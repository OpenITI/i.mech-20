ms141	 الرجلين غدا ، فامترى(@)(@@) 4 فهذا ' بعين ' ، و ' زاي ' يروح %~% وذاك يؤوب ' بضاد ' و ' را '(@)(@@) 5 وعامل قوت ذرا حبه %~% وخدن ركاز ضحى فادرى(@)(@@) 6 وكورك فوق طويل المطا ، %~% وسرجك فوق شديد القرا(@)(@@) 7 وتجري دفار بها جدها ، %~% بمثل الظلام ، إذا ماجرى(@)(@@) 8 كأن بصاق الدبا فوقها %~% اذا وقدت في الانوف البرى(@)(@@) 9 وذلك من حر أنفاسها %~% يضاعفه حر يوم جرى PageV01P618(@)(@@) 10 تلوم على أم دفر أخاك ، %~% وراءك ، ان هوى قد ورى(@)(@@) 11 عهدتك تشبه سيد الضراء ، %~% ولست مشابه ليث الشرى(@)(@@) 12 تدب ، فإن وجدت خلسة ، %~% فيا للسليك أو الشنفري(@)(@@) 13 هو الشر قد عم في العالمين %~% أهل الوهود وأهل الذرى(@)(@@) 14 ليفتن في صمته ناسك %~% اذا افتن فيما يقول الورى(@)(@@) 15 فكنو صبوحية الشرب : ' أم %~% ليلى ' ومكة ' أم القرى '(@)(@@) 16 وقالوا بدا المشتري في الظلام ، %~% فيا ليت شعري ماذا اشترى(@)(@@) 17 وترجو الرباح ، وأين الرباح ، %~% ونعتك في نفسك الخيسرى(@)(@@) 18 عذيري من مارد فاجر ، %~% تقرأ والمخزيات اقترى(@)(@@) 19 فهون عليك لقاء المنون %~% وقل ، حين تطرق : أطرق كرا PageV01P619(@)(@@) 20 وناد ، إذا أوعدتك : اعتري ، %~% فصبرا على الحكم لما اعترى(@)(@@) 21 ونفسي ترجي ، كإحدى النفوس ، %~% وتذري النوائب سكن الذرى(@)(@@) 22 وكم نزل القيل عن منبر %~% فعاد إلى عنصر في الثرى(@)(@@) 23 وأخرج عن ملكه عاريا %~% وخلف مملكة بالعرا(@)(@@) 24 اذا الضبف جاءك فابسم له %~% وقرب إليه وشيك القرى(@)(@@) 25 ولاتحقر المزدرى في العيون %~% ويبقى الزمان على ما نرى(@)(@@) 26 %~% إلا بأزرارها والعرا(@)(@@) 27 أجل خزرتني وثابة %~% سواها التي مشت الخيزري(@)(@@) 28 فان سراء الليالي رمى %~% أوان شبيبتنا ، فانسرى(@)(@@) 29 ونومي موت ، قريب النشور ، %~% وموتي نوم ، طويل الكرى PageV01P620(@)(@@) 30 نؤمل خالقنا أننا %~% صرينا لنشرب ذاك الصرا(@)(@@) 31 سواء علي ، إذا ما هلكت ، %~% من شاد مكرمتي أو زرى(@)(@@) 32 فأودى فلان بسقم أضر %~% وأدوى فلان بعرق ضرا(@)(@@) 33 أبالنبل أدرك أم بالرما %~% ح ، بين أسنتها والسرا ؟(@)(@@) 34 فهل قام من جدث ميت %~% فيخبر عن مسمع أو مرى ؟(@)(@@) 35 ولو هب صدقه معشر ، %~% وقال أنس طغا 
ms142	 وافترى(@)(@@) 36 ولم يقر في الحوض راعي السو %~% م إلا ليورده ما قرى(@)(@@) 37 افر ومافرأ نافر %~% بمعتصم من قضاء فرا(@)(@@) 38 أحن إلى أمل فاتني ، %~% وما للشبوب وعيش الفرى(@)(@@) 39 متى قرقر الهاتف العكرمي ، %~% هيج صبا إلى قرقرى PageV01P621(@)(@@) 40 وقد يفسد الفكر في حالة ، %~% فيوهمك الدر قطر السرى(@)(@@) 41 سقاك المنى فتمنيتها %~% وصاغ لك الطيف حتى انبرى(@)(@@) 42 فلا تدن من جاهل آهل %~% لو انتزعت خمسه مادرى(@)(@@) 43 أبي سيفه قتل أعدائه %~% وساف وليدته ، أو هرا(@)(@@) 44 وتختلف الإنس في شأنها ؛ %~% فابعد بمن باع ممن شرى(@)(@@) 45 مغنية أعطيت مرغبا ؛ %~% فغنت ، ونائحة تكترى(@)(@@) 46 وهاو ليخرج ماء القليب %~% وراق ليجني ثولا أرى(@)(@@) 47 فإن نال شهدا فأيسر به %~% على أنه بسقوط حرى(@)(@@) 48 نزول كما زال أجدادنا %~% ويبقى الزمان على ما ترى(@)(@@) 49 نهار يضيء ، وليل يج %~% ونجم يغور ، ونجم يرى(@)PageV01P622(@)(@@) البحر : طويل(@)(@@) 1 إذا خطب الزهراء كهل وناشئ %~% فإن الصبا فيها شفيع مشفع(@)(@@) 2 ولا يزهدنها عدمه إن مده %~% لأبرك من صاع الكبير وأنفع(@)(@@) 3 وما لأخي ستين قدرة سائر %~% إليها ، ولكن عجزه ليس يدفع(@)(@@) 4 ويخفض ، في كل المواطن ، ذمه ، %~% وإن كان يدنى ، في المحل ، ويرفع(@)PageV01P623(@)(@@) البحر : -(@)(@@) 1 ألا يكشف القصاص وال ، فإن هم %~% أتوا بيقين فليقصوا لينفعوا(@)(@@) 2 وإن خرصوا مينا ، بغير تحرج ، %~% فأوجب شيء أن يهانوا ويصفعوا(@)(@@) 3 ومن جاء منهم واثقا بشفاعة %~% فكم شافع في هين لا يشفع(@)(@@) 4 سعوا لفساد الدين في كل مسجد %~% فما بالهم لم يستضاموا ويدفعوا ؟(@)PageV01P624(@)(@@) البحر : طويل(@)(@@) 1 هي النفس ، عناها من الدهر فاجع %~% برزء ، وغناها لتطرب ساجع(@)(@@) 2 ولم تدر من أنى تعد لنا الخطى ، %~% ولا أين تقضى للجنوب المضاجع(@)(@@) 3 وما هذه الساعات إلا أراقم %~% وإن شجعت في لمسهن الأشاجع(@)(@@) 4 أرى الناس أنفاس التراب ، فظاهر %~% إلينا ، ومردود إلى الأرض راجع(@)(@@) 5 شربت سني الأربعين تجرعا ، %~% فيا مقرا ما شربه في ناجع(@)(@@) 6 جهلنا ، فحي ، في الضلالة ، ميت ، %~% أخو سكرة في غيه ، لا يراجع(@)(@@) 7 يذم إذا 
ms143	 لاقاك يقظان هاجعا %~% وحمد ، لذئب الخرق ، يقظان هاجع(@)PageV01P625(@)(@@) البحر : بسيط تام(@)(@@) 1 دولاتكم شمعات يستضاء بها ، %~% فبادروها إلى أن يطفأ الشمع(@)(@@) 2 والنفس تفنى بأنفاس مكررة %~% وساطع النار تخبي نوره اللمع(@)(@@) 3 كم سامعي اللفظ قوال ، كأنهم %~% تحت البسيطة لا قالوا ولا سمعوا(@)(@@) 4 والعلم يدرك أن المرء مختلس %~% من الحياة ، ولكن يغلب الطمع(@)(@@) 5 وقد سقتهم غمامات بكت زمنا %~% بلا ابتسام ، فلا جادوا ولا دمعوا(@)(@@) 6 لا تجمعوا المال ، واحبوه مواليه ، %~% فالممسكون تراث كل ما جمعوا(@)(@@) 7 والوقت لله ، والدنيا مخلفة %~% من بعدنا ، وتساوى الهام والزمع(@)(@@) 8 وليس يثبت للأيام من شرف ، %~% إذا تفاخرت الآحاد والجمع(@)(@@) 9 ورب أبيض كان الوشي مبتذلا %~% في صونه ، أكلته أضبع خمع(@)PageV01P626(@)(@@) البحر : طويل(@)(@@) 1 لعمرك ! ما بي نجعة ، فأرومها ، %~% وإني على طول الزمان لمجدب(@)(@@) 2 حملت على الأولى الحمام فلم أقل %~% يغني ولكن قلت يبكي ويندب(@)(@@) 3 وذلك أن الحادثات كثيرة ، %~% وغالبهن الفظ لا المستحدب(@)(@@) 4 وكل أديب ، أي سيدعى إلى الردى ، %~% من الأدب ، لا أن الفتى متأدب(@)PageV01P627(@)(@@) البحر : طويل(@)(@@) 1 إذا كان إكرامي صديقي واجبا ، %~% فإكرام نفسي ، لا محالة ، أوجب(@)(@@) 2 وأحلف ما الإنسان إلا مذمم : %~% أخو الفقر منا والمليك المحجب(@)(@@) 3 أيعقل نجم الليل أو بدر تمه ، %~% فيصبح من أفعالنا يتعجب ؟(@)PageV01P628(@)(@@) البحر : بسيط تام(@)(@@) 1 قالت معاشر : كل عاجز ضرع %~% ما للخلائق لا بطء ولا سرع(@)(@@) 2 مدبرون ، فلا عتب إذا خطئوا %~% على المسيء ، ولا حمد ، إذا برعوا(@)(@@) 3 وقد وجدت لهذا القول في زمني %~% شواهدا ، ونهاني دونه الورع(@)(@@) 4 والناس ضأن تساوت في غرائزها %~% يلقون ، بالأرض ، كفا ، كلما افترعوا(@)(@@) 5 والعيش ورد سيسقى الحي آخره ، %~% عند الحمام ، وأنفاس الفتى جرع(@)(@@) 6 شاموا بروق المنايا غير مانعهم %~% من الحوادث ، ما شاموا وما ادرعوا(@)(@@) 7 ويدعي ، الرتبة العليا ، أخسهم ، %~% فما يجاب لهم داع إذا ضرعوا(@)(@@) 8 وأدركوا ، بدعاويهم ، مدى زحل ، %~% من الرغام بما قاسوه أو ذرعوا(@)(@@) 9 يسعون في المنهج المسلوك ، قد سبقوا %~% إلى الذي هو عند الغر مخترع(@)(@@) 10 أبكار هذي 
ms144	 المعاني ثيبات حجى %~% في كل عصر لها جان ومفترع PageV01P629(@)(@@) 11 وخالفوا الشرع لما جاءهم بتقى %~% واستحسنوا ، من قبيح الفعل ، ما شرعوا(@)(@@) 12 وجدت ما ازدرعوه ، كان عن قدر ، %~% والحق أن بنيهم شر ما ازدرعوا(@)(@@) 13 ولو يكشف عن أبصارهم لرأت %~% آمالهم والمنايا كيف تصطرع(@)(@@) 14 عادت لياليهم دهما بلا وضح %~% وقد تكون بهن الغر والدرع(@)(@@) 15 والمرء ، ما عاش ، مبسوط إساءته ، %~% يشقى به القوم ، إن هانوا وإن فرعوا(@)(@@) 16 والطير والوحش غاديها وصالحها %~% والليث والشبل والذيال والذرع(@)(@@) 17 لا فضل يحباه مخلوق على جهة %~% من حاله ، وتساوى النسر والمرع(@)(@@) 18 والهذر يعطيك عن فقد الهدى نبأ %~% ويكثر القول طير ، شأنها الضرع(@)PageV01P630(@)(@@) البحر : بسيط تام(@)(@@) 1 من رام أن يلزم الأشياء واجبها ، %~% فإنه ببقاء ليس ينتفع(@)(@@) 2 أرضي انتباهي بما لم يرضه حلمي %~% قدما ، وأدفع أوقاتي فتندفع(@)(@@) 3 وخف بالجهل أقوام فبلغهم %~% منازلا بسناء العز تلتفع(@)(@@) 4 أما رأيت جبال الأرض لازمة %~% قرارها ، وغبار الأرض يرتفع ؟(@)PageV01P631(@)(@@) البحر : طويل(@)(@@) 1 أتذهب دار بالنضار ، وربها %~% يخلفها ، عما قليل ، ويذهب(@)(@@) 2 أرى قبسا في الجسم يطفئه الردى ، %~% وما دمت حيا فهو ذا يتلهب(@)PageV01P632(@)(@@) البحر : طويل(@)(@@) 1 غدوت على نفسي أثرب جاهدا ، %~% وأمثالها لام اللبيب المثرب(@)(@@) 2 إذا كان جسمي من تراب ، مآله %~% إليه ، فما حظي بأني مترب(@)(@@) 3 وما زالت الدنيا بأصناف ألسن %~% تبين عن غير الجميل وتعرب(@)(@@) 4 إذا أغربت يوما برزء على الفتى %~% فليست على نفسي بما حم تغرب(@)(@@) 5 وجربتها أم الوليد لطامع %~% وييئس من أم الوليد المجرب(@)(@@) 6 يحق لمن يهوى الحياة بكاؤه %~% إذا لاح قرن الشمس ، أو حين تغرب(@)(@@) 7 وما نفس إلا يباعد مولدا ، %~% ويدني المنايا ، للنفوس ، فتقرب(@)(@@) 8 فهل لسهيل في معدك ناصر %~% إذا أسلمته ، للحوادث ، يعرب(@)(@@) 9 وأهدى إلى نهج الهدى من معاشر ، %~% نواضح تسنو ، أو عوامل تكرب(@)(@@) 10 ألا تفرق الأحياء مما بدا لها %~% وقد عمها بالفجر أزرق مغرب PageV01P633(@)(@@) 11 وشف بقاء صرت من سوء فعله %~% أهش إلى الموت الزؤام وأطرب(@)(@@) 12 فشم صارما ، واركز 
ms145	 قناة ، فللردى %~% يد ، هي أولى بالحمام ، وأدرب(@)(@@) 13 أفض لهامات ، وأرمى بأسهم ، %~% وأطعن في قلب الخميس وأضرب(@)(@@) 14 أرى مطعم الرمس اللهم خليله %~% سيأكل من بعد الخليل ويشرب(@)PageV01P634(@)(@@) البحر : كامل تام(@)(@@) 1 أما الزمان ، فأوقات مواصلة ؛ %~% يا سعد ويحك ، هل أحسست من بلع(@)(@@) 2 أسرر جميلك ، وافعل ما هممت به %~% إن المليك على الأسرار مطلع(@)(@@) 3 ولتركب الجنح ، لا عودا ولا فرسا %~% كأنما الشهب فيه الأينق الظلع(@)(@@) 4 وما الهلال بظفر الليث ترهبه ، %~% لكنه ، من بقايا آكل ، صلع(@)(@@) 5 والشري ، يوجد في أعقابه ضرب ، %~% خير من الأري في أعقابه سلع(@)(@@) 6 وإن جهلت _ هداك الله _ من كبر %~% فكل طود منيف شأنه الصلع(@)(@@) 7 وأم دفر إذا طلقتها بذلت %~% رفدا ، وكانت كعرس حين تختلع(@)(@@) 8 وسرت ، عمري ، إلى قبري على مهل ، %~% وقد دنوت ، فحق الخوف والهلع(@)(@@) 9 ما نحن أم ما برايا عالم كثر ، %~% في قدرة ، بعضها ، الأفلاك ، يبتلع(@)(@@) 10 تهزم الرعد ، حتى خلته أسدا ، %~% أمامه ، من بروق ، ألسن دلع(@)PageV01P635(@)(@@) البحر : بسيط تام(@)(@@) 1 المين أهلك فوق الأرض ساكنها ، %~% فما تصادق ، في أبنائها ، الشيع(@)(@@) 2 لولا عداوة أصل في طباعهم ، %~% كانت مساجد مقرونا بها البيع(@)PageV01P636(@)(@@) البحر : بسيط تام(@)(@@) 1 لا يغبطن أخو نعمى بنعمته ، %~% بئس الحياة حياة بعدها الشجب(@)(@@) 2 والحس أوقع حيا في مساءته %~% وللزمان جيوش ما لها لجب(@)(@@) 3 لو تعلم الأرض ما أفعال ساكنها %~% لطال منها ، لما يأتي به ، العجب(@)(@@) 4 بدء السعادة أن لم تخلق امرأة %~% فهل تود جمادى أنها رجب ؟(@)(@@) 5 ولم تبت لاختير كان منتجبا %~% لكنك العود إذ يلحى وينتجب(@)(@@) 6 وما احتجبت عن الأقوام من نسك ، %~% وإنما أنت للنكراء محتجب(@)(@@) 7 قالت لي النفس : إني في أذى وقذى %~% فقلت : صبرا وتسليما ، كذا يجب(@)PageV01P637(@)(@@) البحر : بسيط تام(@)(@@) 1 النفس في العالم العلوي مركزها %~% وليس في الجو ، للأجساد ، مزدرع(@)(@@) 2 تفرع الناس عن أصل به درن ، %~% فالعالمون ، إذا ميزتهم ، شرع(@)(@@) 3 والجد آدم ، والمثوى أديم ثرى ، %~% وإن تخالفت الأهواء والشرع(@)(@@) 4 ما ربة التاج 
ms146	 والقرطين مارية %~% إلا كمارية في إثرها ذرع(@)(@@) 5 وإن خنساء ، إذ تزجي قصائدها ، %~% نظير خنساء يدعو ظمأها الكرع(@)(@@) 6 ما أكثر الورع المزؤود من جبن %~% فينا ، وإن قل في أشياعنا الورع(@)(@@) 7 ولابس المغفر الدرعي جاء به %~% كالسيد أدرع في ليل له درع(@)(@@) 8 والعيش ماء مزاد ، راح يحمله %~% طاوي الفلاة ، وأنفاس الفتى جرع(@)(@@) 9 إذا دعيت لأمر عادني بأذى %~% أو رزء دين ، فإبطائي هو السرع(@)(@@) 10 غدت جيوش المنايا حول واحدة %~% من النفوس ، عليها الجيش يقترع PageV01P638(@)(@@) 11 إذا أبيدت ، فما عندي ، إذا أخذت ، %~% فرع ينوب ، ولا عذراء تفترع(@)(@@) 12 وإن حباني سعدا من به ثقتي %~% فليس ينقص حظي أنني ضرع(@)(@@) 13 تشابه الإنس إلا أن يشد حجى %~% والطير شتى ، ومنها الفتخ والمرع(@)PageV01P639(@)(@@) البحر : بسيط تام(@)(@@) 1 أخلاق سكان دنيانا معذبة %~% وإن أتتك بما تستعذب العذب(@)(@@) 2 سموا : هلالا وبدرا والندى وضحى %~% وفرقدا وسماكا شد ما كذبوا(@)(@@) 3 ولم ينط ، بحبال الشمس ، من نظر ، %~% إلا له ، في جبال الشر ، مجتذب(@)PageV01P640(@)(@@) البحر : بسيط تام(@)(@@) 1 ما قرطاسك في كف المدير له %~% إلا وقرطاسك المرعوب مرعوب(@)(@@) 2 تضحي وبطنك مثل الكعب أبرزه %~% ري ، ورأسك مثل القعب مشعوب(@)PageV01P641(@)(@@) البحر : وافر تام(@)(@@) 1 إذا ما الأصل ألفي غير زاك ، %~% فما تزكو ، مدى الدهر ، الفروع(@)(@@) 2 وليس يوافق ابن أب وأم %~% أخاه ، فكيف تتفق الشروع ؟(@)(@@) 3 فإن أكدى المنيل فلا تلمه %~% فقد تخلو ، من الرسل ، الضروع(@)(@@) 4 وذكر بالتقى نفرا غفولا %~% فلولا السقي ما نمت الزروع(@)(@@) 5 بني حواء كيف الأمن منكم ، %~% ولم يؤهل بغير الحقد روع(@)(@@) 6 إذا كان القضاء يجيء حتما ، %~% فما هذي المغافر والدروع ؟(@)(@@) 7 أذكركم برحلتكم ، لعلي %~% أروع قلوبكم ، ولمن أروع !(@)PageV01P642(@)(@@) البحر : وافر تام(@)(@@) 1 نفوس للقيامة تشرئب %~% و غي في البطالة متائب(@)(@@) 2 تأبى أن تجيء الخير يوما ، %~% وأنت ليوم غفران تئب(@)(@@) 3 ولا يغررك بشر من صديق %~% فإن ضميره إحن وخب(@)(@@) 4 وإن الناس : طفل ، أو كبير ، %~% يشيب على الغواية أ , يشب(@)(@@) 5 تحب حياتك الدنيا سفاها %~% وماجادت ، عليك 
ms147	 ، بما تحب(@)(@@) 6 وإنك منذ كون النفس عنسا %~% لتوضع في الضلالة ، أو تخب(@)(@@) 7 وإن طال الرقاد من البرايا ، %~% فإن الراقدين لهم مهب(@)(@@) 8 غرامك بالفتاة ضنى وهم %~% وليس يسر من يشتاق غب(@)(@@) 9 لو أن سواد كيوان خضاب %~% بكفك ، والسهى في الأذن حب(@)(@@) 10 لما نجاك من غير الليالي %~% سناء فارع ، وغنى مرب PageV01P643(@)(@@) 11 وما يحميك عز إن تسبى ، %~% ولو أن الظلام عليك سب(@)(@@) 12 أرى جنح الدجى أوفى جناحا ، %~% ومات غرابه الجون الملب(@)(@@) 13 فما للنسر ليس يطير فيه %~% وعقربه المضيئة لا تدب(@)(@@) 14 أيجلو الشمس ، للرائي ، نهار ، %~% فقد شرقت ، ومشرقها مضب(@)(@@) 15 ولم يدفع ردى سقراط لفظ %~% ولا بقراط حامى عنه طب(@)(@@) 16 إذا آسيتني بشفا ، صريعا ، %~% فدعني كل ذي أمل يثب(@)(@@) 17 ولا تذبب ، هناك ، الطير عني ؛ %~% ولا تبلل يداك فما يذب(@)PageV01P644(@)(@@) البحر : خفيف تام(@)(@@) 1 إن دمعي نبع ، وما العود نبع ، %~% وحواني من منزل الهم ربع(@)(@@) 2 خذ بضبعي إذا أطقت غياثا %~% فمسير الأيام تحتي ضبع(@)(@@) 3 نل يسيرا مني ، ولا تسبعني %~% في نوالي ، فإن ظمئي سبع(@)(@@) 4 والسجايا شتى ، فلا يقنص اللي %~% هزبرا والهر للفأر سبع(@)(@@) 5 وتداني الأيام يحدث نقصا %~% وازديادا ، والجسم للنفس تبع(@)(@@) 6 خمسة ، في نظيرها خمس خمسات ، %~% تنمت ، والنصف ، في النصف ، ي(@)(@@) 7 يغدر الخل إن تكفل يوما %~% بوفاء ، والغدر في الناس طبع(@)PageV01P645(@)(@@) البحر : وافر تام(@)(@@) 1 تراب جسومنا وهي التراب %~% إذى ولى عن الآل اغتراب(@)(@@) 2 تراع ، إذا تحس إلى ثراها ، %~% إيابا ، وهو منصبها القراب(@)(@@) 3 وذاك أقل للأدواء فيها %~% وإن صحت كما صح الغراب(@)(@@) 4 هموم بالهواء معلقات %~% إلى التشريف أنفسها طراب(@)(@@) 5 فأرماح يحطمها طعان %~% وأسياف يفللها ضراب(@)(@@) 6 تنافس في الحطام ، وحسب شاك %~% طوى ، وحلف صدى شراب(@)(@@) 7 وأملاك تجزأ في غناها ، %~% وإن ورد العفاة ، فهم سراب(@)(@@) 8 وقد يفري أسود الغيل حرص ، %~% فتحويها الحظائر والزراب(@)(@@) 9 متى لم يضطرب ، من علو ، جد ، %~% فليس بنافع منك اضطراب(@)(@@) 10 كأن السيف لم يعطل زمانا ، %~% إذا حلي الحمائل 
ms148	 والقراب PageV01P646(@)(@@) 11 تألف أربع فينا فتذكى %~% بها منا ضغائن واحتراب(@)(@@) 12 ولو سكنت جبال الأرض روح %~% لما خلدت نضاد ولا إراب(@)PageV01P647(@)(@@) البحر : طويل(@)(@@) 1 لعمرك ما آسى ، إذا ما تحملت ، %~% عن الجسم روح كان يدعى لها ربعا(@)(@@) 2 وما أسأل الأحياء بعدي زيارة %~% ثلاثا لإيناس الدفين ولا سبعا(@)(@@) 3 ولا ترث الزوجات عني حصة %~% من المال : ثمنا في الفريضة أو ربعا(@)(@@) 4 جوار بني الدنيا ضنى لي دائم ، %~% تمنيت ، لما شفني ، الغب والربعا(@)(@@) 5 لقد فعلوا الخير القليل تكلفا %~% وجاؤوا الذي جاؤوه ، من شرهم ، طبعا(@)(@@) 6 فأين ينابيع الندى وبحاره ؟ %~% وهل أبقت الأيام من أسد ضبعا ؟(@)(@@) 7 إذا حرقت عيدانهم فألوة %~% وإن عجمت في حادث وجدت نبعا(@)PageV01P648(@)(@@) البحر : وافر تام(@)(@@) 1 دنا رجل إلى عرس لأمر %~% وذاك ، لثالث خلق ، اكتساب(@)(@@) 2 فما زالت تعاني الثقلحتى %~% أتاها الوضع ، واتصل الحساب(@)(@@) 3 نرد إلى الأصول ، وكل حي %~% له في الأربع القدم انتساب(@)PageV01P649(@)(@@) البحر : وافر تام(@)(@@) 1 ألا عدي بكاء ، أو نحيبا ، %~% فمن سفه بكاؤك والنحيب(@)(@@) 2 محل الجسم في الغبراء ضنك %~% ولكن عفو خالقنا رحيب(@)(@@) 3 وسيان ابن آدم حين يدعى %~% به للغسل ، والهدم السحيب(@)PageV01P650(@)(@@) البحر : -(@)(@@) 1 برد الصبا ليس مثل البرد تخلعه %~% وجاز أن يستعيد اللبس من خلعه(@)(@@) 2 فأجد ، واجدد ، وآجد ، واجد من صمد %~% غفرانه واخش واخشش نفسك الطلعه(@)(@@) 3 واعرض أحاديث من قوم ، أتوك بها ، %~% على قياسك ، تحلف أنهم ولعه(@)PageV01P651(@)(@@) البحر : وافر تام(@)(@@) 1 تريب وسوف يفترق التريب %~% حوانا والثرى نسب قريب(@)(@@) 2 جرى ، بفراق جيرتنا ، غراب %~% فعال من مقالتهم : غريب(@)(@@) 3 غدا يتوكف الأخبار غر %~% وصاح ببينهم داع أريب(@)(@@) 4 طعان كل حين ، أو ضراب ، %~% يموت به طعين ، أو ضريب(@)(@@) 5 وأرض لا تحس بمن عليها %~% ولا يبقى بها منهم عريب(@)(@@) 6 وأشباح يخالطهن غدر %~% فما يرعى الأكيل ولا الشريب(@)(@@) 7 إذا كان الثراء إلى زوال ، %~% فكل ممول منا حريب(@)PageV01P652(@)(@@) البحر : -(@)(@@) 1 لا تخبأن ، لغد ، رزقا ، وبعد غد ، %~% فكل يوم يوافي رزقه معه(@)(@@) 2 واذخر جميلا لأدنى الوقت 
ms149	 تدركه %~% وللقيامة تعرف ذاك أجمعه(@)(@@) 3 فرق تلادك فيما شئت محتقرا ، %~% فليس يذرف خلف النعش أدمعه(@)(@@) 4 وافعل بغيرك ما تهواه يفعله ، %~% وأسمع الناس ما تختار مسمعه(@)(@@) 5 وأكثر الإنس مثل الذئب تصحبه ، %~% إذا تبين منك الضعف أطمعه(@)PageV01P653(@)(@@) البحر : بسيط تام(@)(@@) 1 إذا عفوت ، عن الإنسان ، سيئة ، %~% فلا تروعه تثريبا وتقريعا(@)(@@) 2 وإن كفيت عناء فاجتنب كلفا %~% غان عن النزع مروي الإبل تشريعا(@)(@@) 3 والمرء يوجد من عدم ، وما نقلت ، %~% عنه الحوادث ، من عاداته ، ريعا(@)(@@) 4 إن يألف الهضب لا يبغ الوهود به ؛ %~% أو يألف الوهد لا يؤثر به الريعا(@)(@@) 5 وفي الضرورة يلغى ما تعوده ، %~% والعفر تأكل في الرمل اليساريعا(@)(@@) 6 وكيف يطلب عدلا من غريزته %~% تولد الظلم تثميرا وتفريعا ؟(@)(@@) 7 لكل حال سجايا ، والقريض بنا ، %~% لا تقتضيك ، بغير البدء ، تصريعا(@)PageV01P654(@)(@@) البحر : وافر تام(@)(@@) 1 لسانك عقرب ، فإذا أصابت %~% سواك ، فأنت أول من تصيب(@)(@@) 2 أثمت بما جنته ، فمن شكاها %~% وفى لك من شكيته نصيب(@)(@@) 3 أتى الرجلين ، عنها ، الشر مثنى ، %~% كلا يوميكما شئز عصيب(@)PageV01P655(@)(@@) البحر : وافر تام(@)(@@) 1 إذا ما بيعة زيرت لغي %~% فأعط ، لهجرها ، أيمان بيعه(@)(@@) 2 ولا تجعلك ، للأيام ، كلبا ، %~% ظباء من ذؤيبة أو سبيعه(@)(@@) 3 فإن الدهر ينقل كل حال %~% كما نقل الحكومة عن ضبيعه(@)PageV01P656(@)(@@) البحر : وافر تام(@)(@@) 1 تنادوا ظاعنين غداة قالوا : %~% أصاب الأرض من مطر مصيب(@)(@@) 2 لعل شوائما رمقت وميضأ %~% تبيد ، وما لها فيه نصيب(@)(@@) 3 وقد تنجو النفوس بأرض جدب ، %~% ويهلك أهله المغنى الخصيب(@)PageV01P657(@)(@@) البحر : كامل تام(@)(@@) 1 أزعمت أنك آخذ ، من لذة %~% حظا ، وأنك لا تؤمل مرجعا ؟(@)(@@) 2 حتى م تصبح ، للضعيف ، مقويا ، %~% فعل السفيه ، وللجبان مشجعا ؟(@)(@@) 3 لو لم نراع أمامنا إلا الردى %~% بولى الجسوم لكان أمرا موجعا(@)(@@) 4 وإذا هممت بمطلب لتناله ، %~% لاقيت ، من نوب الزمان ، مفجعا(@)(@@) 5 والشخص لا ينفك في تعب أتى %~% من نفسه حتى يصادف مضجعا(@)PageV01P658(@)(@@) البحر : وافر تام(@)(@@) 1 رغبنا في الحياة لفرط جهل %~% وفقد حياتنا حظ رغيب(@)(@@) 2 شكا خزر حوادثها ، وليث ، %~% فما 
ms150	 رحم الزئير ، ولا الضغيب(@)(@@) 3 شهدت ، فلم أشاهد غير نكر ، %~% وغيبني المنى فمتى أغيب(@)PageV01P659(@)(@@) البحر : سريع(@)(@@) 1 يا ثالث الثنيين في خمسة ، %~% إربع ، لكي تستخبر الأربعا(@)(@@) 2 ينبع ، من عينيك ، ماء لها ، %~% إذا خليط يمموا ينبعا(@)(@@) 3 فهل ترى كسرا على الأر ض من %~% كسراك ، أو من تبع ، تبعا ؟(@)(@@) 4 وكم لقينا ضبعا أقبلت %~% تفترس الآساد والأضبعا(@)PageV01P660(@)(@@) البحر : طويل(@)(@@) 1 لعمري ! لقد أوضعت في الغي برهة ، %~% فما لك في ركب التقى غير موضع(@)(@@) 2 وكم هد من ثهلان أو رد واصيا %~% ولكن ثرى ثهلان لم يتضعضع(@)(@@) 3 حلبت الزمان العود أشطر ثرة ، %~% صفي ، وما تنفك من جهل مرضع(@)(@@) 4 فدع عنك ذكر البارقية ، تعتزي %~% لبارق حي ، أو لبارق موضع(@)(@@) 5 إذا خضعت أعناق رهط لكفرهم %~% فأعناق طلاب الهدى غير خضع(@)PageV01P661(@)(@@) البحر : كامل تام(@)(@@) 1 لذتنا إبل الزمان ، ينالها %~% منا أخو الفتك الذي هو خارب(@)(@@) 2 وأرى عناء قيد يغشى المرء من %~% بنت العناقيد الذي هو شارب(@)(@@) 3 ولسيد الأقوام ، عند حجابه ، %~% طبع يقاتله الحجى ويحارب(@)(@@) 4 و الشر في الجد القديم غريزة %~% في كل نفس منه عرق ضارب(@)PageV01P662(@)(@@) البحر : طويل(@)(@@) 1 حبست كتاب العين في كل وجهة ، %~% فخذ حذرا من ترجمان المفجع(@)(@@) 2 تق الله واترك أدمعا إثر هالك %~% فلم تلق إلا حاملا قلب موجع(@)(@@) 3 وأي انتفاع للهديل ، الذي مضى ، %~% على عهد نوح بالهديل المرجع(@)(@@) 4 كأن خطيبا موفيا رأس منبر ، %~% ينث هذاء بالكلام المسجع(@)(@@) 5 إذا كان جسمي ، في الثرى ، غير عالم ، %~% فلحدي خير من مبيتي بمهجع(@)PageV01P663(@)(@@) البحر : كامل تام(@)(@@) 1 علم الإمام ، ولا أقول بظنه ، %~% أن الدعاة بسعيها تتكسب(@)(@@) 2 هذا الهواء يلوح فيه ، لناظر ، %~% صور ، ولكن عن قريب ترسب(@)(@@) 3 والناس جنس ما تميز واحد ، %~% كل الجسوم ، إلى التراب ، تنسب(@)(@@) 4 والأري باطنه متى ما ذقته %~% شري ، فماذا ، لا أبالك ، تلسب(@)(@@) 5 وسيقفر المصر الحريج بأهله ؛ %~% ويغص بالإنس الفضاء السبسب(@)PageV01P664(@)(@@) البحر : طويل(@)(@@) 1 عليك بفعل الخير ، لو لم يكن له %~% من الفضل إلا حسنه في المسامع 
ms151	(@)(@@) 2 لعمرك ! ما في عالم الأرض زاهد %~% يقينا ، ولا الرهبان أهل الصوامع(@)(@@) 3 أرى أمراء الناس يمسون شرهم %~% إذا خطفوا خطف البزاة اللوامع(@)(@@) 4 وفي كل مصر حاكم : فموفق %~% وطاغ يحابي في أخس المطامع(@)(@@) 5 يجور فينفي الملك عن مستحقه ، %~% وتسكب أسراب العيون الدوامع(@)(@@) 6 ومن حوله قوم كأن وجوههم %~% صفا ، لم يلين بالغيوث الهوامع(@)(@@) 7 عدول لهم ظلم الضعيف سجية %~% يسمون أعراب القرى والجوامع(@)PageV01P665(@)(@@) البحر : سريع(@)(@@) 1 إن عذب المين بأفواهكم ، %~% فإن صدقي بفمي أعذب(@)(@@) 2 طلبت للعالم تهذيبكم %~% والناس ما صفوا ولا هذبوا(@)(@@) 3 سألت من خالف عن دينه ، %~% فأعوز المخبر ، لا يكذب(@)(@@) 4 وأكثروا الدعوى بلا حجة %~% كل ، إلى حيزه ، يجذب(@)PageV01P666(@)(@@) البحر : بسيط تام(@)(@@) 1 إذا فزعنا فإن الأمن غايتنا %~% وإن أمنا فما نخلو من الفزع(@)(@@) 2 وشيمة الإنس ممزوج بها ملك %~% فما تدوم على صبر ولا جزع(@)(@@) 3 وسبتك الشعر الغربيب تطرحه ، %~% ما رغب الشيخ في البادي من النزع(@)(@@) 4 ونغبة إثر أخرى أطفأت ظمأ ؛ %~% ورب ملبس دجن خيط من قزع(@)(@@) 5 وشر ساكن هذي الأرض عالمنا ، %~% واللوب في الجزع أغلى قيمة الجزع(@)(@@) 6 لولا فوارس فوق الخيل مشرعة %~% ما هابت الوحش قرب الشزب المزع(@)(@@) 7 زع نفسك اليوم ، وافديها إلى حسن %~% فإن أطاعت فأدب غيرها وزع(@)PageV01P667(@)(@@) البحر : سريع(@)(@@) 1 يحسن مرأى لبني آدم ، %~% وكلهم في الذوق لا يعذب(@)(@@) 2 ما فيهم بر ، ولا ناسك ، %~% إلا إلى تفع له يجذب(@)(@@) 3 أفضل من أفضلهم صخرة %~% لا تظلم الناس ولاتكذب(@)PageV01P668(@)(@@) البحر : سريع(@)(@@) 1 هذا طريق للهدى لاحب %~% يرضى به المصحوب والصاحب(@)(@@) 2 أهرب من الناس ، فإن جئتهم %~% فمثل سأب جره الساحب(@)(@@) 3 ينتفع الناس بما عنده %~% وهو لقى ، بينهم ، شاحب(@)PageV01P669(@)(@@) البحر : سريع(@)(@@) 1 إصفح ، وجاهر ، بالمراد ، الفتى ؛ %~% ولا يقولوا هو مغتاب(@)(@@) 2 إن رابنا الدهر بأفعاله %~% فكلنا ، بالدهر ، مرتاب(@)(@@) 3 فاعف ، ولا تعتب عليه ، فكم %~% أودى به عوف وعتاب(@)(@@) 4 لو ضرب الغاوون بالسيف لا %~% بالسوط ، حد الخمر ما تابوا(@)(@@) 5 تلك من اجتابت له صورة ، %~% فهو 
ms152	 ، لسخط الله ، مجتاب(@)(@@) 6 نمنا على الشيب ، فهل زارنا %~% طيف ، لأصل الشرخ ، منتاب ؟(@)(@@) 7 هيهات لا تحمله نحونا %~% سرج أفراس وأقتاب . . . . .(@)PageV01P670(@)(@@) البحر : كامل تام(@)(@@) 1 كإنائك الجسم الذي هو صورة %~% لك في الحياة ، فحاذري أن تخدعي(@)(@@) 2 لا فضل للقدح الذي استودعته %~% ضربا ، ولكن فضله للمودع(@)PageV01P671(@)(@@) البحر : منسرح(@)(@@) 1 إياك والخمر ، فهي خالبة %~% غالبة ، خاب ذلك الغلب(@)(@@) 2 خابيةالراح ناقة حفلت %~% ليس لها ، غير باطل ، حلب(@)(@@) 3 أشأم من ناقة البسوس على الن %~% ناس ، وإن ينل عندها الطلب(@)(@@) 4 أن يترامى بدائها حلب %~% أن تترامى بدائها حلب(@)(@@) 5 أفضل مما تضم أكؤوسها %~% ما ضمنته العساس والعلب(@)PageV01P672(@)(@@) البحر : كامل تام(@)(@@) 1 ما لي رأيتك لا تلم بمسجد ، %~% حتى كأنك في البلاغ السابع(@)(@@) 2 سبح بواحدة ففيها بلغة %~% للمتقين ، وكل بخمس أصابع(@)(@@) 3 يا أولا في الكفر لم يك ثانيا %~% طال استتارك بالإمام الرابع(@)(@@) 4 والشمر عندك في الحسين موفق %~% لما حماه من الفرات النابع(@)(@@) 5 ما صح عندي أن ذات خلاخل %~% تقفى من الجن الغواة بتابع(@)PageV01P673(@)(@@) البحر : منسرح(@)(@@) 1 من لي أن أقيم في بلد ، %~% أذكر فيه بغير ما يجب(@)(@@) 2 يظن بي اليسر واليانة والعل %~% م وبيني وبينها حجب(@)(@@) 3 كل شهوري علي واحدة ، %~% لا صفر يتقى ولا رجب(@)(@@) 4 أقررت بالجهل ، وادعى فهمي %~% قوم ، فأمري وأمرهم عجب(@)(@@) 5 والحق أني وأنهم هدر ، %~% لست نجيبا ولا هم نجب(@)(@@) 6 والحال ضاقت عن ضمها جسدي %~% فكيف لي أن يضمه الشجب(@)PageV01P674(@)(@@) البحر : سريع(@)(@@) 1 الطيلسان اشتق في لفظه %~% من طلسة المبتكر الخامع(@)(@@) 2 وزيد ما زيد لتوكيده ، %~% فالشر في بارقه اللامع(@)(@@) 3 أما استحى العدل ، وأخباره %~% سيئة في أذن السامع(@)(@@) 4 ما جار شماسك في حكمه %~% ولا يهوديك بالطامع(@)(@@) 5 فالقس خير لك ، فيما أرى ، %~% من مسلم يخطب في الجامع(@)PageV01P675(@)(@@) البحر : خفيف تام(@)(@@) 1 ما الثريا عنقود كرم ملا %~% ي ، ولا الليل يانع غربيب(@)(@@) 2 ونأى عن مدامة شفق التغ %~% ريب ، فليتق المليك اللبيب(@)(@@) 3 طال ليل ، كأنما قتل العق %~% رب ساط 
ms153	 ، فغاب عنها الدبيب(@)(@@) 4 سلك النجد ، في قطار المنايا ، %~% قطري ، ونجدة ، وشبيب(@)(@@) 5 شب فكر الحصيف نارا ، فما يح %~% سنن ، يوما ، بعاقل ، تشبيب(@)(@@) 6 أين بقراط ، والمقلد جالينوس ، %~% نوس ؟ هيهات أن يعيش طبيب(@)(@@) 7 سبب الرزق للأنام فما يق %~% طع ، بالعجز ، ذلك التسبيب(@)(@@) 8 وجرى الحتف بالقضاء ، فما يس %~% لم ليث ، ولا غزال ربيب(@)(@@) 9 ويطلع الوافد المبغض ، والعي %~% ش ، إلى هذه النفوس ، حبيب(@)(@@) 10 خببتها عليه نكد الرزايا ، %~% فنبا ، عن قلوبها ، التخبيب(@)PageV01P676(@)(@@) البحر : رمل تام(@)(@@) 1 مرحبا بالموت فالعيش دجى %~% وحمام المرء ، كالفجر سطع(@)(@@) 2 أمل أحصد لا ترسله %~% كف حي ، فإذا مات انقطع(@)(@@) 3 أمر الحازم نفسا بالتقى ، %~% ذاك أمر من لبيب لم يطع(@)(@@) 4 كم أراد الخلد قوم فرأوا %~% مسلكا إن يلتمس لا يستطع(@)(@@) 5 لست أدري ، ألقسم المال أم %~% لاقتضاب الرأس يدعى بالنطع(@)(@@) 6 طلب المشتار أريا ، فإذا %~% جثة البائس في الأرض قطع(@)PageV01P677(@)(@@) البحر : متقارب تام(@)(@@) 1 عجبت لآمرنا لم يطع ، %~% وللخلد عز فلم يستطع(@)(@@) 2 ونظم أناس تناهى إلي ، %~% من عهد آدم ، ثم انقطع(@)(@@) 3 وأشنب إن أنظرته المنون ، %~% فلا بد من قصم أو لطع(@)(@@) 4 فلا تيأسن لليل دجا %~% ولا تفرحن بفجر سطع(@)(@@) 5 ولا تحفلن : أللسيب أم %~% مع السيف قدم ذاك النطع(@)PageV01P678(@)(@@) البحر : طويل(@)(@@) 1 رأيت قضاء الله أوجب خلقه ، %~% وعاد عليهم في تصرفه سلبا(@)(@@) 2 وقد غلب الأحياء ، في كل وجهة ، %~% هواهم ، وإن كانوا غطارفة غلبا(@)(@@) 3 كلاب تغاوت أو لحيفة %~% وأحسبني أصبحت ألأمها كلبا(@)(@@) 4 أبينا سوى غش الصدور ، وإنما %~% ينال ، ثواب الله ، أسلمنا قلبا(@)(@@) 5 وأي بني الأيام يحمد قائل ، %~% ومن جرب الأقوام أوسعهم ثلبا(@)PageV01P679(@)(@@) البحر : بسيط تام(@)(@@) 1 من عثرة القوم أن كنوا وليدهم %~% أبا فلان ، ولم ينسل ولا بلغا(@)(@@) 2 كالسيف سمي قطاعا وما ضربت %~% به الأكف ، ولا في هامة ولغا(@)(@@) 3 قد هان مين على أفواهنا فغدا %~% ذو النسك غير مبال أن يكون لغا(@)(@@) 4 وأروح الرزق ما وافاك في دعة %~% حلا ، وقسم في أيامه بلغا(@)PageV01P680(@)(@@) البحر 
ms154	 : طويل(@)(@@) 1 إذا كان رعبي يورث الأمن فهو لي %~% أسر من الأمن ، الذي يورث الرعبا(@)(@@) 2 ألم تر أن الهاشميين بلغوا %~% عظام المساعي ، بعدما سكنوا الشعبا(@)(@@) 3 وكان الفتى ، كعب ، تخير للسرى ، %~% أخا النمر ، فاستدنى إلى أجل كعبا(@)(@@) 4 وإني رأيت الصعب يركب دائما %~% من الناس من لم يركب الغرض الصعبا(@)PageV01P681(@)(@@) البحر : طويل(@)(@@) 1 إذا شئت أن يرضى سجاياك ربها ، %~% فلا تمس من فعل المقادير مغضبا(@)(@@) 2 فإن قرون الخيل أولتك ناطحا %~% وإن الحسام العضب لقاك أعضبا(@)(@@) 4 خضبت بياضا بالصبيب ، صبابة %~% ببيضاء عدتك البنان المخضبا(@)(@@) 5 وما كان حبل العيش إلا معلقا %~% بعروة أيام الصبا فتقضبا(@)PageV01P682(@)(@@) البحر : رمل تام(@)(@@) 1 عد عن شارب كأس أسكرت ، %~% فهو مثل الكلب ، في الرجس ولغ(@)(@@) 2 والفتى ساع لأقصى أمد %~% لم يزل يطلبه حتى بلغ(@)PageV01P683(@)(@@) البحر : طويل(@)(@@) 1 إذا ما عراكم حادث ، فتحدثوا ! %~% فإن حديث القوم ينسي المصائبا(@)(@@) 2 وحيدوا عن الأشياء خيفة غيها ؛ %~% فلم تجعل اللذات إلا نصائبا(@)(@@) 3 وما زالت الأيام ، وهي غوافل ، %~% تسدد سهما للمنية صائبا(@)PageV01P684(@)(@@) البحر : بسيط تام(@)(@@) 1 ما كان في هذه الدنيا بنو زمن %~% إلا وعندي من أخبارهم طرف(@)(@@) 2 يخبر العقل أن القوم ما كرموا ، %~% ولا أفادوا ، ولا طابوا ، ولا عرفوا(@)(@@) 3 عاشوا قليلا ، وماجوا في ضلالتهم ، %~% ولا يفوزون إن جوزوا بما اقترفوا(@)(@@) 4 إذا شقيت فجسم ناله نصب ، %~% وإن ترفت فماذا ينفع الترف(@)(@@) 5 يا أم دفر ، لحاك الله والدة %~% منك الإضاعة والتفريط والسرف(@)(@@) 6 لو أنك العرس أوقعت الطلاق بها ، %~% لكنك الأم ، هلي لي عنك منصرف ؟(@)(@@) 7 ولن يصيب خفافا من يقايضه ، %~% يوما ، بندبة لما فاتها الشرف(@)(@@) 8 قالت رجال عقول الشهب وافرة ، %~% لو صح ذلك قلنا : مسها خرف(@)PageV01P685(@)(@@) البحر : بسيط تام(@)(@@) 1 إن يصحب الروح عقلي ، بعد مظعنها %~% للموت عني ، فأجدر أن ترى عجبا(@)(@@) 2 وإن مضت في الهواء الرحب هالكة %~% هلاك جسمي في تربي ، فوا شجبا(@)(@@) 3 الدين إنصافك الأقوام كلهم ، %~% وأي دين لآبي الحق إن وجبا(@)(@@) 4 والمرء يعييه قود النفس 
ms155	 ، مصبحة %~% للخير ، وهو يقود العسكر اللجبا(@)(@@) 5 وصومه الشهر ، ما لم يجن معصيتة ، %~% يغنيه عن صومه شعبان ، أو رجبا(@)(@@) 6 وما اتبعت نجيبا في شمائله ، %~% وفي الحمام تبعت السادة النجبا(@)(@@) 7 واحذر دعاء ظليم في نعامته ؛ %~% فرب دعوة داع تخرق الحجبا(@)PageV01P686(@)(@@) البحر : بسيط تام(@)(@@) 1 ينجمون ، وما يدرون لو سئلوا %~% عن البعوضة ، أنى منهم تقف(@)(@@) 2 وفرقتهم على علاتها ملل %~% وعند كل فريق أنهم ثقفوا(@)(@@) 3 دع البرية للخطبان تأكله ، %~% فإنهم كنعام فيه ينتقف(@)(@@) 4 ولو درت ، بمخازيهم ، بيوتهم ، %~% هوت عليهم ، ولم تنظرهم السقف(@)PageV01P687(@)(@@) البحر : بسيط تام(@)(@@) 1 لا تفرحن بفأل ، إن سمعت به ؛ %~% ولا تطير ، إذا ما ناعب نعبا(@)(@@) 2 فالخطب أفظع من سراء تأملها %~% والأمر أيسر من أن تضمر الرعبا(@)(@@) 3 إذا تفكرت فكرا ، لا يمازجه %~% فساد عقل صحيح ، هان ما صعبا(@)(@@) 4 فللب ، إن صح ، أعطى النفس فترتها %~% حتى تموت ، وسمى جدها لعبا(@)(@@) 5 وما الغواني الغوادي في ملاعبها %~% إلا خيالات وقت ، أشبهت لعبا(@)(@@) 6 زيادة الجسم عنت جسم حامله %~% إلى التراب ، وزادت حافرا تعبا(@)PageV01P688(@)(@@) البحر : بسيط تام(@)(@@) 1 لو كنتم أهل صفو قال ناسبكم : %~% ' صفوية ' فأتى باللفظ ما قلبا(@)(@@) 2 جند لإبليس في بدليس ، آونة ؛ %~% وتارة يحلبون العيش في حلبا(@)(@@) 3 طلبتم الزاد في الآفاق من طمع %~% والله يوجد حقا أينما طلبا(@)(@@) 4 ولست أعنى بهذا غير فاجركم ؛ %~% إن التقي ، إذا زاحمته ، غلبا(@)(@@) 5 كالشمس لم يدن من أضوائها دنس ، %~% والبدر قد جل عن ذم وإ ، ثلبا(@)(@@) 6 وما أرى كل قوم ضل رشدهم %~% ألا نظير النصارى أعظموا الصلبا(@)(@@) 7 ياآل إسرال ، هل يرجى مسيحكم %~% هيهات قد ميز الأشياء من خلبا(@)(@@) 8 قلنا أتانا ولم يصلب ، وقولكم %~% ما جاء بعد ، وقالت أمة صلبا(@)(@@) 9 جلبتم باطل التوراة ، عن شحط ؛ %~% ورب شر بعيد للفتى جلبا(@)(@@) 10 كم يقتل الناس ، ما هم الذي عمدت %~% يداه للقتل ، إلا أخذه السلبا PageV01P689(@)(@@) 11 بالخلف قام عمود الدين : طائفة %~% تبني الصروح ، وأخرى تحفر القلبا(@)PageV01P690(@)(@@) البحر : بسيط تام(@)(@@) 1 ألفكر حبل متى تمسك 
ms156	 على طرف %~% منه ، ينط بالثريا ذلك الطرف(@)(@@) 2 والعقل كالبحر ، ما غيضت غواربه %~% شيئا ، ومنه بنو الأيام تغترف(@)(@@) 3 أبني بجهلي دارا لست مالكها ، %~% أقيم فيها قليلا ثم أنصرف(@)(@@) 4 سرفت ، والله يرجى أن يسامحنا ، %~% وفي القديم خلا من أهله سرف(@)(@@) 5 أأنكر الله ذنبا خطه ملك %~% وبالذي خطه الإنسان أعترف ؟(@)(@@) 6 تقوي فيهدي إليك الزاد عن عرض %~% وتقتري الأرض جوالا فتقترف(@)(@@) 7 تروم رزقا بأن سموك متكلا ، %~% وأدين الناس من يسعى ويحترف(@)(@@) 8 يكفيك أدما بنحض ماء نابتة %~% وظلمك النحل ما يعطيكه الضرف(@)(@@) 9 إذا افتكرنا علمنا أن ذا ضعة %~% أعلى النجوم ، ولله انتهى الشرف(@)PageV01P691(@)(@@) البحر : بسيط تام(@)(@@) 1 الأمر أيسر مما أنت مضمره ، %~% فاطرح أذاك ، ويسر كل ما صعبا(@)(@@) 2 ولا يسرك ، إن بلغته ، أمل ؛ %~% ولا يهمك غربيب إذا نعبا(@)(@@) 3 إن جد عالمك الأرضي ، في نبأ %~% يغشاهم ، فتصور جدهم لعبا(@)(@@) 4 ما الرأ أمور الناس في عصر ، %~% ولا استقامت فذا أمنا وذا رعبا(@)(@@) 5 ولا يقوم على حق بنو زمن ، %~% من عهد آدم كانوا في الهوى شعبا(@)PageV01P692(@)(@@) البحر : بسيط تام(@)(@@) 1 حسب الفتى من أثام وفه رجلا %~% بالخير ، وهو على ضد الذي يصف(@)(@@) 2 وقد خبرت بني الدنيا ، فليتهم %~% أو ليتني حملتني عنهم العصف(@)(@@) 3 فظالم آخذ مالا يحل له %~% ومنصف ظل فيهم ليس ينتصف(@)PageV01P693(@)(@@) البحر : بسيط تام(@)(@@) 1 قد يسروا لدفين حان مصرعه %~% بيتا من الخشب لم يرفع ولا رحبا(@)(@@) 2 ياهؤلاء اتركوه والثرى فله %~% أنس به ، وهو أولى صاحب صحبا(@)(@@) 3 وإنما الجسم ترب ، خير حالته %~% سقيا الغمائم ، فاستسقوا له السحبا(@)(@@) 4 صار البهيج من الأقوام خط سفى %~% وقد يراع ' ذا ما وجهه شحبا(@)(@@) 5 سيان من لم يضق ذرعا بعيد ردى ، %~% وذارع في مغاني فتية سحبا(@)(@@) 6 فافرق من الضحك واحذر أن تحالفه ، %~% أما ترى الغيم لما استضحك انتحبا ؟(@)PageV01P694(@)(@@) البحر : بسيط تام(@)(@@) 1 خاب الذي سار عن دنياه مرتحلا ، %~% وليس في كفه من دينه طرف(@)(@@) 2 لا خير للمرء إلا خير آخرة %~% يبقي عليه 
ms157	 ، فذاك العز والشرف(@)(@@) 3 نرجو السلامة في العقبى وما حسنت %~% أعمالنا ، فيرجى الفوز والغرف(@)(@@) 4 ما بان قوم عن الأولى بما جمعوا %~% من الحطام ، ولكن بالذي اقترفوا(@)(@@) 5 سألت عقلي فلم يخبر ، فقلت له %~% سل الرجال فما أفتوا ولا عرفوا(@)(@@) 6 قالوا ، فمالوا ، فلما أن حدوتهم %~% إلى القياس ، أبانوا العجز واعترفوا(@)(@@) 7 جاران : ملك ومحتاج أتى زمن %~% عليهما ، فتساوى البؤس والترف(@)(@@) 8 إن تركب الخيل أو تضرب مراكبها %~% من عسجد ، فإلى الغبراء تنصرف(@)(@@) 9 والفقر أحمد من مال تبذره ، %~% إن افتقارك مأمون به السرف(@)(@@) 10 يعرى الفقير وبالدينار كسوته %~% وفي صوانك ، ما إعداده خرف(@)PageV01P695(@)(@@) البحر : بسيط تام(@)(@@) 1 من قلة اللب عند النصح أن تابى ؛ %~% وأن تروم من الأيام إعتابا(@)(@@) 2 خل الزمان وأهليه لشأنهم %~% وعش بدهرك ، والأقوام ، مرتابا(@)(@@) 3 سار الشباب ولم نعرف له خبرا ، %~% ولا رأينا خيالا منه منتابا(@)(@@) 4 وحق للعيس ، لو نالت بنا بلدا %~% فيه الصبا ، كون عود الهند أقتابا(@)(@@) 5 ألقى الكبير قميص الشرخ رهن بلى %~% ثم استجد قميص الشيب مجتابا(@)(@@) 6 ما زال ينطل دنياه بتوبته %~% حتى أتته مناياها ، وما تابا(@)(@@) 7 خط استواء بدا عن نقطة عجب %~% أفنت خطوطا ، وأقلاما ، وكتابا(@)PageV01P696(@)(@@) البحر : بسيط تام(@)(@@) 1 شكوت ، من أهل هذا العصر ، غدرهم %~% لا تنكرن فعلى هذا مضى السلف(@)(@@) 2 وما اعترافي بعيب الجنس منقصة ، %~% والعين يعرف في آنافها الذلف(@)(@@) 3 والإلف هان له أمري فقصر بي %~% كما تهون على ذي المنطق الألف(@)(@@) 4 أمسى النفاق دروعا يستجن بها %~% من الأذى ، ويقوي سردها الحلف(@)(@@) 5 أفني زماني بأنفاس ، كما قطعت %~% مدى بعيدا مواش في السرى دلف(@)(@@) 6 إذا تخلفت ، أو خلفت عن أمل %~% سلى همومي أني ليس لي خلف(@)(@@) 7 ترجى الحياة إذا كانت مودعة %~% وقل خير حياة ، حشوها كلف(@)(@@) 8 لم يمض كون من الأكوان في زمن %~% علي ، إلا به للحتف أزدلف(@)(@@) 9 فحسن الوعد بالإنجاز يتبعه %~% إذا مواعد قوم شأنها الخلف(@)(@@) 10 إنا ائتلفنا ، لأن الله ركبنا %~% من أربع ، ثم حرنا بعد نختلف 
ms158	 PageV01P697(@)(@@) 11 رأى بنو الحزم أن العيش فائدة %~% حتى استبانوا فقالوا حبذا التلف(@)(@@) 12 وقل أن تسكن الأضغان في خلد %~% إلا وفي وجه من يسعى بها كلف(@)PageV01P698(@)(@@) البحر : بسيط تام(@)(@@) 1 لو كنت رائد قوم ظاعنين إلى %~% دنياك هذي ، لما ألفيت كذابا(@)(@@) 2 لقلت : تلك بلاد نبتها سقم %~% وماؤها العذب سم للفتى ذابا(@)(@@) 3 هي العذاب ، فجدوا في ترحلكم %~% إلى سواها ، وخلوا الدار إعذابا(@)(@@) 4 وما تهذب يوم من مكارهها ، %~% أو بعض يوم ، فحثوا السير إهدابا(@)(@@) 5 خبرتكم بيقين غيير مؤتشب ، %~% ولم أكن في حبال المين جذبا(@)PageV01P699(@)(@@) البحر : بسيط تام(@)(@@) 1 طال التبسط منا في جوائحنا %~% وإنما نحن فوق الأرض أضياف(@)(@@) 2 يريد خل خليلا كي يوافقه %~% في الطبع ، هيهات ، إن الناس أخياف(@)(@@) 3 لولا التخالف لم تركض لغارتها %~% خيل ، ولم تقن أرماح وأسياف(@)PageV01P700(@)(@@) البحر : بسيط تام(@)(@@) 1 أترى أخوك فلم يسكب نوافله ، %~% وحل رزء ، فظل الدمع مسكوبا(@)(@@) 2 أما تبالي إذا علتك غانية %~% من كوبها ، الراح أن أصبحت منكوبا ؟(@)(@@) 3 أين الذين تولوا قبلنا فرطا ، %~% أما تسائل عمن بان أركوبا(@)PageV01P701(@)(@@) البحر : بسيط تام(@)(@@) 1 لو كنت يعقوب طير كنت أرشد ، في %~% مسعاك ، من أمم تنمى ليعقوبا(@)(@@) 2 ضلوا بعجل مصوغ من شنوفهم ، %~% فاستنكروا مسمعا للشنف مثقوبا(@)(@@) 3 ولن يقوم مسيح يجمعون له ، %~% وخلت واعدهم في الخلف عرقوبا(@)(@@) 4 وإن دنياك هذي مثل قائبة %~% وسوف يقطع منها ربها القوبا(@)(@@) 5 يغنيك منسوج باري ، تصان به ، %~% عن بسط محكمة ، من نسج قرقوبا(@)(@@) 6 فاحذر لصوص الأماني ، فهي سارقة ، %~% ردت ، عن الدين ، قلب المرء منقوبا(@)PageV01P702(@)(@@) البحر : بسيط تام(@)(@@) 1 الأرض لله ، ما استحيا الحلول بها %~% أن يدعوها ، وهم في الدار أضياف(@)(@@) 2 تنازعوا في عواري ، فبينهم %~% نبل حطام وأرماح وأسياف(@)(@@) 3 إن خالفوك ، ولم يجرر خلافهم %~% شرا ، فلا بأس أن الناس أخياف(@)PageV01P703(@)(@@) البحر : وافر تام(@)(@@) 1 صدقتك ، صاحبي ، لا مال عندي ، %~% وقد كثر الضيافن والضيوف(@)(@@) 2 أناس ، في أكفهم عصي ؛ %~% وقوم ، في أكفهم سيوف(@)(@@) 3 دراهمهم نقيات ، ولكن %~% نفوسهم إذا كشفت زيوف(@)(@@) 4 
ms159	 وما في الأرض من شرب كريم ، %~% يسر بورده الصادي العيوف(@)PageV01P704(@)(@@) البحر : بسيط تام(@)(@@) 1 إن كنت صاحب إخوان ومائدة ، %~% فاحب الطفيلي تأهيلا وترحيبا(@)(@@) 2 لا تلقينه بتعبيس لتوحشه %~% فالزاد يفنى ولا يبقي الأصاحيبا(@)(@@) 3 يقفو اللئيم كريم القوم مكتسبا %~% إن السراحين يتبعن السراحيبا(@)PageV01P705(@)(@@) البحر : وافر تام(@)(@@) 1 ألم تر أن جسمي فيه فضل %~% وجسمك قد أضر به الشسوف(@)(@@) 2 تطيب جاهدا وتعل دوني ، %~% فما أغناك أنك فيلسوف(@)(@@) 3 كأنا في يد الأيام مال %~% وكل المال عن قدر يسوف(@)(@@) 4 وأحسب أننا إبل رذايا ، %~% أجد ، وراءها ، حاد عسوف(@)(@@) 5 أسفت لفائت ، وسلوت عنه ، %~% وهل مثلي على ماض أسوف ؟(@)(@@) 6 لقد عشت الكثير من الليالي %~% ولم أرقب متى يقع الكسوف(@)(@@) 7 فهل لطوالع الأقمار عقل %~% فتعلم حين يدركها الخسوف ؟(@)(@@) 8 أتسمع أو تعاين أو تعاني %~% بلاء ، أو تذوق أو تسوف ؟(@)PageV01P706(@)(@@) البحر : بسيط تام(@)(@@) 1 لم يقدر الله تهذيبا لعالمنا %~% فلا ترومن للأقوام تهذيبا(@)(@@) 2 ولا تصدق بما البهان يبطله %~% فتستفيد من التصديق تكذيبا(@)(@@) 3 إن عذب الله قوما باجترامهم ، %~% فما يريد لأهل العدل تعذيبا(@)(@@) 4 يغدو على خله الإنسان يظلمه %~% كالذيب يأ : ل عند الغرة الذيبا(@)PageV01P707(@)(@@) البحر : وافر تام(@)(@@) 1 رددت إلى مليك الحق أمري ، %~% فلم أسأل متى يقع الكسوف(@)(@@) 2 فكم سلم الجهول من المنايا ، %~% وعوجل بالحمام الفيلسوف(@)PageV01P708(@)(@@) البحر : بسيط تام(@)(@@) 1 يا راعي المصر ! ما سومت في دعة ، %~% وعرسك الشاة ، فاحذر جارك الذيبا(@)(@@) 2 تروم تهذيب هذا الخلق من دنس ؛ %~% والله ما شاء للأقوام تهذيبا(@)(@@) 3 وما رويت بعذب حل في قلب %~% حتى تكلفت إعناتا وتعذيبا(@)(@@) 4 فاعرف ، لصادقك الأنباء ، موضعه ؛ %~% واجز الكذوب على ما قال تكذيبا(@)PageV01P709(@)(@@) البحر : كامل تام(@)(@@) 1 الناس مثل الماء تضربه الصبا ، %~% فيكون منه تفرق وتألف(@)(@@) 2 والخير يفعله الكريم بطبعه ، %~% وإذا اللئيم سخا فذاك تكلف(@)(@@) 3 قد يحسب الصمت الطويل من الفتى %~% حلما يوقر ، وهو فيه تخلف(@)(@@) 4 نرجو من الله الثواب مجازيا ، %~% وله علينا ، في القديم ، تسلف(@)PageV01P710(@)(@@) البحر : بسيط تام(@)(@@) 1 إن كنت يعسوب 
ms160	 أقوام فخف قدرا %~% ما زال كالطفل يصطاد اليعاسيبا(@)(@@) 2 وإن تكن بمنا سيب ، لمهلكة ، %~% فكم طوى الدهر أقيالا مناسيبا(@)PageV01P711(@)(@@) البحر : مجزوء الكامل(@)(@@) 1 ما لي رأيتك معرضا ، %~% فاسمع إذا نطق الحصيف(@)(@@) 2 الدهر ليس بمنصف ، %~% والعيب يستره النصيف(@)(@@) 3 والأرض أم برة ، %~% والسهم عن غرض يصيف(@)(@@) 4 إنا شتونا فوقها %~% ولعلنا فيها نصيف(@)(@@) 5 فالبث وحيدا ، لا وصيفة %~% في ذراك ، ولا وصيف(@)(@@) 6 تأذى الأصول الثابتا %~% ت ، فيحسد الغصن القصيف(@)PageV01P712(@)(@@) البحر : وافر تام(@)(@@) 1 إذا كانت لك امرأة عجوز ، %~% فلا تأخذ بها أبدا كعابا(@)(@@) 2 فإن كانت أقل بهاء وجه ، %~% فأجدر أن تكون أقل عابا(@)(@@) 3 وحسن الشمس في الأيام باق %~% وإن مجت ، من الكبر ، اللعابا(@)PageV01P713(@)(@@) البحر : سريع(@)(@@) 1 غرك سود الشعرات التي %~% في الوجه مني وأنا الدالف(@)(@@) 2 كلفتني شيمة عصر مضى ، %~% هيهات منك العصر السالف(@)(@@) 3 وقد سئمنا زمنا مؤذيا %~% أروح من سالمه التالف(@)(@@) 4 يحلف : لا أبقي على واحد %~% وبر في أيمانه الحالف(@)PageV01P714(@)(@@) البحر : كامل تام(@)(@@) 1 لا تكذبن ، فإن فعلت ، فلا تقل %~% كذبا على رب السماء تكسبا(@)(@@) 2 فالله فرد قادر ، من قبل أن %~% تدعى لآدم صورة ، أو تحسبا(@)(@@) 3 وإذا انتسبت فقلت إني واحد %~% من خلقه ، فكفى بذاك تنسبا(@)(@@) 4 أششباح إنس يخضبون صوارما %~% تحت العجاج ، ويركضون الشسبا(@)(@@) 5 ويمارسون من الظلام غياهبا %~% ويواصلون ، فيقطعون السبسبا(@)(@@) 6 ومرادهم عذب خسيس قدره %~% شربوا له مقرا لكيما يلبسا(@)(@@) 7 ولقد علمت ، فما التمضر نافعي ، %~% أني سأتبع نيسبا ، لابني سبا(@)(@@) 8 سبأ المدامة ، فاستدام مسرة ، %~% فيما يظن ، ولم يرع لما سبى(@)(@@) 9 روح ، إذا رحلت عن الجسم الذي %~% سكنت به ، فمآله أن يرسبا(@)PageV01P715(@)(@@) البحر : كامل تام(@)(@@) 1 لو أنني سميت طيفك صادقا %~% لدعوته غضبان ، أو عتابا(@)(@@) 2 قال الخيال : كذبت لست بطارق %~% ليلا ، ولم أك زائرا منتابا(@)(@@) 3 فأجبته : كم من كتاب زائر ؛ %~% فاهتاج يحلف : ما بعثت كتابا(@)(@@) 4 لا تثبت الأقلام زلة راقد %~% إن كنت بت بحلمه مرتابا(@)(@@) 5 لم يعف ربك عن مصر ، مارد ، %~% لكن تجاوز 