ms21	 وهو ذليل % 8(@)(@@) % أي طرف سما إليكم بكيد % لم تردوه وهو منكم كليل % 9(@)(@@) % أي حد كافحتموه بحد % منكم لم يدعه وهو فليل % 10(@)(@@) % كنتم والكثير فيكم قليل % والعظيم الخطير فيكم ضئيل % PageV01P091 11(@)(@@) % كنتم الهامة التي لو أزالت % أوجه الدهر لم تقل لا أزول % 12(@)(@@) % كنتم أهل سطوة إن تصدت % مال وجه الحمام حيث تميل % 13(@)(@@) % أقليل عديدكم فتقولوا % % إننا في الوغى نفير قليل % 14(@)(@@) % أم ضعاف عن ثأركم فتلذوا % % مشرب الذل والضعيف الذليل % 15(@)(@@) % أنساء ينعى لهن بعول % إن ستر المحصنات البعول % 16(@)(@@) % أم عبيد لراشد ولموسى % % أي هذي الأصناف أنتم فقولوا % % 17(@)(@@) % ليس ينعى لها امرؤ وسدته % معصميها الوهنانة العطبول % 18(@)(@@) % لا ولا المحسن الظنون ب % ريب الدهر أن سوف ينثني ويدول % 19(@)(@@) % يا بني مالك عقلتم لساني % % كيف يمشي المقيد المعقول % 20(@)(@@) % إن سلكتم إلى الفعال سبيلا % وضحت لي إلى المقال سبيل % PageV01P092 21(@)(@@) % أو تأبيتم شكلت عن الجر % ي وهل يبلغ المدى المشكول % 22(@)(@@) % أين عن ثارها هناة فروع ال % % عز أم أين كهفه المأمول % 23(@)(@@) % أين معن وهم إذا استحمس البأ % % س ليوث تنجاب عنها الفيول % 24(@)(@@) % وبنو جهضم وهم جبل العز % الذي عز فرعه المستطيل % 25(@)(@@) % أين دعوى بني سليمة أطوا % % د المعالي فتيانها والكهول % 26(@)(@@) % والجراميز حصننا الأمنع الرك % ن ومن في الوغى إليه نؤول % 27(@)(@@) % والعقاة الذين يستدفع اليأ % % س بهم وهو مقمطر مهيل % 28(@)(@@) % وحمام حماتها حين لا يع % طف إلا المضمر الخنشليل % 29(@)(@@) % وفراهيدنا الذين على الرو % ضة من خيلهم دماء تسيل % 30(@)(@@) % وحماة الزمان من آل دهما % % ن إذا أبرز البرى والحجول % PageV01P093 31(@)(@@) % وعمادي من آل سيد إذا ما % % شمر الحرب والمنايا نزول % 32(@)(@@) % وسليمى الباسلون إذا أب % % لس ذو العد والنجيد البسول % 33(@)(@@) % وشريك فتيانها حين لا ين % فع إلا المهند المسلول % 34(@)(@@) % والمداريك للذحول بنو قس % % مل إن خفت أن يفوت الذحول % 35(@)(@@) % وبنو العم من جديد خصوصا % وعمادي في كل أمر نفيل % 36(@)(@@) % وبنو حاضر يدي ولساني 
ms22	 % % وحسامي المهند المصقول % 37(@)(@@) % يا بني مالك بن فهم قتيلا % بدهاريس عزهن التبول % 38(@)(@@) % إن بالروضتين هاما نزافا % لم يقل من ثوى هناك قتيل % 39(@)(@@) % أتضيع الدماء يا قوم فزعا % لا بواء ولا دم مطلول % 40(@)(@@) % وبطودي عمان والسيف منكم % عدد كاثر وعز بجيل % PageV01P094 41(@)(@@) % لبني السامة السمو على الخس % % ف بما نالكم من الذل نيلوا % % 42(@)(@@) % لأشمأزت قلوبها ولأضحى % % نابئ الأهل ربعها المأهول % 43(@)(@@) % أفترضون أن تساموا الذي سي % % موه عن سوم مثله ستصولوا % % 44(@)(@@) % يا ابن حمحام للعلى شمر ال % % ذيل فلا حين أن تجر الذيول % 45(@)(@@) % ليس شأن الموترين مهاد % وغناء ومزهر وشمول % 46(@)(@@) % وصبوح مباكر وغبوق % وشواء ودرمك ونشيل % 47(@)(@@) % إنما ثوبه إذا اعتكر الإظ % % لام ثوب الدجنة المسدول % 48(@)(@@) % ومهاده نمرق فوق كفل % عرشه غيهم البجاد مثول % 49(@)(@@) % ونديماه داثر الحد عضب % وأمين الفصوص نهد ذليل % 50(@)(@@) % وأكيلاه نهدة أم أجر % والطريد العشنق الهذبول % PageV01P095 51(@)(@@) % ذلك الثأر لا الذي وهلته % نومة الصبح فهو رخو مذيل % 52(@)(@@) % يا سليمان جرد العزم قدما % تدرك الوتر منجدا وهو نول % 53(@)(@@) % يا فراهيد أنت نجم المساعي % % أنتم العدة الحماة النصول % 54(@)(@@) % يا سليم بن مالك المنتمي قد % هدنا السيد العميد القتيل % 55(@)(@@) % قد أوصاله حلفت يمينا % % ليس فيها لمقسم تحليل % 56(@)(@@) % لو تغاضت عنه المنون لأضحى % % يهتدي بالرعيل عنه الرعيل % 57(@)(@@) % ما تضيع الدماء ما طالبتها % % فيهم سهمة وصبر جميل % 58(@)(@@) % أي يوم لراشد ولموسى % % ذاك يوم لو تعلمون ثقيل % 59(@)(@@) % يوم لا ينفع اتصال بقربى % % يوم لا العذر عنده مقبول % 60(@)(@@) % فلحى الله مانع الروع منا % % حيث يستصحب الضئيل الضئيل % PageV01P096 البحر : مديد تام 1(@)(@@) % لا يفوت الموت من حذر % - إن وقاه الغاب والغيل - % 2(@)(@@) % مفرع الأكتاف ذو لبد % مترص الأوصال مجدول % 3(@)(@@) % إن دهرا فل حدهم % حده لا بد مفلول % 4(@)(@@) % ما بكاهم إن هم قتلوا % % صبرهم للقتل تفضيل % 5(@)(@@) % إنما أخبرت الحرب بأن % نالهم قوم أراذيل % 6(@)(@@) % نالهم من لا يحصله % في كرام القوم تحصيل % 7(@)(@@) % أعبد 
ms23	 قن يصادرهم % قوم أسود تنابيل % 8(@)(@@) % فرأوا أن يهربوا طرا % والطرد ما فيه تمهيل % 9(@)(@@) % بمشيج ثالط ودم % أخلصت منه السراويل % 10(@)(@@) % قيل والمقدار يحرسه % فنجا والسرج مبلول % PageV01P097 البحر : طويل 1(@)(@@) % جهلت فعاديت العلوم وأهلها % % كذاك يعادي العلم من هو جاهله % 2(@)(@@) % ومن كان يهوى أن يرى متصدرا % ويكره لا أدري أصيبت مقاتله % PageV01P098 البحر : سريع 1(@)(@@) % كم عاقل أخره عقله % وجاهل صدره جهله % PageV01P099 البحر : مجزوء الكامل 1(@)(@@) % الناس مثل زمانهم % قد الحذاء على مثاله % 2(@)(@@) % ورجال دهرك مثل ده % رك في تقلبه وحاله % 3(@)(@@) % وكذا إذا فسد الزما % % ن جرى الفساد على رجاله % PageV01P100 البحر : طويل 1(@)(@@) % أرى الشيب مذ جاوزت خمسين دائبا % يدب دبيب الصبح في غسق الظلم % 2(@)(@@) % هو السقم إلا أنه غير مؤلم % ولم أر مثل الشيب سقما بلا ألم % PageV01P101 البحر : طويل 1(@)(@@) % على أي رغم ظلت أغضي وأكظم % وعن أي حزن بات دمعي يترجم % 2(@)(@@) % أجدك ما تنفك ألسن عبرة % تصرح عما كنت عنه تجمجم % 3(@)(@@) % كأنك لم تركب غروب فجائع % شباهن من هاتا أحد وأكلم % 4(@)(@@) % بلى غير أن القلب ينكؤه الأسى ال % % ملم وإن جل الجوى المتقدم % 5(@)(@@) % وكم نكبة زاحمت بالصبر ركنها % % فلم يلف صبري واهيا حين يزحم % 6(@)(@@) % ولو عارضت رضوى بأيسر درئها % % لظل ذرى أقذافها تتهدم % 7(@)(@@) % وقد عجمتني الحادثات فصادفت % صبورا على مكروهها حين تعجم % 8(@)(@@) % ومن يعدم الصبر الجميل فإنه % وجدك لا من يعدم الوفر معدم % 9(@)(@@) % أصارفة عني بوادر حدها % % فجائع للعلياء توهي وتحطم % 10(@)(@@) % لها كل يوم في حمى المجد وطأة % تظل لها أسبابه تتجذم % PageV01P102 11(@)(@@) % إذا أجشمت جياشة مصمئلة % قفت إثرها دهياء صماء صيلم % 12(@)(@@) % أم الدهر - أن لن تستفيق صروفه % مصرفة نحوي فجائع - يقسم % 13(@)(@@) % وساءلت عن حزم أضيع وهفوة % أطيعت وقد ينبو الحسام المصمم % 14(@)(@@) % فلا تشعري لذع الملام فؤاده % فإنك ممن رعت باللوم ألوم % 15(@)(@@) % ولم تر ذا حزم وعزم وحنكة % على القدر الجاري عليه يحكم % 16(@)(@@) % متى دفع المرء الأريب بحيلة % بوادر ما 
ms24	 يقضى عليه فيبرم % 17(@)(@@) % ولو كنت محتالا على القدر الذي % % نبابي لم أسبق بما هو أحزم % 18(@)(@@) % ولكن من تملك عليه أموره % فمالكها يمضي القضاء فيحتم % 19(@)(@@) % وما كنت أخشى أن تضاءل همتي % % فأضحي على الاجن الصرى أتلوم % 20(@)(@@) % كأن نجيا كان يبعث خاطري % % قرين إسار أو نزيف مهوم % PageV01P103 21(@)(@@) % وما كنت أرضى بالدناءة خطة % ولي بين أطراف الأسنة مقدم % 22(@)(@@) % وما ألفت ظل الهوينا صريمتي % % وكيف وحداها من السيف أصرم % 23(@)(@@) % ألم تر أن الحر يستعذب المنى % % تباعده من ذلة وهي علقم % 24(@)(@@) % ويقذف بالأجرام بين بها الردى % % إذا كان فيه العز لا يتلعثم % 25(@)(@@) % سأجعل نفسي للمتالف عرضة % وأقذفها للموت والموت أكرم % 26(@)(@@) % بأرضك فارتع أو إلى القبر فارتحل % فإن غريب القوم لحم موضم % 27(@)(@@) % تندمت والتفريط يجني ندامة % ومن ذا على التفريط لا يتندم % 28(@)(@@) % يصانع أو يغضي العيون عن القذى % % ويلذع بالمرى فلا يترمرم % 29(@)(@@) % على أنني - والحكم لله - واثق % بعزم يفض الخطب والخطب مبهم % 30(@)(@@) % وقلب لو أن السيف عارض صدره % لغادر حد السيف وهو مثلم % PageV01P104 31(@)(@@) % إلى مقول ترفض عن عزماته % أوابد للصم الشوامخ تقضم % 32(@)(@@) % صوائب يصرعن القلوب كأنما % % يمج عليها السم أربد أرقم % 33(@)(@@) % وما يدري الأعداء من متدرع % % سرابيل حتف رشحها المسك أ % 34(@)(@@) % بل نجيد بين أحناء سرجه % شهاب وفي ثوبيه أضبط ضيغم % 35(@)(@@) % إذا الدهر أنحى نحوه حد ظفره % ثناه وظفر الدهر عنه مقلم % 36(@)(@@) % وإن عضه خطب تلوى بنابه % وأقلع عنه الخطب والناب أدرم % 37(@)(@@) % ولم تر مثلي مغضبا وهو ناظر % ولم تر مثلي صامتا يتكلم % 38(@)(@@) % بالشعر يبدي المرء صفحة عقله % فيعلن منه كل ما كان يكتم % 39(@)(@@) % وسيان من لم يمتط اللب شعره % فيملك عطفيه وآخر مفحم % 40(@)(@@) % جوائب أرجاء البلاد مطلة % تبيد الليالي وهي لا تتخرم % PageV01P105 41(@)(@@) % ألم تر ما أدت إلينا وسيرت % على قدم الأيام عاد وجرهم % 42(@)(@@) % هم اقتضبوا الأمثال صعبا قيادها % % فذل لهم منها الشريس الغشمشم % 43(@)(@@) % وقالوا الهوى يقظان والعقل راقد 
ms25	 % وذو العقل مذكور وذو الصمت أسلم % 44(@)(@@) % ومما جرى كالوسم في الدهر قولهم % على نفسه يجني الجهول ويجرم % 45(@)(@@) % وكالنار في يبس الهشيم مقالهم % ألا إن أصل العود من حيث يقضم % 46(@)(@@) % % فصيح على وجه الزمان وأعجم % PageV01P106 البحر : متقارب تام 1(@)(@@) % بنا لا بك الوصب المؤلم % ونفسك من صرفه تسلم % 2(@)(@@) % لئن نال جسمك نهك الضنى % % لقد ضني السؤدد الأعظم % 3(@)(@@) % فحاشاك من سقم عارض % ولكن أكبادنا تسقم % 4(@)(@@) % فأنت السماء التي ظلها % % إذا زال أعقبه الصيلم % 5(@)(@@) % وأنت الصباح الذي نوره % به ينجلي الحادث المظلم % 6(@)(@@) % وأنت الغمام التي سيبه % ينال الثراء به المعدم % 7(@)(@@) % يخاطب عنك لسان العلى % % إذا ذكر المفضل المنعم % 8(@)(@@) % فمن نال من كرم رتبة % فيومك من دهره أكرم % 9(@)(@@) % إذا ما تخطاك صرف الردى % % فركن المكارم لا يهدم % 10(@)(@@) % فبالله أقسم رب الورى % % ولله غاية ما يقسم % PageV01P107 11(@)(@@) % لو أن السماء حمت قطرها % % لكنت حيا سيبه مثجم % PageV01P108 البحر : كامل تام 1(@)(@@) % صارمته فتواصلت أحزانه % وهجرته فتهاجرت أجفانه % 2(@)(@@) % قالت تعرض : مس شيطان به ! % بل أنت حين ملكته شيطانه % 3(@)(@@) % قد ضل عنه فؤاده فاستخبري % % عينيك أين محله ومكانه % PageV01P109 البحر : كامل تام 1(@)(@@) % وإذا قرأت كلامه قدرته % سحبان أو يوفي على سحبان % 2(@)(@@) % لو كان شاهده معد خاطبا % وذوو الفصاحة من بني قحطان % 3(@)(@@) % لأقر كل طائعين بأنه % أولاهم بفصاحة وبيان % 4(@)(@@) % هادي الأنام من الضلالة والعمى % % ومجيرها من جاحم النيران % 5(@)(@@) % رب العلوم إذا أجال قداحه % لم يختلف في فوزهن اثنان % 6(@)(@@) % ذو فطنة في المشكلات وخاطر % أمضى وأنفذ من شباة سنان % 7(@)(@@) % وإذا تفكر عالم في كتبه % يبغي التقى وشرائط الإيمان % 8(@)(@@) % متبينا للدين غير مقلد % يسمو بهمته إلى الرضوان % 9(@)(@@) % أضحت وجوه الحق في صفحاتها % % ترمي إليه بواضح البرهان % 10(@)(@@) % من حجة ضمن الوفاء بنصرها % % نص الرسول ومحكم القرآن % PageV01P110 11(@)(@@) % ودلالة تجلو مطالع سيرها % % غر القرائح من ذوي الأذهان % 12(@)(@@) % حتى ترى متبصرا في دينه % مفلول غرب الشك بالإيقان % 13(@)(@@) % الله وفقه 
ms26	 اتباع رسوله % وكتابه الأصلين في التبيان % 14(@)(@@) % وأمده من عنده بمعونة % حتى أناف بها عن الأعيان % 15(@)(@@) % وأراه بطلان المذاهب قبله % ممن قضى بالرأي والحسبان % PageV01P111 البحر : وافر تام 1(@)(@@) % أمن نحو العقيق شجاك برق % كأن وميضه رجع الجفون % 2(@)(@@) % أيا برق العقيق أقم فمالي % % سواك على الصبابة من معين % 3(@)(@@) % أحن إلى العقيق وساكنيه % وما يخلو المتيم من حنين % PageV01P112 البحر : مجتث 1(@)(@@) % عفظير إنا اختلفنا % % في الفعل من فاعلين % 2(@)(@@) % فقال قوم يثنى % % لجمعنا الهمزتين % 3(@)(@@) % وقال قوم يعدى % % بملتقى الساكنين % 4(@)(@@) % وأنت أعلم منا % % بذا وذاك وذين % 5(@)(@@) % لأنك الدهر فعل % يعتل من جهتين % PageV01P113 البحر : بسيط تام 1(@)(@@) % الله يعلم والراضي وشيعته % أن الوزارة لفظ أنت معناه % PageV01P114 البحر : سريع 1(@)(@@) % لو أنزل الوحي على نفطويه % % لكان ذاك الوحي سخطا عليه % % 2(@)(@@) % وشاعر يدعى بنصف اسمه % مستأهل للصفع في أخدعيه % % 3(@)(@@) % أف على النحو وأربابه % قد صار من أربابه نفطويه % % 4(@)(@@) % أحرقه الله بنصف اسمه % وصير الباقي صراخا عليه % % PageV01P115 البحر : رجز تام 1(@)(@@) % ما طاب فرع لا يطيب أصله % حمى مؤاخاة اللئيم فعله % 2(@)(@@) % وكل من واخى لئيما مثله % % 3(@)(@@) % من أمن الدهر أتي من مأمنه % لا تستثر ذا لبد من مكمنه % 4(@)(@@) % وكل شيء يبتغى في معدنه % % 5(@)(@@) % لكل ناع ذات يوم ناعي % % وإنما السعي بقدر الساعي % % 6(@)(@@) % قد يهلك المرعي عتب الراعي % % 7(@)(@@) % من ترك القصد تضق مذاهبه % دل على فعل امرئ مصاحبه % 8(@)(@@) % لا تركب الأمر وأنت عائبه % % 9(@)(@@) % مالك إلا ما عليك مثله % لا تحمدن المرء ما لم تبله % 10(@)(@@) % والمرء كالصورة لولا فعله % % PageV01P116 11(@)(@@) % يا ربما أورثت اللجاجه % ما ليس للمرء إليه حاجه % 12(@)(@@) % وضيق أمر يتبع انفراجه % % 13(@)(@@) % كم من وعيد يخرق الآذانا % % كأنما ينبأ به سوانا % % 14(@)(@@) % أصمنا الإهمال أم أعمانا % % 15(@)(@@) % يجل ما يؤذي وإن قل الألم % ما أطول الليل على من لم ينم % 16(@)(@@) % وسقم عقل المرء من شر السقم % % 17(@)(@@) % ما منك من لم يقبل المعاتبه % وشر أخلاق الفتى المواربه 
ms27	 % 18(@)(@@) % يكفيك مما تكره المجانبه % % 19(@)(@@) % متى تصيب الصاحب المهذبا % % هيهات ما أعسر هذا مطلبا % % 20(@)(@@) % وشر ما طلبته ما استصعبا % % PageV01P117 21(@)(@@) % لا يسلك الخير سبيل الشر % والله يقضي ليس زجر الطير % 22(@)(@@) % كم قمر عاد إلى قمير % % 23(@)(@@) % لم يجتمع جمع لغير بين % لفرقة كل اجتماع اثنين % 24(@)(@@) % يعمى الفتى وهو بصير العين % % 25(@)(@@) % الصمت إن ضاق الكلام أوسع % لكل جنب ذات يوم مصرع % 26(@)(@@) % كم جامع لغيره ما يجمع % % 27(@)(@@) % ما لك إلا ما بذلت مال % في طرفة العين تحول الحال % 28(@)(@@) % ودون آمال الورى الآجال % % 29(@)(@@) % كم قد بكت عين وأخرى تضحك % وضاق من بعد اتساع مسلك % 30(@)(@@) % لا تبرمن أمرا عليك يملك % % PageV01P118 31(@)(@@) % خير الأمور ما حمدت غبه % لا يرهب المذنب إلا ذنبه % 32(@)(@@) % والمرء مغرور بمن أحبه % % 33(@)(@@) % كل مقام فله مقال % كل زمان فله رجال % 34(@)(@@) % وللعقول تضرب الأمثال % % 35(@)(@@) % دع كل أمر منه يوما يعتذر % خف كل ورد غير محمود الصدر % 36(@)(@@) % لا تنفع الحيلة في ماضي القدر % % 37(@)(@@) % نوم الفتى خير له من يقظه % لم ترضه فيها الكرام الحفظه % 38(@)(@@) % وفي صروف الدهر للناس عظه % % 39(@)(@@) % مسألة الناس لباس ذل % من عف لم يسأم ولم يمل % 40(@)(@@) % فارض من الأكثر بالأقل % % PageV01P119 41(@)(@@) % جواب سوء المنطق السكوت % قد أفلح المتئد الصموت % 42(@)(@@) % ما حم من رزقك لا يفوت % % 43(@)(@@) % في كل شيء عبرة لمن عقل % قد يسعد المرء إذا المرء اعتدل % 44(@)(@@) % يرجو غدا ودون ما يرجو الأجل % % 45(@)(@@) % كم زاد في ذنب جهول عذره % دع أمر من أعيى عليك أمره % 46(@)(@@) % يخشى امرؤ شيئا ولا يضره % % 47(@)(@@) % رأيت غب الصبر مما يحمد % وإنما النفس كما تعود % 48(@)(@@) % وشر ما يطلب ما لا يوجد % % 49(@)(@@) % لا يأكل الإنسان إلا ما رزق % ما كل أخلاق الرجال تتفق % 50(@)(@@) % هان على النائم ما يلقى الأرق % % PageV01P120 51(@)(@@) % من يلدغ الناس يجد من يلدغه % لا يعدم الباطل حقا يدمغه % 52(@)(@@) % لسان ذي الجهل وشيكا يوثقه % % 53(@)(@@) % كل 
ms28	 زمان فله نوابغ % والحق للباطل ضد دامغ % 54(@)(@@) % يغضك المشرب وهو سائغ % % 55(@)(@@) % لا خير في صحبة من لا ينصف % والدهر يجفو مرة ويلطف % 56(@)(@@) % كأن صرف الدهر برق يخطف % % 57(@)(@@) % رب صباح لامرىء لم يمسه % حتف الفتى موكل بنفسه % 58(@)(@@) % حتى يحل في ضريح رمسه % % 59(@)(@@) % إني أرى كل جديد بال % وكل شيء فإلى زوال % 60(@)(@@) % فاستشف من جهلك بالسؤال % % PageV01P121 61(@)(@@) % إنك مربوب مدين تسأل % والدهر عن ذي غفلة لا يغفل % 62(@)(@@) % حتى يجيء يومه المؤجل % % PageV01P122 البحر : كامل تام 1(@)(@@) % أبقيت لي سقما يمازج عبرتي % % من ذا يلذ مع السقام لقاء % 2(@)(@@) % أشمت بي الأعداء حين هجرتني % % حاشاك مما يشمت الأعداء % 3(@)(@@) % أبكيتني حتى ظننت بأنني % % سيصير عمري ما حييت بكاء % 4(@)(@@) % أخفي وأعلن باضطرار إنني % % لا أستطيع لما أجن خفاء % PageV01P123 البحر : طويل 1(@)(@@) % بقلبي لذع من هواك مبرح % نعم دام ذاك اللذع ما عشت للقلب % 2(@)(@@) % بك استحسنت نفسي الصبابة والصبا % % وقد كنت قبل اليوم أزري على الصب % 3(@)(@@) % بذلت له الدمع الذي كنت صائنا % لأدناه إلا في الجليل من الخطب % 4(@)(@@) % بليت ببعض الحب والحب موعدي % % مجاورة بعد المنية في الترب % PageV01P124 البحر : وافر تام 1(@)(@@) % تمنيت المنية يوم قالوا % % غدا مجموع شملكم شتيت % 2(@)(@@) % تعيش صبابتي ويموت صبري % % ونفسي لا تعيش ولا تموت % 3(@)(@@) % تراءى لي الأسى فصدفت عنه % فقال إليك إنك لا تفوت % 4(@)(@@) % تكلم ماء عيني عن فؤادي % % وقلبي من سجيته السكوت % PageV01P125 البحر : طويل 1(@)(@@) % ثوى بين أثناء الحشا منك لوعة % يجد بنفسي شوقها وهو يعبث % 2(@)(@@) % ثللت الهوى إن كنت أكره ق ربه % على أنه الداء الذي لا يلبث % 3(@)(@@) % ثنى قلبه لما ثنت عنه طرفها % % على مضض أحشاؤه منه تفرث % 4(@)(@@) % ثقي بجفون إن دعا ماءها الهوى % % بذكرك يوما أقبلت لا تمكث % PageV01P126 البحر : طويل 1(@)(@@) % جريء على قتل النفوس وإنه % ليجزع من لبس الحرير ويهرج % 2(@)(@@) % جرى خاطر بالوهم يوما بحبه % فظل لوهمي خده يتضرج % 3(@)(@@) % جمال يغض الطرف عنه جلالة % وفعل من 
ms29	 البين المشتت أسمج % 4(@)(@@) % جلا وجهه لليل في غسق الدجى % % فناب عن الإصباح والليل أدعج % PageV01P127 البحر : طويل 1(@)(@@) % حماه الكرى طيف يهم بجفنه % ويبعث ماء العين فهو سفوح % 2(@)(@@) % حرام على عين يسامرها البكا % % وجفن رماه الوجد فهو قريح % 3(@)(@@) % حرام على ماء السلو وللهوى % % خواطر تغدو نحوه وتروح % 4(@)(@@) % حوى غاية البلوى فؤاد معذب % طوى عنه صد حبه ونزوح % PageV01P128 البحر : خفيف تام 1(@)(@@) % خامرت قلبه هموم تلظت % نارها في الحشا فليست تبوح % 2(@)(@@) % خفيت في الفؤاد ثم أذاعت % لدموع تجيش ثم تسوخ % 3(@)(@@) % خاف نأي الحبيب فاستصرخ الدم % ع وماء الجفون نعم الصريخ % 4(@)(@@) % خنت من لو دعوته وهو ميت % ظل يصغي مسارعا ويصيخ % PageV01P129 البحر : طويل 1(@)(@@) % دعا دمعه الشوق المبرح دعوة % فأقبل لا يلوي ولا يتردد % 2(@)(@@) % دموع هي الماء الزلال وتحته % تضرم وجد جمره يتوقد % 3(@)(@@) % دواء فؤاد أنت أعظم دائه % لقاؤك والعذال عني رقد % 4(@)(@@) % دنوت فكافى بالدنو تباعدا % فحتى متى أدنو إليه ويبعد % PageV01P130 البحر : خفيف تام 1(@)(@@) % ذاب من فرط شوقه القلب حتى % % عاد مما عراه وهو حنيذ % 2(@)(@@) % ذقت طعم الهوى مع الهجر مرا % وهو إن مازج الوصال لذيذ % 3(@)(@@) % ذرع صبري يضيق إن مارس الشو % % ق فصبري إليك منه يعوذ % 4(@)(@@) % ذاع ما كنت كاتما من جوى الح % % ب الذي ضمه الفؤاد الوقيذ % PageV01P131 البحر : خفيف تام 1(@)(@@) % رب ليل أطاله ألم الشو % % ق وفقد الرقاد وهو قصير % 2(@)(@@) % راع فيه الكرى ، تباريح شوق % وخيال جنح الظلام يزور % 3(@)(@@) % راقه منظر أنار فأورى % % لسناه ضوء الصباح المنير % 4(@)(@@) % رشأ يقتل الأسود غرير % كيف يردي الأسود ظبي غرير % PageV01P132 البحر : خفيف تام 1(@)(@@) % زافرات للقلب فيها إذا ما % % ضرمتها الهموم فيه - أزيز % 2(@)(@@) % زعموا أن من يحب ذليل % فكذا كل من يحب عزيز % 3(@)(@@) % زار تحت الكرى فسهل أمرا % كان إن رمت وهو صعب حريز % 4(@)(@@) % زلت في أمره أكفكف دمعا % ساقه للجفون شوق حميز % PageV01P133 البحر : خفيف تام 1(@)(@@) % سيرة الوامق انقياد إذا قي % % د ذلولا 
ms30	 وهو الجموح الشريس % 2(@)(@@) % سيم خسفا فقال إن كان حظي % % منهم الضيم فهو حظ نفيس % 3(@)(@@) % ساعدت عينه الفؤاد فجادت % فهي غرقى ونورها مطموس % 4(@)(@@) % سئمت نفسه الحياة وأكدر % بحياة إذا اجتوتها النفوس % PageV01P134 البحر : خفيف تام 1(@)(@@) % شاب ماء الجفون بالدم شوق % ملأ القلب منه فهو يجيش % 2(@)(@@) % شفه الهم فهو نضو سقيم % أي نفس مع الهموم تعيش % 3(@)(@@) % شقيت بالسهاد مقلة حب % بات والجمر تحته مفروش % 4(@)(@@) % شام برقا يحدو الردى فحداه % لورود الحمام حاد كميش % PageV01P135 البحر : طويل 1(@)(@@) % صواب لعيني أن تصوب دموعها % % وقد شمرت بالظاعنين القلائص % 2(@)(@@) % صرفت إليهم طرف عين سخينة % وإنسانها في لجة الدمع غائص % 3(@)(@@) % صباحا وقد طالت دوين شخوصهم % فساح الفيافي والأكام الشواخص % 4(@)(@@) % سباك ولا يغلب عليك وقد بدا % % شعاع مشيب في المفارق وابص % PageV01P136 البحر : وافر تام 1(@)(@@) % ضمان أن يكنف مذ تولى % % وقلبي من تذكره مريض % 2(@)(@@) % ضنيت وكيف لا يضنى محب % يشرد نومه دمع يفيض % 3(@)(@@) % ضميري مرتع الأحزان دهري % % وطرفي عن سوى سكني غضيض % 4(@)(@@) % ضرام الشوق في أثناء قلبي % % وبين جوانحي جمر قضيض % PageV01P137 البحر : خفيف تام 1(@)(@@) % طاب فقد الحياة بعد أناس % شط بي عنهم المحل الشحيط % 2(@)(@@) % طال من بعدهم مطال همومي % % حظ قلبي منها الجوى والنحيط % 3(@)(@@) % طاف والليل مدلهم الحواشي % % طارق للرقاد عني محيط % 4(@)(@@) % طوقتني الدجى يدا لا تجازى % % عشر معشارها بشكري محيط % PageV01P138 البحر : كامل تام 1(@)(@@) % ظعنوا ففي كنف الإله وحفظه % لا زلت أرعى عهدهم وأحافظ % 2(@)(@@) % ظلموا ولست بحائد عن ظلمهم % إلا إليهم فالهوى لي باهظ % 3(@)(@@) % ظني الوفاء مجانبا ومقاربا % أبدا ألاين مرة وأغالظ % 4(@)(@@) % ظفرت بأوفر حظها عين إذا % % ظلت ترامق حبها وتلاحظ % PageV01P139 البحر : طويل 1(@)(@@) % عصى عاذليه واعترته لجاجة % فرته نزاعا والمحب نزوع % 2(@)(@@) % عرته خطوب شردت نوم عينه % وليس لعين المستهام هجوع % 3(@)(@@) % عزاؤك لا تغلب عليه فإنه % هو الدهر : إن يؤمن فسوف يروع % 4(@)(@@) % عصى عاذليه إن أطاع حمامه % ويعصي الفتى في حبه ويطيع % PageV01P140 البحر : رجز تام 
ms31	 1(@)(@@) % غابوا فعيشي ناصب من بعدهم % دامت لهم نعمى وعيش رافع % 2(@)(@@) % غودرت بعدهم أسير صبابة % كمدا يغصصني الشراب السائغ % 3(@)(@@) % غنت فظل غناؤها لي شاغلا % لكن لها قلب وعيشك فارغ % 4(@)(@@) % غورية تعلو الغصون كأنما % % أهدى لها الطوق المؤلف صائغ % PageV01P141 البحر : كامل تام 1(@)(@@) % فنن على دعص تألق فوقه % بدر يضيء به الظلام العاكف % 2(@)(@@) % فاقت محاسنه وكل مسربل % بالحسن عن أدنى مداه واقف % 3(@)(@@) % فإذا بدت شمس النهار ووجهه % رجعت ولون النور منها كاسف % 4(@)(@@) % فرد المحاسن لا يقوم بوصفه % أبدا وإن بلغ النهاية واصف % PageV01P142 البحر : كامل تام 1(@)(@@) % قالوا صحوت فقلت تأبى لوعة % في القلب يلذع جمرها بل يحرق % 2(@)(@@) % قلقت مدامعه فبحن بسره % من ذا يقارنه الهوى لا يقلق % 3(@)(@@) % قلبي الملوم عن الهوى بل مقلتي % % بل ذا وذاك كلاهما لي موبق % 4(@)(@@) % قل ما بدا لك عاذلا ومناصحا % قدر الهوى فأسيره لا يطلق % PageV01P143 البحر : كامل تام 1(@)(@@) % كن كيف شئت فإنني لك وامق % أنت المليك وقلبي المملوك % 2(@)(@@) % كم ليلة قاسيتها بسهادها % % والقلب تحت لظى الهوى مسبوك % 3(@)(@@) % كبد تذوب ومقلة موقوفة % درج السهاد ودمعها مسفوك % 4(@)(@@) % كيف التخلص من مقارنة الهوى % % والجسم ملتبس به منهوك % PageV01P144 البحر : طويل 1(@)(@@) % لك العهد عهد الله ألا يزال لي % % بذكراك أو ألقى المنية شاغل % 2(@)(@@) % لقلبي من ذكراك في كل خطرة % تلهب شوق إن عدا لي قاتل % 3(@)(@@) % لبست نحولا لو تلبس بالصفا % % لأصبح منه صلده وهو ناحل % 4(@)(@@) % لعلك إن أمسيت رهن حفيرة % تقولين جادته الغيوث الهواطل % PageV01P145 البحر : كامل تام 1(@)(@@) % مني علي براحة من مهجة % فالموت أيسر من عذاب دائم % 2(@)(@@) % مالي سوى الزمن المعلق بالمنى % % نفس تردد في الفؤاد الهائم % 3(@)(@@) % مكلت فؤادي وهي أعنف مالك % وتحكمت والحب أجور حاكم % 4(@)(@@) % مرسومة بالحسن لكن فعلها % % سمج كذا فعل المليك الظالم % PageV01P146 البحر : خفيف تام 1(@)(@@) % نمت عن ليل مدنف حيران % % نومه نازح عن الأجفان % 2(@)(@@) % نعمت بالكرى جفونك لما % % سئم القلب من جوى الأحزان % 3(@)(@@) % نالني 
ms32	 منك ما لو التبس الطو % % د به ظل واهي الأركان % 4(@)(@@) % نظري خاشع وقلبي كتوم % ودموعي تبوح بالكتمان % PageV01P147 البحر : متقارب تام 1(@)(@@) % هنيئا لعينك ورد الكرى % % إذا الليل أردف من جانبيه % 2(@)(@@) % هل الحب لي منصف مرة % فيعدي رقادي على مقلتيه % 3(@)(@@) % هوائي رقيب علي فما % % يعطف قلبي إلا عليه % 4(@)(@@) % هو البدر يدركني ضوؤه % ولا أستطيع وصولا إليه % PageV01P148 البحر : متقارب تام 1(@)(@@) % وعيشك لا زلت حلف الضنى % % ولا التام بعدك للقلب لهو % 2(@)(@@) % ودون مزارك لليعملات % إذا ما ابتذلن ذميل وشدو % % 3(@)(@@) % ومما يزيد بكم لوعة % ولوع العواذل والعذل لغو % % 4(@)(@@) % وقيت بنفسي صروف الردى % % وكل زماني صروف ونبو % PageV01P149 البحر : منسرح 1(@)(@@) % لا تصغيا في الهوى لمن عذلا % بل واسقياني سقيتما نهلا % 2(@)(@@) % لا والذي ملك الهوى جسدي % % ما هجعت مقلتاي إذ رحلا % % 3(@)(@@) % لا زال طيف له يؤرقني % % يطرق عني الكرى إذا نزلا % 4(@)(@@) % لا صبر عمن إذا تصور لي % % رأيت بدر السماء قد أفلا % PageV01P150 البحر : متقارب تام 1(@)(@@) % يرجي اصطباري وأي اصطبار % يكون لقلب عميد جري % 2(@)(@@) % يقول إذا ما الهوى شفه % لقد خص قلبي بداء دوي % 3(@)(@@) % يبيت على مثل جمر الغضا % % وإن بات فوق مهاد وطي % 4(@)(@@) % ينام الخلي وما للشجي % رقاد إذا طال نوم الخلي % PageV01P151 
