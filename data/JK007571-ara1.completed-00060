ms41	 % يسبق حضر الإمام في مهله % 13(@)(@@) % إذا انتضاه لصرف حادثة % يهتز كالسيف سل من خلله % 14(@)(@@) % فأصبحت لبلة مؤمنة % لا يعتدي ذيبها على حمله % 15(@)(@@) % قد وقف النكث والخلاف بها % % وقوف صب يبكي على طلله % 16(@)(@@) % كل بيمن الإله تم لها % % وكل خير أتى فمن قبله % 17(@)(@@) % يا رحمة الله في بريته % بك استقام الزمان من ميله % 18(@)(@@) % أنت الزمان الذي بدولته % يضحك سن لزمان من دوله % 19(@)(@@) % كم خامل قد رفعت همته % ورد في ماله وفي أمله % 20(@)(@@) % وكم عديم سددت خلته % وكم عليل شفيت من علله % PageV01P242 21(@)(@@) % سللت سيفا على عداك فما % % يقر قلب الخلاف من وهله % PageV01P243 البحر : كامل تام 1(@)(@@) % بل رب مذهبة المزاج ومذهب % راحا براحة ريمه وغزاله % 2(@)(@@) % وكأن كف مديرها ومديره % فلك يدور بشمسه وهلاله % PageV01P244 (@)(@@)(@@)(@@) | (@)(@@) البحر : سريع 1(@)(@@) % شمس تجلت تحت ثوب ظلم % سقيمة الطرف بغير سقم % 2(@)(@@) % ضاقت علي مذ صرمت % حبلي فما فيها مكان قدم % 3(@)(@@) % شمس وأقمار يطوف بها % % طوف النصارى حول بيت صنم % 4(@)(@@) % ( النشر مسك والوجوه دنا % % نير وأطراف الأكف عنم % PageV01P245 البحر : مديد تام 1(@)(@@) % يا وميض البرق بين الغمام % لا عليها بل عليك السلام % 2(@)(@@) % إن في الأحداج مقصورة % وجهها يهتك ستر الظلام % 3(@)(@@) % تحسب الهجر حلالا لها % % وترى الوصل عليها حرام % 4(@)(@@) % ما تأسيك لدار خلت % ولشعب شت بعد التئام % 5(@)(@@) % ( إنما ذكرك ما قد مضى % % ضلة مثل حديث المنام ) % PageV01P246 البحر : سريع 1(@)(@@) % أنت بما في نفسه أعلم % فاحكم بما أحببت أن تحكم % 2(@)(@@) % ألحاظه في الحب قد هتكت % مكتومه والحب لا يكتم % 3(@)(@@) % يا مقلة وحشية قتلت % نفسا بلا نفس ولم ولم تظلم % 4(@)(@@) % قالت : تسليت ، فقلت : لها % % ما بال قلبي هائم مغرم ؟ % 5(@)(@@) % يا أيها الزاري على عمر % قد قلت فيه غير ما تعلم ) % PageV01P247 البحر : بسيط تام 1(@)(@@) % نفسي فداؤك والأبطال واقفة % والموت يقسم في أرواحها النقما % % 2(@)(@@) % شاركت صرف المنايا في نفوسهم % حتى تحكمت فيها مثل ما احتكما % % 3(@)(@@) % لو تستطيع العلا جاءتك خاضعة 
ms42	 % حتى تثقبل منك الكف والقدما % % PageV01P248 البحر : هزج 1(@)(@@) % فأين الزيج والقانو % % ن والأركند والكمه ؟ % 2(@)(@@) % وأين السند هند البا % % طل الجدول هل ثمه % 3(@)(@@) % سوى الإفك على الله % تعالى منشر الرمه % 4(@)(@@) % إذا كان أخو النجم % يرى الغيب بما ضمه % 5(@)(@@) % فلم ذا يطلب الرزق % طلاب العاجز الهمه % 6(@)(@@) % وهذي الأرض قد وارت % كنوزا عدة جمه % 7(@)(@@) % فلا والله ما لل % % ه خلق يحتوي علمه % PageV01P249 البحر : منسرح 1(@)(@@) % يا رب صوت يصوغه عصب % نيطت بساق من فوقها قدم % 2(@)(@@) % جوفاء ، مضمومة أصابعها % % في ساكنات تحريكها نغم % 3(@)(@@) % أربعة جزئت لأربعة % أجزاؤها بالنفوس تلتحم % 4(@)(@@) % أصغرها في القلوب أكبرها % % يبعث منه الشفاء والسقم % 5(@)(@@) % إذا أرنت بغمز لافظها % % قلت : حمام يجيبهن حم % 6(@)(@@) % لها لسان بكف ضاربها % % يعرب عنها وما لهن فم % PageV01P250 البحر : سريع 1(@)(@@) % صحيفة طابعها اللوم % عنوانها بالجهل مختوم % 2(@)(@@) % يهدي لها والخلف في طيها % % والمطل والتسويف واللوم % 3(@)(@@) % من وجهه نحس ومن قربه % رجس ومن عرفانه شوم % 4(@)(@@) % لا تهتضم إن بت ضيفا له % % فخبزه في الجوف هاضوم % 5(@)(@@) % تكلمه الألحاظ من رقة % فهو بلحظ العين مكلوم % 6(@)(@@) % لا تأتدم شيئا على أكله % فإنه بالجوع مأدوم % PageV01P251 البحر : سريع 1(@)(@@) % يا ويلتا من موقف ما به % أخوف من أن يعدل الحاكم % 2(@)(@@) % أبارز الله بعصيانه % وليس لي من دونه راحم ! % 3(@)(@@) % يا رب غفرانك عن مذنب % أسرف ، إلا أنه نادم % PageV01P252 البحر : وافر تام 1(@)(@@) % بنفسي من مراشفه مدام % ومن لحظات مقلته سهام % 2(@)(@@) % ومن هو إن بدا والبدر تم % خفي من حسنه البدر التمام % 3(@)(@@) % أقول له ، وقد أبدى صدودا % فلا لفظ إلي ولا ابتسام % 4(@)(@@) % تكلم ليس يوجعك الكلام % ولا يمحو محاسنك السلام % PageV01P253 البحر : منسرح 1(@)(@@) % إذا أدارت بنانه قلما % لم تدر للشبه أيها القلم ؟ % PageV01P254 البحر : منسرح 1(@)(@@) % يسعى بها شادن ، أنامله % ضربان منها العناب والعنم % 2(@)(@@) % تنسى به العين طرفها عجبا % ويدرك الوهم عنده الوهم % 3(@)(@@) % كأنما لاحظت به صنما % يعبده من بهائه الصنم % PageV01P255 البحر : طويل 1 
ms43	(@)(@@) % أحاطت جنود الأرض بابن سوادة % وعاجله الحتف المتاح أشائمه % 2(@)(@@) % ووافاه خطب لا ينادي وليده % وعاداه ليث لا ترد عزائمه % PageV01P256 البحر : طويل 1(@)(@@) % ونؤي كدملوج الكعاب ودمنة % تذكر من وشم الخضاب وسومها % % PageV01P257 البحر : مديد تام 1(@)(@@) % من محب شفه سقمه % وتلاشى لحمه ودمه % 2(@)(@@) % كاتب حنت صحيفته % وبكى من رحمة قلمه % 3(@)(@@) % يرفع الشكوى إلى قمر % تنجلي عن وجهه ظلمه % 4(@)(@@) % من لقرن الشمس جبهته % % وللمع البرق مبتسمه % 5(@)(@@) % خل عقلي يا مسفهه % إن عقلي لست أتهمه % 6(@)(@@) % ( فتى عقل يعيش به % حيث تهدي ساقه قدمه % PageV01P258 البحر : طويل 1(@)(@@) % كأن التي يوم الوداع تعرضت % هلال بدا محقا على أنه تم % PageV01P259 البحر : كامل تام 1(@)(@@) % يا من يجرد من بصيرته % تحت الحوادث صارم العزم % 2(@)(@@) % رعت العدو فما مثلت له % إلا تفزع منك في الحلم % 3(@)(@@) % أضحى لك التدبير مطردا % مثل اطراد الفعل للإسم % 4(@)(@@) % رفع العدو إليك ناظره % فرآك مطلعا مع النجم % PageV01P260 البحر : كامل تام 1(@)(@@) % قالوا : شبابك قد مضت أيامه % بالعيش ، قلت : وقد مضت أيامي % % 2(@)(@@) % لله ! أية نعمة كان الصبا % % لو أنها وصلت بطول دوام % 3(@)(@@) % حسر المشيب قناعه عن رأسه % وصحا العواذل بعد طول ملام % 4(@)(@@) % فكأن ذاك العيش ظل غمامة % وكأن ذاك اللهو طيف منام % PageV01P261 البحر : خفيف تام 1(@)(@@) % جعل الله رزق كل عدو % لي بكف لبعض من لا أسمي % % 2(@)(@@) % كف من لا يهز عطفيه يوما % لمديح ، ولا يبالي بذم % 3(@)(@@) % يتلقى الرجاء منه بوجه % راشح ، الخد والجبين بسم % 4(@)(@@) % جئته زائرا فما زال يشكو % % لي حتى حسبته سيدمي % % 5(@)(@@) % ألف اللؤم فيه من كل طرف % معرقا فيه بين خال وعم % 6(@)(@@) % قد نهاني النصيح عنه مرارا % بأبي أنت من نصيح وأمي ! % PageV01P262 البحر : طويل 1(@)(@@) % أبا صالح جاءت على الناس غفلة % على غفلة بانت بكل كريم % 2(@)(@@) % فليت الألى باتوا يفادون بالألى % % أقاموا فيفدى ظاعن بمقيم % 3(@)(@@) % ويا ليتها الكبرى فتطوى سماؤنا % % لها ، وتمد الأرض مد أديم % 4(@)(@@) % فما الموت إلا عيش كل مبخل % وما 
ms44	 العيش إلا موت كل ذميم % 5(@)(@@) % وأعذر ما أدمى الجفون من البكا % % كريم رأى الدنيا بكف لئيم % PageV01P263 البحر : طويل 1(@)(@@) % أعاذل قد آلمت ويك فلومي % % وما بلغ الإشراك ذنب عديم % 2(@)(@@) % لقد أسقطت حقي عليك صبابتي % % كما أسقط الإفلاس حق غريم % 3(@)(@@) % وأعذر ما أدمى الجفون من البكا % % كريم رأى الدنيا بكف لئم % 4(@)(@@) % أرى كل فدم قد تبحبح في الغنى % % وذو الظرف لاتلقاه غير عديم % PageV01P264 البحر : رمل تام 1(@)(@@) % % وكسا جسمي ثوب الألم % 2(@)(@@) % أيها البين ، أقلني مرة % فإذا عدت فقد حل دمي % % 3(@)(@@) % يا خلي الذرع نم في غبطة % إن من فارقته لم ينم % 4(@)(@@) % ولقد هاج لقلبي سقما % ذكر من لو شاء داوى سقمي % % PageV01P265 البحر : سريع 1(@)(@@) % سيف من الحتف تردى به % يوم الوغى سيف من الحزم % 2(@)(@@) % مواصلا أعداءه عن قلى % لا صلة القربى ولا الرحم % 3(@)(@@) % وصل يحن الإلف من بغضه % شوقا إلى الهجران والصرم % 4(@)(@@) % حتى إذا نادمهم سيفه % % بكل كأس مرة الطعم % 5(@)(@@) % ترى حمياها بهاماتهم % % تغور بين الجلد والعظم % 6(@)(@@) % على أهازيج ظبا بينها % % ما شئت من حذف ومن خرم % 7(@)(@@) % طاعوا له من بعد عصيانهم % % وطاعة الأعداء عن رغم % 8(@)(@@) % وكم أعدوا واستعدوا له % هيهات ليس الخضم كالقضم % % PageV01P266 البحر : كامل تام 1(@)(@@) % يا وجه معتذر ومقلة ظالم % كم من دم ظلما سفكت بلا دم ! % 2(@)(@@) % أوجدت وصلي في الكتاب محرما % ووجدت قتلي فيه غير محرم % 3(@)(@@) % كم جنة لك قد سكنت ظلالها % % متفكها في لذة وتنعم ! % 4(@)(@@) % وشربت في خمر العيون تعللا % فإذا انتشيت أجود جود المرزم % 5(@)(@@) % وإذا صحوت فما أقصر عن ندى % وكما علمت شمائلي وتكرمي % % PageV01P267 البحر : كامل تام 1(@)(@@) % أزف الرحيل فودعتني مقلة % أوحت إلي جفونها بسلام % 2(@)(@@) % وتطلعت بين الحدوج ، كأنها % % شمس تطلع في خلال غمام % 3(@)(@@) % وشكت تباريح الصبابة والهوى % % بمدامع نطقت بغير كلام % 4(@)(@@) % كمهاة رمل قد تربعت الحمى % % بين الظباء العفر والآرام % 5(@)(@@) % حتى إذا ضرب المضيف رواقه % صافت بظل أراكة وبشام % PageV01P268 البحر : مجزوء 
ms45	 البسيط 1(@)(@@) % ظالمتي في الهوى ، لاتظلمي % % وتصرمي حبل من لم يصرم % 2(@)(@@) % أهكذا باطلا عاقبتني ؟ % لا يرحم الله من لم يرحم % 3(@)(@@) % قتلت نفسا بلا نفس ، وما % % ذنب بأعظم من سفك الدم ! % 4(@)(@@) % لمثل هذا بكت عيني ولا % % للمنزل القفر وللأرسم % 5(@)(@@) % ( ماذا وقوفي على رسم عفا % % مخلولق دارس مستعجم ؟ ) % PageV01P269 البحر : بسيط تام 1(@)(@@) % يخرجن من فرجات النقع دامية % كأن آذانها أطراف أقلام % PageV01P270 البحر : كامل تام 1(@)(@@) % ما كلما بل ربما عبث البكا % % بدموع عينك من بكاء حمام % 2(@)(@@) % وإذا الشمال مع العشي تنسمت % هاج التنسم لي دفين سقام % PageV01P271 البحر : كامل تام 1(@)(@@) % ومدامة صلى الملوك لوجهها % % من كثرة التبجيل والتعظيم % 2(@)(@@) % رقت حشاشتها ورق أديمها % % فكأنها شيبت من التسنيم % 3(@)(@@) % وكأن عين السلسبيل تفجرت % لك عن رحيق الجنة المختوم % 4(@)(@@) % راح إذا اقترنت عليك كؤوسها % % خلت النجوم تقارنت بنجوم % 5(@)(@@) % تجري بأكناف الرياض وما لها % % فلك سوى كفي وكف نديمي % % 6(@)(@@) % حتى تخال الشمس يكسف نورها % % والأرض ترعد رعدة المحموم % PageV01P272 البحر : طويل 1(@)(@@) % ألا إنما الدنيا كأحلام نائم % وما خير عيش لا يكون بدائم % 2(@)(@@) % تأمل إذا ما نلت بالأمس لذة % فأفنيتها ، هل أنت إلا كحالم % 3(@)(@@) % وما الموت إلا شاهد مثل غائب % وما الناس إلا جاهل مثل عالم % PageV01P273 البحر : كامل تام 1(@)(@@) % مظلومة باللحظ وجنتها % % وجفونها جبلت على الظلم % 2(@)(@@) % وكأن عينيها تضمنتا % % ما في فؤادك من جوى السقم % PageV01P274 البحر : متقارب تام 1(@)(@@) % أيا ويح نفسي وويل أمها % % لما لقيت من جوى همها % % 2(@)(@@) % فديت التي قتلت مهجتي % % ولم تتق الله في ذمها % % 3(@)(@@) % أغض الجفون إذا ما بدت % وأكني إذا قيل لي : سمها % % 4(@)(@@) % أداري العيون وأخشى الرقيب % وأرصد غفلة قيمها % % 5(@)(@@) % ( سبتني بجيد وخد ونحر % غداة رمتني بأسهمها % % PageV01P275(@)(@@)(@@)(@@) | (@)(@@) البحر : مجزوء الخفيف 1(@)(@@) % ما لليلى تبدلت % بعدنا ود غيرنا ؟ % 2(@)(@@) % أرهقتنا ملامة % بعد إيضاح عذرنا % % 3(@)(@@) % فسلونا عن ذكرها % % وتسلت عن ذكرنا % % 4(@)(@@) % لم نقل إذ تحرمت % واستهلت بهجرنا % % 5(@)(@@) % ليت شعري ماذا ترى % % أم عمرو في 
ms46	 أمرنا % % PageV01P276 البحر : بسيط تام 1(@)(@@) % لا بيت يسكن إلا فارق السكنا % % ولا امتلا فرحا إلا امتلا حزنا % % 2(@)(@@) % لهفا على ميت مات السرور به % لو كان حيا لأحيا الدين والسننا % % 3(@)(@@) % واها عليك أبا بكر مرددة % لو سكنت ولها أو فترت شجنا % % 4(@)(@@) % إذا ذكرتك يوما قلت : واحزنا % % وما يرد عليك القول : واحزنا % % 5(@)(@@) % يا سيدي ، ومراح الروح في بدني % % هلا دنا الموت مني حيث منك دنا % % 6(@)(@@) % حتى يعود بنا في قعر مظلمة % لحد ، ويلبسنا في واحد كفنا % % 7(@)(@@) % يا أطيب الناس روحا ضمه بدن % أستودع الله ذاك الروح والبدنا % % 8(@)(@@) % لو كنت أعطى به الدنيا معاوضة % منه ، لما كانت الدنيا له ثمنا % % PageV01P277 البحر : كامل تام 1(@)(@@) % ولى الشباب وكنت تسكن ظله % فانظر لنفسك أي ظل تسكن ؟ % 2(@)(@@) % وانه المشيب عن الصبا لو أنه % يدلي بحجته إلى من يلقن % PageV01P278 البحر : سريع 1(@)(@@) % ومعشر تنطق أقلامهم % % بحكمة تلقنها الأعين % 2(@)(@@) % تلفظها في الصك أقلامهم % كأنما أقلامهم ألسن % PageV01P279 البحر : طويل 1(@)(@@) % عجبت للفظ منك ذاب نحافة % ومعناه ضخم ما أردت سمين % 2(@)(@@) % وأعجب من هذين أن بيانه % حياة لأرباب الهوى ومنون % 3(@)(@@) % زحمت به في غنجها مقل الدمى % % وعلمت سثمر النفث كيف يكون % PageV01P280 البحر : وافر تام 1(@)(@@) % ومغبر السماء إذا تحلى % % يغادر أرضه كالأرجوان % 2(@)(@@) % سموت له سمو النقع فيه % % بكل مذلق سلب السنان % 3(@)(@@) % وكل مشطب المتنين صاف % كلون الملح منصلت يماني % % 4(@)(@@) % كأن نهاره ظلماء ليل % كواكبه من السمر اللدان % PageV01P281 البحر : طويل 1(@)(@@) % أما والذي سوى السماء مكانها % % ومن مرج البحرين يلتقيان % 2(@)(@@) % ومن قام في الأوهام من غير رؤية % بأثبت من إدراك كل عيان % 3(@)(@@) % لما خلقت كفاك إلا لأربع % عقائل لم يخلق لهن يدان % 4(@)(@@) % لتقبيل أفواه ، وإعطاء نائل ، % وتقليب هندي ، وحبس عنان % PageV01P282 البحر : كامل تام 1(@)(@@) % بكرت علي عواذلي تلحينني % % وعلى الذي لم يعد بي أعدينني % % 2(@)(@@) % إيها عليك فقد كبرت عن الصبا % % ونهى المشيب عن الذي تنهينني % % 3(@)(@@) % أنى وكيف وقد رأين تغيري % % عن عهدهن 
ms47	 إذا العيون رأينني ؟ % 4(@)(@@) % وعلى مفارقة الشباب شمتن بي % % وعلى معاداة الصبا عادينني % % 5(@)(@@) % أدنينني حتى إذا التهب الجوى % % أقصينني أضعاف ما أذنينني % % 6(@)(@@) % وفتنني بلواحظ تشكو الضنى % % دائي بهن وربما داوينني % % 7(@)(@@) % يذكين في قلبي وبين جوانحي % % حرقا بنار جحيمها أصلينني % % 9(@)(@@) % يا بن الخلائف إن أيام الغنى % % أبامك الغر التي أغنينني % % 10(@)(@@) % بنوالها وسجالها وثمالها % % أسقينني حتى لقد أروينني % % PageV01P283 البحر : سريع 1(@)(@@) % قد صرح الأعداء بالبين % وأشرق الصبح لذي العين % PageV01P284 البحر : بسيط تام 1(@)(@@) % قالوا شبابك قد ولى ، فقلت لهم : % هل من جديد على كر الجديدين ؟ % 2(@)(@@) % صل من هويت وإن أبدى معاتبة % فأطيب العيش وصل بين إلفين % 3(@)(@@) % واقطع حبائل خل لا تلائمه % فربما ضاقت الدنيا على اثنين % PageV01P285 البحر : بسيط تام 1(@)(@@) % فكرت فيك أبحر أنت أم قمر % فقد تحير فكري بين هذين ! % 2(@)(@@) % إن قلت : بحر ، وجدت البحر منحسرا % وبحر جودك ممتد العبابين % 3(@)(@@) % أو قلت : بدرا ، رأيت البدر منتقصا % فقلت : شتان ما بين اليزيدين % PageV01P286 البحر : طويل 1(@)(@@) % فكيف ولي قلب إذا هبت الصبا % % أهاب بشوق في الضلوع مكين % 2(@)(@@) % ويهتاج قلبي كما كان ساكنا % دعاء حمام لم يبت بوكون % 3(@)(@@) % وإن ارتياحي من بكاء حمامة % كذي شجن داويته بشجون % 4(@)(@@) % كأن حمام الأيك لما تجاوبت % حزين بكى من رحمة لحزين % PageV01P287 البحر : طويل 1(@)(@@) % كلاني لما بي عاذلي كفاني % % طويت زماني برهة وطواني % % 2(@)(@@) % بليت وأبلتني الليالي بكرها % % وصرفان للأيام معتوران % 3(@)(@@) % وما لي لا أبكي لسبعين حجة % وعشر أتت من بعدها سنتان ؟ % 4(@)(@@) % فلا تسألاني عن تباريح علتي % % ودونكما مني الذي تريان % 5(@)(@@) % وإني بحمد الله راج لفضله % ولي من صمان الله خير ضمان % 6(@)(@@) % ولست أبالي عن تباريح علتي % % إذا كان عقلي باقيا ولساني % % 7(@)(@@) % هما ما هما في كل حال تلم بي % % فذا صارمي فيها وذاك سناني % % PageV01P288 البحر : مجزوء الوافر 1(@)(@@) % سلبت الروح من بدني % % ورعت القلب بالحزن % 2(@)(@@) % فلي بدن بلا روح % ولي روح بلا بدن % 3(@)(@@) % قرنت مع الردى نفسي % % فنفسي 
ms48	 وهو في قرن % 4(@)(@@) % فليت السحر من عيني % % ك لم أره ولم يرني % % PageV01P289 البحر : وافر تام 1(@)(@@) % تعللنا أمامة بالأماني % % ولج بنا البعاد من التداني % % 2(@)(@@) % إذا ما قلت : أين الوصل ؟ قالت : % طلبت العز في دار الهوان % PageV01P290 البحر : طويل 1(@)(@@) % ولو شئت راهنت الصبابة والهوى % % وأجريت في اللذات من مئتين % 2(@)(@@) % وأسلبت من ثوب الشباب ، وللصبا % % علي رداء معلم الطرفين % PageV01P291 البحر : طويل 1(@)(@@) % صحا القلب إلا نظرة تبعث الأسى % % لها زفرة موصولة بحنين % 2(@)(@@) % بلى ربما حلت عرى عزماته % سوالف آرام وأعين عين % 3(@)(@@) % لواقط حبات القلوب ، إذا رنت % بسحر عيون وانكسار جفون % 4(@)(@@) % وريط من الموشي أينع تحته % ثمار صدور لا ثمار غصون % 5(@)(@@) % برود كأنوار الربيع لبسنها % % ثياب تصاب لاثياب مجون % 6(@)(@@) % فرين أديم الليل عن نور أوجه % تجن بها الألباب أي جنون % 7(@)(@@) % وجوه جرى فيها النعيم فكللت % بورد خدود يجتنى بعيون % 8(@)(@@) % سألبس للأحزان ثوب تصبر % وإن لم يكن عند اللقا بحصين % 9(@)(@@) % فكيف ولي قلب إذا هبت الصبا % % أهاب بشوق في الفؤاد كمين % 10(@)(@@) % ويهتاج منه كل ما كان ساكنا % دعاء حمام لم يبت بوكون % PageV01P292 11(@)(@@) % وإن ارتياحي من بكاء حمامة % كذي شجن داويته بشجون % 12(@)(@@) % كأن حمام الأيك ، حين تجاوبت ، % حزين بكى من رحمة لحزين % PageV01P293 البحر : مديد تام 1(@)(@@) % أي تفاح ورمان % يجتنى من خوط ريحان % 2(@)(@@) % أي ورد فوق خد بدا % % مستنيرا فوق سوسان % 3(@)(@@) % وثن يعبد في روضة % صيغ من در ومرجان % 4(@)(@@) % من رأى الذلفاء في خلوة % لم ير الحد على الزاني % % 5(@)(@@) % إنما الذلفاء ياقوتة % أخرجت من كيس دهقان % PageV01P294 البحر : بسيط تام 1(@)(@@) % أهدت إليك حمياها بكأسين % شمس تدبرتها بالكف والعين % 2(@)(@@) % يسعى بتلك وهذي شادن غنج % كأنه قمر يسعى بنجمين % 3(@)(@@) % كأنه حين يمشي في تأوده % قضيب بان تثنى بين ريحين % PageV01P295 البحر : خفيف تام 1(@)(@@) % رجع صوت كأنه نظم در % ما يرى سلكه سوى الآذان % 2(@)(@@) % تنفث السحر بالبيان من القو % % ل ولا سحر مثل سحر البيان % PageV01P296 (@)(@@)(@@)(@@) | (@)(@@) البحر : مجزوء 
ms49	 الكامل 1(@)(@@) % ألحاظ عيني تلتهي % % في روض ورد يزدهي % % 2(@)(@@) % رتعت بها وتنزهت % فيها ألذ تنزه % 3(@)(@@) % يأيها الخنث الجفو % % ن بنخوة وتكره % 4(@)(@@) % والمكتسي غنجا ، أما % % ترثي لأشعث أمره % PageV01P297 البحر : بسيط تام 1(@)(@@) % أطلال لهوك قد أقوت مغانيها % % لم يبق من عهدها إلا أثافيها % % 2(@)(@@) % هذي المفارق قد قامت شواهدها % % على فنائك والدنيا تزكيها % % 3(@)(@@) % الشيب سفتجة فيها معنونة % لم يبق للموت إلا أن يسحيها % % PageV01P298 البحر : مخلع البسيط 1(@)(@@) % ورب ملتفة العوالي % % يلتمع الموت في ذراها % % 2(@)(@@) % إذا توطت حزون أرض % طحطحت الشم من رباها % % 3(@)(@@) % يقودها منه ليث غاب % إذا رأى فرصة قضاها % % 4(@)(@@) % تمضي بآرائه سيوف % يستبق الموت في ظباها % % 5(@)(@@) % بيض تحل القلوب سودا % إذا انتضى عزمه انتضاها % % 6(@)(@@) % تتبعه الطير في الأعادي % % تجني كلا العشب من كلاها % % 7(@)(@@) % أقدم إذ كاع كل ليث % عن حومة الموت إذ رآها % % 8(@)(@@) % فأقحم الخيل في غمار % تفغر بالموت لهوتاها % % 9(@)(@@) % عنت له أوج المنايا % % فعافها القوم واشتهاها % % PageV01P299 البحر : مجزوء الرمل 1(@)(@@) % يا هلالا في تجليه % وقضيبا في تثنيه % 2(@)(@@) % والذي لست أسمي % % ه ولكني أكنيه % 3(@)(@@) % شادن ما تقدر العي % ن تراه من تلاليه % 4(@)(@@) % كلما قابله شخ % % ص رأى صورته فيه % 5(@)(@@) % ( لان حتى لو مشى الذر % ر عليه كاد يدميه ) % PageV01P300 البحر : خفيف تام 1(@)(@@) % بزمام الهوى أمت إليه % وبحكم العقار أقضي عليه % 2(@)(@@) % بأبي من زها علي بوجه % كاد يدمى لما نظرت إليه % % 3(@)(@@) % كلما علني من الراح صرفا % علني بالرضاب من شفتيه % 4(@)(@@) % ناول الكأس واستمال بلحظ % فسقتني عيناه قبل يديه % PageV01P301 البحر : بسيط تام 1(@)(@@) % يا غافلا ما يرى إلا محاسنه % ولو درى ما رأى إلا مساويه % 2(@)(@@) % انظر إلى باطن الدنيا ، فظاهرها % % كل البهائم يجري طرفها فيه % PageV01P302 البحر : بسيط تام 1(@)(@@) % ونائح في غصون الأيك أرقني % % وما عنيت بشيء ظل يعنيه % 2(@)(@@) % مطوق بعقود ما تزايله % حتى تزايله إحدى تراقيه % 3(@)(@@) % قد بات يبكي لشجو ما دريت به % وبت أبكي بشجو ليس يدريه % PageV01P303(@)(@@)(@@)(@@) | (@)(@@) البحر 
ms50	 : كامل تام 1(@)(@@) % ولرب نائمة على فنن % تشجي الخلي وما به شجو % 2(@)(@@) % وتغردت في غصن أيكتها % % فكأنما تغريدها شدو % PageV01P304 البحر : - 1(@)(@@) % أطفت شرارة لهوي % % ولوت بشدة عدوي % % 2(@)(@@) % شعل علن مفارقي % % ومضت ببهجة سروي % % 3(@)(@@) % لما سلكت عروضها % % ذهب الزحاف بحزوي % % 4(@)(@@) % ( يأيها الشادي ، صه % ليست بساعة شدو % PageV01P305(@)(@@)(@@)(@@) | (@)(@@) البحر : متقارب تام 1(@)(@@) % لا تبك ليلى ولا ميه % % ولا تندبن راكبا نيه % % 2(@)(@@) % وبك الصبا إذ طوى ثوبه % فلا أحد ناشر طيه % % 3(@)(@@) % ولا القلب ناس لما قد مضى % % ولا تارك أبدا غيه % % 4(@)(@@) % ودع قول باك على أرسم % فليس الرسوم بمبكيه % % 5(@)(@@) % خليلي عوجا على رسم دار % خلت من سليمى ومن ميه ) % PageV01P306 البحر : خفيف تام 1(@)(@@) % وجنة كالربيع جاد عليها % % من حياء لا من حيا وسمي % 2(@)(@@) % ووجوه قلبتهاكالدناني % % ر ومثلي لمثلها صيرفي % 3(@)(@@) % تتهادى الرياح منها نسيما % شابه عنبر ومسك ذكي % PageV01P307 البحر : خفيف تام 1(@)(@@) % ورضاب كأنه ما يمج الن % نحل طيبا وما يسح الحبي % 2(@)(@@) % علنيه بدر من الإنس يا من % ظن بالبدر أنه إنسي ! % PageV01P308 البحر : سريع 1(@)(@@) % وردية يحملها شادن % في مشرب الحمرة وردي % 2(@)(@@) % كأنه والكأس في كفه % بدر دجى يسعى بدري % PageV01P309 البحر : سريع 1(@)(@@) % منظومة هذب ألفاظها % % ليست من الشعر الحجازي % 2(@)(@@) % لكنها في الصوغ نجدية % صاحبها ليس بنجدي % 3(@)(@@) % كوفية الإبداع بصرية % لغير كوفي وبصري % 4(@)(@@) % كأنها شاذورة علقت % بوجه دينار هرقلي % PageV01P310 البحر : هزج 1(@)(@@) % هنا تفنى قوافي الشع % % ر في هذا الروي % 2(@)(@@) % قواف ألبست حليا % من الحسن البدي % 3(@)(@@) % تعالت عن جرير بل % زهير بل عدي % PageV01P311 (@)(@@)(@@)(@@) | (@)(@@) البحر : رجز تام 1(@)(@@) % سبحان من لم تحوه أقطار % ولم تكن تدركه الأبصار % 2(@)(@@) % ومن عنت لوجهه الوجوه % فما له ند ولا شبيه % 2(@)(@@) % % ناك من خوط بانة بيضاء % 3(@)(@@) % سبحانه من خالق قدير % وعالم بخلقه بصير % 3(@)(@@) % أن يعرف التحريك والسكون % داءك في الإملال والقريض % 4(@)(@@) % وأول ليس له ابتداء % وآخر ليس له انتهاء % 4(@)(@@) % كنت استصعب الجفاء ، فلما % % 5(@)(@@) % أوسعنا إحسانه وفضله % وعز 
ms51	 أن يكون شيء مثله % 5(@)(@@) % % في الفصل والغائي والابتداء % 6(@)(@@) % حركتان غير ذي تنوين % % PageV01P312 6(@)(@@) % وجل أن تدركه العيون % أو يحوياه الوهم والظنون % 7(@)(@@) % لكنه يدرك بالقريحه % % والعقل والأبنية الصحيحه % % 8(@)(@@) % وهذه من أثبت المعارف % % في الأوجه الغامضة اللطائف % 8(@)(@@) % أيها العاذلات في الحب ، إن ال % % عذل في الحب ينتهي إغراء % 9(@)(@@) % معرفة العقل من الإنسان % أثبت من معرفة العيان % 9(@)(@@) % مجازفا إذ خانه الدليل % ولا يكون في سوى ذي الأربعه % 10(@)(@@) % فالحمد لله على نعمائه % حمدا جزيلا وعلى آلائه % 10(@)(@@) % بديعة أحكم في تدبيرها % % 11(@)(@@) % سالمة من أجمع الزحاف % لا كل ما تخطه اليدان % 11(@)(@@) % ستة اربع عشرة وثلاثمائة لم ي % غز فيها وغزت قواده % PageV01P313 12(@)(@@) % أما تراه في هوان يرتع % بعسكر يسعر من حماته % 12(@)(@@) % وأصلها معرفة اللسان % % 13(@)(@@) % وإنما أجازه الخليل % تتعب النفس ، هل تنال السماء ؟ % 13(@)(@@) % فاستنزل الوحش من الهضاب % كأنما حطت من السحاب % 14(@)(@@) % أسرتي ، لا أقول فخرا ، سراة % حسبهم ذاك ، مفخرا وسناء % 14(@)(@@) % فأذعنت مراقها سراعا % % وأقبلت حصونها تداعى % % 15(@)(@@) % ثم أتى به إلى الإمام % مشحوذة على دروع الحزم % % 16(@)(@@) % كادت لها أنفسهم تجود % وكادت الأرض بهم تميد % 17(@)(@@) % لولا الإله زلزلت زلزالها % % وأخرجت من رهبة أثقالها % % 18(@)(@@) % فأنزل الناس إلى البسيط % وقطع البين من الخليط % PageV01P314 19(@)(@@) % وافتتح الحصون حصنا حصنا % % وأوسع الناس جميعا أمنا % % 20(@)(@@) % ولم يزل حتى انتحى جيانا % % فلم يدع بأرضها شيطانا % % 21(@)(@@) % أسباب من أصبح فيه خالعا % % قد عقد الإل لهم والذمه % % 22(@)(@@) % ثم انتحى من فوره إلبيره % وهي بكل آفة مشهوره % 23(@)(@@) % فداسها بخيله ورجله % حتى توطأ خدها بنعله % 24(@)(@@) % ولم يدع من جنها مريدا % % بها ولا من إنسها عنيدا % % 25(@)(@@) % إلا كساه الذل والصغارا % % وعمه وأهله دمارا % % 26(@)(@@) % فما رأيت مثل ذاك العام % ومثل صنع الله للإسلام % 27(@)(@@) % فانصرف الأمير من غزاته % وقد شفاه الله من عداته % 28(@)(@@) % وقبلها ما خضعت وأذعنت % إستجة وطالما قد صنعت % PageV01P315 29(@)(@@) % وبعدها مدينة الشنيل % ما أذعنت للصارم الصقيل % 30(@)(@@) % لما غزاها قائد 
ms52	 الأمير % باليمن في لوائه المنصور % 31(@)(@@) % فأسلمت ولم تكن بالمسلمه % وزال عنها أحمد بن مسلمه % 32(@)(@@) % وبعدها في آخر الشهور % من ذلك العام الزكي النور % 33(@)(@@) % أرجفت القلاع والحصون % كأنما ساورها المنون % 34(@)(@@) % وأقبلت رجالها وفودا % % تبغي لدى إمامها السعودا % % 35(@)(@@) % وليس من ذي عزة وشده % % إلا توافوا عند باب السده % % 36(@)(@@) % قلوبهم باخعة بالطاعه % قد أجمعة ا الدخول في الجماعه % % 37(@)(@@) % وبعد حمد الله والتمجيد % وبعد شكر المبدئ المعيد % 38(@)(@@) % أقول في أيام خير الناس % ومن تحلى بالندى والباس % PageV01P316 39(@)(@@) % ومن أباد الكفر والنفاقا % % وشرد الفتنة والشقاقا % % 40(@)(@@) % ونحن في حنادس كالليل % % وفتنة مثل غثاء السيل % 41(@)(@@) % حتى تولى عابد الرحمن % ذاك الأغر من بني مروان % 42(@)(@@) % مؤيد حكم في عداته % % سيفا يسيل الموت من ظباته % 43(@)(@@) % وصبح الملك مع الهلال % فأصبحا ندين في الجمال % 44(@)(@@) % واحتمل التقوى على جبينه % والدين والدنيا على يمينه % 45(@)(@@) % قد أشرقت بنوره البلاد % وانقطع التشغيب والفساد % 46(@)(@@) % هذا على حين طغى النفاق % واستفحل النكاث والمراق % 47(@)(@@) % وضاقت الأرض على سكانها % % وأذكت الحرب لظى نيرانها % % 48(@)(@@) % ونحن في عشواء مدلهمه % وظلمة ما مثلها من ظلمه % PageV01P317 49(@)(@@) % تأخذنا الصيحة كل يوم % فما تلذ مقلة بنوم % 50(@)(@@) % وقد نصلي العيد بالنواظر % % مخافة من العدو الثائر % % 51(@)(@@) % حتى أتانا الغوث من ضياء % طبق بين الأرض والسماء % 52(@)(@@) % خليفة الله الذي اصطفاه % على جميع الخلق واجتباه % 53(@)(@@) % من معدن الوحي وبيت الحكمه % وخير منسوب إلى الأئمه % 54(@)(@@) % بكت على ما فاتها النواظر % وتستحي من جوده السحائب % 55(@)(@@) % في وجهه من نوره برهان % وكفه تقبيلها قربان % 56(@)(@@) % أحيا الذي مات من المكارم % % من عهد كعب وزمان حاتم % % 57(@)(@@) % وشيمة كالصاب أو كالماء % وهمة ترقى إلى السماء % 58(@)(@@) % وانظر إلى الرفيع من بنيانه % يريك بدعا من عظيم شانه % PageV01P318 59(@)(@@) % لو خايل البحر ندى يديه % إذا لجت عفاته إليه % 60(@)(@@) % لغاض أو لكاد أن يغيضا % % ولاستحى من بعد أن يفيضا % % 61(@)(@@) % من أسبغ النعمى وكانت محقا % % وفتق الدنيا وكانت رتقا % % 62 
ms53	(@)(@@) % سامية في خيلها المسومه % وجاب عنها دامسات الظلمه % 63(@)(@@) % وجدد الملك الذي قد أخلقا % % حتى رست أوتاده واستوسقا % % 64(@)(@@) % وجمع العدة والعديدا % % وكثف الأجناد والحشودا % % 92(@)(@@) % ثم غزا في عقب عام قابل % فجال في شذونة والساحل % 93(@)(@@) % ولو يدع رية والجزيره % % حتى كوى أكلبها الهريره % 94(@)(@@) % حتى أناخ في ذرى قرمونه % % بكلكل كمدرة الطاحونه % % 95(@)(@@) % على الذي خالف فيها وانتزى % % يعزى إلى سوادة إذا اعتزى % % PageV01P319 96(@)(@@) % فسال أن يمهله شهورا % % ثم يكون عبده المأمورا % % 97(@)(@@) % فأسعف الأمير منه ما سأل % وعاد بالفضل عليه وقفل % 99(@)(@@) % % من غزو إحدى وثلاث ميه % % 100(@)(@@) % فلم يكن يدرك في باقيها % % غزو ولا بعث يكون فيها % % 102(@)(@@) % % وقد كساه عزمه وحزمه % 103(@)(@@) % فسار في جيش شديد الباس % % وقائد الجيش أبوالعباس % % 104(@)(@@) % حتى ترقى بذرى ببشتر % وجال في ساحاتها بالعسكر % 105(@)(@@) % فلم يدع زرعا ولا ثمارا % % لهم ولا علقا ولا عقارا % % 106(@)(@@) % مكارم يقصر عنها الوصف % ولم يباع علجها ولا ظهر % 107(@)(@@) % ثم انثنى من بعد ذاك قافلا % % وقد أباد الزرع والمآكلا % % PageV01P320 108(@)(@@) % فأيقن الخنزير عند ذاكا % % أن لا بقاء يرتجى هناكا % % 109(@)(@@) % فكاتب الإمام بالإجابه % % والسمع والطاعة والإنابه % % 110(@)(@@) % فأخمد الله شهاب الفتنه % % وأصبح الناس معا في هدنه % % 111(@)(@@) % وارتعت الشاة معا والذيب % إذ وضعت أوزارها الحروب % 113(@)(@@) % وبعدها كانت غزاة أربع % فأي صنع ربنا لم يصنع ؟ % 114(@)(@@) % فيها ببسط الملك الأواه % % كلتا يديه في سبيل الله % 115(@)(@@) % وذاك أن قود قائدين % بالنصر والتأييد ظاهرين % 116(@)(@@) % هذا إلى الثغر وما يليه % على عدو الشرك أو ذويه % % 117(@)(@@) % وذا إلى شم الربا من مرسيه % % وما مضى جرى إلى بلنسيه % % 118(@)(@@) % فكان من وجهه للساحل % القرشي القائد القنابل % % PageV01P321 119(@)(@@) % وابن أبي عبدة نحو الشرك % في خير ما تعبية وشك % 120(@)(@@) % فأقبلا بكل فتح شامل % وكل ثكل للعدو ثاكل % 121(@)(@@) % وبعد هذي الغزوة الغراء % كان افتتاح لبلة الحمراء % 122(@)(@@) % أغزى بجند نحوها مولاه % في عقب هذا العام لا سواه % 123(@)(@@) % بدرا فضم جانبيها ضمه % % وغمها حتى أجابت حكمه 
ms54	 % % 124(@)(@@) % أسلمت صاحبها مقهورا % % حتى أتى بدر به مأسورا % % 126(@)(@@) % وبعدها كانت غزاة خمس % إلى السوادي عقيد النحس % 127(@)(@@) % لما طغى وجاوز الحدودا % % ونقض الميثاق والعهودا % % 128(@)(@@) % ونابذ السلطان من شقائه % ومن تعديه وسوء رائه % 129(@)(@@) % أغزى إليه القرشي القائدا % % إذ صار عن قصد السبيل حائدا % % PageV01P322 130(@)(@@) % ثمت شد أزره ببدر % فكان كالشفع لهذا الوتر % 131(@)(@@) % أحدقها بالخيل والرجال % مشمرا ، وجد في القتال % 132(@)(@@) % فنازل الحصن العظيم الشان % بالرجل والرماة والفرسان % 133(@)(@@) % فلم يزل بدر بها محاصرا % % كذا على قتاله مثابرا % % 134(@)(@@) % والكلب في تهور قد انغمس % وضيق الحلق عليه والنفس % 135(@)(@@) % فافترق الأصحاب عن لوائه % وفتحوا الأبواب دون رائه % 136(@)(@@) % واقتحم العسكر في المدينه % وهو بها كهيئة الظعينه % 137(@)(@@) % مستسلما للذل والصغار % % وملقيا يديه للإسار % 138(@)(@@) % فنزع الحاجب تاج ملكه % وقاده مكتفا لهلكه % 139(@)(@@) % وكان في آخر هذا العام % نكب أبي العباس بالإسلام % PageV01P323 140(@)(@@) % غزا وكان أنجد الأنجاد % وقائدا من أفحل القواد % 141(@)(@@) % فسار في غير رجال الحرب % الضاربين عند وقت الضرب % 142(@)(@@) % محاربا في غير ما محارب % والحشم الجمهور عند الحاجب % 143(@)(@@) % واجتمعت إليه أخلاط الكور % وغاب ذو التحصيل عنه والنظر % 144(@)(@@) % حتى إذا أوغل في العدو % فكان بين البعد والدنو % 145(@)(@@) % أسلمه أهل القلوب القاسيه % وأفردوه للكلاب العاويه % 146(@)(@@) % فاستشهد القائد في أبرار % قد وهبوا نفوسهم للباري % % 147(@)(@@) % في غير تأخير ولا فرار % % إلا شديد الضرب للكفار % 149(@)(@@) % % وأحكم النصر لأوليائه % 150(@)(@@) % في مبدأ العام الذي من قابل % أزهق فيه الحق نفس الباطل % PageV01P324 151(@)(@@) % فكان من رأي الإمام الماجد % وخير مولود وخير والد % 152(@)(@@) % أن احتمى بالواحد القهار % وفاض من غيظ على الكفار % 153(@)(@@) % فجمع الأجناد والحشودا % % ونفر السيد والمسودا % % 154(@)(@@) % وحشر الأطراف والثغورا % % ورفض اللذات والحبورا % % 155(@)(@@) % حتى إذا ما وفت الجنود % واجتمع الحشاد والحشود % 156(@)(@@) % قود بدرا أمر تلك الطائفه % وكانت النفس عليه خائفه % 157(@)(@@) % فسار في كتائب كالسيل % وعسكر مثل سواد الليل % 158(@)(@@) % حتى إذا حل على مطنيه % % وكان فيها أخبث البريه % 159(@)(@@) % فحطه 
ms55	 من هضبات ولب % كأنما أضرم فيها النار % 160(@)(@@) % وجد من بينهم القتال % وأحدقت حولهم الرجال % PageV01P325 161(@)(@@) % فحاربوا يومهم وباتوا % % وقد نفت نومهم الرماة % 162(@)(@@) % فهم طوال الليل كالطلائح % جراحهم تنغل في الجوارح % 163(@)(@@) % ثم مضوا في حربهم أياما % % حتى بدا الموت لهم زؤاما % % 164(@)(@@) % لما رأوا سحائب المنيه % % تمطرهم صواعق البليه % % 165(@)(@@) % تغلغل العجم بأرض العجم % وانحشدوا من تحت كل نجم % 166(@)(@@) % فأقبل العلج لهم مغيثا % % يوم الخميس مسرعا حثيثا % % 167(@)(@@) % بين يديه الرجل والفوارس % وحوله الصلبان والنواقس % 168(@)(@@) % وكان يرجو أن يزيل العسكرا % % عن جانب الحصن الذي قد دمرا % % 169(@)(@@) % فاعتاقه بدر بمن لديه % مستبصرا في زحفه إليه % 170(@)(@@) % حتى التقت ميمنة بميسره % % واعتنت الأرواح عند الحنجره % % PageV01P326 171(@)(@@) % ففاز حزب الله بالعلجان % وانهزمت بطانة الشيطان % 172(@)(@@) % فقتلوا قتلا ذريعا فاشيا % وأدبر العلج ذميما خازيا % 173(@)(@@) % وانصرف الناس إلى القليعه % % فصبحوا العدو يوم الجمعه % 174(@)(@@) % ثم التقى العلجان في الطريق % % البنبلوني مع الجليقي % % 175(@)(@@) % فأعقدا على انتهاب العسكر % وأن يموتا قبل ذاك المحضر % 176(@)(@@) % وأقسما بالجبت والطاغوت % لا يهزما دون لقاء الموت % 177(@)(@@) % فأقبلوا بأعظم الطغيان % قد جللوا الجبال بالفرسان % 178(@)(@@) % حتى تداعى الناس يوم السبت % فكان وقتا يا له من وقت ! % 179(@)(@@) % فأشرعت بينهم الرماح % وقد علا التكبير والصياح % 180(@)(@@) % وفارقت أغمادها السيوف % وفغرت أفواهها الحتوف % PageV01P327 181(@)(@@) % والتقت الرجال بالرجال % وانغمسوا في غمرة القتال % 182(@)(@@) % في موقف زاغت به الأبصار % وقصرت في طوله الأعمار % 183(@)(@@) % وهب أهل الصبر والبصائر % فأوعقوا على العدو الكافر % 184(@)(@@) % حتى بدت هزيمة البشكنس % كأنه مختضب بالورس % 185(@)(@@) % فانقضت العقبان والسلالقه % زعقا على مقدم الجلالقه % 186(@)(@@) % عقبان موت تخطف الأرواحا % % وتشبع السيوف والرماحا % % 187(@)(@@) % فانهزم الخنزير عند ذا كا % % وانكشفت عورته هناكا % % 188(@)(@@) % فقتلوا في بطن كل واد % وجاءت الرؤوس في الأعواد % 189(@)(@@) % وقدم القائد ألف راس % من الجلاليق ذوي العماس % 190(@)(@@) % فتم صنع الله للإسلام % وعمنا سرور ذاك العام % PageV01P328 191(@)(@@) % وخير ما فيه من السرور % موت ابن حفصون به الخنزير % 192(@)(@@) % فاتصل الفتح بفتح 
ms56	 ثان % والنصر بالنصر من الرحمن % 193(@)(@@) % وهذه الغزاة تدعى القاضيه % % وقد أتتهم بعد ذاك الداهيه % 195(@)(@@) % وبعدها كانت غزاة بلده % % وهي التي أودت بأهل الرده % % 196(@)(@@) % وبدؤها أن الإمام المصطفى % % أصدق أهل الأرض عدلا ووفا % % 197(@)(@@) % لما أتته ميتة الخنزير % وأنه صار إلى السعير % 198(@)(@@) % كاتبه أولاده بالطاعه % وبالدخول مدخل الجماعه % 199(@)(@@) % أن يقرهم على الولايه % على درور الخرج والجبايه % 200(@)(@@) % فاختار ذلك الإمام المفضل % ولم يزل من رأيه التفضل % 201(@)(@@) % ثم لوى الشيطان رأس جعفر % وصار منه نافخا في المنخر % PageV01P329 202(@)(@@) % فنقض العهود والميثاقا % % واستعمل التشغيب والنفاقا % % 203(@)(@@) % وضم أهل النكث والخلاف % من غير ما كاف وغير وافي % % 204(@)(@@) % فاعتاقه الخليفة المؤيد % وهو الذي يشقى به ويسعد % 205(@)(@@) % ومن عليه من عيون الله % حوافظ من كل أمر داهي % % 206(@)(@@) % فجند الجنود والكتائبا % % وقود القواد والمقانبا % % 207(@)(@@) % ثم غزا في أكثر العديد % مستصحبا بالنصر والتأييد % 208(@)(@@) % حتى إذا مر بحصن بلده % % خلف فيه قائدا في عده % 209(@)(@@) % يمنعهم من انتشار خيلهم % وحارسا في يومهم وليلهم % 210(@)(@@) % ثم مضى يستنزل الحصونا % % ويبعث الطلاع والعيونا % % 211(@)(@@) % حتى أتاه باشر من بلده % يعدو برأس رأسها في صعده % PageV01P330 212(@)(@@) % فقدم الخيل إليها مسرعا % % واحتلها من يومه تسرعا % % 213(@)(@@) % فخفها بالخيل والرماة % وجملة الحماة والكماة % 214(@)(@@) % فاطلع الرجل على أنقابها % % واقتحم الجند على أبوابها % % 215(@)(@@) % فأذعنت ولم تكن بمذعنه % واستسلمت كافرة لمؤمنه % 216(@)(@@) % فقدمت كفارها للسيف % وقتلوا بالحق لا بالحيف % 217(@)(@@) % وذاك من يمن الإمام المرتضى % % وخير من بقي وخير من مضى % % 218(@)(@@) % ثم انتحى من فوره ببشترا % % فلم يدع بها قضيبا أخضرا % % 219(@)(@@) % وحطم النبات والزروعا % % وهتك الرباع والربوعا % % 220(@)(@@) % فإذ رأى الكلب الذي رآه % من عزمه في قطع منتواه % 221(@)(@@) % ألقى إليه باليدين ضارعا % % وسال أن يبقي عليه وادعا % % PageV01P331 222(@)(@@) % وأن يكون عاملا في طاعته % على درور الخرج من جبايته % 223(@)(@@) % فوثق الإمام من رهانه % كيلا يكون في عمى من شانه % 224(@)(@@) % وقبل الإمام ذاك منه % فضلا وإحسانا وسار عنه % 226(@)(@@) % ثم غزا 
ms57	 الإمام دار الحرب % فكان خطبا يا له من خطب % 227(@)(@@) % فحشدت إليه أعلام الكور % ومن له في الناس ذكر وخطر % 228(@)(@@) % إلى ذوي الديوان والرايات % وكل منسوب إلى الشامات % 229(@)(@@) % وكل من أخلص للرحمان % بطاعة في السر والإعلان % 230(@)(@@) % وكل من طاوع في الجهاد % أو ضمه سرج على الجياد % 231(@)(@@) % فكان حشدا يا له من حشد % من كل حر عندنا وعبد % 232(@)(@@) % فتحسب الناس جرادا منتشر % كما يقول ربنا فيمن حشر % PageV01P332 233(@)(@@) % ثم مضى المظفر المنصور % على جبينه الهدى والنور % 234(@)(@@) % أمامه جند من الملائكه % آخذة لربها وتركه % 235(@)(@@) % حتى إذا فوز في العدو % جنبه الرحمن كل سو % 236(@)(@@) % وأنزل الجزية والدواهي % % على الذين أشركوا بالله % 237(@)(@@) % فزلزلت أقدامهم بالرعب % واستنفروا من خوف نار الحرب % 238(@)(@@) % واقتحموا الشعاب والمكامنا % % وأسلموا الحصون والمدائنا % % 239(@)(@@) % فما بقي من جنبات دور % من بيعة لراهب أو دير % 240(@)(@@) % إلا وقد صيرها هباء % كالنار إذ وافقت الأباء % 241(@)(@@) % وزعزعت كتائب السلطان % لكل ما فيها من البنيان % 242(@)(@@) % فكان من أول حصن زعزعوا % % ومن به من العدو أوقعوا % % PageV01P333 243(@)(@@) % مدينة معروفة بوخشمه % فغادروها فحمة مسخمه % 244(@)(@@) % ثم ارتقوا منها إلى حواضر % فغادروها مثل أمس الدابر % 245(@)(@@) % ثم مضوا والعلج يحتذيهم % % بجيشه يخشى ويقتفيهم % 246(@)(@@) % حتى أتوا توا لوادي دي % ففيه عفى الرشد سبل الغي % 247(@)(@@) % لما التقوا بمجمع الجوزين % % واجتمعت كتائب العلجين % 248(@)(@@) % من أهل أليون وبنبلونه % وأهل أرنيط وبرشلونه % 249(@)(@@) % تضافر الكفر مع الإلحاد % واجتمعوا من سائر البلاد % 250(@)(@@) % فاضطربوا في سفح طود عال % وصففوا تعبية القتال % 251(@)(@@) % فبادرت إليهم المقدمه % سامية في خيبها المسومه % 252(@)(@@) % وردها متصل برد % يمده بحر عظيم المد % PageV01P334 253(@)(@@) % فانهزم العلجان في علاج % ولبسوا ثوبا من العجاج % 254(@)(@@) % كلاهما ينظر حينا خلفه % فهو يرى في كل وجه حتفه % 255(@)(@@) % والبيض في إثرهم والسمر % والقتل ماض فيهم والأسر % 256(@)(@@) % فلم يكن للناس من براح % وجاءت الرؤوس في الرماح % 257(@)(@@) % فأمر الأمير بالتقويض % وأسرع العسكر في النهوض % 258(@)(@@) % فصادفوا الجمهور لما هزموا 
ms58	 % % وعاينوا قوادهم تخرموا % % 259(@)(@@) % فدخلوا حديقة للموت % إذ طمعوا في حصنها بالفوت % 260(@)(@@) % فيا لها حديقة ويا لها % % وافت بها نفوسهم آجالها % % 261(@)(@@) % تحصنوا إذ عاينوا الأهوالا % % لمعقل كان لهم عقالا % % 262(@)(@@) % وصخرة كانت عليهم صيلما % % وانقلبوا منها إلى جهنما % % PageV01P335 263(@)(@@) % تساقطوا يستطعمون الماء % فأخرجت أرواحهم ظماء % 264(@)(@@) % فكم لسيف الله من جزور % في مأدب الغربان والنسور % 265(@)(@@) % وكم به قتلى من القساوس % تندب للصلبان والنواقس % 266(@)(@@) % ثم ثنى عنانه الأمير % وحوله التهليل والتكبير % 267(@)(@@) % مصمما بحرب دار الحرب % قدامه كتائب من عرب % 268(@)(@@) % فداسها وسامها بالخسف % والهتك والسفك لها والنسف % 269(@)(@@) % فحرقوا ومزقوا الحصونا % % وأسخنوا من أهلها العيونا % % 270(@)(@@) % فانظر عن اليمين واليسار % فما ترى إلا لهيب النار % 271(@)(@@) % وأصبحت ديارهم بلا قعا % % فما نرى إلا دخانا ساطعا % % 272(@)(@@) % ونصر الإمام فيها المصطفى % % وقد شفى من العدو واشتفى % % PageV01P336 274(@)(@@) % وبعدها كانت غزاة طرش % سما إليها جيشه لم ينهش % 275(@)(@@) % وأحدقت بحصنها الأفاعي % % وكل صل أسود شجاع % 276(@)(@@) % ثم بنى حصنا عليها راتبا % % يعتور القواد فيه دائبا % % 277(@)(@@) % حتى أنابت عنوة جنانها % % وغاب عن يافوخها شيطانها % % 278(@)(@@) % فأذعنت لسيد السادات % وأكرم الأحياء والأموات % 279(@)(@@) % خليفة الله على عباده % وخير من يحكم في بلاده % 280(@)(@@) % وكان موت بدر ابن أحمد % بعد قفول الملك المؤيد % 281(@)(@@) % واستحجب الإمام خير حاجب % وخير مصحوب وخير صاحب % 282(@)(@@) % موسى الأغر من بني حدير % عقيد كل رأفة وخير % 284(@)(@@) % وبعدها غزاة عشر غزوه % بها افتتاح منتلون عنوه % PageV01P337 285(@)(@@) % غزا الإمام في ذوي السلطان % يؤم أهل النكث والطغيان % 286(@)(@@) % فاحتل حصن منتلون قاطعا % % أسبابض من أصبح فيه خالعا % % 287(@)(@@) % سار إليه وبنى عليه % حتى أتاه ملقيا يديه % 288(@)(@@) % ثم انثنى عنه إلى شذونه % فعاضها سهلا من الحزونه % 289(@)(@@) % وساقها بالأهل والولدان % إلى لزوم قبة الإيمان % 290(@)(@@) % ولم يدع صعبا ولا منيعا % % إلا وقد أذلهم جميعا % % 291(@)(@@) % ثم انثنى بأطيب القفول % كما مضى بأحسن الفضول % 293(@)(@@) % وبعدها غزاة إحدى عشره % كم نبهت من نائم في سكره % 294(@)(@@) % غزا 
ms59	 الإمام ينتحي ببشترا % % في عسكر أعظم بذاك عسكرا % % 295(@)(@@) % فاحتل من ببشترا ذراها % % وجال في شاط وفي سواها % % PageV01P338 296(@)(@@) % فخرب العمران من ببشتر % وأذعنت شاط لرب العسكر % 297(@)(@@) % فأدخل العدة والعديدا % % فيها ولم يترك بها عنيدا % % 298(@)(@@) % ثم انتحى بعد حصون العجم % فداسها بالقضم بعد الخضم % 299(@)(@@) % ما كان من سواحل البحور % منها وفي الغابات والوعور % 300(@)(@@) % وأدخل الطاعة في مكان % لم يدر قط طاعة السلطان % 301(@)(@@) % ثم رمى الثغر بخير قائد % وذادهم عنه بخير ذائد % 302(@)(@@) % به قما الله ذوي الإشراك % وأنقذ الثغر من الهلاك % 303(@)(@@) % وانتاش من مهواتها تطيله % وقد جرت دماؤها مطلوله % 304(@)(@@) % وطهر الثغر وما يليه % من شيعة الكلإفر ومن ذويه % 305(@)(@@) % ثم انثنى بالفتح والنجاح % قد غير الفساد بالصلاح % PageV01P339 307(@)(@@) % وبعدها غزاة اثنتي عشره % وكم بها من حسرة وعبره % 308(@)(@@) % غزا الإمام حوله كتائبه % % كالبدر محفوفا به كواكبه % % 309(@)(@@) % غزا وسيف النصر في يمينه % % وطالع السعد على جبينه % 310(@)(@@) % وصاحب العسكر والتدبير % موسى الأغر حاجب الأمير % 311(@)(@@) % فدمر الحصون من تدمير % واستنزل الوحش من الصخور % 312(@)(@@) % فاجتمعت عليه كل الأمة % % وبايعته أمراء الفتنه % 313(@)(@@) % حتى إذا أوعب من حصونها % % وجمل الحق على متونها % % 314(@)(@@) % مضى وسار في ظلال العسكر % تحت لواء الأسد الغضنفر % 315(@)(@@) % رجال تدمير من يليهم % من كل صنف يعتزى إليهم % 316(@)(@@) % حتى إذا حل على تطيله % بكت على دمائها المطلوله % PageV01P340 317(@)(@@) % وعظم ما لاقت من العدو % والحرب في الرواح والغدو % 318(@)(@@) % فهم أن يديخ دار الحرب % وأن تكون ردأه في الدرب % 319(@)(@@) % ثم استثار ذا النهى واالحجر % من صحبه ومن رجال الثغر % 320(@)(@@) % فكلهم أشار أن لا يدربا % % ولا يجوز الجبل الموشبا % % 321(@)(@@) % لأنه في عسكر قد انخرم % بندب كل العرفاء والحشم % 322(@)(@@) % وشنعوا أن وراء الفج % خمسين ألفا من رجال العلج % 323(@)(@@) % فقال : لابد من الدخول % وما إلى حاشاه من سبيل % 324(@)(@@) % وأن أديخ أرض بنبلونه % وساحة المدينة الملعونه % 325(@)(@@) % وكان رأيا لم يكن من صاحب % ساعده عليه غير الحاجب % 326 
ms60	(@)(@@) % فاستنصر الله وعبى ودخل % فكان فتحا لم يكن له مثل % PageV01P341 327(@)(@@) % لما مضى وجاوز الدروبا % % وادرع الهيجاء والحروبا % % 328(@)(@@) % عبى له علج من الأعلاج % كتائبا غطت على الفجاج % 329(@)(@@) % فاستنصر الإمام رب الناس % ثم استعان بالندى والباس % 330(@)(@@) % وعاذ بالرغبة والدعاء % واستنزل النصر من السماء % 331(@)(@@) % فقدم القواد بالحشود % وأتبع المدود بالمدود % 332(@)(@@) % فانهزم العلج وكانت ملحمه % جاوز فيها الساقة المقدمه % 333(@)(@@) % فقتلوا مقتلة الفناء % فارتوت البيض من الدماء % 334(@)(@@) % ثم أمال نحو بنبلونه % % واقتحم العسكر في المدينه % 335(@)(@@) % حتى إذا جاسوا خلال دورها % % وأسرع الخراب في معمورها % % 336(@)(@@) % % إذ جعلت تدقها الحوافر % PageV01P342 337(@)(@@) % لفقد من قتل من رجالها % % وذل من أيتم من أطفالها % % 338(@)(@@) % فكم بها وحولها من أغلف % تهمي عليه الدمع عين الأسقف % 339(@)(@@) % وكم بها حقر من كنائس % بدلت الآذان بالنواقس % 340(@)(@@) % يبكي لها الناقوس والصليب % كلاهما فرض له النحيب % 341(@)(@@) % وانصرف الإمام بالنجاح % والنصر والتأييد والفلاح % 342(@)(@@) % ثم ثنى الرايات في طريقه % إلى بني ذي النون من توفيقه % 343(@)(@@) % فأصبحوا من بسطهم في قبض % قد ألصقت خدودهم بالأرض % 344(@)(@@) % حتى بدوا إليه بالبرهان % من أكبر الآباء والولدان % 345(@)(@@) % فالحمد لله على تأييده % % حمدا كثيرا وعلى تسديده % % 347(@)(@@) % ثم غزا بيمنه أشونا % % وقد أشادوا حولها حصونا % % PageV01P343 348(@)(@@) % وحفها بالخيل والرجال % وقاتلوهم أبلغ القتال % 349(@)(@@) % حتى إذا ما عاينوا الهلاكا % % تبادروا بالطوع حينذاكا % % 350(@)(@@) % وأسلموا حصنهم المنيعا % % وسمحوا بخرجهم خضوعا % % 351(@)(@@) % وقبلهم في هذه الغزاة % قد هدمت معاقل العصاة % 352(@)(@@) % وأحكم الإمام في تدبيره % على بني هابل في مسيره % 353(@)(@@) % ومن سواهم من ذوي العشيره % وأمراء الفتنة المغيرة % % 354(@)(@@) % إذ حبسوا مراقبا عليهم % حتى أتوا بكل ما لديهم % 355(@)(@@) % من البنين والعيال والحشم % وكل من لاذ بهم من الخدم % 356(@)(@@) % فهبطوا من أجمع البلدان % وأسكنوا مدينة السلطان % 357(@)(@@) % فكان في آخر هذا العام % بعد خضوع الكفر للإسلام % PageV01P344 358(@)(@@) % مشاهد من أعظم المشاهد % على يدي عبد الحميد القائد % 359(@)(@@) % لما غزا إلى بني ذي النون % % فكان فتحا لم يكن 