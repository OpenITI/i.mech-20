ms2001	 أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2109 -(@)(@@) عمير سمع ابن عباس قوله سمع منه يحيى بن عمير مولى بنى اسد المديني سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2110 -(@)(@@) عمير أبو صالح روى عن أبي هريرة " تفضل صلاة الجميع " روى عنه بكير بن الأشج سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2111 -(@)(@@) عمير الانصاري روى عن الحسين (2) بن علي روى عنه ابنه موسى (3) ابن عمير سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2112 -(@)(@@) عمير رأى عمرو بن العاص (يمسح على الخفين - 4) روى عنه ابنه عتبة بن عمير سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2113 - -(@)(@@) عمير أبو المغلس ويقال ميمون أبو المغلس روى عن ابن PageV06P380(@)(@@) ابى نجيح، مرسل روى عنه ابن جريج سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2114 -(@)(@@) عمير روى عن مجاهد قوله سمعت أبي يقول ذلك، ويقول هو مجهول.(@)(@@)(@@)(@@) $ 2115 -(@)(@@) عمير الضبى روى عن ليث روى عنه أبو معاوية سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عطية(@)(@@)(@@)(@@) ||||| واسم ابيه على الالف(@)(@@)(@@)(@@) $ 2116 -(@)(@@) عطية بن الاسود سمع ابن عمر روى عنه مغيرة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2117 -(@)(@@) عطية بن ابى امية سمع مورقا قوله روى عنه مهدي بن ميمون (سمعت أبي يقول ذلك - 1) .(@)(@@)(@@)(@@) ||||| باب الباء(@)(@@)(@@)(@@) $ 2118 -(@)(@@) عطية بن بسر الشامي روى حديث عكاف بن وداعة روى بقية عن معاوية بن يحيى عن سليمان بن موسى عن مكحول عن غضيف بن الحارث الثمالى عن عطية بن بسر قال اتى عكاف بن وداعة إلى رسول الله صلى الله(@)(@@) عليه وسلم سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2119 -(@)(@@) عطية بن بهرام روى عن شيبان اليشكرى ومورق العجلى وقتادة سمع منه وكيع وابو نعيم ومسلم وابو الوليد وسهل بن تمام سمعت أبي يقول ذلك، وسألته عنه فقال شيخ ليس به بأس.(@)(@@)(@@)(@@) $ 2120 -(@)(@@) عطية بن بقية بن الوليد الحمصى أبو سعيد روى عن أبيه بقية ابن الوليد كتبت عنه ومحله الصدق وكانت فيه غفلة.(@)(@@)(@@)(@@) ||||| باب الجيم(@)(@@)(@@)(@@) $ 2121 -(@)(@@) عطية بن جبير العنزي واختلف فيه الرواة عن سماك بن حرب PageV06P381(@)(@@) فقال شعبة عن سماك عن عطية بن جبير عن على، وروى 
ms2002	 إبراهيم بن طهمان عن سماك عن حريث عن عطية بن جبير قال قلت لعلى رضى الله عنه، وروى أبو الأحوص عن سماك عن حريث بن عميرة عن ام عطية عن على، وروى حماد بن سلمة عن سماك عن ام عطية عن على، وروى سفيان الثوري عن سماك عن ابى عطية بن جبير عن على، سمعت أبي يقول بعض ذلك، وبعضه من قبلى.(@)(@@)(@@)(@@) ||||| باب الحاء(@)(@@)(@@)(@@) $ 2122 -(@)(@@) عطية بن الحارث أبو روق الهمداني روى عن الشعبى والضحاك روى عنه الثوري وشريك وعبد الواحد بن زياد وبشر بن عمارة وابنه يحيى سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سئل أبي عن أبي روق قال ليس به بأس، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال أبو روق عطية بن الحارث صالح، نا عبد الرحمن قال سألت ابى عن ابى روق عطية بن الحارث(@)(@@) فقال صدوق.(@)(@@)(@@)(@@) ||||| باب الراء(@)(@@)(@@)(@@) $ 2123 -(@)(@@) عطية بن رافع أبو هزان الشامي وهو عطية بن ابى جميلة سمع حذيفة وروى عن معاوية وقد ادركه وروى عن كعب روى عنه فضيل بن فضالة وصفوان بن عمرو ويحيى بن حصين سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) ||||| باب السين(@)(@@)(@@)(@@) $ 2124 -(@)(@@) عطية بن سفيان بن عبد الله بن ربيعة الثقفي روى عن الوفد الذين جاؤا إلى النبي صلى الله عليه وسلم روى عنه عيسى بن عبد الله بن مالك الدار، روى عنه محمد مولى عطية سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2125 -(@)(@@) عطية بن سعد العوفى الجدلي كوفى أبو الحسن روى عن أبي سعيد الخدري وابى هريرة وابن عمر وابن عباس روى عنه الاعمش واسمعيل(@)(@@) PageV06P382(@)(@@) ابن ابى خالد ومسعر وابن ابى ليلى وقرة بن خالد سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلى قال سمعت أبي وذكر عطية العوفى فقال هو ضعيف الحديث بلغني ان عطية كان يأتي 
ms2003	 الكلبى فيأخذ عنه التفسير، وكان الثوري وهشيم يضعفان حديث عطية، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال قيل ليحيى بن معين كيف حديث عطية؟ قال صالح، نا عبد الرحمن قال سألت ابى عن عطية العوفى فقال (ضعيف الحديث يكتب حديثه وابو نضرة احب إلى من عطية، سئل أبو زرعة عنه فقال كوفى - 1) لين.(@)(@@)(@@)(@@) $ 2126 -(@)(@@) عطية بن سعد الدعاء البصري سمع الحكم بن الحارث روى عنه (كهمس بن الحسن ومحمد بن حمران - 2) .(@)(@@)(@@)(@@) ||||| باب العين(@)(@@)(@@)(@@) $ 2127 -(@)(@@) عطية بن عروة السعدى من سعد بن بكر شامي له صحبة روى عنه ابن ابنه عروة بن محمد بن عطية عن ابيه عن جده عطية السعدي سمعت أبي يقول ذلك، قال أبو محمد روى عنه ربيعة بن يزيد وعطية بن قيس.(@)(@@)(@@)(@@) $ 2128 -(@)(@@) عطية بن عارض روى عن ابن عباس روى عنه أبو خالد الدالانى وروى مسعر عن عبد الكريم عنه سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2129 -(@)(@@) عطية بن عبد الله بن انيس الجهنى اخو عيسى بن عبد الله بن انيس حجازى روى عن أبيه وروى عنه اخوه بلال بن عبد الله سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2130 -(@)(@@) عطية بن عبد الرحمن أبو محمد الثقفى روى عن القاسم بن عبد الرحمن مرسل روى عنه الثوري وشريك سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) ||||| باب القاف(@)(@@)(@@)(@@) $ 2131 -(@)(@@) عطية بن قيس الكلابي أبو يحيى حمصي روى عن ابن عمر ومعاوية روى عنه ابنه سعد بن عطية وأبو بكر بن أبي مريم وداود بن عمرو الدمشقي مات وهو ابن مائة واربع سنين سمعت أبي يقول ذلك، وسمعته يقول عطية PageV06P383(@)(@@) مولى لبنى عامر الذي روى عنه يزيد بن بشر عن ابن عمر عن النبي صلى الله عليه وسلم بنى الاسلام على خمس روى عنه سالم بن أبي الجعد وهو عطية بن قيس رأى ابن ام مكتوم يوما من ايام الكوفة عليه درع سابغ يجرها، نا عبد الرحمن قال سئل ابى عن عطية بن قيس فقال صالح الحديث.(@)(@@)(@@)(@@) ||||| باب من يسمى عطية ولا 
ms2004	 ينسب(@)(@@)(@@)(@@) $ 2132 -(@)(@@) عطية القرظى له صحبة روى عنه مجاهد وعبد الملك بن عمير(@)(@@) وكثير بن السائب في رواية (1) حماد بن سلمة عن ابى جعفر الخطمى عن كثير بن السائب عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2133 -(@)(@@) عطية أبو المعذل الطفاوى روى عن ابن عمر - وعن امه روى عنه سليمان التيمي وعوف الاعرابي وخالد الحذاء سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 2134 -(@)(@@) عطية السلمى السراج كاتب عبد الله بن مطرف بصري روى عن عبد الله بن مطرف والشعبى روى عنه حاتم بن أبي صغيرة وأيوب السختياني سمعت أبي يقول ذلك، وسألته عنه فقال شيخ.(@)(@@)(@@)(@@) $ 2135 -(@)(@@) عطية الراسبى سمع الحسن روى عن امرأة عن عمر روى عنه بديل بن ميسرة العقيلى وسعيد بن ابى عروبة وابان بن يزيد سمعت أبي يقول ذلك(@)(@@)(@@)(@@) $ 2136 - عطية مولى السلم روى عن معاذ بن جبل روى عنه ثور بن يزيد وبرد بن سنان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2137 -(@)(@@) عطية أبو وهب السمسار سمع الحسن روى عنه هشيم ويزيد ابن هارون سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عونا(@)(@@)(@@)(@@) $ 2138 -(@)(@@) عون بن عبد الله بن عتبة بن مسعود الهذلى سمع ابا هريرة وابن عمر سمع منه مسعر والمسعودي والشيبانى سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال عون بن عبد الله PageV06P384(@)(@@) ابن عتبة ثقة.(@)(@@)(@@)(@@) $ 2139 -(@)(@@) عون بن ابى جحيفة كوفى واسم ابى جحيفة وهب بن عبد الله السوائى من بنى عامر بن صعصعة روى عن أبيه ولأبيه صحبة روى عنه الثوري(@)(@@) وشعبة ومسعر سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن اسحاق ابن منصور عن يحيى بن معين قال عون بن ابى جحيفة ثقة، نا عبد الرحمن قال سألت ابى عن عون بن أبي جحيفه فقال ثقة.(@)(@@)(@@)(@@) $ 2140 -(@)(@@) عون بن عبد الله الازدي ويقال الاسدي روى عن ابن عمر روى عنه أبو فروة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2141 -(@)(@@) عون بن عبد 
ms2005	 الله بن سلام روى عن أبيه عبد الله بن سلام روى عنه حرملة بن عبد العزيز بن الربيع بن سبرة.(@)(@@)(@@)(@@) $ 2142 -(@)(@@) عون العقيلى أبو معمر روى عن انس ومطرف بن عبد الله ومورق وعبد الرحمن بن أبي بكرة روى عنه هشام الدستوائى وعمارة بن زاذان والجريري وسليمان بن المغيرة وهارون النحوي وعمر بن عبد الله الرومي سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عون العقيلى ثقة.(@)(@@)(@@)(@@) $ 2143 -(@)(@@) عون بن على بن عبيد الله بن ابى رافع ويقال عون بن عبيد الله بن ابى رافع فنسب إلى جده ومنهم من يقول عون بن عبد الله بن ابى رافع يخطئ فيه وبعض الناس (1) جعله ثلاثة اسامى كتب في موضع عون بن عبيد الله وفى موضع عون بن على بن عبيد الله وفى موضع عون بن عبد الله وكلهم واحد روى عن أبيه وعبيد الله بن عبد الله بن عمر روى عنه يحيى بن سعيد الانصاري وأبو جعفر محمد بن علي وموسى بن يعقوب الزمعي سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه سئل عن عون بن عبيد الله بن ابى رافع فقال مشهور.(@)(@@)(@@)(@@) $ 2144 -(@)(@@) عون بن عباس روى عن حفصة ابنه عبد الرحمن بن أبي بكر PageV06P385(@)(@@) روى عنه عبد الرحمن الأعرج سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2145 -(@)(@@) عون أبو محمد بصري روى عن أبي موسى الاشعري حديثا منقطعا روى عنه أبو هلال الراسبي سمعت أبي يقول ذلك ويقول هو مجهول.(@)(@@)(@@)(@@) $ 2146 -(@)(@@) عون بن الخطاب بن عبد الله بن رافع (1) عن ابن لانس بن مالك روى عنه ابن أبي ذئب حديث أنس سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2147 -(@)(@@) (عون بن محمد بن علي بن أبي طالب الهاشمي روى عن أبيه عن جده روى عنه يونس بن راشد ومحمد بن موسى وعبد الملك بن ابى عياش سمعت أبي يقول ذلك - 2) .(@)(@@)(@@)(@@) $ 2148 -(@)(@@) عون 
ms2006	 مولى ام حكيم ابنة يحيى بن الحكم المدينى، وام حكيم امرأة هشام بن عبد الملك روى عن الزهري روى عنه الماجشون وابن ابى ذئب وابنه محمد بن عون سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2149 -(@)(@@) عون بن أرطبان مولى مزينة والد عبد الله بن عون روى عن أبيه عن عمر روى عنه ابنه عبد الله بن عون سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2150 -(@)(@@) عون بن يعقوب روى عن ابن سيرين أو ابى حبيب روى عنه مسعدة بن اليسع سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2151 -(@)(@@) عون بن موسى أبو روح بصرى سمع معاوية بن قرة وبكر ابن عبد الله المزني والحسن البصري وإياس بن معاوية روى عنه أبو سلمة (3) واللاحقى سمعت أبي يقول ذلك، نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلى نا عبيد الله بن عمر القواريرى نا عون بن موسى وكان ثقة،.(@)(@@) نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلي قال ثنا عثمان بن سعيد قال سألت يحيى بن معين عن عون بن موسى فقال ثقة، نا عبد الرحمن قال سألت(@)(@@) ابى عن عون بن موسى فقال لا بأس به.(@)(@@)(@@)(@@) $ 2152 -(@)(@@) عون بن عمرو القيسي اخو رياح بن عمرو الزاهد روى عن PageV06P386(@)(@@) سعيد الجريري روى عنه مسلم بن ابراهيم واسمعيل بن سيف وروى عنه عمرو ابن على ومحمد بن أبي بكر المقدمي فقالا حدثنا عون أبو عون القيسي عن ابى مصعب المكى عن أنس، حدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى ابن معين انه قال عون بن عمرو القيسي لا شئ، نا عبد الرحمن قال سألت ابى عن عون بن عمرو القيسي فقال شيخ.(@)(@@)(@@)(@@) $ 2153 -(@)(@@) (عون السهمى قال أتيت ابا امامة فقال لا تسب الحجاج فانه عليك امير وليس على روى عنه حاتم بن أبي صغيرة سمعت أبي يقول ذلك - 1) .(@)(@@)(@@)(@@) $ 2154 -(@)(@@) عون بن المعمر قال كتب الحسن إلى عمر بن عبد العزيز روى عنه ابن المبارك وسعيد بن عامر وعبد الله بن 
ms2007	 محمد بن اسماء وإبراهيم بن موسى سمعت أبي يقول ذلك، قال أبو محمد روى عن إبراهيم بن ميمون الصائغ روى عنه احمد بن عبدة، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال قال ابى عون بن المعمر هذا شيخ صالح، نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحى بن معين يقول عون بن معمر ثقة، نا عبد الرحمن قال سألت ابى عن عون بن معمر فقال صالح الحديث، نا عبد الرحمن قال سئل أبو زرعة عن عون بن معمر فقال ثقة.(@)(@@)(@@)(@@) $ 2155 -(@)(@@) عون بن الاشهب بن ملقام بن التلب بن ثعلبة العنبري التميمي روى عن جده التلب روى عنه موسى بن اسمعيل سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2156 -(@)(@@) عون بن ذكوان الحرشى بصرى أبو جناب القصاب روى عن زرارة بن اوفى وعمرو بن هرم وزياد النميري وعامر الاحول وحفص بن غياث ومطر روى عنه يزيد بن هارون وهدبة بن خالد سمعت أبي يقول ذلك، قال أبو محمد وروى عن سعيد بن جبير، نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال سألت أحمد بن حنبل عن أبي جناب القصاب فقال ثقة، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحى بن معين أنه قال أبو جناب القصاب ثقة، نا عبد الرحمن قال سألت ابى عن ابى جناب القصاب PageV06P387(@)(@@) فقال لا بأس به صالح الحديث.(@)(@@)(@@)(@@) $ 2157 -(@)(@@) عون بن مثيل الضبى ويقال عون بن بثين الحارثى ويقال عون بن نبيل الجريرى بصري روى عن عبد الله بن بريدة روى عنه ابن المبارك وأبو عامر العقدي وعبد الصمد بن عبد الواث سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2158 -(@)(@@) عون بن صالح البارقى روى عن عطية العوفي روى عنه عبد الله بن المبارك ووكيع سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2159 -(@)(@@) عون بن كهمس بن الحسن روى عن هشام بن حسان وعمران ابن حدير روى عنه 
ms2008	 محمد بن المثنى ومحمد بن بشار بندار سمعت أبي يقول ذلك، نا عبد الرحمن أنا حرب بن اسمعيل الكرماني فيما كتب إلي قال قلت لاحمد بن حنبل عون بن كهمس؟ فقال لا اعرافه.(@)(@@)(@@)(@@) $ 2160 -(@)(@@) عون بن عمارة البصري روى عن سليمان التيمى وسعيد بن ابى عروبة وهشام بن حسان سمعت أبي يقول ذلك، ويقول أدركته ولم أكتب عنه وكان منكر الحديث ضعيف الحديث (سئل أبو زرعة عن عون بن(@)(@@) عمارة فقال منكر الحديث - 1) .(@)(@@)(@@)(@@) $ 2161 -(@)(@@) عون بن سلام القرشى أبو جعفر مولى بني هاشم روى عن زهير بن معاوية وبشر بن عمارة ومندل بن على وابى اسرائيل الملائى وابى بكر النهشلي وعيسى بن عبد الرحمن السلمي روى عنه أبو زرعة وموسى بن اسحاق الانصاري.(@)(@@)(@@)(@@) $ 2162 -(@)(@@) عون بن الحكم بن سنان الباهلى أبو بكر روى عن حماد بن سلمة وحماد بن زيد وابيه الحكم بن سنان وأبي عوانة روى عنه أبي وأبو زرعة سئل أبي عنه فقال بصرى صدوق.(@)(@@)(@@)(@@) $ 2163 -(@)(@@) عون بن جرير بن عبد الحميد رازى روى عن أبيه سمع منه أبي وسئل عنه فقال صدوق.(@)(@@)(@@)(@@) $ 2164 -(@)(@@) عون بن حريث روى عن رقبة بن مسقلة روى عنه الوليد PageV06P388(@)(@@) ابن مسلم.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عمارا(@)(@@)(@@)(@@) $ 2165 -(@)(@@) عمار بن ياسر أبو اليقظان مولى بنى مخزوم بدرى قتل وهو ابن ثلاث وتسعين سنة له صحبة روى عنه محمد بن على ابن الحنفية وعبد الرحمن بن ابزى وعبيد الله بن عبد الله بن عتبة وصلة بن زفر وسلمان الاغر وابو مالك الغفاري والسائب بن فروخ وقيس بن عباد وابنه محمد بن عمار وابو حسان الاعرج ويزيد بن خثيم ونعيم بن حنظلة وناجية بن كعب سمعت بعض ذلك من أبي وبعضه من قبلى.(@)(@@)(@@)(@@) $ 2166 -(@)(@@) عمار بن معاذ بن زرارة الظفرى أبو نملة الانصاري من الأوس له صحبة روى عنه ابنه.(@)(@@)(@@)(@@) $ 2167 -(@)(@@) عمار بن ابى عمار مولى بنى هاشم أبو عمرو مكى سمع ابا قتادة وابا هريرة وابن عباس وعمران بن حصين وابا 
ms2009	 حبة البدرى روى عنه عطاء بن أبي رباح ويونس بن عبيد وحميد الطويل وشعبة وعوف وحماد بن سلمة سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال قال ابى عمار بن ابى عمار ثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن عمار بن أبي عمار فقال ثقة لا بأس به، نا عبد الرحمن قال سئل أبو زرعة عن عمار بن أبي عمار مولى بني هاشم فقال ثقة لا بأس به.(@)(@@)(@@)(@@) $ 2168 -(@)(@@) عمار الغفاري روى عن عمر رضي الله عنه روى عنه عبد الله ابن صفوان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2169 -(@)(@@) عمار بن سعد القرظ المؤذن المدينى سمع ابا هريرة حديث المواقيت روى عنه عمر بن عبد الرحمن بن اسيد بن زيد بن الخطاب وابنه سمعت أبي يقول ذلك.(@)(@@) PageV06P389(@)(@@)(@@)(@@) $ 2170 -(@)(@@) عمار بن سعد التجيبى روى عن ... (1) سمع منه بكير بن عبد الله ابن الاشج وعطاء بن دينار وعياش بن عباس سمعت أبى يقول ذلك.(@)(@@) قال أبو محمد(@)(@@)(@@)(@@) $ 2171 -(@)(@@) عمار بن سعد السلهمى وسلهم من اليمن روى عن ابى فراس يزيد بن رباح روى عنه حيوة بن شريح، وهو عمار بن سعد التجيبى وتجيب من اليمن.(@)(@@)(@@)(@@) $ 2172 -(@)(@@) عمار بن سعد المؤذن المدينى روى عن أبي عبيدة بن محمد بن عمار(@)(@@) بن ياسر روى عنه علي بن مجاهد سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2173 -(@)(@@) (عمار المزني سمع انسا قوله روى عنه حميد الطويل سمعت ابى يقول ذلك - 2) .(@)(@@)(@@)(@@) $ 2174 -(@)(@@) عمار بن عتبة (3) العبسي روى عن عبد الله بن سيار (4) روى عنه شعبة سمعت أبي يقول ذلك، نا عبد الرحمن نا ابى عن الربيع بن يحيى عن شعبة بذلك قال وسألته عنه فقال هو صالح الحديث وهو صدوق، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عمار بن عتبة (3) ثقة.(@)(@@)(@@)(@@) $ 2175 -(@)(@@) عمار الدهنى وهو عمار بن ابى معاوية أبو معاوية البجلى وهى (5) قبيلة من بجيلة كوفي روى 
ms2010	 عن سعيد بن جبير روى عنه الاجلح وسفيان الثوري وزهير بن معاوية وعنبسة بن سعيد قاضي الري وأبو صخر حميد بن زياد وابو مودود سمعت أبي يقول ذلك، قال أبو محمد وروى عنه سفيان بن عيينة، عبد الرحمن نا أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت أبي يقول عمار بن ابى معاوية هو عمار الدهنى وهو ثقة، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عمار الدهنى ثقة، نا عبد الرحمن قال سألت ابى عن عمار الدهنى فقال ثقة.(@)(@@)(@@)(@@) $ 2176 -(@)(@@) عمار بن عمارة أبو هاشم الزعفراني البصري روى عن الحسن PageV06P390(@)(@@) وصالح بن عبيد وكثير ابى اليمان وربيع بن لوط ومحمد بن عبد الله روى عنه يحيى بن يمان وروح بن عبادة وابو الوليد الطيالسي وسهل بن تمام سمعت أبي يقول ذلك، قال أبو محمد روى عنه مسلم بن إبراهيم، نا عبد الرحمن قال سمعت ابى(@)(@@) يقول اخطأ يحيى بن يمان فيما قال عمار بن عمر وانما هو عمار بن عمارة، نا عبد الرحمن نا العباس بن محمد الدوري قال سمعت يحيى بن معين يقول أبو هاشم الزعفراني اسمه عمار بن عمارة وهو ثقة، نا عبد الرحمن قال سألت أبي عن أبي هاشم الزعفراني فقال صالح ما ارى بحديثه بأسا.(@)(@@)(@@)(@@) $ 2177 -(@)(@@) عمار أبو الهيثم صاحب القصب يعد في الكوفيين سمع سعيد ابن المسيب وسعيد بن جبير وإبراهيم النخعي روى عنه الثوري وإسرائيل وعلي وحسن ابنا صالح سمعت أبي يقول ذلك، نا عبد الرحمن نا صالح بن أحمد بن محمد بن حنبل قال قال أبي أبو الهيثم صاحب القصب معروف روى عنه الثوري، نا عبد الرحمن نا علي بن أبي طاهر القزويني فيما كتب إلى نا أبو بكر الأثرم قال سمعت أبا عبد الله أحمد بن حنبل يسأل عن ابى الهيثم صاحب القصب فقال ثقة، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى 
ms2011	 بن معين انه قال أبو الهيثم ثقة.(@)(@@)(@@)(@@) $ 2178 -(@)(@@) عمار بن ابى فروة أبو عمر مولى عثمان بن عفان القرشي رضي الله عنه روى عن الزهري روى عنه يزيد بن أبي حبيب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2179 -(@)(@@) عمار الحضرمي سمع زاذن روى عنه اسمعيل بن أبي خالد سمعت أبي يقول ذلك(@)(@@)(@@)(@@) $ 2180 -(@)(@@) عمار بن مالك أبو محمد روى عنه المنهال بن عمرو سمعت أبي يقول ذلك وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 2181 -(@)(@@) عمار بن حفص بن عمر بن سعد القرظ وهو اخو عمر وهو والد محمد بن عمار المؤذن مدينى مولى بني مخزوم روى عن ابيه عن آبائه(@)(@@) PageV06P391(@)(@@) روى عنه عبد الرحمن بن سعد سمعت أبي يقول ذلك، نا عبد الرحمن أنا يعقوب ابن إسحاق فيما كتب إلى نا عثمان بن سعيد الدارمي قال قلت ليحيى بن معين عمار بن حفص بن عمر بن سعد عن آبائه عن اجداده كيف حاله؟ قال ليس بشئ.(@)(@@)(@@)(@@) $ 2182 -(@)(@@) عمار بن رزيق الضبى الكوفى التميمي روى عن أبي إسحاق الهمداني ومغيرة بن مقسم روى عنه أبو الأحوص ويحيى بن آدم وأبو الجواب الاحوص بن جواب وقبيصة بن عقبة سمعت أبي يقول ذلك، وسألته عنه فقال لا بأس به، حدثنا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلي قال نا عثمان بن سعيد قال سألت يحيى بن معين عن عمار بن رزيق فقال ثقة، نا عبد الرحمن قال سئل أبو زرعة عنه فقال ثقة.(@)(@@)(@@)(@@) $ 2183 -(@)(@@) عمار بن زربى أبو المعتمر الضرير روى عن معتمر بن سليمان كتب عنه ابى، انا عبد الرحمن قال سألت أبي عنه فقال هو كذاب متروك الحديث وضرب على حديثه ولم يقرأه علينا.(@)(@@)(@@)(@@) $ 2184 -(@)(@@) عمار بن عبد الله بن يسار كوفى جهنى روى عن ابيه والشعبى وابن أبي ليلى روى عنه ابن عيينة ومروان بن معاوية سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2185 -(@)(@@) عمار بن عمران الزيدى من زيد الله روى عن سعيد بن جبير روى عنه العلاء بن عبد الكريم.(@)(@@)(@@)(@@) $ 2186 -(@)(@@) عمار بن 
ms2012	 علثم روى عن ام سعيد بنت الاسود روى عنه ازهر بن سعد السمان سمعت أبي يقول ذلك وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 2187 -(@)(@@) عمار بن حكيم أو حكيم بن عمار من بنى عبد الدولي (1) روى عن ابن خالته قال حدثنى أبو هريرة روى النضر بن محمد عن عكرمة بن عمار عنه سمعت أبي يقول ذلك ويقول هو مجهول.(@)(@@)(@@)(@@) $ 2188 -(@)(@@) عمار بن يزيد روى عن يزيد بن عبد الله بن قسيط روى سعيد PageV06P392(@)(@@) ابن ابى ايوب عن خالد بن يزيد عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2189 -(@)(@@) (عمار بن عمرو البجلى روى عن محمد بن النضر الحارثى روى عنه اسمعيل بن قتيبة مولى البراء بن عازب شيخا لابي سعيد الاشج هو يروى عنه - 1) .(@)(@@)(@@)(@@) $ 2190 -(@)(@@) عمار بن محمد ابن اخت سفيان الثوري أبو اليقظان روى عن منصور والاعمش وليث بن أبي سليم روى عنه محمد بن حاتم الزمي المؤدب والحسن بن عرفة سمعت أبي يقول ذلك، نا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول عمار بن محمد ابن أخت سفيان الثوري لم يكن به بأس (سألت أبي عنه فقال ليس به بأس يكتب حديثه - 2) .(@)(@@) نا عبد الرحمن قال سألت أبا زرعة عن عمار بن محمد ابن أخت سفيان فقال ليس بقوى وهو احسن حالا من عمار بن سيف.(@)(@@)(@@)(@@) $ 2191 -(@)(@@) عمار بن سيف الضبى روى عن عاصم الاحول وابن ابى ليلى وابى معان روى عنه إسحاق بن منصور السلولى وابو نعيم وابو غسان وثابت ابن محمد وعبد الحميد بن صالح سمعت أبي يقول ذلك، حدثنا عبد الرحمن أنا أبو بكر ابن أبي خيثمه فيما كتب إلي، قال نا محمد بن عبد العزيز بن أبي رزمة قال أخبرني أبي عن عبد الله بن المبارك عن عمار بن سيف وأثنى عليه خيرا،.(@)(@@) نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول عمار بن سيف ليس حديثه بشئ، ثنا عبد الرحمن 
ms2013	 قال سألت ابى عن عمار بن سيف فقال كان شيخا صالحا وكان ضعيف الحديث منكر الحديث،(@)(@@) نا عبد الرحمن قال سمعت أبا زرعة يقول عمار بن سيف ضعيف.(@)(@@)(@@)(@@) $ 2192 -(@)(@@) عمار بن عبد الملك روى عن محمد بن عبد العزيز القرشى قاضى المدينة روى عنه محمد بن مقاتل المروزى أبو الحسن.(@)(@@)(@@)(@@) $ 2193 -(@)(@@) عمار بن عبد الجبار المروروذى أبو الحسن مات بمكة سنة PageV06P393(@)(@@) مائتين واحدى عشرة روى عن شعبة وابن أبي ذئب والمسعودي سمعت أبي يقول ذلك، نا عبد الرحمن قال سألت ابى عن عمار بن عبد الجبار فقال صدوق، نا عبد الرحمن قال سئل أبو زرعة عن عمار بن عبد الجبار فقال لا بأس به.(@)(@@)(@@)(@@) $ 2194 -(@)(@@) عمار بن نوح المصرى روى عن عمران القطان والحسن بن أبي جعفر روى عنه سعيد بن أسد بن موسى، نا عبد الرحمن قال سمعت أبا زرعة يقول ذلك وسألته عنه فقال بصرى كان ينزل مصر ليس بقوى يحدث عن عمران القطان احاديث منكرة.(@)(@@)(@@)(@@) $ 2195 -(@)(@@) عمار بن موسى أبو عصمة مروزى روى عن ابن المبارك وخالد ابن صبيح روى عنه ابى بالرى سمعت أبي يقول (1) كتبت عنه وكان شيخا صدوقا.(@)(@@)(@@)(@@) $ 2196 -(@)(@@) عمار بن هارون أبو ياسر المستملى بصري روى عن حماد بن سلمة وحماد بن زيد وعلى بن عابس واسحاق بن الربيع وهشام بن زياد وابى هلال الراسبى سمع منه أبي وسألته عنه فقال متروك الحديث وترك الرواية عنه.(@)(@@)(@@)(@@) $ 2197 -(@)(@@) عمار بن نصر المروزى أبو ياسر روى عن جرير بن عبد الحميد ومحمد بن شعيب بن شابور ووكيع بن الجراح وعبد الله بن عيسى سمع منه أبي ببغداد في الرحلة الأولى وسألته عنه فقال هو صدوق.(@)(@@)(@@)(@@) $ 2198 -(@)(@@) عمار بن مطر الرهاوى كان يسكن الرها روى عن (ابن أبي ذئب روى عنه أبو ميسرة احمد بن عبد الله الحرانى - 2) سمع منه أبي وسألته عنه فقال كتبت عنه وكان يكذب.(@)(@@)(@@)(@@) $ 2199 -(@)(@@) عمار بن عمر بن المختار أبو ياسر روى عن سهل بن أسلم روى عنه أبو زرعة قديما. 
ms2014	(@)(@@)(@@)(@@) $ 2200 -(@)(@@) عمار بن الحلبي روى عن جعفر بن سليمان روى عنه حجاج ابن الشاعر، حدثنا عبد الرحمن نا علي بن الحسن (3) نا الحجاج بن الشاعر نا عمار PageV06P394(@)(@@) ابن الحلبي وكان من الثقات.(@)(@@)(@@)(@@) $ 2201 -(@)(@@) عمار بن خالد الواسطي التمار أبو الفضل روى عن جرير بن عبد الحميد وابن عيينة وابن ابى عدى ويحيى بن سعيد القطان وعبد الوهاب الثقفى ومرحوم بن عبد العزيز وابى بكر بن عياش والحكم بن سنان صاحب القرب والقاسم بن مالك كتبت عنه مع ابى بواسط وكان ثقة صدوقا، نا عبد الرحمن قال سئل أبي عنه فقال صدوق.(@)(@@)(@@)(@@) $ 2202 -(@)(@@) عمار بن رجاء الاستاراباذى روى عن أحمد بن أبي طيبة ومعاوية بن هشام ووهب بن جرير وابى داود الطيالسي كتب الينا والى ابى وابى زرعة وكان صدوقا.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عروة(@)(@@)(@@)(@@) $ 2203 -(@)(@@) عروة بن ابى الجعد البارقى وبارق جبل نزله بعض الازديين ونزل عروة الكوفة له صحبة روى عنه العيزار بن حريث وابو لبيد وشبيب بن غرقدة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2204 -(@)(@@) عروة بن مضرس بن اوس بن حارثة بن لام الطائى انه حج مع النبي صلى الله عليه وسلم روى عنه الشعبي سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2205 -(@)(@@) عروة الفقيمى التميمي له صحبة روى عنه ابنه غاضرة بن عروة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2206 -(@)(@@) عروة بن مغيث الانصاري شامي روى عن النبي صلى الله عليه وسلم ان صاحب الدابة احق بصدرها روى عنه الوليد بن عامر اليزنى اخرج اسمه أبو زرعة في مسند الشاميين.(@)(@@)(@@)(@@) $ 2207 -(@)(@@) عروة بن الزبير بن العوام أبو عبد الله القرشى رأى اباه ورأى حكيم بن حزام وسمع من ابى حميد الساعدي وابن عباس وابى هريرة والمغيرة بن شعبة وعائشة روى عنه الزهري ويزيد بن رومان وهشام وعثمان ويحيى ومحمد وعبد الله بنو عروة بن الزبير وابن عبد الله بن عروة سمعت ابى(@)(@@) PageV06P395(@)(@@) يقول ذلك، نا عبد الرحمن نا علي بن الحسن الهسنجاني نا سعيد بن عفير حدثني يعقوب بن عبد 
ms2015	 الرحمن عن أبيه عن ابن شهاب قال كان عروة بن الزبير بحرا لا يكدره الدلاء، حدثنا عبد الرحمن نا أبي نا هارون بن سعيد الأيلي قال أخبرني خالد بن نزار عن سفيان يعني ابن عيينة قال كان أعلم الناس بحديث عائشة ثلاثة القاسم بن محمد وعروة بن الزبير وعمرة بنت عبد الرحمن، نا عبد الرحمن نا أبو سعيد الأشج نا حفص نا الاعمش نا أبو الزناد قال كان فقهاء اهل المدينة اربعة سعيد بن المسيب وعروة بن الزبير وقبيصة بن ذؤيب وعبد الملك بن مروان.(@)(@@)(@@)(@@) $ 2208 -(@)(@@) عروة بن عياض سمع عبد الله بن عمرو وجابر بن عبد الله روى عنه ابن جريج وسعيد بن حسان سمعت أبي يقول ذلك، نا عبد الرحمن قال سئل أبو زرعة عن عروة بن عياض فقال مكى ثقة، قال أبو محمد كان واليا لعمر بن عبد العزيز على مكة.(@)(@@)(@@)(@@) $ 2209 -(@)(@@) عروة بن رزين بن عبد الرحمن بن عدى روى عن عمر بن عبد العزيز روى عنه يزيد بن عبد الله ابن الهاد.(@)(@@)(@@)(@@) $ 2210 -(@)(@@) عروة بن عامر سمع ابن عباس وعبيد بن رفاعة روى عنه عمرو ابن دينار والقاسم بن ابى بزة وحبيب بن أبي ثابت سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2211 -(@)(@@) عروة بن رويم اللخمى روى عن ابى ثعلبة الخشنى مرسل وروى عن أنس وعبد الله بن الديلمى روى عنه الاوزاعي ويزيد بن سنان الرهاوي سمعت أبي يقول ذلك، نا عبد الرحمن قال سمعت أبي يقول سمعت ابراهيم ابن موسى يقول ليت شعرى ان اعلم عروة بن رويم ممن سمع فأن عامة حديثه مراسيل، نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلى قال أنا عثمان بن سعيد قال قلت ليحيى بن معين عروة بن رويم؟ فقال ثقة، نا عبد الرحمن قال سئل ابى عن عروة بن رويم فقال تابعي عامة حديثه مراسيل لقى انسا وابا كبشة.(@)(@@)(@@)(@@) $ 2212 -(@)(@@) عروة بن اذينة الليثى مديني روى عن عبد الله بن عمر روى عنه مالك بن أنس وعبيد 
ms2016	 الله بن عمر سمعت ابى يقول ذلك.(@)(@@) PageV06P396(@)(@@)(@@)(@@) $ 2213 -(@)(@@) عروة الحمصى روى عن أنس بن مالك روى عنه الوليد بن مسلم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2214 -(@)(@@) عروة بن أبي قيس مولى عمرو بن العاص مصري روى عن عبد الله بن عمرو روى عنه يزيد بن أبي حبيب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2215 -(@)(@@) عروة بن عبيد الله بن كعب بن مالك السلمي الأنصاري سمعت أبي يقول ذلك ويقول لا يعرف.(@)(@@)(@@)(@@) $ 2216 -(@)(@@) عروة بن محمد بن عمار بن ياسر روى عن أبيه روى عنه امية ابن هند سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2217 -(@)(@@) عروة بن محمد بن عطية بن عروة من بني سعد بن بكر روى عن أبيه عن جده روى عنه سماك بن الفضل ورجاء بن ابى سلمة وامية بن شبل وابو وائل القاص والزبير أبو النعمان ومحمد بن خراشة سمعت أبي يقول ذلك، ويقول قال علي بن المديني كان واليا على اليمن عشرين سنة وخرج حين خرج ومعه سيف ومصحف، قال أبو محمد روى عنه عبد الرحمن بن يزيد بن جابر وعمرو ابن عون الصنعاني وعبد الله بن نعيم والد عاصم بن عبد الله.(@)(@@)(@@)(@@) $ 2218 -(@)(@@) عروة بن قبيصة روى عن عدى بن ارطاة وعن رجل عن ابيه عن عثمان روى عنه الجريرى واياس بن دغفل سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2219 -(@)(@@) عروة بن زهير العجلى روى عن ثابت البناني روى عنه عبد الحميد بن جعفر سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2220 -(@)(@@) عروة بن فائد كوفى سمع ابن ابى ليلى وابا عبد الله الجدلي وسعيد بن جبير روى عنه إبراهيم بن ميمون سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 2221 -(@)(@@) عروة بن عبد الله بن قشير أبو مهل الجعفي كوفي روى عن ابن أبي مليكية وأبي جعفر محمد بن علي ومحمد بن سيرين ومعاوية بن قرة روى عنه الثوري وزهير بن معاوية وعنبسة بن سعيد قاضي الري سمعت أبي يقول ذلك.(@)(@@) حدثنا عبد الرحمن قال سئل أبو زرعة عن ابى مهل الجعفي فقال ثقة.(@)(@@) PageV06P397(@)(@@)(@@)(@@) $ 2222 -(@)(@@) عروة بن عبد 
ms2017	 الله بن محمد بن يحيى بن عروة بن الزبير بن العوام روى عن عبد الرحمن بن أبي الزناد روى عنه محمد بن مرزوق ابن ابنة مهدي بن ميمون.(@)(@@)(@@)(@@) $ 2223 -(@)(@@) عروة بن النزال روى عن معاذ بن جبل روى عنه الحكم ابن عتيبة.(@)(@@)(@@)(@@) $ 2224 -(@)(@@) عروة بن الحارث أبو فروة الهمداني كوفى روى عن مسلم ابن صبيح والشعبى وعبد الرحمن بن أبي ليلى روى عنه الثوري وشعبة وابن عيينة سمعت أبي يقول ذلك، قال أبو محمد وروى عن ابى عمرو الشيباني سعد (1) بن اياس وكان جاهليا، نا عبد الرحمن أخبرنا يعقوب بن إسحاق فيما كتب إلى قال حدثنا عثمان بن سعيد قال سألت يحيى بن معين عن ابى فروة فقال ثقة.(@)(@@)(@@)(@@) $ 2225 -(@)(@@) عروة أبو عبد الله البزاز روى عن الشعبي روى عنه يزيد بن هارون، نا عبد الرحمن سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال عروة أبو عبد الله الهمداني ثقة.(@)(@@)(@@)(@@) $ 2226 -(@)(@@) عروة العرقي روى عن عبد الله بن المبارك روى عنه يونس ابن عبد الاعلى سألت أبي عنه فقال لا اعرفه (مجهول - 2) .(@)(@@)(@@)(@@) $ 2227 -(@)(@@) عروة بن ابى العطوف (روى عن ... - 2) روى عنه محمد بن مرزوق سمعت أبي يقول ذلك وسألته عنه فقال لا اعرفه.(@)(@@)(@@)(@@) $ 2228 -(@)(@@) عروة بن مروان الرقى الجرار روى عن عبيد الله بن عمرو وعمر بن المغيرة وزهير بن معاوية ومحمد بن عبد الله بن عبيد بن عمير واسمعيل بن عياش روى عنه أيوب بن محمد الوزان الرقى.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عنبسة(@)(@@)(@@)(@@) $ 2229 -(@)(@@) عنبسة بن سعيد بن العاص القرشي الاموى كان بالشام يكنى بابى خالد سمع ابا هريرة سمع منه الزهري واسماء بن عبيد وضمرة بن حبيب سمعت أبي يقول ذلك وسألته عنه فقال لا بأس به. PageV06P398(@)(@@)(@@)(@@) $ 2230 -(@)(@@) عنبسة بن سعيد بن الضريس الاسدي أبو بكر قاضي الري (على أهل الذمة - 1) كوفي سكن الري روى عن ابى اسحاق الهمداني والاعمش والزبير ابن عدى 
ms2018	 وعاصم بن عبيد الله روى عنه ابن المبارك وجرير وحكام واسحاق بن سليمان وهارون بن المغيرة سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال نا أبى قال كان أحمد بن حنبل يقدمه على ابى جعفر الرازي، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت أبي يقول عنبسة بن سعيد اصح حديثا من أبي جعفر الرازي حدث عنه ابن المبارك، نا عبد الرحمن أنا علي بن أبي طاهر فيما كتب إلى نا أبو بكر الأثرم قال سمعت أبا عبد الله أحمد بن حنبل يقول عنبسة قاضى الرى ثقة.(@)(@@) نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلي قال نا عثمان بن سعيد قال قلت ليحيى بن معين عنبسة بن سعيد؟ قال ثقة، نا عبد الرحمن قال سألت ابى عن عنبسة قاضى الرى قال ثقة لا بأس به، نا عبد الرحمن قال سألت ابا زرعة عن عنبسة قاضى الرى فقال ثقة كان كوفى الاصل.(@)(@@)(@@)(@@) $ 2231 -(@)(@@) عنبسة بن سعيد الواسطي اخو أبي الربيع السمان روى عن الحسن روى عنه البصريون سمعت أبي يقول ذلك، نا عبد الرحمن نا محمد بن إبراهيم نا عمرو بن علي الصيرفي بأن عنبسة القطان اخا ابى الربيع كان مختلطا لا يروى عنه قد سمعت منه وجلست إليه، نا عبد الرحمن قال سألت ابى عن عنبسة اخى ابى الربيع فقال ضعيف الحديث يأتي بالطامات.(@)(@@)(@@)(@@) $ 2232 -(@)(@@) عنبسة بن سعيد البصري روى عن حنظلة عن انس روى عنه عقبة بن خالد السكوني ومحمد بن عيسى ابن الطباع سمعت أبي يقول ذلك وسألته عنه فقال هو ضعيف الحديث، نا عبد الرحمن قال سئل أبو زرعة عن عنبسة بن(@)(@@) سعيد البصري هذا فقال ضعيف الحديث.(@)(@@)(@@)(@@) $ 2233 -(@)(@@) عنبسة بن سعيد البصري روى عن الزهري روى عنه أبو عاصم النبيل سمعت أبي يقول ذلك، ويقول هو ضعيف الحديث. PageV06P399(@)(@@)(@@)(@@) $ 2234 -(@)(@@) عنبسة بن سعيد بن ابان القرشى الاموى الكوفى أبو خالد اخو يحيى بن سعيد الاموى واخو 
ms2019	 محمد بن سعيد وعبيد بن سعيد روى عن شريك وابن المبارك وكان صاحب حديث الكوفة هو ونوفل ويحيى بن آدم سمعت أبي يقول ذلك، ويقول كان من حفاظ اهل الكوفة وكان من اصدق اخوته واحفظهم روى عنه احمد الدورقى.(@)(@@)(@@)(@@) $ 2235 -(@)(@@) عنبسة بن سعيد بن غنيم الكلاعي روى عن مكحول روى عنه اسمعيل بن عياش والوليد بن مسلم وعمرو بن بشر بن السرح سمعت أبي يقول ذلك، وسألته عنه فقال ليس بالقوى، نا عبد الرحمن قال سئل أبو زرعة عن عنبسة بن سعيد بن غنيم فقال احاديثه منكرة ولم يسمع من عكرمة شيئا.(@)(@@)(@@)(@@) $ 2236 -(@)(@@) عنبسة بن سعيد بن كثير بن عبيد وجده كثير بن عبيد رضيع عائشة مولى أبي بكر الصديق رضي الله عنه وهو ابن ابى العنبس روى عن جده عن أبي هريرة روى عنه عبد الرحمن بن مهدى والانصاري وأبو الوليد الطيالسي سمعت أبي يقول ذلك، نا عبد الرحمن نا أبي نا أبو الوليد نا عنبسة بن سعيد القرشى وكان ثقة.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عنبسة بن سعيد بن كثير بن عبيد ثقة، نا عبد الرحمن قال سئل أبي عن عنبسة بن سعيد الذى روى عنه أبو الوليد فقال ثقة.(@)(@@)(@@)(@@) $ 2237 -(@)(@@) عنبسة بن ابى رائطة الغنوى الاعور روى عن الحسن روى عنه وهيب وعبد الوهاب الثقفي سمعت أبي يقول ذلك، نا عبد الرحمن نا محمد بن أحمد بن البراء قال قال علي بن المدينى عنبسة الغنوى ضعيف، نا عبد الرحمن قال سألت ابى عن عنبسة الاعور فقال هو عنبسة بن ابى رائطة الاعور وهو عنبسة الغنوى شيخ روى عنه عبد الوهاب الثقفى احاديث حسانا وروى عنه وهيب وليس بحديثه بأس.(@)(@@)(@@)(@@) $ 2238 -(@)(@@) عنبسة بن ابى سفيان اخو ام حبيبة أبو عامر روى عن(@)(@@) PageV06P400(@)(@@) ام حبيبة روى عنه مكحول وعمرو بن اوس الثقفي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 2239 -(@)(@@) عنبسة بن ابى عمرو (ويقال عنبسة عن ابن ابى عمرو - 1) ويقال 
ms2020	 عنبسة عن ابن عمرو روى عن النبي صلى الله عليه وسلم مرسل روى عنه ايمن بن نابل سمعت أبي يقول ذلك، وسألته عنه فقال هو شيخ مجهول، قلت ايهما اصح قال الله اعلم.(@)(@@)(@@)(@@) $ 2240 -(@)(@@) عنبسة أبو نافع الليثى رأى أنس بن مالك يصلى الجمعة روى عنه عبد الصمد بن عبد الوارث وأبو الوليد سمعت أبي يقول ذلك، قال أبو محمد روى عنه مسلم بن ابراهيم.(@)(@@)(@@)(@@) $ 2241 -(@)(@@) عنبسة بن الازهر الشيباني أبو يحيى قاضى جوزجان (2) كوفى روى عن سلمة بن كهيل وسماك بن حرب روى عنه يونس بن بكير وابراهيم ابن المختار واحمد بن ابى طيبة سمعت أبي يقول ذلك، وسألته عنه فقال لا بأس به يكتب حديثه ولا يحتج به.(@)(@@)(@@)(@@) $ 2242 -(@)(@@) عنبسة بن عبد الواحد وهو ابن أمية بن عبد الله بن سعيد بن العاص الأموي القرشي أبو خالد الاعور كوفى سمع بيانا وعبد الملك بن عمير(@)(@@) وعوفا وسعيدا الجريري سمعت أبي يقول ذلك، قال أبو محمد وروى عن منصور ابن عبد الرحمن روى عنه منصور بن أبي مزاحم، نا عبد الرحمن قال سمعت ابى يقول روى عنه محمد بن بكار بن الريان وابراهيم بن موسى الرازي وابراهيم بن مهدي.(@)(@@) نا عبد الرحمن أنا علي بن أبي طاهر فيما كتب إلي قال أنا أبو بكر الأثرم قال قلت لأبي عبد الله أحمد بن حنبل عنبسة بن عبد الواحد القرشي كيف هو؟ قال ما أرى به بأسا، نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول عنبسة بن عبد الواحد القرشي ثقة.(@)(@@) نا عبد الرحمن قال سألت ابى عن عنبسة بن عبد الواحد فقال ثقة ليس به بأس (نا عبد الرحمن قال سئل أبو زرعة عن عنبسة بن عبد الواحد فقال PageV06P401(@)(@@) لا بأس به - 1) .(@)(@@)(@@)(@@) $ 2243 -(@)(@@) عنبسة بن عمار الدوسى ويقال القرشى سمع ابن عمر وعكرمة وحميد بن عبد الرحمن وابا سلمة روى عنه عيسى بن يونس ومروان بن معاوية وابو معاوية وسعيد 