ms34	 سنة أربع عشرة، وقيل خمس عشرة ومائة.(@)(@@)(@)(@@)(@@)(@@) $ 1100 - حبيب بن أبي ثابت، أبو يحيي الأسدي الكوفي، تابعي، وكان أعور، مات سنة تسع عشرة ومائة.(@)(@@)(@)(@@)(@@)(@@) $ 1101 - حميد بن مسلم الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1102 - الحارث بن كعب الأزدي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1103 - حطان بن خفاف، أبو جويرية الجرمي.(@)(@@)(@)(@@)(@@)(@@) $ 1104 - حصين بن عمرو الهمداني المشعاري.(@)(@@)(@)(@@)(@@)(@@) $ 1105 - حكيم بن جبير بن مطعم بن عدي بن عبد مناف القرشي المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1106 - حفص بن عمر الأنصاري، كوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1107 - حبيب بن حسان بن أبي الأشرس الأسدي، مولاهم، روى عنه وعن أبي جعفر وأبي عبد الله عليهم السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1108 - حميد بن نافع الهمداني.(@)(@@)(@)(@@)(@@)(@@) $ 1109 - الحارث بن الفضيل المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1110 - حكيم بن حكيم بن عباد بن حنيف الأنصاري، 2 روى عنه وعن أبي جعفر وأبي عبد الله عليهم السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1111 - حذيم بن سفيان الأسدي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1112 - الحسن بن عمارة الكوفي.(@)PageV00P112(@)(@@)(@)(@@)(@@)(@@) $ 1113 - حكيم بن صهيب الصيرفي الكوفي، أبو سدير.(@)(@@)(@)(@@)(@@)(@@) $ 1114 - الحارث بن الجارود التيمي.(@)(@@)(@)(@@)(@@)(@@) $ 1115 - حسان العامري.(@)(@@)(@)(@@)(@@)(@@) $ 1116 - حذيم بن شريك الأسدي.(@)(@@)(@)(@@)(@@)(@@) $ 1117 - حبيب السجستاني.(@)(@@)(@@)(@@) || باب الخاء(@)(@@)(@@)(@@) $ 1118 - خشرم بن يسار المدني.(@)(@@)(@@)(@@) || باب الدال(@)(@@)(@@)(@@) $ 1119 - داود الصرمي.(@)(@@)(@@)(@@) || باب الراء(@)(@@)(@@)(@@) $ 1120 - رزين. 1(@)(@@)(@@)(@@) $ 1121 - رزين بن عبيد السلولي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1122 - رشيد الهجري.(@)(@@)(@)(@@)(@@)(@@) $ 1123 - ربيعة بن أبي عبد الرحمان، واسم أبي عبد الرحمان فروخ.(@)(@@)(@)(@@)(@@)(@@) $ 1124 - رياح بن عبيدة الهمداني. 2(@)(@@)(@@)(@@) $ 1125 - ربيعة بن عثمان التيمي القرشي المدني.(@)(@@)(@@)(@@) || باب الزاي(@)(@@)(@@)(@@) $ 1126 - زيد بن علي بن الحسين بن علي بن أبي طالب عليه السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1127 - زيد بن الحسن بن علي بن أبي طالب عليه السلام، أبو الحسن الهاشمي.(@)PageV00P113(@)(@@)(@)(@@)(@@)(@@) $ 1128 - زياد بن سوقه الجريري، مولاهم كوفي، وأخواه محمد وحفص.(@)(@@)(@)(@@)(@@)(@@) $ 1129 - زيد العمي البصري.(@)(@@)(@)(@@)(@@)(@@) $ 1130 - زيد بن أسلم العدوي، مولاهم المدني، مولى عمر بن الخطاب، تابعي، كان يجالسه كثيرا.(@)(@@)(@@)(@@) || باب السين(@)(@@)(@@)(@@) $ 1131 - سعيد بن المسيب بن حزن، أبو محمد المخزومي، سمع منه وروى عنه عليه السلام، وهو من الصدر الأول.(@)(@@)(@)(@@)(@@)(@@) $ 1132 - سعيد بن جبير، أبو محمد، مولى بني والبة، أصله الكوفة، نزل مكة، تابعي.(@)(@@)(@)(@@)(@@)(@@) $ 1133 - سعيد بن عثمان.(@)(@@)(@)(@@)(@@)(@@) $ 1134 - سدير 
ms35	 بن حكيم بن صهيب الصيرفي، يكنى أبا الفضل، من الكوفة، مولى.(@)(@@)(@)(@@)(@@)(@@) $ 1135 - السري بن عبد الله بن الحارث بن العباس بن عبد المطلب.(@)(@@)(@)(@@)(@@)(@@) $ 1136 - سليم بن قيس الهلالي، ثم العامري الكوفي، صاحب أمير المؤمنين عليه السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1137 - سالم بن أبي الجعد الأشجعي، مولاهم الكوفي، يكنى أبا أسماء.(@)(@@)(@)(@@)(@@)(@@) $ 1138 - سالم، مولى عمر بن عبد الله. 1(@)(@@)(@@)(@@) $ 1139 - سلمة بن كهيل، أبو يحيي الحضرمي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1140 - سعد بن سعيد بن قيس بن عمرو بن سهل الأنصاري.(@)(@@)(@)(@@)(@@)(@@) $ 1141 - سلمة بن دينار، يكنى أبا حازم الأعرج، ويعرف بالأقرن القاص. 2(@)(@@)(@@)(@@) $ 1142 - سلمة بن نبيط بن شريط بن انس، 3 أبو فراس الأشجعي، من همدان،(@)PageV00P114(@)(@@) كوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1143 - سماك بن حرب الذهلي، أبو المغيرة.(@)(@@)(@)(@@)(@@)(@@) $ 1144 - سليمان بن أبي المغيرة العبسي.(@)(@@)(@)(@@)(@@)(@@) $ 1145 - سالم بن أبي حفصة، مولى بني عجل، من الكوفة، كنيته أبو يونس، و اسم أبيه عبيد، وقيل كنيته أبو الحسن، مات سنة سبع وثلاثون ومائة.(@)(@@)(@)(@@)(@@)(@@) $ 1146 - سعيد بن المرزبان، أبو سعيد الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1147 - سعد بن طريف الحنظلي الإسكاف، مولى بني تميم الكوفي، ويقال: سعد الخفاف، روى عن الأصبغ بن نباتة، وهو صحيح الحديث.(@)(@@)(@)(@@)(@@)(@@) $ 1148 - سعد بن أبي سعيد المقبري، 1 سمي به لأنه سكن المقابر، ذكره ابن قتيبة.(@)(@@)(@)(@@)(@@)(@@) $ 1149 - سعيد بن الحارث المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1150 - سعيد بن مرجانة المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1151 - سليمان، أبو عبد الله بن سليمان العبسي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1152 - سلام بن المستنير الجعفي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1153 - سعيد، أبو خالد الصيقل.(@)(@@)(@)(@@)(@@)(@@) $ 1154 - سعيد بن حكيم. 2(@)(@@)(@@)(@@) || باب الشين(@)(@@)(@@)(@@) $ 1155 - شيبة بن نعامة الضبي البصري.(@)(@@)(@)(@@)(@@)(@@) $ 1156 - شرحبيل بن سعد، مولى أنصاري، مولى بني حنظلة منهم، مدني.(@)PageV00P115(@)(@@)(@@)(@@) || باب الصاد(@)(@@)(@@)(@@) $ 1157 - صالح بن كيسان المدني.(@)(@@)(@@)(@@) $ 1158 - صالح بن أبي حسان المدني.(@)(@@)(@@)(@@) $ 1159 - صالح بن خوات بن جبير الأنصاري المدني، ابنه صالح بن صالح بن خوات بن جبير الأنصاري.(@)(@@)(@@)(@@) $ 1160 - صفوان بن سليم الزهري المدني.(@)(@@)(@@)(@@) $ 1161 - صهيب، أبو حكيم الصيرفي الكوفي، تابعي.(@)(@@)(@@)(@@) || باب الضاد(@)(@@)(@@)(@@) $ 1162 - الضحاك بن مزاحم الخراساني، أصله الكوفة، تابعي.(@)(@@)(@@)(@@) $ 1163 - الضحاك بن عبد الله المشرقي.(@)(@@)(@@)(@@) || باب الطاء(@)(@@)(@@)(@@) $ 1164 - طلحة 
ms36	 بن النضر المدني.(@)(@@)(@@)(@@) $ 1165 - طارق بن عبد الرحمان الأحمسي البجلي، كوفي.(@)(@@)(@@)(@@) $ 1166 - طاووس بن كيسان، أبو عبد الرحمان اليماني.(@)(@@)(@@)(@@) $ 1167 - طلحة بن عمرو المدني.(@)(@@)(@@)(@@) || باب الظاء(@)(@@)(@@)(@@) $ 1168 - ظالم بن عمرو، يكنى أبا الأسود الدؤلي.(@)(@@)(@@)(@@) || باب العين(@)(@@)(@@)(@@) $ 1169 - عبد الله بن علي بن الحسين بن علي بن أبي طالب عليهم السلام. PageV00P116(@)(@@)(@)(@@)(@@)(@@) $ 1170 - عبد الله بن عقيل بن أبي طالب الهاشمي المدني، تابعي سمع جابرا.(@)(@@)(@)(@@)(@@)(@@) $ 1171 - عبد الله بن سليمان العبسي الكوفي، يعرف بالصيرفي.(@)(@@)(@)(@@)(@@)(@@) $ 1172 - عبد الله بن دينار، مولى عمر بن الخطاب، العمري، مولاهم المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1173 - عبد الله بن المستورد المدني الهاشمي، مولى لعلي بن الحسين عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1174 - عبد الله بن أبي مليكه المخزومي المكي.(@)(@@)(@)(@@)(@@)(@@) $ 1175 - عبد الله بن عطاء الهاشمي، مولاهم المكي، مولى بني عبد المطلب بن هاشم.(@)(@@)(@)(@@)(@@)(@@) $ 1176 - عبد الله بن هرمز المكي.(@)(@@)(@)(@@)(@@)(@@) $ 1177 - عبد الله بن أبي بكر بن عمرو بن حزم الأنصاري المدني، توفي بالمدينة سنة عشرين ومائة، كنيته اسمه. 1(@)(@@)(@@)(@@) $ 1178 - عبد الله بن عبيدة الزهري.(@)(@@)(@)(@@)(@@)(@@) $ 1179 - عبد الله بن ذكوان، أبو الزناد.(@)(@@)(@)(@@)(@@)(@@) $ 1180 - عبيد الله بن زبيد الهاشمي، مولى آل علي عليه السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1181 - عبد الله بن عبد الرحمان المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1182 - عبد الله بن جعفر المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1183 - عبد الله بن سعيد بن أبي هند المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1184 - عبد الله بن شبرمة الضبي الكوفي، كنيته أبو شبرمة، وكان قاضيا لأبي جعفر على سواد الكوفة، وكان شاعرا، مات سنة أربع وأربعين ومائة.(@)(@@)(@)(@@)(@@)(@@) $ 1185 - عبد الله بن محمد بن عمر بن علي بن أبي طالب، الهاشمي المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1186 - عبيد الله بن علي بن أبي رافع أسلم، مولى رسول الله صلى الله عليه وآله.(@)PageV00P117(@)(@@)(@)(@@)(@@)(@@) $ 1187 - عبيد الله بن المغيرة العبسي الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1188 - عبيد الله بن أبي الوشيم الكوفي، ويقال: عبيد الجنابي. 1(@)(@@)(@@)(@@) $ 1189 - عبيد الله بن مسلم العمري الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1190 - عبيد الله بن عبد الرحمان بن موهب المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1191 - عبد الله بن أبي الجعد، 2 يقال: عبيد النخعي، أخو سالم، مولاهم كوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1192 - عامر بن واثلة الكناني، يكنى أبا 
ms37	 الطفيل، من أصحاب أمير المؤمنين عليه السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1193 - عامر بن السمط، يكنى أبا يحيي.(@)(@@)(@)(@@)(@@)(@@) $ 1194 - علي بن ثابت.(@)(@@)(@)(@@)(@@)(@@) $ 1195 - عيسى بن علي.(@)(@@)(@)(@@)(@@)(@@) $ 1196 - عائذ الأحمسي.(@)(@@)(@)(@@)(@@)(@@) $ 1197 - عمران بن ميثم التمار.(@)(@@)(@)(@@)(@@)(@@) $ 1198 - عبد الله بن محمد الجعفي.(@)(@@)(@)(@@)(@@)(@@) $ 1199 - عبد الملك وعبد الله، ابنا عطاء بن أبي رياح.(@)(@@)(@)(@@)(@@)(@@) $ 1200 - عقبة بن بشير.(@)(@@)(@)(@@)(@@)(@@) $ 1201 - عبد الرحمان القصير.(@)(@@)(@)(@@)(@@)(@@) $ 1202 - عبد المؤمن.(@)(@@)(@)(@@)(@@)(@@) $ 1203 - عمار الأنصاري.(@)(@@)(@)(@@)(@@)(@@) $ 1204 - عبد الله البرقي.(@)(@@)(@)(@@)(@@)(@@) $ 1205 - عبد الغفار بن القاسم، يكنى أبا مريم، وله اخوة: عبد المؤمن وعبد الواحد.(@)PageV00P118(@)(@@)(@@)(@@) || باب الفاء(@)(@@)(@@)(@@) $ 1206 - فرات بن الأحنف العبدي، يرمي بالغلو والتفريط في القول.(@)(@@)(@)(@@)(@@)(@@) $ 1207 - فليح بن أبي بكر الشيباني. 1(@)(@@)(@@)(@@) $ 1208 - الفرزدق الشاعر، ويكنى أبا فراس.(@)(@@)(@@)(@@) || باب القاف(@)(@@)(@@)(@@) $ 1209 - القاسم بن عوف الشيباني، وكان يختلف بين علي بن الحسين عليهما السلام ومحمد بن الحنفية.(@)(@@)(@)(@@)(@@)(@@) $ 1210 - القاسم بن محمد بن أبي بكر.(@)(@@)(@)(@@)(@@)(@@) $ 1211 - القاسم بن عبد الرحمان، يكنى أبا القاسم.(@)(@@)(@@)(@@) || باب الكاف(@)(@@)(@@)(@@) $ 1212 - كيسان بن كليب، يكنى أبا صادق.(@)(@@)(@)(@@)(@@)(@@) $ 1213 - كنكر، يكنى أبا خالد الكابلي، وقيل: إن اسمه وردان.(@)(@@)(@@)(@@) || باب الميم(@)(@@)(@@)(@@) $ 1214 - محمد بن جبير بن مطعم.(@)(@@)(@)(@@)(@@)(@@) $ 1215 - محمد بن علي بن الحسين عليهم السلام، ولده.(@)(@@)(@)(@@)(@@)(@@) $ 1216 - المنهال بن عمرو الأسدي.(@)(@@)(@)(@@)(@@)(@@) $ 1217 - مسلم بن علي البطين.(@)(@@)(@)(@@)(@@)(@@) $ 1218 - محمد بن شهاب الزهري، عدو. 2(@)PageV00P119(@)(@@)(@@)(@@) $ 1219 - محمد بن عمر بن علي بن أبي طالب، وقيل: ليس له عنه رواية.(@)(@@)(@@)(@@) $ 1220 - مالك بن عطية.(@)(@@)(@@)(@@) $ 1221 - محمد بن قيس الأنصاري.(@)(@@)(@@)(@@) $ 1222 - منذر الثوري.(@)(@@)(@@)(@@) $ 1223 - ميمون القداح.(@)(@@)(@@)(@@) $ 1224 - ميمون البان.(@)(@@)(@@)(@@) $ 1225 - معروف بن خربوذ المكي.(@)(@@)(@@)(@@) || باب الياء(@)(@@)(@@)(@@) $ 1226 - يحيي بن أم الطويل المطعمي.(@)(@@)(@@)(@@) || باب الكنى(@)(@@)(@@)(@@) $ 1227 - أبو مريم.(@)(@@)(@@)(@@) || باب النساء(@)(@@)(@@)(@@) $$ 1228 - أم البراء، وقيل: هي حبابة الوالبية. PageV00P120(@)(@@)(@@)(@@) | أصحاب أبي جعفر محمد بن علي بن الحسين عليهم السلام PageV00P121(@)(@@)(@@)(@@) || باب الهمزة(@)(@@)(@@)(@@) $ 1229 - إبراهيم بن حيان الأسدي الكوفي، نزل واسط. 1(@)(@@)(@@)(@@) $ 1230 - إبراهيم بن نعيم العبدي الكناني، يكنى أبا الصباح، كان يسمي الميزان من ثقته، له أصل رواه محمد بن إسماعيل بن بزيع ومحمد بن الفضيل وأبو محمد صفوان بن يحيي بياع 
ms38	 السابري الكوفي عنه، وروى عنه غير الأصول عثمان بن عيسى وعلي بن الحسن بن رباط 2 ومحمد بن إسحاق الخزاز وظريف بن ناصح و غير هم، وممن روى عنه أبو الصباح عن أبي عبد الله عليه السلام صابر ومنصور ابن حازم وابن أبي يعفور.(@)(@@)(@)(@@)(@@)(@@) $ 1231 - إبراهيم بن مرثد الكندي الأزدي، أبو سفيان.(@)(@@)(@)(@@)(@@)(@@) $ 1232 - إبراهيم الجريري.(@)(@@)(@)(@@)(@@)(@@) $ 1233 - إبراهيم بن معرض الكوفي، روى عنه وعن أبي عبد الله عليهما السلام، روى عنه منصور بن حازم وحصين بن مخارق.(@)(@@)(@)(@@)(@@)(@@) $ 1234 - إبراهيم بن عبد الله الأحمري، روى عنه وعن أبي عبد الله عليهما السلام، روى عنه سيف بن عميرة.(@)(@@)(@)(@@)(@@)(@@) $ 1235 - إبراهيم بن عمر الصنعاني اليماني، له أصول رواها عنه حماد بن عيسى.(@)(@@)(@)(@@)(@@)(@@) $ 1236 - إبراهيم بن جميل، أخو طربال الكوفي، روى عنه علي بن شجرة وإبراهيم(@)PageV00P123(@)(@@) ابن إسحاق.(@)(@@)(@)(@@)(@@)(@@) $ 1237 - إبراهيم بن معاذ، روى عنه عليه السلام في قوله تعالي: (ان الذين ارتدوا علي ادبارهم) 1 حديث التعاقد بين القوم.(@)(@@)(@)(@@)(@@)(@@) $ 1238 - إبراهيم بن عبيد، أبو غرة الأنصاري.(@)(@@)(@)(@@)(@@)(@@) $ 1239 - إبراهيم الأزرق الكوفي، 2 بياع الطعام، روى عنه وعن أبي عبد الله عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1240 - إبراهيم بن نصر.(@)(@@)(@)(@@)(@@)(@@) $ 1241 - إبراهيم بن صالح الأنماطي.(@)(@@)(@)(@@)(@@)(@@) $ 1242 - إسماعيل بن عبد الله بن جعفر بن أبي طالب المدني، روى عنه وسمع أباه عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1243 - إسماعيل بن عبد الرحمان الجعفي الكوفي، تابعي، سمع أبا الطفيل عامر بن واثلة، روى عنه وعن أبي عبد الله عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1244 - إسماعيل بن زياد البزاز الكوفي الأسدي، تابعي، روى عنه وعن أبي عبد الله عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1245 - إسماعيل بن الفضل 3 بن يعقوب بن الفضل بن عبد الله بن الحارث بن نوفل بن الحارث بن عبد المطلب، ثقة من أهل البصرة.(@)(@@)(@)(@@)(@@)(@@) $ 1246 - إسماعيل بن جابر الخثعمي 4 الكوفي، ثقة ممدوح، له أصول رواها عنه صفوان بن يحيي.(@)(@@)(@)(@@)(@@)(@@) $ 1247 - إسماعيل بن عبد الرحمان السدي الكوفي، أبو محمد القرشي المفسر.(@)PageV00P124(@)(@@)(@)(@@)(@@)(@@) $ 1248 - إسماعيل بن سلمان الأزرق، 1 يكنى أبا خالد.(@)(@@)(@)(@@)(@@)(@@) $ 1249 - إسماعيل، أبو أحمد الكاتب الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1250 - إسماعيل بن 
ms39	 عبد الخالق الجعفي.(@)(@@)(@)(@@)(@@)(@@) $ 1251 - إسماعيل، أبو العلا، من بني قيس بن ثعلبة.(@)(@@)(@)(@@)(@@)(@@) $ 1252 - إسماعيل بن عبد العزيز.(@)(@@)(@)(@@)(@@)(@@) $ 1253 - إسماعيل بن أبي خالد.(@)(@@)(@)(@@)(@@)(@@) $ 1254 - إسحاق بن يزيد بن إسماعيل الطائي، أبو يعقوب الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1255 - إسحاق بن نوح الشامي.(@)(@@)(@)(@@)(@@)(@@) $ 1256 - إسحاق بن الفضل بن يعقوب بن الفضل بن عبد الله بن الحارث بن نوفل بن الحارث بن عبد المطلب، روى عن أبي جعفر وأبي عبد الله عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1257 - إسحاق بن يسار، مولى قيس بن مخرمة، وقيل: مولى فاطمة بنت عتبة، 2 أبو صاحب السيرة.(@)(@@)(@)(@@)(@@)(@@) $ 1258 - إسحاق بن بشير النبال.(@)(@@)(@)(@@)(@@)(@@) $ 1259 - إسحاق بن جعفر بن علي.(@)(@@)(@)(@@)(@@)(@@) $ 1260 - أيوب بن شهاب بن زيد البارقي الأزدي، مولاهم كوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1261 - أيوب بن بكر بن أبي علاج الموصلي.(@)(@@)(@)(@@)(@@)(@@) $ 1262 - أيوب بن أبي تميمة كيسان السختياني العنزي البصري، 3 كنيته أبو بكر، مولى عمار بن ياسر، وكان مولى فهو مولى مولى، وكان يحلق شعره في كل سنة مرة فإذا طال فرق، رأي انس بن مالك، ومات بالطاعون بالبصرة سنة أحدي و(@)PageV00P125(@)(@@) ثلاثين ومائة.(@)(@@)(@)(@@)(@@)(@@) $ 1263 - أيوب بن وشيكة.(@)(@@)(@)(@@)(@@)(@@) $ 1264 - أبان بن أبي عياش فيروز، تابعي، ضعيف.(@)(@@)(@)(@@)(@@)(@@) $ 1265 - أبان بن تغلب، أبو سعيد البكري الجريري.(@)(@@)(@)(@@)(@@)(@@) $ 1266 - أنس بن عمرو الأزدي.(@)(@@)(@)(@@)(@@)(@@) $ 1267 - أسلم المكي القواس.(@)(@@)(@)(@@)(@@)(@@) $ 1268 - إسرائيل بن عباد المكي. 1(@)(@@)(@@)(@@) $ 1269 - أعين الرازي، يكنى أبا معاذ.(@)(@@)(@)(@@)(@@)(@@) $ 1270 - إسحاق بن واصل الضبي.(@)(@@)(@)(@@)(@@)(@@) $ 1271 - إسحاق بن عبد الله بن أبي طلحة المدني.(@)(@@)(@)(@@)(@@)(@@) $ 1272 - أسلم بن أيمن التميمي المنقري الكوفي. 2(@)(@@)(@@)(@@) $ 1273 - أحمد بن عائذ.(@)(@@)(@)(@@)(@@)(@@) $ 1274 - أحمد بن عمران الحلبي.(@)(@@)(@)(@@)(@@)(@@) $ 1275 - إسحاق القمي.(@)(@@)(@)(@@)(@@)(@@) $ 1276 - أسيد بن القاسم.(@)(@@)(@@)(@@) || باب الباء(@)(@@)(@@)(@@) $ 1277 - بشر بن جعفر الجعفي، أبو الوليد، روى عنه أحمد بن الحارث الأنماطي.(@)(@@)(@)(@@)(@@)(@@) $ 1278 - بشر بن أبي عقبة المدائني.(@)(@@)(@)(@@)(@@)(@@) $ 1279 - بشر بن عبد الله الخثعمي الكوفي.(@)PageV00P126(@)(@@)(@)(@@)(@@)(@@) $ 1280 - بشير بن ميمون الوابشي الهمداني النبال الكوفي، 1 وأخوه شجرة، وهما ابنا أبي أراكة، واسمه ميمون مولى بني وابش، وهو ميمون بن سنجار.(@)(@@)(@)(@@)(@@)(@@) $ 1281 - بشير، أبو عبد الصمد بن بشير الكوفي، 2 روى عن أبي جعفر 
ms40	 وأبي عبد الله عليهما السلام، ذكره علي بن الحسن بن فضال.(@)(@@)(@)(@@)(@@)(@@) $ 1282 - بشر، بياع الزطي.(@)(@@)(@)(@@)(@@)(@@) $ 1283 - بشر بن خثعم.(@)(@@)(@)(@@)(@@)(@@) $ 1284 - بشير الرحال. 3(@)(@@)(@@)(@@) $ 1285 - بشر بن يسار.(@)(@@)(@@)(@@) $ 1286 - بشار بن زيد بن النعمان، مجهول.(@)(@@)(@)(@@)(@@)(@@) $ 1287 - بشير، يكنى أبا محمد المستنير الجعفي الأزرق، بياع الطعام، مجهول.(@)(@@)(@)(@@)(@@)(@@) $ 1288 - بكر بن حبيب الأحمسي البجلي الكوفي، روى عنه وعن أبي عبد الله عليهما السلام، كنيته أبو مريم، ذكره علي بن الحسن بن فضال.(@)(@@)(@)(@@)(@@)(@@) $ 1289 - بكر بن خالد الكوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1290 - بكر بن كرب.(@)(@@)(@)(@@)(@@)(@@) $ 1291 - بكر بن صالح.(@)(@@)(@)(@@)(@@)(@@) $ 1292 - بكر بن أبي حبيبة.(@)(@@)(@)(@@)(@@)(@@) $ 1293 - بكير بن أعين بن سنسن الشيباني الكوفي، روى عنه وعن أبي عبد الله(@)PageV00P127(@)(@@) عليهما السلام، يكنى أبا عبد الله، ويقال: أبو الجهم، وله ستة أولاد ذكور: عبد الله والجهم وعبد الحميد وعبد الاعلى وعمرو زيد. 1(@)(@@)(@@)(@@) $ 1294 - بكير بن حبيب الكوفي، روى عنه وعن أبي عبد الله عليهما السلام، و روى عاصم عن منصور بن حازم عنه.(@)(@@)(@)(@@)(@@)(@@) $ 1295 - بكير بن جندب الكوفي، روى عنهما عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1296 - بكرويه الكندي الكوفي، روى عنه وعن أبي عبد الله عليهما السلام، روى عنه أبان بن عثمان.(@)(@@)(@)(@@)(@@)(@@) $ 1297 - برد الإسكاف الأزدي الكوفي، روى عنهما عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1298 - بريد بن معاوية العجلي، يكنى أبا القاسم.(@)(@@)(@)(@@)(@@)(@@) $ 1299 - برد الخياط، كوفي.(@)(@@)(@)(@@)(@@)(@@) $ 1300 - بسام بن عبد الله الصيرفي، يكنى أبا عبد الله، مولى بني هاشم.(@)(@@)(@)(@@)(@@)(@@) $ 1301 - بدر بن الخليل الأسدي، أبو الخليل الكوفي، روى عنه وعن أبي عبد الله عليهما السلام.(@)(@@)(@)(@@)(@@)(@@) $ 1302 - بشار الأسلمي.(@)(@@)(@)(@@)(@@)(@@) $ 1303 - بشير بن سلمان المدني. 2(@)(@@)(@@)(@@) $ 1304 - بشر بن عبد الله بن عمرو بن سعيد الخثعمي، كوفي. 3(@)(@@)(@@)(@@) || باب التاء(@)(@@)(@@)(@@) $ 1305 - تميم بن زياد.(@)PageV00P128(@)(@@)(@@)(@@) || باب الثاء(@)(@@)(@@)(@@) $ 1306 - ثابت بن هرمز، أبو المقدام العجلي، مولاهم الكوفي الحداد.(@)(@@)(@@)(@@) $ 1307 - ثابت بن دينار، أبو صفية الأزدي الثمالي الكوفي، يكنى أبا حمزة.(@)(@@)(@@)(@@) $ 1308 - ثابت بن أبي ثابت، عبد الله البجلي الكوفي، يكنى أبا سعيد، مولى، روى عنه وعن أبي عبد الله عليهما السلام.(@)(@@)(@@)(@@) $ 1309 - ثابت بن زائدة العكلي.(@)(@@)(@@)(@@) $ 1310 - ثوير 