ms181	 اركع حتى تطمئن راكعا ، ثم ارفع حتى تستوي قائما ، ثم اسجد حتى تطمئن ساجدا ، ثم ارفع حتى تطمئن جالسا ، ثم اسجد حتى تطمئن ساجدا ، ثم ارفع حتى تستوي قائما ، ثم افعل ذالك في صلاتك كلها ) )(@)(@@) ( ق ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1688 ) قال النبي :(@)(@@) | 30 ( إذا قمت إلى الصلاة فأسبغ الوضوء واجعل الماء بين أصابع يديك ورجليك ) )(@)(@@) ( ه ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1689 ) قال النبي :(@)(@@) | 30 ( إذا قمت إلى الصلاة فتوضأ كما أمرك الله ثم قم فاستقبل القبلة ثم كبر فإن كان معك قرآن فاقرأه ، وإن لم يكن معك قرآن فاحمد الله وهلله وكبره فإذا ركعت فاركع حتى تطمئن ، ثم ارفع رأسك فاعتدل قائما ثم اسجد فاعتدل ساجدا ، ثم ارفع رأسك فاعتدل قاعدا حتى تقضي صلاتك ، فإذا فعلت ذالك PageV01P252 فقد تمت صلاتك ، وإن انتقصت من ذالك شيئا فإنما انتقصت من صلاتك ) )(@)(@@) عن رفاعة البدري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1690 ) قال النبي :(@)(@@) | 30 ( إذا قمت إلى الصلاة فكبر ثم اقرأ ما تيسر معك من القرآن ، ثم اركع حتى تطمئن راكعا ، ثم ارفع حتى تعتدل قائما ، ثم اسجد حتى تطمئن ساجدا ، ثم ارفع حتى تطئمن جالسا ، ثم اسجد حتى تطمئن ساجدا ، ثم افعل ذالك في صلاتك كلها ) )(@)(@@) ( حم ق 3 ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1691 ) قال النبي :(@)(@@) | 30 ( إذا قمت في صلاتك فصل صلاة مودع ، ولا تكلم بكلام تعتذر منه ، واجمع الإياس مما في أيدي الناس ) )(@)(@@) ( حم ه ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1692 ) قال النبي :(@)(@@) | 30 ( إذا قمتم في الصلاة فلا تسبقوا قارئكم بالركوع والسجود ولاكن هو يسبقكم ) )(@)(@@) ( البزار ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1693 ) قال النبي :(@)(@@) | 30 ( إذا كان آخر الزمان واختلفت الأهواء فعليكم بدين أهل البادية والنساء ) )(@)(@@) ( حب ) في الضعفاء ( فر ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1694 ) قال النبي :(@)(@@) | 30 ( إذا كان اثنان صليا معا ، وإذا كانوا ثلاثة تقدم أحدهم ) )(@)(@@) ( قط ) عن سمرة رضي الله عنه ( ز 
ms182	 ) .(@)(@@)(@@)(@@) $ ( 1695 ) قال النبي :(@)(@@) | 30 ( إذا كان اثنان يتناجيان فلا تدخل بينهما ) ( ابن عساكر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1696 ) قال النبي :(@)(@@) | 30 ( إذا كان أجل أحدكم بأرض أتى له حاجة إليها ، فإذا بلغ أقصى أثره قبضه الله إليه فتقول الأرض يوم القيامة رب هاذا ما استودعتني ) ) PageV01P253(@)(@@) ( ه ) و الحكيم ( ك ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1697 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم صائما فليفطر على التمر ، فإن لم يجد التمر فعلى الماء فإن الماء طهور ) )(@)(@@) ( د ك هق ) عن سل مان بن عامر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1698 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم على وضوء فأكل طعاما فلا يتوضأ إلا أن يكون لبن الإبل إذا شربتموه فتمضمضوا بالماء ) )(@)(@@) ( طب ) و الضياء عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1699 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم فقيرا فليبدأ بنفسه ، فإن كان فضل فعلى عياله ، فإن كان فضل فعلى ذي قرابته ، فإن كان فضل فهاهنا وهاهنا ) )(@)(@@) ( حم م د ن ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1700 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في الشمس فقلص عنه الظل وصار بعضه في الظل وبعضه في الشمس فليقم ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1701 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في الصلاة فلا يرفع بصره إلى السماء أن يلتمع بصره ) )(@)(@@) ( حم ن ) عن رجل من الصحابة ( ز ) .(@)(@@)(@@)(@@) $ ( 1702 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في الصلاة فوجد حركة في دبره أحدث أو لم يحدث فأشكل عليه فلا ينصرف حتى يسمع صوتا أو يجد ريحا ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1703 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في المسجد فوجد ريحا بين ألييه فلا يخرج حتى يسمع صوتا أو يجد ريحا ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1704 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في صلاة فإنه يناجي ربه فلينظر PageV01P254 أحدكم ما يقول في صلاته ولا ترفعوا أصواتكم فتؤذوا المؤمنين ) )(@)(@@) ( البغوي ) عن رجل من بني 
ms183	 بياضة ( ز ) .(@)(@@)(@@)(@@) $ ( 1705 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم يصلي فلا يبصق قبل وجهه ، فإن الله قبل وجهه إذا صلى ) )(@)(@@) ( مالك ق ن ) عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1706 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم يصلي فلا يدع أحدا يمر بين يديه وليدرأه ما استطاع فإن أبى فليقاتله فإنما هو شيطان ) )(@)(@@) ( م د ن ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1707 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم يصلي فلا يدع أحدا يمر بين يديه وليدرأه ما استطاع فإن أبى فليقاتله فإن معه القرين ) )(@)(@@) ( حم م ه ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1708 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم يصلي فلا يرفع بصره إلى السماء لا يلتمع ) )(@)(@@) ( طس ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1709 ) قال النبي :(@)(@@) | 30 ( إذا كان الجهاد على باب أحدكم فلا يخرج إلا باذن أبويه ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1710 ) قال النبي :(@)(@@) | 30 ( إذا كان العام المقبل صمنا يوم التاسع ) )(@)(@@) ( د ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1711 ) قال النبي :(@)(@@) | 30 ( إذا كان الغلام لم يطعم الطعام صب على بوله ، وإذا كانت الجارية غسل ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1712 ) قال النبي :(@)(@@) | 30 ( إذا كان الغلام يتيما فامسحوا برأسه هاكذا إلى قدام ، وإذا كان له أب فامسحوا برأسه هاكذا إلى خلف من مقدمه ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@) PageV01P255(@)(@@)(@@)(@@) $ ( 1713 ) قال النبي :(@)(@@) | 30 ( إذا كان الفيء ذراعا ونصفا إلى ذراعين فصلوا الظهر ) )(@)(@@) ( عق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1714 ) قال النبي :(@)(@@) | 30 ( إذا كان الماه قلتين فإنه لا ينجس ) )(@)(@@) ( د ه ك ) عن ابن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1715 ) قال النبي :(@)(@@) | 30 ( إذا كان أول ليلة من شهر رمضان صفدت الشياطين ومردة الجن وغلقت أبواب النار فلم يفتح منها باب ، وفتحت أبواب الجنة فلم يغلق منها باب ، وينادي مناد كل ليلة ، يا باغي الخير أقبل ، ويا باغي الشر أقصر ، ولله 
ms184	 عتقاء من النار وذالك كل ليلة ) )(@)(@@) ( ت ه حب ك هق ) عن أبي هريرة رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1716 - قال النبي صلى الله عليه وسلم : ' إذا كانت الفتنة بين المسلمين فاتخذ سيفا من | خشب ' ( ه ) عن أهبان رضي الله عنه . |(@)(@@)(@@)(@@) $ 1717 - قال النبي صلى الله عليه وسلم : ' إذا كانت الهبة لذي رحم محرم لم يرجع فيها ' | ( قط ك هق ) عن سمرة رضي الله عنه ( ز ) |(@)(@@)(@@)(@@) $ 1718 - قال النبي صلى الله عليه وسلم : ' إذا كان أمراؤكم خياركم ، وأغنياؤكم سمحاءكم ، | وأموركم شورى بينكم ، فظهر الأرض خير لكم من بطنها ، وإذا كان أمراؤكم | أشراركم ، وأغنياؤكم بخلاءكم ، وأموركم إلى نسائكم ، فبطن الأرض خير لكم من | ظهرها ' ( ت ) عن أبي هريرة رضي الله عنه . |(@)(@@)(@@)(@@) $ 1719 - قال النبي صلى الله عليه وسلم : ' إذا كانت بالرجل الجراحة في سبيل الله أو القروح | أو الجدري فيجنب فيخاف إن اغتسل أن يموت فليتيمم ' ( ك هق ) عن ابن عباس | رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 1720 - قال النبي صلى الله عليه وسلم : ' إذا كانت عند الرجل امرأتان فلم يعدل بينهما جاء | يوم القيامة وشقه ساقط ' ( ت ك ) عن أبي هريرة رضي الله عنه . | PageV01P256 |(@)(@@)(@@)(@@) $ 1721 - قال النبي صلى الله عليه وسلم : ' إذا كان ثلاثة جميعا فلا يتناجى اثنان دون الثالث ' | ( حم ) عن أبي هريرة رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1722 - قال النبي صلى الله عليه وسلم : ' إذا كان ثلاثة في سفر فليؤمروا أحدهم ' ( هق ) عن | أبي هريرة رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1723 - قال النبي صلى الله عليه وسلم : ' إذا كان جنح الليل فكفوا صبيانكم فإن الشياطين | تنتشر حينئذ ، فإذا ذهب ساعة من الليل فخلوهم وأغلقوا الأبواب واذكروا اسم الله | فإن الشيطان لا يفتح بابا مغلقا ، وأوكئوا قربكم واذكروا اسم الله ، وخمروا آنيتكم | واذكروا اسم الله ولو أن تعرضوا عليه شيئا ، وأطفئوا مصابيحكم ' ( حم ق د ن ) عن | جابر رضي الله عنه . |(@)(@@)(@@)(@@) $ 1724 - قال النبي صلى الله عليه وسلم : ' إذا كان دم الحيض فإنه دم أسود يعرف فإذا كان ذلك | فأمسكي عن الصلاة ، وإذا كان 
ms185	 الآخر فتوضئي وصلي فإنما هو عرق ' ( د ن ك ) عن | فاطمة بنت أبي حبيش ( ن ) عن عائشة رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 1725 - قال النبي صلى الله عليه وسلم : ' إذا كان رمضان فاعتمري فيه فإن عمرة فيه تعدل | حجة ' ( ن ) عن ابن عباس رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 1726 - قال النبي صلى الله عليه وسلم : ' إذا كان شيء من أمر دنياكم فأنتم أعلم به ، وإذا كان | شيء من أمر دينكم فإلي ' ( حم م ) عن أنس ( ه ) عن أنس وعائشة رضي الله | عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 1727 - قال النبي صلى الله عليه وسلم : ' إذا كان في آخر الزمان لا بد للناس فيها من الدراهم | والدنانير يقيم الرجل بها دينه ودنياه ' ( طب ) عن المقدام رضي الله عنه . |(@)(@@)(@@)(@@) $ 1728 - قال النبي صلى الله عليه وسلم : ' إذا كان في وسط الصلاة أو حين انقضائها فابدءوا قبل | PageV01P257 | التسليم فقولوا : التحيات الطيبات والصلوات والسلام والملك لله ، ثم سلموا على | النبيين ، ثم سلموا على أقاربكم وعلى أنفسكم ' ( د طب هق ) والضياء عن سمرة | رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1729 - قال النبي صلى الله عليه وسلم : ' إذا كان لإحداكن مكاتب فكان عنده ما يؤدي | فلتحتجب عنه ' ( حم د ت ك هق ) عن أم سلمة رضي الله عنها ( ز ) . |(@)(@@)(@@)(@@) $ 1730 - قال النبي صلى الله عليه وسلم : ' إذا كان لأحدكم ثوبان فليصل فيهما ، فإن لم يكن | إلا ثوب فليأتذر ولا يشتمل اشتمال اليهود ' ( د ) عن ابن عمر رضي الله | عنهما ( ز ) |(@)(@@)(@@)(@@) $ 1731 - قال النبي صلى الله عليه وسلم : ' إذا كان لأحدكم خادم قد كفاه المشقة فليطعمه ، فإن | لم يفعل فليناوله اللقمة ' ( طص ) عن جابر رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1732 - قال النبي صلى الله عليه وسلم : ' إذا كان لأحدكم شعر فليكرمه ' ( د ) عن أبي هريرة | ( هب ) عن عائشة رضي الله عنهما . |(@)(@@)(@@)(@@) $ 1733 - قال النبي صلى الله عليه وسلم : ' إذا كان للرجل على الرجل حق فأخره إلى أجله كان | له صدقة ، فإن أخره بعد أجله كان له بكل يوم صدقة ' ( طب ) عن عمران بن | حصين رضي الله 
ms186	 عنهما . |(@)(@@)(@@)(@@) $ 1734 - قال النبي صلى الله عليه وسلم : ' إذا كان ليلة النصف من شعبان اطلع الله إلى خلقه | فيغفر للمؤمنين ويملي للكافرين ويدع أهل الحقد بحقدهم حتى يدعوه ' ( هب ) عن | أبي ثعلبة الخشني رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1735 - قال النبي صلى الله عليه وسلم : ' إذا كان ليلة النصف من شعبان فقوموا ليلتها وصوموا | يومها ، فإن الله ينزل فيها لغروب الشمس إلى سماء الدنيا فيقول ألا مستغفر فأغفر | PageV01P258 | له ، ألا مسترزق فأرزقه ، ألا مبتلى فأعافيه ، ألا سائل فأعطيه ، ألا كذا ألا كذا حتى | يطلع الفجر ' ( ه هب ) عن علي رضي الله عنه ( ز ) |(@)(@@)(@@)(@@) $ 1736 - قال النبي صلى الله عليه وسلم : ' إذا كان ليلة النصف من شعبان نادى مناد هل من | مستغفر فأغفر له ، هل من سائل فأعطيه فلا يسأل أحد شيئا إلا أعطي ، إلا زانية | بفرجها أو مشرك ' ( هب ) عن عثمان بن أبي العاص رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1737 - قال النبي صلى الله عليه وسلم : ' إذا كان ليلة النصف من شعبان يغفر الله من الذنوب | أكثر من عدد شعر غنم كلب ' ( هب ) عن عائشة رضي الله عنها ( ز ) . |(@)(@@)(@@)(@@) $ 1738 - قال النبي صلى الله عليه وسلم : ' إذا كان مطر وابل فصلوا في رحالكم ' ( حم ك ) عن | عبد الرحمن بن سمرة ( ز ) . |(@)(@@)(@@)(@@) $ 1739 - قال النبي صلى الله عليه وسلم : ' إذا كانوا ثلاثة فلا يتناج اثنان دون الثالث ' ( مالك | ق ) عن ابن عمر رضي الله عنهما . |(@)(@@)(@@)(@@) $ 1740 - قال النبي صلى الله عليه وسلم : ' إذا كانوا ثلاثة فليؤمهم أحدهم وأحقهم بالإمامة | أقرؤهم ' ( حم م ن ) عن أبي سعيد رضي الله عنه . |(@)(@@)(@@)(@@) $ 1741 - قال النبي صلى الله عليه وسلم : ' إذا كانوا ثلاثة فليؤمهم أقرؤهم لكتاب الله ، فإن | كانوا في القراءة سواء فأكبرهم سنا ، فإن كانوا في السن سواء فأحسنهم وجها ' | ( هق ) عن أبي زيد الأنصاري رضي الله عنه . |(@)(@@)(@@)(@@) $ 1742 - قال النبي صلى الله عليه وسلم : ' إذا كان يوم الجمعة غدت الشياطين براياتها إلى | الأسواق فيرمون الناس بالربائث ويثبطونهم عن الجمعة ، وتغدو الملائكة فتجلس | على أبواب المسجد 
ms187	 فيكتبون الرجل من ساعة والرجل من ساعتين ، حتى يخرج | PageV01P259 | الإمام فإذا جلس الرجل مجلسا يستمكن فيه من الاستماع والنظر فأنصت ولم يلغ | كان له كفل من أجر ، وإن جلس مجلسا يتمكن فيه من الاستماع والنظر فلغا ولم | ينصت كان له كفل من وزر ، ومن قال يوم الجمعة لصاحبه صه فقد لغا ، ومن لغا | فليس له في جمعته تلك شيء ' ( حم د ) عن علي رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 1743 - قال النبي صلى الله عليه وسلم : ' إذا كان يوم الجمعة قعدت الملائكة على أبواب | المسجد يكتبون من جاء من الناس على قدر منازلهم فرجل قدم جزورا ، ورجل قدم | بقرة ، ورجل قدم شاة ، ورجل قدم دجاجة ، ورجل قدم عصفورا ، ورجل قدم | بيضة ، فإذا أذن المؤذن وجلس الإمام على المنبر طووا الصحف ودخلوا المسجد | يستمعون الذكر ' ( حم والضياء ) عن أبي سعيد رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ ( 1744 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم الجمعة كان على كل باب من أبواب المسجد ملائكة يكتبون الناس على قدر منازلهم الأول فالأول ، فإذا جلس الإمام طووا الصحف وجاؤوا يستمعون الذكر ، ومثل المهجر كمثل الذي يهدي بدنة ثم كالذي يهدي بقرة ، ثم كالذي يهدي الكبش ، ثم كالذي يهدي الدجاجة ، ثم كالذي يهدي البيضة ) )(@)(@@) ( ق ن ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1745 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم الجمعة وليلة الجمعة فأكثروا الصلاة علي ) ( الشافعي ) عن صفوان بن سليم مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 1746 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم الخميس بعث الله ملائكة معهم صحف من فضة وأقلام من ذهب يكتبون يوم الخميس وليلة الجمعة أكثر الناس علي صلاة ) )(@)(@@) ( ابن عساكر ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1747 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة أتي بالموت كالكبش الأملح فيوقف بين الجنة والنار فيذبح وهم ينظرون فلو أن أحدا مات فرحا لمات أهل الجنة ، PageV01P260 ولو أن أحدا مات حزنا لمات أهل النار ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1748 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة أتي 
ms188	 بصحف مختمة تنصب بين يدي الله تعالى فيقول الله للملائكة إقبلوا هاذا وألقوا هاذا ، فتقول الملائكة وعزتك ما رأينا إلا خيرا فيقول نعم ولاكن كان لغيري ، ولا أقبل اليوم إلا ما ابتغي به وجهي ) )(@)(@@) ( سمويه ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1749 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة أدنيت الشمس من العباد حتى تكون قيد ميل أو اثنتين فتصهرهم الشمس فيكونون في العرق كقدر أعمالهم ، فمنهم من يأخذه إلى عقبيه ، ومنهم من يأخذه إلى ركبتيه ، ومنهم من يأخذه إلى حقويه ، ومنهم من يلجمه إلجاما ) )(@)(@@) ( حم ت ) عن المقداد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1750 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة أعطى الله تعالى كل رجل من هاذه الأمة رجلا من الكفار فيقال له هاذا فداؤك من النار ) )(@)(@@) ( م ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1751 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة بعث الله إلى كل مؤمن ملكا معه كافر ، فيقول الملك للمؤمن يا مؤمن هاك هاذا الكافر فهاذا فداؤك من النار ) )(@)(@@) ( طب ) و الحاكم في الكنى ا عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1752 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة دعا الله تعالى بعبد من عبيده فيقف بين يديه فيسأله عن جاهه كما يسأله عن ماله ) )(@)(@@) ( تمام خط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1753 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة شفعت فقلت : يا رب أدخل الجنة من كان في قلبه خردلة من إيمان فيدخلون ، ثم يقول أدخل الجنة من كان في PageV01P261 قلبه أدنى شيء ) )(@)(@@) ( خ ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1754 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة عرف الكافر بعمله فجحد وخاصم فيقال هاؤلاء جيرانك يشهدون عليك فيقول كذبوا ، فيقول أهلك وعشيرتك فيقول كذبوا ، فيقول احلفوا فيحلفون ، ثم يصمتهم الله وتشهد عليهم ألسنتهم فيدخلهم النار ) )(@)(@@) ( ع ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1755 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة كنت إمام النبيين وخطيبهم وصاحب شفاعتهم غير فخر ) )(@)(@@) ( حم 
ms189	 ت ه ك ) عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1756 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة نادى مناد ألا ليقم خصماء الله وهم القدرية ) )(@)(@@) ( طس ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1757 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة نادى مناد لا يرفعن أحد من هاذه الأمة كتابه قبل أبي بكر وعمر ) )(@)(@@) ( ابن عساكر ) عن عبد الرحمن بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1758 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة نادى مناد من بطنان العرش : أيها الناس غضوا أبصاركم حتى تجوز فاطمة إلى الجنة ) )(@)(@@) ( أبو بكر ) في الغيلانيات عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1759 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة نادى مناد من بطنان العرش : يا أهل الجمع نكسوا رؤوسكم ، وغضوا أبصاركم حتى تمر فاطمة بنت محمد على الصراط فتمر مع سبعين ألف جارية من الحور العين كمر البرق ) )(@)(@@) ( أبو بكر في الغيلانيات ) عن أبي أيوب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1760 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة نادى مناد : من عمل عملا لغير PageV01P262 الله فليطلب ثوابه ممن عمله له ) )(@)(@@) ( ابن سعد ) عن أبي سعد بن أبي فضالة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1761 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة نادى مناد من وراء الحجب يا أهل الجمع غضوا أبصاركم عن فاطمة بنت محمد حتى تمر ) )(@)(@@) ( تمام ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1762 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة نودي أين أبناء الستين وهو العمر الذي قال الله تعالى عنه أو لم نعمركم ، ما يتذكر فيه من تذكر ) ( الحكيم طب هب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1763 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة ينادي مناد من بطنان العرش ليقم من على الله أجره فلا يقوم إلا من عفا عن ذنب أخيه ) )(@)(@@) ( خط ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1764 ) قال النبي :(@)(@@) | 30 ( إذا كان يوم صوم أحدكم فلا يرفث ولا يجهل ، فإن امرؤ شاتمه أو قاتله فليقل إني صائم إني 
