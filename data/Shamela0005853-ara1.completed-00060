ه بن يونس قد روى عن يوسف بن موسى القطان عنه(@)(@@)(@@)(@@) $ 2051 - (@)(@@) أحمد بن أبي شعيب وأبو شعيب عبد الله بن مسلم الحراني وقد حدث عن محمد غير منسوب ويقال إنه محمد بن النضر بن عبد الوهاب أو محمد بن إبراهيم البوشنجي عنه في تفسير سورة براءة أحمد بن حنبل(@)(@@) قال أبو عبد الله في كتاب اللباس في باب هل يجعل نقش الخاتم ثلاثة أسطر في عقب حديث الأنصاري زادني أحمد بن حنبل(@)(@@) وقد روي في كتاب الجامع عن أشياخ الترمذي عنه وقد روى عنه أبو عبد الله خارج الجامع عن أحمد بن حنبل غير شيء(@)(@@)(@@)(@@) $ 2052 - (@)(@@) أحمد بن يزيد بن إبراهيم بن الورتنيسي 
ms48	 الحراني وقد روى عن محمد بن يوسف وهو أبو أحمد البيكندي عنه(@)(@@)(@@)(@@) $ 2053 - (@)(@@) أحمد بن صالح المصري روى عنه أبو عبد الله في غير موضوع(@)(@@) PageV00P000(@)(@@) من الكتاب ثم روى عن محمد غير منسوب عنه(@)(@@)(@@)(@@) $ 2054 - (@)(@@) إبراهيم بن المنذر الحزامي روى عنه في غير موضع من الجامع ثم روى في كتاب الاستئذان عن محمد بن أبي غالب عنه(@)(@@)(@@)(@@) $ 2055 - (@)(@@) إسماعيل بن إبراهيم أبو معمر الهذلي روى عنه أبو عبد الله في في صفة النبي صلى الله عليه وسلم عن محمد بن عبد الرحيم وهو صاعقة عنه(@)(@@)(@@)(@@) $ 2056 - (@)(@@) إسماعيل بن الخليل الخزاز أبو عبد الله الكوفي روى عنه أبو عبد الله في غير موضع من الجامع وقد روى عن الحسن غير منسوب في الجامع أيضا عنه(@)(@@)(@@)(@@) $ 2057 - (@)(@@) بشر بن شعيب بن أبي حمزة قال أبو عبد اله في كتاب التاريخ تركناه وهو حي وروى في باب مرض النبي صلى الله عليه وسلم عن إسحاق غير منسوب عنه مفرد مجرد(@)(@@)(@@)(@@) $ 2058 - (@)(@@) محمد بن سابق وقد روى عنه الحسن بن إسحاق المروزي عنه في عمرة الحديبية(@)(@@)(@@)(@@) $ 2059 - (@)(@@) أحمد بن منيع البغوي روى محمد بن إسماعيل في كتاب الطب عن الحسين بن يحيى بن جعفر عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2060 - (@)(@@) حفص بن عمر أبو عمر الحوضي روى أبو عبد الله في غير موضع من الكتاب عنه ثم روى في الجامع عن محمد بن عبد الرحيم صاعقة في الوضوء والصلاة والجهاد عنه(@)(@@)(@@)(@@) $ 2061 - (@)(@@) خالد بم مخلد القطواني روى عنه أبو عبد الله في غير موضع من الجامع وروى في محمد بن عثمان بن كرامة عنه في الرقاق والردة(@)(@@)(@@)(@@) $ 2062 - (@)(@@) داود بن رشيد روى عنه بغير واسطة خارج الجامع وروى عن عن أبي يحيى محمد بن عبد الرحيم في كتاب كفارت الإيمان(@)(@@)(@@)(@@) $ 2063 - (@)(@@) أبو توبة الربيع بن نافع روى عنه ثم روى في الجامع عن الحسن بن الصباح عنه في كفارات الإيمان(@)(@@)(@@)(@@) $ 2064 - (@)(@@) زكريا بن عدي روى عنه ثم روى في كتاب الوصايا وفي غزوة أحد عن أبي يحيى عنه 
ms49	(@)(@@)(@@)(@@) $ 2065 - (@)(@@) سعيد بن عبد الله بن الحكم بن أبي مريم روى عنه في غير(@)(@@) PageV00P000(@)(@@) موضع من الكتاب ثم روى عن محمد بن عبد الله وهو محمد بن يحيى بن عبد الله الذهلي عنه(@)(@@)(@@)(@@) $ 2066 - (@)(@@) أبو زيد سعيد بن الربيع الهروي روى عنه أبو عبد الله في الصيد وفي التوحيد ثم روى في آخر الكتاب عن أبي يحيى محمد بن عبد الرحيم عنه(@)(@@)(@@)(@@) $ 2067 - (@)(@@) سعيد بن سليمان الواسطي روى عنه في غير موضع من الكتاب ثم روى في المناسك عن أبي يحيى محمد بن عبد الرحيم عنه(@)(@@)(@@)(@@) $ 2068 - (@)(@@) سعيد بن منصور أبو عثمان الخراساني ويقال الجوزجاني نزيل مكة روى عنه ثم روى في آخر كتاب الصلاة عن يحيى بن موسى وهو ابن أخت البجلي عنه(@)(@@)(@@)(@@) $ 2069 - (@)(@@) سليمان بن عبد الرحمن بن بنت شرحبيل الدمشقي روى عنه أبو عبد الله في الأدب وروى في كتاب أبي بكر رضي الله عنه عن عبد الله غير منسوب وهو ابن حماد الآملي عنه(@)(@@)(@@)(@@) $ 2070 - (@)(@@) سريج بن النعمان الجوهري روى أبو عبد الله في غير موضع من الكتاب ثم روى في الجمعة والحج وعمرة القضاء عن محمد بن رافع وأيضا عن محمد غير منسوب عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2071 - (@)(@@) سريج بن يونس أبو الحارث الجمال روى عنه أبو عبد الله وروى في أول الطب من كتاب الجامع عن محمد بن عبد الرحيم عنه(@)(@@)(@@)(@@) $ 2072 - (@)(@@) أبو عاصم الضحاك بن مخلد النبيل روى عنه أبو عبد الله في غير موضع من الجامع ثم روى عن علي بن المديني وعبد الله بن محمد وهو المسندي وإسحاق وهو ابن نصر وجماعة من شيوخه عنه(@)(@@)(@@)(@@) $ 2073 - (@)(@@) عبد الله بن رجاء الغداني روى عنه أبو عبد الله في غير موضع من الجامع ثم روى عن محمد غير منسوب عنه في صفة النبي صلى الله عليه وسلم وفي الصلاة ومحمد هو ابن يحيى(@)(@@)(@@)(@@) $ 2074 - (@)(@@) عبد الله بن محمد أبو جعفر النفيلي روى عنه ثم روى عن محمد وهو ابن يحيى في تفسير آخر سورة البقرة عنه 
ms50	(@)(@@)(@@)(@@) $ 2075 - (@)(@@) عبيد الله بن موسى العبسي روى عنه أبو عبد الله في كتاب الإيمان وفي غير موضع من الجامع ثم روى في الاعتصام والديات وغير موضع من الجامع عن جماعة عنه منهم إسحاق بن إبراهيم وأحمد بن إسحاق ومحمود بن غيلان(@)(@@) PageV00P000(@)(@@) وعبد الله بن أبي شيبة ويوسف بن موسى وأحمد بن أبي سريج عنه(@)(@@)(@@)(@@) $ 2076 - (@)(@@) عبيد الله بن معاذ العنبري روى عنه أبو عبد الله ثم روى في التفسير عن محمد وأحمد غير منسوبين وهما ابنا النضر بن عبد الوهاب النيسابوري عنه وقد روى أيضا عن حماد بن حميد عنه(@)(@@)(@@)(@@) $ 2077 - (@)(@@) أحمد بن صالح المصري روى عنه أبو عبد الله في غير موضع من الكتاب ثم روى عن محمد غير منسوب عنه(@)(@@)(@@)(@@) $ 2078 - (@)(@@) عمر بن حفص بن غياث روى عنه أبو عبد الله في غير موضع من الكتاب ثم روى عنه محمد بن أبي الحسين عنه(@)(@@)(@@)(@@) $ 2079 - (@)(@@) عمرو بن عاصم الكلابي روى عنه أبو عبد الله في باب وقت الفجر في كتاب الصلاة ثم روى في فضائل القرآن عن أحمد بن اسحاق السرماري عنه(@)(@@) وروى أيضا في كتاب اللباس عن عبد القدوس بن محمد الحبحابي عنه(@)(@@)(@@)(@@) $ 2080 - (@)(@@) عمرو بن عون الواسطي روى عنه أبو عبد الله في كتاب الصلاة وغيره ثم روى عن عبد الله بن محمد عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2081 - (@)(@@) عثمان بن الهيثم روى عنه أبو عبد الله في مواضع كثيرة في الجامع ثم روى في كتاب اللباس وفي كتاب الأيمان والنذور حديث عثمان بن الهيثم ومحمد عنه لم ينسب محمد أو هو ابن يحيى(@)(@@)(@@)(@@) $ 2082 - (@)(@@) عاصم بن علي روى عنه أبو عبد الله في الصلاة وفي غير موضع ثم روى في كتاب الحدود عن محمد بن عبد الله عنه ومحمد بن عبد الله هو عندي محمد بن يحيى بن عبد الله(@)(@@)(@@)(@@) $ 2083 - (@)(@@) عفان بن مسلم روى عنه أبو عبد الله ثم روى عن أبي يحيى صاعقة وعن أبي قدامة وعن إسحاق غير منسوب عنه في الجنائز في مواضع كثيرة(@)(@@)(@@)(@@) $ 2084 
ms51	 - (@)(@@) أبو نعيم الفضل بن دكين أكثر أبو عبد الله الرواية عنه في الكتاب ثم روى عن يوسف بن موسى عنه(@)(@@)(@@)(@@) $ 2085 - (@)(@@) محمد بن سابق قد روى عنه في كتاب الوصايا وروى في كتاب النكاح عن الفضل بن يعقوب عنه وفي كتاب الجهاد عن الحسن بن الصباح عنه وروى في عمرة الحديبية عن الحسن بن اسحاق عنه وروى في الأشربة عن محمد بن عبد الله عنه وهو عندي محمد بن يحيى بن عبد الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 2086 - (@)(@@) محمد بن عبد الله الأنصاري روى أبو عبد الله عنه في كتاب الوكالة وغيره ثم روى عن علي بن المديني عنه وعن قتيبة بن سعيد عنه وعن يحيى بن جعفر عنه وعن قتيبة بن سعيد عنه وعن يحيى بن جعفر عنه وعن محمد بن عبد الله بن اسماعيل عنه وعن بندار بن بشار عنه وعن أبي موسى عنه وعن محمد بن خالد عنه ومحمد بن خالد هو محمد بن يحيى الذهلي(@)(@@) وهذه الروايات في كتاب الوكالة وكتاب التفسير عنه وبدء الخلق والأحكام(@)(@@)(@@)(@@) $ 2087 - (@)(@@) محمد بن يوسف الفريابي روى عنه أبو عبد الله في مواضع كثيرة من الجامع وقد روى في كتاب الصلاة عن اسحاق غير منسوب عنه(@)(@@)(@@)(@@) $ 2088 - (@)(@@) محمد بن أبي بكر المقدمي روى عنه أبو عبد الله في غير موضع من الكتاب وقد روى عن أحمد غير منسوب عنه(@)(@@)(@@)(@@) $ 2089 - (@)(@@) معلى بن منصور الرازي سمع منه البخاري وروى في غير كتاب الجامع وقد روى في الجامع عن أبي يحيى محمد بن عبد الرحيم في البيوع عنه(@)(@@) PageV00P000(@)(@@) وروى في كتاب التفسير عن علي بن الهيثم عنه(@)(@@)(@@)(@@) $ 2090 - (@)(@@) مكي بن إبراهيم حدث عنه أبو عبد الله في مواضع ذوات عدد من الجامع وقد حدث في كتاب البيوع عن محمد بن عمرو السوبقي عنه(@)(@@)(@@)(@@) $ 2091 - (@)(@@) هارون بن معروف روى عنه أبو عبد الله في مصنفاته خارج الجامع وروى في التفسير من الجامع عن محمد بن عبد الله عنه(@)(@@)(@@)(@@) $ 2092 - (@)(@@) يحيى بن حماد روى عنه أبو عبد الله في 
ms52	 الجامع في ذكر الحوض وغيره ثم روى في كتاب الحيض عن الحسن بن مدرك عنه(@)(@@)(@@)(@@) $ 2093 - (@)(@@) يحيى بن صالح الوحاظي روى عنه أبو عبد الله في كتاب الصلاة وغيره ثم روى في كتاب الوكالة والكسوف عن إسحاق غير منسوب عنه وروى عن محمد غير منسوب عنه(@)(@@)(@@)(@@) $ 2094 - (@)(@@) يحيى بن أبي بكير روى عنه أبو عبد الله في مواضع كثيرة من الجامع ثم روى عن محمد بن عبد الله عنه(@)(@@)(@@)(@@) $ 2095 - (@)(@@) يحيى بن معين روى عنه أبو عبد الله في مناقب الحسن والحسين من الجامع وروى في كتاب التفسير من الجامع عن عبد الله بن(@)(@@) PageV00P000(@)(@@) محمد عنه وروى في باب إسلام أبي بكر رضي الله عنه عن عبد الله غير منسوب عنه(@)(@@) بلغ عدد هؤلاء الشيوخ الذين سمع منهم أبو عبد الله وروى عنهم عن واحد ثم روى عن رجل عنهم ستة وأربعين شيخا PageV01P280 
