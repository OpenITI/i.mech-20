ms201	 فزونم به هر فضل و علم %~% که طبعم روان است و خاطر منیر(@)(@@) 19 بجای است در من به فضل خدای %~% همان فهم و آن طبع معنی پذیر(@)(@@) 20 به چاه اندرون بودم آن روز من %~% بر آوردم ایزد به چرخ اثیر(@)(@@) 21 از این قدر کامروز دارم به علم %~% نبوده‌ستم آن روز عشر عشیر(@)(@@) 22 گر آنگه به دنیا تنم شهره بود %~% کنون بهترم چون به دینم شهیر(@)(@@) 23 گر از خاک و از آب بودم کنون %~% گلابم شد آن آب و خاکم عبیر(@)(@@) 24 کنون میر پیشم ندارد خطر %~% گر آنگه خطر داشتم پیش میر(@)(@@) 25 ز دین‌اند پیشم به دنیا درون %~% عزیزان ذلیل و خطیران حقیر(@)(@@) 26 اگر میر میر است و کامش رواست %~% چنان که‌ش گمان است گو شو ممیر(@)(@@) 27 کرا بانگ و نامش شود زیر خاک %~% چه شادی کند خیره بر بانگ زیر(@)(@@) 28 چه بایدت رغبت به شیره کنون %~% که چون شیر گشته‌است بر سرت قیر(@)(@@) 29 گلی تازه بوده‌ستی آری ولیک %~% شده‌ستی کنون پژمریده زریر(@)(@@) 30 نیارد کنون تازگی باز تو %~% نه خورشید تابان نه ابر مطیر(@)(@@) 31 یکی سرو بودی چو آهن قوی %~% تو را سرو چنبر شد آهن خمیر(@)(@@) 32 هژیرت سخن باید ای پیر اگر %~% نباشد چه باک است رویت هژیر(@)(@@) 33 چو تیرت سخن باید ایرا که نیست %~% گناه تو گر نیست قدت چو تیر(@)(@@) 34 بدان منگر ای خواجه کز ظاهری %~% نبینی همی مرد دین را ظهیر(@)(@@) 35 بصارت بیلفغد باید که تو %~% ز خر به نه ای گر به چشمی بصیر(@)(@@) 36 بیاموز و ماموز مر عام را %~% زعلم نهانی قلیل و کثیر(@)(@@) 37 به خوشه قران در ببین دانه را %~% به انگور دین در رها کن عصیر(@)(@@) 38 گر از تو چو از من نفورست خلق %~% تو را به مکن هیچ بانگ و نفیر(@)(@@) 39 دلم پر ز درد است جهال خلق %~% زمن جمله زین‌اند 
ms202	 دل پر زحیر(@)(@@) 40 اگر عامه بد گویدم زان چه باک %~% رها کرده‌ام پیش موشان پنیر(@)(@@) 41 نجنبد زجایای‌پسرچون درخت %~% به باد سحرگاه کوه ثبیر(@)(@@) 42 اگر دیو بستد خراسان ز من %~% گواه منی ای علیم قدیر(@)(@@) 43 خراسانیان گر نجستند دین %~% بتر زین که خودشان گرفتی مگیر(@)(@@) 44 به پیش ینال و تگین چون رهی %~% دوانند یکسر غنی و فقیر(@)(@@) 45 چو عادند و ترکان چو باد عقیم %~% بدین باد گشتند ریگ هبیر(@)(@@) 46 مثالی از امثال قرآن تو را %~% نمودم نکو بنگر ای تیز ویر(@)(@@) 47 بیاویزد آن کس به غدر خدای %~% که بگریزد از عهد روز غدیر(@)(@@) 48 چه گوئی به محشر اگر پرسدت %~% از آن عهد محکم شبر با شبیر(@)(@@) 49 گر امروز غافل توی همچنین %~% بر این درد فردا بمانی حسیر(@)(@@) 50 وگر پند گیری زحجت به حشر %~% تو را پند او بس بود دستگیر PageV1P106(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای حجت بسیار سخن دفتر پیش آر %~% وز نوک قلم در سخنهات فروبار(@)(@@) 2 هر چند که بسیار و دراز است سخنهات %~% چون خوب و خوش است آن نه دراز است نه بسیار(@)(@@) 3 شاهی که عطاهاش گران است ستوده‌است %~% هر چند شوی زیر عطاهاش گران‌بار(@)(@@) 4 نو کن سخنی را که کهن شد به معانی %~% چون خاک کهن را به بهار ابر گهربار(@)(@@) 5 شد خوب به نیکو سخنت دفتر ناخوب %~% دفتر به سخن خوب شود جامه به آهار(@)(@@) 6 از خاطر پر علم سخن ناید جز خوب %~% از پاک سبو پاک برون آید آغار(@)(@@) 7 آچار سخن چیست معانی و عبارت %~% نو نو سخن آری چو فراز آمدت آچار(@)(@@) 8 در شعر ز تکرار سخن باک نباشد %~% زیرا که خوش آید سخن نغز به تکرار(@)(@@) 9 آچار خدای است مزه و بوی خوش و رنگ %~% با سیب و ترنج آمد و گوز و بهی و نار(@)(@@) 10 از تاک زر انگور نو امسال خوش آیدت 
ms203	 %~% هر چند کزو پار همین آمد و پیرار(@)(@@) 11 زی اهل خرد تخم سخن حکمت و علم است %~% در خاک دل ای مرد خرد تخم سخن کار(@)(@@) 12 مختار شوی کز تو بماند سخن خوب %~% زیرا که همین ماند ز پیغمبر مختار(@)(@@) 13 دینش به سخن گشت مشهر به زمین بر %~% وز راه سخن رفت بر این گنبد دوار(@)(@@) 14 مقهور به حکمت شود این خلق جهان پاک %~% زیرا که حکیم است جهان داور قهار(@)(@@) 15 از راه تن خویش سوی جانت نگه کن %~% بنگر که نهان چیست در این شخص پدیدار(@)(@@) 16 آن چیست که چون شخص گران تو بخسپد %~% بینا و سخن‌گوی همی ماند و بیدار(@)(@@) 17 آن گوهر زنده است و پدیرای علوم است %~% زو زنده و گوینده شده‌است این تن مردار(@)(@@) 18 شرم و سخن و مدح و نکوهش همه او راست %~% تن را چو شد او هیچ نه قدر است و نه مقدار(@)(@@) 19 سالار تن توست چرا تنت گرامی است %~% نزدیک تو و مهتر و سالار تنت خوار(@)(@@) 20 زیرا که چو معروف شد این بنده سوی تو %~% مجهول بمانده‌است ز بس جهل تو سالار(@)(@@) 21 بشناس هم این را و هم آن را به حقیقت %~% حکمت همه این است سوی مردم هشیار(@)(@@) 22 چون تو ز بهین نیمه خود غافلی ای پیر %~% گر مرد خرد مرد نخواندت میازار(@)(@@) 23 یارند تن و جانت به علم و عمل اندر %~% تو غافلی از کار بهین یار و مهین یار(@)(@@) 24 دار تن پیدای تو این عالم پیداست %~% جان را که نهان است نهان است چنو دار(@)(@@) 25 جان تو غریب است و تنت شهری ازین است %~% از محنت شهریت غریب تو به آزار(@)(@@) 26 ناداشته و خوار بماند از تو غریبت %~% بد داشت غریبان نبود سیرت احرار(@)(@@) 27 چون داری نیکوش چو خود می‌نشناسیش %~% بشناس نخستینش پس آنگاه نکودار(@)(@@) 28 خوار است خور شهریت از 
ms204	 تن سوی مهمانت %~% شهریت علف‌خوار است مهمانت سخن‌خوار(@)(@@) 29 حق تن شهری به علف چند گزاری %~% گه گه به سخن نیز حق مهمان بگزار(@)(@@) 30 زشت است که صد سال دو تن پیش تو باشد %~% هموار یکی سیر و یکی گرسنه زار(@)(@@) 31 جان تو برهنه‌است و تنت زیر خز و بز %~% عار است ازین چونکه نپرهیزی از این عار(@)(@@) 32 جان جامه نپوشد مگر از بافته حکمت %~% مر حکمت را معنی پودست و سخن تار(@)(@@) 33 نه هر سخنی حکمت باشد بر نام چو مردم %~% دینار بود هر که بود نامش دینار(@)(@@) 34 گر کار به نامستی از دوستی عمر %~% فرزند تو را نام عمر بودی و عمار(@)(@@) 35 مر حکمت را خوب حصاری است که او را %~% داناست همه بام و زمین و در و دیوار(@)(@@) 36 پیغمبر بد شهر همه علم و بر آن شهر %~% شایسته دری بود و قوی حیدر کرار(@)(@@) 37 این قول رسول است و در اخبار نبشته‌است %~% تا محشر از آن رو ز نویسنده اخبار(@)(@@) 38 از پند و ز علم آنچه برون نامد از این در %~% از علم مگو آن را وز پند مپندار(@)(@@) 39 فرق است میان دو سخن صعب فزون زانک %~% فرق است میان گل و گل خار دو صد بار(@)(@@) 40 گر حکمت نزدیک تو خوار است عجب نیست %~% خوار است گل تو سوی اشتر که خورد خار(@)(@@) 41 دادمت نشانی به سوی خانه حکمت %~% سر است نهان دارش از مرد سبکسار(@)(@@) 42 گر سوی در آئی و بدین خانه در آئی %~% بیرون شوی از قافله دیو ستمگار(@)(@@) 43 واگاه شوی کاین فلک از بهر چه کردند %~% واخر چه پدید آید از این گشتن هموار(@)(@@) 44 اینجات درون جز که بدین کار نیاورد %~% سازنده گنبد تو چه بگریزی از این کار(@)(@@) 45 فربی بکن و سیر بدین حکمت جان را %~% تا ناید از این بند برون لاغر و ناهار 
ms205	(@)(@@) 46 چیزی که بجوئیش نه از جایگه خویش %~% بر مردم دشوار شود کار نه دشوار(@)(@@) 47 بپذیر نصیحت به طلب حکمت دین را %~% ای غدر پذیرفته از این گنبد غدار(@)(@@) 48 خامش منشین زیر فلک و ایمن ازیراک %~% دریاست فلک بنگر دریای نگونسار(@)(@@) 49 ابلیس لعین دست گشاده‌است به غارت %~% ایزدت بدین سختی ازین بست در این غار(@)(@@) 50 تو قیمت این روز ندانی مگر آنگاه %~% کائی به یکی بتر از این روز گرفتار(@)(@@) 51 بازار تو است این به طلب هر چه ببایدت %~% بی‌توشه مرو باز تهی خانه ز بازار(@)(@@) 52 زیرا که به بازار نیابی ره ازین پس %~% آنگاه که بیمار بمانی و به تیمار(@)(@@) 53 بر گفته من کار کن ای خواجه ازیراک %~% کردار ببایدت براندازه گفتار PageV1P107(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای خردمند و هنر پیشه و بیدار و بصیر %~% کیست از خلق به نزدیک تو هشیار و خطیر(@)(@@) 2 گر خطیر آن بودی که‌ش دل و بازوی قوی است %~% شیر بایستی بر خلق جهان جمله امیر(@)(@@) 3 ور به مال اندر بودی هنر و فضل و خطر %~% کوه شغنان ملکی بودی بیدار و بصیر(@)(@@) 4 ور به خوبی در بودی خطر و بخت بلند %~% سرو سالار جهان بودی خورشید منیر(@)(@@) 5 نه بزرگ است که از مال فزون دارد بهر %~% آن بزرگ است که از علم فزون دارد تیر(@)(@@) 6 ای شده مغفر چون قیر تو بردست طمع %~% شسته بر درگه بهمان و فلان میر چو شیر(@)(@@) 7 مال در گنج شهان یابی و در خاطر من %~% هر چه یک مال خطیر است دگر مال حقیر(@)(@@) 8 شیر بر مغفر چون قیر تو ای غافل مرد %~% روز چون شیر همی ریزد و شب‌های چو قیر(@)(@@) 9 آن نه مال است که چو دادیش از تو بشود %~% زو ستاننده غنی گردد و بخشنده فقیر(@)(@@) 10 آن بود مال که گر زو بدهی کم نشود %~% به ترازوی خرد سخته 
ms206	 و بر دست ضمیر(@)(@@) 11 مال من گر تو اسیر افتی آزاد کندت %~% مال شاهانت گرفت از پس آزادی اسیر(@)(@@) 12 نیست چون مال من اموال شهان جز که به نام %~% چون به تخم است چو نرگس نه به بوی خوش سیر(@)(@@) 13 نشود غره خردمند بدان ک «ز پس من %~% چون پس میر نیاید نه تگین و نه بشیر»(@)(@@) 14 قیمت و عزت کافور شکسته نشده‌است %~% گر ز کافور به آمد به سوی موش پنیر(@)(@@) 15 خطر خیر بود بر قدر منفعتش %~% گر خطیر است خطیر است ازو نفع پذیر(@)(@@) 16 همچنان چون نرسد بر شرف مردم خر %~% نرسد بر خطر گندم پر مایه شعیر(@)(@@) 17 زانکه خیرات تو از فرد قدیر است همه %~% بر تو اقرار فریضه است بدان فرد قدیر(@)(@@) 18 خطری را خطری داند مقدار و خطر %~% نیست آگاه زمقدار شهان گاه و سریر(@)(@@) 19 کور کی داند از روز شب تار هگرز %~% کر بنشناسد آوای خر از ناله زیر(@)(@@) 20 نه هر آن چیز که او زرد بود زر بود %~% نشود زر اگر چند شود زرد زریر(@)(@@) 21 کرم بسیار ولیکنت یکی کرم کند %~% حاصل از برگ شجر مایه دیبا و حریر(@)(@@) 22 مردمان آهن بسیار بسودند ولیک %~% جز به داوود نگشت آهن و پولاد خمیر(@)(@@) 23 دود ماننده ابر است ز دیدار ولیک %~% نبود دود لطیف و خنک و تر و مطیر(@)(@@) 24 شرف خویش نیاورد ونیاردت پدید %~% تا نبوئیش اگر چند ببینیش عبیر(@)(@@) 25 شرف خیر به هنگام پدید آید ازو %~% چون پدید آمد تشریف علی روز غدیر(@)(@@) 26 بر سر خلق مرو را چو وصی کرد نبی %~% این به اندوه در افتاد ازو وان به زحیر(@)(@@) 27 حسد آمد همگان را زچنان کار و ازو %~% برمیدند و رمیده شود از شیر حمیر(@)(@@) 28 او سزا بد که وصی بود نبی را در خلق %~% که برادرش بدو بن عم و داماد و وزیر 
ms207	(@)(@@) 29 پشت احکام قران بود به شمشیر خدای %~% بهتر از تیغ سخن را نبود هیچ ظهیر(@)(@@) 30 کی شناسی بجز او را پدر نسل رسول %~% کی شناسی بجز او قاسم جنات وسعیر(@)(@@) 31 بی‌نظیر و ملی آن بود در امت که نبود %~% مر نبی را بجز او روز مواخات نظیر(@)(@@) 32 بی نظیر و ملی آن بود که گشتند به قهر %~% عمرو و عنتر به سر تیغش خاسی و حسیر(@)(@@) 33 ذوالفقار ایزد سوی که فرستاد به بدر %~% زن و فرزند که را بود چو زهرا و شبیر(@)(@@) 34 بر سر لشکر کفار به هنگام نبرد %~% چشم تقدیر به شمشیر علی بود قریر(@)(@@) 35 روز صفین و به خندق به سوی ثغر جحیم %~% عاصی و طاغی را تیغ علی بود مشیر(@)(@@) 36 نه به مردی زد گر یاران او بود فزون %~% شرف نسبت و جود و شرف علم مگیر(@)(@@) 37 ای که بر خیره همی دعوی بیهوده کنی %~% که «فلان بوده‌است از یاران دیرینه و پیر»(@)(@@) 38 شرف مرد به علم است شرف نیست به سال %~% چه درائی سخن یافه همی خیره بخیر(@)(@@) 39 چونکه پیری نفرستاد خداوند رسول %~% یا از این حال نبود ایزد دادار خبیر(@)(@@) 40 جز که پیر تو نبودی به سوی خلق رسول %~% گر به‌سوی تو فگنده‌ستی یزدان تدبیر(@)(@@) 41 یافت احمد به چهل سال مکانی که نیافت %~% به نود سال براهیم ازان عشر عشیر(@)(@@) 42 علی آن یافت ز تشریف که زو روز غدیر %~% شد چو خورشید درفشنده در آفاق شهیر(@)(@@) 43 گر به نزد تو به پیری است بزرگی سوی من %~% جز علی نیست بنایت نه حکیم و نه کبیر(@)(@@) 44 با علی یاران بودند بلی پیر ولیک %~% به میان دو سخن گستر فرق است کثیر(@)(@@) 45 به یکی لفظ رسانید بلی جمله کتاب %~% از خداوند پیمبر به کبیر و به صغیر(@)(@@) 46 لیکن از نامه همه مغز به خواننده رسد %~% ور چه هر 
ms208	 دو بپساورش دبیر و نه دبیر(@)(@@) 47 جز که حیدر همگان از خط مسطور خدا %~% با بصرهای پر از نور بماندند ضریر(@)(@@) 48 از سخن چیز نیابد بجز آواز ستور %~% مردم است آنکه بدانست سرود از تکبیر(@)(@@) 49 معنی از قول علی دارد و آواز جز او %~% مرد باید که ز تقصیر بداند توفیر(@)(@@) 50 تو به آواز چرا می رمی از شیر خدا %~% چون پی‌شیر نگیری و نباشی نخچیر PageV1P108(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای یار سرود و آب انگور %~% نه یار منی به حق والطور(@)(@@) 2 معزول شده است جان ز هرچه %~% داده است بر آنت دهر منشور(@)(@@) 3 می گوی محال ز آنکه خفته %~% باشد به محال و هزل معذور(@)(@@) 4 نگشاید نیز چشم و گوشم %~% رنگ قدح و ترنگ طنبور(@)(@@) 5 پرنده زمان همی خوردمان %~% انگور شدیم و دهر زنبور(@)(@@) 6 پخته شدم و چو گشت پخته %~% زنبور سزاتر است به انگور(@)(@@) 7 تیره است و مناره می‌نبیند %~% آن چشم که موی دیدی از دور(@)(@@) 8 بسترد نگار دست ایام %~% زین خانه پرنگار معمور(@)(@@) 9 در سور جهان شدم ولیکن %~% بس لاغر بازگشتم از سور(@)(@@) 10 زین سور بسی ز من بتر رفت %~% اسکندر و اردشیر و شاپور(@)(@@) 11 گر تو سوی سور می‌روی رو %~% روزت خوش باد و سعی مشکور(@)(@@) 12 دانی که چگونه گشت خواهی %~% اندر پدرت نگه کن ای پور(@)(@@) 13 اندوده رخش زمان به زر آب %~% آلوده سرش به گرد کافور(@)(@@) 14 زنهار که با زمان نکوشی %~% کاین بد خو دشمنی است منصور(@)(@@) 15 بی‌لشکر عقل و دین نگردد %~% از مرد سپاه دهر مقهور(@)(@@) 16 از علم و خرد سپر کن و خود %~% وز فضل و ادب دبوس و ساطور(@)(@@) 17 ور زی تو جهان به طاعت آید %~% زنهار بدان مباش مغرور(@)(@@) 18 زیرا که به زیر نوش و خزش %~% نیش است نهان و زهر مستور(@)(@@) 19 این ناکس را من آزمودم %~% فعلش همه 
