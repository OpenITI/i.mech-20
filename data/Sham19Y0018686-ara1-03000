ms2981	 - بالمرحلة المتوسطة - العوالي - مكة المكرمة.(@)(@@) * * *(@)(@)PageV23P002(@)(@)(@@) الكشف والبيان عن تفسير القرآن(@)(@@) [23] PageV23P003(@)(@@) جميع الحقوق محفوظة(@)(@@) رقم الإيداع بدار الكتب 15248/ 2013(@)(@)(@@) الطبعة الأولى(@)(@@) 1436 ه - 2015 م(@)(@)(@@) دار التفسير(@)(@@) جدة - المملكة العربية السعودية(@)(@@) شارع محمود نصيف - حي الأندلس(@)(@@) ص. ب: 122497 - جدة: 21332(@)(@@) تلفاكس: 6688823 - 012(@)(@)PageV23P004(@)(@)(@@)(@@)(@@) | AUTO 39 - سورة الزمر PageV23P005(@)(@@) {بسم الله الرحمن الرحيم}(@)(@)(@@) سورة الزمر(@)(@@) مكية إلا قوله تعالى {قل ياعبادي الذين أسرفوا} الآية (¬1).(@)(@@) وهي أربعة آلاف وسبعمائة وثمانية أحرف وألف ومائة واثنتان وسبعون كلمة وخمس وسبعون آية (¬2).(@)(@@) أخبرنا الأستاذ الإمام أبو إسحاق الثعلبي (¬3) رحمه الله قال:(@)(@@) [2475] نا ابن المقرئ (¬4)، قال: نا ابن مطر (¬5)، قال: نا ابن PageV23P007(@)(@@) شريك (¬1)، قال: نا ابن يونس (¬2)، قال: نا ابن سليم (¬3)، قال: نا ابن كثير (¬4)، عن زيد بن أسلم (¬5)، عن أبيه (¬6)، عن أبي أمامة (¬7)، عن أبي ابن كعب قال قال رسول الله - صلى الله عليه وسلم -: "من قرأ سورة الزمر لم يقطع الله رجاه وأعطاه ثواب الخائفين" (¬8).(@)(@@) [2476] أخبرني ابن فنجويه (¬9)، قال: نا أحمد بن حمدان (¬10)، قال: نا ابن ماهان (¬11)، قال: نا مسدد (¬12)، قال: نا حماد بن PageV23P008(@)(@@) زيد (¬1)، عن مروان أبي لبابة (¬2) مولى عبد الرحمن بن زياد عن عائشة (¬3) - رضي الله عنهما - قالت: كان رسول الله -صلى الله عليه وسلم- يقرأ كل ليلة ببني إسرائيل والزمر) (¬4).(@)(@)PageV23P009(@)(@)(@@)(@@)(@@) || AUTO 1(@)(@)(@@) - قوله عز وجل: {تنزيل الكتاب}(@)(@@) قال الفراء (¬(@)(@)(@@)(@@)(@@) || AUTO 1)(@)(@)(@@) : معناه هذا تنزيل، وإن شئت رفعته بمن، مجازه من الله تنزيل الكتاب، وإن شئت جعلته ابتداء وخبره فيما بعد {من الله العزيز الحكيم}.(@)(@)(@@)(@@)(@@) || AUTO 2(@)(@)(@@) - {إنا أنزلنا إليك الكتاب بالحق فاعبد الله مخلصا له الدين(@)(@)(@@)(@@)(@@) || AUTO (2)(@)(@)(@@) } الطاعة.(@)(@)(@@)(@@)(@@) || AUTO 3(@)(@)(@@) - {ألا لله الدين الخالص} قال قتادة: شهادة أن لا إله إلا الله (¬(@)(@)(@@)(@@)(@@) || AUTO 2)(@)(@)(@@) .(@)(@@) وقال أهل المعاني: لا يستحق الدين الخالص إلا الله عز وجل.(@)(@@) {والذين اتخذوا من دونه أولياء} يعني: الأصنام {ما نعبدهم} مجازه: قالوا: ما نعبدهم {إلا ليقربونا إلى الله زلفى} قال قتادة: وذلك أنهم كانوا إذا قيل لهم من ربكم، ومن خلقكم ومن خلق السماوات والأرض، ونزل من السماء ماء؟ قالوا: الله، 
ms2982	 فيقال لهم: فما معنى عبادتكم الأوثان، قالوا: ليقربونا إلى الله زلفى وتشفع لنا عند الله (¬(@)(@)(@@)(@@)(@@) || AUTO 3)(@)(@)(@@) . قال الكلبي: وجوابه في الأحقاف {فلولا نصرهم الذين اتخذوا من دون الله قربانا آلهة} (¬4).(@)(@)PageV23P010(@)(@)(@@) {إن الله يحكم بينهم في ما هم فيه يختلفون} من أمر الدين.(@)(@@) {إن الله لا يهدي} لدينه ومحبته {من هو كاذب كفار}.(@)(@)(@@)(@@)(@@) || AUTO 4(@)(@)(@@) - {لو أراد الله أن يتخذ ولدا} كما زعموا(@)(@@) {لاصطفى مما يخلق ما يشاء سبحانه هو الله الواحد القهار}.(@)(@)(@@)(@@)(@@) || AUTO 5(@)(@)(@@) - {خلق السماوات والأرض بالحق يكور الليل على النهار ويكور النهار على الليل}(@)(@@) قال قتادة: يعني يغشى هذا على هذا ويغشئ هذا هذا نظيره قوله تعالى: {يغشي الليل النهار} (¬1).(@)(@@) وقال المؤرج: يدخل هذا على هذا وهذا على هذا) (¬2).(@)(@@) نظيره قوله تعالى: {يولج الليل في النهار ويولج النهار في الليل} (¬3). قال مجاهد: يدهوره (¬(@)(@)(@@)(@@)(@@) || AUTO 4)(@)(@)(@@) .(@)(@@) وقال الحسن وابن حيان والكلبي: ينقص من الليل ويزيد في النهار وينقص من النهار ويزيد في الليل، فما نقص من الليل دخل في النهار وما نقص من النهار دخل في الليل (¬(@)(@)(@@)(@@)(@@) || AUTO 5)(@)(@)(@@) . ومنتهى النقصان تسع ساعات PageV23P011(@)(@@) ومنتهى الزيادة خمس عشرة ساعة (¬1). وأصل التكوير اللف والجمع ومنه كور العمامة (¬2) {وسخر الشمس والقمر كل يجري لأجل مسمى ألا هو العزيز الغفار}.(@)(@)(@@)(@@)(@@) || AUTO 6(@)(@)(@@) - {خلقكم من نفس واحدة ثم جعل منها زوجها وأنزل}(@)(@@) وأنشأ وجعل {لكم} وقال بعض أهل المعاني: جعلها لكم نزلا ورزقا لكم (¬3) {من الأنعام ثمانية أزواج} أصناف وأفراد تفسيرها في سورة الأنعام (¬4) {يخلقكم في بطون أمهاتكم خلقا من بعد خلق} نطفة ثم علقة ثم مضغة كما قال {وقد خلقكم أطوارا (14)} (¬5) قال ابن زيد (¬(@)(@)(@@)(@@)(@@) || AUTO 6)(@)(@)(@@) : معناه يخلقكم في بطون أمهاتكم من بعد الخلق الأول الذي خلقكم في ظهر آدم عليه السلام (¬7).(@)(@)PageV23P012(@)(@)(@@) {في ظلمات ثلاث} يعني البطن والرحم والمشيمة (¬1) {ذلكم الله ربكم له الملك لا إله إلا هو فأنى تصرفون} عن عبادته إلى عبادة غيره.(@)(@)(@@)(@@)(@@) || AUTO 7(@)(@)(@@) - {إن تكفروا فإن الله غني عنكم ولا يرضى لعباده الكفر}(@)(@@) فإن قيل كيف قال: {ولا يرضى لعباده الكفر} وقد 
ms2983	 كفروا! ! قلنا معناه: لا يرضى لعباده أن يكفروا به (¬2) وهذا كما يقول: لست أحب الإساءة وإني لأحب أن يسيء فلان فيعاقب.(@)(@@) وقال ابن عباس والسدي: معناه: ولا يرضى لعباده المخلصين المؤمنين الكفر وهو الذين قال {إن عبادي ليس لك عليهم سلطان} (¬3) فيكون عاما في اللفظ خاصا في المعنى كقوله {عينا يشرب بها عباد PageV23P013(@)(@@) الله} (¬1) وإنما يريد به بعض العباد دون بعض (¬2).(@)(@@) {وإن تشكروا} تؤمنوا بربكم وتطيعوه {يرضه لكم} ويثيبكم عليه {ولا تزر وازرة وزر أخرى ثم إلى ربكم مرجعكم فينبئكم بما كنتم تعملون إنه عليم بذات الصدور}.(@)(@)(@@)(@@)(@@) || AUTO 8(@)(@)(@@) - {وإذا مس الإنسان ضر دعا ربه منيبا} مخلصا {إليه} مستغيثا به(@)(@@) {ثم إذا خوله} أعطاه ومنه قيل للمال والعطاء خول وللعبيد خول قال أبو النجم:(@)(@@) أعطى فلم يبخل ولم يبخل ... كوم الذرى من خول المخول (¬3) PageV23P014(@)(@@) {نعمة منه نسي} ترك {ما كان يدعو إليه من قبل} في حال الضر {وجعل لله أندادا} يعني الأوثان (¬1).(@)(@@) وقال السدي: يعني أندادا من الرجال يطيعونهم في معاصي الله (¬2).(@)(@)(@@)(@@)(@@) || AUTO 9(@)(@)(@@) - {ليضل عن سبيله قل تمتع بكفرك قليلا إنك من أصحاب النار (8) أمن هو قانت}(@)(@@) قرأ نافع وابن كثير ويحيى والأعمش وحمزة (أمن) بتخفيف الميم.(@)(@@) وقرأ الآخرون بتشديده (¬3)، فمن شدد فله وجهان:(@)(@@) أحدهما: أن يكون الميم في (أم) صلة ويكون معنى الكلام الاستفهام وجوابه محذوف مجازه: أمن هو قانت كمن هو غير قانت كقوله: {أفمن شرح الله صدره للإسلام} (¬4) يعني كمن لم يشرح الله صدره. أو نقول: أمن هو قانت كمن جعل لله أندادا.(@)(@)PageV23P015(@)(@)(@@) والوجه الثاني: أن يكون بمعنى العطف على الاستفهام مجازه: فهذا خير أمن هو قانت، فحذف لدلالة الكلام عليه ونحوها كثير (¬1).(@)(@@) ومن خفف فله وجهان:(@)(@@) أحدها: أن يكون الألف في (أمن) بمعنى حرف النداء.(@)(@@) تقديره: يامن هو قانت، والعرب تنادي بالألف كما تنادي بيا، فتقول: يا زيد أقبل وأزيد أقبل قال أوس بن حجر (¬2):(@)(@@) أبني لبينى لستم بيد ... إلا يدا ليست لها عضد (¬3)(@)(@@) يريد يا بني لبينى.(@)(@@) وقال آخر:(@)(@@) أضمر بن ضمرة ماذا ذكرت 
ms2984	 ... من صرمة أخذت بالمرار(@)(@@) فيكون معنى الآية: قل تمتع بكفرك قليلا إنك من أصحاب النار، يا من هو قانت آناء الليل إنك من أهل الجنة، كما تقول في الكلام فلان PageV23P016(@)(@@) لا يصلي ولا يصوم، فيا من يصلي ويصوم أبشر فحذف لدلالة الكلام عليه.(@)(@@) والوجه الثاني: أن يكون الألف في (أمن) ألف استفهام ومعنى الكلام، أهذا الذي جعل لله أندادا؟ فاكتفى بما سبق إذ كان معنى الكلام مفهوما كقول الشاعر:(@)(@@) فأقسم لو شيء أتانا رسوله ... سواك ولكن لم نجد لك مدفعا (¬1)(@)(@@) أراد: لدفعناه.(@)(@@) قال ابن عمر: القنوت قراءة القرآن وطول القيام (¬2).(@)(@@) وقال ابن عباس: الطاعة (¬3).(@)(@@) {آناء الليل} ساعاته {ساجدا وقائما يحذر الآخرة}.(@)(@@) [2477] أخبرنا عبد الله بن حامد (¬4)، قال: نا محمد بن خالد (¬5) PageV23P017(@)(@@) قال: نا داود بن سليمان (¬1)، قال: نا عبد بن حميد (¬2)، قال: نا الحسن ابن موسى (¬3)، قال: نا يعقوب بن عبد الله (¬4)، عن جعفر (¬5)، عن سعيد ابن جبير (¬6) أنه كان يقرأ (أمن هو قانت آناء الليل ساجدا وقائما يحذر عذاب الآخرة) (¬7).(@)(@)PageV23P018(@)(@)(@@) {ويرجو رحمة ربه} قال مقاتل (¬1)، نزلت في عمار بن ياسر وأبي حذيفة بن المغيرة بن عبد الله المخزومي (¬2).(@)(@@) {قل هل يستوي الذين يعلمون} يعني عمارا {والذين لا يعلمون} يعني أبا حذيفة {إنما يتذكر أولو الألباب}.(@)(@@) [2478] أخبرني الحسين بن محمد بن الحسين العدل (¬3)، قال: نا هارون بن محمد بن هارون العطار (¬4)، قال: حدثنا (¬5) حازم بن يحيى الحلواني (¬6)، قال: نا محمد بن يحيى الطفيل (¬7)، قال: نا هشام بن PageV23P019(@)(@@) يوسف (¬1)، قال: حد محمد بن إبراهيم اليماني (¬2)، قال: سمعت وهب ابن منبه (¬3) يقول: سمعت ابن عباس يقول: من أحب أن يهون الله عليه الموقف يوم القيامة فليره الله في سواد الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه (¬4).(@)(@)(@@)(@@)(@@) || AUTO 10(@)(@)(@@) - {قل يا عباد الذين آمنوا اتقوا ربكم للذين أحسنوا في هذه الدنيا حسنة}(@)(@@) يعني الجنة عن مقاتل (¬5).(@)(@@) وقال السدي: يعني العافية والصحة (¬6).(@)(@@) {وأرض الله واسعة} فهاجروا واعتزلوا الأوثان قاله مجاهد (¬7).(@)(@@) وقال مقاتل: يعني أرض الجنة (¬8).(@)(@)PageV23P020(@)(@)(@@) {إنما يوفى الصابرون أجرهم بغير حساب} قال قتادة: 
ms2985	 لا والله ما هنالك مكيال ولا ميزان (¬1).(@)(@@) [2479] وأخبرني الحسين بن فنجويه (¬2) بقراءتي عليه قال: (حدثنا أحمد بن محمد بن إسحاق (¬3)، قال: أخبرني إبراهيم بن محمد بن الضحاك (¬4)، قال: حدثنا نصر بن مرزوق (¬5)، قال: حدثنا أسد بن موسى (¬6)، قال: حدثنا بكر بن خنيس (¬7)، عن ضرار بن عمرو (¬8)، PageV23P021(@)(@@) عن يزيد الرقاشي (¬1)، عن أنس بن مالك - رضي الله عنه - أن النبي - صلى الله عليه وسلم - قال) (¬2): "تنصب الموازين يوم القيامة فيؤتى بأهل الصلاة فيؤتون أجورهم بالموازين ويؤتى بأهل الصيام فيوفون أجورهم بالموازين ويؤتى بأهل الصدقة فيوفون أجورهم بالموازين ويؤتى بأهل الحج فيوفون أجورهم بالموازين ويؤتى بأهل البلاء فلا ينصب لهم ميزان ولا ينشر لهم ديوان وبصب عليهم الأجر صبا بغير حساب، قال الله عز وجل: {إنما يوفى الصابرون أجرهم بغير حساب} حتى تمنى أهل العافية في الدنيا أن أجسامهم تقرض بالمقاريض مما يذهب به أهل البلاء من الفضل" (¬3).(@)(@)PageV23P022(@)(@)(@@) [2480] وأخبرني ابن فنجويه (¬1)، قال: نا أبو علي بن حبش المقرئ (¬2)، قال: نا أبو سهل فهد بن سليمان بن فهد التستري (¬3)، قال: نا محمد بن موسى الكديمي (¬4)، قال: نا مكي بن قمير العجلي (¬5)، قال: نا جعفر بن سليمان الضبعي (¬6)، عن سعد بن طريف (¬7)، عن الأصبغ بن نباته (¬8)، قال: دخلنا مع علي بن أبي طالب - رضي الله عنه - على الحسن بن علي نعوده وهو مريض فقال له علي:(@)(@)PageV23P023(@)(@)(@@) كيف أصبحت يا ابن رسول الله. قال أصبحت بنعمة الله باريا قال: كذلك يكون إن شاء الله، ثم قال الحسن أسندوني فأسنده على عليهما السلام إلى صدره ثم قال: سمعت جدي رسول الله - صلى الله عليه وسلم - يقول: "يا بني أد الفرائض تكن من أعبد الناس وعليك بالقنوع تكن من أغنى الناس، يا بني إن في الجنة شجرة يقال لها شجرة البلوى، يؤتى بأهل البلاء فلا ينصب لهم ميزان ولا ينشر لهم ديوان يصب عليهم الأجر صبا" ثم تلا رسول الله - صلى الله عليه وسلم - هذه الآية {إنما يوفى الصابرون أجرهم بغير حساب} " (¬1).(@)(@@) [2481] وأخبرني ابن فنجويه (¬2)، قال: نا محمد 
ms2986	 بن عبد الله بن برزة (¬3)، قال: نا الحارث بن أبي أسامة (¬4)، قال: نا داود PageV23P024(@)(@@) المحبر (¬1)، قال: نا عباد بن كثير (¬2)، عن أبي الزناد (¬3)، عن الأعرج (¬4)، عن أبي هريرة - رضي الله عنه - أن النبي - صلى الله عليه وسلم - قال: "من سره أن يلحق بذوي الألباب والعقول فليصبر على الأذى والمكاره فذلك آية العقل وكمال التقوى، وآية الجهل الجزع ومن جزع صيره جزعه إلى النار وما نال الفوز في القيامة إلا الصابرون، إن الله عز وجل يقول: {إنما يوفى الصابرون أجرهم بغير حساب} وقال: {والملائكة يدخلون عليهم من كل باب (23) سلام عليكم بما صبرتم فنعم عقبى الدار (24)} (¬5) " (¬6).(@)(@)(@@)(@@)(@@) || AUTO 11(@)(@)(@@) - {قل إني أمرت أن أعبد الله مخلصا له الدين(@)(@)(@@)(@@)(@@) || AUTO (11)(@)(@)(@@) وأمرت لأن أكون أول المسلمين(@)(@)(@@)(@@)(@@) || AUTO (12)(@)(@)(@@) } من هذه الأمة.(@)(@)(@@)(@@)(@@) || AUTO 13(@)(@)(@@) - {قل إني أخاف إن عصيت ربي} فعبدت غيره {عذاب يوم عظيم}(@)(@)PageV23P025(@)(@)(@@)(@@)(@@) || CHECK 15(@)(@)(@@) وهذا حين دعي إلى دين آبائه، قاله أكثر المفسرين (¬1).(@)(@@) وقال أبو حمزة الثمالي والمسيب: هذه الآية منسوخة (¬2)، وإنما هذا قبل أن يغفر ذنب رسول الله - صلى الله عليه وسلم -.(@)(@)(@@)(@@)(@@) || AUTO 14(@)(@)(@@) - {قل الله أعبد مخلصا له ديني(@)(@)(@@)(@@)(@@) || AUTO (14)(@)(@)(@@) فاعبدوا ما شئتم من دونه}(@)(@@) أمر توبيخ وتهديد كقوله {اعملوا ما شئتم} (¬3) وقيل نسختها آية القتال (¬4).(@)(@@) {قل إن الخاسرين الذين خسروا أنفسهم وأهليهم} أزواجهم وخدمهم في الجنة {يوم القيامة ألا ذلك هو الخسران المبين} قال ابن عباس: وذلك أن الله تعالى جعل لكل إنسان منزلا في الجنة وأهلا فمن عمل بطاعة الله كان له ذلك المنزل والأهل ومن عمل بمعصية الله صيره الله إلى PageV23P026(@)(@@) النار وكان المنزل ميراثا لمن عمل بطاعة الله إلى (¬1) ما كان له قبل ذلك (¬2) وهو قول الله عز وجل {أولئك هم الوارثون (10)} (¬3).(@)(@)(@@)(@@)(@@) || AUTO 16(@)(@)(@@) - {لهم من فوقهم ظلل} أطباق وسرادقات (¬4) من النار ودخانها،(@)(@@) {ومن تحتهم ظلل} فراش ومهاد من نار وإنما سمي الأسفل ظللا لأنها ظلل لمن تحتهم، نظيرها قوله عز وجل {لهم من جهنم مهاد ومن فوقهم غواش} (¬5) وقوله {يوم يغشاهم العذاب من فوقهم ومن تحت 
ms2987	 PageV23P027(@)(@@) أرجلهم} (¬1) وقوله {أحاط بهم سرادقها} (¬2) وقوله {وظل من يحموم (43)} (¬3) وقوله {انطلقوا إلى ظل ذي ثلاث شعب (30)} (¬4).(@)(@@) {ذلك يخوف الله به عباده يا عباد فاتقون}.(@)(@)(@@)(@@)(@@) || AUTO 17(@)(@)(@@) - {والذين اجتنبوا الطاغوت} الأوثان {أن يعبدوها وأنابوا}(@)(@@) رجعوا {إلى} عبادة {الله لهم البشرى} في الحياة الدنيا بالجنة في العقبى {فبشر عباد}.(@)(@)(@@)(@@)(@@) || AUTO 18(@)(@)(@@) - {الذين يستمعون القول فيتبعون أحسنه} أرشده وأهداه إلى الجنة.(@)(@@) [2482] أخبرنا الحسين بن محمد بن عبد الله (¬5)، قال: نا أحمد ابن محمد بن إسحاق (¬6)، قال: نا إبراهيم بن محمد (¬7)، قال: نا يونس (¬8)، قال: نا ابن وهب (¬9)، قال: نا يحيى بن أيوب (¬10)، عن خالد بن يزيد (¬11)، عن عبيد الله بن زحر (¬12)، عن سعد بن PageV23P028(@)(@@) مسعود (¬1)، قال: قال أبو الدرداء (¬2) - رضي الله عنه -: لولا ثلاث ما أحببت أن أعيش يوما واحدا الظمأ بالهواجر، والسجود في جوف الليل، ومجالسة أقوام ينتقون من خير الكلام كما ينتقى أطايب الثمر (¬3).(@)(@@) وقال قتادة: أحسنه طاعة الله (¬4).(@)(@@) وقال السدي: أحسن ما يؤمرون به فيعملون به (¬5).(@)(@@) {أولئك الذين هداهم الله وأولئك هم أولو الألباب (18)} قال ابن زيد في قوله {والذين اجتنبوا الطاغوت} الآيتين حدثني أبي أن هاتين الآيتين نزلتا في ثلاثة نفر كانوا في الجاهلية يقولون: لا إله إلا الله، زيد بن عمرو وأبي ذر الغفاري وسلمان الفارسي (¬6).(@)(@)PageV23P029(@)(@)(@@)(@@)(@@) || AUTO 19(@)(@)(@@) - {أفمن حق عليه كلمة العذاب} بكفره {أفأنت تنقذ من في النار}(@)(@@) أي: من هو من أهل النار وكرر الاستفهام كما كرر (أن) في قوله {أيعدكم أنكم إذا متم وكنتم ترابا وعظاما أنكم مخرجون (35)} (¬1) ومثله كثير.(@)(@)(@@)(@@)(@@) || AUTO 20(@)(@)(@@) - {لكن الذين اتقوا ربهم لهم غرف}(@)(@@) درجات في الجنة {من فوقها غرف مبنية}.(@)(@@) [2483] أخبرنا ابن فنجويه (¬2)، قال: نا ابن شنبة (¬3)، قال: نا الفريابي (¬4)، قال: نا يحيى بن معين (¬5)، قال:(@)(@)PageV23P030(@)(@)(@@) نا معن بن عيسى (¬1)، قال: نا مالك بن أنس (¬2)، عن صفوان بن سليم (¬3)، عن عطاء بن يسار (¬4)، عن أبي سعيد الخدري - رضي الله عنه - عن رسول الله - صلى الله عليه وسلم - قال: "إن أهل الجنة ليتراءون الغرف من فوقهم كما تتراءون الكوكب الدري في 
ms2988	 الأفق من المشرق أو المغرب لتفاضل ما بينهم، فقالوا يا رسول الله تلك منازل الأنبياء لا يبلغها غيرهم، قال: بلى والذي نفسي بيده رجال آمنوا بالله وصدقوا المرسلين" (¬5).(@)(@@) {تجري من تحتها الأنهار وعد الله} نصب على المصدر {لا يخلف الله الميعاد}.(@)(@)(@@)(@@)(@@) || AUTO 21(@)(@)(@@) - {ألم تر أن الله أنزل من السماء ماء فسلكه} فأدخله (¬6) PageV23P031(@)(@@) {ينابيع} عيونا {في الأرض} قال الشعبي والضحاك: كل ماء في الأرض فمن السماء نزل إنما ينزل من السماء إلى الصحرة ثم يقسم منها العيون والركايا (¬1) {ثم يخرج به} أي بالماء {زرعا مختلفا ألوانه PageV23P032(@)(@@) ثم يهيج} ييبس (¬1) {فتراه} بعد خضرته ونضرته {مصفرا ثم يجعله حطاما} فتاتا متكسرا {إن في ذلك لذكرى لأولي الألباب}.(@)(@)(@@)(@@)(@@) || AUTO 22(@)(@)(@@) - {أفمن شرح الله} فسح الله {صدره للإسلام} للإيمان(@)(@@) {فهو على نور} بيان (¬2) {من ربه} قال قتادة: النور كتاب الله -عز وجل- منه يأخذ وإليه ينتهي (¬3). ومجاز الآية: أفمن شرح الله صدره للإسلام فهو على نور من ربه كمن أقسى قلبه.(@)(@@) [2484] أخبرنا ابن فنجويه (¬4)، قال: نا عبيد الله بن محمد بن شنبة (¬5)، قال: نا أبو جعفر محمد بن الحسن بن بدينا الموصلي (¬6) ببغداد، قال: نا أبو فروة واسمه يزيد بن محمد (¬7)، قال: حدثني أبي (¬8)، PageV23P033(@)(@@) عن أبيه (¬1)، قال: نا زيد بن أبي أنيسة (¬2)، عن عمرو بن مرة (¬3)، عن عبد الله بن الحارث (¬4)، عن عبد الله بن مسعود -رضي الله عنه- قال: (تلا رسول الله -صلى الله عليه وسلم- {أفمن شرح الله صدره للإسلام فهو على نور من ربه} قلنا: يا رسول الله كيف انشراح صدره؟ قال: "إذا دخل النور القلب انشرح وانفسح" قلنا: يا رسول الله فما علامة ذلك؟ قال: "الإنابة إلى دار الخلود والتجافي عن دار الغرور والتأهب للموت قبل نزول الموت" (¬5).(@)(@)PageV23P034(@)(@)(@@) . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .(@)(@)PageV23P035(@)(@)(@@) وقال الثمالي (¬1): بلغت (¬2) أنها نزلت في عمار بن ياسر (¬3).(@)(@@) وقال مقاتل: {أفمن شرح الله صدره للإسلام} يعني النبي - صلى الله عليه وسلم- (¬4).(@)(@)PageV23P036(@)(@)(@@) {فويل للقاسية قلوبهم من ذكر الله} أبو جهل وذووه من الكفار (¬1) {أولئك في ضلال مبين}.(@)(@@) [2485] أخبرنا أبو عبد الله الحسين بن محمد بن الحسين 
ms2989	 الحافظ (¬2)، قال: نا أبو أحمد القاسم بن محمد بن عبدويه السراج الصوفي (¬3)، قال: نا إبراهيم بن محمد بن يعقوب البزاز (¬4)، قال: نا الحسن بن الفضل بن السمح البصري ببغداد (¬5) قال جندل (¬6): نا (¬7) أبو مالك الواسطي الجنبي (¬8)، قال: نا أبو عبد الرحمن PageV23P037(@)(@@) السدي (¬1)، عن داود بن أبي هند (¬2)، عن أبي نضرة (¬3)، عن أبي سعيد (¬4) -رضي الله عنه- أن رسول الله -صلى الله عليه وسلم- قال: " (يقول الله -عز وجل-) (¬5): اطلبوا الحوائج من السمحاء، فإني جعلت فيهم رحمتي، ولا تطلبوها من القاسية قلوبهم؛ فإني جعلت فيهم سخطي" (¬6).(@)(@)PageV23P038(@)(@)(@@) [2486] وأخبرنا الحسين بن محمد (¬1)، قال: نا عبد الله بن إبراهيم بن علي بن عبد الله (¬2)، قال: نا (¬3) عبد الله بن محمد بن وهب (¬4)، قال: نا يوسف بن الصباح العطار (¬5)، قال: أخبرنا إبراهيم بن سليمان بن الحجاج (¬6)، قال: عمي محمد بن الحجاج (¬7)، قال: نا يونس بن ميسرة بن حلبس (¬8)، عن أبي إدريس الخولاني (¬9)، عن أبي الدرداء (¬10)، قال: قال رسول الله -صلى الله عليه وسلم-: "إن الله -عز وجل- رفيق يحب الرفق في الأمر كله ويحب كل قلب خاشع حزين رحيم يعلم الناس الخير ويدعو إلى طاعة الله -عز وجل-، ويبغض كل قلب قاس لاه ينام الليل كله فلا يذكر الله ولا يدري يرد عليه روحه أم لا" (¬11).(@)(@)PageV23P039(@)(@)(@@) [2487] وأخبرني ابن فنجويه (¬1)، قال: نا ابن نصرويه (¬2)، قال:(@)(@)PageV23P040(@)(@)(@@) نا ابن وهب (¬1)، قال: نا إبراهيم بن بسطام (¬2)، قال: نا سعيد بن عامر (¬3)، قال: نا جعفر بن سليمان (¬4)، عن مالك بن دينار (¬5)، قال: ما ضرب عبد بعقوبة أعظم من قسوة قلب، وما غضب الله على قوم إلا ونزع منهم الرحمة (¬6).(@)(@)(@@)(@@)(@@) || AUTO 23(@)(@)(@@) - {الله نزل أحسن الحديث}(@)(@@) قال ابن مسعود وابن عباس قالت الصحابة -رضي الله عنهم-: يا رسول الله لو حدثتنا فنزلت: {الله نزل أحسن الحديث} (¬7).(@)(@@) {كتابا متشابها} يشبه بعضه بعضا (في الحسن ويصدق بعضه بعضا) (¬8) ليس فيه تناقض ولا اختلاف (¬9).(@)(@)PageV23P041(@)(@)(@@) وقال قتادة: تشبه الآية الآية والكلمة الكلمة والحرف الحرف (¬1) {مثاني} جمع مثنى وهو المردد المكرر. قال المفسرون: يسمى القرآن مثاني؛ لأنه يثنى فيه 
ms2990	 الأخبار والأحكام والحدود ويثنى في التلاوة (فلا تمل) (¬2) {تقشعر} تضطرب وتشمئز وتستوفز {منه جلود الذين يخشون ربهم ثم تلين جلودهم وقلوبهم إلى ذكر الله} يعني: إلى العمل بكتاب الله والتصديق به.(@)(@@) وقيل إلى بمعنى: اللام.(@)(@@) [2488] أخبرنا الحسين بن محمد بن فنجويه (¬3)، قال: نا ابن شنبة (¬4)، قال: نا حمدان بن داود (¬5)، قال: نا سلمة بن شبيب (¬6)، قال: نا خلف بن سالم (¬7)، قال: نا هشيم (¬8)، عن حصين (¬9)، عن PageV23P042(@)(@@) عبد الله بن عروة بن الزبير (¬1) قال: قلت لجدتي أسماء بنت أبي بكر -رضي الله عنهما- كيف كان أصحاب رسول الله -صلى الله عليه وسلم- يفعلون إذا قرئ عليهم القرآن، قالت: كانوا كما نعتهم الله -عز وجل- تدمع أعينهم وتقشعر جلودهم. قال فقلت لها: إن ناسا اليوم إذا قرئ عليهم القرآن خر أحدهم مغشيا عليه؟ فقالت: أعوذ بالله من الشيطان (¬2).(@)(@@) [2489] وبه عن سلمة (¬3)، قال: نا يحيى بن يحيى (¬4)، قال: نا سعيد بن عبد الرحمن الجمحي (¬5) أن ابن عمر -رضي الله عنهما- مر برجل من أهل PageV23P043(@)(@@) العراق ساقطا فقال: ما بال هذا؟ قالوا: إنه إذا قرئ عليه القرآن أو سمع ذكر الله سقط. فقال ابن عمر: إنا لنخشى الله وما نسقط. وقال ابن عمر: إن الشيطان يدخل في جوف أحدهم، ما كان هذا صنيع أصحاب محمد -صلى الله عليه وسلم- (¬1).(@)(@@) [2490] وأخبرني الحسين بن محمد بن الحسين (¬2)، قال: نا أحمد بن جعفر بن حمدان بن عبد الله (¬3)، قال: نا إبراهيم بن الحسين بن ديزيل (¬4)، قال: نا أبو نعيم (¬5)، قال: نا حمدان بن PageV23P044(@)(@@) عبد العزيز (¬1)، قال: ذكر عند ابن سيرين (¬2) الذين يصرعون إذا قرئ عليهم القرآن فقال: بيننا وبينهم أن يقعد أحدهم على ظهر بيت باسطا رجليه، ثم يقرأ عليه القرآن من أوله إلى آخره، فإن رمى بنفسه فهو صادق (¬3).(@)(@@) [2491] وأخبرني الحسين بن محمد (¬4)، قال: نا أبو بكر بن مالك (¬5)، قال: نا عبد الله بن أحمد بن حنبل (¬6)، قال: نا صلت بن مسعود الجحدري (¬7)، قال: نا جعفر بن سليمان (¬8)، قال: نا أبو PageV23P045(@)(@@) عمران الجوني (¬1)، قال: وعظ موسى قومه فشق رجل منهم قميصه 
ms2991	 فقيل لموسى: قل لصاحب القميص لا يشق قميصه ليشرح لي عن قلبه (¬2).(@)(@@) [2492] وأخبرني الحسين بن محمد (¬3)، قال: نا عبيد الله بن عبد الله بن أبي سمرة البغوي (¬4)، قال: نا أحمد بن محمد بن أبي شيبة (¬5)، قال: نا الحسن بن سعيد (¬6) ابن عم سعدان بن نصر أبو علي قال: نا شبابة (¬7)، عن (أبي غسان المدني محمد بن مطرف) (¬8)، PageV23P046(@)(@@) عن زيد بن أسلم (¬1)، قال: قرأ أبي بن كعب عند النبي -صلى الله عليه وسلم- فرقوا، فقال رسول الله -صلى الله عليه وسلم-: "اغتنموا الدعاء عند الرقة، فإنها رحمة" (¬2).(@)(@@) [2493] وأخبرني الحسين بن محمد (¬3)، قال: نا محمد بن عبد الله بن برزة (¬4) وموسى بن محمد بن علي بن عبد الله (¬5) قالا: نا محمد بن يحيى بن سليمان المروزي (¬6)، قال: نا يحيى بن عبد الحميد الحماني (¬7).(@)(@@) [2494] قال: وحدثنا موسى بن محمد بن علي (¬8)، قال: نا محمد بن عبدوس بن كامل (¬9)، قال: نا يحيى بن عبد الحميد الحماني (¬10)، قال: نا عبد العزيز بن محمد (¬11)، عن يزيد بن عبد الله PageV23P047(@)(@@) ابن الهاد (¬1)، عن محمد بن إبراهيم التيمي (¬2)، عن أم كلثوم بنت العباس (¬3)، عن العباس بن عبد المطلب (¬4)، قال: قال رسول الله -صلى الله عليه وسلم-: "إذا اقشعر جلد العبد من خشية الله تحات عنه ذنوبه كما تحات عن الشجرة اليابسة ورقها" (¬5).(@)(@@) [2495] وأخبرني الحسين (¬6)، قال: نا أحمد بن جعفر بن حمدان (¬7)، قال: نا موسى بن إسحاق الأنصاري (¬8)، قال: نا (¬9) PageV23P048(@)(@@) محمد بن معاوية (¬1)، قال: نا الليث بن سعد (¬2)، قال: نا يزيد بن عبد الله بن الهاد (¬3)، عن محمد بن إبراهيم التيمي (¬4)، عن أم كلثوم بنت العباس (¬5)، عن أبيها (¬6)، قال: سمعت النبي -صلى الله عليه وسلم- يقول: "إذا اقشعر جلد العبد من خشية الله حرمه الله على النار" (¬7).(@)(@@) {ذلك} يعني أحسن الحديث {هدى الله يهدي به من يشاء ومن يضلل الله فما له من هاد} وفيه رد على القدرية.(@)(@)PageV23P049(@)(@)(@@)(@@)(@@) || AUTO 24(@)(@)(@@) {أفمن يتقي بوجهه سوء العذاب} أي شدته {يوم القيامة}(@)(@@) قال مجاهد: يجر على وجهه في النار (¬1).(@)(@@) وقال عطاء: يرمى به في 
ms2992	 النار منكوسا فأول شيء منه تمسه النار وجهه (¬2).(@)(@@) وقال مقاتل: هو أن الكافر يرمى به في النار مغلولة يده في عنقه، وفي عنقه صخرة ضخمة مثل الجبل العظيم من الكبريت فتشتعل النار في الحجر وهو معلق في عنقه، فحرها ووهجها على وجهه لا يطيق دفعها عن وجهه من أجل الأغلال التي في يده وعنقه (¬3). ومجاز الآية (¬4): أفمن يتقي بوجهه سوء العذاب (كمن هو آمن من العذاب وهو كقوله {أفمن يلقى في النار} الآية (¬5).(@)(@@) قال المسيب نزلت هذه) (¬6) الآية في أبي جهل (¬7).(@)(@)PageV23P050(@)(@)(@@)(@@)(@@) || CHECK 28(@)(@)(@@)(@@)(@@) || CHECK 26(@)(@)(@@) {وقيل} أي: ويقول الخزنة {للظالمين ذوقوا ما كنتم تكسبون} أي: وباله.(@)(@)(@@)(@@)(@@) || AUTO 25(@)(@)(@@) - {كذب الذين من قبلهم فأتاهم العذاب من حيث لا يشعرون(@)(@)(@@)(@@)(@@) || AUTO (25)(@)(@)(@@) فأذاقهم الله الخزي في الحياة الدنيا} العذاب والذل الذي يستحق منه في الحياة الدنيا {ولعذاب الآخرة أكبر لو كانوا يعلمون}.(@)(@)(@@)(@@)(@@) || AUTO 27(@)(@)(@@) - {ولقد ضربنا للناس في هذا القرآن من كل مثل لعلهم يتذكرون(@)(@)(@@)(@@)(@@) || AUTO (27)(@)(@)(@@) قرآنا عربيا} نصب على الحال {غير ذي عوج}(@)(@@) قال مجاهد: يعني غير ذي لبس (¬1).(@)(@@) وقال عثمان بن عفان -رضي الله عنه-: غير متضاد (¬2).(@)(@@) وقال ابن عباس -رضي الله عنهما-: غير مختلف (¬3).(@)(@@) وقال السدي: غير مخلوق (¬4).(@)(@)PageV23P051(@)(@)(@@) وقال بكر بن عبد الله المزني: غير ذي لحن (¬1).(@)(@@) {لعلهم يتقون} الكفر والتكذيب به.(@)(@)(@@)(@@)(@@) || AUTO 29(@)(@)(@@) - {ضرب الله مثلا رجلا}(@)(@@) قال الكسائي نصب (رجلا) لأنه ترجمة للمثل وتفسير له (¬2).(@)(@@) وإن شئت نصبته بنزع الخافض، مجازه ضرب الله مثلا لرجل أو في رجل.(@)(@@) {فيه شركاء متشاكسون} مختلفون متنازعون متشاحون سيئة أخلاقهم وكل واحد منهم يستخدمه بقدر نصيبه فيه، يقال: رجل شكس وشرس وضرس وضبس إذا كان سيئ الخلق مخالفا للناس (¬3).(@)(@@) وقال المورج: متشاكسون متماكسون، يقال: شاكسني فلان. أي: ماكسني (¬4).(@)(@@) {ورجلا سلما} قرأ ابن عباس ومجاهد والحسن وابن كثير وأبو عمرو ويعقوب (سالما) بالألف (¬5) واختاره أبو عبيد وقال إنما اخترناه لصحة التفسير فيه، وذلك أن السالم الخالص وهو ضد PageV23P052(@)(@@) المشترك، فأما السلم فهو ضد المحارب ولا موضع للحرب هاهنا (¬1).(@)(@@) وقرأ سعيد بن جبير (سلما) 
ms2993	 بكسر السين وسكون اللام (¬2).(@)(@@) وقرأ الآخرون {سلما} بفتح السين واللام من غير ألف (¬3)، واختاره أبو حاتم وقال: هو الذي لا ينازع فيه (¬4).(@)(@@) {هل يستويان مثلا} وهذا مثل ضربه الله -سبحانه وتعالى- للكافر الذي يعبد آلهة شتى والمؤمن الذي لا يعبد إلا الله -عز وجل- الواحد ثم قال {الحمد لله} يعني الشكر الكامل لله سبحانه دون كل معبود سواه.(@)(@@) {بل أكثرهم لا يعلمون}.(@)(@)PageV23P053(@)(@)(@@)(@@)(@@) || AUTO 30(@)(@)(@@) - {إنك} يا محمد {ميت} عن قليل {وإنهم ميتون}(@)(@@) وقرأ ابن محيصن وابن أبي عبلة: (إنك مائت وإنهم مائتون) بالألف (¬1).(@)(@@) قال الحسن والفراء والكسائي: الميت بالتشديد من لم يمت وسيموت والميت بالتخفيف الذي فارقة الروح، لذلك لم يخفف هاهنا (¬2).(@)(@@) قال قتادة: نعيت إلى رسول الله -صلى الله عليه وسلم- نفسه ونعيت إليكم أنفسكم (¬3).(@)(@@) [2496] أخبرني ابن فنجويه (¬4)، قال: نا ابن ماجه (¬5)، قال: نا الحسن بن أيوب (¬6)، قال: نا عبد الله بن أبي زياد (¬7)، قال: نا سيار PageV23P054(@)(@@) ابن حاتم (¬1)، قال: نا جعفر بن سليمان (¬2)، قال: نا ثابت (¬3)، قال: إنعى رجل إلى صلة بن أشيم (¬4) أخا له فوافقه يأكل فقال ادن فكل فقد نعي إلي أخي منذ حين قال الله -عز وجل- {إنك ميت وإنهم ميتون (30)} (¬5).(@)(@)(@@)(@@)(@@) || AUTO 31(@)(@)(@@) - {ثم إنكم يوم القيامة عند ربكم تختصمون(@)(@)(@@)(@@)(@@) || AUTO (31)(@)(@)(@@) }(@)(@@) المحق والمبطل والظالم والمظلوم.(@)(@@) [2497] أخبرني ابن فنجويه (¬6)، قال: نا ابن مالك (¬7)، قال: نا ابن حنبل (¬8)، قال: حد أبي (¬9)، قال: نا ابن نمير (¬10)، قال: نا محمد يعني ابن عمرو (¬11)، عن يحيى بن عبد الرحمن بن PageV23P055(@)(@@) حاطب (¬1)، عن عبد الله بن الزبير بن العوام (¬2)، قال: لما نزلت على رسول الله -صلى الله عليه وسلم- {ثم إنكم يوم القيامة عند ربكم تختصمون (31)} قال الزبير: (أي رسول الله أيكرر (¬3) علينا ما كان بيننا في الدنيا مع خواص الذنوب، قال: نعم ليكرر عليكم حتى يؤدى إلى كل ذي حق حقه) قال الزبير: والله إن الأمر لشديد (¬4).(@)(@@) [2498] وأخبرني الحسين بن محمد بن عبد الله (¬5)، قال: نا أحمد ابن جعفر بن حمدان بن عبد الله (¬6)، قال: نا إبراهيم بن الحسين بن PageV23P056(@)(@@) ديزيل (¬1)، قال: نا آدم بن 
ms2994	 أبي إياس (¬2)، قال: نا بن أبي ذئب (¬3)، قال: نا سعيد المقبري (¬4)، عن أبي هريرة -رضي الله عنه- قال: قال رسول الله -صلى الله عليه وسلم-: "من كانت عنده مظلمة لأخيه من ماله أو عرضه فليتحللها اليوم منه قبل أن يؤخذ حيث لا يكون دينار ولا درهم، إن كان له عمل صالح أخذ منه بقدر مظلمته، وإن لم يكن حسنات أخذ من سيئات صاحبه فحملت عليه" (¬5).(@)(@@) [2499] وأخبرني الحسين بن محمد الثقفي (¬6)، قال: نا الفضل ابن الفضل الكندي (¬7)، قال: نا أبو عبد الله محمد بن محمد بن PageV23P057(@)(@@) عبد الله بن محمد بن النعمان (¬1)، قال: نا محمد بن بكر بن أبي بكر البرجمي (¬2)، قال: نا محمد بن المنهال (¬3)، قال: نا يزيد (¬4) يعني: ابن زريع قال: نا روح بن القاسم (¬5)، عن العلاء (¬6)، عن أبيه (¬7)، عن أبي هريرة -رضي الله عنه- قال: قال رسول الله -صلى الله عليه وسلم-: "تدرون من مفلس أمتي؟ " قلنا: نعم من لا مال له. قال: "لا، مفلس أمتي من يجاء به يوم القيامة قد ضرب هذا وشتم هذا وأخذ مال هذا فيؤخذ من حسناته فيوضعن على حسنات الآخر فإن فضل عليه فضل أخذ من سيئات الآخر فطرحت عليه ثم يؤخذ فيلقى في النار" (¬8).(@)(@)PageV23P058(@)(@)(@@) وقال أبو العالية: هم أهل القبلة (¬1).(@)(@@) [2500] وأخبرني الحسين بن محمد بن الحسين بن عبد الله (¬2)، قال: نا موسى بن محمد بن علي بن عبد الله (¬3)، قال: نا الحسن بن علويه (¬4)، قال: نا عبيد بن جناد الحلبي (¬5)، قال: نا عبيد الله بن عمرو (¬6)، عن زيد بن أبي أنيسة (¬7)، عن القاسم بن عوف البكري (¬8)، قال: سمعت ابن عمر -رضي الله عنه- يقول: عشنا برهة من دهرنا ونحن نرى أن هذه الآية أنزلت فينا وفي أهل الكتابين {ثم إنكم يوم القيامة عند ربكم تختصمون (31)} قلنا: كيف نختصم ونبينا واحد وكتابنا واحد! ! حتى رأيت بعضنا يضرب وجوه بعض بالسيف فعرفت أنه فينا نزلت (¬9).(@)(@)PageV23P059(@)(@)(@@) وروى خلف بن خليفة (¬1)، عن أبي هاشم (¬2)، عن أبي سعيد الخدري -رضي الله عنه- في هذه الآية قال: كنا نقول: ربنا واحد 
ms2995	 ونبينا واحد وديننا واحد فما هذه الخصومة، فلما كان يوم صفين وشد بعضنا على بعض بالسيوف قلنا: نعم هو هذا (¬3).(@)(@@) [2501] وأخبرني الحسين بن محمد (¬4)، قال: نا عبد الله بن يوسف (¬5)، قال: نا عبد الله بن محمد بن عبد العزيز البغوي (¬6)، نا (¬7) أبو الربيع الزهراني (¬8)، قال: نا حماد بن زيد (¬9)، قال: زعم PageV23P060(@)(@@) ابن عون (¬1)، عن إبراهيم (¬2)، قال: لما نزلت {ثم إنكم يوم القيامة عند ربكم تختصمون (31)} قالوا: كيف نختصم ونحن إخوان! فلما قتل عثمان -رضي الله عنه- قالوا: هذه خصومتنا (¬3).(@)(@)(@@)(@@)(@@) || AUTO 32(@)(@)(@@) - {فمن أظلم ممن كذب على الله} فزعم أن له ولدا وشريكا {وكذب بالصدق} بالقرآن.(@)(@@) {إذ جاءه أليس في جهنم مثوى للكافرين}(@)(@)(@@)(@@)(@@) || AUTO 33(@)(@)(@@) - {والذي جاء بالصدق وصدق به}(@)(@@) قال السدي: والذي جاء بالصدق يعني جبريل جاء بالقرآن، وصدق به يعني محمد تلقاه بالقبول (¬4).(@)(@@) وقال ابن عباس: والذي جاء بالصدق يعني: رسول الله -صلى الله عليه وسلم- جاء بلا إله إلا الله وصدق به هو أيضا رسول الله بلغه إلى الخلق (¬5).(@)(@)PageV23P061(@)(@)(@@) وقال علي بن أبي طالب وأبو العالية والكلبي: والذي جاء بالصدق رسول الله -صلى الله عليه وسلم- وصدق به أبو بكر (¬1).(@)(@@) وقال قتادة ومقاتل: والذي جاء بالصدق رسول الله -صلى الله عليه وسلم- وصدق به المؤمنون (¬2) واستدلالا (بقوله تعالى {أولئك هم المتقون}.(@)(@@) وقال عطاء: والذي جاء بالصدق الأنبياء عليهم السلام وصدق به الأتباع (¬3)، وحينئذ يكون الذي) (¬4) بمعنى الذين على طريق الجنس (¬5) كقوله -سبحانه وتعالى- {مثلهم كمثل الذي استوقد نارا} ثم قال {ذهب الله بنورهم} (¬6) وقوله {إن الإنسان لفي خسر (2)} (¬7) ثم قال {إلا الذين آمنوا وعملوا PageV23P062(@)(@@) الصالحات} (¬1). ودليل هذا التأويل ما:(@)(@@) [2502] أخبرنا ابن فنجويه (¬2)، قال: نا طلحة بن محمد بن جعفر (¬3) وعبيد الله بن أحمد بن يعقوب (¬4) قالا: نا أبو بكر بن مجاهد (¬5)، قال: نا عبدان بن محمد المروزي (¬6)، قال: نا عمار بن الحسن (¬7)، قال: نا عبد الله بن أبي جعفر الرازي (¬8)، عن أبيه (¬9)، عن الربيع (¬10) أنه كان يقرأ (والذين جاؤوا بالصدق وصدقوا به) قال: الأنبياء وصدقوا به الأتباع (¬11).(@)(@)PageV23P063(@)(@)(@@) وقال الحسن: هو المؤمن صدق به 
ms2996	 في الدنيا وجاء به يوم القيامة (¬1) يدل عليه ما:(@)(@@) [2503] أخبرنا أبو عبد الله بن فنجويه (¬2)، قال: نا أبو علي بن حبش (¬3)، قال: نا الطبراني (¬4)، قال: نا يحيى بن الفضل الخرقي (¬5)، قال: نا وهيب بن عمرو (¬6)، قال: نا هارون النحوي (¬7)، عن محمد بن جحادة (¬8)، عن أبي صالح الكوفي وهو أبو صالح السمان (¬9) أنه قرأ {والذي جاء بالصدق وصدق به} مخففة، قال: هو(@)(@)PageV23P064(@)(@)(@@)(@@)(@@) || CHECK 36(@)(@)(@@) المؤمن جاء به صادقا وصدق به (¬1).(@)(@@) وقال مجاهد: هم أهل القرآن يجيئون به يوم القيامة يقولون هذا الذي أعطيتمونا فعملنا بما فيه (¬2)، {أولئك هم المتقون}.(@)(@)(@@)(@@)(@@) || AUTO 34(@)(@)(@@) - {لهم ما يشاءون عند ربهم ذلك جزاء المحسنين(@)(@)(@@)(@@)(@@) || AUTO (34)(@)(@)(@@) ليكفر الله عنهم أسوأ الذي عملوا ويجزيهم أجرهم بأحسن الذي كانوا يعملون(@)(@)(@@)(@@)(@@) || AUTO (35)(@)(@)(@@) أليس الله بكاف عبده}(@)(@@) وقرأ أبو جعفر ويحيى والأعمش وحمزة وخلف (عباده). وقرأ الباقون {عبده} (¬3) يعنون محمدا -عليه السلام-.(@)(@@) {ويخوفونك بالذين من دونه} وذلك أنهم خوفوا النبي -صلى الله عليه وسلم- معرة (¬4)(@)(@)PageV23P065(@)(@)(@@)(@@)(@@) || CHECK 38(@)(@)(@@) الأوثان قالوا: إنك تعيب آلهتنا وتذكرها بسوء فوالله لتكفن عن ذكرها أو لتخبلنك أو تصيبنك (بسوء) (¬1) {ومن يضلل الله فما له من هاد}.(@)(@)(@@)(@@)(@@) || AUTO 37(@)(@)(@@) - {ومن يهد الله فما له من مضل أليس الله بعزيز ذي انتقام(@)(@)(@@)(@@)(@@) || AUTO (37)(@)(@)(@@) ولئن سألتهم من خلق السماوات والأرض ليقولن الله قل أفرأيتم ما تدعون من دون الله إن أرادني الله بضر} شدة وبلاء {هل هن كاشفات ضره أو أرادني برحمة}(@)(@@) نعمة ورخاء {هل هن ممسكات رحمته}(@)(@@) قرأ شيبة وأبو عمرو ويعقوب بالتنوين (¬2)، واختاره أبو عبيد وأبو حاتم (¬3)، وقرأ الباقون بالإضافة (¬4).(@)(@@) وقال مقاتل: فسألهم النبي -صلى الله عليه وسلم- فسكتوا، فأنزل الله تعالى {قل حسبي الله عليه يتوكل المتوكلون} (¬5).(@)(@)PageV23P066(@)(@)(@@)(@@)(@@) || AUTO 39(@)(@)(@@) - {قل ياقوم اعملوا على مكانتكم إني عامل فسوف تعلمون}(@)(@@) إذا جاءكم بأس الله من المحق منا والمبطل.(@)(@)(@@)(@@)(@@) || AUTO 40(@)(@)(@@) - {من يأتيه عذاب يخزيه ويحل عليه عذاب مقيم(@)(@)(@@)(@@)(@@) || AUTO (40)(@)(@)(@@) إنا أنزلنا عليك الكتاب للناس بالحق فمن اهتدى فلنفسه ومن ضل فإنما يضل عليها وما أنت عليهم بوكيل(@)(@)(@@)(@@)(@@) || AUTO (41)(@)(@)(@@) }(@)(@@) بحفيظ ورقيب (¬1)، وقيل: 
ms2997	 موكل عليهم في حملهم على الإيمان.(@)(@)(@@)(@@)(@@) || AUTO 42(@)(@)(@@) - {الله يتوفى الأنفس حين موتها} فيقبضها عند فناء أكلها (¬2)(@)(@@) وانقضاء أجلها {والتي لم تمت} يعني ويتوفى أيضا التي لم تمت {في منامها} كما توفي التي ماتت، فجعل النوم موتا {فيمسك التي قضى عليها الموت} عنده، قرأ يحيى والأعمش وحمزة والكسائي وخلف (قضي) بضم القاف وكسر الضاد وفتح الياء (الموت) برفع التاء على مذهب ما لم يسم فاعله (¬3).(@)(@)PageV23P067(@)(@)(@@) وقرأ الباقون بفتحها (¬1) واختاره أبو حاتم وأبو عبيد (¬2)، قال: لقوله تعالى {الله يتوفى الأنفس حين موتها} فهو يقضي عليها.(@)(@@) قال مفسرون: إن أرواح الأحياء والأموات تلتقي في المنام فيتعارف ما شاء الله منها فإذا أراد جميعها الرجوع إلى أجسادها أمسك الله أرواح الأموات عنده وحبسها، وأرسل أرواح الأحياء حتى ترجع إلى أجسادها (¬3).(@)(@@) {ويرسل الأخرى إلى أجل مسمى} وقت انقضاء مدة حياتها {إن في ذلك لآيات لقوم يتفكرون}.(@)(@@) [2504] أخبرنا عبد الله بن حامد الأصفهاني (¬4)، قال: نا محمد ابن جعفر المطيري (¬5)، قال: نا علي بن حرب الموصلي (¬6) قال نا ابن فضيل (¬7)، قال: نا عطاء (¬8)، عن سعيد بن جبير (¬9) في قوله -عز وجل- {الله PageV23P068(@)(@@) يتوفى الأنفس حين موتها} قال: يقبض أنفس الأموات والأحياء فيمسك أنفس الأموات ويرسل أنفس الأحياء إلى أجل مسمى لا يغلط (¬1).(@)(@@) وقال ابن عباس: في ابن آدم نفس وروح بينهما مثل شعاع الشمس، فالنفس التي بها العقل والتمييز والروح التي بها النفس والتحرك، فإذا نام العبد قبض الله نفسه ولم يقبض روحه (¬2).(@)(@@) [2505] أخبرني الحسين بن محمد بن الحسين الثقفي (¬3)، قال: نا PageV23P069(@)(@@) الفضل بن الفضل الكندي (¬1)، قال: نا إبراهيم بن سعيد بن معدان (¬2)، قال: نا ابن كاسب (¬3)، قال: نا عبد الله بن رجاء (¬4)، عن عبيد الله (¬5)، عن سعيد (¬6)، عن أبي هريرة -رضي الله عنه- أن النبي -صلى الله عليه وسلم- قال: "إذا أوى أحدكم إلى فراشه فليضطجع على شقه الأيمن وليقل: باسمك اللهم وضعت جنبي وبك أرفعه، إن أمسكت نفسي فاغفر لها، وإن أرسلتها فاحفظها بما تحفظ به عبادك الصالحين" (¬7).(@)(@)(@@)(@@)(@@) || AUTO 43(@)(@)(@@) - {أم اتخذوا من دون الله شفعاء قل 
ms2998	 أولو كانوا لا يملكون شيئا ولا يعقلون(@)(@)(@@)(@@)(@@) || AUTO (43)(@)(@)(@@) }(@)(@)(@@)(@@)(@@) || AUTO 44(@)(@)(@@) - {قل لله الشفاعة جميعا} فمن يشفع فبإذنه يشفع (¬8).(@)(@)PageV23P070(@)(@)(@@) {له ملك السماوات والأرض ثم إليه ترجعون}.(@)(@)(@@)(@@)(@@) || AUTO 45(@)(@)(@@) - قوله {وإذا ذكر الله وحده اشمأزت قلوب الذين لا يؤمنون بالآخرة}(@)(@@) قال ابن عباس ومجاهد ومقاتل: انقبضت (¬1).(@)(@@) وقال قتادة (¬2): كفرت واستكبرت (¬3).(@)(@@) وقال الضحاك: نفرت (¬4).(@)(@@) وقال الكسائي: امتعضت (¬5).(@)(@@) وقال المؤرج: أنكرت (¬6).(@)(@@) وأصل الاشمئزاز النفور والازورار (¬7).(@)(@@) قال عمرو بن كثلوم:(@)(@@) إذا عض الثقاف بها اشمأزت ... وولته عشوزنة زبونا (¬8) PageV23P071(@)(@@) {وإذا ذكر الذين من دونه} يعني الأوثان وذلك حين ألقى الشيطان في أمنية (¬1) رسول الله -صلى الله عليه وسلم- عند قراءة سورة النجم: تلك الغرانيق العلى منها الشفاعة ترتجى (¬2). {إذا هم يستبشرون} يفرحون.(@)(@)(@@)(@@)(@@) || AUTO 46(@)(@)(@@) - {قل اللهم فاطر السماوات والأرض عالم الغيب والشهادة أنت تحكم بين عبادك في ما كانوا فيه يختلفون(@)(@)(@@)(@@)(@@) || AUTO (46)(@)(@)(@@) }.(@)(@@) [2506] أخبرني الحسين بن محمد بن فنجويه (¬3)، قال: نا أحمد ابن إبراهيم بن شاذان (¬4)، قال: عبيد الله بن ثابت (¬5)، قال: نا أبو سعيد الكندي (¬6)، قال: نا ابن فضيل (¬7)، عن سالم بن أبي PageV23P072(@)(@@) حفصة (¬1)، عن منذر الثوري (¬2)، قال: كنت عند الربيع بن خثيم (¬3) فدخل عليه رجل ممن شهد قتل الحسين (¬4) ممن كان يقاتله فقال: جئتم بها معلقيها. يعني الرؤوس، ثم أدخل يده في حنكه تحت لسانه فقال: والله لقد قتلتم صفوة لو أدركهم رسول الله -صلى الله عليه وسلم- لقبل أمواتهم وأجلسهم في حجره ثم قرأ {قل اللهم فاطر السماوات والأرض عالم الغيب والشهادة أنت تحكم بين عبادك في ما كانوا فيه يختلفون (46)} (¬5).(@)(@)(@@)(@@)(@@) || AUTO 47(@)(@)(@@) - قوله {ولو أن للذين ظلموا ما في الأرض جميعا ومثله معه لافتدوا به من سوء العذاب يوم القيامة}.(@)(@@) [2507] أخبرنا ابن فنجويه (¬6)، قال: نا ابن شنبة (¬7)، قال: نا ابن وهب (¬8)، قال: حد محمد بن الوليد القرشي (¬9)، قال: نا محمد بن PageV23P073(@)(@@) جعفر (¬1)، قال: نا شعبة (¬2)، عن أبي عمران ال