ms2901	 من موسى إلا أنه ليس بعدي نبي ) )(@)(@@) ( حم ق ت ه ) عن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27355 قال النبي :(@)(@@) | 30 ( يا علي ! سل الله الهدى والسداد ، واذكر بالهدى هدايتك الطريق ، وبالسداد تسديدك السهم ) )(@)(@@) ( حم ن ك ) عن علي رضي الله عنه ( ز ) .(@)(@@) PageV09P091(@)(@@)(@@)(@@) $ 27356 قال النبي :(@)(@@) | 30 ( يا علي ! لا تتبع النظرة ، فإن لك الأولى وليست لك الآخرة ) )(@)(@@) ( حم د ت ك ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27357 قال النبي :(@)(@@) | 30 ( يا علي ! لا تفتح على الإمام في الصلاة ) )(@)(@@) ( د ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27358 قال النبي :(@)(@@) | 30 ( يا علي ! لا تقع إقعاء الكلب ) )(@)(@@) ( ه ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27359 قال النبي :(@)(@@) | 30 ( يا علي ! لا يحل لأحد أن يجنب في هاذا المسجد غيري وغيرك ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27360 قال النبي :(@)(@@) | 30 ( يا ع| مر ! لا تبل قائما ) )(@)(@@) ( ه ك ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27361 قال النبي :(@)(@@) | 30 ( يا عم ! ألا أصلك ، ألا أحبوك ، ألا أنفعك ؟ تصلي يا عم أربع ركعات تقرأ في كل ركعة بفاتحة الكتاب وسورة ، فإذا انقضت القراءة فقل : الله أكبر والحمد لله وسبحان الله ولا إلاه إلا الله خمس عشرة مرة قبل أن تركع ، ثم اركع فقلها عشرا قبل أن ترفع رأسك ، ثم ارفع رأسك فقلها عشرا قبل أن تسجد فقلها عشرا ، ثم ارفع فقلها عشرا قبل أن تقوم ، فتلك خمس وسبعون في كل ركعة وهي ثلاث مائة في أربع ركعات ، فلو كانت ذنوبك مثل زبد البحر أو رمل عالج غفرها الله لك ، إن لم تستطع أن تصليها في كل يوم فصلها في كل جمعة ، فإن لم تستطع فصلها في كل شهر ، فإن لم تستطع فصلها في كل سنة ) )(@)(@@) ( ت ه ) عن أبي رافع رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27362 قال النبي :(@)(@@) | 30 ( يا عوف ! احفظ خلالا ستا بين يدي الساعة PageV09P092 إحداهن موتي ، ثم فتح بيت المقدس ، ثم داء يظهر فيكم يستشهد الله به ذراريكم 
ms2902	 وأنفسكم ويزكي به أموالكم ، ثم تكون الأموال فيكم حتى يعطى الرجل مائة دينار فيظل ساخطا ، وفتنة تكون بينكم لا يبقى بيت مسلم إلا دخلته ، ثم يكون بينكم وبين بني الأصفر هدنة فيغدرون فيسيرون إليكم في ثمانين غاية تحت كل غاية اثنا عشر ألفا ) )(@)(@@) ( ه ك ) عن عوف بن مالك الأشجعي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27363 قال النبي :(@)(@@) | 30 ( يا غلام ! إني أعلمك كلمات احفظ الله يحفظك ، احفظ الله تجده تجاهك ، إذا سألك فاسأل الله ، وإذا استعنت فاستعن بالله ، واعلم أن الأمة لو اجتمعت على أن ينفعوك بشيء لم ينفعوك إلا بشيء قد كتبه الله لك ، ولو اجتمعوا على أن يضروك بشيء لم يضروك إلا بشيء قد كتبه الله عليك ، جفت الأقلام ورفعت الصحف ) )(@)(@@) ( حم ت ك ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 27364 قال النبي :(@)(@@) | 30 ( يا غلام ! سم الله ، وكل بيمينك ، وكل مما يليك ) )(@)(@@) ( ق ه ) عن عمر بن أبي سلمة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27365 قال النبي :(@)(@@) | 30 ( يا غلام ! هاذا أبوك ، وهاذه أمك ، فخذ بيد أيهما شئت ) )(@)(@@) ( أن ه ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27366 قال النبي :(@)(@@) | 30 ( يا فاطمة ! احلقي رأسه وتصدقي بزنة شعره فضة ) )(@)(@@) ( ت ك ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27367 قال النبي :(@)(@@) | 30 ( يا ف| اطمة ! ألا ترضين أن تكوني سيدة نساء المؤمنين ؟ ) )(@)(@@) ( ق ) عن فاطمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27368 قال النبي :(@)(@@) | 30 ( يا فاطمة ! أيسرك أن يقول الناس : فاطمة بنت محمد في يدها سلسلة من نار ) )(@)(@@) ( حم ن ك ) عن ثوبان رضي الله عنه ( ز ) .(@)(@@) PageV09P093(@)(@@)(@@)(@@) $ 27369 قال النبي :(@)(@@) | 30 ( يا فلان ! أيما كان أحب إليك أن تمتع به عمرك أو لا تأتي غدا إلى باب من أبواب الجنة إلا وجدته قد سبقك إليه يفتحه لك ) )(@)(@@) ( ن ) عن قرة بن إياس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27370 قال النبي :(@)(@@) | 30 ( يا فلان ! أفلا تحسن صلاتك ، ألا تنظر المصلي إذا صلى كيف يصلي ؟ فإنما يصلي لنفسه ، إني والله لأبصر 
ms2903	 من ورائي كما أبصر من بين يدي ) )(@)(@@) ( م ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27371 قال النبي :(@)(@@) | 30 ( يا قبيصة ! إن المسألة لا تحل إلا لأحد ثلاثة : رجل تحمل حمالة فتحل له المسألة حتى يصيبها ثم يمسك ، ورجل أصابته جائحة اجتاحت ماله فحلت له المسألة حتى يصيب قواما من عيش ، ورجل أصابته فاقة حتى يقول ثلاثة من ذوي الحجا من قومه : لقد أصابت فلانا فاقة فحلت له المسألة حتى يصيب قواما من عيش ثم يمسك ، فما سواهن من المسألة فسحت يأكلها صاحبها سحتا ) )(@)(@@) ( حم م د ن ) عن قبيصة بن المخارق رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27372 قال النبي :(@)(@@) | 30 ( يا معاذ ! أفتان أنت ، فلولا صليت ب { سبح اسم ربك الأعلى } ، و { الشمس وضحاها } ، و { الليل إذا يغشى } فإنه يصلي وراءك الكبير والضعيف وذو الحاجة ) )(@)(@@) ( ق د ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27373 قال النبي :(@)(@@) | 30 ( يا معاذ بن جبل ! ما من أحد يشهد أن لا إلاه إلا الله وإني رسول الله صدقا من قلبه إلا حرمه الله على النار ، قال : يا رسول الله ! أفلا أخبر به الناس فيستبشروا ؟ قال : إذن يتكلوا ) )(@)(@@) ( حم ق ) عن أنس رضي الله عنه ( ز ) .(@)(@@) PageV09P094(@)(@@)(@@)(@@) $ 27374 قال النبي :(@)(@@) | 30 ( يا م| عاذ بن جبل ! هل تدري ما حق الله على عباده ، وما حق العباد على الله ؟ فإن حق الله على العباد أن يعبدوه ولا يشركوا به شيئا ، وحق العباد على الله أن لا يعذب من لا يشرك به شيئا ) )(@)(@@) ( حم ق ت ه ) عن معاذ بن جبل رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27375 قال النبي :(@)(@@) | 30 ( يا معاذ ! لا تكن فتانا فإنه يصلي وراءك : الكبير والضعيف وذو الحاجة والمسافر ) )(@)(@@) ( د ) عن حزم بن أبي بن كعب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27376 قال النبي :(@)(@@) | 30 ( يا معاذ ! والله إني لأحبك ، أوصيك يا معاذ ! لا تدعن في دبر كل صلاة أن تقول : اللهم أعني على ذكرك وشكرك وحسن عبادتك ) )(@)(@@) ( حم د ن حب ك ) عن معاذ 
ms2904	 بن جبل رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27377 قال النبي :(@)(@@) | 30 ( يا معشر الأنصار ! ألم أجدكم ضلالا فهداكم الله بي ، وكنتم متفرقين الله بي ، وكنتم عالة فأغناكم الله بي ، أما ترضون أن يذهب الناس بالشاة والبعير وتذهبون بالنبي إلى رحالكم ، لولا الهجرة لكنت امرأ منع الأنصار ، ولو سلك الناس واديا وشعبا لسلكت وادي الأنصار وشعبها ، الأنصار شعار والناس دثار ، إنكم ستلقون بعدي أثرة فاصبروا حتى تلقوني على الحوض ) )(@)(@@) ( حم ق ) عن عبد الله بن زيد بن عاصم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27378 قال النبي :(@)(@@) | 30 ( يا معشر الأنصار ! أمسكوا عليكم أموالكم لا تعمروها ، فإنه من أعم شيئا حياته فهو له حياته وموته ) )(@)(@@) ( ن ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27379 قال النبي :(@)(@@) | 30 ( يا معشر الأنصار ! إن الله قد أثنى عليكم خيرا في PageV09P095 الطهور ، فما طهوركم ؟ قالوا : نستنجي بالماء ، قال : هو ذاك فعليكموه ) )(@)(@@) ( ه ك ) عن جابر وأبي أيوب وأنس رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ 27380 قال النبي :(@)(@@) | 30 ( يا معشر الأنصار ! ما حديث أتاني عنكم ؟ ألا ترضون أن يذهب الناس بالأموال وتذهبون برسول الله حتى تدخلوه في بيوتكم ، لو أخذت الناس شعبا وأخذت الأنصار شعبا أخذت شعب الأنصار ) )(@)(@@) ( حم ق ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27381 قال النبي :(@)(@@) | 30 ( يا معشر التجار ! إن التجار يبعثون يوم القيامة فجارا إلا اتقى الله وبر وصدق ) )(@)(@@) ( ت ه حب ك ) عن رفاعة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27382 قال النبي :(@)(@@) | 30 ( يا معشر التجار ! إن الشيطان والإثم يحضران البيع فشوبوا بيعكم بالصدقة ) )(@)(@@) ( ت ) عن قيس بن أبي غرزة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27383 قال النبي :(@)(@@) | 30 ( يا معشر التجار ! إن هاذا البيع يحضره اللغو والحلف فشوبوه بالصدقة ) )(@)(@@) ( حم د ن ه ك ) عن قيس بن أبي غرزة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27384 قال النبي :(@)(@@) | 30 ( يا معشر التجار ! إياكم والكذب ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27385 قال النبي :(@)(@@) | 30 ( يا معشر الشباب ! من استطاع منكم الباءة فليتزوج فإنه أغض للبصر ، وحصن 
ms2905	 للفرج ، ومن لم يستطع فعليه بالصوم فإنه له وجاء ) )(@)(@@) ( حم ق 4 ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27386 قال النبي :(@)(@@) | 30 ( يا معشر الفقراء ! ألا أبشركم إن فقراء المؤمنين يدخلون الجنة قبل أغنيائهم بنصف يوم خمسمائة عام ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@) PageV09P096(@)(@@)(@@)(@@) $ 27387 قال النبي :(@)(@@) | 30 ( يا معشر المسلمين ! لا صلاة لمن لا يقيم صلبه في الركوع والسجود ) )(@)(@@) ( ه ) عن علي بن شيبان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27388 قال النبي :(@)(@@) | 30 ( يا معشر المهاجرين ! خصال خمس إذا ابتليتم بهن ، وأعوذ بالله أن تدركوهن : لم تظهر الفاحشة في قوم قط حتى يعلنوا بها إلا فشا فيهم الطاعون والأوجاع التي لم تكن مضت في أسلافهم الذين مضوا ، ولم ينقصوا المكيال والميزان إلا أخذوا بالسنين ، وشدة المؤونة ، وجور السلطان عليهم ، ولم يمنعوا زكاة أموالهم إلا منعوا القطر من السماء ، ولولا البهائم لم يمطروا ، ولم ينقضوا عهد الله وعهد رسوله إلا سلط الله عليهم عدوهم من غيرهم فأخذوا بعض ما كان في أيديهم ، وما لم تحكم أئمتهم بكتاب الله عز وجل ويتحروا فيما أنزل الله إلا جعل الله بأسهم بينهم ) )(@)(@@) ( ه ك ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 27389 قال النبي :(@)(@@) | 30 ( يا معشر المهاجرين والأنصار إن من إخوانكم قوما ليس لهم مال ولا عشيرة فليضم أحدكم إليه الرجلين أو الثلاثة ) )(@)(@@) ( د ك ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27390 قال النبي :(@)(@@) | 30 ( يا معشر النساء ! تصدقن وأكثرن الاستغفار فإني رأيتكن أكثر أهل النار ، إنكن تكثرن اللعن وتكفرن العشير ، ما رأيت من ناقصات عقل ودين أغلب لذي لب منكن ، أما نقصان العقل فشهادة امرأتين تعدل شهادة رجل فهاذا نقصان العقل ، وتمكث الليالي ما تصلي ، وتفطر في رمضان فهاذا نقصان الدين ) )(@)(@@) ( م ه ) عن ابن عمر ( حم م ت ) عن أبي هريرة ، ( حم ق ) عن أبي سعيد رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ 27391 قال النبي :(@)(@@) | 30 ( يا معشر النساء ! تصدقن ولو من حليكن فإنكن أكثر PageV09P097 أهل جهنم يوم القيامة ) )(@)(@@) ( حم 
ms2906	 ت ن حب ك ) عن زينب امرأة ابن مسعود رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27392 قال النبي :(@)(@@) | 30 ( يا معشر النساء ! لا تحلين الذهب ، أما لكن في الفضة ما تحلين به ، أما إنه ليس منكن امرأة تحلى ذهبا تظهره إلا عذبت به يوم القيامة ) )(@)(@@) ( حم د ن طب ) عن خولة بنت اليمان رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27393 قال النبي :(@)(@@) | 30 ( يا معشر قريش ! اشتروا أنفسكم من الله لا أغني عنكم من الله شيئا ، يا بني عبد مناف ! اشتروا أنفسكم من الله لا أغني عنكم من الله شيئا ، يا عباس بن عبد المطلب ! لا أغني عنك من الله شيئا ، يا صفية عمة رسول الله ! لا أغني عنك من الله شيئا ، يا فاطمة بنت محمد ! سليني من مالي ما شئت لا أغني عنك من الله شيئا ) )(@)(@@) ( ق ن ) عن أبي هريرة ، ( م ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27394 قال النبي :(@)(@@) | 30 ( يا معشر قريش ! أنقذوا أنفسكم من النار ، فإني لا أملك لكم من الله ضرا ولا نفعا ، يا معشر بني عبد مناف ! أنقذوا أنفسكم من النار فإني لا أملك لكم من الله ضرا أو نفعا ، يا معشر بني عبد المطلب ! أنقذوا أنفسكم من النار فإني لا أملك لكم ضرا ولا نفعا ، يا فاطمة بنت محمد ! أنقذي نفسك من النار فإني لا أملك لك ضرا ولا نفعا ، إن لك رحما وسأبلها ببلالها ) )(@)(@@) حم ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27395 قال النبي :(@)(@@) | 30 ( يا معشر من آمن بلسانه ولم يدخل الإيمان قلبه ! لا تغتابوا المسلمين ولا تتبعوا عوراتهم ، فإنه من تتبع عورة أخيه المسلم تتبع الله عورته ، ومن تتبع الله عورته يفضحه ولو في جوف بيته ) )(@)(@@) ( حم د ) عن أبي برزة الأسلمي PageV09P098 ( 4 ) عن البراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27396 قال النبي :(@)(@@) | 30 ( يا معشر من أسلم بلسانه ولم يدخل الإيمان في قلبه ! لا تؤذوا المسلمين ولا تعيروهم ولا تتبعوا عوراتهم ، فإنه من تتبع عورة أخيه المسلم يتتبع الله عورته ، ومن 
ms2907	 تتبع الله عورته يفضحه ولو في جوف رحله ) )(@)(@@) ( ت ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 27397 قال النبي :(@)(@@) | 30 ( يا معشر يهود ! أسلموا تسلموا ، اعلموا أن الأرض لله ورسوله ، وإني أريد أن أجليكم من هاذه الأرض ، فمن وجد منكم بماله شيئا فليبعه وإلا فاعلموا أن الأرض لله ورسوله ) )(@)(@@) ( ق د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27398 قال النبي :(@)(@@) | 30 ( يا مقلب القلوب ثبت قلبي على دينك ) )(@)(@@) ( ت ك ) عن أنس ، ( ت ) عن شهاب الجرمي ، ( ك ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27399 قال النبي :(@)(@@) | 30 ( يا مقلب القلوب ثبت قلوبنا على دينك ) )(@)(@@) ( ه ك ) عن النواس بن سمعان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27400 قال النبي :(@)(@@) | 30 ( يا نساء المسلمات ! لا تحقرن جارة لجارتها ولو فرسن شاة ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ز ) .(@)(@@)(@@)(@@) $ 27401 قال النبي :(@)(@@) | 30 ( يا هذال ! لو سترته بثوبك كان خيرا لك ) )(@)(@@) ( حم د ك ) عن نعيم بن هذال رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27402 قال النبي :(@)(@@) | 30 ( يأتي أحدكم بماله لا يملك غيره فيتصدق به ثم يقعد بعد ذالك يتكفف الناس ، إنما الصدقة عن ظهر غنى ) )(@)(@@) ( د ك ) عن جابر رضي الله عنه ( ز ) .(@)(@@) PageV09P099(@)(@@)(@@)(@@) $ 27403 قال النبي :(@)(@@) | 30 ( يأتي الدجال المدينة فيجد الملائكة يحرسونها فلا يدخلها الدجال ولا الطاعون إن شاء الله تعالى ) )(@)(@@) ( حم خ ت ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27404 قال النبي :(@)(@@) | 30 ( يأتي الدجال وهو محرم عليه أن يدخل نقاب المدينة فينزل بعض السباخ التي بالمدينة فيخرج إليه يومئذ رجل هو خير الناس ، أو من خير الناس فيقول له : أشهد أنك الدجال الذي حدثنا رسول الله حديثه ، فيقول الدجال : أرأيتم إن قتلت هاذا ثم أحييته هل تشكون في الأمر ؟ فيقولون : لا ، فيقتله ثم يحييه ، فيقول حين يحييه ، والله ما كنت فيك قط أشد بصيرة من اليوم ، فيريد الدجال أن يقتله فلا يسلط عليه ) )(@)(@@) ( حم ق ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27405 قال النبي :(@)(@@) | 30 ( يأتي الشيطان 
ms2908	 أحدكم فيقول من خلق كذا ، من خلق كذا ؟ حتى يقول : من خلق ربك ؟ فإذا بلغه فليستعذ بالله ولينته ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27406 قال النبي :(@)(@@) | 30 ( يأتي القرآن وأهله الذين كانوا يعملون به في الدنيا تقدمه سورة البقرة وآل عمران يأتيان كأنهما غيابتان وبينهما شرق أو كأنهما غمامتان سوداوان ، أو كأنهما ظلتان أو كأنهما حزقان من طير صواف يجادلان عن صاحبهما ) )(@)(@@) ( حم م ت ) عن النواس بن سمعان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27407 قال النبي :(@)(@@) | 30 ( يأتي المسيح من قبل المشرق وهمته المدينة حتى ينزل دبر أحد ثم تصرف الملائكة وجهه قبل الشام ، وهنالك يهلك ) )(@)(@@) ( حم م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV09P100(@)(@@)(@@)(@@) $ 27408 قال النبي :(@)(@@) | 30 ( يأتي الناس زمان ما يبالي الرجل من أين أصاب المال من حلال أو حرام ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27409 قال النبي :(@)(@@) | 30 ( يؤتى بالرجل يوم القيامة من أهل الجنة فيقول له : يا ابن آدم ! كيف وجدت منزلك ؟ فيقول : أي رب خير منزل : فيقول : سل وتمن ، فيقول : يا رب ما أسأل ولا أتمنى إلا أن تردني إلى الدنيا فأقتل في سبيلك عشر مرار لما يرى من فضل الشهادة ، ويؤتى الرجل من أهل النار فيقول له : يا آدم ! كيف وجدت منزلك ؟ فيقول : أي رب شر منزل ، فيقول له : أتفتدي منه بطلاع الأرض ذهبا ؟ فيقول : أي رب نعم ، فيقول : كذبت ، قد سألتك أقل من ذالك وأيسر فلم تفعل ، فيرد إلى النار ) )(@)(@@) ( حم م ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27410 قال النبي :(@)(@@) | 30 ( يؤتى بالعبد يوم القيامة فيقال له : ألم أجعل لك : سمعا وبصرا ومالا وولدا ، وسخرت لك الأنعام والحرث وتركتك ترأس وتربع ، فكنت تظن أنك ملاقي يومك هاذا ، فيقول : لا ، فيقول له : اليوم أنساك كما نسيتني ) )(@)(@@) ( ت ) عن أبي هريرة وأبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27411 قال النبي :(@)(@@) | 30 ( يؤتى بالموت كأنه كبش أملح حتى يوقف على السور بين الجنة والنار ، فيقال : يا أهل 
ms2909	 الجنة فيشرئبون ، ويقال : يا أهل النار ! فيشرئبون ، فيقال : هل تعرفون هاذا ؟ فيقولون : نعم هاذا الموت ، فيضجع ويذبح ، فلولا أن الله قضى لأهل الجنة الحياة والبقاء لماتوا فرحا ، ولولا أن الله قضى لأهل النار الحياة فيها لماتوا ترحا ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27412 قال النبي :(@)(@@) | 30 ( يؤتى بالموت يوم القيامة فيوقف على الصراط ، فيقال : يا أهل الجنة ! فيطلعون خائفين وجلين أن يخرجوا من مكانهم الذي هم فيه ، PageV09P101 ثم يقال : يا أهل النار ! فيطلعون مستبشرين فرحين أن يخرجوا من مكانهم الذي هم فيه ، فيقال : هل تعرفون هاذا ؟ فيقولون : نعم هاذا الموت ، فيؤمر به فيذبح على الصراط ، ثم يقال للفريقين كلاهما خلود فيما يجدون لا موت فيها أبدا ) )(@)(@@) ( حم ه ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27413 قال النبي :(@)(@@) | 30 ( يؤتى بأنعم أهل الدنيا من أهل النار يوم القيامة فيصبغ في جهنم صبغة ، ثم يقال له : يا ابن آدم ! هل رأيت خيرا قط ، هل مر بك نعيم قط ؟ فيقول : لا والله يا رب ، ويؤتى بأشد الناس بؤسا في الدنيا من أهل الجنة ، فيصبغ في الجنة صبغة فيقال له : يا ابن آدم ! هل رأيت بؤس قط ، هل مر بك شدة قط ؟ فيقول : لا والله يا رب ما مر بي بؤس قط ، ولا رأيت شدة قط ) )(@)(@@) ( حم م ن ه ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27414 قال النبي :(@)(@@) | 30 ( يؤتى بجهنم يومئذ لها سبعون ألف زمام ، مع كل زمام سبعون ألف ملك يجرونها ) )(@)(@@) ( م ت ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27415 قال النبي :(@)(@@) | 30 ( يأتي على الناس زمان ، الصابر فيهم على دينه كالقابض على الجمر ) )(@)(@@) ( ت ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27416 قال النبي :(@)(@@) | 30 ( يأتي على الناس زمان ما يبالي الرجل من أين أصاب المال ، من حلال أو حرام ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27417 قال النبي :(@)(@@) | 30 ( يأتي على الناس زمان يدعو الرجل ابن عمه وقريبه ، هلم إلى الرخاء ، هلم إلى 
ms2910	 الرخاء ، والمدينة خير لهم لو كانوا يعلمون ، والذي نفسي بيده لا يخرج منها أحد رغبة عنها إلا أخلف الله فيها من هو خير منه ، ألا إن المدينة كالكير يخرج الخبث ، لا تقوم الساعة حتى تنفي المدينة شرارها كما ينفي الكير خبث الحديد ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV09P102(@)(@@)(@@)(@@) $ 27418 قال النبي :(@)(@@) | 30 ( يأتي على الناس زمان يغزو فئام من الناس ، فيقال : فيكم من صاحب الرسول ؟ فيقولون : نعم ، فيفتح لهم ، ثم يأتي على الناس زمان فيغزو فئام من الناس ، فيقال لهم : هل فيكم من صاحب أصحاب الرسول ؟ فيقولون : نعم ، فيفتح لهم ، ثم يأتي على الناس زمان فيغزو فئام من الناس ، فيقال لهم : هل فيكم من صاحب أصحاب الرسول ؟ فيقولون : نعم ، فيفتح لهم ) )(@)(@@) ( حم ق ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27419 قال النبي :(@)(@@) | 30 ( يأتي على الناس زمان يقومون ساعة لا يجدون إماما يصلي بهم ) )(@)(@@) ( حم ه ) عن سل امة بن الحر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27420 قال النبي :(@)(@@) | 30 ( يأتي على الناس زمان يكون المؤمن فيه أذل من شاته ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27421 قال النبي :(@)(@@) | 30 ( يأتي في آخر الزمان قوم حدثاء الأسنان ، سفهاء الأحلام ، يقولون من قول خير البرية ، يمرقون من الإسلام كما يمرق السهم من الرمية ، لا يجاوز إيمانهم حناجرهم فاقتلوهم فإن في قتلهم أجرا لمن قتلهم يوم القيامة ) )(@)(@@) ( خ د ت ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27422 قال النبي :(@)(@@) | 30 ( يأتيكم رجال من قبل المشرق يتعلمون ، فإذا جاءوكم فاستوصوا بهم خيرا ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27423 قال النبي :(@)(@@) | 30 ( يؤجر الرجل في نفقته كلها إلا في التراب ) )(@)(@@) ( ت ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ 27424 قال النبي :(@)(@@) | 30 ( يؤدي المكاتب بحصته ما أدى دية حر ، وما بقي دية PageV09P103 عبد ) )(@)(@@) ( حم ت ك ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 27425 قال النبي :(@)(@@) | 30 ( يأخذ الجبار سماواته وأرضه بيده ثم يقول : أنا الجبار ، أنا الملك أين الجبارون 
ms2911	 ؟ أين المتكبرون ؟ ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 27426 قال النبي :(@)(@@) | 30 ( يأكل أهل الجنة فيها ويشربون ، ولا يمخطون ، ولا يتغوطون ، ولا يبولون ، إنما طعامهم جشاء ، ورشح كرشح المسك ، يلهمون التسبيح والحمد كما يلهمون النفس ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27427 قال النبي :(@)(@@) | 30 ( يؤم القوم أقرؤهم لكتاب الله ، فإن كانوا في القراءة سواء فأعلمهم بالسنة ، فإن كانوا في السنة سواء فأقدمهم هجرة ، فإن كانوا في الهجرة سواء فأقدمهم سنا ، ولا يؤمن الرجل في أهله ولا في سلطانه ، ولا يقعد في بيته على تكرمته إلا بإذنه ) )(@)(@@) ( حم م 4 ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27428 قال النبي :(@)(@@) | 30 ( يؤم القوم أقرؤهم للقرآن ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 27429 قال النبي :(@)(@@) | 30 ( يا عدتي عند كربتي ، ويا صاحبي عند شدتي ، ويا ولي نعمتي ، يا إلهي وإله آبائي لا تكلني إلى نفسي فأقترب من الشر وأتباعد عن الخير ، وآنسني في قبري من وحشتي ، واجعل لي عهدا يوم القيامة مسؤولا ) )(@)(@@) ( ك ) في تاريخه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 27430 قال النبي :(@)(@@) | 30 ( يا ولي الإسلام وأهله متعني به حتى ألقاك ) )(@)(@@) PageV09P104 ( طس ) و الخطيب ، ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27431 قال النبي :(@)(@@) | 30 ( يا مالك يوم الدين ، إياك نعبد وإياك نستعين ) )(@)(@@) البغوي عن أبي طلحة رضي الله عنه قال : كنا مع رسول الله في غزوة فلقي العدو فسمعته يقول ، فذكره ابن السني في عمل يوم وليلة ، والديلمي عن أنس رضي الله عنه مثله .(@)(@@)(@@)(@@) $ 27432 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إني رأيتني البارحة على قليب أنزع ، فجئت أنت فنزعت ، وأنت ضعيف والله يغفر لك ، ثم جاء عمر فاستحالت غربا وضرب الناس بعطن ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 27433 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إن أقمت فتقدم فصل بالناس ) )(@)(@@) ( ك ) عن سهل رضي الله عنه .(@)(@@)(@@)(@@) $ 27434 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! أنت عتيق الله من النار ) )(@)(@@) ( ك 
ms2912	 ) و ابن عساكر عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27435 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! أعطاك الله ، الرضوان الأكبر ، قال : وما رضوانه الأكبر ؟ قال : إن الله يتجلى للخلق عامة ويتجلى للخلق عامة ويتجلى لك خاصة ) )(@)(@@) ابن مردويه عن أنس ( ك ) وتعقب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 27436 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! أنتظر بها القضاء ) )(@)(@@) ابن سعد عن علي ، أحمد اليشكري أن أبا بكر خطب فاطمة رضي الله عنها إلى النبي فقال له فذكره .(@)(@@)(@@)(@@) $ 27437 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إني لا أحب أن يعينني على طهوري غيري ) )(@)(@@) ابن النجار عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ 27438 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! لعانين وصديقين كلا ورب الكعبة ) )(@)(@@) الحكيم ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27439 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إن لله ملائكة تنطق على ألسنة بني آدم PageV09P105 بما في المرء من الخير والشر ) )(@)(@@) ( ك هب ) عن أنس مرسلا .(@)(@@)(@@)(@@) $ 27440 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! الدنيا تطاولت لي بعنقها ورأسها ، فقلت : إليك عني ، إليك عني ، إليك عني ، فقالت : أما إنك إن انفلت مني فلن ينفلت مني من بعدك ) )(@)(@@) ( حل ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ 27441 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إن المصيبة في الدنيا جزاء ) )(@)(@@) هناد وابن جرير عن مسلم مرسلا .(@)(@@)(@@)(@@) $ 27442 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! ألا تحب قوما بلغهم أنك تحبني فأحبوك بحبك إياي فأحبهم الله ) )(@)(@@) أبو الشيخ وأبو نعيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27443 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إن الله سماك الصديق ) )(@)(@@) الديلمي عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ 27444 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! سدد وقارب تنج ) )(@)(@@) ( حل ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ 27445 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إذا دخلتم المساجد فارتعوا فيها فإن رياض الجنة المساجد فأكثروا فيها الرتع : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، ولا حول ولا قوة إلا بالله العلي العظيم ) )(@)(@@) الديلمي عن أبي 
ms2913	 هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27446 قال النبي :(@)(@@) | 30 ( يا أبا بكر إذا رأيت الناس يسارعون في الدنيا فعليك بالآخرة ، واذكر الله عند كل حجر ومدر يذكرك إذا ذكرته ، ولا تحقرن أحدا من المسلمين فإن صغير المسلمين عند الله كبير ) )(@)(@@) السلمي والديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27447 قال النبي :(@)(@@) | 30 ( يا أبا بكر ليت أني لقيت إخواني فإني أحبهم : الذين لم يروني وصدقوني وأحبوني حتى أني لأحب إلى أحدهم من والده وولده ) )(@)(@@) PageV09P106 أبو الشيخ في الأذان والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27448 قال النبي :(@)(@@) | 30 ( يا أبا بكر الشرك أخفى فيكم من دبيب النمل ، إن من الشرك أن يقول الرجل : ما شاء الله وشئت ، ومن النداء أن يقول الرجل : لولا فلان لقتلني فلان ، أفلا أدلك على ما يذهب الله عنك صغار الشرك وكباره ؟ تقول كل يوم ثلاث مرات : اللهم إني أعوذ بك أن أشرك بك وأنا أعلم وأستغفرك لما لا أعلم ) )(@)(@@) الحكيم عن ابن جريج رضي الله عنه بلاغا .(@)(@@)(@@)(@@) $ 27449 قال النبي :(@)(@@) | 30 ( يا أبا بكر إن أفضل الناس عندي في الصحبة وذات يده ابن أبي قحافة ) )(@)(@@) ( طب ) عن معاوية ، ( طب ) وعن أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ 27450 قال النبي :(@)(@@) | 30 ( يا أبا أمامة ؛ ألا أدلك على كلمات هن خير للميت من الدنيا وما فيها وما غابت عليه الشمس وطلعت ، إذا مات أخوكم المؤمن وفرغتم من دفنه فليقم أحدكم عند قبره ثم ليقل : يا فلان بن فلان والذي نفسي بيده إنه ليستوي قاعدا ، ثم ليقل : يا فلان بن فلانة فيقول : أرشدنا إلى عندك ما يرحمك الله ، فليقل : اذكر ما خرجت عليه من الدنيا : شهادة أن لا إلاه إلا الله وأن محمدا رسول الله ، وقد كنت رضيت بالله ربا ، وبالإسلام دينا ، وبمحمد نبيا ، فيقوم منكر فيأخذ بيد نكير فيقول : قم بنا ما يقعدنا عند هاذا وقد لقن حجته ويكون الله حجيجهما دونه ، قيل : إن كنت لا أحفظ اسم أمه ؟ قال : فانسبه إلى حواء ) )(@)(@@) ابن النجار عن أبي أمامة رضي الله 
ms2914	 عنه .(@)(@@)(@@)(@@) $ 27451 قال النبي :(@)(@@) | 30 ( يا أبا أمامة ما أنا والله وامرأة سفعاء الخدين سفعاء المعصمين ، آمنت بربها ، وتحننت على ولدها إلا كهاتين ، والله أذهب فخر الجاهلية وتكبرها بآبائها ، كلكم لآدم وحواء كطف الصاع بالصاع ، وإن أكرمكم عند PageV09P107 الله أتقاكم ، فمن آتاكم ترضون دينه وأمانته فزوجوه ) )(@)(@@) ( هب ) وضعفه عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 27452 قال النبي :(@)(@@) | 30 ( يا أبا أمامة أعز أمر الله يعزك الله ) )(@)(@@) السلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 27453 قال النبي :(@)(@@) | 30 ( يا أبا أمامة أنت مني وأنا منك ) )(@)(@@) ابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 27454 قال النبي :(@)(@@) | 30 ( يا أبا أ| مام ة إن من المؤمنين من يلين له قلبي ) )(@)(@@) ( حم طب ) و تمام ، ( ض ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 27455 قال النبي :(@)(@@) | 30 ( يا أبا أيوب ألا أدلك على صدقة ترضي الله ورسوله بوضعها : تصلح بين الناس إذا تفاسدوا ، وتقرب بينهم إذا تباعدوا ) )(@)(@@) ( ط ) و عبد بن حميد ، ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ 27456 قال النبي :(@)(@@) | 30 ( يا أبا أيوب أتسمع ما أسمع ؟ أسمع أصوات اليهود يعذبون في قبورهم ) )(@)(@@) ( طب ) وهو لفظه ( حم خ م ن ) عن البراء عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ 27457 قال النبي :(@)(@@) | 30 ( يا أبا أيوب لا تعيره بالفارسية ، فلو أن الدين معلق بالثريا لنالته أبناء فارس ) )(@)(@@) الشيرازي في الألقاب عن سفينة رضي الله عنه .(@)(@@)(@@)(@@) $ 27458 قال النبي :(@)(@@) | 30 ( يا أبا أيوب إن طلاق أم أيوب لحوب ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 27459 قال النبي :(@)(@@) | 30 ( يا أبا برزة أمط الأذى عن الطريق فإن لك بذالك صدقة ) )(@)(@@) ( طب ) عن أبي برزة رضي الله عنه .(@)(@@) PageV09P108(@)(@@)(@@)(@@) $ 27460 قال النبي :(@)(@@) | 30 ( يا أبا ثعلبة مروا بالمعروف وتناهوا عن المنكر ، فإذا رأيت شحا مطاعا ، وهوى متبعا ، ودنيا مؤثرة ، ورأيت أمرا لا بد لك من طلبه فعليك نفسك ودعهم وعوامهم ، فإن وراءكم أيام الصبر ، صبر فيهن كقبض على الجمر ، للعامل فيهن أجر خمسين يعمل مثل عمله 
ms2915	 ) )(@)(@@) ( ك ) عن أبي ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ 27461 قال النبي :(@)(@@) | 30 ( يا أبا حسن أيما أحب إليك ؟ : خمسمائة شاة ورعاؤها ، أو خمس كلمات أعلمكهن تدعو بهن ؟ تقول : اللهم اغفر لي ذنبي ، وطيب لي كسبي ، ووسع لي في خلقي ، وقنعني بما قضيت لي ، ولا تذهب نفسي إلى شيء صرفته عني ) )(@)(@@) الرافعي عن سهل بن سعد عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 27462 قال النبي :(@)(@@) | 30 ( يا أبا جحيفة أقصر من جشائك ، فإن أطول الناس جوعا يوم القيامة أكثر شبعا في الدنيا ) )(@)(@@) الحكيم عن المقدام بن معدي كرب ، ( هب ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 27463 قال النبي :(@)(@@) | 30 ( يا أبا جذيم إنما الصدقة خمس ، وإلا فعشر ، وإلا فخمس عشرة ، وإلا فعشرون ، وإلا فخمس وعشرون ، وإلا فثلاثون ، وإلا فخمس وثلاثون ، فإن كثرت فأربعون ) )(@)(@@) ( حم ع ) و يعقوب بن سفيان والمنجنيقي في مسنده وابن سعد والبغوي والباوردي وابن قانع ، ( طب ض ) عن ديال بن عبيد بن حنظلة بن جذيم عن جده .(@)(@@)(@@)(@@) $ 27464 قال النبي :(@)(@@) | 30 ( يا أبا الدرداء أتمشي أمام من هو خير منك في الدنيا والآخرة ؟ ما طلعت شمس ولا غربت على أحد بعد النبيين والمرسلين أفضل من أبي بكر ) )(@)(@@) ( حل ) و ابن النجار عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 27465 قال النبي :(@)(@@) | 30 ( يا أبا الدرداء لا تخصن ليلة الجمعة بقيام دون PageV09P109 الليالي ، ولا يوم الجمعة بصيام دون الأيام ) )(@)(@@) ( حم ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 27466 قال النبي :(@)(@@) | 30 ( يا أبا الدرداء إن لجسدك عليك حقا ، ولأهلك عليك حقا ، ولربك عليك حقا ، فأعط كل ذي حق حقه : صم وأفطر ، وقم ونم وائت أهلك ) )(@)(@@) ( حل ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 27467 قال النبي :(@)(@@) | 30 ( يا أبا الدرداء أحسن جوار من جاورك تكن مؤمنا ، وأحب للناس ما تحب لنفسك تكن مسلما ، وارض بقسم الله لك تكن من أغنى الناس ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 27468 قال النبي :(@)(@@) | 30 ( يا أبا الدرداء قل : سبحان الله ، والحمد لله ، ولا 
ms2916	 إلاه إلا الله ، والله أكبر ، ولا حول ولا قوة إلا بالله إنهن الباقيات الصالحات ، وهن يحططن الخطايا كما تحط الشجرة ورقها وهي كنوز الجنة ) )(@)(@@) ابن شاهين في الترغيب في الذكر عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 27469 قال النبي :(@)(@@) | 30 ( يا أبا ذر تعوذ بالله من شر شياطين الإنس والجن ، قال : يا رسول الله وللإنس شياطين ؟ قال : نعم ، قال : يا رسول الله الصلاة ماذا هي ؟ قال : خير موضوع ، من شاء أقل ، ومن شاء أكثر ، قال : فالصوم ؟ قال : فرض مجزي ، قال : فالصدقة ؟ قال : أضعاف مضاعفة وعند الله مزيد ، قال : فأيها أفضل ؟ قال : جهد من مقل ، وسر إلى فقير ، قال : أي الأنبياء كان أول ؟ قال : آدم ، قال : أو نبي كان آدم ؟ قال : نعم نبي مكلم ، قال : كم المرسلون ؟ قال : ثلاثمائة وبضعة عشر جم غفير ، قال : يا رسول الله أي ما أنزل عليك أعظم ؟ قال : آية الكرسي ) )(@)(@@) ( ط حم ن ع ك هب ض ) عن أبي ذر ، ( حم طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 27470 قال النبي :(@)(@@) | 30 ( يا أبا ذر ألم تر إلى صاحبكم ؟ ، غفر له وأدخل PageV09P110 الجنة يعني الذي رجم ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 27471 قال النبي :(@)(@@) | 30 ( يا أبا ذر إن العبد المسلم يصلي الصلاة يريد بها وجه الله عز وجل فتتهافت عنه ذنوبه كما تهافت هاذا الورق عن هاذه الشجرة ) )(@)(@@) ( حم ) و الروياني ( ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 27472 قال النبي :(@)(@@) | 30 ( يا أبا ذر انظر إلى أرفع رجل في المسجد في عينك ، قال : فنظرت فإذا رجل عليه حلة ، قلت : هاذا ، قال : انظر إلى أوضع رجل في المسجد ، قال : فنظرت فإذا رجل عليه أخلاق ، قلت : هاذا ، قال : والذي نفسي بيده ، هاذا عند الله يوم القيامة خير من ملء الأرض مثل هاذا ) )(@)(@@) ( حم و هناد ع حب ) والروياني ، ( ك ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 27473 قال النبي :(@)(@@) | 30 ( يا أبا ذر أتدري فيما ينتطحان ؟ قال : لا ، قال : لاكن الله يدري وسيقضي بينهما 
ms2917	 يوم القيامة ) )(@)(@@) ( ط حم ) عن أبي ذر أن رسول الله رأى شاتين ينتطحان قال فذكره .(@)(@@)(@@)(@@) $ 27474 قال النبي :(@)(@@) | 30 ( يا أبا ذر إني رأيت أنني وزنت بأربعين أنت فيهم فوزنتهم ) )(@)(@@) ابن عساكر عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 27475 قال النبي :(@)(@@) | 30 ( يا أبا ذر إذا بلغ البناء سلعا فاخرج منها نحو الشام ولا أرى أمراءك إلا أن يحولوا بينك وبين ذالك ، قال : فاخذ سيفي فأضرب به ؟ قال : لا ، ولاكن تسمع وتطيع ولو لعبد حبشي ) )(@)(@@) ( ك هق ) في الدلائل و ابن عساكر عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 27476 قال النبي :(@)(@@) | 30 ( يا أبا رافع سيكون بعدي قوم يقاتلون عليا ، حق على الله جهادهم ، فمن لم يستطع جهادهم بيده فبلسانه ، فمن لم يستطع بلسانه PageV09P111 فبقلبه ، ليس وراء ذالك شيء ) )(@)(@@) ( طب ) عن محمد بن عبد الله بن أبي رافع عن أبيه عن جده .(@)(@@)(@@)(@@) $ 27477 قال النبي :(@)(@@) | 30 ( يا أبا رافع إن الصدقة حرام على محمد وعلى آل محمد ، وإن موالي القوم من أنفسهم ) )(@)(@@) ( طب هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 27478 قال النبي :(@)(@@) | 30 ( يا أبا رزين إن المسلم إذا زار أخاه المسلم شيعه سبعون ألف ملك يصلون عليه يقولون : اللهم كما وصله فيك فصله ) )(@)(@@) ( طس ) عن أبي رزين العقيلي رضي الله عنه .(@)(@@)(@@)(@@) $ 27479 قال النبي :(@)(@@) | 30 ( يا أبا سفيان أنت كما قال القائل : كل الصيد في جوف الفراء ) )(@)(@@) الديلمي عن نصر بن عاصم الليثي عن أبيه .(@)(@@)(@@)(@@) $ 27480 قال النبي :(@)(@@) | 30 ( يا أبا رافع اقتل كل كلب بالمدينة ) )(@)(@@) ( حم ) عن الفضل بن عبد الله بن أبي رافع عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ 27481 قال النبي :(@)(@@) | 30 ( يا أبا مويهبة انطلق فإني قد أمرت أن أستغفر لأهل هاذا البقيع ، السلام عليكم يا أهل البقيع ، ليهن لكم ما أصبحتم فيه مما أصبح الناس فيه لو تعلمون ما أنجاكم الله منه ، أقبلت الفتن كقطع الليل المظلم يتبع آخرها أولها ، الآخرة شر من الأولى ، يا أبا مويهبة إني قد أعطيت مفاتيح خزائن الدنيا 
ms2918	 والخلد فيها ثم الجنة ، فخيرت بين ذالك وبين لقاء ربي والجنة ، فاخترت لقاء ربي والجنة ) )(@)(@@) ( حم ) و ابن سعد والبغوي وابن منده ، ( طب ك ) وابن عساكر عن أبي مويهبة مولى رسول الله .(@)(@@)(@@)(@@) $ 27482 قال النبي :(@)(@@) | 30 ( يا أبا عبد الله هاذا جبريل يقرئك السلام ويقول : PageV09P112 أنا معك يوم القيامة حتى أذب عن وجهك شرر جهنم ) )(@)(@@) أبو بكر الشافعي في الغيلانيات وابن عساكر عن عمر رضي الله عنه قال : رأيت النبي وقد نام فجلس الزبير يذب عن وجهه حتى استيقظ قال فذكره .(@)(@@)(@@)(@@) $ 27483 قال النبي :(@)(@@) | 30 ( يا أبا الفضل ألا أبشرك ؟ لو قدمت أعطاك الله حتى ترضى قاله للعباس ) )(@)(@@) ( عد ) و ابن عساكر عن سعيد بن المسيب مرسلا .(@)(@@)(@@)(@@) $ 27484 قال النبي :(@)(@@) | 30 ( يا أبا موسى لقد أوتيت مزمارا من مزامير آل داود ) )(@)(@@) ( خ ت ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ 27485 قال النبي :(@)(@@) | 30 ( يا أبا لبابة مجزي عنك الثلث ) )(@)(@@) ( حم طب ) عن الحسين بن السائب عن أبي لبابة عن أبيه عن جده .(@)(@@)(@@)(@@) $ 27486 قال النبي :(@)(@@) | 30 ( يا أبا عبيدة لا تأمنن على أحد بعدي ) )(@)(@@) الحكيم عن أبي عبيدة بن الجراح رضي الله عنه .(@)(@@)(@@)(@@) $ 27487 قال النبي :(@)(@@) | 30 ( يا أبا فاطمة إن أردت أن تلقاني فأكثر من السجود ) )(@)(@@) ( طب ) عن أبي فاطمة رضي الله عنه .(@)(@@)(@@)(@@) $ 27488 قال النبي :(@)(@@) | 30 ( يا أبا كاهل ألا أخبرك بقضاء قضاه الله على نفسه ، أحيا الله قلبك ولا يميته حتى يموت بدنك ، اعلم يا أبا كاهل أنه لن يغضب رب العزة على من كان في قلبه مخافة ، ولا تأكل النار منه هدبة ، إنه من قلت حسناته وعظمت عنده سيئاته كان حقا على الله أن يثقل ميزانه يوم القيامة ) )(@)(@@) ( طب ) عن أبي كاهل رضي الله عنه .(@)(@@)(@@)(@@) $ 27489 قال النبي :(@)(@@) | 30 ( يا أبا كاهل ضع الطهور منك مواضعه ، وأبق فضل طهورك لأهلك لا يعطش أهلك ، ولا تشقن على خادمك ) )(@)(@@) ( عد طب ) عن أبي كاهل رضي الله عنه .(@)(@@)(@@)(@@) $ 27490 قال النبي :(@)(@@) | 30 ( يا أبا كاهل أصلح بين الناس 
ms2919	 ولو بكذا وكذا PageV09P113 يعني الكذب ) )(@)(@@) ( طب ) عن أبي كاهل رضي الله عنه .(@)(@@)(@@)(@@) $ 27491 قال النبي :(@)(@@) | 30 ( يا أبا هاشم إنها لعلك أن تدرك أموالا تقسم بين أقوام ، وإنما يكفيك من جمع المال : خادم ، ومركب في سبيل الله ) )(@)(@@) ( حم و هناد حب طب ) وابن عساكر عن أبي هاشم شيبة بن عتبة القرشي رضي الله عنه .(@)(@@)(@@)(@@) $ 27492 قال النبي :(@)(@@) | 30 ( يا أبا الهيثم إياك واللبون اذبح لنا عناقا ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 27493 قال النبي :(@)(@@) | 30 ( يا أبا الوليد ، يا عبادة بن الصامت إذا رأيت الصدقة كتمت وغلت ، واستؤجر على الغزو وأخرب العامر ، وعمر الخراب ، والرجل يتمرس بأمانته كما يتمرس البعير بالشجرة ، فإنك والساعة كهاتين ) )(@)(@@) عبد الرزاق ، ( طب ) عن عبد الله بن وهب الجندي رضي الله عنه .(@)(@@)(@@)(@@) $ 27494 قال النبي :(@)(@@) | 30 ( يا أبا يزيد إني أحبك حبين : حبا لقرابتك مني ، وحبا لما كنت أعلم من حب عمي إياك قاله لعقيل بن أبي طالب ) )(@)(@@) ابن سعد والبغوي ، ( طب ك ) وابن عساكر عن أبي إسحاق مرسلا ، ( ك ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 27495 قال النبي :(@)(@@) | 30 ( يا أبا اليقظان لن تموت حتى تقتلك الفئة الباغية عن الطريق ) )(@)(@@) ( ك ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 27496 قال النبي :(@)(@@) | 30 ( يا أبا المنذر أتدري أي آية في كتاب الله معك أعظم ؟ قال : آية الكرسي ، قال : ليهنك العلم أبا المنذر ، فوالذي نفسي بيده ، إن لها للسانا يوم القيامة وشفتين تقدس الملك عند ساق العرش ) )(@)(@@) ( ط حم ) و عبد بن حميد ، ( هب ) عن أبي بن كعب رضي الله عنه وروى صدره ( م د ك ) إلى قوله : أبا المنذر الجهني رضي الله عنه .(@)(@@) PageV09P114(@)(@@)(@@)(@@) $ 27497 قال النبي :(@)(@@) | 30 ( يا أبا المنذر إني أمرت أن أعرض عليك القرآن ، قال : يا رسول الله وذكرت هناك ؟ قال : نعم باسمك ونسبك في الملا الأعلى ) )(@)(@@) ( طب ) عن معاذ عن محمد بن معاذ بن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ 27498 قال النبي :(@)(@@) | 30 ( يا ابن حذافة لا تسمعني وسمع الله ) )(@)(@@) ابن سعد وابن 
ms2920	 نصر ، ( طب ) وابن عساكر عن الزهري عن أبي سلمة أن عبد الله بن حذافة قام يصلي فجهر بالقراءة قال فذكره ، ( حم هق ) عنه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27499 قال النبي :(@)(@@) | 30 ( يا ابن رواحة إن عجزت فلا تعجزن ، إن أسأت عشرا أن تحسن واحدة ) )(@)(@@) الواقدي وابن عساكر عن عطاء بن أبي سلمة مرسلا .(@)(@@)(@@)(@@) $ 27500 قال النبي :(@)(@@) | 30 ( يا ابن أم عبد هل تدري ما حكم الله تعالى فيمن بغى من هاذه الأمة ؟ فإن حكم الله فيهم أن لا تجهز على جريحها ، ولا يتبع مدبرها ، ولا يقتل أسيرها ، ولا يقسم فيها ) )(@)(@@) ( ك هق ) وضعفه و ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 27501 قال النبي :(@)(@@) | 30 ( يا ابن أخي لا تبيعن شيئا حتى تقبضه ) )(@)(@@) ( حم هق ) عن حكيم بن حزام رضي الله عنه .(@)(@@)(@@)(@@) $ 27502 قال النبي :(@)(@@) | 30 ( يا ابن أم عبد تدري من أفضل المؤمنين إيمانا ؟ أفضل المؤمنين إيمانا أحاسنهم أخلاقا ، الموطؤن أكنافا ، لا يبلغ عبد حقيقة الإيمان حتى يحب للناس ما يحب لنفسه ، وحتى يأمن جاره بوائقه ) )(@)(@@) ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 27503 قال النبي :(@)(@@) | 30 ( يا ابن آدم لك ما نويت ، وعليك ما اكتسبت ، ولك ما احتسبت ، وأنت مع من أحببت ، ومن مات بطريق كان من أهل ذالك الطريق ) )(@)(@@) ابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@) PageV09P115(@)(@@)(@@)(@@) $ 27504 قال النبي :(@)(@@) | 30 ( يا ا| بن مسعود إن للساعة أعلاما ، وإن للساعة أشراطا ، ألا وإن من أعلام الساعة وأشراطها أن يكون الولد غيظا ، وأن يكون المطر قيظا ، وأن تفيض الأشرار فيضا ، يا ابن مسعود إن من أعلام الساعة وأشراطها : أن يصدق الكاذب ، وأن يكذب الصادق ، يا ابن مسعود إن من أعلام الساعة وأشراطها : أن يؤتمن الخائن ، وأن يخون الأمين ، يا ابن مسعود إن من أعلام الساعة وأشراطها : أن يواصل الأطباق ، وأن تقاطع الأرحام ، يا ابن مسعود إن من أعلام الساعة وأشراطها : أن يسود كل قبيلة منافقوها ، وكل سوق فجارها ، يا ابن مسعود إن من أعلام 