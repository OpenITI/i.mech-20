ms2413	 ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22512 ) قال النبي :(@)(@@) | 30 ( من فارق الجماعة فهو في النار على وجهه لأن الله تعالى يقول : { أمن يجيب المضطر إذا دعاه ويكشف السوء ويجعلكم خلفاء في الأرض } ، فالخلافة من الله ، فإن كان خيرا فهو يذهب به ، وإن كان شرا فهو يؤخذ به ، عليك به ، ائت الطاعة فيما أمرك الله تعالى بها ) )(@)(@@) ( طب ) عن سعد بن جنادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22513 ) قال النبي :(@)(@@) | 30 ( من فارق الجماعة فاقتلوه ) )(@)(@@) الخطيب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22514 ) قال النبي :(@)(@@) | 30 ( من فارق عليا فارقني ، ومن فارقني فقد فارق الله ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22515 ) قال النبي :(@)(@@) | 30 ( من فارقك يا علي فقد فارقني ، ومن فارقني فقد PageV07P289 فارق الله ) )(@)(@@) ( ك ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22516 ) قال النبي :(@)(@@) | 30 ( من فاوض الحجر الأسود فإنما يفاوض يد الرحمان ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22517 ) قال النبي :(@)(@@) | 30 ( من فتح باب مسألة فتح الله له باب فقر في الدنيا والآخرة ، ومن فتح باب عطية ابتغاء لوجه الله أعطاه الله خير الدنيا والآخرة ) )(@)(@@) ابن جرير في تهذيبه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22518 ) قال النبي :(@)(@@) | 30 ( من فتح له باب من الخير فلينتهزه ، فإنه لا يدري متى يغلق عنه ) )(@)(@@) ابن المبارك عن حكيم بن عمير مرسلا . ابن شاهين عن عبد الله بن إبان بن عثمان بن حذيفة ، ابن أوس عن أبيه عن جده حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22519 ) قال النبي :(@)(@@) | 30 ( من فتح له من الدعاء منكم فتحت له أبواب الإجابة ) )(@)(@@) ( ش ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22520 ) قال النبي :(@)(@@) | 30 ( من فجع هاذه بولدها ، ردوا ولدها إليها يعني حمرة ) )(@)(@@) ( د ) عن عبد الرحمان بن عبد الله عن أبيه .(@)(@@)(@@)(@@) $ ( 22521 ) قال النبي :(@)(@@) | 30 ( من فرج عن أخيه المسلم كربة من كرب الدنيا ، فرج الله عنه سبعين كربة من كرب يوم القيامة ، والله في عون العبد ما كان العبد في عون أخيه ، ومن ستر 
ms2414	 على أخيه المسلم في الدنيا ستر الله عليه يوم القيامة ، فقال رجل : يا رسول الله ! من أهل الجنة ؟ قال : كل هين لين سهل قريب ) )(@)(@@) الخطيب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22522 ) قال النبي :(@)(@@) | 30 ( من فرق بين أمتي وهم جميع فاضربوا رأسه كائنا PageV07P290 من كان ) )(@)(@@) ( ش طب ) عن أسامة بن شريك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22523 ) قال النبي :(@)(@@) | 30 ( من فرج عن مؤمن كربة جعل الله له يوم القيامة شعبتين من نور على الصراط يستضيء بضوئهما عالم لا يحصيهم إلا رب العزة عز وجل ) )(@)(@@) ( ك ) في تاريخه و الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22524 ) قال النبي :(@)(@@) | 30 ( من فرق بين اثنين في مجلس تكبرا عليهما فلتبوأ مقعده من النار ) ( حل ) عن إ$ بان مرسلا .(@)(@@)(@@)(@@) $ ( 22525 ) قال النبي :(@)(@@) | 30 ( من فر من اثنين فقد فر ، ومن فر ثلاثة فلم يفر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22526 ) قال النبي :(@)(@@) | 30 ( من فسر القرآن برأيه وهو على وضوء فليعد وضوءه ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22527 ) قال النبي :(@)(@@) | 30 ( من فسا أو ضرط فليعد الوضوء ) )(@)(@@) عبد الرزاق عن علي بن سيابة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22528 ) قال النبي :(@)(@@) | 30 ( من فضل على أبي بكر وعمر وعثمان وعلي فقد رد ما قلته وما هم أهله ) )(@)(@@) الرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22529 ) قال النبي :(@)(@@) | 30 ( من فطر صائما فله مثل أجره ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22530 ) قال النبي :(@)(@@) | 30 ( من فطر صائما كان له مثل أجره إلا أنه لا ينقص من أجر الصائم شيء ، ومن جهز غازيا في سبيل الله ، أو خلفه في أهله ، كتب له مثل أجره إلا أنه لا ينقص من أجر الغازي شيء ) )(@)(@@) ( حم ) و عبد بن حميد ، PageV07P291 ( هب حق حب طب ض ) عن زيد بن خالد الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22531 ) قال النبي :(@)(@@) | 30 ( من فطر صائما ، أو جهز حاجا ، أو جهز غازيا ، أو خلفه في أهله ، فله مثل أجره من غير 
ms2415	 أن ينتقص من أجره شيء ) )(@)(@@) ابن قانع ( طب ) عن زيد بن خالد الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22532 ) قال النبي :(@)(@@) | 30 ( من فعل هاذا فليس فيه من الكبر شيء ) )(@)(@@) ( ت ) حسن غريب ، ( ك هب ض ) عن نافع بن جبير بن مطعم عن أبيه قال : يقولون لي في الشبه وقد ركبت الحمار ، ولبست الشملة ، وحلبت الشاة ، وقد قال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 22533 ) قال النبي :(@)(@@) | 30 ( من فطر صائما في رمضان على طعام وشراب من كسب حلال صلت عليه الملائكة في ساعات شهور رمضان ، وصلى عليه جبريل ليلة القدر ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22534 ) قال النبي :(@)(@@) | 30 ( من فطر صائما في رمضان من كسب حلال ، صلت عليه الملائكة ليالي رمضان كلها وصافحه جبريل ليلة القدر ، ومن صافحه جبريل تكثر دموعه ويرق قلبه ، قال رجل : يا رسول الله أرأيت من لم يكن ذاك عنده ، قال : فلقمة خير ، قال : أفرأيت من لم يكن ذاك عنده ، قال : فقبضة من طعام ، قال : أفرأيت من لم يكن ذاك عنده ، قال : فمذقة من لبن ، قال : أفرأيت من لم يكن ذاك عنده ، قال : فشربة من ماء ) )(@)(@@) ( حب ) في الضعفاء ، ( عد هب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22535 ) قال النبي :(@)(@@) | 30 ( من فطر صائما فأطعمه وسقاه ، كان له مثل أجره ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22536 ) قال النبي :(@)(@@) | 30 ( من فطر صائما كان له مثل أجره من غير أن ينقص PageV07P292 من أجره شيء ، وما عمل الصائم من أعمال البر كان لصاحب الطعام مثل أجره ما دام قوة الطعام فيه ) )(@)(@@) ابن صصرى في أماليه عن عائشة رضي الله عنه ، الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22537 ) قال النبي :(@)(@@) | 30 ( من قاتل على الخلاف فاقتلوه كائنا من كان ) )(@)(@@) الديلمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22538 ) قال النبي :(@)(@@) | 30 ( من قاتل دون ماله حتى يقتل فهو شهيد ) )(@)(@@) ( طب ) عن سعد بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22539 ) قال النبي :(@)(@@) | 30 ( من قاتل دون نفسه حتى يقتل فهو شهيد 
ms2416	 ، ومن قتل دون ماله فهو شهيد ، ومن قتل دون أهله حتى يقتل فهو شهيد ، ومن قتل في حب الله فهو شهيد ) )(@)(@@) ( عب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22540 ) قال النبي :(@)(@@) | 30 ( من قاد أعمى أربعين خطوة لم تمس وجهه النار ) )(@)(@@) ابن النجار عن نعيم بن سالم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22541 ) قال النبي :(@)(@@) | 30 ( من قاد أعمى أربعين ذراعا كان له كعتق رقبة ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22542 ) قال النبي :(@)(@@) | 30 ( من قاد أعمى أربعين ذراعا أو خمسين ذراعا كتب له عتق رقبة ) )(@)(@@) ابن منيع عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22543 ) قال النبي :(@)(@@) | 30 ( من قاد أعمى حتى يبلغه مأمنه ، غفر الله له أربعين كبيرة ، وأربع كبائر توجب النار ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22544 ) قال النبي :(@)(@@) | 30 ( من قاس حديثي برأيه فقد اتهمني ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22545 ) قال النبي :(@)(@@) | 30 ( من قال عشر مرات : لا إلاه إلا الله وحده لا شريك PageV07P293 له ، له الملك وله الحمد وهو على كل شيء قدير ، كانت له عدل أربع رقاب من ولد إسماعيل ) )(@)(@@) ( ت طب هب ) عن أبي أيوب ، ( ش ) عن ابن مسعود رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 22546 ) قال النبي :(@)(@@) | 30 ( من قال : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، ولا حول ولا قوة إلا بالله ، قال الله : أسلم عبدي واستسلم ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22547 ) قال النبي :(@)(@@) | 30 ( من قال في دبر كل صلاة مكتوبة : اللهم أعط محمدا الدرجة والوسيلة ، اللهم اجعل في المصطفين صحبته ، وفي العالمين درجته ، وفي المقربين ذكره ، من قال في دبر كل صلاة فقد استوجب الشفاعة ووجبت له الجنة ) )(@)(@@) ابن السني في عمل يوم وليلة عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22548 ) قال النبي :(@)(@@) | 30 ( من قال بعد صلاة الصبح : أشهد أن لا إلاه إلا الله ، وحده لا شريك له ، إلاها واحدا صمدا ، لم يتخذ صاحبة ولا ولدا ، ولم يكن له كفوا أحد 
ms2417	 ، كتب له أربعون ألف حسنة ) )(@)(@@) ابن السني عن تميم الداري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22549 ) قال النبي :(@)(@@) | 30 ( من قال حين يدخل السوق : لا إلاه إلا الله ، وحده لا شريك له ، له الملك وله الحمد ، يحيي ويميت ، بيده الخير وهو على كل شيء قدير ، لا إلاه إلا الله ، والله أكبر ، والحمد لله ، وسبحان الله ، ولا حول ولا قوة إلا بالله ، كتب الله عز وجل له ألف حسنة ) )(@)(@@) ابن السني عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22550 ) قال النبي :(@)(@@) | 30 ( من قال بعد صلاة الجمعة وهو قاعد قبل أن يقوم من مجلسه : سبحان الله وبحمده ، سبحان الله العظيم وبحمده ، واستغفر الله PageV07P294 مائة مرة ، غفر الله له مائة ألف ذنب ، ولوالديه أربعة وعشرين ألف ذنب ) )(@)(@@) ابن السني والديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22551 ) قال النبي :(@)(@@) | 30 ( من قال حين يفرغ من طعامه الحمد لله الذي أطعمني وأشبعني وآواني بلا حول مني ولا قوة فقد أدى شكر ذالك الطعام ) )(@)(@@) ابن السني عن سعيد بن أبي هلال عمن حدثه .(@)(@@)(@@)(@@) $ ( 22552 ) قال النبي :(@)(@@) | 30 ( من قال سبحان الله بحمده كتب الله له عشر حسنات ، ومن قالها عشرا كتب الله له مائة حسنة ، ومن قالها مائة مرة كتب الله له ألف حسنة ، ومن زاد زاده الله ، ومن استغفر غفر الله له ، ومن حالت شفاعته دون حد من حدود الله فقد ضاد الله في حكمه ، ومن اتهم برياء صيره الله إلى طينة الخبال حتى يأتي بالمخرج مما قال ، ومن انتفى من ولده يفضحه به في الدنيا ، فضحه الله على رؤوس الخلائق يوم القيامة ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22553 ) قال النبي :(@)(@@) | 30 ( من قال لا إلاه إلا الله ، وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير عشر مرات ، كان له عدل نسمة ، ومن سبح تسبيحة ، ومنح منيحة لبن ، أو أهدى زقاقا كان له كعدل نسمة ) )(@)(@@) ( هب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22554 ) قال النبي :(@)(@@) | 30 ( من قال إذا 
ms2418	 أصبح : سبحان الله وبحمده ألف مرة فقد اشترى نفسه من الله تعالى ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22555 ) قال النبي :(@)(@@) | 30 ( من قال عند وفاته : لا إلاه إلا الله الكريم ، ثلاث مرات ، والحمد لله رب العالمين ، ثلاث مرات ، وتبارك الذي بيده الملك يحيي ويميت وهو على كل شيء قدير دخل الجنة ) )(@)(@@) الخرائطي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22556 ) قال النبي :(@)(@@) | 30 ( من قال حين يصبح : لا إلاه إلا الله ، وحده لا PageV07P295 شريك له ، له الملك وله الحمد يحييى ويميت وهو على كل شيء قدير عشر مرات ، كتب الله عز وجل له بكل واحدة قالها عشر حسنات وحط عنه عشر سيئات ، ورفعه بها عشر درجات ، وكن له كعتق عشر رقبات ، وكن له مسلحة من أول النهار إلى آخره ، ولم يعمل يومئذ عملا يقهقرهن ، وإن قالها حين يمسي فمثل ذالك ) )(@)(@@) ( حم ض طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22557 ) قال النبي :(@)(@@) | 30 ( من قال : لا إلاه إلا الله ، وحده لا شريك له ، له الملك ، وله الحمد ، بيده الخير ، وهو على كل شيء قدير ، كن له كعدل عشر رقاب ) )(@)(@@) ( ش ) عبد بن حميد ، ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22558 ) قال النبي :(@)(@@) | 30 ( من قال إذا أصبح وإذا أمسى ثلاث مرات : بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم ، لم يصبه في يومه ولا في ليلته شيء ) )(@)(@@) ( ش ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22559 ) قال النبي :(@)(@@) | 30 ( من قال حين يصبح : رضيت بالله ربا ، وبالإسلام دينا ، وبمحمد نبيا ، وبالقرآن إماما ، كان حقا على الله تعالى أن يرضيه يوم القيامة ) )(@)(@@) ابن النجار عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22560 ) قال النبي :(@)(@@) | 30 ( من قال : لا إلاه إلا الله والله أكبر ، صدقه ربه وقال : لا إلاه إلا أنا وأنا أكبر ، وإذا قال : لا إلاه إلا الله وحده ، يقول الله : لا إلاه إلا أنا وحدي ، وإذا قال : لا إلاه إلا الله وحده 
ms2419	 لا شريك له ، قال الله : لا إلاه إلا أنا وحدي لا شريك لي ، وإذا قال : لا إلاه إلا الله له الملك وله الحمد ، قال الله : لا إلاه إلا أنا أنا لي الملك ولي الحمد ، وإذا قال : لا إلاه إلا الله ولا حول ولا قوة إلا بالله ، قال الله : لا إلاه إلا أنا ولا حول ولا قوة إلا بي ، وكان يقول : من قالها في مرضه ثم مات لم تطعمه النار ) )(@)(@@) ( ت ) حسن عن أبي سعيد وأبي هريرة رضي الله عنه .(@)(@@) PageV07P296(@)(@@)(@@)(@@) $ ( 22561 ) قال النبي :(@)(@@) | 30 ( من قال في كل يوم مائة مرة : لا إلاه إلا الله الملك الحق المبين كان له أمانا من الفقر ، وأنسا من وحشة القبر ، واستجلب الغنى ، واستقرع بها باب الجنة ) )(@)(@@) الشيرازي في الألقاب من طريق ذي النون المصري عن سالم الخواص والخطيب والديلمي والرافعي وابن النجار من طريق الفضل بن غانم عن مالك بن أنس كلاهما عن جعفر بن محمد عن أبيه عن جده عن أبيه عن علي قال الفضل بن غانم : لو رحل الإنسان في هاذا الحديث إلى خراسان لكان قليلا ( حل ) من طريق إسحاق بن زريق عن سالم الخواص عن مالك .(@)(@@)(@@)(@@) $ ( 22562 ) قال النبي :(@)(@@) | 30 ( من قال : لا إلاه إلا الله وحده والله أكبر ، لا إله إلا الله وحده ، لا إلاه إلا الله لا شريك له ، لا إلاه إلا الله له الملك وله الحمد ، لا إلاه إلا الله لا حول ولا قوة إلا بالله ، من قالهن في يوم أو ليلة أو شهر ثم مات من ذالك اليوم ، أو تلك الليلة ، أو ذالك الشهر غفر له ذنبه ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22563 ) قال النبي :(@)(@@) | 30 ( من قال : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير مائة مرة أذا أصبح ، ومائة إذا أمسى ، لم يجىء أحد بعمل أفضل من عمله ، إلا من عمل أفضل من ذالك ) )(@)(@@) ابن السني والخطيب عن عمرو بن شعيب عن أبيه عن 
ms2420	 جده ، ( ش ) عن أبي الدرداء رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 22564 ) قال النبي :(@)(@@) | 30 ( من قال لا إلاه إلا الله يصدق لسانه قلبه ، دخل من أي أبواب الجنة الثمانية شاء ) )(@)(@@) ابن النجار عن عقبة بن عامر عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22565 ) قال النبي :(@)(@@) | 30 ( من قال حين يصبح ثلاث مرات : اللهم لك الحمد ، لا إلاه إلا أنت ، أنت ربي وأنا عبدك ، آمنت بك مخلصا لك ديني ، PageV07P297 أصبحت على عهدك ووعدك ما استطعت أبوء إليك من سيىء عملي وأستغفرك لذنوبي لا يغفرها إلا أنت ، فإن مات في ذالك اليوم دخل الجنة ، وإن قالها حين يمسي ثلاث مرات فمات في تلك الليلة دخل الجنة ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22566 ) قال النبي :(@)(@@) | 30 ( من قال إذا أصبح وإذا أمسى : ربي الله توكلت عليه وهو رب العرش العظيم ، لا إلاه إلا الله العلي العظيم ، ما شاء الله كان وما لم يشأ لم يكن ، أعلم أن الله على كل شيء قدير ، وأن الله قد أحاط بكل شيء علما ثم مات دخل الجنة ) )(@)(@@) ابن السني عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22567 ) قال النبي :(@)(@@) | 30 ( من قال حين يصبح : أعوذ بالله السميع العليم من الشيطان الرجيم ، أجير من الشيطان حتى يمسي ) )(@)(@@) ابن السني عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22568 ) قال النبي :(@)(@@) | 30 ( من قال : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ، بعد ما يصلي الغداة كتب الله له عشر حسنات ومحا عنه عشر سيئات ورفع له عشر درجات ، وكن له كعدل رقبتين من ولد إسماعيل وكن له حجابا من النار ، وكن له حرزا من الشيطان حتى يمسي ، ومن قالها حين يمسي كان له مثل ذالك وكن له حجابا من الشيطان حتى يصبح ) )(@)(@@) ابن صصرى في أماليه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22569 ) قال النبي :(@)(@@) | 30 ( من قال : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد يحيي ويميت بيده 