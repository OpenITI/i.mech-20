ms61	 فضله على ما ترون وكذلك علم المعرفة إنما يلقي الحق إلى من شاء من خلقه له طيبة ثم لا يخرج بلسانه ولا ينطقه الحق إلا بارداه فلأن أكون منحوس الخطة بالكليه من أبي القاسم أحب إلي من أن أكون مغبونا آخذ منه أردى ما ألقى ويبقى طيبه عنده. فأعجبنا كلامه وقمنا من عنده حتى دخلنا أبي (2) القاسم ورحب بنا وسألنا عنه فقصصنا عليه القصة فبكى أبو القاسم حتى كاد أن يغشى عليه وسكت ذلك اليوم ولم ينطق إلى أن قمنا من عنده(@)(@@)(@@)(@@) $BIO_MAN$ 1333 - عبد الله بن دلشاد النيسابوري أبو محمد الرلعري(@)(@@)(@@)(@@) $BIO_MAN$ 1334 - عبد الله بن محمد بن أحمد بن نصر النيسابوري أبو محمد العابد(@)(@@)(@@)(@@) $BIO_MAN$ 1335 - عبد الله بن محمد بن إبراهيم البخاري أبو محمد الداعوني(@)(@@)(@@)(@@) $BIO_MAN$ 1336 - عبد الله بن حمشاد بن حندل بن عمران بن حماد أبو عبد الرحمن المطوعي من سكة نوند(@)(@@)(@@)(@@) $BIO_MAN$ 1337 - عبد الله بن حميد بن معقل القنطري(@)(@@)(@@)(@@) $BIO_MAN$ 1338 - عبد الله بن سعيد النسوي(@)(@@)(@@)(@@) $BIO_MAN$ 1339 - عبد الله بن أحمد النيسابوري أبو محمد الوبري(@)(@@)(@@)(@@) $BIO_MAN$ 1340 - عبد الله بن عبد الرحمن بن الحسين القاضي بن القاضي أبو القاسم الحاكم(@)(@@)(@@)(@@) $BIO_MAN$ 1341 - عبد الله بن سلمة المؤدب أبو محمد النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1342 - عبد الله بن سعيد مخلد (3) الطوسي نزيل نيسابور(@)(@@)(@@)(@@) $BIO_MAN$ 1343 - عبد الله بن محمد بن سلمة النيسابوري أبو محمد البزاز الحافظ(@)PageV00P000(@)(@@)(@@)(@@) $BIO_MAN$ 1344 - عبد الله بن محمد بن يعقوب البخاري أبو محمد الفقيه الكلابادي المعروف بعبد الله الأستاذ(@)(@@)(@@)(@@) $BIO_MAN$ 1345 - عبد الله بن أحمد بن محمد بن الحسين الماسرخسي أبو محمد النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1346 - عبد الله بن إسحاق بن يعقوب الكرماني وغيره(@)(@@)(@@)(@@) $BIO_MAN$ 1347 - عبد الله بن محمد بن الحسين بن الشرقي أبو محمد النيسابوري أخو أبي حامد وكان أسن منه وأسند منه(@)(@@)(@@)(@@) $BIO_MAN$ 1348 - عبد الله بن فارس بن محمد بن علي البلخي أبو ظهير العمري(@)(@@)(@@)(@@) $BIO_MAN$ 1349 - عبد الله بن أبي صالح المذكر أبو عبد الرحمن الزاهد المتكلم 
ms62	 وكان من المجتهدين في العبادة ولكن إنه رأى رأى القدر(@)(@@)(@@)(@@) $BIO_MAN$ عبيد الله إبراهيم (1) بن بابويه النيسابوري أبو القاسم مزكى عصره ومن(@)(@@)(@@)(@@) $BIO_MAN$ 1350 - عبيد الله إبراهيم (1) بن بابويه النيسابوري أبو القاسم مزكى عصره ومن أعيان المشايخ ومسجده المعروف في سكة معقل(@)(@@)(@@)(@@) $BIO_MAN$ 1351 - عبيد الله بن محمد النيسابوري المعروف بعيد الوراق(@)(@@)(@@)(@@) $BIO_MAN$ 1352 - عبيد الله بن يعقوب بن يوسف الرازي أبو القاسم الواعظ وتوفي بنيسابور ودفن في مقبرة باب معمر(@)(@@)(@@)(@@) $BIO_MAN$ 1353 - عبد الرحمن بن محمد بن الحسين بن علي بن أحمد النيسابوري أبو القاسم المذكر الواعظ الأديب الأوحد في عصره في صنعته بلا مدافعة وله كرامات مشهورة رضي الله عنه(@)(@@)(@@)(@@) $BIO_MAN$ 1354 - عبد الرحمن بن محمد بن عبد الرحمن السرخسي المذكر أبو بكر سكن بنيسابور إلى أن توفي بها(@)(@@)(@@)(@@) $BIO_MAN$ 1355 - عبد الرحمن بن محمد بن سليمان النيسابوري أبو محمد من قرية بغوحك(@)(@@)(@@)(@@) $BIO_MAN$ 1356 - عبد الرحمن بن محمد بن علويه الأبهري أبو بكر القاضي ولى قضاء طوس وأبيورد(@)(@@)(@@)(@@) $BIO_MAN$ 1357 - عبد الواحد بن سعيد النيسابوري أبو أحمد الأرغياني(@)(@@)(@@)(@@) $BIO_MAN$ 1358 - عبد العزيز بن الحسن أبو بكر البردعي العابد(@)(@@)(@@)(@@) $BIO_MAN$ 1359 - عبد العزيز بن محمد الخشاب أبو عمر النيسابوري وكان من الزهاد يسكن سكة تنكش(@)(@@)(@@)(@@) $BIO_MAN$ 1360 - عبد الملك بن محمد بن عدي الجرجاني أبو نعيم الفقيه الإسترابادني(@)(@@)(@@)(@@) $BIO_MAN$ 1361 - عبد الواحد بن محمد بن أحمد بن بالويه النيسابوري أبو الحسن البالوي الحيري(@)(@@)(@@)(@@) $BIO_MAN$ 1362 - عبد الواحد بن محمد النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1363 - عبد الواحد بن محمد النيسابوري(@)(@@)(@@)(@@) $BIO_MAN$ 1364 - عبد الواحد بن محمد بن هاني أبو حاتم شيخ آل هاني واشتغل بالفتوة فصار أوحد أهل بلدنا فيها(@)(@@)(@@)(@@) $BIO_MAN$ 1365 - عمر بن علي بن عبد الرحمن الجوهري أبو حفص المروزي المعروف بابن علل(@)(@@)(@@)(@@) $BIO_MAN$ 1366 - عقيل بن إسحاق أبو حاتم النيسابوري المعروف بعقيل القنارزي PageV00P000(@)(@@)(@@)(@@) $BIO_MAN$ 1367 - علي الوراق وهو ابن محمد بن أحمد بن علي بن عبد الله بن نور النيسابور