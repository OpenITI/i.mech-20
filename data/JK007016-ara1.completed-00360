ms341	 الصلت .(@)(@@) قال : وسمعت يحيى يقول : كنية زائدة بن قدامة أبو الصلت .(@)(@@) 1171 - حدثني أبو جعفر محمد بن إسماعيل بن سالم الصائغ ، قال : حدثنا يحيى بن أبي بكير ، قال : حدثنا إسرائيل ، عن أبي حومل العامري ، عن عبادة ابن الوليد بن عبادة بن الصامت ، وكان يكنى أبا الصامت ، أنه سافر مع جابر بن عبد الله أو أبي سعيد الخدري ، قال : فكانا يمسحان على الخفين . PageV02P662(@)(@@) [ وسمعت عبد الله بن أحمد قال : سمعت أبي يقول : زائدة بن قدامة كنيته أبو الصلت .(@)(@@) 1172 - حدثنا عمران بن بكار البراد ، قال : حدثنا أبو المغيرة عبد القدوس بن الحجاج ، قال : حدثنا صفوان بن عمرو ، قال أخبرني شريح بن عبيد أبو الصلت الحضرمي ، قال : قال رجل لعمرو بن الأسود العنسي قد ذكر لنا أن الحكم يقع في مهواه من جهنم أبعد من عدن ، قال عمرو : إن هذا والله لشديد ، و تعجب من الرجل لم يبتل بالقضاء ولم يؤمر به فيمر به الرجلان يختصمان ، فيقول لهما : تعالا أقضي بينكما .(@)(@@) 1173 - حدثنا عمران بن بكار ، قال : حدثنا أبو المغيرة ، قال : حدثنا صفوان بن عمرو ، قال : حدثنا أبو الصلت سليم الحضرمي ، قال : شهدت صفين مع علي ، فإنا على صفوفنا ، وقد حيل بين أهل العراق وبين الماء فأتانا فارس مقنع بالحديد ، فأقبل حتى وقف ، ثم حسر عن رأسه ، فإذا هو الأشعث بن قيس ، فقال : الله الله يا معاوية في أمة محمد ، فقال معاوية : ما الذي تريد ؟ قال : نريد أن تخلوا بيننا وبين الماء ، فقال معاوية لأبي الأعور عمرو بن سفيان : يا أبا عبد الله ! خل بين إخواننا وبين الماء ، قال أبو الأعور لمعاوية : كلا ، والله يا معاوية لا نخلي بينهم وبين الماء ، فعزم عليه معاوية حتى خلى بينهم وبين الماء ، قال : فلم يلبثوا بعد ذلك إلا قليلا حتى كان الصلح بينهم . PageV02P663(@)(@@) قال : وأخبرني أحمد بن شعيب ، عن قتيبة بن سعيد ، قال : حدثنا شهاب بن خراش أبو الصلت .(@)(@@) 1174 - وحدثني محمد بن إسماعيل أبو صالح بن أبي ضرار ، قال : حدثنا أبو الصلت الهروي عبد 
ms342	 السلام بن صالح ، قال : حدثني علي بن موسى الرضا ، عن أبيه موسى بن جعفر بن محمد ، عن أبيه جعفر ، عن أبيه محمد بن علي ، عن أبيه ، علي بن الحسين ، عن أبيه الحسين بن علي ، عن أبيه علي بن أبي طالب ، قال : قال رسول الله [ صلى الله عليه وسلم ] : الإيمان معرفة بالقلب ، وتصديق باللسان ، وعمل بالأركان . PageV02P664(@)(@@)(@@)(@@) ||| ( من كنيته أبو صدقة وأبو صخر وأبو صخرة )(@)(@@)(@@)(@@) $ * أبو صدقة سليمان بن كندير ، صلى إلى جنب ابن عمر .(@)(@@)(@@)(@@) $ * وأبو صدقة توبة ، عن أنس ، ومعاوية بن صالح عنه .(@)(@@)(@@)(@@) $ * وأبو صدقة صخر بن صدقة ، يروي عن : أبي عقال ، يحدث عنه : الوليد بن مسلم .(@)(@@)(@@)(@@) $ * وأبو صدقة محمد بن عبد الأعلى ، يحدث عنه : يونس بن عبد الأعلى .(@)(@@)(@@)(@@) $ * وأبو صخر حميد بن زياد الخراط .(@)(@@)(@@)(@@) $ * وأبو صخر حشرج بن عبد الله .(@)(@@)(@@)(@@) $ * وأبو صخرة ( 2 / 12 ) جامع بن شداد .(@)(@@)(@@)(@@) $ * [ وأبو صدقة العجلي ، يروي عنه : شعبة .(@)(@@)(@@)(@@) $ * وأبو صدقة مولى أنس ] .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى [ بن معين ] يقول : أبو صخرة جامع بن شداد .(@)(@@) وسمعت عبد الله بن أحمد ، يقول : سمعت أبي يقول : أبو صدقة العجلي ، يروي عنه : شعبة ، وأبو صدقة مولى أنس يروي عنه : شعبة . PageV02P665(@)(@@) [ قال ] : وأخبرني أحمد بن شعيب ، قال : أنبأ إسحاق بن إبراهيم ، قال : أنبأ محمد بن مروان البجلي بصري .(@)(@@) 1175 - قال : حدثنا سليمان بن كندير ويكنى أبا صدقة ، أنه صلى إلى جنب ابن عمر ، قال : فرفعت رأسي قبل الإمام فأهوى ابن عمر بيده إلى رأسي فرده .(@)(@@) 1176 - حدثنا محمد بن بشار ، قال : حدثنا عبد الرحمن بن مهدي ، قال : حدثنا معاوية بن صالح ، عن توبة أبي صدقة ، أن أنس بن مالك كان يقتل القمل والبراغيث في الصلاة .(@)(@@) 1177 - حدثنا محمد بن منصور الجواز ، قال : حدثنا سفيان بن عيينة ، عن مسعر عن أبي صخر ، عن الأسود بن هلال ، قال : قام عمر على المنبر ، فقال : إني داع على ثلاث فهيمنوا : اللهم إني غليظ فليني ، وإني شحيح فسخني ، وإني ضعيف فقوني .(@)(@@) 1178 - حدثني أبو بكر شعيب بن أيوب القاضي ، قال : حدثنا يحيى 
ms343	 بن آدم ، قال : حدثنا الحسن بن ثابت ، عن عبد الله بن الوليد المزني ، عن أبي صخرة جامع بن شداد ، عن عبد الرحمن بن أبي علقمة الثقفي ، عن عبد الله بن مسعود ، قال : كان معنا ليلة نام رسول الله [ صلى الله عليه وسلم ] في صبيحتها عن صلاة الفجر ، حتى طلعت الشمس حاديان . PageV02P666(@)(@@)(@@)(@@) ||| ( من كنيته أبو صفوان )(@)(@@)(@@)(@@) $ * أبو صفوان مهران ، عن ابن عباس .(@)(@@)(@@)(@@) $ * وأبو صفوان عبد الله بن سعيد بن عبد الملك بن مروان .(@)(@@)(@@)(@@) $ * وأبو صفوان أيوب بن خالد بن صفوان .(@)(@@)(@@)(@@) $ * وأبو صفوان حميد بن قيس المكي [ الأعرج ] .(@)(@@)(@@)(@@) $ * وأبو صفوان يحيى بن هانئ الرعيني .(@)(@@)(@@)(@@) $ * وأبو صفوان نصر بن قديد بن نصر بن سيار .(@)(@@)(@@)(@@) $ * وأبو صفوان عطاف بن خالد المخزومي .(@)(@@)(@@)(@@) $ * [ وأبو صفوان يحيى بن قيس ] .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين ، يقول : قد روى زهير بن معاوية ، عن يحيى بن قيس ، وهو أبو صفوان .(@)(@@) سمعت عبد الله بن أحمد ، يقول : سمعت أبي يقول : حميد الأعرج كنيته أبو صفوان .(@)(@@) [ قال ] : وأخبرني أحمد بن شعيب ، قال : أنبأ قتيبة بن سعيد ، قال : العطاف بن خالد أبو صفوان . PageV02P667(@)(@@) 1179 - [ قال ] : وأخبرني أحمد بن شعيب ، قال : أنبا محمد بن المثنى ، قال : حدثني أبو معاوية ، قال : أخبرني الحسن بن عمرو الفقيمي ، عن مهران أبي صفوان ، عن ابن عباس قال : قال رسول الله [ صلى الله عليه وسلم ] : من أراد الحج فليستعجل .(@)(@@) 1180 - قال : وأخبرني أحمد بن شعيب ، قال : أنبأ قتيبة بن سعيد ، قال : حدثنا أبو صفوان عبد الله بن سعيد بن عبد الملك بن مروان ، عن يونس بن يزيد ، عن ابن شهاب ، أن السائب بن يزيد ، وعبيد الله أخبراه ، أن عبد الرحمن بن عبد القارئ ، قال : سمعت عمر بن الخطاب ، يقول : قال رسول الله [ صلى الله عليه وسلم ] : من نام عن حزبه أو عن شيء منه ، فيقرأه فيما بين صلاة الفجر وصلاة الظهر ، كتب كأنما قرأه من الليل .(@)(@@) 1181 - حدثني يزيد [ بن محمد ] بن عبد الصمد ، قال : حدثنا عبد الرحمن بن يحيى ، قال : حدثنا عبد الرحمن بن 
ms344	 يحيى ، قال : قال أبو صفوان الرعيني يحيى بن هانئ ، قال : قال أبو علاثة : ولاني عمر بن عبد العزيز الصدقة بالجزيرة ، فبلغت ثلاثين ألفا ، وكتب إليه عمر يأمره أن يأخذ منها الثمن ، ويبعث إليه بالبقية . PageV02P668(@)(@@) 1182 - وفيما روى محمد بن إدريس ، قال : حدثنا أبو صفوان نصر ابن قديد بن نصر ( 2 / 13 ) بن سيار ، قال : حدثنا ربعي بن عبد الله بن الجارود بن أبي سبرة ، [ عن الجارود بن أبي سبرة ] عن أنس بن مالك يرفعه ، قال : المخلدون في النار في توابيت من حديد مطبقة .(@)(@@) حدثنا يحيى بن عثمان بن صالح ، قال : حدثنا نعيم [ بن حماد ] ، قال : حدثنا محمد بن عثمان بن صفوان [ بن أمية ] بن خلف الجمحي ، عن حميد بن قيس أبي صفوان الأعرج أخي عمر بن قيس . PageV02P669(@)(@@)(@@)(@@) ||| ( من كنيته أبو الصباح )(@)(@@)(@@)(@@) $ * أبو الصباح موسى بن أبي كثير ، روى عنه : الثوري .(@)(@@)(@@)(@@) $ * وأبو الصباح عيسى بن سوادة النخعي ، روى عن : إسماعيل بن أبي خالد .(@)(@@)(@@)(@@) $ * وأبو الصباح محمد بن سمير ، روى عنه : عبد الرحمن بن شريح .(@)(@@)(@@)(@@) $ * وأبو الصباح إسماعيل بن صديق ، حدث عنه : إبراهيم بن عرعرة .(@)(@@)(@@)(@@) $ * وأبو الصباح سليمان بن يسير ، قال يحيى بن معين : ليس هو بشيء . PageV02P670(@)(@@)(@@)(@@) $ * وأبو الصباح سعيد بن سعيد .(@)(@@)(@@)(@@) $ * وأبو الصباح سعدان بن سالم [ الأيلي ] .(@)(@@)(@@)(@@) $ * وأبو الصباح عبد الغفور الواسطي .(@)(@@) سمعت العباس ، يقول : سمعت يحيى يقول : موسى بن أبي كثير أبو الصباح ، يروي عنه : سفيان ، ومسعر ، وهشيم ، وهو ثقة إلا أنه مرجئ .(@)(@@) قال يحيى : وأبو الصباح الذي يحدث عنه : ابن المبارك ثقة ، يقال له : سعدان بن سالم ، وهو أبو الصباح الأيلي ، يروى عنه حديث يزيد بن أبي سمية ، عن ابن عمر ، ما قال النبي [ صلى الله عليه وسلم ] في الإزار ، فهو في القميص .(@)(@@) قال يحيى : عبد الغفور أبو الصباح ، حديثه ليس بشيء .(@)(@@) 1183 - حدثنا محمد بن منصور الجواز ، قال : حدثنا سفيان ، عن مسعر ، عن أبي الصباح ، قال : تكره العدة في البيع .(@)(@@) 1184 - حدثنا محمد بن بشار ، قال : حدثنا يحيى بن سعيد ، قال : حدثنا سفيان ، قال : أخبرني أبو الصباح موسى 
ms345	 بن أبي كثير ، قال : سألت سعيد بن المسيب كم تعتد امرأة المرتد ؟ قال : ثلاثة قروء ، قلت : فإن قتل ، قال : فأربعة أشهر وعشرا ، قلت : تواصل بميراثه ، قال : ما تواصل بميراثه نرثهم ولا يرثوننا . PageV02P671(@)(@@) 1185 - أخبرني أحمد بن شعيب ، قال : أنبأ عمار بن الحسن ، قال : حدثنا أبو الصباح عيسى بن سوادة النخعي ، قال : حدثنا إسماعيل بن أبي خالد ، عن زاذان ، قال : مرض ابن عباس مرضة ثقل فيها ، فجمع إليه بني وأهله ، فقال لهم : يا بني إني سمعت رسول الله [ صلى الله عليه وسلم ] يقول : من حج [ من ] مكة ماشيا ، كتب الله له بكل خطوة سبع مائة حسنة من حسنات الحرم ، فقال بعضهم : وما حسنات الحرم ؟ قال : كل حسنة بمائة ألف حسنة .(@)(@@) 1186 - قال : وأخبرني أحمد بن شعيب ، قال : أنبأ علي بن حجر ، قال : أنبأ ضمرة ، عن سعدان بن سالم أبي الصباح ، عن يزيد بن أبي سمية ، قال : سمعت ابن عمر يقول : ما قال رسول الله [ صلى الله عليه وسلم ] في الإزار ، فهو في القميص ، [ انتهى ] . PageV02P672(@)(@@)(@@)(@@) ||| ( من كنيته أبو الصهباء )(@)(@@)(@@)(@@) $ * أبو الصهباء بصري ، روى عن : ابن عباس .(@)(@@)(@@)(@@) $ * وأبو الصهباء صلة بن أشيم .(@)(@@)(@@)(@@) $ * وأبو الصهباء مضرس بن عبد الله ، يروي عنه : وكيع بن الجراح .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين ، قال : اسم أبي الصهباء صلة بن أشيم .(@)(@@) [ قال : ] وقد روى وكيع ، وعبد الله بن داود ، عن شيخ يقال له : مضرس بن عبد الله كنيته أبو الصهباء .(@)(@@) قال : ومعاذة العدوية ، هي معاذة بنت أشيم ، وهي أم الصهباء .(@)(@@) 1187 - حدثنا أبو بكر بن إدريس ، قال : حدثنا الحميدي ، قال : حدثنا سفيان ، عن ( 2 / 14 ) إبراهيم بن ميسرة ، عن طاوس ، قال : جاء أبو الصهباء إلى ابن عباس ، فقال : ماذا جمعت وماذا صررت .(@)(@@) 1188 - أخبرني أحمد بن شعيب ، قال : أخبرنا قتيبة بن سعيد ، قال : حدثنا جعفر بن سليمان ، عن الجريري ، عن أبي السليل ، قال : قلت لصلة بن PageV02P673 أشيم : يا أبا لصهباء ! علمني خيرا أفدني خيرا ، قال : أكثر دعوة الله وإياك أن تصيبك دعوة العامة .(@)(@@) 1189 - حدثنا 
ms346	 بشر بن عبد الوهاب ، قال : حدثنا وكيع ، عن أبي الصهباء مضرس بن عبد الله ، قال : سمعت الضحاك يقول [ في قوله تعالى ] : @QB@ إنها عليهم مؤصدة @QE@ : أي مطبقة . PageV02P674(@)(@@)(@@)(@@) ||| ( المفاريد في حرف الصاد )(@)(@@)(@@)(@@) $ * أبو [ صفرة ] عسعس بن سلامة .(@)(@@)(@@)(@@) $ * وأبو صفية ثابت بن دينار .(@)(@@)(@@)(@@) $ * وأبو صيفي بشير بن ميمون .(@)(@@)(@@)(@@) $ * وأبو الصيدا صالح بن طريف .(@)(@@)(@@)(@@) $ * وأبو صفرة والد المهلب .(@)(@@)(@@)(@@) $ * وأبو صادق عبد الله بن ناجذ [ الأزدي ] .(@)(@@)(@@)(@@) $ * وأبو الصديق بكر بن عمرو .(@)(@@)(@@)(@@) $ * وأبو الأصبغ عبد العزيز بن مروان بن الحكم .(@)(@@)(@@)(@@) $ * [ وأبو صغيرة مسلم ] .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى بن معين يقول : عسعس بن سلامة كنيته أبو صفرة .(@)(@@) واسم أبي صفرة والد المهلب : ظالم بن سارق .(@)(@@) حاتم بن أبي صغيرة ، هو حاتم بن مسلم ، اسم أبي صغيرة مسلم . PageV02P675(@)(@@) سمعت عبد الله بن أحمد ، قال : قال أبي : كنية عسعس بن سلامة أبو صفرة .(@)(@@) 1190 - حدثنا القاسم بن يونس الحمصي البرساني ، قال : حدثنا أحمد بن حنبل ، قال : حدثنا عبيد الله بن محمد القرشي ، قال : أخبرني أبو الخليل ، وكان من أهل الخير ، قال : خرج عسعس بن سلامة الجاري إلى أصحابه ، فنظر فقال : أما إني قد أعددت لهم سورة الواقعة ، فقالوا : يا أبا صفرة ! فنحن إخوانك قال : إخوان دون إخوان .(@)(@@) 1191 - أخبرني أحمد بن شعيب ، قال : أخبرني عبيدة بن الطيب نسائي ، قال : حدثنا أبو علي الحسن بن علي الكسائي الكوفي ، قال : حدثنا جنادة بن سلم أبو الحكم ، عن أبي صفية ثابت بن دينار ، عن عكرمة ، عن PageV02P676 ابن عباس قال : قال رسول الله [ صلى الله عليه وسلم ] : اللهم بارك لأمتي في بكورها ، واجعلها يوم الخميس .(@)(@@) 1192 - وأخبرني أحمد بن شعيب ، قال : أنبأ عمرو بن زرارة ، قال : أنبأ بشير بن ميمون أبو صيفي من أهل واسط ، عن عبيد بن همام ، عن عكرمة ، عن ابن عباس قال : من السنة إذا دعوت الرجل إلى منزلك ، فإذا خرج تخرج معه إلى باب الدار .(@)(@@) 1193 - وأخبرني أبو عبد الرحمن النسائي ، قال : أنبأ أحمد بن سعيد الرباطي ، قال : حدثنا وهب بن جرير ، قال : حدثنا حيان بن 
ms347	 زهير أبو زهير العدوي ، قال : حدثنا أبو الصيدا صالح بن طريف الضبي ، قال : لما قدم يوسف بن عمر العراق فأتانا خبره بخراسان بكى أبو الصيدا واشتد بكاؤه ، وقال : هذا الخبيث شهدته ضرب وهب بن منبه حتى قتله .(@)(@@) سمعت العباس بن محمد قال : سمعت يحيى بن معين يقول : أبو الصديق ثقة ، واسمه بكر بن عمرو .(@)(@@) قال يحيى : أبو الأصفر الذي يروي عنه مبارك بن فضالة مشهور .(@)(@@) قال يحيى : وعبد العزيز بن مروان أبو الأصبغ . PageV02P677(@)(@@) حدثنا إبراهيم بن يعقوب ، قال : حدثنا أبو نعيم ، قال : حدثنا أبو عاصم الثقفي محمد بن أيوب ، قال : سمعت أبا صادق عبد الله بن ناجذ الأزدي من أزد شنوءة .(@)(@@) 1194 - حدثنا إسحاق بن سيار ، قال : حدثنا عمرو بن عاصم ، قال : حدثنا أبو بكر بن شعيب ، قال : سمعت أبي يحدث قال : قلت لأبي صادق : ما تقول في فلان ؟ هو أشنأ الصحابة عندي ، قلت ( 2 / 15 ) له : فما تقول في علي ؟ قال : هو أحب الصحابة إلي ، وما أحب أني شهدت معه الجمل ، وأن لي سواري المسجد ذهبا كسواري المسجد الجامع بالكوفة . PageV02P678(@)(@@)(@@)(@@) || ( [ باب ] حرف الضاد )(@)(@@)(@@)(@@) ||| ( [ من كنيته أبو ضمرة ] )(@)(@@)(@@)(@@) $ * أبو ضمرة غيلان المقرائي ، عن : أبي أمامة ، روى عنه : أرطأة بن المنذر .(@)(@@)(@@)(@@) $ * وأبو ضمرة عبد الله بن المستورد ، روى عنه : أبو أسامة .(@)(@@)(@@)(@@) $ * وأبو ضمرة أنس بن عياض مديني .(@)(@@)(@@)(@@) $ * وأبو ضمرة عاصم بن أبي بكر الزهري ، عن : مالك .(@)(@@)(@@)(@@) $ * وأبو ضمرة محمد بن سليمان الحمصي .(@)(@@) سمعت العباس بن محمد يقول : سمعت يحيى بن معين يقول : أبو ضمرة أنس بن عياض ثقة .(@)(@@) 1195 - حدثني عبد الصمد بن عبد الوهاب صميد ، قال : حدثنا يحيى بن صالح الوحاظي ، حدثنا محمد بن سليمان أبو ضمرة البصري ، قال : حدثني عبد الله بن أبي قيس ، قال : أرسلني عطية بن عازب إلى عائشة أسألها عن الغسل من الجنابة ؟ وعن الرجل يجنب فيدركه الصبح ؟ وهو يريد الصيام ؟ وعن الوصال ؟ قال : فلما جئتها قلت : كيف أسلم على أم المؤمنين ، فقيل لي : قل : سلام عليك يا رسول الله ، وسلام عليكم أهل البيت .(@)(@@) 1196 - حدثنا 
ms348	 إبراهيم بن يعقوب السعدي ، قال : حدثنا عبد الله بن PageV02P679 الربيع ، قال : حدثنا أبو أسامة ، عن أبي ضمرة عبد الله بن المستورد ، قال : حدثني محمد بن عبد الرحمن بن لبيبة ، أن رسول الله [ صلى الله عليه وسلم ] أبصر الحسن بن علي مقبلا ، فقال : اللهم سلمه وسلم منه .(@)(@@)(@@)(@@) ||| ( من كنيته أبو الضحاك )(@)(@@)(@@)(@@) $ * أبو الضحاك عبد الله بن راشد الزوفي ، روى عنه : يزيد بن أبي حبيب .(@)(@@)(@@)(@@) $ * وأبو الضحاك عبيد بن فيروز ، شعبة عنه .(@)(@@)(@@)(@@) $ * وأبو الضحاك يحيى بن مسلم ، محمد بن ربيعة عنه .(@)(@@)(@@)(@@) $ * وأبو الضحاك الجارود بن يزيد ، غير ثقة .(@)(@@) 1197 - حدثنا حسين بن نصر ، قال : سمعت يزيد بن هارون ، قال : أنبأ شعبة ، عن سليمان بن عبد الرحمن ، عن عبيد بن فيروز أبي الضحاك الشيباني ، عن البراء بن عازب ، قال : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : لا يجوز في الأضاحي ، وأشار بأصابعه الأربع ، وقال : يدي أقصر من يد رسول الله [ صلى الله عليه وسلم ] : العوراء البين عورها ، والمريضة البين مرضها ، والعرجاء البين عرجها ، والظالع البين ظلعها ، والكبيرة التي لا تنقي ، قال فقلت : للبراء : إني لأكره النقص في السن والقرن ؟ قال : ما PageV02P680 كرهت فدعه ، ولا تحرمه على أحد .(@)(@@) 1198 - حدثنا أحمد بن حرب الطائي ، قال : حدثنا محمد بن ربيعة ، عن يحيى بن مسلم أبي الضحاك ، عن أبيه ، عن عوف بن مالك ، عن أبيه ، قال : سئل علي بن أبي طالب ، عن الجنين فقال : خذ السكين فسمه واقطع فإنما هو بمنزلة الذبيحة . PageV02P681(@)(@@)(@@)(@@) ||| ( المفاريد في حرف الضاد )(@)(@@)(@@)(@@) $ * أبو الضحى مسلم بن صبيح .(@)(@@)(@@)(@@) $ * وأبو الضريس عقبة بن عمار .(@)(@@)(@@)(@@) $ * وأبو ضرغام هلقام .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين يقول : أبو الضحى مسلم بن صبيح ، هو مولى لسعيد بن ( 2 / 16 ) ، العاص وكان عطارا .(@)(@@) حدثنا أحمد بن حرب الطائي ، قال : حدثنا أسباط بن محمد ، عن الشيباني ، عن أبي الضحى مسلم بن صبيح .(@)(@@) 1199 - حدثنا أحمد بن شعيب ، قال : أنبأ محمد بن العلاء ، قال : حدثنا أبو بكر بن عياش ، قال : حدثنا أبو حصين ، قال : رأيت الشعبي وإلى 
ms349	 جنبه مسلم ، فإذا جاءه شيء ، قال : ما ترى يا ابن صبيح ؟(@)(@@) 1200 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن يحيى بن أيوب المروزي ، قال : حدثنا عرعرة بن البرند ، عن هلقام أبي ضرغام ، قال : كتب عمر بن عبد العزيز في السبية أن تستبرأ . PageV02P682(@)(@@)(@@)(@@) || ( باب حرف الطاء )(@)(@@)(@@)(@@) ||| ( من كنيته أبو طالب ، وأبو طاهر ، [ وأبو طيبة ، وأبو الطيب ] )(@)(@@)(@@)(@@) $ * أبو طالب هاشم بن الوليد ، يروي عن : أبي بكر بن عياش .(@)(@@)(@@)(@@) $ * وأبو طالب يحيى بن يعقوب بن مدرك بن سعد الأنصاري .(@)(@@)(@@)(@@) $ * وأبو طالب عبد الجبار بن عاصم ، عن عبيد الله بن عمرو الرقي .(@)(@@)(@@)(@@) $ * وأبو طالب دينار ، يروي عنه : قتادة .(@)(@@)(@@)(@@) $ * وأبو الطاهر موسى بن محمد بن عطاء ، يروي عن : يزيد .(@)(@@)(@@)(@@) $ * وأبو الطاهر أحمد بن عمرو بن السرح .(@)(@@)(@@)(@@) $ * وأبو طيبة عبد الله بن مسلم مروزي ، يروي عنه : زيد بن حباب .(@)(@@)(@@)(@@) $ * وأبو الطيب موسى بن يسار ، يروي عنه : شبابة بن سوار .(@)(@@)(@@)(@@) $ * وأبو الطيب هارون بن محمد ، يروي عنه : داود بن رشيد .(@)(@@) سمعت العباس بن محمد ، يقول : يحيى بن معين ، يقول : اسم أبي طالب الذي يروي عن قتادة : دينار .(@)(@@) وفي موضع آخر قال : سمعت يحيى يقول : وقيل [ له ] : إن قتادة يقول : حدثني أبو طالب الحجام ، فقال : نعم ، هكذا كان يقول حدثني أبو طالب الضبعي ، وكان حجاما . PageV02P683(@)(@@) 1201 - أخبرني أحمد بن شعيب ، قال : أنبأ جعفر بن الهذيل ، قال : حدثنا سعيد بن محمد الجرمي ، قال : حدثنا أبو تميلة ، قال : حدثنا أبو طالب يحيى بن يعقوب بن مدرك بن سعد الأنصاري القاضي خال أبي يوسف ، عن محارب بن دثار ، قال : دخلنا على جابر بن عبد الله ، فقرب إلينا خبزا وخلا ، وقال : كلوا ، فإني سمعت رسول الله [ صلى الله عليه وسلم ] يقول : نعم الإدام الخل .(@)(@@) 1202 - أخبرني أحمد بن شعيب ، قال : أنبأ أحمد بن سليمان ، قال : حدثنا زيد بن الحباب ، قال : حدثني عبد الله بن مسلم السلمي خراساني من أهل مرو أبو طيبة ، قال : حدثني عبد الله بن بريدة ، عن أبيه ، أن رجلا جاء إلى رسول الله [ صلى الله عليه وسلم ] وعليه 
ms350	 خاتم من حديد ، فقال : مالي أرى عليك حلية أهل النار .(@)(@@) 1203 - حدثني محمد بن عبد الله بن مخلد ، قال : حدثنا داود بن رشيد ، قال : حدثنا أبو الطيب هارون بن محمد ، قال : حدثنا بكير بن مسمار ، عن عامر بن سعد ، عن سعد ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إن الله نظيف يحب النظافة ، جواد يحب الجود ، كريم يحب الكرم ، طيب يحب الطيب ، فنظفوا أفنيتكم ، ولا تشبهوا باليهود تجمع الأكباء في دورها .(@)(@@) 1204 - حدثنا حاجب بن سليمان ، وعلي بن معبد ، قالا : حدثنا شبابة بن سوار ، قال : حدثنا موسى بن يسار أبو الطيب ، قال : سمعت عكرمة يقرأ : @QB@ فقدرنا فنعم القادرون @QE@ أي : ملكنا فنعم المالكون ، ولو كانت PageV02P684 فقدرنا - بالتشديد - كان : فنعم المقدرون .(@)(@@) سمعت العباس ، يقول : سمعت يحيى يقول : موسى بن يسار أبو الطيب ، وكان من أهل المدائن ، روى عنه : شبابة ، وهو ثقة .(@)(@@) قال : وأبو الطيب الذي كان في الحربية من الأنبار ، وكان كذابا ( 2 / 17 ) .(@)(@@) حدثنا العباس ، قال : [ قال ] : سمعت يحيى ، يقول : أبو طيبة الجرجاني ، روى عنه : أبو شجاع .(@)(@@) 1205 - حدثنا ابن أبي مريم ، قال : حدثنا السري يعني ابن يحيى ، قال : حدثني أبو شجاع ، عن أبي طيبة الجرجاني ، عن عبد الله بن عمر ، أن جبرائيل أتى النبي [ صلى الله عليه وسلم ] فعلمه هذا الدعاء : يا نور السماوات والأرض ، ويا زين السماوات والأرض ، ويا جمال السموات والأرض ، ويا عماد السماوات والأرض ، ويا بديع السماوات والأرض ، يا ذا الجلال والإكرام ، يا صريخ المستحضرين ، ويا غوث المستغيثين ، ويا منتهى رغبة العالمين ، والمفرج عن المكروبين ، ومروح المغمومين ، ومجيب المضطرين ، وكاشف السوء يا أرحم الراحمين ، منزول بك كل حاجة ، انتهى . PageV02P685(@)(@@)(@@)(@@) ||| ( من كنيته أبو طلحة )(@)(@@)(@@)(@@) $ * أبو طلحة إياس بن زهير .(@)(@@)(@@)(@@) $ * وأبو طلحة سفيان بن حمزة .(@)(@@)(@@)(@@) $ * وأبو طلحة شداد بن سعيد الراسبي .(@)(@@)(@@)(@@) $ * وأبو طلحة بشر بن كثير .(@)(@@)(@@)(@@) $ * وأبو طلحة حكيم بن دينار .(@)(@@)(@@)(@@) $ * وأبو طلحة فرقد .(@)(@@)(@@)(@@) $ * وأبو طلحة عبد الله بن حفص .(@)(@@)(@@)(@@) $ * وأبو طلحة نعيم بن زياد ، حدث عنه : معاوية بن صالح .(@)(@@)(@@)(@@) $ * وأبو طلحة الأسدي ، سمع : أبا عمرو الشيباني .(@)(@@)(@@)(@@) $ * وأبو 
ms351	 طلحة يحيى بن طلحة ، سمع : جده أبا أمه سعيد بن جمهان .(@)(@@)(@@)(@@) $ * [ وأبو طلحة الطلحات عبد الله بن خالد الخزاعي .(@)(@@)(@@)(@@) $ * وأبو طلحة علي بن أبي طلحة الشامي ] .(@)(@@) 1206 - حدثني معاذ بن معاذ [ أبو المثنى ] ، قال : حدثني مسدد ، قال : حدثنا عبد الوارث بن سعيد ، عن أبي نعامة العدوي ، عن مسلم بن يزيد ، عن إياس أبي طلحة ، وهو إياس بن زهير ، عن سويد بن هبيرة ، قال : قال رسول الله [ صلى الله عليه وسلم ] : خير مال المرء سكة مأبورة ، أو مهرة مأمورة .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى بن معين ، يقول : PageV02P686 أبو طلحة الطلحات عبد الله بن خالد الخزاعي ، كان مع عائشة يوم الجمل .(@)(@@) قال : وأبو طلحة علي بن أبي طلحة الشامي .(@)(@@) حدثنا عبد الله بن أحمد بن حنبل ، قال : حدثنا أبي ، قال : حدثنا أبو سعيد مولى بني هاشم ، قال : حدثنا بشر بن كثير أبو طلحة الأسيدي ، قال أبي : هذا ثقة ثقة .(@)(@@) 1207 - حدثنا سعيد بن عثمان ، قال : حدثنا بشر بن بكر ، قال : حدثنا ابن جابر ، قال : حدثنا حكيم بن دينار أبو طلحة ، قال : غدوة وروحة وحظ من دلجة ، واستقامة تبلغك المنزل ، وإن كان بعيدا .(@)(@@) 1208 - حدثنا يزيد بن سنان ، قال : حدثنا أبو داود ، قال : حدثنا السكن بن المغيرة أبو محمد ، قال أبو داود : ثقة ، وهو مولى لآل عثمان بن عفان ، قال : حدثنا الوليد بن أبي هشام ، قال : حدثنا فرقد أبو طلحة ، عن عبد الرحمن بن خباب ، قال : خطب رسول الله [ صلى الله عليه وسلم ] فحض على جيش العسرة ، فقال عثمان : يا رسول الله ! علي ثلاث مائة بعير بأحلاسها وأقتابها في سبيل الله ، قال : فسمعت رسول الله [ صلى الله عليه وسلم ] يقول : ما على عثمان ، ما عمل بعد هذه ، قالها غير مرة .(@)(@@) 1209 - أخبرني أحمد بن شعيب ، قال : أخبرنا أحمد بن نصر النيسابوري ، عن محمد بن عبد الله المديني ، قال : حدثني عبد الله بن حفص PageV02P687 أبو طلحة الأنصاري ، قال : حدثني إسحاق بن عبد الله بن أبي طلحة ، عن أنس بن مالك ، قال : دخل 
ms352	 النبي ( 2 / 18 ) [ صلى الله عليه وسلم ] بيت أبي طلحة وله بني ، فقال : ما كنيته ؟ فقال : أبو عمير ، فقال : يا أبا عمير ما فعل النغير ؟ .(@)(@@) 1210 - قال : أخبرني أحمد بن شعيب ، قال : أنبأ أحمد بن عبيد الله بصري ، قال : حدثنا أبو قتيبة ، عن شداد أبي طلحة ، عن معاوية بن قرة ، عن ابن عباس ، أن رسول الله [ صلى الله عليه وسلم ] قال : يا معشر شباب بني هاشم ! اتقوا الله ولا تزنوا ألا من حفظ الله فرجه كنت له ضامنا بالجنة . PageV02P688(@)(@@)(@@)(@@) ||| ( المفاريد في حرف الطاء )(@)(@@)(@@)(@@) $ * أبو طلق علي بن حنظلة .(@)(@@)(@@)(@@) $ * وأبو طلق عمرو بن حسان .(@)(@@)(@@)(@@) $ * وأبو طالوت عبد السلام بن شداد .(@)(@@)(@@)(@@) $ * وأبو طرفة عباد بن ريان .(@)(@@)(@@)(@@) $ * وأبو طوالة عبد الله بن عبد الرحمن الأنصاري .(@)(@@)(@@)(@@) $ * وأبو الطفيل شبيل بن عوف .(@)(@@)(@@)(@@) $ * وأبو طعمة نسير بن ذعلوق .(@)(@@) 1211 - حدثنا بشر بن موسى ، قال : حدثنا أبو بكر بن أبي شيبة ، قال : حدثنا أبو أسامة ، قال : حدثنا أبو طلق علي بن حنظلة ، قال : حدثني أبي ، عن أوس بن ثريب ، قال : أكريت جرير بن عبد الله في الحج ، فقدم على عمر ، فسأله كيف تجد نساءك ؟ فقال : يا أمير المؤمنين ؟ ما أستطيع أن أقبل إحداهن في غير يومها إلا اتهمتني الأخرى ، ولا أخرج مخرجا إلا قالت كنت عند فلانة ، فقال عمر : إن كثيرا منهن لا يؤمن بالله ولا يؤمن للمؤمنين ، لعلك أن تكون في حاجة بعضهن ، أو تأتي السوق فتشتري الحاجة لبعضهن فتتهمك ، فقال ابن مسعود ، وهو عنده : يا أمير المؤمنين ! أما علمت أن إبراهيم شكى إلى ربه زرء خلق سارة ، فقال له : يا إبراهيم إن PageV02P689 المرأة كالضلع ، إن تركتها اعوجت ، وإن قومتها كسرتها فاستمتع بأهلك على ما فيهن ، فضرب عمر بين كتفي عبد الله ، وقال : لقد جعل الله في قلبك يا ابن مسعود من العلم غير قليل .(@)(@@) 1212 - حدثنا علي بن سهل الرملي ، قال : حدثنا الوليد بن مسلم ، عن يحيى بن حمزة ، عن أبي طرفة الحمصي ، قال : أتينا المقدام بن معد يكرب صاحب رسول الله [ صلى الله عليه 
ms353	 وسلم ] ، وهو في قرية من قرى حمص على أربعة أميال منها في يوم عيد ، فقلنا : أخرج فصل بنا ، فقال : لا ولكن صلوا فرادى .(@)(@@) 1213 - حدثنا أبو القاسم يزيد بن محمد بن عبد الصمد ، قال : حدثنا ابن عائذ ، قال : حدثنا الوليد بن مسلم ، قال : قال أبو طرفة عباد بن ريان اللخمي ، [ قال ] : سمعت عروة بن رويم ، قال : حدثني عامر بن لدين قاضي الناس مع عبد الملك بن مروان ، قال : سمعت أبا ليلى الأشعري يقول : حدثني أبو ذر قال : قال رسول الله [ صلى الله عليه وسلم ] : أما إنه طعام طعم ، يعني زمزم ، مختصر من حديث إسلام أبي ذر الحديث الطويل .(@)(@@) حدثنا العباس بن محمد ، الدوري ، قال : حدثنا أبو نعيم الفضل بن دكين ، قال : حدثنا عبد السلام أبو طالوت ، قال : رأيت أبا عثمان النهدي شرطيا .(@)(@@) أخبرني معاوية بن صالح ، قال : حدثنا يحيى بن معين ، قال : أبو طالوت عبد السلام بن أبي حازم غنوي بصري ثقة . PageV02P690(@)(@@) 1214 - حدثنا إسحاق بن سيار ، قال : حدثنا عمرو بن عاصم ، عن سليمان بن محمد القافلاني ، قال : حدثنا أبو طالوت ، قال كنت مع عبد الملك ابن عبد الله الخثعمي ، وكان قد أدرك القرن الأول حتى إذا كنا بمقطعة الأنهار من درب الحدب ، لقي عبد الله بن بسر ، ومعه كتاب من عزى ، فقال : يا ابن أخي ! ما هذا ؟ قال : اشتريت والله من صاحب المقاسم ، فقال : يا ابن أخي ! اتق الغلول ، فإني سمعت رسول الله [ صلى الله عليه وسلم ] يقول : الخيط والمخيط ، وما فوق ذلك من النار .(@)(@@) سمعت العباس بن محمد ، يقول : نسير بن ذعلوق أبو طعمة .(@)(@@) 1215 - أخبرني ( 2 / 19 ) أحمد بن شعيب ، قال : أنبأ علي بن حجر ، قال : حدثنا شريك ، عن نسير بن ذعلوق أبي طعمة ، قال : رأيت ابن عمر يؤذن على راحلته في السفر ، ويقيم إذا نزل وكان يصلي بنا إلى بعيره .(@)(@@) 1216 - حدثنا إسحاق بن سيار ، قال : حدثنا إبراهيم بن عبد الرحمن ابن مهدي ، قال : حدثنا أبي ، عن سفيان ، عن أبي طعمة قال : كان الربيع بن خثيم 
ms354	 إذا رأى أصحاب الحديث قال : أعوذ بالله من شركم .(@)(@@) 1217 - حدثنا إسماعيل بن توبة القزويني ، قال : حدثنا إسماعيل بن جعفر ، قال : حدثنا عبد الله بن عبد الرحمن بن معمر بن حزم أبو طوالة الأنصاري ، سمع أنس بن مالك ، يقول : أتانا رسول الله [ صلى الله عليه وسلم ] PageV02P691 في دارنا ، فحلبنا له شاة ، فصب عليه من ماء بئرنا ، وأعطي رسول الله [ صلى الله عليه وسلم ] فشربه ، وكان أبو بكر عن يساره ، وعمر تجاهه ، وناس من الأعراب عن يمينه ، فقال عمر : يا رسول الله ! أبو بكر يؤذنه ليعطيه فضله ، فأعطاه رسول الله [ صلى الله عليه وسلم ] الأعراب ، وقال : الأيمنون .(@)(@@) سمعت العباس بن محمد الدوري ، قال : سمعت يحيى بن معين يقول : أبو طوالة ثقة . PageV02P692(@)(@@)(@@)(@@) || ( باب حرف الظاء )(@)(@@)(@@)(@@) ||| ( [ من كنيته أبو ظلال ، وأبو ظبيان وأبو ظفر ، وأبو ظبية ] )(@)(@@)(@@)(@@) $ * أبو ظلال هلال بن ميمون القسملي .(@)(@@)(@@)(@@) $ * وأبو ظبيان حصين بن جندب ، والد قابوس .(@)(@@)(@@)(@@) $ * وأبو ظفر عبد السلام بن مطهر .(@)(@@) حدثنا العباس بن محمد ، قال : حدثنا يحيى بن معين ، قال : أبو ظلال القسملي ، وهو ضعيف ، قلت ليحيى : ابن من هو ؟ قال : لا أدري .(@)(@@) قال : وسمعت يحيى يقول : أبو ظبية الكلاعي شامي صاحب معاذ بن جبل .(@)(@@) حدثنا العباس ، قال : سألت يحيى ، عن حديث الأعمش ، عن أبي ظبيان ، قال : قال لي عمر : يا أبا ظبيان ! اتخذ مالا .(@)(@@) قال يحيى : ليس هذا أبو ظبيان الذي يروي عن علي ، هذا أبو ظبيان آخر .(@)(@@) قال يحيى : وأبو ظبيان الذي روى عنه سلمة بن كهيل ، الذي يقول : كنت عند عمر ، فقال : كم عطاؤك ؟ هو أبو ظبيان القرشي ، ليس هو أبو ظبيان صاحب الأعمش ، هو رجل آخر . PageV02P693(@)(@@) قال : وسمعت يحيى يقول : في حديث عبد الرزاق ، عن سفيان عن قابوس ، عن أبي ظبيان ، عن علي ، قال : أتاه رجلان وقعا عل امرأة في طهر واحد ، قال يحيى ، هذا أبو ظبيان أبو قابوس ، واسمه : حصين بن جندب .(@)(@@) قال : وأبو ظبيان الجنبي صاحب الأعمش ، وليس في الدنيا إلا هذا إلا رجلا يروي عنه : مسعر في حديث عن أبي ظبيان 
ms355	 ، أن عمر قال : ما مالك ، هذا أبو ظبيان آخر ، قلت ليحيى : من هو ؟ قال : لا أدري .(@)(@@) 1218 - وأخبرني أحمد بن شعيب ، قال : أنبأ إسحاق بن إبراهيم ، قال : حدثنا مروان بن معاوية ، قال : حدثنا أبو ظلال هلال بن ميمون القسملي ، قال : سألني أنس بن مالك ، عن ذهاب بصري ، فأخبرته ، فقال : لأخبرنك [ حديثا ] حدثنا رسول الله [ صلى الله عليه وسلم ] ، عن جبريل عليه السلام ، عن ربه [ عز وجل ] قال : يقول [ الله شبحانه ] : ما من عبد أخذت كريمتيه فصبر واحتسب ، إلا لم أرض له ثوابا دون الجنة . PageV02P694(@)(@@)(@@)(@@) || ( باب [ حرف ] العين )(@)(@@)(@@)(@@) ||| ( [ حرف الألف في العين ] )(@)(@@)(@@)(@@) |||| ( من كنيته أبو عائشة )(@)(@@)(@@)(@@) $ * ( 2 / 20 ) أبو عائشة مسروق بن الأجدع بن مالك .(@)(@@)(@@)(@@) $ * وأبو عائشة الحارث بن سويد .(@)(@@)(@@)(@@) $ * وأبو عائشة زيد بن صوحان .(@)(@@)(@@)(@@) $ * وأبو عائشة والد العلاء .(@)(@@) 1219 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد ابن عمر قال : مسروق بن الأجدع أبو عائشة الهمداني ، هلك في إمارة يزيد ابن معاوية ، وكان عثمانيا ، اعتزل وأقام بالكوفة .(@)(@@) 1220 - أخبرني أبو عبيد القاضي علي بن الحسين ، قال : حدثنا الحسن ابن محمد ، قال : حدثنا أسباط بن محمد ، قال : حدثنا زكريا بن أبي زائدة ، عن عامر ، قال شتير بن شكل لمسروق ، وهما في المسجد : يا أبا عائشة ! إنما اجتمع هؤلاء لتحدثهم فحدثهم وأصدقك أو أحدثهم وتصدقني بما سمعت من عبد الله بن مسعود ، قال : مسروق : حدثهم وأصدقك ، فقال شتير : PageV02P695 سمعت عبد الله بن مسعود يقول : إن أعظم ما خلق الله من شيء بأرض أو سماء أو جنة أو نار الآية التي في سورة البقرة أعظم منه ، ثم تلا عبد الله : @QB@ الله لا إله إلا هو @QE@ إلى آخر الآية .(@)(@@) حدثنا العباس [ بن محمد ] ، قال : حدثنا يحيى بن معين ، قال : الحارث بن سويد كنيته أبو عائشة .(@)(@@) 1221 - حدثنا يزيد بن سنان ، قال : حدثنا محمد بن كثير ، قال : حدثنا سليمان بن كثير ، عن الحصين ، عن العلاء بن أبي عائشة ، عن أبيه عن رأس الجالوت ، قال : كنا نسمع إنه يقتل بكربلاء ابن نبي ، فكنت إذا 
ms356	 دخلتها ، ركضت دابتي حتى أخلفها ، فلما قتل الحسين جعلت أسير على هينتي . PageV02P696(@)(@@)(@@)(@@) |||| ( من كنيته أبو العالية )(@)(@@)(@@)(@@) $ * أبو العالية عبد الله بن سلمة روى عنه : أبو إسحاق السبيعي ، وعمرو ابن مرة .(@)(@@)(@@)(@@) $ * وأبو العالية الرياحي رفيع ، روى عن : أبي بن كعب .(@)(@@)(@@)(@@) $ * وأبو العالية البراء زياد بن فيروز .(@)(@@)(@@)(@@) $ * وأبو العالية سعيد بن مرثد الرحبي ، حدث عنه : حريز بن عثمان .(@)(@@)(@@)(@@) $ * وأبو العالية شداد الكوفي ، روى عنه : أبو حيان .(@)(@@)(@@)(@@) $ * وأبو العالية قيراط ، روى عنه : شريك .(@)(@@) 1222 - حدثنا يحيى بن حبيب بن عربي ، قال : حدثنا معتمر بن سليمان ، قال : حدثني أبي ، عن الربيع بن أنس ، عن رفيع أبي العالية ، عن أبي بن كعب في قول الله جل ثناؤه : @QB@ وإذ أخذ ربك من بني آدم من ظهورهم ذريتهم وأشهدهم على أنفسهم @QE@ قال : جمعهم فجعلهم أرواحا ثم صورهم واستنطقهم ، فتكلموا وأخذ عليهم العهد والميثاق ، وأشهدهم على أنفسهم : ألست بربكم ؟ قالوا : بلى .(@)(@@) 1223 - حدثني أبو بكر بن علي وكيل دار العباس بحمص ، قال : حدثنا داود بن رشيد ، قال : حدثنا حفص ، عن عاصم ، عن أبي العالية البراء PageV02P697 زياد بن فيروز ، في قوله تعالى : @QB@ كانوا قليلا من الليل ما يهجعون @QE@ قال : كانوا لا ينامون بين المغرب والعشاء .(@)(@@) سمعت العباس بن محمد ، عن يحيى بن معين ، قال : أبو العالية البراء اسمه : زياد بن فيروز .(@)(@@) وأبو العالية الرياحي اسمه : رفيع ، قال شعبة : قد أدرك رفيع أبو العالية علي بن أبي طالب عليه السلام ، ولم يسمع منه شيئا .(@)(@@) قال : أبو العالية أيضا عبد الله بن سلمة ، يروي عنه : أبو إسحاق السبيعي ، وليس هو الذي يروي عنه : عمرو بن مرة .(@)(@@) وفي موضع آخر قال : سمعت يحيى قال : عبد الله بن سلمة ( 2 / 21 ) الذي يروي عنه عمرو بن مرة ، وأبو إسحاق السبيعي كنيته أبو العالية .(@)(@@) 1224 - حدثنا محمد بن عبد الله بن يزيد ، قال : حدثنا أبي ، قال : حدثنا حماد بن سلمة ، عن داود بن أبي هند ، عن رفيع أبي العالية .(@)(@@) 1225 - وذكر نصر بن علي الجهضمي ، قال : أنبأني أبي ، عن الحسن بن أبي الحسناء ، عن 
ms357	 أبي العالية البراء أذينة ، عن ابن عباس ، أن رسول الله [ صلى الله عليه وسلم ] أهل بالحج ، فقدم مكة لأربع مضين من ذي الحجة فصلى الصبح بالبطحاء ، ثم قال : من شاء أن يجعلها عمرة فليجعلها . PageV02P698(@)(@@)(@@)(@@) |||| ( من كنيته أبو عاصم )(@)(@@)(@@)(@@) $ * أبو عاصم عبيد بن عمير الليثي مكي .(@)(@@)(@@)(@@) $ * وأبو عاصم عبد الله بن عبد الرحمن بن أبي حسين مكي .(@)(@@)(@@)(@@) $ * وأبو عاصم علي بن عبيد الله ، روى عنه : الثوري ، وأبو أدريس .(@)(@@)(@@)(@@) $ * وأبو عاصم رفاعة بن شداد .(@)(@@)(@@)(@@) $ * وأبو عاصم العباداني عبد الله بن عبيد الله .(@)(@@)(@@)(@@) $ * وأبو عاصم القاسم بن أبي بزة مكي .(@)(@@)(@@)(@@) $ * وأبو عاصم أحمد بن أسد البجلي ، يروي عن : عبثر .(@)(@@)(@@)(@@) $ * وأبو عاصم محمد بن أيوب .(@)(@@)(@@)(@@) $ * وأبو عاصم الضحاك بن مخلد الشيباني .(@)(@@)(@@)(@@) $ * وأبو عاصم سعد بن زياد .(@)(@@)(@@)(@@) $ * وأبو عاصم جبلة بن أبي سليمان .(@)(@@)(@@)(@@) $ * وأبو عاصم سمير .(@)(@@) 1226 - حدثنا علي بن عبد العزيز ، قال : حدثنا الحسن بن الربيع ، قال : حدثنا أبو الأحوص ، عن سمير أبي عاصم ، قال : كان يقال : شرف المؤمن الصلاة في جوف الليل ، وعزه استغناؤه عما في أيدي الناس ، PageV02P699 وكان يقال : المؤمن لا يجزع من ذل الدنيا ، ولا ينافس في عزها .(@)(@@) 1227 - حدثنا أبو هاشم زياد بن أيوب ، قال : حدثنا عبد الله بن إدريس ، قال : سمعت أبا عاصم علي بن عبيد الله يذكر ، قال : دعانا يسار بن نمير إلى طعام عند المغرب ، فقالوا : الصلاة ، فقال يسار : إن عمر كان يقول إذا اجتمع : صلاتكم وطعامكم فابدءوا بطعامكم ، ثم افرغوا لصلاتكم .(@)(@@) 1228 - قال محمد بن إسماعيل البخاري : حدثنا موسى بن إسماعيل ، قال : حدثنا سعد أبو عاصم ، عن الأسود ، قال : كنت أشتري لعمر بن عبد العزيز حوائجه .(@)(@@) 1229 - حدثنا الحسن بن علي بن عفان ، قال : حدثنا معاوية بن هشام ، قال : حدثنا سفيان ، عن أبي عاصم ، قال : سالت عطاء عن رجل أصاب مالا من عماله ، فأراد أن يخرج منه ، قال : يرده إلى أهله ، قلت : لا يقدر عليهم ، قال : يتصدق به ولا أجر له ، ولا أراه يفلت من وزره .(@)(@@) 1230 - حدثنا أبو يعلى زكريا بن خلاد ، قال : حدثنا الأصمعي 
ms358	 ، قال : حدثنا سعد أبو عاصم مولى سليمان بن علي ، وكان قد ادرك عمر بن عبد العزيز ، قال : عزى أعرابي عمر بن عبد العزيز على ابن له ، فقال :(@)(@@) % تعز أمير المؤمنين فإنه % % لما قد ترى يعزى الصغير ويولد %(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أبو عاصم العباداني ، ليس به بأس .(@)(@@) 1231 - أخبرني أحمد بن ( 2 / 22 ) شعيب ، قال : حدثنا إسحاق بن إبراهيم ، قال : أنبأ أبو عاصم العباداني عبد الله بن عبيد الله ، قال : حدثنا PageV02P700 علي بن زيد ، عن يوسف بن مهران ، عن ابن عباس ، قال : قال رسول الله [ صلى الله عليه وسلم ] : لا ينبغي لأحد أن يكون خيرا من يحيى بن زكريا ، ذكره الله جل ثناؤه في القرآن ، فقال : @QB@ يا يحيى خذ الكتاب بقوة @QE@ ما عمل سيئة قط ولا هم بها .(@)(@@) 1232 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن العلاء في حديثه ، عن ابن إدريس ، عن علي بن عبيد الله الغطفاني ، أن أبا عاصم قال : دعانا يسار بن نمير فأتينا بالطعام ، وحضرت الصلاة ، فقال بعض القوم : الصلاة ، فقال يسار بن نمير : إن عمر كان يقول : إذا حضرت صلاتكم وطعامكم ، فابدؤا بطعامكم ، ثم افرغوا لصلاتكم .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى [ بن معين ] ، يقول : أبو عاصم العباداني ، كان ينزل بعبادان ، ولم يكن به بأس .(@)(@@) وأبو عاصم الثقفي ، كوفي ، وهو ثقة .(@)(@@) وأبو عاصم العبسي ، هو علي بن عبيد الله ، يروي عنه : سفيان الثوري ، وحماد بن سلمة .(@)(@@)(@@)(@@) $ * وأبو عاصم الغنوي ، يروي عنه : حماد بن سلمة .(@)(@@)(@@)(@@) $ * [ وأبو عاصم عصمة . PageV02P701(@)(@@)(@@)(@@) $ * وأبو عاصم البجلي عمرو بن عبد الله .(@)(@@)(@@)(@@) $ * وأبو عاصم التمار ] .(@)(@@) أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : أبو عاصم البجلي عمرو بن عبد الله ، سمع من عمر ، وكان شاميا ، ثم نزل الكوفة .(@)(@@) 1233 - حدثنا أحمد بن المقدام العجلي أبو الأشعث ، قال : حدثنا المعتمر بن سليمان ، قال : حدثنا عصمة أبو عاصم ، عن عطاء بن السائب ، عن مقسم ، عن ابن عباس ، قال : أول ما خلق الله 
ms359	 من شيء القلم ، خلقه من هجأ : ق ل م ، قال : فتصور قلما من نور ، طوله ما بين السماء والأرض ، فقال له : اجر في اللوح المحفوظ ، قال : يا رب بماذا ؟ قال : بما يكون إلى يوم القيامة ، قال : فلما خلق الله الخلق وكل بالخلق حفظة يحفظون عليهم أعمالهم ، فإذا كان يوم القيامة عرضت عليهم أعمالهم ، فقيل : @QB@ هذا كتابنا ينطق عليكم بالحق إنا كنا نستنسخ ما كنتم تعملون @QE@ أي : من اللوح المحفوظ ، قال : فيعارض بين الكتابين ، فإذا هما سواء .(@)(@@) 1234 - أخبرني أبو عبيد القاضي علي بن الحسين ، عن الحسن بن محمد الزعفراني ، قال : حدثنا داود بن مهران ، قال : حدثنا عبد الجبار بن الورد ، قال : سمعت القاسم بن أبي بزة يقول : خرجت أنا ومجاهد حتى قدمنا المدينة ، فبينا أنا وهو جالسين في مسجد المدينة ، فمر بنا عكرمة مولى ابن عباس ، فقال لي مجاهد : يا أبا عاصم ! اذهب إليه فسله عن قول الله PageV02P702 عز وجل : @QB@ فليبتكن آذان الأنعام ولآمرنهم فليغيرن خلق الله @QE@ وما تغيير خلق الله ؟ فأتيته ، فسالته قال : الإخصاء .(@)(@@) 1235 - ذكر أحمد بن محمد النوفلي ، قال : حدثنا إبراهيم بن المنذر ، قال : حدثنا مروان بن معاوية ، قال : حدثنا أزهر بن راشد ، عن أبي عاصم التمار ، عن سعيد بن جبير ، قال : كنت جالسا عند ابن عباس ، فأتاه رجل فسأله عن مسألة ، فقال : ما تقول يا سعيد ؟ قال : قلت : أنت ابن عباس وجئت أقتبس منك ؟ فقال : إذا كان لك جليس فسله فإنما هو فهم يؤتيه الله من يشاء .(@)(@@) 1236 - أخبرني بعض أصحابنا ، قال : حدثنا محمد بن أبي بكر المقدمي ، قال : حدثنا سعد بن زياد أبو عاصم ، قال : حدثنا إبراهيم بن محمد بن علي بن عبد الله بن جعفر ، عن أبيه محمد بن علي ، عن عائشة أم المؤمنين ، قالت : قال النبي [ صلى الله عليه وسلم ] : إن أول الناس فناء قومك ، فقلت : يا رسول الله ! هل هم إلا كالناس يفنون كما يفنى الناس ؟ قال : تستحليهم المنايا ، ويتنافس عليهم الناس ( 2 / 23 ) . PageV02P703(@)(@@)(@@)(@@) |||| ( من كنيته أبو عامر )(@)(@@)(@@)(@@) $ * أبو عامر سليم ، يحدث 
ms360	 عنه : ثابت بن عجلان .(@)(@@)(@@)(@@) $ * وأبو عامر عبد الله بن يحيى الهوزني .(@)(@@)(@@)(@@) $ * وأبو عامر عبد الله بن عامر الأسلمي .(@)(@@)(@@)(@@) $ * وأبو عامر عبيد بن حسان .(@)(@@)(@@)(@@) $ * وأبو عامر العقدي عبد الملك بن عمرو .(@)(@@)(@@)(@@) $ * وأبو عامر إبراهيم بن صدقة الأنصاري .(@)(@@)(@@)(@@) $ * وأبو عامر صالح بن رستم ، يحدث عنه : سعيد بن عامر .(@)(@@)(@@)(@@) $ * وأبو عامر قبيصة بن عقبة .(@)(@@)(@@)(@@) $ * وأبو عامر معمر بن يعمر ، يحدث عن : معاوية بن سلام .(@)(@@)(@@)(@@) $ * وأبو عامر موسى بن أبي الهيذام .(@)(@@)(@@)(@@) $ * وأبو عامر موسى بن عامر الليثي .(@)(@@)(@@)(@@) $ * [ وأبو عامر الكاهلي ] .(@)(@@) 1237 - حدثنا يعقوب بن سفيان ، قال : حدثنا أبو عاصم عثمان بن عامر الليثي ، قال : حدثنا [ يعقوب بن سفيان ، عن ] أبي عامر موسى بن PageV02P704 عامر ، عن عاصم بن الحدثان ، قال : قال عمران بن حصين : سمعت رسول الله [ صلى الله عليه وسلم ] يقول : من باع عقدة من غير حاجة أرسل الله على ذلك المال تالفا .(@)(@@) 1238 - حدثنا محمد بن المثنى ، قال : حدثنا إبراهيم بن صدقة الأنصاري أبو عامر ، قال : حدثنا سفيان بن حسين ، عن الزهري ، عن سالم ، عن ابن عمر ، قال : كتب رسول الله [ صلى الله عليه وسلم ] الصدقة ، فلم تخرج إلى عماله حتى قبض ، فلما قبض أخذها أبو بكر ، فعمل بها بعده ، فلما قبض أبو بكر أخذها عمر ، فعمل بها .(@)(@@) حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين يقول : أبو عامر الخزاز ، هو أبو عامر المزني ، وهو [ صالح ] بن رستم .(@)(@@) قال : وسمعت يحيى يقول : أبو حصين ، عن أبي عامر [ صالح ] الكاهلي سمع من : علي .(@)(@@) 1239 - أخبرني أحمد بن شعيب ، قال : أخبرني ابن المصفى ، قال : حدثنا يحيى بن سعيد العطار ، عن أبي عامر عبيد بن حسان ، عن عطاء ، عن أبي موسى الأشعري ، أنه سمع رسول الله [ صلى الله عليه وسلم ] يقول : يأجوج ومأجوج من ولد آدم . PageV02P705(@)(@@) وأخبرني أحمد بن شعيب ، قال : حدثنا إسحاق بن إبراهيم ، عن عيسى بن يونس ، قال : [ حدثنا ] أبو عامر الأسلمي عبد الله بن عامر ، عن نافع .(@)(@@)(@@)(@@) |||| ( من كنيته أبو عائذ ، وأبو عاتكة )(@)(@@)(@@)(@@) $ * أبو عائذ سيف السعدي ، يروي عنه : الجريري .(@)(@@)(@@)(@@) $ * وأبو عائذ 