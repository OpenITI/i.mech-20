ms312	 مهره عاج(@)(@@) 53 فارد عرصه تو باشی و به اقبال بری %~% نرد دولت که حریف ار همه باشد لیلاج PageV1P625(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا هست جهان به کام خان باد %~% خان کام‌ستان و کامران باد(@)(@@) 2 تا هست زمانه آن یگانه %~% سر خیل اعاظم زمان باد(@)(@@) 3 هر بنده بارگه نشینش %~% در مرتبه باد شه نشان باد(@)(@@) 4 خشت ته فرش آستانش %~% بر تارک هفتم آسمان باد(@)(@@) 5 ماوای همای دولت او %~% بالاتر از این نه آشیان باد(@)(@@) 6 ذاتش که یگانه زمانه است %~% ز آفات زمانه در امان باد(@)(@@) 7 دستش که همیشه تاج‌بخش است %~% افسر نه فرق فرقدان باد(@)(@@) 8 اقبال که مطلق‌العنان است %~% با او همه‌وقت همعنان باد(@)(@@) 9 نصرت ز پی عساکر او %~% پیوسته چو بی‌روان روان باد(@)(@@) 10 فتحش به ملازمت شب و روز %~% در سلسله ملازمان باد(@)(@@) 11 هر فتح که رخ نماید از خان %~% فتحی دگر از قفای آن باد(@)(@@) 12 از خیل غنیم او غنیمت %~% در لشگر وی جهان جهان باد(@)(@@) 13 خصمش که ز عمر می‌کشد رنج %~% منت کش مرگ ناگهان باد(@)(@@) 14 امروز چو شاه محتشم اوست %~% لطفیش به محتشم نهان باد(@)(@@) 15 او باقی و دولتش مقارن %~% بادولت صاحب الزمان باد(@)(@@) 16 این نظم بدیهه چون دعائیست %~% معروض به خان نکته‌دان باد PageV1P626(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 اگر چه مادر ایام خوش نتیجه فتاد %~% درین زمان پسری به نزاد از بهزاد(@)(@@) 2 مه سپهر حکومت که در زمانه او %~% زمانه را فزع دادخواه رفت از یاد(@)(@@) 3 گل بهار سخاوت که در محل کرم %~% درم چو برگ خزان می‌دهد کفش بر باد(@)(@@) 4 بجای خون همه یاقوت و لعل خواهد ریخت %~% به دست او نیش اگر زند فصاد(@)(@@) 5 گرفته کشور دلها که هست بر بازوش %~% دو فتح‌نامه ز دست کریم و طبع بداد(@)(@@) 6 به آن محیط کرم نسبت ملال ز بذل %~% چنان بود که به حاتم کنند بخل اسناد(@)(@@) 7 
ms313	 زبان به شکوه او هیچ دادخواه نراند %~% به غیر ظلم که از عدل اوست در فریاد(@)(@@) 8 خراش ناخن عدلش چو کوه ظلم بکند %~% بماند در دهن انگشت تیشه فرهاد(@)(@@) 9 به روی کشور ما تنگ از آن که منصب اوست %~% امارتی که زخانی و خسرویست زیاد(@)(@@) 10 جمال باز گرفتن نیافت ساقی دهر %~% چو بر کف املش ساغر مراد نهاد(@)(@@) 11 فلک نمود به زیر پرش چو بیضه مرغ %~% همای رفعت او بال ابهت چو گشاد(@)(@@) 12 چه حاجتست که او طایران دولت را %~% به دانه ریزی و دام‌افکنی شود صیاد(@)(@@) 13 که بهر صید مرادش درین کمند گاهند %~% نه آسمان سبب انگیز و بخت در امداد(@)(@@) 14 نقیض سوز و مخالف گداز و ضد کاهست %~% صلاح و رای وی اندر جهان کون و فساد(@)(@@) 15 چو آمد آن نصفت کیش داد گر به وجود %~% کشید رخت به سر منزل عدم بیداد(@)(@@) 16 بنای ظلم و تعدی ضعیف بنیان گشت %~% به دستیاری این دولت قوی بنیاد(@)(@@) 17 ز سهم ناوک آهن گداز هیبت او %~% ز موج گشته زره پوش از ازل پولاد(@)(@@) 18 ز بوسه کاری سکان آسمان فرمود %~% بهر مکان که ازو سایه بر زمین افتاد(@)(@@) 19 به جز درش که نه جای وقوع بیداد است %~% ندیده کس در دارالامارتی بیداد(@)(@@) 20 اگر شود متوجه به رفع ضدیت %~% دهند دست معیت به یکدیگر اضداد(@)(@@) 21 ز لطف خاص خود این بلده‌اش خدای علیم %~% که شهر خاص علی بود بی مضایقه داد(@)(@@) 22 جز او که والی معموره‌ای چنین شده است %~% ندیده گنج کسی در اماکن آباد(@)(@@) 23 عنان به دست ندادش چنان که بستاند %~% که کرد بخت بلندش سوار رخش مراد(@)(@@) 24 متاع هرکه چو نظم منش رواجی نیست %~% به عهد او شده بازار کاسدیش کساد(@)(@@) 25 چو ظلم گشت درین بلده کم وز یاوریش %~% اساس داوریش را خدا زیاد کند(@)(@@) 26 رسید عید و دل جمله تهنیت 
ms314	 گویان %~% ز دیدن رخ او کامیاب و خرم و شاد(@)(@@) 27 تو را چو پای روان نیست محتشم که روی %~% به سده بوسی آن نیر سپهر سداد(@)(@@) 28 به دستیاری نظمی که عزت تو ازوست %~% زبان خامه بجنبان پی مبارک‌باد(@)(@@) 29 امید آن که بود تا ز کعبه نام و نشان %~% که هست بر درش امروز ازدحام عباد(@)(@@) 30 بود جناب معلای او مطاف انام %~% به مصطفای معلا و عترت امجاد PageV1P627(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مرا غمی است ز بیداد چرخ بی‌بنیاد %~% که برده عشرتم از خاطر و نشاط از یاد(@)(@@) 2 مرا تبی است که گر از درون برون افتد %~% به نبض من نتواند طبیب دست نهاد(@)(@@) 3 مرا دلیست که هست از کمال بوالعجبی %~% به آه سرد گدازنده دل فولاد(@)(@@) 4 مرا رخیست کبود آن چنان ز سیلی غم %~% که روی اخگر پیکر گداخته ز رماد(@)(@@) 5 مرا سریست گران آن چنان که سرتاسر %~% زمین بلرزد اگر از تن افکند جلاد(@)(@@) 6 مرا ز داغ واسف سینه سربه سر مجروح %~% ز دیدن گل و شمشاد از چه باشم شاد(@)(@@) 7 مرا دمیست که نسبت به سوز بی‌حد او %~% دم از نسیم جنان می‌زند دم حداد(@)(@@) 8 مدام دلم همی آرد از مجره فلک %~% که مرغ روح من خسته را شود صیاد(@)(@@) 9 همیشه تیشه همی سازد از هلال سپهر %~% که در دلم نگذارد بنای عیش آباد(@)(@@) 10 اگر کنم سفری بس بعید نیست بعید %~% ور از وطن نروم هست جای استبعاد(@)(@@) 11 منم به دشت جنون سر نهاده چون مجنون %~% منم به کوه بلا پا فشرده چون فرهاد(@)(@@) 12 منم ز دست قضا نوش کرده زهر ستم %~% منم ز شست قدر خورده ناوک بیداد(@)(@@) 13 نخورده لقمه‌ای از خوان رزق خود بی‌دود %~% نبوده لحظه‌ای از دست بخت خود بیداد(@)(@@) 14 ز اقتضای قضا صد قضیه‌ام واقع %~% تمام عکس مرام و همه نقیض مراد(@)(@@) 15 ز افتراق احبا میان ما 
