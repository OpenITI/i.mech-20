ms6235	 أبو عبد الله.(@)(@@) التهذيب: ج 6، ح 822.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 3، ب 212، و ج 6.(@)(@@) ك 7، ب 19، ح 3. والتهذيب: ج 9.(@)(@@) ح 478.(@)(@@) * وروى محمد بن يحيى، عن بعض أصحابنا، عنه.(@)(@@) الكافي: ج 5، ك 2، ب 109، ح 17.(@)(@@) وب 159، ح 8، والتهذيب: ج 7، ح 994.(@)(@@) وروى عنه المعلى بن محمد.(@)(@@) الكافي: ج 6، ك 8، ب 29، ح 8.(@)(@@) * وروى عن الحسن بن معاوية بن وهب، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 6، ب 49، ح 4، * وروى عن حمزة بن عبد الله، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 8، ب 43. ح 7.(@)(@@) * وروى عن سعد، وروى عنه أحمد ابن أبي عبد الله.(@)(@@) الكافي: ج 6. ك 8، ب 64، ح 5.(@)(@@) * وروى عن سعيد بن جناح. وروى عنه أحمد بن محمد بن خالد.(@)(@@) الكافي: ج 2، ك 1، ب 126، ح 11، وك 2، ب 27، ح 5، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 8، ب 28، ح 1.(@)(@@) * وروى عن سليمان بن رشيد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 67. ح 1.(@)(@@) * وروى عن سليمان المسترق، وروى عنه سهل بن زياد.(@)(@@) الروضة: ح 168.(@)(@@) * وروى عن صالح بن اللفائفي، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 3، ب 3. ح 3.(@)(@@) * وروى عن صفوان بن يحيى، وروى محمد بن أحمد، عمن ذكره، عنه. PageV19P508(@)(@@) الكافي: ج 4، ك 2، ب 66، ح 4، وروى عنه محمد بن الحسين، الكافي ج 1، ك 4، ب 102. ح 5.(@)(@@) * وروى عن عبد العزيز بن حسان البغدادي. وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 6، ك 6، ب 139، ح 1.(@)(@@) * وروى عن علي بن أسباط، وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 3، ب 68، ح 1.(@)(@@) وب 198، ح 9. والتهذيب: ج 5، ح 937، و 1573.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 5، ح 802.(@)(@@) وروى عنه المعلى بن محمد الكافي: ج 1، ك 4، ب 11، ح 19، و ج 2.(@)(@@) ك 1، ب 115، ح 10.(@)(@@) * وروى عن عمرو بن سعيد، وروى عنه أبو عبد الله.(@)(@@) التهذيب: ج 10، ح 387.(@)(@@) وروى عنه أحمد البرقي.(@)(@@) الكافي: ج 3، ك 4، ب 42، ح 3.(@)(@@) والتهذيب: ج 2، ح 1432.(@)(@@) وروى عنه سهل بن زياد.(@)(@@) الكافي: ج 4، ك 2، ب 1، ح 14.(@)(@@) * وروى عن عمرو بن عثمان، 
