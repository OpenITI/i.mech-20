ms605	 غیر چوب خاییدن %~% وگر ز اره نهی بر لب تبر دندان(@)(@@) 24 ایا رخ چو مهت بر بساط خوبی شاه %~% ز من سخن چو ز پیل است معتبر دندان(@)(@@) 25 بشعر پایه من زین سخن شود معلوم %~% که ناطق است ز تاریخ سن خر دندان(@)(@@) 26 ز خوان وصل تو نان امید خشک آمذ %~% مرا که در لب تو نیست کارگر دندان(@)(@@) 27 ازین سخن چه گشاید مرا ز خدمت تو %~% ز خوان تو چه خورم من بذین قدر دندان(@)(@@) 28 برای آنکه دلت نرم گردد این گفتم %~% ولی نکرد ز سختی در او اثر دندان(@)(@@) 29 برنج وعده تو سنگ عشوها دارد %~% خورم برنج و نگه دارم از حجر دندان(@)(@@) 30 امید پسته کور است بسته سر چون جوز %~% که از شکستن آن هست در خطر دندان(@)(@@) 31 حساب شعر چو سی و دو شد قلم بشکن %~% کزین نه کمتر باید نه بیشتر دندان(@)(@@) 32 زبانت ار چه دراز است قصه کوته کن %~% برو بپوش بخاموشی از نظر دندان PageV1P846(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 دلا گر دولتی داری طلب کن جای درویشان %~% که نوردوستی پیداست در سیمای درویشان(@)(@@) 2 برون شو از مکان و کون تا زیشان نشان یابی %~% چو در کون و مکان باشی نیابی جای درویشان(@)(@@) 3 بر ایشان که بشناسند گوهرهای مردم را %~% توانگر گر بود چون زر نگیرد جای درویشان(@)(@@) 4 چو مهر خوب رویانست در هر جان ترا جانی %~% اگر دولت ترا جا داد در دلهای درویشان(@)(@@) 5 مقیم مقعد صد قند درویشان بی مسکن %~% بنازد جنت ار فردا شود مأوای درویشان(@)(@@) 6 مبر از صحبت ایشان که همچو باد در آتش %~% در آب و خاک اثر دارد دم گیرای درویشان(@)(@@) 7 فلک را گرچه بازیهاست بر بالای اوج خود %~% زمین را سرفرازیهاست زیر پای درویشان(@)(@@) 8 بتقدیر ارچه گردون را همه زین سو بود گردش %~% بگردد آسمان زآن سو که گردد رای درویشان(@)(@@) 9 شب 
ms606	 قدرست و روز عید هر ساعت مه و خور را %~% اگر خود را بگنجانند در شبهای درویشان(@)(@@) 10 اگر چه جان ز مستوری چو صورت در نظر ناید %~% بتن در روی جان بیند دل بینای درویشان(@)(@@) 11 بزیر پای ایشانست در معنی سر گردون %~% بصورت گرچه گردونست بر بالای درویشان(@)(@@) 12 ز درهای سلاطین ار گدایان نان همی یابند %~% سلاطین ملک می یابند از درهای درویشان(@)(@@) 13 چو مردان سیف فرغانی مکن بیرون اگر مردی %~% ز دل اندوه درویشی ز سر سودای درویشان PageV1P847(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 نمی دانم که چون باشد بمعدن زر فرستادن %~% بدریا قطره آوردن بکان گوهر فرستادن(@)(@@) 2 شبی بی فکر این نقطه بگفتم در ثنای تو %~% ولیکن روزها کردم تأمل در فرستادن(@)(@@) 3 مرا از غایت شوقت نیامد در دل این معنی %~% که آب پارگین نتوان سوی کوثر فرستادن(@)(@@) 4 مرا آهن در آتش بود از شوقت ندانستم %~% که مس از ابلهی باشد بکان زر فرستادن(@)(@@) 5 چو بلبل در فراق گل ازین اندیشه خاموشم %~% که بانگ زاغ چون شاید بخنیاگر فرستادن(@)(@@) 6 حدیث شعر من گفتن بپیش طبع چون آبت %~% بآتش گاه زردشتست خاکستر فرستادن(@)(@@) 7 بر آن جوهری بردن چنین شعر آنچنان باشد %~% که دست افزار جولاهان بر زرگر فرستادن(@)(@@) 8 ضمیرت جام جمشیدست و دروی نوش جان پرور %~% بر او جرعه یی نتوان ازین ساغر فرستادن(@)(@@) 9 سوی فردوس باغی را نزیبد میوه آوردن %~% سوی طاوس زاغی را نشاید پر فرستادن(@)(@@) 10 بر جمع ملک نتوان بشب قندیل بر کردن %~% سوی شمع فلک نتوان بروز اختر فرستادن(@)(@@) 11 اگر از سیم و زر باشد ور از در و گهر باشد %~% بابراهیم چون شاید بت آزر فرستادن(@)(@@) 12 ز باغ طبع بی بارم ازین غوره که من دارم %~% اگر حلوا شود نتوان بدان شکر فرستادن(@)(@@) 13 تو کشورگیر آفاقی و شعر تو ترا لشکر %~% چنین لشکر ترا زیبد بهر کشور فرستادن(@)(@@) 14 مسیح عقل 
ms607	 می گوید که چون من خرسواری را %~% بنزد مهدیی چون تو سزد لشکر فرستادن(@)(@@) 15 چو چیزی نیست در دستم که حضرت را سزا باشد %~% ز بهر خدمت پایت بخواهم سر فرستادن(@)(@@) 16 سعادت می کند سعیی که با شیرازم اندازد %~% ولکن خاک را نتوان بگردون بر فرستادن(@)(@@) 17 اگر با یکدگر ما را نیفتد قرب جسمانی %~% نباشد کم ز پیغامی بیکدیگر فرستادن(@)(@@) 18 سراسر حامل اخلاص ازین سان نکتها دارم %~% ز سلطان سخن دستور و از چاکر فرستادن(@)(@@) 19 در آن حضرت که چون خاکست زر خشک سلطانی %~% گدایی را اجازت کن بشعر تر فرستادن PageV1P848(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 در شب زلف تو قمر دیدن %~% خوش بود خاصه هر سحر دیدن(@)(@@) 2 تا بکی همچو سایه خانه %~% آفتاب از شکاف در دیدن(@)(@@) 3 پرده بردار از آن رخ پرنور %~% که ملولم ز ماه و خور دیدن(@)(@@) 4 گرچه کس را نمی شود حاصل %~% لذت شکر از شکر دیدن(@)(@@) 5 هست دشوار دیدن تو چنان %~% که ز خود مشکلست سر دیدن(@)(@@) 6 روی منما بهر ضعیف دلی %~% گرچه ناید ز بی بصر دیدن(@)(@@) 7 که چو سیماب مضطرب گردد %~% دل مسکین ز روی زر دیدن(@)(@@) 8 میوه یی ده ز باغ وصل مرا %~% که دلم خون شد از زهر دیدن(@)(@@) 9 آشنای ترا سزد زین باغ %~% همچو بیگانگان شجر دیدن(@)(@@) 10 طالب رؤیت مؤثر شد %~% چون کلیم الله از اثر دیدن(@)(@@) 11 گرچه صبرم گرفته است کمی %~% شوقم افزون شود بهر دیدن(@)(@@) 12 زخم چوگان شوق می باید %~% بر دل از بهر ره نور دیدن(@)(@@) 13 گرد میدان عشق می نتوان %~% بسر خود چو گوی گردیدن(@)(@@) 14 ای دل ای دل ترا همه چیزی %~% شد میسر ازو مگر دیدن(@)(@@) 15 بفروغ چراغ عشق توان %~% هر دو عالم بیک نظر دیدن(@)(@@) 16 جان معنی و معنی جان را %~% در پس پرده صور دیدن(@)(@@) 17 اوست پیش و پس همه چیزی %~% چون غلط 
ms608	 می کنی تو در دیدن(@)(@@) 18 علم رسمیت منع کرد از عشق %~% بصدف ماندی از گهر دیدن(@)(@@) 19 مرد این ره نظر بخود نکند %~% از عجایب درین سفر دیدن(@)(@@) 20 گر سر این رهت بود شرطست %~% پای طاوس را چو پر دیدن(@)(@@) 21 نزد ما از خواص این ره هست %~% در یکی گام صد خطر دیدن(@)(@@) 22 چند خود را خلاف باید کرد %~% در مقامات خیر و شر دیدن(@)(@@) 23 تا دل و دیده اتفاق کنند %~% روی او را بیکدگر دیدن PageV1P849(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 روی تو عرض داد لشکر حسن %~% که رخ تست شاه کشور حسن(@)(@@) 2 شاه عشقت ستد ولایت جان %~% ملک دلها گرفت لشکر حسن(@)(@@) 3 بحر لطفی و چون برآری موج %~% دو جهان پر شود ز گوهر حسن(@)(@@) 4 همه اجزا چو روی دلبر گل %~% همه اعضا چو روی مظهر حسن(@)(@@) 5 چون تویی پادشاه سیم بران %~% سکه دارد ز نام تو زر حسن(@)(@@) 6 ما فقیران صابر عشقیم %~% شکر نعمت کن ای توانگر حسن(@)(@@) 7 زیر پایت فگند ماه کلاه %~% چون تو بر سر نهادی افسر حسن(@)(@@) 8 ای که در دور خوبی تو بسیست %~% دل و جان داده در برابر حسن(@)(@@) 9 وی تو از یک کرشمه در یکدم %~% داده صد جان نو بپیکر حسن(@)(@@) 10 ما از آن شب در احتراق غمیم %~% که طلوع از تو کرد اختر حسن(@)(@@) 11 همه منظر بحسن شد زیبا %~% لیک زیبا بتست منظر حسن(@)(@@) 12 بی رخت مه ندید برج جمال %~% بی لبت می نداشت ساغر حسن(@)(@@) 13 از عروسان حجله تقدیر %~% که روان گشته اند از بر حسن(@)(@@) 14 دست مشاطه قضا ناراست %~% هیچ کس را چو تو بزیور حسن(@)(@@) 15 گر بدیوان لطف خود نگری %~% ای رخت آفتاب خاور حسن(@)(@@) 16 نقطه یی مه بود ز خط جمال %~% ورقی گل بود ز دفتر حسن(@)(@@) 17 آن زمانی که از مشیمه غیب %~% مه و خورشید زاد مادر 
ms609	 حسن(@)(@@) 18 با تو همشیره بود پنداری %~% لطف یعنی کهین برادر حسن(@)(@@) 19 بت آزر بسوخت چون هیزم %~% تا رخت برافروخت آذر حسن(@)(@@) 20 خود بت بت شکن کجا آراست %~% همچو تو در زمانه آزر حسن(@)(@@) 21 عشق ما از جمال تو عرضیست %~% لیک دایم بقا چو جوهر حسن(@)(@@) 22 پادشاهی چو عقل گردن کش %~% از پی روی تست چاکر حسن(@)(@@) 23 تا رخ تو ندید سجده نکرد %~% عشق دل داده پیش دلبر حسن(@)(@@) 24 ذره با مهرت ار درآمیزد %~% راست چون مه شود منور حسن(@)(@@) 25 اندرین موسمی که دست قضا %~% بر جهان باز می کند در حسن(@)(@@) 26 شاخ مانند بچه طاوس %~% می برآرد یکان یکان پر حسن(@)(@@) 27 باغ در بر فگند حله سبز %~% شاخ بر سر نهاد چادر حسن(@)(@@) 28 لاله بر پای خاسته که ز شاخ %~% غنچه بیرون همی کند سر حسن(@)(@@) 29 بلبل آغاز کرده مدحت گل %~% راست گویی منم ثناگر حسن(@)(@@) 30 این قیامت نگر که از گل شد %~% عرصه خاک تیره محشر حسن(@)(@@) 31 خطبه مهر دوست می خواند %~% روز و شب برفراز منبر حسن(@)(@@) 32 این همه فعلها بتست مضاف %~% زآنکه اسم تو هست مصدر حسن PageV1P850(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 زهی از نور روی تو چراغ آسمان روشن %~% تو روشن کرده ای او را و او کرده جهان روشن(@)(@@) 2 اگر نه مقتبس بودی بروز از شمع رخسارت %~% نبودی در شب تیره چراغ آسمان روشن(@)(@@) 3 چراغ خانه دل شد ضیای نور روی تو %~% وگرنه خانه دل را نکردی نور جان روشن(@)(@@) 4 جواز از موی و روی تو همی یابند روز و شب %~% که در آفاق می گردند این تاریک و آن روشن(@)(@@) 5 اگر با آتش عشقت وزد بادی برو شاید %~% که خاک تیره دل گردد چو آب دیدگان روشن(@)(@@) 6 چو با خورشید روی تو دلش گرمست عاشق را %~% نفس چون صبح روشن دل برآید از دهان روشن(@)(@@) 7 
ms610	 اگر از آتش روی تو تابی بر هوا آید %~% کند ابر بهاری را چو آب اندر خزان روشن(@)(@@) 8 وگر از ابر لطف تو بمن برسایه یی افتد %~% چو خورشید یقین گردد دل من بی گمان روشن(@)(@@) 9 میان مجلس مستان اگر تو در کنار آیی %~% ببوسه می توان خوردن شرابی زآن لبان روشن(@)(@@) 10 قدت در مجمع خوبان چو سرو اندر چمن زیبا %~% رخت بر صفحه رویت چو گل در گلستان روشن(@)(@@) 11 خطت همچون شب و دروی رخی چون ماه تابنده %~% براتت رایجست اکنون که بنمودی نشان روشن(@)(@@) 12 دهان چون پسته و دروی سخن همچون شکر شیرین %~% رخت را رنگ گلنار و لبت چون ناردان روشن(@)(@@) 13 کمان ابروت بر دل خدنگی زد کزو هردم %~% مرا تیر مژه گردد بخون همچون سنان روشن(@)(@@) 14 من اشتر دل اگر یابم ترا در گردن آویزم %~% جرس وار و کنم هردم ز درد دل فغان روشن(@)(@@) 15 اگر خاک سر کویت دمی با سرمه آمیزد %~% بره بینی شود چون چشم میل سرمه دان روشن(@)(@@) 16 مرا بی ترک سر وصلت میسر گردد ار باشد %~% ز شیرینی دهن تلخ وز تاریکی مکان روشن(@)(@@) 17 فراقت آنچه با من کرد پنهان در شب تیره %~% کجا گفتن توان پیدا کجا کردن توان روشن(@)(@@) 18 رخ همچون قمر بنما ز زلف همچو شب ای جان %~% که تا گردد بنزد خلق عذر عاشقان روشن(@)(@@) 19 چو در وصف جمال تو نویسم شعر خود گردد %~% مرا همچون ید بیضا قلم اندر بنان روشن(@)(@@) 20 مرا در شب نمی باید چراغ مه که می گردد %~% بیاد روز وصل تو شبم خورشید سان روشن(@)(@@) 21 ز بهر سوختن پیشت چه مردانه قدم باشد %~% ز جیب شمع بر کردن سری چون ریسمان روشن(@)(@@) 22 ز نور عشق تو ناگه دلم چون روز روشن شد %~% بسان تیره شب کز برق گردد ناگهان روشن(@)(@@) 23 ز حسنت نور رو کم گشت 
ms611	 مر خوبان عالم را %~% چو شد خورشید پیدا مه نباشد آنچنان روشن(@)(@@) 24 بهر مجلس که جمع آیند خوبان همچو استاره %~% تو با آن روی پرنوری چو ماه اندر میان روشن(@)(@@) 25 چو رویت رخ نمود آنجا بجز تو کس نبود آنجا %~% وگر صد شمع بود آنجا تو کردی خانه شان روشن(@)(@@) 26 مرا اندوه خود دادی و شادی جز مرا کردی %~% رهی را قوت جان تعیین گدا را وجه نان روشن(@)(@@) 27 بمستی و بهشیاری بدیدم نیست چون دردی %~% بپیش لعل میگونت می چون ارغوان روشن(@)(@@) 28 ز یاقوت لبت گر عکس بر اجزای کان آید %~% دل تیره کند چون لعل جوهردار کان روشن(@)(@@) 29 چو خندد لعل تو در حال خلقی را کند شیدا %~% چو دم زد صبح گیتی را کند اندر زمان روشن(@)(@@) 30 دل اندر زلف تو پیداست همچون نور در ظلمت %~% که هرگز در شب تیره نمی ماند نهان روشن(@)(@@) 31 میان مردم غافل همی تابند عشاقت %~% چنان کندر شب تیره بتابند اختران روشن(@)(@@) 32 دلم کز ظلمت تن بد چو پشت آینه تیره %~% شد از انوار عشق تو چو روی نیکوان روشن(@)(@@) 33 چو اندر دل قدم زد عشق انده خانه دل را %~% بسان دست موسی شد ز پایش آستان روشن(@)(@@) 34 شبی در مجمع خوبان نقاب از روبر افگندی %~% ز نورش شمع رخشان را چو آتش شد دخان روشن(@)(@@) 35 دلم از عشق پرنورست و شعر از وصف تو نیکو %~% زلال از چشمه دان صافی شراب از جام دان روشن(@)(@@) 36 ز بهر آن رو پیشت رخی بر خاک می مالم %~% که از بس سنگ ساییدن شود نعل خران روشن(@)(@@) 37 من از دهشت درین حضرت سخن پوشیده می گویم %~% در اشعارم نظر کن نیک و حالم بازدان روشن(@)(@@) 38 بدین شعر ای صنم با من کجا گردد دلت صافی %~% بدم آیینه را هرگز کجا کردن توان روشن(@)(@@) 39 مرا زین طبع شوریده 
ms612	 سخن نیکو همی آید %~% چراغم من مرا باشد دهن تیره زبان روشن(@)(@@) 40 چو شمع اندر شب تیره همی گریم همی سوزم %~% مگر روزی شود چشمم بیار مهربان روشن(@)(@@) 41 ز بس کاید بنور دل بسوزم عود اندیشه %~% برآید هر نفس از من دمی آتش فشان روشن(@)(@@) 42 بدین رخسار گرد آلوده رنگم آنچنان بینی %~% که گویی بر سر خاکست آب زعفران روشن(@)(@@) 43 الا ای صوفی صافی کزآن حضرت همی لافی %~% مرا از علم ره کافی بگو یک داستان روشن(@)(@@) 44 درین بازار محتالان ترا عشقست سرمایه %~% برو از نور او بر کن چراغی در دکان روشن(@)(@@) 45 چو روی خود در آیینه ببینی پشت گردون را %~% گرت در کوزه قالب شود آب روان روشن(@)(@@) 46 بسیم و زر بود دایم دل بی عشق را شادی %~% باسپیداج و گلگونه شود روی زنان روشن(@)(@@) 47 تو در سود و زیان خود غلط کردی نمی دانی %~% ازین سرمایه نزد تو شود سود و زیان روشن(@)(@@) 48 ازین دنیا بدست دل برآور پای جان از گل %~% که آیینه برون ناید ز نمگین خاکدان روشن(@)(@@) 49 مجرد شو اگر خواهی خلاص از تیرگی خود %~% که چون شد گوشت دور از وی بماند استخوان روشن(@)(@@) 50 ز همت (نزد) معشوقست جای عاشقان عالی %~% از اختر در شب تیره است راه کهکشان روشن(@)(@@) 51 درین منزلگه دزدان مخسب آمن که کم باشد %~% بسان شمع بیداران چراغ خفتگان روشن(@)(@@) 52 شب ار چون شمع برخیزی و سوزی در میان خود را %~% بسان صبح روشن دل نشینی بر کران روشن(@)(@@) 53 بجوشی تا چو زر گردد سراسر خام تو پخته %~% بکوشی تا خبر گردد ترا همچون عیان روشن(@)(@@) 54 ازین تیره قفس بر پر که مر سیمرغ جانت را %~% نماند بال طاوسی درین زاغ آشیان روشن(@)(@@) 55 درین کانون تاریک ار بمانی همچو خاکستر %~% برآیی بر فلک همچون چراغ فرقدان روشن(@)(@@) 56 کمال الدین اسمعیل را بودست 
ms613	 پیش از من %~% یکی شعری ردیف آن چو جان عاشقان روشن(@)(@@) 57 چو در قندیل طبع من فزودی روغنی کردم %~% چراغ فکرت خود را بچوب امتحان روشن(@)(@@) 58 سوی آن بحر شعر ار کش ازین جو قطره یی بردی %~% کجا آب سخن ماندی ورا در اصفهان روشن(@)(@@) 59 چو ذکر دیگری کردی نماند شعر را لذت %~% چو با خس کرد آمیزش نماند آب روان روشن PageV1P851(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 هان ای رفیق خفته دمی ترک خواب کن %~% برخیز و عزم آن در میمون جناب کن(@)(@@) 2 ساکن روا مدار تن سایه خسب را %~% جنبش چو ذره در طلب آفتاب کن(@)(@@) 3 تا چون ستاره مشعله دار تو مه شود %~% بیدار باش در شب و در روز خواب کن(@)(@@) 4 زین بیشتر زیاده بود گفتن ای پسر %~% عمرت کمی گرفت برفتن شتاب کن(@)(@@) 5 زآن پیشتر که بارگی وقت سرکشد %~% رو دست در عنان زن و پا در رکاب کن(@)(@@) 6 اول در مجامله بر خویشتن ببند %~% پس خانه معامله را فتح باب کن(@)(@@) 7 نفست بسی دراهم انفاس صرف کرد %~% زآن خرج و دخل روز بروزش حساب کن(@)(@@) 8 در راه هرچه نفس بدان ملتفت شود %~% گر خود بهشت باشد از آن اجتناب کن(@)(@@) 9 گر او بشهد آرزویی کام خوش کند %~% آن شور بخت را نمک اندر جلاب کن(@)(@@) 10 خواهی که بر حقیقت کار افتدت نظر %~% بر روی حال خود ز شریعت نقاب کن(@)(@@) 11 چون عشق دوست ولوله اندر دلت فگند %~% بر خویشتن چو زلزله خانه خراب کن(@)(@@) 12 فعلی که عشق باطن آن را صواب دید %~% در ظاهر ار خطاست برو ارتکاب کن(@)(@@) 13 هم پای برفراز سلالیم غیب نه %~% هم دست در مشیمه ام الکتاب کن(@)(@@) 14 زآن پس بگو اناهو یا من هوانا %~% از معترض مترس و بجانان خطاب کن(@)(@@) 15 بیم سرست سیف ازین شطحها ترا %~% شمشیر نطق را پس ازین در قراب کن 
ms614	 PageV1P852(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 وصلست و هجر آنچه بهست اختیار کن %~% دانی که وقت می گذرد عزم کار کن(@)(@@) 2 اول چو چرخ گرد زمین و زمان برآی %~% وآنگه چو قطب گرد خود آخر مدار کن(@)(@@) 3 گیتی شکارگاه سعادت نهاده اند %~% ای باز چشم دوخته دولت شکار کن(@)(@@) 4 عالم پر از گلست ز عکس جمال دوست %~% روی همه ببین(و) ورا اختیار کن(@)(@@) 5 ای مفلس دریده گریبان ترا که گفت %~% دامن فرو گذار و تعلق بخار کن(@)(@@) 6 خرگه زدی برای اقامت درو ولیک %~% جای تو نیست خیمه فرو گیر و بار کن(@)(@@) 7 از آب چشم خاک ره دوست ساز گل %~% هر رخنه یی که در دل تست استوار کن(@)(@@) 8 روز وصال در همه ایام سایرست %~% آن روز را تو چون شب قدر انتظار کن(@)(@@) 9 ای یار ناگزیر که جان چون تو دوست نیست %~% با دوستان خویش مرا نیز یار کن(@)(@@) 10 هرچند عاشقان تو نایند در شمار %~% در دفتر حسابم ازیشان شمار کن(@)(@@) 11 جام وصالت از همه عشاق باز ماند %~% یک جرعه زآن نصیب من خاکسار کن(@)(@@) 12 خواهم که در ره تو شوم کشته چون حسین %~% با من کنون معامله حلاج وار کن(@)(@@) 13 آن ساعتی که باز رهانی مرا ز من %~% از زلف خود رسن ز قد خویش دار کن(@)(@@) 14 گر چنگ من بدامن وصلت رسد شبی %~% دستم چنانکه چشم امیدم چهار کن(@)(@@) 15 بسیار در منازل هجرت دویده ایم %~% وقتست بر جنیبت وصلم سوار کن PageV1P853(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 ایا سلطان ترا بنده ز سلطان بی نیازم کن %~% ز خسرو فارغم گردان و از خان بی نیازم کن(@)(@@) 2 ز سلطان بی نیازی نیست در دنیا توانگر را %~% بمن ده ملک درویشی ز سلطان بی نیازم کن(@)(@@) 3 چو شطرنج از پی بازیست هر شاهی که می بینم %~% مریز آب رخم را و ز شاهان بی نیازم کن(@)(@@) 4 امیران همچو 
ms615	 گرگان و رعیت گوسپندان شان %~% سگ درگاه خویشم خوان ز گرگان بی نیازم کن(@)(@@) 5 اگر چون بحر عمانند هریک معدن لؤلو %~% مرا لولو نمی باید ز عمان بی نیازم کن(@)(@@) 6 وگر دریای فیاضند وقت خود از آن دریا %~% ز فیضت قطره یی بر من بیفشان بی نیازم کن(@)(@@) 7 همه از ضعف ایمانست بر غیر اعتماد من %~% ازین کافردلان یارب بایمان بی نیازم کن(@)(@@) 8 جهان مأوای انسانست دروی نیک و بد باشد %~% ز بد مستغنیم دار وز نیکان بی نیازم کن(@)(@@) 9 برای زندگی تن نخواهم منت جان را %~% بعشقم زنده دل گردان و از جان بی نیازم کن(@)(@@) 10 مرا از بهر تن باید که نانی باشد اندر کف %~% ز جانم بار تن برگیر و از نان بی نیازم کن(@)(@@) 11 طمع دردیست در انسان که باشد مال درمانش %~% ببر این درد را از من ز درمان بی نیازم کن(@)(@@) 12 همه رنگست و بود نیاز نان را شاید این معنی %~% ز ننگ شرکت ایشان چو مردان بی نیازم کن(@)(@@) 13 ز حرص آدمی یارب زمین انبار موران شد %~% تو از انبار این موران چو مرغان بی نیازم کن(@)(@@) 14 قناعت مصر ملک است و جهان مانند کنعانی %~% چو یوسف ملک مصرم ده ز کنعان بی نیازم کن(@)(@@) 15 ندیدم نعمت از اخوان و بر نعمت حسد دیدم %~% بحق سوره یوسف ز اخوان بی نیازم کن(@)(@@) 16 عطای تست چون باران سخاشان هست چون شبنم %~% بلی از منت شبنم بباران بی نیازم کن(@)(@@) 17 چو از اقران صاحب نفس نقصانست حالم را %~% بدرویشان صاحب دل از اقران بی نیازم کن(@)(@@) 18 منم مانند خاقانی و روم امروز شروانم %~% بتبریزم فگن یارب ز شروان بی نیازم کن(@)(@@) 19 نگفتم همچو خاقانی ثنای هیچ خاقانی %~% تو از گنج عطای خود ز خاقان بی نیازم کن(@)(@@) 20 دل دنیاطلب کورست هان ای سیف فرغانی %~% بگو در راه دین یارب 
ms616	 ز کوران بی نیازم کن PageV1P854(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 دلا از آستین عشق دست کار بیرون کن %~% ز ملک خویش دشمن را بعون یار بیرون کن(@)(@@) 2 حریم دوستست این دل اگر نه دشمن خویشی %~% بغیر از دوست چیزی را درو مگذار بیرون کن(@)(@@) 3 تو چون گنجی و حب مال مارست ای پسر در تو %~% سخن بشنو برو از خود بافسون مار بیرون کن(@)(@@) 4 اگر از دست حکم دوست تیغ آید ترا بر سر %~% سپر در رو مکش جوشن درین پیکار بیرون کن(@)(@@) 5 تو در کعبه بتان داری ازین پندارها در دل %~% ز کعبه بت برون افگن ز دل پندار بیرون کن(@)(@@) 6 چو در مسجد سگان یابی مسلمان وار بیرون ران %~% چو در کعبه بتان بینی برو زنهار بیرون کن(@)(@@) 7 سرت را در فسار حکم خویش آورد نفس تو %~% گر از عقل افسری داری سر از افسار بیرون کن(@)(@@) 8 چو کار عشق خواهی کرد دست افزار یک سونه %~% چو اندر کعبه خواهی رفت پای افزار بیرون کن(@)(@@) 9 گرت در دل نیامد عشق و عاشق نیستی باری %~% برو با عاشقان او ز دل انکار بیرون کن(@)(@@) 10 تو می گویی که هشیارم ولیکن از می غفلت %~% هنوز اندر سرت مستیست ای هشیار بیرون کن(@)(@@) 11 گل و خارست پایت را درین ره هرچه پیش آید %~% هم از گل پا برون آور هم از پا خار بیرون کن(@)(@@) 12 تو اندر خویشتن دایم چو بو در گل چه ماندستی %~% چو برگ از شاخ و چون میوه سر از ازهار بیرون کن(@)(@@) 13 برو گر عاشق از جانی برو ای سیف فرغانی %~% گرت در دل جز او چیزیست عاشق وار بیرون کن PageV1P855(@)(@@)(@@)(@@) || [genre: Qt](@)(@@) 1 ای جمالت آیتی از صنع رب العالمین %~% باد بر روی تو از ایزد هزاران آفرین(@)(@@) 2 تو چنان شاهی که در منشور دولت درج کرد %~% عشق تو عشاق را انتم علی الحق 
