ms301	 أعللها ، % كمن يعلل بعد النهل بالعلل % 12(@)(@@) % لعل إلمامة بالجزع نابتة ، % كيما يهب نسيم البرء في عللي % % 13(@)(@@) % لوت إلي عنان الذل قائلة : % علام تعجل الأسفار والنقل % 14(@)(@@) % لمن تؤمل بالإعسار ؟ قلت لها : % على ابن أرتق ، بعد الله ، متكلي % % 15(@)(@@) % الباسم الثغر ، والأبطال عابسة ، % والمخصب الربع ، والأرضون في محل % 16(@)(@@) % لمن أضاءت بنور الله دولته ، % كأنها غرة في جبهة الدول % 17(@)(@@) % له يراع ، وعضب ما جرى وبرى % % إلا قضى ، ومضى بالرزق والأجل % 18(@)(@@) % لذنا به ، فرأينا من مناقبه % ما لاتشاهده الأبصار في رجل % 19(@)(@@) % ليث أضافت سجاياه حماسته % إلى السماح ، وناط العلم بالعمل % 20(@)(@@) % لك الفضائل ، يا نجم الملوك ، لقد % % جريت في المجد جري النوم بالمقل % PageV01P1314 21(@)(@@) % لزمت حد التقى عن كل فاحشة ، % حتى كأنك معصوم عن الزلل % 22(@)(@@) % لرب ليل عجاج كان أنجمه % شهب الصفاح وأطراف القنا الذبل % 23(@)(@@) % لذ الوغى للمواضي ، فانثنت طربا % به ، وماس القنا كالشارب الثمل % 24(@)(@@) % لولا فرار الأعادي من يديك به ، % لأصبحوا في فم الأيام كالمثل % 25(@)(@@) % لقيتهم بجياد قد كفلت لها % % أن لا ترى الشوس منها صورة الكفل % 26(@)(@@) % لي أيها الملك المنصور فيك فم % ما صاغ قبلك تبر المدح في رجل % 27(@)(@@) % لهوت عن مدح أهل الأرض مرتفعا % عنهم ، وعضب لساني غير ذي قلل % 28(@)(@@) % لو كان مثلك موجودا نظمت به % أضعاف ما نظموا فيه ذووالطول % 29(@)(@@) % لك الولاية ، فارق في علاك على % % هام السماك بعز غير منتقل % PageV01P1315 البحر : طويل 1(@)(@@) % مغانم صفو العيش أسنى المغانم ، % هي الظل ، إلا أنه غير دائم % 2(@)(@@) % ملكت زمام العيش فيها ، وطالما % % رفعت بها أولى وقوع الجوازم % 3(@)(@@) % مغاني الحمى جادت سحائب أدمعي % % عليك ، إذا جفت جفون الغمائم % 4(@)(@@) % ملاعب لهو كم قضيت بربعها % % لبانات أيام الصبا المتقادم % 5(@)(@@) % من الجانب الغربي من أرض بابل % معاهد أنس مشرقات المباسم % 6(@)(@@) % معالم بين القلعتين ، وإنما % % محل المعالي بين تلك المعالم % 7(@)(@@) % مكثت بها دهرا ، وعيني قريرة % بها ، ورواق العز عالي الدعائم % 8(@)(@@) % مقيلي ظهور الصافنات ، ومؤنسي % % رياض 
ms302	 الكلا دون الحشايا النواعم % 9(@)(@@) % ميع يقيني ضيم كل غضنفر % طويل نجاد السيف ماضي العزائم % 10(@)(@@) % متى جاد نادى ماله يا لطارق ، % وإن سار نادى عرضه يا سالم % PageV01P1316 11(@)(@@) % مواضي سرور لا انتفاع بذكرها ، % إذا لم أعدها بارتكاب العظائم % 12(@)(@@) % منبه عزم إنه غير راقد ، % وموقظ حزم إنه غير نائم % 13(@)(@@) % مطلت السرى حتى مللت ، كأنما % % علي مقام الذل ضربة لازم % 18(@)(@@) % منيع يقيني ضيم كل غضنفر % % 19(@)(@@) % متى جاد نادى ماله يا لطارق ، % وإن سار نادى عرضه يا لسالم % 23(@)(@@) % منعت عن الترحال عيسي ، ومنعها % % عن الملك المنصور إحدى العظائم % 24(@)(@@) % مليك جبال الأرض من حلمه انتشت ، % وأبحرها من جوده المتلاطم % 25(@)(@@) % مفرق شمل المال بعد اجتماعه ، % وفي راحتيه جمع شمل المكارم % 26(@)(@@) % مواهبه وقف على كل طالب ، % وأسيافه حتم على كل آثم % 27(@)(@@) % مقيم بآيات الندى كل قاعد ، % كما أقعدت أسيافه كل قائم % PageV01P1317 28(@)(@@) % محل الردى في سيفه وسنانه ، % وبحر الندى في كفه والبراجم % 29(@)(@@) % محا بسطاه ذكر عمرو وعنتر ، % وأحيا نداه ذكر معن وحاتم % 30(@)(@@) % مكارم كف لا تزال بها الورى % % مطوقة أعناقها كالحمائم % 31(@)(@@) % معودة بالبسط ، إلا إذا غدت % بمتن يراع ، أو بقائم صارم % 32(@)(@@) % مشيد العلى لا تارك خلة الندى ، % ولا سامع في الجود لومة لائم % 33(@)(@@) % مصر على بذل الهبات يسره ، % إذا أصبحت أمواله بالمآتم % 34(@)(@@) % مزيد العطا لا يلحق الجود منة ، % ولا يتبع الأموال حسرة نادم % 35(@)(@@) % مضيف الورى مثل الربيع بربعه ، % وأيامهم في ظله كالمواسم % 36(@)(@@) % مررنا حفاة في مقادس ربعه ، % كأنا مشاة فوق هام النعائم % 37(@)(@@) % مشينا ، ولو أنا وفينا بحقه ، % مشينا على الأحداق دون المناسم % PageV01P1318 38(@)(@@) % مدى الدهر لا زالت تحج بنو الرجا % % إليه ، وتحظى بالغنى والغنائم % PageV01P1319 البحر : طويل 1(@)(@@) % نعم لقلوب العاشقين عيون ، % يبين لها ما لا يكاد يبين % 2(@)(@@) % نظرنا بها ما كان قبل من الهوى ، % فدل على ما بعدها سيكون % 3(@)(@@) % نهانا النهى عنها ، فلجت قلوبنا ، % فقلنا : اقدمي ! إن الجنون فنون % 4(@)(@@) % نغض ونعفو للغرام ، إذا جنى 
ms303	 ، % ويقسو علينا حكمه ، فنلين % 5(@)(@@) % نرد حدود المرهفات كليلة ، % وتفتك فينا أعين وجفون % 6(@)(@@) % نهون في سبل الغرام نفوسنا ، % وما عادة ، قبل الغرام ، تهون % 7(@)(@@) % نطيع رماحا فوقهن أهلة ، % وكثبان رمل فوقهن غصون % 8(@)(@@) % نواعم شنت في المحبين غارة % بها اللدن قد ، والسهام عيون % 9(@)(@@) % نبال ، ولكن القسي حواجب ، % نصال ، ولكن الجفون جفون % 10(@)(@@) % نهبن قلوب العاشقين ، وغادرت % بجسمي ضنى للقلب منه شجون % PageV01P1320 11(@)(@@) % نحول وصبر قاطن ومقوض ، % ودمع وقلب مطلق ورهين % 12(@)(@@) % نسهل أحوال الغرام تجلدا ، % وإن سهول العاشقين حزون % 13(@)(@@) % نتابعه طورا ، ولا عروة الهوى % % بوثقى ولا حبل الزمان متين % 14(@)(@@) % نظن جميلا في الزمان ، وإنه % زمان لتصديع القلوب ضمين % 15(@)(@@) % نروم وعود الجود منه ، وقد غدت % لدى الملك المنصور ، وهي ديون % 16(@)(@@) % نبي سماح قد تحقق بعثه ، % له الرأي وحي ، والسماحة دين % 17(@)(@@) % نجت فئة لاذت به ، فتيقنت % بأن طريق الحق فيه مبين % 18(@)(@@) % نخي ، له العزم الشديد مصاحب ، % سخي ، له الرأي السديد قرين % 19(@)(@@) % نجيب ، لو أن البحر أشبه جوده ، % لما سلمت من جانبيه سفين % 20(@)(@@) % نفت عنه ما ظن العداة عزائم ، % هي الجيش والجيش الخميس كمين % PageV01P1321 21(@)(@@) % نمته إلى القوم الذين رماحهم % قضت في الوغى أن لا يضيق طعين % 22(@)(@@) % نجوم لها فوق السروج مطالع ، % ليوث لها تحت الرماح عرين % 23(@)(@@) % نفوسهم يوم الجدال جداول ، % وآراؤهم يوم الجدال حصون % 24(@)(@@) % نجعنا إليه من بلاد بعيدة ، % وكل له حسن الرجاء ضمين % 25(@)(@@) % نهضنا لنستسقي السحاب ، فجادنا % % سحاب ندى كفيه وهي هتون % 26(@)(@@) % نوافيك يا من قد غدت حركاته % % على الملك منها هيبة وسكون % 27(@)(@@) % نجازى بما نأتي إليك هدية ، % فنحمل در المدح ، وهو ثمين % 28(@)(@@) % نعمت ، ولا زالت ربوعك جنة ، % فمغناك حصن للعفاة حصين % 29(@)(@@) % نهبت الثنا والجود والمجد والعلى ، % ونلت الأماني ، والزمان سكون % PageV01P1322 البحر : منسرح 1(@)(@@) % هل علم الطيف عند مسراه ، % أن عيون المحب ترعاه ؟ % 2(@)(@@) % هيج أشواقنا بزورته ، % ثم انثنى ، والقلوب أسراه % 3(@)(@@) % هجعت كيما يزورني قمري ، % أعتب طرفي ظلما وألحاه % 4(@)(@@) % هلا أتى 
ms304	 ، والعيون ساهرة ، % والنوم بالنوح قد طردناه % 5(@)(@@) % هديت ، يا طيف ، قل لأهل منى % إن المعنى هواه أفناه % 6(@)(@@) % هوى إلى نحوكم يجاذبه ، % وهو الذي في البلاد أقصاه % 7(@)(@@) % هاجر لما هجرتموه ، فما % % أغناه عن أهله ومغناه % 8(@)(@@) % هام ، ولم يألف البلاد ، وإن % % فرت بتلك البلاد عيناه % 9(@)(@@) % هني عيش لولا فراقكم ، % أيقن أن الجنان مأواه % 10(@)(@@) % همت به في البلاد همته ، % ونال بالسعي ما تمناه % PageV01P1323 11(@)(@@) % هادنه دهره ، وراهنه ، % ورامه منعما وأرضاه % 12(@)(@@) % هذب أخلاقه الزمان ، وقد % % طهر مدح ابن ارتق فاه % 13(@)(@@) % هو السحاب الذي بشاشته % بارقه ، والحيا عطاياه % 14(@)(@@) % هتون جود ، سماح راحته % % جار على ماله ، فأفناه % 15(@)(@@) % همت على الناس سحبه ، فلكم % % قتيل فقر ، نداه أحياه % 16(@)(@@) % هيهات يدعى بالسحب نائله ، % فهو نضار ، وتلك أمواه % 17(@)(@@) % هول ، جميع الأهوال ترهبه ، % خطب ، جميع القلوب تخشاه % 18(@)(@@) % ها إن أمر الزمان في يده ، % يأمره تارة وينهاه % 19(@)(@@) % هلم يا طالب النوال إلى % % من فتكت بالنضار كفاه % 20(@)(@@) % هذا الذي أصبح الندى مثلا % يفصح عن ذكره ، وأسماه % PageV01P1324 21(@)(@@) % هادي البرايا بنور طلعته ، % محيي الرعايا بفيض جدواه % 22(@)(@@) % هلال أفق ، تيار مكرمة ، % تهوى الورى حسنه ، وحسناه % 23(@)(@@) % همام بأس ، سهل خلائقه ، % أنكرنا البؤس مذ عرفناه % 24(@)(@@) % هم بنا قبل أن نهم به ، % فجادنا قبل أن سألناه % 25(@)(@@) % هز ليرضي العلى عزيمته ، % فأصبح المال بعض قتلاه % 26(@)(@@) % هون بها اللهى ، فلو نطقت ، % يوما ، لقالت : أعزك الله % 27(@)(@@) % هني بك أيها الملك المنصو % % ر ، فالدهر فيك هناه % 28(@)(@@) % هويت طيب الثنا ، فلا برحت % تحدى إلى نحوكم مطاياه % 29(@)(@@) % هبت إلى مدحكم جوارحنا ، % فكلها بالثناء أفواه % PageV01P1325 البحر : طويل 1(@)(@@) % وحقك إني قانع بالذي تهوى ، % وراض ولو حملتني في الهوى رضوى % % 2(@)(@@) % وهبتك روحي فاقض منها ولا تخف ، % لأن عناني نحو غيرك لا يلوى % % 3(@)(@@) % وهى جلدي إن كان أضمر خاطري % % سلوا ، ولو أني قضيت من البلوى % % 4(@)(@@) % وحقك قد عز السلو ، فمن لي % % بوصل ، فإن المن أحلى من السلوى % % 5(@)(@@) % وجدت الهوى حلوا ، فلما 
ms305	 وردته % تأجن حتى شاب بالكدر الصفوا % % 6(@)(@@) % وأعبتني من خمر حبك نشوة ، % فها أنا حتى الحشر لا أعرف الصحوا % % 7(@)(@@) % ولعت بذكر الغانيات تموها % عن اسمك كيلا يعلم الناس من أهوى % % 8(@)(@@) % وأكثرت تذكاري لحزوى ورامة ، % وما رامة لولا هواك وما حزوى ؟ % 9(@)(@@) % وعدت جميلا ثم اخلفت موعدي ، % فما بال وعد الهجر عندك لا يلوى % % 10(@)(@@) % وصلت العدى رغما علي ، وحبذا % % لو أنك أصفيت الوداد لمن يسوى % % PageV01P1326 11(@)(@@) % وحق الهوى العذري ، وهي ألية % تنزه أرباب الغرام عن الدعوى % % 12(@)(@@) % وصالك للأعداء لا الهجر قاتلي ، % ولكن رأيت الصبر أولى من الشكوى % % 13(@)(@@) % وفيت لهم دوني ، فسوف أكيدهم % % بصبري إلى أن أبلغ الغاية القصوى % % 14(@)(@@) % وإلا ، فلا أضحت لنجب عزائمي % % إلى الملك المنصور عصب الفلا تطوى % % 15(@)(@@) % ولي لأمر المسلمين ، وحافظ % شرائط دين الله بالعدل والتقوى % % 16(@)(@@) % وصول ، عبوس ، قاطع ، متبسم ، % يخاف ويرجى عنده الحتف والجدوى % % 17(@)(@@) % ولي عن الفحشا ، سريع إلى الندى ، % بعيد عن المرأى ، قريب من النجوى % % 18(@)(@@) % وبال لمن عاداك ، وبل لمن راعا % % ك ، قحط لمن ناواك ، خصب لمن ألوى % % 19(@)(@@) % وفي يجازي المذنبين بعفوه ، % ولكنه عن ماله لا يرى العفوا % % 20(@)(@@) % ويصبح عن عيب الخلائق لاهيا ، % وعن رعيهم بالعدل لا يعرف السهوا % % PageV01P1327 21(@)(@@) % وأبلج قد راع الزمان سياسة ، % وشن على أمواله غارة شعوا % % 22(@)(@@) % وصفنا نداه للمطي ، فأطلعت % يداها ، وسارت نحوه تسرع الخطوا % % 23(@)(@@) % وظلت بها يكوي الهجير جلودها ، % وأخفافها من لذع قدح الحصى تكوى % % 24(@)(@@) % وبيد عسفت العيس في هضباتها ، % وأنضيت بالإدلاج في وعرها النضوا % % 25(@)(@@) % وردنا بها ربعا به مورد الندى ، % غزير ، ووعل الجود في ظله أحوى % % 26(@)(@@) % ولذنا بملك ليس يخلف وعده ، % إذا موعد الوسمي أخلف أو ألوى % % 27(@)(@@) % ولما أنخنا عيسنا بفنائه ، % أفادت يداه كل نفس بما تهوى % % 28(@)(@@) % وأوردنا من جود كفيه نعمة ، % وصير جنات النعيم لنا مأوى % % 29(@)(@@) % وحسبي من الأيام أني بظله ، % ولي جوده محيا ولي ربعه أحوى % % PageV01P1328 البحر : منسرح 1(@)(@@) % لا نلت من طيب وصلكم أملا ، % إن أنا حاولت عنكم 
ms306	 بدلا % % 2(@)(@@) % لا كان يوما يدوم ، غيركم ، % قلب على فرط حبكم جبلا % % 3(@)(@@) % لام عذولي عليكم سفها ، % وصارم الحب يسبق العذلا % % 4(@)(@@) % لاح غدا في الهوى يعنفني ، % وكلما لام في الغرام حلا % % 5(@)(@@) % لأهل نجد عندي عهود صبا ، % يحفظها القلب كلما بخلا % % 6(@)(@@) % لاعج شوقي إلى لقائهم ، % ينبه قلبي بهم إذا غفلا % % 7(@)(@@) % لامع برق الغرام يذكرني % % ربعا لقوم من الأنيس خلا % % 8(@)(@@) % لازمت من دونه القفار ، وقد % % تركت فيه الرفاق والخولا % % 9(@)(@@) % لاكت به خيلنا مراودها ، % ثم استحبت من بعدنا العطلا % % 10(@)(@@) % لأظهر الصافنات خيالة % منا ، وأما قلوبهن ، فلا % % PageV01P1329 11(@)(@@) % لأقطعن القفار ممتطيا % جواد عزم للنجم منتعلا % % 12(@)(@@) % لئن هممت كان لي همم % تفتح لي باهتمامها سبلا % % 13(@)(@@) % لا خفت بؤسا ، ونائل الملك المن % % صور للعالمين قد كفلا % % 14(@)(@@) % لابس ثوب العفاف مدرع % من سندس المجد والتقى حللا % % 15(@)(@@) % لاح فقوم تعد طلعته % رزقا ، وقوم تعده أجلا % % 16(@)(@@) % لأخصمن الزمان مرتجلا ، % وأنظمن القريض مرتجلا % % 17(@)(@@) % لاق بأمثاله ، ومحكمه % لمن غدا ذكر حلمه مثلا % % 18(@)(@@) % لأغزر المنعمين طول ندى ، % وأرفع العالمين طور على % % 19(@)(@@) % لأروع لا تزال راحته % تجود للناس قبلما تسلا % % 20(@)(@@) % لاحق شأو الكرام سابقهم ، % في جريه للعلى ، إذا قفلا % % PageV01P1330 21(@)(@@) % لاذ به الوافدون ، فامتلأت % منه يداهم ، وصدقوا الأملا % % 22(@)(@@) % لاجية من ندى يديه إلى % % ركن مشيد لعيهم حملا % % 23(@)(@@) % لا تخش يا ابن الكرام من زمن % أمرته بالصلاح ، فامتثلا % % 24(@)(@@) % لا واك قوم ، فكان حظهم % طل دم في الوغى وضرب طلى % % 25(@)(@@) % لاقيتهم ، والعجاج لو خضبت % به فروع الدجى لما نصلا % % 26(@)(@@) % لأنت من معشر بعدلهم % قوم زيغ الزمان ، فاعتدلا % % 27(@)(@@) % لان لك الدهر بعد شدته ، % فجاد للناس بعدما بخلا % % 28(@)(@@) % لأجل ذا أنجم العلى طلعت % به ، ونجم الضلال قد أفلا % % 29(@)(@@) % لأربع المجد منك آنسة ، % فلا خلا ربعها ، ولا عطلا % % PageV01P1331 البحر : خفيف تام 1(@)(@@) % يا هلالا من سلطة العي حيي ، % أشرق الصبح تحت ليل دجي % % 2(@)(@@) % يوسفي الجمال ، كم تاه صب % في معاني جماله اليوسفي % 3 
ms307	(@)(@@) % يا فتي في الأعراق واللحظ واللف % % ظ أي حسن بحسن خلق سوي % 4(@)(@@) % يستعير القضيب القود ، هامي الجو % % د ، حتف الضدود فتح الولي % 5(@)(@@) % يحمل اللدن للقتال ، ولم تغ % % ن بلدن من قده السمهري % % 6(@)(@@) % يرنو بعين تغنيه في قتله العش % اق عن كل ذابل يزني % 7(@)(@@) % يتلقى دم القلوب بخد % زانه نقط خاله العنبري % 8(@)(@@) % ن ويزري بالذابل الخطي % % قوسها خط حاجب محني % 9(@)(@@) % يقق ، مذ بدا العذار عليه ، % أنبت الآس في اللجين النقي % 10(@)(@@) % يتجنى من بعدما بات طوعي ، % ويسقيني من المدامة ري % PageV01P1332 11(@)(@@) % يمزج الكاس لي ، فإن عزت الرا % % ح سقاني من ريقه السكري % 12(@)(@@) % يمنح المستهام خمر رضاب ، % في حباب من ثغره اللؤلؤي % 13(@)(@@) % يهتكث الليل نورها ببروق % أذكرتنا برق الحمى الأرتقي % 14(@)(@@) % يا حداة المطي ها نور نجم ال % % دين قد لاح يا حداة المطي % 15(@)(@@) % يمموا نحوه تلقوا سماحا ، % ووليا يجودنا بولي % 16(@)(@@) % يرد الركب منه بحر سماح ، % من ولا الجود ، بحر روي % 17(@)(@@) % يقظ قد رعى الأنام بطرف ، % رد عنه الردى بطرف عمي % 18(@)(@@) % يافع ، شديد المعالي ، ووا % % تى الحكم من قبل رشده المرضي % 19(@)(@@) % يم جود جادت على الناس كفا % % ه ، فأغنت عن الحيا الوسمي % 20(@)(@@) % يتقي الهول منه طورا ، وطورا % جوده سعد لكل شقي % PageV01P1333 21(@)(@@) % يقسم الدول بالسطا والعطايا % % بين يومي إقامة ومطي % PageV01P1334 
