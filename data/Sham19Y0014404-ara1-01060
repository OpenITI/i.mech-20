ms1049	 وبينهم فتحا ونجني ومن معي من المؤمنين (118)}.(@)(@)(@@)(@@)(@@) || AUTO [118](@)(@)(@@) {فافتح بيني وبينهم فتحا} فاحكم بيني وبينهم حكما.(@)(@@) {ونجني ومن معي من المؤمنين} من قصدهم. قرأ ورش، وحفص: (معي) بفتح الياء، والباقون: بإسكانها (¬3).(@)(@@) ...(@)(@)PageV05P081(@)(@)(@@) {فأنجيناه ومن معه في الفلك المشحون (119)}.(@)(@)(@@)(@@)(@@) || AUTO [119](@)(@)(@@) {فأنجيناه ومن معه في الفلك المشحون} أي: المملوء من الناس والطير والحيوان كلها.(@)(@@) ...(@)(@@) {ثم أغرقنا بعد الباقين (120)}.(@)(@)(@@)(@@)(@@) || AUTO [120](@)(@)(@@) {ثم أغرقنا بعد الباقين} أي: أغرقنا بعد إنجاء نوح وأهله من بقي من قومه.(@)(@@) ...(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين (121)}.(@)(@)(@@)(@@)(@@) || AUTO [121](@)(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين}.(@)(@@) ...(@)(@@) {وإن ربك لهو العزيز الرحيم (122)}.(@)(@)(@@)(@@)(@@) || AUTO [122](@)(@)(@@) {وإن ربك لهو العزيز الرحيم} تقدم تفسير نظيرها.(@)(@@) ...(@)(@@) {كذبت عاد المرسلين (123)}.(@)(@)(@@)(@@)(@@) || AUTO [123](@)(@)(@@) {كذبت عاد المرسلين}.(@)(@@) ...(@)(@@) {إذ قال لهم أخوهم هود ألا تتقون (124)}.(@)(@)(@@)(@@)(@@) || AUTO [124](@)(@)(@@) {إذ قال لهم أخوهم هود} يعني: في النسب، لا في الدين.(@)(@@) {ألا تتقون}؟(@)(@)PageV05P082(@)(@)(@@) {إني لكم رسول أمين (125)}.(@)(@)(@@)(@@)(@@) || AUTO [125](@)(@)(@@) {إني لكم رسول أمين} على الرسالة.(@)(@@) ...(@)(@@) {فاتقوا الله وأطيعون (126)}.(@)(@)(@@)(@@)(@@) || AUTO [126](@)(@)(@@) {فاتقوا الله وأطيعون}.(@)(@@) ...(@)(@@) {وما أسألكم عليه من أجر إن أجري إلا على رب العالمين (127)}.(@)(@)(@@)(@@)(@@) || AUTO [127](@)(@)(@@) {وما أسألكم عليه من أجر إن أجري إلا على رب العالمين}.(@)(@@) ...(@)(@@) {أتبنون بكل ريع آية تعبثون (128)}.(@)(@)(@@)(@@)(@@) || AUTO [128](@)(@)(@@) {أتبنون بكل ريع} هو المكان المرتفع {آية} علامة.(@)(@@) {تعبثون} بمن مر بكم؛ لأنهم كانوا يبنون الغرف في الأماكن العالية؛ ليشرفوا على المارة، فيسخرون منهم، ويعبثون بهم.(@)(@@) ...(@)(@@) {وتتخذون مصانع لعلكم تخلدون (129)}.(@)(@)(@@)(@@)(@@) || AUTO [129](@)(@)(@@) {وتتخذون مصانع} أي: حصونا، وقيل: مصانع الماء تح