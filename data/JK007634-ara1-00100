ms81	 جبينها % % قبس تقنع في خمار دخان % 30(@)(@@) % ويلاه كم أشقى بهم وإلى متى % % فيهم يخلد بالجحيم جناني % % PageV01P239 31(@)(@@) % ولقد تصفحت الزمان وأهله % ونقدت أهل الحسن والإحسان % 32(@)(@@) % فقصرت تشبيبي على ظبياتهم % وحصرت مدحي في علي الشان % 33(@)(@@) % فهم دعوني للنسيب فصغته % وأبو الحسين إلى المديح دعاني % % 34(@)(@@) % ملك علي إذا هممت بمدحه % تملي شمائله بديع معاني % % 35(@)(@@) % جاريت أهل النظم تحت ثنائه % فتلوا وحلبتهم خيول رهان % 36(@)(@@) % مضمون ما نثرت علي بنانه % ولسانه أبرزته ببيان % 37(@)(@@) % % أذن الكليم وحل عقد لساني % % 38(@)(@@) % سمح إذا ما شئت وصف نواله % حدث ولا حرج عن الطوفان % 39(@)(@@) % بالبحر كن وبالغمام عن اسمه % والبدر والضرغام لا بفلان % 40(@)(@@) % صرعت ثعالبه الأسود فأصبحت % محشوة بحواصل الغربان % PageV01P240 41(@)(@@) % بطل يريك إذا تحلل درعه % أسد العربين بحلة الثعبان % 42(@)(@@) % رشف النجيع من الأسنة عنده % رشفات حمر بوارق الأسنان % 43(@)(@@) % يرتاح من وقع السيوف على الطلا % حتى كأن صليلهن أغاني % % 44(@)(@@) % ويرى كعوب السمر سمر كواعب % % وذكور بيض الهند بيض غواني % % 45(@)(@@) % لم يستطع وترا يلذ له سوى % % أوتار كل حنية مرنان % 46(@)(@@) % قرن يقارن حظه بحسامه % فيعود سعدا ذابح الأقران % 47(@)(@@) % صاح تدب الأريحية للندى % % فيه دبيب السكر بالنشوان % 48(@)(@@) % ذو رواحة هي للعدى جراحة % % 49(@)(@@) % % نقع ولمع مهند وسنان % 50(@)(@@) % أطواق فضل كالخواتم أصبحت % بيديه وهي طوارق الحدثان % PageV01P241 51(@)(@@) % بالنحس تقضي والسعادة فالورى % % منهن بين تخوف وأمان % 52(@)(@@) % في سلمها تهب البدور في الوغى % % بالشهب تقدف مارد الفرسان % 53(@)(@@) % قد أضحك الدنيا سرورا مثل ما % % أبكى السيوف وأعين الغزلان % 54(@)(@@) % حر تولد من سلالة مطلب % خلف الأيمة من بني عدنان % 55(@)(@@) % من هاشم أهل المفاخر والت قى % % والأمر بالمعروف والإيمان % 56(@)(@@) % بيت النبوة والرسالة والهدى % % والوحي والتنزيل والفرقان % 57(@)(@@) % قوم تقوم فيهم أود العلا % والدين أصبح آبد الأركان % 58(@)(@@) % قد حالفوا سهر العيون وخالفوا % % أمر الهوى في طاعة الرحمان % 59(@)(@@) % من كل من كالبدر كلف وجهه % أثر السجود فزاد في اللمعان % % 60(@)(@@) % أشباح نور في الزمان 
ms82	 وجودهم % روح لهذا العالم الجسماني % % PageV01P242 61(@)(@@) % أقران حرب كلما اقترنوا لدى ال % هيجاء تحسبهم ليوث قران % 62(@)(@@) % لبسوا سوابغهم لأجل سلامة ال % % أعراض لا لسلامة الأبدان % 63(@)(@@) % وتحملوا طعن الرماح لأنهم % لا يحملون مطاعن الشنآن % 64(@)(@@) % بوركت من ولد جريت بإثرهم % فبلغت غايتهم بكل مكان % 65(@)(@@) % جددت آثار المآثر منهم % وورثت ما حفظوا من القرآن % 66(@)(@@) % مولاي لا برحت تهنيك العلا % بختان غر أكرم الفتيان % 67(@)(@@) % نطف مطهرة الذوات أزدتهم % نورا على نور بطهر ختان % 68(@)(@@) % خلفاء مجد من بنيك كأنهم % للأرض قد هبطوا من الرضوان % 69(@)(@@) % أقمار تم لا يوقى نقصها % % إلا بليل عجاجة الميدان % 70(@)(@@) % وفراخ فتح قبل ينبت ريشها % % همت بصيد جوارح الشجعان % PageV01P243 72(@)(@@) % بلغوا وما بلغوا الكلام فأدركوا % % رشد الكهول بغرة الصبيان % 73(@)(@@) % ما جاوزوا قدر السهام بطولهم % % فتطولوا وسموا على المران % 74(@)(@@) % شرر توارت في زنادك إذ ورت % أمست شموس مسرة وتهان % 75(@)(@@) % قبسات أنوار تعود إلى اللقا % % شعلا تذيب مواضع الأضغان % 76(@)(@@) % سترد عنك المشرفية والقنا % % ولديك تشهد كل يوم طعان % 77(@)(@@) % وستضحك البيض الظبا بأكفهم % ضحك البروق بعارض هتان % % 78(@)(@@) % وتميل من خمر النجيع رماحهم % مثل السكارى في سلاف دنان % 79(@)(@@) % فاسلم ودم معهم بأسبغ نعمة % والذ عيش في أتم تدان % PageV01P244 البحر : طويل 1(@)(@@) % أما والهوى لولا الجفون السواحر % لما علقت في الحب منا الخواطر % 2(@)(@@) % ولولا العيون الناعسات لما رعت % نجوم الدجى منا العيون السواهر % 3(@)(@@) % ولولا ثغور كالعقود تنظمت % لما انتثرت منا الدموع البوادر % % 4(@)(@@) % ولم ندر كيف الحتف يعرض للفتى % % وما وجهه إلا الوجه النواضر % 5(@)(@@) % وإنا أناس دين ذي العشق عندنا % % إذا لم يمت فيه قضى وهو كافر % 6(@)(@@) % خولم يرضينا في الحب شق جيوبنا % % إذا نحن لم تنشق منا المرائر % 7(@)(@@) % لقينا المنايا قبل نلقى سيوفها % % تسل من الأجفان وهي نواظر % 8(@)(@@) % نروع المواضي وهي بيض فواتك % ونشفق منها وهي سود فواتر % 9(@)(@@) % ونخشى رماح الموت وهي معاطف % ونسطو عليها وهي سمر شواجر % 10(@)(@@) % نعد العذارى من دواهي 
ms83	 زماننا % % وأقتلها أحداقها والمحاجر % PageV01P245 11(@)(@@) % ونشكو إليها دائرات صروفه % وأعظمها أطواقها والأساور % 12(@)(@@) % لنا قدر في دفع كل ملمة % تلم بنا إلا النوى والتهاجر % 13(@)(@@) % وليس لنا لذع الأفاعي بضائر % إذا لم تظافرنا عليه الظفائر % 14(@)(@@) % ألم يكف هذا الدهر ما صنعت بنا % % لياليه حتى ساعدتها الغدائر % 15(@)(@@) % رعى الله حيا بالحمى لم تزل به % تعانق آرام الخدود الخوادر % 16(@)(@@) % تميل بقمصان الحديد أسوده % وتمرح في وشي الحرير الجآذر % 17(@)(@@) % حمته بطعنات الخواطر دونه % قدد الغواني والرماح الخواطر % 18(@)(@@) % محل به الأغصان تحمل عسجدا % وتنبت ما بين الشفاه الجواهر % 19(@)(@@) % وتلتف من فوق الغصون وتلتوي % % على مثل أحقاء اللجين المآزر % 20(@)(@@) % تظن عليه ألفت أنجم الدجى % % يدا ناظم أو فرق الدر ناثر % PageV01P246 21(@)(@@) % ملاعبه هالاته وبيوته % بروج الدراري والنوادي الدوائر % 22(@)(@@) % وحيا الحيا فيه وجوها إذا انجلت % تعيد ضياء الصبح والليل عاكر % 23(@)(@@) % وجوها ترى منها بدورا تعممت % ومنها شموسا قنعتها الدياجر % 24(@)(@@) % تردد ماء الحسن بين خدودها % % فأصبح منها جاريا وهو حائر % 25(@)(@@) % فديتهم من أسرة قد تشاكلت % مهاجرهم في فتكها والخناجر % 26(@)(@@) % إذا من مواضيهم نجا قلب زائر % فمن بيضهم ترديه سود بواتر % 27(@)(@@) % أقاموا على الأبواب حجاب هيبة % فلم يغشهم ليلا سوى النوم زائر % 28(@)(@@) % فلولاهم لم يصب صوت لمنشد % ولا هز أعطاف المحبين سامر % 29(@)(@@) % ولولا غوالي لؤلوء في نحورهم % وأفواههم لم يحسن النظم شاعر % 30(@)(@@) % فما الحسن إلا روضة ذات بهجة % وما هم إلا وردها والأزاهر % PageV01P247 31(@)(@@) % لقد جمع الله المحاسن فيهم % كما اجتمعت بابن الوصي المفاخر % 32(@)(@@) % سليل علي المرتضى وسميه % كريم أتت فيه الكرام الأكابر % 33(@)(@@) % عزيز لدى المسكين يبدي تذللا % وتسجد ذلا إذ تراه الجبابر % 34(@)(@@) % منير تجلى في سماوات رفعة % كواكبها أخلاقه والمآثر % 35(@)(@@) % مليك أقام الله في حمل عرشه % ملوكا هم أبناؤه والعشائر % 36(@)(@@) % عظيم يضيق الدهر عن كتم فضله % فلو كان سرا لم تسعه الضمائر % 37(@)(@@) % فما المجد إلا حلة وهو ناسج % وما الحمد إلا خمرة وهو عاصر % 38 
ms84	(@)(@@) % يسر العطايا وهو ذو شغف بها % % وهيهات تخفى من محب سرائر % 39(@)(@@) % يحدث عنه فضله وهو صامت % ويخفى نداه وهو في الخلق ظاهر % 40(@)(@@) % يغص العدا في ذكره وهو طيب % وكم طيذب فيه تغص الخناجر % PageV01P248 41(@)(@@) % إذا اشتد ضيق الأمر بان ارتخاؤه % وهل تحدث الصهباء لولا المعاصر % 42(@)(@@) % غمام إذا ضن الغمام بجوده % توالت علينا من يديه المواطر % 43(@)(@@) % فأين الجبال الشم من وزن حمله % ومن فتكه أين الأسود القساور % 44(@)(@@) % وأين ذووا الرايات منه إذا سطا % % وما كل خفاق الجناحين كاسر % 45(@)(@@) % همام أعاد المجد بعد مماته % وجدد رسم ألجود والجود داثر % 46(@)(@@) % وورد وجنات الظبى وتسودت % ببيض عطايا راحتيه الدفاتر % 47(@)(@@) % له شيم تصحو فتفني حطامه % هبات كما تفني العقول المساكر % 48(@)(@@) % فكم هم في عثر المنايا إلى المنى % % فجاز عليها والسيوف القناطر % 49(@)(@@) % وكم وقفة معروفة في العدا له % لها مثل في سائر الناس سائر % 50(@)(@@) % وكم موقف أثنت صدور القنايه % % عليه وذمته الكلى والخواصر % PageV01P249 51(@)(@@) % ولم أنس في المينات يوم تجمعت % قبائل أحزاب العدا والعشائر % 52(@)(@@) % عصائب بدو أخطأوا بادىء الهوى % % فراموه بالخذلان والله ناصر % 53(@)(@@) % تمنوا محالا لا يرام وخادعوا % % وقد مكروا والله بالقوم ماكر % 54(@)(@@) % أصروا على العصيان سرا وأظهروا % % له طاعة والكل بالعهد غادر % 55(@)(@@) % وقد جحدوا نعمى علي وأنكروا % % كما جحدوا نص القدير وكابروا % % 56(@)(@@) % توالوا على عزل الوصي ضلالة % وقد حسنوا الشورى وفيها تشاوروا % % 57(@)(@@) % شياطين إنس جمعوا حول كاهن % وأمة غي بينها قام ساحر % 58(@)(@@) % فقام إليهم إذ بغوا أدعياؤه % رعاة بها تجري العتاق الصوارم % 59(@)(@@) % وكل فتى مثل الشهاب إذا ارتمى % % غدا لشياطين العدا وهو داحر % 60(@)(@@) % وفرسان حرب من بنيه إلى العدا % % مواردهم معروفة والمصادر % PageV01P250 61(@)(@@) % أسود إذا ما كشر الحرب نابه % سطوا والظبا أنيابهم والأظافر % 62(@)(@@) % يهزون في نار الوغى كل جدول % يموج به بحر من الموت زاخر % 63(@)(@@) % هم عشرة في الفضل كاملة لهم % مآثر فخر للنجوم تكاثر % 64(@)(@@) % بهم شغفت منه الحواس مع القوى % % فصحت 
ms85	 له أعضاؤهم والعناصر % 65(@)(@@) % هم جمرات الحرب يوم حروبه % وفي السلم أسنى سمعه والمحاجر % 66(@)(@@) % إذا شرفوا فوق السروج حسبتهم % بدور تمام للمعالي تبادر % 67(@)(@@) % فمن شئت منهم فهو في السبق أول % ومن شئت منهم فهو في العز آخر % 68(@)(@@) % فلما التقى الجمعان وانكشف العطا % % وقد غاب ذهن المرء والموت حاضر % 69(@)(@@) % وقد حارت الأبصار فالكل شاخص % على وجنات الموت والريق غائر % 70(@)(@@) % وأضحت نفوس الشوس وهي بضائع % بسوق الردى والمكرمات المتاجر % PageV01P251 71(@)(@@) % سطا وسطوا في إثره يلحقونه % يريدون أخذ الثار والنقع ثائر % 72(@)(@@) % وصال وصالوا كالأسود على العدا % % ففروا كما فرت ظباء نوافر % 73(@)(@@) % فكم تركوا منهم هماما على الثرى % % طريحا ومنه الرأس بالجو طائر % 74(@)(@@) % فلم يخل منهم هارب من جراحة % فإن قيل فيهم سالم وهو نادر % 75(@)(@@) % تولوا وخلوا غانيات خدورهم % مبرقعة بالذل وهي سوافر % 76(@)(@@) % تنادي ولا فيهم سميع يجيبها % % فتلطم حزنا والرؤوس حواسر % 77(@)(@@) % فصاحت بأعلى الصوت يا حامي الحمى % % الحمى لعفوك مأمون مما تحاذر % 78(@)(@@) % فرد عليها سترها بعد هتكه % وبشرها بالأمن مما تحاذر % 79(@)(@@) % وأمست لديه في أتم صيانة % وإن عظمت من فوقهن الجرائر % 80(@)(@@) % فتبا لهم من معشر ضل سعيهم % وقد عميت أبصارهم والبصائر % PageV01P252 81(@)(@@) % لقد ضيعزا ما الله باللوح حافظ % وقد كشفوا ما الله بالغيب ساير % 82(@)(@@) % ألا فاسمعوا يا حاضرون نصيحة % تصدقها أعرابكم والحواضر % 83(@)(@@) % عظيم ملوك الفرس ترف قدره % وتغبطهم فيه وفيك القياصر % 84(@)(@@) % لقد شنف الأسماع در حديثه % وشمت فتيق المسك منه المناخر % 85(@)(@@) % فشكرا لربي حيث حفك لطفه % بنصر وحسبي أنك اليوم ظافر % PageV01P253 البحر : وافر تام 1(@)(@@) % خطبت المجد بالأسل العوالي % % ففزت بوصل ابكار المعالي % % 2(@)(@@) % وحاولت العلا فلذذت منها % % بشهد دونه لسع النبال % 3(@)(@@) % وجزت إلى الثنا لجج المنايا % % فخضت اليم في طلب اللآلي % % 4(@)(@@) % وقارعت الخطوب السود حتى % % أرضت جوانح النوب العضال % 5(@)(@@) % وارعشت القنا حتى ظننا % % نفخت بهن ارواح الصلال % 6(@)(@@) % وصافحت الصفاح فلاح فيها % % وجوه الموت في صور النمال % 7(@)(@@) % حويت المجد أجمعه 
ms86	 صبيا % تحن هوى إلى الحرب السجال % 8(@)(@@) % تكني بالقريض عن المواضي % % بذكر قصار أيام الوصال % 9(@)(@@) % وعن عذب القنا بقرون ليلى % % فتنسب في لياليها الطوال % 10(@)(@@) % فكم أقرحت أكباد الأعادي % % وكم أرمدت أجفان النصال % PageV01P254 11(@)(@@) % وكم صبحت بالغار حيا % فأصبح ميت الأطلال بالي % % 12(@)(@@) % و أمسى والديار معطلات % من الفتيان والبيض الحوالي % % 13(@)(@@) % وكم لك بالحويزة يوم حرب % تشيب لهوله لمم الليالي % % 14(@)(@@) % ويوم مثل يوم الحشر فيه % تميد الراسيات من الجبال % 15(@)(@@) % به الأعلام كالآرام تسري % % فتشتبه الرعان مع الرعال % 16(@)(@@) % مهول فيه نار الحقد تغلي % % مراجلها بأفئدة الرجال % 17(@)(@@) % به اجتمعت بنولام جميعا % تستر جانب الطرف الشمالي % % 18(@)(@@) % ولاذوا بالحصون فما استفادوا % % نجاة بالجدار ولا الجدال % 19(@)(@@) % غواة قام بينهم غوي % يمنيهم بأنواع المحال % 20(@)(@@) % جزى نعماك طغيانا وكفرا % فحلت فيه قارعة النكال % PageV01P255 21(@)(@@) % تخيل سحر باطله لديهم % وأوهمهم بحيات الحبال % 22(@)(@@) % فجئت ببينات الحق حتى % % تهدم ما بنوه على الجبال % 23(@)(@@) % تروم رماتهم غيا وغدرا % تصيب علاك في سهم اغتيال % 24(@)(@@) % أما علموا بأنك يا علي % لباري قوسها يوم النزال % 25(@)(@@) % تناءوا بالديار فكنت أسري % % إليهم بالخيول من الخيال % 26(@)(@@) % ملأت الرحب حولهم جيوشا % تكاثر عد حبات الرمال % 27(@)(@@) % إلى عقباتها العقبان تأوي % % وتمدح في ضراغمها السعالي % % 28(@)(@@) % كتائب للحديد بها وميض % تمر عليك كالسحب الثقال % 29(@)(@@) % ولما لم تجد للصلح وجها % ولا للعفو عنهم والنوال % 30(@)(@@) % قذفتهم بشهب من حديد % وأقمار سواء في الكمال % PageV01P256 31(@)(@@) % بدور من بنيك تحف فيها % % نجوم من بني عم وخال % 32(@)(@@) % سلالات إلى المختار تعزى % % وأرحام به ذات اتصال % 33(@)(@@) % رووا سند المفاخر عن أبيهم % وعن أجدادهم شرف الخصال % 34(@)(@@) % فعالهم وأوجههم سواء % تمام بالجميل وبالجمال % 35(@)(@@) % جعلتهم أمامك في التلاقي % % مقدمة الجيوش وأنت تال % 36(@)(@@) % فكنتض كفيل أظهرهم وكانوا % % لك الكفلاء من قبل النزال % 37(@)(@@) % إذا جفل الخميس ثبت حتى % % يعود الهاربون الى القتال % 38(@)(@@) % كأنك يا علي المجد فينا % % سميك يوم احزاب الضلال % 39(@)(@@) % حملت على العدا وبنوك صالوا 
ms87	 % % فضاق بجيشهم رحب المجال % 40(@)(@@) % وكانوا كالجوارح كاسرات % فولوا مثل نافرة الرئال % PageV01P257 41(@)(@@) % وعن نار الظبا للشط فروا % % فكان الماء من نار الوبال % 42(@)(@@) % رأوا أن الردى بالسيف مر % فذاقوا الموت بالعذب الزلال % 43(@)(@@) % فكم صرعت سيوفك من هزبر % بحيهم وعفت عن غزال % 44(@)(@@) % لئن أغضبت بيض الشوس منهم % فقد أرضيت بيضات الحجال % 45(@)(@@) % تركت سراتهم صرعى غداة % وحزت الحمد في ستر العيال % 46(@)(@@) % ألا يامعشر الاعراب كفوا % % وتوبوا عن خبيثات الفعال % 47(@)(@@) % فإن تبتم فبشراكم بعفو % % ومغفرة وحسن مآل حال % 48(@)(@@) % وإن عدتم يعد يوما بأخرى % % تصبحكم أشد من الأوالي % % 49(@)(@@) % ليهنك سيدي فتح قريب % بعيد الصيت مرتفع المنال % 50(@)(@@) % ونصر لا يزال الدهر منه % عليك يزف ألوية الجلال % PageV01P258 51(@)(@@) % فلا برحت ديارك مؤنقات % وروح علاك ممدود الظلال % % 52(@)(@@) % ولا زالت شموسك مشرقات % بدائرة الزوال بلا زوال % PageV01P259 البحر : وافر تام 1(@)(@@) % تصاحى وهو مخمور الجنان % وهل يصحو فتى يهوى الغواني % % 2(@)(@@) % وأورى وجده فشكا وورى % % عن الأحداق في نوب الزمان % 3(@)(@@) % وهل في النائبات السودشيء % أشد عليه من حدق الحسان % 4(@)(@@) % وهل كذوائب الفتيان منها % % عليه تطاولت ظلم امتحان % 5(@)(@@) % تدين في الهوى العذري حتى % % رأى عز المحبة بالهوان % 6(@)(@@) % أشد من الاسود إذا لقيها % % وفيه عن المهى فرق الجنان % 7(@)(@@) % فليس يفر إلا عن قتال % به القامات من عدد الطعان % 8(@)(@@) % إلام يروم ستر الحب فيه % فتكشف عنه عثرات اللسان % 9(@)(@@) % يشبب بالحويزة وهو صب % تغزله بغزلان اللقان % 10(@)(@@) % ويسفح دمعه بالسفح شوقا % ويلمع مضحك البرق اليمان % PageV01P260 11(@)(@@) % ويطوي السر منه وكيف يخفى % % وفي عينيه عنوان العلان % 12(@)(@@) % لقد شغفت حشاشته بنجد % فهام بها وحن إلى المجاني % % 13(@)(@@) % رأى حفظ العهود لساكنيها % % وضيع قلبه بين المغاني % % 14(@)(@@) % رهين قوى على خديه تجري % % سوابق دمعه جري الرهان % 15(@)(@@) % يمر على حصى الوادي فيبكي % % فينتثر العقيق على الجمان % 16(@)(@@) % وتنفحه الصبا فيميل سكرا % كأن بريحها راح الدنان % 17(@)(@@) % فهل من مسعد لفتى تفانى % % فادركه الوجود من التفاني % % 18(@)(@@) % اذا قبض 
ms88	 الإياس الروح منه % به نفخ الرجا روح التداني % % 19(@)(@@) % تشب بقلبه النيران لكن % يشم من الحمى نفس الجنان % 20(@)(@@) % سقى الله الحمى غيثا كدمعي % % تسيل به البطاح بأرجوان % PageV01P261 21(@)(@@) % ولا برحت تجيب به ارتياحا % قماري الدوح اقمار القيان % 22(@)(@@) % حمى فيه البنود تمد منها % % على البيضاء أجنحة الأماني % % 23(@)(@@) % ومرتبعا به الضرغام يبني % % كناس الظبي في غاب اللدان % 24(@)(@@) % تلوح عليه نار من حديد % وأخرى للضيوف على الرعان % 25(@)(@@) % فكم تزهو به جنات حسن % وكم تجري عليه عيون عان % 26(@)(@@) % بأجفن بيضه حمر المنايا % % وتحت قبابه بيض الاماني % % 27(@)(@@) % محلا في الملاعب منه تبدو % % كواعب كالكواكب في قران % 28(@)(@@) % حسان كالشموع ترى عليها % % ذوائبها كأعمدة الدخان % 29(@)(@@) % تماثيل تضلك لو تراها % % عذرت العاكفين على المداني % % 30(@)(@@) % بروحي غادة منهن تبدو % % إلى قلبي وتنأى عن مكاني % % PageV01P262 31(@)(@@) % يمثلها الخيل خيال طرفي % % فأبصرها وتحجب عن عياني % % 32(@)(@@) % نقد البيض فيجفن نحيف % وتفري السابغات بغصن بان % 33(@)(@@) % إذا نبذت إلى سمعي كلاما % حسبت لسانها نباذ حان % 34(@)(@@) % ثناياها كدر ثنا علي % مرتلة مرتبة المعاني % % 35(@)(@@) % ومقلتها وعزمته سواء % كلا السيفين نصل هندواني % % 36(@)(@@) % هواه إلى المديح كما دعتني % % كذا التشبيب فيها قد دعاني % % 37(@)(@@) % حليف المكرمات أبو حسين % عزيز الجار ذو المال المهن % 38(@)(@@) % أخو همم إذا انبعثت فأدنى % % مواضيها على هام الزمان % 39(@)(@@) % وأخبار سرت فبكل أرض % لها عبق يضر بكل شان % 40(@)(@@) % وأمثال تلذ بكل سمع % كأن بضربها ضرب المثاني % % PageV01P263 41(@)(@@) % وأخلاق كروض المزن تحكي % % فوقرها براسية الجنان % 42(@)(@@) % خصال كاللآلي نافستها % % عليه قلائد البيض الحصان % 43(@)(@@) % شهاب وغى يهز سري نصل % وليث سرى يصول بأفعوان % 44(@)(@@) % يرى وضح النصول فصول شيب % فيخضبها بأحمر كالدهان % 45(@)(@@) % تبناه السحاب فكان أحرى % % لأجل عذابه فيما يعاني % % 46(@)(@@) % وواخاه الحسام فكان منه % بمرتبة القناة من السنان % 47(@)(@@) % وحلت منه منزلة المعالي % % فأضحت كالخواتم في البنان % 48(@)(@@) % وحلى المجد في درر السجايا % % فامسى وهو كالأفق المزان % 49(@)(@@) % كسا ترك النجوم مسوح نقع % ورومي النهار بطيلسان 
ms89	 % 50(@)(@@) % وأنبت في فؤاد الصبح روعا % فها كافوره كالزعفران % PageV01P264 51(@)(@@) % كأن بنوده حجاب كسرى % % على كل قميص خسرواني % % 52(@)(@@) % وحمر ظباه للمريخ رهط % فكل عندمي اللون قان % 53(@)(@@) % توهم أن تميد الأرض فيه % % 54(@)(@@) % وأيقن أن بذل المال يبقي % % له بقيا فخلده بفان % 55(@)(@@) % لقد غلط الزمان فجاد فيه % وأعقم بعده فرج الأوان % 56(@)(@@) % فلو حملتمن القمر الثريا % % لما كادت تجيء له بثان % 57(@)(@@) % تورث كل فخر من أبيه % وكل تقى وفضل وامتنان % % 58(@)(@@) % كأنهما صلاة الفجر هذا % % لذا شفع أو السبع المثاني % % 59(@)(@@) % علا مقداره فحكا عليا % فشاركه بتسمية وشان % 60(@)(@@) % هما نجمان بينهما اشتراك % لو اقترنا لقلنا الفرقدان % PageV01P265 61(@)(@@) % فكم من نهر سابور تأتى % % له نصر كيوم النهروان % % 62(@)(@@) % وكم في التابعين لآل حرب % له منء فتكة بكر عوان % 63(@)(@@) % وأشرف ماله في الدهر يوم % قضى يوم الصفوف بشهر كان % 64(@)(@@) % ألا يا ابن الأيمة من قريش % هداة الخلق من أنس وجان % 65(@)(@@) % لقد أشبهتهم حلقا وخلقا % وحكما بالقضايا والبيان % 66(@)(@@) % ووافيت الزمان وكان شيخا % فعاد سواد مفرقه الهجان % 67(@)(@@) % عرجت إلى المعالي فوق طرف % فجاريت البراق على حصان % 68(@)(@@) % كأنك في اليد البيضاء موسى % % ورمحك كالعصا في زي جان % 69(@)(@@) % سنانك عن لسان الموت أضحى % % لدى الهيجاء أفصح ترجمان % 70(@)(@@) % وسيفك لم يزل إما سوارا % لملحمة وإما طوق جان % PageV01P266 71(@)(@@) % فدم حتى يعود إليك أمس % وعش حتى يؤوب القارظان % 72(@)(@@) % ومتعك الإله بعيد فطر % وخصك بالتحية والتهاني % % PageV01P267 البحر : خفيف تام 1(@)(@@) % نظر البدر وجهه فتلاها % % فسلوه عن أختها هل حكاها % % 2(@)(@@) % وتراءت للبدر يوما فأبقت % خجلا فوق وجهه وجنتاها % % 3(@)(@@) % وتجلت على النجوم فولت % واستقلت بصدرها فرقداها % % 4(@)(@@) % وأضافت قرونها لليالي % % فأطالت على المشوق دجاها % % 5(@)(@@) % فتنت في جمالها الشهب حتى % % شاركتنا ونازعت في هواها % % 6(@)(@@) % علقت شمسنا بها فلهذا % % عينها في الرواح تجري دماها % % 7(@)(@@) % لم تحل من فراقها كل يوم % فهي صفراء خشية من نواها % % 8(@)(@@) % قد برى حبها الأهلة وجدا % فأطالت على الضلوع انحناها 
ms90	 % % 9(@)(@@) % ذات حسن لو تحسن النطق يوما % سبعة الشهب أقسمت بضحاها % % 10(@)(@@) % ومحيا لو أنه قابلته % آية الليل بالنهار محاها % % PageV01P268 11(@)(@@) % كم لها بالجمال آيات سحر % قد أضلت عقولنا عن هداها % % 12(@)(@@) % اثبتت في الخيال حيات تبر % تنفث النار من خيال سناها % % 13(@)(@@) % غرة ذات عزة ضاع عمري % % بالمنى بين صبحها ومساها % % 14(@)(@@) % خالها في الخدود في الحال مثلي % % حائر بين ثلجها ولظاها % % 15(@)(@@) % هي لولا ملابس الوشي غصن % وغزال الصريم لولا شواها % % 16(@)(@@) % وجهها جنة وعذب لماها % % سلسبيل وحورها مقلتاها % % 17(@)(@@) % يتمنى الرحيق لو كان يحكي % % ريقها والكؤس تغبط فاها % % 18(@)(@@) % وإلى إلفها تحن القماري % % فهي تشكو إلى الغصون جفاها % % 19(@)(@@) % دوحة حلوة الجناء ولكن % مر خرط القتاد حول خباها % % 20(@)(@@) % جمعت في صفاتها كل حسن % فهي كنز مرصودة في حماها % % PageV01P269 21(@)(@@) % ضربت دونها سرادق عز % طنبتها حماتها في قناها % % 22(@)(@@) % كم ترى حولها بدور كمال % برزت في أهلة من ظباها % % 23(@)(@@) % وأسودا تهب مثل النعامى % % في ظهور النعام يوم وغاها % % 24(@)(@@) % وبدورا تدرعت بسراب % نلتظي نارها ويجري نداها % % 25(@)(@@) % سقم جسمي وصحتي وفناءي % % ووجودي في سخطها ورضاها % % 26(@)(@@) % حبذا رامة وليلات وصل % بيضهن انقضت بخضر رباها % % 27(@)(@@) % وعهود بها لنا محكمات % حكم الدهر بانفصام عراها % % 28(@)(@@) % يارعى الله رامة وسقاها % % ضاحكات البروق دمع حياها % % 29(@)(@@) % وتحامى الخسوف أقمارتم % تتثنى على غصون نقاها % % 30(@)(@@) % دار أنس بها شموس العذارى % % تتمشى على نجوم حصاها % % PageV01P270 31(@)(@@) % قربت أرضها الكواعب فيما % % بين أرحام أرضها وسماها % % 32(@)(@@) % خضبت في دم القلوب أكفنا % % وخدودا رجالها ونساها % % 33(@)(@@) % ب قعة زينت بكل عجيب % جل من علم الكلام مهاها % % 34(@)(@@) % وعلى منشىء اليواقيت فيها % % واللآلي مباسما وشفاها % % 35(@)(@@) % جنة أشبهت يمين علي % حيث فيها لكل نفس مناها % % 36(@)(@@) % فاطمي سليل فخر أبوه % خلف الطاهرين من آل طه % 37(@)(@@) % ماء عين الحياة نار المنايا % % صرصر الحادثات حر بلاها % % 38(@)(@@) % مخلب الحرب نابها حين يسطو % % ساقها إذ تقوم قطب رحاها % % 39(@)(@@) % سمح للندى يمد يمينا % تعلم المزن أنه 
ms91	 أنواها % % 40(@)(@@) % ذو إياد ترى لهن التباسا % بالغوادي وبالبحور اشتباها % % PageV01P271 41(@)(@@) % سائرات لا تستقر بمصر % دون مصر ولا يحل نواها % % 42(@)(@@) % وأكف تدري البرية حقا % أن فيها نعيمها وشقاها % % 43(@)(@@) % طلسم البأس فوقهن خطوطا % ليس للمسلمين حرز سواها % % 44(@)(@@) % ونصال تدب فيها نمال % وهي بالنار بالنجي سقاها % % 45(@)(@@) % قضب حمرها تظن سريحا % % 46(@)(@@) % كجراح الهوى لهن جراح % ليس ترقى ولا يصاب دواها % % 47(@)(@@) % كتب الموت بالغبار عليها % % إن للضرب لاغيره الاها % % 48(@)(@@) % وخصال تودهن الغواني % % بدلا من عقودها وحلاها % % 49(@)(@@) % غرر كالجمان مستحسنات % جل باري النجوم حيث براها % % 50(@)(@@) % كل معشوقة إلى النفس أشهى % % من ثنايا الحسان دون ثناها % % PageV01P272 51(@)(@@) % لو خوت بعضها سجايا الليالي % % بدلت بدلت بحسن وفاها % % 52(@)(@@) % شيم عطرت جيوب المعالي % % وانطوى بالنسيم نشر شذاها % % 53(@)(@@) % منعم فاز بالثناء فأضحى % % شكره بالسجود يدعو الجباها % % 54(@)(@@) % صقلت ذهنه التجارب حتى % % صور الكائنات فيه رآها % % 55(@)(@@) % ذات قدس تكونت فيه نفس % قد نهاها من كل رجس نهاها % % 56(@)(@@) % مثل ماء السماء يوشك يبدو % % كالدراري صفاته في صفاها % % 57(@)(@@) % تم إيجادها ولله فيها % % حكمة بان فيه وجه خفاها % % 58(@)(@@) % عظمت هيبة وعمت نوالا % فالورى بين خوفها ورجاها % % 59(@)(@@) % كم له في القريض من بنت فكر % يبتغي البدر أن يكون أخاها % % 60(@)(@@) % قد ترقت حسنا ورقت كمالا % فاستفزت قلوبنا في رقاها % % PageV01P273 61(@)(@@) % صاغها عسجدا ورصع درا % في حشاها وبالحرير كساها % % 62(@)(@@) % أصبحت بيننا اليتيمة تدعى % % متع الله بالحياة أباها % % 63(@)(@@) % جملة من كواكب كالثريا % % وقعت في كلامه فحكاها % % 64(@)(@@) % موسوي أزكى الملوك نجارا % خيرها قدرة وقدرا وجاها % % 65(@)(@@) % زينة الأكرمين في كل مصر % تاجها عقدها سوار علاها % % 66(@)(@@) % ليثها في النزال غيث نداها % % زند نيران حربها وقراها % % 67(@)(@@) % ربما وقعة تشيب النواصي % % قد ألمت به فكان فتاها % % 68(@)(@@) % وقعة وقعها يهد الرواسي % % ويذيب الحديد حر صلاها % % 69(@)(@@) % جورها أسود الجبين ولكن % بيضها وردت خدود ثراها % % 70(@)(@@) % خضب النقع فودها فرمته % بنصول نصوله إذ نضاها % % PageV01P274 71(@)(@@) % وشوت نارها اللحوم فأمسى % % يكرم اللدن 
ms92	 في ضعيف شواها % % 72(@)(@@) % بطل تضحك الظبا بيديه % فتطبل الرقاب حزنا بكاها % % 73(@)(@@) % مرضت قبله صدور العوالي % % فسقاها دم الطلا فشفاها % % 74(@)(@@) % كلما خاض في دجنة نقع % فلق الفجر سيفه فجلاها % % 75(@)(@@) % عشقت نفسه السماح فعدت % ما عدا قوت يومها من عداها % % 76(@)(@@) % يا بني الوحي والنبوة أنتم % رهطها والخواص من أقرباها % % 77(@)(@@) % ولدتكم كرائم من كرام % عترة مفخر العباء حواها % % 78(@)(@@) % كم لكم في الكتاب آيات مدح % بين الله فضلها وتلاها % % 79(@)(@@) % تعلم الأرض إنكم لعليها % % شم أوتادها وخط استواها % % 80(@)(@@) % قد نشرتم موتى البقاع فكنتم % روح سكانها وعصر صباها % % PageV01P275 81(@)(@@) % وحكمتم على الليالي فخلنا % % ملكتكم يد الزمان إماها % % 82(@)(@@) % وصرفتم صروفها للإعادي % % أسرتم نفوسها في عناها % % 83(@)(@@) % وهززتم على الخطوب رماحا % فشككتم صدورها في شباها % % 84(@)(@@) % سيدي ليست المكارم إلا % لفظة أنت واضع معناها % % 85(@)(@@) % أنتم للنفوس داء وطب % قد قضيتم بموتها وبقاها % % 86(@)(@@) % يا نصيري على العداء وعوني % % ومعاذي إذا خشيت أذاها % % 87(@)(@@) % أقبل العيد فلنهنيه فيكم % اذ بكم زاد قدره وتباهى % % 88(@)(@@) % لكم العيد في الحقيقة عبد % صحفت باؤه بياء سفاها % % 89(@)(@@) % حزت أجر الصيام مولاي فاغنم % لذة الفطروابتهج في هناها % % 90(@)(@@) % وابق في نعمة وعزة ملك % يحمل النصر والفتوح لواها % % PageV01P276 91(@)(@@) % واسم واسلم واستجل بكر قريض % ختمت مدحكم بخير دعاها % % PageV01P277 البحر : وافر تام 1(@)(@@) % آ في طي الصبا نشر التصابي % % فقد نفخت بنا روح الشباب % 2(@)(@@) % وهل طرقت مجر ذيول ليلى % % فقد جاءت معطرة الثياب % 3(@)(@@) % وهل رشفت ثناياها فأمست % تحدث عن رحيق مستطاب % 4(@)(@@) % تمر بنا فتثنينا سكاري % % كأنا لا نفيق من الشراب % 5(@)(@@) % كأن نسيمها شكوى مشوق % أخي أدب تلطف بالعتاب % 6(@)(@@) % سلوها هل لها وجد بنجد % فرقت رقة الصب المصاب % 7(@)(@@) % سقى نجدا وأهليه ملث % يحاري رعده طول انتحابي % % 8(@)(@@) % ولا برح الزمان به ربيعا % يطرز زهره حلل الروابي % % 9(@)(@@) % زكي لا تمل له انتشاقا % كأن هناه أنفاس الكعاب % 10(@)(@@) % بمورده لصادي القلب ري % كأن بمائه برد الرضاب % PageV01P278 11(@)(@@) % إذا بربوعه حزنا 
ms93	 مزجنا % % لجينض الدمع بالذهب المذاب % 12(@)(@@) % تسير جسومنا فوق المطايا % % وأنفسنا تسيل على التراب % 13(@)(@@) % فكم من فاقد فيه فؤادا % وواجد مهجة ذات التهاب % 14(@)(@@) % إلى نخل النخيل تحن شوقا % وترزم تحتنا خوص الركاب % 15(@)(@@) % ونلثم من ثنايا الجذع برقا % فنحسبه ثغور بني حساب % 16(@)(@@) % بنفسي أسرة أسروا رقادي % % وحلوا بين قلبي والذهاب % 17(@)(@@) % ثناياهم على نسق الحباب % بريش النبل بيضات العقاب % 18(@)(@@) % تهز أكفهم حيات لدن % وتمرح خيلهم بأسود غاب % 19(@)(@@) % إذا لبسوا الدروع حسبت فيها % % نجوم الليل غرقى في السراب % 20(@)(@@) % فكم فيهم ترى قمرا تجلى % % وشمس ضحى توارت في حجاب % PageV01P279 21(@)(@@) % وصبح طلا تستر في خمار % % وآخر قد تنفس في نقاب % 22(@)(@@) % وراحات بدمع أو نجيع % % مضرجة وأخرى في خضاب % 23(@)(@@) % وكم بخدود نسوتهم وأيدي % % فوارسهم توقد من شهاب % 24(@)(@@) % حوت أفواههم خمرا فصيغت % فاحدث في الورى نعما وبؤسا % 25(@)(@@) % كأن به إلى رؤياك ما بي % % إذا منها ترشف باللعاب % 26(@)(@@) % كأنهم إذا سطعت عليهم % مجامرهم شموس في ضباب % 27(@)(@@) % تحنث الساجعات إذا تثنوا % % فتؤثرهم على القضب الرطاب % 28(@)(@@) % هم راحي وريحاني وروحي % % وجناتي وإن كانوا عذابي % % 29(@)(@@) % وعافيتي وأمراضي وبرئي % % وأفراحي وحزني واكتئابي % % 30(@)(@@) % تولوا والصبا معهم تولى % % فهل لهم إلينا من إياب % PageV01P280 31(@)(@@) % إلام أطالب الأيام فيهم % فلم تسمع ولم تردد جوابي % % 32(@)(@@) % أعوذ من الزمان ومن نواهم % برب المجد والمولى المهاب % 33(@)(@@) % أخي الشرف الرفيع أبي حسين % علي المجد ذي الشيم العجاب % 34(@)(@@) % مبيد المال في بيد العطايا % % مجلي السبق في يوم الطلاب % 35(@)(@@) % زكي النفس محمد السجايا % % مصان العرض ممدوح الجناب % 36(@)(@@) % قدير ذو قدرر راسبات % تقابلها جفان كالجوابي % % 37(@)(@@) % فصيح ما لمنطقه شبيه % لو حملت به أم الكتاب % 38(@)(@@) % شهاب في الثغور عليه تثني % % بيوم الحرب ألسنة الحراب % 39(@)(@@) % تسير جيوشه فتكاد رعبا % تميد الراسيات من الهضاب % 40(@)(@@) % تقابله البوارق مغمدات % وتصحبه السحائب في القباب % PageV01P281 41(@)(@@) % به يدري الخميس إذا رآه % سيخشره بأحشاء الذئاب % 42(@)(@@) % ويعتقد الهزبر إذا التقاه % بأن رجامه جوف 
ms94	 الغراب % 43(@)(@@) % إذا هز المثقف خلت فيه % جرى من بأسه سم الحباب % 44(@)(@@) % كريم صاغ من بيض الأيادي % % خواتمه وأطواق الرقاب % 45(@)(@@) % وحسن بالندى وجه المعالي % % وورد خدها بدم الضراب % 46(@)(@@) % ومن مسك الغبار أثار سحبا % مخضبة المبارق بالملاب % 47(@)(@@) % مكارمه تسير بكل أرض % كأن يمينه حوض السحاب % 48(@)(@@) % وأنعمه تعلمنا القوافي % % فهذا الدر من ذاك العباب % 49(@)(@@) % حلت منه الطباع فعز بأسا % فأصبح وهو من شهد وصاب % 50(@)(@@) % فأحدث في الورى نعماص وبؤسا % كذلك شيمة الغيم الرباب % PageV01P282 51(@)(@@) % يسوق إلى الولي ولي فضل % ونحو عداه صاعقة العقاب % 52(@)(@@) % يرى عقبان رايات الأعادي % % إذا خفقت كأجنحة الذباب % 53(@)(@@) % يفوق أبا السحاب أبا وجودا % إذا ماقيل ذ ابن أبي تراب % 54(@)(@@) % تزف جياده العزمات منه % زفاف النمل أجنحة العقاب % 55(@)(@@) % له عضب بليل الخطب فجر % وناب في النوائب غير ناب % 56(@)(@@) % تصيد نماله الأسد الضواري % % ويقتنص الجوارح بالذباب % 57(@)(@@) % وآراء كأسهمه نفاذا % مفوقة لإدراك الصواب % 58(@)(@@) % وآثار على دهم الليالي % % حكت غرر المسومة العراب % 59(@)(@@) % الا يا ابن الأولى شرفوا وسادوا % % على الدنيا بفضل وانتساب % 60(@)(@@) % لقد فلقت هامات الرزايا % % وقدت أبية النوب الصعاب % PageV01P283 61(@)(@@) % وأثكلت الخزائن فهي تنعى % % على الولد المقرط بالجراب % 62(@)(@@) % خلت دار الندى فظهرت فيه % ظهور الكنز في البلد الخراب % 63(@)(@@) % ليهنك سيدي عيد شريف % يبشر عن صيامك بالثواب % 64(@)(@@) % فقابل بالمسرة وجه فطر % تبسم عن ثناياه العذاب % 65(@)(@@) % % تعطف زائرا بعد اجتناب % 66(@)(@@) % وجلى رونق البشرى هلالا % تصدى كالحسام بلا قراب % 67(@)(@@) % هلالا شق جيب الهم عنا % % بمخلبه وضرسه بناب % 68(@)(@@) % أخا كلف إذا رام انصرافا % ثناه الشوق وهو إليك صابي % % 69(@)(@@) % أتاك على النوى نضوا طليحا % كأت به إلى رؤياك مابي % % 70(@)(@@) % فدم بالمجد ما حنت قلوب % إلى الأوطان في دار اغتراب % PageV01P284 71(@)(@@) % ولا برحت أكف نداك تجري % % بنثر الدر منظوم الخطاب % 72(@)(@@) % ولا زالت لك الأقدار تقضي % % بما تهوى إلى يوم الحساب % PageV01P285 البحر : رمل تام 1(@)(@@) % قد براها للسرى جذب براها % % فذراها يأكل السير 
ms95	 ذراها % % 2(@)(@@) % ودعاها للحمى داعي الهوى % % فدعاها فالهوى حيث دعاها % % 3(@)(@@) % واسقياها من صفا ذكر الصفا % % وصفا الخيف لها كي تسكراها % % 4(@)(@@) % يا لها من أحرف مسطورة % تسبق الوحي إذا الحادي تلاها % % 5(@)(@@) % ترتمي شوقا فلولا ثقل ما % % في صدور الركب طارت في سراها % % 6(@)(@@) % سحب صيف قدح أيديها الحصى % % برقها والرعد أصوات رغاها % % 7(@)(@@) % كلما حنت لأرض المنحنى % % وكلاها أقرح السوق كلاها % % 8(@)(@@) % كم ترى من خلفها من مروة % وردت أخفافها بيض حصاها % % 9(@)(@@) % سفن تجري بأشباح غدت % معها غرقى بطوفان بكاها % % 10(@)(@@) % ذات أنفاس حرار صيرت % فحمة الظلماء جمرا في لظاها % % PageV01P286 11(@)(@@) % كل ذي قلب مشوق لم يزل % للمطايا زجره أوها وآها % % 12(@)(@@) % أسهم فوق سهام مثلها % % لا يصيب النجح إلا في خطاها % % 13(@)(@@) % تبتغي نجما بأطراف الحمى % % وهم همهم بدر سماها % % 14(@)(@@) % أوشكت تعرج فيها للسما % % إذ درت قصدهم شمس ضحاها % % 15(@)(@@) % حي أكناف الحمى من أربع % ما سقت أحياءها المزن حياها % % 16(@)(@@) % وبقاع قدست لكنها % % نجستها الأسد في طمث ظباها % % 17(@)(@@) % % أفصح الأعراب ما ضم بناها % % 18(@)(@@) % كم ثنايا في ثناياها دجى % مبعث الفجر إلينا من كواها % % 19(@)(@@) % جنة فيها اللآلي فصلت % واليواقيت ثغور أو شفاها % % 20(@)(@@) % ماؤها شهد هواها قرقف % طينها العنبر والمسك ثراها % % PageV01P287 21(@)(@@) % كم به بيت غدا مضمونه % درة بيضاء من بيض ثناها % % 22(@)(@@) % وقطوف من جمان ذللت % عز كل العز مستحلي جناها % % 23(@)(@@) % يا بني فهر سلوا بلقيسكم % كيف تسبي مهجتي وهي سباها % % 24(@)(@@) % واسألوا أجفانكم عن صحتي % % فهي عنا عوضت جسمي ضناها % % 25(@)(@@) % ورق نجد بعدكم لي رحمة % ندبت شجوا ورقت في ضناها % % 26(@)(@@) % وبكت لي وحشها حتى محت % كحلها بالدمع أحداق مهاها % % 27(@)(@@) % تلفت نفسي بكم إلا شفا % والشفاه اللعس لم يمنح شفاها % % 28(@)(@@) % هي تدري ما بها من نبلكم % والعيون السود تدري من رماها % % 29(@)(@@) % ويحها كم تتقي بأس الهوى % % وعلي كل مخدور كفاها % % 30(@)(@@) % كفها كافلها عصمتها % % من أذى الذدهر إذا الدهر دهاها % % PageV01P288 31(@)(@@) % كنزها جوهرها ياقوتها % % قوتها 
ms96	 قوتها خمس قواها % % 32(@)(@@) % زينة الدنيا وأهليها معا % طوقها دملجها تاج علاها % % 33(@)(@@) % ساعد الهيجاء موري زندها % % سيفها عاملها قطب رحاها % % 34(@)(@@) % موسوي عنده إذ لم تجد % نار موسى فيه إذ لاح هداها % % 35(@)(@@) % قد حكاها في اليد البيضا وفي % % رمحه عن عزمه سر عصاها % % 36(@)(@@) % حيدري أوشكت راحاته % تلتظي نيرانها لولا نداها % % 37(@)(@@) % غيث جود لو أصابت قطرة % منه رضوى كان يخضر صفاها % % 38(@)(@@) % ليث حرب أشفقت أسد الشرى % % منه حتى بايعته في شراها % % 39(@)(@@) % خائض الحرب التي نيرانها % % في التلاقي تنزع الأسد شواها % % 40(@)(@@) % فالق الهامات بالقضب التي % % حين تنضى يفلق الليل سناها % % PageV01P289 41(@)(@@) % يحسب البيض ثنايا خرد % وعليها الدم معسول لماها % % 42(@)(@@) % حازت النصر لها ألوية % جعلت معكوسة حظ عداها % % 43(@)(@@) % كلما كبر في حشر وغى % سبح الصف لآيات يراها % % 44(@)(@@) % سورة الرحمن في صورته % كتبت بالنور في لوح صفاها % % 45(@)(@@) % ملك قد شرف الملك به % لو صبا نجد تلت في مدحه % 46(@)(@@) % طيب لو لم تصل أخباره % شجر الكافور ما طاب شذاها % % 47(@)(@@) % % بيت شعر لحكى العود غضاها % % 48(@)(@@) % أو تغنت ورقها في شعره % هزت الأعطاف بالرقص رباها % % 49(@)(@@) % لسن كل لآل يده % فرقتها هو في النطق حواها % % 50(@)(@@) % بحر علم لجه من جعفر % قبس شعلته من نور طها % % PageV01P290 51(@)(@@) % كم بروضات القراطيس له % كلمات تشبه الزهر رواها % % 52(@)(@@) % علمه نور مبين للهدى % % ظلمات النصب بالنص جلاها % % 53(@)(@@) % جاد في خير مقال صدقه % شبه الباطل بالحق محاها % % 54(@)(@@) % طاهر لو سبق الدهر به % جاذب العترة في فضل كساها % % 55(@)(@@) % سمح يبسط للوفد يدا % تم معنى الجود فيها وتناهى % % 56(@)(@@) % راحة مبسوطة لو مدها % % للسما أمكنها قبض سهاها % % 57(@)(@@) % نارها مشبوبة في لجها % % تقذف العسجد أمواج لهاها % % 58(@)(@@) % ظللت علياؤه في راية % تنسف الأعلام في خفق لواها % % 59(@)(@@) % راية منصوبة في رفعها % % تنصب الأعداء في كي جواها % % 60(@)(@@) % حائز غر خصال زينت % عطل الأيام في حسن حلاها % % PageV01P291 61(@)(@@) % غبطتها أنجم الأفق فها % % هي في الإشراق فيها لا 
ms97	 تضاهى % % 62(@)(@@) % لو بأفكار الليالي خطرت % بيضت أنوارها سود إماها % % 63(@)(@@) % يا علي المجد لا زالت بكم % تشرق الدنيا ولا زلتم ضياها % % 64(@)(@@) % ولدتكم والنواصي شعلة % فجرى في عودها ماء صباها % % 65(@)(@@) % كانت الأيام مرضى قبلكم % فاستفادت من معانيكم دواها % % 66(@)(@@) % حسنت أوقاتها فيكم فلا % زلتم يا رونق الدهر بهاها % % 67(@)(@@) % كل أخبار المعالي والندى % % عنكم صحت ومنكم مبتداها % % 68(@)(@@) % عترة قد صح عندي أنها % % ليس للأيام أرواح سواها % % 69(@)(@@) % سيدي هنيت بالصوم وفي % % بهجة الإفطار وأنعم في هناها % % 70(@)(@@) % وتلق العيد بالبشر فقد % جاء منكم يجتدي قدرا وجاها % % PageV01P292 البحر : وافر تام 1(@)(@@) % أتنكر بأس أحداق العذارى % % أما تدري بعربدة السكارى % % 2(@)(@@) % وتفتنك العيون وما عهدنا % % جريحا قلبه يهوى الشفارا % % 3(@)(@@) % زتغرم في القدود فهل طعين % هوى من قبلك الأسل الحرارا % % 4(@)(@@) % وتمسي في الذوائب مستهاما % متى عشقت سلاسلها الأسارى % % 5(@)(@@) % لقد فتكت بنا الأجفان حتى % % شكت ضعفا لذلك وانكسارا % % 6(@)(@@) % إلام بها نلام ولا نبالي % % فتوسعنا جراحا واعتذارا % % 7(@)(@@) % رأينا أن حبل الحب فينا % % شعور فاتخذناها شعارا % % 8(@)(@@) % وهمنا بالحسان وما فهمنا % % بنات صدورها تلد البوارا % % 9(@)(@@) % وهبنا العذر لعذال لما % % خلعنا في عذارها العذارا % % 10(@)(@@) % علام عيوننا بالدمع غرقى % % ومن وجناتهن تخوض نارا % % PageV01P293 11(@)(@@) % ونسأل من مراشفهن ريا % وبرد برودها يوري الأوارا % % 12(@)(@@) % تؤرقنا ذوائبها ولسنا % % نرى لدجى لياليها قصارى % % 13(@)(@@) % فهل تدري بغايتها المداري % % فقد ضاقت على المرضى السهارى % % 14(@)(@@) % لعمرك ليس من حمر المنايا % % سوى الوجنات تسلبنا القرارا % % 15(@)(@@) % إذا لشقائنا الآجال طالت % تخلصها الخصور لنا اختصارا % % 16(@)(@@) % وإن كهم الردى يوما فمنه % يسن لقتل أنفسنا الغرارا % % 17(@)(@@) % تحاذرنا المنايا السود جهرا % وتأتينا العيون بها سرارا % % 18(@)(@@) % بروحي جيرة جاروا وقلبي % % لديهم لم يزل بالحي جارا % % 19(@)(@@) % مصابيح إذا سفروا بليل % حسبت ظلامه لبس النهارا % % 20(@)(@@) % بدور بالخيام ذووا شموسا % بشبه البيض تحملها الغبارا % % PageV01P294 21(@)(@@) % مرنحة معاطفهم صحاة % تكاد عيونهم تجري عقارا % % 22(@)(@@) % لهم صور كأن الحسن صب % تأمل طرفه فيهم فحارا % % 23(@)(@@) % وألفاظ إذا المخمور 
ms98	 فيها % % تداوى طبعه فقد الخمارا % % 24(@)(@@) % وأسنان تفديها اللآلي % % بأكبرها وإن كانت صغارا % % 25(@)(@@) % بأعينهم تجول السحر حتى % % نثير الكحل تحسبه غبارا % % 26(@)(@@) % لشوق سنا الصباح إلى لقاهم % تنفس حسرة ورمى جمارا % % 27(@)(@@) % إذا بقبابهم سفرت ظباهم % حسبت بيوتهم بيع النصارى % % 28(@)(@@) % سقتهم أعين الأنواء دمعا % يخط بخد واديهم عذارا % % 29(@)(@@) % ولا درست نوادي الحسن منهم % ولا فصم البلى منها سوارا % % 30(@)(@@) % هم بالقلب لا بالخيف حلوا % % وفي جمراته اتخذوا ديارا % % PageV01P295 31(@)(@@) % أقاموا فيه بعد رحيل صبري % % فأضحت مهجتي أهلا قفارا % % 32(@)(@@) % إذا خطروا ببالي فر شوقا % فلو حملته قادمة لطارا % % 33(@)(@@) % أروح ولي بهم روح تلظت % إذا استضرمتها قدحت شرارا % % 34(@)(@@) % وأجفان كسحب ندى علي % إذا استمطرتها مطرت نضارا % % 35(@)(@@) % حليف المكرمات أبي علي % أجل الناس قدرا واقتدارا % % 36(@)(@@) % أعز بني الملوك الغر نفسا % وأشجعهم وأمنعهم ذمارا % % 37(@)(@@) % وأنجدهم وأطولهم نجادا % وأفخرهم وأطهرهم إزارا % % 38(@)(@@) % أخو شرف تولد من علي % وبضعة أحمد فزكا فخارا % % 39(@)(@@) % تلاقى مجمع البحرين فيه % وشارك هاشم فيه نزارا % % 40(@)(@@) % هو النور الذي لولاه لاقت % بدور المجد في التم السرارا % % PageV01P296 41(@)(@@) % محا إيضاؤه صبغ الليالي % % فعسجد لونهن وكان قارا % % 42(@)(@@) % أتى الأيام والأيام غضبى % % فأحدث في مباسمها افترارا % % 43(@)(@@) % ووافى والندى ثمد ففاضت % موارده ولولاه لغارا % % 44(@)(@@) % رسا حلما فقر الحوز فيه % ولولا حلمه فينا لمارا % % 45(@)(@@) % بصهوة مهده طلب المعالي % % وقبل قماطه لبس الوقارا % % 46(@)(@@) % وحاز تقى ومعروفا وفضلا % وأقدارا وبأسا واصطبارا % % 47(@)(@@) % وأصبح للعلا بعلا كريما % فأولدها المحامد والفخارا % % 48(@)(@@) % غمام صافح البيض المواضي % % فأحدث في جوانبها اخضرارا % % 49(@)(@@) % بأحينها إذا كتب احورارا % % حيا كفيه لا شيحا وغارا % % 50(@)(@@) % ويوشك أن يعود النور تبرا % لو ان الغيث نائله استعارا % % PageV01P297 51(@)(@@) % وروض من حمائله التقطنا % % دنانير العطايالا العرارا % % 52(@)(@@) % حكى فصل الربيع الطلق خلقا % وفاق بجود راحته القطارا % % 53(@)(@@) % كسا قتلى أعاديه شقيقا % وبرقع وجه حبهم بهارا % % 54(@)(@@) % وهز على الكماة قطوف لدن % فدلت من جماجمهم ثمارا % % 55(@)(@@) % وأحدث عهده فينا سرورا % فأنبت في 
ms99	 الخدود الجلنارا % % 56(@)(@@) % مطاع لو دها الصفواء يوما % سمعت لها وإن صمت خوارا % % 57(@)(@@) % جواد في ميادين العطايا % % ومضمار الفصاحة لا يجارى % % 58(@)(@@) % فصيح نطقه نظما ونثرا % يرصع لفظه الدرر الكبارا % % 59(@)(@@) % تود مداده الأيام تمسي % % بأعينها إذا كتب احورارا % % 60(@)(@@) % فكم في خطه من بنت فكر % لها نسجت محابره خمارا % % PageV01P298 61(@)(@@) % ذكاء من سناها كاد يحكي % % ظلام مداده الشفق احمرارا % % 62(@)(@@) % له القلم الذي في كل سطر % ترى في خطه فلكا مدارا % % 63(@)(@@) % يمج على صباح السطر ليلا % تكوكب في المعالي واستنارا % % 64(@)(@@) % وأشرق منه في أندى يمين % % فلجج في أناملها وسارا % % 65(@)(@@) % ومن يسعى إلى طلب المعالي % % فلا عجب إذا ركب البحارا % % 66(@)(@@) % يراع روع القضب المواضي % % فأثبت في تقومها ازورارا % % 67(@)(@@) % ترى ثعباانه الأفلاك تسعى % % فيخفق قلب عقربها حذارا % % 68(@)(@@) % يرد حسام جوزاها كهاما % ويطعن في عطاردها احتقارا % % 69(@)(@@) % مؤيد ملة الإسلام هاد % إذا ضل الهداة ولامنازا % % 70(@)(@@) % له كتب يعز النصب عنها % % إذا شنت كتائبها مغارا % % PageV01P299 71(@)(@@) % حكت زهر الرياض الغض حسنا % ونشر المسك طيبا وانتشارا % % 72(@)(@@) % ووقتعين نسيم صفاء % وعين الشمس نورا واشتهارا % % 73(@)(@@) % فواصلها سيوف فاصلات % وهدي بالضلالة لا يمارى % % 74(@)(@@) % من الدباج ألبسها ثيابا % وصاغ من النضلر لها فقارا % % 75(@)(@@) % إذا في إثرها الأفكار سارت % لتدرك ثأرها وقفت حيارى % % 76(@)(@@) % فنور مبينها جمع الدراري % % وخير مقالها الدرر النثارا % % 77(@)(@@) % وفي نكت البيان أبان فضلا % بمختصر حوى حكما غزارا % % 78(@)(@@) % كتاب كل سفر منه سفر % من الإقهار في الأقطار دارا % % 79(@)(@@) % فلو أم الكتاب أتت بنجل % لقلنا فيه قد حملت قصارا % % 80(@)(@@) % إذا ورد العدا منه كتاب % توعدهم به طلبوا الفرارا % % PageV01P300 81(@)(@@) % كأن كتابه جيش علته % % 82(@)(@@) % وإن صدرت ظباه عن الهوادي % % حسبت حديدها ذهبا ممارا % % 83(@)(@@) % وهوب يوسع الفقراء تبرا % ولم يهب العدا إلا تبارا % % 84(@)(@@) % ألا يا أيها الملك المرجى % % إذا غدر الزمان بنا وجارا % % 85(@)(@@) % ويا غيثا إذا الأنواء ضنت % وطال جفا الحيا حيا وزارا % % 86(@)(@@) % لعمرك إن قدرك لا يجارى 
ms100	 % % وقطرك بالسماحة لا يبارى % % 87(@)(@@) % بطولك تم نقصان المعالي % % فطالت بعدما كانت قصارا % % 88(@)(@@) % % فقد أبكيتهن دما جبارا % % 89(@)(@@) % ليهنك بعد صومك عيد فطر % يريك بقلب حاسدك انفطارا % % 90(@)(@@) % أتاك وفوق غرته هلال % إذا قابلته خجلا توارى % % PageV01P301 91(@)(@@) % يشير وعاد نحوك كل عام % يحدد فيك عهدا وازديارا % % 92(@)(@@) % ولا برحت لك العلياء دارا % ومتعك الزمان بملك دارا % % PageV01P302 البحر : كامل تام 1(@)(@@) % لله منزلها على الروحاء % درت عليه مراضع الأنواء % 2(@)(@@) % وسقت ثراه عيون أرباب الهوى % % دمعا يورد وجنة البطحاء % 3(@)(@@) % واستخرجت أيدي الربيع كنوزه % فحباه بالبيضاء والصفراء % 4(@)(@@) % أكرم به من منزل أكنافه % جمعت أسود شرى وعين ظباء % 5(@)(@@) % مغنى إذا سفرت وجوه حسانه % ليلا يطول تلفت الحرباء % 6(@)(@@) % بهج يكلفك السجود صعيده % شوقا للثم مباسم الحصباء % 7(@)(@@) % حتى توهمنا ملاعب بيضه % % فتظنها ليلا بروج سماء % 8(@)(@@) % دارت كهالات البدور حصونه % فهما سواء في سنى وسناء % 9(@)(@@) % تهوى الكواكب أن تصوغ سوارها % % طوقا لجيد مهاته الجوزاء % 10(@)(@@) % ويود ضوء الفجر يصبح خيطه % سلكا لعقد فتاته العذراء % PageV01P303 11(@)(@@) % رفعت على عمد الصباح بيوته % فحبالهن ذوائب الظلماء % 12(@)(@@) % قطع من الليل البهيم إلى الثرى % % هبطت وفيها أنجم الجوزاء % 13(@)(@@) % ليلا قدر كل حسن أنزلت % آياته فيها وكل بهاء % 14(@)(@@) % كم فيه من حقف يموز بمئزر % وقضيب بان يثني بقباء % 15(@)(@@) % سقيا لها من روضة لم تخل من % وردين ورد حيا وورد حياء % 16(@)(@@) % لا صحت النسمات فيه ولا صحت % سكرى عيون رجاله ونساء % 17(@)(@@) % يا صاح إن شارفت مكة سالما % فاعدل يمين منى فثم مناءي % % 18(@)(@@) % واسأل بجانب طوره الغربي عن % قلب غريب ضاع من أحشائي % % 19(@)(@@) % أطلبه ثم تجده في جمراته % أبدا تعذبه مدى برحائي % % 20(@)(@@) % لا تعدلن إلى سواه فمنزل الن % وى به ومعرس الأهواء % % PageV01P304 21(@)(@@) % حرم له حق لدي وحرمة % وضعت له خدي مكان حذائي % % 22(@)(@@) % ما حله دنف فاصبح محرما % إلا أحل مقمصا بضناء % 23(@)(@@) % قرب به قلبي فإن لم تلقه % فانحر به نومي وضح عزائي % % 24(@)(@@) % وامزج 