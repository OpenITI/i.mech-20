ms61	 الفخار بها على الآصال % % 63(@)(@@) % وكسوتها برد الشباب مفوقا % % وشفيت ما تشكو من الأوجال % % 64(@)(@@) % مولاي لا أحصي ثناءك إنه % % أربى على التفصيل والإجمال % % 65(@)(@@) % أعليت في أفق العناية مظهري % % وخصصته بعوارف الإفضال % % 66(@)(@@) % ظفرت يداي بكل ما أملته % % في النفس أو في الجاه أو في المال % % 67(@)(@@) % لم تبق لي أملا وما بلغته % % بلغت ما ترجو من الآمال % % PageV01P218 البحر : - 1(@)(@@) % رفعت قوس سمائي % % يزهى بتاج الهلال % % 2(@)(@@) % قد قلدته نقوشي % % در الدراري العوالي % % 3(@)(@@) % ترى الأباريق فيه % % تهديك عذب الزلال % % 4(@)(@@) % قد زان قصري سعد % % بسعده المتوالي % % 5(@)(@@) % فدام يعمر ربعي % % من كلء مولى الموالي % % PageV01P219 البحر : - 1(@)(@@) % بما قد حزت من كرم الخلال % % بما أدركت من رتب الجلال % % 2(@)(@@) % بما خولت من دين ودنيا % % بما قد حزت من شرف الجمال % % 3(@)(@@) % بما أوليت من صنع جميل % % يطابق لفظه معنى الكمال % % 4(@)(@@) % تغمدني بفضلك واغتفرها % % ذنوبا في الفعال وفي المقال % % PageV01P220 البحر : - 1(@)(@@) % لك الخير شأن الجفن يحرس عينه % % وهذا بعين الله يحرس دائما % % 2(@)(@@) % تبيت له خمس الثريا معيذة % % تقلده زهر النجوم تمائما % % 3(@)(@@) % فيا جفن لا تنفك في الحفظ دائما % % وإن كنت في لج من البحر عائما % % PageV01P221 البحر : - 1(@)(@@) % تأمل أطلال الهوى فتألما % % وسيما الجوى والسقم منها تعلما % % 2(@)(@@) % أخو زفرة هاجت له نار ذكرة % % فأنجد في شعب الغرام وأتهما % % 3(@)(@@) % توجتني بعمامة % % توجت تاج الكرامة % % 4(@)(@@) % فروض حمدك يزهى % % مني بسجع الحمامه % % PageV01P222 البحر : - 1(@)(@@) % هناء له ثغر الهدى يتبسم % % وبشرى بها عرف الرضا يتنسم % % 2(@)(@@) % تبسم ثغر الثغر عنها بشارة % % فأعدى ثغور الزهر منه التبسم % % 3(@)(@@) % ولا عجب من مبسم الزهر في الربا % % فللبرق من خلف السحائب مبسم % % 4(@)(@@) % عناية من أعطى الخليفة رتبة % % عليها النجوم النيرات تحوم % % 5(@)(@@) % فمنه استفاد الملك كل غريبة % % تخط على صفح الزمان وترسم % % 6(@)(@@) % ومنه تلقى الهدي كل خليفة % % كأنهم مما أفاد تعلموا % % PageV01P223 البحر : - 1(@)(@@) % وكم من لواء في الفتوح نشرته % % وللرعب جيش دونه يتقدم % % 2(@)(@@) % فقل لملوك الأرض دونكم فقد % % أعلم 
ms62	 ما لا زال بالنصر يعلم % % 3(@)(@@) % تسامت به للنصر أشرف ذمة % % لها من رسول الله عهد مكرم % % 4(@)(@@) % وكم من جهاد قد أقمت فروضه % % يزار به البيت العتيق وزمزم % % 5(@)(@@) % وكم عزمة جردت منها إلى العدا % % حساما به داء الضلالة يحسم % % 6(@)(@@) % وكم بيت مال في الجهاد بذلته % % وأقرضت منه الله ما الله يعلم % % 7(@)(@@) % وكم ليلة قد جئت فيها بليلة % % من النقع فيها للأسنة أنجم % % 8(@)(@@) % سهرت بها والله يكتب أجرها % % تؤمن فيها الخلق والخلق نوم % % 9(@)(@@) % وفوقك من سعد لواء مشهر % % ودونك من عزم حسام مصمم % % 10(@)(@@) % إذا أنت جهزت الجياد لغارة % % فإن صباح الحي أغبر أقتم % % PageV01P224 11(@)(@@) % فمن أشهب مهما يكر رأيته % % صباحا بليل النقع لا يتكتم % % 12(@)(@@) % وأحمر قد أذكى به البأس جذوة % % إذا ابتل عطفا في الوغى يتضرم % % 13(@)(@@) % وأشقر أعدى البرق لونا وسرعة % % ولكن له دون البروق التقدم % % 14(@)(@@) % واصفر في لون العشي وذيله % % ولون الذي بعد العشية يعلم % % 15(@)(@@) % وأدهم مثل الليل والبدر غرة % % وبالشهب في حلي المقلد ملجم % % 16(@)(@@) % واشهب كالقرطاس قد خط صفحه % % كتاب من النصر المؤزر محكم % % 17(@)(@@) % ورب جلاد في جدال سطرته % % يراع القنا فيه تخط وترسم % % 18(@)(@@) % وقام خطيب السيف فوق رؤوسهم % % فأعجب منه أعجم يتكلم % % 19(@)(@@) % فكم من رؤوس عن جسوم أزالها % % فأثكل منها كل باغ يجسم % % 20(@)(@@) % وزرق عيون للأسنة قد بكت % % ولا دمع إلا ما أسيل به الدم % % PageV01P225 21(@)(@@) % ونهر حسام كلما أغرق العدا % % تلقتهم منه سريعا جهنم % % 22(@)(@@) % فأصليت عباد المسيح من الوغى % % سعيرا به يرضى المسيح ومريم % % 23(@)(@@) % أبر من التثليث بالله وحده % % فمن يعتصم بالله فالله يعصم % % 24(@)(@@) % ونبه سيوفا ماضيات على العدا % % وخل جفون المرهفات تهوم % % 25(@)(@@) % ولله من شهر الصيام مودع % % على كل محتوم السعادة يكرم % % 26(@)(@@) % تنزل فيه الذكر من عند ربنا % % فيبدأ بالذكر الجميل ويختم % % 27(@)(@@) % ولله فيه من ليال منيرة % % اضاء بنور الوحي منهن مظلم % % 28(@)(@@) % وصابت سحاب الدمع يمحى بمائها % % من الصحف أوزار تخط ومأثم % % 29 
ms63	(@)(@@) % ولله فيه ليلة القدر قد غدت % % على الف شهر في الثواب تقدم % % 30(@)(@@) % تبيت بها حتى الصباح بإذنه % % ملائكة السبع الطباق تسلم % % PageV01P226 31(@)(@@) % وبشرى بعيد الفطر ايمن قادم % % عليك بمجموع البشائر يقدم % % 32(@)(@@) % جعلت قراه سنة نبوية % % لها في شعار الدين قدر معظم % % 33(@)(@@) % وفي دعوات للإله رفعتها % % تسدد منها للإجابة اسهم % % 34(@)(@@) % وفي كل يمن من محياك قرة % % وفي كل كف من نوالك أنعم % % 35(@)(@@) % إذا أنت لم تفخر بما أنت أهله % % فلا ابصر المصباح من يتوسم % % 36(@)(@@) % فما مهد الإسلام غير خليفة % % على عطفه در المحامد ينظم % % 37(@)(@@) % ولسن بيوتا بل قصورا مشيدة % % تطل على أوج العلا وتخيم % % 38(@)(@@) % وما ضرها أن قد تأخر عهدها % % إذا طال مبناها الذين تقدموا % % 39(@)(@@) % وإذ أنت مولاها وعامر ربعها % % فكل فخار تدعيه مسلم % % 40(@)(@@) % أنا العبد قد أسكنته جنة الرضا % % فلا زلت فيها خالدا تتنعم % % PageV01P227 41(@)(@@) % ولا زلت في الأعياد ساجع روضها % % إذا احتفلت أشرافها أترنم % % 42(@)(@@) % بقيت متى يبل الزمان تجده % % وفي كل يوم منك عيد وموسم % % 43(@)(@@) % ودمت لألف مثله في سعادة % % يذل بها باغ ويعتز مسلم % % 44(@)(@@) % ولما رأيت الفخر جهد مقصر % % وأنك أعلى من مديحي وأعظم % % 45(@)(@@) % ختمت ثنائي بالدعاء وها أنا % % أقلب في كف الندى وأسلم % % PageV01P228 البحر : - 1(@)(@@) % رضيت بما تقضي علي وتحكم % % أهان فأقصى أم أعز فأكرم % % 2(@)(@@) % إذا كان قلبي في يديك قياده % % فمالي عليه في الهوى أتحكم % % 3(@)(@@) % على أن روحي في يديك بقاؤها % % بوصلك تحيي أو بهجرك تعدم % % 4(@)(@@) % وأنت إلى المشتاق نار وجنة % % ببعدك يشقى أو بقربك ينعم % % 5(@)(@@) % ولي كبد تندى إذا ما ذكرتم % % وقلب بنيران الهوى يتضرم % % 6(@)(@@) % ولو كان ما بي منك بالبرق ما سرى % % ولا استصحب الأنواء تبكي وتبسم % % 7(@)(@@) % اراعي نجوم الافق في الليل ما دجا % % وأقرب من عيني للنوم أنجم % % 8(@)(@@) % وما زلت أخفي الحب عن كل عاذل % % وتبدي دموع الصب ما هو يكتم % % 9(@)(@@) % كساني الهوى ثوب السقام وإنه % % متى صح حب المرء لا 
ms64	 شيء يسقم % % 10(@)(@@) % فيا من له الفعل الجميل سجية % % ومن جود يمناه الهوى يتعلم % % PageV01P229 11(@)(@@) % وعنه يروي الناس كل غريبة % % تخط علي صفح الزمان وترسم % % 12(@)(@@) % إذا أنت لم ترحم خضوعي في الهوى % % فمن ذا الذي يحنو علي ويرحم % % 13(@)(@@) % ووالله ما في الحي حي ولم ينل % % رضاك وعمته أياد وأنعم % % 14(@)(@@) % ومن قبل ما طوقتني كل نعمة % % كأني وإياها سوار ومعصم % % 15(@)(@@) % وفتحت لي باب القبول مع الرضا % % فما بال ذاك الباب عني مبهم % % 16(@)(@@) % ولو كان لي نفس تخونك في الهوى % % لفارقتها طوعا وما كنت أندم % % 17(@)(@@) % وأترك أهلي في رضاك إلى الأسى % % واسلم نفسي في يديك واسلم % % 18(@)(@@) % أما والذي أشقى فؤادي وقادني % % وإن كان في تلك الشقاوة ينعم % % 19(@)(@@) % لأنت منى قلبي ونزهة خاطري % % ومورد آمالي وإن كنت أحرم % % PageV01P230 البحر : - 1(@)(@@) % قيادي قد تملكه الغرام % % ووجدي لا يطاق ولا يرام % % 2(@)(@@) % ودمعي دونه صوب الغوادي % % وشجوي فوق ما يشكو الحمام % % 3(@)(@@) % إذا ما الوجد لم يبرح فؤادي % % على الدنيا وساكنها السلام % % PageV01P231 البحر : - 1(@)(@@) % تجلى لنا المولى الإمام محمد على أدهم قد راق حسن أديمه % . . . % 2(@)(@@) % فأبصرت صبحا فوق ليل وقد حكى % % مقلد ذاك الطرف بعض نجومه % % PageV01P232 البحر : - 1(@)(@@) % تجلى لنا المولى الإمام محمد % % على أدهم قد راق حسن أديمه % % 2(@)(@@) % فأبصرت صبحا فوق ليل وقد حكى % % مقلد ذاك الطرف بعض نجومه % % 3(@)(@@) % ثم قال ومن ذلك ما أنشد في الصنيع الثاني المخصوص بعمينا السيدين الأميرين سعد ونصر رحمة الله تعالى عليهما وأجاد في وصف الجند والجرد والطلبة وغرائب الأوضاع من الكامل أللمحة من بارق متبسم % % أرسلته دمعا تضرج بالدم % % 4(@)(@@) % وللمحة تهفو ببانات اللوى % % يهفو فؤادك عن جوانح مغرم % % 5(@)(@@) % هي عادة عذرية من يوم أن % % خلق الهوى تعتاد كل متيم % % 6(@)(@@) % قد كنت أعذل ذا الهوى من قبل أن % % أدري الهوى واليوم أعذل لومي % % 7(@)(@@) % كم زفرة بين الجوانح ما ارتقت % % حذر الرقيب ومدمع لم يسجم % % 8(@)(@@) % إن كان واشي الدمع قد كتم الهوى % % هيهات 
ms65	 واشي السقم لما يكتم % % 9(@)(@@) % ولقد أجد هواي رسم دارس % % قد كان يخفى عن خفي توهم % % 10(@)(@@) % وذكرت عهدا في حماه قد انقضى % % فأطلت فيه ترددي وتلومي % % PageV01P233 11(@)(@@) % ولربما أشجى فؤادي عنده % % ورقاء تنفث شجوها بترنم % % 12(@)(@@) % لا أجدب الله الطلول فطالما % % أشجى الفصيح بها بكاء الأعجم % % 13(@)(@@) % يا زاجر الأظعان يحفزها السرى % % قف بي عليها وقفة المتلوم % % 14(@)(@@) % لترى دموع العاشقين برسمها % % حمرا كحاشية الرداء المعلم % % 15(@)(@@) % دمن عهدت بها الشبيبة والهوى % % سقيا لها ولعهدها المتقدم % % 16(@)(@@) % وكتيبة للشوق قد جهزتها % % أغزو بها السلوان غزو مصمم % % 17(@)(@@) % ورفعت فيها القلب بندا خافقا % % وأريت للعشاق فضل تهممي % % 18(@)(@@) % فأنا الذي شاب الحماسة بالهوى % % لكن من أهواه ضايق مقدمي % % 19(@)(@@) % فطعنت من قد القوام بأسمر % % ورميت من غنج اللحاظ بأسهم % % 20(@)(@@) % يا قاتل الله الجفون فإنها % % مهما رمت لم تخط شاكلة الرمي % % PageV01P234 21(@)(@@) % ظلمت قتيل الحب ثم تبينت % % للسقم فيها فترة المتظلم % % 22(@)(@@) % يا ظبية سنحت بأكناف الحمى % % سقي الحمى صوب الغمام المسجم % % 23(@)(@@) % ما ضر إذ أرسلت نظرة فاتك % % أن لو عطفت بنظرة المترحم % % 24(@)(@@) % فرأيت جسما قد أصيب فؤاده % % من مقلتيك وأنت لم تتأثمي % % 25(@)(@@) % ولقد خشيت بأن يقاد بجرحه % % فوهبت لحظك ما أحلك من دمي % % 26(@)(@@) % كم خضت دونك من غمار مفازة % % لا تهتدي فيها الليوث لمجثم % % 27(@)(@@) % والنجم يسري من دجاه بأدهم % % رحب المقلد بالثريا ملجم % % 28(@)(@@) % والبدر في صفح السماء كأنه % % مرآة هند وسط لج ترتمي % % 29(@)(@@) % والزهر زهر والسماء حديقة % % فتقت كمائم جنحها عن أنجم % % 30(@)(@@) % والليل مربد الجوانح قد بدا % % فيه الصباح كغرة في أدهم % % PageV01P235 31(@)(@@) % فكأنما فلق الصباح وقد بدا % % مرأى ابن نصر لاح للمتوسم % % 32(@)(@@) % ملك أفاض على البسيطة عدله % % فالشاة لا تخشى اعتداء الضيغم % % 33(@)(@@) % هو منتهى آمال كل موفق % % هو مورد الصادي وكنز المعدم % % 34(@)(@@) % لاحت مناقبه كواكب أسعد % % فرأت ملامح نوره عين العمي % % 35(@)(@@) % ولقد تراءى بأسه وسماحة % % فأتى الجلال من الجمال بتوءم % % 36(@)(@@) % مثل الغمام وقد تضاحك برقه 
ms66	 % % فأفاد بين تجهم وتبسم % % 37(@)(@@) % أنسى سماحة حاتم وكذاك في % % يوم اللقاء ربيعة بن مكدم % % 38(@)(@@) % سير تسير النيرات بهديها % % وتعير عرف الروض طيب تنسم % % 39(@)(@@) % فالبدردونك في علا وإنارة % % والبحر دونك في ندى وتكرم % % 40(@)(@@) % ولك القباب الحمر ترفع للندى % % فترى العمائم تحتها كالأنجم % % PageV01P236 41(@)(@@) % يذكي الكباء بها كأن دخانه % % قطع السحاب بجوها المتغيم % % 42(@)(@@) % ولك العوالي السمر تشرع للعدى % % فتخر صرعى لليدين وللفم % % 43(@)(@@) % ولك الأيادي البيض قد طوقتها % % صيد الملوك ذوي التلاد الأقدام % % 44(@)(@@) % شيم يقر الحاسدون بفضلها % % والصبح ليس ضياؤه بمكتم % % 45(@)(@@) % ورث السماحة عن أبيه وجده % % فالأكرم ابن الأكرم ابن الأكرم % % 46(@)(@@) % نقلوا المعالي كابرا عن كابر % % كالرمح مطرد الكعوب مقوم % % 47(@)(@@) % وتسنموا رتب العلاء بحقها % % ما بين جد في الخلافة وابنم % % 48(@)(@@) % يا آل نصر أنتم سرج الهدى % % في كل خطب قد تجهم مظلم % % 49(@)(@@) % الفاتحون لكل صعب مقفل % % والفارجون لكل خطب مبهم % % 50(@)(@@) % والباسمون إذا الكماة عوابس % % والمقدمون على السواد الأعظم % % PageV01P237 51(@)(@@) % أبناء أنصار النبي وحزبه % % وذوي السوابق والحوار الأعصم % % 52(@)(@@) % سل عنهم أحدا وبدرا تلقهم % % أهل الغناء بها وأهل المغنم % % 53(@)(@@) % وبفتح مكة كم لهم في يومه % % بلواء خير الخلق من متقدم % % 54(@)(@@) % اقسمت بالحرم الأمين ومكة % % والركن والبيت العتيق وزمزم % % 55(@)(@@) % لولا مآثرهم وفضل علاهم % % ما كان يعزى الفضل للمتقدم % % 56(@)(@@) % ماذا عسى أثني وقد أثنت على % % عليائهم آي الكتاب المحكم % % 57(@)(@@) % يا وارثا عنها مآثرها التي % % قد شيدت للفخر أشرف معلم % % 58(@)(@@) % يا فخر أندلس لقد مدت إلى % % علياك كف اللائذ المستعصم % % 59(@)(@@) % أما سعودك في الوغى فتكفلت % % بسلامة الإسلام فاخلد واسلم % % 60(@)(@@) % وافيت هذا الثغر وهو على شفا % % فشفيت معضل دائه المستحكم % % PageV01P238 61(@)(@@) % ورعيته بسياسة دارت على % % مختطه دور السوار بمعصم % % 62(@)(@@) % كم ليلة قد بت فيها ساهرا % % تهدي الأمان إلى العيون النوم % % 63(@)(@@) % يا مظهر الألطاف وهي خفية % % ومهب ريح النصر للمتنسم % % 64(@)(@@) % لله دولتك التي آثارها % % سير الركاب لمنجد أومتهم % % 65(@)(@@) % ما بعد يومك في المواسم بعدما 
ms67	 % % أتبعت عيد الفطر أكرم موسم % % 66(@)(@@) % وافتك اشراف البلاد ليومه % % من كل ندب للعلا متسنم % % 67(@)(@@) % صرفوا إليك ركابهم وتيمموا % % من بابك المنتاب خير ميمم % % 68(@)(@@) % تبوأوا منه بدار كرامة % % فالكل بين مقرب ومنعم % % 69(@)(@@) % ودت نجوم الأفق لو مثلت به % % لتفوز فيه برتبة المستخدم % % 70(@)(@@) % والروض مختال بحلية سندس % % من كل موشي الرقوم منمنم % % PageV01P239 71(@)(@@) % ورياحه نسمت بنشر لطيمة % % وأقاحة بسمت بثغر ملثم % % 72(@)(@@) % واريتنا فيه عجائب جمة % % لم تجر في خلد ولم تتوهم % % 73(@)(@@) % أرسلت سرعان الجياد كأنها % % أسراب طير في التنوفة حوم % % 74(@)(@@) % من كل منحفز بخطفة بارق % % قد كاد يسبق لمحة المتوهم % % 75(@)(@@) % طرف يشك الطرف في استثباته % % فكأنه ظن بصدر مرجم % % 76(@)(@@) % ومسافر في الجو تحسب أنه % % يرقى إلى أوج السماء بسلم % % 77(@)(@@) % رام استراق السمع وهو ممنع % % فأصيب من قضب العصي بأسهم % % 78(@)(@@) % رجمته من شهب النصال حواصب % % لولا تعرضه لها لم يرجم % % 79(@)(@@) % ومدارة الأفلاك أعجز كنهها % % إبداع كل مهندس ومهندم % % 80(@)(@@) % يمشي الرجال بجوفها وجميعهم % % عن مستوى قدميه لم يتقدم % % PageV01P240 81(@)(@@) % ومنوع الحركات قد ركب الهوا % % يمشي على خط به متوهم % % 82(@)(@@) % فإذا هوى من جوه ثم استوى % % أبصرت طيرا حول صورة آدم % % 83(@)(@@) % يمشي على فنن الرشاء كأنه % % فيه مساور ذابل أو أرقم % % 84(@)(@@) % وإليك من صون العقول عقيلة % % وقفت ببابك وقفة المسترحم % % 85(@)(@@) % ترجو قبولك وهو أكبر منحة % % فاسمح به خلدت من متكرم % % 86(@)(@@) % طاردت فيها وصف كل غريبة % % فنظمت شاردة الذي لم ينظم % % 87(@)(@@) % ودعوت أرباب البيان اريهم % % كم غادر الشعراء من متردم % % 88(@)(@@) % ما ذاك إلا بعض أنعمك التي % % قد علمتنا كيف شكر المنعم % % PageV01P241 البحر : - 1(@)(@@) % الحمد لله بلغنا المنى % % لما رأيناك وزال العنا % % 2(@)(@@) % وفزت بالأجر وكبت العدى % % وفزت بالعز وطيب الثنا % % 3(@)(@@) % فالحمد لله على ما به % % من علينا من ظهور السنا % % PageV01P242 البحر : - 1(@)(@@) % يا خير من ورث السماح عن الألى % % نصروا الألى وتبوأوا الإيمانا % % 2(@)(@@) % في كل يوم منك تحفة منعم % % وإلى الجميل وأجزل الإحسانا 
ms68	 % % 3(@)(@@) % قد أذكرت دار النعيم عبيدة % % وتضمنت من فضله رضوانا % % 4(@)(@@) % تهدي موالي الذين تفرعوا % % عن روح فخرك في العلا أغصانا % % 5(@)(@@) % لجلالك الأعلى قنيصا أتعبوا % % في صيده الأرواح والأبدانا % % 6(@)(@@) % فتخصني منه بأوفر قسمة % % فسحت لعبدك في الرضى ميدانا % % 7(@)(@@) % لله من مولى كريم بالذي % % تهدي الموالي يتحف العبدانا % % 8(@)(@@) % تدعو بني إلى الغني بربه % % يا ربنا أغن الذي أغنانا % % 9(@)(@@) % وعليك من قوس الإله تحية % % تهديك منه الروح والريحانا % % PageV01P243 البحر : - 1(@)(@@) % مالي بحمل الهوى يدان % % من بعد ما أعوز التداني % % 2(@)(@@) % أصبحت اشكوه من زمان % % ما بت منه على أمان % % 3(@)(@@) % ما بال عينيك تسجمان % % والدمع يرفض كالجمان % % 4(@)(@@) % ناداك والإلف عنك وإن % % والبعد من بعده كواني % % 5(@)(@@) % يا شقة النفس من هوان % % لجج في أبحر الهوان % % 6(@)(@@) % لم يثنني عن هواك ثان % % يا بغية القلب قد كفاني % % PageV01P244 البحر : - 1(@)(@@) % لعل الصبا إن صافحت روض نعمان % % تؤدي أمان القلب عن ظبية البان % % 2(@)(@@) % وماذا على الأرواح وهي طليقة % % لو احتملت أنفاسها حاجة العاني % % 3(@)(@@) % وما حال من يستودع الريح سره % % ويطلبها وهي النموم بكتمان % % 4(@)(@@) % وكالضيف استقريه في سنة الكرى % % وهل تنقع الاحلام غلة ظمآن % % 5(@)(@@) % أسائل عن نجد ومرمى صبابتي % % ملاعب غزلان الصريم بنعمان % % 6(@)(@@) % وأبدي إذا ريح الشمال تنفست % % شمائل مرتاح المعاطف نشوان % % 7(@)(@@) % عرفت بهذا الحب لم أدر سلوة % % وأنى لمسلوب الفؤاد بسلوان % % 8(@)(@@) % فيا صاحبي نجواي والحب غاية % % فمن سابق جلى مداه ومن وان % % 9(@)(@@) % وراءكما ما اللوم يثني مقادتي % % فإني عن شأن الملامة في شان % % 10(@)(@@) % وإني وإن كنت الأبي قياده % % ليأمرني حب الحسان وينهاني % % PageV01P245 11(@)(@@) % وما زلت ارعى العهد فيمن يضيعه % % وأذكر إلفي ما حييت وينساني % % 12(@)(@@) % فلا تنكرا ما سامني مضض الهوى % % فمن قبل ما أودى بقيس وغيلان % % 13(@)(@@) % لي الله إما أومض البرق في الدجى % % أقلب تحت الليل مقلة وسنان % % 14(@)(@@) % وإن سل في غمد الغمام حسامه % % برى كبدي الشوق الملم واضناني % % 15(@)(@@) % تراءى بأعلام الثنية باسما % % فأذكرني العهد القديم 
ms69	 وأبكاني % % 16(@)(@@) % أسامر نجم الأفق حتى كأننا % % وقد سدل الليل الرواق حليفان % % 17(@)(@@) % ومما أناجي الافق أعديه بالجوى % % فأرعى له سرح النجوم ويرعاني % % 18(@)(@@) % ويرسل صوب القطر من فيض أدمعي % % ويقدح زند البرق من نار أشجاني % % 19(@)(@@) % وضاعف وجدي رسم دار عهدتها % % مطالع شهب أو مراتع غزلان % % 20(@)(@@) % على حين شرب الوصل غير مصرد % % وصفو الليالي لم يكدر بهجران % % PageV01P246 21(@)(@@) % لئن أنكرت عيني الطلول فإنها % % تمت إلى قلبي بذكر وعرفان % % 22(@)(@@) % ولم أر مثل الدمع في عرصاتها % % سقى تربها حين استهل وأظماني % % 23(@)(@@) % ومما شجاني أن سرى الركب موهنا % % تقاد به هوج الرياح بأرسان % % 24(@)(@@) % غوارب في بحر السراب تخالها % % وقد سبحت فيه مواخر غربان % % 25(@)(@@) % على كل نضو مثله فكأنما % % رمى منهما صدر المفازة سهمان % % 26(@)(@@) % ومن زاجر كوماء مخطفة الحشا % % توسد منها فوق عوجاء مرنان % % 27(@)(@@) % نشاوى غرام يستميل رؤوسهم % % من تبلغ الأوطار فرقة أوطان % % 28(@)(@@) % أجابوا نداء البين طوع غرامهم % % وقد تبلغ الأوطار فرقة أوطان % % 29(@)(@@) % يؤمون من قبر الشفيع مثابة % % تطلع منها جنة ذات أفنان % % 30(@)(@@) % إذا نزلوا من طيبة بجواره % % فأكرم مولى ضم أكرم ضيفان % % PageV01P247 31(@)(@@) % بحيث علا الإيمان وامتد ظله % % وزان حلى التوحيد تعطيل أوثان % % 32(@)(@@) % مطالع آيات مثابة رحمة % % معاهد أملاك مظاهر إيمان % % 33(@)(@@) % هنالك تصفو للقبول موارد % % يسقون منها فضل عفو وغفران % % 34(@)(@@) % هناك تؤدي للسلام أمانة % % يحييهم عنها بروح وريحان % % 35(@)(@@) % يناجون عن قرب شفيعهم الذي % % يؤمله القاصي من الخلق والداني % % 36(@)(@@) % لئن بلغوا دوني وخلفت إنه % % قضاء جرى من مالك الأرض ديان % % 37(@)(@@) % وكم عزمة مليت نفسي صدقها % % وقد عرفت مني مواعد ليان % % 38(@)(@@) % إلى الله نشكوها نفوسا أبية % % تحيد عن الباقي وتغتر بالفاني % % 39(@)(@@) % ألا ليت شعري هل تساعدني المنى % % فاترك أهلي في رضاه وجيراني % % 40(@)(@@) % واقضي لبانات الفؤاد بأن أرى % % أعفر خدي في ثراه وأجفاني % % PageV01P248 41(@)(@@) % إليك رسول الله دعوة نازح % % خفوق الحشا رهن المطالع هيمان % % 42(@)(@@) % غريب بأقصى الغرب قيد خطوه % % شباب تقضى في مراح وخسران % % 43 
ms70	(@)(@@) % يجد اشتياقا للعقيق وبانه % % ويصبو إليها ما استجد الجديدان % % 44(@)(@@) % وإن اومض البرق الحجازي موهنا % % يردد في الظلماء أنة لهفان % % 45(@)(@@) % فيا مولي الرحمى ويا مذهب العمى % % ويا منجي الغرقى ويا منقذ العاني % % 46(@)(@@) % بسطت يد المحتاج يا خير راحم % % وذنبي ألجاني إلى موقف الجاني % % 47(@)(@@) % وسيلتي العظمى شفاعتك التي % % يلوذ بها عيسى وموسى بن عمران % % 48(@)(@@) % فأنت حبيب الله خاتم رسله % % وأكرم مخصوص بزلفى ورضوان % % 49(@)(@@) % وحسبك أن سماك أسماءه العلى % % وذاك كمال لا يشاب بنقصان % % 50(@)(@@) % وأنت لهذا الكون علة كونه % % ولولاك ما امتاز الوجود بأكوان % % PageV01P249 51(@)(@@) % ولولاك للافلاك لم تجل نيرا % % ولا قلدت لباتهن بشهبان % % 52(@)(@@) % خلاصة صفو المجد من آل هاشم % % ونكتة سر الفخر من آل عدنان % % 53(@)(@@) % وسيد هذا الخلق من نسل آدم % % وأكرم مبعوث إلى الإنس والجان % % 54(@)(@@) % وكم آية أطلعت في أفق الهوى % % يبين صباح الرشد منها ليقظان % % 55(@)(@@) % وما الشمس يجلوها النهار لمبصر % % بأجلى ظهورا أو بأوضح برهان % % 56(@)(@@) % وأكرم بآيات تحديتنا بها % % ولا مثل آيات لمحكم فرقان % % 57(@)(@@) % وماذا عسى يثني البليغ وقد أتى % % ثناؤك في وحي كريم وقرآن % % 58(@)(@@) % فصلى عليك الله ما انسكب الحيا % % وما سجعت ورقاء في غصن البان % % 59(@)(@@) % وأيد مولانا ابن نصر فإنه % % لأشرف من ينمى لملك وسلطان % % 60(@)(@@) % اقام كما يرضيك مولدك الذي % % به سفر الإسلام عن وجه جذلان % % PageV01P250 61(@)(@@) % سمي رسول الله ناصر دينه % % معظمه في حال سر وإعلان % % 62(@)(@@) % ووارث سر المجد من آل خزرج % % واكرم من تنمي قبائل قحطان % % 63(@)(@@) % ومرسلها ملء الفضاء كتائبا % % تدين لها غلب الملوك بإذعان % % 64(@)(@@) % حدائق خضر والدروع غدائر % % وما أنبتت إلا ذوابل مران % % 65(@)(@@) % تجاوب فيها الصاهلات وترتمي % % جوانبها بالأسد من فوق عقبان % % 66(@)(@@) % فمن كل خوار العنان قد ارتمى % % به كل مطعام العشيات مطعان % % 67(@)(@@) % وموردها ظمأى الكعوب ذوابلا % % ومصدرها من كل أملد ريان % % 68(@)(@@) % ولله منها والربوع مواحل % % غمام ندى كفت بها المحل كفان % % 69(@)(@@) % إذا أخلف الناس الغمام وأمحلوا % % فإن نداه والغمام لسيان 
ms71	 % % 70(@)(@@) % إمام أعاد الملك بعد ذهابه % % إعادة لا نابي الحسام ولا وان % % PageV01P251 71(@)(@@) % فغادر أطلال الضلال دوارسا % % وجدد بالاسلام أرفع بنيان % % 72(@)(@@) % وشيدها والمجد يشهد دولة % % محافلها تزهى بيمن وإيمان % % 73(@)(@@) % وراق من الثغر الغريب ابتسامه % % وهز له الإسلام أعطاف مزدان % % 74(@)(@@) % لك الخير ما أسنى شمائلك التي % % يقصر عن إدراكها كل إنسان % % 75(@)(@@) % ذكاء إياس في سماحة حاتم % % وإقدام عمرو في بلاغة سحبان % % 76(@)(@@) % أمولاي ما أسنى مناقبك التي % % هي الشهب لا تحصى بعد وحسبان % % 77(@)(@@) % فلا زلت ياغوث البلاد وأهلها % % مبلغ أوطار ممهد أوطان % % PageV01P252 البحر : - 1(@)(@@) % يا من به رتب الإمارة تعتلي % % ومعالم الفخر المشيدة تبتني % % 2(@)(@@) % أرجز بهذا الثلج فألا إنه % % ثلج اليقين بنصر مولانا الغني % % 3(@)(@@) % بسط البياض كرامة لقدومه % % وافتر ثغرا عن كرامة معتني % % 4(@)(@@) % فالأرض جوهرة تلوح لمجتل % % والدوح مزهرة تفوح لمجتني % % 5(@)(@@) % سبحان من أعطى الوجود وجوده % % ليدل منه على الجواد المحسن % % 6(@)(@@) % وبدائع الأكوان في إتقانها % % اثر يشير إلى البديع المتقن % % PageV01P253 البحر : - 1(@)(@@) % يا من يحن إلى نجد وناديها % % غرناطة قد ثوت نجد بواديها % % 2(@)(@@) % قف بالسبيكة وانظر ما بساحتها % % عقيلة والكثيب الفرد جاليها % % 3(@)(@@) % تقلدت بوشاح النهر وابتسمت % % أزهارها هي حلي في تراقيها % % 4(@)(@@) % وأعين النرجس المطلول يانعة % % ترقرق الطل دمعا في مآقيها % % 5(@)(@@) % وافتر ثغر أقاح من أزاهرها % % مقبلا خد ورد من نواحيها % % 6(@)(@@) % كأنما الزهر في حافاتها سحرا % % دراهم والنسيم اللدن يجبيها % % 7(@)(@@) % وانظر إلى الدوح والأنهار تكنفها % % مثل الندامى سواقيها سواقيها % % 8(@)(@@) % كم حولها من بدور تجتني زهرا % % فتحسب الزهر قد قبلن أيديها % % 9(@)(@@) % حصباؤها لؤلؤ قد شف جوهرها % % والنهر قد سال ذوبا من لآليها % % 10(@)(@@) % نهر المجرة والزهر المطيف به % % زهر النجوم إذا ما شئت تشبيها % % PageV01P254 11(@)(@@) % يزيد حسنا على نهر المجرة قد أغناه در حباب عن دراريها % . . . % 12(@)(@@) % يدعى المنجم رائيه وناظره % % مسميات أبانتها أساميها % % 13(@)(@@) % إن الحجاز مغانيه بأندلس % % ألفاظها طابقت منها معانيها % % 14(@)(@@) % فتلك نجد سقاها كل منسجم % % من الغمام يحييها فيحييها % % 15(@)(@@) % وبارق 
ms72	 وعذيب كل مبتسم % % من الثغور يجليها مجليها % % 16(@)(@@) % وإن أردت ترى وادي العقيق فرد % % دموع عاشقها حمرا مجاريها % % 17(@)(@@) % وللسبيكة تاج فوق مفرقها % % تود در الدراري لو تحليها % % 18(@)(@@) % فإن حمراءها والله يكلؤها % % ياقوتة فوق ذاك التاج يعليها % % 19(@)(@@) % إن البدور لتيجان مكللة % % جواهر الشهب في أبهى مجاليها % % 20(@)(@@) % لكنها حسدت تاج السبيكة إذ رأت أزاهره زهرا يجليها % . . . % PageV01P255 21(@)(@@) % بروجها لبروج الأفق مخجلة % % فشهبها في جمال لا تضاهيها % % 22(@)(@@) % تلك القصور التي راقت مظاهرها % % تهوى النجوم قصورا عن معاليها % % 23(@)(@@) % لله لله عينا من رأى سحرا % % تلك المنارة قد رقت حواشيها % % 24(@)(@@) % والصبح في الشرق قد لاحت بشائره % % والشهب تستن سبقا في مجاريها % % 25(@)(@@) % تهوي إلى الغرب لما غالها سحر % % وغمض الفجر من أجفان واشيها % % 26(@)(@@) % وساجع العود في كف النديم إذا % % ما استوقفت ساجعات الطير يغريها % % 27(@)(@@) % يبدي أفانين سحر في ترنمه % % يصبي العقول بها حسنا ويسبيها % % 28(@)(@@) % يجسه ناعم الاطراف تحسبها % % لآلئا هي نور في تلاليها % % 29(@)(@@) % مقاتل بلحاظ قوس حاجبها % % ترمي القلوب بها عمدا فتصميها % % 30(@)(@@) % فباكر الروض والأغصان مائلة % % يثني النفوس لها شوقا تثنيها % % PageV01P256 31(@)(@@) % لم يرقص الدوح بالأكمام من طرب % % حتى شدا من قيان الطير شاديها % % 32(@)(@@) % واسمعتها فنون السحر مبدعة % % ورق الحمام وغناها مغنيها % % 33(@)(@@) % غرناطة آنس الرحمن ساكنها % % باحت بسر معانيها أغانيها % % 34(@)(@@) % أعدى نسيمهم لطفا نفوسهم % % فرقة الطبع طبع منه يعديها % % 35(@)(@@) % فخلد الله ايام السرور بها % % صفرا عشياتها بيضا لياليها % % 36(@)(@@) % وروض المحل منها كل منبجس % % إذا اشتكت بقليل الجدب يرويها % % 37(@)(@@) % يحكي الخليفة كفا كلما وكفت % % بالجود فوق موات الأرض يحييها % % 38(@)(@@) % تغني العفاة وقد أمت مكارمه % % عن السؤال وبالإحسان يغنيها % % 39(@)(@@) % لها بنان فلا غيث يساجلها % % جودا ولا سحبه يوما تدانيها % % 40(@)(@@) % فإن تصب سحبه بالماء حين همت % % بعسجد ولجين صاب هاميها % % PageV01P257 41(@)(@@) % يا ايها الغوث أنت الغوث في زمن % % ملوكه تلفت لولا تلافيها % % 42(@)(@@) % إن الرعايا جزاك الله صالحة % % ملكت شرقا وغربا من يراعيها % % 43(@)(@@) % إن الخلائق في 
ms73	 الاقطار أجمعها % % سوائم أنت في التحقيق راعيها % % 44(@)(@@) % فكل مصلحة للخلق تحكمها % % وكل صالحة في الدين تنويها % % 45(@)(@@) % إذا تيممت أرضا وهي مجدبة % % فرحمة الله بالسقيا تحييها % % 46(@)(@@) % يا رحمة بثت الرحمى بأندلس % % لولاك زلزلت الدنيا بمن فيها % % 47(@)(@@) % في فضل جودك قد عاشت مشيختها % % في ظل أمنك قد نامت ذراريها % % 48(@)(@@) % في طول عمرك يرجو الله آملها % % بنصر ملكك يدعو الله داعيها % % 49(@)(@@) % عوائد الله قد عودت أفضلها % % لتبلغ الخلق ما شاءت أمانيها % % 50(@)(@@) % سل السعود وخل البيض مغمدة % % واضرب بها فرية التثليث تفريها % % PageV01P258 51(@)(@@) % لله أيامك الغر التي اطردت % % فيها السعود بما ترضى ويرضيها % % 52(@)(@@) % لله دولتك الغراء إن لها % % لكافلا من إله العرش يكفيها % % 53(@)(@@) % هيهات أن تبلغ الأعداء مأربة % % في جريها وجنود الله تحميها % % 54(@)(@@) % هذي سيوفك في الأجفان نائمة % % والمشركون سيوف الله تفنيها % % 55(@)(@@) % سريرة لك في الإخلاص قد عرفت % % حسنى عواقبها حتى أعاديها % % 56(@)(@@) % لم يحجب الصبح شهب الأفق عن بصر % % إلا وهديك للأبصار يبديها % % 57(@)(@@) % يا ابن الملوك وأبناء الملوك إذا % % تدعو الملوك إلى طوع تلبيها % % 58(@)(@@) % ابناء نصر ملوك عز نصرهم % % وأوسعوا الخلق تنويها وترفيها % % 59(@)(@@) % هم المصابيح نور الله موقدها % % تضيء للدين والدنيا مشاكيها % % 60(@)(@@) % هم النجوم وأفق الهدي مطلعها % % فوزا لمهديها عزا لهاديها % % PageV01P259 61(@)(@@) % هم البدور كمال ما يفارقها % % هم الشموس ظلام لا يواريها % % 62(@)(@@) % قضت قواضبها أن لا انقضاء لها % % وأمضت الحكم في الأعدا مواضيها % % 63(@)(@@) % وخلدت في صفاح الهند سيرتها % % وأسندت عن عواليها معاليها % % 64(@)(@@) % وأورثتك جهادا أنت ناصره % % والأجر منك يرضيها ويحظيها % % 65(@)(@@) % كم موقف ترهب الأعداء موقفه % % والخيل تردي ووقع السمر يرديها % % 66(@)(@@) % ثارت عجاجته واليوم محتجب % % والنقع يؤثر غيما من دياجيها % % 67(@)(@@) % وللأسنة شهب كلما غربت % % في الدار عين تجلت من عواليها % % 68(@)(@@) % وللسيوف بروق كلما لمعت % % تزجي الدماء وريح النصر يزجيها % % 69(@)(@@) % أطلعت وجها تريك الشمس غرته % % تبارك الله ما شمس تساميها % % 70(@)(@@) % من أين للشمس نطق كله حكم % % يفيدها كل حين منك مبديها 
ms74	 % % PageV01P260 71(@)(@@) % لك الجياد إذا تجري سوابقها % % فللرياح جياد ما تجاريها % % 72(@)(@@) % إذا انبرت يوم سبق في أعنتها % % ترى البروق طلاحا لا تباريها % % 73(@)(@@) % من أشهب قد بدا صبحا تراع له % % شهب السماء فإن الصبح يخفيها % % 74(@)(@@) % إلا التي في لجام منه قيدها % % فإنه سامها عزا وتنويها % % 75(@)(@@) % أو اشقر مر عن شقر البروق وقد % % ابقى لها شفقا في الجو تنبيها % % 76(@)(@@) % أو أحمر جمره في الحرب متقد % % يعلوا لها شرر من بأس مذكيها % % 77(@)(@@) % لون العقيق وقد سال العقيق دما % % بعطفه من كماة كر يدميها % % 78(@)(@@) % أو أدهم ملء صدر الليل تنعله % % أهلة فوق وجه الأرض يبديها % % 79(@)(@@) % إن حارت الشهب ليلا في مقلده % % فصبح غرته بالنور يهديها % % 80(@)(@@) % أو اصفر بالعشيات ارتدى مرحا % % وعرفه بتمادي الليل ينبيها % % PageV01P261 81(@)(@@) % مموه بنفار تاه من عجب % % فليس يعدم تنويها ولا تيها % % 82(@)(@@) % ورب نهر حسام رق رائقه % % متى ترده نفوس الكفر يرديها % % 83(@)(@@) % تجري الرؤوس حبابا فوق صفحته % % وما جرى غير أن البأس يجريها % % 84(@)(@@) % وذابل من دم الكفار مشربه % % يجني الفتوح وكف النصر تجنيها % % 85(@)(@@) % وكم هلال لقوس كلما نبضت % % ترى النجوم رجوما في مراميها % % 86(@)(@@) % أئمة الكفر ما يممت ساحتها % % إلا وقد زلزلت قسرا صياصيها % % 87(@)(@@) % يا دولة النصر هل من مبلغ دولا % % مضين أنك تحييها وتنسيها % % 88(@)(@@) % أو مبلغ سالف الأنصار مألكة % % والله بالخلد في الفردوس يجزيها % % 89(@)(@@) % أن الخلافة أعلى الله مظهرها % % أبقت لنا شرفا والله يبقيها % % 90(@)(@@) % يا ابن الذين لهم في كل مكرمة % % مفاخر ولسان الدهر يمليها % % PageV01P262 91(@)(@@) % أنصار خير الورى مختار هجرته % % جيران روضته أكرم بأهليها % % 92(@)(@@) % أسمتهم الملة السمحاء تكرمة % % أنصارها وبهم عزت أواليها % % 93(@)(@@) % ففي حنين وفي بدر وفي أحد % % تلفى مفاخرهم مشهورة فيها % % 94(@)(@@) % ولتسأل السير المرفوع مسندها % % فعن مواقفهم تروى مغازيها % % 95(@)(@@) % مآثر خلد الرحمن أثرتها % % ينصها من كتاب الله قاريها % % 96(@)(@@) % ماذا يجيد بليغ أو ينمقه % % من الكلام ووحي الله تاليها % % 97(@)(@@) % له الجهاد به تسري الرياح إلى % % ممالك الأرض 
ms75	 من شتى أقاصيها % % 98(@)(@@) % تحدى الركاب إلى البيت العتيق به % % فمكة عمرت منه نواديها % % 99(@)(@@) % بشائر تسمع الدنيا وساكنها % % إذا دعا باسمك الأعلى مناديها % % 100(@)(@@) % كفى خلافتك الغراء منقبة % % أن الإله يوالي من يواليها % % PageV01P263 101(@)(@@) % وقد أفاد بنيه الدهر تجربة % % أن السعود تعادي من يعاديها % % 102(@)(@@) % إذا رميت سهام العزم صائبة % % فما رميت بل التوفيق راميها % % 103(@)(@@) % شكرا لمن عظمت منا مواهبه % % وإن تعد فليس العد يحصيها % % 104(@)(@@) % عما قريب ترى الأعياد مقبلة % % من الفتوح ووفد النصر حاديها % % 105(@)(@@) % وتبلغ الغاية القصوى بشائرها % % فقد أظلت بما ترضى مباديها % % 106(@)(@@) % فأهنأ بما شئت من صنع تسر به % % وانو الأماني فالأقدار تدنيها % % 107(@)(@@) % مولاي خذها كما شاءت بلاغتها % % ولو تباع لكان الحسن يشريها % % 108(@)(@@) % أرسلتها حيثما الارواح مرسلة % % نوادرا تنشر البشرى أمانيها % % 109(@)(@@) % جاءت تهنيك عيد الفطر معجبة % % بحسنها ولسان الصدق يطريها % % 110(@)(@@) % البشر في وجهها واليمن في يدها % % والسحر في لفظها والدر في فيها % % PageV01P264 111(@)(@@) % لو رصع البدر منها تاج مفرقة % % لم يرض در الدراري أن تحليها % % 112(@)(@@) % فإن تكن بنت فكري وهو أوحدها % % نعماك في حجرة كانت تربيها % % 113(@)(@@) % في روض جودك قد طوقتني مننا % % طوق الحمام فما سجعي موفيها % % 114(@)(@@) % ولو أعرت لسان الدهر يشكرها % % لكان يقصر عن شكر شوفيها % % 115(@)(@@) % بقيت للدين والدنيا إمام هدى % % مبلغ النفس ما ترجو أمانيها % % 116(@)(@@) % والسعد يجري لغايات تؤملها % % ما دامت الشهب تجري في مجاريها % % PageV01P265 البحر : - 1(@)(@@) % سلام على الدنيا جميعا وما فيها % % غداة نعت شمس الخلافة من فيها % % 2(@)(@@) % نعت ملك الاملاك والكامل الذي % % يكف عوادي الحادثات ويكفيها % % 3(@)(@@) % عميد بني الأنصار غير مدافع % % ومحيي معاليها ومولى مواليها % % 4(@)(@@) % وبدر دياجيها وشمس نهارها % % وبشر محياها ونور مجاليها % % 5(@)(@@) % خفا الكوكب الوقاد قد كان نوره % % يجلي من الدهم الخطوب دياجيها % % 6(@)(@@) % هوى القمر الوضاح من أفق العلا % % فأظلم جو النيرات بساريها وقد كسفت شمس الهداية بعدما أبان سبيل الحق للخلق هاديها هو الجبل الراسي تصدع بعدما أقرت به شم الجبال رواسيها % % 7 
ms76	(@)(@@) % يعز على دين الهدى أن شمسه % % يطول بأطباق التراب تواريها % % 8(@)(@@) % يعز على زهر النجوم متى سرت % % ولا تلمح الهدي الذي كان يهديها % % 9(@)(@@) % لأندلس ثكل عليه مردد % % له لبست سود المسوح نواحيها % % 10(@)(@@) % ثلاثين حولا بعد خمس تعودت % % يدافع عنها كل خطب ويحميها أبكيه للرايات يخفق بندها وفي مرقب النصر المؤزر يعليها % % PageV01P266 11(@)(@@) % أبكيه للخيل المغيرة بالضحى % % وقد أبعد الفتح المبين مراميها % % 12(@)(@@) % أبكيه للخيل المغيرة بالضحى % % وقد أبعد الفتح المبين مراميها % % 13(@)(@@) % ويبكيه معمور البسيطة كلها % % وما ضم من داني البلاد وقاصيها % % 14(@)(@@) % وتبكيه سحب أخجلتها بنانه % % وترسل دمع الغيث حزنا مآقيها % % 15(@)(@@) % وتبكيبه حتى الشهب في أفق العلا % % وتلبس جلباب الظلام جواريها % % 16(@)(@@) % عزاء أمين المسلمين فإنها % % مقادير رب الخلق في الخلق يجريها % % 17(@)(@@) % هو الموت ورد للخليقة كلها % % أواخرها تقفو سبيل أواليها % % 18(@)(@@) % وما بيننا حي وما بين آدم % % ألا هكذا سوى البرية باريه % % 19(@)(@@) % وفي موت خير الخلق أكبر أسوة % % تصبر أحرار النفوس وتسليها % % 20(@)(@@) % أمولاي لو كان الفداء مسوغا % % فديناك بالدنيا جميعا وما فيها % % PageV01P267 21(@)(@@) % أمولاي كم من نعمة لك عندنا % % إذا نحن رمنا حصرها ليس نحصيها أمولاي خلفت العبيد إلى الأسى يناجيك من فرط الشجون مناجيها % % 22(@)(@@) % وقد مات منا الصبر إلا صبابة % % بذكرك في جنح الدجنة نحييها % % 23(@)(@@) % أمولاي يا مولاي هل أنت سامعي % % أبثك ما يشجي القلوب ويدميها % % 24(@)(@@) % تحفيت بي حتى نضوت شبيبتي % % عزيزا وجيها حيثما رمت توجيها % % 25(@)(@@) % وقد كان ظني أن تكون جنازتي % % يشيعها منك الرضا ويواريها % % 26(@)(@@) % وقد عشت حتى ذقت فقدك قلما % % تبلغ نفس ما تريد أمانيها % % 27(@)(@@) % ولولا أبو الحجاج نجلك لم يكن % % لدين الهدى كرات بحر يزجيها % % 28(@)(@@) % ولكنه والله يجمل صبره % % مناقبك الغر الكرام سيحييها % % 29(@)(@@) % فخلفتنا منه لأكرم كافل % % يحمل أعباء الخلافة كافيها % % 30(@)(@@) % سريرته الرحمى وسيرته الرضا % % وأخلاقه الغر الكريمة تدريها % % PageV01P268 31(@)(@@) % وسيلتك العظمى وظلك فوقنا % % وعمدتنا والله في العز يبقيها % % 32(@)(@@) % فما كنت إلا الشمس قد غربت لنا % % وأنوارها بدر 
ms77	 التمام يجليها % % 33(@)(@@) % وما أنت إلا المسك إن تخف ذاته % % ينم بها العرف الذكي فيفشيها % % 34(@)(@@) % الا قدس الرحمن نفسا كريمة % % بكل عزيز في الوجود نفديها % % 35(@)(@@) % وبشرى لنا أن السعادة نزلها % % وأن رضا الله الكريم يرضيها % % 36(@)(@@) % وحاشا وكلا أن تضيع وسائل % % سيذخرها الرب الكريم وينشيها % % 37(@)(@@) % فكم من جهاد قد رفعت بنوده % % وقد أثمرت فيها المعالي عواليها % % 38(@)(@@) % كسرت تماثيل الصليب وأخرست % % نواقيس كانت بالضلال تناغيها % % 39(@)(@@) % وكم من منار قد أعدت أذانه % % وأعلن فيه دعوة الحق داعيها % % 40(@)(@@) % وكم من رياض للكتائب قد غدت % % تضيق بمستن الجياد نواحيها % % PageV01P269 41(@)(@@) % وملتف زرع بالاسنة مزهر % % ولكن به المران تحلو مجانيها % % 42(@)(@@) % إذا ظمئت منها الذوابل في الوغى % % جداول أنهار السيوف ترويها % % 43(@)(@@) % غراس زكي للجهاد غرسته % % فصرت إلى دار السعادة تجنيها % % 44(@)(@@) % ولم لم يكن إلا سنين قطعتها % % رهين شكاة لا تزال تعانيها % % 45(@)(@@) % صبرت لها صبر الكرام وإنما % % ذخرت أجورا فضل ربك جازيها % % 46(@)(@@) % أمالك في الأنصار خير وسيلة % % وقد كنت بالنصر العزيز تحييها % % 47(@)(@@) % وحسبك بالمختار أكرم شافع % % وسنته والله لا زلت تحييها % % 48(@)(@@) % على علم الدنيا وفخر ملوكها % % تحية رب لا يزال يواريها % % 49(@)(@@) % سأبكيه ما دام الحمام مطوقا % % وما سجعت تبكي الهديل قماريها % % 50(@)(@@) % وأهديه من طيب السلام معطرا % % كما فتقت أيدي التجار غواليها % % PageV01P270 51(@)(@@) % وأسبل رب العرش سحب كرامة % % تسح على ذاك الضريح غواديها % % 52(@)(@@) % ونسأل فتحا للخليفة يوسف % % يملكه اقصى البلاد ومن فيها % % PageV01P271 البحر : - 1(@)(@@) % يهني زمانك أعياد مجددة % % من الفتوح مع الأيام تغشاه % % 2(@)(@@) % غضبت للدين والدنيا بحقهما % % يا حبذا غضب في الله أرضاه % % 3(@)(@@) % فوقت للغرب سهما راشه قدر % % وسدد الله للأعداء مرماه % % 4(@)(@@) % سهم أصاب وراميه بذي سلم لقد رمى الغرض الأقصى فأصماه % . . . % 5(@)(@@) % من كان بندك يا مولاي يقدمه % % فليس يخلفه فتح ترجاه % % 6(@)(@@) % من كان جندك جند الله ينصره % % أناله الله ما يرجو وسناه % % 7(@)(@@) % ملكته غربه خلدت من ملك للغرب والشرق منه ما تمناه % . . . % 8(@)(@@) % وسام اعداءك 
ms78	 الاشقين ما كسبوا % % ومن تردى رداء الغدر ارداه % % 9(@)(@@) % قل للذين رمدت جهلا بصيرته % % فلم تر الشمس شمس الهدي عيناه % % 10(@)(@@) % غطى الهوى عقله حتى إذا ظهرت % % له المراشد أعشاه واعماه % % PageV01P272 11(@)(@@) % هل عنده وذنوب العذر توبقه % % أن الذي قد كساه العز أعراه % % 12(@)(@@) % لو كان يشكر ما أوليت من نعم % % ما زلت ملجأه الأحمى ومنجاه % % 13(@)(@@) % سل السعود وخل البيض مغمدة % % فالسيف مهما مضى فالسعد أقصاه % % 14(@)(@@) % واشرع من البرق نصلا راع مصلته % % وارفع من الصبح بندا راق مجلاه % % 15(@)(@@) % فالعدوتان وما قد ضم ملكهما % % أنصار ملكك صان الله علياه % % 16(@)(@@) % لا أوحش الله قطرا أنت مالكه % % وآنس الله بالألطاف مغناه % % 17(@)(@@) % لا أظلم الله أفقا أنت نيره % % لا أهمل الله سرحا أنت ترعاه % % 18(@)(@@) % واهنأ بشهر صيام جاء زائره % % مستنزلا من إله العشر رحماه % % 19(@)(@@) % أهل بالسعد فانهلت به منن % % وأوسع الصنع إجمالا ووفاه % % 20(@)(@@) % أما ترى بركات الأرض شاملة % % وأنعم الله قد عمت براياه % % PageV01P273 21(@)(@@) % وعادك العيد تستحلي موارده % % ويجزل الأجر والرحمى مصلاه % % 22(@)(@@) % جهزت جيش دعاء فيه ترفعه % % لذي المعارج والإخلاص رقاه % % 23(@)(@@) % افضت فيه من النعماء اجزلها % % وأشرف البر بالإحسان زكاه % % 24(@)(@@) % واليت للخلق ما أوليت من نعم % % وإلى لك الله ما أولى ووالاه وأول هذه القصيدة هذي العوالم لفظ أنت معناه كل يقول إذا استنطقته الله % % 25(@)(@@) % بحر الوجود وفلك الكون جارية % % وباسمك الله مجراه ومرساه % % 26(@)(@@) % من نور وجهك ضاء الكون أجمعه % % حتى تشيد بالأفلاك مبناه % % 27(@)(@@) % عرش وفرش وأملاك مسخرة % % وكلها ساجد لله مولاه % % 28(@)(@@) % سبحان من أوجد الأشياء من عدم % % وأوسع الكون قبل الكون نعماه % % 29(@)(@@) % من ينسب النور للأفلاك قلت له % % من أين أطلعت الأنوار لولاه % % 30(@)(@@) % مولاي مولاي بحر الجود أغرقني % % والخلق أجمع في ذا البحر قد تاهوا % % PageV01P274 31(@)(@@) % فالفلك تجري كما الأفلاك جارية % % بحر السماء وبحر الأرض اشباه % % 32(@)(@@) % وكلهم نعم للخلق شاملة % % تبارك الله لا تحصى عطاياه % % 33(@)(@@) % يا فاتق الرتق من هذا الوجود كما % % في سابق 
ms79	 العلم قد خطت قضاياه % % 34(@)(@@) % كن لي كما كنت لي إذ كنت لا عمل % % ارجو ولا ذنب قد اذنبت أخشاه % % 35(@)(@@) % وأنت في حضرات القدس تنقلني % % حتى استقر بهذا الكون مثواه % % 36(@)(@@) % ما أقبح العبد أن ينسى وتذكره % % وأنت باللطف والإحسان ترعاه % % 37(@)(@@) % غفرانك الله من جهل بليت به % % فمن أفاد وجودي كيف أنساه % % 38(@)(@@) % مني علي حجاب لست أرفعه % % إلا بتوفيق هدي منك ترضاه % % 39(@)(@@) % فعد علي بما عودت من كرم % % فأنت أكرم من أملت رحماه % % 40(@)(@@) % ثم الصلاة صلاة الله دائمة % % على الذي باسمه في الذكر سماه % % PageV01P275 41(@)(@@) % المجتبي وزناد النور بما قدحت % % ولا ذكا من نسيم الروض مسراه % % 42(@)(@@) % والمصطفى وكمام الكون ما فتقت % % عن زهر زهر يروق العين مرآه % % 43(@)(@@) % ولا تفجر نهر للنهار علي % % در الدراري فغطاه وأخفاه % % 44(@)(@@) % يا فاتح الرسل أو يا ختمها شرفا % % والله قدس في الحالين معناه % % 45(@)(@@) % لم أدخر غير حب فيك أرفعه % % وسيلة لكريم يوم ألقاه % % 46(@)(@@) % صلى عليك إله أنت صفوته % % ما طيبت بلذيذ الذكر أفواه % % 47(@)(@@) % وعم بالروح والريحان صحبته % % وجادهم من نمير العفو أصفاه % % 48(@)(@@) % وخص أنصاره الأعلين صفوته % % وأسكنوا من جوار الله أعلاه % % 49(@)(@@) % أنصار ملته أعلام بيعته % % مناقب شرفت أثنى بها الله % % 50(@)(@@) % وأيد الله من أحيا جهادهم % % وواصل الفخر اخراه وأولاه % % PageV01P276 51(@)(@@) % المنتقى من صميم الفخر جوهره % % ما بين نصر وأنصار تهاداه % % 52(@)(@@) % العلم والحلم والإفضال شيمته % % والبأس والجود بعض من سجاياه % % PageV01P277 البحر : - 1(@)(@@) % ما ترى في الرياض اشباهي % % يسحر العقل حسني الزاهي % % 2(@)(@@) % زان روضي أميره سعد % % وهو نجل الغني بالله % % 3(@)(@@) % دام منه بمرتقى عز % % آمر بالسعود أو ناهي % % PageV01P278 البحر : - 1(@)(@@) % للغني بالله قصر % % للتهاني يصطفيه % % 2(@)(@@) % فيه محراب صلاة % % يقف الإبريق فيه تاليا سورة حسن والمعالي تقتفيه % % PageV01P279 البحر : - 1(@)(@@) % أتعطش أولادي وأنت غمامة % % تعم جميع الخلق بالنفع والسقيا % % 2(@)(@@) % وتظلم أوقاتي ووجهك نير % % تفيض به الأنوار للدين والدنيا % % 3(@)(@@) % وجدك قد سماك ربك باسمه % % وأورثك الرحمن رتبته العليا % % 4(@)(@@) % وقد 
ms80	 كان أعطاني الذي أنا سائل % % وسوغني من غير شرط ولا ثنيا % % 5(@)(@@) % وشعري في غر المصانع خالد % % يحييه عني في الممات وفي المحيا % % 6(@)(@@) % وما زلت أهدي المدح مسكا مفتقا % % فتحمله الأرواح عاطرة الريا % % 7(@)(@@) % وقد أكثر العبد التشكي وإنه % % وحقك يا فخر الملوك قد استحيا % % 8(@)(@@) % وما الجود إلا ميت غير أنه % % إذا نفحت يمناك في روحه يحيا % % 9(@)(@@) % فمن شاء أن يدعو لدين محمد % % فيدعو لمولانا الخليفة بالبقيا % % PageV01P280 البحر : - 1(@)(@@) % كتبت ودمعي بلل الركب قطرة % % وأجرى به بين الخيام السواقيا % % 2(@)(@@) % حنينا لمولى أتلف المال جوده % % ولكنه قد خلد الفخر باقيا % % 3(@)(@@) % وما عشت بعد البين إلا لأنني % % أرجي بفضل الله منه التلاقيا % % PageV01P281 البحر : - 1(@)(@@) % يكلفني مولاي رجع جوابه % % وما لتعاطي المعجزات وماليا % % 2(@)(@@) % أجيبك للفضل الذي أنت أهله % % وأكتب مما قد أفدت الأماليا % % 3(@)(@@) % فأنت الذي طوقتني كل منة % % وأحسبت آمالي وأكسبت ماليا % % 4(@)(@@) % وأنت الذي أعدى الزمان كماله % % وصيرت أحرار الزمان مواليا % % 5(@)(@@) % فلا زلت للفعل الجميل مواصلا % % ولا زلت للشكر الجزيل مواليا % % PageV01P282 البحر : - 1(@)(@@) % معاذ الهوى أن أصحب القلب ساليا % % وأن يشغل اللوام بالعذل باليا % % 2(@)(@@) % دعاني أعط الحب فضل مقادتي % % ويقضي علي الوجد ما كان قاضيا % % 3(@)(@@) % ودون الذي رام العواذل صبوة % % رمت بي في شعب الغرام المراميا % % 4(@)(@@) % وقلب إذا ما البرق أومض موهنا % % قدحت به زندا من الشوق واريا % % 5(@)(@@) % خليلي إني يوم طارقة النوى % % شقيت بمن لو شاء أنعم باليا % % 6(@)(@@) % وبالخيف يوم النفر يا أم مالك % % تخلفت قلبي في حبالك عانيا % % 7(@)(@@) % وذي أشر عذب الثنايا مخصر % % يسقي به ماء النعيم الاقاحيا % % 8(@)(@@) % أحوم عليه ما دجا الليل ساهرا % % وأصبح دون الورد ظمآن صاديا % % 9(@)(@@) % يضيء ظلام الليل ما بين أضلعي % % إذا البارق النجدي وهنا بداليا % % 10(@)(@@) % أجيرتنا بالرمل والرمل منزل % % مضى العيش فيه بالشبيبة حاليا % % PageV01P283 11(@)(@@) % ولم ار ربعا منه أقضى لبانة % % وأشجى حمامات وأحلى مجانيا % % 12(@)(@@) % سقت طلة الغر الغوادي ونظمت % % من القطر في جيد الغصون لآليا % % 13 