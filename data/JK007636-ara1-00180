ms161	 يتفجر % % 43(@)(@@) % نبي له مجد قديم وسؤدد % % صميم وأخبار تجل وتخبر % % 44(@)(@@) % تحزم جبريل لخدمة وحيه % % وأقبل عيسى بالبشارة يجهر % % 45(@)(@@) % فمن ذا يضاهيه وجبريل خادم % لمقدمه العالي وعيسى مبشر % % 46(@)(@@) % تهاوي لمأتاه النجوم كأنها % % تشافه بالخد الثري وتعفر % % 47(@)(@@) % و ينضب طام من بحيرة ساوة % % ولم لا وقد فاضت بكفيه أبحر % % 48(@)(@@) % نبي له الحوضان هذا أصابع % تفيض وهذا في القيامة كوثر % % 49(@)(@@) % و عن جاهه الناران هذي بفارس % % تبوخ وهذي في غد حين نحشر % % 50(@)(@@) % اذا ما تشفعنا به كف غيظها % % وقالت عبارات الصراط لنا اعبروا % % PageV01P769 51(@)(@@) % تنقل نورا بين أصلاب سادة % % فلله منه في سما الفضل نير % % 52(@)(@@) % به أيد الطهر الخليلي فانتحت % % يداه على الأصنام تغزو وتكسر % % 53(@)(@@) % و من أجله جيء الذبيحان بالفدى % % وصين دم بين الدماء مطهر % % 54(@)(@@) % وردت جيوش الفيل عن دار قومه % % فلله نصل قبل ما سل ينصر % % 55(@)(@@) % و لما أراد الله إظهار دينه % % بدا قمرا والشرك كالليل يكفر % % 56(@)(@@) % فجلى الدجى واستوثق الدين واضحا % وقام بنصر الله داع مظفر % % 57(@)(@@) % بخوف السطا بالرعب ينصر والظبا % % وداني الحيافي اليسر والعسر يهمر % % 58(@)(@@) % عزائم من لا يختشي يوم غزوه % % ردى وعطا من ليس للفقر يحذر % % 59(@)(@@) % علا عن محاكاة الغمام لفضله % % وكيف يحاكيه الخديم المسخر % % 60(@)(@@) % يظلله وقت المسير وتارة % % يشير اليه بالبنان فيمطر % % PageV01P770 61(@)(@@) % ألم تر أن القطر في الغيم فارس % اذا برزت آلاؤه يتقطر % % 62(@)(@@) % هو البحر فياض الموارد للورى % % ولكنه العذب الذي لا يكدر % % 63(@)(@@) % فمن لي بلفظ جوهري قصائد % % تنظم حتى يمدح البحر جوهر % % 64(@)(@@) % و هيهات أن تحصى بتقدير مادح % مناقب في الذكر الحكيم تقرر % % 65(@)(@@) % اذا شعراء الذكر قامت بمدحه % % فما قدر ماتنشي الأنام وتشعر % % 66(@)(@@) % نبي زكا أصلا وفرعا واقبلت % % اليه أصول في الثرى تتجرر % % 67(@)(@@) % و خاطبه وحش المهامة آنسا % اليه وما عن ذلك الحسن منفر % % 68(@)(@@) % له راحة فيها على البأس والندى % % دلائل حتى في الجماد تؤثر % % 69(@)(@@) % فبينا العصا فيها وريق قضيبها 
ms162	 % % اذا هو مشحوذ الغرارين أبتر % % 70(@)(@@) % كذا فليكن في شكرها وصفاتها % % يد بين أوصاف النبيين تشكر % % PageV01P771 71(@)(@@) % سخت ومحت شكوى قتادة فاغتدت % % بها العين تجري إذ بها العين تجبر % % 72(@)(@@) % لعمري لقد سارت صفات محمد % كذاك النجوم الزاهرات تسير % % 73(@)(@@) % أرى معجز الرسل انطوى بانطوائهم % % ومعجزه حتى القيامة ينشر % % 74(@)(@@) % كبير فخار الذكر في الخلق كلما % % تلا قارئ أو قيل الله أكبر % % 75(@)(@@) % هو المرتفي السبع الطباق إلى مدى % لجبريل عنه موقف متأخر % % 76(@)(@@) % هو الثابت العليا على كل مرسل % % بحيث له في حضرة القدس محضر % % 77(@)(@@) % هو المصطفى والمقتفى لا مناره % % يحط ولا أنواره تتكور % % 78(@)(@@) % إليك رسول الله مدت مطالبي % % على أنها أضحت على الغور تقصر % % 79(@)(@@) % خلقت شفيعا للانام مشفعا % فرجواك في الدارين أجدى وأجدر % % 80(@)(@@) % ولي حالتا دنيا وأخرى أراهما % % يمران بي في عيشة تتمرر % % PageV01P772 81(@)(@@) % حياة ولكن بين ذل وغربة % فلا العز يستجلي ولا البين يفتر % % 82(@)(@@) % و عزم إلى الأخرى يهم نهوضه % % ولكنه بالذنب كالظهر موقر % % 83(@)(@@) % تصبرت في هذا وذاك كأنني % % من العجز والبوسى قتيل مصبر % % 84(@)(@@) % و ها أنا ذا أبلغت عذري قاصدا % وأيقنت أن النجح لا يتعذر % % 85(@)(@@) % عليك صلاة الله في كل منزل % % تعبر عن سر الجنان وتعبر % % 86(@)(@@) % و آلك والصحب الذين عليهم % تحل حبا مدح ويعقد خنصر % % 87(@)(@@) % بجاهك عند الله أقبلت لائذا % فكثرت حاجاتي وجاهك أكثر % % 88(@)(@@) % و نظمت شعري فيك تزهى قصيدة % على كل ذي بيت من الشعر يعمر % % 89(@)(@@) % معظمة المعنى يكرر لفظها % % فيحلو نباتي الكلام المكرر % % 90(@)(@@) % دنت من صفات الفضل منك وانها % % لتفضل ما قالته طي وبحتر % % PageV01P773 91(@)(@@) % و ما ضرها اذ كان نشر نسيمها % % رخآء اذا ما لم يكن فيه صرصر % % PageV01P774 البحر : - 1(@)(@@) % يوم صحو فاجعله لي يوم سكر % % وأدر لي كأسي رضاب وخمر % % 2(@)(@@) % واسقني في منازل مثل خلقي % % بيدي هاجر يغني بشعري % % 3(@)(@@) % حبذا روضة وظل ونهر % كعذار على لمى فوق ثغر % % 4(@)(@@) % ومليح يقول حسن حلاه % إعملوا ما أردتم 
ms163	 أهل بدر % % 5(@)(@@) % جفن عينيه فاتر مستحي % انما خده المشعشع جمري % % 6(@)(@@) % و غرامي العذري ذنب لديه % % وعجيب يكون ذنبي عذري % % 7(@)(@@) % هاتها في يديه عذراء تجلى % % لنداماي في قلائد در % 8(@)(@@) % ليت شعري وللسرور انتهاز % أي شيء يعوقنا ليت شعري % % 9(@)(@@) % زمن الأنس قائم بالتهاني % % ونوال الملك المؤيد يسري % % 10(@)(@@) % ملك باهر المكارم يروي % % وجه لقياه عن عطاء وبشر % % PageV01P775 11(@)(@@) % زرت أبوابه فقرب شخصي % % ومحا عسرتي ونوه ذكري % % 12(@)(@@) % و نحا لي من المكارم نحوا % صانني عن لقاء زيد وعمرو % % 13(@)(@@) % و تفننت في مفاوضة الش % % كر إلى أن أعيي التطول شكري % % 14(@)(@@) % أريحي من الملوك أريب % فائض البحر ذو عجائب كثر % % 15(@)(@@) % رب خلق أرق من أدمع الخن % % سا وقلب يوم الوغى مثل صخر % % 16(@)(@@) % يقسم الدهر من سطاه بليل % % ومن المنظر البهي بفجر % % 17(@)(@@) % كل أيامنا مواسم فضل % في ذرى بابه وأعياد فطر % % 18(@)(@@) % فإذا لاح وجهه في ذوي القص % % د بعيد فاضت يداه بعشر % % 19(@)(@@) % لذ بيمناه في الحوائج تظفر % % بيسار يمحى به كل عسر % % 20(@)(@@) % سمه في الضمير إن ذقت فقرا % وعلي الضمان أنك تثري % % PageV01P776 21(@)(@@) % و القه للعلوم أو للعطايا % % تلق ملكا يقري الضيوف ويقري % % 22(@)(@@) % طوت العسر ثم فاضت لهاه % فنعمنا بذات طي ونشر % % 23(@)(@@) % يا مليك النوال والعلم لازل % % ت سري الثناء في كل قطر % % 24(@)(@@) % حملتك العلى شؤونا فألفت % % آل أيوب دائما آل صبر % % PageV01P777 البحر : - 1(@)(@@) % يا شاهر اللحظ حبي فيك مشهور % % وكاسر الطرف قلبي منك مكسور % % 2(@)(@@) % أمرت لحظك أن يسطو على كبدي % % يا صدق من قال ان السيف مأمور % % 3(@)(@@) % وجاوب الدمع ثغرا منك متسقا % فبيننا الدر منظوم ومنثور % % 4(@)(@@) % لا تجعل اسمي للعذال منتصبا % فما لتعريف وجدي فيك تنكير % % 5(@)(@@) % ولا توال أذى قلبي لتهدمه % % فانه منزل بالود معمور % % 6(@)(@@) % هل عند منظرك الشفاف جوهرة % % اني اليه فقير اللحظ مضرور % % 7(@)(@@) % أو عند مبسمك الغرار بارقة % اني بموعد صبري فيه مغرور % % 8(@)(@@) % أقسمت بالعارض المسكي ان به % % للمقسمين 
ms164	 كتاب الحسن مسطور % % 9(@)(@@) % وبالدموع التي تهمي الجفون بها % % فإ نها البحر في أحشائي مسجور % % 10(@)(@@) % لقد ثنى من يدي صبري عزائمه % % قلب بطرفك أمسى وهو مسحور % % PageV01P778 11(@)(@@) % وقد تغير عهد الحال من جسدي % % ومالحال عهودي فيك تغيير % % 12(@)(@@) % حبي ومدح ابن شاه شاه من قدم % % كلاهما في حديث الدهر مأثور % % 13(@)(@@) % أنشا المؤيد ألفاظي وأنشرها % % فحبذا منشأ منها ومنشور % % 14(@)(@@) % ملك اذا شمت برقا من أسرته % % علمت أن مراد القصد ممطور % % 15(@)(@@) % مكمل الذات زاكي الأصل طاهره % % فعنده الفضل مسموع ومنظور % % 16(@)(@@) % أقام للملك أراء معظمة % % لشهبها في بروج اليمن تسيير % % 17(@)(@@) % وقام عنه لسان الجود ينشدنا % % زوروا فما الظن فيه كالورى زور % % 18(@)(@@) % هذا الذي للثنا من نحو دولته % % وللجوائز مرفوع ومجرور % % 19(@)(@@) % وللعلوم تصانيف بدت فغدت % % نعم السوار على الاسلام والسور % % 20(@)(@@) % في كفه حمر أقلام وبيض ظبا % % كأنها لبرود المدح تشهير % % PageV01P779 21(@)(@@) % قد أثرت ما يسر الدين أحرفها % % وللحروف كما قد قيل تأثير % % 22(@)(@@) % لله من قلم صان الحمى وله % % مال على صفحات الحمد منثور % % 23(@)(@@) % وصارم في ظلام النقع تحسبه % % برقا يشق به في الأفق ديجور % % 24(@)(@@) % تفدي البرية ان قلوا وان كثروا % % أبا الفداء فثم الفضل والخير % % 25(@)(@@) % مدت إلى مجده الامداح واقتصرت % % فاعجب لممدود شيء وهو مقصور % % 26(@)(@@) % وسرها من أب وابن قد اجتمعا % % مؤيد يتلقاها ومنصور % % 27(@)(@@) % يا مالكا أشرقت أيامه وزهت % % رياضها فتجلى النور والنور % % 28(@)(@@) % هنئت عيدا له منك اعتياد هنا % % فالصبح مبتهج والليل مسرور % % 29(@)(@@) % فطرت فيه الورى واللفظ متفق % % للوفد فطر وللحساد تفطير % % 30(@)(@@) % كأن شكل هلال العيد في يده % % قوس على مهج الأضداد موتور % % PageV01P780 31(@)(@@) % أو مخلب مده نسر السماء لهم % % فكل طائر قلب منه مذعور % % 32(@)(@@) % أو منجل بحصاد القوم منعطف % % أو خنجر مرهف النصلين مطرور % % 33(@)(@@) % أو نعل تبرأجادت في هديته % % إلى جواد ابن أيوب المقادير % % 34(@)(@@) % أوراكع الظهرشكرا في الظلام على % % من فضله في السما والأرض مشكور % % 35(@)(@@) % أو حاجب أشمط ينبي بأن له 
ms165	 % % عمرا له في ظلال الملك تعمير % % 36(@)(@@) % أو زورق جاء فيه العيد منحدرا % حيث الدجى كعباب البحر مسجور % % 37(@)(@@) % أولا فقل شفة للكأس مائلة % % تذكر العيش إن العيش مذكور % % 38(@)(@@) % أولا فنصف سوار قام يطرحه % % كف الدجى حين عمته التباشير % % 39(@)(@@) % أولا فقطعة قيد فك عن بشر % % أخنى الصيام عليه فهو مأسور % % 40(@)(@@) % أولا فمن رمضان النون قد سقطت % % لما مضى وهو من شوال محصور % % PageV01P781 41(@)(@@) % فانعم به وبأمداح مشعشعة % % مديرها في صباح الفطر مبرور % % 42(@)(@@) % نفاحة المسك من مسود أحرفها % % ما كان يبلغها في مصر كافور % % 43(@)(@@) % قالت وما كذبت رؤيا محاسنها % % قبول غيري على الأملاك محظور % % 44(@)(@@) % بعض الورى شاعر فاسمع مدائحه % % وبعضهم مثلما قد قيل شعرور % % PageV01P782 البحر : - 1(@)(@@) % هن الوجوه الناضره % % عيني اليها ناظره % % 2(@)(@@) % آها لها عينا على % % تلك الأزاهر ماطره % % 3(@)(@@) % رقب الوشاة جفونها % % فاذا هم بالساهره % % 4(@)(@@) % من لي بغزلان على % % سفح المخصب نافره % % 5(@)(@@) % ومعاطف مثل الغصو % % ن سبت حشاي الطائره % % 6(@)(@@) % ياصاح علل مهجتي % % بسنا الكؤوس الدائره % % 7(@)(@@) % واحرق بلمع شعاعها % % هذي الليالي الكافره % % 8(@)(@@) % وانظر لساعات النها % % ر بجنح ليل سائره % % 9(@)(@@) % من كف مهضوم الحشا % % مثل المهاة الحادره % % 10(@)(@@) % رامي النواظر والقلو % % ب بهاجر وبهاجره % % PageV01P783 11(@)(@@) % ذي مقلة تلقى الضرا % % غم بالجفون الكاسره % % 12(@)(@@) % تردي وأنت تحبها % % وكذا تكون الساحره % % 13(@)(@@) % أحيت وأردت بالفتو % % ر وباللحاظ الشاطره % % 14(@)(@@) % كيد المؤيد باليرا % % ع وبالسيوف الباتره % % 15(@)(@@) % ذات الحروف مجيرة % % وظبا الأسنة جائره % % 16(@)(@@) % أكرم بصنع يد لها % % هذي الايادي الفاخره % % 17(@)(@@) % محمرة الآفاق في % % يوم الندى والنائره % % 18(@)(@@) % فشعاع تبر صاعد % % ودماء قوم مائره % % 19(@)(@@) % و تبسم مع ذا وذا % % يزع الخطوب الكاشره % % 20(@)(@@) % و تفنن في العلم يق % % دح بين ذاك خواطره % % PageV01P784 21(@)(@@) % لا يهمل الدنيا ولا % % ينسى حقوق الآخره % % 22(@)(@@) % عن كفه أو صدره % % تروي البحار الزاخره % % 23(@)(@@) % ياأيها الملك الذي % % رد الحقائب شاكره % % 24(@)(@@) % و سما بهمته على % % غرر النجوم الزاهره % % 25(@)(@@) % حتى انتقى من زهرها % % هذي الخلال 
ms166	 الباهره % % 26(@)(@@) % سقيا لدهرك إنه % % دهر الأيادي الوافره % % 27(@)(@@) % مترادف لذوي الرجا % % بهباته المتواتره % % 28(@)(@@) % لولاك ماأمست قري % % حتي الكليلة شاعره % % 29(@)(@@) % أنت الذي روت غما % % ئمه رباي العاطره % % 30(@)(@@) % و أبحتني بحر الندى % % حتى نظمت جواهره % % PageV01P785 31(@)(@@) % لاغرو إن سليت عن % % بلدي حشاي الذاكره % % 32(@)(@@) % فلقد وجدت ديار مل % % كك بالسعادة عامره % % 33(@)(@@) % قهرت حماة لي العدى % % فحماة عندي القاهره % % PageV01P786 البحر : - 1(@)(@@) % مبلبل الأصداغ والطره % % ومرسل اللحظ على فتره % % 2(@)(@@) % أرخى على أعطافه شعرة % % قد جذبتني فيه للحسرة % % 3(@)(@@) % فاعجب لمن جار عليه الضنى % % حتى غدا تجذبه شعره % % 4(@)(@@) % واحربا من رشإ خاذل % مالي على عشقته نصره % % 5(@)(@@) % مهفهف تعرف من جفنه % % علامة التأنيث بالكسرة % % 6(@)(@@) % ذو طاعة تعلو على المشتري % % وغرة تزهو على الزهرة % % 7(@)(@@) % ومقلة دعجاء ضاقت فما % % تشبع من يقنع بالنظره % % 8(@)(@@) % عشقته حلوا على مثله % % يطاع في الغي أبو مره % % 9(@)(@@) % لولا دجى طرته لم أبت % % سهران لا أجر ولا أجره % % 10(@)(@@) % يبدو كتاب الحسن في وجهه % % فاقرأ العشق من الطره % % PageV01P787 11(@)(@@) % ياابن أمير الحرب يوم الوغى % % كم لك في العشاق من إمره % % 12(@)(@@) % اليك يشكو المرء أشجانه % % ولابن شاد يشتكي دهره % % 13(@)(@@) % الملك العالم والضيغم ال % % باسل والمفرد والندره % % 14(@)(@@) % رب العطايا عن غنى قاصر % والحلم كل الحلم عن قدره % % 15(@)(@@) % سبحان من صوره خالصا % ما شيب من أخلاقه ذره % % 16(@)(@@) % من آل مروان ويمناه في % % حب العطايا من بني عذره % % 17(@)(@@) % لو لم تكن يمناه غيثا لما % % أضحت ربى الطرس بها نضره % % 18(@)(@@) % حروفها تعطف يسر الفتى % % فهي حروف العطف لليسرة % % 19(@)(@@) % وسيفها ممتزج بالدما % % مزج بياض الخد بالحمره % % 20(@)(@@) % إذا مضى في الدرع إفرنده % % عجبت للمريخ في النثره % % PageV01P788 21(@)(@@) % أكرم باسماعيل من شائد % % أركان بيت الملك عن خبره % % 22(@)(@@) % ذي السلم لا تعبأ له ديمة % والحرب لا يصلى له جمره % % 23(@)(@@) % معطي جواد الخيل للمعتفي % % وخلفه الصرة كالمهرة % % 24(@)(@@) % دع حاتما يفخر في قومه % % بنحره البكرة لا البدره % % 25(@)(@@) % ليسوا سواء المجد 
ms167	 إلا اذا % % تساوت الخزفة والدره % % 26(@)(@@) % هو الذي يروي حديث الثنا % % عن شخصه الباهر عن قره % % 27(@)(@@) % للخلق والخلق على وجهه % % نوران ردا ناظر الامره % % 28(@)(@@) % ان كان النورين فضلا فكم % % جهز من جيش ذوي العسره % % 29(@)(@@) % يا ملكا يلقى المنى والعدى % % بضعف ما ترضى وما تكره % % 30(@)(@@) % و قرتني عن أهل ودي فلا % % والله مالي فيهم فكره % % PageV01P789 31(@)(@@) % إلى أياديك انتهى مطلبي % % فيا لها فيحآء مخضره % % 32(@)(@@) % كذا مدي الأيام في نعمة % باسمة الإخوان مفتره % % 33(@)(@@) % في كل وجه قد تيممته % % سعادة واضحة الغره % % PageV01P790 البحر : - 1(@)(@@) % صيرت نومي مثل عطفك نافرا % % وتركت عزمي مثل جفنك فاترا % % 2(@)(@@) % وسكنت قلبا طار فيك مسرة % أرأيت وكرا قط أصبح طائرا % % 3(@)(@@) % يا مخربا ربع السلو جعلتني % % أدعى بأنساب الصبابة عامرا % % 4(@)(@@) % ويطيع قلبي حكم لحظك في الهوى % % ياللكليم غدا يطيع الساحرا % % 5(@)(@@) % رفقا بقلب في الصبابة والأسى % % صيرته مثلا فأصبح سائرا % % 6(@)(@@) % ومسهد يشكو القتار دموعه % % مما سلكن على هواك محاجرا % % 7(@)(@@) % ما بال مقلتك الضعيفة لم تزل % % وسنا وطرفي ليس يبرح ساهرا % % 8(@)(@@) % خلقت بلا شك لأخلاق الأسى % % ويد المؤيد للنوال بلا مرا % % 9(@)(@@) % من مبلغ الملك المؤيد أنني % % لولاه ما سميت نفسي شاعرا % % 10(@)(@@) % وحلفت لم أمدح سواه لرغبة % لكنني جربت فيه الخاطرا % % PageV01P791 11(@)(@@) % ملك ابن أيوب الثناء بنائل % أضحى على حمل المغارم صابرا % % 12(@)(@@) % وتملكته سماحة وحماسة % جعلا له في كل ناد ذاكرا % % 13(@)(@@) % وإذا سخا ملأ الديار عوارفا % وإذا غزا ملأ القفار عساكرا % % 14(@)(@@) % وإذا سطا جعل الحديد قلائدا % وإذا عفى جعل الحديد جواهرا % % 15(@)(@@) % بينا الأسير لديه راكب أدهم % حتى غدا بالعفو أدهم ضامرا % % 16(@)(@@) % تمحو ظلام الليل بيض سيوفه % % مذ قيل إن الليل يسمى كافرا % % 17(@)(@@) % و تتابع المنن التي ما عيبها % % إلا رجوع الوصف عنها قاصرا % % 18(@)(@@) % يا ابن الملوك المالئين فجاجها % % مدحا منظمة الحلى ومآثرا % % 19(@)(@@) % من كل ذي عرض يصفى جوهرا % فاعجب لإعراض تكون جواهرا % % 20(@)(@@) % شكرا لشخصك ما أسير ممدحا % وأعز منتصرا 
ms168	 وأحلم قادرا % % PageV01P792 21(@)(@@) % حملتني النعمى إلى أن لم أبن % % من تغلبن أشاكيا أم شاكرا % % 22(@)(@@) % و نعم شكرت مواهبا لك حلوة % % حتى شققت من العداة مرائرا % % 23(@)(@@) % لا غرو ان عمر البيوت معانيا % عاف عمرت له البيوت ذخائرا % % 24(@)(@@) % بكرت عليك سعادة أبدية % وبقيت منصور العزائم ظافرا % % PageV01P793 البحر : - 1(@)(@@) % والذي زاد مقليك اقتدارا % % ما أظن الوشاة الا غيارا % % 2(@)(@@) % بهم مثل ما بنا من جفون % % شاجيات تهتك الأستارا % % 3(@)(@@) % كلما جال لحظها ترك النا % % س سكارى وماهم بسكارى % % 4(@)(@@) % يا غزالا رنا وغصنا تثنى % % وهلالا سما وبدرا أنارا % % 5(@)(@@) % كان دمعي على هواك لجينا % فأحالته نار قلبي نضارا % % 6(@)(@@) % حلية لا أعيرها لمحب % شغل الحلي أهله أن يعارا % % 7(@)(@@) % ما لقلبي اليتيم ضل وقد آ % % نس من جانب السوالف نارا % % 8(@)(@@) % لك جيد ومقلة تركا الظ % % بي لفرط الحياء يأوي القفارا % % 9(@)(@@) % وثنايا أخذن في ريقها الخم % % ر وأعطين العقول الخمارا % % 10(@)(@@) % عاطرات الشميم تحسب فيه % % ن شذا من ثنا ابن شاد معارا % % PageV01P794 11(@)(@@) % المليك المؤيد اللازم السؤ % % دد إن حل حل أوسار سارا % % 12(@)(@@) % والجواد الذي حبا المال حتى % % كاد يحبو الأعمال والأعمارا % % 13(@)(@@) % أعدل المالكين حكما فما يظ % % لم الا العداة والدينارا % % 14(@)(@@) % فاح ذكرا وفاض في الخلق نهرا % فحمدنا الرياض والأنهارا % % 15(@)(@@) % ليس فيه عيب سوى أن إحسا % % ن يديه يستعبد الأحرارا % % 16(@)(@@) % لم يزل جوده يجور على الما % % ل إلى أن كسى النضار اصفرارا % % 17(@)(@@) % البدار البدار نحو نداه % % فإذا صال فالفرار الفرارا % % 18(@)(@@) % مثل ماء السماء خلقا هنيئا % وابن ماء السما علي واقتدارا % % 19(@)(@@) % كلما استغفر الرجا من سواه % % أرسلت كفه الندى مدرارا % % 20(@)(@@) % و إذا شبت الوغى فكأن الس % % يف من بأسه استعار استعارا % % PageV01P795 21(@)(@@) % ذو حسام مدرب لم يدع في % % جانب الشام للعدى ديارا % % 22(@)(@@) % أعجل الكافرين بالفتك عن أن % % يلدوا فيه فاجرا كفارا % % 23(@)(@@) % يا مليكا أحيي الثنا والعطايا % % فجلبنا لسوقه الأشعارا % % 24(@)(@@) % و تلقى بضائع القصد والحم % % د فجئنا إلى حماه 
ms169	 تجارا % % 25(@)(@@) % اسأل الله أن يزيدك فضلا % وسموا على الورى وفخارا % % 26(@)(@@) % صنتني عن أذى الزمان وقدحا % % ول حربي واستكبر استكبارا % % 27(@)(@@) % و انبرى غيثك الهتون بجدوى % % علمتني مدائحا لا تبارى % % 28(@)(@@) % مامددنا لك اليمين ابتغاء % للعطايا الا شكرنا اليسارا % % PageV01P796 البحر : - 1(@)(@@) % في مرشفيه سلاف الراح من عصره % % ومعطفيه قوام البان من هصره % % 2(@)(@@) % وفي ابتسام ثناياه ومنطقه % % من نظم الدر أسلاكا ومن نثره % % 3(@)(@@) % ظبي قضى كل زيد في محبته % % وما قضى من ليالي وصله وطره % % 4(@)(@@) % مطابق الوصل في مرأى ومختبر % % فالخد سهل وأسباب الرضا وعره % % 5(@)(@@) % اذا انثنى شمت من أعطافه غصنا % عليه من كل حسن باهر زهره % % 6(@)(@@) % ذاك الذي خجلت أجفان مقلته % % من القلوب فراحت وهي منكسره % % 7(@)(@@) % بينا يرى جنة في العين مونقة % % حتى يرى جذوة في القلب مستعره % % 8(@)(@@) % كيف الخلاص لمطوي على شجن % % وقد تمالت عليه أعين السحره % % 9(@)(@@) % تغزو لواحظها في المسلمين كما % % تغزو سيوف عماد الدين في الكفره % % 10(@)(@@) % ملك اذا نظرت عين الرجاء له % % لم يدفع الجود رؤياها اذا نظره % % PageV01P797 11(@)(@@) % مؤيد النعت والأفعال ذو شيم % لباسة لبرود الحمد مفتخرة % % 12(@)(@@) % يضيئ حسنا ويندي كفه كرما % فما ترى بدره ترى بدره % % 13(@)(@@) % اذا تأملت بشرا منه مقتبلا % عرفت من مبتداه في الندى خبره % % 14(@)(@@) % لو أن للغيث جزأ من مكارمه % % لم يهمل الغيث من سقيا الثرى مدره % % 15(@)(@@) % لا عيب فيه أدام الله دولته % % الا عزائم مجد عندهن شره % % 16(@)(@@) % و فكرة في العلى والفكر دائبة % % ليست على أمد في الفضل مقتصره % % 17(@)(@@) % طالت إلى الأفق فاستنقت دراريه % % و غاصت البحر حتى استخرجت درره % % 18(@)(@@) % آها لها فكرا حدت بمعرفة % % تحديد رب من الألفاظ بالنكره % % 19(@)(@@) % و همة في سماء العز واضحة % % كأنما الشمس من نيرانها شرره % % 20(@)(@@) % تباشر الحرب هولا وهي سافرة % % و تمنح المال جودا وهي محتقره % % PageV01P798 21(@)(@@) % يا حبذا منه في عين الثنا رجل % % شاف اذا الناس في عين الثناء مره % % 22(@)(@@) % أبهى وأبهر ما يلقاك 
ms170	 منظره % % إذا نظرت على وجه الوغى قتره % % 23(@)(@@) % والبيض محنية الاضلاع من قدم % % على الطلا وقدود السمر منتظره % % 24(@)(@@) % والطرف قد نبتت بالنبل جلدته % % كأنه بين أنهار الدما شجره % % 25(@)(@@) % مناقب ما تولى الخبر أحرفها % % الا حسبت على عطف العلى خبره % % 26(@)(@@) % أقول للمدح اللاتي أنظمها % % ردي حماه على اسم الله مبتدره % % 27(@)(@@) % ما يخذل الله أوصافا ولا كلما % بين المؤيد والمنصور منتصره % % 28(@)(@@) % أضحى المؤيد للاملاك واسطة % % بين الأصول وبين النسل مفتخره % % 29(@)(@@) % ذاك الذي سترت رؤيا محاسنه % % ذنب الزمان فما يشكو امرؤ ضرره % % 30(@)(@@) % مهما أراه رفيع الذكر ممتدحا % فكل سيئة للدهر مغتفره % % PageV01P799 31(@)(@@) % ياابن الملوك قضوا أوقات ملكهم % سديدة وتقضوا سادة برره % % 32(@)(@@) % كم سفرة لي إلى مغناك فائزة % % أغنت لهاك يدي فيها عن السفرة % % 33(@)(@@) % ومدحة لي قد أيمنت طائرها % % حيث المدائح في أهل الغنى طيره % % 34(@)(@@) % فعش ودم لذوي الآمال ذا رتب % % علية ويد في الفضل مقتدره % % 35(@)(@@) % يا رب أفنان مدح فيك قد سطرت % % فأصبح الجود في أوراقها ثمره % % PageV01P800 البحر : - 1(@)(@@) % أفدي قمر عقلي قمر % % ثم غدر لما قدر % % 2(@)(@@) % فلا وزر ولا مفر % % يا من شهر سيف الحور % % 3(@)(@@) % على البشر فما فتر % % حتى استعر وهج الفكر % % 4(@)(@@) % ولو أمر ذاك الخصر % % من الثغر أطفى شرر % % 5(@)(@@) % لكن هجر وما ادكر % % دما هدر هلا نظر % % 6(@)(@@) % دمعي نهر على زهر % % ذاك الخفر يحكي بدر % % 7(@)(@@) % ملك عمر بما نشر % % نشر الخبر من الخبر % % 8(@)(@@) % والمختبر لله در % تلك السير كم من غرر % % 9(@)(@@) % ومن درر فيها سمر % % إلى السحر ولا ضجر % % 10(@)(@@) % ولا ضرر علم مهر % % فضل ظهر ثم انتشر % % PageV01P801 11(@)(@@) % فكم غفر وكم نصر % % على الغير جدا عثر % % 12(@)(@@) % وكم قهر من ذي أشر % % دب الخمر يا من ستر % % 13(@)(@@) % أهل الحصر ممن شكر % % ثم عذر أنت المطر % % 14(@)(@@) % لا ما نظر على المدر % % سد من حضر ومن غبر % % 15(@)(@@) % ولا تذر لمن نذر % % من مفتخر إلا مضر % % PageV01P802 البحر : - 1(@)(@@) % يا عذولي 
ms171	 خلني أغنم عمري % % ان أعمار الورى كالسحب تسري % % 2(@)(@@) % دع فؤادي والذي يختاره % % ماعلى ظهرك ياعاذل وزري % % 3(@)(@@) % دع غواني مجلسي تصدح لي % % فغد اتبكي البواكي حول قبري % % 4(@)(@@) % يا نديمي وهذا يومنا % % يوم صحو فاجعلاه يوم سكري % % 5(@)(@@) % واسقياني مثل خلقي قهوة % % بيدي بدر يغنيني بشعري % % 6(@)(@@) % أنا عذري الهوى لكن لي % % ثقة بالعفو تجلو وجه عذري % % 7(@)(@@) % والذي أهواه بدر قاتل % اعملوا ما شئتم يا أهل بدر % % 8(@)(@@) % ولسلطاني صفات مدحها % % صادق يمحى بها وزري وفقري % % 9(@)(@@) % ملك من آل أيوب له % % في تكاليف العلى ميراث صبري % % 10(@)(@@) % عادل ماكاد زيد النحو في % % دهره يعزى اليه ضرب عمرو % % PageV01P803 11(@)(@@) % وجواد ماليسر الغيث ما % % لندى راحته في حال عسر % % 12(@)(@@) % أفضلي التعت والذات فيا % % لهما من نسبتي سر وجهر % % 13(@)(@@) % يا مليكا أحمل المدح له % % وعجيب حامل درا لبحر % % 14(@)(@@) % إن أعداءك والأنعام في % % حالة فاجمعها في يوم نحر % % 15(@)(@@) % وتهنا ألف عيد مثله % % في مسرات وفي عز ونصر % % 16(@)(@@) % رفعت قدري فيه ليلة % % قربتني سيالها ليلة قدر % % 17(@)(@@) % وعلى القصر اجتماع ياله % % سفرا أفضى إلى جمع وقصر % % 18(@)(@@) % كنت غضبانا على الدهر وقد % % ردني جودك فرحانا بدهري % % 19(@)(@@) % فيمينا لسوى مغناك لا % % ينثني قصدي ولا أثني بشعري % % 20(@)(@@) % أنت غيثي ونباتي للثنا % % حقه أن يتلقاك بزهر % % PageV01P804 البحر : - 1(@)(@@) % تنبه لما أن رأى شيبه فجرا % % فنزه عن عاداته الشعر والشعرا % % 2(@)(@@) % وأعرض عن أغزاله وغزاله % % فلا قامة سمرا ولا وجنة حمرا % % 3(@)(@@) % ولا مقلة نجلاء يحرس لحظها % % لمى فأقول السيف قد حرس الثغرا % % 4(@)(@@) % ولا مرشف ماء الحياة حسبته % % ولا نبت خد كنت أحسبه الخضرا % % 5(@)(@@) % ولا قهوة أستغفر الله تجتلى % % ومن عجب أن قد حلا منه ما مرا % % 6(@)(@@) % وكانت كما لا يقتضي العقل غرة % فحنك ذاك الشيب ذاك الفتى الغرا % % 7(@)(@@) % وذكرني فقد الأحبة مرجعي % % اليهم وترحالي فلم أستطع صبرا % % 8(@)(@@) % أحباء ساروا قبلنا لمنازل % فيا صاحبي رحلى قفا نبك من ذكرى % % 9(@)(@@) % كأنهم لم يركبوا ظهر 
ms172	 سابح % % ولا ركبوا في يوم مكرمة ظهرا % % 10(@)(@@) % ولا بسطوا يمنى ببذل رغيبة % ولا أوجدوا من بعد جائحة يسرا % % PageV01P805 11(@)(@@) % لنا عبرة فيهم تنبه مقلة % ولو أرشدت كانت له مقلة غبرا % % 12(@)(@@) % لقد غرت الدنيا بخدعة حربها % % فما أكثر القتلى وما أرخص الأسرى % % 13(@)(@@) % حمى الله من عين الزمان وأهله % % لنا ملكا قد أحرز الذكر والأجرا % % 14(@)(@@) % ترجى لدنياها الملوك واننا % % لنرجوه للدنيا ملاذا وللأخرى % % 15(@)(@@) % مليك سمت عيناه للنسك والعلى % % فكانت قليلا من دجى الليل ما تكرى % % 16(@)(@@) % وأعذر في هجر التنعم نفسه % % وقال للاحيه لعل لها عذر % % 17(@)(@@) % على حين أعطاف الشبيبة لدنة % وروضتنا في الملك أو نفسها خضرا % % 18(@)(@@) % ومازال طهر الفعل حتى تشبهت % % فعال رعاياه فكان يرى طهرا % % 19(@)(@@) % ليهن بني أيوب أن محمدا % بنى لهم في كل صالحة ذكرا % % 20(@)(@@) % وبر البرايا عدله ونواله % % فلا عدموا من شخصه البر والبحرا % % PageV01P806 21(@)(@@) % وفي الناس من حاز الممالك جنة % ولكن جنان الخلد مملكة أخرى % % 22(@)(@@) % أيا ملكا نمسي اذا الدهر مظلم % % نراقب من لألاء غرته الفجرا % % 23(@)(@@) % بقيت لنا تعلو عن الشعر رتبة % % نعم وعلى هام السماكين والشعرى % % 24(@)(@@) % وتذكرنا عهد الشهيد ودهره % % سقى الغيث عنا ذلك العهد والدهرا % % PageV01P807 البحر : - 1(@)(@@) % بدت في رداء الشعر باسمة الثغر % % فعوذتها بالشمس والليل والفجر % % 2(@)(@@) % ولو شئت قسمت الذوائب مقسما % بطيب ليال من ذوائبها عشر % % 3(@)(@@) % وقبلتها مصرية حلوة اللمى % % أكرر في تقبيلها السكر المصري % % 4(@)(@@) % ويعذلني من ليس يدري صبابتي % % فأصرفه من حيث يدري ولا يدري % % 5(@)(@@) % ومن عجب الأشياء حلو ممنع % أصبر عنه وهو حلو مع الصبر % % 6(@)(@@) % وكم لائم في حب خنساء أعرضت % % وعنف حتى جانس الهجر بالهجر % % 7(@)(@@) % وشيب رأسي خدها ومعنفي % % وهذا رماد الشيب من ذلك الجمر % % 8(@)(@@) % فيا قلب خنساء القوي وأدمعي % % على مثلك العينان تجري على صخر % % 9(@)(@@) % ويا قلب صبرا في عطاها ومنعها % % فلا بد من يسر ولا بد من عسر % % 10(@)(@@) % أرى الشمس منها في العشاء منيرة % ومن صدها عني أرى 
ms173	 النجم في الظهر % % PageV01P808 11(@)(@@) % يذكرني عهد الوفا ما نسيته % % ولكنه تجديد ذكر على ذكر % % 12(@)(@@) % زمان الصبى والقرب لانحذر النوى % % ولكن نقضي الحال أحلى من التمر % % 13(@)(@@) % وأما وقد ضاء المشيب بمفرقي % % فبالشيب لا بالطوع صرنا إلى الهجر % % 14(@)(@@) % وفارقت خد الغانيات وجفنها % % فجرحا على جرح وكسرا على كسر % % 15(@)(@@) % وإني لمشتاق إلى ظل روضة % على النيل أروي العيش منها عن النضر % % 16(@)(@@) % لئن حثني باب البريد إلى مصر % % لقد حثني باب الزيادة في النزر % % 17(@)(@@) % إلى مصر يحلو نيلها مخصب الثرى % % فيغني الورى في الحالتين عن القطر % % 18(@)(@@) % وتقبيل حلو الغزو للمحل قاتل % % حلاوته سكب وجنديه يجري % % 19(@)(@@) % ويجري باسعاد العباد فحبذا % % بسعدك ياسلطانها ساعيا يجري % % 20(@)(@@) % لسلطان مصر الناصر بن محمد % على كل مصر طاعة البحر والبر % % PageV01P809 21(@)(@@) % تجمعت الأمصار في مصر طاعة % % وهل تجمع الأمصار إلاعلى مصر % % 22(@)(@@) % سلام على اسكندر الوقت أن يفح % % شذا الذكر عنه فالسلام على الخضر % % 23(@)(@@) % سلام ثغور الخلق تنقش في الثرى % % بأفواهها ختما على أنفس الذخر % % 24(@)(@@) % على باب سلطان العباد كأنها % % لنظم ثناياها عقود من الدر % 25(@)(@@) % مليك روت أعماله سير التقى % % عن الملك المصري عن الحسن البصري % % 26(@)(@@) % له منزلا جيش وتحت مقامه % % بهذا وذا في القلب حب وفي الصدر % % 27(@)(@@) % أيالة ملك لا فلان ولا فل % ونحو على لا نحو زيد ولا عمرو % % 28(@)(@@) % فملك بلا جور وحكم بلا هوى % % وأزر بلا وزر وعز بلا كبر % % 29(@)(@@) % قضا عمر في حلم عثمان جامعا % لبأس علي في سماح أبي بكر % % 30(@)(@@) % مضى الشفع من مرآى أبيه وجده % % وجاء فلا زالت له دولة الوتر % % PageV01P810 31(@)(@@) % إلى ناصر من ناصر وكذا على % % مدى جده المنصور مسترسل النصر % % 32(@)(@@) % أجل بيوت الملك بيت قلاون % وأنت أجل البيت يا وارث الدهر % % 33(@)(@@) % فملكك حق واضح الصبح أشرقت % % سعادته كالظهر ياواحد العصر % % 34(@)(@@) % مراد البرايا أن تدوم وأن تووا % % وميراثك الباقي إلى ذلك الحشر % % 35(@)(@@) % بصوتك أركان الشريعة شيدت % % وصينت ثغور كلها باسم الثغر 
ms174	 % % 36(@)(@@) % وخاض بها قوم تعدوا فقوبلوا % % بما كل انسان لديه من الخسر % % 37(@)(@@) % وليس الذي خاض الشريعة سالما % من الأسد الحامي حماها من المكر % % 38(@)(@@) % لك الله إما كسب حظ من الثنا % % يحوز وإما كسب حظ من الأجر % % 39(@)(@@) % ليهنك ما تجنيه من جنة غدا % % بإبطال ما تجنى الجنايات من وزر % % 40(@)(@@) % ليهنك ما عمرته من معالم % سيثني على عمارهن أبو ذر % PageV01P811 41(@)(@@) % ويمدحكم حسانها اليوم أو غدا % % بدار البقا بعد الطويل من العمر % % 42(@)(@@) % فأيامك الأعياد عائدة لمن % % رجاك ومن عاداك بالفطر والنحر % % 43(@)(@@) % وكفاك للمداح أيام عشرها % % وليلة من تسعى لها ليلة القدر % % 44(@)(@@) % ودولتك الزهراء للجود والسطا % % فبالفلك السعدي والفلك البشري % % 45(@)(@@) % ونصر على الاعدا يبادر رعبه % فيسبق مجرى الخيل بالعسكر المجر % 46(@)(@@) % ويعرض عن كيد العدا لاحتقارهم % % بلا قاصد ماش ولا حائم صقر % % 47(@)(@@) % فأعداك هذا مس في النوم رأسه % % وآخر قبل السيف مات من الذعر % % 48(@)(@@) % وكم لك في داني الديار ونازح % غيوث عطايا تخلط السهل بالوعر % % 49(@)(@@) % يضن بأحمال من التبن معشر % إذا اتصلت أحمال جودك من تبر % % 50(@)(@@) % مليك التقى والعلم والبأس والندى % % فمدح على مدح وشكر على شكر % % PageV01P812 51(@)(@@) % تهن وكل الناس عافية روت % % حديث التهاني عن بشير وعن بشر % % 52(@)(@@) % بها حملت عنك السقام بمصرها % % عيون المها بين الجزيرة والجسر % % 53(@)(@@) % فأحسن بها للملك في كل حالة % بشائر عند السيف والعز والنصر % % 54(@)(@@) % وأحسن بها حيث الهناء مسطر % صحائفها عن كاتب السر والجهر % % 55(@)(@@) % عوافي الا أنها قاهرية % حلت حالتاها في المسرة والقهر % % 56(@)(@@) % فعافية الاجساد عند ذوي الهدى ع وعافية الأطلال عند ذوي الكفرص هنئا لسلطان البرية سيرة سقط شطرين من ص % % مزهرة الأوراق بالأنجم الزهر % % 57(@)(@@) % هنيئا لاجلاب المدائح والرجا % % لقد أصبحت تجري إلى ملك تجري % % 58(@)(@@) % يبيع ولكن بالكلام نفائسا % من المال تلقاها غدا جمة الوفر % % 59(@)(@@) % ويبتاع لكن بالنفيس غواليا % من الحمد إلا أنه عاطر النشر % % 60(@)(@@) % غنينا عن السبع البحار بأنمل % أفيضت كما يغنى عن السبع 
ms175	 بالعشر % % PageV01P813 61(@)(@@) % وأحييت للآداب علما ومعلما % بنعماء تقري بالفوائد أو تقري % % 62(@)(@@) % وجوه دنانير سبقن بمعجز % ترينا وجوه التم في أول الشهر % % 63(@)(@@) % سبقن وان لم يشتكي الفقر بالغنى % % وقابلن من لم يشتكي الكسر بالجبر % % 64(@)(@@) % كذلك أذهان الملوك نقية % ترى في مراة العقل أيان يستقري % % 65(@)(@@) % تأملت ما تعطى الملوك من النهى % % فعوذت فردا بالثلاث من الحجر % % 66(@)(@@) % أحقا أراني في ثرى عتباته % % نباتا يحيي واكف المزن بالزهر % % 67(@)(@@) % وأنشدت امداحا تقول لمن أتت % % مدحتك بالشعرى وغيرك بالشعر % % PageV01P814 البحر : - 1(@)(@@) % سقى حماك من الوسمي باكره % % حتى تبسم من عجب أزاهره % % 2(@)(@@) % يا دار لهوي لا واش أكاتمه % % ولا رقيب بمغناها أحاذره % % 3(@)(@@) % حيث الشبيبة تصبي كل ذي حور % سيان أسود مرآها وناظره % % 4(@)(@@) % من كل محتكم الأجفان يخرجنا % % من أرض سلوتنا في الحب ساحره % % 5(@)(@@) % ظبي إذا شمت خديه ومقلته % % أذاب لاهبه قلبي وفاتره % % 6(@)(@@) % يأوي إلى بيت قلب فيه مخترب % فاعجب لمخرب بيت وهو عامره % % 7(@)(@@) % كأنه بيت شعر في عروض جوى % % دارت عليه بلا ذنب دوائره % % 8(@)(@@) % ليهن من بات مسرورا بهجعته % % إني عليه قريح الطرف ساهره % % 9(@)(@@) % مجري الدموع على طرف تألفها % % فاستسهلت لمجاريها محاجره % % 10(@)(@@) % كم ليلة بت أشكو من تطاولها % % علي والأفق داجي القلب كافره % % PageV01P815 11(@)(@@) % وأرقب الشهب فيه وهي ثابتة % كأنما سمرت منها مسامره % % 12(@)(@@) % حتى بدا الصبح يحكي وجه سيدنا % % قاضي القضاة اذا استجداه زائره % % 13(@)(@@) % لله صبح تجلى للشريعة عن % % ذاك الجلال لقد جلت مآثره % % 14(@)(@@) % أفدي البريد وللتقليد في يده % % مخلق تملأ الدنيا بشائره % % 15(@)(@@) % يكاد يلمع مطوي السطور به % % حتى ينم على فحواي ظاهره % % 16(@)(@@) % مسرة كان طرف الشرع يرقبها % % ومطلب كانت العليا تحاوره % % 17(@)(@@) % قاضي القضاة جلال الدين قد وضحت % % سبل القريض وصاغ القول ماهره % % 18(@)(@@) % هذي كؤس الثنا والحمد مترعة % باكر صبوحك أهنى العيش باكره % % 19(@)(@@) % واسمع مدائح قد فاه الجماد بها % % وقد ترنم فوق الأيك طائره % % 20(@)(@@) % ما أحسن الدين والدنيا يسوسهما % % والطيلسان فلا تخفى مفاخره 
ms176	 % % PageV01P816 21(@)(@@) % كأن أبيض هذا تلو أسود ذا % % عين الزمان الذي مازاغ باصره % % 22(@)(@@) % حيث المقاصد في أبوابه زمرا % فليس للدهر ذنب وهو غافره % % 23(@)(@@) % فاستجل طلعة ذي بشر وذي كرم % كالغيث بارقه الساري فماطره % % 24(@)(@@) % تصبو لحبر فتاويه لواحظنا % % فما عيون المها إلا محابره % % 25(@)(@@) % وينفذ الأمر كالسهم القويم فماع تحيد عن غرض التقوى أوامرهص لا شيء أحسن من مرآه مقتبلا سقط شطرين من ص % % إلا محاسن ما ضمت سرائره % % 26(@)(@@) % تجلو المهابة في ناديه رونقها % % فما نكاد بنجوانا نجاهره % % 27(@)(@@) % ويفهم السر من حاجات أنفسنا % % فما نطيق على أمر نساتره % % 28(@)(@@) % يا حاكما صان سوح الدين عاضده % % وفاز بالشرف المأثور ظافره % % 29(@)(@@) % وليت بالعلم لا بالحظ مرتبة % فاحكم بعلمك فيما أنت ناظره % % 30(@)(@@) % وانظر لحال غريب الدار مفتقر % % طال الزمان وما سدت مفاقره % % PageV01P817 31(@)(@@) % نعم الفتى أنت قد برت أوائله % % في المكرمات وقد أربت أواخره % % 32(@)(@@) % يممته دلفي الأصل منتسبا % تأبى معاليه أن تخفى عناصره % % 33(@)(@@) % لا يستقر بكفيه الثراء فما % % تلك الحظوظ بها إلا معابره % % 34(@)(@@) % زكا وأمكنه فعل الجميل فما % % في الناس لو قصرت جدواه عاذره % % 35(@)(@@) % ما بعد علياه ركن أستجير به % % من الخطوب ولا بحر أجاوره % % 36(@)(@@) % لئن تفرد بالعلياء سؤدده % % لقد تفرد بالآداب شاعره % % PageV01P818 البحر : - 1(@)(@@) % وقائع حب حاد في كرها فكري % % فمن حسد تمشي ومن أدمع تجري % % 2(@)(@@) % ولاح ثقيل في مليح ممنع % فيا لك من أحد لدي ومن بدر % % 3(@)(@@) % يظل أبا جهل علي بجهله % % وأمسي بأوصاف السقام أبا ذر % 4(@)(@@) % وأغيد في فيه المدام ولحظه % % وفي وفي أعطافه نشوة السكر % % 5(@)(@@) % تداويت من ألحاظه برضا به % % كما يتداوى شارب الخمر بالخمر % 6(@)(@@) % ونزهت فكري في بدائع حسنه % % وفي عقل عذالي على أنها تغري % % 7(@)(@@) % تبارك من أنشا بخديه زخرفا % وسبحان من أنشى عذولي بلا حجر % % 8(@)(@@) % لعمري لقد قاس الهوى نحو صبوتي % % مقاييس لم تعبأ بزيد ولا عمرو % % 9(@)(@@) % وأنفقت عمري في المليح محبة % % فان يسلني عذل فيا ضيعة العمر % % 10 
ms177	(@)(@@) % واني لعذري الصبابة ان روت % % حديث الاسى عني الدموع فمن عذري % % PageV01P819 11(@)(@@) % تسابق بيض المزن حمر مدامعي % % فتسبقها والسبق من عادة الحمر % % 12(@)(@@) % ويسهرني ومض البروق كأنما % % تبسم في لعس السحائب عن ثغر % % 13(@)(@@) % أما ومليح العصر انك بالبكى % % و بالسهد يا إنسان عيني لفي خسر % % 14(@)(@@) % معنى بوسنان اللواحظ سارق % % كرى مقلني من حيث أدري ولا أدري % % 15(@)(@@) % يجر بنون الصدغ قلبي للأسى % % و ما خلت أن النون من أحرف الجر % % 16(@)(@@) % يقابل دمعي باسما فكأنما % % ينظم ما أملت جفوني من النثر % % 17(@)(@@) % وما لي لا أبكي على در مبسم % % كما بكت الخنساء قبلي على صخر % % 18(@)(@@) % وأجري عيون الدمع فائضة على % % عيون المها بين الجزيرة والجسر % % 19(@)(@@) % ظباء بشطي نيل مصر لأجلها % % يقول حنين الشوق آها على مصر % % 20(@)(@@) % خليلي شابت في النواظر لمتي % % و شب الأسى نار التذكر في صدري % % PageV01P820 21(@)(@@) % فلا تنكرا تعبيس وجهي فانما % % تنقل ذاك الابتسام إلى شعري % % 22(@)(@@) % وزالت بصبح الشيب عني خلني % % فكان زوال الشمس للصبح لا الظهر % % 23(@)(@@) % ويارب ليل كان لي بكؤوسه % % و مبسمه سلك ينظم بالدر % % 24(@)(@@) % تولى ووافى بالهموم كدمل % أكابده في الحالتين بلا فجر % % 25(@)(@@) % كأن النجوم المائلات بأفقه % % مفارق شيب لا تسر ولا تسري % % 26(@)(@@) % سقى الله أيام الشباب التي خلت % % من السحب أحلى ما يسيل من القطر % % 27(@)(@@) % رأيت شباب المرءعونا على الهوى % % وجود ابن فضل الله عوناعلى الدهر % % 28(@)(@@) % إذا ذكرت أهل السيادة والعلى % % فعد ابن فضل الله فاتحة الذكر % % 29(@)(@@) % إذا شمت منه طلعة علوية % فغال الثنا وارفض سنا لأنجم الزهر % % 30(@)(@@) % إذا ما علاء الدين حام فخاره % % فسل ثم عن نسر الكواكب لا النسر % % PageV01P821 31(@)(@@) % وزير بلا وزر وقاض بلا هوى % و غيث بلا عيب وبحر بلا ضر % % 32(@)(@@) % يسابقني لفظي لوصف زمانه % % و بالطبع تشدو الورق في الورق الخضر % % 33(@)(@@) % و يخدعه مثلي فيخدع للندى % % سريعا ولا والله ما هو بالغمر % % 34(@)(@@) % فسيح مجال الصدر بالبر للورى % % فيا لك من بحر 
ms178	 ويا لك من بر % % 35(@)(@@) % و يالك من لفظ وفضل لطالب % يحقق أن الصدر والكف من بحر % % 36(@)(@@) % و يالك مجدا جل رائيه عن عمى % % ويا لك بحرا جل عافيه عن نهر % % 37(@)(@@) % يسر به ملك ويحمي ثغوره % % فليس يزال الملك مبتسم الثغر % % 38(@)(@@) % و مازال شفعا بأسه ونواله % % لدى الملك حتى ما ينام على وتر % % 39(@)(@@) % فما الشمس في ظهر مثيلة وصفه % % ولا مثله فيما تقدم من عصر % % 40(@)(@@) % و مافيه من عيب يعد لناقد % سوى أنه بالجود مستعبد الحر % PageV01P822 41(@)(@@) % و أن ثناه فاضح حصر الورى % % وأن نداه لا يحاول بالحصر % % 42(@)(@@) % من القوم في بطحاء مكة أصلهم % % وأفناؤهم في الخلق فواحة الزهر % % 43(@)(@@) % إذا فرق الفاروق في الخلق ذكرهم % % فيا حبذا الاطهار تعزى إلى الطهر % % 44(@)(@@) % إذا ذكرت أقلامهم وسيوفهم % % فناهيك بالحمر الرواعف والسمر % % 45(@)(@@) % طوى شخصهم دهر وقام بمجدهم % % يفوح ثنا يستقبل الطي بالنشر % % 46(@)(@@) % له قلم يدعو الدواة كتابة % % ويغزى به عيش الملوك إلى النضر % % 47(@)(@@) % حفي غداة المكرمات أو الوغى % % ببيض أياديها وأعلامها الصفر % % 48(@)(@@) % و نظم ونثر يخرجان ذوي النهى % % لعمرك من أرض التثبت بالسحر % % 49(@)(@@) % لأجيادنا منه وللطرس حلية % فأجيادنا بالجود والطرس بالشذر % % 50(@)(@@) % و للحرب صف من سطور كأنها % % حديد يسوق الناكثين إلى الحشر % % PageV01P823 51(@)(@@) % بكف كريم الإرث والكسب في العلى % % فمن خبر نامي الفخار ومن خبر % % 52(@)(@@) % همام إذ الآراء حثت لغارة % % كريم إذا حثت على الكلم الغر % 53(@)(@@) % له منزل في القلب من كل جحفل % وفي المحفل السامي محل من الصدر % % 54(@)(@@) % بزهر من الآراء والقول واللهى % % روينا صحيح الحمد منها عن الزهري % % 55(@)(@@) % فيا حبذا عبد الرحيم توسلا % ويا حبذا الطائي في الجود والشعر % % 56(@)(@@) % ألم ترني أني نهضت بمدحه % % وألقيت أمداح البرية عن فكري % % 57(@)(@@) % أمولاي قد غنى بمدحي لك الورى % % وسارت به الركبان في السهل والوعر % % 58(@)(@@) % و قصر عن نظمي الأنام وشيدت % % عليك مباني بيته فهو كالقصر % % 59(@)(@@) % اذا رفعت قدري بمدحك ليلة % % تيقن قصدي 
ms179	 انها ليلة القدر % % 60(@)(@@) % وقضيتها والنيرات تمدني % % سلاما وتسليما إلى مطلع الفجر % % PageV01P824 61(@)(@@) % على أن عندي كأس شكوى أديرها % % على السمع ممزوجا بمدمعي الغمر % % 62(@)(@@) % أيكسر حالي بالجفاء وطالما % % تعودت من نعماك عاطفة الجبر % % 63(@)(@@) % و يدفعني عن قوت يومي معشر % وأنت عليهم نافذ النهي والأمر % % 64(@)(@@) % و لو كان ذنب لاعترفت به ولا % % تحيلت في عذر ولا جئت من غفر % % 65(@)(@@) % أحاشيك أن يدجو زماني بعدما % % أضاءت بشعري في المدائح من شعري % % 66(@)(@@) % بنيت على ضم ولاءك في الحشا % % فلا تبن بيت القلب مني على كسر % % 67(@)(@@) % وان تخف ياذا السر عنك محبتي % % فشاهد حبي عالم السر والجهر % % PageV01P825 البحر : - 1(@)(@@) % يتيم ابتسامك ما يقهر % % فسائل دمعي لا ينهر % % 2(@)(@@) % وانسان عيني إلى كم كذا % % بحين من الدهر لا يذكر % % 3(@)(@@) % و خدك ذا السهل ما باله % % على من رجا قبلة يعسر % % 4(@)(@@) % عن الورد يروي فيا حسن ما % % رواه لنا خلف الأحمر % % 5(@)(@@) % و يا حبذا حوله عارض % لدمعي هو العارض الممطر % % 6(@)(@@) % يقول نناسب روحي له % % هي النفس خضراء يا أخضر % % 7(@)(@@) % عسى يجبر الصب آس العذار % % فبالآس كسر الورى يجبر % % 8(@)(@@) % لك الله قلبا بحر الأسى % % ومن عمل الحب لا يفتر % % 9(@)(@@) % وهبت الكرى لجفون الرشا % % فكم ذا ينام وكم أسهر % % 10(@)(@@) % و كم قيل للنفس قال العذول % % فقالت جفون الرشا تغتر % % PageV01P826 11(@)(@@) % تعشقه بابلي اللحاظ % % يسكر من شاء أو يسحر % % 12(@)(@@) % ولام على حسنه المجتلي % % وقاح العيون فما أثروا % % 13(@)(@@) % و قالوا أما يرعوي سامع % فقلت أما يستحي مبصر % % 14(@)(@@) % حلوت وأمررت ملح الملاح % % فيا حبذا الملح والسكر % % 15(@)(@@) % و كرر لي ذكرك العاذلون % % فما كان أحلى الذي كرروا % % 16(@)(@@) % و وجهك جامع لذاتنا % % فيا حبذا الجامع الأقمر % % 17(@)(@@) % و ثغرك يشهد مسواكه % % فأعدل به شاهدا يسكر % % 18(@)(@@) % و يارب نيل بلقيك قد % % تبين لي فعله المضمر % % 19(@)(@@) % بخصرك والنهد نحو الهنا % % فهذا أضم وذا أكسر % % 20(@)(@@) % فيالك ليلا لو المانوي % % رآه رأى أنه الخير % % PageV01P827 21 
ms180	(@)(@@) % و أشرق إشراق ذاك الدجى % % فما منهما واحد يكفر % % 22(@)(@@) % و طابق أجفان عيني الظلام % % فهذا يطول وذي تقصر % % 23(@)(@@) % و ما قصر الليل أو طوله % % سوى أنك تسعف أو تهجر % % 24(@)(@@) % و ما الحزن والعيش الا سطا % % علي وأنعمه تنشر % % 25(@)(@@) % وزير اذا نظراء العلى % % تردوا ولاذوا به أزروا % % 26(@)(@@) % اذا سلكوا نحوه عرفوا % % برفع وإن تركوا نكروا % % 27(@)(@@) % فما صغروا وبه كبروا % % و لا كبروا وبه صغروا % % 28(@)(@@) % سعادة جد بها يحتذى % % ونهج أب في العلى يشهر % % 29(@)(@@) % كريم رأينا مسيء الزمان % % ببسط أياديه يستغفر % % 30(@)(@@) % فحسب الملوك سفير لهم % % وجوه إنالته تسفر % % PageV01P828 31(@)(@@) % و حسب ابن يحيى حياة العلى % % ولبعض معالي الورى تقبر % % 32(@)(@@) % زها أفق مصر بتدبيره % % فطالعها أبدا يزهر % % 33(@)(@@) % و قاهرة شادها لفظه % % فشائدها أبدا جوهر % % 34(@)(@@) % هو اللفظ حال به جيدها % % كفيل ندى وردى يهمر % % 35(@)(@@) % وزهر الورى خضر بالهنا % % وملك البرية إسكندر % % 36(@)(@@) % و صاحب أسراره كاتم % % وأنعمه في الورى تجهر % % 37(@)(@@) % مقيم على النيل لاابن الفرات % % ومجدهم البحر لا جعفر % % 38(@)(@@) % يعجل غاية ما يرتجى % % ويحلم ساعة ما يقدر % % 39(@)(@@) % و لا عيب فيه سوى سؤدد % % تكد الفهوم ولا يحصر % % 40(@)(@@) % على فضله خنصر العاقدين % % ومن أجل ذا حلي الخنصر % % PageV01P829 41(@)(@@) % و في يده فاضلي اليراع % % مقيم وسؤدده سير % % 42(@)(@@) % تغازل أحرفه كالظبا % % وطورا يحاذرها القسور % % 43(@)(@@) % اذا صاولته سيوف العدى % % فما ضره الشانئ الأبتر % % 44(@)(@@) % و ان ساجع الورق مال الحيا % % بها خلف أوراقها تستر % % 45(@)(@@) % و ان فاض درا على سامع % % فأنمل حامله الجسر % % 46(@)(@@) % أخا الفضل مكتملا وابنه % % ليهنك عام الهنا الأزهر % % 47(@)(@@) % فقابل بعلياك فيه الهلال % % لينحر حسادها خنجر % % 48(@)(@@) % و عش يا كثير الندى والثنا % % وأجرك من ذا وذا أكبر % % 49(@)(@@) % بجود يديك ابن فضل الاله % % تناسب منطقي الابهر % % 50(@)(@@) % فان كنت غيث ندى هاملا % فإن نبات ثنا مزهر % % PageV01P830 51(@)(@@) % شعرت بمدحك حتى بهرت % % وكنت من العي لا أشعر % % 52(@)(@@) % و حلق خلقي بهذا المطار % % أناس 