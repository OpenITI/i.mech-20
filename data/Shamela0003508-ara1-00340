ms321	 بشيء(@)(@@)(@@)(@@) | 4847 - (@)(@@) حدثنا يحيى قال حدثنا علي بن الحسين بن شقيق قال أنبأنا سفيان بن عيينة قال أخبرني أبو حمزة الثمالي قال قال المغيرة بن شعبة لحديث من عافل أحب إلى من الشهد بماء رصفة قال علي بن الحسين بن شقيق فأخبرني عبد الله بن المبارك عن سفيان بن عيينة عن أبي حمزة الثمالي قال فبلغ ذلك زيادا فقال أكذاك فلهو أحب إلى من رثيئة فثئت بسلالة ثغب في يوم ذي وديقة ترمض فيه الآجال قال علي بن الحسين فسروه عن عبد الله أجله الظباء من رثيئة فثئت هو اللبن يحلب من الليل ثم يحلب عليه منن النهار والثغب العين التي تجرى أو قال تخرج على الحجارة ليس فيها طين قال يحيى الوديقة الحر الشديد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4848 - (@)(@@) سمعت يحيى يقول أبو رجاء الذي يروى عنه محمد بن كثير هو عبد الله بن واقد أبو رجاء الخراساني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (تسمية أهل واسط والسواد وأهل المدائن وبغداد ومن يليهم)(@)(@@)(@@)(@@) | 4849 - (@)(@@) سمعت يحيى يقول حجاج الأعور قال قيل لشعبة بن الحجاج إن مستلم بن سعيد خالفك في حرف إذا وضعت لمتلك وكان شعبة يقول إذا وضعت لمثلك حديث أبي الدرداء ثم جاءك ملكان أسودان أزرقان فقال شعبة ما كنت أظن ذاك يحفظ حديثين قال يحيى والقول قول مستلم بن سعيد وصحف شعبة(@)(@@)(@@)(@@) | 4850 - (@)(@@) سمعت العباس يقول سمعت يزيد بن هارون يقول كان مستلم بن سعيد عندنا ها هنا بواسط وكان لا يشرب إلا في كل جمعة(@)(@@)(@@)(@@) | 4851 - (@)(@@) سألت يحيى عن عبد الحميد بن بهرام فقال ثقة(@)(@@)(@@)(@@) | 4852 - (@)(@@) سألت يحيى عن الحكم بن فضيل فقال ثقة(@)(@@)(@@)(@@) | 4853 - (@)(@@) سألت يحيى عن سفيان بن حسين فقال ثقة(@)(@@)(@@)(@@) | 4854 - (@)(@@) سألت يحيى عن محمد بن يزيد الواسطي فقال ثقة(@)(@@)(@@)(@@) | 4855 - (@)(@@) سمعت يحيى يقول محمد بن الحسن الواسطي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4856 - (@)(@@) سألت يحيى عن حماد بن دليل فقال ليس به بأس هو ثقة قلت من أين كان قال كان ولى قضاء المدائن ولا أدري من أين كان(@)(@@)(@@)(@@) | 4857 - (@)(@@) سمعت يحيى يقول سلام بن 
ms322	 سلم التميمي ليس بشيء(@)(@@)(@@)(@@) | 4858 - (@)(@@) والهذيل بن بلال ليس بشيء(@)(@@)(@@)(@@) | 4859 - (@)(@@) وعبد الأعلى بن أبي المساور ليس بشيء(@)(@@)(@@)(@@) | 4860 - (@)(@@) سمعت يحيى يقول وسألته عن حديث هشيم عن عروة الهمداني عن عائشة من عروة هذا فقال هو واسطي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4861 - (@)(@@) سألت يحيى عن حديث هشيم عن أبي إسحاق عن أبي قيس عن هزيل قال قال عبد الله ما أبالي ذكرى مسست أو أنفي فقلت له من أبو إسحاق هذا فقال يحيى هشيم لم يلق أبا إسحاق السبيعي ولم يلق أيضا أبا إسحاق والذي يدلس عنه الذي يقال له أبو إسحاق الكوفي(@)(@@)(@@)(@@) | 4862 - (@)(@@) سألت يحيى عن حديث هشيم عن حصين عن هلال بن يساف عن أبي عبيدة حدثنا فزعة أن النبي صلى الله عليه وسلم كان إذا رفع رأسه من الركوع من قزعة هذا فقال صاحب بن عمر(@)(@@)(@@)(@@) | 4863 - (@)(@@) سألت يحيى عن حديث رواه هشيم عن هارون السلمي قال هو أبو يزيد بن هارون وهو هارون بن يزيد بن زاذي(@)(@@)(@@)(@@) | 4864 - (@)(@@) سألت يحيى عن ليث أبي المشرقي فقال هو واسطي وليس به بأس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4865 - (@)(@@) حدثنا يحيى قال حدثنا جرير عن رقبة أن عبد الله بن المسور المدائن وضع أحاديث عن رسول الله صلى الله عليه وسلم فاحتملها الناس(@)(@@)(@@)(@@) | 4866 - (@)(@@) سمعت يحيى يقول عمرو بن خالد الواسطي ليس بثقة(@)(@@)(@@)(@@) | 4867 - (@)(@@) سمعت يحيى يقول أبو كامل صاحبنا اسمه مظفر بن مدرك وكان من الأبناء من أهل خراسان(@)(@@)(@@)(@@) | 4868 - (@)(@@) سمعت يحيى يقول نعيم بن حكيم من أهل المدائن الذي يروى عن أبي مريم(@)(@@)(@@)(@@) | 4869 - (@)(@@) سمعت يحيى يقول عمرو بن أبي حكيم الواسطي يروى عنه هشيم وهو ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4870 - (@)(@@) سمعت يحيى يقول حدثنا هشيم بن بشير عن أبي ساسان الخراساني قلت له من روى عن أبي ساسان هذا غير هشيم قال لا أدري(@)(@@)(@@)(@@) | 4871 - (@)(@@) سمعت يحيى يقول حدثنا هشيم قال قال له حجاج صف لي الزهري فإني لم أره(@)(@@)(@@)(@@) | 4872 - (@)(@@) قال يحيى ولم يسمع هشيم من القاسم بن أبي أيوب وقد حدث عنه وقد حدث عن بيان 
ms323	 بن بشر ولم يسمع منه(@)(@@)(@@)(@@) | 4873 - (@)(@@) قال يحيى وبيان بن بشر كنيته أبو بشر وهو بجلي(@)(@@)(@@)(@@) | 4874 - (@)(@@) سمعت يحيى يقول حجاج بن دينار واسطي ثقة(@)(@@)(@@)(@@) | 4875 - (@)(@@) وحجاج بن أبي زينب واسطي وهو ثقة(@)(@@)(@@)(@@) | 4876 - (@)(@@) سمعت يحيى يقول عمرو بن الأزهر كان بواسط وهو بصري ضعيف(@)(@@)(@@)(@@) | 4877 - (@)(@@) سمعت يحيى يقول الضحاك بن حمرة واسطي وكان أصله شاميا وليس بشيء(@)(@@)(@@)(@@) | 4878 - (@)(@@) سمعت يحيى يقول سويد بن عبد العزيز واسطي انتقل إلى دمشق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4879 - (@)(@@) سمعت يحيى يقول موسى بن يسار أبو الطيب وكان من أهل المدائن وروى عنه شبابة وهو ثقة(@)(@@)(@@)(@@) | 4880 - (@)(@@) سمعت يحيى يقول حدث هشيم عن أبي رحمة وأبو رحمة هذا بواسط وهو شامي(@)(@@)(@@)(@@) | 4881 - (@)(@@) سمعت يحيى يقول دلس هشيم عن زاذان أبي منصور ولم يسمع منه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4882 - (@)(@@) سمعت يحيى يقول أبو كامل صاحبنا كان قد لقى محمد بن طلحة وفليحا وأيوب بن عتبة وكان لا يرضاهم قال يحيى قال أبو كامل قال محمد بن طلحة أذكر أبي شبيها بالحلم وكان أبو كامل يضعف محمد بن طلحة(@)(@@)(@@)(@@) | 4883 - (@)(@@) سمعت يحيى يقول حماد بن دليل كنيته أبو زيد ليس به بأس(@)(@@)(@@)(@@) | 4884 - (@)(@@) سمعت يحيى يقول قد روى حماد بن سلمة عن عبد الله بن شداد قال يحيى وهو شيخ واسطي(@)(@@)(@@)(@@) | 4885 - (@)(@@) سمعت يحيى يقول شعيب بن حرب ثقة مأمون(@)(@@)(@@)(@@) | 4886 - (@)(@@) سمعت يحيى يقول أبو عقيل قاضي واسط هاشم بن بلال(@)(@@)(@@)(@@) | 4887 - (@)(@@) سمعت يحيى يقول عبد الحكيم بن منصور واسطي كذاب(@)(@@)(@@)(@@) | 4888 - (@)(@@) سمعت يحيى يقول الزبير بن سعيد كان ينزل المدائن وكان ضعيفا(@)(@@)(@@)(@@) | 4889 - (@)(@@) سمعت يحيى يقول أيوب بن مسكين واسطي قصاب وكنيته أبو العلاء(@)(@@)(@@)(@@) | 4890 - (@)(@@) سمعت يحيى يقول قد روى هشيم عن رجل يقال له غيلان وهو واسطي(@)(@@)(@@)(@@) | 4891 - (@)(@@) سمعت يحيى يقول قد روى هشيم وشعبة عن رجل يقال له زكريا(@)(@@)(@@)(@@) | 4892 - (@)(@@) سمعت يحيى يقول الهذيل بن بلال كان ينزل المدائن وليس بشيء(@)(@@)(@@)(@@) | 4893 - (@)(@@) سمعت يحيى يقول الحسين بن علوان كذاب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4894 - (@)(@@) سمعت يحيى يقول سلمة الأحمر قاضي واسط ليس بثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4895 
ms324	 - (@)(@@) سمعت يحيى يقول أبو قتادة كان ينزل دار سفيان بن معاوية ليس بشيء وليس هو أبو قتادة الحراني هذا رجل آخر(@)(@@)(@@)(@@) | 4896 - (@)(@@) سمعت يحيى يقول داود بن عبد الجبار كان ينزل باب الطاق وقد رأيته وكان يكذب(@)(@@)(@@)(@@) | 4897 - (@)(@@) سمعت يحيى يقول سالم بن عبيد يروى عنه يزيد بن هارون(@)(@@)(@@)(@@) | 4898 - (@)(@@) وأبو قتادة الحراني ليس به بأس إلا أنه كان يغلط في الحديث(@)(@@)(@@)(@@) | 4899 - (@)(@@) سمعت يحيى يقول هشيم لم يرو عن خالد بن سلمة وقد سمع منه سفيان بن عيينة وسفيان الثوري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4900 - (@)(@@) سمعت يحيى يقول وذكر عنده حسين بن محمد فقال كان شبابة أكيس من حسين بن محمد(@)(@@)(@@)(@@) | 4901 - (@)(@@) سمعت يحيى يقول وذكر عنده إسماعيل بن عياش فقال يحيى كان إسماعيل بن عياش يقعد ومعه ثلاثة أو أربعة فيقرأ كتابا وهم معه والناس مجتمعون ثم يلقيه إليهم فيكتبونه جميعا ولم ينظر في الكتاب إلا أولئك الثلاثة أو الأربعة سمعت يحيى يقول شهدت إسماعيل بن عياش وهو يحدث هكذا فلم أكن آخذ منه شيئا ولكني شهدته يملى إملاء فكتبت عنه(@)(@@)(@@)(@@) | 4902 - (@)(@@) سمعت يحيى يقول كان بن أبي ذئب يحدث فيقرأ عليهم كتابا ثم يلقيه عليهم فيكتبونه ولم ينظروا في الكتاب(@)(@@)(@@)(@@) | 4903 - (@)(@@) سمعت يحيى يقول كان هشيم يحدث ها هنا فمن علق شيئا فذاك وإلا فما كانوا يكتبون عن المستملي(@)(@@)(@@)(@@) | 4904 - (@)(@@) سمعت يحيى يقول قال لي حجاج الأعور كان بن أبي ذئب رجلا لا يملى شيئا ما سمعته منه قرأته عليه(@)(@@)(@@)(@@) | 4905 - (@)(@@) حدثنا العباس قال حدثنا حجين بن المثنى قال قدم علينا إسرائيل بغداد فاجتمع الناس عليه فأقعدوه فوق موضع مرتفع وقام رجل معه دفتر فجعل يسأله منه وليس ينظر فيه الناس فلما قام إسرائيل قعد الرجل فأملاه على الناس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4906 - (@)(@@) سمعت يحيى يقول وذكر محمد بن الصباح الذي ينزل جرجرايا فقال حدث بحديث منكر عن علي بن ثابت عن إسرائيل عن بن أبي ليلى عن نافع عن بن عمر قال قال رسول الله صلى الله عليه وسلم صنفان ليس لهما في 
ms325	 الإسلام نصيب المرجئة والقدرية ولم أر يحيى ذكره بسوء(@)(@@)(@@)(@@) | 4907 - (@)(@@) سمعت يحيى يقول صلة بن سليمان كان وسطيا وكان ببغداد وكان كذابا(@)(@@)(@@)(@@) | 4908 - (@)(@@) سمعت يحيى يقول راشد بن معبد واسطي قد سمع من أنس بن مالك وسمع منه زيد بن حباب وراشد هذا ضعيف(@)(@@)(@@)(@@) | 4909 - (@)(@@) سمعت يحيى يقول زياد بن أبي زياد الجصاص واسطي ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4910 - (@)(@@) سمعت يحيى يقول عقبة بن أبي الصهباء كنيته أبو خريم مولى باهلة وهو ثقة وكان ينزل المدائن(@)(@@)(@@)(@@) | 4911 - (@)(@@) سمعت يحيى يقول أبو سلام الحنفي هو عبد الملك بن سلام المدائني وهو ثقة يروى عنه يزيد بن هارون(@)(@@)(@@)(@@) | 4912 - (@)(@@) سمعت يحيى يقول وقلت له إن يزيد بن هارون يروى عن هشام عن كثير بن أبي كثير عن بن عباس ثلاثة لا تقربهم الملائكة نائم جنب ومتضمخ بخلوق وجنازة كافر من كثير بن أبي كثير هذا فقال لا أدري(@)(@@)(@@)(@@) | 4913 - (@)(@@) سمعت يحيى يقول عمرو بن حكيم واسطي مولى لآل الزبير قد سمع عبد الوارث وهشيم منه(@)(@@)(@@)(@@) | 4914 - (@)(@@) سمعت يحيى يقول قد سمع هشيم من يعلى بن عطاء وكان صغيرا جدا وأبوه يعلى بن عطاء كبير قيل ليحيى سمع هشيم من يعلى بن عطاء حديث صخر الغامدي فقال نعم هذا مما كان سمعه هشيم فقلت ليحيى إن بعضهم يقول في حديث صخر الغامدي سمعت النبي صلى الله عليه وسلم يقول فقال يحيى لا إنما يقول صخر عن النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 4915 - (@)(@@) سمعت يحيى يقول يعلى بن عطاء رجل من أهل الطائف وكان ينزل واسطا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4916 - (@)(@@) سمعت يحيى يقول قد روى هشيم عن أبي الجودي واسمه الحارث بن عمير فلا أدري هو الذي روى عنه شعبة أم لا(@)(@@)(@@)(@@) | 4917 - (@)(@@) حدثنا يحيى قال حدثنا هشيم عن العوام بن حوشب عن عبد الجبار الخولاني قال قدم علينا رجل من أصحاب النبي صلى الله عليه وسلم دمشق فرأى ما فيه الناس يعنى من الدنيا فقال وما يغنى عنهم أليس من ورائهم الفلق قيل وما الفلق قال جب في 
ms326	 النار إذا فتح هر منه أهل النار هكذا قال يحيى هر منه أهل النار لم يقل فر منه فأستفهمته فقال هر منه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4918 - (@)(@@) سمعت يحيى يقول أبو علقمة ليس حديثه بشيء كان يكون في مسجد الجامع مسجد الرصافة لا يكاد يفارقه(@)(@@)(@@)(@@) | 4919 - (@)(@@) وأبو علقة الفروي ثقة(@)(@@)(@@)(@@) | 4920 - (@)(@@) سمعت يحيى يقول داود بن محبر ليس بكذاب قال يحيى وقد كتبت عن أبيه المحبر بن قحذم وكان داود ثقة ولكنه جفا الحديث ثم حدث(@)(@@)(@@)(@@) | 4921 - (@)(@@) سمعت يحيى يقول سمعت هشيما يحدث يوما فقال حدثنا على بن زيد ثم ذكر أنه لم يسمعه من علي بن زيد فتنحنح ثم قال سووا الطريق ثم قال قال على بن زيد(@)(@@)(@@)(@@) | 4922 - (@)(@@) سمعت يحيى يقول وسئل عن هذا الحديث وتقطعت عنا الخنف فقال الثياب الخلقان(@)(@@)(@@)(@@) | 4923 - (@)(@@) سمعت يحيى يقول كان العوام بن حوشب كوفيا نزل واسطا(@)(@@)(@@)(@@) | 4924 - (@)(@@) سمعت يحيى يقول عمرو بن ميمون كان جزريا نزل بغداد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4925 - (@)(@@) سمعت يحيى يقول حدثنا هشيم قال أنبأنا يونس عن الحسن أنه كان لا يرى بأس للمكاتب أن يتزوج(@)(@@)(@@)(@@) | 4926 - (@)(@@) سألت يحيى عن أحاديث يرويها هشيم عن مغيرة عن إبراهيم النظر في مرآة الحجام دناءة وإذا بلى المصحف دفن وأشباه هذه الأحاديث فقال سمعها هشيم من إبراهيم بن عطية الواسطي عن مغيرة قلت ليحيى إبراهيم هذا سمع من المغيرة هذه الأحاديث قال كان إبراهيم هذا لا يساوي شيئا وينبغي أن يكون قد سمع من مغيرة فهشيم إنما سمع هذه الأحاديث منه عن مغيرة وكان يقول مغيرة هكذا قال يحيى أو شبيه بهذا(@)(@@)(@@)(@@) | 4927 - (@)(@@) سمعت يحيى يقول أبو الطيب هذا من الأبناء وكان في الحراسة وكان كذابا(@)(@@)(@@)(@@) | 4928 - (@)(@@) سمعت يحيى يقول هشيم أكبر من سفيان بن عيينة بثلاث سنين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4929 - (@)(@@) سمعت يحيى يقول كان سهل بن هاشم بن بلال الحبشي واسطيا وكان ينزل الشام وقد سمع هشيم من أبيه وسمع شعبة أيضا من هاشم بن بلال وكان يكنى أبا عقيل(@)(@@)(@@)(@@) | 4930 - (@)(@@) وهشيم كنيته أبو معاوية(@)(@@)(@@)(@@) | 4931 - (@)(@@) سمعت يحيى يقول عمرو 
ms327	 بن عون الواسطي وهو عمرو بن عون بن أوس(@)(@@)(@@)(@@) | 4932 - (@)(@@) سمعت يحيى يقول كان الرجل يجىء إلى هشيم فيذاكره الحديث فيقول له هشيم كيف هو فإذا ذهب الرجل حدث به هشيم أو نحو هذا قاله أبو زكريا(@)(@@)(@@)(@@) | 4933 - (@)(@@) سمعت يحيى يقول هلال بن خباب ينزل المدائن وهو أبو العلاء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4934 - (@)(@@) سمعت يحيى يقول قال رجل من الشعر ... ألا إنما التقوى هو العز والكرم ... وحبك للدنيا هو الذل والعدم ... ... وليس على عبد تقى نقيصة ... إذا صحح التقوى وإن حاك أو حجم ...(@)(@@)(@@)(@@) | 4935 - (@)(@@) سمعت يحيى يقول سمعت يزيد بن هارون بواسط وكان امامهم فسمعته يقرأ سبح اسم ربك الأعلى فقال سبحان ربي الأعلى(@)(@@)(@@)(@@) | 4936 - (@)(@@) سمعت العباس وسمعت يزيد بن هارون بواسط يقول يقول وكان إمام مسجد يقرأ يا أيها الذين آمنوا إذا نودى للصلاة من يوم الجمعة فاسعوا إلى ذكر الله وذروا البيع ذلكمو خير لكم إن كنت تعلمون قال أبو الفضل وهذه قراءة قريش المكيين يفخمون(@)(@@)(@@)(@@) | 4937 - (@)(@@) سمعت يحيى يقول الإيمان قول وعمل يزيد وينقص(@)(@@)(@@)(@@) | 4938 - (@)(@@) سمعت يحيى وأبا خيثمة يقولان صبيح كان ينزل الخلد وكان يحدث عن عثمان بن عفان وعن عائشة أم المؤمنين وكان كذابا خبيثا(@)(@@)(@@)(@@) | 4939 - (@)(@@) سمعت يحيى يقول وأعمى كان في دار الرقيق كذاب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4940 - (@)(@@) قال يحيى والميموني محمد بن زياد الطحان قال سمعت ميمونا قال سمعت بن عباس كبرت الملائكة على آدم أربعا قال يحيى قيل له وهو في السوق هذه الأحاديث سمعتها فقال قد سمعتها وكان كذابا خبيثا(@)(@@)(@@)(@@) | 4941 - (@)(@@) قال يحيى أبو السكن كان بالمخرم وكان يقول سمعت الشعبي ولم يكن بشيء(@)(@@)(@@)(@@) | 4942 - (@)(@@) وأيوب بن مدرك لم يكن بثقة وقد كتبنا عنه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4943 - (@)(@@) سمعت يحيى يقول حديث يزيد بن هارون عن همام عن مطر عن دخيل قال يحيى وإنما هو دخيل(@)(@@)(@@)(@@) | 4944 - (@)(@@) قال يحيى وحديث يزيد بن هارون ليس بشيء عن أبي إسحاق الدوسي قال كنا مع النبي صلى الله عليه وسلم وإنما هو أبو إسحاق عن أبي هريرة(@)(@@)(@@)(@@) | 4945 - (@)(@@) سمعت يحيى يقول الهذيل بن 
ms328	 بلال ينزل المدائن وليس بشيء(@)(@@)(@@)(@@) | 4946 - (@)(@@) سمعت يحيى يقول الحارث بن أفلح روى عنه مروان ولم يكن ثقة وكان مروان ينزل عليه وكان ينزل على السيب(@)(@@)(@@)(@@) | 4947 - (@)(@@) سمعت يحيى يقول في تفسير هذا الحديث لا عقر في الإسلام ولا أسعار قال يحيى العقر شيء تصنعه الأعراب يذبحون على الماء لغير الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4948 - (@)(@@) سمعت يحيى يقول أتيت محمد بن عبيد يعنى يحيى حيث قدم بغداد وقد كنت أبطأت عنه فلما أتيته وقد كان الناس كثروا عليه فقال يحيى أبا زكريا ... وتركتني حتى إذا ... علقت أبيض كالشطن ... ... أنشأت تطلب وصلنا ... في الصيف ضيعت اللبن ... قال يحيى وقال بعضهم في هذا في الصيف ضيحت اللبن(@)(@@)(@@)(@@) | 4949 - (@)(@@) سمعت يحيى يقول الحكم بن مروان الضرير ليس به بأس(@)(@@)(@@)(@@) | 4950 - (@)(@@) وأبو الجنيد الضرير ليس بثقة(@)(@@)(@@)(@@) | 4951 - (@)(@@) وأبو يوسف المديني شيخ يحدث عن هشام بعروة ليس بثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4952 - (@)(@@) ومحمد بن الحجاج الواسطي كان يحدث بحديث يطعمني جبريل هريسة كان ينزل فصل الكرخ ليس بثقة(@)(@@)(@@)(@@) | 4953 - (@)(@@) ومحمد بن الحجاج المصفر ليس بثقة(@)(@@)(@@)(@@) | 4954 - (@)(@@) سمعت يحيى يقول في حديث إسماعيل عن قيس عن عبد الله أنه دخل عليه عثمان فقال كيف تجدك قال أجدني مردودا إلى مولاي الحق فقال عثمان هذه ظنة قال يزيد في حديثه طبت وقد أوهم يزيد(@)(@@)(@@)(@@) | 4955 - (@)(@@) سمعت يحيى يقول حدث هشيم عن الحسن بن عبيد الله ولم يدركه ولم يدرك بيانا ولم يدرك زكريا بن أبي عتيك وحدث عنه ولم يسمع من خالد بن سلمة ولم يسمع من زاذان أبي منصور بن زاذان وقد حدث عنه وحدث عن القاسم بن أبي أيوب ولم يدركه والقاسم بن أبي أيوب هو الأعرج قال يحيى وقد سمع هشيم من أيوب حديثا واحدا(@)(@@)(@@)(@@) | 4956 - (@)(@@) سمعت يحيى يقول حجاج بن دينار الواسطي روى عنه شعبة وغيره(@)(@@)(@@)(@@) | 4957 - (@)(@@) وحجاج بن أبي زينب الواسطي روى عنه هشيم ومحمد بن يزيد وغيره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4958 - (@)(@@) سمعت يحيى يقول عبيد بن القاسم كان يكون في مسجد الجامع وكانت له هيئة وكان كذابا(@)(@@)(@@)(@@) | 4959 - (@)(@@) سمعت يحيى 
ms329	 يقول شيبة بن مساور واسطي روى عنه سفيان بن حسين وعبيد الله بن عمر(@)(@@)(@@)(@@) | 4960 - (@)(@@) سمعت يحيى يقول كانت دابة تقوم في درب بن علية وتروث وإلى جنبها مخراة فجاءنا مطر فأساله في بئر فسئل بن علية عن مائها فلم ير به بأسا(@)(@@)(@@)(@@) | 4961 - (@)(@@) حدثنايحيى قال حدثنا هشيم عن أبي حرة قال أرسلنا إلى ابنة الحسن أكان الحسن يأخذ من حاجبيه إذا طالا قالت نعم(@)(@@)(@@)(@@) | 4962 - (@)(@@) سمعت يحيى يقول الحجاج بن أبي زينب واسطي وكان صيقلا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4963 - (@)(@@) سمعت يحيى يقول حرام بن عثمان أظن يحيى قال مات بالأنبار زمن أبي العباس(@)(@@)(@@)(@@) | 4964 - (@)(@@) قال يحيى أراد ربيعة يقدم العراق فقال له مالك بن أنس تحدث أهل العراق فقال ربيعة لا أحدثهم فما حدثهم بحديث قال أبو الفضل مات يعنى ربيعة بالأنبار(@)(@@)(@@)(@@) | 4965 - (@)(@@) سمعت يحيى يقول محمد بن مجيب كذاب وحدث عن جعفر بن محمد عن أبيه عن علي أن النبي صلى الله عليه وسلم قال جنبوا مساجدكم صناعكم(@)(@@)(@@)(@@) | 4966 - (@)(@@) سألت يحيى عن عبد الصمد البزاز جار معاوية بن عمرو فقال هو ثقة في الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4967 - (@)(@@) سمعت يحيى يقول سمعت أبا داود النخعي وكان عند درب البقر يقول سمعت خصيفا وخصافا ومخصفا قال يحيى وكان أكذب الناس واسمه سليمان بن عمرو(@)(@@)(@@)(@@) | 4968 - (@)(@@) سمعت يحيى يقول عامر بن صالح كان يكون عند مسجد خضير وكان ضعيف الحديث(@)(@@)(@@)(@@) | 4969 - (@)(@@) سمعت يحيى يقول الحبطي الذي كان جار السهمي ليس بشيء(@)(@@)(@@)(@@) | 4970 - (@)(@@) سمعت يحيى يقول عبد الملك بن سلام الحنفي هو مدائني ليس به بأس(@)(@@)(@@)(@@) | 4971 - (@)(@@) سمعت يحيى يقول أبو سعيد هو محمد بن مسلم بن أبي وضاح(@)(@@)(@@)(@@) | 4972 - (@)(@@) سمعت يحيى يقول كان هشيم يقول مؤثر بن عفازة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4973 - (@)(@@) سمعت يحيى يقول صحف شبابه في هذا قال في حديث ورقاء عبر الوادي قال يحيى عبر الوادي(@)(@@)(@@)(@@) | 4974 - (@)(@@) سمعت يحيى يقول قد روى يزيد بن هارون عن أبي الأشهب الكوفي وهو جعفر بن الحارث ويروى عنه محمد بن يزيد الواسطي وهو ضعيف الحديث(@)(@@)(@@)(@@) | 4975 - (@)(@@) سمعت يحيى يقول 
ms330	 قلت لعلي بن عاصم عن الجسر سمعت حديث مطرف عن الشعبي من زوج كريمته من فاسق فقد قطع رحمها فقال نعم والله لقد سمعته(@)(@@)(@@)(@@) | 4976 - (@)(@@) سمعت يحيى يقول عبد القدوس شامي ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4977 - (@)(@@) قال يحيى قال حجاج الأعور رأيت عبد القدوس في زمن أبي جعفر على باب مدينة جعفر وهو مغلق وكن لا يفتح حتى يصبح الناس جدا فجاء رجل إلى عبد القدوس وهو واقف بباب المدينة فقال له أصلحك الله الحديث الذي حدثت به أعده علي أو نحو هذا من الكلام قاله يحيى فقال لا تتخذوا شيئا فيه الروح غرضا فقال له الرجل أي شيء يعنى بهذا فقال له عبد القدوس هو الرجل يخرج من داره شبه القسطرون قلت ليحي ما يعنى بهذا قال أهل الشام يسمون الروشن والكنيف يخرج إلى خارج القسطرون(@)(@@)(@@)(@@) | 4978 - (@)(@@) سمعت يحيى يقول شيخ يقال له عمرو بن جميع كان بغداديا وقع إلى حلوان ليس بثقة ولا مأمون(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4979 - (@)(@@) وشيخ كان جارا لخلف بن سالم في المخرم يقال له عمرو بن مجمع أو جميع أيضا لم يكن به باس(@)(@@)(@@)(@@) | 4980 - (@)(@@) سمعت يحيى يقول لم يسمع هشيم من القاسم بن أبي أيوب(@)(@@)(@@)(@@) | 4981 - (@)(@@) سمعت يحيى يقول وسئل عن حديث هشيم عن علي بن زيد عن أيوب بن عبد الله اللخمي عن بن عمر قال وقع في سهمي يوم جلولاء جارية كأن عنقها إبريق فضة فما ملكت نفسي أن قبلتها والناس ينظرون فقال يحيى لم يسمعه من علي بن زيد ولم يسمع هشيم أيضا من على بن زيد حديث رأس العقل قال يحيى وقد سمع هشيم من علي بن زيد أحاديث غير هذه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4982 - (@)(@@) قال يحيى في حديث هشيم قال كان النبي صلى الله عليه وسلم وسمل إذا صلى انحرف قل يحيى انحرف هذه الكلمة ليست من حديث هشيم(@)(@@)(@@)(@@) | 4983 - (@)(@@) سمعت يحيى يقول قال أبو سلمة الخزاعي في حديث تأخذ إحداكن البعرة فتقبض وإنما هو فتفتض هذا قال معن وحجاج عن مالك فتفتض(@)(@@)(@@)(@@) | 4984 - (@)(@@) وحدث أبو سلمة 
ms331	 الخزاعي أيضا بحديث وهم حدث عن حماد بن سلمة عن ثابت عن الجارود قال حدثنا أبي بن كعب ولم يسمع الجارود من أبي بن كعب وإنما يرويه الناس عن ثابت عن الجارود أن النبي صلى الله عليه وسلم ليس فيه أبي بن كعب والجرود لم يسمع من أبي بن كعب شيئا(@)(@@)(@@)(@@) | 4985 - (@)(@@) قال أنشدنا يحيى بن معين يوما قال أبو الفضل ما أنشدنا هذا قط الا في الشتاء في يوم بارد ... يومنا يوم ديمة ... قد تطيب فيه العصايد ... ... أو روؤس قد أهريت ... هامها بالجلامد ...(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4986 - (@)(@@) رأيت يحيى بن معين قد كتب الى بعض المحدثين كتابا هذا صدره حفظك الله حفظ من رضي عنه من خلقه ورأيت يحيى كتب الى رجل حفظك الله بحفظ الإيمان واراك اتحب في جميع أمورك(@)(@@)(@@)(@@) | 4987 - (@)(@@) سألت يحيى عن حي يروى عن بن علية عن أيوب عن محمد بن سيرين عن عبد الرحمن بن بشر بن مسعود من هذا فقال يحيى هذا عبد الرحمن بن بشر بن مسعود يقال له الأزرق وأبو حصين يروى عنه(@)(@@)(@@)(@@) | 4988 - (@)(@@) سمعت يحيى يقول وقد اشترى خبزا فقال هذا لامرأة من نساء الجند أمرني زوجها أن أشتري لها زوجها غائب(@)(@@)(@@)(@@) | 4989 - (@)(@@) سمعت يحيى يقول قد روى هشام بن يوسف حديث عبد الله بن بسر قلت ليحيى من هشام بن يوسف هذا قال شيخ شامي(@)(@@)(@@)(@@) | 4990 - (@)(@@) سمعت يحيى بن معين يقول قد سمع هشيم من زكريا بن أبي مريم قلت ليحيى من زكريا بن أبي مريم قال شامي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4991 - (@)(@@) سمعت يحيى يقول حدثنا حجاج قال سمعت شريكا يقول المرجئة إعداء الله وكفى بالرافضة خبثا(@)(@@)(@@)(@@) | 4992 - (@)(@@) سمعت العباس يقول سمعت أبا عبيد يقول عاشرت الناس وكلمت أهل الكلام فما رأيت قوما أوسخ وسخا ولا أقذر ولا أضعف حجة ولا أحمق من الرافضة ولقد وليت قضاء الثغور فنفيت منهم ثلاثة رجال جهميين ورافضيا أو رافضيين وجهميا قلت مثلكم لا يساكن أهل الثغور فأخرجتهم(@)(@@)(@@)(@@) | 4993 - (@)(@@) سمعت يحيى يقول سمعت يزيد بن هارون يقول في الخرء 
ms332	 يصيب الخف قال لا بأس أن يمسحه ويصلى فيه قال أبو الفضل هذا عندنا في اليابس فأما الرطب فيغسل غسلا جيدا(@)(@@)(@@)(@@) | 4994 - (@)(@@) سمعت يحيى يقول عبد الأعلى بن أبي المساور الجرار ليس بشيء(@)(@@)(@@)(@@) | 4995 - (@)(@@) سئل يحيى عن عمر بن عون وسعدويه قال ان سعدويه أكيسهما قلت له أنا في جميع ما حدث قال نعم(@)(@@)(@@)(@@) | 4996 - (@)(@@) سئل يحيى عن أبي معمر وعن هارون بن معروف فقال أبو معمر كان أكيس من هارون(@)(@@)(@@)(@@) | 4997 - (@)(@@) سمعت يحيى يقول كثير بن مروان ضعيف وقد سمعت أنا منه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 4998 - (@)(@@) سمعت يحيى يقول قد روى هشيم عن الحكم بن عتيبة وليس هو الكبير إنما هو شيخ آخر(@)(@@)(@@)(@@) | 4999 - (@)(@@) سمعت يحيى يقول قد كان هشيم قارب الثمانين وكان أبو عوانة أكبر منه(@)(@@)(@@)(@@) | 5000 - (@)(@@) سمعت يحيى يقول كنا نلزم هشيما فربما سمعنا خمسة أحاديث وعشرة أحايث وكان إذا جاءه إنسان يريد أن يدخله أدخله من على الباب وكان يحدث بزمزم فيحدث بثمانين أو أكثر فيقومون كلهم فيكتبون ما قرأ(@)(@@)(@@)(@@) | 5001 - (@)(@@) سمعت يحيى يقول قد روى شعبة عن عمرو بن أبي حكيم الواسطي وهو أبو سعيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5002 - (@)(@@) سمعت يحيى يقول وأنشدنا هذا الشعر ... ومالي من عبد ولا من وليدة ... وإني لفي فضل من الله واسع ... ... بنعمة ربي ما أريد معيشة ... سوى قصد حال من معيشة قانع ... ... ومن يجعل الرحمن في قلبه الرضا ... يعش في غنى من طيب العيش واسع ... ... إذا كان ديني ليس فيه غميزة ... ولم أشره في بعض تلك المطامع ... ... ولم أبتع الدنيا بدين أبيعه ... وبائع دين الله من شر بائع ... ... ولم تشتملني مرديات من الهوى ... ولم أتخشع لامرىء ذي بضائع ... ... جموع لشر المال من غير حله ... ضنين بقول الحق للزور راتع ... قال يحيى بن معين كنت أظن أن هذا الشعر قاله العمري العابد حتى قال لي بن العمري العابد هذا قاله عبد الله بن إدريس(@)(@@)(@@)(@@) | 5003 - (@)(@@) أنشدنا يحيى بن معين هذا الشعر ... المال ينفد حله وحرامه ... يوما ويبقى في غد آثامه ... ... ليس التقى بمتق في دينه ... حتى 
ms333	 يطيب شرابه وطعامه ... ... ويطيب ما يحوي ويكسب أهله ... ويطيب في حسن الحديث كلامه ... ... نطق النبي به لنا عن ربه ... فعلى النبي صلاته وسلامه ...(@)(@@)(@@)(@@) | 5004 - (@)(@@) سمعت يحيى يقول أبو كامل اسمه مظفر بن مدرك وهو من الأبناء يعنى يحيى بن معين أنه من أهل خراسان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5005 - (@)(@@) سمعت يحيى يقول حديث الصدقات حديث سفيان بن حسين عن الزهري عن سالم عن بن عمر عن النبي صلى الله عليه وسلم قال يحيى بن معين هذا حديث مرسل إنما يرويه يونس وغيره عن رجل من ولد عبد الله بن عمر ليس هو سالما إنما رواه مرسلا(@)(@@)(@@)(@@) | 5006 - (@)(@@) سمعت يحيى يقول حماد بن دليل أبو زيد قاضي الدائن وكان ثقة(@)(@@)(@@)(@@) | 5007 - (@)(@@) سمعت يحيى يقول عبد الملك بن مسلم كنيته أبو سلام وهو مدائني روى عنه يزيد بن هارون ووكيع بن الجراح وليس بن بأس(@)(@@)(@@)(@@) | 5008 - (@)(@@) سمعت يحيى يقول قد روى يزيد بن هارون هذا الحديث قال كنا مع عمر بالدف من جندان واوهم فيه يزيد إنما هو كنا مع عمر بالدف من جمدان بالميم(@)(@@)(@@)(@@) | 5009 - (@)(@@) سمعت يحيى يقول قد روى يونس بن محمد وغيره عن شيخ مكي يقال له أيوب بن ثابت يروى عن خالد بن كيسان ال رأيت بن عمر مرق عليه طائر ويقال مزق عليه طائر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5010 - (@)(@@) سمعت يحيى يقول قال يزيد بن هارون عن دخيل قال يحيى فقلت من دخيل فقال يزيد بن هارون إنا لله وقعنا(@)(@@)(@@)(@@) | 5011 - (@)(@@) سمعت يحيى يقول كان ها هنا رجل يقال له يحيى من ولد بن أبي بردة كان على السيب وقد سمعت منه وهو ضعيف الحديث قلت ليحيى بريد كيف هو قال ليس به بأس(@)(@@)(@@)(@@) | 5012 - (@)(@@) سمعت يحيى يقول كان شيخ عند درب أبي الطيب يروى عنه الأوزاعي وكان يقول حدثنا أبو عمرو رحمه الله فذهبنا إليه واختلفنا إليه فقعدنا يوما في الشمس فذهبنا ننظر فإذا في أعلى الصحيفة حدثنا إسماعيل بن عبد الله بن سماعه عن الأوزاعي قال فطرحنا صحيفته وتركناه وكانت كنيته أبو قتادة 
ms334	 وليس هو أبو قتادة الحراني كان رجلا آخر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5013 - (@)(@@) سمعت يحيى يقول في حديث حماد بن سلمة عن عبد الله بن شداد عن أبي عذرة قال يحيى عبد الله بن شداد هذا من أهل واسط من التجار(@)(@@)(@@)(@@) | 5014 - (@)(@@) سمعت يحيى قول قد روى هشيم عن صبيح وهو أبو الجهم وليس هو أبو الجهم الذي يروى عنه حديث الزهري حديث امرئ القيس(@)(@@)(@@)(@@) | 5015 - (@)(@@) سمعت يحيى يقول يزيد بن خمير شامي قدم عليهم واسطا(@)(@@)(@@)(@@) | 5016 - (@)(@@) سمعت يحيى يقول قال هشيم رأيت إسماعيل بن أي خالد يأتي مجالدا ومعه سكرجة يستطعم منه كامخا(@)(@@)(@@)(@@) | 5017 - (@)(@@) سمعت يحيى يقول عبد الحكيم بن مصور واسطي ليس حديثه بشيء(@)(@@)(@@)(@@) | 5018 - (@)(@@) سألت يحيى عن أبي بكر الداهري الذي يحدث عنه عمرو بن عون الواسطي فقال ليس حديثه بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5019 - (@)(@@) سمعت يحيى يقول حدثنا هشيم عن أيوب قال يحيى قد سمع منه حديثا أو حديثين وقد سمع هشيم من هلال بن خباب(@)(@@)(@@)(@@) | 5020 - (@)(@@) سمعت يحيى يقول قد سمع هشيم من عبد الله بن أبي طلة الخزاعي ولم نسمع أحدا يحدث عنه غير هشيم(@)(@@)(@@)(@@) | 5021 - (@)(@@) سمعت يحيى يقول اصبغ بن يزيد واسطي وهو ثقة فقلت ليحيى كنت أرى أن أصبغ بن زيد ضعيف فقال هو ثقة(@)(@@)(@@)(@@) | 5022 - (@)(@@) سألت يحيى عن حديث ورقاء بن عمر أنه كان يقول في أولها عن بن أبي نجيح عن مجاهد فقيل له ترى بأسا أن يخرجها إنسان فيكتب في كل حديث ورقاء عن بن أبي نجيح عن مجاهد قال وليس به بأس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (تسمية الشاميين وأهل مصر والجزيرة)(@)(@@)(@@)(@@) | 5023 - (@)(@@) سمعت يحيى يقول أبو فروة الجزري اسمه يزيد بن سنان وقد روى الكوفيون عنه وليس بثقة(@)(@@)(@@)(@@) | 5024 - (@)(@@) سمعت يحيى يقول مروان بن شجاع ثقة(@)(@@)(@@)(@@) | 5025 - (@)(@@) سمعت يحيى يقول الإفريقي ليس به بأس وفيه ضعف وهو أحب إلى من أبي بكر بن أبي مريم الغساني(@)(@@)(@@)(@@) | 5026 - (@)(@@) سمعت يحيى يقول عفيف بن سالم الموصلي ثقة(@)(@@)(@@)(@@) | 5027 - (@)(@@) سمعت يحيى يقول عمر بن أيوب الموصلي ثقة(@)(@@)(@@)(@@) | 5028 - (@)(@@) سمعت يحيى يقول الفرات 
ms335	 بن سلمان ثقة(@)(@@)(@@)(@@) | 5029 - (@)(@@) سمعت يحيى يقول المغيرة بن زياد الموصلي ثقة(@)(@@)(@@)(@@) | 5030 - (@)(@@) سمعت يحيى يقول عبد الله بن العلاء أبو زبر ثقة(@)(@@)(@@)(@@) | 5031 - (@)(@@) سمعت يحيى يقول شعيب بن إسحاق الدمشقي ثقة(@)(@@)(@@)(@@) | 5032 - (@)(@@) سمعت يحيى يقول إسماعيل بن عياش ثقة(@)(@@)(@@)(@@) | 5033 - (@)(@@) سمعت يحيى يقول النضر بن عربي ثقة(@)(@@)(@@)(@@) | 5034 - (@)(@@) سمعت يحيى يقول زيد بن أبي أنيسة ثقة(@)(@@)(@@)(@@) | 5035 - (@)(@@) سمعت يحيى يقول عمرو بن أي قيس ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5036 - (@)(@@) سمعت يحيى يقول النعمان بن راشد ثقة(@)(@@)(@@)(@@) | 5037 - (@)(@@) سمعت يحيى يقول عبد الله بن وهب المصري ثقة(@)(@@)(@@)(@@) | 5038 - (@)(@@) سمعت يحيى يقول حفص بن ميسرة ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5039 - (@)(@@) سمعت يحيى يقول وسئل عن حديث دراج عن أبي الهيثم عن أي سعيد فقال ما كان هكذا الإسناد فليس به بأس فقلت له إن دراجا يحدث عن أبي الهيثم عن أبي سعيد عن النبي صلى الله عليه وسلم قال أصدق الرؤيا بالأسحار ويروى أيضا اذكروا الله حتى يقولوا مجنون فقال هما ثقتان دراج وأبو الهيثم قال يحيى وقد روى هذه الأحاديث عمر بن الحارث قلت ليحيى دراج من هو قال مصري وهو أبو السمح قلت ليحيى أبو الهيثم من هو قال مصري واسمه سليمان بن عمرو(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5040 - (@)(@@) سألت يحيى عن هؤلاء الشيوخ فزعم أن حديثهم ليس بشيء عنبسة بن عبد الرحمن الذي يروى عنه الوليد بن مسلم وغيره وهو الذي يحدث عن محمد بن زاذان والفرات بن السائب وحمزة النصيبي وأبو العطوف الجزري ومحمد بن سعيد أبي سعيد ومحمد المحرم ورشدين بن سعد والموقري ووزير الذي يحدث بحديث معاوية أن النبي صلى الله عليه وسلم أعطاه سهما(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5041 - (@)(@@) حدثنا العباس قال حدثنا وضاح بن حسان الأنباري العابد قال حدثنا وزير بن عبد الله عن غالب بن عبيد الله الجزري عن عطاء بن أبي رباح عن أبي هريرة عن النبي صلى الله عليه وسلم أعطى معاوية سهما وقال هاك هذا يا معاوية حتى توافيني به في الجنة(@)(@@)(@@)(@@) | 5042 - (@)(@@) سمعت يحيى يقول يحيى بن أبي أنيسة ليس بشيء(@)(@@)(@@)(@@) | 5043 
ms336	 - (@)(@@) سمعت يحيى يقول إذا لم يسم بقية الرجل الذي يروى عنه وكناه فاعلم أنه لا يساوي شيئا(@)(@@)(@@)(@@) | 5044 - (@)(@@) سمعت يحيى سئل عن سويد الدمشقي فقال ليس حديثه بشيء(@)(@@)(@@)(@@) | 5045 - (@)(@@) سمعت يحيى يقول عمر بن راشد ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5046 - (@)(@@) سألت يحيى عن حديث ثور عن يزيد بن يزيد بن جابر عن مكحول عن يزيد بن جابر عن أبي هريرة يجزئ من الستر مثل مؤخرة الرحل فقال هذا مستقيم الإسناد هكذا يحدث ثور به(@)(@@)(@@)(@@) | 5047 - (@)(@@) سمعت يحيى يقول عمرو بن شعيب أبو إبراهيم(@)(@@)(@@)(@@) | 5048 - (@)(@@) سمعت يحيى يقول قد سمع سعيد بن عبد العزيز من الزهري(@)(@@)(@@)(@@) | 5049 - (@)(@@) سمعت يحيى يقول قد سمع سفيان بن عيينة من الوليد بن هشام المعيطي وسمع سفيان أيضا من يحيى بن يحيى الغساني وسمع أيضا من يزيد بن يزيد بن جابر وسمع أيضا من عبد الكريم بن مالك وسمع أيضا من خصيف(@)(@@)(@@)(@@) | 5050 - (@)(@@) سمعت يحيى يقول الوليد بن أبي هشام أخو أبي المقدام هشام بن زياد لأمه وكانوا موالي عثمان بن عفان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5051 - (@)(@@) سمعت يحيى يقول أبو ماوية مالك بن حريث وقد سمع شهاب بن خراش من أبي ماوية(@)(@@)(@@)(@@) | 5052 - (@)(@@) سمعت يحيى يقول زياد بن سعد صاحب الزهري خراساني نزل مكة(@)(@@)(@@)(@@) | 5053 - (@)(@@) سمعت يحيى يقول يزيد بن يوسف شامي وليس بثقة روى عن حسان بن عطية(@)(@@)(@@)(@@) | 5054 - (@)(@@) سمعت يحيى يقول أبو سعد الرعيني جعيد(@)(@@)(@@)(@@) | 5055 - (@)(@@) سمعت يحيى يقول كان يزيد بن أبي مالك قاضيا بالشام(@)(@@)(@@)(@@) | 5056 - (@)(@@) سمعت يحيى يقول صدقة بن خالد ثقة(@)(@@)(@@)(@@) | 5057 - (@)(@@) وصدقة السمين ضعيف(@)(@@)(@@)(@@) | 5058 - (@)(@@) سمعت يحيى يقول مغيث بن سمى شامي(@)(@@)(@@)(@@) | 5059 - (@)(@@) سمعت يحيى يقول وصدقة بن يزيد الدمشقي صالح الحديث(@)(@@)(@@)(@@) | 5060 - (@)(@@) سمعت يحيى يقول أبو زكريا مريح بن مسروق شامي(@)(@@)(@@)(@@) | 5061 - (@)(@@) سمعت يحيى يقول الوليد بن مسلم روى عن خالد بن يزيد بن صالح بن صبيح(@)(@@)(@@)(@@) | 5062 - (@)(@@) سمعت يحيى يقول إبراهيم بن أدهم رجل من العرب من بنى عجل(@)(@@)(@@)(@@) | 5063 - (@)(@@) سمعت يحيى يقول ذو الكلاع يكنى أبا شرحبيل(@)(@@)(@@)(@@) | 5064 - (@)(@@) سمعت يحيى يقول يزيد 
ms337	 بن أبي حبيب يكنى أبا رجاء وأبو حبيب اسمه سويد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5065 - (@)(@@) سمعت يحيى يقول أبو عبد الرحمن الحبلى يروى عن عمرو بن حريث المصري وعمرو هذا لم يسمع من النبي صلى الله عليه وسلم شيئا(@)(@@)(@@)(@@) | 5066 - (@)(@@) سمعت يحيى يقول روى حجاج عن الوليد بن أبي مالك وهو شامي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5067 - (@)(@@) سمعت يحيى يقول كان جعفر بن برقان أميا لا يقرأ ولا يكتب وكان رجل صدق(@)(@@)(@@)(@@) | 5068 - (@)(@@) سمعت يحيى بن معين يقول اسم أبي مرحوم يحيى بن ميمون وهو مصري يروى عنه يحيى بن أيوب(@)(@@)(@@)(@@) | 5069 - (@)(@@) سمعت يحيى يقول سمعت على بن عياش يقول سمعت حريز بن عثمان يقول لرجل ويحك تزعم أني أشتم علي بن أبي طالب والله ما شتمت عليا قط(@)(@@)(@@)(@@) | 5070 - (@)(@@) سمعت يحيى يقول محمد بن عبد الله الشعيثي وهو محمد بن المهاجر(@)(@@)(@@)(@@) | 5071 - (@)(@@) سمعت يحيى يقول لم يسمع الأوزاعي من نافع وقد سمع الأوزاعي من عطاء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5072 - (@)(@@) حدثنا يحيى بن معين قال حدثني خزيمة بن زرعة الخراساني عن أبي حفص التنيسي عن عبد الله بن العلاء أبي زبر عن القاسم أبي عبد الرحمن عن أبي أمامة أن رسول الله صلى الله عليه وسلم قال اسم الله الأعظم في ثلاث سور في البقرة وآل عمران وطه قال وعنده عيسى بن موسى فقال حدثني غيلان بن أنس عن القاسم أبي عبد الرحمن عن أبي أمامة عن النبي صلى الله عليه وسلم قال اسم الله الأعظم في ثلاث سور سورة البقر وآل عمران وطه(@)(@@)(@@)(@@) | 5073 - (@)(@@) سمعت يحيى يقول محرز أبو رجاء الذي يروى عنه الكوفيون وهو شامي(@)(@@)(@@)(@@) | 5074 - (@)(@@) سمعت يحيى يقول عثمان بن أبي العاتكة كنيته أبو حفص وكان قاص دمشق وليس بالقوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5075 - (@)(@@) سمعت يحيى يقول عبد الرحمن بن زياد بن أنعم ليس به بأس وفيه ضعف قيل ليحيى هو أحب إليك أو بكر بن عبد الله بن أبي مريم قال هو فرددت أنا على يحيى فقلت هو أحب إليك من أبي بكر بن عبد الله بن أبي مريم الغساني 
ms338	 قال نعم(@)(@@)(@@)(@@) | 5076 - (@)(@@) سمعت يحيى يقول ركن الذي يروى عنه أبو عمرو الشيباني ليس بثقة(@)(@@)(@@)(@@) | 5077 - (@)(@@) سمعت يحيى يقول رأيت عبد الله بن وهب يعرض له على عبد الله بن رجاء(@)(@@)(@@)(@@) | 5078 - (@)(@@) سمعت يحيى يقول رأيت عبد الله بن وهب يعرض له على سفيان بن عيينة وهو قاعد ينعس أو قال يحيى وهو نائم(@)(@@)(@@)(@@) | 5079 - (@)(@@) قلت ليحيى إنهم يقولون إن عبد الله بن وهب قال لسفيان بن عيينة السماع الذي كان أول من أمس أجزه لي فقال يحيى أنا سمعته يقول لسفيان يعنى هذا(@)(@@)(@@)(@@) | 5080 - (@)(@@) سمعت يحيى يقول فرات بن السائب جزري ليس بشيء(@)(@@)(@@)(@@) | 5081 - (@)(@@) وفرات بن سلمان ثقة(@)(@@)(@@)(@@) | 5082 - (@)(@@) وفرات بن مسلم وهو أبو نوفل بن فرات وهو رقى وهو ثقة(@)(@@)(@@)(@@) | 5083 - (@)(@@) سمعت يحيى يقول اسم أبي إدريس عائذ الله(@)(@@)(@@)(@@) | 5084 - (@)(@@) سمعت يحيى يقول أيوب بن سويد شامي وليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5085 - (@)(@@) سمعت يحيى يقول قد روى إسماعيل بن عياش عن أبي رافع وهو إسماعيل بن رافع(@)(@@)(@@)(@@) | 5086 - (@)(@@) سمعت يحيى يقول أبو سلمة الحمصي سليمان بن سليم وهو ثقة(@)(@@)(@@)(@@) | 5087 - (@)(@@) سمعت يحيى يقول سعيد بن سنان أبو المهدي ليس بثقة(@)(@@)(@@)(@@) | 5088 - (@)(@@) سمعت ييحيى يقول عفير بن معدان ليس بثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5089 - (@)(@@) سمعت يحيى يقول أزهر الحرازي وأسد بن وداعة وجماعة كانوا يجلسون يشتمون علي بن أبي طالب وكان ثور بن يزيد في ناحية لا يسب عليا فإذا لم يسب جروا برجله(@)(@@)(@@)(@@) | 5090 - (@)(@@) سمعت يحيى يقول عبد الله بن أبو زكريا أيو زكريا أبوه وكان اسمه إياس بن زيد(@)(@@)(@@)(@@) | 5091 - (@)(@@) سمعت يحيى يقول قد حدث بقية بن الوليد عن عمر بن موسى الوجيهى وليس بثقة(@)(@@)(@@)(@@) | 5092 - (@)(@@) سمعت يحيى يقول بن ثوبان أصله خراساني نزل الشام وما ذكره إلا بخير(@)(@@)(@@)(@@) | 5093 - (@)(@@) سمعت يحيى يقول شعيب بن أبي حمزة هو مولى زياد وكان اسم أبيه دينار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5094 - (@)(@@) سمعت يحيى يقول قد روى سفيان الثوري عن حفص بن ميسرة الصنعاني وكنيته أبو عمر وكان ينزل عسقلان(@)(@@)(@@)(@@) | 5095 - (@)(@@) سمعت يحيى يقول أبو الهيثم الذي يروى عن 
ms339	 أبي سعيد اسمه سليمان بن عمرو وهو ثقة(@)(@@)(@@)(@@) | 5096 - (@)(@@) سمعت يحيى يقول أبو مسلم الخولاني اسمه عبد الله بن ثوب(@)(@@)(@@)(@@) | 5097 - (@)(@@) سمعت يحيى يقول خصيف يروى عن سعد أبي هاشم وسعد هذا هو السنجاري(@)(@@)(@@)(@@) | 5098 - (@)(@@) سمعت يحيى يقول أبو معيد حفص بن غيلان صاحب مكحول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5099 - (@)(@@) سمعت يحيى يقول محمد بن درهم شامي ليس به بأس حدث عنه إسماعيل بن عياش(@)(@@)(@@)(@@) | 5100 - (@)(@@) سمعت يحيى يقول قد سمع أبو إدريس الخولاني من أبي الدرداء أوس بن شداد بن أوس ومن عبادة بن الصامت ومن أبي ثعلبة الخشني قال وفاتني معاذ بن جبل(@)(@@)(@@)(@@) | 5101 - (@)(@@) سمعت يحيى يقول خالد بن يزيد أبي مالك ليس بشيء(@)(@@)(@@)(@@) | 5102 - (@)(@@) سمعت يحيى يقول رواد أبو عصام ليس به بأس إنما غلط في حديث سفيان الثوري(@)(@@)(@@)(@@) | 5103 - (@)(@@) سمعت يحيى يقول يزيد بن يوسف كان شاميا نزل علي أبي عبيد الله كان يحدث عن القاسم بن مخيمرة وقد حدث عنه الوليد بن مسلم وليس هو بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5104 - (@)(@@) سمعت يحيى يقول شهاب بن خراش وقد روى عن أبي ماوية فقيل ليحيى من أبو ماوية هذا قال رجل(@)(@@)(@@)(@@) | 5105 - (@)(@@) سمعت يحيى يقول ليث بن سعد كنيته أبو الحارث(@)(@@)(@@)(@@) | 5106 - (@)(@@) سمعت يحيى يقول مطرح بن يزيد هو أبو المهلب ليس بثقة(@)(@@)(@@)(@@) | 5107 - (@)(@@) وعبيد الله بن زحر ليس بشيء(@)(@@)(@@)(@@) | 5108 - (@)(@@) سمعت يحيى يقول جابر بن يزيد بن رفاعة كان موصليا يروى عنه بن مهدي وعفان وهو يروى عن مجاهد(@)(@@)(@@)(@@) | 5109 - (@)(@@) سمعت يحيى يقول عبد العزيز بن عمر بن عبد العزيز ثقة(@)(@@)(@@)(@@) | 5110 - (@)(@@) سمعت يحيى يقول محمد بن سعيد الشامي منكر الحديث وليس هو كما قالوا صلب في الزندقة ولكنه منكر الحديث وله أخ يقال له عبد الرحيم بن سعيد الأبرص وقد سمعنا منه ببغداد وكان يروى عن الزهري قال يحيى وقد سمع مروان بن معاوية من محمد بن سعيد هذا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5111 - (@)(@@) سمعت يحيى يقول قد حدث مروان عن محمد بن أبي قيس قلت ليحيى محمد بن أبي قيس هذا هو محمد بن سعيد 
ms340	 فقال لا أخبرني رجل من أهل الشام أن محمد بن أبي قيس ليس هو محمد بن سعيد هو رجل آخر(@)(@@)(@@)(@@) | 5112 - (@)(@@) سمعت يحيى يقول محمد بن مهاجر الذي يروى عنه أبو توبة هو أخو عمرو بن مهاجر صاحب عمر بن عبد العزيز(@)(@@)(@@)(@@) | 5113 - (@)(@@) سمعت يحيى يقول نوف شامي وقد كان نزل الكوفة(@)(@@)(@@)(@@) | 5114 - (@)(@@) سمعت يحيى يقول كثير بن مروان شامي ليس بشيء(@)(@@)(@@)(@@) | 5115 - (@)(@@) سمعت يحيى يقول الحكم بن حزن الكلفى يقال إنه من بنى نصر(@)(@@)(@@)(@@) | 5116 - (@)(@@) سمعت يحيى يقول عطاء الخراساني هو عطاء بن أبي مسلم(@)(@@)(@@)(@@) | 5117 - (@)(@@) سمعت يحيى يقول الحكم بن عمرو الرعيني ضعيف(@)(@@)(@@)(@@) | 5118 - (@)(@@) سمعت يحيى يقول غالب بن عبيد الله العقيلي ضعيف(@)(@@)(@@)(@@) | 5119 - (@)(@@) سمعت يحيى يقول الوليد بن عمرو بن ساج ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5120 - (@)(@@) سمعت يحيى يقول القاسم بن عبد الرحمن الذي يروى عن أبي أمامة ثقة(@)(@@)(@@)(@@) | 5121 - (@)(@@) سمعت يحيى يقول شرحبيل بن مسلم ثقة(@)(@@)(@@)(@@) | 5122 - (@)(@@) وإبراهيم بن أبي عبلة ثقة(@)(@@)(@@)(@@) | 5123 - (@)(@@) وعتبة بن أبي حكيم ثقة(@)(@@)(@@)(@@) | 5124 - (@)(@@) ومحمد بن زياد الألهاني ثقة(@)(@@)(@@)(@@) | 5125 - (@)(@@) وحريز بن عثمان الرحبي ثقة(@)(@@)(@@)(@@) | 5126 - (@)(@@) سمعت يحيى يقول زرعة بن إبراهيم صالح الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5127 - (@)(@@) سمعت يحيى يقول عبد العزيز بن عبيد الله بن حمزة بن صهيب وحميد بن مالك اللخمي ضعيفان لم يحدث عنهما إلا إسماعيل بن عياش(@)(@@)(@@)(@@) | 5128 - (@)(@@) سمعت يحيى يقول عطاء بن عجلان ضعيف(@)(@@)(@@)(@@) | 5129 - (@)(@@) سمعت يحيى يقول عيسى بن سنان ضعيف(@)(@@)(@@)(@@) | 5130 - (@)(@@) سمعت يحيى يقول تمام بن نجيح ثقة(@)(@@)(@@)(@@) | 5131 - (@)(@@) وجعفر بن الزبير ضعيف(@)(@@)(@@)(@@) | 5132 - (@)(@@) سمعت يحيى يقول موسى بن أيوب الغافقي ثقة(@)(@@)(@@)(@@) | 5133 - (@)(@@) ومحمد بن مهاجر ثقة(@)(@@)(@@)(@@) | 5134 - (@)(@@) ومعاذ بن رفاعة ضعيف(@)(@@)(@@)(@@) | 5135 - (@)(@@) وخالد بن يزيد بن أبي مالك ضعيف(@)(@@)(@@)(@@) | 5136 - (@)(@@) سمعت يحيى يقول معمر بن سليمان الرقي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5137 - (@)(@@) سمعت يحيى يقول عبد الرحمن بن يزيد بن جابر أكبر من أخيه يزيد بن يزيد بن جابر وبقى بعده وهو أكبرهما(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 5138 - (@)(@@) سمعت يحيى يقول محمد بن مسلم بن أبي الوضاح وهو جزري كان مؤدب موسى أمير المؤمنين قبل 