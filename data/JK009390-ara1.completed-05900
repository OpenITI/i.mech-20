ms5881	 عافه | رسول الله صلى الله عليه وسلم ' . ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 9966 - عن أبي سعيد رضي الله عنه : ' أن رسول الله صلى الله عليه وسلم قال : ضلت أمة من | بني إسرائيل فأرهب أن تكون الضباب ' ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 9967 - عن أبي سعيد رضي الله عنه : ' أن رسول الله صلى الله عليه وسلم سئل عن الضب ؟ | فقال : أمة مسخت فأرهب أن تكون هذه فالله أعلم ' . ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 9968 - عن أبي سعيد رضي الله عنه قال : ' أتي النبي صلى الله عليه وسلم بضب ، فقال : إنا | بأرض مضبة فما تأمرنا ؟ فقال رسول الله صلى الله عليه وسلم : بلغني أن أمة من بني إسرائيل | مسخت دواب ، فلا أدري أي الدواب هي ؟ فلم يأمر ولم ينه ' . ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 9969 - عن أبي سعيد رضي الله عنه : ' أن رجلا أتى النبي صلى الله عليه وسلم فقال : أصوم | الدهر ، فنهاه ' . ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 9970 - عن أبي إدريس الخولاني : ' أنه سمع أبا هريرة وأبا سعيد الخدري | رضي الله عنهما يقولان : من توضأ فليستنثر ، ومن استجمر فليوتر ' . ( ص ) . |(@)(@@)(@@)(@@) $ 9971 - عن أبي سعيد رضي الله عنه قال : ' من توضأ فقال حين يفرغ من | وضوئه : سبحانك اللهم وبحمدك ، أشهد أن لا إله إلا أنت ، أستغفرك وأتوب إليك ، | كتب في رق ثم طبع عليه بطابع تحت العرش فلا يفض إلى يوم القيامة ' . ( ض ) . |(@)(@@)(@@)(@@) $ 9972 - عن أبي سعيد رضي الله عنه : عن النبي صلى الله عليه وسلم أنه قال : ' لقد اهتز العرش | لموت سعد ' . ( ش ) . |(@)(@@)(@@)(@@) $ 9973 - عن أبي سعيد رضي الله عنه يبلغ به النبي صلى الله عليه وسلم قال : ' إذا أراد - يعني | PageV17P259 | الجنب - أن يعود فلا يعود حتى يتوضأ ' . |(@)(@@)(@@)(@@) $ 9974 - عن أبي سعيد الخدري رضي الله عنه قال : ' الجنب إذا أراد أن ينام | أو يأكل فليتوضأ ' . ( ض ) . |(@)(@@)(@@)(@@) $ 9975 - عن أبي سعيد رضي الله عنه قال : ' نزل أهل قريظة على حكم | سعد بن أبي معاذ ، فأرسل رسول الله صلى الله عليه وسلم إلى سعد ، فأتاه على حمار ، فلما أن دنا | قريبا من المسجد ، قال رسول الله صلى الله 
ms5882	 عليه وسلم : قوموا إلى سيدكم أو خيركم ، ثم قال : إن | هؤلاء قد نزلوا على حكمك ، فيقتل مقاتلهم ، ويسبى ذراريهم ، فقال رسول | الله صلى الله عليه وسلم : قضيت بحكم الشرع وربما قال : قضيت بحكم الله تعالى ' . ( ش ) . |(@)(@@)(@@)(@@) $ 9976 - عن أبي بصير العبدي قال : ' دخلنا على أبي سعيد الخدري رضي | الله عنه فسألنا عن العرب ، فقال : أسرنا كرائم العرب ، أسرنا نساء بني المصطلق | فأردنا العزل ، ورغبنا في الفداء فقال رسول الله صلى الله عليه وسلم : لا عليكم أن لا تفعلوا ، فإنه | ليس من نسمة كتب الله تعالى عليها أن تكون إلى يوم القيامة إلا وهي كائنة ' . |(@)(@@)(@@)(@@) $ 9977 - عن أبي سعيد رضي الله عنه قال : ' لم يزل رسول الله صلى الله عليه وسلم في وجعه ، | إذا وجد خفة خرج ، وإذا ثقل وجاء المؤذن قال : مروا أبا بكر يصلي بالناس ، فخرج | من عنده يوما الأمر يأمر الناس يصلون وابن أبي قحافة غائب ، فصلى عمر رضي الله | عنه بالناس فلما كبر ، قال رسول الله صلى الله عليه وسلم : لا ، لا ! أبي قحافة ، فالتصقت | الصفوف ، وانصرف عمر ، فما برحنا حتى طلع ابن أبي قحافة وكان بالشيح فتقدم | فصلى بالناس ' . ( الواقدي ) . |(@)(@@)(@@)(@@) $ 9978 - عن أبي سعيد رضي الله عنه قال : ' رأيت رسول الله صلى الله عليه وسلم ذات ليلة من | أول الليل إلى أن طلع الفجر رافعا يديه يدعو لعثمان بن عفان يقول : اللهم رضيت | عنه فارض عنه ' . ( كر ) . | PageV17P260 |(@)(@@)(@@)(@@) $ 9979 - عن أبي سعيد رضي الله عنه قال : ' سمعت رسول الله صلى الله عليه وسلم يقول | لعثمان رضي الله عنه : غفر الله تعالى لك ما قدمت وما أخرت ، وما أسررت وما | أعلنت ، وما كان منك وما هو كائن إلى يوم القيامة ' . ( كر ) . |(@)(@@)(@@)(@@) $ 9980 - عن أبي سعيد رضي الله عنه قال : ' قال رسول الله صلى الله عليه وسلم : ' لا تقوم | الساعة حتى يقتتل فئتان عظيمتان دعواهما واحدة ، فبينما هم كذلك إذ مرقت منهم | مارقة ، تقتلهم أولى الطائفتين بالحق ' . ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 9981 - عن أبي سعيد رضي الله عنه قال : ' سألنا رسول 
ms5883	 الله صلى الله عليه وسلم عن الجنين ؟ | فقال : كلوه إن شئتم ، ذكاته ذكاة أمه ' . |(@)(@@)(@@)(@@) $ 9982 - عن أبي سعيد رضي الله عنه عن أبي عفان ، عن النبي صلى الله عليه وسلم قال : ' يا | رب ! عثمان بن عفان رضيت عنه فارض عنه ، فما زال يدعو رافعا يديه حتى طلع | الفجر ' . ( كر ) . |(@)(@@)(@@)(@@) $ 9983 - عن أبي سعيد رضي الله عنه عن الحارث بن محمد ، عمن حدثه ، | عن رجل يكنى بأبي سعيد قال : ' قدمت من العالية إلى المدينة ، فما بلغت حتى | أصابني جهد ، فبينا أنا أسير في سوق من أسواق المدينة سمعت رجلا يقول | لصاحبه : إن رسول الله صلى الله عليه وسلم قري الليلة ، فلما سمعت ذكر القرى وفي جهد ، أتيت | رسول الله صلى الله عليه وسلم ، فقلت : يا رسول الله ! بلغني أنك قريت الليلة ، قال : أجل ، قال : | وما ذاك ؟ قال طعام فيه مسخنة ، قلت : فما فعل فضله ؟ قال : رفع ، قلت : يا رسول | الله ! أفي أمتك يكون موتا أو آخرها ، قال : في أولها ، ثم يكون إفناء - يعني بعضكم | بعضا - ' . ( ابن منده ) . |(@)(@@)(@@)(@@) $ 9984 - عن أبي سعيد ، عن أبي هياج ، عن أبيه ، عن أبي سفيان : ' أن أمية بن | أبي الصلت كان معه بقرة ، فقال : يا أبا سفيان ! أتعرف عتبة بن ربيعة ؟ قال : كريم | PageV17P261 | الطرفين ، ويجتنب المظالم أو المحارم ، وشريف مسن ، قال : كنت أجد في كتبي | نبيا يبعث من حرتنا هذه ، فكنت أظن أني هو ، فلما دارست أهل العراق ، إذا هو من | بني عبد مناف ، فنظرت في بني عبد مناف ، فلم أجد أحدا يصلح لهذا الأمر غير | عتبة بن ربيعة ، فلما أخبرتني بسنه عرفت أنه ليس به حين جاوز الأربعين ولم يوح | إليه ، قال أبو سفيان : فضرب الدهر من ضربة وأوحي إلى رسول الله صلى الله عليه وسلم ، وخرجت | في ركب من قريش أريد اليمن في تجارة ، فمررت بأمية بن أبي الصلت ، فقلت له | كالمستهزئ به : يا أمية ! قد خرج النبي الذي قد كنت تنتظر ، قال : أما إنه حق تنتظره | فاتبعه ، قلت : ما يمنعك من اتباعه ؟ قال : ما 
ms5884	 يمنعني إلا الاستحياء من نساء ثقيف ، | إني كنت أحدثهم أني هو ، ثم يرونني تابعا لغلام من بني عبد مناف ثم قال أمية : | وكأني بك يا أبا سفيان ! إن خالفته قد ربطت كما يربط الجدي ، حتى يؤتى بك إليه | فيحكم فيك بما يريد ' . ( كر ) . |(@)(@@)(@@)(@@) $ 9985 - عن أبي سعيد رضي الله عنه ، عن أبي هياج ، عن أبيه ، عن أبي | سفيان بن الحارث قال : ' اليوم علمت أن العباس رضي الله عنه سيد العرب بعد | رسول الله صلى الله عليه وسلم ، وأنه أعظم الناس منزلة عند رسول الله صلى الله عليه وسلم حين أحضره قريش | بأصلها ، فقال : إن قتلوه لا أستبقي منهم أحدا أبدا ، وقال في حمزة حين قتل ومثل | به : لئن بقيت ، لأمثلن بثلاثين من قريش ، وقال المكثر : بسبعين ' . ( كر ) . |(@)(@@) | ( 56 - أبو سعيد الزرقي الأنصاري رضي الله عنه )(@)(@@)(@@)(@@) $ 9986 - عن سعيد بن عبد العزيز ، عن يونس بن ميسرة بن حلبس قال : | ' خرجت مع أبي سعيد الزرقي - وكانت له صحبة - إلى شرى الضحايا ، فأشار إلى | كبش أدغم الرأس ليس بأرفع الكباش ، فقال : كأنه الكبش الذي ضحى به | رسول الله صلى الله عليه وسلم ، فأمرني فاشتريته ، قال سعيد : الأدغم ، الأسود الرأس ' . ( ابن | منده ، كر ) . | PageV17P262 |(@)(@@)(@@)(@@) $ 9987 - عن عبد الله عامر بن قيس الكندي ، حدثه عن أبي سعيد الزرقي | رضي الله عنه : ' أن رسول الله صلى الله عليه وسلم قال : إن الله تعالى وعدني أن يدخل من أمتي | الجنة سبعين ألفا بغير حساب ، ويشفع كل ألف في سبعين ألفا ، ثم يحثي لي ثلاث | حثيات بكفيه ، قال رسول الله صلى الله عليه وسلم : إن ذلك - إن شاء الله - مستوعب مهاجري أمتي | ويوفينا الله بشيء من أعرابنا ' . ( البغوي وابن النجار ) . |(@)(@@)(@@)(@@) $ 9988 - عن عبد الله بن مرة ، عن أبي سعيد الزرقي : ' أن رجلا من أشجع ، | واسمه سعد بن عمارة سأل النبي صلى الله عليه وسلم عن العزل ؟ فقال : ما يقدر في الرحم يكن ' . | ( البغوي ) . |(@)(@@) | ( 57 - أبو سفيان بن حرب رضي الله عنه )(@)(@@)(@@)(@@) $ 9989 - عن أبي الهيثم ، عمن أخبره : ' أنه سمع 
ms5885	 أبا سفيان بن حرب مازح | النبي صلى الله عليه وسلم في بيت ابنته أم حبيبة ويقول : والله ! إن هو إلا أن تركتك فتركتك العرب | أن انتطحت فيك وقالوا : جماء ولا ذات قرن ، ورسول الله صلى الله عليه وسلم يضحك ويقول : | أنت تقول ذلك يا أبا حنظلة ' . ( الزبير بن بكار في كر ) . |(@)(@@)(@@)(@@) $ 9990 - عن عبد الله بن علقمة بن أبي الفغواء الخزاعي عن أبيه قال : ' بعثني | النبي صلى الله عليه وسلم بمال إلى أبي سفيان بن حرب يفرقه في فقراء قريش وهم مشركون | يتألفهم ، فقال لي : التمس صاحبا ، فلقيت عمرو بن أمية الضمري ، قال : فأنا أخرج | معك وألتمس صحبتك ، فجئت النبي صلى الله عليه وسلم فقلت : يا رسول الله ! إني قد وجدت | صاحبا ، قال : من ؟ قلت : عمرو بن أمية الضمري ، زعم أنه سيحسن صحبتي ، | قال : فهو إذن ، فلما أجمعت المسير ، خلا بي دونه فقال : يا علقمة ! إذا بلغت بلاد | بني ضمرة فكن من أخيك على حذر ، فإنك قد سمعت قول القائل : أخوك البكري | ولا تأمنه ، فخرجنا حتى إذا جئنا الأبواء ، وهي بلاد بني ضمرة ، قال عمرو بن أمية : | PageV17P263 | إني أريد أن آتي بعض قومي ههنا لحاجة لي ، قلت : لا عليك ، فلما ولى ضربت | بعيري وذكرت ما وصاني به النبي صلى الله عليه وسلم ، فإذا هو قد طلع بنفر منهم ، معهم القسي | والنبل ، فلما رأيتهم ضربت بعيري ، فلما رآني قد قذفت القوم أدركني فقال : جئت | قومي وكانت لي إليهم حاجة ، فقلت : أجل ، فلما قدمت مكة دفعت المال إلى أبي | سفيان ، فجعل أبو سفيان يقول : من أبر من هذا ولا أوصل - يعني النبي صلى الله عليه وسلم - ، إنا | نجاهده ونطلب دمه ، وهو يبعث إلينا بالصلات يبرنا بها ' . ( كر ) . |(@)(@@)(@@)(@@) $ 9991 - عن ابن شهاب قال : ' أرسلت بنو قريظة إلى أبي سفيان وإلى من معه | من الأحزاب يوم الخندق أن اثبتوا فإنا سنغير على بيضة المسلمين من ورائهم ، | فسمع ذلك نعيم بن مسعود الأشجعي وهو موادع لرسول الله صلى الله عليه وسلم ، وكان عند | عيينة بن 
ms5886	 حصن حين أرسلت بذلك بنو قريظة إلى الأحزاب ، فأقبل نعيم إلى رسول | الله صلى الله عليه وسلم فأخبره خبر ما أرسلت به بنو قريظة إلى الأحزاب ، فقال رسول الله صلى الله عليه وسلم : | فلعلنا نحن أمرناهم بذلك فقام نعيم بكلمة رسول الله صلى الله عليه وسلم تلك من عند رسول | الله صلى الله عليه وسلم ليحدث بها غطفان ، وكان نعيم رجلا لا يملك الحديث ، فلما ولى نعيم | ذاهبا إلى غطفان ، قال عمر بن الخطاب رضي الله عنه : يا رسول الله ! هذا الذي | قلت ، إما هو من عند الله فأمضه ، وإما هو رأي رأيته ، فإن شأن بني قريظة هو أيسر | من ذلك أن تقول شيئا يؤثر عليك فيه ، فقال رسول الله صلى الله عليه وسلم : هذا رأي رأيته ، إن | الحرب خدعة ، ثم أرسل رسول الله صلى الله عليه وسلم في أثر نعيم فدعاه ، فقال له : أرأيتك الذي | سمعتني أذكر آنفا ، اسكت عنه فلا تذكره لأحد ، فانصرف نعيم من عند رسول | الله صلى الله عليه وسلم حتى جاء عيينة بن حصن ومن معه من غطفان ، فقال لهم : هل علمتم أن | محمدا صلى الله عليه وسلم قال شيئا قط إلا حقا ؟ قالوا : لا ، قال : فإنه قد قال لي فيما أرسلت به | إليكم بنو قريظة : فلعلنا نحن أمرناهم بذلك ، ثم نهاني أن أذكره لكم ، فانطلق عيينة | حتى لقي أبا سفيان بن حرب ، فأخبره بما أخبره نعيم عن رسول الله صلى الله عليه وسلم ، فقال : | إنما أنتم في مكر من بني قريظة ، قال أبو سفيان : فنرسل إليهم نسألهم الرهن ، فإن | PageV17P264 | دفعوا إلينا رهنا منهم فصدقوا ، وإن أبوا فنحن منهم في مكر ، فجاءهم رسول أبي | سفيان يسألهم الرهن ، فقال : إنكم أرسلتم إلينا تأمروننا بالمكث وتزعمون أنكم | ستخالفون محمدا ومن معه ، فإن كنتم صادقين ، فارهنونا بذلك ، من أبنائكم | وصبحوهم غدا ، قالت بنو قريظة : قد دخلت علينا ليلة السبت ، فأمهلوا حتى يذهب | السبت ، فرجع الرسول إلى أبي سفيان بذلك ، فقال أبو سفيان ، ورؤوس الأحزاب | معه : هذا مكر من 
ms5887	 بني قريظة ، فارتحلوا ، فبعث الله تعالى عليهم الريح ، حتى ما | كان رجل منهم يهتدي إلى رحله ، فكانت تلك هزيمتهم ، فبذلك يرخص الناس | الخديعة في الحرب ' . ( ابن جرير ) . |(@)(@@)(@@)(@@) $ 9993 - عن سعيد بن المسيب قال : ' لما كان ليلة دخل الناس مكة - ليلة | الفتح - لم يزالوا في تكبير وتهليل وطواف بالبيت حتى أصبحوا ، فقال أبو سفيان | لهند : أترين هذا من الله ؟ ثم أصبح ، فغدا أبو سفيان إلى رسول الله صلى الله عليه وسلم ، فقال له | رسول الله صلى الله عليه وسلم : قلت لهند : أترين هذا من الله ؟ نعم ! هو من الله ، فقال أبو سفيان : | أشهد أنك عبد الله ورسوله ، والذي يحلف به أبو سفيان ، ما سمع قولي هذا أحد | من الناس إلا الله وهند ' . ( كر ؛ وسنده صحيح ) . |(@)(@@)(@@)(@@) $ 9993 عن أنس رضي الله عنه قال :(@)(@@) | 30 ( لما كنا بسرف ، قال رسول الله : إن أبا سفيان قريب منكم ، فافترقوا له وأخذوه فقال له رسول الله : أسلم يا أبا سفيان تسلم ، قال : يا رسول الله قومي قومي ، قال : قومك من أغلق بابه فهو آمن ، قال : اجعل لي شيئا ، قال : من دخل دارك فهو آمن ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9994 حدثنا سليمان بن حرب ، حدثنا حماد بن زيد ، عن أيوب ، عن عكرمة قال : $ 30 ( لما وادع رسول الله أهل مكة ، وكانت خزاعة خلفاء رسول الله في الجاهلية ، وكانت بنو بكر حلفاء قريش ، فدخلت خزاعة في صلح رسول الله ودخلت بنو بكر في صلح قريش ، وكان بين خزاعة وبين بني بكر PageV17P265 قتال ، فأمدتهم قريش بسلاح وطعام ، وظلوا عليهم ، فظهرت بنو بكر علاى خزاعة وقتلوا منهم ، فخافت قريش أن يكونوا قد نقضوا ، فقالوا لأبي سفيان : إذهب إلاى محمد وأجر الحلف وأصلح بين الناس ، فانطلق أبو سفيان حتى قدم المدينة فقال رسول الله : ( قد جاءكم أبو سفيان وسيرجع راضيا بغير حاجته ) ، فأتاى أبا بكر رضي الله عنه فقال : يا أبا بكر أجر الحلف بين الناس ، قال : ليس الأمر إلي ، الأمر إلاى الله وإلاى رسوله ، وقد قال له فيما قال : ليس من قوم ظللوا 
ms5888	 علاى قوم وأمدوهم بسلاح وطعام أن يكونوا نقضوا ، فقال أبو بكر : الأمر إلاى الله وإلاى رسوله ، ثم أتاى عمر بن الخطاب رضي الله عنه فقال له نحوا مما قال لأبي بكر ، فقال له عمر : أنقضتم فما كان منه جديدا فأبلاه الله ، وما كان منه شديدا أو قال متينا فقطعه الله ، فقال أبو سفيان : ما رأيت كاليوم شاهد عشيرة ، ثم أتاى فاطمة فقال : يا فاطمة هل لك في أمر تسودين فيه نساء قومك ؟ ثم ذكر لها نحوا مما ذكر لأبي بكر ، فقالت : ليس الأمر إلي ، الأمر إلاى بكر ، فقال له علي : ما رأيت كاليوم رجلا أضل ، أنت سيد الناس فأجر الحلف ، وأصلح بين الناس ، فضرب بإحداى يديه علاى الأخراى وقال : قد أجرت الناس بعضهم من بعض ، ثم ذهب حتى قدم علاى أهل مكة ، فأخبرهم بما صنع ، فقالوا : والله ما رأينا كاليوم وافد قوم ، والله ما أتيتنا بحرب فنحذر ، ولا أتيتنا بصلح فنأمن ، إرجع ، قال : وقدم وافد خزاعة علاى رسول الله فأخبره بما صنع القوم ودعا إلاى النصر وأنشده في ذالك شعرا :(@)(@@) اللهم إني ناشد محمدا %~% حلف أبينا وأبيه الأتلدا(@)(@@) فأمر رسول الله بالرحيل ، فارتحلوا ، فساروا حتى نزلوا مرا ، وجاء أبو سفيان حتى نزل بمر ليلا ، ورأى العسكر والنيران فقال : ما هاؤلاء ؟ قيل : هاذه تميم محلت بلادها وانتجعت بلادكم قال : والله لهاؤلاء أكثر من أهل منى ، فلما علم أنه النبي قال : دلوني علاى العباس ، فأتاى العباس فأخبره الخبر ، وذهب به إلاى PageV17P266 رسول الله ، ورسول الله في قبة له ، فقال له : ( يا أبا سفيان أسلم تسلم ، فأسلم أبو سفيان ) ، وذهب به العباس إلاى منزله ، فلما أصبحوا ، ثار الناس لطهورهم ، فقال أبو سفيان : يا أبا الفضل ما للناس أمروا بشيء ؟ قال : لا ، ولاكنهم قاموا إلاى الصلاة ، فأمره العباس فتوضأ ، ثم ذهب به إلاى رسول الله ، فلما دخل رسول الله الصلاة كبر ، فكبر الناس ، ثم ركع وركعوا ، ثم رفع فرفعوا ، فقال أبو سفيان : ما رأيت كاليوم طاعة قوم ، جمعهم من هاهنا ومن هاهنا ، ولا فارس 
ms5889	 الأكارم ، ولا الروم ذات القرون بأطوع منهم له ، قال أبو سفيان : يا أبا الفضل أصبح ابن أخيك عظيم الملك ، فقال له العباس : إنه ليس بملك ، ولاكنها نبوة ، قال : أو ذاك ، أو ذاك قال أبو سفيان : واصباح قريش ، فقال العباس : يا رسول الله لو أذنت لي فأتيتهم فدعوتهم وآمنتهم ، وجعلت لأبي سفيان شيئا يذكر به ؟ فانطلق العباس فركب بغلة رسول الله الشهباء ، فانطلق ، فقال رسول الله : ردوا علي أبي ، ردوا علي أبي ، فإن عم الرجل صنو أبيه ، إني أخاف أن تفعل به قريش ما فعلت ثقيف بعروة بن مسعود ، دعاهم إلاى الله فقتلوه ، أما والله لئن ركبوها منه لأضرمنها عليهم نارا ، فانطلق العباس حتى قدم مكة ، فقال : يا أهل مكة أسلموا تسلموا ، قد استبطنتم بأشهب بازل ، وقد كان رسول الله بعث الزبير من قبل أعلاى مكة ، وبعث خالد بن الوليد من قبل أسفل مكة ، فقال لهم العباس رضي الله عنه : هاذا الزبير من قبل أعلاى مكة ، وهاذا خالد من قبل أسفل مكة ، وخالد وما خالد وخزاعة المجدعة الأنوف ، ثم قال : من ألقاى السلاح فهو آمن ، ثم قدم رسول الله فتراموا بشيء من النبل ، ثم إن رسول الله ظهر عليهم فأمن الناس إلا خزاعة من بني بكر ، فذكر أربعة : مقيس بن صبابة ، وعبد الله بن أبي سرح ، وابن خطل ، وسارة مولاة بني هاشم ، فقاتلتهم خزاعة إلاى PageV17P267 نصف النهار ، وأنزل الله تعالاى : { ألا تقاتلون قوما نكثوا أيمانهم } الآية ) . ( ش ) . ) $(@)(@@)(@@)(@@) $ 9995 حدثنا يزيد بن هارون ، أنبأنا محمد بن عروة ، عن أبي سلمة ويحي ى بن عبد الرحمان بن حاطب قالا : $ 30 ( كانت بين رسول الله وبين المشركين هدنة ، فكان بين بني كعب وبين بني بكر قتال بمكة ، فقدم صريخ بني كعب علاى رسول الله فقال :(@)(@@) اللهم إني ناشد محمدا %~% حلف أبينا وأبيه الأتلدا(@)(@@) فانصر هداك الله نصرا عتدا %~% وادع عباد الله يأتوا مددا(@)(@@) فمرت سحابة فرعدت ، ( فقال رسول الله : إن هاذه لترعد بنصر بني كعب ، ثم قال لعائشة رضي الله عنها : جهزيني ولا تعلمي 
ms5890	 بذالك أحدا ) ، فدخل عليها أبو بكر رضي الله عنه فأنكر بعض شأنها فقال : ما هاذا ؟ قالت : أمرني رسول الله أن أجهزه ، قال : إلاى أين ؟ قالت : إلاى مكة ، قال : فوالله ما نقضت الهدنة بيننا وبينهم بعد ، فجاء أبو بكر إلاى رسول الله فذكر له ، ( فقال النبي : إنهم أول من غدر ، ثم أمر بالطرق فحبست ، ثم خرج وخرج المسلمون معه ، فغم لأهل مكة لا يأتيهم خبر ، فقال أبو سفيان لحكيم بن حزم : أي حكيم والله لقد غممنا واغتممنا ، فهل لك أن تركب ما بيننا وبين مر ، لعلنا أن نلقاى خبرا ، فقال له بديل بن ورقاء الكعبي من خزاعة : وأنا معكم ، قالا : وأنت إن شئت ، فركبوا ، ثم إذا دنوا من ثنية مر وأظلموا فأشرفوا علاى الثنية ، فإذا النيران قد أخذت الوادي كله ، قال أبو سفيان لحكيم بن حزام ، أي حكيم ما هاذه النيران ؟ قال بديل بن ورقاء : هاذه نيران بني عمرو خدعتها الحرب ، قال أبو سفيان : لا وأبيك لبنو عمرو أذل وأقل من هاؤلاء ، فتكشف عنهم الأراك ، فأخذهم حرس رسول الله نفر من الأنصار ، وكان عمر بن الخطاب رضي الله عنه تلك الليلة علاى الحرس ، فجاءوا بهم إليه ، PageV17P268 فقالوا : جئناك بنفر أخذناهم من أهل مكة ، فقال عمر وهو يضحك إليهم : والله لو جئتموني بأبي سفيان ما زدتم قالوا : قد والله أتينا بأبي سفيان ، فقال : احبسوه فحبسوه ، حتى أصبح فغداى به علاى رسول الله ، فقيل له : بايع ، فقال : لا أجد إلا ذاك أو شرا منه فبايع ، ثم قيل لحكيم بن حزام : بايع ، فقال : أبايعك ولا أخر إلا قائما ، قال رسول الله : ( أما من قبلنا فلن تخر إلا قائما ، فلما ولوا ، قال أبو بكر : يا رسول الله إن أبا سفيان رجل يحب السماع يعني الشرف فقال رسول الله : من دخل دار أبي سفيان فهو آمن إلا ابن خطل ، ومقيس بن صبابة الليثي ، وعبد الله بن سعد بن أبي سرح والقينتين ، فإن وجدتموهم متعلقين بأستار الكعبة فاقتلوهم ، فلما ولوا ، قال أبو بكر : يا رسول الله لو 
ms5891	 أمرت بأبي سفيان فحبس علاى الطريق ، وأذن في الناس بالرحيل ، فأدركه العباس فقال : هل لك إلاى أن تجلس حتى تنظر ؟ قال : بلاى ولم يكره ذالك فيراى ضعفه ، فسألهم فمرت جهينة فقال : أي عباس من هاؤلاء ؟ قال : هاذه جهينة ، قال : مالي ولجهينة ، والله ما كان بيني وبينهم حرب قط ، ثم مرت مزينة ، فقال : أي عباس من هاؤلاء ؟ قال : هاذه مزينة ، قال : مالي ولمزينة ، والله ما كان بيني وبينهم حرب قط ، ثم مرت سليم فقال : أي عباس من هاؤلاء ؟ قال : هاذه سليم ، ثم جعلت تمر طوائف العرب ، فمر عليه أسلم وغفار ، فيسأل عنهما فيخبره العباس ، حتى مر رسول الله في أخريات الناس في المهاجرين الأولين والأنصار ، في لأمة تلمع البصر ، فقال : أي عباس من هاؤلاء ؟ قال : هاذا رسول الله واصحابه في المهاجرين الأولين والأنصار ، قال : لقد أصبح ابن أخيك عظيم الملك ، قال : لا والله ، ما هو بملك ، ولاكنها النبوة ، وكانوا عشرة آلاف أو إثنى عشر ألفا ، ودفع رسول الله الراية إلاى سعد بن عبادة ، فدفعها سعد إلاى ابنه قيس بن سعد ، وركب أبو سفيان فسبق الناس ، حتى اطلع عليهم من الثنية ، قال له أهل مكة : ما وراءك ؟ قال : ورائي الدهم ، ورائي ما لا قبل لكم به ، ورائي من لم أر مثله ، من دخل داري فهو آمن ، فجعل الناس يقتحمون PageV17P269 داره ، وقدم رسول الله فوقف في الحجون بأعلاى مكة ، وبعث الزبير بن العوام في الخيل في أعلاى الوادي ، وبعث خالد بن الوليد في الخيل في أسفل الوادي ، وقال رسول الله : إنك لخير أرض الله وأحب أرض الله إلى الله ، وإني والله لو لم أخرج منك ما خرجت ، وإنها لن تحل لأحد كان قبلي ، ولا تحل لأحد بعدي ، وإنما أحلت لي من النهار ساعة ، وهي ساعتي هاذه ، حرام لا يعضد شجرها ، ولا يحتش حشيشها ، ولا يلتقط لقطتها إلا لمنشد ، فقال له رجل يقال له : أبو شاه ، والناس يقولون قال له العباس : يا رسول الله إلا الإذخر فإنه لبيوتنا وقيوننا ، أو لبيوتنا وقبورنا ، فأما ابن 
ms5892	 خطل فوجدوه متعلقا بأستار الكعبة فقتل ، وأما مقيس بن صبابة فوجدوه بين الصفا والمروة ، فبادره نفر من بني كعب ليقتلوه ، فقال ابن عمه نميلة خلوا عنه ، فوالله لا يدنو منه رجل إلا ضربته بسيفي هاذا حتى يبرد ، فتأخروا عنه ، فحمل عليه بسيفه ففلق به هامته ، وكره أن يفخر عليه أحد ، ثم طاف رسول الله بالبيت ، ثم دخل عثمان بن طلحة فقال : أي عثمان أين المفتاح ؟ فقال : هو عند أمي سلامة ابنة سعد ، فأرسل إليها رسول الله فقالت : لا ، واللات والعزى ، لا أدفعه إليه أبدا ، قال : إنه قد جاء أمر غير الأمر الذي كنا عليه ، فإنك إن لم تفعلي قتلت أنا وأخي ، فدفعته إليه ، فأقبل به حتى إذا كان وجاه رسول الله عشر فسقط المفتاح منه ، فقام إليه رسول الله ، فأحنى عليه بثوبه ، ثم فتح له عثمان ، فدخل رسول الله الكعبة ، فكبر في زواياها وأرجائها وحمد الله ، ثم صلى بين الأسطوانتين ركعتين ، ثم خرج فقام بين الناس ، فقال علي : فتطاولت لها ورجوت أن يدفع إلينا المفتاح فتكون فينا السقاية والحجابة ، فقال رسول الله : أين عثمان ؟ هاكم ما أعطاكم الله ، ثم دفع إليه المفتاح ، ثم رقي بلال علاى ظهر الكعبة فأذن ، فقال خالد بن أسيد : ما هاذا الصوت ؟ قالوا : بلال بن رباح ، قال : PageV17P270 عبد أبي بكر الحبشي قالوا : نعم ، قال : أين ؟ قالوا : علاى ظهر الكعبة ، قال : علاى مرقة بني أبي طلحة ؟ قالوا : نعم ، قال : ما يقول ؟ قالوا : يقول : أشهد أن لا إلاه إلا الله ، وأشهد أن محمدا رسول الله ، قال : لقد أكرم الله أبا خالد بن أسيد عن أن يسمع هاذا الصوت ، يعني أباه ، وكان ممن قتل يوم بدر في المشركين ، وخرج رسول الله إلاى حنين ، وجمعت له هوازن بحنين ، فاقتتلوا ، فهزم أصحاب رسول الله ، قال تعالاى : { ويوم حنين إذ أعجبكم كثرتكم فلم تغن عنكم شيئا } الآية ، فنزل رسول الله عن دابته فقال : اللهم إنك إن شئت لم تعبد بعد اليوم ، شاهت الوجوه ، ثم رماهم بحصباء كانت في يده فولوا مدبرين ، فأخذ 
ms5893	 رسول الله السبي والأموال فقال لهم : إن شئتم فالفداء ، وإن شئتم فالسبي ، فقالوا : لن نؤثر اليوم علاى الحسب شيئا ، فقال رسول الله : إذا خرجت فاسألوني فإني أعطيكم الذي لي ، ولن يتعذر علي أحد من المسلمي ، فلما خرج رسول الله : صاحوا إليه فقال : أما الذي أعطيتكموه ، وقال المسلمون مثل ذالك إلا عيينة بن حصن فإنه قال : أما الذي لي فأنا لا أعطيه ؛ قال : فأنت علاى حقك من ذالك ، فصارت له يومئذ عجوز عوراء ، ثم حاصر رسول الله أهل الطائف قريبا من شهر ، فقال عمر بن الخطاب : أي رسول الله دعني أدخل عليهم فأدعوهم إلاى الله ، قال : إنهم إذا قاتلوك ، فدخل عليهم عروة فدعاهم إلاى الله ، فرماه رجل من بني مالك بسهم فقتله ، فقال رسول الله : مثله في قومه كمثل صاحب ياس ، وقال رسول الله : خذوا مواشيهم ، وضيقوا عليهم ، ثم أقبل رسول الله راجعا ، حتى إذا كان بنخلة جعل الناس يسألونه ، قال أنس : حتى انتزعوا رداءه عن ظهره ، فأبدوا عن مثل فلقة القمر ، فقال : ردوا علي ردائي لا أبا لكم ، PageV17P271 أتبخلوني ، فوالله أن لو كان لي ما بينهما إبلا وغنما لأعطيتكموه ، فأعطاى المؤلفة قلوبهم يومئذ مائة مائة من الابل ، وأعطاى الناس ، فقالت الأنصار عند ذالك ، فدعاهم رسول الله فقال : قلتم كذا وكذا ، ألم أجدكم ضلالا فهداكم الله بي ؟ قالوا : بلاى ، قال : أو لم أجدكم عالة فأغناكم الله بي ؟ قالوا : بلاى ، قال : ألم أجدكم أعداء فألف الله بين قلوبكم بي ؟ قالوا : بلاى ، قال : أما إنكم لو شئتم قلتم : قد جئتنا مخذولا فنصرناك ؟ قالوا : الله ورسوله أمن ، قال : لو شئتم قلتم : جئتنا طريدا فأديناك ؟ قالوا : الله ورسوله أمن ، قال : ولو شئتم قلتم جئنا عائلا فواسيناك ؟ قالوا : الله ورسوله أمن ، قال : أفلا ترضون أن ينقلب الناس بالشاء والبعير ، وتنقلبون برسول الله إلاى دياركم ؟ قالوا : بلاى ، فقال رسول الله : الناس دثار والأنصار شعار ، وجعل علاى المغانم عباد بن وقش أخا بني عبد الأشهل ، فجاء رجل من أسلم عاريا ليس عليه ثوب ، فقال : إكسني من هاذه البرود 
ms5894	 بردة ، قال : إنما هي مقاسم المسلمين ، ولا يحل لي أن أعطيك منها شيئا ، فقال قومه : اكسه منها بردة ، فإن تكلم فيها أحد فهي من قسمنا وأعطائنا ، فأعطاه بردة ، فبلغ ذالك رسول الله فقال : ما كنت أخشى هاذا عليه ما كنت أخشاكم عليه ، فقال : يا رسول الله ما أعطيته إياها حتى قال قومه : إن تكلم فيها أحد فهي من قسمنا وأعطائنا ، فقال : جزاكم الله خيرا ، جزاكم الله خيرا ، جزاكم الله خيرا ) . ( ش ) . ) $(@)(@@)(@@)(@@) $ 9996 عن عبد الله بن أبي سفيان عن أبيه ، عن الأحمدي قال :(@)(@@) | 30 ( كنت وعدت امرأتي حجة ، ثم بدا لي فغزوت فوجدت من ذالك وجدا شديدا ، فشكوت ذالك إلاى رسول الله فقال : مرها فلتعتمر في رمضان فإنها كعدل حجة ) . ( ابن نافع والبغوي ، وقال : لا أدري من الأحمدي ولم يسم وأبو نعيم ) . )(@)(@@) PageV17P272(@)(@@)(@@)(@@) $ 9997 عن أبي سفيان :(@)(@@) | 30 ( أن أمية بن أبي الصلت كان معه بقرة ، فقال : يا أبا سفيان أتعرف عتبة بن ربيعة ؟ قال : كريم الطرفين ، ويجتنب المظالم والمحارم ، وشريف مسن ، قال : إني كنت أجد في كتبي نبيا يبعث من حرتنا هاذه ، فكنت أظن أني هو ، فلما دارست أهل العراق إذا هو من بني عبد مناف فنظرت في بني عبد مناف ، فلم أجد أحدا يصلح لهاذا الأمر غير عتبة بن ربيعة ، فلما أخبرتني بسنه عرفت أنه ليس به حين جاوز الأربعين ولم يوح إليه ، قال أبو سفيان : فضرب الدهر من ضربه وأوحي إلاى رسول الله وخرجت في ركب من قريش أريد اليمن في تجارة ، فمررت بأمية بن أبي الصلت فقلت له كالمستهزيء به : يا أمية قد خرج النبي الذي كنت تنتظر ، قال : أما إنه حق تنتظره فاتبعه ، قلت : ما يمنعك من اتباعه ؟ قال : ما يمنعني إلا الاستحياء من نساء ثقيف إني كنت أحدثهم أني هو ، ثم يرونني تابعا لغلام من بني عبد مناف ، ثم قال أمية : كأني بك يا أبا سفيان إن خالفته قد ربطت كما يربط الجدي حتى يؤتاى بك إليه فيحكم فيك بما يريد ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9998 عن ابن 
ms5895	 عباس رضي الله عنها قال :(@)(@@) | 30 ( لقي رسول الله أبا سفيان بن حرب في الطواف فقال : يا أبا سفيان كان بينك وبين هند كذا وكذا ، فقال أبو سفيان : أفشت علي هند سري ، لأفعلن بها فلما فرغ رسول الله من طوافه لحق أبا سفيان فقال : يا أبا سفيان لا تكلم هندا ، فإنها لم تفش من سرك شيء ، فقال أبو سفيان : أشهد أنك رسول الله هاذه هند ظننتها أن تكون أفشت سري من إنبائك ما في نفسي ) . ( كر ) . )(@)(@@)(@@)(@@) $ 9999 عن عمرو بن يحي ى بن سعيد الأموي عن جده :(@)(@@) | 30 ( أن أبا سفيان دخل علاى عمر بن الخطاب رضي الله عنه ، فعزاه عمر بابنه يزيد ، فقال : آجرك الله في ابنك يا أبا سفيان فقال : أي بني يا أمير المؤمنين ؟ قال : يزيد ، قال : فمن بعثت علاى عمله ؟ قال : معاوية أخاه ، قال عمر : ابنان مصلحان ، وإنه لا يحل لنا أن ننزع PageV17P273 مصلحا ) . ( ابن سعد ، واللالكائي في السنة ) . )(@)(@@)(@@)(@@) $ 10000 عن معاوية قال :(@)(@@) | 30 ( خرج أبو سفيان إلاى بادية له مردفا هندا ، وخرجت أسير أمامهما وأنا غلام علاى حمارة لي ، إذ سمعنا رسول الله ، فقال أبو سفيان : إنزل يا معاوية حتى يركب محمد ، فنزلت عن الحمارة وركبها رسول الله ؛ فسار أمامنا هنيهة ث التفت إلينا فقال : يا أبا سفيان بن حرب ويا هند ابنة عتبة والله لتموتن ثم لتبعثن ، ثم ليدخلن المحسن الجنة والمسيء النار ، وأنا أقول لكم بحق ، وإنكم الأول من أنذر ، ثم قرأ رسول الله { حام تنزيل من الرحمان الرحيم } حتى بلغ : ( قالتا أتينا طائعين ) ، فقال أبو سفيان : أفرغت يا محمد ؟ قال : نعم ، ونزل رسول الله عن الحمارة وركبتها ، وأقبلت هند علاى أبي سفيان فقالت : ألهاذا الساحر الكذاب أنزلت ابنى ؟ قال : لا والله ما هو بساحر ولا كذاب ) . ( كر ) .(@)(@@)(@)(@@)(@@)(@@) |||| 58 القيسي ضريب بن نفير الجريري ، أبو سليل )(@)(@@)(@@)(@@) $ 10001 عن أبي السليل قال :(@)(@@) | 30 ( أخبرني أبي قال : شهدت النبي وهو جالس في دار رجل من الأنصار يقال له : أوس بن حوشب ، فأتي بعس فوضع في 
ms5896	 يده ، فقال : ما هاذا ؟ فقالوا : يا رسول الله لبن وعسل ، فوضعه في يده ثم قال : هاذا شراب لا نشربه ولا نحرمه ، من تواضع رفعه الله ، ومن تجبر قصمه الله ، ومن أحسن تدبير معيشته رزقه الله ) . ( ابن النجار ) . )(@)(@@) PageV17P274(@)(@@)(@@)(@@) |||| ( أبو سلمة(@)(@@) | 59 عبد الرحمان بن عوف رضي الله عنه )(@)(@@)(@@)(@@) $ 10002 عن أبي سلمة بن عبد الرحمان رضي الله عنه قال :(@)(@@) | 30 ( كان أزواج النبي يأخذن من شعورهن حتى يدعنه كهيئة الوفرة ) . ( ابن جرير ) . )(@)(@@)(@@)(@@) $ 10003 عن أبي سلمة بن عبد الرحمان ، عن عبد الله بن رواحة رضي الله عنه قال :(@)(@@) | 30 ( كنت في غزاة فتعجلت ، فانتهيت إلى الباب فإذا المصباح يتأجج ، وإذا أنا بشيء أبيض ، فاخترطت سيفي ثم حركتها فانتبهت المرأة ، فقالت : إليك إليك فلانة كانت عندي تمشطني ، فأتيت النبي فأخبرته فنهاى أن يطرق الرجل أهله ليلا ) . ( ك ) . )(@)(@@)(@@)(@@) $ ( 10004 ) عن أبي سلمة بن عبد الرحمن ، عن الشفاء بنت عبد الله قالت : ' دخل علي النبي & فسألته وشكوت إليه فجعل يعتذر إلي ، وجعلت ألومه ، ثم حانت صلاة الأولى ، فدخلت بيت ابنتي وهي عند شرحبيل بن حسنة ، فوجدت زوجها في البيت فوقعت به ألومه ، حضرت الصلاة الأولى وأنت ههنا ، فقالت : يا عمة لا تلوميني ، كان لي ثوبان استعار أحدهما رسول الله صلى الله عليه وسلم فوجدت في نفسي من ذلك ، فقلت : ومن يلومه وهذا شأنه ' . ( كر ) .(@)(@@)(@@)(@@) $ 10005 عن أبي سلمة بن عبد الرحمان رضي الله عنه قال :(@)(@@) | 30 ( خرج رسول الله والمؤذن يقيم الفجر فوجد رجلين يصليان ، فقال : أصلاتان معا ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10006 عن أبي سلمة بن عبد الرحمان رضي الله عنه قال :(@)(@@) | 30 ( جيء بالنبي في مرضه حتى جلس في مصلاه ، وقام أبو بكر رضي الله عنه إلاى جنبه فصلى قائما PageV17P275 يأتم بالنبي والناس يأتمون بأبي بكر ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10007 عن أبي سلمة بن عبد الرحمان ، عن رجل من أهل الصفة قال :(@)(@@) | 30 ( دعاني رسول الله ورهطا معي من أهل الصفة ، فتعشينا عنده ، ثم قال : إن شئتم رقدتم هاهنا ، وإن شئتم في المسجد ، فقلنا : في المسجد ، فكنا 
ms5897	 ننام في المسجد ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10008 عن أبي سلمة بن عبد الرحمان بن عوف رضي الله عنه قال :(@)(@@) | 30 ( خطب النبي فقال : ( إن الحمد لله ، أحمده وأستعينه نعوذ بالله من شرور أنفسنا وسيئات أعمالنا ، من يهده الله فلا مضل له ، ومن يضلل فلا هادي له ، وأشهد أن لا إلاه إلا الله وحده لا شريك له ؛ إن أحسن الحديث كتاب الله ، قد أفلح من زينه الله في قلبه وأدخله في الاسلام بعد الكفر ، واختاره علاى ما سواه من أحاديث الناس ، إنه أحسن الحديث وأبلغه ، أحبوا من أحب الله ، أحبوا الله من كل قلوبكم ، ولا تملوا كلام الله وذكره ، ولا تقساى قلوبكم ، فقد سماه الله خيرته من الأعمال والصالح من الحديث ، وعلاى كل ما آواى الناس من الحلال والحرام ، فاعبدوا الله ولا تشركوا به شيئا ، واتقوه حق تقاته ، واصدقوا الله صالح ما تقولون بأفواهكم ، وتجابوا بروح الله عز وجل بينكم ، إن الله يغضب أن ينكث عهده ، والسلام عليكم ورحمة الله ) . ( هناد ) . )(@)(@@)(@@)(@@) $ 10009 عن أبي سلمة رضي الله عنه قال :(@)(@@) | 30 ( خطب النبي فقال : ( إن الحمد لله ، ما شاء الله جعل بين يديه ، وما شاء جعل خلفه ، وإن من البيان سحرا ) . ( حم ، طب عن معن بن يزيد ) . )(@)(@@)(@@)(@@) $ 10010 عن أبي سلمة بن عبد الرحمان رضي الله عنه قال :(@)(@@) | 30 ( جلس رسول الله ذات يوم فأخذ عودا يابسا فحط ورقه ثم قال : إن قول : ( لا إلاه إلا الله ، PageV17P276 والله أكبر ، والحمد لله ، وسبحان الله ، يحط الخطايا كما تحط ورق هاذه الشجرة ، خذهن يا أبا الدرداء قبل أن يحال بينك وبينهن ، فإنهن الباقيات الصالحات ، وهن من كنور الجنة ) ؛ قال أبو سلمة : فكان أبو الدرداء رضي الله عنه إذا ذكر هاذا الحديث قال : لأهللن الله ، ولأكبرن الله ، ولأسبحن الله ؛ حتى إذا رآني جاهل حسب أني مجنون ) . ( كر ) . )(@)(@@)(@@)(@@) $ 10011 عن كهمس الهلالي قال :(@)(@@) | 30 ( كنت عند عمر رضي الله عنه فبينما نحن جلوس عنده إذ جاءت امرأة فجلست إليه فقالت : يا أمير المؤمنين إن زوجي قد كثر شره 
ms5898	 ، وقل خيره ، فقال لها : من زوجك ؟ قالت : أبو سلمة ، قال : إن ذاك رجل له صحبة ، وإنه لرجل صدق ، ثم قال عمر لرجل عنده جالس : أليس كذالك ؟ قال : يا أمير المؤمنين لا نعرفه إلا بما قلت ، فقال لرجل : قم فادعه لي ، فقامت المرأة حين أرسل إلاى زوجها فقعدت خلف عمر ، فلم يلبث أن جاءا معا حتى جلس بين يدي عمر ، فقال عمر : ما تقول هاذه الجالسة خلفي ؟ قال : ومن هاذه يا أمير المؤمنين ؟ قال : هاذه امرأتك ، قال : وتقول ماذا ؟ قال : تزعم أنه قل خيرك ، وكثر شرك ، قال : قد بئس ما قالت يا أمير المؤمنين إنها لمن صالح نسائهم ، أكثرهن كسوة ، وأكثرهن رفاهية بيت ، ولاكن فحلها بلي ، فقال عمر للمرأة : ما تقولين ؟ قالت : صدق ، فقام عمر إليها بالدرة فتناولها بها ، ثم قال : أي عدوة نفسها أكلت ماله ، وأفنيت شبابه ، ثم أنشأت تخبرين بما ليس فيه قالت : يا أمير المؤمنين لا تعجل فوالله لا أجلس هاذا المجلس أبدا ، فأمر لها بثلاث أثواب ، فقال : خذي هاذا بما صنعت بك ، وإياك أن تشتكي هاذا الشيخ قال : فكأني أنظر إليها قامت ومعها الثياب ، ثم أقبل علاى زوجها فقال : لا يحملك ما رأيتني صنعت بها أن تسيء إليها فقال : ما كنت لأفعل ، قال : فانصرفا ؛ ثم قال عمر : سمعت رسول الله يقول : ( خير أمتي القرن الذي أنا منهم ، ثم الثاني والثالث ، ثم ينشأ قوم يسبق أيمانهم شهادتهم ، يشهدون من غير أن يستشهدوا ، لهم لغط في أسواقهم ) . ( ط ، خ PageV17P277 في تاريخه والحاكم في الكنى ، قال ابن حجر : إسناده قوي ) . )(@)(@@)(@@)(@@) $ 10012 عن عمر بن أبي سلمة رضي الله عنه قال : ( قال النبي :(@)(@@) | 30 ( يا أيها الناس أي يوم أحرم ؟ أي يوم أحرم ؟ أي يوم أحرم ) ؟ قالوا : يوم الحج الأكبر ، قال : فإن دماءكم وأموالكم وأعراضكم عليكم حرام كحرمة يومكم هاذا ، في بلدكم هاذا ، في شهركم هاذا ، ألا ولا يجنى جان إلا علاى نفسه ، ألا ولا يجنى والد علاى ولده ، ألا إن الشيطان قد أيس أن يعبد في بلدكم هاذا أبدا ، ولاكن 
ms5899	 ستكون له طاعة في بعض ما تستحقرون من أعمالكم فيرضاى بها ، ألا إن المسلم أخو المسلم ، فليس يحل لمسلم من أخيه شيء إلا ما حل من نفسه ، ألا وإن كل ربا في الجاهلية موضوع ، لكم رؤوس أموالكم لا تظلمون ولا تظلمون غير ربا العباس بن عبد المطلب فإنه موضوع له ، وإن كل دم كان في الجاهلية موضوع ، وأول دم أضع من دم الجاهلية دم الحارث بن عبد المطلب ، ألا واستوصوا بالنساء خيرا ، فإنما هن عوان عندكم ، ليس تملكوا منهن شيئا غير ذالك ، إلا أن يأتين بفاحشة مبينة ، فإن فعلن فاهجروهن في المضاجع واضربوهن ضربا غير مبرح ، فإن أطعنكم فلا تبغوا عليهن سبيلا ، ألا وإن لكم علاى نسائكم حقا ، ولنسائكم عليكم حقا ، فأما حقكم علاى نسائكم : فلا يوطئن فرشكم من تكرهون ، ولا يأذن في بيوتكم لمن تكرهون ، ألا وإن حقهن عليكم أن تحسنوا إليهن في كسوتهن وطعامهن ) . ( ت حسن صحيح ) . )(@)(@@)(@@)(@@) $ 10013 عن أبي سلمة رضي الله عنه :(@)(@@) | 30 ( أن أبا سلمة كان ابن عمة رسول الله وكان أول من هاجر إلاى أرض الحبشة ثم إلاى المدينة ) . ( ش ) . )(@)(@@)(@@)(@@) $ 10014 عن أبي سلمة بن عبد الرحمان بن عوف ، ويحي ى بن عبد الرحمان بن حاطب بن أبي بلتعة ، عن أسامة بن زيد بن حارثة ، عن أبيه زيد بن حارثة رضي الله عنه قال :(@)(@@) | 30 ( خرجت مع رسول الله ) . )(@)(@@) PageV17P278(@)(@@)(@@)(@@) $ 10015 عن أبي سلمة بن عبد الرحمان رضي الله عنه قال :(@)(@@) | 30 ( بينا أنا وأبو هريرة عند ابن عباس رضي الله عنهم إذ جاءته امرأة فقالت : توفي زوجي وأنا حامل فذكرت أنها وضعت لأدناى من أربعة أشهر من يوم مات عنها ، فقال ابن عباس : أنت لآخر الأجلين قال أبو سلمة : فقلت : إن عندي علما ، فقال ابن عباس : علي بالمرأة ؟ فقال : أبو سلمة : أخبرني رجل من أصحاب النبي أن سبيعة الأسلمية جاءت النبي فقالت : توفي عنها زوجها فوضعت ، فأخبرته بأدناى من أربعة أشهر من يوم مات ، فقال النبي : يا سبيعة اربعي بنفسك ، قال أبو هريرة : وأنا 
ms5900	 أشهد بذالك ، فقال ابن عباس للمرأة : أسمع ما تسمعين ) . ( عب ) . )(@)(@@)(@@)(@@) $ 10016 عن الزهري عن أبي سلمة بن عبد الرحمن رضي الله عنه قال :(@)(@@) | 30 ( جاء قيس بن هطاطية إلاى حلقة فيها سلمان الفارسي وصهيب الرومي وبلال الحبشي ، فقال : هاؤلاء الأوس والخزرج قاموا بنصرة هاذا الرجل ، فما بال هاؤلاء ؟ فقام معاذ فأخذ بقليبه حتى أتاى به النبي فأخبره بمقالته ، فقام رسول الله مغضبا يجر رداءه حتى دخل المسجد ، ثم نودي : الصلاة جامعة ، فحمد الله وأثنى عليه ثم قال : يا أيها الناس إن الرب رب واحد ، وإن الأب أب واحد ، وإن الدين دين واحد ، ألا وإن العربية ليست لكم بأب ولا أم ، إنما هي لسان ، فمن تكلم بالعربية فهو عربي ، فقال معاذ : وهو آخذ بتلابيبه : يا رسول الله ما تقول في هاذا المنافق ؟ فقال : دعه إلاى النار ، فكان فيمن ارتد فقتل في الردة ) . ( كر وقال : هاذا حديث مرسل وهو مع إرساله غريب جدا ، تفرد فيه أبو بكر السلمي بن عبد الله الهذلي البصري عن مالك ولم يروه عنه إلا قرة بن عيين ) . )(@)(@@)(@@)(@@) $ 10017 عن أبي سلمة بن عبد الرحمان رضي الله عنه قال :(@)(@@) | 30 ( لما أن هجت قريش رسول الله أحزنه ذالك ، فقال لعبد الله بن رواحة : اهج قريشا ، فهجاهم هجاء ليس بالبليغ إليهم ، فلم يرض به ، فبعث إلاى أبي بن مالك فقال : اهج قريشا PageV17P279 فهجاهم هجاء لم يبلغ فيه ، فلم يرض بذالك ، فبعث إلاى حسان بن ثابت وكان يكره أن يبعث إلاى حسان ، فقال حسان حين جاءه الرسول أن اهج قريشا : قد آن لكم أن تبعثوا إلاى هاذا الأسد الضارب بذنبه ؛ فقال حسان : والذي بعثك بالحق لأغزونهم بلساني هاذا ، ثم أطلع لسانه ، فتقول عائشة : والله كان لسانه لسان حية فقال رسول الله : إن لي فيهم نسبا ، وأنا أخشى أن تصيب بعضه ، فائت أبا بكر فإنه أعلم قريش بأنسابها فيتخلص لك نسبي ، قال حسان : والذي بعثك بالحق لأسلنك منهم ونسبك مثل الشعرة من العجين ، فهجاهم حسان ، فقال له رسول الله : لقد شفيت 