ms41	 استمر بي الركوب % PageV01P118 31(@)(@@) % سترمي عنك بي إبلي بعيدا % % و تنتظر الإياب فلا أؤوب % 32(@)(@@) % و ربتما أتاك بنشر صيتي % % و واسع حالي النبأ العجيب % 33(@)(@@) % أخوف بالخيانة من زماني % % و قد مرنت على القتب الندوب % 34(@)(@@) % و ما وادعته منذ احتربنا % % على سلم فتوحشني الحروب . % 35(@)(@@) % و كيف يريبني منه بيوم % زمان كله يوم مريب % 36(@)(@@) % و إني مذ غدت هممي سيوفا % % لأعلم أنني أبدا ضريب % 37(@)(@@) % و ما جنت الذي يجنيه قلبي % % على جسمي العداة ولا الخطوب % 38(@)(@@) % لئن أبصرتني رثا معاشي % % أطوف حول حظي أو أجوب % 39(@)(@@) % فتحت خصاصتي نفس عزوف % و حشو معاوزي كرم قشيب % 40(@)(@@) % سلي بيدي الطروس وعن لساني % % فوارك لا يلامسها خطيب % PageV01P119 41(@)(@@) % لها وطن المقيم بكل سمع % تمر به وسائرها غريب % 42(@)(@@) % بوالغ في مدى العلياء لو ما % % أعان ركودها يوما هبوب % 43(@)(@@) % لئن خفت على قوم ودقت % فما يدعى بها منهم مجيب % 44(@)(@@) % و نفرها رجال لم يروح % على أفهامهم منها عزيب % 45(@)(@@) % فعند مؤيد الملك اطمأنت % و ضم شعاعها المرعى الخصيب % 46(@)(@@) % فكم حق به وجد انتصافا % وظن في نداه لا يخيب % 47(@)(@@) % و واسعة الذراع يغر فيها % % عيون العيس رقاص خلوب % 48(@)(@@) % إذا استاف الدليل بنا ثراها % % أراب شميمه الترب الغريب % 49(@)(@@) % تخفضنا وترفعنا ضلالا % كما خبت براكبها الجنوب % 50(@)(@@) % إذا غنت لنا الأرواح فيها % % تطاربت العمائم والجيوب % PageV01P120 51(@)(@@) % عمائم زانها الإخلاق ليثت % على سنن وضاءتها الشحوب % 52(@)(@@) % قطعناها إليك على يقين % بأن الحظ رائده اللغوب % 53(@)(@@) % ترى ما لا ترى الأبصار منها % % كأن عيونها فيها قلوب % 54(@)(@@) % إلى ملك مخضرة رباه % جماد الرزق من يده يذوب % 55(@)(@@) % يغيض بنا ويملح كل ماء % و ماء بنانه عد شروب % 56(@)(@@) % تناهت عنه أقدام الأعادي % % كأن رواقه الغاب الأشيب % 57(@)(@@) % إذا ركب السرير علا فأوفى % على مرباته أقنى رقوب % 58(@)(@@) % يعول الأرض ما كسبت يداه % و ما كل ابن مرقبة كسوب % 59(@)(@@) % متين قوى العزيمة ألمعي % إذا ما ارتاب بالفكر الأريب 
ms42	 % 60(@)(@@) % يريه أمس ما في اليوم رأي % تمل على شهادته الغيوب % PageV01P121 61(@)(@@) % بذبك من وراء الملك قامت % % دعائم منه والتأمت شعوب % 62(@)(@@) % حملت له بقلبك ما تركت ال % % جبال به تفاخرها القلوب % 63(@)(@@) % تضرم فتنة وتضيق حال % و صدرك فيهما ثلج رحيب % 64(@)(@@) % و كم أشفى به داء عضال % و صنع الله فيك له طبيب % 65(@)(@@) % طلعت على البلاد وكل شمس % % تضيء قد استبد بها الغروب % 66(@)(@@) % و قد قنط الثرى وخوت أصول ال % % عضاه وصوح العشب الرطيب % 67(@)(@@) % و نار الجور عالية تلظى % % و داء العجز منتشر دبوب % 68(@)(@@) % فكنت الروض تجلبه النعامى % و ماء المزن منهمرا يصوب % 69(@)(@@) % كأنك غرة الإقبال لاحت % % بعقب اليأس والفرج القريب % 70(@)(@@) % هنا أم الوزارة أن أتاها % % على الإعقام منك ابن نجيب % PageV01P122 71(@)(@@) % و أنك سيد الوزراء معنى % به سميت والألقاب حوب % 72(@)(@@) % و لو أتت السماء بمثلك ابنا % لما كانت طوالعها تغيب % 73(@)(@@) % بك اجتمعت بدائدها ولا نت % % معاطفها ومعجمها صليب % 74(@)(@@) % فلا تتجاذب الحساد منها % % عرى يعيا يمرتها الجذيب % 75(@)(@@) % و لا يستروحوا نفحات عرف % لها بثياب غيرك لا تطيب % 76(@)(@@) % نصحت لهم لو أن النصح أجدى % % و لم يكن المشاور يستريب % 77(@)(@@) % و قلت دعوا لمالكها المعالي % % ففي أيديكم منها غصوب % 78(@)(@@) % خذوا جماته الأولى وخلوا % % أقاصي لا يخابطها ذنوب % 79(@)(@@) % فكم من شرقة بالماء تردى % % و إن كانت به تشفى الكروب % 80(@)(@@) % لك اليومان تكتب أو تشب ال % % وغى وكلاهما يوم عصيب % PageV01P123 81(@)(@@) % فيومك جالسا قلم خطيب % و يومك راكبا سيف خضيب % 82(@)(@@) % جمعت كفاية بهما وفتكا % % و مجمع ذين في رجل عجيب % 83(@)(@@) % و ضيقة المجال لها وميض % قطار سمائه العلق الصبيب % 84(@)(@@) % وقفت له حسامك مستبيح % محارمها وعفوك مستثيب % 85(@)(@@) % و مسود اللثات له لعاب % يجد الخطب وهو به لعوب % 86(@)(@@) % يخال على الطروس شجاع رمل % إذا ما عض لم يرق اللسيب % 87(@)(@@) % تغلغل منه في مهج الأعادي % % جوائف جرحها أبدا رغيب % 88(@)(@@) % إذا ملك الرقاب به 
ms43	 امترينا % % مضى قلم بكفك أم قضيب % 89(@)(@@) % و مضطهد طردت الدهر عنه % % و قد فغرت لتفرسه شعوب % 90(@)(@@) % إذا عصرت من الظمأ الأداوى % % على الإعياء أو ركب الجنيب % PageV01P124 91(@)(@@) % فنعم مناخ ظالعة وسقيا % ذراك الرحب أو يدك الحلوب % 92(@)(@@) % علا رخجية الأبيات خطت % على شماء ينصفها عسيب % 93(@)(@@) % لها عمد على صدر الليالي % % و فوق أوائل الدنيا طنوب % 94(@)(@@) % صفا حلب الزمان لها وقامت % % لدعوتها الممالك تستجيب % 95(@)(@@) % و ما من دولة قدمت وعزت % % و إلا ذكرها بكم يطيب % 96(@)(@@) % و منكم في سياستها رجال % فحول أو لكم فيها نصيب % 97(@)(@@) % كرام تسند الحسنات عنهم % % و تزلق عن صفاتهم العيوب % 98(@)(@@) % مضوا طلقا بأعداد المساعي % % و جئت ففت ما يحصى الحسيب % 99(@)(@@) % قناة أنت عاملها شروعا % % إلى نحر السما وهم الكعوب % 100(@)(@@) % و خير قبيلة شرفا ملوك % لمجدك منهم عرق ضروب % PageV01P125 101(@)(@@) % فلا وصح النهار ولست شمسا % % و لا أزرى بمطلعك المغيب % 102(@)(@@) % و لا برحت بك الدنيا فتاة % ترب كما اكتسى الورق القضيب % 103(@)(@@) % إذا ما حزتها انتفضت عطارا % % سوالفها بعدلك والتريب % 104(@)(@@) % و مات الدهر وانطوت الليالي % % و ملكك لا يموت ولا يشيب % 105(@)(@@) % و قام المهرجان فقال مثل ال % % ذي قلنا وآب كما نؤوب % 106(@)(@@) % و عادك زائرا ما كر ليل % لسعدك بين أنجمه ثقوب % 107(@)(@@) % بك استظللت من أيام دهري % % و من رمضائها فوقي لهيب % 108(@)(@@) % كفيتني السؤال فما أبالي % % سواك من المنوع أو الوهوب % 109(@)(@@) % و غرت على الكمال فصنت وجهي % % فليس لمائه الطامي نضوب % 110(@)(@@) % مكارم خضرت عودي وروت % ثراه وقد تعاوره الجدوب % PageV01P126 111(@)(@@) % تواصلني مثاني أو وحادا % % كما يتناصر القطر السكوب % 112(@)(@@) % فما اشكو سوى أني بعيد % و غيري يوم ناديكم قريب % 113(@)(@@) % أفوق عزمتي شوقا اليكم % % و يقبضني الحياء فلا أصيب % 114(@)(@@) % أصد وضمن دستك لي حبيب % عليه من جلالته رقيب % 115(@)(@@) % إذا امتلأت لحاظي منك نورا % % نزا قلبي فطار به الوجيب % 116(@)(@@) % يميل إليك بشرك لحظ عيني % % و يحبس عنك مجلسك 
ms44	 المهيب % 117(@)(@@) % و لو أني بسطت لكان سعي % وبل بلاله الشوق الغلوب % 118(@)(@@) % أبيت فما أجيب سواك داع % و لكني دعاءكم أجيب % 119(@)(@@) % فإن يكن انقباضي أمس ذنبا % % فمنذ اليوم أقلع أو أتوب % 120(@)(@@) % و تحضر نابيات عن لساني % % فواقر ربها عبد منيب % PageV01P127 121(@)(@@) % أوانس في فمي متيسرات % إذا ذعرت من الكلم السروب % 122(@)(@@) % إذا أعيت على الشعراء قيدت % إلي وظهر ريضها ركوب % 123(@)(@@) % بقيت وليس لي فيها ضريب % و لا لك في الجزاء بها ضريب % 124(@)(@@) % تصاغ لها الحماسة من معاني % % علاك ومن محاسنك النسيب % 125(@)(@@) % رعيت بهن من أملي سمينا % % لديك وحاسدي غيظا يذوب % 126(@)(@@) % و هل أظما وهذا الشعر سجل % أمد به وراحتك القليب % PageV01P128 البحر : - 1(@)(@@) % على أي أخلاق الزمان أعاتبه % و ما هو إلا صرفه ونوائبه % 2(@)(@@) % تفرى أديمي وهو بتر شفاره % و جافت جروحي وهو صم مخالبه % 3(@)(@@) % ندوب تقفي هذه عقب هذه % و داء إذا ما باخ أوقد صاحبه % 4(@)(@@) % شغلت يدي حينا بعد ذنوبه % و زدن فقد تاركته لا أحاسبه % 5(@)(@@) % طرحت سلاحي وانترعت تمائمي % % و ضاربه ينحى علي وسالبه % 6(@)(@@) % ببيض من الأيام هن سيوفه % و سود من الليلات هن عقاربه % 7(@)(@@) % أدامجه حتى يراني راضيا % % مرارا وأعصى مرة فأغاضبه % 8(@)(@@) % فلا هو إن أطريته قابض يدا % و لا خائف عارا بما أنا عائبه % 9(@)(@@) % نصحتك لا تخدع بسنة وجهه % فشاهده حسن تشوه غائبه % 10(@)(@@) % و لا تتمهد قعدة فوق ظهره % فما هو إلا ضيغم أنت راكبه % PageV01P129 11(@)(@@) % تردى رجال قبلنا وتقطرت % بهم شهبه دون المدى وشاهبه % 12(@)(@@) % و صرح عما ساءهم طول محضه % خبائث جرتها عليهم أطايبه % 13(@)(@@) % حبائل مكتوب لها نصر كيدها % % من الله لا يمحى الذي هو كاتبه % 14(@)(@@) % فمن مغلق مستعجل أو مؤخر % مراخيه يوما لا محالة جاذبه % 15(@)(@@) % تصاممت عن داعي المنون مغالطا % % و إني على طول السكوت مجاوبه % 16(@)(@@) % و قدمت غيري جنة أتقي بها % % و من يوق من راميه لا بد صائبه % 17(@)(@@) % أخلاى أيم 
ms45	 الله أطلب ثأركم % % من الدهر لو قد أدرك الثأر طالبه % 18(@)(@@) % أفي كل يوم لي قضيب مخالس % و ذخر نفيس منكم الموت غاصبه % 19(@)(@@) % و كاس من العلياء والحسن يعتدي % % سليما على سيفي وسوطى سالبه % 20(@)(@@) % تطيح به زندي وجهد تحفظي % % بميثاقه في الغيب أني نادبه % PageV01P130 21(@)(@@) % و كم منكم كالنجم رعت به الدجى % % زمانا خبا بعد الإضاءة ثاقبه % 22(@)(@@) % و آخر لما سامحتني بأصله ال % % منايا ذوت أغصانه وشعائبه % 23(@)(@@) % و أضحى بنوه غبطة وبناته % تسل بهم أنيابه ورواجبه % 24(@)(@@) % فينزو بلبي شجوه وتصيبني % % بموضعه من سر قلبي مصائبه % 25(@)(@@) % ألا يا أخي للود دنيا وكم أخ % لأمي بعيدات علي قرائبه % 26(@)(@@) % لحا الله خطبا شل سرحك طرده % و جمع في إلهاب قلبك حاطبه % 27(@)(@@) % رمتك يد الأيام عن قوس قارن % إذا هو والي لم تخنه صوائبه % 28(@)(@@) % سقتك بكف أدهقت لك ثانيا % % و لما يفق من أول بعد شاربه % 29(@)(@@) % فقرح وقرح لم تلاحم ندوبه % و دمع ودمع ما تعلق ساربه % 30(@)(@@) % و يا ليته لما تثنى تعلقت % مقاديره أو استوين مراتبه % PageV01P131 31(@)(@@) % و لكنها كف هوت إثر إصبع % % و حارك ظهر بعده جب غاربه % 32(@)(@@) % حصاتان من در حصانان لم تطر % يد بهما ما دنس الدر ثاقبه % 33(@)(@@) % هما بيضتا كن بجانب ملبس % حماه الطروق تيهه وسباسبه % 34(@)(@@) % حرام على الساري تضيع على القطا % % أفاحيصه في جوه ومساربه % 35(@)(@@) % يحوطهما ما استطاع وحف جناحه % شعارهما دون التراب ترائبه % 36(@)(@@) % تراه يصادى حاجب الشمس عنهما % % لو أن الردى ما أحرز الشيء هائبه % 37(@)(@@) % رزئتهما شمسين أقسم فيهما % % ظلام الأسى ألا تجلى غياهبه % 38(@)(@@) % يعدون خرقا بالفتى في بناته % إذا ما بكى أو ذل للحزن جانبه % 39(@)(@@) % و كم من كريم عزه نجباؤه % % فعز بما ساقت إليه نجائبه % 40(@)(@@) % و بعض البنات من بها ينتج العلا % % و بعض بني الإنسان في الحي عائبه % PageV01P132 41(@)(@@) % فإلا تكونا صارمين فحذوتا % % حسام عتيق لا تفل مضاربه % 42(@)(@@) % أخي الحلم لم يملك عليه 
ms46	 حياؤه % % و لا كذبته في الزمان تجاربه % 43(@)(@@) % إذا ولد استذكرن حزما إناثه % كما ذكرت أخلاقه وضرائبه % 44(@)(@@) % تعز ابن روح إنما الموت مدلج % إلى أمد فيه النفوس مراكبه % 45(@)(@@) % و من أخرته شمس يوم فلم يمت % % يمت حوله أحبابه وحبائبه % 46(@)(@@) % و أعجب من ذي خبرة بزمانه % % تنكر منه أن توالى عجائبه % 47(@)(@@) % خلقنا لأمر أرهقتنا صدوره % فيا ليت شعري ما تجر عواقبه % 48(@)(@@) % غريم ملط لا يمل وطالب % بغير ترات لا تنام مطالبه % 49(@)(@@) % و قد جربتك الحادثات فلا تكن % % ضعيف القوى رخوا لهن مجاذبه % 50(@)(@@) % و غيرك مغلوب على حسن صبره % و لا خطب إلا أنت بالصبر غالبه % PageV01P133 51(@)(@@) % برغمي أن يسرى غزي من الأسى % % اليك ولم تفلل بنصري كتائبه % 52(@)(@@) % و إن كان خصما لا لساني ينوشه % % و لا كلماتي الغاسقات تواقبه % 53(@)(@@) % و يا لدفاعي عنك إن كان صارما % % أصافحه أو كان ليثا أواثبه % 54(@)(@@) % و من لي لو أن الحزن يرعى جوانحي % % فدى لك لو يرضى بقلبي ناصبه % 55(@)(@@) % فما هي إلا مهجة لك شطرها % % و موهوب عيش أنت ما عشت واهبه % 56(@)(@@) % و إن كان يطفي حر لوعتك البكا % % على أنه جاريه لا بد ناضبه % 57(@)(@@) % فدونك دمعي سائلا ومعلقا % % فجامده باق عليك وذائبه % 58(@)(@@) % عتبت على دهري فسهل عذره % بأنك باق كل ما هو جالبه % 59(@)(@@) % إذا سلم البدر التمام فهين % على الليل أن تهوى صغارا كواكبه % PageV01P134 البحر : - 1(@)(@@) % هل عند عينيك على غرب % غرامة بالعرض الخلب % 2(@)(@@) % نعم . دموع يكتسى تربه % منها قميص البلد المعشب % 3(@)(@@) % ساربة تركب أردافها % % معلقات بعد لم تسرب % 4(@)(@@) % ترضى بهن الدار سقيا وإن % % قال لها نوء السماك اغضبني % % 5(@)(@@) % علامة أني لم أنتكث % مرائر العهد ولم أقضب % 6(@)(@@) % يا سائق الأظعان لا صاغرا % % عج عوجة ثم استقم واذهب % 7(@)(@@) % دع المطايا تلتفت إنها % % تلوب من جفني على مشرب % 8(@)(@@) % لا والذي إن شاء لم أعتذر % في حبه من حيث لم أذنب % 9(@)(@@) % ما حدرت ريح 
ms47	 الصبا بعده % % لثامها عن نفس طيب % 10(@)(@@) % و لا حلا البذل ولا المنع لي % % مذهو لم يرض ولم يغضب % PageV01P135 11(@)(@@) % كم لي على البيضاء من دعوة % لولا اصطخاب الحلي لم تحجب % 12(@)(@@) % و حاجة لولا بقياتها % % في النفس لم أطرب ولم أرغب % 13(@)(@@) % يا ماطلي بالدين ما ساءني % % إليك تريد المواعيد بي % % 14(@)(@@) % إن كنت تقضي ثم لا نلتقي % % فدم على المطل وعد واكذب % 15(@)(@@) % سال دمي يوم الحمى من يد % لولا دم العشاق لم تخضب % 16(@)(@@) % نبل رماة الحي مطرورة % أرفق بي من أعين الربرب % 17(@)(@@) % يا عاذلي قد جاءك الحزم بي % % أقاد فاركبني أو فاجنب % 18(@)(@@) % قد سد شيبي ثغري في الهوى % % فكيف قصى أثر المهرب % 19(@)(@@) % أفلح إلا قانص غادة % مد بحبل الشعر الأشيب % 20(@)(@@) % ما لبنات العشر والعشر في % % جد بني الخمسين من ملعب % PageV01P136 21(@)(@@) % شيات أفراس الهوى كلها % % تحمد فيهن سوى الأشهب % % 22(@)(@@) % أما تريني ضاويا عاريا % من ورق المتلحف المخصب % 23(@)(@@) % محتجزا أندب من أمسى ال % % ماضي أخا مات ولم يعقب % 24(@)(@@) % فلم يلثم ظبتي عاملي % % ما حطم الساحب من أكعبي % % 25(@)(@@) % يوعدني الدهر بغدراته % قعقع لغير الليث أو هبهب % 26(@)(@@) % قد غمزت كفك في مروتي % % فتحت أي الغمز لم أصلب % 27(@)(@@) % أمفزعي أنت بفوت الغنى % % تلك يدالطالي على الأجرب % 28(@)(@@) % دع ماء وجهي مالئا حوضه % % و كل سمينا نشبي واشرب % 29(@)(@@) % إن أغلب الحظ فلي عزمة % بالنفس لم تقمر ولم تغلب % 30(@)(@@) % ذم الأحاظي طالب لم يجد % فكيف وجداني ولم أطلب % PageV01P137 31(@)(@@) % آه على المال وما يجتنى % % منه لو أن المال لم يوهب % 32(@)(@@) % راخ على الدنيا إذا عاسرت % و إن أتت مسمحة فاجذب % 33(@)(@@) % و لا تعسف كد أخلافها % % فربما درت ولم تعصب % 34(@)(@@) % هذا أوان استقبلت رشدها % % بوقفة المعتذر المعتب % 35(@)(@@) % و ارتجعت ما ضل من حلمها % % من بين سرح الذائد المغرب % 36(@)(@@) % و ربما طالع وجه المنى % % من شرف اليأس ولم يحسب % 37(@)(@@) % قل لذوي الحاجات مطرودة % و ابن السبيل 
ms48	 الضيق المذهب % 38(@)(@@) % و قاعد يأكل من لحمه % تنزها عن خبث المكسب % 39(@)(@@) % قد رفعت في بابل راية % للمجد من يلق بها يغلب % 40(@)(@@) % يصيح داعي النصر من تحتها % % يا خيل محيي الحسنات اركبي % % PageV01P138 41(@)(@@) % جاء بها الله على فترة % بأية من يرها يعجب % 42(@)(@@) % هاجمة الإقبال لم تنتظر % بواسع الظن ولم ترقب % 43(@)(@@) % لم تألف الأبصار من قبلها % % أن تطلع الشمس من المغرب % 44(@)(@@) % ردوا فقد زاركم البحر لم % % يخض له الهول ولم يركب % 45(@)(@@) % يشف للأعين عن درة ال % % ثمين صافي مائه الأعذب % 46(@)(@@) % فارتبعوا بعد مطال الحيا % % و روضوا بعد الثرى المجدب % 47(@)(@@) % قد عاد في طيء ندى حاتم % و قام كعب سيد الأكعب % 48(@)(@@) % و عاش في غالب عمرو العلا % % يهشم في عامهم الملزب % 49(@)(@@) % و ارتجعت قحطان ما بزها % % من ذي الكلاع الدهر أو حوشب % 50(@)(@@) % ورد بيت في بني دارم % زرارة من حوله محتبى % % PageV01P139 51(@)(@@) % كل كريم أو فتى كامل % و فاعل أو قائل معرب % 52(@)(@@) % فاليوم شك السمع قد زال في % % أخباره بالمنظر الأقرب % 53(@)(@@) % إلى الوزير اعترقت نيها % % كل أمون وعرة المجذب % 54(@)(@@) % تعطي الخشاشات ليانا على % % أنف لها غضبان مستصعب % 55(@)(@@) % مجنونة الحلم وما سفهت % بالسوط خرقاء ولم تجنب % 56(@)(@@) % ييأس فحل الشول من ضربها % % لعزة النفس ولم تكتب % 57(@)(@@) % لو وطئت شوك القنا نابتا % في طرق العلياء لم تنقب % 58(@)(@@) % يخط في الأرض لها منسم % دام متى يمل السرى يكتب % 59(@)(@@) % كأن حاذيها على قارد % أحمش مسنون القرا أحقب % 60(@)(@@) % طامن في الرمل له قانص % أعجف لم يحمض ولم يرطب % PageV01P140 61(@)(@@) % ذو وفضة يشهد إخلاقها % % بأنها عامين لم تنكب % 62(@)(@@) % مهما تخلله بنياتها % % من ودج أو ورك يعطب % 63(@)(@@) % فمر لم يعطف على عانة % ذعرا ولم يرأم على تولب % 64(@)(@@) % به خدوش يتعجلنه % قدائم من لاحق الأكلب % 65(@)(@@) % بأي حس ريع خيلت له % % رنة قوس أو شبا مخلب % 66(@)(@@) % يذرع أدراج الفيافي بها % % كل غريب الهم والمطلب % 67(@)(@@) % يرمي بها 
ms49	 ليل جمادى إلى % % يوم من الجوزاء معصوصب % 68(@)(@@) % في عرض غبراء رياحية % عجماء لم تسمر ولم تنسب % 69(@)(@@) % يشكل مشهور الركايا بها % % على مصانيف القطا اللغب % 70(@)(@@) % حتى أنيخت وصدوع السرى % % بالنوم في الأجفان لم تشعب % PageV01P141 71(@)(@@) % و شملة الظلماء مكفورة % تحت رداء القمر المذهب % 72(@)(@@) % إلى ظليل البيت رطب الثرى % % عالي الأثافي حافل المحلب % 73(@)(@@) % مختضب الجفنة ضخم القرى % % إذا يد الجازر لم تخضب % 74(@)(@@) % ترفع بالمندل نيرانه % إذا إماء الحي لم تحطب % 75(@)(@@) % له مجاويف عماق إذا % % ما القدر لم توسع ولم ترحب % 76(@)(@@) % كل ربوض عنقها بارز % مثل سنام الجمل الأنصب % 77(@)(@@) % تعجلها زحمة ضيفانه % أن تتأنى حظب الملهب % 78(@)(@@) % أبلج في كل دجى شبهة % لو سار فيها النجم لم تثقب % 79(@)(@@) % موقر النادي ضحوك الندى % % يلقاك بالمرغب والمرهب % 80(@)(@@) % تلحظه الأبصار شزرا وإن % % أكثر من أهل ومن مرحب % PageV01P142 81(@)(@@) % مر وإن أجدتك أخلاقه % شمائل الصهباء لم تقطب % 82(@)(@@) % ينحط عنه الناس من فضلهم % % منحدر الردف عن المنكب % 83(@)(@@) % أتعبه تغليسه في العلا % % من طلب الراحة فليتعب % 84(@)(@@) % من معشر لم يهتبل عزهم % % بغلط الحظ ولم يجلب % 85(@)(@@) % و لا علا ابن منهم طالعا % % من شرف إلا وراء الأب % 86(@)(@@) % تسلقوا المجد وداسوا العلا % % و طرقها يهماء لم تلحب % 87(@)(@@) % و وافقوا الأيام فاستنزلوا % % أبطالها في مقنب مقنب % 88(@)(@@) % قوم إذا أخلف عام الحيا % % لم تختزلهم حيرة المسغب % 89(@)(@@) % أو بسط الله ربيعا لهم % % لم يبطروا في سعة المخصب % 90(@)(@@) % سموا وأصبحت سماء لهم % % يطلع منها شرف المنسب % PageV01P143 91(@)(@@) % زدت وما انحطوا ولكنها % % إضاءة البدر على الكوكب % 92(@)(@@) % خلقت في الدنيا بلا مشبه % أغرب من عنقائها المغرب % 93(@)(@@) % لا يجلس الحلم ولا يركب ال % % خوف ولم تجلس ولم تركب % 94(@)(@@) % إن جنح الأعداء للسلم أو % % تلاوذوا منك إلى مهرب % 95(@)(@@) % كتبت لو قلت فقال العدا % % أعزل لم يطعن ولم يضرب % 96(@)(@@) % أو ركبوا البغي إلى غارة % طعنت حتى قيل لم يكتب % 97(@)(@@) % فأنت ملء العين والقلب ما 
ms50	 % % تشاء في الدست وفي الموكب % 98(@)(@@) % و رب طاو غلة بائت % من جانب الشر على مرقب % 99(@)(@@) % ينظر من أيامه دولة % بقلم الأقدار لم تكتب % 100(@)(@@) % راعته من كيدك تحت الدجى % % دبابة أدهى من العقرب % PageV01P144 101(@)(@@) % فقام عنها باذلا بسلة ال % % راقي ولم يرق ولم يسلب % 102(@)(@@) % بك اشتفى الفضل وأبناؤه % % بعد عموم السقم المنصب % 103(@)(@@) % و التقم الملك هدى نهجه % و كان يمشي مشية الأنكب % 104(@)(@@) % وزارة قلبها شوقها % % منك إلى حولها القلب % 105(@)(@@) % جاءتك لم توسع لها مرغبا % % وليها المهر ولم تخطب % 106(@)(@@) % كم أجهضت قبلك من عدهم % % لها شهور الحامل المقرب % 107(@)(@@) % و ولدت وهي كأن لم تلد % أم إذا ما هي لم تنجب % 108(@)(@@) % قمت بمعناها وكم جالس % تكفيه منها سمة المنصب % 109(@)(@@) % و هي التي إن لم يقد رأسها % % بمحصدات الصبر لم تصحب % 110(@)(@@) % مزلقة راكب سيسائها % % راكب ظهر الأسد الأغلب % PageV01P145 111(@)(@@) % راحت على عطفك أثوابها % % طاهرة المرفع والمسحب % 112(@)(@@) % فتحت في مبهم تدبيرها % % تنفس البلجة في الغيهب % 113(@)(@@) % و ارتجعت منك رجالاتها % % كل مطيل في الندى مرغب % 114(@)(@@) % رد بنو يحيى و سهيل لها % % و الطاهريون بنو مصعب % 115(@)(@@) % فاضرب عليها بيت ثاو بها % % قبلك لم يعمد ولم يطنب % 116(@)(@@) % و استخدم الأقدار في ضبطها % % و استشر الإقبال واستصحب % 117(@)(@@) % و امدد على الدنيا وجهلاتها % % ظلال حلم لك لم يعزب % 118(@)(@@) % و اطلع على النيروز شمسا إذا % % ساق الغروب الشمس لم تغرب % 119(@)(@@) % تفضل ما كر سني عمره % بملء كف الحاسب المطنب % 120(@)(@@) % يوم من الفرس أتى وافدا % فقالت العرب له قرب % PageV01P146 121(@)(@@) % بات من الإحسان في داركم % % و هو غريب غير مستغرب % 122(@)(@@) % لو شاء من ينسب لم يعزه % لغيركم عيدا ولم ينسب % 123(@)(@@) % و اسمع لمغلوب على حظه % % لو أنك الناصر لم يغلب % 124(@)(@@) % موحد لم يشك من دهره % % و أهله إلا إلى مذنب % 125(@)(@@) % أقصاه عند الناس إدلاؤه % % من فضله بالنسب الأقرب % 126(@)(@@) % لو قيض إنصافك قدما له % % عز فلم يقص 
ms51	 ولم يقصب % 127(@)(@@) % عندك من برقي لماعة % سابقة تشهد للغيب % 128(@)(@@) % منثورها ذاك ومنظومها % % هذا كلا الدرين لم يثقب % 129(@)(@@) % ما زلت أرجوك ومن آيتى % % أن رجائي فيك لم يكذب % 130(@)(@@) % لم يبق لي بعدك عتب على % % خظ ولا فقر إلى مطلب % PageV01P147 131(@)(@@) % فاغرس ونوه منعما واصطنع % % ترض مضاء الصارم المقضب % 132(@)(@@) % و غر على رقي من خامل % لملك مثلي غير مستوجب % 133(@)(@@) % كم أحمدت قبلك عنقي يد % لكنها سامت ولم تضرب % % 134(@)(@@) % و لدنة الأعطاف لم تعتسف % بالكلم المر ولم تتعب % 135(@)(@@) % من الحلال العفو لم تستلب % بغارة الشعر ولم تنهب % 136(@)(@@) % دم الكرى المهراق فيها على % % سامعها إن هو لم يطرب % 137(@)(@@) % جاءك معناها وألفاظها % % في الحسن بالأسهل والأصعب % 138(@)(@@) % أفصح ما قيل ولكنها % % فصاحة تهدى إلى يعرب % PageV01P148 البحر : - 1(@)(@@) % ضمانة يصدق وعد الضنا % % فيها جناها الطمع الكاذب % 2(@)(@@) % عاد بها اليوم جديد الهوى % % و قد تولى أمسها الذاهب % 3(@)(@@) % أية نار قدحت في الحشا % % عين مهاة زندها ثاقب % 4(@)(@@) % و أي ثغر ولمي صادني % % نابل قلبي بهما الصائب % 5(@)(@@) % حبا له من برد جامد % يقطر منه ضرب ذائب % 6(@)(@@) % الله يا حسناء في مهجة % أنت بها الثائر والطالب % 7(@)(@@) % إن كنت حرمت وصالي فمن % % أين دمي حل لكم واجب % % 8(@)(@@) % سلي سهام الشوق عن أضلعي % % إن صدقت عينك والحاجب % 9(@)(@@) % من موقد النار وقد أخمدت % على فؤادي ومن الحاطب % PageV01P149 البحر : - 1(@)(@@) % يا دار لا أنهج القشيب % منك ولا صوح الرطيب % 2(@)(@@) % و لا أخلت بك الغوادي % % تشعب ما يصدع الجدوب % 3(@)(@@) % من كل مخروقة العزالي % % تغلب أخياطها الثقوب % 4(@)(@@) % تعجب منها رباك حتى % % يضحك فيها الوجه القطوب % 5(@)(@@) % و كان عطرا كما عهدنا % % مشي الصبا فيك والهبوب % 6(@)(@@) % فرب ليل ثراك فيه % % بين بحور العشاق طيب % 7(@)(@@) % عجنا وليل المطي ليل % بعد وصوت الحادي صليب % 8(@)(@@) % و ما نقضناه من طريق % من حيث رحنا عنه قريب % 9(@)(@@) % فقال صحبي أضل هاد % أم خدع الحازم الأريب % 10(@)(@@) % ليس 
ms52	 أوان التعريس هذا % % قلت هو الشوق لا اللغوب % PageV01P150 11(@)(@@) % يا من رأى باللوى بريقا % تقدح نيرانه الجنوب % 12(@)(@@) % كلا ولا بينما تراه % يطلع أبصرته يغيب % 13(@)(@@) % كأن ما لاح منه وهنا % على شباب الدجى مشيب % 14(@)(@@) % حدثني بالغضا حديثا % % سر على أنه خلوب % 15(@)(@@) % يقول هيفاء لم يحلها % % عن عهدك الناقل الكذوب % 16(@)(@@) % جفونها بعدكم حنوا % % ماء وأحشاؤها لهيب % 17(@)(@@) % فارض فمن قلبها خفوقي % % أعدي ومن طرفها أصوب % 18(@)(@@) % لا وليال على المصلي % % تسرق في نسكها الذنوب % 19(@)(@@) % و ما رأى الجبف من هنات % يغفرها المالك الوهوب % 20(@)(@@) % و خلوات بأم سعد % ما بعدها لذة تطيب % PageV01P151 21(@)(@@) % لولا لماها لما شفاني % % بزمزم ما سقى القليب % 22(@)(@@) % ماذا على محرم بجمع % و سهمه من دمى خضيب % 23(@)(@@) % و كيف والصيد ثم بسل % تصاد بالأعين القلوب % 24(@)(@@) % يا فتكها نظرة خلاسا % % سبب أدواءها الطبيب % 25(@)(@@) % ذابت عليها حصاة قلبي % % يا من رأى جمرة تذوب % 26(@)(@@) % قل لزماني ما شئت فاضغط % % قد دبر الجابر الجليب % 27(@)(@@) % أصبتني بالخطوب حتى % % لم تبق لي مقتلا تصيب % 28(@)(@@) % في كل يوم جور غريب % عندي عليه صبر غريب % 29(@)(@@) % حتى لقد صار عجيبا % % منك الذي كله عجيب % 30(@)(@@) % و لائم في عزوف نفسي % % قلت له أنت والخطوب % PageV01P152 31(@)(@@) % عساك خبرا بالناس مثلي % % إن رد من حلمك العزيب % 32(@)(@@) % ففي قلي من تراك تلحى % % منهم وفي ترك من تعيب % 33(@)(@@) % الله لي إن طرحت عرضي % % أكلة آمالهم حسيب % 34(@)(@@) % قد كنت أبكي وهم فروق % شتى وأشكو وهم ضروب % 35(@)(@@) % فاليوم سوتهم المساوي % % عندي وعمتهم العيوب % 36(@)(@@) % فما أرى منهم بريئا % % يخشى افتضاحا به المريب % 37(@)(@@) % بلى قد استثنت المعالي % % بيتا لها فخره نسيب % 38(@)(@@) % بيتا شموس الضحى عماد % له وشهب الدجى طنوب % 39(@)(@@) % الحسب العد من بينه % كل نجيب نمى نجيب % 40(@)(@@) % من آل عبد الرحيم مرد % حول رواق العلا وشيب % PageV01P153 41(@)(@@) % تشابهوا سوددا فأعطى % % شاهدهم فضل من يغيب % 42(@)(@@) % كل محيا الجبين طلق % لم يعتسف بشره القطوب 
ms53	 % 43(@)(@@) % راضون أن يشبعوا ويضووا % % و العام مسحنفز غصوب % 44(@)(@@) % تروى عطاش الآمال فيهم % % و هي على غيرهم تلوب % 45(@)(@@) % لهم أفاويقها إذا ما % % أصرم ثدي الحيا الحلوب % 46(@)(@@) % دوحة مجد أبو المعالي % % غصن جناها الغض الرطيب % 47(@)(@@) % كان فتاها والرأي كهل % و طفلها والحجا لبيب % 48(@)(@@) % ليث حماها والدار حرب % و في السلام الظبي الربيب % 49(@)(@@) % لا فرحة تستقل منه % % حلما ولا نوبة تنوب % 50(@)(@@) % تغمز فيه أيدي الليالي % % و النبع مستعصم صليب % PageV01P154 51(@)(@@) % إذا كساه الغنى قميصا % % فهو بأيدي الندى سليب % 52(@)(@@) % و كل سعي له كسوب % تغرمه كفه الوهوب % 53(@)(@@) % يحمي حماه بنافذات % خدوشها في العدا ندوب % 54(@)(@@) % لا يبلغ السبر ما يفري % % معمقا جرحها الرغيب % 55(@)(@@) % يبعثها مفصحا لسان % ماض إذا لجلج الخطيب % 56(@)(@@) % إذا فروج الكلام ضاقت % تم بها باعه الرحيب % 57(@)(@@) % لا محقت بدرك الدآدي % % و لا محا شمسك الغروب % 58(@)(@@) % و رجع الدهر مستقيلا % % اليك من ذنبه ينوب % 59(@)(@@) % يقسم لا شيم وهو سيف % بعد ولا شم وهو ذيب % 60(@)(@@) % و عاد ظل الدنيا عليكم % % يورق أو ينمر القضيب % PageV01P155 61(@)(@@) % حظكم صفوها وحظ ال % % أعداء منها المر المشوب % 62(@)(@@) % ما كر عودا شباب ليل % يردفه من ضحى مشيب % 63(@)(@@) % و زار يوم النيروز عام ال % % خضب كما زارك الحبيب % 64(@)(@@) % تهدى لكم من ثناي عون % كل ابن سمع لها طروب % 65(@)(@@) % قواطن فيكم وتمسى % % تجول في الأرض أو تجوب % 66(@)(@@) % في كل يوم تغشاك منها % % حبيبة ما لها رقيب % 67(@)(@@) % كذاك لا غائبي خبيث % لكم ولا شاهدي مريب % 68(@)(@@) % قلبي صحيح لكم وودي % % ما مرض الود والقلوب % 69(@)(@@) % أجببتكم قبل أن دعوتم % % فكيف أدعى فلا أجيب % PageV01P156 البحر : - 1(@)(@@) % لعلها واليأس منها أغلب % إن نأت اليوم غدا تستقرب % 2(@)(@@) % حاجة صدر لك لا ملفوظة % و لا تسوغ حلوة فتشرب % 3(@)(@@) % أضحك من مواعد الدهر بها % % مما يجيء باطلا ويذهب % 4(@)(@@) % و دونها أن ينتهي لجاجها % % ذو صبغتين دينه التقلب % 5(@)(@@) % في كل يوم مرسل 
ms54	 مغالط % لي عنده وشافع محبب % 6(@)(@@) % و حلفة كاذبة وفي فمي % % شكيمة من أن أقول تكذب % 7(@)(@@) % مل فلا الحصاة من فؤاده % % تلين لي ولا اللسان يرطب % 8(@)(@@) % الله يا هيفاء لي في زمن % نعيمه بعدكم معذب % 9(@)(@@) % و كبد يصدعها كل أسى % بها الكبود القرحات تشعب % 10(@)(@@) % لا سلوة البعد المريح عصمة % منك ولا الهم المراح يعزب % PageV01P157 11(@)(@@) % و كلما أطمع فيك سبب % آمله أياس منك سبب % 12(@)(@@) % يعيش قلبي وهو عيش مؤلم % ثم يموت وهو موت طيب % 13(@)(@@) % نفسك يا معطي الهوى قياده % % إنك في خيط الهوان تجنب % 14(@)(@@) % و إن هويت فانتصر بغدرة % عن ثقة أن الوفاء العطب % 15(@)(@@) % قالت على البيضاء أخت عامر % أسفر في فوديك ذاك الغيهب % 16(@)(@@) % و من بلاياك وإن عبت به % % شباب حبي وعذاري الأشيب % 17(@)(@@) % غدرك والخمسون أي روضة % قشيبة بينهما لا تجدب % 18(@)(@@) % و ما الذي أنكرته من ليلة % يطلع فيها قمر أو كوكب % 19(@)(@@) % ما نصلت إلا بماء مقلتي % % فليتها بماء قلبي تخضب % 20(@)(@@) % و عاذل لا سقيت غلته % بالغور ما يروى ولا ما يعذب % PageV01P158 21(@)(@@) % يزعم أن كل دار رامة % و أن كل ذات حجل زينب % 22(@)(@@) % حلفت يوم ينحر الناس بها % % ساجدة أذقانها والركب % 23(@)(@@) % يعطى المنى منها الذي يستامه % طلى تطيح وجنوب تجب % 24(@)(@@) % مثل التلاع بازلا وحقة % قام عليهن الربيع المخصب % 25(@)(@@) % و المشرفات من منى كأنها % % على ظهور الهضبات حدب % 26(@)(@@) % و بالملبين سعوا فنفضوا % % ذنوبهم وجمروا وحصبوا % % 27(@)(@@) % و ما حوى وأي فضل ما حوى % % ذاك العتيق البارز المحجب % 28(@)(@@) % لو نسب المجد لما كان إلي % % غير بني عبد العزيز ينسب % 29(@)(@@) % من أرضهم طينته وفيهم % رواقه وبيته المطنب % 30(@)(@@) % أقسم لا فارقهم وأقسموا % % ما دام خلدا من أبان منكب % PageV01P159 31(@)(@@) % حي على رغم البدور غررا % تقدح في فحم الدجى فتثقب % 32(@)(@@) % ورد نفوسا حرة وأيديا % % تحيل في المحل عليها السحب % 33(@)(@@) % تبادروا الجود فلاطوا حوضه % لهم ليالي ورده والقرب % 34(@)(@@) % و انتظموا 
ms55	 سوددهم القنا % % لكن صدور ليس فيها أكعب % 35(@)(@@) % داسوا بأعقابهم هام العلا % % و اقتعدوا ظهورها واعتقبوا % % 36(@)(@@) % شم الأنوف والسيوف قصرت % دروعهم وهي سباغ تسحب % 37(@)(@@) % يمشون رجلي فيخال أنهم % % من شارة ومن شطاط ركبوا % % 38(@)(@@) % توارثوا الملك فلا خلافة % إلا لهم سريرها والموكب % 39(@)(@@) % و منهم في حربها وسلمها % % رمح يخط ولسان يخطب % 40(@)(@@) % حلي كل دولة عاطلة % و بشر كل نعمة تقطب % PageV01P160 41(@)(@@) % إذا الخطوب حسمت بخدعة % أو ردعة لانوا لها وصعبوا % % 42(@)(@@) % إن كتبوا قلت اصطلاما طعنوا % % أو طعنوا قلت بلاغا كتبوا % % 43(@)(@@) % ترى الجبال في الحبى إن جلسوا % % و الأسد هيج شرها إن وثبوا % % 44(@)(@@) % لهم قدامى الفخر ما تنقله % لك الرواة وتريك الكتب % 45(@)(@@) % و خير ما استطرفته حديثهم % % إذا الكرام زانهم ما أعقبوا % % 46(@)(@@) % و ولدوا أبا الحسين فرأى ال % % مجد به كيف نموا وأنجبوا % % 47(@)(@@) % برزت في عقدهم واسطة % لها من الأبصار ما يستلب % 48(@)(@@) % بيضاء مما أبغض الغواص في ال % % فحص عليها أنفسا تحبب % 49(@)(@@) % و مطلتهم دونها أمنية % رواغة وحقب وحقب % 50(@)(@@) % حتى قضى الصبر لهم قضاءه % و استحييت الأيام مما نصبوا % % PageV01P161 51(@)(@@) % فاستخرجوها تملأ الراحة وال % % عين فقالوا درة أم كوكب % 52(@)(@@) % و شرفت فلقبت فخر العلا % % لو لم يقع دون سناها اللقب % 53(@)(@@) % و كيف لا تطلع بدرا فيهم % و الشمس جد لك والنجم أب % 54(@)(@@) % ألقى الكمال طائعا عنانه % اليك يرخى تارة ويجذب % 55(@)(@@) % و أقعص الأقران عنك قلم % ممرن وخاطر مدرب % 56(@)(@@) % و قمت قرحانا فتيا بالعلا % % قيد عنك القارح المجرب % 57(@)(@@) % ورثت فضلا لو قنعت لكفي % % لكن أبيت غير ما تكتسب % 58(@)(@@) % كالليث لا تحلو له فريسة % لا ينتقي فيها ولا يخلب % 59(@)(@@) % و كم سواك لم يجز حسابه % أعداد ما تملي عليه الحسب % 60(@)(@@) % حويت إعظاما وقد مثلت لي % % رائد عيني وقلت تكذب % PageV01P162 61(@)(@@) % أدمية صيغت أم البدر هوى % % و بشر أم ملك مقرب % 62(@)(@@) % معجزة جاء الزمان غلطا % % بها وآوى كلهن عجب % 63(@)(@@) % و 
ms56	 كرم على اللسان حاضر % يشف منه الكرم المغيب % 64(@)(@@) % و راحة مطلقة طارحها ال % % عرض المصون أن يهون النشب % 65(@)(@@) % سحرتني ودار عزي بابل % % و قدتني وأم رأسي تصعب % 66(@)(@@) % و ملكتني لك نشوان الهوى % % خلائق غناؤهن مطرب % 67(@)(@@) % ملأت بالبشر وطاب أملي % % و بعضهم بكيئة لا تحلب % 68(@)(@@) % حتى رقى الحاوي فأصيغت له % % و كدت مع شدة زهدي أرغب % 69(@)(@@) % و قلت عاش لزهير هرم % و قام في أهل الزبير مصعب % 70(@)(@@) % أرضيتني عن الزمان بعد ما % % حرق أضلاعي عليه الغضب % PageV01P163 71(@)(@@) % و عاد بردا وسلاما بك لي % % ما توقد الدنيا وما تحتطب % 72(@)(@@) % أغنيتني قبل اللها مودة % و الود عندي خير رفد يوهب % 73(@)(@@) % و قربتني منك أولى نظرة % حتى كأنا لم نزل نصطحب % 74(@)(@@) % فراسة أيقظك المجد لها % % و فطنة على سواك تعزب % 75(@)(@@) % و همة إذا ركبت ظهرها % % أدركت من أخرى العلا ما تطلب % 76(@)(@@) % فاسمع أقرطك شنوفا درها % % لغير آذانكم لا يثقب % 77(@)(@@) % من المصونات التي تعنست % خلف الخدور وهي بكر تخطب % 78(@)(@@) % تنافس الملوك في مهورها % % و اقترعوا في حبها واحتربوا % % 79(@)(@@) % عندهم الرغبة والود لها % % و عندها الملال والتجنب % 80(@)(@@) % و زادها نزاهة وورعا % مني أب على البنات حدب % PageV01P164 81(@)(@@) % ليس عليه للتمني طاعة % و لا له في الشهوات أرب % 82(@)(@@) % لا يمدح الناس ولكن مدحكم % % يلزم في دين العلا ويجب % PageV01P165 البحر : - 1(@)(@@) % نأت والأماني بها تقرب % و ملت وأحسبها تعتب % 2(@)(@@) % و مال بها الغدر غدر الطبا % % ع عني والكاشح المجلب % 3(@)(@@) % و غيران يذعره اسمي بكم % % و يؤنسه حوله المقنب % 4(@)(@@) % يكون لغيري جناح البعو % % ض لينا ولي قومه المصعب % 5(@)(@@) % و منتحل في الهوى يدعى % % مقامي وشاهده يكذب % 6(@)(@@) % تبدل بي ساء ذاك البديل % كما بيع في الأخبث الأطيب % 7(@)(@@) % فيا عجبي من مريق دمي % % عنادا وقلبي به معجب % 8(@)(@@) % و مستهزي ضاحك من بكاي % % يجد بقلبي كما يلعب % 9(@)(@@) % أهيفاء أي هوى قد علم % % ت يقصى وأي أخ يقصب 
ms57	 % 10(@)(@@) % و لما انطوى العام نفسي تر % % د عنك وحافزها يطلب % PageV01P166 11(@)(@@) % صددت كما انصرفت بالصدى % % غرائب أوجهها تضرب % 12(@)(@@) % أقول غدا نظرا للوفاء % % و غدركم من غد أقرب % 13(@)(@@) % و كيف اللقاء وقد سدت ال % % مطالع يا ذلك الكوكب % 14(@)(@@) % و أين النجاء وما الحظ فيه % % و منك وأنت المنى المهرب % 15(@)(@@) % سل الهاجعين على ذي الطلوح % % و طرفي لهم حارس يرقب % 16(@)(@@) % اشمتم يمينا سنا بارق % يشوق على أنه خلب % 17(@)(@@) % تألق مستشرفا لا يسل % حتى يرى سيفه يقرب % 18(@)(@@) % يبين ريخفى رؤس الهضاب % فتنصل منه كما تخضب % 19(@)(@@) % يمر فيرغب في أضلعي % % صدوعا برجعتة تشعب % 20(@)(@@) % و هل عنده خبر إن سأل % % ت ما البانتان وما زينب % PageV01P167 21(@)(@@) % و هل ربع غرب في الباليا % % ت أم هل على عهدنا غرب % 22(@)(@@) % سقى بالحمى الأعين النابلا % % ت من دم أحشاي ما تشرب % 23(@)(@@) % و حيا الحيا أوجها لا تغش % لجين الجمال بها مذهب % 24(@)(@@) % و في السانحات بذاك الرمي % % ل عفراء تاه بها الربرب % 25(@)(@@) % من الذاهبات بحب القلو % % ب لا تقتضي رد ما تسلب % 26(@)(@@) % و ما نطفة حصنتها السماء % بأرعن مرقاه مستصعب % 27(@)(@@) % مصفقة حلبت عفوها % % بها المزن أول ما تحلب % 28(@)(@@) % إلى أن تبقت لباناتها % % و كادت بما لطفت تنضب % 29(@)(@@) % تراوحها وتغادي الشمال % ترقرق فيها وتستعذب % 30(@)(@@) % و لا نحلة بات يعسوبها % % على الحسن من حذر يلسب % PageV01P168 31(@)(@@) % يغار فيمنعها أن تشا % % ر ما منع الشائر المشغب % 32(@)(@@) % تجاذب فيها أكف الجنا % % ة غنى مثلها مثله تكسب % 33(@)(@@) % و لا مسكة طاف عطارها % % بدارين ينخل ما يجلب % 34(@)(@@) % يبقر عنها بطون الظباء % من الألف واحدة تنجب % 35(@)(@@) % فجاءت لضوعتها سورة % تكاد العياب بها تثقب % 36(@)(@@) % بأطيب من فم ذات الوشاح % % سحورا بلى فمها أطيب % 37(@)(@@) % تقول العواذل دع ذكرها % % ففي الذكر قادحة تلهب % 38(@)(@@) % وهبها كعارية تسترد % لا بد أو ثلة تعزب % 39(@)(@@) % فقلت إذن كبدي فلذة % من الصخر أو كبدي أصلب % 40(@)(@@) % تزم 
ms58	 الحمول فلا أستكين % و تشدو الحمام فلا أطرب % PageV01P169 41(@)(@@) % عذيري من زمن لا يسر % بنعماء إلا بها ينكب % 42(@)(@@) % إذا قسم الحظ بين الرجال % % فحظي من ستر ما ينصب % 43(@)(@@) % تعاوى على تصاريفه % % تذأبب حولي وتستكلب % 44(@)(@@) % فأدفعهن بصبري الجميل % إذا ظلع المتن والمنكب % 45(@)(@@) % سأركب عزمي حتى يطير % عن الضيم عنقاء بي مغرب % 46(@)(@@) % و إلا فعند عميد الكفا % % ة حمى مانع وذرى معشب % 47(@)(@@) % و راتعة من أماني العفا % % ة لا هي تظمى ولا تسغب % 48(@)(@@) % لها ما يوسع من ذرعها % % بساط الرجاء وما يرحب % 49(@)(@@) % كريم وشائج أعراقه % إلى العيص من مجده تضرب % 50(@)(@@) % توسع في نسب كالهلال % % إلى الشمس أعرق ما ينسب % PageV01P170 51(@)(@@) % بناة العلا آل عبد الرحي % % م يعرف بابنهم ما الأب % 52(@)(@@) % ميامين أندية المكرمات % % لهم تجتبى وبهم تعصب % 53(@)(@@) % إذا ذكروا العار لم يأمنوا % % و إن ركبوا السيف لم يرهبوا % % 54(@)(@@) % وجوه ميسرة للنجا % % ح باسمة والثرى يقطب % 55(@)(@@) % و أيد تخف إلى الأعطيات % إذا حسب الفقر لا تحسب % 56(@)(@@) % تراح عشارهم للشفار % فتعبط من قبل تستحلب % 57(@)(@@) % و لولا القرى ورشاد الضيو % % ف لم يغد عبد لهم يحطب % 58(@)(@@) % مضوا تضمن المجد أحداثهم % و ذكرهم خالد طيب % 59(@)(@@) % و قام أبو سعدهم ذائدا % % بميراثه وبما يكسب % 60(@)(@@) % فتاهم بما عد من سنه % و شيخ وأحلامهم تعزب % PageV01P171 61(@)(@@) % كفته بديهة حدثانه % قديم الرجال وما جربوا % % 62(@)(@@) % و غلس حتى انتهى واحدا % % له المجلس الصدر والموكب % 63(@)(@@) % كثير الغناء قليل العناء % فما يستريح وما يتعب % 64(@)(@@) % و ما يغمز الخطب في عوده % % إذا انقلب الزمن القلب % 65(@)(@@) % أبي جواد فيوم الخصام % % يحج ويوم الندى يغلب % 66(@)(@@) % يرى النفس تلك التي لا تذ % % ل والمال ذاك الذي يوهب % 67(@)(@@) % أصاخ بكم لي الأص % % م واعتذر الزمن المذنب % 68(@)(@@) % و ذللتم لي ظهور الرجا % % ء ما شئت أركب أو أجنب % 69(@)(@@) % و كنتم مآلي ومالي فلس % % ت أرهب شيئا ولا أرغب % 70(@)(@@) % ورد الوداد اليكم قيا 
ms59	 % % د قلبي فما عنكم مذهب % PageV01P172 71(@)(@@) % و حلأت عن حوض شعري الملو % % ك وهو لكم مغدق معذب % 72(@)(@@) % صوارمه دونكم تنتضي % % و أذياله حولكم تسحب % 73(@)(@@) % أحن لكم حنة العاشقين % % فأمدحكم مثل ما أنسب % 74(@)(@@) % على ملل فيكم لا تزال % % بجنبي قوارفه تندب % 75(@)(@@) % متى آت لم أك مستكرها % % و أنأى فما أنا مستقرب % 76(@)(@@) % و كم ماطر فيهم بالوفاء % إذا رمت أنصافه يحلب % 77(@)(@@) % يدير كؤس الهوى بيننا % % فيسقي الغرام ولا يشرب % 78(@)(@@) % و من حاسد لي أرسانه % بما ساءني عندكم تجذب % 79(@)(@@) % إذا خافني دب في دوركم % % بعيبي كما دبت العقرب % 80(@)(@@) % فلا وشقاوته ما يشق % على البدر أن تنبح الأكلب % PageV01P173 81(@)(@@) % و لو كنت أغلى عليكم رضاي % لما سركم أنني أغضب % 82(@)(@@) % و لكن فؤاد لكم رقه % فما يستبيع ولا يهرب % 83(@)(@@) % يريه الهوى أن إمساكه % % بكم من تنقله أصوب % 84(@)(@@) % و أن الحفاظ وحب الوفاء % على طين طابعه أغلب % 85(@)(@@) % فلا تنتزعكم يد تستم % % يح مني ولا قاهر يغصب % 86(@)(@@) % و لا أعدمن منكم أسرة % بأيسر عتبي لها تعتب % 87(@)(@@) % و غر مفوفة كالبرو % % د أو هي من حوكها أقشب % 88(@)(@@) % تجاري بروج العلا أو تعود % % و شرق النجوم لها مغرب % 89(@)(@@) % يذل النوال لكم صعبها % % فكل شوامسها تركب % % 90(@)(@@) % بكم هام ريقها في الشباب % و هذا لكم عمرها الأشيب % PageV01P174 91(@)(@@) % على كل يوم جديد السعو % % د ومن حسنها سمة تغرب % 92(@)(@@) % فإن جاءكم أعجمي اللسا % % ن فهي لسان له معرب % 93(@)(@@) % فتبقون وهي بواق قعود % ما اختلفت الصبح والغيهب % PageV01P175 البحر : - 1(@)(@@) % طرقت على خطر السرى المركوب % و الليل بين شبيبة ومشيب % 2(@)(@@) % و على الرحائل ساجدون دحاهم % % سكران سكر هوى وسكر لغوب % 3(@)(@@) % دعموا الخدود بأذرع مضعوفة % و تواقعوا لمناكب وجنوب % % 4(@)(@@) % و تعللوا طربا إلى أوطانهم % % بحنين كل مندب مجلوب % 5(@)(@@) % فكأن صحبي نافحتهم قرقف % أوفز بينهم عياب الطيب % 6(@)(@@) % فعجبت للزور القريب دنا به % % قدر وليس مزاره بقريب % 7(@)(@@) % يسري وحيدا بالعراق وأهله 
ms60	 % % ما بين قنة لعلع و عسيب % 8(@)(@@) % و أبي سلامة إنما جلب الكرى % % منها عدوا في ثياب حبيب % 9(@)(@@) % لو حكمت يقظى لما زارت بلا % % عدة ولا وصلت بغير رقيب % % 10(@)(@@) % يا أخت فهر والمحبة بيننا % % نسب وإن ناداك غير نسيب % PageV01P176 11(@)(@@) % لولاك لم أشم الخلاب ولا صبت % نفسي لأحلام الكرى المكذوب % 12(@)(@@) % و لكان لي مندوحة بالحزن في % % أخويك من رشأ له وقضيب % 13(@)(@@) % ناهضت حبك والنحول يخونني % % و كتمت سرك والدموع تشي بي % % 14(@)(@@) % و حملت حتى قيل مات إباؤه % % و جزعت حتى قيل غير لبيب % 15(@)(@@) % فإذا وذلك ليس عندك نافعا % % لما مللت وقل منك نصيبي % % 16(@)(@@) % تتجرمين الذنب تجزيني به % % و الشيب والإقلال كل ذنوبي % % 17(@)(@@) % ثنتان لو خيرت في كلتيهما % % عمر الربا مالي وعمر مشيبي % % 18(@)(@@) % و لقد حبست عن اللئام مطامعي % % و أطلت في دار الهوان مغيبي % % 19(@)(@@) % و عزفت والأرزاق مطمح ناظري % % أنفا من المتنن الموهوب % 20(@)(@@) % ما لي أذل وسيف نصري في فمي % % و الصون بين مآزري وجيوبي % % PageV01P177 21(@)(@@) % و على دون الحاسدين ونبلهم % % درعان من فطني ومن تجريبي % % 22(@)(@@) % و حماية الأحرار تحفظ جانبي % % و الفضل يمنع سارحي وعزيبي % % 23(@)(@@) % و إذا فزعت لجأت من أسد إلى % % أسد تأشب في القنا المخضوب % 24(@)(@@) % و نزلت في غرف العلا متظللا % % بالعز تحت رواقها المضروب % 25(@)(@@) % و علقت منها ذمة ومودة % أن فات حماد بحبل شبيب % 26(@)(@@) % الماجد ابن الماجدين وربما % % تجد النجيب وليس بابن نجيب % 27(@)(@@) % و ابن القرى وابن الصوارم والقنا % % و الخيل تخلط أرجلا بسبيب % 28(@)(@@) % و الواهبي ما لا يجاد بمثله % و السالبي ما ليس بالمسلوب % 29(@)(@@) % و الراكبين إلى ذوي حاجاتهم % % ظهرا من الأخطار غير ركوب % 30(@)(@@) % جادوا فقال المال سحب مواهب % وسطوا فقال الموت أسد حروب % PageV01P178 31(@)(@@) % و تتابعوا في المجد ينتظمونه % % و الرمح أنبوب على أنبوب % 32(@)(@@) % كانوا الأسنة في معد كلها % % و الناس بين معاقد وكعوب % 33(@)(@@) % إن فوخروا شهدت لهم أيامهم % % فيها بكل معلم 