ms61	 أروع الخليل بالصرم مني % % لم يخفه وقلة التكليم % PageV01P224 البحر : وافر تام 1(@)(@@) % برئت إلى الإله من ابن أروى % % ومن قول الخوارج أجمعينا % % 2(@)(@@) % ومن عمر برئت ومن عتيق % غداة دعي أمير المؤمنينا % % PageV01P225 البحر : خفيف تام 1(@)(@@) % خير إخوانك المشارك في الأم % % ر وأين الشريك في الأمر أينا % % 2(@)(@@) % الذي إن حضرت سرك في الحي % % ي وإن غبت كان أذنا وعينا % % 3(@)(@@) % ذاك مثل الحسام أخلصه القي % ن جلاه الجلاء فازداد زينا % % 4(@)(@@) % أنت في معشر إذا غبت عنهم % بدلوا كل ما يزينك شينا % % 5(@)(@@) % وإذا ما رأوك قالوا جميعا : % أنت من أكرم الرجال علينا % % PageV01P226 البحر : طويل 1(@)(@@) % أهاجك مغنى دمنة ومساكن % خلت وعفاها المعصرات السوافن % 2(@)(@@) % ديار ابنة الضمري إذ حبل وصلها % % متين وإذ معروفها لك عاهن % 3(@)(@@) % تقول ابنة الضمري ما لك شاحبا % وقد تنبري للعين فيك المحاسن % 4(@)(@@) % جفوت فما تهوى حديثك أيم % ولا تجتديك الآنسات الحواضن % 5(@)(@@) % فقلت لها بل أنت حنة حوقل % جرى بالفرى بيني وبينك طابن % 6(@)(@@) % فصدقته في كل حق وباطل % أتاك به نم الأحاديث خائن % 7(@)(@@) % رأتني كأنضاء اللجام وبعلها % % من الملء أبزى عاجز متباطن % 8(@)(@@) % رأت رجلا أودى السفار بوجهه % فلم يبق إلا منظر وجناجن % 9(@)(@@) % فإن أك معروق العظام فإنني % % إذا وزن الأقوام بالقوم وازن % 10(@)(@@) % متى تحسروا عني العمامة تبصروا % % جميل المحيا أغفلته الدواهن % PageV01P227 11(@)(@@) % يروق العيون الناظرات كأنه % هرقلي وزن أحمر التبر وازن % 12(@)(@@) % نساء الأخلاء المصافين محرم % علي وجارات البيوت كنائن % 13(@)(@@) % وإني لما استودعتني من أمانة % إذا ضاعت الأسرار للسر دافن % 14(@)(@@) % وما زلت من ليلي لدن طر شاربي % % إلى اليوم أخفي حبها وأداجن % 15(@)(@@) % وأحمل في ليلى لقوم ضغينة % وتحمل في ليلى علي الضغائن % PageV01P228 البحر : طويل 1(@)(@@) % أبائنة سعدى ؟ نعم ستبين % كما انبت من حبل القرين قرين % 2(@)(@@) % أإن زم أجمال وفارق جيرة % وصاح غراب البين أنت حزين ؟ % 3(@)(@@) % كأنك لم تسمع ولم تر قبلها % % تفرق ألاف لهن حنين % 4(@)(@@) % حنين إلى ألافهن وقد بدا % % لهن 
ms62	 من الشك الغداة يقين % 5(@)(@@) % وهاج الهوى أظعان عزة غدوة % وقد جعلت أقرانهن تبين % 6(@)(@@) % فلما استقلت عن مناخ جمالها % % وأسفرن بالأحمال قلت سفين % 7(@)(@@) % تأطرن في الميناء ثم تركنه % وقد لاح من أثقالهن شحون % 8(@)(@@) % كأني وقد نكبن برقة واسط % وخلفن أحواض النجيل طعين % 9(@)(@@) % فأتبعتهم عيني حتى تلاحمت % عليها قنان من خفينن جون % 10(@)(@@) % فقد حال من حزم الحماتين دونهم % % وأعرض من وادي البليد شجون % PageV01P229 11(@)(@@) % وفاتتك عير الحي لما تقبلت % ظهور بهم من ينبع وبطون % 12(@)(@@) % وقد حال من رضوى وضيبر دونهم % شمارخ للأروى بهن حصون % 13(@)(@@) % على الكمت أو أشباهها غير أنها % % صهابية حمر الدفوف وجون % 14(@)(@@) % وأعرض ركب من عباثر دونهم % ومن حد رضوى المكفهر جبين % 15(@)(@@) % فأخلفن ميعادي وخن أمانتي % % وليس من خان الأمانة دين % 16(@)(@@) % وأورثنه نأيا فأضحى كأنه % مخالطه يوم السرير جنون % 17(@)(@@) % كذبن صفاء الود يوم شنوكة % وأدركني من عهدهن وهون % 18(@)(@@) % وإن خليلا يحدث الصرم كلما % % نأيت وشطت داره لظنون % 19(@)(@@) % وطاف خيال الحاجبية موهنا % ومر وقرن دونها ورنين % 20(@)(@@) % وعاذلة ترجو لياني نجهتها % % بأن ليس عندي للعواذل لين % PageV01P230 21(@)(@@) % تلوم امرءا في عنفوان شبابه % وللترك أشياع الصبابة حين % 22(@)(@@) % وما شعرت أن الصبا إذ تلومني % % على عهد عاد للشباب خدين % 23(@)(@@) % وأني ولو داما لأعلم أنني % % لحفرة موت مرة لدفين % 24(@)(@@) % وأني لم أعلم ولم أجد الصبا % % يلائمه إلا الشباب قرين % 25(@)(@@) % وأن بياض الرأس يعقب بالنهى % % ولكن أطلال الشباب تزين % 26(@)(@@) % لعمري لقد شقت علي مريرة % ودار أحلتك البويب شطون % PageV01P231 البحر : طويل 1(@)(@@) % سيأتي أمير المؤمنين ودونه % جماهير حسمى : قورها وحزونها % % 2(@)(@@) % تجاوب أصدائي بكل قصيدة % من الشعر مهداة لمن لا يهينها % % 3(@)(@@) % أفحم فيها آل مروان إنهم % % إذا عم خوف عبد شمس حصونها % % 4(@)(@@) % أسود بوادي ذي حماس خوادر % حوان على الأشبال محمى عرينها % % 5(@)(@@) % إذا طلبوا أعلى المكارم أدركوا % % بما أدركت أحساب قوم ودينها % % 6(@)(@@) % لقد جهد الأعداء فوتك جهدهم % وضافتك أبكار الخطوب وعونها % % 7(@)(@@) % فما 
ms63	 وجدوا فيك ابن مروان سقطة % ولا جهلة في مأزق تستكينها % % 8(@)(@@) % ولكن بلوا في الجد منك ضريبة % بعيدا ثراها مسمهرا وجينها % % 9(@)(@@) % إذا جاوزوا معروفها أسلمتهم % إلى غمرة لا ينظر العوم نونها % % 10(@)(@@) % إذا ما أراد الغزو لم تثن عزمه % حصان عليها نظم در يزينها % % PageV01P232 11(@)(@@) % نهته فلما لم تر النهي عاقه % بكت فبكى مما شجاها قطينها % % 12(@)(@@) % ولم يثنه عند الصبابة نهيها % % غداة استهلت بالدموع شؤونها % % 13(@)(@@) % ولكن مضى ذو مرة متثبت % لسنة حق واضح يستبينها % % 14(@)(@@) % أشم عميم في العمامة أظهرت % حزامته أجلاد جسم يعينها % % 15(@)(@@) % وصدق مواعيد إذا قيل إنما % % يصدق موعود المغيب يقينها % % 16(@)(@@) % فتى أخلصته الحرب حتى تقلبت % كما أخلصت عضبا بضرب قيونها % % 17(@)(@@) % وهم يضربون الصف حتى يثبتوا % % وهم يرجعون الخيل جما قرونها % % PageV01P233 البحر : طويل 1(@)(@@) % لقد كنت للمظلوم عزا وناصرا % إذا ما تعيا في الأمور حصونها % % 2(@)(@@) % كما كان حصنا لا يرام ممنعا % بأشبال أسد لا يرام عرينها % % 3(@)(@@) % وليت فما شانتك فينا ولا ية % ولا أنت فيها كنت ممن يشينها % % 4(@)(@@) % فعفت عن الأموال نفسك رغبة % وأكرم بنفس عند ذاك تصونها % % 5(@)(@@) % وعطلتها من بعد ذلك كالذي % % نهى نفسه أن خالفته يهينها % % 6(@)(@@) % كدحت لها كدح امرىء متحرج % قد أيقن أن الله سوف يدينها % % 7(@)(@@) % فما عاب من شيء عليه فإنه % قد استيقنت فيه نفوس يقينها % % 8(@)(@@) % فعشت حميدا في البرية مقسطا % تؤدي إليها حقها ما تخونها % % 9(@)(@@) % ومت فقيدا فهي تبكي بعولة % عليك وحزن ، ما تجف عيونها % % 10(@)(@@) % إذا ما بدا شجوا حمام مغردا % على أثلة خضراء دان غصونها % % PageV01P234 11(@)(@@) % بكت عمر الخيرات عيني بعبرة % على إثر أخرى تستهل شؤونها % % 12(@)(@@) % تذكرت أياما خلت ولياليا % بها الأمن فيها العدل كانت تكونها % % 13(@)(@@) % فإن تصبح الدنيا تغير صفوها % % فحالت وأمست وهي غث سمينها % % 14(@)(@@) % فقد غنيت إذ كنت فيها رخية % ولكنها قدما كثير فنونها % % 15(@)(@@) % فلو كان ذاق الموت غيرك لم تجد % سخيا بها ما عشت فيها يمونها % % 16(@)(@@) % فمن لليتامى والمساكين 
ms64	 بعده % وأرملة باتت شديدا أنينها % % 17(@)(@@) % وليس بها سقم سوى الجوع لم تجد % على جوعها من بعدها من يعينها % % 18(@)(@@) % وكنت لها غيثا مريعا ومرتعا % كما في غمار البحر أمرع نونها % % 19(@)(@@) % فإن كان للدنيا زوال وأهلها % % لعدل إذا ولى فقد حان حينها % % 20(@)(@@) % أقامت لكم دنيا وزال رخاؤها % % فلا خير في دنيا إذا زال لينها % % PageV01P235 21(@)(@@) % بكته الضواحي واقشعرت لفقده % بحزن عليه سهلها وحزونها % % 22(@)(@@) % فكل بلاد نالها عدل حكمه % شديد إليها شوقها وحنينها % % 23(@)(@@) % فلما بكته الصالحات بعدله % وما فاتها منه بكته بطونها % % 24(@)(@@) % ولما اقشعرت حين ولى وأيقنت % % لقد زال منها أنسها وأمينها % % 25(@)(@@) % وقالت له أهلا وسهلا وأشرقت % بنور له مستشرفات بطونها % % 26(@)(@@) % فإن أشرقت منها بطون وأبشرت % له إذ ثوى فيها مقيما رهينها % % 27(@)(@@) % وقد زانها زينا له وكرامة % كما كان في ظهر البلاد يزينها % % 28(@)(@@) % لقد ضمنته حفرة طاب نشرها % % وطاب جنينا ضمنته جنينها % % 29(@)(@@) % سقى ربنا من دير سمعان حفرة % بها عمر الخيرات رهنا دفينها % % 30(@)(@@) % صوابح من مزن ثقال غواديا % دوالح دهما ماخضات دجونها % % PageV01P236 البحر : طويل 1(@)(@@) % أأطلال دار من سعاد بيلبن % وقفت بها وحشا كأن لم تدمن % 2(@)(@@) % إلى تلعات الخرج غير رسمها % % همائم هطال من الدلو مدجن % 3(@)(@@) % عرفت لسعدى بعد عشرين حجة % بها درس نؤي في المحلة منحن % 4(@)(@@) % قديم كوقف العاج ثبت حوله % مغازر أوتاد برضم موضن % 5(@)(@@) % فلا تذكراه الحاجبية إنه % متى تذكراه الحاجبية يحزن % 6(@)(@@) % تراها إذا استقبلتها محزئلة % على ثفن منها دوام مسفن % 7(@)(@@) % كأن قتود الرحل منها تبينها % % قرون تحنت في جماجم أبدن % 8(@)(@@) % كأن خليفي زورها ورحاهما % % بنى مكوين ثلما بعد صيدن % 9(@)(@@) % إلى ابن أبي العاصي بدوة أرقلت % وبالسفح من ذات الربى فوق مظعن % 10(@)(@@) % بشعث عليها ، غير السير منهم % صفاء وجوه وهي لم تتشنن % PageV01P237 11(@)(@@) % إذا ذر قرن الشمس مالت طلاهم % % عليها وألقوا كل سوط ومحجن % 12(@)(@@) % كأنهم كانوا من النوم عاقروا % % بليل خراطيم السلاف المسخن % 13(@)(@@) % إلى خير أحياء البرية 
ms65	 كلها % % لذي رحم أو خلة متأسن % 14(@)(@@) % له عهد ود لم يكدر يزينه % ردى قول معروف حديث ومزمن % 15(@)(@@) % وليس امرؤ من لم ينل ذاك كامرئ % بدا نصحه فاستوجب الرفد محسن % 16(@)(@@) % فإن لم تكن بالشأم داري مقيمة % فإن بأجنادين مني ومسكن % 17(@)(@@) % منازل لم يعف التنائي قديمها % % وأخرى بميافارقين فموزن % 18(@)(@@) % إذا النبل في نحر الكميت كأنها % % شوارع دبر في حشافة مدهن % 19(@)(@@) % وأنت كريم بين بيتي أمانة % بعلياء مجد قدمت لك فابتن % 20(@)(@@) % مصانع عز ليس بالترب شرفت % ولكن بصم السمهري المعرن % PageV01P238 21(@)(@@) % وقد علمت قدما أمية أنكم % من الحي مأوى الخائف المتحصن % 22(@)(@@) % وإن تقصر الدعوى إلى الرهط قصرة % فإنك ذو فضل على الحق بين % 23(@)(@@) % بحقك إن تنطق تقل غير مهجر % صوابا وإن يخفف حصى القوم ترزن % 24(@)(@@) % بهاليل معروف لكم أن تفضلوا % % وأن تحفظوا الأحساب في كل موطن % 25(@)(@@) % بصبر وإبقاء على جل قومكم % على كل حال بالأنا والتحنن % 26(@)(@@) % ولين لهم حتى كأن صدورهم % من الحلم كانت عزة لم تخشن % 27(@)(@@) % وأنت فلا تفقد ولا زال منكم % إمام يحيا في حجاب مسدن % 28(@)(@@) % أشم من الغادين في كل حلة % يميسون في صبغ من العصب متقن % 29(@)(@@) % لهم أزر حمر الحواشي يطونها % % بأقدامهم في الحضرمي الملسن % PageV01P239 البحر : كامل تام 1(@)(@@) % طرب الفؤاد فهاج لي ددني % % لما حدون ثواني الظعن % 2(@)(@@) % والعيس أنى هي توجهه % شأما وهن سواكن اليمن % 3(@)(@@) % ثم اندفعن ببطن ذي عبب % ونكأن قرح فؤادي الضمن % PageV01P240 البحر : كامل تام 1(@)(@@) % لمن الديار بأبرق الحنان % فالبرق فالهضبات من أدمان % 2(@)(@@) % أقوت منازلها وغير رسمها % % بعد الأنيس تعاقب الأزمان % 3(@)(@@) % فوقفت فيها صاحبي وما بها % % يا عز من نعم ولا إنسان % 4(@)(@@) % إلا الظباء بها كأن نزيبها % % ضرب الشراع نواحي الشريان % 5(@)(@@) % فإذا غشيت لها ببرقة واسط % فلوى لبينة منزلا أبكاني % % 6(@)(@@) % ثم احتملن غدية وصرمنه % والقلب رهن عند عزة عان % 7(@)(@@) % ولقد شأتك حمولها يوم استوت % % بالفرع بين خفينن ودعان % 8(@)(@@) % فالقلب أصور عندهن 
ms66	 كأنما % % يجذبنه بنوازع الأشطان % 9(@)(@@) % طاف الخيال لآل عزة موهنا % بعد الهدو فهاج لي أحزاني % % 10(@)(@@) % فألم من أهل البويب خيالها % % بمعرس من أهل ذي ذروان % PageV01P241 11(@)(@@) % ردت عليه الحاجبية بعدما % % خب السفاء بقزقز القريان % 12(@)(@@) % ولقد حلفت لها يمينا صادقا % بالله عند محارم الرحمان % 13(@)(@@) % بالراقصات على الكلال عشية % تغشى منابت عرمض الظهران % PageV01P242 البحر : طويل 1(@)(@@) % وقفت عليه ناقتي فتنازعت % شعوب الهوى لما عرفت المغانيا % % 2(@)(@@) % فما أعرف الآيات إلا توهما % وما أعرف الأطلال إلا تماريا % % 3(@)(@@) % وما خلف منكم بأطلال دمنة % تنكرن واستبدلن منك السوافيا % % 4(@)(@@) % وإن طنت الأذنان قلت ذكرتني % % وإن خلجت عيني رجوت التلاقيا % % 5(@)(@@) % أيا عز صادي القلب حتى يودني % % فؤادك أو ردي علي فؤاديا % % 6(@)(@@) % أيا عز لو أشكو الذي قد أصابني % % إلى ميت في قبره لبكى ليا % % 7(@)(@@) % ويا عز لو أشكو الذي قد أصابني % % إلى راهب في ديره لرثى ليا % % 8(@)(@@) % ويا عز لو أشكو الذي قد أصابني % % إلى جبل صعب الذرى لانحنى ليا % % 9(@)(@@) % ويا عز لو أشكو الذي قد أصابني % % إلى ثعلب في جحره لانبرى ليا % % 10(@)(@@) % ويا عز لو أشكو الذي قد أصابني % % إلى موثق في قيده لعدا ليا % % PageV01P243 البحر : طويل 1(@)(@@) % عفا الله عن أم الحويرث ذنبها % % علام تعنيني وتكمي دوائيا % % 2(@)(@@) % فلو آذنوني قبل أن يرقموا بها % % لقلت لهم أم الحويرث دائيا % % PageV01P244 
ms67	