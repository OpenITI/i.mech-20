ms181	 جان به لب از جوع کلبی %~% بداندیش تو بر هر در دوان باد(@)(@@) 44 بسان سگ دو چشمش چار و هر چار %~% سفید اندر ره یک پاره نان باد(@)(@@) 45 در زندان قهر ایزدی را %~% سر خصمت به جای آستان باد(@)(@@) 46 به هر در کز اجل بانگی بر آید %~% در او طفل عدویت در فغان باد(@)(@@) 47 به چاهی در رود هر جا نهد پای %~% ز بس بند بداندیشت گران باد(@)(@@) 48 سمند تند عمر دشمنت را %~% عنان در دست مرگ ناگهان باد(@)(@@) 49 رگ و پی ریشه ریشه خون بر او خشک %~% ز خوفت خصم را چون زعفران باد(@)(@@) 50 چو راز اندر نهاد راز داران %~% به سر نیستی خصمت نهان باد(@)(@@) 51 اجل چون دست بندد بر حسودت %~% بلا تیر و قضای بد کمان باد(@)(@@) 52 اجل چون غرق خون آید ز رزمی %~% سر بد خواهت او را بر سنان باد(@)(@@) 53 چو تیر روی ترکش آزماید %~% جگرگاه بداندیشت نشان باد(@)(@@) 54 هزاران سر محرومی کشیده %~% عدویت را میان جسم و جان باد(@)(@@) 55 به گاه صور هم جان و تنش را %~% همان سدی که بود اندر میان باد(@)(@@) 56 سخندان داورا معنی شناسا %~% ثنایت زیور نطق و بیان باد(@)(@@) 57 چو وحشی گر چه چوی وحشی یکی نیست %~% هزارت مدح گوی و مدح خوان باد(@)(@@) 58 اگر یک نکته سنجد کلک نطقش %~% ورای مدح تو سهو اللسان باد(@)(@@) 59 به عکس این دو سال رفته با او %~% ترا احسان و لطف بی کران باد(@)(@@) 60 ز دست بخششت در آستینش %~% کلید قفل گنج شایگان باد(@)(@@) 61 ز تفصیل عطاهای تو او را %~% به هر هنگامه‌ای سد داستان باد(@)(@@) 62 ز بس لطف تو طبع بذله سنجش %~% پشیمان از ثنای دیگران باد(@)(@@) 63 الا تا بعد باشد لازم جسم %~% الا تا جسم محتاج مکان باد(@)(@@) 64 به گیتی هرکجا صاحب مکانیست %~% به حکمت زنده چون جسم از 
ms182	 روان باد PageV1P415(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دل و طبعی که من دارم اگر دریا و کان باشد %~% یکی جوهر نثار آید یکی گوهر فشان باشد(@)(@@) 2 ز بس گوهر کزان دریا نثار آسمان گردد %~% سراسر آسمان مانند راه کهکشان باشد(@)(@@) 3 ز بس جوهر که آن کان در زمین بر روی هم ریزد %~% همه روی زمین در زیر گنج شایگان باشد(@)(@@) 4 از آن دریا و کان کآمد محیط مرکز دوران %~% زمین و آسمان در جوهر و گوهر نهان باشد(@)(@@) 5 کمین گوهر از آن دریا و ز آن کان کمترین جوهر %~% زمین را زیب تخت و زیور تاج زمان باشد(@)(@@) 6 کشد در باختر بر رشته گوهر تیره شب اعما %~% اگر زان جوهر رخشان یکی در خاوران باشد(@)(@@) 7 نیاید جوهری را در نظر گنجینه قارون %~% یکی زان گوهر پر قیمتش گر در دکان باشد(@)(@@) 8 مگر زان جوهر و گوهر مرصع افسری سازم %~% که آن افسر سزاوار سرافراز جهان باشد(@)(@@) 9 امیر باذل و عادل که رشک بذل و عدل او %~% جحیم افروز روح حاتم و نوشیروان باشد(@)(@@) 10 غیاث الدین محمد سر فراز دولت سرمد %~% که خاک پای قدرش تاج فرق فرقدان باشد(@)(@@) 11 ره اقبال او جوید اگر اجلال پا یابد %~% ثنای دست او گوید کرم را گر زبان باشد(@)(@@) 12 کند چون میزبان همتش ترتیب مهمانی %~% فلک مهمانسرا گردد کواکب میهمان باشد(@)(@@) 13 عجب نبود که در ایام عدلش گوسفندان را %~% به جانب‌داری گرگان خصومت با شبان باشد(@)(@@) 14 به اقلیمی که آید شحنه در وی حزم بیدارش %~% قضای خواب رفته عهد شغل پاسبان باشد(@)(@@) 15 ز استیلای امر نافذش چون آب فواره %~% نباشد دور کآب چاه بر گردون روان باشد(@)(@@) 16 فلک پر کاروانست از دعای خیر او هر شب %~% به راه کهکشان تا روز گرد کاروان باشد(@)(@@) 17 به بازار سیاست قهر او چون محتسب گردد %~% بلا ارزان شود نرخ سر و جان رایگان 
ms183	 باشد(@)(@@) 18 سر از گردن گریزد گردن از پیکر کران خواهد %~% میان گردنان چون حرف تیغت در میان باشد(@)(@@) 19 سراپا نافه گردد گر چرد در ساحتش آهو %~% شمیم خلق او گر عطرسای بوستان باشد(@)(@@) 20 نمی‌خواهد که صبح بخت او لب بندد از خنده %~% فلک را طلبه خورشید از او پر زعفران باشد(@)(@@) 21 جهان گر در خور بحر نوالش کشتیی سازد %~% زمینش لنگر آید آسمانش بادبان باشد(@)(@@) 22 زمان گر خانه طرح افکند شایسته قدرش %~% سپهرش طاق گردد آسمانش کهکشان باشد(@)(@@) 23 زهی قدر ترا بنیاد دولت آنچنان عالی %~% که در رفعت نشیب او فراز آسمان باشد(@)(@@) 24 به چاهی شد فرو خصمت که نتوان بر کشید او را %~% زمان آغاز تا انجام اگر یک ریسمان باشد(@)(@@) 25 توان کرد از کتان آیینه آن مه که جاویدان %~% نفرساید اگر حفظ تو نساج کتان باشد(@)(@@) 26 تعالی‌اله چه ترکیب است آن رخش جهان پیما %~% که گه برق جهان گردد گهی باد وزان باشد(@)(@@) 27 چو زین بر پشت او بندند برقی زیر ران آید %~% نشیند گر کسش بر پشت بادش زیر ران باشد(@)(@@) 28 محیط نور و ظلمت پر ز موج روز و شب سازد %~% گرش رخش زمان یک دم عنان اندر عنان باشد(@)(@@) 29 بدان ساحل بود دستش هنوزش تا بدین ساحل %~% اگر پهنای بحری قیروان تا قیروان باشد(@)(@@) 30 گرش پیری دواند در ره ایام طی گشته %~% به خیزی کهل گردد و ز دگر خیزیش جوان باشد(@)(@@) 31 شود پشت و شکم یک سطح با هم گاو ماهی را %~% چو لنگر افکند یعنی رکاب او گران باشد(@)(@@) 32 چنان زان بگذرد کش کج نگرد موی بر پیکر %~% به سقف سوزنش ره گر چه تار پرنیان باشد(@)(@@) 33 بدو آسان توان رفتن به سقف آسمان زیرا %~% که دست و پای او بام فلک را نردبان باشد(@)(@@) 34 به یک اندازه از چوگان از ابدان نیمش اندازد %~% خم پایش 
ms184	 اگر گوی فلک را صولجان باشد(@)(@@) 35 دمد تیرو جهد زین نه سپر بی‌دست ناوک زن %~% بر آن خاکی که پای آن سبک پی را نشان باشد(@)(@@) 36 به میدان سعادت بی قرین رخشی چنین باید %~% که پای دولتت را با رکاب او قران باشد(@)(@@) 37 زبان خامه چون شد خشک از عجز ثنا وحشی %~% همان بهتر که در عرض دعا رطب اللسان باشد(@)(@@) 38 الا تا هست در دست فنا سر رشته تاری %~% کز آن سررشته پیوند بقای انس و جان باشد(@)(@@) 39 تن و جان ترا تار تعلق نگسلد از هم %~% میان هر دو پیوند دعای جاودان باشد PageV1P416(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 یک جهان جان خواهم و چندان امان از روزگار %~% کن جهان جان بر آن جان جهان سازم نثار(@)(@@) 2 گر دهد دستم ثبات کوه بستانم به وام %~% بسکه پای بندگی خواهم به راهت استوار(@)(@@) 3 خاک چون گرداندم جذب سکون درگهت %~% تندباد رستخیز ازمن نینگیزد غبار(@)(@@) 4 حاش لله گر بشوید صدمه توفان نوح %~% از جبین من غبار سجده آن رهگذار(@)(@@) 5 آمدم تا افکنم یک یک به راه توسنت %~% اینکه یک سردر بدن دارم بود گر سد هزار(@)(@@) 6 آمدم تا سازم از بس خاک فرسایی به عجز %~% خاک این درگاه را از جبهه خود شرمسار(@)(@@) 7 آمدم با کاروانهای دعای مستجاب %~% تا گشایم در حریم کعبةالاسلام بار(@)(@@) 8 حبذا این خطه یزد است یا دارالامان %~% یا گلستان ارم یا روضه دارالقرار(@)(@@) 9 خفته در وی فارغ از آسیب و ایمن از گزند %~% شیر و آهو باز و تیهو بچه گنجشک و مار(@)(@@) 10 ضبط و ربط ملک تا حدی که بر وی نگذرد %~% جز به اذن باغبان در بوستان باد بهار(@)(@@) 11 مردمش پرورده ناز و نعیم عافیت %~% در پناه کامران کام بخش کامکار(@)(@@) 12 تاج فرق سروری سرمایه فر و شکوه %~% خاتم دست بزرگی مایه عز و وقار(@)(@@) 13 ماه ملک آرا غیاث الدین 
ms185	 محمد آنکه هست %~% بر مراد خاطر او چرخ و انجم را مدار(@)(@@) 14 در طلسم باطن او گنج درویشی نهان %~% وز جبین ظاهرش سیمای شاهی آشکار(@)(@@) 15 ظاهرش بخشنده آمال هر صاحب امل %~% باطنش داننده امید هر امیدوار(@)(@@) 16 در بساطی کاندرو دیوان احسانش بود %~% آرزو بسیار گو باشد تقاضا هرزه کار(@)(@@) 17 ره ندارد چند چیز اندر جهان جود او %~% عیب منت نقص قلت احتمال انتظار(@)(@@) 18 دشمنش گو خویش را میکش نخواهد یافتن %~% آنقدر رفعت که آویزند دزدی را ز دار(@)(@@) 19 خویش را انداخت گردون در رکاب او ولی %~% زود می‌ماند که بس تند است رخش این سوار(@)(@@) 20 بلعجب رخشی که گر تازاندش رو بر ابد %~% در نخستین گام بر فارس کند امسال پار(@)(@@) 21 در سر میدان چو خود را گرد کرده همچو گوی %~% پای او از گوشه سم کرده گوشش را فکار(@)(@@) 22 چشم تا بر هم زند بر جا نبیند نقش او %~% گر مصور صورت او را نگارد بر جدار(@)(@@) 23 تیزهوش و تیزبین و نرم موی و نرم رو %~% خوش نشان و خوش عنان و راه دان و راهوار(@)(@@) 24 با وجود آنکه چون کوه گرانش پیکریست %~% از سبک خیزی نماند نقش پایش بر غبار(@)(@@) 25 ای ز پای توسنت یک نعل زرین آفتاب %~% کآسمانش می‌نهد بر سر ز روی افتخار(@)(@@) 26 اقتباس نور اگر از پرتو رایت کند %~% تا ابد منفک نگرد روشنایی از شرار(@)(@@) 27 تقویت چون یابد از حفظ تو تار عنکبوت %~% نگسلد گر بختی ایام را باشد مهار(@)(@@) 28 بسکه دور از اعتدال انداخت وقت امتزاج %~% مایه ترکیب بدخواه ترا پروردگار(@)(@@) 29 گر مزاج فاسدش گردد مؤثر در عدد %~% مرتفع سازد فسادش صحت نصف از چهار(@)(@@) 30 ز آتش قهرت شراری گرددش قائم مقام %~% فی‌المثل گر عنصر آتش کشد پا بر کنار(@)(@@) 31 روز و شب روی تو بزم آرای عالم مثل مه %~% چون قمر در چارده چون 
ms186	 شمس در نصف النهار(@)(@@) 32 روزگار از بهر چشم بخت بد خواهت نهاد %~% خواب را در حقه‌های سر به مهر کو کنار(@)(@@) 33 سعی نیسان و صدف شرط است با دیگر امور %~% تا گهر گردد چو بارد مایه بحر از بخار(@)(@@) 34 کو خواص دست تو تا ابر بی آن حل و عقد %~% سازد از تأثیر آن هر قطره در شاهوار(@)(@@) 35 زین تشبه چشم خصمت را نشاید ابر خواند %~% کاین سفید و اشکریز است آن سیاه و اشکبار(@)(@@) 36 اشتراکی هست اما این کجا ماند بدان %~% چشم او گر ابر بودی نم که دیدی در بحار(@)(@@) 37 داورا وحشی گر از لطف تو یابد تربیت %~% ای بسا نقد سخن کز وی بماند یادگار(@)(@@) 38 از من استعداد و از تو تربیت وز بخت سعی %~% اهتمام از طبع و توفیق سخن از کردگار(@)(@@) 39 گر مرتب گردد این اسباب در کم فرصتی %~% بشنوی کز من چها در دهر یابد انتشار(@)(@@) 40 طالع ناساز و بخت نامساعد چون مرا %~% داد سر در وادی اندوه ازین خرم دیار(@)(@@) 41 داشتم ناقص مسی وز کیمیای لطف تو %~% آن مس ناقص همه زر شد زر کامل عیار(@)(@@) 42 آمدم تا سازدش رایج در اطراف جهان %~% سکه نام تو و شه زاده‌های نامدار(@)(@@) 43 تا به استعداد یابد هر که یابد پایه‌ای %~% تا به قدر پایه یابد که هر یابد اعتبار(@)(@@) 44 در میان اعتبار و پایه خصم تو باد %~% آنچنان بعدی که می‌باشد میان فخر و عار PageV1P417(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 باد فرخنده عید و فصل بهار %~% بر تو و شاهزاده‌های کبار(@)(@@) 2 میر میران که روی خرم تست %~% عید احرار و قبله ابرار(@)(@@) 3 بر یمین و یسار تو چو روند %~% آن دو شهزاده فلک مقدار(@)(@@) 4 اله اله چه رشکها که برند %~% بر هم وقدر هم یمین و یسار(@)(@@) 5 ای ترا آسمان جنیبت کش %~% وی ترا آفتاب غاشیه دار(@)(@@) 6 کوه را 
ms187	 همچو برق سرعت داد %~% هر کجا عزم تو نمود گذار(@)(@@) 7 برق را همچو کوه ساکن ساخت %~% هر کجا حلم تو گرفت قرار(@)(@@) 8 مور با حفظ تو برون آید %~% از ته پای پیل بی آزار(@)(@@) 9 خصم بیهوده گردگو می‌کرد %~% گرد بازار نکبت و ادبار(@)(@@) 10 نه متاعی‌ست دولت و اقبال %~% که فروشند بر سر بازار(@)(@@) 11 باز بر نسر طایر اندازند %~% بازداران تو به روز شکار(@)(@@) 12 بر فلک نسر طایر ایمن نیست %~% کبک خود چیست و بر سر کهسار(@)(@@) 13 گر به دیوار بر کشد به مثل %~% نقش خصم تو کلک نقش نگار(@)(@@) 14 تن رود سرنگون که کوته چاه %~% سر رود مضطرب که کو سردار(@)(@@) 15 بد سگالت که مرد وخاکش خورد %~% بلکه از خاک او نماند غبار(@)(@@) 16 لحدش دیدمی به خواب که بود %~% همچو سوراخ مار تیره و تار(@)(@@) 17 پیکری اندر او ز دود جحیم %~% پای تا سر سیاه گشته چو قار(@)(@@) 18 دل پر زنگ کینه گر سوده %~% مانده یک کف سیاهی زنگار(@)(@@) 19 چشم در چشمخانه خاک شده %~% مانده یک مشت نشتر و مسمار(@)(@@) 20 قدرتت چون زبون نواز شده %~% صولتت چون رود به دفع مضار(@)(@@) 21 عجز بگریزد از جبلت مور %~% زهر بگریزد از طبیعت مار(@)(@@) 22 در کف استقامت رایت %~% جز خط راست ناید از پر گار(@)(@@) 23 آب حزمت گرش به روی زنند %~% جهد از خواب صورت دیوار(@)(@@) 24 داورا دادگسترا شاها %~% ای جهان را به ذاتت استظهار(@)(@@) 25 واجب العرض خود به خدمت تو %~% گر اجازت بود کنم اظهار(@)(@@) 26 به خدایی که لطف او بخشد %~% سد گنه را به نیم استغفار(@)(@@) 27 از خطایی چو کفر سجده بت %~% بگذرد عفو او به یک اقرار(@)(@@) 28 رقمی پیش طاق وحدت او %~% لیس فی الدار غیره دیار(@)(@@) 29 آنکه نسبت به بی نیازی او %~% هست یکسان چه یار و چه اغیار(@)(@@) 30 وانکه محتاج اوست هر کس هست 
ms188	 %~% خواه بدکار و خواه نیکوکار(@)(@@) 31 آن کس اول ز چشم تو فکند %~% هر کرا پیش خلق خواهد خوار(@)(@@) 32 وانکه آخر کند غلام تواش %~% هر کرا آفرید دولتیار(@)(@@) 33 که به دارالعباده تکلیف %~% مدتی قبل از آن که یابم بار(@)(@@) 34 دم ازین خاندان زدم چون کرد %~% اقتضای طبیعتم مختار(@)(@@) 35 این کشش ذاتی است و هر ذاتی %~% هست تا هست ذات را آثار(@)(@@) 36 در میان عقیده من و غیر %~% هست شاها تفاوت بسیار(@)(@@) 37 من نمی‌خواهم از تو غیر از تو %~% او نمی‌خواهد از تو جز دینار(@)(@@) 38 همت هر کس از تو چیزی خواست %~% غیر دینار جست و ما دیدار(@)(@@) 39 من سگ این درم اگر دگران %~% خادم این درند وخدمتکار(@)(@@) 40 به خدا کز پی گدایی نیست %~% اینکه مدح تو می‌کنم تکرار(@)(@@) 41 از در مدح و زیور نامت %~% می‌دهم زیب و زینت اشعار(@)(@@) 42 چون بگویم گدا نیم هستم %~% شاعران را گدایی است شعار(@)(@@) 43 هنر من گدایی است و مرا %~% از گدایی چگونه باشد عار(@)(@@) 44 خاصه زینسان گداییی که گدا %~% زان شود صاحب ضیاع و عقار(@)(@@) 45 از چه کس از کسی که گوید چرخ %~% که مرا هم گدای خویش شمار(@)(@@) 46 آنقدر گویم ای که دست و دلت %~% مایه بخش معادن است و بحار(@)(@@) 47 که گدای توام نه از همه کس %~% همه کس داند از صغار و کبار(@)(@@) 48 فرقه خود پسند کس مپسند %~% همگی عجب و جملگی پندار(@)(@@) 49 از پی جر و اخذ سر تا پای %~% همه دست و زبان چو بید و چنار(@)(@@) 50 آنچنان فرقه زیاده طلب %~% که طلب می‌کنند پنج از چار(@)(@@) 51 چه عجب گر ز بیم طامعه شان %~% کور بنهد عصا و کل دستار(@)(@@) 52 گر ز ابرامشان سخن راند %~% قابض روح بر سر بیمار(@)(@@) 53 خوش بمیرند خستگان آسان %~% ندهد هیچ خسته جان دشوار(@)(@@) 54 شکرلله کزین گروه نیم %~% من و شکر 
ms189	 و زبان شکر گزار(@)(@@) 55 شکر کز نقد کنز لایفنی %~% همتم پر نمود جیب و کنار(@)(@@) 56 وحشی این شکر و این شکایت چیست %~% تا کی و چند طی کن این تومار(@)(@@) 57 در دعای دوام دولت شاه %~% دست عجز و کف نیاز برآر(@)(@@) 58 تا جهان را بهار و عیدی هست %~% در جهان باشی ای جهان وقار(@)(@@) 59 که جهان از رخ خجسته تست %~% خرم و خوش چو عید و فصل بهار PageV1P418(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عقل و دولت ساعت سعدی نمودند اختیار %~% ساعت سعدی هزارش سعد اکبر پیشکار(@)(@@) 2 ساعتی کان ساعت از خوبی گلستان ارم %~% در نخستین گام گردد باغ فردوست دچار(@)(@@) 3 ساعتی کان ساعت ار آبی رود همراه ابر %~% باز گردد قطره‌هایش گشته در شاهوار(@)(@@) 4 ساعتی کان ساعت ار گشتی سکندر کامجوی %~% یافتی سر چشمه خضر از بن دندان مار(@)(@@) 5 ساعتی کان ساعت ار طالع شود مهر از افق %~% تا به شام روز محشر تابد از نصف النهار(@)(@@) 6 ساعتی کان ساعت ار آید برون از بیضه بوم %~% بر دمد پر همایش از یمین و از یسار(@)(@@) 7 ساعتی کان ساعت ار سر بر زند تاج خروس %~% گیرد از سیمرغ بروی شاهی مرغان قرار(@)(@@) 8 ساعتی الحق چه ساعت ساعتی کثار آن %~% زر برون ریز ز خارا گل برون آید ز خار(@)(@@) 9 ساعتی الحق چه ساعت ساعت سعدی کزو %~% سعد گردون دارد آثار سعادت مستعار(@)(@@) 10 در چنین وقت همایونی و فرخ ساعتی %~% زد به دولت خیمه بیرون داور جم اقتدار(@)(@@) 11 خیمه‌ای زان عرصه گیتی پر از میخ و طناب %~% منتهای طول و عرضش طول و عرض روزگار(@)(@@) 12 خیمه‌ای کاندر میانش وهم را گر سر دهند %~% پر بگردد لیک آخر ره نیاید بر کنار(@)(@@) 13 خیمه‌ای کایمن شوند اهل قیامت ز آفتاب %~% گر کسش در عرصه محشر زند روز شعار(@)(@@) 14 خیمه‌ای باید که باشد اینچنینش طول و عرض %~% تا سپهر 
ms190	 حشمت و شوکت در او گیرد قرار(@)(@@) 15 زینت اقبال و دولت زیور فر و شکوه %~% حلیه ملک و ملک پیرایه عز و وقار(@)(@@) 16 شاه دریا دل غیاث الدین محمد کز کفش %~% کان برآرد الامان و بحر گوید زینهار(@)(@@) 17 در پناه پاس او روشن بماند سالها %~% در میان آب همچون دیده ماهی شرار(@)(@@) 18 هستی از عالم گریزد تا در ملک عدم %~% گر ز جیش قهر او بر دهر تازد یک سوار(@)(@@) 19 ایمنی در ملک تا حدیست کز انصاف او %~% آشیان گیرند مرغان در میان رهگذار(@)(@@) 20 گر ز رای روشن او پرتو افتد در جهان %~% حامله خورشید زاید در سواد زنگبار(@)(@@) 21 بسکه سر دارد تنفر در تن بدخواه او %~% چون به پای دار عبرت جا کند آن نابکار(@)(@@) 22 از زمین نارفته پایش بر سر کرسی هنوز %~% سر بود از شوق رقصان بر فراز چوب دار(@)(@@) 23 کوه را گر بر کمر زد از کمر افتاد کوه %~% هست تیغ باطنش قائم مقام ذوالفقار(@)(@@) 24 اطلس گردون به قد لامکان بودی بلند %~% گر ز قدر همتت می‌بود او را پود و تار(@)(@@) 25 آسمان گر داشتی دستی چو دست همتت %~% بر سر قدر تو گوهرهای خود کردی نثار(@)(@@) 26 می‌دهد عدل تو میلش از بروت شیر نر %~% می‌کشد چون سرمه آهو بره اندر مرغزار(@)(@@) 27 روضه فردوس بزم تست کاندر ساحتش %~% هر چه در دل بگذرد حاضر شود بی انتظار(@)(@@) 28 گر ز بزم خرمت بادی وزد در بوستان %~% آورد گلبن به جای گل لب پر خنده بار(@)(@@) 29 دفتر جود خداوندان احسان نزد کیست %~% گو بیا و آنچه ارباب کرم دارد بیار(@)(@@) 30 تا بیارم فصلی از جودت که دفتر را تمام %~% ز آب پیشانی بشوید بسکه گردد شرمسار(@)(@@) 31 پیش دست گوهر افشانت که فوق دستهاست %~% وز گهرباریش پر در گشته دامان بحار(@)(@@) 32 هست دریا کید و در یوزه گوهر کند %~% اینکه بعضی 
ms191	 ابر می‌خوانندش و بعضی بخار(@)(@@) 33 دین پناها داورا شاها رعیت پرورا %~% باد بر دور تو یارب دور گیتی را مدار(@)(@@) 34 رو به هر جانب که رخش عزم راند بخت تو %~% کامران آنجا روی آیی از آنجا کامکار(@)(@@) 35 می‌روی اندر سر راه وداعت مرد وزن %~% پای در گل مانده‌اند از آب چشم اشکبار(@)(@@) 36 گرنه در زنجیر بودندی ز موج آب چشم %~% کس نماندی کز پیت نشتافتی دیوانه وار(@)(@@) 37 خیمه تا بیرون زدی از شهر شهری کز خوشی %~% بود چون دارالقراری گشت چون دارالبوار(@)(@@) 38 از برونش برنخیزد جز غریو الحذر %~% وز درونش برنیاید جز خروش الفرار(@)(@@) 39 شد چنان آب و هوا موحش که نفرت می‌کند %~% طایران از شاخسار و ماهیان از جویبار(@)(@@) 40 گر جدار و سقف را بودی در او پای گریز %~% این زمان در خانه‌ها نی سقف ماندی نی جدار(@)(@@) 41 تو هنوز اندر کنار شهر و اینها در میان %~% آه اگر از شهر یک منزل روی ای شهریار(@)(@@) 42 حال شهر اینست حال ساکنانش را مپرس %~% کارشان صعب است صبریشان دهد پروردگار(@)(@@) 43 مضطرب آشفته خاطر تنگدل اندوهناک %~% هم وضیع و هم شریف و هم صغیر و هم کبار(@)(@@) 44 خود بفرما چون ضعیفان را نگردد دل دو نیم %~% لاشه لنگ و شیشه دربار و گذر بر کوهسار(@)(@@) 45 دست از تریاک کوتاه است و جان اندر خطر %~% پا نهی تاریک شب چون بر در سوراخ مار(@)(@@) 46 از پریشانی فرامش کرده مادر طفل خویش %~% بلکه رفته شیر هم از یاد طفل شیرخوار(@)(@@) 47 هر جماعت در خیالی هر گروه اندر غمی %~% این که چون آرام گیرد وان که چون گیرد قرار(@)(@@) 48 چون قوی زور آورد دارد ضعیفان را که پاس %~% گر جهد بادی به دامان که آویزد غبار(@)(@@) 49 گرگهای تیز دندان را که دندان بشکنند %~% وین لگد زن استران را چون توان کردن جدار(@)(@@) 50 مفلسان در غم که 
