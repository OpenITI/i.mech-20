ms384	 تاريخه ( هب ) عن ابن عباس رضي الله عنهما وقال ( هب ) غريب .(@)(@@)(@@)(@@) $ ( 3598 ) قال النبي :(@)(@@) | 30 ( افترقت بنو إسرائيل على إحدى وسبعين فرقة وتزيد أمتي عليها فرقة ليس فيها فرقة أضر على أمتي من قوم يقيمون الدين برأيهم فيحلون ما حرم الله ، ويحرمون ما أحل الله ) )(@)(@@) ( طب عد ) و الخطيب وابن عساكر عن PageV02P024 عوف بن مالك رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ ( 3599 ) قال النبي :(@)(@@) | 30 ( افترقت بنو إسرائيل على إحدى وسبعين ملة ، ولن تذهب الليالي ولا الأيام حتى تفترق أمتي على مثلها ، وكل فرقة منها في النار إلا واحدة وهي الجماعة ) )(@)(@@) عبد بن حميد عن سعد بن أبي وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3600 ) قال النبي :(@)(@@) | 30 ( أفتان أنت أفتان أنت لا تطول بهم ، إقرأ بسبح اسم ربك الأعلى والشمس وضحاها ونحو هاذا ) )(@)(@@) ( حم ) عن أنس ( ن ) عن جابر رضي الله عنهما .(@)(@@)(@@)(@@) $ 3601 قال النبي :(@)(@@) | 30 ( افتدوا من النار ولو بشق تمرة ) )(@)(@@) ابن خزيمة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3602 ) قال النبي :(@)(@@) | 30 ( إفراغك من دلوك في إناء أخيك صدقة ، وأمرك بالمعروف ونهيك عن المنكر صدقة ، وتبسمك في وجه أخيك صدقة ، وإماطة الحجر والشوك والعظم عن طريق الناس صدقة ، وهدايتك الرجل في أرض الضالة صدقة ) )(@)(@@) ( هب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3603 ) قال النبي :(@)(@@) | 30 ( افشوا السلام عباد الله كما وصفكم الله ) )(@)(@@) الخطيب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3604 ) قال النبي :(@)(@@) | 30 ( افصل بعضها من بعض ثم بعها ) )(@)(@@) ( ن ) عن فضالة بن عبيد رضي الله عنه قال : أصبت يوم خيبر فلادة فيها ذهب وخرز فأردت أن أبيعها فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 3605 ) قال النبي :(@)(@@) | 30 ( أفضل الإسلام من سلم المسلمون من لسانه ويده ) )(@)(@@) ( حم م ت ن طب ) عن أبي موسى ا ( طب ) عن ابن عمر ابن عبسة ( ط ) والدارمي وعبد بن حميد ( ع طص ض ) عن جابر ( طب هق ) عن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 3606 ) قال النبي :(@)(@@) | 30 ( أفضل الإسلام من سلم المسلمون من لسانه ويده ، وأكمل المؤمنين إيمانا أحسنهم 
ms385	 خلقا ، وأفضل الصلاة طول القنوت ، وأفضل الصدقة جهد المقل ) )(@)(@@) ابن نصر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3607 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال إيمان بالله ، وتصديق به ، وجهاد في سبيل الله ، وحج مبرور ، وأهون عليكم من ذالك إطعام الطعام ولين الكلام والسماحة وحسن الخلق ، وأهون عليك من ذالك لا تتهم الله في شيء قضاه عليك ) )(@)(@@) ( حم ش ) و الحكيم ( ع طب ) عن عبادة بن الصامت وحسن ( حم ) عن عمرو بن العاص رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3608 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال : إيمان بالله ورسوله ، ثم جهاد في سبيل الله ، ثم حج مبرور ) )(@)(@@) ( حم خ م ت ن حب ) عن أبي هريرة ( حم طب حب ص ) عن عبد الله بن سلام ( حم ش ) وعبد بن حميد والحارث ( ع طب ) عن الشفاء بنت عبد الله رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 3609 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال : إيمان بالله ورسوله ، ثم جهاد في سبيل الله سنام العمل ، ثم حج مبرور ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3610 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال عند الله : إيمان بالله ، وجهاد في سبيل الله ، وحج مبرور ، قالوا : ما بر الحج ؟ قال : إطعام الطعام ، وطيب الكلام ) )(@)(@@) ( حب ) و عبد بن حميد وابن خزيمة ( ك حل ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3611 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال الصلاة لوقتها ، وخير ما أعطي الإنسان حسن الخلق ، ألا وإن حسن الخلق خلق من أخلاق الله عز وجل ) )(@)(@@) الخطيب وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3612 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال حسن الخلق ) )(@)(@@) ( طب ) عن أسامة بن شريك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3613 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال إيمان لا شك فيه ، وجهاد لا غلول فيه ، وحجة مبرورة ، وأفضل الصلاة طول القيام ، وأفضل الصدقة جهد المقل ، وأفضل الهجرة من هجر ما حرم الله عليه ، وأفضل الجهاد من جاهد المشركين بماله ونفسه ، وأفضل القتل من اهريق دمه وعقر جواده ) )(@)(@@) ( حم ) و الدارمي ( د ن طب هق ض ) عن عبد الله بن حبشي الخثعمي رضي الله عنه 
ms386	 .(@)(@@)(@@)(@@) $ ( 3614 ) قال النبي :(@)(@@) | 30 ( أفضل الإسلام أن يسلم المسلمون من لسانك ويدك ، وأفضل الهجرة أن تهجر ما كره ربك ، والهجرة هجرتان : هجرة الحاضرة وهجرة البادي ، فهجرة البادي أن يجيب إذا دعي ويطيع إذا أمر ، وهجرة الحاضرة أعظمها بلية وأفضلها أجرا ) )(@)(@@) ( ط حم حب ك ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3615 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال إيمان بالله ثم الصلاة لأول وقتها ) )(@)(@@) ( طب ) عن امرأة من المبايعات رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3616 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال سرور تدخله على مسلم ) )(@)(@@) ( عد ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3617 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال الصلاة ثم الصلاة ثم الصلاة ، ثم الجهاد في سبيل الله ) )(@)(@@) ( حم حب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3618 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال عند الله إيمان لا شك فيه ، وغزو لا غلول فيه ، وحج مبرور ) )(@)(@@) ( حم حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3619 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال الحب في الله والبغض في الله ) )(@)(@@) ( د ) عن أبي ذر رضي الله عنه .(@)(@@) PageV02P027(@)(@@)(@@)(@@) $ ( 3620 ) قال النبي :(@)(@@) | 30 ( أفضل الأيام عند الله يوم النحر ثم يوم القر ) )(@)(@@) ( حب طب ) عن عبد الله بن قرط رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3621 ) قال النبي :(@)(@@) | 30 ( أفضل الأيام عند الله يوم الجمعة وهو شاهد ومشهود ، ويوم عرفة ، واليوم الموعود يوم القيامة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3622 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال الحال المرتحل صاحب القرآن يضرب من أوله إلى آخره حتى يبلغ آخره ، ومن آخره حتى يبلغ أوله كلما ارتحل ) )(@)(@@) ( ك ) وتعقب عن ابن عباس ( ك ) وتعقب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3623 ) قال النبي :(@)(@@) | 30 ( أفضل الإيمان خلق حسن ) )(@)(@@) ( طب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3624 ) قال النبي :(@)(@@) | 30 ( أفضل البقاع المساجد ، وأفضل أهلها أولهم دخولا وآخرهم خروجا ، ومن سبق بالجماعة كمن سبق بالإيمان ) )(@)(@@) الرافعي عن عثمان بن صهيب عن أبيه .(@)(@@)(@@)(@@) $ ( 3625 ) قال النبي :(@)(@@) | 30 ( أفضل الجهاد من عقر جواده واهريق دمه ) )(@)(@@) ( طب ) عن أبي موسى ا 
ms387	 ( ه ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3626 ) قال النبي :(@)(@@) | 30 ( أفضل الجهاد أن يعقر جوادك ويهراق دمك ) )(@)(@@) ( ط حم ) و عبد بن حميد والدارمي ( ع حب طص ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3627 ) قال النبي :(@)(@@) | 30 ( أفضل الجهاد كلمة أحدكم عند إمام جائر ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3628 ) قال النبي :(@)(@@) | 30 ( أفضل الكلام : سبحان الله والحمد لله ولا إلاه إلا PageV02P028 الله والله أكبر ) )(@)(@@) ( حم ) عن بعض الصحابة .(@)(@@)(@@)(@@) $ ( 3629 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال الصلاة ، ثم قراءة القرآن في غير الصلاة ، ثم التسبيح والتمجيد والتهليل والتكبير ، ثم الصدقة ، ثم الصيام ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3630 ) قال النبي :(@)(@@) | 30 ( أفضل الأعمال عند الله صلاة الصبح يوم الجمعة في جماعة ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3631 ) قال النبي :(@)(@@) | 30 ( أفضل الدعاء لا إلاه إلا الله ، وأفضل الذكر الحمد لله ) )(@)(@@) ( عد هب ) و ابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3632 ) قال النبي :(@)(@@) | 30 ( أفضل ما قلت أنا والنبيون قبلي عشية عرفة : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ) )(@)(@@) اسماعيل بن عبد الغافر الفارسي في الأربعين عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3633 ) قال النبي :(@)(@@) | 30 ( أفضل الكلام أربع لا تبالي بأيهن بدأت : سبحان الله والحمد لله ولا إلاه إلا الله والله أكبر ) )(@)(@@) ( ش حب ) عن سمرة بن جندب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3634 ) قال النبي :(@)(@@) | 30 ( أفضل الليل جوف الليل الآخر ، ثم الصلاة مقبولة إلى صلاة الفجر ، ثم لا صلاة إلى طلوع الشمس ، ثم الصلاة مقبولة إلى صلاة العصر ، ثم لا صلاة حتى تغرب الشمس ، قيل : يا رسول الله كيف صلاة الليل ؟ قال : مثنى مثنى ، كيف صلاة النهار ؟ قال : أربعا أربعا ، ومن صلى علي صلاة كتب الله له قيراطا ، والقيراط مثل أحد ، وإن العبد إذا قام يتوضا فغسل كفيه خرجت ذنوبه من كفيه ، ثم إذا تمضمض واستنشق خرجت ذنوبه من خياشيمه ثم إذا غسل وجهه خرجت 
ms388	 ذنوبه من ذراعيه ، ثم إذا مسح برأسه خرجت ذنوبه من رأسه ، ثم إذا غسل رجليه خرجت ذنوبه من رجليه ، ثم إذا قام إلى الصلاة خرج من ذنوبه كيوم PageV02P029 ولدته أمه ) )(@)(@@) عبد الرزاق عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3635 ) قال النبي :(@)(@@) | 30 ( أفضل الدعاء دعوة غائب لغائب ) )(@)(@@) ( ش ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3636 ) قال النبي :(@)(@@) | 30 ( أفضل الدعاء لا إلاه إلا الله ، وأفضل الدعاء الحمد لله ) )(@)(@@) ( ت ) حسن غريب ( ن ه حب ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3637 ) قال النبي :(@)(@@) | 30 ( أفضل دينار دينار ينفقه الرجل على عياله ثم على نفسه ثم على دابته في سبيل الله ثم على أصحابه في سبيل الله ) )(@)(@@) ( حم م ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3638 ) قال النبي :(@)(@@) | 30 ( أفضل صلاتكم في بيوتكم إلا المكتوبة ) )(@)(@@) ( ت ) حسن عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3639 ) قال النبي :(@)(@@) | 30 ( أفضل الشهداء أن يعقر جوادك ويهريق دمك ) )(@)(@@) ( ط ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3640 ) قال النبي :(@)(@@) | 30 ( أفضل الرقاب أغلاها ثمنا وأنفسها عند أهلها ) )(@)(@@) ( ه حب ) عن أبي ذر ( حم طب ) عن أبي أمامة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3641 ) قال النبي :(@)(@@) | 30 ( أفضل الصدقة ما كان عن ظهر غنى ، واليد العليا خير من اليد السفلى ، وابدأ بمن تعول ، تقول المرأة : إما أن تطعمني وإما أن تطلقني ، ويقول العبد : أطعمني واستعملني ، ويقول الإبن : أطعمني إلى من تدعني ) )(@)(@@) ( خ حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3642 ) قال النبي :(@)(@@) | 30 ( أفضل الصدقة أن تصدق وأنت صحيح شحيح تأمل العيش وتخشى الفقر ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV02P030(@)(@@)(@@)(@@) $ ( 3643 ) قال النبي :(@)(@@) | 30 ( أفضل الصدقة أن تشبع كبدا جائعا ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3644 ) قال النبي :(@)(@@) | 30 ( أفضل الصدقة جهد المقل ) )(@)(@@) ( ن ) عن عبد الله بن حبشي ابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3645 ) قال النبي :(@)(@@) | 30 ( أفضل الصدقة أن يتعلم المرء المسلم علما ثم يعلمه أخاه المسلم ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه 
ms389	 .(@)(@@)(@@)(@@) $ ( 3646 ) قال النبي :(@)(@@) | 30 ( أفضل الصلاة عند الله المغرب ومن صلى بعدها ركعتين بنى الله له بيتا في الجنة يغدو ويروح ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3647 ) قال النبي :(@)(@@) | 30 ( أفضل كسب الرجل ولده وكل بيع مبرور ) )(@)(@@) ( طب ) عن أبي بردة بن نيار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3648 ) قال النبي :(@)(@@) | 30 ( أفضل الإسلام الحنيفية السمحة ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3649 ) قال النبي :(@)(@@) | 30 ( أفضل الليل جوف الليل الأوسط ) )(@)(@@) ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 3650 ) قال النبي :(@)(@@) | 30 ( أفضل الصلاة بعد الفريضة قيام الليل ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3651 ) قال النبي :(@)(@@) | 30 ( أفضل الصلاة بعد الصلاة المفروضة الصلاة في جوف الليل ) )(@)(@@) ابن جرير عن جندب البجلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3652 ) قال النبي :(@)(@@) | 30 ( أفضل الصوم صوم أخي داود ، كان يصوم يوما ويطفر يوما ) )(@)(@@) ( عق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3653 ) قال النبي :(@)(@@) | 30 ( أفضل العبادة قراءة القرآن ) )(@)(@@) الحسن بن سفيان ، PageV02P031 والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3654 ) قال النبي :(@)(@@) | 30 ( أفضل الناس عند الله إمام عادل يأخذ للناس من الله ، ويأخذ للناس بعضهم من بعض ) )(@)(@@) أبو الشيخ في الثواب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3655 ) قال النبي :(@)(@@) | 30 ( أفضل العبادة طلب العلم ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3656 ) قال النبي :(@)(@@) | 30 ( أفضل الجهاد أن تجاهد نفسك وهواك في ذات الله ) )(@)(@@) الديلمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3657 ) قال النبي :(@)(@@) | 30 ( أفضل الزهد في الدنيا ذكر الموت ، وأفضل العبادة التفكر فمن أثقله ذكر الموت وجد قبره روضة من رياض الجنة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3658 ) قال النبي :(@)(@@) | 30 ( أفضل الصلاة طول القيام ) )(@)(@@) الطحاوي ( ض ) عن جابر بن نصر عن عبد الله بن حبشي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3659 ) قال النبي :(@)(@@) | 30 ( أفضل العمل العلم بالله ، قليل العمل ينفع مع العلم ، وكثير العمل لا ينفع مع الجهل ) )(@)(@@) الديلمي عن نوفل بن عبد الرحمن الثقفي عن عبادة بن عبد الصمد وهما ضعيفان 
ms390	 عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3660 ) قال النبي :(@)(@@) | 30 ( أفضل العمل الحال المرتحل ، قيل : وما الحال المرتحل ؟ قال : الخاتم والمفتتح ) )(@)(@@) محمد بن نصر من طريق ابن المبارك .(@)(@@)(@@)(@@) $ ( 3661 ) قال النبي :(@)(@@) | 30 ( أفضل العمل إيمان بالله وجهاد في سبيل الله ، قيل : فأي الرقاب أفضل ؟ قال : أنفسها عند أهلها وأغلاها ثمنا ، قيل : فإن لم أجد ؟ قال : تعين صانعا أو تصنع لآخر ، قال : فإن لم أستطع ؟ قال : كف أذاك عن PageV02P032 الناس فإنها صدقة تصدق بها على نفسك ) )(@)(@@) ( حم خ م ك حب ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3662 ) قال النبي :(@)(@@) | 30 ( أفضل أهل الجنازة أجرا أكثرهم فيها ذكرا ، ومن لم يجلس حتى توضع ، وأوفاهم مكيالا من حثى عليها ثلاثا ) )(@)(@@) ابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3663 ) قال النبي :(@)(@@) | 30 ( أفضل شيء في الميزان الخلق الحسن ) )(@)(@@) ( كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3664 ) قال النبي :(@)(@@) | 30 ( أفضل الثغور أرض ستفتح يقال لها قزوين ، من بات بها ليلة احتسابا مات شهيدا وبعث مع الصديقين في زمرة النبيين حتى يدخل الجنة ) )(@)(@@) الخليل بن عبد الجبار في فضائل قزوين والرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3665 ) قال النبي :(@)(@@) | 30 ( أفضل عمل يؤتى به يوم القيامة خلق حسن ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3666 ) قال النبي :(@)(@@) | 30 ( أفضل المسلمين من سلم المسلمون من لسانه ويده ) )(@)(@@) ( حم حب ) و الخرائطي في مكارم الأخلاق عن جابر والخرائطي ( طب ) عن عمير بن قتادة الليثي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3667 ) قال النبي :(@)(@@) | 30 ( أفضل المؤمنين كل مؤمن مخموم القلب قال : التقي النقي الذي لا إثم فيه ولا بغي ولا غل ولا حسد ، قالوا : فمن يليه ؟ قال : الذين نسوا الدنيا وأحبوا الآخرة ، قالوا : فمن يليه ؟ قال : مؤمن في خلق حسن ) )(@)(@@) الحكيم ( حل ) والخرائطي في مكارم الأخلاق عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3668 ) قال النبي :(@)(@@) | 30 ( أفضل ما أعطي المسلم خلق حسن ) )(@)(@@) ( طب ) عن أسامة بن شريك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3669 ) قال النبي :(@)(@@) | 30 ( أفضل ما أعطي المرء 
ms391	 المسلم حسن الخلق ) PageV02P033 )(@)(@@) ( حب ) عن أسامة بن شريك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3670 ) قال النبي :(@)(@@) | 30 ( أفضل الهجرة أن تهجر ما كره الله ) )(@)(@@) ( حم ) و عبد بن حميد عن جابر ( ن هق ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3671 ) قال النبي :(@)(@@) | 30 ( أفضل الهجرة أن تهجر السوء ) )(@)(@@) ( طب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3672 ) قال النبي :(@)(@@) | 30 ( أفضلكم من تعلم القرآن وعلمه ) )(@)(@@) ( كر ) عن ععثمان رضي الله عنه .(@)(@@)(@@)(@@) $ 3673 قال النبي :(@)(@@) | 30 ( أفطر الحاجم والمستحجم ) )(@)(@@) ( حم ن ض ) عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3674 ) قال النبي :(@)(@@) | 30 ( أفطر الحاجم والمحجوم والمستحجم ) )(@)(@@) ( ه ) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3675 ) قال النبي :(@)(@@) | 30 ( أفطر فإنه ليس من البر الصيام في السفر ) )(@)(@@) الخطيب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3676 ) قال النبي :(@)(@@) | 30 ( افعلوها حولوا مقعدتي نحو القبلة ) )(@)(@@) عبد الرزاق عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3677 ) قال النبي :(@)(@@) | 30 ( افعلي كل ما يفعل الحاج غير أن لا تطوفي بالبيت حتى تطهري ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها قالت : قدمت مكة وأنا حائض فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 3678 ) قال النبي :(@)(@@) | 30 ( أفعمياوان أنتما ألستما تبصرانه ) )(@)(@@) ( حم د ت ) حسن صحيح عن أم سلمة رضي الله عنها .(@)(@@) PageV02P034(@)(@@)(@@)(@@) $ ( 3679 ) قال النبي :(@)(@@) | 30 ( أففت من صاحب هاذا القبر الذي سئل عني فشك في ) )(@)(@@) ( طب ) رباح بن صالح بن عبيد الله بن أبي رافع عن أبيه عن جده رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3680 ) قال النبي :(@)(@@) | 30 ( أفلا انتفعتم به فإن دباغها زكاتها ، يحل كما يحل خل الخمر ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3681 ) قال النبي :(@)(@@) | 30 ( أفلا قلت : ليهنئك الطهور ) )(@)(@@) تمام وابن عساكر عن أبي أمامة قال : مر رجل فقال : يا رسول الله ما له قالوا كان مريضا فذكره .(@)(@@)(@@)(@@) $ ( 3682 ) قال النبي :(@)(@@) | 30 ( أفلا تفدين بها بنت أخيك أو بنت أختك من رعاية الغنم ) )(@)(@@) ( طب ) عن هزيلة أم حفيد الهلالية رضي الله عنها أنها قالت : يا رسول الله إني أردت أن أعتق هاذه 
ms392	 قال فذكره .(@)(@@)(@@)(@@) $ ( 3683 ) قال النبي :(@)(@@) | 30 ( أفلا ترمونهم بالبعر ) )(@)(@@) ( طب ) عن أبي أيوب قال : قيل : يا رسول الله إن هاهنا قوما يجهرون بالقراءة في صلاة النهار قال فذكره .(@)(@@)(@@)(@@) $ ( 3684 ) قال النبي :(@)(@@) | 30 ( أفلا قبل هاذا ، أو تريد أن تميتها موتتين ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما قال : مر رسول الله على رجل واضع رجله على صفحة شاة وهو يحد شفرته وهي تلحظ ببصرها قال فذكره .(@)(@@)(@@)(@@) $ ( 3685 ) قال النبي :(@)(@@) | 30 ( أفلا انتفعتم بإهابها يحلها دباغها كما يحل خل الخمر ) )(@)(@@) ( طس ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3686 ) قال النبي :(@)(@@) | 30 ( أفيكم أحد من هزيل ، إن صاحبكم محتبس بدينه ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3687 ) قال النبي :(@)(@@) | 30 ( أفطر الحاجم والمحجوم ) )(@)(@@) ( حم ) و العدني وابن جرير ( ه ق ) عن أسامة بن زيد ( بز ) وابن جرير ( قط طس ) عن أنس ( حم ن ) وابن جرير وضعفه ( طب ض ) عن بلال ( ط حم ) والدارمي ( ن ه ) والشاشي والروياني وابن جرير وابن الجارود ( ع ) وابن خزيمة ( حب ) والباوردي وابن قانع ( طب ك هق ض ) عن ثوبان قال ( حم ) هو أصح ما في الباب ( بز ) وابن جرير عن جابر ( حم ت حسن ) وابن جرير وابن خزيمة ( حب طب ك هق ض ) عن رافع بن خديج بن جرير عن سعد ( بز طب هب ض ) عن سمرة ( ط حم ) والدارمي ( د ه ) وابن جرير ( حب ك ق ض ) عن شداد بن أوس ( بز ) وابن جرير ( طب ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 3688 ) قال النبي :(@)(@@) | 30 ( أفيكم من طعم اليوم ، من كان لم يطعم فليتم صومه ، ومن كان طعم شيئا فليتم بقية يومه يعني يوم عاشوراء ) )(@)(@@) ( طب ) عن محمد بن صيفي الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الهمزة مع القاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 3689 ) قال النبي :(@)(@@) | 30 ( إقامة حد من حدود الله خير من مطر أربعين ليلة في بلاد الله ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3690 ) قال النبي :(@)(@@) | 30 ( إقبل الحديقة وطلقها تطليقة ) )(@)(@@) ( خ ن 
