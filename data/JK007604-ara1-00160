ms141	 % % م شهادة بولائكا % % 5(@)(@@) % فلقد رضيت بشاهد % من شاهدين بذلكا % % 6(@)(@@) % أو لا فمن أهجو ، إذا % % أنكرت عند دعائكا % % 7(@)(@@) % سيان قلت الشعر في ال % % جعلان أو ضربائكا % % PageV01P677 البحر : وافر تام 1(@)(@@) % أحقا منك أنك لن تراني ، % على حال وأني لن أراكا % % 2(@)(@@) % وأنك غائب في قعر لحد ، % وما قد كنت تعلوه علاكا % % 3(@)(@@) % فلا ضحكت ، وقد غيبت ، سني ، % ولا رقأت مدامع من سلاكا % % PageV01P678 البحر : طويل 1(@)(@@) % رأيت المحبين الصحيح هواهم ، % إذا بلغوا الجهد استراحوا إلى البكا % % 2(@)(@@) % ولكن أيوبا إذا ما فؤاده % تذكر من لسنا نسمي تحركا % % 3(@)(@@) % دعا بدواة عند ذاك ملاقة ، % فخط اسمه في كفه ثم دلكا % % 4(@)(@@) % فلو كان يرضى العاشقون بمثل ما % % رضيت به ما حن صب ولا شكا % % PageV01P679 البحر : متقارب تام 1(@)(@@) % تفرد قلبي ، فما يشتبك ، % بحب الظباء ، وبغض السمك % 2(@)(@@) % ولم أرلي فيهما مسعدا ، % يساعدني غير عبد الملك % 3(@)(@@) % فتى ينهش الكتف من ظهرها % % ولا يتعرق بطن الورك % 4(@)(@@) % ولا يتأنى لشعب الصدوع ، % ولكن بصير بصدع الفلك % 5(@)(@@) % خروق جهول بحل الإزار ، % رقيق بصير بحل التكك % PageV01P680 البحر : هزج 1(@)(@@) % سألت أخي أبا عيسى ، % وجبريل له عقل % 2(@)(@@) % فقلت : الخمر تعجبني ! % فقال : كثيرها قتل % 3(@)(@@) % فقلت له : فقدر لي ! % فقال ، وقوله فصل : % 4(@)(@@) % وجدت طبائع الإنسا % % ن أربعة هي الأصل % 5(@)(@@) % فأربعة لأربعة ، % لكل طبيعة رطل % PageV01P681 البحر : طويل 1(@)(@@) % نجوت من اللص المغير بسيفه ، % إذا ما رماه بالتجار سبيل % 2(@)(@@) % وسلطت خمارا علي بخمره ، % فراح بأثوابي ، ورحت أميل % PageV01P682 البحر : منسرح 1(@)(@@) % أما ترى الشمس حلت الحملا ، % وقام وزن الزمان ، عاعتدلا % % 2(@)(@@) % وغنت الطير بعد عجمتها ، % واستوفت الخمر حولها كملا % % 3(@)(@@) % واكتست الأرض من زخارفها % % وشي نبات ، تخاله حللا % % 4(@)(@@) % فاشرب على جدة الزمان ، فقد % أصبح وجه الزمان مقتبلا % % 5(@)(@@) % كرخية تترك الطويل من ال % % عيش قصيرا ، وتبسط الأملا % % 6(@)(@@) % تلعب لعب السراب في قدح ال % % قوم ، إذا ما حبابها اتصلا % % 7(@)(@@) % يقول : صرف ! إذا مزجت له ، % من لم يكن للكثير محتملا % % 8(@)(@@) % عجنا بثنتين 
ms142	 من طبائعها % % حسنا ، وطيبا ترى به المثلا % % PageV01P683 البحر : كامل تام 1(@)(@@) % يا رب صاحب حانة قد رعته ، % فبعثته من نومه المتزمل % 2(@)(@@) % عرفت ثياب الطارقين كلابه ، % فيبتن عن سنن الطريق بمعزل % 3(@)(@@) % ما زلت أمتحن الدساكر دونه ، % حتى دفعت إلى خفي المنزل % 4(@)(@@) % فعرفته ، والليل ملتبس بنا ، % برفيف صلعته وشيب المسحل % 5(@)(@@) % يا صاحب الحانوت لا تك مشعيا ، % إن الشراب محرم كمحلل % 6(@)(@@) % فدع الذي نبذت يداك ، وعاطني ، % لله درك ، من نبيذ الأرجل % 7(@)(@@) % مما تخيره التجار ، ترى لها % % قرصا إذا ذيقت كقرص الفلفل % 8(@)(@@) % ولها دبيب في العظام كأنه % قبض النعاس ، وأخذه بالمفصل % 9(@)(@@) % عبقت أكفهم بها ، فكأنما % % يتنازعون بها سخاب قرنفل % 10(@)(@@) % تسقيكها كف إليك حبيبة ، % لا بد أن بخلت ، وإن لم تبخل % PageV01P684 البحر : بسيط تام 1(@)(@@) % بادر صبوحك ، وانعم أيها الرجل ، % واعص الذين بجهل في الهوى عذلوا % % 2(@)(@@) % واخلع عذارك ، أضحك كل ذي طرب % واعدل بنفسك فيهم أينما عدلوا % % 3(@)(@@) % نال السرور ، وخفض العيش في دعة % وفاز بالطيبات الماجن الهزل % 4(@)(@@) % سقيا لمجلس فتيان أنادمهم % ما في أديمهم وهي ، ولا خلل % 5(@)(@@) % هذا لذاك ، كما هذا وذاك لذا ، % فالشمل منتظم ، والحبل متصل % 6(@)(@@) % أكرم بهم ، وبنغم من مغنية ، % ففي الغناء يضرب المثل % 7(@)(@@) % هيفاء تسمعنا ، والعود يطربنا : % ' ودع هريرة إن الركب مرتحل ' % PageV01P685 البحر : وافر تام 1(@)(@@) % أمالك باكر الصهباء مال ، % وإن غالوا بها ثمنا فغال % 2(@)(@@) % وأشمط ، رب حانوت ، تراه % لنفخ الزق مسود السبال % 3(@)(@@) % دعوت ، وقد تخونه نعاس ، % فوسده براحته الشمال % 4(@)(@@) % فقام لدعوتي فزعا مروعا ، % وأسرع نحو إشعال الذبال % 5(@)(@@) % وأفرخ روعه ، وأفاد بشرا ، % وهرهر ضاحكا جذلان بال % 6(@)(@@) % فلما بينتني النار حيا % % تحية وامق ، لطف السؤال % 7(@)(@@) % عددت بكفه ألفا لشهر ، % بلا شرط المقيل ، ولا المقال % 8(@)(@@) % فظلت لدى دساكره عروسا ، % بعذراوين من خمر وآل % 9(@)(@@) % كذلك لا أزال ، ولم أزله % ذريع الباع في ديني ومالي % % 10(@)(@@) % يلائمني الحرام ، إذا اجتمعنا ، % وأجفو عن ملاءمة الحلال % PageV01P686 البحر : كامل تام 1(@)(@@) % نزه صبوحك عن مقال العذل 
ms143	 ، % ما العيش إلا في الرحيق السلسل % 2(@)(@@) % ما العيش إلا أن تباكر شربها % % صفراء ، زفت من قرى قطربل % 3(@)(@@) % تهدي لقلب المستكين تخيلا ، % وتلين قلب البازخ المتخيل % 4(@)(@@) % وكأن شاربها لطيل نسيمها % % وافت مشاربه سحاب قرنفل % 5(@)(@@) % ولقد دخلت على الكواعب حسرا ، % فلقينني بتبسم ، وتهلل % 6(@)(@@) % فأصبت من طرف الحديث لذاذة % وأصبنها مني ، ولما أجهل % PageV01P687 البحر : مخلع البسيط 1(@)(@@) % ومجلس ما له شبيه ، % حل به الحسن والجمال % 2(@)(@@) % يمطر فيه السرور سحا ، % بديمة ما لها انتقال % 3(@)(@@) % شهدته في شباب صدق ، % ما إن تسامى لهم فعال % 4(@)(@@) % نأخذ صهباء ، بنت كرم ، % عذراء ، لم تؤوها الحجال % 5(@)(@@) % نشربها بالكبار صرفا ، % وليس في شربنا مطال % 6(@)(@@) % يسعى بها مخطف ، غرير ، % كأنه البدر ، أو مثال % 7(@)(@@) % فصرع القوم ، واستدارت % رحى الحميا بهم ، فمالوا % % 8(@)(@@) % كأنما الشرب بعد هذي ، % صرعى تمادى بهم كلال % 9(@)(@@) % حتى إذا ما بدا سهيل ، % وحان من ليلنا ارتحال % 10(@)(@@) % نبهت طلق اليدين ، سمحا % يمطر من كفه النوال % PageV01P688 11(@)(@@) % فقلت : خذها فدتك نفسي ، % فكل شيء له زوال % 12(@)(@@) % فقام ، والنوم في المآقي ، % كأنما مسه خبال % 13(@)(@@) % ثم احتبى مسرعا ، وغنى % % بخسروي له دلال : % 14(@)(@@) % ( عيناك دمعاهما سجال % كأن شأنيهما وشال % PageV01P689 البحر : وافر تام 1(@)(@@) % وخمار تحططت إليه رحلي ، % فقام مثرنحا ، ثملا ، يميل % 2(@)(@@) % فقلت له : اتئد ، فالرفق يمن ، % ولم يظفر بحاجته العجول % 3(@)(@@) % فرد علي رد فتى أديب : % خليلي لست أجهل ما تقول % 4(@)(@@) % وقام إلى التي عكفت عليها % % بنات الدهر ، والزمن الطويل % 5(@)(@@) % فودج خصرها ، فبدا لسان ، % كأن لعابه علق يسيل % 6(@)(@@) % بكف مزنر ، أعلاه غصن ، % وأسفل خصره ردف ثقيل % 7(@)(@@) % أقول ، وقد بدا للصبح نجم : % خليلي إن فعلك بي جميل % 8(@)(@@) % أرحني قد ترفعت الثريا ، % وغالت جنح ليلى عنك غول % 9(@)(@@) % فقال : الآن تأمرني بهذا ، % وقد علقت مفاصلي الشمول % PageV01P690 البحر : منسرح 1(@)(@@) % إني ، وإن كنت ماجنا ، خرقا ، % لا يخطر النسك لي على بال % 2(@)(@@) % لذو حياء ، وذو محافظة ، % مبتاع حمد الرجال بالغالي % % 3(@)(@@) % فإن دنس المال عرضذي شرف 
ms144	 % فإن عرضي يصان بالمال % 4(@)(@@) % وأعشق الجؤذر الرخيم ، ولا % % أكتم حبي له فيخفى لي % % 5(@)(@@) % وخندريس باكرت حانتها ، % فودجوا خصرها بمبزال % 6(@)(@@) % فسال عرق على ترائبها ، % كأن مجراه فتل خلخال % 7(@)(@@) % حتى إذا صبها مفدمة ، % تضحك عن جوهرات لأآل % 8(@)(@@) % دعوت إبليس ، ثم قلت له : % لا تسق هذا الشراب عذالي % % 9(@)(@@) % فبت أسقى ومن كلفت به % % مدامة صفقت بسلسال % PageV01P691 البحر : طويل 1(@)(@@) % أيا من دعاني للوصال كتابة ، % مرارا ، ومن بعد الكتاب رسول % 2(@)(@@) % وما سرني أني أكون يحالة ، % لمثلك في الدنيا علي سبيل % PageV01P692 البحر : منسرح 1(@)(@@) % أحسن من وقفة على طلل ، % كأس عقار ، تجري على ثمل % 2(@)(@@) % يديرها أحور ، به هيف ، % معتدل الخلق ، راجح الكفل % 3(@)(@@) % على شباب ما فيهم خرق ، % ولا سفيه ، ولا أخو زلل % 4(@)(@@) % إذا استدارت بكفه ، وبدت % رأيت فيها كهيئة الشعل % 5(@)(@@) % تحكي لنا الجلنار وجنته ، % إذا علاها تورد الخجل % 6(@)(@@) % فإن ترم عنده مداعبة ، % قال لك : احذر من ذلك العمل % 7(@)(@@) % فحين منه خشيت جلوته ، % أكثر في جوده من القبل % 8(@)(@@) % وما لمن رام منه جلوته ، % وصرت من حبه على وجل % 9(@)(@@) % دعوت إبليس ثم قلت له : % قد أعجزتني مذاهب الحيل % 10(@)(@@) % حبلي ، وحبل الذي كلفت به ، % على تدانيه ، غير متصل % PageV01P693 11(@)(@@) % فرده الشيخ عن صعوبته ، % وصار قوادنا ولم يزل % PageV01P694 البحر : وافر تام 1(@)(@@) % أعاذل ما علي مثلي سبيل % وعذلك في المدامة يستحيل % 2(@)(@@) % أعاذل لا تلمني في هواها % % فإن عتابنا فيها يطول % 3(@)(@@) % كلانا يدعي في الخمر علما ، % فدعني ، لا أقول ولا تقول % 4(@)(@@) % ليس مطيتي حقوي غلام ، % و رحل أناملي كأس شمول ! ؟ % 5(@)(@@) % إذا كانت بنات الكرم شربي ، % وقبلة وجهي الحسن الجميل % 6(@)(@@) % آمنت بذين عاقبة الليالي ، % وهان علي ما قال العذول % 7(@)(@@) % ومعتدل إلي بشطر عين ، % له من كسر ناظره رسول % 8(@)(@@) % صرفت الكأس عنه حين غنى ، % وأن لسانه منها ثقيل : % 9(@)(@@) % ( أرحني قد ترفعت الثريا ، % وغالت جنح ليلي عنك غول % PageV01P695 البحر : سريع 1(@)(@@) % لا تمزج الخمر على حال % وسقنيها منك أحوال 
ms145	 % % 2(@)(@@) % عتقها الكردي في مجلس ، % بين بساتين ، وأجبال % % 3(@)(@@) % ثم أتانا ناكسا رأسه ، % منحدرا من مرقب عال % 4(@)(@@) % إبريقه في كفه مترع ، % ترف من ذوب جريال % 5(@)(@@) % نأخذها من كف ذي غنة ، % كأنما خط بتمثال % 6(@)(@@) % يسقيك بالعينين خمرا إذا % % ناغاك بالكأس لإعجاب % 7(@)(@@) % ليس بمحتاج إلى مكحل % ولا دماليج ، وخلخال % 8(@)(@@) % خال به في خده واضح ، % وا بأبي ذالك من خال ! % PageV01P696 البحر : بسيط تام 1(@)(@@) % دع الوقوف على رسم وأطلال % ودمنة كسحيق اليمنة البالي % % 2(@)(@@) % وعج بنا نصطبح صفراء ، واقدة ، % في حمرة النار ، أو رقة الآل % 3(@)(@@) % لم يذهب الدهر عنها حد سورتها ، % ولم ينلها الأذى في دهرها الخالي % % 4(@)(@@) % قام الغلام بها في الليل يمزجها ، % كالبدر ، ضوء سناه للدجى حال % % 5(@)(@@) % تكاد تخطف أبصارا ، إذا مزجت % بالماء ، واجتليت في لونها الحالي % % 6(@)(@@) % تفتر في أوجه الندمان ضاحكة ، % كمثل در وهي من كف لأآل % 7(@)(@@) % ترى الكريم عن الأنذال يصرفها ، % يبقي عليها ، ولا يبقي على مال % 8(@)(@@) % في بيت كافرة ، بالخمر تاجرة ، % شمطاء ، شاطرة ، تعتز بالوالي % % PageV01P697 البحر : خفيف تام 1(@)(@@) % وتمام السرور فيها بساق ، اسقياني الحرام قبل الحلال ، % ودعاني من دارس الأطلال % 2(@)(@@) % إنما العيش في مباكرة الخم % ر ، وسكر يدوم في كل حال % 3(@)(@@) % وتمام السرور فيها بساق ، % حسن الوجه ، مستنير الجمال % 4(@)(@@) % لو بدا وجهه إذا الشمس دارت % قلت نوران صورا من مثال % 5(@)(@@) % فاسقياني رقيقة السربال ، % تعدماني معارف الأطلال . . . . . % PageV01P698 البحر : بسيط تام 1(@)(@@) % مالي بدار خلت من أهلها شغل ، % ولا شجاني لها شخص ولا طلل % 2(@)(@@) % ولا رسوم ، ولا أبكي لمنزلة ، % للأهل عنها ، وللجيران منتقل % 3(@)(@@) % ولا قطعت على حرف مذكرة % في مرفقيها ، إذا استعرضتها ، فتل % 4(@)(@@) % بيداء مقفرة يوما ، فأنعتها ، % ولا سرى بي ، فأحكيه بها ، جمل % 5(@)(@@) % ولا شتوت بها عاما فأدركني % % فيها المصيف ، فلي عن ذاك مرتحل % 6(@)(@@) % ولا شددت بها من خيمة طنبا ، % جارى بها الضب والحرباء والورل % 7(@)(@@) % لا الحزن مني برأي العين أعرفه ، % وليس يعرفني سهل ولا جبل % 8(@)(@@) % لا أنعت 
ms146	 الروض إلا رأيت به % قصرا منيفا ، عليه النخل مشتمل % 9(@)(@@) % فهاك من صفتي إن كنت مختبرا ، % ومخبرا نفرا عني ، إذا سألوا % % 10(@)(@@) % نخل ، إذا جليت إبان زينتها ، % لاحت بأعناقها أعذاقها النحل % PageV01P699 11(@)(@@) % أسقاط عسجده فيها لآلئها ، % منضودة ، بسموط الدر تتصل % 12(@)(@@) % يفتضها فطن علج بها خبر ، % فض العذارى ، حلاها الريط والحلل % 13(@)(@@) % فافتض أولها منها وآخرها % % فأصبحت ، وبها من فحلها حبل % 14(@)(@@) % لم تمتنع عفة منه ، ولا ورعا % بلا صداق ، ولم يوجد لها عقل % 15(@)(@@) % حتى إذا لقحت أرخت عقائصها ، % فمال منتثرا عرجونها الرجل % 16(@)(@@) % فبينما هي والأرواح تنفحها ، % شهرين بارحة وهنا ، وتنتحل % 17(@)(@@) % أرخت عقودا من الياقوت ترضعه ، % حتى تمكن في أوصاله العسل % 18(@)(@@) % يا طيب تلك عروسا في مجاسدها ، % لو كان يصلح منها الشم والقبل % 19(@)(@@) % خلالها شجر في فيئه نقد ، % لا يرهب الذئب فيها الكبش والحمل % 20(@)(@@) % إن جئت زائرها غناك طائرها ، % % PageV01P700 21(@)(@@) % من بلبل غرد ناداك من غصن ، % يبكي لبلبلة أودى بها خبل % 22(@)(@@) % هذا فصفه ، وقل في وصفه سددا ، % مدت لواصفه في عمره الطول % 23(@)(@@) % ما بين ربع ولارسم ولا طلل % أقوى وبيني في حكم الهوى عمل % 24(@)(@@) % مالي وعوسجها بالقاع جانيها % % أفعى يقابلها عن جحره ورل % 25(@)(@@) % إني امرؤ همتي ، والله يكلؤني ، % أمران ما فيهما شرب ولا أكل % 26(@)(@@) % حب النديم ، وما في الناس من حسن % كفي إليه إذا راجعته خضل % 27(@)(@@) % لا أمدحن ولا أخطي خلائقه % من عنده لي إذا ما جئته نزل . . . % PageV01P701 البحر : مجزوء الخفيف 1(@)(@@) % دع جنانا وحبها % % عنك ، إن كنت عاقلا % % 2(@)(@@) % لا تذكر بنفسك ال % موت مادام غافلا % % 3(@)(@@) % أنت إن لم تمت بها ال % عام لم تنج قابلا % % 4(@)(@@) % رحمت نفسك التي % % ذهبت عنك باطلا ! % PageV01P702 البحر : رمل تام 1(@)(@@) % شجر التفاح لا ذقت القحل % لا ، ولا زلت لغايات المثل % 2(@)(@@) % وعدتني قبلة من سيدي ، % فتعاضت سيدي حين فعل % 3(@)(@@) % ليس ذاك العض من عيب بها ، % إنما ذاك سؤال للقبل % PageV01P703 البحر : خفيف تام 1(@)(@@) % واشربنها كأنها عين ديك ، انس 
ms147	 رسم الديار ثم الطلولا ، % واهجر الربع دارسا ومحيلا % % 2(@)(@@) % هل رأيت الديار ردت جوابا ، % وأجابت لذي سؤال سؤولا % % 3(@)(@@) % واشربنها كأنها عين ديك ، % يطرد الهم طعمها ، والغليلا % % 4(@)(@@) % هي إذ ما تغلغلت في عروقي ، % عجل الهم عن فؤادي الرحيلا % % 5(@)(@@) % ونديم مساعد ، غير نكس ، % حيثما ملت مال معك مميلا % % 6(@)(@@) % رنحته الكؤوس بالصرف حتى % % خر منها على الجبين تليلا % % 7(@)(@@) % قلت لما بدت تباشير صبح ، % هتكت في دجى الظلام الذيولا % % 8(@)(@@) % فشكا شدة الخمار عليه ، % وتلكا لأخذ كأس قليلا : % 9(@)(@@) % فم بنفسي أقيك من كل سوء ، % فاصطبخها مدامة ، مشمولا % % 10(@)(@@) % قلت : خذها لكي يزول التشكي % % فبها يصبح الخمار قتيلا % % PageV01P704 11(@)(@@) % فاستوى قاعدا ، وأبرز كفا % لم تزل راحها لراح حمولا % % 12(@)(@@) % وتغنى على المدام ثلاثا : % أزجر العين أن تبكي الطولا . . . % PageV01P705 البحر : طويل 1(@)(@@) % لقد جن من يبكي على رسم منزل % ويندب أطلالا عفون بجرول % 2(@)(@@) % فإن قيل : ما يبكيك ؟ قال : حمامة % تنوح على فرخ بأصوات معول % 3(@)(@@) % تذكرن حيا حلالا بقفرة ، % وآخية شدت بفهر وجندل % 4(@)(@@) % لكنني أبكي على الراح ؛ إنها % % حرام علينا في الكتاب المنزل % 5(@)(@@) % سأشربها صرفا ، وإن هي حرمت ، % فقد طالما واقعت غير محلل % PageV01P706 البحر : وافر تام 1(@)(@@) % فديتك ، فيم عتبك من كلام % نطقت به على وجه جميل ؟ ! % 2(@)(@@) % وقولك للرسول : عليك غيري ، % فليس إلى التواصل من سبيل % 3(@)(@@) % فقد جاء الرسول له انكسار ، % وحال ما عليها من قبول % 4(@)(@@) % ولو ردت جنان مرد خير % تبين ذاك في وجه الرسول % PageV01P707 البحر : كامل تام 1(@)(@@) % أين الجواب ، وأين رد رسائلي ؟ % قالت : تنظر ردها في قابل % % 2(@)(@@) % فمددت كفي ، ثم قلت : تصدقي ! % قالت : نعم ؛ بحجارة وجنادل % % 3(@)(@@) % إن كنت مسكينا ، فجاوز بابنا % % وارجع ، فمالك عندنا من نائل % 4(@)(@@) % ياناهر المسكين عند سؤاله ، % الله عاتب في انتهار السائل % PageV01P708 البحر : كامل تام 1(@)(@@) % رسم الكرى بين الجفون محيل % عفى عليه بكا عليك طويل % 2(@)(@@) % يا ناظرا ما أقلعت لحظاته ، % حتى تشحط بينهن قتيل % 3(@)(@@) % أحللت من قلبي هواك محلة ، % ما حلها المشروب 
ms148	 والمأكول % 4(@)(@@) % بكمال صورتك التى في مثلها % % يتحير التشبيه والتمثيل % 5(@)(@@) % فوق القصيرة ، والطويلة فوقها ، % دون السمين ، ودونها المهزول % PageV01P709 البحر : مجزوء الكامل 1(@)(@@) % إن التي أبصرتها % % سحرا تكلمني ؛ رسول % 2(@)(@@) % ليست هي القصد الذي % % يومي إليه ، ولا السبيل % 3(@)(@@) % أدت إلي رسالة ، % كادت لها نفسي تسيل % 4(@)(@@) % من ساحر العينين يج % ذب خصره ردف ثقيل % 5(@)(@@) % متقلد قوس الصبا ، % يرمي وليس له رسيل % 6(@)(@@) % فلو ان أذنك بيننا % % حتى تسمع ما نقول % 7(@)(@@) % لرأيت ما استقبحته % من أمرنا وهو الجميل % 8(@)(@@) % وعلمت أني في نع % % يم لا يحول ولا يزول % PageV01P710 البحر : بسيط تام 1(@)(@@) % إني وذكري من حسن محاسنها ، % مثل الذي قال : ما أحلاك ياعسل ! % 2(@)(@@) % أحدث الناس أني قد وقعت لهم % % من وجه حسن على الأمر الذي جهلوا % % 3(@)(@@) % قد اكتفى الناس من علمي بعلمهم ، % فالرد مني عليهم علمهم نقل % PageV01P711 البحر : مجزوء الكامل 1(@)(@@) % آنست نفسي بالتوح % د ، لا أريد به بديلا % % 2(@)(@@) % موف على شرف المني % ة ، مضمر حزنا دخيلا % % 3(@)(@@) % لكن واردة الحما % % م موائلا عندي مثول % 4(@)(@@) % يا جيرة ذهبت عل % ي ، علوا بها عرضا وطولا % % 5(@)(@@) % أمسى الحبيب ، ولا أطي % % ق إلى زيارته سبيلا % % 6(@)(@@) % ألقت مراقبة العيو % % ن لتجتني قالا وقيلا % % 7(@)(@@) % إن دام ذا كان البقا % % ء ، ولا بقيت له ، قليلا ! % PageV01P712 البحر : بسيط تام 1(@)(@@) % نبات ! بنت ! سباك الله من أمة ، % كم اعترتك على الدهر المشاغيل % 2(@)(@@) % كم قد عذلت ، وكم عاتبت مجتهدا ، % وقلت لو أخذت فيك الأقاويل % 3(@)(@@) % ما أنت إلا عروس يوم جلوتها % % على المنصة ، تجلوها العطابيل % 4(@)(@@) % أما نبات ، فقد أضحت مخضبة ، % والشعر مفترق بالبان مغسول % 5(@)(@@) % قالت : تعللت بالحناء ، قلت لها : % ما بت تطاريف بالحناء تعليل % 6(@)(@@) % هذي التطاريف من غنج ومن عبث ، % كما زعمت ، فما للطرف مكحول ؟ % 7(@)(@@) % قالت : كحلت بعذر العين من رمد ، % فقلت ! عذرا : فما للشعر مبلول ؟ % 8(@)(@@) % قالت : مطرنا ، ولم تمطر ، فقلت لها : % ما بال مئزرك المصقول محلول ؟ % 9(@)(@@) % قالت : برمت به حملا ، فأثقلني ، % هذا 
ms149	 الإزار ، فلم حل السراويل ؟ % 10(@)(@@) % قالت : غلبت على نفسي ، فقلت لها : % هذا زناك ، فما هذي أباطيل % PageV01P713 11(@)(@@) % زال الحمار ، وكانت تلك منيته % في الطين ، إن حمار السوء موحول % PageV01P714 البحر : مديد تام 1(@)(@@) % يا مبيح الدمع في الطلل ، % راكبا منه إلى أمل % 2(@)(@@) % أله عما أنت طالبه ، % من جواب النؤي والطلل % 3(@)(@@) % ببنات الشمس ما منعت ، % نفسها من لمس مبتذل % 4(@)(@@) % ما لهافي الكأس من نسب ، % غير ما تجني من الشعل % 5(@)(@@) % يذهب الجاني جنايتها % % في مقر النفس بالمهل % 6(@)(@@) % تتمرى بالعيون لما % % يتغشاها من الوشل % 7(@)(@@) % فإذا ما الماء واقعها ، % أظهرت شكلا من الغزل % 8(@)(@@) % لؤلؤات ينحدرنا بها ، % كانحدار الدمع في عجل % 9(@)(@@) % فإذا ما المرء قبلها ، % أسكرته لذة القبل . . . % PageV01P715 البحر : بسيط تام 1(@)(@@) % لأعذلن فؤادي أبلغ العذل ، % حتى أنهنهه عن مثلي ذا العمل % 2(@)(@@) % مناني الصبر ، لا يألو ، ليوقعني ، % حتى إذا صار بي في مقطع السبل % 3(@)(@@) % أبى الوفاء بما منى ، وأسلمني % % لكل معجلة عن موقت الأجل % 4(@)(@@) % أف وأف لقلبي ؛ ما استجبت له % قلبا لقد كان مني غير ذي أمل % PageV01P716 البحر : منسرح 1(@)(@@) % مر بنا ، والعيون تأخذه ، % تجرح منه مواضع القبل % 2(@)(@@) % أفرغ في قالب الجمال ، فما % % يصلح إلا لذلك العمل % PageV01P717 البحر : مجزوء الرمل 1(@)(@@) % دمعة كاللؤلؤ الرط % ب على الخد الأسيل % 2(@)(@@) % قطرت في ساعة البي % ن ، من الطرف الكحيل % 3(@)(@@) % إنما يفتضح العا % % شق في وقت الرحيل % PageV01P718 البحر : سريع 1(@)(@@) % عجزت يا مهجور أن تذهلا ، % ومن ذوي نصحك أن تقبلا % % 2(@)(@@) % سجية لست لها تاركا ، % إذا تولوا عنك أن تقبلا % % 3(@)(@@) % وتذرف العين ، إذا ما نأوا ، % وإن أساؤوا الدهر أن تجملا % % 4(@)(@@) % إني ، وإن لم أك مستحسنا % مني لذا الهجر ، ومستجملا % % 5(@)(@@) % فالموت أن يزرى على عاشق ، % يقال قد كان ، ولكن سلا % % 6(@)(@@) % ياويلتي من جسدي كله ، % رضض مني مفصلا ، مفصلا % % 7(@)(@@) % ترى المعافى يعذر المبتلى ، % ولا يعين المبتلي المبتلى % % PageV01P719 البحر : سريع 1(@)(@@) % تمت ، وتم الحسن في وجهها ، % فكل شيء ما خلاها محال % 2(@)(@@) % للناس في 
ms150	 الشهر هلال ، ولي % % في وجهها كل صباح هلال % PageV01P720 البحر : منسرح 1(@)(@@) % لا تهجرن الحبيب إن هجر ، % ولا تعاقبه بالذي فعلا % % 2(@)(@@) % إذا بلوناه في الوصال ، فما % % أحسن إلا المطال والعللا % % PageV01P721 البحر : طويل 1(@)(@@) % أقول لها لما أتتني تدلني % % على امرأة موصوفة بجمال % 2(@)(@@) % أصبت لها يا أخت فحلا كما اشتهت ، % إذا أغفلت مني ثلاث خلال % 3(@)(@@) % فمنهن فسق ، لا ينادى وليده ، % ورقة إسلام ، وقلة مال % 4(@)(@@) % ولو أنها في الحسن كانت كيوسف % وبلقيس ، أو كانت كخط مثال % 5(@)(@@) % وقالت : تجوزني على مهر درهم ، % لقلت : إذهب عني فمهرك غال % PageV01P722 البحر : طويل 1(@)(@@) % خلعت مجوني ، فاسترحت من العذل ، % وكنت وما بي ، والتماجن من مثلي % % 2(@)(@@) % أيا ابن أبان هل سمعت بفاسق % يعد من النساك ، فيمن مضى قلبي % % 3(@)(@@) % ألم تر أني حين أغدو مسبحا % بسمت أبي ذر وقلب أبي جهل % 4(@)(@@) % وأخشع في نفسي وأخفض ناظري % % وسجادتي في الوجه كالدرهم المطلي % % 5(@)(@@) % وآمر بالمعروف لا من تقية ، % وكيف وقولي لا يصدقه فعلي % % 6(@)(@@) % ومحبرتي رأس الرياء ، ودفتري ، % ونعلاي في كفي من آلة الختل % 7(@)(@@) % أؤم فقيها ليس رأي بفقهه ، % ولكن لرب المرد مجتمع الشمل % 8(@)(@@) % فكم أمرد قد قال والده له : % عليك بهذا ، إنه من أولي الفضل % 9(@)(@@) % يفر به من أن يصاحب شاطرا ، % كمن فر من حر الجراح إلى القتل % PageV01P723 البحر : مجزوء الكامل 1(@)(@@) % سجد الجمال لحسن وج % هك ، واستراح إلى جمالك % 2(@)(@@) % وتشوقت حور الجنا % % ن من الخلود إلى مثالك % 3(@)(@@) % فعشقت وجهك ، إذ رأي % تك ، واعتمدت على وصالك % 4(@)(@@) % يا ظالمي ليس المح % ب ، وإن تجلد ، من رجالك % PageV01P724 البحر : هزج 1(@)(@@) % وفي الحمام يبدو لك % % و في الحمام يبدو لي % % 2(@)(@@) % فقم مجتليا ، فانظر % بعيني غير مشغول % 3(@)(@@) % ترى ردفا يغطي الظه % ر من أهيف مجدول % 4(@)(@@) % يناجي بعضه بعضا ، % بتكبير وتهليل % 5(@)(@@) % ألا يا حبذا الحما % % م من موضع تفضيل % 6(@)(@@) % وإن نغص بعض الطي % % ب أصحاب المناديل ! % PageV01P725 البحر : منسرح 1(@)(@@) % مالي في الناس كلهم مثل ، % مائي عقار 
ms151	 ، ونقلي القبل % 2(@)(@@) % كذاك حتى إذا العيون غفت ، % وحان نومي فمفرشي كفل % 3(@)(@@) % يا أيها الناس بادروا أجلا ، % فكل نفس وراءها أجل % 4(@)(@@) % ليحمد الله منكم رجلا ، % ساعده في حبيبه الأمل ! % PageV01P726 البحر : منسرح 1(@)(@@) % لم ينسني السعي والطواف ولا ال % % داعون لما ابتهلنا وابتهلوا % % 2(@)(@@) % قضيب بان إن قام ينخزل ، % وإن تول فكله كفل % 3(@)(@@) % ميسان من حيث ما عطفت له ، % حياك وجه بحسنه المثل % 4(@)(@@) % تخال خديه لاحمرارهما % % يفتح الورد فيهما الخجل % 5(@)(@@) % تراه كسلان من تساقطه ، % وما به غير نعمة كسل % 6(@)(@@) % يجل أن نلحق الصفات به ، % فكل حسن لحسنه خول % PageV01P727 البحر : مجتث 1(@)(@@) % يا قابري بدلاله % ودامري بمطاله % 2(@)(@@) % ويا مبدل ليلي % % قصاره بطواله % 3(@)(@@) % أعوذ منك بوجه ، % بدر الدحى في مثاله % 4(@)(@@) % لكنه منك أحلى % % لحسن موضع خاله % 5(@)(@@) % ألا رحمت صريعا ، % تحت الردى وظلاله % 6(@)(@@) % من لا يرى من وثير ال % % فراش غير خياله % 7(@)(@@) % مثل الخلال ، نحيل % يخفى على عذاله % 8(@)(@@) % فمن بغى لك سوءا ، % فكان في مثل حاله % PageV01P728 البحر : مجتث 1(@)(@@) % يا من تمره عمدا % فكان للعين أملا % % 2(@)(@@) % وفي الشعوثة أيضا ، % فكان أحلى وأحلى ! % 3(@)(@@) % أردت أن تزدريك الع % يون ، هيهات ، كلا ! % 4(@)(@@) % كمن أراد بشيء % سماجة فتجلى ؟ ! % 5(@)(@@) % ياعاقد القلب مني ، % هلا تذكرت حلا % 6(@)(@@) % تركت جسمي عليلا ، % من القليل أقل % 7(@)(@@) % يكاد لا يتجزا ، % أقل في اللفظ من لا % % 8(@)(@@) % ولقد ملئت لعيني ، % شحا علي ، وبخلا % 9(@)(@@) % فما تراني لوصل ، % وإن هويتك ، أهلا % % PageV01P729 البحر : هزج 1(@)(@@) % أيا من حمل الذر % ة ما لا يحمل الفيل % 2(@)(@@) % أما تعلم أن المر % ء مبعوث ، ومسؤول % 3(@)(@@) % ومن أنصت للواشي % % ن هزته الأقاويل % 4(@)(@@) % فلو قلت لهم : مهلا ، % كما قلت لهم : قولوا % % 5(@)(@@) % لما كان على عبد % ك لا قال ، ولا قيل % 6(@)(@@) % ولكنك للواشي ، % على الطاعة مخبول % 7(@)(@@) % وقد أسقطني الحق ، % وأعلته الأباطيل % 8(@)(@@) % فموت لي مذخور ، % وموت بي مفعول % 9(@)(@@) % فعللني بوعد من % ك ، تكفيني التعاليل % 10(@)(@@) % فما للأرض مذ صارم 
ms152	 % تني عرض ولا طول % PageV01P730 البحر : مجتث 1(@)(@@) % يا من جداه قليل ، % ومن بلاه طويل % 2(@)(@@) % ومن دعاني إليه ، % طرف أحم كحيل % 3(@)(@@) % وواضح النبت ، يحكي % % مزاجه الزنجبيل % 4(@)(@@) % أو عين تسنيم ، أو شا % % ب طعمه السلسبيل % 5(@)(@@) % ووجنة جائل ما % % ؤها ، وخد أسيل % 6(@)(@@) % وغصن بان تثنى ، % لك الوثيقة مني ، % 7(@)(@@) % يجمع الحسن فيه ، % وجه وسيم ، جميل % 8(@)(@@) % ذاك الذي فيه من صن % % عة الإله قبول % 9(@)(@@) % فكل ما فيه منه ، % قلبي إليه يميل % 10(@)(@@) % ويلي ! فليس يرى لي % % حقا ، وليس ينيل % PageV01P731 11(@)(@@) % ويلي ! وما هكذا ، يا % % ويلي ، يكون الخليل % 12(@)(@@) % لم يخترق كرما بي % ننا بود رسول % 13(@)(@@) % حتى بدا منك ما لم % يطقه قط ملول % 14(@)(@@) % ولا اهتدي باحتيال % إليه قط بخيل % 15(@)(@@) % ولا ترى أن ما قد % % يخفى علي يخيل % 16(@)(@@) % و الطرف منك على غا % % ئب الضمير دليل % 17(@)(@@) % فالله يرعاك ، يا من % % مع الرياح يميل % 18(@)(@@) % % بأنني لا أحول % 19(@)(@@) % عما عهدت ، وربي % % راع علي كفيل % 20(@)(@@) % جفاك يانفس شيء ، % ما إن إليه سبيل % PageV01P732 21(@)(@@) % لأن حبك حب في % % في القلب مني دخيل % 22(@)(@@) % ضمت إلي وثاقي % % أغلاله والكبول % 23(@)(@@) % فالحب فوقي سحاب ، % و الحب تحتي سيول % 24(@)(@@) % فذا يسيخ برجلي ، % وذا علي هطول % 25(@)(@@) % وللصبابة حولي % % مدينة ، وقبيل % 26(@)(@@) % وللحنين ، بقلبي ، % محلة ، ومقيل % 27(@)(@@) % وليس حولي إلا % رياح حب تجول % 28(@)(@@) % والقلب قلب معنى ، % والجسم جسم عليل % 29(@)(@@) % شعاره الهم والحز % ن والضنا والعويل % 30(@)(@@) % ياأهل ودي علاما % % صرمتموني ؟ فقولوا % % PageV01P733 31(@)(@@) % إن كان ذاك لذنب ، % فإنني مستقيل % 32(@)(@@) % ما في يدي منك إلا % منى الغرور تنيل % 33(@)(@@) % بلى ! همومي ثقال ، % دقيقهن جليل % 34(@)(@@) % ولست إلا بوصل % على الصدود أصول % 35(@)(@@) % كان الكثير رجائي ، % ففات مني القليل % 36(@)(@@) % فلا نوال زهيد ، % ولا عطاء جزيل % 37(@)(@@) % والله في كل هذا % % حسبي ، ونعم الوكيل % PageV01P734 البحر : مجزوء الخفيف 1(@)(@@) % قبل أن يستر السوا % % د من الشعر خالكا % % 2(@)(@@) % حينما تكدم الندا % % مة منه شمالكا % % PageV01P735 البحر : منسرح 1(@)(@@) % من 
ms153	 أنا في موقف الحساب ، إذا % % نودي بالأنبياء والرسل % 2(@)(@@) % ذلك يوم يجل عن خطري ، % فما لمثلي هناك من أمل % 3(@)(@@) % هنت على الخالق الجليل ، فما % % ينظر في قصتي ولا عملي % % PageV01P736 البحر : رجز تام 1(@)(@@) % يا أيهذا الملك المؤمل % قد استزرت عصبة ، فأقبلوا % % 2(@)(@@) % وعصبة لم تستزرهم طفلوا % % رجوك في تطفيلهم ، وأملوا % % 3(@)(@@) % وللرجاء حرمة لا تجهل ! % % PageV01P737 البحر : رجز تام 1(@)(@@) % يا واصف الغلمان في شعره % % أنت وربي منهم الأول % 2(@)(@@) % وصفت خمسين ، فميزتهم ، % وأنت أنت الظبية المغزل % 3(@)(@@) % عنا ودعهم عنك أو وصفهم ، % أنت وربي منهم أجمل % 4(@)(@@) % يا وزة تنقص أنفالها ، % وقد تلاها اللحم الأحفل % 5(@)(@@) % قد قلت ، والعقبة لا تنقضي ، % ارفق حبيبي ، أنت مستعجل % PageV01P738 البحر : كامل تام 1(@)(@@) % حي الديار وأهلها أهلا ، % واربع ، وقل لمفند مهلا % % 2(@)(@@) % حب المدامة ، مذ لهجت بها ، % لم يبق لي في غيرها فضلا % % 3(@)(@@) % إني ندبت لحاجتي رجلا % صافي السماحة واحتوى النبلا % % 4(@)(@@) % وسمت به الهمم العظام إلى ال % % رتب الجسام ، فباين المثلا % % 5(@)(@@) % تلقلى الندى في غيره عرضا ، % وتراه فيه طبيعة أصلا % % 6(@)(@@) % فاسبق ، أيا عبد الإله ، بها ، % واجعل لعقبك ذخرها نجلا % % 7(@)(@@) % كلم أخاك يكلم الفضلا ، % وليبلني حسنا كما أبلى % % 8(@)(@@) % إني وصلت بك الرجاء على % % بعد المدى ، إذ كنت لي أهلا % % 9(@)(@@) % وإذا وصلت بعاقل أملا % كانت نتيجة قولك الفعلا ! % PageV01P739 البحر : بسيط تام 1(@)(@@) % قدر الرقاشي مضروب بها المثل ، % في كل شيء خلا النيران تبتذل % 2(@)(@@) % تشكو إلى قدر جارات ، إذا التقتا : % اليوم لي سنة ما مسني بلل % PageV01P740 البحر : مجزوء الرمل 1(@)(@@) % هل عرفت الربع أجلى % % أهله عنه ، فزالا % % 2(@)(@@) % بشرورى قد عفا ، أو % % صار آلا أو خيالا % % 3(@)(@@) % جرت الريح عليه % % ن جنوبا ، وشمالا % 4(@)(@@) % رب ريم كان فيها % % يملأ العين جمالا % % 5(@)(@@) % ولقد تقنصك الحو % % ر بها العين الغزالا % % 6(@)(@@) % في ظباء يتزاور % نا ، فيمشين ثقالا % % 7(@)(@@) % قد تبدلنا فروعا % بصياصيها طوالا % % 8(@)(@@) % كم شفين العين منه % % ن رميقا ، واكتحالا % % 9(@)(@@) % وفلاة ألبستها % % ظلمة الليل جلالا % % 10(@)(@@) % قد 
ms154	 تبطنت بحرف ، % تقدم العيس العجالا % % PageV01P741 11(@)(@@) % تفعم الغبط بأخرا % % ها ، وتستوفي الحبالا % % 12(@)(@@) % ذات لوث شدقمي ، % يسبق الطرف نقالا % % 13(@)(@@) % وهي في ذاك من إبرا % % هيم تستشفئ خالا % % 14(@)(@@) % خير من حط به الرك % ب المخبون الرحالا % % 15(@)(@@) % مال إبراهيم بالما % % ل يمينا وشمالا % % 16(@)(@@) % فإذا عد جواد % معه كان محالا % % 17(@)(@@) % ليت أعدائي كانوا % % لأبي إسحاق مالا % % 18(@)(@@) % جاد حتى حصد الفا % % قة ، واجتث السؤالا % % 19(@)(@@) % لم يقل أفعل ، إلا % أتبع القول الفعالا % % 20(@)(@@) % أجود الناس ولو أص % بح أسوء الناس حالا % % PageV01P742 21(@)(@@) % يا أبا إسحاق لو أن % صفت منك المال قال : % 22(@)(@@) % ما لرجل المال أمست % تشتكي منك الكلالا % % 23(@)(@@) % ما لأموالك من شا % % ء اجتنى منها ، وكالا % % 24(@)(@@) % أترى لاء حراما ، % وترى هاء حلالا % % 25(@)(@@) % يا فتى يرغم بالجو % % د رجالا ورجالا % % 26(@)(@@) % كلما قيس بك الأ ق % وام لم يسووا قبالا % % PageV01P743 البحر : وافر تام 1(@)(@@) % أما يفنى حديثك عن جنان ، % ولا تبقي على هذا اللسان ؟ ! % 2(@)(@@) % أكل الدهر : قلت لها وقالت ؟ % فكم هذا ! أما هذا بفان ؟ ! % 3(@)(@@) % جعلت الناس كلهم سواء ، % إذا حدث عنهم في البيان % 4(@)(@@) % عدوك كالصديق ، وذا كهذا % % سواء ، والأباعد كالأداني % % 5(@)(@@) % إذا حدث عن شيء ، فولت % عجائبه ، أتيتهم بثان % % 6(@)(@@) % فلو عميت عنها باسم أخرى ، % - علمنا كلنا من أنت عان % PageV01P744 البحر : مجزوء الكامل 1(@)(@@) % لولا حذاري من جنان % لخلعت عن رأسي عنان % 2(@)(@@) % وركبت ما أهوى ، وكم % أجفو مقالة من نهاني % % 3(@)(@@) % وخرجت أخبط سادرا ، % لم أغن عن حب الغواني % % 4(@)(@@) % قد ذبت ، غير حشاشة % في النفس تحبسها الأماني % % 5(@)(@@) % يا من يلوم على الصبا ! % دعني ، فشأنك غير شاني % % 6(@)(@@) % لم تلق من حرق الهوى ، % ما قد لقيت على عنان % 7(@)(@@) % أنى ترد علي قل % با راح في غلق الرهان % 8(@)(@@) % قلبا ، إذا كلفته % غير الذي يهوى عصاني % % 9(@)(@@) % قد خضت في لجج الهوى ، % وشربت صافية الدنان % 10(@)(@@) % ومضمخات بالعبي % % ر نزلن من غرف الجنان % PageV01P745 11(@)(@@) % راضعتهن من الصبا % % كأسا عقدن بها 
ms155	 لساني % % 12(@)(@@) % أقبلن من باب الرصا % % فة كالتماثيل . . . . . . . . . . . % 13(@)(@@) % يحففن أحور كالغزا % % ل أمر إمرار العنان % 14(@)(@@) % يمشي بردف كالنقا ، % يختال تحت قضيب بان % 15(@)(@@) % فإذا انجليت ، فجاملي ، % كيلا أموت على المكان % 16(@)(@@) % ولقد أقول لمن دعا % % ه من الهوى ما قد دعاني : % 17(@)(@@) % أبلغ هواك من الغنا ، % والكأس ، واغن عن الزمان % 18(@)(@@) % لا يشغلنك غير ما % % تهوى ، فكل العيش فان % 19(@)(@@) % ودع الهوان لأهله ، % إذا زلت عن دار الهوان % PageV01P746 البحر : وافر تام 1(@)(@@) % هجوت الفضل دهري وهو عندي % % رقاشي ، كما زعم المسول % 2(@)(@@) % فلما سوئلت عنه رقاش ، % لنعلم ما تقول وما يقول % 3(@)(@@) % ولما أن نصصناه إليها % % لتعلم ما يقال وما نقول % 4(@)(@@) % وجدنا الفضل أكرم من رقاش ، % لأن الفضل مولاه الرسول % PageV01P747 البحر : طويل 1(@)(@@) % ودهماء ترسها رقاش ، إذاشتت ، % مركبة الآذان أم عيال % 2(@)(@@) % يغص بحيزون جرادة صدرها ، % وينضج ما فيها اتقاد ذبال % 3(@)(@@) % وتغل بذكر النار من غير حرها ، % وينزلها الطاهي بغير جعال % 4(@)(@@) % ولو جئتها ملأى عبيطا مجزلا ، % لأخرجت ما فيها بعود خلال % 5(@)(@@) % هي القدر قدر الشيخ بكر ين وائل % ربيع اليتامى عام كل هزال % PageV01P748 البحر : طويل 1(@)(@@) % على خبز إسماعيل واقية البخل ، % فقد حل في دار الأمان من الأكل % 2(@)(@@) % وما خبزه إلا كآوى يرى ابنه ، % ولم ير آوى في حزون ولا سهل % 3(@)(@@) % وما خبزه إلا كعنقاء مثغرب ، % تصور في بسط الملوك وفي المثل % 4(@)(@@) % يحدث عنها الناس من غير رؤية ، % سولا صورة ما إن تمر ولا تحلي % % 5(@)(@@) % وما خبزه إلا كليب ين وائل ، % ومن كان يحمي عزه منبت البقل % 6(@)(@@) % وإذ هو لا يستب خصمان عنده ، % ولا الصوت مرفوع بجد ولا هزل % 7(@)(@@) % فإن خبز إسماعيل حل به الذي % % أصاب كليبا لم يكن ذاك من ذل % 8(@)(@@) % ولكن قضاء ليس يسطاع رده % بحيلة ذي مكر ، ولا فكر ذي عقل % PageV01P749 البحر : طويل 1(@)(@@) % لعمرك ما العباس من ولد الفضل ، % فيرجى لفضل أو يعين على بذل % 2(@)(@@) % فتى كلما ناديته لملمة ، % دعوت مثالا لا 
ms156	 يمر ولا يحلي % % 3(@)(@@) % وكيف يرجى الفضل ممن خلافه % % تراث لفضل ، والربيع أبو الفضل % PageV01P750 البحر : مجزوء الرمل 1(@)(@@) % أكثري ، أو فأقلي ، % قد مللناك فمل % 2(@)(@@) % ما إلى حبك عود ، % ما دعا الله مصلي % % 3(@)(@@) % قد وهبناك لعمري % % وتصدقنا بحمل % 4(@)(@@) % لم يكن مثلك لولا % % سفه الرأي هوى لي % % 5(@)(@@) % أيها السائل عنها % % إسمع اللفظ المحلي % % 6(@)(@@) % شخصها شخص قبيح ، % ولها وجه مولي % % 7(@)(@@) % وخفت عن كل عين ، % وخفت عن كل دل % 8(@)(@@) % ولها ثغر كأن ا % % الله غشاه بكحل % 9(@)(@@) % تصف النكهة منها % % جيفة في يوم طل % 10(@)(@@) % وتفلي حين تلقا % % ك لتحظى بالتفلي % % PageV01P751 11(@)(@@) % ردفها طست ، ولكن % % بطنها زكرة خل % 12(@)(@@) % اشهدوا إني بريء % من هواها ، متخلي % % PageV01P752 البحر : منسرح 1(@)(@@) % خاف من الأرض أن تميد به % فأوسع الناس كلهم ثقلا % % 2(@)(@@) % أشرق بالكأس ، حين أنظره ، % ولو شربت الزلال والعسلا % % PageV01P753 البحر : مجتث 1(@)(@@) % أيا سعيد بن وهب % إسمع فديتك قيلي % % 2(@)(@@) % إني هويت غزالا % مساعدا لي بسولي % % 3(@)(@@) % إذا أتاه رسولي ، % فلا يرد رسولي % % PageV01P754 البحر : بسيط تام 1(@)(@@) % أضمرت للنيل هجرانا ومقلية % مذ قيل لي إنما التمساح في النيل % 2(@)(@@) % فمن رأى النيل رأي العين من كثب ، % فما أرى النيل إلا في البواقيل % PageV01P755 البحر : مجزوء الرمل 1(@)(@@) % قلت يوما للرقاشي ، % وقد سب الموالي : % 2(@)(@@) % ما الذي نحاك عن أص % لك من عم وخال % 3(@)(@@) % قال لي : قد كنت مولى ، % زمنا ثم بدا لي % % 4(@)(@@) % أنا بالبصرة مولى ، % عربي بالجبال % 5(@)(@@) % أنا حقا أدعيهم ، % لسوادي وهزالي % % PageV01P756 البحر : مجزوء الوافر 1(@)(@@) % سهوت ، وغرني أملي ، % وقد قصرت في عملي % % 2(@)(@@) % ومنزلة خلقت لها % % جعلت لغيرها شغلي % % PageV01P757 البحر : منسرح 1(@)(@@) % % ومن مسيء يكفيكه عمله % 2(@)(@@) % والمرء ما عاش عامل نصب ، % لا ينقضي حرصه ولا أمله % 3(@)(@@) % يرجو أمورا عنه مغيبة ، % جهلا ، ومن دون ما رجا أجله % PageV01P758 البحر : رجز تام 1(@)(@@) % قد طالما أفلت يا ثعالا ، % وطالما وطالما وطالا ! % 2(@)(@@) % جلت بكلبي يومك الأجوالا ، % ماطلت من لا يسأم المطالا % % 3(@)(@@) % حتى إذا اليوم حدا الآصالا 
ms157	 ، % أتاك حين يقدم الآجالا % % PageV01P759 البحر : رجز تام 1(@)(@@) % لما بدا الثعلب في سفح الجبل % صحت بكلبي : ها ! . . . فهاج كالبطل % 2(@)(@@) % كلب جريء القلب محمود العمل % مؤدب كل الخصال قد كمل % 3(@)(@@) % فجاذب المقود كفي ، وحمل ، % وطرد الثعلب طردا ما بطل % 4(@)(@@) % ومر كالصقر على الصيد اشتمل ، % فلفه لفا سريعا ما قتل % 5(@)(@@) % يا لك من كلب إذا صاد عدل % % PageV01P760 البحر : رجز تام 1(@)(@@) % يا رب ظبي بمكان خال ، % صبحته ، والليل ذو أهوال % 2(@)(@@) % بأغضف غذي بحسن حال ، % مسود العم ، حسيب الخال % 3(@)(@@) % أعطي تمام القد والجمال ، % قلدته قلادة الأعمال % 4(@)(@@) % يجول في المقود كالمختال ، % هجنا به فهاج للنزال ! % 5(@)(@@) % وانس الظبي بتل عال ، % فانسل قلبي ساعة الإرسال % 6(@)(@@) % ومر يتلوه ، ولم يبال ، % بالحزن والسهل وبالرمال % 7(@)(@@) % فصاده في أصعب الجبال ، % وقائل لي وهو عن حيالي : % 8(@)(@@) % أكرم بهذا الكلب من محتال ! % أتيح حتف الظبي والأوعال % PageV01P761 البحر : مجتث 1(@)(@@) % يا من جفاني ، وملا ، % نسيت أهلا ، وسهلا % % 2(@)(@@) % ومات مرحب لما % % رأيت مالي قلا % 3(@)(@@) % إني أظنك تحكي ، % فيما فعلت ، القرلى % % 4(@)(@@) % تلقاه في الشر ينأى ، % وفي الرخا يتدلى % % PageV01P762 البحر : طويل 1(@)(@@) % تقول لي الركبان ما لك راجلا ، % وكنت ركوبا عصر نحن رجال % 2(@)(@@) % فقلت عداني عن ركوب وملبس ، % ذوو رحم آثرتهم وعيال % 3(@)(@@) % فمن يك يغلا أو حمارا ركوبه ، % فإن ركوبي نعلة وقبال % PageV01P763 البحر : خفيف تام 1(@)(@@) % سابق الناس هاشم ين حديج ، % يوم موسى بن مصعب المقتول % 2(@)(@@) % جاء في حلبة الفرار أمام ال % % قوم ، فلا للعسكر المفلول % PageV01P764 البحر : طويل 1(@)(@@) % لقد نام عما قد عناك أبو الفضل ، % وليس له من موقظ لك ككالفضل % 2(@)(@@) % فقل لأبي العباس مبتدثا له : % وقاك الردى مالي ، ونفسي مع الأهل % 3(@)(@@) % أجدك لم تسمع ببيت مهزة % لدى المطل ، يا ذخري ، فتصحو من المطل % 4(@)(@@) % متى ما أقل يوما لطالب حاجة % نعم ! أقضها حتما ، وذلك من شكلي % % 5(@)(@@) % فإن قلت قد قصرت فيها ، وليس من % بغى حاجة إلا كما قال ذو الفضل % 6(@)(@@) % فما طالب الحاجات 
ms158	 ممن يرومها % % من الناس إلا المصبحون على رحل % 7(@)(@@) % فقد كان مني ذاك فيها تعمدا ، % لما قال في الأمثال جرول من قبلي ' % 8(@)(@@) % تأن مواعيد الكرام ؛ فربما % % حملت من الإلحاح سمحا على البخل % PageV01P765 البحر : بسيط تام 1(@)(@@) % قالوا امتدحت ، فماذا اعتضت ؟ قلت لهم % % خرق النعال ، وإبلاء السراويل % % 2(@)(@@) % قالوا فسم لنا هذا ! فقلت لهم : % وصفي له يعدل التصريح في القيل % 3(@)(@@) % ذاك الأمير الذي طالت علاوته ، % كأنه ناظر في السيف في الطول % PageV01P766 البحر : وافر تام 1(@)(@@) % أعاذل ما على وجهي قتوم ، % و لا عرضي لأول من يسوم % 2(@)(@@) % يفضلني على الفتيان إني % % أبيت فلا ألام ، ولا أليم % 3(@)(@@) % أعاذل إن يكن برداي رثا ، % فلا يعدمك بينهما كريم % 4(@)(@@) % شققت من الصبا ، واشتق مني % % كما اشتقت من الكرم الكروم % 5(@)(@@) % فلست أسوف اللذات نفسي ، % مياومة كما دفع الغريم % 6(@)(@@) % ولا بمدافع بالكأس حتى % % يهيجني على الطرب النديم % 7(@)(@@) % ومتصل بأسباب المعالي ، % له في كل مكرمة قديم % 8(@)(@@) % رفعت له النداء : بقم ، فخذها ، % وقد أخذت مطالعها النجوم % 9(@)(@@) % بتفدية تذال النفس فيها ، % وتمتهن الخؤولة والعموم % 10(@)(@@) % فقام ، وقمت من أخوين هاجا ، % على طرب ، وليلهما بهيم % PageV01P767 11(@)(@@) % أجر الزق ، وهو يجر رجلا ، % يجور بها النعاس ، ويستقيم % 12(@)(@@) % سل الندمان ما أولته منها ، % وسلها ما احتوى منها الكريم % 13(@)(@@) % كلا الشخصين منتصف ، ولكن % قضت وطرا ، وذا منها سقيم % PageV01P768 البحر : مديد تام 1(@)(@@) % يا شقيق النفس من حكم % نمت عن ليلي ، ولم أنم % 2(@)(@@) % فاسقيني الخمر التي اختمرت % بخمار الشيب في الرحم % 3(@)(@@) % ثمت انصات الشباب لها % % بعد ما جازت مدى الهرم % 4(@)(@@) % فهي لليوم الذي بزلت % وهي ترب الدهر في القدم % 5(@)(@@) % عتقت حتى لو اتصلت % بلسان ناطق ، وفم % 6(@)(@@) % لاحتبت في القوم ماثلة % ثم قصت قصة الأمم % 7(@)(@@) % قرعتها بالمزاج يد % خلقت للكأس والقلم % 8(@)(@@) % في ندامى سادة نجب % أخذوا اللذات من أمم % 9(@)(@@) % فتمشت في مفاصلهم % كتمشي البرء في السقم % 10(@)(@@) % فعلت في البيت إذا مزجت % مثل فعل الصبح في الظلم % PageV01P769 11 
ms159	(@)(@@) % فاهتدى ساري الظلام بها % % كاهتداء السفر بالعلم % PageV01P770 البحر : كامل تام 1(@)(@@) % صفة الطلول بلاغة القدم ، % فاجعل صفاتك لابنة الكرم % 2(@)(@@) % لا تخدعن عن التي جعلت % سقم الصحيح ، وصحة السقم % 3(@)(@@) % وصديقة الروح التي حجبت % عن ناظريك ، وقيم الجسم % 4(@)(@@) % لا كرمها مما يذال ، ولا % % فتلت مرائرها على عجم % 5(@)(@@) % صهباء فضلها الملوك على % % نظرائها بفضيلة القدم % 6(@)(@@) % فإذا أطفن بها صمتن لها ، % صمت البنات مهابة الأم % 7(@)(@@) % وإذا هتفنا بها لنازلة ، % قدمنا كنيتها على الاسم % 8(@)(@@) % وإذا أردنا لها محاورة % روحن ما عزبن من حلم % 9(@)(@@) % شجت ؛ فعالت فوقها حببا ، % متراصفا كتراصف النظم % 10(@)(@@) % ثم انفرت لك عن مدب دبا % عجلان ، صعدا في ذرا أكم % PageV01P771 11(@)(@@) % فكأنما يتلو طرائدها ، % نجم تواتر في قفى نجم % 12(@)(@@) % وكأن عقبى طعمها صبر ، % وعلى البديهة ، مزة الطعم % 13(@)(@@) % ترمي فتقصد من له قصدت ، % جم المراح ، دريرة السهم % 14(@)(@@) % فعلام تذهل عن مشعشعة ، % وتهيم في طلل ، وفي رسم % 15(@)(@@) % تصف الطلول على السماع بها ، % أفذو العيان كأنت في العلم % 16(@)(@@) % وإذا وصفت الشيء متبعا ، % لم تخل من زلل ، ومن وهم % PageV01P772 البحر : - 1(@)(@@) % اسقنا ، إن يومنا يوم رام ئن % % ولرام فضل على الأيام % 2(@)(@@) % من شراب ألذ من نظر المع % % شوق في وجه عاشق بابتسام % 3(@)(@@) % لا غليظ تنبو الطبيعة عنه % نبوة السمع عن شنيع الكلام % 4(@)(@@) % بنت عشر صفت ، ورقت ، فلو صب % ت على الليل راح كل ظلام % 5(@)(@@) % في رياض ربعية ، بكر النو % ء عليها بمستهل الغمام % 6(@)(@@) % فتوشت بكل نور أنيق ، % من فرادى نباته ، وتؤام % 7(@)(@@) % فترى الشرب كالأهلة فيها ، % يتحسون خسروي المدام % 8(@)(@@) % ولهم من جناه آذريون ، % وضعوه مواضع الأقلام % PageV01P773 البحر : مجزوء الرمل 1(@)(@@) % اسقني يا ابن أدهما % % واتخذني لك ابنما % % 2(@)(@@) % اسقنيها سلافة % سبقت خلق آدما % % 3(@)(@@) % فهي كانت ، ولم يكن % ما خلا الأرض والسما % % 4(@)(@@) % رأت الدهر ناشئا ، % وكبيرا مهزما % % 5(@)(@@) % فهي روح مخلص ، % فارق اللحم والدما % % 6(@)(@@) % اسقنيها ، وغن صو % تا ، لك الخير ، أعجما % % 7(@)(@@) % ليس في نعت دمنة 
ms160	 ، % لا ولا زجر أشأما % % PageV01P774 البحر : مجزوء الكامل 1(@)(@@) % هلا استعنت على الهموم % صفراء ، من حلب الكروم % 2(@)(@@) % ووهبت للعيش الحمي % % د ، بقية العيش الذميم % 3(@)(@@) % بمجالس فيها المزا % % هر ، والأوانس كالنجوم % 4(@)(@@) % بدء التحية بينهم ، % نظر النديم إلى النديم % PageV01P775 البحر : طويل 1(@)(@@) % ألا لا أرى مثلي امترى اليوم في رسم ، % تغص به عيني ، ويلفظه وهمي % % 2(@)(@@) % أتت صور الأشياء بيني وبينه ، % فجهلي كلا جهل ، وعلمي كلا علم % 3(@)(@@) % فطب بحديث عن نديم مساعد ، % وساقية سن المراهق للحلم % 4(@)(@@) % إذا هي قامت والسداسي طالها ، % وبين النحيف الجسم ، والحسن الجسم % 5(@)(@@) % ضعيفة كر الطرف ، تحسب أنها % % حديثة عهد بالإفاقة من سقم % 6(@)(@@) % تفوق مالي من طريف وتالد ، % تفوقي الصهباء من حلب الكرم % 7(@)(@@) % وإني لآتي الوصل من حيث يتقى ، % ويعلم سهمي حين أنزع من أرمي % % PageV01P776 البحر : طويل 1(@)(@@) % أديرا علي الكأس ينقشع الغم ، % ولا تحبسا كأسي ، ففي حبسها إثم % 2(@)(@@) % ولا تسقياني بنت عشر ، فإنها % % كما عصرت لم ينس فرقتها الكرم % 3(@)(@@) % ولكن عجوزا ، بنت كسرى ، قديمة % معتقة قد دب في طيها الحلم % 4(@)(@@) % إذا ذاقها شرابها بجلوا لها % % بألسنهم شكرا ، فهم عرب ، عجم % 5(@)(@@) % وكأسان قد دارا علي ، مؤمر % ومنتخب ، هذا فصيل ، وذا قرم % 6(@)(@@) % كأني ، وقد علقت كفي منهما ، % وما فيهما من حربة ، للفتى سلم % 7(@)(@@) % مؤلف شاهين بيسرى بنانه ، % وفي كفه اليمنى لشاهينه طعم % 8(@)(@@) % يديرهما دعجاء روض ، وأدعج ، % أخ وأخته في القوم ، واسمهما اسم % 9(@)(@@) % يقال له معن ، فإما نكسته ، % لتدعو اخته يوما ، فمنكوسه نعم % PageV01P777 البحر : طويل 1(@)(@@) % إذا خطرت فيك الهموم ، فداوها % % بكأسك حتى لا تكون هموم % 2(@)(@@) % أدرها ، وخذها قهوة بابلية ، % لها بين بصرى و العراق كروم % 3(@)(@@) % وما عرفت نارا ، ولا قدر طابخ % سوى حر شمس إذ تهيج سموم % 4(@)(@@) % لها من ذكي المسك ريح ذكية ، % ومن طيب ريح الزعفران نسيم % 5(@)(@@) % فشمرت أثوابي ، وهرولت مسرعا % وقلبي من شوق يكاد يهيم % 6(@)(@@) % وقلت لملاحي : ألا هي زورقي ، % وبت يغنيني أخ ونديم % 7(@)(@@) % إلى بيت خمار 