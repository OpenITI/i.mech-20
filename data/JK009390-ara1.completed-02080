ms2067	 من أن يسأله العافية ) )(@)(@@) ( ش ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19193 ) قال النبي :(@)(@@) | 30 ( ما ساء عمل قوم قط إلا زخرفوا مساجدهم ) )(@)(@@) ( د ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19194 ) قال النبي & : ' ما سألتهما يعني أبويه ربي فيطيعني فيهما ، وإني لقائم يومئذ المقام المحمود ، ثم ينزل الله فيه على كرسيه يئط به كما يئط به الرجل من تضايقه لسعة ما بين السماء والأرض ، ويجاء بكم عراة حفاة غرلا ، فيكون أول من يكسى إبراهيم ، يقول الله : اكسوا خليلي فيؤتى بريطيتن بيضاوين من رياط الجنة فيلبسهما ثم يقعد مستقبل العرش ، ثم أكسى على أثره فأقوم عن يمين الله مقاما لا يقومه غيري ، يغبطني فيه الأولون والآخرون ، ويشق لي نهر من PageV06P343 الكوثر إلى حوضي يجري في حال من المسك ، ورضراض نباته قضبان الذهب ، ثمارها اللؤلؤ والجوهر ، شرابه أشد بياضا من اللبن ، وأحلى من العسل ، من سقاه الله منه شربة لم يظمأ بعدها ، ومن حرمه لم يرو بعدها ' ( حم ) وابن جرير ( ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19195 ) قال النبي :(@)(@@) | 30 ( ما سافر رجل في أرض تنوفة ، فقال تحت شجرة ومعه راحلته عليها زاده وطعامه فاستيقظ وقد أفلت راحلته ، فعلا شرفا فلم ير شيئا ، ثم علا شرفا فلم ير شيئا ، فالتفت فإذا هو بها تجر خطامها ، فما هو أشد فرحا بها من الله بتوبة عبده إذا تاب إليه ) )(@)(@@) ( ك ) عن النعمان بن بشير ( ك ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19196 ) قال النبي :(@)(@@) | 30 ( ما سأل سائل ولا استعاذ مستعيذ بمثلهما يعني المعوذتين ) )(@)(@@) ( ش ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19197 ) قال النبي :(@)(@@) | 30 ( ما ستر الله عز وجل على عبد في الدنيا إلا ستر عليه في الآخرة ) )(@)(@@) ابن النجار عن علقمة المزني عن أبيه .(@)(@@)(@@)(@@) $ ( 19198 ) قال النبي :(@)(@@) | 30 ( ما سخط الله عز وجل على أمة إلا غلا سعرها ، وأكسد أسواقها ، وأكثر فسادها ، واشتد جور سلطانها ، فعند ذالك لا يزكي أغنياؤها ، ولا يعف سلطانها ، ولا يصلي فقراؤها ) )(@)(@@) ابن النجار عن ابن عباس رضي 
ms2068	 الله عنهما .(@)(@@)(@@)(@@) $ ( 19199 ) قال النبي :(@)(@@) | 30 ( ما سلط على ابن آدم إلا من خافه ابن آدم ، ولو أن ابن آدم لم يخف إلا الله ما سلط الله عليه غيره ، ولا وكل ابن آدم إلا من رجاه ، PageV06P344 ولو أن ابن آدم لم يرج إلا الله ما وكله الله إلى غيره ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19200 ) قال النبي :(@)(@@) | 30 ( ما سكن حب الدنيا قلب عبد إلا ابتلاه الله بخصال ثلاث : بأمل لا يبلغ منتهاه ، وفقر لا يدرك غناه ، وشغل لا ينفك عناه ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19201 ) قال النبي :(@)(@@) | 30 ( ما سؤالك عنه ؟ إنك لا تدركه أما إنه لا يخرج حتى لا يقسم ميراث ، ولا يفرح بغنيمة يعني الدجال ) )(@)(@@) ( طب ) عن المغيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19202 ) قال النبي :(@)(@@) | 30 ( ما شهد رجل على رجل بكفر إلا باء بها أحدهما : إن كان كافرا فهو كما قال ، وإن لم يكن كافرا فقد كفر بتكفيره إياه ) )(@)(@@) الخرائطي في مساوىء الأخلاق والديلمي وابن النجار عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19203 ) قال النبي :(@)(@@) | 30 ( ما شبه عليكم منه يعني الدجال فإن الله تعالى ليس بأعور ، يخرج فيكون في الأرض أربعين صباحا يرد منها كل منهل إلا الكعبة وبيت المقدس ، والمدينة ، الشهر كالجمعة ، والجمعة كاليوم ، ومعه جنة ونار ، فناره جنة ، وجنته نار ، معه جبل من خبز ، ونهر من ماء ، يدعو برجل لا يسلطه الله إلا عليه ، فيقول : ما تقول في ؟ فيقول : أنت عدو الله وأنت الدجال الكذاب ، فيدعو بمنشار فيضعه حذو رأسه فيشقه حتى يقع على الأرض ، ثم يحييه فيقول له : ما تقول في ؟ فيقول : والله ما كنت أشد بصيرة مني فيك الآن أنت عدو الله الدجال الذي أخبرنا عنك رسول الله فيهوي إليه بسيفه فلا يستطيعه فيقول : أخروه عني ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19204 ) قال النبي :(@)(@@) | 30 ( ما شهدت حلفا إلا حلف قريش من حلف PageV06P345 المطيبين ، وما أحب أن لي به حمر النعم ، أني كنت نقضته ) )(@)(@@) ( هق 
ms2069	 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19205 ) قال النبي :(@)(@@) | 30 ( ما شهد رجل على رجل بالكفر إلا باء به أحدهما ، إن كان كافرا فهوع كما قال ، وإن لم يكن كافرا فقد كفر بتكفيره إياه ) )(@)(@@) النقاش في القضاة عن أبي سعيد وفيه مندل بن علي ضعيف .(@)(@@)(@@)(@@) $ ( 19206 ) قال النبي :(@)(@@) | 30 ( ما شيء أكرم على الله من ابن آدم ، قيل : يا رسول الله ولا الملائكة ، قال : الملائكة مجبورون بمنزلة الشمس والقمر ) )(@)(@@) ( هب ) وضعفه عن ابن عمرو رضي الله عنه وقال : الصحيح وقفه عليه .(@)(@@)(@@)(@@) $ ( 19207 ) قال النبي :(@)(@@) | 30 ( ما صامتا ، وكيف صام من يأكل لحوم الناس ) )(@)(@@) ( ط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19208 ) قال النبي :(@)(@@) | 30 ( ما صبر معي يوم أحد غير طلحة ، لقد كان يقيني النبل بكفيه ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19209 ) قال النبي :(@)(@@) | 30 ( ما صدقة أفضل من أن أتصدق على مملوك عند مليك سوء ) )(@)(@@) ( عق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19210 ) قال النبي :(@)(@@) | 30 ( ما صلى ثلاثة صفوف من المسلمين على رجل مسلم يستغفرون له إلا غفر له ) )(@)(@@) ( هق ) عن مالك بن هبير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19211 ) قال النبي :(@)(@@) | 30 ( ما صلى رجل العتمة في جماعة ، ثم صلى بعدها ما بدا له ، ثم أوتر قبل أن يربو ، إلا كانت تلك الليلة كأنه لقي ليلة القدر في الإجابة ) )(@)(@@) عبد بن حميد وابن زنجويه ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19212 ) قال النبي :(@)(@@) | 30 ( ما صلى صلاتكم هاذه أمة قط قبلكم ، وما زلتم في صلاة بعد ، إن النجوم أمان السماء فإذا طمست النجوم أتى أهل السماء ما PageV06P346 يوعدون ، وإني أمان لأصحابي فإذا ذهبت أتى أصحابي ما يوعدون ، وأصحابي أمان لأمتي فإذا ذهب أصحابي أتى أمتي ما يوعدون ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19213 ) قال النبي :(@)(@@) | 30 ( ما صلى علي عبد من أمتي صلاة صادقا بها في قلب نفسه إلا صلى الله عليه بها عشر صلوات وكتب له بها عشر حسنات ، ورفع له بها عشر درجات ومحا عنه 
ms2070	 بها عشر سيئات ) )(@)(@@) ( طب ) عن أبي بردة بن نيار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19214 ) قال النبي :(@)(@@) | 30 ( ما صمت ولا أفطرت ) )(@)(@@) ابن المبارك عن أبي سلمة بن عبد الرحمان بن عوف رضي الله عنه أن رجلا قال : يا رسول الله ما أفطرت منذ أربع سنين قال : فذكره ، قال أبو سلمة : لأنه تحدث به .(@)(@@)(@@)(@@) $ ( 19215 ) قال النبي :(@)(@@) | 30 ( ما صيد صيد ، ولا قطعت شجرة إلا بتضييع من التسبيح ، وكل شيء من الخلق يسبح حتى يتغير عن الخلقة التي خلقها الله ، وإن كنتم تسمعون نقض جدركم فإنما هو تسبيح ) )(@)(@@) أبو نعيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19216 ) قال النبي :(@)(@@) | 30 ( ما صيد صيد ، ولا عضدت عضاة ، ولا قطعت وشيجة إلا بقلة التسبيح ) )(@)(@@) ابن راهويه عن أبي بكر رضي الله عنه وسنده ضعيف جدا .(@)(@@)(@@)(@@) $ ( 19217 ) قال النبي :(@)(@@) | 30 ( ما ضر عثمان ما عمل بعد هاذا اليوم ) )(@)(@@) ( حم ك حل ) عن عمران بن حصين ، ( حم ) عن عبد الرحمن بن خباب السلمي رضي الله عنه .(@)(@@) PageV06P347(@)(@@)(@@)(@@) $ ( 19218 ) قال النبي :(@)(@@) | 30 ( ما ضر صاحب هاذه لو تصدق بأطيب من هاذا ، إن صاحب هاذه ليأكل الحشف يوم القيامة ، والله ليدعنها مذللة أربعين عاما للعوافي ، أتدرون ما العوافي ؟ الطير والسباع ) )(@)(@@) ( هق ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19219 ) قال النبي :(@)(@@) | 30 ( ما ضر عثمان ما عمل بعد هاذا أبدا ) )(@)(@@) أبو نعيم في فضائل الصحابة عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19220 ) قال النبي :(@)(@@) | 30 ( ما ظن محمد بربه لو لقي الله وهاذه الدنانير عنده ) )(@)(@@) ( حم وهناد كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19221 ) قال النبي :(@)(@@) | 30 ( ما عبد الله تعالى بشيء أحب إليه من حسن الظن به ) )(@)(@@) أبو نعيم عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19222 ) قال النبي :(@)(@@) | 30 ( ما عدل وال اتجر في رعيته ) )(@)(@@) ابن منيع والحاكم في الكنى ا ( طب ) وأبو سعيد النقاش في القضاة عن أبي الأسود المالكي عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 19223 ) قال النبي :(@)(@@) | 30 ( ما عرضت الإسلام على أحد إلا كانت له نظرة غير 
ms2071	 أبي بكر ، فإنه لم يتلعثم ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19224 ) قال النبي :(@)(@@) | 30 ( ما على وجه الأرض قوم يعرفون الله غيركم ، فأين الزاهدون في الدنيا ، الراغبون في الآخرة ) )(@)(@@) ( كر ) عن ابن مسعود قال : خرج علينا رسول الله يوم بدر من قبة حمراء فقال : فذكره .(@)(@@)(@@)(@@) $ ( 19225 ) قال النبي :(@)(@@) | 30 ( ما على الأرض من مسلم يتوضأ فيسبغ الوضوء لصلاة مفروضة إلا غفر له في ذالك اليوم : ما مشت إليه رجلاه ، أو قبضت عليه PageV06P348 يداه ، ونظرت إليه عيناه ، واستمعت إليه أذناه ، ونطق به لسانه ، وحدثته به نفسه ) )(@)(@@) ( كر ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19226 ) قال النبي :(@)(@@) | 30 ( ما على إحداكن أن تغير أظفارها ، وتخضب يدها ولو بسير ) )(@)(@@) ابن سعد عن ثبيتة بنت حنظلة عن أمها أم سنان الأسلمية رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19227 ) قال النبي :(@)(@@) | 30 ( ما على أحدكم إذا أراد أن يتصدق أن يجعلها لوالديه إذا كانا مسلمين فيكون لوالديه أجرها ، ويكون له مثل أجورهما من غير أن ينقص من أجورهما شيء ) )(@)(@@) ابن النجار عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 19228 ) قال النبي :(@)(@@) | 30 ( ما على عثمان ما عمل بعد اليوم ) )(@)(@@) ( طب حل ) عن عبد الرحمان بن خباب السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19229 ) قال النبي :(@)(@@) | 30 ( ما على الأرض من رجل يموت وفي قلبه من الكبر مثقال حبة من خردل إلا جعله الله في النار ، فقال رجل : يا رسول الله : إني أحب أن أتجمل بحمالة سيفي ، وبغسل ثيابي من الدرن ، وبحسن الشراك والنعلين ، فقال : ليس ذاك أعني ، الكبر : من سفه الحق ، وغمص الناس قيل : يا رسول الله ما سفه الحق وغمص الناس ؟ قال : هو الذي يجيء شامخا بأنفه ، فإذا رأى ضعفاء الناس وفقراءهم لم يسلم عليهم محقرة لهم ، فذالك الذي يغمص الناس ، من رقع الثوب ، وخصف النعل ، وركب الحمار ، وعاد المملوك إذا مرض ، وحلب الشاة ، فقد برىء من العظمة ) )(@)(@@) ابن صصرى في أماليه عن العباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19230 ) قال النبي :(@)(@@) | 30 ( ما على المرأة أن لا 
ms2072	 تطيب وزوجها غائب ) )(@)(@@) ( طب ) عن أسماء بنت أبي بكر رضي الله عنها .(@)(@@) PageV06P349(@)(@@)(@@)(@@) $ ( 19231 ) قال النبي :(@)(@@) | 30 ( ما على الأرض نفس تموت لا تشرك بالله شيئا ، وتشهد أني رسول الله يرجع ذالك إلى قلب موقن إلا غفر الله لها ) )(@)(@@) ( حب ك ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19232 ) قال النبي :(@)(@@) | 30 ( ما على الأرض رجل يقول لا إلاه إلا الله ، والله أكبر ، وسبحان الله ، والحمد لله ، ولا حول ولا قوة إلا بالله العلي العظيم ، إلا كفرت عنه ذنوبه ولو كانت أكثر من زبد البحر ) )(@)(@@) ( حم طب ) و ابن شاهين في الترغيب في الذكر ( ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19233 ) قال النبي :(@)(@@) | 30 ( ما علمته إذ كان جاهلا ، ولا أطعمته إذ كان ساغبا ) )(@)(@@) ( ط حم د ن ه طب ك هق ض ) عن عباد بن شرحبيل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19234 ) قال النبي :(@)(@@) | 30 ( ما عمل أحب إلى الله تعالى من جهاد في سبيله ، وحجة مبرورة متقبلة لا رفث فيها ولا فسوق ولا جدال ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19235 ) قال النبي :(@)(@@) | 30 ( ما عمل آدمي عملا أنجى له من عذاب الله من ذكر الله ، قالوا : ولا الجهاد في سبيل الله ؟ قال : ولا الجهاد ، إلا أن تضرب بسيفك حتى ينقطع ، ثم تضرب به حتى ينقطع ، ثم تضرب به حتى ينقطع ) )(@)(@@) ( ش حم طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19236 ) قال النبي :(@)(@@) | 30 ( ما عمل شيء أفضل من مشي إلى الصلاة ، وإصلاح ذات البين ، وخلق جائز بين المسلمين ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV06P350(@)(@@)(@@)(@@) $ ( 19237 ) قال النبي :(@)(@@) | 30 ( ما عندي ما أزودكم به ولاكن ادنوا لكل عظم مررتم به فهو لكم لحم عريض ، وكل روث مررتم به فهو لكم تمر قاله للجن ) )(@)(@@) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19238 ) قال النبي :(@)(@@) | 30 ( ما غبنت صفقتك يا ضرار ) )(@)(@@) ( حم ) عن ضرار بن الأزور رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19239 ) قال النبي :(@)(@@) | 30 ( ما عمل أفضل من إشباع كبد جائعة ) )(@)(@@) الديلمي عن أنس رضي 
ms2073	 الله عنه .(@)(@@)(@@)(@@) $ ( 19240 ) قال النبي :(@)(@@) | 30 ( ما عولج مريض بدواء أفضل من الصدقة ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19241 ) قال النبي :(@)(@@) | 30 ( ما فاتكم من هاذه البهائم فاحبسوه بما تحبسون به الوحش ) )(@)(@@) أبو نعيم عن جابر رضي الله عنه وسنده ضعيف جدا .(@)(@@)(@@)(@@) $ ( 19242 ) قال النبي :(@)(@@) | 30 ( ما فتح الله على عاد من الريح التي أهلكوا بها إلا مثل موضع الخاتم ، فمرت بأهل البادية فحملتهم ومواشيهم فجعلتهم بين السماء والأرض ، فلما رأى ذالك أهل الحاضرة من عادة الريح وما فيها قالوا : هاذا عارض ممطرنا ، فألقت أهل البادية ومواشيهم على أهل الحاضرة ) )(@)(@@) ( ع طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19243 ) قال النبي :(@)(@@) | 30 ( ما فتح رجل على نفسه باب مسألة يسأل الناس إلا فتح الله عليه باب فقر ، لأن العفة خير ) )(@)(@@) ابن جرير في تهذيبه عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19244 ) قال النبي :(@)(@@) | 30 ( ما فوق الإزار ، والتعفف عن ذالك أفضل ) )(@)(@@) عن PageV06P351 معاذ بن جبل قال : سألت النبي عما يحل للرجل من امرأته وهي حائض قال : فذكره قال ( د ) : ليس بالقوي .(@)(@@)(@@)(@@) $ ( 19245 ) قال النبي :(@)(@@) | 30 ( ما فوق الخبز وجرة الماء وظل الحائط ، وظل الشجرة فضل يحاسب به ابن آدم يوم القيامة ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19246 ) قال النبي :(@)(@@) | 30 ( ما في الناس مثل رجل أخذ برأس فرسه يجاهد في سبيل الله ويحبس شره عن الناس ومثل رجل يأوي في عتمة يقري ضيفه ، ويعطي حقه ) )(@)(@@) ( حم طب حل ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19247 ) قال النبي :(@)(@@) | 30 ( ما في التوراة ولا في الإنجيل مثل أم القرآن ، وهي السبع المثاني ، وهي مقسومة بيني وبين عبدي ولعبدي ما سأل ) )(@)(@@) ( حب ) عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19248 ) قال النبي :(@)(@@) | 30 ( ما في السماوات السبع موضع قدم ، ولا شبر ، ولا كف ، إلا وفيه ملك قائم ، أو ملك راكع ، أو ملك ساجد ، فإذا كان يوم القيامة قالوا جميعا : سبحانك ما عبدناك حق عبادتك إلا أنا لم 
ms2074	 نشرك بك شيئا ) )(@)(@@) ( طب ) و أبو نعيم ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19249 ) قال النبي :(@)(@@) | 30 ( ما في السماء موضع قدم إلا عليه ملك ساجد أو قائم ) )(@)(@@) أبو الشيخ في العظمة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19250 ) قال النبي :(@)(@@) | 30 ( ما قال عبد لا إلاه إلا الله مخلصا إلا صعدت لا يردها حجاب ، فإذا وصلت إلى الله تعالى نظر الله إلى قائلها ، وحق على الله أن لا ينظر إلى موحد إلا رحمه ) )(@)(@@) ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV06P352(@)(@@)(@@)(@@) $ ( 19251 ) قال النبي :(@)(@@) | 30 ( ما قال عبد : اللهم رب السماوات السبع ورب العرش العظيم ، اكفني كل مهم من حيث شئت ، من أين شئت ، إلا أذهب الله تعالى همه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19252 ) قال النبي :(@)(@@) | 30 ( ما قال عبد قط يا رب ثلاثا إلا قال الله : لبيك عبدي ، فيعجل الله ما يشاء ويؤخر ما يشاء ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19253 ) قال النبي :(@)(@@) | 30 ( ما قال الناس في شيء وقال فيه عمر بن الخطاب إلا جاء القرآن نحو ما يقول ) )(@)(@@) أبو نعيم ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19254 ) قال النبي :(@)(@@) | 30 ( ما قبض نبي إلا جعل روحه بين عينيه ثم خير بين الرجعة إلى الدنيا والموت ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19255 ) قال النبي :(@)(@@) | 30 ( ما قدس الله أمة لا يأخذون للضعيف منهم حقه غير متعتع ) )(@)(@@) ( طب ) عن عبد الله بن أبي سفيان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19256 ) قال النبي :(@)(@@) | 30 ( ما قدس الله تعالى أمة لا يأخذ ضعيفها الحق من قويها غير متعتع ، من انصرف غريمه من حقه عنده وهو راض عنه صلت عليه دواب الأرض ونون الماء ، ومن انصرف غريمه وهو ساخط كتب عليه في كل يوم وليلة وجمعة وشهر ظلم ) )(@)(@@) ( طب ) عن خولة بنت قيس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19257 ) قال النبي :(@)(@@) | 30 ( ما قطر في الأرض قطرة أحب إلى الله من دم رجل مسلم في سبيل الله ، أو 
ms2075	 قطرة دمع في سواد الليل من خشية الله حيث لا يراه أحد إلا الله عز وجل ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19258 ) قال النبي :(@)(@@) | 30 ( ما قعد قوم مقعدا لا يذكرون الله فيه ويصلون على النبي إلا كان عليهم حسرة يوم القيامة ، وإن أدخلوا الجنة للثواب ) )(@)(@@) ( حب ) عن أبي هريرة PageV06P353 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19259 ) قال النبي :(@)(@@) | 30 ( ما كان الله ليجمع فيكم أمرين : النبوة والخلافة ) )(@)(@@) الشيرازي في الألقاب عن أم سلمة أن عليا وفاطمة والحسن والحسين دخلوا على النبي فسألوه الخلافة قال : فذكره .(@)(@@)(@@)(@@) $ ( 19260 ) قال النبي :(@)(@@) | 30 ( ما كان محمد قائلا لربه لو مات وهاذه عنده ) )(@)(@@) ( طب حل ) عن ابن عباس رضي الله عنهما قال : خرج رسول الله على أصحابه وفي يده قطعة من ذهب فقسمها وقال : فذكره .(@)(@@)(@@)(@@) $ ( 19261 ) قال النبي :(@)(@@) | 30 ( ما كان يدا بيد فلا بأس به وما كان نسيئا فلا خير فيه ) )(@)(@@) ( طب ) عن البراء وزيد بن أرقم رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19262 ) قال النبي :(@)(@@) | 30 ( ما كان الله ليفتح لعبد الدعاء فيغلق عنه باب الإجابة ، الله أكرم من ذالك ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19263 ) قال النبي :(@)(@@) | 30 ( ما كان من حزن في قلب أو عين فهو من قبل الرحمة ، وما كان من حزن في يد أو لسان فهو من قبل الشيطان ) )(@)(@@) أبو نعيم عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19264 ) قال النبي :(@)(@@) | 30 ( ما كانت هاذه تقاتل ، أدرك خالدا فقل له : إن رسول الله يأمرك أن لا تقتل ذرية وفي لفظ : امرأة ولا عسيفا ) )(@)(@@) ( حم ن ه ) و الطحاوي ( طب ) والباوردي وابن قانع ( طب ض ) عن حنظلة الكاتب قال : غزونا مع رسول الله فمررنا على امرأة مقتولة قال : فذكره ، ( حم د ن ه ) والطحاوي والبغوي ، ( حب ك ) عن المرقع بن صيفي بن رباح عن جده رباح بن PageV06P354 الربيع أخي حنظلة الكاتب قال ابن حجر في أطرافه وهو المحفوظ ، وادعى ( حب ) أن الطريقين محفوظان .(@)(@@)(@@)(@@) $ ( 19265 ) قال النبي :(@)(@@) | 30 ( ما كانت من فتنة ولا يكون حتى 
ms2076	 تقوم الساعة أعظم من فتنة الدجال ، وما من نبي إلا وقد حذر قومه ، ولأخبرنكم بشيء ما أخبر به نبي قبلي ، إنه أعور وأشهد أن الله ليس بأعور ) )(@)(@@) ( ك ) عن جار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19266 ) قال النبي :(@)(@@) | 30 ( ما كبر مكبر في بر ولا بحر إلا ملأ تكبيره ما بين السماء والأرض ) )(@)(@@) ابو الشيخ عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19267 ) قال النبي :(@)(@@) | 30 ( ما كبر الحاج من تكبيرة وما هلل من تهليلة إلا بشر بها تبشرة ) )(@)(@@) ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19268 ) قال النبي :(@)(@@) | 30 ( ما كثر الربا إلا كان عاقبته إلى قلة ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19269 ) قال النبي :(@)(@@) | 30 ( ما كسب رجل مالا حراما فبورك فيه ، وما تصدق منه فقبل منه ، ولا يتركه خلف ظهره إلا كان زاده إلى النار ) )(@)(@@) ابن النجار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19270 ) قال النبي :(@)(@@) | 30 ( ما كلمت في الإسلام أحدا إلا أبى علي وراجعني الكلام إلا ابن أبي قحافة فإني لم أكلمه في شيء إلا قبله وسارع إليه ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19271 ) قال النبي :(@)(@@) | 30 ( ما كنت لأستعملك على غسالة ذنوب الناس ) )(@)(@@) ابن سعد ( ك ) عن علي قال : قلت للعباس : سل النبي ليستعملنك على الصدقة ، فسأله فقال : فذكره .(@)(@@)(@@)(@@) $ ( 19272 ) قال النبي :(@)(@@) | 30 ( ما كنتم تقولون ؟ فإني رأيت الرحمة تنزل عليكم PageV06P355 فأحببت أن أشارككم فيها ) )(@)(@@) ( ك ) عن سل مان رضي الله عنه أنه كان في عصابة يذكرون الله تعالى فمر بهم رسول الله فجاء نحوهم قال : فذكره .(@)(@@)(@@)(@@) $ ( 19273 ) قال النبي :(@)(@@) | 30 ( ما كنت في هاذا اليوم إلا سفينة ) )(@)(@@) ا(@)(@@) | 40 ( بن منده والماليني في المؤتلف وأبو نعيم من طريق عمران البجلي ) 40(@)(@@) بن منده والماليني في المؤتلف وأبو نعيم من طريق عمران البجلي عن أحمر مولى أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19274 ) قال النبي :(@)(@@) | 30 ( ما لقي الشيطان عمر في فج فسمع صوته إلا أخذ في غيره ) )(@)(@@) الحكيم عن عمر رضي الله 
ms2077	 عنه .(@)(@@)(@@)(@@) $ ( 19275 ) قال النبي :(@)(@@) | 30 ( ما لك وهاذه النومة ، هاذه نومة يبغضها الله ) )(@)(@@) ( ك ) عن قيس الغفاري عن أبيه .(@)(@@)(@@)(@@) $ ( 19276 ) قال النبي :(@)(@@) | 30 ( ما لك وللعذارى ولعابها ) )(@)(@@) ( ط حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19277 ) قال النبي :(@)(@@) | 30 ( ما لكم تدخلون علي قلحا ، لولا أن أشق على أمتي لأمرتهم بالسواك عند كل صلاة ، لا بد للناس من العريف ، والعريف في النار ، يؤتى بالجلواز يوم القيامة فيقال له : ضع سوطك وادخل النار ) )(@)(@@) سمويه ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19278 ) قال النبي :(@)(@@) | 30 ( ما لم تنله خفاف الإبل ) )(@)(@@) ( د ت ن ه ) و الدرامي ( حب قط هب ) عن أبيض بين حمال أنه سأل رسول الله عما يحمي من الأراك قال : فذكره .(@)(@@) PageV06P356(@)(@@)(@@)(@@) $ ( 19279 ) قال النبي :(@)(@@) | 30 ( ما لك وللشبرم , 3 فإنه حار يابس ، عليك بالسنا والسنون فإن فيهما دواء من كل شيء إلا السام ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19280 ) قال النبي :(@)(@@) | 30 ( ما لهم ولعمار ، يدعوهم إلى الجنة ، ويدعونه إلى النار ، قاتله وسالبه في النار ) )(@)(@@) ( كر ) عن مجاهد عن أسامة بن شريك بن أبي زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19281 ) قال النبي :(@)(@@) | 30 ( ما لهم ولعمار ، يدعوهم إلى الجنة ويدعونه إلى النار ، وذالك فعل الأشقياء الأشرار وفي لفظ : وذالك دأب الأشقياء الفجار ) )(@)(@@) ( ش كر ) عن مجاهد مرسلا ، قال ( كر ) : وهو المحفوظ .(@)(@@)(@@)(@@) $ ( 19282 ) قال النبي :(@)(@@) | 30 ( ما لكم تدخلون علي قلحا ؟ استاكوا ، فلولا أن أشق على أمتي لأمرتهم بالسواك عند كل طهور ) )(@)(@@) ( طب ) عن تمام بن العباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19283 ) قال النبي :(@)(@@) | 30 ( ما لكم تدخلون علي قلحا ؟ تسوكوا فلولا أن أشق على أمتي لأمرتهم أن يتسواكوا عند كل صلاة ) )(@)(@@) ( طب ) و أبو نعيم عن تمام بن العباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19284 ) قال النبي :(@)(@@) | 30 ( ما لكم لا تتكلمون ، من قال : سبحان الله وبحمده كتب الله له عشر حسنات ، ومن قالها عشرا كتب الله له مائة حسنة ، ومن قالها مائة مرة كتب الله له ألف حسنة ، ومن زاد زاده الله 
ms2078	 ، ومن استغفر غفر الله له ، ومن حالت شفاعته دون حد من حدود الله فقد ضاد الله في حكمه ، ومن اتهم PageV06P357 برياء صيره الله إلى طينة الخبال حتى يأتي بالمخرج مما قال ، ومن انتفى من ولده ويفضحه به في الدنيا فضحه الله على رءوس الخلائق يوم القيامة ) )(@)(@@) ابن صصرى في أماليه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19285 ) قال النبي :(@)(@@) | 30 ( ما لكم تضربون كتاب الله بعضه ببعض ، بهاذا هلك من كان قبلكم ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19286 ) قال النبي :(@)(@@) | 30 ( ما لكم تنظرون ؟ قالوا : رأيناك رققت ، قال : رحمة يضعها الله حيث يشاء ، وإنما يرحم الله غدا من عباده الرحماء ) )(@)(@@) ( طب ) عن الوليد بن إبراهيم بن عبد الرحمان بن عوف عن أبيه عن جده قال : استعز بأمامة بنت أبي العاص ، فبعثت زينب إلى رسول الله فجاءها ومعه ناس من أصحابه ، فأخرجت الصبية إليه فإذا نفسها تقعقع في صدرها فذرفت عيناه فقطر بهم وهم ينظرون إليه قال : فذكره .(@)(@@)(@@)(@@) $ ( 19287 ) قال النبي :(@)(@@) | 30 ( ما لي لا أرى عندك من البركات شيئا ، إن الله تعالى أنزل بركات ثلاثا : الشاة والنخلة والنار ) )(@)(@@) ( طب ) عن أم هانىء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19288 ) قال النبي :(@)(@@) | 30 ( ما لي أنازع القرآن ، لا يقرأ أحد منكم شيئا من القرآن إذا جهرت بالقراءة إلا بأم القرآن ) )(@)(@@) ( قط ) وحسنه ( هق ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 19289 - قال النبي صلى الله عليه وسلم : ' ما لي أراكم تتهافتون في الكذب تهافت الفراش | في النار ، ألا إن كل كذب مكتوب على ابن آدم كذبا لا محالة إلا أن يكذب الرجل | في الحرب فإن الحرب خدعة ، أو يكذب بين الرجلين ليصلح بينهما ، أو يكذب | امرأته ليرضيها ' ابن جرير والخرائطي في مساوئ الأخلاق ( هب ) عن النواس | رضي الله عنه . | PageV06P358 |(@)(@@)(@@)(@@) $ 19290 - قال النبي صلى الله عليه وسلم : ' ما لي أراكم تتتايعون في الكذب كما يتتايع | الفراش في النار ' ابن لال عن أسماء بنت يزيد رضي الله عنها . |(@)(@@)(@@)(@@) $ 19291 - قال النبي صلى الله عليه 
ms2079	 وسلم : ' ما لي أراكم تأتوني قلحا ، استاكوا ، فلولا أن أشق | على أمتي لفرضت عليهم السواك كما فرضت عليهم الصلاة ' ( طب ) وأبو نعيم عن | جعفر بن تميم ابن العباس أو ابن تمام بن العباس عن أبيه . |(@)(@@)(@@)(@@) $ 19292 - قال النبي صلى الله عليه وسلم : ' ما لي أراكم تأتوني قلحا ، استاكوا ، فلولا أن أشق | على أمتي لفرضت عليهم السواك عند كل صلاة كما فرضت عليهم الوضوء ' | ( حم ) والبغوي والباوردي وابن قانع ( ض ) عن جعفر بن تمام بن العباس عن | أبيه ، ( ن ) والبغوي وسمويه ، ( ك ) عن جعفر بن تمام عن أبيه عن جده | العباس بن عبد المطلب ( حم ) والباوردي عن قثم بن تمام أو تمام بن قثم عن | أبيه ، البغوي عن جعفر بن العباس عن أبيه قال : وهو الصواب زعموا . |(@)(@@)(@@)(@@) $ 19293 - قال النبي صلى الله عليه وسلم : ' ما لي أنازع القرآن ، إذا صلى أحدكم خلف | الإمام فليصمت ، فإن قراءته له قراءة ، وصلاته له صلاة ' ( خط ) عن ابن مسعود | رضي الله عنه . |(@)(@@)(@@)(@@) $ 19294 - قال النبي صلى الله عليه وسلم : ' ما لي من هذا المال إلا مثل ما لأحدكم ، إلا | الخمس وهو مردود عليكم ، فأدوا الخياط والمخيط فما فوقهما ، وإياكم والغلول | فإنه عار ونار وشنار على صاحبه يوم القيامة ' ( حم طب ) عن العرباض رضي الله | عنه . |(@)(@@)(@@)(@@) $ 19295 - قال النبي صلى الله عليه وسلم : ' ما لي أراكم سكوتا ، للجن كانوا أحسن ردا | PageV06P359 | منكم ، ما قرأت عليهم هذه الآية من مرة ^ ( فبأي آلاء ربكما تكذبان ) ^ إلا | قالوا : ولا بشيء من نعمك ربنا نكذب فلك الحمد ' الحسن بن سفيان ( ك هب ) | عن جابر رضي الله عنه . |(@)(@@)(@@)(@@) $ ( 19296 ) قال النبي :(@)(@@) | 30 ( ما لي ولبني العباس : شيعوا أمتي ، وسفكوا دماءها ، وألبسوها ثياب السواد ألبسهم الله ثياب النار ) )(@)(@@) ( طب ) عن ثوبان ، نعيم بن حماد في الفتن عن مكحول مرسلا ، وعن علي رضي الله عنه موصولا .(@)(@@)(@@)(@@) $ ( 19297 ) قال النبي :(@)(@@) | 30 ( ما لي أرى أيديكم كأنها أذناب خيل شمس ، إنما يكفي أحدكم أن يضع يديه على فخذه ثم يسلم عن يمينه وعن شماله ) )(@)(@@) ( حب 
ms2080	 ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19298 ) قال النبي :(@)(@@) | 30 ( ما لي أراك لقا بقا ، كيف بك أذا أخرجوك من المدينة ؟ قال : آتي الأرض المقدسة ، قال : فكيف إذا أخرجوك منها ؟ قال : آتي المدينة ، قال : فإن أخرجوك منها ؟ قلت : آخذ سيفي فأضرب به حتى أقتل ، قال : لا ، ولاكن اسمع وأطع ولو لعبد أسود ) )(@)(@@) نعيم بن حماد في الفتن عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19299 ) قال النبي :(@)(@@) | 30 ( ما للنفساء عندي شفاء مثل الرطب ، ولا للمريض مثل العسل ) )(@)(@@) أبو الشيخ وأبو نعيم في الطب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19300 ) قال النبي :(@)(@@) | 30 ( ما مد الناس أيديهم إلى شيء من السلاح إلا وللقوس عليه فضل ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19301 ) قال النبي :(@)(@@) | 30 ( ما من أحد يتوضأ فيحسن الوضوء ثم يقول حين PageV06P360 يفرغ من وضوئه : أشهد أن لا إلاه إلا الله وحده لا شريك له ، وأن محمدا عبده ورسوله إلا فتحت أبواب الجنة الثمانية له يدخل من أيها شاء ) )(@)(@@) ( حب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19302 ) قال النبي :(@)(@@) | 30 ( ما من أحد يدخل الجنة يسره أن يرجع إلى الدنيا إلا الشهيد فإنه يحب أن يرجع ليقتل معرة أخرى ) )(@)(@@) ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19303 ) قال النبي :(@)(@@) | 30 ( ما من أحد يدخل الجنة يحب أن يرجع إلى الدنيا وله ما على الأرض من شيء إلا الشهيد فإنه يتمنى أن يرجع إلى الدنيا فيقتل عشر مرات لما يرى من الكرامة ) )(@)(@@) ابن زنجويه ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19304 ) قال النبي :(@)(@@) | 30 ( ما من أحد يحلف على يمين كاذبة ليقتطع بها حق امرىء إلا لقي الله عز وجل وهو عليه غضبان ) )(@)(@@) ( طب ) عن الحارث بن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19305 ) قال النبي :(@)(@@) | 30 ( ما من أحد يقرأ القرآن ثم ينساه إلا لقي الله وهو أجذم ) )(@)(@@) ( ش ) عن سعد بن عبادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19306 ) قال النبي :(@)(@@) | 30 ( ما من أحد يلي أمر عشرة فما فوق ذالك إلا 