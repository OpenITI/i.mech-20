ms881	 وطولها، لا نعرفه إلا من حديث عمر بن هارون، ورأيته حسن الرأي في عمر (@)(@@) @MATN@ ": وسمعت قتيبة، يقول: " عمر بن هارون كان صاحب حديث، وكان يقول: الإيمان قول وعمل. سمعت قتيبة قال: حدثنا وكيع بن الجراح، عن رجل، عن ثور بن يزيد، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم نصب المنجنيق على أهل الطائف» (@)(@@) قال قتيبة: قلت لوكيع: من هذا؟ قال: (@)(@@) @MATN@ «صاحبكم عمر بن هارون» (@)(@@) (@)PageV05P094 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في إعفاء اللحية (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٦٣ - (@)(@@) حدثنا الحسن بن علي الخلال قال: حدثنا عبد الله بن نمير، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «احفوا الشوارب واعفوا اللحى» : (@)(@@) @MATN@ «هذا حديث صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٦٤ - (@)(@@) حدثنا الأنصاري قال: حدثنا معن قال: حدثنا مالك، عن أبي بكر بن نافع، عن أبيه، عن ابن عمر، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم أمرنا بإحفاء الشوارب وإعفاء اللحى» : (@)(@@) @MATN@ " هذا حديث حسن صحيح، وأبو بكر بن نافع هو: مولى ابن عمر ثقة، وعمر بن نافع ثقة، وعبد الله بن نافع مولى ابن عمر يضعف " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في وضع إحدى الرجلين على الأخرى مستلقيا (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٦٥ - (@)(@@) حدثنا سعيد بن عبد الرحمن المخزومي وغير واحد، قالوا: حدثنا سفيان بن عيينة، عن الزهري، عن عباد بن تميم، عن عمه، (@)(@@) @MATN@ «أنه رأى PageV05P095 النبي صلى الله عليه وسلم مستلقيا في المسجد واضعا إحدى رجليه على الأخرى» : (@)(@@) @MATN@ " هذا حديث حسن صحيح، وعم عباد بن تميم هو: عبد الله بن زيد بن عاصم المازني " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الكراهية في ذلك (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٦٦ - (@)(@@) حدثنا عبيد بن أسباط بن محمد القرشي قال: حدثنا أبي قال: حدثنا سليمان التيمي، عن خداش، عن أبي الزبير، عن جابر، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إذا استلقى أحدكم على ظهره فلا يضع إحدى رجليه على الأخرى» (@)(@@) هذا حديث رواه غير واحد عن سليمان التيمي ولا يعرف خداش هذا من هو، وقد روى له سليمان التيمي غير حديث " (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٦٧ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، 
ms882	 عن أبي الزبير، عن جابر، (@)(@@) @MATN@ «أن رسول الله صلى الله عليه وسلم نهى عن اشتمال الصماء والاحتباء في ثوب واحد، وأن يرفع الرجل إحدى رجليه على الأخرى وهو مستلق على ظهره» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P096 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية الاضطجاع على البطن (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٦٨ - (@)(@@) حدثنا أبو كريب قال: حدثنا عبدة بن سليمان، وعبد الرحيم، عن محمد بن عمرو قال: حدثنا أبو سلمة، عن أبي هريرة، قال: رأى رسول الله صلى الله عليه وسلم رجلا مضطجعا على بطنه فقال: (@)(@@) @MATN@ «إن هذه ضجعة لا يحبها الله» (@)(@@) وفي الباب عن طهفة، وابن عمر: وروى يحيى بن أبي كثير، هذا الحديث عن أبي سلمة، عن يعيش بن طهفة، عن أبيه، (@)(@@) @MATN@ " ويقال: طخفة، والصحيح طهفة، وقال بعض الحفاظ: الصحيح طخفة، ويقال: طغفة يعيش هو من الصحابة " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في حفظ العورة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٦٩ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد قال: حدثنا بهز بن حكيم قال: حدثني أبي، عن جدي، قال: قلت: يا رسول الله عوراتنا ما نأتي منها وما نذر؟ قال: (@)(@@) @MATN@ «احفظ عورتك إلا من زوجتك أو ما PageV05P097 ملكت يمينك» ، (@)(@@) فقال: الرجل يكون مع الرجل؟ قال: (@)(@@) @MATN@ «إن استطعت أن لا يراها أحد فافعل» ، (@)(@@) قلت: والرجل يكون خاليا، قال: (@)(@@) @MATN@ «فالله أحق أن يستحيا منه» : (@)(@@) @MATN@ " هذا حديث حسن، وجد بهز اسمه: معاوية بن حيدة القشيري، وقد روى الجريري، عن حكيم بن معاوية وهو والد بهز " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الاتكاء (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٠ - (@)(@@) حدثنا عباس بن محمد الدوري البغدادي قال: حدثنا إسحاق بن منصور الكوفي قال: أخبرنا إسرائيل، عن سماك بن حرب، عن جابر بن سمرة، قال: (@)(@@) @MATN@ «رأيت النبي صلى الله عليه وسلم متكئا على وسادة على يساره» : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) وروى غير واحد هذا الحديث عن إسرائيل، عن سماك عن جابر بن سمرة، قال: (@)(@@) @MATN@ «رأيت النبي صلى الله عليه وسلم متكئا على وسادة» (@)(@@) ولم يذكر على يساره (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧١ - (@)(@@) حدثنا يوسف بن عيسى قال: حدثنا وكيع، عن إسرائيل، عن سماك بن حرب، عن جابر بن 
ms883	 سمرة، قال: (@)(@@) @MATN@ «رأيت النبي صلى الله عليه وسلم متكئا على وسادة» (@)(@@) هذا حديث صحيح (@)PageV05P098 (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٢ - (@)(@@) حدثنا هناد قال: حدثنا أبو معاوية، عن الأعمش، عن إسماعيل بن رجاء، عن أوس بن ضمعج، عن أبي مسعود، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لا يؤم الرجل في سلطانه ولا يجلس على تكرمته في بيته إلا بإذنه» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء أن الرجل أحق بصدر دابته (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٣ - (@)(@@) حدثنا أبو عمار الحسين بن حريث قال: حدثنا علي بن الحسين بن واقد قال: حدثني أبي قال: حدثني عبد الله بن بريدة، قال: سمعت أبي بريدة، يقول: بينما النبي صلى الله عليه وسلم يمشي إذ جاءه رجل ومعه حمار فقال: يا رسول الله اركب، وتأخر الرجل، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لأنت أحق بصدر دابتك، إلا أن تجعله لي» (@)(@@) قال: قد جعلته لك، قال: فركب: (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) وفي الباب عن قيس بن سعد بن عبادة (@)PageV05P099 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الرخصة في اتخاذ الأنماط (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٤ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا سفيان، عن محمد بن المنكدر، عن جابر، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «هل لكم أنماط» ؟ (@)(@@) قلت: وأنى تكون لنا أنماط قال: (@)(@@) @MATN@ «أما إنها ستكون لكم أنماط» (@)(@@) قال: فأنا أقول لامرأتي أخري عني أنماطك فتقول: ألم يقل النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «إنها ستكون لكم أنماط» ؟ (@)(@@) قال: فأدعها: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في ركوب ثلاثة على دابة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٥ - (@)(@@) حدثنا عباس العنبري قال: حدثنا النضر بن محمد هو الجرشي اليمامي قال: حدثنا عكرمة بن عمار، عن إياس بن سلمة، عن أبيه، قال: (@)(@@) @MATN@ «لقد قدت نبي الله صلى الله عليه وسلم والحسن والحسين على بغلته الشهباء حتى أدخلته حجرة النبي صلى الله عليه وسلم، هذا قدامه، وهذا خلفه» (@)(@@) PageV05P100 وفي الباب عن ابن عباس، وعبد الله بن جعفر: (@)(@@) @MATN@ «هذا حديث حسن صحيح غريب من هذا الوجه» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب 
ms884	 ما جاء في نظرة الفجاءة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٦ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا هشيم قال: أخبرنا يونس بن عبيد، عن عمرو بن سعيد، عن أبي زرعة بن عمرو بن جرير، عن جرير بن عبد الله، قال: سألت رسول الله صلى الله عليه وسلم عن نظرة الفجاءة (@)(@@) @MATN@ «فأمرني أن أصرف بصري» : (@)(@@) @MATN@ «هذا حديث حسن صحيح، وأبو زرعة بن عمرو اسمه هرم» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٧ - (@)(@@) حدثنا علي بن حجر قال: أخبرنا شريك، عن أبي ربيعة، عن ابن بريدة، عن أبيه، رفعه قال: (@)(@@) @MATN@ «يا علي لا تتبع النظرة النظرة فإن لك الأولى وليست لك الآخرة» : (@)(@@) @MATN@ «هذا حديث غريب لا نعرفه إلا من حديث شريك» (@)(@@) (@)PageV05P101 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في احتجاب النساء من الرجال (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٨ - (@)(@@) حدثنا سويد قال: حدثنا عبد الله قال: أخبرنا يونس بن يزيد، عن ابن شهاب، عن نبهان، مولى أم سلمة، أنه حدثه أن أم سلمة، حدثته أنها كانت عند رسول الله صلى الله عليه وسلم وميمونة قالت: فبينا نحن عنده أقبل ابن أم مكتوم فدخل عليه وذلك بعد ما أمرنا بالحجاب، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «احتجبا منه» ، (@)(@@) فقلت: يا رسول الله أليس هو أعمى لا يبصرنا ولا يعرفنا؟ فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أفعمياوان أنتما ألستما تبصرانه» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في النهي عن الدخول على النساء إلا بإذن الأزواج (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٧٩ - (@)(@@) حدثنا سويد قال: حدثنا عبد الله قال: أخبرنا شعبة، عن الحكم، عن ذكوان، عن مولى عمرو بن العاص، أن عمرو بن العاص، أرسله إلى علي يستأذنه على أسماء بنت عميس فأذن له حتى إذا فرغ من حاجته سأل المولى عمرو بن العاص عن ذلك. فقال: (@)(@@) @MATN@ «إن رسول الله صلى الله عليه وسلم نهانا أن ندخل على النساء بغير إذن أزواجهن» (@)(@@) PageV05P102 وفي الباب عن عقبة بن عامر، وعبد الله بن عمرو، وجابر: (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في تحذير فتنة النساء (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٠ - (@)(@@) حدثنا محمد بن عبد الأعلى الصنعاني قال: حدثنا المعتمر بن سليمان، عن أبيه، 
ms885	 عن أبي عثمان، عن أسامة بن زيد، وسعيد بن زيد بن عمرو بن نفيل، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «ما تركت بعدي في الناس فتنة أضر على الرجال من النساء» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد روى هذا الحديث غير واحد من الثقات عن سليمان التيمي، عن أبي عثمان، عن أسامة بن زيد، عن النبي صلى الله عليه وسلم، (@)(@@) @MATN@ " ولم يذكروا فيه عن سعيد بن زيد بن عمرو بن نفيل، ولا نعلم أحدا قال: عن أسامة بن زيد. وسعيد بن زيد غير المعتمر " وفي الباب عن أبي سعيد (@)PageV05P103 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية اتخاذ القصة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨١ - (@)(@@) حدثنا سويد قال: أخبرنا عبد الله قال: أخبرنا يونس، عن الزهري قال: أخبرنا حميد بن عبد الرحمن، أنه سمع معاوية، بالمدينة يخطب يقول: أين علماؤكم يا أهل المدينة؟ إني سمعت رسول الله صلى الله عليه وسلم ينهى عن هذه القصة ويقول: (@)(@@) @MATN@ «إنما هلكت بنو إسرائيل حين اتخذها نساؤهم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح، وقد روي من غير وجه عن معاوية» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الواصلة والمستوصلة والواشمة والمستوشمة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٢ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا عبيدة بن حميد، عن منصور، عن إبراهيم، عن علقمة، عن عبد الله، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم لعن الواشمات والمستوشمات والمتنمصات مبتغيات للحسن مغيرات خلق الله» (@)(@@) PageV05P104 هذا حديث حسن صحيح " وقد رواه شعبة، وغير واحد من الأئمة عن منصور (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٣ - (@)(@@) حدثنا سويد قال: أخبرنا عبد الله بن المبارك، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «لعن الله الواصلة والمستوصلة والواشمة والمستوشمة» (@)(@@) قال نافع: (@)(@@) @MATN@ «الوشم في اللثة» (@)(@@) هذا حديث حسن صحيح " وفي الباب عن عائشة، ومعقل بن يسار، وأسماء بنت أبي بكر، وابن عباس حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد قال: حدثنا عبيد الله بن عمر، عن نافع، عن ابن عمر، عن النبي صلى الله عليه وسلم نحوه، (@)(@@) @MATN@ «ولم يذكر فيه يحيى قول نافع» : (@)(@@) @MATN@ «هذا حديث 
ms886	 حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في المتشبهات بالرجال من النساء (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٤ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود الطيالسي قال: حدثنا شعبة، وهمام، عن قتادة، عن عكرمة، عن ابن عباس، قال: (@)(@@) @MATN@ «لعن PageV05P105 رسول الله صلى الله عليه وسلم المتشبهات بالرجال من النساء والمتشبهين بالنساء من الرجال» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٥ - (@)(@@) حدثنا الحسن بن علي الخلال قال: حدثنا عبد الرزاق قال: أخبرنا معمر، عن يحيى بن أبي كثير، وأيوب، عن عكرمة، عن ابن عباس، قال: (@)(@@) @MATN@ «لعن رسول الله صلى الله عليه وسلم المخنثين من الرجال والمترجلات من النساء» (@)(@@) هذا حديث حسن صحيح " وفي الباب عن عائشة (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية خروج المرأة متعطرة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٦ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد القطان، عن ثابت بن عمارة الحنفي، عن غنيم بن قيس، عن أبي موسى، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «كل عين زانية، والمرأة إذا استعطرت فمرت بالمجلس فهي كذا وكذا» (@)(@@) يعني زانية وفي الباب عن أبي هريرة: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P106 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في طيب الرجال والنساء (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٧ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود الحفري، عن سفيان، عن الجريري، عن أبي نضرة، عن رجل، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «طيب الرجال ما ظهر ريحه وخفي لونه، وطيب النساء ما ظهر لونه وخفي ريحه» (@)(@@) حدثنا علي بن حجر قال: أخبرنا إسماعيل بن إبراهيم، عن الجريري، عن أبي نضرة، عن الطفاوي، عن أبي هريرة، عن النبي صلى الله عليه وسلم نحوه بمعناه. هذا حديث حسن إلا أن الطفاوي لا نعرفه إلا في هذا الحديث ولا نعرف اسمه، وحديث إسماعيل بن إبراهيم أتم وأطول. وفي الباب عن عمران بن حصين (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٨ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو بكر الحنفي، عن سعيد، عن قتادة، عن الحسن، عن عمران بن حصين، قال: قال لي النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «إن خير طيب الرجل ما ظهر ريحه وخفي لونه، وخير 
ms887	 طيب النساء ما ظهر لونه وخفي ريحه» ، (@)(@@) ونهى عن ميثرة الأرجوان (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) (@)PageV05P107 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية رد الطيب (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٨٩ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا عزرة بن ثابت، عن ثمامة بن عبد الله، قال: كان أنس لا يرد الطيب، وقال أنس: (@)(@@) @MATN@ «إن النبي صلى الله عليه وسلم كان لا يرد الطيب» (@)(@@) وفي الباب عن أبي هريرة: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٠ - (@)(@@) حدثنا قتيبة قال: حدثنا ابن أبي فديك، عن عبد الله بن مسلم، عن أبيه، عن ابن عمر، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " ثلاث لا ترد: الوسائد، والدهن، واللبن " الدهن: يعني به الطيب. هذا حديث غريب، وعبد الله بن مسلم هو ابن جندب وهو مديني (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩١ - (@)(@@) حدثنا محمد بن خليفة أبو عبيد الله البصري، وعمرو بن علي، قالا: حدثنا يزيد بن زريع، عن حجاج الصواف، عن حنان، عن أبي عثمان النهدي، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إذا أعطي أحدكم الريحان فلا يرده فإنه خرج من الجنة» (@)(@@) هذا حديث غريب لا نعرفه إلا من هذا الوجه، ولا نعرف PageV05P108 حنانا إلا في هذا الحديث، وأبو عثمان النهدي اسمه: عبد الرحمن بن مل، وقد أدرك زمن النبي صلى الله عليه وسلم ولم يره ولم يسمع منه " (@) (@)(@) (@)(@@)(@@)(@@) || باب في كراهية مباشرة الرجال الرجال والمرأة المرأة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٢ - (@)(@@) حدثنا هناد قال: حدثنا أبو معاوية، عن الأعمش، عن شقيق بن سلمة، عن عبد الله، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لا تباشر المرأة المرأة حتى تصفها لزوجها كأنما ينظر إليها» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٣ - (@)(@@) حدثنا عبد الله بن أبي زياد قال: حدثنا زيد بن حباب قال: أخبرني الضحاك بن عثمان قال: أخبرني زيد بن أسلم، عن عبد الرحمن بن أبي سعيد الخدري، عن أبيه، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لا ينظر الرجل إلى عورة الرجل، ولا تنظر المرأة إلى عورة المرأة، ولا 
ms888	 يفضي الرجل إلى الرجل في الثوب الواحد، ولا تفضي المرأة إلى المرأة في الثوب الواحد» : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) (@)PageV05P109 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في حفظ العورة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٤ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا معاذ بن معاذ، ويزيد بن هارون، قالا: حدثنا بهز بن حكيم، عن أبيه، عن جده، قال: قلت: يا نبي الله عوراتنا ما نأتي منها وما نذر؟ قال: (@)(@@) @MATN@ «احفظ عورتك إلا من زوجتك أو ما ملكت يمينك» ، (@)(@@) قلت: يا رسول الله إذا كان القوم بعضهم في بعض؟ قال: (@)(@@) @MATN@ «إن استطعت أن لا يراها أحد فلا ترينها» ، (@)(@@) قال: قلت: يا نبي الله إذا كان أحدنا خاليا؟ قال: (@)(@@) @MATN@ «فالله أحق أن يستحيا منه من الناس» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء أن الفخذ عورة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٥ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن أبي النضر، مولى عمر بن عبيد الله، عن زرعة بن مسلم بن جرهد الأسلمي، عن جده جرهد، قال: مر النبي صلى الله عليه وسلم بجرهد في المسجد وقد انكشف فخذه فقال: (@)(@@) @MATN@ «إن الفخذ عورة» : (@)(@@) @MATN@ «هذا حديث حسن ما أرى إسناده بمتصل» (@)(@@) (@)PageV05P110 (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٦ - (@)(@@) حدثنا واصل بن عبد الأعلى الكوفي قال: حدثنا يحيى بن آدم، عن إسرائيل، عن أبي يحيى، عن مجاهد، عن ابن عباس، عن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «الفخذ عورة» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٧ - (@)(@@) حدثنا واصل بن عبد الأعلى قال: حدثنا يحيى بن آدم، عن الحسن بن صالح، عن عبد الله بن محمد بن عقيل، عن عبد الله بن جرهد الأسلمي، عن أبيه، عن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الفخذ عورة» . (@)(@@) هذا حديث حسن غريب من هذا الوجه. وفي الباب عن علي، ومحمد بن عبد الله بن جحش. ولعبد الله بن جحش صحبة ولابنه محمد صحبة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٨ - (@)(@@) حدثنا الحسن بن علي الخلال قال: حدثنا عبد الرزاق قال: أخبرنا معمر، عن أبي الزناد، قال: أخبرني ابن جرهد، عن أبيه، أن النبي صلى الله عليه وسلم مر به وهو كاشف عن فخذه، فقال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «غط فخذك 
ms889	 فإنها من العورة» . (@)(@@) هذا حديث حسن (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في النظافة (@)(@) (@)(@@)(@@)(@@) ||| ٢٧٩٩ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو عامر العقدي قال: حدثنا خالد بن إلياس، ويقال ابن إياس، عن صالح بن أبي حسان، قال: سمعت PageV05P111 سعيد بن المسيب، يقول: (@)(@@) @MATN@ «إن الله طيب يحب الطيب، نظيف يحب النظافة، كريم يحب الكرم، جواد يحب الجود، فنظفوا - أراه قال - أفنيتكم ولا تشبهوا باليهود» (@)(@@) قال: فذكرت ذلك لمهاجر بن مسمار، فقال: حدثنيه عامر بن سعد بن أبي وقاص، عن أبيه، عن النبي صلى الله عليه وسلم مثله، إلا أنه قال: (@)(@@) @MATN@ «نظفوا أفنيتكم» . (@)(@@) هذا حديث غريب وخالد بن إلياس يضعف (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الاستتار عند الجماع (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٠ - (@)(@@) حدثنا أحمد بن محمد بن نيزك البغدادي قال: حدثنا الأسود بن عامر قال: حدثنا أبو محياة، عن ليث، عن نافع، عن ابن عمر، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «إياكم والتعري فإن معكم من لا يفارقكم إلا عند الغائط وحين يفضي الرجل إلى أهله، فاستحيوهم وأكرموهم» : (@)(@@) @MATN@ " هذا حديث غريب لا نعرفه إلا من هذا الوجه وأبو محياة اسمه: يحيى بن يعلى " (@)PageV05P112 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في دخول الحمام (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠١ - (@)(@@) حدثنا القاسم بن دينار الكوفي قال: حدثنا مصعب بن المقدام، عن الحسن بن صالح، عن ليث بن أبي سليم، عن طاوس، عن جابر، أن النبي صلى الله عليه وسلم، قال: (@)(@@) @MATN@ «من كان يؤمن بالله واليوم الآخر فلا يدخل الحمام بغير إزار، ومن كان يؤمن بالله واليوم الآخر فلا يدخل حليلته الحمام، ومن كان يؤمن بالله واليوم الآخر فلا يجلس على مائدة يدار عليها بالخمر» : (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه من حديث طاووس، عن جابر إلا من هذا الوجه» (@)(@@) قال محمد بن إسماعيل: (@)(@@) @MATN@ «ليث بن أبي سليم صدوق وربما يهم في الشيء» (@)(@@) وقال محمد بن إسماعيل: قال أحمد بن حنبل: (@)(@@) @MATN@ «ليث لا يفرح بحديثه، كان ليث يرفع أشياء لا يرفعها غيره فلذلك ضعفوه» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٢ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا 
ms890	 حماد بن سلمة، عن عبد الله بن شداد الأعرج، عن أبي عذرة - وكان قد أدرك النبي صلى الله عليه وسلم - عن عائشة، أن النبي صلى الله عليه وسلم نهى الرجال والنساء عن الحمامات ثم رخص للرجال في الميازر. PageV05P113 هذا حديث لا نعرفه إلا من حديث حماد بن سلمة وإسناده ليس بذاك القائم (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٣ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود قال: حدثنا شعبة، عن منصور، قال: سمعت سالم بن أبي الجعد، يحدث عن أبي المليح الهذلي، أن نساء من أهل حمص، أو من أهل الشام دخلن على عائشة، فقالت: أنتن اللاتي يدخلن نساؤكن الحمامات؟ سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «ما من امرأة تضع ثيابها في غير بيت زوجها إلا هتكت الستر بينها وبين ربها» : (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء أن الملائكة لا تدخل بيتا فيه صورة ولا كلب (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٤ - (@)(@@) حدثنا سلمة بن شبيب، والحسن بن علي الخلال، وعبد بن حميد، وغير واحد واللفظ للحسن بن علي، قالوا: حدثنا عبد الرزاق قال: أخبرنا معمر، عن الزهري، عن عبيد الله بن عبد الله بن عتبة، أنه سمع ابن عباس، يقول: سمعت أبا طلحة، يقول: سمعت رسول الله صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «لا تدخل الملائكة بيتا فيه كلب ولا صورة تماثيل» : (@)(@@) @MATN@ «هذا حديث صحيح» (@)(@@) (@)PageV05P114 (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٥ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا روح بن عبادة قال: حدثنا مالك بن أنس، عن إسحاق بن عبد الله بن أبي طلحة، أن رافع بن إسحاق، أخبره قال: دخلت أنا وعبد الله بن أبي طلحة، على أبي سعيد الخدري نعوده، فقال أبو سعيد: أخبرنا رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «أن الملائكة لا تدخل بيتا فيه تماثيل، أو صورة» (@)(@@) شك إسحاق لا يدري أيهما قال،: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٦ - (@)(@@) حدثنا سويد قال: أخبرنا عبد الله بن المبارك قال: أخبرنا يونس بن أبي إسحاق قال: حدثنا مجاهد، قال: حدثنا أبو هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ " أتاني جبريل فقال: 
ms891	 إني كنت أتيتك البارحة فلم يمنعني أن أكون دخلت عليك البيت الذي كنت فيه إلا أنه كان في باب البيت تمثال الرجال، وكان في البيت قرام ستر فيه تماثيل، وكان في البيت كلب، فمر برأس التمثال الذي بالباب فليقطع فليصير كهيئة الشجرة، ومر بالستر فليقطع ويجعل منه وسادتين منتبذتين توطآن، ومر بالكلب فيخرج " ، ففعل رسول الله صلى الله عليه وسلم وكان ذلك الكلب جروا للحسن أو الحسين تحت نضد له فأمر به فأخرج: " هذا حديث حسن وفي الباب عن عائشة (@)PageV05P115 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية لبس المعصفر للرجل والقسي (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٧ - (@)(@@) حدثنا عباس بن محمد البغدادي قال: حدثنا إسحاق بن منصور قال: أخبرنا إسرائيل، عن أبي يحيى، عن مجاهد، عن عبد الله بن عمرو، قال: (@)(@@) @MATN@ «مر رجل وعليه ثوبان أحمران فسلم على النبي صلى الله عليه وسلم فلم يرد النبي صلى الله عليه وسلم عليه» : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه، ومعنى هذا الحديث عند أهل العلم أنهم كرهوا لبس المعصفر، ورأوا أن ما صبغ بالحمرة بالمدر أو غير ذلك، فلا بأس به إذا لم يكن معصفرا» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٨ - (@)(@@) حدثنا قتيبة قال: حدثنا أبو الأحوص، عن أبي إسحاق، عن هبيرة بن يريم، قال: قال علي: (@)(@@) @MATN@ «نهى رسول الله صلى الله عليه وسلم عن خاتم الذهب وعن القسي وعن الميثرة وعن الجعة» (@)(@@) قال أبو الأحوص: (@)(@@) @MATN@ «وهو شراب يتخذ بمصر من الشعير» (@)(@@) هذا حديث حسن صحيح " (@)PageV05P116 (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٠٩ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا محمد بن جعفر، وعبد الرحمن بن مهدي، قالا: حدثنا شعبة، عن الأشعث بن سليم، عن معاوية بن سويد بن مقرن، عن البراء بن عازب، قال: (@)(@@) @MATN@ «أمرنا رسول الله صلى الله عليه وسلم بسبع ونهانا عن سبع، أمرنا باتباع الجنازة، وعيادة المريض، وتشميت العاطس، وإجابة الداعي، ونصر المظلوم، وإبرار المقسم، ورد السلام، ونهانا عن سبع، عن خاتم الذهب، أو حلقة الذهب، وآنية الفضة، ولبس الحرير والديباج، والإستبرق، والقسي» . (@)(@@) هذا حديث حسن صحيح، وأشعث بن سليم هو: أشعث بن أبي الشعثاء، وأبو 
ms892	 الشعثاء اسمه سليم بن الأسود (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في لبس البياض (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٠ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا سفيان، عن حبيب بن أبي ثابت، عن ميمون بن أبي شبيب، عن سمرة بن جندب، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «البسوا البياض فإنها أطهر وأطيب، وكفنوا فيها موتاكم» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وفي الباب عن ابن عباس، وابن عمر (@)PageV05P117 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الرخصة في لبس الحمرة للرجال (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١١ - (@)(@@) حدثنا هناد قال: حدثنا عبثر بن القاسم، عن الأشعث وهو ابن سوار، عن أبي إسحاق، عن جابر بن سمرة، قال: (@)(@@) @MATN@ «رأيت رسول الله صلى الله عليه وسلم في ليلة إضحيان، فجعلت أنظر إلى رسول الله صلى الله عليه وسلم وإلى القمر وعليه حلة حمراء، فإذا هو عندي أحسن من القمر» : (@)(@@) @MATN@ «هذا حديث حسن غريب لا نعرفه إلا من حديث الأشعث» (@)(@@) (@)(@) (@)(@@) وروى شعبة، والثوري، عن أبي إسحاق، عن البراء بن عازب، قال: (@)(@@) @MATN@ «رأيت على رسول الله صلى الله عليه وسلم حلة حمراء» (@)(@@) حدثنا بذلك محمود بن غيلان قال: حدثنا وكيع قال: حدثنا سفيان، عن أبي إسحاق، ح، وحدثنا محمد بن بشار قال: حدثنا محمد بن جعفر قال: حدثنا شعبة، عن أبي إسحاق، بهذا (@)(@@) @MATN@ «وفي الحديث كلام أكثر من هذا» (@)(@@) سألت محمدا، قلت له: حديث أبي إسحاق، عن البراء أصح أم حديثه عن جابر بن سمرة؟ فرأى كلا الحديثين صحيحا " وفي الباب عن البراء، وأبي جحيفة (@)PageV05P118 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الثوب الأخضر (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٢ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا عبد الرحمن بن مهدي قال: حدثنا عبيد الله بن إياد بن لقيط، عن أبيه، عن أبي رمثة، قال: (@)(@@) @MATN@ «رأيت رسول الله صلى الله عليه وسلم وعليه بردان أخضران» : (@)(@@) @MATN@ " هذا حديث حسن غريب لا نعرفه إلا من حديث عبيد الله بن إياد، وأبو رمثة التيمي اسمه: حبيب بن حيان، ويقال اسمه: رفاعة بن يثربي " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الثوب الأسود (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٣ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا يحيى 
ms893	 بن زكريا بن أبي زائدة قال: أخبرني أبي، عن مصعب بن شيبة، عن صفية بنت شيبة، عن عائشة، قالت: (@)(@@) @MATN@ «خرج النبي صلى الله عليه وسلم ذات غداة وعليه مرط من شعر أسود» : (@)(@@) @MATN@ «هذا حديث حسن غريب صحيح» (@)(@@) (@)PageV05P119 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الثوب الأصفر (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٤ - (@)(@@) حدثنا عبد بن حميد قال: حدثنا عفان بن مسلم الصفار أبو عثمان قال: حدثنا عبد الله بن حسان، أنه حدثته جدتاه صفية بنت عليبة، ودحيبة بنت عليبة، حدثتاه، عن قيلة بنت مخرمة - وكانتا ربيبتيها، وقيلة جدة أبيهما أم أمه - أنها قالت: قدمنا على رسول الله صلى الله عليه وسلم، فذكرت الحديث بطوله، حتى جاء رجل وقد ارتفعت الشمس فقال: السلام عليك يا رسول الله، فقال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «وعليك السلام ورحمة الله» (@)(@@) وعليه - تعني النبي صلى الله عليه وسلم - أسمال مليتين كانتا بزعفران وقد نفضتا ومع النبي صلى الله عليه وسلم عسيب نخلة: (@)(@@) @MATN@ «حديث قيلة لا نعرفه إلا من حديث عبد الله بن حسان» (@)(@@) (@)PageV05P120 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية التزعفر والخلوق للرجال (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٥ - (@)(@@) حدثنا قتيبة قال: حدثنا حماد بن زيد، ح وحدثنا إسحاق بن منصور قال: حدثنا عبد الرحمن بن مهدي، عن حماد بن زيد، عن عبد العزيز بن صهيب، عن أنس بن مالك، قال: (@)(@@) @MATN@ «نهى رسول الله صلى الله عليه وسلم عن التزعفر للرجال» : (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@) وروى شعبة، هذا الحديث عن إسماعيل ابن علية، عن عبد العزيز بن صهيب، عن أنس، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم نهى عن التزعفر» (@)(@@) حدثنا بذلك عبد الله بن عبد الرحمن قال: حدثنا آدم، عن شعبة،: (@)(@@) @MATN@ " ومعنى كراهية التزعفر للرجال: أن يتزعفر الرجل، يعني أن يتطيب به " (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٦ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود الطيالسي، عن شعبة، عن عطاء بن السائب، قال: سمعت أبا حفص بن عمر، يحدث، عن يعلى بن مرة، أن النبي صلى الله عليه وسلم أبصر رجلا متخلقا قال: (@)(@@) @MATN@ «اذهب فاغسله، ثم اغسله ثم لا تعد» : (@)(@@) PageV05P121 (@)(@@) @MATN@ " هذا حديث حسن، 
ms894	 وقد اختلف بعضهم في هذا الإسناد عن عطاء بن السائب، قال علي: قال يحيى بن سعيد: من سمع من عطاء بن السائب قديما فسماعه صحيح، وسماع شعبة وسفيان من عطاء بن السائب صحيح إلا حديثين عن عطاء بن السائب، عن زاذان، قال شعبة: سمعتهما منه بآخرة " : (@)(@@) @MATN@ " يقال: إن عطاء بن السائب كان في آخر أمره قد ساء حفظه (@)(@@) @MATN@ «وفي الباب عن عمار، وأبي موسى، وأنس» (@)(@@) وأبو حفص هو: أبو حفص بن عمر " (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية الحرير والديباج (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٧ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا إسحاق بن يوسف الأزرق قال: حدثنا عبد الملك بن أبي سليمان قال: حدثني مولى أسماء، عن ابن عمر، قال: سمعت عمر، يذكر أن النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «من لبس الحرير في الدنيا لم يلبسه في الآخرة» (@)(@@) وفي الباب عن علي، وحذيفة، وأنس وغير واحد وقد ذكرناه في أبواب اللباس. PageV05P122 هذا حديث حسن صحيح قد روي من غير وجه عن عمر. ومولى أسماء بنت أبي بكر الصديق اسمه: عبد الله ويكنى أبا عمر. وقد روى عنه عطاء بن أبي رباح، وعمرو بن دينار (@) (@)(@) (@)(@@)(@@)(@@) || باب (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٨ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن أبي مليكة، عن المسور بن مخرمة، أن رسول الله صلى الله عليه وسلم قسم أقبية ولم يعط مخرمة شيئا، فقال مخرمة: يا بني انطلق بنا إلى رسول الله صلى الله عليه وسلم، فانطلقت معه قال: ادخل فادعه لي، فدعوته له، فخرج النبي صلى الله عليه وسلم وعليه قباء منها فقال: (@)(@@) @MATN@ «خبأت لك هذا» ، (@)(@@) قال: فنظر إليه فقال: (@)(@@) @MATN@ «رضي مخرمة» : (@)(@@) @MATN@ " هذا حديث حسن صحيح، وابن أبي مليكة اسمه: عبد الله بن عبيد الله بن أبي مليكة " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء إن الله تعالى يحب أن يرى أثر نعمته على عبده (@)(@) (@)(@@)(@@)(@@) ||| ٢٨١٩ - (@)(@@) حدثنا الحسن بن محمد الزعفراني قال: حدثنا عفان بن مسلم قال: حدثنا همام، عن قتادة، عن عمرو بن شعيب، عن أبيه، عن جده، PageV05P123 قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن 
ms895	 الله يحب أن يرى أثر نعمته على عبده» (@)(@@) وفي الباب عن أبي الأحوص، عن أبيه، وعمران بن حصين، وابن مسعود: (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) (@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الخف الأسود (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٠ - (@)(@@) حدثنا هناد قال: حدثنا وكيع، عن دلهم بن صالح، عن حجير بن عبد الله، عن ابن بريدة، عن أبيه، (@)(@@) @MATN@ «أن النجاشي أهدى إلى النبي صلى الله عليه وسلم خفين أسودين ساذجين فلبسهما ثم توضأ ومسح عليهما» (@)(@@) هذا حديث حسن، إنما نعرفه من حديث دلهم " وقد رواه محمد بن ربيعة، عن دلهم (@)PageV05P124 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في النهي عن نتف الشيب (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢١ - (@)(@@) حدثنا هارون بن إسحاق الهمداني قال: حدثنا عبدة، عن محمد بن إسحاق، عن عمرو بن شعيب، عن أبيه، عن جده، أن النبي صلى الله عليه وسلم نهى عن نتف الشيب، وقال: (@)(@@) @MATN@ «إنه نور المسلم» (@)(@@) هذا حديث حسن " قد روي عن عبد الرحمن بن الحارث، وغير واحد عن عمرو بن شعيب (@)(@) (@)(@@)(@@)(@@) || باب أن المستشار مؤتمن (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٢ - (@)(@@) حدثنا أحمد بن منيع قال: حدثنا الحسن بن موسى قال: حدثنا شيبان، عن عبد الملك بن عمير، عن أبي سلمة بن عبد الرحمن، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «المستشار مؤتمن» . (@)(@@) @MATN@ «هذا حديث حسن، وقد روى غير واحد عن شيبان بن عبد الرحمن النحوي، وشيبان هو صاحب كتاب وهو صحيح الحديث، ويكنى أبا معاوية» (@)(@@) (@)(@) (@)(@@) حدثنا عبد الجبار بن العلاء العطار، عن سفيان بن عيينة، قال: قال عبد الملك بن عمير، (@)(@@) @MATN@ «إني لأحدث الحديث فما أخرم منه حرفا» (@)(@@) (@)PageV05P125 (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٣ - (@)(@@) حدثنا أبو كريب قال: حدثنا وكيع، عن داود بن أبي عبد الله، عن ابن جدعان، عن جدته، عن أم سلمة، قالت: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «المستشار مؤتمن» (@)(@@) وفي الباب عن ابن مسعود، وأبي هريرة، وابن عمر: (@)(@@) @MATN@ «هذا حديث غريب من حديث أم سلمة» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في الشؤم (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٤ - (@)(@@) حدثنا ابن أبي عمر قال: حدثنا سفيان، عن الزهري، عن سالم، وحمزة، ابني عبد الله بن عمر عن أبيهما، أن 
ms896	 رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ «الشؤم في ثلاثة، في المرأة، والمسكن، والدابة» : " (@)(@@) هذا حديث حسن صحيح وبعض أصحاب الزهري لا يذكرون فيه عن حمزة إنما يقولون: عن سالم، عن أبيه، عن النبي صلى الله عليه وسلم. وروى مالك بن أنس هذا الحديث عن الزهري، فقال: عن سالم، وحمزة، ابني عبد الله بن عمر، عن أبيهما. وهكذا روى لنا ابن أبي عمر، هذا الحديث عن سفيان بن عيينة، عن الزهري، عن سالم، وحمزة، ابني عبد الله بن عمر، عن أبيهما، عن النبي صلى الله عليه وسلم، PageV05P126 حدثنا سعيد بن عبد الرحمن قال: حدثنا سفيان، عن الزهري، عن سالم، عن أبيه، عن النبي صلى الله عليه وسلم بنحوه، ولم يذكر فيه سعيد بن عبد الرحمن، عن حمزة، ورواية سعيد أصح، لأن علي بن المديني والحميدي رويا عن سفيان، عن الزهري، عن سالم، عن أبيه، وذكرا عن سفيان قال: لم يرو لنا الزهري هذا الحديث إلا عن سالم عن ابن عمر وروى مالك، هذا الحديث عن الزهري، وقال: عن سالم، وحمزة، ابني عبد الله بن عمر، عن أبيهما، وفي الباب عن سهل بن سعد، وعائشة، وأنس وقد روي عن النبي صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «إن كان الشؤم في شيء ففي المرأة والدابة والمسكن» (@)(@@) (@) (@)(@) (@)(@@) وقد روي عن حكيم بن معاوية، قال: سمعت النبي صلى الله عليه وسلم يقول: (@)(@@) @MATN@ «لا شؤم، وقد يكون اليمن في الدار والمرأة والفرس» (@)(@@) حدثنا بذلك علي بن حجر قال: حدثنا إسماعيل بن عياش، عن سليمان بن سليم، عن يحيى بن جابر الطائي، عن معاوية بن حكيم، عن عمه حكيم بن معاوية، عن النبي صلى الله عليه وسلم بهذا (@)PageV05P127 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء لا يتناجى اثنان دون ثالث (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٥ - (@)(@@) حدثنا هناد، قال: حدثنا أبو معاوية، عن الأعمش، ح وحدثني ابن أبي عمر قال: حدثنا سفيان، عن الأعمش، عن شقيق، عن عبد الله، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إذا كنتم ثلاثة فلا يتناجى اثنان دون صاحبهما» 
ms897	 (@)(@@) وقال سفيان، في حديثه: (@)(@@) @MATN@ «لا يتناجى اثنان دون الثالث، فإن ذلك يحزنه» ،: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) وقد روي عن النبي صلى الله عليه وسلم أنه قال: (@)(@@) @MATN@ «لا يتناجى اثنان دون واحد، فإن ذلك يؤذي المؤمن، والله عز وجل يكره أذى المؤمن» (@)(@@) وفي الباب عن ابن عمر، وأبي هريرة، وابن عباس (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في العدة (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٦ - (@)(@@) حدثنا واصل بن عبد الأعلى الكوفي قال: حدثنا محمد بن فضيل، عن إسماعيل بن أبي خالد، عن أبي جحيفة، قال: (@)(@@) @MATN@ «رأيت PageV05P128 رسول الله صلى الله عليه وسلم أبيض قد شاب، وكان الحسن بن علي يشبهه، وأمر لنا بثلاثة عشر قلوصا فذهبنا نقبضها فأتانا موته فلم يعطونا شيئا» ، (@)(@@) فلما قام أبو بكر قال: من كانت له عند رسول الله صلى الله عليه وسلم عدة فليجئ، فقمت إليه فأخبرته، فأمر لنا بها: (@)(@@) @MATN@ «هذا حديث حسن» (@)(@@) وقد روى مروان بن معاوية، هذا الحديث بإسناد له عن أبي جحيفة، نحو هذا وقد روى غير واحد عن إسماعيل بن أبي خالد، عن أبي جحيفة، قال: (@)(@@) @MATN@ «رأيت النبي صلى الله عليه وسلم وكان الحسن بن علي يشبهه» (@)(@@) ولم يزيدوا على هذا " (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٧ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا يحيى بن سعيد، عن إسماعيل بن أبي خالد قال: حدثنا أبو جحيفة، قال: (@)(@@) @MATN@ «رأيت النبي صلى الله عليه وسلم وكان الحسن بن علي يشبهه» . (@)(@@) وهكذا روى غير واحد عن إسماعيل بن أبي خالد نحو هذا. وأبو جحيفة اسمه: وهب السوائي. وفي الباب عن جابر (@)PageV05P129 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في فداك أبي وأمي (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٨ - (@)(@@) حدثنا إبراهيم بن سعيد الجوهري قال: حدثنا سفيان بن عيينة، عن يحيى بن سعيد، عن سعيد بن المسيب، عن علي، قال: (@)(@@) @MATN@ «ما سمعت النبي صلى الله عليه وسلم جمع أبويه لأحد غير سعد بن أبي وقاص» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٢٩ - (@)(@@) حدثنا الحسن بن الصباح البزار قال: حدثنا سفيان، عن ابن جدعان، ويحيى بن سعيد، سمعا سعيد بن المسيب، يقول: قال علي: ما جمع رسول الله صلى الله عليه وسلم أباه وأمه لأحد إلا 
ms898	 لسعد بن أبي وقاص، قال له يوم أحد: (@)(@@) @MATN@ «ارم فداك أبي وأمي» ، (@)(@@) وقال له: (@)(@@) @MATN@ «ارم أيها الغلام الحزور» (@)(@@) وفي الباب عن الزبير، وجابر: (@)(@@) @MATN@ «هذا حديث حسن صحيح، وقد روي من غير وجه عن علي» (@)(@@) (@)(@) (@)(@@) وقد روى غير واحد، هذا الحديث عن يحيى بن سعيد، عن سعيد بن المسيب، عن سعد بن أبي وقاص، قال: جمع لي رسول الله صلى الله عليه وسلم أبويه يوم أحد قال: (@)(@@) @MATN@ «ارم فداك أبي وأمي» (@)(@@) (@)PageV05P130 (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٠ - (@)(@@) حدثنا بذلك قتيبة قال: حدثنا الليث بن سعد، وعبد العزيز بن محمد، عن يحيى بن سعيد، عن سعيد بن المسيب، عن سعد بن أبي وقاص، قال: (@)(@@) @MATN@ «جمع لي رسول الله صلى الله عليه وسلم أبويه يوم أحد» (@)(@@) وهذا حديث صحيح " (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في يا بني (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣١ - (@)(@@) حدثنا محمد بن عبد الملك بن أبي الشوارب قال: حدثنا أبو عوانة قال: حدثنا أبو عثمان شيخ له، عن أنس، أن النبي صلى الله عليه وسلم قال له: (@)(@@) @MATN@ «يا بني» (@)(@@) وفي الباب عن المغيرة، وعمر بن أبي سلمة: (@)(@@) @MATN@ " هذا حديث حسن صحيح غريب من هذا الوجه، وقد روي من غير هذا الوجه عن أنس. وأبو عثمان هذا شيخ ثقة وهو: الجعد بن عثمان، ويقال: ابن دينار وهو بصري، وقد روى عنه يونس بن عبيد، وغير واحد من الأئمة " (@)PageV05P131 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في تعجيل اسم المولود (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٢ - (@)(@@) حدثنا عبيد الله بن سعد بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف قال: حدثني عمي يعقوب بن إبراهيم قال: حدثنا شريك، عن محمد بن إسحاق، عن عمرو بن شعيب، عن أبيه، عن جده، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم أمر بتسمية المولود يوم سابعه ووضع الأذى عنه والعق» : (@)(@@) @MATN@ «هذا حديث حسن غريب» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء ما يستحب من الأسماء (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٣ - (@)(@@) حدثنا عبد الرحمن بن الأسود أبو عمرو الوراق البصري قال: حدثنا معمر بن سليمان الرقي، عن علي بن صالح، عن عبد الله بن عثمان، عن نافع، عن ابن عمر، عن النبي صلى 
ms899	 الله عليه وسلم قال: (@)(@@) @MATN@ «أحب الأسماء إلى الله عبد الله وعبد الرحمن» : (@)(@@) @MATN@ «هذا حديث حسن غريب من هذا الوجه» (@)(@@) (@)PageV05P132 (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٤ - (@)(@@) حدثنا عقبة بن مكرم العمي البصري قال: حدثنا أبو عاصم، عن عبد الله بن عمر العمري، عن نافع، عن ابن عمر، قال: قال النبي صلى الله عليه وسلم: (@)(@@) @MATN@ «إن أحب الأسماء إلى الله عبد الله وعبد الرحمن» (@)(@@) هذا حديث غريب من هذا الوجه " (@)(@) (@)(@@)(@@)(@@) || باب ما يكره من الأسماء (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٥ - (@)(@@) حدثنا محمد بن بشار قال: حدثنا أبو أحمد قال: حدثنا سفيان، عن أبي الزبير، عن جابر، عن عمر بن الخطاب، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «لأنهين أن يسمى رافع وبركة ويسار» : (@)(@@) @MATN@ «هذا حديث غريب» (@)(@@) هكذا رواه أبو أحمد، عن سفيان، عن أبي الزبير، عن جابر، عن عمر، ورواه غيره عن سفيان، عن أبي الزبير، عن جابر، عن النبي صلى الله عليه وسلم (@)(@@) @MATN@ «وأبو أحمد ثقة حافظ، والمشهور عند الناس هذا الحديث عن جابر عن النبي صلى الله عليه وسلم وليس فيه عن عمر» (@)(@@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٦ - (@)(@@) حدثنا محمود بن غيلان قال: حدثنا أبو داود، عن شعبة، عن منصور، عن هلال بن يساف، عن الربيع بن عميلة الفزاري، عن سمرة بن جندب، أن رسول الله صلى الله عليه وسلم قال: (@)(@@) @MATN@ " لا تسمي غلامك رباح ولا أفلح ولا يسار ولا نجيح. يقال: أثم هو؟ فيقال: لا " . PageV05P133 هذا حديث حسن صحيح (@) (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٧ - (@)(@@) حدثنا محمد بن ميمون المكي قال: حدثنا سفيان، عن أبي الزناد، عن الأعرج، عن أبي هريرة، يبلغ به النبي صلى الله عليه وسلم قال: (@)(@@) @MATN@ «أخنع اسم عند الله يوم القيامة رجل تسمى بملك الأملاك» (@)(@@) قال سفيان: " شاهان شاه، وأخنع: يعني وأقبح (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في تغيير الأسماء (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٨ - (@)(@@) حدثنا يعقوب بن إبراهيم الدورقي، وأبو بكر محمد بن بشار وغير واحد، قالوا: حدثنا يحيى بن سعيد القطان، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، أن النبي صلى الله عليه وسلم غير اسم عاصية وقال: (@)(@@) @MATN@ «أنت 
ms900	 جميلة» : (@)(@@) @MATN@ «هذا حديث حسن غريب، وإنما أسنده يحيى بن سعيد القطان، عن عبيد الله، عن نافع، عن ابن عمر» (@)(@@) وروى بعضهم هذا عن عبيد الله، عن نافع، أن عمر، (@)(@@) @MATN@ «مرسلا» (@)(@@) وفي الباب عن عبد الرحمن بن عوف، وعبد الله بن سلام، وعبد الله بن مطيع، وعائشة، والحكم بن سعيد، ومسلم، وأسامة بن أخدري، وشريح بن هانئ، عن أبيه، وخيثمة بن عبد الرحمن، عن أبيه (@)PageV05P134 (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٣٩ - (@)(@@) حدثنا أبو بكر بن نافع البصري قال: حدثنا عمر بن علي المقدمي، عن هشام بن عروة، عن أبيه، عن عائشة، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم كان يغير الاسم القبيح» (@)(@@) قال أبو بكر: وربما قال عمر بن علي، في هذا الحديث: هشام بن عروة، عن أبيه، عن النبي صلى الله عليه وسلم، (@)(@@) @MATN@ «مرسلا ولم يذكر فيه عن عائشة» (@)(@@) (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في أسماء النبي صلى الله عليه وسلم (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٤٠ - (@)(@@) حدثنا سعيد بن عبد الرحمن المخزومي قال: حدثنا سفيان، عن الزهري، عن محمد بن جبير بن مطعم، عن أبيه، قال: قال رسول الله صلى الله عليه وسلم: (@)(@@) @MATN@ «إن لي أسماء، أنا محمد، وأنا أحمد، وأنا الماحي الذي يمحو الله بي الكفر، وأنا الحاشر الذي يحشر الناس على قدمي، وأنا العاقب الذي ليس بعدي نبي» (@)(@@) وفي الباب عن حذيفة: (@)(@@) @MATN@ «هذا حديث حسن صحيح» (@)(@@) (@)PageV05P135 (@)(@) (@)(@@)(@@)(@@) || باب ما جاء في كراهية الجمع بين اسم النبي صلى الله عليه وسلم وكنيته (@)(@) (@)(@@)(@@)(@@) ||| ٢٨٤١ - (@)(@@) حدثنا قتيبة قال: حدثنا الليث، عن ابن عجلان، عن أبيه، عن أبي هريرة، (@)(@@) @MATN@ «أن النبي صلى الله عليه وسلم نهى أن يجمع أحد بين اسمه وكنيته، ويسمي محمدا أبا القاسم» (@)(@@) وفي الباب عن جابر: (@)(@@) @MATN@ «هذا حديث حسن صحيح، وقد كره بعض أهل العلم أن يجمع الرجل بين اسم النبي صلى الله عليه وسلم وكنيته، وقد فعل ذلك بعضهم» (@)(@@) (@)(@) (@)(@@) روي عن النبي صلى الله عليه وسلم أنه سمع رجلا في السوق ينادي يا أبا القاسم، فالتفت النبي صلى الله عليه وسلم، فقال: لم أعنك، فقال النبي صلى الله عليه وسلم: 