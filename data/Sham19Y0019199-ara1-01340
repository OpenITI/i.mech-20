ms1323	 [ينسب]:(@)(@)(@@)(@@)(@@) ||| AUTO 7913 - أبو عبد الله محمد بن عبد الله بن مسبح بن عبد الرحمن المقرئ(@)(@)(@@) (¬7).(@)(@)PageV05P187(@)(@)(@@)(@@)(@@) ||| CHECK 7915 - والشاعر الثاني طرابزوني يدعى رمضان أفندي(@)(@)(@@)(@@)(@@) ||| CHECK 7914 - أولهما من فئة الكتاب(@)(@)(@@) الفطري: [نسبة] إلى الفطريين موالي بني مخزوم (¬1).(@)(@@) الفغانديزي: [نسبة] فغانديزه قرية ببخارى (¬2).(@)(@@) فغاني: [فغان كلمة فارسية بمعنى البكاء والنحيب والياء للنسبة، وهي مخلص شاعرين عثمانيين عاشا في القرن العاشر الهجري،(@)(@)(@@) 7914 - • أولهما من فئة الكتاب فكان يقوم بمهمة الكتابة لدى الأمير عبد الله أحد أبناء السلطان بايزيد خان الثاني، وبعد وفاة الأمير المذكور وشى به خصومه فتم إعدامه. له منظومة باسم "اسكندرنامه" على وزن شهنامة الفردوسي لكنها ليست مشهورة، وأشعاره متوسطة.(@)(@@) 7915 - • والشاعر الثاني طرابزوني يدعى رمضان أفندي، وفد على إستانبول وانتسب إلى اسكندر جلبى، لكن منافسيه خوفا من الصدام مع الصدر الأعظم إبراهيم باشا نفسه تجاسروا على الوشاية به والافتراء عليه لدى الباشا فصاغوا بيتا من الشعر ملفقا فيه هجاء وقالوا له إن صاحب الترجمة هو الذين قاله، فكانت النتيجة أن حرم الشاعر لذة الحياة في سن الشباب] (¬3).(@)(@@) الفغديزي: [نسبة] إلى فغديز، قرية ببخارى (¬4).(@)(@@) الفغديني: [نسبة] إلى فغدين، قرية ببخارى (¬5).(@)(@@) الفغشتي: [نسبة] إلى فغشت جد (¬6).(@)(@@) الفغفور: من ملك الهند، جمعه فغافرة، كذا قيل (¬7).(@)(@@) الفغيدزي: [نسبة] إلى فغيدزة، محلة بسمرقند (¬8).(@)(@@) الفغيطوسيني: [نسبة] إلى فغيطوسين، قرية ببخارى (¬9).(@)(@@) الفقاعي: [نسبة] إلى بيع الفقاع (¬10).(@)(@)PageV05P188(@)(@)(@@)(@@)(@@) ||| CHECK 7918 - سالم بن عبد الله بن عمر(@)(@)(@@)(@@)(@@) ||| CHECK 7917 - وعبيد الله [بن عبد الله] بن عتبة بن مسعود(@)(@)(@@)(@@)(@@) ||| CHECK 7916 - أبو عثمان يزيد بن صهيب الكوفي ثم المكي(@)(@)(@@) الفقيري: [نسبة] إلى الفقير جد (¬1) والفقير هو:(@)(@)(@@) 7916 - • أبو عثمان يزيد بن صهيب الكوفي ثم المكي مات ....... قيل له الفقير لأنه أصيب في فقار ظهره فكان يألم منه حتى كان ينحني له، لا أنه كان فقيرا.(@)(@@) الفقيمي: [نسبة] إلى فقيم، بطن من تميم (¬2).(@)(@@) الفقيه: [نسبة] إلى الفقه و