ms572	 بی‌حشیشی‌سنگ‌محنت در تساخینش(@)(@@) 94 چو جوکی موی‌سر انبوه‌و ناخنهای‌دست و پا %~% دراز و زفت و ناهنجار چون بیل دهاقینش(@)(@@) 95 اگر لاحول پاس من نبودی حافظ و حارس %~% ز شب تا چاشتگه نهمار گادندی شیاطینش(@)(@@) 96 به‌من چون‌دیو در ریمن ولی‌من‌از ش‌ش ایمن %~% بلی چون مهر نورانی‌کرا یارای تبطینش(@)(@@) 97 نهانی خواجه با او رام چونان نفس با شهوت %~% ولی‌وحشت‌ز من چون معده از حب‌السلاطینش(@)(@@) 98 ضرورت را بریدم زوکه تا در عرصه محشر %~% بپیوندم ابا پیغمبر و آل میامینش(@)(@@) 99 خلاف امر یزدان بود و شرع پاک پیغمبر %~% رضای‌ خواجه‌ای‌ چو نان که‌ چونین زسم و آیینش(@)(@@) 100 گرفتم خواجه‌ کوثر بود کوثر ناگوار آید %~% چو آمیزش به‌ غساقش چو آلایش به‌ غسلینش(@)(@@) 101 ازین پس مادح پیغمبر و دارای دورانم %~% که ستوار ست پغمبر ز دارا ملت و دینش(@)(@@) 102 الا تا آب نبود کار جز ترطیب و تبریدش %~% الا تا نار نبود فعل جز تجفیف و تسخینش(@)(@@) 103 ملک پیوسته با چرخ برین انباز اورنگش %~% کیان همواره با مهر فلک همراز گرزینش PageV1P281(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چه ماه بود که از خانه کرد طلوع %~% که کرد از پی تعظیمش آفتاب رکوع(@)(@@) 2 به چشم صورت و معنی توان مشاهده کرد %~% کمال قدرت صانع در اینچنین مصنوع(@)(@@) 3 مرا ز هرچه در آفاق طبع مستغنی است %~% ولی به عشق تو چون تشنه‌ام به آب ولوع(@)(@@) 4 ولوع تشنه به آب ارچه اختیاری نیست %~% مرا به عشق‌ تو اینک به اختیار ولوع(@)(@@) 5 ترا لبی است چو چشم بخیل تنگ و مرا %~% برو دو چشم بخیلی نمی‌کند ز دموع(@)(@@) 6 عنان سیل توانیم تافتن به شکیب %~% عنان ‌گریه نیاریم تافتن ز هموع(@)(@@) 7 علاج هرچه در آفاق ممکن است ولی %~% علاج چشمه چشمم نمی‌شود ز نبوع(@)(@@) 8 نظر ز صید غزالان دشت عشق بپوش %~% اذا الخوادر فیها عن المهاه تروع(@)(@@) 9 شمیم عنبر از آن زلف مشکبیز آید %~% به عنبرین‌ 
ms573	 خطش آن زلف شد مگر مشموع(@)(@@) 10 اذا اراک یغنی الفواد من طرب %~% کان حمامه بان علی الاراک سجوع(@)(@@) 11 کند دو چشم تو با ما به جای ناز نیاز %~% بلی ز مست نباشد عجب خضوع و خشوع(@)(@@) 12 چه معجز است ندانم به زلف مفتولت %~% که خاطرم ز پریشانیش بود مجموع(@)(@@) 13 چه شد که فتنه بیدار چشم فتانت %~% به عهد خسرو آفاق کرده قصد هجوع(@)(@@) 14 زمین و هرکه بر او خادمند و او مخدوم %~% جهان و هرچه در او تابع‌اند و او متبوع(@)(@@) 15 به شکل عقرب جراره‌ایست شمشیرش %~% که جان نمی‌برد از زهر قهر او ملسوع(@)(@@) 16 بود به دعوی آجال حجتی قاطع %~% ولیک رشته آمال خصم ازو مقطوع(@)(@@) 17 درون عالم امکان وجود کامل او %~% چنان غریب نماید که دل درون ضلوع(@)(@@) 18 خیال سطوت او خصم را بدرد دل %~% به حیرتم‌که چه بر خصم می‌رود ز وقوع(@)(@@) 19 ز چین ابروی قهرش عدو کند فریاد %~% بر ‌آن صفت‌ که ز دیدار ماه نو مصروع(@)(@@) 20 بود به دهر ز هر عصر عصر او ممتاز %~% چغان‌ که عید ز ایام و جمعه از اسبوع(@)(@@) 21 اگر چه از سخط روزگار دون‌پرور %~% سواد دیده ی حق‌بین او بود مفلوع(@)(@@) 22 ولی هنوز ز بیم زبان خنجر او %~% به وقت وقعه رود رود خون ز چشم دروع(@)(@@) 23 بصیرتیست مر او را به چشم سر که بر او %~% نهفته نیست یکی نکته از اصول و فروع(@)(@@) 24 سخنوران سپس مدحت خدا و رسول %~% به نام ناهی او نامه را کنند شروع(@)(@@) 25 به حلم و همت او کوه و کان قرین نکنم %~% که هیچ عذر نباشد درین خطا مسموع(@)(@@) 26 به‌ کوه قاف برابر چسان ‌نهم قیراط %~% به بحر ژرف مقابل چسان نکن بنبوع(@)(@@) 27 زهی ملک سیری‌ کز کمال قوت نفس %~% چو سالکان مجرد گرفته پیشه قنوع(@)(@@) 28 زبان به وصف تو قاصر چو در بهار 
ms574	 نهار %~% جهان ز عدل تو خرم چو در ربیع ربوع(@)(@@) 29 چو خصم فاعل‌کین توگشت رفعش‌کن %~% به حکم قاعده‌ کل فاعل مرفوع(@)(@@) 30 نیاز نیست به تعریف جود دست ترا %~% که خود معرف حودگشته ازکمال شیوع(@)(@@) 31 شهان ملک سخن را به حضرت تو نیاز %~% مهان بزم هنر را به دانش تو بخوع(@)(@@) 32 ز هرکرانه به‌کاخ تو کرده‌اند نزول %~% ز هرکناره به قصر تو جسته‌اند هبوع(@)(@@) 33 بزرگوارا دارم طمع‌ که برهاند %~% عنایت توام از کید روزگار خدوع(@)(@@) 34 تو دانی اینکه بزرگان این دیار از شعر %~% چنان رمند که زاهد ز فعل نامشروع(@)(@@) 35 به خاکپای عزیزت هنر چنان خوار است %~% که مال درکف فیاض و زر به چشم قنوع(@)(@@) 36 مرا ز شعر همان منفعت‌که دهقان را %~% به خشک‌سال ز کشت زمین نامزروع(@)(@@) 37 عجب‌تر آنکه کسی جز تونی که بشناسد %~% قشور را ز لباب و نجیع را ز نجوع(@)(@@) 38 اگر به چون تو کریمی‌ کنم شکایت حال %~% مرا مگوی حریص و مرا مگوی هلوع(@)(@@) 39 نه سفله‌طبع بود بخردی‌که بهر معاش %~% بر آستان‌ کریمان‌ کشد نفیر ز جوع(@)(@@) 40 کمال سفلگی آن را بود که شام و سحر %~% کند به د‌ونان بهر دو نان ز جوع رجوع(@)(@@) 41 گهی ز بهر خوش آمد شود دخیل بخیل %~% گهی ز روی تملق ‌کند رکوع وکوع(@)(@@) 42 غرض به بزم خداوندگار من بگذر %~% ز من سلام رسانش به ‌صد خضوع و خشوع(@)(@@) 43 پس از سلام ز من بازگو به حضرت او %~% که ای ز خشم تو کودک به بطن مام جزوع(@)(@@) 44 تویی‌ که می‌کنی از یک نظاره قلع جنود %~% تویی که می کنی از یک اشاره بیخ قلوع(@)(@@) 45 تویی‌ که دشمن مال خودی ز فرط نوال %~% ازآن به خلق مفیضستی و به خویش منوع(@)(@@) 46 تویی سکندر و جود تو هست آب حیات %~% همه چو خضر ازو بهرهاب و خود ممنوع(@)(@@) 47 به نزد خلق 
ms575	 عزیزست زر به نزد تو خوار %~% چو کذب پیش عدول و خطا به نزد وزوع(@)(@@) 48 ز بهر جود تو زانرو مهان هفت اقلیم %~% به درگه تو گرایند از بلاد شسوع(@)(@@) 49 نه در دیار تو جز بحر و کان‌ کسی مظلوم %~% نه در زمان تو جز سیم و زر تنی مفجوع(@)(@@) 50 مرا چو خویش شماری مگر ز غایت لطف %~% که می‌نخواهیم از بهرکسب مال ولوع(@)(@@) 51 بلی ولوع نیم از غنای طبع ولی %~% به حد خویش بود هر سجیتی مطبوع(@)(@@) 52 قناعت است پسندیده نزد اهل هنر %~% ولی نه چندان‌ کز جان طمع شود مرفوع(@)(@@) 53 نه عاملم‌که مرا مایه ز انتفاع عمل %~% نه زارعم‌ که مرا بهره ز ارتفاع زروع(@)(@@) 54 منستم و هنری کان درین دیار بود %~% چنان‌ کساد که در تاب آفتاب شموع(@)(@@) 55 حدیث فضل نپرسد ز من‌ کس آنگونه %~% که جاهلین عذر جریزه از مخلوع‌(@)(@@) 56 ز بیم دادن فلسی چنان نفور از من %~% که عاملین ولایت ز حاکم مقلوع(@)(@@) 57 کنون یکی ز دو مقصود من ز لطف بر آر %~% به‌شکر آگه خدایت به‌خلق‌خواست نفوع(@)(@@) 58 نخست آنکه نوازی مرا و نپسندیم %~% در آب و آتش قلب حریق و عین دموع(@)(@@) 59 به شرط آنکه چو حربا به شب ندارم پاس %~% که ‌کی نماید از مشرق آفتاب طلوع(@)(@@) 60 و‌گر به چشم تو خوارم چو سیم و زر مگذار %~% که خوارتر شوم از کثرت سؤال قنوع(@)(@@) 61 مرا اجازه ری ده مگر به همت شاه %~% سپاه حادثه و جیش غم شود مدفوع(@)(@@) 62 عنان به مدح پیمبرگرای قاآنی %~% که آفتاب سعادت عیان شود ز نقوع(@)(@@) 63 شهنشهی‌ که ز روز الست لفظ وجود %~% شدست از پی فرخنده‌ذات او موضوع(@)(@@) 64 به نام ختم رسل ختم کن سخن که خدای %~% ازو رساله ابداع را نمود شروع PageV1P282(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 زهی به منزلت از عرش برده فرش تو رونق %~% زمین ز یمن تو محسود 
ms576	 هفت‌کاخ مطبق(@)(@@) 2 تویی‌ که خاک تو با آب رحمت است مخمر %~% تویی‌که فیض تو با فر سرمدست ملفق(@)(@@) 3 چو دین احمد مرسل مبانی تو مشید %~% چو شرع حیدر صفدر قواعد تو موثق(@)(@@) 4 ز هرچه عقل تصور کند فضای تو اوسع %~% ز هرچه وهم تخیل‌ کند بنای تو اوثق(@)(@@) 5 ز آستان تو حصنی است نه سپهر معظم %~% ز خاکروب تو گردیست هفت‌کاخ مروق(@)(@@) 6 کدام مظهر بیچون بود به خاک تو مدفون %~% که از زمین تو خیزد همی خروش اناالحق(@)(@@) 7 حصانت تو بر از صد هزار حصن مشید %~% رزانت تو بر از صدهزار کوه محلق(@)(@@) 8 ز بس رفیعی و محکم زبس منیعی و معظم %~% به راستی‌ که خموشیست در ثنای تو اوفق(@)(@@) 9 چنان نماید سرگشته در فضای تو گردون %~% که در محیط یکی بادبان‌ گسیخته زورق(@)(@@) 10 به نزد نزهت تو نزهت بهشت مضیع %~% به‌ جنب ساحت تو ساحت سپهر مضیق(@)(@@) 11 ز صد یکی نتواند حدیث وصف توگفتن %~% هزار صاحب و صابی هزار صابر و عمعق(@)(@@) 12 چو بر فرود سپهر برین که پرده نیلی %~% به دامن تو نمودار هفت طارم ازرق(@)(@@) 13 سپهر را بشکافد ز هم تجلی نورت %~% چنان‌که صخره صما شود ز صاعقه منشق(@)(@@) 14 چه قبه‌یی توکه گر رفع پایه تو نبودی %~% زمین شدی متزلزل بسان توده زیبق(@)(@@) 15 چه‌ بقعه‌ای‌ تو که نبود بهای یک‌ کف خاکت %~% هزار تخت مرصع هزار تاج مغرق(@)(@@) 16 چه‌ سده‌ای‌ تو که‌ در ساحت‌ تو هست هماره %~% اساس شرع منظم امور کفر معوق(@)(@@) 17 چه‌کعبه‌ای‌تو که‌ اینک ز بهر طوف حریمت %~% دمی ز پویه نیاساید این تکاور ابلق(@)(@@) 18 کدام‌ کاخ همایونی ای عمارت میمون %~% که هست برتری سده‌ات ز سدره محقق(@)(@@) 19 کدام بقعه میمونی ای بنای همایون %~% که از سمو سموات برده قدر تو رونق(@)(@@) 20 کدام آیت رحمت به ساحتت شده نازل %~% که‌ می‌زند ز شرف عرصه‌ات‌ به‌ عرش 
ms577	 برین دق(@)(@@) 21 تویی‌ که خاک تو را همچو تاج از پی زیور %~% فلک نهاده به تارک فرشته هشته به مفرق(@)(@@) 22 تویی ‌که چرخ ترنجی درین سرای سپنجی %~% ز شکل طا ق رواقت دهان‌م‌شاده چو فسنق(@)(@@) 23 چنان ‌که ‌هوش به ‌سر فیض ‌با فضای ‌تو منضم %~% چنان‌که روح به تن روح با هوای تو ملصق(@)(@@) 24 ز بهر حفظ فضایت قضا ز روز نخستین %~% به‌گرد بازه خاک از محیط ساخته خندق(@)(@@) 25 اگر به طور تجلی ‌کند فروغ فضایت %~% شود ز جلوه آن طور چون تراب مدقق(@)(@@) 26 به سر سپهر برین را بود هوای پریدن %~% بدان امید که‌ گردد به خاک ‌کوی تو ملحق(@)(@@) 27 ز نور بیضه بیضا ربوده فر تو فره %~% فراز طارم امکان زده ‌است قدر تو بعدق(@)(@@) 28 فرود قبه تو ماند این زبر شده خرگه %~% به‌کوی خاک به دامان آسمان معلق(@)(@@) 29 عیون اهل خرد از غبار توست مکحل %~% رقاب خلق به طوق پرستش تو مطوق(@)(@@) 30 به نزد قبه عالیت هفت‌ گنبد گردون %~% چو پیش کوه دماوند هفت دانه جوزق(@)(@@) 31 دلی‌که نیست هواخواه آستان تو بادا %~% طعین تیغ مصیقل نشان سهم مفوق(@)(@@) 32 اگر نه مرکز چرخستی ای بنای مشید %~% چرا به ‌گرد تو می‌‌گردد این دوازده جوسق(@)(@@) 33 ز صد یکی ز فزون اندکی نمود نیارد %~% شمار منقبتت را دوصد جریر و فرزدق(@)(@@) 34 مگر تو مقصد ایجادی ای رواق معظم %~% که هست‌هستی نه چرخ از وجود تو مشتق(@)(@@) 35 مگر سراچه عدلی‌ که در هوای تو تیهو %~% مقام امن نیابد مگر به چنگل باشق(@)(@@) 36 مگر تو روضه سلطان هشتمی ‌که به خاکت %~% کند ز بهر شرف سجده هفت طارم ازرق(@)(@@) 37 خدیو خطه امکان‌که از عنایت یزدان %~% فراز خرگه لاهوت برفراشته سنجق(@)(@@) 38 علی عا‌لی اعلی ام‌ام ثامن ضامن %~% که از طفیل وجودش وجود گشته منسق(@)(@@) 39 سپهر عدل مهین‌گوهر محیط خلافت %~% جهان جود بهین‌زاده رسول مصدق 
