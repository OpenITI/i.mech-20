ms262	 ماه درخشنده جامه کتان(@)(@@) 38 ز قدر او نپذیرد خدای عز و جل %~% ز هیچ دشمن او روز رستخیز امان(@)(@@) 39 همیشه تا چو گل نسترن بو لؤلؤ %~% چنان کجا چو گل ارغوان بود مرجان(@)(@@) 40 همیشه تابود آز و امید در دل خلق %~% چنان چو آتش در سنگ وگوهر اندر کان(@)(@@) 41 خدایگان جهان باد و پادشاه زمین %~% بعون ایزد کشور گشاو شهرستان(@)(@@) 42 ازو هر آنکه بود بدسکال او غمگین %~% بدو هر آنکه بود نیکخواه او شادان PageV1P178(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چه روز افزون و عالی دولتست این دولت سلطان %~% که روز افزون بدو گشته ست ملک و ملت و ایمان(@)(@@) 2 بدین دولت زیادت شد به اسلام اندرون قوت %~% بدین دولت پدید آمد به تعطیل اندرون نقصان(@)(@@) 3 بدین دولت جهان خالی شد از کفران و ازبدعت %~% بدین دولت خلیفه باز گسترده ست شادروان(@)(@@) 4 بدین دولت همی باشد دل بدمذهبان غمگین %~% بدین دولت همی گردد روان مصطفی شادان(@)(@@) 5 بدین دولت همی نازند شاهان همه عالم %~% چنان کاین دولت عالی همی نازد بدان سلطان(@)(@@) 6 یمین دولت عالی امین ملت باقی %~% نظام دین ابوالقاسم ستوده خسرو ایران(@)(@@) 7 کمابیش سخا دید آن که او را دید در مجلس %~% سرا پای هنر دید آن که او را دید در میدان(@)(@@) 8 جهانداری که از ساری جهان بگرفت تا باری %~% شهنشاهی که از گرگان جهان اوراست تا کرمان(@)(@@) 9 ز گرد معرکه چترش گرفته گونه لؤلؤ %~% ز خون دشمنان تیغش گرفته گونه مرجان(@)(@@) 10 ز خشتش درتن هر کینه خواهی رخنه بیحد %~% ز تیرش در بر هر جنگجویی دامنی پیکان(@)(@@) 11 رسیده در بیابانهای بی انجام و بی منزل %~% برون رفته ز دریاهای بی پایاب و بی پایان(@)(@@) 12 بشمشیر از جهان برداشت نام خسروان یکسر %~% نماند از بیم آن شمشیر ملک آرای گیتی بان(@)(@@) 13 نه با یعقوبیان دولت نه با مأمونیان نعمت %~% نه با چیپالیان قوت نه 
ms263	 با سامانیان سامان(@)(@@) 14 کسی کو را خلاف آورد گو آهنگ رفتن کن %~% که روزی با خلاف او به گیتی زیستن نتوان(@)(@@) 15 ایا بر دوستان خویش فرخ روی و فرخ پی %~% ز عزم تو دم سردست بهره دشمن نادان(@)(@@) 16 ز شاهان هر که با تو دوستی پیوست ویکدل شد %~% بجاه تو مخالف را بچاه انداخت از ایوان(@)(@@) 17 نگه کن میر کرمانرا که زیر سایه آوردی %~% ز فر سایه تو گشت میر بصره و عمان(@)(@@) 18 همایونی وفرخنده چنین بادی همه ساله %~% ولی در سایه تو شاد و تو در سایه یزدان(@)(@@) 19 ختا خانرا مراد آمد که با تو دوستی گیرد %~% همی خواهد که آید چون قدر خان نزدتو مهمان(@)(@@) 20 خداوندا جهاندارا ز خانان دوستی ناید %~% که بی رسمند و بی قولند وبد عهدند و بد پیمان(@)(@@) 21 زبانشان نیست با دلشان یکی در دوستی کردن %~% تو خودبه دانی از هر کس رسوم و عادت ایشان(@)(@@) 22 گر از بیم تو با تو دوستی جویند و نزدیکی %~% بدان کان چیست ایشانرا مخالف دان و دشمن خوان(@)(@@) 23 وگر چون بندگان آیند خدمت را میان بسته %~% گرامی دارشان کان آمدن هست از بن دندان(@)(@@) 24 چو با تو نیست ایشان را توان داوری کردن %~% چه چاره است از تواضع کردن و پذرفتن پیمان(@)(@@) 25 ز دشمن دوستی ناید اگرچه دوستی جوید %~% درین معنی مثل بسیار زد لقمان و جز لقمان(@)(@@) 26 ز ایرانی چگونه شاد خواهد بود تورانی %~% پس از چندین بلا کآمد ز ایران بر سر توران(@)(@@) 27 هنوز ار باز جویی در زمینشان چشمه هایابی %~% از آن خونها کزیشان ریخت تیغ رستم دستان(@)(@@) 28 بجای آنکه تو کردی برایشان در کتر شاها %~% حدیث رستم دستان یکی بود از هزار افسان(@)(@@) 29 چه گویی کان ز دلهاشان بشد کزبلخ پیش تو %~% همی رفتند لبها خشک ورخ پر چین و دل بریان(@)(@@) 30 به جنگ مرو و 
ms264	 جنگ بلخ و جنگ میله زان لشکر %~% به خاک اندر فکندستی فزون از قطره باران(@)(@@) 31 به ترکستان سرایی نیست کز شمشیر توصد ره %~% در آن شیون نکردستند خاتونان ترکستان(@)(@@) 32 هنوز آن مرد را کان پیل تو آن چتر بر سر زد %~% ز بیم تو نه اندر چشم خوابست و نه در تن جان(@)(@@) 33 نیرزند آنهمه خانان بپاک اندیشه خسرو %~% مکن زین پس ازیشان یادو ایشانرا به ایشان مان(@)(@@) 34 وگر گویی ولایتشان بگیرم تا مرا ماند %~% ولایتشان بیابانیست خشک و بیکس و ویران(@)(@@) 35 چه خواهی کرد آن ویرانه های ضایع و بی کس %~% ترا ایزد ولایتهای خوش داده ست و آبادان(@)(@@) 36 تو داری از کنار گنگ تادریای آبسکون %~% توداری از در گرگانج تا قزدارو تا مکران(@)(@@) 37 نه مال ماورا النهر در گنجت بیفزاید %~% نه درملک توافزونی پدید آید ز صد چندان(@)(@@) 38 بده چندان که در ده سال از آن کشور خراج آید %~% بیک هفته بر آید مر ترا از کوه زر رویان(@)(@@) 39 بخارا و سمرقندست روی و چشم آن کشور %~% غلامان ترا زین هر دو حقا گر بر آید نان(@)(@@) 40 ترا آنجا غلامانند چون خوارزمشاه ای شه %~% دگر چون میر طوس و زو گذشتی میر غرجستان(@)(@@) 41 نباشد مرترا حاجت به ملک خان طلب کردن %~% که این هر دو به مال و ملک صد ره بر ترند ازخان(@)(@@) 42 تو گر خواهی جهان یکسر به تیع تیز بگشایی %~% نیاردگفت هرگز کس که بر تو نیست این آسان(@)(@@) 43 ولیکن تو از آن ترسی که چون گیتی ترا گردد %~% شمار گیتی از تو باز خواهد داور سبحان(@)(@@) 44 دگر زان بشکهی گویی: بجایی از سپاه من %~% کسی را بد رسد بیشک مرا ایزد بپرسد زان(@)(@@) 45 زهی اندر جهانداری و بیداری چو افریدون %~% زهی اندرنکو کاری و هوشیاری چو نوشروان(@)(@@) 46 همیشه تا مه آذر نباشد چون مه کانون %~% همیشه تا مه 
ms265	 کانون نباشد چون مه آبان(@)(@@) 47 همیشه تا بهار از تیر مه خوشبوی تر باشد %~% همیشه تا زمستان سردتر باشد ز تابستان(@)(@@) 48 بشاهی باش و در شاهی سپه کش باش و دشمن کش %~% بشادی باش و در شادی توانا باش و نهمت ران(@)(@@) 49 به دل بر خور ز بت رویی که او را خوانده ای دلبر %~% ببر در کش نگارینی که نامش کرده ای جانان(@)(@@) 50 گهی از دست اومی خور گهی از دولبش بر خور %~% گهی از روی او گل چین گهی از زلف او ریحان PageV1P179(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای شهریار بیقرین ای پادشاه پاک دین %~% ای مر ترا داده خدای آسمان ملک زمین(@)(@@) 2 هم میر نیکو منظری هم شاه نیکو مخبری %~% بر منظر و برمخبر تو آفرین باد آفرین(@)(@@) 3 ای نیکنام! ای نیکخوی! ای نیکدل! ای نیکروی! %~% ای پاک اصل! ای پاک رای! ای پاک طبع! ای پاک دین(@)(@@) 4 دولت بنازد سال و مه ملت بنازد روز و شب %~% کان چون تویی دارد یمین وین چون تویی دارد امین(@)(@@) 5 فرخ یمین دولتی زیبا امین ملتی %~% وز بهر ملت روز و شب تیغ یمانی در یمین(@)(@@) 6 گاهی به دریا در شوی گاهی به جیحون بگذری %~% گه رای بگریزد ز تو گه رام و گه خان گه تگین(@)(@@) 7 صد قلعه شاهانه را برهم زدی بی کیمیا %~% صد لشکر مردانه را گردن شکستی بی کمین(@)(@@) 8 چون روز جنگ آید ترا تنها برون آیی ز صف %~% زانرو که داری لشکری بر سان کوه آهنین(@)(@@) 9 صد ره فزون دیدم ترا کز قلب لشکر درشدی %~% با کرگ تنها در اجم با شیر تنها در عرین(@)(@@) 10 اندر بیابان های سخت ره برده ای بی راهبر %~% وین از توکل باشد ای شاه زمانه وز یقین(@)(@@) 11 در ریگ جوشان چشمه روشن پدید آید ترا %~% آری چنین باشد کسی کورا بود یزدان معین(@)(@@) 12 بردی فراوان 
ms266	 رنج دل بردی فراوان رنج تن %~% وز رنج دل و ز رنج تن کردی جهان زیر نگین(@)(@@) 13 زانسو جهان بگشاده ای تادامن کوه یمن %~% زینسو زمین بگرفته ای تا ساحل دریای چین(@)(@@) 14 بغداد و زانسو هم ترا بودی کنون گر خواستی %~% لیکن نگهداری همی جاه امیر المؤمنین(@)(@@) 15 از بهر میر مؤمنین بگذاشتی نیم از جهان %~% کو هیچکس را این توانایی که کردستی تو این(@)(@@) 16 صد بنده داری در توانایی و مردی و هنر %~% صد ره فزون از مقتدر وز معتصم و زمستعین(@)(@@) 17 حرمت نگهداری همی حری بجای آری همی %~% واجب چنین بینی همی ای پیشوای پیش بین(@)(@@) 18 از جمله میران ترا هر گز نبیند کس کفو %~% از جمله شاهان ترا هر گز نبیند کس قرین(@)(@@) 19 پیلی چو در پوشی زره شیری چو بر تابی کمان %~% ابری چو برگیری قدح ببری چو در یازی بزین(@)(@@) 20 با این بزرگی هر ضعیفی راه یابد سوی تو %~% خویی گزین کردی چنان چون رادمردان گزین(@)(@@) 21 با بندگان و کهتران از آسمان گوید سخط %~% آنکس که اورا ده درم باشد به خاک اندر دفین(@)(@@) 22 از پادشاهی پارسایی دوستتر داری همی %~% زین پادشاهان عاجزند ای پادشاه راستین(@)(@@) 23 هر گز نگشتی کینه ور هر گز نگشتی کینه کش %~% کاین عاجزانرا باشد و تو قادری جز کارکین(@)(@@) 24 آنرا که تویاری دهی یاری دهد چرخ برین %~% وانرا که تو غمگین کنی برکام دل گردد غمین(@)(@@) 25 آن کونکو خواهد ترا گرسنگ بر گیرد ز ره %~% از دولت توگردد آن در دست او در ثمین(@)(@@) 26 آن کس که بدخواهد ترا یاقوت رمانی مثل %~% در دست او اخگر شود پس وای بدخواه لعین(@)(@@) 27 تا آسمان روشن شود چون سبز گردد بوستان %~% تا بوستان خرم شود چون تازه گردد یاسمین(@)(@@) 28 شاهنشه گیتی تو باش و در خور شاهنشهی %~% تا هر امیری پیش تو بر خاک ره مالد جبین 
ms267	(@)(@@) 29 خوی چنین گیرد همی کو را به چنگ آید درم %~% تو با جهانداری شها خویی همی داری چنین(@)(@@) 30 زانجا که دل خواهد ترا شکرکش و شکرستان %~% باآنکه خوش باشد ترا شادان خور و شادان نشین(@)(@@) 31 تو شاد خوار و شادکام و شادمان و شاد دل %~% بدخواه تو غلطیده اندر پای پیل پوستین(@)(@@) 32 پاینده بادا عمر تو پیوسته بادا عز تو %~% فرخنده بادا عبد تو آمین رب العالمین PageV1P180(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عید فرخ باد بر شاه جهان %~% جاودانه شادمان و کامران(@)(@@) 2 نعمتش پیوسته و عمرش دراز %~% دولتش پاینده و بختش جوان(@)(@@) 3 سال و مه لشکرکش و لشکر شکن %~% روز و شب کشورده وکشورستان(@)(@@) 4 ایزداورا یار و دولت پیشکار %~% اوبکام دل مکین اندرمکان(@)(@@) 5 تا جهان را پادشه باید همی %~% پادشه محمد باد اندر جهان(@)(@@) 6 باده اندر دست و خوبان پیش روی %~% خوبرویانی به خوبی داستان(@)(@@) 7 هر یکی با قامتی چون زاد سرو %~% هر یکی با چهره ای چون ارغوان(@)(@@) 8 جعدشان در مجلس او مشکبار %~% زلفشان در پیش او عنبر فشان(@)(@@) 9 زلف چون چوگان زنخدان همچو گوی %~% ابرو و مژگانشان تیر و کمان(@)(@@) 10 می گسار آنکس کز ایشان دوست تر %~% می زدست دوست خوشتر بیگمان(@)(@@) 11 جاودان زینگونه بادا عیش او %~% عیش بد خواهش به تیمار وهوان(@)(@@) 12 دشمن و بد گوی او را آب سرد %~% آتش سوزنده بادا در دهان(@)(@@) 13 بد که گوید زو ملک هر گز نبود %~% بد خصال و بد فعال و بدنشان(@)(@@) 14 نیکخوتر زوملک هر گز نبود %~% نیک باد آن نیک شه را جاودان(@)(@@) 15 طبع او را مال درویشان بری %~% زو رعیت شاد خوار و شادمان(@)(@@) 16 دولت او در ولایت کارساز %~% هیبت او بر رعیت پاسبان(@)(@@) 17 شیر نر درکشور ایران زمین %~% از نهیبش کرد نتواند زیان(@)(@@) 18 هیچ شه را در جهان آن زهره نیست %~% کوسخن راند ز ایران بر زبان 
