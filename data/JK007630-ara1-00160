ms141	 الممدوح لم يجزني به % % إذا قلت خيرا إن ذلك بالضد % 13(@)(@@) % أحقهم عندي بما قمت مثليا % % أعدده من فات إحسانه عدي % % 14(@)(@@) % فإن تكن الأيام أجدبن مرتعي % % لديه وكدرن الزلالة من وردي % % 15(@)(@@) % أقول لآمالي وأخشى قنوطها % % ركوبك ظهر الصبر أدنى إلى الرشد % 16(@)(@@) % تطار فلولا وجه سعدك لم يكن % % سراجك في الظلماء نجم بني سعد % 17(@)(@@) % أبا القاسم امنحني سمعت استماعة % وقف بي من استبطاء حظي على حد % 18(@)(@@) % سخوت بشعري قبل مدحك لاقيا % % بسبط كلامي كل ذي نائل جعد % 19(@)(@@) % إذا قلت أين الجود أنشد بخله % % محا الدهر ربعا بالمشقر من هند % 20(@)(@@) % تعاب لديه الشمس بالنور حجة % على منعه والماء في القيظ من برد % PageV01P414 21(@)(@@) % و فاضت وهم يبس بحارك بينهم % % فيا ليت شعري ما لجودك ما يعدى % % 22(@)(@@) % و قد كان لي في الشعر عندك دولة % و لكن قليل مكثها دولة الورد % 23(@)(@@) % أظل وما في عاشقيك محقق % سواي أقاسي الهجر من بينهم وحدي % % 24(@)(@@) % فلم أنت راض وللمجد وقفة % تزاحم دمع اليأس فيها على خدي % 25(@)(@@) % و ما غير تأميلي بديني قضاؤه % % فكم أتقاضاه وأنحت من جلدي % % 26(@)(@@) % عسى يقف الإنجاز بي عند غاية % تريح فلي حول أجر على الوعد % 27(@)(@@) % تساويف وفاها المطال حدوده % % فعجل لها الإنجاز أو جبهة الرد % PageV01P415 البحر : - 1(@)(@@) % أنا اليوم مما تعهدين بعيد % تريدين مني والعلاء يريد % 2(@)(@@) % طوى رسني عن قبضة الحب خالعا % % قواه وقدما كنت حيث يقود % 3(@)(@@) % هوى وليالي اللهو بيض وهبته % إليها وأيام الكريهة سود % 4(@)(@@) % و هيف رقاق موضع الهيف فتنني % % و هن جسوم حلوة وقدود % 5(@)(@@) % دعيني وخلقا من سني استفديه % % عزيزا فمعدود السنين مفيد % 6(@)(@@) % و لا تحسبيني صبغ لونين في الهوى % % أتوب وتبدو فرصة فأعود % 7(@)(@@) % و لا كامنا في الحي أنظر سربه % على خدعة الأشراك كيف أصيد % 8(@)(@@) % و حص غرابي يا ابنة القوم أجدل % بصير بأوكار الشباب صيود % 9(@)(@@) % أراك تريني ناقصا ونقيصتي % % ليال وأيام على تزيد % 10(@)(@@) % لكل جديد 
ms142	 باعترافك لذة % فما لك عفت الشيب وهو جديد % PageV01P416 11(@)(@@) % تأخرت بالصمصام وهو مصمم % % و خالفت رأي الرمح وهو سديد % 12(@)(@@) % متى ضنت الدنيا علي فأبصرت % % لساني فيها بالسؤال يجود % 13(@)(@@) % إذا كنت حرا فاجتنب شهواتها % % فإن بنيها للزمان عبيد % 14(@)(@@) % و بن في عيون الناس منهم مباعدا % % إذا اشتبهوا واسلم وأنت وحيد % 15(@)(@@) % و قل بلسان الحظ إن خطيبه % بليغ ومن أعيا عليه بليد % 16(@)(@@) % إذا شئت أن تلقي الأنام معظما % % فلا تلقهم إلا وأنت سعيد % 17(@)(@@) % و رب نجيب كابن أيوب واحد % تراه مع الحالات حيث تريد % 18(@)(@@) % صديق وما يغنى صديقك لم يطق % ثقيلا ولم يقرب عليه بعيد % 19(@)(@@) % أعد سجايا الأكرمين وتنقضي % % و أم سجاياه الكرام ولود % 20(@)(@@) % إذا قمت أتلوهن قالت لي العلا % % أعد والحديث المستحب يعود % PageV01P417 21(@)(@@) % و صدق وصفي والمحب بمعرض % من الريب آيات عليه شهود % 22(@)(@@) % يد في الندى ماء وقلب إذا التوت % عليه حبال المشكلات حديد % 23(@)(@@) % و مخضوبة الأطراف لم تصب عاشقا % % عميدا وكم أودي بهن عميد % 24(@)(@@) % قواطع أوصال البلاد سوائر % % و ما ثار عن أخفافهن صعيد % 25(@)(@@) % إذا نار حرب أضرمت أو مكيدة % فهن لها وما احترقن وقود % 26(@)(@@) % و علمه أن يصنع المجد منبت % عريق وبيت في السماء قعيد % 27(@)(@@) % و حامون بالرأي الجميع حماهم % و وفرهم عند الحقوق شريد % 28(@)(@@) % مطاعيم أرواح الشتاء إذا طغت % % سواجر في أبياتهم وركود % 29(@)(@@) % قيام إلى أضيافهم وعليهم % و لكنهم عند الملوك قعود % 30(@)(@@) % سخا بهم أن السخاء شجاعة % و شجعهم أن الشجاعة جود % PageV01P418 31(@)(@@) % وقيت من الحساد فيك فكل من % % يرى ودك الباقي علي حسود % 32(@)(@@) % يودون ما أصفيتني من مودة % و ما أصطفي من شكرها وأجيد % 33(@)(@@) % لبعضهم من بعضهم متخلص % و تأبى غلول بينهم وحقود % 34(@)(@@) % و عذراء مما استنجب الفكر وارتضى % % معقلة في الخدر وهي شرود % 35(@)(@@) % نجوم سجاياك الصباح إذا سرت % % قلائد في أعناقها وعقود % 36(@)(@@) % إذا يوم عيد زفها قام ناصبا % % لتجهيز أخرى مثلها لك 
ms143	 عيد % 37(@)(@@) % لها بعدما يفنى الزمان وأهله % % بقاء على أحسابكم وخلود % PageV01P419 البحر : - 1(@)(@@) % إذا صاح وفد السحب بالريح أو حدا % % و راح بها ملأى ثقالا أو اغتدى % % 2(@)(@@) % فكان وما باراه من عبراتنا % % نصيب محل بالجناب تأبدا % % 3(@)(@@) % و ما كنت لولاه ولو تربت يدي % % لأحمل في ترب لماطره يدا % % 4(@)(@@) % خليلي هذي دار لمياء فاحبسا % % معي واعجبا إن لم تميلا فتسعدا % % 5(@)(@@) % نعاتب فيها الدهر لا كيف عتبه % و أخلاقه إخلاق ما كان جددا % % 6(@)(@@) % سلاها سقاها ما يعيد زمانها % % و عيشا بها ما كان أحلى وأرغدا % % 7(@)(@@) % عهدنا لديك الليل يقطع أبيضا % % فلم صار فيك الفجر يطلع أسودا % % 8(@)(@@) % فأين الظباء العامراتك بالظبي % % ثنى وفرادي غافلات وشردا % % 9(@)(@@) % و ليل اختلاط لو تغاضى صباحه % لما مازت الأيدي القناع من الردا % % 10(@)(@@) % أبعد جلاء العين فيك من القذى % % أرى أثرا أني تلفت مرمدا % % PageV01P420 11(@)(@@) % لعمر الجوى في رفقتي بك إنه % % يخامر قرحان الحشا ما تعودا % % 12(@)(@@) % و قلت صدى قالوا الفرات الذي ترى % % و هيهات غير الماء ما نقع الصدى % % 13(@)(@@) % مضى الناس ممن كان يعتده الفتى % % و ما أكثر الباقين إن هو عددا % % 14(@)(@@) % و كان بكائي أنني لا أرى الأخ ال % % ودود فمن لي أن أرى المتوددا % % 15(@)(@@) % أمنعطف قلب الزمان بعاطش % يرى الأرض بحرا لا يرى فيه موردا % % 16(@)(@@) % تحمل شرقيا مع الركب شوقه % و قد غار شوق العاشقين وأنجدا % % 17(@)(@@) % له بين أثناء الجبال وأهلها % % مزار حبيب دونه طرق عدا % % 18(@)(@@) % و ما بي إلا أن أرى البدر ناطقا % % و ثهلان شخصا جالسا متوسدا % % 19(@)(@@) % و ليث الشرى تحت السرادق ملبدا % % و بحر الندى فوق الأسرة مزدا % % 20(@)(@@) % و أن أدرك العلياء شخصا مصورا % % هناك وألقى العز جسما محددا % % PageV01P421 21(@)(@@) % و من بلغته الأوحد الكافي المنى % % تغزل مكفيا وفاخر أوحدا % % 22(@)(@@) % لذاك اشتياقي ليس أن جازني له % % على البعد إحسان ولا فاتني ندى % % 23(@)(@@) % مواهبه سارت لحالي كثيفة % و شعري مطلوبا وذكري مشيدا % % 24(@)(@@) % فمن 
ms144	 نعمة خضراء تسبق نعمة % له ويد بيضاء لاحقة يدا % % 25(@)(@@) % فتى لم أجد لي غيره فأقول ما % % أعتم عطاء من فلان وأجودا % % 26(@)(@@) % أنال وفي الأيام لين وأيبست % فلم ينتقص ذاك النوال المعودا % % 27(@)(@@) % إذا بلغ الزوار بابك ألقيت % رحال ذليل عز أو حائر هدى % % 28(@)(@@) % و قل من الآراب قل ضممته % و قد جاز في الآفاق نهبا مطردا % % 29(@)(@@) % تغلق أبواب الملوك أمامه % و يرعى لديها الجهل وهي لقى سدى % % 30(@)(@@) % تدافعه آدابها وأكفها % % مدافعة السرح البعير المعبدا % % PageV01P422 31(@)(@@) % كما شاءها كانت ببعدك دولة % جفوت فقد صارت كما شاءها العدا % % 32(@)(@@) % فموكبها بعد السكينة نافر % و مركبها صعب وكان ممهدا % % 33(@)(@@) % عدا الدهر فيها إذ نأيت بصرفه % % و كان احتشاما منك يمشي مقيدا % % 34(@)(@@) % فإن يك ضرت هجرة بعث أحمد % فقد حط هجر الري رتبة أحمدا % % 35(@)(@@) % تعزل عنها والمقاليد عنده % % و وازرها والكد فيمن تقلدا % % 36(@)(@@) % أيخشى ابن إبراهيم فوت وزارة % و قد حازها سقف السماء وأبعدا % % 37(@)(@@) % و لما بدت للعين وقضاء جهمة % و كانت تريك البدر والظبي أجيدا % % 38(@)(@@) % معنسة أفنيت عمر شبابها % % فلم يبق إلا الشيب فيها أو الردى % % 39(@)(@@) % نهضت على الإحسان فيها ولم تقم % % و عيشك إلا وهي تزعج مقعدا % % 40(@)(@@) % تزوجتها أيام تنكح لذة % و سرحت إذ كان النكاح تمردا % % PageV01P423 41(@)(@@) % و خلفتها قاعا يغر سرابها % % يدي حافر لم يسق منها سوى الكدا % % 42(@)(@@) % قليل اطلاع في العواقب لو درى % % مشقة ما في منصدر ما توردا % % 43(@)(@@) % تلبسها جهلا بأنك لم تكن % % لتنزعها لو كنت تنزع سؤددا % % 44(@)(@@) % تحدثني عنك الأماني حكاية % بما أنا لاق منك كالصوت والصدى % % 45(@)(@@) % و كم زائر منا حملت اقتراحه % % مضى ساحبا رجلا وآب مقودا % % 46(@)(@@) % و مثلي لو دوني أتاك بنفسه % % ذنابي وولي عنك رأسا مسودا % % 47(@)(@@) % عسى عزمة أوت فمثلت كاتبا % % يقرطس أحيانا فأمثل منشدا % % 48(@)(@@) % و قائلة هل يدرك الحط قاعدا % فقلت لها هل يقطع السيف مغمدا % % 49(@)(@@) % سيلقى بها الكافي عهودا وثيقة % لقد 
ms145	 زادها الإسلام حقا وأكدا % % 50(@)(@@) % رضيت وإن جد الجدوب تعففا % % و عيشا مع الوجه المصون مبددا % % PageV01P424 51(@)(@@) % و ميلا بنفسي عن لقاء معاشر % أحتهم صخرا وأعصر جلمدا % % 52(@)(@@) % أرادوا ببخل أن يذموا فيعرفوا % % خمولا كما أعطيت أنت لتحمدا % % 53(@)(@@) % أعالج نفسا منهم مقشعرة % و أنفا إذا شموا المذلة أصيدا % % 54(@)(@@) % هو المنقذى من شرك قومي وباعثي % % على الرشد أن أصفى هواي محمدا % % 55(@)(@@) % و تارك بيت النار يبكي شراره % علي دما أن صار بيتي مسجدا % % 56(@)(@@) % عليك بها وصالة رحم الندى % % إذا اشتمل الشعر العقوق أو ارتدى % % 57(@)(@@) % هجرنا لها اللفظ المقلقل قربه % إلى السمع والمعنى العوان المرددا % % 58(@)(@@) % يخال بها الراوي إذا قام منشدا % % بما ملك ا طراب قام مغردا % % 59(@)(@@) % لكم آل إبراهيم نهدي مدائحا % % و ذما إلى أعدائكم وتهددا % % 60(@)(@@) % إذا عز ملك أن يدوم لمالك % و طال على ذي نعمة أن يخلدا % % PageV01P425 61(@)(@@) % فلا تعدم الدنيا الوساع مدبرا % % يقوم بها منكم ولا الناس سيدا % % PageV01P426 البحر : - 1(@)(@@) % أنت على حالتيك محمود % إن كان بخل لديك أو جود % 2(@)(@@) % يشقى ويرضى بك الفؤاد كما الط % % رف إذا ما رآك مسعود % 3(@)(@@) % يا غصنا دهره الربيع فما % % يفترق الماء فيه والعود % 4(@)(@@) % فات بك الحسن أن تحد ولل % % بدر بما انحط عنك تحديد % 5(@)(@@) % قم حدث الليل عن أواخره % % إن مقام الصبوح مشهود % 6(@)(@@) % يا ظبي لو بتض فيه عدت وقد % % عن ظباء ببابل غيد % 7(@)(@@) % أما ترى الفطر صائحا نورزوا % % حلض حرام وانحل معقود % 8(@)(@@) % و البدر يدعو بحاجب حاجب % للعيد بشرى هنالك العيد % 9(@)(@@) % فاسبق بها الشمس أختها لهبا % % بقاؤها في الزمان تخليد % 10(@)(@@) % صان اليهودي خدرها أن يف % % ض الختم أو تؤخذ المقاليد % PageV01P427 11(@)(@@) % عد رجلا من قومه لهم % في فضلها عنده أسانيد % % 12(@)(@@) % سن له اللهو أن يعظمها % % فهي له في الدنان معبود % 13(@)(@@) % حمراء ما فازت الأكف به % % من لونها في الخدود مردود % 14(@)(@@) % من فم إبريقها إلى شفة ال % % كأس عمود الصباح ممدود 
ms146	 % 15(@)(@@) % دين من اللهو أنت عن باب إب % % ليس متى حدت عنه مطرود % 16(@)(@@) % تغنم اليوم من سرورك وال % % ساعة إن الزمان معدود % 17(@)(@@) % ما دام يدعونك الفتى مرحا % % و الغصن فينان والصبا رود % 18(@)(@@) % غدا بياض يا قاتل الله ما % % تنشق عنه من بيضك السود % 19(@)(@@) % لا تجمع الشيب والسرور يد % و لا يتم الثراء والجود % 20(@)(@@) % لا أخلف المال غير متلفه % إن الغنى البخيل مكدود % PageV01P428 21(@)(@@) % يا راكبا لم تلحه هاجرة % و لا ترامت بشخصه البيد % 22(@)(@@) % و لم تقد حظه مخاطرة % تنضي إليها المهرية الفود % 23(@)(@@) % بين مناه وبينه غرض ال % % رامي سداد منه وتعضيد % 24(@)(@@) % قل لابن عبد الرحيم عشت فما % % يعدم فضل وأنت موجود % 25(@)(@@) % ملكك المجد أن بابك مف % % توح وباب الأرزاق مسدود % 26(@)(@@) % يزدحم الناس فيه راجين را % % ضين وحوض الكريم مورود % 27(@)(@@) % و أن عافيك والمكلف مش % % نوء مراد لديك مودود % 28(@)(@@) % لا هو في الذل بالسؤال ولا % % بالمن فيما مننت مكدود % 29(@)(@@) % يختلف الناس من كرامته % % عندك من قاصد ومقصود % 30(@)(@@) % و البشر حتى يقال بارقة % و الحلم حتى يقال جلمود % PageV01P429 31(@)(@@) % يلبسك المدح كل ضافية % لها بطول الإخلاق تجديد % 32(@)(@@) % در المعالي فيها يوصفك من % % ظوم ووشي الألفاظ منضود % 33(@)(@@) % تخبر منه ما أنت ناقده % % و أكثر الإنتقاد تقليد % 34(@)(@@) % و الشعر ما لم توجدك آيته % إلا القوافي والوزن مفقود % 35(@)(@@) % يتعب فيه الموفرون له % % و هو مع المسهلين موؤود % % 36(@)(@@) % بقيت منه لزائراتك بالثناء % غيدا أكفاؤها الصيد % 37(@)(@@) % كل فتاة محدوها يوم تب % % غى الحظ إما أتتك مجدود % 38(@)(@@) % صديقها أنت والحسود بها % % و بي على القرب منك مفؤود % 39(@)(@@) % في وجهه البشر حين يسمعها % % خوفا وفي قلبه الأخاديد % 40(@)(@@) % يطرب منها للشيء يحزنه % و اسم بكاء الحمام تغريد % PageV01P430 41(@)(@@) % لا اجتاز عيد إلا عليك وإن % % أجزت أن تمطل المواعيد % PageV01P431 البحر : - 1(@)(@@) % إذا لم يرع عندكم الوداد % فسيان القرابة والبعاد % 2(@)(@@) % عهود يوم رامة دارسات % كما يتناوب الطلل العهاد 
ms147	 % 3(@)(@@) % و أيمان تضيع بها المعاني % % و تحفظها الأنامل والعداد % 4(@)(@@) % تطير مع الخيانة كل جنب % و حبات القلوب بها تصاد % 5(@)(@@) % أمعترض صدودك أم سعد % ببعض الشر أم خلق وعاد % 6(@)(@@) % و عذل فيك أوجع نازل بي % % أنا الملسوع والعذل العداد % 7(@)(@@) % و عبت وليس غير الشيب شيئا % % أذاد له بعيب أو أكاد % 8(@)(@@) % و ما منى البياض فتجرميني % % به ذنبا ولا منك السواد % 9(@)(@@) % بأيمن ملتقى الماءين دار % لمرتاد الهوى فيها مراد % 10(@)(@@) % وقفت ومسعدون معي عليها % % ألا يا دار ما فعلت سعاد % PageV01P432 11(@)(@@) % أقول لهم أعلل فيك شوقي % % و شيكا ينقع الظمأ الثماد % 12(@)(@@) % خذوا من يومكم لغد نصيبا % % من الأطلال إن اليوم زاد % 13(@)(@@) % توق الحب تأمن كل بغض % فداؤك من ذوائك مستفاد % 14(@)(@@) % يخوفني مكايده زماني % % صغارك لا أحس ولا أكاد % 15(@)(@@) % و قدرته إذا لم يعط بخل % و غايته إذا أعطى نفاد % 16(@)(@@) % فقل لبنيه لست إذا أخاكم % % بعاد بيننا أبدا بعاد % 17(@)(@@) % أعان الله مسكينا رجاكم % % فإن رجاء مثلكم جهاد % 18(@)(@@) % رضينا من قبائلكم ببيت % عماد المكرمات له عماد % 19(@)(@@) % بنى عبد الرحيم وكل فخر % % يفوت فباسم نسبتهم يفاد % 20(@)(@@) % أعد ذكر التحية في أناس % إذا بدءوا إليك يدا أعادوا % % PageV01P433 21(@)(@@) % و قم واخطب بحمدك في ربوع % وفود المجد عنها لا تذاد % 22(@)(@@) % و مبتسمين يورى الملك منهم % % جباها كل واضحة زناد % 23(@)(@@) % رأوا حفظ النفوس إذا استميحوا % % و قد بخل الحيا بخلا فجادوا % % 24(@)(@@) % فدى للمحسنين فتى علاهم % % و ناشرها وقد درسوا وبادوا % % 25(@)(@@) % دعي في السماح وليس منه % % متى اعترف الندى بك يا زياد % 26(@)(@@) % دع العلياء يسحبها عريق % بياضك يوم نسبته سواد % 27(@)(@@) % يطول ركابه إن قام فيها % % و يقصر عن مقلده النجاد % 28(@)(@@) % أيا ابن علي اعتقلتك منى % يد لم تدر قبلك ما العتاد % 29(@)(@@) % عركت يد الخطوب وفي ضعف % فلن وهن أعباء شداد % 30(@)(@@) % لذلك تستزاد الشمس نورا % % و حبيك الذي لا يستزاد % PageV01P434 31(@)(@@) % و حظك من جنى 
ms148	 فكري ثناء % يطول وطوله فيك اقتصاد % 32(@)(@@) % إذا الشيء المعاد أمل سمعا % % تكرر وهو طيبا يستعاد % 33(@)(@@) % فما خطبت بأبلغ منه خاء % و لا نطقت بأفصح منه ضاد % 34(@)(@@) % ألا لا تذكر الدنيا بخير % فتى إلا وأنت به المراد % 35(@)(@@) % إذا حاز امرؤ تأييد نجل % أمدك من أبي سعد مداد % 36(@)(@@) % شبيهك والعلا منها اكتساب % % و منها وهو أفضلها ولاد % 37(@)(@@) % و كنت البدر تم فزيد نجما % % كما أوفى بغرته الجواد % 38(@)(@@) % فعش واذخره للعافين كهفا % % و خير ذخيرة الجسم الفؤاد % PageV01P435 البحر : - 1(@)(@@) % أبا لغور تشتاق تلك النجودا % % رميت بقلبك مرمى بعيدا % % 2(@)(@@) % وفيت فكيف رأيت الوفاء % يذل العزيز ويضوي الجليدا % % 3(@)(@@) % أفي كل دار تمر العهود % عليك ولم تنس منها العهودا % % 4(@)(@@) % فؤاد أسير ولا يفتدى % % و جفن قتيل البكا ليس يودي % % 5(@)(@@) % سهرنا ببابل للنائمي % % ن عما نقاسى بنجد رقودا % % 6(@)(@@) % من العربيات شمس تعود % بأحرار فارس مثلي عبيدا % % 7(@)(@@) % إذا قومها افتخروا بالوفا % % ء والجود ظلت ترى البخل جودا % % 8(@)(@@) % و لو أنهم يحفظون الجوا % % ر ردوا على فؤادا طريدا % % 9(@)(@@) % نعم جمع الله يا من هويت % و صد عليك الهوى والصدودا % % 10(@)(@@) % رنت عينه ورأت مقتلي % % ففوقها ورماني سديدا % % PageV01P436 11(@)(@@) % قلوب الغواني حديد يقال % و قلبك نار تذيب الحديدا % % 12(@)(@@) % سأجري مع الناس في شوطهم % % فعالا بغيضا وقولا وديدا % % 13(@)(@@) % أغر ببشر أخي في اللقا % % ء لو تبع الغيث تلك الرعودا % % 14(@)(@@) % و يعجبي الماء في وجهه % % و في قلبه الغل يذكي وقودا % % 15(@)(@@) % مريبون أوسعهم حجة % و عذرا معي من يكون الحسودا % % 16(@)(@@) % و حاد فلست ترى المستري % % ح في الناس من لا تراه الوحيدا % % 17(@)(@@) % و حازت سجايا ابن عبد الرحيم % % ثناء كسؤدده لن يبيدا % % 18(@)(@@) % و مدحا إذا مات مجد الرجا % % ل أعطى الذي سار فيه الخلودا % % 19(@)(@@) % تمهد من فارس ذروة % تحط المجرة عنها صعودا % % 20(@)(@@) % مكانة لا تستفز العيو % % ب فخرا ولا يغمز اللؤم عودا % % PageV01P437 21(@)(@@) % تشابه عرق وأغصانه % كما بدئ 
ms149	 المجد فيهم أعيدا % % 22(@)(@@) % فعد الكواكب منهم بنين % و عد الأهاضيب منهم جدودا % % 23(@)(@@) % سعدت بحبك لو أنني % % لحظي منك رزقت السعودا % % 24(@)(@@) % إلام توان يميت الوفاء % و عندي ضمان يحل العقودا % % 25(@)(@@) % و نقص اهتمام أرى مكرها % لجودك من أجله مستزيدا % % 26(@)(@@) % أما آن للعادة المرتضا % % ة من رحب صدرك لي أن تعودا % % 27(@)(@@) % و لو لم يكن ماء وجهي يذوب % بها ثمنا لم يرعني جمودا % % 28(@)(@@) % أمان صدرن بطانا وعدن % خمائص مما رعين الوعودا % % 29(@)(@@) % إلى الله محتسبا عنده % % بعثت هوى مات فيكم شهيدا % % 30(@)(@@) % على ذاك ما قصرت دولة % % فطاول زمانك بيضا وسودا % % PageV01P438 31(@)(@@) % و لا تبرحن بشعري عليك % % عرائس يجلين هيفا وغيدا % % 32(@)(@@) % تخال اليماني حاك البرود % إذا أنا قصدت منها القصيدا % % 33(@)(@@) % و لي كل عيد بها وقفة % أناشد عطفك فيها نشيدا % % 34(@)(@@) % تهان يغص التقاضي بها % % فهل أنا لا أتقاضاك عيدا % % PageV01P439 البحر : - 1(@)(@@) % إما تقومون كذا أو فاقعدوا % % ما كل من رام السماء يصعد % 2(@)(@@) % نام على الهون الذليل ودرى % % جفن العزيز لم بات يسهد % 3(@)(@@) % أخفكم سعيا إلى سودده % % أحقكم بأن يقال سيد % 4(@)(@@) % عن تعب أورد ساق أولا % % و مسحت غرة سباق يد % 5(@)(@@) % لو شرف الإنسان وهو وادع % لقطع الصمصام وهو مغمد % 6(@)(@@) % هيهات أبصرت العلاء وعشوا % % عنه فضلوا سبله وتجد % 7(@)(@@) % يا عمدة الملك وأي شرف % طال ولم ترفعه منكم عمد % 8(@)(@@) % لله هذا اليوم يوما أنجز ال % % دهر به ما كان فيه يعد % 9(@)(@@) % لما طلعت البدر من ثنية % تجلى بها عين وعين ترمد % 10(@)(@@) % من شفق الشمس يسدى ثوبها % % و تلحم الجوزاء أو تعمد % PageV01P440 11(@)(@@) % دق وجل فهو إن لامسته % سبط وإن مارسته مجعد % 12(@)(@@) % متوجا عمامة وإنما % % عمامة الفارس تاج يعقد % 13(@)(@@) % ممتطيا أتلع لو حبسته % تحتك قيل فدن مشيد % 14(@)(@@) % مناقلا بأربع كأنما % % يلاطم الجليد منها جلمد % 15(@)(@@) % وقرها خوفك فهو مطلق % ينقلها كأنه مقيد % 16(@)(@@) % خف بطبع عتقه وآده % % ثقل الحلى فمشيه تأود % 17(@)(@@) % مقلدا 
ms150	 مهندا ما ضمه % % قبلك إلا خافه مقلد % 18(@)(@@) % أبيض لا يعطيك عهدا مثله % إذا أخوك حال عما تعهد % 19(@)(@@) % إذا ادرعت في الدجى فقبس % و إن توسدت الثرى فعضد % 20(@)(@@) % ما اعتدت كسب العز إلا معه % و المرء مشاء وما يعود % PageV01P441 21(@)(@@) % ما زال فخر الملك في أمثالها % % يرشد في آرائه ويسعد % 22(@)(@@) % فكيف لا وأنت من فؤاده % % عزا وعينيه المكان الأسود % 23(@)(@@) % و لو ركبت أرحلا لكان لي % % فيك براق بالمنى مزود % 24(@)(@@) % أنت الذي جمعتني من معشر % شمل العلاء بينهم مبدد % 25(@)(@@) % كأنني آخذ ما أعطيهم % من مدحي إذا نطقت أنشد % 26(@)(@@) % أبحتني مجدك إذ أرحتني % % ممن أذم منهم وأحمد % PageV01P442 البحر : - 1(@)(@@) % ليتك لما لم تكن مسعدا % % أو مصلحا لم تكن المفسدا % % 2(@)(@@) % كنت كثيرا بك فيما يرى % % ظني فكثرت عديد العدا % % 3(@)(@@) % وشى وقد قدمته رائدا % % لا تبعث الظلمة مسترشدا % % 4(@)(@@) % يسومني الغدر بعهد اللوى % % ما حق من يغدر أن يعهدا % % 5(@)(@@) % غيري أبو الألوان في حبه % % يشكو الهوى اليوم ويسلوا غدا % % 6(@)(@@) % أصبو إلى طيبة من بابل % ما أقرب الشوق وما أبعدا % % 7(@)(@@) % يا فارس الغيداء يبغي منى % بلغ بلغت الرشأ الأغيدا % % 8(@)(@@) % يا حبذا الذكرى وإن أسهرت % بعدك والدمع وإن أرمدا % % 9(@)(@@) % لا تأخذ النفر بتقريقنا % % فربما عاد لنا موعدا % % 10(@)(@@) % بالغور دار و بنجد هوى % يا لهف من غار لمن أنجدا % % PageV01P443 11(@)(@@) % ما كان سلمى يوم فارقتكم % % يا سلم منى حاملا أجلدا % % 12(@)(@@) % سجية في الصبر عودتها % % قلبي والقلب وما عودا % % 13(@)(@@) % لم تدنني الأيام من عدلها % % قط فألقى الجور مستبعدا % % 14(@)(@@) % و إنما ينكر من عيشه % أنكده من عرف الأرغدا % % 15(@)(@@) % حوادث أعجب من كرها % % أن أتشكاها وأن أحسدا % % 16(@)(@@) % ليت بني الدنيا التي لا ترى % % لي نسبا منها ولا مولدا % % 17(@)(@@) % كفتهم عني أو ليتهم % كانوا جميعا للحسين الفدى % % 18(@)(@@) % للقمر الفرد وهل مالك % في الأفق غير البدر أن يفردا % % 19(@)(@@) % لا يحسب الطيب من ماله % % ما لم يكن معترضا للجدا % % 20 
ms151	(@)(@@) % و كان أغنى حسبا عندهم % من لم يزل أفقر منهم يدا % % PageV01P444 21(@)(@@) % و الأبيض الرأي إذا ما شكا % % خابط ليل رأيه الأسودا % % 22(@)(@@) % و فارس القولة لم يستقم % في ظهرها الفارس إلا ارتدى % % 23(@)(@@) % و سالك الخطب وقد أظلمت % محجة بالنجم لا تهتدى % % 24(@)(@@) % ما شيم منكم صارم مغمد % إلا وأمضى منه ما جردا % % 25(@)(@@) % و لا قضى الله على سيد % قضاءه إلا اجتبى سيدا % % 26(@)(@@) % إن بدأوا تمم أو نقصوا % % أنعم أو حطوا علا شيدا % % 27(@)(@@) % كأنه أرضع ثدي النهى % % أو شاب من حنكته أمردا % % 28(@)(@@) % لا عاق أنوارك يا بدرهم % ما ينقص البدر إذا زيدا % % 29(@)(@@) % و لا أغبتكم على عادها % % ما أفطر الصائم أو عيدا % % 30(@)(@@) % بواكر من مدحي تقتفي % % في صونها آثاركم في الندى % % PageV01P445 31(@)(@@) % تجلو على الألباب أحسابكم % بواديا في حليها عودا % % 32(@)(@@) % تبقى على الدهروساع الخطا % % في جوبها الأرض طوال المدى % % 33(@)(@@) % يزيدها ترديدها جدة % و يخلق القول إذا رددا % % PageV01P446 البحر : - 1(@)(@@) % لا تلمس الشمس يد % فما يرد الحسد % 2(@)(@@) % ما لمريد حسنها % % إلا الأسى والكمد % 3(@)(@@) % يفنى نزولا ولها % % علاؤها والخلد % 4(@)(@@) % أرى نفوسا ضلة % تنشد ما لا تجد % 5(@)(@@) % تحسب بالكسب العلا % % ء والعلاء مولد % 6(@)(@@) % أفضحها مفند % لو سد غيظا فند % 7(@)(@@) % و كل قلب قرحة % % يشف عنه الجسد % 8(@)(@@) % أبرده بعذلي % % لو أن نارا تبرد % 9(@)(@@) % هيهات من دوائها % % و داؤها محمد % 10(@)(@@) % فات على أطماعه % حمى العيون الفرقد % PageV01P447 11(@)(@@) % شوقها لحاقه % جهل الحظوظ المسعد % 12(@)(@@) % و نعم نابتة % مع الربيع جدد % 13(@)(@@) % حدثها أضغاثها % % هذا السراب الموقد % 14(@)(@@) % و الصبح في تكذيبها % % إن بلغوه الموعد % 15(@)(@@) % يا حاسدي محمد % لا تطلبوه واحسدوا % % 16(@)(@@) % شريعة مورودة % لو أصدرت من يرد % 17(@)(@@) % منتكم جدودكم % % أن السبيل جدد % 18(@)(@@) % تنكبوا فإنما % % على الطريق الأسد % 19(@)(@@) % أغيد لا ينجى الرقا % % ب من يديه الجيد % 20(@)(@@) % أوفى على مرقبه % % لكفه ما يرصد % PageV01P448 21(@)(@@) % أزب ما من قرة % خيطت عليه اللبد % 22(@)(@@) % إذا غدا لسفر 
ms152	 % أقسم لا يزود % 23(@)(@@) % الناجيات عنده % % وذية ونقد % 24(@)(@@) % قد قلت لما أجمعوا % % و أنت عنهم مفرد % 25(@)(@@) % تخبط عشواؤهم % ما فعل المقود % 26(@)(@@) % البدر في أمثالها % % حنادسا يفتقد % 27(@)(@@) % ضاع بياض ناركم % % و الليل بعد أسود % 28(@)(@@) % أكرمكم أحقكم % % بأن يقال سيد % 29(@)(@@) % دل على آياته % فما لنا نقلد % 30(@)(@@) % و ناقص الشكة مض % % عوف الحشا معود % PageV01P449 31(@)(@@) % صم القنا الصلاب من % % خوره تقصد % 32(@)(@@) % يطولها شوارعا % % و هو لقى موسد % 33(@)(@@) % إذ الكمال كله % % في جسد يحدد % 34(@)(@@) % ما تلد الأرض كذا % % و الأرض بعد تلد % 35(@)(@@) % قل لبني الآراب تج % % فى والمنى تشرد % 36(@)(@@) % و الحاج يلقى دونه % % ن الحز المزيد % 37(@)(@@) % الكوفة الكوفة يا % % مغور يا منجد % 38(@)(@@) % ما الناس إلا رجل % و الأرض إلا بلد % 39(@)(@@) % من راكب مربعة % تم عليها العدد % 40(@)(@@) % موضوعة الرحل تل % % س حكمها وترد % PageV01P450 41(@)(@@) % يمد قيد الرمح ظ % % لا قصرها المشيد % 42(@)(@@) % تحمله مخفة % و لو علاها أحد % 43(@)(@@) % تخد في الصخر ملا % % طم عليها تخد % 44(@)(@@) % عجلى إذا ما الساق صا % % دت ما تثير العضد % 45(@)(@@) % لم يدر لحظ ضابط % ما رجلها وما اليد % 46(@)(@@) % بلغ بلغت راشدا % % تسري ويحدو مرشد % 47(@)(@@) % شوقا يقض نبله ال % % أضلاع وهي زرد % 48(@)(@@) % دام على حصاة قل % % بي ويذوب الجلمد % 49(@)(@@) % أفنى الوقود كبدي % % فهل يحس الموقد % 50(@)(@@) % كم يسعد الصبر ترى % % بعدك خان المسعد % PageV01P451 51(@)(@@) % على من الفضل وقد % % فارقته يعتمد % 52(@)(@@) % يا طول ذمي للنوى % % هل من لقاء يحمد % 53(@)(@@) % متى فقد طال المدى % % لكل شيء أمد % 54(@)(@@) % يا باعث النعمى التي % % آياتها لا تجحد % 55(@)(@@) % لو كتمت تطلعت % من حسن حالي تشهد % 56(@)(@@) % كانت سداد رحلة % أصيب فيها المقصد % 57(@)(@@) % رممت منها ثلما % % ما خلتها تسدد % 58(@)(@@) % علك من مطلي بالش % % كر عليها تجد % 59(@)(@@) % ما كان تقصيرا فهل % % يقتصر المجتهد % 60(@)(@@) % لكنها عارفة % من الثناء أزيد % PageV01P452 61(@)(@@) % أفسدني إفراطها % % بعض العطاء يفسد % 62(@)(@@) % و الجود ما أسرف 
ms153	 وال % % إمساك فيه أجود % 63(@)(@@) % و الآن رثت مسكة % فاسمع لها أجدد % 64(@)(@@) % تأتيك بشرى ما تسو % % د أبدا وتسعد % 65(@)(@@) % و ما تصوم مرضا % بقاك أو تعيد % 66(@)(@@) % سنين لا يضبطه % % ن في الحساب عدد % 67(@)(@@) % إن عاقني دهر أقو % % م أبدا ويقعد % 68(@)(@@) % عن المثول اليوم ما % % بين يديك أنشد % 69(@)(@@) % فربما قمت غدا % إن أخا اليوم غد % PageV01P453 البحر : - 1(@)(@@) % أقريش لا لفم أراك ولا يد % فتوا كلى غاض الندى وخلا الندى % % 2(@)(@@) % خولست فالفتي بأوقص واسئلي % % من بز ظهرك وانظري من أرمد % 3(@)(@@) % وهبي الذحول فلست رائد حاجة % تقضي بمطرور ولا بمنهد % 4(@)(@@) % خلاك ذو الحسين أنقاضا متى % % تجذب على حبل المذلة تنقد % 5(@)(@@) % قمر الدنا أضحت سماؤك بعده % % أرضا تداس بحائر وبمهتدى % % 6(@)(@@) % فإذا تشادقت الخصوم فلجلجي % % و إذا تصادمت الكماة فعردي % % 7(@)(@@) % يا ناشد الحسنات طوف فاليا % % عنها وعاد كأنه لم ينشد % % 8(@)(@@) % اهبط إلى مضر فسل حمراءها % % من ضاح بالبطحاء يا نار اخمدي % % 9(@)(@@) % بكر النعي فقال أردي خيرها % % إن كان يصدق فالرضي هو الردي % % 10(@)(@@) % عادت أراكة هاشم من بعده % % خورا لفأس الحاطب المتوقد % PageV01P454 11(@)(@@) % فجعت بمعجز آية مشهودة % و لرب آيات لها لم تشهد % 12(@)(@@) % كانت إذا هي في الإمامة نوزعت % ثم ادعت بك حقها لم تجحد % 13(@)(@@) % رضي الموافق والمخالف رغبة % بك واقتدى الغاوي برأي المرشد % 14(@)(@@) % ما أحرزت قصباتها وتراهنت % إلا وظهرت بفضلة من سؤدد % 15(@)(@@) % تبعتك عاقدة عليك أمورها % % و عرى تميمك بعد لما تعقد % 16(@)(@@) % و رآك طفلا شيبها وكهولها % % فتزحزحوا لك عن مكان السيد % 17(@)(@@) % أنفقت عمرك ضائعا في حفظها % % و عققت عيشك في صلاح المفسد % 18(@)(@@) % كالنار للساري الهداية والقرى % % من ضوئها ودخانها للموقد % 19(@)(@@) % من راكب يسع الهموم فؤاده % و تناط منه بقارح متعود % 20(@)(@@) % ألف التطوح فهو ما هددته % % يفري فيافي البيد غير مهدد % PageV01P455 21(@)(@@) % يطوي المياه على الظما وكأنه % % عنها يضل وإنه للمهتدي % % 22(@)(@@) % صلب الحصاة يثور غير مودع % % عن أهله ويسير غير 
ms154	 مزود % 23(@)(@@) % عدلت جويته على ابن مفازة % مستقرب أمم الطريق الأبعد % 24(@)(@@) % يجري على أثر الراب كأنه % % يمشي على صرح بهن ممرد % 25(@)(@@) % يغشى الوهاد بمثلها من مهبط % و ربا الهضاب بمثلها من مصعد % 26(@)(@@) % قرب قربت من التلاع فإنها % % أم المناسك مثلها لم يقصد % 27(@)(@@) % دأبا به حتى تريح بيثرب % فتنيخه نقضا بباب المسجد % 28(@)(@@) % و احث التراب على شحوبك حاسرا % % و انزل فعز محمدا بمحمد % 29(@)(@@) % و قل انطوى حتى كأنك لم تلد % منه الهدى وكأنه لم يولد % 30(@)(@@) % نزلت بأمتك المضاعة في ابنك ال % % مفقود بنت العنقفير المؤيد % PageV01P456 31(@)(@@) % طرقته تأخذ ما اطفته ولا ترى % % مكرا وتقتل من نحته ولا تدى % % 32(@)(@@) % نشكو إليك وقود جاحمها وإن % % كانت تخصك بالملظ المكمد % 33(@)(@@) % بكت السماء له وودت أنها % % فقدت غزالتها ولما يفقد % 34(@)(@@) % و الأرض وابن الحاج سدت سبله % و المجد ضيم فما له من منجد % 35(@)(@@) % و بكاك يومك إذ جرت أخباره % ترحا وسمي بالعبوس الأنكد % 36(@)(@@) % صبغت وفاتك فيه أبيض فجره % % با للعيون من الصباح الأسود % 37(@)(@@) % إن تمس بعد تزاحم الغاشين مه % % جورا بمطرحة الغريب المفرد % 38(@)(@@) % فالدهر ألأم ما علمت وأهله % من أن تروح عشيرهم أو تغتدي % % 39(@)(@@) % و لئن غمرت من الزمان بلين % عن عجم مثلك أو عضضت بأدرد % 40(@)(@@) % فالسيف يأخذ حكمه من مغفر % % و طلى ويأخذ منه سن المبرد % PageV01P457 41(@)(@@) % لو كان يعقل لم تنلك له يد % لكن أصابك منه مجنون اليد % 42(@)(@@) % قد كان لي بطريف مجدك سلوة % عن سالف من مجد قومك متلد % 43(@)(@@) % فكأنكم ومدى بعيد بينكم % % يوم افتقدتك زلتم عن موعد % 44(@)(@@) % يا مثكلا أم الفضائل مورثا % % يتما بنات القاطنات الشرد % 45(@)(@@) % خلفتهن بما رضينك ناظما % % ما بين كل مرجز ومقصد % 46(@)(@@) % فتحت بهن وقد عدمتك ناقدا % % أفواه زائفة اللهى لم تنقد % 47(@)(@@) % ورثيت حتى لو فرقت مميزا % % راثيك من هاجيك لم تستبعد % 48(@)(@@) % غادرتني فيهم بما أبغضته % أدعو البيوع إلى متاع مكسد % 49(@)(@@) % أشكو انفراد الواحد 
ms155	 الساري بلا % % أنس وإن أحرزت سبق الأوحد % 50(@)(@@) % و إذا حفظتك باكيا ومؤنبا % % عابوا عليك تفجعي وتلددي % % PageV01P458 51(@)(@@) % أحسنت فيك فساءهم تقصيرهم % ذنب المصيب إلى المغير المعضد % 52(@)(@@) % كانوا الصديق رددتهم لي حسدا % صلي الإله على مكثر حسدي % % 53(@)(@@) % يغير فيك الشامتون وإنه % % يوم هم رهن عليه إلى غد % 54(@)(@@) % و سيسبروني كيف قطع مجردي % % إن كان حز ولم يعمق مغمدي % % 55(@)(@@) % و تثير عارمة الرياح سحابتي % % من مبرق في فضل وصفك مرعد % 56(@)(@@) % فتقت بذكرك فأرها فتفاوحت % % نعما تأرج لي بطيب المولد % 57(@)(@@) % تزداد طولا ما استرحت فإنني % % أرثيك بعد وحرقتي لم تبرد % 58(@)(@@) % ماء الأسى متصبب لي لم يغض % في صحن خد بالبكاء مخدد % 59(@)(@@) % لو قد رأيت مع الدموع جدوبه % فرط الزفير عجبت للراوي الصدى % % 60(@)(@@) % لا غيرتك جنائب تحت البلى % % و كساك طيب البيت طيب الملحد % PageV01P459 61(@)(@@) % و قربت لا تبعد ؛ وإن علالة % للنفس زورا قولتي لا تبعد % PageV01P460 البحر : - 1(@)(@@) % حاشاك من عارية ترد % ابيض ذاك الشعر المسود % 2(@)(@@) % أشرف بازي على عزابه % % حتى ذوي الغصن ولان الجعد % 3(@)(@@) % أتعبني بخاضب مصدد % لو كان من هجومه يصد % 4(@)(@@) % و ثالم بلقطه ثنية % معروفة من يومها تسد % 5(@)(@@) % يصبغ سوداء ودون أخذه % % بيضاء تخفي تارة وتبدو % % 6(@)(@@) % أخلق جاهي في ذوات الخمر مذ % % ليث خمار لي مستجد % 7(@)(@@) % قلن وقد عتبت في وثائق % % نقضنها ما غادة وعهد % 8(@)(@@) % نافى بك الشيب بطالات الصبا % % الليل هزل والنهار جد % 9(@)(@@) % فقلت نصل لا يذم عتقه % قلن فأين الماء والفرند % 10(@)(@@) % كان قناة فغدا حنية % ظهرك ما القضيب إلا القد % PageV01P461 11(@)(@@) % سائل بني سعد وأي مأثم % لم يتقلد منك ظلما سعد % 12(@)(@@) % أهند قالت ملني وحلفت % تحللي حالفة يا هند % 13(@)(@@) % أمنك بين أضلعي جناية % أعجب بها نارا خباها زند . % 14(@)(@@) % وعدك لم أخلف يوم بابل % بل كان سحرا واسمه لي وعد % 15(@)(@@) % خصرك صعفا واللسان ملقا % دقا عليك أن يصح عقد % 16(@)(@@) % ضاع الهوى ضياع من يحفظه % % و مات 
ms156	 مع أهل الوفاء الود % 17(@)(@@) % أنج ربيح العرض واقعد حجرة % منفردا إن الحسام فرد % 18(@)(@@) % كم مستريح في ظلال نعمة % و أنت في تأميله تكد % 19(@)(@@) % طالك بالمال ولو أريته % صونا رآك معه تعد % 20(@)(@@) % ملكت نفسي مذ هجرت طمعي % % اليأس حر والرجاء عبد % PageV01P462 21(@)(@@) % و لو علمت رغبة تسوق لي % % نفعا لخفت أن يضر الزهد % 22(@)(@@) % جربت أخلاق الرجال فإذا % % بسمحها مع السؤال نكد % 23(@)(@@) % و رمت أيديهم بكل رقية % تلين والأيدي معي تشتد % 24(@)(@@) % لم يعيني فضل أداريهم به % % و إنما أعيا علي الجد % 25(@)(@@) % ما كان من شعشع لي سرابه % غر فمي وقلت ماء عد % 26(@)(@@) % في الناس من معروفه في عنقي % % غل وفيهم من جداه عقد % 27(@)(@@) % مثل الحسين إن طلبت غاية % فاتت وهل مثل له أوند % 28(@)(@@) % فات الرجال أن ينالوا مجده % % مشمر للمجد مستعد % 29(@)(@@) % غلس في إثر العلا وأشمسوا % % فجاء قبلا والنجوم بعد % 30(@)(@@) % و من بني عبد الرحيم قمر % كل لياليه تمام سعد % PageV01P463 31(@)(@@) % ما نطفة المزن صفت طاهرة % أطيب مما ضم منه البرد % 32(@)(@@) % لابنه لا تلف القضيب عاسيا % و اصعب يزاحمك ثقيلا أحد % 33(@)(@@) % من المحامين على أحسابهم % % بمالهم فالفقر فيهم مجد % 34(@)(@@) % لا يتمنون على حظوظهم % % أن يجدوا دنيا إذا لم يجدوا % % 35(@)(@@) % سخوا ولم تبن عليهم طيء % و فصحوا ولم تلدهم نجد % 36(@)(@@) % كانوا الخيار وفرعت زائدا % % و النار تعلو وأبوها الزند . % 37(@)(@@) % يا مؤنسي بقربه سل وحشتي % % بعدك ما جر علي البعد . % 38(@)(@@) % أكل يوم للفراق فيكم % تعمد يسوءني أو قصد % 39(@)(@@) % ما بين أن يحبرني لقاؤكم % % حتى النوى فنعمة وجهد % 40(@)(@@) % و كيف لا وأنتم في نوبي % % يد وظهر وفم وعضد % PageV01P464 41(@)(@@) % ريش جناحي بكم مضاعف % و حبل باعي منكم ممتد % 42(@)(@@) % كم تحملون كلفي ثقيلة % كأن حملي ليس منه بد % 43(@)(@@) % مبتسمين والثرى معبس % بيض الوجوه والخطوب ربد % 44(@)(@@) % قد فضلتني سرفا ألطافكم % % فحسبكم . لكل شيء حد % 45(@)(@@) % أبقوا علي إنما إبقاؤكم % % ذخر ليوم حاجتي 
ms157	 معد % 46(@)(@@) % شيبكم والنصفاء منكم % و الغر من شبابكم والمرد % 47(@)(@@) % في نجوة أيدي الخطوب دونها % % بتر وأجفان الليالي رمد % 48(@)(@@) % أراك فيها كل يوم لابسا % % ثوبا من النعماء يستجد % 49(@)(@@) % يزورك الشعر به في معرض % منشده يحسب طيبا يشدو % % 50(@)(@@) % و ربما أذكر ما أنساك من % % رسمي اتفاق ساءني لا عمد % PageV01P465 51(@)(@@) % سيفك في الأعداء لم خلفته % مجردا ليس عليه غمد % 52(@)(@@) % و كيف طبت أن يرى فريسة % نفسا وأيام الشتاء أسد % 53(@)(@@) % يحتشم النيروز من إطلاله % % و المهرجان يقتضيك بعد % PageV01P466 البحر : - 1(@)(@@) % خليلك من صفا لك في البعاد % % و جارك من أذك على الوداد % 2(@)(@@) % و حظك من صديقك أن تراه % % عدوا في هواك لمن تعادى % % 3(@)(@@) % و رب أخ قصي العرق فيه % % سلو عن أخيك من الولاد % 4(@)(@@) % فلا تغررك ألسنة رطاب % بطائنهن أكباد صوادي % % 5(@)(@@) % و عش إما قرين أخ وفي % أمين الغيب أو عيش الوحاد % 6(@)(@@) % فإني بعد تجربتي لأمر % أنست ولا أغشك بإنفرادي % % 7(@)(@@) % تريد خلائق الأيام مكرا % % لتغضبني على خلقي وعادي % % 8(@)(@@) % و تغمرني الخطوب تظن أني % % ألين على عرائكها الشداد % 9(@)(@@) % و ما ثهلان تشرف قنتاه % % بأحمل للنوائب من فؤادي % % 10(@)(@@) % تغرب في تقلبها الليالي % % علي بكل طارقة ناد % PageV01P467 11(@)(@@) % إذا قلت آكتفت مني وكتفت % نزت بالداء ثائرة العداد % 12(@)(@@) % رعى سمن الحوادث في هزالي % % كأن صلاحهن على فسادي % % 13(@)(@@) % فيوما في الذخيرة من صديقي % % و يوما في الذخيرة من تلادي % % 14(@)(@@) % يذم النوم دون الحرص قوم % و قلت لرقدتي عنه حماد % 15(@)(@@) % و ما كان الغني إلا يسيرا % % لو أن الرزق يبعثه اجتهادي % % 16(@)(@@) % و ضاحكة إلى شعر غريب % شكمت به فأسلس من قيادي % % 17(@)(@@) % تعد سني تعجب من بياضي % % و أعجب منه لو علمت سوادي % % 18(@)(@@) % أمان كل يوم في انتقاص % يساوقهن هم في ازدياد % % 19(@)(@@) % و فرقة صاحب قلق المطايا % % به قلق المدامع والوساد % 20(@)(@@) % تخفض بعده الأيام صوتي % % على لسني وتخفض من عمادي % % PageV01P468 21(@)(@@) % و تخمد عن ضيوف 
ms158	 الأنس ناري % % و كنت بقربه واري الزناد % 22(@)(@@) % أقيم ولم أقم عنه لمسل % و يرحل لم يسر مني بزاد % 23(@)(@@) % كأنا إذ خلقنا للتصافي % % خلقنا للقطيعة والبعاد % 24(@)(@@) % أرى قلبي يطيش إذا المطايا % % إلى الرابين ياسرهن حادي % % 25(@)(@@) % و لم احسب دجيلا من مياهي % % و لا أن المطيرة من بلادي % % 26(@)(@@) % و لا أني أبيت دعامي يحدو % % إلى تكريت سارية الغوادي % % 27(@)(@@) % و من صعداء أنفاسي شرار % % تمر مع الجنوب بها تنادي % % 28(@)(@@) % أأحبابي أثار البين بيني % % و بينكم مساخطة الأعادي % % 29(@)(@@) % سقت أخلاقكم عهدي لديكم % % فهن به أبر من العهاد % 30(@)(@@) % ورد على عندكم زمان % مجود الروض مشكور المراد % PageV01P469 31(@)(@@) % أصابت طيب عيشي فيه عيني % % فقد جازيتها هجر الرقاد % 32(@)(@@) % فلا تحسب وظنك في خيرا % % بقاي وأنت ناء من مرادي % % 33(@)(@@) % و لا أني يسر سواد عيني % % بما عوضت من هذا السواد % 34(@)(@@) % و كيف وما تلف المجد دار % نأتك ولا يضم الفضل نادي % % 35(@)(@@) % فإن أصبر ولم أصبر رجوعا % % إلى جلد ولم أحمل بآد % 36(@)(@@) % فقد تحنى الضلوع على سقام % و قد تغضى الجفون على سهاد % 37(@)(@@) % و كنت وبيننا إن طال ميل % و إما عرض دجلة وهي وادي % % 38(@)(@@) % إذا راوحت دارك لج شوقي % % فلم يقنعه إلا أن أغادي % % 39(@)(@@) % فكيف وبيننا للأرض فرج % يماطل طوله عنق الجياد % 40(@)(@@) % و معترض الجزيرة والخوافي % % من القاطول تلمع والبوادي % % PageV01P470 41(@)(@@) % وفود من مطايا الماء سود % روادفها تطول على الهوادي % % 42(@)(@@) % إذا كن الليالي مقمرات % فراكبهن يخبط في الدآدي % % 43(@)(@@) % لهن من الرياح الهوج حاد % و من خلج المياه العوج هادي % % 44(@)(@@) % إذا قمصت على الأمواج خيلت % على الأحشاء تقمص أو فؤادي % % 45(@)(@@) % فهل لي أن أراك وأن تراني % % و هل من عدتي هي أو عتادي % % 46(@)(@@) % سأنتظر الزمان لها ويوما % % يطيل يد الصديق على المعادي % % 47(@)(@@) % ظمئنا بعدكم أسفا وشوقا % % كما جيدت بكم يبس البلاد % 48(@)(@@) % لعل محمدا ذكرته نعمى % % تراني ناسيا فيه اعتقادي % % 49(@)(@@) % و عل الله يجبر 
ms159	 بالتداني % % كسيرة قانط حسب التمادي % % 50(@)(@@) % و أقرب ما رجوت الأمر فيه % % على الله اعتمادك واعتمادي % % PageV01P471 51(@)(@@) % فلا تعدم ولا يعدمك خلآ % % متى ما تعده عنك العوادي % % 52(@)(@@) % يزرك كرائما متكفلات % بجمع الأنس قيل له بداد % 53(@)(@@) % نواحب في التعازي والتشاكي % % حبائب للتهاني والتهادي % % 54(@)(@@) % طوالع في سواد الهم بيضا % طلوع المكرمات أو الأيادي % % 55(@)(@@) % إذا جرت ذلاذلها بجو % تضوع حاضر منه وبادي % % 56(@)(@@) % لها فعل الدروع عليك صونا % % و في الأعداء أفعال الصعاد % 57(@)(@@) % ربت يا آل أيوب وأتت % % رباي بكم على السنة الجماد % 58(@)(@@) % فهل رجل يدل إذا عدمتم % % على رجل وفي أو جواد % 59(@)(@@) % و من أخذ المحاسن عن سواكم % % كمن أخذ المناسب عن زياد % PageV01P472 البحر : - 1(@)(@@) % سلمت وما الديار بسالمات % على عنت البلى يا دار هند % % 2(@)(@@) % و لا برحت مفوفة الغوادي % % تصيب رباك من خطإ وعمد % 3(@)(@@) % بموقظة الثرى والترب هاد % و مجدية الحيا والعام مكدي % % 4(@)(@@) % على أني متى مطرتك عيني % % ففضل ما سقاك الغيث بعدي % % 5(@)(@@) % أميل إليك يجذبني فؤادي % % و غيرك ما استقام السير قصدي % % 6(@)(@@) % و أشفق أن تبدلك المطايا % % بوطأتها كأن ثراك خدي % % 7(@)(@@) % أرى بك ما أراه فمستعير % حشاي وواجد بالبين وجدي % % 8(@)(@@) % و ليتك إذ نحلت نحول جسمي % % بقيت على النحول بقاء عهدي % % 9(@)(@@) % و ما أهلوك يوم خلوت منهم % % بأول غدرة للدهر عندي % % 10(@)(@@) % سلي الأيام ما فعلت بأنسي % % و عيش لي على البيضاء رغد % PageV01P473 11(@)(@@) % و في الأحداج عن رشإ حبيب % على لونيه من صلة وصد % 12(@)(@@) % يماطل ثم ينجز كل دين % و لم ينجز بذي العلمين وعدي % % 13(@)(@@) % تبسم بالبراق وصاب غيث % % فلو ملك الفداء لكنت أفدي % % 14(@)(@@) % ثناياه وفاه ولا أغالي % % بما في المزن من برق وبرد % 15(@)(@@) % ألا من عائد بياض يوم % لعيني بين أحناء و صمد % 16(@)(@@) % و عين بالطويلع بارزات % على قسماتهن حياء نجد % % 17(@)(@@) % نظرن فما غزالته بلحظ % و مسن فما أراكته بقد % 18(@)(@@) % و بلهاء الصبا تبغي سقاطي % % إذا 
ms160	 حللتها هزلت بجدي % % 19(@)(@@) % تعد سني تعجب من وقاري % % و لم يجتز مراح العمر عدي % % 20(@)(@@) % فما للشيب شد على ركضا % % فطوح بي ولم أبلغ أشدي % % PageV01P474 21(@)(@@) % يعيرني ولم أره شآني % % تنبه حظه بخمول جدي % % 22(@)(@@) % و ود على غضارة حلتيه % مكان الرقع من أسمال بردى % % 23(@)(@@) % و ما ورق الغنى المنفوض عني % % بمعر من حسام المجد غمدي % % 24(@)(@@) % حملت وليس عن جلد بقلبي % % حمولة واسع الجنبين جلد % 25(@)(@@) % تبادهني النوائب مستغرا % % فأدفعها بعزمة مستعد % 26(@)(@@) % يزل الحوف عن سكنات قلبي % % زليل الماء عن صفحات جلدي % % 27(@)(@@) % دع الدنيا ترف على بنيها % % و تجلب بالجفاء علي وحدي % % 28(@)(@@) % وفر أموالهم تنمو وتزكو % % فليس كنوزها ثمنا لحمدي % % 29(@)(@@) % لعل حوائل الآمال فيهم % % تطرق من أبي سعد بسعد % 30(@)(@@) % فتى عقدت تمائمه فطيما % % على أكرومة ووفاء عقد % PageV01P475 31(@)(@@) % و ربته على خلق المعالي % % غرائز من أب عال وجد % 32(@)(@@) % فما مجت له أذن سؤالا % % و لا سمحت له شفة برد % 33(@)(@@) % إذا اخضرت بنان أب كريم % % فصبغتها إلى الأبناء تعدي % % 34(@)(@@) % تطاول للكمال فلم يفته % على قرب الولاد مكان بعد % 35(@)(@@) % و تم فعلق الأبصار بدرا % % و لم يعلق له شعر بخد % 36(@)(@@) % رآه أبوه وابن الليث شبل % % لسدة ثغرة وهو ابن مهد % 37(@)(@@) % فقال لحاسديه شقيتم بي % % و هذا ابني به تشقون بعدي % % 38(@)(@@) % جرى ولداته فمضى وكدوا % % لو أن الريح مدركة بكد % 39(@)(@@) % إذا سبروه عن عوصاء أدلى % بها فنجا على غرر التحدي % % 40(@)(@@) % دعوا درج الفضائل مزلقات % لماض بالفضائل مستبد % PageV01P476 41(@)(@@) % و ما حسد النجوم على المعالي % % و لو ذاب الحصا حسدا بمجدي % % 42(@)(@@) % أبا سعد ولو عثروا بعيب % مشوا فيه بحق أو تعدى % % 43(@)(@@) % و قد تسري العيوب على التصافي % % فكيف بها على حنق وحقد % 44(@)(@@) % و لكن فتهم فنجوت منهم % % نجاء اللحن بالخصم الألد % 45(@)(@@) % و ملكك الفخار فلم تنازع % % بقل في الندى ولا بحشد % 46(@)(@@) % أب لك يحلم العلياء طولا % % و خال في عراص المجد يسدي 