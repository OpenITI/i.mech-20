ms141	 لولا بدائع صنعه % ماعاد أصفر ، بعد إذ هو أخضر % 22(@)(@@) % خلق أطل من الربيع كأنه % خلق الإمام وهديه المتيسر % 23(@)(@@) % في الأرض من عدل الإمام وجوده % % ومن النبات الغض سرج تزهر % 24(@)(@@) % تنسى الرياض وما يروض فعله % % أبدا على مر الليالي يذكر % 25(@)(@@) % إن الخليفة حين يظلم حادث % عين الهدى وله الخلافة محجر % 26(@)(@@) % كثرت به حركاتها ولقد ترى % % من فترة وكأنها تتفكر % 27(@)(@@) % ما زلت أعلم أن عقدة أمرها % % في كفه مذ خليت تتخير % 28(@)(@@) % سكن الزمان فلا يد مذمومة % للحادثات ولا سوام يذعر % 29(@)(@@) % نظم البلاد فأصبحت وكأنها % % عقد كأن العدل فيه جوهر % 30(@)(@@) % لم يبق مبدى موحش إلا ارتوى % % من ذكره فكأنما هو محضر % PageV01P473 31(@)(@@) % ملك يضل الفخر في أيامه % ويقل في نفحاته ما يكثر % 32(@)(@@) % فليعسرن على الليالي بعده % أن يبتلى بصروفهن المعسر % PageV01P474 البحر : طويل 1(@)(@@) % أألله إني خالد بعد خالد % وناس سراج المجد نجم المحامد ! % 2(@)(@@) % وقد ترعت إثفية العرب التي % % بها صدعت مابين تلك الجلامد % 3(@)(@@) % ألا غرب دمع ناصر لي على الأسى % % ألا حر شعر في الغليل مساعدي % % 4(@)(@@) % فلم تكرم العينان إن لم تسامحا % % ولاطاب فرع الشعر إن لم يساعد % 5(@)(@@) % لتبك القوافي شجوها بعد خالد % بكاء مضلات السماح نواشد % 6(@)(@@) % لكانت عذاراها إذا هي أبرزت % لدى خالد مثل العذارى النواهد % 7(@)(@@) % وكانت لصيد الوحش منها حلاوة % على قلبه ليست لصيد الأوابد % 8(@)(@@) % وكان يرى سم الكلام كأنما % % يقشب أحيانا بسم الأساود % 9(@)(@@) % تقلص ظل العرف في كل بلدة % % وأطفىء في الدنيا سراج القصائد % 10(@)(@@) % فيا عي مرحول إليه وراحل % % وخجلة موفود إليه ووافد % PageV01P475 11(@)(@@) % وياماجدا أوفى به الموت نذره % فأشعر روعا كل أروع ماجد ! % 12(@)(@@) % غدا يمنع المعروف بعدك دره % وتعذر غدران الأكف الروافد % 13(@)(@@) % ويا شائما برقا خدوعا وسامعا % لراعدة دجالة في الرواعد % 14(@)(@@) % أقم ثم حط الرحل والظن إنه % % مضت قبلة الأسفار منء بعد خالد % 15(@)(@@) % تكفأ متن الأرض يوم تعطلت % من الجبل المنهد تحت الفدافد % 16(@)(@@) % فللثغر لون 
ms142	 قاتم بعد منظر % أنيق وجو سائل غير راكد % 17(@)(@@) % لأبرحت يا عام المصائب بعدما % % دعتك بنو الآمال عام الفوائد ! % 18(@)(@@) % لقد نهس الدهر القبائل بعده % % بناب حديد يقطر السم عاند % 19(@)(@@) % فجلل قحطا آل قحطان وانثنت % نزار بمنزور من العيش جاحد % 20(@)(@@) % على أي عرنين غلبنا ومارن % وأية كف فارقتنا وساعد ! % PageV01P476 21(@)(@@) % كأنا فقدنا ألف ألف مدجج % على ألف ألف مقرب لا مباعد % 22(@)(@@) % فيا وحشة الدنيا وكانت أنيسة % ووحدة من فيها لمصرع واحد ! % 23(@)(@@) % مضت خيلاء الخيل وانصرف الردى % % بأنفس نفس من معد ووالد % 24(@)(@@) % فأين شفاء الثغر أين إذا القنا % % خطرن على عضو من الملك فاسد ؟ % 25(@)(@@) % وأين الجلاد الهبر إذ ليس سيد % يقي جلدة الأحساب إن لم يجالد ؟ % 26(@)(@@) % ومن يجعل السلطان حبل وريده % ومن ينظم الأطراف نظم القلائد ؟ % 27(@)(@@) % ومن لم يكن ينفك يغبق سيفه % دما عاندا من نحر ليث معاند ؟ % 28(@)(@@) % بنفسي من خطتء ربيعة لحده % % ولا زال مهتز الربي غير هامد % 29(@)(@@) % أقام به من حي بكر بن وائل % هني الندى مخضر إثر المواعد % 30(@)(@@) % فماذا حوت أكفانه من شمائل % % مناهل أعداد عذاب الموارد ! % PageV01P477 31(@)(@@) % خلائق كانت كالثغور تخرمت % وكان عليها واقفا كالمجاهد % 32(@)(@@) % فكم غال ذاك الترب لي ولمعشري % % وللناس طرا من طريف وتالد ! % 33(@)(@@) % أشيبان لا ذاك الهلال بطالع % علينا ولا ذاك الغمام بعائد % 34(@)(@@) % أشيبان ماجدي ولاجد كاشح % ولاجد شيء يوم ولى بصاعد % 35(@)(@@) % أشيبان عمت نارها من مصيبة % فما يشتكى وجد إلى غير واجد % 36(@)(@@) % لإن أقرحت عيني صديق وصاحب % % لقد زعزعت ركني عدو وحاسد % 37(@)(@@) % لئن هي أهدت للأقارب ترحة % لقد جللت تربا خدود الأباعد % 38(@)(@@) % فما جانب الدنيا بسهل ولا الضحى % % بطلق ولاماء الحياة ببارد % 39(@)(@@) % بلى وأبي إن الأمير محمدا % لقطب الرحى مصباح تلك المشاهد % 40(@)(@@) % حمدت الليالي إذ حمت سرحنا به % ولست لها في غير ذاك بحامد % PageV01P478 41(@)(@@) % عليه دليل من يزيد وخالد % ونوران لاحا من نجار وشاهد % 42(@)(@@) % من المكرمين الخيل فيهم ولم يكن % ليكرمها 
ms143	 إلا كرام المحاتد % 43(@)(@@) % أخو الحرب يكسوها نجيعا كأنما % % متون رباها منه مثل المجاسد % 44(@)(@@) % إذا شب نارا أقعدت كل قائم % وقام لها من خوفه كل قاعد % 45(@)(@@) % فقل لملوك السيسجان ومن غدا % % بأران أو جرزان غير مناشد % 46(@)(@@) % ألا القوا مقاليد البلاد وهل لها % % رتاج فيلقي أهلها بالمقالد ؟ ! % 47(@)(@@) % ولا يغوكم شيطان حرب فإنه % % مع السيف يدمى نصله غير مارد % 48(@)(@@) % ولا تفترق أعناقكم إن حولها % % ردينية يجمعن هام الشوارد % 49(@)(@@) % وما كثرت في بلدة قصد القنا % % فتقلع إلا عن رقاب قواصد % PageV01P479 البحر : سريع 1(@)(@@) % ولي من الدنياهوى واحد % يا رب فاصفح لي عن الواحد % 2(@)(@@) % لا تتركني فيه يا ذا العلى % % احدوثة الصادر والوارد % 3(@)(@@) % يا رب إن فارقته بعد ما % % أصرعني للشامت الحاسد % 4(@)(@@) % فألحق الروح وجثمانه % بوهدة المحتفر اللاحد % PageV01P480 البحر : كامل تام 1(@)(@@) % الحق أبلج والسيوف عوار % فحذار من أسد العرين حذار % 2(@)(@@) % ملك غدا جار الخلافة منكم % والله قد أوصى بحفظ الجار % 3(@)(@@) % يارب فتنة أمة قد بزها % % جبارها في طاعة الجبار % 4(@)(@@) % جالت بخيذر جولة المقدار % فأحله الطغيان دار بوار % 5(@)(@@) % كم نعمة لله كانت عنده % فكأنها في غربة وإسار % 6(@)(@@) % كسيت سبائب لومه فتضاءلت % كتضاؤل الحسناء في الأطمار % 7(@)(@@) % موتورة طلب الإله بثأرها % % وكفى برب الثأر مدرك ثار % 8(@)(@@) % صادى أمير المؤمنين بزبرج % في طيه حمة الشجاع الضاري % % 9(@)(@@) % مكرا بنى ركنيه ، إلا أنه % وطد الأساس على شفير هار % 10(@)(@@) % حتى إذا ما الله شق ضميره % عن مستكن الكفر والإصرار % PageV01P481 11(@)(@@) % ونحا لهذا الدين شفرته انثنى % % والحق منه قانئ الأظفار % 12(@)(@@) % هذا النبي وكان صفوة ربه % من بين باد في الأنام وقار % 13(@)(@@) % قد خص من أهل النفاق عصابة % وهم أشد أذى من الكفار % % 14(@)(@@) % واختار من سعد لعين بني أبي % % سرح لوحي الله غير خيار % 15(@)(@@) % حتى استضاء بشعلة السور التي % % رفعت له سجفا عن الأسرار % 16(@)(@@) % والهاشميون استقلت عيرهم % من كربلاء بأثقل الأوتار % 17(@)(@@) % فشفاهم المختار منه ولم يكن % في دينه 
ms144	 المختار بالمختار % 18(@)(@@) % حتى إذا انكشفت سرائره اغتدوا % % منه براء السمع والأبصار % 19(@)(@@) % ما كان لولا فحش غدر خيذر % ليكون في الإسلام عام فجار % 20(@)(@@) % ما زال سر الكفر بين ضلوعه % حتى اصطلى سر الزناد الواري % % PageV01P482 21(@)(@@) % نارا يساور جسمه من حرها % % لهب كما عصفرت شق إزار % 22(@)(@@) % طارت لها شعل يهدم لفحها % % أركانه هدما بغير غبار % 23(@)(@@) % مشبوبة رفعت لأعظم مشرك % ما كان يرفع ضوءها للساري % % 24(@)(@@) % صلى لها حيا وكان وقودها % % ميتا ويدخلها مع الفجار % 25(@)(@@) % فصلن منه كل مجمع مفصل % وفعل فاقرة بكل فقار % 26(@)(@@) % وكذاك أهل النار في الدنيا هم % يوم القيامة جل أهل النار % 27(@)(@@) % يا مشهدا صدرت بفرحته إلى % % أمصارها القصوى بنو الأمصار % 28(@)(@@) % رمقوا أعالي جذعه فكأنما % % وجدوا الهلال عشية الإفطار % 29(@)(@@) % واستنشأوا منه قتارا نشره % من عنبر ذفر ومسك داري % % 30(@)(@@) % وتحدثوا عن هلكه كحديث من % بالبدو عن متتابع الأمطار % PageV01P483 31(@)(@@) % وتباشروا كتباشر الحرمين في % % قحم السنين بأرخص الأسعار % 32(@)(@@) % كانت شماتة شامت عارا فقد % صارت به تنضو ثياب العار % 33(@)(@@) % قد كان بوأه الخليفة جانبا % من قلبه حرما على الأقدار % 34(@)(@@) % فسقاه ماء الخفض غير مصرد % وأنامه في الأمن غير غرار % 35(@)(@@) % ورأى به مالم يكن يوما رأى % % عمرو بن شأس قبله بعرار % 36(@)(@@) % فإذا ابن كافرة يسر بكفره % وجدا كوجد فرزدق بنوار % 37(@)(@@) % وإذا تذكره بكاه كما بكى % % كعب زمان رثى أبا المغوار % 38(@)(@@) % دلت زخارفه الخليفة أنه % ما كل عود ناضر بنضار % 39(@)(@@) % يا قابضا يد آل عادلا % أتبع يمينا منهم بيسار % 40(@)(@@) % ألحق جبينا داميا رملته % بقفا ، وصدرا خائنا بصدار % PageV01P484 41(@)(@@) % واعلم بأنك إنما تلقيهم % في بعض ما حفروا من الآبار % 42(@)(@@) % لو لم يكد للسامري قبيله % ما خار عجلهم بغير خوار % 43(@)(@@) % وثمود لو لم يدهنوا في ربهم % % لم تدم ناقته بسيف قدار % 44(@)(@@) % ولقد شفى الأحشاء من برحائها % % أن صار بابك جار مازيار % 45(@)(@@) % ثانيه في كبد السماء ولم يكن % لاثنين ثان إذ هما في الغار 
ms145	 % 46(@)(@@) % وكأنما انتبذا لكيما يطويا % % عن ناطس خبرا من الأخبار % 47(@)(@@) % سود الثياب كأنما نسجت لهم % أيدي السموم مدارعا من قار % 48(@)(@@) % بكروا وأسروا في متون ضوامر % قيدت لهم من مربط النجار % 49(@)(@@) % لا يبرحون ومن رآهم خالهم % أبدا على سفر من الأسفار % 50(@)(@@) % كادوا النبوة والهدى ، فتقطعت % أعناقهم في ذلك المضمار % PageV01P485 51(@)(@@) % جهلوا ، فلم يستكثروا من طاعة % معروفة بعمارة الأعمار % 52(@)(@@) % فاشدد بهارون الخلافة إنه % سكن لوحشتها ودار قرار % 53(@)(@@) % بفتى بني العباس والقمر الذي % % حفته أنجم يعرب ونزار % 54(@)(@@) % كرم العمومة والخؤولة مجه % سلفا قريش فيه والأنصار % 55(@)(@@) % هو نوء يمن فيهم وسعادة % وسراج ليل فيهم ونهار % 56(@)(@@) % فاقمع شياطين النفاق بمهتد % ترضى البرية هديه والباري % % 57(@)(@@) % ليسير في الآفاق سيرة رأفة % ويسوسها بسكينة ووقار % 58(@)(@@) % فالصين منظوم بأندلس إلى % % حيطان رومية فملك ذمار % 59(@)(@@) % ولقد علمت بأن ذلك معصم % ما كنت تتركه بغير سوار % 60(@)(@@) % فالأرض دار أقفرت مالم يكن % من هاشم رب لتلك الدار % PageV01P486 61(@)(@@) % سور القران الغر فيكم أنزلت % ولكم تصاغ محاسن الأشعار % PageV01P487 البحر : بسيط تام 1(@)(@@) % لو صحح الدمع لي أو ناصح الكمد % لقلما صحباني الروح والجسد % 2(@)(@@) % خان الصفاء أخ كان الزمان له % % أخا فلم يتخون جسمه الكمد % 3(@)(@@) % تساقط الدمع أدنى مابليت به % في الحب إذ لم تساقط مهجة ويد % 4(@)(@@) % لا والذي ارتكت تطوي الفجاج له % % سفائن البر في خد الثرى تخد % 5(@)(@@) % لأنفدن أسى إذ لم أمت أسفا % أو ينفد العمر بي أو ينفد الأبد % 6(@)(@@) % عني إليك فإني عنك في شغل % لي منه يوم يبكي مهجتي وغد % 7(@)(@@) % وإن بجرية نابت جأرت لها % % إلى ذرى جلدي فاستوهل الجلد % 8(@)(@@) % هي النوائب فاشجي أو فعي عظة % فإنها فرص أثمارها رشد % 9(@)(@@) % هبي تري قلقا من تحته أرق % يحدوهما كمد يحنو له الجسد % 10(@)(@@) % صماء سم العدى في جنبها ضرب % وشرب كأس الردى في فمها شهد % PageV01P488 11(@)(@@) % هناك أم النهى لم تود من حزن % ولم تجد لبني الدنيا بما تجد % 12 
ms146	(@)(@@) % لو يعلم الناس علمي بالزمان وما % % عاثت يداه لما ربوا ولا ولدوا % % 13(@)(@@) % لايبعد الله ملحودا أقام به % شخص الحجى وسقاه الواحد الصمد % 14(@)(@@) % ياصاحب القبر دعوى غير مثئب % إن قال أودى الندى والبدر والأسد % 15(@)(@@) % بات الثرى بأخي جذلان مبتهجا % وبت يحكم في أجفاني السهد % 16(@)(@@) % لهفي عليك ومالهفي بمجدية % % مالم يزرك بنفسي حر ما أجد % 17(@)(@@) % أنسى أبا الفضل يعفو الترب أحسنه % % دوني ودلو الردى في مائه يرد ؟ ! % 18(@)(@@) % ويل لأمك أقصر إنه حدث % لم يعتقد مثله قلب ولا جلد % 19(@)(@@) % عاق الزمان رضيع الجود لم يقه % أهل ولم يفده مال ولاولد % 20(@)(@@) % حين ارتوى الماء وافترت شبيبته % % عن مضحك للمعالي ثغره برد % PageV01P489 21(@)(@@) % وقيل أحمدها بل قيل أمجدها % % بل قيل أنجدها إن فرت النجد % 22(@)(@@) % رود الشباب كنصل السيف لاجعد % في راحتيه ولافي عوده أود % 23(@)(@@) % سقى الحبيس ومحبوسا ببرزخه % من السمي كفيت الودق يطرد % 24(@)(@@) % بحيث حل أبو صقر فودعه % % صفو الحياة ومن لذاتها الرغد % 25(@)(@@) % بحيث حل فقيد المجد مغتربا % ومورثا حسرات ليس تفتقد % PageV01P490 البحر : - 1(@)(@@) % فرد جمال سليل نور % به استقلت يد السرور % 2(@)(@@) % تجول في رونقي جمال % من خده مقلة البصير % 3(@)(@@) % لم يعرفوا مثله جمالا % جل عن المثل والنظير % PageV01P491 البحر : كامل تام 1(@)(@@) % أفنى وليلي ليس يفنى آخره % هاتا موارده فأين مصادره ؟ % 2(@)(@@) % نامت عيون الشامتين تيقنا % أن ليس يهجع والهموم تسامره % 3(@)(@@) % أسر الفراق عزاءه ونأى الذي % % قد كان يستحييه إذ يستاسره % 4(@)(@@) % لا شيء ضائر عاشق ، فإذا نأى % % عنه الحبيب فكل شيء ضائره % 5(@)(@@) % يا أيهاذا السائلي أنا شارح % لك غائبي حتى كأنك حاضره % 6(@)(@@) % إني ونصرا والرضا بجواره % كالبحر لا يبغي سواه مجاوره % 7(@)(@@) % ما إن يخاف الخذل من أيامه % أحد تيقن أن نصرا ناصره % 8(@)(@@) % يفدي أبا العباس من لم يفده % من لائميه جذمه وعناصره % 9(@)(@@) % مستنفر للمادحين ، كأنما % % آتيه يمدحه أتاه يفاخره % 10(@)(@@) % ماذا ترى فيمن رآك لمدحه % أهلا وصارت في يديك مصايره % PageV01P492 11(@)(@@) % قد كابر الأحداث 
ms147	 حتى كذبت % عنه ولكن القضاء يكابره % 12(@)(@@) % مر دهره بالكف عن جنباته % % فالدهر يفعل صاغرا ما تأمره % 13(@)(@@) % لاتنس من لم ينس مدحك والمنى % % تحت الدجى يزعمن أنك ذاكره % 14(@)(@@) % أبكر فقد بكرت عليك بمدحه % غرر القصائد خير أمر باكره % 15(@)(@@) % لاقاك أوله بأول شعره % فأهب بأوله يكن لك آخره % 16(@)(@@) % لاشيء أحسن من ثنائي سائرا % ونداك في أفق البلاد يسايره % 17(@)(@@) % وإذا الفتى المأمول أنجح عقله % في نفسه ونداه أنجح شاعره % PageV01P493 البحر : طويل 1(@)(@@) % كذا فليجل الخطب وليفدح الأمر % فليس لعين لم يفض ماؤها عذر % 2(@)(@@) % توفيت الآمال بعد محمد % % وأصبح في شغل عن السفر السفر % 3(@)(@@) % وما كان إلا مال من قل ماله % وذخرا لمن أمسى وليس له ذخر % 4(@)(@@) % وما كان يدري مجتدي جود كفه % إذا ما استهلت أنه خلق العسر % 5(@)(@@) % ألا في سبيل الله من علطت له % % فجاج سبيل الله وانثغر الثغر % 6(@)(@@) % فتى كلما فاضت عيون قبيلة % دما ضحكت عنه الأحاديث والذكر % 7(@)(@@) % فتى مات بين الضرب والطعن ميتة % تقوم مقام النصر إذ فاته النصر % 8(@)(@@) % وما مات حتى مات مضرب سيفه % من الضرب واعتلت عليه القنا السمر % 9(@)(@@) % وقد كان فوت الموت سهلا فرده % إليه الحفاظ المر والخلق الوعر % 10(@)(@@) % ونفس تعاف العار حتى كأنه % % هو الكفر يوم الروع أو دونه الكفر % PageV01P494 11(@)(@@) % فأثبت في مستنقع الموت رجله % % وقال لها من تحت أخمصك الحشر % 12(@)(@@) % غدا غدوة والحمد نسج ردائه % فلم ينصرف إلا وأكفانه الأجر % 13(@)(@@) % تردى ثياب الموت حمرا فما أتى % % لها الليل إلا وهي من سندس خضر % 14(@)(@@) % كأن بني نبهان يوم وفاته % % نجوم سماء خر من بينها البدر % 15(@)(@@) % يعزون عن ثاو ت عزى به العلى % % ويبكي عليه الجود والبأس والشعر % 16(@)(@@) % وأني لهم صبر عليه وقد مضى % % إلى الموت حتى استشهدوا هو والصبر ! % 17(@)(@@) % فتى كان عذب الروح لامن غضاضة % ولكن كبرا أن يقال به كبر ! % 18(@)(@@) % فتى سلبته الخيل وهو حمى لها % % وبزته نار الحرب وهو لها جمر 
ms148	 % 19(@)(@@) % وقد كانت البيض المآثير في الوغى % % بواتر فهي الآن من بعده بتر % 20(@)(@@) % أمن بعد طي الحادثات محمدا % يكون لأثواب الندى أبدا نشر ؟ ! % PageV01P495 21(@)(@@) % إذا شجرات العرف جذت أصولها % % ففي أي فرع يوجد الورق النضر ؟ % 22(@)(@@) % لئن أبغض الدهر الخؤون لفقده % لعهدي به ممن يحب له الدهر % 23(@)(@@) % لئن غدرت في الروع أيامه به % لما زالت الأيام شيمتها الغدر % 24(@)(@@) % لئن ألبست فيه المصيبة طيء % لما عريت منها تميم ولا بكر % 25(@)(@@) % كذلك ما ننفك نفقد هالكا % يشاركنا في فقده البدو والحضر % 26(@)(@@) % سقى الغيث غيثا وارت الأرض سخصه % % وإن لم يكن فيه سحاب ولا قطر % 27(@)(@@) % وكيف احتمالي للسحاب صنيعة % بإسقائها قبرا وفي لحده البحر ! % 28(@)(@@) % مضى طاهر الأثواب لم تبق روضة % غداة ثوى إلا اشتهت أنها قبر % 29(@)(@@) % ثوى في الثرى من كان يحيا به الثرى % % ويغمر صرف الدهر نائله الغمر % 30(@)(@@) % عليك سلام الله وقفا فإنني % % رأيت الكريم الحر ليس له عمر % PageV01P496 البحر : خفيف تام 1(@)(@@) % ياعليلا حشا الجوانح نارا % % كان لي فيك حافظ الجار جارا % % 2(@)(@@) % معدن الحسن والملاحة قد % % بح للسقم معدنا وقرارا % % 3(@)(@@) % إن وجه الحمى لوجه صفيق % حين تسطو به نهارا جهارا % % 4(@)(@@) % لم تشن وجهه المليح ولكن % % جعلت ورد وجنتيه بهارا % % PageV01P497 البحر : طويل 1(@)(@@) % شجا في الحشى ترداده ليس يفتر % به صمن آمالي وإني لمفطر % 2(@)(@@) % حلفت بمستن المنى تسترشه % سحابة كف بالرغائب تمطر % 3(@)(@@) % إذا درجت فيه الصبا كفكفت لها % % وقام يباريها أبو الفضل جعفر % 4(@)(@@) % بسيب كأن السيف من ثر نؤيه % وأندية منها ندى النوء يعصر % 5(@)(@@) % لقد زينت الدنيا بأيام ماجد % به الملك يبهى والمفاخر تفخر % 6(@)(@@) % فتى من يديه البأس يضحك والندى % % وفي سرجه بدر وليث غضنفر % 7(@)(@@) % به ائتلفت آمال وافدة المنى % % وقامت لديه جمة تتشكر % 8(@)(@@) % أبا الفضل إني يوم جئتك مادحا % رأيت وجوه الجود والنجح تزهر % 9(@)(@@) % وأيقنت أني فالج غمر زاخر % تثوب إليه بالسماحة أبحر % 10(@)(@@) % فلا شيء أمضى من رجائك في الندى 
ms149	 % % ولا شيء أبقى من ثناء يحبر % PageV01P498 11(@)(@@) % وماتنصر الأسياف نصر مديحة % لها عند أبواب الخلائف محضر % 12(@)(@@) % إذا ما انطوى عنها اللئيم بسمعه % يكون لها عند الأكارم منشر % 13(@)(@@) % لها بين أبواب الملوك مزامر % من الذكر لم تنفخ ولا تتزمر % 14(@)(@@) % حوت راحتاه الباس والجود والندى % % ونال الحجا فالجهل حيران أزور % 15(@)(@@) % فلا يدع الإنجاز يملك أمره % % ويقدمه في الجود مطل مؤخر % 16(@)(@@) % إليك بها عذراء زفت كأنها % % عروس عليها حليها يتكسر % 17(@)(@@) % تزف إليكم يابن نصر كأنها % % حليلة كسرى يوم آواه قيصر % 18(@)(@@) % أبا الفضل إن الشعر مما يميته % إباء الفتى والمجد يحيا ويقبر % PageV01P499 البحر : طويل 1(@)(@@) % عزاء فلم يخلد حوي ولاعمرو % % وهل أحد يبقى وإن بسط العمر ؟ % 2(@)(@@) % سيأكلنا الدهر الذي غال من نرى % % ولا تنقضي الأشياء أو يؤكل الدهر % 3(@)(@@) % وأكثر حالات ابن آدم خلقة % يضل إذا فكرت في كنهها الفكر % 4(@)(@@) % فيفرح بالشيء المعار بقاؤه % ويحزن لما صار وهو له ذخر ! % 5(@)(@@) % عليك بثوب الصبر إذ فيه ملبس % فإن ابنك المحمود بعد ابنك الصبر % 6(@)(@@) % وما أوحش الرحمن ساحة عبده % إذا عاين الجلى ومؤنسه الأجر % PageV01P500 البحر : سريع 1(@)(@@) % و قهوة كوكبها يزهر % يسطع منها المسك والعنبر % 2(@)(@@) % وردية يحثها شادن % كأنها من خده تعصر % 3(@)(@@) % ما زال قلبي مذ تعلقته % أعمى من الهجران ما يبصر % 4(@)(@@) % مهفهف لم يبتسم ضاحكا % مذ كان الاكسد الجوهر % 5(@)(@@) % بحبه يقبرني قابري % % مسد مماتي وبه أنشر % PageV01P501 البحر : طويل 1(@)(@@) % أأحمد إن الحاسدين كثير % ومالك إن عد الكرام نظير % 2(@)(@@) % حللت محلا فاضلا متقدما % من المجد والفخر القديم فخور % 3(@)(@@) % فكل قوي أو غني فإنه % إليك ولو نال السماء فقير % 4(@)(@@) % إليك تناهى المجد من كل وجهة % يصير فما يعدوك حين تصير % 5(@)(@@) % وبدر إياد أنت لا ينكرونه % % كذاك إياد للأنام بدور % 6(@)(@@) % فما من ندى إلا إليك محله % ولا رفقة إلا إليك تسير % 7(@)(@@) % تجنبت أن تدعى الأمير تواضعا % وأنت لمن يدعى الأمير أمير % PageV01P502 البحر : وافر تام 1(@)(@@) % كفاني من 
ms150	 حوادث كل دهر % بإسحق بن إبراهيم جارا % % 2(@)(@@) % سيكفيني الحوادث مصعبي % كأن جبينه قمر أنارا % % 3(@)(@@) % على ثقة وأنت لذاك أهل % أخذت بحبل ذمتك اختيارا % % 4(@)(@@) % بإسحق بن إبراهيم أضحت % سماء الجود تنهمر انهمارا % % 5(@)(@@) % فتى بنواله في كل قوم % أقام لكل مكرمة نجارا % % 6(@)(@@) % عقدت بحبله حبلي فأضحت % قواه لا أخاف لها انبتارا % % 7(@)(@@) % لكم نعم غواد ساريات % علي مننتم فيها مرارا % % 8(@)(@@) % شكرتكم بها سرا وجهرا % وأنجد فيكم مدحي وغارا % % 9(@)(@@) % نفضلكم على الأقوام إنا % % رأينا الملك حل بكم وسارا % % 10(@)(@@) % لقد عمت فضولكم وخصت % ذوي يمن كما سلبت نزارا % % PageV01P503 11(@)(@@) % تخيرك الإمام على رجال % لأمته فما حرم الخيارا % % 12(@)(@@) % وليت المسلمين فلم تضيع % أمورهم الصغار ولا الكبارا % % 13(@)(@@) % براك الله من كرم وجود % وألبسك المهابة والوقارا % % 14(@)(@@) % إذا ما كان جارك مصعبيا % فلا ضيرا تخاف ولا افتتارا % % PageV01P504 البحر : بسيط تام 1(@)(@@) % سهرت فيك فلم أجحد يد السهر % وطال فكري ولاعتب على الفكر % 2(@)(@@) % نادمت ذكرك والظلماء عاكفة % فكان ياسيدي أحلى من السمر % 3(@)(@@) % فإن ترى عبرتي والشوق يسفحها % % لما التفت إلى شيء من المطر % 4(@)(@@) % يا من إذا قلت يا من لا نظير له % في حسنه قيل لي يا أصدق البشر % 5(@)(@@) % ما إن أرى وجهك المكنون جوهره % % ياأملح الناس إلا نسخة القمر % PageV01P505 البحر : بسيط تام 1(@)(@@) % يا وارث الملك إن الملك محتبس % وقف عليك إلى أن تنشر الصور % 2(@)(@@) % لم يذكر الجود إلا خضت واديه % ولا انتضي السيف إلا خافك القدر % 3(@)(@@) % ما ضر من أصبح المأمون سائسه % أن لم يسسه أبو بكر ولا عمر % 4(@)(@@) % وما على الأرض والمأمون يملكها % % أن لا تضيء لنا شمس ولا قمر % PageV01P506 البحر : خفيف تام 1(@)(@@) % يا سمي النبي في سورة الج % % ن ويا ثاني العزيز بمصر % 2(@)(@@) % تركت ليلة الصراة بقلبي % % جمر شوق احر من كل جمر % 3(@)(@@) % باشر الماء فهو في رقة الصن % % عة كالماء غير أن ليس يجري % % 4(@)(@@) % خمش الماء جلده الرطب حتى % % خلته لابسا غلالة 
ms151	 خمر % PageV01P507 البحر : طويل 1(@)(@@) % أصم بك الناعي وإن كان أسمعا % % وأصبح مغنى الجود بعدك بلقعا % % 2(@)(@@) % للحد أبي نصر تحية مزنة % إذا هي حيت معمرا عاد ممرعا % % 3(@)(@@) % فلم ار يوما كان أشبه ساعة % بيومي من اليوم الذي فيه ودعا % % 4(@)(@@) % مصيف أفاض الحزن فيه جداولا % من الدمع حتى خلته عاد مربعا % % 5(@)(@@) % ووالله لا تقضي العيون الذي له % عليها ولو صارت مع الدمع أدمعا % % 6(@)(@@) % فتى كان شربا للعفاة ومرتعا % فأصبح للهندية البيض مرتعا % % 7(@)(@@) % فتى كلما ارتاد الشجاع من الردى % % مفرا غداة المأزق ارتاد مصرعا % % 8(@)(@@) % إذا ساء يوم في الكريهة منظرا % تصلاه علما أن سيحسن مسمعا % % 9(@)(@@) % فإن ترم عن عمر تدانى به المدى % % فخانك حتى لم يجد فيك منزعا % % 10(@)(@@) % فما كنت إلا السيف لاقى ضريبة % فقطعها ثم انثنى فتقطعا ! % PageV01P508 البحر : منسرح 1(@)(@@) % هل أثر من ديارهم دعس % حيث تلاقى الأجراع والوعس % 2(@)(@@) % مخبر السائر الرذية في ال % أطلال أين الجآذر اللعس % 3(@)(@@) % لا تسألنها فليس يسمع جرس ال % % قول إلا شخص له جرس % 4(@)(@@) % ولايراخي عذل المعنسة ال % خرقاء إلا الشملة العنس % 5(@)(@@) % وراكد الهم كالزمانة وال % % بيت إذا ما ألفته رمس % 6(@)(@@) % نعم متاع الدنيا حباك به % أروع لا جيدر ولاجبس % 7(@)(@@) % أصغر منها كأنه محة ال % بيضة ، صاف كأنه عجس % 8(@)(@@) % هاديه جذع من الأراك وما % % خلف الصلا منه صخرة جلس % 9(@)(@@) % يكاد يجري الجادي من ماء عط % فيه ويجنى من متنه الورس % 10(@)(@@) % هذب في جنسه ونال المدى % % بنفسه فهو وحده جنس % PageV01P509 11(@)(@@) % أحزر آباؤه الفضيلة مذ % تفرست في عروقها الفرس % 12(@)(@@) % ليس بديعا منه ولا عجبا % أن يطرق الماء ورده خمس % 13(@)(@@) % يترك ما مر مذ قبيل به % كأن أدنى عهد به الأمس % 14(@)(@@) % وهو إذا ما ناجاه فارسه % يفهم عنه ما يفهم الإنس % 15(@)(@@) % وهو ولما تهبط ثنيته % لا الربع في جريه ولا السدس % 16(@)(@@) % وهو إذا ما رمى بمقلته % كانت سخاما كأنها نقس % 17(@)(@@) % وهو إذا ما أعرت غرته 
ms152	 % عينيك لاحت كأنها برس % 18(@)(@@) % ضمخ من لونه فجاء كأن % قد كسفت في أديمه الشمس % 19(@)(@@) % كل ثمين من الثواب به % غير ثنائي فإنه بخس % 20(@)(@@) % شذب همي به صقيل ن ال % % فتيان أقطار عرضه ملس % PageV01P510 21(@)(@@) % سامي القذالين والجبين ، إذا % % نكس من لؤم فعله النكس % 22(@)(@@) % أبو علي أخلاقه زهر % غب سماء وروحه قدس % 23(@)(@@) % أبيض قدت قد الشراك شرا % % ك السبت بيني وبينه النفس % 24(@)(@@) % للمجد مستشرف وللأدب ال % % مجفو ترب وللندى حلس % 25(@)(@@) % وحومة للخطاب فرجها وال % قوم عجم في مثلها خرس % 26(@)(@@) % شك حشاها بخطبة عنن % كأنها منه طعنة خلس % 27(@)(@@) % أروع لا من رياحه الحرجف ال % % صر ولا من نجومه النحس % 28(@)(@@) % يشتاقه من كماله غده % ويكثر الوجد نحوه الأمس % 29(@)(@@) % ردي لطرفي عن وجهه زمن % وساعتي من فراقه حرس % 30(@)(@@) % أيامنا في ظلاله أبدا % فصل ربيع ودهرنا عرس % PageV01P511 31(@)(@@) % لا كأناس قد أصبحوا صدأ ال % % عيش كأن الدنيا بهم حبس % 32(@)(@@) % القرب منهم بعد من الروح وال % وحشة من مثلهم هي الأنس % 33(@)(@@) % تلك خلال وقف عليك ابن وه % ب بن سعيد عتاقها حبس % 34(@)(@@) % آبر حمد يرى الرجال هم % سر الثرى والعلى هي الغرس % PageV01P512 البحر : كامل تام 1(@)(@@) % بأبي وغير أبي وذاك قليل % ثاو عليه ثرى النباج مهيل % 2(@)(@@) % خذلته أسرته كأن سراتهم % جهلوا بأن الخاذل المخذول % 3(@)(@@) % أكال أشلاء الفوارس بالقنا % % أضحى بهن وشلوه مأكول ! % 4(@)(@@) % كفي فقتل محمد لي شاهد % أن العزير مع القضاء ذليل % 5(@)(@@) % إن يستضم بعد الإباء فإنه % % قد يستضام المصعب المعقول % 6(@)(@@) % مستحسن وجه الردى في معرك % وجه الحياة بحومتيه جميل % 7(@)(@@) % أنسى أبا نصر نسيت إذن يدي % % في حيث ينتصر الفتى وينيل ! % 8(@)(@@) % هيهات لا يأتي الزمان بمثله % إن الزمان بمثله لبخيل ! % 9(@)(@@) % ما أنت بالمقتول صبرا إنما % % أملي غداة نعيك المقتول % 10(@)(@@) % للسيف بعدك حرقة وعويل % وعليك للمجد التليد غليل % PageV01P513 11(@)(@@) % إن طال يومك في الوغى فلقد ترى % % فيه ويوم الهام منك طويل % 12(@)(@@) % فستذكر 
ms153	 الخيل انصلاتك في السرى % % والقفر معروف الردى مجهول % 13(@)(@@) % وتفلل الأحساب بعدك والنهى % % والبيض ملس ما بهن فلول % 14(@)(@@) % من ذا يحدث بالبقاء ضميره % % هيهات أنت على الفناء دليل ! % 15(@)(@@) % يا ليت شعري بالمكارم كلها % % ماذا وقد فقدت نداك تقول ؟ % 16(@)(@@) % كم مشهد قد جددته لك العلا % وكأنه بالأمس وهو محيل % 17(@)(@@) % وكتيبة كتبت لها أرواحها % % واليوم أحمر من دم مصقول % 18(@)(@@) % ماشك أثبتهم يقينا أنه % % للموت في قبض النفوس رسول % 19(@)(@@) % يا يوم قحطبة لقد أبقيت لي % % حرقا أرى أيامها ستطول % 20(@)(@@) % ليث لو أن الليث قام مقامه % % لانصاع وهو يراعة إجفيل % PageV01P514 21(@)(@@) % لما رأى جمعا قليلا في الوغى % % وأولو الحفاظ من القليل قليل % 22(@)(@@) % لاقى الكريهة وهو مغمد روعه % % فيها ولكن سيفه مسلول % 23(@)(@@) % ومشى إلى الموت الزوام كأنما % % هو في محبته إليه خليل % 24(@)(@@) % لم يود منه واحد لكنما % % أودى به من أسودان قبيل % 25(@)(@@) % أضحت عراص محمد ومحمد % وأخيهما وكأنهن طلول % 26(@)(@@) % أبني حميد ليس أول ماعفا % % بعد الأسود من الأسود الغيل % 27(@)(@@) % ما زال ذاك الصبر وهو عليكم % بالموت في ظل السيوف كفيل % 28(@)(@@) % مستبسلون كأنما مهجاتهم % ليست لهم إلا غداة تسيل % 29(@)(@@) % ألفوا المنايا فالقتيل لديهم % من لاتجلي الحرب وهو قتيل % 30(@)(@@) % إن كان ريب الدهر أثكلنيهم % فالدهر أيضا ميت مثكول % PageV01P515 البحر : - 1(@)(@@) % ثقيل ردف دقيق خصر % شقيق شمس نتيج بدر % 2(@)(@@) % بديع حسن رشيق قد % مليح خد نقي ثغر % 3(@)(@@) % قضيب بان عليه بدر % مثال حسن عروس خدر % 4(@)(@@) % ياخصر قد كنت دا استتار % في الحب حتى هتكت ستري % % 5(@)(@@) % نمت دموعي على عذابي % % اذ غاب عني جميل صبري % % PageV01P516 البحر : منسرح 1(@)(@@) % قالت وعي النساء كالخرس % وقد يصبن الفصوص في الخلس % 2(@)(@@) % هل يرجعن غير جانب فرسا % ذو سبب في ربيعة الفرس % 3(@)(@@) % كأنني قد وردت ساحتها % % بمسمح في قياده سلس % 4(@)(@@) % أحمر منها مثل السبيكة أو % % أحوى به كاللمى أو اللعس % 5(@)(@@) % أو أدهم فيه كمتة أمم % كأنه قطعة من الغلس % 6 
ms154	(@)(@@) % مبتل متن وصهوتين إلى % % حوافر صلب له ملس % 7(@)(@@) % فهو لدى الروع والحلائب ذو % % أعلى مندى وأسفل يبس % 8(@)(@@) % يكبر أن يستحم في الحر والقر % م حميما يزيد في النجس % 9(@)(@@) % مخلق وجهه على السبق تخلي % % ق عروس الأبناء للعرس % 10(@)(@@) % حر له سورة لدى الزجر والسو % ط وعبد العنان والمرس % PageV01P517 11(@)(@@) % فهو يسر الرواض بالنزق السا % % كن منه واللين والشرس % 12(@)(@@) % صهصلق في الصهيل تحسبه % % أشرج حلقومه على جرس % 13(@)(@@) % تقتل عشرا من النعام به % % بواحد الشد واحد النفس % 14(@)(@@) % حلفت بالبيت ذي الملبين في ال % % إحرام والحل قبل والحمس % 15(@)(@@) % أن ابن طوق بن مالك ملك % مالك أمر المكارم الشمس % 16(@)(@@) % خلائق فيه غضة جدد % ليست بمنهوكة ولا لبس % 17(@)(@@) % لا برد أدنى ولا إزار على % % مخزية تتقى ولا دنس % 18(@)(@@) % مفترس ماله ولست ترى % % فريسة عرضه لمفترس % 19(@)(@@) % كأنني قد رأيت زلفته % عند إمام بقربه أنس % 20(@)(@@) % تبنى المعالي في ظله وله % حظ من الملك غير مختلس % PageV01P518 21(@)(@@) % فإن موسى وصلى على روحه الرب % م صلاة كثيرة القدس % 22(@)(@@) % صار نبيا وعظم بغيته % في جذوة للصلاء أو قبس % PageV01P519 البحر : طويل 1(@)(@@) % جوى ساور الأحشاء والقلب واغله % ودمع يضيم العين والجفن هامله % 2(@)(@@) % وفاجع موت لا عدوا يخافه % فيبقي ولا يبقي صديقا يجامله % 3(@)(@@) % وأي أخي عزاء أو جبرية % ينابذه أو رام يناضله % 4(@)(@@) % إذا ما جرى مجرى دم المرء حكمه % وبثت على طرق النفوس حبائله % 5(@)(@@) % فلو شاء هذا الدهر أقصر شره % كما قصرت عنا لهاه ونائله % 6(@)(@@) % سنشكوه إعلانا وسرا ونية % شكية من لا يستطيع يقاتله % 7(@)(@@) % فمن مبلغ عني ربيعة أنه % % تقشع طل الجود منها ووابله % 8(@)(@@) % وأن الحجى منها استطارت صدوعه % % وأن الندى منها أصيبت مقاتله ؟ % 9(@)(@@) % مضى للزيال القاسم الواهب اللهى % % ولو لم يزايلنا لكنا نزايله % 10(@)(@@) % ولم يعلموا أن الزمان يريده % % بفجع ولا أن المنايا تراسله % PageV01P520 11(@)(@@) % فتى سيط حب المكرمات بلحمه % وخامره حق السماح وباطله % 12(@)(@@) % فتى لم يذق سكر الشباب 
ms155	 ولم تكن % تهب شمالا للصديق شمائله % 13(@)(@@) % فتى جاءه مقداره واثنتا العلا % % يداه وعشر المكرمات أنامله % 14(@)(@@) % فتى ينفج الأقوام من طيب ذكره % ثناء كأن العنبر الورد شامله % 15(@)(@@) % لقد فجعت عتابه وزهيره % وتغلبه أخرى الليالي ووائله % 16(@)(@@) % وكان لهم غيثا وعلما فمعدم % فيسأله أو باحث فيسائله % 17(@)(@@) % ومبتدر المعروف تسري هباته % % إليهم ولاتسري إليهم غوائله % 18(@)(@@) % فتى لم تكن تغلي الحقود بصدره % وتغلي لأضياف الشتاء مراجله % 19(@)(@@) % مليك لأملاك تضيف ضيوفه % % ويرجى مرجيه ويسأل سائله % 20(@)(@@) % طواه الردى طي الكتاب وغيبت % فضائله عن قومه وفواضله % PageV01P521 21(@)(@@) % طوى شيما كانت تروح وتغتدي % % وسائل من أعيت عليه وسائله % 22(@)(@@) % فيا عارضا للعرف أقلع مزنه % % ويا واديا للجود جفت مسائله % 23(@)(@@) % ألم ترني أنزفت عيني على أبي % % محمد النجم المشرق آفله % 24(@)(@@) % وأخضلتها فيه كما لو أتيته % % طريد الليالي أخضلتني نوافله ! % 25(@)(@@) % ولكنني أطري الحسام إذا مضى % % وإن كان يوم الروع غيري حامله ! % 26(@)(@@) % وآسى على جيحان إذ غاض ماؤه % % وإن كان ذودا غير ذودي ناهله % 27(@)(@@) % عليك أبا كلثوم الصبر إنني % % أرى الصبر أخراه تقى وأوائله % 28(@)(@@) % تعادل وزنا كل شيء ولا أرى % % سوى صحة التوحيد شيئا يعادله % 29(@)(@@) % فأنت سنام للفخار وغارب % وصنواك منه منكباه وكاهله % 30(@)(@@) % وليست أثافي القدر إلا ثلاثها % % ولا الرمح إلا لهذماه وعامله % PageV01P522 البحر : كامل تام 1(@)(@@) % ما في وقوفك ساعة من باس % نقضي ذمام الأربع الأدراس % 2(@)(@@) % فلعل عينك أن تعين بمائها % % والدمع منه خاذل ومواس % 3(@)(@@) % لايسعد المشتاق وسنان الهوى % % يبس المدامع بارد الأنفاس % 4(@)(@@) % إن المنازل ساورتها فرقة % أخلت من الآرام كل كناس % 5(@)(@@) % من كل ضاحكة الترائب أرهفت % % إرهاف خوط البانة المياس % 6(@)(@@) % بدر أطاعت فيك بادرة النوى % % ولعا وشمس أولعت بشماس % 7(@)(@@) % بكر إذا ابتسمت أراك وميضها % % نور الأقاحي في ثرى ميعاس % 8(@)(@@) % وإذا مشت تركت بصدرك ضعف ما % % بحليها من كثرة الوسواس % 9(@)(@@) % قالت وقد حم الفراق فكأسه % % قد خولط الساقي بها والحاسي % % 10(@)(@@) % لاتنسين تلك العهود فإنما % % سميت إنسانا 
ms156	 لأنك ناسي % % PageV01P523 11(@)(@@) % إن الذي خلق الخلائق قاتها % % أقواتها لتصرف الأحراس % 12(@)(@@) % فالأرض معروف السماء قرى لها % % وبنو الرجاء لهم بنو العباس % 13(@)(@@) % القوم ظل الله أسكن دينه % % فيهم وهم جبل الملوك الراسي % % 14(@)(@@) % في كل جوهرة فرند مشرق % وهم الفرند لهؤلاء الناس % 15(@)(@@) % هدأت عل تأميل أحمد همتي % % وأطاف تقليدي به وقياسي % % 16(@)(@@) % بالمجتبى والمصطفى والمسترى % % للحمد والحالي به والكاسي % % 17(@)(@@) % والحمد برد جمال اختالت به % غرر الفعال وليس برد لباس % 18(@)(@@) % فرع نما من هاشم في تربة % كان الكفيء لها من الأغراس % 19(@)(@@) % لا تهجر الأنواء منبتها ولا % % قلب الثرى القاسي عليها قاسي % % 20(@)(@@) % وكأن بينهما رضاع الثدي من % فرط التصافي أو رضاع الكاس % PageV01P524 21(@)(@@) % نور العرارة نوره ونسيمه % نشر الخزامى في اخضرار الآس % 22(@)(@@) % أبليت هذا المجد أبعد غاية % فيه وأكرم شيمة ونحاس % 23(@)(@@) % إقدام عمرو في سماحة حاتم % في حلم أحنف في ذكاء إياس % 24(@)(@@) % لا تنكروا ضربي له من دونه % مثلا شرودا في الندى والباس % 25(@)(@@) % فالله قد ضرب الأقل لنوره % مثلا من المشكاة والنبراس % 26(@)(@@) % إن تحو خصل المجد في أنف الصبا % % يابن الخليفة يا أبا العباس % 27(@)(@@) % فلرب نار منكم قد أنتجت % في الليل من قبس من الأقباس % 28(@)(@@) % ولرب كفل في الخطوب تركته % لصعابها حلسا من الأحلاس % 29(@)(@@) % أمددته في العدم والعدم الجوى % % بالجود والجود الطبيب الآسي % % 30(@)(@@) % آنسته بالدهر حتى أنه % ليظنه عرسا من الأعراس % PageV01P525 31(@)(@@) % غلب السرور على همومي بالذي % % أظهرت من بري ومن إيناسي % % 32(@)(@@) % عدل المشيب على الشباب ولم يكن % % من كبرة لكنه من ياس % 33(@)(@@) % أثر المطالب في الفؤاد وإنما % % أثر السنين ووسمها في الراس % 34(@)(@@) % فالآن حين غرست في كرم الثرى % % تلك المنى وبنيت فوق أساس % PageV01P526 البحر : كامل تام 1(@)(@@) % مازالت الأيام تخبر سائلا % % أن سوف تفجع مسهلا أو عاقلا % % 2(@)(@@) % إن المنون إذا استمر مريرها % % كانت لها جنن الأنام مقاتلا % % 3(@)(@@) % في كل يوم يعتبطن نفوسنا % % عبط المنحب جلة وأفائلا % % 4(@)(@@) % ما إن ترى شيئا 
ms157	 لشيء محييا % حتى تلاقيه لآخر قاتلا % % 5(@)(@@) % من ذاك أجهد أن لا أراه فلا أرى % % حقا سوى الدنيا يسمى باطلا % % 6(@)(@@) % لله أية لوعة ظلنا بها % % تركت بكيات العيون هواملا ! % 7(@)(@@) % مجد تأوب طارقا حتى إذا % % قلنا أقام الدهر أصبح راحلا % % 8(@)(@@) % نجمان شاء الله ألا يطلعا % % إلا ارتداد الطرف حتى يأفلا % % 9(@)(@@) % إن الفجيعة بالرياض نواضرا % لأجل منها بالرياض ذوابلا % % 10(@)(@@) % لو ينسآن لكان هذا غاربا % للمكرمات وكان هذا كاهلا % % PageV01P527 11(@)(@@) % لهفي على تلك الشواهد فيهما % % لو أمهلت حتى تكون شمائلا % % 12(@)(@@) % لغدا سكونهما حجى وصباهما % % حلما وتلك الأريحية نائلا % % 13(@)(@@) % ولأعقب النجم المرذ بديمة % ولعاد ذاك الطل جودا وابلا % % 14(@)(@@) % إن الهلال إذا رأيت نموه % أيقنت أن سيكون بدرا كاملا % % 15(@)(@@) % قل للأمير وإن لقيت موقرا % منه بريب الحادثات حلاحلا % % 16(@)(@@) % إن تزز في طرفي نهار واحد % رزئين هاجا لوعة وبلابلا % % 17(@)(@@) % فالثقل ليس مضاعفا لمطية % % إلا إذا ما كان وهما بازلا % % 18(@)(@@) % لاغرو إن فننان من عيدانه % لقيا حماما للبرية آكلا % % 19(@)(@@) % إن الأشاء إذا أصاب مشذب % منه اتمهل ذرى وأث أسافلا % % 20(@)(@@) % حقفان هالهما القضاء وغادرا % % قللا لنا دون السماء قواعلا % % PageV01P528 21(@)(@@) % رضوى وقدس ويذبلا وعماية % ويرمرما ومتالعا ومواسلا % % 22(@)(@@) % الطاهرين وإخوة أنجبتهم % كالحوم وجه صادرا أو ناهلا % % 23(@)(@@) % شمخت خلالك أن يؤسيك امرؤ % أو أن تذكر ناسيا أو غافلا % % 24(@)(@@) % إلا مواعظ قادها لك سمحة % إسجاح لبك سامعا أو قائلا % % 25(@)(@@) % هل تكلف الأيدي بهز مهند % إلا إذا كان الحسام القاصلا % % PageV01P529 البحر : كامل تام 1(@)(@@) % من أين لي صبر على الهجر % لو أن قلبي كان من صخر ؟ % 2(@)(@@) % ويل لجسمي من دواعي الهوى % % ويل معي يدخل في القبر % % 3(@)(@@) % لو كنت أرعى النجم تقوى لقد % أدرك طرفي ليلة القدر % PageV01P530 البحر : بسيط تام 1(@)(@@) % أحيا حشاشة قلب كان مخلوسا % ورم بالصبر عقلا كان مألوسا % % 2(@)(@@) % سرى رداء الهوى في حين جدته % واها له منه مسرورا وملبوسا ! % 3(@)(@@) % لو تشهدين أقاسي الدمع منهمرا % والليل مرتتج الأبواب مطموسا 
ms158	 % % 4(@)(@@) % إستنبت القلب من لوعاته شجرا % من الهموم فأجنته الوساويسا % % 5(@)(@@) % أهل الفراديس لم أعدد لذكركم % إلا رعى وسقى الله الفراديسا % % 6(@)(@@) % إذ لا نعطل منها منظرا أنقا % ومربعا بمها اللذات مأنوسا % % 7(@)(@@) % قد قلت لما اطلخم الأمر وانبعثت % عشواء تالية غبسا دهاريسا % % 8(@)(@@) % لي حرمة بك أمسى حق نازلها % % وقفا عليك - فدتك النفس - محبوسا % % 9(@)(@@) % كم دعوة لي إذا مكروهة نزلت % واستفحل الخطب يا عياش ياعيسى % % 10(@)(@@) % لله أفعال عياش وشيمته % يزدنه كرما إن ساس أو سيسا % % PageV01P531 11(@)(@@) % ما شاهد اللبس إلا كان متضحا % ولانأى الحق إلا كان ملبوسا % % 12(@)(@@) % فاضت سحائب من نعمائه فطمت % نعماه بالبؤس حتى اجتثت البوسا % % 13(@)(@@) % يحرسن بالبذل عرضا ما يزال من ال % % آفات بالنفحات الغر محروسا % % 14(@)(@@) % فرع سما في سماء العز متخذا % أصلا ثوى في قرار المجد مغروسا % % 15(@)(@@) % ليث ترى كل يوم تحت كلكله % ليثا من الإنس جهم الوجه مفروسا % % 16(@)(@@) % أهيس أليس مشاء إلى همم % تغرق العيس في آذيها الليسا % % 17(@)(@@) % نافس أهل العلى فاحتاز عقلهم % منهم فأصبح معطى الحق منفوسا % % 18(@)(@@) % تجري السعود له في كل نائبة % نابت وإن كان يوم البأس منحوسا % 19(@)(@@) % له لواء ندى ما هز عامله % إلا أراك لواء البخل منكوسا % % 20(@)(@@) % مقابل في بني الأذواء منصبه % عيصا فعيصا وقدموسا فقدموسا % % PageV01P532 21(@)(@@) % الواردين حياض الموت متأقة % ثبا ثبا وكراديسا كراديسا % % 22(@)(@@) % والمانعين حياض المجد إن دهمت % منع الضراغم آجاما وعريسا % % 23(@)(@@) % نموك قنعاس دهر حين يحزبه % % أمر يشابه آباء قناعيسا % % 24(@)(@@) % وقدموا منك إن هم خاطبوا ذربا % ورادسوا حضرمي الصخر رديسا % % 25(@)(@@) % أشم أصيد تكوي الصيد غرته % كيا وأشوس يعشي الأعين الشوسا % % 26(@)(@@) % شامت بروقك آمالي بمصر ولو % % أصبحت بالطوس لم استبعد الطوسا % % PageV01P533 البحر : طويل 1(@)(@@) % ذكرت محمدا بقتل محمد % وقحطبة ذكرا طويل البلابل % 2(@)(@@) % وكان الأسى قد آل فيه إلى الحشا % % فلما استجراه جرى في المفاصل % 3(@)(@@) % كماء الغدير امتد بعد وقوعه % % بما هاج من فيض التلاع القوابل % 4(@)(@@) % ثووا في الثرى من بعدما 
ms159	 سربلوا العلا % % ومن بعدما سموا نجوم المحافل % 5(@)(@@) % مصارع لم تورث شنارا وإنها % % ليرتع فيها شامت عند جاهل % 6(@)(@@) % لعمرك ماكانوا ثلاثة أخوة % % ولكنهم كانوا ثلاث قبائل % PageV01P534 البحر : سريع 1(@)(@@) % معتمدا كالغصن الناضر % ابلج مثل القمر الزاهر % % 2(@)(@@) % جفونه ترشق أهل الهوى % % باسهم من طرفه الفاتر % 3(@)(@@) % قد قلتث لما لج في صده % إعطف على عبدك يا قابري % % 4(@)(@@) % إن لم تجد لي صحت بين الورى % % ويلاه من ظبي بني عامر % PageV01P535 البحر : كامل تام 1(@)(@@) % أقشيب ربعهم أراك دريسا % % وقرى ضيوفك لوعة ورسيسا % % 2(@)(@@) % ولئن حبست على البلى لقد اغتدى % % دمعي عليك إلى الممات حبيسا % % 3(@)(@@) % فكأن طسما قبل كانوا جيرة % بك والعماليق الألى وجديسا % % 4(@)(@@) % وأرى ربعك موحشات بعدها % % قد كنت مألوف المحل أنيسا % % 5(@)(@@) % وبلاقعا حت كأن قطينها % % حلفوا يمينا أخلقتك غموسا % % 6(@)(@@) % أترى الفراق يظن أني غافل % عنه وقد لمست يداه لميسا % % 7(@)(@@) % رود أصابتها النوى في خرد % كانت بدور دجنة وشموسا % % 8(@)(@@) % بيض تدور عيونهن إلى الصبا % % فكأنهن بها يدرن كووسا % % 9(@)(@@) % وكأنما أهدى شقائقه إلى % % وجناتهن بها أبو قابوسا % % 10(@)(@@) % قد أوتيت من كل شيء بهجة % وددا وحسنا في الصبا مغموسا % % PageV01P536 11(@)(@@) % لولا حداثتها وأني لا أرى % % عرشا لها لظننتها بلقيسا % % 12(@)(@@) % إيها دمشق فقد حويت مكارما % بأبي المغيث وسؤددا قدموسا % % 13(@)(@@) % وأرى الزمان غدا عليك بوجهه % جذلان بساما وكان عبوسا % % 14(@)(@@) % قد بوركت تلك البطون وقدست % تلك الظهور بقربه تقديسا % % 15(@)(@@) % فصنيعة تسدى وخطب يعتلى % % وعظيمة تكفى وجرح يوسى % % 16(@)(@@) % الآن أمست للنفاق وأصبحت % عورا عيون كن قبلك شوسا % % 17(@)(@@) % وتركت تلك الأرض ظلا سجسجا % من بعد ماكادت تكون وطيسا % % 18(@)(@@) % لم يشعروا حتى طلعت عليهم % بدرا يشق الظلمة الحنديسا % % 19(@)(@@) % ما في النجوم سوى تعلة باطل % قدمت وأسس إفكها تأسيسا % % 20(@)(@@) % إن الملوك هم كواكبنا التي % % تخفى وتطلع أسعدا ونحوسا % % PageV01P537 21(@)(@@) % فتن جلوت ظلامها من بعد ما % % مدوا عيونا نحوها ورؤوسا % % 22(@)(@@) % حرب يكون الجيش فضل صبوحها % % ويكون فضل عبوقها الكردوسا % % 23(@)(@@) % غرم 
ms160	 امرىء من روحه فيها إذا % % ذو السلم أغرم مطعما ولبوسا % % 24(@)(@@) % كم بين قوم إنما نفقاتهم % % مال وقوم ينفقون نفوسا ! % 25(@)(@@) % سار ابن إبراهيم موسى سيرة % سكن الزمان لها وكان شموسا % % 26(@)(@@) % فأقر واسطة الشآم وأنشرت % كفاه جورا لم يزل مرموسا % % 27(@)(@@) % كانت مدينة عسقلان عروسها % % فغدت بسيرته دمشق عروسا % % 28(@)(@@) % من بعد ما صارت هنيدة صرمة % والبدرة النجلاء صارت كيسا % % 29(@)(@@) % فكأنهم بالعجل ضلوا حقبة % وكأن موسى إذ أتاهم موسى % % 30(@)(@@) % وستشكر النعمى التي صنعت ولا % % نعم كنعمى أنقذت من بوسى % % PageV01P538 31(@)(@@) % ألوى يذل الصعب إن هو ساسه % ويلين جانبه إذا ما سيسا % % 32(@)(@@) % ولذاك كانوا لا يرأس منهم % من لم يجرب حزمه مرؤوسا % % 33(@)(@@) % من لم يقد فيطير في خيشومه % رهج الخميس فلن يقود خميسا % % 34(@)(@@) % أعط الرياسة من يديك فلم تزل % من قبل أن تدعى الرئيس رئيسا % % 35(@)(@@) % ماذا عسيت ومن أمامك حية % تقص الأسود ومن ورائك عيسى % % 36(@)(@@) % أسدان شدا من دمشق وذللا % من حمص أمنع بلدة عريسا % % 37(@)(@@) % تخذ القنا خيسا فإن طاغ طغى % % نقلا إلى مغناه ذاك الخيسا % % 38(@)(@@) % أسق الرعية من بشاشتك التي % % لو أنها ماء لكان مسوسا % % 39(@)(@@) % إن الطلاقة والندى خير لهم % من عفة جمست عليك جموسا % % 40(@)(@@) % لو أن أسباب العفاف بلا تقى % نفعت لقد نفعت إذا إبليسا % % PageV01P539 41(@)(@@) % هذي القوافي قد أتينك نزعا % تتجسم التهجير والتغليسا % % 42(@)(@@) % من كل شاردة تغادر بعدها % % حظ الرجال من القصيد خسيسا % % 43(@)(@@) % وجديدة المعنى إذا معنى التي % % تشقى بها الأسماع كان لبيسا % % 44(@)(@@) % تلهو بعاجل حسنها وتعدها % % علقا لأعجاز الزمان نفيسا % % 45(@)(@@) % من دوحة الكلم التي لم تنفكك % يمسي عليك رصينها محبوسا % % 46(@)(@@) % كالنجم إن سافرت كان مواكبا % % وإذا حططت الرحل كان جليسا % % 47(@)(@@) % إنا بعثنا الشعر نحوك مفردا % وإذا أذنت لنا بعثنا العيسا % % 48(@)(@@) % تبغي ذراك إذا آسنة قعضب % أردين عريف الوغى المريسا % % PageV01P540 البحر : بسيط تام 1(@)(@@) % لا تعذلي جارتي إنى لك العذل % فلا شوى ما زريناه ولا جلل % 2(@)(@@) % إحدى المصائب 