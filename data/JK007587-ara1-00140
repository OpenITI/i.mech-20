ms121	 تام 1(@)(@@) % دنياي ناشزة فإن فارقتها % % طوعا ، وإلا فارقتني كارها % % 2(@)(@@) % إنا لننكر سوء عاقبة الورى % % فيها ، ونهواها على إنكارها % % 3(@)(@@) % كل بها كلف ، ومن يزهد يكن % في زهده متكلفا متكارها % % 4(@)(@@) % أذكرت نفسي مصرع الآباء من % % قبلي ، فما أصغت إلى إذكارها % % 5(@)(@@) % وعجبت منها كيف لم يجر الذي % % خلقت له يوما على أفكارها % % 6(@)(@@) % والموت إن لم يأت في إمسائها % % وافى مع الإصباح في إبكارها % % 7(@)(@@) % وأمامها السفر البعيد وقطعه % % بالبر ، لا بقرومها وبكارها % % 8(@)(@@) % والدهر يطرق بالخطوب ، وما لنا % % بعوانها أيد ولا أبكارها % % 9(@)(@@) % والترب أوكار الأنام ، وكلنا % % كالطير رائحة إلى أوكارها % % PageV01P618 البحر : طويل 1(@)(@@) % لك الحمد يا مولاي كم لك منة % علي ، وفضلا لا يقوم به شكري % % 2(@)(@@) % نزلت بهذا المسجد العام قافلا % من الغزو ، موفور النصيب من الأجر % 3(@)(@@) % ومنه رحلت العيس في عامي الذي % % مضى نحو بيت الله ذي الركن والحجر % % 4(@)(@@) % فأديت مفروضي ، وأسقطت ثقل ما % % تحملت من وزر السنين على ظهري % % PageV01P619 البحر : مجزوء الرمل 1(@)(@@) % أيها الظالم مهلا % أنت بالحاكم غر % 2(@)(@@) % كل ما استعذبت من جو % % جورك تعذيب وجمر % 3(@)(@@) % ليس يلقى دعوة المظ % % لوم دون الله ستر % 4(@)(@@) % فخف الله فما يخ % % فى عليه منه سر % 5(@)(@@) % يجمع الظالم والمظ % % لوم بعد الموت حشر % 6(@)(@@) % حيث لا يمنع سل % % ن ، ولا يسمع عذر % 7(@)(@@) % أو ما ينهاك عن ظل % % مك موت ثم قبر % % 8(@)(@@) % بعض ما فيه من ال % % هوال فيه لك زجر % PageV01P620 البحر : بسيط تام 1(@)(@@) % الناس كالطير ، والدنيا شباكهم % وهم بها بين ركاض ومختبط % % 2(@)(@@) % والموت قناصهم يأتي على مهل % % لهلكهم بين مذبوح ومعتبط % % 3(@)(@@) % وقد شغلنا بدنيانا وزخرفها % % فالخلق ما بين محزون ومغتبط % % 4(@)(@@) % هذا يسر بحال لا تدوم وذا % % يبكي على الفوت من دنياه والفرط % % 5(@)(@@) % وليس يسوى الذي نال الملوك من الد % % نيا ، فدع غيرهم ، كفا من العبط % % PageV01P621 البحر : رجز تام 1(@)(@@) % ما زلت في غبطة عيشي عالما % أن سيزول بالهموم ما غبط % % 2(@)(@@) % وأن صرف 
ms122	 الدهر يأتي بالذي % % ساء اعتمادا ، وبما سر غلط % 3(@)(@@) % بينا الفتى تعلو به جدوده % % إذ أسلمته للرزايا فهبط % % 4(@)(@@) % حتى يرق حاسد لحاله % % من بعد ما نافس فيها ، وغبط % PageV01P622 البحر : سريع 1(@)(@@) % من مبلغ المعتر والقانع % % وابن السبيل النازح النازع % 2(@)(@@) % أن الندى قد مات فاستعصموا % % باليأس من دان ومن شاسع % % 3(@)(@@) % لا يبذلن ذو فاقة وجهه % % لذي ثراء باخل باخع % % 4(@)(@@) % ما يظفر الراجي ندى كفه % % بغير ذل الخاشع الخاضع % % 5(@)(@@) % هل ينفع الظامي إذا ما طما % % أجاج بحر ليس بالناقع % 6(@)(@@) % لله در اليأس من ناصح % ليس بغرار ولا خادع % % 7(@)(@@) % ولا سقى الأطماع صوب الحيا % % فإنها مهلكة الطامع % % 8(@)(@@) % لا ترجون خلقا ، فكل الورى % % يقبض كف المانع الجامع % % 9(@)(@@) % وما حوت أيديهم فهو في % % مثل لهاة الأسد الجائع % % 10(@)(@@) % قد سمعوا بالجود لكنه % % لبخلهم ما لذ للسامع % % PageV01P623 11(@)(@@) % وكلهم إن أنت كشفتهم % % مثل سراب القيعة اللامع % 12(@)(@@) % فدعهم واطلب من الله ما % % ضنوا به من فضله الواسع % % 13(@)(@@) % فما لما يقطع من واصل % % ولا لما يوصل من قاطع % 14(@)(@@) % قد قسم الأرزاق بين الورى % % في متعب ساع وفي وداع % % 15(@)(@@) % كلهم يأتيه من رزقه % % كفاية لو كان بالقانع % % 16(@)(@@) % لكنهم من حرصهم قد عموا % % عن الطريق المهيع الشارع % 17(@)(@@) % لو أيقنوا أن لهم رازقا % ليس لما يعطيه من مانع % 18(@)(@@) % ولا لما يرفع من خافض % ولا لما يخفض من رافع % 19(@)(@@) % ما طلبوا من غير معط ، ولا % % دعوا إذا اضطروا سوى السامع % % PageV01P624 البحر : رمل تام 1(@)(@@) % أيها الغافل كم هذا الهجوع % % أعلن الداعي ، فهل أنت سميع % 2(@)(@@) % أنت عما هو آت غافل % % وكأن قد فاجأ الخطب الفظيع % 3(@)(@@) % نحن فرع لأصول ذهبت % كم ترى من بعدها تبقى الفروع % 4(@)(@@) % وزروع للمنايا حصدت % % بيديها قبلنا منا زروع % % 5(@)(@@) % بادر الخوف وقدم صالحا % ما لمن مات إلى الدنيا رجوع % 6(@)(@@) % نحن سفر سارمنا سلف % وعلى ثارهم يمضي الجميع % 7(@)(@@) % وإلى المورد ميعادهم % % يلتقي فيه بطى ء وسريع % 8(@)(@@) % أمنا 
ms123	 الدنيا رقوب ، يستوي % % عندها في الفقد كهل ورضيع % 9(@)(@@) % ما رأينا ثاكلا من قبلها % % مالها في إثر مفقود دموع % % 10(@)(@@) % كلنا منها ، ومنا كلها % % فهي لا تشبع أو نحن صريع % % PageV01P625 11(@)(@@) % بئست الأم رمت أولادها % % برزاياها ، ألا بئس الصنيع % 12(@)(@@) % ما هناهم فوقها نومهم % فهم فيها إلى الحشر هجوع % % 13(@)(@@) % أبدا تجفو علينا ولنا % % نحوها الدهر حنين ونزوع % 14(@)(@@) % هي ليلى والورى أجمعهم % % قيسها كل بها صب ولوع % % 15(@)(@@) % جد يا مطلوب ، من جد نجا % % إن ذا الطالب مدراك تبوع % 16(@)(@@) % ليس ينجي الجحفل الجرار من % % يده الطولى ولا الحصن المنيع % % 17(@)(@@) % يأخذ السلطان ذا الجمع ، فلا % % يدفع السلطان عنه ، والجموع % 18(@)(@@) % ليس يرعى حرمة الجار ولا % % ينقذ الشاسع في البعد الشسوع % % 19(@)(@@) % ما مع السبعين تسويف فلا % % يخدعنك الأمل الواهي الخدوع % % 20(@)(@@) % قد تحملت على ضعفك من % % ثقل أوزارك ما لا تستطيع % PageV01P626 21(@)(@@) % وتقصت عنك أيام الصبا % % وعلى مفرقك الشيب الشنيع % 22(@)(@@) % ثم أفضت مدة الشيب إلى % % هرم يعقبه الموت الذريع % % 23(@)(@@) % صوح المرعى ، فماذا ترتجي % % بعد ما صوح مرعاك المريع % % 24(@)(@@) % هل ترى إلا هشيما ذاويا % % تجتويه العين إن ولى الربيع % % PageV01P627 البحر : خفيف تام 1(@)(@@) % أيها الغافلون عن سكرة المو % % ت ، وإذا لا يسوغ في الحلق ريق % 2(@)(@@) % كم إلى كم هذا التشاغل والغف % % لة ، حار الساري ، وضل الطريق % 3(@)(@@) % إنما هزت الزلازل هذي ال % % أرض بالغافلين كي يستفيقوا % % PageV01P628 البحر : بسيط تام 1(@)(@@) % سلوت عن صبوات كنت ذا شغف % % بها ، وملت إلى الإخبات والنسك % 2(@)(@@) % لكن لقلبي من تذكارها قلق % % ونزوة كاختباط الطير في الشرك % % 3(@)(@@) % هذي عقابيل داء كان يمطلني % % ولم أزل مشفيا منه على الهلك % % 4(@)(@@) % حتى إذا الشيب رداني تصرم ذا % % ك الداء عن شائب الفودين محتنك % % PageV01P629 البحر : طويل 1(@)(@@) % أرى الموت يستقري النفوس ولا أرى % % سوى مانع ما في يديه بخيل % 2(@)(@@) % فيا عجبا للباخلين وإنما % % قليلهم للإرث بعد قليل % % PageV01P630 البحر : طويل 1(@)(@@) % إذا ما عرا مالا أطيق دفاعه % % وأرمضني الفكر المسهد والهم % % 2 
ms124	(@)(@@) % دعوت الذي ناداه موسى لدفع ما % % يحاذر من فرعون ، فانفرق اليم % 3(@)(@@) % وناديت من ناداه ذو النون واثقا % به في ظلام البحر فانكشف الغم % % PageV01P631 البحر : سريع 1(@)(@@) % فليس بعد الموت دار سوى % % جنة عدن ، أو لظا تضرم % 2(@)(@@) % والموعد الحشر ، ونجزى عن الأ % أعمال والغبن لمن يندم % % 3(@)(@@) % وينصف المظلوم من خصمه % % ويستوي السلطان والمعدم % 4(@)(@@) % ويشخص الخلق إلى حاكم % يحكم فيهم بالذي يعلم % 5(@)(@@) % ولليالي واعظ صامت % يسمعنا لو أننا نفهم % % 6(@)(@@) % والناس في الدنيا نيام وما % % أسرع ما يستيقظ النوم % % 7(@)(@@) % ويقدم الخلق على وزر ما % % تقلدوا أو أجر ما قدموا % % PageV01P632 البحر : منسرح 1(@)(@@) % نمنا عن الموت والمعاد فأص % % بحنا نظن اليقين أحلاما % % 2(@)(@@) % فحركتنا هذي الزلازل أن % تيقظوا كم ينام من ناما % % PageV01P633 البحر : مجزوء الخفيف 1(@)(@@) % فوض الأمر راضيا % % جف بالكائن القلم % % 2(@)(@@) % ليس في الرزق حيلة % إنما الرزق بالقسم % 3(@)(@@) % دل رزق الضعيف وه % % و كلحم على وضم % % 4(@)(@@) % وافتقار القوي تره % به الأسد في الأجم % % 5(@)(@@) % أن للخلق خالقا % لا مرد لما حكم % PageV01P634 البحر : مجزوء الكامل 1(@)(@@) % أوبقت نفسك يا ظلو % % م بما احتقبت من المظالم % 2(@)(@@) % أظننت أن المال لا % % يفنى ، وأن الملك دائم % 3(@)(@@) % هيهات ، أنت وما جمع % % ت كلاكما أحلام نائم % 4(@)(@@) % تفنى ويفنى والذي % % يبقى الخطايا والم ثم % 5(@)(@@) % وغدا يناقشك الحساب % % على الحقير من الجرائم % % 6(@)(@@) % ملك تناجيه القلو % % ب من الذنوب بما تكاتم % 7(@)(@@) % عدل القضاء بكل ما % % تخفي صدور الخلق عالم % % PageV01P635 البحر : بسيط تام 1(@)(@@) % ماذا الوقوف على دار بذي سلم % % عجماء أو قد عراها عارض البكم % % 2(@)(@@) % أحالها الدهر عما كنت تعهده % % وغال مستوطنيها غائل الأمم % % 3(@)(@@) % حتى لقد أظلمت من بعدهم ، ولقد % % غنوا بها ، وهم الأقمار في الظلم % % 4(@)(@@) % بلوا كما بليت ثارهم ، ولكم % % أبلى ديارا وأهلا سالف القدم % 5(@)(@@) % أملى الزمان لهم حينا ، وغرهم % % ما خولوه من الدنيا فلم يدم % % 6(@)(@@) % مضوا ، وما استصحبوا مالا ولا نعما % ونوقشوا عن حساب المال والنعم % % 7(@)(@@) % لم يحصلوا 
ms125	 حين وافاهم حمامهم % % من كل ما حصلوا إلا على الندم % % 8(@)(@@) % وصبوة الناس بالدنيا وشغلهم % % عما سيبقى بما يفنى من اللمم % % PageV01P636 البحر : بسيط تام 1(@)(@@) % لا تغبطن أهل بيت سرهم زمن % % فسوف يطرقهم بالهم والحزن % 2(@)(@@) % يعيرهم كل دنياهم وينهب ما % % أعارهم بيد الآفات والمحن % % 3(@)(@@) % حتى يروحوا بلا شيء كما خلقوا % % كأن ما خولوه أمس لم يكن % 4(@)(@@) % لا يصحب المرء مما كان يملكه % % في ظلمة اللحد إلا خرقة الكفن % % 5(@)(@@) % يستنزع المال منه ثم يسأل عن % % جميعه يا لها من حسرة الغبن % % PageV01P637 البحر : مجزوء الرمل 1(@)(@@) % أيها المغرور ، مهلا % بلغ العمر مداه % % 2(@)(@@) % كم عسى من جاوز السب % % بعين يبقى ، كم عساه % 3(@)(@@) % أنسيت الله أم أم % % نك الله لظاه % 4(@)(@@) % تظلم الناس لمن ترجو % % جوه ، أو تخشى سطاه % 5(@)(@@) % أنت كالتنور : يصلى الن % % ار في نفع سواه % PageV01P638 البحر : رمل تام 1(@)(@@) % أف للدنيا ، فما أوبا جناها % % ليس يخلوا من رآها من أذاها % % 2(@)(@@) % خدعتنا بأباطيل المنى % % فارتكسنا في هوانا لهواها % % 3(@)(@@) % واستملنا بوعد كاذب % % فتمسكنا بواه من عراها % % 4(@)(@@) % وعدتنا باللهى لاهية % فاشتغلنا بتقاضينا لهاها % % 5(@)(@@) % وهي إن جاد بنزر يومها % % غدها مسترجع نزر جداها % % 6(@)(@@) % بئست الأم رقوب أكثرت % % ولدها ، ثم رمتهم بقلاها % % 7(@)(@@) % وغدا تنقلنا منها إلى % % مظلم الأرجاء ضنك من ثراها % % 8(@)(@@) % والذي يتبعنا من سحتها % % تبعات موبقات من شذاها % % 9(@)(@@) % وتحوز المال بالإرث وما % % حازت الميراث من أم سواها % % 10(@)(@@) % فإذا الله رعى والدة % % ذات بر وحنو ، لا رعاها % % PageV01P639 11(@)(@@) % أوردتنا النار ، لا مأوى . لنا % % من لظاها ، ويح من يصلى لظاها % % 12(@)(@@) % أمرتنا بالمعاصي فإذا % % وفق الله امرأ منا عصاها % % 13(@)(@@) % آه من تفريطنا ، شغلا بها % % عن فعال الخير والطاعة آها % % PageV01P640 البحر : بسيط تام 1(@)(@@) % قد كنت أسمع ، لكن خلته مثلا : % أن الليالي يصدن الصقر بالخرب % 2(@)(@@) % وأن أيديها شلت ، ولا انبسطت % % إذا ضربن كسرن النبع بالغرب % 3(@)(@@) % حتى رأيت النعام الربد قد قتلت % % أسد العرين فيا للناس للعجب % % 4(@)(@@) % كأن سقب المنايا 
ms126	 وسط جمعهم % رغا فماتوا جميعا جيرة الصقب % % 5(@)(@@) % لم تغن نجدتهم ، إذ حان يومهم % عنهم ، ولم تحمهم من سطوة النوب % % PageV01P641 البحر : كامل تام 1(@)(@@) % ويح الغريبة والديار ديارها % % لم ترتحل عنها ، ولم تتغرب % 2(@)(@@) % ماتت غريبة وحدة من تربها % % وشقيقها ومن العمومة والأب % % 3(@)(@@) % فهي الوحيدة ، والأقارب حولها % % وهي البعيدة في المحل الأقرب % % 4(@)(@@) % فإذا تضرم في الجوانح ذكرها % % قال الأسى : بالله يا عين اسكبي % % PageV01P642 البحر : رمل تام 1(@)(@@) % لهف نفسي لهلال طالع % % ما استوى في أفقه حتى غرب % 2(@)(@@) % لو رأى ما حل بي من بعده % % من هموم غشيتني وكرب % % 3(@)(@@) % لبكى لي تحت أطباق الثرى % % وبكاء الميت للحي عجب % % 4(@)(@@) % أنا ميت مثله لكنه % % مستريح ومماتي في تعب % % PageV01P643 البحر : مجزوء الكامل 1(@)(@@) % يا نفس ، أين جميل صب % % رك حين تطرقك الخطوب % 2(@)(@@) % أين احتمالك ما تكا % % د الراسيات له تذوب % % 3(@)(@@) % وثبات جأشك حين تض % % طرب الجوانح والقلوب % 4(@)(@@) % ماذا دهاك ، إلى متى % % هذا التأسف والنحيب % 5(@)(@@) % كيف استنزلك بعد صد % % ق يقينك الأمل الكذوب % % 6(@)(@@) % أرجوت أن سيرد من % % غال الردى دمع سكوب % 7(@)(@@) % أم خلت أن نوائب الد % % نيا لغيرك لا تنوب % 8(@)(@@) % هيهات كل الخلق من % % نكباتها لهم نصيب % 9(@)(@@) % وبكل قلب من حوا % % دثها وأسهمها ندوب % % 10(@)(@@) % من ذا الذي ييقى على % % مر الزمان له حبيب % % PageV01P644 11(@)(@@) % لكن يسلى النفس أن % لحاقنا بهم قريب % 12(@)(@@) % وإليهم من بعد غي % % بتهم وإن طالت نئوب % % PageV01P645 البحر : خفيف تام 1(@)(@@) % لهف نفسي على ديار من الس % % كان أقوت فليس فيها عريب % % 2(@)(@@) % ولكم حلها فأنسته أوطا % % ن صباه والأهل يوما غريب % % 3(@)(@@) % فاحتسب ما أصاب قومك مجد % % الدين ، واصبر ، فالحادثات ضروب % 4(@)(@@) % هكذا الدهر : حكمه الجور والقص % % د ، وفيه المكروه ، والمحبوب % 5(@)(@@) % إن تخصصكم نوائب ما زا % % لت لكم دون من سواكم تنوب % % 6(@)(@@) % فكذاك القناة : يكسر يوم الر % روع منها صدر وتبقى كعوب % % PageV01P646 البحر : مجزوء الكامل 1(@)(@@) % يا دهر ، كم هذا التفر % ق والتغرب والشتات % % 2 
ms127	(@)(@@) % أبدا على سير كأ % ني الشمس ، ليس لها ثبات % 3(@)(@@) % متقلقل العزمات كال % % مطلوب أفرقه البيات % % 4(@)(@@) % ناء عن الأهلين والأ % أوطان والأتراب ماتوا % % 5(@)(@@) % ولبئس عيش المرء فا % % رقه الأحبة واللدات % % 6(@)(@@) % فالإم أشقى بالبقا % % ء ، وكم تعذبني الحياة % PageV01P647 البحر : طويل 1(@)(@@) % إلى الله أشكو روعتي ورزيتي % % وحرقة أحشائي لفقد أبي بكر % 2(@)(@@) % خلا ناظري منه ، وكان سواده % % ولم يخل من حزني ووجدي به صدري % % 3(@)(@@) % خشيت عليه اليتم لكن ثكله % % ولوعته لم يخطرا لي على فكر % 4(@)(@@) % فيا ليته لاقى الذي كنت أختشي % % عليه وأني دونه صاحب القبر % % 5(@)(@@) % فما في حياتي بعده لي راحة % فيا طول حزني إن تطاول بي عمري % % 6(@)(@@) % ولم تسلني الأيام عنه ، وإنما % % سلوي بما أرجو من الأجر في الصبر % % PageV01P648 البحر : طويل 1(@)(@@) % أعاتب فيك الدهر ، لو أعتب الدهر % وأستنجد الصبر الجميل ، ولا صبر % 2(@)(@@) % وأسأل عن نهج السلو وقد بدا % % لعيني ، إلا أن مسلكه وعر % 3(@)(@@) % وكيف التسلي والحوادث جمة % % إذا ما انقضى أمر يسوء أتى أمر % % 4(@)(@@) % رمتني في عشر الثمانين نكبة % من الثكل يوهي حملها من له عشر % % 5(@)(@@) % على حين أفنى الدهر قومي ، ولم تزل % لهم ذروة العلياء والعدد الدثر % % 6(@)(@@) % إذا حاربوا فالأسد تحمي عرينها % % وإن سالموا كان التبتل والذكر % % 7(@)(@@) % تبيح وتحمي منذ كانت سيوفهم : % يباح بها ثغر ، ويحمى بها ثغر % 8(@)(@@) % مضوا ، وانطوت دنياهم ، وتصرمت % كأنهم ما عمروا ، ولها نشر % 9(@)(@@) % فلم يبق إلا ذكرهم وتأسفي % % عليهم ، ولن يبقى التأسف ، والذكر % 10(@)(@@) % وأصبحت لا آل يلبون دعوتي % % ولا وطن آوي إليه ، ولا وفر % PageV01P649 11(@)(@@) % كأني من غير التراب فليس لي % % من الأرض ذات العرض دون الورى شبر % % 12(@)(@@) % رزئت أبا بكر ، على شغفي به % % فيا لهفتا ماذا جني الحادث البكر % % 13(@)(@@) % لسبع مضت من عمره ، غاله الردى % وكنت أرجي أن يطول به العمر % 14(@)(@@) % وقلت : عتيق من خطوب زمانه % % عتيق بهذا يخبر الفأل والزجر % 15(@)(@@) % فعاجله قبل التمام حمامه % % ولا عجب ، قد يخضد الغصن النضر % 16 
ms128	(@)(@@) % ويأمرني فيه الأخلاء بالأسى % % وهيهات مالي بالأسى بعده خبر % % 17(@)(@@) % يقولون : كم هذا البكاء ، ولو بدا % % ضمير الذي بي ، رق لي ، وبكى الصخر % 18(@)(@@) % وكنت أظن الدمع يبرد غلتي % % إلى أن بدا لي أن دمع الأسى جمر % 19(@)(@@) % أبا بكر ما وجدي عليك بمنقض % % طوال الليالي ما انقضى اليوم والشهر % % 20(@)(@@) % أطلت علي الليل حتى كأنما % % زماني ليل كله ماله فجر % % PageV01P650 21(@)(@@) % وإني لأستدعي الكرى ، وهو نافر % به من جفوني أن يلم بها ذعر % % 22(@)(@@) % لعل خيالا منك يطرق مضجعي % % فأشكو إليه ما رماني به الدهر % % 23(@)(@@) % تمثلك الأفكار لي كل ليلة % % وتؤنسني أشباهك الأنجم الزهر % % 24(@)(@@) % إذا لج بي شوق أتيتك زائرا % فأرجع كالمخبول دلهه السحر % 25(@)(@@) % وماالقرب من قبر أجنك نافعي % % إذا كان فيما بيننا للثرى ستر % % 26(@)(@@) % أقول لنفسي ، حين جد نزاعها % % عليك بحسن الصبر إن أمكن الصبر % % 27(@)(@@) % ألسنا بني الموتى ، إليهم مآلنا % % بلا مرية ، والفرع يجذبه النجر % 28(@)(@@) % فنحن كسفر عرسوا ووراءهم % % رفاق ، إذا وافوهم رحل السفر % 29(@)(@@) % من الأرض أنشئنا وفيها معادنا % % ومنها يكون النشر والبعث والحشر % % 30(@)(@@) % هي الأم لا بر لديها وردنا % % إلى بطنها بعد الولاد هو البر % % PageV01P651 31(@)(@@) % ثكول ولا دمع لها إثر هالك % % وكل رقوب ثاكل دمعها همر % 32(@)(@@) % أضل الورى حب الحياة ، فحازم % خبير سواء في الضلالة والغر % 33(@)(@@) % فلا يأمنن غدر الليالي من % وإن أمهلته إن إمهالها ختر % % 34(@)(@@) % تعير ، وبالقسر العنيف ارتجاعها % % ولا خير في عاربة ردها القسر % % 35(@)(@@) % ونحن عليها عاكفون ، وليس في % % مواهبها عقبى تسر ولا يسر % % 36(@)(@@) % فما بالنا في سكرة من طلابها % % ومن نالها منا يزيد به السكر % 37(@)(@@) % مضى من مضى ممن حبته ، فأكثرت % وراحته من كل ما جمعت صفر % % 38(@)(@@) % وما نال أيام الحياة من الغنى % % عن الفقر في يوم المعاد هو الفقر % % 39(@)(@@) % يحاسب عن قطميره ونقيره % % ولم يتبعه منه كثر ولا نزر % % 40(@)(@@) % وهذا هو الخسر المبين ، فما لنا % % حراص على أمر عواقبه خسر % % PageV01P652 41(@)(@@) % وقد كان في آبائنا 
ms129	 زاجر لنا % % يبصرنا لو كان يردعنا الزجر % % 42(@)(@@) % تفانوا ، فبطن الأرض من بعد وحشة % بهم آهل مستأنس ، وخلا الظهر % 43(@)(@@) % وقد درست آثارهم وقبورهم % % كما درسوا فيها فليس لها أثر % % 44(@)(@@) % فهل لي في هذي المواعط واعظ % يبرد ما يخفي من الكمد الصدر % 45(@)(@@) % يحث على الصبر الجميل ، فإنه % % ينال به حسن المعوضة والآجر % 46(@)(@@) % ومن نزعت أيدي المنية من يدي % % هو الذخر لي ، في يوم ينفعني الذخر % PageV01P653 البحر : بسيط تام 1(@)(@@) % أزور قبرك مشتاقا فيحجبني % % ماهيل فوقك من ترب وأحجار % 2(@)(@@) % فأثني ، ودموعي من جوى كبدي % % تفيض ، فاعجب لماء فاض من نار % PageV01P654 البحر : طويل 1(@)(@@) % تخرمت الأيام أهل مودتي % % فنفسي عن أنس المسرات ناشز % 2(@)(@@) % وأفردت منهم ، فارتياعي لفقدهم % % كروعة ثكلى أوجعتها الجنائز % % 3(@)(@@) % برتهم كبارى القوس ، جذ الذي انحنى % % عليها ، إلى أن نالها وهي بارز % 4(@)(@@) % فقد أبرزتني للحوادث ليس لي % % إذا مارمتني حاجز أو محاجز % PageV01P655 البحر : بسيط تام 1(@)(@@) % صبري على فقد إخواني وفرقتهم % غدر وأجمل بي من صبري الجزع % % 2(@)(@@) % تقاسمتهم نوى شطت بهم وردى % % فالحي كالميت ما في قربه طمع % % 3(@)(@@) % وأصبحت وحشة الغبراء دونهم % من بعد أنسي بهم والشمل مجتمع % % 4(@)(@@) % وعشت منفردا منهم وأقسم ما % % يكاد منفرد بالعيش ينتفع % PageV01P656 البحر : طويل 1(@)(@@) % وقفت على رسم ببيداء بلقع % % خلي من النادي صموت إذا دعي % % 2(@)(@@) % نبت عنه عيني ، ثم قال لها الهوى : % هي الدار ، فاستمري شئونك ، وادمعي % % 3(@)(@@) % ولا تنكري للدهر إخلاق جدة % % وتشتيت ألاف وإيحاش مجمع % % 4(@)(@@) % فللموت سكان الديار ، وللبلى % % منازلهم ، وشملهم للتصدع % 5(@)(@@) % فصبرا فإن عزت نوائب دهرنا % % وأحداثه حسن التصبر فاجزع % % PageV01P657 البحر : بسيط تام 1(@)(@@) % أزور قبرك والأشجان تمنعني % % أن اهتدي لطريقي حين أنصرف % 2(@)(@@) % فما أرى غير أحجار منضدة % قد احتوتك ، ومأوى الدرة الصدف % 3(@)(@@) % فأنثني لست أدري أين منقلبي % % كأنني حائر في الليل معتسف % 4(@)(@@) % إن قصر العمر بي عن أرى خلفا % له ، ففي الأجر عند الله لي خلف % 5(@)(@@) % أقول للنفس إذ جد النزاع بها % % يا نفس 
ms130	 ويحك ، أين الاهل والسلف % 6(@)(@@) % أليس هذا سبيل الخلق أجمعهم % % وكلهم بورود الموت معترف % % 7(@)(@@) % كم ذا التأسف أم كم ذا الحنين وهل % % يرد من قد حواه قبره الأسف % % PageV01P658 البحر : كامل تام 1(@)(@@) % أصبحت لا أشكو الخطوب وإنما % % أشكو زمانا لم يدع لي مشتكى % % 2(@)(@@) % أفني أخلائي وأهل مودتي % % وأباد إخوان الصفاء وأهلكا % % 3(@)(@@) % عاشوا براحتهم ، ومت لفقدهم % % فعلي يبكي ، لا عليهم ، من بكى % % 4(@)(@@) % بقيت بعدهم كأني حائر % بمفازة ، لم يلق فيها مسلكا % % PageV01P659 البحر : سريع 1(@)(@@) % وسع صبري عن عتيق الأسى % % من بعد ما ضاق بي المسلك % 2(@)(@@) % أسلمته إذ لم أجد لي يدا % بدفع من يطلب ما يملك % % 3(@)(@@) % عارية كان ، وما كل ما % % يعار ، يستقنى ، ويستملك % 4(@)(@@) % أعاره مشترطا رده % % والشرط ما بين الورى أملك % % PageV01P660 البحر : خفيف تام 1(@)(@@) % كيف أنساك يا أبا بكر أم كي % % ف اصطباري ما عنك صبري جميل % % 2(@)(@@) % أنت حيث اتجهت في أسودي عي % % ني وقلبي ممثل لا تزول % % 3(@)(@@) % وعلام الأسى ؟ ونحن كسفر % بعضنا سائر وبعض نزول % % 4(@)(@@) % عرس الأولون ، والآخر التا % % لي إليهم عما قليل يئول % 5(@)(@@) % وإلى حيث عرس السلف الأو % ل ميعادنا ومنه القفول % % PageV01P661 البحر : وافر تام 1(@)(@@) % أحدث عنك بالسلوان نفسي % % وهل تسلو مولهة ثكول % % 2(@)(@@) % إذا ناجيتها بالصبر حنت % كما حنت إلى بو عجول % 3(@)(@@) % إذا نظرت إليه أنكرته % وتعطفها الصبابة والغليل % 4(@)(@@) % ولي في الموت يأس مستبين % ولكن حال وجدي لا تحول % % 5(@)(@@) % أحن إلى أبي بكر ، وما لي % % إلى رؤياه في الدنيا سبيل % % 6(@)(@@) % فيا لله من يأس مبين % يخالف حاله الصبر الجميل % % 7(@)(@@) % يغالبني على عقلي حنين % إليه ، لا تغالبه العقول % 8(@)(@@) % فينسيني يقين اليأس منه % % كما تنسي معاقرها الشمول % % 9(@)(@@) % ويلحاني العذول ، وليس يدري % % بما أخفي من الكمد العذول % 10(@)(@@) % إذا نام الخلي أراح همي % % وأسهر ليلي الحزن الدخيل % PageV01P662 11(@)(@@) % كأن نجوم ليلي موثقات % % فليست من أماكنها تزول % % 12(@)(@@) % وما في الصبح لي روح ، ولكن % % به يتعلل الدنف العليل % % 13(@)(@@) % نهاري لا 
ms131	 يلائمني سول % % وليلي لا يفارقني العويل % % PageV01P663 البحر : طويل 1(@)(@@) % لعمرك ما ينسيني الدهر روعتي % % بفقد أبي بكر حياتي ، ولا يسلي % % 2(@)(@@) % خشيت عليه اليتم بعدي ، فليتني % % رميت بما أخشى ، ولم أرم بالثكل % % 3(@)(@@) % فكل بعيد يرتجى جمع شمله % % وبعد المنايا غير مجتمع الشمل % % PageV01P664 البحر : كامل تام 1(@)(@@) % حيا ربوعك من ربى ومنازل % % ساري الغمام بكل هام هامل % % 2(@)(@@) % وسقتك يا دار الهوى بعد النوى % % وطفاء تسفح باهتون الهاطل % % 3(@)(@@) % حتى تروض كل ماح ماحل % عاف وتروي كل ذاو ذابل % % 4(@)(@@) % أبكيك ، أم أبكى زماني فيك ، أم % % أهليك ، أم شرخ الشباب الراحل % % 5(@)(@@) % ما قدر دمعي أن يقسمه الأسى % % والوجد بين أحبة ومنازل % % 6(@)(@@) % أنفقته سرفا وها أنا ماثل % % في ماحل ، أبكي بجفن ماحل % % 7(@)(@@) % وإذا فزعت إلى العزاء دعوت من % % لا يستجيب ورمت نصرة خاذل % % 8(@)(@@) % أين الظباء عهدتهن كوانسا % بك في ظلال السمهري الذابل % % 9(@)(@@) % النافرات من الأنيس تكرما % والآنسات بكل ليث باسل % % 10(@)(@@) % من كل مكروه اللقاء منازل % % رحب الفناء لطارق أو نازل % % PageV01P665 11(@)(@@) % متمنع صعب على أعدائه % % سهل المقادة للخليل الواصل % % 12(@)(@@) % عزوا على الدنيا وخالف فعلهم % % أفعالها ، فبغتهم بغوائل % 13(@)(@@) % حتى إذا اغتالتهم بخطوبها % % ورمتهم بحوادث وزلازل % 14(@)(@@) % درست منازلهم وأوحش منهم % % مأنوس أندية وعز محافل % % 15(@)(@@) % واها لهم من عالم ومعالم % % وممنعات عقائل ومعاقل % % 16(@)(@@) % كانوا شجى في صدر كل معاند % % وقذى يجول بعين كل محاول % % 17(@)(@@) % غوثا لملهوف وملجا لاجيء % % وجوار رب جرائر وطوائل % % 18(@)(@@) % ذهبوا ذهاب الأمس ما من مخبر % عنهم وزالوا كالظلال الزائل % % 19(@)(@@) % وبقيت بعدهم حليف كآبة % مستورة بتجمل وتحامل % % 20(@)(@@) % سعدوا براحتهم ، وها أنا بعدهم % % في شقوة تضني ، وهم داخل % % PageV01P666 21(@)(@@) % فاعجب لشقوة متعب بمقامه % % من بعد أسرته وراحة راحل % % 22(@)(@@) % دع ذا فأنت على الحوادث مروة % % تلقى الرزايا عالما كالجاهل % % 23(@)(@@) % واصبر فما فيما أصابك وصمة % % كل الورى غرض لسهم النابل % % PageV01P667 البحر : بسيط تام 1(@)(@@) % حمائم الأيك هيجتن أشجانا % % فليبك أصدقنا بثا وأشجانا % % 2(@)(@@) % كم ذا الحنين على مر 
ms132	 السنين أما % % أفادكن قديم العهد نسيانا % 3(@)(@@) % هل ذا العويل على غير الهديل وهل % % فقيدكن أعز الخلق فقدانا % % 4(@)(@@) % ما وجد صادحة في كل شارقة % ترجع النوح في الأفنان ألحانا % % 5(@)(@@) % كما وجدت على قومي تخونهم % % ريب المنون ودهر طال ما خانا % % 6(@)(@@) % إذا نهى الصبر دمعي عند ذكرهم % % قال الأسى : فض وجد سحا وتهتانا % % 7(@)(@@) % قالوا : تأس وما قالوا بمن وإذا % % أفردت بالرزء ما أنفك أسوانا % % 8(@)(@@) % ما حدثتني بالسلوان بعدهم % % نفسي ، ولا حان سلواني ولا نا % % 9(@)(@@) % ما استدرج الموت قومي في هلاكهم % % ولا تخرمهم مثنى ووحدانا % % 10(@)(@@) % فكنت أصبر عنهم صبر محتسب % % وأحمل الخطب فيهم عز أو هانا % % PageV01P668 11(@)(@@) % وأقتدي بالورى قبلي فكم فقدوا % % أخا ، وكم فارقو أهلا وجيرانا % % 12(@)(@@) % لكن سقب المنايا وسط جمعهم % % رغا فخروا على الأذقان إذعانا % % 13(@)(@@) % وفاجأتهم من الأيام قارعة % % سقتهم بكؤوس الموت ذيفانا % % 14(@)(@@) % ماتوا جميعا كرجع الطرف ، وانقرضوا % % هل ما ترى تارك للعين إنسانا % % 15(@)(@@) % أعزز علي بهم من معشر صبر % % عند الحفيظة إن ذو لوثة لانا % % 16(@)(@@) % لم يترك الدهر لي من بعد فقدهم % قلبا أجشمه صبرا وسلوانا % % 17(@)(@@) % فلو رأوني لقالوا : مات أسعدنا % % وعاش للهم والأحزان أشقانا % % 18(@)(@@) % لم يترك الموت منهم من يخبرني % % عنهم فيوضح ما لاقوه تبيانا % % 19(@)(@@) % بادوا جميعا ، وما شادوا ، فوا عجبا % للخطب أهلك عمارا وعمرانا % % 20(@)(@@) % هذي قصورهم أمست قبورهم % % كذاك كانوا بها من قبل سكانا % % PageV01P669 21(@)(@@) % ويح الزلازل أفنت معشري فإذا % % ذكرتهم ، خلتني في القوم سكرانا % % 22(@)(@@) % بني أبي ، إن تبيدوا ، أن عدا زمن % عليكم دون هذا الخلق عدوانا % % 23(@)(@@) % فلن يبيد جوى قلبي ولا كمدي % % عليكم أو يبيد الدهر ثهلانا % % 24(@)(@@) % أفسدتم عمري الباقي علي فما % % أنفك فيه كئيب القلب ولهانا % % 25(@)(@@) % أفردت منكم ، وما يصفو لمنفرد % عيش ولو نال من رضوان رضوانا % % 26(@)(@@) % فليتني معهم أوليت أنهم % % بقوا وما بيننا باق كما كانا % % 27(@)(@@) % لقيت منهم تباريح العقوق ، كما % % لقيت من بعدهم هما وأحزانا % % 28(@)(@@) % لولا شمات الأعادي عند ذكرهم 
ms133	 % لغادرت أدمعي في الأرض غدرانا % % 29(@)(@@) % أرد فيض دموعي في مسالكها % % فتستحيل مياه الدمع نيرانا % % 30(@)(@@) % لا ألتقي الدهر من بعد الزلازل ما % % بقيت إلا كسير القلب حيرانا % % PageV01P670 31(@)(@@) % أخنت على معشري الأدنين فاصطلمت % % منهم كهولا ، وشبانا ، وولدانا % % 32(@)(@@) % كم رام ما أدركته منهم ملك % فعاد باليأس مما رام لهفانا % % 33(@)(@@) % لم يحمهم حصنهم منها ولا رهبت % % بأسا تناذره الأقران أزمانا % % 34(@)(@@) % أتاهم قدر لم ينجهم حذر % منه ، وهل حذر منج لمن حانا % % 35(@)(@@) % إن أقفرت شيزر منهم فهم جعلوا % % منيع أسوارها بيضا وخرصانا % 36(@)(@@) % هم حموها فلو شاهدتها وهم % % بها ، لشاهدت آسادا وخفانا % % 37(@)(@@) % كانوا لمن خاف ظلما أو سطا ملك % % كهفا ، وللجاني المطلوب جيرانا % % 38(@)(@@) % علوا بمجدهم سيف بن ذي يزن % كما علت شيزر في العز غمدانا % % 39(@)(@@) % كانوا ملاذا لأيتام وأرملة % % وبائس فاقد أهلا وأوطانا % % 40(@)(@@) % إذا أتيتهم ألفيت شطرهم % % مسترفدين وزوارا وضيفانا % % PageV01P671 41(@)(@@) % تراهم في الوغى أسدا ، ويوم ندى % غيثا هتونا ، وفي الظلماء رهبانا % % 42(@)(@@) % حاولت كتمان بثي بعد فقدهم % % فلم يطق قلبي المحزون كتمانا % % 43(@)(@@) % لعل من يعرف الأمر الذي بعدت % % بعد التصاقب من جراه دارانا % % 44(@)(@@) % يقول بالظن ، إذ لم يدر ما خلقي % % ولا محافظتي من حان أو بانا % % 45(@)(@@) % أسامة لم يسؤه فقد معشره % % كم أوغروا صدره غيظا وأضغانا % 46(@)(@@) % وما درى أن في قلبي لفقدهم % نارا تلظى وفي الأجفان طوفانا % % 47(@)(@@) % بنو أبي وبنو عمي دمي دمهم % % وإن أروني مناواة وشنآنا % % 48(@)(@@) % كانوا جناحي فحصته الخطوب وإخ % % ي ، فلم تبق لي الأيام إخوانا % % 49(@)(@@) % كانوا سيوفي إذا نازلت حادثة % % وجنتي حين ألقى الخطب عريانا % % 50(@)(@@) % بهم أصول على الأمر المهول ، إذا % % عرا وألقى عبوس الدهر جذلانا % % PageV01P672 51(@)(@@) % فكيف بالصبر لي عنهم وقد نظموا % % دمعي على فقدهم درا ومرجانا % % 52(@)(@@) % يطيب النفس عنهم أنهم رحلوا % % وخلفوني على الآثار عجلانا % % 53(@)(@@) % سقى ثرى أودعوه رحمة ملأت % % مثوى قبورهم روحا وريحانا % % 54(@)(@@) % وألبس الله هاتيك العظام وإن % % بلين تحت الثرى عفوا وغفرانا % % PageV01P673 البحر : بسيط تام 
ms134	 1(@)(@@) % حسبي من العيش كم لاقيت فيه أذى % أقله فقد أترابي وخلاني % % 2(@)(@@) % لم يبق لي مشتكى بث أحمله % % همي ، ولا من إذا استصرخت لباني % % 3(@)(@@) % وصم عني صدى صوتي ، وأفردني % % ظلي ، ومل الكرى والطيف غشياني % % 4(@)(@@) % وما نظرت إلى ما كان يبهجني % % إلا شجاني وآساني وأبكاني % % PageV01P674 البحر : رجز تام 1(@)(@@) % ناحت فباحت في فروع البان % % عن لوعتي وعن جوى أحزاني % % 2(@)(@@) % بخيلة العينين بالدمع ولي % % عين تجود بالنجيع القاني % % 3(@)(@@) % إذا دعت أجبتها بروعة % % ورق تداعت في ذرا الأغصان % 3(@)(@@) % أحببت قوما وإفراط الهوى ندم % % 4(@)(@@) % وحسرتي أن الزمان غال من % % كنت إذا دعوته لباني % % 6(@)(@@) % يزيد هوى ليلى رضاها ، وعتبها % % 7(@)(@@) % هي اليوم شتى ، وهي أمس جميع % % 7(@)(@@) % وللشوق منها ، ما دعاها إجابة % % 10(@)(@@) % وإن مروري ، لا أكلم أهله % % 10(@)(@@) % وكم أضاعوا مواثيق الهوى ورعت % % PageV01P675 18(@)(@@) % أسائقها للبين وهو عجول % % 21(@)(@@) % ألا قلما تصفو مع البين عيشة % % 24(@)(@@) % حرمت ما كنت أرجو : من ودادهم % % ما الرزق إلا الذي تجري به القسم % % 26(@)(@@) % هوى في عفاف لم تدنسه ريبة % % 27(@)(@@) % وما كل أسباب الغرام تقوده % % 28(@)(@@) % كأن على أنيابها الخمر شابها % % عن البلد النائي المخوف نزيع % 33(@)(@@) % حملن وجوها في الخدور أعزة % % 43(@)(@@) % فهن على جور الغرام وعدله % % 45(@)(@@) % لبانة نفس مستمر عناؤها % % 48(@)(@@) % بلغ أميري معين الدين مألكة % من نازح الدار لكن وده أمم % % PageV01P676 52(@)(@@) % مللت ، فما تدني إليك شفاعة % % 54(@)(@@) % أهلة بيد ، والأهلة فوقها % % 55(@)(@@) % ألا قلما تصفو مع البين عيشة % % 56(@)(@@) % هل في القضية يا من فضل دولته % % لمن طالعات في السراب أفول % 61(@)(@@) % أقلب في عرفانها الناظر القذي % % 67(@)(@@) % وأقنع منها بالخيال إذا سرى % % كما شيم من أعلى السحابة بارق % % 68(@)(@@) % ويعجبني منها بزخرفها الكرى % % 70(@)(@@) % فلم أرق ولم أفرق لبغيهم % % 72(@)(@@) % لكن ثقاتك ما زالوا بغشهم % % حتى استوت عندك الأنوار والظلم % % 79(@)(@@) % وما كل أسباب الغرام تقوده % % PageV01P677 82(@)(@@) % والنقص في دينهم أو في عبارتهم % % 85(@)(@@) % عياء على مر الليالي دواؤها % % 98(@)(@@) % ولم تمر بفكري 
ms135	 خجلة الندم % % 101(@)(@@) % يأوي إلى حسن عهد منك ما ابتذلا % % 107(@)(@@) % وباك بما جر الفراق جهول % % 108(@)(@@) % % عذر فماذا جنى الأطفال والحرم % % 112(@)(@@) % وقد تعرف الآثار ، وهي محول % رضا عدا يسخط الرحمن فعلهم % % 122(@)(@@) % وفي الخدر بدر آفل ، لا يريمه % % 123(@)(@@) % وترغو ، وفي طول الرغاء غليل % % 124(@)(@@) % وما أنت يا ظمياء إلا براعة % % PageV01P678 137(@)(@@) % أخفوا من الغل ما أخفوه ثم علن % % 141(@)(@@) % دعانا الهوى واستوقفتنا المعارف % % 151(@)(@@) % يزيد إذا هب النسيم وقوده % % 152(@)(@@) % هل فيهم رجل يغني غناي إذا % % 160(@)(@@) % لكن رأيك أدناهم وأبعدني % % فليت أنا بقدر الحب نقتسم % % 161(@)(@@) % لما خلطت يقين الود بالشبه % % 169(@)(@@) % وروعة شوق للحشا مستفزة % % 176(@)(@@) % % فهن صحيحات النواظر حول % PageV01P679 
