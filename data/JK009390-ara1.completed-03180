ms3166	 النبي :(@)(@@) | 30 ( إذا طلع النجم صباحا رفعت العاهة ) )(@)(@@) . ( حم ، طك ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 274 / 29299 قال النبي :(@)(@@) | 30 ( إذا طهرت فاغسلي موضع الدم ثم صلى فيه ، قالت : فإن لم يخرج أثره ؟ قال : يكفيك الماء ولا يضرك أثره ) )(@)(@@) . ( حم ، عن أبي هريرة رضي الله عنه قال : إن خولة بنت يسار أتت النبي فقالت : ليس لي إلا ثوب واحد وأنا أحيض فيه فذكره ) . .(@)(@@) PageV10P051(@)(@@)(@@)(@@) $ 275 / 29300 قال النبي :(@)(@@) | 30 ( إذا ظلم أهل الذمة كانت الدولة دولة العدو ، وإذا كثر الزنا كثر السباء ، وإذا كثر اللوطية رفع الله يده عن الخلق ولا يبالي في أي واد هلكوا ) )(@)(@@) . ( طك ، عن جابر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 276 / 29301 قال النبي :(@)(@@) | 30 ( إذا ظهر السوء في الأرض أنزل الله بأسه بأهل الأرض قيل وفيها أهل طاعة الله ؟ قال : نعم ثم يصيرون إلاى رحمة الله ) )(@)(@@) . ( حم ، عن عائشة رضي الله عنها ) . .(@)(@@)(@@)(@@) $ 277 / 29302 قال النبي :(@)(@@) | 30 ( إذا ظهر القول وخزن العمل ، واختلفت الألسن ، وتباغضت القلوب ، وقطع ذو رحم رحمه ، فعند ذالك لعنهم الله فأصمهم وأعماى أبصارهم ) )(@)(@@) . ( طس ، عن سلمان رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 278 / 29303 قال النبي :(@)(@@) | 30 ( إذا عاد المريض جلس عند رأسه ) )(@)(@@) . ( ع ، عن ابن عباس رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 279 / 29304 قال النبي :(@)(@@) | 30 ( إذا عتقت الأمة فهي بالخيار ما لم يطأها ، إن شاءت فارقته ، وإن وطئها فلا خيار لها ولا تستطيع فراقه ) )(@)(@@) . ( حم ، عن عمرو بن أمية رضي الله عنه متصلا ) . .(@)(@@)(@@)(@@) $ 280 / 29305 قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليقل : الحمد لله علاى كل حال ، وليقل له : رحمك الله ، وليقل هو : يغفر لنا ولكم ) )(@)(@@) . ( بز ، عن ابن عمر رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 281 / 29306 قال النبي :(@)(@@) | 30 ( إذا عطس أحدكم فليقل : الحمد لله ، وليقل من عنده : يرحمك الله ، وليقل هو : يهديكم الله ويصلح بالكم ) )(@)(@@) . ( طس ، عن علي رضي الله عنه ) . .(@)(@@) PageV10P052(@)(@@)(@@)(@@) $ 282 / 29307 قال النبي :(@)(@@) | 30 ( إذا قال الإمام : غير المغضوب عليهم ولا الضالين ، قال الذين خلفه : آمين ، التقت ممن أهل السماوات والأرض آمين غفر له 
ms3167	 ما تقدم من ذنبه ، ومثل الذي لا يقول آمين كمثل رجل غزا مع قوم فخرج سهامهم ولم يخرج سهمه ، فقال : ما لسهمي لم يخرج ؟ قال : إنك لم تقل آمين ) )(@)(@@) . ( ع ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 283 / 29308 قال النبي :(@)(@@) | 30 ( إذا قال العبد : يا رب يا رب أربعا ، قال الله تبارك وتعالاى : لبيك عبدي ، سل تعطه ) )(@)(@@) . ( بز ، عن عائشة رضي الله عنها ) . .(@)(@@)(@@)(@@) $ 284 / 29309 قال النبي :(@)(@@) | 30 ( إذا قام الرجل في الصلاة أقبل الله عليه بوجهه ، فإذا التفت قال : يا ابن آدم إلاى من تلتفت ؟ إلاى من هو خير مني أقبل إلي ، فإذا التفت الثانية قال مثل ذالك ، فإذا التفت الثالثة صرف الله تعالاى وجهه ) )(@)(@@) . ( بز ، عن جابر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 285 / 29310 قال النبي :(@)(@@) | 30 ( إذا قام أحدكم إلاى الصلاة فليصل علي حتى يفرغ منها ، وإياكم والالتفات في الصلاة فإن أحدكم يناجي ربه ما قام في الصلاة ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 286 / 29311 قال النبي :(@)(@@) | 30 ( إذا قرب لأحدكم طعامه وفي رجليه نعلان فلينزع نعليه ، فإنه أروح للقدمين وهو من السنة ) )(@)(@@) . ( بز ، ع ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 287 / 29312 قال النبي :(@)(@@) | 30 ( إذا قضاى أحدكم صلاته في المسجد ثم رجع إلاى بيته فليصل في بيته ركعتين وليجعل لبيته نصيبا من صلاته ، فإن الله جاعل في بيته من صلاته خيرا ) )(@)(@@) . ( حم ، وعبد بن حميد ، ع ، وابن خزيمة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 288 / 29313 قال النبي :(@)(@@) | 30 ( إذا قمت إلاى الصلاة فأسبغ الوضوء ، فإنك PageV10P053 إذا تمضمضت انتثرت الذنوب من منخرك ، وإذا غسلت وجهك انتثرت الذنوب من شعر عينيك ، وإذا غسلت يديك انتثرت الذنوب من أظفار يديك ، وإذا مسحت رأسك انتثرت الذنوب من رأسك ، وإذا غسلت رجليك انتثرت الذنوب من أظفار قدميك ، ثم إذا قمت إلاى الصلاة فاقرأ من القرآن ما شئت ، ثم إذا ركعت فأمكن يديك من ركبتيك ، وافرج بين أصابعك حتى تطمئن راكعا ، ثم إذا سجدت فأمكن وجهك من السجود كله حتى تطمئن ساجدا ولا تنقر 
ms3168	 نقرا ، وصل من أول النهار وآخره ) )(@)(@@) . ( بز ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 289 / 29314 قال النبي :(@)(@@) | 30 ( إذا كان آخر الزمان صارت أمتي ثلاث فرق : فرقة يعبدون الله خالصا ، وفرقة يعبدون الله رياء ، وفرقة يعبدون الله ليستأكلوا به الناس ، فإذا جمعهم يوم القيامة قال للذي يستأكل الناس : بعزتي وجلالي ما أردت بعبادتي ؟ فيقول : وعزتك وجلالك أستأكل به الناس قال : لم تتعقل ما جمعت شيئا يلجأ إليه ، انطلقوا به إلاى النار ، ثخم يقول للذي كان يعبده خالصا : بعزتي وجلالي ما أردت بعبادتي ؟ قال : بعزتك وجلالك أنت أعلم بذالك مني ، أردت به ذكرك ووجهك ، قال : صدق عبدي انطلقوا به إلاى الجنة ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 290 / 29315 قال النبي :(@)(@@) | 30 ( إذا كان أجل أحدكم بأرض أتاى إليها بحاجة ) )(@)(@@) . ( طك ، عن ابن مسعود رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 291 / 29316 قال النبي :(@)(@@) | 30 ( إذا كان أحدكم صائما فأكل وشرب فليتم صومه فإن الله تعالاى أطعمه وسقاه ) )(@)(@@) . ( حم ، عن الحسن مرسلا ) . .(@)(@@)(@@)(@@) $ 292 / 29317 قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في الصلاة فلا يغمض عينيه ) )(@)(@@) . ( طكسص ، عن ابن عباس رضي الله عنهما ) . .(@)(@@) PageV10P054(@)(@@)(@@)(@@) $ ( 293 / 29318 ) قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في المسجد فلا يسمع أحد صوته ويشير بأصبعه إلاى ربه ) )(@)(@@) . ( طس ، عن ابن عمر رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 294 / 29319 قال النبي :(@)(@@) | 30 ( إذا كان أحدكم في صلاة فلا يرفع بصره إلاى السماء ولا يستمع ) )(@)(@@) . ( طكس ، عن أبي سعيد رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 295 / 29320 قال النبي :(@)(@@) | 30 ( إذا كان إزارك ضيقا فاتزر به ، وإذا كان واسعا فاشتمل به يعني في الصلاة ) )(@)(@@) . ( بز ، عن علي رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 296 / 29321 قال النبي :(@)(@@) | 30 ( إذا كان ثلاثة فلا يتناجاى اثنان دون صاحبهما ) )(@)(@@) . ( بز ، عن عمر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 297 / 29322 قال النبي :(@)(@@) | 30 ( إذا كان حين تفتتح الصلاة فقل : سبحانك اللهم وبحمدك ولا حول ولا قوة إلا بالله ، لا إلاه إلا أنت ظلمت نفسي فاغفر للي إنه لا يغفر الذنوب إلا أنت ، وتقرأ ما تيسر من القرآن وتركع 
ms3169	 فتقول : سبحان ربي العظيم ثلاث مرات ، فإذا رفعت من الركوع فقل : سمع الله لمن حمده اللهم ربنا لك الحمد ملء السماوات وملء الأرض وملء ما شئت من شيء بعد ، فإذا سجدت فقل : سبحان ربي الأعلى ثلاثا ، سجد وجهي للذي خلقه فشق سمعه وبصره تبارك الله أحسن الخالقين ، فإذا رفعت من السجود فقل : رب اغفر لي وارحمني واهدني وارزقني إني لما أنزلت إلي من خير فقير ، فإذا جلست في صلاتك فلتقولن في التشهد : لا إلاه إلا الله وأني رسول الله والصلاة علي وعلاى جميع أنبياء الله وسلم علاى عبااد الله الصالحين ) )(@)(@@) . ( بز ، عن أبي بريدة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 298 / 29323 قال النبي :(@)(@@) | 30 ( إذا كان عليكم أمراء ، من دخل عليهم بكذبهم وأعانهم علاى ظلمهم فليس مني ولا أنا منه ولا يرد علي الحوض ، ومن دخل عليهم فلم يصدقهم بكذبهم ولم يعنهم علاى ظلمهم فهو مني وأنا منه ) )(@)(@@) . ( طس ، عن كعب بن عجرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 299 / 29324 قال النبي :(@)(@@) | 30 ( إذا كان عليكم أمراء يأمرونكم بالصلاة والزكاة PageV10P055 والجهاد في سبيل الله فقد حرم عليكم سبهم ، وحل لكم الصلاة خلفهم ) )(@)(@@) . ( طك ، عن عمر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 300 / 29325 قال النبي :(@)(@@) | 30 ( إذا كان في الأرض خليفتان فاقتلوا أحدهما ) )(@)(@@) . ( طكس ، عن سعيد بن الزبير رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 301 / 29326 قال النبي :(@)(@@) | 30 ( إذا كان ليلة النصف من شعبان يغفر الله لعباده إلا لمشرك أو مشاحن ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 302 / 29327 قال النبي :(@)(@@) | 30 ( إذا كان ليلة النصف من شعبان ينزل الله تعالاى إلاى سماء الدنيا فيغفر الله لعباده إلا ما كان من مشرك أو من مشاحن لأخيه ) )(@)(@@) . ( بز ، عن أبي بكر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 303 / 29328 قال النبي :(@)(@@) | 30 ( إذا كان نصف الليل الثاني هبط الله عز وجل إلاى سماء الدنيا ثم تفتح أبواب السماء ثم يبسط يده عز وجل فيقول : هل من سائل يعطاى سؤله ؟ فلا يزال كذالك حتى يطلع الفجر ) )(@)(@@) . ( حم ، ع ، عن ابن مسعود رضي الله 
ms3170	 عنه ) . .(@)(@@)(@@)(@@) $ 304 / 29329 قال النبي :(@)(@@) | 30 ( إذا كان يوم سابعه فأهريقوا عنه دما ، وأميطوا عنه الأذاى وسموه ) )(@)(@@) . ( طكس ، عن ابن عمر رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 305 / 29330 قال النبي :(@)(@@) | 30 ( إذا كان يوم الجمعة خرج الشياطين يرمون الناس إلاى أسواقهم وتقعد الملائكة علاى أبواب المساجد يكتبون الناس علاى قدر منازلهم : السابق والمصلي والذي يليه حتى يخرج الإمام ، فمن دناى من الإمام فأنصت واستمع ولم يلغ كان له كفلان منن الأجر ، ومن نأى فاستمع وأنصت ولم يلغ كان له كفل من الأجر ، ومن دناى من الإمام ولم ينصت ولم يستمع كان له كفلان من الوزر ، ومن قال صه فقد تكلم لا جمعة له ) )(@)(@@) . ( حم ، عن علي رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 306 / 29331 قال النبي :(@)(@@) | 30 ( إذا كانوا ثلاثة فلا يتناجاى اثنان دون الثالث ، وإذا كانوا ثلاثة في سفر فليؤم واحد ) )(@)(@@) . ( بز ، عن ابن عمر رضي الله عنهما ) . .(@)(@@) PageV10P056(@)(@@)(@@)(@@) $ 307 / 29332 قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة دعي عبد الله بن عبيدة فيوقفه بين يديه فيسأله عن جاهه كما يسأله عن ماله ) )(@)(@@) . ( طص ، عن ابن عمر رضي الله عنهما ) . .(@)(@@)(@@)(@@) $ 308 / 29333 قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة دعي الإنسان بأكثر عمله ، فإن كانت الصلاة أكثر دعي بها ، وإن كان صيامه أكثر دعي به ، ثم يأتي بابا من أبواب الجنة يقال له الريان يدعاى منه الصائمون ، قال أبو بكر : أثم أحد يدعاى بعملين ؟ قال : نعم أنت ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 309 / 29334 قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة قام ثلة من الناس يسدون الأفق نورهم كالشمس ، فيقال النبي الأمي ، فيتحشحش لها كل شيء فيقال : محمد وأمته ، ثم يقوم ثلة أخراى يسد ما بين الأفق ، نورهم كالقمر ليلة البدر فقال : النبي الأمي فيتحشحش لها كل شيء فيقال محمد وأمته ، ثم يقوم ثلة أخراى يسد ما بين الأفق نورهم مثل كل كوكب في السماء فيقال : النبي الأمي فيتحشحش كل شيء ثم يحثاى حثيتين فيقال ) هاذا مني لك يا محمد ، ثم يوضع الميزان 
ms3171	 ويؤخذ في الحساب ) )(@)(@@) . ( طك ، عن أبي أمامة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 310 / 29335 قال النبي :(@)(@@) | 30 ( إذا كان يوم القيامة لم يبق مؤمن إلا أتي بيهودي أو نصراني حتى يدفع إليه فيقال هاذا فداؤك من النار ) )(@)(@@) . ( حم ، عن أبي موساى رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 311 / 29336 قال النبي :(@)(@@) | 30 ( إذا كفن أحدكم أخاه فليحسن كفنه وصلوا علاى الميت بالليل والنهار أربع تكبيرات في الليل والنهار سواء ) )(@)(@@) . ( حم ، طس ، عن جابر رضي الله عنه ) . .(@)(@@) PageV10P057(@)(@@)(@@)(@@) $ 312 / 29337 قال النبي :(@)(@@) | 30 ( إذا كنت ترجو نتجا فتبلغ بلحوم ماشيتك أو كنت ترجو ميسرة تنالها فتبلغ إليها من لحوم ماشيتك ، فإن كنت لا ترجو شيئا فأطعم أهلك فيما بدا لك حتى تستغني عنه ، فقال : ما غناي الذي أدعه إذا وجدته ؟ فقال : إذا أديت أهلك عيونا من اللبن واجتنب ما حرم ، عليك من الطعام وأما مالك فإنه ميسور لك كل ليس فيه حرام غير أن في نتجك في إبلك فرعا وفي نتجك من غنمك فرعا تغذوه ماشيتك حتى تستغني عنه ، ثم إن شئت أطعمته أهلك ، وإن شئت تصدقت بلحمه ، وأمره بعنز من الغنم في كل مائة عنيزة ) )(@)(@@) . ( بز ، طك ، عن ابن مسعود رضي الله عنه قال سأل النبي رجل ما فقري وما الذي آكل من ذالك إذا بلغته وما غناي الذي يغنيني عنه ؟ فذكره ) . .(@)(@@)(@@)(@@) $ 313 / 29338 قال النبي :(@)(@@) | 30 ( إذا كنت في قوم عشرين رجلا أو أقل أو أكثر فلم ير فيهم من لا يهاب في الله عز وجل فاعلم أن الأمر قد رق ) )(@)(@@) . ( حم ، طك ، عن عبد الله بن بشير رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 314 / 29339 قال النبي :(@)(@@) | 30 ( إذا كنتم في جماعة فرأيتم من يفرق جماعتكم ، ويشق عصاكم فاقتلوه كائنا من كان من الناس ) )(@)(@@) . ( طس ، عن محمد بن صريح الأشجعي رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 315 / 29340 قال النبي :(@)(@@) | 30 ( إذا كنتم في الخصب أمكنوا الركب سنتها ، ولا تعدوا المنازل ، وإذا كنتم في الجدب فانجوا ، وعليكم بالدلجة فإن الأرض تطواى بالليل ، وإذا تغولت بكم الغيلان فبادروا بالأذان ولا تصلوا 
ms3172	 علاى جواد الطريق ولا تنزلوا عليها فإنها مأواى الحيات والسباع ، ولا تقضوا عليها الحوائج فإنها الملاعن ) )(@)(@@) . ( ع ، عن جابر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 316 / 29341 قال النبي :(@)(@@) | 30 ( إذا مات لكم ميت فادفنوه ) )(@)(@@) . ( طك ، عن PageV10P058 أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 317 / 29342 قال النبي :(@)(@@) | 30 ( إذا مشاى الرجل إلاى الرجل فقتله ، فالمقتول في الجنة والقاتل في النار ) )(@)(@@) . ( طس ، عن عمر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 318 / 29343 قال النبي :(@)(@@) | 30 ( إذا نزلت بكم رغبة أو رهبة إلاى من تفزعون ؟ قالوا : إلاى الله ، قال : إذا جاء بكم قال إلاى من تعودون ؟ قالوا : إلاى ما تعلم ، قال : تعلمون ولا تعملون ، تعلمون ولا تعملون ، تعلمون ولا تعملون ثلاثا ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 319 / 29344 قال النبي :(@)(@@) | 30 ( إذا نودي للصلاة فتحت أبواب السماء واستجيب الدعاء ) )(@)(@@) . ( ع ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 320 / 29345 قال النبي :(@)(@@) | 30 ( إذا وجد أحدكم ألما فليضع يده حيث يجد ألمه وليقل سبع مرات : أعوذ بعزة الله وقدرته علاى كل شيء من شر ما أجد ) )(@)(@@) . . ( حم ، طك ، خد ، عن كعب بن مالك رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 321 / 29346 قال النبي :(@)(@@) | 30 ( إذا وجد أحدكم وهو في صلاته رزءا فلينصرف فليتوضأ ) )(@)(@@) . ( حم ، طسص ، عن سهيل بن صالح عن أبي هريرة رضي الله عنه ورجاله موثقون ) . .(@)(@@)(@@)(@@) $ 322 / 29347 قال النبي :(@)(@@) | 30 ( إذا وقع الذباب في إناء أحدكم فليغمسه ، فإن في أحد جناحيه داء وفي الآخر شفاء ) )(@)(@@) . ( بز ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 323 / 29348 قال النبي :(@)(@@) | 30 ( إذا وقع الطاعون بأرض وأنتم فيها فلا تخرجوا منها ، وإذا وقع فيها ولستم بها فلا تقدموا عليه ، وفي رواية : إذا كان بأرض ولستم فيها فلا تقربوها ) )(@)(@@) . ( حم ، عن عكرمة بن خالد المخزومي عن أبيه أو عن عمه عن جده ) . .(@)(@@) PageV10P059(@)(@@)(@@)(@@) $ 324 / 29349 قال النبي :(@)(@@) | 30 ( إذا وقف العباد للحساب جاء قوم واضعي سيوفهم علاى رقابهم تقطر دما ، فازدحموا على باب الجنة ، فقيل : من هاؤلاء ؟ قيل : الشهداء كانوا أحياء مرزوقين ، ثم ناداى مناد : ليقم من أجره علاى الله فليدخل 
ms3173	 الجنة ثم ناداى الثانية : ليقم من أجره علاى الله فليدخل الجنة ، فقام كذا وكذا ألفا فدخلوها بغير حساب ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 325 / 29350 قال النبي :(@)(@@) | 30 ( إذا وقف العبد للحساب جاء قوم واضعي سيوفهم علاى رقابهم تقطر دما فازدحموا علاى باب الجنة ، فقيل : من هاؤلاء ؟ قيل : الشهداء كانوا أحياء مرزوقين ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 326 / 29351 قال النبي :(@)(@@) | 30 ( إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات إحداهن بالتراب ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 327 / 29352 قال النبي :(@)(@@) | 30 ( اذبحوا بكل شيء فري الأوداج ما خلا السن والظفر ) )(@)(@@) . ( طس ، عن حذيفة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 328 / 29353 قال النبي :(@)(@@) | 30 ( اذبحوا في أي شهر كان ، وبروا الله وأطعموا ) )(@)(@@) . ( طس ، عن أنس رضي الله عنه قال رجل : إنا كنا نحترز في الجاهلية فما تأمرنا ؟ فذكره ) . .(@)(@@)(@@)(@@) $ 329 / 29354 قال النبي :(@)(@@) | 30 ( اذكروا اسم الله وليأكل أحدكم مما يليه ) )(@)(@@) . ( طس ، عن عمر بن أبي سلمة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 330 / 29355 قال النبي :(@)(@@) | 30 ( أذن في الناس ! الصلاة جامعة : لا يدخلن الجنة إلا نفس مسلمة ) )(@)(@@) . ( طك ، عن خالد بن الوليد رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 331 / 29356 قال النبي :(@)(@@) | 30 ( أذن يا سحم في الناس أنه لا يدخل الجنة إلا مؤمن ) )(@)(@@) . ( حم ، عن جابر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 332 / 29357 قال النبي :(@)(@@) | 30 ( إذن يتركون جميعا ولاكن خذ بالفضل PageV10P060 وصلهم ، فإنه لن يزال معك ظهير من الله ما كنت علاى ذالك ) )(@)(@@) . ( حم ، عن ابن عمرو رضي الله عنه قال : قال رجل إن لي ذوي أرحام : أصل ويقطعون ، وأغفر ويظلمون ، وأحسن ويسيئون أنا كافيهم فذكره ) . .(@)(@@)(@@)(@@) $ 333 / 29358 قال النبي :(@)(@@) | 30 ( أذن لي أن أحدث عن ملك قد مرقت رجلاه الأرض السابعة ، والعرش علاى منكبيه وهو يقول : سبحانك أين كنت وأين تكون ) )(@)(@@) . ( ع ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 334 / 29359 قال النبي :(@)(@@) | 30 ( اذهب فأتم وضوءك ) )(@)(@@) . ( طسص ، عن أبي بكر رضي الله عنه قال : كنت جالسا عند رسول الله فجاء رجل 
ms3174	 توضأ وفي قدميه موضع لم يصبه الماء فذكره ) . .(@)(@@)(@@)(@@) $ 335 / 29360 قال النبي :(@)(@@) | 30 ( اذهبي أم سلمة فأعطيه الأربعين وربما التي عندها ) )(@)(@@) . ( حم ، عن أنس رضي الله عنه قال : أتاى النبي سائل فأمر له بتمرة فلم يأخذها وقال سبحان الله تمرة من رسول الله ؟ فقال للجارية : اذهبي الخ . . . ) . .(@)(@@)(@@)(@@) $ 336 / 29361 قال النبي :(@)(@@) | 30 ( اذهبي فاختضبي ثم تعالي حتى أبايعك ) )(@)(@@) . ( طكس ، عن السوار رضي الله عنه ) . .(@)(@@)(@@)(@@) ||| ( الهمزة مع الراء )(@)(@@)(@@)(@@) $ 337 / 29362 قال النبي :(@)(@@) | 30 ( أرأيت إن كان علاى أبيك دين أكنت تقضيه عنه ؟ قالت : نعم ، قال : فإنه دين الله فاقضيه ) )(@)(@@) . ( بز ، طكس ، عن عقبة بن عامر رضي الله عنه أن امرأة قالت : أحج عن أمي وقد ماتت ؟ فذكره ) . .(@)(@@) PageV10P061(@)(@@)(@@)(@@) $ 338 / 29363 قال النبي :(@)(@@) | 30 ( أرأيت لو كان علاى أبيك دين فقضيت عنه قبل موتك ؟ قال : نعم ، قال : فالله أرحم ، حج عن أبيك ) )(@)(@@) . ( حم ، طك ، عن سودة رضي الله عنها قالت : قال رجل : إن أبي شيخ كبير لا يستطيع الحج فذكره ) . .(@)(@@)(@@)(@@) $ 339 / 29364 قال النبي :(@)(@@) | 30 ( أرأيتم الزاني والسارق وشارب الخمر ما تقولون فيهم ؟ قالوا : الله ورسوله أعلم ، قال : هن فواحش وفيهن عقوبة ، ألا أنبئكم بأكبر الكبائر ؟ الإشراك بالله ، ثم قرأ : { ومن يشرك بالله فقد افتراى } ، وعقوقة الوالدين ثم قعرأ : { أن اشكر لي ولوالديك إلي المصير } ، وكان متكئا فاحتفز وقال : ألا وقول الزور ) )(@)(@@) . ( طك ، عن عمران رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 340 / 29365 قال النبي :(@)(@@) | 30 ( أربعة أجبال من أجبال الجنة ، وأربعة أنهار من أنهار الدنيا ، وأربعة ملاحم من ملاحم الجنة ، أحد يحبنا ونحبه جبل من جبال الجنة ، والطور جبل من جبال الجنة ، ولبنان جبل من جبال الجنة ، والأنهار الأربعة : النيل ، والفرات ، وسيحان ، وجيحان ، والملاحم : بدر ، وأحد ، والخندق ، وحنين ) )(@)(@@) . ( طك ، عن عمرو بن عوف رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 341 / 29366 قال النبي :(@)(@@) | 30 ( أربعة أجبال من جبال الجنة ، وأربعة أنهار من أنهار الجنة ، فأما الجبال : فالطور ، ولبنان ، وطور سيناء ، وطور زينا ، والأنهار من الجنة : الفرات ، والنيل ، وسيحان ، وجيحان ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 342 / 29367 
ms3175	 قال النبي :(@)(@@) | 30 ( أربعة تقوم يوم القيامة : رجل أصم لا يسمع شيئا ، ورجل أحمق ، ورجل هرم ، ورجل مات في فترة ، فأما الأصم فيقول : رب لقد جاء الإسلام وما أسمع شيئا ، وأما الأحمق فيقول : يا رب جاء الإسلام والصبيان PageV10P062 يحذفوني بالبعر ، وأما الهرم فيقول : يا رب لقد جاء الإسلام وما أعقل شيئا ، وأما الذي مات في فترة فيقول : رب ما أتاني لك رسول فيأخذ مواثيقهم ليطعنه ، فيرسل إليهم أن ادخلوا النار ، قال : فوالذي نفسي بيده لو دخلوها لكانت عليهم بردا وسلاما ، ومن لم يدخلها يسحب إليها ) )(@)(@@) . ( حم ، عن الأسود بن سريع رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 343 / 29368 قال النبي :(@)(@@) | 30 ( أربعة من الشقاء : جمود العين ، وقسوة القلب ، وطول الأمل ، والحرص علاى الدنيا ) )(@)(@@) . ( بز ، عن أنس رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 344 / 29369 قال النبي :(@)(@@) | 30 ( أربعون خصلة يدخل الله بها الجنة أرفعها منحة شاة ) )(@)(@@) . ( طس ، عن أبي هريرة رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 345 / 29370 قال النبي :(@)(@@) | 30 ( ارجع فإن لله ما أخذ وله ما بقيع وكل أجل بمقدار ) )(@)(@@) . ( بز ، عن أبي هريرة رضي الله عنه قال : ثقل ابن لفاطمة رضي الله عنها فأرسلت لأبيها تدعوه فذكره ) . .(@)(@@)(@@)(@@) $ 346 / 29371 قال النبي :(@)(@@) | 30 ( ارحم المساكين وجالسهم ) )(@)(@@) . ( حم ، عن أبي ذر رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 347 / 29372 قال النبي :(@)(@@) | 30 ( أرشد الرجال رجل بين هاذين الحرمين ، قلة ، يقيم الصلاة لمواقيتها ويحج ويعتمر فلا يزال كذالك حتى تأتيه يد خاطئة ، أو منية قاضية ) )(@)(@@) . ( طس ، عن سعد بن أبي وقاص رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 348 / 29373 قال النبي :(@)(@@) | 30 ( أرض المحشر وأرض النشر ائتوه فصلوا فيه ، فإن صلاة فيه كألف صلاة في غيره ، فمن لم يستطع أن يأتيه فليهد له زيتا يسرج فيه ، فمن أهداى إليه زيتا كان كمن قد أتاه ) )(@)(@@) . ( ع ، عن ميمونة رضي الله عنها قالت : بيت المقدس ) . .(@)(@@)(@@)(@@) $ 349 / 29374 قال النبي :(@)(@@) | 30 ( ارفع ثوبك فإنه أبقاى وأنقاى ) )(@)(@@) . ( حم ، عن PageV10P063 الحارث ، طك ، عن عبيدة بن خالد رضي الله عنه ) . .(@)(@@)(@@)(@@) $ 350 / 29375 قال النبي :(@)(@@) | 30 ( ارفعوا ألسنتكم عن المسلمين ، وإذا مات 
