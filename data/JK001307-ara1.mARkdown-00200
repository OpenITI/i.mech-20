ms196	 مجهول(@)(@@)(@@)(@@) $ 3862 - عبد المؤمن بن عثمان العنبري قال الأزدي ليس بثقة مجهول(@)(@@)(@@)(@@) $ 3863 - ت ق / عبد المهيمن بن عباس بن سهل بن سعد الساعدي ضعفوه(@)(@@)(@@)(@@) $ 3864 - عبد النور المسمعي عن شعبة رافضي كذاب(@)(@@)(@@)(@@) $ 3865 - عبد الواحد بن ثابت الباهلي عن البناني عن أنس PageV02P409 تسحروا ولو بجرعة تفرد به(@)(@@)(@@)(@@) $ 3866 - عبد الواحد بن حمد بن الصباغ سيء السيرة متأخر ذكره ابن النجار(@)(@@)(@@)(@@) $ 3867 - عبد الواحد بن راشد عن أنس وعنه عباد بن عباد بخبر سمي أسير الله في أرضه ليس بعمدة(@)(@@)(@@)(@@) $ 3868 - خ م / عبد الواحد بن زياد العبدي عن الأعمش وغيره صدوق يغرب قال ابن معين ليس بشيء وقال أبو داود الطيالسي عمد إلى أحاديث كان يرسلها الأعمش فوصلها كلها ولينه القطان(@)(@@)(@@)(@@) $ 3869 - عبد الواحد بن زيد البصري الزاهد عن الحسن قال البخاري والنسائي متروك(@)(@@)(@@)(@@) $ 3870 - عبد الواحد بن سليم البصري عن عطاء قال أحمد أحاديثه موضوعة(@)(@@)(@@)(@@) $ 3871 - عبد الواحد بن سليمان الأزدي البراء عن ابن عون مجهول قلت بل معروف PageV02P410(@)(@@)(@@)(@@) $ 3872 - عبد الواحد بن صفوان عن عكرمة قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 3873 - خ عه / عبد الواحد بن عبد الله النصري عن واثلة وثق وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 3874 - عبد الواحد بن عبيد عن يزيد الرقاشي وعنه أبو معاوية مجهول(@)(@@)(@@)(@@) $ 3875 - عبد الواحد بن علي بن برهان العكبري شيخ العربية وافق المعتزلة في أشياء(@)(@@)(@@)(@@) $ 3876 - عبد الواحد بن قيس عن نافع قال يحيى القطان شبه لا شيء(@)(@@)(@@)(@@) $ 3877 - عبد الواحد بن ميمون أبو حمزة عن عروة ضعفة الدارقطني وغيره(@)(@@)(@@)(@@) $ 3878 - عبد الواحد بن نافع الكلاعي عن تابعي قال ابن حبان لا يحل ذكره إلا للقدح فيه(@)(@@)(@@)(@@) $ 3879 - عبد الواحد بن واصل عن أنس ضعفه الأزدي(@)(@@)(@@)(@@) $ 3880 - عبد الواحد عن أبي الدرداء لم يرو عنه إلا محمد بن سوقة(@)(@@)(@@)(@@) $ 3881 - عبد الواحد أبو الرماح الكلابي شيخ للتبوذكي ضعف روى حديثا في تأخير العصر(@)(@@)(@@)(@@) $ 3882 - عبد الوارث بن سعيد التنوري ثبت لكن رمي بالقدر وكان حماد بن زيد ينهى عنه 
ms197	 لذلك PageV02P411(@)(@@)(@@)(@@) $ 3883 - عبد الوارث بن صخر الحمصي شيخ لسليمان بن بنت شرحبيل مجهول(@)(@@)(@@)(@@) $ 3884 - عبد الوارث بن غالب عن ثابت البناني لا يعرف وحديثه منكر(@)(@@)(@@)(@@) $ 3885 - عبد الوارث عن أنس بن مالك ضعفه الدارقطني وهو من موالي أنس(@)(@@)(@@)(@@) $ 3886 - عبد الوهاب بن إسحاق القرشي في عصر هشيم مجهول(@)(@@)(@@)(@@) $ 3887 - د س / عبد الوهاب بن بخت المكي صدوق في أحاديثه أوهام كثيرة(@)(@@)(@@)(@@) $ 3888 - عبد الوهاب بن جعفر الميداني الدمشقي قال عبد العزيز الكتاني اتهم في أبي علي بن هارون وكان رحمه الله فيه تساهل(@)(@@)(@@)(@@) $ 3889 - عبد الوهاب بن الحسن قال أبو حاتم أحاديثه مناكير ولا أعرفه له عن شيبان(@)(@@)(@@)(@@) $ 3890 - ق / عبد الوهاب بن الضحاك الحمصي العرضي متهم تركوه ومن طبقته(@)(@@)(@@)(@@) $ 3891 - عبد الوهاب بن الضحاك نيسابوري ثقة معروف(@)(@@)(@@)(@@) $ 3892 - عبد الوهاب بن عبد الله بن صخر عن أبيه وعنه عبد الصمد ابن عبد الوارث مجهول(@)(@@)(@@)(@@) $ 3893 - عبد الوهاب بن عبد الله أبو القاسم البغدادي رأس في الإعتزال(@)(@@)(@@)(@@) $ 3894 - ع / عبد الوهاب بن عبد المجيد بن الصلت مجهول قلت ذا هو الثقفي مشهور ثقة قال ابن معين اختلط بآخرة PageV02P412(@)(@@)(@@)(@@) $ 3895 - م عه / عبد الوهاب بن عطاء الخفاف ضعفه أحمد وقواه غيره(@)(@@)(@@)(@@) $ 3896 - عبد الوهاب بن عمر بن شرحبيل يروي عنه عمرو بن الحارث المصري مجهول(@)(@@)(@@)(@@) $ 3897 - عبد الوهاب بن مجاهد بن جبر عن أبيه قال النسائي وغيره متروك(@)(@@)(@@)(@@) $ 3898 - عبد الوهاب بن محمد الفارسي الفامي مدرس النظامية متأخر ليس بثقة(@)(@@)(@@)(@@) $ 3899 - عبد الوهاب بن موسى عن عبد الرحمن بن أبي الزناد نكرة والخبر أحيا الله لي أمي فآمنت بي والسند ظلمة(@)(@@)(@@)(@@) $ 3900 - عبد الوهاب بن نافع العامري المطوعي عن مالك قال العقيلي منكر الحديث ووهاه الدارقطني(@)(@@)(@@)(@@) $ 3901 - عبد الوهاب بن هشام بن الغاز قال أبو حاتم كان يكذب(@)(@@)(@@)(@@) $ 3902 - عبد الوهاب بن همام أخو عبد الرزاق قال أبو حاتم كان يغلو في التشيع وقال الأزدي يتكلمون فبه(@)(@@)(@@)(@@) $ 3903 - عبد الوهاب المغربي عن موسى بن وردان مجهول(@)(@@)(@@)(@@) $ 3904 - عبد الوهاب عن ابن 
ms198	 عمر وعنه يحيى بن سعيد الأنصاري لا يعرف(@)(@@)(@@)(@@) $ 3905 - عبدان بن يسار عن أحمد البرقي أتى بخبر موضوع PageV02P413(@)(@@)(@@)(@@) $ 3906 - عبدة بن عبد الرحيم المروزي عن ابن عيينة قال أبو داود لا أحدث عنه(@)(@@)(@@)(@@) $ 3907 - عبيد الله بن إبراهيم الجزري عن عمرو بن عون له خبر موضوع(@)(@@)(@@)(@@) $ 3908 - عبيد الله بن أحمد بن معروف قاضي القضاة وثقه الخطيب لكنه معتزلي(@)(@@)(@@)(@@) $ 3909 - عبيد الله بن أحمد الأندلسي عن الطبراني بخبر موضوع في فضل القراءات لم يروه الطبراني(@)(@@)(@@)(@@) $ 3910 - عبيد الله بن الأزور عن هشام بن حسان له حديث ساقط(@)(@@)(@@)(@@) $ 3911 - عبيد الله بن اسحاق بن حماد الطلحي قال أبو حاتم ليس بقوي(@)(@@)(@@)(@@) $ 3912 - عبيد الله بن أنس روى عنه عبد الرحيم بن سليم لا يعرف(@)(@@)(@@)(@@) $ 3913 - م د / عبيد الله بن إياد بن لقيط ثقة قيل إن بعض روايته صحيفة قاله ابن قانع(@)(@@)(@@)(@@) $ 3914 - عبيد الله بن بشير البجلي مجهول روى عنه يونس ابن أبي إسحاق(@)(@@)(@@)(@@) $ 3915 - عبيد الله بن تمام أبو عاصم عن يونس بن عبيد ضعفوه(@)(@@)(@@)(@@) $ 3916 - ع / عبيدالله بن أبي جعفر عن بكير بن الأشج وغيره وثق وقال أحمد ليس بقوي(@)(@@)(@@)(@@) $ 3917 - عبد الله بن الحارث عن عبدالله بن عمرو لا يصح حديثه PageV02P414(@)(@@)(@@)(@@) $ 3918 - ق / عبيد الله بن أبي حميد أبو الخطاب عن عطاء قال أحمد تركوا حديثه(@)(@@)(@@)(@@) $ 3919 - س / عبيد الله بن الخشخاش عن أبي ذر رضي الله عنه لا يعرف(@)(@@)(@@)(@@) $ 3920 - س ق / عبيد الله بن خليفة أبو الغريف عن علي فيه كلام(@)(@@)(@@)(@@) $ 3921 - عبيد الله بن رماحس شيخ الطبراني ما علمت أحدا وهاه ولا احتج به(@)(@@)(@@)(@@) $ 3922 - عه / عبيد الله بن زحر عن علي بن يزيد مختلف فيه وهو إلى الضعف أقرب ضعفه أحمد بن حنبل وقال النسائي لا بأس به(@)(@@)(@@)(@@) $ 3923 - د ت ق / عبدي الله بن أبي زياد القداح لينه يحيى وقال أحمد صالح الحديث وقال أبو داود أحاديثه مناكير وقال ابن عدي لم أر له شيئا منكرا سمع أبا الطفيل(@)(@@)(@@)(@@) $ 3924 - عبيد الله 
ms199	 بن سالم عن ابن عمر مجهول(@)(@@)(@@)(@@) $ 3925 - د / عبيد الله بن سعيد الثقفي مثله تابعي روى عنه أبو عون(@)(@@)(@@)(@@) $ 3926 - عبيد الله بن سعيد أبو مسلم قائد الأعمش قال البخاري في حديثه نظر(@)(@@)(@@)(@@) $ 3927 - عبيد الله بن سعيد بن كثير المصري عن أبيه فيه ضعف ذكره ابن حبان PageV02P415(@)(@@)(@@)(@@) $ 3928 - عبيد الله بن سفيان أبو سفيان عن ابن عون كذبه يحيى بن معين(@)(@@)(@@)(@@) $ 3929 - عبيد الله بن سليمان عن عبد الرزاق بخبر كذب(@)(@@)(@@)(@@) $ 3930 - د س ق / عبيد الله بن عبد الله أبو المنيب العتكي المروزي وثقه ابن معين وقال البخاري عنده مناكير وأنكر أبو حاتم على البخاري إدخاله في الضعفاء(@)(@@)(@@)(@@) $ 3931 - عبيد الله بن عبد الله العتكي مصري عن أنس وعنه النضر ابن شميل كرره ابن عدي ولم يدر ثم قال له مناكير(@)(@@)(@@)(@@) $ 3932 - عبيد الله بن عبد الله بن الحصين الخطمي قال البخاري في حديثه نظر(@)(@@)(@@)(@@) $ 3933 - ت ق / عبيد الله بن عبد الله بن موهب التيمي والد يحيى قال أحمد أحاديثه مناكير(@)(@@)(@@)(@@) $ 3934 - د س ق / عبيد الله بن عبد الرحمن بن موهب عن ابن المسيب اختلف قول ابن معين فيه وهو صالح الحديث(@)(@@)(@@)(@@) $ 3935 - عبيد الله بن عبد الرحمن الأصم عن أبيه لا يعرف وأبوه واه(@)(@@)(@@)(@@) $ 3936 - ع / عبيد الله بن عبد المجيد أبو علي الحنفي ثقة قال ابن معين ليس بشيء PageV02P416(@)(@@)(@@)(@@) $ 3937 - عبيد الله بن عبد الملك أبو كلثوم العبدي قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 3938 - ت ق / عبيد الله بن عكراش شيخ للعلاء بن الفضل مجهول وقال ابن حبان منكر الحديث(@)(@@)(@@)(@@) $ 3939 - د ت / عبيد الله بن علي بن أبي رافع عن أبيه صويلح فيه لين(@)(@@)(@@)(@@) $ 3940 - عبيد الله بن علي بن المارستانية من شيوخ ابن خليل عن شهدة كذاب متهم(@)(@@)(@@)(@@) $ 3941 - عبيد الله بن عمر بن موسى التيمي عن ربيعة فيه لين وهو عم عبيد الله العيشي(@)(@@)(@@)(@@) $ 3942 عبيد الله بن عمر الفقيه بغدادي نزل قرطبة وروى عمن لم يدرك وهو إمام في القراءات(@)(@@)(@@)(@@) $ 3943 
ms200	 - عبيد الله بن غالب هو ابن أبي حميد عن أبي المليح تركوه وقد مر(@)(@@)(@@)(@@) $ 3944 - عبيد الله بن محمد بن بطة العكبري إمام لكنه لين صاحب أوهام مات سنة ثمانين وثلثمائة(@)(@@)(@@)(@@) $ 3945 - عبيد الله بن محمد بن البيهقي قال ابن عساكر سمع لنفسه في جزء تسميعا طريا وما عدا ذلك صحيح(@)(@@)(@@)(@@) $ 3946 - عبيد الله بن محمد بن الكلابي الدمشقي عن دحيم ضعفوه(@)(@@)(@@)(@@) $ 3947 - عبيد الله بن محمد الطابخي عن أبيه عن أبي هريرة لا يدرى من هو PageV02P417(@)(@@)(@@)(@@) $ 3948 - عبيد الله بن محمد بن عبد العزيز العمري شيخ للطبراني رماه النسائي بالكذب(@)(@@)(@@)(@@) $ 3949 - عبيد الله بن محمد الاسكندراني عن رجل مجهول ذكر له أبو أحمد الحاكم خبرين ساقطين(@)(@@)(@@)(@@) $ 3950 - خ / عبيد الله بن محرز عن الشعبي لم يرو عنه سوى أبو نعيم فيما أعلم(@)(@@)(@@)(@@) $ 3951 - عبيد الله بن موسى بن معدان عن منصور لم يأت إلا في حديث منكر(@)(@@)(@@)(@@) $ 3952 - خ عبيد الله بن موسى شيخ للبخاري ثقة شيعي متحرق لم يرو عنه أحمد لذلك(@)(@@)(@@)(@@) $ 3953 - ت ق عبيد الله بن الوليد الوصافي عن عطية ضعفوه(@)(@@)(@@)(@@) $ 3954 - عبيد الله بن يعقوب الرازي الواعظ بعد الثلاثمائة كذبه أبو علي النيسابوري سمع صالحا جزرة(@)(@@)(@@)(@@) $ 3955 - عبيد بن إسحاق العطارعن شريك ضعفوه ورضيه أبو حاتم(@)(@@)(@@)(@@) $ 3956 - عبيد بن الأغر أو عبيد الأغر لا يعرف وما روى عنه سوى موسى بن عبيدة PageV02P418(@)(@@)(@@)(@@) $ 3957 - عبيد بن أوس الغساني كاتب لمعاوية ما روى عنه إلا ابنه محمد فقط(@)(@@)(@@)(@@) $ 3958 - عبيد بن باب والد عمرو المعتزلي قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 3959 - عبيد بن حجر ما روى عنه سوى أبي أسامة(@)(@@)(@@)(@@) $ 3960 - س / عبيد بن الخشخاش عن أبي ذر قال البخاري لم يذكر أن سمعه حديث آدم بني مكلم(@)(@@)(@@)(@@) $ 3961 - عبيد بن حمران أبو معبد عن علي مجهول(@)(@@)(@@)(@@) $ 3962 - ق / عبيد بن زيد عن سمرة لا يعرف(@)(@@)(@@)(@@) $ 3963 - عبيد بن خنيس العبدي قال الدارقطني متروك(@)(@@)(@@)(@@) $ 3964 - عبيد بن سلمان الكلبي والد البختري بن عبيد تابعي لا يعرف(@)(@@)(@@)(@@) $ 3965 