ms121	 % 15(@)(@@) % ولا أنا جلد على فاقتي % % فأمسي لأثقالها حاملا % % 16(@)(@@) % وفي الأمر قد بقيت خصلة % تكون بها بيننا فاصلا % 17(@)(@@) % فإما تصيره كاتبا % وإما تصيرني غاسلا % % PageV01P460 البحر : خفيف تام 1(@)(@@) % ومغن إذا الغناء شفا الهم % أعار القلوب هما دخيلا % % 2(@)(@@) % خارج طبعه فإن دخل الدا % % ر كرهنا خروجه والدخولا % 3(@)(@@) % قل له لا أبا له حين تلقا % % ه وحاشاك أن تكون رسولا % 4(@)(@@) % يا أبا الفتح ما غناؤك مطبو % % عا ولا مؤثرا ولا مقبولا % 5(@)(@@) % ما تخيرت من كتاب الأغاني % % لك شبها إلا الخفيف الثقيلا % 6(@)(@@) % لو قضى الله لي بخير وللنا % % س لكنت المعلق المحمولا % % 7(@)(@@) % ولكم ليلة رعى منك سمعي % % وفؤادي مرعى وخيما وبيلا % 8(@)(@@) % جمد الدهن وهي حرى فقصر % ت فضاهت يوم القيامة طولا % % 9(@)(@@) % ذدت عن عيني الرقاد فلم تب % تبعث نشاطا ولا شفيت العليلا % % 10(@)(@@) % ف نصرف عن كلاءة الله يا فت % ح بغيضا مودعا مملولا % PageV01P461 البحر : متقارب تام 1(@)(@@) % أماطت لثاما وأبدت هلالا % وراشت نبالا وسلت نصالا % 2(@)(@@) % ومنت محالا وغنت مطالا % % وصدت ملالا وملت دلالا % % 3(@)(@@) % وضنت على مدنف لم تدع % فنون الأسى منه إلا خيالا % 4(@)(@@) % أبا قلبه أن يطيق السلو % وعثرته في الهوى أن تقالا % % 5(@)(@@) % وبالجزع منفرد بالجمال % يميس قضيبا ويرنو غزالا % 6(@)(@@) % تغير لواحظه في القلوب % فترجع بالسبي منه ثقالا % 7(@)(@@) % كثير الملال فما باله % على زعمه لا يمل الملالا % 8(@)(@@) % وما شغفي برمال العقيق % ولكن بمن حل تلك الرمالا % 9(@)(@@) % ولا أن سكان ذاك الجناب % أسكن قلبي داء عضالا % 10(@)(@@) % جلبن لكل خلي هوى % % وأورثن كل فؤاد خبالا % % PageV01P462 11(@)(@@) % وقلدن بالدر تلك الثغور % وحملن كل قضيب هلالا % % 12(@)(@@) % وخفن على الحسن أن يستتيه % ألحاظنا ف تخذن الحجالا % 13(@)(@@) % دنون فلما ملكن القلوب % أصبحن فوق الثريا منالا % 14(@)(@@) % على أنني ما خلعت العذار % في الحب حتى لبسن الجمالا % PageV01P463 البحر : مجزوء الكامل 1(@)(@@) % يا من جلا بقدومه % الميمون عن عيني قذاها % % 2(@)(@@) % وأعاد لما عاد أ % يام السرور كما بداها 
ms122	 % % 3(@)(@@) % وح نبتها % % ودجى ضحاها % % 4(@)(@@) % مذ غبت ما أنست إلى % % غمض ولا طعمت كراها % % 5(@)(@@) % وتوحشت بغداذ لي % % لما بعدت وجانباها % % 8(@)(@@) % أمست وقد ودعتها % % عطلا فلا عدمت حلاها % % 9(@)(@@) % عميت مطالعها فعد % ت ونور وجهك قد جلاها % % 11(@)(@@) % أليوم أصبح مؤنقا % بك جوها عبقا ثراها % % 12(@)(@@) % يا من له كف تع % بغ ظلها وحلا جناها % % 13(@)(@@) % واخضر يابس عودها % % بنداك واخضلت رباها % % PageV01P464 14(@)(@@) % كادت تمور وقد عرا % % ها من فراقك ما عراها % % 15(@)(@@) % لكن تذاكرها بها % % ء الدين فاشتدت قواها % % 16(@)(@@) % ذاد الردى عن ذودها % % وحمى بسطوته حماها % % 18(@)(@@) % كفوء إذا نيطت ملما % % ت الأمور به كفاها % % 19(@)(@@) % قلدته عضبا إذا % % مس الخطوب به براها % % 21(@)(@@) % بعزيمة كالنجم لم % تتعد في شبه أباها % % 22(@)(@@) % متقيلا لك لا يزا % % ل بوجهه لك الاتجاها % % 24(@)(@@) % يا دوحة المجد الذي % % شرف المظفر منتهاها % % 25(@)(@@) % وعصابة الملك التي % % اختار الخليفة وارتضاها % % 26(@)(@@) % ألطاعنو ثغر العدى % % والحرب قد دارت رحاها % % PageV01P465 27(@)(@@) % تشكو السيوف إليهم % قصرا فيشكيها خطاها % % 28(@)(@@) % بمحمد شادت قوا % % عد مجدها وعلا بناها % % 29(@)(@@) % ملك إذا الأيام ر % ث جديد رونقها كساها % % 30(@)(@@) % أفنى خزائن ماله % وشرى المحامد ف قتناها % % 31(@)(@@) % راض الأمور فأصبحت % طوع الأزمة و متطاها % % 33(@)(@@) % يفني المدى جريا إذا % % ما الخيل أفناها مداها % % 34(@)(@@) % يا من له كف تعلمت السحائب من سخاها % ب من سخاها % % 35(@)(@@) % تنهل مغدقة على % % ما حاد عن نهج السبي % % 36(@)(@@) % لك في القلوب محبة % ثبتت فلم تنكث قواها % % 37(@)(@@) % حتى كأنك من ضما % % ئرها خلقت ومن هواها % % PageV01P466 38(@)(@@) % وكأنما جبل القلو % % ب على ودادك من براها % % PageV01P467 البحر : مجزوء الكامل 1(@)(@@) % أهلا بطلعة زائر % فضح الدجا بضيائها % % 2(@)(@@) % سمح الخيال بوصلها % % فدنت على عدوائها % % 3(@)(@@) % باتت تعاطيني المدام % وكنت من أكفائها % % 4(@)(@@) % فسكرت من ألحاظها % % وغنيت عن صهبائها % % 5(@)(@@) % بيضاء قتلي دأبها % % في نأيها وثوائها % % 6(@)(@@) % فإذا دنت بجفونها % % وإذا نأت بجفائها % % 7(@)(@@) % لا يلتقي أبدا موا % % عدها بيوم وفائها % % 8(@)(@@) % ألشمس من 
ms123	 ضراتها % % والبدر من رقبائها % % 9(@)(@@) % والصبح فوق لثامها % % والليل تحت ردائها % % 11(@)(@@) % تسبت إلى حمرائها % % تجول حول خبائها % % PageV01P468 12(@)(@@) % فالموت دون فراقها % % والموت دون لقائها % % 13(@)(@@) % ولقد مررت بربعها % % فة في ذرى عليائها % % 14(@)(@@) % والعين في الأطلال سا % % كنة على أطلائها % % 15(@)(@@) % فوقفت أنشد في مطا % % دنيا على أبنائها % % 17(@)(@@) % يا موحش العين التي % % أنست بطول بكائها % % 18(@)(@@) % غادرت بين جوانحي % % نفسا تموت بدائها % % 19(@)(@@) % أشفت فكنت شفاء ع % وأنت في سودائها % % 20(@)(@@) % فإذا بخلت بنظرة % سمحت بجمة مائها % % 21(@)(@@) % فكأنها كف الخليفة % أسبلت بعطائها % % 26(@)(@@) % لتها وشمس ضحائها % % اضين من خلفائها % % PageV01P469 27(@)(@@) % فإذا تخمط في وغا % % خضب العدى بدمائها % % 28(@)(@@) % مضرية تنمى إذا ن % ئبه على أعدائها % % 29(@)(@@) % ملك يحل من الخلا % جمالها وبهائها % % 30(@)(@@) % عزمات من آرائها % % ما أجدبت أرض وص % 31(@)(@@) % ونهضت مضطلعا بما % % حملت من أعبائها % % 34(@)(@@) % يرمي مواضع نقبها % % وب نداه من أنوائها % % 35(@)(@@) % من عصبة لا تملك الأيا % % م رد قضائها % % 38(@)(@@) % لا يرتضى من عامل % عمل بغير ولائها % % 39(@)(@@) % تستنزل البركات ما % % قنط الثرى بدعائها % % 40(@)(@@) % لا تدرك الأفهام غا % % ية حمدها وثنائها % % PageV01P470 41(@)(@@) % بأبي محمد الإما % % م نمت فروع علائها % % 43(@)(@@) % يا بهجة المجد التي % % ب حاذق بدوائها % % 44(@)(@@) % كشفت لنا ظلم الخطو % % ب برأيها وروائها % % 45(@)(@@) % لك راحة فضلت شآ % % بيب الحيا بسخائها % % 46(@)(@@) % تنهل جودا فالحبي % الجود دون حبائها % % 47(@)(@@) % وعزيمة تعنو السيو % % ف لحدها ومضائها % % 49(@)(@@) % أنت الغياث لأمة % فرجت من غمائها % % 50(@)(@@) % بدلتها من يوم شد % تها بيوم رخائها % % 52(@)(@@) % أدركت منها أنفسا % لم يبق غير ذمائها % % 54(@)(@@) % عدلا يؤلف بين ذؤ % بان الفلاة وشائها % % PageV01P471 55(@)(@@) % تاهت ولكن ما رأت % طالت فضول ملائها % % PageV01P472 البحر : كامل تام 1(@)(@@) % يا مشرق البحر الخضم بمائه % إسلم فقد هلك الحسود بدائه % 2(@)(@@) % ألحامل العبء الثقيل بكاهل % قلل الهضاب الشم من أعبائه % 3(@)(@@) % ومنيرها رأد النهار وقد دجت % بثواقب العزمات من أرآئه % 4(@)(@@) % ومبيد شمل المال حتى خلته % أمسى ينافسه على عليائه % 5 
ms124	(@)(@@) % لما طما بحر العراق مزمجرا % ثانية متخمطا بغثائه % 6(@)(@@) % ألقى على الأرض الفضاء جرانه % حتى لتقت حيتانه بظبائه % 7(@)(@@) % ورمى التلاع بمثلها من موجه ال % طامي وغادر أرضه كسمائه % 8(@)(@@) % يطأ الشواهق والإكام بخطوه % ويجر بالبيداء فضل ردائه % 9(@)(@@) % أخجلته بنوالك الغمر الذي % % غمر البلاد فجاش لاستحيائه % 10(@)(@@) % حتى لقد ظن العدو بجهله % مما رأى أن لست من أكفائه % PageV01P473 11(@)(@@) % أرديته بالرأي قبل نزاله % وقذفته بالرعب قبل لقائه % 12(@)(@@) % ورددته وزئير بأسك خارق % سمعيه من قدامه وورائه % 13(@)(@@) % ولى على الأعقاب يجمع نفسه % كالأفعوان نسل من خرشائه % 14(@)(@@) % يا بحر كيف طلبت شأو محمد % مهلا فلست اليوم من نظرائه % 15(@)(@@) % هذا الذي أمسى الأنام بجوده % أسرى وظلوا اليوم من طلقائه % 16(@)(@@) % فهم وقد حضر النفوس حمامها % % عتقاؤه وهم عبيد عطائه % 17(@)(@@) % إن يكفروك فلست أول منعم % نالت يد الكفران من نعمائه % 18(@)(@@) % يا من يطارحه العلاء تحذيا % بفعاله وتشبها بسخائه % 19(@)(@@) % ما أنتم ممن يسد مسده % يوما ولا تبلون مثل بلائه % 20(@)(@@) % أنى لكم بوقاره وسداده % ووفائه وإبائه ومضائه % PageV01P474 21(@)(@@) % يا من كفاني ريب دهري أنني % % أمسيت بين الناس من شعرائه % 22(@)(@@) % ضاهيت نوحا في النجاة بفلكه % وشركت روح الله في إحيائه % 23(@)(@@) % متقيلا كسرى وليس بمنكر % لك ما أتيت وأنت من أبنائه % 24(@)(@@) % ما مات من أصبحت وارث مجده % يوما ولا من كنت من خلفائه % 25(@)(@@) % فهنا أمير المؤمنين عطية % لله منك تعد من آلائه % 26(@)(@@) % دافعت دون حريمه وبلاده % وعباده وحملت من أعبائه % 27(@)(@@) % لم يدع نصرك في مقام كريهة % إلا وقمت ملبيا لدعائه % 28(@)(@@) % فليحمدن الله ما أمسيت من % أعضاء دولته ومن خلصائه % 29(@)(@@) % آل المظفر أنتم النجم الذي % % لا يهتدي البازي بغير ضيائه % 30(@)(@@) % فالمجد مشرقة بكم هضباته % والملك منصور على أعدائه % PageV01P475 31(@)(@@) % والدين مرفوع العماد بمجده % وبتاجه وسهامه وبهائه % 32(@)(@@) % قوم إذا اعتل الزمان فعندهم % تدبير طب عارف بدوائه % 33(@)(@@) % وإذا السنون تتابعت بجدوبها % % جادوا وقد بخل السحاب بمائه % 34(@)(@@) % يفديكم في المجد كل مقصر 
ms125	 % في نفسه كل على آبائه % 35(@)(@@) % ما زلتم تعطون وهو مبخل % حتى لهجت بمدحكم وهجائه % 36(@)(@@) % فلتشكرنكم قوافي الشعر ما % % اختلف الزمان بصبحه ومسائه % PageV01P476 البحر : خفيف تام 1(@)(@@) % من مجيري ومن يجير على ذي % % جبروت تخشى الملوك سطاه % 2(@)(@@) % ظالم إن مدحته لم أنل خيرا % وإن لم أمدحه خفت أذاه % 3(@)(@@) % فهو لا يشتري المديح ولا يس % مح أني أبيعه من سواه % 4(@)(@@) % ليته تاركي كفافا فلا أر % جوه في حالة ولا أخشاه % PageV01P477 البحر : متقارب تام 1(@)(@@) % أتنكر قتلي بألحاظها % % وهذا دمي في جلابيبها % % 2(@)(@@) % فلله ما ارتكبت من دمي % % وباءت على ضعف تركيبها % % 3(@)(@@) % فرفقا بذي صبوة في هواك % ضعيف العزيمة مغلوبها % % PageV01P478 البحر : متقارب تام 1(@)(@@) % أأحرم دولتكم بعد ما % % ركبت الأماني فأنضيتها % % 2(@)(@@) % وما لي ذنب سوى أنني % % رجوتكم فتمنيتها % % PageV01P479 البحر : كامل تام 1(@)(@@) % إن الأجل وما رأى أحدا % في كربة إلا وفرجها % % 2(@)(@@) % أوفى كميتي بعد ضيعتها % % والله أغناه وأحوجها % % 3(@)(@@) % وبدا له من بعد ما سكنت % رأي فحولها وأزعجها % % 4(@)(@@) % وأظنها أكلت لشقوتها % % من تبنه شيئا فأخرجها % % 5(@)(@@) % ف غفر جنايتها عليك وإن % عظمت فإن الجوع أحوجها % % PageV01P480 البحر : كامل تام 1(@)(@@) % ما ذقت قط أمر من أمري % % في اليسر والسيلان والتمر % 2(@)(@@) % جاز المخاوف والشراة وأصحاب البدارق من بني عمرو % % من بني عمرو % % 3(@)(@@) % والريح في تلك الذنائب ما % % بين اختلاف المد والجزر % 4(@)(@@) % والموج أمثال الجبال إذا ال % ملاح شقل فيه للعبر % 5(@)(@@) % حتى إذا وصل المشوم إلى % % نهر المعلى جانب الجسر % 6(@)(@@) % دهمتني الآفات فيه ولم % أفطن بها من حيث لا أدري % % 7(@)(@@) % وأتوه غلمان زبانية % يتتابعون تتابع القطر % 8(@)(@@) % حتى لقد رفعوا ليومهم % ما حطه الملاح في شهر % 9(@)(@@) % فدعوا التغافل إن سألتكم % و شفوا برد جوابكم صدري % % 10(@)(@@) % كيف ستخرتم مع تفردكم % دون الورى بالتيه والكبر % PageV01P481 11(@)(@@) % أن تعرضوا من غير ما سبب % تتشبثون به ولا عذر % 12(@)(@@) % لهدية جاءت لشاعركم % من غيركم منزورة القدر % 13(@)(@@) % حتى كأني ما نظمت لكم % في 
ms126	 مدحكم بيتا من الشعر % 14(@)(@@) % وكسوتكم حللا مفوفة % بالحمد من نظمي ومن نثري % % 15(@)(@@) % ونشرت في الأحياء ذكركم % فض التجار لطيمة العطر % 16(@)(@@) % قسما بمن قصد الحجيج له % والبيت ذي الأستار والحجر % 17(@)(@@) % ما دمت أنظر في وجوهكم % إن كنت أفلح آخر الدهر % 18(@)(@@) % ولأبكين وهذه معكم % حالي لما ضيعت من عمري % % 19(@)(@@) % وستعلمون من الغبين إذا % % فارقتكم وعرفتم قدري % % PageV01P482 البحر : سريع 1(@)(@@) % يا لك من يوم له حرمة % تقصر الأسن عن شكره % 2(@)(@@) % ببرء مولانا الذي استؤصلت % شافة أهل الجور في عصره % 3(@)(@@) % لو لم يكن فيه سوى رده % كيد أبي الريان في نحره % 4(@)(@@) % وأنه كذب آماله % وكسر الحاجات في صدره % 5(@)(@@) % أمل لا قدره الله أن % يظهر ما يبطن في سره % 6(@)(@@) % حتى استشف الناس من وجهه % ما صور الشيطان في فكره % 7(@)(@@) % فيا أمير المؤمنين عتمد % ما يقتضيه الحزم في أمره % 8(@)(@@) % طهر بلاد العدل من جوره % ونزه الإسلام من كفره % 9(@)(@@) % و كشف عن الدولة ما رابها % % من عاره المخزي ومن عسره % 10(@)(@@) % و ستدرك الفارط في حقه % و خش على بغداذ من مكره % PageV01P483 11(@)(@@) % فربما أخربها شؤمه % لا بارك الرحمن في عمره % PageV01P484 البحر : طويل 1(@)(@@) % أبا الجود ما ناديك بالجود معمور % وعلا بيد الإحسان راجيك مغمور % 2(@)(@@) % لؤمت فلا من ظل يهجوك في الورى % % ملوم ولا من بات يرجوك معذور % 3(@)(@@) % وما زلت معتل الخلال مذمما % فعرضك منقوص ومالك مقصور % 4(@)(@@) % تمد إلى الإحسان كفا بنانها % % يناط به زند من الخير مبتور % 5(@)(@@) % رداء على الخذلان والشؤم مسبل % وذيل على الفحشاء والعار مزرور % 6(@)(@@) % حويت المخازي خسة ودناءة % ولؤما فلا خير لديك ولا خير % 7(@)(@@) % بقيت لأحداث الليالي درية % وليك مخذول وشانيك منصور % 8(@)(@@) % تحاربك الأيام من بعد سلمها % % وأنت ذليل في يد الدهر مقهور % 9(@)(@@) % فلا زلت موتور الليالي وصرفها % % كما الفضل في أيامك السود موتور % 10(@)(@@) % حريمك مبذول وربعك موحش % وشملك مصدوع وبابك مهجور % PageV01P485 البحر : وافر تام 1(@)(@@) % أسفت وقد نضت عني 
ms127	 الليالي % % جديدا من شباب مستعار % 2(@)(@@) % فكان يقيم عندي في زمان الصبى لون الشبيبة في عذاري % % صبي لون الشبيبة في عذاري % % 3(@)(@@) % ولم أكره بياض الشيب إلا % لان العيب يظهر بالنهار % PageV01P486 البحر : متقارب تام 1(@)(@@) % نعمت زمانا مع المترفين % وعشت أخا ثروة موسرا % % 2(@)(@@) % وقضيت عمر الهوى بالوصال % وليل الصبى بالدمى مقمرا % % 3(@)(@@) % طليق العناق خليع العذار % أهوى الغزال إذا عذرا % % 4(@)(@@) % ولم أعص في حكمها غادة % كعابا ولا رشأ أحورا % % 5(@)(@@) % ويا رب صفراء مشمولة % أهنت لها العسجد الأحمرا % % 6(@)(@@) % وغاليت في اللهو لا نادما % لصفقة غبن ولا مخسرا % % 7(@)(@@) % ونادمت كل سخي البنان % يطعم نيرانه العنبرا % % 8(@)(@@) % وجالست كل منيع الحجاب % يفرق منه أسود الشرى % % 9(@)(@@) % رفيع العماد طويل النجاد % يعتصب التاج والمغفرا % % 10(@)(@@) % وزرت الولاة وخضت الفلاة % طورا ثواء وطورا سرى % % PageV01P487 11(@)(@@) % وقدت الجياد تلوك الشكيم % والعيس خاضعة في البرى % % 12(@)(@@) % وما كنت في لذة وانيا % ولا عن طلاب على مقصرا % % 13(@)(@@) % وها أنا من بعد طول الحياة % والخفض صرت إلى ما ترى % % 14(@)(@@) % وغودرت منفردا بالعرا % % وقد قصم الموت تلك العرى % % 15(@)(@@) % كأني رأيت زمان الشباب % ونضرة عيش به في الكرى % % 16(@)(@@) % وما كان مر ليالي السلو % إلا كخطفة برق سرى % % 17(@)(@@) % فقف بي معتبرا إن مررت % على جدثي وابك مستعبرا % % 18(@)(@@) % ولا تخدعن بمغترة % حديث مودتها مفترى % % 19(@)(@@) % ولا تركنن إلى ثروة % مقيلك من بعدها في الثرى % % PageV01P488 البحر : رجز تام 1(@)(@@) % يا لك من ليل حجا % % ب جنحه معتكر % 2(@)(@@) % ظلامه لا ينجلي % % وصبحه لا يسفر % 3(@)(@@) % ليس له إلى الممات % آخر ينتظر % 4(@)(@@) % ما في حياة معه % لذي حصاة وطر % 5(@)(@@) % غادرني كأنني % % في كسر بيت حجر % 6(@)(@@) % لا أهتدي لحاجتي % % وفي الليالي عبر % 7(@)(@@) % أين الشباب والمراح % والهوى والأشر % 8(@)(@@) % أخنت على أيامها % % أيام دهر غدر % 9(@)(@@) % لم يبق لي إلا الأسى % % منهن والتذكر % PageV01P489 البحر : كامل تام 1(@)(@@) % ما لي أرى كتبي بغير جناية % قد طال عندك في الوثاق إسارها % % 2(@)(@@) % أضحت لديك 
ms128	 حبائسا % أثمانها مجهولة أقدارها % % 3(@)(@@) % مهتوكة حرماتها مبذولة % صفحاتها محلولة أزرارها % % 4(@)(@@) % قد أبديت عوراتها لكم وما % % أنتم محارمها ولا أصهارها % % 5(@)(@@) % ومن العجائب أنها نكحت ولا % صدقاتها حملت ولا أمهارها % % 6(@)(@@) % ف منن عليها بالإياب فما نبت % عن مثلها أوطانها وديارها % % 7(@)(@@) % و عطف لغربتها وطول مقامها % % بذراك فهي رقيقة أبشارها % % PageV01P490 البحر : طويل 1(@)(@@) % أيثبت مدحي في دوارين مدحكم % ويخلو دساتير الجوائز من ذكري % % 2(@)(@@) % وأملأ بالآمال صدري فيكم % فأرجع عن أبوابكم بيد صفر % PageV01P491 البحر : طويل 1(@)(@@) % لئن سئم العذال طول شكايتي % % ومل حديثي زائري ومجالسي % % 2(@)(@@) % وعاد طبيبي من سقامي آيسا % فما أنا من روح الحياة بآيس % PageV01P492 البحر : رجز تام 1(@)(@@) % ما لك يا خدن السماح والباس % وأنت من سراة آل عباس % 2(@)(@@) % رأس العلى وأنت قمة الراس % أسلمتني في حاجتي إلى الياس % 3(@)(@@) % رددتني رد الجفاة الأجباس % مستوحشا من بعد طول الإيناس % 4(@)(@@) % والناس يقضون حوائج الناس % لا تبن لي عذرا ضعيف الآساس % 5(@)(@@) % فلست ذا عدم بها وإفلاس % وإنما ردك رد الهراس % PageV01P493 البحر : رجز تام 1(@)(@@) % بالقصر من بغداذ لا بطياس % أهيف مثل الغصن المياس % 2(@)(@@) % كالشمس مطبوع على الشماس % يخجله ما بي من الوسواس % 3(@)(@@) % ليس لجرحي في هواه آس % عداه بلبالي وما أقاسي % % 4(@)(@@) % يسكرني بلحظه والكاس % سقاك من معالم أدراس % 5(@)(@@) % وربع لهو باللوى طماس % كل مليث الودق ذي ارتجاس % 6(@)(@@) % ولا عدا يا ظبية الكناس % عهد هوى لست لها بناس % 7(@)(@@) % أيام عود الدهر غير عاس % ما وخطت يد المشيب راسي % % 8(@)(@@) % والدهر لم ينكث قوى أمراسي % % وقهوة من خمر بنت راس % 9(@)(@@) % حمراء تجلو ظلم الأغباس % ربيبة القسيس والشماس % 10(@)(@@) % عانسة تجلى على الشماس % تروي أحاديث أبي نواس % PageV01P494 11(@)(@@) % تدار في باطية وطاس % مع رفقة أكارم أكياس % 12(@)(@@) % في روضة مسكية الأنفاس % كأنها وجل عن قياس % 13(@)(@@) % أخلاق شمس الدين رب الباس % ابن أبي المضاء خير الناس % 14(@)(@@) % محيي الندى وقاتل الإفلاس % مخجل صوب العارض الرجاس % 15(@)(@@) % منزه العرض عن الأدناس 
ms129	 % زاكي الفروع طاهر الأغراس % 16(@)(@@) % سهل الندى صعب على المراس % فعم الحياض فارغ الأكياس % 17(@)(@@) % نشوته للحمد لا للكاس % تخافه الآساد في الأخياس % 18(@)(@@) % إن خفت الأحلام فهو الراسي % % أو مرض الزمان فهو الآسي % % 19(@)(@@) % أشوس من عصابة أشواس % غير رعاديد ولا أنكاس % 20(@)(@@) % ساسوا فكانوا أحسن السواس % وجوههم في الليلة الديماس % PageV01P495 21(@)(@@) % مضيئة كالقمر النبراس % كل هزبر للعدى فراس % 22(@)(@@) % جدل حروب بالقنا دعاس % فداك نكس دنس اللباس % 23(@)(@@) % معود ضراعة المكاس % كفاه لا تدر بالإبساس % 24(@)(@@) % عار وأنت بالثناء كاس % تلين للمعروف وهو قاس % 25(@)(@@) % راجيه لم يظفر بغير الياس % قربتني وزدت في إيناسي % % 26(@)(@@) % وصنتني عن معشر أجباس % ما فيهم سمح ولا مؤاس % 27(@)(@@) % والموت خير من سؤال الناس % بقيت لي وللندى والباس % 28(@)(@@) % ما رست الشوامخ الرواسي % % عالي البناء ثابت الأساس % PageV01P496 البحر : كامل تام 1(@)(@@) % يا من جعلناه لحاجتنا % % أهلا فأسلمنا إلى الياس % 4(@)(@@) % أو لم توفق للقضاء لها % % كنت مرءا من جملة الناس % PageV01P497 البحر : متقارب تام 1(@)(@@) % شويكة قصابكم قد أغار % على غنم لي يحتاشها % % 2(@)(@@) % فلا أتمت قدمي شوكة % وهيبة وجهك منقاشها % % 3(@)(@@) % فغر أن يبيت مغيرا على % % خيار الرعية أوباشها % % 4(@)(@@) % فلو كان ذئب غضا ما عجز % ت أنك من فيه تنتاشها % % PageV01P498 البحر : كامل تام 1(@)(@@) % مولاي فخر الدين أنت إلى الندى % % عجل وغيرك محجم متباطي % % 2(@)(@@) % أنزلت من يرجوك أرحب منزل % وبسطت من يرجوك خير بساط % 3(@)(@@) % وقرعت أعواد العلاء بهمة % نيطت بها الآمال أي مناط % 4(@)(@@) % يا منجز الميعاد في زمن توا % % صى أهله بالمنع والإلطاط % 5(@)(@@) % حاشاك ترضى أن تكون جرايتي % % كجراية البواب والنفاط % 6(@)(@@) % سوداء مثل الليل سعر قفيزها % % ما بين طسوج إلى قيراط % 7(@)(@@) % أخنت عليه الحادثات وأفرطت % فيها الغداة وأيما إفراط % 8(@)(@@) % قد كدرت حسي المضيء وغيرت % طبعي السليم وعفنت أخلاطي % % 9(@)(@@) % فتول تدبيري وقد أنهيت ما % % أشكوه من مرضي إلى بقراط % PageV01P499 البحر : خفيف تام 1(@)(@@) % يا علي يا بن الخلائف والمحت % ل من ذروة المعالي اليفاعا 
ms130	 % % 2(@)(@@) % هاك ف سمع مني دعاء ولي % مخلص في ولائه ما استطاعا % % 3(@)(@@) % أنت إن حاولت مناواتك الأ % أندى كفا وأرحب باعا % % 4(@)(@@) % لم تزل تدفع الحوادث عنا % % أحسن الله في علاك الدفاعا % % 5(@)(@@) % وهناك الزور الجديد ولا زا % % ل يرى أمرك الزمان مطاعا % % 6(@)(@@) % إلفة لم تزل تمد إلى أن % أحكمتها الأيام كفا صناعا % % 7(@)(@@) % ما رأى الناس قبلها في الليالي ال % البيض للشمس بالهلال اجتماعا % % 8(@)(@@) % فابقيا لا رأى لشملكما الحساد % ما امتدت الليالي انصداعا % % PageV01P500 البحر : متقارب تام 1(@)(@@) % كتبت إليك وظني بأن % مسعاي عندك لا يخفق % 2(@)(@@) % وأن عهودي إذا أخلقت % عهود المحبين لا تخلق % 3(@)(@@) % فلما جعلت جوابي السكوت % تبين لي أنني أحمق % PageV01P501 البحر : خفيف تام 1(@)(@@) % يا جمال الدين الذي أظهر العد % ل وأحيا مكارم الأخلاق % 2(@)(@@) % بك قامت سوق المديح ولولا % ك غدت وهي أكسد الأسواق % 3(@)(@@) % غير أني أرى العطايا التي جد % ت بها باذلا لأهل العراق % 7(@)(@@) % غير أن الأرزاق تجري بتقد % % غبياء الجهال والحذاق % PageV01P502 البحر : كامل تام 1(@)(@@) % لك يا أمير المؤمنين يد % في الظالمين وأخذهم لبقه % 2(@)(@@) % ضمنت إعادة كل مغتصب % فلأي معنى تترك الطبقه % 3(@)(@@) % أولست تعلم أنها شريت % و بن الجليب مضايق سرقه % 4(@)(@@) % فانفذ قضاءك في استعادتها % % فلقد تركت قلوبنا علقه % PageV01P503 البحر : سريع 1(@)(@@) % وباخل قدم لي شمعة % وحاله أحرق من حالها % % 2(@)(@@) % فما جرت من عينها دمعة % إلا ومن عينيه أمثالها % % PageV01P504 البحر : خفيف تام 1(@)(@@) % جبة طال عمرها فغدت % لح أن يسمع الحديث عليها % % 2(@)(@@) % كلما قلت فرج الله منها % % أحوجت خسة الزمان إليها % % PageV01P505 
ms131	