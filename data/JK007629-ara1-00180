ms161	 الهوية في المدعو والداعي % % 5(@)(@@) % به سمعت كما به نطقت لذا % % قد قام فينا مقام الحافظ الراعي % % 6(@)(@@) % أنا له تابع ما دام يطلبني % % كما أكون إذا أدعو من أتباعي % % 7(@)(@@) % وليس من شيعي حتى أفوز به % % وإنه حين أدعوه من أشياعي % % 8(@)(@@) % لذا ينزل في الطاف حكمته % من الذراع على التقريب والباع % 9(@)(@@) % فقد تقدر والمقدار ليس له % وهو الصدوق فقد حيرت أسماعي % % 10(@)(@@) % أين العماء ومن حبل الوريد أتى % % في قربه وإذا ما كنت بالساعي % % PageV01P621 11(@)(@@) % يأتي إلي كما قد قال هرولة % والفرق يعلم بين المد والصاع % 12(@)(@@) % إن التنزه والتشبيه ملحمة % % وتلك خيري الذي أدري وأقطاعي % % 13(@)(@@) % ما قلت إلا الذي قال الإله لنا % % في نعته من مقالات وأوضاع % 14(@)(@@) % لما أتيت به سوق الكلام أبى % % وقال ليس بضاعاتي وأمتاعي % % 15(@)(@@) % إلا المحدث والصوفي فاجتمعا % % والمؤمنون وهذا علم اجماعي % % 16(@)(@@) % إن العقول لها حد يصرفها % % وليس يعرف منه علم إبداع % % 17(@)(@@) % إني أذعت لك العلم الغريب وما % % أنا بصاحب إفشاء وإيذاع % 18(@)(@@) % إني وجدت الذي بالسير أطلبه % % سير الحقائق في سبتي وإبضاعي % % PageV01P622 البحر : بسيط تام 1(@)(@@) % لبيك لبيك من داع بإجماع % والكل أنت فأنت السامع الداعي % % 2(@)(@@) % فلم يلبيك مني غير كونكم % أنت اللسان بلا خلف باجماع % 3(@)(@@) % قد صح عنك من الأخبار ما نطقت % به التراجم عند الحافظ الواعي % % 4(@)(@@) % ما إن ذكرتك في نفسي وفي ملإ % % إلا وكان شفاء لي من أوجاعي % % 5(@)(@@) % لم يقص عنك الذي قد صح من خبر % رويته من حديث البشر والباع % 6(@)(@@) % لقد تحققته ذوقا ومعرفة % من غير شك ولا قول بإقناع % % 7(@)(@@) % درت لبون مواشيه على جلدي % % كل مرعى وإن الرعي للراعي % % 8(@)(@@) % ولو طمعت بكوني في دونكم % خابت لدي على التحقيق أطماعي % % 9(@)(@@) % أنت اللسان وأنت الرجل أسعى بها % % ولا أقول بأن الناطق الساعي % % 10(@)(@@) % وأنت لي بصر إذ أبصرت به % وأنت سمعي فخذ فضلا بأسماعي % % PageV01P623 11(@)(@@) % نطقا يحققني بمنا يوفقني % % وليس يلحقني في الفهم اتباعي % % 12(@)(@@) % بشرى 
ms162	 أسر بها إني من أهلكم % ولا يطمنه زجري وإرداعي % % 13(@)(@@) % إني لأشهدكم وأنت تشهد لي % % بذاك في الجبل الراسي وفي القاع % 14(@)(@@) % أنت العليم الذي قسمت أقفزة % حب العقول فمن مد ومن صاع % 15(@)(@@) % أمري ظفرت بها في وقت قسمتها % % وما جعلت لها حظا من إقطاعي % % 16(@)(@@) % أقطاعنا هي أسماء الإله بها % % عين النجاة لأبصاري وأسماعي % % 17(@)(@@) % ولا خطوت إلى ما ليس لي قدما % % في حال وتر ولا في حال إشفاع % 18(@)(@@) % لذاك ما وردت في حقنا كتب % منه تؤدي إلى ردع واقماع % 19(@)(@@) % أنصفته في الذي قد جاء يطلبنا % % بما تقرر من سبق بإسراع % PageV01P624 البحر : سريع 1(@)(@@) % أرسلت ما أرسلت من أدمعي % % تذكرة مني له إن يعي % 2(@)(@@) % فلم يعرج والتوى هاربا % % وقال لا تسأل فهذا معي % % 3(@)(@@) % وإنما أطلب لي معرضا % % قد اختفى عني في المخدع % % 4(@)(@@) % إنا دعوناهم عسى يرجعوا % % والخائب المحروم لم يسمع % % 5(@)(@@) % وما به من طرش حاكم % % لكنه استحيى فلم يرجع % % 6(@)(@@) % أتبعه أذكره نعمتي % % وما برحت اليوم من موضعي % % 7(@)(@@) % فقال لي تهزأ بي سيدي % % وأنت تدري أنني مدعي % % 8(@)(@@) % بالحال لا بالقول في حبكم % % لأننى أخشى إذا ادعي % % 9(@)(@@) % يقول لي قل ما الدليل على % % صحة ما أنت به تدعي % % 10(@)(@@) % لا تطلب البرهان من ناطق % % إلا إذا سمعته يدعي % % PageV01P625 11(@)(@@) % وكان من كان وأنت الذي % % تفهم قولي فيه لا تجزع % PageV01P626 البحر : طويل 1(@)(@@) % إذا نظرت عيني فأنت الذي ترى % % وإن سمعت أذني فلست سوى سمعي % % 2(@)(@@) % وإن قوايا كلها ومحلها % % وجودك يا سري كما جاء في الشرع % 3(@)(@@) % ولا حكم من طبع إذا ما تكونه % فإن كنته كان التحكم للطبع % % 4(@)(@@) % إذا كنت عيني حين أبصركم بكم % فقد أمنت عيناي من علة الصدع % 5(@)(@@) % إذا فرقت أسماؤه عين صورتي % % على صورتي فيه أحن إلى الجمع % 6(@)(@@) % فاحمده حمد المحامد كلها % % وأشكره في حالة الضر والنفع % 7(@)(@@) % وارقب أحوالي إذا كان عينها % % واشهده في صورة الوهب والمنع % % 8(@)(@@) % لقد أثرت لما أغارت 
ms163	 جياده % % بميدانه شحبا كثيرا من النفع % 9(@)(@@) % فما قرع باب الله والباب أنتم % كما أنت ذاتي حين أشرع في القرع % 10(@)(@@) % واشهده عند اللوى وانعطافه % % وإن كمال الحق في مشهد الجزع % PageV01P627 11(@)(@@) % وصورته في الدر أكمل صورة % وصورة عين الكون أكمل في الجزع % 12(@)(@@) % أما وجلال النازعات وغرقها % % لقد شهدت عيني الطوالع في النزع % 13(@)(@@) % إذا لم يكن فرع لأصل وجودنا % % وهل ثمر تجنيه إلا من الفرع % 14(@)(@@) % وصقع وجود الحق في دار غربتي % % فلا صقع أعلى في المنازل من صقعي % % 15(@)(@@) % ألا إنه يخفي مع الوتر عينه % ويظهرها للعين في حضرة الشفع % 16(@)(@@) % ألا كل ما قد خامر العقل خمرة % وإن كان في مزر وإن كان في تبع % 17(@)(@@) % لقد رفعت للعين أعلام هديه % وضمن كيد الحق في ذلك الرفع % % 18(@)(@@) % ولولا دفاع الله هدت صوامع % لرهبان دير فالسلامة في الدفع % 19(@)(@@) % لقد سحت في شرق البلاد وغربها % % وما خفيت نعلي ولا انقطعت شسعي % % 20(@)(@@) % وفي عرفات ما عرفت حقيقتي % % ولا عرفت حتى أتيت إلى جمع % PageV01P628 21(@)(@@) % ولما شهدناها وجئت إلى منى % بذلت له بالنحر ما كان في وسعي % % 22(@)(@@) % حصبت عدوي جمرة بعد جمرة % ببضع من الأحجار بورك من بضع % 23(@)(@@) % ولما أتيت البيت طفت زيارة % % حنينا بها من فوق أرقعة سبع % % 24(@)(@@) % عناية ربي أدركت كل كائن % من الناس في ختم القلوب وفي الطبع % 25(@)(@@) % ومن أجل ذا لم يدخل الكبر قلبهم % % على موجد الصنع الذي جل من صنع % % 26(@)(@@) % ولولا وجود السمع في الناس ما اهتدوا % % وليس سوى علم الشريعة والوضع % % 27(@)(@@) % فكم بين أهل النقل والعقل يا فتى % وهل تبلغ الألباب منزله السمع % PageV01P629 البحر : مجزوء الرجز 1(@)(@@) % العلم أولى ما ابتع % والعبد عبد ما اتبع % 2(@)(@@) % هذا هو الحق بدا % % فخذ بقولي أو فدع % 3(@)(@@) % من وسع الحق فما % % يعجز عن شي يسع % % 4(@)(@@) % ما أشرف العبد الذي % % لكل شي قد وضع % 5(@)(@@) % من نازل وصاعد % وخافض ومرتفع % % 6(@)(@@) % ميزانه في يده % كالحق يعلي ويضع 
ms164	 % % 7(@)(@@) % إن قال قولا هائلا % فما يقول من جزع % % 8(@)(@@) % لأنه يعلم أن % القول بالحق صدع % % 9(@)(@@) % عباده فاعتبروا % % في هول يوم المطلع % % 10(@)(@@) % إذا أتى العبد به % % إلى الجحيم فاطلع % PageV01P630 11(@)(@@) % لكي يرى صاحبه % عنه الأمان قد نزع % % 12(@)(@@) % فقال : تالله لقد % % كدت لتردين ومع % 13(@)(@@) % هذا فإني شافع % فيك إن الله شفع % 14(@)(@@) % فالحمد لله الذي % % خلصني مما وقع % % 15(@)(@@) % فيه الجهول إذ أتا % % ه رادع فما ارتدع % % 16(@)(@@) % في سورة الصف أتت % آيته لو اطلع % 17(@)(@@) % على المعاني نلتها % % نيل الذي بها انتفع % 19(@)(@@) % في منزل الدنيا الذي % % لكل خير قد جمع % % 20(@)(@@) % والشكر لله الذي % % من علي ودفع % 21(@)(@@) % عني ما احذره % % يوم النشور والفزع % % PageV01P631 22(@)(@@) % وجاء في توقيعه % هذا جزاء من تبع % 23(@)(@@) % بعقده وفعله % % رسولنا فيما شرع % 24(@)(@@) % وكل ما جاء به % % إليه من شرع نزع % % 25(@)(@@) % وما توانى ساعة % وما افترى وما ابتدع % % 26(@)(@@) % فوجهه النور إذا % % ما النور في الحشر سطع % 27(@)(@@) % فالحمد لله الذي % % يحمد أعطى أو منع % 28(@)(@@) % بذا أتانا وحيه % % فألسن الخلق تبع % % 29(@)(@@) % بأنه قال على % % لسانه ما قد شرع % 30(@)(@@) % له بما يقوله % على مصل متبع % % 31(@)(@@) % إمام قوم مقتد % ليس بشخص مبتدع % PageV01P632 32(@)(@@) % وأي مجد مثل ذا % % وأي فخر قد سمع % 33(@)(@@) % أصبح عبدا تائبا % عني إذا قال سمع % 34(@)(@@) % الله والله لمن % حمده كذا وقع % % PageV01P633 البحر : بسيط تام 1(@)(@@) % ليس التعجب من شخص وعى فدعا % % إن التعجب من شخص وعى فسمع % % 2(@)(@@) % إذا أجاب علمنا أنه رجل % لما دعا ضامنا لمن دعاه طمع % 3(@)(@@) % فقل له ما الذي سمعت منه يقل % ما قلته إنه برق لديه لمع % PageV01P634 البحر : بسيط تام 1(@)(@@) % إني جعلت رسول الله خير شفيع % فكن له يا ولي اليوم خير سميع % 2(@)(@@) % وما التمست سوى مرسوم صاحبه % % السيد الطائع المحفوظ خير مطيع % % 3(@)(@@) % وقد رأيت الذي خطت أنامله % من كل معنى جليل قدره وبديع % 4(@)(@@) % والأمر لله فيه ثم صاحبه % % إن الجناب 
ms165	 الذي ذكرته لرفيع % PageV01P635 البحر : طويل 1(@)(@@) % غني عن الأكوان بالذات والذي % % له من سنى الأسماء ما ليس يبلغ % % 2(@)(@@) % غوى من له حكم الخلافة في الورى % % لذا جاء في القرآن حقا سنفرغ % % 3(@)(@@) % غريق ببحر والنجاة بعيدة % ولولا وجودي لم ير الحق يدمغ % 4(@)(@@) % غني وإني أكثر الذكر جاهدا % فقال أنا عن كل ذاك مفرغ % 5(@)(@@) % غنيت به إذ كان كوني وجوده % ونشئي به في قالب الطبع يفرغ % 6(@)(@@) % غريب تراه العين في أرض غربة % من الأهل والمرجو منه سيبلغ % % 7(@)(@@) % غوايتنا ما كانت إلا لحكمة % هي الرشد عن أمر أتاه المبلغ % % 8(@)(@@) % غصصت يرتقي بل شرقت بمائه % ويا عجبا وهو الحياة فبلغوا % % 9(@)(@@) % غرار حسام الموت والحكم فيصل % لسان فصيح النطق ما هو الثغ % 10(@)(@@) % غمام جوى إتيان حق بمحشر % وأرواح أملاك فقولوا وسوغوا % % PageV01P636 البحر : طويل 1(@)(@@) % أصرفه في كل وقت تصرفا أصرفه في كل وقت تصرفا % % لأني سمعت الله قال سنفرغ % 2(@)(@@) % وما ثم إلا قائم متحير % بأعراضه فانظر لعلك تبلغ % 3(@)(@@) % إلى حده الأقصى فيأتي دليلكم % إلى شبهة جاءته بالقذف تدمغ % 4(@)(@@) % فقل لإمام الوقت أنت مقلد % وقل للرعايا إنني سأبلغ % 5(@)(@@) % إليه الذي أنتم عليه وإنه % % عليم بكم لكنه قال بلغوا % % 6(@)(@@) % فيا من هو الملآن بالكون كله % ويا من هو الخالي الذي يتفرغ % 7(@)(@@) % لقد حار قولي فيه إذ حار قوله % إلى خلقه إني إليكم سنفرغ % % 8(@)(@@) % فمن من إلى من أو إلى أي حالة % يكون تجليه إذا قال فرغوا % % 9(@)(@@) % ألا إنني منه لأزراق خلقه % وآجالهم والخلق والخلق أفرغ % % PageV01P637 البحر : كامل تام 1(@)(@@) % صفة الإله لكل شخص مبتغى % في كل موجود تواضع أو طغا % % 2(@)(@@) % والمبتغى المعتوب في أعراضه % % عن نفسه وقبوله لمن ابتغى % % 3(@)(@@) % منه القياد لربه طمعا به % % من أجل أتباع له لما بغى % % 4(@)(@@) % فيعود إكسيرا يرد حديدهم % % للفضة البيضا إذا سقب رغا % % PageV01P638 البحر : سريع 1(@)(@@) % من كان يبغيني وأبغيه % ما زلت للإحسان ألغيه % 2(@)(@@) % حتى بدا للذوق ما قد بدا 
ms166	 % % منه إلى قلبي فألغيه % % 3(@)(@@) % خوفا على قلبي أن الردى % % يلحقه إذ كان يطغيه % % PageV01P639 البحر : كامل تام 1(@)(@@) % غار الإله لبيته وحريمه % % فلذاك ما حصب الذي يبغيه % 2(@)(@@) % بالسوء ثم تراه من إحسانه % % بعباده يلغي الذي يلغيه % % 3(@)(@@) % إن اللئيم الطبع إن أكرمته % لم يلتفت فبجوره يطغيه % PageV01P640 البحر : سريع 1(@)(@@) % من علم السر الذي في القضا % % قد علم الأمر الذي ينبغي % % 2(@)(@@) % فأمره يجري على حكمه % % في كل ما ينوي وما يبتغي % % 3(@)(@@) % يستعجل الأمر الذي لم يصب % أوانه حبرا ولم يبلغ % % 4(@)(@@) % يقذف بالحق على باطل % يدمغه وقتا فلم يدمغ % 5(@)(@@) % قد يفرغ الرحمن منا لنا % % وشأننا الدائم لم يفرغ % 6(@)(@@) % من مبلغي لما رأى رشدنا % % في نيله بالله من مبلغي % % PageV01P641 البحر : مخلع البسيط 1(@)(@@) % يا أيها المؤمنون أوفوا % % فإنكم في الذراع وقف % 2(@)(@@) % زينتم إذ كتبتوه % لذاك أنتم عليه وقف % % 3(@)(@@) % إن كان في قلبكم سواكم % فهو لما يحتويه ظرف % % 4(@)(@@) % والحق بي قد أشار نحوي % % فقلت ماذا فقال لطف % 5(@)(@@) % منى بمن كان لي جليسا % فيه معان وفيه ظرف % 6(@)(@@) % ما كنت أجني علي إلا % % حتى ترى العين كيف تغفو % % 7(@)(@@) % فإنه سيد كريم % لذاك نفسي إليه تهفو % % PageV01P642 البحر : سريع 1(@)(@@) % إن الغنى لله منا كما % % منه أنا الفقر الذي يعرف % 2(@)(@@) % إذ قد تسمى الله في خلقه % بما سمعتم وهو المنصف % 3(@)(@@) % فكل من يسأل عن حاله % % فإنه هو إن تكن تنصف % % PageV01P643 البحر : طويل 1(@)(@@) % إذا اختصم الجمعان قيل لهم كفوا % % فمن شاء فليأخذ ومن شاء فليعف % 2(@)(@@) % وكل لبيب القلب في الأمر حازم % إذا جاءه خير إليه به يهفو % % 3(@)(@@) % فيأخذه علما من الله زينة % % ولو رواح عنه سار في أثره يقفو % % 4(@)(@@) % فيظهر فينا ذا صنوف كثيرة % وفي عينه عند العليم به صنف % 5(@)(@@) % وحيد بمعناه كثير بصورة % وذلك في المعقول والعادة العرف % 6(@)(@@) % ففي أذني قراط وفي الساق دملج % وفي مفرقي تاج وفي ساعدي وقف % 7(@)(@@) % إذا حصل الإجماع ليس لصورة % على صورة 
ms167	 أخرى افتخار ولا شف % 8(@)(@@) % تنوع عندي زينة الله أنها % % علي بإنعام الكريم بها وقف % 9(@)(@@) % تنوعت الأشكال والماء واحد % نزيه عن الأوصاف بل خالص صرف % % 10(@)(@@) % تقنع بما قد جاء منه ولا تزد % % مخافة أن يأتيك من بعده خلف % % PageV01P644 11(@)(@@) % هو الحق فاعلمه يقينا محققا % فليس لما قد قلت في ذلكم خلف % PageV01P645 البحر : بسيط تام 1(@)(@@) % الله أعظم أن يدرى فيعتقدا % % مقيدا وهو بالإطلاق معروف % 2(@)(@@) % وهو الذي تدرك الأبصار في صور % مشهودة فهو للأبصار مكشوف % 3(@)(@@) % فهو المقيد والمحدود من صور % وهو الذي هو بالتنزيه موصوف % 4(@)(@@) % لذاك نعلمه لذاك نجهله % فالعجز في علمه عليه موقوف % % 5(@)(@@) % إن قلت ذا قال حكم العقل ليس كذا % % فلا تقل ليس إن الأمر مصروف % 6(@)(@@) % وقل بليس فإن الله قال بها % % في آية وهو قول فيه تعريف % 7(@)(@@) % وقل بليس ولكن في أماكنها % % على الذي قاله ما فيه تحريف % % 8(@)(@@) % في عين تنزيهه عين مسهبة % والكل حق فإن الأمر تصريف % 9(@)(@@) % ما الحق خلق فيدريه خليقته % ولا الخلائق حق فيه تكييف % % 10(@)(@@) % إني وزنت لكم أعلام خالقكم % % وزنا وما فيه خسران وتطفيف % PageV01P646 11(@)(@@) % إني نظمته لكم ما قال خالقكم % والنظم تدريه موزون ومرصوف % PageV01P647 البحر : طويل 1(@)(@@) % إذا كنت بالأمر الذي أنت عالم % به جاهلا فاعلم بأنك عارف % 2(@)(@@) % إذا أنت أعطيت العبارة عنهم % بما هم عليه فاعلم أنك واصف % 3(@)(@@) % فإن الذي قد ذقته ليس ينحكي % % ولا يصرف الإنسان عن ذاك صارف % 4(@)(@@) % وقل رب زدني من علوم تقيدت % علوم مذاق أنهن عوارف % 5(@)(@@) % إذا نلتها كنت العليم بحقها % % وإن كانت الأخرى فتلك المعارف % 6(@)(@@) % فمعرفتي بالعين ما ثم غيرها % % وعلمي بحال واحد وهو عاطف % % 7(@)(@@) % عليها وذاك الأمر ما فيه مدخل % % ألا كل ذي ذوق هنالك واقف % % 8(@)(@@) % وما جهل الأقوام إلا عبارتي % % وما أنا باللفظ المركب كاشف % 9(@)(@@) % وما ثم تصريح لذاك عيوننا % % إذا ما عجزنا بالدموع ذوارف % % 10(@)(@@) % فإن نحن عبرنا فإن كبيرنا % % لحنظلة التشبيه باللفظ ناقف % % PageV01P648 11 
ms168	(@)(@@) % تمعر منه الوجه والعجز قائم % به ويراه اليثربي المكاشف % 12(@)(@@) % ولو كان غير اليثربي لما درى % % وهل يجهل العلام إلا المخالف % 13(@)(@@) % نفى عنهم القرآن فيه مقامهم % % وإني بالله العظيم لحالف % % 14(@)(@@) % لقد سمعت أذناي ما لا أبثه % % وقد جافى الأمر الذي لا يخالف % % 15(@)(@@) % فقلت له سمعا إلهي وطاعة % % وقد كان لي فيما ذكرت مواقف % % 16(@)(@@) % وما كنت ذا فكر ولا قائلا به % % وقد بينت لي في الطريق المصارف % 17(@)(@@) % وما صرفتنا عن تحقق ذاتنا % % بما في طريق السالكين الصوارف % 18(@)(@@) % وما ثم إلا سالك ومسلك % % بذا قالت الأسلاف منا السوالف % 19(@)(@@) % مشينا على آثارهم عن بصيرة % % وتقليد إيمان فنحن الخوالف % 20(@)(@@) % وما حيرتنا في الطريق مجاهل % % وما حكمت بالتيه فينا التنائف % % PageV01P649 21(@)(@@) % فإن كنت ذا حس فنحن الكثائف % وإن كنت ذا علم فنحن اللطائف % % 22(@)(@@) % لقد جهلت ما قلته وأبنته % % من أهل الوجود الحق منا طوائف % % 23(@)(@@) % لقد قالت الأعراب : الحرب خدعة % وإني خبير بالحروب مثاقف % 24(@)(@@) % ألا فاعذروا من كان لي ذا جناية % % ويقديه مني تالد ثم طارف % % 25(@)(@@) % ويشتد خوفي من شهودي لموجدي % % ولما رمت بي نحو ذاك المخاوف % % 26(@)(@@) % علمت بأني ذو إنكسار وذلة % % وأني مما يأمن القلب خائف % 27(@)(@@) % وأصبحت لا أرجو أمانا وإنني % % على باب كوني للشهادة واقفث % % 28(@)(@@) % شهيد لنفسي لا عليها لأنني % % عليم تهادى للعمى متجانف % % 29(@)(@@) % وإني أناديني إذا ما دعوتني % % وقد هتفت بي في الخطوب الهواتف % PageV01P650 البحر : طويل 1(@)(@@) % فررت إلى الرحمن أبغي التصرفا % % بسطوة جبار ورحمة مصطفى % % PageV01P651 البحر : رمل تام 1(@)(@@) % سألتنا شرف نلبسها % % خرقة القوم على شرط الوفا % % 2(@)(@@) % حين تابت عندنا من كل ما % % كان منها قبل هذا سلفا % % 3(@)(@@) % فأجبناها إلى ما سألت % % باعتقاد ووداد وصفا % % 4(@)(@@) % وأمرناها بأن تلبسها % % كل من كان بخير عرفا % % PageV01P652 البحر : رمل تام 1(@)(@@) % هي لما لبستها سبحت % حسبي الله تعالى وكفى % % 2(@)(@@) % وأتت تلثم نعلي خدمة % ولقد كان لنا فيه شفا % % 3(@)(@@) % ولقد عانقت منها غصنا % يخجل الغصن إذا 
ms169	 ما انعطفا % % 4(@)(@@) % وارتشفنا ريقة مسكية % تخجل الشهد إذا ما ارتشفا % % 5(@)(@@) % ما أتينا محرما نحذره % بل أتينا فيه ما الله عفا % % 6(@)(@@) % فانظروا المعنى الذي أرمزه % في كلامي تجدوه في الوفا % % PageV01P653 البحر : طويل 1(@)(@@) % إذا كانت الأعراف تعطى عوارفا % % فإن السليم الشم لينشق العرفا % % 2(@)(@@) % ولا يقبل الرحمن منه إذا أتى % % قبول الذي قد شم عدلا ولا صرفا % % 3(@)(@@) % وإن جاءه الإقبال من كل جانب % % ولم يقبل الرحمن لم يكن إلا حفى % % 4(@)(@@) % وإياك واستدراجه في عباده % فإن لمكر الله في خلقه عرفا % % 5(@)(@@) % يراه الذي ما زال فيهم مقدما % فيعز له حكما ليشربه صرفا % % PageV01P654 البحر : طويل 1(@)(@@) % فررت إلى ربي كموسى ولم يكن % % فراري عن خوف عناية مصطفى % % 2(@)(@@) % فنوديت من تبغي فقلت : وصال من % % دعاني إليه قبل والرسم قد عفا % % 3(@)(@@) % فما هو مطموس وما هو واضح % وطالبه بالنفس منه على شفا % % 4(@)(@@) % فلو كان معلوما لكان مميزا % ولو كان مجهولا لما كان منصفا % % 5(@)(@@) % فيا ليت شعري هل أراه كما أرى % % وجودي ومن يرجو غنيا قد أنصفا % % 6(@)(@@) % فقال لسان الحال يخبر أنني % % غلطت ولا والله جئت معنفا % % 8(@)(@@) % فبادرني في الحال من غير مقصدي % % أيا حادبي عندي ببابي توقفا % % 9(@)(@@) % فإني بحكم العين لست مخيرا % ولو كنت مختارا لما سمعوا قفا % % 10(@)(@@) % فنيت به عني فأدرك ناظري % % وجودي وغيري لو يكون تأسفا % % 11(@)(@@) % فما ثم إلا ما رأيت ومن يرم % سوى ما رأينا فهو شخص تعسفا % % PageV01P655 12(@)(@@) % فرام أمورا عقله حاكم بها % % وما أثبت البرهان فالكشف قد نفى % % PageV01P656 البحر : طويل 1(@)(@@) % ألا انعم صباحا أيها الوارد الذي % % أتانا فحيانا من الحضرة الزلفى % % 2(@)(@@) % فقلت له أهلا وسهلا ومرحبا % % بوارد بشرى جاء من مورد أصفى % % 3(@)(@@) % فقال : سلام عندنا وتحية % % عليكم وتسليم من الغادة الهيفا % % 4(@)(@@) % من اللاء لم يحجبن إلا بقية % فقلت له القنوى فقال هي الذلفا % % 5(@)(@@) % لقد طلعت في العين بدرا مكملا % % وفي جيدنا عقدا وفي ساعدي وقفا % % 6(@)(@@) % فقلت لها : من أنت 
ms170	 ؟ قالت : جهلتني % % أنا نفسك الغرا تجلت لكم لطفا % % 7(@)(@@) % فأعرضت عنها كي أفوز بقربها % % وطأطأت رأسي ما رفعت لها طرفا % % 8(@)(@@) % وقد شغفت حبا بذاتي وما درت % وقد ملئت تيها وقد حشيت ظرفا % % 9(@)(@@) % وثارت جياد الريح جودا وهمة % وما سبقت ريحا تهب ولا طرفا % % 10(@)(@@) % وجاء الإله الحق للفصل والقضا % % على الكشف والأملاك صفا له سفا % % PageV01P657 11(@)(@@) % عن الحكم عن أعياننا وهو علمه % وما غادروا مما علمت به حرفا % % 12(@)(@@) % لذلك كانت حجة الله تعتلي % % على الخصم شرعا أو مشاهدة كشفا % % 13(@)(@@) % وهب نسيم القرب من جانب الحمى % % فأهدى لنا من نشر عنبره عرفا % % 14(@)(@@) % حبست على من كان مني كأنه % % فؤادي وأعضائي لشغلي به وقفا % % 15(@)(@@) % وما برحت أرساله في وجودنا % % على حضرتي بما أرسلت عرفا % % 16(@)(@@) % وأرواحه تزجي سحائب علمه % إلى خلدي قصدا فيعصفها عصفا % % 17(@)(@@) % يشف لها برق بإنسان ناظري % % وميض سناه كاد يخطفه خطفا % % 18(@)(@@) % ويعقبه صوت الرعود مسبحا % ليزجرها رحمي فيقصفها قصفا % % 19(@)(@@) % يخرج ودق الغيث من خلل بها % % فتصبح أرض الله كالروضة الأنفا % % 20(@)(@@) % شممت لها ريحا بأعلام راية % كريا حمياها إذا شربت صرفا % % PageV01P658 21(@)(@@) % ولما تدانت للقطاف غصونها % % تناولت منها كالنبي لهم قطفا % % 22(@)(@@) % ولما تذكرت الرسول وفعله % % على مثل هذا لم أزل أطلب الحلفا % % 23(@)(@@) % وراثة من أحيى به الله قلبه % % ولو كنت كنت الوارث الخلف الخلفا % % 24(@)(@@) % ألا إنني أرجو زوال غوايتي % % وأرجو من الله الهداية والعطفا % % 25(@)(@@) % إذا ما بدا لي الوجه في عين حيرتي % % قررت بها عينا وكنت بها الأحفى % % 26(@)(@@) % تبين علامات لها عند ذي حجى % وأعلامها بين المقامات لا تخفى % % PageV01P659 البحر : مجزوء الرجز 1(@)(@@) % ألبست ست العابدي % % ن خرقة التصوف % 2(@)(@@) % ألبستها من رعبتي % % فيها ومن تخوفي % % 3(@)(@@) % على انكسار راعني % % منها ومن تشوف % 4(@)(@@) % ألبستها بمكة % في الحج بالمعرف % % 5(@)(@@) % ألبستها ثوب تقى % توفني تشرفي % % 6(@)(@@) % لأنها معشوقة % لطيفة التظرف % % 7(@)(@@) % محجوبة مطلوبة % لطالب التطرف % PageV01P660 البحر : بسيط تام 1(@)(@@) % لما تألفت الأشياء بالألف % % أعطاك صورته 
ms171	 في كل مؤتلف % 2(@)(@@) % فأحرف الرقم والألفاظ دائرة % ما بين مؤتلف منها ومختلف % % 3(@)(@@) % وإن تمادت إلى ما لا انقضاء له % فإن مرجع عقباها على الألف % % 4(@)(@@) % لولا تألفها وسر حكمته % لم تدر أمرا ولا نهيا فقف وخف % 5(@)(@@) % وفي أوامره إن كنت ذا بصر % % سر عجيب ولكن غير منكشف % 6(@)(@@) % لا يأمر الله بالفحشاء وقال لمن % عصاه وعدا له فاركض ولا تقف % 7(@)(@@) % وليس يبدو الذي قلناه من عجب % % في أمر أمرهم إلا لمعترف % 8(@)(@@) % يا رحمة وسعت كل الوجود فما % % يشذ عنها وجود فاعتبر وقف % % 9(@)(@@) % ولا يرى الله في شيء يعن له % مما له عن إلا صاحب الغرف % 10(@)(@@) % أو من يجود إذا أثرى بنعمته % أو من يكون من الرحمن في كنف % PageV01P661 11(@)(@@) % لذا أقام له عذرا بما صدرت % % أوامر منه في القربى وفي الزلف % % PageV01P662 البحر : بسيط تام 1(@)(@@) % إن الجبال وإن أصبحن جامدة % فإنها عند أهل الكشف كالصوف % 2(@)(@@) % أو كالبيته أجزاء مفرقة % % في كل وجه عن التحقيق مصروف % 3(@)(@@) % كما أتت في كتاب الله صورته % % وزنا صحيحا لنا من غير تطفيف % 4(@)(@@) % ينزه الأمر عن وضع وعن صفة % وعن مثال وعن كم وتكييف % % 5(@)(@@) % أما الذي ثقلت منا موازنه % % بالخير في منزل بالبر معروف % 6(@)(@@) % وثم هذا الذي خفت موازنه % % بالشر في منزل بالدخ مسقوف % 7(@)(@@) % وثم وزن صحيح أنت صنجته % % جاءت إلي به رسل بتعريف % % PageV01P663 البحر : بسيط تام 1(@)(@@) % إني بنيت على علمي بأسلافي % % ومن صحبت من أشياخي وآلافي % % 2(@)(@@) % فما أصلي بهم إلا قرأت لهم % % من القرآن لما فيه لإيلاف % 3(@)(@@) % فالا فإن الذي في العبد من صفة % عين الحبيب فهذا عين إنصاف % 4(@)(@@) % نفسي تنازعني إذا أطهرها % % والخف في قدمي من نزع أخفافي % % 5(@)(@@) % وكيف أنزعها وقد لبستهما % % على طهارة أقدامي بأوصافي % % 6(@)(@@) % إن اتصافي بنعت الحق بعدني % % منه وقربني بنعت أسلافي % % 7(@)(@@) % عجز وفقر إلى ربي ومسكنة % % إلى سؤال بإلحاح وإلحاف % 8(@)(@@) % إلى رفيق لطيف مشفق حذر % وما أنا بالعتل الجعمص 
ms172	 الجافي % % 9(@)(@@) % إذا ذكرت الذي عليه معتمدي % % سبحانه كنت فيه المثبت النافي % % 10(@)(@@) % فالنفي تنزيهه عن كل حادثة % من الصفات التي فيهن إتلافي % % PageV01P664 11(@)(@@) % ولست أثبت للرحمن من صفة % إلا التي قالها في قوله الكافي % % 12(@)(@@) % لله ميزان عدل في خليقته % % فإن وزنت فإني الراجح الوافي % % 13(@)(@@) % أنا مريض ودائي ليس يعرفه % % إلا العليم بحالي الراحم الشافي % % 14(@)(@@) % إن التستر بالعادات من خلقي % % فما أنا علم كبشر الحافي % % 15(@)(@@) % إن التخلق بالأسماء يظهر ما % % يكون حليته بالمشهد الخافي % % 16(@)(@@) % العبد يرسب يبغي أصل نشأته % % والغير متصف بالمدعي الطافي % % 17(@)(@@) % ثوبي قصير كما جاء الخطاب به % وثوب ديني ثوب ذيله ضافي % % 18(@)(@@) % مياه أهل الدعاوى غير رائقة % % وماء مثلي ذاك الرائق الصافي % % 19(@)(@@) % ديار أهل القوى في الخلق عامرة % % ودار أهل المعالي رسمها عافي % % 20(@)(@@) % يجود عند سؤالي كل مكرمة % ربي علي بإنعام وإسعاف % PageV01P665 21(@)(@@) % لقد علمت بأن الله ذو كرم % % وأن فينا له خفي ألطاف % 22(@)(@@) % أثنيت بالجود عن فقر وعن ضرر % % على الإله فجازاتي بإسعافي % % 23(@)(@@) % كماء ورد إذا الداري يمرجه % % بما يطيبه من ماء خلاف % 24(@)(@@) % فبالأكف جياد الخيل إن سبقت % نمس منها بأجياد وأعراف % 25(@)(@@) % لا تفرحن باستواء الكفتين إذا % % أعمالكم وزنت من أجل أعراف % 26(@)(@@) % وأكثر الذكر للرحمن في ملأ % % من الملائك سادات وأشراف % % 27(@)(@@) % واحذر قبولك رفدا قد أتيت به % % عن التشوق منكم أو عن إسراف % 28(@)(@@) % إن الغريب مصون في تقلبه % كلؤلؤ صين في أجواف أصداف % % 29(@)(@@) % إن الكريم تولاه بجائزة % تترى عليه وإنعام وإرداف % 30(@)(@@) % لو جاء من أسهم البلوى على حذر % من المصاب لجاءته بآلاف % PageV01P666 31(@)(@@) % إن العبيد أولي الألباب قد نصبوا % % لرمي أسهم بلواه كأهداف % 32(@)(@@) % الله عاصمهم من كل نازلة % بما يجن من ألطاف وأعطاف % 33(@)(@@) % من عند رب حفي بي ومكتنف % وعاصم بالذي يسدي وعطاف % % 34(@)(@@) % من الجميل الذي ما زال يرفده % % بمثله ليعم الخير أكنافي % % PageV01P667 البحر : - 1(@)(@@) % ألبسته خرقة التصوف % وما له نحوها تشوف % 2(@)(@@) % لعلمه بالذي يراه 
ms173	 % من أدب الوقت والتظرف % 3(@)(@@) % ألبسته بعدما تعالى % % عن رتبة الأخذ والتعطف % 4(@)(@@) % وحصل الكون في حماه % % وأحكم العلم والتصرف % 5(@)(@@) % فمثل هذا ألبست ثوبي % % إذ كان ثوبا على التعرف % % PageV01P668 البحر : متقارب تام 1(@)(@@) % أتاك الشتاء عقيب الخريف % وجاء الربيع يليه المصيف % 2(@)(@@) % ودار الزمان بأبنائه % % فمن دوره كان دور الرغيف % % 3(@)(@@) % سرى في الجسوم بأحكامه % تغذى اللطيف به والكثيف % % 4(@)(@@) % عجبت لهم جهلوا قدرهم % ويسعى القوي له والضعيف % % 5(@)(@@) % فأصبح كالماء في قدره % % لديهم وفي الماء سر لطيف % PageV01P669 البحر : رمل تام 1(@)(@@) % إنما الله إله واحد % ماله حكمان فانهض لا تقف % 2(@)(@@) % وله حكمان فاعمل بهما % % عن شهود لهما لا تنصرف % % 3(@)(@@) % ليس للأقوام رأي في الذي % % شربوا منه قليلا فاغترف % 4(@)(@@) % إنما الأمر مذاق كله % % فإذا ما ذقته لا تنحرف % % PageV01P670 البحر : - 1(@)(@@) % أمر الإله من % % ما أمره في العالمين محقق % % 2(@)(@@) % إلا بواسطة الرسول فإنه % % أمر مطاع سره يتحقق % % 3(@)(@@) % إن خالفت أمر الإله إرادة % منه تكاد النفس منه تزهق % % 4(@)(@@) % ولذاك شيبت النبي مقالة % هي فاستقم فيما أمرت توفق % % 5(@)(@@) % فإذا أراد نقيض ما أمرت به % % نفس المكلف فالوقوع محقق % PageV01P671 البحر : بسيط تام 1(@)(@@) % إذا بدا علم الأحوال يسبق % إليه والسحب بالأمطار تندفق % 2(@)(@@) % فما ترى علما إلا رأيت سنا % % ولا مضى طبق إلا أتى طبق % 3(@)(@@) % الأمر مشترك في كل معترك % فما انقضت علق إلا بدت علق % 4(@)(@@) % إذا رأيت الذي في الغيب من عجب % رأيت نور وجود الحق ينفتق % 5(@)(@@) % عليك من خلف ستر أنت وافره % % وعنده تبصر الأسرار تستبق % % 6(@)(@@) % إليه وهي مع الإتيان فانية % عنها وعنه وهذا كيف ينفق % % 7(@)(@@) % لذاك قلنا بأن الأمر مشترك % ما بيننا ولهذا عمنا القلق % % 8(@)(@@) % فالكل في قلق لا يعرفون لما % % لأن باب وجود العلم منطبق % % 9(@)(@@) % ضاعت مقاليده لذاتها فلذا % % والله قد رجح التقليد حين شقوا % % 10(@)(@@) % بالفكر في نيل علم لا يكون لهم % % ولو يكون مفاتيحا لما وثقوا % % PageV01P672 11(@)(@@) % فسلم الأمر إن الأمر مرجعه % % إلى 
ms174	 عمى وإليه الكل قد خلقوا % % 12(@)(@@) % حرنا وحاروا فخذ علما منحتكه % وكن ذريبته تحظى بك الفرق % 13(@)(@@) % ولا تخف إنهم في كل آونة % % في شبهة حكمها لنفسها الفرق % % 14(@)(@@) % تردهم لمحل الفكر فهي لهم % تار تحرقهم فالكل محترق % 15(@)(@@) % هم المسمون إن حققت إمعة % كنعت خالقهم فاصدق كما صدقوا % % 16(@)(@@) % وكن بهم نائبا عنهم فلبهم % غض جديد ولبسي دونهم خلق % 17(@)(@@) % ولا تسابق سوى الحرباء إن لها % % حال الوجود وريا مسكها عبق % PageV01P673 البحر : مجزوء الخفيف 1(@)(@@) % حاسبونا فدفقوا % % قيدونا فأوثقوا % % 2(@)(@@) % نظروا في صنيعنا % % ثم منوا فأعتقوا % % PageV01P674 البحر : - 1(@)(@@) % حاسبونا ما دققوا % % قيدونا ما أوثقوا % % 2(@)(@@) % نظروا في ذنوبنا % % ثم منوا فأطلقوا % % 3(@)(@@) % إن ظني وخاطري % % في إلهي محقق % % 4(@)(@@) % إن من مات محسنا % ليس بالنار يحرق % PageV01P675 البحر : وافر تام 1(@)(@@) % عيون الزهر يبدو من خباها % % لناظر مقلتي الزهر الأنيق % % 2(@)(@@) % إذا ما ساعدتها الشمس فيه % % تراه بعد نومته يفيق % 3(@)(@@) % أفاقت لأمر فيه سر % فؤاد الطالبين له مشوق % 4(@)(@@) % يروم المجنون له حصولا % إذا تزجى الزعازع أو تسوق % % 5(@)(@@) % يروم المجنون له حصولا % فذاك النجم ليس له حريق % % 6(@)(@@) % فإن الشمس أقوى منه فعلا % ودمع الزمهرير له طليق % 7(@)(@@) % فيطفئه ويسلم منه ريح % ويحكم أنه فيه غريق % 8(@)(@@) % وذاك الانقضاض لنا شهيد % % على ما قلته بر صدوق % 9(@)(@@) % رأيت الريح تأخذ منه سغلا % حذار منية ولها شهيق % PageV01P676 البحر : بسيط تام 1(@)(@@) % إني أفيق وفي أرضي لها فيق % % تبكي السماء لها لينفق السوق % 2(@)(@@) % وإنني ضابط فيما يصرفني % % وليس فيما أتاني منه تعويق % 3(@)(@@) % الحق يعجب من حالي ومن قلقي % % مع الأحبة والأحوال تلفيق % 4(@)(@@) % لم ينتشر خبر لي أنني رجل % أهوى الأمور ولي بحث وتحقيق % 5(@)(@@) % إن الموافقة الكبرى بدايتها % % عند الرجال عنايات وتوفيق % 6(@)(@@) % ما ينفق الذهب المصنوع عندهم % إلا إذا جاءه سبك وتعليق % % 7(@)(@@) % فإن تسامح فيه بالحمى صنع % فإن ذلك تمويه وتزويق % 8(@)(@@) % وليس يعلم ما قلناه فيه سوى % % مجرب فيه إيمان وتصديق % % 9(@)(@@) % الله يعلم 
ms175	 أني فيه ذو عمه % وإنني مؤمن به وصديق % % 10(@)(@@) % لا يعتريني هوى فيما علمت به % % وليس عندي تزيين وتنميق % PageV01P677 11(@)(@@) % الصدق حليتنا والحق حلتنا % % فمن يخالف حالي فهو زنديق % 12(@)(@@) % والله لو عرفت نفسي بمن كلفت % لم يلهها زجل عنه وتصفيق % 13(@)(@@) % لما علمت بأن الأمر ذو صور % فلو يخاطبني حبر وبطريق % % 14(@)(@@) % لم أنكر إن الأمر فيه كما % % ذكرته فهو خلاق ومخلوق % % 15(@)(@@) % إن النياق تجاري نحو كعبته % وإنها همم يدعونها النوق % PageV01P678 البحر : بسيط تام 1(@)(@@) % يس على الجزم مبني فليس له % % في العقل كون ولا طبع فيسرقه % 2(@)(@@) % فذاته القلب فالتقليب شيمته % لكنه رحوي فيه مشرقه % 3(@)(@@) % فما له من سكون فهو في فرح % % وما له حركات عنه تقلقه % % 4(@)(@@) % له الشؤون وفوق العرش مسكنه % % عند الإله الذي به تحققه % % 5(@)(@@) % وبالذي عنده منه تعلقه % % كما بأسمائه الحسنى تخلقه % % 6(@)(@@) % هو الوجود فما تنفك صورته % % مع الجمال الذي به تعشقه % 7(@)(@@) % فالوجد يسكنه والشوق يقلقه % % وللذي يدعيه الأمر يسبقه % % 8(@)(@@) % خلاف طه فإن الفتح يلزمه % لذاك جاء ليشقى وهو يخلقه % 9(@)(@@) % بالجود أوجده بالكون حدده % وبالتجلي يغذيه ويرزقه % 10(@)(@@) % أعطاه سورته فحاز سورته % به يقيده عنه ويطلقه % PageV01P679 11(@)(@@) % به يحققه منه يخلقه % فيه يعشقه له يشوقه % 12(@)(@@) % إن الوجود له حد ومستند % في الكائنات وأحوالي تصدقه % % 13(@)(@@) % و ن وق معص وسائط ظهرت % تعطي الغنى وهي بالأسماء تغرقهث % % 14(@)(@@) % وإذ بدت سبحات الوجه واتصلت % % بالكون أضواؤها في الحال تحرقه % 15(@)(@@) % من أعجب الأمر أن الستر منسدل % والنور من خلفه وليس يخرقه % % 16(@)(@@) % وكل ستر فمجموع ويشهد لي % % أجزاؤه ثم لا تأتي تمزقه % % PageV01P680 البحر : سريع 1(@)(@@) % جسم بلا روح ضجيع الردى % % غصن ذوى ياليته أورقا % % 2(@)(@@) % روح بلا علم وهي بيته % لرؤية الأغيار إذ أخلقا % % 3(@)(@@) % افتقر الكل إلى جوده % أهل الأباطيل ومن حققا % % 4(@)(@@) % فوجه الأنوار سيارة % % أنارت المغرب والمشرقا % % 5(@)(@@) % فأشرق الجسم بأنوره % وأظهر الأسرار إذ أشرقا % % 6(@)(@@) % فالحمد لله الذي قد وقى % % من شر ما يحذر 
ms176	 أو يتقى % % PageV01P681 البحر : بسيط تام 1(@)(@@) % في شهوة البطن سر ليس يعلمه % % إلا الذي شاهد الرزاق رزاقا % % 2(@)(@@) % لولا الغذاء ولولا سر حكمته % % ما لاح فرع ولا عاينت أعراقا % % 3(@)(@@) % فكل حلالا إذا كان المحلل موج % % ودا بقلبك وهابا وخلاقا % % PageV01P682 البحر : وافر تام 1(@)(@@) % سمعت الخلق ليس لهم وجود % وفي ظني الوجود لهم حقيقه % 2(@)(@@) % فلما أن شهدت الأمر منه % رأيت الخلق ظاهره خليقه % 3(@)(@@) % فظاهرهم وباطنهم سواء % وهذا من معانيه الدقيقه % % 4(@)(@@) % رقائقه من الأعيان مدت % % وفي تلك الرقائق لي رقيقه % 5(@)(@@) % علمت بها بأني غير شيء % % وإن كانت تخالفني السليقه % % 6(@)(@@) % وقد كتبت علي بذا كتابا % وشرح الأمر في تلك الوثيقه % 7(@)(@@) % لقد لله في كوني أمور % % يريك بها المطرق للطريقه % 8(@)(@@) % أمورا أبطن الرحمن فيها % % عجائب مكره الغر الأنيقه % 9(@)(@@) % لها غور بعيد ليس يدرى % % لذا قال اللبيب هي الفليقه % % PageV01P683 البحر : طويل 1(@)(@@) % وجودي وجود العارفين لأنهم % كمثل الذي أشهدته أشهد واحقا % % 2(@)(@@) % فعينهم عيني ولست سوى لهم % % ولو أطلقوا جمعا ولو أطلقوا فرقا % % 3(@)(@@) % وكونهم كون الإله كما أنا % % فقل إن تشا حقا وقل إن تشا خلقا % % 4(@)(@@) % كزيتونة قامت على ساق موجدي % % فما هي في غرب ولا رأت الشرقا % % 5(@)(@@) % تعالت عن الأرواح لا ميل عندها % % ويمطرها السحب الذي يخرج الودقا % % 6(@)(@@) % فمنها بدا إلى ساق حر كما بدت % لعيني منها المطوقة الورقا % % 7(@)(@@) % فعاينت آحادا ولم أر كثرة % وقد قلت فيما قلته الحق والصدقا % % 8(@)(@@) % ونظمت أبياتا من الشعر فيهما % % وما كان نطقي بل هما عينا النطقا % % 9(@)(@@) % سواسية أسنان مشط تراهم % وهم في سفال جاوزوا الدوح والأفقا % % 10(@)(@@) % لهم حركات في سكون قصنعهم % صنيع الذي من أجله أوجدوا الفرقا % % PageV01P684 11(@)(@@) % فيفعل بالشكل المعين وضعه % لذاك تراه يحفظ الرتق والفتقا % % PageV01P685 البحر : سريع 1(@)(@@) % من يعبد الله على أمره % % ذاك الذي يعبده حقا % % 2(@)(@@) % من يعبد الله على شرعه % % ذاك الذي يعبده رقا % % 3(@)(@@) % العبد من يعبده هكذا % % لا يلتفت أجرا ولا خلقا % % 4(@)(@@) % والله 
ms177	 يجزيه على فعله % صدقا لما قد قاله صدقا % % PageV01P686 البحر : سريع 1(@)(@@) % ألقى الهوى في القلب ما ألقى % % فلا تسل عن كنه ما ألقى % % 2(@)(@@) % لقيت منه الجهد في لذة % % لأنني عبد له حقا % % 3(@)(@@) % أضلنا الله على علمنا % % به فما أعذب ما نلقى % % 4(@)(@@) % تعبد القلب هواه فما % % ينفك قلبي للهوى رقا % % 5(@)(@@) % رقيت للحب إلى راحة % ملذوذة غيري بها يشقى % % 6(@)(@@) % لما درى بأنني عبده % قضى بضربي الغرب والشرقا % % 7(@)(@@) % قد دبت فيما حاز من رقة % ومن جمال والهوى عشقا % % 8(@)(@@) % والله لو أن الذي عندنا % % منه بأقوى جبل شقا % % 9(@)(@@) % قد رق لي الشامت مما يرى % % وحسبكم من شامت رقا % % 10(@)(@@) % ما إن رأينا في الهوى عاذلا % إلا ولا بد له يلقى % % PageV01P687 11(@)(@@) % مثل الذي يلقاه ذو لوعة % وهو الذي سمي بالأشقى % % 12(@)(@@) % كما الذي قد اتقى نفسه % وربه سماه بالأتقى % % 13(@)(@@) % فاشربه مرا ولذيذا فما % % بكاس غير الحب ما تسقى % % 14(@)(@@) % ألا ترى موسى وما موله % % أعطاه ما أمل والصعقا % % 15(@)(@@) % فكان موسى صادقا في الذي % % قد جاء يبغيه به صدقا % % 16(@)(@@) % فعندما رد إلى حسه % تاب ووفى العهد واستبقى % % 17(@)(@@) % وكلما كان له بعد ذا % % مما رأى من ربه وفقا % % 18(@)(@@) % أثمر فيه ذاك من ربه % % في ليلة الإسرا بنا رفقا % % 19(@)(@@) % وعاين الروح وقد جاءه % % إذ سد بالأجنحة الأفقا % % 20(@)(@@) % يخبره أن السماء التي % % ترى وأرضا كانتا رتقا % % PageV01P688 21(@)(@@) % فحكم الفصل بها والقضا % % فصيراها حكمة فتقا % % 22(@)(@@) % لا يشرب الخالص عبد هنا % % من كل ما يشرب إذ يسقى % % 23(@)(@@) % من كان أمشاجا من أخلاطه % فكيف لا يشربه ريقا % % 24(@)(@@) % من يبتغي العصمة في حالة % دائمة يستلزم الصدقا % % 25(@)(@@) % والصدق لا شك ما ترى % % أنزله الله لنا رزقا % % 26(@)(@@) % فيأخذ العبد على قدره % % منه كمثل الرزق لا فرقا % % 27(@)(@@) % ما إن رأينا في الهوى حاكما % أبقى ولا أتقى ولا أنقى % % 28(@)(@@) % مثل الذي يعرف مقداره % فإنه قد حازه سبقا % % 29(@)(@@) % العلم يستعمل أصحابه % لا بد منه 
ms178	 فالزم الحقا % % 30(@)(@@) % فإن قوما لم يقولوا بذا % % لجهلهم بالعلم أو فسقا % % PageV01P689 البحر : مجتث 1(@)(@@) % يا لائمي في مقالي % % لا بد فيه تلقى % % 2(@)(@@) % إن كنت ثوبا عليه % % فانني منك أنقى % % 3(@)(@@) % أو كنت عبدا لديه % % فإنني فيه أبقا % % 4(@)(@@) % أو كنته في يديه % % فإنني منه أبقى % % 5(@)(@@) % قد حزت كل مقام % لله ملكا ورقا % % 6(@)(@@) % وإنني في أموري % % إذا نظرت موقى % % 7(@)(@@) % فاحمد إلهك تحمد % خلقا وخلقا وخلقا % % 8(@)(@@) % وكن به من لدنه % % تحور علما ورزقا % % PageV01P690 البحر : رمل تام 1(@)(@@) % نطح الغفر بطينا رابنا % والثريا كللت بالأفق % 2(@)(@@) % دبر القلب بهقعات على % % شولة طالعة بالمشرق % 3(@)(@@) % هنعة الأنعام في أفلاكها % % ذرعت بلدتها في الغسق % 4(@)(@@) % نثرة الذابح للطرف رأت % % بلعا يشكو كمين الحرق % 5(@)(@@) % جبهة السعد إذا ما زبرت % علمها وسط خباء أزرق % 6(@)(@@) % صرف المقدم عواء له % % مؤخر يثقله في الطرق % % 7(@)(@@) % وسماك سبحت أرجله % % في رشاء طالع كالزورق % PageV01P691 البحر : منسرح 1(@)(@@) % ألبست بدرا خريقة الخلق % لما حكى نوره دجى الغسق % 2(@)(@@) % وقلت يا بدر لا كسفت ولا % % عدلت يوما عن أحسن الطرق % 3(@)(@@) % ألبستك الزهد والصيانة إذ % % جردت ثوب المجون والعلق % PageV01P692 البحر : سريع 1(@)(@@) % الفضل للسابق في كل حال % بالفضل حازوا قصب السبق % 2(@)(@@) % وما لوسع الخلق أن يبلغوا % % تسابق المخلوق والحق % 3(@)(@@) % لما تجارت نحو أنفس % % أقعدها في مقعد الصدق % 4(@)(@@) % فعم كل الخلق أفضاله % % ولم يعم الحق للخلق % 5(@)(@@) % أبدى لهم مشهده بارقا % كلمحة العين أو البرق % 6(@)(@@) % وعنده خروا له سجدا % لكن يحوزوا نظرة الصعق % % 7(@)(@@) % من فاز بالأسماء في خلقه % قد فاز بالذات وبالخلق % % PageV01P693 البحر : طويل 1(@)(@@) % إذا صادف الإنسان علما من الحق % % فليس بعلم عنده وهو في الذوق % 2(@)(@@) % لمن قاله بالكشف علم محقق % به يقعد الإنسان في مقعد الصدق % 3(@)(@@) % وما حازه إلا إمام مجرد % نزيه عن الثوب المحير والريق % % 4(@)(@@) % به يشرب الإنسان ماء حياته % به تفتق الأسماع إن كن في رتق % 5(@)(@@) % إذا طلعت شمس من الغرب صيرت % بمطلعها 
ms179	 الغرب المحقق في شرق % 6(@)(@@) % كفاروقنا والمنتقى وخليفته % % وقد عاد حكم الله فيه لذي السبق % % 7(@)(@@) % فلو كان عن كشف لما كان باكيا % ولو كان عن ظن لما قال بالعتق % % PageV01P694 البحر : بسيط تام 1(@)(@@) % الله نور أفلاكا بأنجمها % % ليهتدى في ظلام الليل في الطرق % 2(@)(@@) % ونور الجو بالبيضاء شارقة % ونور العقل بالتوحيد والخلق % 3(@)(@@) % ونور القلب أنوارا منوعة % لأنه وسع المذكور في العلق % 4(@)(@@) % ونور البدر بالبيضاء إن غربت % وجد في سيره بالنص والعنق % 5(@)(@@) % كما ينور آفاقا يشاهدها % % شرقا وغربا من الإشفاق بالشفق % 6(@)(@@) % ونور الجسم بالأرواح فانتشرت % عن أحمر ناصع وأبيض يقق % 7(@)(@@) % وأظلم السر بالهوا حيث ما وقعت % من الطباق التي أظهرن عن طبق % % 8(@)(@@) % وأظلم العقل في أفكاره نظرا % وأظلم النفس بالأطماع والعلق % 9(@)(@@) % وأظلم المعتدي من طبيعته % % بالأكلش من جرض والشرب من شرق % 10(@)(@@) % وأظلم الولد المخلوق من نطف % مكنونة بثلاث جئن في نسق % PageV01P695 11(@)(@@) % فليس من نور إلا قد يقابله % % ضدكما قابل الإشراق بالغسق % 12(@)(@@) % من أجل ذا ضل فإن في مقالته % % باثنين وافترقوا في ذا على فرق % 13(@)(@@) % والكل جاء إليه في تفكره % من الإله أمور فيه لم تطق % 14(@)(@@) % لذاك ما اختلفت فيه مقالتهم % ما بين قول بتقييد ومنطلق % 15(@)(@@) % وكل من قال قولا في عقيدته % % فإنه جاعل التقليد في العتق % 16(@)(@@) % سمعا وعقلا فما ينفك ذو نظر % من التحير للتهييج والحرقش % % 17(@)(@@) % لذا ترى كل من قد كان ذا فطن % وقتا على عرق مفض إلى حرق % PageV01P696 البحر : كامل تام 1(@)(@@) % التب من صفة اليدين لأنها % % جادت على الكفار بالإنفاق % 2(@)(@@) % وكلاهما عين الهلاك ونفسه % % فالهلك في الأملاك والإرفاق % 3(@)(@@) % نفقت يميني وهو عين هلاكها % % أين الهلاك من اسمه الخلاق % 4(@)(@@) % لولا وجود القبض ما انبسطت لنا % % كف الكريم بسيبه الغيداق % PageV01P697 البحر : طويل 1(@)(@@) % لها ولهذا لو تفكرت شيبت ألا إن رب الناس ربي وإنه % % لذي النظر الفكري رب المشارق % 2(@)(@@) % ثلاثة أسماء بإحكام دورها % % نموت ونحيى ما أنا بالمفارق % 3(@)(@@) % لها 
ms180	 ولهذا لو تفكرت شيبت % بأحكامها فينا وفيكم مفارقي % % 4(@)(@@) % فلولا الرحيم الرب ما كنت طامعا % وإن كان فيهما حكمة بالتطابق % 5(@)(@@) % وبالواسع الرحمن وسعت خاطري % % وقد كنت منها في عقود المضايق % PageV01P698 البحر : طويل 1(@)(@@) % تعشقت نفسا ما رأيت لها عينا % وما سمعت أذناي فيها من الخلق % 2(@)(@@) % كلاما يؤديني إلى حسن عينها % % فعشقي لها بالاتفاق وبالوفق % 3(@)(@@) % مناسبة تخفى على كل ناظر % % ويعلمها العلام بالرتق والفتق % 4(@)(@@) % أشاهد منها كل سر محجب % وما لي فيها غير ذلك من حق % 5(@)(@@) % وليس حجابي غير كوني فلو مضى % % قعدت مع المحبوب في مقعد الصدق % % 6(@)(@@) % وهذا محال أن يكون ذهابه % % فما ثم صفو لا يخلط بالرفق % 7(@)(@@) % تجلى لنا بالأفق بدرا مكملا % وإن فؤادي لا يجن إلى الأفق % 8(@)(@@) % وإن كان حقا فالمجالي كثيرة % % وشرعي نهاني عنه في حلبة السبق % 9(@)(@@) % لقد أوب الحق العليم بلادنا % % نفوس عباد حظها الوهم إذ يلقي % % 10(@)(@@) % وسرحني في كل وجه بوجهة % % ولم يتقيد لي بغرب ولا شرق % PageV01P699 11(@)(@@) % وفرق لي ما بين كوني وكونه % وإن وجود السعد في ذلك الفرق % % 12(@)(@@) % تعالى فلم تعلم حقيقة ذاته % % سغلت فلم أجهل فحدي في نطقي % % 13(@)(@@) % ولم أدر أن الحد يشمل كونه % وكوني إذا كانت هويته خلقي % % 14(@)(@@) % كما جاء في الوحي المقرر صدقه % على ألسن الأرسال والقول للحق % 15(@)(@@) % به يسمع العبد المطيع به يرى % % به يظهر الأفعال في الفتق والرتق % 16(@)(@@) % لو أن الذي قد لاح منه يلوح لي % % ولا شرع عندي ما جنحت إلى الفسق % 17(@)(@@) % وكنت بما قد لاح لي في بصيرة % فقيدني بالشرع كشفا وما يبقي % % 18(@)(@@) % خلافا فإن الأمر فيه لواحد % ولا ينكر الحق الذي جاء بالحق % 19(@)(@@) % إلهي يحب الرفق في الأمر كله % % كذلك أهل الله يأتون بالرفق % 20(@)(@@) % لقد شاهدت عيني ثلاث أسرة % % وفي ثالث منها ازورار من العرق % PageV01P700 21(@)(@@) % وأخره عن صاحبه اعتراقه % وكل له شرب روي من الحق % 22(@)(@@) % موازين لا تخطيك فالوزن قائم % ولا سيما في عالم 