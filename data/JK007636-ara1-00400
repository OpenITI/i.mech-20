ms381	 كأيام % % 19(@)(@@) % ولت كأني منها كنت في سنة % ثم انبرت لي أيام كأعوام % % 20(@)(@@) % مقلقلا بيد الأيام مضطربا % كأنما استسقت مني بأزلام % % PageV01P1741 21(@)(@@) % قد حرمت حالتي طيب الحياة بها % % كأن طيب حياتي طيب إحرام % % 22(@)(@@) % هي المقادير لا تنفك مقدمة % % وللحجى خطرات ذات إحجام % % 23(@)(@@) % أما ولي حالة عن مرة نقلت % % لأنقلن بها عن عزم همام % % 24(@)(@@) % ورب شائمة عزمي ومرتحلي % % إلى حمى مصر أشكو جفوة الشام % % 25(@)(@@) % قالت وراءك أطفال فقلت لها % % نعم ونعمى ابن فضل الله قدامي % % 26(@)(@@) % لولاعلي ابن فضل الله ما استبقت % % سفائن العيس في لج الفلا الطامي % % 27(@)(@@) % لعاقد خنصر المداح يوم ثنا % % وموضح الجود فيهم بعد إبهام % % 28(@)(@@) % رب السيادة في إرث ومكتسب % فيالها ذات أنواع وأقسام % % 29(@)(@@) % سد ياعلي بن يحيى كيف شئت فما % % في فرعك المجتنى والأصل من ذام % % 30(@)(@@) % وارفع إلى عمر إسناد بيتك في % % فضل وفصل وتقديم وإقدام % % PageV01P1742 31(@)(@@) % بيت تسامى إلى الفاروق منصبه % % فكاتبته العلى بالمنصب السامي % % 32(@)(@@) % منظم طاب حتى تم مفخره % % فكم إلى طيب يعزى وتمام % % 33(@)(@@) % إسم حروف المعالي فيه واضحة % % وكل عال سواكم حرف إدغام % % 34(@)(@@) % لو طاولتكم نجوم الأفق ما بلغت % % قوادم النسر منكم ترب أقدام % % 35(@)(@@) % بأول الحال منكم أو بآخره % % يراكم الله تأييدا لإسلام % % 36(@)(@@) % إما بأرماح أقلام لكم عرفت % % لياقة الحد أو إرماح أقلام % % 37(@)(@@) % تحمون سرح الهدى بدأ ومختتما % وتنهضون بإنعام وإرغام % % 38(@)(@@) % منكم علي نماه للعلى عمر % فحبذا ثمرات المغرس النامي % % 39(@)(@@) % ندب سما وحمت ملكا براعته % % فذا له الناس من سام ومن حام % % 40(@)(@@) % محسن الخلق والأخلاق تألفه % % عقائل الفضل عن وجد وتهيام % % PageV01P1743 41(@)(@@) % من أجل ما عقد المداح خنصرهم % % عليه ميز من جلي نجا تام % % 42(@)(@@) % لا عيب فيه سوى علياء حالته % % عن صف ما شئت من عي وإفحام % % 43(@)(@@) % تدري سرائر نجوانا عوارفه % % إما بصائب فكر أو بإلهام % % 44(@)(@@) % لو أن للبحر جزأ من مكارمه % % ألقى على الطرق درا موجه الطامي % % 45(@)(@@) % جارى حياه بحار الأرض 
ms382	 يوم ندى % % ويوم علم فروى غلة الظامي % % 46(@)(@@) % فالبحر يزبد من غيظ يخامره % % والبرق يضحك من عجز الحيا الهامي % % 47(@)(@@) % والعدل يغمض جفن السيف في دعة % % من بعد ما كان جفنا دمعه دامي % % 48(@)(@@) % أما الملوك فقد أغنى ممالكها % % تصميم منطقة عن حد صمصام % % 49(@)(@@) % ذو اللفظ علمت المصغي فصاحته % % قول المدائح فيه ذات إحكام % % 50(@)(@@) % فلو مزجت أباريق المدام به % % ما رجعت صوت فأفاء وتمتام % % PageV01P1744 51(@)(@@) % يا فاضلا لو رنت عين العماد له % % لبات يخفق رعبا برقه الشامي % % 52(@)(@@) % غطى ثناك على عبد الرحيم فما % % ترنو لأنجمه أبصار أفهام % % 53(@)(@@) % وقدج طوى نظمك الطائي منهزما % لما برزت بأطراس كأعلام % % 54(@)(@@) % ليخبر الملك في مناك عن قلم % صان الأقاليم عن تخبير مستام % % 55(@)(@@) % أشد من ألف في الكف يكرع من % % نون وأمنع يوم الروع من لام % % 56(@)(@@) % تغاير الوصف في يوم العطاء به % % والناس ما بين مطعان ومطعام % % 57(@)(@@) % وراثة لك يا ابن السابثقين علا % في بث مكرمة أو حسم آلام % % 58(@)(@@) % كأن أهل العلى جسم ذووك له % % هام وأنت يمين العين في الهام % % 59(@)(@@) % ان كنت في الوقت قد أوفيت آخرهم % % فانك العيد وافى آخر العام % % 60(@)(@@) % شكرا لأوقات عدل قد أنمت بها % % عين الرعايا فهم في طيب أحلام % % PageV01P1745 61(@)(@@) % وأنجم خدمت علياك فهي اذا % نعم الجواري التي تدعى بخدام % % 62(@)(@@) % أبحت يا صاحب السر النوال وقد % % منعت ما خيف من ظلم وإظلام % % 63(@)(@@) % وأنجدتنا على الأمداح منك لهى % إلى الورى ذات إنجاد وإتهام % % 64(@)(@@) % خذها منظمة الأسلاك معجزة % % بالجوهر الفرد فيها كل نظام % % 65(@)(@@) % مصرية من بيوت الفضل ما عرفت % % فيها بنسبة جزار وحمام % % 66(@)(@@) % أنت الذي أنقذتني من يدي عدمي % % آلاؤه ومحت بالبر إعدامي % % 67(@)(@@) % فعش مع الدهر لا إبرام في سبب % % لما نقضت ولا نقض لابرام % % 68(@)(@@) % ودم لحمد وآلاء ملأت بها % % جهاتي الست من جاه وإنعام % % 69(@)(@@) % فواضل عن يميني والشمال ومن % % فوقي وتحتي ومن خلفي وقدامي % % PageV01P1746 البحر : - 1(@)(@@) % يدافعني الغيران عن طيب لثمها % % فيقنعني 
ms383	 لثم التذكر لاسمها % % 2(@)(@@) % محجبة أبكي ليالي وصلها % % بشهبي وحمري وهي تبكي بدهمها % % 3(@)(@@) % بكيت بلوامي عليها وعذلي % % ولا وصل إلا بين وهمي ووهمها % % 4(@)(@@) % وصنو أب قد صان نقطة خالها % % فيا حربا من خالها ثم عمها % % 5(@)(@@) % ويا عجبا حيث اللآلي يتيمة % % بفيها وما يبدو بها ذل يتمها % % 6(@)(@@) % وحيث أرى من جفنها السهم قاتلا % وما غرضي إلا ملاقات سهمها % % 7(@)(@@) % بروحي من لا خارج غير ردفها % % ثقيلا ومن لا بارد غير ظلمها % % 8(@)(@@) % أما وجراحي خدها ثم أدمعي % % لقد وقعت عين المحب بجرمها % % 9(@)(@@) % ودر بكائي حين يبسم ثغرها % % لقد لاح فرق بين نثري ونظمها % % 10(@)(@@) % نأت فنأى عني الكرى وتغيبت % % فلا طيب أحلامي ولا فضل حلمها % % PageV01P1747 11(@)(@@) % وأفردت بالآلام فيها وقاسمت % % لواحظها ما بين سقمي وسقمها % % 12(@)(@@) % كأني ما نزهت طرفي ببيضة % % اليها ولا رويت قلبي بضمها % % 13(@)(@@) % و لا ظننا الواشون حرفا مشددا % لتوثيق جسمي في العناق وجسمها % % 14(@)(@@) % يداي على الحسناء قفل مؤكد % بآثار لثم مثل آثار ختمها % % 15(@)(@@) % زمان غوايات الصبابة والصبا % % أغر بنعماها وألهو لنعمها % % 16(@)(@@) % و ليل شباب أيقظ الشيب مقلتي % % لديه وكانت في غيابة حلمها % % 17(@)(@@) % و طاوعت نصاحي ويارب مأثم % % قضيت على رغم النهى قبل رغمها % % 18(@)(@@) % و ما الشيب الا كالحسام مجردا % لتعجيل أدواء الضلال لجسمها % % 19(@)(@@) % تبارك من أردى ضلالا برحمة % % وزين آفاق المعالي بنجمها % % 20(@)(@@) % إمام اذا عاينت سنة وجهه % % حكمت على تلك الفخار بعلمها % % PageV01P1748 21(@)(@@) % تهلل اذ طارحته بمدائحي % % تهلل وسمي البروق بوسمها % % 22(@)(@@) % حفي بطلاب الفضائل والندى % % فلله ما حي عيها بعد عدمها % % 23(@)(@@) % وفاصل أحكام القضاء بفطنة % % كأن سرار الشهب من فتح فهمها % % 24(@)(@@) % اذا اختصم الأقوام ضاء بفكرة % % يقول ضياء الصبح لست بخصمها % % 25(@)(@@) % و لا عيب فيه غير إسراف أنعم % % ترى عزمها في الجود غاية غنمها % % 26(@)(@@) % يجانس بالفتوى الفتوة جائدا % ويعرب عن فصل الأمور بحزمها % % 27(@)(@@) % اذا زعماء القوم همت بشاؤه % % فقد طلبت شأو النجوم بزعمها % % 28(@)(@@) % فديناه ندبا زاد في 
ms384	 شأو بيته % % اذا نقصت ذات البيوت بجرمها % % 29(@)(@@) % و قاضي القضاة تعرب الخلق مدحه % % فتعجز حتى عربها مثل عجمها % % 30(@)(@@) % فيمدحه حتى النسيم بعرفه % % وتصغى له حتى الجبال بصمها % % PageV01P1749 31(@)(@@) % له همة ان شئت غالية الثنا % % فشمها وإن شئت الفخار فشمها % % 32(@)(@@) % على حين مسود المفارق حالك % % فكيف اذا ضاء المشيب بفحمها % % 33(@)(@@) % و أقلام رشد يتبع الرشد خطها % % ويعمل أنواع الثناء برسمها % % 34(@)(@@) % يقيم على العادين حدا بحدها % % ويهدي إلى العافين عزا بعزمها % % 35(@)(@@) % و تكتب في حالي نداها وسطوها % % بدرياقها طورا وطورا بسمها % % 36(@)(@@) % مسددة المرمى مقسمة الحيا % % فلا زال للاسلام وافر سهمها % % 37(@)(@@) % بكف كريم يملأ العلم والقرى % % لديه قلوب الطالبين بشحمها % % 38(@)(@@) % فتى الدين والدنيا ينير ظلامها % % بكوكبها العالي ويلوي بظلها % % 39(@)(@@) % سليل عماد الدين انك بعده % % مصاعد ما هم الزمان بثلمها % % 40(@)(@@) % تطوف بمغناه وفود مقاصد % % محملة جدوى يديه لهمها % % PageV01P1750 41(@)(@@) % لتمكين رجواها وتأمين روعها % % وتأثيل نعماها وتفريج غمها % % 42(@)(@@) % فما الشهد أحلى من صنائع فضله % % ولا المسك أذكى من تضوع كتمها % % 43(@)(@@) % و ما روضة بالحزن مخضلة الربى % % مكاثرة زهر النجوم بنجمها % % 44(@)(@@) % يجر لديها عاطر الريح ذيله % % وتخطر فيها المزهرات بكمها % % 45(@)(@@) % بألطف من أخلاقه عند شيمها % % وأعطر من أخباره عند شمها % % 46(@)(@@) % لجأت اليه والحياة مريرة % % فعرفني إحسانه حلو طعمها % % 47(@)(@@) % و كنت على قصدي من الناس خائفا % فألقيته من راحتيه بيمها % % 48(@)(@@) % و ما هو إلا النجم جاورته فلا % % مخافة من كل العداة وكلمها % % 49(@)(@@) % أتمت حلا مرآه حلية حبره % % فلا عدمت منه العلى بدر تمها % % PageV01P1751 البحر : - 1(@)(@@) % إلى م بين العشق واللائمه % % خواطري شاعرة هائمه % % 2(@)(@@) % في كل ناد أصبحت صبوتي % % ناثرة ودمع عيني ناظمه % % 3(@)(@@) % مفطر المهجة في حب من % % عيني عن النوم بها صائمه % % 4(@)(@@) % يسوم سعر الوصل من سامه % لو ترع في الحب لها سائمه % % 5(@)(@@) % وأهيف كالرمح أعطافه % % عادلة مع أنها ظالمة % % 6(@)(@@) % تلوم في ناعس أجفانه % % لائمة عن صبوتي نائمه % % 7(@)(@@) % كمثل ما لامت بها 
ms385	 في التقى % % في الجود بعض النية الراغمة % % 8(@)(@@) % أوفى الورى علما وأسماهم % % إلى العلى عزما وأبهى سمه % % 9(@)(@@) % ذو الأصل والفرع له نسبة % % جليسة في دستها قائمه % % 10(@)(@@) % فريد وقت بفريد الثنا % % قد جليت أوقاته الباسمه % % PageV01P1752 11(@)(@@) % سبكية التبر سبيكية % % أوصافه في المدح في اللازمة % % 12(@)(@@) % لله ما أغناه في حالتي % % جدوى وفتوى للعلى قاسمه % % 13(@)(@@) % كلتاهما للطالبي غوثة % % في الفقه والجهل يد حاسمه % % 14(@)(@@) % أقلامنا في طرس إمداحه % % تجرها جارية خادمه % % 15(@)(@@) % دنيا وأخرى كلمت ذاته % % فحبذا المبدأ والخاتمه % % 16(@)(@@) % أبا البقا هنئت طول البقا % % بنعمة سابغة دائمه % % 17(@)(@@) % و سؤدد مكنت أسبابه % % بعزمه عاملة عالمه % % 18(@)(@@) % و وصلة زاكية بالرفا % % وبالبنين ابتدرت باسمه % % 19(@)(@@) % رقت على زاهر افق الهدى % % زهراء في أنجمها الناجمه % % 20(@)(@@) % عقيلة الأنصار حكامهم % % لا برحت علياهم حاكمه % % PageV01P1753 21(@)(@@) % نبت علي بعلا قومها % % تعيش أجسادهم فاطمه % % 22(@)(@@) % رافعة في ظلهم بيتها % % بكسر أعدائهم جازمه % % PageV01P1754 البحر : - 1(@)(@@) % مدمع سائل لغير رحيم % واعنائي من سائل محروم % % 2(@)(@@) % ونثار من البكى مستفاض % % في الهوى من لقاء ثغر نظيم % % 3(@)(@@) % صادق الخد واستحم به الجس % % م فآها من الصديق الحميم % % 4(@)(@@) % ليت شعري أهكذا كل صب % أم كذا حال حظي المقسوم % % 5(@)(@@) % يجرح القلب وهو عدل عن الح % % ب ويقضي الغرام وهو غريمي % % 6(@)(@@) % حربي من مهفهف القد ألمى % % أوقع القلب في العذاب الأليم % % 7(@)(@@) % قائم الخصرقاعد الدف أمري % % فيه ما بين مقعد ومقيم % % 8(@)(@@) % وعده مثل خصره من جفاء % باطني يقول بالمعدوم % % 9(@)(@@) % لي على روض خده كل يوم % أدمع مستهلة كالغيوم % % 10(@)(@@) % لا تلم عاشقا بكى بعد روض % كبكاء الوليد بعد نسيم % % PageV01P1755 11(@)(@@) % حطم الوجد ركن دمعي وطافت % % لوعتي بين زمزم والحطيم % % 12(@)(@@) % ورمتني من العيون سهام % ذات نصل كما ترى مسموم % % 13(@)(@@) % بين مرئى فم وطرة شعر % % فهي لاشك بين سين وميم % % 14(@)(@@) % يالها من سهام لحظ كستني % % برد سقم محرر التسهيم % % 15(@)(@@) % و فم بارد المراشف لكن % % كبدي منه في سواء الجحيم % % 16(@)(@@) % برخيم الألفاظ 
ms386	 صير حظي % % مثل حظ الاسماء بالترخيم % % 17(@)(@@) % ودجى طرة تسلمت القل % % ب فأمسى منها بليل السليم % % 18(@)(@@) % ذات صدغ دناله مسك خال % % فحسبناه نقطة تحت جيم % % 19(@)(@@) % و رقيم من العذار ثناني % % ساهرا طول ليلتي بالرقيم % % 20(@)(@@) % خط ريحانه على ماء خد % % كاد يجري في نضرة ونعيم % % PageV01P1756 21(@)(@@) % ما تذكرت ذا وهذاك إلا % % بت بين المشروب والمشموم % % 22(@)(@@) % رب ليل قد همت فيه بظبي % % قربه لي أشهى من التهويم % % 23(@)(@@) % باللمى والطلا سعى فسقاني % % من كلا الساعيين بالخرطوم % % 24(@)(@@) % حيث وجه الزمان عندي هش % % ونبات الشباب غير هشيم % % 25(@)(@@) % يا زمان الصبا سقتك الغوادي % % أين كأسي وروضتي ونديمي % % 26(@)(@@) % عن جمال الوجوه قصر شجوي % % وثنائي يهوى جمال العلوم % % 27(@)(@@) % سيد وابن سيد هام حمدي % % فيهما بالكريم وابن الكريم % % 28(@)(@@) % و إمام محراب أفكاره الطر % % س وكل الأنام مثل الأميم % % 29(@)(@@) % بشروا بيته الذي طال قدرا % بغلام في العالمين عليم % % 30(@)(@@) % ذو كلام تجمع الجوهر الفا % % خر فيه وذل قدر اليتيم % % PageV01P1757 31(@)(@@) % أين عبد الحميد من نثره الجز % % ل الذي كساه ثوب الذميم % % 32(@)(@@) % أين نظم السعيد منه ومن قو % % ة ما خطه ابن العديم % % 33(@)(@@) % ذاك خط أغضى ابن مقلة عنه % % يوم فخر اغضاء غير حليم % % 34(@)(@@) % زاحف بين أسطر وطروس % % لسطا عسكرين زنج وروم % % 35(@)(@@) % صغت لي من حلاك يا ابن علي % % طوق مجد على الفخار مقيم % % 36(@)(@@) % و أدارت يمناك لي كأس درج % % كان فيها المزاج من تسنيم % % 37(@)(@@) % يلتقيها لفظ المصلين عجبا % ويمدون راحة التسليم % % 38(@)(@@) % ليس فيها عيب سوى أنني بال % % عجز عنها شكوت شكوى الظليم % % 39(@)(@@) % حين ولى زمان لفظي وجفت % % أيكتي وانثنى هبوب نسيمي % % 40(@)(@@) % و رأيت الألفاظ أولاد فكر % % نفرتها عني وجوه همومي % % PageV01P1758 41(@)(@@) % فغدا الفكر في التغابن عجزا % وهي عنه في غاية التحريم % % 42(@)(@@) % نقصت قوتي عن المدح فاصفح % % في نظامي عن خجلة التتميم % % 43(@)(@@) % واكتم السر عن معائب فاهت % % فسروري في سرها المكتوم % % PageV01P1759 البحر : - 1(@)(@@) % ربع لعزة صامت لا يفهم % % وقلوبنا 
ms387	 في رسمه تتكلم % % 2(@)(@@) % لو لم تعف حماه غر سحائب % % تهمى لعفته مدامع تسجم % % 3(@)(@@) % وعلى البكى فلقد يروق كأنما % % قطع الغمام عليه برد معلم % % 4(@)(@@) % ما أنس كم ليل عليه قطعته % % بالوصل تعذرني عليه اللوم % % 5(@)(@@) % حيث المجرة فيه مثل سبيكة % % قد جربت فالبدر منها درهم % % 6(@)(@@) % وضجيعتي خود بحكم جفائها % % ولقائها يشقى المحب وينعم % % 7(@)(@@) % حوراء الا أنها قد أسكنت % % قلبي الذي تبلته وهو جهنم % % 8(@)(@@) % لو لم تكن روضا لما كانت اذا % % هطلت غيوث مدامعي تتبسم % % 9(@)(@@) % يا قلب هذا شعرها وجفونها % % فاصبر اذا زحف السواد الأعظم % % 10(@)(@@) % ما الشمس أشرف بهجة منها ولا % % صوب السحائب من علي أكرم % % PageV01P1760 11(@)(@@) % بحر تعلمنا المديح صفاته % % فعقوده منه عليه تنظم % % 12(@)(@@) % متيقظ الآراء تحسب أنه % % كل الأمور لديه غيبا يعلم % % 13(@)(@@) % ومسدد الحركات ينهل الندى % % وتخيم العلياء حيث يخيم % % 14(@)(@@) % جزل العطاء والبأس حين خبرته % % كالسيف حين يروق ثم يصمم % % 15(@)(@@) % تجني فيحلم بعد ما جاورته % % حتى تظن لديه أنك تحلم % % 16(@)(@@) % رفق كما انحلت خيوط غمامه % % فإذا سطا نزل القضاء المبرم % % 17(@)(@@) % نطق الزمان به وكل مفاخر % % كلم على لسن الزمان مجمجم % % 18(@)(@@) % إنظر لحبوته وأنعمه تجد % % من جانبي رضوى سيولا تفعم % % 19(@)(@@) % لا عيب فيه سوى تسلط جوده % % فالمال من نفحاته يتظلم % % 20(@)(@@) % لله ما بلغت مساعيه وما % % جمعت من المجد الذي لا يرغم % % PageV01P1761 21(@)(@@) % كرم تصلي السحب خلف صلاته % % لكنها للعجز عنه تسلم % % 22(@)(@@) % وثنا يقيد بالمدائح ذكره % % فتراه ينجد في البلاد ويتهم % % 23(@)(@@) % عبق الشذا تحكيه زهر كمائم % % في الروض الا أنها تتكلم % % 24(@)(@@) % وفضائل لذت وعز مرامها % % فكأنها شهد يذاق وعلقم % % 25(@)(@@) % من كل ساجعة السطور كأنما % % همزاتها ورق بها تترنم % % 26(@)(@@) % وقصيدة غراء تعلم أنه % % قد غادر الشعراء ما يتردم % % 27(@)(@@) % وتواضع كالشمس دان ضوءها % % والقدر أرفع أن ينال ويكرم % % 28(@)(@@) % يممه يا راجيه تلق خلاله % % تسدي بها حلل الثناء وترقم % % 29(@)(@@) % يرجى فيعطي فوق كل رغيبة % % وتطيش ألباب الرجال فيحلم % % 30(@)(@@) % واذا 
ms388	 دعى الداعي نزال وجدته % % بالرأي يطعن واليراع فيهزم % % PageV01P1762 31(@)(@@) % قلم له في كل يوم كريهة % % أنباء يجري في جوانبها الدم % % 32(@)(@@) % نادى سواد النفس لما أفصحت % % كلماته أنا عبد من يتفهم % % 33(@)(@@) % و جرت بحكمته يد من تحتها % % أبدا يد من فوقها ابدا فم % % 34(@)(@@) % يا ابن الذين لهم سنا بهر الورى % % وعلا نبجل ذكرها ونعظم % % 35(@)(@@) % شرف ولكن بالهلال متوج % % فوق السماء وبالسماك مخيم % % 36(@)(@@) % يفدي ربيع نداك مثر كفه % % أبدا جمادى أو نداه محرم % % 37(@)(@@) % قرم يعيس للمديح اذا شدا % % فكانه عند المديح مذمم % % 38(@)(@@) % أنت الذي لجأت اليه مدائحي % % أيام لا وزر ولا مستعصم % % 39(@)(@@) % اغنيتني عمن إذ مدح امرؤ % % لم يفرحوا واذا هجا لم يألموا % % 40(@)(@@) % خذها اليك بديهة عربية % % ما نال غايتها زياد الاعجم % % PageV01P1763 41(@)(@@) % شاب الوليد لعجزه عن مثلها % % وارتد عن نظم القوافي مسلم % % PageV01P1764 البحر : - 1(@)(@@) % قوامك تحت شعرك يا أمامه % % لحسنك حامل علم الإمامة % % 2(@)(@@) % أما وصراط فرق مستقيم % لقد قامت علي به القيامة % % 3(@)(@@) % بروحي منك قدا هز رمحا % فسل الجفن أيضا لي حسامه % % 4(@)(@@) % وخد شاهد بدمي والا % % بأن وراه من ريق مدامه % % 5(@)(@@) % يشف من الاضاءة عن رحيق % تخال الخال من مسك ختامه % % 6(@)(@@) % تأخر يا غلام وخل خالا % ينادمني على خد الغلامه % % 7(@)(@@) % لشامته يقول اذا أديرت % % علي مدام ريقته بشامه % % 8(@)(@@) % ألذ بظلمها لي حيث لذت % % به فأفر من كشف الظلامه % % 9(@)(@@) % إلى أسد لها نسب ولكن % % محاسنها إلى آرام رامه % % 10(@)(@@) % أطعت بها الغواية والتصابي % % وعاصيت النصيحة والملامه % % PageV01P1765 11(@)(@@) % و قلت لعاذلي لا كيد يمشي % % لمثلك في هواي ولا كرامه % % 12(@)(@@) % زمان اللهو مبرور اليالي % % ووجه الأنس وضاح الغمامه % % 13(@)(@@) % و رب حمامة سجعت فهاجت % % خفايا مهجة لي مستهامه % % 14(@)(@@) % فما ورق الحمامة حين أبدت % % خفا شجني سوى زرق اليمامه % % 15(@)(@@) % لقد حاكيتها وجدا وحيدا % عليه لحلية النعمى وسامه % % 16(@)(@@) % فما يبلى جواي ولا أنادي % % علي لي ولا طوق الحمامه % % 17(@)(@@) % سقى دنيا علي كما سقاني % % فواصل 
ms389	 كفه صوب الغمامه % % 18(@)(@@) % وزير ماترى الفضل بن يحيى % % سواه ولا الحسين ولا قدامه % % 19(@)(@@) % عيان الفضل دع خبر ابن قيس % % ورأس الجودع كعب بن مامه % % 20(@)(@@) % تعالى الله ما أندى حياه % % لدى رجوى وما أوفى ذمامه % % PageV01P1766 21(@)(@@) % بدتا ويد الزمان قد استطالت % % فأخمد ظلمه ومحا ظلامه % % 22(@)(@@) % ووفى الملك ما شرطت عليه % % تكاليف الكفالة والزعامه % % 23(@)(@@) % وداعي الجود يروي عن رباح % وداعي اليأس يروي عن أسامه % % 24(@)(@@) % وكأس الحمد في يمناه يملا % % بممزوج اللطافة والشهامه % % 25(@)(@@) % وملك صلاح دين الله يزهو % % بأفضل فاضل فيه اقامه % % 26(@)(@@) % فأما أصله فإلى قريش % وأما سره فالى كتامه % % 27(@)(@@) % له قلم تقسم ريقتاه % % شهاد فم المحاول أو سمامه % % 28(@)(@@) % مكين في الندى والبأس إما % % لهام في المصالح أو لهامه % % 29(@)(@@) % وما اللامات تحمي الجيش إلا % % إذا ما خط فوق الطرس لامه % % 30(@)(@@) % ومالروض النضير له نظير % % إذا أدراجه مزجت كلامه % % PageV01P1767 31(@)(@@) % وما الدر اليتيم ربيب بيت % % إذا لم يعتمد يوما نظامه % % 32(@)(@@) % علاء الدين ما أشهى للثمي % % ثرى قدميك أجعله لثامه % % 33(@)(@@) % أتيت الشام بعد سنين جدب % فكان العام حين أغثت عامه % % 34(@)(@@) % وواليت الندى مالا وجاها % إلى أن جانس الكرم الكرامه % % 35(@)(@@) % وعدت عزيز مصر وكل مصر % سعيدا في الترحل والاقامه % % 36(@)(@@) % وقالوا سار قلبك يوم سارت % % ركائبه فقلت مع السلامه % % 37(@)(@@) % ففي دار البوار الآن شخصي % % وقلبي الآن في دار المقامه % % 38(@)(@@) % اليك أبو الخلائف من قريش % % سؤال سامه أملي وحامه % % 39(@)(@@) % أذكر جودك الوعد المبدا % % وقد أخمدت من سغبي ضرامه % % 40(@)(@@) % جعلت الجسم مني بيت لحم % وزدت وظائفي أيضا قمامه % % PageV01P1768 41(@)(@@) % وما أدري أتوقيعي بمصر % وإلا بالشآم فلن أسامه % % 42(@)(@@) % إلى التوقيع قد طرب استماعي % % وحار دقيق فكري في العلامه % % PageV01P1769 البحر : - 1(@)(@@) % تفهمه قلبي الشجي فهاما % % ولم يره طرف الغبي فلاما % % 2(@)(@@) % وعرفني بالحب في خد عارض % بدا ألفا ثم استدار فلاما % % 3(@)(@@) % بوحي رشيق المقلتين إذا رنا % % رمى في فؤاد المستهام سهاما % % 4(@)(@@) % جعلت دموع العين جارية له % % وصيرت 
ms390	 قلبي في هواه غلاما % % 5(@)(@@) % من الغيد حسبي ورد خديه نزهة % % وريقته يا حسرتاه مداما % % 6(@)(@@) % يقول حلال خمر ريقي وليته % % سقاني به كأسا وكان حراما % % 7(@)(@@) % لئن تم عشقي في ملاحته لقد % % تعشثقت بدرا في الملاح تماما % % 8(@)(@@) % وعذبني ذاك المليح بناره % % فكان عذاب القلب فيه غراما % % 9(@)(@@) % ووالله لا أصغيت فيه لعاذل % % ولو ذاب جسمي لوعة وسقاما % % 10(@)(@@) % سأزداد في الحب انتسابا لعامر % إلى أن أزيد العاذلين ملاما % % PageV01P1770 11(@)(@@) % يقولون أعدتك السقام جفونه % % فقلت ومن أعدى الجفون سقاما % % 12(@)(@@) % ومن مزج الغصن الرطيب بعطفه % % فكان مزاج المعطفين قواما % % 13(@)(@@) % تناوحت العشاق إذ ماس قده اذا خاطبتني في هواه عواذلي مضيت على حالي وقلت سلاما % % فيا لك غصنا في الهوى وحماماسقط بيت ص % % 14(@)(@@) % كما خاطب العذال جود محمد % فأعرض عنهم واستهل غماما % % 15(@)(@@) % رئيس على التحقيق قالت صفاته % % لنقاده ذا ما يخالط ذاما % % 16(@)(@@) % سمونا لمدح المفضلين وإنما % % لأمثاله في الفضل لن يتسامى % % 17(@)(@@) % وألت معانينا إلى مسك ذكره % % فكانت لذكر الأكرمين ختاما % % 18(@)(@@) % أخو العلم والتقوى تقدم فيهما % % فكان أمرا للمعتقين إماما % % 19(@)(@@) % يقضون للملك النهار فان دجى % % مسا الليل باتوا سجدا وقياما % % 20(@)(@@) % وأضحى لسر الملك صدرا قد انتقى % % له مستقرا في الورى ومقاما % % PageV01P1771 21(@)(@@) % سقى الغيث مثوى الصاحب الشرف الذي % % عهدنا به عهد النوال ركاما % % 22(@)(@@) % وغر المعالي أخجلت كل سالف % من القوم كانوا للأمور قواما % % 23(@)(@@) % تنادي نظام الملك أسلاك فضله % % إليك فما كل النظام نظاما % % 24(@)(@@) % لنعم الفتى أبقى لروض نباته % % شميما وأوهى الدهر منه شماما % % 25(@)(@@) % ونعم سبيل المكرمات محمد % % اذا ما ذكرنا ناسلا وإذا ما % % 26(@)(@@) % بدا مثل ما يبدو الصباح فخاره % % فزيل من ظلم الزمان ظلاما % % 27(@)(@@) % وعال باذن الله أبناء آدم % % وحام بأفاق الفخار وساما % % 28(@)(@@) % بليغ الندى والنطق تلقاه فيهما % % فريدا وتلقى المكرمات نواما % % 29(@)(@@) % له قلم ان ماس كان لمعتف % حياة وإلا للعدو حماما % % 30(@)(@@) % يمج شهادا تارة لوليه % % ووقتا لشانيه يمج سماما % % PageV01P1772 31(@)(@@) % قرين الفتاوى والفتوة 
ms391	 لم يذق % % بليل مداد بين ذاك مناما % % 32(@)(@@) % تسهد في حفظ الممالك جفنة % % وفي كل جفن قد أنام حساما % % 33(@)(@@) % بكف كريم الراحتين مؤمل % % فيا لك برقا في الندى وغماما % % 34(@)(@@) % ويا لك في النطق البليغ قدامة % % وفي طيران الذكر عنه قداما % % 35(@)(@@) % شكوت له ظلم الزمان وانما % % إلى سيد بر شكوت غلاما % % 36(@)(@@) % فرد الزمان الجهم عني خاضعا % فتى ليس غيم الظن فيه جهاما % % 37(@)(@@) % وجدد من جدواه مالا نسيته % % ولم يبق من عند الزمان مراما % % 38(@)(@@) % وألبسني بيضاء رد ضياؤها % % لدى حاسد حتى استحال ضراما % % 39(@)(@@) % أمد يدي في كل يوم لذيلها % % فآخذ من جور الشتاء ذماما % % 40(@)(@@) % ومذ علقت منها بناني بعروة % شددت لطرف القول فيه حزاما % % PageV01P1773 41(@)(@@) % فلا زال ممدوحا اذا ما وصفته % % زحمت المعاني المائلات زحاما % % 42(@)(@@) % أولد مع فقد الصبا جوهر الثنا % % يتيما وأولاد الشيوخ يتامى % % PageV01P1774 البحر : - 1(@)(@@) % قدوم كما حيي قدوم غمام % % وعود إلى الأوطان عود حسام % % 2(@)(@@) % فهذا على الرواد أكرم حاتم % % وهذا على الاسلام خير محامي % % 3(@)(@@) % لك الله من سار إلى أرب سرى % % هلال إلى أن غار بدر تمام % % 4(@)(@@) % دعاك إلى أرض الحطيم تذكر % % وغيرك مشغول الهوى بحطام % % 5(@)(@@) % فلله وفر من حلال بذلته % % على بلد زاكي المحل حرام % % 6(@)(@@) % وما هي إلا همة تغلبية % % تروم من العلياء كل مرام % % 7(@)(@@) % حوت أمد الدنيا من المجد وانبرت % % تشق إلى الأخرى صنوف زحام % % 8(@)(@@) % وما ضر ركبا كنت نجعة أهله % % تعذر زاد أو صروف غمام % % 9(@)(@@) % فوالله ما برق البشاشة خلب % لديك ولا غيم الندى بجهام % % 10(@)(@@) % يطوف بك الحجاج في كل منزل % اذا ذعرتهم سحبه بفطام % % PageV01P1775 11(@)(@@) % كأنهم قبل الوصول تعجلوا % % طوافهم في كعبة ومقام % % 12(@)(@@) % اذا ذكروا الركن اليماني يمموا % % مواهب ركن للعفاة شآمي % % 13(@)(@@) % كريم الثنا يجدي الركاب كأنه % % لنفحته قد حل دار سلام % % 14(@)(@@) % لقد ظفرت منكم قسي ظهورها % % لدى عرض البيدا بخير سهام % % 15(@)(@@) % وأحسن بها حيث الزمان يروعها % % نشاطا كأن النصل ثني زمام % % 16 
ms392	(@)(@@) % تمد جناحي ظلها في هجيرة % فتحسبها في البيد خيط نعام % % 17(@)(@@) % اذا خلعت وجه الفلا بمناسم % تفاءل حاديها بنيل مرام % % 18(@)(@@) % إلى أن أتت أرض المقام كأنها % % من البشر فيها بشرت بمقام % % 19(@)(@@) % ويمم هاتيك المناسك أروع % تهم على أعطافه بسلام % % 20(@)(@@) % إذا هو ولى قبلة البيت وجهه % فيا فضل محراب وفضل إمام % % PageV01P1776 21(@)(@@) % حلفت بما ضم المحصب والصفا % % وبالبدن في لباتهن دوامي % % 22(@)(@@) % لطابت على علياه طيبة دوره % % غدت لمساعي حجه كختام % % 23(@)(@@) % وجئت جلال المصطفى منك قائما % بشرعته الغراء خير قيام % % 24(@)(@@) % وعدت إلى الأوطان مقتبل الهنا % % يمد اليك السعي رأس غلام % % 25(@)(@@) % وشرفت أرضا قد وطئت كأنما % % وهاد الشرى منها فروع أكام % % 26(@)(@@) % وتشرح أرض الشام فيك غرامها % % بضعف نسيم أو حنين حمام % % 27(@)(@@) % وما أرقت حتى سريت كأنما % % مقامك فيها كان طيف منام % % 28(@)(@@) % بقيت على أولاد آدم منعما % وعن كل سام قد علوت وحام % % PageV01P1777 البحر : - 1(@)(@@) % أعيذ ريم الترك بالروم % % والصدغ مع فيه بحاميم % % 2(@)(@@) % ميم فم يسكرني ذكره % % فيالها سكرة خرطوم % % 3(@)(@@) % وجاء صدغ قد تأملتها % % فيا لها بالخال من جيم % % 4(@)(@@) % وناعس الاجفان ما هم في % % هواه لي جفن بتهويم % % 5(@)(@@) % كلم قلبي وسماعي فما % % ألذ في الحالين تكليمي % % 6(@)(@@) % يا سقمي من سقم أجفانه % % زدني ويا لائمتي لومي % % 7(@)(@@) % تسنمي سمعي ثم اجعلي % % مزاج ذكراه بتسنيم % % 8(@)(@@) % قبلة ذاك الوجه في مثلها % % صلاة أشجاني وتسليمي % % 9(@)(@@) % وخده المشرق قد صح في % % عذاره المعوج تقويمي % % 10(@)(@@) % ما عمل في الحب خاف على % % كتاب حسن فيه مرقوم % % PageV01P1778 11(@)(@@) % قد رسم الحسن عليه فما % % أقرأه إلا بمرسوم % % 12(@)(@@) % كم لثمة لي فيه قد عجلت % % سكري بمشمول ومشموم % % 13(@)(@@) % و ضمة للقد كم قابلت % % منصوب أشواقي بمضموم % % 14(@)(@@) % حتى اذا الشيب تلثمه % % ودعت مضمومي وملثومي % % 15(@)(@@) % و عارض الباسم لما نأى % % منثور أجفاني بمنظوم % % 16(@)(@@) % يا زمن الوصل سقاك الحيا % % ودمع أشواقي بمركوم % % 17(@)(@@) % ما كنت الا بارقا أتبعت % % عقباه من دمعي بمسجوم % % 18(@)(@@) % أين سهام 
ms393	 العيش مقسومة % % وأين في الألفاظ تسهيمي % % 19(@)(@@) % و أين اوطان الغنى والهنا % % وأين إقدامي وتقديمي % % 20(@)(@@) % و أين لا أين بلى أشرقت % % نجوم سعدي قبل تنجيمي % % PageV01P1779 21(@)(@@) % نعم وهذا خادمي اليمن قد % % أقبل اذ أقبل مخدومي % % 22(@)(@@) % حل علي بجسمي خائف % % فحل أمن بعد تحريم % % 23(@)(@@) % و يمم الشام فأغصانه % % أنامل نحو الهنا تومي % % 24(@)(@@) % و قلت إيه يا رجائي إلى % % ذي كرم يلفى وتكريم % % 25(@)(@@) % إلى حيا جاء إلى رائد % % فالآن تروى غلة الهيم % % 26(@)(@@) % إلى علي الاسم والفعل وال % % ألفاظ والرتبة والحيم % % 27(@)(@@) % ذو كوم ما هو الا القنا % % مركوزة حول الأقاليم % % 28(@)(@@) % ساع بتتويج ملوك الهدى % % وباسط البر بتعميم % % 29(@)(@@) % في راحة الجود تعبانة % % بنائل في الخلق مقسوم % % 30(@)(@@) % تمنى بليغ فهم الملك من % % جدوى عليه خير مفهوم % % PageV01P1780 31(@)(@@) % دان لنا وهو بعلياء لا % % يرقى اليها بالسلاليم % % 32(@)(@@) % كأنما ألفاظه جنة % % تجل عن لغو وتأثيم % % 33(@)(@@) % كأنما طلعته نير بد % % ر الدجى منها كملطوم % % 34(@)(@@) % لا عيب فيه غير نفس لها % % في جمع مجد حرص منهوم % % 35(@)(@@) % يقول رائيه إمداحه % % حومى على أفق العلى حومي % % 36(@)(@@) % و فطري إكباد أنداده % % وعن سوى إمداده صومي % % 37(@)(@@) % كل مسمى كرم حازه % % بكافه والراء والميم % % 38(@)(@@) % لولا ابن فضل الله ما استجمعت % % فرائد الفضل لتنظيم % % 39(@)(@@) % ينمي به المدح إلى أسرة % مادهر داعيهم بمذموم % % 40(@)(@@) % عن عمر الفاروق يروونه % % تراث تمجيد وتعظيم % % PageV01P1781 41(@)(@@) % ناهيك منهم بامام مضى % % وقائل بالعدل مأموم % % 42(@)(@@) % مثل إمام عادل قبله % % من درك الادناس معصوم % % 43(@)(@@) % يا ابن الأولى تخلق مداحهم % % من مسك ذكراهم بمختوم % % 44(@)(@@) % يا كاسرا بالرأي جيش العدى % % تكسير ماضي الفعل مجزوم % % 45(@)(@@) % يا صاحب السر وفي ذكره % % للمسك سر غير مكتوم % % 46(@)(@@) % عطفا على ميت من الفقر قد % % أصبح في حالة مرحوم % % 47(@)(@@) % منطبخ الاحشاء بالهم لا % % يزال في حلة مغموم % % 48(@)(@@) % قد أفسدت فاقته ذهنه % % فهو معافى مثل محموم % % 49(@)(@@) % راتبه مجهول أمر وما % % معلومه أيضا بمعلوم % % 50(@)(@@) % يسري برجليه سرى 
ms394	 سائل % % بسائل للدمع محروم % % PageV01P1782 51(@)(@@) % و ربما جاع على أنه % % في همة في زي مطعوم % % 52(@)(@@) % و البعد عن بابكم ظالم % % وهذه قصة مظلوم % % 53(@)(@@) % لا زلت ملثوم الثرى شائدا % % أركان مجد غير مثلوم % % 54(@)(@@) % في الصوم والفطر أخا غبطة % % وموسم بالعز موسوم % % PageV01P1783 البحر : - 1(@)(@@) % الحمد لله على إنعامه % % واصل للدين فضل حكامه % % 2(@)(@@) % من والد في العلى ومن ولد % قد جاء عن علمه وأعلامه % % 3(@)(@@) % لو لم يكن في علومه ملكا % ما زيد تاجا شعار أيامه % % 4(@)(@@) % مراتب الشرع أو علائمه % % قد توجت باسمه وأقلامه % % 5(@)(@@) % ليت العلائي تاج مصر رأى % % ذا التاج في مصر وفي شامه % % 6(@)(@@) % مكلل الوصف بالفرائد من % % صاغة حلى القريض نظامه % % 7(@)(@@) % وابن علي عال لنجم سما % % فهو على الأفق تاج بهرامه % % 8(@)(@@) % عربي محض العلى عمائمه % % تيجان أخواله وأعمامه % % 9(@)(@@) % ينفح عن راحتيه نشر ندى % % كأنما الزهر حشو أكمامه % % 10(@)(@@) % ذو البيت حج الرجا اليه ومن % % عسفان دهر ميقات إحرامه % % PageV01P1784 11(@)(@@) % إلى حمى علمه وأنعمه % % لكل سامي الطلاب مستامه % % 12(@)(@@) % لطالب الجود ملء رغبته % % وطالب العلم ملء أفهامه % % 13(@)(@@) % و شائع الاسم عند خنصره % % وسامع الفضل عند ابهامه % % 14(@)(@@) % حسبك بيت الانصار تبصر من % % دعا لنصر قديم إقدامه % % 15(@)(@@) % عبية خير الورى التي سلمت % % من بيت ذي قولة ومن ذامه % % 16(@)(@@) % أقلام أثباتهم كأنصلهم % % حمى لدين الهدى واسلامه % % 17(@)(@@) % علي يا ذا الفقار من قلم % % يقد قد العادي بأرغامه % % 18(@)(@@) % دم واحدا للعلوم يعجبه % % من التصانيف أنس أحلامه % % 19(@)(@@) % تسخو لنا بالعيان وابن دقي % % ق العيد طيف يسخو بألمامه % % 20(@)(@@) % مباركا حيث كان حامله % % عيون غيد فتور إسقامه % % PageV01P1785 21(@)(@@) % في كل يوم له وليل دجى % % سباق صوامه وإقدامه % % 22(@)(@@) % كأن جنح الدجى يمد يدا % من الثريا للمس أقدامه % % 23(@)(@@) % نعم وهنئت دهر سيدنا % % قاضي قضاة الزمان حكامه % % 24(@)(@@) % مثلك في نسكه وسؤدده % % مطهر في جميع أقسامه % % 25(@)(@@) % أحكامه الزهر وهي واصلة % % بالحق أيدي أسباب إعظامه % % 26(@)(@@) % الله وهاب عبده شرفا % وفره فيه قسم 
ms395	 قسامه % % 27(@)(@@) % و أسرة جانسوا اذا حكموا % % إكراه عدل القضا بإكرامه % % 28(@)(@@) % يا آل سبك الخلاص مجدهم % % نطقتم الشعر بعد إفحامه % % 29(@)(@@) % أحلامكم قد زكت وحاسدكم % % بين كرى همه وأوهامه % % 30(@)(@@) % نام وسرتم شتان حينئذ % % ما بين أحلامكم وأحلامه % % PageV01P1786 31(@)(@@) % غايات قوم مبدا سريكم % في رتب الفضل بين أقوامه % % 32(@)(@@) % يهدي له المدح في نفائسه % % والذخر من دره نجا تامه % % 33(@)(@@) % و ما عسى ذوي المديح تحمل من طيبه % % طيبة في الثنا وتمامه % % 34(@)(@@) % إلى سري فتاق السراة وما % % زيد نبات الفلا كقلامه % % 35(@)(@@) % مالروض يروي شذا النسيم لنا % % صحائحا من حديث نمامه % % 36(@)(@@) % أعبق من ذكره ولا عبق المس % % ك المسمى أقل خدامه % % 37(@)(@@) % ولا حيا السحب في تراكمها % % بالودق تسخو طلال تسجامه % % 38(@)(@@) % عن ابن عباسها الدجون روت % % والبرق يروي عن ابن بسامه % % 39(@)(@@) % أسمح منه بما حوته يده % % في يومه والسحاب في عامه % % 40(@)(@@) % ولا بحار الطوفان طائفة % % كالبحر في صدره وأكمامه % % PageV01P1787 41(@)(@@) % ولا ولا أو يعود قائلها % % من بعد إفصاحه كتمتامه % % 42(@)(@@) % خذها نباتية المدائح من % % جائد فكر القريض همامه % % 43(@)(@@) % سابق مداحكم وأجدرهم % % بأن تبدا إعدام اعدامه % % 44(@)(@@) % لازال مهدي اليتيم من درر ال % % مدح يراكم ثمال أيتامه % % 45(@)(@@) % سام وحام الثنا لكم صحفا % وجاء في سامه وفي حامه % % PageV01P1788 البحر : - 1(@)(@@) % يفدي كرام الحمى منكم كرائمه % % ويعبق الروض إن ولت كمائمه % % 2(@)(@@) % با آل تغلب لا يغلب تصبركم % % صرف الزمان ولا تزهب عظائمه % % 3(@)(@@) % ليس النفائس مما تأسفون بها % % ولا التثبت منقوض عزائمه % % 4(@)(@@) % ولا تلوم ولو فاضت جفونكم % % على المصاب الذي انقضت حوائمه % % 5(@)(@@) % فأكرم الدمع ما سحت بوادره % % من الوفاء وما انهلت سواجمه % % 6(@)(@@) % إناالى الله من رزء براحلة % بكى لها الحرم الأقصى وقادمه % % 7(@)(@@) % وبئر زمزم قد هاجت مدامعها % % وبيت وائل قد ماجت دعائمه % % 8(@)(@@) % إن لم تزاحم بأولاها لها نسيبا % فقد غدت بمساعيها تزاحمه % % 9(@)(@@) % قريبة كل عن أوصاف رتبتها % % سجع الفتى وهو منشي القول ناظمه % % 10(@)(@@) % و أوحشت صدر محراب 
ms396	 بفقد حلا % كأنها دمعة مما تلازمه % % PageV01P1789 11(@)(@@) % ما خص مأتم أهليها بل اتفقت % % في كل باب من التقوى مآتمه % % 12(@)(@@) % فلو بكت سور القرآن من أسف % % لانهل جفن النسا مما تكاتمه % % 13(@)(@@) % و لو أطافت بنات النعش لا بتدرت % % تنافس النعش فيها أو تساهمه % % 14(@)(@@) % و لو درى القبر من وافاه لاحتفرت % % من السرور بلا كف معالمه % % 15(@)(@@) % إن يغد روضا فقد ارسى بجانبه % % غيث الدموع وقد جادت غمائمه % % 16(@)(@@) % و هب من طي مثواه نسيم ثنا % يود نشر الغوالي لو يقاسمه % % 17(@)(@@) % وزيد في الحور ذي حجب ممنعة % % يمسي ورضوان في الجنات خادمه % % 18(@)(@@) % مضى لأخصب من أوطانه وقضى % % فما على الدمع لو كفت سوائمه % % 19(@)(@@) % هو الحمام الذي خففت قدرته % % فكيف تنكر أمرا أنت عالمه % % 20(@)(@@) % لايفتأ الليل أن ترمى كواكبه % % نبلا ولا الصبح أن تنضى صوارمه % % PageV01P1790 21(@)(@@) % بينا الفتى رافع الآمال خافضها % % اذ انتحى من صروف الدهر حازمه % % 22(@)(@@) % ان يمس ربعك قد راعت نواعيه % % فطالما صدحت أنسا حمائمه % % 23(@)(@@) % و ان يكن بيت صبري قد ألم به % % عدي دهر فقد سلاه حاتمه % % 24(@)(@@) % لا تجزعن أبا العباس من خطر % عداك فالوقت باكي الفكر باسمه % % 25(@)(@@) % و ذاهب بات طرف الخير ذا سهر % % عليه وهو قرير الطرف نائمه % % 26(@)(@@) % ما ضره في مطاوي الأرض منزلة % % وأنت دافنه والله راحمه % % PageV01P1791 البحر : - 1(@)(@@) % بكى لك العاليان القدر والهمم % % و الماضيان سنان الرأي والقلم % 2(@)(@@) % و الوقت أغيد في أعطافه ميد % % و العز أصيد في عرنينه شمم % % 3(@)(@@) % و العقل يثني عليه الركب وا أسفا % للعقل يثني عليه الأنيق الرسم % % 4(@)(@@) % و الفضل ما بين موروث ومكتسب % % فحبذا هو نعت لازم وسم % % 5(@)(@@) % يا غائبا أظلمت دار لغيبته % % وهكذا البدر تدجو بعده الظلم % % 6(@)(@@) % يا من يعز علينا أن نفارقهم % % وجداننا كل شيء بعدكم عدم % % 7(@)(@@) % رحلت عن عادمي صبر وما قدروا % % أن لا تفارقهم فالراحلون هم % 8(@)(@@) % من للرئاسة فيها الجد أجمعه % % وللسياسة فيها الصفح والنقم % % 9(@)(@@) % من للوقار 
ms397	 أمام الحجب يحجبه % % وللفخارأمام الشهب يبتسم % % 10(@)(@@) % من للسطور على صحف معذرة % % تكاد بالقلب قبل الثغر تلتثم % % PageV01P1792 11(@)(@@) % من للحمى كف سار كف قاصده % % سرا وجهرا فلا عرب ولا عجم % 12(@)(@@) % مضى وغير عجيب أن يقال مضى % % فانما هو عضب الملة الخذم % % 13(@)(@@) % نح يا حمام مع الباكي على غصن % % رطب وقف بجمى لم يعفه القدم % % 14(@)(@@) % أذكرتنا فقد يحيى يا محمده % % وللجراح على آثارها ألم % % 15(@)(@@) % ماذا تركت لأرض الشام من أسف % % إذا تذكرت الأنساب والشيم % % 16(@)(@@) % ماذا تركت بمصر من حقيق جوى % % ياذا الشبيبة حتى آذها الهرم % 17(@)(@@) % لهفي على واحد في العزم منفرد % % كانت تقر لمسعى سعده الأمم % % 18(@)(@@) % لهفي على قلم يهتز ثابته % % في مهرق خافق الأعلام قد علموا % % 19(@)(@@) % عطلت هذا وهذا إذ رحلت وقد % % خاب الرجاء فلا بان ولا علم % % 20(@)(@@) % لهفي على أسطر سار البريد بها % % تحت الظلام وفيها الكلم والكلم % % PageV01P1793 21(@)(@@) % و الخيل والليل والبيداء شاهدة % % والضرب والطعن والقرطاس والقلم % % 22(@)(@@) % لهفي على بيت فضل كان من زنة % % في الشمل وهو كبيت الشعر منتظم % % 23(@)(@@) % رماه بالنقص والاحزان حرف ردى % % مغير فهو منقوص ومنثلم % % 24(@)(@@) % لهفي على البدر منكم يا بني عمر % % لا تستطيع نداه الأنجم الخدم % % 25(@)(@@) % هوت معاليه حيث العمر مقتبل % والسعد جار وأكناف العلى حرم % % 26(@)(@@) % و الوجه ريان من ماءي حيا وضيا % حتى يكاد على الأعطاف ينسجم % % 27(@)(@@) % مازال للسر قبر في جوانحه % % حتى أتى القبر والأسرار تزدحم % % 28(@)(@@) % بمثله يفخر الملك العقيم على % % ماض وأن النسا عن مثله عقم % % 29(@)(@@) % عمري لقد صرخ الناعون في رجب % فأسمع النوح شجوا من به صمم % % 30(@)(@@) % و بالغ الحزن فينا ثم صبرنا % % أن الطريق إلى أحبابنا أمم % PageV01P1794 31(@)(@@) % مضى الأنام على هذا وساق بهم % % حادي الردى وسنمضي نحن أثرهم % 32(@)(@@) % و المرء في الأصل فخار ولا عجب % % ان راح وهو بكف الدهر منحطم % % 33(@)(@@) % و للمنية فخ من هلال دجى % % شهب البزاة سواء فيه والرخم % % 34(@)(@@) % قل للذي هزمت شحا 
ms398	 كتائبه % % هل فاته من جيوش الموت منهزم % % 35(@)(@@) % سقى ضريحك رضوان ولا برحت % % تنهل نافعة في تربك الديم % % 36(@)(@@) % حتى تنور أرض أنت ساكنها % % نورا ونورا ويزهى القاع والأكم % % 37(@)(@@) % ودام للناس باقي البيت ينشده % % اذا سلمت فكل الناس قد سلموا % % PageV01P1795 البحر : - 1(@)(@@) % سقى زمان الصبا يا منزل الهرم % % دم من الدمع أو دمع من الديم % % 2(@)(@@) % يا نيل مصر ودمعي لا يحل بكما % % عهد الوفاءين من جار ومنسجم % % 3(@)(@@) % كراحتي علم الدين الأمير اذا % % لاقي الرجا بمضي البشر مبتسم % % 4(@)(@@) % ذو الرأي والعزم والهيجاء مسبعة % % والعلم والحلم والمعروف والكرم % % 5(@)(@@) % وفارس الجيش كالعنوان تقدمه % % والصف كالسطر والخطي كالعلم % % 6(@)(@@) % أكرم به وأبيه قبلة فلقد % % توارثا شيما ناهيك من شيم % % 7(@)(@@) % نصرت في حرب أيامي بهم فأنا % % في جنة تحت ظل السيف والقلم % % PageV01P1796 البحر : - 1(@)(@@) % بانت سعاد حقيقة % % مني وما رعت العصم % % 2(@)(@@) % و شقيت بالأولاد بع % % ضهم لكلي قد قصم % % 3(@)(@@) % لولا ندى قاضي القضا % % ة لوائق القصد انفصم % % 4(@)(@@) % هنئت شهرا بامتدا % % حك فيه قد سمع الأصم % % 5(@)(@@) % يا من به لاذ الفق % % ير من الفواقر واعتصم % % 6(@)(@@) % ياذا الرغائب من نوا % % لك لا أصوم ولم أصم % % 7(@)(@@) % خصمي من الأولاد جا % % ر وأنت أولى من خصم % % PageV01P1797 البحر : - 1(@)(@@) % أصبحت بعد تطاول الأيام % % قلبي بموضع قالبي بالشام % % 2(@)(@@) % ان مت من حزن فان بني قد % % ماتوا بشامهم من الاعدام % % 3(@)(@@) % يا للوزيرين اللذان هماهما % % لا ترحماني وارحما أيتامي % % 4(@)(@@) % من لي بحملهم على عيني فما % % لي نحو حملهم على أقدامي % % 5(@)(@@) % فيكون جبركما لقلبي جبرهم % % فهم على كل الوجوه عظامي % % 6(@)(@@) % يا عصمة لأرامل وثمال أي % % تام بقيتم عصمة الاسلام % % 7(@)(@@) % أقسمت لولا جاهكم ونوالكم % % أصبحت لا خلفي ولا قدامي % % PageV01P1798 البحر : - 1(@)(@@) % يا ابن الأولى اتخذوا السماء مطامحا % لغريمهم ونجومها خداما % % 2(@)(@@) % لله أنت فما أبر مكارما % للشائمين وما أجل مقاما % % 3(@)(@@) % أنت الذي أحيي المآثر بعد ما % % أمست عظام المأثرات عظاما % % 4(@)(@@) % نعم الشهاب اذا تمرد مارد 
ms399	 % من عسرة لاقى لديك حماما % % 5(@)(@@) % لك همة تسع الفضاء ورتبة % % لا تستطيع لها النجوم مراما % % 6(@)(@@) % ومكارم ما لاح بشرك بارقا % إلا استهلت للوفود غماما % % 7(@)(@@) % وفضائل في الروض أودع نشرها % % فترى النسيم لسائل نماما % % 8(@)(@@) % ذلت لعزتها الفرائد في الحلى % % عجزا ولا عجب لذل يتامى % % 9(@)(@@) % ويراعة حمر الإهاب كأنها % % ألف تقد إذا غضبت اللاما % % 10(@)(@@) % وتواضع كالشمس دان ضوءها % % والقدرأرفع رتبة ومراما % % PageV01P1799 11(@)(@@) % هي عادة من فضل بيتكم الذي % % خلقت مناقبه الحسان تماما % % 12(@)(@@) % سبحان من عم البلاد ببركم % % في كل معضلة وخص الشاما % % 13(@)(@@) % هنئت بالعيد السعيد ودمت ذا % % قدر توقل ما اشتهى وتسامى % % 14(@)(@@) % قالت صفاتك للأنام دعوا العلى % % ذا ما يخالف في البرية ذاما % % 15(@)(@@) % وغدا الغمام يخاطب الكرم الذي % % يجود فقلنا للغمام سلاما % % PageV01P1800 البحر : - 1(@)(@@) % أهلا وسهلا بك من قادم % % له المعالي والأيادي الجسام % % 2(@)(@@) % قد ساقك الله إلى جلق % % لما درى حاجتها للغمام % % 3(@)(@@) % يا من به تسقى غوادي الحيا % % ويدرأ البأس ويشفى السقام % % 4(@)(@@) % لا تلم الدهر على نقلة % فقد تنقلت لأشهى مقام % % 5(@)(@@) % وحيثما يممت من منزل % فانه الدنيا وأنت الأنام % % PageV01P1801 البحر : - 1(@)(@@) % تصبر فإن الأجر أسنى وأعظم % % ورأيك أهدى للتي هي أقوم % % 2(@)(@@) % وكم جاز فرط الحزن للمرء لم يفد % % فما بالنا لا نستفيد ونأثم % % 3(@)(@@) % وإني عن ندب الأحبة ساكت % وإن كان قلبي بالأسى يتكلم % % 4(@)(@@) % أعزيك في غصن ذوى قبل ماارتوى % % وقامت به ورق الثنا تترنم % % 5(@)(@@) % على مثل هذا عاهد الدهر أهله % % وصال وتفريق يسر ويؤلم % % 6(@)(@@) % وان منع الغياب أن يقدموا لنا % % فإنا على غيابنا سوف نقدم % % PageV01P1802 البحر : - 1(@)(@@) % ابن لي بيضاء حلت لواطيء % بغير نكاح تستحل به الحما % % 2(@)(@@) % على أنها ذات العبادة والتقى % % تروق للدنيا وللدين كل ما % % 3(@)(@@) % وتنمى بلا ثان لها عن فخارها % % إلى سادة يا طيب فخر ومنعما % % 4(@)(@@) % وأحرفها خمس فان أسقطوا لها % % ثلاثا غدت عشرا اذا المرء أعجما % % 5(@)(@@) % اذا عرضت أعمالها كل ليلة % % على ربها صلى عليها 
ms400	 وسلما % % PageV01P1803 البحر : - 1(@)(@@) % نعم الامام الذي بالخصب شملها % % ممالكا وأناسيا وانعاما % % 2(@)(@@) % يا واحد العصران علما وان كرما % هنئت بالدهر ان شهرا وان عاما % % 3(@)(@@) % وبالأهلة أمثال الشفاه دنت % % للثم كف تعم الخلق إنعاما % % 4(@)(@@) % تهدي السعود إلى بحر العلوم فما % % يلام زورقها في البحر إن عاما % % 5(@)(@@) % لا زلت بالحال أهنا ما أكون به % % وقبلها كنت للأحوال أنعى ما % % PageV01P1804 البحر : - 1(@)(@@) % يا فاضلا قد عنى لرتبته % % جالب در الثنا وناظمه % % 2(@)(@@) % مااسم نحيف بال كأن على % % أحشائه صبوة تلازمه % % 3(@)(@@) % يبكي على الوصل وهو واجده % % وليس يبكيه وهو عادمه % % 4(@)(@@) % قل فيه ما شئت ان حذفت وان % % حرفت يا من لسنا نقاومه % % PageV01P1805 البحر : - 1(@)(@@) % يا وليا رجوته لولاه % % عند دار الدنا ودار السلام % % 2(@)(@@) % حبذا كوثر الجنان ورضوا % % ن أناديه يا مضيف الكرام % % 3(@)(@@) % إسقني شربة ألذ عليها % % واسق بالله مثلها ابن هشام % % PageV01P1806 البحر : - 1(@)(@@) % أمولانا الوزير تهن عيدا % سعيدا وابق ذا عز وعزم % % 2(@)(@@) % ولا زلت هباتك بالضحايا % % وبالأشغال قائمة برسمي % % 3(@)(@@) % تبلغني قمامة كل يوم % % وتجعل فيه بيتي بيت لحم % % PageV01P1807 البحر : - 1(@)(@@) % يا سيدا صرف عني العنا % % بفعله المعرب أو باسمه % % 2(@)(@@) % شكرا لجود لازم للثنا % % كدوم روح المرء مع جسمه % % 3(@)(@@) % لولاه أصبحت فتى شاعرا % يبكي من الجود على رسمه % % PageV01P1808 البحر : - 1(@)(@@) % أبا البقاء أطال الله في نعم % % لك البقاء وفضلا ليس نعدمه % % 2(@)(@@) % يا من له نسب عالي السنا وحمى % رحب ومدح كوشي الروض نرقمه % % 3(@)(@@) % ما أحسن البيت من علياك متسقا % أثني عليه وآويه وأنظمه % % PageV01P1809 البحر : - 1(@)(@@) % سادتي كم أتشكى % % لحلي يتغمم % % 2(@)(@@) % صرت من وهمي تيسا % للمراعي يتشمم % % 3(@)(@@) % ماله في الشام مرعى % % فدعوه يتقمم % % PageV01P1810 البحر : - 1(@)(@@) % كم تمسكت بممدوحين في % % حلب رفدهما لي ما عدم % % 2(@)(@@) % فبمشكور ين محمود مضى % % وبمحمودين مشكور قدم % % PageV01P1811 البحر : - 1(@)(@@) % فضلت السعيد واستاذه % % بنظميهما وبنثريهما % % 2(@)(@@) % وكانا عتيقي فخار حويت % % فكنت الأحق بارثيهما % % PageV01P1812 البحر : - 1(@)(@@) % سقي ابن هشام في الثرى نوء رحمة % تجر على مثواه ذيل غمام 