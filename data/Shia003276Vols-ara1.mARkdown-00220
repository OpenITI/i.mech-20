ms217	 غالب العباداني عن الربيع بن صبيح وعدة وعنه عباد الغبري وعباس الترقفي لم يضعف. ق (@)(@@)(@@)(@@) $ 2905 -(@)(@@) عبد الله بن غنام البياضي صحابي عنه عبد الله بن عنبسة. د (@)(@@)(@@)(@@) $ 2906 -(@)(@@) عبد الله بن فروخ عن مولاته عائشة وأبي هريرة وعنه شداد أبو عمار وأبو سلام ممطور ثقة. م د (@)(@@)(@@)(@@) $ 2907 -(@)(@@) عبد الله بن فروخ عن طلحة مولاه وعثمان وعنه ابنه إبراهيم وطلحة بن يحيى صدوق. س (@)(@@)(@@)(@@) $ 2908 -(@)(@@) عبد الله بن فروخ بالمغرب عن هشام ابن عروة وابن عون وعنه سعيد بن أبي مريم PageV01P584(@)(@@) وجماعة قال سعيد: هو أرضى أهل الأرض عندي وقال البخاري: تعرف وتنكر توفي 175. د (@)(@@)(@@)(@@) $ 2909 -(@)(@@) عبد الله بن فضالة الليثي عن أبيه وعنه الحرب بن أبي الأسود. د (@)(@@)(@@)(@@) $ 2910 -(@)(@@) عبد الله بن الفضل بن العباس بن ربيعة الهاشمي عن أنس والأعرج وعنه ابن الماجشون ومالك وزياد بن سعد. ع (@)(@@)(@@)(@@) $ 2911 -(@)(@@) عبد الله بن فيروز الديلمي المقدسي عن أبيه وابن مسعود وعدة وعنه ربيعة القصير ويحيى السيباني ثقة. د س ق (@)(@@)(@@)(@@) $ 2912 -(@)(@@) عبد الله بن فيروز الداناج بصري عن أنس وأبي رافع الصائغ وعنه همام وابن علية ومن رفاقه قتادة. خ م د س ق (@)(@@)(@@)(@@) $ 2913 -(@)(@@) عبد الله بن القاسم مولى الصديق عن جابر وابن عباس وعنه فضيل بن غزوان وقرة بن خالد وثق حب. د (@)(@@)(@@)(@@) $ 2914 - عبد الله بن القاسم عن ابن أبزى وابن المسيب وعنه ابن شوذب قال ابن معين: ليس به بأس. ت PageV01P585(@)(@@)(@@)(@@) $ 2915 -(@)(@@) عبد الله بن أبي قتادة السلمي أبو إبراهيم عن أبيه وعنه المقبري ويحيى بن أبي كثير مات 95. ع (@)(@@)(@@)(@@) $ 2916 -(@)(@@) عبد الله بن قدامة العنبري أبو السوار عن أبي برزة وعنه توبة العنبري وثقه النسائي. س (@)(@@)(@@)(@@) $ 2917 -(@)(@@) عبد الله بن قرط الثمالي أمير حمص صحابي عنه غضيف وسليم بن عامر وعدة قتل سنة 56. د س (@)(@@)(@@)(@@) $ 2918 - عبد الله بن قريش البخاري عن أبي مسهر وطبقته وعنه أبو داود وغيره. د(@)(@@)(@@)(@@) $ 2919 -(@)(@@) عبد الله بن قيس أبو موسى الأشعري ولي زبيد وعدن للنبي صلى 
ms218	 الله عليه وسلم وولي الكوفة والبصرة لعمر عنه بنوه: أبو بكر وأبو بردة وإبراهيم وموسى قال ابن بريدة: كان قصيرا خفيف اللحم أثط مناقبه مشهورة توفي 44 بخلف. ع (@)(@@)(@@)(@@) $ 2920 -(@)(@@) عبد الله بن قيس بن مخرمة المطلبي عن أبي هريرة وجماعة وعنه ابناه: محمد ومطلب وأبو بكر بن حزم ولي العراق قبل الحجاج أياما وولي قضاء المدينة. م 4 (@)(@@)(@@)(@@) $ 2921 -(@)(@@) عبد الله بن قيس أبو بحرية الكندي السكوني الحمصي عن عمر ومعاذ وعنه خالد بن معدان ويونس بن ميسرة وعدة ولي غزو الصائفة لمعاوية وبقي إلى زمن الوليد. 4 (@)(@@)(@@)(@@) $ 2922 -(@)(@@) عبد الله بن قيس النخعي عن الحارث بن أقيش وعنه داود بن أبي هند. ق (@)(@@)(@@)(@@) $ 2923 -(@)(@@) عبد الله بن قيس أو ابن أبي قيس أبو الأسود النصري الحمصي عن أبي ذر وعائشة وعنه PageV01P586(@)(@@) يزيد بن خمير ومعاوية بن صالح صدوق. م 4 (@)(@@)(@@)(@@) $ 2924 -(@)(@@) عبد الله بن كثير الزرقي المدني عن أبيه وسعد بن سعيد المقبري وعنه عباس العنبري والزبير بن بكار شيخ. ق * - عبد الله بن كثير بن المطلب السهمي عن شيخ وعنه ابن جريج لم يصح وصوابه: عبد الله بن أبي مليكة واسم شيخه: محمد بن قيس. م س (@)(@@)(@@)(@@) $ 2925 -(@)(@@) عبد الله بن كثير الداري أبو معبد مقرئ مكة عن ابن الزبير و عبد الرحمن بن مطعم PageV01P587(@)(@@) ومجاهد وعنه ابن جريج وابن أبي نجيح وشبل بن عباد وجرير بن حازم ثقة فصيح مفوه إمام توفي 120. ع (@)(@@)(@@)(@@) $ 2926 -(@)(@@) عبد الله بن كعب بن مالك السلمي عن أبيه وأبي أيوب وعدة وعنه ابنه عبد الرحمن وإخوته والزهري توفي 97. خ م د س ق (@)(@@)(@@)(@@) $ 2927 -(@)(@@) عبد الله بن كعب الحميري عن عمر بن أبي سلمة وأبي بكر بن عبد الرحمن وعنه عبد ربه بن سعيد وابن إسحاق ثقة. م س (@)(@@)(@@)(@@) $ 2928 -(@)(@@) عبد الله بن كنانة بن عباس بن مرداس في دعاء عرفة عن أبيه وعنه عبد القاهر بن السري قال البخاري: لم يصح حديثه. د ق PageV01P588(@)(@@)(@@)(@@) $$$ * -(@)(@@) عبد الله بن كنانة عن ابن 
ms219	 عباس وعنه ابنه هشام حديثه مضطرب. س PageV01P589(@)(@@)(@@)(@@) $ 2929 -(@)(@@) عبد الله بن كيسان أبو عمر عن مولاته أسماء وابن عمر وعنه عطاء وابن جريج قال أبو داود: ثبت. ع (@)(@@)(@@)(@@) $ 2930 -(@)(@@) عبد الله بن كيسان المروزي أبو مجاهد عن سعيد بن جبير وعكرمة وعنه السيناني وعلي بن الحسن بن شقيق ضعفه أبو حاتم. د (@)(@@)(@@)(@@) $ 2931 -(@)(@@) عبد الله بن كيسان مولى طلحة عن عبد الله بن شداد والمقبري وعنه موسى بن يعقوب وثق. ت (@)(@@)(@@)(@@) $ 2932 -(@)(@@) عبد الله بن أبي لبيد أبو المغيرة المدني عن أبي سلمة والمطلب بن عبد الله وعنه السفيانان ثقة. خ م د س ق (@)(@@)(@@)(@@) $ 2933 -(@)(@@) عبد الله بن لحي أبو عامر الهوزني الحمصي عن عمر ومعاذ وبلال وعنه راشد بن سعد وأزهر الحرازي ثقة. د س ق (@)(@@)(@@)(@@) $ 2934 -(@)(@@) عبد الله بن لهيعة أبو عبد الرحمن الحضرمي الفقيه قاضي مصر عن عطاء والأعرج وابن أبي مليكة وعمرو بن شعيب وعنه يحيى بن بكير وقتيبة والمقرئ ضعف وقال أبو داود: سمعت أحمد يقول: من كان مثل ابن لهيعة بمصر في كثرة حديثه وإتقانه وضبطه؟. قلت: العمل على تضعيف حديثه توفي 174. د ت ق PageV01P590(@)(@@)(@@)(@@) $ 2935 -(@)(@@) عبد الله بن مالك أبو تميم الجيشاني هاجر من اليمن زمن عمر وسمع منه ومن علي وتلا على معاذ وعنه بكر بن سوادة وكعب بن علقمة وعدة وكان من العابدين مات 77.(@)(@@) م ت س ق.(@)(@@)(@@)(@@) $ 2936 -(@)(@@) عبد الله بن مالك ابن بحينة وبحينة أمه مطلبية من السابقين عنه حفص بن عاصم والأعرج ومحمد بن يحيى بن حبان توفي مع عائشة تقريبا. ع (@)(@@)(@@)(@@) $ 2937 -(@)(@@) عبد الله بن مالك عن علي وابن عمر وعنه أبو إسحاق وأبو روق الهمداني شيخ. د ت (@)(@@)(@@)(@@) $ 2938 -(@)(@@) عبد الله بن مالك بن حذافة عن أمه وعنه كثير بن فرقد. د س (@)(@@)(@@)(@@) $ 2939 -(@)(@@) عبد الله بن مالك له صحبة عنه شبل بن خليد. س (@)(@@)(@@)(@@) $ 2940 -(@)(@@) عبد الله بن مالك اليحصبي عن عقبة بن عامر وعنه أبو سعيد جعثل الرعيني قال ابن يونس:(@)(@@) هو أبو 
ms220	 تميم الجيشاني. 4 (@)(@@)(@@)(@@) $ 2941 -(@)(@@) عبد الله بن المبارك بن واضح أبو عبد الرحمن الحنظلي مولاهم المروزي شيخ خراسان عن سليمان التيمي وعاصم الأحول والربيع بن أنس وعنه ابن مهدي وابن معين وابن عرفة فأبوه تركي مولى تاجر وأمه خوارزمية ولد سنة 118 وتوفي بهيت 181 في رمضان ع. PageV01P591(@)(@@)(@@)(@@) $ 2942 -(@)(@@) عبد الله بن المثنى بن عبد الله بن أنس بن مالك أبو المثنى عن عمومته والحسن وعنه ابنه محمد ومسدد و عبد الواحد بن غياث قال أبو حاتم: صالح وقال أبو داود: لا أخرج حديثه.(@)(@@) خ ت ق.(@)(@@)(@@)(@@) $ 2943 -(@)(@@) عبد الله بن أبي المجالد عن ابن أبي أوفى مولاه و عبد الرحمن بن أبزى وعنه أبو إسحاق الشيباني وشعبة ثقة وسماه شعبة محمدا فوهم. خ د س ق(@)(@@)(@@)(@@) $ 2944 -(@)(@@) عبد الله بن محرر العامري قاضي الجزيرة عن نافع والزهري وعنه عبد الرزاق وأبو نعيم.(@)(@@) قال البخاري: منكر الحديث. ق (@)(@@)(@@)(@@) $ 2945 -(@)(@@) عبد الله بن محصن الأنصاري اختلف في صحبته عنه ابنه سلمة. ت ق * - عبد الله بن محصن عن عمته وعنه بشير بن يسار. صوابه حصين. س. [= 1131].(@)(@@)(@@)(@@) $ 2946 -(@)(@@) عبد الله بن محمد بن أبي شيبة الحافظ أبو بكر العبسي مولاهم الكوفي صاحب التصانيف عن شريك وابن المبارك وهشيم وعنه البخاري ومسلم وأبو داود وابن ماجة وأبو يعلى والباغندي قال الفلاس: ما رأيت أحفظ منه وقال صالح جزرة: هو أحفظ من أدركنا عند المناظرة.(@)(@@) توفي 235. سوى ت (@)(@@)(@@)(@@) $ 2947 -(@)(@@) عبد الله بن محمد بن إسحاق أبو عبد الرحمن الأذرمي عن هشيم وجرير وعنه أبو داود PageV01P592(@)(@@) والنسائي وابن صاعد قال أبو حاتم: ثقة. د س (@)(@@)(@@)(@@) $ 2948 -(@)(@@) عبد الله بن محمد بن أسماء الضبعي عن عمه جويرية وجعفر بن سليمان وعنه البخاري ومسلم وأبو داود وأبو يعلى قال أحمد الدورقي: لم أر بالبصرة أفضل منه توفي 231. خ م د س(@)(@@)(@@)(@@) $ 2949 -(@)(@@) عبد الله بن محمد بن أبي الأسود: حميد أبو بكر البصري الحافظ عن مالك وديلم بن غزوان وخاله عبد الرحمن بن مهدي وعنه البخاري وأبو 