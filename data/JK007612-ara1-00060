ms41	 لباسه % % وفي شكله يا بعد ما يقع الشكل % % 10(@)(@@) % فما كل جنس تحته النوع داخل % % ولا كل ما أبصرت من شجر نخل % % PageV01P185 11(@)(@@) % ولن تفعل الأقوام مثل فعاله % % ولا سائر الذبان ما تفعل النحل % % 12(@)(@@) % وما جل هذا الناس إن تبلهم أبو % % علي حيسن أوأبو طيب سهل % % 13(@)(@@) % أيا ناقة بلغتنيه محرم % % عليك السرى لا بل على ظهرك الرحل % % 14(@)(@@) % ألا يهنىء الشيخ الموفق إنه % % فتاه ولولا الفرع ما شرف الأصل % % 15(@)(@@) % تشابهتما فضلا ومجداص فلم يبن % % أألأصل أزكى في القياس أم النسل % % 16(@)(@@) % كذا الدهر يقضي في عداهم وفيهم % % بنجم لهم يهوي ونجم لهم يعلو % % PageV01P186 البحر : منسرح 1(@)(@@) % يا ملك الشرق عمدة الدول % % ويا علا المكرمات لا الحيل % % 2(@)(@@) % يا أسد الملك لا الغياض ويا % % سيف السنا والسناء لا الخلل % % 3(@)(@@) % ويا سحاب العقيان لا بلل القطر % % عقاب الملوك لا الحجل % % 4(@)(@@) % أصبح منك الزمان في وجل % % ومن نداك الغمام في خجل % % 5(@)(@@) % طلعت للناس مبتدا أمل % % وللمعادين منتهى أجل % % 6(@)(@@) % بنت لك المكرمات منزلة % % اسس أركانها على زحل % % 7(@)(@@) % فامدد إلى الشعريين منك يدا % مخلوقة للعطاء والقبل % % 8(@)(@@) % إذا همت راحتاتك يوم ندى % % فالغيم والبحر نطفتا وشل % % 9(@)(@@) % وإن طمى عسكراك يوم ردى % % فالسيل والليل واردا فشل % % 10(@)(@@) % يا من يرى الحرب منتحى قنص % % والضرب والطعن مجتنى عسل % % PageV01P187 11(@)(@@) % % وأسمائه مدى الطول % % 12(@)(@@) % فانكدر النجم دون ظنك بي % % وانتقل الفرض دون أمرك لي % % 13(@)(@@) % ومن سمت في العلاء همته % % يخطب ما خطبت من قبلي % % 14(@)(@@) % لا جرم اجتبت كل مخترق % % فيه وأدخلت كل مدخل % % 15(@)(@@) % وشمت دون السيوف سيف فمي % % لا ذا عمى ولا شلل % % 16(@)(@@) % فسفت بالقلب أين أنت الصدر وبالصدر % % فقد سار سائر المثل % % 18(@)(@@) % والصارم النافذ الشبا الجراز % % ز المقاطع الحد غير منتصل % % 21(@)(@@) % والكفصل السيف هو من فصل % % صل العظم إذ قده على عجل % % 24(@)(@@) % وفي السيوف الكهام هو الذي % % يفتك لكن بالقرع والبصل % % 25(@)(@@) % وفي السيوف المجذ والجد معن % % نى سواء في الرعب 
ms42	 والوجل % % PageV01P188 26(@)(@@) % وقد يقال المهز وهو الذي % % يهتز كالغصن ساعة العمل % % 27(@)(@@) % وهو مقد إن خاض في مفرق الرأس % % مقط لها من الكفل % % 28(@)(@@) % ثم القساسي وهو منتسب % % إلى قساس مدينة العمل % % 29(@)(@@) % % قالوا من الريف عذبة الحلل % % 30(@)(@@) % والأبرص السيف لا سواد به % % كأنه شعلة من الشعل % % 31(@)(@@) % والأبيض السيف راع منظره % % كأنه من سناك في حلل % % 32(@)(@@) % والمرهف السيف رق جانبه % % حتى كأني أعرته غزلي % % 33(@)(@@) % والمبعج السيف واللسان له % % رأس طويل كهامة الأسل % % 35(@)(@@) % % القاطع العظم عند مقتتل % % 36(@)(@@) % وقد يسمونه المطبق وهو % % و الضارب العظم ساعة الوهل % % PageV01P189 38(@)(@@) % % والقضب ما لم يقف على فلل % % 39(@)(@@) % وبعض أسمائه المذكر وه % % إن رمت علمه فسل % % 40(@)(@@) % تلك سيوف شفارها ذكر % % من عمل الجزيرة النمل % % 41(@)(@@) % والباهر السيف نور منظره % % يبهر نور العيون والمقل % % PageV01P190 البحر : طويل 1(@)(@@) % وأحور ساجي الطرف أغرى بي الضنى % % والمفصل السيف وهو من ف % PageV01P191 البحر : مجزوء الكامل 1(@)(@@) % يا شادنا لو لم تكن % % شفتاه للأسنان ذيلا % % 2(@)(@@) % ما إن رأيت ولا رأى % % أحد من العشاق ليلا % % PageV01P192 البحر : رجز تام 1(@)(@@) % مرت بنا وعينها % % من سكرها منخزله % % 2(@)(@@) % ذات جفون ضعفت % % كمذهب المعتزله % % 3(@)(@@) % وظاهر يروعه % % وباطن لا أصل له % % PageV01P193 البحر : كامل تام 1(@)(@@) % منه كدور عمامتي شكلا % % وترى الضرير لشكلها مثلا % % 2(@)(@@) % والمنحنى ظهرا يماثلها % % ومع الزيارة يثني أصلا % % 3(@)(@@) % وترى البلاد لها مقاربة % % والقين يفعل تحتها فعلا % % 4(@)(@@) % هذا إذا ما نونها انقلبت % % مأوى الطيور وبيتها العلى % % PageV01P194 البحر : مجزوء الوافر 1(@)(@@) % أحاجيكم وليس لكم % % بما حاجيت من قبل % 2(@)(@@) % بدر صين في صدف % % وفي خلل وفي كلل % % 3(@)(@@) % وإن عطلت أوله % % فموردة من الحيل % % 4(@)(@@) % وإن حليت آخره % % فهيج البحر كالقلل % % 5(@)(@@) % وإن قوست قامته % % رأيت حليلة الرجل % % 6(@)(@@) % وإن تضم له شفة % % تعطلها من الحلل % % 7(@)(@@) % فعند الله ليس له % % مبادي الشكل والمثل % % 8(@)(@@) % وإن شئنا لطولنا % % وأخينا مدى الطول % % PageV01P195 البحر : متقارب تام 1(@)(@@) % أيا جامع المال من حله % % يبيت ويصبح في ظله 
ms43	 % % 2(@)(@@) % سيؤخذ منك غدا كله % % وتسأل من بعد عن كله % % PageV01P196 البحر : مجزوء الكامل 1(@)(@@) % يا معجبا مرح العنان % % يجر في الخيلاء ذيله % % 2(@)(@@) % أقصر فإنك ميت % % يهدي الفناء إليك سليه % % PageV01P197 البحر : وافر تام 1(@)(@@) % دخلت على الرسول وكان غثا % % ثقيل الروح ذا حمق وجهل % % 2(@)(@@) % وأقسم أنه لو كان أيرا % لكان على أبي نصر بن سهل % % PageV01P198 البحر : طويل 1(@)(@@) % أقول لإحدى المضلات العظائم % % وبالود أني قاعد غير قائم % % 2(@)(@@) % أعزيك لا فعل اختيار ولا رضى % % ولكن على رغمي ورغم المكارم % % 3(@)(@@) % ألا بكر الناعي بأن أجحف الردى % % بأخضر مما أنبت المجد ناعم % % 4(@)(@@) % ووافق يوم المهرجان نعيه % % لنا فزجنا فيه طير الأشائم % % 5(@)(@@) % فلا جرم اعتضنا من الخز حزنه % % وسرنا حفاة حسرا في المآتم % % 6(@)(@@) % على هين من نفس من سار صاغر % ومجتدع من أنف من ساد راغم % % 7(@)(@@) % فإن ترعني سمع القبول فإنني % % أعزى فلا أهدا لصيحة خادم % % 8(@)(@@) % وإن كنت فيما ناب من حادث الردى % % أقل مصابا منك يا نقص ماتم % % 9(@)(@@) % تأمل من الدنيا القليل متاعها % % وما نحن فيه غير أحلام حالم % % 10(@)(@@) % وفكر رويدا هل يعدون سالما % إلى آدم أم هل يرون ابن سالم % % PageV01P199 11(@)(@@) % فإن كنت مخصوصا فحق لك الأسى % % وإلا فلا ترفض جميل العزائم % % 12(@)(@@) % فنحن لما أفضى إليه بموعد % % وريش الذنابى تابع للقوادم % % PageV01P200 البحر : وافر تام 1(@)(@@) % ومضطغين على الألباب قاس % % يرى ويقول بالرأي القديم % % 2(@)(@@) % يحدث عن أب فأب مجوس % % إلى هابيل كالليل البهيم % % 3(@)(@@) % أبوه أخوه وهو أخو بنيه % % ولا السيران قدا من أديم % % 4(@)(@@) % له في النور والظلمات عقد % % بطيء الحل ممنوع الأديم % % 5(@)(@@) % تخير من أديم الحزن أرضا % عذاة الترب طيبة الأروم % % 6(@)(@@) % وعرش فوقنا فالطرف فيها % % يسير على صراط مستقيمم % % 7(@)(@@) % وحصنها بعيدان طوال % % وزينها بقضبان الكروم % % 8(@)(@@) % وحاز لها من الأنهار فحلا % فاهداها إلى كفؤ كريم % % 9(@)(@@) % فأولدها بنين ولم تخنه % % وربت لائم فيها مليم % % 10(@)(@@) % وأقبل ربها يسعى إليها % % وفض الختم عن صافي الحميا % % PageV01P201 11(@)(@@) % فأبصر 
ms44	 غلمة كالصبح بيضا % لهن وغلمة مثل الصريم % % 12(@)(@@) % فصعر خده غضبا عليها % % وزناها ببهتان عظيم % % 13(@)(@@) % وقال أغلمه سود وبيض % % لفحل واحد يا للزنيم % % 14(@)(@@) % أجابته الكروم وقلن كلا % % ولكن صنع ذي العرش العظيم % % 15(@)(@@) % قضى بسواد ذاو بياض هذا % % كما ولد الصبيح من الدميم % % 16(@)(@@) % فقال جزى العواهر ما جزاها % % وسمن كل جانيه ظلوم % % 17(@)(@@) % ألم ترضين أن تزنين حتى % % تماريتن في علم النجوم % % 18(@)(@@) % وجرد مدية كاماء ابقيت % % على أوداجها أثر الكلوم % % 19(@)(@@) % فما ارعى على أم ثكول % % ولا أبقى على ولد يتيم % % 20(@)(@@) % وجاء بهن أمثال السبايا % % على لونين من حبش وروم % % PageV01P202 21(@)(@@) % فداس بطونهن بركل علج % % أشق كظل شيطان رجيم % % 22(@)(@@) % فسالت بالدم الأنهار حتى % % تركن القاع أحمر كالأديم % % 23(@)(@@) % ولما أن قضى الأوطار منها % % وميزت الدماء من اللحوم % % 24(@)(@@) % أشار بحبسها لتزيد غما % على ما حملته من الغموم % % 25(@)(@@) % فأودعها من المغشى سموما % تطابق تحت أعراق النجوم % % 26(@)(@@) % فوافاها من النجدين شيخ % % ترى ما لا ترى عين النديم % % 27(@)(@@) % فقص عليه قصة ما أجابت % % وقال ولم تدعها كالهشيم % % 28(@)(@@) % حلفت لنشربن دم الزواني % % وننتصرن للدين القديم % % 29(@)(@@) % % ورد الطين في داني النسيم % % 30(@)(@@) % ولما ذاقها والطعم مر % % وقوس الظهر ظاهرة الوضوم % % PageV01P203 31(@)(@@) % أعادت سنه جذعا وردت % % ضراءة ذلك العظم الرميم % % 32(@)(@@) % وجازته عن السوءى بحسنى % % فيا لله للطبع الكريم % % 33(@)(@@) % وفتيان كمجتمع الثريا % % على طرف من العيش الرخيم % % 34(@)(@@) % يساقهم من الفتيان أحوى غضيض % % الطرف كشح هضيم % % 35(@)(@@) % تنادوا للمدام وعنفوني % % وقالوا هاك حظك من نعيم % % 36(@)(@@) % فقلت أخاف عقباها ولكن % % أشيعكم إلى باب الجحيم % % PageV01P204 البحر : مجزوء الكامل 1(@)(@@) % يا لمة ضرب الزمان % % على معرسها خيامه % % 2(@)(@@) % لله درك من خزامى % % مى روضة عادت ثغامه % % 3(@)(@@) % فوربه قامت به % % للدين أشراط القيامه % % 4(@)(@@) % لمضرج بدم النبو % % ة ضارب بيد الإمامه % % 5(@)(@@) % متقسم يطأ السيو % % ف مجرعا منها حمامه % % 6(@)(@@) % منع الورود وماؤه % % منه على طرف الثمامه % % 7(@)(@@) % نصب ابن هند راسه % % فوق الورى نصب العلامه 
ms45	 % % 8(@)(@@) % ومقبل كان النبي % % بلثمه يشفي غرامه % % 9(@)(@@) % قرع ابن هند بالقضيب % % غراره فرط استضامه % % 10(@)(@@) % وشدا بنغمته عليه % % وصب بالفضلات جامه % % PageV01P205 11(@)(@@) % والعدل أبلج ساطع % % والدين ذو خال وشامه % % 12(@)(@@) % يا ويح من ولى الكتا % % ب قفاه والدنيا أمامه % % 13(@)(@@) % ليضرسن يدا الندا % % حين لا تغني الندامة % % 14(@)(@@) % وليدركن على الكرمة % % مة سوء عاقبة الغرامه % % 15(@)(@@) % وحمى أباح بنو يزيد % د عن طوائلهم حرامه % % 16(@)(@@) % حتى اشتفوا من يوم بد % % واستبدوا بالزعامة % % 17(@)(@@) % لعنوا أمير المؤمني % % ن بمثل إعلان الإقامه % % 18(@)(@@) % لم لم تخري يا سما % % ء ولم تصبي يا غمامه % % 19(@)(@@) % يا لعنة صارت على % % أعناقهم طوق الحمامه % % 20(@)(@@) % إن الإمامة لم تكن % % للئيم ما تحت العمامه % % PageV01P206 21(@)(@@) % يا سبط هند وابنها % % دون البتول ولا كرامه % % 22(@)(@@) % يا عين جودي للبقي % % ع وما به تشفى رغامه % % 23(@)(@@) % جودي لمشهد كربلاء % % ء فوفري عني ذمامه % % 24(@)(@@) % جودي بمكنون الدموع % % وأرسلي بددا تهامه % % PageV01P207 البحر : وافر تام 1(@)(@@) % إمامي لا يعادله إمام % % تواضع تحت رايته الأنام % % 2(@)(@@) % يزيد الخير والسامي أبوه % % أقاما الخلق طرا فاستقاموا % % 3(@)(@@) % فمن يك لائمي في حب رهطي % % فإني في ولائي لا ألام % 4(@)(@@) % ومن يفخر بآل أبي تراب % % فآلي من أمية والسلام % % PageV01P208 البحر : رجز تام 1(@)(@@) % يا آل عصم أنتم أولو العصم % لم توسموا إلا بنيران الكرم % % 2(@)(@@) % لا ينزع الله سرابيل النعم % % عنكم فلا تخطوا بها دون الأمم % % 3(@)(@@) % طابت مبانيكم وطبتم لا جرم % % يا سادة السيف وأرباب القلم % % 4(@)(@@) % تهمي سجاياكم بعقبان ودم % % أنتم فصاح ما خلا في لا ولم % % 5(@)(@@) % الجار والعرض لديكم في حرم % % والمال للآمال نهب مقتسم % % 6(@)(@@) % أنتم أسود المجد لا أسد الأجم % % يا سيدا نيط له بيت القدم % % 7(@)(@@) % بالعمد الأطول والفرع الأشم % % هل لك أن تعقد في بحر الشيم % % 8(@)(@@) % عارفة تضرم نارا في علم % % ويقصر الشكر عليها قل نعم % % 9(@)(@@) % أما وإنعمك إنه قسم % % وثغر مجد في معاليك ابتسم % % 10(@)(@@) % إنك في الناس كبرء في سقم % % يا 
ms46	 فرق ما بين الوجود والعدم % % PageV01P209 11(@)(@@) % وبعدما بين الموالي والخدم % % ما أحد كهاشم وإن هشم % % 12(@)(@@) % ولا امرؤ كحاتم وإن حتم % % ليس الحدوث في المعالي كالقدم % % 13(@)(@@) % ولا شباب النبت فيها كالهرم % % شتان ما بين الذنابى والقمم % % PageV01P210 البحر : هزج 1(@)(@@) % تعالى الله ما شاء % % وزاد الله إيماني % % 2(@)(@@) % أأفريدون في التاج % % أم الاسكندر الثاني % % 3(@)(@@) % أم الرجعة قد عادت % % إلينا بسليمان % % 4(@)(@@) % أظلت شمس محمود % % على انجم سامان % % 5(@)(@@) % وأسى آل بهرام % % عبيدا لابن خاقان % % 6(@)(@@) % إذا ما ركب الفيل % % لحرب أو لميدان % % 7(@)(@@) % رأت عيناك سلطانا % على منكب شيطان % % 8(@)(@@) % أمن واسطة الهند % % إلى ساحات جرجان % % 9(@)(@@) % ومن قاضية السند % % إلى أقصى خراسان % % 10(@)(@@) % على مقتبل العمر % % وفي مفتتح الشان % % PageV01P211 11(@)(@@) % لك السرج إذا شحت % % على كاهل كيوان % % 12(@)(@@) % يمين الدولة العقبى % % لبغداد وغمدان % % 13(@)(@@) % وما يعقد بالمغرب % % ب عن طاعتك اثنان % % 14(@)(@@) % إذا شءت ففي أمن % % وفي يمن وإيمان % % PageV01P212 البحر : رمل تام 1(@)(@@) % لا ولا لا لست من قدرته % % لم ترض نفسي على هذا الهون % % 2(@)(@@) % من رجال الخمر واللهو أنا % % لست للحزن ولا للولهان % % PageV01P213 البحر : سريع 1(@)(@@) % لو كان بالدهر لحر يدان % % أغراه من همتي إلا تكلاان % % 2(@)(@@) % وذاده عن خطتي صاغرا % بد الغرارين حديد السنان % % 3(@)(@@) % إن يك من ذي أمل هجرة % % جائرة الكف ظلوم البنان % % 4(@)(@@) % نثرت من نرجستي روضة % % على جنى الورد عقدي جمان % % 5(@)(@@) % مؤكد من حرج أو ضمان % % على الليالي ؤصرؤف الزمان % % 6(@)(@@) % إن لم تعقلك باحد اثها % % ولم تجرعك بمر الهوان % % 7(@)(@@) % قال وقد راش بها دلها % % كما انثنى تحت الصبا غصن بان % % 8(@)(@@) % ضرب من الذل ونوع من النعمة % % مة تفطن له الخيزران % % 9(@)(@@) % إنك يا ذا العزمات التي % % يسرن والشمس شريكتي عنان % % 10(@)(@@) % تدرع من عزمك ثوب المنى % % والدهر منا سبعة في ثمان % % PageV01P214 11(@)(@@) % عني باعوالك يا هذه % % لست لخود بمطيع العنان % % 12(@)(@@) % لايجهل البازل سنا ولا % % أعلم الخمرة إني عوان % % 13(@)(@@) % لي غلوة اخرى فان اورقت % % كسرت قوسي 
ms47	 وهشمت البنان % % 14(@)(@@) % منحة إن أخلفت بغيتي % % جرعت باسي واكلت اللسان % % 15(@)(@@) % وغزوت ان خففت مطلبي % % أغمدت سيفي ونزعت السنان % % 16(@)(@@) % يا ملك الدهر ويا من له % % واسطة الدست وصدرت المكان % % 17(@)(@@) % ومنتضى الصارم يجري دما % والقلم الماطر يجري بيان % % 18(@)(@@) % هل أنت إلا رجل واحد % % افرغ في قالبه الأجودان % % 19(@)(@@) % أم انت الا ملك مكرم % % اظهره الله لراي العيان % % 20(@)(@@) % لهذه العزة حيث الفلا % % قد عفت أرضي وتركت الهوان % % PageV01P215 21(@)(@@) % كما اقتضيت الدهر ميعاده % % 22(@)(@@) % يا ملك الدهر الذي خلتني % % ظلت من الدهر في امان % % 23(@)(@@) % انظر إلى الخطب الذي اغتالني % % هل أثر يلقى له أو عيان % % 24(@)(@@) % ان بك منذي امل هجرة % % إلى مجال قبله هجرتان % % 25(@)(@@) % وكل هذا وذاك الحمى % % وبعض هذا وبك المستعان % % PageV01P216 البحر : رمل تام 1(@)(@@) % ويك يا دهر لحا % % الله ما اعظم شانك ! % 2(@)(@@) % ساكت أنت وما اك % % باللغو لسانك % % 3(@)(@@) % قصر الله عن الأح % % رار والمجد عنانك % PageV01P217 البحر : - 1(@)(@@) % ليل الصبا ونهاره سكران % % حدثان لم يدركهما حدثان % % 2(@)(@@) % يا زفرة لي لا يكاد أزيزها % % يسع الضلوع إليك يا همذان % 3(@)(@@) % قسما لقد فقد الفراق بي امرأ % ليست تجود برده البلدان % 4(@)(@@) % يا دهر إنك لا محالة مزعجي % % عن خطتي ولكل دهر شان % % 5(@)(@@) % فاعمد براحلتي هراة فإنها % % عدن وأنت رئيسها عدنان % % PageV01P218 البحر : وافر تام 1(@)(@@) % فلا يثقل عليك أذى عدو % يهب إليك مثل الكلب عاوي % % 2(@)(@@) % فكم من روضة رضت الأعادي % % فعاد العود منها وهو ذاو % PageV01P219 البحر : متقارب تام 1(@)(@@) % مدحت الأمير وأيامه % % فضاءت وجوه وسيئت وجوه % % 2(@)(@@) % وهل يجحد الشمس إلا العمي % وهل يعرف الفضل إلا ذووه % % PageV01P220 البحر : - 1(@)(@@) % أقضي العمر تشبيها % % على الناس وتمويها % % 2(@)(@@) % أرى الأيام لا تبقى % % على حال فأحكيها % % 3(@)(@@) % فيوم شرها في % % ويوم شرتي فيها % % PageV01P221 البحر : وافر تام 1(@)(@@) % كذا من شام بارقة الثنايا % % وغر بما تمنيه الصبايا % % 2(@)(@@) % فأدنى ما يعن له الدواهي % % وأيسر ما يلم به الرزايا % % 3(@)(@@) % أظاعنة ولما أحظى منها % % لتغريني من الوجد 
ms48	 السرايا % % 4(@)(@@) % أجاعلة المواعد لي نقودا % وتاركة الوفاء بها سنايا % % 5(@)(@@) % وعدت زيارة وقعدت عنها % % وأوسعت المنى ليا ولا يا % % 6(@)(@@) % فقي لا بر أيسر من سلام % % أتدخرينني حتى التحايا % % 7(@)(@@) % بروج شاخصات أم حدوج % % وأفلاك طوالع أم مطايا % % 8(@)(@@) % وراقته الملاح فلم يبيت % % روية حازم فيصيب رايا % % 9(@)(@@) % وقد أتبعتها نظرا غليظا % إلى أن جزت أسنمة السبايا % % 10(@)(@@) % فلا سقيت ندا تلك الثنايا % % ولا وقيت ردى تلك النجايا % % PageV01P222 11(@)(@@) % ورين جوانحا فأرين نكرا % أرى بحرا وأمتاح الركايا % % 12(@)(@@) % وفي الأظعان لو رحموا أسارى % % تفديها وأفئدة سبايا % % 13(@)(@@) % غدت بشعوبهم نفسي شعاعا % % وقلبي في تشطيهم شظايا % % 14(@)(@@) % إذا ما عددت بكر الغدايا % % زممت إليك آمالي عجافا % 15(@)(@@) % فلا يوم كيومك حين بانوا % % ولا ليل كليلة جرجرايا % % 16(@)(@@) % نزلت عن الأسرة والحشايا % % وقلت وقد تلاحقت المطايا % % 17(@)(@@) % لك الخيرات إن حاولت دلا % ولي الويلات إن أزمعت نايا % % 18(@)(@@) % وما أحظى من الحسناء إلا % % بما يحظى الشجي من الخلايا % % 19(@)(@@) % وإن يك حظه منهن حظا % أعرني فضل عارفة وفضلا % 20(@)(@@) % تطير أن رأت رأسي خضيبا % وتحت غلائل الخطر البلايا % % PageV01P223 البحر : متقارب تام 1(@)(@@) % أيا من تعرض للداهيه % % ولم يتلزم سنن العافيه % % 2(@)(@@) % سيأتي الفضاء فلا تأته % % ولا تقعدن على القافيه % % 3(@)(@@) % ويا من يلم به نكبة % % وألطاف خالقه خافيه % % 4(@)(@@) % سيلبسها سابغا ضافيا % ويشربها عذبة صافيه % % 5(@)(@@) % وليس الغنى أن يقول الغني % % عقاري وداري وأمواليه % % 6(@)(@@) % ولا أسرج الطرف لي يا غلام % % ولا نضدي الفرش يا جاريه % % 7(@)(@@) % ولكنها غير ما عنده % % من الله وافية واقيه % % PageV01P224 البحر : رجز تام 1(@)(@@) % وكلني بالهم والكآابة % % طعانة لعانة سبابه % 2(@)(@@) % للسلف الصالح والصحابه % % أساء سمعا فأساء جابه % % 3(@)(@@) % تأملوا يا كبراء الشيعة % % لعشرة الإسلام والشريعه % % 4(@)(@@) % أتستحل هذه الوقيعة % % في تبع الكفر وأهل البيعه % % 5(@)(@@) % فكيف من صدق بالرساله % % وقام للدين بكل آله % % 6(@)(@@) % واحرز الله يد العقبى له % % ذلكم الصديق لا محاله % 7(@)(@@) % إمام من أجمع في السقيفة % % قطعا عليه إنه الخليفه % 8(@)(@@) % ناهيك 
ms49	 من آثاره الشريفه % % في رده كيد كيد بني حنيفه % % 9(@)(@@) % سل الجبال الشم والبحارا % % وسائل المنبر والمنارا % % 10(@)(@@) % واستعلم الآفاق والأقطار م % % أظهر الدين بها شعارا % % PageV01P225 11(@)(@@) % ثم سل الفرس وبيت النار % % من الذي فل شبا الكفار % % 12(@)(@@) % هل هذه البيض من الآثار % إلا لثاني المصطفى في الغار % 13(@)(@@) % وسائل الإسلام من قواه % وقال إذ لم تقل الأفواه % 14(@)(@@) % واستنجر الوعد فأومى الله % % من قام لما قعدوا إلا هو % % 15(@)(@@) % ثاني النبي في سني الولاده % % ثانيه في القبر بلا وساده % % 16(@)(@@) % أتأمل الجنة يا شتامه % % ليست بمأواك ولاكرامه % 17(@)(@@) % إن امرأ أنثى عليه المصطفى % % ثمت والاه الوصي المرتضى % % 18(@)(@@) % واجتمعت على معاليه الورى % % واختاره خليفة رب العلا % % 19(@)(@@) % واتبعته امة الأمي % وبايعته راحة الوصي % 20(@)(@@) % وباسمه استسقى حيا الوسمي % % ما ضره هجو الخوارزمي % PageV01P226 21(@)(@@) % سبحان من لم يلقم الصخر فمه % % ولم يعده حجرا ما أحلمه % % 22(@)(@@) % يا نذل يا مأبون أفطرت فمه % % لشد ما اشتاقت إليك الحطمه % % 23(@)(@@) % إن أمير المؤمنين المرتضى % % وجعفر الصادق أوموسى الرضى % % 24(@)(@@) % لو سمعوك بالخنا معرضا % % ما ادخروا عنك الحسام المنتضى % % 25(@)(@@) % ويلك لم تنجو يا كلب القمر ؟ % ما لك يا مأبون تغتاب عمر % 26(@)(@@) % سيد من صام وحج واعتمر % % صرح بالحادك لا تمشي الخمر % % 27(@)(@@) % يا من هجا الصديق والفاروقا % % كيما يقيمة عند قوم سوقا % % 28(@)(@@) % نفخت يا طبل علينا بوقا % % فما لك اليوم كذا موهوقا ؟ % 29(@)(@@) % إنك في الطعن على الشيخين % % والقدح في السيد ذو النورين % % 30(@)(@@) % لواهن الظهر سخين العين % % معترض للحين بعد الحين % % PageV01P227 31(@)(@@) % هلا شغلت باستك المغلومة % % وهامة تحملها ميشومه % % 32(@)(@@) % هلا نهتك الوجنة الموشومه % % عن مشتري الخلد ببئر رومه % % 33(@)(@@) % كغى من الغيبة أدنى شمه % % من استجاز القدح في الأئمه % % 34(@)(@@) % ولم يعظم أمناء الأمه % فلا تلوموه ولوموا أمه % 35(@)(@@) % ما لك يا نذل وللزكيه % عائشة الراضية المرضيه ؟ % 36(@)(@@) % يا ساقط الغيرة والحمية % % ألم تكن للمصطفى حظيه ؟ % 37(@)(@@) % من مبلغ عني الخوارزميا % % يخبره أن ابنه عليا % % 38(@)(@@) % قد اشترينا 
ms50	 منه لحمانيا % % بشرط أنيفهمنا المعنيا % % 39(@)(@@) % يا أسد الخلوة خنزير الملا % % ما لك في الجري تقود الجملا % % 40(@)(@@) % يا ذا الذي يثلبني إذا خلا % % وفي الخلا أطعمه ما في الخلا % % PageV01P228 41(@)(@@) % وقلت لما احتفل المضمار % % واحتفت الأسماع والأبصار % % 42(@)(@@) % سوف ترى إذا انجلى الغبار % أفرس تحتي أم حمار % PageV01P229 
