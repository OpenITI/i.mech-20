ms241	 % % رداء الحلم ودرعت سفاها % % 35(@)(@@) % أحين أظلها سلم الليالي % % و قلناقد تجنبها أذاها % % 36(@)(@@) % رماها بالتي عظمتو لكن % % أصاب قلوبنا لما رماها % % 37(@)(@@) % فمال بمعشر عرر إليها % % و مال بنا إلى أخرى سواها % % 38(@)(@@) % أراذل ليس تحمي الأسد غيلا % كما تحمي روائحها حماها % % 39(@)(@@) % عراة في الجنائب لا تبالي % % أصد العار عنها أم عراها % % 40(@)(@@) % لهتناأن نلم بساحتيها % % رياح إن سطت أردت سطاها % % PageV01P906 41(@)(@@) % و أمواه لو ان الترب يشكو % % مجاورة الأذى يوما شكاها % % 42(@)(@@) % فلو غسلت بماء المزن منهم % % و ماء البحر لم يطهر ثراها % % 43(@)(@@) % يحن الطائر الموفي عليها % % و توسع كل ماشية خطاها % % 44(@)(@@) % سلام الله منك على رباع % نأت أحبابهاو دنت عداها % % 45(@)(@@) % و طيبة النسيم عدت علينا % % جنائبهاو عادتنا صباها % % 46(@)(@@) % و كافورية البنيان تثني % % على من خطهاأو من بناها % % 47(@)(@@) % محلقة يكل الطرف عنها % % إذا ما الطرف حاول منتهاها % % 48(@)(@@) % تضيء إذا الدجى اشتملت عليها % % فتحسبها مؤلقة دجاها % % 49(@)(@@) % بعثت الطرف مشتاقا إليها % % فكاد يرده عنها سناها % % 50(@)(@@) % و حببها إليو إن تولت % % مآرب بلغت نفسي مناها % % PageV01P907 51(@)(@@) % لقد كانت جلاء العين حسنا % فعادت وهي من قبح قذاها % % 52(@)(@@) % عقاب الدهر بقياه عليها % % و عفو الدهر عنها لو عفاها % % 53(@)(@@) % فيا نوب الخطوب إليك عنها % % كفاها ما ألم بهاكفاها % % PageV01P908 البحر : - 1(@)(@@) % سألت الله مما كان عفوا % و عدت بتوبة تركتك نضواحذف % % 2(@)(@@) % محوت صحائف اللذات لما % % محوت بها سطور الزفن محواحذف % % 3(@)(@@) % فأضمر نايك الحنان هما % و أعلن صنجك الصياح شكوى حذف % % 4(@)(@@) % و كم للقصف من طلل محيل % تأبد منك منزلهفأقوى حذف % % 5(@)(@@) % تحن إليك حانة باطر تحى % % و يبكي الزندرود عليك شجوى حذف % % 6(@)(@@) % أحقا عاد طعم العيش مرا % و كان بزفنك المرموق حلواحذف % % 7(@)(@@) % و جف قضيبه المياس رقصا % و طار هزاره الغريد شأواحذف % % 8(@)(@@) % أفارسأنت أحسن من تثنى % % على صنج وأملح من تلوى حذف % % 9(@)(@@) % أصيب العيش منك بخير حاد % يحث ركائب الصهباء حدواحذف % % 10(@)(@@) % إذا اختلجت مناكبه لرقص % نزت 
ms242	 طير القلوب إليه نزواحذف % % PageV01P909 11(@)(@@) % أعاد حكاية الشيخين جدا % و كان حكاهما لعبا ولهواحذف % % 12(@)(@@) % فأصبح زفنه لغة وشعرا % و أمسى عزفه جدلا ونحواحذف % % 13(@)(@@) % يخف به رواة عنه علما % زلالا إن سقانا منه أروى حذف % % 14(@)(@@) % فمقتبس من المصباح نورا % و مغترف من التيار صفواحذف % % 15(@)(@@) % فلا يبعد زمان منك عادت % % مواهبه على الفتيان بلوى حذف % % 16(@)(@@) % ليال بالمعازف منك تنضى % % و أيام بحث الراحتطوى حذف % % 17(@)(@@) % قعدت وكم نهضت إلى التصابي % % بنقر الدف توسع فيه خطواحذف % % 18(@)(@@) % فأظهرت الزمانة في زمان % حززت به من اللذات عضواحذف % % PageV01P910 البحر : - 1(@)(@@) % غدا تبدي مدامعنا الخفايا % % إذا زمت لطيبتها المطايا % % 2(@)(@@) % وقفنا نحمد العبرات لما % % رأينا البين مذموم السجايا % % 3(@)(@@) % كأن خدودهنإذا استقلت % شقيق فيه من طل بقايا % % 4(@)(@@) % و قد فوقن بالألحاظ نبلا % قلوب العاشقين لها رمايا % % 5(@)(@@) % تمنينا اللقاءفكان حتفا % و كم أمنية جلبت منايا % % 6(@)(@@) % أرى الآفاق قد ملئت سرورا % بتغليب الأمير أبي السرايا % % 7(@)(@@) % بمولود يراه الله ليثا % و غيثا يستهل على البرايا % % 8(@)(@@) % نجيب أنتجته كرام قوم % فجاء شبيههم حزما ورايا % % 9(@)(@@) % ثناي عليهم ما دمت حيا % ثناء المستهام على الثنايا % % 10(@)(@@) % كأني بالأمير وقد بلاه % يكشف زائدا عنه البلايا % % PageV01P911 11(@)(@@) % و قطع أنفس الحساد غيظا % بسؤددهفطيرها شظايا % % 12(@)(@@) % و أصبحت الدروع له شفوفا % خفافا و السروج له حشايا % % 13(@)(@@) % إذا ما سابق الأكفاء يوما % إلى الغايات خلفهم رزايا % % 14(@)(@@) % يجور على التليد إذا استميحت % % أنامله ويعدل في القضايا % % 15(@)(@@) % حياة المجد أن يحياو تفني % % أعاديه الحوادث والرزايا % % 16(@)(@@) % فقللأبي المظفر قد ظفرنا % % بما نرجو لديك من العطايا % % 17(@)(@@) % فضلت فكنت بحرا حين كانوا % % ثمادا يستمد من الركايا % % 18(@)(@@) % و لولا الفضل لم نشعر بنقص % و لولا النسك لم تبر الخطايا % % 19(@)(@@) % و من يهد الحيا لرياض حمد % يفز منها بألطاف الهدايا % % 20(@)(@@) % كما جاد السحاب الجود أرضا % فأبرز من محاسنها الخبايا % % PageV01P912 21(@)(@@) % و قد جاءت مدائحنا نقودا % فلا تجعل جوائزها نسايا % % PageV01P913 البحر : - 1(@)(@@) % تذكر أيامه الخالية 
ms243	 % % فما رقأت عبرة جاريه % % 2(@)(@@) % أقول لمعتكر الطرتين % من الغيث ملتهب الحاشيه % % 3(@)(@@) % على الربض المرتدي بالرياض % سجالك والبيعة الدانيه % % 4(@)(@@) % على طلعة الجد نغنى بها % % عن الصبح في الليلة الداجيه % % 5(@)(@@) % و حسناء لما يشن حسنها % % تقادم أعوامها الماضيه % % 6(@)(@@) % و مأهولة من تماثيلها % % إذا هي يوما غدت خاليه % % 7(@)(@@) % و ما منح الشمس شماسها % % و ما خبأ القس في الخابيه % % 8(@)(@@) % فسقيا لملعب غزلانها % % و أعظم رهبانها الباليه % % 9(@)(@@) % و ساحرة الطرف مطبوعة % على الظرف مقسمة شافيه % % 10(@)(@@) % و نقش عبير على وجنة % كما نقش الورد بالغاليه % % PageV01P914 11(@)(@@) % رباع تقنصت غزلانها % % و قارعت آسادها الضاريه % % 12(@)(@@) % إذا غنت الطير فيها ضحى % % حسبت القيان بها شاديه % % 13(@)(@@) % و إن راح رعيانها أطربتك % فواقد أولادها الثاغيه % % 14(@)(@@) % لقيت سروري بها كاملا % و صافحت كأسي بها وافيه % % 15(@)(@@) % فإن أرها سالما أستلم % % فوارع أركانها العاليه % % 16(@)(@@) % وأغش بحانة أترجة % أمت ثالث الدن والباطيه % % 17(@)(@@) % و يغمز كفي كف النديم % و يومض طرفي إلى الساقيه % % 18(@)(@@) % و أسبق بالشكر أولى الصلاة % و أثني العنان إلى الثانيه % % 19(@)(@@) % و أضرب بالفص وجه الثرى % % فإما علي وإما ليه % % 20(@)(@@) % فإن كنت للخلد ريحانة % فدعني أكن حطب الهاويه % % PageV01P915 21(@)(@@) % و إن كنت تدعو إلى مذهب % فإني إلى تركه داعيه % % PageV01P916 البحر : - 1(@)(@@) % قصدتك لم أرد رفدا وأنى % % يروم من الصفا العطشان ريا % % 2(@)(@@) % و كم من مانع جدواه بخلا % يكون بجاهه برا حفيا % % 3(@)(@@) % فكان لحاظك المكرور شزرا % و كان جوابك المفهوم عيا % % 4(@)(@@) % فلو أني امتدحتك مستميحا % سللت علي عضبا مشرفيا % % PageV01P917 البحر : - 1(@)(@@) % أما وأبيك لا أنساه تدمي % % مضارب سيفه البطل الكميا % % 2(@)(@@) % و برقا في أناملهإذا ما % % تألق فتح الورد الجنيا % % 3(@)(@@) % إذا ظمئت فراخ أبيك يوما % سقاها من رقاب القوم ريا % % 4(@)(@@) % و ان جرح الأخادع مطمئنا % كسا الأوداج ديباجا بهيا % % 5(@)(@@) % و لم أر مثله يدعى عقوقا % فيدعوه الورى برا حفيا % % PageV01P918 
