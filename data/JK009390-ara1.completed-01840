ms1829	 :(@)(@@) | 30 ( لله في كل ليلة من شهر رمضان عند الإفطار ألف ألف عتيق من النار ، فإذا كانت ليلة الجمعة أعتق في كل ساعة ألف ألف عتيق من النار ، كلهم قد استوجبوا النار ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@) PageV06P013(@)(@@)(@@)(@@) $ ( 16895 ) قال النبي :(@)(@@) | 30 ( لئن عشت لأخرجن اليهود والنصارى من جزيرة العرب حتى لا أدع فيها إلا مسلما ) )(@)(@@) ( حم م د ت ن ) و ابن الجارود وأبو عوانة ( حب ك ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16896 ) قال النبي :(@)(@@) | 30 ( لأنا بهم أو ببعضهم أوثق مني بكم أو ببعضكم ) )(@)(@@) ( ت ) غريب عن أبي هريرة رضي الله عنه قال : ذكرت الأعاجم عند رسول الله فقال : فذكره .(@)(@@)(@@)(@@) $ ( 16897 ) قال النبي :(@)(@@) | 30 ( لأن يلبس الرجل من ألوان شتى خير له من أن يستدين ما ليس عنده قضاؤه ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16898 ) قال النبي :(@)(@@) | 30 ( لأن أجالس قوما يذكرون الله من صلاة الغداة إلى طلوع الشمس أحب إلي مما طلعت عليه الشمس ، ولأن أذكر الله من صلاة العصر إلى غروب الشمس أحب إلي من أن أعتق ثمانية من ولد إسماعيل دية كل واحد منهم اثنا عشر ألفا ) )(@)(@@) ( ط ) و ابن السني في عمل يوم وليلة ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16899 ) قال النبي :(@)(@@) | 30 ( لأن أقعد مع أقوام يذكرون الله من بعد صلاة الفجر إلى أن تطلع الشمس أحب إلي من أن أعتق أربعة من بني إسماعيل ، دية كل رجل منهم اثنا عشر ألفا ، ولأن أقعد مع أقوام يذكرون الله من بعد صلاة العصر إلى أن تغرب الشمس أحب إلي من أن أعتق أربعة من بني إسماعيل دية كل رجل منهم اثنا عشر ألفا ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16900 ) قال النبي :(@)(@@) | 30 ( لأن يؤدب أحدكم ولده خير له من أن يتصدق كل يوم بنصف صاع على مساكين ) )(@)(@@) ( طب ك ) عن جابر بن سمرة رضي الله عنه .(@)(@@) PageV06P014(@)(@@)(@@)(@@) $ ( 16901 ) قال النبي :(@)(@@) | 30 ( لأن يؤدب أحدكم ولده خير له من أن يتصدق كل 
ms1830	 يوم له بصاع ) )(@)(@@) العسكري في الأمثال عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16902 ) قال النبي :(@)(@@) | 30 ( لأن أجهز نعلين في سبيل الله أحب إلي من أن أعتق ولد زنا ) )(@)(@@) ( حم ) و ابن منده ( كر ) عن ميمونة بنت سعد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16903 ) قال النبي :(@)(@@) | 30 ( لأن يأخذ أحدكم حبله ثم يأتي هاذا الجبل فيحتطب حزمة من حطب فيأكل به خير له من أن يسأل الناس أعطوه أو منعوه ) )(@)(@@) ابن راهويه ( ض ) عن حكيم بن حزام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16904 ) قال النبي :(@)(@@) | 30 ( لأن يتصدق المرء في حياته بدرهم خير له من أن يتصدق بمائة درهم عند موته ) )(@)(@@) ( د حب و سمويه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16905 ) قال النبي :(@)(@@) | 30 ( لأن أصلي الصبح ثم أجلس في مجلس فأذكر الله عز وجل حتى تطلع الشمس أحب إلي من شد على جياد الخيل في سبيل الله ، من حين أصلي إلى أن تطلع الشمس ) )(@)(@@) البغوي والحسن بن سفيان والباوردي ( طب ) عن إياس بن سهل الأنصاري عن أبيه وما له غيره ( عب طب ض ) عن سهل بن سعد الساعدي ( طب ) عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16906 ) قال النبي :(@)(@@) | 30 ( لأن أقعد أذكر الله من طلوع الفجر إلى طلوع الشمس : أكبره وأحمده ، وأهلله ، وأسبحه أحب إلي من أن أعتق رقبة من ولد إسماعيل ، ولأن أذكر الله من بعد صلاة العصر إلى أن تغيب الشمس أحب إلي من أن أعتق أربع رقاب من ولد إسماعيل ) )(@)(@@) ( حم طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16907 ) قال النبي :(@)(@@) | 30 ( لأن أعطي أخا لي في الله درهما أحب إلي من أن PageV06P015 أتصدق بعشرة ، ولأن أعطي أخا لي في الله عشرة أحب إلي من أن أتصدق على مسكين بمائة ) )(@)(@@) ابن أبي الدنيا في كتاب الإخوان عن أبي جعفر رضي الله عنه معضلا .(@)(@@)(@@)(@@) $ ( 16908 ) قال النبي :(@)(@@) | 30 ( لأن أعطي أخا لي في الله درهما أحب إلي من أن أتصدق بعشرة ، ولأن أعطي أخا لي في الله 
ms1831	 عشرة أحب إلي من أن أعتق رقبة ) )(@)(@@) ابن أبي الدنيا بن يزيد بن عبد الله بن الشخير مرسلا .(@)(@@)(@@)(@@) $ ( 16909 ) قال النبي :(@)(@@) | 30 ( لأن يوتر أحدكم أهله وماله خير له من أن تفوته وقت صلاة العصر ) )(@)(@@) ( هب طب ) عن نوفل بن سعد عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 16910 ) قال النبي :(@)(@@) | 30 ( لأن تطهر خير لها ) )(@)(@@) ( حم ) عن مسعود بن العجماء أنه قال لرسول الله في المخزومية التي سرقت نفديها ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 16911 ) قال النبي :(@)(@@) | 30 ( لأن أصلي الصبح في جماعة أحب إلي من أن أصلي ليلة ، ولأن أصلي العشاء في جماعة أحب إلي من أن أصلي نصف ليلة ) )(@)(@@) ( هب ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16912 ) قال النبي :(@)(@@) | 30 ( لأن أحرس ثلاث ليال مرابطا من وراء بيضة المسلمين أحب إلي من أن تصيبني ليلة القدر في أحد المسجدين المدينة أو بيت المقدس ) )(@)(@@) أبو الشيخ عن أنس بن شاهين ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16913 ) قال النبي :(@)(@@) | 30 ( لأن يوسع أحدكم لأخيه في المجلس خير له من عتق رقبة ) )(@)(@@) ابن شاهين عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16914 ) قال النبي :(@)(@@) | 30 ( لأن يمتلىء جوف الرجل قيحا أو دما خير له من أن يمتلىء شعرا مما هجيت به ) )(@)(@@) ( ع عد ) عن جابر رضي الله عنه .(@)(@@) PageV06P016(@)(@@)(@@)(@@) $ ( 16915 ) قال النبي :(@)(@@) | 30 ( لأن يمتلىء جوف أحدكم من عانته إلى لهاته قيحا يتخضخض خير له من أن يمتلىء شعرا ) )(@)(@@) ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16916 ) قال النبي :(@)(@@) | 30 ( لأن يمتلىء ما بين لبتك إلى عانتك قيحا خير من أن يمتلىء شعرا ) )(@)(@@) ( طب ) عن مالك بن عمير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16917 ) قال النبي :(@)(@@) | 30 ( لأن يأكل أحدكم من جيفة حتى يشبع خير له من أن يأكل لحم أخيه المسلم ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16918 ) قال النبي :(@)(@@) | 30 ( لأن يكون في رأس رجل مشط من حديد حتى يبلغ العظم خير له من أن تمسه امرأة ليست له بمحرم ) )(@)(@@) ( هب ) عن 
ms1832	 معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16919 ) قال النبي :(@)(@@) | 30 ( لأن ألعق القصعة أحب إلي من أن أتصدق بمثلها طعاما ) )(@)(@@) الحسن بن سفيان عن رابطة عن أبيها .(@)(@@)(@@)(@@) $ ( 16920 ) قال النبي :(@)(@@) | 30 ( لأن أمرض على ساحل البحر أحب إلي من أن أصبح فأعتق مائة رجل ثم أجهزهم لهم في سبيل الله ) )(@)(@@) أبو الشيخ عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16921 ) قال النبي :(@)(@@) | 30 ( لأن تدعو أخاك المسلم فتطعمه وتسقيه أعظم لأجرك من أن تتصدق بخمسة وعشرين درهما ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16922 ) قال النبي :(@)(@@) | 30 ( لأن يمسك أحدكم يده عن الحصى في الصلاة خير له من أن يكون له مائة ناقة كلها سود الحدق ، فإن غلب أحدكم الشيطان فليمسح مسحة واحدة ) )(@)(@@) عبد بن حميد وسمويه ( ض ) عن جابر رضي الله عنه .(@)(@@) PageV06P017(@)(@@)(@@)(@@) $ ( 16923 ) قال النبي :(@)(@@) | 30 ( لأن أصلي الصبح ثم أقعد في مجلسي أذكر الله حتى تطلع الشمس أحب إلي مما تطلع عليه الشمس وتغرب ) )(@)(@@) ( عب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16924 ) قال النبي :(@)(@@) | 30 ( لأن أقدم سقطا أحب إلي من مائة مستلئم ) )(@)(@@) أبو عبيد في الغريب ( هب ) عن حميد بن عبد الرحمان الحميري مرسلا .(@)(@@)(@@)(@@) $ ( 16925 ) قال النبي :(@)(@@) | 30 ( لئن انتهيتم عندما تأكلون لتأكلن غير زراعين ) )(@)(@@) ( خ ) في تاريخه عن إسماعيل البجلي مرسلا .(@)(@@)(@@)(@@) $ ( 16926 ) قال النبي :(@)(@@) | 30 ( لئن بقيت أمرت بصيام يوم قبله أو يوم بعده يوم عاشوراء ) )(@)(@@) ( هب ) عن داود بن علي عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 16927 ) قال النبي :(@)(@@) | 30 ( لئن كنت كما قلت فكأنما تسفهم المل ، ولا يزال معك من الله ظهير عليهم ما دمت على ذالك ) )(@)(@@) ( م حب ) عن أبي هريرة أن رجلا قال : يا رسول الله إن لي قرابة أصلهم ويقطعوني قال : فذكره .(@)(@@)(@@)(@@) $ ( 16928 ) قال النبي :(@)(@@) | 30 ( لئن بقيت لا أدع بجزيرة العرب دينين ) )(@)(@@) ابن سعد عن عبيد الله بن عبد الله بن عتبة مرسلا .(@)(@@)(@@)(@@) $ ( 16929 ) قال النبي :(@)(@@) | 30 ( لئن كنت أحسنت القتال لقد أحسنه سهل بن حنيف وأبو دجانة سماك بن خرشة ) )(@)(@@) ( طب ك ) عن ابن 
ms1833	 عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16930 ) قال النبي :(@)(@@) | 30 ( لئن بلغت بنية العباس هاذه وأنا حي لأتزوجها ) )(@)(@@) قاله لأم حبيبة بنت العباس ( طب ) عن ابن عباس ( حم ) عن ابن عباس عن أمه PageV06P018 أم الفضل رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 16931 ) قال النبي :(@)(@@) | 30 ( لئن صدقت رؤياك لتلين أمر العامة بعدي ، ولتلين سنتين ) )(@)(@@) أبو نعيم عن عائشة رضي الله عنها أن أبا بكر قال للنبي : إني رأيت في المنام كأني أطأ في عذرة وأن في صدري خالين أو شامتين وعلي رداء حبرة قال فذكره .(@)(@@)(@@)(@@) $ ( 16932 ) قال النبي :(@)(@@) | 30 ( لئن صدقت رؤياك كانت ملحمة ) )(@)(@@) أبو نعيم عن عائشة رضي الله عنها قالت : رأيت كأني على تل وحولي بقر تنحر ، قال النبي فذكره .(@)(@@)(@@)(@@) $ ( 16933 ) قال النبي :(@)(@@) | 30 ( لئن عشت لأنهين أن يسمى نافعا وبركة ويسارا ) )(@)(@@) ابن جرير عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16934 ) قال النبي :(@)(@@) | 30 ( لئن كنت أوجزت في المسألة لقد أعظمت وأطولت فاعقل عني إذن : أعبد الله لا تشرك به شيئا ، وأقم الصلاة المكتوبة ، وأد الزكاة المفروضة ، وصم رمضان ، وحج البيت واعتمر ، وما تحب أن يفعله بك الناس فافعله بهم وما تكره أن يأتي إليك الناس فذر الناس منه ) )(@)(@@) ( حم طب ) و البغوي وابن جرير وأبو نعيم عن رجل من قيس يقال له ابن المنتفق ويكنى أبا المنتفق رضي الله عنه قال : أتيت النبي فقلت : ما سينجيني من النار وما يدخلني الجنة ؟ قال فذكره ، ( طب ) عن معن بن يزيد ( طب ) عن صخر بن القعقاع الباهلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16935 ) قال النبي :(@)(@@) | 30 ( لئن أقصرت الخطبة لقد أعرضت المسألة : اعتق النسمة ، وفك الرقبة ، قال : أو ليسا واحدا ؟ قال : لا ، عتق النسمة أن ينفرد بعتقها ، وفك الرقبة أن تعين في ثمنها ، والمنحة الموكوفة ، والفيء على ذي الرحم الظالم ، فإن لم تطق ذالك فأطعم الجائع ، واسق الظمآن ، وأمر PageV06P019 بالمعروف ، وانه عن المنكر ، فإن لم تطق ذالك فكف لسانك إلا من خير ) )(@)(@@) ( ط حب ك هق ) و الخرائطي في مكارم الأخلاق عن البراء رضي الله عنه أن أعرابيا 
ms1834	 قال : يا رسول الله علمني شيئا يدخلني الجنة قال فذكره .(@)(@@)(@@)(@@) $ ( 16936 ) قال النبي :(@)(@@) | 30 ( لئن أقصرت الخطبة لقد أعظمت وأطولت : تعبد الله لا تشرك به شيئا ، وتقيم الصلاة المفروضة ، وتؤتي الزكاة ، وتصوم شهر رمضان ، وتحج البيت ، وتأتي إلى الناس ما تحب أن يؤتى إليك ، وما كرهت أن يؤتى إليك فدع الناس منه ) )(@)(@@) الخرائطي في مكارم الأخلاق عن مغيرة بن سعد ابن الأحزم الطحاوي عن عمه .(@)(@@)(@@)(@@) $ ( 16937 ) قال النبي :(@)(@@) | 30 ( لأسمينه اسما لم يسم به بعد يحيى بن زكريا ) )(@)(@@) ابن سعد عن إسحاق بن عبد الله قال : حدثني من سمع علي بن يحيى بن خلاد قال : لما ولد يحيى بن خلاد رضي الله عنه أتي به النبي فحنكه وقال فذكره .(@)(@@)(@@)(@@) $ ( 16938 ) قال النبي :(@)(@@) | 30 ( لامرىء ما احتسب ، وعليه ما اكتسب ، والمرء مع من أحب ، ومن مات على ذنابى الطريق فهو من أهله ) )(@)(@@) ( طب كر ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16939 ) قال النبي :(@)(@@) | 30 ( لأنازعن رجالا عن الحوض فيختلجون دوني ، فأقول أصحابي ، فيقال : إنك لا تدري ما أحدثوا بعدك ) )(@)(@@) ( قط ) في الأفراد عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16940 ) قال النبي :(@)(@@) | 30 ( لاهل الذمة ما أسلموا عليه من ذراريهم وأموالهم وأراضيهم وعبيدهم ومواشيهم ، وليس عليهم فيها إلا الصدقة ) )(@)(@@) ( حم بز ) عن سل يمان بن بريدة عن أبيه .(@)(@@) PageV06P020(@)(@@)(@@)(@@) $ ( 16941 ) قال النبي :(@)(@@) | 30 ( لاكن ربي أمرني أن أحفي شاربي وأعفي لحيتي ) )(@)(@@) ابن سعد عن عبيد الله بن عبد الله مرسلا .(@)(@@)(@@)(@@) ||| ( اللام مع الباء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 16942 ) قال النبي :(@)(@@) | 30 ( لبيك إلاه الحق لبيك ) )(@)(@@) ( حم ن ه ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16943 ) قال النبي :(@)(@@) | 30 ( لبيك اللهم لبيك ، إنما الخير خير الآخرة ) )(@)(@@) ( ك هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 16944 ) قال النبي :(@)(@@) | 30 ( لبيك اللهم لبيك ، لبيك لا شريك لك لبيك ، إن الحمد والنعمة لك والملك ، لا شريك لك ) )(@)(@@) ( حم ق 4 ) عن ابن عمر ، ( حم خ ) عن عائشة ، ( م د ه ) عن جابر ، ( ن ) عن 
ms1835	 ابن مسعود ، ( حم ) عن ابن عباس ، ( ع ) عن أنس ، ( طب ) عن عمرو بن معدي كرب رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 16945 ) قال النبي :(@)(@@) | 30 ( لبن الدر يحلب بنفقته إذا كان مرهونا ، والظهر يركب بنفقته إذا كان مرهونا ، وعلى الذي يركب ويحلب النفقة ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV06P021(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 16946 ) قال النبي :(@)(@@) | 30 ( لبيك حي حقا ، تعبدا ورقا ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( اللام مع التاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 16947 ) قال النبي :(@)(@@) | 30 ( لتأخذوا عني مناسككم ، فإني لا أدري لعلي لا أحج بعد حجتي هاذه ) )(@)(@@) ( م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16948 ) قال النبي :(@)(@@) | 30 ( لتؤدن الحقوق إلى أهلها يوم القيامة حتى يقاد للشاة الجلحاء من الشاة القرناء تنطحها ) )(@)(@@) ( حم م خد ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16949 ) قال النبي :(@)(@@) | 30 ( لتأمرن بالمعروف ، ولتنهون عن المنكر ، أو ليسلطن الله عليكم شراركم ، فيدعو خياركم فلا يستجاب لهم ) )(@)(@@) البزار ، ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16950 ) قال النبي :(@)(@@) | 30 ( لتتبعن سنن الذين من قبلكم شبرا بشبر ، أو ذراعا بذراع ، حتى لو سلكوا جحر ضب لسلكتموه ، قالوا : اليهود والنصارى ؟ قال : فمن ؟ ) )(@)(@@) ( حم ق ه ) عن أبي سعيد ( ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16951 ) قال النبي :(@)(@@) | 30 ( لتتركن المدينة على خير ما كانت ، تأكلها الطير والسباع ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV06P022(@)(@@)(@@)(@@) $ ( 16952 ) قال النبي :(@)(@@) | 30 ( لتخرج العواتق ، وذوات الخدور ، والحيض ويشهدن الخير ، ودعوة المؤمنين ، ويعتزل الحيض المصلى ) )(@)(@@) ( خ ن ه ) عن أم عطية رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 16953 ) قال النبي :(@)(@@) | 30 ( لتخرجن الظعينة من المدينة حتى تدخل الحيرة لا تخاف أحدا ) )(@)(@@) ( حل ) عن جابر بن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16954 ) قال النبي :(@)(@@) | 30 ( لتدخلن الجنة إلا من أبى وشرد على الله كشراد البعير ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16955 ) قال النبي :(@)(@@) | 30 ( لتدع الصلاة في كل شهر أيام قرئها ، ثم تتوضأ لكل صلاة ، فإنما هو 
ms1836	 عرق ) )(@)(@@) ( ك ) عن فاطمة بنت أبي حبيش رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 16956 ) قال النبي :(@)(@@) | 30 ( لتركبن سنن من كان قبلكم شبرا بشبر ، وذراعا بذراع ، حتى لو أن أحدهم دخل جحر ضب لدخلتم ، وحتى لو أن أحدهم جامع امرأته بالطريق لفعلتموه ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 16957 ) قال النبي :(@)(@@) | 30 ( لتزدحمن هاذه الأمة على الحوض ازدحام إبل وردت لخمس ) )(@)(@@) ( طب ) عن العرباض رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16958 ) قال النبي :(@)(@@) | 30 ( لتستحلن طائفة من أمتي الخمر باسم يسمونها إياه ) )(@)(@@) ( حم ) و الضياء ، عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16959 ) قال النبي :(@)(@@) | 30 ( لتسون الصفوف ، أو لتطمسن الوجوه ، ولتغضن أبصاركم ، أو لتخطفن أبصاركم ) )(@)(@@) ( حم طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@) PageV06P023(@)(@@)(@@)(@@) $ ( 16960 ) قال النبي :(@)(@@) | 30 ( لتسون لصفوفكم في صلاتكم ، أو ليخالفن الله بين قلوبكم ) )(@)(@@) ( حم طب ) عن النعمان بن بشير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16961 ) قال النبي :(@)(@@) | 30 ( لتغشين أمتي بعدي فتن يموت فيها قلب الرجل كما يموت بدنه ) )(@)(@@) نعيم بن حماد في الفتن ، عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 16962 ) قال النبي :(@)(@@) | 30 ( لتفتحن القسطنطينية ولنعم الأمير أميرها ، ولنعم الجيش ذالك الجيش ) )(@)(@@) ( حم ك ) عن بشر الغنوي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16963 ) قال النبي :(@)(@@) | 30 ( لتفتحن عصابة من المسلمين كنز آل كسرى الذي في الأبيض ) )(@)(@@) ( م ) عن جابر بن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16964 ) قال النبي :(@)(@@) | 30 ( لتقاتلن المشركين حتى يقاتل بقيتكم الدجال على نهر الأردن ، أنتم شرقيه ، وهم غربيه ) )(@)(@@) ( طب ) عن نهيك بن صريم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16965 ) قال النبي :(@)(@@) | 30 ( لتقيمن صفوفكم ، أو ليخالفن الله بين وجوهكم ) )(@)(@@) ( ن ) عن النعمان بن بشير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16966 ) قال النبي :(@)(@@) | 30 ( لتكن عليكم السكينة ) )(@)(@@) ( حم ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16967 ) قال النبي :(@)(@@) | 30 ( لتملأن الأرض جورا وظلما فإذا ملئت جورا وظلما ، يبعث الله رجلا مني اسمه اسمي ، واسم أبيه اسم أبي فيملؤها عدلا وقسطا كما ملئت جورا وظلما ، فلا تمنع السماء شيئا 
ms1837	 من قطرها ، ولا الأرض شيئا PageV06P024 من نباتها ، يمكث فيكم سبعا أو ثمانيا ، فإن أكثر فتسعا ) )(@)(@@) البزار ( طب ) عن قرة المزني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16968 ) قال النبي :(@)(@@) | 30 ( لتملأن الأرض ظلما وعدوانا ثم ليخرجن رجل من أهل بيتي حتى يملأها قسطا وعدلا كما ملئت ظلما وعدوانا ) )(@)(@@) الحارث ، عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16969 ) قال النبي :(@)(@@) | 30 ( لتنقضن عرى الإسلام عروة عروة ، فكلما انتقضت عروة تشبث الناس بالتي تليها ، فأولهن نقضا الحكم ، وآخرهن الصلاة ) )(@)(@@) ( حم حب ك ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16970 ) قال النبي :(@)(@@) | 30 ( لتنقضن عرى الإسلام عروة عروة ولتكونن أئمة مضلون ، ولتخرجن على أثر ذالك الدجالون الثلاثة ) )(@)(@@) ( ك ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 16971 ) قال النبي :(@)(@@) | 30 ( لتنتقون كما ينتقى التمر من الحثالة ، فليذهبن خياركم وليبقين شراركم ، فموتوا إن استطعتم ) )(@)(@@) ( ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16972 ) قال النبي :(@)(@@) | 30 ( لتنتهكن الأصابع بالطهور أو لتنتهكنها النار ) )(@)(@@) ( طس ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16973 ) قال النبي :(@)(@@) | 30 ( لتنتظر عدة الليالي والأيام التي كانت تحيضهن من الشهر قبل أن يصيبها الذي أصابها ، فلتترك الصلاة قبل ذالك من الشهر فإذا خلفت ذالك فلتغتسل ثم لتستثفر بثوب ثم لتصل ) )(@)(@@) ( د ن ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@) PageV06P025(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 16974 ) قال النبي :(@)(@@) | 30 ( لتأتينكم أجوركم ولو كان أحدكم في حجر ثعلب ) )(@)(@@) ( حم هق ) عن جبير بن مطعم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16975 ) قال النبي :(@)(@@) | 30 ( لتتب هاذه المرأة إلى الله وإلى رسوله وترد على الناس متاعهم ، قم يا فلان فاقطع يدها ) )(@)(@@) ( خط ) عن ابن عمر قال : كانت امرأة تأتي قوما تستعير منهم الحلي ثم تمسكه ، فرفع ذالك إلى النبي قال فذكره .(@)(@@)(@@)(@@) $ ( 16976 ) قال النبي :(@)(@@) | 30 ( لتأمرن بالمعروف ولتنهون عن المنكر ، وليوشكن الله أن يبعث عليكم عقابا من عنده ثم لتدعونه فلا يستجيب لكم ) )(@)(@@) ( هق ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16977 ) قال النبي :(@)(@@) | 30 ( لتأمرن بالمعروف ولتنهون عن المنكر ، أو ليبعثن الله عليكم العجم فليضربن رقابكم 
ms1838	 ، وليكونن أسدا لا يفرون ) )(@)(@@) نعيم في الفتن عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 16978 ) قال النبي :(@)(@@) | 30 ( لتتهوكن كما تهوكت اليهود والنصارى ، لقد جئتكم بها بيضاء نقية ، ولو كان موسى حيا ما وسعه إلا اتباعي ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16979 ) قال النبي :(@)(@@) | 30 ( لتشربن طائفة من أمتي الخمر باسم يسمونها إياه ) )(@)(@@) ( عب ) عن ابن محيريز مرسلا .(@)(@@)(@@)(@@) $ ( 16980 ) قال النبي :(@)(@@) | 30 ( لتصل ما عقلت فإذا خشيت أن تغلب فلتنم ) )(@)(@@) عبد بن حميد عن أنس رضي الله عنه .(@)(@@) PageV06P026(@)(@@)(@@)(@@) $ ( 16981 ) قال النبي :(@)(@@) | 30 ( لتسلكن سنن من كان قبلكم حذو النعل بالنعل ، ولتأخذن بمثل أخذهم إن شبرا فشبر ، وإن ذراعا فذراع ، وإن باعا فباع ، حتى لو دخلوا جحر ضب دخلتم فيه ، إلا أن بني إسرائيل افترقت على موسى سبعين فرقة كلها ضالة إلا فرقة واحدة الإسلام وجماعتهم ، ثم إنها افترقت على عيسى إحدى وسبعين فرقة كلها ضالة إلا واحدة الإسلام وجماعتهم ، ثم إنكم تكونون على ثلاث وسبعين فرقة كلها ضالة إلا الإسلام وجماعتهم ) )(@)(@@) ( ك ) عن كثير بن عبيد الله بن عمرو بن عوف عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 16982 ) قال النبي :(@)(@@) | 30 ( لتبقين ولتهاجرن إلى أرض الشام وتموت وتدفن بالربوة من أرض فلسطين ) )(@)(@@) ابن قانع وابن السكن وابن منده ( طب ) وأبو نعيم ( كر ) عن الأقرع بن شفي العكي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16983 ) قال النبي :(@)(@@) | 30 ( لتشد عليها إزارها ثم شأنك بأعلاها يعني الحائض ) )(@)(@@) مالك ( هق ) عن زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ ( 16984 ) قال النبي :(@)(@@) | 30 ( لتضربن مضر عباد الله حتى لا يعبد الله ، وليضربنهم المؤمنون حتى لا يمنعوا ذات تلعة ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16985 ) قال النبي :(@)(@@) | 30 ( لتغضن أبصاركم ، ولتحفظن فروجكم ، ولتقيمن وجوهكم ، أو ليكسفن وجوهكم ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 16986 ) قال النبي :(@)(@@) | 30 ( لتفتحن لكم الشام والروم وفارس حتى يكون لأحدكم من الإبل كذا وكذا ، ومن البقر كذا وكذا ، ومن الغنم ، حتى يعطى PageV06P027 أحدهم مائة دينار فيسخطها ) )(@)(@@) ( حم طب ك هق ض ) عن عبد الله بن حوالة رضي الله 
