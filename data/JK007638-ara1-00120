ms101	 من مثل % هيهات مثلا لروح الفضل % 37(@)(@@) % ما ظللت قبة الخضراء % % PageV01P332 البحر : رمل تام 1(@)(@@) % عرفت ناسكة ذات اللمى % % فرنت فاتكة في أضلعي % % 2(@)(@@) % ولكم بالهدب راشت أسهما % % فرمت شاكلتي صبري معي % % 3(@)(@@) % أنشقتني يوم جمع عرفها % % وعلى الخفيف حمتني رشفها % % 4(@)(@@) % كحل الحسن لسحر طرفها % % ما رنت للصب إلا أقسما % % 5(@)(@@) % ما كذا ترنو ضباء الأجرع % والغواني تدعي السحر وما % % 6(@)(@@) % هو إلا تحت ذاك البرقع % % 7(@)(@@) % غادة أقتلها لي كلها % % مثل ما أحي لقلبي وصلها % % 8(@)(@@) % ذات غنج قد سباني دلها % % طرقت وهنا فقالت أجرما % % 9(@)(@@) % إذ رأتني بائتا في الهجع % ونعم يا ريم طرفي هوما % % 10(@)(@@) % طمعا منك بطيف ممتع % % PageV01P333 11(@)(@@) % دمية نشر الخزامى نشرها % % بفتات المسك يزري شعرها % % 12(@)(@@) % كم ليال هي عندي بدرها % % قابلت فيهن مرآة السما % % 13(@)(@@) % بمحياها فقيل انطبعي % % هي والظبية من واد كما % % 14(@)(@@) % هي والبدر معا من مطلع % % 15(@)(@@) % كلما ورد خديها الخجل % % قطفت ذيالك الورد المقل % % 16(@)(@@) % لا تسل عني وعنها لا تسل % % وقفت فاستوقفتني مسقما % % 17(@)(@@) % وأفاضت فأفاضت أدمعي % % عجبا راقبت فيها الحرما % % 18(@)(@@) % واستحلت صيد قلبي الموجع % % 19(@)(@@) % كم قضت في سعيها من منسك % % ما أضاعت فيه إلا نسكي % % 20(@)(@@) % فلقد عدت بقلب مشرك % في الهوى يعبد منها صنما % % PageV01P334 21(@)(@@) % فهو في اللاهين لا في الركع % % ظلة يقرأ قل من حرما % % 22(@)(@@) % زينة الله - ولما يقلع % % 23(@)(@@) % لست أنسى بالمصلى موقفا % % فيه يرجى العفو عما سلفا % % 24(@)(@@) % فبدت أحلا الغواني مرشفا % % تجرح النسك بلحظ إن رمى % % 25(@)(@@) % سهمه قرطس قلب الورع % % وانثنت تطعن بالحج بما % % 26(@)(@@) % قد حوى لين الرماح الشرع % % 27(@)(@@) % يا سقى الله ضحيات النقى % % وكساها الررض وشيا مونقا % % 28(@)(@@) % كم أرت عيني وجها مشرقا % وجلت لي من فتاة مبسما % % 29(@)(@@) % عن شتيت واضح ملتمع % % فدعى دمعي ولكن رخما % % 30(@)(@@) % فأجابت بعقيق أدمعي % % PageV01P335 31(@)(@@) % عجبت حين بدت في تربها % % ورأتني بين صرعى حبها % % 32(@)(@@) % ثم قالت للتي في جنبها % % هل وصلن الغيد قبلي مغرما % % 33(@)(@@) % وسوى 
ms102	 الشيب له لم يشفع % سنة ما عملت فيها الدمى % % 34(@)(@@) % وهي في دين الهوى لم تشرع % % 35(@)(@@) % لا ومن أودع في خصري النحول % % ورمى نرجس جفني بالذبول % % 36(@)(@@) % لست أحيي أشيبا واسمي قتول % % للذي ماء الصبا فيه نما % % 37(@)(@@) % غصنه من ناشىء أو يفع % كلما استقطرت منه اللمما % % 38(@)(@@) % قطرت ماء فبلت موضعي % % 39(@)(@@) % قلت يا سالبتى طيب الوسن % % ما لمن تصبي المعنى والسنن % % 40(@)(@@) % فصلي الصب الذي فيك افتتن % % واجعلي وصلك في هذا الحمى % % PageV01P336 41(@)(@@) % بدعة جاءت كبعض البدع % وألمي كخيال سلما % % 42(@)(@@) % هوم الركب فحيا مضجعي % % 43(@)(@@) % من رأى خديك قال العجب % كيف في الماء يشع اللهب % 44(@)(@@) % والتي طاب أبوها العنب % بالذي أودعها منك الفما % % 45(@)(@@) % وبه حلت بحلا موضع % ما الذي من يرتشفه أثما % % 46(@)(@@) % هي أم فوك فزيدي ولعي % % 47(@)(@@) % وحديث تتهاداه الربى % % طاب نشرا بين أنفاس الصبا % % 48(@)(@@) % عن بشير جاء يطوي السبسبا % % تأرج البشرى عبيرا أينما % % 49(@)(@@) % حل في الأربع بعد الأربع % % شعب شمل العلى فالتأما % % 50(@)(@@) % ودعت قلب الحسود : انصدع % % PageV01P337 51(@)(@@) % فأدر يا صاحبي كأس الطرب % % واطرح في كأسها بنت العنب % % 52(@)(@@) % قم فشاركني بما سر الحسب % % بشر المجد وهن الكرما % % 53(@)(@@) % وعلى هذا إلهنا باكر معي % % قد تجلى كل أفق أظلما % % 54(@)(@@) % بسنا هذي البدور الطلع % % 55(@)(@@) % زهر مجد زهر المجد بهم % % لا خلت أفلاكه من شهبهم % % 56(@)(@@) % كلما خف الهوى في صبهم % % وعلى المسرى إليهم عزما % % 57(@)(@@) % ثقلت نهضته في المربع % % في أمور طاريات كلما % % 58(@)(@@) % هم ينحو قصدهم قلن ارجع % % 59(@)(@@) % لك يا عبد الكريم الفرح % ولحسادك ذاك الترح % % 60(@)(@@) % وصفت لابن أخيك المنح % مصطفى المجد بأزكى من نما % % PageV01P338 61(@)(@@) % شرف سام لمجد أرفع % % كبدور التم تنضو اللثما % % 62(@)(@@) % عن ثغور كالبروق اللمع % % 63(@)(@@) % قر طرف الفخر منها بالحسن % % ذاك من قرت به عين الزمن % % 64(@)(@@) % شخصه والدهر روح وبدن % % فحياة الدهر لما قدما % % 65(@)(@@) % رجعت للناس أحلا مرجع % ما براه الله إلا عيلما % % 66(@)(@@) % لبني الآمال عذب المشرع 
ms103	 % % 67(@)(@@) % رد في صدر المعالي قلبها % % ولأفلاك المساعي قطبها % % 68(@)(@@) % والقوافي سبحته ربها % % وأتت تهدي إليه أنجما % % 69(@)(@@) % ما حواها فلك في مطلع % دررا وهي تسمى كلما % % 70(@)(@@) % مثلها ما أنشدت في مجمع % % PageV01P339 71(@)(@@) % شهدت للمجد أبهى محفل % % فادعت فخرا وقالت : هو لي % % 72(@)(@@) % أيها القالة مثلي فصلي % % من فريد المدح ما قد نظما % % 73(@)(@@) % ثم يا صاغة مثلي رصعي % % أو فكفي وأريحي القلما % % 74(@)(@@) % وبياض الطرس للطرس دعي % % 75(@)(@@) % هذه الأفناء أفناء الشرف % % منتدى الآداب فيها والظرف % % 76(@)(@@) % لم يزل للمدح فيها معتكف % % من يرد يهدي إلى هذي السما % % 77(@)(@@) % يلتقط من هذه الزهر معي % % ما وعاها الدهر إلا مغرما % % 78(@)(@@) % قال أحسنت فقرط مسمعي % % 79(@)(@@) % دار مجد مصطفى الفخر بها % % كأبيه حلمه من هضبها % % 80(@)(@@) % فالورى في شرقها أو غربها % % كلها تلحظ منه علما % % PageV01P340 81(@)(@@) % شامخا هضبته لم تطلع % خيرها مجدا وأعلى منتما % % 82(@)(@@) % في العلى من كل ندب أروع % % 83(@)(@@) % طاول الأمجاد حتى ابتدرا % % غاية جاز إليها القمرا % % 84(@)(@@) % وغدا جودا يمير البشرا % % بيد أخجل فيها الديما % % 85(@)(@@) % قائلا : يا أيها السحب اقلعي % % ما أتاه الوفد إلا كرما % % 86(@)(@@) % حل منه في الجناب الممرع % % 87(@)(@@) % يا عرانين المعالي والشرف % % لكم أهديتها أسنى التحف % % 88(@)(@@) % ولكم تجلى عروسا وتزف % % فلها البشر بكم زهوا كما % % 89(@)(@@) % لكم البشر بها في المجمع % والبسوا الأفراح ثوبا معلما % % 90(@)(@@) % عنكم طول المدى لم ينزع % % PageV01P341 البحر : رمل تام 1(@)(@@) % نصب العشق لعقلي شركا % % من جعود كم سبت ذا ولع % 2(@)(@@) % ومن الحظ بقلبي فتكا % % بسهام ليتها لم تنزع % 3(@)(@@) % يا نديمي على الورد الندي % % من خدود الخرد الغيد الكعاب % 4(@)(@@) % غنياني بلعوب بالعشي % ليس غير العطر تدري والخضاب % % 5(@)(@@) % قد حوى مرشفها العذب الشهي % % شهدة قد لقبوها برضاب % % 6(@)(@@) % أطرباني ودعا من نسكا % % إنما الجنة تحت البرقع % 7(@)(@@) % في محيا ذات قد قد حكى % % قمر التم بأبهى مطلع % 8(@)(@@) % عللاني برشوف ثغرها % % مرتو خلخالها ، عطشى الوشاح % % 9(@)(@@) % غضة الجيد ، رهيف خضرها % % لم تكن 
ms104	 تبسم إلا عن أقاح % % 10(@)(@@) % طرقت زائرة تسترها % % طرة في ليلها تعمي الصباح % % PageV01P342 11(@)(@@) % بت لا أجذبها إلا اشتكى % % خصرها مما تلوى ولعي % % 12(@)(@@) % لفنا الشوق وقال احتبكا % % بعناق وبضم ممتع % 13(@)(@@) % غادة قامتها الغصن الوريق % % فوقها ريحانة الفرع ترف % 14(@)(@@) % صدغها والخد آس وشقيق % % فتروح وإذا شئت اقتطف % % 15(@)(@@) % خالها والريق مسك ورحيق % % فتنشق وكما تهوى ارتشف % 16(@)(@@) % نصبت ألحاظها معتركا % % غير عذري الهوى لم يجمع % % 17(@)(@@) % جفنها في سيفه كم سفكا % % من دم لولا الهوى لم يضع % 18(@)(@@) % معرك للشوق كم فيه مقام % % لأخي قلب من الوجد صديع % % 19(@)(@@) % وبه كم قلبت أيدي الغرام % % بين ألحاظ الغواني من صريع % % 20(@)(@@) % ودعت حوراؤه : موتوا هيام % % فلدينا أجركم ليس يضيع % % PageV01P343 21(@)(@@) % في سبيل الحب من قد هلكا % % فمعي يمسي ومن يمسي معي % % 22(@)(@@) % كان في جنة حسني ملكا % % أين ما مد يدا لم يمنع % 23(@)(@@) % أقبلت سكرى ومن خمر الصبا % % عطفتها نشوة الدل عليك % % 24(@)(@@) % تسرق النظرة من عين الضبا % % وبلحظ فاتر ترنو إليك % % 25(@)(@@) % تخذت ماشطة كف الصبا % % كلما رجلت الجعد لديك % % 26(@)(@@) % نثرت مسكا بذي البان ذكا % % فسرت نفحته في لعلع % % 27(@)(@@) % كم تسترت بها فانهتكا % % ذلك الستر بطيب المضجع % % 28(@)(@@) % ونديم لفظه العذب الرخيم % % كنسيم الورد في رقته % % 29(@)(@@) % قبله ما خلت ولدان النعيم % % بعضهم يسرق من جنته % 30(@)(@@) % إنما آنست يا قلبي الكليم % % شعلة بالكاس من وجنته % PageV01P344 31(@)(@@) % لا تقل كيف من الكاس ذكا % % جمر خديه معا في أضلعي % % 32(@)(@@) % فذكا وهي تحل الفلكا % % أن تقابل بزجاج تلذع % 33(@)(@@) % عد عن ذكرك ربات الخدور % % وأعد لي ذكر أرباب الحسب % % 34(@)(@@) % وأدر راح التهاني والحبور % % للندامى واطرح بنت العنب % % 35(@)(@@) % فصبا الأفراح عن نور السرور % % فتحت يا سعد أكمام الطرب % % 36(@)(@@) % والعلى والمجد بشرا ضحكا % % في ختان قال للشمس اطلعي % % 37(@)(@@) % إن يكن قطعا ففيه اشتركا % % بسرور ليس بالمنقطع % % 38(@)(@@) % طاولوا الشم بني الشم الرعان % % والبسوا الفخر على طول السنين % % 39(@)(@@) % ما أتم المجد فيكم فالزمان % % منكم 
ms105	 العليا به في كل حين % % 40(@)(@@) % لم تلد إلا ( غنيا ) عن ختان % ' وسليم ' عن زيادات تشين % % PageV01P345 41(@)(@@) % كلهم في منبت العز زكا % % وكطيب الأصل طيب المفرع % % 42(@)(@@) % من ترى منهم تخله ملكا % % قد تراءى بشرا في المجمع % % 43(@)(@@) % لكم البشرى ذوي الفخر الأغر % % بسليلي أكرم الناس قبيل % % 44(@)(@@) % لست أدري أفهل أنتم أسر % بهما اليوم أم المجد الأثيل % % 45(@)(@@) % وهل العلياء عيناها أقر % بهما أم عين ذي الرأي الأصيل % % 46(@)(@@) % مصطفى المعروف من لو ملكا % % حوزة الأقطار لم تتسع % % 47(@)(@@) % لأياديكم بها قد سمكا % % من سماء لعلاء أرفع % % 48(@)(@@) % إن أقل : يا بدر مجد زهرا % % وبزعمي غاية المدح بلغت % % 49(@)(@@) % قال لي البدر : كفاني مفخرا % % فبتشبيهك لي فيهم مدحت % % 50(@)(@@) % أو أقل : يا بحر جود زخرا % % قال لي البحر : لماذا بي سخرت % % PageV01P346 51(@)(@@) % قست من لورام فخرا لا تكن % % وكفى عني بصغرى إصبع % % 52(@)(@@) % كم بها بخل غيثا فبكى % % وغدا ينحب بالرعد معي % % 53(@)(@@) % واحدا في كل فضل منفرد % % بمزايا في الورى لم تكن % 54(@)(@@) % حلف الدهر به أن لا يلد % % للعلى مثلا له في الزمن % % 55(@)(@@) % لا تخلها حلفة لم تنعقد % % فبها استثنى له بالحسن % % 56(@)(@@) % ذاك من أصعد حتى أدركا % % ذروة المجد التي لم تطلع % % 57(@)(@@) % كم من المجد سماء سمكا % % لاح والشمس بها من مطلع % % 58(@)(@@) % ذو مزايا سقيتها روضته % % فارتوت بالعذب من ماء النهى % % 59(@)(@@) % كملت عند المعالي نهضته % % لو بها شاء إذا حط السهى % % 60(@)(@@) % وهو الغيث ولكن ومضته % % تنبت الشكر بمنهل اللهى % % PageV01P347 61(@)(@@) % مثلما ينبت طورا حسكا % % في عيون حسدا لم تهجع % % 62(@)(@@) % أعين ليت الكرى إن سلكا % % بين جفنيها جرى في الأدمع % % PageV01P348 البحر : رمل تام 1(@)(@@) % يا خليلي وأيام الصبا % % حلبات فانهضا نستبق % 2(@)(@@) % خلعت خيل التصابي عذرها % % فردا فيها بحزوى غدرها % % 3(@)(@@) % واقنصا بين الخزامى عفرها % % فات فيما قد مضى أن تطربا % % 4(@)(@@) % فخذا حظكما فيما بقي % % 5(@)(@@) % إن أيام الصبا في مذهبي % % لأخي الشوق دواعي الطرب % 6(@)(@@) % فعلى جلوة بنت العنب 
ms106	 % أو على نرجس أحداق الظبا % % 7(@)(@@) % غنياني ، من لصب شيق % % 8(@)(@@) % زال عني يا نديمي الوصب % أقبل النور ولي فيه أرب % % 9(@)(@@) % أبرز الأنفاء في زي عجب % % ومن الوشي كساها قشبا % % 10(@)(@@) % حلل السندس والاستبرق % % PageV01P349 11(@)(@@) % وشح الطل عروس الزهر % بسقيط اللؤلؤ المنحدر % % 12(@)(@@) % ثم حياها نسيم السحر % % وجلاها فوق كرسي الربا % % 13(@)(@@) % لمع برق من ثنايا الأبرق % % 14(@)(@@) % أعرس الروض بنوار حلا % % عندليب الأيك فيه هلهلا % % 15(@)(@@) % رقص القطر فغنى وعلى % % منبر الأغصان لما خطبا % % 16(@)(@@) % عقد البان وقال اعتنقي % % 17(@)(@@) % في ربيع بالتهاني زهرا % % فرش الأرض بهارا بهرا % % 18(@)(@@) % ودنانيرا عليها نثرا % % بيد الوسمي ليست ذهبا % % 19(@)(@@) % بل خدود الجلنار المونق % % 20(@)(@@) % كم شقيق قد جلى عن نظرة % من بياض مشرب في حمرة % PageV01P350 21(@)(@@) % ومن الريحان كم من وفرة % رفرفت ما بين أنفاس الصبا % % 22(@)(@@) % فوق قد من قضيب مورق % % 23(@)(@@) % وعلى خد من الورد بدا % % صدغ آس بله طل الندى % % 24(@)(@@) % في رياض غضة فيها غدا % % ضاحكا ثغر الأقاحي عجبا % % 25(@)(@@) % وبها النرجس ساهي الحدق % % 26(@)(@@) % في الرياحين يطيب المجلس % % لبني اللهو وتحلو الأكؤس % 27(@)(@@) % نزه ترتاح فيها الأنفس % لمدام عتقوها حقبا % % 28(@)(@@) % ونديم ناشىء ذي قرطق % % 29(@)(@@) % بين سمطي ثغره للمستلذ % % خمرة لم يعتصرها منتبذ % % 30(@)(@@) % إن تغنى هزجا قلت اتخذ % % معبدا عبدا وبعه إن أبى % % PageV01P351 31(@)(@@) % وعلى إسحاق بالنعل إسحق % % 32(@)(@@) % ذي دلال يتكفى غنجا % % فاق أنفاس الخزامى أرجا % % 33(@)(@@) % كلما شعتها تحت الدجى % % خلته أوقد منها لهبا % % 34(@)(@@) % كاد أن يحرق ثوب الغسق % % 35(@)(@@) % أيها المخجل ضوء القمر % حرك الشوق بجس الوتر % % 36(@)(@@) % فإلى ريقك ذاك الخصر % % طرب الصب فزده طربا % % 37(@)(@@) % بغنى يصبي ذوات الأطوق % % 38(@)(@@) % واجلها وجنة خد أشربت % % ماء ورد الحسن حتى شرقت % % 39(@)(@@) % وبكأس من ثناياك حلت % % عاطنيها خمر ريق أعذبا % % 40(@)(@@) % من جنى النحل ورب الفلق % % كم ليال بال % % PageV01P352 41(@)(@@) % كم ليال مبيضة % نعمتنا بفتاة غضة % 42(@)(@@) % صيغ حسنا نحرها من فضة % وهي تلويه وشاحا مذهبا % % 43(@)(@@) % فوق خصر 
ms107	 مثله لم يخلق % % 44(@)(@@) % ذات خد ورده للمقتطف % % عقرب الصدغ عليه تنعطف % % 45(@)(@@) % وعلى فرش من الجعد ترف % طالما العاشق منها قلبا % % 46(@)(@@) % حلوة المرشف والمعتنق % % 47(@)(@@) % حيها عاقدة زنارها % % كم قضت من صبها أوطارها % % 48(@)(@@) % ودعت في خدرها من زارها % % لبني الأتراك أفدي العربا % % 49(@)(@@) % فظباهم خدرها لم يطرق % % 50(@)(@@) % لو تطيق العرب من إشفاقها % % حمت الطيف على مشتاقها % % PageV01P353 51(@)(@@) % وغواني الترك مع عشاقها % % كلما مد الظلام الغيهبا % % 52(@)(@@) % كم لها في مضجع من عبق % % 53(@)(@@) % من عذيري من غزال ثمل % ثعلي الجفن لا من ثعل % % 54(@)(@@) % راش بالأهداب سهم المقل % لو رمى من حاجب فيمن صبا % % 55(@)(@@) % حاجبا راح بقوس غلق % % 56(@)(@@) % يا خليلي على ذكر المقل % خلتما همت ومن يسمع يخل % % 57(@)(@@) % لا وما في الرأس من شيبي اشتعل % % إنما كان غرامي كذبا % % 58(@)(@@) % وحديثي في الهوى لم يصدق % % 59(@)(@@) % إن ريعان الشباب النظر % وطر العمر وعمر الوطر % 60(@)(@@) % فخذا غيد الطلى عن بصري % % فاتني العشق وفي عصر الصبا % % PageV01P354 61(@)(@@) % خسرت صفقة من لم يعشق % % 62(@)(@@) % كان ذياك السوار المنقلب % % شافعا عند العذارى لم يخب % % 63(@)(@@) % فأتى الشيب ولي قلب طرب % % فبماذا أبتغي وصل الظبا % % 64(@)(@@) % ولها عندي بياض المفرق % % 65(@)(@@) % وعظ الحلم فلباه النهى % % ونهى جهل التصابي فانتهى % % 66(@)(@@) % فبما راع بفودي المها % % خبراها ، إن طرفي قد نبا % % 67(@)(@@) % عنك يا ذات المحيا المشرق % % 68(@)(@@) % قد وهبنا لسليمى قدها % % وعلى اللثم وفرنا خدها % % 69(@)(@@) % برد الشوق فعفنا بردها % % واقتبلنا فرحة قد أعربا % % 70(@)(@@) % حسنها عن جدة لم تخلق % % PageV01P355 71(@)(@@) % إن في عرس الحسين ذي النهى % % حيز الكون جميعا قد زهى % % 72(@)(@@) % وبهاء الغرب للشرق انتهى % % يبهج العين ويجلو الكربا % % 73(@)(@@) % وإلى الغرب بهاء المشرق % % 74(@)(@@) % بشر الدين به أن سيلد % % من حبا الدين عليهم تنعقد % % 75(@)(@@) % والمعالي هنها أن ستجد % % منه في أفق شناها شبها % % 76(@)(@@) % وهو بين الشهب بدر الأفق % % 77(@)(@@) % فله الأملاك لما عقدوا % % كلهم لله شكرا سجدوا % % 78(@)(@@) % وعلى ( المهدي ) طرا وفدوا % % ثم 
ms108	 هنوه وقالوا : لاخبا % % 79(@)(@@) % نور هذا الفرح المؤتلق % % 80(@)(@@) % يا صبا البشر بنشر روحي % % شيبة الحمد وشيخ الأبطح % PageV01P356 81(@)(@@) % وعلى ( الهادي ) برياك انفحي % % ولأنف المرتضى والنقبا % % 82(@)(@@) % ولده عرف التهاني أنشقي % % 83(@)(@@) % وعلى الفيحاء زهوا عرجي % % وانقلي فيها حديث الأرج % % 84(@)(@@) % وانشري وسط حماها المبهج % % لا عن الشيح ولا عود الكبا % % 85(@)(@@) % بل عن ' المهدي ' طيب الخلق % % 86(@)(@@) % من به الدين الحنيفي اعتضد % % والهدى فيه اكتسى عز الأبد % % 87(@)(@@) % جد في كسب المعالي واجتهد % % وسواه يستجيد للقبا % % 88(@)(@@) % فوق فرش حفها بالنمرق % % 89(@)(@@) % ضمن الفخر بمثنى برده % ووطى الشهب بعالي جده % % 90(@)(@@) % كان نصفا لو أعادي مجده % كلما حلت لمرآه الحبا % % PageV01P357 91(@)(@@) % رفعت نعليه فوق الحدق % % 92(@)(@@) % نشر المطوي عمن سلفوا % % فطوى من نشرته الصحف % 93(@)(@@) % أين منه وهو فينا الخلف % إنه أعلم ممن ذهبا % % 94(@)(@@) % من ذوي الفضل وأعلى من بقي % % 95(@)(@@) % يا بن من قد عبد الله بهم % % ولهم من سلم الأمر سلم % % 96(@)(@@) % إن أنفا أن مدحناك رغم % % ليته ما شم إلا التربا % % 97(@)(@@) % أو أطاحته مدى معترق % % 98(@)(@@) % لك لا مدت من الدهر يد % فلأنت الروح وهو الجسد % 99(@)(@@) % وهو الباع وأنت العضد % كم ألنا بك منه المنكبا % % 100(@)(@@) % بعدما كان شديد المرفق % % PageV01P358 101(@)(@@) % تزدهي الأمجاد في آبائها % % وتباهى الصيد من أكفائها % % 102(@)(@@) % ونرى هاشم في عليائها % % أنت قد زينت منها الحسبا % % 103(@)(@@) % فاكتسى منك بأبهى رونق % % 104(@)(@@) % فالورى شخص بجدواك كما % % أصبحت في مدحك الدنيا فما % % 105(@)(@@) % لو بتقريضك أفنى الكلما % % لم يصف معشار ما قد طلبا % % 106(@)(@@) % من معانيك لسان المفلق % % 107(@)(@@) % دارك الدنيا وأنت البشر % ولك الورد معا والصدر % 108(@)(@@) % وبتعليمك جاد المطر % فالورى لو كفرت منك الحبا % % 109(@)(@@) % لكفى شكر الغمام المغدق % % 110(@)(@@) % هي أرض فيها ملك % أم سماء أنت فيها ملك % PageV01P359 111(@)(@@) % دار قدس يتمنى الفلك % لو حوى مما حوته كوكبا % % 112(@)(@@) % ولها كل نجوم الأفق % % 113(@)(@@) % كل ذي علم فمنهم ستمد % % وإليهم كل فضل يستند % % 114(@)(@@) % وبتطهيرهم الله شهد % % حنق 
ms109	 الخصم فقلنا : اذهبا % % 115(@)(@@) % عنهم الرجس لأهل الحنق % % 116(@)(@@) % حسدت شمس الضحى أم الهدى % % فتمنت مثلهم أن تلدا % % 117(@)(@@) % وابنها البدر لهم قد سجدا % % وحياء منه مهما غربا % % 118(@)(@@) % ود من بعد بأن لم يشرق % % 119(@)(@@) % كلهم جعفر فضل من يرد % % خلقه العذب ارتوت منه الكبد % % 120(@)(@@) % أبدا في الوجه منه يطرد % % ماء بشر من رآه عجبا % % PageV01P360 121(@)(@@) % كيف قد رق ولما يرق % % 122(@)(@@) % ففداء لمحياه الأغر % % أوجه تحسب قدت من حجر % % 123(@)(@@) % أين هم من ذي سماح لو قدر % % وعلى قدر علاه وهبا % % 124(@)(@@) % وهب المغرب فوق المشرق % % 125(@)(@@) % لا تفقه والورى في حلبة % فلقد بان بأعلى رتبة % 126(@)(@@) % ولئن كان وهم من منبت % فالثرى ينبت وردا طيبا % 127(@)(@@) % وصريما ليس بالمنتشق % % 128(@)(@@) % جاء للمجد المعلى ' صالحا ' % بحر جود بالمزايا طافحا % % 129(@)(@@) % فغدا فكري فيه سابحا % % يبرز اللؤلؤ عقدا رطبا % % 130(@)(@@) % والعلى تلبسه في العنق % % PageV01P361 131(@)(@@) % فرع مجد كرمت أخلاقه % % فكستها طيبها أعراقه % % 132(@)(@@) % يهجر الشهد لها مشتاقه % % لو بكأس الدهر منها سكبا % % 133(@)(@@) % ثمل الدهر ولما يفق % % 134(@)(@@) % ورع أعماله لو وزعت % % في الورى عنها الحدود ارتفعت % % 135(@)(@@) % أو بتقواه الأنام ادرعت % % لوقها في المعاد اللبها % % 136(@)(@@) % أو لنار لهب لم يخلق % % 137(@)(@@) % بأبي القاسم قد حلت لنا % % راحة الأفراح أزرار المنة % % 138(@)(@@) % لم يزنه بل به زين الثنا % % أفحم المطري فكنى مغربا % % 139(@)(@@) % إذا رأى ذكر إسمه لم يطق % % 140(@)(@@) % بالحسين استبشروا آل الحسب % % وابلغوا في عرسه أسنى الأرب % % PageV01P362 141(@)(@@) % ولكم دام مدى الدهر الطرب % % بختان الطيبين النجبا % % 142(@)(@@) % خير أغصان العلاء المعرق % % PageV01P363 البحر : رمل تام 1(@)(@@) % اجتلي الكاس فذي كف الصبا % % حدرت عن مبسم الصبح اللثاما % % 2(@)(@@) % واصطبحها من يدي غض الصبا % % أغيد يجلو محياه الظلاما % % 3(@)(@@) % بنت كرم زوجت بابن السحب % % فتحلت في لئال من حبب % % 4(@)(@@) % مذ جلاها الشرب في نادي الطرب % % ضحكت في الكاس حتى قطبا % % 5(@)(@@) % كل من كان لها يبدي ابتساما % % وانثنى الزامر يشدو مطربا % % 6(@)(@@) % غرقوا بالراح كسرى يا ندامى 
ms110	 % % 7(@)(@@) % هي نار في إناء من برد % % عجبا ذابت به وهو جمد % % 8(@)(@@) % أبدا تحرق نمرود الكمد % % وإذا منها الخليل اقتربا % % 9(@)(@@) % غودرت بردا عليه وسلاما % % فاحتسي أعذب من ماء الربى % % 10(@)(@@) % خمرة أطيب من نشر الخزامى % % PageV01P364 11(@)(@@) % أشبهت صافية في الأكؤس % % دمعة الهجر بخدي ألعس % % 12(@)(@@) % إن أديرت مثلت للمحتسي % % وجنة الساقي بها فاستلبا % % 13(@)(@@) % رشده حتى تراه مستهاما % % ليس يدري وجنة قد شربا % % 14(@)(@@) % أم سلافا عتقت عاما فعاما % % 15(@)(@@) % تنشىء الخفة في روح النسم % % وتروض الصعب منهم للكرم % % 16(@)(@@) % لو حساها وهو في اللؤم علم(@)(@@) % مادر ) منه إذا لانقلبا % % 17(@)(@@) % ذلك اللؤم سماحا مستداما % % ودعى خذ مع عقلي النشبا % % 18(@)(@@) % آخر الدهر ودعني والمداما % % 19(@)(@@) % كم على ذات الغضا من مجلس % % قد كساه الروض أبهى ملبس % % 20(@)(@@) % فيه بتنا تحت برد الحندس % % نتعاطى من كؤوس شهبا % % PageV01P365 21(@)(@@) % تطرد الهم وإن كان لزاما % % إذ به نامت عيون الرقبا % % 22(@)(@@) % ليتها تبقى إلى الحشر نياما % % 23(@)(@@) % ونديمي من بني الترك أغن % % شهدة النحل بفيه يختزن % % 24(@)(@@) % هب يثني عطفه سكر الوسن % % وأخيه المصطفى ابن المجتبى % % 25(@)(@@) % أنملا أبدى بها الحسن وشاما % % وكأن خديه منها أشربا % % 26(@)(@@) % خمرة إذ زفها جاما فجاما % % 27(@)(@@) % رشأ جسد صافي جسمه % % من شعاع الخمر لا من جرمه % % 28(@)(@@) % خفيت صهباؤه من كتمه % % لسناه مذ عليها غلبا % % 29(@)(@@) % نور خديه فما تدري الندامى % % أسنا خديه أبدى لهبا % % 30(@)(@@) % أم سنا الكأس لهم أبدى ضراما ؟ % % PageV01P366 31(@)(@@) % إن يقل لليل : عسعس ، شعره % % قال للصبح : تنفس ، ثغره % % 32(@)(@@) % أومن الردف تشكى خصره % قال يازادك : من زام الظبا ؟ % 33(@)(@@) % بالخصور الهيف ضعفا وانهضاما % ولكاسيك الوشاح المذهبا % % 34(@)(@@) % زاد جفنيه فتورا وسقاما % % 35(@)(@@) % يا أليفي صبوتي بشراكما % % جاء ما قرت به عيناكما % % 36(@)(@@) % ذا جديد الأنس قد حياكما % % وخلاصا لكما قد جلبا % % 37(@)(@@) % ناقلا من صفة الراح النظاما % % فاجعلاه للتهاني سببا % % 38(@)(@@) % فعل من يرعى لذي الود الذماما % % 39(@)(@@) % خليا ذكر أحاديث الغضا % % واطويا من عهد حزوى ما مضى % % 40 
ms111	(@)(@@) % وانشرا فرحة إقبال الرضا % % وأخيه المصطفى ابن المجتني % % PageV01P367 41(@)(@@) % إن إقبالهما سر الأناما % % وكذا الدنيا استهلت طربا % % 42(@)(@@) % إذ معا آبا وقد نالا المراما % % 43(@)(@@) % بوركا في الكرخ من بدري على % % شع برج المجد لما أقبلا % % 44(@)(@@) % ومحيا الفخر بالبشر انجلى % % وأعد ذكر كرام نجبا % % 45(@)(@@) % بمنيري أبرج المجد القدامى % % بكما قرت عيون النجبا % % 46(@)(@@) % آل بيت المصطفى السامي مقاما % % 47(@)(@@) % رجع السعد إلى مطلعه % % والبها رد إلى موضعه % % 48(@)(@@) % والندى عاد إلى منبعه % % بسراجي شرف قد أذهبا % % 49(@)(@@) % بالسنا من أفق الكرخ الظلاما % % وخضمي كرم قد عذبا % % 50(@)(@@) % موردا يروي من الصادي الأواما % % PageV01P368 51(@)(@@) % هل بنات السير في تلك الفلا % % علمت عاد بها ما حملا % % 52(@)(@@) % وبماذا بوقار وعلى % % رحلت بالأمس تطوي السبسبا % % 53(@)(@@) % حدرا تهبط أو تعلو أكاما % % وأريحت بالمصلى لغبا % % 54(@)(@@) % قد برت اقتابها منها السناما % % 55(@)(@@) % حملت من حرم المجد الكرم % % وانبرت تسعى إلى نحو الحرم % % 56(@)(@@) % وألمت لا لتمحيص اللمم % % بمقام البيت لكن طلبا % % 57(@)(@@) % لمزيد الأجر وافين المقاما % % وبمغناه طرحن القتبا % % 58(@)(@@) % بغية الفوز وألقين الخطاما % % 59(@)(@@) % قربت منه ومنشي الفلك % صفوتي بيت التقى والنسك % % 60(@)(@@) % بالسما أقسم ذات الحبك % % لهما بالحج حازا رتبا % % PageV01P369 61(@)(@@) % ما حبا في مثلها الله الأناما % % هي كانت من سواها أقربا % % 62(@)(@@) % عنده زلفى وأعلاها مقاما % % 63(@)(@@) % رتبا لا يتناهى قدرها % % يسع الخلق جميعا برها % % 64(@)(@@) % حيث لو عاد إليهم أجرها % % واستووا في الإثم شخصا مذنبا % % 65(@)(@@) % لمحى الله به عنه الإثاما % % وله من حسنات كتبا % % 66(@)(@@) % ضعف من حج ومن صلى وصاما % % 67(@)(@@) % بهما سائل ، تجد حتى الحجر % % شاهدا أنهما بين البشر % % 68(@)(@@) % خير من طاف ولبى واعتمر % % 69(@)(@@) % مسحاه بيد تنشى الحطاما % % هي بالجود لأجزال الحبا % % 70(@)(@@) % كعبة تعتادها الوفد استلاما % % PageV01P370 71(@)(@@) % % بين إحرام عن الإثم وحل % 72(@)(@@) % ويرى للهدي بالنحر يصل % كل يوم ويميح النشبا % % 73(@)(@@) % بيد لم يحكها الغيث انسجاما % % كان طبعا جودها محتلبا % % 74(@)(@@) % لا كما تحتلب الغيث النعاما % % 75(@)(@@) % ثم لما أكملا الحج 
ms112	 معا % ودعا مكة فيمن ودعا % % 76(@)(@@) % وإلى يثرب منها أزمعا % % قصد من ألبس فخرا يثربا % % 77(@)(@@) % وحباها شرف الذكر دواما % % وبه فاق سناها الشهبا % % 78(@)(@@) % فاشتهت تغدو لها الشهب رغاما % % 79(@)(@@) % ونحن كل ضريح المصطفى % % ناشقا طيب ثراه عرفا % % 80(@)(@@) % وبه طاف ومنه عطفا % % نحو مغنى المرتضى مرتغبا % % PageV01P371 81(@)(@@) % لسواه عنه لا يلوي الزماما % % فقضى من حقه ما وجبا % % 82(@)(@@) % وأتى ' الكرخ ' فحيا وأقاما % % 83(@)(@@) % كم لأيدي العيس يا سعد يد % أبدا مشكورة لا تجحد % 84(@)(@@) % فعليها ليس ينأى بلد % وبها وخدا سرت أو خببا % % 85(@)(@@) % يدرك الساري أمانيه الجساما % % ويرى أوطأ شيء مركبا % % 86(@)(@@) % ظهرها من طلب العز وراما % % 87(@)(@@) % أطلعت بالكرخ من حجب السرى % % قمري سعد بها قد أزهرا % % 88(@)(@@) % وغراما بهما أم القرى % % لو أطاقت لهما أن تصحبا % % 89(@)(@@) % حين آبا لأتت تسعى غراما % % وأقامت لا ترى منقلبا % % 90(@)(@@) % عن حمى الزوراء ما دامت دواما % % PageV01P372 91(@)(@@) % أوبة جاءت بنيل المنح % ذهبت فرحتها بالترح % % 92(@)(@@) % فبهذا العام أم الفرح % ولدتها فأجدت طربا % % 93(@)(@@) % بعد ما جاءت بها من قبل عاما % % ولها الإقبال قد كان أبا % % 94(@)(@@) % سعده أخدمه اليمن غلاما % % 95(@)(@@) % فاهن والبشرى أبا المهدي لك % % تلك علياك لبدريك فلك % % 96(@)(@@) % قد بدا كل بها يجلو الحلك % % فترى الأقطار شرقا مغربا % % 97(@)(@@) % لم يدع ضوؤهما فيها ظلاما % % والورى أبعدها والأقربا % % 98(@)(@@) % بهما تقتسم الزهو اقتساما % % 99(@)(@@) % ملت القلب سرورا مثلما % % قد ملآت الكف منها كرما % % 100(@)(@@) % واحتبت زهوا تهنيك بما % % خصك الرحمن من هذا الحبا % % PageV01P373 101(@)(@@) % حيث لازلت لها ترعى الذماما % % جاليا أن وجه عام قطبا % % 102(@)(@@) % للورى وجها به تسقي الغماما % % 103(@)(@@) % ففداء لك يا أندى يدا % % 104(@)(@@) % معشر ما خلقوا إلا فدا % % لبسوا الفخر معارا فنبا % % 105(@)(@@) % عن أناس تلبس الفخر حراما % % كل من فيهم على الحظ أبى % % 106(@)(@@) % قدرهم عن ضعة إلا الرغاما % % 107(@)(@@) % تشتكي من مس أبدانهم % % حلل ترفع من شانهم % 108(@)(@@) % وإذا صر بأيمانهم % قلم فهو ينادي عجبا % % 109(@)(@@) % صرت في أنملة اللؤم 
ms113	 مضاما % % من بها قر مقيما عذبا % % 110(@)(@@) % إنها ساءت مقرا ومقاما % % PageV01P374 111(@)(@@) % هب لهم درهمهم أصبح أب % % فسما فيهم إلى أعلا الرتب % % 112(@)(@@) % إكرام هم لدى نص النسب % % إن يعدوا نسبا مقتضيا % % 113(@)(@@) % لا عريقا في المعالي أو قدامى % % عدموا الجود معا والحسبا % % 114(@)(@@) % فماذا يتسمون كراما % % 115(@)(@@) % عبدوا فلسهم دهرهم % % وعليه قصروا شكرهم % 116(@)(@@) % فاطرح بين الورى ذكرهم % % 117(@)(@@) % قصروا الوفر على الوفد دواما % % وبنوا للضيف قدما قببا % % 118(@)(@@) % رفعت منها يد المجد الدعاما % % 119(@)(@@) % إذ على تقوى من الله الصمد % % أسس البنيان منها ووطد % % 120(@)(@@) % من له كل يد تشكر يد % % مصطفى الفخر وفيها أعقبا % % PageV01P375 121(@)(@@) % عشرة ألقى له الفضل الزماما % % إذ سهام الفضل عشر قصبا % % 122(@)(@@) % فيه كل فحوى العشر السهاما % % 123(@)(@@) % أعقب الصالح فيها خلفا % % وأبا الكاظم من قد شرفا % % 124(@)(@@) % والرضا الهادي حسينا مصطفى % % وأمينا كاظما أن أغضبا % % 125(@)(@@) % وجوادا جعفرا كلا هماما % % صبية سادوا ولكن في الصبا % % 126(@)(@@) % بأبي المهدي قد سادوا الأناما % % 127(@)(@@) % معشر بيت علاهم عامر % بهم للضيف زاه زاهر % 128(@)(@@) % فيه ما أم الأماني عاقر % تلد النجح فتكفي الطلبا % % 129(@)(@@) % وأبو الآمال لا يشكوا العقاما % % وعلى أبوابه مثل الدبي % % 130(@)(@@) % نعم الوفد لها تلقي الزماما % % PageV01P376 131(@)(@@) % أرضعت أم العلى ما ولدوا % % فزكى ميلادهم والمولد % 132(@)(@@) % إنهم طفلهم والسؤدد % % يستهلا ن فداع للحبا % % 133(@)(@@) % ذا وهذا قائل طبت غلاما % % إبق في حجر المعالي حقبا % % 134(@)(@@) % لا ترى من لبن العليا فطاما % % 135(@)(@@) % صفوة المعروف قروا أعينا % % واهنئوا بالصفو من هذا الهنا % % 136(@)(@@) % لكم السعد جلا وجه المنى % % بيد اليمن ومنه قربا % % 137(@)(@@) % لكم الإقبال ما ينأى مراما % % فالبسوا أبراد زهو قشبا % % 138(@)(@@) % منكم لا نزعت ما الدهر داما % % 139(@)(@@) % واليكم غادة وشحتها % % وبريا ذكركم عطرتها % % 140(@)(@@) % وإلى علياكم ارفقتها % % فلها جاء افتتاحا طيبا % % PageV01P377 141(@)(@@) % نشر راح الأنس منكم لا الخزامى % % ولها تشهد أنفاس الصبا % % 142(@)(@@) % من ثناكم مسكه كان ختاما % % PageV01P378 البحر : طويل 1(@)(@@) % ذخرتك لي إن نابني الدهر مرهفا % % على ثقة فيه 
ms114	 أصول على الخطب % % 2(@)(@@) % وقلت : أبي ، والأمر لله ، إن مضى % % فعنه أخي ، والحمد لله ، لي حسبي % % 3(@)(@@) % وبت لنفسي عنه فيك مسليا % وعين رجائي فيك معقودة الهدب % % 4(@)(@@) % فلما علي الخطب ألقى جرانه % % وسد بعيني واسع الشرق والغرب % % 5(@)(@@) % نزلت بآمالي عليك ظواميا % وقلت ردي قد صرت للمنهل العذب % % 6(@)(@@) % عهدتك عني في العظائم ناهضا % بأثقالها فراج معضلة الكرب % % 7(@)(@@) % وكان رجائي منك ما يكمد العدى % % فعاد رجائي أن تدوم على الحب % 8(@)(@@) % فكيف وأنت السيف حدا ورونقا % ونيت على أني هززتك بالعتب ؟ % PageV01P379 البحر : خفيف تام 1(@)(@@) % كلما زادك المحب اقترابا % % زدت عنه تباعدا واجتنابا % % 2(@)(@@) % شيمة ليست العلى ترتضيها % % للذي كان هاشميا لبابا % % 3(@)(@@) % ياهماما ضربن في طينة العل % % ياء أعراقه فطبن وطابا % % 4(@)(@@) % لا تسم هذه الأواصر قطعا % ليس ذا اليوم يوم لا أنسابا % % 5(@)(@@) % كيف تغضي ، وقد سمعت عتابا % لم أخلني عدوت فيه الصوابا ؟ % 6(@)(@@) % هل أتى غير مفهم عن قصور ؟ % أم تراني أسأت فيه الخطابا ؟ % 7(@)(@@) % أو تثاقلت عن ملال ، وحاشا % % ك ، فكان السكوت منك جوابا ؟ % 8(@)(@@) % كان ظني بأن على إثر إن نا % % ديت ، أغدو بما رجوت مجابا % % 9(@)(@@) % فإذا بي أتابع الرسل تترى % % بكتاب للعتب يتلو كتابا % % 10(@)(@@) % لست أسخو بأن يقول لساني : % مس بعض التغيير ذاك الجنابا % % PageV01P380 11(@)(@@) % يا تنزهت عن تطرق ظن % بسجاياك أن تحول انقلابا % % 12(@)(@@) % قد أبت تلكم الخلائق حتى % % للعدى أن تكون إلا عذابا % % 13(@)(@@) % سؤتني يا نسيج وحدك حدا % فنسجت القريض فيك عتابا % % 14(@)(@@) % أن تجدني أطلت نحوك تردا % % دي بالتعب جيئة وذهبا % % 15(@)(@@) % فلود شكا وأيأس شاك % من يداوي بعتبه الأوصابا % % PageV01P381 البحر : رجز تام 1(@)(@@) % يا خير من أعطى الجميل في الورى % % تبرعا فيه وأوفى من وعد % % 2(@)(@@) % لي عدة عندك ماذا صنعت ؟ % كأن عنها طرف ذكراك رقد % % PageV01P382 البحر : رجز تام 1(@)(@@) % يا أصدق الناس وأوفى من وعد % % ما أنت من أعطى الجميل واسترد % % 2(@)(@@) % أبعد بها طارية بذكرها % % يخزى أخو المجد إذا النادي انعقد % % 3(@)(@@) % وخطة 
ms115	 شنعاء لا يركبها % % إلا الذي في عود علياه أود % % 4(@)(@@) % وسبة تثلم من مجد الفتى % % ثلمة نقص ضل من قال : تسد % % 5(@)(@@) % لم يرضها إلا الوضيع همة % أو من على أخلاقه الذم حشد % % 6(@)(@@) % لا من سما لما سما لا مفردا % بل هو والحمد على النجم صعد % % 7(@)(@@) % يا جامعا بالمنع شمل وفره % % لا ترم شمل المكرمات بالبدد % % 8(@)(@@) % مجد أبوك بالسماح شاده % % حاشاك أن تهدم منه ما وطد % % 9(@)(@@) % ذاك الذي كانت سمات فخره % % في جبهة الدهر سناها يتقد % % 10(@)(@@) % يمد كفا نشأت من رحمة % في الله تعطي ولها منه المدد % % PageV01P383 11(@)(@@) % لو أن فيها كان رمل ( عالج % % ينفق ما أنفق منه لنفد % % 12(@)(@@) % حتى مضى تلفه مطارف % من الثنا ، تبقى على الدهر جدد % % 13(@)(@@) % فقمت أنت بعده مقامه % % فقيل : هذا الشبل من ذاك الأسد % % 14(@)(@@) % لا مثل من مجد أبيه بعده % % أضاعه ، فقيل : بئس ما ولد % % 15(@)(@@) % كنت لعمري ديمة ، وإنما % % ذاب زمانا عرفها ثم جمد % % 16(@)(@@) % ولجة بالأمس عادت وشلا % واردها اليوم تمنى لا ورد % % 17(@)(@@) % كم قلت - لست حالفا موريا % بأن هذا جهد ما عندي وجد % % 18(@)(@@) % ثم شفعت الوعد في إيصاله % % مكررا : لم لا علي تعتمد ؟ % 19(@)(@@) % ولم أخل أن السراب صادق % حتى غدا وعدك منه يستمد % % PageV01P384 20(@)(@@) % نعم صددت إذ بخلت موهما % فابخل أبا الهادي وسم البخل صد % % 21(@)(@@) % فيا فداء لك من كان له % % وجه من الصخر وعرض من سرد % % 22(@)(@@) % تذكر كم فيك القوافي فاخرت % % من سجد الناس له حتى سجد % % 23(@)(@@) % فكيف تقذي عينها بجفوة % من أجلها طرف المعالي قد رمد % % 24(@)(@@) % إن يغرك الحاسد فيها فلقد % % أغراك في مجدك من فرط الحسد % % 25(@)(@@) % أبعد ما مد الثنا طرافه % % عليك حتى قيل : بالحمد انفرد % % 26(@)(@@) % عنك كما الحاسد فيك يشتهي % % يصبح في كفيك منزوع العمد % % 27(@)(@@) % فقل لمن يرغب عن كسب الثنا : % من فقد المدح ترى ماذا وجد ؟ % 28(@)(@@) % أهون بمنشور دفين ذكره % % فذاك مفقود وإن لم يفتقد % % 29(@)(@@) % صابتك من 
ms116	 بوارقي مرشة % من عتب شؤبوبها لا من برد % % PageV01P385 30(@)(@@) % في عدة نومك عن إنجازها % % غيظا له قام القريض وقعد % % 31(@)(@@) % ترقد عنها والقريض حالف % بمجدك الشامخ عنها ما رقد % % 32(@)(@@) % ما الخلف في الوعد اكتساب شرف % وليس في منع الندى فخر الأبد % % 33(@)(@@) % تلك اليد البيضاء بعد بسطها % % عن السماح كفها كيف انعقد ؟ % 34(@)(@@) % وذلك الوجه الكريم ما له % من بعد ما ماء الحيا فيه أطرد % % 35(@)(@@) % أسفر بين الناس لا يخجله % % خلف المواعيد ولا منع الصفد % % 36(@)(@@) % فعد كما كنت ، وإلا انبعثت % % تترى إليك النافثات في العقد % % 37(@)(@@) % من اللواتي إن أصاب سهمها % % عرض لئيم طل من غير قود % % 38(@)(@@) % وهي على عرض الكريم نثرة % ما النثرة الحصداء منها بأرد % % 39(@)(@@) % تبدو فإما هي في جيد الفتى % % طوق وإما هي حبل من مسد % % PageV01P386 40(@)(@@) % فعش كما تهوى العلى ممدحا % لا خير في ميت العلى حي الجسد % % PageV01P387 البحر : متقارب تام 1(@)(@@) % ولاؤك أنفع ما يذخر % وذكرك أضوع ما ينشر % 2(@)(@@) % أجل ومكارمك الباهرات % أجل وأعظم ما يشكر % % 3(@)(@@) % أبا جعفر أنت لطف الإله % % وأنت لرأفته مظهر % % 4(@)(@@) % براك الأله لنا رحمة % يعلن بها العائل المقتر % % 5(@)(@@) % لقد صنت وجهي عن أن يرى % % لدى أحد ماؤه يقطر % % 6(@)(@@) % وعودتني كرما أن تجود % % علي ابتداء بما يغمر % 7(@)(@@) % فأضحى لساني لديك يطول % وهو لدى غيركم يقصر % % 8(@)(@@) % أبو إخوة لي على الحاسدين % على قلتي بهم أكثر % 9(@)(@@) % وداد الورى عرض زائل % وثابت ودهم جوهر % % 10(@)(@@) % هم الأطيبون هم الأنجبون % % هم السحب جودا هم الأبحر % % PageV01P388 11(@)(@@) % وهم عدتي حيث لا عدة % وهم معشري حيث لا معشر % % 12(@)(@@) % وعني بهم كم دفعت الخطوب % فولت بأذيالها تعثر % % 13(@)(@@) % توعدني زمني بالظما % % وفي زعمه أنني أضجر % % 14(@)(@@) % فقلت له : خلي عني الوعيد % أيظمأ من عنده ( جعفر ) % 15(@)(@@) % فتى أملي في ندى كفه % % كبير وهمته أكبر % % 16(@)(@@) % له أنمل سحب عشرها % % وراح أساريرها أبحر % % 17(@)(@@) % وعيشي في طيبها ' صالح ' % رياض المنى فيه لي تزهر % % 18(@)(@@) % محياه كالبدر 
ms117	 لا بل أتم % على أنه الشمس بل أنور % 19(@)(@@) % فيا رائشي حص مني الجناح % ففي الوكر طيري لقا يصفر % % 20(@)(@@) % ويا ناعشي أضعفت من قواي % أمور بها كاهلي موقر % % PageV01P389 21(@)(@@) % أعد نظرا نحو حالي غدت % % ومربعها طلل مقفر % % 22(@)(@@) % لئن أنت فيها غرست الجميل % % بالشكر سوف إذا يثمر % % 23(@)(@@) % وعن بصري إن جلوت القذا % % فإني بهديك مستبصر % % 24(@)(@@) % وإن كنت أخرت صنع الجميل % بعسر وليتك لا تعسر % % 25(@)(@@) % فحسبي صنايعك السالفات % واجبة الشكر لا تكفر % % 26(@)(@@) % ستعذر عندي عذر الذي % % على نفسه نفسه تصبر % % 27(@)(@@) % ولكن على كل حال أخال % بأن لك نفسك لا تعذر % % PageV01P390 البحر : مجزوء الكامل 1(@)(@@) % ما بال من نوهت دهرا % % فيه يتيه علي كبرا % % 2(@)(@@) % وكسوته العليا فجر % علي ثوب الزهو فخرا % % 3(@)(@@) % كم قمت فيك مفاخرا % من كان أشرف منك قدرا % % 4(@)(@@) % وموازنا من لا يراك % % بجنب طود علاه ذرا % % 5(@)(@@) % ومسايرا من كان أسير % في المكارم منك ذكرا % % 6(@)(@@) % ومطاولا من لم تقس % % أبدا بباعك منه فترا % % 7(@)(@@) % ومباهيا من لا يعد % كفخره لعلاك فخرا % % 8(@)(@@) % كنت الهلال فزدت في % % مدحي إلى أن صرت بدرا % % 9(@)(@@) % أنت البغاث لمعشر % فعلام صرت علي صقرا % % PageV01P391 البحر : طويل 1(@)(@@) % أيا خير من يرتاده أمل الورى % % فمبصره في روضة منه يحبر % % 2(@)(@@) % لديك رمت نفسي كبار همومها % % وهمتك العلياء منهن أكبر % % 3(@)(@@) % وطار رجائي في حماك محلقا % عن الناس حيث الكل منهم مقصر % % 4(@)(@@) % وعدت بري منك حائمة الرجا % % فهل هكذا تبقى وجودك جعفر % % 5(@)(@@) % سواك يخيب الظن فيه فيعذر % % ويمسك بخلا وهو بالبخل أجدر % % 6(@)(@@) % وغيرك يستجدى وما الجود عنده % % سوى كلمات بالأكاذيب تسحر % % 7(@)(@@) % ولكنك المولى الذي انتشرت له % % صنايع ما بين البرية تشكر % % PageV01P392 البحر : كامل تام 1(@)(@@) % حيا لي الباري صفي مودة % قد لذ لي وله قديما كاسها % % 2(@)(@@) % ما زال يفتل حبله ما بيننا % % بالوصل حتى استحصدت أعراسها % % 3(@)(@@) % وكأن بعض حواسدي ، وأعيذه % % بالله ، وسوس عنده خناسها % % 4(@)(@@) % فنهى ولكن عن حقوق مودة % لم 
ms118	 يغد منتقضا علي أساسها % % 5(@)(@@) % يا من غرست له المودة في الحشا % % وعلى الصفاء نمت له أغراسها % % 6(@)(@@) % أنتم دعاة الله سادة خلقه % % أمناء ملة دينه حراسها % % 7(@)(@@) % ومطهرون من الخبائث كلها % % أبدا فليس تمسكم أدناسها % % 8(@)(@@) % ومبجلون فما تطاولت الورى % % وحضر تم إلا وطأطا رأسها % % 9(@)(@@) % وأرى الكرام معادنا فلجينها % % وأبيك أنت وما سواك نحاسها % % 10(@)(@@) % ولأنت نعم مناخ وافدة المنى % % وأبر من شدت له أحلاسها % % PageV01P393 11(@)(@@) % تلك الخلايق أين جامع بشرها % % كانت تفرق وحشتي إيناسها % % 12(@)(@@) % تلك المكارم أين هامع قطرها % % ما زال يخضب ساحتي رجاسها % % 13(@)(@@) % عجبا دعوتك والخطوب تلوكني % % وعلى حشاشتي إلتقت أضراسها % % 14(@)(@@) % فصرفت فهمك عن خطاب ألوكتي % % تبدي الغموض بها وأنت أياسها % % 15(@)(@@) % نزعت برغبتها إليك فلم يكن % % من غير خجلتها لديك لباسها % % 16(@)(@@) % نشرت وسائلها إليك مع الرجا % % فلأيما سبب طواها ياسها % % 17(@)(@@) % وجبهتها بالرد حتى أنها % % لتكاد تضرم مهجتي أنفاسها % % 18(@)(@@) % عين رعيت بها هواي فحقبة % لم أدر عين الدهر كيف خلاسها % % 19(@)(@@) % ما لي انبهها لتلحظ خلتي % % ومن الجفاء لها يطيب نعاسها % % PageV01P394 البحر : طويل 1(@)(@@) % رأيت الثنا في جعفر الجود صادقا % وكم جعفر فيه الثنا غير صادق % 2(@)(@@) % فتى لم يزده المدح فخرا لفخره % % على أنه في غيره غير لائق % % 3(@)(@@) % وهل تستزاد الشمس نورا لنورها % % إذا قيل : إن الشمس أنور شارق % % 4(@)(@@) % فيا معرضا عني عن العتب بالجفا % % عجمت لساني وهو أفصح ناطق % % PageV01P395 البحر : كامل تام 1(@)(@@) % يا من براه الله روح كمال % فتمثلت شخصا بغير مثال % 2(@)(@@) % لك أنمل خلقت لبون مواهب % ما أرضعت سقب الرجا لفصال % % 3(@)(@@) % أم الحيا نبت الخضم ربيبة الإ % % حسان أخت العارض الهطال % % 4(@)(@@) % أملت لي تلد الكثير من الندى % % فحصلت من أملي على الإقلال % % 5(@)(@@) % ما خلت أن ألقاك حين كلاكلي % % عن ظهر همك طارحا أثقالي % % 6(@)(@@) % عجبا لجودك كيف عني قد سها % % فوقعت منه بجانب الإهمال % % 7(@)(@@) % مالي أنبه منك لحظ فواضل % ما نام عن كرم وعن إفضال % % 8(@)(@@) % تغضي وبي ضاق 
ms119	 المجال وطالما % % أوسعت في عين العدو مجالي % % 9(@)(@@) % وتحوم آمالي وبحرك زاخر % فتحيل حومها إلى الأوشال % % 10(@)(@@) % يا راعيا أملي علام وسمته % % من بعد ذاك البر بالإغفال % % PageV01P396 11(@)(@@) % عهدي بودك لا يحول وغيره % متنقل يتنقل الأحوال % % 12(@)(@@) % وأرى رجاي غروس جودك لم يزل % % فأفض عليه منعما بسجال % % PageV01P397 البحر : متقارب تام 1(@)(@@) % تظن الأنام بأقبالكم % % علي بلغت العريض الطويلا % % 2(@)(@@) % وقد صدقوا فلكم كم يد % لدي تحقق ما كان قيلا % % 3(@)(@@) % رأوا أملي بارك الله فيه % بآلائكم لم يزل مستطيلا % % 4(@)(@@) % وقالوا : عمرت بناء القريض % % ودارك تبقى كثيبا مهيلا % % 5(@)(@@) % وعندك من بنداهم يخف % على الدهر ما كان عبأ ثقيلا % % 6(@)(@@) % فهلا شفعت اليهم بها % % صناعا من المديح يسقي الشمولا % % 7(@)(@@) % إذا أنت أقرضتها جودهم % % أخذت على النجح فيها كفيلا % % 8(@)(@@) % فقلت : دعوا النصح في عذلكم % % فلا رأي لي أن أطيع العذولا % % 9(@)(@@) % بحسبي نباهة ذكري بهم % % وإن بات حظي يشكوا الخمولا % % 10(@)(@@) % فقد تشرق الشهب في بدرها % % وإن سامها القرب منها أفولا % % PageV01P398 11(@)(@@) % إذا ما تنبه لي جودهم % % وجاء إلي ، ابتداء ، جزيلا % % 12(@)(@@) % فتصبح داري معمورة % ويربع ما كان منها محيلا % % 13(@)(@@) % وإلا ، أدم مقصرا من رجاي % % ولم أر للعتب يوما مطيلا % % 14(@)(@@) % على أنني لو أشاء العتاب % إذا لوجدت إليه السبيلا % % 15(@)(@@) % ولكن لي كلهم ( مرتضى % فحاشاهم أن يروني ( عقيلا ) % PageV01P399 البحر : خفيف تام 1(@)(@@) % قد بلونك في قديم الليالي % % فوجدناك ( صالحا ) للمعالي % % 2(@)(@@) % وامتحناك فامتحنا بريئا % طبعه من تحول وانتقال % % 3(@)(@@) % فمحضنا لك الصريح من الود % وقابلته بحر الفعال % % 4(@)(@@) % قسما والسحاب كفك إن أق % % سمت بالمنشىء السحاب الثقال % 5(@)(@@) % نزل العتب منك ساحة فضل % لم تكن منزلا لغير الكمال % % 6(@)(@@) % واقتفاك القريض حق وداد % منك أمسى في جانب الإهمال % % PageV01P400 البحر : متقارب تام 1(@)(@@) % قبيح بحقك أن تبخلا % % علي وجودك عم الملا % % 2(@)(@@) % ولو أن غيرك في منعه % % يبيت لصعبي مستسهلا % % 3(@)(@@) % إذا لأصبت بسهم القريض % % مقاتله مقتلا مقتلا % % 4(@)(@@) % وجردت من مقولي صارما % فاحتزه مفصلا مفصلا % % 5(@)(@@) % ولكن 
ms120	 أجلك عما ذكرت % % فذاك بحقك لن يجملا % % PageV01P401 البحر : بسيط تام 1(@)(@@) % تلك المودة ما رأي العلى فيها % % ذابت حشا المجد غيظا من تلظيها % % 2(@)(@@) % أرست ولكن على قلب الحسود لها % % قواعد كان يبني الفخر بانيها % % 3(@)(@@) % معتلة بضنا الهجران قد مرضت % % بعلة مرضت نفس العلى فيها % % 4(@)(@@) % فالله الله في استبقائها فلقد % % كادت تقوم على الدنيا نواعيها % % 5(@)(@@) % ما عذر من صد عنها وهي مقبلة % من بعد ما كان تصيبه ويصيبها % % 6(@)(@@) % عهدي بها تكتسي أبهاج غرته % % والبشر يقطر زهوا من نواحيها % % 7(@)(@@) % فاعجب وما قد أراها دهرها عجب % من كان يضحكها قد صار يبكيها % % 8(@)(@@) % وكيف في كل ذاك العتب ما شفيت % % وكان في الحق منه البغض يشفيها % % 9(@)(@@) % داء من الهجر لم أبرح أعالجها % % منه وبالبرء في عتبي أمنيها % % 10(@)(@@) % وما طويت على يأس عليه طوت % % حتى مللت وملت من تشكيها % % PageV01P402 11(@)(@@) % فاعذر أخاك إذا مل العلاج فقد % % أفنى الدواء ولم ينجع تداويها % % 12(@)(@@) % سل ديمة كلما استمطرتها لمعت % % بروقها لي وانحلت عزاليها % % 13(@)(@@) % ما بالها بان إخلاف البروق بها % % أعيذها بإله الخلق منشيها % % 14(@)(@@) % فقم أعدها أبا الهادي بلا مهل % مكارما أنت قبل اليوم مبديها % % 15(@)(@@) % لا قلت مات الرجا والجود ما انبسطت % % بنان كفك في الدنيا لراجيها % % PageV01P403 البحر : خفيف تام 1(@)(@@) % ما الحيث انتهى بك الأسراء % لمهب العشر العقول ارتقاء % 2(@)(@@) % وإذا لم يكن إليك انتهاء(@)(@@) % كيف ترقى رقيك الأنبياء % % 3(@)(@@) % يا سماء ما طاولتها سماء ' % % 4(@)(@@) % جزت إذ فتحت لك الحجب فتحا % % لعلا دونه على الرسل تمحى % % 5(@)(@@) % فلهم لو غدى ذرى العرش سطحا % ' لم يساووك في علاك وقد حا % % 6(@)(@@) % ل سنا منك دونهم وسناء % % PageV01P404 البحر : طويل 1(@)(@@) % إذا عن لي برق يضيء على البعد % نزت كبدي من شدة الشوق والوجد % % 2(@)(@@) % وناديت معتل النسيم بلا رشد(@)(@@) % نسيم الصبا استنشقت منك شذا الند % 3(@)(@@) % فهل سرت مجتازا على دمنتي هند ؟ % % 4(@)(@@) % وهل لسليم الحب أقبلت راقيا ؟ % بنشر فتاة الحي إذ كان شافيا % % 5(@)(@@) % فما 