ms2402	 امرأته ثلاثا لم تحل له حتى تنكح زوجا غيره ) )(@)(@@) ( هق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22406 ) قال النبي :(@)(@@) | 30 ( من طلق أو حرم أو نكح أو أنكح فقال إني كنت لاعبا فهو جاد ) )(@)(@@) ( طب ) عن الحسن عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22407 ) قال النبي :(@)(@@) | 30 ( من طلق أو أعتق أو نكح أو أنكح ، جادا أو لاعبا ، PageV07P274 فقد جاز عليه ) )(@)(@@) ( ش ) و ابن جرير وابن أبي حاتم عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 22408 ) قال النبي :(@)(@@) | 30 ( من طلق ما لا يملك فلا طلاق له ، ومن أعتق ما لا يملك فلا عتاق له ، ومن نذر فيما لا يملك فلا نذر له ، ومن حلف على معصية فلا يمين له ، ومن حلف على قطيعة رحم فلا يمين له ) )(@)(@@) ( ك هق ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22409 ) قال النبي :(@)(@@) | 30 ( من ظلم معاهدا مقرا بذمته ، مؤديا لجزيته كنت خصمه يوم القيامة ) )(@)(@@) ابن منده وأبو نعيم في المعرفة عن عبيد الله بن جرادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22410 ) قال النبي :(@)(@@) | 30 ( من ظلم من الأرض شبرا فإنه يطوقه من سبع أرضين ) )(@)(@@) ابن جرير عن سعيد بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22411 ) قال النبي :(@)(@@) | 30 ( من ظلم أهل المدينة وأخافهم ، فعليه لعنة الله والملائكة والناس أجمعين ، لا يقبل منه صرف ولا عدل ) )(@)(@@) ( طب ض ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22412 ) قال النبي :(@)(@@) | 30 ( من ظلم شبرا من الأرض خسف به إلى يوم القيامة ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22413 ) قال النبي :(@)(@@) | 30 ( من ظلم من الأرض شبرا فما فوقه ، كلف أن يحفره يوم القيامة حتى يبلغ الماء ، يحمله إلى المحشر ) )(@)(@@) ( طب ) عن يعلى بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22414 ) قال النبي :(@)(@@) | 30 ( من ظلم شبرا من الأرض طوقه من سبع أرضين ، ومن قتل دون ماله فهو شهيد ) )(@)(@@) ابن جرير عن سعيد بن زيد رضي الله عنه .(@)(@@) PageV07P275(@)(@@)(@@)(@@) $ ( 22415 ) قال النبي :(@)(@@) | 30 ( من ظن منكم أن لا يستيقظ آخر الليل فليوتر أوله ، ومن ظن 
ms2403	 أنه يستيقظ آخره فليوتر آخره ، فإن صلاة آخر الليل محضورة وهي أفضل ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22416 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا خاض في رحمة الله ، فإذا جلس عنده غمرته الرحمة ) )(@)(@@) ( كر ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22417 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا لم يزل يخوض في الرحمة حتى يجلس ، فإذا جلس اغتمس فيها ) )(@)(@@) ( حم ش خ ) في الأدب و الحارث وابن منيع ( ن ع حب ك هق ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22418 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا ابتغاء مرضات الله ، وتنجيز موعود الله ، ورغبة فيما عنده ، وكل الله به سبعين ألف ملك يصلون عليه إن كان صباحا حتى يمسي ، وإن كان مساء حتى يصبح ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22419 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا خاض في الرحمة ، فإذا جلس إليه غمرته الرحمة ، فإن عاده من أول النهار استغفر له سبعون ألف ملك حتى يمسي ، وإن عاده من آخر النهار استغفر له سبعون ألف ملك حتى يصبح ، قيل : يا رسول الله هاذا العائد ، فما للمريض ؟ قال : أضعاف هاذا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22420 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا فجلس عنده ساعة أجرى الله له أجر عمل ألف سنة لا يعصي الله فيها طرفة عين ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@) PageV07P276(@)(@@)(@@)(@@) $ ( 22421 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا خاض في الرحمة ، فإذا جلس عنده استنقع فيها ) )(@)(@@) ( طب ) عن كعب بن عجرة ، ( حم ) وابن جرير ، ( طب ) عن كعب بن مالك رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 22422 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا إيمانا بالله واحتسابا وتصديقا بكتابه ، وكل الله به سبعين ألف ملك يصلون عليه من حيث يصبح حتى يمسي ، ومن حيث يمسي حتى يصبح ، وكان ما كان قاعدا عنده في خراف الجنة ) )(@)(@@) ابن صصرى في أماليه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22423 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا مشى في خراف الجنة ، فإذا جلس عنده استنقع في 
ms2404	 الرحمة ، فإذا خرج من عنده وكل الله به سبعين ألف ملك يستغفرون له ويحفظونه ذالك اليوم ) )(@)(@@) ( هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22424 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا يلتمس وجه الله خاض في رحمة الله خوضا ، فإذا قعد عنده استنقع فيها استنقاعا ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22425 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا لم يزل في خرافة الجنة حتى يرجع ) )(@)(@@) ( م طب ) و ابن جرير عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22426 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا لا يزال يخوض في الرحمة ، حتى إذا قعد عنده استنقع فيها ، ثم إذا قام من عنده لا يزال يخوض فيها حتى يرجع من حيث خرج ، ومن عزى أخاه المؤمن بمصيبة كساه الله تعالى من حلل الكرامات يوم القيامة ) )(@)(@@) ابن جرير والبغوي ( طب هق كر ) عن عبد الله بن أبي بكر بن PageV07P277 محمد بن عمرو بن حزم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22427 ) قال النبي :(@)(@@) | 30 ( من عاد أخاه المسلم فقعد عند رأسه ثم قال سبع مرات : أسأل الله العظيم ، رب العرش العظيم أن يشفيك ، عوفي إن لم يكن أجله حضر ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22428 ) قال النبي :(@)(@@) | 30 ( من عاد المريض خاض في الرحمة ، فإذا جلس عنده اغتمس فيها ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22429 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا خاض في الرحمة حتى يبلغه ، فإذا قعد عنده غمرته الرحمة ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22430 ) قال النبي :(@)(@@) | 30 ( من عاد مريضا قعد في خرافة الجنة ، فإذا قام من عنده وكل به سبعون ألف ملك يصلون عليه حتى الليل ) )(@)(@@) ( هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22431 ) قال النبي :(@)(@@) | 30 ( من عاش مداريا مات شهيدا ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22432 ) قال النبي :(@)(@@) | 30 ( من عال ابنتين أو أختين حتى يبن أو يموت عنهن كنت أنا وهو في الجنة كهاتين ) )(@)(@@) عبد بن حميد ( حب ) عن ثابن عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22433 ) قال 
ms2405	 النبي :(@)(@@) | 30 ( من عال ثلاث بنات حتى يبنهن كن له حجابا من النار ) )(@)(@@) الخطيب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22434 ) قال النبي :(@)(@@) | 30 ( من عال ابنتين أو أختين أو خالتين أو عمتين أو PageV07P278 جدتين فهو معي في الجنة كهاتين ، فإن كن ثلاثا فهو مفدح ، وإن كن أربعا أو خمسا فيا عباد الله أدركوه ، أقرضوه ، ضاربوه ) )(@)(@@) ( طب ) و أبو نعيم عن أبي المجير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22435 ) قال النبي :(@)(@@) | 30 ( من عال ثلاث بنات فأنفق عليهن ، وأحسن إليهن حتى يغنيهن الله عنه أوجب الله له الجنة البتة إلا أن يعمل عملا لا يغفر له ، قيل : أو اثنتين ؟ قال : أو اثنتين ) )(@)(@@) الخرائطي في مكارم الأخلاق عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22436 ) قال النبي :(@)(@@) | 30 ( من عاهر , 3 أمة أو حرة فولده ولد زنا لا يرث ولا يورث ) )(@)(@@) ( ه ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 22437 ) قال النبي :(@)(@@) | 30 ( من عبد الله لا يشرك به شيئا ، وأقام الصلاة ، وآتى الزكاة ، وسمع وأطاع أدخله الله من أي أبواب الجنة شاء ، ولها ثمانية أبواب ، ومن عبد الله لا يشرك به شيئا ، وأقام الصلاة ، وآتى الزكاة ، وسمع وعصى ، فإن الله من أمره بالخيار ، إن شاء رحمه ، وإن شاء عذبه ) )(@)(@@) ( حم طب ) و ابن عساكر عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22438 ) قال النبي :(@)(@@) | 30 ( من عجز منكم عن الليل أن يكابده ، وبخل بالمال أن ينفقه ، وجبن عن العدو أن يجاهده فليكثر ذكر الله ) )(@)(@@) ( طب هب ) و ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22439 ) قال النبي :(@)(@@) | 30 ( من عذب الناس في الدنيا عذبه الله ) )(@)(@@) ( حم ) عن PageV07P279 هشام بن حكيم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22440 ) قال النبي :(@)(@@) | 30 ( من عرضت له الدنيا والآخرة ، فأخذ الآخرة وترك الدنيا فله الجنة ، وإن أخذ الدنيا وترك الآخرة فله النار ) )(@)(@@) ابن عساكر عن أبي هريرة وابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22441 ) قال النبي :(@)(@@) | 30 ( من عرض له شيء من هاذا الرزق من غير مسألة ولا إشراف نفس 
ms2406	 فليتوسع به في رزقه ، وإن كان عنه غنيا فليوجهه إلى من هو أحوج إليه منه ) )(@)(@@) ( حم ع طب ض هب ) عن عائذ بن عمرو المزني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22442 ) قال النبي :(@)(@@) | 30 ( من عرض له شيء من غير أن يسأله فليقبله ، فإنما هو رزق ساقه الله ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22443 ) قال النبي :(@)(@@) | 30 ( من عزى ثكلى بردا في الجنة ) )(@)(@@) ( ت ) وضعفه ( ع ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22444 ) قال النبي :(@)(@@) | 30 ( من عزى أخاه المؤمن في مصيبة ، كساه الله حلة خضراء تحبر بها يوم القيامة ، قيل : يا رسول الله ! ما تحبر بها ؟ قال : يغبط بها ) )(@)(@@) ( ك ) في تاريخه و الخطيب وابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22445 ) قال النبي :(@)(@@) | 30 ( من عزى حزينا إلبسه الله عز وجل لباس التقوى وصلى على روحه في الأرواح ، ومن كفن ميتا كساه الله من السندس ) )(@)(@@) أبو الشيخ عن جابر رضي الله عنه وفيه الخليل بن مرة .(@)(@@)(@@)(@@) $ ( 22446 ) قال النبي :(@)(@@) | 30 ( من عزى ثكلى كسي بردا من برود الجنة ) )(@)(@@) ( هب ) عن أبي بردة رضي الله عنه .(@)(@@) PageV07P280(@)(@@)(@@)(@@) $ ( 22447 ) قال النبي :(@)(@@) | 30 ( من عشق وكتم ، وعف وصبر غفر الله له وأدخله الجنة ) )(@)(@@) ( كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22448 ) قال النبي :(@)(@@) | 30 ( من عقب ما بين المغرب والعشاء بني له في الجنة قصران ، ما بينهما مسيرة مائة عام ، وفيهما من الشجر ما لو يراهما أهل المشرق وأهل المغرب لأوصلهم فاكهة ، وهي صلاة الأوابين ، وهي غفلة الغافلين ، وإن من الدعاء المستجاب الدعاء الذي لا يرد ما بين المغرب والعشاء ) )(@)(@@) ابن مردويه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22449 ) قال النبي :(@)(@@) | 30 ( من عقد الجزية في عنقه فقد برىء مما جاء به محمد ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22450 ) قال النبي :(@)(@@) | 30 ( من عقر بهيمة ذهب ربع أجره ، ومن حرق نخلا ذهب ربع أجره ، ومن غش شريكا ذهب ربع أجره ، ومن عصى إمامه ذهب أجره كله ) )(@)(@@) ( هق ) و الديلمي وابن 
ms2407	 النجار عن أبي وهم السعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22451 ) قال النبي :(@)(@@) | 30 ( من علق شيئا وكل إليه ) )(@)(@@) ( طب ) عن معبد الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22452 ) قال النبي :(@)(@@) | 30 ( من علق في مسجد قنديلا صلى عليه سبعون ألف ملك حتى ينطفىء ذالك القنديل ) )(@)(@@) ابن النجار عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22453 ) قال النبي :(@)(@@) | 30 ( من علق الصيد غفل ، ومن لزم البادية جفا ، ومن أتى السلطان افتتن ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22454 ) قال النبي :(@)(@@) | 30 ( من علم آية من كتاب الله ، وسنة في دين الله هيأ الله له من الثواب يوم القيامة ما لا يكون ثواب أفضل مما هيأ له ) )(@)(@@) أبو الشيخ عن عبد الله بن ضرار عن يزيد الرقاشي وهما ضعيفان عن أنس رضي الله عنه .(@)(@@) PageV07P281(@)(@@)(@@)(@@) $ ( 22455 ) قال النبي :(@)(@@) | 30 ( من علم آية من كتاب الله كان له مثل أجر من تعلمها ضعفين ) )(@)(@@) ابن لال عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22456 ) قال النبي :(@)(@@) | 30 ( من علم آية من كتاب الله كان له ثوابها ما تليت ) )(@)(@@) ابن لال عن إبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22457 ) قال النبي :(@)(@@) | 30 ( من علم شيئا فلا يكتمه ، ومن دمعت عيناه من خشية الله لم يحل له أن يلج النار أبدا إلا تحلة الرحمان ، ومن كذب علي فليتبوأ بيتا في جهنم ) )(@)(@@) ( طب ) عن سعد بن المدحاس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22458 ) قال النبي :(@)(@@) | 30 ( من علم الرمي ونسيه فهي نعمة جحدها ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22459 ) قال النبي :(@)(@@) | 30 ( من علم علما ثم كتمه ألجمه الله يوم القيامة بلجام من نار ) )(@)(@@) ابن النجار عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22460 ) قال النبي :(@)(@@) | 30 ( من علم من أخيه سبة فسترها عليه ستر الله عليه يوم القيامة ) )(@)(@@) ( طب ) عن عقبة بن عامر وسلمة بن مخلد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22461 ) قال النبي :(@)(@@) | 30 ( من علم رجلا القرآن فهو مولاه لا يخذله ولا يستأثر عليه ) )(@)(@@) ( هب ) عن حماد الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22462 ) قال النبي 
