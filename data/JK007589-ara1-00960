ms941	 % 89(@)(@@) % بل حمى جسمها وقد أسلمته % رقة سابرية لانحلال % 90(@)(@@) % مستعار رنوها من مهاة % مستعار عطوها من غزال % % PageV01P3702 91(@)(@@) % بل هي المستعار ذلك منها % % للمها والظباء غير انتحال % 92(@)(@@) % ظبية إن عطت جنت ثمرات % من قلوب ولم تنش غصن ضال % 93(@)(@@) % ذات جيد عطوله أحسن الحل % % ي عليه وليس بالمعطال % 94(@)(@@) % روضة الليل عاطر النشر فيه % % حين تعتل نكهة المنفال % % 95(@)(@@) % أيما منظر تزودت منه % % يوم ردت جمالها لاحتمال % % 96(@)(@@) % ذات يوم رأيتها فيه مليء % للعين من بهجة وحسن دلال % 97(@)(@@) % لبست حلة الشباب وظلت % تتهادى في غصنه الميال % 98(@)(@@) % صبغة أرجوانية في صفاء % وقوام مهفهف في اعتدال % 99(@)(@@) % وزهاها سواد فرع بهيم % فهي سكرى لذاك سكر اختيال % 100(@)(@@) % لتزد في اختيالها ولعمري % % إنها في مزية المختال % PageV01P3703 101(@)(@@) % أقبلت في القبول تمشي الهوينا % % وهي حسنا كالحظ في الإقبال % 102(@)(@@) % قد تجلت على محاسن ليست % عند فقد الحلي والإعطال % 103(@)(@@) % ظاهرت شكة عليها بأخرى % % لامرىء غير مؤذن بقتال % 104(@)(@@) % ويح أعدائها أذلك منها % % فرط حشد لحاسر معزال % 105(@)(@@) % لاتظاهر سلاحها لمحب % فكفاه بسهمها القتال % 106(@)(@@) % أيها العائبي بخفة لحمي % % بجلى منه كسوة الأوصال % 107(@)(@@) % وهنيئا لك الفضول من اللح % % م ففاخر بها ذوات الحجال % 108(@)(@@) % قل ما توجد الفضائل إلا % % في خفاف الرجال دون الثقال % 109(@)(@@) % ينظم الدر في السلوك وتأبى % % عزة الدر نظمه في الحبال % 110(@)(@@) % كم غليظ من الرجال ثقيل % ناقص الوزن شائل المثال % PageV01P3704 111(@)(@@) % من أناس أوتوا حلوم العصافي % % ر فلم تغنهم جسوم البغال % 112(@)(@@) % وقضيف من الرجال خفيف % راجح الوزن عند وزن الرجال % % 113(@)(@@) % مكن أناس ذوي جسوم شخات % قد أمرت على نفوس نبال % 114(@)(@@) % حظهم وافر من الروح روح ال % % له لاوافر من الصلصال % % 115(@)(@@) % لم يخالطهم من الحمأ المس % % نون إلا طيف كطيف الخيال % 116(@)(@@) % من كهول جحاجح تعرف الحن % % كة فيهم وفتية أزوال % 117(@)(@@) % خلقوا للخطوب يمضون فيها % % فهم مرهفون مثل النصال % 118(@)(@@) % يتلظون حدة وذكاء % كتلظي ثوائر الأصلال % 119(@)(@@) % يستشفون رقة وصفاء % عن 
ms942	 رقيق من الطباع زلال % 120(@)(@@) % مثل ما تستشف آنية البل % لور عن ماء مزنة سلسال % % PageV01P3705 121(@)(@@) % بين تلك الثياب أرواح نور % علقت منهم بأشبال آل % 122(@)(@@) % جثث لطفت على قدر الأر % % واح إن الآلات كالعمال % 123(@)(@@) % لم تكن آلة ليخلقها الخا % % لق إلا شبيهة المؤتال % 124(@)(@@) % هم مفاتيح كل قفل عسير % وأطباء كل داء عضال % 125(@)(@@) % هم مصابيح كل ليل بهيم % وأدلاء كل أمر ضلال % 126(@)(@@) % فليعب عائب سواهم وإلا % % فليلاطم أسنة في عوال % 127(@)(@@) % ما يعيب العماة لولا عماهم % % من مصابيح أذكيت في ذبال % 128(@)(@@) % لو رأى الله أن في البدن فضلا % ما زوى الفضل عن علي المعالي % % 129(@)(@@) % ما زوى الله عن علي بن يحيى % % وزواه عني فلست أبالي % % 130(@)(@@) % من فتى أسمن المكارم حتى % % هزلته وحبذا من هزال % PageV01P3706 131(@)(@@) % لم يثقل ولم يشذب وإن كا % % نت له هيبة الطوال البجال % % 132(@)(@@) % طاله بالعظام قوم فأضحى % % بمساعيه وهو فوق الطوال % 133(@)(@@) % فليطلهم بالصالحات البواقي % % وليطولوه بالعظام البوالي % % 134(@)(@@) % ماجد سائر الندى في فياف % مقفرات منأهله أفلال % 135(@)(@@) % سالكا فجه بغير صحاب % وهو ما شئت من مهيب مهال % % 136(@)(@@) % يا لقوم لأنسه وهداه % بين تلك المهامه الأغفال % 137(@)(@@) % أآنسته من مجده مؤنسات % أوحشته بقلة الأشكال % % 138(@)(@@) % وهداه من وجهه ضوء بدر % نوره الدهر غير ذي اضمحلال % 139(@)(@@) % من رجال توقلوا في المعالي % % بالمساعي توقل الأوعال % 140(@)(@@) % بل ترقى إلى العلا طالبوها % % وتدلى إلى العلا من معال % PageV01P3707 141(@)(@@) % منحته فضوله كل فضل % حل بين النبيل والتنبال % 142(@)(@@) % بل أبى بذله الفضول تعد % من ظلوم كرائم الأموال % 143(@)(@@) % يفضل المفضلون إلا ابن يحيى % % فهو عال عن خطة الإفضال % 144(@)(@@) % غير راض لسائليه بقصد % عند إثرائه ولا إقلال % 145(@)(@@) % فإذا ماله تعذر وصى % % جاهه بعده على السؤال % 146(@)(@@) % فتراه لهم رشاء وطورا % جمة يستقونها بالعقال % % 147(@)(@@) % كل من يبن لا يبن من النا % % س عيال عليه أو كالعيال % 148(@)(@@) % ما يقاسي العفاة من عض دهر % ما يقاسى فيهم من العذال % 149(@)(@@) % بل 
ms943	 هو المرء يحجم العذل عنه % % لا لخوف الخنا بل الإجلال % 150(@)(@@) % يتبارى إليه وفدان شتى % % وفد شكر يحث وفد سؤال % PageV01P3708 151(@)(@@) % بل عطاياه لاتزال تباري % % وافدات إلى ذوي الآمال % % 152(@)(@@) % موغلات في كل فج من الأر % % ض تفوت الرياح في الأيقال % % 153(@)(@@) % بالغات إلى المقصر عنها % % نائلات بعيد كل منال % 154(@)(@@) % يرقد الطالبون وهي إليهم % % أرقات الوجيف والإرقال % 155(@)(@@) % رحلت نحو من تثاقل عنها % % وكفته مؤونة الترحال % 156(@)(@@) % لاتزل عنه نعمة لو أزيلت % لم تجد عنه وجهة للزوال % 157(@)(@@) % فلئن كان للرعية غيثا % أصبحت في حياه كالأهمال % 158(@)(@@) % إنه للجموح يجمح في الغي % ي لنكل من أعظم الأنكال % 159(@)(@@) % في يد الله والخليفة منه % % سيف كيد على ذوي الإخلال % 160(@)(@@) % هو أجلى عن الخليفة لما % % سلت السيف فتنة الجهال % PageV01P3709 161(@)(@@) % رد بالأمس عرقها في ثراهام طل دمع هريق في الأطلال % بعد إقوائها من الحلال % 162(@)(@@) % فل ما طلت الدماء اللواتي % % سفكتها سواكن الأطلال % % 163(@)(@@) % أي حق لها فيرعاه راع % من نوال لأهلها ووصال % 164(@)(@@) % فانصرافا عن الوقوف عليها % % إنها من مواقف الضلال % 165(@)(@@) % لن ترى الدهر موقفا لرشيد % يشتري النكس فيه بالإبلال % 166(@)(@@) % ليس تجدي على المسائل دار % غير هيج السقام بعد اندمال % % 167(@)(@@) % وكفاه بما تسلف منها % % من قديم الخبال بعد الخبال % 168(@)(@@) % تهجر الوحش كل واد عراه % مرة ذو حبالة أو نبال % 169(@)(@@) % وعساها لم تمن فيه برمي % % نالها صبرة ولا باحتبال % % 170(@)(@@) % وترى الناس يرأمون عراصا % يختبلن الصحيح أي اختبال % % PageV01P3710 171(@)(@@) % بعدما لقوا بها البرح المبر % رح من حابل ومن نبال % 172(@)(@@) % ولعمري لكانت الإنس أحجى % % باجتناب الأمور ذات الوبال % 173(@)(@@) % بل يظل الأسير منهم إذا فك % ك طويل الأسى على الأكبال % 174(@)(@@) % واقفا في معاهد الأسر يبكي % % من هوى آسراته غير سال % 175(@)(@@) % يتبع النفس كل بيضاء شالت % من دماء الرجال ذات انتقال % 176(@)(@@) % مع أني وإن رزئت عليهم % % واحتلبت الصبا بغير اكتهال % 177(@)(@@) % غير ناس على تناسي جهلي % % عهد أسماء بالحمى والمطال % 178(@)(@@) % من فتاة 
ms944	 تحل كل ربيع % بمغان من المها ومحلال % 179(@)(@@) % حين يغدو بنو الظباء فيلقو % % ن خليطي جآذر ورئال % % 180(@)(@@) % وكذاك الزمان يمحل بالإل % % فين محلا يجني بعاد زيال % % PageV01P3711 181(@)(@@) % حبذا عهدها الذي عاد شوقا % وحنينا إلى العهود الخوالي % % 182(@)(@@) % والزمان الذي لبسنا به العي % % ش جديدا كأنه برد حال % 183(@)(@@) % والمحل الذي تبدل عينا % بعد عين من الأنيس الخوالي % % 184(@)(@@) % إن نبادل بسكنه فعلى ضن % ن بتلك الأعلاق عند البدال % 185(@)(@@) % ليت شعري هل ذلك العهد مرجو % % ع بعطف من النوى وانفتال % 186(@)(@@) % إذ غصون اللجين لا البان منه % % فوق كثبان لؤلؤ لا رقال % % 187(@)(@@) % ليس غير العيون فيهن من نو % ر وغير الثدي من أحمال % 188(@)(@@) % بينها غادة تشارك فيها % % بهجة الشمس صورة التمثال % % 189(@)(@@) % من ذوات الحظوظ في البدن إلا % % طي بين الصدور والأكفال % 190(@)(@@) % تقسم الحلي بين قب خماص % تحت أثنائه وجسم خدال % PageV01P3712 191(@)(@@) % يتشاكى وشاحها وأخوه ضد % شكوى السوار والخلخال % 192(@)(@@) % جاع شاك وكظ شاك % وما ذاك لخبث الغذاء والإرقال % 193(@)(@@) % بلكلا الشاكيين نزل منها % % نزلا طيبا من الأنزال % % 194(@)(@@) % شد من متنها هوى بعضها بعضا % وقد هم خصرها بانخزال % 195(@)(@@) % كاد لولاه أن يلين قضيب % من كثيب على شفير انهيال % 196(@)(@@) % بل حمى جسمها وقد أسلمته % رقة سابرية لانحلال % 197(@)(@@) % مستعار رنوها من مهاة % مستعار عطوها من غزال % % 198(@)(@@) % بل هي المستعار ذلك منها % % للمها والظباء غير انتحال % 199(@)(@@) % ظبية إن عطت جنت ثمرات % من قلوب ولم تنش غصن ضال % 200(@)(@@) % ذات جيد عطوله أحسن الحل % % ي عليه وليس بالمعطال % PageV01P3713 201(@)(@@) % روضة الليل عاطر النشر فيه % % حين تعتل نكهة المنفال % % 202(@)(@@) % أيما منظر تزودت منه % % يوم ردت جمالها لاحتمال % % 203(@)(@@) % ذات يوم رأيتها فيه مليء % للعين من بهجة وحسن دلال % 204(@)(@@) % لبست حلة الشباب وظلت % تتهادى في غصنه الميال % 205(@)(@@) % صبغة أرجوانية في صفاء % وقوام مهفهف في اعتدال % 206(@)(@@) % وزهاها سواد فرع بهيم % فهي سكرى لذاك سكر اختيال % 207(@)(@@) % لتزد في اختيالها ولعمري % % إنها في مزية 
ms945	 المختال % 208(@)(@@) % أقبلت في القبول تمشي الهوينا % % وهي حسنا كالحظ في الإقبال % 209(@)(@@) % قد تجلت على محاسن ليست % عند فقد الحلي والإعطال % 210(@)(@@) % ظاهرت شكة عليها بأخرى % % لامرىء غير مؤذن بقتال % PageV01P3714 211(@)(@@) % ويح أعدائها أذلك منها % % فرط حشد لحاسر معزال % 212(@)(@@) % لاتظاهر سلاحها لمحب % فكفاه بسهمها القتال % 213(@)(@@) % أيها العائبي بخفة لحمي % % بجلى منه كسوة الأوصال % 214(@)(@@) % وهنيئا لك الفضول من اللح % % م ففاخر بها ذوات الحجال % 215(@)(@@) % قل ما توجد الفضائل إلا % % في خفاف الرجال دون الثقال % 216(@)(@@) % ينظم الدر في السلوك وتأبى % % عزة الدر نظمه في الحبال % 217(@)(@@) % كم غليظ من الرجال ثقيل % ناقص الوزن شائل المثال % 218(@)(@@) % من أناس أوتوا حلوم العصافي % % ر فلم تغنهم جسوم البغال % 219(@)(@@) % وقضيف من الرجال خفيف % راجح الوزن عند وزن الرجال % % 220(@)(@@) % مكن أناس ذوي جسوم شخات % قد أمرت على نفوس نبال % PageV01P3715 221(@)(@@) % حظهم وافر من الروح روح ال % % له لاوافر من الصلصال % % 222(@)(@@) % لم يخالطهم من الحمأ المس % % نون إلا طيف كطيف الخيال % 223(@)(@@) % من كهول جحاجح تعرف الحن % % كة فيهم وفتية أزوال % 224(@)(@@) % خلقوا للخطوب يمضون فيها % % فهم مرهفون مثل النصال % 225(@)(@@) % يتلظون حدة وذكاء % كتلظي ثوائر الأصلال % 226(@)(@@) % يستشفون رقة وصفاء % عن رقيق من الطباع زلال % 227(@)(@@) % مثل ما تستشف آنية البل % لور عن ماء مزنة سلسال % % 228(@)(@@) % بين تلك الثياب أرواح نور % علقت منهم بأشبال آل % 229(@)(@@) % جثث لطفت على قدر الأر % % واح إن الآلات كالعمال % 230(@)(@@) % لم تكن آلة ليخلقها الخا % % لق إلا شبيهة المؤتال % PageV01P3716 231(@)(@@) % هم مفاتيح كل قفل عسير % وأطباء كل داء عضال % 232(@)(@@) % هم مصابيح كل ليل بهيم % وأدلاء كل أمر ضلال % 233(@)(@@) % فليعب عائب سواهم وإلا % % فليلاطم أسنة في عوال % 234(@)(@@) % ما يعيب العماة لولا عماهم % % من مصابيح أذكيت في ذبال % 235(@)(@@) % لو رأى الله أن في البدن فضلا % ما زوى الفضل عن علي المعالي % % 236(@)(@@) % ما زوى الله عن علي بن يحيى % % وزواه عني فلست أبالي % % 237(@)(@@) % من فتى أسمن المكارم 
ms946	 حتى % % هزلته وحبذا من هزال % 238(@)(@@) % لم يثقل ولم يشذب وإن كا % % نت له هيبة الطوال البجال % % 239(@)(@@) % طاله بالعظام قوم فأضحى % % بمساعيه وهو فوق الطوال % 240(@)(@@) % فليطلهم بالصالحات البواقي % % وليطولوه بالعظام البوالي % % PageV01P3717 241(@)(@@) % ماجد سائر الندى في فياف % مقفرات منأهله أفلال % 242(@)(@@) % سالكا فجه بغير صحاب % وهو ما شئت من مهيب مهال % % 243(@)(@@) % يا لقوم لأنسه وهداه % بين تلك المهامه الأغفال % 244(@)(@@) % أآنسته من مجده مؤنسات % أوحشته بقلة الأشكال % % 245(@)(@@) % وهداه من وجهه ضوء بدر % نوره الدهر غير ذي اضمحلال % 246(@)(@@) % من رجال توقلوا في المعالي % % بالمساعي توقل الأوعال % 247(@)(@@) % بل ترقى إلى العلا طالبوها % % وتدلى إلى العلا من معال % 248(@)(@@) % منحته فضوله كل فضل % حل بين النبيل والتنبال % 249(@)(@@) % بل أبى بذله الفضول تعد % من ظلوم كرائم الأموال % 250(@)(@@) % يفضل المفضلون إلا ابن يحيى % % فهو عال عن خطة الإفضال % PageV01P3718 251(@)(@@) % غير راض لسائليه بقصد % عند إثرائه ولا إقلال % 252(@)(@@) % فإذا ماله تعذر وصى % % جاهه بعده على السؤال % 253(@)(@@) % فتراه لهم رشاء وطورا % جمة يستقونها بالعقال % % 254(@)(@@) % كل من يبن لا يبن من النا % % س عيال عليه أو كالعيال % 255(@)(@@) % ما يقاسي العفاة من عض دهر % ما يقاسى فيهم من العذال % 256(@)(@@) % بل هو المرء يحجم العذل عنه % % لا لخوف الخنا بل الإجلال % 257(@)(@@) % يتبارى إليه وفدان شتى % % وفد شكر يحث وفد سؤال % 258(@)(@@) % بل عطاياه لاتزال تباري % % وافدات إلى ذوي الآمال % % 259(@)(@@) % موغلات في كل فج من الأر % % ض تفوت الرياح في الأيقال % % 260(@)(@@) % بالغات إلى المقصر عنها % % نائلات بعيد كل منال % PageV01P3719 261(@)(@@) % يرقد الطالبون وهي إليهم % % أرقات الوجيف والإرقال % 262(@)(@@) % رحلت نحو من تثاقل عنها % % وكفته مؤونة الترحال % 263(@)(@@) % لاتزل عنه نعمة لو أزيلت % لم تجد عنه وجهة للزوال % 264(@)(@@) % فلئن كان للرعية غيثا % أصبحت في حياه كالأهمال % 265(@)(@@) % إنه للجموح يجمح في الغي % ي لنكل من أعظم الأنكال % 266(@)(@@) % في يد الله والخليفة منه % % سيف كيد على ذوي الإخلال % 267(@)(@@) % هو أجلى عن الخليفة لما % % سلت 
ms947	 السيف فتنة الجهال % 268(@)(@@) % رد بالأمس عرقها في ثراهاه % % نابتا بعد أيما استئصال % 269(@)(@@) % أسندت ركنها إليه فأرسى % % ولقد كان زال كل مزال % 270(@)(@@) % آلها أولها وحق لأمر % آله أن يؤول خير مآل % PageV01P3720 271(@)(@@) % لم يكن للصفاح لولا علي % شوكة في العدى ولا للإلال % 272(@)(@@) % كيده كاد حد كل سنان % وشبا كل مرهف فصال % % 273(@)(@@) % كان مثل الرحا هناك وكانت % عدد الحرب كلها كالثفال % 274(@)(@@) % أيها السائلي بجمع ابن ليث % % لج ذاك النعام في الإجفال % 275(@)(@@) % قفلوا خاسرين بل أقفل القو % م وهم كارهون للإقفال % 276(@)(@@) % بل عدت جلهم عوادي المنايا % % عن نوى المقفلين والقفال % 277(@)(@@) % فجلتهم مثقفات ظماء % تتقيها النحور بالإرغال % 278(@)(@@) % ظل مرانهن أشطان موت % % لدلاهن في الصدور تدال % 279(@)(@@) % وفلتهم مهندات حداد % تحسن الفلي عن سواء المفالي % % 280(@)(@@) % فثوى هامهم بمثوى هوان % ليس فيه سوى الرياح فوالي % % PageV01P3721 281(@)(@@) % قد أذيلت لهم لحى كالجوا % % ليق تليها عنافق كالمخالي % % 282(@)(@@) % ونجا فلهم على فل خيل % كن أقبلن كالقطا الأرسال % % 283(@)(@@) % بعدما قدروا لهن مروجا % من سيوح مريعة ودوالي % % 284(@)(@@) % بين بغداد والحديثة يخصم % ن بها الريف آمنات الرعال % 285(@)(@@) % أمل القوم ثوبة البدن فيهن % ن فأعجلن ثوبة الأبوال % 286(@)(@@) % صادفوا دون ذاك شوك القنا ال % % لدن وودوا لو كان شوك السيال % 287(@)(@@) % أسرعت فيهم مكائد كانت % % قبل دبت لهم دبيب النمال % 288(@)(@@) % بث منها الحكيم فيهم سهاما م طل دمع هريق في الأطلال % بعد إقوائها من الحلال % 289(@)(@@) % فل ما طلت الدماء اللواتي % % سفكتها سواكن الأطلال % % 290(@)(@@) % أي حق لها فيرعاه راع % من نوال لأهلها ووصال % PageV01P3722 291(@)(@@) % فانصرافا عن الوقوف عليها % % إنها من مواقف الضلال % 292(@)(@@) % لن ترى الدهر موقفا لرشيد % يشتري النكس فيه بالإبلال % 293(@)(@@) % ليس تجدي على المسائل دار % غير هيج السقام بعد اندمال % % 294(@)(@@) % وكفاه بما تسلف منها % % من قديم الخبال بعد الخبال % 295(@)(@@) % تهجر الوحش كل واد عراه % مرة ذو حبالة أو نبال % 296(@)(@@) % وعساها لم تمن فيه برمي % % نالها صبرة ولا باحتبال % % 297(@)(@@) % وترى 
ms948	 الناس يرأمون عراصا % يختبلن الصحيح أي اختبال % % 298(@)(@@) % بعدما لقوا بها البرح المبر % رح من حابل ومن نبال % 299(@)(@@) % ولعمري لكانت الإنس أحجى % % باجتناب الأمور ذات الوبال % 300(@)(@@) % بل يظل الأسير منهم إذا فك % ك طويل الأسى على الأكبال % PageV01P3723 301(@)(@@) % واقفا في معاهد الأسر يبكي % % من هوى آسراته غير سال % 302(@)(@@) % يتبع النفس كل بيضاء شالت % من دماء الرجال ذات انتقال % 303(@)(@@) % مع أني وإن رزئت عليهم % % واحتلبت الصبا بغير اكتهال % 304(@)(@@) % غير ناس على تناسي جهلي % % عهد أسماء بالحمى والمطال % 305(@)(@@) % من فتاة تحل كل ربيع % بمغان من المها ومحلال % 306(@)(@@) % حين يغدو بنو الظباء فيلقو % % ن خليطي جآذر ورئال % % 307(@)(@@) % وكذاك الزمان يمحل بالإل % % فين محلا يجني بعاد زيال % % 308(@)(@@) % حبذا عهدها الذي عاد شوقا % وحنينا إلى العهود الخوالي % % 309(@)(@@) % والزمان الذي لبسنا به العي % % ش جديدا كأنه برد حال % 310(@)(@@) % والمحل الذي تبدل عينا % بعد عين من الأنيس الخوالي % % PageV01P3724 311(@)(@@) % إن نبادل بسكنه فعلى ضن % ن بتلك الأعلاق عند البدال % 312(@)(@@) % ليت شعري هل ذلك العهد مرجو % % ع بعطف من النوى وانفتال % 313(@)(@@) % إذ غصون اللجين لا البان منه % % فوق كثبان لؤلؤ لا رقال % % 314(@)(@@) % ليس غير العيون فيهن من نو % ر وغير الثدي من أحمال % 315(@)(@@) % بينها غادة تشارك فيها % % بهجة الشمس صورة التمثال % % 316(@)(@@) % من ذوات الحظوظ في البدن إلا % % طي بين الصدور والأكفال % 317(@)(@@) % تقسم الحلي بين قب خماص % تحت أثنائه وجسم خدال % 318(@)(@@) % يتشاكى وشاحها وأخوه ضد % شكوى السوار والخلخال % 319(@)(@@) % جاع شاك وكظ شاك % وما ذاك لخبث الغذاء والإرقال % 320(@)(@@) % بلكلا الشاكيين نزل منها % % نزلا طيبا من الأنزال % % PageV01P3725 321(@)(@@) % شد من متنها هوى بعضها بعضا % وقد هم خصرها بانخزال % 322(@)(@@) % كاد لولاه أن يلين قضيب % من كثيب على شفير انهيال % 323(@)(@@) % بل حمى جسمها وقد أسلمته % رقة سابرية لانحلال % 324(@)(@@) % مستعار رنوها من مهاة % مستعار عطوها من غزال % % 325(@)(@@) % بل هي المستعار ذلك منها % % للمها والظباء غير انتحال % 326(@)(@@) % ظبية إن عطت 
ms949	 جنت ثمرات % من قلوب ولم تنش غصن ضال % 327(@)(@@) % ذات جيد عطوله أحسن الحل % % ي عليه وليس بالمعطال % 328(@)(@@) % روضة الليل عاطر النشر فيه % % حين تعتل نكهة المنفال % % 329(@)(@@) % أيما منظر تزودت منه % % يوم ردت جمالها لاحتمال % % 330(@)(@@) % ذات يوم رأيتها فيه مليء % للعين من بهجة وحسن دلال % PageV01P3726 331(@)(@@) % لبست حلة الشباب وظلت % تتهادى في غصنه الميال % 332(@)(@@) % صبغة أرجوانية في صفاء % وقوام مهفهف في اعتدال % 333(@)(@@) % وزهاها سواد فرع بهيم % فهي سكرى لذاك سكر اختيال % 334(@)(@@) % لتزد في اختيالها ولعمري % % إنها في مزية المختال % 335(@)(@@) % أقبلت في القبول تمشي الهوينا % % وهي حسنا كالحظ في الإقبال % 336(@)(@@) % قد تجلت على محاسن ليست % عند فقد الحلي والإعطال % 337(@)(@@) % ظاهرت شكة عليها بأخرى % % لامرىء غير مؤذن بقتال % 338(@)(@@) % ويح أعدائها أذلك منها % % فرط حشد لحاسر معزال % 339(@)(@@) % لاتظاهر سلاحها لمحب % فكفاه بسهمها القتال % 340(@)(@@) % أيها العائبي بخفة لحمي % % بجلى منه كسوة الأوصال % PageV01P3727 341(@)(@@) % وهنيئا لك الفضول من اللح % % م ففاخر بها ذوات الحجال % 342(@)(@@) % قل ما توجد الفضائل إلا % % في خفاف الرجال دون الثقال % 343(@)(@@) % ينظم الدر في السلوك وتأبى % % عزة الدر نظمه في الحبال % 344(@)(@@) % كم غليظ من الرجال ثقيل % ناقص الوزن شائل المثال % 345(@)(@@) % من أناس أوتوا حلوم العصافي % % ر فلم تغنهم جسوم البغال % 346(@)(@@) % وقضيف من الرجال خفيف % راجح الوزن عند وزن الرجال % % 347(@)(@@) % مكن أناس ذوي جسوم شخات % قد أمرت على نفوس نبال % 348(@)(@@) % حظهم وافر من الروح روح ال % % له لاوافر من الصلصال % % 349(@)(@@) % لم يخالطهم من الحمأ المس % % نون إلا طيف كطيف الخيال % 350(@)(@@) % من كهول جحاجح تعرف الحن % % كة فيهم وفتية أزوال % PageV01P3728 351(@)(@@) % خلقوا للخطوب يمضون فيها % % فهم مرهفون مثل النصال % 352(@)(@@) % يتلظون حدة وذكاء % كتلظي ثوائر الأصلال % 353(@)(@@) % يستشفون رقة وصفاء % عن رقيق من الطباع زلال % 354(@)(@@) % مثل ما تستشف آنية البل % لور عن ماء مزنة سلسال % % 355(@)(@@) % بين تلك الثياب أرواح نور % علقت منهم بأشبال آل % 356(@)(@@) % جثث لطفت على قدر الأر % % واح 
ms950	 إن الآلات كالعمال % 357(@)(@@) % لم تكن آلة ليخلقها الخا % % لق إلا شبيهة المؤتال % 358(@)(@@) % هم مفاتيح كل قفل عسير % وأطباء كل داء عضال % 359(@)(@@) % هم مصابيح كل ليل بهيم % وأدلاء كل أمر ضلال % 360(@)(@@) % فليعب عائب سواهم وإلا % % فليلاطم أسنة في عوال % PageV01P3729 361(@)(@@) % ما يعيب العماة لولا عماهم % % من مصابيح أذكيت في ذبال % 362(@)(@@) % لو رأى الله أن في البدن فضلا % ما زوى الفضل عن علي المعالي % % 363(@)(@@) % ما زوى الله عن علي بن يحيى % % وزواه عني فلست أبالي % % 364(@)(@@) % من فتى أسمن المكارم حتى % % هزلته وحبذا من هزال % 365(@)(@@) % لم يثقل ولم يشذب وإن كا % % نت له هيبة الطوال البجال % % 366(@)(@@) % طاله بالعظام قوم فأضحى % % بمساعيه وهو فوق الطوال % 367(@)(@@) % فليطلهم بالصالحات البواقي % % وليطولوه بالعظام البوالي % % 368(@)(@@) % ماجد سائر الندى في فياف % مقفرات منأهله أفلال % 369(@)(@@) % سالكا فجه بغير صحاب % وهو ما شئت من مهيب مهال % % 370(@)(@@) % يا لقوم لأنسه وهداه % بين تلك المهامه الأغفال % PageV01P3730 371(@)(@@) % أآنسته من مجده مؤنسات % أوحشته بقلة الأشكال % % 372(@)(@@) % وهداه من وجهه ضوء بدر % نوره الدهر غير ذي اضمحلال % 373(@)(@@) % من رجال توقلوا في المعالي % % بالمساعي توقل الأوعال % 374(@)(@@) % بل ترقى إلى العلا طالبوها % % وتدلى إلى العلا من معال % 375(@)(@@) % منحته فضوله كل فضل % حل بين النبيل والتنبال % 376(@)(@@) % بل أبى بذله الفضول تعد % من ظلوم كرائم الأموال % 377(@)(@@) % يفضل المفضلون إلا ابن يحيى % % فهو عال عن خطة الإفضال % 378(@)(@@) % غير راض لسائليه بقصد % عند إثرائه ولا إقلال % 379(@)(@@) % فإذا ماله تعذر وصى % % جاهه بعده على السؤال % 380(@)(@@) % فتراه لهم رشاء وطورا % جمة يستقونها بالعقال % % PageV01P3731 381(@)(@@) % كل من يبن لا يبن من النا % % س عيال عليه أو كالعيال % 382(@)(@@) % ما يقاسي العفاة من عض دهر % ما يقاسى فيهم من العذال % 383(@)(@@) % بل هو المرء يحجم العذل عنه % % لا لخوف الخنا بل الإجلال % 384(@)(@@) % يتبارى إليه وفدان شتى % % وفد شكر يحث وفد سؤال % 385(@)(@@) % بل عطاياه لاتزال تباري % % وافدات إلى ذوي الآمال % % 386(@)(@@) % موغلات في 
ms951	 كل فج من الأر % % ض تفوت الرياح في الأيقال % % 387(@)(@@) % بالغات إلى المقصر عنها % % نائلات بعيد كل منال % 388(@)(@@) % يرقد الطالبون وهي إليهم % % أرقات الوجيف والإرقال % 389(@)(@@) % رحلت نحو من تثاقل عنها % % وكفته مؤونة الترحال % 390(@)(@@) % لاتزل عنه نعمة لو أزيلت % لم تجد عنه وجهة للزوال % PageV01P3732 391(@)(@@) % فلئن كان للرعية غيثا % أصبحت في حياه كالأهمال % 392(@)(@@) % إنه للجموح يجمح في الغي % ي لنكل من أعظم الأنكال % 393(@)(@@) % في يد الله والخليفة منه % % سيف كيد على ذوي الإخلال % 394(@)(@@) % هو أجلى عن الخليفة لما % % سلت السيف فتنة الجهال % 395(@)(@@) % رد بالأمس عرقها في ثراها % % نابتا بعد أيما استئصال % 396(@)(@@) % أسندت ركنها إليه فأرسى % % ولقد كان زال كل مزال % 397(@)(@@) % آلها أولها وحق لأمر % آله أن يؤول خير مآل % 398(@)(@@) % لم يكن للصفاح لولا علي % شوكة في العدى ولا للإلال % 399(@)(@@) % كيده كاد حد كل سنان % وشبا كل مرهف فصال % % 400(@)(@@) % كان مثل الرحا هناك وكانت % عدد الحرب كلها كالثفال % PageV01P3733 401(@)(@@) % أيها السائلي بجمع ابن ليث % % لج ذاك النعام في الإجفال % 402(@)(@@) % قفلوا خاسرين بل أقفل القو % م وهم كارهون للإقفال % 403(@)(@@) % بل عدت جلهم عوادي المنايا % % عن نوى المقفلين والقفال % 404(@)(@@) % فجلتهم مثقفات ظماء % تتقيها النحور بالإرغال % 405(@)(@@) % ظل مرانهن أشطان موت % % لدلاهن في الصدور تدال % 406(@)(@@) % وفلتهم مهندات حداد % تحسن الفلي عن سواء المفالي % % 407(@)(@@) % فثوى هامهم بمثوى هوان % ليس فيه سوى الرياح فوالي % % 408(@)(@@) % قد أذيلت لهم لحى كالجوا % % ليق تليها عنافق كالمخالي % % 409(@)(@@) % ونجا فلهم على فل خيل % كن أقبلن كالقطا الأرسال % % 410(@)(@@) % بعدما قدروا لهن مروجا % من سيوح مريعة ودوالي % % PageV01P3734 411(@)(@@) % بين بغداد والحديثة يخصم % ن بها الريف آمنات الرعال % 412(@)(@@) % أمل القوم ثوبة البدن فيهن % ن فأعجلن ثوبة الأبوال % 413(@)(@@) % صادفوا دون ذاك شوك القنا ال % % لدن وودوا لو كان شوك السيال % 414(@)(@@) % أسرعت فيهم مكائد كانت % % قبل دبت لهم دبيب النمال % 415(@)(@@) % بث منها الحكيم فيهم سهاما ه % % وقعت في مواضع الآجال % 416(@)(@@) % يا ابن 
ms952	 يحيى حلفت لو غبت عنها % % أعضل الداء أيما إعضال % 417(@)(@@) % بهداك اهتدت حيارى المنايا % % يوم ضلت مقاتل الأقيال % 418(@)(@@) % ظاهر الأولياء منك ظهيرا % ناصح الجيب غير ذي إدغال % 419(@)(@@) % يوم جاء الصفار تكنفه الكف % فار حمر العيون صهب السبال % 420(@)(@@) % بخميس له لجيب صهيل % راغ في عرضه رغاء الجمال % PageV01P3735 421(@)(@@) % فيه مستلئمون كالجلة الجر % ب طلاهن بالعبيبة طال % 422(@)(@@) % غير أن احتكاكهن من العر % ر بحد اللقاء لا الأجذال % 423(@)(@@) % أقبلوا مقبلا تمخض منه % % حاملا كالنساء بالأحمال % 424(@)(@@) % فوق شقر من الحرائر جرد % % لاحقات البطون بالآطال % 425(@)(@@) % مسرجات مجللات تجافي % % ف حديد مواضع الأجلال % 426(@)(@@) % ملبسات من التهاويل زيا % يستفز القلوب قبل التبال % % 427(@)(@@) % راعت الناس يوم ذلك حتى % % قال قوم أخيلهم أم سعالي % % 428(@)(@@) % وأبى قلبك المشيع إلا % % جرأة الليث مثلك الرئبال % 429(@)(@@) % فتفاءلت إذ بدت في شعور % كشعور المعيز أصدق فال % 430(@)(@@) % قلت شاء مجنبات لأسد % عودت جرها إلى الأشبال % PageV01P3736 431(@)(@@) % والموالي بمسمع من ولي % جاهد النصر ليس بالخذال % % 432(@)(@@) % واستثاروا عجاجة الكر قدما % مشرعي كل ذابل عسال % % 433(@)(@@) % من رماح إذا عسلن تضمن % ن قرا كل عاسل بسال % % 434(@)(@@) % قد مشت فيهم حميا حفاظ % كحميا سلافة الجريال % % 435(@)(@@) % بعدما سهلت لهم سبل ال % % كر بتدبير ناقض فتال % % 436(@)(@@) % راض بالرأي مصعب الخطب حتى % % عاد مثل الطليح في التذلال % % 437(@)(@@) % وجرت عند كرهم ريح نصر م طل دمع هريق في الأطلال % بعد إقوائها من الحلال % 438(@)(@@) % فل ما طلت الدماء اللواتي % % سفكتها سواكن الأطلال % % 439(@)(@@) % أي حق لها فيرعاه راع % من نوال لأهلها ووصال % 440(@)(@@) % فانصرافا عن الوقوف عليها % % إنها من مواقف الضلال % PageV01P3737 441(@)(@@) % لن ترى الدهر موقفا لرشيد % يشتري النكس فيه بالإبلال % 442(@)(@@) % ليس تجدي على المسائل دار % غير هيج السقام بعد اندمال % % 443(@)(@@) % وكفاه بما تسلف منها % % من قديم الخبال بعد الخبال % 444(@)(@@) % تهجر الوحش كل واد عراه % مرة ذو حبالة أو نبال % 445(@)(@@) % وعساها لم تمن فيه برمي % % نالها صبرة ولا باحتبال % % 446(@)(@@) % وترى الناس 
ms953	 يرأمون عراصا % يختبلن الصحيح أي اختبال % % 447(@)(@@) % بعدما لقوا بها البرح المبر % رح من حابل ومن نبال % 448(@)(@@) % ولعمري لكانت الإنس أحجى % % باجتناب الأمور ذات الوبال % 449(@)(@@) % بل يظل الأسير منهم إذا فك % ك طويل الأسى على الأكبال % 450(@)(@@) % واقفا في معاهد الأسر يبكي % % من هوى آسراته غير سال % PageV01P3738 451(@)(@@) % يتبع النفس كل بيضاء شالت % من دماء الرجال ذات انتقال % 452(@)(@@) % مع أني وإن رزئت عليهم % % واحتلبت الصبا بغير اكتهال % 453(@)(@@) % غير ناس على تناسي جهلي % % عهد أسماء بالحمى والمطال % 454(@)(@@) % من فتاة تحل كل ربيع % بمغان من المها ومحلال % 455(@)(@@) % حين يغدو بنو الظباء فيلقو % % ن خليطي جآذر ورئال % % 456(@)(@@) % وكذاك الزمان يمحل بالإل % % فين محلا يجني بعاد زيال % % 457(@)(@@) % حبذا عهدها الذي عاد شوقا % وحنينا إلى العهود الخوالي % % 458(@)(@@) % والزمان الذي لبسنا به العي % % ش جديدا كأنه برد حال % 459(@)(@@) % والمحل الذي تبدل عينا % بعد عين من الأنيس الخوالي % % 460(@)(@@) % إن نبادل بسكنه فعلى ضن % ن بتلك الأعلاق عند البدال % PageV01P3739 461(@)(@@) % ليت شعري هل ذلك العهد مرجو % % ع بعطف من النوى وانفتال % 462(@)(@@) % إذ غصون اللجين لا البان منه % % فوق كثبان لؤلؤ لا رقال % % 463(@)(@@) % ليس غير العيون فيهن من نو % ر وغير الثدي من أحمال % 464(@)(@@) % بينها غادة تشارك فيها % % بهجة الشمس صورة التمثال % % 465(@)(@@) % من ذوات الحظوظ في البدن إلا % % طي بين الصدور والأكفال % 466(@)(@@) % تقسم الحلي بين قب خماص % تحت أثنائه وجسم خدال % 467(@)(@@) % يتشاكى وشاحها وأخوه ضد % شكوى السوار والخلخال % 468(@)(@@) % جاع شاك وكظ شاك % وما ذاك لخبث الغذاء والإرقال % 469(@)(@@) % بلكلا الشاكيين نزل منها % % نزلا طيبا من الأنزال % % 470(@)(@@) % شد من متنها هوى بعضها بعضا % وقد هم خصرها بانخزال % PageV01P3740 471(@)(@@) % كاد لولاه أن يلين قضيب % من كثيب على شفير انهيال % 472(@)(@@) % بل حمى جسمها وقد أسلمته % رقة سابرية لانحلال % 473(@)(@@) % مستعار رنوها من مهاة % مستعار عطوها من غزال % % 474(@)(@@) % بل هي المستعار ذلك منها % % للمها والظباء غير انتحال % 475(@)(@@) % ظبية إن عطت جنت 
ms954	 ثمرات % من قلوب ولم تنش غصن ضال % 476(@)(@@) % ذات جيد عطوله أحسن الحل % % ي عليه وليس بالمعطال % 477(@)(@@) % روضة الليل عاطر النشر فيه % % حين تعتل نكهة المنفال % % 478(@)(@@) % أيما منظر تزودت منه % % يوم ردت جمالها لاحتمال % % 479(@)(@@) % ذات يوم رأيتها فيه مليء % للعين من بهجة وحسن دلال % 480(@)(@@) % لبست حلة الشباب وظلت % تتهادى في غصنه الميال % PageV01P3741 481(@)(@@) % صبغة أرجوانية في صفاء % وقوام مهفهف في اعتدال % 482(@)(@@) % وزهاها سواد فرع بهيم % فهي سكرى لذاك سكر اختيال % 483(@)(@@) % لتزد في اختيالها ولعمري % % إنها في مزية المختال % 484(@)(@@) % أقبلت في القبول تمشي الهوينا % % وهي حسنا كالحظ في الإقبال % 485(@)(@@) % قد تجلت على محاسن ليست % عند فقد الحلي والإعطال % 486(@)(@@) % ظاهرت شكة عليها بأخرى % % لامرىء غير مؤذن بقتال % 487(@)(@@) % ويح أعدائها أذلك منها % % فرط حشد لحاسر معزال % 488(@)(@@) % لاتظاهر سلاحها لمحب % فكفاه بسهمها القتال % 489(@)(@@) % أيها العائبي بخفة لحمي % % بجلى منه كسوة الأوصال % 490(@)(@@) % وهنيئا لك الفضول من اللح % % م ففاخر بها ذوات الحجال % PageV01P3742 491(@)(@@) % قل ما توجد الفضائل إلا % % في خفاف الرجال دون الثقال % 492(@)(@@) % ينظم الدر في السلوك وتأبى % % عزة الدر نظمه في الحبال % 493(@)(@@) % كم غليظ من الرجال ثقيل % ناقص الوزن شائل المثال % 494(@)(@@) % من أناس أوتوا حلوم العصافي % % ر فلم تغنهم جسوم البغال % 495(@)(@@) % وقضيف من الرجال خفيف % راجح الوزن عند وزن الرجال % % 496(@)(@@) % مكن أناس ذوي جسوم شخات % قد أمرت على نفوس نبال % 497(@)(@@) % حظهم وافر من الروح روح ال % % له لاوافر من الصلصال % % 498(@)(@@) % لم يخالطهم من الحمأ المس % % نون إلا طيف كطيف الخيال % 499(@)(@@) % من كهول جحاجح تعرف الحن % % كة فيهم وفتية أزوال % 500(@)(@@) % خلقوا للخطوب يمضون فيها % % فهم مرهفون مثل النصال % PageV01P3743 501(@)(@@) % يتلظون حدة وذكاء % كتلظي ثوائر الأصلال % 502(@)(@@) % يستشفون رقة وصفاء % عن رقيق من الطباع زلال % 503(@)(@@) % مثل ما تستشف آنية البل % لور عن ماء مزنة سلسال % % 504(@)(@@) % بين تلك الثياب أرواح نور % علقت منهم بأشبال آل % 505(@)(@@) % جثث لطفت على قدر الأر % % واح إن 
ms955	 الآلات كالعمال % 506(@)(@@) % لم تكن آلة ليخلقها الخا % % لق إلا شبيهة المؤتال % 507(@)(@@) % هم مفاتيح كل قفل عسير % وأطباء كل داء عضال % 508(@)(@@) % هم مصابيح كل ليل بهيم % وأدلاء كل أمر ضلال % 509(@)(@@) % فليعب عائب سواهم وإلا % % فليلاطم أسنة في عوال % 510(@)(@@) % ما يعيب العماة لولا عماهم % % من مصابيح أذكيت في ذبال % PageV01P3744 511(@)(@@) % لو رأى الله أن في البدن فضلا % ما زوى الفضل عن علي المعالي % % 512(@)(@@) % ما زوى الله عن علي بن يحيى % % وزواه عني فلست أبالي % % 513(@)(@@) % من فتى أسمن المكارم حتى % % هزلته وحبذا من هزال % 514(@)(@@) % لم يثقل ولم يشذب وإن كا % % نت له هيبة الطوال البجال % % 515(@)(@@) % طاله بالعظام قوم فأضحى % % بمساعيه وهو فوق الطوال % 516(@)(@@) % فليطلهم بالصالحات البواقي % % وليطولوه بالعظام البوالي % % 517(@)(@@) % ماجد سائر الندى في فياف % مقفرات منأهله أفلال % 518(@)(@@) % سالكا فجه بغير صحاب % وهو ما شئت من مهيب مهال % % 519(@)(@@) % يا لقوم لأنسه وهداه % بين تلك المهامه الأغفال % 520(@)(@@) % أآنسته من مجده مؤنسات % أوحشته بقلة الأشكال % % PageV01P3745 521(@)(@@) % وهداه من وجهه ضوء بدر % نوره الدهر غير ذي اضمحلال % 522(@)(@@) % من رجال توقلوا في المعالي % % بالمساعي توقل الأوعال % 523(@)(@@) % بل ترقى إلى العلا طالبوها % % وتدلى إلى العلا من معال % 524(@)(@@) % منحته فضوله كل فضل % حل بين النبيل والتنبال % 525(@)(@@) % بل أبى بذله الفضول تعد % من ظلوم كرائم الأموال % 526(@)(@@) % يفضل المفضلون إلا ابن يحيى % % فهو عال عن خطة الإفضال % 527(@)(@@) % غير راض لسائليه بقصد % عند إثرائه ولا إقلال % 528(@)(@@) % فإذا ماله تعذر وصى % % جاهه بعده على السؤال % 529(@)(@@) % فتراه لهم رشاء وطورا % جمة يستقونها بالعقال % % 530(@)(@@) % كل من يبن لا يبن من النا % % س عيال عليه أو كالعيال % PageV01P3746 531(@)(@@) % ما يقاسي العفاة من عض دهر % ما يقاسى فيهم من العذال % 532(@)(@@) % بل هو المرء يحجم العذل عنه % % لا لخوف الخنا بل الإجلال % 533(@)(@@) % يتبارى إليه وفدان شتى % % وفد شكر يحث وفد سؤال % 534(@)(@@) % بل عطاياه لاتزال تباري % % وافدات إلى ذوي الآمال % % 535(@)(@@) % موغلات في كل 
ms956	 فج من الأر % % ض تفوت الرياح في الأيقال % % 536(@)(@@) % بالغات إلى المقصر عنها % % نائلات بعيد كل منال % 537(@)(@@) % يرقد الطالبون وهي إليهم % % أرقات الوجيف والإرقال % 538(@)(@@) % رحلت نحو من تثاقل عنها % % وكفته مؤونة الترحال % 539(@)(@@) % لاتزل عنه نعمة لو أزيلت % لم تجد عنه وجهة للزوال % 540(@)(@@) % فلئن كان للرعية غيثا % أصبحت في حياه كالأهمال % PageV01P3747 541(@)(@@) % إنه للجموح يجمح في الغي % ي لنكل من أعظم الأنكال % 542(@)(@@) % في يد الله والخليفة منه % % سيف كيد على ذوي الإخلال % 543(@)(@@) % هو أجلى عن الخليفة لما % % سلت السيف فتنة الجهال % 544(@)(@@) % رد بالأمس عرقها في ثراها % % نابتا بعد أيما استئصال % 545(@)(@@) % أسندت ركنها إليه فأرسى % % ولقد كان زال كل مزال % 546(@)(@@) % آلها أولها وحق لأمر % آله أن يؤول خير مآل % 547(@)(@@) % لم يكن للصفاح لولا علي % شوكة في العدى ولا للإلال % 548(@)(@@) % كيده كاد حد كل سنان % وشبا كل مرهف فصال % % 549(@)(@@) % كان مثل الرحا هناك وكانت % عدد الحرب كلها كالثفال % 550(@)(@@) % أيها السائلي بجمع ابن ليث % % لج ذاك النعام في الإجفال % PageV01P3748 551(@)(@@) % قفلوا خاسرين بل أقفل القو % م وهم كارهون للإقفال % 552(@)(@@) % بل عدت جلهم عوادي المنايا % % عن نوى المقفلين والقفال % 553(@)(@@) % فجلتهم مثقفات ظماء % تتقيها النحور بالإرغال % 554(@)(@@) % ظل مرانهن أشطان موت % % لدلاهن في الصدور تدال % 555(@)(@@) % وفلتهم مهندات حداد % تحسن الفلي عن سواء المفالي % % 556(@)(@@) % فثوى هامهم بمثوى هوان % ليس فيه سوى الرياح فوالي % % 557(@)(@@) % قد أذيلت لهم لحى كالجوا % % ليق تليها عنافق كالمخالي % % 558(@)(@@) % ونجا فلهم على فل خيل % كن أقبلن كالقطا الأرسال % % 559(@)(@@) % بعدما قدروا لهن مروجا % من سيوح مريعة ودوالي % % 560(@)(@@) % بين بغداد والحديثة يخصم % ن بها الريف آمنات الرعال % PageV01P3749 561(@)(@@) % أمل القوم ثوبة البدن فيهن % ن فأعجلن ثوبة الأبوال % 562(@)(@@) % صادفوا دون ذاك شوك القنا ال % % لدن وودوا لو كان شوك السيال % 563(@)(@@) % أسرعت فيهم مكائد كانت % % قبل دبت لهم دبيب النمال % 564(@)(@@) % بث منها الحكيم فيهم سهاما % وقعت في مواضع الآجال % 565(@)(@@) % يا ابن يحيى حلفت 
ms957	 لو غبت عنها % % أعضل الداء أيما إعضال % 566(@)(@@) % بهداك اهتدت حيارى المنايا % % يوم ضلت مقاتل الأقيال % 567(@)(@@) % ظاهر الأولياء منك ظهيرا % ناصح الجيب غير ذي إدغال % 568(@)(@@) % يوم جاء الصفار تكنفه الكف % فار حمر العيون صهب السبال % 569(@)(@@) % بخميس له لجيب صهيل % راغ في عرضه رغاء الجمال % 570(@)(@@) % فيه مستلئمون كالجلة الجر % ب طلاهن بالعبيبة طال % PageV01P3750 571(@)(@@) % غير أن احتكاكهن من العر % ر بحد اللقاء لا الأجذال % 572(@)(@@) % أقبلوا مقبلا تمخض منه % % حاملا كالنساء بالأحمال % 573(@)(@@) % فوق شقر من الحرائر جرد % % لاحقات البطون بالآطال % 574(@)(@@) % مسرجات مجللات تجافي % % ف حديد مواضع الأجلال % 575(@)(@@) % ملبسات من التهاويل زيا % يستفز القلوب قبل التبال % % 576(@)(@@) % راعت الناس يوم ذلك حتى % % قال قوم أخيلهم أم سعالي % % 577(@)(@@) % وأبى قلبك المشيع إلا % % جرأة الليث مثلك الرئبال % 578(@)(@@) % فتفاءلت إذ بدت في شعور % كشعور المعيز أصدق فال % 579(@)(@@) % قلت شاء مجنبات لأسد % عودت جرها إلى الأشبال % 580(@)(@@) % والموالي بمسمع من ولي % جاهد النصر ليس بالخذال % % PageV01P3751 581(@)(@@) % واستثاروا عجاجة الكر قدما % مشرعي كل ذابل عسال % % 582(@)(@@) % من رماح إذا عسلن تضمن % ن قرا كل عاسل بسال % % 583(@)(@@) % قد مشت فيهم حميا حفاظ % كحميا سلافة الجريال % % 584(@)(@@) % بعدما سهلت لهم سبل ال % % كر بتدبير ناقض فتال % % 585(@)(@@) % راض بالرأي مصعب الخطب حتى % % عاد مثل الطليح في التذلال % % 586(@)(@@) % وجرت عند كرهم ريح نصر ه % % تحت عثنون ذلك القسطال % % 587(@)(@@) % بابتهال امرىء تقي ذكي لي % % له قبل ذاك ليل ابتهال % 588(@)(@@) % فإذا الكلب عن حماهم طريد % قد كفاه الطراد دون النزال % 589(@)(@@) % صد عنهم وكان صبا إليهم % % حين لاقاهم صدود مقالي % % 590(@)(@@) % وتلته على الوحى واثقات % من صبيب الدماء بالأنعال % PageV01P3752 591(@)(@@) % غير مرتاعة لفور نجيع % من صريع ولا لصوت انجدال % 592(@)(@@) % فوقها طالبون كانوا قديما % يطلبون الإدبار بالإقبال % 593(@)(@@) % يتقاضون في الغلول نضالا % من ديون السلاح بعد نضال % 594(@)(@@) % لهم في الظهور سبح طويل % بعد طعن الكلى وضرب القلال % 595(@)(@@) % لم يخيموا عن النزال ولكن % % نزل النصر قبل دعوى 
ms958	 نزال % % 596(@)(@@) % شمروا في الوغى وذلل يعقو % % ب وألوى التشمير بالأسبال % 597(@)(@@) % والموالي مشمرون وكم % % ذيل حباه التشمير بالأسبال % % 598(@)(@@) % ذلل الحيل حين شمرت لل % % حرب فما زادها سوى الأثقال % 599(@)(@@) % ولعمر القنا الذي استدبرته % % لو تمتعن منه باستقبال % 600(@)(@@) % ضل يعقوب إذ يعد التهاوي % % ل لمن لا يهال بالأهوال % PageV01P3753 601(@)(@@) % لزمته زجاجها لعيون % ليس فيها كوالىء بل كوالي % % 602(@)(@@) % لا رأت يومك الفظيع الموالي % % فالموالي لما صنعت موالي % % 603(@)(@@) % كدت أعداءهم بكيد عظيم % % ذب للقوم في شخاص ضئال % 604(@)(@@) % فاجتلى هامهم بسيف دهاء % لم يزل قاطعا بغير استلال % 605(@)(@@) % وبك استيقظوا وقد زاول الغا % % در قبل القتال باب الختال % 606(@)(@@) % قلت إذ سطر الأساطير مهلا % رمت من لا يزل لاسترسال % 607(@)(@@) % أرسلوا نحوه السهام جوابا % لرسلاته وللإرسال % 608(@)(@@) % عظمت غفلة امرىء مبتداه % % رام من ذراك باستغفال % 609(@)(@@) % جادلت ترهاتهم فاستنز % % لتها إلى النار أيما إزلال % % 610(@)(@@) % حكمة منك ربما جعل السي % % ف لسانا لها غداة الجدال % PageV01P3754 611(@)(@@) % بعدما قلت لاسم كيدك زرهم % % مجلبا في عساكر الأرجال % 612(@)(@@) % فمضى بادئا ومعناه خا % % ف غير رعب يصول كل مصال % 613(@)(@@) % ظل لما أطل تنفل عنه % % عزمات الطغاة كل انفلال % 614(@)(@@) % وقديما ذكرت فاشتمل المجر % % على الرعب منك كل اشتمال % 615(@)(@@) % وغدا ربه يرى كل شيء % كائدا شديد المحال % 616(@)(@@) % وجلا قلبه بلا أخذ حذر % غير مافي حشاه من قلقال % 617(@)(@@) % لو تدلى إليه حبل من الله % % رآه حبلا من الأحبال % 618(@)(@@) % واسم كيد المجرب الكيد كي % د ظاهر قبل بطان ختال % % 619(@)(@@) % ليس ينفك صائلا في صدور % صولة بالقلوب قبل الصيال % 620(@)(@@) % ما عجبنا من انفلال ابن ليث % عن حسام لمثله فلال % % PageV01P3755 621(@)(@@) % حول يغرق المداهون منه % % في غمار يرونها كالضحال % 622(@)(@@) % بل لإقدامه مع الرعب لكن % % ساقه الحين راكب استبسال % % 623(@)(@@) % مستطار الفؤاد مشعر خوف % لا طمأنينة ولا استرسال % 624(@)(@@) % ثكلت أم من تعادي وما كن % % ت تعادي إلا بني مثكال % 625(@)(@@) % لك إطراقة إذا ناب خطب % هي أدهى من 
ms959	 سورة الأبطال % 626(@)(@@) % يستثير المكائد الصمع منها % % أي صل هناك في العرزال % % 627(@)(@@) % وقى الله ابن يحيى عن الأم % مة شرا قد هم باستفحال % 628(@)(@@) % فتنة كان أهلها قد تعدوا % % قدح نيرانها إلى الإشعال % 629(@)(@@) % أطفأتها دماؤهم بل سيوف % أبهلتهن أيما إبهال % 630(@)(@@) % وامرؤ مصلح إذا عاين القو % م أرادوا الأديم بالإنغال % % PageV01P3756 631(@)(@@) % جرد الرأي والعزيمة والجد % د وولى الوكال أهل الوكال % % 632(@)(@@) % ومضى كالقضاء يأذن في سف % ك دماء العدا لأسد بسال % 633(@)(@@) % وكذاك القضاء يأذن في القد % ل وفيه عن القتال تعالي % % 634(@)(@@) % قائل المدح في علي بن يحيى % % غير مستكره ولامحتال % 635(@)(@@) % بل إذا قاله أتته المعاني % % والقوافي تنثال أي انثيال % % 636(@)(@@) % لاتطالبه بالثواب فما رد % د ثواب من مثله بحلال % % 637(@)(@@) % لن يحل الثواب إلا إذا ما % % كان في المدح موضع لاعتمال % 638(@)(@@) % فاطو كشحا عن الثواب لديه % % والتمس نيل ماجد منه نال % 639(@)(@@) % بذل المال للرعية والنف % % س لراعيه ديدني بذال % 640(@)(@@) % للندى والردى مواطن كره % لايطاليه حرهن مصال % PageV01P3757 641(@)(@@) % ملك أورثته ساسان اليونا % % ن من والد وعم وخال % 642(@)(@@) % بيت نار وبيت نور من الحك % % مة طالا شواهق الأجبال % 643(@)(@@) % لست أنفك قائما يا بن يحيى % % فيك بالمدح غير ذي إخلال % 644(@)(@@) % وإلى الله بعد هذا تشكي % % حاجتي منك خلة الإغفال % 645(@)(@@) % أصبحت حاجتي إليك ترجى % % في عقال أمر من عقال % 646(@)(@@) % وأراني إليك دون أناس % لاتداني بحورهم أوشالي % % 647(@)(@@) % ولهذا ومثله غير شك % كان بين القوابل استهلالي % % 648(@)(@@) % ما بكاء الوليد إلا لأمر % حق من مثله مشيب القذال % % 649(@)(@@) % أتراه بكى من الروح والرح % % ب على غمة وضيق مجال % 650(@)(@@) % لا ولكن جلى هناك عليه % % ما سيلقى من العجائب جالي % % PageV01P3758 651(@)(@@) % أبصرت نفسه الذي هو لاق % فرأت منه منظرا لأهوال % 652(@)(@@) % من خطوب تغشى به كل حدم طل دمع هريق في الأطلال % بعد إقوائها من الحلال % 653(@)(@@) % فل ما طلت الدماء اللواتي % % سفكتها سواكن الأطلال % % 654(@)(@@) % أي حق لها فيرعاه راع % من نوال 
ms960	 لأهلها ووصال % 655(@)(@@) % فانصرافا عن الوقوف عليها % % إنها من مواقف الضلال % 656(@)(@@) % لن ترى الدهر موقفا لرشيد % يشتري النكس فيه بالإبلال % 657(@)(@@) % ليس تجدي على المسائل دار % غير هيج السقام بعد اندمال % % 658(@)(@@) % وكفاه بما تسلف منها % % من قديم الخبال بعد الخبال % 659(@)(@@) % تهجر الوحش كل واد عراه % مرة ذو حبالة أو نبال % 660(@)(@@) % وعساها لم تمن فيه برمي % % نالها صبرة ولا باحتبال % % PageV01P3759 661(@)(@@) % وترى الناس يرأمون عراصا % يختبلن الصحيح أي اختبال % % 662(@)(@@) % بعدما لقوا بها البرح المبر % رح من حابل ومن نبال % 663(@)(@@) % ولعمري لكانت الإنس أحجى % % باجتناب الأمور ذات الوبال % 664(@)(@@) % بل يظل الأسير منهم إذا فك % ك طويل الأسى على الأكبال % 665(@)(@@) % واقفا في معاهد الأسر يبكي % % من هوى آسراته غير سال % 666(@)(@@) % يتبع النفس كل بيضاء شالت % من دماء الرجال ذات انتقال % 667(@)(@@) % مع أني وإن رزئت عليهم % % واحتلبت الصبا بغير اكتهال % 668(@)(@@) % غير ناس على تناسي جهلي % % عهد أسماء بالحمى والمطال % 669(@)(@@) % من فتاة تحل كل ربيع % بمغان من المها ومحلال % 670(@)(@@) % حين يغدو بنو الظباء فيلقو % % ن خليطي جآذر ورئال % % PageV01P3760 671(@)(@@) % وكذاك الزمان يمحل بالإل % % فين محلا يجني بعاد زيال % % 672(@)(@@) % حبذا عهدها الذي عاد شوقا % وحنينا إلى العهود الخوالي % % 673(@)(@@) % والزمان الذي لبسنا به العي % % ش جديدا كأنه برد حال % 674(@)(@@) % والمحل الذي تبدل عينا % بعد عين من الأنيس الخوالي % % 675(@)(@@) % إن نبادل بسكنه فعلى ضن % ن بتلك الأعلاق عند البدال % 676(@)(@@) % ليت شعري هل ذلك العهد مرجو % % ع بعطف من النوى وانفتال % 677(@)(@@) % إذ غصون اللجين لا البان منه % % فوق كثبان لؤلؤ لا رقال % % 678(@)(@@) % ليس غير العيون فيهن من نو % ر وغير الثدي من أحمال % 679(@)(@@) % بينها غادة تشارك فيها % % بهجة الشمس صورة التمثال % % 680(@)(@@) % من ذوات الحظوظ في البدن إلا % % طي بين الصدور والأكفال % PageV01P3761 681(@)(@@) % تقسم الحلي بين قب خماص % تحت أثنائه وجسم خدال % 682(@)(@@) % يتشاكى وشاحها وأخوه ضد % شكوى السوار والخلخال % 683(@)(@@) % جاع شاك وكظ شاك % وما ذاك لخبث 