ms1751	 ص ) عن عطاء بن أبي رباح مرسلا ( ص ) عن عمرو بن دينار مرسلا .(@)(@@)(@@)(@@) $ ( 15930 ) قال النبي :(@)(@@) | 30 ( كل صلاة لا يقرا فيها بأم الكتاب فهي خداج إلا صلاة خلف إمام ) )(@)(@@) ( هق ) في القراءة وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15931 ) قال النبي :(@)(@@) | 30 ( كل صلاة لا يقرأ فيها بفاتحة الكتاب وآيتين فهي PageV05P453 خداج ) )(@)(@@) ( كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 15932 ) قال النبي :(@)(@@) | 30 ( كل كذب مكتوب على صاحبه لا محالة إلا أن يكذب الرجل بين الرجلين يصلح بينهما ، ورجل يعد امرءاته ، ورجل يكذب في الحرب والحرب خدعة ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15933 ) قال النبي :(@)(@@) | 30 ( كلكم راع وكلكم مسؤول عن رعيته ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15934 ) قال النبي :(@)(@@) | 30 ( كلكم يحب أن يدخل الجنة ؟ قالوا : نعم يا رسول الله ، قال : فأقصروا من الأمل ، وثبتوا آجالكم بين أبصاركم ، واستحيوا من الله حق الحياء ، قالوا : يا رسول الله كلنا نستحيي من الله ، قال : ليس كذالك الحياء من الله ، ولاكن الحياء من الله أن لا تنسوا المقابر والبلى ، وأن لا تنسوا الجوف وما وعى ، وأن لا تنسوا الرأس وما احتوى ، ومن يشتهي كرامة الآخرة يدع زينة الدنيا ، هنالك استحيا العبد من الله ، وهنالك أصابه ولاية الله ) )(@)(@@) ابن المبارك ( حل ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 15935 ) قال النبي :(@)(@@) | 30 ( كلكم مغفور له إلا صاحب الجمل الأحمر ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15936 ) قال النبي :(@)(@@) | 30 ( كلكم في الأجر سواء ، كلكم تصدق بعشر ماله ) )(@)(@@) ( حم ق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15937 ) قال النبي :(@)(@@) | 30 ( كلمات إذا قالهن العبد وضعهن ملك في جناحه ثم يخرج بهن فلا يمر على ملإ من الملائكة إلا صلوا عليهن وعلى قائلهن حتى يضعهن بين يدي الرحمان : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، ولا PageV05P454 حول ولا قوة إلا بالله ، وسبحان الله ، أنزاه الله عن السوء ) )(@)(@@) ( ش ) عن موسى بن طلحة مرسلا .(@)(@@)(@@)(@@) $ ( 15938 ) قال النبي :(@)(@@) | 30 ( كلمتان خفيفتان على اللسان من 
ms1752	 أعطيهما كفي مؤونة الدنيا والآخرة ، يقول العبد : اللهم ارزقني وارحمني ، فمن رحمه صرف عنه عذاب النار ، ومن رزقه فقد كفاه الله مؤونة الدنيا ) )(@)(@@) ( ك ) في تاريخه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15939 ) قال النبي :(@)(@@) | 30 ( كل حكمة يسمعها الرجل خير له من عبادة سنة ، والجلوس ساعة عند مذاكرة العلم خير من عتق رقبة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15940 ) قال النبي :(@)(@@) | 30 ( كلمة الحكمة ضالة كل حكيم ، فإذا وجدها فهو أحق بها ) )(@)(@@) العسكري في الأمثال عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15941 ) قال النبي :(@)(@@) | 30 ( كلم الله عز وجل البحر الشامي فقال : يا بحر ألم أخلقك فأحسنت خلقك ، وأكثرت فيك من الماء ؟ قال : بلى يا رب ، قال : فكيف تصنع إذا حملت فيك عبادي يهللوني ويحمدوني ويسبحوني ويكبروني ؟ قال : أغرقهم ، قال : فإني جاعل بأسك في نواحيك ، وحاملهم على يدي ، ثم كلم الله البحر الهندي فقال : يا بحر ألم أخلقك فأحسنت خلقك وأكثرت فيك من الماء ؟ قال : بلى يا رب ، قال : فكيف تصنع إذا حملت فيك عبادي يهللوني ويسبحوني ويحمدوني ويكبروني ؟ قال : أهللك معهم ، وأسبحك معهم ، وأكبرك معهم ، وأحملهم بين ظهري وبطني ، فأثابه الله الحلية والصيد الطيب ) )(@)(@@) أبو الشيخ في العظمة ( خط ) والديلمي عن أبي هريرة ( بز ) عنه موقوفا ( خط ) عن ابن عمرو موقوفا ، PageV05P455 ابن أبي حاتم ( خط ) عن ابن عمرو عن كعب الأحبار رضي الله عنهم موقوفا .(@)(@@)(@@)(@@) $ ( 15942 ) قال النبي :(@)(@@) | 30 ( كلها قد بقي إلا كتفها ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها أنهم ذبحوا شاة فقالت : يا رسول الله ما بقي إلا كتفها قال : فذكره .(@)(@@)(@@)(@@) $ ( 15943 ) قال النبي :(@)(@@) | 30 ( كل ما ردت عليك قوسك وإن توارى عنك بعد أن لا ترى فيه أثر سهم أو نصل ) )(@)(@@) ( طب ) عن أبي ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15944 ) قال النبي :(@)(@@) | 30 ( كل باسم الله ، ثقة بالله ، وتوكلا على الله ) )(@)(@@) عبد بن حميد ( د ت ه ) ابن أبي عاصم وابن خزيمة ( ع حب ) عن جابر قال : أخذ رسول الله بيد مجذوم فوضعها معه في 
ms1753	 القصعة ثم قال : فذكره .(@)(@@)(@@)(@@) $ ( 15945 ) قال النبي :(@)(@@) | 30 ( كل ما أمسكت عليك قوسك ذكي وغير ذكي وإن تغيب عنك ما لم يصل أو تجد فيه أثرا غير سهمك ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15946 ) قال النبي :(@)(@@) | 30 ( كلوا هاذه الذي تسميه فارس ، الخبيص ) )(@)(@@) ( طب ك هب ) عن عبد الله بن سلام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15947 ) قال النبي :(@)(@@) | 30 ( كلوه فإنه حلال يعني الضب ) )(@)(@@) ( ط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15948 ) قال النبي :(@)(@@) | 30 ( كلوا الثوم وتداووا به فإن فيه شفاء من سبعين داء ، ولولا أن الملك يأتيني لأكلته ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15949 ) قال النبي :(@)(@@) | 30 ( كلو اليقطين ، فلو علم الله عز وجل أن شجرة أحق PageV05P456 منها لأنبتها على يونس ، وإذا اتخذ أحدكم مرقا فليكثر فيه من الدباء فإنه يزيد في الدماغ وفي العقل ) )(@)(@@) الديلمي عن الحسن بن علي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15950 ) قال النبي :(@)(@@) | 30 ( كلوا وكلوا من أسفلها ولا تأكلوا من أعلاها ، فإن البركة تنزل من أعلاها ) )(@)(@@) ( حم ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15951 ) قال النبي :(@)(@@) | 30 ( كلوا هاذا المال ما طاب لكم فإذا عاد رشى فدعوه فإن الله سيغنيكم من فضله ، ولن تفعلوا حتى يأتيكم الله بإمام عادل ليس من بني أمية ) )(@)(@@) عبد الجبار الخولاني في تاريخ داريا ( كر ) عن أبي هريرة رضي الله عنه مرفوعا وموقوفا .(@)(@@)(@@)(@@) $ ( 15952 ) قال النبي :(@)(@@) | 30 ( كلوا من حافات القصعة ولا تأكلوا من أعلاها ، فإن البركة تنزل من أعلاها ) )(@)(@@) ( عق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15953 ) قال النبي :(@)(@@) | 30 ( كلوا من جوانبها ) )(@)(@@) ( عق ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15954 ) قال النبي :(@)(@@) | 30 ( كلوا واشربوا وتصدقوا والبسوا في غير مخيلة ولا سرف ، فإن الله يحب أن يرى أثر نعمته على عبده ) )(@)(@@) ( حم ك هب ) و تمام عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 15955 ) قال النبي :(@)(@@) | 30 ( كلوا لحم الصيد وأنتم حرم ما لم تصيدوه أو يصاد لكم ) )(@)(@@) ( حم ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@)