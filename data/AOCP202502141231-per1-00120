ms101	 گویم؟ زصفت بیرون است(@)(@@)(@@)(@@) | فخرالدین مبارکشاه(@)(@@) ~~وان روز، که بر خاک لحد روی نهم 1001 تا من غم توخورم، زغم نشکیبم(@)(@@) %~% ایک دم، زتو و غم تو هم نشکیبم %~% وز روی تو، تا جان ندهم نشکیبم(@)(@@)(@@)(@@) | وله(@)(@@) ~~1002 چون گشت گشاده، دل بر اسرار غمتندهم به گل همه جهان، خارغمت(@)(@@) ~~ما، پشت سوی جهان شادی کردیم زین پس، رخ زرد ما و دیوار غمت(@)(@@)(@@)(@@) | بدرتفلیسی(@)(@@) ~~10030 تا هجر تو کرد سعی در خواری من از جمله جهان، هیچ کسم یارنبود(@)(@@) %~% شد خیره فلک زناله و زاری من %~% الا غم تو، که کرد دلداری من PageV01P237(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0241.jpg)(@)(@)(@@)(@@)(@@) | ایل(@)(@@) ~~1004 بس غم، که زتوبر دل غمخواره گذشت بس خون، که زدیده بر دو رخساره گذشت(@)(@@) (@@) زین پس صنما، کار مرا چاره مکن %~% کاندر غم تو، کار من از چاره گذشت!(@)(@@)(@@)(@@) | عماد(@)(@@) (@@) 1005 ای عشق تو کرده جان من معدن غم %~% مسکین دل من، گشته زتو مسکن غم(@)(@@) (@@) تو، دست جفا کشیده در عالم جور %~% من پای وفا کشیده در دامن غم(@)(@@)(@@)(@@) | عماد(@)(@@) (@@) 1006 ای با همه شادیم برابر غم تو %~% بل کز همه شادیم فزون تر غم تو(@)(@@) (@@) مشکن چوسر زلف خودت عهد، که ما %~% بستیم دل شکسته را در غم تو(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1007 چون پیشهآ دل شده هم غم خوردن %~% از دل، غم عشق را نهادم گردن(@)(@@) (@@) می گریم و چوبک زن غم می گوید: %~% این کار، به گریه پیش خواهی بردن!(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 1008 بر من، در وصل بسته می دارد دوست %~% دل را، به عنا نشستبه می دارد دوست(@)(@@) (@@) زین پس، من و دل شکستگی بر درغم %~% چون دوست، دل شکسته می دارد دوست!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1009 مغزم ز غمت، در استخوان می سوزد %~% خونم، ز عنا در رگ جان می سوزد(@)(@@) (@@) دوش، از غم هجرانت چنان سوخت دلم %~% وله %~% کامروز، دلم ز شرح آن می سوزد(@)(@@) ~~1010 بر من، ز فراقت ار چه بیدادیهاست دل را به شب از خیالت، 
ms102	 آزادیهاست(@)(@@) (@@) شاگردی تو، مایهآ استادیهاست %~% شادم به غمت، که در غمت شادیهاست!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) ~~1011 تا دل به کف تو رایگان افتادهست صد گونه مرا به جان زیان افتادهست(@)(@@) ~~جزبا اجلم، صلح نخواهد بودن زین سان که غم تو در میان افتادهست PageV01P238(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0242.jpg)(@)(@)(@@) تن کیست، که با وصل تودمساز شود %~% اوله %~% دل کیست، که با عشق تو همراز شود(@)(@@) (@@) مربوی غمت به دل رسد، نعره زنان %~% جان، رقص کنان به پیش غم بازشود(@)(@@) ~~ومید نبودم، که بدین روز افتم 1012 در کوی توام، سینهآ پر سوز افکند(@)(@@) %~% اوله %~% شبهای غم توام بدین روز افکند %~% وز روی توام دور، بدآموز افکند(@)(@@)(@@)(@@) | وله(@)(@@) (@@) صل طرب ومایهآ شادی، غم توست 101 ای برده دلم به صد هزار استادی %~%(@)(@@) در عشق تو، بندگی به از آزادی! %~% یک دم غم تو، به از هزاران شادی!(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) (@@) 1015 با تونیم از غم تویک دم فارغ من تنگدل و فراخ روزی، زغمت %~%(@)(@@) مشغول توام، زهر دو عالم فارغ! %~% خود بی تو چگونه باشم از غم فارغ(@)(@@)(@@)(@@) | نظامی گنجهای(@)(@@) (@@) 1013 تا شربت عاشقی چشیدم زغمت قصه چه کنم؟ به جان رسیدم زغمت %~% هر(@)(@@) بد که گمان بری، کشیدم زغمت %~% آن به که نگویم، که چه دیدم زغمت(@)(@@) ~~کوه است غمت، کاه تنم زیر غمت 1017 تا کی، دل من بار تو دلبند کشد(@)(@@) %~% لااعرف %~% کاه تن من، کوه غمت چند کشد؟ %~% تا چند، مرا زلف تو در بند کشد(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) (@@) (101 بی یاد تو، در تنم نفس پیکان باد %~% دل زنده به اندهت چوتن پیچان باد(@)(@@) (@@) گر درتن من به هیچ نوعی شادی است %~% الآ به غمت، پوست بر او زندان باد!(@)(@)PageV01P239(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0243.jpg)(@)(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 1019 ابری است، که قطره غم فشاند غم تو %~% در بوالعجبی، هم به توماند غم تو(@)(@@) (@@) هر چند بر آتشم نشاند غم تو %~% غمناک شوم، گرم نماند غم تو!(@)(@@) فخرالدین مبارکشاه(@)(@@) (@@) 1020 گفتم: چو پدید نیست پایان غمت %~% اومید 
ms103	 گسسته شد، زدرمان غمت(@)(@@) (@@) تدبیر من آن است، که بیرون آرم %~% جان به لب آمده، ز دندان غمت!(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 1021 تا کار دل از غم تودر هم دارم %~% بیخ غم تو، ز اشک در نم دارم(@)(@@) (@@) زنهار، گمان مبر که غم کم دارم %~% گر بینم و، گر نبینمت غم دارم(@)(@@) ابوالحسن طلحه(@)(@@) (@@) 1022 شادی چوغم توام، در این عالم نیست %~% وان دم، که نه در غمت بر آرم دم نیست(@)(@@) (@@) آن کس که غم توخورد، او را غم نیست %~% زیرا که غمت، زهیچ شادی کم نیست!(@)(@@)(@@)(@@) | ابوالقاسم(@)(@@) (@@) 1023 گر هست مرا دل، به نشست غم توست %~% جان نیز، به نیم جرعه مست غم توست(@)(@@) (@@) بر من، غمت آنچه می کند از خواری %~% حق باید گفت: حق به دست غم توست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1024 سودای تو، هر دم نفسم می گیرد %~% هر لحظه، غمت پیش و پسم می گیرد(@)(@@) (@@) از دست غمت، که جانم آورد به لب %~% بگریزم آخر، نه کسم می گیرد!(@)(@@)(@@)(@@) | لا اعرف(@)(@@) (@@) 1025 ای از غم عاشقان غافل فارغ %~% زین واقعه های سخت مشکل فارغ(@)(@@) (@@) در کار غم تو، من به صد جان مشغول %~% تو، از غم کار من به صد دل فارغ(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1026 سرمایهآ عمر، داد بر باد دلم %~% و اومید زجان خویش بنهاد دلم(@)(@@) (@@) با خسته دلم، غم تو را کار نبود %~% بر رهگذر قافیه افتاد دلم PageV01P240(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0244.jpg)(@)(@)(@@)(@@)(@@) | نجیب بارنده(@)(@@) (@@) 1027 ماییم، در این زمانه سر دفتر غم %~% غم در خور ما آمد وما، در خور غم(@)(@@) (@@) در کوی جهان، که خانهآ عمر در اوست %~% همسایهآ محنیتم و، در با درغم(@)(@@) (@@) 1028 تو، محنت شبهای دراز از من پرس %~% الغیره %~% و اندیشهآ هجر جانگداز، از من پرس(@)(@@) (@@) هر واقعه، کان به غم تعلق دارد %~% چون: حسرت و فرقت ونیاز، از من پرس!(@)(@@)(@@)(@@) | لا اعرف(@)(@@) (@@) 1029 ای کرده خراب، عشق توعالم جان %~% وی لطف خیال تو، شده همدم جان(@)(@@) (@@) چندان ز غم عشق تو دارم در 
ms104	 دل %~% کم نیست سر آن که خورم من غم جان(@)(@@) (@@) 1030 مهر تو، مرا یار وثاقی است هنوز %~% بهتر قدحی، در کف ساقی است هنوز(@)(@@) (@@) نوشم بادا، زبس که خوردم غم تو %~% آوخ که نماند و، خه که باقی است هنوز!(@)(@@)(@@)(@@) | ملک طغانشاه(@)(@@) (@@) 1030 گفتم که مگر غمت بود درمانم %~% کی دانستم، که با غمت درمانم(@)(@@) (@@) ر خاک درت نشسته، می دانستم %~% کز دست غمت، چو حلقه بر درمانم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1032 هر جا که غمی است، در کنار دل ماست %~% غم خوردن بی فایده، کار دل ماست(@)(@@) (@@) گفتی که: ««چرا شاد نباشی؟)) شادی؟ %~% خه! لایق حال و روزگار دل ماست!(@)(@@) فخر الدین مبارکشاه(@)(@@) (@@) 1033 در عشق تو، شادی از بر ما بگذشت %~% مهتاب سلامت از در ما بگذشت(@)(@@) (@@) و آن کوه بلا که کوه را پست کند %~% در پای غم تو از سر ما بگذشت(@)(@@)(@@)(@@) | اوله(@)(@@) ~~103 چون نیست امید، کز تو مرهم سازیم وز وصل تو، روزگار خرم سازیم(@)(@@) (@@) تو، روپس کارخویش، من دانم وغم %~% دیر است که باهمیم و، با هم سازیم!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 1035 افتاد ز محنت من، آوازه برون %~% آآی خانهآ مهر تو ز دروازه برون!(@)(@@) (@@) ز اندازه برون است زجورتو، غمم %~% فریاد، از این غم زاندازه برون PageV01P241(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0245.jpg)(@)(@)(@@) (@@) 1036اری استم که خون دیده بارد غم تو %~% لها %~% زهری است، که تریاک ندارد غم تو(@)(@@) (@@) در هر نفسی، هزار محنت زده را %~% بی دل کند و، زجان بر آرد غم تو(@)(@@)(@@)(@@) | اسمعیل باخزری(@)(@@) (@@) 1.37 ابری است، که جز بلا نبارد غم تو %~% شاخی است، که بار محنت آرد غم تو(@)(@@) (@@) گردون جفا پیشهآ گرد نکش را %~% از خیره کشی، به کس ندارد غم تو!(@)(@@)(@@)(@@) | لا اعرف(@)(@@) (@@) 1038 ای رشک قمر، دوش به مهمان غمت %~% دیدم دل ریش خویش، بریان غمت(@)(@@) (@@) جز خون جگر، نیامد اندر چشمم %~% از هر چه نهاده بود، بر خوان غمت(@)(@@)(@@)(@@) | جلال خواری(@)(@@) (@@) 1039 این دل که مراست، دست پرورد غم است %~% در 
ms105	 زیر لگد کوب بلا، مرد غم است(@)(@@) (@@) جز غم خوردن، از او نیاید کاری %~% در خورد غمش دهم، که در خورد غم است(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) 1040 آسوده دلم، ز گفت و گوی غم تو %~% فرسوده تنم، زجست وجوی غم تو(@)(@@) (@@) طبعی است مرا، گرفته خوی غم تو %~% جانی است مرا، زنده به بوی غم تو(@)(@@)(@@)(@@) | لا اعرف(@)(@@) (@@) 104 در عشق، دلم خون شد و جانم بگداخت %~% و اندیشهآ دوست، استخوانم بگداخت(@)(@@) (@@) شرح غم خود را، به چه بتوانم گفت %~% کز تف تنور دل، زبانم بگداخت!(@)(@@) (@@) 1042 پر خنده لبت، که چشم گریانم از وست %~% اوله %~% لعلی است، که این اشک چومرجانم ازوسل(@)(@@) (@@) گشته ست مرا لب تو، چون آب حیات %~% در هجر تو اینکه زنده می مانم، ازوست(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1043 هرگز نشدم ز وصل کس روزی شاد %~% کو، بر دل من داغ فراقی ننهاد(@)(@@) (@@) با هر که در آمیختم، از من برمید %~% جز غم، که خدا عاقبتش خیر کناد!(@)(@@)(@@)(@@) | نظامی(@)(@@) (@@) 1044 گیرم که مسیحی، دم تو چند خورم؟ %~% زخم از قبل مر هم تو چند خورم؟(@)(@@) (@@) من عذر تو و، توجرم من چند نهی؟ %~% توخون من و، من غم توچند خورم؟(@)(@)PageV01P242(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0246.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~1044 کشت طربم، ز ابر غم نم خوردهست عیشم، زعنا قفای محکم خوردهست(@)(@@) (@@) شادان به چه باشم، که ندارم شادی %~% غم چون نخورم، که خون من غم خوردهست!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1043 در چشم من ای نم، ز کجا می آیی %~% وی غصه تو هر دم ز کجا می آیی؟(@)(@@) (@@) هر غم که زدل در آید، این دل گوید: %~% شاد آمدی ای غم! ز کجا می آیی؟(@)(@@) فخرالدین خالد هروی(@)(@@) (@@) 1047 در چشم من، اشک چیست؟ سیل غم او %~% در تن دل وجان کیند؟ خیل غم او(@)(@@) (@@) دوش آمده بود شادیی در دل من %~% گفتم: تو کیی؟ گفت: طفیل غم او!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1048 تا خوی تو، بی سبب جفا جوی شدهست %~% روی من، زاشک دیده چون جوی شدهست 
ms106	(@)(@@) (@@) هر کجا که غمی است، تا توبیگانه شدی %~% بی روی تو، با من آشنا روی شدهست!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 104 با اصل بلندم، ارچه ام پست غمت %~% وز عقل بهوشم، ارچه ام مست غمت(@)(@@) (@@) دست غم تو، گرفت پای طربم %~% له %~% پای طر بم، برون کن ازدست غمت!(@)(@@) (@@) 105 نوشین لب او، نداد جز درد مرا %~% دست غمش، از پای در آورد مرا(@)(@@) (@@) چون شادی او بود ز غم خوردن من %~% خوردم غم او، تا غم او خورد مرا!(@)(@@) (@@) 105 تا کی، غم این جهان بد ساز خورم %~% مشرف %~% خیزم، غم آن غمزهآ غماز خورم(@)(@@) (@@) خونابهآ دل، در قدح دیده کنم %~% دزدیده، به. شادی غمت باز خورم!(@)(@@)(@@)(@@) | ثیر اخسیکتی(@)(@@) (@@) 1052 این آتش دل، بسوخت پروانهآ تو %~% این طرفه، که پر نگشت پیمانهآ تو!(@)(@@) (@@) آن روز که غم حلقه بزد، گفتم: کیست؟ %~% گفتا که: منم، خرابی خانهآ توا(@)(@@)(@@)(@@) | عزالدین شفروه(@)(@@) ~~1052 کو دیده، که خون جگر آرم با اویا صبر، که روزی به سر آرم با او(@)(@@) (@@) کو، شیفته ای و تیره روزی چون من %~% تا از دم تو، دمی بر آرم با او PageV01P243(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0247.jpg)(@)(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) 1054 یار آن باشد که انده یار خورد %~% محنت زده ای را، ز غمی باز خرد(@)(@@) (@@) درمانده منم: یار تو وحال این است %~% گر توغم کارم نخوری، پس که خورد؟(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 1055 با زخم زمانه، مرهمی بایستی %~% یا کار فلک، بی ستمی بایستی(@)(@@) (@@) یا بایستی چنان که غم خود نبدی %~% یا چون غم هست، محرمی بایستی!(@)(@@) (@@) 1056 صد غم، من غمخور بخورم در یک دم %~% وله %~% یک غم نشود زصد غمم، یک دم کم(@)(@@) (@@) غم می خوردم، چنانکه من می خورمش %~% غم طعمهآ من شدهست و، من طعمهآ غم!(@)(@@)(@@)(@@) | لا اعرف(@)(@@) ~~1057 آن شد که دلت به مجلس ما بودی رویت گل و، چشم نرگس ما بودی(@)(@@) (@@) با اینهمه، شادم که غمت مونس ماست %~% وای، ار غم تونه مونس ما بودی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1058 
ms107	 نه درد مرا، کنارهای هست پدید %~% نه سوی وصال، چارهای هست پدید(@)(@@) (@@) گفتی: زغمم هیچ اثر نیست پدید %~% بهتر بنگر، که پارهای هست پدید!(@)(@@)(@@)(@@) | ی(@)(@@) (@@) 1059 شد روز سپید من، سیاه از غم تو %~% وین سرخ رخم، زرد چوماه از غم تو(@)(@@) (@@) رخساره بنفش کردم و، جامه کبود %~% ای لعل رخ و سبز خط آه از غم تو(@)(@@)(@@)(@@) | لااعرف(@)(@@) ~~1060 با حسن تو، لاف زهد و تقوی بنمانددر وصف تو، لفظ حسن ومعنی بنماند(@)(@@) (@@) وین مدعیان عقل نابالغ را %~% در کوی غمت، مجال دعوی بنماند!(@)(@@)(@@)(@@) | وله(@)(@@) ~~این طرفه، که خون کرد دلم را غم تو 106 ای بی رخ تو، دلم ز جان(@)(@@) بگرفته %~% و آوازهآ حسن توه جهان بگرفته %~% و آنگاه، مرا چو خونیان بگرفته!(@)(@@)(@@)(@@) | مبارکشاه غوری(@)(@@) ~~صد ساله غمم نهد به هردم، در پیش 106 تا با غم عشق یار، خویشی دارم(@)(@@) %~% گر چه به هزار ساله، پیشی دارم %~% بر شادی و غم، کمی و بیشی دارم PageV01P244(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0248.jpg)(@)(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~1062 هر شب، غم تو غمزده ای را بکشد بیهوده، به کار آمده ای را بکشد(@)(@@) (@@) گفتی که: نداری توغم، آخر دارم %~% چندانکه چو من دلشدهای را بکشد!(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 1064 دی گفت بتم: به هر غمی صد می خور %~% وان زخم کز آن بتر نباشد می خور(@)(@@) (@@) گفتم: توغمی بخور به کارم، گفتا: %~% عاشق نه منم که غم خورم، خود می خور!(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) ~~1064 ای کشته چو من هزار، در پای غمتوای غرقه چومن بسی، به دریای غمت(@)(@@) (@@) ویران مکن این دیده ودل، زاتش وآب %~% کاین جای خیال توست و آن جای غمت!(@)(@@)(@@)(@@) | شهریار زوزنی(@)(@@) (@@) 1065 جان گفت به دل، که تا کی ای بی معنی %~% از خوردن غم، شرم نیایدت همی(@)(@@) (@@) دل گفت: چوغم در آید از در گوید: %~% مهمان خواهی؟ نمی توان گفت که نی!(@)(@@)(@@)(@@) | شهریار زوزنی(@)(@@) (@@) 1067 محروم رخ چون ارمت می باشم %~% سرگشتهآ جور و ستمت می باشم(@)(@@) (@@) از روز وصال تو، 
ms108	 طمع ببریدم %~% اوله %~% در خدمت شبهای غمت می باشم!(@)(@@) (@@) 1028 عاقل باید که شخره غم نشود %~% هر دم، ز غم بیهده در هم نشود(@)(@@) (@@) زیرا که غم است انچه در مدت عمر %~% چندانکه از و بیش خوری، کم نشود!(@)(@@)(@@)(@@) | لااعرف(@)(@@) ~~1065 لشکر گه عشق، عارض خرم توست زنجیر خرد، زلف خم اندر خم توست(@)(@@) ~~آسایش صد هزار جان، یک دم توست ای شادی آن دل، که در آن دل غم توست!(@)(@@)(@@)(@@) | علی شروانی(@)(@@) (@@) 1070 من مرد نشاط نیستم، مرد غمم %~% در کوی نیاز، ناز پرورد غمم(@)(@@) (@@) من، با غم دل چوجان برآمیخته ام %~% غم خورد دل من است و، من خورد غمم!(@)(@@)(@@)(@@) | لااعرف(@)(@@)(@@)(@@) | چون باد شدم، گرد به من باز گذار!(@)(@@) (@@) ای مرغ سحر، لاف غم یار مزن %~% خاموش! تواین درد به من باز گذار!(@)(@)PageV01P245(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0249.jpg)(@)(@)(@@)(@@)(@@) | مبار کشاه غوری(@)(@@) (@@) 1072 آنها، که ز خود فراغ دل می یابند %~% سودای تو، در دماغ دل می یابند(@)(@@) (@@) در ظلمت غم، ز نور شمع رخ توست %~% هر شعله، که در چراغ دل می یابند!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1073 معشوقه، چو زلف خویش بر هم زندم %~% زخمی که به جان زند، دمادم زندم(@)(@@) (@@) در خانهآ غم نهد، فراغ دل خویش %~% و آنگاه، چو حلقه بر در غم زندم(@)(@@) قاضی شمس الدین اقطع(@)(@@) (@@) 1074 روزم، ز رخ تو روشنایی می داشت %~% دل، کی زتو طاقت جدایی می داشت؟(@)(@@) (@@) بیگانه تو کردیام زشادی، گرنه %~% غم، با دل من چه آشنایی می داشت؟(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 1075 دل، بر سر کوی توست سرمست غمت %~% تن، همچودل اوفتاده در شست غمت(@)(@@) (@@) در ماندهآ آنم، که چه سر خواهد داشت؟ %~% جانی، که به پای بردم از دست غمت!(@)(@@)(@@)(@@) | ثیر اخسیکتی(@)(@@) (@@) 1076 گفتی که غمم همی شمارد غم تو %~% تا سور کند ز شادی ام ماتم تو(@)(@@) (@@) ای کاش بدی من از خدا می خواهم %~% کاین فتح برآمدی، به بخت غم تو!(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 1077 در یک دم عاریت، زعالم مندیش %~% وردم دهدت 
ms109	 جهان، از آن دم مندیش(@)(@@) (@@) جایی که درو به یک دم عاریتی [است] %~% صد گونه غم بیهده درهم، مندیش!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1078 مگذر ز سر رهی و، مگذار مرا %~% زین عاشق سرسری مپندار مرا(@)(@@) (@@) چون شمع، در آتش غمت می سوزم %~% از من نرهی، تا نکشی زار مرا!(@)(@@)(@@)(@@) | ظامی(@)(@@) (@@) 1079 گیرم که گرفته ای کمم، اینت رسد! %~% ور زان نخوری بتاغمم، اینت رسد!(@)(@@) (@@) اینم نرسد، که من بمیرم زغمت %~% ارتونایی به ماتمم، اینت رسد!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 1080 گر بر چومنی کم نگری، اینت رسد! %~% نام من مسکین نبری، اینت رسد!(@)(@@) (@@) اینم نرسد، که من غم تونخورم %~% گر توغم کارم نخوری، اینت رسد!(@)(@)PageV01P246(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0250.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~1081 بر شمع رخ تو، سوخت پروانهآ دل وز دست غمت، خراب شد خانهآ دل(@)(@@) (@@) با اینهمه شادم، که مرا هست غمت %~% چون گنج، نهان میان و یرانهآ دل!(@)(@@)(@@)(@@) | سراج اسد آبادی(@)(@@) ~~1082 از دیده و دل، غرقهآ سودای توامیارب، که چگونه مرده در پای توام!(@)(@@) (@@) نقد غم خویشتن، زمن باز مگیر %~% آخر، نه خزینه دار غمهای توام؟(@)(@@)(@@)(@@) | وله(@)(@@) ~~1083 با کفر سرزلف تو، دینها سره نیستبا روی تو، بر مه آفرینها سره نیست(@)(@@) (@@) هر لحظه، هزار گونه غم نقد کنی %~% ای جان و جهان، مکن که اینها سره نیست!(@)(@@)(@@)(@@) | سید اشرف غزنوی(@)(@@) (@@) 1084 یارم، چو کلاله بر گل ولاله نهاد %~% جان نیز، دل شکسته بر ناله نهاد(@)(@@) (@@) مسکین دل من، امید یکروزه نداشت %~% باری، به چه حرص این غم صد ساله نهاد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1085 گر من نه چنین عاشق بیخرده امی %~% بی تو، نفسی ز عمر نشمرده امی(@)(@@) (@@) من زنده نیم، حقیقتم روشن شد %~% گر زنده امی نه از غمت، مرده امی!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1086 برکس به جزاز تو، یک زمان دل ننهیم بی روی تو، بر ملک جهان دل ننهیم(@)(@@) (@@) گویی که: مخورغم، که کنم با تو وفا %~% وله %~% گویی تو، ولیک ما بر آن دل ننهیم!(@)(@@) (@@) 1087 در ده قدح درد، که در می 
ms110	 باید %~% دردم چوز توست، بیشتر می باید!(@)(@@) ~~خوش نیست غمت، ولیک بس خوشخواراست چندانکه همی خورم، دگر می باید!(@)(@@)(@@)(@@) | خالد هروی(@)(@@) ~~1088 در عشق تو، سرمایهآ درمان درد استبریاد تو، پیرایهآ هجران درد است(@)(@@) ~~دور از من! اگر شود زمن درد تو دور یارب که غم آن غم است و، دردآن درداستا PageV01P247(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0251.jpg)(@)(@)(@@)(@@)(@@) | فضل اسفراینی(@)(@@) ~~1089 تا جان و دلم بوی تو [را] یافته اندروی از دو جهان بجمله بر تافتهاند(@)(@@) (@@) دانی چه کنم؟ دست بدارم زغمت %~% کاین غم، نه به پای چومنی بافته اند!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1090 سلطان دل من، ستمش می خواهد %~% وز والی وقت، هر دمش می خواهد(@)(@@) (@@) چون من [پی] شادی ام، خطی خواهد داد %~% پروانهآ خواجهآ غمش می خواهد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1091 چون من به غم عشق تودل بسپارم %~% خواهم که به هر غمی دلی پیش آرم(@)(@@) (@@) ازمن به هزار دل، نداری منت %~% وز تو به غمی، هزار منت دارم(@)(@@) (@@) 1092 زان یار، کزو عمر مرتب دارم %~% هنگامهآ روز وصل، در شب دارم(@)(@@) (@@) تلخی غمم جان به لب آورد و، هنوز %~% شیرینی آن نواله در لب دارم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1093 از دهرهآ دهر خود مسلم نجهد %~% وز دام سپهر شاد بی غم نجهد(@)(@@) (@@) بسیار مخور توغم، که از دست اجل %~% آدم چونجست، آدمی هم نجهد!(@)(@@)(@@)(@@) | (اعرف(@)(@@) (@@) 1094 گر دل که یکی است، صد شود در غم تو %~% دانم زهمه بود فزونتر غم تو(@)(@@) (@@) در بازم، اگر پای نداری با من %~% سر در غم تو، که هست در سر غم تو!(@)(@@)(@@)(@@) | رضیهآ گنجهای(@)(@@) (@@) 1095 هر چند، چو خاک راه خوارم گیری %~% خاک توام، ارچه خاکسارم گیری(@)(@@) (@@) در بحر غمم زاشک، شاید که به لطف %~% نزدیک لب آیی، به کنارم گیری!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~1096 عشق تو، زلطفها که با ما کردهست چشمم صدف لؤلؤ لالا کردهست(@)(@@) ~~وین مردمک چشم سیه کاسهآ من در دور رخ تو، دل به دریا کردهست!(@)(@@) (@@) 1057 گفتی: دو دلی تو، زتو کاری ناید! %~% بهتان 
