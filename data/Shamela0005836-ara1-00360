ms357	 بشيء(@)(@@)(@@)(@@) | 6996 - (@)(@@) خ م / يحيى بن عباد الضبعي عن شعبة ثبت ضعفه زكريا الساجي(@)(@@)(@@)(@@) | 6997 - (@)(@@) يحيى بن عباد بن هانئ المديني عن ابن جريج قال العقيلي يحيى بن عباد البصري عن ابن جريج حديثه يدل على الكذب(@)(@@)(@@)(@@) | 6998 - (@)(@@) د / يحيى بن عبد الله المرادي شيخ ما روى عنه سوى معمر(@)(@@)(@@)(@@) | 6999 - (@)(@@) عه / يحيى بن عبد الله أبو حجية الكندي الأجلح عن الشعبي وغيره قال أبو حاتم لا يحتج به ليس بقوي وقال السعدي الأجلح مفتر وقال ابن عدي هو عندي صدوق إلا أنه يعد في الشيعة(@)(@@)(@@)(@@) | 7000 - (@)(@@) د ت ق / يحيى بن عبد الله الجابر عن أبي ماجدة ضعفه النسائي وجماعة(@)(@@)(@@)(@@) | 7001 - (@)(@@) س / يحيى بن عبد الله بن مالك الدار تابعي فيه جهالة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7002 - (@)(@@) يحيى بن عبد الله البابلتي عن الأوزاعي واه قال الأزدي الضعف على حديثه بين وقال أبوحاتم لا يعتد به(@)(@@)(@@)(@@) | 7003 - (@)(@@) يحيى بن عبد الله روى عنه عبد الرحمن بن خالد حديثا كذبا في الأيام(@)(@@)(@@)(@@) | 7004 - (@)(@@) يحيى بن عبد الله مصري عن عبد الرزاق بخبر باطل قطعا(@)(@@)(@@)(@@) | 7005 - (@)(@@) خ م / يحيى بن عبد الله بن بكير ثقة حافظ قال أبو حاتم لا يحتج به وقال النسائي ضعيف وقال مرة ليس بثقة احتجا به في الصحيحين(@)(@@)(@@)(@@) | 7006 - (@)(@@) يحيى بن عبد الحميد الحماني حافظ منكر الحديث وقد وثقه ابن معين وغيره وقال احمد بن حنبل كان يكذب جهارا وقال النسائي ضعيف(@)(@@)(@@)(@@) | 7007 - (@)(@@) يحيى بن عبد الرحمن بن أبي لبيبة شيخ وكيع قال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 7008 - (@)(@@) يحيى بن عبد الرحمن البصري عن أبان بن أبي عياش قال الأزدي متروك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7009 - (@)(@@) يحيى بن عبد الرحمن أبو بسطام عن الضحاك قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) | 7010 - (@)(@@) يحيى بن عبد الرحمن عن محمود بن خالد الدمشقي ليس بثقة متهم(@)(@@)(@@)(@@) | 7012 - (@)(@@) يحيى بن عبدويه عن شعبة قال يحيى بن معين ليس بشيء وقال مرة كذاب(@)(@@)(@@)(@@) | 7013 - (@)(@@) ت ق / يحيى بن عبيد الله بن موهب التيمي عن أبيه هالك قال احمد ليس بثقة 
ms358	(@)(@@)(@@)(@@) | 7014 - (@)(@@) ق / يحيى بن عثمان أبو سهل عن ولد ابن أبي مليكة جرحه ابن حبان وغيره(@)(@@)(@@)(@@) | 7015 - (@)(@@) يحيى بن عثمان عن أبي حازم قال البخاري حديثه ليس بالقائم(@)(@@)(@@)(@@) | 7016 - (@)(@@) يحيى بن عثمان الحربي صدوق تفرد عن الهقل بن زياد بحديث أنكر(@)(@@)(@@)(@@) | 7017 - (@)(@@) يحيى بن عثمان بن صالح السهمي صدوق كتب عنه ابن أبي حاتم وقال تكلموا فيه(@)(@@)(@@)(@@) | 7018 - (@)(@@) يحيى بن عثمان الحمصي أخو عمرو صدوق لينه أبو عروبة الحراني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7019 - (@)(@@) يحيى بن أبي عطاء عن أبي جعفر الخطمي مجهول(@)(@@)(@@)(@@) | 7020 - (@)(@@) يحيى بن عفيف الكندي عن أبيه لا يعرف(@)(@@)(@@)(@@) | 7021 - (@)(@@) يحيى بن عقبة بن أبي العيزار عن ابن أبي ليلى القاضي قال أبو حاتم يفتعل الحديث(@)(@@)(@@)(@@) | 7022 - (@)(@@) د ق / يحيى بن العلاء الرازي البجلي مشهور قال أبو حاتم ليس بالقوي واما أحمد بن حنبل فقال كذاب يضع الحديث(@)(@@)(@@)(@@) | 7023 - (@)(@@) يحيى بن علي إمام مسجد عيثم قرأ السيرة على ابن رفاعة قال الزكي المنذري كان كذابا وكذبه علي بن المفضل وغيره(@)(@@)(@@)(@@) | 7024 - (@)(@@) ت / يحيى بن عمرو بن مالك النكري رماه حماد بن زيد بالكذب وضعفه جماعة(@)(@@)(@@)(@@) | 7025 - (@)(@@) يحيى بن عمران شيخ مدني مجهول قلت روى عنه أبو مصعب وإبراهيم بن حمزة(@)(@@)(@@)(@@) | 7026 - (@)(@@) يحيى بن عمير عن علي في الحدود لا يدرى من هو(@)(@@)(@@)(@@) | 7027 - (@)(@@) يحيى بن عنبسة القرشي عن حميد الطويل قال ابن حبان دجال وضاع(@)(@@)(@@)(@@) | 7028 - (@)(@@) م د ت ق / يحيى بن عيسى الرملي مشهور ضعفه ابن معين وقال س ليس بالقوي(@)(@@)(@@)(@@) | 7029 - (@)(@@) يحيى بن غالب العبشمي عن يحيى بن حمزة في النكاح لم يصح حديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7030 - (@)(@@) يحيى بن غالب عن أبيه عن الحسن في فضائل معاية بخبر موضوع(@)(@@)(@@)(@@) | 7031 - (@)(@@) ق / يحيى بن فلان الأنصاري عن أبيه لا يعرف(@)(@@)(@@)(@@) | 7032 - (@)(@@) يحيى بن فياض الزماني عن همام قال أبو داود عقيب روايته هذا عندنا باطل(@)(@@)(@@)(@@) | 7033 - (@)(@@) يحيى بن كثير أبو النضر صاحب البصري عن أيوب قال الدارقطني متروك فأما(@)(@@)(@@)(@@) | 7034 - (@)(@@) يحيى ب