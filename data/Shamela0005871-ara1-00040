ms21	 حمزة بن القاسم بن عفيف الوراق في شعبان(@)(@@)(@@)(@@) | 356 - (@)(@@) أبو علي فضل بن صالح بن علي في جمادى الآخرة حدث بيسير(@)(@@)(@@)(@@) | 357 - (@)(@@) ذو النون العطار في شعبان(@)(@@)(@@)(@@) | 358 - (@)(@@) أبو القاسم ابن الإخوة في شعبان(@)(@@)(@@)(@@) | 359 - (@)(@@) أبو المرجا الفقيه في رمضان سمع من ابن السري التنيسي(@)(@@)(@@)(@@) | 360 - (@)(@@) أبوبكر الحارثي في شهر رمضان(@)(@@)(@@)(@@) | 361 - (@)(@@) أبو عبد الله محمد بن علي القرقوبي الحنيفي حدث بيسير(@)(@@)(@@)(@@) | 362 - (@)(@@) أبو الفرج مظفر بن محمد الأصبهاني(@)(@@)(@@)(@@) | 363 - (@)(@@) سهيل بن طلحة ذكر أنه سمع من ابن المقريء بأصبهان(@)(@@)(@@)(@@) | 364 - (@)(@@) هاشم بن عبيد الجابري سمع كثيرا وحدث(@)(@@)(@@)(@@) | 365 - (@)(@@) أبو محمد علي بن موسى بن مالك النجيرمي(@)(@@)(@@)(@@) | 366 - (@)(@@) الحسين بن صالح بن علي أخو العميد(@)(@@)(@@)(@@) | 367 - (@)(@@) القاضي أبو الحسن محمد بن إسحاق بن حصين عنده إسناد العراق(@)(@@)(@@)(@@) | 368 - (@)(@@) علي بن حمزة الكتبي حدث(@)(@@)(@@)(@@) | 369 - (@)(@@) أبو الفتح بن بابشاذ في رمضان(@)(@@)(@@)(@@) | 370 - (@)(@@) أبو عبد الله الحسين بن أحمد المعلم العباسي في ذي القعدة(@)(@@)(@@)(@@) | 371 - (@)(@@) الشريف أبو الحسن محمد بن القاسم بن ميمون بن حمزة في ذي القعدة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | سنة ثمان وأربعين(@)(@@)(@@)(@@) | 372 - (@)(@@) أبو جعفر المسلم بن علي بن طباطبا الحسني(@)(@@)(@@)(@@) | 373 - (@)(@@) أبو الحسن محمد بن الحسين بن بقاء ابن بنت عبد الغني الحافظ في المحرم(@)(@@)(@@)(@@) | 374 - (@)(@@) أبو الحسين عبد الملك بن إسماعيل الهلالي في محرم(@)(@@)(@@)(@@) | 375 - (@)(@@) أبو الحسن محمد بن الحسين النيسابوري الطفال الرابع عشر من صفر(@)(@@)(@@)(@@) | 376 - (@)(@@) أبو الطاهر محمد بن الحسين بن سعدون في ربيع الأول(@)(@@)(@@)(@@) | 377 - (@)(@@) أبو علي الحسن بن الحسين الخلعي الفقيه الشافعي في شوال(@)(@@)(@@)(@@) | 378 - (@)(@@) أبو القاسم علي بن عبد الواحد النجيرمي في ذي الحجة(@)(@@)(@@)(@@) | 379 - (@)(@@) أبو الفرج القاسم بن علي الذهلي الكاتب المعروف بالجليس(@)(@@)(@@)(@@) | 380 - (@)(@@) أبو الحسين ابن الترجمان في جمادى الأول(@)(@@)(@@)(@@) | سنة تسع وأربعين(@)(@@)(@@)(@@) | 381 - (@)(@@) أبو الحسين علي بن يحيى بن أبي الفراتي في شعبان(@)(@@)(@@)(@@) | 382 - (@)(@@) أبو الحسن ابن رجاء الشاهد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | سنة خمسين(@)(@@)(@@)(@@) | 383 - (@)(@@) أبو عبد الله الحسين بن محمد بن أزهر في ربيع الآخر(@)(@@)(@@)(@@) | 384 - (@)(@@) أبو الحسين ابن السيرافي في جمادى الأول(@)(@@)(@@)(@@) | 385 - (@)(@@) أبو 
ms22	 الحسن علي بن بقاء الوراق في ذي الحجة(@)(@@)(@@)(@@) | سنة إحدى وخمسين(@)(@@)(@@)(@@) | 386 - (@)(@@) أبو محمد فضل بن جعفر بن أبي الكرام في ربيع الآخر(@)(@@)(@@)(@@) | 387 - (@)(@@) أبو بكر أحمد بن عبيد الله بن إسحاق القاضي في رمضان(@)(@@)(@@)(@@) | 388 - (@)(@@) أبو القاسم منصور بن النعمان الصيرفي في ذي القعدة(@)(@@)(@@)(@@) | 389 - (@)(@@) أبو عبد الله ابن الرومي في ذي الحجة(@)(@@)(@@)(@@) | سنة اثنتين وخمسين الدقاق(@)(@@)(@@)(@@) | 390 - (@)(@@) أبو الفضل جعفر بن الحسين بن يحيى في ربيع الآخر(@)(@@)(@@)(@@) | 391 - (@)(@@) أبو عبد الله محمد بن أبي سعد القزويني المقريء في ربيع الآخر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | سنة ثلاث وخمسين(@)(@@)(@@)(@@) | 392 - (@)(@@) أبو إسحاق إبراهيم بن أحمد القزويني في جمادى الأول(@)(@@)(@@)(@@) | 393 - (@)(@@) أبو العباس أحمد بن سعيد بن نفيس المقريء آخر رجب(@)(@@)(@@)(@@) | 394 - (@)(@@) أبو القاسم عبد الرحمن بن سعد القاضي في شعبان(@)(@@)(@@)(@@) | 395 - (@)(@@) أبو محمد أحمد بن أبي سعيد الصيمري أخو منصور في رمضان(@)(@@)(@@)(@@) | 396 - (@)(@@) أبو الحسن علي بن الحسين بن جابر بتنيس في شوال(@)(@@)(@@)(@@) | سنة أربع وخمسين(@)(@@)(@@)(@@) | 397 - (@)(@@) عبد الرحمن بن المظفر بن عبد الرحمن المعروف بالكحال في ربيع الأول(@)(@@)(@@)(@@) | 398 - (@)(@@) القاضي أبو عبد الله القضاعي الفقيه الشافعي في ذي القعدة(@)(@@)(@@)(@@) | 399 - (@)(@@) حمود الفقيه البغدادي الشافعي في ذي القعدة(@)(@@)(@@)(@@) | 400 - (@)(@@) أبو الفرج محمد بن عبد الملك الهلالي نصف ذي الحجة(@)(@@)(@@)(@@) | 401 - (@)(@@) أبو البركات الحسين بن إبراهيم بن الفرات في صفر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | سنة خمس وخمسين(@)(@@)(@@)(@@) | 402 - (@)(@@) يحيى بن فرج الصيرفي في ربيع الأول(@)(@@)(@@)(@@) | 403 - (@)(@@) الوزير أبو الفضل عبد الله بن يحيى بن المدبر سمع من ابن النحاس وغيره(@)(@@)(@@)(@@) | 404 - (@)(@@) سليمان بن علي العباس في جمادى الآخرة(@)(@@)(@@)(@@) | 405 - (@)(@@) الحسين بن الحارث الزاهد توفي بأسوان(@)(@@)(@@)(@@) | 406 - (@)(@@) الحسن بن أبي شهاب الشعري النصف من رمضان(@)(@@)(@@)(@@) | 407 - (@)(@@) أبو الحسن علي بن خلف الزيات في شوال(@)(@@)(@@)(@@) | 408 - (@)(@@) أبو القاسم عبد الوهاب بن عباس بن قوقل الجيزي في ذي القعدة(@)(@@)(@@)(@@) | 409 - (@)(@@) أبو الحسين عبد الباقي بن إبراهيم الغازي في ذي الحجة(@)(@@)(@@)(@@) | 410 - (@)(@@) أبو محمد علي بن ميمون بن سلام في ذي الحجة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | سنة ست وخمسين(@)(@@)(@@)(@@) | 411 - (@)(@@) أبو النجيب المراعني في ربيع الأول(@)(@@) آخر 
ms23	 كتاب أبي إسحاق الحبال رحمه الله(@)(@@)(@@)(@@) | 412 - (@)(@@) قال السلفي سمعت الشيخ الأمين أبا محمد الأكفاني بدمشق يقول سمعت عبد العزيز بن أحمد بن علي الحافظ يقول كتب إلي أبو الحسن علي بن بقاء الوراق في مصر أن أبا محمد عبد الغني بن سعيد الحافظ حدثهم قال ولدت سنة اثنتين وثلاثين وثلاثمائة وتوفي والدي سعيد بن علي سنة ثمان وثلاثين وثلاثمائة ولم أسمع منه شيئا وكان له حين وفاته ثلاث وأربعون سنة(@)(@@)(@@)(@@) | 413 - (@)(@@) قال سمعته يقول كتب إلي أبو إسحاق الحبال من مصر أن أبا مسلم محمد بن أحمد بن علي الكاتب البغدادي توفي سنة تسع وتسعين وثلاثمائة في ذي القعدة وقال غير أبي إسحاق توفي ليلة الأربعاء ثاني ذي الحجة وكان مولده يوم الأربعاء الحادي والعشرين من شهر ربيع الأول سنة خمس وثلاثمائة فيكون عمره أربعا وتسعين سنة وسبعة أشهر وأحد عشر يوما(@)(@@)(@@)(@@) | 414 - (@)(@@) قال سمعته يقول توفي أبو أحمد عبد الله بن محمد بن عبد الله بن شجاع الفقيه المعروف بابن المفسر بمصر في رجب سنة خمس وثلاثين وثلاثمائة(@)(@@) PageV00P000(@)(@@) سمع من أحمد بن علي بن سعيد القاضي المروزي بدمشق وكان مولده يوم الثلاثاء لخمس خلون من شهر ربيع الأول سنة ثلاث وسبعين ومائتين(@)(@@)(@@)(@@) | 415 - (@)(@@) قال سمعته يقول مولد أبي إسحاق الحبال المصري سنة إحدى وتسعين وثلاثمائة PageV00P000 
