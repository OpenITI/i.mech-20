ms135	 بن ناجية(@)(@@)(@@)(@@) $ 3118 - (@)(@@) البردي(@)(@@) موسى بن هارون الدمشقي(@)(@@)(@@)(@@) $ 3119 - (@)(@@) البريدي(@)(@@) جعفر بن محمد الهمداني أبو القاسم عن ابن ماجه القزويني نسب إلى سكة البريد من همذان(@)PageV00P000(@)(@@)(@@)(@@) $ 3120 - (@)(@@) البرزي(@)(@@) محمد بن الفضل المروزي(@)(@@)(@@)(@@) $ 3121 - (@)(@@) البطيخي(@)(@@) أبو إسماعيل محمد بن عبد الله بن منصور الفقيه(@)(@@)(@@)(@@) $ 3122 - (@)(@@) البطيطي إبراهيم بن خالد(@)(@@)(@@)(@@) $ 3123 - (@)(@@) البعراني أبو حامد محمد بن هارون الحضرمي(@)(@@)(@@)(@@) $ 3124 - (@)(@@) البلخي(@)(@@) الحسن بن عمر بن شقيق كان يتجر إليها(@)(@@)(@@)(@@) $ 3125 - (@)(@@) البلطيحي(@)(@@) حجاج بن دينار الواسطي(@)(@@)(@@)(@@) $ 3126 - (@)(@@) البويطي(@)(@@) محمد بن عمر بن عبد الله الشيرازي(@)PageV00P000(@)(@@) أما البويطي صاحب الشافعي فذكره أبو القاسم بن منده في هذا الموضع فأخطأ فليس ذلك لقبا له(@)(@@)(@@)(@@) $ 3127 - (@)(@@) بوارني(@)(@@) أحمد بن محمد بن خالد البغدادي أبو بكر كان قاضيا على تكريت حدث عنه الجعابي كذا ذكره ابن منده أيضا(@)(@@)(@@)(@@) $ 3128 - (@)(@@) البهي(@)(@@) يحيى بن محمد الكوفي عن هشام بن عروة(@)(@@)(@@)(@@) $ 3129 - (@)(@@) وأقدم منه عبد الله بن يسار يروي عن عائشة(@)(@@)(@@)(@@) $ 3130 - (@)(@@) البياضي(@)(@@) محمد بن عيسى بن محمد العباسي(@)(@@)(@@)(@@) $ 3131 - (@)(@@) البيني(@)(@@) أحمد بن علي بن إسحاق الدلال(@)PageV00P000(@)(@@)(@@)(@@) || - التاء(@)(@@)(@@)(@@) $ 3132 - (@)(@@) التبعي(@)(@@) أحمد بن محمد بن سعيد القرشي الهمداني(@)(@@)(@@)(@@) $ 3133 - (@)(@@) التستري(@)(@@) أحمد بن عيسى بن حسان البصري كان يتجر إلى تستر(@)(@@)(@@)(@@) $ 3134 - (@)(@@) التبوذكي(@)(@@) موسى بن إسماعيل أبو سلمة البصري(@)(@@)(@@)(@@) $ 3135 - (@)(@@) التنيسي(@)(@@) عبد الله بن يوسف الدمشقي ذكره ابن طاهر(@)PageV00P000(@)(@@)(@@)(@@) $ 3136 - (@)(@@) التيمي(@)(@@) سليمان بن طرخان نزل فيهم(@)(@@)(@@)(@@) $ 3137 - (@)(@@) التنيني(@)(@@) منصور بن جعفر الكشميهني ذكره ابن السمعاني(@)(@@)(@@)(@@) || - الثاء(@)(@@)(@@)(@@) $ 3138 - (@)(@@) الثوري(@)(@@) الحسن بن محمد الصوفي أبو القاسم الزاهد نسب إلى مذهب أبي ثور(@)(@@)(@@)(@@) || - الجيم(@)(@@)(@@)(@@) $ 3139 - (@)(@@) الجرجسي(@)(@@) يزيد بن عبد ربه جاور كنيسة جرجس(@)(@@)(@@)(@@) $ 3140 - (@)(@@) الجزري(@)(@@) محمد بن محمد بن حمدان التاجر الهمداني عن الحارث ابن أبي أسامة(@)PageV00P000(@)(@@)(@@)(@@) $ 3141 - (@)(@@) ويقال أيضا لصالح جزرة الحافظ(@)(@@)(@@)(@@) $ 3142 - (@)(@@) الجعدي(@)(@@) مروان بن محمد بن مروان آخر خلفاء بني أمية نسب إلى الجعد بن درهم لأنه كان معلمه(@)(@@)(@@)(@@) $ 3143 - (@)(@@) الجعفي(@)(@@) محمد بن أبان بن صالح الكوفي تزوج فيهم(@)(@@)(@@)(@@) $ 3144 - (@)(@@) الجلاجلي(@)(@@) موسى بن الحسن بن عباد لقبه بذلك القعنبي لحسن صوته(@)PageV00P000(@)(@@)(@@)(@@) $ 3145 - (@)(@@) الجلواباذي 
ms136	(@)(@@) علي بن إسحاق بن إبراهيم الهمذاني عن عثمان بن أبي شيبة(@)(@@)(@@)(@@) $ 3146 - (@)(@@) الجني(@)(@@) عبد السلام بن عمر بن إدريس الفقيه أبو بكر عن مالك(@)(@@)(@@)(@@) $ 3147 - (@)(@@) الجهني(@)(@@) أبو فروة مسلم بن سالم النهدي نزل في جهينة(@)(@@)(@@)(@@) $ 3148 - (@)(@@) الجورباري(@)(@@) يحيى بن خلف البصري شيخ لمسلم(@)(@@)(@@)(@@) $ 3149 - (@)(@@) الجوسقي(@)(@@) إبراهيم بن دينار الوراق الهمداني عن عبد الحميد بن عصام وعنه أبو زرعة وأبو حاتم(@)PageV00P000(@)(@@)(@@)(@@) $ 3150 - (@)(@@) الجوعي(@)(@@) محمد بن علي بن الحسين بن مساور بن أبي الدرداء قال ابن عدي كتب عنه بصر فنده وكان متصوفا فلقب الجوعي(@)(@@)(@@)(@@) || - الحاء(@)(@@)(@@)(@@) $ 3151 - (@)(@@) الحرمازي(@)(@@) أبو علي مولى بني هاشم نزل في بني حرماز(@)(@@)(@@)(@@) $ 3152 - (@)(@@) الحسني(@)(@@) نافع بن يزيد قيل له ذلك لأن ديوانه كان إلى شرحبيل ابن حسنة(@)(@@)(@@)(@@) $ 3153 - (@)(@@) الحنظلي(@)(@@) أبو حاتم محمد بن إدريس سكن درب حنظلة(@)(@@)(@@)(@@) $ 3154 - (@)(@@) الحصري اثنان(@)(@@) جعفر بن إبراهيم النيسابوري الحافظ(@)(@@)(@@)(@@) $ 3155 - (@)(@@) وعبد الله بن جعفر الطبري من شيوخ الإسماعيلي(@)(@@)(@@)(@@) || - الخاء(@)(@@)(@@)(@@) $ 3156 - (@)(@@) الخبري(@)(@@) الحسن بن الحسين بن علي الشيرازي صحب الفضل بن يحيى(@)PageV00P000(@)(@@) الخبري فنسب إليه(@)(@@)(@@)(@@) $ 3157 - (@)(@@) الخشوعي(@)(@@) أبو طاهر بركات بن إبراهيم الدمشقي قيل لجده ذلك لأنه مات وهو يصلي(@)(@@)(@@)(@@) $ 3158 - (@)(@@) الخلدي(@)(@@) جعفر بن محمد الصوفي لقبه بذلك الجنيد(@)(@@)(@@)(@@) $ 3159 - (@)(@@) الخندقي(@)(@@) أحمد بن أبي العباس التمار الكوفي شيخ لأبي حاتم الرازي(@)(@@)(@@)(@@) $ 3160 - (@)(@@) الخوزي(@)(@@) إبراهيم بن يزيد كان ينزل شعب الخوز(@)(@@)(@@)(@@) $ 3161 - (@)(@@) وسليمان الخوري شيخ لعبيد الله بن موسى لقب بذلك لشحه(@)PageV00P000(@)(@@)(@@)(@@) $ 3162 - (@)(@@) الخولاني(@)(@@) إدريس بن يحيى المصري كان ينزل في بني خولان(@)(@@)(@@)(@@) || - الدال(@)(@@)(@@)(@@) $ 3163 - الدالاني(@)(@@) يزيد أبو خالد الأسدي كان ينزل في بني دالان(@)(@@)(@@)(@@) $ 3164 - (@)(@@) الدحيمي(@)(@@) عبد الله بن أحمد بن زياد بن زهير الهمذان