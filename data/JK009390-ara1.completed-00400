ms400	 :(@)(@@) | 30 ( إقبل الحق ممن أتاك به صغيرا أو كبيرا وإن كان بغيضا بعيدا ، واردد الباطل على من جاء به من صغير أو كبير وإن كان حبيبا قريبا ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3777 ) قال النبي :(@)(@@) | 30 ( إقتدوا باللذين من بعدي أبي بكر وعمر واهتدوا بهدي عمار وتمسكوا بعهد ابن أم عبد ) )(@)(@@) الروياني ( ك هق ) عن حذيفة ( عد ) وابن عساكر عن أنس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3778 ) قال النبي :(@)(@@) | 30 ( اقتلوا الحيات اقتلوا ذا الطفيتين والأبتر فإنهما يطفئان البصر ويستسقطان الحبل ) )(@)(@@) ( حم خ م د ت ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3779 ) قال النبي :(@)(@@) | 30 ( اقتلوا الحيات كلها من تركها خشية ثأرها فليس منا ) )(@)(@@) ( طب ) عن إبراهيم بن جرير عن أبيه ( طب ) عن عثمان بن أبي العاصي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3780 ) قال النبي :(@)(@@) | 30 ( اقتلوا الحيات فمن وجد ذا الطفيتين والأبتر فلم يقتلهما فليس منا فإنهما اللذان يخطفان البصر ويسقطان ما في بطون النساء ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3781 ) قال النبي :(@)(@@) | 30 ( اقتلوا الفاعل والمفعول به في عمل قوم لوط ، والبهيمة والواقع على البهيمة ومن وقع على ذات محرم فاقتلوه ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3782 ) قال النبي :(@)(@@) | 30 ( اقتلوا القاتل واصبروا الصابر ) )(@)(@@) أبو عبيد في الغريب PageV02P047 ( هق ) عن إسماعيل بن أمية مرسلا .(@)(@@)(@@)(@@) $ ( 3783 ) قال النبي :(@)(@@) | 30 ( اقتلوا العقرب والحية على كل حال ) )(@)(@@) عبد الرزاق عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 3784 ) قال النبي :(@)(@@) | 30 ( اقدروا الناس بأضعفهم فإن فيهم الضعيف والكبير وذا الحاجة ، وإذا كنت وحدك فطول ما شئت وأتاك المؤذن يريد أن يؤذن فلا تمنعه ) )(@)(@@) عبد الرزاق عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 3785 ) قال النبي :(@)(@@) | 30 ( إقرأ عليه السلام وقل : لولا أنا حرم لم نرده ) )(@)(@@) ( طب ) عن ابن عباس عن زيد بن أرقم رضي الله عنهم قال : أهدى لرسول الله رجل حمار وحح فقال فذكره .(@)(@@)(@@)(@@) $ ( 3786 ) قال النبي :(@)(@@) | 30 ( إقرأ فإنها السكينة تنزلت للقرآن ) )(@)(@@) ( حم خ م ) عن البراء