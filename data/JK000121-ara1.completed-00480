ms476	 وقيل هي امرأة ق من الصحابة بحديث في الصوم س(@)(@@)(@@)(@@) $ 6492 محارب بضم أوله وكسر الراء بن دثار بكسر المهملة وتخفيف المثلثة السدوسي الكوفي القاضي ثقة إمام زاهد من الرابعة مات سنة ست عشرة ع(@)(@@)(@@)(@@) $ 6493 محاضر بضاد معجمة بن المورع بضم الميم وفتح الواو وتشديد الراء المكسورة بعدها مهملة الكوفي صدوق له أوهام من التاسعة مات سنة ست ومائتين خت م د س(@)(@@)(@@)(@@) $$$ محبوب بن الحسن هو محمد تقدم(@)(@@)(@@)(@@) $$$ محبوب بن صالح صوابه محبوب أبو صالح وهو محبوب بن موسى الآتي س(@)(@@)(@@)(@@) $ 6494 محبوب بن محرز التميمي القواريري العطار أبو محرز الكوفي لين الحديث من التاسعة بخ ت(@)(@@)(@@)(@@) $ 6495 محجوب بن موسى أبو صالح الأنطاكي الفراء صدوق من العاشرة لم يصح أن البخاري أخرج له مات سنة إحدى وثلاثين وله ثمانون د س(@)(@@)(@@)(@@) $ 6496 محجن بكسر أوله وسكون المهملة وفتح الجيم بن الأدرع الأسلمي صحابي هو الذي اختط مسجد البصرة مات في آخر خلافة معاوية بخ د س(@)(@@)(@@)(@@) $ 6497 محجن بن أبي محجن الديلي صحابي قليل الحديث س(@)(@@)(@@)(@@) $ 6498 محدوج بمهملة ساكنة وآخره جيم الباهلي مجهول من السادسة أخطأ من زعم أن له صحبة ق(@)(@@)(@@)(@@) $ 6499 محرر برائين وزن محمد على الصحيح بن عبد الله التيمي متروك من السابعة ت(@)(@@)(@@)(@@) $ 6500 محرر بن أبي هريرة الدوسي المدني مقبول من الرابعة مات في خلافة عمر بن عبد العزيز س ق(@)(@@)(@@)(@@) $ 6501 محرز بسكون المهملة وكسر الراء بعدها زاي بن سلمة العدني ثم المكي صدوق من العاشرة مات سنة أربع وثلاثين وقد جاز التسعين ق(@)(@@)(@@)(@@) $ 6502 محرز بن عبد الله الجزري أبو رجاء مولى هشام بن عبد الملك صدوق يدلس من السابعة بخ ق PageV01P521(@)(@@)(@@)(@@) $ 6503 محرز بن عون الهلالي أبو الفضل البغدادي صدوق من العاشرة مات سنة إحدى وثلاثين وله سبع وثمانون م(@)(@@)(@@)(@@) $ 6504 محرز بن الوضاح بن محرز المروزي مقبول من التاسعة س(@)(@@)(@@)(@@) $$$ محرز عن الحسن هو أبو رجاء المذكور قبل اثنين(@)(@@)(@@)(@@) $ 6505 محرش بضم أوله وفتح المهملة وقيل إنها 
ms477	 معجمة وكسر الراء بعدها معجمة بن عبد الله أو سويد بن عبد الله الكعبي الخزاعي نزيل مكة صحابي له حديث في عمرة الجعرانة د ت س(@)(@@)(@@)(@@) $ 6506 محصن بضم أوله وسكون ثانيه وكسر الصاد المهملة بن علي الفهري المدني مستور من السادسة د س(@)(@@)(@@)(@@) $ 6507 محفوظ بن علقمة الحضرمي أبو جنادة الحمصي صدوق من السادسة د عس ق(@)(@@)(@@)(@@) $ 6508 محل بضم أوله وكسر ثانيه وتشديد اللام بن خليفة الطائي الكوفي ثقة من الرابعة خ س ق(@)(@@)(@@)(@@) $ 6508 محل بن محرز الضبي الكوفي لا بأس به من السادسة مات سنة ثلاث وخمسين بخ(@)(@@)(@@)(@@) $ 6509 محمود بن آدم المروزي صدوق من العاشرة مات سنة ثمان وخمسين ذكره بن عدي في شيوخ البخاري خ(@)(@@)(@@)(@@) $ 6510 محمود بن خالد السلمي أبو علي الدمشقي ثقة من صغار العاشرة مات سنة سبع وأربعين وله ثلاث وسبعون د س ق(@)(@@)(@@)(@@) $ 6511 محمود بن خداش بكسر المعجمة ثم مهملة خفيفة وآخره معجمة الطالقاني نزيل بغداد صدوق من العاشرة مات سنة خمسين وله تسعون سنة ت عس ق(@)(@@)(@@)(@@) $ 6512 محمود بن الربيع بن سراقة بن عمرو الخزرجي أبو نعيم أو أبو محمد المدني صحابي صغير وجل روايته عن الصحابة ع(@)(@@)(@@)(@@) $ 6513 محمود بن سليمان البلخي صدوق من مشايخ النسائي من صغار العاشرة س(@)(@@)(@@)(@@) $$$ محمود بن سليمان العدني صوابه محرز بن سلمة ق(@)(@@)(@@)(@@) $ 6514 محمود بن عمرو بن يزيد بن السكن الأنصاري مقبول من الثالثة د س(@)(@@)(@@)(@@) $ 6515 محمود بن عمير بن سعد الأنصاري مقبول من الثالثة س(@)(@@)(@@)(@@) $ 6516 محمود بن غيلان العدوي مولاهم أبو أحمد المروزي نزيل بغداد ثقة من العاشرة مات سنة تسع وثلاثين وقيل بعد ذلك خ م ت س ق(@)(@@)(@@)(@@) $ 6517 محمود بن لبيد بن عقبة بن رافع الأوسي الأشهلي أبو نعيم المدني صحابي صغير وجل روايته عن الصحابة مات سنة ست وتسعين وقيل سنة سبع وله تسع وتسعون سنة بخ م 4(@)(@@)(@@)(@@) $ 6518 محمود بن الوليد شامي مقبول من الثامنة د PageV01P522(@)(@@)(@@)(@@) $ 6519 محيصة بضم الميم 
ms478	 وفتح المهملة وتشديد التحتانية وقد تسكن بن مسعود بن كعب الخزرجي أبو سعد المدني صحابي معروف 4(@)(@@)(@@)(@@) $ 6520 مخارق بن خليفة وقيل بن عبد الله الأحمسي أبو سعيد الكوفي ثقة من السادسة خ قد ت س(@)(@@)(@@)(@@) $ 6521 مخارق بن سليم الشيباني أبو قابوس مختلف في صحبته وذكره بن حبان في ثقات التابعين س(@)(@@)(@@)(@@) $ 6522 مختار بن صيفي بفتح المهملة وسكون التحتانية بعدها فاء الكوفي مقبول من السادسة له في مسلم حديث واحد متابعة م د(@)(@@)(@@)(@@) $ 6523 مختار بن غسان التمار الكوفي العبدي مقبول من التاسعة ق(@)(@@)(@@)(@@) $ 6524 مختار بن فلفل بفاءين مضمومتين ولامين الأولى ساكنة مولى عمرو بن حريث صدوق له أوهام من الخامسة م د ت س(@)(@@)(@@)(@@) $ 6525 مختار بن نافع التيمي ويقال العكلي أبو إسحاق التمار الكوفي ضعيف من السادسة ت(@)(@@)(@@)(@@) $$$ مخرش الكعبي تقدم في محرش بالمهملة(@)(@@)(@@)(@@) $ 6526 مخرمة بن بكير بن عبد الله بن الأشج أبو المسور المدني صدوق وروايته عن أبيه وجادة من كتابه قاله أحمد وابن معين وغيرهما وقال بن المديني سمع من أبيه قليلا من السابعة مات سنة تسع وخمسين بخ م د س(@)(@@)(@@)(@@) $ 6527 مخرمة بن سليمان الأسدي الوالبي بكسر اللام والموحدة المدني ثقة من الخامسة مات سنة ثلاثين ع(@)(@@)(@@)(@@) $ 6528 مخلد بفتح أوله وثالثه وسكون ثانيه بن الحسن بن أبي زميل بالزاي مصغر الحراني نزيل بغداد لا بأس به من التاسعة س(@)(@@)(@@)(@@) $ 6529 مخلد بن الحسن آخر بصري مقبول من العاشرة تمييز(@)(@@)(@@)(@@) $ 6530 مخلد بن الحسين بالضم الأزدي المهلبي أبو محمد البصري نزيل المصيصة ثقة فاضل من كبار التاسعة مات سنة إحدى وتسعين م س(@)(@@)(@@)(@@) $ 6531 مخلد بن خالد بن يزيد الشعيري بفتح المعجمة أبو محمد العسقلاني نزيل طرسوس ثقة من العاشرة م د(@)(@@)(@@)(@@) $ 6532 مخلد بن خالد بن عبد الله التميمي أبو عبد الله النيسابوري مقبول من العاشرة أيضا تمييز(@)(@@)(@@)(@@) $ 6533 مخلد بن خراش البصري يقال أخو خالد صدوق من العاشرة وهو من كبار شيوخ النسائي س(@)(@@)(@@)(@@) $ 6534 مخلد بن خداش 
ms479	 أبو خداش كوفي صدوق من التاسعة تمييز(@)(@@)(@@)(@@) $ 6535 مخلد بن خداش عن مالك يحتمل أن يكون الذي قبله تمييز(@)(@@)(@@)(@@) $ 6536 مخلد بن خفاف بضم المعجمة وفاءين الأولى خفيفة الغفاري مقبول من الثالثة 4 PageV01P523(@)(@@)(@@)(@@) $ 6537 مخلد بن الضحاك بن مسلم الشيباني والد أبي عاصم مقبول من السابعة مات سنة سبع وستين وله خمس وسبعون ق(@)(@@)(@@)(@@) $ 6538 مخلد بن مالك بن جابر الجمال بالجيم أبو جعفر الرازي نزيل نيسابور ثقة من العاشرة مات سنة إحدى وأربعين خ(@)(@@)(@@)(@@) $ 6539 مخلد بن مالك بن شيبان الحراني أبو محمد مولى قريش لا بأس به من العاشرة مات سنة اثنتين وأربعين عس(@)(@@)(@@)(@@) $ 6540 مخلد بن يزيد القرشي الحراني صدوق له أوهام من كبار التاسعة مات سنة ثلاث وتسعين خ م د س ق(@)(@@)(@@)(@@) $ 6541 مخمر بكسر أوله وسكون ثانيه وفتح ثالثه بن معاوية النميري صحابي قليل الحديث ق(@)(@@)(@@)(@@) $ 6542 مخنف بكسر أوله وبنون بن سليم بن الحارث بن عوف الأزدي الغامدي صحابي نزل الكوفة وكانت معه راية الأزد بصفين واستشهد بعين الوردة سنة أربع وستين 4(@)(@@)(@@)(@@) $ 6543 مخول بوزن محمد وقيل بوزن الذي قبله بن راشد أبو راشد بن أبي مجالد النهدي مولاهم الكوفي الحناط بمهملة ونون ثقة نسب إلى التشيع من السادسة مات بعد سنة أربعين ع(@)(@@)(@@)(@@) $ 6544 مدرك بن سعد أو بن أبي سعد الفزاري أبو سعيد الدمشقي لا بأس به من السابعة د(@)(@@)(@@)(@@) $ 6545 مرار بفتح أوله وتشديد الراء بن حمويه الثقفي أبو أحمد الهمذاني بفتح الميم والمعجمة ثقة حافظ فقيه من الحادية عشرة مات سنة أربع وخمسين خ ق(@)(@@)(@@)(@@) $ 6546 مرثد بسكون الراء بعدها مثلثة الزماني بكسر الزاي وتشديد الميم مقبول من الثالثة بخ ت س ق(@)(@@)(@@)(@@) $ 6547 مرثد بن عبد الله اليزني بفتح التحتانية والزاي بعدها نون أبو الخير المصري ثقة فقيه من الثالثة مات سنة تسعين ع(@)(@@)(@@)(@@) $ 6548 مرثد بن أبي مرثد الغنوي بفتح المعجمة والنون صحابي بدري استشهد في عهد النبي صلى الله عليه وسلم سنة أربع د ت 
ms480	 س(@)(@@)(@@)(@@) $ 6549 مرثد بن وداعة الجعفي وقيل غير ذلك في نسبه أبو قتيلة بالقاف والمثناة مصغر صحابي مقل له رواية عن بعض الصحابة د(@)(@@)(@@)(@@) $ 6550 مرجى بتشديد الجيم بن رجاء اليشكري أبو رجاء البصري صدوق ربما وهم من الثامنة خت(@)(@@)(@@)(@@) $ 6551 مرحب أو أبو مرحب مختلف في صحبته د PageV01P524(@)(@@)(@@)(@@) $ 6552 مرحوم بن عبد العزيز بن مهران العطار الأموي أبو محمد البصري ثقة من الثامنة مات سنة ثمان وثمانين وله خمس وثمانون ع(@)(@@)(@@)(@@) $ 6553 مرداس بكسر أوله وسكون الراء بن مالك الأسلمي صحابي بايع تحت الشجرة وهو قليل الحديث خ(@)(@@)(@@)(@@) $ 6554 مرزوق بن أبي الهذيل الثقفي أبو بكر الدمشقي لين الحديث من السابعة صدوق(@)(@@)(@@)(@@) $ 6555 مرزوق الباهلي أبو بكر البصري مولى طلحة صدوق من السابعة ت(@)(@@)(@@)(@@) $ 6556 مرزوق أبو بكر التيمي مقبول من السادسة ت(@)(@@)(@@)(@@) $ 6557 مرزوق أبو بكير بالتصغير التيمي الكوفي المؤذن سكن الري من السادسة أيضا تمييز(@)(@@)(@@)(@@) $ 6558 مرزوق أبو عبد الله الحمصي نزل البصرة لا بأس به من السادسة ت(@)(@@)(@@)(@@) $ 6559 مرزوق أبو عبد الله المدني مولى سعيد بن المسيب مقبول من السادسة تمييز(@)(@@)(@@)(@@) $ 6560 مرزوق الثقفي مولى الحجاج مقبول من الرابعة بخ(@)(@@)(@@)(@@) $ 6561 مرقع بضم أوله وفتح ثانيه وكسر القاف المشددة بن صيفي بالمهملة وقيل بن عبد الله بن صيفي التميمي الحنظلي صدوق من الثالثة د س ق(@)(@@)(@@)(@@) $ 6562 مرة بن شراحيل الهمداني بسكون الميم أبو إسماعيل الكوفي هو الذي يقال له مرة الطيب ثقة عابد من الثانية مات سنة ست وسبعين وقيل بعد ذلك ع(@)(@@)(@@)(@@) $$$ مرة بن عقبة بن نافع أبو عبيدة في الكنى(@)(@@)(@@)(@@) $ 6563 مرة بن عمرو بن حبيب بن واثلة الفهري المدني صحابي قليل للحديث بخ(@)(@@)(@@)(@@) $$$ مرة بن كعب أو كعب بن مرة البهزي في الكاف(@)(@@)(@@)(@@) $ 6564 مرة بن وهب بن جابر الثقفي والد يعلى يقال إن له صحبة إن ثبت الإسناد ق(@)(@@)(@@)(@@) $$$ مرة البهزي هو بن كعب(@)(@@)(@@)(@@) $$$ مرة الفهري هو بن عمرو تقدم(@)(@@)(@@)(@@) $ 6565 مرة شيخ روى عنه المنهال بن عمرو لا يعرف 