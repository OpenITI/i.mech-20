ms101	(@)(@@) % فطرقنني والليل رق أديمه % والنجم كاد يهم بالتعريد % 7(@)(@@) % ووجدت برد حليهن ، وهز من % عطفيه ذو الرعثات للتغريد % 8(@)(@@) % فانجاب من أنوارهن ظلامه % وأظلهن دجى ذوائب سود % 9(@)(@@) % وأنا بحيث القرط من أجيادها % % ينأى ، ويقرب محملي من جيدي % % 10(@)(@@) % كرمت مضاجعنا فليث على التقى % % أزري وجيب عن العفاف برودي % % PageV01P328 11(@)(@@) % أزمان ينفض لمتي مرح الصبا % % وهو الشفيع إلى الكعاب الرود % 12(@)(@@) % ومشاربي زرق الجمام فلم ينل % مني الأوام بمنهل مورود % 13(@)(@@) % فارفض شمل الأنس إذ جمع البلى % % بزرود ، بين معاهد وعهود % 14(@)(@@) % وتقاسمتني بعده عقب النوى % % حتى لففت تهائما بنجود % 15(@)(@@) % وفليت ناصية الفلا بمناسم % وسم المطي بها جباه البيد % 16(@)(@@) % فسقى الغمام - ولست أقنع بالحيا - % أيامنا بين اللوى فزرود % 17(@)(@@) % بل جادها ابن العامري براحة % وطفاء صيغ بنانها من جود % 18(@)(@@) % متوقد العزمات ، لو رميت بها % % زهر النجوم لآذنت بخمود % 19(@)(@@) % ومواصل أرقا على طلب العلا % % في معشر عن نيلهن رقود % 20(@)(@@) % ذو ساحة فيحاء معروف بها % % وزر اللهيف وعصرة المنجود % PageV01P329 21(@)(@@) % ملثومة العرصات ، في أرجائها % % مثوى جنود أو مناخ وفود % 22(@)(@@) % لما توشحت البلاد بفتنة % ما إن تصيد سوى نفس الصيد % 23(@)(@@) % وتشب شعثاء الفروع وتمتري % % أخلاف حرب للمنون ولود % 24(@)(@@) % أوهى معاقدها وأطفأ نارها % % قبل انتشار لظى وبعد وقود % 25(@)(@@) % بالجرد تمتاح العجاج وغلمة % في الغاب من أسل القنا كأسود % 26(@)(@@) % من كل وطاء على قمم العدا % % بحوافر خلقت من الجلمود % 27(@)(@@) % وصوارم عرين من أغمادها % % حتى ارتدين من الطلى بغمود % 28(@)(@@) % ولو انتضى أقلامه السود احتمى % % ببض الصفاح بها من التجريد % 29(@)(@@) % والسمر من حذر التحطم في الوغى % % تبدي اهتزاز منضنض مطرود % 30(@)(@@) % فكأنهن أعرن من أعدائه % يوم اللقاء تلوي المزؤود % PageV01P330 31(@)(@@) % وهم إذا ما الروع قلص ظله % عن كل مستلب الحشاشة مود % 32(@)(@@) % من سائل صفدا يؤمل سيبه % ومكبل في قده مصفود % 33(@)(@@) % وكلاهما من رهبة أو رغبة % بأسا وجودا ، موثق بقيود % 34(@)(@@) % كم قلت للمتمرسين بشأوه % أرميهم بقوارع التفنيد % 35(@)(@@) % غاض الوفاء فليس في 
ms102	 صفحاتهم % ماء ، وفي الأحشاء نار حقود % 36(@)(@@) % وحضورهم في حادث كمغيبهم % وقيامهم لملمة كفعود % 37(@)(@@) % لم يبتنوا المجد الطريف ولا اقتنوا % % منه التليد بأنفس وجدود % 38(@)(@@) % لا تطلبوه ، فشر ما لقي امرؤ % في السعي خيبة طالب مكدود % 39(@)(@@) % لك يا علي مآثر في مثلها % % حسد الفتى ، والفضل للمحسود % 40(@)(@@) % وضحت مناقبك التي لم يخفها % % حسد يلثمه العدا بجحود % PageV01P331 41(@)(@@) % والناس غيرك ، والعلا لك كلها % % ضلوا معالم نهجها المسدود % 42(@)(@@) % فاستقبل النيروز ، طلق المجتلى % % والدهر عذب الورد نضر العود % 43(@)(@@) % في دولة ترخي ذوائبها على % % عز يلاذ بظله الممدود % PageV01P332 البحر : طويل 1(@)(@@) % قنعت وريعان الشباب بمائه % ولم يتبسم وافد الشيب في الراس % 2(@)(@@) % وأعرضت عن دنيا تولى نعيمها % % فما بيد الساقي سوى فضلة الكاس % 3(@)(@@) % ولا عز حتى يضرب المرء جأشه % على اليأس فانفض راحتيك من الناس % PageV01P333 البحر : طويل 1(@)(@@) % سقى دارها من منحنى الأجرع الفرد % أجش نموم البرق مرتجز الرعد % 2(@)(@@) % فبات يحيي بالحيا عرصاتها % % إذا حدرت فيها النعامى لثامها % % 3(@)(@@) % فلا زال يكسوها الربيع وشائعا % ترف حواشيها على علمي نجد % 4(@)(@@) % ويفعم غدرانا كأن يد الصبا % % تجر عليها رفرف النثرة السرد % 5(@)(@@) % بها تسحب الأرماح فهر بن مالك % إذا ما شحا الراعي ليكرع في الورد % 6(@)(@@) % وتدفع عنه كل أشوس باسل % بمسنونة زرق وملبونة جرد % 7(@)(@@) % يصوب بأيديهم نجيع ونائل % ولولا الندى لم تستنر صفحة المجد % 8(@)(@@) % بكى حضن إذ عريت هضباته % من البطل الجحجاح والفرس النهد % 9(@)(@@) % وفي الجيرة الغادين هيفاء غادة % نأت ، لادنا قرط لظمياء من عقد % 10(@)(@@) % إذا نظرت أغضى لها الريم طرفه % وإن سفرت أخفى سنا البدر ما تبدي % % PageV01P334 11(@)(@@) % خليلي إن عللتماني فعرضا % % بها قبل تصريح الفؤاد عن الوجد % 12(@)(@@) % فما هت علوي الرياح ، ولا بدا % % سنا بارق ، إلا طربت إلى هند % % 13(@)(@@) % وقد كمنت في القلب مني صبابة % إليها ، كمون النار في طرف الزند % 14(@)(@@) % أأنقض عهد المالكية باللوى % % إذا لا رعى العلياء إن خنتها عهدي % % 15(@)(@@) % وأغدر وابنا خندف يهتفان بي % % ويلمع 
ms103	 حد السيف من خلل الغمد % 16(@)(@@) % ولو لم يكن في الوفاء سجية % دعاني إليها الأريحي أبو سعد % 17(@)(@@) % فتى يفتري شأو المعالي بهمة % تناجي غرار السيف في طلب الجمد % 18(@)(@@) % وما روضة حل الربيع نظاقها % % وجرت بها الأنواء حاشية البرد % 19(@)(@@) % إذا حدرت فيها التعمامى لثامها % % ثنى عطفه الحوذان والتف بالرند % 20(@)(@@) % بأطيب نشرا من شمائله التي % % تنم برياها على العنبر الورد % PageV01P335 21(@)(@@) % أغر إذا هزته نغمة معتف % تبلج عن أكرومة وندى عد % 22(@)(@@) % إليك زجرت العيس بين عصابة % كهول وشبان وأغلمة مرد % 23(@)(@@) % تخوض خداري الظلام بأوجه % تقايض غي الداعرية بالرشد % 24(@)(@@) % على كل فتلاء الذراع كأنها % % من الضمر شلو الأصبحي من القد % 25(@)(@@) % تركنا وراء الرمل دار إقامة % ملأت بها كفي من لبد الأسد % 26(@)(@@) % ولولاك لم تخطر ببالي قصائد % هوابط في غور طوالع من نجد % 27(@)(@@) % لحقت بها شأو المجيدين قبلها % % وهيهات أن يؤتى بأمثالها بعدي % % 28(@)(@@) % فهن عذارى ، مهرها الود لا الندى % % وما كل من يعزى إلى الشعر يستجدي % % PageV01P336 البحر : طويل 1(@)(@@) % خليلي ما بال الليالي تلفتت % إلي بأعناق الخطوب الطوارق % 2(@)(@@) % وأعقبني قبل الثلاثين صرفها % % بسود دواهيها بياض المفارق % 3(@)(@@) % ولست أذم الدهر فيما يسومني % % وقد حمدت في النائبات خلائقي % % 4(@)(@@) % لئن أنا لم أخلف شبا الرمح في الوغى % % بأخرس رعاف الخياشيم ناطق % 5(@)(@@) % فلا شام في هام الأعادي مهندا % يميني ، ولا شم الحمائل عاتقي % % PageV01P337 البحر : طويل 1(@)(@@) % ألا بأبي كعب خليلا وصاحبا % وناهيك كعب من مغيث ومصرخ % 2(@)(@@) % أروع به سرب القطا كل ليلة % تمد جناحي أقتم الريش أفتخ % 3(@)(@@) % إذا سيم خسفا أدركته حفيظة % تصعر خد العامري فينتخي % % 4(@)(@@) % يزور الوغى في غلمة من هوازن % رقاق حواشي الأوجه الغر شرخ % % 5(@)(@@) % وجوه كما شيف الدنانير ، عودت % إباء عرانين من العز شمخ % 6(@)(@@) % وأيد تبز التاج قمة أبلج % وتكسو قناع النقع لمة أبلخ % % 7(@)(@@) % لئن جمعت ما بين ظهر ولبة % فكم فرقت ما بين هام وأفرخ % 8(@)(@@) % أقول لخرق من لؤي بن غالب % بأرجاء 
ms104	 مغبر من البيد سربخ % % 9(@)(@@) % أجزنا وأيم الله ساحة حاجر % فمل بهواديها إلى رمل مربخ % 10(@)(@@) % هنالك حي من قريش تحدبوا % % على الجار والعافي ، بعاطفة الأخ % PageV01P338 11(@)(@@) % إذا ما صباح فر عنهم شميطه % % وهد الدجى من ركنها المتفسخ % 12(@)(@@) % أقمنا بحيث الطل ذاب شقيطه % على زهر بالمندلي مضمخ % 13(@)(@@) % فلا زال حادي الخصب يسحب فوقه % ذوائب سحب تلثم الأرض نضخ % 14(@)(@@) % وذي بخل لا يتبع الودق برقه % متى يتخرق في المواهب يرضخ % 15(@)(@@) % دعاني إلى ضحضاح ماء أعافه % لدى عطن إن يغشه الركب يسبخ % 16(@)(@@) % إليك فلم تظفر يداك بطامع % متى ما يفتش عن رمادك ينفخ % 17(@)(@@) % إذا ما أناخ الضيف عندك نضوه % بكى رحمة للأرحبي المنوخ % 18(@)(@@) % وأرحب باعا منك كعب بن مدلج % متى ما أزره مدحة لا أوبخ % % 19(@)(@@) % عن الشرف الوضاح قد أديمه % وبالحسب المغمور لم يتلطخ % 20(@)(@@) % إذا ما أتاه الضيف لم يعتم القرى % % ولم يحتجب عن معتفيه ببرزخ % PageV01P339 21(@)(@@) % وإن طاش حرب كف بالحلم غربها % % وأهوى بنيران إلى السلم بوخ % 22(@)(@@) % وذي لجب كالطود كادت رعانه % تميد بأركان حواليه سوخ % 23(@)(@@) % فشدت نواصي الخيل وهي تدوسه % بأثبت منه في اللقاء وأرسخ % 24(@)(@@) % بأروع فضفاض الرداء مذرب % أغرة غرم للخطوب مدوخ % 25(@)(@@) % يخوض القنا الرعاف ، ليثت كعوبه % بأذرع أبطال لهاميم بذخ % 26(@)(@@) % إذا ثار ريعان العجاج تلثموا % % على غرر تستوقف العين شدخ % PageV01P340 البحر : طويل 1(@)(@@) % تنكر لي دهري ولم يدر أنني % % أعز ، وأحداث الزمان تهون % 2(@)(@@) % فظل يريني الخطب كيف اعتداؤه % وبت أريه الصبر كيف يكون % PageV01P341 البحر : رجز تام 1(@)(@@) % يا طرة الشيح بسفح عاقل % كيف تناجيك صبا الأصائل % 2(@)(@@) % لاخطر النعام فيك موهنا % يريغ توشيم الخضاب الناصل % 3(@)(@@) % وصافحتك الريح حسرى ، والثرى % % مرتضع در الغمام الهاطل % 4(@)(@@) % فرب أعرابية نشوى الخطا % % تقلق أثناء الوشاح الجائل % 5(@)(@@) % ترمي حواليك بأحداق المها % % إذا ارتقبن غرة الحبائل % 6(@)(@@) % ويح الهوى كيف أصاب لحظها % % وقد أطاش أسهمي ، مقاتلي % % 7(@)(@@) % أما كفاها القد ، وهو رامح % ألا تراميني بطرف نابل % 8 
ms105	(@)(@@) % أصغت إلى الواشين بعد صبوة % أرد فيها لغط العواذل % 9(@)(@@) % فليتها أوصت بنا خيالها % % غداة أبدت صفحة المزايل % 10(@)(@@) % تضحك من ذي وله يبكي الصبا % % شوقا إلى أيامه القلائل % PageV01P342 11(@)(@@) % أيا أخا حنطلة بن مالك % ناضل عن الفهري أخت وائل % 12(@)(@@) % فالنثرة الحصداء لم تسنها % % إلا على عبل الذراع باسل % 13(@)(@@) % والثأر لا تغفل عنه خندف % فكيف أغضيت على الطوائل % 14(@)(@@) % إن لم أروع قومها بفتية % يمشون مشي الأسد بالمناصل % 15(@)(@@) % تشلهم بأذرع مفتولة % على الرقاب في عرا السلاسل % 16(@)(@@) % فما انتضت أفرى حسام للطلى % % من خير جفن ضمه قوابلى % % 17(@)(@@) % وقد أراب - والرقيب هاجع - % طروقها ترفل في الغلائل % 18(@)(@@) % مرت بجرعاء الحمى فعطرت % أشباح أطلال بها نواحل % 19(@)(@@) % تبغي ، كأنضاء السيوف ، فتية % موسدين أذرع الرواحل % 20(@)(@@) % فأرقت أسوان خاط جفنه % كرى هو الصهباء في المفاصل % PageV01P343 21(@)(@@) % عد عن الطيف فما أتى به % حلم جنته سورة البلابل % 22(@)(@@) % والشعر في غير الإمام صادر % عن فكر تعللت بالباطل % 23(@)(@@) % من معشر شم الأنوف ذادة % بيض الوجوه سادة أماثل % 24(@)(@@) % دلت على أعراقهم أفعالهم % والمكرمات جمة المخائل % 25(@)(@@) % فطرفوا عن العلا بأذرع % شابت أسابي دم بنائل % 26(@)(@@) % شنوا على الأعداء غاراتهم % تترى كولغ الأذؤب العواسل % 27(@)(@@) % وكم أناخوا الحرب وهي تلتظي % % على مسر الضغن ، بالكلاكل % 28(@)(@@) % وقد وفوا إذ ضمنوا يوم الوغى % % ري القنا للأسل النواهل % 29(@)(@@) % فهاشم خير بني فهر وهم % خير الورى وأشرف القبائل % 30(@)(@@) % لله بيت شد من أطنابه % ركز القنا في ثغر القنابل % PageV01P344 31(@)(@@) % عبد مناف ضربت أوتاده % على طلى الأعداء والكواهل % 32(@)(@@) % هل يخفض السادر من هديره % فالمجد لا يعبق بالأراذل % 33(@)(@@) % كم يلقح الآمال وهي ترعوي % % إليه في أعقاب جد حائل % 34(@)(@@) % يمسي إذا الليل ارجحن ظله % في شغل عن الرقاد شاغل % 35(@)(@@) % وإن أضاء الصبح زر صدره % على الجوى مرتعد الخصائل % 36(@)(@@) % سيخطر الآبي على شكيمه % من زبر الحديد في الخلاخل % 37(@)(@@) % ودون ما يعلي إليه طرفه % عيطاء تدمي قدم المساجل % 38(@)(@@) % يا خير من 
ms106	 تفتر كل شارق % عن ذكره ضمائر المحافل % 39(@)(@@) % جاءك شهر الله طلق المجتلى % % مبارك الأيام والليائل % 40(@)(@@) % يهدي لك الأجر وتقريه الندى % % من نعم مترعة المناهل % PageV01P345 41(@)(@@) % فليرع حوذان الغمير هجمة % لعامر طائرة النسائل % 42(@)(@@) % فلي بأكناف العراق مسرح % رحب المندى أرج الخمائل % 43(@)(@@) % ومنحة ضافية أرمي بها % % طرفي في إثر الغمام الوابل % 44(@)(@@) % وأستدر صوبها بمدحة % تغرى لها الأسنان بالأنامل % 45(@)(@@) % غراء لو ذابت لصاغت الدمى % % منها حلى أجيادها العواطل % 46(@)(@@) % ولو رضيت حبرت رواتها % % بها كلام العرب الأوائل % PageV01P346 البحر : وافر تام 1(@)(@@) % سواي يجر هفوته التظني % % ويرخي عقد حبوته التمني % % 2(@)(@@) % ويلبس جيده أطواق نعمى % % يشف وراءها أغلال من % 3(@)(@@) % إذا ما سامه اللؤماء ضيما % تمرغ في الأذى ظهرا لبطن % 4(@)(@@) % وظل نديم غاطية وروض % وبات صريع باطية ودن % 5(@)(@@) % وأشعر قلبه فرق المنايا % % وأودع سمعه نغم المغني % % 6(@)(@@) % وصلصلة اللجام لدي أحرى % % بعز في مباءته مبن % 7(@)(@@) % فلست لحاصن إن لم أقدها % % عوابس تحت أغلمة كجن % 8(@)(@@) % أقرطها الأعنة في ملاء % ينشرها مثار النقع دكن % 9(@)(@@) % وأملأ من عصي الدمع قسرا % % محاجر كل طيعة التثني % % 10(@)(@@) % رأتني في أوائلهامشحا % ألهب جمرتي ضرب وطعن % PageV01P347 11(@)(@@) % وأسطو سطوة الأسد المحامي % % وتنفر نفرة الرشأ الأغن % 12(@)(@@) % وحول خبائها أشلاء قتلى % % رفعن عقيرة الطير المرن % 13(@)(@@) % وسربالي مضاعفة أفيضت % على نزق الشباب المرجحن % 14(@)(@@) % كأني خائض منها غديرا % يشب النار فيه خبيء جفن % 15(@)(@@) % إذا غدر السنان وفى بضرب % هززت له شباه فلم يخني % % 16(@)(@@) % ومجنى العز من بيض رقاق % وسمر تخلس المهجات لدن % 17(@)(@@) % فمالك يابنة القرشى ملقى % % قناعك والفؤاد مسر حزن % 18(@)(@@) % ذريني والحسام أفدك مالا % فراحة من يعولك في التعني % % 19(@)(@@) % وغير أخيك يرقب مجتديه % % تبسم بارق وعبوس دجن % 20(@)(@@) % فها أنا أوسع الثقلين صدرا % ولكن الزمان يضيق عني % % PageV01P348 البحر : طويل 1(@)(@@) % ألمت ودوني رامة فكثيبها % % ينم على مسرى البخيلة طيبها % % 2(@)(@@) % وفوق الغريريات أعناق فتية % يشد طلاها بالرحال دؤوبها % % 3(@)(@@) % وأنى اهتدت ، والليل داج ودونها % % حزون البطاح 
ms107	 من منى وسهوبها % % 4(@)(@@) % وزارت فتى نضو السفار تطاوحت % به نوب تطغى عليه خطوبها % % 5(@)(@@) % وما راقبتها عصبة عامرية % تزر على أسد العرين جيوبها % % 6(@)(@@) % فإن نسيم العنبر الورد إن سرت % إلينا ، ووسواس الحلي ، رقيبها % % 7(@)(@@) % ولله عين تمتري دمعها النوى % % ونفس يعنيها الهوى ويذيبها % % 8(@)(@@) % وكنت إذا الأيكية الورق غردت % أخذت بأحناء الضلوع أجيبها % % 9(@)(@@) % وإن خطرت وهنا صبا مشرقية % على كبدي هاج الغرام هبوبها % % 10(@)(@@) % وإني لأستنشى الرياح فربما % % تجيء بريا أم عمرو جنوبها % % PageV01P349 11(@)(@@) % وأنشق منها نفحة غضوية % ولي عبرات ما تجف غروبها % % 12(@)(@@) % أعلل نفسا بالعراق مريضة % ولكن بأكناف الحجاز طبيبها % % 13(@)(@@) % فهل علمت بنت الحويرث أنني % % مقيم على العهد الذي لا يريبها % % 14(@)(@@) % ومخلسة من روعة البين لمتي % % أقبل الثلاثين استنار مشيبها % % 15(@)(@@) % وما نهنهتني دونها خشية الردى % % وهل هي إلا مهجة وشعوبها % % 16(@)(@@) % ولا خفت أن يستغوي البيد ناظري % % فإني إذا ما اغبرت الأرض ذيبها % % 17(@)(@@) % وبيض أرويها دما عند مأزق % به تشهد الهيجاء أني شبيبها % % 18(@)(@@) % وشعر كنوار الرياض أقوله % إذا الكلمات العور قام خطيبها % % 19(@)(@@) % أنير وأسدي مجد أروع باسم % على حين يلوي بالوجوه قطوبها % % 20(@)(@@) % تصوب بكفيه شآبيب نائل % إذا السنوات الشهب مار ضريبها % % PageV01P350 21(@)(@@) % ويخلف أنواء الربيع إذا كسا % % سنام الحمى بردي عديم نضوبها % % 22(@)(@@) % أخو همم مشغوفة بمكارم % يروح إلى غاياتهن عزيبها % % 23(@)(@@) % ويقصر عنها المدح حتى كأننا % % إذا نحن أثنينا عليها نعيبها % % 24(@)(@@) % أطل على الأكفاء تغلي صدورهم % على حسد تفتر عنه ندوبها % % 25(@)(@@) % وصاغت له في كل قلب محبة % يد بالأيادي ثرة تستثيبها % % 26(@)(@@) % ولو أضمرت فيه العداوة أنفس % لحدث عن أسرارهن قلوبها % % 27(@)(@@) % إليك أبا حسان أزجي ركائبا % لها من رحاب الأكرمين خصيبها % % 28(@)(@@) % ويطربها الحادي بمدحك موهنا % فتخدي وقد مس المراخي لغوبها % % 29(@)(@@) % ولولاك لم أطرق أحاوص عامر % ولا نبحتني في كليب كليبها % % 30(@)(@@) % فيممت أخوالي هلال بن عامر % واغربة الحيين شاج نعيبها % % PageV01P351 31(@)(@@) % أؤمل أن ألقى الخطوب فتنثني % % نوابي عن شلوي لديهم نيوبها % % 32 
ms108	(@)(@@) % فمعذرة الأيام مقبولة بهم % ومغفورة للنائبات ذنوبها % % PageV01P352 البحر : طويل 1(@)(@@) % أقول لنفسي ، وهي تطوى ضلوعها % % على كمد يمتار وقدته الجمر : % 2(@)(@@) % أبى الله إلا أن تلوذي بمعشر % على لؤمهم ألقى مراسيه الوفر % 3(@)(@@) % لئن رم في أحوالهم حادث الغنى % % فقد كاد من أفعالهم يقطر الفقر % 4(@)(@@) % ومن زارهم شد الحيازيم فيهم % على ما يعانيه وإن غلب الصبر % 5(@)(@@) % فإن مقاساة اللئام على الفتى % % بلاء ولم يرعف بأمثالها الدهر % PageV01P353 البحر : كامل تام 1(@)(@@) % نظرت بألحاظ الظباء العين % ظمياء بالعقدات من يبرين % 2(@)(@@) % ترنو وقد ولع الفتور بعينها % % ولع الهوى بفؤادي المفتون % 3(@)(@@) % ولها استراقة نظرة نالت بها % % مالا ينال بصارم مسنون % 4(@)(@@) % ونشدت قلبي حين عز مرامه % إذ ضل بين محاجر وعيون % 5(@)(@@) % تلك النواظر ما تفيق من الكرى % % وبها سهاد الهائم المحزون % 6(@)(@@) % ياسعد إن الجزع أكثب فاستعر % نظرات طاوي ليلتين شفون % 7(@)(@@) % واجذب زمام الأرحبي ولا تبل % ذكرا وصلن حنينه بحنيني % % 8(@)(@@) % واشتاق كاظمة فجن جنونه % وذكرت ساكنها فجن جنوني % % 9(@)(@@) % لمن الظعائن دون أكثبة الحمى % % يطوي الفلاة بهن كل أمون % 10(@)(@@) % فالآل بحر حين ماج بركبها % % وجرى الركائب فيه جري سفين % PageV01P354 11(@)(@@) % عارضتها فنظرن عن حدق المها % % يلمحن بارقة الغمام الجون % 12(@)(@@) % وتكاثرت دفع الدموع كأنها % % نفحات سيبك ياقوام الدين % 13(@)(@@) % لله درك من مدبر دولة % وجدته خير مؤازر ومعين % 14(@)(@@) % يلقي بعقوتها ذراعي ضيغم % أدمى شبا الأنياب دون عرين % 15(@)(@@) % ويحوطها بيراعه وحسامه % متدفقين بنائل ومنون % 16(@)(@@) % وضحت مناقبه ، فليس بمدع % شرفا ، ولا في مجده بظنين % 17(@)(@@) % واستأنف الفضلاء في أيامه % عزا فلم يتضاءلوا للهون % 18(@)(@@) % وتطوحت بي همة درأت إلى % % وجناء جائلة النسوع وضيني % % 19(@)(@@) % وطرقت ساحته فألقمت الثرى % % صنفات ذيل دلاصي الموضون % 20(@)(@@) % من مبلغ بطحاء مكة أنني % % لم أرع بالجرعاء روض هدون % PageV01P355 21(@)(@@) % ورأيت من يمتار ضوء جبينه % بصرى ، فقبلت الثرى بجبيني % % 22(@)(@@) % لولا العلا ، وأنا القمين بنيلها % % لنفضت من منح الملوك يميني % % 23(@)(@@) % فالعز بالبطحاء بين مغرر % شرس وأبلج شامخ العرنين % 24(@)(@@) % ولأشكرن 
ms109	 نداك شكر خميلة % لندى يرقرقه الغمام هتون % 25(@)(@@) % ولأنظمن قصائدا لف الحجى % % فيها سهول بلاغة بحزون % 26(@)(@@) % وتهز أعطاف الملوك كأنها % % ريح الشمال تعثرت بغصون % 27(@)(@@) % وكأن راويها يطو عليهم % بابن الغمامة وابنة الزرجون % PageV01P356 البحر : وافر تام 1(@)(@@) % أنا ابن الأكرمين أبا وأما % ولي فوق السها همم مطله % 2(@)(@@) % كثير بي أمية في المعالي % % ومالي من سماحي فيه قله % 3(@)(@@) % سأطلب رتبة شماء حتى % % يمد بها علي العز ظله % 4(@)(@@) % وأزحف بالجياد إلى مكر % به الأبطال دامية الأشله % 5(@)(@@) % ولو رأت البدور نعال خيلي % % لصرن بها حواسد للآهله % PageV01P357 البحر : بسيط تام 1(@)(@@) % تلك الحدوج يراعيهن غيران % ودونهن ظبا تدمى وخرصان % 2(@)(@@) % مررن بالقارة اليمنى فعارضها % % أسد تسارقها الألحاظ غزلان % 3(@)(@@) % ينحو الأجيرع من حزوى أغيلمة % سالت بهم برق الصمان غران % 4(@)(@@) % والعين تلحظهم شزرا فتطرفها % % بالمشرفية والخطي فرسان % 5(@)(@@) % تبطنوا عقدات الرمل من إضم % بحيث يلثم فرع الضالة البان % 6(@)(@@) % والجرد صافنة ليثت بأجرعه % % لها على الأثلات الشم أرسان % 7(@)(@@) % وفي الحدوج الغوادي كل غانية % يروى مؤزرها ، والخصر ظمآن % 8(@)(@@) % تهزني طربات من تذكرها % % كما ترنح نضو الراح نشوان % 9(@)(@@) % كم زرتها بنجاد السيف مشتملا % والنجم في الأفق الغربي حيران % 10(@)(@@) % وللعريب بأكناف الحمى حلل % طرقتها ، والهوى ذهل وشيبان % PageV01P358 11(@)(@@) % فراعها قرشي في مراعفه % تيه يهز به عطفيه عدنان % 12(@)(@@) % وبت أحبو إليها وهي خائفة % كما حبا في حواشي الرمل ثعبان % 13(@)(@@) % فأقشع الروع عنها إذ توسنها % % أغر منخرق السربال شيحان % 14(@)(@@) % وفض غمد حسامي في العناق لها % % ضمي ، كما التف بالأغصان أغصان % 15(@)(@@) % والشهب تحكي عيون الروم ، خيط على % % أحداقها الزرق للسودان أجفان % 16(@)(@@) % يا أخت معتقل الأرماح يتبعه % إلى وقائعه نسر وسرحان % 17(@)(@@) % أعرضت غضبى وأغريت الخيال بنا % % فلست ألقاه إلا وهو غضبان % 18(@)(@@) % يسري إلي ولا أحظى بزورته % فالطرف لا سهرت عيناك يقظان % 19(@)(@@) % وإنما الطيف يستشفي برؤيته % على النوى مستميت الشوق وسنان % 20(@)(@@) % ياروع الله قوما ريع جارهم % والذل حيث ثوى جنب وهمدان % PageV01P359 21(@)(@@) % ملطمون بأعقار 
ms110	 الحياض لهم % بكل منزلة للؤم أوطان % 22(@)(@@) % فليس يأمنهم في السلم جيرتهم % ولا يخافهم في الروع أقران % 23(@)(@@) % فارقتهم ولهم نحوي إذا نظروا % % لحظ تلظيه أحقاد وأضغان % 24(@)(@@) % وبين جنبي قلب لا يزعزعه % % على مكافحة الأيام أشجان % 25(@)(@@) % ألقى الخطوب ولي نفس تشيعني % % غضبى وأجزع إما بان جيران % 26(@)(@@) % أكل يوم نوى تشقى الدموع بها % % إلى غوارب تفريهن كيران % 27(@)(@@) % فالغرب مثوى أصيحابي الذين هم % عشيرتي ولنا بالشرق إخوان % 28(@)(@@) % أستنشق الريح تسري من ديارهم % وهنا كأن نسيم الريح ريحان % 29(@)(@@) % فياسقى الله زوراء العراق حيا % تروى بشؤبوبه قور وغيطان % 30(@)(@@) % مزن إذا هز فيه البرق منصله % علا من الرعد في حضنيه إرنان % PageV01P360 31(@)(@@) % يرمي بألهوبه والغيث منسكب % حتى التقت فيه أمواه ونيران % 32(@)(@@) % فقد عرفت بها قوما ألفتهم % كما تمازج أرواح وأبدان % PageV01P361 البحر : مجزوء الخفيف 1(@)(@@) % رب ليل بالصبح من % وجه ليلى توشحا % % 2(@)(@@) % صافحت فورة العشا % % ء به نهضة الضحى % % PageV01P362 البحر : طويل 1(@)(@@) % إذا زم للبين الغداة جمال % فلا وصل إلا أن يزور خيال % 2(@)(@@) % تفرق أهواء الجميع ، وثورت % ركائب ، أدنى سيرهن نقال % 3(@)(@@) % وفي الركب نشوى المقلتين كأنها % % وديعة أدحي ، وهن رئال % 4(@)(@@) % لها نظرات الريم تملأ سمعه % حفيفا بأيدي القانعين نبال % 5(@)(@@) % وفي الدمع من خوف الوشاة إذا رنت % إلينا أناة والمطي عجال % 6(@)(@@) % فياحسرات النفس حين تقطعت % لبين - كما شاء الغيور - حبال % 7(@)(@@) % ونحن بنجد قبل أن تفطن النوى % % بنا ، ويروع القاطنين زيال % 8(@)(@@) % على منهل عذب النطاف كأنما % % أدار به كأس الشمول شمال % 9(@)(@@) % ركزنا حواليه الرماح ومالنا % % سواها إذا فار الهجير ظلال % 10(@)(@@) % يلوذ بها من عبد شمس جحاجح % بهم تلقح الآمال وهي حيال % PageV01P363 11(@)(@@) % ملوك إذا استلوا الظبا استنهض الردى % % صوارم دبت فوقهن نمال % 12(@)(@@) % فليس لهم غير المعالي لبانة % ولا غير أطراف السيوف ثمال % 13(@)(@@) % علا كأنابيب الرماح تناسقت % بناها لنا عم أغر وخال % 14(@)(@@) % وخير عتادي في الحروب مهند % نفى صدأ عن مضربيه صقال % 15(@)(@@) % وفي السلم ميلاء الخمار كأنها 
ms111	 % % إذا التفتت خوف الرقيب ، غزال % 16(@)(@@) % وكم طرقتني والنجوم كأنها % % على مفرق الليل الأحم ذبال % 17(@)(@@) % فبرح بي سحر حرام بطرفها % % دمي لك يا سحر العيون حلال % 18(@)(@@) % فلا تعديني يابنة القوم نائلا % يطول اقتضاء دونه ومطال % 19(@)(@@) % ومن كان عفا في هواك ضميره % فسيان هجر عنده ووصال % 20(@)(@@) % ولولا التقى لم أترك البيض كالدمى % % وإن ظللت بالمرهفات حجال % PageV01P364 21(@)(@@) % وإني لأثني النفس عما تريده % إذا كان في العقبى على مقال % 22(@)(@@) % ولا أرتضي خلا يدوم وداده % على طمع ما دام عندي مال % 23(@)(@@) % أرى الناس أتباع الغنى ، ولمن نبا % % به الدهر منهم ضجرة وملال % 24(@)(@@) % إذا ما استفدت المال مالوا بودهم % إليك ، وحالوا إن تغير حال % 25(@)(@@) % فمن لي على غي التمني بصاحب % عزيمته للمشرفي مثال % 26(@)(@@) % إذا مد من أثناء خطوته المدى % % فليس يناجي أخمصيه كلال % 27(@)(@@) % ويقدم والأسياف تغمد في الطلى % % وللخيل من صوب الدماء نعال % 28(@)(@@) % وإن طرق الأعداء والليل مظلم % أطلت عليهم بالصباح نصال % 29(@)(@@) % فيصدرها عنهم رواء متونها % % وقد ورد الهيجاء وهي نهال % 30(@)(@@) % فتى سيبه قيد الثناء ، وسيفه % لأدم المتالي في الشتاء عقال % PageV01P365 31(@)(@@) % إذا ماسألت الحي عن خيرهم أبا % أشارت نساء نحوه ورجال % PageV01P366 البحر : مجزوء الكامل 1(@)(@@) % وأغر إن عذر الورى % % في حبه عذل الحجى % % 2(@)(@@) % وقيبه في ناظري % قذى وفي صدري شجى % % 3(@)(@@) % أهوى إلي بكأسه % كالجمر حين تأججا % % 4(@)(@@) % والليل أسحم لم يكد % سرباله أن ينهجا % % 5(@)(@@) % فافتر عن قصر أها % % ب بفجره فتبلجا % % 6(@)(@@) % وكأن طرة صبحه % ليثت بناصية الدجى % % PageV01P367 البحر : وافر تام 1(@)(@@) % علوت فدونك السبع الشداد % وأنت لكل مكرمة عماد % 2(@)(@@) % ودان لك العدا فلهم خضوع % ولولا الرعب لج بهم عناد % 3(@)(@@) % وعزوا حين غبت فهم أسود % وذلوا إذ حضرت فهم نقاد % 4(@)(@@) % إذا ما سارقوك اللحظ أدنت % مسافته المهندة الحداد % 5(@)(@@) % كأنهم ونار الحرب يقظى % % تمشى في عيونهم الرقاد % 6(@)(@@) % هم بخلوا بطاعتهم ولكن % على الأسلات بالأرواح جادوا % % 7(@)(@@) % وغرهم بك المطوي كشحا % على إحن يغص 
ms112	 بها الفؤاد % 8(@)(@@) % وكيف يروم شأوك في المعالي % % وشسعك فوق عاتقه نجاد % 9(@)(@@) % يضج الدست من حنق عليه % ويبصق في محياه الوساد % 10(@)(@@) % فأخلد من غوايته إليهم % وبان له بهلكهم الرشاد % PageV01P368 11(@)(@@) % وسول بالمنى لهم أمورا % أعاروها جماجمهم فبادوا % % 12(@)(@@) % ودبرها فدمرها برأي % تجانبه الإصابة والسداد % 13(@)(@@) % خبت نجداتهم ، والجبن يعدي % % به ، والنار يطفئها الرماد % 14(@)(@@) % إذا صلحت له حال فأهون % عليه بأن يعمهم الفساد % 15(@)(@@) % كأن النقع إذ أرخى سدولا % عليهم قبل مهلكهم حداد % 16(@)(@@) % كأن الصافنات الجرد فيهم % % يداف على قوائمها الجساد % 17(@)(@@) % فهم من بين معتجر بسيف % ومقتسر يؤرقه الصفاد % 18(@)(@@) % وآخر ترجف الأحشاء مشنه % نجا بذمائه ، ولك المعاد % 19(@)(@@) % وكان له سواد الليل جارا % وبئس الجار للبطل السواد % 20(@)(@@) % يحرك طرفه وبه لغوب % ويمسح طرفه وبه سهاد % PageV01P369 21(@)(@@) % إذا ارتكض الكرى في مقلتيه % أقض على جوانحه المهاد % 22(@)(@@) % أبى أن يلتقي الجفنان منه % كأن الهدب بينهما قتاد % 23(@)(@@) % فألحمهم سيوفك ، إن فيها % % إذا انتضيت ، رغائب تستفاد % 24(@)(@@) % ولست بواجد لهم ضميرا % أبن به وفاء أو وداد % 25(@)(@@) % يلفون الضلوع على حقود % لها بمقيل همهم اتقاد % 26(@)(@@) % إذا ما السيف خشن شفرتيه % أخو الغمرات لان له القاد % 27(@)(@@) % وكم لك من مواطن صالحات % بهن لفارج الكرب احتشاد % 28(@)(@@) % وأبطال كآساد تمطت % كذؤبان الرداه بهم جياد % 29(@)(@@) % تخالهم أراقم في دروع % تحدق من مطاويها الجراد % 30(@)(@@) % إذا دلفوا إلى الهيجاء عفت % على الأعداء داهية نآد % PageV01P370 31(@)(@@) % بيوم كاد من قرم إليهم % تلمظ في حواشيه الصعاد % 32(@)(@@) % وطئت بهم سنام الأرض حتى % % تركت تلاعها وهي الوهاد % 33(@)(@@) % تلقي الطعن لبات المذاكي % % ويدمي من حواميها الطراد % 34(@)(@@) % فأنت الغيث ، شيمته سماح % وأنت الليث ، عرضته جلاد % 35(@)(@@) % من النفر الألى نقص المسامي % % غداة رأى مساعيهم وزادوا % % 36(@)(@@) % لهم أيد إذا اجتديت سباط % تصافحهن آمال جعاد % 37(@)(@@) % وواد مونق الجنبات ، تأوي % % إليه ، إذا تجهمت البلاد % 38(@)(@@) % ومثلك زان سؤدد أوليه % بطارفه ، وزينه التلاد % 39(@)(@@) % فأنميت الذي غرسوه قبلا % كما يتعاهد الروض العهاد 
ms113	 % 40(@)(@@) % فلا زالت زنادك واريات % فقد وريت بدولتك الزناد % PageV01P371 البحر : طويل 1(@)(@@) % وعاذلة والفجر في حجر أمه % تلوم وما أدري علام تلوم % 2(@)(@@) % تعيرني أن يرضع الحمد نائلي % % وتعلم ما أسعى له وأروم % 3(@)(@@) % ولي همم لا ينكر المجد أنها % % بأطرار آفاق السماء نجوم % 4(@)(@@) % وفيها سرور النفس واليسر جاذب % بضبعي وإن أعسرت فهي هموم % 5(@)(@@) % دون المعالي منية أو منية % وكل على ورد المنون يحوم % 6(@)(@@) % سأطلبها والنقع يضفو رداؤه % وجرد المذاكى في الدماء تعوم % 7(@)(@@) % فما أربي إلا سرير ومنبر % وذكر على مر الزمان يدوم % PageV01P372 البحر : وافر تام 1(@)(@@) % سرت ، والليل يرمز بالصباح % بثينة وهي جائلة الوشاح % 2(@)(@@) % وأجنحة النجوم يملن زورا % لهن تخاوص الحدق الملاح % 3(@)(@@) % ونحن على رحائلنا جنوح % نحث العيس في سرر البطاح % 4(@)(@@) % ويجمح بي إلى العلمين شوق % أفض له اللجام من المراح % 5(@)(@@) % وأنشق من ربا نجد نسيما % يغازل في أباطحه الأقاحي % % 6(@)(@@) % فمالت للكرى حدق تجلي % % رنو الصقر لألأ بالجناح % 7(@)(@@) % وآب خيالها والليل داج % ونضوي فاتر اللحظات طاح % 8(@)(@@) % أحن صبابة ويحن شوقا % كلا القلبين ، ويبك ، غير صاح % 9(@)(@@) % ولو نطق المطي لبث وجدا % يؤرقنا بألسنة فصاح % 10(@)(@@) % أكاسرة الجفون على فتور % سموت لنا ونحن على رماح % PageV01P373 11(@)(@@) % أعاتب فيك أخفاف المطايا % % وأسأل عنك أنفاس الرياح % 12(@)(@@) % تساورني الخطوب ولا ألاقي % % جماح الخطب إلا بالجماح % 13(@)(@@) % رويدك يا زمان ، أكل يوم % معاندة من القدر المتاح ؟ % 14(@)(@@) % وقد طال الثواء على الهويني % % وحن إلى مسارحها لقاحي % % 15(@)(@@) % يجاذب همتي وجه حيي % طلاب العز في زمن وقاح % 16(@)(@@) % وأقطع بالمنى عمري ، ونفسي % % أعللها بآمال فساح % 17(@)(@@) % وأجثم بالعراق ، وللفيافي % % مناسم هذه الإبل القماح % 18(@)(@@) % وهلا أرتقي هضبات مجد % قواعده بيين على الصفاح % 19(@)(@@) % ومثلي حين تبتدر المعالي % % تهون عليه أطراف الرماح % 20(@)(@@) % أأخضع للزمان وفي بنيه % قصور حين نضرب بالقداح % PageV01P374 21(@)(@@) % ويلحفني رداء العز قرم % يحوم على مكارمه امتداحي % % 22(@)(@@) % له والمزن لا يندى جفونا % بنان يد تجن على السماح % 23(@)(@@) % من الشم 
ms114	 الأنوف بني عويف % ذوي النخوات والأدم الصحاح % 24(@)(@@) % يلوثون الحبا ، والعز فيها % % على كرم وأحلام رجاح % 25(@)(@@) % أزرتك يا أبا زفر ثناء % يعاف زيارة العصب الشحاح % 26(@)(@@) % كأنك حين تسمعه اهتزازا % بك النشوات من فضلات راح % 27(@)(@@) % طويت إلى العراق مساب صل % ينضنض عند معتلج الكفاح % 28(@)(@@) % وشمت برأيك الأسياف عنه % فأقلعت الكباش عن النطاح % 29(@)(@@) % وعدت وتحت رايتك العوالي % % تحدث عن حماه المستباح % 30(@)(@@) % فلم يفد العفاة عليك إلا % بآمال ترف على النجاح % PageV01P375 البحر : طويل 1(@)(@@) % ومتشح باللؤم جاذبني العلا % % فقدمه يسر وأخرني عسر % 2(@)(@@) % وطوقت أعناق المقادير ما أتى % % به الدهر حتى ذل للعجز الصدر % 3(@)(@@) % ولو نيلت الأرزاق بالفضل والحجى % % لما كان يرجو أن يثوب له وفر % 4(@)(@@) % فيا نفس صبرا إن للهم فرجة % ومالك إلا العز عندي أو القبر % 5(@)(@@) % ولي حسب يستوعب الأرض ذكره % على العدم والأحساب يدفنها الفقر % PageV01P376 البحر : طويل 1(@)(@@) % سرى طيفها والليل رق ظلامه % وقد حط عن وجه الصباح لثامه % 2(@)(@@) % وهبت عصافير اللوى فتكلمت % وجاوبها فوق الأراك حمامه % 3(@)(@@) % وكنت وأصحابي نشاوى من الكرى % % ونضوي على الوعساء ملقى خطامه % 4(@)(@@) % أجاذب ذكرى العامرية نعسة % بحيث الرقاد الحلو صعب مرامه % 5(@)(@@) % فما راعني إلا الخيال وعتبه % وفجر نضا برد الظلام ابتسامه % 6(@)(@@) % وشهب تهاوت للغروب كأنما % % يذاب على الأفق النضار وسامه % 7(@)(@@) % كأن ظلام الليل ، والنجم جانح % إلى الغرب غمد والصباح حسامه % 8(@)(@@) % فقلت لصحبي إذ وشى الدمع بالهوى % % وأظهر ما تخفي الضلوع انسجامه % 9(@)(@@) % دعوا ناظري يطفو ويرسب في دم % فلولاه ما ألوى بقلبي غرامه % 10(@)(@@) % ولا تعذلوني فالهوى بغلب الفتى % % ولا ينثني عنه للوم يلامه % PageV01P377 11(@)(@@) % لعز على حي بنعمان نازل % مطاف أخيهم بالحمى ومقامه % 12(@)(@@) % يهيم بمكحول المدامع شادن % يهيج زئير العامري بغامه % 13(@)(@@) % ويخضع في كعب لغيران يحتمي % % بجار خزيمي الإباء سوامه % 14(@)(@@) % ولوز بنته الحرب طارت أفيرخ % مجاثمها تحت المغافر هامه % 15(@)(@@) % أيخشى العدا والدهر قوم درؤه % بعثمان مرميا إليه زمامه % 16(@)(@@) % فلو ناول الأقمار أطراف ذمة 
ms115	 % إذا لوقاهن المحاق ذمامه % 17(@)(@@) % إذا سار في الأرض الفضاء بجحفل % ثنى الشمس حيرى في السماء قتامه % 18(@)(@@) % ومد سحابا من قنا ، وقسيه % رعود المنايا ، والبروق سهامه % 19(@)(@@) % يحوط أقاليم البلاد بكفه % يراع على أربابهن احتكامه % 20(@)(@@) % وينحل من نحل وأفعى مشابها % فيحيي ويردي أريه وسمامه % PageV01P378 21(@)(@@) % إليك ابن خير القريتين طوى الفلا % % برحلي غريري تفرى خدامه % 22(@)(@@) % ولست أشيم البرق يتبعه الحيا % % إذا من بالسقيا علي غمامه % 23(@)(@@) % وألوي عنان الطرف عنه إذا ذعا % % سواي إلى الري الذليل أوامه % 24(@)(@@) % فأمطيتني جون الإهاب مطهما % يلاث على السيد الأزل حزامه % 25(@)(@@) % ويمرح في ثني العذار كأنه % تسربل ليلا والثريا لجامه % PageV01P379 البحر : بسيط تام 1(@)(@@) % حتام تشكو الصدى بيض مباتير % ولا تخوض دما جرد محاضير % 2(@)(@@) % وطالب العز لا يلقي مراسيه % بحيث يمتهن الشم المغاوير % 3(@)(@@) % ولست أدري أنال الدهر من جدتي % % جهالة بي ، أم جن المقادير % 4(@)(@@) % ولي قصائد تحكي روضة أنفا % تبسمت في حواشيها الأزاهير % 5(@)(@@) % والشعر ليس بمجد ، فالملوك لهم % أيد صخور وأعراض قوارير % PageV01P380 البحر : طويل 1(@)(@@) % أما وتجني طيفها المتأوب % ليالي روحنا المطايا بغرب % 2(@)(@@) % لقد زارني والعتب يقصر خطوه % وأحبب به من زائر متعتب % 3(@)(@@) % يواصلنا والليل غض شبابه % ويهجر إن شابت ذوائب غيهب % 4(@)(@@) % فما لي وللطيف المعاود موهنا % سرى كاختطاف البارق المتصوب % 5(@)(@@) % وقد كنت راجعت السلو عن الصبا % % وأضمرت توديع الغزال المربب % 6(@)(@@) % ورحت غبي السن عن كل مضحك % ومنكسر الألحاظ عن كل ملعب % 7(@)(@@) % على حين نادى بالظعائن أهلها % % ولم يحذروا العقبى لما في المغيب % 8(@)(@@) % وأودى قوام الدين حتى تولعت % صروف الليالي فرنقن مشربي % % 9(@)(@@) % سأذكره للركب كلت مطيهم % وللسفر إذ أعياهم وجه مطلب % 10(@)(@@) % وللآمل الصادي متى يبد منهل % ولم يك من أحواضه يتنكب % PageV01P381 11(@)(@@) % ولولا نظام الدين كانت لحومنا % % وإن كرمت نهبى نسور وأذؤب % 12(@)(@@) % وما زال من أبناء إسحاق كوكب % يلوح إذا ولى الزمان بكوكب % 13(@)(@@) % ولما أتاني أنه قمع العدا % % هتفت بآمال روازح لغب % 14(@)(@@) % وقلت لصحبي 
ms116	 بادروا الصبح نبتكر % على بابلي في الزجاجة أصهب % 15(@)(@@) % له مشرق في أوجه الشرب بعدما % % تصوب ما بين اللها نحو مغرب % 16(@)(@@) % كأن الحباب المستطير إذا طفا % % لآلىء إلا أنها لم تثقب % 17(@)(@@) % ومن أريحياتي ، وللراح نشوة % متى تدر الكأس الروية أطرب % 18(@)(@@) % فظلنا بيوم قصر اللهو طوله % نشاوى ، ولم نحفل عتاب المؤنب % 19(@)(@@) % تنم إلينا بالسرور مزاهر % يغازلن أطراف البنان المخضب % 20(@)(@@) % إذا كنت جارا للحسين فلا تبل % رضى المتجني فاترك الدهر يغضب % PageV01P382 21(@)(@@) % أخو عزمة تغني إذا الأمر أظلمت % جوانبه ، عن باتر الحد مقضب % 22(@)(@@) % ويسمو إلى أعدائه من كماته % وآرائه في مقنب بعد مقنب % 23(@)(@@) % ويرميهم ، واليوم دام عجاجه % بجرد يبارين الأعنة شزب % 24(@)(@@) % ويكنفه نصر يناجي لواءه % إذا ما هفا كالطائر المتقلب % 25(@)(@@) % فلله ميمون النقيبة ، إن غزا % % أراح إليه ماله كل مغرب % 26(@)(@@) % يقول لمرتاد السماحة مرحبا % إذا النكس لوى ماضغيه بمرحب % 27(@)(@@) % ويلقي لديه المعتفون رحالهم % بأفيح لا يعتاده المحل مخضب % 28(@)(@@) % حلفت بأيدي الراقصات إلى منى % % يبارين وفد الريح في كل سبسب % 29(@)(@@) % عليها غلام لاحه السير والسرى % % به قلق من عزمه المتلهب % 30(@)(@@) % وهز الفيافي عوده إذ تشبثت % يد الدهر منه باللحاء المشذب % PageV01P383 31(@)(@@) % فلم يدرع والشمس كاد أوارها % % يذيب الحصى ، ظل الخباء المطنب % 32(@)(@@) % فما زال يطويها ويطوينه الفلا % % إلى أن أنخناهن عند المحصب % 33(@)(@@) % لأوهيت أركان العدو بكاهل % تحمله عبء المعالي ، ومنكب % 34(@)(@@) % ومن يتصدى للوزارة جاهدا % ويمسح عطف المطلب المتعصب % 35(@)(@@) % فقد نزعت ولهى إليك ، وخيمت % % بخير فتى ، واستوطنت خير منصب % 36(@)(@@) % وشتان ما بين الوزيرين : وادع % أتته العلا طوعا ، وآخر متعب % 37(@)(@@) % فحسب أبيك مفخرا أنك ابنه % كما أنه ناهيك في الفخر من أب % 38(@)(@@) % بقيت ولا زالت تروح وتغتدي % % إليك المساعي غضة المتنسب % 39(@)(@@) % ولا برح الحساد يكسو وليدهم % لواعج من هم غدائر أشيب % PageV01P384 البحر : طويل 1(@)(@@) % خليلي بئس الرأي ما تريان % أما لكما بالنائبات يدان ؟ % 2(@)(@@) % تريدان مني أن أزير مدائحي % % هجينا فما قومي إذا بهجان 
ms117	 % 3(@)(@@) % ومن يكتسب مالا بعرض يذيله % فلا ذاق طعم العيش غير مهان % 4(@)(@@) % وإن شئتما أن تعلما ما أجنه % فليس بمأمون عليه لساني % % 5(@)(@@) % وعن كثب يفضي بسري إليكما % % غرار حسام أو شباة سنان % 6(@)(@@) % وإخوان صدق كنت أرعي مغيبهم % وأدفع عنهم والرماح دوان % 7(@)(@@) % فلما استفادوا ثروة بطروا بها % % وضاع خماص الحي بين بطان % 8(@)(@@) % أرى أيديا نالت غنى بعد خلة % لألأم قوم في أخس زمان % 9(@)(@@) % فضنت بما تحويه ، شل بنانها % % وإن رمت جدواها فشل بناني % % 10(@)(@@) % ومن حدثان الدهر أن أستميحهم % وتحت نجادي مدره الحدثان % PageV01P385 11(@)(@@) % ولكنني في معشر لا تسوؤهم % أحاديث تقلولي لها الأذنان % 12(@)(@@) % إذا عاهدوا أو عاقدوا فعهودهم % عهود قيون في وفاء قيان % 13(@)(@@) % وجارتهم في الأمن غير مصونة % وجارهم في الروع غير معان % 14(@)(@@) % بكت أم عمر وإذ أنيخت ركائبي % % بحيث الهضاب الحمر من همدان % 15(@)(@@) % فأذرت دموعا كالجمان تفيضها % % على خد مقلاق الوشاح رزان % 16(@)(@@) % وما علمت أن السيوف تشبثت % بأذيال شمطاء القرون عوان % 17(@)(@@) % فأبكت رجالا كالأسود ، ولم تبل % بكاء نساء كالظباء غوان % 18(@)(@@) % وقمت فقرطت الأغر عنانه % وفي اليد ماضي الشفرتين يمان % 19(@)(@@) % ولست إذا ما الدهر أحدث نكبة % خفيا بمستن الخطوب مكاني % % 20(@)(@@) % لئن بسطت باعي من الله نعمة % ولم أحي يومي نائل وطعان % PageV01P386 21(@)(@@) % فما أسندتني كف أروع ماجد % إلى نحر روعاء الفؤاد حصان % PageV01P387 البحر : كامل تام 1(@)(@@) % هو طيفها وطروقه تعليل % فمتى يفي لك ، والوفاء قليل % 2(@)(@@) % وكأن زورنه تألق بارق % هتفت به النكباء وهي بليل % 3(@)(@@) % عرضت لوامعه فطرب مجدب % ومضى ، فلا عدة ولا تنويل % 4(@)(@@) % أأميم إن أشبهته في خلفه % فالخلف يقبح وهو منك جميل % 5(@)(@@) % وله ابتسامك عن ثغور لم يكن % يشفى بهن من المحب غليل % 6(@)(@@) % والقد من مرح الصبا متأود % والطرف من ترف النعيم عليل % 7(@)(@@) % والخصر خف فلا يزال وشاحه % قلقا ، وما وارى الإزار ثقيل % 8(@)(@@) % غضي من الإدلال فهو على النوى % % ما دام يجلبه الملال ، دليل % 9(@)(@@) % ودعي الوشاة فكل 
ms118	 مامحلوا به % عند اللقاء يزيله التأويل % 10(@)(@@) % ووراء وصلكم القصير زمانه % هجر - كما شاء الغيور - طويل % PageV01P388 11(@)(@@) % لو دام قبلكم اجتماع لم يذق % ألم افتراق مالك وعقيل % 12(@)(@@) % ولئن صددت فبيننا مجهولة % للركب فيها رنة وعويل % 13(@)(@@) % تسري بعقوتها الرياح لواغبا % ولهن من حذر الضلال أليل % 14(@)(@@) % أنا والمطى وجنح ليل مظلم % ولدي إن نزل الهوان رحيل % 15(@)(@@) % فالهجر أروح والأماني ضلة % إن حال عهد أو أراب خليل % 16(@)(@@) % وتطرف القرناء يقبح بالفتى % % لكن دواء الغادر التبديل % 17(@)(@@) % همم تنقل بي ، فإن قلقت بها % % دار ، نضا عزماتي التحويل % 18(@)(@@) % وأبى لجيدي أن يطوق منة % شرف بناه الأنبياء أثيل % 19(@)(@@) % نطق الزبور بفضله المشهور وال % % قرآن والتوراة والإنجيل % 20(@)(@@) % من معشر لهم السماحة شيمة % والمجد ترب والنجوم قبيل % PageV01P389 21(@)(@@) % لهم المعلى والرقيب من العلا % % وبهم أفاض قداحهن مجيل % 22(@)(@@) % فرحلت والنفس الأبية حرة % والعزم ماض والحسام صقيل % 23(@)(@@) % هل يعجزني والبقاع فسيحة % في هذه الأرض الفضاء مقيل ؟ % 24(@)(@@) % بقصائد قست الليالي ، واكتست % منها ، فرقت بكرة وأصيل % 25(@)(@@) % إن شارفت أرضا تطلع نحوها % % أخرى ، كأن مقامها تحليل % 26(@)(@@) % خضلت بدجلة والفرات ذيولها % % فاهتز من طرب إليها النيل % 27(@)(@@) % وأزارها ابن الدارمي أبا الندى ال % % إكرام والتعظيم والتبجيل % 28(@)(@@) % خضبت مناسمها إلى عرصاته % خوص نماها شدقم وجديل % 29(@)(@@) % ولكم تسافهت البرون لمطلب % وتناجت الركبان أين تميل % 30(@)(@@) % فأقمن حيث المجد أتلع ، والندى % % جم وظل المكرمات ظليل % PageV01P390 31(@)(@@) % ورعين حالية الربيع ودونها % % جار بما تعد الظنون كفيل % 32(@)(@@) % ومسدد العزمات لا يغتالها % % خطب كما اعتكر الظلام ، جليل % 33(@)(@@) % ويصيب أعقاب الأمور إذا ارتأى % % عفوا ، وآراء الرجال تفيل % 34(@)(@@) % وإذا الوغى حدر الكماة لثامه % ووشى بسر المشرفي صليل % 35(@)(@@) % ورماحه توجن من هام العدا % % ولخيله بدمائهم تنعيل % 36(@)(@@) % نشرت رفارف درعه عن ضيغم % يحمي الحقيقة والأسنة غيل % 37(@)(@@) % هيهات أن يلد الزمان نظيره % إن الزمان بمثله لبخيل % 38(@)(@@) % فالضيف إلا عن نداه مدفع % والجار إلا في ذراه ذليل % 39(@)(@@) % نفضت إلى أفيائه لمم الربا % % أيدي 
ms119	 الركائب ، سيرهن ذميل % 40(@)(@@) % شرقت بنغمة شاعر أو زائر % ودعا هدير فاستجاب صهيل % PageV01P391 41(@)(@@) % مهلا فما دنت النجوم لطامع % في نيلهن ، وهل إليه سبيل % 42(@)(@@) % وسعيت للعلياء حتى أيقنت % أن الأوائل سعيهم تضليل % 43(@)(@@) % واها لعصرك وهو يقطر نضرة % ويميس تحت ظلاله التأميل % 44(@)(@@) % فكأنه ورد الخدود إذا اكتست % خجلا وكاد يذيبها التقبيل % 45(@)(@@) % لولا تأخره ، وقد أوقرته % كرما ، لنم بفضله التنزيل % 46(@)(@@) % أين المدى ولقد بلغت من العلا % % رتبا ترد الطرف وهو كليل % 47(@)(@@) % وتقابلت غاياتها فتماثلت % حتى تعذر بينها التفضيل % PageV01P392 البحر : طويل 1(@)(@@) % بدت وجناح الفجر لم يتنفض % لوامع برق يشتكي الأين مومض % 2(@)(@@) % يلوح ابتسام العامرية ، والجوى % % يبرح بي ، والنجم لم يتعرض % 3(@)(@@) % فقلت لأدنى صاحبي وقد طوى % % على النوم جفني راقد الليل مغمض % 4(@)(@@) % تصح وتلحاني فذرني وحبها % % فإن مصحي في الصبابة ممرضي % % 5(@)(@@) % ومن يتعوض عن هواه فإنني % % وجدك عن ظمياء لم أتعوض % 6(@)(@@) % أحن إليها ، والنوى مطمئنة % بنا وبيوت الحي لم تتقوض % 7(@)(@@) % فلا الصبر موجود ولا القلب ذاهل % ولا الشمل مجموع ولا الشوق منقض % PageV01P393 البحر : رجز تام 1(@)(@@) % إيها فكم تهصر أغصان الضال % والعيس يمرحن بمستن الآل % 2(@)(@@) % من كل فتلاء الذراع مرقال % يفحصن أدحي الظليم المجفال % 3(@)(@@) % ميل الهوادي ناحلات الأوصال % كأنها مزمومة بالأصلال % 4(@)(@@) % فهن أمثال الحنايا الأعطال % بها اهتزازات الوشيج العسال % 5(@)(@@) % للحدو بالأهزاج قبل الأرمال % قد وشجت بالغدوات الآصال % 6(@)(@@) % بمسرح العفر ومرعى الأوعال % ارم بها والليل ضافي الأذيال % 7(@)(@@) % من لهوات الواد مغنى محلال % ترشف درات الغمام الهطال % 8(@)(@@) % حيث ترود السروات الازوال % ويملأ السمع زئير الرئبال % 9(@)(@@) % ويسحب الفارس ذيل القسطال % صامت حواليه بنات العقال % 10(@)(@@) % من كل وضاح المحيا صهال % بضيعه خاظ وهاديه عال % PageV01P394 11(@)(@@) % صافي الأديم مستنير السربال % كأنما رش عليه الجريال % 12(@)(@@) % يدير إما هز عطفى مختال % مكحولتي ظبي يراعي أطفال % 13(@)(@@) % أغدو عليه في فتو أقيال % كالإبل الجرب هناهن الطال % 14(@)(@@) % والبيض تمشي راجحات الأكفال % من كل بلهاء التثني مكسال % % 15(@)(@@) % تبدي لأطراف 
ms120	 القنا عن خلخال % والسمهريات بأيدي أبطال % 16(@)(@@) % تميس في أطرافهن الآجال % يا حبذا رعي المطي الأهمال % 17(@)(@@) % إذا تجاذبن فروع الأهدال % % تكرع من رشح الحيا في أوشال % 18(@)(@@) % عوجا إلى رجع الحداء الجلجال % لا عز إلا لرويعي أشوال % 19(@)(@@) % لم يتطرق عرصات البخال % يخطر في أثناء برد أسمال % 20(@)(@@) % ولا يناجي خطرات الآمال % % فإن أطواق الأيادي أغلال % % PageV01P395 البحر : طويل 1(@)(@@) % وذي سفه ألقيت فضل خطامه % إليه وكم أبقى على جهله علمي % % 2(@)(@@) % فلما أبى إلا طماحا إلى الخنى % % تجافيت عنه والتفت إلى حلمي % % PageV01P396 البحر : بسيط تام 1(@)(@@) % ياحادي الشدنيات المطاريب % أناقل أنت أخبار الأعاريب ؟ % 2(@)(@@) % ترفعت بك أو بي همة تركت % % هذا الرديني مهزوز الأنابيب % 3(@)(@@) % فعج على خيم لفت ولائدها % % أطنابهن بأعراف السراحيب % 4(@)(@@) % واها لليلتنا بالجزع إذ طرقت % عفر الأجارع من بطحاء ملحوب % 5(@)(@@) % والوائليون يسري في عيونهم % كرى هو الغنج في لحظ الرعابيب % 6(@)(@@) % ولاح في الكلة الصفراء لي رشأ % يرمي دجى الليل عن أجفان مرعوب % 7(@)(@@) % طرقته والنجوم الزهر حائرة % على مطهمة جرداء يعبوب % 8(@)(@@) % وقد دنت منه حتى أودعت أرجا % أحناء سرجي أفاويه من الطيب % 9(@)(@@) % وكاد يفتل إكراما لزائره % عذارها من أثيث النبت غربيب % 10(@)(@@) % لكنه ستر البدر المنير به % حتى أجار محبا صدغ محبوب % PageV01P397 11(@)(@@) % وقد أخذنا بأطراف الحديث فكم % دمع على ملعب الأطواق مسكوب % 12(@)(@@) % واستعجلت قبل مرت على شبم % صافي القرارة بالصهباء مقطوب % 13(@)(@@) % إني لأدرع الليل البهيم ولا % % أليح من قدر يأتيك مجلوب % 14(@)(@@) % وفي من شيم الضرغام جرأته % إذا أرابتك أخلاق من الذيب % 15(@)(@@) % أواصل الخشف والغيران مرتقب % لا خير في الوصل عندي غير مرقوب % 16(@)(@@) % ولا أحالف إلا كل مشتمل % على حسام من الأعداء مخضوب % 17(@)(@@) % يستنزل الموت في إقدامه طربا % إلى مدى يدع الشبان كالشيب % 18(@)(@@) % ويستجيش إذا ما خطة عرضت % % رأيا يشيع بأسرار التجاريب % 19(@)(@@) % من معشر يحمد العافي لقاحهم % إذا امتدرت أفاويق الأحاليب % 20(@)(@@) % أعداؤهم ومطاياهم على وجل % فهم أعادي رؤوس أو عراقيب % PageV01P398 21(@)(@@) % مد 