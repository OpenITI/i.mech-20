ms301	 به ‌کار آید و هم زر(@)(@@) 17 ور کس به زر و سیم دل از من نستاند %~% بشتابم و سوداکنمش با دل دیگر(@)(@@) 18 نی‌نی غلطم کس دل دیوانه نخواهد %~% دیوانه بود هرکه به دیوانه‌کند سر PageV1P183(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 به هر بهارکل از زیرکل برآرد سر %~% گلی برفت‌ که ناید به صد بهار دگر(@)(@@) 2 گلی برفت‌ کز امروز تا به دامن حشر %~% گلاب اوست‌که جاری بود ز دیده تر(@)(@@) 3 گلی برفت ‌که با آنکه غنچه بود هنوز %~% دو غنچه داشت به هریک هزار تنگ‌ شکر(@)(@@) 4 گلی ‌برفت ‌که ‌از مشک‌ چین دو سنبل داشت %~% نهان به زیر دو سنبل دو لاله احمر(@)(@@) 5 هلا که بود و کجا آمد و چه‌ گفت و چه شد %~% که هرچه بینم ازآن هر چهار نیست خبر(@)(@@) 6 چه‌شمع‌بودکه‌روش‌نگشته گشت خموش %~% چه شعله بود که ناجسته‌ گشت خاکستر(@)(@@) 7 چرا چو نجم سحر نادمیده‌کرد غروب %~% چرا چو صبح دوم نارسیده ‌کرد سفر(@)(@@) 8 برفت از صدف خاک‌گوهری بیرون %~% که خلق‌ را صدف دیده‌ گشت پرگوهر(@)(@@) 9 فتاد از فلک مجد اختری به زمین %~% که جان خلق از آن اخترست پر اخگر(@)(@@) 10 شبیه شمس و قمر بود در شمایل حسن %~% چو او بمرد تو گفتی بمرد شمس و قمر(@)(@@) 11 مدار عقل و هنر بود در فصاحت و نطق %~% چو او بمرد تو گفتی برفت عقل و هنر(@)(@@) 12 رخش کبود شد از سیلی اجل عجبست %~% که‌ گل بنفشه شود یا که لاله نیلوفر(@)(@@) 13 به‌وقت زندگی ا ز حسن و وقت مرگ از غم %~% به هر دو حال جهان را نمود زیر و زبر(@)(@@) 14 گمان برم که جهان را خدا عقوبت‌ کرد %~% چراکه هجر وی از هر عقوبتیست بتر(@)(@@) 15 گشاده بود رخش بر جهان دری ز بهشت %~% نهفت چهره و شد بسته بر جهان آن در(@)(@@) 16 به باغ خلد خرامید و از شمایل خویش %~% به باغ خلد 
ms302	 بیفزود باغ خلد دگر(@)(@@) 17 مگو که زیور حسنش فزون شود ز بهشت %~% که او ز چهره فزاید بهشت را زیور(@)(@@) 18 چه بود این خبر این قاصد ازکجا آمد %~% که‌کاش نامده بود و نداده بود خبر(@)(@@) 19 به حق‌ پناه برم ‌کاین خبر نباشد راست %~% به حیرتم‌که چگویم چسان ‌کنم باور(@)(@@) 20 گل شکفته به یکدم چگونه ریخت ز شاخ %~% مه دو هفته به یک ره چگونه شد ز نظر(@)(@@) 21 بهار تازه به آنی چگونه‌گشت خزان %~% درخت میوه به بادی چگونه ریخت ثمر(@)(@@) 22 شنیده‌ایدکه نشکفته بفسرد لاله %~% شنیده‌اید که نارسته پژمرد عبهر(@)(@@) 23 امیرزاده نه ما جمله چاکران توییم %~% ترا که ‌گفت‌ که بی‌چاکران روی سفر(@)(@@) 24 تراکه نفع سخایت به مور و مار رسید %~% به مور و مار سپردیم خاکمان بر سر(@)(@@) 25 تراکه از کرمت شاد بود دشمن و دوست %~% زکف چو دشمن دادیم دوستی بنگر(@)(@@) 26 ز رفتن تو اگر رفتگان خوشند چسود %~% که ماندگان ترا ماند داغها به جگر(@)(@@) 27 پدر هنوز درین ذوق بود کز سر شوق %~% هزار تحفه فرستد ترا ازین ‌کشور(@)(@@) 28 برای بازوی تو حرز سازد از یاقوت %~% ز بهر فرق تو افسر فرستد ازگوهر(@)(@@) 29 تراکه‌گفت‌که از چوب نخل سازی حرز %~% ترا که‌ گفت‌که از خاک ره‌کنی افسر(@)(@@) 30 پدر هنوز علی‌رغم دشمنان می‌خواست %~% که بسترت ‌کند از سیم و بالشت از زر(@)(@@) 31 ترا که‌ گفت‌ که از لوح قبر کن بالین %~% ترا که ‌گفت ‌که از خاک ‌گور کن بستر(@)(@@) 32 پدر هنوزت طوق‌ کمر نساخته بود %~% که دست مرگت شد طوق و طاق گور کمر(@)(@@) 33 به جای آنکه به تخت جلال بنشینی %~% دریغ بود که بر تخته افتدت پیکر(@)(@@) 34 به جای آنکه‌ کنندت به‌بر لباس حریر %~% دریغ بود ز بردت‌کفن‌کنند به‌بر(@)(@@) 35 به جای آنکه نهی سر فراز بالش زر %~% دریغ بود به خشت لحد گذاری سر(@)(@@) 36 دریغ بود که کافور مردگان 
ms303	 پاشند %~% به‌گیسویی‌که ز خود داشت نکهت عنبر(@)(@@) 37 تو آن کبوتر عرشی‌ کنون ز غصه منال %~% گر از قفس به سوی آشیان‌گشودی بر(@)(@@) 38 ترا خدای دهد جای در کنار نبی %~% چه این نبی پدرت باشد و چه پیغمبر(@)(@@) 39 تراست جای به هرحال در کنار رسول %~% مشو غمین‌ که جدا ماندی از کنار پدر(@)(@@) 40 بزرگوار امیرا به بندگان خدای %~% بسی نخواسته دادی هزار گنج‌ گهر(@)(@@) 41 اگر خدای تو یک گوهر از تو خواست مرنج %~% که ترسم از تو برنجد حکیم دانشور(@)(@@) 42 که‌ گو‌هری چو نبخشی ‌که خواست از تو خدای %~% چرا نخواسته بخشی به بغده بی‌حد و مر(@)(@@) 43 و دیگر آنکه تو دانی خدای با هرکس %~% هزار بار بود مهربانتر از مادر(@)(@@) 44 هزار مادر اگر بشمریم تا حوا %~% تمام صادر از اوییم و او بود مصدر(@)(@@) 45 ولیک حکم قضا و قدر بدان رفتست %~% که در زمانه نبینیم غیر رنج و خطر(@)(@@) 46 نهاده راحت ما را به رنج و ما غافل %~% سپرده عشرت ما را به مرگ و ما ابتر(@)(@@) 47 گهی به طعنه‌که داد آفرین چه راند جور %~% ‌گهی به شکوه‌ که خیرآفرین چه جوید شر(@)(@@) 48 اگرچه حق ز پی امتحان دانش ما %~% دو صد مثال نهادست در نهاد بشر(@)(@@) 49 مگر نه داروی تلخ حکیم ‌گاه علاج %~% به ‌کام ما دهد از روی طبع طعم شکر(@)(@@) 50 مگر نه این رگ شریان ‌که رشته تن ماست %~% دهیم مزد به فصاد تا زند نشتر(@)(@@) 51 ز باده تلختری نیست‌کش خوریم به ذوق %~% که تلخیش به طبیعت حلاوت آرد بر(@)(@@) 52 ز بانگ زیر و بم چنگ‌ کی به رقص آییم %~% اگر بر آن نزند زخمه مرد خنیاگر(@)(@@) 53 ولی چو عشرت عقبی نهان ز دیده ماست %~% خواص مرگ ندانیم وزان‌کنیم حذر(@)(@@) 54 به عیش فانی دنیا خوشیم و غافل ازین %~% که سود او همه سوم‌ست و نفع او همه ضر(@)(@@) 55 
ms304	 بر اسب چوبین کودک چه آگهی دارد %~% که چیست تخت سلبمان و رخش رستم زر(@)(@@) 56 رئیس ده چو به دهقان همی دهد فرمان %~% همی چه داند خاقان کدام یا قیصر(@)(@@) 57 ز آب شور بیابان عرب به وجد آید %~% چه آگهیش‌ که تسنیم چیست یا کوثر(@)(@@) 58 چو عنکبوت مگس‌گیرد آنچنان داند %~% که اژدهای دمان را کشد به‌کام اندر(@)(@@) 59 چوگربه حمله به موشان برد چنان داند %~% که قلب لشکر دارا دریده اسکندر(@)(@@) 60 به کرم سیب کس ار داستان پیل کند %~% به خویش پیچد و افسانه داندش یکسر(@)(@@) 61 مگس بپرد و در چشم نایدش سیمر %~% فرس بپوید و در وهم نایدش صرصر(@)(@@) 62 گمان برد حبشی در حبش‌که چهره او %~% همی به فر و بها باج‌گیرد از قیصر(@)(@@) 63 ولی اگر به سیاحت رود به خطه روم %~% ز شرم همچو زنان چادر افکند بر سر(@)(@@) 64 ز شوق این سخن آن صفدران خبر دارند %~% که پیش تیر بلا جان و دل‌کنند سپر(@)(@@) 65 بلا به لفظ عرب امتحان بود یعنی %~% که بنده را به بلا امتحان‌کند داور(@)(@@) 66 ولا بزرگ بود چون بلا بزرگ بود %~% نشان فراخور شأن‌ست و جامه درخور بر(@)(@@) 67 هزار سال فزونست تا حسین علی %~% شهیدگشته و نامش هنوز بر منبر(@)(@@) 68 خدای در همه حالی منزه ست از خلق %~% ولی ز غایت لطفست خلق را رهبر(@)(@@) 69 برای ماست‌گر ایمان وکفر بخشد سود %~% خدای را چه‌ که ما مومنیم یا کافر(@)(@@) 70 اگر بهشت و سقر فرق دارد از پی ماست %~% خدای را چه تفاوت ‌کند بهشت و سقر(@)(@@) 71 ستاره تابد و پیشش یکیست پاک و پلید %~% سحاب بارد و نزدش یکیست خار و شجر(@)(@@) 72 اگر مراد تو یزدان بود مراد مخواه %~% رضای دوست طلب وز رضای خود بگذر(@)(@@) 73 ز من امیرا یک نکته دیگر بنیوش %~% عبث مجوی ‌کت از دست رفت یک گوهر(@)(@@) 74 تو مال خویش سپاری 
ms305	 به هرکه چاکر تست %~% بدین بهانه‌که‌گویی امین بود چاکر(@)(@@) 75 چنان خدای ‌که خود چاکر آفرین دانیش %~% به حفظ مال تو از چاکری بود کمتر(@)(@@) 76 تو بشنو اندکی امروز پند قاآنی %~% که‌ کارت آید فردا به عرصه محشر PageV1P184(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 پیک دلارام دی درآمدم از در %~% نامه‌یی آورد سر به مهر ز دلبر(@)(@@) 2 جستم و بگرفتم وگشودم و دیدم %~% یار نوشتست ‌کای ادیب سخنور(@)(@@) 3 خیز و مبوی ار به دست داری سنبل %~% خیز و منوش ار به‌کام داری ساغر(@)(@@) 4 آب بزن حجره را گلاب بیفشان %~% برگ بنه خانه را شراب بیاور(@)(@@) 5 یار بخوان می بخواه بزم بیارا %~% نقل بهل گل بریز فرش بگستر(@)(@@) 6 چون سر زلفم بسای مشک به هاون %~% چون خم جعدم بسوز عود به مجمر(@)(@@) 7 عیش موفا کن از شراب مصفا %~% بزم معطر کن از گلاب مقطر(@)(@@) 8 ساز سماع مرا بساز ز هر باب %~% برک نشاط مرا بخواه ز هر در(@)(@@) 9 نقل ‌و می شمع ‌و شهد و شکر و شاهد %~% رود و نی و تار و عود و بربط و مزهر(@)(@@) 10 هیچ خبر نیستت مگر که دل من %~% زین سفر دیر بازگشته مکدر(@)(@@) 11 هشت مه افزونترست ‌کافتان خیزان %~% گرد صفت می‌شتابم از پس لشکر(@)(@@) 12 زین سر از یال اسب دارم بالین %~% زیر تن از زین رخش دارم بستر(@)(@@) 13 دشت مرا مجلسست و هامون محفل %~% گرد مرا خیمه است و گردون چادر(@)(@@) 14 خیمه من چرخ هست و حجره بیابان %~% مسند من زین و خوابگاه من اشقر(@)(@@) 15 چرم تن من مراست ‌گویی جوشن %~% مغز سر من مراست ‌گویی مغفر(@)(@@) 16 گویی با جوشن آفریدم ایزد %~% گویی با مغفر آوریدم داور(@)(@@) 17 تختم یکران شدس و چترم خورشید %~% خودم زینت شدست و درعم زیور(@)(@@) 18 غالیه‌ام‌گرد راه و شانه سرانگشت %~% ماشطه‌ام آفتاب و آینه خنجر(@)(@@) 19 گرد رهست ار به چشم دارم سرمه %~% خاک 
ms306	 رهست ار به زلف پاشم عنبر(@)(@@) 20 شیب و فراز جهان بریدم و دیدم %~% معظم معموره جهان چو سکندر(@)(@@) 21 گه به مغاکی شدم بر آن روی ماهی %~% گه به ستیغی شدم بدان سوی اختر(@)(@@) 22 گه به نشیبی ز حد هستی بیرون %~% گه به فرازی ز آفرینش برتر(@)(@@) 23 رخت سپردم‌ گهی به مخزن قارون %~% تخت نهادم ‌گهی به پشت دو پیکر(@)(@@) 24 گاه ز سرما لبم‌ کفیده چو پسته %~% گاه زگرما تنم تفیده چواخگر(@)(@@) 25 بسکه ببوسید نعل موزه عزمم %~% موم‌صفت نرم شد رکاب تکاور(@)(@@) 26 خودم فرسوده‌گشت و درعم سوده %~% زخشم آسیمه‌‌گشت و شخصم مضطر(@)(@@) 27 بارم درگل نشست و خارم در دل %~% تابم از رخ پرید و خوابم از سر(@)(@@) 28 رخشم نالان‌ که بس کن آخر بنشین %~% از در رحمت یکی به حالم بنگر(@)(@@) 29 مرغ نیم تا یکی پرم ز بر و زیر %~% برق نیم تا به‌ کی جهم به‌ که و در(@)(@@) 30 چرخ نیم تا به ‌کی خرامم ایدون %~% باد نیم تا به‌ کی شتابم ایدر(@)(@@) 31 چند دوم چون نیم نبیره‌ گردون %~% چند روم چون نیم سلاله صرصر(@)(@@) 32 من نه خیالم چنین چه پویم ایدون %~% من نه‌گمانم چنین چه رانم ایدر(@)(@@) 33 رانت مگر آهنست و گامت فولاد %~% جانت مگر خاره است و جسمت مرمر(@)(@@) 34 چند دهم شرح هیچ دیده مبیناد %~% آنچه بدیدم ز رنج و انده بی‌مر(@)(@@) 35 جسمم بیتاب‌ گشته چهرم بی‌ آب %~% چشمم بی‌خواب گ‌‌شته جانم بی‌خور(@)(@@) 36 گر تو ببینی مرا یقین نشناسی %~% ورت بگویم منم نداری باور(@)(@@) 37 جز که به‌ گرمابه تن بشویم و رخسار %~% گرد برافشانم از دو زلف معنبر(@)(@@) 38 غالیه سایم به زلف و غازه به ‌رخسار %~% رنگ‌کلف بسترم ز ماه منور(@)(@@) 39 هی بزنم شانه برد و بیچان سنبل %~% هی بکشم سرمه در دو مشکین عبهر(@)(@@) 40 تا زند این راه جان به شوخی غمزه %~% تا شود آن دام 
ms307	 دل به حلقه چنبر(@)(@@) 41 باده خورم یک دو ساتکین سپس هم %~% تا دو رخم بشکفد چو لاله احمر(@)(@@) 42 وانگه بر عادت قدیم‌ که دانی %~% مدحت فخرالانام خوانم از بر(@)(@@) 43 اصل طرب فصل جود میر معظم %~% بحرکرم بدر ملک صدر مظفر(@)(@@) 44 فارس دولت نظام ملک شهنشاه %~% حارس ملت قوام دین پیمبر(@)(@@) 45 حاجی آقاسی آنکه خاک درش را %~% میران آیین‌ کنند و شاهان افسر(@)(@@) 46 از کرم اوست هرچه رزق به ‌گیتی %~% وز قلم اوست هرچه عیش به‌ کشور(@)(@@) 47 روزی او می‌خورند عارف و عامی %~% نعمت‌ او می‌برند مومن وکافر(@)(@@) 48 همت او چون ابد ندارد پایان %~% فکرت اور چون فلک ندارد معبر(@)(@@) 49 زایر درگاه او به‌ گام نخستین %~% پای‌ گذارد به فرق چرخ مدور(@)(@@) 50 ای نفست نفس را به یزدان داعی %~% وی سخنت عقل را به یزدان رهبر(@)(@@) 51 راز بیان تو خواست تا بنماید %~% ایزد از آن آفرید چشمه کوثر(@)(@@) 52 سر جلال تو خواست تا بگشاید %~% باری‌ از آن خلق ‌کرد گنبد اخضر(@)(@@) 53 فیض نیارد ز هم گسست وگرنه %~% با تو تمامست آفرینش‌ داور(@)(@@) 54 حبر سر خامه‌ات چکیده به عمان %~% وررنه ز عمان نزاید این همه گوهر(@)(@@) 55 منبت کلک تو بود هند وگرنه %~% این همه از هند می ‌نخیزد شکر(@)(@@) 56 آیت عزمت به ‌کشتی ار بنگارند %~% باز ناستد به صد هزاران لنگر(@)(@@) 57 خاطر خصمت به آذر ار بنمایند %~% می‌برود گرمی از طبیعت آذر(@)(@@) 58 حکمت ‌کونین در وجود تو مدغم %~% دولت جاوید در رضای تو مضمر(@)(@@) 59 مور شود با اعانت تو سلیمان %~% باز شود با اهانت تو کبوتر(@)(@@) 60 گویا زاید ز حرص مدح تو کودک %~% بینا روید ز شوق روی تو عبهر(@)(@@) 61 خشم تو است ار شود هلاک مجسم %~% لفظ تو است ار شود حیات مصور(@)(@@) 62 برگ درختان بود به مدح تو گویا %~% ریگ بیابان شود ز وصف تو جانور(@)(@@) 63 رقص 
