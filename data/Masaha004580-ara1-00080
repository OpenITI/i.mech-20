ms61	 عن وصفه ويكذبك(@)(@)(@@)(@@)(@@) ||| 84(@)(@)(@@) @HAD09 إياك وطول الأمل فكم من مغرور افتتن بطول(@)(@)PageV01P171(@)(@)(@@) @HAD015 أمله وأفسد عمله وقطع أجله فلا أمله أدرك ولا ما فاته استدرك(@)(@)(@@)(@@)(@@) ||| 85(@)(@)(@@) @HAD017 إياك ومساماة الله سبحانه فى عظمته فإن الله تعالى يذل كل جبار ويهين كل مختال(@)(@)(@@)(@@)(@@) ||| 86(@)(@)(@@) @HAD014 إياك والغفلة والإغترار بالمهلة فإن الغفلة تفسد الأعمال والآجال تقطع الآمال(@)(@)(@@)(@@)(@@) ||| 87(@)(@)(@@) @HAD012 إياك والقحة فإنها تحدوك على ركوب القبائح والتهجم على السيئات(@)(@)(@@)(@@)(@@) ||| 88(@)(@)(@@) @HAD013 إياك والبغي فإن الباغي يعجل الله له النقمة ويحل به المثلات(@)(@)(@@)(@@)(@@) ||| 89(@)(@)(@@) @HAD017 إياك وفضول الكلام فإنه يظهر من عيوبك ما بطن ويحرك عليك من أعدائك ما سكن(@)(@)(@@)(@@)(@@) ||| 90(@)(@)(@@) @HAD017 إياك وكثرة الوله بالنساء والإغترار بلذات الدنيا فإن الوله بالنساء ممتحن والغري باللذات ممتهن(@)(@)(@@)(@@)(@@) ||| 91(@)(@)(@@) @HAD014 إياك وما يستهجن من الكلام فإنه يحبس عليك اللئام وينفر عنك الكرام(@)(@)(@@)(@@)(@@) ||| 92(@)(@)(@@) @HAD019 إياك والوقوع في الشبهات والولوع بالشهوات فإنهما يقتادانك إلى الوقوع فى الحرام وركوب كثير من الأثام(@)(@)(@@)(@@)(@@) ||| 93(@)(@)(@@) @HAD016 إياك أن تستسهل ركوب المعاصي فإنها تكسوك في الدنيا ذلة وتكسبك في الاخرة سخط الله(@)(@)(@@)(@@)(@@) ||| 94(@)(@)(@@) @HAD03 إياك أن تجعل(@)(@)PageV01P172(@)(@)(@@) @HAD016 مركبك لسانك في غيبة إخوانك أو تقول ما يصير عليك حجة وفي الإسائة إليك علة(@)(@)(@@)(@@)(@@) ||| 95(@)(@)(@@) @HAD018 إياك وما قل إنكاره وإن كثر منك اعتذاره فما كل قائل نكرا يمكنك أن توسعه عذرا(@)(@)(@@)(@@)(@@) ||| 96(@)(@)(@@) @HAD021 إياك وكل عمل ينفر عنك حرا أو يذل لك قدرا أو يجلب عليك شرا أو تحمل به إلى القيمة وزرا(@)(@)(@@)(@@)(@@) ||| 97(@)(@)(@@) @HAD021 إياك وما يسخط ربك ويوحش الناس منك فمن أسخط ربه تعرض للمنية ومن أوحش الناس تبرء من الحرية(@)(@)(@@)(@@)(@@) ||| 98(@)(@)(@@) @HAD013 إياك وخبث الطوية وافساد النية وركوب الدنية وغرور الأمنية(@)(@)(@@)(@@)(@@) ||| 99(@)(@)(@@) @HAD016 إياك والإستئثار بما للناس فيه أسوة والتغابي عما وضح للناظرين فإنه مأخوذ منك لغيرك(@)(@)(@@)(@@)(@@) ||| 100(@)(@)(@@) @HAD018 إياك ومودة الأحمق فإنه يضرك من حيث يرى أنه ينفعك ويسوئك وهو يرى أنه يسرك(@)(@)(@@)(@@)(@@) ||| 101(@)(@)(@@) @HAD015 إياك أن تستخف بالعلماء فإن ذلك يزري بك ويسىء الظن بك والمخيلة فيك(@)(@)(@@)(@@)(@@) ||| 102(@)(@)(@@) @HAD039 إياك أن تغتر بما ترى من إخلاد أهل الدنيا إليها وتكالبهم عليها فقد نبأك الله عنها 
ms62	 وتكشفت لك عن عيوبها ومساويها قال تعالى: إنما الدنيا لهو ولعب وإن الآخرة لهي الحيوان لو كانوا يعلمون(@)(@)(@@)(@@)(@@) ||| 103(@)(@)(@@) @HAD03 إياك أن تخدع(@)(@)PageV01P173(@)(@)(@@) @HAD026 عن دار القرار ومحل الطيبين الأخيار والأولياء الأبرار التى نطق القرآن بوصفها وأثنى على أهلها ودلك الله سبحانه عليها ودعاك إليها(@)(@)(@@)(@@)(@@) ||| 104(@)(@)(@@) @HAD040 إياك والكلام فيما لا تعرف طريقته ولا تعلم حقيقته فإن قولك يدل على عقلك وعبارتك تنبىء عن معرفتك فتوق من طول لسانك ما أمنته واختصر من كلامك ما استحسنته فإنه بك أجمل وعلى فضلك أدل(@)(@)(@@)(@@)(@@) ||| 105(@)(@)(@@) @HAD041 إياك ومشاورة النساء فإن رأيهن إلى أفن وعزمهن إلى وهن واكفف عليهن من أبصارهن فحجابك لهن خير من الإرتياب بهن وليس خروجهن بشر من إدخالك من لا يوثق عليهن وإن استطعت أن لا يعرفن غيرك فافعل(@)(@)(@@)(@@)(@@) ||| 106(@)(@)(@@) @HAD013 إياكم والتدابر والتقاطع وترك الأمر بالمعروف والنهى عن المنكر(@)(@)(@@)(@@)(@@) ||| 107(@)(@)(@@) @HAD09 إياكم ومصادقة الفاجر فإنه يبيع مصادقه بالتافه المحتقر(@)(@)(@@)(@@)(@@) ||| 108(@)(@)(@@) @HAD012 إياكم وصرعات البغي وفضحات الغدر وإثارة كامن الشر المذمم(@)(@)(@@)(@@)(@@) ||| 109(@)(@)(@@) @HAD013 إياكم والغلو فينا قولوا إنا مربوبون واعتقدوا فى فضلنا ما شئتم(@)(@)(@@)(@@)(@@) ||| 110(@)(@)(@@) @HAD011 إياكم وتحكم الشهوات عليكم فإن عاجلها ذميم وآجلها وحيم(@)(@)PageV01P174(@)(@)(@@)(@@)(@@) ||| 111(@)(@)(@@) @HAD013 إياكم والبطنة فإنها مقساة للقلب ومكسلة عن الصلوة ومفسدة للجسد(@)(@)(@@)(@@)(@@) ||| 112(@)(@)(@@) @HAD012 إياكم وغلبة الدنيا على أنفسكم فإن عاجلها نغصة وآجلها غصة(@)(@)(@@)(@@)(@@) ||| 113(@)(@)(@@) @HAD011 إياكم وتمكن الهوى منكم فإن أوله فتنة وآخره محنة(@)(@)(@@)(@@)(@@) ||| 114(@)(@)(@@) @HAD012 إياكم وغلبة الشهوات على قلوبكم فإن بدايتها ملكة ونهايتها هلكة(@)(@)(@@)(@@)(@@) ||| 115(@)(@)(@@) @HAD015 إياكم والفرقة فإن الشاذ عن أهل الحق للشيطان كما أن الشاذ من الغنم للذئب(@)(@)(@@)(@@)(@@) ||| 116(@)(@)(@@) @HAD011 إياكم والبخل فإن البخيل يمقته الغريب وينفر منه القريب(@)(@)(@@)(@@)(@@) ||| 117(@)(@)(@@) @HAD06 إياك أن تغتر بغلطة شرير بالخير(@)(@)(@@)(@@)(@@) ||| 118(@)(@)(@@) @HAD07 إياك أن تستوحش من غلطة خير بالشر(@)(@)PageV01P175(@)(@)(@@)(@@)(@@) ||| الفصل السادس مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام)(@)(@)(@@) حرف الألف بألف الإستفتاح.(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD07 ألا منتبه من رقدته قبل حين منيته(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD07 ألا مستيقظ من غفلته قبل نفاد مدته(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD06 ألا عامل لنفسه قبل يوم بؤسه(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD07 ألا مستعد للقاء ربه قبل زهوق نفسه(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD06 ألا 
ms63	 متزود لآخرته قبل أزوف رحلته(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD07 ألا تائب من خطيئته قبل حضور منيته(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD09 ألا إن أبصر الأبصار من نفذ فى الخير طرفه(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD09 ألا إن أسمع الأسماع من وعى التذكير وقبله(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD011 ألا إن إعطاء هذا المال فى غير حقه تبذير وإسراف(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD09 ألا وإن القناعة وغلبة الشهوة من أكبر(@)(@)PageV01P176(@)(@)(@@) @HAD01 العفاف(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD013 ألا وإنى لم أر كالجنة نام طالبها ولا كالنار نام هاربها(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD018 ألا وإن الدنيا دار لا يسلم منها إلا بالزهد فيها ولا ينجى منها بشىء كان لها(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD06 ألا حر يدع هذه اللماظة لأهلها(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD011 ألا إنه ليس لأنفسكم ثمن إلا الجنة فلا تبيعوها إلا بها(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD075 ألا وإن الدنيا قد تصرمت وآذنت بانقضاء وتنكر معروفها وصار جديدها رثا وسمينها غثا ألا وإن الدنيا قد ولت حذاء فلم يبق منها إلا صبابة كصبابة الإناء إصطبها صابها ألا وإن الآخرة قد أقبلت ولكل منهما بنون فكونوا من أبناء الآخرة ولا تكونوا من أبناء الدنيا فإن كل ولد سيلحق بأمه يوم القيامة وإن اليوم عمل ولا حساب وغدا حساب ولا عمل(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD012 ألا وإن أخوف ما أخاف عليكم إتباع الهوى وطول الأمل(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD020 ألا وإن من لا ينفعه الحق يضره الباطل ومن لا يستقم به الهدى يجر به الضلال إلى الردى(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD022 ألا وما يصنع بالدنيا من خلق للأخرة وما يصنع بالمال من عما قليل يسلبه ويبقى عليه حسابه وتبعته(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD04 ألا وإن التقوى(@)(@)PageV01P177(@)(@)(@@) @HAD010 مطايا ذلل حمل عليها أهلها وأعطوا أزمتها فأوردتهم الجنة(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD014 ألا وإن الخطايا خيل شمس حمل عليها أهلها وخلعت لجمها فأوردتهم النار(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD014 ألا وإن اليوم المضمار وغدا السباق والسبقة الجنة والغاية النار(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD023 ألا وانكم فى أيام أمل من ورائه أجل فمن عمل فى أيام أمله قبل حضور أجله نفعه عمله ولم يضرره أجله(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD030 ألا وإن اللسان بضعة من الإنسان فلا يسعده القول إذا امتنع ولا يمهله النطق إذا اتسع وإنا لأمراء الكلام وفينا تشبثت فروعه وعلينا تهدلت أغصانه(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD019 ألا وإن 
ms64	 من البلاء ألفاقة وأشد من الفاقة مرض البدن وأشد من مرض البدن مرض القلب(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD021 ألا وإن من النعم سعة المال وأفضل من سعة المال صحة البدن وأفضل من صحة البدن تقوى القلب(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD016 ألا وإن من تورط فى الأمور من غير نظر في العواقب فقد تعرض لمفدحات النوائب(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD014 ألا وإن اللبيب من استقبل وجوه الآراء بفكر صائب ونظر في العواقب(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD013 ألا لا يعدلن أحدكم عن القرابة يرى بها الخصاصة أن يسدها بالذي لا(@)(@)PageV01P178(@)(@)(@@) @HAD08 يزيده إن أمسكه ولا ينقصه إن أنفقه(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD017 ألا وإن اللسان الصادق يجعله الله للمرء في الناس خير من المال يورثه من لا يحمده(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD034 ألا وانه قد أدبر من الدنيا ما كان مقبلا وأقبل منها ما كان مدبرا وازمع الترحال عباد الله الأخيار وباعوا قليلا من الدنيا لا يبقى بكثير من الأخرة لا يفنى(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD017 ألا وقد أمرتم بالظعن ودللتم على الزاد فتزودوا من الدنيا ما تحرزون به أنفسكم غدا(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD017 ألا وإن الجهاد ثمن الجنة فمن جاهد نفسه ملكها وهي اكرم ثواب الله لمن عرفها(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD022 ألا وإن شرايع الدين واحدة وسبله قاصدة فمن أخذ بها لحق وغنم ومن وقف عنها ضل وندم(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD013 ألا وإن أهل البيت أبواب الحلم وأنوار الظلم وضياء الأمم(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD014 ألا لا يستحين من لا يعلم أن يتعلم فإن قيمة كل امرىء ما يعلم(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD012 ألا لا يستقبحن من سئل عما لا يعلم أن يقول لا أعلم(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD025 ألا فاعملوا والألسن مطلقة والأبدان صحيحة والأعضاء لدنة والمنقلب فسيح والمجال عريض قبل ازهاق الفوت وحلول الموت فحققوا عليكم(@)(@)PageV01P179(@)(@)(@@) @HAD05 حلوله ولا تنتظروا قدومه(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD042 ألا وقد أمرني الله بقتال أهل النكث والبغي والفساد في الأرض فأما الناكثون فقد قاتلت وأما القاسطون فقد جاهدت وأما المارقة فقد دوخت وأما شيطان الردهة فإني كفيته بصعقة سمعت لها وجيب قلبه ورجة صدره(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD040 ألا وإن الظلم ثلاثة فظلم لا يغفر وظلم لا يترك وظلم مغفور لا يطلب فأما الظلم الذى لا يغفر 
ms65	 فالشرك بالله لقوله تعالى إن الله لا يغفر أن يشرك به ويغفر ما دون ذلك لمن يشاء @HAD@ وأما الظلم الذى يغفر فظلم المرء نفسه عند بعض الهنات وأما الظلم الذى لا يترك فظلم العباد بعضهم بعضا العقاب هنالك شديد ليس جرحا بالمدى ولا ضربا بالسياط ولكنه ما يستصغر ذلك معه(@)(@)(@@)(@@)(@@) ||| 40(@)(@)(@@) @HAD044 ألا فاعملوا عباد الله والخناق مهمل والروح مرسل في فينة الإرشاد وراحة الأجساد ومهل البقية وأنف المشية وانظار التوبة وإنفساح الجنة قبل الضنك والمضيق والردع والزهوق قبل قدوم الغائب المنتظر وأخذة العزيز المقتدر(@)(@)PageV01P180(@)(@)(@@)(@@)(@@) ||| (الفصل السابع:) مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام)(@)(@)(@@) في حرف الألف بألف الإستفهام بلفظ أين قال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD05 أين العمالقة وأبناء العمالقة(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD05 أين الجبابرة وأبناء الجبابرة(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD011 أين أهل مدائن الرس الذين قتلوا النبيين واطفئوا نور المرسلين(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD07 أين الذين عسكروا العساكر ومدنوا المدائن(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD010 أين الذين قالوا من أشد منا قوة وأكثر جمعا(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD011 أين الذين كانوا أحسن آثارا وأعدل أفعالا وأكنف ملكا(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD07 أين الذين هزموا الجيوش وساروا بألوف(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD013 أين الذين شيدوا الممالك ومهدوا المسالك وأغاثوا الملهوف وقروا الضيوف(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD09 أين من سعى واجتهد وأعد واحتشد(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD013 أين من بنى وشيد وفرش ومهد وجمع وعدد(@)(@)PageV01P181(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD08 أين كسرى وقيصر وتبع وحمير(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD011 أين من ادخر واعتقد وجمع المال على المال فأكثر(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD09 أين من حصن وأكد وزخرف ونجد(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD012 أين من جمع فأكثر واحتقب واعتقد ونظر بزعمه للولد(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD09 أين من كان أطول منكم أعمارا وأعظم آثارا(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD08 أين من كان أعد عديدا واكنف جنودا(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD04 أين الملوك والأكاسرة(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD05 أين بنوا الأصفر والفراعنة(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD06 أين الذين ملكوا من الدنيا أقاصيها(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD07 أين الذين استذلوا الأعداء وملكوا نواصيها(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD05 أين الذين دانت لهم الأمم(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD07 أين الذين بلغوا من الدنيا أقاصى الهمم(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD04 أين تختدعكم كواذب الأمال(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD04 أين يغركم سراب الآمال(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD04 أين تذهب بكم المذاهب(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD07 أين تتيه بكم الغياهب وتخدعكم الكواذب(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD018 أين 
