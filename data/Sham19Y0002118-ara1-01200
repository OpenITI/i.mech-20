ms1189	 الكنوز الحرفية وفك الرموز العددية(@)(@)(@@) فتح الكنوز الحرفية، وفك الرموز العددية(@)(@@) ....(@)(@)(@@)(@@)(@@) || CHECK فتح اللطيف في أسرار التصريف(@)(@)(@@) فتح اللطيف، في أسرار التصريف(@)(@@) للشيخ: علوان علي بن عطية الحموي.(@)(@@) المتوفى: سنة 936، ست وثلاثين وتسعمائة.(@)(@@) رسالة.(@)(@@) مشتملة على: أسرار مسائل نحوية.(@)(@@) من (الأجرومية) .(@)(@)(@@)(@@)(@@) || CHECK الفتح المبين في ذكر جملة من أسرار الدين(@)(@)(@@) الفتح المبين، في ذكر جملة من أسرار الدين(@)(@@) رسالة.(@)(@@) في: الأركان الخمس للإسلام.(@)(@@) للشيخ: عبد الوهاب بن أحمد الشعراني.(@)(@@) المتوفى: سنة 973، ثلاث وسبعين وتسعمائة.(@)(@)(@@)(@@)(@@) || CHECK الفتح المبين في مدح الأمين(@)(@)(@@) الفتح المبين، في مدح الأمين(@)(@@) قصيدة ميمية، في البديع.(@)(@@) لعائشة بنت يوسف بن أحمد بن ناصر الباعوني.(@)(@@) توفيت: سنة 922.(@)(@@) أولها:(@)(@@) في حسن مطلع أقمار بذي سلم * أصبحت في زمرة العشاق كالعلم(@)(@@) ثم شرحتها شرحا لطيفا.(@)(@@) أوله: (الحمد لله محلي جياد الإفهام، بعقود مدح الشفيع ... الخ) .(@)(@@) قالت: وبعد، فهذه قصيدة صادرة عن ذات قناع، شاهدة بسلامة الطباع، سافرة عن وجوه البديع، سامية بمدح الحبيب الشفيع ... الخ) .(@)(@@) أتمته: في رمضان، سنة 922.(@)(@)(@@)(@@)(@@) || CHECK الفتح المبين في مدح شفيع المذنبين(@)(@)(@@) الفتح المبين، في مدح شفيع المذنبين(@)(@@) لعبد العزيز بن علي، المكي، الزمزمي.(@)(@@) المتوفى: سنة 963، ثلاث وستين وتسعمائة.(@)(@)(@@)(@@)(@@) || CHECK فتح المتعال في وصف النعال(@)(@)(@@) فتح المتعال، في وصف النعال(@)(@@) للشيخ، الأديب: أحمد بن محمد المغربي، نزيل مصر.(@)(@@) المتوفى: سنة 1041، إحدى وأربعين وألف.(@)(@@) قال الشهاب: رأيته في صفات نعل النبي - صلى الله (2/ 1235) عليه وسلم -(@)(@@) وهو مصنف حسن، أنشدني في وصفه أشعارا كثيرة لأدباء المغرب ... الخ) .(@)(@)PageV02P1234(@)(@)(@@)(@@)(@@) || CHECK فتح المجني في شرح المغني(@)(@)(@@) فتح المجني، في شرح المغني(@)(@@) في الأصول.(@)(@@) يأتي.(@)(@)(@@)(@@)(@@) || CHECK فتح المدبر للعاجز المقصر(@)(@)(@@) فتح المدبر، للعاجز المقصر(@)(@@) في: علم القضاء.(@)(@@) للشيخ: محمد بن إبراهيم بن أحمد السميديسي، الحنفي.(@)(@@) فرغ منه: في المحرم، سنة 921.(@)(@@) مختصر.(@)(@@) أوله: (أما بعد، حمدا لله الذي لا فوز إلا في طاعته ... الخ) .(@)(@@) ذكر فيه: قواعد الأشباه، وأورد في أثنائه مباحث الشروط، والحكم.(@)(@)(@@)(@@)(@@) || CHECK فتح مسالك الرمز شرح مناسك الكنز(@)(@)(@@) فتح مسالك الرمز، شرح مناسك الكنز(@)(@@) يأتي.(@)(@)(@@)(@@)(@@) || CHECK الفتح المستجاد في فتح 
ms1190	 بغداد(@)(@)(@@) الفتح المستجاد، في فتح بغداد(@)(@@) مختصر.(@)(@@) للشيخ: محمد بن علان المكي.(@)(@@) ألفه: سنة 1048، ثمان وأربعين وألف.(@)(@)(@@)(@@)(@@) || CHECK فتح المطلب المبرور وبرد الكبد المحرور في الجواب عن الأسئلة الواردة من(@)(@)(@@) فتح المطلب المبرور، وبرد الكبد المحرور، في الجواب عن الأسئلة الواردة من (التكرور)(@)(@@) لجلال الدين السيوطي.(@)(@@) المتوفى: سنة 911، إحدى عشرة وتسعمائة.(@)(@@) ذكره في (حاويه) تماما.(@)(@)(@@)(@@)(@@) || CHECK فتح المغالق من (أنت طالق)(@)(@)(@@) فتح المغالق، من (أنت طالق)(@)(@@) لجلال الدين السيوطي.(@)(@@) المتوفى: سنة 911، إحدى عشرة وتسعمائة.(@)(@@) رسالة.(@)(@@) ذكرها في (حاويه) تماما.(@)(@)(@@)(@@)(@@) || CHECK الفتح لمغلق حزب الفتح(@)(@)(@@) الفتح، لمغلق حزب الفتح(@)(@@) مر في: الحاء.(@)(@)(@@)(@@)(@@) || CHECK فتح المغيث في شرح: (ألفية الحديث)(@)(@)(@@) فتح المغيث، في شرح: (ألفية الحديث)(@)(@@) مر.(@)(@@) لمؤلف المتن: الحافظ، زين الدين: عبد الرحيم بن الحسين العراقي.(@)(@@) المتوفى: سنة 805.(@)(@)(@@)(@@)(@@) || AUTO فتح مفرج الكرب(@)(@)(@@) في مختصر: (شرح المنفرجة) .(@)(@@) يأتي.(@)(@)(@@)(@@)(@@) || CHECK فتح المنان في تخميس: (رائية الشيخ علوان)(@)(@)(@@) فتح المنان، في تخميس: (رائية الشيخ علوان)(@)(@@) للشيخ، زين الدين: عمر بن أحمد الشماع، الحلبي.(@)(@@) المتوفى: سنة 936، ست وثلاثين وتسعمائة.(@)(@@) مطلعها:(@)(@@) يا طالب الوصال بادر * واخرج عن الكون، ثم سافر(@)(@)(@@)(@@)(@@) || CHECK فتح المنان في تفسير القرآن(@)(@)(@@) فتح المنان، في تفسير القرآن(@)(@@) وهو: كبير.(@)(@@) في أربعين مجلدا.(@)(@@) للعلامة، قطب الدين: محمود بن مسعود الشيرازي.(@)(@@) المتوفى: سنة 710، عشر وسبعمائة.(@)(@@) وهو المعروف: (بتفسير العلامي) .(@)(@)(@@)(@@)(@@) || CHECK فتح المواهبي في مناقب الشاطبي(@)(@)(@@) فتح المواهبي، في مناقب الشاطبي(@)(@@) للشيخ، أبي العباس: (2/ 1236) أحمد بن محمد الخطيب، القسطلاني.(@)(@@) المتوفى: سنة 923، ثلاث وعشرين وتسعمائة.(@)(@@) أوله: (الحمد لله الذي فضل بفضله من اختاره ... الخ) .(@)(@)PageV02P1235(@)(@)(@@)(@@)(@@) || AUTO فتح نامه(@)(@)(@@) فارسي.(@)(@@) منظوم.(@)(@@) للشيخ: حسن الأصبهاني.(@)(@@) المتوفى: سنة ...(@)(@)(@@)(@@)(@@) || CHECK فتح النقوض في شرح العروض(@)(@)(@@) فتح النقوض، في شرح العروض(@)(@@) مر.(@)(@)(@@)(@@)(@@) || CHECK فتح الوصيد في شرح القصيد(@)(@)(@@) فتح الوصيد، في شرح القصيد(@)(@@) أي: (الشاطبية) .(@)(@@) مر.(@)(@)(@@)(@@)(@@) || CHECK فتح الوهاب بشرح الآداب(@)(@)(@@) فتح الوهاب، بشرح الآداب(@)(@@) للقاضي، زين الدين: زكريا بن محمد الأنصاري.(@)(@@) المتوفى: سنة 926، ست وعشرين وتسعمائة.(@)(@)(@@)(@@)(@@) || CHECK فتح الوهاب في فضائل الآل والأصحاب(@)(@)(@@) فتح الوهاب، في فضائل الآل والأصحاب(@)(@@) للشيخ: عبد 
ms1191	 الوهاب بن أحمد الشعراني.(@)(@@) المتوفى: سنة 973، ثلاث وسبعين وتسعمائة.(@)(@@) أثبت فيه: الخلافة للخلفاء الأربعة، على الترتيب الواقع.(@)(@@) وذكر في أوله: مقدمة جامعة، لبيان الطريقة النافعة.(@)(@@) وختم: بذكر بعض فضائل أهل البيت، تاركا في الكل التعصب الباطل.(@)(@@) أوله: (الحمد لله الذي منحنا معشر أهل السنة بالسنة ... الخ) .(@)(@@) وذكرهم في: أربعة أبواب.(@)(@)(@@)(@@)(@@) || CHECK فتح الوهاب فيما خالف فيه الشيخين أي: الرافعي والنووي صاحب: (العباب(@)(@)(@@) فتح الوهاب، فيما خالف فيه الشيخين، أي: الرافعي، والنووي، صاحب: (العباب)(@)(@@) وهو: صفي الدين: أحمد بن عمر.(@)(@@) للشيخ: محمد بن الحسين الزبيدي، النهاري.(@)(@@) المتوفى: سنة 970، سبعين وتسعمائة.(@)(@)(@@)(@@)(@@) || AUTO الفتحية(@)(@)(@@) رسالة.(@)(@@) في الهيئة البسيطة.(@)(@@) للمولى، علاء الدين: علي بن محمد، المعروف: بقوشجي.(@)(@@) المتوفى: سنة 879، تسع وسبعين وثمانمائة.(@)(@@) وهي: رسالة نافعة.(@)(@@) ألفها: لما ذهب مع السلطان: محمد خان، إلى محاربة الحسن الطويل.(@)(@@) شرحها:(@)(@@) المولى، سنان الدين: يوسف، المشهور: بعلامة سنان.(@)(@@) قال في (الشقاق) : وهو من تلامذة المصنف.(@)(@@) وهو: شرح نافع.(@)(@@) لكنه ليس من علماء هذا الفن، فلم يقدر على الشرح كما ينبغي.(@)(@@) كذا في: (الموضوعات) .(@)(@@) وميرم جلبي، الموسوم: بمحمود بن محمد، ابن بنت المؤلف.(@)(@@) المتوفى: سنة 931، إحدى وثلاثين وتسعمائة.(@)(@@) حين قرأها المولى: طاشكبري، زاده عليه.(@)(@)(@@)(@@)(@@) || CHECK الفتحية في الموسيقى(@)(@)(@@) الفتحية، في الموسيقى(@)(@@) لمحمد بن عبد الحميد اللاذقي.(@)(@@) أولها: (الحمد لله الذي أذاقنا حلاوة ألحان عنادل ورد جماله ... الخ) .(@)(@@) ذكر فيها أنه: ألفها في: أوائل فتوح السلطان: بايزيد بن محمد خان، وأهداها (2/ 1237) إليه.(@)(@@) وهي: من المتوسطات في هذا الفن.(@)(@@) رتبها على: مقدمة، وطرفين.(@)(@@) ذكر في المقدمة: فصولا ثلاثة.(@)(@@) وذكر في الطرف الأول: التأليف.(@)(@@) وفي الثاني: الإيقاع.(@)(@)PageV02P1236(@)(@)(@@)(@@)(@@) || CHECK الفتن بين قيس ويمن(@)(@)(@@) الفتن، بين قيس ويمن(@)(@@) مختصر.(@)(@@) أوله: (الحمد لله الذي نهى عن اتباع الهوى ... الخ) .(@)(@)(@@)(@@)(@@) || AUTO الفتوحات الربانية(@)(@)(@@) لأبي محمد: عبد الله بن محمد المرجاني.(@)(@@) المتوفى: سنة 699، تسع وتسعين وستمائة.(@)(@)(@@)(@@)(@@) || CHECK الفتوحات الربانية على الأذكار النواوية(@)(@)(@@) الفتوحات الربانية، على الأذكار النواوية(@)(@@) مر.(@)(@)(@@)(@@)(@@) || AUTO الفتوحات السليمانية(@)(@)(@@) تركي.(@)(@@) أنشأها: الحريري، الشاعر.(@)(@)(@@)(@@)(@@) || AUTO الفتوحات السليمية(@)(@)(@@) منظومة.(@)(@@) بالتركية.(@)(@@) لشكري، من علماء الأكراد.(@)(@)(@@)(@@)(@@) || AUTO فتوحات الشام 
ms1192	(@)(@)(@@) لأبي عبد الله: محمد بن عمر بن واقد.(@)(@@) المتوفى: سنة 207.(@)(@@) نظمها:(@)(@@) محمد بن محمود بن أجا.(@)(@@) بالتركي.(@)(@@) في: اثني عشر ألف بيت.(@)(@@) ولأبي حذيفة: إسحاق بن بشر القرشي.(@)(@@) وصنف:(@)(@@) أبو محمد: أحمد بن أعتم الكوفي.(@)(@@) المتوفى: سنة ...(@)(@@) ترجمه:(@)(@@) أحمد بن محمد المستوفي.(@)(@@) بالفارسية.(@)(@@) المتوفى: سنة ...(@)(@)(@@)(@@)(@@) || AUTO فتوحات الصيام(@)(@)(@@) في التصوف.(@)(@@) للسلطان: مراد بن سليم خان العثماني.(@)(@@) المتوفى: سنة 1003.(@)(@@) قال النوعي في تاريخ تأليفه: فتوحات ملوكي.(@)(@)(@@)(@@)(@@) || CHECK الفتوحات الغيبية في تدبير الأرواح الحكمية(@)(@)(@@) الفتوحات الغيبية، في تدبير الأرواح الحكمية(@)(@@) مختصر.(@)(@@) في: الإكسير.(@)(@@) أوله: (الحمد لله البديع، الوهاب ... الخ) .(@)(@@) مرتب على: أبواب، وفصول(@)(@@) للشيخ: عبد الكريم بن يحيى بن عثمان المراكشي.(@)(@)(@@)(@@)(@@) || CHECK الفتوحات في الجفر(@)(@)(@@) الفتوحات، في الجفر(@)(@@) لشكر الله الشرواني، وهو: محمد بن إبراهيم.(@)(@@) المتوفى: حدود سنة 912.(@)(@@) أولها: (الحمد لله الذي أودع في قلوب أوليائه ... الخ) .(@)(@@) رتبها على: مقدمة، وثلاث مقالات.(@)(@@) المقدمة: في أوضاع علم الجفر.(@)(@@) المقالة الأولى: في أحوال العالم.(@)(@@) الثانية: في أحوال الإمام، وزمان خروجه.(@)(@@) الثالثة: في أحوال الدولة العلية.(@)(@)(@@)(@@)(@@) || AUTO الفتوحات المدنية(@)(@)(@@) للشيخ، محيي الدين: عبد القادر بن محمد، الشهير: بقضيب البان.(@)(@@) المتوفى: سنة 1040، أربعين وألف.(@)(@@) ألفها: في مجاورته بها، في حدود سنة 1010، عشر وألف.(@)(@)(@@)(@@)(@@) || AUTO الفتوحات المصرية(@)(@)(@@) للشيخ الأكبر: المذكور.(@)(@@) ذكره الشعراني في: (الكبريت) .(@)(@)PageV02P1237(@)(@)(@@)(@@)(@@) || CHECK الفتوحات المكية في معرفة أسرار المالكية والملكية(@)(@)(@@) الفتوحات المكية، في معرفة أسرار المالكية والملكية(@)(@@) مجلدات.(@)(@@) للشيخ، محيي الدين: محمد بن علي، المعروف: بابن عربي، الطائي، المالكي.(@)(@@) المتوفى: سنة 638، ثمان وثلاثين وستمائة.(@)(@@) من أعظم كتبه، وآخرها تأليفا.(@)(@@) قال فيها: كنت نويت الحج والعمرة، فلما وصلت أم القرى، أقام الله - سبحانه وتعالى - في خاطري أن أعرف الولي، بفنون من المعارف، حصلتها في غيبتي.(@)(@@) وكان الأغلب منها، ما فتح الله - سبحانه وتعالى - علي، عند طوافي بيته المكرم.(@)(@@) وقال في الباب الثامن والأربعين:(@)(@@) واعلم: أن ترتيب أبواب الفتوحات، لم يكن عن اختيار ولا عن نظر فكري، وإنما الحق - تعالى - يملي لنا، على لسان ملك الإلهام، جميع ما نسطره.(@)(@@) وقد نذكر كلاما بين كلامين، لا تعلق له 
ms1193	 بما قبله، ولا بما بعده.(@)(@@) وذلك شبيه: بقوله - سبحانه وتعالى -: (حافظوا على الصلوات والصلاة الوسطى ... ) بين آيات طلاق، ونكاح، وعدة، ووفاة.(@)(@@) وقال:(@)(@@) واعلم: أن جميع ما أتكلم فيه في مجالسي وتصانيفي، إنما هو من حضرة القرآن وخزائنه.(@)(@@) فإني أعطيت مفاتيح الفهم فيه، والإمداد منه. انتهى.(@)(@@) وفي أوله: مقدمة في فهرسه.(@)(@@) ذكر فيه: خمسمائة وستين بابا.(@)(@@) والباب التاسع والخمسون وخمسمائة منه: باب عظيم.(@)(@@) جمع فيه: أسرار الفتوحات كلها.(@)(@@) وجد بخطه، في آخر الفتوحات.(@)(@@) وكان الفراغ من هذا الباب: في شهر صفر، سنة 629، تسع وعشرين وستمائة.(@)(@@) وقد اختصرها:(@)(@@) الشيخ: عبد الوهاب بن أحمد الشعراني.(@)(@@) المتوفى: سنة 973، ثلاث وسبعين وتسعمائة.(@)(@@) وسماه: (لواقح الأنوار القدسية، المنتقاة من الفتوحات المكية) .(@)(@@) وفرغ في: ذي الحجة، سنة 960، ستين وتسعمائة.(@)(@@) ثم لخص: ذلك التلخيص ثانيا.(@)(@@) وسماه: (الكبريت الأحمر، من علوم الشيخ الأكبر) .(@)(@@) ذكر فيه: أن جماعة من مشايخ عصره، بمصر، سألوه اختصاره، بمعنى أنه: حذف لهم منه كل ما لا تمس الحاجة إليه من: المسائل، لا بمعنى: تقليل اللفظ، وتكثير المعنى، فأجاب.(@)(@@) ولم يخرج عن: ترتيب الشيخ: على خمسمائة وستين بابا.(@)(@@) وقد تكلم العلماء فيه.(@)(@@) قال البقاعي:(@)(@@) يسميها المحقون: (القبوحات الهلكية) .(@)(@@) وله: (فتوحات مدنية) .(@)(@@) مختصرة.(@)(@@) عشر ورقات.(@)(@@) أولها: (الحمد لله الذي جعل الإنسان خلاصة مملكة الأكوان ... ) .(@)(@@) قال الشعراني في (مختصر الفتوحات) :(@)(@@) وقد توقفت حال الاختصار في مواضع كثيرة.(@)(@@) منها: لم يظهر لي موافقتها لما عليه أهل السنة والجماعة، فحذفتها من هذا المختصر.(@)(@@) وربما سهوت، فتتبعت ما في الكتاب.(@)(@@) كما وقع للبيضاوي مع الزمخشري.(@)(@@) ثم لم أزل كذلك، أظن أن المواضع التي حذفت ثابتة عن الشيخ: محيي الدين.(@)(@@) حتى قدم علينا الأخ، العالم، الشريف، شمس الدين، السيد: محمد بن السيد: أبي الطيب المدني.(@)(@@) المتوفى: سنة (2/ 1239) 955، خمس وخمسين وتسعمائة.(@)(@@) فذاكرته في ذلك.(@)(@@) فأخرج إلي نسخة من (الفتوحات) التي قابلها على النسخة التي عليها: خط الشيخ: محيي الدين نفسه، بقونية.(@)(@@) فلم أر فيها شيئا مما توقفت فيه وحذفته.(@)(@@) فعلمت أن النسخ التي في مصر الآن، كلها كتبت من النسخة التي دسوا 
ms1194	 على الشيخ فيها، ما يخالف عقائد أهل السنة والجماعة، كما وقع له ذلك في كتاب: (الفصوص) ، وغيره.(@)(@@) وقد أطلعني: الأخ، الصالح، السيد: الشريف المدني، على صورة ما رآه مكتوبا بخط الشيخ: محيي الدين، وغيره، على النسخة التي وقفها: الشيخ، في قونية.(@)(@@) وهو هذا: وقف محمد بن علي بن عربي الطائي هذا الكتاب على جميع المسلمين.(@)(@@) وفي آخره: وقد تم هذا الكتاب على يد منشئه.(@)(@@) وهو النسخة الثانية منه: بخط يدي.(@)(@@) وكان الفراغ منه: بكرة يوم الأربعاء، الرابع والعشرين من شهر ربيع الأول، سنة 636، ست وثلاثين وستمائة.(@)(@@) وكتبه منشئه.(@)(@@) قال السيد: وهذه النسخة في: سبعة وثلاثين مجلدا.(@)(@@) وفيها: زيادات على النسخة الأولى، التي دس الملحدون فيها العقائد الشنيعة.(@)(@@) قال: وفي ظهره: ترجمة اسم الكتاب بخطه.(@)(@@) وتحته: بخط الشيخ: صدر الدين القونوي:(@)(@@) إنشاء مولانا، شيخ الإسلام، وصفوة الأنام: محيي الدين بن عربي.(@)(@@) وتحته: ملك هذه المجلدة: لمحمد بن إسحاق القونوي.(@)(@@) وتحته أيضا: بخط الشيخ: صدر الدين:(@)(@@) رواية: محمد بن أبي بكر بن ميذار التبريزي، سماعا منه، انتقل إلى خادمه، وربيب لطفه: محمد بن إسحاق، سنة 637، سبع وثلاثين وستمائة.(@)(@@) وأورد: ما نقله السيد، من الكتاب السماع، في آخر المجلدات.(@)(@)PageV02P1238(@)(@)(@@)(@@)(@@) || AUTO فتوح مير انشاهي(@)(@)(@@) لسعد الله الكرماني.(@)(@@) المتوفى: سنة ...(@)(@)(@@)(@@)(@@) || AUTO فتوح أبي حذيفة(@)(@)(@@) إسحاق بن بشر القرشي.(@)(@)(@@)(@@)(@@) || AUTO فتوح الإرشاد(@)(@)(@@) لمحمد بن محمد، الشهير: بالمحب الشيرازي.(@)(@)(@@)(@@)(@@) || AUTO فتوح أرمنية(@)(@)(@@) لأبي عبيد: معمر بن المثنى البصري.(@)(@@) المتوفى: سنة 210، عشر ومائتين.(@)(@@) وله: (فتوح أهواز) .(@)(@)(@@)(@@)(@@) || AUTO فتوح أعثم(@)(@)(@@) وهو: محمد بن علي، أبو محمد: أحمد بن علي، المعروف: بابن أعثم الكوفي.(@)(@@) وترجمته بالفارسية:(@)(@@) لأحمد بن محمد المستوفي.(@)(@@) المتوفى: ...(@)(@)(@@)(@@)(@@) || AUTO فتوح الأمصار(@)(@)(@@) لمحمد بن عمر الواقدي.(@)(@@) المتوفى: سنة 207.(@)(@@) وله: (فتوح الشام) .(@)(@@) نظمه:(@)(@@) محمد بن محمود بن آجا التدموري.(@)(@@) المتوفى: سنة 925، خمس وعشرين وتسعمائة.(@)(@@) في: اثني عشر ألف بيت.(@)(@)PageV02P1239(@)(@)(@@)(@@)(@@) || AUTO فتوح بيت المقدس(@)(@)(@@) لأبي حذيفة: إسحاق بن بشر القرشي.(@)(@@) المتوفى: سنة 206.(@)(@@) كذا في: (إتحاف الأخصاء) .(@)(@)(@@)(@@)(@@) || AUTO فتوح الحرمين(@)(@)(@@) فارسي.(@)(@@) منظوم: (مناسك مصور) للمحيي.(@)(@@) أوله:(@)(@@) أي همه كس را بدرت 
ms1195	 التجا *(@)(@)(@@)(@@)(@@) || CHECK الفتوح الربانية في دفع الشبهات الكورانية(@)(@)(@@) الفتوح الربانية، في دفع الشبهات الكورانية(@)(@@) رسالة.(@)(@@) تتضمن: الأجوبة عن البيضاوي، في أول: (تفسير الكوراني) .(@)(@)(@@)(@@)(@@) || CHECK فتوح الرحمن في إشارات القرآن وتفسيره(@)(@)(@@) فتوح الرحمن، في إشارات القرآن، وتفسيره(@)(@@) للشيخ: عبد الملك الديلمي.(@)(@@) أوله: (الحمد لله حق حمده ... ) .(@)(@@) قال: فهذا تفسير بعض آيات القرآن التي تحتاج إليها الصوفية في أحوالهم.(@)(@)(@@)(@@)(@@) || AUTO فتوح: سيف بن عمر التميمي(@)(@)(@@) ....(@)(@)(@@)(@@)(@@) || AUTO فتوح: عبد الملك بن قريب(@)(@)(@@) الأصمعي.(@)(@@) المتوفى: سنة 216، ست عشرة ومائتين.(@)(@)(@@)(@@)(@@) || AUTO فتح الغيب(@)(@)(@@) للشيخ: عبد القادر الكيلاني.(@)(@@) المتوفى: سنة 561، إحدى وستين وخمسمائة.(@)(@@) أوله: (الحمد لله رب العالمين أولا، وآخرا ... الخ) .(@)(@)(@@)(@@)(@@) || AUTO فتوح الغيب(@)(@)(@@) وهو حاشية: (الكشاف) للطيبي.(@)(@@) يأتي.(@)(@)(@@)(@@)(@@) || CHECK فتوح المشاهدين لترويح قلوب المجاهدين(@)(@)(@@) فتوح المشاهدين، لترويح قلوب المجاهدين(@)(@@) في ترجمة: (نفحات الأنس) .(@)(@@) يأتي.(@)(@)(@@)(@@)(@@) || CHECK فتوح: مصر والمغرب(@)(@)(@@) فتوح: مصر، والمغرب(@)(@@) للإمام، أبي القاسم: عبد الرحمن بن عبد الله بن عبد الحكم القرشي، المصري.(@)(@@) المتوفى: سنة 257، سبع وخمسين ومائتين.(@)(@)(@@)(@@)(@@) || CHECK فتوح الواهب بأن ليس شيء على الله بواجب(@)(@)(@@) فتوح الواهب، بأن ليس شيء على الله بواجب(@)(@@) لمحمد بن علي بن محمد الموصلي، المالكي.(@)(@@) رسالة.(@)(@@) أولها: (الحمد لله الذي لا يجب عليه شيء ... الخ) .(@)(@@) ألفها: ردا على من ذهب إلى مذهب المعتزلة.(@)(@)(@@)(@@)(@@) || CHECK فتوح: وهب بن منبه بن كامل اليماني الصنعاني(@)(@)(@@) فتوح: وهب بن منبه بن كامل اليماني، الصنعاني(@)(@@) المتوفى: سنة 114، أربع عشرة ومائة.(@)(@)(@@)(@@)(@@) || CHECK فتور زمان الصدور وصدور زمان الفتور(@)(@)(@@) فتور زمان الصدور، وصدور زمان الفتور(@)(@@) فارسي.(@)(@@) للوزير: أنوشروان بن خالد.(@)(@@) المتوفى: سنة 532، اثنتين وثلاثين وخمسمائة.(@)(@@) ذكره (العماد) في أول: (نصرة الفترة) .(@)(@@) وقال: وجدته تنبئ إطالته عن القصور.(@)(@@) وقد قصره: على أهل (2/ 1241) زمانه، من أوسط عهد: نظام الملك(@)(@@) إلى آخر عهد: طغرل.(@)(@@) فما أنصف فيه الصدق والصواب. انتهى.(@)(@)PageV02P1240(@)(@)(@@)(@@)(@@) || CHECK فتيا صلاح العمل لانتظار الأجل(@)(@)(@@) فتيا صلاح العمل، لانتظار الأجل(@)(@@) لأبي الحسن: علي بن أحمد الحراني، النجيبي.(@)(@@) المتوفى: سنة ...(@)(@@) مختصر مكرر.(@)(@@) (وفي سلاح العمل) .(@)(@)(@@)(@@)(@@) || CHECK فتى الفتوة ومرآة المروة(@)(@)(@@) فتى الفتوة، ومرآة المروة(@)(@@) رسالة.(@)(@@) لجمال الدين: 
ms1196	 محمد بن إبراهيم الوطواط، الكتبي.(@)(@@) المتوفى: سنة 718، ثمان عشرة وسبعمائة.(@)(@@) قرظ له: عليها جماعة من أكابر عصره.(@)(@)(@@)(@@)(@@) || CHECK فجر الأسما وصبح المسمى(@)(@)(@@) فجر الأسما، وصبح المسمى(@)(@@) ذكره: البوني.(@)(@)(@@)(@@)(@@) || CHECK فجر الثمد في إعراب أكمل الحمد(@)(@)(@@) فجر الثمد، في إعراب أكمل الحمد(@)(@@) للسيوطي.(@)(@@) المتوفى: سنة 911، إحدى عشرة وتسعمائة.(@)(@@) ذكره في: فن النحو.(@)(@@) وله: (فجر الدياجي، في الأحاجي) .(@)(@)(@@)(@@)(@@) || AUTO فحول الشعراء(@)(@)(@@) لأبي تمام: حبيب بن أوس الطائي.(@)(@@) المتوفى: سنة 231، إحدى وثلاثين ومائتين.(@)(@@) فيه: خلق كثير من: الجاهلية، والإسلام، والمخضرمين.(@)(@)(@@)(@@)(@@) || AUTO الفجر المنير(@)(@)(@@) للفاكهاني.(@)(@)(@@)(@@)(@@) || CHECK الفخري في الجبر والمقابلة(@)(@)(@@) الفخري، في الجبر والمقابلة(@)(@@) لأبي بكر، فخر الدين: محمد بن حسن الوزير.(@)(@@) المتوفى: سنة ...(@)(@@) ألفها: لبهاء الدين والدولة.(@)(@@) فصارت: من أنفس مبسوطاتها.(@)(@)(@@)(@@)(@@) || CHECK الفخ المنصوب إلى صيد المحبوب(@)(@)(@@) الفخ المنصوب، إلى صيد المحبوب(@)(@@) في علم: الباه.(@)(@)(@@)(@@)(@@) || AUTO علم الفراسة(@)(@)(@@) عده صاحب (مفتاح السعادة) : من فروع العلم الطبيعي.(@)(@@) وقال: وهو: علم يعرف منه أخلاق الناس من أحوالهم الظاهرة، من الألوان، والأشكال، والأعضاء.(@)(@@) وبالجملة: الاستدلال بالخلق الظاهر، على الخلق الباطن.(@)(@@) وموضوعه، ومنفعته: ظاهران.(@)(@@) ومن الكتب المؤلفة فيه:(@)(@@) كتاب الإمام الرازي: (خلاصة كتاب أرسطو) .(@)(@@) مع زيادات مهمة.(@)(@@) ولأقليمون:(@)(@@) (كتاب في الفراسة) .(@)(@@) يختص بالنسوان.(@)(@@) و (كتاب السياسة) .(@)(@@) لمحمد بن الصوفي.(@)(@@) مختصر.(@)(@@) مفيد في هذا العلم.(@)(@@) وكفى بهذا العلم شرفا قوله - تعالى -: (إن في ذلك لآيات للمتوسمين) .(@)(@@) وقوله - سبحانه وتعالى -: (2/ 1242) (تعرفهم بسيماهم) .(@)(@@) وقوله - صلى الله تعالى عليه وسلم -: (اتقوا فراسة المؤمن..) . انتهى.(@)(@)PageV02P1241(@)(@)(@@)(@@)(@@) || AUTO فراست نامه(@)(@)(@@) فارسي.(@)(@@) لأبي الفضل: المنشي، الشيرازي.(@)(@@) المتوفى: سنة ...(@)(@@) أوله: (أي فيض تورهنماي هر عقدة كشاي ... ) .(@)(@)(@@)(@@)(@@) || CHECK علم الفراشي والنومى(@)(@)(@@) علم الفراشي، والنومى(@)(@@) من: فروع علم التفسير.(@)(@)(@@)(@@)(@@) || AUTO فراق نامه(@)(@)(@@) منظوم.(@)(@@) فارسي.(@)(@@) في: مزاحفات بحر المتقارب المثمن.(@)(@@) لكمال الدين: إسماعيل بن ... الأصبهاني.(@)(@@) المتوفى: سنة 635.(@)(@@) ولسلمان بن خواجه: محمد الساوجي.(@)(@@) المتوفى: سنة 779، تسع وسبعين وسبعمائة.(@)(@@) نظمه: للشيخ: أويس خان.(@)(@@) أوله:(@)(@@) بنام خدايي كه باتيره خاك * بر آميخت أين جوهر جان باك.(@)(@)(@@)(@@)(@@) || CHECK فرائد الأعصار في مدح النبي المختار(@)(@)(@@) فرائد الأعصار، في مدح النبي المختار(@)(@@) لابن العطار: أحمد 
ms1197	 بن محمد الدنيسري.(@)(@@) المتوفى: سنة 794، أربع وتسعين وسبعمائة.(@)(@)(@@)(@@)(@@) || CHECK فرائد التاجي في شرح: (الفرائض السراجي)(@)(@)(@@) فرائد التاجي، في شرح: (الفرائض السراجي)(@)(@@) يأتي.(@)(@)(@@)(@@)(@@) || AUTO فرائد التفسير(@)(@)(@@) لأبي المحامد، فصيح الدين: محمد بن عمر المابرنابازي.(@)(@@) اختصر فيه: (الكشاف) .(@)(@@) وزيادات: بحثية نحوية، وكلامية، وأدبية.(@)(@@) رأيت القطعة الأخيرة منه.(@)(@)(@@)(@@)(@@) || CHECK الفرائد التيسيرية في الفوائد التفسيرية(@)(@)(@@) الفرائد التيسيرية، في الفوائد التفسيرية(@)(@@) لزين الدين: سريجا بن محمد الملطي.(@)(@@) المتوفى: سنة 788، ثمان وثمانين وسبعمائة.(@)(@@) عشرة أجزاء.(@)(@)(@@)(@@)(@@) || AUTO فرائد الجواهر(@)(@)(@@) في الطب.(@)(@)(@@)(@@)(@@) || CHECK فرائد الخرائد في الأمثال والحكم(@)(@)(@@) فرائد الخرائد، في الأمثال والحكم(@)(@@) لأبي يعقوب: يوسف بن طاهر النحوي.(@)(@@) فرغ منه: في سنة 532، اثنتين وثلاثين وخمسمائة.(@)(@@) ذكر في أوله: أبا الفضل: أحمد بن محمد الميداني، أنه أستاذه.(@)(@@) وأنه ألف كتابا، لكنه أطال فيه، يذكر ما أهمل من الأمثال.(@)(@@) فألفه على: ترتيب الحروف.(@)(@@) وأدرج فيه: الأبيات السائرة، والحكم.(@)(@@) أوله: (الحمد لله رافع السماوات العلى ... الخ) .(@)(@)PageV02P1242(@)(@)(@@)(@@)(@@) || CHECK فرائد الدر المنظم في التطفل على حضرة المصطفى - صلى الله تعالى عليه(@)(@)(@@) فرائد الدر المنظم، في التطفل على حضرة المصطفى - صلى الله تعالى عليه وسلم -(@)(@@) لمحمد الخالص ابن عنقاء الحسيني، المكي.(@)(@@) مختصر.(@)(@@) أوله: (سبحان من منح حبيبه المصطفى - صلى الله تعالى عليه وسلم - ... الخ) .(@)(@@) جمع فيها: مدائحه النبوية.(@)(@@) على ترتيب: الحروف.(@)(@@) في كل حرف: ثلاثة عشر بيتا.(@)(@@) فجملة أبياتها: خمس وتسعون وثلاثمائة.(@)(@)(@@)(@@)(@@) || CHECK فرائد السلوك في تاريخ الخلفاء والملوك(@)(@)(@@) فرائد السلوك، في تاريخ الخلفاء والملوك(@)(@@) منظومة.(@)(@@) لأبي الفضل: محمد بن أحمد بن محمد بن أحمد الباعوني.(@)(@@) المتوفى: سنة 871، إحدى وسبعين وثمانمائة.(@)(@@) من: أول الخليقة.(@)(@@) إلى: الأشرف: قايتباي.(@)(@@) قلت: سماها السخاوي في: (الامتنان) :(@)(@@) (بتحفة الظرفاء، في تاريخ الملوك والخلفاء) .(@)(@@) ثم ذيلها:(@)(@@) ابن أخيه: محمد بن يوسف بن أحمد الباعوني.(@)(@@) المتوفى: سنة 916.(@)(@@) إلى زمن: قايتباي.(@)(@@) وسماه: (الإشارة الوفية، إلى الخصايص الأشرفية) .(@)(@)(@@)(@@)(@@) || CHECK فرائد السلوك في مصائد الملوك(@)(@)(@@) فرائد السلوك، في مصائد الملوك(@)(@@) رجز.(@)(@@) لجمال الدين: محمد بن محمد بن نباتة المصري.(@)(@@) المتوفى: سنة 768، ثمان وستين وسبعمائة.(@)(@)(@@)(@@)(@@) || AUTO فرائد القلائد(@)(@)(@@) لرشيد: محمد بن محمد الكاتب، الوطواط. 
ms1198	(@)(@@) المتوفى: سنة 573، ثلاث وسبعين وخمسمائة.(@)(@)(@@)(@@)(@@) || AUTO فرائد الفوائد(@)(@)(@@) في: التعريف، والمعرفة.(@)(@@) رسالة.(@)(@@) لمحمد الكشي، الخالدي.(@)(@@) المتوفى: سنة ...(@)(@)(@@)(@@)(@@) || AUTO فرائد الفوائد(@)(@)(@@) في التعبير.(@)(@@) لابن دقماق: إبراهيم بن محمد المصري، المؤرخ.(@)(@@) المتوفى: سنة 809، تسع وثمانمائة.(@)(@)(@@)(@@)(@@) || CHECK فرائد الفوائد في فنون غير واحد(@)(@)(@@) فرائد الفوائد، في فنون غير واحد(@)(@@) لأحمد بن علي بن أحمد بن داود البلوي، الغرناطي.(@)(@@) المتوفى: حدود سنة 830.(@)(@)(@@)(@@)(@@) || AUTO فرائد الفوائد(@)(@)(@@) في مختصر: (شرح الشواهد) .(@)(@@) كلاهما: للعيني.(@)(@)(@@)(@@)(@@) || CHECK الفرائد في حل المسائل والفوائد(@)(@)(@@) الفرائد، في حل المسائل والفوائد(@)(@@) في شرح: (الكنز) .(@)(@@) يأتي.(@)(@)(@@)(@@)(@@) || CHECK الفرائد في الزوائد(@)(@)(@@) الفرائد، في الزوائد(@)(@@) لأمين الدين: عبد الوهاب بن أحمد بن وهبان الدمشقي.(@)(@@) المتوفى: سنة 768، ثمان وستين وسبعمائة.(@)(@)PageV02P1243(@)(@)(@@)(@@)(@@) || AUTO فرائد اللآلي(@)(@)(@@) في: فروع الحنفية.(@)(@@) مختصر.(@)(@@) ليحيى الفقيه، صاحب: (مشتمل الأحكام) .(@)(@@) أولها: (الحمد لوليه ... الخ) .(@)(@@) قال: جمعته من الفتاوى، والشروح، بعد ما كتبت حاشية على: (شرح الوفاية) لصدر الشريعة.(@)(@@) وغب ما جمعت مشتمل الأحكام البديعة.(@)(@@) وأثر ما حررت أجوبة، لأسئلة صاحب: (جامع الفصولين) .(@)(@)(@@)(@@)(@@) || AUTO علم الفرائض(@)(@)(@@) وهو: علم بقواعد، وجزئيات، تعرف بها: كيفية صرف التركة إلى الوارث، بعد معرفته.(@)(@@) وموضوعها: التركة، والوارث.(@)(@@) لأن الفرضي يبحث عن التركة، وعن مستحقها بطريق الإرث، من حيث أنها تصرف إليه إرثا، بقواعد معينة شرعية، ومن جهة قدر ما يحرزه، ويتبعها متعلقات التركة.(@)(@@) ووجه الحاجة إليه: الوصول إلى إيصال كل وارث قدر استحقاقه.(@)(@@) وغايتها: الاقتدار على ذلك وإيجاده، وما عنه البحث فيه، هو مسائله.(@)(@@) واستمداده من أصول الشرع، كذا في: (أقدار الرائض) .(@)(@@) واختلف في قوله - عليه الصلاة والسلام -: أنها نصف العلم.(@)(@@) فقال طائفة، سماهم في (ضوء السراج) ، وغيره، وهم أهل السلامة: لا ندري، وليس علينا ذلك، بل يجب علينا اتباعه، عقلنا المعنى، أولم نعقل، لاحتمال خطأ التأويل.(@)(@@) وأول الآخرون على: أربعة عشر قولا.(@)(@@) الأول: سماها: نصف العلم، (باعتبار) البلوي، رواه البيهقي.(@)(@@) الثاني: لأن الخلق بين طوارئ الحياة والممات.(@)(@@) قاله في (النهاية) ، وعليه الأكثرون.(@)(@@) الثالث: لأن سبب الملك: اختياري، وضروري.(@)(@@) فالاختيار: كالشراء، وقبول الهبة، والوصية.(@)(@@) والضروري: كالإرث، قال صاحب (الضوء) ، وغيره.(@)(@@) الرابع: 
ms1199	 تعظيما لهما.(@)(@@) كذا في: (الابتهاج) .(@)(@@) الخامس: لكثرة شعبها، وما يضاف إليها من الحساب.(@)(@@) قاله: صاحب (إغاثة اللهاج) .(@)(@@) السادس: لزيادة المشقة.(@)(@@) قاله: نزيل حلب.(@)(@@) السابع: باعتبار العلمين.(@)(@@) لأن العلم نوعان:(@)(@@) علم: يحصل به معرفه الأسباب، وهو سائرها (معرفة أسباب الإرث) .(@)(@@) وعلم: يعرف به جميع ما يجب.(@)(@@) قاله صاحب: (الضوء) ، وغيره.(@)(@@) الثامن: باعتبار الثواب.(@)(@@) لأنه يستحق الشخص بتعليم مسألة واحدة من فرائض: مائة حسنة.(@)(@@) وبتعليم مسألة واحدة من الفقه: عشر حسنات.(@)(@@) ولو قدرت جميع الفرائض: عشر مسائل.(@)(@@) وجميع الفقه: مائة مسألة.(@)(@@) يكون حسنات كل واحد منها: ألف حسنة.(@)(@@) وحينئذ تكون الفرائض باعتبار الثواب: مساوية لسائر العلوم.(@)(@@) التاسع: باعتبار التقدير.(@)(@@) يعني: أنك لو بسطت(@)(@)(@@)(@@)(@@) || AUTO علم الفرائض(@)(@)(@@) كل البسط، لبلغ حجم فروعه حجم (2/ 1245) فروع سائر الكتب.(@)(@@) كما في: (شرح السراجية) .(@)(@@) العاشر: سماها: نصف العلم.(@)(@@) ترغيبا لهم في تعلم هذا العلم، لما علم أنه أول علم ينسى وينتزع من بين الناس.(@)(@@) وورد أنها: ثلث العلم.(@)(@@) وفي الجمع بينهما: أجاب ابن عبد السلام المالكي، في (شرحه لفروع ابن الحاجب) : إن الجمع ليس واجبا على الفقيه.(@)(@@) قال الإمام، أبو منصور: عبد القاهر بن طاهر.(@)(@@) المتوفى: سنة 429، تسع وعشرين وأربعمائة.(@)(@@) في كتابه: (الرد على الجرجاني) .(@)(@@) في ترجيح مذهب أبي حنيفة: أنه أدعى تقدمهم في الفرائض، ونقض: بسعيد بن جبير، وعبيدة السلماني، والشعبي، والفقهاء السبعة.(@)(@@) ثم نشأ من بعدهم: قبيصة بن ذؤيب، وأبو الزناد.(@)(@@) وفي زمن أبي حنيفة: كان ابن أبي ليلى، وابن شبرمة، قد صنفا في الفرائض.(@)(@@) ولأصحاب: مالك، والشافعي، أيضا كتب، منها:(@)(@@) (كتاب أبي ثور) .(@)(@@) و (كتاب الكرابيسي) .(@)(@@) و (كتاب) ، رواه الربيع عن الشافعي.(@)(@@) وأبسط الكتب فيها:(@)(@@) كتب: أبي العباس بن سريج.(@)(@@) وأبسط من الجميع:(@)(@@) (كتاب: محمد بن نصر المروزي) .(@)(@@) وماصنف فيها: أتقن، وأحكم منه.(@)(@@) وحجمه: يزيد على الخمسين جزءا.(@)(@@) قال: وكتابنا في الفرائض يزيد على: ألف ورقة.(@)(@@) قال ابن السبكي:(@)(@@) وهو: كتاب جليل القدر، لا مزيد على حسنه. انتهى.(@)(@)PageV02P1244(@)(@)(@@)(@@)(@@) || AUTO فرائض: ابن عبد البر(@)(@)(@@) يوسف بن عبد الله القرطبي.(@)(@@) المتوفى: سنة 463، ثلاث وستين وأربعمائة.(@)(@)(@@)(@@)(@@) || AUTO 
ms1200	 فرائض: أبي الرشيد(@)(@)(@@) مبشر بن أحمد بن علي بن أحمد الحاسب، الرازي، الشافعي.(@)(@@) المتوفى: سنة 589، تسع وثمانين وخمسمائة.(@)(@@) وهو على: مذهب الشافعي، ومالك.(@)(@)(@@)(@@)(@@) || AUTO فرائض: ابن اللبان(@)(@)(@@) محمد بن عبد الله المصري.(@)(@@) المتوفى: سنة 402، اثنتين وأربعمائة.(@)(@@) وهي: ثلاث نسخ.(@)(@@) إحداها: (الإيجاز) .(@)(@)(@@)(@@)(@@) || AUTO فرائض: ابن الملا(@)(@)(@@) أحمد بن محمد الحلبي.(@)(@@) المتوفى: في حدود سنة 1090، تسعين وألف.(@)(@)(@@)(@@)(@@) || AUTO فرائض: أبي نصر(@)(@)(@@) أحمد بن محمد بن علي البغدادي، الحنفي.(@)(@@) وهو: كتاب كبير.(@)(@@) في مجلد.(@)(@@) جمع فيه: أصول مسائل الفرائض.(@)(@@) وذكر فيه: فوائد كثيرة.(@)(@)(@@)(@@)(@@) || AUTO فرائض الأشنهية(@)(@)(@@) لأبي الفضل: عبد العزيز بن علي الأشنهي، الشافعي.(@)(@@) المتوفى: في حدود سنة 550، خمسين وخمسمائة.(@)(@@) وهو: (كتاب الكفاية) .(@)(@@) على ما وجدته في ظهر نسخة، وليس فيه تسمية.(@)(@@) أوله: (2/ 1246) (أما بعد حمدا لله وصلواته ... الخ) .(@)(@@) وبعد، فإني خرجت:(@)(@@) (مختصرا) .(@)(@@) في الفرائض.(@)(@@) وعريته من: الخلاف.(@)(@@) أوله: (الحمد لله حق حمده ... الخ) .(@)(@@) كتب أولا: (مختصرا في الفرائض) .(@)(@@) ثم أتبعه: بالولاء، وقسم التركات.(@)(@@) وأردف ذلك: بالوصايا، والمسائل الملقيات.(@)(@@) شرحها:(@)(@@) عبد الرحمن بن محمد الرشيدي، المصري.(@)(@@) المتوفى: سنة 803، ثلاث وثمانمائة.(@)(@@) وفيه: أوهام كثيرة.(@)(@@) ومن شروحها:(@)(@@) (الأنوار البهية) .(@)(@@) لمحمد بن محمد بن محمد الشعسي.(@)(@@) المتوفى: سنة ...(@)(@@) أوله: (الحمد لله الذي حكم بالموت على جميع الأنام ... ) .(@)(@@) وهو: شرح مفيد، بقال، أقول.(@)(@@) وأفرد: ابن حجر في حسابه: (الرسالة العزية) .(@)(@)PageV02P1245(@)(@)(@@)(@@)(@@) || AUTO فرائض: أيوب البصري(@)(@)(@@) وهو: أبو بكر: أيوب بن أبي نميمة السجستاني، البصري، التابعي.(@)(@@) المتوفى: سنة 131.(@)(@)(@@)(@@)(@@) || AUTO فرائض: بركلي(@)(@)(@@) وهو: المولى: محمد بن بير علي.(@)(@@) المتوفى: سنة 981، إحدى وثمانين وتسعمائة.(@)(@@) وشرحها: له أيضا.(@)(@)(@@)(@@)(@@) || AUTO فرائض: التركماني(@)(@)(@@) وهو: أحمد بن عثمان بن صبيح الجوزجاني، الحنفي.(@)(@@) المتوفى: سنة 744، أربع وأربعين وسبعمائة.(@)(@@) وهي: نسختان.(@)(@)(@@)(@@)(@@) || AUTO فرائض: التمرتاشي(@)(@)(@@) هو: ظهير الدين: أحمد بن إسماعيل التمرتاشي، الخوارزمي، الحنفي.(@)(@@) المتوفى: في حدود سنة 600.(@)(@)(@@)(@@)(@@) || CHECK الفرائض الجعدية على مذهب المالكية(@)(@)(@@) الفرائض الجعدية، على مذهب المالكية(@)(@@) للشيخ، الإمام، أبي محمد: الحسن بن علي بن الأجعد الصقلي، المالكي.(@)(@)(@@)(@@)(@@) || CHECK فرائض: جمال الأئمة. . . الكردلاني(@)(@)(@@) فرائض: جمال الأئمة ... الكردلاني(@)(@@) شرحها:(@)(@@) محمد العمادي، من أحفاده.(@)(@)(@@)(@@)(@@) || AUTO فرائض: الحليمي الرومي 