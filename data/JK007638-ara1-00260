ms241	 فقد أطيب معرق % في المجد مفقد طيب الأعراق % % 6(@)(@@) % ذهبا بأيام خطرت مع الهوى % % لوقتك من دمها العفاة بما وقى % % 7(@)(@@) % زمنا لبست حريرها ونضوتها % % عن جدة وأبيك لا الأخلاق % % 8(@)(@@) % فلأندبن اليوم صالح عهدها % % ولأبكين نفائس الأعلاق % % 9(@)(@@) % ولأحلبن من الشجون حشاشتي % % دمعا كمندفق الحيا المهراق % % 10(@)(@@) % أمرقصا دمعي وأخلاقي معا % بنشائد ( الخنساء ) لا ( إسحاق ) % PageV01P827 11(@)(@@) % فرق بأقتلها مجامع أضلعي % % إن المكارم آذنت بفراق % % 12(@)(@@) % قتلت أسى لأغر لولا جوده % % قتل الزمان بنيه من إملاق % % 13(@)(@@) % فأزل بنعيك في الورى رمق الورى % % فالموت زال بممسك الأرماق % % 14(@)(@@) % هذا ' أبو حسن ' استقل مشيعا % لكن بنعش لا متون عتاق % % 15(@)(@@) % ومشت وراء سريره من هاشم % غلب الرقاق خواضع الأعناق % % 16(@)(@@) % متماسكين من الحياء تهافتت % % قطعا قلوبهم من الإقلاق % % 17(@)(@@) % يا راحلا بالصبر حمل قومه % % عبثا من الأرزاء غير مطاق % % 18(@)(@@) % خرجت تمني لو بهاشم كلها % % خرجت وأنت لمجد قومك باقي % % 19(@)(@@) % فلو افتدى بسواه غيرك أو وقى % % من حد أسياف المنية واقي % % 20(@)(@@) % لو قتك من دمعها العفاة بما وقى % % بوفاء ماء سماحك الرقراق % % PageV01P828 21(@)(@@) % ولغيمت بالنقع دونك هاشم % حتى تسد مطالع الآفاق % % 22(@)(@@) % وأتتك ترعد بالصواهل واغتدت % % بالبيض تبرق أيما إبراق % % 23(@)(@@) % ولأمطرت بدم سقت شوك القنا % % منه بأغزر وابل دفاق % % 24(@)(@@) % ولقارعت عنك الردى وشعارها % % أنا من أمر اليوم طعم مذاقي % % 25(@)(@@) % ولأقبلت بك يا عميد سراتها % % والموت بين يديك رهن وثاق % % 26(@)(@@) % وأظن أنك والتكرم شأنكم % % كرما تمن عليه بالإطلاق % % 27(@)(@@) % فيردن أفئدة لهن لظى الجوى % % لم تبق باقية على الإحراق % % 28(@)(@@) % لكن دعيت وأي خلق لم يكن % % ليجيب دعوة قاهر خلاق % % 29(@)(@@) % فمضى الردى بك راغبا بطلاقها % % دنيا تجد تبعلا بطلاق % % 30(@)(@@) % معشوقة وهي الملال وإنها % % لعلى الملال كثيرة العشاق % % PageV01P829 31(@)(@@) % سار على أيد رفعن برفعها % % منك البنان مفاتح الأرزاق % % 32(@)(@@) % اعتقن من رق الزمان كرامه % % فجمعن بين الرق والإعتاق % % 33(@)(@@) % ودعت وقد رفعت عقيرتها العلى % % الله أين بمثقل الأعناق % % 34(@)(@@) % فبرغم أنفى اليوم حطك في الثرى 
ms242	 % % من كنت أرفعه على الأحداق % % 35(@)(@@) % فلو استطعت عن التراب رفعته % % بالوضع بين ترائب وتراقى % % 36(@)(@@) % واها لتربة ذلك الجدث الذي % % فيه دفنت مكارم الأخلاق % % 37(@)(@@) % مصت ندى تلك البنان فأعطشت % % عود الرجاء وكان ذا ايراق % % 38(@)(@@) % إيها صروف الدهر دونك في الورى اب % % تدرى بلا فرق ولا اشفاق % % 39(@)(@@) % غطي التراب على قريعك وابرزي % % في الناس كاشفة لهم عن ساق % % 40(@)(@@) % قدر رمى شجر العلوم بمعطش % فشكت أعاليه جفاف الساق % % PageV01P830 41(@)(@@) % وذوى وزال عن القلوب لفقد من % % قد كان بحرا والقلوب سواقى % % 42(@)(@@) % سلبت نضارته وغودر عن يدي % % طلابه متساقط الأوراق % % 43(@)(@@) % يا نازلا غرف الجنان وبارك ال % % صب المشوق بقاتم الأعماق % % 44(@)(@@) % وفدت عليك صلاة ربك شائقا % منعت إليه وفادة المشتاق % % 45(@)(@@) % فاذهب وحسبك للعلى ' بمحمد ' % فعلاه لا يرقى إليها الراقى % % 46(@)(@@) % عرجت به لسماء فضلك همة % قالت : أجل من البراق براقي % % 47(@)(@@) % هذا الذي ورث النبوة علمها % % ومن الإمامة حل أي رواق % % 48(@)(@@) % ولقد أقول لمن بغاه بضغنه % % أقصر فلست تناله بلحاق % % 49(@)(@@) % عجبا طمعت بمن يروضك عالما % إن القلوب تراض بالإرفاق % % 50(@)(@@) % لا تقربن الصل نضنض مطرقا % فالصل سورته مع الإطراق % % PageV01P831 51(@)(@@) % هو و ( الحسين ) كلاهما قمرا على % % في فتية هم أنجم الآفاق % % 52(@)(@@) % من كل نهاض العزائم حائز % قصب الرهان بيوم كل سباق % % 53(@)(@@) % خطبت لهم بكر العلى وهم لها % % جعلوا جميل الذكر خير صداق % % 54(@)(@@) % فبنوا بخير عقيلة ما راعها % % صرف النوائب منهم بطلاق % % 55(@)(@@) % لولاهم غدت القلوب كمضغة % بلهى الخطوب تلاك بالأشداق % % 56(@)(@@) % ولأطبقت ظلم الرزية واختفى % % ضوء السلو بذلك الإطباق % % 57(@)(@@) % فهم البدور تفاوتت بطلوعها % % في المجد لا في التم والإشراق % % 58(@)(@@) % المجد أطلعها وقال معوذا % لا نيل باهر مجدكم بمحاق % % PageV01P832 البحر : طويل 1(@)(@@) % أرى الأرض قد مادت لأمر يهولها % % فهل طرق الدنيا فناء يزيلها ؟ % 2(@)(@@) % وأسمع رعدا قد تقصف في السما % % لمن زمر الأملاك قام عويلها ؟ % 3(@)(@@) % تأمل فأما الساعة اليوم فاجأت % % وأما التي في العالمين عديلها % % 4(@)(@@) % وإلا فما الدهر 
ms243	 راع حشا الورى % % بتقطيبه منها عراها ذهولها ؟ % 5(@)(@@) % بلى طرقت أخت القيامة بغتة % وتلك التي للحشر يبقى غليلها % % 6(@)(@@) % لها صعدت بالحزن للعرش رنة % بأعلى بيوت الوحي كان نزولها % % 7(@)(@@) % نحت في رواق المجد صدرا من العلى % % يروع ملوك الأرض فيه مئولها % % 8(@)(@@) % ومالت بأرسى هضبة ما تصورت % % جحاجح فهر أن ترى ما يميلها % % 9(@)(@@) % فدى لعميد الغالبين كلها % % وأي فريد لو فداه قبيلها % % 10(@)(@@) % إذا لافتدت طودا لها ما تعلقت % % بقنته للكاشحين وعولها % % PageV01P833 11(@)(@@) % فإن ' معز الدين ' من سل دونه % % صوارم لا يخشى عليها فلولها % % 12(@)(@@) % وقارع حتى كل مضاء فكرة % ثناه بحد القول وهو كليلها % % 13(@)(@@) % وراش نبالا لم تفت مقتل العدى % % وأقتل سهم ما يريش نبيلها % % 14(@)(@@) % وسدد من أقلامه السمر صعدة % بصعداتها للسمر قصر طولها % % 15(@)(@@) % فأدرك ما لا تدرك الشوس بالقنا % % ونال بها ما لم تنله نصولها % % 16(@)(@@) % أكالئ ثغر الدين قد عثر الردى % % بيومك لكن عثرة لا نقيلها % % 17(@)(@@) % لأرخى يمينا منك شد قوى الهدى % % وغمض عينا بالحفاظ تجيلها % % 18(@)(@@) % فمن مخبري كيف انتحتك منية % بطرفك لو ترمى لعز وصولها ؟ % 19(@)(@@) % أأنحلها خوف التقحيم إذ مشت % % إليك فأخفاها عليك نحولها ؟ % 20(@)(@@) % أم اقتادك التسليم لله طائعا % وهل طاعة إلا وأنت فعولها ؟ % PageV01P834 21(@)(@@) % ورزئك ما هذي الدموع وإن جرت % % بماء ولا هذي السيول سيولها % % 22(@)(@@) % ولكن حشاشات على الشوق لم تزل % % تذوب إلى أن جاءها ما يسيلها % % 23(@)(@@) % ستبكيك ما ناح ابن ورقاء أعين % بفضلك من حيث التفتنا نجيلها % % 24(@)(@@) % نرى لك آثار الغمامة لاطفت % % ثرى الأرض حتى روضته هطولها % % 25(@)(@@) % ' أبا صالح ' ما العيش بعدك صالحا % لنفس هواها عنك لا يستميلها % % 26(@)(@@) % عفاء على ' الفيحاء ' بعدك وحدها % % وإن غال كل الأرض بعدك غولها % % 27(@)(@@) % لقد لبست فيك الجمال وإنما % % عليك تعرى اليوم عنها جميلها % % 28(@)(@@) % غدت ثاكلا تشجى بنيها وطالما % % زهت فاجتلتها كالعروس بعولها % % 29(@)(@@) % نعاك لها ناع إليك أطارها % % بدهياء راع الخافقين حلولها % % 30(@)(@@) % أتت لك تشكو اليتم فيك بأدمع % لها صنتها دهرا 
ms244	 فأضحت تذيلها % % PageV01P835 31(@)(@@) % وشرفتها ميتا بحملك ضعف ما % % رأتك من التشريف حيا تنيلها % % 32(@)(@@) % إصاح إلى جنبي قف اليوم ممسكا % علي حشا حان الغداة رحيلها % % 33(@)(@@) % فقد كنت قبل اليوم أعهد لي يدا % هي اليوم لا مني فأنت بديلها % % 34(@)(@@) % أزل بالنعي الراسيات فقد سرى % % يخف على أيدي الرجال ثقيلها % % 35(@)(@@) % وما خف لما أن تساوى بحمله % % حقير الورى فوق الثرى وجليلها % % 36(@)(@@) % ولكن سرى الأملاك فيه يؤمهم % % بتكبيره فوق السما جبرئيلها % % 37(@)(@@) % وغبراء من حثو التراب قد احتبى % % بقاتمها حزن الفلا وسهولها % % 38(@)(@@) % مرت ماءها الأنفاس في صعداتها % % فسالت وأسراب الدموع سيولها % % 39(@)(@@) % تدانى بها منا ابن نعي يلوثها % % على وجهه طورا وطورا يذيلها % % 40(@)(@@) % فقمنا له نخفي الذي منه هالنا % % وهل طلعة للشر يخفي مهولها ؟ % PageV01P836 41(@)(@@) % وقلنا زعيم الطالبيين أحدقت % % بجنب علاه شيبها وكهولها % % 42(@)(@@) % قضى حجة واستأنف السير فانبرت % % تعطف منه حول فحل فحولها % % 43(@)(@@) % وهذا بشير لو وهبنا نفوسنا % % لقلت له والفضل منه قبولها % % 44(@)(@@) % فلما ألم استلها من لسانه % % صفيحة نعي كل قلب قتيلها % % 45(@)(@@) % شكت عندها الأسماع وقرا أصمها % % وما وقر الأسماع إلا صليلها % % 46(@)(@@) % وقال امسحوها اليوم عمياء من جوى % بشلاء فيها لم يككف همولها % % 47(@)(@@) % فذاك على الأعواد سيد هاشم % بجنب العلى منه مسجى كفيلها % % 48(@)(@@) % وذي هاشم جاءت بأثقال همها % % ومهديها محمولة لا حمولها % % 49(@)(@@) % نضتها السرى أسياف مجد صقيلة % وعادت وفي قلب المعالي فلولها % % 50(@)(@@) % مضت بأب للمكرمات يؤمها % % وكان بأم النائبات قفولها % % PageV01P837 51(@)(@@) % أما وسرير تحته قد تزاحمت % % فطاشت كما طاشت خطاها عقولها % % 52(@)(@@) % لقد هالها الإقدام فيه لتربة % على روحها بالراحتين تهيلها % % 53(@)(@@) % فقد قبرت في اللحد واحد عصرها % % وأقسم ما المقبور إلا قبيلها % % 54(@)(@@) % تجللتها يا دهر سوداء فانطوت % % عليك ليوم النشر تضفو ذيولها % % 55(@)(@@) % خطمت بها قسرا عرانين هاشم % فقدها تساوى صعبها وذلولها % % 56(@)(@@) % وقل لعوادي الحتف شأنك والردى % % 57(@)(@@) % فما جولة عند الردى فوق هذه % % فنخشاه يوما في كريم يجولها % % 58(@)(@@) % ويا رافعيه في الأكف 
ms245	 نصبتم % بها علما يشأى العلى ويطولها % % 59(@)(@@) % قفوا وانظروا كيف الورى لو تحاشدت % % وضاق بأبناء السبيل سبيلها % % 60(@)(@@) % تشيع نعشا ليس تدري إمامها % % إلى القبر محمول به أم رسولها ؟ % PageV01P838 61(@)(@@) % فتى طبق الدنيا علاء وعمها % % سخاء وأبقى بعده من يعولها % % 62(@)(@@) % كفى خلفا منه بأشبال مجده % % وهل تخلف الآساد إلا شبولها ؟ % 63(@)(@@) % مصابيح رشد والمصابيح في الورى % % يكون إليها ليس عنها عدولها % % 64(@)(@@) % فشمس الهدى والأمر لله إن تغب % وراع الورى شرقا وغربا أفولها % % 65(@)(@@) % فدونكها موروثة نبوية % وخلفك باغيها فللأسد غيلها % % 66(@)(@@) % إمامة حق إن تكن أمس ودعت % % أباها فعند اليوم ناب سليلها % % 67(@)(@@) % ستعلم رواد الشريعة إذ جرت % % بسلسل علم فيك ما سلسبيلها % % 68(@)(@@) % لقد سمعت بالوحي تنزيل آيها % % وسوف ترى من فيك كيف نزولها % % 69(@)(@@) % ألا إنما العليا قواعد سؤدد % لك الله أرساها فمن ذا يزيلها % % 70(@)(@@) % ومجد قدامى الفخر مد على الورى % % سماء لها عرض السماء وطولها % % PageV01P839 71(@)(@@) % عفاة الورى لا يقعد اليأس فيكم % % فأثقال أهل الأرض قام حمولها % % 72(@)(@@) % أبل بني فهر لواشجة حشا % إذا الشتوة الغبراء هب بليلها % % 73(@)(@@) % أتى باليد البيضاء تقطر نعمة % وبالطلعة الغراء يبهى جميلها % % 74(@)(@@) % لقد جاء في عصر به عقر الندى % % سوى مذقة يعي الرجاء حصولها % % 75(@)(@@) % فما هو إلا ' صالح ' و ' ثموده ' % وبالجود إلا ناقة وفصيلها % % 76(@)(@@) % أنر يا ' أبا الهادي ' دجى كل مشكل % % فما شبهة إلا وأنت مزيلها % % 77(@)(@@) % وأمطر بنانا يا ' محمد ' في الورى % % وقد روضوا حالا توالت محولها % % 78(@)(@@) % فاقسم لو لم ترو عاطشة المنى % % لدب بأغصان الرجاء ذبولها % % 79(@)(@@) % صنايع من عرف لنا بك فخرها % % وللناس مشكورا لديك جزيلها % % 80(@)(@@) % قد اكتست الدنيا فتاهت بزهوها % % خلائق أخلاق الرجال سمولها % % PageV01P840 81(@)(@@) % إذا استبقت فهر بفخرك في مدى % غدت غرر العليا لها وحجولها % % 82(@)(@@) % وليس الخطاب الفصل إلا مقالة % % لسان قريش وهو أنت قؤولها % % 83(@)(@@) % بك ارتاش عافيها وقر مروعها % % وأدنى قاصيها وعز ذليلها % % 84(@)(@@) % وما قصرت باع العلى عن رزية % رغت كرغاء المثقلات نكولها % % 85 
ms246	(@)(@@) % وذا ' صالح ' الدنيا وأنت كلاكما % % تمدان منها و ' الحسين ' مطيلها % % 86(@)(@@) % فتى لا أقول الغيث يحكي بنانه % % سماحا لأن الغيث فيه عذولها % % 87(@)(@@) % شمائله تحكى النسيم لطافة % وأخلاقه الصهباء رقت شمولها % % 88(@)(@@) % بنى الغالبيين الذين أكفهم % % تريك الغوادي الغر كيف مخيلها % % 89(@)(@@) % ألستم لقوم تملأ الأرض رجفة % إذا هي للهيجاء سار رعيلها ؟ % 90(@)(@@) % ضراغم تخشى رقدة الموت من غفا % % إذا استيقظت للضرب يوما نصولها % % PageV01P841 91(@)(@@) % يطول نعي الثاكلات لقومها % % إذا صهلت للطعن شوقا خيولها % % 92(@)(@@) % بها ليل أما هجرت يوم معرك % فتحت ظبات المشرفي مقيلها % % 93(@)(@@) % لها الحرب لم تبرح تقلل عدها % % ويكثر في عين العدو قليلها % % 94(@)(@@) % لكم صبرها تحت السيوف وحلمها % % إذا نوب الدهر ارجحن جليلها % % 95(@)(@@) % فما شيمة الحساد فيكم وليتها % % عفت كعفو المجد منها طلولها % % 96(@)(@@) % وقدركم في الموت يعلو نباهة % وما الموت كل الموت إلا خمولها % % 97(@)(@@) % ألا أنتم القوم الذين قبابهم % % على شهب الخضراء ترخي سدولها % % 98(@)(@@) % فروع على لا يدرك الوهم طائرا % سوى إنها فوق السماء أصولها % % 99(@)(@@) % لها فوق أهل الأرض مجد تكافأت % % عمومتها في فخره وخؤولها % % 100(@)(@@) % خذوها بني العلياء ' خنساء ' عصرها % % وإلا فبنت الدوح مر غليلها % % PageV01P842 101(@)(@@) % فلو أنها ناحت لصخر ارتكه % % 102(@)(@@) % لها قرب عهد بالولادة لا تخل % % أتى قبل أو من بعد يأتي مثيلها % % 103(@)(@@) % تطول قوافي الشعر منها قصيدة(@)(@@) % زهير ) بحولياته لا يطولها % % 104(@)(@@) % ألا إنما يبقى الهدى ببقائكم % % فسؤل المعالي أن تدوم سؤولها % % PageV01P843 البحر : كامل تام 1(@)(@@) % عودي بطرفك يا قريش كليلا % % وبعزمك امتلأت ظباه فلولا % % 2(@)(@@) % فعلى الرؤوس رفعت فخرك ميتا % % ودفنت مجدك في الصعيد أثيلا % % 3(@)(@@) % واها لكاهلك الأجب لقد شآ % % وقرا على ظهر الزمان ثقيلا % % 4(@)(@@) % خفت حلوم بني أبيك بساعة % ذهبت بحامل ثقلها محمولا % % 5(@)(@@) % بمقلب وسط الندى أناملا % لم تدر إلا الرفد والتقبيلا % % 6(@)(@@) % نسيت به الأرزاء بل ذكرت به % % رزء ( الحسين ) غداة خر قتيلا % % 7(@)(@@) % رفعته والتكبير بالعشر التي % % قتلوا بها التكبير والتهليلا % % PageV01P844 البحر : متقارب تام 1(@)(@@) % هموم نوى البرء 
ms247	 منها ارتحالا % % فلا تبعث الداء إلا عضالا % % 2(@)(@@) % وطفل الأسى لم يجد من رضاع % % حشا حالب الفضل يوما فصالا % % 3(@)(@@) % عفاء على الدهر من ناقص % على الكاملين تجنى خبالا % % 4(@)(@@) % أجال عليهم خيول الخطوب % % ولو مثلت لاستقالوا قبالا % % 5(@)(@@) % ولو عرف الدهر قدر الكرام % % لكف غداتئذ ما أجالا % % 6(@)(@@) % غزاني بملمومة النائبات % % وعاد بإنسان عيني نفالا % % 7(@)(@@) % فروع سمعي بصوت النعي % ورنق من صفو وردي سجالا % % 8(@)(@@) % فبت وفي مقلتي عائر % حمى جفنها بالكرى الاكتحالا % % 9(@)(@@) % وقائلة ليس سمعي لها % % وبعض المقال أراه محالا % % 10(@)(@@) % أجدك من عاتب ما تزال % % تذم من الدهر هذي الخصالا % % PageV01P845 11(@)(@@) % أقل عثرة الدهر أو لا تقل % % فليس يبالي بأن لا يقالا % % 12(@)(@@) % أتجزع للبين مستثقلا % وأنت حجى تستخف الجبالا ؟ % 13(@)(@@) % تماسك ولا تبذل أدمعا % حماها وقارك عن أن تذالا % % 14(@)(@@) % فقلت وعيني أسى تستهل % كمحتفل الودق مرخي العزالا % % 15(@)(@@) % أآمنة السرب كفى الملام % ضلالا لرأيك مني ضلالا % % 16(@)(@@) % فما نفحة من رياض الصبا % % لها أرج للقلوب استمالا % % 17(@)(@@) % بأطيب من تربة ضمنت % على رغم أنفى مني هلالا % % 18(@)(@@) % نشدتك يا دهر ألا أعرت % مسامعك اليوم مني مقالا % % 19(@)(@@) % أعن سفه منك للأكرمين % % تركب غدرك حالا فحالا % % 20(@)(@@) % وتزجى الخطوب ثقالا لكي % % لهم تستخف حلوما ثقالا % % PageV01P846 21(@)(@@) % وأنى يزاول نمل القرى % % جبال شرورى فتخشى زيالا ؟ % 22(@)(@@) % وتعجم يا دهر في ما ضغيك % % من عود علياهم ما استطالا % % 23(@)(@@) % وهل زبرة عضها أدرد % فآثر أو نال منها منالا % % 24(@)(@@) % تعلم لك السوء من ناقص % عدا طوره وتمنى محالا % % 25(@)(@@) % بأن الأماجد صبر ولو % % بدهتهم بالخطوب اغتيالا % % PageV01P847 البحر : خفيف تام 1(@)(@@) % كل يوم يسومني الدهر ثكلا % % ويريني الخطوب شكلا فشكلا % % 2(@)(@@) % وبصبري يجد خلف حبيب % منه طرفي لا القلب يخلو محلا % 3(@)(@@) % أودع الأرض شخصه ثم أدعو % % أين ركب المنون فيك استقلا % 4(@)(@@) % يا عذولى صبابتي علماني % % كيف تسلى الهموم لا كيف تسلى ؟ ! % 5(@)(@@) % خلياني من مورد الصبر إني % % قد وردت الأشجان علا ونهلا % % 6(@)(@@) % كم أخ 
ms248	 شد ساعدي بأخيه % % بعده قد صحبت باعا أشلا % 7(@)(@@) % وقريب إلي أبعده الموت % وكم أبعدت يد الموت خلا % 8(@)(@@) % وعزيز علي أرخص دمعي % % وهو عندي من نور عيني أغلى % % 9(@)(@@) % أخوتي اخوة الصفا درجتم % % فبمن لا بمن همومي تجلى % % 10(@)(@@) % مضنى فقدكم ولا كفقيد % كبر الخطب فيه عندي وجلا % PageV01P848 11(@)(@@) % إن تكن بعضت نواكم فؤادي % % فنواه مضت به اليوم كلا % 12(@)(@@) % يا دفينا بتربة تخذتها % % أعين الحور موضع الكحل كحلا % % 13(@)(@@) % ثكل أم القريض فيك عظيم % ولام الصلاح أعظم ثكلا % % 14(@)(@@) % ما عركن الخطوب صبرك إلا % % حسبت أنها جلت لك نصلا % % 15(@)(@@) % قد لعمري أفنيت عمرك نسكا % وشحنت الزمان فرضا ونفلا % % 16(@)(@@) % وطويت الأيام صبرا عليها % % فتساوت عليك حزنا وسهلا % % 17(@)(@@) % طالما وجهك الكريم على الله % % به قوبل الحيا فاستهلا % 18(@)(@@) % إن تعش عاطلا فكم لك نظم % بات جيد الزمان فيه محلى % % 19(@)(@@) % ولك السائرات شرقا وغربا % % جئن بعدا ففتن ما جاء قبلا % % 20(@)(@@) % كم قرعن الأسماع بيتا فبيتا % % فأفضن العيون سجلا فسجلا % % PageV01P849 21(@)(@@) % كنت أخلصت نية القول فيها % % فجزاك ' الحسين ' عنهن فعلا % % 22(@)(@@) % فهي الصالحات بعدك تبقى % % بلسان الزمان للحشر تتلى % % 23(@)(@@) % يا أمنت الروائع أنعم بدار % قد أعدت للمتقين محلا % % 24(@)(@@) % أنت أهل وقد علمت بأن لي % % س يضيع الباري لمثلك أهلا % % 25(@)(@@) % ها هم قد تفيأوا ظل من كا % % ن على العالمين لله ظلا % 26(@)(@@) % ذاك ( مهدي ) شرعة الحق وال % % قائم فيها بالصدق قولا وفعلا % % 27(@)(@@) % من إذا جاد واهبا جاد وبلا % وإذا قال ناطقا قال فصلا % % 28(@)(@@) % أسد رشح الإله بنيه % % لعرين الآساد شبلا فشبلا % % 29(@)(@@) % علماء الهدى دعائم دين الل % ه حفاظه وناهيك فضلا % % 30(@)(@@) % وسقى الله ' صالحا ' غيث لطف % بشآبيب عفوه مستهلا % % PageV01P850 البحر : مخلع البسيط 1(@)(@@) % لو برد العذل من غليلي % % لم أحم سمعي عن العذول % % 2(@)(@@) % لام خلي الحشا فقلبي % % ملآن من دائي الدخيل % % 3(@)(@@) % أثكلني الدهر وهو لاه % لم يدر ما لوعة الثكول % % 4(@)(@@) % لو صدعت نكبتي حشاه % % إذا كسا جسمه نحولي 
ms249	 % % 5(@)(@@) % يقول ما لي أراك حزنا % تحن كالواله العجول % % 6(@)(@@) % تعز إن العزاء أولى % % بشيمة الكامل النبيل % % 7(@)(@@) % فقلت عني وهل لغيري % % يالأئمى رنة العويل ؟ % 8(@)(@@) % قلبي بالصبر كان سيفا % وامتلأ اليوم بالفلول % % 9(@)(@@) % معللي بالعزاء رفقا % تحنو على قلبي العليل % % 10(@)(@@) % كذبت لو قد عناك وجدي % % ما نمت عن ليلى الطويل % % PageV01P851 11(@)(@@) % أسأل عن صبري الجميل % % بعد افتقادي ( أبا خليل ) % 12(@)(@@) % قضى بحجر النهى عزيزا % والموت ضرب من الخمول % % 13(@)(@@) % ولم تغمض له جفونا % إلا يدا مجده الأثيل % % 14(@)(@@) % وغسلته العلى وقالت : % بوركت من طاهر غسيل % % 15(@)(@@) % ثم نعت : أيها المسجى % % والحمد في برده الجميل % % 16(@)(@@) % أما ترى ( أحمدا ) ينادي % % يا مقلتي في الدموع سيلي % % 17(@)(@@) % ومنك ينعى على نجيب % قرم لأثقاله حمول % % 18(@)(@@) % يقول يا منهضي برفق % من عثرة الدهر من مقيلي % % 19(@)(@@) % أصول فيمن على زماني % % يا دافني سيفي الصقيل % % 20(@)(@@) % وهذه المكرمات تنعي % % فتخلط النعى بالعويل % % PageV01P852 21(@)(@@) % قد حملوا واحدي بنعش % خف بعبء النهى الثقيل % % 22(@)(@@) % يا راحلا للبلى إلى من % % بعدك بين الورى رحيلي % % 23(@)(@@) % منك رباع العلى برغمي % % خلت ورغم الحجى الأصيل % % 24(@)(@@) % زهت زمانا بها الليالي % % والسعد في ظلها الظليل % % 25(@)(@@) % وغر أيامها حسان % تمر وضاحة الحجول % % 26(@)(@@) % والناس من رائح وغاد % يثنى بمعروفها الجزيل % % 27(@)(@@) % واليوم ذاك الثناء أضحى % % نوحا على رزئه الجليل % % 28(@)(@@) % كنت ' لشبلي ' أمس أنعى % % واليوم أنعي أبا الشبول % % 29(@)(@@) % تتابعوا للمنون عني % % تتابع الشهب للافول % % 30(@)(@@) % جفاهم الدهر بعد وصل % والدهر كالعاشق الملول % % PageV01P853 31(@)(@@) % لم يبق إلا القليل منهم % % والخير في ذلك القليل % % 32(@)(@@) % فروع مجد شذا علاهم % % يشهد بالطيب للاصول % % 33(@)(@@) % من ' أحمد ' قدره علي % ومن أخ للنهى خليل % % 34(@)(@@) % قبيلة المجد من سواكم % % لم يعرف المجد من قبيل % % 35(@)(@@) % عذرا إذا لم أقل عزاء % ما هذه قولة الثكول % % 36(@)(@@) % وطاب قبر به توارى % ' محمد ' ذو الحجى الأصيل % % 37(@)(@@) % أغناه ما فيه من سماح % عن سقى جفن الحيا البخيل % % PageV01P854 البحر : طويل 1(@)(@@) % وقفت على ' الزوراء ' وهي يتيمة 
ms250	 % تحن لمن أبقى المعالي ثواكلا % % 2(@)(@@) % فتنعاه طورا للفواضل والنهى % % وطورا له تنعى النهى والفواضلا % % PageV01P855 البحر : متقارب تام 1(@)(@@) % بكائي بعيني لم يكفني % % لمن قطع الدهر فيه وتيني % % 2(@)(@@) % فليت توزع دمعي الأنام % لأبكي عليه بكل العيون % % PageV01P856 البحر : طويل 1(@)(@@) % فقلت على من رنة النوح والبكا % % فقالت على من لا ترى الدهر مثله % % 2(@)(@@) % أليس أبى ذلك الذي تعهدونه % % طوت نوب الأيام عني ظله % % 3(@)(@@) % فقلت وعندي من فؤادي بقية % % خذي يا يد الأحزان قلبي كله % % PageV01P857 البحر : سريع 1(@)(@@) % عادت مراثى تهنيات العلى % % ينصدع القلب بإنشادها % % 2(@)(@@) % قد رحل اليوم سرور الورى % % فلتلمسه يوم ميعادها % % 3(@)(@@) % قد دفنت تحت الثرى عيدها % % وأبقت النحر لأكبادها % % 4(@)(@@) % فلا ازدهاها يوم ( نوروزها % % ولا أتى ( الفطر ) باسعادها % % PageV01P858 البحر : بسيط تام 1(@)(@@) % يا دهر ما شئت فاصنع هان ما عظما % % هذا الذي للرزايا لم يدع ألما % % 2(@)(@@) % رزء تلاقت رزايا الدهر فاجتمعت % % فيه فهون ما يأتي وما قدما % % 3(@)(@@) % ما بال ام الليالي فيه قد حملت % % فليتها وأبا أيامها عقما % % 4(@)(@@) % لقد تحكم في الدنيا فنال بها % % من النواظر والأحشاء ما احتكما % % 5(@)(@@) % عجت ولا كعجيج الموقرات به % % وهل تلام وهذا ظهرها انقصما % % 6(@)(@@) % مضى الذي طبقتها كفه نعما % فطبقتها الليالي بعده نقما % % 7(@)(@@) % الآن غودرت الآمال حائمة % وأين في الدهر منها من يبل فما ؟ % 8(@)(@@) % وقبة المجد قد مالت ولا عجب % فإن أثبت أركان العلى انهدما % % 9(@)(@@) % فلينتظم مأتما عمر الزمان لمن % % بالصالحات جميعا عمره انتظما % % 10(@)(@@) % ولتحتلب عينها الدنيا لمن يده % % كانت حلوبة جود تقتل الأزما % % PageV01P859 11(@)(@@) % وكيف تسأم من دمع تتابعه % % ومن متابعة النعماء ما سئما % % 12(@)(@@) % في الكف ما زرعت حسن الرجاء له % % إلا وأمطرها من كفه كرما % % 13(@)(@@) % يا آخذا كل قلب في ملامته % % دع الملام وشاطرني الدموع دما % % 14(@)(@@) % واقرع بلومك سمع الدهر حيث أتى % % برنة تركته يشتكى الصمما % % 15(@)(@@) % طويت من يستظل المعدمون به % % فليت يا دهر قسرا ظلك انعدما % % 16(@)(@@) % هل يعلم الزمن الغدار لا علما % % ماذا 
ms251	 به هجم المقدار لا هجما ؟ % 17(@)(@@) % فأي رزء بأي الناس يكبر في % % صدر الأنام سوى هذا الذي دهما ؟ % 18(@)(@@) % أفي ذوي الحلم فالثاوي زعيمهم % % أم في بني العلم فالثاوي أبو العلما ؟ % 19(@)(@@) % أم في الأنام جميعا فالذي افتقدوا % % هو الذي جمعت أبراده الأمما ؟ % 20(@)(@@) % بل كل ميت له ثلم بحوزته % % لكن في موته الإسلام قد ثلما % % PageV01P860 21(@)(@@) % قام النعي على ' دار السلام ' له % % فقلت بعدك ليت الكون ما سلما % % 22(@)(@@) % ما زال بشرك بالعفين ملتمعا % حتى تحول في أحشائهم ضرما % % 23(@)(@@) % وإن بكتك فلا من عليك لها % % بماء جودك جاري جفنها انسجما % % 24(@)(@@) % هذه الدموع بقايا ماء عيشهم % % من فضل ما كنت توليهم عليك همي % % 25(@)(@@) % إن لم تفض بك عن وجد نفوسهم % % فسوف بعدك من قرب تفيض ظما % % 26(@)(@@) % يا راحلا ولسان الحال ينشده % % وللمقال لسان بالأسى انعجما % % 27(@)(@@) % واها ' أبا المصطفى ' ماذا يقول فمي % % وما البلى منك أبقى للجواب فما % % 28(@)(@@) % الموت حتم وإن كان المنى لك أن % % تبقى ولو جاوزت أيامك الهرما % % 29(@)(@@) % لكن أتقضى بحيث الشم راغمة % من أزمة لم تدع في معطس شمما % % 30(@)(@@) % هلا بقيت لها في هذه السنة ال % % شهباء تحفظ من أمجادها الحرما % % PageV01P861 31(@)(@@) % أحين فيها اقشعر العام وانبعثت % % غبراء أمحلت الغيطان والأكما % % 32(@)(@@) % تمضى وتتركها في عام مسغبة % فمن لها وإلى من تشتكي القحما % % 33(@)(@@) % أوقت موتك هذا والورى حشدت % % هذي الخطوب عليها والبلا ارتكما ؟ % 34(@)(@@) % وددت يومك لم يجر القضاء به % % لو كان للوح أن يستوقف القلما % % 35(@)(@@) % حتى تفرج غماء الجدوب كما % % فرجت من قبلها أمثالها غمما % % 37(@)(@@) % أشار ربك إرسال العذاب بها % % لما جنوها ذنوبا تهتك العصما % % 38(@)(@@) % ففيض الماء من أنهارها وطوي % % بالموت شخصك عنها والحيا انعدما % % 39(@)(@@) % مشت بنعشك أهل الأرض تحمله % % فخف حتى كأن لم يحملوا علما % % 40(@)(@@) % وما دروا رفعته من كرامته % % أهل السماء على أكتافها عظما % % 41(@)(@@) % لم يرفعوا قدما إلا وقد وضعت % من قبلهم غر أملاك السما قدما % % PageV01P862 42(@)(@@) % كأن نعشك محمول 
ms252	 به ملك % وخلفه العالم الأعلى قد ازدحما % % 43(@)(@@) % ساروا بها وسماء الدمع ترسلها % % لك النواظر مدرارا ولا سأما % % 44(@)(@@) % وهب حين التقى ماء العيون على % % أمر نزا منه قلب الموت واضطرما % % 45(@)(@@) % فكنت ( نوحا ) وكان الفلك نعشك وال % % طوفان فائر دمع أغرق الأمما % % 46(@)(@@) % إن يحملوك على علم فما حملوا % % إلا الركانة والأخطار والهمما % % 47(@)(@@) % أو يدفنوك على علم فما دفنوا % % إلا المحاسن والأخلاق والشيما % % 48(@)(@@) % أو ينفضوا الكف من ترب به دفنوا % % ميتا فتربك بالأفواه قد لثما % % 49(@)(@@) % كأن قبرك فوق الأرض نجم سما % % أو أنه في ثراه حل نجم سما % % 50(@)(@@) % يا نازلا حيث لا صوتي يلم به % % عليك أم المعالي جزت اللمما % % 51(@)(@@) % واستوقفت بحشاها الركب في جدث % يجود كفك لا بالغيث قد وسما % % PageV01P863 52(@)(@@) % نادت بشجو خذو لي في حقائبكم % % حشاشة ملئت من وجدها سقما % % 53(@)(@@) % قفوا بها واعقروها وانضحوا دمها % % على ثرى أمس قد واروا به الكرما % % 54(@)(@@) % وقفت بعدك و ' الزوراء ' أنشدها % % أين الذي كان للاجين معتصما ؟ % 55(@)(@@) % وأين من يزهر النادي بطلعته % % للزائرين ويجلو عنهم الغمما ؟ % 56(@)(@@) % ومن بني لقرى الأضياف دار على % % عمادها الفخر فيه طاولت إرما % % 57(@)(@@) % ومن ترد جميع المشكلات له % % إذا القضية أعيا فصلها الحكما % % 58(@)(@@) % وأين للشتوة الغبراء من كرما % ما قطب العام إلا ثغره ابتسما ؟ % 59(@)(@@) % وأين من كان للعافين يلحفها % % جناح رحمته ما دهره أزما ؟ % 60(@)(@@) % لا فرق ما بين أقصاها إذا نسبا % عنه وما بين أدناه له رحما % % 61(@)(@@) % وأين من ليتامى الناس كان أبا % في بره قد تساوت كلهم قسما ؟ % PageV01P864 62(@)(@@) % في فقد آبائها لليتم ما عرفت % % لكنها عرفت في فقده اليتما % % 63(@)(@@) % أحببت في الله كتمان الصنيع ولا % % يزداد إلا ظهورا كلما كتما % % 64(@)(@@) % من كان يحلف أن لم يعتلق أبدا % إثم ببردك لم يخث ولا أثما % % 65(@)(@@) % ألا وقتك حشا العافين صائبة % ولا وقاء إذا رامي القضاء رمى % % 66(@)(@@) % وهو توفيك شكر المنعمين وقد % % طوقت حيا وميتا جيدها نعما ؟ % 67(@)(@@) % بالأمس وجهك 
ms253	 يستسقى الغمام به % % واليوم قبرك تستسقى به الديما % % 68(@)(@@) % وكنت ري صداها فاستنبت لها % % من ولدت بحارا للندى فعما % % 69(@)(@@) % فأين مثلك تلقى الناس ذا كرم % ومنك في حالة ما فارقوا الكرما ؟ % 70(@)(@@) % يا غائبا ما جرت في القلب ذكرته % % إلا ترقرق دمع العين وانسجما % % 71(@)(@@) % لا غرو أن يعقد الإسلام حوزته % % جميعها مأتما يورى الحشا ضرما % % PageV01P865 72(@)(@@) % فالثاكل الدين والمثكول شخصك وال % % ناعي الهدى والمعزي خاتم العلما % % 73(@)(@@) % ( محمد حسن ) نظم الثناء له % % فقل في سلك تقواه من انتظما % % 74(@)(@@) % سقت ضريحك من جدواك واكفة % وطفاء ترضع درا ما الحيا فطما % % 75(@)(@@) % أعيذ قلبك أن يهفو به حذر % على المكارم أو يغدو لها وجما % % 76(@)(@@) % طب في ثرى الأرض نفسا لا الندي خلا % % من الوفود ولا عهد الندى انصرما % % 77(@)(@@) % قامت مقامك فيه فتية ضربت % على السماء لها علياؤها خيما % % 78(@)(@@) % وكيف يظلم ربع من علاك به % ' أبو الأمين ' سراج يكشف الظلما % % 79(@)(@@) % بقية من أبيك ( المصطفى ) رفعت % % به علاه وفيه مجده دعما % % 80(@)(@@) % أحب قربك واستبقاه خالقه % % ركنا تطوف به الآمال مستلما % % 81(@)(@@) % وأنت يا حرم المجد المنيف على % لا راعك الدهر واسلم للعلى حرما % % PageV01P866 82(@)(@@) % إن يوحشنك ما من بدرك انكتما % % فليؤنسنك من نجميه ما نجما % % 83(@)(@@) % لولا ابنه ( المصطفى ) للجود قلت شكت % % من بعد إنسانها عين الرجاء عمى % % 84(@)(@@) % ندب به فتح المعروف ثانية % من بعدما بأبيه أولا حتما % % 85(@)(@@) % من يلقه قال هذا في شمائله % ' محمد صالح ' أن يغتدى علما % % 86(@)(@@) % حلو الخلائق في جيل لهم خلق % لو مازج الكوثر الخلدي ما طعما % % 87(@)(@@) % ما شاهدت عظماء الأرض هيبته % % إلا وطأطأت الأعناق والقمما % % 88(@)(@@) % والمشتري الحمد والأشراف أكسبها % % لجوهر الحمد أغلاها به قيما % % 89(@)(@@) % من لو يجود لعاف في نقيبته % % لم يقرع السن في آثارها ندما % % 90(@)(@@) % لو قال قوم نرى بالجود مشبهه % % لقلت هاتوا وعدوا العرب والعجما % % 91(@)(@@) % أستغفر الله إن شبهت أنمله % % بالقطر منسجما والبحر ملتطما % % PageV01P867 92(@)(@@) % نعم حكاه أخوه من به ظهرت 
ms254	 % % مخائل من أبيه تفضح الديما % % 93(@)(@@) % ' محمد ' وكفى أن الزمان لنا % % عن منظر حسن منه قد ابتسما % % 94(@)(@@) % إذا بدا سمت الألحاظ ترمقه % % تخاله بهلال العيد ملتثما % % 95(@)(@@) % من لفظه العذب إن شئت التقط دررا % أو فاقتطف زهرا أو فاقتبس حكما % % 96(@)(@@) % فاهتف بمن مات من أهل العلاء وقل % % لولا الردى لا افتضحتم فاشكروا الرجما % % 97(@)(@@) % قد أطلع المجد في أفق العلى قمرا % يا فرحة الشهب لو تغدو له خدما % % 98(@)(@@) % أمات نشر مساعيه مساعيكم % % حتى انطوت مثلكم تحت الثرى رمما % % 99(@)(@@) % فلو رآه ' زهير ' في شبيبته % % إذا لفداه واختار الفدا هرما % % 100(@)(@@) % من دوحة ما نمت إلا الغصون على % وكل غصن بماء المكرمات نما % % 101(@)(@@) % كارم لها الغيث واستشهد لها بندى % % الجواد ثم ارو كيف الغيث قد لؤما % % PageV01P868 102(@)(@@) % وفاخر البدر في لألاء غرته % % وحكم الشرف الوضاح والعتما % % 103(@)(@@) % واصدع بنجم العلى ' الهادي ' بطلعته % % دجى همومك واستكشف به الغمما % % 104(@)(@@) % ومن ( أمين ) الندى فاعقد يديك على % % أوفى البرية في أوفى الندى ذمما % % 105(@)(@@) % يا اسرة المجد لا زلتم باسرتكم % % عقدا على نحر هذا الدهر منتظما % % 106(@)(@@) % صبرا بني الحلم إن الحلم منزلة % حتى لمن منكم لم يبلغ الحلما % % 107(@)(@@) % وحسبكم ( مصطفى ) العلياء فهو لكم % % نعم الزعيم به شمل العلى التأما % % PageV01P869 البحر : كامل تام 1(@)(@@) % قطعت لسانك نفثة من أرقم % أعلمت من تنعاه أم لم تعلم ؟ % 2(@)(@@) % كيف استطعت تدير في فمك اسمه % % ولقد يضيق به فم المتكلم ؟ % 3(@)(@@) % يا ناعيا للخلق روح حياتهم % % أملك لسانا لا أبا لك واكظم % % 4(@)(@@) % رفه على موتي نبلت قلوبهم % % فتنبهوا بسهام نعي مؤلم % % 5(@)(@@) % فجميعهم تحت الثرى في ملحد % وجميعهم فوق الثرى في مأتم % % 6(@)(@@) % دعهم فقد غصوا بجرعة ثكلهم % % وإلى الأئمة في نعائك يمم % % 7(@)(@@) % وقل السلام عليكم درس التقى % % وعفت معالمه عفو الأرسم % % 8(@)(@@) % والدين هد اليوم دين ' محمد ' % ووهت دعائمه بفقد المحكم % % 9(@)(@@) % كان الدليل أقمتموه على الهدى % % علما يدل على الطريق الأقوم % % 10(@)(@@) % والآن لما طوحته يد الردى % % غدت 
ms255	 الأنام بمجمل مستبهم % % PageV01P870 11(@)(@@) % حميت عليهم للرشاد مطالع % لا تستبين اليوم للمتوسم % % 12(@)(@@) % غشيتهم سوداء أطبق ليلها % % للحشر تلحفهم بليل مظلم % % 13(@)(@@) % يا خير آباء فقدنا برهم % % فجعت يتاماكم بأرفق قيم % % 14(@)(@@) % فطموا فمن لهم بدرة فيئكم % % أن يرضعوها بعد أكرم منعم % % 15(@)(@@) % حسن مقالك ما الأئمة أهملوا % % أبناءكم فيسوء ظن المعدم % % 16(@)(@@) % بل كان شاقهم الإمام ( المرتضى % % ولذاك قيل له على الرحب اقدم % % 17(@)(@@) % ورأوا ( محمد صالحا ) من بعده % % لبنيهم يبقى فقيل له اسلم % % 18(@)(@@) % دم للصلاح وللهداية والتقى % % ولعلية العافي وحمل المغرم % % 19(@)(@@) % قسما بهديك بل بنسكك بل بمن % % بالفضل خصك وهو جهد المقسم % % PageV01P871 20(@)(@@) % ما فوق ظهر الأرض فوقك مقتف % أثر الأئمة في تقى وتكرم % % 21(@)(@@) % أنت الذي تنميك من سلف العلى % % زهر الوجوه لها المكارم تنتمي % % 22(@)(@@) % ومعذب بعلاك قلت وقد سما % % لينالها فانحط موطىء منسم % % 23(@)(@@) % أتعبت نفسك ليس تعلو شأوه % % ولو ارتقيت إلى السماء بسلم % % 24(@)(@@) % فاسلم على الأيام ربعك آهل % وعلاك سام فوق هام المرزم % % PageV01P872 البحر : كامل تام 1(@)(@@) % ملأت مكارمك البسيطة أنعما % % فلذلك انعقدت لرزئك مأتما % % 2(@)(@@) % ولئن غدا فذا مصابك في الورى % % فالغيث كان له وجودك توأما % % 3(@)(@@) % بالأمس قد رضعت بنانك درها % % واليوم تحلبها محاجرها دما % % 4(@)(@@) % ما غمضت أجفان عينك عن ردى % إلا وجفن الدهر غمض عن عمى % % 5(@)(@@) % حلب الحمام ' أبا الأمين ' بك الجوى % % شطرين صابا في الزمان وعلقما % % 6(@)(@@) % فأغص في شطر فما من ' هاشم ' % وأغص في شطر ( لجعفرها ) فما % % 7(@)(@@) % قسم الرزية في السوية فيهما % % فغدا كلا العبأين ثقلا أعظما % % 8(@)(@@) % أما وساعتك التي بيلملم % زالت وما أعنى سواك يلملما % % 9(@)(@@) % ما خلت فقدك يستقل بثقله % % ركنا زمانك ثم لم يتهدما % % 10(@)(@@) % فلقد أطل غداة يومك فادح % هو منه في الأرضين أعظم في السما % % PageV01P873 11(@)(@@) % في ناره استوت الأنام فما دروا % % أي القلوب أحق أن تتضرما % % 12(@)(@@) % يا من أضاء بنوره أفق الهدى % % أعلمت بعدك كل أفق أظلما ؟ % 13(@)(@@) % من رد طرفك عن فتور مغضيا % ولكم 
ms256	 لحظت به الحواسد أرقما % % 14(@)(@@) % أبكيك للإحسان غاض نميره % % قسرا وللآمال بعدك حوما % % 15(@)(@@) % ولطالب المعروف ألقى رحله % % وأقام ميت العزم لا متلوما % % 16(@)(@@) % قطعت بك الأيام آمال الورى % % قطعت ولا وصلت لكفك معصما % % 17(@)(@@) % ولقد سددت فم النعي بأنمل % % رجفت ولم أملك بهن له فما % % 18(@)(@@) % فأقر في سمعي أمض قوارع % نفذت فكانت في فؤادي أسهما % % 19(@)(@@) % ينعي جفونا كان يرخيها التقى % % بأبي جفونك ما أعف وأكرما % % 20(@)(@@) % وأناملا منها بأعظم كلفة % عبر الحمام إليك بحرا مفعما % % PageV01P874 21(@)(@@) % رفعوك والبركات عن ظهر الثرى % % وطووك واللمعات عن وجهه السما % % 22(@)(@@) % دفنوك وانقلبوا بأعظم حيرة % فكأنما دفنوا الكتاب المحكما % % 23(@)(@@) % لولاك يا ( مهدي ) آل ( محمد % ظلوا بمجهلها الطريق الأقوما % % 24(@)(@@) % أشرقت شمسا في بروج سما الهدى % % فأضأتها وولدت فيها أنجما % % 25(@)(@@) % لولاك ما وجدت ولولا ' جعفر ' % من مذهب للحق يرغم مجرما % % 26(@)(@@) % أقسمت بالشرف الذي هو طبعه % % وعلمت ذلك جهد من قد أقسما % % 27(@)(@@) % لقد احتمت منك الشريعة في فتى % لا تستبيح يد النوائب ما حمى % % 28(@)(@@) % وإذا ذوو الفضل استوت أقدامهم % % وجدوه أحرى القوم أن يتقدما % % 29(@)(@@) % ومن السكينة والوقار سكوته % % وإذا تكلم لم تجد متكلما % % PageV01P875 30(@)(@@) % هو خير من نمت العلاء وآله % % من ذروة ( الجوزاء ) أشرف منتمى % % 31(@)(@@) % ' الجعفريين ' الذين بمجدهم % % ركبوا من الشرف السنام الأعظما % % 32(@)(@@) % رفعوا على اولى الزمان رواقهم % % وتوارثوا فيه العلاء الأقدما % % 33(@)(@@) % بالسيد ( المهدي ) ثم ( بجعفر % وبهم أنار الله ما قد أبهما % % 34(@)(@@) % يا موصلا مني رسالة ذي حشا % ظمئت إلى ذاك الرواء ولا ظما % % 35(@)(@@) % بلغ بلغت الخير خير موسد % جدثا به دفنوا الصراط الأقوما % % 36(@)(@@) % يا بدر إن تك قد أفلت فلا تخل % برج الهداية منك بعدك أبهما % % 37(@)(@@) % فلقد ولدت به كواكب لم تلد % مثلا لها ام الكواكب في السما % % 38(@)(@@) % لو عدت للدنيا ومن لزمانها % % بك أن تعود فيغتدي متبسما % % PageV01P876 39(@)(@@) % لرأيت ' صالحها ' معينا للعلى % % مولى له الدهر اغتدى مستخدما % % 40(@)(@@) % وتلطفت وطفاه تحلبها الصبا % % بثرى حواك فضم عضبا مخذما 
ms257	 % % 41(@)(@@) % أفصحت عن وجدى إليك بدعوة % ربما ذممت بها الزمان الأعجما % % 42(@)(@@) % قد كنت لي بجميل ذكرك مالكا % فلئن بقيت لأنسين متمما % % PageV01P877 البحر : مجزوء الكامل 1(@)(@@) % وأبيك لا حي يدوم % فعلام ترمضك الهموم ؟ % 2(@)(@@) % لا تجزعن لضاعن % % وانظر هديت من المقيم % % 3(@)(@@) % إنا بنو الدنيا تطيب % لنا ومربعها وخيم % % 4(@)(@@) % نرجو الشفا لسقيمنا % % وصحيحنا فيها سقيم % % 5(@)(@@) % ونروم أن نبقى بها % % والموت غاية ما نروم % % 6(@)(@@) % هذا ( الحسين ) وكان يس % % تسقى بطلعته الغيوم % % 7(@)(@@) % سائل به محرابه % % إن شئت فهو به عليم % % 8(@)(@@) % يخبرك كم بسناه أم % % سى يزهر الليل البهيم % % 9(@)(@@) % متهجدا لله ودت % % لثم مسجده النجوم % % 10(@)(@@) % هو واحد التقوى الذي % % هي بعد مولده عقيم % % PageV01P878 11(@)(@@) % رحل الحمام به فتلك % % معالم التقوى رسوم % % 12(@)(@@) % رفعت برفع سريره ال % % بركات وافتقد النعيم % % 13(@)(@@) % حملوه والتقوى تنا % % شده ومدمعها سجوم % % 14(@)(@@) % يا ذاهبا لا يرتجى % % أبد الزمان له قدوم % % 15(@)(@@) % فاللحد هل يدرى أأن % % ت أم الصلاح به مقيم ؟ % 16(@)(@@) % قمر السماء به توارى % % أم محياك الكريم ؟ % 17(@)(@@) % إن يوص غيرك من بأر % % ث يتيمه ورعا يقوم ؟ % 18(@)(@@) % فالنسك إرث والوصي % تقاك والزهد اليتيم % % 19(@)(@@) % ومقيم مأتمك التقى % % إن التقى نعم المقيم % % 20(@)(@@) % وبك المعزى من أتى % % في مدحه الذكر الحكيم % % PageV01P879 21(@)(@@) % القائم ' المهدي ' من % % تجلى بطلعته الهموم % % 22(@)(@@) % ورث النبوة علمها % % فهو الخبير بها العليم % % 23(@)(@@) % مولى بنادي عزه % % تتضاءل الصيد القروم % % 24(@)(@@) % ناد ملائكة السماء % % على سرادقه تحوم % % 25(@)(@@) % وبشم آناف الملوك % % تراب عتبته شميم % % 26(@)(@@) % في صدره ' المهدي ' تص % % در للورى منه العلوم % % 27(@)(@@) % ملأت نتائجه الزمان % % وغيره الشكل العقيم % % 28(@)(@@) % فله الزعامة في الهدى % % وسواه في الدعوى أثيم % % 29(@)(@@) % يا من له النسب الصريح ال % % محض والحسب الكريم % % 30(@)(@@) % عجبا يروم علاك من % % لك فوقه الشرف القديم % % PageV01P880 31(@)(@@) % فوق الرغام وتحت نعلك % % أنف همته رغيم % % 32(@)(@@) % هبه يروم فأين من % % يد من على الأرض النجوم ؟ % 33(@)(@@) % مثلان خلقك والنسيم % ونداك والغيث العميم % % 34(@)(@@) % ولأنت واسطة العلاء 
ms258	 % % وولدك العقد النظيم % % 35(@)(@@) % قوم بهم أمن المروع % وفيهم أثرى العديم % % 36(@)(@@) % كلا تراه ' جعفرا ' % في الجود وهو لهم زعيم % % 37(@)(@@) % أرج السيادة فيهم % % كالمسك ينشره النسيم % % 38(@)(@@) % رضعوا الإمامة فالجميع % بنور عصمتها فطيم % % 39(@)(@@) % فولاؤهم فرض وهد % % يهم الصراط المستقيم % % 40(@)(@@) % لبس الزمان بهاءهم % % فبهم محياه وسيم % % PageV01P881 41(@)(@@) % وبهم لنا الأيام يقطر % % من غضارتها النعيم % % 42(@)(@@) % تهوى السماء بأنها % % لصعيد أرضهم أديم % % 43(@)(@@) % وإذا مشوا فوق الثرى % % حسدت نعالهم النجوم % % 44(@)(@@) % يا سادة العلما ومن % % تزن الجبال لهم حلوم % % 45(@)(@@) % بكم العزاء وحسبنا % % من كل ماض أن تدوموا % % 46(@)(@@) % ' أمحمد ' في ظلهم % % ستنال أقصى ما تروم % % 47(@)(@@) % فأبوك إن يفقد فكل % هم أب بر رحيم % % 48(@)(@@) % سيقر عينا في الثرى % % إذ فيك جودهم يقوم % % 49(@)(@@) % حيا الملائك قبره % % من حيث فيه هو المقيم % % 50(@)(@@) % وسقته من أنواء عفو % % الله واكفة سجوم % % PageV01P882 البحر : خفيف تام 1(@)(@@) % إطوياني ملامة وانشراني % % بلغ الوجد حيث لا تبلغاني % % 2(@)(@@) % قد عناني جوي يطول وفيه % % يقصر اللوم عن مرد عناني % % 3(@)(@@) % كيف عيني لم تغد بيضاء حزنا % وهي قد أصبحت بلا إنسان ؟ % 4(@)(@@) % إن صوت النعي مذ خاض سمعي % % خلته في حشاي غرب سنان % % 5(@)(@@) % وعضضت البنان غيظا ولكن % % لا يفيد المكلوم عض البنان % % 6(@)(@@) % فاعذراني إذا ربطت فؤادي % % بيدي وانطويت مما دهاني % % 7(@)(@@) % إن قلبي من دهشتي طار رعبا % فغدا وهو دائم الخفقان % % 8(@)(@@) % كفكفا عن حشاي غرب ملامي % % من جراح الجوى بها ما كفاني % % 9(@)(@@) % أين مني صبري لأرضى فأسلو % % صبري اليوم والرضا ميتان % % 10(@)(@@) % أنا يا لائمي أدرى بطبي % % فاعذلاني ما عشت أو فاعذراني % % PageV01P883 11(@)(@@) % سلياني برد روحي وإلا % % فبماذا عنه إذا سلواني % % 12(@)(@@) % قرباه فوق الثرى اليوم مني % % أو فمنه تحت الثرى قرباني % % 13(@)(@@) % واقبراه إذا بقلبي وإلا % % فخذاه بقبره واقبراني % % 14(@)(@@) % وإلى جنب مهجتي وسداه % % أو إلى جنب جسمه وسداني % % 15(@)(@@) % فحياتي وموته رزآن % % لم أقدر علي يجتمعان % % 16(@)(@@) % بل تخيلت أن يعيش وأفنى % % أو سواء تضمنا حفرتان % % 17(@)(@@) % لم 
ms259	 أفارقه أجنبيا ولكن % هو روحي وفارقت جثماني % % 18(@)(@@) % قد نشرنا ما بيننا الود دهرا % فطواه الردى وليت طواني % % 19(@)(@@) % غمضا ناظري ما عشت غيظا % فعلى من بعد ' الرضا ' تفتحان % % 20(@)(@@) % وزفيري ثقف حنايا ضلوعي % % فعلى ود من تبين حواني % % PageV01P884 21(@)(@@) % وخطوب الزمان دونك شخصي % % فلك اليوم قد كشفت عياني % % 22(@)(@@) % نزعت عني الحوادث درعى % % فبمن أبقى شبا الحدثان % % 23(@)(@@) % فلكم قد لويت دهري وهذا % % دهري اليوم كيف شاء لواني % % 24(@)(@@) % لك أسمحت يا خطوب الزمان % % ذهبت نخوتي فهاك عناني % % 25(@)(@@) % قد أبانت حشاي فاستهدفيها % % نكبة طوحت ضحى بأبان % % 26(@)(@@) % راصدتني من حيث لست أراها % % أعين النائبات وهي تراني % % 27(@)(@@) % فرمتني من حيث لا أتقيها % % بسهام الهموم والأحزان % % 28(@)(@@) % فأنا اليوم يا نوائب كلي % % مقتل بارز لمن قد رماني % % 29(@)(@@) % كنت قدما أذود نبلك عني % % ببناني فأين مني بناني ؟ % 30(@)(@@) % قد نعاه الناعي إلي أيدري % % لا درى أنه إلى نعاني ؟ % PageV01P885 31(@)(@@) % فحسبت الفؤاد مني أضحى % % بين نابي ذي سورة افعوان % % 32(@)(@@) % لهف نفسي على صريع حمام % ليس لي عنه بالدفاع يدان % % 33(@)(@@) % ودت المكرمات لو أن منها % % غسلته بدمعها العينان % % 34(@)(@@) % ومسجى بنعشه في حبير % هو والجود فيه ملتحفان % % 35(@)(@@) % حملوه وخلفه كل عاف % بدماه عيناه فائرتان % % 36(@)(@@) % قائلا : أيكة الرجاء اظمأي اليو % % م وعودي مصفرة العيدان % % 37(@)(@@) % مص منك الصعيد ماء سماح % كنت فيه ريانة الأغصان % % 38(@)(@@) % عجبا خف نعشه وهو قد سار % % ر بثقل المعروف والإحسان % % 39(@)(@@) % بل أراه ما خف إذ سار لكن % % حملته ملائك الرحمن % % 40(@)(@@) % شيعته الأنام بالأحزان % % والتقته بالبشر حور الجنان % % PageV01P886 41(@)(@@) % هل كذا جل نعش ميت سواه % % أختلطا عند نعشه العالمان % % 42(@)(@@) % وعليه قد ودت الأرض يبقى % % ويرى كل من عليها فان % % 43(@)(@@) % فاحملاني إلى ثراه أحملاني % % وقفا بي عليه وقفة عان % % 44(@)(@@) % ودعاني خلف الصعيد أناديه % % نداء المروع اللهفان % % 45(@)(@@) % يا فقيدا فقدت منه غماما % كلما قلت قد ظمئت سقاني % % 46(@)(@@) % ودفينا دفنت منه حساما % % كنت أعددته لحرب الزمان % % 47(@)(@@) % أغمدته في الترب 
ms260	 كفي فشلت % % فات نصري وابت بالخذلان % % 48(@)(@@) % شغلت منطقي عليه المراثي % % وخلا من هوى سواه جناني % % 49(@)(@@) % يا تراني أثني على من بمدح % وهوى من أحبه يا تراني % % 50(@)(@@) % مات محي الثنا ولولا أبوه % % قلت في لحده دفنت لساني % % PageV01P887 51(@)(@@) % ذاك منه صفاته الغر جاءت % % في مزايا علاه طبق المعاني % % 52(@)(@@) % صالح الفعل راجح الفضل غوث ال % % مستغيثين غيث أهل الأماني % % 53(@)(@@) % ورع ناسك تفرغ لله % % بقلب من خوفه ملآن % % 54(@)(@@) % جامع قسوة الحمية للدين % % انتصارا ورقة الإيمان % % 55(@)(@@) % وبعز الملوك يصبح مرهو % % با ويمسي بذلة الرهبان % % 56(@)(@@) % صدق المدح في علاه فقل ما % % شئت في مجده العظيم الشان % % 57(@)(@@) % هو في الخير من قديم الليالي % % خير من قد مشت به قدمان % % 58(@)(@@) % أثقلت كاهل الزمان أياديه % % فأمسى عياله الثقلان % % 59(@)(@@) % وعلى الأرض كلها من نداه % % أثر طيب بكل مكان % % 60(@)(@@) % قد بنى للقرى على الكرخ بيتا % والتقى اس ذلك البنيان % % PageV01P888 61(@)(@@) % شارع الباب تلتقي طرق الأر % % ض جميعا لديه بالضيفان % % 62(@)(@@) % رافعا تحت ظلمة الليل للسا % % رين فيه ذوائب النيران % % 63(@)(@@) % كرما قد أعد للضيف فيه % % عدد الطارقين غر الجفان % % 64(@)(@@) % مكرمات ترى رضيع سماح % عندها الدهر لا رضيع لبان % % 65(@)(@@) % شكرها أعجز الأنام فأني % % قابلتها الأيام بالكفران ؟ % 66(@)(@@) % قلت للبحر هل تساويه يوما % قال كلا : لا يستوي البحران % % 67(@)(@@) % وسألت الحيا أتحكيه جودا % قال : أين الباكي من الجذلان ؟ % 68(@)(@@) % ليس يحكيه في سماحة كف % غير من قد حكاه عزة شان % % 69(@)(@@) % ذاك ( عبد الكريم ) من قد تسامى % % شرفا حط دونه النيران % % 70(@)(@@) % فهما فرقدا علاء ومجد % وهما ديمتا ندى وامتنان % % PageV01P889 71(@)(@@) % كلما عن مفخر يوم سبق % فيه تلقاهما شريكي عنان % % 72(@)(@@) % ولدا فتية هم شهب الفخر % % وإلا جداول الإحسان % % 73(@)(@@) % متساوين في المكارم قد فا % % قوا بفضل النهى على الفتيان % % 74(@)(@@) % ينشر الحي من طوى الموت منهم % % ويعيد الباقي حياة الفاني % % 75(@)(@@) % ما فقدت ( الرضا ) وذلك باق(@)(@@) % مصطفى ) الجود يا ركاب الأماني % % 76(@)(@@) % فرديه خفائفا تصدرى منه % % ثقال 