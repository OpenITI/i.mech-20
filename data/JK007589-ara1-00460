ms441	 غير قاعد % 25(@)(@@) % وباشرت فيه كل لين وشدة % وجاهدت عنه فوق جهد المجاهد % 26(@)(@@) % غلاما أميرا ثم كهلا خليفة % بهمة ماضي العزم يقظان ماجد % 27(@)(@@) % وكم مارق من ربقة الدين خائن % % لنعمى الإله عنده فيك جاحد % % 28(@)(@@) % دلفت إليه فاستبحت حريمه % بجيش لهام كالمدود الزوائد % 29(@)(@@) % وأسلفت إنذارا وقدمت عذرة % لتقويم معوج وإصلاح فاسد % 30(@)(@@) % ولو شئت أطعمت المنية روحه % % بأدنى غلام أو بأصغر قائد % PageV01P1635 31(@)(@@) % وقد فغرت فاها له غير أنها % % تراقب إذنا منك غير مساعد % 32(@)(@@) % وأنت تراعي الله فيمن تضمه % % مدينته من مسلم ومعاهد % 33(@)(@@) % فلم يعصم ابن الشيخ تشييد سوره % % على رأس نيق بالصفا والجلامد % 34(@)(@@) % بل اغتر بالإحصار منه وسولت % له النفس غيا ليس غاو كراشد % 35(@)(@@) % وما الحازم النحرير إلا الذي يرى % % مصادر ما يأتيه قبل الموارد % 36(@)(@@) % وقد كان في الغيث المواصل غوثه % يدافعنا عنه دفاع المكايد % 37(@)(@@) % فلما تقضى حينه وتفرغت % عزاليه ثرنا كالليوث اللوابد % % 38(@)(@@) % فجادته من وبل السهام سحابة % تسح ذعافا من سمام الأوساد % 39(@)(@@) % وأمطره جذب المجانيق جندلا % ونارا تلظى كانقضاض الفراقد % 40(@)(@@) % ودب إليه الموت غضبان مسرعا % باباته من محكمات المصائد % PageV01P1636 41(@)(@@) % ثلاثة أيام فقط عددتها % % به ساهرا في ليله غير راقد % 42(@)(@@) % فأخرجته مستخزيا راجلا بما % % بثثت عليه من صنوف المكايد % 43(@)(@@) % ولو لم يعد بالعفو منك لأرقلت % إليه المنايا في رؤوس المطارد % 44(@)(@@) % فأثبته لما استقاد وقد دنت % % ظبات السيوف من مناط القلائد % 45(@)(@@) % وأصبحت تحوي أرضه ودياره % % وكل طريف من حماه وتالد % 46(@)(@@) % أباح وما قامت عليه لسفكه % % شهادة قاض فهو أعدل شاهد % 47(@)(@@) % بنقض شروط كان أحمق ناقص % عراها ولكن كنت أحزم عاقد % 48(@)(@@) % فآب ذميم الفعل خزيان نادما % وأبت كريم العفو جم المحامد % 49(@)(@@) % وأبنا عزاز النصر تشكو ركابنا % % وجاها ونشكو طول هجر الخرائد % 50(@)(@@) % بأية ملأ مغنما وسلامة % حواها رفيع العيش خوض الشدائد % PageV01P1637 51(@)(@@) % وليس كإغذاذ المسير وحثه % % لتقريب لقيان الصديق الأباعد % 52(@)(@@) % ولم أر مثل الشعر ينظم للعلا % % فنون الحلى لو 
ms442	 أنه غير كاسد % PageV01P1638 البحر : - 1(@)(@@) % بني طاهر مدحي لكم دون غيركم % % بحكم الندى والطول والبأس والمجد % 2(@)(@@) % كأني إذ أشركت في المدح مرة % بكم معشرا أشركت بالله في الحمد % 3(@)(@@) % فما بال أيديكم على الناس ثرة % % سواي فإني من نوالكم مكدي % % 4(@)(@@) % إذا كان حظ الناس سقيا سمائكم % % فحظي وميض البرق أو زجل الرعد % % 5(@)(@@) % فلو كان منعا شاملا لعذرتكم % ولكنه شيء خصصت به وحدي % % 6(@)(@@) % أفي عدلكم أن تفردوا بجفائكم % % وليا لكم يصفيكم بهوى فرد % 7(@)(@@) % وإني على ما كان منكم لعالم % بأني ما أخطأت في مدحكم رشدي % % 8(@)(@@) % لأني أتيت الحظ من نحو بابه % % فإن يك حرمان فذاك على جدي % % 9(@)(@@) % وليس ضلال المرء فوت غنيمة % رجاها ولكن أن يجور عن القصد % 10(@)(@@) % أطلتم وقوفي بين يأس ومطمع % % بلا صدر بادي السبيل ولا ورد % PageV01P1639 11(@)(@@) % ولا مثلكم من قال طالب رفده % % بخلتم ببرد اليأس عني وبالرفد % PageV01P1640 البحر : - 1(@)(@@) % أراد الغيث أن يحكيك جودا % % فقصر بعد أن أحيا البلادا % % 2(@)(@@) % فقلت غلطت جود أبي علي % يقصر عن مداه من أرادا % % 3(@)(@@) % لأن الجود منه كل يوم % % وأنت تجود أياما عدادا % % 4(@)(@@) % وأنت تجود أرضا بعد أرض % % وكفاه يعمان البلادا % % PageV01P1641 البحر : - 1(@)(@@) % يا مظهرا نخوة عند اللقاء لنا % % وكاسرا طرفه من غير ما رمد % % 2(@)(@@) % أما علمت بأني عنك في سعة % وفي غنى من عطايا الواحد الصمد % 3(@)(@@) % فهبك أوتيت ما لم يؤته أحد % من فضل جاه ومن مال ومن ولد % 4(@)(@@) % ألست من لبسة الأحرار منسلخا % وكاسيا من لبوس الشؤم والنكد % 5(@)(@@) % لا خير في نعمة لا شكر يتبعها % % ولا يد عريت من اصطناع يد % 6(@)(@@) % إن كنت أصبحت محسودا على بخل % فذو السماحة أولى منك بالحسد % 7(@)(@@) % من جاد ساد ومن لم يأت عارفة % ولم يجد لاكتساب المجد لم يسد % PageV01P1642 البحر : - 1(@)(@@) % لعن الله خالدا % % بادئا ثم عائدا % % 2(@)(@@) % ألأم اللائمين نف % سا وأما ووالدا % % 3(@)(@@) % رجل لا يرى إلا % ها سوى الأير واحدا % % 4(@)(@@) % كلما ذر شارق 
ms443	 % خر للأير ساجدا % % 5(@)(@@) % ويرى كل من لحا % % ه على ذاك حاسدا % % 6(@)(@@) % فقد الأير ساعة % فترى الشيخ فاقدا % % 7(@)(@@) % لو خلا منه ليلة % بات يرعى الفراقدا % % 8(@)(@@) % فيه عادى صديقه % % والحسان الخرائدا % % 9(@)(@@) % وله كابد الأذى % % والأكف القوافدا % % 10(@)(@@) % اعذروا الشيخ فاسته % أوردته المواردا % % PageV01P1643 البحر : - 1(@)(@@) % قالوا هجاك أبو حفص فقلت لهم % % استبطأت هامة الصفعان عادتها % % 2(@)(@@) % فأبلغوا سلامي لا عدمتكم % واستنظروها سأعطيها إرادتها % % 3(@)(@@) % لولا النبيذ وأشغال شغلت بها % % إذن لما أغفلت كفي عيادتها % % 4(@)(@@) % إن أرى خوذة الصفعان قد صدئت % % ترفقوا سوف أعطيكم جرادتها % % PageV01P1644 البحر : - 1(@)(@@) % إن أبا حفص سيستعدي % % على القوافي حين لا معدي % % 2(@)(@@) % يا لك من أصلع ذي هامة % % قد قرعتها خلع القفد % 3(@)(@@) % زوجه الدهر على سنه % % زمردة صادقة الوعد % 4(@)(@@) % فأخلف الله عليه بها % % قرنا مكان الشعر الجعد % % PageV01P1645 البحر : - 1(@)(@@) % غيره الكون والفساد % % ولاح في خده سواد % 2(@)(@@) % كأنه دمنة أمحت % فكل آثارها رماد % % PageV01P1646 البحر : - 1(@)(@@) % أصف الحبيب ولا أقول كأنه % % كلا لقد أمسى من الأفراد % 2(@)(@@) % إني لأستحيي محاسن وجهه % % ألا أنزهه عن الأنداد % PageV01P1647 البحر : - 1(@)(@@) % الحزن منحل ومنعقد % لاثنين ذا باك وذا كمد % 2(@)(@@) % فمقيض تشقى الجفون به % % ومفتت تشقى به الكبد % 3(@)(@@) % ليت الذين لحوا على شغفي % % بمعذبي يجدون ما أجد % % PageV01P1648 البحر : - 1(@)(@@) % ويح الطبيب الذي جست يداه يدك % % ما كان أشجعه فيما به اعتمدك % 2(@)(@@) % لو أن ألحاظه كانت مباضعه % ثم انتحاك بها من رقة فصدك % 3(@)(@@) % يا واضح الثغر كم تدل على الص % ب كان قد أذقته بردك % 4(@)(@@) % عجبت من قتلك النجد القوي ولو % % يشا رخو القوى ثناك أو عقدك % % PageV01P1649 البحر : - 1(@)(@@) % في كبدي جمرة نكت كبدي % % وفي غد منى لبعد غد % 2(@)(@@) % وبي سقام جوى الفؤاد كما % % عندي صنوف له من الكمد % 3(@)(@@) % تعيى يدي والظلام معتكر % % من طول مدي إلى السماء يدي % % 4(@)(@@) % واكبدا قد ضنيت فما % % أقدر ضعفا أقول واكبدي % % PageV01P1650 البحر : - 1(@)(@@) % كمد ليس ينفد % وهموم تجدد % 2(@)(@@) % وفؤاد به من ال % % وجد 
ms444	 نار توقد % 3(@)(@@) % يا بديعا له البري % ة بالحسن تشهد % 4(@)(@@) % كم إلى كم تصد عن % ي ظلما وتبعد % 5(@)(@@) % نم هنيئا فمقلتي % % فيك بالشوق تسهد % PageV01P1651 البحر : - 1(@)(@@) % مازادني نظري يا من سررت به % % إليك إلا اشتياقا فوق ما أجد % 2(@)(@@) % حجبت لما حجبت النوم عن بصري % % وخانني في هواك الصبر والجلد % 3(@)(@@) % رأيت حظي من الدنيا وإن حسنت % لغيرنا فيك حظا عابه النكد % 4(@)(@@) % فالحمد لله ما ينفك من كمد % قلبي عليك فقد أودى بي الكمد % PageV01P1652 البحر : - 1(@)(@@) % سأنظر نحو دارك حين أخشى % % على كبدي التفتت من بعيد % 2(@)(@@) % كما نظر الأسير إلى طليق % يؤم بلاده لحضور عيد % 3(@)(@@) % سيتلف في الهوى وجدا فؤادي % % ولو كان الفؤاد من الحديد % PageV01P1653 البحر : - 1(@)(@@) % ألف بين الفؤاد والكمد % وحال دون العناء والجلد % 2(@)(@@) % ظبي غرير كأن ريقته % نكهة خمر نزل في برد % % 3(@)(@@) % يا منية النفس لو أبوح بها % % ويا شفاء السقام والكمد % 4(@)(@@) % أصبر حتى أموت فيك ولا % % أشكو الذي شفني إلى أحد % 5(@)(@@) % خشيت أني ومن كلفت به % % لا نتلاقى ونحن في بلد % % 6(@)(@@) % لعل دهرا فجعت فيه بكم % % يعقب حتى أراك طوع يدي % % PageV01P1654 البحر : - 1(@)(@@) % يا آل نوبخت كفوا من غزالكم % % عني فلم يترك قلبا ولا جسدا % % 2(@)(@@) % أنا الصديق الذي لا شك فيه فلم % أورثتموني على ودي لكم كمدا % % 3(@)(@@) % ردوا علي فؤادي قد أصبت به % % أو حاكموني وإلا فابذلوا القودا % % 4(@)(@@) % لئن تصيدني ظبي بمثلته % % لقد تصيد الظبا من قبله الأسدا % % 5(@)(@@) % أستودع الله من لو شاء أنصفني % % ورد قلبي وأولاني بذاك يدا % % PageV01P1655 البحر : - 1(@)(@@) % فديت دما أريق من الفصيد % تغير منه مسموم الصعيد % 2(@)(@@) % دم قد كنت أنظر من قريب % إليه فصرت أنظر من بعيد % 3(@)(@@) % فلو أني ظفرت به لأضحى % % خلوقا بين سالفتي وجيدي % % 4(@)(@@) % عجبت لساعد يدميه لحظي % % ويقوى أن يباشر بالحديد % PageV01P1656 البحر : - 1(@)(@@) % تلقى بتسبيحة من حسن ما خلقت % % وتستفز حشا الرائي بإرعاد % 2(@)(@@) % كأنما أفرغت من قشر لؤلؤة % % فكل أكنافها وجه بمرصاد 
ms445	 % PageV01P1657 البحر : - 1(@)(@@) % تعجل مولود ليمهل والد % ولا بدع قد يحمي العشيرة واحد % 2(@)(@@) % لقد دافع المفقود عنك بنفسه % % عراما فلا يحزنك أنك فاقد % 3(@)(@@) % ومن قبلت منه الليالي فداءه % % فحق بأن يلقينه وهو حامد % 4(@)(@@) % على أن من قدمت عال مكانه % % بحيث الثريا أو بحيث الفراقد % 5(@)(@@) % وما مات منه أسوة الناس ميت % بل انقض منه المشترى أو عطارد % 6(@)(@@) % وما كأخ لو خيرت عرضة فدية % % ولا ولدا يشربه بالأجر والد % 7(@)(@@) % وما كان لو حكمت جنة بذله % % ولو حوذرت أنياب دهر حدائد % 8(@)(@@) % بل النفس تفدى النفوس وتشترى % % فتبذل منها المنفسات التلائد % 9(@)(@@) % ولكن أبى إلا افتداء بنفسه % % لنفسك جادته الغوث الرواعد % 10(@)(@@) % عظيم وفى النعمى عظيما وماجد % % فدى ماجدا لا زال يفديه ماجد % PageV01P1658 11(@)(@@) % سوى البدر والنجمين والعترة التي % % نصالح فيها دهرنا ونفاسد % 12(@)(@@) % أولئك كانوا قدوة بل مواهبا % فذاد الردى عنهم ير الدهر ذائد % % 13(@)(@@) % مضى ابنك والآمال تكنف نعشه % % وتبكيه للمعروف وهي حواشد % 14(@)(@@) % ولو عاش عاشت في ذراه وأورقت % لها من عطاياه غصون موائد % 15(@)(@@) % فما عندنا إلا شؤون حوافل % % تجود عليه أو عيون سواهد % 16(@)(@@) % وإلا تأسينا مرارا وقولنا % % هو الدهر لا تبقى عليه الجلامد % 17(@)(@@) % قرى ما تمج النحل ثم استرده % % وأصبح يقري ما تمج الأواسد % 18(@)(@@) % ومن ذاك ذم الصالحون أموره % وقالوا جميعا صالح الدهر فاسد % 19(@)(@@) % ومن ذاك ما أولاكه وهو بادئ % ومن ذاك ما أبلاكه وهو عائد % 20(@)(@@) % وبيناه من فرط الموالاة قابل % إذا هو من فرط المعاداة عاند % PageV01P1659 21(@)(@@) % ومن عقده عند العطايا ارتجاعه % % وأن ينقض العقد الذي هو عاقد % 22(@)(@@) % وما ابنك إلا من بني النشء والبلى % % لكل على حوض المنون موارد % 23(@)(@@) % وما ابنك إلا مستعار رددته % وكل عواري الزمان ردائد % 24(@)(@@) % وما ابنك إلا وافد نحو ربه % % ومن أوفدته عزمة الله وافد % 25(@)(@@) % فإما اشتراه الله منك فما اشترى % % ضنين بإرغاب ولا باع زاهد % 26(@)(@@) % فصبرا فإن الصبر خير مغبة % وهل من محيد عنه إن حاد 
ms446	 حائد % 27(@)(@@) % وقد فزت أن أصبحت عبدا مسلما % لما أوجبته في الرقاب القلائد % 28(@)(@@) % لك الأجر تعويضا من الله وحده % % ومن خلقه حسن الثنا والمحامد % 29(@)(@@) % ولله لطف في العزاء لعبده % % وإن مسه جهد من الحزن جاهد % 30(@)(@@) % هو الجارح الآسي ولا شك أنه % % سيشفي الحشا المجروح مما يكابد % PageV01P1660 31(@)(@@) % ويحبوك بالعمر الطويل متابعا % لك الرفد والمبتز إن شاء رافد % 32(@)(@@) % أخا العلم والحلم اللذين كلاهما % % يؤازره في أمره ويعاضد % 33(@)(@@) % ألم تك من هذا المصاب بمنظر % ليالي كان ابن النذور يجاهد % 34(@)(@@) % ولا تحسبن الرزء لم يك واقعا % ولا تعتقده طارفا فهو تالد % 35(@)(@@) % ونحن بذور الدهر والدهر زارع % % ونحن زروع الدهر والدهر حاصد % 36(@)(@@) % وتالله ما مولى لمولاه خالد % % ولا الحزن من مولى لمولاه خالد % 37(@)(@@) % غدا الموت والسلوان حتما على الورى % % كلا ذا وهذا للفريقين راصد % 38(@)(@@) % فلا تجعلن الموت نكرا فإنما % % حياة الفتى سير إلى الموت قاصد % 39(@)(@@) % ولا تحسبن الحزن يبقى فإنه % % شهاب حرق واقد ثم خامد % 40(@)(@@) % ستألف فقدان الذي قد فقدته % % كإلفك وجدان الذي أنت واجد % PageV01P1661 41(@)(@@) % على أنه لابد من لذع لوعة % تهب أحايينا كما هب راقد % % 42(@)(@@) % ومن لم يزل يرعى الشدائد فكره % % على مهل هانت عليه الشدائد % 43(@)(@@) % وللشر إقلاع وللهم فرجة % وللخير بعد المؤيسات عوائد % 44(@)(@@) % وكم أعقبت بعد البلايا مواهب % وكم أعقبت بعد الرزايا فوائد % 45(@)(@@) % وكم سيىء يوما سيقفوه صالح % وكم شامت يوما سيقفوه حاسد % 46(@)(@@) % تعز حجا قبل السلو على المدى % % فمثلك للحسنى من الأمر عامد % % 47(@)(@@) % وما أنت بالمرء المعلم رشده % % لعمر ولكن قد يذكر راشد % 48(@)(@@) % وعش في غاء والوزير كلاكما % % وكلكم والدهر طوع مساعد % % 49(@)(@@) % ترودون منه بين حظي سعادة % % لكم حاصل منها عتيد وواعد % 50(@)(@@) % وجد الذي يبغيكم الشر هابط % وجد الذي يبغيكم الخير صاعد % PageV01P1662 51(@)(@@) % وزارتكم بالمدح كل قصيدة % ولا قصدتكم بالمراثي القصائد % % 52(@)(@@) % أرى كل مدح قيل فيمن سواكم % فليست له إلا البيوت مناشد % 53(@)(@@) % وكل مديح قيل فيكم فإنما 
ms447	 % % مناشده دون البقاع المساجد % 54(@)(@@) % وما أنكرت تلك المشاهد فضلكم % % وهل ينكر المعروف تلك المشاهد % PageV01P1663 البحر : - 1(@)(@@) % لو يعلم الأعداء أين تحلني % % لعدوا بأظفار علي حداد % 2(@)(@@) % أو تبغض الدنيا كبغضك عشرتي % % أصبحت معدودا من الزهاد % % 3(@)(@@) % ولو اطلعت على هواي جعلتني % % بمحل روح من صميم فؤاد % % PageV01P1664 البحر : - 1(@)(@@) % شيخ لنا من آل مسعود % من أحذق الأمة بالعود % 2(@)(@@) % تستأنس الطير إلى قوسه % % كأنه محراب داوود % PageV01P1665 البحر : - 1(@)(@@) % لا أزال الله نعمته % % من جواد آخر الأبد % 2(@)(@@) % ورمى بالفقر من بخلت % كفه بالعرف عن أحد % 3(@)(@@) % أيصون المال للولد % % ثم يبقيه حذار غد % PageV01P1666 البحر : - 1(@)(@@) % لعمركما لو أطلقت السلو % % ك لم نهتجر هذه المده % 2(@)(@@) % ولكنه ليس في طاقتي % % قتال السماء بلا عده % PageV01P1667 البحر : - 1(@)(@@) % ملكتم يابني العباس عن قدر % بغير حق ولافضل على أحد % 2(@)(@@) % تقدمون أمام الناس كلهم % % وأنتم يابني العباس كالنقد % 3(@)(@@) % شبهتكم إن بغى باغ لكم مثلا % صغرى الأصابع تثني أول العدد % PageV01P1668 البحر : - 1(@)(@@) % يا ابن الزنيم ويا ابن ألفي والد % يا ابن الطريق لصادر ولوارد % 2(@)(@@) % مافيك موضع لسعة لبعوضة % إلا وفيه نطفة من واحد % PageV01P1669 البحر : - 1(@)(@@) % فتى على خبزه ونائله % % أشفق من والد على ولده % 2(@)(@@) % رغيفه منه حين يسأله % مكان روح الجبان من جسده % PageV01P1670 البحر : - 1(@)(@@) % تورد خديه يذكرني الوردا % % ولم أر أحلى منه شكلا ولا قدا % % 2(@)(@@) % وأبصرت في خديه ماء وخضرة % فما أملح المرعى وما أعذب الوردا % % 3(@)(@@) % كأن الثريا علقت في جبينه % % وبدر الدجى في النحر صيغ له عقدا % % 4(@)(@@) % وأهدت له شمس النهار ضياءها % % فمر بثوب الحسن مرتديا بردا % % 5(@)(@@) % ولم أر مثلي في شقائي بمثله % % رضيت به مولى ولم يرض بي عبدا % % PageV01P1671 البحر : - 1(@)(@@) % أرى ماء وبي عطش شديد % ولكن لاسبيل إلى الورود % 2(@)(@@) % أما يكفيك أنك تملكيني % % وأن الخلق كلهم عبيدي % % 3(@)(@@) % وأنك لو قطعت يدي ورجلي % % لقلت من الهوى أحسنت زيدي % % PageV01P1672 البحر : - 1(@)(@@) % رب ليل تراه كالدهر طويلا % قد تناهى فليس فيه مزيد % 2(@)(@@) % ذي نجوم 
ms448	 كأنهن نجوم الشي % ب ليست تغور لابل تزيد % PageV01P1673 البحر : - 1(@)(@@) % فإن يك سيار بن مكرم انقضى % % فإنك ماء الورد إن ذهب الورد % 2(@)(@@) % مضى وبنوه وانفردت بفضلهم % % وألف إذا ما جمعت واحد فرد % PageV01P1674 البحر : - 1(@)(@@) % ما أنصف الآس بالياسمين مشبهه % والآس منه مكان الياء مفقود % 2(@)(@@) % والياسمين إذا حصلت أحرفه % فاليأس منه مكان الياء معدود % 3(@)(@@) % إن الدليل على هذا تناثر ذا % % وأن ذاك على الأيام موجود % PageV01P1675 البحر : - 1(@)(@@) % فإن تسأليني ما الخضاب فإنني % % لبست على فقد الشباب حدادي % % PageV01P1676 البحر : - 1(@)(@@) % من سره ألا يرى ما يسوءه % فلا يتخذ شيئا يخاف له فقدا % % PageV01P1677 البحر : - 1(@)(@@) % كفاك من ذلتي للشيب حين أتى % % أني توليت نتفا لحيتي بيدي % % PageV01P1678 البحر : - 1(@)(@@) % يرتاح للنيلوفر القلب الذي % % لايستفيق من الغرام وجهده % 2(@)(@@) % والورد أصبح في الروائح عبده % % والنرجس النيلي خادم عبده % 3(@)(@@) % ياحسنه في بركة قد أصبحت % محشوة مسكا يشاب بنده % % 4(@)(@@) % وكأنه فيها قد لحظ الصبا % % ورمى المنام ببعده وبصده % 5(@)(@@) % مهجور حب ظل يرفع رأسه % % كالمستجير بربه من صده % 6(@)(@@) % وكأنه إذ غاب عند مسائه % % في الماء وانحجبت نضارة قده % 7(@)(@@) % صب يهدده الحبيب بهجره % % ظلما فعرق نفسه من وجده % PageV01P1679 البحر : - 1(@)(@@) % بعثت ببرني جني كأنه % % مخازن تبر قد ملئن من الشهد % 2(@)(@@) % مختمة الأطراف تنقد قمصها % % عن العسل الماذي والعنبر الهندي % % 3(@)(@@) % ينقل من خضر الثياب وصفرها % % إلى حمرها مابين وشي إلى برد % 4(@)(@@) % فكم لبثت في شاهق منه لاترى % % ولاتجتنى باللحظ إلا من البعد % 5(@)(@@) % ألذ من الشكوى وأحلى من المنى % % وأعذب من وصل الحبيب على الصد % PageV01P1680 البحر : - 1(@)(@@) % وحية في رأسها درة % تسبح في بحر قصير المدى % % 2(@)(@@) % إن بعدت كان العمى حاضرا % وإن دنت بان طريق الهدى % % PageV01P1681 البحر : - 1(@)(@@) % لم أخضب الشيب للغواني % % أبغي به عندهم ودادا % % 2(@)(@@) % لكن خضابي على شبابي % % لبست من بعده حدادا % % PageV01P1682 البحر : - 1(@)(@@) % فلو شهدت مقامي ثم أنديتي % % يوم الخصام وماء الموت يطرد % 2(@)(@@) % في فتية لم يلاق الناس إذ وجدوا % % لهم شبيها ولا 
ms449	 يلقون إن فقدوا % % 3(@)(@@) % مجاوروالفضل أفلاك العلا سبل ال % % تقوى محل الهدى عمد النهى الوطد % % 4(@)(@@) % كأنهم في صدور الناس أفئدة % % تحسن ما أخطأوا فيها وما عمدوا % % 5(@)(@@) % يبدون للناس ما تخفي ضمائرهم % % كأنهم وجدوا منها الذي وجدوا % % 6(@)(@@) % دلوا على باطن الدنيا بظاهرها % % وعلم ما غاب عنهم بالذي شهدوا % % 7(@)(@@) % مطالع الحق ما من شبهة غسقت % إلا ومنهم لديها كوكب يقد % PageV01P1683 البحر : - 1(@)(@@) % لو كان مثلك في زمان محمد % % ماجاء في القرآن بر الوالد % PageV01P1684 البحر : - 1(@)(@@) % لئن فخرت بآباء ذوي حسب % % لقد صدقت ولكن بئس ما ولدوا % % PageV01P1685 البحر : - 1(@)(@@) % وإخوان اتخذتهم دروعا % فكانوها ولكن للأعادي % % 2(@)(@@) % وخلتهم سهاما صائبات % % فكانوها ولكن في فؤادي % % 3(@)(@@) % وقالوا قد صفت منا قلوب % لقد صدقوا ولكن من ودادي % % PageV01P1686 البحر : - 1(@)(@@) % إذا مطلت امرأ بحاجته % % فامض على منعه ولاتحد % 2(@)(@@) % فلست تلقاه شاكرا ليد % قد كدها المطل آخر الأبد % PageV01P1687 البحر : - 1(@)(@@) % هذا مقام يابني وائل % % من مستجير بكم عائذ % 2(@)(@@) % أنشب فيه الدهر أظفاره % % وعضه بالناب والناجذ % 3(@)(@@) % فأنصفوا منه أخا حرمة % لاذ بكم منه مع اللائذ % 4(@)(@@) % فما أرى الدهر على حكمه % % يخرج من حكمكم النافذ % PageV01P1688 البحر : - 1(@)(@@) % إذا حاولت تطفيلا % فكن في ذاك أستاذا % % 2(@)(@@) % ألا واجعله تطفيلا % ذليق الحد نفاذا % % 3(@)(@@) % كتطفيل سليمان % % على إمرة بغداذا % % 4(@)(@@) % تعالى الله ما أمضا % % ه في التطفيل ياهذا % % 5(@)(@@) % أغذ السير من آم % ل للتطفيل إغذاذا % % 6(@)(@@) % وخلى طبرستان % % على الديلم آزاذا % % 7(@)(@@) % ولما جاء بغداد % % رأيت الناس أنباذا % % 8(@)(@@) % فما ألف أشتانا % ولاشتت شذاذا % % 9(@)(@@) % ولا اسطاع لمن رجى % % به الإنفاذ إنفاذا % % 10(@)(@@) % بلى شارك في الطعم % % ة قوادا ونباذا % % PageV01P1689 11(@)(@@) % ففي بغداذ حانات % تباهي طيزناباذا % % 12(@)(@@) % لا جعل الله للزواني % % من حيلي للزنا معاذا % % 12(@)(@@) % أمور لكم تكن ترضى مخلع البسيطاطعن بحد المقمده قدما ما اسطاع في مطعن نفاذا في أم هذا وبنت هذاوأخت هذا وعرس هذا فلست تعدو هناك إماإراك ثار أو التذاذا لا جعل الله للزوانيمن حيلي للزنا معاذا % % بها 
ms450	 بنا وكلواذا % % 12(@)(@@) % اطعن بحد المقمده قدما % ما اسطاع في مطعن نفاذا % % 12(@)(@@) % في أم هذا وبنت هذا % % وأخت هذا وعرس هذا % % 12(@)(@@) % فلست تعدو هناك إما % % إراك ثار أو التذاذا % % PageV01P1690 البحر : - 1(@)(@@) % رب هب لي في أبي الفضل رذاذ % % عوذة الصحة ياخير معاذ % 2(@)(@@) % واصطنعه واتخذه للعلا % % إنه أهل اصطناع واتخاذ % 3(@)(@@) % ماجد ينفذ في حكمته % % ومساعي بره كل النفاذ % 4(@)(@@) % أنعم الله على أخلاقه % % وغذاه بنعيم العيش غاذي % % 5(@)(@@) % فهو من ظرف وحلم وندى % % تستوي أفعاله مثل الفذاذ % 6(@)(@@) % لجواب العود منه حقه % % حين يهذي في جواب العود هاذي % % 7(@)(@@) % اسقني واشرب على صحته % % إنه عيد اصطباح والتذاذ % 8(@)(@@) % من شمول ذات صبغ قانىء % نحلتها اللون أحجار بجاذي % % 9(@)(@@) % ينزل الهم على أحكامها % % فترى أحكام سعد بن معاذ % 10(@)(@@) % تلك أو صفراء صاف لونها % % عتقت من عهد كسرى بن قباذ % PageV01P1691 11(@)(@@) % وأبي الفضل يمينا إنه % % لوصول غير ذي حبل جذاذ % 12(@)(@@) % عاذ أهل الظرف منه بفتى % % مثقب الزند ولاذوا بملاذ % 13(@)(@@) % عمر الله اللذاذات به % % تحت أيام اسمه ذات الرذاذ % % PageV01P1692 البحر : - 1(@)(@@) % سمي خليل الله لازلت مثله % % يعيذك من كيد العداة معيذه % 2(@)(@@) % نجوت كمنجاه كما اسمك كاسمه % % فأنت نقيذ الله وهو نقيذه % 3(@)(@@) % تشابهتما هديا فأنت محبب % لذيذ مذاق الذكر وهو لذيذه % 4(@)(@@) % كما اشتبه النمروذ والحائن الذي % % سيتبعه والبغي جم وقيذه % 5(@)(@@) % اتخذت من المعروف درعا حصينة % % وقتك من الطاغي وينت أخيذه % % PageV01P1693 البحر : - 1(@)(@@) % وصافية مابها من قذى % % لها نفحات تذود الشذا % % 2(@)(@@) % تميت الهموم وتحيي السرور % % وتشفي السقام وتنفي الأذى % % 3(@)(@@) % كأن الأماني مثلنها % % فقال لها الله كوني كذا % % 4(@)(@@) % تغادر عينك مطروفة % % وأذنك حمراء فيها خذا % % PageV01P1694 البحر : - 1(@)(@@) % شحا فاه كالتنين نحوي شحوة % % فقلت له بالله منك أعوذ % 2(@)(@@) % وأقرب بنصر الله من متضعف % % يصول عليه القرن وهو يلوذ % PageV01P1695 البحر : - 1(@)(@@) % ما أوجب العفو على سيد % ما لامرىء منه سواه ملاذ % 2(@)(@@) % وأوجب الشكر على منقذ % من سطوة لم يك منها معاذ % 3(@)(@@) % إن 
ms451	 الصاديد بني مخلد % % لهم بإحياء النفوس التذاذ % 4(@)(@@) % فارجع إليهم واتخذ منهم % ردءا ففيهم للأريب اتخاذ % 5(@)(@@) % وأسألهم تمطرك أيديهم % عرفا خلال الوبل منه رذاذ % 6(@)(@@) % لاتنتبذ عنهم فما عنهم % لطالب الحظ الجزيل انتباذ % 7(@)(@@) % واقصد أبا عيسى فثم الندى % % والحلم والعلم وثم النفاذ % 8(@)(@@) % ألحاظه فضل وألفاظه % % فصل وإن هز سيف هذاذ % 9(@)(@@) % تكافأت في الفضل أحواله % % كما استوت في سهم رام قذاذ % 10(@)(@@) % كم هنة لولاه لم تنصرف % % إلا وأشلاء أناس جذاذ % PageV01P1696 البحر : - 1(@)(@@) % رأيت في المائق ما لا يرى % % ورأيه في نفسه أنفذ % 2(@)(@@) % إذا تذكرت مديحي له % % حسبته من كبدي يفلذ % PageV01P1697 البحر : - 1(@)(@@) % ياصلعة لأبي حفص ممردة % كأن ساحتها مرآة فولاذ % 2(@)(@@) % ترن تحت الأكف الواقعات بها % % حتى ترن لها أكناف بغداذ % 3(@)(@@) % كم من غناء سمعنا في جوانبها % % من حاذق بلحون الصفع أستاذ % 4(@)(@@) % لا شيء أحسن منها حين تأخذها % % من الأكف سماء ذات إرذاذ % % PageV01P1698 البحر : - 1(@)(@@) % لم أتخذ منك غير متخذ % فما لحظي غدا بمنتبذ % % 2(@)(@@) % ما إن أرى رقية تقربني % % منك ولا أخذة من الأخذ % 3(@)(@@) % يكفيك أني أراك تجتبذ ال % % ناس وآتيك غير مجتبذ % 4(@)(@@) % محبة لا قربت منك متى % % لم يتمثل بها ولم يشذ % 5(@)(@@) % لاتسلمني إلى الزمان وقد % % أنقذتني منه أيما نقذ % 6(@)(@@) % إن كنت بعض الثقال فاحتمل ال % % ثقل تجدني في السد ذا نفذ % 7(@)(@@) % لا تحقرني فربما نفدت % في هدم يأجوج حيلة % 8(@)(@@) % صني أكن كالحسام أخلصه ال % % قين فأضحى من خير متخذ % 9(@)(@@) % مطرد المتن كل مطرد % منشحذ الحد كل منشحذ % 10(@)(@@) % هبني بعض المثقلات حوا % % ليك وهب خلقتي من العوذ % PageV01P1699 11(@)(@@) % بل كم ثقال تطبعوا بسجا % % ياك فأضحوا في خفة القذذ % 12(@)(@@) % يا آل وهب غدا عدوكم % % مفترس الشلو غير منتقذ % 13(@)(@@) % من ذا الذي عاذ من جفائكم % % بلين أعطافكم فلم يعذ % 14(@)(@@) % أنا الذي حجكم وكعبتكم % % لم يتطوف بها ولم يلذ % 15(@)(@@) % فلا يقطع جفاؤكم كبدي % % فحبكم بين تلكم الفلذ % PageV01P1700 البحر : - 1(@)(@@) % يا أيها السيد 
ms452	 الذي طهرت % % به من المنكرات بغداذ % 2(@)(@@) % ومن غدا وهو للخبائث تر % اك وللطيبات أخاذ % 3(@)(@@) % مبارك في يديه للمال إه % % لاك وللهالكين إنقاذ % 4(@)(@@) % أعوذ من عسرتي بيسرك وال % % أحرار بالأكرمين عواذ % PageV01P1701 البحر : - 1(@)(@@) % لابدع إن ضحك القتير % فبكى لضحكته الكبير % 2(@)(@@) % عاصى العزاء عن الشبا % % ب فطاوع الدمع الغزير % 3(@)(@@) % كيف العزاء عن الشبا % % ب وغصنه الغصن النضير % 4(@)(@@) % كيف العزاء عن الشبا % % ب وعيشه العيش الغرير % 5(@)(@@) % بان الشباب وكان لي % % نعم المجاور والعشير % 6(@)(@@) % بان الشباب فلا يد % نحوي ولا عين تشير % 7(@)(@@) % ولقد أسرت به القلو % % ب فقلبي اليوم الأسير % 8(@)(@@) % سقيا لأيام مضت % وطويلها عندي قصير % 9(@)(@@) % أيام لي بين الكوا % % عب روضة فيها غدير % 10(@)(@@) % أصبى وأصبي الغانيا % % ت وأستزار وأستزير % PageV01P1702 11(@)(@@) % بيض الوجوه عقائلا % لم يصبهن سواي زير % 12(@)(@@) % أبشارهن وما ادرع % % ن من الحرير معا حرير % 13(@)(@@) % وجمالهن وما لبس % ن من الحبير معا حبير % 14(@)(@@) % ونسيمهن وما مسس % ن من العبير معا عبير % 15(@)(@@) % من كل ناعمة الشبا % % ب كأنها الخوط الهصير % 16(@)(@@) % مهتزة الأعلى يجا % % ذب خصرها ردف وثير % 17(@)(@@) % جمع الشباب ولهونا % % فيه الخورنق والسدير % 18(@)(@@) % مبدى المناذرة الذي % % فيه الفواكه لا البرير % 19(@)(@@) % كم جنة فيه وكم % % نهر لجريته خرير % 20(@)(@@) % من كل دانية الجنى % % للطير فيها قرقرير % PageV01P1703 21(@)(@@) % يشتقها طامي الجما % % م على جوانبه الغمير % 22(@)(@@) % يضحي إذا جرت الصبا % % وكأن ضاحيه حصير % 23(@)(@@) % ها إن ذاك لمنزل % من كل صالحة عمير % 24(@)(@@) % شجر ونخل لا يطي % % ر غراب أيكهما مطير % 25(@)(@@) % ومتى نشاء بدت لنا % % أم الفرير أو الفرير % 26(@)(@@) % لهفي لعيشتنا هنا % % لك والقذى عنها طحير % % 27(@)(@@) % إذ نحن أتراب النعي % % م ودر دنيانا درير % 28(@)(@@) % كل لكل في الشبا % % ب وفي مناعمه سجير % 29(@)(@@) % تشدو لنا ريا البنا % % ن على معاصمها الحبير % 30(@)(@@) % قد أدميت لباتها % % مسكا كما يدمى العتير % PageV01P1704 31(@)(@@) % وشرابنا وردية % لكؤوسها شرر يطير % 32(@)(@@) % هدرت فلما استفحلت % في دنها سكن 
ms453	 الهدير % 33(@)(@@) % حمراء في يد أحمر ال % % وجنات ملثمه مهير % 34(@)(@@) % متأمل لا يجتوى % % منه القبيل ولا الدبير % 35(@)(@@) % واها لقولي للمدي % % ر وقد سقانيها المدير % 36(@)(@@) % أعصير خمرك هذه % % من ماء خدك أم عصير % 37(@)(@@) % سقي الشباب وإن عفا % % آثار معهده القتير % 38(@)(@@) % ما كان إلا الملك أو % دى تاجه وهوى السرير % 39(@)(@@) % رحل المطي لنية % زوراء مطلبها شطير % 40(@)(@@) % فكأن في الأحشاء ني % % رانا يضرمهن كير % PageV01P1705 41(@)(@@) % هون عليك فإنها % % خلع أعاركها معير % 42(@)(@@) % والدهر يقسم مرة % نفلا وآونة يغير % 43(@)(@@) % وأبو الفوارس أحمد % لمن استجار به مجير % 44(@)(@@) % أضحى ظهيرا للذي % % أضحى وليس له ظهير % % 45(@)(@@) % فاجعل خفارته ذرا % % ك فإنه نعم الخفير % 46(@)(@@) % شهدت مآثره بذا % % ك ووجهه ذاك الطرير % 47(@)(@@) % ياابن المسمى باسم من % % جرت الرياح به تطير % 48(@)(@@) % والطير أظلال علي % % ه لها هديل أو صفير % 49(@)(@@) % أعني سليمان الذي % % في رمسه قمر وشير % 50(@)(@@) % سيف الملوك إذا تجا % % وب من ذوي الفتن النعير % PageV01P1706 51(@)(@@) % لله ماذا ضمه % من شيخك الجدث الحفير % 52(@)(@@) % لكن من أنت ابنه % ما مات أو ميت نشير % 53(@)(@@) % لله خالك ذو المكا % % رم إنه بك للخبير % 54(@)(@@) % لو لم يقلدك الأمو % % ر لما استمر لها مرير % 55(@)(@@) % نثل الجفير فكنت أه % زع ماتضمنه الجفير % 56(@)(@@) % فرمى بك الغرض البعي % % د مسدد لا يستشير % 57(@)(@@) % أقسمت بالهدي النحي % % ر ومن له الهدي النحير % 58(@)(@@) % إن كان حاباك القضا % % ء بما حباك به الوزير % 59(@)(@@) % كلا ولا كان الهوى % % هو عند ذاك بك المشير % 60(@)(@@) % لكن رأى فيك الوزي % % ر كما رأى فيه الأمير % PageV01P1707 61(@)(@@) % فصغى إليك برأيه % % والحاسدون لهم زفير % 62(@)(@@) % ألقى خلافته إلي % % ك وقدرها القدر الخطير % 63(@)(@@) % علما بفضلك في الرجا % % ل وفضلك الفضل الشهير % 64(@)(@@) % فطفقت تسلك فجه % وتسير فيه كما يسير % 65(@)(@@) % لا تخطىء الرأي الموف % فق حين تسدي أو تنير % 66(@)(@@) % فهناك وافق في اختيا % % رك مستخارا مستخير % 67(@)(@@) % ولما حبيت برتبة % إلا وأنت بها 
ms454	 جدير % 68(@)(@@) % فافخر على أن الجلي % % ل من الأمور لكم حقير % 69(@)(@@) % عين الأمير هي الوزي % % ر وأنت ناظرها البصير % 70(@)(@@) % طابقت أحكام الوزي % % ر تبير قوما أو تمير % PageV01P1708 71(@)(@@) % وعملت ما عمل المشا % % رك في البضاعة لا الأجير % 72(@)(@@) % فالليل منذ خلفته % ليل قصير مستنير % 73(@)(@@) % لا الخوف فيه ولا السها % % د ولا الظلام المستحير % 74(@)(@@) % ترك القطا فيه فنا % % م بحيث ليس له مثير % 75(@)(@@) % يا أحمد الخير المؤم % مل حين تخشى العنقفير % 76(@)(@@) % هذا مقام المستجي % % ر وأنت أكرم من يجير % 77(@)(@@) % أأقول فيكم ما أقو % % ل فلا يكون له حوير % 78(@)(@@) % ما لي حرمت وقد سأل % تكم وإني للفقير % 79(@)(@@) % ومدائحي تترى يجو % % د بها لساني والضمير % 80(@)(@@) % إذ لم أنل من فضلكم % % مقدار مايزن النقير % PageV01P1709 81(@)(@@) % ولطالما استغنى الفقي % % ر بكم وما انجبر الكسير % 82(@)(@@) % انظر إلي أبا الفوا % % رس يسهل الأمر العسير % % 83(@)(@@) % بين العباد وربهم % في قسم زرقهم سفير % 84(@)(@@) % ووزيرنا ذاك السفي % % ر فمن سواه نستمير % 85(@)(@@) % في ظله الكلأ المري % % ع خلاله الماء النمير % 86(@)(@@) % فامنن علي بجانب % منه فقد حمي الهجير % % 87(@)(@@) % واعجل بعرفك ما استطع % % ت فأفضل العرف البكير % 88(@)(@@) % أو قل لعبدك كيف يص % % نع إنه لك مستشير % 89(@)(@@) % أين المميل عن الوزي % % ر أو الرحيل أو المسير % 90(@)(@@) % هل للمحرب غيره % % في كل نائبة مصير % PageV01P1710 91(@)(@@) % من وجهه الوجه الجمي % % ل وشخصه الشخص الجهير % 92(@)(@@) % من منه المن القلي % % ل وفضله الفضل الكثير % 93(@)(@@) % من جوده الجود الشهي % % ر وبذله البذل الستير % 94(@)(@@) % من قوله وفعاله % سمران ما اسمر السمير % 95(@)(@@) % من لا نصير لما له % % ولجاره أبدا نصير % 96(@)(@@) % من نيل غايته يشق % ق ونيل نائله يسير % 97(@)(@@) % من كل أمر حين يذ % % كر أمرهأمر صغير % 98(@)(@@) % إلا أبا الصقر الذي % % أضحى وطالبه حسير % 99(@)(@@) % رجع المماطله الجرا % % ء وحظه النفس البهير % 100(@)(@@) % ملك غدت أفعاله % والعرف فيها والنكير % PageV01P1711 101(@)(@@) % يوماه يوم ندى ويو % % م ردى 
ms455	 عبوس قمطرير % 102(@)(@@) % في ذا وذاك كليهما % % خير وشر مستطير % 103(@)(@@) % فوليه لوليه % أبدا بناقلة بشير % 104(@)(@@) % وعدوه لعدوه % أبدا بنازلة نذير % 105(@)(@@) % كافي ملوك لا يفن % % ند ما يجيل وما يدير % 106(@)(@@) % ركدت على أقطابه % % أرحاء ملك تستدير % 107(@)(@@) % لو كان في أولى الزما % % ن لظل مزدك لا يحير % 108(@)(@@) % وغدا أنو شروان مف % % تقرا إليه وأردشير % 109(@)(@@) % تجف القلوب إذا غدت % أقلامه ولها صرير % 110(@)(@@) % ضخم الدسيعة والفعا % % ل نبيه مملكة ذكير % PageV01P1712 111(@)(@@) % جمعت له أشياء لم % % يخلق له فيها نظير % 112(@)(@@) % فيه الوسامة والندى % % والحلم والرأي الزبير % 113(@)(@@) % فإذا بدا في موكب % فكأنه القمر المنير % 114(@)(@@) % وإذا احتبى في مجلس % فكأنما أرسى ثبير % 115(@)(@@) % وإذا تهلل بالندى % % فكأنه الغيث المطير % % 116(@)(@@) % وإذا رمى بمكيدة % فكأنه القدر المبير % % 117(@)(@@) % تتحرك الأشياء غب % ب سكونه ولها نفير % 118(@)(@@) % لروية منه نتيجتها % % نقيذ أو عقير % 119(@)(@@) % أضحى يحل بحيث يل % % قى المستميح المستجير % 120(@)(@@) % لا يستعير له المما % % دح من سواه مستعير % PageV01P1713 121(@)(@@) % بل يستثير له المما % % دح من ثراه المستثير % 122(@)(@@) % لولاه أصبحت الركا % % ئب لا يئط لها صفير % 123(@)(@@) % يا آل بلبل الكرا % % م بيمنكم صلح العذير % 124(@)(@@) % لولاكم غدت الرعي % ية كلها والمخ رير % 125(@)(@@) % فابقوا لنا في غبطة % ما أوغلت في الأرض عير % 126(@)(@@) % وغدا الألى عادوكم % % ومقام أرجلهم شفير % 127(@)(@@) % لا زالت الدنيا لهم % % مهوى قرارته السعير % 128(@)(@@) % أعي على طلابكم % أن تدرك الخيل الحمير % 129(@)(@@) % تتبسمون إذا اللئا % % م تبسروا ولهم هرير % 130(@)(@@) % وتبسلون إذا السبا % % ع تنمرت ولها زئير % PageV01P1714 131(@)(@@) % رددت فيكم ناظري % ي فكلكم كرم وخير % 132(@)(@@) % شرفت أوائلكم وأش % % به أولا فيكم أخير % 133(@)(@@) % وحرمت منكم والإل % % ه على مردكم قدير % 134(@)(@@) % لاتتركوا الطرف الجوا % % د خليع مضيعة يعير % % 135(@)(@@) % خذها إليك أبا الفوا % % رس حلية بك تستنير % 136(@)(@@) % ماضرها أن لا يعي % % ش لها الفرزدق أو جرير % 137(@)(@@) % اسلم على حدث الزما % % ن وأنت بالحسنى أثير % 138(@)(@@) % حتى يصدق من 
ms456	 كنا % % ك فوارس لهم كرير % PageV01P1715 البحر : - 1(@)(@@) % أعف أخاك المريض من حرج % أعفاه منه الإله في زبره % % 2(@)(@@) % هب لأخي السكر ماجناه % وعاقبه إذا ماأفاق من سكره % % PageV01P1716 البحر : - 1(@)(@@) % تعنت بالمسواك أبيض صافيا % تكاد عذاري الدر منه تحدر % 2(@)(@@) % وما سر عيدان الأراك بريقها % % تناوحها في أيكها تتهصر % 3(@)(@@) % لئن عدمت سقيا الثرى إن ريقها % % لأعذب من هاتيك سقيا وأخصر % 4(@)(@@) % وما ذقته إلا بشيم ابتسامها % % وكم مخبر يبديه للعين منظر % 5(@)(@@) % بدا لي وميض مخبر أن صوبه % غريض وما عندي سوى ذاك مخبر % 6(@)(@@) % ولا عيب فيها غير أن ضجيعها % % وإن لم تصبها الساهرية يسهر % 7(@)(@@) % تذود الكرى عنه بنشر كأنما % % يضوعه مسك ذكي وعنبر % 8(@)(@@) % وما تعتريها آفة بشرية % من النوم إلا أنها تتخثر % 9(@)(@@) % وغير عجيب طيب أنفاس روضة % منورة باتت تراح وتمطر % 10(@)(@@) % كذلك أنفاس الرياض بسحرة % تطيب وأنفاس الأنام تغير % PageV01P1717 البحر : - 1(@)(@@) % تربصت بي ريب المنون تجرني % % على مطلك الممدود عصرا إلى عصر % 2(@)(@@) % وأعطيتني زاد المسافر عالما % بقلة ماأبقى مطالك من عمري % % 3(@)(@@) % ومثل امرىء أفنى مطالك عمره % كفاه لعمري مثل نائلك النزر % PageV01P1718 البحر : - 1(@)(@@) % ياسيدا لم يلتبس عرضه % بذم رائية ولا خابره % 2(@)(@@) % ظاهره أحسن من غيبه % % وغيبه أحسن من ظاهره % 3(@)(@@) % ومن إذا الرأى خبا نوره % فإنما يقدح من خاطره % 4(@)(@@) % فلا ترى أثقب من ذهنه % فيه ولا أيمن من طائره % 5(@)(@@) % أول ما أسأل من حاجة % أن تقرأ الشعر إلى آخره % 6(@)(@@) % قراءة تصدر عن نية % تفهم قلب المرء عن ناظره % % 7(@)(@@) % ثم كفاني بالذي ترتئي % % في جيد الشعر وفي شاعره % 8(@)(@@) % وما أرى التقصير يخشى على % % فعلك بل يخشى على شاكره % PageV01P1719 البحر : - 1(@)(@@) % أبلغ فتى آل بشر بل مؤملهم % رسالة ليس في أمثالها عار % 2(@)(@@) % هل جائز يا أبا العباس أو حسن % وأنت شهم ذكي القلب نظار % 3(@)(@@) % ظلم تمادون فيه لا يرى لكم % عنهوإن سكت المظلومإقصار % 4(@)(@@) % ما هازباء مصيد في فنائكم % مثل السبائك أشيار وأفتار % 5(@)(@@) % في كل 
ms457	 يوم تغاديكم وظائفكم % % منه وإخوانكم من ذاك أصفار % 6(@)(@@) % أنتم أصحاء والمرضى أحق به % % فأنصفوا إن أهل العدل أبرار % 7(@)(@@) % أولا ففي درهم مايستعف به % % عنكم وتقضى لبانات وأوطار % 8(@)(@@) % فكلمونا إذا جئنا لحاجتنا % % إنا بذلك نستوفي ونختار % 9(@)(@@) % ولا تشحوا علينا أن نغرمكم % % فيلتقي فيكم بخل وإضرار % 10(@)(@@) % أقول قولي وقد أنذرتكم غضبي % % ياسادة الناس والإنذار إعذار % PageV01P1720 11(@)(@@) % وقد خصصت أبا عيسى بلائمتي % % إذ لم يكن منه تنبيه وإذكار % 12(@)(@@) % أدللت منكم على أحرار دهركم % وليس يستثقل الإدلال أحرار % 13(@)(@@) % فلا يقابل بإنكار فإنكم % قوم لكم بحقوق المجد إقرار % PageV01P1721 البحر : - 1(@)(@@) % وكم حاجب غضبان كاسر حاجب % محا الله مافيه من الكسر بالكسرص عبوس إذا حييته بتحية % 2(@)(@@) % فيا لك من كبر ومن منطق نزر % يظل كأن الله يرفع قدره % 3(@)(@@) % بما حط من قدري وصغر من أمري % % إذا ما رآني عاد أعمى بلا عمى % 4(@)(@@) % وصم سميعا ما بأذنيه من وقر % أزف إليك البكر ما زف مثلها % % 5(@)(@@) % فيدفع منها في الترائب والنحر % ولو أنه خلى إليك سبيلها % % 6(@)(@@) % قررت بها عينا وأثخنت في المهر % ومن شيم الحجاب أن قلوبهم % % 7(@)(@@) % قلوب على الأحرار أقسى من الصخر % وأنهم لو ملكوا القطر أو ولوا % % 8(@)(@@) % خزائنه خافوا النفاد على القطر % يخافون أن يحظى سواهم بحظهم % % 9(@)(@@) % فهم من سؤال السائلين على وحر % فلو حلؤوني عن شريعة جدول % 10(@)(@@) % عذرت ولكن حلؤوني عن البحر % فإن كان لي قدر لديك تسره % PageV01P1722 11(@)(@@) % فعرفهم مالي لديك من القدر % ن % % PageV01P1723 البحر : - 1(@)(@@) % يا أبا حفص المعي % % ير بالأبنة الحدر % 2(@)(@@) % لا تعير ذوي البلا % % ء به واحذر الغير % 3(@)(@@) % إن يكن في ما ذكر % % ت وقد يكذب الخبر % 4(@)(@@) % فعلى رأسك ابتلي % % ت بدائي مع القدر % 5(@)(@@) % من يرى رأسك الصقي % % ل فلا يشتهي الكمر % 6(@)(@@) % لم يزل بي تنزهي % % فيه باللمس والنظر % 7(@)(@@) % دون أن صرت أشتهي % % بعض مايشتهي البشر % PageV01P1724 البحر : - 1(@)(@@) % مدحت معاشرا عررا % حسبت بأنهم غرر % 2(@)(@@) % فما رفدوا ولا وعدوا 
ms458	 % % ولا اعتلوا ولا أعتذروا % % PageV01P1725 البحر : - 1(@)(@@) % أحب الطهارة من داخل % فلم يرض منها بما يظهر % 2(@)(@@) % وما استدخل الأير من حاجة % ولكن به المذهب الأكبر % PageV01P1726 البحر : - 1(@)(@@) % ألا ربما سؤت الغيور وساءني % % وبات كلانا من أخيه على وحر % 2(@)(@@) % وقبلت أفواها عذابا كأنها % % ينابيع خمر حصبت لؤلؤ البحر % % PageV01P1727 البحر : - 1(@)(@@) % مدحت أبا العباس أطلب رفده % فخيبني من رفده وهجا شعري % % 2(@)(@@) % فهبني قد أعفيته من مثوبتي % % أيغضى له شعري على مضض الوتر % 3(@)(@@) % سيبريه شعري حسب ما كان راشه % ولا خير في شعر يريش ولا يبري % % 4(@)(@@) % وإني عليم أن فري أديمه % % يسير عليه ماغدا سالم الوفر % PageV01P1728 البحر : - 1(@)(@@) % لي صديق إذا رأت % % وجهه العين سرها % % 2(@)(@@) % قلت يوما وخلته % مطلق الكف ثرها % % 3(@)(@@) % يا جوادا إذا حمت % لفح المزن درها % % 4(@)(@@) % فرطت منك دعوة % تأمل النفس كرها % % 5(@)(@@) % قال كانت فليتة % فوقى الله شرها % % 6(@)(@@) % قلت واها بجرعة % ذقتها ما أمرها % % 7(@)(@@) % أنت مذ ذقتها تشك % كى إلى الله حرها % % 8(@)(@@) % قال إي والذي قضى % % حل كفي وصرها % % 9(@)(@@) % قلت تب توبة امرىء % عق نفسا وبرها % % 10(@)(@@) % كلف النفس خطة % % لم تطقها وغرها % % PageV01P1729 11(@)(@@) % ثم قفى بتوبة % مط فيها وجرها % % 12(@)(@@) % ولقد تنفع النفو % % س بما كان ضرها % % PageV01P1730 البحر : - 1(@)(@@) % وفي ابن عمار عزيزية % يخاصم الله بها في القدر % 2(@)(@@) % لم كان ما كان ولم لم يكن % % ما لم يكن فهو وكيل البشر % 3(@)(@@) % لا بل فتى خاصم في نفسه % % لم لم يفز قدما وفاز البقر % 4(@)(@@) % وكل من كان له ناظر % % صاف فلابد له من نظر % PageV01P1731 البحر : - 1(@)(@@) % يا هل من الحادثات من وزرللخائف المستجير أم عصر تغدو فتعدو فما ترق على عأنثى وما إن تخاف من ذكر % % يابؤس للدهر ذي السفاه أما % % 2(@)(@@) % يفرق بين القيان والجزر % % أمايعفي على جرائم ما اس % % 3(@)(@@) % تقدم منه متاب منتظر % % يمر عصراه كل منتكث % % 4(@)(@@) % ونقضه عائد على المرر % % منصلت السيف كل منصلت % % 5(@)(@@) % منشمر النبل كل منشمر % % يقتلنا سيفه 
ms459	 وتختلنا % % 6(@)(@@) % سهامه الكامنات في القتر % كأن إسرافه برهبة مق % % 7(@)(@@) % هور عليه وحرص مؤتجر % كم من قتيل لصرفه طلف % 8(@)(@@) % وكم دم في ثيابه هدر % ألا فداء يفي ببغيته % % 9(@)(@@) % ألا سداد لتلكم الفقر % % يالك من مالك ومقتدر % % 10(@)(@@) % مؤتمر السوء كل مؤتمر % مكتنف بالعداء معتور % % PageV01P1732 11(@)(@@) % مكتنف بالملام معتور % فجعني صرفه بمؤنسة % 12(@)(@@) % تبعث ميت النشاط والأشر % سيغت وفاق الهوى فما شنئت % % 13(@)(@@) % من رهل عابها ولاقفر % % عسيرة البذل غير خالية % 14(@)(@@) % من خلق يخدع الرضا يسر % تمتع الحدث من ملاعبة % 15(@)(@@) % تنزل بين المجون والحصر % ويومها من محرم أبدا % 16(@)(@@) % حذقا ويوم القيان في صفر % سابقة لم تزل تنقلها % % 17(@)(@@) % بسابق في الكتاب مستطر % واها لذلك الغناء من طبق % 18(@)(@@) % على جميع القلوب مقتدر % يملأ روحا فؤاد سامعه % 19(@)(@@) % ويصطلى حره من القرر % كأنه قالب لكل هوى % 20(@)(@@) % فكله والمنى على قدر % لاخير في غيره وهل أمم % % PageV01P1733 21(@)(@@) % من شارب الراح شارب السكر % % إنا إلى الله راجعون لقد % % 22(@)(@@) % غال الردى سيرة من السير % ملء صدور المجالس اختلست % % 23(@)(@@) % لابل صدور الورى إلى الثغر % فزفرة لا تزال في صعد % 24(@)(@@) % وعبرة وكلت بمنحدر % بانت وما خلفت نظيرتها % % 25(@)(@@) % وغصنها اللدن غير مهتصر % مضت على دلها بوحدتها % % 26(@)(@@) % ولم يعد شخصها بمنجحر % % تسمو لأقرانها مبارزة % 27(@)(@@) % لا من وراء الستور والحجر % لم يعتصم عودها بزامرة % 28(@)(@@) % ولا ضوى وجهها إلى الستر % تبارز العين وحدها أبدا % 29(@)(@@) % والأذن وهي الحميدة الأثر % وتقتل الهم شر قتلته % 30(@)(@@) % بغير عون يكون من أخر % ما بذلت للكئيب نصرتها % % PageV01P1734 31(@)(@@) % على الأسى فارعوى إلى النصر % لم تخل من منظر تشوقه % 32(@)(@@) % ومن عفاف يفي بمستتر % ما برزت للخنا ولا استترت % % 33(@)(@@) % من عجر شانها ولا بجر % ما أولع الدهر في تصرفه % 34(@)(@@) % بكل زين له ومفتخر % يعدو على نفسه فيسلبها % % 35(@)(@@) % إلا عتاد المعد ذي النمر % كم ملبس لا يعاب هتكه % % 36(@)(@@) % عن جلدة منه شثنة الوبر % أودى ببستان وهي حلته % 37(@)(@@) % فقد 
ms460	 غدا عاريا من الحبر % أطار قمرية الغناء عن ال % % 38(@)(@@) % أرض فأي القلوب لم تطر % % لله ما ضمنت حفيرتها % % 39(@)(@@) % من حسن مرأى وطهر مختبر % أضحت من الساكني حفائرهم % % 40(@)(@@) % سكنى الغوالي مداهن السرر % مطيبي كل تربة خبثت % PageV01P1735 41(@)(@@) % ومؤنسيها بشر مجتور % يا حر صدري على ثلاثة أم % % 42(@)(@@) % واه هريقت في الترب والمدر % ماءي شباب ونعمة مزجا % % 43(@)(@@) % بماء ذاك الحياء والخفر % لو يعلم القبر من أتيح له % % 44(@)(@@) % لانحفر القبر غير محتفر % أو لأباها فصان حينئذ % 45(@)(@@) % عن رمسه درة من الدرر % إن ثرى ضمهالأفضل مح % % 46(@)(@@) % جوج لصب وخير معتمر % أقسمت بالغنج من ملاحظها % % 47(@)(@@) % وسحر ذاك السجو والفتر % لو عقرت حول قبرها بقر ال % % 48(@)(@@) % إنس مكان القلاص والمهر % والدر نظم على الترائب من % % 49(@)(@@) % هن وأشكاله من العتر % وانتحرت في فنائه بهم الحر % % 50(@)(@@) % ب وصيد الملوك من مضر % ثم سقيت الدماء تربتها % % PageV01P1736 51(@)(@@) % لم أشف ما في الفؤاد من وحر % نفسك يا نفس فانحري أسفا % 52(@)(@@) % فإن هذا أوان منتحر % ما حسن أن تذوب مهجتها % % 53(@)(@@) % ومهجتي لم ترق ولم تمر % لا ينكر الدهر بعد مهلكها % % 54(@)(@@) % هلك ذوات الجلال والخطر % كور شمس النهار فانكدرت % % 55(@)(@@) % كواكب الليل كل منكدر % بستان يا حسرتها على زهر % 56(@)(@@) % فيك من اللهو بل على ثمر % بستان لهفي لحسن وجهك وال % % 57(@)(@@) % إحسان صارا معا إلى العفر % بستان أضحى الفؤاد من وله % 58(@)(@@) % يا نزهة السمع منه والبصر % بستان ما منك لامرىء عوض % 59(@)(@@) % من البساتين لا ولا البشر % بستان أسقيت من مدامعنا الد % 60(@)(@@) % دمع وأعقبت عقبة المطر % بل حق سقياك أن تكون من الص % PageV01P1737 61(@)(@@) % صهباء صهباء حمص أو جدر % بل من رحيق الجنان يقطب بالمس % % 62(@)(@@) % ك سلافاته بلا عكر % بل من نجيع القلوب يمزج بال % % 63(@)(@@) % عطف وصفو الوداد لا الكدر % بستان لم يستعر لك اسمك يا % % 64(@)(@@) % بستان لذاتنا ولم يعر % كنا إذا اللهو قل مائرنا % % 65(@)(@@) % منه وجدناك معدن المير % ما كل 