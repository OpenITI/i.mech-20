ms261	 % 4(@)(@@) % يظل سحيقها في الكف يهزا % % بطيب روائح المسك السحيق % 5(@)(@@) % فعاقرها ، وطلق ما سواها % % تعش في الناس ذا وجه طليق % PageV01P1108 البحر : خفيف تام 1(@)(@@) % خذ أحاديثها من العار فيها % % واعف ندمانها من العار فيها % % 2(@)(@@) % قهوة لا يخاف شاربها الح % د ، ولا تجعل الحليم سفيها % % 3(@)(@@) % قد وجدنا بها نعيما مقيما ، % فغدت جنة لمن يصطفيها % % 4(@)(@@) % أكلها دائم ، وظل ظليل ، % وترى أهلها يحلون فيها % % PageV01P1109 البحر : كامل تام 1(@)(@@) % في نشوة الحمراء والخضراء % أمن من السوداء والصفراء % 2(@)(@@) % هذي بلا نار تفور ، وهذه % % ماست معاطفها بغير هواء % 3(@)(@@) % فاكسر بفترة تلك شرة هذه ، % واعجب لحسن تلاؤم الأجزاء % 4(@)(@@) % فالسكر فيما بين ذين مركب ، % كسل الحشيش ونشطة الصهباء % PageV01P1110 البحر : وافر تام 1(@)(@@) % حوت ضدين ، إذ ضربت وغنت ، % فقد ساءت وسرت من رآها % % 2(@)(@@) % غناء تستحق عليه ضربا ، % وضربا تستحق به غناها % % PageV01P1111 البحر : متقارب تام 1(@)(@@) % وشاد يشتت شمل الطرب ، % يميت السرور ، ويحيي الكرب % 2(@)(@@) % بوجه يبيد ، إذا ما بدا ، % وكف تضر ، إذا ما ضرب % 3(@)(@@) % شدا ، فغدا كل قلب به % قليل النصيب كثير النصب % 4(@)(@@) % تغنى ، فعنى قلوب الرفاق ، % وماس ، فمس القلوب العطب % PageV01P1112 البحر : كامل تام 1(@)(@@) % غنى بصوت مثل سوط عذاب ، % وبدا بوجه مثل ظهر غراب % 2(@)(@@) % فوددت أني لا أراه ، فإنني % % بكرت إلي مغيرة الأعراب % PageV01P1113 البحر : كامل تام 1(@)(@@) % ماتت ملاحته يكون لك البقا ، % وأتى العذار يقول من عاش التقى % % 2(@)(@@) % وبدا السواد على نقاء خدوده ، % فجديده لجديدها قد أخلقا % % 3(@)(@@) % وتنكرت صفة الغوير ، فلم يكن % % ذاك الغوير ولا النقا ذاك النقا % % PageV01P1114 البحر : سريع 1(@)(@@) % لما اغتنى أفقدنا نفعه ، % وتلك من شيمة بيت الخلا % % 2(@)(@@) % يسعى إليه إن غدا فارغا ، % وما به نفع إذا ما امتلا % % PageV01P1115 البحر : كامل تام 1(@)(@@) % ما كنت في إحدى الشدائد مرتجى ، % إلا رأينا باب جودك مرتجا % % 2(@)(@@) % وكذاك ما نسبت إليك رذيلة ، % غلا مدحت بها ، وكان لها الهجا % % PageV01P1116 البحر : كامل تام 1(@)(@@) % ثم بلغه أن المهجو توعد ذلك المقترح فخاف وطلب التنصل فغير له 
ms262	 في كل بيت لفظة وقال إن سئلت فقل ما قلت إلاما كنت في إحدى الشدائد مرتجى ، % إلا رأينا باب عذرك مرتجا % % 2(@)(@@) % وكذاك ما نسبت إليك فضيلة ، % إلا وقد مدحت وكان لك الهجا % % PageV01P1117 البحر : بسيط تام 1(@)(@@) % ما كان إسحق إنسانا فتندبه ، % فلا تقل مات إسحق ، وقل نفقا % % 2(@)(@@) % لا تجنحن إلى حي تمايله ، % وإن جنحت إليه ، فاتخذ نفقا % % PageV01P1118 البحر : طويل 1(@)(@@) % سرى نعشه من بعد ما سار غشه ، % فأفنى به الأحياء حال بقائه % 2(@)(@@) % وطال ازدحام الناس من حول نعشه % شماتا به ، لا رحمة لثوائه % 3(@)(@@) % فلا رحم الرحمن من فوق تحته ، % ولا من غدا يسري أمام ورائه % 4(@)(@@) % ونور من كفل من النار قبره ، % وآنسه بالرعب عند لقائه % PageV01P1119 البحر : وافر تام 1(@)(@@) % بشمس الدين لم تطق الرعايا ، % فكيف ، وقد تبدل بالنجيب % 2(@)(@@) % رعايا ما أطاقوا بأس كبش ، % محال أن يطيقوا بأس ذئب % PageV01P1120 البحر : متقارب تام 1(@)(@@) % عزيت إلى آل بيت النبي ، % وأنت بضدهم في الصلاح % 2(@)(@@) % وإن صح أنك من نسلهم ، % فقد ينبت الشوك بين الأقاح % PageV01P1121 البحر : كامل تام 1(@)(@@) % قال النبي مقال صدق لم يزل % يجري على الأسماع والأفواه : % 2(@)(@@) % من غاب عنكم أصله ، ففعاله % % تنبيكم عن أصله المتناهي % % 3(@)(@@) % وسفرت عن أفعال سوء أصبحت % بين الأنام قليلة الأشباه % 4(@)(@@) % وتقول : إنك من سلالة حيدر ، % أفأنت أصدق أم رسول الله ؟ % PageV01P1122 البحر : خفيف تام 1(@)(@@) % ومليح له رقيب قبيح ، % يتعنى وغيره يتهنى % % 2(@)(@@) % ليس فيه معنى يقال ولكن % % هو عند النحاة جاء لمعنى % % PageV01P1123 البحر : وافر تام 1(@)(@@) % ليهنك أن لي ولدا وعبدا ، % سواء في المقال وفي المقام % 2(@)(@@) % فهذا سابق من غير سين ، % وهذا عاقل من غير لام % PageV01P1124 البحر : سريع 1(@)(@@) % وأغيد مكتمل حسنه ، % ليس له في الناس من مشبه % 2(@)(@@) % أسقطه العارض من رتبة % مخبرة بالقرب من ربه % 3(@)(@@) % فقلت ، إذ سال له عارض ، % فأعرض العشاق عن حبه : % 4(@)(@@) % لو فكر العاشق في منتهى % % حسن الذي يسبيه لم يسبه % PageV01P1125 البحر : طويل 1(@)(@@) % ولي فرس ليست شكورا ، وإنما 
ms263	 % % بها تضرب الأمثال في العض والرفس % 2(@)(@@) % إذا جفلت بي في ضياع دبرش ، % فليس لها قبض سوى في جوى فرس % 3(@)(@@) % تعربد في وقت الصباح من الضيا ، % وتجفل في الآصال من شفق الشمس % 4(@)(@@) % فياليتها ، عند العليق ، جفولة ، % كما هي منكار من الحس والجنس % 5(@)(@@) % فلو شربت بالفلس من كف حاتم % لأصبح ندمانا على تلف الفلس % 6(@)(@@) % ولو برزت في جفل تحت عنتر % لجدل وانفلت جيوش بني عبس % PageV01P1126 البحر : كامل تام 1(@)(@@) % لا جاد هطال السحائب بقعة % بالغور ، أضحت وهي شر بقاعه % 2(@)(@@) % أرض تضاعف حرها وبعوضها % % في مرجها ، لما حللت بقاعه % 3(@)(@@) % وخلا الذباب بها ، فليس ببارح % غردا يحك ذراعه بذراعه % PageV01P1127 البحر : خفيف تام 1(@)(@@) % لي صديق لا يعرف الصدق في القو % % ل ، وليس الصديق إلا الصدوق % 2(@)(@@) % ليس فيه تصور يدرك العل % % م ، ولا لي إن قلته تصديق % PageV01P1128 البحر : طويل 1(@)(@@) % تلفق كذبا ، ثم تأتي بضده ، % إذا سألوا تكرير ما كنت حاكيا % % 2(@)(@@) % فإن كنت قوالا فإنك كاذب ، % وإن كنت كذابا فلا تك ناسيا % % PageV01P1129 البحر : متقارب تام 1(@)(@@) % طفيل تقاد بأذنابها ، % وقود الجياد بأرسانها % % 2(@)(@@) % إذا افتخرت فتية بالرجال ، % ففخر طفيل بنسوانها % % PageV01P1130 البحر : وافر تام 1(@)(@@) % تحجر فيك طبع الشح يبسا ، % وذاك لأن كفك فيه قبض % 2(@)(@@) % وكم حركته بشراب عتب ، % فأقسم لا يجيب ولا ينض % 3(@)(@@) % ومنذ رفعت صوتك لي دليلا ، % فكان لنصب قدرك منه خفض % 4(@)(@@) % علمت بأن رأسك فيه خلط % غليظ ، لا يحل ، ولا يفض % 5(@)(@@) % ومن تك هذه الأعراض فيه ، % ولم يعرف له بالعذل عرض % 6(@)(@@) % فكيف أروم صحته بعتبي ، % ولم يخفق له بالجود نبض % PageV01P1131 البحر : بسيط تام 1(@)(@@) % لما تطاول بي إفراط مطلك لي ، % وضاع وقتي بين العذر والعذل % 2(@)(@@) % أيقنت أن لست إنسانا لفعلك ذا ، % لقوله خلق الإنسان من عجل % PageV01P1132 البحر : خفيف تام 1(@)(@@) % أيها الفاضل الذي لفظه الد % ر ، ولفظ الأنام كالأصداف % 2(@)(@@) % كيف تلقى الأنام شأوك في الفض % % ل ، وإن شبهوك في الأوصاف % 3(@)(@@) % أصل كل الأنام طين ، ولكن % % أنت 
ms264	 طين من بعد ياء وقاف % PageV01P1133 البحر : طويل 1(@)(@@) % مباضع إسحاق الطبيب كأنها % % لها بفناء العالمين كفيل % 2(@)(@@) % معودة ألا تسل نصالها % % فتغمد حتى يستباح قتيل % PageV01P1134 البحر : بسيط تام 1(@)(@@) % سميت عيسى ، ولم تظفر بمعجزة ، % ولم تشابهه في علم ولا حسب % 2(@)(@@) % ولا أتيت بشيء من فضائله ، % إلا بأنك من أم بغير أب % PageV01P1135 البحر : كامل تام 1(@)(@@) % لو أن قوة وجهه في قلبه ، % قبض الأسود وجدل الأبطالا % % 2(@)(@@) % أو كان طول لسانه بيمينه ، % أفنى الكنوز ، وأنفد الأموالا % % PageV01P1136 البحر : وافر تام 1(@)(@@) % وقالوا : عند عبد الله ضعف ، % فقلت : نعم ، ولكن في اليقين % 2(@)(@@) % فقالوا : ما يعيش ؟ فقلت : عدل ، % كذا هو في الحياة بغير شين % PageV01P1137 البحر : خفيف تام 1(@)(@@) % كيف ترجو بأن تساوي حسينا ، % لستما في الفخار أبناء جنس % 2(@)(@@) % هل تساوى من جده عبد الشم % % س ، ومن كان جده عبد شمس % PageV01P1138 البحر : سريع 1(@)(@@) % جعل الذي أنشاك من قرعة ، % وسائر العالم من طينه % % 2(@)(@@) % أعجب ما شوهد في عصرنا % % عوسجة تحمل يقطينه % % PageV01P1139 البحر : كامل تام 1(@)(@@) % وافى ، وقد شفع التقطب وجهه ، % وطحا بها مرح التكبر ، فانثنى % % 2(@)(@@) % يبدو فتقذفه النفوس لثقله ، % فتراه أبعد ما يكون إذا دنا % % 3(@)(@@) % فطفقت أنشد ، إذ بصرت بحمقه ، % بيتا جعلت الشطر منه مضمنا % % 4(@)(@@) % يا ثقل صورته وخفة رأسه ، % هلا نقلت إلى خنا من ها هنا % % PageV01P1140 البحر : خفيف تام 1(@)(@@) % لي جار كأنه البوم في الشكل ، % ولكن في عجبه ، فغراب % 2(@)(@@) % هو كالماء إن أردت له قب % ضا ، وإن رمت موردا فسراب % PageV01P1141 البحر : وافر تام 1(@)(@@) % أتشمخ إن كساك الدهر ثوبا ، % شرفت به ، ولم تك بالشريف % 2(@)(@@) % فكم قد عاينت عيناي سترا % من الديباج حط على كنيف % PageV01P1142 البحر : وافر تام 1(@)(@@) % مدحتك مدح بشار بن برد % ربابة ، إذ دعاه لها اضطرار % 2(@)(@@) % أراد قضاء حاجته لديها ، % فجاء بما لها فيه اختيار % 3(@)(@@) % إذا اضطر الشريف إلى كنيف ، % فليس عليه إذ يأتيه عار % PageV01P1143 البحر : سريع 1(@)(@@) % لو عاينت مقلته دخنة ، % لاسترق اللب من القشر % 2(@)(@@) % ولو فلاها بعده 
ms265	 ناقد ، % لم ير فيها أثر الكسر % 3(@)(@@) % يكاد أن يسرق طيب الكرى ، % من راقد الليل ، ولا يدري % % 4(@)(@@) % هذا ، ولو شاء غدا ممكنا % أن يسرق السكر من الخمر % PageV01P1144 البحر : خفيف تام 1(@)(@@) % لو غدا أنفك العظيم غدا وه % و وقود للنار ذات الوقود % 2(@)(@@) % ثم قالوا : هلا امتلأت ؟ لقالت : % هو حسبي ، ولم ترد من مزيد % PageV01P1145 البحر : طويل 1(@)(@@) % ليحيى فم لو علق المسك فوقه % لأصلحه ، والضد يصلحه الضد % 2(@)(@@) % ترى صحبه الحضار من نتن ريحه % كأنهم من طول ما التثموا مرد % PageV01P1146 البحر : وافر تام 1(@)(@@) % لو كان لريح نكهته هبوب ، % لأوشكت الجبال لها تذوب % 2(@)(@@) % إذا ما عاب ضرس أبي علي ، % فليس يطيق يقلعه الطبيب % PageV01P1147 البحر : خفيف تام 1(@)(@@) % قلت للكلبتين إذ عجزت عن % % ضرس يحيى من بعد جهد عنيف % 2(@)(@@) % كيف أعياك نزع ذلك والكل % % ب بسلب العظام غير ضعيف % 3(@)(@@) % فأعادت من الصليل جوابا ، % بادرتنا منه بعذر لطيف % 4(@)(@@) % لا تطيق الكلاب تنزع عظما % موثق السمر في قرار كنيف % PageV01P1148 البحر : منسرح 1(@)(@@) % عهدي به ، والأكف تختلف ، % وهو يعاصي طورا وينحرف % 2(@)(@@) % وكلما مال عطفه سفها % تميله صفعة ، فينعطف % 3(@)(@@) % وإن توارضى بشخصه هربا % من راحة في اعتمادها خيف % 4(@)(@@) % ظلت سهام النعال ترشقه ، % كأنما رأسه لها هدف % PageV01P1149 البحر : سريع 1(@)(@@) % فم ليحيى ريحه منتن ، % لم ير يوما مثله قط % 2(@)(@@) % لو أنه عض على فارة % لعاف أن يأكلها القط % PageV01P1150 البحر : طويل 1(@)(@@) % أيا من يرد الفقر باللوم جاهدا ، % كما رده يوما بسوءته عمرو % % 2(@)(@@) % إذا كان هذا سوء عيشك في الغنى ، % فماذا الذي تخشى إذا مسك الفقر % PageV01P1151 البحر : خفيف تام 1(@)(@@) % وبخيل ينال من عرضه النا % % س ، ولكن رغيفه لا ينال % 2(@)(@@) % كل يوم يأتي بحرف رغيف ، % كهلال لم يدن منه كمال % 3(@)(@@) % مستقر في وسط سفرته الزر % % قاء لا يتريه منه زوال % 4(@)(@@) % فتعجبت من سماء بأرض % كل يوم يلوح فيها هلال % PageV01P1152 البحر : طويل 1(@)(@@) % ولي صاحب يسترجع الناس كلما % % ذكرت لهم أوصافه ونعوته % 2(@)(@@) % لقد ألبستني 
ms266	 صحة الجسم داره % بفرط الحمى لما حللت بيوته % 3(@)(@@) % وما علمتني حكمة غير أنني % % أديم مطال الجوع حتى أمينه % PageV01P1153 البحر : خفيف تام 1(@)(@@) % وشحيح من لؤمه يخبز البخ % % ل ببسط الأخلاق بين الرفاق % 2(@)(@@) % فهو من شحه يثمن في الخر % % ج علينا مكارم الأخلاق % PageV01P1154 البحر : خفيف تام 1(@)(@@) % لو تراني من فوق طود من الجو % % ع أناجي رغيف نجل سنان % 2(@)(@@) % كلما قمت قائلا أرني وج % % هك نادى : وعزتي لن تراني % % PageV01P1155 البحر : منسرح 1(@)(@@) % يحفظ في الجوع ألف منفعة ، % ومثلها في مضرة البطنه % 2(@)(@@) % ويوهم الناس أن شبعهم % يطفىء نور الذكاء والفطنه % % 3(@)(@@) % إن حاول الضيف أن يلم به % أعطاه من قبل نطقه القطنه % PageV01P1156 البحر : منسرح 1(@)(@@) % صاحب ، إذا ما صحبت ، ذا أدب % مهذب ، زان خلقه الخلق % 2(@)(@@) % ولا تصاحب من في طبائعه % سر لأن الطباع تسترق % PageV01P1157 البحر : خفيف تام 1(@)(@@) % لا تصاحب من الأنام لئيما ، % ربما أفسد الطباع اللئيم % 2(@)(@@) % فالهواء البسيط في جمرة القي % % ظ سموم ، وفي الربيع نسيم % 3(@)(@@) % وابغ منهم مجانسا يوجب الض % م ، فقد يصحب الكريم الكريم % 4(@)(@@) % واعتبر حال عالم الطير طرا ، % كل جنس مع جنسه مضموم % PageV01P1158 البحر : خفيف تام 1(@)(@@) % لا تكن طالبا لما في يد النا % % س ، فيزور عن لقاك الصديق % 2(@)(@@) % إنما الذل في سؤالك للنا % % س ، ولو في سؤال أين الطريق % PageV01P1159 البحر : سريع 1(@)(@@) % قناعة المرء بما عنده ، % مملكة ما مثلها مملكه % % 2(@)(@@) % فارضوا بما قد جاء عفوا ، ولا % % تلقوا بأيديكم إلى التهلكه % % PageV01P1160 البحر : خفيف تام 1(@)(@@) % أقلل المزح في الكلام احترازا ، % فبإفراطه الدماء تراق % 2(@)(@@) % قلة السم لا تضر ، وقد يق % % تل مع فرط أكله الدرياق % PageV01P1161 البحر : متقارب تام 1(@)(@@) % توق من الناس فحش الكلام ، % فكل ينال جنى غرسه % 2(@)(@@) % فمن جرب الذم في عرضه ، % كمن جرب السم في نفسه % PageV01P1162 البحر : - 1(@)(@@) % كل من كان شأنه الانبساط ، % ليس يطوى للقدح فيه بساط % 2(@)(@@) % ربما أوغر الصدور بمزح % لاح فيه الجفا والإشتطاط % 3(@)(@@) % فأقلل المزح ما استطعت ولا تأ % % ت 
ms267	 بنزر إلا وفيه احتياط % 4(@)(@@) % وتوق الإفراط فيه فقد يف % % رط في وضع قدرك الإفراط % PageV01P1163 البحر : وافر تام 1(@)(@@) % أرى فحش الكلام يروع قلبي ، % وليس تروعه البيض الحداد % 2(@)(@@) % كحلق البكر يجرحه زلال ، % ولا يدمي مشافره القتاد % PageV01P1164 البحر : طويل 1(@)(@@) % تعلمت فعل الخير من غير أهله ، % وهذب نفسي فعلهم باختلافه % 2(@)(@@) % أرى ما يسوء النفس من فعل جاهل ، % فآخذ في تأديبها بخلافه % PageV01P1165 البحر : طويل 1(@)(@@) % إذا غاب أصل المرء فاستقر فعله ، % فإن دليل الفرع ينبي عن الأصل % 2(@)(@@) % فقد يشهد الفعل الجميل لربه ، % كذاك مضاء الحد من شاهد النصل % PageV01P1166 البحر : طويل 1(@)(@@) % لعمرك لا يغني الفتى طيب أصله ، % وقد خالف الآباء في القول والفعل % 2(@)(@@) % فقد صح أن الخمر رجس محرم ، % وما شك خلق أنه طيب الأصل % PageV01P1167 البحر : بسيط تام 1(@)(@@) % عود لسانك قول الخير تنج به % من زلة اللفظ بل من زلة القدم % 2(@)(@@) % واحرز كلامك من خل تنادمه ، % إن النديم لمشتق من الندم % PageV01P1168 البحر : كامل تام 1(@)(@@) % اسمع مخاطبة الجليس ، ولا تكن % % عجلا بنطقك قبلما تتفهم % 2(@)(@@) % لم تعط مع أذنيك نطقا واحدا ، % إلا لتسمع ضعف ما تتكلم % PageV01P1169 البحر : متقارب تام 1(@)(@@) % إذا لم تكن عالما بالسؤال ، % فترك الجواب له أسلم % 2(@)(@@) % فإن أنت شككت فيما سئل % ت ، فخير جوابك لا أعلم % PageV01P1170 البحر : وافر تام 1(@)(@@) % إذا زرت الملوك ، فكن رئيسا ، % بصيرا بالأمور رحيب صدر % 2(@)(@@) % وقابل منهم بجزيل شكر % لديك ، ومنعهم بجميل عذر % 3(@)(@@) % فإن أقصوك قل هذا مقامي ، % وإن أدنوك قل ذا فوق قدري % % PageV01P1171 البحر : رجز تام 1(@)(@@) % إن تصحب السلطان كن محترسا ، % متقن آداب الصباح والمسا % % 2(@)(@@) % وكن لما يؤثره مقتبسا ، % واخضع ، إذا لان ، ولن إذا قسا % % 3(@)(@@) % ولا تكن طلقا إذا ما عبسا ، % ولا تكن مستوحشا إن أنسا % % 4(@)(@@) % ولا تزر حضرته مختلسا ، % ولا تشمته إذا ما عطسا % % 5(@)(@@) % وأوضح له الأمر إذا ما التبسا ، % من غير جعل رأيه منعكسا % % 6(@)(@@) % ولا تشع سرا له محتبسا ، % ولا تبت في عيشه مغمسا % % 7(@)(@@) % ولا تشاركه 
ms268	 بأحوال النسا ، % لم تدر ما في نفسه قد هجسا % % 8(@)(@@) % فإنه كالليث يخفي الشرسا ، % حتى إذا ريع حماه افترسا % % PageV01P1172 البحر : وافر تام 1(@)(@@) % إذا بلي اللبيب بقرب فدم % تجرع منه كاسات الحتوف % 2(@)(@@) % فذو الطبع الكثيف بغير قصد % يضر بصاحب الطبع اللطيف % 3(@)(@@) % وذاك لأن بينهما اختلافا % ينافي العقل بالجهل العنيف % 4(@)(@@) % فداء الجهل ليس له دواء ، % كحمى الربع في فصل الخريف % PageV01P1173 البحر : بسيط تام 1(@)(@@) % إن الجهول ، إذا ألزمت صحبته % قسرا ، فصاحبته عن غير إيثار % 2(@)(@@) % يطفي ضياء سنا فهمي ، وينقصه ، % كالنار بالماء ، أو كالماء بالنار % PageV01P1174 البحر : متقارب تام 1(@)(@@) % توقوا النساء ، فإن النساء % نقصن حظوظا وعقلا ودينا % % 2(@)(@@) % وكل به جاء نص الكتاب % وأوضح فيه دليلا مبينا % % 3(@)(@@) % فأما الدليل لنقص الحظوظ ، % فإرثهم نصف إرث البنينا % % 4(@)(@@) % ونقص العقول فإجراؤهن % بنصف الشهادة في الشاهدينا % % 5(@)(@@) % وحسبك من نقص أديانهن % ما لست تزداد فيه يقينا % % 6(@)(@@) % فوات الصلاة ، وترك الصيام % في مدة الحيض حينا ، فحينا % % 7(@)(@@) % فلا تطمعوهن يوما ، فقد % % تكون الندامة منه سنينا % % PageV01P1175 البحر : منسرح 1(@)(@@) % إخفض جناحا لمن تعاشره ، % ولن ، إذا ما قست خلائقه % % 2(@)(@@) % فإنه ، إن أسأت صحبته ، % أعدى أعاديك ، إذ تفارقه % % PageV01P1176 البحر : طويل 1(@)(@@) % وليس صديقا من إذا قلت لفظة % يحاول في أثناء موقعها أمرا % % 2(@)(@@) % ولكنه من لو قطعت بنانه % % PageV01P1177 البحر : متقارب تام 1(@)(@@) % فكم صاحب مذ بدا سخطه % % بذلت له خلقا مرتضى % % 2(@)(@@) % مخافة أن تنقضي بيننا % % عهود المودة ، أو ينقضا % % 3(@)(@@) % وإني ، وإن ساءني فعله ، % وأصبح بعد الوفا معرضا % % 4(@)(@@) % أقابله بمحيا القبول ، % وألحظه بعيون الرضا % % PageV01P1178 البحر : كامل تام 1(@)(@@) % إن الصديق يريد بسطك مازحا ، % فإذا رأى منك الملالة يقصر % 2(@)(@@) % وترى العدو ، إذا تيقن أنه % يؤذيك بالمزح العنيف يكثر % PageV01P1179 البحر : وافر تام 1(@)(@@) % تحمل من حبيبك كل ذنب ، % وعد خطاه في وفق الصواب % 2(@)(@@) % ولا تعتب على ذنب حبيبا ، % فكم هجرا تولد من عتاب % PageV01P1180 البحر : طويل 1(@)(@@) % أحب صديقا منصفا في ازدياده ، % يخفف عن قصد ويبرم عن عذر % 2(@)(@@) % ولا رأي 
ms269	 لي فيمن ينغص خلوتي ، % فيسرق لذاتي ، وينفق من عمري % % 3(@)(@@) % ولي خلوات لا ابيع يسيرها % % بما ملكت كفاي من وافر الوفر % 4(@)(@@) % أبيت بها في عالم من تصوري ، % يسامرني عقلي ، ويؤنسني فكري % % 5(@)(@@) % ويعتادني من خمر معناي نشوة ، % أود سرورا أن يدوم بها سكري % % 6(@)(@@) % إذا كد وزن النظم جهد قريحتي % % عزلت القوافي واسترحت إلى النثر % 7(@)(@@) % وأجعل لفظي للمعاني قوالبا ، % فأنحت من صخر وأغرف من بحر % PageV01P1181 البحر : مجزوء الكامل 1(@)(@@) % انصح صديقك مرتين ، % فإن عصاك فغشه % 2(@)(@@) % لو ظن صدقك ما عصى ، % وأبى وأظهر فحشه % PageV01P1182 البحر : متقارب تام 1(@)(@@) % نصحتك فاصغ إلى منطقي ، % يقدك إلى السنن الأرشد % 2(@)(@@) % ولا تستقلن رأي امرىء ، % وإن كان دونك في المحتد % 3(@)(@@) % فإن سليمان في ملكه ، % وكل بآرائه يهتدي % % 4(@)(@@) % أطاعته كل ذوات الجناح % وأصغى إلى نبأ الهدهد % PageV01P1183 البحر : مخلع البسيط 1(@)(@@) % سرك إن صنته بصمت ، % أصلح بين الأنام شانك % % 2(@)(@@) % فلا تفه لامرىء بسر ، % وتحرك به لسانك % % PageV01P1184 البحر : بسيط تام 1(@)(@@) % إن الغنى كشهاب كلما اعتكرت % دجى الخطوب جلا منها حنادسها % % 2(@)(@@) % لا تنفع الخمسة الأسماء محدقة % لديك ، إلا إذا ما كنت سادسها % % PageV01P1185 البحر : متقارب تام 1(@)(@@) % تأمل ، إذا ما كتبت الكتاب ، % سطورك من بعد إحكامها % % 2(@)(@@) % وهذب عبارة طرز الكلام ، % واستوف سائر أقسامها % % 3(@)(@@) % فقد قيل إن عقول الرجال % تحت ألسنة أقلامها % % PageV01P1186 البحر : خفيف تام 1(@)(@@) % وإذا فاتك الغنى نكص العز % % م وكل اللسان عند الكلام % 2(@)(@@) % ما لسان الفقير إلا قصير ، % عجبا إن أطاق رد السلام % PageV01P1187 البحر : كامل تام 1(@)(@@) % لن يقضي الحاجات إلا درهم ، % عز الغني ودرهم لمؤمل % 2(@)(@@) % يدني لك الغرض البعيد بسحره ، % ويحل عقدة كل أمر مشكل % 3(@)(@@) % فإذا فهمت السر فيه رأيته % ذخر المؤمل ، نزهة المتأمل % 4(@)(@@) % وإذا نظرت إلى أسرة وجهه % لمعت كلمع العارض المتهلل % PageV01P1188 البحر : سريع 1(@)(@@) % قد نظر الناس بلا عين ، % من ناظر الناس بلا عين % 2(@)(@@) % لا تحقرن المال فالعين لل % % إنسان كالإنسان للعين % PageV01P1189 البحر : كامل تام 1(@)(@@) % عين النضار كناظر العين 
ms270	 الذي % % يتأمل القاصي به والداني % % 2(@)(@@) % ولرب إنسان بلا عين غدا % % وكأنه عين بلا إنسان % PageV01P1190 البحر : كامل تام 1(@)(@@) % يعطى البليد مع الخمول ، من الغنى % % ما لم ينله بعقله وبحسه % 2(@)(@@) % كم مدرك ، مع عجزه من دهره % % في يومه ، ما لم ينل من أمسه % 3(@)(@@) % لكنها الأيام ، في تصريفها ، % تقضي عليه بسعده وبنحسه % 4(@)(@@) % إن أقبلت وهبت محاسن غيره ، % أو أدبرت سلبت محاسن نفسه % PageV01P1191 البحر : مجزوء الكامل 1(@)(@@) % إن الفقير ، وإن نمت % % ه مكارم وفضائل % 2(@)(@@) % لا يستعان به ، ولا % % يعبا بما هو قائل % 3(@)(@@) % لو كان سحبان البلا % % غة أنكرته وائل % 4(@)(@@) % أو كان قسا في الفصا % % حة قيل هذا باقل % PageV01P1192 البحر : مجتث 1(@)(@@) % لا تحسن الظن فيمن % % يرضيك حسن لقائه % 2(@)(@@) % فمن يردك لأمر ، % يمللك عند انقضائه % % PageV01P1193 البحر : كامل تام 1(@)(@@) % إن الصديق ، إذا رآك مخالفا % لهواه بدل وده بعقوق % 2(@)(@@) % فاخفض جناحك للصديق متابعا % لهوائه ، أو عش بغير صديق % PageV01P1194 البحر : مجزوء الكامل 1(@)(@@) % للعشق سكرق كالمدا % % م ، إذا تمكن في العقول % 2(@)(@@) % يبقى اليسير من الكثي % % ر ، فكيف ظنك بالقليل % PageV01P1195 البحر : منسرح 1(@)(@@) % من لم تضم الضيوف ساحته ، % فستره أن تضمه الحفره % % 2(@)(@@) % ومن تمادى في شحه نفرت % من قربه الناس أيما نفره % % 3(@)(@@) % واللؤم يزري من قدر صاحبه ، % حتى لقد كاد يقتضي كفره % % 4(@)(@@) % ومن غدا عرضه المهلب في النا % % س ، غدا وجهه أبا صفره % % PageV01P1196 البحر : سريع 1(@)(@@) % يا من يعز المال ضنا به ، % إن المعالي ضد ما تزعم % 2(@)(@@) % ما عز بين الناس قدر امرىء % إلا وقد ذل به الدرهم % PageV01P1197 البحر : سريع 1(@)(@@) % لا تحزنوا المال لقصد الغنى ، % وتطلبوا اليسرى بعسراكم % 2(@)(@@) % فذاكض فقر لكم عاجل ، % أعاذنا اللهث وإياكم % 3(@)(@@) % ما قال ذو العرش لنا اخزنوا % % بل أنفقوا مما رزقناكم % PageV01P1198 البحر : بسيط تام 1(@)(@@) % إن قل نفعك في أرض حللت بها % % سافر لتدرك قصدا أو ترى أملا % % 2(@)(@@) % فالبيض لو لازمت أغمادها صدئت ، % والشمس لو لم تسر ما حلت الحملا % % PageV01P1199 البحر : وافر تام 1(@)(@@) % تغرب 
ms271	 وابغ في الأسفار رزقا ، % لتفتح بالتغرب باب نجح % 2(@)(@@) % فلن تجد الثراء بغير سعي ، % وهل يوري الزناد بغير قدح ؟ % PageV01P1200 البحر : كامل تام 1(@)(@@) % بثلاث واوات وشين بعدها % % كاف وضاد أصل كل هوان % 2(@)(@@) % بوكالة ، ووديعة ، ووصية ، % وبشركة ، وكفالة ، وضمان % PageV01P1201 البحر : وافر تام 1(@)(@@) % يسائلني صديقي عن كتاب ، % فأنكره ، وأشغل عنه بالي % % 2(@)(@@) % وأزعم أنه خط سقيم ، % وطرس دارس ، كالشن بالي % % 3(@)(@@) % مخافة أن أروم له ارتجاعا ، % فيقطع دونه حبل الوصال % 4(@)(@@) % ولست بواصف يوما حبيبا % أعرضه لأهواء الرجال % PageV01P1202 البحر : طويل 1(@)(@@) % وإني لمغرى بالقوافي ونظمها ، % ويبلغ بي حد السرور وبليغها % % 2(@)(@@) % وأطيب أوقاتي من الدهر ليلة ، % تريغ القوافي خاطري وأريغها % % 3(@)(@@) % فكم بلغت بي همتي بعد غاية % % يعز على الشعرى العبور بلوغها % % 4(@)(@@) % فما سرني إلا كلام أسيغه ، % بمسمع واع ، أو معان أصوغها % % PageV01P1203 البحر : مجتث 1(@)(@@) % ليس البلاغة معنى % فيه الكلام يطول % 2(@)(@@) % بل صوغ معنى كثير % يحويه لفظ قليل % 3(@)(@@) % فالفضل في حسن لفظ % يقل فيه الفضول % 4(@)(@@) % يظنه الناس سهلا ، % وما إليه سبيل % 5(@)(@@) % والعي معنى قصير ، % يحويه لفظ طويل % PageV01P1204 البحر : خفيف تام 1(@)(@@) % في فساد الأحوال لله سر ، % والتباس في غاية الإيضاح % % 2(@)(@@) % فيقول الجهال : قد فسد الأم % % ر ، وذاك الفساد عين الصلاح % PageV01P1205 البحر : سريع 1(@)(@@) % ذو العقل من أصبح ذا خلوة % في بيته ، كالميت في رمسه % 2(@)(@@) % منفردا بالفكر عن صحبه ، % مستوحشا بالإنس من أنسه % 3(@)(@@) % أصبح لا يألف خلا ، ولا % % يصحب شخصا ليس من جنسه % 4(@)(@@) % ولا يريد الليث في غابه ، % من مؤنس فيه سوى نفسه % PageV01P1206 البحر : طويل 1(@)(@@) % وأطيب أوقاتي من الدهر خلوة ، % يقر بها قلبي ويصفو بها ذهني % % 2(@)(@@) % وتأخذني من سورة الفكر نشوة % فأخرج من فن وأدخل في فن % 3(@)(@@) % ويفهم ما قد قال عقلي تصوري ، % فنقلي إذا عني ، وسمعي بها مني % % 4(@)(@@) % وأسمع من نجوى الدفاتر طرفة ، % أزيل بها همي ، وأجلو بها حزني % % 5(@)(@@) % ينادمني قوم لدي حديثهم ، % فما غاب منهم غير شخصهم عني % % PageV01P1207 البحر : سريع 1(@)(@@) % تؤنسني الوحدة في خلوتي 
ms272	 ، % وهذه من صفة العالم % 2(@)(@@) % من يك بالعالم مستأنسا ، % فإنني مني في عالم % PageV01P1208 البحر : كامل تام 1(@)(@@) % قال العذول : لم اعتزلت عن الورى ، % وأقمت نفسك في المقام الأوهن % 2(@)(@@) % ناديت : طالب راحة ، فأجابني : % أتعبتها بطلاب ما لم يمكن % PageV01P1209 البحر : كامل تام 1(@)(@@) % لا تهد شيئا لم يكن حسنا ، % أو طرفة عدت من النزر % 2(@)(@@) % إن الهدية في زيارتها % % تزري بصاحبها ولا يدري % % PageV01P1210 البحر : متقارب تام 1(@)(@@) % إذا الجد لم يك لي مسعدا ، % فما حركاتي إلا سكون % 2(@)(@@) % إذا لم يكن ما يريد الفتى ، % على رغمه ، فليرد ما يكون % PageV01P1211 البحر : طويل 1(@)(@@) % بقدر لغات المرء يكثر نفعه ، % فتلك له عند الملمات أعوان % 2(@)(@@) % تهافت على حفظ اللغات مجاهدا ، % فكل لسان في الحقيقة إنسان % PageV01P1212 البحر : كامل تام 1(@)(@@) % إني لأعجب من تعقل جاهل % أمسى يدل بجاهه وبوفره % 2(@)(@@) % أمسى يشح بماله وبزاده ، % لكن يجود بعرضه وبذكره % 3(@)(@@) % وتراه يحسب ما بقي من ماله ، % فتراه يعلم ما بقي من عمره ؟ % PageV01P1213 البحر : وافر تام 1(@)(@@) % أتطلب من أخ خلقا جليلا ، % وخلق الناس من ماء مهين % 2(@)(@@) % فسامح أن تكدر ود خل ، % فإن المرء من ماء وطين % PageV01P1214 البحر : وافر تام 1(@)(@@) % إذا أبطا الرسول فظن خيرا ، % فسوء الظن في عجل الرسول % 2(@)(@@) % فلولا أن يرى ما يشتهيه ، % لعاد إليك في أمد قليل % PageV01P1215 البحر : كامل تام 1(@)(@@) % لا تأمنن إلى الخريف وإن غدا % % عذب الهواء يلذ للأجسام % 2(@)(@@) % وأحذر توصله إليك بلذة ، % فالداء يحدث من ألذ طعام % PageV01P1216 البحر : منسرح 1(@)(@@) % يا رب ! إني دخلت بيتك وال % % داخل بيت الكريم في حسبه % 2(@)(@@) % لا يختشي سخطه عليه ، ولا % % يحذر من مكره ولا غضبه % % 3(@)(@@) % فكيف يرتاع من أناخ بك الرح % ل ، ويخشى من سوء منقلبه % 4(@)(@@) % لا يسأل العبد غير من هو بال % % عفو جدير ، وأنت أجدر به % % PageV01P1217 البحر : مجتث 1(@)(@@) % يا رب ! ذنبي عظيم ، % وأنت عني حليم % 2(@)(@@) % بل عزني منك وعد ، % له الأنام تروم % 3(@)(@@) % إذ قلت في الذكر للمص % % طفى ، وأنت كريم % 4(@)(@@) % نبىء 
ms273	 عبادي أني % % أنا الغفور الرحيم % PageV01P1218 البحر : خفيف تام 1(@)(@@) % رب أنعمت في المديد من العم % % ر ، ونجيتني من الأشرار % 2(@)(@@) % فاعفني اليوم من سؤال لئيم ، % وقني في غد عذاب النار % PageV01P1219 البحر : خفيف تام 1(@)(@@) % تب وثب وادع ذا الجلال بصدق % تجد الله للدعاء سميعا % % 2(@)(@@) % لا تخف مع رجاء ربك ذنبا ، % إنه يغفر الذنوب جميعا % % PageV01P1220 البحر : مجتث 1(@)(@@) % يا رب إن كان ذنبي % % خلاف إخلاص قلبي % % 2(@)(@@) % فليس ذلك إلا % لحسن ظني بربي % % 3(@)(@@) % ما لي إليك شفيع ، % إلا اعترافي بذنبي % % 4(@)(@@) % وليس حسبي إلا % بأن عفوك حسبي % % PageV01P1221 البحر : مجزوء الخفيف 1(@)(@@) % كل كأس من غير خم % % رة معناك لي قدح % 2(@)(@@) % وسوى ذكرك المف % % رح لم ينش لي فرح % 3(@)(@@) % أيها الغائب الذي % % عن حمى القلب ما نزح % 4(@)(@@) % من يكن قصده سوا % % ك فقد خاب وافتضح % PageV01P1222 البحر : طويل 1(@)(@@) % تعشقت ليلى من وراء حجابها ، % ولم تر عيني لمحة من جنابها % % 2(@)(@@) % فكيف سلوي ، إذ أميطت ستورها ، % وزحزح إذ وافيت فضل نقابها % % 3(@)(@@) % وكم أمكنتني فرصة في اختلاسها ، % وبت ، وقلبي طامع في اغتصابها % % 4(@)(@@) % فأجللتها عن أن أراها بريبة % ولم يرضني إلا الدخول ببابها % % PageV01P1223 البحر : طويل 1(@)(@@) % شهدت بأني عبد مغناكم الذي % % على بابكم أرضى حجابكم عني % % 2(@)(@@) % فإن شنع الأعداء عني بضده ، % فلا تشهدوا إلا بمسموعكم مني % % PageV01P1224 البحر : طويل 1(@)(@@) % تراءت لنا ، بين الأكلة والحجب ، % فتاة بها طرفي ، وهام بها قلبي % % 2(@)(@@) % وأعجب شيء أنها مذ تبرجت ، % رأت حسنها عيني ، ولم يرها صحبي % % 3(@)(@@) % تلقيتها بالرحب مني كرامة ، % ومنها تعلمنا التلقي بالرحب % 4(@)(@@) % عجبت لمسراها ، وأعجب باللقا ، % فيا عجبي مما رأيت ، ويا عجبي % % 5(@)(@@) % غزالة سرب كنت أخشى نفارها ، % فأصبحت مع فوزي بها آمن السرب % 6(@)(@@) % خفضت جناح الذل رفعا لقدرها ، % فأوجب ذاك الخفض رفعي عن النصب % 7(@)(@@) % وناجيتها فيما أحب سماعه ، % مشافهة ، لا بالترسل والكتب % 8(@)(@@) % لقد أصبحتنا من مدام خطابها ، % وما قلت إلحاحا عليه : ألا هبي % % 9(@)(@@) % حملت الظمأ شوقا إليها ، فساقني % % إلى عين تنسيم أدمت 
ms274	 بها شربي % % 10(@)(@@) % علمت بها ما كنت أجهل علمه ، % وكنت بها أنبا فصرت بها أنبي % % PageV01P1225 11(@)(@@) % كستني من العز المقيم ملابسا % حسانا ولم تقصد بذاك سوى سلبي % % 12(@)(@@) % وأصبح موتي كالحياة بوصلها ، % فإن غبت كان البعد في غاية القرب % 13(@)(@@) % وكم جعلت مني علي طليعة ، % فعيني لها في ذاك عين على قلبي % % 14(@)(@@) % فكل يرى شمسا من الشرق أشرقت ، % وتشرق شمس العارفين من الغرب % 15(@)(@@) % فيا حضرة القدس التي مذ شهدتها % % تيقن قلبي بالوصول إلى ربي % % 16(@)(@@) % حنانيك قد أشهدتني كل واجب % علي ، فلي من ذاك شغل عن الندب % 17(@)(@@) % فأنت لنا قطب عليه مدارنا ، % وأي رحى أضحت تدور بلا قطب % PageV01P1226 البحر : رجز تام 1(@)(@@) % لما رفعت ناركم للساري ، % آنست على النار هدى الأسرار % 2(@)(@@) % قد جئتكم أروم منها قبسا ، % نوديت أن بورك من في النار % PageV01P1227 البحر : كامل تام 1(@)(@@) % عجبا لفودي بعد فقد شبيبتي ، % وكأن نور الشيب فيه قتام % 2(@)(@@) % لما نضت عنه الليالي صبغها ، % خلعت عليه شبابها الأيام % PageV01P1228 البحر : خفيف تام 1(@)(@@) % لو تيقنت أن ضيف بياض الشي % % ب يبقى لما كرهت الشبابا % % 2(@)(@@) % غير أني علمت من ذلك الزا % % ئر ما يقتضي وما يتقاضى % % PageV01P1229 البحر : سريع 1(@)(@@) % تقول لما أن رأت لمتي % % محفوفة بالشعر الأشيب : % 2(@)(@@) % بدلت من مسكك كافورة ، % فقلت : بل العنبر الأشهب % PageV01P1230 البحر : خفيف تام 1(@)(@@) % هذه دولة الشباب ، إذا لم % % أك فيها مملكا محسودا % % 2(@)(@@) % فمتى أملك القياد ، ويضحي ال % % شيب حولي عساكرا وجنودا % % PageV01P1231 البحر : سريع 1(@)(@@) % قالوا اخضب الشيب فقلت اقصروا ، % فإن قصد الصدق من شيمتي % % 2(@)(@@) % فكيف أرضى بعد ذا أنني % % أول ما أكذب في لحيتي % % PageV01P1232 البحر : كامل تام 1(@)(@@) % إني لفضلك بالمديح أجازي ، % شتان بين حقيقة ومجاز % 2(@)(@@) % فضلا به ضاق الكلام بأسره ، % فضلا عن الإرمال والإرجاز % 3(@)(@@) % إن رمت بالنظم البديع صفاته ، % لم ألق غير نهاية الإعجاز % 4(@)(@@) % رضت العلوم فأصبحت إذا أصبحت ، % وجيادها تمشي بلا مهماز % 5(@)(@@) % وسموت هرمس والرئيس وثابتا ، % فضلا على الطوسي والشيرازي % % 6(@)(@@) % والشعر ثوب ليس 
ms275	 يعرف قدره ، % من بعد حائكه سوى بزاز % 7(@)(@@) % وهززت أغصان الكلام ، فساقطت % دررا ، فلا عدمتك من هزاز % 8(@)(@@) % ونشرت في أقصى البلاد فضائلا ، % غرا ، رزأت بهن ذكر الرازي % % 9(@)(@@) % وتركت فرسان الكلام لقاية ، % حتى كأنك بالفضائل غازي % % 10(@)(@@) % فإذا الجدال ، أو الجلاد حواهم % في يوم تبريز ويوم براز % PageV01P1233 11(@)(@@) % نظروا إليك بأعين مزورة ، % نظر البغاث إلى التفات البازي % % 12(@)(@@) % يا سابق الوعد المقول بفعله ، % فيحول بين المطل والإيجاز % 13(@)(@@) % كم قد أسأت مهاجرا ومجاهرا ، % فعزيت بالإكرام والإعزاز % 14(@)(@@) % يا صاحب المنن التي آثارها % % فينا ، كفعل الغيث بالإجاز % 15(@)(@@) % لديار مصر لك الهناء ، وإن غدا % % للزوم بعدك والعراق تعازي % % 16(@)(@@) % قوضت عن أعلامها ، فتنكرت ، % فكأنها ثوب بغير طراز % 17(@)(@@) % ما للمقيم بحصر بعض صفاته % قبل ، فكيف لعابر مجتاز % 18(@)(@@) % وجلوت شعري في المحافل بعدما % % أخفيته بدفاتر وجزاز % 19(@)(@@) % وخطبت مني بعد ذاك إجازة % عن نقله ، حتى ظننتك هازي % % 20(@)(@@) % هل يخطب المولى إجازة عبده ، % ويروم من مولاه خط جواز % PageV01P1234 21(@)(@@) % ولقد أجبت بأن أجزت بخدمة % في غاية التلخيص والإيجاز % 22(@)(@@) % وأذنت أن ترويه عني ، مالكي ، % مع كل ما تعزوه نحوي عازي % % 23(@)(@@) % فهي الإجازة والوداع لأنها % % صدرت ، ومرسلها على أوفاز % % 24(@)(@@) % متوقع الإغضاء عن تقصيره ، % من ذا يوازن فضلكم ويوازي % % 25(@)(@@) % وإذا عجزت عن الجزاء لحقكم % % بمدائحي ، فالله خير مجازي % % PageV01P1235 البحر : وافر تام 1(@)(@@) % أجزت لسيدي ومليك رقي ، % رواية ما حوى من نسج فكري % % 2(@)(@@) % وما أنشأت من جد وهزل ، % وما أبدعت من نظم ونثر % 3(@)(@@) % ولم أقصد بذاك سوى قبولي % % لمرسوم أشار به وأمري % % 4(@)(@@) % ولو نسبوا إليه جميع علمي ، % لكان كنقطة في لج بحر % PageV01P1236 البحر : سريع 1(@)(@@) % هذا كتاب المثل السائر % في أدب الكاتب والشاعر % 2(@)(@@) % ألفه نجل الأثير الذي % % أبرزه كالكوكب الزاهر % 3(@)(@@) % فكم به من زهر ناضر ، % في الحسن أضحى نزهة الناظر % 4(@)(@@) % إذا بدا معناه قال الورى : % كم ترك الأول للآخر % PageV01P1237 البحر : كامل تام 1(@)(@@) % إن يحبسوك ، فإن جودك سائر ، % أو قيدوك ، فإن ذكرك مطلق % 2 
ms276	(@)(@@) % والمسك يخزن في الوعاء ونشره % % أبدا بافنية المنازل يعبق % 3(@)(@@) % وكذاك كل نفيس در لم يزل % % من دونه للخزن باب مغلق % 4(@)(@@) % والحلي في كل المواطن زينة ، % شتان جيد عاطل ومطوق % PageV01P1238 البحر : سريع 1(@)(@@) % قد عهد الجوهر بالخزن ، % فلا تخف عاقبة السجن % 2(@)(@@) % يوسف نال الملك من بعده ، % وعاش في عز ، وفي أمن % 3(@)(@@) % من بعد ما أعمى أباه البكا % % وابيض عيناه من الحزن % PageV01P1239 البحر : بسيط تام 1(@)(@@) % لم تتبع الأمر إلا كان ، أو كادا ، % ولم تر الخطب إلا بان ، أو بادا % % 2(@)(@@) % وما رأى البؤس أفواج العفاة ، وقد % % حلت بربعك ، إلا حال أو حادا % % 3(@)(@@) % وطيب ذكرك لم يقصد بشهوته % بناء مجدك ، إلا شاع أو شادا % % 4(@)(@@) % حلى بك الدهر أجياد العلاء ، فلم % % تعط المراتب إلا زان ، أو جادا % % 5(@)(@@) % يا ماجدا ما دعته في ندى وردى % بنو المطالب إلا جال أو زادا % % 6(@)(@@) % ما رام بالعزم صيد الصيد يوم وغى % إن صالت الشوس إلا صال أو صادا % % 7(@)(@@) % ولم يشاهد بني الآمال قد قطعت % منها العلائق إلا عاج أو عادا % % 8(@)(@@) % وما دعا للندضى إلا أجاب ندا % % باغي النوال ، إذا ما ناح أو نادى % % 9(@)(@@) % لا ينثني لمهب العاصفات ، ولم % % يهزه المدح إلا مال أو مادا % % 10(@)(@@) % فخار مجدك ، نجم الدين ، إن فخرت % أهل السيادة ساوى النجم ، أو سادا % % PageV01P1240 11(@)(@@) % ونار عزمك إن نار القرى وقدت % رأى لها الناس إيقاظا وإيقادا % % 12(@)(@@) % وسحب نفعك إن هبت عواصفها % % رأى لها الشوس إرعابا وإرعادا % % 13(@)(@@) % تركت مدحك إذ أكرمتني حذرا % أن تفني المال إنفاقا وإنفادا % % 14(@)(@@) % إذ كنت أوليت قوما دون مرتبتي % % بأيسر المدح إرفاقا وإرفادا % % 15(@)(@@) % فمذ أثرت ركابي عنك مرتحلا ، % أثرت مدحك إنشاء وإنشادا % % 16(@)(@@) % فاسعد بأبكاره ، لا زلت في نعم ، % ترى من الله إسعافا وإسعادا % % PageV01P1241 البحر : وافر تام 1(@)(@@) % أغار الغيث كفك حين جادا ، % فأفرط في تواتره وزادا % % 2(@)(@@) % أظن الغيث يحسدنا عليه . % فيمنع من زيارتك العبادا % % 3(@)(@@) % همى فرأيت منه السح شحا ، % سحابا ما عهدت به 
ms277	 العهادا % % 4(@)(@@) % إذا رمنا لحضرتك ازديادا ، % نوهم أننا رمنا ازديادا % % 5(@)(@@) % أعاد الأرض في صفر ربيعا ، % وكان ربيعنا فيها جمادى % % 6(@)(@@) % وما باراك في فضل بهطل ، % ولكن زادنا فيك اعتقادا % % 7(@)(@@) % وكيف يروم أن يحكيك جودا ، % بفرط الهطل ، أو يدعى جوادا % % 8(@)(@@) % وأنت وقد أفدت ضحوك ثغر ، % ويبدو بالبكاء ، وما أفادا % % 9(@)(@@) % وأين الغيث من إنعام مولى ، % ينول كل قلب ما أرادا % % 10(@)(@@) % أغر تراه أعلى الناس نقدا ، % إذا ما رمت للناس انتقادا % % PageV01P1242 11(@)(@@) % قليل الغمض في طلب المعالي ، % ومن عشق العلى هجر الوسادا % % 12(@)(@@) % إذا عصفت به النكباء عاس ، % وإن هزته ريح المدح مادا % % 13(@)(@@) % يعيد الفضل عودا بعد بدء ، % وينكر فهمه اللفظ المعادا % % 14(@)(@@) % تصرف كفه اليمنى يراعا ، % به راع العدى ، ورعى البلادا % % 15(@)(@@) % ترى الأسياف قد مطرت نجيعا ، % إذا أوداجه قطرت مدادا % % 16(@)(@@) % خفي الكيد تعرفه المنايا ، % إذا ما أنكر السيف النجادا % % 17(@)(@@) % بنفث علم الأفاعي ، % وجري علم الجري الجيادا % % 18(@)(@@) % يكون لساعد العلياء زندا ، % ونار الحرب إن وقدت زنادا % % 19(@)(@@) % يرينا أوجه الآمال بيضا ، % غذا مجت مشافره السوادا % % 20(@)(@@) % يظن إذا امتطى خمسا لطافا % لعدته ارتقى سبعا شدادا % % PageV01P1243 21(@)(@@) % ولم أر قلبه قلما نحيفا ، % يكون لبيت مكرمة عمادا % % 22(@)(@@) % شهاب الدين قد أطلقت نطقي ، % وصيرت المكارم لي صفادا % % 23(@)(@@) % أقمت لصنعة الإنشاء سوقا ، % وكانت قبل شاكية كسادا % % 24(@)(@@) % وزدت رفيع منصبها سدادا ، % وكان سواك من عوز سدادا % % 25(@)(@@) % بفضل يخجل السحب الغوادي ، % ولفظ يفجر الصم الجلادا % % 26(@)(@@) % رفعت إليك يا مولاي شعري ، % لأخطب من مكارمك الودادا % % 27(@)(@@) % وحظي من ودادك غير نزر ، % ولكني أؤمل أن أزادا % % 28(@)(@@) % وأسأل منك أن تعفو وتعفي % % محبك من إجابته اعتقادا % % 29(@)(@@) % فيعفيني قبولك عن جواب ، % إذا يتلى نقصت به وزادا % % 30(@)(@@) % فلا أنفك أشكر منك فضلا % قريب العهد ، أو أشكو بعادا % % PageV01P1244 195(@)(@@) % % عدل يؤلف بين الذئب والغنم % PageV01P1245 البحر : مجزوء الرجز 1(@)(@@) % رو عظامي بسلا % % ف العنب المورق % 2(@)(@@) % وصرف اللهم بصر % % ف مائها المروق % 3(@)(@@) % ولا تدنسها بمز % ج مائك 
ms278	 المرقرق % 4(@)(@@) % وعوذ الكأس من ال % % ماء برب الفلق % 5(@)(@@) % وعاطنيها قهوة % تجلوا ظلام الغسق % 6(@)(@@) % وأسقني حتى أرى % % الفيل بقدر البيدق % 7(@)(@@) % صفراء تجلوها السقا % % ة في زجاج يقق % 8(@)(@@) % كأنها في كأسها % % كهربة في زيبق % 9(@)(@@) % تجلى بكف شادن % مقرط مقرطق % 10(@)(@@) % يشرق نور وجهه % في قرطق مخلق % PageV01P1246 11(@)(@@) % كأنه شمس النها % % ر في رداء الشفق % 12(@)(@@) % يسكرنا من كأسه ، % ولحظه المسترق % 13(@)(@@) % فتارة من قدح ، % وتارة من حدق % 14(@)(@@) % أما ترى الغيم الجدي % % د محدقا بالأفق % 15(@)(@@) % فاشرب على جديده % من خمرنا المعتق % 16(@)(@@) % في جنتي محول ، % وباسق والجوسق % 17(@)(@@) % فهي مرادي لا ربى ال % % سدير والخورنق % 18(@)(@@) % وانظر إلى القداح يب % % دو من خلال الورق % 19(@)(@@) % كلؤلؤ بالتبر في % % زمرد معلق % 20(@)(@@) % والزهر قد مد لنا % % بسطا من الإستبرق % PageV01P1247 21(@)(@@) % من أحمر ، وأصفر ، % وأخضر ، وأزرق % 22(@)(@@) % والماء بين الروض من % % مقيد ، ومطلق % 23(@)(@@) % والطير من محوم % فيها ، ومن محلق % 24(@)(@@) % ونغمة البلبل وال % % شحرور والمطوق % 25(@)(@@) % فالق الصباح بالصبو % % ح قبل ضوء الشفق % 26(@)(@@) % واجل دجى الظلماء من % % نور سناها المشرق % 27(@)(@@) % حتى يرينا أدهم اللي % % ل شبيه الأبلق % 28(@)(@@) % ولا تخف يوما على % % سيء ، عيش المملق % 29(@)(@@) % فإن عندي فضلة % من جود آل أرتق % 30(@)(@@) % قوم يفيض جودهم % % ردوا بقايا رمقي % % PageV01P1248 31(@)(@@) % ولم تزل أنعامهم % % قلائدا في عنقي % % 32(@)(@@) % لذاك أجلو ذكرهم % % في مغرب ومشرق % 33(@)(@@) % ولو أردت حصر بع % % ض وصفهم لم أطق % PageV01P1249 البحر : كامل تام 1(@)(@@) % أبت الوصال مخافة الرقباء ، % وأتتك تحت مدارع الظلماء % 2(@)(@@) % أصفتك من بعد الصدود مودة ، % وكذا الدواء يكون بعد الداء % 3(@)(@@) % أحيت بزورتها النفوس ، وطالما % % ضنت بها ، فقضت على الأحياء % 4(@)(@@) % أتت بليل ، والنجوم كأنها % % درر بباطن خيمة زرقاء % 5(@)(@@) % أمست تعاطيني المدام ، وبيننا % % عتب غنيت به عن الصهباء % 6(@)(@@) % أبكي ، وأشكو ما لقيت ، فتلتهي % % عن در ألفاظي بدر بكاء % 7(@)(@@) % آبت إلى جسدي لتنظر ما انتهت % من بعدها فيه يد البرحاء % 8(@)(@@) % ألفت به وقع الصفاح ، فراعها 
ms279	 % % جزعا ، وما نظرت جراح حشائي % % 9(@)(@@) % أمصيبة منا بنبل لحاظها % % ما أخطأته أسنة الأعداء % 10(@)(@@) % أعجبت مما قد رأيت ، وفي الحشا % % أضعاف ما عاينت في الأعضاء % PageV01P1250 11(@)(@@) % أمسي ، ولست بسالم من طعنة % نجلاء ، أو من مقلة كحلاء % 12(@)(@@) % إن الصوارم واللحاظ تعاهدا % % أن لا أزال مزملا بدمائي % % 13(@)(@@) % أجنت عليذ بما رأيت معاشر ، % نظروا إلي بمقلة عمياء % 14(@)(@@) % أكسبتهم مالي ، فمذ طلبوا دمي % % لم أشكهم إلا إلى البيداء % 15(@)(@@) % أبعدت عن أرض العراق ركائبي % % متنقلا كتنقل الأفياء % 16(@)(@@) % أرجو بقطع البيد قطع مطامعي ، % وأروم بالمنصور نصر لوائي % % 17(@)(@@) % أدركته ، فجعلت ألثم ، فرحة % بوصوله ، أخفاف نوق رجائي % % 18(@)(@@) % أضحى يهنيني الزمان بقصده ، % ويشير كف العز بالإيماء % 19(@)(@@) % أومت إلي مشيرة أن لا تخف ، % وابشر ، فإنك في ذرى العلياء % 20(@)(@@) % أبماردين تخاف خطفة مارد ، % وشهابها في القلعة الشبهاء % PageV01P1251 21(@)(@@) % ألهيت عن قومي بملك عنده % تنسى البنون فضائل الآباء % 22(@)(@@) % إني تركت الناس حين وجدته ، % ترك التيمم في وجود الماء % % 23(@)(@@) % المرتقي فلكض الفخار ، إذا اغتدى ، % رايات ، بل بسواكن الآراء % 24(@)(@@) % أفنى جيوش عداته بخوافق ال % % 25(@)(@@) % أسيافه نقم على أعدائه ، % وأكفه نعم على الفقراء % 26(@)(@@) % إن حل حل النهب في أركانه ، % أو سار سار الخلف في الأعداء % 27(@)(@@) % أمجندل الابطال ، بل يا منتهى % % الآمال ، بل يا كعبة الشعراء % 28(@)(@@) % أقبلت نحوك في سواد مطالبي ، % حتى أتتني باليد البيضاء % 29(@)(@@) % أرقي إلى عرش الرجا رب الندى ، % فكأن يومي ليلة الإسراء % PageV01P1252 البحر : بسيط تام 1(@)(@@) % بدت لنا الراح في تاج من الحبب ، % فمزقت حالة الظلماء باللهب % 2(@)(@@) % بكر ، إذا زوجت بالماء أولدها % % أطفال در على مهد من الذهب % 3(@)(@@) % بقية من بقايا قوم نوح ، إذا % % لاحت جلت ظلمة الأحزان والكرب % 4(@)(@@) % بعيدة العهد بالمعصار ، لو نطقت % لحدثتنا بما في سالف الحقب % 5(@)(@@) % باكرتها برفاق قد زهت بهم % قبل السلاف سلاف العلم والأدب % 6(@)(@@) % بكل متشح بالفضل متزر ، % كأن في لفظه ضربا من الضرب % 7(@)(@@) % بل رب ليل غدا في الآهبات غدت % تنقض فيه كؤوس 
ms280	 وهي كالشهب % 8(@)(@@) % بذلت عقلي صداقا حين بت به % أزوج ابن سحاب بابنة العنب % 9(@)(@@) % بتنا بكاساتها صرعى ، ومضربنا % % يعيد أرواحنا من مبدأ الطرب % 10(@)(@@) % بعث أتانا ، فلم ندر لفرحتنا % % من نفخة الصور أم من نفحة القصب % PageV01P1253 11(@)(@@) % بروضة طل فيها الطل أدمعه ، % والدهر مبتسم عن ثغره الشنب % 12(@)(@@) % بكت عليه أساكيب الحيا ، فغدا % % جذلان يرفل في أثوابه القشب % 13(@)(@@) % بسط من الروض قد حاكت مطارفها % % يد الربيع ، وجارتها يد السحب % 14(@)(@@) % باتت تجود علينا بالمياه ، كما % % جادت يد الملك المنصور بالذهب % 15(@)(@@) % بحر تدفق بحر الجود من يده ، % فأصبح الملك يزهو زهو معتجب % 16(@)(@@) % باد ببذل الندى قبل السؤال ، ومن % % في دولة الترك أحيا ذمة العرب % 17(@)(@@) % بدر أضاءثغور الملك فابتسمت % به ، فكان لثغر الملك كالشنب % 18(@)(@@) % بنى المعالي ، وأفني المال نائله ، % فالملك في عرس والمال في حرب % 19(@)(@@) % ببأسه أضحت الأيام جازعة ، % فلا تصاحب عضوا غير مضطرب % 20(@)(@@) % بأس يذلل صعب الحادثات به ، % فأصبح الدهر يشكو شدة التعب % PageV01P1254 21(@)(@@) % به تناسيت ما لاقيت من نصب ، % ولذة الشبع تنسي شدة السغب % 22(@)(@@) % بادرته ، وعقاب الهم يطردني ، % فاليوم قد عاد كالعنقاء في الهرب % 23(@)(@@) % بكم تبلج وجه الحق ، يا ملكا % به تشرف هام الملك والرتب % 24(@)(@@) % بنيت للمجد أبياتا مشيدة ، % ولم يمد لها لولاك من طنب % 25(@)(@@) % بسطت في الأرض عدلا لو له اتبعت % نوائب الدهر لم تعذر ، ولم تنب % 26(@)(@@) % بلغت سيفك في هام العدو ، كما % % أنشيت سيف العطا في قمة النشب % 27(@)(@@) % باشر غرائب أشعاري ، فقد برزت % إليك أبكار أفكاري من الحجب % 28(@)(@@) % بدائع من قريض لو أتيت بها % % في غيركم كان منسوبا إلى الكذب % 29(@)(@@) % بقيت ما دارت الأفلاك في نعم ، % محروسة من صروف الدهر والنوب % PageV01P1255 البحر : كامل تام 1(@)(@@) % تاب الزمان من الذنوب فوات ، % واغنم لذيذ العيش قبل فوات % 2(@)(@@) % تم السرور بنا ، فقم يا صاحبي % % نستدرك الماضي بنهب الآتي % % 3(@)(@@) % تاقت إلى شرب المدام نفوسنا ، % لا تذهبن بطالة الأوقات % 4(@)(@@) % توج بكاسات الطلى هام الربى 