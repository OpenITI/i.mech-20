ms281	 ، % في روضة مطلولة الزهرات % 5(@)(@@) % تغدو سلاف القطر دائرة بها ، % والكأس دائرة بكف سقاة % 6(@)(@@) % % من ذا أحق بها من الكاسات % 7(@)(@@) % تبت يدا من تاب عن رشف الطلى ، % والكأس متقد كخد فتاة % 8(@)(@@) % تبرية لولا ملازمتي لها % % أصبحت معصوما من الزلات % 9(@)(@@) % تابع إلى أوقاتها داعي الصبا ، % واعجب لما فيها من الآيات % 10(@)(@@) % تمم بها نقص السرور ، فإنها % % عند الكرام ، تميمة اللذات % PageV01P1256 11(@)(@@) % تركي لأكياس النضار جهالة ، % خد الغلام منمق بنبات % 12(@)(@@) % تبدو ، وقد يبدو الندى بمتونها % % صدأ ، فتلقطه يد النسمات % 13(@)(@@) % تسري على صفحاتها ريح الصبا ، % بسحائب منهلة العبرات % 14(@)(@@) % تستل فيها للبروق صوارما ، % كصوارم المنصور في الغارات % 15(@)(@@) % تعب لتحصيل الثناء مجرد % للمجد عزما صادق اللحظات % 16(@)(@@) % تبع الهوى قوم ، فكان هواه في % % طلب العلى وتجنب الشهوات % 17(@)(@@) % ترك الكتائب في السباسب شردا ، % فترى الزمان مقيد الخطوات % 18(@)(@@) % تمت محاسنه بحسن خلاقه ، % وسنا ، فزاد الحسن بالحسنات % 19(@)(@@) % تاهت به الدنيا ، ولولا جوده ، % كان الأنام هبا بغير هبات % 20(@)(@@) % تبكي خزائنه على أمواله ، % من حر قلب دائم الحسرات % PageV01P1257 21(@)(@@) % تتبسم الأيام عند بكائها ، % فكأنهن بها من الشمات % 22(@)(@@) % تسمو بهمتك ابن أرتق همة % حفت بألوية من العزمات % 23(@)(@@) % تردي صروف الدهر وهي سواكن ، % إن السكون لها من الحركات % 24(@)(@@) % تاقت إليك قلوب قوم أصبحت % تلقي إليك معارق الفلوات % 25(@)(@@) % تركوا على شاطي الفرات ديارهم % % وسعوا إليك ، فأحدقوا بفرات % 26(@)(@@) % يهدي إليك المادحون جواهرا ، % منظومة كقلائد اللبات % 27(@)(@@) % تحلو صفاتك في القلوب ، كأنها % % جاءت لمعنى عارض في الذات % 28(@)(@@) % ته في الأنام ، فلا برحت مؤملا ، % تجلو الجفون وتملأ الجفنات % PageV01P1258 البحر : كامل تام 1(@)(@@) % ثقتي بغير هواكم لا تحدث ، % ويدي بحبل وصالكم تتشبث % 2(@)(@@) % ثبتت مغارس حبكم في خاطري ، % فهو القديم ، وكل حب محدث % 3(@)(@@) % ثنت العهود أعنتي عن غيركم ، % فعقودها منظومة لا تنكث % 4(@)(@@) % ثلجت على حفظ الوداد قلوبنا ، % ولظى الهوى بضيائها يتأرث % 5(@)(@@) % ثقل الهوى ، وإن استلذ ، فإنه % % داء به تبلى العظام وتشعث % 6(@)(@@) % ثوب خلعت العز حين 
ms282	 لبسته ، % إذ كان إذ ذل الصبابة يورث % 7(@)(@@) % ثلب الورى عرضي المصون وحبذا % % لو صح ما قال العدى وتحدثوا % % 8(@)(@@) % ثاروا بنا ، فطفقت حين أراهم ، % حذرا أذكر ذكركم ، وأؤنث % 9(@)(@@) % ثكل الورى طرفي المسهد فابعثوا % % طيف الخيال إلي ، أو لا تبعثوا % % 10(@)(@@) % ثج الهوى ، فأنا الغريق بلجه ، % لكنني بحبالكم أتشبث % PageV01P1259 11(@)(@@) % ثلم الهوى حدي ، وكنت مهندا % ماضي الغرار بغمده لا يمكث % 12(@)(@@) % ثم اغتدت أيدي ابن أرتق قصتي ، % كل بها ، بين الأنام ، يحدث % 13(@)(@@) % ثبت الجنان يكاد يبعث مرسلا ، % لو أن بعد محمد من يبعث % 14(@)(@@) % ثغر الفلا من نوره متبسم ، % وفم الزمان بفضله متحدث % 15(@)(@@) % ثخنت جراح النجل منه وبعدها % % وافى ووجه الحور أغبر أشعث % 16(@)(@@) % ثرمت ثغور الملك ، لولا أنه % ينشي لها العدل العميم ويحدث % 17(@)(@@) % ثهلان ، إن عد الحلوم أو النهى ، % بحر ، إذا عد الندى والمبحث % 18(@)(@@) % ثمن البحار السبع جود يمينه ، % وجبينه للنيرين يثلث % 19(@)(@@) % ثاني عنان الحادثات ، وفارس % أمسى جواد الدهر منه يلهث % 20(@)(@@) % ثوت الخطوب مخافة من بأسه ، % صرعى ، وذل بها الزمان الأحنث % PageV01P1260 21(@)(@@) % ثمل بصهباء السماح ، فهمه % % مال يقسم ، أو علوم تبحث % 22(@)(@@) % ثمرات مجد مد نحو قطافها % % كفا بإسداء الصنائع تعبث % 23(@)(@@) % ثقفت زيغ الملك يا نجم الهدى % % بأسنة سم المنية تنفث % 24(@)(@@) % ثب للعلى واستخدم الدهر الذي % % إن تدعه لملمة لا يلبث % 25(@)(@@) % ثبنا إليك على هجان ضمر ، % شبه القسي إلى حماك تحثث % 26(@)(@@) % ثارت بنا تطوي القفار ، فعندما % % آنست نارك قلت للركب : أمكثوا % % 27(@)(@@) % ثم اقتسمنا بالسرور ، وأشركت % في طيب بشرانا النياق الدلث % 28(@)(@@) % ثقة بأن يد الردى ، إن غادرت % ميتا ، فعندك بالمكارم يبعث % 29(@)(@@) % ثبتت ، ولو حلفت بأنك ناعش % بنوالك الأرواح لم تك تحنث % PageV01P1261 البحر : بسيط تام 1(@)(@@) % جاءت لتنظر ما أبقت من المهج ، % فعطرت سائر الأرجاء بالأرج % 2(@)(@@) % جلت علينا محيا لو جلته لنا % % في ظلمة الليل أغنانا عن السرج % 3(@)(@@) % جميلة الوجه ، لو أن الجمال بها % % يولي الجميل لأشجت فود كل شج % 4(@)(@@) % جورية الخد يحمى ورد 
ms283	 وجنتها % % بحارس من نبال الغنج والدعج % 5(@)(@@) % جازت إساءة أفعالي بمغفورة ، % فكان غفرانها يغني عن الحجج % 6(@)(@@) % جارت لعرفانها أني المريض بها ، % فما علي إذا أذنبت من حرج % 7(@)(@@) % جست يدي لترى ما بي فقلت لها : % كفي ، فذاك جوى لولاك لم يهج % 8(@)(@@) % جفوتني ، فرأيت الصبر أجمل بي ، % والصمت بالحب أولى بي من اللهج % 9(@)(@@) % جارت لحاظك فينا غير راحمة ، % ولذة الحب جور الناظر الغنج % 10(@)(@@) % جوري فلا فرجا لي من عذابك لي ، % إلا يد الملك المنصور بالفرج % PageV01P1262 11(@)(@@) % جواد كف تروع الدهر سطوته ، % فلا تصاحب عضوا غير مختلج % 12(@)(@@) % جدت لما ترتضي العلياء همته ، % فالملك في رقدة ، والحرب في رهج % 13(@)(@@) % جنت على ماله أيدي مكارمه ، % فلا يبيت بطرف غير منزعج % 14(@)(@@) % جهد المواهب أن تغنى خزائنه ، % حتى كأن بها ضربا من اللجج % 15(@)(@@) % جدت إليه بنو الآمال مسرعة ، % فأكثروا نحوه بالسعي والحجج % 16(@)(@@) % جون إذا شمت برق السيف من يده % تراه منبلجا في كف منبلج % 17(@)(@@) % جنى ثمار المعالي حين حاولها ، % بصارم ما خلا في الحرب من هرج % 18(@)(@@) % حالت قناة المنايا في مضاربه ، % فظل ينقص أبكارا من المهج % 19(@)(@@) % جزيا أبا الفتح ، غايات الفخار ، فقد % % أمسكت طلابه في مسلك حرج % 20(@)(@@) % جللت حتى لو أن الصبح لحت به % وقلت : قف لا تلج في الليل لم يلج % PageV01P1263 21(@)(@@) % جردت أسياف نصر أنت جوهرها ، % في حالك من ظلام النقع منتسج % 22(@)(@@) % جبرت كسر المعالي يا ابن بجدتها % % بها وقومت ما بالدين من عوج % 23(@)(@@) % جمار نار ، ولكن من عوائدها % % اطفاء ما في صدور القوم من وهج % 24(@)(@@) % جوازم إن أردت البطش كن يدا ، % وإن رقيت المعالي كن كالدرج % 25(@)(@@) % جلوت كرب الورى بالمكرمات ، كما % % جلوت تلك الردى بالمنظر البهج % 26(@)(@@) % جعلت جودك دون الوعد معترضا ، % ووعد غيرك ضيق غير منفرج % 27(@)(@@) % جئناك ، يا ملك الدنيا ، وواحدها ، % نؤم بالدر نهديه إلى اللجج % 28(@)(@@) % جزنا البلاد ، ولم نقصد سواك فتى ، % من يحظ بالدر يستغن عن السبج % 29(@)(@@) % جمعت فضلا ، فلا فرقته 
ms284	 أبدا ، % أنت الفريد وجل الناس كالمهج % PageV01P1264 البحر : كامل تام 1(@)(@@) % حي الرفاق ، وطف بكأس الراح ، % واطرز بكأس حلة الأفراح % 2(@)(@@) % حث الكؤوس إلى جسوم أصبحت % فيها المدام شريكة الأرواح % 3(@)(@@) % حاش المدام ، وعاطني مشمولة ، % ظلت فسادي وهي عين صلاحي % % 4(@)(@@) % حمراء ، لو ترك السقاة مزاجها ، % أمست لنا عوضا عن المصباح % 5(@)(@@) % حجب الحباب شعاعها ، فكأنه % شفق تلهب تحت ذيل صباح % 6(@)(@@) % حبب ، تظل به الكؤوس كأنها % % خصر الفتاة ممنطقا بوشاح % 7(@)(@@) % حكم الزمان ، وغض عنا طرفه ، % يا صاح لا تقنع بأنك صاح % 8(@)(@@) % حق الصبا دين عليك فأده ، % بالشرب بين خمائل ورداح % 9(@)(@@) % حاك الحيا حلل الربيع ، فعطرت % نشر الصبا بأريجها الفياح % 10(@)(@@) % حلل ، إذا بكت السحائب أشرقت % بخدود ورد ، أو ثغور أقاح % PageV01P1265 11(@)(@@) % حيا الحيا بأريجها ، فترنحت % أعطافها من غير نشوة راح % 12(@)(@@) % حملت ، فأشرق زهرها ، فكأنما % % ضربت معاصمها يد القداح % 13(@)(@@) % حبك الهنا بسمائهن خمائلا ، % تنقض فيها أنجم الأقداح % 14(@)(@@) % حزنا السرور بها ، وبتنا نجتلي % % بنت الكروم بغير عقد نكاح % 15(@)(@@) % حلى الزمان بجوده أجيادنا ، % وسخا ، فألبسنا ثياب مراح % 16(@)(@@) % حتى انتهبنا العيش حتى كأنه % % مال ابن أرتق في يد المداح % 17(@)(@@) % حامي النزيل ، إذا ألم بربعه ، % محيي الأنام بجوده السحاح % 18(@)(@@) % حسنت به الدنيا ، فكان أديمها % % عطلا من التجميل والأوضاح % 19(@)(@@) % حكم رضيت به فمد سماحه % ضيقي ، وحيا جوده بفلاحي % % 20(@)(@@) % حلت مكارمه عقال خصاصتي ، % إذ راش من بعد الخمول جناحي % % PageV01P1266 21(@)(@@) % حاربت دهري ، مذ حللت بربعه ، % وجعلته عند المضيق سلاحي % % 22(@)(@@) % حسبي ، إذا رمت الفخار من الورى ، % مغداي في أكنافه ورواحي % % 23(@)(@@) % حملت ، نجم الدين ، أعناق الورى % % مننا جساما من ندى وسماح % 24(@)(@@) % حكمت في الأموال آمال العدى ، % وجعلت شرب المجد غير صباح % 25(@)(@@) % حاز العلى ، فسرى بصارم عزمه % يغنيك عن خطية وصفاح % 26(@)(@@) % حزم فتحت به الأمور ، وإنها % % كالقفل محتاج إلى المفتاح % 27(@)(@@) % حجت إليك بنو الرحيل لعلمهم % % حقا بأنك كعبة المداح % 28(@)(@@) % حرم ، إذا حل الوفود بربعه ، % قرنت عواقب سعيهم بنجاح % 29(@)(@@) % حمدوك جهد 
ms285	 المستطيع ، وأثبتوا % % لعلاك شكرا ما له من ماح % PageV01P1267 البحر : طويل 1(@)(@@) % خيال سرى والنجم في القرب راسخ ، % ألم ، ومن دون الحبيب فراسخ % 2(@)(@@) % خطاء كماء البيد يجري ، وبيننا % % هضاب الفيافي ، والجبال الشوامخ % 3(@)(@@) % خفيذ الخطى وافى لينظر هل غفت % عيوني وهل جفت جفوني النواضخ % 4(@)(@@) % خف الله ، يا طيف الخيال ، فإنها % % بماء حياتي لا بدمعي فواضخ % 5(@)(@@) % خطرت إلى ميت الغرام ، مكلما % له بعدما ناحتء عليه الصوراخ % 6(@)(@@) % خطيب فهل عيسى بن مريم جاءه % لينطقه أم أنت في الصور نافخ % 7(@)(@@) % خض الليل وأقصد من أحب وقل له % % سأكتم ما بي ، وهو في القلب راسخ % 8(@)(@@) % خشيت انفساخ العهد عني ، وإنني % % لعهدك ، لا والله ، ما أنا فاسخ % 9(@)(@@) % خرجت من الدنيا بودك قانعا ، % وأنت لأضدادي بوصلك راضخ % 10(@)(@@) % خسرت ، ولم تعلم بأن عزائمي % % لأشباح حمي بالسرور نواسخ % PageV01P1268 11(@)(@@) % خلا الملك المنصور لي فأحلني % % محلا له تعنو الجبال البواذخ % 12(@)(@@) % خطت بي إليه همتي ، فوردته ، % فلا السعي مذموم ولا السور شامخ % 13(@)(@@) % خلعت نعال الشك في قدس ربعه ، % فمن تربه كفي لخدي لاطخ % 14(@)(@@) % خلصت من الأهواب لما لقيته ، % فبت منيعا ، والخطوب شوائخ % 15(@)(@@) % خشيت على الآرائك سطوة بأسه ، % وأطواد رضوى دونها والشمارخ % 16(@)(@@) % خليفة عصر ليس ينسخ جوده ، % ويغتاظ منه ماله المتناسخ % 17(@)(@@) % خصيب إذا ما الأرض صوح نبتها ، % حليم ، إذا أخفى الملوم الرواسخ % 18(@)(@@) % خلائقه بيض ، إذا هم قاصد ، % وأسيافه حمر ، إذا هم صارخ % 19(@)(@@) % خصال حواها من أبيه وجده ، % وأكسبه أسيافه والمشايخ % 20(@)(@@) % خزائنه مبذولة ، وأكفه % بحار الندى ، ما بينهن برازخ % PageV01P1269 21(@)(@@) % خطابك ، نجم الدين ، خطب على العدى % % فكيف إذا سلت ظباك النواضخ % 22(@)(@@) % خشنت على الأعداء في الحرب ملمسا ، % وغصنك غض في الشبيبة شارخ % 23(@)(@@) % خلقت رضى العليا ، ووجهك واضح ، % وجودك سحاح ، ومجدك باذخ % 24(@)(@@) % خبير بأمر الملك ، عدلك باسط ، % وعلمك فياض ، وحلمك راسخ % 25(@)(@@) % خفضت للهى كي ترفع الذل بالندى ، % فأنت لآل الجود بالجود ناسخ % 26(@)(@@) % خصصت بقلب في الشدائد جامد ، % فزانك كف بالمكارم ناصخ % 27 
ms286	(@)(@@) % خذ المدح مني ، وابق للحمد سالما ، % هنيئا لذكر عرفه بك فائخ % 28(@)(@@) % خلي ، يصوغ المدح فيك قلائدا ، % وينشده راو ، ويكتب ناسخ % PageV01P1270 البحر : كامل تام 1(@)(@@) % دمع مزائد قطره لا تجمد ، % أنى ، ونار صبابتي لا تخمد % 2(@)(@@) % دام البعاد ، فلا أزال مكابدا % دمعا يذوب ، وزفرة تتوقد % 3(@)(@@) % داء تأبد في الفؤاد مخيم ، % أعيا الأساة ، ومل عنه القود % 4(@)(@@) % دعني أموت بعد سكان الحمى % % بصبابتي ، كم جهد ، ما أتجلد % 5(@)(@@) % دار الأحبة جاد مغناك الحيا ، % وتراب ربعك للنواظر إثمد % 6(@)(@@) % دون ازديارك خوض أغمار الردى ، % والسمر تشرع ، والصفاح تجرد % 7(@)(@@) % دمن لنا في الجامعين تنكرت ، % من بعدها ، أعلامها والمعهد % 8(@)(@@) % درس الزمان جديدها بيد البلى ، % فالقلب يبلى ، والهوى يتجدد % 9(@)(@@) % دارت على سكانها كأس الردى ، % سكروا بها فغدا الزمان يعربد % 10(@)(@@) % دعت النوى بفراقهم ، فتفرقوا ، % وقضى الزمان ببينهم ، فتبددوا % % PageV01P1271 11(@)(@@) % وهمت من الدهر الخؤون عليهم % نوب على أيدي الزمان لها يد % 12(@)(@@) % دهر ذميم الحالتين ، فما به % شيء سوى جود ابن أرتق يحمد % 13(@)(@@) % دام الخلائق يمتطون به العلى ، % ويبيت منه الدهر ، وهو مسهد % 14(@)(@@) % درع به الملك العزيز مدرع ، % سيف به الدين الحنيف مقلد % 15(@)(@@) % داني النوال ، فلا ينال مقامه ، % قاضي المنال ، ورفده لا يبعد % 16(@)(@@) % ديم الدماء تسح من أسيافه % طورا ، ويمطر من يديه العسجد % 17(@)(@@) % دفع الخطوب عن الأنام بعدله ، % ورعى العباد بمقلة لا ترقد % 18(@)(@@) % دع من سواه ولذ بكعبة جوده ، % فجنابه لذوي المطالب مقصد % 19(@)(@@) % دم في سماء الملك ، يا نجم العلى ، % إن العباد لجود كفك أعبد % 20(@)(@@) % دبرت أمر المسلمين ، فطوقوا ، % بنداك ، أطواق الحمام ، فغردوا % % PageV01P1272 21(@)(@@) % داويت أضعاف الصدور بصارم ، % ماء المنون بمتنه يتجعد % 22(@)(@@) % دبت نمال الموت في شفراته ، % وجرى الحمام بحده يتردد % 23(@)(@@) % داع ، إذا ما قام يوما خاطبا ، % فالهام تركع والجماجم تسجد % 24(@)(@@) % دامي المضارب لو عكست شعاعه % % فوق الجبال ، لذاب منه الجلمد % 25(@)(@@) % دانت له الدنيا فمنظر وجهها % % طلق ، وخد الدهر منه مورد % 26(@)(@@) % دكت بك الأرضون حين حللتها % % فعليك تغبطها السماء 
ms287	 وتحمد % 27(@)(@@) % دنت المطي بنا إليك بحدة ، % فلها علينا منة لا تجحد % 28(@)(@@) % دانيت ربعك والأعادي شمت ، % فرجعت عنه والورى لي حسد % 29(@)(@@) % دس هامة العلياء وابق مملكا % أبدا يحل بك الزمان ويعقد % PageV01P1273 البحر : كامل تام 1(@)(@@) % ذكر العهود فأسهر الطرف القذي % % صب بغير حديثكم لا يغتذي % % 2(@)(@@) % ذاق الهوى صرفا ، فأعقب قلبه % % فكر الصحاة ، وسكرة المتنبذ % 3(@)(@@) % ذم الهوى لما تذكر إلفه ، % بالجامعين ، وحبله لم يجذذ % 4(@)(@@) % ذر النسيم عليه من أكنافه % نشر العبير فشاقه العرف الشذي % % 5(@)(@@) % ذابت بكم ، يا أهل بابل ، مهجتي % % فتنغصت بالعيش بعد تلذذ % 6(@)(@@) % ذهب الوفا بعد الصفاء ، فما عدا ؟ % وعدتموني بالوصال فما الذي ؟ % 7(@)(@@) % ذبلت غصون الود فيما بيننا ، % وجرى الذي قد كان منه تعوذي % % 8(@)(@@) % ذاب الكرى عن ناصري بفراقكم ، % ولكم جلوت بنوركم طرفي القذي % % 9(@)(@@) % ذلت بكم روحي ، وكنت ممنعا % في صفو عيش عزه لم يفلذ % 10(@)(@@) % ذل علاني ، والعداة عزيزة ، % لو لم يكن جود ابن أرتق منقذي % % PageV01P1274 11(@)(@@) % ذاك الذي بسط المهيمن كفه % في أنعم الدنيا ، وقال لها : خذي % % 12(@)(@@) % ذو راحتين : هما المنية والمنى ، % يسطو بتلك ويبذل النعمى بذي % % 13(@)(@@) % ذاكي العزائم في جلابيب التقى ، % ناش ، ومن ثدي الفضائل يغتذي % % 14(@)(@@) % ذخرت خزائنه ، فقال لها : انفدي ، % وذكت عزائمه فقال لها : انفذي % % 15(@)(@@) % ذلق الفضائل هكذا فضل التقى ، % غدق البنان على الفصاحة قد غذي % % 16(@)(@@) % ذمم الزمان بعدله محفوظة ، % فذمامه من غيره لم يؤخذ % 17(@)(@@) % ذاعت سرائر فضله بين الورى ، % وسما الأنام بجوده المستحوذ % 18(@)(@@) % ذروات مجد لاتنال وهمة % طالت فكادت للكواكب تحتذي % % 19(@)(@@) % ذخر لنا في النائبات وملجأ ، % من لم يلذ بجنابه لم ينفذ % 20(@)(@@) % ذكري له راع الخطوب لأنني ، % من كيدها بسواه لم أتعوذ % PageV01P1275 21(@)(@@) % ذهلت صروف الدهر منه فلم تجد % % نحوي لأسهم كيدها من منفذ % 22(@)(@@) % ذعر الزمان وقال : هل من عاصم % منه ألوذ به ؟ فقلت له : لذ % 23(@)(@@) % ذر عنك نجم الدين أشباح العدى ، % وعلى صميم قلوبهم فاستحوذ % 24(@)(@@) % ذكر بهم سهم القضاء ، فإنه % بسوى الذي 
ms288	 تختاره لم ينفذ % 25(@)(@@) % ذللت أعناق الطغاة بصارم ، % بسوى الجماجم حده لم يشحذ % 26(@)(@@) % ذكر إذا شكت الظما شفراته % في غير يم دمائهم لم ينبذ % 27(@)(@@) % ذا السعي قد قرت به عين الورى ، % فالملك يزهو زهوة المتلذذ % 28(@)(@@) % ذرت الزمان على الطغاة وقد طغى ، % وجلوت طرف المكرمات وقد قذي % % 29(@)(@@) % ذويت عداك ولا برحت منعما ، % عن رفد طلاب الندى لم تجذذ % PageV01P1276 البحر : بسيط تام 1(@)(@@) % رقت لنا حين هم الصبح بالسفر ، % وأقبلت في الدجى تسعى على حذر % 2(@)(@@) % راض الهوى قلبها القاسي ، فجاد لنا ، % وكان أبخل من تموز بالمطر % 3(@)(@@) % رأت غداة النوى نار الكليم ، وقد % % شبت ، ولم تبق من قلبي ولم تذر % 4(@)(@@) % رقت إلى الصب طول الوصل راقية ، % فقلت : قد جئت يا موسى على قدر % 5(@)(@@) % ربيبة لو تراها عندما سفرت ، % والبدر ساه إليها سهو معتذر % 6(@)(@@) % رأيت بدرين من شمس ومن قمر ، % في ظل جنحين من ليل ومن شعر % 7(@)(@@) % رشفت برد الحميا من مراشفها ، % فنبهتني إليها نسمة السحر % 8(@)(@@) % رنت نجوم الدجى نحوي فما نظرت % من يرشف الراح ليلا من فم القمر % 9(@)(@@) % راق العتاب ، فأبدت لي سرائرها ، % في ليلة الوصل بل في غرة القمر % 10(@)(@@) % رثت فلما رأت رسل النوى فغدت % تطيل عتبي ، وعمر الليل في قصر % % PageV01P1277 11(@)(@@) % رحب مقامي بمغناها ، فمذ نظرت % ذم المطي قضت للصفو بالكدر % 12(@)(@@) % ريعت لذم المطايا للسرى قعدت ، % وأحذرتني من الأهوالي في سفري % % 13(@)(@@) % رامت بذلك تخويفي ، فقلت لها : % عندي من الخبر ما يغني عن الخبر % 14(@)(@@) % ردي ، فما ضرني هول أكابده ، % ونائل الملك المنصور في الأثر % 15(@)(@@) % رب النوال ، ومحمود الخصال ، ومق % % دام النزال ، وأمن الخائف الحذر % 16(@)(@@) % راعي الأنام بعين غير راقدة ، % قد وكلت في أمور الملك بالسهر % 17(@)(@@) % رحب الذراعين لولا صبح غرته ، % لأصبح الجود فجرا غير منفجر % 18(@)(@@) % راض مع السخط يبدي عزم منتقم % للمنذبين ، ويعفو عفو مقتدر % 19(@)(@@) % راحاته مذ نشا في الملك قد عهدت % يوم الندى والردى بالنفع والضرر % 20(@)(@@) % روى مناقبه الراوي 
ms289	 ، فقلت له : % جلوت سمعي ، فهل تجلو به بصري % % PageV01P1278 21(@)(@@) % رح أيها الملك المنصور ، واغد على % % هام العلى آمنا من حادث الغير % 22(@)(@@) % رسمت جودا حكى الطوفان فاعتصمت % منه الخلائق بالألواح والدسر % 23(@)(@@) % رفقت بالناس في كل الأمور ، فقد % % أضحى الزمان إليهم شاخص ر % 24(@)(@@) % ربوا لديك ، فلولا أن بعضهم % تجل عنه ، لقلنا : يا أبا البشر % 25(@)(@@) % رعت العدى بحسام لو عدلت به % عنهم ، لأغناك عنه صارم القدر % 26(@)(@@) % رفعت ذكرك في يوم الهياج به ، % فأذكرتني بحد الصارم الذكر % 27(@)(@@) % رمت إليك بنا هوج مضمرة ، % كأنها في الدجى قوس بلا وتر % 28(@)(@@) % راحت إلى جنة حل العفاة بها % % في الخلد ، واتكأوا فيها على سرر % 29(@)(@@) % رجعت أعتب نفسي في تأخرها % % عنها ، طورا أهني النفس بالظفر % PageV01P1279 البحر : كامل تام 1(@)(@@) % سفح المزاج على حميا الكاس ، % وسعى يطوف بها على الجلاس % 2(@)(@@) % ساق ، فلو طرح المدام لأسكرت % صهباء فاتر طرفه النعاس % 3(@)(@@) % سكران من خمر الدنان كأنما % % عبث النسيم بقده المياس % 4(@)(@@) % سال العذار على أسيل خدوده ، % فغدا يسيج وردها بالآس % 5(@)(@@) % ساوى الرفاق بشربها ، حتى إذا % % ثمل المدير ، وغاب رشد الحاسي % % 6(@)(@@) % سكنت مقر عقولهم ، وتمكنت ، % فغدت توسوس في صدور الناس % 7(@)(@@) % سفرت فكانت تحت جلباب الدجى ، % تغني عن المصباح والمقباس % 8(@)(@@) % سلت عليها للمزاج صوارم ، % لتروض منها الخلق بعد شماس % 9(@)(@@) % سل النفوس بقهوة ديرية ، % كالشمس تشرق في يد الجلاس % 10(@)(@@) % سمها ، ولا تبخل ، إذا تجلو بها % % خوفا من الإقتار والإفلاس % PageV01P1280 11(@)(@@) % سمح كفوفك في الشراء ، فرأينا % % ثقل الكؤوس وخفة الأكياس % 12(@)(@@) % سابق إلى جنات عدن قد بدت % أزهارها بغرائب خير لباس % 13(@)(@@) % سكرت قدود غصونها فترنمت % ورق الحمام بأطيب الأنفاس % 14(@)(@@) % سجعت ، فخلنا الطوق في أعناقها % % من ابن أرتق في رقاب الناس % 15(@)(@@) % سلطان عدل بل خليفة منصب ، % أحيت مناقبه بني العباس % 16(@)(@@) % سقمت به مهج العداة ، وطالما % % سقم الزمان وكان نعم الآسي % % 17(@)(@@) % سيف أعز الدين بعد هوانه ، % فبدت رسوم ربوعه الأدراس % 18(@)(@@) % سارت لخسف الأرض قب جياده ، % فأمدها 
ms290	 من حلمه برواس % 19(@)(@@) % سهل الخلائق لين عند الندى ، % لكنه عند الشدائد عاس % 20(@)(@@) % سبقت عطاياه السؤال ، فماله % في مأتم ، والناس في أعراس % PageV01P1281 21(@)(@@) % سن المواهب ، والجهاد ، فدهره % يومان : يوم قرى ويوم قراس % 22(@)(@@) % سعي أساس المجد منه ثابت ، % والمجد لا يبنى بغير أساس % % 23(@)(@@) % سهدت ، نجم الدين ، طرفك للعلى ، % فحفظت دوحتها من الإيباس % 24(@)(@@) % سرت بسعيك ، واطمأنت أنفس % كانت من الأيام في وسواس % 25(@)(@@) % سعدت بك الدنيا ، وعاد نفارها ، % من بعد وحشتها ، إلى الإيناس % 26(@)(@@) % سد في الأنام ، فلا برحت مؤملا % تسوي الخلائق في الندى وتواسي % % 27(@)(@@) % سمح الأكف تروم نائلك الورى ، % وتخافك الآساد في الأخياس % 28(@)(@@) % سعد أتاك من الإله مؤيد ، % فاخلد ، ودم في نعمة وغراس % PageV01P1282 البحر : طويل 1(@)(@@) % شمول إلى نيرانها أبدا نعشو ، % لتنعشنا من بعد ما ضمنا نعش % 2(@)(@@) % شغفنا بها ، والعز قد مد ظله % علينا ووجه الأرض هش لنا بش % 3(@)(@@) % شقيقة خد بالسرور مدرج % بها ، ولوقع الماء في خدها خدش % 4(@)(@@) % شهرنا عليها للمزاج صوارما ، % إذا عملت ما للجراح بها أرش % 5(@)(@@) % شمول عقار في أكف أهلة ، % لها لهب وهم الظلام بها يرشو % % 6(@)(@@) % شعاع غدا طرف المسرة شاخصا % إليه ، وأحداق الهموم به عمش % 7(@)(@@) % شددت بها أزر السرور ، وزرتها % % بفتيان صدق ليس في ودهم غش % 8(@)(@@) % شباب ، ولكن في العلوم مشايخ ، % إذا خوطبوا بشوا وإن سئلوا بشوا % % 9(@)(@@) % شهدنا زواج الراح والماء والندى ، % عليهم نثار ، والرياض له فرش % 10(@)(@@) % شدت ، إذ بدت تجلى على كل قينة % كبلقيس حسنا ، والجمال لها عرش % PageV01P1283 11(@)(@@) % شربنا ، وقد حاك الربيع مطارفا % حسانا لدمع الطل من فوقها رش % 12(@)(@@) % شباك على خد الهضاب يبثها % % بكار ، وفي كف الوهاد بها نقش % 13(@)(@@) % شممنا أريجا من شذا بأنيقة ، % تشارك في ديباجها الطل والطش % 14(@)(@@) % شعاب من الحدباء يضحكها الحيا ، % ويحرسنا بأس ابن أرتق والبطش % 15(@)(@@) % شجاع ترى متن الجياد مهاده ، % وتألم جنبيه الوسائد والفرش % 16(@)(@@) % شبيه سليمان الزمان ، إذا غدا % % تحف به في سيره الطير والوحش % 17(@)(@@) % شهاب له الشهباء 
ms291	 أفق ، ومطلع ، % وشمس عيون الخطب من نورها تعشو % % 18(@)(@@) % شهي إليه في الندى بذل ماله ، % وأبغض شيء عنده الجمع والفرش % 19(@)(@@) % شديد القوى من معشر لفوا الوغى ، % إذ نهض المقدام من شرها ينشو % % 20(@)(@@) % شفاة ، كفاة ، لا المواثيق عندهم % % تضاع ولا الأسرار من بينهم تفشو % % PageV01P1284 21(@)(@@) % شريف له ناران للحرب والقرى % % تلوحث بها في الليل من بينهم تفشو % % 22(@)(@@) % شواظ وغى كل يحاذر وقدها ، % ونار قرى كل إلى ضوئها يعشو % % 23(@)(@@) % شفار مواضيه ، إذا هي جردت ، % فأيسر مقتول بها اللوم والفحش % 24(@)(@@) % شققن قلوب الحادثات بوقعها ، % وشاركت الأقدار أقلامه الرقش % 25(@)(@@) % شعارك ، يا نجم الملوك وبدرها ، % سماح يد طفل الثناء بها ينشو % % 26(@)(@@) % شغلت صروف الحادثات عن الورى ، % فأبصارها كمه ، وأسماعها طرش % 27(@)(@@) % شننت على الأعداء غارة عزمة ، % فبادت ولما يغنها النبل والبطش % 28(@)(@@) % شككت كلاها في رماح كأنها % % أفاع لها في كل جارحة نهش % 29(@)(@@) % % بجود هتون المزن في ضمنه طش % PageV01P1285 البحر : كامل تام 1(@)(@@) % صرف المدام به السرور مخصص ، % وبه الهموم عن القلوب تمحص % 2(@)(@@) % صرف بها عنك الهموم لتغتدي % % فرقا ، إذا تملا الكؤوس النقص % 3(@)(@@) % صبهاء قد راض المزاج مزاجها ، % فغدت تقهقه ، والفواقع ترقص % 4(@)(@@) % صاغ المزاج لها فواقع فضة % مثل اللآلي ، وهي تبر مخلص % 5(@)(@@) % صد التقى قوما ، فأبدوا زهدهم % % فيها ، وماذا ضرهم لو رخصوا % % 6(@)(@@) % صاموا ، وفطرهم على مفسودها % % جهل ، فهلا استخلص ما استخلصوا % % 7(@)(@@) % صفت المدامة والسقاة فتارة % تزجى الكؤوس وتارة تتربص % 8(@)(@@) % صعبت ، فحكمنا السقاة بمزجها % % فغدا يزيد بها المزاج وينقص % 9(@)(@@) % صبغتء خدود سقاتها من نورها % % شفقا به تجلى العيون الشخص % 10(@)(@@) % صدق الذي قد قال عن شمس الضحى % % إن البدر بنورها تتقمص % PageV01P1286 11(@)(@@) % صفراء من وقع المزاج صقيلة ، % يسعى بها سبط البنان مخرص % 12(@)(@@) % صنم أضل العاشقين ، فمعشر % قد زودوا فيها ، وقوم نقصوا % % 13(@)(@@) % صاد القلوب بمقلتيه ولم أخل % % أن الجآذر للقساور تقنص % 14(@)(@@) % صبغ الأنامل من دمائي ، وما درى % % أن ابن أرتق عن دمي يتفحص % 15(@)(@@) % صبح جلا ليل الخطوب 
ms292	 بنوره ، % نجم إليه كل طرف يشخص % 16(@)(@@) % صعب العريكة ، سهلة أخلاقه ، % قوم به سعدوا ، وقوم نغصوا % % 17(@)(@@) % صابت يداه ، فلا السماح بربعه % وان ، ولا ظل الأماني يقلص % 18(@)(@@) % صدرت مناقبه الحسان ، فأصبحت % تغري الأنام بمدحه وتحرص % 19(@)(@@) % صعدت مراتب مجده ، فكأنما % % تعلو له فوق المجرة أخمص % 20(@)(@@) % صاحبت ، نجم الدين ، دهرك صائلا % بعزيمة من كيده لا تنكص % PageV01P1287 21(@)(@@) % صقلت تجاريب الأمور متونها ، % كالسيف يصلحه الصقال ويخلص % 22(@)(@@) % صرمت شمال المسلمين بصارم % غال ، به مهج القلوب ترخص % 23(@)(@@) % صافي الحديدة في مضاربه الردى ، % باد ، وشكل الموت فيه مشخص % 24(@)(@@) % صادمتهم في نقع ليل حالك ، % طرف المنية في دجاه أخوص % 25(@)(@@) % صفت صفاح الهند حول أديمه ، % فكأنه بالبيض عبد أبرص % 26(@)(@@) % صكت ظباك رؤوسهم وجسومهم ، % فالهام تنثر ، والضلوع تقصص % 27(@)(@@) % صرف القضاء ، يا ابن أرتق خادم % لعلوكم ، والدهر داع مخلص % 28(@)(@@) % صوبت نحوكم عنان مدايحي ، % فمدقق من نظمها وملخص % 29(@)(@@) % صحت معانيها ، وشرف لفظها % % بكم ، وطاب ختامها والمخلص % PageV01P1288 البحر : كامل تام 1(@)(@@) % ضحكت ثغور حدائق الأرض ، % فسهت عيون النرجس الغض % 2(@)(@@) % ضرب الربيع بها مضاربه ، % وجرت جياد السحب في الركض % 3(@)(@@) % ضاع العبير من الربيع ، فما % % عذر إلى اللذات من نهض % 4(@)(@@) % ضيعت بعض العمر مشتغلا ، % أفلا خلفت العيش بالبعض % 5(@)(@@) % ضع منة واجل المدام لنا ، % فيها من الأيام نستقضي % % 6(@)(@@) % ضرج بها خد السرور ، فقد % % أيقنت أن الدهر في قبض % 7(@)(@@) % ضحك الحباب بها ، وقد غضبت % للشاربين بسخطها ترضي % % 8(@)(@@) % ضجت لوقع الماء ، واضطربت % من غير إيلام ، ولا مض % 9(@)(@@) % ضيع كنوز الملك ، وابق لنا % % راحا إلى راحاتها تفضي % % 10(@)(@@) % ضمن الشبيبة والربيع حلا % % رشفي الطلا ، ولغيرها رفضي % % PageV01P1289 11(@)(@@) % ضاء الزمان إضاءة بسما % % يزهو بثوب غير مرفض % 12(@)(@@) % ضرب من الأنوار مبتهج ، % ما بين مزرور ومنفض % 13(@)(@@) % ضفت الرياض ، وما أضر بها % % إخلاف وعد البرق في الومض % 14(@)(@@) % ضن السحاب بمائه ، فروت % كف ابن أرتق غلة الأرض % 15(@)(@@) % ضراب هامات الكماة ، ومن % % راض الزمان بخلقه المرضي % % 16(@)(@@) % ضرغام بأس غير محتجب 
ms293	 % خوفا ، ونجم غير منقض % 17(@)(@@) % ضاهى السحائب منه جود يد ، % معتادة بالبسط والقبض % 18(@)(@@) % ضمنت سماحة راحتيه لنا % % بر البلاد بجوده المحض % 19(@)(@@) % ضبع لدين الله منذ علا % % الإسلام آمنة من الخفض % 20(@)(@@) % ضبطت أمور المسلمين به % ضبطا به أمنت من النقض % PageV01P1290 21(@)(@@) % ضخم الدسيعة ، جوده غدق ، % أحوى المرابع أبيض العرض % 22(@)(@@) % ضر العداة ، ونفع قاصده ، % كل يراه عليه كالفرض % 23(@)(@@) % ضمن اليراع وحد صارمه % عز الوالي وذل ذي البغض % 24(@)(@@) % ضدان ذا يولي الجميل ، وذا % % أبدا بحتف عداته يقضي % % 25(@)(@@) % ضر السهاد بمعشر ، فرأى % % سهاده أحلى من الغمض % 26(@)(@@) % ضاقت بجحفله وعزمته % أرض الفلا في الطول والعرض % 27(@)(@@) % ضل الذي أضحى يطاوله % وبإصره يجري القضا المقضي % % 28(@)(@@) % ضجر الذي جاراه حين رأى % % سهم القضاء بأمره يمضي % % 29(@)(@@) % ضليت إن لم أصفه مدحي ، % وإليه نضو قريحتي أنضي % % PageV01P1291 البحر : خفيف تام 1(@)(@@) % طاف يسعى بسرعة ونشاط ، % ويعاطي المدام أحلى تعاط % 2(@)(@@) % طيب النشر يجرح اللحظ خدي % % ه ويدمي أعضاه مس القباطي % % 3(@)(@@) % طلق وجه تلهب الخد في % % ه ووافى عذاره كالسراط % 4(@)(@@) % طرس خد له عليه سطور % ما ألمت به يد الخطاط % 5(@)(@@) % طالما زارني وقد مدت الأر % ض رياضا من تحتنا كالسماط % 6(@)(@@) % طل فيها دم الدنان ، فبالأق % داح طورا ، وتارة بالبواطي % % 7(@)(@@) % طفحت نشوة المدام وقد ش % % طت على الشاربين أي اشتطاط % 8(@)(@@) % طوحت بالسقاة ، حتى أطاعوا ، % وأباحوا الوصال بعد احتياط % 9(@)(@@) % طافت سعاد تضم لأغصا % % ن قدود من الظباء العواطي % % 10(@)(@@) % طوق تلك الأجياد أجعلها طو % % را ، وطورا مناطق الأوساط % PageV01P1292 11(@)(@@) % طبت عيشا لما رأيت يد الصب % ح لدر النجوم ذات التقاط % 12(@)(@@) % طفل صبح له من الشرق مهد ، % وله حلة الدجى كالقماط % 13(@)(@@) % طرد الليل بالضياء ، فمذ لا % % ح فأهوت نجومه بانهباط % 14(@)(@@) % طلعت في الأنام غرة نجم % لعلاه على النجوم مواطي % % 15(@)(@@) % طالع بالسعود في أفق الشه % % با ، فعش دائما به في اغتباط % 16(@)(@@) % طاب رزق له بمغناه فالرز % % ق لدى غيره كسم الخياط % 17(@)(@@) % طاهر 
ms294	 الجد جده كل يوم % في صعود وضده في انحطاط % 18(@)(@@) % طود حلم يكاد يستعبد الده % % ر بعزم له شديد النياط % 19(@)(@@) % طب هذا الزمان ، وهو جسيم ، % قصرت دونه يدا بقراط % 20(@)(@@) % طوق الناس بالندى ، فهناهم % % في دوام ، ورزقهم في انبساط % PageV01P1293 21(@)(@@) % طبعت راحتاه من جوهر الجو % % د ، وليس المعطي كالمتعاطي % % 22(@)(@@) % طال في المال عز كفيه ، حتى % % أفرطت فيه غاية الإفراط % 23(@)(@@) % طاعن الخيل قبل ذابلة اللد % % ن ، بلدن من عزمه ذي شطاط % 24(@)(@@) % طرفه الدهر أينما سار ، والحز % % م عنان ، وعزمه كالسياط % 25(@)(@@) % طاردته الكرام في حلبة الجو % % د ، فكلوا في أول الأشواط % 26(@)(@@) % طلبوا شأوه ، فما حصل الطا % % لب من كنزه سوى قيراط % 27(@)(@@) % طاوعتني جواهر المدح فيه ، % فأتت في النظام كالأسماط % 28(@)(@@) % طيب اللفظ لو حوته اللآلي % % جعلته الحسان كالأقراط % 29(@)(@@) % طرف كالعقود ، فالدر منها % % ذكره والبيوت كالأسماط % PageV01P1294 البحر : كامل تام 1(@)(@@) % طفرت سهام فواتر الألحاظ ، % فرمت صميم قلوبنا بشواظ % 2(@)(@@) % ظلت تقاتل للمقاتل أسهما % أغنت عن الأفواق والأرعاظ % 3(@)(@@) % ظلمت ظباء الخيف حين منحتها % % حفظ العهود ، وجهدها إحفاظي % % 4(@)(@@) % ظبيات أنس صيدهن محرم ، % يرتعن ما بين الصفا ، فعكاظ % 5(@)(@@) % ظعنوا ، فبت أسح دمعي بعدهم ، % وأجيل في تلك الديار لحاظي % % 6(@)(@@) % ظفري لسني قارع ، ومدامعي % % قد خددت خدي بالإلظاظ % 7(@)(@@) % ظن الخلي بأن أحاول بعدهم % % سكنا ، ودام بعدله إيقاظي % % 8(@)(@@) % ظلم ، إذا ظعن الخليط ولم أسر % بالعيش بين تنايف وشناظ % 9(@)(@@) % ظهرية إن ضامها ألم السرى % % حثت مناسمها بغير مظاظ % 10(@)(@@) % ظلمات دجن في الظلام دواهش ، % من حولها هول السرى إيقاظي % % PageV01P1295 11(@)(@@) % ظلعت ، فأنحلها السرى ، فتأودت % من طول مس شظاظهن شظاظي % % 12(@)(@@) % ظأب الحداة يحثها ، فإذا ونت % تفنى بزجر حداتها الأفظاظ % 13(@)(@@) % ظبظابها ألم المسير ، ووقعها % % بيدي حداة في المسير غلاظ % 14(@)(@@) % ظلت على المرعى الخصيب نفوسنا % % متألمين بسائق ملظاظ % 15(@)(@@) % ظلنا نقاسمهن أهوال السرى ، % ونبيت في حث به ودلاظ % 16(@)(@@) % ظعن يقود إلى الحبيب نفوسنا ، % وإلى ابن أرتق جوهر الألفاظ % 17(@)(@@) % ظل ظليل للعفاة فدره % ينسيك 
ms295	 وقد جواهر الأقباظ % 18(@)(@@) % ظرفت خلائقه ، وأحفظ ماله % % فأضاعه ، رغما ، على الحفاظ % 19(@)(@@) % ظفر به در العداة بغيظهم ، % مذ أنهم علموا بمن أنا حاظي % % 20(@)(@@) % ظلام جذب الظالمين بصارم ، % قد خاطب الغلظاء بالإغلاظ % PageV01P1296 21(@)(@@) % ظلت ظباه ، إذ غدت تعظ الورى ، % إن الرؤوس منابر الوعاظ % 22(@)(@@) % ظام إلى نهل الدماء ، فهمه ، % يوم الهياج ، تشتت الأشواظ % 23(@)(@@) % ظمئت مضارب غفرتيه ، فأصبحت % من عدم اللهوات ذات لماظ % 24(@)(@@) % ظني جميل فيك يا من أصبحت % ترنو إلى نعمائه ألحاظي % % 25(@)(@@) % ظفروا بظلك ، يا مليك ، فإنهم % % بولاك قد فازوا بخير حفاظ % 26(@)(@@) % ظران أرضك للسماء قد اغتدت ، % بك ، في مفاخرة وفرط غياظ % PageV01P1297 البحر : كامل تام 1(@)(@@) % عذل العواذل في هواك مضيع ، % هب أنهم عذلوا ، فمن ذا يسمع % 2(@)(@@) % عذلوا ، ولو عدلوا بأرباب الهوى ، % ما حاولوا ما ليس فيه مطمع % 3(@)(@@) % علموا بأنك هاجري ، فتوهموا % % أني لذلك بالملامة أردع % 4(@)(@@) % عدوا صفاتك فانثنيت بلومهم ، % واللوم فيه ما يضر وينفع % 5(@)(@@) % عذبت بالهجران صبا ما له % حتى الممات إلى سواك تطلع % 6(@)(@@) % عار يناديه الهوى ، فيجيبه % طوعا ، ويدعوه الغرام فيسمع % 7(@)(@@) % عين تنام ، إذا هجرت ، لعلها % % بخيال طيفك في المنام تمتع % 8(@)(@@) % عطف الخيال بأن يلم ، فإنني % % أرضى بإلمام الخيال ، وأقنع % 9(@)(@@) % عد بالجميل ، كما عهدت ، فإنه % % لم يبق في قوس التصبر منزع % 10(@)(@@) % عسفا صبرت على هواك ، لأنني % % إن لم ألذ بالصبر ، ماذا أصنع % PageV01P1298 11(@)(@@) % عل الزمان يرد أيام الرضى ، % أو أن ساعات التواصل ترجع % 12(@)(@@) % عز الشفيع إلى الزمان ، وإنني % % بسوى يد المنصور لا أتشفع % 13(@)(@@) % علم لنا منه الخلافة منصب ، % نجم له أفق المعالي مطلع % 14(@)(@@) % عضد لوا الإسلام مشدود به ، % ركن لدين الله لا يتزعزع % 15(@)(@@) % عبل ، إذ لاقى العداة بمعرك ، % سيان منهم حاسر ومدرع % 16(@)(@@) % عذب ، مرير ، عابس ، متبسم ، % ناء ، قريب ، مبطىء ، مترعرع % 17(@)(@@) % عالي المراتب تخضع الدنيا له ، % طوعا ، وتحسده النجوم الطلع % 18(@)(@@) % عهدت يداه بالسماح فأصبحت % ترجو مواهبه الخلائق أجمع % 19(@)(@@) % علم الخلائق من نداه بوابل % غدق سحائب جوده لا 
ms296	 تقطع % 20(@)(@@) % عبق الثناء ، ففرقت أمواله % كف لشمل بالسماح تجمع % PageV01P1299 21(@)(@@) % عجلت يداه على عداه بصارم % برق المنية من سناه يلمع % 22(@)(@@) % عضب إذا ما قام يوما خاطبا ، % % 23(@)(@@) % % فالهام تسجد والجماجم تركع % 24(@)(@@) % عطشان من طول الضراب ، وإنه % % بسوى الدماء غليله لا ينقع % 25(@)(@@) % عصفت رياح الموت من شفراته ، % فتكلمت فيه الطباع الأربع % 26(@)(@@) % علقت يدي بك يا أبا الفتح الذي % % عني ، ويمنحني الوصال ويمنع % 27(@)(@@) % علما بأن الجود فيك صنيعة ، % طبع ، وذلك في سواك تطبع % 28(@)(@@) % عش في نعيم لا ينقل ظله ، % وعلى يذل بها الزمان ويخضع % PageV01P1300 البحر : خفيف تام 1(@)(@@) % غير مجد مع صحة وفراغ % طول مكثي ، والمجد سهل لباغي % % 2(@)(@@) % غفلت همتي عن السعي ، حتى % % بلغتني الأيام شر بلاغ % 3(@)(@@) % غالط من يحط عن صهوة الع % ز ويرضى بموقع الأرساغ % 4(@)(@@) % غب عن الهم يصف عيشك يا صا % % ح ، ولا تنثن إلى الفراغ % 5(@)(@@) % غن لي باسم ليلى عسى ويوم البا % % غي فيه له يوم عين الباغ % 6(@)(@@) % غاب عنا الرقيب وابتدر ال % % ساقي على الكؤوس والفراغ % 7(@)(@@) % غنج الطرف ذو خد أسيل % لم يزل من دمائنا في الصباغ % 8(@)(@@) % غال فينا وجار في القتل حتى % % تسلسلت عقارب الأصداغ % 9(@)(@@) % غصت الراح بالمزج ، فجاشت % بحباب ، يحكي الثغور ، سباغ % 10(@)(@@) % غضبت ، فانثنت توسوس في العق % % ل شياطين فكرها في النزاغ % PageV01P1301 11(@)(@@) % غيرت صبغة الدنان بنور ، % هو للكأس أحسن الأصباغ % 12(@)(@@) % غسق خلت أن وجه أبي الفت % % ح جلاه بنوره البزاغ % 13(@)(@@) % غيث جود إن هم للقصد راج ، % ووبال إن هم بالجور باغ % 14(@)(@@) % غدق الجود بعدما هو مم % % طر شرب الخيل والمطي الرواغي % % 15(@)(@@) % غافر للذنوب بعد اقتدار ، % عائد للصلاة بعد الفراغ % 16(@)(@@) % غابن للمال أن يجود علي % % ه جود أسيافه على كل باغ % 17(@)(@@) % غرس الجود في الورى وأسرا % % ه بكثر الغرس في بطون الأواغي % % 18(@)(@@) % غمر العالمين نائل كفي % % ه ببذل النوال والإسباغ % 19(@)(@@) % غشي الحرب يهتدي بحسام % عارف بالنحور والأصداغ % 20(@)(@@) % غاض في لجة 
ms297	 المفارق حتى % % خصم العقل في مقر الدماغ % PageV01P1302 21(@)(@@) % غادر الشهب كالعجاجة دهما ، % وسناها مخضوبة الأرساغ % 22(@)(@@) % غارة لم يخف بها زجر قوم ، % ليس تخشى الأسود نغوة ثاغ % 23(@)(@@) % غبطة فيها الخلائق إذ ب % ت ، ودهر مصغ إلي وصاغ % 24(@)(@@) % غصص الدهر قبله أخلصتني ، % فانثنيت للناس نشر مساغ % 25(@)(@@) % غير أن العزائم الأرتقيا % % ت حمتني من صرفه الرواغ % 26(@)(@@) % غض طرف الأعداء عنك أبا الفت % % ح وباتت قلوبهم في ارتياغ % 27(@)(@@) % غيظ أهل النفاق منك وأم % % سى كل ضار من خوفه وهو صاغ % 28(@)(@@) % غاص منه ماء الحياة فبادت % حذرا من سنانك اللداغ % 29(@)(@@) % غم أعداء لا برحت بملك % آمنا من شوائب الارتياغ % PageV01P1303 البحر : كامل تام 1(@)(@@) % فتك اللواحظ والقدود الهيف % أغرى السهاد بطرفي المطروف % 2(@)(@@) % فجهلت تضعيف الجفون ، وإنما % % ضعف القلوب بذلك التضعيف % 3(@)(@@) % في كل يوم للواحظ غارة % شغفت بنهب فؤادي المشغوف % 4(@)(@@) % فترت وما فتر القتال وأضعفت ، % وفعالها بالفتك غير ضعيف % 5(@)(@@) % فلئن سطت أيدي الفراق وأبعدت % بدرا تحجب نصفه بنصيف % 6(@)(@@) % فلكم نعمت بوصله في منزل % قد طاب فيه مربعي ومصيفي % % 7(@)(@@) % فارقت زوراء العراق ، وإن لي % % قلبا أقام بربعه المألوف % 8(@)(@@) % فلأثنين إلى العراق أعنتي ، % وأطيل في تلك الديار وقوفي % % 9(@)(@@) % فيها بدور في خلال مضارب ، % وشموس دجن من وراء سجوف % 10(@)(@@) % فاقت بكل مقرطق ومشنف ، % والحسن بين قراطق وشنوف % PageV01P1304 11(@)(@@) % فات المراد ، فبت أقرع بعدهم % % سني ، وأصفق ، إذ نأيت ، كفوفي % % 12(@)(@@) % فردا أعلل من لقاهم بالمنى ، % وأعيش بعد القوم بالتسويف % 13(@)(@@) % فصلت ملازمة السقام مفاصلي ، % بيد البعاد ، وأنكرت تعريفي % % 14(@)(@@) % فعرفت بالحب المبرح مثلما % % عرفت يد المنصور بالتصريف % 15(@)(@@) % فخر الملوك ، ونجمها ، وهلالها ، % غوث الطريد وملجأ الملهوف % 16(@)(@@) % فكر يدور في أمور مانه % % طرفي ، خبير في الزمان عروف % 17(@)(@@) % فجر ، إذا ما الظلم أظلم ليله ، % جلى دجاه بعدله الموصوف % 18(@)(@@) % فرض على أسيافه وبنانه % بالعد ردده وصرف صروف % 19(@)(@@) % فتكت يداه بالنضار ، فأتلفت % ماضمه من تالد وطريف % 20(@)(@@) % فشعاره في الحرب فل مقانب ، % وصنيعه في 
ms298	 السلم بذل ألوف % PageV01P1305 21(@)(@@) % فرق الزمان بحالتيه ، فدهره % يومان : يوم ندى ويوم حتوف % 22(@)(@@) % فلذاك آنست الوقوف بربعه ، % نارين نار وغى ونار مضيف % 23(@)(@@) % فهم ، ولكن في مسامع فهمه % % صم عن التقييد والتعنيف % 24(@)(@@) % فند العواذل في السماح يزيده % % جودا ، ويرجفهم برغم أنوف % 25(@)(@@) % فل الجيوش بعزمة ملكية ، % تغنيه عن خطية وسيوف % 26(@)(@@) % فصل القضا متتابع لقضائه ، % تلقى إليه أزمة التشريف % 27(@)(@@) % فضل به فضل الأنام ، وهمة % ركب العلو بها بغير رديف % 28(@)(@@) % فهنا بنظم حديثه مع أننا ، % ما إن نروم به سوى التشريف % 29(@)(@@) % فزنا به الفوز العظيم من الردى ، % وأمنا في مغناه كل مخوف % PageV01P1306 البحر : طويل 1(@)(@@) % قفي ودعينا قبل وشك التفرق ، % فما أنا من يحيا إلى حين نلتقي % % 2(@)(@@) % قضيت وما أودى الحمام بمهجتي ، % وشبت وما حل البياض بمفرقي % % 3(@)(@@) % قضيت لنا في الذل في مذهب الهوى ، % ولم تفرقي بين المنعم والشقي % % 4(@)(@@) % قرنت الرضى بالسخط والقرب بالنهوى ، % ومزقت شمل الوصل كل ممزق % 5(@)(@@) % قبلت وصايا الهجر من غير ناصح ، % وأحييت قول الهجر من غير مشفق % 6(@)(@@) % قطعت زماني بالصدود وزرتني % % عشية زمت للترحل أينقي % % 7(@)(@@) % قضى الدهر بالتفريق فاصطبري له % ولا تذممي أفعاله ، وترفقي % % 8(@)(@@) % قبيح بنا ذم الزمان ، وإن جنى ، % إذا كان فيه مثل غازي بن أرتق % 9(@)(@@) % قوام لدين الله قد حفظ الورى % % بعين متى تنظر إلى الدهر يطرق % 10(@)(@@) % قريب إذا نودي ، بعيد إذا انتمى ، % عبوس إذا لاقى ، ضحوك إذا لقي % % PageV01P1307 11(@)(@@) % قسا قلبه جودا على المال فاغتدى % % يجور على أمواله جور محنق % 12(@)(@@) % قلائد أعناق الرجال هباته ، % ترى الناس منها كالحمام المطوق % 13(@)(@@) % قضى بتلاف المال في مذهب العطا ، % فجاد إلى أن قال سائله : ارفق % 14(@)(@@) % قضت عنه قوم إذ رأت فيض جوده ، % ومن لم يبن عن مهبط السيل يغرق % 15(@)(@@) % قوي السطا لو خاصم الدهر بأسه % غدا خاسرا في درعه المتمزق % 16(@)(@@) % قصير الخطى نحو المعاصي ، وإنها % % طوال ، إذا ما جال في صدر فيلق % 17(@)(@@) % قدير على جيش اللهى غير قادر 
ms299	 ، % تقي لأهوال الوعى غير متق % 18(@)(@@) % قنى الحمد ثوبا للفخار ، وإنه % على حدة الأيام لم يتخرق % 19(@)(@@) % قد العزم ، وابق يا أبا الفتح سالما ، % فقد خفض الدهر الجناح لترتقي % % 20(@)(@@) % قد استبشرت منك الليالي ، وإنما % % بشاشتها في غيركم للتملق % PageV01P1308 21(@)(@@) % قريب من الداعي ، فمن يبغ نصرة % يجدك ، ومن يطلبك في الضيق يلحق % 22(@)(@@) % قسمت على الوراد رزقا قسمته ، % وقلت لها : مما رزقناك أنفقي % % 23(@)(@@) % قصدناك ، يا نجم الملوك ، لأننا % % رأينا الورى من بحر جودك تستقي % % 24(@)(@@) % قطعنا إليك البيد نهدي مدائحا ، % جواهرها من بحرك المتدفق % 25(@)(@@) % قصائد في أبياتهن مقاصد % تردد في أحداقها سحر منطق % 26(@)(@@) % قواف ، إذا ما حزن في سمع ناقد % فعلن به فعل السلاف المعتق % 27(@)(@@) % قدمت بمدحي زائرا ، فلقيتني % % بحسن قبول للرجاء محقق % 28(@)(@@) % قليل إلى أرض العراق تطلعي ، % وجودك قيد بالمكارم موثقي % % 29(@)(@@) % قصرت بمغناك الحوادث إذ رأت % بحبلك من دون الأنام تعلقي % % PageV01P1309 البحر : بسيط تام 1(@)(@@) % كفي القتال ، وفكي قيد أسراك ، % يكفيك ما فعلت بالناس عيناك % 2(@)(@@) % كلت لحاظك مما قد فتكت بنا ، % فمن ترى في دم العشاق أفتاك % 3(@)(@@) % كفاك ما أنت بالعشاق فاعلة ، % لو أنصف الدهر في العشاق عزاك % 4(@)(@@) % كملت أوصاف حسن غير ناقصة ، % لو أن حسنك مقرون بحسناك % 5(@)(@@) % كيف انثنيت إلى الأعداء كاشفة % غوامض السر لما استنطقوا فاك % 6(@)(@@) % كتمت سرك حتى قال فيك فمي % % شعرا ، ولم يدر أن القلب يهواك % 7(@)(@@) % كدت المحب فما أنت بطالبة % فنا محبك مع إشمات أعداك % 8(@)(@@) % كافيتني بذنوب لست أعرفها ، % فسامحي وأذكري من ليس يسلاك % 9(@)(@@) % كلفتني حمل أثقال عجزت بها ، % وحبذا ثقلها إن كان أرضاك % 10(@)(@@) % كابدت هول السرى في البيد مكتسبا % مالا ، وما كنت أبغي المال لولاك % PageV01P1310 11(@)(@@) % كلا ، ولا بت أطوي كل مقفرة ، % ومهمه لم تسر فيه مطاياك % 12(@)(@@) % كأن فيه السما والأرض واحدة ، % ونوقنا نجب نور تحت أملاك % 13(@)(@@) % كبت من الأين فيه ناقتي ، فغدت % تشكو إلي بطرف شاخص باك % 14(@)(@@) % كوماء تسحب من سقم مناسمها % % كأن أرجلها 
ms300	 شدت بأشراك % 15(@)(@@) % كفت عن السير للمرعى محاولة ، % فقلت : سيري إلى مرعى الندى الزاكي % % 16(@)(@@) % كرت ، وقالت : إلى من ذا ؟ فقلت لها : % إلى أبي الفتح مولانا ومولاك % 17(@)(@@) % كهف الضيوف ووهاب الألوف وجد % اع الأنوف ، وأمن الخائف الشاكي % % 18(@)(@@) % كريم أصل يعيد الروح منظره ، % فلو قضيت ، بإذن الله ، أحياك % 19(@)(@@) % كساك من سندس الإنعام أردية ، % حتى كان جنان الخلد مأواك % 20(@)(@@) % كلي هنيئا ، ونامي غير جازعة ، % في مربع فيه مرعانا ومرعاك % PageV01P1311 21(@)(@@) % كان الرجاء بلقياه يعللني ، % وحادثات الليالي دون إدراكي % % 22(@)(@@) % كذا طلاب العلى ، يا نفس ، ممتنع ، % فإن صبرت له نالته كفاك % 23(@)(@@) % كواكب القطر إلا أن راحته % إن أمسك القطر لا تعبا بإمساك % 24(@)(@@) % كف حكى وابل الأنواء وابلها ، % حتى غدا يحسد المحكي للحاكي % % 25(@)(@@) % كم أبكت البيض في كفيه إذ ضحكت % عينا ، وأضحك سنا ماله الباكي % % 26(@)(@@) % كل الأنام ، لما أولاه ، شاكرة ، % فما له غير بيت المال من شاك % 27(@)(@@) % كن كيف شئت بأمن الله يا ملكا ، % أضحت عزائمه أقطاب أفلاك % 28(@)(@@) % كفيتنا منك منا لو وصفت به % لظن ذلك منا نوع إشراك % % 29(@)(@@) % كذاك لا زلت تكفي كل ذي جسد % فتك الخطوب بعزم منك فتاك % PageV01P1312 البحر : بسيط تام 1(@)(@@) % لم أدر أن نبال الغنج والكحل ، % تحت السوابغ تصمي مهجة البطل % 2(@)(@@) % لعل طرفك من أسمائه ثعل ، % كذلك الرمي منسوب إلى ثعل % 3(@)(@@) % لواحظ حاذرت ألحاظنا ، فغدت % بصارم الغنج تحمي وردة الخجل % 4(@)(@@) % لقد تعدت علينا غير راحمة ، % فظلل الحسن ظلا غير منتقل % 5(@)(@@) % لله ليلتنا بالمجمعين ، وقد % % حالت ، وتذكارها في القلب لم يحل % 6(@)(@@) % ليل تنعمت في وصل الفتاة به ، % حتى توهمت أن البدر من قبلي % % 7(@)(@@) % لمياء جادت لنا بالوصل ، إذ علمت % أن الترحل قد زمت به إبلي % % 8(@)(@@) % زلت إلى صدرها صدري مودعة ، % وزودتني من الإرشاف والقبل % 9(@)(@@) % لما أحست بوشك البين فانسفحت % دموع منتحب في إثر مرتحل % 10(@)(@@) % لاحت صروف النوى حزنا وقد نثرت % عقيق أدمعها من نرجس المقل % PageV01P1313 11(@)(@@) % لجت ، فقلت لها كيما 