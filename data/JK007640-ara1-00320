ms301	 أيامنا على القرب منهم % % صدعت بالفراق بعد التئام % % 27(@)(@@) % ذمة قد وفيت فيها لديهم % % وعلى الحر أن يفي بالذمام % % 28(@)(@@) % لو تراني من بعدهم وادكاري % % ماضيات العصور والعوام % % 29(@)(@@) % أتلهى تعللا بالأماني % % بنثار أقول أو بنظام % % 30(@)(@@) % فإذا قلت في الكرام قصيدا % ذقت فيها حلاوة الإنسجام % % 31(@)(@@) % زان شعري وزان نظمي ونثري % % صدق مدحي للسادة الأعلام % % PageV01P941 32(@)(@@) % وإذا رمت في الرجال كريما % % 33(@)(@@) % إنما أعرف المكارم منه % % من كريم الأخلاق نجل الكرام % % 34(@)(@@) % قسم الفضل في الرجال فأضحى % % حظه منه وافر الأقسام % % 35(@)(@@) % لو تغنى الحمام بالمداح فيه % % أرقص البان في غناء الحمام % % 36(@)(@@) % طاهر لا يشوبه دنس الآث % % أم فما لاث قط بالآثام % % 37(@)(@@) % لو تأملت في علوم حراها % % قلت هاتيك منحة الإلهام % % 38(@)(@@) % أوتي الفضل والكمال غلاما % يا له الله سيدا من غلام % % 40(@)(@@) % ثابت الجأش لا يراع لأمر % ثابت عند زلة الأ دام % % 41(@)(@@) % إن فيه والحمد لله ما يرفع % % قدر العلوم بين النام % % 42(@)(@@) % فطنة تدرك الغوامض علما % حجبت عن مدارك الأفهام % % PageV01P942 43(@)(@@) % أدب رائع وعلم غزير % أين منه الأزهار في الأكمام % % 44(@)(@@) % فإذا ما سمعت منه كلاما % كان ذاك الكلام حر الكلام % % 45(@)(@@) % يا شفاء الصدور من علل % الجهل ويا برءها من الآلام % % 46(@)(@@) % يا رفيع العماد يا بن علي % ياابن عالي الذرا علي المقام % % 47(@)(@@) % أنت غيث على العفاة هطول % % أنت بحر من المكارم طامي % % 48(@)(@@) % آل بيت النبي لا زال فيكم % % ثقتي في ولائكم واعتصامي % % 49(@)(@@) % قد سرت منكم بنا نفخات % سريان الأرواح في الأجسام % % 50(@)(@@) % قد أعدوا لكل أمر عظيم % % و ستعدوا للنقض والإبرام % % 51(@)(@@) % دام مجد لهم وللناس مجد % % ما سواهم وما له من دوام % % 52(@)(@@) % شيدوها مبانيا للمعالي % % ما بناها مشيد الأهرام % % PageV01P943 53(@)(@@) % طهر الله ذاتكم واصطفاكم % % حجة للإسلام في الإسلام % % 54(@)(@@) % علقت فيكم المطالب منا % % منذ كنتم وما علقتم بذام % % 55(@)(@@) % كل فرد منكم إمام لعصر % % 56(@)(@@) % أرضعته أم العلى بلبان % % قد عهدناه قبل عهد الفطام % % 57(@)(@@) % فلئن سار 
ms302	 فيكم ذكر شعري % % اخذا بالإنسجام والإتهام % % 58(@)(@@) % فبكم عصمتي وفيكم فخاري % % وبلوغ المنى ونيل الحطام % % 59(@)(@@) % إن كتمت الثناء حينا عليكم % % ضاق صدري به عن الاكتتام % % 60(@)(@@) % فابق في نعمة علينا من الله % % مفيضا سوابغ الإنعام % % 61(@)(@@) % واهنا يا سيدي بعيد سعيد % % عائد بالسرور في كل عام % % 62(@)(@@) % أترجى الفتوح في المدح فيكم % % بأفتتاحي بمدحكم واختتامي % % PageV01P944 البحر : رمل تام 1(@)(@@) % لمن الركب حنيفا وذميلا % % يقطع البيد حزونا وسهولا % % 2(@)(@@) % يتساقون أفاويق الكرى % % ويعانون السرى ميلا فميلا % % 3(@)(@@) % فوق أنضاء فرت أخفافها % % شقق البيد صعودا ونزولا % % 4(@)(@@) % كلما مرت برسم دارس % هملت أدمع عينيها همولا % % 5(@)(@@) % وإذا ما نتشقتها شمالا % % فكما قد شربت راحا شمولا % % 6(@)(@@) % أتراها ذكرت في ذي الغضا % % زمنا مر بمن تهوى عجولا % % 7(@)(@@) % بدلت بالوصول هجرا وبما % % نعمت بؤسا وبالري غليلا % % 8(@)(@@) % قصرت أيامنا في رامة % % ورباها فذكرناها طويلا % % 9(@)(@@) % قد رعيناها رياضا أزهرت % وبكيناها رسومأ وطلولا % % 10(@)(@@) % أين يا سعد ديار درست % وأحباء بها كانوا نزولا % % PageV01P945 11(@)(@@) % بدور أشرفت أرجاؤها % % لقيت بعد تلاقينا أفولا % % 12(@)(@@) % أرسل الطرف فما لي لا أرى % % ناظرا أحوى ولا خدا أسيلا % % 13(@)(@@) % قد ذكرنا عهدكم من بعدكم % % فتحرقنا بكاء وعويلا % % 14(@)(@@) % شد ما لاقيت من هجرانكم % % يوم أزمعتم عن الحي رحيلا % % 15(@)(@@) % واعتقلتم من قدود سمرا % واتخذتم حدق الغيد نصولا % % 16(@)(@@) % أي ذكرى قد ذكرناكم بها % % وكذا فليذكر الخل الخليلا % % 17(@)(@@) % تورث القلب التهابا والحشا % % حرقا والدمع مجرى ومسيلا % % 18(@)(@@) % فسقى أطلالكم من عبرة % لم نكن نبعثها إلا سيولا % % 19(@)(@@) % مغرم في قبضة الوجد شج % لا يرى يوما إلى الصبر سبيلا % % 20(@)(@@) % وثنته عن ملام فيكم % % طاعة الحب التي تعصي العذولا % % PageV01P946 21(@)(@@) % قد تركتم في عذاب جسدا % فأخذتم قلبه أخذا وبيلا % % 22(@)(@@) % عللونا بنسيم منكم % % عل يشفينا وإن كان عليلا % % 23(@)(@@) % وانصفونا من خيال طارق % زارنا ليلا فما أغنى فتيلا % % 24(@)(@@) % فأعيدوه لنا ثانية % وليكن منكم وما كان رسولا % % 25(@)(@@) % إي ودين الحب لولا سربكم % % ما استباحت أعين الغيد قتيلا % % 26 
ms303	(@)(@@) % ما أخو الحزم سوى من يتقي % % الشاذن الألعس والطرف الكحيلا % % 27(@)(@@) % ذل عبد الحب من مستعبد % كم عزيز ترك الحب ذليلا % % 28(@)(@@) % لا رعى الله زمانا أملي % % فيه يحكيني سقاما ونحولا % % 29(@)(@@) % إن يسؤني الدهر في أحداثه % % سرني عبدالغني الدهر طولا % % 30(@)(@@) % عارض ممطرنا من سيبه % % كل يوم وابل المزن هطولا % % PageV01P947 31(@)(@@) % فتأمل في البرايا هل تجد % من يضاهيه جمالا وجميلا % % 32(@)(@@) % عارف بالفضل معط حقه % % بين قوم تحسب الفضل فضولا % % 33(@)(@@) % طالما استسقيته من ظمأ % فسقاني من نداه سلسبيلا % % 34(@)(@@) % أليس الدهر بأفعال له % % غررا أشرق فيها وحجولا % % 35(@)(@@) % خير ما يطرب فيه موقف % % يملأ الأرض صهيلا وصليلا % % 36(@)(@@) % يوم لا تشرق إلا بدم % مرهفات تتشكاه فلولا % % 37(@)(@@) % وبحر الطعن أطراف القنا % % والمواضي البيض كادت أن تسيلا % % 38(@)(@@) % يا إماما في العلى فليقتد % بعد ذاك الجبل في الآتين جيلا % % 39(@)(@@) % لا مثيل لك في الناس وإن % كنت للبدر نظيرا ومثيلا % % 40(@)(@@) % ما سواك اليوم في ساداتها % % من يجير الجار أو يحمي النزيلا % % PageV01P948 41(@)(@@) % ولئن كان قؤول فيهم % لم تكن بينهم إلا فعولا % % 42(@)(@@) % وإذا ما زكيت أنسابها % % كنت أزكاها فروعا وأصولا % % 43(@)(@@) % لم تكن بالغة منك على % طاولت أعلى الجبال الشم طولا % % 44(@)(@@) % ولقد أنزلت أعلى منزل % في مقام يرجع الطرف كليلا % % 45(@)(@@) % وأبى مجدك إلا أن ترى % % أيها القرم مغيثا ومنيلا % % 46(@)(@@) % أفأنت الغيث ينهل فما % % تركت أنواؤه روضا محيلا % % 47(@)(@@) % إن للإحسان والحسنى معا % فيك يا مولاي حالا لن تحولا % % 48(@)(@@) % ينقضي جيل ويستودعها % % بعد ذاك الجبل في الآتين جبلا % % 49(@)(@@) % أي نعمائك أقضي حقها % % فلقد حملتني حملا ثقيلا % % 50(@)(@@) % نبهت حظي من رقدته % بعد أن أرقدة الدهر خمولا % % PageV01P949 51(@)(@@) % كل يوم بالغ منك منى % وعطاء من عطاياك جزيلا % % 52(@)(@@) % وإذا ما هجرت هاجرة % % كنت ظلا يتقى فيه ظليلا % % 53(@)(@@) % ولقد ملت يدي من أخذها % % منك ما تولى وماكنت ملولا % % 54(@)(@@) % فكأني روضة باكرها % % صيب أو صادفت منك قبولا % % 55(@)(@@) % وحري بعدها أن أنثني % % ساحبا فيك من 
ms304	 الفخر ذيولا % % 56(@)(@@) % فابق للأعياد عيدا والندى % % منهلا عذبا وللوفد مقيلا % % PageV01P950 البحر : مجزوء الكامل 1(@)(@@) % يا أيها القمر المني % % ر وأيها الغصن الرطيب % 2(@)(@@) % إني لأعجب من هواك % % وإنه أمر عجيب % % 3(@)(@@) % تدمى بعبرتها العيون % % به وتحترق القلوب % % 4(@)(@@) % ما لي دعوتك أن تصيخ % فلا تصيخ ولا تجيب % % 5(@)(@@) % إن كان ذنبي أنني % % أهوى هواك فلا أتوب % % 6(@)(@@) % يا بدر ما نال الأفول % مناه منك ولا الغروب % % 7(@)(@@) % زرني إذا غفل الرقيب % % وربما غفل الرقيب % 8(@)(@@) % و عطف على مضنى يراع % إذا جفوت ويستريب % % 9(@)(@@) % صب بمهجته أصيب % فدمعه أبدا صبيب % % 10(@)(@@) % هل تدري ما تحت الضلوع % % فإنها كبد تذوب % % PageV01P951 11(@)(@@) % ويلاه كيف أصابني % % من ليس لي منه نصيب % % 12(@)(@@) % عجز الطبيب وأي داء % في الفؤاد له وجيب % % 13(@)(@@) % كيف الدواء من الهوى % % في الحب إن عجز الطبيب % % 14(@)(@@) % من كان علته الحبيب % فما له إلا الحبيب % % PageV01P952 البحر : طويل 1(@)(@@) % أقول لعبد المحسن اليوم منشدا % % له ما أراه في الحقيقة مرشدا % % 2(@)(@@) % سعيت فلم تحصل على طائل به % % تسر صديقا أو تسيء به العدى % % 3(@)(@@) % وقال لك التوفيق لو كنت سامعا % وراءك ما تبغي من الفضل والندى % % 4(@)(@@) % وقد خاب ساع أبصر البحر خلفه % % إلى جرعة يروي بنهلتها الصدى % % 5(@)(@@) % وأنفقت مالا لو قنعت ببعضه % % إذن لكفاك العمر مرعى وموردا % % 6(@)(@@) % فما نلت ماحاولت إذ ذاك مغورا % ولا حزت ما املت إذ ذاك منجدا % % 7(@)(@@) % وكم أمل يشقى به من يرومه % % وأمنية يلقى الفتى دونها الردى % % 8(@)(@@) % فأهلا وسهلا بعد غيبتك التي % % قضيت بها الأيام لكنها سدى % % 9(@)(@@) % ولذ بالأشم القيل إما مقيله % % فظل وأما ما حواه فللندى % % 10(@)(@@) % بعذب الندى مر العداوة قادر % % عفو عن الجاني وإن جار و عتدى % % PageV01P953 11(@)(@@) % أخ طالما تفدى بأنفس ماله % % وأقسم لو أنصفت كنت له الفدا % % 12(@)(@@) % ولو كنت ممن شد عضدا بأزره % % بلغت لعمر الله عزا وسؤددا % 13(@)(@@) % ولو كنت ذا باع طويل جعلته % % بيمناك سيفا لا يزال مجردا % % 14(@)(@@) % وإنك ما 
ms305	 تختار غير رضائه % % كمن راح يختار الضلال على الهدى % % 15(@)(@@) % على أنه إن لم لك مسعدا % % فهيهات أن تلقى من الناس مسعدا % % 16(@)(@@) % يقيك اتقاء السابغات سهامها % % متى ترمك الأرزاء سهما مسددا % % 17(@)(@@) % وإنك إن تول القطيعة مثله % % قطعت لعمري من يديك بها يدا % % 18(@)(@@) % ولا تسلم الأطماع من بعد هذه % % إلى مستحيلات الأماني مقودا % % 19(@)(@@) % ومن سفه بغي مرىء وارتكابه % % من البغي ما إن أصلح الدهر أفسدا % % 20(@)(@@) % وعش مثل ماتهوى بظل جنابه % % ترى العيش أهنا ما رأيت وأرغدا % % PageV01P954 البحر : مجزوء الرمل 1(@)(@@) % أيها السيد صبرا % في المصيبات الملمة % % 2(@)(@@) % قد مضت زوجك للأخرى % % وأمضى الله حكمه % % 3(@)(@@) % وكذاك الناس تمضي % % أمة من بعد أمه % % 4(@)(@@) % أي شخص لم ترعه % % الحادثات المدلهمه % % 5(@)(@@) % وزعيم القوم ما ري % % ع وغالى الموت حمه % % 6(@)(@@) % كم أصاب الحتف منا % % كلما سدد سهمه % % 7(@)(@@) % رحمة الله عليها % % رحمة تنزل جمة % % 8(@)(@@) % جاورت ربا كريما % لنعيم ولنعمه % % 9(@)(@@) % قل لها و دع وأرخ % أنت في الجنات رحمه % % PageV01P955 البحر : خفيف تام 1(@)(@@) % لا تلم مغرما رآك فهاما % % كل صب تركته مستهاما % % 2(@)(@@) % لو رآك العذول يوما بعيني % % ترك العذل في الهوى والملاما % % 3(@)(@@) % يا غلاما نهاية الحسن فيه % % ما رأت مثله العيون غلاما % % 4(@)(@@) % تارك في الأحشاء نارا وفي الأجفان % % دمعا وفي القلوب غراما % % 5(@)(@@) % أتراني أبل فيك غليلا % أم تراني أنال منك مراما % % 6(@)(@@) % كلما قلت أنت برؤ لقلبي % % بعثت لي منك العيون سقاما % % 7(@)(@@) % وبوحي من سحر عينيك يوحي % % لفؤادي صبابة وغراما % % 8(@)(@@) % عمرك الله هذه كبدي الحرى % % تشكت إلى لماك الأواما % % 9(@)(@@) % فاسقني من رحيق ريقك صرفا % لا يريني كأس المدام مداما % % 10(@)(@@) % حام خال على زلال برود % هو في فيك ف صطلاها ضراما % % PageV01P956 11(@)(@@) % أطمعته في فيك أطماعنا فيك % % فما نال بردها والسلاما % % 12(@)(@@) % أولم تخش يا مليح من الله % % بقتلي من غير ذنب أثاما % % 13(@)(@@) % فالأمان من سحر عينيك % % فقد جردت علينا حساما % % 14(@)(@@) % لست أدري وقد تثنيت تيها % أقضيبا 
ms306	 هززته أم قواما % % 15(@)(@@) % ما هصرنا إلا قوامك غصنا % ونظرنا إلاك بدرا تماما % % 16(@)(@@) % لم تدم لذة لعيني بمرآك % % فما للهوى بصبك داما % % 17(@)(@@) % فإذا مر بي ادكارك يوما % قعد الوجد بالفؤاد وقاما % % 18(@)(@@) % فأجرني من مثل هجرك إني % % لا أرى العيش جفوة وانصرما % % 19(@)(@@) % بل أعد اليوم الذي أنت تجفو % % فيه دهرا ويوم هجرك عالما % % 20(@)(@@) % أين منك الآرام في مسرح السرب % % إذا قلت تشبه الآراما % % PageV01P957 21(@)(@@) % يا غزالا يرعى سويدا فؤادي % % لا الخزامى بحاجر والثماما % % 22(@)(@@) % صرعت مقلتاك بالسحر أقوا % % ما وداوت من دائها أقواما % % 23(@)(@@) % كم سهرت الدجى بأعين صب % أمطرت مزنها فكان ركاما % % 24(@)(@@) % والتمست الكرى لطرفي بطرفي % % فرأيت الكرى علي حراما % % 25(@)(@@) % يا خليلي خلياني من اللوم % % فإني لا أسمع اللواما % % 26(@)(@@) % واتحفاني بطبيب أخبار نجد % وصفا لي ربوعها والخياما % % 27(@)(@@) % واذكرا لي من اعلراق شهاب % % الدين نثرا في مدحه ونظاما % % 28(@)(@@) % فبذكر الكرام تنتعش الرو % % ح انتعاشا فتطرب الأجساما % % 29(@)(@@) % ساد سادات عصره ولأمر % فاخر التبر والنضار الرغاما % % 30(@)(@@) % لم يزل للعلاء والمجد أقسا % % ما وللعلم والنهى أقساما % % PageV01P958 31(@)(@@) % فعلا في سماء كل فخار % فتعالى علاؤه وتسامى % % 32(@)(@@) % خارق فكره من العلم ما لم % % يقبل الخرق قبل والالتئاما % % 33(@)(@@) % فأرى الناس ما سواه وهادا % مذ أرينا علومه الأعلاما % % 34(@)(@@) % يا إماما للمسلمين هماما % بأبي ذلك الإمام الهماما % % 35(@)(@@) % إنما أنت رحمة رحم الله % % بها المسلمين والإسلاما % % 36(@)(@@) % يكشف الله فيك عن مشكلات % % العلم سرا ويرفع الإيهاما % % 37(@)(@@) % بكلام يشفي الصدور من الجهل % % شفاء ويبرىء الأسقاما % % 38(@)(@@) % فكأن العلوم توحى إلى قلبك % % في السر يقظة ومناما % % 40(@)(@@) % جل مجد حويته أن يضاهى % % وكمال رزقته أن يراما % % 41(@)(@@) % قصرت دون ما بلغت الأعالي % % علوما ألهمتها إلهاما % % PageV01P959 42(@)(@@) % لم ينالوا أخفافها وتسنمت % برغم الأنوف منها السناما % % 43(@)(@@) % قد رأيناك يوم جد وهزل % قد بهرت الأفكار والأفهاما % % 44(@)(@@) % فاقتطفنا من الرياض وردا % وسمعنا من الداري كلاما % % 45(@)(@@) % وانتشقنا نشيم رقة لفظ % % كنسيم الصبا ونشر الخزامى % % 46(@)(@@) % حجج منك 
ms307	 توضح الحق حتى % % أفحمت كل ملحد إفحاما % % 47(@)(@@) % نبهت بعد رقة الجهل قوما % لم يكونوا من قبل إلا نياما % % 48(@)(@@) % محقت ظلمة الضلالة والغي % كما بمحق الضياء الظلاما % % 49(@)(@@) % يمنه البيض خط أقلامك السمر % % بلاغا أن تسبق الأقلاما % % 50(@)(@@) % أنت مقدامها إذا أصبح % % دام فيها لا يحسن الإقداما % % 51(@)(@@) % أنت أعلى من أن يقال كريم % فالأمان الأمان من سحر عينيك % % PageV01P960 52(@)(@@) % تغمر الناس بالجميل وصوب % المزن يسقي البطاح والآكاما % % 53(@)(@@) % فإذا عدت الأماجد يوما % كنت بدءا لها وكنت الختاما % % PageV01P961 البحر : كامل تام 1(@)(@@) % هذا محل العلم والإفتاء % تأوي إليه أكابر العلماء % % 2(@)(@@) % دار حوت من كل شهم حائز % بأس الحديد ورقة الصهباء % % 3(@)(@@) % فيها العوارف والمعارف والتقى % % وفكاهة الظرفاء والأدباء % % 4(@)(@@) % أين النجوم الزهر من ألفاظهم % % ووجوههم كالروضة الغناء % % 5(@)(@@) % لله دار ما خلت من فاضل % أبدا ولا من سادة نجباء % % 6(@)(@@) % ولقد يحل أبو الثناء بصدرها % % يحكي حلول الشمس في الجوزاء % % 7(@)(@@) % مفتي العراقين الذي بعلومه % % يرقى لأعلى رتبة قعساء % % 8(@)(@@) % لو أسمع الحجر الأصم بوعظه % % لتفجرت صماؤه بالماء % % 9(@)(@@) % للعلم والآداب شيد داره % % ولكل ذي فضل من الفضلاء % % 10(@)(@@) % تسري بمرآها الهموم فأرخوا % % دار تسر بها عيون الرائي % % PageV01P962 البحر : وافر تام 1(@)(@@) % يشق علي أن تشقى بحبس % وأن تبقى لرش أو لكنس % 2(@)(@@) % تكبل بالحديد وكنت أخشى % % محاذرة عليك من الدمقس % % 3(@)(@@) % وعز علي أن تبقى بدار % % وما يلفى بها غير الأخس % 4(@)(@@) % أتخدم كل مبتذل حقير % % إذا ما بيع لا يشرى بفلس % % 5(@)(@@) % وكنت أغار إن رمقتك عين % تلوث عرض صاحبها برجس % % 6(@)(@@) % تطوف بك الوجوه الغبر منهم % % كما طافت شياطين بإنسي % % 7(@)(@@) % ولو مكنت مما أشتهيه % % خدمتك دون أصحابي بنفسي % % 8(@)(@@) % تقول سلوتني ونقضت عهدي % % وخنت مودتي ونسيت أنسي % % 9(@)(@@) % معاذ الله أن أسلوك يوما % ويومي في غرامك فوق أمس % % 10(@)(@@) % تحدث عن هواك دموع عيني % % بألسنة من العبرات خرس % % PageV01P963 11(@)(@@) % يجول عليك طول الليل فكري % % وأصبح فيك محزونا وأمسي % % 12(@)(@@) % وأذكر ما مضى من طيب 
ms308	 عيش % % فآكل راحتي وأعض خمسي % % 13(@)(@@) % فمن غزل يروق لديك مني % % ومن نغم يلذ وشرب كأس % % 14(@)(@@) % فآها ثم آها ثم آها % على قمر يدير شعاع شمس % % 15(@)(@@) % فما أغلى ليالينا وأحلى % % لقد بيعت لشقوتنا ببخس % % 16(@)(@@) % ليلي كانت اللذات فيها % % وأيام لنا أيام عرس % % 17(@)(@@) % مضت تلك السنون وفرقتنا % % حوادث من خطوب الدهر بؤس % % 18(@)(@@) % رماها من قضاء الله رام % فأنفذ سهمه من غير قوس % % 19(@)(@@) % ومن لي أن أزورك كل يوم % % وأن أسعى على عيني ورأسي % % 20(@)(@@) % عسى لطف من الرحمن يأتي % % ويسعدني بسعد بعد نحس % % PageV01P964 21(@)(@@) % كما سعد العراق به ولاذت % % برأفته أفاضل كل جنس % % 22(@)(@@) % أرى ما يطمع الراجين فيه % % فأطمع في نجاتك بعد يأس % % 23(@)(@@) % سأفرغ للثناء عليه فكري % % وإملاء القريض عليك طرسي % % 24(@)(@@) % ومنه إليك قد حان التفات % فأبشر في إزالة كل نكس % % 25(@)(@@) % فبادر بالدعاء له وأخلص % % وأنذر نتف لحية كل وكس % % PageV01P965 البحر : وافر تام 1(@)(@@) % لقد عجب الحسان الغيد لما % % رأت عنها سلوي و صطباري % % 2(@)(@@) % وأني لا أميل إلى نديم % % يرويني بكاسات العقار % % 3(@)(@@) % وإني قد مددت اليوم باعا % أنال بها الذي فوق الدراري % % 4(@)(@@) % فلا يوم صبوت إلى الغواني % % ولا يوم خلعت به عذاري % % 5(@)(@@) % ثكلتك ليس لي في اللهو عذر % % وقد لاح المشيب على عذاري % % 6(@)(@@) % ولست براكب من بعد هذا % % جوادا غير مأمون العثار % % 7(@)(@@) % فنم يا عاذلي بالأمن مني % % فلم تر بعد عذلك واعتذاري % % 8(@)(@@) % وقل للغيد شأنك والتجافي % % وللغزلان أخذك بالنفار % % 9(@)(@@) % صبوت إلى الدمى زمنا طويلا % وقد أعرضت عنها ب ختياري % % 10(@)(@@) % وكانت صبوتي قد خامرتني % % وها أنا قد صحوت من الخمار % % PageV01P966 11(@)(@@) % وقد هدرت زمانا فاستقرت % % وكانت لا تصيخ إلى قرار % % 12(@)(@@) % لئن ضيعت أيام التصابي % % فإني قد حظيت على الوقار % % 13(@)(@@) % وكيف يجد في طلب الغواني % % فتى قد جد في طلب الفخار % % PageV01P967 البحر : - 1(@)(@@) % قل مثلما قد قال عبد الباقي % % في نعمت عترة صفوة الخلاق % % 2(@)(@@) % أو فاسترح وأرح لسانك واتخذ % % للنطق من 
ms309	 صمت أجل نطاق % % 3(@)(@@) % إن اللسان لمضغة ما لم تفه % % بالطيبات تلاك بالأشداق % % 4(@)(@@) % أو ما تراه قد أتى بأوابد % تفنى بنو الدنيا وهن بواقي % % 5(@)(@@) % لله درك حكمة الإشراق % % 6(@)(@@) % تشجي وتطرب أنفسا وجواراحا % فكأنهن صوارم الأحداق % % 7(@)(@@) % ولقد أدار على العقول سلافة % ما لا تدور بها أكف الساقي % % 8(@)(@@) % عن بهجة المعشوق يسفر حسنها % % ولواعج المشتاق في العشاق % % 9(@)(@@) % قد عانقت أشراف آل محمد % % فكأنها الأطواق في العناق % % 10(@)(@@) % فكأنها هبت صبا في روضة % % فتأرجت بنسيمها الخفاق % % PageV01P968 11(@)(@@) % رقت فكادت أن تسيل بلطفها % % حتى من الأقلام والأوراق % % 12(@)(@@) % وبما غدت تملي ثناء طيبا % عن طيب في الأصل والأعراق % % 13(@)(@@) % لدغت أمية منه أفعى تنفث % السم الزعاف وما لها من راق % 14(@)(@@) % كلم ولا وخزات أطراف القنا % % يلمعن عن صوب الدم المهراق % % 15(@)(@@) % من كل قافية بثاقب فكره % % يفتضهاعذرا بغير صداق % % 16(@)(@@) % طوبى له في النشأتين لقد حوى % % نعم الذخيرة والثناء الباقي % % 17(@)(@@) % فالله يجزيه بها خير الجزا % % ويقيه شرا ما له من واق % % PageV01P969 البحر : متقارب تام 1(@)(@@) % أما والهوى بالوجوه الملاح % لقد لذ لي في الغرام فتضاحي % % 2(@)(@@) % ومن ثم رحت وقول العذول % % يمر بسمعي مرور الرياح % % 3(@)(@@) % حرام علي بدين الغرام % % ركوني إلى ما تقول اللواحي % % 4(@)(@@) % ويا ربما زادني صبوة % % إذا ما لحاني على الحب لاحي % % 5(@)(@@) % ويوما على غفلات الرقيب % % نحرت به الزق نحر الأضاحي % % 6(@)(@@) % وما العيش إن كان عيشا يسر % سوى كأس راح وخود رداح % % 7(@)(@@) % بروض تصفق أوراقه % % وقبل بالقطر ثغر الأقاح % % 8(@)(@@) % أسرح طرفي بتلك الرياض % % بحيث غتباقي وحيث صطباحي % % 9(@)(@@) % وأسكرني طرف ذاك الغرير % % بغير المدام فهل أنت صاح % % 10(@)(@@) % بروحي ذاك المليح الذي % % يحيي الندامى بروح وراح % % PageV01P970 11(@)(@@) % تراءت بوجه الحيي الحليم % % وتفعل فعل السفيه الوقاح % % 12(@)(@@) % جنحنا إلى حلبات الكميت % % وليس على مطرب من جناح % % 13(@)(@@) % فكدت أطير سرورا به % % ومن ذا يطير بغير الجناح % % 14(@)(@@) % ومستملح نامم سكره % % على أن فيه بقيات صاح % % 15(@)(@@) % فوسدته ساعدي والكرى 
ms310	 % % يخوض بعينيه حتى الصباح % % 16(@)(@@) % فعانقت منه مكان العقود % وألبست منه مكان الوشاح % % 17(@)(@@) % فلله من نشوات الصبا % % ولله من هفوات الملاح % % 18(@)(@@) % ومن رشفات ترشفتها % % تبل غليلي وتأسو جراحي % % 19(@)(@@) % أقول له هل تطيق النهوض % % ولو مد راح إلى أخذ راح % % 20(@)(@@) % فقد نبهتك ديوك الصباح % % وأكثرن من غلبات الصياح % % PageV01P971 21(@)(@@) % فأومى إلي بهات الصبوح % % وصرح في لفظ راح صراح % % 22(@)(@@) % فناولته الكأس مملوءة % وغنيته بالقوافي الصحاح % % 23(@)(@@) % فكان له غزلي كله % % وكان لسلمان جل امتداحي % % PageV01P972 البحر : كامل تام 1(@)(@@) % إن الممالك في صدارة أحمد % % أضحت بطبيب مسرة وهناء % % 2(@)(@@) % ضحكت به دار السعادة بعدما % % أبكت عليه أعين الزوراء % % 3(@)(@@) % للدولة العلياء في سلطانها % % أرخ تصدر مدحت العلياء % % PageV01P973 البحر : طويل 1(@)(@@) % تذكر عهدا بالحمى قد تقدما % % فأجرى عليه الدمع فردا وتوأما % % 2(@)(@@) % ولاسيما إذ شاهد الربع لم يدع % % له أهله إلا تلالا وأرسما % % 3(@)(@@) % وآثار ما أبقى الخليط بعهده % % ونؤيا كمعوج السوار مهدما % % 4(@)(@@) % منازل كانت للبدور منازلا % وإن شئت قل كانت محاريب للدمى % % 5(@)(@@) % لهونا بها والعيش إذ ذاك ناعم % % فلله عيش ما ألذ وأنعما % % 6(@)(@@) % زمان مضى في طاعة الحب وانقضى % % وصلنا به اللذات حتى تصرما % % 7(@)(@@) % خليلي عوجا بي على الدار إنني % % أشد بلاءا بالمنازل منكما % % 8(@)(@@) % خليلي هذا الحب ما تعرفانه % % خليلي لو شاهدتما لعرفتما % % 9(@)(@@) % خليلي رفقا بي فقد ضرني الهوى % % ألم موجع القلب مؤلما % % 10(@)(@@) % ونمت على وجدي دموع أرقتها % % ولم يبق هذا الدمع سرا مكتما % % PageV01P974 11(@)(@@) % فلا تمنعاني وقفة أنا سائل % % بها الدار عن حي نأى أين يمما % % 12(@)(@@) % وقفنا عليها يا هذيم وكلنا % % حريص على الأطلال أن تتكلما % % 13(@)(@@) % نعالج فيها لوعة بحشاشة % على الرسم منا نمزج الدمع بالدما % % 14(@)(@@) % فلم نرتحل يوما لنسقي معاهدا % من الدار في سلع وفي الدار من ظما % % 15(@)(@@) % بعبرة مشتاق إذا لم تجد لها % % من الدمع ما يروي اتلديار بكت دما % % 16(@)(@@) % أحباءنا شطت بهم شطط النوى % % فأتبعتهم مني فؤادا متيما % % 17(@)(@@) % هبوا لعيوني أن 
ms311	 يحل بها الكرى % % وإن كان نوم العاشقين محرما % % 18(@)(@@) % ألا رب طيف زار ممن احبه % % وما زار إلا من سليمى وسلما % % 19(@)(@@) % سرى من زرود منعما بوصاله % % وما كان إلا في الحقيقة منعما % % 20(@)(@@) % فأرقني والليل يسحب ذيله % % وفارق صبا لا يزال متيما % % PageV01P975 21(@)(@@) % وبرق كنار الشوق توقد بالحشا % % تلهب في جنح الدجى وتضرما % % 22(@)(@@) % بليل كحظي منه قطب وجهه % % فما زلت أبكي فيه حتى تبسما % % 23(@)(@@) % أساهر فيه كل نجم يمر بي % % إلى أعين باتت عن الصب نوما % % 24(@)(@@) % سقى الله أياما خلون حواليا % على الجزع بالجرعاء من أيمن الحمى % % 25(@)(@@) % ولا بدع أن يسمو وها قد سما % % رواء إذا ما ساقها الرعد أرزما % % 26(@)(@@) % كراحة عبد القادر القرم لم تزل % % تهامي على العافين فضلا وأنعما % % 27(@)(@@) % يصب الحيا في صوبه مثل سيبه % كأن علم الغيث الندى فتعلما % % 28(@)(@@) % إذا جئته مسترفدا رفد فضله % % غدوت إذن في ماله متحكما % % 29(@)(@@) % وردت نداه ظامئا غير أنني % % وردت إليه البحر والبرح قد طمى % % 30(@)(@@) % ولولا جميل الصنع منه لما رأت % عيوني وجه العيش إلا مذمما % % PageV01P976 31(@)(@@) % من القوم يولون الجميل تفضلا % ولم يحسنوا الإحسان إلا تكرما % % 32(@)(@@) % أطرت لديه طائر اليمن أسعدا % وكنا أطرنا طائر النحس أشأما % % 33(@)(@@) % ودخر الذكر الحميد بفضله % % ولم يدخر يوما من المال درهما % % 34(@)(@@) % رأيت يساري كلما كان موسرا % ولم يرض إعدامي إذا كان معدما % % 35(@)(@@) % فما يجمع الأموال إلا لبذلها % % ولا يطلب النعماء إلا لينعما % % 36(@)(@@) % برغم الأعادي نال همة نائل % % فجدع آناف العداة وأرغما % % 37(@)(@@) % ولو رام أن يرقى إلى النجم لأرتقى % % ويوشك رب الفضل أن يبلغ السما % % 38(@)(@@) % فلا غرو أن يعلو وها هو قد علا % % 39(@)(@@) % عزائمه كالمشرفية والظبا % % وآراؤه ما زلن بالخطب أنجما % % 40(@)(@@) % يصيب بها الأغراض مما يرومه % % ولا يخطىء المرمى البعيد إذا رمى % % PageV01P977 41(@)(@@) % وكم من خميس قد رماه عرمرم % % فقرق بالرأي الخميس العرمرما % % 42(@)(@@) % فلو أبرزت آراؤه غسق الدجى % % لحث الدجى عن أشقر الصبح أدهما % % 43(@)(@@) % وأثقل بالأيدي 
ms312	 لساني وعاتقي % % ألم ترني لا أستطيع التكلما % % 44(@)(@@) % وإني وإن لم أقض للشكر واجبا % بمستغرم أصبحت في المجد مغرما % % 45(@)(@@) % سكت وأنطقت اليراع لشكره % % فأعرب عما في ضميري وترجما % % 46(@)(@@) % جرى وكذا لا زال يجري بمدحه % % فغردفي مدحي له وترنما % % 47(@)(@@) % وأولى الورى بالشكر من كان محسنا % وأولى الورى بالحمد من كان منعما % % 48(@)(@@) % لك الله مطبوع على الجود والندى % % فلو رام إقداما على البخل أحجما % % 49(@)(@@) % شكرتك شكر الروض باكره الحيا % % سحابا عليه آنهل بالجود أو همى % % 50(@)(@@) % لك القلم العالي على البيض والقنا % % جرى فجرى رزق العباد مقسما % % PageV01P978 51(@)(@@) % ففي القلم الحادي وصاحبه النهى % % علوت به حتى ظنناه سلما % % 52(@)(@@) % وسيرت ذكر الحمد في كل منزل % فأنجد في شرق البلاد وأتهما % % 53(@)(@@) % أضاء بك الأيام لي وتبلجت % وأشرق فجر بعدما كان مظلما % % 54(@)(@@) % رفعت مقامي مرغما أنف حاسدي % % فأصبحت إذ ذاك العزيز المكرما % % 55(@)(@@) % صفا لي منك الجود عذب غديره % % فجرعت أعدائي من الغيظ علقما % % 56(@)(@@) % أطلت يدي في كل أمر طلبته % % وغادرت شاني عبد نعماك أجذما % % 57(@)(@@) % وبلغتني أقصى الرجاء فلم أقل % عسى أبلغ القصد القصي وربما % % 58(@)(@@) % وعظمتني في نفس كل معاند % % فلا زلت في نفس المعالي معظما % % PageV01P979 البحر : رجز تام 1(@)(@@) % يا أيها الركب قفوا بي ساعة % % أقض لربع في الحمى ديونا % % 2(@)(@@) % ولم أشم وامض برق لامعا % إلا ذكرت الثغر والجبينا % % 3(@)(@@) % وحين لاح الشيب في مفارقي % % وكان ما لم أرض أن يكونا % % 4(@)(@@) % وما خلفت للغرام طاعة % % وما نكثت حبلها المتينا % % 5(@)(@@) % أئن مما أضمرت أضالعي % % وكنت ممن أعلن الأنينا % % 6(@)(@@) % وما وجدت في الهوى على الهوى % % غير بكائي للأسى معينا % % 7(@)(@@) % يا صاحبي والخليل مسعد % إن لم تعينا كلفا فبينا % % 8(@)(@@) % . . . . . . . . . . . . % ومارس الأيام والسنينا % % 9(@)(@@) % وأرقتني الورق في أفنانها % % تردد التغريد واللحونا % % 10(@)(@@) % كم أججت من الفؤاد لوعة % وأهرقت من عبرة شؤونا % % PageV01P980 11(@)(@@) % كم أرغمت أنف الحسود سطوة % وغمرت بالبر معتفينا % % 12(@)(@@) % يا شد ما كابد من صبابة % في صبوة عذابها المهينا 
ms313	 % % 13(@)(@@) % وفارق الموصل في قدومه % % ليث هزبر فارق العرينا % % 14(@)(@@) % من أشرف الناس وأعلى نسبا % وكان من أندى الورى يمينا % % 15(@)(@@) % وكلما أملت تباريح الجوى % % تفننت بنوحها فنونا % % 16(@)(@@) % عوده على الجميل شيمة % وأورثته شدة ولينا % % 17(@)(@@) % وحل في الزوراء شهم ماجد % نقر في طلعته العيونا % % 18(@)(@@) % أولئك القوم الذين أنجبت % أصلابها الآباء والبنينا % % 19(@)(@@) % وطوقته في العلى أطواقها % % وقلدته درها الثمينا % % 20(@)(@@) % وأظهروا ما أضمروا من كيدهم % % وكان في صدورهم كمينا % % PageV01P981 21(@)(@@) % يحفظك الحافظ من كيد العدى % % وكان حصنا حفظه حصينا % % 22(@)(@@) % وخيب الله به ظنونهم % % وطالما ظنوا به الظنونا % % 23(@)(@@) % وعذت بالرحمن وهي عوذة % أخزت به شيطانها اللعينا % % 24(@)(@@) % لو كان للأيام وجه حسن % كان لها الوجنة والعيونا % % 25(@)(@@) % قد طبعو على الجميل كله % % وإن أساء الدهر محسنينا % % PageV01P982 البحر : طويل 1(@)(@@) % أحبتنا أنتم على السخط والرضا % % وفي القلب منكم لوعة ووجيب % 2(@)(@@) % ذكرناكم والدمع ينهل والحشا % % تذوب وأجفان المشوق تصوب % % 3(@)(@@) % فطار بنا شوق إليكم مبرح % له زفرة توري جوى ولهيب % % 4(@)(@@) % ركبنا إليكم ظهر كل مخوفة % ترامى بنا أهوالها وتجوب % % 5(@)(@@) % وبنظرنا منها وللهول ناظر % % جلوب لآجال الرجال مهيب % % 6(@)(@@) % وخضنا ظلام الليل والليل حالك % % بهيم وفي وجه الخطوب قطوب % % 7(@)(@@) % وجئنا فلم نظفر لديكم بطائل % % ولا نيل حظ منكم ونصيب % % 8(@)(@@) % وفينا على صدق الهوى وغدرتم % وفزتم لدينا بالجوى ونخيب % % 9(@)(@@) % فمنوا علينا بعدها بزيارة % % بها العيش يصفو والحياة تطيب % % 10(@)(@@) % ولا تمنعونا نظرة من جمالكم % % فيرتاح قلب أو يسر كئيب % % PageV01P983 11(@)(@@) % وإلا فرسل لاشوق تبعث كلما % % تهب شمال بيننا وجنوت % % 12(@)(@@) % على مثلنا لو تنصفون بحبكم % % تشق قلوب لا تشق جيوب % % 13(@)(@@) % وتظهر أسرار وتبدو لواعج % % ويشكو محب ما جناه حبيب % % 14(@)(@@) % أحن إليكم والهوى يستفزني % % كما حن نائي الدار وهو غريب % % 15(@)(@@) % وأطرب في ذكراكم ما ذكرتم % % وإني على ذكراكم لطروب % % PageV01P984 البحر : رمل تام 1(@)(@@) % من معيد لي من عهد الألى % % زمنا فيه حلا ثم خلا % % 2(@)(@@) % وليالي بجمع ومنى % % هطل الغيث لها و 
ms314	 نهملا % % 3(@)(@@) % عللاني يا خليلي بما % % مر من أيام جمع عللا % % 4(@)(@@) % وبما كان بأيام الصبا % % أين أيامك يا سعد الألى % % 5(@)(@@) % خففا عن دنف حمل الأسى % % فلقد أثقله ما حملا % % 6(@)(@@) % كان لي صبر فلما رحل % % الركب بالأحباب عني رحلا % % 7(@)(@@) % نزلوا بالشعب واختاروا على % % بعدهم مني فؤادي منزلا % % 8(@)(@@) % وبنفسي من رماني عامدا % ما رمت عيناه إلا قتلا % % 9(@)(@@) % وتظلمت من الحب إلى % % جائر في حكمه ما عدلا % % 10(@)(@@) % رمية منك أصابت مقتلي % % هي من عينيك يا ريم الفلا % % PageV01P985 11(@)(@@) % فاتق الله بأحشاء شج % ما اتقى منك العيون النجلا % % 12(@)(@@) % خضب العينين منه بدم % في خضاب الليل حتى نصلا % % 13(@)(@@) % ساهر لو عرض الغمض على % % جفنه طيب الكرى ما قبلا % % 14(@)(@@) % خلياني بعد سكان الغضا % % أندب الربع وأبكي الطللا % % 15(@)(@@) % يا لها من وقفة في أربع % % أرخصت من أدمعي ما قد غلا % % 16(@)(@@) % حدث الواشين جفني في الهوى % % عن دم الدمع حديثا مرسلا % % 17(@)(@@) % سر وجدان بدا لي صونه % % باحت العين به فابتذلا % % 18(@)(@@) % ولحاني صاحب يحسبني % % أسمع النصح وأرضى العذلا % % 19(@)(@@) % جادل العاذل حتى إنه % % كان لي أكثر شيء جدلا % % 20(@)(@@) % لو رآى الحب عذول لامني % % عرف العاذل ما قد جهلا % % PageV01P986 21(@)(@@) % يا خليلي إذا لم تعلما % % ما أقاسي من غرام فاسألا % % 22(@)(@@) % إنما أحبابنا يوم النوى % % قطعوا في هجرهم ما وصلا % % 23(@)(@@) % نقل الواشي إليهم سلوتي % % كذب الناقل فيما نقلا % % 24(@)(@@) % هل سألتم عن فؤادي إنه % % ما سلاكم في الهوى حتى نسلى % % 25(@)(@@) % لست أنساكم بذكرى غيركم % % كيف أبغي بسواكم بدلا % % 26(@)(@@) % إن علا جد امرئ في جده % % فعلي الجد بالجد علا % % 27(@)(@@) % تسبق الأقوال أفعال له % % وإذا قال بشيء فعلا % % 28(@)(@@) % سيد لو أمر الدهر بما % % شاء من أمر المعالي امتثلا % % 29(@)(@@) % وجد الدهر مزياه حلى % فتحلى منه في تلك الحلى % % 30(@)(@@) % قرأ المجد على أخلاقه % % سورة الحمد قديما وتلا % % PageV01P987 31(@)(@@) % وصعاب المعالي لم تقد % قادها من غير كره ذللا % % 32(@)(@@) % طيب الذات رفيع قدره 
ms315	 % % ما يريك النجم إلا أسفلا % % 33(@)(@@) % سيد أشرف من في هاشم % % شب في حجر العلى واكتهلا % % 34(@)(@@) % من أناس بلغوا غاياتهم % % من نوال ونزال وعلى % % 35(@)(@@) % سادة قد أوضح الله بهم % % لجميع العالمين السبلا % % 36(@)(@@) % أنزل الله على جدهم % سيد الرسل الكتاب المنزلا % % 37(@)(@@) % سادة لولا هداهم بقيت % % هذه الناس جميعا هملا % % 38(@)(@@) % ما رأينا أحدا من قبله % % لاح كالبدر هزيزا رجلا % % 39(@)(@@) % لاح للأبصار يبدو واضحا % وتجلى وبه الكرب انجلى % % 40(@)(@@) % وضح الصبح إذا الصبح أضا % % أو حسام مشرفي صقلا % % PageV01P988 41(@)(@@) % أوبخفى عن عيون أبصرت % بوجود بن ذكاء ابن جلا % % 42(@)(@@) % أنا من آلائه في نعمة % بالغ في كل يوم أملا % % 43(@)(@@) % ونوال من يد مبسوطة % % للعطايا أرسلتها مثلا % % 44(@)(@@) % إنما أيديه أيدي ديمة % روضت روضي إذا ما أمحلا % % 45(@)(@@) % وصلات من نداه اتصلت % والندى أعذبه ما اتصلا % % 46(@)(@@) % منهل مستعذب مورده % % لا عدمنا منه ذاك المنهلا % % 47(@)(@@) % لا أبالي إن يكن لي موردا % مر يا سعد زماني أم حلا % % 48(@)(@@) % فجزاه الله عنا خير ما % % جوزي المنعم فيما نولا % % 49(@)(@@) % إن يرم فيه مقالا شاعر % قال فيه شعره مرتجلا % % 50(@)(@@) % دامت الأيام أعيادا له % % وعليه السند وافى مقبلا % % PageV01P989 البحر : سريع 1(@)(@@) % أقول للشامت لما بدا % % يكثر بالتعنيف والشين % 2(@)(@@) % أليس يكفيني فخارا وقد % % أصبحت في قيد وزيرين % % PageV01P990 البحر : طويل 1(@)(@@) % سأبكي وأستبكي عليك المعاليا % % وأسكب من عيني الدموع الجواريا % % 2(@)(@@) % وأصلى لظى نار الأسى كلما أرى % % مكانك ما قد كان بالأمس خاليا % % 3(@)(@@) % وإن لم يكن يجدي البكاء ولم يعد % علي الأسى من ذلك العهد ماضيا % % 4(@)(@@) % ومن حق مثلي أن يذوب حشاشة % من الحزن أو يبكي الديار الخواليا % % 5(@)(@@) % خلت من أبي محمود دار عهدتها % % تضيء به أرجاءها والنواحيا % % 6(@)(@@) % تنورها من كل فج مؤمل % وطارق ليل يبتغي العز راجيا % % 7(@)(@@) % على ثقة بالنيل مما يرومه % % يعاني السرى ليلا ويطوي الفيافيا % % 8(@)(@@) % إذا بلغت آل الجميل ركابه % % فقد فاز بالجدوى ونال الأمانيا % % 9(@)(@@) % ولما مضى عبد الغني 
ms316	 مضت به % % صنايع بر تستفاض أياديا % % 10(@)(@@) % مضى أيها الماضي بك الجود والندى % % وأصبح روض الفضل بعدك ذاويا % % PageV01P991 11(@)(@@) % لئن كنت أغدو من جميلك ضاحكا % لقد رحت ألفى موجع القلب باكيا % % 12(@)(@@) % وقد كنت ألقى الخير عندك كله % % إلى أن قضى الرحمن أن لا تلاقيا % % 13(@)(@@) % فقدناك فقدان الغمامة أقلعت % وقد ألبست برد الربيع اليمانيا % % 14(@)(@@) % وكان مرادي أن أكون لك الفدى % % ولكن أراد الله غير مراديا % % 15(@)(@@) % على هذه الدينا العفا بعد باسل % عقير المنايا يعقر الليث جاثيا % % 16(@)(@@) % ولو أن قرما يفتدى من منية % ويمضي بما يفدي من الموت ناجيا % % 17(@)(@@) % فدتك صناديد الرجال وأرخصت % نفوسا أهانتها المنايا غواليا % % 18(@)(@@) % لقيت بك الأيام غرا فأصبحت % % بفقدك يا شمس الوجود لياليا % % 19(@)(@@) % وما كنت أخشى أن أراع بحادث % يجر إلي القارعات الدواهيا % % 20(@)(@@) % وفي نظر من عين لطفك شاملي % % لقد كنت مرعيا وقد كنت راعيا % % PageV01P992 21(@)(@@) % وكنت إذا يممت جودك ساخطا % على الدهر أمضي من جميلك راضيا % % 22(@)(@@) % أمر على ناديك بعدك قائلا % سقيت الحيا المنهل بالوبل ناديا % % 23(@)(@@) % وأذكر ما أوليتني من صنايع % % من البر معروفا وما كنت ناسيا % % 24(@)(@@) % وكنت متى أسعى إليك بحاجة % % حمدت لدى علياك فيك المساعيا % % 25(@)(@@) % فيا جبلا ساروا به لضريحه % % يطاول بالمجد الجبال الرواسيا % % 26(@)(@@) % % وفي رحمة الرحمن أصبحت ثاويا % % 27(@)(@@) % تبوأت منها مقعد الصدق مكرما % ونلت مقاما عند ربك عاليا % 28(@)(@@) % وغودرت في دار النعيم مخلدا % وفارقت إذ فارقت ما كان فانيا % % 29(@)(@@) % أناع نعاه معلنا بوفاته % % أسمعت أم أصممت ، ويحك ناعيا % % 30(@)(@@) % شققت قلوبا لا جيوبا وأذرفت % إلى جنة الفردوس والعفو والرضى % % PageV01P993 31(@)(@@) % وأسرعت إحراق القلوب صواديا % وعاجلت إهراق الدموع سواقيا % % 32(@)(@@) % رويدك ما أبقيت بالجود مطمعا % ولا لذوي الحاجات في الناس راجيا % % 33(@)(@@) % نعيت إلى العلياء أفلاذ قلبها % % وأدميت منها مهجة ومآقيا % % 34(@)(@@) % ومما يريع الروح قولك بعده % % لنفسي بنفسي خاطبا ومناجيا % 35(@)(@@) % فيا ليتني ذقت المنية قلبه % % ولم أر فيه ما يشيب النواصيا % % 36(@)(@@) % صروف المنايا العاديات كأنها 
ms317	 % % تخال الكرام الأنجبين أعاديا % % 37(@)(@@) % قضى الله بالأمر الذي قد قضى به % % وكان قضاء الله في الخلق جاريا % % 38(@)(@@) % أقلب طرفي بالرجال وأغتدي % % لنفسي خاطبا ومناجيا % 39(@)(@@) % تبدلت الشم العرانين والتوت % بهم بدهى دهياء تصمي المراقيا % % 40(@)(@@) % ولم يبق في بغداد من لو فقدته % أسيت له أو كان للحزن آسيا % % PageV01P994 41(@)(@@) % لقد زالت الشم الرواسي فلم نبل % إذا زلزلت بعد الجبال الرواسيا % % 42(@)(@@) % سقيت الغوادي طالما قد سقيتني % % فما تدرك الآمال إلا أمانيا % % 43(@)(@@) % وحياك منهل من المزن رائحا % وحياك منهل من المزن غاديا % % 44(@)(@@) % ترحات عنا لا ملالا ولا قلى % وهل يعرف السلوان بعدك ساليا % % 45(@)(@@) % وحال الثرى بيني وبينك بالردى % % فما تدرك الآمال إلا ما أمانيا % % 46(@)(@@) % كأنك لم تول ولم تنل % % جزيلا ولم تطلق من الأسر عانيا % % 47(@)(@@) % عزاء بني عبد الغني فإنكم % % فقدتم به ظلا على الخلق ضافيا % % 48(@)(@@) % ودرعا حصينا يعلم الله أنه % % مدى الدهر لم يبرح من الدهر واقيا % % 49(@)(@@) % بنى لكم المجد الأثيل الذي بنى % % ولا تهدم الأيام ما كان بانيا % % 50(@)(@@) % إذا بزغت منه نجوم مناقب % أباهي بساريها النجوم السوارايا % % PageV01P995 51(@)(@@) % لمن أنظم الشعر الذي دق لفظه % % ورق أساليبا وراق معانيا % % 52(@)(@@) % وما كان يحلو لي القريض ونظمه % % إذا لم يكن في ذكره الشعر حاليا % % 53(@)(@@) % وأقسم لو لامست قبرك فالغنى % % وحقك مرجو الحصول به ليا % % 54(@)(@@) % أخذت المزايا والمكارم كلها % % جميعا فما أبقيت للناس باقيا % % 55(@)(@@) % % مضيت ولم يعقب لك الدهر ثانيا % % 56(@)(@@) % يراع بك الخطب المهول وتنتضى % % على حادث الأيام عضبا يمانيا % 57(@)(@@) % وكم نعمة أوليتها وحسرة % % غدوت بها من لوعة البين شاكيا % % 58(@)(@@) % إذا نثرت عيني عليك دموعها % % نظمت لأحزاني عليك القوافيا % % 59(@)(@@) % وقد كنت أشتاق المدائح قبلها % % وبعدك لا أشتاق إلا المراثيا % % PageV01P996 البحر : بسيط تام 1(@)(@@) % ناحت مطوقة في البان تزعجني % % بما تهيج من وجدي وأشجاني % % 2(@)(@@) % كأنما هي إذ تشدو على فنن % % تشدو بذكر أصيحابي وجيراني % % 3(@)(@@) % يا ورق مالك ، لا ألف أصبت به % % ولا تناءيت عن 
ms318	 دار وأوطان % % 4(@)(@@) % فإن بكيت كما أبكي على سكن % % فأين منك همول المدمع القاني % % 5(@)(@@) % إني لفي نار وجد لا خمود لها % % وأنت حشو جنان ذات أفنان % % 6(@)(@@) % وفي الحشاشة ما ألقاه من ظمأ % إلى غرير بماء الحسن ريان % % 7(@)(@@) % إذا جنى الطرف مني عنده نظرا % أماتني طرفه الجاني وأحياني % % 8(@)(@@) % كنا وكان وأيامي بذي سلم % بيض وقد صارمتني منذ أزمان % % 9(@)(@@) % فهل يبل غليل الوجد بعدهم % % من مغرم دنف يا سعد ظمآن % % 10(@)(@@) % يا سعد لا الوعد بالقاصي أرقت له % % ولا إصطباري بعد النأي بالداني % % PageV01P997 11(@)(@@) % ولست أنفك والأحشاء ظامئة % % وإن سقتها بوبل الدمع أجفاني % % 12(@)(@@) % أصبو إذا سجعت في البان ساجعة % % وقد أراع لذكر البين والبان % % PageV01P998 البحر : خفيف تام 1(@)(@@) % جد في وجده بكم فعلاما % % عذل العاذل المحب ولاما % % 2(@)(@@) % ما درى لا درى بصبوة عان % وجد الوجد في هواكم فهاما % % 3(@)(@@) % يستلذ العذاب من جهة الحب % ويحتار في الشفاء السقاما % % 4(@)(@@) % أيها النازحون عنا بقلب % أخلق الصبر و ستجد الهياما % % 5(@)(@@) % عللونا منكم ولو بنسيم % يحمل الشيح عنكم والخزامى % % 6(@)(@@) % وائذنوا للخيال يطرق ليلا % أن يزور الخيال منكم مناما % % 7(@)(@@) % لست أدري ولا المفند يدري % % أملا ما يزيدني أم غراما % % 8(@)(@@) % أين عهد الهوى بآرام نجد % وبلوغ المشوق فيها المراما % % 9(@)(@@) % ذكراني بها مسرات عيش % ليته عاد بعد ذاك وداما % % 10(@)(@@) % وابكياها معي وإن كنت أولى % % عبرة منكما عليها انسجاما % % PageV01P999 11(@)(@@) % ربما ينفع البكاى غليلا % أو تبل الدموع منا أواما % % 12(@)(@@) % وبنفسي أحبة أوقدوها % % لوعة في الحشا فشبت ضراما % % 13(@)(@@) % حرموا عيني الكرى يوم بانوا % % واستباحوا دمي وكان حراما % % 14(@)(@@) % يا لقومي وكل آية عذر % % تعذر المستهام من أن يلاما % % 15(@)(@@) % كيف ينجو من الصبابة صب % فوقت نحوه العيون سهاما % % 16(@)(@@) % ورمته بسهمها فأصابت % % حين أصمت فؤاده المستهاما % % 17(@)(@@) % لم ظهورا وترفع الإيهاما % % بعد أن أصبحت طلولا رماما % % 18(@)(@@) % ليت شعري وأين أيام فروى % % أفكانت أيامها أحلاما % % 19(@)(@@) % ينبت الحسن في ثراها غصونا % كل غصن يقل بدرا 
ms319	 تماما % % 20(@)(@@) % من لصاد ظامي الحشا يتلظى % % غلة في فؤاده واضطراما % % PageV01P1000 21(@)(@@) % لو رشفنا الحياة من ريق ألمى % % ما شكونا من الجوى آلاما % % 22(@)(@@) % لا تنوب المدام عن رشفات % من شفاه تعاف فيها المداما % % 23(@)(@@) % حبذا العيش والمدام مدام % ذلك العصر والندامى ندامى % % 24(@)(@@) % فسقاها الغمام أربع لهو % كلما استسقت الديار الغماما % % 25(@)(@@) % كان صحبي بها وكنا جميعا % نشبه العقد بهجة وانتظاما % % 26(@)(@@) % فإذا عن ذكرهم لفؤادي % % قعد الوجد بالفؤاد وقاما % % 27(@)(@@) % أترى في الأنجاب ك بن علي % وهو عبد الرحمن شهما هماما % % 28(@)(@@) % ناشئ في الشباب في طاعة الل % % ه فكان الصوام والقواما % % 29(@)(@@) % لا ينال الشيطان منه مراما % ثقة منه بالتقى و عتصاما % % 30(@)(@@) % يرتقي في الكمال يوما فيوما % ويسود الرجال عاما فعاما % PageV01P1001 31(@)(@@) % فطنة تكشف الغوامض في العلم % % ظهورا وترفع الإبهاما % % 32(@)(@@) % فتراه إذا تأملت فيه % % ألهم العلم والحجى إلهاما % % 33(@)(@@) % زانه الله بالتقى وحباه % % عفة في طباعه واحتشاما % % 34(@)(@@) % طاهر لا يمسه دنس الس % وء عفافا ولا يداني أثاما % % 35(@)(@@) % فيه من جده مناقب شتى % % مدهشات الأفكار والأفهاما % % 36(@)(@@) % من أراه الترياق من ضرر السم % م أراه على العدو سماما % % 37(@)(@@) % فرع آل البيت الذي شرف الله % % ه وأعلاهم لديه مقاما % % 38(@)(@@) % فتمسك بهم ولذ بحماهم % % فهم العروة التي لا انفصاما % % 39(@)(@@) % يبعث الله منهم كل عصر % علماء أفاضلا أعلاما % % 40(@)(@@) % يمحقون الضلال من ظلمة الكفر % % ر كما يمحق الضياء الظلاما % % PageV01P1002 41(@)(@@) % ينفقون الأوال حبا لوجه الله % % منهم ويطعمون الطعاما % % 42(@)(@@) % دحضوا الغي بالرشاد فما % % زالوا إلى الله يرشدون الأناما % % 43(@)(@@) % كلما استبشروا بميلاد طفل % بشر المسلمين والإسلاما % % 44(@)(@@) % وينال الوليد منهم علاء % قبل أن يبلغ الوليد الفطاما % % 45(@)(@@) % نولوا وابلا وجادوا غيوثا % و ستهلوا بشاشة وابتساما % % 46(@)(@@) % لو سألت العلى أجابتك عنهم % % أو سألت السيوف والأقلاما % % 47(@)(@@) % لا يضام النزيل فيهم بحال % وأبى الله جارهم أن يضاما % % 48(@)(@@) % بلغوا غاية المعالي قعودا % تعجز الراغبين فيها قياما % % 49(@)(@@) % بأبي سيدا تهلل طفلا % وزكا عنصرا وساد غلاما 
ms320	 % % 50(@)(@@) % وكأني به وقد ولي الأمر % وأضحى للعارفين إماما % % PageV01P1003 51(@)(@@) % هكذا تخبر السعادة عنه % % ويطيل العرفان فيه الكلاما % % 52(@)(@@) % يتحلى من فضله بحلي % نظمته غر القوافي نظاما % % PageV01P1004 البحر : طويل 1(@)(@@) % فديتك لا ترجو لنطقي تكلما % % فإن يراعي عن لساني يترجم % 2(@)(@@) % غرقت ببحر من نوالك سيدي % % فكيف غريق عائم يتكلم % PageV01P1005 البحر : طويل 1(@)(@@) % ومالكة رقي وما أنا ملكها % % أقول لها سلمى ملكت فأرفقي % % 2(@)(@@) % لئن كنت صدقت الوشاة بأنني % % سلوت فما قالوه غير مصدق % 3(@)(@@) % وبي شاهد مني على ما أقوله % % وإن كنت في شك مريب فحققي % % 4(@)(@@) % يقيدني حبيك فالدمع مطلق % عليك وقلبي في الهوى غير مطلق % % 5(@)(@@) % ولم أنس إذ زارت على حين غفلة % تميس كغصن البان بالحلي مورق % % 6(@)(@@) % وبتنا ولا واش هناك وساعدي % % يطوقها إذ ذاك أي تطوق % % 7(@)(@@) % ودار من الأشواق بيني وبينها % % حديث عتاب كالرحيق المعتق % % 8(@)(@@) % وكيف تراها ليلة طاب عيشها % % وعهدي بطيب العيش قبل التفرق % % 9(@)(@@) % إلى أن تجلى صارم الفجر و نجلى % % ومزق برد الفجر كل ممزق % % 10(@)(@@) % وقالت سليمى نلتقي بعد هذه % % فقلت خذي روحي إلى حين نلتقي % % PageV01P1006 البحر : طويل 1(@)(@@) % هو الوجد يا ظمياء منك وجدته % % يحملني في الحب ما لا أطيقه % % 2(@)(@@) % إذا قيل لي وجد فقلبي حريقه % % وإن قيل لي دمع فطرفي غريقه % % 3(@)(@@) % وحسبك من صب يروع فؤاده % % سنا بارق يحكي فؤادي خفوقه % % 4(@)(@@) % وكل وميض يا سليمى يروعه % % وكل هوى من آل مي يشوقه % % PageV01P1007 البحر : وافر تام 1(@)(@@) % يقول لي النصوح هلكت وجدا % بمن تهوى وما كذب النصوح % 2(@)(@@) % وقال إلى متى تبكي رسوما % عفتهن الجنوب وكم تنوح % % 3(@)(@@) % فغض الطرف عن طلل قديم % فقد أودى بك الطرف الطموح % % 4(@)(@@) % تلوح لعينيك الدمن البوالي % % وقد تخفى وآونة تلوح % % 5(@)(@@) % أراعك ما ترى من رسم دار % وطار بقلبك البرق اللموح % % 6(@)(@@) % فخفض من فؤادك حين يبدو % % لعينك بارق وتهب ريح % % 7(@)(@@) % وفي الأطلال ما تشكو إليها % % من البلوى ولكن لا تبوح % % 8(@)(@@) % محث آثارها للحي نأي 