ms41	 نور شمس جلاله % قبال قبا تجلو دياجي الدياجر % 17(@)(@@) % شعاع تسامى من ضريح محمد % و أشرق منه طالعات البشائر % 18(@)(@@) % هو الرحمة المهداة للخلق حبذا % % كريم السجايا خير باد وحاضر % 19(@)(@@) % أليس انشقاق البدر معجزة له % و ظل غمام الجو عند الهواجر % 20(@)(@@) % و سجدة أجمال وسجدة ظبية % و حنة جذع من هشيم المنابر % % PageV01P126 21(@)(@@) % و تسبيح حصباء اليمين يمينه % و فيض زلال الماء يوم العساكر % 22(@)(@@) % و إخبار عضو الشاة أني مسمم % فتبا لأفعال اليهود الأصاغر % 23(@)(@@) % و يوم دعا الأشجار من غير حاجة % سعت نحو خير الخلق سعى مبادر % 24(@)(@@) % و أشبع يوم الخندق الجيش كله % بصاع شعير كان في بيت جابر % 25(@)(@@) % و في ثمد أهوى بسهم فلميزل % يجيش لهم بالري من غير حافر % 26(@)(@@) % و مسرى رسول الله من بطن مكة % إلى المسجد الأقصى كلمحة ناظر % 27(@)(@@) % فأم بها الأملاك والرسل وانثنى % % إلى الملإ الأعلى بقدرة قادر % 28(@)(@@) % و سار به جبريل في سمر الرضا % % و بشر من أهل السما كل سامر % 29(@)(@@) % و زج به في النور حتى إذا انتهى % % إلى موقف ما فيه نهج لسائر % 30(@)(@@) % أشار إليه الله بالبشر فانثنى % يخوض بحار النور خوض مباشر % PageV01P127 31(@)(@@) % مشاهد لم توطأ بأخمص غيره % و آثار تخصيص على كل آثر % 32(@)(@@) % و بيداء نور وحده جاز جنحها % على قدم ساع إلى الخير طاهر % 33(@)(@@) % فلما دنا من قاب قوسين رفعة % و ألبسه الرحمن تاج المفاخر % 34(@)(@@) % سقاه بكأس الحب من فوق عرشه % سلافة قرب لا سلافة عاصر % 35(@)(@@) % و بوأه فوق النبيين رتبة % تحاشى بها عن مشبه ومناظر % 36(@)(@@) % و شفعه في المذنبين وزاده % خصائص أخرى لا تعد لحاصر % 37(@)(@@) % غداة لواء الحمد والكوثر الذي % % يوافيه ظامى الورد ريا المصادر % 38(@)(@@) % إليك شفيع المذنبين مدائحا % مؤلفةتزرى بنظم الجواهر % 39(@)(@@) % أتيتك يا شمس الهدى متشفعا % بها لأخي في الله أعني الحصاورى % % 40(@)(@@) % سميك يا مولاي أثقل ظهره % بفعل المناهي واجتناب الأوامر % PageV01P128 41(@)(@@) % فكن من جميع النائبات حمى 
ms42	 له % و عامله بالحسنى وواصل وناصر % 42(@)(@@) % أزح محن الدارين بالعطف منك عن % مؤلفها عبد الرحيم المهاجري % 43(@)(@@) % وأتمملنا النعمى على ذيقرابة % و صحب وأشياخ وجار مجاور % 44(@)(@@) % و صلى عليك الله ما هبت الصبا % % و ماجن رعد في عريض المواطر % 45(@)(@@) % صلاة إذا خصتك عمت بنورها % % بقيةأصحاب و آل أخاير % PageV01P129 البحر : - 1(@)(@@) % حروف معان أو عقود جواهر % تحاكى مصابيح النجوم الزواهر % 2(@)(@@) % و إبريز تبريز من النظم فتحت % قوافيه زهرا في رياض الدفاتر % 3(@)(@@) % يروح بأرواح المحامد حسنها % % فيرقى بها في ساميات المفاخر % 4(@)(@@) % فتلك على بعد الديار وقربها % % قريبة عهد بالحبيب المهاجر % 5(@)(@@) % عرائس لا ينكحن غير مهذب % كريم ولا يعشقن من لم يخاطر % 6(@)(@@) % إذا ما هداها الفكر أهدت لذي النهى % % شمائل أشهى من شمول المعاصر % 7(@)(@@) % تشعشع من نور المعاني عناية % بها تضرب الأمثال بين المعاشر % 8(@)(@@) % و تنظم من نثر المثاني قلائدا % تزخرف جيد الجود من كل فاخر % 9(@)(@@) % و تنشر من طي المروءة للفتى % % مكارم أخلاق وحسن سرائر % 10(@)(@@) % إذا ستروها بالحجاب تبرجت % محاسن تبدو من وراء الستائر % PageV01P130 11(@)(@@) % وإن فض في الأكوان مسك ختامها % % تعطر منها كل نجد وغائر % 12(@)(@@) % تخيرتهاللهاشميمحمد % حميد المساعي خير باد وحاضر % 13(@)(@@) % نبي أتى والناس في جاهلية % يخوضون في بحر من الشرك زاخر % 14(@)(@@) % على الغي في طغيانهم يعمهون وقد % هوت بهم الأهوا إلى غير ناصر % 15(@)(@@) % فمد عليهممنه ظل هداية % و أرشد منهم للهدى كل حائر % 16(@)(@@) % وأحكم أسباب النجاة وهم على % % شفا جرف هار لإنقاذ عاثر % % 17(@)(@@) % له معجزات الوحي لا قولكاهن % كما زعموا زورا ولا قول شاعر % 18(@)(@@) % عزيز عن الإفك الذي يفترونه % على الله من تحريم ذات البحائر % 19(@)(@@) % و عمن رجس أوثان وخمر وميسر % و طغيان أنصاب وأزلام فاجر % 20(@)(@@) % فنحنبه في ملة خير ملة % على خير دين ظاهر متظاهر % PageV01P131 21(@)(@@) % هدانا الصراط المستقيم بهديه % و أورى بنور الحق نور البصائر % 22(@)(@@) % و علمنا الأحكام والرشد رحمة % لنا ووقانا دائرات الدوائر % 23(@)(@@) % سقى 
ms43	 واكف الوسمي أكناف طيبة % و روى ربا تلك الرياض النواضر % 24(@)(@@) % مشاهد يرضى اللهمسحترابها % % و يوضع فيها الوزر عن كل وازر % 25(@)(@@) % و أرض بهاللهاشميمآثر % يعودعليناخيرتلكالمآثر % 26(@)(@@) % فيا زائرا روح الحبيب محمد % بنفسي وأهلي من حبيب وزائر % 27(@)(@@) % إذا ما رأت عيناك روضة أحمد % فباه رياض الخلد فيها وفاخر % 28(@)(@@) % و قبل ثرى ذاك الحبيب مسلما % على خير مقبور بخير المقابر % 29(@)(@@) % سلام إذا ما عد بالرمل والحصى % % و نبت الفلا حصرا وقطر المواطر % 30(@)(@@) % فضاعف على أعشاره ومئينه % بسبعين ألفا ثم ضاعف وكاثر % PageV01P132 31(@)(@@) % و قل يا شفيع المذنبين إعانة % لذيدعوة يرجو إقالة عاثر % 32(@)(@@) % أتاكينادييا لجاه محمد % و أنت جواد باعه غير قاصر % 33(@)(@@) % و ما الظن يا مولاي فيك بخائب % و لا العائذ اللاجي إليك بخاسر % 34(@)(@@) % فإني على قربى وبعدى رفيقكم % و ما دحكم في كل ناد وسامر % 35(@)(@@) % فكن من أذى الدنيا غياثي وناصري % % و غوثي على باغ علي وغادر % 36(@)(@@) % و إن ضاق يوم الحشر بالناس جانبا % فقل لا تخف عبد الرحيم المهاجري % % 37(@)(@@) % و برو أكرممنيليهلأجله % إذا قيل قم فاشفع لأهل الكبائر % 38(@)(@@) % فليس لنا يوم المعاد ذخيرة % بلا وجهك الميمون خير الذخائر % 39(@)(@@) % فما أمل الراجين من مطلب الغنى % % سواك وما راجى سواك بظافر % 40(@)(@@) % وصلى عليك الله ما حن راعد % و ما لاح برق في دياجى الدياجر % PageV01P133 41(@)(@@) % صلاة تسامى الشمس نورا ورفعة % و تروي برياها عبير المجامر % 42(@)(@@) % منالأزلاستفتاحهامستمرة % إلى أبد الآباد آخر آخر % 43(@)(@@) % تخصك يا فرد الوجود وتنثني % % على آلك الغر الكرام العناصر % PageV01P134 البحر : - 1(@)(@@) % ضربت سعاد خيامها بفؤادي % % من قبل سفك دمي بسفح الوادي % % 2(@)(@@) % و غدت تجرعني الهموم فمن لمن % فصمت عراه شماتة الحساد % 3(@)(@@) % و كأنني وكأنها متودد % متلطف لظويلم متمادى % % 4(@)(@@) % لعب الفراقبها وبي فلها ولي % % خبر كوى كبدي بغير زناد % 5(@)(@@) % و ترعرت طرق التواصل بيننا % % فغدوت نضو صبابة و بعاد % 6(@)(@@) % ما كان حجة من أقام بمكة % أن لا يحدثني حديث سعاد 
ms44	 % 7(@)(@@) % بعثت إلى من الحجاز خيالها % % شتان بين بلادها و بلادي % % 8(@)(@@) % يا هذه عودتني ألمالضنى % و أراكلست أراكفي العواد % 9(@)(@@) % وبأيآونة أزوركبعدما % % حملت هجرك أضعف الأجساد % 10(@)(@@) % فبحق حقك إن ملكت فأسمحى % % شيم الكرام وإن أسرت ففادي % % PageV01P135 11(@)(@@) % فقف المطى ولو كلمحةناظر % بربا المحصب أو منى يا حادي % % 12(@)(@@) % و أعد حديثك عن أباطح مكة % و عن الغريق أرائح أم غادي % % 13(@)(@@) % و مسرةللناظرينبدتلنا % % مابين سوق سويقة وجياد % 14(@)(@@) % قنصت عقول أولى النهى بحبائل ال % % صبوات لا بحبائل الصياد % 15(@)(@@) % و محاسن طلعت طلائعهن عن % حلل الكماللحاضر و لبادي % % 16(@)(@@) % عكفتبساحتها الرفاقو إنما % % عكفوا على كبد منالأكباد % 17(@)(@@) % هطلالغمام على الحطيم وزمزم % و على بقاع بالنقاو وهاد % 18(@)(@@) % و سرى النسيمبطيبنسمة طيبة % فشقتنفخة عنبر وجساد % 19(@)(@@) % بلد سمتأوطانهو تشرفت % بمحمد قمر الكمالالهادي % % 20(@)(@@) % قمر محادينالضلالةبالهدى % % وأذلأهلالبغيو الإلحاد % PageV01P136 21(@)(@@) % قمر أضاءالنور ليلةو ضعه % منمكة لدمشقأو بغداد % 22(@)(@@) % قمر حمى الدينالحنيفبسيفه % شرفا وأحرزسبق كلجهاد % 23(@)(@@) % قمر أبادالمشركينبسادة % فاقتعزائمهمعلى الآساد % 24(@)(@@) % قمر سقى الجيشالعظيمبكفه % نهرا أزالغليلكلفؤاد % 25(@)(@@) % هوأشرف العربينمجدا بازخا % و أحق منيعلو على الأمجاد % 26(@)(@@) % هو شمس عبد مناف العليا علت % مضر بجديهعلى الأنجاد % 27(@)(@@) % هوجاوز السبعالسموات العلى % % و العرشفيماصحمن إسناد % 28(@)(@@) % هو في الجلالةقال سيدهله % سلما تحبفأنت خير عمادي % % 29(@)(@@) % هوخير من كمل الأناس به من % الأبناءوالآباءوالأجداد % 30(@)(@@) % هو سيدالكونينوالثقلين لا % شبه لهفيالغوروالأنجاد % PageV01P137 31(@)(@@) % هوأكرم الكرماءإنعصفتبه % ريحالسماح وأجودالأجواد % 32(@)(@@) % هو ذخرتي هو موئلي ومؤملي % % هوعمدتيهوعدتي وعيادي % % 33(@)(@@) % هو أحمدالهاديالمجاهدو الذي % % يروى بكوثرهالغليلالصادي % % 34(@)(@@) % هوتحت ساق العرش يسجدشافعا % في الخلق إنحشروا إلى الميعاد % 35(@)(@@) % هومنيلوذغدا بظللوائه % كلالورى والرسل والأشهاد % % 36(@)(@@) % هو عمدة الأممالتيلولميكن % فيهالقدكانتبغيرعماد % 37(@)(@@) % هو هازمالأقرانفيفنكاته % و مدمرالعشراتبالآحاد % 38(@)(@@) % ما إنرجوتبهالهدى لضلا لتي % % إلالقيتبها صلاحفسادي % % 39(@)(@@) % مولاي خذبيديو اقض حوائجي % % و اعطفعلى و لبحين أنادي % % 40(@)(@@) % و اقبلخويدمكالمعلمإنه % فلس منالتقوى قليلالزاد % PageV01P138 41(@)(@@) % حملتذي النفسالضعيفةثقلها % % و شعلتبينأصادق و أعادي % % 42(@)(@@) % في الخيمةانقصمتعرايلزلتي % % و النارللعاصينبالمرصاد % 43(@)(@@) % و عريضجاهكيا محمد عصمتي % % و كفايتي وهدايتي ورشادي % % 44(@)(@@) % فاشددعرى عبد الرحيمبرحمة % يلقى بهافيالحشر خير مهاد 
ms45	 % % 45(@)(@@) % و اجعليديك حمى لهو لأهله % و الصحبو الآباءو الأولاد % 46(@)(@@) % فلأنت أمنعمنلجأتإليهفي ال % % دارين دارإقامتيو معادي % % 47(@)(@@) % و اعطفعلى بنفحة نبوية % لأنال غاية مطلبيو مرادي % % 48(@)(@@) % و مكارم موصولة بمكارم % و لطائف وعواطف وأيادي % % 49(@)(@@) % و اسمعجواهر أحرف عربية % زفتإليك فصيحةالإنشاد % 50(@)(@@) % وانهضبقائلهاو صاحبه فقد % خصاكإذ صداعن الوراد % PageV01P139 51(@)(@@) % فتراهماوفداعليك ليحظيا % % يا سيديبكرامةالوفاد % 52(@)(@@) % و تولكاتبها الضعيف وكنله % يد نصرة من شركل عناد % 53(@)(@@) % وعليكصلى اللهيا علمالهدى % % ما ارفض في الأقطار صوب عهاد % 54(@)(@@) % وعلى صحابتك الكرام الزهر ما % % نادى بحي على الصلاة منادى % % PageV01P140 البحر : - 1(@)(@@) % أيرجعلي قرب الحبيب المعاهد % و تجديد عهد الوصل بين المعاهد % 2(@)(@@) % و هل بعد شت الشمل وصل علائق % علقنبقلبفاقد غيرفاقد % 3(@)(@@) % فما زلت مطلولا دمى ومدامعي % % على طلل بالأبرقالفردهامد % 4(@)(@@) % و سفكدمي عن سفح دمعي مفهم % بأن عيون العين سم الأساود % 5(@)(@@) % و بين بطاح الرمل من شعب عامر % خدور بدور ناعمات نواهد % 6(@)(@@) % كأن شعاع النور في قسماتها % % شقائق حسن في رياض خرائد % 7(@)(@@) % يرنحها سكرالشبيبة والصبا % % فعند الهوى العذري مطل الموارد % 8(@)(@@) % فيا ليت شعري عن خييمات حاجر % و سكان ذاك البرزخ المتباعد % 9(@)(@@) % و عن روضة كانت مقيلا ومسمرا % لنا ولليلى في الزمان المساعد % 10(@)(@@) % و ما كان من علم الفريق وما حكوا % % عن الطالب المهجور خلف العضائد % PageV01P141 11(@)(@@) % قفا بي بذات الأثل عن أيمن الحمى % % لأنشد قلبا لا يردبناشد % 12(@)(@@) % وأستخبر النجدي إن هب عائدا % بربع اللوى عن ظنه وعقائدي % % 13(@)(@@) % لعل عليل الريح يهدي روائحا % لراحة صب للصبو مكابد % 14(@)(@@) % أما والذي حج الملبونبيته % يؤمونه بالهدى ذات القلائد % 15(@)(@@) % و من طاف بالبيت المعظم ناسكا % و شاهد من أنوار تلك المشاهد % 16(@)(@@) % لئن نذرت لي عطفة بوصالكم % على بعد دارينا وقرب الحواسد % 17(@)(@@) % لأستغرقن العمر شكرا على الذي % % مننتم به مستعزما غيرجاحد % 18(@)(@@) % فما صدني من بعدكم بعد منزلي % % و لا خوف قطع من ظلام الشدائد % 19(@)(@@) % و بين قبا والشامشمس جلالة % جلا الكون سامى نورها المتصاعد % 20 
ms46	(@)(@@) % نبي نضاه الله سيفا لدينه % و مكنهمنكلعاد معاند % PageV01P142 21(@)(@@) % و ناداه باسمي أحمد ومحمد % على أنهمستجمع للمحامد % 22(@)(@@) % فها هو خير الخلق من خير أمة % يدل على نهج لإرشاد قاصد % 23(@)(@@) % و نحن به نعلو على الأمم التي % % مضت وكتاب الله أعدل شاهد % 24(@)(@@) % أتانا بنور الحق والشرك عامر % فأصبح رسم الشرك واهى القواعد % 25(@)(@@) % و مدعلينامنه ظلهداية % و أمطرنا من برهكلجائد % 26(@)(@@) % ألا يا نسيما هب من قبر طيبة % بثثت رياح المسك بين الثلائد % 27(@)(@@) % أعد لي إلى تلك الرياض هدية % لأكرم ساع في الأنام وقاعد % 28(@)(@@) % سلاما كعد الرمل والقطر والحصى % % ونبت الأراضي والنجوم الشواهد % 29(@)(@@) % جديدا على مر الجديدين جاريا % إلى أبد الآباد ليسبنافد % 30(@)(@@) % على خير خلق الله حيا وميتا % و أشرف مولود لأشرف والد % PageV01P143 31(@)(@@) % حبيب زرعت الحب في كبدي له % و لست لزرع الحب أول حاصد % 32(@)(@@) % و قدمت مدح الهاشمي تجارة % إلى موسم الأرباح كنز الفوائد % % 33(@)(@@) % إليك شفيعالمذنبين انتهت بنا % % طلائع فكر تبتغي حق وافد % 34(@)(@@) % كأن فتيت المسك مسود خطها % % و ألفاظهاتزريبدرالفرائد % 35(@)(@@) % هنيئا لها إن أدركت مطلب الغنى % % لديك وأضحى سوقها غير كاسد % 36(@)(@@) % أتتك من النيابتين مجيدة % بمدحك ترجو منك مهر القصائد % 37(@)(@@) % لقائلهاعبد الرحيم بن أحمد % و صاحبه الذنوب ابن راشد % 38(@)(@@) % فما زال في أرض المغارب حاملا % لثقل ذنوب كالجبال الرواكد % 39(@)(@@) % فقيرا حقيرا مستقرا بذنبه % يبارز بالعصيان أعدل ناقد % 40(@)(@@) % و ذنبي أيا مولاى أضعاف ذنبه % و بحرك للراجين عذب الموارد % PageV01P144 41(@)(@@) % وجودك موجودو فضلكفائض % و مهما سئلت الشيء جدت بزائد % 42(@)(@@) % فلا تخلنايا سيدالمرسلينمن % % عواطف بر أو جميلعوائد % 43(@)(@@) % و قلأنتما في ذمتي من جهنم % و من محن الدنيا ومكر الحواسد % 44(@)(@@) % و من سكرات الموتو القبروحده % و من كل هول واقف بالمراصد % 45(@)(@@) % و برو أكرممنيلينا رحامة % و صحبة دين و اتفاقعقائد % 46(@)(@@) % فليس لنا ركن يقينا من الذي % % نحاذرهلولاكسهل المقاصد % 47(@)(@@) % و لا عمل به نرجو النجاة سوى % % شفاعتك العظمى لساه وعامد % 48 
ms47	(@)(@@) % و صلى عليكاللهما لاحبارق % تجاوبهفي الجو حنة راعد % 49(@)(@@) % و ما ارفضمنواهى العرا كل مسجم % و قوم من نبت الثرى كل ساجد % 50(@)(@@) % و ماغردتورقاءفيعذباتها % % سحيرا على غصن من الأيك مائد % PageV01P145 51(@)(@@) % صلاةتباريالريح مسكا وعنبرا % و تعلو بسامي النور فوق الفراقد % 52(@)(@@) % وتستغرق الأعصارو الحقب عمرها % % بغير انتهاء خالد في الخوالد % 53(@)(@@) % تخصكيا فردالوجود وتثني % % عموما على الصحب الكرامالموالد % 54(@)(@@) % عتيق و فاروق و عثمانو الفتى % % على و أتباع و آل أماجد % PageV01P146 البحر : - 1(@)(@@) % ضحكت بروق الإبرقين تبسما % % و سمت نجوم الحق في كبد السما % % 2(@)(@@) % و سقى الغمام ربا الحجاز مسحرا % و مصبحا و مفجرا و معتما % 3(@)(@@) % و بكى الحمام على الربامترنما % فأجبت ذاك الساجعالمترنما % % 4(@)(@@) % ومكثتفيالنيابتينمتيما % % و لقد رضيت بأن أعيشمتيما % % 5(@)(@@) % يا ساجعات الورقفي عذب الحمى % % ما كل ذي شجن يحن إلى الحمى % % 6(@)(@@) % . أعلى لوم إن جرى دمعي دما % أوذبت من ولهي إلى البيض الدما % % 7(@)(@@) % صد الحبيب عن الزيارة بعدما % % قد كنت أرجو أن يرق ويرحما % % 8(@)(@@) % يا صاح لا ترض بالإقامةمنجدا % إن كنت فارقت الفريق المتهما % % 9(@)(@@) % ارحل منالنيابتينقلانصا % في الدونافرة تبارى الاسهما % % 10(@)(@@) % فإذا دنت أعلام مكة منك أو % ميقاتهاأحرمت فيمن أحرما % % PageV01P147 11(@)(@@) % و طف القدوم هناك واسع مهرولا % في المروتين ولبوادع معظما % 12(@)(@@) % و افض الذي فرض الإله عليك من % تفث وعد نحو الحجاز ميمما % 13(@)(@@) % فإذا بلغتإلى رياضمحمد % فانزلهناك مصليا ومسلما % 14(@)(@@) % تلقالبشير المنذرالمزملال % % مدثر المتأخر المتقدما % % 15(@)(@@) % كانتنبوتهو آدمصورة % في الماءو الطينالمصور منهما % % 16(@)(@@) % و بهوجود الكونمنعدم فقد % ملأالزمانتفضلا و تكرما % % 17(@)(@@) % قمر تعلقتالنفوسبحبه % فكأنهفيكلقلب خيما % % 18(@)(@@) % فمتى نجوزإلى البقيعو طيبة % و أحوزملءالعين مننوريهما % % 19(@)(@@) % و أقومفي حرمالنبوةمنشدا % مدحا كأزهارالربيعمنظما % % 20(@)(@@) % للعاقبالماحيالذيملأالورى % % كرما ومرحمة وعمو أنعما % % PageV01P148 21(@)(@@) % و ابن العواتكخيرمنوطىء الثرى % % و أجل منركب المطى وأكرما % % 22(@)(@@) % فالوجدأوجدنيإليكصبابة % و حشا الحشا شوقا يشقالأعظما % % 23(@)(@@) % يسريحجازيالنسيمبنشره % فأبيتملتهبالحشاشةمغرما % % 24(@)(@@) % أصلالصلاةإلى الصلاةعلى الذي % % صلى عليه ذو الجلال وسلما % % 25(@)(@@) % من ليبأنأصلالمدينةزائرا % و أقبلالتربالكريمو ألثما % % 26(@)(@@) % جادتعلى حرمالنبي محمد % و طفاءتنشردمعهاالمتسجما % % 27(@)(@@) % و 
ms48	 سرى إلى أكناف طيبة عارض % غدقا إذا ضحكت بوارقههما % % 28(@)(@@) % بلد به الملاالذينتبوءوا % % رتب العلابالسمروالبيض الظما % % 29(@)(@@) % و تفيئواظل العجاجو أعلموا % % أسبافهم لمصارع الصيد الكما % % 30(@)(@@) % بمبارك الوجه الذي نفحاته % في المحل تحكى الزاخر المتلطما % % PageV01P149 31(@)(@@) % فرد الكرامة بالشفاعة واللوا % % و الكوثر المروى العباد من الظما % % 32(@)(@@) % و مظفر العزمات يصدع عزمه % صمالجبال ويستحط الأنجما % % 33(@)(@@) % ملأ الثغور صواهلا وقبائلا % كالأسدتستبقى العجاج الأدهما % % 34(@)(@@) % و سقى ديار الشرك غيم عواسل % و مناصل يرفض عارضها دما % % 35(@)(@@) % ذاك المظلل بالغمامة والذي % % سجد البعير له وحن وأرزما % % 36(@)(@@) % و الظبي حياه بأحسن منطق % والعضو خاطبه وكان مسمما % % 37(@)(@@) % و بخمسة الأقراص أشبع جيشه % و سقى خميسا من يديه عرمرما % % 38(@)(@@) % و رمى هوازن في حنين بقبضة % من تربة الوادي فولوا إذ رمى % % 39(@)(@@) % و دعا بأشجار الفلاة فأقبلت % عنقا تسير تأخرا وتقدما % % 40(@)(@@) % و هو الذي نطقالحصا في كفه % و الجذعحن تذكرا وتندما % % PageV01P150 41(@)(@@) % و انشق بدر التم من بركاته % و الحق يشهدقبلأنأتكلما % % 42(@)(@@) % صلى عليك الله ما هب الصبا % % أو حن رعد في الدجى وتزرجما % % 43(@)(@@) % و على أبي بكر فقد سبق الورى % % فضلا وتصديقا لهمذأسلما % % 44(@)(@@) % عضد الرسول بنفسه وبماله % طوبى لذلك ما أبرو أرحما % % 45(@)(@@) % و على الفتى عمر الذي بجهاده % في الله حل بسيفه ما استبهما % % 46(@)(@@) % فتح الفتوح وغادرت فتحاته % رسم الضلالة دارسا متهدما % % 47(@)(@@) % و على شهيد الدار عثمان الذي % % من نوره استحيت ملائكة السما % % 48(@)(@@) % من أنزلت فيه أمن هو قانت % ذاك الذي جمع الكتاب المحكما % % 49(@)(@@) % و على أبي السبطين حيدرة الذي % % ما زال في الحرب الهزبر الضيغما % % 50(@)(@@) % ترتاده الآمالرفضة ممحل % و تذوقه الأعداء سما علقما % % PageV01P151 51(@)(@@) % و على الحسين وصنوه حسن فقد % سميا بأمهما علا وأبيهما % % 52(@)(@@) % والآل والصحب الكرام فإنهم % شهب إذا ليل الحوادث أظلما % % 53(@)(@@) % الضاحكون إذا الوجوه عوابس % و المقدمون إذا المقدم أحجما % % 54(@)(@@) % سحب الندى شهب الهداية كلهم % يلقى العدا أسدا وأسود أرقما % % 55(@)(@@) % للوحش رزق من حصاد 
ms49	 سيوفهم % % شبعا وريا كان لحما أو دما % % 56(@)(@@) % جعلوا نفائسهم وأنفسهم حمى % % للدين حتى كان دينا قيما % % 57(@)(@@) % لله در أولئكممنفتية % ما كان أولاهم بذاك وأقدما % % 58(@)(@@) % شملتهم بركات أحمد الذي % % ساد الأنام فصيحها والأعجما % % 59(@)(@@) % قمر سما سبعا و كلم ربه % ليلا وعاد مبجلا ومعظما % % 60(@)(@@) % و تقدم الرسل الكرام لفضله % فيهم وكبر بالصلاة وأحرما % % PageV01P152 61(@)(@@) % صلى عليه الله كم ملك سرى % % فيه صعودا في السماء وكم سما % % 62(@)(@@) % يا سيدالثقلين يا مأمولنا % % في الحشر يا هادي العباد من العمى % % 63(@)(@@) % إنقمت يا ابنالأطيبينمشفعا % بالمذنبين ومشفقا مترحما % % 64(@)(@@) % فاعطفعلى عبد الرحيم برحمة % فلقد طغى وجار وأجرما % % 65(@)(@@) % و جفاك إذ زار الرفاق ولم يزر % ما يستطيع يرد أمرا مبرما % % 66(@)(@@) % لكنه لمارأى زلاته % عظمت عليه رأى نوالك أعظما % % 67(@)(@@) % فالطف به واعطف عليه وكن له % حصنا من الخطب العظيم وملزما % % 68(@)(@@) % واشفعإلى الباري له ولسربه % إذ صار سجن الظالمين جهنما % % 69(@)(@@) % و أجره في الدارين مما يتقى % % هو في حماك ولم تزل حامى الحمى % % 70(@)(@@) % وأجزه يا مولاي كل كرامة % ترجى وزده على المكارم أنعما % % PageV01P153 71(@)(@@) % و عليك صلى الله طول الدهر ما % % ضحكت بروق الأبرقين تبسما % % PageV01P154 البحر : - 1(@)(@@) % أفقهديت من التبرج والكمد % و إن تكن قطعة ذابت من الكبد % 2(@)(@@) % و اقنع بمن لم يزل سبحانه عوضا % عن كل ما فات من أهل ومن ولد % 3(@)(@@) % و اشكر على نعمة من نعمة نشأت % لمن أراد بك الحسنى ولم ترد % 4(@)(@@) % و اصبر على الكسر على الله يجبره % بمعظم الأجر واطلب جوده تجد % 5(@)(@@) % و كلما صرعتك النائبات فقل % يا سيدي يا رسول الله خذ بيدي % % 6(@)(@@) % تلق ابن آمنة غوث الطريد إذا % % ضاق الخناق بخطب غير متئد % 7(@)(@@) % خير البرية من عجم ومن عرب % و أكرم الخلق في الأغوار والنجد % 8(@)(@@) % محمد خير سادات الورى مضر % من جاره جار عز غير مضطهد % 9(@)(@@) % أتى به الله شمسا غير آفلة % تسمو بنور على الآفاق متقد % 10(@)(@@) % فرع تسلسل من 
ms50	 سر النبوة في % % أفيال مكة مغنى الطارق الكمد % PageV01P155 11(@)(@@) % من عنصر المجد بحبوح الفخار سرى % % من سيد سند في سيد سند % 12(@)(@@) % هدى به الله قوما لا خلاق لهم % من أمة عميت عن منهج الرشد % 13(@)(@@) % أمت شفا جرف هار فأنقذها % % و حل منها محل الروح في الجسد % 14(@)(@@) % أقال عثرة غاويها وأدركها % % رشدا وأصلح ما فيها من الأود % 15(@)(@@) % و قام يهدي إلى قصد السبيل فكم % بالحق من سابق منا ومقتصد % 16(@)(@@) % و جاء باليمن والإيمان يرشدنا % % بالنور من ظلمات الزيغ والنكد % 17(@)(@@) % له السموات والأرضون شاهدة % بمعجزات و آيات بلا عدد % 18(@)(@@) % تنأى عن الرمل والقطر الملث وعن % عد النبات وموج البحر والزبد % 19(@)(@@) % كم ذا أحن إلى ذاك الحبيب على % % بعدي وأمسي ضنين الوجد والسهد % 20(@)(@@) % أستودع الرب تسليمي إليه إذا % % جد الرحيل بهم عني وعن بلدي % % PageV01P156 21(@)(@@) % وكم وكمبيننا من مجهل درس % و من فراسخ لا تحصي ومن برد % 22(@)(@@) % يا نازلا بديار الشام لا تربت % يداك فاخر بمدح المصطفى تفد % 23(@)(@@) % و حي عني حبيب الزائرين ولا % تضع وديعة واهى الصبر والجلد % 24(@)(@@) % واردد عليه سلاما لا انتهاء لها % % كرمل عالج أضعافا وزد وزد % 25(@)(@@) % و قل لأشرف خلق الله مرتبة % و من تبوأ مجدا غير منجحد % 26(@)(@@) % ماذا تعامل يا شمس النبوة من % أضحى إليك من الأشواق في كمد % 27(@)(@@) % فامنع جناب ضريح لا صريخ له % نائى المزار غريب الدار مبتعد % 28(@)(@@) % حليف ودك واهى الصبر منتظر % لغارة منك ياركنى ويا عضدي % % 29(@)(@@) % أسير ذنبي وزلاتي ولا عمل % أرجو النجاة به إن أنت لم تجد % 30(@)(@@) % قرعن أيام دهري قوتي فوهت % عراي من محن تجري إلى الأمد % PageV01P157 31(@)(@@) % وضاق ذرعي لأحوال منكرة % لدي أعظم أن أشكو إلى أحد % 32(@)(@@) % ما زال يحسدني دهري على نعم % و الحر ما عاش لا يخلو عن الحسد % 33(@)(@@) % كم من خطوب إلى الدنيا أعدلها % % حسن اعتنائك بي مع قلة المدد % % 34(@)(@@) % فاقبل بفضلك إذلالي ومعذرتي % % و قو ضعفي 
ms51	 بفضل فائض رغد % 35(@)(@@) % وانظر إلي بعين منكمشفقة % و قم بحالي ولاطفني وجد وعد % 36(@)(@@) % و حل عقدة كربي يا محمد من % هم على خطرات القلب مطرد % 37(@)(@@) % أرجوك في سكرات الموت تشهدني % % كيما يهون إذ الأنفاس في صعد % 38(@)(@@) % و إن نزلت ضريحا لا أنيس به % فكن أنيس وحيد فيه منفرد % 39(@)(@@) % حتى إذا نشر الأموات يوم غد % و كل نفس رأت ما قدمت لغد % 40(@)(@@) % والحق يحكم والأعضاء شاهدة % و النار تؤصد للطاغين في عمد % PageV01P158 41(@)(@@) % فكن دليلي بحسن الستر منك إلى % % لواء حمد بظل العرش منعقد % 42(@)(@@) % قل أنت منا على ما كان منك فجز % على الصراط وهذا حوضنا فرد % 43(@)(@@) % و كن رفيقي في دار السلام إذا % % كنا بمقعد صدق جيرة الصمد % 44(@)(@@) % وارحم مؤلفها عبد الرحيم ومن % يليهمن أهله وانعشه وافتقد % 45(@)(@@) % إذا استعدت له الأعداء قاصدة % أعد حبك منهم أمنع العدد % 46(@)(@@) % و إن دعا فأجبه واحم جانبه % من حاسد شامت أو ظالم نكد % 47(@)(@@) % فلما بلينا بمكروه نساوره % إلا استندنا بركن منك معتمد % 48(@)(@@) % و لا سلكنا سبيبلا نرتجيك به % إلا وجدناك للراجين بالرصد % 49(@)(@@) % صلى عليك إلهي يا محمد ما % % تنوعت نغمات الطائر الغرد % 50(@)(@@) % تحية كشعاع الشمس طيبة % تستغرق الأمد الجاري إلى الأبد % PageV01P159 51(@)(@@) % يندي على الآل والأرواح عارضها % % و الصحب من نسمات الند كل ندي % % PageV01P160 البحر : - 1(@)(@@) % أنسمة طيب أم صبا طيبة هبا % % سحيرا دعى قلبي فأسرع مالبى % % 2(@)(@@) % و طلعة نور التم أم نور أحمد % تشعشع حتى شق ساطعه التربا % % 3(@)(@@) % فذانكزادانيسرورا وأفرجا % % هموميوحلا عن عرا كبدي كربا % % 4(@)(@@) % و هيهات ما كل النسيم حجازيا % و لا كل نور يبهج الشرق والغربا % % 5(@)(@@) % لسكان تلك الأرض عهد مؤكد % لدى وخير العهد ما أنصب الحبا % % 6(@)(@@) % ومازلت أستسرى النسيم لأرضهم % على بعد دارينا وأستمطر السحبا % % 7(@)(@@) % تذكرني الأشواق من لست ناسيا % فتجري دموعي في محاجرها صبا % % 8(@)(@@) % فيالى من الذكرى ويالي من الهوى % % و يادمع ما أجرى ويا قلب ما 
ms52	 أصبى % % 9(@)(@@) % خليلي من حبي كأن يرعكما % % رحيل فريق فارقوا الهائم الصبا % % 10(@)(@@) % فأصبح لا عهد قريب بهم ولا % طليعة علم عنهم تشرح القلبا % % PageV01P161 11(@)(@@) % دعته حمامات الحمى للبكا فلم % تدع إذ تداعت في الأراك له لبا % % 12(@)(@@) % و أثمله مر النسيم فما درى وما ذاك إلا رواح روضة جنة ثوى في ثراها سيد العرب العربا % % أنسمة طيب أم صبا طيبة هباسقط بيت ص % % 13(@)(@@) % نبي هدى من ضل منا بهديه % و أدرك بالتوحيد من يعبد النصبا % % 14(@)(@@) % رجونا به من ظلمة الظلم رحمة % فمد علينا ظل حلته الغلبا % % 15(@)(@@) % و مازال يدعونا إلى الله وحده % إلى أن رضينا الله سبحانه ربا % % 16(@)(@@) % و لولاه ما كان الوجود بموجد % و لا أرسل الرحمن رسلا ولا نبا % % 17(@)(@@) % فما اشتملت أرض على مثل أحمد % ولا استودع الرحمن رحما ولا صلبا % % 18(@)(@@) % تظافرت الأخبار من قبل بعثه % بأن يظهر الرحمن أعلى الورى كعبا % % 19(@)(@@) % و بشرنا موسى وعيسى بن مريم % به ومن الأحبار من قرأ الكتبا % % 20(@)(@@) % فلما استقلت أمه حمله رأت % به بركات من عديد الحصى أربى % % PageV01P162 21(@)(@@) % و أهبطت الأملاك ليلة وضعه % و ناداه من في الكون رحبا به رحبا % % 22(@)(@@) % و نكست الأصنام في كل وجهة % و غلتيد الشيطان تبا له تبا % % 23(@)(@@) % و أخمدت النيران في أرض فارس % و كل يهود الشام قد عدموا خبا % % 24(@)(@@) % و لاح شعاع النور في شعب مكة % فقامت رجال الحق تستبق الشعبا % % 25(@)(@@) % فلما رأوه أكبروه وفاخرت % بطلعته البطحاء أفق السما عجبا % % 26(@)(@@) % و رأوا منه ملء العين طفلا مباركا % يناسب غرا من بني غالب غلبا % % 27(@)(@@) % ولم ينكروا من آل وهب بن زهرة % خؤولتهم إذ كان أكرمهم وهبا % % 28(@)(@@) % فلاقت قريش منه أيمن طائر % و أسعد فال وانثنى جدبها خصبا % % 29(@)(@@) % و جلل أهل الشرق والغرب أنعما % يقل مداد البحرعن حصرها كتبا % % 30(@)(@@) % وعلم أهل الرشدذكرا مباركا % حوى الزجر والأحكام والفرض والندبا % % PageV01P163 31(@)(@@) % و بالغ في الإنذار حتى إذا عتت % عليه 
ms53	 رجال الشرك خاطبهم حربا % % 32(@)(@@) % و مازال حتى فل شوكة بأسهم % و أبدلهم بالسيف من أمرهم رعبا % % 33(@)(@@) % و حل بلطف الله عقدة عزهم % و ذلك حين استعمل الطعن والضربا % % 34(@)(@@) % ولم يبق للكفار حصنا ممنعا % و لا مسلكا وعرا ولا مرتقى صعبا % % 35(@)(@@) % فكان فتى الطاغين في كل بلدة % و منتجع الراجين في السنة الشهبا % % 36(@)(@@) % يباري هبوب الريح جود يمينه % إذا ما شمال الشام ناوحت النكبا % % 37(@)(@@) % لئنكان إبراهيمخصبخلة % فهذا نبي أوتى القرب والحبا % % 38(@)(@@) % و إن كان فوق الطور موسى مكلما % فأحمد جاز السبع واخترق الحجبا % % 39(@)(@@) % و إن فجر النبوع موسى من الصفا % % فأحمد أروى من أنامله الركبا % % 40(@)(@@) % و إن كلم الأموات عيسى ابن مريم % فأحمد في يمناه سبحت الحصبا % % PageV01P164 41(@)(@@) % لقد فضل الأملاك والرسل رفعة % عليهم وساد الجن والعجم والعربا % % 42(@)(@@) % ألم ترأن الأنبياء جميعهم % عليه يحيلون الشفاعة في العقبى % % 43(@)(@@) % فما أحد منهم يقولأنالها % % سواه وأي ينتهى مثله قربا % % 44(@)(@@) % غداة ترى من تحت ظل لوائه % حبيبا وحوضا طيبا باردا عذبا % % 45(@)(@@) % عليك سلام الله عد بكرامة % لمن لا يرى غير الذنوب له كسبا % % 46(@)(@@) % و قل أنت يا عبد الرحيم غدا معي % % بحضرة قدس عند من يغفر الذنبا % % 47(@)(@@) % و كن من أذى الدارين حصنى فانني % % أعدك لي من كل نائبة حسبا % % 48(@)(@@) % و مهما تناءت عنك داري فإنني % % لأصبح يا شمس الهدى جارك الجنبا % % 49(@)(@@) % فما كان عودي إذ حججت ولم أعد % إليك جفاء لا ومن فلق الحبا % % 50(@)(@@) % و لكن تصاريف الزمان عجيبة % و أنت إذا استعتبت أجدر بالعتبى % % PageV01P165 51(@)(@@) % فصل حبل مدحي فيك واقبل وسيلتي % % لأدرك حسانا بفضلك أو كعبا % % 52(@)(@@) % و أكرم معي نسلي وأهلي وجيرتي % % و سالف آبائي وصحبي وذا القربى % % 53(@)(@@) % و صلى عليك الله ماذر شارق % و ما ابتهجت في الليل أفق السما شهبا % % 54(@)(@@) % صلاة وتسليما عليك ورحمة % مباركة تنمو فتستغرق الحصبا % % 55(@)(@@) % تخصك يا مولاي حيا وميتا % و تشمل في تعميمها الآل والصحبا 
ms54	 % % PageV01P166 البحر : - 1(@)(@@) % أرى برق الغوير إذا تراءى % % بأقصى الشام زودني بكاء % 2(@)(@@) % و ماعبر الصبا النجدي إلا % ليمطر ناظري دما وماء % 3(@)(@@) % تقسمني الهوى العذري هما % % وسقما لا أرى لهما دواء % 4(@)(@@) % و أمرضني الطبيب فيا لقومي % % طبيب زادني بدواه داء % 5(@)(@@) % فما للعاذلين وطول عذلي % % جعلت لمن أحبهم فداء % 6(@)(@@) % أكاتم عنهم عبرات وجدي % % و أختلق السلو لهم رداء % 7(@)(@@) % مضت أيام جيرتنا بنجد % فأصبح كل ما وهبت هباء % 8(@)(@@) % أمنكر الإخاء بغير جرم % علام وفيم تنكرني الإخاء % 9(@)(@@) % فدعني والذين أرى حياتي % % و موتي بعد ما رحلوا سواء % 10(@)(@@) % بحقك هل سألت حلول نجد % ألم يجدوا لفرقتنا التقاء % PageV01P167 11(@)(@@) % و هل لك بالخبا المضروب علم % فتعلمني بمن ضرب الخباء % 12(@)(@@) % بقيت أسائل الركبان عمن % أقام بذي الأراك ومن تناءى % % 13(@)(@@) % و في أكناف طيبة هاشمي % تصرفه السماحة حيث شاء % 14(@)(@@) % إمام المرسلين ومنتقاهم % حوى الخيرات ختما وابتداء % 15(@)(@@) % تناهى فخر كل أخى فخار % و لن تلقى لمفخرة انتهاء % 16(@)(@@) % كفته كرامة المعراج فضلا % بها في القرب ساد الأنبياء % 17(@)(@@) % سرى من مكة ببراق عز % لأقصى مسجد وعلا السماء % 18(@)(@@) % مفتحة له الأبواب منها % % يجاوزها إلى العرش ارتقاء % 19(@)(@@) % فسر به الملائكة ابتهاجا % و صلى خلفه الرسل اقتداء % 20(@)(@@) % و كلم ربه من قاب قوس % و ألهم في تحيته الثناء % PageV01P168 21(@)(@@) % فقال الله عز وجل سلني % % فلست أشاء إلا أن أشاء % 22(@)(@@) % خزائن رحمتي لك فاقض فيها % % بحكمك لست أمنعك العطاء % 23(@)(@@) % و شفعه الإله بكل عاص % و كل مقصر يخشى الجزاء % 24(@)(@@) % وشرفه على الثقلين قدرا % و حقق في المعاد له الجزاء % 25(@)(@@) % نبي ما رأته الشمس إلا % % وكلت من محاسنه حياء % 26(@)(@@) % عظيم إن تواضع عن علو % كبير ليس يرضى الكبرياء % 27(@)(@@) % حوى جمل الكلام فقال صدقا % و أحسن في السؤال وما أساء % 28(@)(@@) % أبادبدينه الأديان حقا % و كانت قبل زورا وافتراء % 29(@)(@@) % زمامصوافن شهدت مغاز % وحد صوارم قطرت دماء % 30(@)(@@) % سيد سادة في كل ثغر % يروى 
ms55	 البيض والأسل الظماء % PageV01P169 31(@)(@@) % فلا برح الغمام يصوب أرضا % دفنا الجود فيها والسخاء % 32(@)(@@) % و ذلك خير من حملته أم % و من لبس العمامة والرداء % 33(@)(@@) % أنخ بجنابة الأنضاء وابذل % لزائره المودة والصفاء % 34(@)(@@) % وقل للركب إن هجعوا فإني % % أرى برق الغوير إذا تراآى % % 35(@)(@@) % أما جبريل روح الله وجدا % بمن تحت الكسا ورد الكساء % 36(@)(@@) % نحن لذكره طربا وشوقا % فتحسبنا تساقينا الطلاء % 37(@)(@@) % و ما لى لا أحن إلى حبيب % ثملت براح مدحته انتشاء % 38(@)(@@) % رسول الله أعلى الناس قدرا % و أكرمهموأزحمهم فناء % 39(@)(@@) % من اختار الوسيلة في المعالي % % و من أوتى الوسيلة واللواء % 40(@)(@@) % شفيع المذنبين أثقل عثاري % % فإنك خير من سمع النداء % PageV01P170 41(@)(@@) % دعوتك بعد ما عظمت ذنوبي % % و ضاع العمر فاستجب الدعاء % 42(@)(@@) % و من لي أن أزورك بعد بعد % صباحا يا محمد أو مساء % 43(@)(@@) % و ألثم تربة نفحتعبيرا % و أنظر قبة ملئت ضياء % 44(@)(@@) % و إن كنت المصر على المعاصي % % فكن للداء من ذنبي دواء % 45(@)(@@) % و هب لي منك في الدارين فضلا % و أوردني من الحوض ارتواء % 46(@)(@@) % وصل عبد الرحيم ومن يليه % بحبل الأنس واكفهم البلاء % 47(@)(@@) % جزاك الله عنا كل خير % و زادك يا ابن آمنة سناء % 48(@)(@@) % عليك صلاة ربك ما تبارت % صبا نجد نسيما أو رخاء % 49(@)(@@) % و لا برحت تحياتيتحيي % % صحابتك الكرام الأنقياء % PageV01P171 البحر : - 1(@)(@@) % كلام بلا نحو طعام بلا ملح % و نحو بلا شعر ظلام بلا صبح % 2(@)(@@) % و من يتخذ علما ويلغمها يعد % بلا رأس مال في الكلام ولا ربح % 3(@)(@@) % إذا شرحوا فضل العلوم فإنني % % غني بفضل النحو عن ذلك الشرح % 4(@)(@@) % يليق الخطاب اليعربي بأهله % فيهدي الوفا بالنص والحسن للقبح % 5(@)(@@) % و من شرف الأعراب أن محمدا % أتى عربي الأصل من عرب فصح % 6(@)(@@) % و أن المثاني أنزلت بلسانه % بما خصصته في الخطاب من المدح % 7(@)(@@) % يكون محال الشعر وصفا لغيره % و يكفيه ما في سورة الشرح والفتح % 8(@)(@@) % نبي دعاه المذنبون وهم على 
ms56	 % % شفا جرف هار فمد يد الصفح % 9(@)(@@) % و أحيا منار الدين في كل وجهة % و ذب عن الإسلام بالسيف والرمح % 10(@)(@@) % و أيام غارات تظل بها القنا % % محطمة والخيل مشتدة الضبح % PageV01P172 11(@)(@@) % و كم في عيون الغي بالرشد من قذى % % و كم في فؤاد الشرك من كبد نزح % 12(@)(@@) % محا نوره المشهور نار عنادهم % وهد بطود الهدى منهدم الصرح % 13(@)(@@) % و قل جهادا شوكه الشرك إذ دعا % % كباش جهاد المشركين إلى الذبح % 14(@)(@@) % و هدم رسم الكفر بالسيف عنوة % % وأودع ذات البين داعية الصلح % 15(@)(@@) % و مازال يدعونا بتوفيق ربنا % % إلى الملة الغراء والمذهب السمح % 16(@)(@@) % إذا خابت الآمال فانزل بطيبة % وزر قبرها تظفر هنالك بالنجح % 17(@)(@@) % نضجت لظى ذنبي بلذة ذكره % فأطفأت نار الذنب بالذكر والنصح % 18(@)(@@) % مكين إذا استنصرته أو عودته % لخطب أتاك الغوث أسرع من لمح % 19(@)(@@) % ولي لمن والى شديد على العدا % % عطوف على العافين ذو خلق سجح % 20(@)(@@) % حوى الشرف الأعلى بمجد مؤثل % منيف وأحساب مهذبة وضح % PageV01P173 21(@)(@@) % ورفعة قدر زانها طيب عنصر % و طول يد أندى من العارض السح % 22(@)(@@) % و عز جناب مخضر السوح دائما % إذا اغبرت الآفاق منحصر السوح % 23(@)(@@) % تلوح عليه شيمة هاشمية % جلال أبيه البر أو عمه اللح % 24(@)(@@) % خلاصة سر السر من عز غالب % أولى الفضل لاشهم ولا جمح الجمح % 25(@)(@@) % تسلل في الأصلاب من عهد آدم % فسار مسير الشمس في طالع النطح % 26(@)(@@) % و أشرق في شرق البلاد وغربها % % سناه وما أبقى إلى الشرك من جنح % 27(@)(@@) % إليك رسول الله جاءت بسرعة % قلوب من الأشواق داعية الفرح % 28(@)(@@) % فأنت الذي لولاك ما كان كائن % و لا كر من ليل بهيم ولا صبح % 29(@)(@@) % كفاك علا أن الجمادات سلمت % عليك الغمام الهاطلات من اللفح % 30(@)(@@) % و كم لمست يمناك ذا المس فانثنى % % صحيحا وداوت معضل الداء بالمسح % PageV01P174 31(@)(@@) % و سليت محزونا وأرشدت غاويا % و أشفيت من سقم وأبرأت من جرح % 32(@)(@@) % عساك رسول الله تقبل عذر من % يظل ويمسي 
ms57	 في الذنوب كما يضحى % % 33(@)(@@) % يناديكمن نيابتيبرع فقد % كبا زنده في الصالحات عن القدح % 34(@)(@@) % فشد عرى عبد الرحيم وسر به % بمرحمة واغلل يد الضيق بالفسح % 35(@)(@@) % و إن خضت في بحر الذنوب جهالة % فعطفك يا فرد الجلالة بالصفح % 36(@)(@@) % فبي فاقة للجود منك وللندى % % كفاقة ظمآن صدى إلى الرشح % % 37(@)(@@) % و إني إذا ضاقت وجوه مطالبي % % أسير بآمال إلى بابك الفسح % 38(@)(@@) % فصني لمدحي فيك واقبل وسيلتي % % إليك وقم بي في معادى وفي منحي % % 39(@)(@@) % و صل حبل راويها وأرحامه غدا % إذا طرحوا في النار مستوجب الطرح % 40(@)(@@) % وصلى عليك الله ما هبت الصبا % % و ما اعتقبت رأد الضحى عذب السفح % PageV01P175 41(@)(@@) % صلاة تبارى الريح مسكا وعنبرا % و تزرى بنور النور في طلع ذي الطلح % PageV01P176 البحر : - 1(@)(@@) % أراني ما ذكرت لك الفراقا % % و دمعك واقف إلا هراقا % % 2(@)(@@) % بلحظك لا هجرت وأي لحظ % أراق دمي وأي دم أراقا % % 3(@)(@@) % لقد طال المطال على لولا % % خيالك زار مضجعي استراقا % % 4(@)(@@) % و ما شي بأعظم من جسوم % % مفرقة وأرواح تلاقى % % 5(@)(@@) % فكم سمح الهوى بدمي ودمعي % % و كلفني بكم ولها وشاقا % 6(@)(@@) % و أمرضني وأضرم نار وجدي % % و ذلك مذهب الحب اتفاقا % % 7(@)(@@) % و لو كان الهوى العذري عدلا % لحمل كل قلب ما أطاقا % % 8(@)(@@) % إذا هب الصبا النجدي وهنا % بريح الرند أطربني انتشاقا % % 9(@)(@@) % و لم أهو الكثييب وساكنيه % و لا مصر الخصيب ولا العراقا % % 10(@)(@@) % و لا شوقي لكاظمة ولكن % إلى من ساد أمته وفاقا % % PageV01P177 11(@)(@@) % محمد المخصص باسم أحمد % من المحمود كان له اشتقاقا % % 12(@)(@@) % إمام المرسلين ومنتقاهم % و أكرمهم وأطهرهم نطاقا % % 13(@)(@@) % نبي أنزل الرحمن فيه % تبارك والضحى والانشقاقا % % 14(@)(@@) % كتابا ذا صراط مستقيم % مبين لا افتراء ولا اختلاقا % % 15(@)(@@) % فلا برح الغمام يجود أرضا % نرى لضياء قبتها ائتلاقا % % 16(@)(@@) % بها شمس تفوق الشمس نورا % و بدر يلبس البدر المحاقا % % 17(@)(@@) % هو الكرم الذي ملأ البرايا % % هو العلم الذي ركب البراقا % % 18(@)(@@) % نبي لم يزل يسمو علوا 
ms58	 % إلى أن جاوز السبع الطباقا % % 19(@)(@@) % نضاهاللهللإسلام سيفا % أزال به الضلالة والنفاقا % % 20(@)(@@) % فكان لأهل دين الله عزا % و للهيجاء حين تقوم ساقا % % PageV01P178 21(@)(@@) % أباد المشركين بكل ثغر % و قاد الخيل شاذبة وساقا % % 22(@)(@@) % و فرق شوكة الفرق الطواغي % % و أروى منهم القضب الرقاقا % % 23(@)(@@) % و أقدم والصوافن صافنات % و قد ضرب العجاج لها رواقا % % 24(@)(@@) % و عادت شامخات الفكر وهدا % و أمشى فوقه الخيل العتاقا % % 25(@)(@@) % و من على الأساري يوم بدر % وفادى بعد ما شدالوثاقا % % 26(@)(@@) % و عم الخلق مكرمة وجودا % فلماجادفارقما أذاقا % % 27(@)(@@) % أتقبل يا محمد عذر عبد % يحن إليك من برع اشتياقا % % 28(@)(@@) % حججت ولم أزرك لسوء حظي % % و عبد السوء يعتاد الإباقا % % 29(@)(@@) % و من لي أن أسلم من قريب % و ألتثم التراب ولو فواقا % % 30(@)(@@) % و أنظر قبة ملئت جمالا % و أشبع من جوانبها عناقا % % PageV01P179 31(@)(@@) % أتاك الزائرون من النواحي % % يحثونالسوابقو النياقا % % 32(@)(@@) % و عاقتنيذنوبي عنك فاعلم % بأن الذنب أوقفني وعاقا % % 33(@)(@@) % فصل عبد الرحيم بحبل جود % تعمبهالأحبة والرفاقا % % 34(@)(@@) % أتيتك سيدي بالعذر فاعطف % على إذا الفضاء علي ضاقا % % 35(@)(@@) % قصرت خطاي عنك من الخطايا % % و ذنبي لم أطق معه انطلاقا % % 36(@)(@@) % فكن ظلي غدا و شفيع ذنبي % % و حوضك فاسقني منهدهاقا % % 37(@)(@@) % و آنسبالقبول غريب لفظي % % و نفس عن مؤلفهالخناقا % % 38(@)(@@) % فقد ملكتني الأوزار عبدا % و لكني رجوت بك العتاقا % % 39(@)(@@) % و كيف يخاف لفح النار مثلي % % وجار حماك لم يخف احتراقا % % 40(@)(@@) % عليك صلاة ربك ما تبارت % رياح الجو تستبقاستياقا % % PageV01P180 البحر : - 1(@)(@@) % ضربوا الخيام على الكثيب الأخضر % ما بين روضة حاجر ومحجر % 2(@)(@@) % و تفيؤا في الأرض ظلا وارتووا % % من مائه المتسجم المتفجر % % 3(@)(@@) % و اخضر فردوس الخمائل إذ غدا % % و سرى عليه حيا العريض الممطر % % 4(@)(@@) % فكأن لؤلؤ ظله رأد الضحى % % درر متى تسري النسائم تنثر % 5(@)(@@) % أوما ترى عذبات بانات اللوا % % ترتاح روح نسيمها المتعطر % % 6(@)(@@) % ولع البشام بنفحة نجدية % تغشى الرياض بعنبر ومعنبر % 7(@)(@@) % إن النفوس على اختلاف طباعها 
ms59	 % % طعمت من الدنيا بما لم تظفر % 8(@)(@@) % و على الكريم دلالة عذرية % بصرت به فأرته ما لم ينظر % 9(@)(@@) % يا نازلا بربا الأراك عداك ما % % حملت منولهي وطول تذكري % % 10(@)(@@) % سل جيرة الجرعى غداة غدت بهم % نزل الركائب في الفريق المصحر % PageV01P181 11(@)(@@) % هل جددوا عهدا بمعهد رأمة % أم طنبوا في الشعب شعب العوعر % 12(@)(@@) % لله در العيس وهي رواسم % بمروح ومصبح و مهجر % 13(@)(@@) % يخرقن من حجب السراب سرادقا % ما بين طيبة والمقام الأكبر % 14(@)(@@) % و يلجن في لجج الظلام ضوامرا % شوقا إلى المزمل المدثر % 15(@)(@@) % الأبطحي المنتقى من غالب % و الطاهر الطهر البشير المنذر % 16(@)(@@) % الصادق الهادي الأمين المجتبى % % و السابق المتقدم المتأخر % 17(@)(@@) % وابن العواتك من سليم إنه % ذو الفخر إجماعا ومن لم يفخر % 18(@)(@@) % ملأت محاسنه الزمان وأشرقت % بوجوده الأكوان فاسمع وانظر % 19(@)(@@) % و تتابعت نعم به وتطاولت % رتب تناهى في عراض المشتري % % 20(@)(@@) % هذا منارك يا محمد مذ سما % % طلعت طلائعه بنور النير % PageV01P182 21(@)(@@) % كم نازعتك الفخر سادة مكة % حسدا وهل صدف يقاس بجوهر % 22(@)(@@) % و لأنت سر المرسلين وخير من % وطيء الثرى من منجد ومغور % 23(@)(@@) % ضربت رواق العز دونك هيبة % قصمت عرا المتكبر المتجبر % 24(@)(@@) % وسمعت نجومك بالسعود وأشرقت % شمس الوجود بحظك المتوفر % 25(@)(@@) % وأرتك أنوار النبوة ما انطوى % % في الكون من مكنون سر مضمر % 26(@)(@@) % ووقتك من لفح السموم غمائم % مبسوطة من فوق بدر مزهر % 27(@)(@@) % و عليك سلمت الغزالة مذ رأت % بك من بديع الحسن أكمل منظر % 28(@)(@@) % وأوا بد الوحش الكوانس في الفلا % % نادتك باسم معرف لم ينكر % 29(@)(@@) % و ببطن كفكسبحت صم الحصى % % و كذاك حن الجذع يوم المنبر % 30(@)(@@) % و نبت عليك العنكبوت بنسجها % % في الغار توهم أن منهجه بري % % PageV01P183 31(@)(@@) % و غدت مغيرة لأثرك في الثرى % % و رق الحمام فعاد غير مؤثر % 32(@)(@@) % و جعلت شق البدر معجزة لمن % في الحي من بدو هديت وحضر % 33(@)(@@) % و لمدحك الوحى المنزل فصلت % آياته عن معجزاتك فاشكر % 34(@)(@@) % و مكارم 
ms60	 قد عمت الدنيا ندى % % و هدى وأخرى أخرت للمحشر % % 35(@)(@@) % فخر الجلالة والمهابة والعلى % % و شفاعة العقبى وحوض الكوثر % 36(@)(@@) % يا بهجة الدنيا وعصمة أهلها % % من كل خطب عابس متنكر % 37(@)(@@) % كن من أذى الدارين نصري واحمني % % و لنيل ما أرجوه موسم متجري % % 38(@)(@@) % واجعل مديحي فيك حبل تواصل % بيني وبينك يارفيع المفخر % 39(@)(@@) % قل أنت يا عبد الرحيم وكل من % واليته فيذمة لمتخفر % 40(@)(@@) % و لمن يليني صحبة ورحامة % بالخير يا خير العباد فبشر % PageV01P184 41(@)(@@) % وادرأ بصولك في نحور حواسدي % % أبدا وقم بي حيث كنت وشمر % 42(@)(@@) % و إذا دعوتك للملمة فاستجب % و إذا انتصرت بجاه وجهك فانصر % 43(@)(@@) % وعليك صلى الله ياعلم الهدى % % ما لاح ملتثم الصباح المسفر % 44(@)(@@) % و على المذهبة الكرام كواكب ال % % إسلام صحب الخير للمتخير % PageV01P185 البحر : - 1(@)(@@) % سجعت بأيمن ذى الأراك حمائمه % وهمت على عذب العذيب غمائمه % 2(@)(@@) % وسرى حجازي النسيم يعانق ال % % مخضر من أثلاته ويلائمه % 3(@)(@@) % فأجبت ساجع ورقهبمدامع % ذرفت على طلل درسن معالمه % 4(@)(@@) % سحبت سحاب الجو فيه ذيولها % % ومحاهمن غدق الحيا متراكمه % 5(@)(@@) % وتضاحكتأنواره وتنوعت % أزهاره حين ابتسمن كمائمه % 6(@)(@@) % وتنكرت أعلامه وربوعه % وتفرقتهنداتهوفواطمه % 7(@)(@@) % يالائميفيمنكلفت فلم أفق % عن لوم صب أمرضته لوائمه % 8(@)(@@) % وأبيك ما أنصفت في عذلي ولا % علمت قلبي غيرماهو عالمه % 9(@)(@@) % الحب ماأجرى الدموع صبابة % وأباح سرا ما برحتأكاتمه % 10(@)(@@) % وأنا الذيلعب الفراقبعقله % لما تناءتبالفريق رواسمه % PageV01P186 11(@)(@@) % يحدوا الحجاز على الحمى وخلا الحمى % % من بعده عقداته وصائمه % 12(@)(@@) % فسقى الحجاز حيا الغمامةكلما % % تبكيسحائبه ويضحك باسمه % 13(@)(@@) % بلد أضاءت من ضياء محمد % أحزانه ونجوده وتهائمه % 14(@)(@@) % و تطاولت رتب الفخارلمن دنا % % لعلاه إكليل العلا ونعائمه % 15(@)(@@) % علم النبوة خاتم الرسل الذي % % ملأت جميع العالمين مكارمه % 16(@)(@@) % سيف حمائله على عنق الهدى % % و بكف أخيار الخليقة قائمه % 17(@)(@@) % لما دعا الكفار بالبيض الظبا % % لبته من جند الضلال جماجمه % 18(@)(@@) % و محت نجوم الشرك شمس ظهوره % و تتابعت في الملحدين ملاحمه % % 19(@)(@@) % بعرمرم فيالخافقين غباره % صعدا وفي أذن السماك 