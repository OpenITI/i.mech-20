ms41	 دنى لقاب وأدنى % % آية الله نسخة الكون معنى % % PageV01P141 51(@)(@@) % حيطة الأصل نكتة الإيجاد % % 52(@)(@@) % سر باب العلى لكل نبي % % وإمام وسيد وولي % % 53(@)(@@) % وهو لما أتى بأمر علي % % قام جهرا بكل سر خفي % % 54(@)(@@) % وبكل الاشياء خاف وباد % % 55(@)(@@) % مد بسط الهدى بغرب وشرق % % وسرى يكشف الظلام بصدق % % 56(@)(@@) % فاصل بين مبطل ومحق % % عنده علم كل شيء بحق % % 57(@)(@@) % ومع العلم قوة استعداد % % 58(@)(@@) % ملجأ العبد حين فقد التحمل % % ومحل الرجا وباب التوصل % % 59(@)(@@) % كان في الغيب قبل هذا التنزل % % يتلقى من ربه كلمات % % 60(@)(@@) % العلم وهبا بعالم الإمداد % % PageV01P142 61(@)(@@) % قد أفاض الهدى بخلق جميل % % وبحبل من الكمال طويل % % 62(@)(@@) % وتسامى في شأنه عن مثيل % % فأتانا بكل شأن جليل % % 63(@)(@@) % وهدانا إلى الكريم الهادي % % 64(@)(@@) % اشرف العالمين طبعا وأصلا % % وأجل الوجود قولا وفعلا % % 65(@)(@@) % كم على الله بالدلائل دلا % % هو أقوى وسائل الخلق لله % % 66(@)(@@) % تعالى وحبل كل العباد % % 67(@)(@@) % وجهه عن حقائق الدين أسفر % % فجلاها بعد التخافي وأظهر % % 68(@)(@@) % فهو في الكائنات أعظم مظهر % % وهو ميزاب أنعم الله في الأرض % % 69(@)(@@) % لكل العباد والعباد % % 70(@)(@@) % فجر رشد وللقلوب طبيب % % وإمام مؤدب وأديب % % PageV01P143 71(@)(@@) % قو فيه الرجاء فهو حبيب % % وهو إن جاد فالمراد قريب % % 72(@)(@@) % وإذا رد عز نيل المراد % % 73(@)(@@) % جاء بالأمر هاديا ودليلا % % وصراطا لربنا وسبيلا % % 74(@)(@@) % فهو بالله كم أعز ذليلا % % وهو والله ما أخاب نزيلا % % 75(@)(@@) % لاذ فيه وقال أنت اعتمادي % % 76(@)(@@) % كيف حالي قد قطعتني القواطع % % وعن الباب أبعدتني الموانع % % 77(@)(@@) % لست أدري للوزر ما أنا صانع % % سيدي يا أبا البتول ويا نعم % % 78(@)(@@) % رسولا ويا طريق الرشاد % % 79(@)(@@) % يا حبيبا به المهيمن اسرى % % فطوى فيه من عطاياه سرا % % 80(@)(@@) % يا معين الورى إذ الناس سكرى % % يا مغيث الوجود دنيا وأخرى % % PageV01P144 81(@)(@@) % يا عروس الشهود يوم المعاد % % 82(@)(@@) % يا أمينا إلى الخفايا تدلى % % يا أمير على البرايا تولى % % 83(@)(@@) % يا سراجا بكل برج تجلى % % يا حبيب الديان يا حجة الله % % 84(@)(@@) % على الخلق يا طويل 
ms42	 النجاد % % 85(@)(@@) % يا مدار الامور في النشر والطي % % وعنان البرهان في دولة الحي % % 86(@)(@@) % يا ضياء الأكوان يا رافع الغي % % يا أبا المعجزات يا كاشف الغين % % 87(@)(@@) % عن العين يا رفيع العماد % % 88(@)(@@) % يا عطوفا وفي الشؤن عظيما % % وصراطا من الهدى مستقيما % % 89(@)(@@) % يا رؤفا ومنعما وكريما % % يا صفوحا عن مذنب ورحيما % % 90(@)(@@) % بمسيء أتى بحسن اعتقاد % % PageV01P145 91(@)(@@) % يا رحاب الرضا ويا خير مأمن % % ونبيا على الملوك تحنن % % 92(@)(@@) % يا ملاذا لذي الحوائج أحسن % % يا عريض الجاه العظيم ويا من % % 93(@)(@@) % أنت والله عروة الإعتضاد % % 94(@)(@@) % جد أغثني فقد تعاظم وزري % % والخطايا بالحمل أثقلن ظهري % % 95(@)(@@) % لك اشكو ضيعت بالجهل عمري % % قم برشدي من غير زيد وعمرو % % 96(@)(@@) % واحمني رحمة من الحساد % % 97(@)(@@) % ضاع وقتي لغفلتي بالتمني % % ومضت مدتي بسوء التأني % % 98(@)(@@) % فتحنن وجد ولا تلو عني % % وأعني على الزمان فإني % % 99(@)(@@) % ليس إلاك ملجئي وعمادي % % 100(@)(@@) % فك قيدي بنفحة ورضاء % % فيه أحمي من بلوة وعناء % % PageV01P146 101(@)(@@) % وتفضل تكرما بشفاء % % وتعطف وداوني بدواء % % 102(@)(@@) % فيه اشفي من علتي وبعادي % % 103(@)(@@) % منك أملت سيدي حسن وصل % % للمعالي فصل بفضك حبلي % % 104(@)(@@) % لا تخيب يا ملجأ الكون سؤلي % % واكفني الخطب والكروب وكن لي % % 105(@)(@@) % حاميا واجل لي ظلام فؤادي % % 106(@)(@@) % ولنهج الهدى بجودك سر بي % % واكفني البعد ثم أنعم بقربي % % 107(@)(@@) % وأصلح السر من كوامن قلبي % % وتحنن بنظرة تحيي لبي % % 108(@)(@@) % واراها صلاح أمر فسادي % % 109(@)(@@) % لي لاحظ فقد رايت زمانا % % ساء أهلا وقد جفا إخوانا % % 110(@)(@@) % فأثبني مولاي منك أمانا % % ثم قل أنت رحمة وحنانا % % PageV01P147 111(@)(@@) % لذ ببابي وكل بفضلي زادي % % 112(@)(@@) % لا تخف من مصائب التشتيت % % كل صيت أحرزته فضل صيتي % % 113(@)(@@) % في زمامي بيقظة ومبيت % % أنت عندي قبلت من أهل بيتي % % 114(@)(@@) % وبجودي دخلت في أولادي % % 115(@)(@@) % وتكرم بمأربي وتفضل % % بوصولي إلى حماك المفضل % % 116(@)(@@) % ذاك حي به القران تنزل % % فعساني إذا وصلت لذاك الرحب % % 117(@)(@@) % أحيي لأنني كالجماد % % 118(@)(@@) % أنت اصل المراد في كل شي % % وإمام السادات من 
ms43	 غير لي % % 119(@)(@@) % أبطحي ذو موكب يثربي % % أدرك أدرك أعين كل نبي % % 120(@)(@@) % وولي وملجأ الأوتاد % % PageV01P148 121(@)(@@) % أنت من عطرك الأنام تعطر % % وبمجلى ضيا سناك تنور % % 122(@)(@@) % أنت حصن إذا الوطيس بنا أحمر % % وملاذ الأملاك في ساحة العرش % % 123(@)(@@) % وميزاب فيضة الإسعاد % % 124(@)(@@) % يا عتادي بقطعتي واتصالي % % وعياذي من دهشة الأهوال % % 125(@)(@@) % جد بلطف وغوثة ونوال % % وتدارك بنفحة ووصال % % 126(@)(@@) % لمحب من الخطيئة صاد % % 127(@)(@@) % هائم فيك لا بزيد وعمرو % % ذو استناد إليك في كل أمر % % 128(@)(@@) % لائذ في حماك والدمع يجري % % شغله أنت لا سواك وتدري % % 129(@)(@@) % ذاك لا تبقه بسوق الكساد % % 130(@)(@@) % غاب عن ذي الإغيار كلا وبعضا % % علا مأموله ببابك يقضى % % PageV01P149 131(@)(@@) % راح يدعو وقد رآى الصدق فرضا % % يا رفيع الجناب حاشاك ترضى % % 132(@)(@@) % منع سؤلي وأنت كل مرادي % % 133(@)(@@) % حزت قدرا مطلسما بجلال % % ومحيا مجسما من جمال % % 134(@)(@@) % وتفردت في مقال وحال % % إن تفضلت لحظة بنوال % % 135(@)(@@) % فك لا شك من ذنوبي قيادي % % 136(@)(@@) % طال من خيفة الخطيئة نعيي % % وتحيرت بين أمر ونهي % % 137(@)(@@) % نظرة من رضاك للقلب تحيي % % لا تخيب يا اكرم الرسل سعيي % % 138(@)(@@) % وذهابي ونيتي واجتهادي % % 139(@)(@@) % ذكر علياك كل شغلي وفني % % وطريقي القويم من بدء سني % % 140(@)(@@) % فالتفت لي يا خير إنس وجني % % وتبصر بحالتي واعف عني % % PageV01P150 141(@)(@@) % ثم عجل تعطفا بافتقادي % % 142(@)(@@) % فيك قيدت مخلصا حسن ظني % % فتعطف بلفتة وأعني % % 143(@)(@@) % غاب رشدي وراح جهدي مني % % قل صبري وضاع فكري وإني % % 144(@)(@@) % طامع لم أزل بوصل ودادي % % 145(@)(@@) % ذهب العمر بين لهو ولهف % % وملال وترك زهد وخوف % % 146(@)(@@) % أنت والله بحر جود وعطف % % فامددن باعك الطويل بلطف % % 147(@)(@@) % واشف جرحي يا من تجيب المنادي % % 148(@)(@@) % أغن فقري تكرما بعطاء % % منك واحفظ حماي يوم قضاء % % 149(@)(@@) % وترحم واكشف ثقيل غطاء % % وتكرم على أبي برضاء % % 150(@)(@@) % منك واكرمه بالجمال البادي % % PageV01P151 151(@)(@@) % وأعنه بهمة وأمان % % وشهود بنظرة وعيان % % 152(@)(@@) % واكفه الهجر واحيه بتدان % % وأغثه بلفتة فهو فان % % 153(@)(@@) % فيك واطلقه من قيود البعاد % % 154 
ms44	(@)(@@) % وأجب بالقبول مولاي سؤالي % % رحمة واكفني بلية جهلي % % 155(@)(@@) % واجل سري فضلا بنور التجلي % % ولأمي وكل حزبي وأهلي % % 156(@)(@@) % صل بفضل وامنن على أولادي % % 157(@)(@@) % وأغثهم بكأس فيضة ري % % تحمهم من غشاء وهم وغي % % 158(@)(@@) % ولمن زارنا بنسبة زي % % وجميع الإخوان في كل حي % % 159(@)(@@) % حيث كانوا في الغور والأنجاد % % 160(@)(@@) % وأعنهم واحرس بفضل حماهم % % واكفهم شر من يريد أذاهم % % PageV01P152 161(@)(@@) % وإذا ما أتوا لنيل مناهم % % خذهموا بالقبول واقبل رجاهم % % 162(@)(@@) % واحمهم واهدهم إلى الإرشاد % % 163(@)(@@) % وابدل الإنقطاع منهم بوصل % % وبعلم ما كان من وهم جهل % % 164(@)(@@) % واعنهم بنور سر وعقل % % واكرم المسلمين طرا بفضل % % 165(@)(@@) % منك واحرسهمو من الأوغاد % % 166(@)(@@) % ثم صنهم إن حل مدهش خطب % % ومهم أو مس وارد كرب % % 167(@)(@@) % وامنح الكل بعد بعد بقرب % % وصلاة الرحمن من لب قلب % % 168(@)(@@) % مستهام بل من صميم الفؤاد % % 169(@)(@@) % تتوالى بجيش نصر وفتح % % وارتقاء وطول باع وربح % % 170(@)(@@) % بالعنايات ما انجلى فرق صبح % % لك تهدي مع السلام بمنح % % PageV01P153 171(@)(@@) % اقدسي ما حن في الركب حاد % % 172(@)(@@) % تنجلي دائما بثوب أمان % % وجمال وحسن رفعة شان % % 173(@)(@@) % ونراها مع الرضا بمعان % % تتدلى في كل وقت وآن % % 174(@)(@@) % باتصال من باب هاد لهاد % % 175(@)(@@) % وتعم الشذا بشرق وغرب % % فتتم الهدى لكل محب % % 176(@)(@@) % وعليك الرضوان من فيض ربي % % وعلى آلك الكرام وصحب % % 177(@)(@@) % وعلى الأولياء والأفراد % % 178(@)(@@) % وعلى من لهم منحت بعطف % % فأعينوا من الإله بلطف % % 179(@)(@@) % ونسيم الأمان من كل خوف % % والتحيات ما دعاك بلهف % % 180(@)(@@) % وخشوع أبو الهدى الصيادي % % PageV01P154 البحر : مديد تام 1(@)(@@) % لاحظ المسكين بالمدد % % يا رسول الواحد الأحد % % 2(@)(@@) % يا عريض الجاه يا سند العاجز % % المحتاج للسند % % 3(@)(@@) % يا سراج الرسل يا قمر الأنبياء % % يا كوكب الرشد % % 4(@)(@@) % يا إمام المرسلين ويا % % تاج هام القادة العمد % % 5(@)(@@) % أنت ذخري والغياث إذا % % ضاق رحبي أو وهي جلدي % % 6(@)(@@) % أنت عوني والمساعد إن % % قد لي سيف النوى كبدي % % 7(@)(@@) % ألتجي في باب أمنك من % % هم هذا الدهر والنكد % % 8(@)(@@) % ومن 
ms45	 الآلام والمحن الددهم % % والأعداء والعدد % % 9(@)(@@) % يا أجل العالمين أغث % % بلطيف الحل للعقد % % 10(@)(@@) % فذنوبي قد طمت ونما % % نقطها عن حيطة العدد % % PageV01P155 11(@)(@@) % ولهذا خانني زمني % % ودهتني عصبة الحسد % % 12(@)(@@) % ودموعي للمصائب قد % % أغرقت واحسرتي جسدي % % 13(@)(@@) % وهمومي أوهنت هممي % % فأجرني أنت معتمدي % % 14(@)(@@) % يا أبا الزهراء يا أمل المرتجي % % يا حجة الصمد % % 15(@)(@@) % يا طويل الباع يا أسد الغيب % % يا علامة الأبد % % 16(@)(@@) % يا كتابا كنز حكمته % % قد علا عن طارق الرصد % % 17(@)(@@) % وبه الأسرار قد طويت % % بين منحل ومنعقد % % 18(@)(@@) % وسما في شأن دولته % % عن أب عال وعن ولد % % 19(@)(@@) % وهو بحر ضمن زبدته % % كل بحر عائم الزبد % % 20(@)(@@) % ليس في الدنيا وضرتها % % دونه للناس من أحد % % PageV01P156 21(@)(@@) % ذاك باب الله باب رجا % % كل ملهوف ومعتضد % % 22(@)(@@) % عين أعيان الوجود حمى % % خائف ناداه يا سندي % % 23(@)(@@) % جئت ارجو منك مد يد % % لا تضيعني وخذ بيدي % % 24(@)(@@) % رحمة الله التي وسعت % % كل شيء خير معتقدي % % 25(@)(@@) % لوح عرفان دقائقه % % نقشت في هيكل الأبد % % 26(@)(@@) % وصراط عنده وقفت % % بسلوك عدة المدد % % 27(@)(@@) % فانطوى في ظل ساحته % % شمخ هام الفيل والأسد % % 28(@)(@@) % لذت فيه والذنوب كستني % % بأثواب العنا الجدد % % 29(@)(@@) % ولعلياه التجأت ولي % % مقلة تجري من الكمد % % 30(@)(@@) % ورجائي أن يمن على % % غصتي بالعيش ذي الرغد % % PageV01P157 31(@)(@@) % وبأنواع القبول إذا % % جئت في فعل لدي ردي % % 32(@)(@@) % وبعطف فيه تحصل لي % % نفحة الباري بخير يد % % 33(@)(@@) % ويفضل من مواهبه البيض % % تعلو للسما عمدي % % 34(@)(@@) % وبلطف جيش دولته % % قاتل من قصده نكدي % % 35(@)(@@) % وبإحسان حقيقته % % كفها بالمكرمات ندي % % 36(@)(@@) % وصلاة الله جارية % % من مدار الرحمة الأبدي % % 37(@)(@@) % وسلام مسك وارده % % وارد من حضرة المدد % % 38(@)(@@) % لحبيب الله أحمد خير % % البرايا السيد السند % % 39(@)(@@) % ولأهل البيت سادتنا % % والصحاب السادة الأسد % % PageV01P158 البحر : كامل تام 1(@)(@@) % لله من ريم الحجون شرود % % لهفا عليه هجرت طيب رقودي % % 2(@)(@@) % يرنو ويرمي من قسي حواجب % % نبل الجفون بقلبي المكمود % % 3(@)(@@) % أفديه مكحولا تحكم سهمه % % مني بقلب حاضر مفقود % % 4 
ms46	(@)(@@) % يا للرجال ترحما بمتيم % % أفنت معالمه ظباء زرود % % 5(@)(@@) % أنا مغرم كم صاغ ضمن نظامه % % بيض المعاني في العيون السود % % 6(@)(@@) % أهوى الجميل وإن أقمت مع النوى % % بيد البعاد مسربلا بقيود % % 7(@)(@@) % وحلفت أني لا أميل عن الهوى % % حاشاي أنقض ذمتي وعهودي % % 8(@)(@@) % حكم الغرام علي أن أدع السوى % % ففعلت إعزازا لنص عقودي % % 9(@)(@@) % وهجرت إلامدح اشرف مرسل % % سر الوجود وعلة الموجود % % 10(@)(@@) % تاج النبيين العظام محمد % % غيث الهدى بحر الندى والجود % % PageV01P159 11(@)(@@) % كنز المكارم والمراحم والتقى % % والفضل رب الطالع المسعود % % 12(@)(@@) % مصباح دائرة البرايا شمسها % % في طوري الإطلاق والتقييد % % 13(@)(@@) % معنى النبوة رمز فرقان الهدى % % مفتاح فرق الجمع حين شهود % % 14(@)(@@) % كشف الكروب عن القلوب بهمة % % مقصودة في الحشر للمقصود % % 15(@)(@@) % كل المعالي والمكارم تنتهي % % وحياته لمقامه المحمود % % 16(@)(@@) % لولاه لم يكن الوجود ولادرى % % كل العبيد تفرد المعبود % % 17(@)(@@) % لولاه تاه العارفون واخطؤا % % طرق الرضا وحقيقة التوحيد % % 18(@)(@@) % لولاه لم يسع الحجيج لمكة % % شعثا وخلصهم على التجريد % % 19(@)(@@) % لولاه ما طاب المقام بطيبة % % ولوى لها الركبان زهر وفود % % 20(@)(@@) % لولاه ما رفعت بقبتها السماء % % ورصعت من أنجم بعقود % % PageV01P160 21(@)(@@) % لولاه ما قرئ الكتاب وسلسلت % % في الله رشة أدمع بخدود % % 22(@)(@@) % لولاه ما خشع القلوب لربها % % في خلوة من ركع وسجود % % 23(@)(@@) % لولاه ما عطر المحافل بالثنا % % والذكر والتحميد والتمجيد % % 24(@)(@@) % هو آية الله القديم ومنتهى % % شأن الكمال وموصل المبعود % % 25(@)(@@) % هو رحمة الله التي وسع الورى % % تيارها والغوث للمردود % % 26(@)(@@) % هو سيد الرسل العظيم مقامهم % % وإمامهم في جامع التأييد % % 27(@)(@@) % هو والذي أعطاه أرفع رتبة % % باب الرجا لمراد كل مريد % % 28(@)(@@) % هو روح ذرات العوالم كلها % % ذو المعجزات وذو اللوا المعقود % % 29(@)(@@) % ذو المجد ذو الجاه العريض ذو الندا % % ذو المظهر المحفوف بالتأييد % % 30(@)(@@) % روحي الفدا لغبار أرض رحابه % % فلك العلى قمر السنا المشهود % % PageV01P161 31(@)(@@) % أفديه من اسد إلهي لوت % % بوصيده الهامات أي أسود % % 32(@)(@@) % نصب العجاج عليه خيمة مشهد % % بحنين شيب مفرق المولود % % 33(@)(@@) % فحمى الحما فرد كجيش 
ms47	 سابح % % ما بين لين دوابل وحديد % % 34(@)(@@) % وكأنه والخيل تزحم بعضها % % هربا يصول على العدا بجنود % % 35(@)(@@) % حتى بطاهر ذاته لا غيرها % % من الأله بنصره الموعود % % 36(@)(@@) % وبيوم بدر والعقنقل طامس % % خفقت له بالنصر خير بنود % % 37(@)(@@) % وبفتح مكة والرجال ذواهل % % حيى بخلق لو فقهت جديد % % 38(@)(@@) % قد أذهب الله الشقاء واهله % % وأتى بحزب لا يرام سعيد % % 39(@)(@@) % من كل فحل في العرمرم صائل % % سامي الجناب مهذب صنديد % % 40(@)(@@) % باع الفؤاد تحققا بنبيه % % طمعا بشربة حوضه المورود % % PageV01P162 41(@)(@@) % فهو النبي الهاشمي المرتجى % % حصن النزيل وملجأ المطرود % % 42(@)(@@) % موسى وعيسى والنبيون الالى % % لاذوا بذيل بساطه الممدود % % 43(@)(@@) % هو خيرهم ذاتا وأكرمهم يدا % % وأعزهم في الطارقات السود % % 44(@)(@@) % متقلبا في الساجدين لنا أنجلى % % من زهر آباء وغر جدود % % 45(@)(@@) % سبقت شفاعته فكل موحد % % في طي نشر ضمانها المعهود % % 46(@)(@@) % مولاي يا بحر النوال ويا ضيا % % ليل العلوم وكهف كل شريد % % 47(@)(@@) % يا من إليك رجوع كل مؤمل % % ونداك للعافين غير بعيد % % 48(@)(@@) % أدعوك دعوة مستجير لائذ % % بعريض جاهك من جفا وصدود % % 49(@)(@@) % فالذنب سود لي وجوه صحائفي % % وعقيق دمعي صار صبغ برودي % % 50(@)(@@) % طمحت إلى نيل المآثم همتي % % وتجاوزت بي في الذنوب حدودي % % PageV01P163 51(@)(@@) % وغدوت مرتديا ملابس زلة % % حطمت جحافل عدتي وعديدي % % 52(@)(@@) % وبكل ما أنا فيه ما لي موئل % % إلاك يرحم لوعتي ووقيدي % % 53(@)(@@) % إني اعتصمت بحبل عزك راغبا % % بك سيدي عن طارقي وتليدي % % 54(@)(@@) % متمسكا بشريف ذيلك راجيا % % حسن القبول عسى تتم سعودي % % 55(@)(@@) % فلأنت غوث العاجزين وذخرهم % % ومجيرهم من وهدة التفنيد % % 56(@)(@@) % يا خير من قاصرا عن درك ما % % هو لائق بجنابك المسعود % % 57(@)(@@) % يا خير من قصد العفاة رحابه % % وأتاه صاحب مقصد بقصيد % % 58(@)(@@) % إني مدحتك قاصرا عن درك ما % % هو لائق بجنابك المسعود % % 59(@)(@@) % متوشح مرط الحيا لكنني % % أدبا بذلت بخدمتي مجهودي % % 60(@)(@@) % وكفاك مدحة ربنا بكتابه % % عن مدحي ذي نظم ورب نشيد % % PageV01P164 61(@)(@@) % جل الذي أعطاك قدرا دونه % % خرس الفصيح وتاه كل رشيد % % 62(@)(@@) % هل غير 
ms48	 فضلك لي ولولا أنت هل % % يخضر في صحر الحوادث عودي % % 63(@)(@@) % أدعوك بالرحم الذي هو حجتي % % يوم الحساب لموعدي ووعيدي % % 64(@)(@@) % وبنعمة الإيمان غوثا إنني % % حي يقوم بهيكل الملحود % % 65(@)(@@) % ضاقت على مذاهبي فامنن على % % ضعفي بإحسان يغيظ حسودي % % 66(@)(@@) % واجعل إلى نفحات عونك مرجعي % % وعلى بحار الفضل منك ورودي % % 67(@)(@@) % وبطى ذيل جنابك السامي الذرى % % أحسن قيامي بالرضا وقعودي % % 68(@)(@@) % لأكون في الأخرى نزيلك في العلى % % وبهذه الدنيا إليك وفودي % % 69(@)(@@) % وابى وولدتي وكل أقاربي % % وأحبتي والآخذين عهودي % % 70(@)(@@) % والمسلمين تولهم بإغاثة % % ومن العناية جد لهم بمزيد % % PageV01P165 71(@)(@@) % وانظر بعين الرفق كسري واكفني % % هم الزمان ووصمة التنكيد % % 72(@)(@@) % فبرمش طرفك كل همي ينجلى % % ويصير عمري مثل ساعة عيدي % % 73(@)(@@) % صلى عليك الله ما حاد حدا % % عيسى الحمى بنزولها وصعود % % 74(@)(@@) % والآل والصحب الكرام جميعهم % % والتابعين ومرشد ومريد % % PageV01P166 البحر : كامل تام 1(@)(@@) % يا صاحب القبر المنير بيثرب % % لك قد مددت وليس لي وجه يدي % % 2(@)(@@) % وجه رسول الله بوجهك لي وجد % % لأنال آمالي وأقهر حسدي % % 3(@)(@@) % وانظر بعين العفو سود صحائفي % % ليضيئي دهرا خط حظي الاسود % % 4(@)(@@) % غوثاه يا سيف المهمن إنني % % بحديد بطشك قد قرعت المعتدي % % 5(@)(@@) % ليل النوائب طال فابلج فجره % % بإغاثة يا نجدة المستنجد % % 6(@)(@@) % بدد بسيفك يا أمين الله ما % % جمع العدو وصر له بالمرصد % % 7(@)(@@) % حتى أقول له انتصرت بخائب % % وأنا انتصرت بسر جاه محمد % % PageV01P167 البحر : كامل تام 1(@)(@@) % رح يا عليل القلب والثم خاشعا % % أعتاب طه وانشق العرف الشذي % % 2(@)(@@) % واستجل أنوار الهدى من بابه % % واقرأ مفاخره بسبحان الذي % % PageV01P168 البحر : طويل 1(@)(@@) % إلهي بسر الليل والفائض الجاري % % من الرفرف الأعلى لحجرة مختارة % % 2(@)(@@) % بحبل اتصال بين طه وبينكم % % بأسراره العظمى التي تحت أستار % % 3(@)(@@) % بآيات قرآن تدلت لقلبه % % من الحضرة الكبرى بعلم وإخبار % % 4(@)(@@) % بدولة إرسال وبعث به علت % % دعائمها والسر سار لأقطار % % 5(@)(@@) % بسطوة تصريف تجلت بذاته % % وعصمته من كل باغ وغدا % % 6(@)(@@) % بسيف سماوي به سل في العما % % فقط به راس العدو 
ms49	 ببتار % % 7(@)(@@) % بمظهره السامي على كل مظهر % % ومحفلة الممدود من جانب الباري % % 8(@)(@@) % بعلم خفي فيه صين عن السوى % % فدانت له القادات في كل مضمار % % 9(@)(@@) % بإخوانه أهل النبوة والهدى % % وآل وأصحاب وحزب وأنصار % % 10(@)(@@) % بأتباعه الوارث والقوم كلهم % % بجدي الرفاعي صاحب المدد الساري % % PageV01P169 11(@)(@@) % بسادة هذا العصر خاف وظاهر % % وغوث الورى شيخي وبهجة أسراري % % 12(@)(@@) % بأعيان ديوان وأصحاب نوبة % % وارباب تصريف وحال وأطوار % % 13(@)(@@) % بأهل قبول الله في الأرض والسما % % بكل زمان دار في دور أعصار % % 14(@)(@@) % تكرم علينا بالقبول وبالرضا % % وبالمدد الغيبي يا خير ستار % % 15(@)(@@) % وحف حمانا منك باللطف واحمنا % % من الخوف واحرسنا بآيات أذكار % % 16(@)(@@) % وكف يد الباغي علينا وشلها % % ليخمد عن رغم له زنده الواري % % 17(@)(@@) % واكمل علينا فضل نعمتك التي % % تكرمت فيها منك سبقة اقدار % % 18(@)(@@) % ولا تخزنا يوم المعاد وخذ بنا % % لظل الحبيب المصطفى كافل الجار % % 19(@)(@@) % عليه صلاة الله ما لاح كوكب % % وضاءت فجاج الكائنات بأقمار % % 20(@)(@@) % وآل وأصحاب كرام وكل من % % يناجيك عن ظن جميل بأسحار % % PageV01P170 البحر : وافر تام 1(@)(@@) % رسول الله ضاق بي الديار % % وأج بقلبي المحزون نار % % 2(@)(@@) % ولي حمل وهنت به ثقيل % % وما لي غير ظل حماك جار % % 3(@)(@@) % وهمي يا عريض الجاه اضحى % % كبيرا دونه هممي صغار % % 4(@)(@@) % وحسادي علي عدوا بزور % % وطاشوا يا ابن آمنة وحاروا % % 5(@)(@@) % ولي قصص اسطرها بوزري % % نتيجتها المذلة والصغار % % 6(@)(@@) % ولي راي أقالبه بأمري % % فيغلبه لدي الإعتذار % % 7(@)(@@) % ولي ذنب عظيم جل منه % % مصابي والعناء والانقهار % % 8(@)(@@) % وما لي في بلاد الروم خل % % يواسيني إذا صار المصار % % 9(@)(@@) % وجنحي آه والهفي كسير % % ويجبرني إليك الإنكسار % % 10(@)(@@) % فلاحظني بعين العطف إني % % إليك يصون وجهي الافتقار % % PageV01P171 11(@)(@@) % ولا تجعل لغير الله فقري % % إذا ما ثار من خطب أوار % % 12(@)(@@) % فإن كبائر الآثام مني % % بذيل جنابك العالي صغار % % 13(@)(@@) % الا فاسبل علي طويل ذيل % % تلوذ بظل رأفته الكبار % % 14(@)(@@) % وأدركني بغوثك من زمان % % قليلا صار فيه الانتصار % % 15(@)(@@) % فلي رحم إليك وحسن ظني % % بجاهك 
ms50	 لا يدنسه غبار % % 16(@)(@@) % أجل المرسلين تول أمري % % فإني قد تسورني اضطرار % % 17(@)(@@) % بشأني أضمر الحساد سوءا % % ولا ورق لدي ولانضار % % 18(@)(@@) % وحولي عيلة وصغار آل % % لهم نسب إليك به الفخار % % 19(@)(@@) % فإن أهملتني لعظيم وزري % % ففي من يا حبيبي يستجار % % 20(@)(@@) % تداركني رسول الله يا من % % يقال بحاهه العالي العثار % % PageV01P172 21(@)(@@) % واسعفني ولا تقطع حبالي % % وأنقذني فقد عظم الخسار % % 22(@)(@@) % وخذ بيدي ولا تفصم رجائي % % فمثلك لا يذل لديه جار % % 23(@)(@@) % جعلت الليل معنى عرض حالي % % إليك فقل سيرضيك النهار % % 24(@)(@@) % عسى بجليل قدرك عند ربي % % ارى فرج الصباح له ازدهار % % 25(@)(@@) % وتجبر كسرتي ويسر قلبي % % ويخذل حاسدي بما تجاروا % % 26(@)(@@) % حبيب الله أدركني فإني % % كطير ما لجنحيه مطار % % 27(@)(@@) % لقد سلبتني الأعداء ريشي % % ولكني بطولك لي اشتهار % % 28(@)(@@) % فلا ترض افتضاح حجاب ستري % % ولي بظلال دولتك استتار % % 29(@)(@@) % أب لي في الحمى شيخ كبير % % عراه لفرقتي ثم انكسار % % 30(@)(@@) % وكم يدعو بجاهك متسجيرا % % ومن يدعوك منكسرا يجار % % PageV01P173 31(@)(@@) % وإني قد دعوتك والخطايا % % لها بخواطري مني اغبرار % % 32(@)(@@) % وبي خوف من الآثام منه % % على وجهي ذبول واصفرار % % 33(@)(@@) % أغثني يا عظيم القدر إني % % خؤف لا يقر له قرار % % 34(@)(@@) % وأنت يعزك المولى بنصري % % ولو جفت لأوزاري البحار % % 35(@)(@@) % وخالقنا بتبديل التجلي % % يجللك والضعيف له يغار % % 36(@)(@@) % فذنبي سد بالظلمات دربي % % وانت بنور وجهك يستنار % % 37(@)(@@) % فاتحفني بغوثك يا حبيبي % % فلي في ذمة الايام ثار % % 38(@)(@@) % وسامحني بمرحمة وصفح % % فما لي إن كففت الطرف دار % % 39(@)(@@) % رفعت بعزك الوضاح بيتي % % وطال له بدولتكم جدار % % 40(@)(@@) % فلا تهدم بناء فيك طالت % % دعائمه وطال لها منار % % PageV01P174 41(@)(@@) % بآلك والصحابة يا ابن فهر % % فهم قوم صغارهمو كبار % % 42(@)(@@) % وبالأتباع والأصهار طرا % % ومن لهم بنسبتكم فخار % % 43(@)(@@) % تداركني بكشف الكرب عني % % ودارك غربتي فلك اقتدار % % 44(@)(@@) % وحول قيود عجزي بانتهاض % % قوي فالهموم لها ابتدار % % 45(@)(@@) % وحول ذلتي كرنا لعز % % وفخر لا يقابله دمار % % 46(@)(@@) % وطوقني بإيمان ومجد % % وخير إذ عليك بنا المدار % % 47(@)(@@) % ففي 
ms51	 أعتابك العليا دخيل % % وصدق الحب لي أبدا شعار % % 48(@)(@@) % تلقاني ببشرك وامح عسري % % بإسعاف وقل حصل اليسار % % 49(@)(@@) % عليك الله صلى كل حين % % مدى ما عاقب الليل النهار % % 50(@)(@@) % وكل الرسل والأصحاب طرا % % وآلك من لهم كرم النجار % % PageV01P175 51(@)(@@) % وأهل الله والغوث الرفاعي % % سليلك من لديك به أجار % % PageV01P176 البحر : خفيف تام 1(@)(@@) % يا أبا إبراهيم أنت نصيري % % ومعيني وكافلي ومجيري % % 2(@)(@@) % يا أبا إبراهيم إن عدوي % % رام خذلي طيشا وأنت ظهيري % % 3(@)(@@) % يا أبا إبراهيم دارك حنانا % % حال هذا العويجز المستجير % % 4(@)(@@) % يا أبا إبراهيم قل اصطباري % % ومن الخطب قد كواني زفيري % % 5(@)(@@) % يا أبا إبراهيم لله أسعف % % وأغثني بجبر قلب كسير % % 6(@)(@@) % يا أبا إبراهيم جد لي بعطف % % وحنان فأنت خير بشير % % 7(@)(@@) % يا أبا إبراهيم جاهك حسبي % % إن توالت نوائب المقدور % % 8(@)(@@) % يا أبا إبراهيم فضلك ذخري % % وعليه معولي في أموري % % 9(@)(@@) % يا أبا إبراهيم لاحظ بعون % % يتجلى من المعين النصير % % 10(@)(@@) % يا أبا إبراهيم طاش حسودي % % وهو حقا عليك غير عسير % % PageV01P177 11(@)(@@) % يا أبا إبراهيم غوثاه إني % % ذبت هما وقد جهلت مصيري % % 12(@)(@@) % يا أبا إبراهيم يا أكرم الخلق % % ويا كفء كل أمر خطير % % 13(@)(@@) % يا أبا إبراهيم رحماك فالليلة % % حبلى وأنت سيف القدير % % 14(@)(@@) % يا أبا إبراهيم دارك ضعيفا % % شب نحو العلى بباع قصير % % 15(@)(@@) % يا أبا إبراهيم بالبضعة الزهراء % % والآل والصحاب البدور % % 16(@)(@@) % يا أبا إبراهيم خذ عرض حالي % % وأجزه منك بالعطاء الكبير % % 17(@)(@@) % يا أبا إبراهيم حرك ركاب العزم % % نحوي فأنت كنز الفقير % % 18(@)(@@) % يا أبا إبراهيم صلى عليك الله % % من سيد بشير نذير % % PageV01P178 البحر : طويل 1(@)(@@) % أغث كرما يا صاحب الحضرة الكبرى % % وطيب كسير القلب مولاي بالبشرى % % 2(@)(@@) % فإنك باب الله والسيد الذي % % افاض له الرحمن منته الوفرى % % 3(@)(@@) % وأنت الرسول الابطحي محمد % % ملاذ الورى سر الوجود أبو الزهرا % % 4(@)(@@) % تصدرت في بحبوحة الشرف الذي % % مفاخره من فوق هام العلى تقرا % % 5(@)(@@) % وقمت إماما للبرايا وهاديا % % فبدلت ليل الغي رشدا جلا ظهرا % % 6 
ms52	(@)(@@) % وأحييت أموات القلوب بنظرة % % لقد أطلعت في افقها أنجما زهرا % % 7(@)(@@) % وأعلى بك الله الشريعة والهدى % % فجئت رسولا في حقيقته ذكرا % % 8(@)(@@) % وايدت أمر الله رغم عدوه % % فكنت له جهرا على ضده نصرا % % 9(@)(@@) % بك القصد يعطى والمهمات تنجلي % % ويجبر بارينا بهمتك الكسرا % % 10(@)(@@) % وحاشاك ترضي خزي من أحسن الرجا % % بفضلك عن صدق ولم يستطع صبرا % % PageV01P179 11(@)(@@) % وها هو قد ناداك غوثاه إنني % % عبيد أخو عسر فأفرغ له يسرا % % 12(@)(@@) % فأنت أمين الله قاسم فضله % % فلا بخل في هذا المقام ولا فقرا % % 13(@)(@@) % أعين عيون الانبياء ورأسهم % % وأعظمهم جاها وأوسعهم صدرا % % 14(@)(@@) % وأعطفهم قلبا وأكثرهم ندا % % وأثبتهم في كشف هم دها سرا % % 15(@)(@@) % بقدرك عند الله بالرحمة التي % % بقلبك ماجت في طرائقه بحرا % % 16(@)(@@) % بعلم حباك الله محكم نصه % % فأطلعته في سرك المنتقى بدرا % % 17(@)(@@) % بما لك من عطف على المذنب الذي % % بحمل ألخطا والإثم قد أثقل الظهرا % % 18(@)(@@) % بروحك روح القدس بالقبضة التي % % لها الله في أكوانه رفع الذكرا % % 19(@)(@@) % بآلك أهل البيت والصحب كلهم % % وأتباعك الأقطاب من شرفوا فواقدرا % % 20(@)(@@) % بوراثك الأغواث والعلماء من % % بحبك منهم ربنا شرح الصدرا % % PageV01P180 21(@)(@@) % تدارك بإذن الله حالي فإنني % % لواني عن الآمال كف البلا قسرا % % 22(@)(@@) % إليك علت بي يا محمد نسبة % % حسينية بثت بكل الملا عطرا % % 23(@)(@@) % وإني عبيد مسلم خالص له % % بودك قلب عامر كله ذكرى % % 24(@)(@@) % وأنت إلى الله الكريم وسيلتي % % كفى بك في الدنيا كفى بك في الآخرى % % 25(@)(@@) % شفاعتك العظمى لكل مؤمل % % وأنك في السرا غياث وفي الضرا % % 26(@)(@@) % دعوتك محزونا وسرك حاضر % % محيط ففي الغبراء يفعل والخضرا % % 27(@)(@@) % أغثني بتفريج الكروب تحننا % % عليك صلاة الله طول المدى تترى % % PageV01P181 البحر : كامل تام 1(@)(@@) % الله أكبر هذه الآثار % % منها بسابق خلقها أسرار % % 2(@)(@@) % فلكل شيء حكمة وحقيقة % % حارت بفهم ضميرها الأفكار % % 3(@)(@@) % والكون لو حققته وفهمته % % كنز وفيه شؤننا الأضمار % % 4(@)(@@) % بستان رمز مغلق بطرازه % % أرواحنا برياضه الأطيار % % 5(@)(@@) % هو مستعار كالوديعة عندنا % % وكأننا الملاك والأمار % % 6(@)(@@) % فاعجب 
ms53	 بحقك من عبيد عجز % % يتصرفون كأنهم أحرار % % 7(@)(@@) % فالمرء منا لو تفكر ثوبه % % حال اغتسال ذاق كيف يعار % % 8(@)(@@) % وإذا انتحى بيت الخلا متبصرا % % خضعت به في ذاتها الأطوار % % 9(@)(@@) % وإذا مشى في البر أدرك أنه % % فرد وظل الدار والدينار % % 10(@)(@@) % ووجوده إن نام أرشده إلى % % ترك الوجود ونومه الأجبار % % PageV01P182 11(@)(@@) % وبنفس هيكله بكل دقيقة % % يتبارز الأخطار والأخطار % % 12(@)(@@) % فالجوع والشبع الكثير كلاهما % % خطر وتحت كلاهما مخطار % % 13(@)(@@) % والبرد والحر الوفير وما هما % % طويا به والطمس والابصار % % 14(@)(@@) % والسمع والصمم الثقيل وعلة % % وشفاؤها والبسط والأكدار % % 15(@)(@@) % والأمن والخوف المريع وغيره % % ينبيه كيف تمزق الأغيار % % 16(@)(@@) % نشر وطي فيهما لمفكر % % حال به تتسلسل الأدوار % % 17(@)(@@) % ليل تدور عليه أحكام الدجا % % ويليه في دور الشؤن نهار % % 18(@)(@@) % والكل للرجل الرشيد حقائق % % تجري بها في سفنها الأقدار % % 19(@)(@@) % فإذا عرفت بقاء نفسك فانيا % % أدركت كيف إلى الآله يسار % % 20(@)(@@) % وعلمت أن الفعل ظاهر فعله % % وهو القدير الفاعل المختار % % PageV01P183 21(@)(@@) % فانزع لعمرك ثوب وهمك بالسوى % % فالجهل عند ذوي البصيرة عار % % 22(@)(@@) % واصرف وجود الروح للباب الذي % % من فضله تتنزل الأسرار % % 23(@)(@@) % والحق بأرواح الأغراء الألى % % فهم الكرام السادة الأخيار % % 24(@)(@@) % رأوا الوجود بنور عين بصرة % % فرأوه ظلاما لديه قرار % % 25(@)(@@) % وتفكروا الصنع القديم وحادث الططرز % % الكريم فضاءت الأبصار % % 26(@)(@@) % وتمسكوا بطريقة الرحمن عن % % صدق وحقق فيهم الإيثار % % 27(@)(@@) % وتجردوا عنهم فهم بين الورى % % الأحرار والأمار الأبرار % % 28(@)(@@) % علقوا بذيل محمد شمس الهدى % % وعلى طريقته الكريمة ساروا % % 29(@)(@@) % فهو الحبيب الهاشمي المرتضى % % طه الذي اسرى به الجبار % % 30(@)(@@) % فرقان علم الله إنجيل الرضا % % توراته وزبوره المختار % % PageV01P184 31(@)(@@) % فلك العناية سمك كل حقيقة % % عرش الطريقة بحرها الزخار % % 32(@)(@@) % تاج النبيين الكرام إمامهم % % والغوث مهما كرت الأعصار % % 33(@)(@@) % باب الإله حبيبه مختارة % % مجلى رضاه وسيفه البتار % % 34(@)(@@) % ناموس برهان الهدى قاموسه % % قمر القبول ونجمه السيار % % 35(@)(@@) % مصباح منهاج الفتوح ونوره % % ملئت به الأنجاد والأغوار % % 36(@)(@@) % سلطان حزب الله صاحب أمره % % فيما ارتضى الجبار والقهار % % 37(@)(@@) % داعي الفلاح 
ms54	 إلى النجاح وصدرها الجحجاح % % والحماد والشكار % % 38(@)(@@) % مولى الأيادي مظهر الشرف الذي % % شهدت برفعة قدره الكفار % % 39(@)(@@) % وعليه سلمت الغزالة مثل ما % % بيمينه قد سبح الأحجار % % 40(@)(@@) % وبريقه التأم الجروح وطرفه % % شقت لرمشة عزه الأقمار % % PageV01P185 41(@)(@@) % وبيوم بدر ضاء بدرا حين لم % % يثبت مهاجرة ولا أنصار % % 42(@)(@@) % وأعز دين الله في أحد وقد % % وقدت لذلته هناك النار % % 43(@)(@@) % وبنو النضير تحزبوا فأبادهم % % حتى تحير فيهم النظار % % 44(@)(@@) % خفقت له في فتح مكة راية % % في الخافقين سرت لها أخبار % % 45(@)(@@) % والرعب يسري للجوانب قبله % % فتراع قبل وروده الاقطار % % 46(@)(@@) % وجيوشه فيها ملائكة السما % % جهرا يراها العسكر الجرار % % 47(@)(@@) % ذلت ملوك الأرض طرا لاسمه % % فالكل منهم خائف فرار % % 48(@)(@@) % وعلت به الفقرا وعز ذليلهم % % وحمي به مضنى الحما والجار % % 49(@)(@@) % وأبان للعدل القويم حدوده % % فبه استوى كبر الورى وصغار % % 50(@)(@@) % كل أمين من غوائل غيره % % بالشرع يمضي اينما يختار % % PageV01P186 51(@)(@@) % ولقد تساوى بالحقوق بشرعه العالي % % رعاة البهم والكبار % % 52(@)(@@) % ألقى بهم أدب الديانة والتقى % % ولكل شخص منهم مقدار % % 53(@)(@@) % أحياهمو نظر النبي وحبذا النظر % % الذي تمحى به الاوزار % % 54(@)(@@) % ما الكيميا قلب الحجارة فضة % % بل أن تزيل الظلمة الأنوار % % 55(@)(@@) % لله من ركن عظيم شامخ % % يعزى له الإيراد والإصدار % % 56(@)(@@) % وافى لنا بكتاب هدي بين % % تفدي لحكمة نصه الأعمار % % 57(@)(@@) % وأتى ببرهان جلي كلما % % حسدا طووه اقامه الإظهار % % 58(@)(@@) % عجبا وإن عميت قلوب حواسد % % هل تعمى عن شمس الضحى الأبصار % % 59(@)(@@) % مدد وإيمان ونور لامع % % إنكار جاحده له إقرار % % 60(@)(@@) % يا خير خلق الله يا من جوده % % بحر وفي أعتابه الإيسار % % PageV01P187 61(@)(@@) % يا من تخلق بالتواضع رحمة % % وببابه قد تقبل الأعذار % % 62(@)(@@) % لك همة قدسية نبوية % % لجأت لها الغياب والحضار % % 63(@)(@@) % روحي الفدا لتراب قبرك إنه % % كنز الندا والطلسم المضمار % % 64(@)(@@) % يا قلب يمم ضمن فكرك رحبة السامي % % إذا ما نابت الاضرار % % 65(@)(@@) % حيث المراحم والمغانم والهدى % % حيث القبول وحيث تحمى الدار % % 66(@)(@@) % حيث النبوة والفتوة والندى الطامي % % وحيث على الدخيل يغار 
ms55	 % % 67(@)(@@) % حيث الفتوة والمرؤة كلها % % بل حيث يؤخذ للضعيف الثار % % 68(@)(@@) % رحب توسده الحبيب المجتبي % % غيث الوصول الهاطل المدرار % % 69(@)(@@) % علم العناية من أقيم بهديه % % في العالم التبشير والإنذار % % 70(@)(@@) % ورقى مقاما جل معنى قدرهب % % عن أن يشق بما لديه غبار % % PageV01P188 71(@)(@@) % مالي سواه لكل ما أملته % % وبه يفارق رحبي الإعسار % % 72(@)(@@) % وأرى به نور السعادة ينجلى % % وتحفني من فضله الاستار % % 73(@)(@@) % وتمد لي منه اليمين لعزتي % % فهو اليمين وما لديه يسار % % 74(@)(@@) % وأكون محفوظ الجناب بفضله % % أبدا ولا تغتالني الأشرار % % 75(@)(@@) % والسعد يخدمني بظل ركابه % % وتسرني الآصال والابكار % % 76(@)(@@) % واصير يوم الحشر تحت لوائه % % في موكب وإلي فيه يشار % % 77(@)(@@) % ويعم ذلك والدي وإخوتي % % وبني كي تقضى لنا الأوطار % % 78(@)(@@) % وتحف عائلتي وكل أقاربي % % وأحبتي ويعز فينا الجار % % 79(@)(@@) % صلى عليه الله ما انبلج الضحى % % وترونقت بجماله الأسحار % % 80(@)(@@) % والآل والأصحاب أصحاب التقى % % فهم الصدور القادة الأطهار % % PageV01P189 81(@)(@@) % والتابعين وكل عبد صالح % % ما انشدت بالمصطفى الاشعار % % 82(@)(@@) % أو ما شدا الحادي إذا وصل النقا % % الله أكبر هذه الآثار % % PageV01P190 البحر : خفيف تام 1(@)(@@) % رب ليل جلت به الأخطار % % واستطالت وقد جلاها النهار % % 2(@)(@@) % حكم في برودها مضمرات % % أودعتها أسرارها الاقدار % % 3(@)(@@) % وشؤون الأيام طي ونشر % % ولهذين في الملا أطوار % % 4(@)(@@) % قد تغيب البدور في الطمس حينا % % ويحيى الأهلة الإظهار % % 5(@)(@@) % لا تقل للهلال إذ لاح فضل % % أو على البدر حين يطمس عار % % 6(@)(@@) % حركات أدارها وارد الامر % % لسر حارت به الأفكار % % 7(@)(@@) % ومعان ستنجلي يوم إظهار % % الخبايا إذ تكشف الأستار % % 8(@)(@@) % هزنا الطبع فاحتفلنا بدنيا % % ما لشخص فيها وحقك دار % % 9(@)(@@) % كلنا ظن أنه صاحب الدار % % وما غير ربنا ديار % % 10(@)(@@) % عمر الخلق فارس تحته اقفر % % تطوى للسير منه القفار % % PageV01P191 11(@)(@@) % والمطيطاء مشية الناس للاعمال % % فانظر هل فوق هذا خسار % % 12(@)(@@) % ذهب الخلص الكرام وقل الخير % % فينا وقلت الأخيار % % 13(@)(@@) % مات من دأبهم جميل الايادي % % واصطناع المعروف والإيثار % % 14(@)(@@) % قد طوتهم يد الزمان فبادوا % % وتواروا تحت التراب وساروا % % 15(@)(@@) % مات 
ms56	 قوم بهم لدى القحط يستسقى % % وفي الحال تنزل الأمصار % % 16(@)(@@) % عاهدوا الله عهد صدق على الحق % % فهم دائما له أنصار % % 17(@)(@@) % ما رأوا طاعة المهيمن قولا % % لأمور قضت بها الأوطار % % 18(@)(@@) % وبقينا بمعشر فقراء الخلق % % لكن أغناهمو الدينار % % 19(@)(@@) % يزعمون الكمال بالعم والجدد % % غرورا وهكذا الأشرار % % 20(@)(@@) % وإذا هزهم كريم لأمر % % صغروا بعد كبرهم ثم حاروا % % PageV01P192 21(@)(@@) % أسرفوا حيث شرفوا النفس بالدرهم % % جهلا حتى على الجار جاروا % % 22(@)(@@) % عظمت ضجة العجائب فينا % % وتساوى الانجاد والأغوار % % 23(@)(@@) % وتعالى الفجار وانخفض الأبرار % % والماء واحد والنار % % 24(@)(@@) % آه يا حسرتا على الشرع أضحى % % خاملا وهو لو دروه منار % % 25(@)(@@) % وديار طالت يد الدين فيها % % لعبت فوق سطحها الكفار % % 26(@)(@@) % ورجال من عصبة الحق فيهم % % نخوة للحمى وعزم وثار % % 27(@)(@@) % سبقتهم جهال قوم كما قد % % سبق العيس بالمسير الحمار % % 28(@)(@@) % وتعدى الحدود كل لئيم الطبع % % خبل واستحسن الضرار % % 29(@)(@@) % وتوالى قلب الحقائق حتى % % قال قوم في الليل هذا نهار % % 30(@)(@@) % حالة ما لها سوى الله إن الله % % في الملك فاعل مختار % % PageV01P193 31(@)(@@) % والرسول العظيم صلى عليه الله % % كنز يمحى به الإعسار % % 32(@)(@@) % سيد الأنبياء علة خلق الخلق % % من قد اسرى به الجبار % % 33(@)(@@) % كنز غيب قامت به نقطة العلم % % وطافت بقلبه الاسرار % % 34(@)(@@) % مظهر الحق معدن الصدق سيف % % في المهمات مصلت بتار % % 35(@)(@@) % وعليه السلام ما انعطف القلب % % إليه ودرعه الإنكسار % % 36(@)(@@) % وعلى الآل والصحابة من هم % % خلفاء الشريعة الأطهار % % 37(@)(@@) % سادة العالمين في كل فج % % قادة الأتقيا الألى الأبرار % % 38(@)(@@) % ما تجلى الرب الجليل بلطف % % ومع الوقت دارت الأدوار % % 39(@)(@@) % وانجلت ذروة الوجود بأضواء % % وقامت بربها الآثار % % PageV01P194 البحر : بسيط تام 1(@)(@@) % رفعت عن مضمر الأسرار أستار % % كما طويت لذي الأسرار أسرار % % 2(@)(@@) % وكنت بحبوحة السر القديم وفي % % تنويع معناه إظهارا وإضمارا % % 3(@)(@@) % وكم جلى منك في نشء الغيوب ضيا % % فأشبع الكون أحوالا وأطوارا % % 4(@)(@@) % وصرت قبل انجلا نور البروز إلى الآثار % % في هيكل التعداد مضمارا % % 5(@)(@@) % وقد تدليت اصلا سابقا ومن الكنز % % الفروعي 
ms57	 درا كنت مختارا % % 6(@)(@@) % أطلعت من صبحك السامي الشريف على % % عليا سموات أهل الحق أقمارا % % 7(@)(@@) % وعتمة الشك قد ولت بنور هدى % % من شمس شدك في دور الورى دارا % % 8(@)(@@) % فأنت روح بني الدنيا وعين بني الأخرى % % وأعظمهم شأنا ومقدارا % % 9(@)(@@) % وأنت أحمد سادات الوجود ومصباح % % السعود وأوفى الرسل أنوارا % % 10(@)(@@) % محمد الخير بمحمود الخصال أحيد % % الخلق أعلى الورى خلقا وآثارا % % PageV01P195 11(@)(@@) % بسطت ذكرا جميلا ركب مدحته % % في كل فج عميق طيب سارا % % 12(@)(@@) % وأقسم الله تعظيما بعمرك في القرآن % % قدما كما ناداك جبارا % % 13(@)(@@) % فدمت بالله جبارا وكنت به % % معنى حساما من الاقدار بتارا % % 14(@)(@@) % فكم جبرت بقرب الله منكسرا % % وكم كسرت بقهر الله جبارا % % 15(@)(@@) % وكم كشفت حجابا دون طيته % % تطوى العزائم إيرادا وإصدارا % % 16(@)(@@) % وكم رفعت وضيعا ذل مسنده % % وكم وضعت بسهم الخذل كفارا % % 17(@)(@@) % لك انجلت دولة القدس التي عظمت % % مجدا وفي سرها عقل الورى حارا % % 18(@)(@@) % وبت في الخلوة العليا نزيل حمى الرحمن % % تكسب قرآنا وأذكارا % % 19(@)(@@) % ونلت وقتا مع المولى رقيقته % % مخصوصة فيك إفصاحا وإسرارا % % 20(@)(@@) % ولم تزل في حضور من حضائر ذات % % الله ترشد غيابا وحضارا % % PageV01P196 21(@)(@@) % وكل سطر بلوح الغيب خط عمى % % فككت مضمونة علما وإخبارا % % 22(@)(@@) % وفي دنا وتدلى سر ما كذب الفؤاد % % اثبت سرا منك سيارا % % 23(@)(@@) % وفجر هديك في ليل الوجود بدا % % فعم بالنور أنجادا وأغوارا % % 24(@)(@@) % لك الفخار انجلى قدما وآدم في % % مهد التكون شكلا كان فخارا % % 25(@)(@@) % وقبل نشأته الأولى وصبغته % % نورت في الملاء القدسي ابصارا % % 26(@)(@@) % وبأس عزمك كم آثاره نشرت % % من عالم الطي أحكاما وأدوارا % % 27(@)(@@) % ما الخيل ما الليل ما البيداء ان قفلت % % بالجند ما الأسد الضاري إذا ثارا % % 28(@)(@@) % ما الدهر ما البحر ما الدنيا وضرتها % % إذ كلهم بجناح منك قد طارا % % 29(@)(@@) % آيات عزك في الصحف القديمة قد % % خطت وسيبك عطفا أحمد النارا % % 30(@)(@@) % كشفت باللطف كرب العاجزين فما % % سواك يصرف أقدارا وأكدارا % % PageV01P197 31(@)(@@) % ها أنت عين العمى الغيبي واسطة الأكوان % % لله 
ms58	 إرشادا وإنذارا % % 32(@)(@@) % نسائم الفضل من علياك سارية % % وقد روت عنك للأملاك أخبارا % % 33(@)(@@) % طوعا وكرها لك انقاد العوالم فالبرهان % % قد صح إقرارا وإنكارا % % 34(@)(@@) % وفي رحابك لاذ المرسلون ومن % % جدواك نالوا سحاب الفوز مدرارا % % 35(@)(@@) % ومن علومك يا طه افضت لهم % % بحرا من المدد العلوي زخارا % % 36(@)(@@) % وسر جودك في بر الوجود سرى % % فاستوعب الكون أكنافا وأقطارا % % 37(@)(@@) % لذاك أصبحت جار العطف منك ولي % % ظن جميل وحاشا تهمل الجارا % % 38(@)(@@) % غوثاه يا سيد السادات خذ بيدي % % فلن أرى لي أعوانا وأنصارا % % 39(@)(@@) % وضاق ذرعي وقلت حيلتي ووهي % % صبري ومني ماء العين قد فارا % % 40(@)(@@) % وقد كلفت قوى والهم أوهن لي % % عظمي وسلطان حظي بالضنى جارا % % PageV01P198 41(@)(@@) % فانعم علي بعطف واكفني نكد الدنيا % % وكن موئلي في الحشر إذ صارا % % 42(@)(@@) % أتيت ارجوك نور القرب منك وقد % % صحبت ليلا من الآثام ستارا % % 43(@)(@@) % حاشاك ترضى بذلي والفضيحة إن % % حق الحساب وخاف الناس أوزارا % % 44(@)(@@) % فامنن بحل عقالي عل بعدئذ % % اقضي بفضلك مما رمت أوطارا % % 45(@)(@@) % وانظر بمرحمة حالي وجد كرما % % لي بالقبول وجرد عني العارا % % 46(@)(@@) % أدرك أبي وبني عمي وعائلتي % % بلفتة يا أعز الخلق أنظارا % % 47(@)(@@) % فنفحة من ندا كفيك إن منحت % % أغنت ولم تبق إقلالا وإعسارا % % 48(@)(@@) % إليك يا اشرف الرسل التجأت ومن % % حسناك أملت إعزازا وإظهارا % % 49(@)(@@) % صلى عليك عظيم الفضل بارئنا % % ما طاب ذكرك تكرارا وتذكارا % % 50(@)(@@) % وحزبك الطيب العالي الذي سبق الأكوان % % مجدا مماليكا وأحرار % % PageV01P199 51(@)(@@) % وآلك الغر أهل البيت ما نشدت % % رفعت عن مضمر الأسرار أستارا % % PageV01P200 البحر : كامل تام 1(@)(@@) % منح المهيمن أحمدا بظهوره % % فهو الحبيب ونوره من نوره % % 2(@)(@@) % وطواه في أستار باهر نعمة % % نشرت على آصاله وبكوره % % 3(@)(@@) % وأقامه عنه خليفة أمره % % وأعانه بسكونه ومروره % % 4(@)(@@) % وأثابة العلم الخفي عن الورى % % وبعصمة نجاه من مقدوره % % 5(@)(@@) % ولوى له هام البرية كلها % % ولقد تولاه بكل أموره % % 6(@)(@@) % ولأجله صاغ الوجود بحكمة % % مدت بساط سنينه وشهوره % % 7(@)(@@) % هو ذلك اللوح الإلهي الذي % % كتب الإله عليه 
ms59	 كل سطوره % % 8(@)(@@) % سر الجليل وعبده وصفيه % % وحبيبه المنصور في تدبيره % % 9(@)(@@) % والدولة القدسية العليا التي % % غلبت ببأس قليله وكثيره % % 10(@)(@@) % وهو العروس بحضرة غيبية % % نشر الكريم لها شريف ستوره % % PageV01P201 11(@)(@@) % وهو الضيا اللماع في سينا الخفا % % والجوهر المحض البسيط بطوره % % 12(@)(@@) % وهو الحقيقة للحقائق والرقيقة % % في زوايا الخط من مسطوره % % 13(@)(@@) % عول عليه أخا المهمة في البلا % % ولك الأمان من القضا وصدوره % % 14(@)(@@) % والجأ بظل رحابه العالي الذرى % % ملجا الوجود جليله وحقيره % % 15(@)(@@) % فببابه تقضى الحوائج والغنى % % من رحبه متدفق لفقيره % % 16(@)(@@) % وهو المعين لمن بحضرته التجا % % أبد الزمان بغيبه وحضوره % % 17(@)(@@) % ما لي سواه ولا ألوذ بغيره % % فالخير لا ينفك عن منظوره % % 18(@)(@@) % وبه أرد سهام كل معاند % % فالضيم لا يعدو على منصوره % % 19(@)(@@) % روحي الفدا لترابه وأبي وأمي % % والوجود بنشئة ونشوره % % 20(@)(@@) % لم لا وذاك الهيكل الاعلى الذي % % جبريل لاذ به لنيل حبوره % % PageV01P202 21(@)(@@) % أرجوه مرحمة بنفحة فضلها % % يجلى علي بها لطيف ستوره % % 22(@)(@@) % صلى عليه الله ما انبلج الضيا % % فأزال غين الليل عن ديجوره % % 23(@)(@@) % وعلى صحابته الكرام وآله % % عين الورى ورؤسه وصدوره % % 24(@)(@@) % ما قال داعي الغيب مبتهجا به % % منح المهيمن أحمدا بظهوره % % PageV01P203 البحر : كامل تام 1(@)(@@) % حرم النبي محمد فيما مضى % % مسته من أثر الصواعق نار % % 2(@)(@@) % ما تلك صاعقة ولكن لمعة % % نورية قدحت بها الأنوار % % 3(@)(@@) % وسرى زفير المذنبين ملامسا % % لحبالها فبدت لها آثار % % PageV01P204 البحر : وافر تام 1(@)(@@) % تجاوز في المقام حدود شرع % % أناس غافلون عن الإشاره % % 2(@)(@@) % أراد الحق إعظاما لطه % % عقابهم فأرسل عز ناره % % 3(@)(@@) % فقال بقبره رب اهد قومي % % فرد النار عنهم للحجاره % % PageV01P205 البحر : خفيف تام 1(@)(@@) % حيرتنا عجائب الآثار % % وتجلي ليل الدجى والنهار % % 2(@)(@@) % وإشارات دولة السر والبأس % % الإلهي بصولة الإظهار % % 3(@)(@@) % وشؤن الأيام والطي والنشر % % ودور الإيراد والإصدار % % 4(@)(@@) % والخفا والظهور والغيب والطور % % الشهودي وجولة الاقدار % % 5(@)(@@) % والعمى والعيان والوهم والفهم % % وتمزيق فرقة الأغيار % % 6(@)(@@) % حكم عند نسجها الحيرة المحض % % لكل الالباب والافكار % % 7(@)(@@) % حكم نظم درها بيد 
ms60	 القدرة % % سار بخيط أمر الباري % % 8(@)(@@) % حكم دونها انعقاد معاني % % همم العارفين والاحبار % % 9(@)(@@) % حكم حام حول رحب حماها % % جحفل الأنبياء والانصار % % 10(@)(@@) % حكم ما لها انقضاء ولا دور % % مداها انتها وذا السر سار % % PageV01P206 11(@)(@@) % حكم قام أمرها مع سر الأمر % % فالأمر مثلما هو جار % % 12(@)(@@) % حكم أفرغت بقالب وهب % % وعظاء للسيد المختار % % 13(@)(@@) % فانجلى شأن عزها بيد الجود % % ودارت على الكرام الكبار % % 14(@)(@@) % عرفوا الله بالنبي وفازوا % % ودروا فيه حكمة الجبار % % 15(@)(@@) % وبه شاهدوا من الأثر المحض % % الإلهي حقائق الأسرار % % 16(@)(@@) % فرأوا أنه مدار معالي % % جمع آثار قدرة القهار % % 17(@)(@@) % وهو عين العمى التي بعماها % % قابلتها الآلطاف بالأبصار % % 18(@)(@@) % فجلت غيهب العمى بجلال % % قد غشاه الجمال بالأنوار % % 19(@)(@@) % ودروا أنه حقيقة كل الأمر % % عند الإظهار والإضمار % % 20(@)(@@) % وهو باب الوصول لله والجاه % % العريض الحامي من الأكدار % % PageV01P207 21(@)(@@) % فلتعظيم قدره قال كل % % حيرتنا عجائب الآثار % % PageV01P208 البحر : طويل 1(@)(@@) % وما مصدر الأشياء إلا محمد % % لها عنه من عين الصعود حدور % % 2(@)(@@) % تقوم به بالعجز عن حد مدحه % % وناهيك طول المدح فيه قصور % % 3(@)(@@) % بدائرة التكوين نور جماله % % منار لديه المرسلون بدور % % 4(@)(@@) % ومركز أمر فوق برج العما استوى % % عليه جميع الكائنات تدور % % PageV01P209 البحر : خفيف تام 1(@)(@@) % لي فؤاد فارقته بفروق % % فسرى طائرا لأرض الحجاز % % 2(@)(@@) % غاب عني حقيقة ولعمري % % قمت من بعده بقلب مجازي % % 3(@)(@@) % يا هنيئا له بحب نبي % % هو في الطمس نكتة الإبرار % % PageV01P210 البحر : كامل تام 1(@)(@@) % أواه من هذا القليب القاسي % % صعب القياد علي غير مواسي % % 2(@)(@@) % أدعوه للسنن القويم فيلتوي % % في غفلة عن دعوتي وتناس % % 3(@)(@@) % وخديعة الدنيا وداعية الهوى % % ودسائس الخناس والوسواس % % 4(@)(@@) % غارت على ضعفي فقلت حيلتي % % وفقدت خلاني الكرام وناسي % % 5(@)(@@) % وبقيت رهن النائبات تلوكني % % أم الخطوب بأصعب الأضراس % % 6(@)(@@) % غوثاه يا شرف الوجود ورحمة % % يا صفوة الباري من الأجناس % % 7(@)(@@) % يا أيها المختار من هذا الورى % % يا نور عين السادة الأكياس % % 8(@)(@@) % لمعت شموس هداك في افق العلى % % فجلت قتام حنادس الأغلاس % % 9 