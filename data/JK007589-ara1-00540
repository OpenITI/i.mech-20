ms521	 % محارب كل تعذير لاعذار % % 126(@)(@@) % رأيت مدحك كالإبصار بعد عمى % إذ غيره كالعمى من بعد إبصار % % 127(@)(@@) % إن القريض الذي يخزى بحائكه % % ليكتسي بك فخرا غير أطمار % % 128(@)(@@) % كالمسك يفخر منسوبا إلى ملك % % وإن تواضع منسوبا إلى القار % % 129(@)(@@) % يزري على الشعر أقوام بحاكته % % وما عليه إذا ألبسته زاري % % PageV01P2060 البحر : - 1(@)(@@) % بليت فأبق على سائري % % فإني في الرمق الآخر % 2(@)(@@) % بلوت فألفيتني صابرا % فعد بالثواب على شاكر % % 3(@)(@@) % وخذ من فؤادك بعض الهوى % % لقلب بحبك مستأثر % % 4(@)(@@) % يبيت تألفه راحتي % % وينفر نحوك كالطائر % % 5(@)(@@) % أقل سيدي عثرة العاثر % % فما أحسن العفو بالقادر % % PageV01P2061 البحر : - 1(@)(@@) % قولا لمن عاب شعر مادحه % % أما ترى كيف ركب الشجر % 2(@)(@@) % ركب فيه اللحاء والخشب ال % % يابس والشوك بينه الثمر % % 3(@)(@@) % وكان أولى بأن يهذب ما % % يخلق رب الأرباب لا البشر % % 4(@)(@@) % فلم يكن ذاك بل سواه من ال % % أمر لشيء جرى به القدر % % 5(@)(@@) % والله أدرى بما يدبره % % منا وفي كل ماقضى الخير % 6(@)(@@) % فليعذر الناس من أساء ومن % % قصر في الشعر إنه بشر % % 7(@)(@@) % مطلبه كالمغاص في درك اللج % جة من دون درها خطر % % 8(@)(@@) % وليذكروا أنه يكد له ال % % عقل وتنضى في قرضه الفكر % % 9(@)(@@) % وفيه ما يأخذ التخير من % % غال ثمين وفيه ما يذر % % 10(@)(@@) % وليس بد لمن يغوص من ال % % جرف لما يصطفى ويحتقر % % PageV01P2062 البحر : - 1(@)(@@) % سيشكر رب الناس ما قد فعلته % بنا بادئا والرب للبر أشكر % 2(@)(@@) % فلا تولني البتراء منك فإنما % % ولي اليد البتراء من هو أبتر % % 3(@)(@@) % وأعقب إذا أبدأت عرفا فإنما % % بوادئه تنسى وعقباه تذكر % % 4(@)(@@) % ولا تك ممن يلحظ المجد فعله % وأولاه معروف وأخراه منكر % 5(@)(@@) % ألم ترد دنيا الناس تكسو شبابها % % وبهجتها الأحياء ثم تنكر % % 6(@)(@@) % فتشكى وفيما قدر الله عاذر % % لأفعالها لكنها ليس تعذر % % 7(@)(@@) % يلومونها مضطرة مستقيدة % فكيف ترى يلحون من يتحير % % 8(@)(@@) % ومن كان في أن يمنع الحق شاعرا % فإني في أن أبذل اللوم أشعر % % 9(@)(@@) % فلا تجعل الحرمان أمرا مقدرا % فيلقاك 
ms522	 من قولي ملام مقدر % % PageV01P2063 البحر : - 1(@)(@@) % حجر الرجل وجهه % خشن مثل شعره % 2(@)(@@) % ضيق الله عينه % % حسب توسيع جحره % 3(@)(@@) % حوسبت عينه بما % % زيد في رحب دبره % 4(@)(@@) % قبح الله وجهه % % فهو ضد لبدره % PageV01P2064 البحر : - 1(@)(@@) % تلق نصيحتي يا ابن الوزير % % بصفحة وجهك الحسن النضير % 2(@)(@@) % إذا ما كنت ذا سخط كبير % فلا تسخط على رجل صغير % % 3(@)(@@) % سخطت على مهندسك الملقى % % وما هو كفء سخطك بالضمير % % 4(@)(@@) % فكيف إذا أسأت القول فيه % % وكيف إذا اعتزمت على النكير % % 5(@)(@@) % ظلمت وما ظلمت الخصم لكن % ظلمت العتب ذا القدر الخطير % % 6(@)(@@) % قبيح أن تعاقب مستكينا % وليس عليك غيرك من مجير % % 7(@)(@@) % أعيذك من إخافة مستجير % % وأنت مكان أمن المستجير % % 8(@)(@@) % ومن إحلال قارعة بنفس % رجتك لدى مخاذلة النصير % % 9(@)(@@) % أسيرك فاقره واعدده ضيفا % فما ضيف بأضعف من أسير % % 10(@)(@@) % وليس قرى بأضعف من تجاف % يكون عن المسيء من القدير % % PageV01P2065 11(@)(@@) % إذا سخط المؤدب خيف منه % فكيف ترى من السخط المبير % 12(@)(@@) % متى يقرن بسخط منك قرن % فدهر الناس ذو الخطب الكبير % % 13(@)(@@) % أتوقع بامرىء لم يمس يرجو % % سواك على البلية من ظهير % % 14(@)(@@) % ومن لم يكف ما جرت يداه % فقادته الجريرة في جرير % % 15(@)(@@) % وأغمد سيفه عن كل شيء % وجرد نصله لابني سمير % % 16(@)(@@) % وإن أنصفت والانصاف أولى % % بمثلك فاعلمن يا ابن الوزير % % 17(@)(@@) % فليس بجائز سخط عظيم % تسلطه على رجل حقير % % 18(@)(@@) % أتتك به جريمته ذليلا % غضيض الجفن ذا نظر حسير % % 19(@)(@@) % وأعدمه النصير شقاء جد % فأمل منك معدوم النظير % 20(@)(@@) % أتظلم منك ناحية عليه % % وفيها سنة القمر المنير % % PageV01P2066 21(@)(@@) % كفاه بأن يراك وأن يرانا % % ونحن لديك في العيش الغرير % % 22(@)(@@) % وأنا مكرمون لديك طرا % نراه بمزجر المقصى الحقير % % 23(@)(@@) % لذاك أمض من مضض التنائي % % وأتعب للشقي من المسير % % 24(@)(@@) % ومن تسخط عليه فذو اغتراب % وإن لم يمس في بلد شطير % % 25(@)(@@) % كفاه فوت تقريب المناجى % % لديك وفقد منزلة الأثير % % 26(@)(@@) % مضى لك أول فيه جميل % فصله بمنة لك في 
ms523	 أخير % % PageV01P2067 البحر : - 1(@)(@@) % حقدت عليك ذنبا بعد ذنب % ولو أحسنت كان الحقد شكرا % % 2(@)(@@) % أديمي من أديم الأرض فاعلم % % أسيء الريع حين تسيء بذرا % % 3(@)(@@) % ولم تك يا لك الخيرات أرض % لتزرع خربقا فتريع برا % % 4(@)(@@) % أؤدي إن فعلت الخير خيرا % إليك وإن فعلت الشر شرا % % 5(@)(@@) % ولست مكافئا بالنكر عرفا % ولست مكافئا بالعرف نكرا % % 6(@)(@@) % يسمى الحقد عيبا وهو مدح % كما يدعون حلو الحق مرا % % PageV01P2068 البحر : - 1(@)(@@) % شكرت مديحي فيك إذ سبق الجدا % % وقلت لقد سلفتنا المدح والشكرا % % 2(@)(@@) % فأطربني ما قلت حتى استخفني % % كأن سماعا هز عطفي أو خمرا % % 3(@)(@@) % وما شكر المداح قوم سواكم % ولا حكموا أن يسبق النائل الشعرا % % 4(@)(@@) % بقية أبناء الملوك بحقكم % % يقولون ما قلتم من العرف لا نكرا % % 5(@)(@@) % وما زالت الآذان تقرع منكم % بأشياء تنفي من مسامعها الوقرا % % 6(@)(@@) % فلو لم تنلني غير ما قلت كان لي % % نوالا جزيلا لا قليلا ولا نزرا % % 7(@)(@@) % وكنتم تفيدونا فوائد جمة % فآونة علما وآونة وفرا % % 8(@)(@@) % أما حسبكم أن تطردوا الفقر وحده % عن الناس حتى تطردوا الجهل والفقرا % % PageV01P2069 البحر : - 1(@)(@@) % دابر أوطاره إلى الذكر % وفاقد العين تابع الاثر % % 2(@)(@@) % مآرب فاته المتاع بها % % إلا افتقاد العهود بالذكر % 3(@)(@@) % إذا تعاطت منالهن يدي % % أعجزن إلا تناوش الفكر % 4(@)(@@) % سقيا لأيام لم أقل أسفا % سقيا ولم أبك عهد مدكر % 5(@)(@@) % سقيا ورعيا لعيشة أنف % أصبحت من عهدها بمفتقر % % 6(@)(@@) % أمتعني دهرها بغبطته % % على الذي كان فيه من قصر % % 7(@)(@@) % إن يطو لذاتها المشيب فقد % % فضضت منها خواتم العذر % % 8(@)(@@) % أو يذو أغصانها الزمان فقد % % جنيت منها مطايب الثمر % % 9(@)(@@) % أجزعني حادث المشيب وإن % % كنت جليدا مستحصد المرر % % 10(@)(@@) % حق لذي الشيب أن يعفره % لابل كفاه بالشيب من عفر % % PageV01P2070 11(@)(@@) % ما الشيب شيبا فإن سألت به % % فالشيب شوب الحياة بالكدر % % 12(@)(@@) % هلا يسليك عن شبيبتك الشي % % ب ومنعاه باقي العمر % % 13(@)(@@) % أول بدء المشيب واحدة % تشعل ما جاورت من الشعر % % 14(@)(@@) % بينا نرى وحدها إذ اشتعلت % % أرتك نار 
ms524	 المشيب في أخر % % 15(@)(@@) % مثل الحريق العظيم تبدؤه % أول صول صغيرة الشرر % % 16(@)(@@) % تعدي إذا ما بدت صواحبها % % كأنها عرة من العرر % % 17(@)(@@) % كذا صغار الأمور ما برحت % % تكون منها مبادىء الكبر % % 18(@)(@@) % ليت شباب الفتى يدوم له % % ما عاش أو ينقضي مع الوطر % % 19(@)(@@) % لكنه ينقضي وإربته % في القلب مثل الكتاب في الحجر % % 20(@)(@@) % يا لمة قد عهدتها زمنا % سوداء سحماء جثلة الغدر % % PageV01P2071 21(@)(@@) % هل صبغة الله فيك عائدة % يوما ولو بعد طول منتظر % % PageV01P2072 البحر : - 1(@)(@@) % عيني هذا ربيع الدمع فاحتشدا % % وأبلياني بلاء غير تعذير % 2(@)(@@) % خص الأمام وعم الناس كلهم % رزء لعمر المنايا غير مجبور % % 3(@)(@@) % أم الإمام أصيبت وهو شاهدها % % ولا مجير على صرف المقادير % % 4(@)(@@) % لقد تجاوز مقدار تخرمها % % ظهرا منيعا وعزا غير مقهور % % 5(@)(@@) % لو أن خابطة عشواء تخبطنا % % لما تنخل أهل الفضل والخير % % 6(@)(@@) % نعاء أم أمير المؤمنين إلى % % بيت بمكة فالبطحاء معمور % % 7(@)(@@) % نعاء راعية المعروف رعيته % لكل عان بأرض الروم مأسور % % 8(@)(@@) % ولاختلال ثغور طال ما حملت % أبناءهن على الجرد المحاضير % % 9(@)(@@) % مواطن البر أمست وهي موحشة % منها وأنكرن عهد الأنس والنور % % 10(@)(@@) % ليبكها راغب كانت ذريعته % حتى تبدل ميسورا بمعسور % % PageV01P2073 11(@)(@@) % وليبكها راهب كانت شفيعته % أمسى يحاذر ذنبا غير مغفور % % 12(@)(@@) % وليبكها لخلال لا كفاء لها % % أجملن من كل خير كل تفسير % % 13(@)(@@) % يا بقعة قدرت فيها حفيرتها % % لقد خصصت بتقديس وتطهير % % 14(@)(@@) % لا ضير ألا تكوني روضة أنفا % أنيقة النور مبهاج الأزاهير % % 15(@)(@@) % أمسى جنابك مختارا على جدث % % من الملائكة الأبرار محضور % % 16(@)(@@) % تحية الله أزكاها وأطيبها % % على معارف وجه فيك منضور % 17(@)(@@) % أما لقد ذهب النوم المتاح لها % % بذكر يوم على الأيام مذكور % % 18(@)(@@) % يوم وجدك لم تشهده أسعده % ولا اجتلينه ميمون التباشير % % 19(@)(@@) % إنا إلى الله مرجوعون ما تركت % لنا المصيبة عظما غير مكسور % % 20(@)(@@) % وإن فينا لبقيا بعدما سلمت % % نفس الإمام لنا من كل محذور % % PageV01P2074 البحر : - 1(@)(@@) % ألا اسلمي يا دار من دار % تهيج أطرابي وأذكاري % % 2 
ms525	(@)(@@) % وقد أراها فأقول اسلمي % % لجمع آرابي وأوطاري % % 3(@)(@@) % حيتك عنا شمأل سهوة % % تسري إذا ما عرس الساري % % 4(@)(@@) % تنسمت تسحب أذيالها % % خلال جنات وأنهار % % 5(@)(@@) % كأنما نشرة أنفاسها % % تصدر عن حانوت عطار % % PageV01P2075 البحر : - 1(@)(@@) % إن خيرا من أن ترى في أن قد % % فسدت نيتي فحقي البوار % 2(@)(@@) % أن ترى أنني متى انجاب هذا ال % % ليل عني أضاء ذاك النهار % 3(@)(@@) % أنا ذاك الذي عهدت وإن % نفرت جأشي فكان مني نفار % 4(@)(@@) % ومتى شئت أن تألف نفسي % % ألفت وهي إن ظلمت نوار % % 5(@)(@@) % إن لي حرمة يغار عليها % % إن تأملت والكريم يغار % % 6(@)(@@) % لا تكونن من أطاع هواه % وطغى إذ أطاعه المقدار % % PageV01P2076 البحر : - 1(@)(@@) % لو كنت أنت حنينا في حذاقته % % أو معبدا رأس من غنى من البشر % 2(@)(@@) % أو كنت كابن سريج في تقادمه % % أو الغريض ففيهم منتهى العبر % % 3(@)(@@) % هل كنت تطرب إلا من تشاكله % ولو أعانك صوت الدف والوتر % % 4(@)(@@) % إن الكلاب مغنيها ومطربها % % في صوته عمر فاسلح على عمر % % 5(@)(@@) % والقحطبي إذا غناك مرتجلا % فقل خريت وقم عن مطل بخر % % 6(@)(@@) % لو كان في سعر في سقر % لمات سامعه من شدة الخصر % % 7(@)(@@) % إن جاء يفخر بالعباس والده % فقل فخرت بشيخ أرمل ذكر % % PageV01P2077 البحر : - 1(@)(@@) % فتى يبسط الآمال حسن لقائه % % ويقبضها من بعد نائله الغمر % 2(@)(@@) % إلى أين بالآمال بعد نواله % % إلى أين وافى آخر السفر السفر % % 3(@)(@@) % فكم نفحة في كفه أريحية % % طوت أملا قد كاد يخلقه النشر % % PageV01P2078 البحر : - 1(@)(@@) % لم تكن مثل نعمة الله في العب % باس تنجو من آفة التكدير % 2(@)(@@) % كدر الدهر صفوها بعبيد ال % % له وجه الحمار والخنزير % % 3(@)(@@) % غير أنا نرجو لراحتنا من % % ه سريعا لطف اللطيف الخبير % % 4(@)(@@) % يسرح الطرف من أخيه ومنه % بين قرد وبين بدر منير % % 5(@)(@@) % لك وجه كأنه حين يبدو % % مستعار من منكر ونكير % % PageV01P2079 البحر : - 1(@)(@@) % ذقت الطعوم فما التذذت كراحة % من صحبة الأشرار والأخيار % 2(@)(@@) % أما الصديق فلا أحب لقاءه % حذر القلى وكراهة الإعوار % % 3(@)(@@) % وأرى 
ms526	 العدو قذى فأكره قربه % فهجرت هذا الخلق عن إعذار % % 4(@)(@@) % أرني صديقا لا ينوء بسقطة % من عيبه في قدر صدر نهار % % 5(@)(@@) % أرني الي عاشرته فوجدته % متغاضيا لك عن أقل عثار % % 6(@)(@@) % من جور إخوان الصفا سرورهم % % بتفاضل الأحوال والأخطار % % 7(@)(@@) % لو أن إخوان الصفاء تناصفوا % % لم يفرحوا بتفاضل الأعمار % % 8(@)(@@) % أأحب قوما لم يحبوا ربهم % % إلا لفردوس لديه ونار % % PageV01P2080 البحر : - 1(@)(@@) % لأثبتن أبا عثمان في الغدره % الناكثين بإخوان لهم برره % 2(@)(@@) % ولا أقول إذا ما عد عاشرهم % لكن أقول بحق أول العشره % % PageV01P2081 البحر : - 1(@)(@@) % قد طلع البدر مع الزهره % في دولة مونقة الزهره % 2(@)(@@) % فأمست الدنيا لها بهجة % وأصبح الملك له نضره % 3(@)(@@) % وأضحت الحرة مقرونة % بالحر في دولته الحره % 4(@)(@@) % أعني أبا النجم فتى أحمد % إمام أهل البدو والحضره % 5(@)(@@) % سيدة زفت إلى سيد % بدلنا اليسر من العسره % 6(@)(@@) % ألف بالتوفيق شملاهما % % في نعمة تمت وفي حبره % 7(@)(@@) % فأسندت ظهرا إلى شاهق % وضم كفيه على دره % 8(@)(@@) % لاأعقبا من فرحة ترحة % % كلا ولا من حبرة عبره % 9(@)(@@) % ولا أرانا الله يوميهما % % لكن أرانا منهما الكثره % 10(@)(@@) % عمره الله وأبقى له % ركنيه من عز ومن قدره % PageV01P2082 11(@)(@@) % وسر مولانا بمولاته % وزاد حسادهما حسره % % PageV01P2083 البحر : - 1(@)(@@) % لحيته في وجهه بظر % وأنفه في وجهه قبر % 2(@)(@@) % وعقده الدهر فيا ويله % أوجهه المقبوح والدهر % % 3(@)(@@) % يا نغل ماهان ألا نهية % تنهاك أن يأكلك الببر % % 4(@)(@@) % مارست قرنا باسلا لو غدا % % قرنا له الصبر بكى الصبر % % PageV01P2084 البحر : - 1(@)(@@) % مرت ماء عيني فاستهل على النحر % % تباريح شوق في الحشا كلظى الجمر % % 2(@)(@@) % إلى صاحب أضحى فؤادي صاحبا % بفرقته للهم والحزن والفكر % % 3(@)(@@) % تظل دموع العين عند ادكاره % % تحدر والأنفاس تصعد في الصدر % % 4(@)(@@) % أأيوب جادت كل أرض حللتها % % مجلجلة وطفاء واكفة القطر % % 5(@)(@@) % ولا زلت محفوظا بحفظك عهد من % % تود إذا مال الخليل إلى الغدر % 6(@)(@@) % ألا ليت شعري لم أشيعك ظاعنا % وشيعتني من قبل ذاك إلى القبر % % 7(@)(@@) % ويا ليتني فارقت بعض جوارحي 
ms527	 % % وأنك ما بوعدت عني قد شبر % PageV01P2085 البحر : - 1(@)(@@) % من أخذ الحذر من المحذور % قل تجنيه على المقدور % 2(@)(@@) % فليحزم الناظر في الأمور % % فإن نجا من كبوة العثور % % 3(@)(@@) % لم ينج منجى حائن مغرور % % يحمله يوما على الغرور % % 4(@)(@@) % وإن كبا والعذر للمعذور % % لم يؤت من مأتى الضعاف الخور % % PageV01P2086 البحر : - 1(@)(@@) % طي اللقاء له نشور % فليطوه الجلد الصبور % 2(@)(@@) % حتى يعود حديثه % وكأنه عسل مشور % % 3(@)(@@) % لا تغترر بطهارة % فيها البشاشة والسرور % % 4(@)(@@) % فالقلب قلب كاسمه % منه التقلب والفتور % % PageV01P2087 البحر : - 1(@)(@@) % هل ينتهي نظر إلا إلى نظر % أو ينقضي وطر إلا إلى وطر % % 2(@)(@@) % وفيك أفضل ما تسمو النفوس له % % فأين عنك مميل السمع والبصر % % 3(@)(@@) % هل توجديني شبابا مونقا حسنا % غادرته من نبات الأرض والشجر % 4(@)(@@) % لكي تقولي استمالته بشاشته % لأن مطلب ما بي داحض الغدر % % 5(@)(@@) % ما فات حسنك لا شمس ولا قمر % إلا نباهة ذكر الشمس والقمر % 6(@)(@@) % تالله ما فت طرفي ريث رجعته % % إلا لقيتك لقيانيك عن عفر % % PageV01P2088 البحر : - 1(@)(@@) % أراحنا الله منك يا قذره % فأنت عين الثقيلة الوضره % 2(@)(@@) % يا إخوتي إن عيشة شغلت % % بشاغل حق عيشة كدره % % 3(@)(@@) % بخراء وقصاء في مغابنها % % نتن مجيف فكلها عذره % % 4(@)(@@) % لا تغسل الدهر كفها قذرا % فكفها طول دهرها غمره % % 5(@)(@@) % مشبهها في الحلاق والقبح % % والنتن وبرد الطريقة الخصره % % 5(@)(@@) % لا عجب أن يحب فاجرة % من استه بالمني منفجره % % 5(@)(@@) % ساخرة منك ثم تحسبها % % جاءت بحق إليك معتذره % % 5(@)(@@) % رضيت منها بأن تناك وتأتيك % % إذا ما أتتك منحدره % % 5(@)(@@) % لهفي لما قد رآه منك أبو شيبة % % يا ذا الصديقة القعره % % 5(@)(@@) % رشت بخيلانها فجلدتها % % منقوشة مثل جلدة النمره % % PageV01P2089 5(@)(@@) % لم ينتشر قط من يشاهدها % % وهي على العالمين منتشره % % 5(@)(@@) % تحرم الماء من نجاستهالم ينتشر قط من يشاهدهاوهي على العالمين منتشره رشت بخيلانها فجلدتهامنقوشة مثل جلدة النمره لهفي لما قد رآه منك أبو شيبة يا ذا الصديقة القعره رضيت منها بأن تناك وتأتيك إذا ما أتتك منحدره بذيء ساخرة منك 
ms528	 ثم تحسبهاجاءت بحق إليك % % فهي يد الدهر كله ذفره % % 6(@)(@@) % فلا سقى الله ريع عاشقها % % ما عاش صوب السحابة الهمره % % PageV01P2090 البحر : - 1(@)(@@) % ثنى شوقه والمرء يصحو ويسكر % % رسوم كأخلاق الصحائف دثر % 2(@)(@@) % لأيدي البلى فيها سطور مبينة % % عبارتها أن كل بيت سيهجر % % 3(@)(@@) % معاهد ربع كنت آلف أهله % % تغير بعدي والأمور تغير % % 4(@)(@@) % وقفت بها صحبي فظلت عراصه % بدمعي وأنفاسي تراح وتمطر % % 5(@)(@@) % سلام على الأيام إذا أنا سلمها % % وإذ أنت مني أيها الربع معمر % % 6(@)(@@) % وإذ فيك أمثال الظباء ملاحة % ونفرا عن الفحشاء بل هن أنفر % % 7(@)(@@) % كسين لبوس الحسن من كل غادة % لها خلق عف وخلق مصور % % 8(@)(@@) % تقسمها نصفان نصف مؤنث % ونصف كخوط الخيزران مذكر % % 9(@)(@@) % تعبد من شاءت بعين كأنها % % وإن سقيت ريا من النوم تسهر % % 10(@)(@@) % إذا هي عيبت عابها أن طرفها % % يريق دماء المسلمين فتهدر % % PageV01P2091 11(@)(@@) % سقى الله ريعان الشباب وإن غدا % % يخون في إخوانه ويغدر % % 12(@)(@@) % تذكرته والشيب قد حال دونه % % فظلت بنات العين مني تحدر % % 13(@)(@@) % ليالي أفنان الزمان رطيبة % تميد على أفيائها وتهصر % 14(@)(@@) % بها ثمر العيش الغرير فيانع % وآخر في أكمامه متنظر % 15(@)(@@) % أضاحك آمالا أمامي لم تكن % % عهودا يبكيهن من يتذكر % % 16(@)(@@) % أنا ابن ذوي التيجان غير مدافع % وهل يدفع الصبح الأغر المشهر % % 17(@)(@@) % نمتني ملوك الروم في رأس باذخ % % من المجد يعلو كل مجد ويقهر % % 18(@)(@@) % فأصبحت في عيص منيع ومنزل % % رفيع له فوق السماكين مظهر % % 19(@)(@@) % فقل للذي يسمو إلي مناوئا % هنالك أسهل إن مرقاك أوعر % % 20(@)(@@) % قصارك أن ترقى لعينيك نظرة % إلي وقد حزت المدى حين تفخر % % PageV01P2092 21(@)(@@) % وإني ودوني الشمس في بيت عزها % % وقلب تعاطاه العيون فتقصر % % 22(@)(@@) % فأغض على إقذاء عينك صاغرا % فجدك أدنى للسفال وأصغر % % 23(@)(@@) % ليأمن سقاطي في الخطوب ونبوتي % % جنان الذي يخشى علي ويحذر % % 24(@)(@@) % فما أسد جهم المحيا شتيمه % % قصاقصة ورد السبال غضنفر % % 25(@)(@@) % مسمى بأسماء فمنهن ضيغم % % ومنهن ضرغام ومنهن قسور % % 26(@)(@@) % له جنة لاتستعار وشكة % % هو الدهر في 
ms529	 هذي وهذي مكفر % 27(@)(@@) % إهاب كتجفاف الكمي حصانه % وعوج كأطراف الشباحين يفغر % 28(@)(@@) % وحجن كأنصاف الأهلة لا يني % % بهن خضاب من دم الجوف أحمر % 29(@)(@@) % تظل له غلب الأسود خواضعا % ضوارب بالأذقان حين يزمجر % % 30(@)(@@) % له ذمرات حين يوعد قرنه % تكاد له صم السلام تفطر % % PageV01P2093 31(@)(@@) % يراه سراة الليل والدو دونه % % قريبا بأدنى مسمع حين يزأر % % 32(@)(@@) % يدير إذا جن الظلام حجاجه % % شهاب لظى يعشى له المتنور % % 33(@)(@@) % خبعثنة جأب البضيع كأنه % % مكسر أجواز العظام مجبر % % 34(@)(@@) % له كلكل رحب اللبان وكاهل % % مظاهر ألباد الرحالة أوبر % % 35(@)(@@) % شديد القوى عبل الشوى مؤجد القرا % % ملاحك أطباق الفقار مضبر % % 36(@)(@@) % إذا ما علا متن الطريق ببركه % % حمى ظهره الركبان فالسفر أزور % % 37(@)(@@) % أخو وحدة تغنيه عن كل منجد % له نجدة منها ونصر مؤزر % % 38(@)(@@) % مخوف الشذا يمشي الضراء لصيده % % ويبرز للقرن المناوي فيصحر % % 39(@)(@@) % باريى على الأقران مني صولة % % وقد أنذر التجريب من كان ينذر % % 40(@)(@@) % فأنى تعاوى لي الثعالب ويبها % % وقد رأت الآساد مني تجحر % % PageV01P2094 41(@)(@@) % أفي كل حين لا يزال يهيجني % % سفيه له في اللؤم فرع وعنصر % % 42(@)(@@) % عفت ذكره آباء سوء أدقة % فمات خمولا غير أن ليس يقبر % 43(@)(@@) % يسوم هجائي كي ينوه باسمه % % وفي السب ذكر للئيم ومفخر % % 44(@)(@@) % أخالد لم أنكر لك النكر والخنا % % بل العرف من أفعال مثلك منكر % % 45(@)(@@) % فدونك لم تسبق بظلمي ظالما % من الناس بل أنت السكيت المؤخر % % 46(@)(@@) % هجوت مهجى في اللئام محسدا % له شانىء منهم يد الدهر أبتر % % 47(@)(@@) % فدأبك فانبح لست أول نابح % ونابحة بدر الدجى حين يبهر % % 48(@)(@@) % أخالد لو كنت المكنى بخالد % هجوتك لكن أنت أزرى وأحقر % % 49(@)(@@) % على أنني هاجيك لامتكلفا % خلا أن تيارا من البحر يزخر % % 50(@)(@@) % ولو ملكت كفي على الشعر غربه % لكان له معدى سواك ومقصر % % PageV01P2095 51(@)(@@) % ولو كنت مختار المهاجين لم يكن % % بسبي ومالي كل من أتخير % % 52(@)(@@) % أخالد ما أغراك بي من عداوة % ولا ترة لولا الشقاء المقدر % % 53(@)(@@) % حداك إلي الحين 
ms530	 حتى استثرتني % % عليك وإني في عريني لمخدر % % 54(@)(@@) % فدونك ما حاولته فبلغته % وردت ولكن لا إخالك تصدر % % 55(@)(@@) % فقد كنت نسيا لا تحس ولا ترى % زمانا طويلا فاصبر الآن تذكر % % 56(@)(@@) % ستروي رواة الشعر فيك قصائدا % يغنى بها ما نودي الله أكبر % % 57(@)(@@) % شوارد لا يثنى المهيب شريدها % % ولا يتناهى غربها حين يزجر % % 58(@)(@@) % تهب هبوب الريح في كل وجهة % عباديد منها منجد ومغور % % 59(@)(@@) % سداها مخازيك التي قد علمتها % % ولحمتها مني الكلام المحبر % % 60(@)(@@) % قواف إذا مرت بسمعك خلتها % % ملاطيس تزجيها مجانيق تخطر % PageV01P2096 61(@)(@@) % لها هزمات في الرؤوس كأنها % % ركايا ابن عاد غورها ليس يسبر % % 62(@)(@@) % وإن كنت لا أهجوك إلا كحالم % % يرى ما يراه النائمون فيهجر % % 63(@)(@@) % لأنك معدوم الوجود وإنما % % يرينيك ظني ريثما أتدير % % 64(@)(@@) % فإن كنت شيئا ثابتا فهباءة أيا ابن التي كانت تحيض من استهايد الخر لم يطهر لها قط مئزر إذا ما ونى عنها الزنادة دعتهمشقائق من أرحامها الخضر تهدر أحاشي التي تنمي إليها وأنتحيبها أمك الأخرى التي سوف تظهر وكم من حصان شفها العقم فاغتدت تبنى ابن أخ % % تضاءل في عين اليقين وتصغر % % 64(@)(@@) % أيا ابن التي كانت تحيض من استها % % يد الخر لم يطهر لها قط مئزر % % 64(@)(@@) % إذا ما ونى عنها الزنادة دعتهم % شقائق من أرحامها الخضر تهدر % % 64(@)(@@) % أحاشي التي تنمي إليها وأنتحي % % بها أمك الأخرى التي سوف تظهر % % 64(@)(@@) % وكم من حصان شفها العقم فاغتدت % % تبنى ابن أخرى والأمور تزور % % 65(@)(@@) % عساك أفادتك الدعاوة نخوة % فغرتك مني والجهول مغرر % % 66(@)(@@) % وكم طامح ذي نخوة قد رددته % % إلى قيمة دون الذي كان يقدر % % PageV01P2097 67(@)(@@) % أرحت عليه حلمه وهو عازب % وقومت منه درأه وهو أصعر % % 68(@)(@@) % أتتركك السادات من آل صامت % تروح سليما في الرجال وتبكر % % 69(@)(@@) % تجر عليهم كل يوم جريرة % فتقضب أعراض الكرام وتهبر % % 70(@)(@@) % وأنت خلي البال مما يعرهم % ولم لا ولم يشتم بهم لك معشر % % 71(@)(@@) % ولو كان جذم القوم جذمك صنته % لعمري ولكن أنت بالأمر أخبر 
ms531	 % % 72(@)(@@) % ليكفك من جر المخازي عليهم % مكانك منهم فهو أخزى وأعور % % 73(@)(@@) % كفاهم بظن الناس أنك منهم % وإن لم تكن منهم ففيك معير % 74(@)(@@) % شهدت لقد ألبستهم ثوب خزية % وأحسابهم من تحت ذلك تزهر % % 75(@)(@@) % ولا غرو إلا أنني رعت عنهم % عرام القوافي وهي نار تسعر % % 76(@)(@@) % وأنت تحداني ليحمى عليهم % وطيسي وما فيهم لذلك منكر % % PageV01P2098 77(@)(@@) % ولولا نهى حلمي إذا لأصبتهم % % بجرمك أو تنفى مهانا وتدحر % % 78(@)(@@) % ولكنني أرعى لهم حق مجدهم % % وأصفح عنهم إن أساؤوا وأغفر % % 79(@)(@@) % وقد بل خصييه بسلحك قابضا % حتارا كعزلاءالمزادة أشتر % % 79(@)(@@) % يكومكما فحلاكما % % يخور من الداء العضال ويجأر % % 79(@)(@@) % فلا أنت منها تستسربسوءة % و هي بالفحشاء منك تستر % % 79(@)(@@) % تظل ترى الجردان فيك مغلغلا % وأنت تراها وهي بالفيش تدسر % % 79(@)(@@) % تناك وعرس السوء منك بمنظر % تناك أخاه بالهنات ويجهر % % 79(@)(@@) % بحيث يراك الله في ملكوته % % وخدك من ذل المعاصي معفر % % 79(@)(@@) % وقفت على فيش الزناة مبالها % % وبيتا قديما كان بالفستق يعمر % % 79(@)(@@) % فيا سوأتا من شيب رأسك بعدها % % إذا ما انتحى فيك الغلام الحزور % % PageV01P2099 79(@)(@@) % سوى أنهم يقرون في استك بعدها % % ثمائل ما تبقيه منهم وتسئر % % 79(@)(@@) % يبيت قرى ضيانه كل ليلة % % بغى وخنزير وخمر وميسر % % 79(@)(@@) % تبيت قوير العين جذلان ضاحكا % إذا هي باتت بين فحلين تشخر % % 79(@)(@@) % بقودك للعهار عرسك طائعا % كأنك مصيور على ذاك مجبر % % 79(@)(@@) % وللشتم في أدنى مخازيك مسبح بقودك للعهار عرسك طائعا كأنك مصيور على ذاك مجبر تبيت قوير العين جذلان ضاحكا إذا هي باتت بين فحلين تشخر وقفت على فيش الزناة مبالهاوبيتا قديما كان بالفستق يعمر يبيت قرى ضيانه كل ليلة بغى وخنزير وخمر وميسر بلا بذل دين % % طويل تجاريه القوافي فتحسر % % 79(@)(@@) % بلا بذل دينار ولا بذل درهم % ينالك منها والمناكح تمهر % % 80(@)(@@) % فلو متما إذ ذاك ما مت غيرة % ولا هي إلا أنها منك أغير % % 81(@)(@@) % أتحسب ما تأتي من الخزي خافيا % على الناس لاتكذب نهارك أنهر % 82(@)(@@) % إذا طيء عدت بناة بنائها % % فحاتمها 
ms532	 الباني وأنت المتبر % 83(@)(@@) % ولو قبلوا نصحي لهم بقبوله % % لواروك حيا فالثرى لك أستر % PageV01P2100 84(@)(@@) % أيوحشهم فقدان قرد وفيهم % بناة المعالي والعديد المجمهر % % 85(@)(@@) % لعمري لقد أصبحت للسيف يانعا % % فيا ليت شعري ما الذي بك ينظر % % 86(@)(@@) % لينفك عن دار الحياة وعنهم % فتى منهم حامي المحيا عزور % % 87(@)(@@) % فوالله ما يثنى عليك بصالح % لسان ولا يثني بذكراك خنصر % % 88(@)(@@) % ولا أنت ممن ينقص القوم فقده % بل الفاقدوك بعد فقدك أكثر % % 89(@)(@@) % أيظلمني يا للبرية خالد % نعم إنه أعلى قرونا وأقهر % % 90(@)(@@) % وأنى يناوي من يصاول قرنه % بقرن يظل الجيش والجيش مظهر % 91(@)(@@) % له شعب لاتعدم الأرض فيئها % % ولو أورقت ما أبصر الشمس مبصر % 92(@)(@@) % ونازعه الشوكي بنت فراشه % % وجرد أيرا فيه للقول مصدر % % 92(@)(@@) % أخالد أعييت الهجاء وفته % فقولي وإن أبلغت فيك مقصر % % PageV01P2101 92(@)(@@) % فقال هبوا أن الفراش لخالد % أليس لهذا كان بالليل يجمر % % 92(@)(@@) % تعيش استه في فضل كعثب عرسه % % فقبح من شيخ يعول استه حر % 92(@)(@@) % إذا هي نيكت نيك أجرة نيكها % % ألا ساء ما يجزى عليه ويؤجر % % 92(@)(@@) % بهاتيك يعطي خالد سؤل نفسه % % وما هو إلا أفطح الرأس أعجز % % 92(@)(@@) % هو البحر إن مثلته قبح يرى % % له راكب إلا الجسور المغرر % % 92(@)(@@) % تفاقم مما لا يزال مفججا % فليس يلاقي مشفرا منه مشفر % % 92(@)(@@) % على أن فيه مرفقين بأنه % % كطوق الرحا منه تبول وتجعر % 92(@)(@@) % مبال لعمري شق للبول كاسمه % % إذا شق للإربين فرج مطهر % 92(@)(@@) % رحيبة شق الفرج أكبر خلقها % % مبال خبيث الريح أخرق أجحر % 92(@)(@@) % وشركته الشوكي في بضع زوجه % % تفسق في جاراتها وتعهر % % PageV01P2102 92(@)(@@) % لقد كان في الشوكي عني لخالد % وفي عرسه سمانة السوء مزجر % % 92(@)(@@) % أما والقوافي المحكمات إذا غدتلقد كان في الشوكي عني لخالد وفي عرسه سمانة السوء مزجر وشركته الشوكي في بضع زوجهتفسق في جاراتها وتعهر رحيبة شق الفرج أكبر خلقهامبال خبيث الريح أخرق أجحر مبال لعمري شق للبول كاسمهإذا شق للإربين فرج مطهر على % % تبسلدوني للعدى وتنمر % % 92(@)(@@) % وما أبعد الشوكي 
ms533	 في ذاك إنه % لأولى بدعوى النسل منه وأذكر % % 92(@)(@@) % لو اطلعت عيناك فيه اطلاعة % رأيت ليبا جولها يتهور % % 93(@)(@@) % وتالله ما أدري أأسكت خاسئا % حسيرا برغمي أم أقول فأعذر % % 94(@)(@@) % أرى كل لؤم في اللئام فإنما % % عصارته من عودك السوء تعصر % % 95(@)(@@) % لؤمت فلو كنت السماء لأمسكت % % حياها وأمسى جوها وهو أغبر % % 96(@)(@@) % خبثت فلو شلشلت في الماء لم يسغ % % لصاد وأضحى صفوه وهو أكدر % % 97(@)(@@) % نطفت فلو ماسست كعبة مكة % بثوبك حاضت حيضة لاتطهر % 98(@)(@@) % ثقلت فغادرت الكواهل كلها % % ثقالا فظهر الأرض من ذاك أدبر % PageV01P2103 99(@)(@@) % قبحت فجاوزت المدى قبح منظر % ويا حسنه من منظر حين تخبر % % 100(@)(@@) % جمعت خلال الشر والعر كلها % % وأنت بها أولى وأحرى وأجدر % % 101(@)(@@) % تحالفك السوءات حيا وميتا % وتبعث مقرونا بها حين تحشر % % 102(@)(@@) % عددت قليلا من كثير معايب % يقصر عنها مجمل ومفسر % % 103(@)(@@) % فدونكها شنعاء حداء يرتمي % % بأمثالها في الأرض مبدى ومحضر % % 104(@)(@@) % تظل مقيما في محلك خافضا % وأنت بها في كل فج تسير % % 105(@)(@@) % نشرتك من موت الخمول بقدرة % لما هو أدهى لو علمت وأنكر % 106(@)(@@) % وللموت خير لامرىء من نشوره % % إذا كان للتخليد في النار ينشر % 107(@)(@@) % هجوتك إنذارا لغيرك حسبة % وخطبك لولا ذاك مما يحقر % PageV01P2104 البحر : - 1(@)(@@) % يا أيها الجائر في سيره % % قصدا فقصد السير من خيره % 2(@)(@@) % لعمر من عرض لي عرضه % ما زجر الميمون من طيره % 3(@)(@@) % بنتك يا خالد فيما يرى % % هي ابنة الشوكي لا غيره % % 4(@)(@@) % دعوه يمتار من فياشلها % % بعلة الطفل تشبع الظير % % 4(@)(@@) % لولا استها جاعت استه أبدا % وعاش ما عاش وهو مضرور % % 4(@)(@@) % يلومه الناس أن تزوجها % % والشيخ لو يعلمون معذور % % 4(@)(@@) % يعيش من طبلها ومن حرها % % فبيته القلطبان معمور % % 4(@)(@@) % فإن يكن بينكما شركة المنسرح لخالد زوجة مكرعة تكريعها في البلاد مشهور يعيش من طبلها ومن حرهافبيته القلطبان معمور يلومه الناس أن تزوجهاوالشيخ لو يعلمون معذور لولا استها جاعت استه أبدا وعاش ما عاش وهو مضرور دعوه يمتار من فياشلهابعلة الطفل تشب 
ms534	 % % فإنها لا شك من أيره % % PageV01P2105 البحر : - 1(@)(@@) % قالوا هجاك أبو حفص فقلت لهم % % قد طال قرن أبي حفص على قصره % 2(@)(@@) % حتى كأن نبيا كان أدركه % % دعا له بشباب القرن في صغره % % 3(@)(@@) % قد عاش دهرا خفيف الرأس نعلمه % % حتى تزوجها بكرا على كبره % 4(@)(@@) % والبكر لا تترك الشبان طائعة % للشيخ من أرذل النصفين من عمره % % 5(@)(@@) % أقول لما علا قرناه صلعته % لبئس ما عوض المسكين من شعره % % PageV01P2106 البحر : - 1(@)(@@) % شاعت له دعوة فأتبعها % % بدعوة واللئيم ذو نظر % 2(@)(@@) % لما ادعى والدا فجاز له % تداخلته حلاوة الظفر % % 3(@)(@@) % فاختار بنتا لكي يكون له % كعثبها وصلة إلى الكمر % % 4(@)(@@) % وما استطرف الأقوزام لي فيه طرفة % لني ما عرفتهم فيه منكرا % % 4(@)(@@) % وما سير الهاجون في الشعر خزية % لعمرك إلا كان في النثر أسيرا % % 4(@)(@@) % طويل حريث نبيطي . . . . . . . . . . . % . . . . . . . . . . . . . % 4(@)(@@) % صك عجان استها بفيشته % % كصكة المنجنيق بالحجر % % 4(@)(@@) % حتى إذا ما اسمغد في يده % % واعتم من جانبيه بالعجز % % 4(@)(@@) % يبركها الشيخ ثم يقبض بال % % خمس على كل محصد المرر % % 4(@)(@@) % لخالد زوجة يلقمها % % بكفه من أطايب الكمر % PageV01P2107 4(@)(@@) % يزعمها بنته وأقسم للشالمنسرح لخالد زوجة يلقمهابكفه من أطايب الكمر يبركها الشيخ ثم يقبض بال خمس على كل محصد المرر حتى إذا ما اسمغد في يدهواعتم من جانبيه بالعجز صك عجان استها بفيشتهكصكة المنجنيق بالحجر طويل حريث نبيطي . . . . . . . . . . . . . . % شوكي أولى بها من البشر % % PageV01P2108 البحر : - 1(@)(@@) % لله لحية حائك أبصرتها % % ما أبصرت عيناي في مقدارها % % 2(@)(@@) % إني لأحسب أن من أشعارها % % هذا الأثاث معا ومن أوبارها % % PageV01P2109 البحر : - 1(@)(@@) % أقول إذا قابلني وجهه % لاسقي الغيث صدى غدر % 2(@)(@@) % فما أراها أوسقت رحمها % % أو شاجه وهي على طهر % 3(@)(@@) % وجهك ياجعفر في قبحه % % أولى من العورة بالستر % 4(@)(@@) % كأنما تأوي إليه الدجى % % إذا هي انفضت عن الفجر % 5(@)(@@) % محلولك أحسب ديباجة % أسففته من حمم القدر % 6(@)(@@) % كذبت بل وجهك في نوره % % واقلب نظير القمر البدر % 7(@)(@@) % إخال ما أتيت من حسنه % % سألته في ليلة القدر % 8(@)(@@) % مفزع إبليس 
ms535	 إليه إذا % % رام فتون العاتق البكر % % 9(@)(@@) % كم حرة قد رام إصباءها % % فما ارعوت منه إلى فكر % % 10(@)(@@) % لو لم يغلغله إلى قلبها % % لرامه من مطلب وعر % % PageV01P2110 11(@)(@@) % أصبحت ملهى لي ومستهزأ % ومرتع العارم من شعري % % 12(@)(@@) % أبشر بأجرين توفاهما % % غدا من الله لدى الحشر % % 13(@)(@@) % أجر على شكرك رب الورى % % وأنت معذور على الكفر % % 14(@)(@@) % لأنه أولاك جل اسمه % % ما لا يجازى عنه بالشكر % % 15(@)(@@) % وشاه تصويرك لم يدخر % % عنك من التشويه من ذخر % % 16(@)(@@) % وأجرك الثاني على خلة % % صاحبها المحقوق بالأجر % % 17(@)(@@) % تترك ذا الغفلة عن ربه % % وربه منه على ذكر % % 18(@)(@@) % يكرر التسبيح من هول ما % % عاين من وجهك ذا عذر % % 19(@)(@@) % فاركب سبيل الغي ثم اقترف % % ما شئت من إثم ومن وزر % % 20(@)(@@) % وأمن عقاب الله لا تخشه % ولا تكن منه على ذعر % % PageV01P2111 21(@)(@@) % تنوس منه وذحات استه % % كأنها أفئدة الجزر % % 21(@)(@@) % وهو لما يلتذ من نيكه % % أنفاسه تصعد في الصدر % % 21(@)(@@) % تخلل الفيشة هلبا له % % قد عم منه شرج الدبر % % 21(@)(@@) % ولو ترى الرجس على اربع % % أمام فحل موثق الأسر % % 21(@)(@@) % من كل فطحاء علت مدمجا % يربي على القبصة والشبر % 21(@)(@@) % ليس لها شاف لدى هيجها % % غير دموع الكمر العجز % % 21(@)(@@) % وفي أبي الفضل على دائه % % بلية في مصدر الجعر % % 21(@)(@@) % فالخزي ققد أ سلفته عاجلا وفي أبي الفضل على دائهبلية في مصدر الجعر ليس لها شاف لدى هيجهاغير دموع الكمر العجز من كل فطحاء علت مدمجا يربي على القبصة والشبر ولو ترى الرجس على اربعأمام فحل موثق الأسر تخلل الفيشة هلبا لهقد عم منه % % فأت الذي تهوى من الأمر % 22(@)(@@) % أقسمت بالقسم في وحيه % وآية بالشفع والوتر % % 23(@)(@@) % أعضاؤها تدعوا إلى قطعها % % كأنها مخلوقة من بظور % % PageV01P2112 23(@)(@@) % لأتركن المسخ أحدوثة يا رب شوهاء لجوج الزناتصطاد بالرفق رجال الفجور وكيف يغشاها بنو آدموالجن من تشويهها في نفور قالت أيادي الله مبسوطة ولي معاش في زكاة الأيور لله جيل كلهم صالح يزدرع البر ولو في الصخور 
ms536	 ضمنت سكري وحريقي الآلى هم للحر % % سائرة تبقى يد الدهر % 23(@)(@@) % يا رب شوهاء لجوج الزنا % % تصطاد بالرفق رجال الفجور % 23(@)(@@) % وكيف يغشاها بنو آدم % % والجن من تشويهها في نفور % % 23(@)(@@) % قالت أيادي الله مبسوطة % ولي معاش في زكاة الأيور % 23(@)(@@) % لله جيل كلهم صالح % يزدرع البر ولو في الصخور % % 23(@)(@@) % ضمنت سكري وحريقي الآلى % % هم للحريق الدهر أو للكسور % % 23(@)(@@) % للكحل والغمرة في وجهها % % والجلجونات شهادات زور % % PageV01P2113 البحر : - 1(@)(@@) % قد عجلت لي عقوبة الخور % وأنت فاحذر عقوبة البطر % 2(@)(@@) % خرت فأملت ما لديك فعو % % قبت بفوت النجاح والظفر % 3(@)(@@) % وأنت أيضا بطرت إذ وردت % % عليك دنيا وشيكة الصدر % 4(@)(@@) % فاصبر ستجزى بما بطرت من الس % سوء كما قد جزيت بالخور % % 5(@)(@@) % ما آمنت نفس من رجاك بما % % أنزل رب السماء في السور % % 6(@)(@@) % هل كان راج يراك عصمته % لولا اتهام القضاء والقدر % % 7(@)(@@) % أسلمتني من يديك في يدي الل % ه وحسبي به من البشر % % 8(@)(@@) % قدما كفاني وما عرفتك في % % بدو من الأرض لا ولا حضر % % 9(@)(@@) % رزقي لست الذي تسببه % مسبب الرزق منشىء الصور % % 10(@)(@@) % فاركب طريقا أراك راكبه % يفضى بركبانه إلى الغير % PageV01P2114 11(@)(@@) % نعماك عندي التي أقربها % % أنك أصبحت لي من العبر % % 12(@)(@@) % أصبحت لي عبرة رأيت بها % % رشدي وقد كنت زائغ البصر % 13(@)(@@) % وشكر تلك اليد الدنيئة إع % % فائيك مني يا تافه الخطر % % 14(@)(@@) % بل ذاك حظي فلست أحسبه % عليك شكرا يا شر مختبر % 15(@)(@@) % والذم شكريك إذ رأيتك ته % % وى الذم فاصبر لشر منتظر % % 16(@)(@@) % وحبك الذم لائق بك ما % % أشبه خطم الخنزير بالقذر % % 17(@)(@@) % أنت الوزير الذي وزارته % معدودة في الكبائر الكبر % % 18(@)(@@) % فاذهب عليك العفاء من رجل % % لابل عليك الدبار في سقر % % 19(@)(@@) % آخر جهلي بك الغداة عتا % % بيك وما للعقاب والحجر % 20(@)(@@) % لا جهل لي بعده وكيف وقد % % كيسني ما وهبت من حذر % % PageV01P2115 21(@)(@@) % لهفي لآصالي التي اتصلت % % في غير شيء لديك بالبكر % % 22(@)(@@) % كدرت قبل استقاء آملك الخا % % ئب قبحا للوجه 
ms537	 والخبر % % 23(@)(@@) % ولو أثارتك دلوه رجعت % إليه مملوءة من المدر % % 24(@)(@@) % وكيف يصفو الذي أثار به % % من كدرت عينه ولم يثر % % 25(@)(@@) % أبديت في أوليات لؤمك ما % % قدرت في أخرياته الأخر % 26(@)(@@) % هلا بدا الصفو منك ثم بدا % % رنقك مثل الطلاء والسكر % % 27(@)(@@) % بل كنت كالأسود الغليظ أخي الن % نتن لمن شمه وذي الوضر % % 27(@)(@@) % أو كدر البدء ثم أعقبهبل كنت كالأسود الغليظ أخي الننتن لمن شمه وذي الوضر % % صفو ففي ذاك وجه معتذر % 28(@)(@@) % كالقطران الذي يرى أبدا % في رأسه ما اقتنى من العكر % % 29(@)(@@) % وذاك يصفو لدى إماطة أع % % لاه وما إن تزال ذا كدر % % PageV01P2116 30(@)(@@) % أصبحت حزت النقيصتين معا % تقصير سعي ضوى إلى قصر % % 31(@)(@@) % دنت بدين من النذالة أدت % % ك إليه لطافة النظر % % 32(@)(@@) % يالك من حكمة ملعنة % أمر ما أثمرت من الثمر % 33(@)(@@) % تغصبه أهله وتمنعه % حقوقه للقمد ذي العجر % % 33(@)(@@) % وكيف يحلو جنى مطاعمهفكر أبا البنت هل تؤثل ماتجمع إلا لناكح ذكر تغصبه أهله وتمنعهحقوقه للقمد ذي العجر واسوأتا للحكيم همتهإشباعه بنته من الكمر يجمع ما يخطب الأيور به غدا إذا غيبته في العفر % % منك بعود من أخبث الشجر % % 33(@)(@@) % واسوأتا للحكيم همته % إشباعه بنته من الكمر % % 33(@)(@@) % فكر أبا البنت هل تؤثل ما % % تجمع إلا لناكح ذكر % % 34(@)(@@) % تضحي وتمسي وأنت ملتمس % أعيط كالرمح من ذوي الطرر % % 34(@)(@@) % لتلك أثلت أو لذي هوج % اصبحت تكنى به أبا العبر % % 34(@)(@@) % وهي تفديه باب الأحمق ال % % مائق والرهز طائر الشرر % % PageV01P2117 34(@)(@@) % ذلك أشهى غليك من نغم الشد % و تناغيه غنة الوتر % % 34(@)(@@) % لهفك أن لا تكون عندهما % % إذا أجابا الحقيق بالنخر % % 34(@)(@@) % لله ماذا يكون بينهما % % إذا تلاقت مداهن السرر % % 34(@)(@@) % ينزو عليها فتستميت له % فيغتدي في النزاء والأشر % % 34(@)(@@) % تبخل إلا على القمد إذا شق % قق ذات الدلال والخفر % % 34(@)(@@) % هل حكمة أن قفل كفك لا % % يفتح إلا بمفتح العذر % 34(@)(@@) % يا أيها الفيلسوف ذا الحكم ال % % جمة مما روى ذوو الفكر % 34(@)(@@) % مطرحا 
ms538	 حق من يلوذ به يا أيها الفيلسوف ذا الحكم ال جمة مما روى ذوو الفكر هل حكمة أن قفل كفك لا يفتح إلا بمفتح العذر تبخل إلا على القمد إذا شققق ذات الدلال والخفر تضحي وتمسي وأنت ملتمس أعيط كالرمح من ذوي الطرر ينزو عليها فتستميت % % إلا المنى أو كواذب العذر % % 34(@)(@@) % يعجبك الفحل في تراجعه % % على عجان الفتاة بالسحر % % 35(@)(@@) % يكنى أبا صالح وصالحه % تكثيره من يحل في الحفر % % PageV01P2118 36(@)(@@) % لاتدعون بالبقاء ويك له % % فموته من أخاير الخير % % 37(@)(@@) % قفاه هول لمن تأمله % ووجهه طيرة من الطير % % 38(@)(@@) % إذا تلوى على مجالسه % في الحفل عاينت شهرة الشهر % % 39(@)(@@) % فإن تعاطى الحديث مات من العي % ي وأبصرت عرة العرر % % 40(@)(@@) % يصفر في السير ماله صفر % ت به دواعي المنون في صفر % % 41(@)(@@) % مبثبثا مثل عمه الأعور المع % % ور أهل الإعوار والعور % % 42(@)(@@) % يتعب جلاسه وينصبهم % % نوكا فيودي بكل مصطبر % % 43(@)(@@) % أودع سواه الذي جمعت له % إن كنت ترعاه يا أبا البقر % % 44(@)(@@) % فلو جمعت الجبال أتلفها % % في غير حق يقضى ولا وطر % % 45(@)(@@) % وإن وقفت الوقوف فاز بها % % قاض يرى ظلم كل ذي صغر % % PageV01P2119 46(@)(@@) % يأكلها تارة ويؤكلها % % طورا وكيلا بأغلظ الأجر % % 47(@)(@@) % وابنك ممن يشيخ وهو من الأي % % تام يا لليتيم ذي الكبر % % 48(@)(@@) % ليس يراه امرؤ فينصفه % والظلم مغرى بكل محتقر % % 49(@)(@@) % لايرتجي المرتجون عدل أبي % % بكر على مثله ولا عمر % % 50(@)(@@) % فاطلب لإرث الشقي عنك غدا % مستودعا إن أثرت أو فذر % % 51(@)(@@) % أودعه أهل الوفاء في منن % تعقد لا في الصرار والبدر % % 52(@)(@@) % أودع له المال لا على جهة ال % % إيداع بل كالحباء والشبر % % 53(@)(@@) % يحفظك فيه المحافظون إذا % % أضحى من الضارطين بالكسر % % 54(@)(@@) % واها لها من نصيحة صدرت % % من صدر حر عليك ذي وحر % % PageV01P2120 البحر : - 1(@)(@@) % ولو شئت ساجلت البحور غزارة % وبادهت قرض الشعر جنة عبقرا % % PageV01P2121 البحر : - 1(@)(@@) % أأبي يوسف دعوة المستصغر % % ويل التي حملتك تسعة أشهر % 2(@)(@@) % ماذا الذي أصليتها في قبرها % % قبل النشور من 
ms539	 اللظى المتسعر % % 3(@)(@@) % أسلمتها للقذع يلفح وجهها % % صبرت له كرها وإن لم تصبر % % 4(@)(@@) % وتقول لضيف الملم سماحة % إن شئت في استيفأتني أو في حر % 4(@)(@@) % يا ابن التي حرمت جنابي قبرهاقطعت شبيبتها زنا وسماحةوتجارة خسرا لذاك المتتجر لم تكتسب أن الدراهم شجوهالكن لترشوهن عند المكبر وكذلك الأكياس تذخر عدةمن مسعد الأزمان للمنتكربظراء عنبلها كعظم ذراعهابخراء ثم أتت بأعمى أبخر % % ومجاوريه حيا السحاب الممطر % % 4(@)(@@) % قطعت شبيبتها زنا وسماحة % وتجارة خسرا لذاك المتتجر % % 4(@)(@@) % لم تكتسب أن الدراهم شجوها % % لكن لترشوهن عند المكبر % % 4(@)(@@) % وكذلك الأكياس تذخر عدة % من مسعد الأزمان للمنتكر % % 4(@)(@@) % بظراء عنبلها كعظم ذراعها % % بخراء ثم أتت بأعمى أبخر % % 4(@)(@@) % فقت الفياشل عينه في بطنها % % فأتت به أعمى قبيح المنظر % % PageV01P2122 4(@)(@@) % ولها مغابن قد أبن صماحها % % لا تستطيب بفيض سبعة أبحر % % 4(@)(@@) % وله طوال الدهر زمرة ناكة % لا يرجعون إليه حتى المحشر % % 4(@)(@@) % أنا كعبة النيك التي نصبت له % فتلق منها حيث شئت فكبر % % 4(@)(@@) % وتبيت بين مقابل ومدابر % مثل الطريق لمقبل ولمدبر % % 4(@)(@@) % يتكافآن الرهز من جهتيهما % % فكلاهما في ذاك غير مقصر % % 4(@)(@@) % كأجيري المبشار يجتذبانه % % متنازعيه في فليج صنوبر % % 4(@)(@@) % وحر إذا ورد الزناة قليبه % % لعنوا الدليل عليه عند المصدر % % 5(@)(@@) % إن ابنها في العالمين لآية % والله أحكم خالق ومصور % % 6(@)(@@) % عجبا لصورته وكيف تشابهت % % منها المعالم وهيش الجوهر % % 7(@)(@@) % خذها إليك مشيحة سيارة % في الناس من باد ومن متحضر % PageV01P2123 8(@)(@@) % تغدو عليك بحاصب وبتارب % على الرواة بلؤلؤ متخير % 9(@)(@@) % كالنار تحرق من تعرض لفحها % % وتكون مرتفق امرىء متنور % 10(@)(@@) % يا ابن الزنا يا ابن الزنا يا ابن الزنا % % والحمد لله العلي الأكبر % PageV01P2124 البحر : - 1(@)(@@) % أأسماء أي الواعدين ترينه % أشدكما مطلا فإني لا أدري % % 2(@)(@@) % أأنت بنيل منك يبرد غلتي % % أم النفس بالسلوان عنك وبالصبر % % PageV01P2125 البحر : - 1(@)(@@) % سألت فأعطيتم قليلا فلم يكن % % غناي ولا استبقى مروتي على فقري % % 2(@)(@@) % بذلتم من المعروف ما فل عفتي % % وقيد تبكيري وضعضع من قدري % % 3(@)(@@) % فلم تصنعوا الحسنى ولم 
ms540	 تفعلوا التي % % أداوي بشكواها الحرارة في صدري % % 4(@)(@@) % فلا لذة الشكوى ولا فرحة الغنى % % وألمظتموني لمظة ثبطت صبري % % 5(@)(@@) % جزيتم جزاء المانع الخير كله % % فإنكم أقسى وآلم من دهري % % PageV01P2126 البحر : - 1(@)(@@) % قل للثوابي إذا جئته % يا ثكل أسماع وأبصار % 2(@)(@@) % إن تستتر مني فقد أكبر % % ت نفسك مني أهل إكبار % % 3(@)(@@) % وما يضير العين ألا ترى % % شبيه بهلول وعمار % % 4(@)(@@) % يا ملقي الردن على وجهه % % لقد تخمرت على عار % % 5(@)(@@) % سترت وجها حق تشويهه % ألا يرى عادم أستار % % 6(@)(@@) % نمت وقد غطيته لحية % كأنها راية بيطار % % 7(@)(@@) % حسبتها من خبث أرواحها % % مخضوبة بالزفت والقار % 8(@)(@@) % يا لك من وجه ومن لحية % ما أشبه الجارة بالجار % 9(@)(@@) % وجه عليه مسحة لم تزل % % تلحظها عين بإنكار % % 10(@)(@@) % يا ليت كفا سترت قبحه % مسمورة فيه بمسمار % % PageV01P2127 11(@)(@@) % أدعو عليها ولها نعمة % ولست للنعمى بكفار % % 12(@)(@@) % مخافة إن فاتنا سترها % % أن نتلقى سوء مقدار % % 13(@)(@@) % نستمتع الله بإحسانها % % فإنها ستر من النار % % 14(@)(@@) % يا عوذة الدار التي أنعمت % عليه بل يا بومة الدار % 15(@)(@@) % بل أنت أحسنت بإلقائها % % على قذاة ذات إضرار % % 16(@)(@@) % ولو تصديت وواقفتني % % كحلت عيني بعوار % % 17(@)(@@) % فاذهب إلى الجنة كيلا ترى % % أنت وأهل الأرض في دار % % 18(@)(@@) % قول امرىء لم ير ما جئته % ضرا ولكن نفع ضرار % % 19(@)(@@) % مضرة البقة في غابة % نالت أذى من أسد ضاري % % 20(@)(@@) % أستغفر الله ولست الذي % % يضر إلا ضر هرار % % PageV01P2128 البحر : - 1(@)(@@) % ألا بيني وبينكم النفار % إلى علمائنا فهم المنار % 2(@)(@@) % فأما فاز قدحكم علينا % % فأقصرنا فما في الحق عار % % 3(@)(@@) % وإما خاب قدحكم وفزنا % % فأقصرتم وألسنكم قصار % % 4(@)(@@) % هنالك تسفر الهبوات عنا % % فيبدو الطرف منا والحمار % 5(@)(@@) % فإن جئنا سواء في عنان % إزاء عذارنا منكم عذار % % 6(@)(@@) % فسلم بعد ذاك وإن أبيتم % % فإعصار تلهب فيه نار % % 7(@)(@@) % وعندي حين تنتضل القوافي % % ويقلص للمحافظة الإزار % % 8(@)(@@) % لسان كالحسام ظهير فكر % كزند المرخ زندته غفار % % 9(@)(@@) % نتائجه عوارم باقيات % % خوالد لا يمح لها حبار % % 