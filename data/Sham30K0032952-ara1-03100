ms3086	 ابن أبي كريمة (الاباضي) = مسلم بن أبي كريمة نحو 145(@)(@@)(@@)(@@) ||| AUT كريمة المروذية(@)(@@) (365 - 463 ه = 975 - 1070 م) كريمة بنت أحمد بن محمد المروذية: محدثة، كانت تروي صحيح البخاري. قال ابن الأثير: انتهى إليها علو الاسناد للصحيح. عاشت قريبا من مئة سنة، ولم تتزوج. أصلها من مرو الروذ، ووفاتها بمكة. ويقال لها أم الكرام وست الكرام (2).(@)(@@)(@@)(@@) ||| AUT بنت الحبقبق(@)(@@) (000 - 641 ه = 000 - 1243 م) كريمة بنت عبد الوهاب بن علي، أم الفضل، القرشية الزبيرية: عالمة بالحديث والفقه، نعتها ابن العماد بمسندة الشام. وقال الحافظ المنذري، بعد أن ذكر بعض شيوخها ومن أخذ عنها: قيل إنها حدثت نيفا وستين سنة، لقيتها ببيت لهيا (بظاهر دمشق) وسمعت منها، وقد كانت أجازت لي في سنة 595 ومولدها تقديرا سنة 454 بدمشق. توفيت ببستانها في " بيت لهيا " ودفنت في جبل قاسيون (3). __________ (1) الاهرام 20 / 3 / 1964 والسوريون في مصر 405 (2) الكامل لابن الأثير 10: 24. (3) شذرات الذهب 5: 212 والتكملة لوفيات النقلة - خ. الجزء التاسع والخمسون. PageV05P0225(@)(@@) NOTMATCH(@)(@@)(@@)(@@) ||| AUT كعب بن الاشرف NOTMATCH(@)(@@) NOTMATCH(@)(@@)(@@)(@@) ||| AUT كعب بن أسد NOTMATCH(@)(@@) الكريمي = محمد بن يوسف 1068 الكريمي = أكمل الدين بن يوسف 1081(@)(@@)(@@)(@@) || AUT كز(@)(@@) ال(@)(@@)(@@)(@@) || AUT كز(@)(@@) بري = محمد بن عبد الرحمن 1221 ال(@)(@@)(@@)(@@) || AUT كز(@)(@@) بري = عبد الرحمن بن محمد 1262(@)(@@)(@@)(@@) || AUT كس(@)(@@) ال(@)(@@)(@@)(@@) || AUT كس(@)(@@) ائي = علي بن حمزة 189 ال(@)(@@)(@@)(@@) || AUT كس(@)(@@) تي = قاسم بن محمد 1328 ال(@)(@@)(@@)(@@) || AUT كس(@)(@@) عي = محارب بن قيس(@)(@@)(@@)(@@) || AUT كش(@)(@@)(@)(@@)(@@)(@@) || AUT كش(@)(@@) اجم = محمود بن حسين 360 ال(@)(@@)(@@)(@@) || AUT كش(@)(@@) ميري (الامامي) = مهدي بن حيدر (1309) ال(@)(@@)(@@)(@@) || AUT كش(@)(@@) ناوي = محمد بن محمد 1154 ال(@)(@@)(@@)(@@) || AUT كش(@)(@@) وان (الكاظمي) = محمد مهدي (1358) ال(@)(@@)(@@)(@@) || AUT كش(@)(@@) ي = محمد بن عمر 340(@)(@@)(@@)(@@) || AUT كع(@)(@@)(@)(@@)(@@)(@@) || AUT كع(@)(@@) ب الاحبار =(@)(@@)(@@)(@@) || AUT كع(@)(@@) ب بن ماتع 32(@)(@@)(@@)(@@) || AUT كع(@)(@@) ب