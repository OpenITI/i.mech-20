ms41	 مستقبل أضر به الصي %~% ف وزر الفحول والتنهاق (@)(@@) 27 أو فريد طاو ، تضيف أرطا %~% ة يبيت في دفها ويضاق (@)(@@) 28 أخرجته قهباء مسبلة الود %~% ق ، رجوس ، قدامها فراق (@)(@@) 29 لم ينم ليلة التمام لكي يص %~% بح ، أضاءه الإشراق (@)(@@) 30 ساهم الوجه من جديلة أو لح %~% يان ، أفنى ضراءه الإطلاق PageV01P141(@)(@@) 31 وتعادى عنه النهار ، تواري %~% ه عراض الرمال والدرداق (@)(@@) 32 وتلته غضف طوارد كانح %~% ل ، مغريث همهن اللحاق (@)(@@) 33 ذاك شبهت ناقتي ، إذ ترامت %~% بي عليها بعد البراق البراق (@)(@@) 34 فعلى مثلها أزور بني قي %~% س ، إذا شط بالحبيب الفراق (@)(@@) 35 وهمما هم ، إذا عزت الحم %~% ر ، وقامت زقاقهم والحقاق (@)(@@) 36 المهينين مالهم لزمان الس %~% وء ، حتى إذا أفاق أفاقوا (@)(@@) 37 وإذا ذو الفضول ضن على المو %~% لى ، وصارت لخيمها الأخلاق (@)(@@) 38 ومشى القوم بالعماد إلى الرز %~% حى ، وأعيا المسيم أين المساق (@)(@@) 39 أخذوا فضلهم هناك ، وقد تج %~% ري على فضلها القداح العتاق (@)(@@) 40 فإذا جادت الدجى ، وضعوا القد %~% ح ، وجن التلاع والآفاق (@)PageV01P142 (@)(@@) 41 لم يزدهم سفاهة شربة الكأ %~% س ، ولا اللهو بينهم والسباق (@)(@@) 42 وإذا ما الأكس شبه بالأر %~% وق عند الهيجا وقل البصاق (@)(@@) 43 ركبت منهم إلى الروع خيل ، %~% غير ميل ، إذ يخطأ الإيفاق (@)(@@) 44 واضعا في سراة نجران رحلي ، %~% ناعما غير أنني مشتاق (@)(@@) 45 في مطابا أربابهن عجال %~% عن ثواء ، وهمهن العراق (@)(@@) 46 درمك لنا غدوة ونشيل ، %~% وصبوح مباكر واغتباق (@)(@@) 47 وندامى بيض الوجوه كأن ال %~% شرب منهم مصاعب ، أفناق (@)(@@) 48 فيهم الخصب والسماحة والنج %~% دة فيهم ، والخاطب المصلاق (@)(@@) 49 وأبيون ، ما يسامون ضيما ، %~% ومكيثون والحلوم وثاق (@)(@@) 50 وترى مجلسا يغص به المح %~% راب ، كالأسد والثياب رقاق PageV01P143(@)(@@) البحر : طويل (@)(@@) 1 أتشفيك ' تيا ' أم تركت بدائكا ، %~% وكانت قتولا للرجال كذلكا (@)(@@) 2 وأقصرت عن ذكر البطالة والصبى ، %~% وكانت سفاها ضلة من ضلالكا (@)(@@) 3 وما كان إلا الحين يوم لقيتها ، %~% وقطع جديد حبلها من حبالكا (@)(@@) 4 وقامت تريني بعدما نام صحبتي %~% بياض ثناياها وأسود حالكا (@)(@@) 5 ويهماء قفر تخرج العين وسطها 
ms42	 ، %~% وتلقى بها بيض النعام ترائكا (@)(@@) 6 يقول بها ذو قوة القوم ، إذ دنا %~% لصاحبه ، إذ خاف منها المهالكا (@)(@@) 7 لك الويل أفش الطرف بالعين حولنا %~% على حذر ، وأبق ما في سقائكا (@)(@@) 8 وخرق مخوف قد قطعت بجسرة %~% إذا الجبس أعيا أن يروم المسالكا (@)(@@) 9 قطعت إذا ما الليل كانت نجومه %~% تراهن في جو السماء سوامكا (@)(@@) 10 بأدماء حرجوج بريت سنامها %~% بسيري عليها بعدما كان تامكا (@)PageV01P144 (@)(@@) 11 لها فخذان تحفزان محالة ، %~% وصلبا كبنيان الصفا متلاحكا (@)(@@) 12 وزورا ترى في مرفقيه تجانفا %~% نبيلا كبيت الصيدلاني دامكا (@)(@@) 13 ورأسا دقيق الحطم صلبا مذكرا ، %~% ودأيا كأعناق الضباع وحاركا (@)(@@) 14 إلى هوذة الوهاب أهديت مدحتي %~% أرجي نوالا فاضلا من عطائكا (@)(@@) 15 تجانف عن جل اليمامة ناقتي ، %~% وما قصدت من أهلها لسوائكا (@)(@@) 16 ألمت بأقوام فعافت حياضهم %~% قلوصي ، وكان الشرب منها بمائكا (@)(@@) 17 فلما أتت آطام جو وأهله ، %~% أنيخت ، وألقت رحلها بفنائكما (@)(@@) 18 ولم يسع في الأقوام سعيك واحد ، %~% وليس إناء للندى كإنائكا (@)(@@) 19 سمعت بسمع الباع والجود والندى %~% فأدليت دلوي ، فاستقت برشائكا (@)(@@) 20 فتى يحمل الأعباء ، لو كان غيره %~% من الناس لم ينهض بها متماسكا (@)PageV01P145 (@)(@@) 21 وأنت الذي عودتني أن تريشني ، %~% وأنت الذي آويتني في ظلالكا (@)(@@) 22 فإنك فيما بيننا في موزع %~% بخير ، وإني مولع بثنائكا (@)(@@) 23 وجدت عليا بانيا ، فورثته ، %~% وطلقا ، وشيبان الجواد ، ومالكا (@)(@@) 24 بحور تقوت الناس في كل لزبة ، %~% أبوك وأعمام هم هؤلائكا (@)(@@) 25 وما ذاك إلا أن كفيك بالندى %~% تجودان بالإعطاء ، قبل سؤالكا (@)(@@) 26 يقولون : في الإكفاء أكبر همه ، %~% ألا رب منهم من يعيش بمالكا (@)(@@) 27 وجدت انهدام ثلمة ، فبنيتها ، %~% فأنعمت إذ ألحقتها ببنائكا (@)(@@) 28 وربيت أيتاما ، وألحقت صبية ، %~% وأدركت جهد السعي قبل عنائكا (@)(@@) 29 ولم يسع في العلياء سعيك ماجد ، %~% ولا ذو إنى في الحي مثل قرئكا (@)(@@) 30 وفي كل عام أنت جاشم غزوة ، %~% تشد لأقصاها عزيم عزائمكا (@)PageV01P146 (@)(@@) 31 مورثة مالا ، وفي الحمد رفعة ، %~% لما ضاع فيها من قروء نسائكا (@)(@@) 32 تخبرهن الطير عنك بأوبة ، %~% وعين أقرت نومها بلقائكا PageV01P147(@)(@@) البحر 
ms43	 : طويل (@)(@@) 1 أيا سيدي نجران لا أوصينكما %~% بنجران فيما نابها ، واعتراكما (@)(@@) 2 فإن تفعلا خيرا وترتديا به ، %~% فإنكما أهل لذاك كلاكما (@)(@@) 3 وإن تكفيا نجران أمر عظيمة ، %~% فقبلكما ما سادها أبواكما (@)(@@) 4 وإن أجلبت صهيون يوما عليكما ، %~% فإن رحى الحرب الدكوك رحاكما (@)PageV01P148(@)(@@) البحر : طويل (@)(@@) 1 لميثاء دار قد تعفت طلولها ، %~% عفتها نضيضات الصبا ، فمسيلها (@)(@@) 2 لما قد تعفى من رماد وعرصة ، %~% بكيت ، وهل يبكي إليك محيلها (@)(@@) 3 لميثاء ، إذ كانت وأهلك جيزة ، %~% رئاء وإذ يفضي إليك رسولها (@)(@@) 4 وإذ تحسب الحب الدخيل لجاجة %~% من الدهر لا تمنى بشيء يزيلها (@)(@@) 5 وإني عداني عنك ، لو تعلمينه ، %~% موازئ لم ينزل سواي جليلها (@)(@@) 6 مصارع إخوان ، وفخر قبيلة %~% علينا ، كأنا ليس منا قبيلها (@)(@@) 7 تعالوا فإن العلم عند ذوي النهى %~% من الناس كالبقاء باد حجولها (@)(@@) 8 نعاطيكم بالحق ، حتى تبينوا %~% على أينا تؤدي الحقوق فضولها (@)(@@) 9 وإلا فعودوا بالهجيم ومازن ، %~% وشيبان عندي جمها وحفيلها (@)(@@) 10 أولئك حكام العشيرة كلها ، %~% وسادتها ، فيما ينوب ، وجولها (@)PageV01P149 (@)(@@) 11 متى أدع منهم ناصري تأت منهم %~% كراديس مأمون علي خذولها (@)(@@) 12 رعالا كأمثال الجراد ، لخيلهم %~% عكوب إذا ثابت سريع نزولها (@)(@@) 13 فإني بحمد الله لم أفتقدكم ، %~% إذا ضم هماما إلي حلولها (@)(@@) 14 أجارتكم بسل علينا محرم ، %~% وجارتنا حل لكم ، وحليلها (@)(@@) 15 فإن كان هذا حكمكم في قبيلة ، %~% فإن رضيت هذا ، فقل قليلها (@)(@@) 16 فإني ورب الساجدين عشية ، %~% وما صك ناقوس النصارى أبيلها (@)(@@) 17 أصالحكم ، حتى تبوءوا بمثلها ، %~% كصرخة حبلى يسرتها قبولها (@)(@@) 18 تناهيتم عنا ، وقد كان فيكم %~% أساود صرعى لم يوسد قتيلها (@)(@@) 19 وإن امرأ يسعى ليقتل قاتلا %~% عداء ، معد جهلة لا يقيلها (@)(@@) 20 ولسنا بذي ع ، ولسنا بكفئه ، %~% كما حدثته نفسها ودخيلها (@)PageV01P150 (@)(@@) 21 ويخبركم حمران أن بناتنا %~% سيهز لن إن لم يرفع العير ميلها (@)(@@) 22 فعيركم كانت أذل ، وأرضكم %~% كما قد علمتم جدبها ومحولها (@)(@@) 23 فإن تمنعوا منا المشقر والصفا ، %~% فإنا وجدنا الخط جما نخيلها (@)(@@) 24 وإن لنا درنى ، فكل عشية %~% يحط إلينا خمرها وخميلها (@)(@@) 25 أبالموت خشتني 
ms44	 عباد ، وإنما %~% رأيت منايا الناس يسعى دليلها (@)(@@) 26 فما ميتة إن متها غير عاجز %~% بعار ، إذا ما غالت النفس غولها (@)PageV01P151(@)(@@) البحر : طويل (@)(@@) 1 أقيس بن مسعود بن قيس بن خالد ، %~% وأنت امرؤ ترجو شبابك وائل (@)(@@) 2 أطورين في عام : غزاة ورحلة ، %~% ألا ليت قيسا غرفته القوابل (@)(@@) 3 وليتك حال البحر دونك كله ، %~% وكنت لقى تجري عليه السوائل (@)(@@) 4 كأنك لم تشهد قرابين جمة ، %~% تعيث ضباع فيهم ، وعواسل (@)(@@) 5 تركتهم صرعى لدى كل منهل ، %~% وأقبلت تبغي الصلح ، أمك هابل (@)(@@) 6 أمن جبل الأمرار صرت خيامكم %~% على نبإ أن الأشافي سائل (@)(@@) 7 فهان علينا أن تجف وطابكم %~% إذا حنيت فيها لديك الزواجل (@)(@@) 8 لقد كان في شيبان لو كنت راضيا ، %~% قباب وحي حلة ، وقنابل (@)(@@) 9 ورجراجة تعشي النواظر فخمة ، %~% وجرد على أكنافهن الرواحل (@)(@@) 10 تركتهم جهلا وكنت عميدهم ، %~% فلا يبلغني عنك ما أنت فاعل PageV01P152(@)(@@) 11 وعريت من وفر ومال جمعته ، %~% كما عريت مما تسر المغازل (@)(@@) 12 شفى النفس قتلى لم توسد خدودها %~% وسادا ولم تعضض عليها الأنامل (@)(@@) 13 بعينيك يوم الحنو إذ صبحتهم %~% كتائب موت لم تعقها العواذل (@)PageV01P153(@)(@@) البحر : طويل (@)(@@) 1 يلمن الفتى ، إن زلت النعل زلة ، %~% وهن على ريب المنون خواذل (@)(@@) 2 يقلن حياة بعد موتك مرة ، %~% وهن لإذا قفين عنك ذواهل (@)(@@) 3 متى تأتنا تعدو بسرجك لقوة %~% صبور تجنبنا ورأسك مائل (@)(@@) 4 صددت عن الأعداء يوم عباعب %~% صدود المذاكي أقرعتها المساحل (@)PageV01P154(@)(@@) البحر : طويل (@)(@@) 1 فيا أخوينا من عباد ومالك ، %~% ألأم تعلما أن كل من فوقها لها (@)(@@) 2 وتستيقنوا أنا أخوكم ، وأننا %~% إذا سنحت شهباء تخشون فالها (@)(@@) 3 نقيم لها سوق الجلاد ونغتلي %~% بأسيافنا حتى نوجه خالها (@)(@@) 4 وإن معدا لن تجاز بفعلها ، %~% وإن إيادا لم تقدر مثالها (@)(@@) 5 أفي كل عام بيضة تفقؤونها ، %~% فتؤذى ، وتبقى بيضة لا أخالها (@)(@@) 6 وكائن دفعنا عنكم من ملية ، %~% وكربة موت قد بيينا عقالها (@)(@@) 7 وأرملة تسعى بشعث ، كأنها %~% وإياهم ربداء حثت رئالها (@)(@@) 8 هنأنا ولم نمنن عليها ، فأصبحت %~% رخية بال قد أزحنا هزالها (@)PageV01P155(@)(@@) البحر 
ms45	 : طويل (@)(@@) 1 صحا القلب من ذكرى قتيلة بعدما %~% يكون لها مثل الأسير المكبل (@)(@@) 2 لها قدم ريا ، سباط بنانها ، %~% قد اعتدلت في حسن خلق مبتل (@)(@@) 3 وساقان مار اللحم مورا عليهما ، %~% إلى منتهى خلخالها المتصلصل (@)(@@) 4 إذا التمست أربيتاها تساندت %~% لها الكف في راب من الخلق مفضل (@)(@@) 5 إلى هدف فيه ارتفاع ترى له %~% من الحسن ظلا فوق خلق مكمل (@)(@@) 6 إذا انبطحت جافى عن الأرض جنبها ، %~% وخوى بها راب كهامة جنبل (@)(@@) 7 إذا ما علاها فارس متبذل ، %~% فنعم فراش الفارس المتبذل (@)(@@) 8 ينوء بها بوص ، إذا ما تفضلت %~% توعب عرض الشرعبي المغيل (@)(@@) 9 روادفه تثني الرداء تساندت %~% إلى مثل دعص الرملة المتهيل (@)(@@) 10 نياف كغصن البان ترتج إن مشت %~% دبيب قطا البحطاء في كل منهل (@)PageV01P156 (@)(@@) 11 وثديان كالرمانتين ، وجيدها %~% كجيد غزال غير أن لم يعطل (@)(@@) 12 وتضحك عن غر الثنايا كأنه %~% ذرى أقحوان نبته لم يفلل (@)(@@) 13 تلألؤها مثل اللجين ، كأنما %~% ترى مقلتي رئم ولو لم تكحل (@)(@@) 14 سجوين برجاوين في حسن حاجب ، %~% وخد أسيل ، واضح ، متهلل (@)(@@) 15 لها كبد ملساء ذات أسرة ، %~% ونحر كفاثور الصريف الممثل (@)(@@) 16 يجول وشاحاها على أخمصيهما ، %~% إذا انفتلت جالا عليها يجلجل (@)(@@) 17 فقد كملت حسنا فلا شيء فوقها ، %~% وإني لذو قول بها متنخل (@)(@@) 18 وقد علمت بالغيب أني أحبها ، %~% وأني لنفسي مالك في تجمل (@)(@@) 19 وما كنت أشكى قبل قتلة بالصبى ، %~% وقد ختلتني بالصبى كل مختل (@)(@@) 20 وإني إذا ما قلت قولا فعلته ، %~% ولست بمخلاف لقولي مبدل PageV01P157(@)(@@) 21 تهالك حتى تبطر المرء عقله ، %~% وتصبي الحليم ذا الحجى بالتقتل (@)(@@) 22 إذا لبست شيدارة ثم أبرقت %~% بمعصمها ، والشمس لما ترجل (@)(@@) 23 وألوت بكف في سوار يزينها %~% بنان كهداب الدمقس المفتل (@)(@@) 24 رأيت الكريم ذا الجلالة رانيا ، %~% وقد طار قلب المستخف المعدل (@)(@@) 25 فدعها وسل الهم عنك بجسرة %~% تزيد في فضل الزمام وتعتلي (@)(@@) 26 فأية أرض لا أتيت سراتها ، %~% وأية أرض لم أجبها بمرحل (@)(@@) 27 ويوم حمام قد نزلناه نزلة ، %~% فنعم مناخ الضيف والمتحول (@)(@@) 28 فأبلغ 
ms46	 بني عجل رسولا وأنتم %~% ذوو نسب دان ومجد مؤثل (@)(@@) 29 فنحن عقلنا الألف عنكم لأهله ، %~% ونحن وردنا بالغبوق المعجل (@)(@@) 30 ونحن رددنا الفارسيين عنوة ، %~% ونحن كسرنا فيهم رمح عبدل PageV01P158(@)(@@) 31 فأي فلاح الدهر يرجو سراتنا ، %~% إذا نحن فيما ناب لم نتفضل (@)(@@) 32 وأي بلاء الصدق لا قد بلوتم ، %~% فما فقدت كانت بلية مبتلي (@)PageV01P159(@)(@@) البحر : طويل (@)(@@) 1 أتصرم ريا أم تديم وصالها ، %~% بل الصرم إذ رمت بليل جمالها (@)(@@) 2 كأن حدوج المالكية غدوة ، %~% نواعم يجري الماء رفها خلالها (@)(@@) 3 وما أم خشف جأبة القرن فاقد %~% على جانبي تثليث تبغي غزالها (@)(@@) 4 بأحسن منها يوم قام نواعم ، %~% فأنكرن ، لما واجهتهن ، حالها (@)(@@) 5 فيا أخوينا من أبينا وأمنا ، %~% ألم تعلما أن كل من فوقها لها (@)(@@) 6 فتستيقنا أنا أخوكم ، وأننا %~% إذا نتجت شهباء يخشون فالها (@)(@@) 7 نقيم لها سوق الضراب ونعتصي %~% بأسيافنا حتى نوجه خالها (@)(@@) 8 وكائن دفعنا عنكم من عظيمة ، %~% وكربة موت قد بتتنا عقالها (@)(@@) 9 وأرملة تسعى بشعث ، كأنها %~% وإياهم ربداء حثت رئالها (@)(@@) 10 هنأنا ولم نمنن عليها ، فأصبحت %~% رخية بال قد أزحنا هزالها (@)PageV01P160 (@)(@@) 11 وفي كل عام بيضة تفقهونها ، %~% فتعنى ، وتبقى بيضة لا أخا لها (@)PageV01P161(@)(@@) البحر : بسيط تام (@)(@@) 1 ودع هريرة إن الرلاكب مرتحل ، %~% وهل تطيق وداعا أيها الرجل ؟ (@)(@@) 2 غراء فرعاء مصقول عوارضها ، %~% تمشي الهوينا كما يمشي الوجي الوحل (@)(@@) 3 كأن مشيتها من بيت جارتها %~% مر السحابة ، لا ريث ولا عجل (@)(@@) 4 تسمع للحلي وسواسا إذا انصرفت %~% كما استعان بريح عشرق زجل (@)(@@) 5 ليست كمن يكره الجيران طلعتها ، %~% ولا تراها لسر الجار تختتل (@)(@@) 6 يكاد يصرعها ، لولا تشددها ، %~% إذا تقوم إلى جاراتها الكسل (@)(@@) 7 إذا تعالج قرنا ساعة فترت ، %~% واهتز منها ذنوب المتن والكفل (@)(@@) 8 ملء الوشاح وصفر الدرع بهكنة %~% إذا تأتى يكاد الخصر ينخزل (@)(@@) 9 صدت هريرة عنا ما تكلمنا ، %~% جهلا بأم خليد حبل من تصل ؟ (@)(@@) 10 أأن رأت رجلا أعشى أضر به %~% للذة المرء لا جاف ولا تفل PageV01P162(@)(@@) 11 هركولة ، فنق ، درم مرافقها ، %~% كأن أخمصنها بالشوك منتعل 
ms47	 (@)(@@) 12 إذا تقوم يضوع المسك أصورة ، %~% والزنبق الورد من أردانها شمل (@)(@@) 13 ما روضة من رياض الحزن معشبة %~% خضراء جاد عليها مسبل هطل (@)(@@) 14 يضاحك الشمس منها كوكب شرق %~% مؤزر بعميم النبت مكتهل (@)(@@) 15 يوما بأطيب منها نشر رائحة ، %~% ولا بأحسن منها إذ دنا الأصل (@)(@@) 16 علقتها عرضا ، وعلقت رجلا %~% غيري ، وعلق أخرى غيرها الرجل (@)(@@) 17 وعلقته فتاة ما يحاولها ، %~% من أهلها ميت يهذي بها وهل (@)(@@) 18 وعلقتني أخيرى ما تلائمني ، %~% فاجتمع الحب حبا كله تبل (@)(@@) 19 فكلنا مغرم يهذي بصاحبه ، %~% ناء ودان ، ومحبول ومحتبل (@)(@@) 20 قالت هريرة لما جئت زائرها : %~% ويلي عليك ، وويلي منك يا رجل (@)PageV01P163 (@)(@@) 21 يا من يرى عارضا قد بت أرقبه ، %~% كأنما البرق في حافاته الشعل (@)(@@) 22 له رداف ، وجوز مفأم عمل ، %~% منطق بسجال الماء متصل (@)(@@) 23 لم يلهني اللهوعنه حين أرقبه ، %~% ولا اللذاذة من كأس ولا الكسل (@)(@@) 24 فقلت للشرب في درني وقد ثملوا : %~% شيموا ، وكيف يشيم الشارب الثمل (@)(@@) 25 برقا يضيء على أجزاع مسقطه ، %~% وبالخبية منه عارض هطل (@)(@@) 26 قالوا نمار ، فبطن الخال جادهما ، %~% فالعسجدية فالأبلاء فالرجل (@)(@@) 27 فالسفح يجري فخنزير فبرقته ، %~% حتى تدافع منه الربو ، فالجبل (@)(@@) 28 حتى تحمل منه الماء تكلفة ، %~% روض القطا فكثيب الغينة السهل (@)(@@) 29 يسقي ديارا لها قد أصبحت عزبا ، %~% زورا تجانف عنها القود والرسل (@)(@@) 30 وبلدة مثل ظهر الترس موحشة ، %~% للجن بالليل في حافاتها زجل (@)PageV01P164 (@)(@@) 31 لا يتمنى لها بالقيظ يركبها ، %~% إلا الذين لهم فيما أتوا مهل (@)(@@) 32 جاوزتها بطليح جسرة سرح ، %~% في مرفقيها إذا استعرضتها فتل (@)(@@) 33 إما ترينا حفاة لا نعال لنا ، %~% إنا كذلك ما نحفى وننتعل (@)(@@) 34 فقد أخالس رب البيت غفلته ، %~% وقد يحاذر مني ثم ما يئل (@)(@@) 35 وقد أقود الصبى يوما فيتبعني ، %~% وقد يصاحبني ذوالشرة الغزل (@)(@@) 36 وقد غدوت إلى الحانوت يتبعني %~% شاو مشل شلول شلشل شول (@)(@@) 37 في فتية كسيوف الهند قد علموا %~% أن ليس يدفع عن ذي الحيلة الحيل (@)(@@) 38 نازعتهم قضب الريحان متكئا ، %~% وقهوة مزة راووقها خضل (@)(@@) 39 لا يستفيقون 
ms48	 منها ، وهي راهنة ، %~% إلا بهات ! وإن علوا وإن نهلوا (@)(@@) 40 يسعى بها ذو زجاجات له نطف ، %~% مقلص أسفل السربال معتمل PageV01P165(@)(@@) 41 مستجيب تخال الصنج يسمعه ، %~% إذا ترجع فيه القنية الفضل (@)(@@) 42 من كل ذلك يوم قد لهوت به ، %~% وفي التجارب طول اللهو والغزل (@)(@@) 43 والساحبات ذيول الخز آونة ، %~% والرافلات على أعجازها العجل (@)(@@) 44 أبلغ يزيد بني شيبان مألكة ، %~% أبا ثبيت ! أما تنفك تأتكل ؟ (@)(@@) 45 ألست منتهيا عن نحت أثلتنا ، %~% ولست ضائرها ما أطت الإبل (@)(@@) 46 تغري بنا رهط مسعود وإخوته %~% عند اللقاء ، فتردي ثم تعتزل (@)(@@) 47 لأعرفنك إن جد النفير بنا ، %~% وشبت الحرب بالطواف واحتملوا (@)(@@) 48 كناطح صخرة يوما ليفلقها ، %~% فلم يضرها وأوهى قرنه الوعل (@)(@@) 49 لأعرفنك إن جدت عداوتنا ، %~% والتمس النصر منكم عوض تحتمل (@)(@@) 50 تلزم أرماح ذي الجدين سورتنا %~% عند اللقاء ، فترديهم وتعتزل (@)PageV01P166 (@)(@@) 51 لا تقعدن ، وقد أكلتها حطبا ، %~% تعوذ من شرها يوما وتبتهل (@)(@@) 52 قد كان في أهل كهف إن هم قعدوا ، %~% والجاشرية من يسعى وينتضل (@)(@@) 53 سائل بني أسد عنا ، فقد علموا %~% أن سوف يأتيك من أنبائنا شكل (@)(@@) 54 واسأل قشيرا وعبد الله كلهم ، %~% واسأل ربيعة عنا كيف نفتعل (@)(@@) 55 إنا نقاتلهم ثمت نقتلهم %~% عند اللقاء ، وهم جاروا وهم جهلوا (@)(@@) 56 كلا زعمتم بأنا لا نقاتلكم ، %~% إنا لأمثالكم ، يا قومنا ، قتل (@)(@@) 57 حتى يظل عميد القوم متكئا ، %~% يدفع بالراح عنه نسوة عجل (@)(@@) 58 أصابه هندواني ، فأقصده ، %~% أو ذابل من رماح الخط معتدل (@)(@@) 59 قد نطعن العير في مكنون فائله ، %~% وقد يشيط على أرماحنا البطل (@)(@@) 60 هل تنتهون ؟ ولا ينهى ذوي شطط %~% كالطعن يذهب فيه الزيت والفتل (@)PageV01P167 (@)(@@) 61 إني لعمر الذي خطت مناسمها %~% له وسيق إليه الباقر الغيل (@)(@@) 62 لئن قتلتم عميدا لم يكن صددا ، %~% لنقتلن مثله منكم فنمتثل (@)(@@) 63 لئن منيت بنا عن غب معركة %~% لم تلفنا من دماء القوم ننتفل (@)(@@) 64 نحن الفوارس يوم الحنو ضاحية %~% جنبي ' فطينة ' لا ميل ولا عزل (@)(@@) 65 قالوا الركوب ! فقلنا تلك عادتنا ، %~% أو تنزلون ، فإنا معشر نزل (@)PageV01P168(@)(@@) البحر : كامل 
ms49	 تام (@)(@@) 1 رحلت سمية ، غدوة ، أجمالها ، %~% غضبى عليك ، فما تقول بدا لها (@)(@@) 2 هذا النهار بدا لها من همها ، %~% ما بالها بالليل زال زوالها (@)(@@) 3 سفها ، وما تدري سمية ، ويحها ، %~% أن رب غانية صرمت وصالها (@)(@@) 4 ومصاب غادية كأن تجارها %~% نشرت عليه برودها ورحالها (@)(@@) 5 قد بت رائدها ، وشاة محاذر %~% حذرا يقل بعينه أغفالها (@)(@@) 6 فظلت أرعاها ، وظل يحوطها ، %~% حتى دنوت إذا الظلام دنا لها (@)(@@) 7 فرميت غفلة عينه عن شاته ، %~% فأصبت حبة قلبها وطحالها (@)(@@) 8 حفظ النهار وبات عنها غافلا ، %~% فخلت لصاحب لذة وخلا لها (@)(@@) 9 وسبيئة مما تعتق بابل ، %~% كدم الذبيح سلبتها جريالها (@)(@@) 10 وغريبة تأتي الملوك حكيمة ، %~% قد قلتها ليقال من ذا قالها (@)PageV01P169 (@)(@@) 11 وجزور أيسار دعوت لحتفها ، %~% ونياط مقفرة أخاف ضلالها (@)(@@) 12 يهماء موحشة ، رفعت لعرضها %~% طرفي لأقدر بينها أميالها (@)(@@) 13 بجلالة سرح كأن بغرزها %~% هرا إذا انتعل المطي ظلالها (@)(@@) 14 عسفا وإرقال الهجير ترى لها %~% خدما تساقط بالطريق نعالها (@)(@@) 15 كانت بقية أربع فاعتمتها %~% لما رضيت مع النجابة آلها (@)(@@) 16 فتركتها ، بعد المراح ، رذية ، %~% وأمنت بعد ركوبها إعجالها (@)(@@) 17 فتناولت قيسا بحر بلاده ، %~% فأتته بعد تنوفة ، فأنالها (@)(@@) 18 فإذا تجوزها حبال قبيلة ، %~% أخذت من الأخرى إليك حبالها (@)(@@) 19 قيل امرء طلق اليدين مبارك ، %~% ألفى أباه بنجوة فسما لها (@)(@@) 20 فكأنها لم تلق ستة أشهر %~% ضرا إذا وضعت إليك جلالها PageV01P170 (@)(@@) 21 ولقد نزلت بخير من وطئ الحصى %~% قيس فأثبت نعلها وقبالها (@)(@@) 22 ما النيل أصبح زاجرا من مده ، %~% جادت له ريح الصبا فجرى لها (@)(@@) 23 زبدا ببابل ، فهو يسقي أهلها ، %~% رغدا تفجره النبيط خلالها (@)(@@) 24 يوما بأجود نائلا منه ، إذا %~% نفس البخيل تجهمت سؤالها (@)(@@) 25 الواهب المائة الهجان وعبدها ، %~% عوذا تزجي خلفها أطفالها (@)(@@) 26 والقارح العدا ، وكل طمرة ، %~% ما إن تنال يد الطويل قذالها (@)(@@) 27 وكأنما تبع الصوار بشخصها %~% عجزاء ترزق بالسلي عيالها (@)(@@) 28 طلبا حثيثا بالوليد تبزه ، %~% حتى توسط رمحه أكفالها (@)(@@) 29 عودت كندة عادة ، فاصبر لها ، %~% اغفر لجاهلها ، ورو سجالها (@)(@@) 30 وكن لها جملا 
ms50	 ذلولا ظهره ، %~% احمل ، وكنت معاودا تحمالها (@)PageV01P171 (@)(@@) 31 وإذا تحل من الخطوب عظيمة ، %~% أهلي فداؤك ، فاكفهم أثقالها (@)(@@) 32 فلعمر من جعل الشهور علامة %~% قدرا ، فبين نصفها وهلالها (@)(@@) 33 ما كنت في الحرب العوان مغمرا ، %~% إذ شب حر وقودها أجزالها (@)(@@) 34 وسعى لكندة غير سعي مواكل %~% قيس فضر عدوها وبني لها (@)(@@) 35 وأهان صالح ماله لفقيرها ، %~% وأسا وأصلح بينها ، وسعى لها (@)(@@) 36 ما إن تغيب لها كما غاب امرؤ %~% هانت عشيرته عليه ، فغالها (@)(@@) 37 وترى له ضرا على أعدائه ؛ %~% وترى لنعمته على من نالها (@)(@@) 38 أثرا من الخير المزين أهله ، %~% كالغيث صاب ببلدة ، فأسالها (@)(@@) 39 ثقف ، إذا نالت يداه غنيمة ، %~% شد الركاب لمثلها لينالها (@)(@@) 40 بالخيل شعثا ما تزال جيادها %~% رجعا تغادر بالطريق سخالها (@)PageV01P172 (@)(@@) 41 أما لصاحب نعمة طرحتها ، %~% ووصال رحم قد نضحت بلالها (@)(@@) 42 طال القياد بها فلم تر تربعا %~% للخيل ذا رسن ، ولا أعطالها (@)(@@) 43 وسمعت أكثر ما يقال لها اقدمي ، %~% والنص والإيجاف كان صقالها (@)(@@) 44 حتى إذا لمع الدليل بثوبه ، %~% سقيت ، وصب رواتها أشوالها (@)(@@) 45 فكفى العضاريط الركاب فبددت %~% منه لأمر مؤمل ، فأجالها (@)(@@) 46 فترى سوابقها يثرن عجاجة ، %~% مثل السحاب ، إذا قفوت رعالها (@)(@@) 47 متباريات في الأعنة قطبا ، %~% حتى تفيء عشية أنفالها (@)(@@) 48 فأصبن ذا كرم ، ومن أخطأنه %~% جزأ المقيظة خشية أمثالها (@)(@@) 49 ولبون معزاب حويت فأصبحت %~% نهبى ، وآزلة قضبت عقالها (@)(@@) 50 ولقد جررت إلى الغنى ذا فاقة ، %~% وأصاب غزوك إمة فأزالها (@)PageV01P173 (@)(@@) 51 وإذا تجيء كتيبة ملمومة %~% خرساء تغثي من يذود نهالها (@)(@@) 52 تأوي طوائفها إلى مخضرة ، %~% مكروهة يخشى الكماة نزالها (@)(@@) 53 كنت المقدم غير لابس جنة ، %~% بالسيف تضرب معلما أبطالها (@)(@@) 54 وعلمت أن النفس تلقى حتفها ، %~% ما كان خالقها المليك قضى لها (@)PageV01P174(@)(@@) البحر : مجزوء الكامل (@)(@@) 1 قالت سمية : من مدح %~% ت ؟ فقلت : مسروق بن وائل (@)(@@) 2 عدي لغيبي أشهرا ، %~% إني لدى خير المقاول (@)(@@) 3 الناس حول قبابه ، %~% أهل الحوائج والمسائل (@)(@@) 4 يتبادرون فنلءه ، %~% قبل الشروق ، وبالأصائل (@)(@@) 5 فإذا رأوه خاشعا ، %~% خشعوا لذي تاج حلاحل (@)(@@) 6 أضحى بعانة زاخرا 
ms51	 %~% فيه الغثاء من المسايل (@)(@@) 7 خشي الصراري صولة %~% منه فعاذوا بالكوائل (@)(@@) 8 فترى النبيط عشية ، %~% راوي المزارع ، بالحوافل (@)(@@) 9 يوما بأجود نائلا %~% مالحضرمي أخي الفواضل (@)(@@) 10 الواهب لاقينات طال %~% غزلان في عقد الحمائل PageV01P175 (@)(@@) 11 يركضن كل عشية ، %~% عصب المريش والمراجل (@)(@@) 12 والتارك القرن الكم %~% ي مجدلا ، رعيش الأنامل (@)(@@) 13 والقائد الخيل العتا %~% ق ضوامرا لخن الأياطل (@)(@@) 14 ما مشبل ورد الجبي %~% ن مهرت الشدقين باسل (@)(@@) 15 القادسيةمألف %~% منه فأودية الغياطل (@)(@@) 16 يدع الوحاد من الرجا %~% ل ، منه على البطل المنازل (@)(@@) 17 طال الثواء لدى تري %~% م وقد نأت بكر بن وائل (@)(@@) 18 قومي بنو البرشاء ثع %~% لبة المجالس ، والمحافل PageV01P176(@)(@@) البحر :مجزوء الكامل (@)(@@) 1 هل أنت يا مصلات مب %~% تكر ، غداة غد ، فزاحل (@)(@@) 2 إنا لدى ملك بشب %~% وة ما تغب له النواقل (@)(@@) 3 متحلب الكفين مث %~% ل البدر ، قوال ، وفاعل (@)(@@) 4 الواهب المائة الصفا %~% يا ، بين تالية وحائل (@)(@@) 5 ولقد شربت الخمر تر %~% كض حولنا ترك وكابل (@)(@@) 6 كدم الذبيح غريبة ، %~% مما يعتق أهل بابل (@)(@@) 7 باكرتها ، حولي ذوو ال %~% آكال من بكر بن وائل (@)(@@) 8 أمل القباب الحمر وال %~% نعم المؤبل ، والقنابل (@)(@@) 9 كم فيهم من شطبة %~% ومقلص نهد المراكل (@)(@@) 10 بل رب مجر جحفل ، %~% عبل ، يضمر بالأصائل PageV01P177 (@)(@@) 11 وهم على جرد مغا %~% وير ، عليهن الرحائل (@)(@@) 12 ة ، كالنعامات الجوافل %~%(@)(@@) 13 يخرجن من خلل الغب %~% ر عوابسا ، لحق الأياطل (@)(@@) 14 كم قد تركن مجدلا ، %~% من بين منقصف وجافل (@)(@@) 15 زيافة أرمي بها ، %~% بالليل معرضة المحافل (@)(@@) 16 وكأنها بعد الكلا %~% ل ، مكدم من حمر عاقل (@)(@@) 17 متربع منها ريا %~% ضا صابها ودق الهواطل (@)(@@) 18 يهوي به ملك حلاحل %~%(@)(@@) 19 غادرته متجدلا ، %~% بالقاع تنهسه الفراعل (@)(@@) 20 ولقد يحاول أن يقو %~% م ، وقد مضت فيه النواهل PageV01P178(@)(@@) البحر :متقارب تام (@)(@@) 1 ألا قل لتياك ما بالها ، %~% أللبين تحدج أحمالها (@)(@@) 2 أم للدلال ، فإن الفتا %~% ة حق على الشيخ إدلالها (@)(@@) 3 فإن يك هذا الصبى قد نبا %~% وتطلاب تيا وتسآلها (@)(@@) 4 فأنى تحول ذا 
ms52	 لمة ، %~% وأنى لنفسك أمثالها (@)(@@) 5 عسيب القيام ، كثيب القعو %~% د ، وهنانة ، ناعم بالها (@)(@@) 6 إذا أدبرت خلتها دعصة ، %~% وتقبل كالظبي تمثالها (@)(@@) 7 وفي كل منزلة بتها ، %~% يؤرق عينيك أهوالها (@)(@@) 8 هي الهم لو ساعفت دارها ، %~% ولكن نأى عنك تحلالها (@)(@@) 9 وصهباء صرف كلون الفصوص ، %~% سريع إلى الشرب إكسالها (@)(@@) 10 تريك القذى وهي من دونه ، %~% إذا ما يصفق جريالها PageV01P179 (@)(@@) 11 شربت ، إذا الراح بعد الأصي %~% ل طابت ، ورفع أطلالها (@)(@@) 12 وأبيض كالنجم آخيته ، %~% وبياء مطرد آلها (@)(@@) 13 قطعت ، إذا خب ريعانها ، %~% ونطق بالهول أغفالها (@)(@@) 14 بناحية من سراة الهجا %~% ن تأتي الفجاج ، وتغتالها (@)(@@) 15 تراها كأحقب ذي جدتي %~% ن ، يجمع عونا ويجتالها (@)(@@) 16 نحائص شتى على عينيه ، %~% حلائل لم يؤذه قالها (@)(@@) 17 عنيف ، وإن كان ذا شرة ، %~% بجمع الضرائر شلالها (@)(@@) 18 إذا حال من دونها غبية %~% من الترب ، فانجال سربالها (@)(@@) 19 فلم يرض بالقرب حتى يكون %~% وسادا للحييه أكفالها (@)(@@) 20 أقام الضغائن من درئها ، %~% كفتل الأعنة فتالها PageV01P180 (@)(@@) 21 فذلك شبهته ناقتي ، %~% وما إن لغيرك إعمالها (@)(@@) 22 وكم دون بيتك من مهمه %~% وأرض ، إذا قيس أميالها (@)(@@) 23 يحاذر منها على سفرها ، %~% مهامه تيه وأغوالها (@)(@@) 24 فمنك تؤوب ، إذا أدبرت ، %~% ونحوك يعطف إقبالها (@)(@@) 25 إياس ، وأنت امرؤ لا يرى %~% لنفسك في القوم معدالها (@)(@@) 26 أبر يمينا ، إذا أقسموا ، %~% وأفضل إن عد أفضالها (@)(@@) 27 وجارك لا يتمنى علي %~% ه ، إلا التي هو يقتالها (@)(@@) 28 كأن الشموس بها بيته ، %~% يطيف حواليه أوعالها (@)(@@) 29 وكاملة الرجل والدارعين ، %~% سريع إلى القوم إيغالها (@)(@@) 30 سموت إليها برجراجة ، %~% PageV01P181 (@)(@@) 31 ومعقودة العزم من رأيه ، %~% قليل من الناس يحتالها (@)(@@) 32 تمممت عليها ، فأتممتهاه ، %~% وتم بأمرك إكمالها (@)(@@) 33 وإن إياسا متى تدعه ، %~% إذا ليلة طال بلبالها (@)(@@) 34 أخ للحفيظة حمالها ، %~% حشود عليها وفعالها (@)(@@) 35 وفي الحرب منه بلاء ، إذا %~% عوان توقد أجذالها (@)(@@) 36 وصبر على الدهر في رزئه ، %~% وإعطاء كف وإجزالها (@)(@@) 37 وتقوداه الخيل حتى يطو %~% ل كر الرواة ، وإيغالها (@)(@@) 38 إذا أدلجوا ليلة والركا %~% ب خوض تخضخض أشوالها (@)(@@) 39 وتسمع فيها 
ms53	 هبي واقدمي ، %~% ومرسون خيل وأعطالها (@)(@@) 40 ونهنه منه له الوازعو %~% ن ، حتى إذا حان إرسالها PageV01P182 (@)(@@) 41 أجيلت كمر ذنوب القرى ، %~% فألوى بمن حان إشعالها (@)(@@) 42 فآب له أصلا جامل ، %~% وأسلاب قتلى وأنفالها (@)(@@) 43 إلى بيت من يعتريه الندى ، %~% إذا النفس أعجبها مالها (@)(@@) 44 وليس كمن دون ماعونه ، %~% خواتم بخل وأقفالها (@)(@@) 45 فعاش بذلك ما ضره %~% صباة الحلوم ، وأقوالها (@)(@@) 46 ينول العشيرة ما عنده ، %~% ويغفر ما قلا جهالها (@)(@@) 47 وبيتك من سنبس في الذرى ، %~% إلى العز والمجد أحبالها PageV01P183(@)(@@) البحر : خفيف تام (@)(@@) 1 ما بكاء الكبير بالأطلال ، %~% وسؤالي ، فهل ترد سؤالي ؟ (@)(@@) 2 دمنة قفرة تعاورها الصي %~% ف بريحين من صبأ وشمال (@)(@@) 3 لات هنا ذكرى جبيرة أو من %~% جاء منها بطائف الأهوال (@)(@@) 4 حل أهلي بطن الغميس فبادو %~% لى ، وحلت علوية بالسخال (@)(@@) 5 نرنعي السفح ، فالكشيب ، فذاقا %~% ر ، فروض القطا فذات الرئال (@)(@@) 6 رب خرق من دونها يخرس السف %~% ر ، وميل يفضي إلى أميال (@)(@@) 7 وسقاء يوكى على تأق المل %~% ء ، وسير ومستقى أوشال (@)(@@) 8 وادلاج بعد المنام ، وتهجي %~% ر ، وقف وسبسب ورمال (@)(@@) 9 وقليب أجن كأن من الري %~% ش بأرجائه لقوط نصال (@)(@@) 10 ريج والشرعبي ذا الأذيال %~% دو قليل الهموم ناعم بال PageV01P184 (@)(@@) 11 إذ هي الهم والحديث ، وإذ تع %~% صي إلي الأمير ذا الأقوال (@)(@@) 12 ظبية من ظباء وجرة أدما %~% ء تسف الكباث تحت الهدال (@)(@@) 13 حرة طفلة الأنامل ، ترت %~% ب سخاما ، تكفه بخلال (@)(@@) 14 كأن السموط عكفها السل %~% ك بعطفي جيداء أم غزال (@)(@@) 15 وكأن الخمر العتيق من الإسفن %~% ط ممزوجة بماء زلال (@)(@@) 16 باكرتها الأغراب في سنة النو %~% م فتجري خلال شواك السيال (@)(@@) 17 فاذهبي كا إليك أدركني الحل %~% م ، عداني عن ذكركم أشغالي (@)(@@) 18 وعسير أدماء حادرة العي %~% ن ، خنوف عيرانة شملال (@)(@@) 19 من سراة الهجان ، صلبها الع %~% ض ورعي الحمى وطول الحيال (@)(@@) 20 لم تعطف على حوار ، ولم يق %~% طع عبيد عروقها من خمال PageV01P185 (@)(@@) 21 قد تعللتها على نكظ المي %~% ط ، وقد خب لامعات ى لآل (@)(@@) 22 
ms54	 فوق ديمومة تغول بالسف %~% ر قفار إلا من الآجال (@)(@@) 23 وإذا ما الضلال خيف مكان ال %~% ورد خمسا يرجونه عن ليال (@)(@@) 24 واستحث المغيرون من القو %~% م وكان النطاف ما في العزالي (@)(@@) 25 مرحت حرة كقنطرة الروم %~% ي تفري الهجير بالإرقال (@)(@@) 26 تقطع الأمعز المكوكب وخدا %~% بنواج سريعة الإيغال (@)(@@) 27 ط ، كعدو المصلصل الجوال %~%(@)(@@) 28 لاحه الصيف والصيال وإشفا %~% ل ، دفاقا غداة غب الصقال (@)(@@) 29 ملمع لاعة الفؤاد إلى جح %~% ش ، فلاه عنها فبئس الفالي (@)(@@) 30 ذو أذاة على الخليط ، خبيث ال %~% نفس ، يرمى مراغه بالنسال (@)PageV01P186 (@)(@@) 31 غادر الجحش في الغبار ، وعدا %~% ها حثيثا لصوة الأدحال (@)(@@) 32 ذاك شبهت ناقتي عن يمين ال %~% رعن ، بعد الكلال والإعمال (@)(@@) 33 وتراها تشكو إلي ، وقد آ %~% لت طليحا تحذى صدور النعال (@)(@@) 34 نقب الخف للسرى ، فترى الأن %~% ساع من حل ساعة وارتحال (@)(@@) 35 أثرت في جناجن كإران ال %~% (@)(@@) 43 ت حبال وصلتها بحبال %~% (@)(@@) 44 أربحي ، صلت ، يظل له القو ~% م ركودا ، قيامهم للهلال (@)(@@) 45 إن يعاقب يكن غراما ، وإن يعط %~% جزيلا ، فإنه لا يبالي (@)(@@) 46 يهب الجلة الجراجر ، كالبس %~% تان تحنو لدردق أطفال (@)(@@) 47 والبغايا يركضن أكسية الإض %~% PageV01P187 (@)(@@) 48 وجيادا كأنها قضب الشو %~% حط ، تعدو بشكة الأبطال (@)(@@) 49 والمكاكيك والصحاف من الفض %~% ة والضامزات تحت الرجال (@)(@@) 50 رب حي أشقاهم آخر الده %~% ر وحي سقاهم بسجال (@)(@@) 51 ولقد شبت الحروب فما غم %~% رت فيهاإذ قلصت عن حيال (@)(@@) 52 هؤلى ثم هؤلى كلا اع %~% طيت نعالا محذوة بمثال (@)(@@) 53 فأرى من عصاك أصبح مخذو %~% لا ، وكعب الذي يطيعك عالي (@)(@@) 54 أنت خير من ألف ألف من القو %~% م إذا ما كبت وجوه الرجال (@)(@@) 55 ولمثل الذي جمعت من العد %~% ة ، تأبى حكومة المقتال (@)(@@) 56 جندك التالد العتيق من ال %~% سادات أهل القباب والآكال (@)(@@) 57 غير ميل ولا عواوير في الهي %~% جا ولا عزل ولا أكفال PageV01P188 (@)(@@) 58 ودروع من نسج داود في الحر %~% ب وسوق يحملن فوق الجمال (@)(@@) 59 ملبسات مثل الرماد من الكب %~% رة 
ms55	 من خشية الندى والطلال (@)(@@) 60 لم يبسرن للصديق ، ولكن %~% لقتال العدو يوم القتال (@)(@@) 61 لامرء يجعل الأداة لريب ال %~% دهر ، لا مسند ولا زمال (@)(@@) 62 كل عام يقود خيلا إلى خي %~% دين دراكا بغزوة وصيال (@)(@@) 63 ثم أسقاهم على العي %~% ش فأروى ذنوب رفد محال (@)(@@) 64 فخمة يلجأ المضاف إليها ، %~% ورعالا موصولة برعال (@)(@@) 65 تخرج الشيخ من بنيه وتلوي %~% بلبون المعزابة المعزال (@)(@@) 66 ثم دانت بعد الرباب ، وكانت %~% كعذاب عقوبة الأقوال (@)(@@) 67 عن تمن وطول حبس وتجمي %~% ع شتات ، ورحلة واحتمال PageV01P189 (@)(@@) 68 من نواصي دودان إذ كرهوا ال %~% بأس وذبيان والهجان الغوالي (@)(@@) 69 ثم وصلت صرة بربيع ، %~% حين صرفت حالة عن حال (@)(@@) 70 هو دان الرباب ، إذ كرهوا ال %~% م وأسرى من معشر أقتال (@)(@@) 71 وشيوخ حربى بشطي أريك ، %~% ونسء كأنهن السعالي (@)(@@) 72 وشريكين من الما %~% ل ، وكانا محالفي إقلال (@)(@@) 73 قسما الطارف التليد من الغن %~% م ، فآبا كلاهما ذو مال (@)(@@) 74 لن تزوالوا كذلكم ، ثم لا زل %~% ت لهم خالدا خلود الجبال (@)PageV01P190(@)(@@) البحر : منسرح (@)(@@) 1 إن محلا ، وإن مرتحلا ، %~% وإن في السفر ما مضى مهلا (@)(@@) 2 استأثر الله بالوفاء وبال %~% عدال ، وولى الملامة الرجلا (@)(@@) 3 والأرض حمالة لما حمل ال %~% له ، وما إن ترد ما فعلا (@)(@@) 4 يوكا تراها كشبه أردية ال %~% خمس ، ويوما أديمها نغلا (@)(@@) 5 أنشى لها الخف والبراثن وال %~% حافر شتى والأعصم الوعلا (@)(@@) 6 والناس شتى على سجائحهم ، %~% مستوقحا حافيا ومنتعلا (@)(@@) 7 وقد رحلت المطي منتخلا ، %~% أزجي ثقالا ، وقلقلا وقلا (@)(@@) 8 أزجي سراعيف كالقسي من ال %~% شوحط ، صك المسفع الحجلا (@)(@@) 9 والهوزب العود أمتطسه بها ، %~% والعنتريس الوجناء والجملا (@)(@@) 10 ينضح بالبول والغبار على %~% فخذيه نضح العبدية الجللا PageV01P191(@)(@@) 11 وساج ساب إذا هبطت به ال %~% سهل وفي الحزن مرجما حجلا (@)(@@) 12 بسير من يقطع المفاوز وال %~% بعد إلى من يثيبه الإبلا (@)(@@) 13 والهيكل النهد ، والوليدة وال %~% عبد ، ويعطي مطافلا عطلا (@)(@@) 14 يكرمها ما ثوت لديه ، ويج %~% زيها بما كان خفها عملا (@)(@@) 15 أصبح ذو فائش سلامة ذو 
ms56	 ال %~% تفضال هشا فؤاده ، جذلا (@)(@@) 16 أبيض لا يرهب الهزال ، ولا %~% يقطع رحما ، ولا يخون إلا (@)(@@) 17 ياخبر من يركب المطي ، ولا %~% يشرب كأسا بكف من بخلا (@)(@@) 18 قلدتك الشعر يا سلامة ذا ال %~% تفضال ، والشيء حيثما جعلا (@)(@@) 19 والشعر يستنزل الكريم كما اس %~% تنزل رعد السحابة السبلا (@)(@@) 20 لو كنت ماء عدا جممت ، إذا %~% ما ورد القوم لم تكن وشلا (@)PageV01P192 (@)(@@) 21 أنجب أيام والديه به ، %~% إذ نجلاه ، فنعم ما نجلا (@)(@@) 22 قد علمت فارس وحمير وال %~% أعراب بالدشت أيهم نزلا (@)(@@) 23 هل تذكر العهد في تنمض ، إذ %~% تضرب لي قاعدا بها مثلا (@)(@@) 24 ليث لدى الحرب أو تدوخ له %~% قسرا ، وبذ الملوك ما فعلا PageV01P193(@)(@@) البحر : سريع (@)(@@) 1 أقصر ، فكل طالب سيمل %~% إن لم يكن على الحبيب عول (@)(@@) 2 فهو يقول للسفيه ، إذا %~% آمره في بعض ما يفعل (@)(@@) 3 جهل طلاب الغانيات ، وقد %~% يكون لهو همه وغزل (@)(@@) 4 السرقات الطرف من ظغن ال %~% حي ، ورقم دونها وكلل (@)(@@) 5 فيهن مخروف النواصف ، مس %~% روق البغام ، شادن أكحل (@)(@@) 6 رخص ، أحم المقلتين ، ضعي %~% ف المنكبين ، للعناق زجل (@)(@@) 7 تعله روعى الفؤاد ، ولا %~% تحرمه عفافة ، فجزل (@)(@@) 8 تخرجه إلى الكناس ، إذا ال %~% تج ذباب الأيكة الأطحل (@)(@@) 9 يرعى الأراك ، ذا الكباث ، وذا ال %~% مرد ، وزهرا نبتهن خضل (@)(@@) 10 ذلك من أشباه قتلة ، أو %~% قتلة منه سافرا أجمل PageV01P194 (@)(@@) 11 بيضاء ، جماء العظام ، لها %~% فرع أثيث ، كالحبال رجل (@)(@@) 12 علقتها بالشيطين ، فقد %~% شق علينا حبها وشغل (@)(@@) 13 إذ هي تصطاد الرجال ، ولا %~% يصطادها ، إذا رماها الأبل (@)(@@) 14 تجري السواك بالبنان على %~% ألمى ، كأطراف السيال رتل (@)(@@) 15 ترد معطوف الضجيع على %~% غيل ، كأن الوشم فيه خلل (@)(@@) 16 كأن طعم الزنجبيل وتف %~% احا على أري الدبور نزل (@)(@@) 17 ظل يذود عن مريرته ، %~% هوى له من الفؤاد وجل (@)(@@) 18 نحلا كدرداق الحفيضة ، مر %~% هوبا ، له حول الوقود زجل (@)(@@) 19 في يافع جون ، يلفع بال %~% صحرى ، إذا ما تجتنيه أهل (@)(@@) 20 يعل منه فو قتيلة بال %~% إسفنط ، قد بات 
ms57	 عليه وظل PageV01P195 (@)(@@) 21 لو صدقته ما تقول ، ول %~% كن عدات دونهن عل (@)(@@) 22 تنأى وتدنو كل ذلك مع %~% لا هي تعطيني ، ولا تبخل (@)(@@) 23 قد تعلمين يا قتيلة ، إذ %~% خان حبيب عهده وأدل (@)(@@) 24 أن قد أجد الحبل منه ، إذا %~% يا قتل ، ما حبل القرين شكل (@)(@@) 25 بعنتريس ، كالمحالة لم %~% يثن عليها للضراب جمل (@)(@@) 26 متى القتود ، والفتيان بأل %~% واح شداد تحتهن عجل (@)(@@) 27 فيها عتاد ، إذ غدوت على ال %~% أمر ، وفيها جرأة وقبل (@)(@@) 28 كأنها طاو تضيفه %~% ضرب قطار ، تحته شمأل (@)(@@) 29 بات يقول بالكثيب من ال %~% غبية : أصبح ليل لو يفعل (@)(@@) 30 منكرسا تحت الغصون ، كما %~% أحنى على شماله الصيقل PageV01P196 (@)(@@) 31 حتى إذا انجلى الصباح ، وما %~% إن كاد عنه ليله ينجل (@)(@@) 32 أطلس طلاع النجاد ، على ال %~% وحش ، وحش ضئيلا مثل القناة أزل (@)(@@) 33 في إثره غضف مقلدة ، %~% يسعى بها مغاور أطحل (@)(@@) 34 كالسيد لا ينمي طريدته ، %~% ليس له مما يحان حول (@)(@@) 35 هجن به ، فانصاع منصلتا ، %~% كالنجم يختار الكثيب أبل (@)(@@) 36 حتى إذا نالت نحا سلبا ، %~% وقد علته روعة ووهل (@)(@@) 37 لا طائش عند الهياج ، ولا %~% رث السلاح مغادر أعزل (@)(@@) 38 يطعنها شزرا على حنق ، %~% ذو جزأة في الوجه منه بسل PageV01P197(@)(@@) البحر: مجزوء الكامل (@)(@@) 1 قالت سمية ، إذ رأت %~% برقا يلوح على الجبال (@)(@@) 2 يا حبذا وادي النجي %~% ر ، وحبذا قيس الفعال (@)(@@) 3 القائد الخيل الجيا %~% د ضوامرا مثل المغالي (@)(@@) 4 الترك الكسب الخبي %~% ث ، إذا تهيأ للقتال PageV01P198(@)(@@) البحر : طويل(@)(@@) 1 هريرة ودعها ، وإن لام لائم ، %~% غداة غد أم أنت للبين واجم (@)(@@) 2 لقد كان في حول ثواء ثويته ، %~% تقضي لبنات ، ويسأم سائم (@)(@@) 3 مبتلة هيفاء رود شبابها ، %~% لها مقلتا رئم وأسود فاحم (@)(@@) 4 ووجه نقي اللون صاف يزينه %~% مع الحلي لبات لها ومعاصم (@)(@@) 5 وتضحك عن غر الثنايا ، كأنه %~% ذرى أقحوان نبته متناعم (@)(@@) 6 هي الهم لا تدنو ، ولا يستطيعها %~% من العيس إلا النجيات الرواسم (@)(@@) 7 رأيت بني شيبان يظهر منهم %~% لقومي عمدا نغصة ومظالم (@)(@@) 8 
ms58	 فإن تصبحوا أدنى العدو فقبلكم %~% من الدهر عادتنا الرباب ودارم (@)(@@) 9 وسعد وكعب والعباد وطيء ، %~% ودودان في ألفافها والأراقم (@)(@@) 10 فما فضنا من صانع بعد عهدكم %~% فيطمع فينا زاهر والأصارم PageV01P199(@)(@@) 11 ولن تنتهوا حتى تكسر بيننا %~% رماح بأيدي شجعة وقوائم (@)(@@) 12 وحتى يبيت القوم في الصف ليلة %~% يقولون نور صبح ، والليل عاتم (@)(@@) 13 وقوفا وراء الطعن ، والخيل تحتهم ، %~% تشد على أكتافهن القوادم (@)(@@) 14 إذا ما سمعن الزجر يممن مقدما %~% عليها أسود الزارتين الضراغم (@)(@@) 15 أبا ثابت أو تنتمون ، فإنما %~% يهيم لعينيه من الشر هائم (@)(@@) 16 متى تلقنا ، والخيل تحمل يزنا ، %~% خناذيذ منها جلة وصلادم (@)(@@) 17 فتلق أناسا لا يخيم سلاحهم ، %~% إذا كان حما للصفيح الجماجم (@)(@@) 18 وإنا أناس يعتدي البأس خلفنا ، %~% كما يعتدي الماء الظماء الحوائم (@)(@@) 19 فهان علينا ما يقول ابن مسهر %~% برغمك إذ حلت علينا اللهازم (@)(@@) 20 يزيد يغض الطرف دوني كأنما %~% زوى بين عينيه علي المحاجم (@)PageV01P200 (@)(@@) 21 فلا ينبسط من بين عينيك ما انزوى ، %~% ولا تلقني إلا وأنفك راغم (@)(@@) 22 فأقسم بالله الذي أنا عبده ، %~% لتصطفقن يوما عليك المآتم (@)(@@) 23 يقلن حرام ما أحل بربنا %~% وتترك أمولا عليها الخواتم (@)(@@) 24 أبا ثابت لا تعلقنك رماحنا ، %~% أبا ثابت اقعد وعرضك سالم (@)(@@) 25 أفي كل عام تقتلون ونتدي ، %~% فتلك التي تبيض منها المقادم (@)(@@) 26 وذرنا وقوما إن هم عمدوا لنا %~% أبا ثابت ، واجلس فإنك ناعم (@)(@@) 27 طعام العراق المستفيض الذي ترى ، %~% وفي كل عام حلة ودراهم (@)(@@) 28 أتأمر سيارا بقتل سراتنا ، %~% وتزعم بعد القتل أنك سالم (@)(@@) 29 أبا ثابت ! إنا إذا تسبقننا ، %~% سيرعد سرح أو ينبه نائم (@)(@@) 30 بمشعلة يغشى الفراش رشاشها ، %~% يبيت لها ضوء من النار جاحم (@)PageV01P201 (@)(@@) 31 تقر به عين الذي كان شامتا ، %~% وتبتل منها سرة ومآكم (@)(@@) 32 وتلقى حصان تخدم ابنة عمها ، %~% كما كان يلقى النصفات الخوادم (@)(@@) 33 إذا اتصلت قالت : أبكر بن وائل ، %~% وبكر سبتها ، والأنوف رواغم (@)PageV01P202(@)(@@) البحر : طويل (@)(@@) 1 ألا قل لتيا قبل مرتها اسلمي ، %~% تحية مشتاق إليها متيم (@)(@@) 2 على قيلها يوم التقينا 
ms59	 ، ومن يكن %~% على منطق الواشين يصرم ويصرم (@)(@@) 3 أجدك لم تأخذ ليالي نلتقي %~% شفاءك من حول جديد مجرم (@)(@@) 4 تسر وتعطى كل شيء سألته ، %~% ومن يكثر التسآل لا بد يحرم (@)(@@) 5 فما لك عندي نائل غير ما مضى %~% رضيت به ، فاصبر لذلك أو ذم (@)(@@) 6 فلا بأس إني قد أجوز حاجتي ، %~% بمستحصد باق من الرأي مبرم (@)(@@) 7 وكور علافي وقطع ونمرق ، %~% ووجناء مرقال الهواجر عيهم (@)(@@) 8 كأن على أنسائها عذق حصلة %~% تدلى من الكافور غير مكمم (@)(@@) 9 عرندسة لا ينفض السير غرضها ، %~% كأحقب بالوفراء جأب مكدم (@)(@@) 10 رعى الروض والوسمي حتى كأنما %~% يرى بيبيس الدو إمرار علقم (@)PageV01P203 (@)(@@) 11 تلا سقبة قوداء مشكوكة القرا ، %~% متى ما تخالفه عن القصد يعذم (@)(@@) 12 إذا ما دنا منها التقته بحافر ، %~% كأن له في الصدر تأثير محجم (@)(@@) 13 إذا جاهرته بالفضاء انبرى لها %~% بإلهاب شد كالحريق المضرم (@)(@@) 14 وإن كان تقريب من الشد غالها %~% بميعة فنان الأجاري مجذم (@)(@@) 15 فلما علته الشمس واستوقد الحصى %~% تذكر أدنى الشرب للمتيمم (@)(@@) 16 فأوردها عينا من السيف رية ، %~% بها برأ مثل الفسيل المكمم (@)(@@) 17 بناهن من ذلان رام أعداها %~% لقتل الهوادي ، داجن بالتوقم (@)(@@) 18 فلما عفاها ظن أن ليس شاربا %~% من الماء إلا بعد طول تحرم (@)(@@) 19 وصادف مثل الذئب في جوف قترة %~% فلما رآها قال : يا خير مطعم (@)(@@) 20 ويسر سهما ذا غرار يسوقه %~% أمين القوى في صلبة المترنم PageV01P204(@)(@@) 21 فمر نضي السهم تحت لبانه ، %~% وجال على وحشيه لم يثمثم (@)(@@) 22 وجال وجالت ينجلي الترب عنهما %~% له رهج في ساطع اللون أقتم (@)(@@) 23 كأن احتدام الجوف في حمي شده %~% وما بعده من شده ، غلي قمقم (@)(@@) 24 فذلك بعد الجهد شبهت ناقتي %~% إذا ما ونى حد المطي المخرم (@)(@@) 25 فدع ذا ولكن ما ترى رأي كاشح %~% يرى بيننا من جهله دق منشم (@)(@@) 26 أراني بريئا من عمير ورهطه ، %~% إذا أنت لم تبرأ من الشر فاسقم (@)(@@) 27 إذا ما رآني مقبلا شام نبله ، %~% ويرمي إذا أدبرت ظهري بأسهم (@)(@@) 28 على 
ms60	 غير ذئب أن عداوة %~% طمت بك فاستأخر لها أو تقدم (@)(@@) 29 وكنت ، إذا نفس الغوي نوت به ، %~% صقعت على العرنين منه بميسم (@)(@@) 30 حلقت برب الراقصات إلى منى ، %~% إذا مخرم جاوزته بعد مخرم PageV01P205(@)(@@) 31 ضوامر خوصا قد أضر بها السرى ، %~% وطابقن مشيا في السريح المخدم (@)(@@) 32 لئن كنت في جب ثمانين قامة %~% ورقيت أسباب السماء بسلم (@)(@@) 33 ليستدرجنك القول حتى تهره %~% وتعلم أني عنك لست بملجم (@)(@@) 34 ونشرق بالقول الذي قد أذعته %~% كما شرقت صدر القناة من الدم (@)(@@) 35 فما أنت من أهل الحجون ولا الصفا %~% ولالك حق الشرب من ماء زمزم (@)(@@) 36 وما جعل الرحمن بيتك في العلى %~% بأجياد غربي الصفا والمحرم (@)(@@) 37 فلا توعدني بالفجار ، فإنني %~% بني الله بيتي الله في الدخيس العرمرم (@)(@@) 38 عجبت لآل الحرقتين ، كأنما %~% رأوني نفيا من إياد وترخم (@)(@@) 39 وغربني سعد بن قيس عن العلى %~% وأحسابهم يوم الندى والتكرم (@)(@@) 40 مقام هجين ساعة بلوائه ، %~% فقل في هجين بين حام وسلهم PageV01P206 (@)(@@) 41 فلما رأيت الناس للشر أقبلوا ، %~% وثابوا إلينا من فصيح وأعجم (@)(@@) 42 وصيح علينا بالسياط وبالقنا %~% إلى غابة مرفوعة عند موسم (@)(@@) 43 دعوت خليلي مسحلا ، ودعوا له %~% جهنام جدعا للهجين المذمم (@)(@@) 44 فإني وثوبي راهب اللج ، والتي %~% بناها قصي والمضاض بن جرهم (@)(@@) 45 لئن جدة أسباب العدواة بيننا ، %~% لترتحلن مني على ظهر شيهم (@)(@@) 46 وتركب مني إن بلوت نكيثي ، %~% على نشز قد شاب ليس بتوأم (@)(@@) 47 فما حسبي إن قسته بمقصر ، %~% حباني أخي الجني ، نفسي فداؤه ، (@)(@@) 48 وما زال إهداء الهواجز بيننا ، %~% وترقيق أقوام لحين ومأثم (@)(@@) 49 وأمر السفى حتى التقينا غدية ، %~% كلانا يحامي عن ذمار ويحتمي (@)(@@) 50 تركنا وخلى ذو الهوادة بيننا ، %~% بأثقب نيران العداوة ترتمي (@)PageV01P207 (@)(@@) 51 بأفيح جياش العشيات خضرم %~%(@)(@@) 52 فقال : ألا فانزل على المجد سابقا ، % لك الخير قلد ، إذ سبقت ، وأنعم (@)(@@) 53 وولى عمير ، وهو كاب ، كأنما %~% يطلى بحص ، أو يغثى بعظلم (@)(@@) 54 ونحن غداة العين يوم فطيمة %~% منعنا بني شيبان شرب محلم (@)(@@) 55 جبهناهم بالطعن ، حتى توجهوا %~% وهزوا 