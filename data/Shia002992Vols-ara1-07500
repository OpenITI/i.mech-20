ms7494	(@)(@@) ج 1، ح 621).(@)(@@) * وروى عن أحمد بن زيد النيسابوري، وروى عنه أحمد بن محمد ابن عيسى.(@)(@@) الكافي: ج 1، ك 4، ب 113، ح 4.(@)(@@) * وروى عن أحمد بن محمد بن أبي نصر، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 9، ح 296 (الإستبصار:(@)(@@) ج 4، ح 328، وفيه: أحمد بن محمد فقط).(@)(@@) * وروى عن إسحاق بن جرير، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 8، ح 244.(@)(@@) * وروى عن إسماعيل، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 1، ح 442 (الإستبصار:(@)(@@) ج 1، ح 440). PageV24P327(@)(@@) * وروى عن أصرم بن حوشب، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 5، ح 1587.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 5، ح 1544.(@)(@@) * وروى عن بكير بن أعين، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 1، ح 1066.(@)(@@) * وروى عن ثعلبة بن ميمون، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 10، ح 234 (الإستبصار:(@)(@@) ج 4، ح 847).(@)(@@) * وروى عن جعفر بن بشير، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 4، ك 3، ب 40، ح 6.(@)(@@) * وروى عن جعفر بن المثنى، وروى عنه أحمد.(@)(@@) التهذيب: ج 4، ح 969.(@)(@@) * وروى عن جعفر بن محمد العلوي، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 7، ح 1880.(@)(@@) * وروى عن الحسن بن الجهم، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 7، ح 1141 (الإستبصار:(@)(@@) ج 3، ح 548).(@)(@@) * وروى عن الحسن بن السري، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 10، ح 536.(@)(@@) * وروى عن الحسين بن زرارة، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 10، ح 234 (الإستبصار:(@)(@@) ج 4، ح 847).(@)(@@) * وروى عن خلف بن حماد، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 4، ح 4.(@)(@@) * وروى عن داود بن أبي يزيد العطار، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 21، ح 26، و ج 6، ك 2، ب 31، ح 1. والتهذيب: ج 5، ح 1275 (الإستبصار: ج 2، ح 712).(@)(@@) * وروى عن ذريح المحاربي، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 2، ح 561.(@)(@@) * وروى عن سعد، وروى عنه أحمد ابن محمد.(@)(@@) التهذيب: ج 2، ح 1404 (الإستبصار:(@)(@@) ج 1، ح 1070، وفيه سعد بن سعد).(@)(@@) * وروى عن سعد بن سعد، وروى 
