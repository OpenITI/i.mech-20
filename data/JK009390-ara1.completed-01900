ms1881	 حسنة إلا من قال مثل ما يقول ) )(@)(@@) ( ك ) في تاريخه و أبو نعيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17391 ) قال النبي :(@)(@@) | 30 ( للماشي أجر سبعين حجة ، ولمن يركب أجر حجة ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17392 ) قال النبي :(@)(@@) | 30 ( للمسافر ثلاثة أيام ولياليهن وللمقيم يوم وليلة يمسح على خفيه إذا أدخلهما وقدماه طاهرتان ) )(@)(@@) عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17393 ) قال النبي :(@)(@@) | 30 ( للمسلم على أخيه المسلم ست خصال واجبة ، فمن ترك خصلة منها فقد ترك حقا واجبا لأخيه : إذا دعاه أن يجيبه ، وإذا لقيه أن يسلم عليه ، وإذا عطس أن يشمته ، وإذا مرض أن يعوده ، وإذا مات أن يتبع جنازته ، وإذا استنصحه أن ينصحه ) )(@)(@@) الحكيم ( طب ) وابن النجار عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17394 ) قال النبي :(@)(@@) | 30 ( للمملوك على مولاه ثلاث : لا يعجله عن صلاته ، ولا يقيمه عن طعامه ، ويبيعه إذا استباعه ) )(@)(@@) ( تمام كر ) عن ابن عباس رضي الله عنهما قال ( كر ) حديث غريب .(@)(@@)(@@)(@@) $ ( 17395 ) قال النبي :(@)(@@) | 30 ( للمنافقين علامات يعرفون بها : تحيتهم لعنة ، وطعامهم نهبة ، وغنيمتهم غلول ، لا يقربون المساجد إلا هجرا ، ولا يأتون الصلاة إلا دبرا ، مستكبرين لا يألفون ولا يؤلفون ، خشب بالليل ، صخب بالنهار ) )(@)(@@) PageV06P089 ( حم ) و ابن نصر وابن منيع وأبو الشيخ وابن مردويه ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17396 ) قال النبي :(@)(@@) | 30 ( للمنصت الذي لا يسمع كأجر المنصت الذي يسمع ) )(@)(@@) ( عب ) عن عبد الرحمان بن زيد بن أسلم مرسلا ( عب ) عن عثمان بن عفان رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 17397 ) قال النبي :(@)(@@) | 30 ( للنار سبعة أبواب ، وللجنة ثمانية أبواب ) )(@)(@@) ابن النجار عن عتبة بن عبد السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17398 ) قال النبي :(@)(@@) | 30 ( للناس ثلاثة معاقل : فمعقلهم من الملحمة الكبرى التي تكون لعمق أنطاكية دمشق ، ومعقلهم من الدجال بيت المقدس ، ومعقلهم من يأجوج ومأجوج طور سيناء ) )(@)(@@) ( حل كر ) عن الحسين بن علي ( كر ) عن يحيى بن جابر الطائي مرسلا .(@)(@@)(@@)(@@) ||| ( اللام مع الميم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 17399 ) قال النبي 
ms1882	 :(@)(@@) | 30 ( لم أنه عن البكاء ، إنما نهيت عن صوتين أحمقين فاجرين : صوت عند نغمة مزمار شيطان ولعب ، وصوت عند مصيبة : خمش وجوه ، وشق جيوب ، ورنة شيطان ، وإنما هاذه رحمة ) )(@)(@@) ( ت ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17400 ) قال النبي :(@)(@@) | 30 ( لم تؤتوا بعد كلمة الإخلاص مثل العافية ، فاسألوا الله العافية ) )(@)(@@) ( هب ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17401 ) قال النبي :(@)(@@) | 30 ( لم تحسدنا اليهود بشيء ما حسدونا بثلاث : PageV06P090 التسليم ، والتأمين ، واللهم ربنا ولك الحمد ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17402 ) قال النبي :(@)(@@) | 30 ( لم تحل الغنائم لأحد سود الرؤوس من قبلكم ، كانت تجمع وتنزل نار من السماء فتأكلها ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17403 ) قال النبي :(@)(@@) | 30 ( لم ترع ولو أردت ذالك لم يسلطك الله علي ) )(@)(@@) ( حم ن ك ) عن جعدة بن خالد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17404 ) قال النبي :(@)(@@) | 30 ( لم يبعث الله تعالى نبيا إلا بلغة قومه ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17405 ) قال النبي :(@)(@@) | 30 ( لم يبق من النبوة إلا المبشرات الرؤيا الصالحة ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17406 ) قال النبي :(@)(@@) | 30 ( لم يتكلم في المهد إلا ثلاثة : عيسى ، وكان في بني إسرائيل رجل يقال له جريج ، يصلي جاءته أمه فدعته فقال : أجيبها أو أصلي ، فقالت : اللهم لا تمته حتى تريه وجوه المومسات ، وكان جريج في صومعة ، فتعرضت له امرأة فكلمته فأبى ، فأتت راعيا فأمكنته من نفسها فولدت غلاما فقالت من جريج ، فأتوه فكسروا صومعته فأنزلوه وسبوه فتوضأ وصلى ثم أتى الغلام فقال : من أبوك يا غلام ؟ قال الراعي ، قالوا : نبني صومعتك من ذهب ، قال : لا إلا من طين ، وكانت امرأة ترضع ابنا لها من بني إسرائيل فمر بها رجل راكب ذو شارة فقالت : اللهم اجعل ابني مثله ، فترك ثديها وأتى على الراكب فقال : اللهم لا تجعلني مثله ، ثم أقبل على ثديها يمصه ، ثم مرت بأمة فقالت : اللهم لا تجعل ابني مثل هاذه ، فترك ثديها وقال : اللهم اجعلني مثلها ، فقالت 
ms1883	 : لم ذاك ؟ فقال : الراكب جبار من الجبابرة ، وهاذه الأمة يقولون سرقت زنت ولم تفعل ) )(@)(@@) ( حم ق ) PageV06P091 عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17407 ) قال النبي :(@)(@@) | 30 ( لم يتكلم في المهد إلا أربعة : عيسى ، وشاهد يوسف ، وصاحب جريج ، وابن ماشطة فرعون ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17408 ) قال النبي :(@)(@@) | 30 ( لم ير للمتحابين مثل النكاح ) )(@)(@@) ( ه ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17409 ) قال النبي :(@)(@@) | 30 ( لم يزل أمر بني إسرائيل معتدلا حتى نشأ فيهم المولدون وأبناء سبايا الأمم التي كانت بنو إسرائيل تسبيها فقالوا بالرأي فضلوا وأضلوا ) )(@)(@@) ( ه طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17410 ) قال النبي :(@)(@@) | 30 ( لم يسلط على الدجال إلا عيسى بن مريم ) )(@)(@@) الطيالسي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17411 ) قال النبي :(@)(@@) | 30 ( لم يقبر نبي إلا حيث يموت ) )(@)(@@) ( حم ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17412 ) قال النبي :(@)(@@) | 30 ( لم يكذب إبراهيم إلا ثلاث كذبات : ثنتين منهن في ذات الله ، قوله : إني سقيم ، وقوله : بل فعله كبيرهم هاذا ، وبينما هو ذات يوم وسارة إذ أتى على جبار من الجبابرة ، فقيل له : إن هاهنا رجلا معه امرأة من أحسن الناس ، فأرسل إليه فسأله عنها ، فقال : من هاذه ؟ قال أختي ، فأتى سارة فقال : يا سارة ليس على وجه الأرض مؤمن غيري وغيرك ، وإن هاذا سألني فأخبرته أنك أختي فلا تكذبيني ، فأرسل إليها ، فلما دخلت عليه ذهب يتناولها بيده فأخذ ، فقال ادعي الله لي ولا أضرك ، فدعت الله فأطلق ، ثم تناولها ثانية فأخذ PageV06P092 مثلها أو أشد ، فقال ادعي الله لي ولا أضرك ، فدعت فأطلق ، فدعا بعض حجبته فقال : إنك لم تأتني بإنسان إنما أتيتني بشيطان ، فأخدمها هاجر فأتته وهو قائم يصلي ، فأومأ بيده مهيا ، قالت : رد الله كيد الفاجر في نحره وأخدم هاجر ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17413 ) قال النبي :(@)(@@) | 30 ( لم يكذب من نمى بين اثنين ليصلح ) )(@)(@@) ( م د ) عن أم كلثوم بنت عقبة رضي الله عنها 
ms1884	 .(@)(@@)(@@)(@@) $ ( 17414 ) قال النبي :(@)(@@) | 30 ( لم يكن مؤمن ولا يكون إلى يوم القيامة إلا وله جار يؤذيه ) )(@)(@@) أبو سعيد النقاش في معجمه وابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17415 ) قال النبي :(@)(@@) | 30 ( لم يلق ابن آدم شيئا قط منذ خلقه الله أشد عليه من الموت ، ثم إن الموت لأهون مما بعده ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17416 ) قال النبي :(@)(@@) | 30 ( لم يمت نبي حتى يؤمه رجل من قومه ) )(@)(@@) ( ك ) عن المغيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17417 ) قال النبي :(@)(@@) | 30 ( لم يمنع قوم زكاة أموالهم إلا منعوا القطر من السماء ، ولولا البهائم لم يمطروا ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17418 ) قال النبي :(@)(@@) | 30 ( لما أسلم عمر أتاني جبريل فقال : قد استبشر أهل السماء بإسلام عمر ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17419 ) قال النبي :(@)(@@) | 30 ( لما أصيب إخوانكم بأحد جعل الله أرواحهم في جوف طير خضر ترد أنهار الجنة تأكل من ثمارها ، وتأوي إلى قناديل من ذهب معلقة PageV06P093 في ظل العرش ، فلما وجدوا طيب مأكلهم ومشربهم ومقيلهم قالوا : من يبلغ إخواننا عنا أنا أحياء في الجنة نرزق لئلا يزهدوا في الجهاد ولا يتكلوا عند الحرب ؟ فقال الله تعالى : أنا أبلغهم عنكم ) )(@)(@@) ( حم د ك ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 17420 ) قال النبي :(@)(@@) | 30 ( لما أغرق الله فرعون قال : آمنت أنه لا إلاه إلا الذي آمنت به بنو إسرائيل ، قال جبريل : يا محمد فلو رأيتني وأنا آخذ من حال البحر فأدسه في فيه مخافة أن تدركه الرحمة ) )(@)(@@) ( حم ت ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 17421 ) قال النبي :(@)(@@) | 30 ( لما ألقي إبراهيم الخليل في النار قال : حسبي الله ونعم الوكيل ، فما احترق منه إلا موضع الكتاف ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17422 ) قال النبي :(@)(@@) | 30 ( لما ألقي إبراهيم في النار قال : اللهم أنت في السماء واحد ، وأنا في الأرض واحد أعبدك ) )(@)(@@) ( ع حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17423 ) قال النبي :(@)(@@) | 30 
ms1885	 ( لما انتهينا إلى بيت المقدس ليلة أسري بي قال جبريل بأصبعه فخرق بها الحجر وشد به البراق ) )(@)(@@) ( ت حب ك ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17424 ) قال الن بي :(@)(@@) | 30 ( لما توفي آدم غسلته الملائكة بالماء وترا وألحدوا له وقالوا : هاذه سنة آدم في ولده ) )(@)(@@) ( ك ) عن أبي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17425 ) قال النبي :(@)(@@) | 30 ( لما حملت حواء طاف بها إبليس وكان لا يعيش لها PageV06P094 ولد فقال : سميه عبد الحارث فإنه يعيش فسمته عبد الحارث فعاش وكان ذالك من وحي الشيطان وأمره ) )(@)(@@) ( حم ت ك ) و الضياء عن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17426 ) قال النبي :(@)(@@) | 30 ( لما خلق الله آدم مسح ظهره ، فسقط من ظهره كل نسمة هو خالقها إلى يوم القيامة ، ثم جعل بين عيني كل إنسان منهم وبيصا من نور ، ثم عرضهم على آدم فقال : أي رب من هاؤلاء ؟ قال : هاؤلاء ذريتك ، فرأى رجلا منهم أعجبه نور ما بين عينيه ، فقال : أي رب من هاذا ؟ قال : رجل من ذريتك في آخر الأمم يقال له داود ، قال : أي رب كم عمره ؟ قال : ستون سنة ، قال : فزده من عمري أربعين سنة ، قال : إذن يكتب ويختم ولا يبدل ، فلما انقضى عمر آدم جاء ملك الموت ، فقال : أو لم يبق من عمري أربعون سنة ؟ قال : أو لم تعطها ابنك داود فجحد فجحدت ذريته ، ونسي آدم فنسيت ذريته ، وخطىء آدم فخطئت ذريته ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17427 ) قال النبي :(@)(@@) | 30 ( لما خلق الله آدم ونفخ فيه الروح عطس ، فقال : الحمد لله ، فحمد الله بإذنه ، فقال له ربه : يرحمك الله يا آدم ، اذهب إلى أولائك الملائكة إلى ملأ منهم جلوس فقل : السلام عليكم ، قالوا : وعليك السلام ورحمة الله ، ثم رجع إلى ربه فقال : إن هاذه تحيتك وتحية بنيك وبنيهم ، فقال الله له ويداه مقبوضتان : اختر أيهما شئت قال : اخترت يمين ربي ، وكلتا يدي ربي يمين مباركة ثم بسطها فإذا فيها آدم وذريته ، فقال : أي رب ما 
ms1886	 هاؤلاء ؟ قال : هاؤلاء ذريتك ، فإذا كل إنسان مكتوب عمره بين عينيه ، فإذا فيهم رجل أضوؤهم أو من أضوئهم قال : يا رب من هاذا ؟ قال : هاذا ابنك داود ، وقد كتبت له عمر أربعين سنة ، قال : يا رب زد في عمره ، قال : ذاك الذي كتبت له ، قال : أي رب فإني قد جعلت له من عمري ستين سنة ، قال : أنت وذاك ، ثم أسكن الجنة ما شاء الله ، ثم أهبط منها فكان آدم يعد لنفسه ، فأتاه ملك الموت ، فقال له آدم : PageV06P095 قد تعجلت ، قد كتب لي ألف سنة ؟ قال : بلى ، ولاكنك جعلت لابنك داود ستين سنة ، فجحد فجحدت ذريته ، ونسي فنسيت ذريته ، فمن يومئذ أمر بالكتاب والشهود ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17428 ) قال النبي :(@)(@@) | 30 ( لما خلق الله الأرض جعلت تميد ، فخلق الجبال فألقاها عليها فاستقرت ، فتعجبت الملائكة من خلق الجبال ، فقالت : يا رب هل في خلقك شيء أشد من الجبال ؟ قال : نعم ، الحديد ، قالت : يا رب فهل في خلقك شيء أشد من الحديد ؟ قال : نعم ، النار ، قالت : يا رب فهل في خلقك شيء أشد من النار ؟ قال : نعم ، الماء ، قالت : يا رب فهل في خلقك شيء أشد من الماء ؟ قال : نعم ، الريح ، قالت : يا رب فهل في خلقك شيء أشد من الريح ؟ قال : نعم ، ابن آدم يتصدق بيمينه ويخفيها من شماله ) )(@)(@@) ( حم ت ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17429 ) قال النبي :(@)(@@) | 30 ( لما خلق الله الجنة قال لجبريل : اذهب فانظر إليها فذهب فنظر إليها ، ثم جاء فقال : أي رب وعزتك لا يسمع بها أحد إلا دخلها ، ثم حفها بالمكاره ، ثم قال : يا جبريل اذهب فانظر إليها ، فذهب ثم نظر إليها ثم جاء فقال : أي رب وعزتك لقد خشيت أن لا يدخلها أحد فلما خلق الله النار قال : يا جبريل ، اذهب فانظر إليها ، فذهب فنظر إليها ، ثم جاء فقال : وعزتك لا يسمع بها أحد فيدخلها فحفها بالشهوات ، ثم قال : يا جبريل ، اذهب فانظر إليها فذهب فنظر إليها فقال 
ms1887	 : أي رب وعزتك لقد خشيت أن لا يبقى أحد إلا دخلها ) )(@)(@@) ( حم ( 3 ) ك ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17430 ) قال النبي :(@)(@@) | 30 ( لما خلق الله تعالى جنة عدن خلق فيها ما لا عين PageV06P096 رأت ، ولا خطر على قلب بشر ، ثم قال لها : تكلمي ، فقالت : قد أفلح المؤمنون ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17431 ) قال النبي :(@)(@@) | 30 ( لما صور الله تعالى آدم في الجنة ، تركه ما شاء الله أن يتركه ، فجعل إبليس يطيف به ينظر إليه ، فلما رآه أجوف عرف أنه خلق لا يتمالك ) )(@)(@@) ( حم م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17432 ) قال النبي :(@)(@@) | 30 ( لما عرج بي رأيت إدريس في السماء الرابعة ) )(@)(@@) ( ت حب ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17433 ) قال النبي :(@)(@@) | 30 ( لما عرج بي ربي عز وجل مررت بقوم لهم أظفار من نحاس يخمشون وجوههم وصدورهم فقلت : من هاؤلاء يا جبريل ؟ قال : هاؤلاء الذين يأكلون لحوم الناس ، ويقعون في أعراضهم ) )(@)(@@) ( حم د ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17434 ) قال النبي :(@)(@@) | 30 ( لما قضى الله الخلق كتب في كتابه فهو عنده فوق العرش : إن رحمتي غلبت غضبي ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17435 ) قال النبي :(@)(@@) | 30 ( لما كانت الليلة التي أسري بي فيها وجدت رائحة طيبة ، فقلت : ما هاذه الرائحة الطيبة يا جبريل ؟ قال : هاذه رائحة ماشطة بنت فرعون وأولادها ، قلت : ما شأنها ؟ قال : بينا هي تمشط بنت فرعون إذ سقط المشط من يدها فقالت : بسم الله ، قال بنت فرعون : أبي ؟ فقالت : لا ، ولاكن PageV06P097 ربي وربك ورب أبيك الله ، قالت : وإن لك ربا غير أبي ؟ قالت : نعم ، قالت : فأعلمه بذالك ؟ قالت : نعم ، فأعلمته بذالك ، فدعا بها فقال : يا فلانة ألك رب غيري ؟ قالت : نعم ، ربي وربك الله الذي في السماء ، فأمر بنقرة من نحاس فأحميت ، ثم أخذ أولادها يلقون فيها واحدا وواحدا ، فقالت : إن لي إليك حاجة ، قال : وما هي ؟ قالت : أحب أن تجمع عظامي وعظام ولدي في ثوب 
ms1888	 واحد فتدفنا جميعا ، قال : ذالك لك بما علينا من الحق ، فلم يزل أولادها يلقون في النقرة حتى انتهى إلى ابن لها رضيع فكأنها تقاعست من أجله فقال لها : يا أمه اقتحمي فإن عذاب الدنيا أهون من عذاب الآخرة ، ثم ألقيت مع ولدها ، وتكلم أربعة وهم صغار : هاذا ، وشاهد يوسف ، وصاحب جريج ، وعيسى بن مريم ) )(@)(@@) ( حم ن ك هب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 17436 ) قال النبي :(@)(@@) | 30 ( لما كذبتني قريش حين أسري بي إلى بيت المقدس قمت في الحجر فجعلى الله لي بيت المقدس ، فطفقت أخبرهم عن آياته وأنا أنظر إليه ) )(@)(@@) ( حم ق ت ن ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17437 ) قال النبي :(@)(@@) | 30 ( لما نفخ في آدم الروح مارت وطارت فصارت في رأسه فعطس فقال : الحمد لله رب العالمين ، فقال الله : يرحمك الله ) )(@)(@@) ( حب ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17438 ) قال النبي :(@)(@@) | 30 ( لما وقعت بنو إسرائيل في المعاصي فنهتهم علماؤهم فلم ينتهوا ، فجالسوهم في مجالسهم وواكلوهم ، وشاربوهم ، ضرب الله قلوب بعضهم ببعض ولعنهم على لسان داود وعيسى بن مريم ذالك بما عصوا ، وكانوا يعتدون ، لا والذي نفسي بيده حتى تأطروهم على الحق أطرا ) )(@)(@@) ( حم ت ) PageV06P098 عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17439 ) قال النبي :(@)(@@) | 30 ( لمعالجة ملك الموت أشد من ألف ضربة بالسيف ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 17440 ) قال النبي :(@)(@@) | 30 ( لم يكن لهم سيئات فيعاقبوا بها فيكونوا من أهل النار ، فلم يكن لهم حسنات فيجازوا بها فيكونوا من ملوك أهل الجنة ، هم خدام أهل الجنة يعني أطفال المشركين ) )(@)(@@) ( ط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17441 ) قال النبي :(@)(@@) | 30 ( لم ترع لم ترع ، ولو أردت ذالك لم يسلطك الله علي ) )(@)(@@) ( ط حم ن ) و البغوي والباوردي وابن قانع ( طب ك ض ) عن جعدة بن خالد الصمة الجشمي قال : جاؤوا برجل إلى النبي فقالوا : هاذا أراد أن يقتلك قال فذكره قال البغوي : لا أعلم له غيره .(@)(@@)(@@)(@@) $ ( 17442 ) قال النبي 
ms1889	 :(@)(@@) | 30 ( لم يبق من مبشرات النبوة إلا الرؤيا الصالحة يراها المسلم أو ترى له : ( بز ) عن أ| بي الطفيل عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17443 ) قال النبي :(@)(@@) | 30 ( لم يبق بعدي من المبشرات إلا الرؤيا الصالحة يراها الرجل أو ترى له ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 17444 ) قال النبي :(@)(@@) | 30 ( لم يبق من طواغيت الجاهلية إلا ذو الخلصة ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17445 ) قال النبي :(@)(@@) | 30 ( لم يمنعني أن أرد عليك إلا أني لم أكن متوضئا ) )(@)(@@) PageV06P099 ( ط ) و الباوردي عن حنظلة الأنصاري أن رجلا سلم على رسول الله فلم يرد عليه حتى تمسح وقال فذكره .(@)(@@)(@@)(@@) $ ( 17446 ) قال النبي :(@)(@@) | 30 ( لم آتكم إلا بخير ، أتيتكم أن تعبدوا الله وحده لا شريك له ، وأن تدعوا اللات والعزى ، وأن تصلوا بالليل والنهار خمس صلوات ، وأن تصوموا من السنة شهرا ، وأن تحجوا البيت ، وأن تأخذوا من أموال أغنيائكم فتردوها على فقرائكم ) )(@)(@@) ( حم ) عن رجل من بني عامر .(@)(@@)(@@)(@@) $ ( 17447 ) قال النبي :(@)(@@) | 30 ( لم أنه عن البكاء ، إنما نهيت عن النوح وعن صوتين أحمقين فاجرين : صوت عند نغمة مزمار شيطان ولعب ، وصوت عند مصيبة : خمش وجوه ، وشق جيوب ، ورنة شيطان ، وإنما هاذه رحمة ، ومن لا يرحم لا يرحم ، يا إبراهيم لولا أنه أمر حق ، ووعد صدق ، وسبيل مأتي ، وأن أخرانا ستلحق أولانا لحزنا عليك حزنا هو أشد من هاذا وإنا بك لمحزونون ، تبكي العين ، ويحزن القلب ، ولا نقول ما يسخط الرب ) )(@)(@@) عبد بن حميد عن جابر رضي الله عنه ، وروى صدره ( ط ت ) وقال حسن .(@)(@@)(@@)(@@) $ ( 17448 ) قال النبي :(@)(@@) | 30 ( لم يمت نبي حتى يؤمه رجل من أمته ) )(@)(@@) ( خط ) في المتفق والمفترق من طريق عبد الله بن الزبير عن عمر بن الخطاب عن أبي بكر الصديق رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17449 ) قال النبي :(@)(@@) | 30 ( لم يكذب من نمى بين اثنين ليصلح ) )(@)(@@) ( د ) عن حميد بن عبد الرحمان عن أمه .(@)(@@)(@@)(@@) $ ( 17450 ) قال النبي :(@)(@@) | 30 ( لم أنس يميني ، ولاكن إذا حلفت على يمين فرأيت غيرها خيرا منها 
ms1890	 فعلت الذي هو خير وكفرت عن يميني ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنه .(@)(@@) PageV06P100(@)(@@)(@@)(@@) $ ( 17451 ) قال النبي :(@)(@@) | 30 ( لم يكن من نبي إلا وله خليل في أمته ، وإن خليلي أبو بكر بن أبي قحافة ، وإن الله اتخذ صاحبكم خليلا ، ألا وإن الأمم قبلكم كانوا يتخذون قبور أنبيائهم مساجد وإني أنهاكم عن ذالك ، اللهم هل بلغت ثلاثا اللهم اشهد ثلاثا ، الله الله فيما ملكت أيمانكم ، أشبعوا بطونهم ، واكسوا ظهورهم ، ولينوا القول لهم ) )(@)(@@) ( طب ) عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17452 ) قال النبي :(@)(@@) | 30 ( لم يتوكل من استرقى أو اكتوى ) )(@)(@@) ( ط هب ) عن المغيرة بن شعبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17453 ) قال النبي :(@)(@@) | 30 ( لم يصب الإسلام حلفا إلا زاده شدة ، ولا حلف في الإسلام ) )(@)(@@) ابن جرير عن الزهري مرسلا .(@)(@@)(@@)(@@) $ ( 17454 ) قال النبي :(@)(@@) | 30 ( لم يتل القرآن من لم يعمل به ، ولم يبر والديه من أحد النظر إليهما في حال العقوق ، أولائك براء مني وأنا منهم بريء ) )(@)(@@) ( قط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17455 ) قال النبي :(@)(@@) | 30 ( لم يهلك الله قوم نبي قط فيكون للنبي الذي عذب قومه أمان دون الحرم ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17456 ) قال النبي :(@)(@@) | 30 ( لم يهلكوا ، إن الصلاة لا تفوت النائم ، إنما تفوت اليقظان ) )(@)(@@) ( عب ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17457 ) قال النبي :(@)(@@) | 30 ( لم يضحك أحدكم مما يفعل ) )(@)(@@) ( حم خ م ت ) عن عبد الله بن زمعة أن النبي وعظهم في الضحك من الضرطة وقال : فذكره .(@)(@@)(@@)(@@) $ ( 17458 ) قال النبي :(@)(@@) | 30 ( لم عذبت نفسك ، صم شهر الصبر ويوما من كل شهر ، صم يومين ثلاثة أيام ، صم من الحرم واترك ، صم من الحرم واترك ، صم من الحرم واترك ) )(@)(@@) ( د ) عن مجيبة الباهلية عن أبيها أو عمها .(@)(@@) PageV06P101(@)(@@)(@@)(@@) $ ( 17459 ) قال النبي :(@)(@@) | 30 ( لم يقول أحدكم لامرأته قد طلقتك قد راجعتك ، ليس هاذا بطلاق المسلمين ، طلقوا المرأة في قبل طهرها ) )(@)(@@) ( ش ك هق ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17460 ) قال النبي :(@)(@@) | 30 ( لما 
ms1891	 نزل بآدم عليه السلام الموت قال لبنيه : أي بني إني أشتهي من ثمر الجنة ، فانطلق بنوه يلتمسوه ، فولوا الملائكة فقالوا : أين تريدون يا بني آدم ؟ قالوا : اشتهى أبونا من ثمرة الجنة ، فانطلقنا نطلب ذاك له ، فقالوا : ارجعوا فقد أمر بقبض أبيكم ، فأقبلوا حتى انتهوا إلى آدم ، فلما رأتهم حواء عرفتهم فلصقت بآدم ، فقال : إليك عني ، فمن قبلك أتيت ، دعيني وملائكة ربي فقبضوه وهم ينظرون ، وغسلوه وهم ينظرون ، وكفنوه وهم ينظرون ، وحنطوه وهم ينظرون ، وصلوا عليه ، ثم حفروا له ودفنوه ، ثم أقبلوا عليهم فقالوا : يا بني آدم هاذه سنتكم في موتاكم ، وهاذا سبيلكم ) )(@)(@@) ( ط ) و ابن منيع ( عم ) والروياني ( كر ك هق ض ) عن أبي بن كعب ( ط ) عن الحسن رفع الحديث .(@)(@@)(@@)(@@) $ ( 17461 ) قال الن بي :(@)(@@) | 30 ( لما توفي آدم غسلته الملائكة بالماء وترا وألحدوا له وقالوا : هاذه سنة آدم في ولده ) )(@)(@@) ( ك ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17462 ) قال النبي :(@)(@@) | 30 ( لما خلق الله تعالى الخلق وقضى القضية ، أخذ أهل اليمين بيمينه ، وأهل الشمال بشماله فقال : يا أصحاب اليمين ، قالوا : لبيك وسعديك ، قال : ألست بربكم ؟ قالوا : بلى ، قال : يا أصحاب الشمال ، قالوا : لبيك وسعديك ، قال : ألست بربكم ؟ قالوا : بلى ، ثم خلط بينهم ، فقال قائل : يا رب لم خلطت بينهم ؟ قال : لهم أعمال من دون ذالك هم لها عاملون أن يقولوا يوم القيامة إنا كنا عن هاذا غافلين ، ثم ردهم في صلب آدم ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17463 ) قال النبي :(@)(@@) | 30 ( لما صور الله آدم تركه ، فجعل إبليس يطيف به PageV06P102 ينظر إليه ، فلما رآه أجوف قال : ظفرت به خلق لا يتمالك ) )(@)(@@) أبو الشيخ في العظمة ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17464 ) قال النبي :(@)(@@) | 30 ( لما خلق الله آدم وذريته قالت الملائكة : ربنا خلقتهم يأكلون ويشربون وينكحون ويركبون ، فاجعل لهم الدنيا ولنا الآخرة ، فقال الله تبارك وتعالى : لا أجعل من خلقته بيدي ونفخت فيه من روحي كمن قلت له كن فكان ) )(@)(@@) ( الديلمي كر ) عن جابر ( هب ) عن عروة 
ms1892	 بن رويم الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17465 ) قال النبي :(@)(@@) | 30 ( لما بعث الله نوحا إلى قومه بعثه وهو ابن خمسين ومائة سنة ، فلبث في قومه ألف سنة إلا خمسين عاما ، وبقي بعد الطوفان خمسين ومائتي سنة فلما أتاه ملك الموت قال : يا نوح يا أكبر الأنبياء ، ويا طويل العمر ، ويا مجاب الدعوة ، كيف رأيت الدنيا ؟ قال : مثل رجل بني له بيت له با بان ، فدخل من واحد وخرج من الآخر ) )(@)(@@) ( كر ) عن إبان عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17466 ) قال النبي :(@)(@@) | 30 ( لما خلق الله الخلق كتب بيده على نفسه : إن رحمتي تغلب غضبي ) )(@)(@@) ( قط ) في الصفات عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17467 ) قال النبي :(@)(@@) | 30 ( لما خلق الله آدم ضرب كتفه اليمنى فأخرج ذرية بيضاء كأنهم الذر ، ثم ضرب كتفه اليسرى فأخرج ذرية سوداء كأنهم الحمم ، فقال : هاؤلاء إلى الجنة ولا أبالي ، وهاؤلاء إلى النار ولا أبالي ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17468 ) قال النبي :(@)(@@) | 30 ( لما بلغ ولد معد بن عدنان أربعين رجلا وقعوا على عسكر موسى فانتهبوه فدعا عليهم موسى فقال : يا رب هاؤلاء ولد معد قد أغاروا على عسكري ، فأوحى الله إليه : يا موسى ، لا تدعوا عليهم فإن منهم النبي الأمي البشير النذير محمدا ، ومنهم الأمة المرحومة أمة محمد ، الذين يرضون من الله PageV06P103 باليسير من الرزق ، ويرضى الله منهم بالقليل من العمل فيدخلهم الجنة ، بقول لا إلاه إلا الله ، لأن فيهم نبيهم محمد بن عبد الله بن عبد المطلب المتواضع في هيئته ، المجتمع له اللب في سكوته ، ينطق بالحكمة ، ويستعمل الحكم ، أخرجته من خير جيل منح أمته قرشيا ، ثم أخرجته من بني هاشم صفوة قريش ، فهم خير من خير إلى خير يصير هو وأمته إلى خير يصيرون ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17469 ) قال النبي :(@)(@@) | 30 ( لما أهبط الله عز وجل آدم من الجنة إلى الأرض حزن عليه كل شيء جاوره إلا الذهب والفضة ، فأوحى الله تعالى إليهما : جاورتكما بعبد من 
ms1893	 عبيدي ثم أهبطته من جواركما فحزن عليه كل شيء جاوره إلا أنتما ، فقالا : إلاهنا وسيدنا أنت تعلم ، إنك جاورتنا به وهو لك مطيع ، فلما عصاك لم نحب أن تحزن عليه ، فأوحى الله تعالى إليهما : وعزتي وجلالي لأعزنكما حتى لا ينال كل شيء إلا بكما ) )(@)(@@) الديلمي وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17470 ) قال النبي :(@)(@@) | 30 ( لما خلق الله العقل قال له ؛ أقبل فأقبل ثم قال : أدبر فأدبر ، ثم قال له : اقعد فقعد ، ثم قال له : انطق فنطق ، ثم قال له : اصمت فصمت ، فقال له : ما خلقت خلقا أحب إلي منك ولا أكرم ، بك أعرف وبك أحمد ، وبك أطاع ، وبك آخذ وبك أعطي ، وإياك أعاتب ، ولك الثواب ، وعليك العقاب وما أكرمتك بشيء أفضل من الصبر ) )(@)(@@) الحكيم عن الحسين قال : حدثني عدة من الصحابة ، الحكيم عن الأوزاعي معضلا .(@)(@@)(@@)(@@) $ ( 17471 ) قال النبي :(@)(@@) | 30 ( لما خلق الله العقل قال له : أقبل فأقبل ، ثم قال له : أدبر فأدبر ، فقال : وعزتي ما خلقت خلقا أعجب إلي منك ، بك آخذ وبك أعطي ، وبك الثواب وعليك العقاب ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17472 ) قال النبي :(@)(@@) | 30 ( لما أراني جبريل وضوء الصلاة ، أخذ ما بالإناء من PageV06P104 ماء فنضح به فرجه ) )(@)(@@) الخطيب عن أسامة بن زيد عن أبيه .(@)(@@)(@@)(@@) $ ( 17473 ) قال النبي :(@)(@@) | 30 ( لما أهبط الله عز وجل آدم إلى الأرض كان أول ما أكل من ثمرها النبق ) )(@)(@@) الخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17474 ) قال النبي :(@)(@@) | 30 ( لما خلق الله القلم قال له : اكتب ، فجرى بما هو كائن إلى قيام الساعة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17475 ) قال النبي :(@)(@@) | 30 ( لما عافى الله عز وجل أيوب أمطر عليه جرادا من ذهب ، فجعل يأخذه بيده ويجعله في ثوبه ، فقيل له : يا أيوب أما تشبع ؟ قال : ومن يشبع من رحمتك ؟ ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17476 ) قال النبي :(@)(@@) | 30 ( لما أهبط الله آدم من الجنة علمه صنعة كل شيء وزوده من ثمار الجنة ، فثماركم 
ms1894	 هاذه من ثمار الجنة غير أن ثمرتكم تتغير ، وثمار الجنة لا تتغير ) )(@)(@@) ( بز طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17477 ) قال النبي :(@)(@@) | 30 ( لما عرج بي إلعى السماء دخلت جنة عدن فوقعت في يدي تفاحة ، فلما وضعتها في يدي انفلقت عن حوراء عيناء مرضية ، أشفار عينها كقواديم أجنحة البشر ، فقلت لها : لمن أنت ؟ قالت : للخليفة من بعدك ) )(@)(@@) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17478 ) قال النبي :(@)(@@) | 30 ( لما خلق الله آدم ضرب بيده على شق آدم الأيمن فأخرج دررا كالذر ثم قال : يا آدم هاؤلاء ذريتك من أهل الجنة ، ثم ضرب بيده على شق آدم الأيسر فأخرج دررا كالحمم ثم قال : هاؤلاء ذريتك من أهل النار ) )(@)(@@) الحكيم عن أبي هريرة رضي الله عنه .(@)(@@) PageV06P105(@)(@@)(@@)(@@) $ ( 17479 ) قال النبي :(@)(@@) | 30 ( لما أسري بي إلى السماء دخلت الجنة فرأيت في ساق العرش الأيمن : لا إلاه إلا الله محمد رسول الله ، أيدته بعلمي ونصرته ) )(@)(@@) ( طب ) عن أبي الحمراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17480 ) قال النبي :(@)(@@) | 30 ( لما بنى سليمان بن داود بيت المقدس جعل لا يتماسك البنيان ، فأوحى الله تعالى إليه : إنك أدخلت فيه ما ليس منه فأخرجه فتماسك البنيان ) )(@)(@@) ( عق ) عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17481 ) قال النبي :(@)(@@) | 30 ( لما أسري بي ، كنت أنا في شجرة وجبريل في شجرة ، فغشينا من الله ما غشيتا ، فخر جبريل مغشيا عليه ، وثبت على أمري ، فعرفت فضل إيمان جبريل على إيماني ) )(@)(@@) ( هب ) عن عطارد بن حاجب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17482 ) قال النبي :(@)(@@) | 30 ( لما لقي موسى الخضر جاء طير فألقى منقاره في الماء ، فقال الخضر لموسى : تدري ما يقول هاذا الطائر ؟ قال : وما يقول ؟ قال : يقول : ما علمك وعلم موسى في علم الله إلا كما أخذ منقاري من هاذا الماء ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17483 ) قال النبي :(@)(@@) | 30 ( لما أسري بي مررت بإبراهيم فقال لجبريل : من هاذا ؟ قال : محمد ، فرحب بي وسلم علي وقال : مر أمتك يكثروا من غراس الجنة ، فإن 
ms1895	 تربتها طيبة ، وأرضها واسعة ، قلت : وما غراس الجنة ؟ قال : لا حول ولا قوة إلا بالله ) )(@)(@@) ( هب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17484 ) قال النبي :(@)(@@) | 30 ( لما خلق الله آدم قال له : اسجد ، فسجد ، فقال : لك الجنة ومن سجد من ذريتك ، وقال لإبليس : اسجد فأبى ، فقال : لك النار ، ولمن أبى أن يسجد من ذريتك ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17485 ) قال النبي :(@)(@@) | 30 ( لما أسكن الله آدم البيت قال : اللهم إنك قد PageV06P106 أعطيت كل عامل أجره فأعطني أجري ، فأوحى الله إليه : أني قد غفرت لك إذا طفت به ، فقال : يا رب زدني ، قال : لقد غفرت لمن طاف به من ولدك ، قال : فيا رب زدني ، قال : قد غفرت لمن استغفروا له ، قال : فقام إبليس على المأزمين فقال : يا رب جعلتني في دار الفناء ، وجعلت مصيري إلى النار ، وجعلت معي عدوي آدم ، يا رب وقد أعطيته فأعطني كما أعطيته ، قال : قد جعلتك تراه ولا يراك ، قال : يا رب زدني ، قال : قد جعلت قلبه مسكنا لك ، قال : يا رب زدني ، قال : قد جعلتك تجري منه مجرى الدم ، قال فقام آدم قال : يا رب قد أعطيت إبليس فأعطني ، قال : قد جعلتك تهم بالحسنة فلا تعملها فأكتبها لك ، قال : يا رب زدني ، قال : قد جعلتك تهم بالسيئة ولا تعملها فلا أكتبها عليك وأكتب لك مكانها حسنة ، قال : يا رب زدني ، قال : واحدة لي ، وواحدة بيني وبينك ، وأخرى لك ، فضل مني عليك ، فأما التي لي : تعبدني لا تشرك بي شيئا ، وأما التي بيني وبينك : فمنك الدعاء ومني الإجابة ، وأما التي لك : فإنك تعمل الحسنة فأكتبها بعشر أمثالها ، وأما التي فضل مني عليك : فتستغفرني فأغفر لك وأنا الغفور الرحيم ) )(@)(@@) الديلمي عن أبي سعيد الخدري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17486 ) قال النبي :(@)(@@) | 30 ( لما كان ليلة أسري بي مررت بالملإ الأعلى وجبريل كالحلس البالي من خشية الله تعالى ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17487 ) قال النبي :(@)(@@) | 30 ( لما كلم الله موسى كان يبصر دبيب النمل على 
ms1896	 الصفا في الليلة الظلماء من مسيرة عشرة فراسخ ) )(@)(@@) ( طب ) و أبو الشيخ في تفسيره عن أبي هريرة رضي الله عنه .(@)(@@) PageV06P107(@)(@@)(@@)(@@) $ ( 17488 ) قال النبي :(@)(@@) | 30 ( لم توفيت خديجة نزل جبريل بصورة عائشة في سرقة حرير خضراء فقال : يا محمد هاذه زوجتك في الدنيا وزوجتك في الآخرة عوضا عن خديجة بنت خويلد ) )(@)(@@) أبو نعيم في فضائل الصحابة عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17489 ) قال النبي :(@)(@@) | 30 ( لما كان ليلة أسري بي لقيت إبراهيم في السماء السابعة فقال : يا محمد اقرأ على أمتك السلام وأخبرهم أن الجنة عذب ماؤها ، طيب شرابها ، وأن فيها قيعانا ، وأن غرس شجرها : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ) )(@)(@@) ابن شاهين في الترغيب والذكر عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17490 ) قال النبي :(@)(@@) | 30 ( لمبارزة علي لعمرو بن ود أفضل من أعمال أمتي إلى يوم القيامة ) )(@)(@@) ( ك ) وتعقب عن بهز بن حكيم عن أبيه عن جده قال الذهبي : صح .(@)(@@)(@@)(@@) $ ( 17491 ) قال النبي :(@)(@@) | 30 ( لقيام أحدكم في سبيل الله خير من الدنيا وما فيها ) )(@)(@@) ( كب ض ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17492 ) قال النبي :(@)(@@) | 30 ( لمقام أحدكم في الدنيا يتكلم بحق يزيل به باطلا ، أو ينصر به حقا أفضل من هجرة معي ) )(@)(@@) أبو نعيم عن عصمة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17493 ) قال النبي :(@)(@@) | 30 ( لموقف في سبيل الله لا يسل فيه سيف ، ولا يطعن فيه برمح ، ولا يرمى فيه بسهم أفضل من عبادة ستين سنة لا يعصى الله فيها طرفة عين ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@) PageV06P108(@)(@@)(@@)(@@) ||| ( اللام مع النون(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 17494 ) قال النبي :(@)(@@) | 30 ( لن تخلو الأرض من أربعين رجلا مثل خليل الرحمان ، فبهم تسقون ، وبهم تنصرون ، ما مات منهم أحد إلا أبدل الله مكانه آخر ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17495 ) قال النبي :(@)(@@) | 30 ( لن تخلو الأرض من ثلاثين مثل إبراهيم خليل الرحمان : بهم تغاثون ، وبهم ترزقون ، وبهم تمطرون ) )(@)(@@) ( حب ) في تاريخه عن أبي 
ms1897	 هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17496 ) قال النبي :(@)(@@) | 30 ( لن تزال أمتي على سنتي ما لم ينتظروا بفطرهم طلوع النجوم ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17497 ) قال النبي :(@)(@@) | 30 ( لن تزول قدم شاهد الزور حتى يوجب الله له النار ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17498 ) قال النبي :(@)(@@) | 30 ( لن تقرأ شيئا أبلغ عند الله من : { قل أعوذ برب الفلق } ) )(@)(@@) ( ن ) عن عقبة بن عامر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17499 ) قال النبي :(@)(@@) | 30 ( لن تقوم الساعة حتى يسود كل قبيلة منافقوها ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17500 ) قال النبي :(@)(@@) | 30 ( لن تنقطع الهجرة ما قوتل الكفار ) )(@)(@@) ( حم ن حب ) عن عبد الله بن وقدان السعدي رضي الله عنه ( ز ) .(@)(@@) PageV06P109(@)(@@)(@@)(@@) $ ( 17501 ) قال النبي :(@)(@@) | 30 ( لن تهلك أمة : أنا في أولها ، وعيسى بن مريم في آخرها ، والمهدي في وسطها ) )(@)(@@) أبو نعيم في أخبار المهدي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 17502 ) قال النبي :(@)(@@) | 30 ( لن يبتلى عبد بشيء أشد من الشرك ، ولن يبتلى بشيء بعد الشرك أشد من ذهاب بصره ، ولن يبتلى عبد بذهاب بصره فيصبر إلا غفر الله له ) )(@)(@@) البزار عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17503 ) قال النبي :(@)(@@) | 30 ( لن يبرح الناس يتساءلون هاذا الله خالق كل شيء ، فمن خلق الله ؟ ) )(@)(@@) ( خ ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 17504 ) قال النبي :(@)(@@) | 30 ( لن يبرح هاذا الدين قائما يقاتل عليه عصابة من المسلمين حتى تقوم الساعة ) )(@)(@@) ( م ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17505 ) قال النبي :(@)(@@) | 30 ( لن يجمع الله تعالى على هاذه الأمة سيفين : سيفا منها ، وسيفا من عدوها ) )(@)(@@) ( د ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 17506 ) قال النبي :(@)(@@) | 30 ( لن يدخل أحدا عمله الجنة ولا أنا ، إلا أن يتغمدني الله بفضل رحمته ، فسددوا وقاربوا ، ولا يتمنى أحدكم الموت ، إما محسن فلعله يزداد خيرا ، وإما مسيء فلعله أن يستعتب ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1