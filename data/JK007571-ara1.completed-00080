ms61	 بالدون % 360(@)(@@) % إذا جاوزوا في الظلم والطغيان % بقتلهم لعامل السلطان % 361(@)(@@) % وحاولوا الدخول في الأذية % حتى غزاهم أنجد البرية % 362(@)(@@) % فعاقهم عن كل ما رجوه % بنقضه كل الذي بنوه % 363(@)(@@) % وضبطه الحصن العظيم الشان % أشتبين بالرجل وبالفرسان % 364(@)(@@) % ثم مضى الليث إليهم زحفا % % يختطف الأرواح منهم خطفا % % 365(@)(@@) % فانهزموا هزيمة لن ترفدا % % وأسلموا صنوهم محمدا % % 366(@)(@@) % وغيره من أوجه الفرسان % مغرب في مأتم الغربان % 367(@)(@@) % مقطع الأوصال بالسنابك % من بعد ما مزق بالنيازك % PageV01P345 368(@)(@@) % ثم لجوا إلى طلاب الأمن % وبذلهم ودائعا من رهن % 369(@)(@@) % فقبضت رهانهم وأمنوا % % وأنفضوا رؤوسهم وأذعنوا % % 370(@)(@@) % ثم مضى القائد بالتأبيد % والنصر في ذي العرش والتسديد % 371(@)(@@) % حتى أتى حصن بني عماره % والحرب بالتدبير والإداره % 372(@)(@@) % فافتتح الحصن وخلى صاحبه % وأمن الناس جميعا جانبه % 374(@)(@@) % % واعتورت ببشترا أجناده % 375(@)(@@) % فكلهم أبلى وأغنى واكتفى % % وكلهم شفى الصدور واشتفى % % 376(@)(@@) % ثم تلاهم بعد ليث الغيل % عبد الحميد من بني بسيل % 377(@)(@@) % هو الذي قام مقام الضيغم % وجاء في غزاته بالصيلم % 378(@)(@@) % برأس جالوت النفاق والحسد % من جمع الخنزير فيه والأسد % PageV01P346 379(@)(@@) % فهاكه مع صحبه في عدة % مصلبين عند باب السدة % 380(@)(@@) % قد امتطى مطية لا تبرح % صائمة قائمة لا ترمح % 381(@)(@@) % مطية إن يعرها انكسار % يطبها النحار لا البيطار % 382(@)(@@) % كأنه من فوقها أسوار % عيناه في كلتيهما مسمار % 383(@)(@@) % مباشرا للشمس والرياح % على جواد غير ذي جماح % 384(@)(@@) % يقول للخاطر بالطريق % قول محب ناصح شفيق : % 385(@)(@@) % هذا مقام خادم الشيطان % ومن عصى خليفة الرحمن % % 386(@)(@@) % فما رأينا واعظا لا ينطق % أصدق منه في الذي لا يصدق % 387(@)(@@) % فقل لمن غر بسوء رائه % يمت إذا شاء بمثل دائه % 388(@)(@@) % كم مارق مضى وكم منافق % قد ارتقى في مثل ذاك الحالق % PageV01P347 389(@)(@@) % وعاد وهو في العصا مصلب % ورأسه في جذعه مركب % 390(@)(@@) % فكيف لا يعتبر المخالف % بحال من تطلبه الخلائف % 391(@)(@@) % % معتبرا لمن يرى ويسمع % 393(@)(@@) % فيها غزا معتزما ببشترا % % فجال في ساحتها ودمرا % % 394(@)(@@) % ثم غزا طلجيرة إليها % % وهي 
ms62	 الشجى من بين أخدعيها % % 395(@)(@@) % وامتدها بابن السليم راتبا % % مشمرا عن ساقه محاربا % % 396(@)(@@) % حتى رأى حفص سبيل رشده % بعد بلوغ غاية من جهده % 397(@)(@@) % فدان للإمام قصدا خاضعا % وأسلم الحصن إليه طائعا % % 399(@)(@@) % % فرمها بما رأى ودبرا % % 400(@)(@@) % واحتلها بالعز والتمكين % ومحو آثار بني حفصون % PageV01P348 401(@)(@@) % وعاضها الإصلاح من فسادهم % وطهر القبور من أجسادهم % 402(@)(@@) % حتى خلا ملحود كل قبر % من كل مرتد عظيم الكفر % 403(@)(@@) % عصابة من شيعة الشيطان % عدوة لله والسلطان % 404(@)(@@) % فخرمت أجسادها تخرما % % وأصليت أرواحهم جهنما % % 405(@)(@@) % ووجه الإمام في ذا العام % % عبد الحميد وهو كالضرغام % % 406(@)(@@) % إلى ابن داود الذي تقلعا % % في جبلي شذونة تمنعا % % 407(@)(@@) % فحطه منها إلى البسيط % كطائر آذن بالسقوط % 408(@)(@@) % ثم أتى به إبى الإمام % % إلى وفي العهد والذمام % 410(@)(@@) % % غزا بطليوس وما يليها % % 411(@)(@@) % فلم يزل يسومها بالخسف % وينتحيها بسيوف الحتف % PageV01P349 412(@)(@@) % حتى إذا ما ضم جانبيها % % محاصرا ثم بنى عليها % % 413(@)(@@) % خلى ابن إسحاق عليها راتبا % مثابرا في حربه مواظبا % % 414(@)(@@) % ومر يستقصي حصون الغرب % ويبتليها بوبيل الحرب % 415(@)(@@) % حتى قضى منهن كل حاجه % وافتحت أكشونيه وباجه % % 416(@)(@@) % وبعد فتح الغرب واستقصائه % وحسمه الأدواء من أعدائه % 417(@)(@@) % لجت بطليوس على نفاقها % % وغرهااللجاج من مراقها % % 418(@)(@@) % حتى إذا شافهت الحتوفا % % وشامت الرماح والسيوفا % % 419(@)(@@) % دعا ابن مروان إلى السلطان % % وجاءه بالعهد والأمان % 420(@)(@@) % فصار في توسعة الإمام % وساكنا في قبة الإسلام % 422(@)(@@) % فيها غزا بعزمه طليطله % وامتنعوا بمعقل لامثل له % PageV01P350 423(@)(@@) % حتى بنى جرنكشا بجنبها % % حصنا منيعا كافلا بحربها % % 424(@)(@@) % وشدها بابن سليم قائدا % % مجالدا لأهلها مجاهدا % % 425(@)(@@) % فجاسها في طول ذاك العام % بالخسف والنسف وضرب الهام % 427(@)(@@) % ثم أتى ردفا له دري % في عسكر قضاؤه مقضي % 428(@)(@@) % فحاصروها عام تسع عشره % بكل محبوك القوى ذي مره % % 429(@)(@@) % ثم أتاهم بعد بالرجال % فقاتلوهم أبلغ القتال % 431(@)(@@) % % من عام عشرين لها ثبور % 432(@)(@@) % ألقت يديها للإمام طائعه % واستسلمت قسرا إليه باخعه % % 433(@)(@@) % فأذعنت وقبلها لم تذعن % ولم تقدمن نفسها وتمكن 
ms63	 % 434(@)(@@) % ولم تدن لربها بدين % سبعا وسبعين من السنين % PageV01P351 435(@)(@@) % ومبتدى عشرين مات الحاجب % موسى الذي كان الشهاب الثاقب % 436(@)(@@) % وبرز الإمام بالتأييد % في عدة منه وفي عديد % 437(@)(@@) % صمدا إلى المدينة اللعينة % % أتعسها الرحمن من مدينة % % 438(@)(@@) % مدينة الشقاق والنفاق % وموئل الفساق والمراق % 439(@)(@@) % حتى إذا ما كان منها بالأمم % وقد ذكا حر الهجير واسحتدم % 440(@)(@@) % أتاه واليها وأشياخ البلد % مستسلمين للإمام المعتمد % 441(@)(@@) % فوافقوا الرحب من الإمام % وأنزلوا في البر والإكرام % 442(@)(@@) % ووجه الإمام في الظهيره % % خيلا لكي تدخل في الجزيره % % 443(@)(@@) % جريدة في وعرها وسهلها % % وذاك حين غفلة من أهلها % % 444(@)(@@) % ولم يكن للقوم من دفاع % بخيل دري ولا امتناع % PageV01P352 445(@)(@@) % وقوض الإمام عند ذلكا % % وقلبه صب بما هنالكا % % 446(@)(@@) % حتى إذا ما حل في المدينه % وأهلها ذليلة مهينه % 447(@)(@@) % أقمعها بالخيل والرجال % من غير ما حرب ولا قتال % 448(@)(@@) % وكان من أول شيء نظرا % % فيه وما روى له ودبرا % % 449(@)(@@) % تهدم لبابها والسور % وكان ذاك أحسن التدبير % 450(@)(@@) % حتى إذا صيرها براحا % % وعاينوا حريمها مباحا % % 451(@)(@@) % أقر بالتشييد والتأسيس % في الجبل النمي إلى عمروس % 452(@)(@@) % حتى استوى فيا بناء محكم % فحله عامله والحشم % 453(@)(@@) % فعند ذاك أسلمت واستسلمت % مدينة الدماء بعد ما عتت % 455(@)(@@) % فيها مضى عبد الحميد ملتئم % في أهبة وعدة من الحشم % PageV01P353 456(@)(@@) % حتى أتى الحصن الذي تقلعا % % يحيى بن ذي النون به وامتنعا % % 457(@)(@@) % % من غير تعنيت وغير حرب % 458(@)(@@) % إلا بترغيب له في الطاعه % وفي الدخول مدخل الجماعه % 459(@)(@@) % حتى أتى به الإمام راغبا % % في الصفح عن ذنوبه وتائبا % % 460(@)(@@) % فصفح الإمام عن جنايته % وقبل المبذول من إنابته % 461(@)(@@) % ورده إلى الحصون ثانيا % مسجلا له عليها واليا % % 463(@)(@@) % ثم غزا الإمام ذو المجدين % في مبتدا عشرين واثنتين % 464(@)(@@) % في فيلق مجمهر لهام % مدكدك الرؤوس والآكام % 465(@)(@@) % حاف الربى لزحفه تجيش % تجيش في حافاته الجيوش % 466(@)(@@) % كأنهم جن على سعالي % % وكلهم أمضى من الرئبال % PageV01P354 467(@)(@@) % فاقتحموا ملندة ورومه % ومن حواليها حصون حيمه % 468 
ms64	(@)(@@) % حتى أتاه المارق التجيبي % % مستجديا كالتائب المنيب % 469(@)(@@) % فخصه الإمام بالترحيب % والصفح والغفران للذنوب % 470(@)(@@) % ثم حباه وكساه ووصل % بشاحج وصاهل لا يمتثل % 471(@)(@@) % كلاهما من مركب الخلائف % في حلية تعجز وصف الواصف % 472(@)(@@) % وقال : كن منا وأوطن قرطبه % % ندنيك فيها من أجل مرتبه % % 473(@)(@@) % تكن وزيرا أعظم الناس خطر % وقائدا تجبي لنا هذا الثغر % 474(@)(@@) % فقال : إني ناقه من علتي % % وقد ترى تغيري وصفرتي % % 475(@)(@@) % فإن رأيت سيدي إمهالي % % حتى أرم من صلاح حالي % % 476(@)(@@) % ثم أوافيك على استعجال % بالأهل والأولاد والعيال % PageV01P355 477(@)(@@) % وأوثق الإمام بالعهود % وجعل الله من الشهود % 478(@)(@@) % فقبل الإمام من أيمانه % ورده عفوا إلى مكانه % 479(@)(@@) % ثم أتته ربة البشاقص % تدلي إليه بالوداد الخالص % 480(@)(@@) % وأنها مرسلة من عنده % % وجدها متصل بجده % 481(@)(@@) % واكتفلت بكل بنبلوني % % وأطلقت أسرى بني ذي النون % 482(@)(@@) % فأوعد الإمام في تأمينها % % ونكب العسكر عن حصونها % % 483(@)(@@) % ثم مضى بالعز والتمكين % وناصرا لأهل هذا الدين % 484(@)(@@) % في جملة الرايات والعساكر % وفي رجال الصبر والبصائر % 485(@)(@@) % إلى عدى الله من الجلالق % وعابدي المخلوق دون الخالق % 486(@)(@@) % فدمروا السهول والقلاعا % % وهتكوا الربوع والرباعا % % PageV01P356 487(@)(@@) % وخربوا الحصون والمدائنا % % وأنفروا من أهلها المساكنا % % 488(@)(@@) % فليس في الديار من ديار % ولا بها من نافخ للنار % 489(@)(@@) % فغادروا عمرانها خرابا % % وبدلوا ربوعها يبابا % % 490(@)(@@) % وبالقلاع أحرقوا الحصونا % % وأسخنوا من أهلها العيونا % % 491(@)(@@) % ثم ثنى الإمام من عنانه % وقد شفى الشجي من أشجانه % 492(@)(@@) % وأمن القفار من أنجاسها % % وطهر البلاد من أرجاسها % % PageV01P357 
