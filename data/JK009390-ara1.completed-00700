ms686	 الله لمن حمده فقولوا : ربنا لك الحمد ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6399 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به ، فإذا كبر فكبروا ، وإذا قرأ فأنصتوا ، وإذا قال : غير المغضوب عليهم ولا الضالين ، فقولوا : آمين ، وإذا ركع فاركعوا ، وإذا قال : سمع الله لمن حمده ، فقولوا : اللهم ربنا ولك الحمد ، وإذا سجد فاسجدوا ، وإذا صلى جالسا فصلوا جلوسا ) )(@)(@@) ( ش ه هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6400 ) قال النبي :(@)(@@) | 30 ( إنما جعل الإمام ليؤتم به فلا تختلفوا عليه ، فإذا كبر فكبروا ، وإذا ركع فاركعوا ، وإذا قال : سمع الله لمن حمده ، فقولوا : ربنا لك الحمد ، وإذا سجد فاسجدوا ، وإذا صلى جالسا فصلوا جلوسا أجمعين ) )(@)(@@) ( عب ش حم ق د حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6401 ) قال النبي :(@)(@@) | 30 ( إنما جعل الصواف بالبيت ، وبين الصفا والمروة ، ورمي الجمار لاقامة ذكر الله ) )(@)(@@) ( د ك ) عن عائشة رضي الله عنها .(@)(@@) PageV02P424(@)(@@)(@@)(@@) $ ( 6402 ) قال النبي :(@)(@@) | 30 ( إنما حر جهنم على أمتي كحر الحمام ) )(@)(@@) ( أبو نعيم في المعرفة طس ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6403 ) قال النبي :(@)(@@) | 30 ( إنما خيرني الله فقال : استغفر لهم أو لا تستغفر لهم ، إن تستغفر لهم سبعين مرة وسأزيده على سبعين ) )(@)(@@) ( م ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6404 ) قال النبي :(@)(@@) | 30 ( إنما ذالك جبريل ما رأيته في الصورة التي خلق فيها غير هاتين المرتين ، رأيته منهبطا من السماء سادا عظم خلقه ما بين السماء والأرض ) )(@)(@@) ( ت ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6405 ) قال النبي :(@)(@@) | 30 ( إنما ذالك عرق ، فانظري ، فإذا أتى قرؤك فلا تصلي ، فإذا مر قرؤك فتطهري ثم صلي ما بين القرء إلى القرء ) )(@)(@@) ( د ن ) عن فاطمة بنت أبي حبيش رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6406 ) قال النبي :(@)(@@) | 30 ( إنما سماهم الله تعالى الأبرار لأنهم بروا الآباء والأمهات والأبناء ، كما أن لوالديك عليك حقا كذالك لولدك ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6407 ) قال النبي :(@)(@@) | 30 ( إنما سمي 
ms687	 البيت العتيق لأن الله أعتقه من الجبابرة فلم يظهر عليه جبار قط ) )(@)(@@) ( ت ك هب ) عن ابن الزبير رضي الله عنهما .(@)(@@) حديث رقم ( 6408 ) سقط غيرمطبوع في الكتاب(@)(@@)(@@)(@@) $ ( 6409 ) قال النبي :(@)(@@) | 30 ( إنما سمي الخضر خضرا لأنه جلس على فروة بيضاء فإذا هي تهتز تحته خضراء ) )(@)(@@) ( حم ق ت ) عن أبي هريرة ( طب ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6410 ) قال النبي :(@)(@@) | 30 ( إنما سمي القلب من تقلبه ، إنما مثل القلب مثل PageV02P425 ريشة بالفلاة تعلقت في أصل شجرة يقلبها الريح ظهرا لبطن ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@) رقم الحديث مكرر في الكتاب مع اختلاف في متن الحديث(@)(@@)(@@)(@@) $ ( 6410 ) قال النبي :(@)(@@) | 30 ( إنما سمي رمضان لأنه يرمض الذنوب ) )(@)(@@) ( محمد بن منصور والسمعاني وأبو زكريا يحيى بن منده في أماليهما ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6411 ) قال النبي :(@)(@@) | 30 ( إنما سمي شعبان لأنه يتشعب فيه خير كثير للصائم فيه حتى يدخل الجنة ) )(@)(@@) ( الرافعي في تاريخه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6412 ) قال النبي :(@)(@@) | 30 ( إنما سميت الجمعة لأن آدم جمع فيها خلقه ) )(@)(@@) ( خط ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6413 ) قال النبي :(@)(@@) | 30 ( إنما فاطمة بضعة مني ، يؤذيني ما آذاها ، وينصبني ما أنصبها ) )(@)(@@) ( حم ت ك ) عن الزبير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6414 ) قال النبي :(@)(@@) | 30 ( إنما كان يكفيك أن تضرب بيديك إلى الأرض فتمسح بهما وجهك وكفيك ) )(@)(@@) ( د ) عن عمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6415 ) قال النبي :(@)(@@) | 30 ( إنما كنا نهيناكم عن لحومها أن تأكلوها فوق ثلاث لكي تسعكم ، جاء الله بالسعة فكلوا وادخروا واتجروا ، ألا وإن هاذه الأيام أيام أكل وشرب وذكر الله ) )(@)(@@) ( د ) عن نبيسة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6416 ) قال النبي :(@)(@@) | 30 ( إنما مثل الجليس الصالح وجليس السوء كحامل المسك ونافح الكير ، فحامل المسك إما أن يحذيك ، وإما أن تبتاع منه ، وإما أن تجد منه ريحا طيبة ، ونافخ الكير إما أن يحرق ثيابك ، وإما أن تجد ريحا خبيثة ) )(@)(@@) ( ق ) عن أبي موسى ا رضي الله عنه 
ms688	 .(@)(@@)(@@)(@@) $ ( 6417 ) قال النبي :(@)(@@) | 30 ( إنما مثل الذي يصلي ورأسه معقوص ، مثل الذي PageV02P426 يصلي وهو مكتوف ) )(@)(@@) ( حم م طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6418 ) قال النبي :(@)(@@) | 30 ( إنما مثل المؤمن حين يصيبه الوعك أو الحمى كمثل حديدة تدخل النار فيذهب خبثها ويبقى طيبها ) )(@)(@@) ( طب ك ) عن عبد الرحمان بن أزهر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6419 ) قال النبي :(@)(@@) | 30 ( إنما مثل المهجر إلى الصلاة كمثل الذي يهدي البدنة ، ثم الذي على أثره كالذي يهدي البقرة ، ثم الذي على أثره كالذي يهدي الكبب ، ثم الذي على أثره كالذي يهدي الدجاجة ، ثم الذي على أثره كالذي يهدي البيضة ) )(@)(@@) ( ت ن ) عن أبي هريرة ( طب ) عن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6420 ) قال النبي :(@)(@@) | 30 ( إنما مثل صاحب القرآن كمثل صاحب الإبل المعقلة ، إن عاهد عليها أمسكها ، وإن أطلقها ذهبت ) )(@)(@@) ( مالك حم ق ن ه ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6421 ) قال النبي :(@)(@@) | 30 ( إنما نسمة المؤمن طائر يعلق في شجر الجنة حتى يبعثه الله إلى جسده يوم يبعثه ) )(@)(@@) ( مالك حم ن ه حب ) عن كعب بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6422 ) قال النبي :(@)(@@) | 30 ( إنما هلك من كان قبلكم بإختلافهم في الكتاب ) )(@)(@@) ( م ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6423 ) قال النبي :(@)(@@) | 30 ( إنما هلكت بنو إسرائيل حين اتخذ هاذه نسائهم ، يعني قصة من شعر ) )(@)(@@) ( ق 3 ) عن معاوية رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6424 ) قال النبي :(@)(@@) | 30 ( إنما هما اثنتان : الكلام والهدي فأحسن الكلام كلام الله ، وأحسن الهدي هدي محمد ، ألا وإياكم ومحدثات الأمور ، فإن شر PageV02P427 الأمور محدثاتها ، وكل محدثة بدعة ، وكل بدعة ضلالة ، ألا لا يطولن عليكم الأمد فتقسو قلوبكم ، ألا إن كل ما هو آت قريب ، وإنما البعيد ما ليس بآت ، ألا إنما الشقي من شقي في بطن أمة ، والسعيد من وعظ بغيره ، ألا إن قتال المؤمن كفر ، وسبابة فسوق ، ولا يحل لمسلم أن يهجر أخاه فوق ثلاث ، ألا وإياكم والكذب فإن الكذب لا يصلح لا بالجد ولا بالهزل 
ms689	 ، ولا يعد الرجل صبيه ولا يفي ، وإن الكذب يهدي إلى الفجور ، وإن الفجور يهدي إلى النار ، وإن الصدق يهدي إلى البر ، وإن البر يهدي إلى الجنة ، وإنه يقال للصادق : صدق وبر ، ويقال للكاذب : كذب وفجر ، ألا وإن العبد يكذب حتى يكتب عند الله كذابا ) )(@)(@@) ( ه طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6425 ) قال النبي :(@)(@@) | 30 ( إنما هما قبضتان ، فقبضة في النار ، وقبضة في الجنة ) )(@)(@@) ( حم طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6426 ) قال النبي :(@)(@@) | 30 ( إنما هي أربعة أشهر وعشر ، وقد كانت إحداكن في الجاهلية ترمي بالبعرة على رأس الحول ) )(@)(@@) ( مالك ق ت ن ه ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6427 ) قال النبي :(@)(@@) | 30 ( إنما هي توبة نبي ، يعني سجدة ص ) )(@)(@@) ( د ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6428 ) قال النبي :(@)(@@) | 30 ( إنما يبعث المقتتلون على النيات ) )(@)(@@) ( ابن عساكر ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6429 ) قال النبي :(@)(@@) | 30 ( إنما يبعث الناس على نياتهم ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6430 ) قال النبي :(@)(@@) | 30 ( إنما يتجالس المتجالسان بأمانة الله تعالى ، فلا يحل PageV02P428 لأحدهما أن يفشي على صاحبه ما يخاف ) )(@)(@@) ( أبو الشيخ ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6431 ) قال النبي :(@)(@@) | 30 ( إنما يخرج الدجال من غضبة يغضبها ) )(@)(@@) ( حم م ) عن حفصة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6432 ) قال النبي :(@)(@@) | 30 ( إنما يدخل الجنة من يرجوها ، وإنما يجنب النار من يخافها ، وإنما يرحم الله من يرحم ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6433 ) قال النبي :(@)(@@) | 30 ( إنما يرحم الله من عباده الرحماء ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6434 ) قال النبي :(@)(@@) | 30 ( إنما يزرع ثلاثة : رجل له أرض فهو يزرعها ، ورجل منح أرضا فهو يزرع ما منح ، ورحل استكرى أرضا بذهب أو فضة ) )(@)(@@) ( د ن ه ) عن رافع بن خديج رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6435 ) قال النبي :(@)(@@) | 30 ( إنما يسلط الله تعالى على ابن آدم من خافه ابن آدم ، ولو أن ابن آدم لم يخف غير الله 
ms690	 لم يسلط الله عليه أحدا ، وإنما وكل ابن آدم لمن رجا ابن آدم ، ولو أن ابن آدم لم يرج إلا الله لم يكله الله إلى غيره ) )(@)(@@) ( الحكيم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6436 ) قال النبي :(@)(@@) | 30 ( إنما يعرف الفضل لأهل الفضل أهل الفضل ) )(@)(@@) ( خط ) عن أنس ( ابن عساكر ) عن عائشة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6437 ) قال النبي :(@)(@@) | 30 ( إنما يغسل من بول الأنثى وينضح من بول الذكر ) )(@)(@@) ( حم د ه ك ) عن أم الفضل رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6438 ) قال النبي :(@)(@@) | 30 ( إنما يقيم من أذن ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV02P429(@)(@@)(@@)(@@) $ ( 6439 ) قال النبي :(@)(@@) | 30 ( إنما يكفي أحدكم ما كان في الدنيا مثل زاد الراكب ) )(@)(@@) ( طب هب ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6440 ) قال النبي :(@)(@@) | 30 ( إنما يكفيك أن تحثي على رأسك ثلاث حثيات من ماء ثم تفيضي على سائر جسدك من الماء فإذا أنت قد طهرت ) )(@)(@@) ( حم 4 ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6441 ) قال النبي :(@)(@@) | 30 ( إنما يكفيك من جمع المال خادم ومركب في سبيل الله ) )(@)(@@) ( ت ن ه ) عن أبي هاشم بن عتبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6442 ) قال النبي :(@)(@@) | 30 ( إنما يلبس علينا صلاتنا قوم يحضرون الصلاة بغير طهور ، من شهد الصلاة فليحسن الطهور ) )(@)(@@) ( حم ش ) عن أبي روح الكلاعي .(@)(@@)(@@)(@@) $ ( 6443 ) قال النبي :(@)(@@) | 30 ( إنما يلبس الحرير في الدنيا من لا خلاق له في الآخرة ) )(@)(@@) ( حم ق د ن ه ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6444 ) قال النبي :(@)(@@) | 30 ( إنما ينصر الله هاذه الأمة بضعيفها بدعوتهم وصلاتهم وإخلاصهم ) )(@)(@@) ( ن ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6445 ) قال النبي :(@)(@@) | 30 ( إنه اتبعنا رجل لم يكن معنا حين دعينا فإن أذنت له دخل ) )(@)(@@) ( ت ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6446 ) قال النبي :(@)(@@) | 30 ( إنه أوحي إلي أنكم تفتنون في القبور ) )(@)(@@) ( ن ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6447 ) قال النبي :(@)(@@) | 30 ( إنه خلق كل إنسان من بني آدم على ستين وثلائمائة مفصل ، فمن كبر الله 
ms691	 وحمد الله وهلل الله ، وسبح الله ، واستغفر الله ، وعزل PageV02P430 حجرا عن طريق الناس ، أو شوكة ، أو عظما عن طريق الناس ، وأمر بمعروف ، أو نهى عن منكر عدد تلك الستين والثلاثمائة السلامى ، فإنه يمسي يومئذ وقد زحزح نفسه عن النار ) )(@)(@@) ( م ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6448 ) قال النبي :(@)(@@) | 30 ( إنه ستكون فرقة واختلاف ، فإذا كان كذالك فاكسر سيفك ، واتخذ سيفا من خشب ، واقعد في بيتك حتى تأتيك يد خاطئة ، أو منية قاضية ) )(@)(@@) ( حم ت ) عن أهبان بن صيفي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6449 ) قال النبي :(@)(@@) | 30 ( إنه ستكون هنات وهنات ، فمن أراد أن يفرق أمر هاذه الأمة وهي جميع فاضربوه بالسيف كائنا من كان ) )(@)(@@) ( حم م د ن ) عن عرفجة بن شريح الأشجعي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6450 ) قال النبي :(@)(@@) | 30 ( إنه سيأتيكم أقوام يطلبون العلم فرحبوا بهم وحيوهم وعلموهم ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6451 ) قال النبي :(@)(@@) | 30 ( إنه سيكون أمراء يؤخرون الصلاة عن مواقيتها ، ألا فصل الصلاة لوقتها ثم ائتهم ، فإن كانوا قد صلوا كنت قد أحرزت صلاتك ، وإلا صليت معهم فكانت تلك نافلة ) )(@)(@@) ( حم م ن ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6452 ) قال النبي :(@)(@@) | 30 ( إنه ستكون أمراء فتعرفون وتنكرون ، فمن أنكر فقد برىء ، ومن كره فقد سلم ، ولاكن من رضي وتابع ) )(@)(@@) ( حم ت ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6453 ) قال النبي :(@)(@@) | 30 ( إنه سيكون في هاذه الأمة قوم يعتدون في الطهور PageV02P431 والدعاء ) )(@)(@@) ( حم د ه حب ك ) عن عبد الله بن مغفل رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6454 ) قال النبي :(@)(@@) | 30 ( إنه سيلي أموركم بعدي رجال يعرفونكم ما تنكرون ، وينكرون عليكم ما تعرفون ، فلا طاعة لمن عصى الله فلا تضلوا بربكم ) )(@)(@@) ( حم ك ) عن عبادة بن الصامت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6455 ) قال النبي :(@)(@@) | 30 ( إنه طرأ علي حزبي من القرآن فكرهت أن أخرج حتى أتمه ) )(@)(@@) ( حم د ه ) عن أوس بن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6456 ) قال 
ms692	 النبي :(@)(@@) | 30 ( إنه عرضت علي الجنة والنار فقربت من الجنة حتى لقد تناولت منها قطفا قصرت يدي عنه ، وعرضت علي النار ، فجعلت أتأخر رهبة أن تغشاني ، ورأيت امرأة حميرية سوداء طويلة تعذب في هرة لها ربطتها فلم تطعمها ولم تسقها ولم تدعها تأكل من خشاش الأرض ، ورأيت فيها أبا ثمامة عمرو بن مالك يجر قصبة في النار ، وإنهم كانوا يقولون : إن الشمس والقمر لا ينكسفان إلا لموت عظيم ، وإنهما آيتان من آيات الله يريكموهما ، فإذا انكسفا فصلوا حتى تنجلي ) )(@)(@@) ( ط م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6457 ) قال النبي :(@)(@@) | 30 ( إنه في ضحضاح من النار ، ولولا أنا لكان في الدرك الأسفل . يعني أبا طالب ) )(@)(@@) ( حم ق ) عن العباس بن عبد المطلب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6458 ) قال النبي :(@)(@@) | 30 ( لا كرب على أبيك بعد اليوم إنه قد حضر من أبيك ما ليس بتارك منه أحدا ، الموافاة يوم القيامة ) )(@)(@@) ( حم خ ) عن أنس رضي الله عنه ( ز ) .(@)(@@) PageV02P432(@)(@@)(@@)(@@) $ ( 6459 ) قال النبي :(@)(@@) | 30 ( إنه قد لعن الموصولات ) )(@)(@@) ( ق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6460 ) قال النبي :(@)(@@) | 30 ( إنه كان يبغض عثمان فأبغضه الله ) )(@)(@@) ( ت ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6461 ) قال النبي :(@)(@@) | 30 ( إنه لم يقبض نبي قط حتى يرى مقعده من الجنة ثم يخير ) )(@)(@@) ( حم ق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6462 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي بعد نوح إلا وقد أنذر الدجال قومه ، وإني أنذركموه لعله سيدركه بعض من قد رآني وسمع كلامي ، قالوا : يا رسول الله فكيف قلوبنا يومئذ ؟ قال : مثلها اليوم أو خير ) )(@)(@@) ( حم د ت حب ك ) عن أبي عبيدة بن الجراح رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6463 ) قال النبي :(@)(@@) | 30 ( إنه لم يكن نبي قبلي إلا كان حقا عليه أن يدل أمته على ما يعلمه خيرا لهم ، وينذرهم ما يعلمه شرا لهم ، وإن أمتكم هاذه جعل عافيتها في أولها ، وسيصيب آخرها بلاء شديد ، وأمور تنكرونها ، وتجيء فتن فيرقق بعضها بعضا ، وتجيء الفتنة 
ms693	 فيقول المؤمن : هاذه مهلكتي ثم تنكشف وتجيء الفتنة ، فيقول المؤمن : هاذه هاذه ، فمن أحب منكم أن يزحزح عن النار ويدخل الجنة فلتأته منيته وهو يؤمن بالله واليوم الآخر ، وليأت إلى الناس الذي يحب أن يؤتى إليه ، ومن بايع إماما فأعطاه صفقة يده وثمرة قلبه فليطعه ما استطاع ، فإن PageV02P433 جاء آخر ينازعه فاضربوا عنق الآخر ) )(@)(@@) ( ش حم م ن ه ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6464 ) قال النبي :(@)(@@) | 30 ( إنه لم يمنعني أن أرد عليك إلا أني كنت أصلي ) )(@)(@@) ( م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6465 ) قال النبي :(@)(@@) | 30 ( إنه لم يمنعني أن أرد عليك إلا أني كنت على غير وضوء ) )(@)(@@) ( حم ه ) عن المهاجر بن قنفذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6466 ) قال النبي :(@)(@@) | 30 ( إنه لو حدث في الصلاة شيء لنبأتكم به ، ولاكن إنما أنا بشر مثلكم ، أنسى كما تنسون ، فإذا نسيت فذكروني ، وإذا شك أحدكم في صلاته فليتحر الصواب فليتم عليه ثم ليسجد سجدتين ) )(@)(@@) ( ق د ن ه حب ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6467 ) قال النبي :(@)(@@) | 30 ( إنه ليأتي الرجل العظيم السمين يوم القيامة لا يزن عند الله جناح بعوضة ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6468 ) قال النبي :(@)(@@) | 30 ( إنه ليس بدواء ولاكنه داء ، يعني الخمر ) )(@)(@@) ( حم م ه ) عن طارق بن سويد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6469 ) قال النبي :(@)(@@) | 30 ( إنه ليس شيء بين السماء والأرض إلا يعلم أني رسول الله إلا عاصي الجن والإنس ) )(@)(@@) ( حم و الدارمي والضياء ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6470 ) قال النبي :(@)(@@) | 30 ( إنه ليس في النوم تفريط إنما التفريط في اليقظة ، فإذا نسي أحدكم صلاة أو نام عنها فليصلها إذا ذكرها لوقتها من الغد ) )(@)(@@)(@@)(@@) $ ( 4 ) عن أبي قتادة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6471 ) قال النبي :(@)(@@) | 30 ( إنه ليس لنبي إذا لبس لامته أن يضعها حتى يقاتل ) )(@)(@@) ( حم ن ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6472 ) قال النبي :(@)(@@) | 30 ( إنه ليس لنبي أن 
ms694	 يدخل بيتا مزوقا ) )(@)(@@) ( د ) عن علي رضي الله عنه ( حم ه حب ك ) عن سفينة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6473 ) قال النبي :(@)(@@) | 30 ( إنه ليس لنبي أن يومض ) )(@)(@@) ( حم د ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6474 ) قال النبي :(@)(@@) | 30 ( إنه ليس من الناس أحد أمن علي في نفسه وماله من أبي بكر بن أبي قحافة ، ولو كنت متخذا من الناس خليلا لاتخذت أبا بكر خليلا ، ولاكن خلة الإسلام أفضل ، سدوا عني كل خوخة في هاذا المسجد غير خوخة أبي بكر ) )(@)(@@) ( حم خ م ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6475 ) قال النبي :(@)(@@) | 30 ( إنه ليس من فرس عربي إلا يؤذن له مع كل فجر يدعو بدعوتين يقول : اللهم إنك خولتني من خولتني من بني آدم فاجعلني من أحب أهله وماله إليه ) )(@)(@@) ( حم ن ك ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6476 ) قال النبي :(@)(@@) | 30 ( إنه ليغان على قلبي وإني لأستغفر الله في اليوم مائة مرة ) )(@)(@@) ( حم م د ن ) عن الأغر المزني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6477 ) قال النبي :(@)(@@) | 30 ( إنه ليغضب علي أن لا أجد ما أعطييه ، من سأل منكم وله أوقية أو عدلها ، فقد سأل إلحافا ) )(@)(@@) ( ن ) عن رجل من بني أسد ( ز ) .(@)(@@) PageV02P435(@)(@@)(@@)(@@) $ ( 6478 ) قال النبي :(@)(@@) | 30 ( إنه من قام مع الإمام حتى ينصرف كتب له قيام ليلة ) )(@)(@@) ( ت ه حب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6479 ) قال النبي :(@)(@@) | 30 ( إنه من لم يسأل الله تعالى يغضب عليه ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6480 ) قال النبي :(@)(@@) | 30 ( إنه لا بد للعرس من وليمة ) )(@)(@@) ( حم ن ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6481 ) قال النبي :(@)(@@) | 30 ( إنه لا بد مما لا بد منه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6482 ) قال النبي :(@)(@@) | 30 ( إنه لا تتم صلاة أحدكم حتى يسبغ الوضوء كما أمره الله ، فيغسل وجهه ويديه إلى المرفقين ويمسح برأسه ورجليه إلى الكعبين ، ثم يكبر الله ويحمده ويمجده ويقرأ ما تيسر 
ms695	 من القرآن مما علمه الله ، وأذن له فيه ، ثم يكبر فيركع فيضع يديه على ركبتيه ، ويرفع حتى تطمئن مفاصله وتسترخي ، ثم يقول : سمع الله لمن حمده فيستوي قائما حتى يأخذ كل عظم مأخذه ويقيم صلبه ثم يكبر فيسجد فيمكن جبهته من الأرض حتى تطمئن مفاصله وتسترخي ، ثم يكبر فيرفع رأسه فيستوي قاعدا على مقعدته ويقيم صلبه ، ثم يكبر فيسجد حتى يمكن وجهه ويسترخي ، لا تتم صلاة أحدكم حتى يفعل ذالك ) )(@)(@@) ( د ن ه ك ) عن رفاعة بن رافع رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6483 ) قال النبي :(@)(@@) | 30 ( إنه لا قدست أمة لا يأخذ الضعيف فيها حقه غير متعتع ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6484 ) قال النبي :(@)(@@) | 30 ( إنه لا قليل من أذى الجار ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6485 ) قال النبي :(@)(@@) | 30 ( إنه لا يحبك إلا مؤمن ، ولا يبغضك إلا منافق قاله PageV02P436 لعلي ) )(@)(@@) ( ت ن ه ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6486 ) قال النبي :(@)(@@) | 30 ( إنه لا يدخل الجنة إلا نفس مسلمة ، وإن الله ليؤيد هاذا الدين بالرجل الفاجر ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 6487 قال النبي :(@)(@@) | 30 ( إنه لا يدخل الجنة إلا نفس مسلمة ، وأيام منى أيام أكل وشرب ) )(@)(@@) ( حم ن ه ) عن بشير بن سحيم ( ز ) .(@)(@@)(@@)(@@) $ ( 6488 ) قال النبي :(@)(@@) | 30 ( إنه لا ينبغي أن يعذب بالنار إلا رب النار ) )(@)(@@) ( د ) عن ابن مسعود ( م ) عن كعب بن مالك رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6489 ) قال النبي :(@)(@@) | 30 ( إنه لا ينبغي لنبي أن تكون له خائنة الأعين ) )(@)(@@) ( د ن ك ) عن سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6490 ) قال النبي :(@)(@@) | 30 ( إنه يخرج من ضئضئي هاذا قوم يتلون كتاب الله رطبا لا يجاوز حناجرهم ، يمرقون من الدين كما يمرق السهم من الرمية ، لئن أدركتهم لأقتلنهم قتل ثمود ) ( حم ق ) عن أ$ بي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6491 ) قال النبي :(@)(@@) | 30 ( إنها حبة أبيك ورب الكعبة ، يعني : ع| ائشة 
ms696	 ) )(@)(@@) ( د ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6492 ) قال النبي :(@)(@@) | 30 ( إنها حرم آمن ، إنها حرم آمن ، يعني : المدينة ) )(@)(@@) ( حم م ه ) عن سهل بن حنيف رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6493 ) قال النبي :(@)(@@) | 30 ( إنها ستفتح لكم أرض العجم وستجدون فيها بيوتا يقال لها الحمامات ، فلا يدخلنها الرجال إلا بالأزر ، وامنعوها النساء إلا مريضة أو نفساء ) )(@)(@@) ( د ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@) PageV02P437(@)(@@)(@@)(@@) $ ( 6494 ) قال النبي :(@)(@@) | 30 ( إنها ستكون عليكم بعدي أمراء يشغلهم أشياء عن الصلاة لوقتها حتى يذهب وقتها ، فصلوا الصلاة لوقتها ، قال رجل : إن أدركتها معهم أصلي معهم ؟ قال : نعم إن شئت ) )(@)(@@) ( حم د والضياء ) عن عبادة بن الصامت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6495 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتن ، ألا ثم تكون فتنة ، المضطجع فيها خير من الجالس ، والجالس فيها خير من القائم ، والقائم فيها خير من الماشي ، والماشي فيها خير من الساعي إليها ، ألا فإذا نزلت أو وقعت ، فمن كانت له إبل فليلحق بابله ، ومن كانت له غنم فليلحق بغنمه ، ومن كانت له أرض فليلحق بأرضه ، ومن لم يكن له شيء من ذالك فليعمد إلى سيفه فيدق على حده بحجر ثم لينج إن استطاع النجاء ، اللهم هل بلغت ، اللهم هل بلغت ) )(@)(@@) ( حم م د ) عن أبي بكرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6496 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة ، القا عد فيها خير من القائم ، والقائم خير من الماشي ، والماشي خير من الساعي ، قيل : أفرأيت إن دخل علي بيتي وبسط يده ليقتلني ؟ قال : كن كابن آدم ) )(@)(@@) ( د ) عن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6497 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة تستنظف العرب قتلاها في النار ، اللسان فيها أشد من وقع السيف ) )(@)(@@) ( د ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6498 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة ، قيل : فما المخرج منها ؟ قال : كتاب الله ، فيه نبا من قبلكم ، وخبر من بعدكم ، وحكم ما بينكم ، هو الفصل ليس بالهزل ، من تركه من جبار قصمه الله ، ومن ابتغى الهدى 
ms697	 في غيره أضله الله ، وهو حبل الله المتين ، وهو الذكر الحكيم ، وهو الصراط المستقيم هو الذي لا تزيع به الأهواء ، ولا تشبع منه العلماء ، ولا تلتبس به الألسن ، ولا تخلق عن الرد ، ولا PageV02P438 تنقضي عجائبه ، هو الذي لم تفته الجن إذ سمعته عن أن قالوا : إنا سمعنا قرآنا عجبا يهدي إلى الرشد ، من قال به صدق ، ومن حكم به عدل ، ومن عمل به أجر ، ومن دعا إليه هدي إلى صراط مستقيم ) )(@)(@@) ( ت ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6499 ) قال النبي :(@)(@@) | 30 ( إنها ستكون فتنة وفرقة واختلاف ، فإذا كان ذالك فائت بسيفك أحدا فاضربه حتى ينقطع ثم اجلس في بيتك حتى تأتيك يد خاطئة ، أو منية قاضية ) )(@)(@@) ( حم ه ) عن محمد بن مسلمة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6500 ) قال النبي :(@)(@@) | 30 ( إنها صلاة رغبة ورهبة سألت الله فيها ثلاث خصال ، فأعطاني اثنتين ومنعني واحدة ، سألته أن لا يسحتكم بعذاب أصاب من كان قبلكم فأعطانيها ، وسألته أن لا يسلط على بيضتكم عدوا فيجتاحها فأعطانيها ، وسألته أن لا يلبسكم شيعا ويذيق بعضكم بأس بعض فمنعنيها ) )(@)(@@) ( ع طب ) و الضياء عن خالد الخزاعي ( حم ت ن حب ) والضياء عن خباب رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6501 ) قال النبي :(@)(@@) | 30 ( إنها طيبة تنفي الرجال كما تنفي النار خبث الحديد ) )(@)(@@) ( ق ن ) عن زيد بن ثابت رضي الله عنه ( ز ) وفي رواية تنفي الدجال .(@)(@@)(@@)(@@) $ ( 6502 ) قال النبي :(@)(@@) | 30 ( إنها لمباركة ، هي طعام طعم وشفاء سقم يعني زمزم ) )(@)(@@) ( الطيالسي ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6503 ) قال النبي :(@)(@@) | 30 ( إنها ليست بدواء ولاكنها داء ، يعني الخمر ) )(@)(@@) ( ن ) عن وائل بن حجر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6504 ) قال النبي :(@)(@@) | 30 ( إنها ليست بنجس ، إنها من الطوافين عليكم والطوافات ، يعني الهرة ) )(@)(@@) ( مالك حم 4حب ك ) عن أبي قتادة ( د هق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@) PageV02P439(@)(@@)(@@)(@@) $ ( 6505 ) قال النبي :(@)(@@) | 30 ( إنها مباركة ، إنها طعام طعم ، يعني زمزم ) )(@)(@@) ( حم م ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6506 ) قال 
ms698	 النبي :(@)(@@) | 30 ( إنها لا يرمى بها لموت أحد ولا لحياته ، ولاكن ربنا تبارك وتعالى إذا قضى أمرا سبح حملة العرش ، ماذا قال ربكم ؟ فيخبرونهم ماذا قال ، فيستخبر بعض أهل السماوات بعضا ، حتى يبلغ الخبر هاذه السماء الدنيا فتخطف الجن السمع فيقذفون إلى أوليائهم ويرمون ، فما جاؤوا به على وجهه فهوغ حق ، ولاكنهم يقترفون فيه فيزيدون ) )(@)(@@) ( حم ت ) عن ابن عباس رضي الله عنهما ( م ت ) عنه عن رجل من الأنصار ( ز ) .(@)(@@)(@@)(@@) $ ( 6507 ) قال النبي :(@)(@@) | 30 ( إنهما ليعذبان ، وما يعذبان في كبير ، أما أحدهما فكان لا يستنزه من البول ، وأما الآخر فكان يمشي بالنميمة ) )(@)(@@) ( حم ق 4 ) عن ابن عباس ( حم ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6508 ) قال النبي :(@)(@@) | 30 ( إنهما ليعذبان وما يعذبان في كبير ، أما أحدهما فيعذب في البول ، وأما الآخر فيعذب في الغيبة ) )(@)(@@) ( حم ه ) عن أبي بكرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6509 ) قال النبي :(@)(@@) | 30 ( إنهم كانوا يسمون بأنبيائهم والصالحين قبلهم ) )(@)(@@) ( حم م ت ) عن المغيرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6510 ) قال النبي :(@)(@@) | 30 ( إنهم يبعثون على نياتهم ) )(@)(@@) ( ت ه ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@) PageV02P440(@)(@@)(@@)(@@) $ ( 6511 ) قال النبي :(@)(@@) | 30 ( إنهم يخيروني بين أن يسألوني بالفحش أو يبخلوني ولست بباخل ) )(@)(@@) ( حم م ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6512 ) قال النبي :(@)(@@) | 30 ( إني أبرأ إلى الله أن يكون لي منكم خليل ، فإن الله قد اتخذني خليلا كما اتخذ إبراهيم خليلا ولو كنت متخذا من أمتي خليلا لاتخذت أبا بكر خليلا ، ألا وإن من كان قبلكم كانوا يتخذون قبور أنبيائهم وصالحيهم مساجد ، ألا فلا تتخذوا القبور مساجد ، إني أنهاكم عن ذالك ) )(@)(@@) ( م ) عن جندب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6513 ) قال النبي :(@)(@@) | 30 ( إني أحدثكم الحديث فليحدث الحاضر منكم الغائب ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6514 ) قال النبي :(@)(@@) | 30 ( إني أحرج عليكم حق الضعيفين : اليتيم والمرأة ) )(@)(@@) ( ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6515 ) قال النبي :(@)(@@) | 30 ( إني أحرم ما بين لابتي 
ms699	 المدينة أن يقطع عضاهها أو يقتل صيدها ، المدينة خير لهم لو كانوا يعلمون ، لا يدعها أحد رغبة عنها ، إلا أبدل الله فيها من هو خير منه ، ولا يثبت أحد على لأوائها وجهدها إلا كنت له شفيعا أو شهيدا يوم القيامة ، ولا يريد أحد أهل المدينة بشر إلا أذابه الله في النار ذوب الرصاص ، أو ذوب الملح في الماء ) )(@)(@@) ( حم م ) عن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6516 ) قال النبي :(@)(@@) | 30 ( إني أرى ما لا ترون ، وأسمع ما لا تسمعون ، أطت السماء وحق لها أن تئط ، ما فيها موضع أربع أصابع إلا وملك واضع جبهته لله تعالى ساجدا ، والله لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا ، وما تلذذتم PageV02P441 بالنساء على الفرش ، ولخرجتم إلى الصعدات تجأرون إلى الله ) )(@)(@@) ( حم ت ه ك ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6517 ) قال النبي :(@)(@@) | 30 ( إني أراك تحب الغنم والبادية ، فإذا كنت في غنمك أو باديتك فأذنت للصلاة فارفع صوتك بالنداء ، فإنه لا يسمع مدى صوت المؤذن جن ولا إنس ولا حجر ولا شجر ولا شيء إلا شهد له يوم القيامة ) )(@)(@@) ( حم مالك خ ن ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6518 ) قال النبي :(@)(@@) | 30 ( إني أراكم تقرؤون وراء إمامكم فلا تفعلوا إلا بام القرآن ، فإنه لا صلاة لمن لم يقرأ بها ) )(@)(@@) ( ت حب ك ) عن عبادة بن الصامت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6519 ) قال النبي :(@)(@@) | 30 ( إني أريت ليلة القدر ثم أنسيتها ، فالتمسوها في العشر الأواخر في الوتر ، وإني رأيت أني أسجد في ماء وطين من صبيحتها ) )(@)(@@) ( مالك حم ق ن ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6520 ) قال النبي :(@)(@@) | 30 ( إني أشهد عدد تراب الدنيا أن مسيلمة كذاب ) )(@)(@@) ( طب ) عن وبر الحنفي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6521 ) قال النبي :(@)(@@) | 30 ( إني أعطي رجالا حديثي عهد بكفر أتألفهم ، أما ترضون أن يذهب الناس بالأموال وترجعون إلى رحالكم برسول الله ، فوالله لما تنقلبون به خير مما ينقلبون به ، إنكم سترون 
ms700	 بعدي أثرة شديدة فاصبروا حتى تلقوا الله ورسوله ، فإني فرطكم على الحوض ) )(@)(@@) ( ق ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6522 ) قال النبي :(@)(@@) | 30 ( إني أعطي قريشا لأتألفهم لأنهم حديثو عهد بجاهلية ) )(@)(@@) ( خ ) عن أنس رضي الله عنه ( ز ) .(@)(@@) PageV02P442(@)(@@)(@@)(@@) $ ( 6523 ) قال النبي :(@)(@@) | 30 ( إني أعطي قوما أخاف ظلعهم وجزعهم ، وأكل قوما إلى ما جعل الله في قلوبهم من الخير والغنى ، منهم ع| مرو بن تغلب ) )(@)(@@) ( خ ) عن عمرو بن تغلب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6524 ) قال النبي :(@)(@@) | 30 ( إني أوعك كما يوعك رجلان منكم ) )(@)(@@) ( حم م ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6525 ) قال النبي :(@)(@@) | 30 ( إني بين أيديكم فرط لكم وأنا شهيد عليكم وإن موعدكم الحوض ، وإني والله لأنظر إلى حوضي الآن ، وإني قد أعطيت مفاتيح خزائن الأرض ، وإني والله ما أخاف عليكم أن تشركوا بعدي ، ولاكني أخاف عليكم الدنيا أن تنافسوا فيها ) )(@)(@@) ( حم ق ) عن عقبة بن عامر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6526 ) قال النبي :(@)(@@) | 30 ( إني تارك فيكم خليفتين : كتاب الله حبل ممدود ما بين السماء والأرض ، وعترتي أهل بيتي ، وإنهما لم يتفرقا حتى يردا علي الحوض ) )(@)(@@) ( حم طب ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6527 ) قال النبي :(@)(@@) | 30 ( إني تارك فيكم ما إن تمسكتم به لن تضلوا بعدي ، أحدهما أعظم من الآخر : كتاب الله حبل ممدود من السماء إلى الأرض ، وعترتي أهل بيتي ، ولن يتفرقا حتى يردا علي الحوض ، فانظروا كيف تخلفوني فيهما ) )(@)(@@) ( ت ) عن زيد بن أرقم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6528 ) قال النبي :(@)(@@) | 30 ( إني قد حدثتكم عن الدجال حتى خشيت أن لا تعقلوا ، إن المسيح الدجال رجل قصير ، أفحج جعد أعور مطموس العين ، PageV02P443 ليست بناتئة ولا حجراء ، فإن التبس عليكم فاعلموا أن ربكم ليس بأعور ، وإنكم لن تروا ربكم حتى تموتوا ) )(@)(@@) ( حم د ) عن عبادة بن الصامت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6529 ) قال النبي :(@)(@@) | 30 ( إني حرمت ما بين لابتي المدينة كما حرم إبراهيم مكة ) )(@)(@@) ( م ) عن أبي سعيد رضي الله عنه 