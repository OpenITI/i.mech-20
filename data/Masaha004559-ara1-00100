ms86	 ما بينكم (409/ 4).(@)(@)(@@) @HAD07 1966 كفى بالقرآن داعيا (573/ 4).(@)(@)(@@) @HAD027 1967 نور لمن استضاء به وشاهد لمن خاصم به وفلج لمن حاج به وعلم [حلم] لمن وعى وحكم لمن قضى (182/ 6).(@)(@)(@@) @HAD017 1968 هو الذي لا تزيغ به الأهواء ولا تلتبس به الشبه والآراء (205/ 6).(@)(@)(@@) @HAD016 1969 هو الفصل ليس بالهزل هو الناطق بسنة العدل والآمر بالفضل هو حبل الله المتين(@)(@)PageV01P110(@)(@)(@@) @HAD044 والذكر الحكيم هو وحي الله الأمين وحبله المتين وهو ربيع القلوب وينابيع العلم وهو الصراط المستقيم هو هدى لمن ائتم به وزينة لمن تحلى به وعصمة لمن اعتصم به وحبل لمن تمسك به (207/ 6).(@)(@)(@@) @HAD017 1970 لا تفنى عجائبه ولا تنقضي غرائبه ولا تنجلي الشبهات إلا به (408/ 6).(@)(@)(@@)(@@)(@@) ||| هداية القرآن(@)(@)(@@) @HAD07 1971 القرآن أفضل الهدايتين (23/ 2).(@)(@)(@@) @HAD024 1972 اتبعوا النور الذي لا يطفأ والوجه الذي لا يبلى واستسلموا وسلموا لأمره فإنكم لن تضلوا مع التسليم (257/ 2).(@)(@)(@@) @HAD022 1973 إن هذا القرآن هو الناصح الذي لا يغش والهادي الذي لا يضل والمحدث الذي لا يكذب (569/ 2).(@)(@)(@@) @HAD011 1974 من اتخذ قول الله دليلا هدي إلى التي هي أقوم @HAD@ (374/ 5).(@)(@)(@@) @HAD021 1975 ما جالس أحد هذا القرآن إلا قام بزيادة أو نقصان زيادة في هدى أو نقصان في عمى (103/ 6).(@)(@)(@@) @HAD012 1976 لن تأخذوا بميثاق الكتاب حتى تعرفوا الذي نبذه (70/ 5).(@)(@)(@@)(@@)(@@) ||| العمل بالقرآن(@)(@)(@@) @HAD013 1977 إذا دعاك القرآن إلى خلة جميلة فخذ نفسك بأمثالها (177/ 3).(@)(@)(@@) @HAD020 1978 تمسك بحبل القرآن وانتصحه وحلل حلاله وحرم حرامه واعمل بعزائمه وأحكامه (313/ 3).(@)(@)(@@) @HAD011 1979 سلوا الله الإيمان واعملوا بموجب القرآن (155/ 4).(@)(@)(@@) @HAD011 1980 ما آمن بما حرمه القرآن من استحله (89/ 6).(@)(@)(@@) @HAD028 1981 يأتي على الناس زمان لا يبقى من القرآن إلا رسمه ولا من الإسلام إلا اسمه مساجدهم يومئذ عامرة من البنى خالية عن الهدى (491/ 6).(@)(@)(@@)(@@)(@@) ||| شفاعة القرآن(@)(@)(@@) @HAD014 1982 قال (ع) في وصف القرآن شافع مشفع وقائل مصدق (190/ 4).(@)(@)(@@) @HAD018 1983 من شفع له القرآن يوم القيامة شفع فيه ومن محل به صدق عليه (431/ 5).(@)(@)(@@) @HAD013 1984 لا تستشفين بغير القرآن فإنه من كل داء شاف (298/ 6).(@)(@)(@@)(@@)(@@) ||| التدبير في القرآن(@)(@)(@@) @HAD013 1985 تدبروا آيات القرآن واعتبروا به فإنه أبلغ العبر (284/ 3).(@)(@)(@@) @HAD029 1986 عليكم بهذا القرآن أحلوا حلاله وحرموا حرامه واعملوا بمحكمه [بحكمه] وردوا 
ms87	 متشابهه إلى عالمه فإنه شاهد عليكم وأفضل ما به توسلتم (302/ 4).(@)(@)(@@)(@@)(@@) ||| أهل القرآن(@)(@)(@@) @HAD010 1987 أهل القرآن أهل الله وخاصته (382/ 1).(@)(@)(@@) @HAD07 1988 ليكن سميرك القرآن (51/ 5).(@)(@)(@@) @HAD011 1989 ليس لأحد بعد القرآن من فاقة ولا لأحد قبل(@)(@)PageV01P111(@)(@)(@@) @HAD05 القرآن غنى (83/ 5).(@)(@)(@@)(@@)(@@) ||| تلاوة القرآن(@)(@)(@@) @HAD016 1990 أحسنوا تلاوة القرآن فإنه أنفع القصص واستشفوا به فإنه شفاء الصدور (257/ 2).(@)(@)(@@) @HAD015 1991 تعلموا القرآن فإنه ربيع القلوب واستشفوا بنوره فإنه شفاء الصدور (303/ 3).(@)(@)(@@) @HAD08 1992 لقاح الإيمان تلاوة القرآن (131/ 5).(@)(@)(@@) @HAD012 1993 من أنس بتلاوة القرآن لم توحشه مفارقة الإخوان (369/ 5).(@)(@)PageV01P112(@)(@)(@@)(@@)(@@) ||| الباب الخامس في الإمامة(@)(@)PageV01P113(@)(@)(@@)(@@)(@@) ||| الفصل الأول في الأئمة(@)(@)(@@)(@@)(@@) ||| في ضرورة الإمامة ووصف من عرفهم(@)(@)(@@) @HAD024 1994 لا تخلو الأرض من قائم لله بحججه إما ظاهرا مشهورا وإما باطنا مغمورا لئلا تبطل حجج الله وبيناته (410/ 6).(@)(@)(@@) @HAD035 1995 أسعد الناس من عرف فضلنا وتقرب إلى الله بنا وأخلص حبنا وعمل بما إليه ندبنا وانتهى عما عنه نهينا فذاك منا وهو في دار المقامة معنا (461/ 2).(@)(@)(@@) @HAD032 1996 إنما الأئمة قوام الله على خلقه وعرفاؤه على عباده ولا يدخل الجنة إلا من عرفهم وعرفوه ولا يدخل النار إلا من أنكرهم وأنكروه (94/ 3).(@)(@)(@@) @HAD048 1997 من مات على فراشه وهو على معرفة حق ربه ورسوله وحق أهل بيته مات شهيدا ووقع أجره على الله سبحانه واستوجب ثواب ما نوى من صالح عمله وقامت نيته مقام إصلاته سيفه فإن لكل شيء أجلا لا يعدوه (435/ 5).(@)(@)(@@)(@@)(@@) ||| في فضائلهم(@)(@)(@@) @HAD017 1998 وإنا لأمراء الكلام فينا تشبثت [انشبثت] فروعه وعلينا [عليها] تهدلت أغصانه (336/ 2).(@)(@)(@@) @HAD018 1999 ألا وإنا [إن] أهل البيت أبواب الحكم وأنوار الظلم وضياء الأمم (341/ 2).(@)(@)(@@) @HAD028 2000 أين تتيهون ومن أين تؤتون وأنى تؤفكون وعلام تعمهون وبينكم عترة نبيكم [أين] وهم أزمة الصدق وألسنة الحق (362/ 2).(@)(@)(@@) @HAD042 2001 أين الذين زعموا أنهم هم الراسخون في العلم دوننا كذبا وبغيا علينا وحسدا لنا إن رفعنا الله سبحانه ووضعهم وأعطانا وحرمهم وأدخلنا وأخرجهم بنا يستعطى الهدى ويستجلى العمى لا بهم (365/ 2).(@)(@)(@@) @HAD017 2002 إن للا إله إلا الله شروطا وإني [أنا] وذريتي من شروطها (514/ 2).(@)(@)(@@) @HAD029 2003 إن أمرنا صعب مستصعب وخشن مخشوشن سر مستتر مقنع لا يحمله إلا ملك مقرب أو 
ms88	 نبي مرسل أو مؤمن امتحن الله سبحانه قلبه للإيمان (550/ 2).(@)(@)(@@) @HAD012 2004 إن نطقوا صدقوا وإن صمتوا لم يسبقوا (12/ 3).(@)(@)PageV01P115(@)(@)(@@) @HAD017 2005 أنا وأهل بيتي أمان لأهل الأرض كما أن النجوم أمان لأهل السماء (41/ 3).(@)(@)(@@) @HAD013 2006 عباد مخلوقون اقتدارا ومربوبون اقتسارا ومقبوضون احتضارا (354/ 4).(@)(@)(@@) @HAD018 2007 لو كنا نأتي ما تأتون لما قام للدين عمود ولا اخضر للإيمان عود (115/ 5).(@)(@)(@@) @HAD020 2008 نحن دعاة الحق وأئمة الخلق وألسنة الصدق من أطاعنا ملك ومن عصانا هلك (185/ 6).(@)(@)(@@) @HAD014 2009 نحن النمرقة الوسطى بها يلحق التالي وإليها يرجع الغالي (186/ 6).(@)(@)(@@) @HAD021 2010 نحن أمناء الله على عباده ومقيمو الحق في بلاده بنا ينجو الموالي وبنا يهلك المعادي (187/ 6).(@)(@)(@@) @HAD031 2011 نحن شجرة النبوة ومحط الرسالة ومختلف الملائكة وينابيع الحكم ومعادن العلم ناصرنا ومحبنا ينتظر الرحمة وعدونا ومبغضينا [مبغضنا] ينتظر السطوة (187/ 6).(@)(@)(@@) @HAD036 2012 هم دعائم الإسلام وولائج الاعتصام بهم عاد الحق في نصابه وانزاح الباطل عن مقامه وانقطع لسانه من منبته عقلوا الدين عقل وعاية ورعاية لا عقل سماع ورواية (215/ 6).(@)(@)(@@) @HAD026 2013 هم موضع سر رسول الله ص وحماة أمره وعيبة علمه وموئل حكمه وكهوف كتبه وجبال [حبال] دينه (216/ 6).(@)(@)(@@) @HAD018 2014 هم كرائم الإيمان وكنوز الرحمن إن قالوا صدقوا وإن صمتوا لم يسبقوا (217/ 6).(@)(@)(@@) @HAD017 2015 هم كنوز الإيمان ومعادن الإحسان إن حكموا عدلوا وإن حاجوا خصموا (218/ 6).(@)(@)(@@) @HAD017 2016 هم أساس الدين وعماد اليقين إليهم يفيء العالي وبهم يلحق التالي (218/ 6).(@)(@)(@@) @HAD016 2017 هم مصابيح الظلم وينابيع الحكم ومعادن العلم ومواطن الحلم (218/ 6).(@)(@)(@@) @HAD032 2018 هم عيش العلم وموت الجهل يخبركم حلمهم عن علمهم وصمتهم عن منطقهم لا يخالفون الحق ولا يختلفون فيه فهو بينهم صامت ناطق وشاهد صادق (219/ 6).(@)(@)(@@) @HAD022 2019 لا يقاس بآل محمد ص من هذه الأمة أحد ولا يستوي بهم من جرت نعمتهم عليه أبدا (432/ 6).(@)(@)(@@)(@@)(@@) ||| التمسك بهم(@)(@)(@@) @HAD026 2020 إن أمرنا صعب مستصعب لا يحتمله إلا عبد امتحن الله قلبه للإيمان ولا يعي حديثنا إلا صدور أمينة وأحلام رزينه (545/ 2).(@)(@)(@@) @HAD015 2021 زر في الله أهل طاعته وخذ الهداية من أهل ولايته (113/ 4).(@)(@)(@@) @HAD015 2022 سلموا لأمر الله ولأمر وليه فإنكم لن تضلوا مع التسليم (139/ 4).(@)(@)(@@) @HAD09 2023 شقوا أمواج الفتن بسفن النجاة 
ms89	 (187/ 4).(@)(@)(@@) @HAD010 2024 عليك بطاعة من لا تعذر بجهالته (290/ 4).(@)(@)(@@) @HAD017 2025 عليكم بطاعة أئمتكم فإنهم الشهداء عليكم اليوم والشفعاء لكم عند الله غدا (309/ 4).(@)(@)(@@) @HAD08 2026 من تمسك بنا لحق (184/ 5).(@)(@)(@@) @HAD08 2027 من تخلف عنا محق (184/ 5).(@)(@)(@@) @HAD08 2028 من اتبع أمرنا سبق (184/ 5).(@)(@)(@@) @HAD09 2029 من ركب غير سفينتنا غرق (184/ 5).(@)(@)(@@) @HAD010 2030 من أطاع إمامه فقد أطاع ربه (352/ 5).(@)(@)PageV01P116(@)(@)(@@) @HAD021 2031 نحن باب حطة وهو باب السلام من دخله سلم ونجا ومن تخلف عنه هلك (186/ 6).(@)(@)(@@) @HAD030 2032 نحن الشعار والأصحاب والسدنة والأبواب ولا يؤتى البيوت إلا من أبوابها ومن أتاها من غير أبوابها كان سارقا لا تعدوه العقوبة (189/ 6).(@)(@)(@@) @HAD022 2033 لا تزلوا عن الحق وأهله فإنه من استبدل بنا أهل البيت هلك وفاتته الدنيا والآخرة (337/ 6).(@)(@)(@@) @HAD012 2034 إنما الناس رجلان متبع شرعة ومبتدع بدعة (74/ 3).(@)(@)(@@)(@@)(@@) ||| في حبهم وبغضهم(@)(@)(@@) @HAD038 2035 أشد الناس عمى من عمي عن حبنا وفضلنا وناصبنا العداوة بلا ذنب سبق منا إليه إلا أنا دعوناه إلى الحق ودعاه سوانا إلى الفتنة والدنيا فآثروها ونصبوا العداوة لنا (461/ 2).(@)(@)(@@) @HAD011 2036 أحسن الحسنات حبنا وأسوء السيئات بغضنا (480/ 2).(@)(@)(@@) @HAD017 2037 إنكم ستعرضون على سبي والبراءة مني فسبوني وإياكم والبراءة مني (70/ 3).(@)(@)(@@) @HAD011 2038 لبغضنا [لمبغضنا] أمواج من سخط الله سبحانه (32/ 5).(@)(@)(@@) @HAD025 2039 لو ضربت خيشوم المؤمن على أن يبغضني ما أبغضني ولو صببت الدنيا بجملتها على المنافق على أن يحبني ما أحبني (109/ 5).(@)(@)(@@) @HAD013 2040 أولى الناس بنا من والانا وعادى من عادانا (483/ 2).(@)(@)(@@) @HAD030 2041 عليكم بحب آل نبيكم فإنه حق الله عليكم والموجب على الله حقكم ألا ترون إلى قول الله تعالى قل لا أسئلكم عليه أجرا إلا المودة في القربى @HAD@ (307/ 4).(@)(@)(@@) @HAD08 2042 لو أحبني جبل لتهافت (114/ 5).(@)(@)(@@) @HAD021 2043 من أحبنا بقلبه وكان معنا بلسانه وقاتل عدونا بسيفه فهو معنا في الجنة في درجتنا (237/ 5).(@)(@)(@@) @HAD023 2044 من أحبنا بقلبه في قلبه وأعاننا بلسانه ولم يقاتل معنا بيده فهو معنا في الجنة دون درجتنا (237/ 5).(@)(@)(@@) @HAD011 2045 من أحبنا فليعمل بعملنا وليتجلبب الورع (303/ 5).(@)(@)(@@)(@@)(@@) ||| في حقهم(@)(@)(@@) @HAD017 2046 لنا حق إن أعطيناه وإلا ركبنا أعجاز الإبل وإن طال السرى (127/ 5).(@)(@)(@@) @HAD018 2047 لنا على الناس حق الطاعة والولاية ولهم من الله سبحانه حسن الجزاء (129/ 5).(@)(@)(@@)(@@)(@@) ||| في 
ms90	 الشيعة(@)(@)(@@) @HAD018 2048 إن أهل الجنة ليترائون منازل شيعتنا كما يتراءى الرجل منكم الكواكب في أفق السماء (531/ 2).(@)(@)(@@) @HAD033 2049 إن الله تعالى اطلع إلى الأرض فاختار لنا شيعة ينصروننا ويفرحون لفرحنا ويحزنون لحزننا ويبذلون أنفسهم وأموالهم فينا فأولئك منا وهم معنا في الجنان (549/ 2).(@)(@)(@@) @HAD09 2050 إن الله سبحانه اطلع إلى الأرض فاختار لنا(@)(@)PageV01P117(@)(@)(@@) @HAD021 شيعة ينصروننا ويفرحون لفرحنا ويحزنون لحزننا ويبذلون أنفسهم وأموالهم فينا أولئك منا وإلينا (668/ 2).(@)(@)(@@) @HAD012 2051 شيعتنا كالنحل لو عرفوا ما في جوفها لأكلوها (190/ 4).(@)(@)(@@) @HAD012 2052 شيعتنا كالأترجة طيب ريحها حسن ظاهرها وباطنها (190/ 4).(@)(@)(@@)(@@)(@@) ||| ذم الغالي(@)(@)(@@) @HAD017 2053 إياكم والغلو فينا قولوا إنا مربوبون واعتقدوا في فضلنا ما شئتم (324/ 2).(@)(@)(@@) @HAD012 2054 هلك في رجلان محب غال ومبغض قال (194/ 6).(@)(@)(@@) @HAD011 2055 إلينا يرجع الغالي وبنا يلحق التالي (1/ 2).(@)(@)(@@)(@@)(@@) ||| الفصل الثاني في علي ع(@)(@)(@@)(@@)(@@) ||| فضائله(@)(@)(@@) @HAD046 2056 ألا وقد أمرني الله بقتال أهل النكث والبغي والفساد في الأرض فأما الناكثون فقد قاتلت وأما القاسطون فقد جاهدت وأما المارقة فقد دوخت وأما شيطان الردهة فإني كفيته بصعقة سمعت لها وجيب قلبه ورجة صدره (343/ 2).(@)(@)(@@) @HAD054 2057 إن هاهنا [وأشار بيده إلى صدره] لعلما جما لو أصبت له حملة بلى أصيب لقنا غير مأمون عليه مستعملا آلة الدين للدنيا أو مستظهرا بنعم الله على عباده وبحججه على أوليائه أو منقادا لحملة الحق لا بصيرة له في أحنائه ينقدح الشك في قلبه لأول عارض من شبهة (621/ 2).(@)(@)(@@) @HAD036 2058 أنا قسيم النار وخازن الجنان وصاحب الحوض وصاحب الأعراف وليس منا أهل البيت إمام إلا وهو عارف بأهل ولايته وذلك لقوله تعالى إنما أنت منذر ولكل قوم هاد @HAD@ (26/ 3).(@)(@)(@@) @HAD021 2059 أنا صنو رسول الله والسابق إلى الإسلام وكاسر الأصنام ومجاهد الكفار وقامع الأضداد (33/ 3).(@)(@)(@@) @HAD015 2060 أنا كاب الدنيا لوجهها وقادرها بقدرها ورادها على عقبها (36/ 3).(@)(@)(@@) @HAD037 2061 أنا مع رسول الله ص ومعي عترتي على الحوض [فليأخذ أحدكم بقولنا وليعمل بعملنا] وإنا لنذود عنه أعداءنا ونسقي منه أولياءنا فمن شرب منه شربة لم يظمأ بعدها أبدا (37/ 3).(@)(@)(@@) @HAD011 2062 أنا يعسوب المؤمنين والمال يعسوب الفجار (38/ 3).(@)(@)(@@) @HAD015 2063 أنا وضعت بكلكل [صدور] العرب وكسرت نواجم ربيعة ومضر 
ms91	 (39/ 3).(@)(@)(@@) @HAD036 2064 أنا مخير في الإحسان إلى من لم أحسن إليه ومرتهن بإتمام الإحسان إلى من أحسنت إليه لأني إذا أتممته فقد حفظته وإذا قطعته فقد أضعته وإذا أضعته فلم فعلته (40/ 3).(@)(@)(@@) @HAD016 2065 أنا على رد ما لم أقل أقدر مني على رد ما قلته (40/ 3).(@)(@)(@@) @HAD012 2066 أنا شاهد لكم وحجيج يوم القيامة عليكم (40/ 3).(@)(@)PageV01P118(@)(@)(@@) @HAD019 2067 أنا داعيكم إلى طاعة ربكم ومرشدكم إلى فرائض دينكم ودليلكم إلى ما ينجيكم (41/ 3).(@)(@)(@@) @HAD019 2068 أنا خليفة رسول الله فيكم ومقيمكم على حدود دينكم وداعيكم إلى جنة المأوى (41/ 3).(@)(@)(@@) @HAD017 2069 إني لعلى بينة من ربي وبصيرة من ديني ويقين من أمري (42/ 3).(@)(@)(@@) @HAD014 2070 إني لعلى يقين من ربي وغير شبهة في ديني (42/ 3).(@)(@)(@@) @HAD010 2071 إني محارب أملي ومنتظر أجلي (42/ 3).(@)(@)(@@) @HAD014 2072 إني مستوف رزقي ومجاهد نفسي ومنته إلى قسمي (43/ 3).(@)(@)(@@) @HAD014 2073 إني لعلى جادة الحق وإنهم لعلى مزلة [منزلة] الباطل (43/ 3).(@)(@)(@@) @HAD017 2074 إني لعلى إقامة حجج الله أقاول وعلى نصرة دينه أجاهد وأقاتل (43/ 3).(@)(@)(@@) @HAD030 2075 إني لأرفع نفسي أن تكون حاجة لا يسعها جودي أو جهل لا يسعه حلمي أو ذنب لا يسعه عفوي أو أن يكون زمان أطول من زماني (44/ 3).(@)(@)(@@) @HAD018 2076 إني كنت إذا سألت رسول الله ص أعطاني وإذا سكت عن مسألته ابتدأني (45/ 3).(@)(@)(@@) @HAD028 2077 إني لأرفع نفسي أن أنهى الناس عما لست أنتهي عنه أو آمرهم بما لا أسبقهم إليه بعملي أو أرضى منهم بما لا يرضى ربي (45/ 3).(@)(@)(@@) @HAD023 2078 إني لا أحثكم على طاعة إلا وأسبقكم إليها ولا أنهاكم عن معصية إلا وأتناهى قبلكم عنها (45/ 3).(@)(@)(@@) @HAD018 2079 إني طلقت الدنيا ثلاثا بتاتا لا رجعة لي فيها وألقيت حبلها على غاربها (46/ 3).(@)(@)(@@) @HAD014 2080 إنما مثلي بينكم كالسراج في الظلمة يستضيء بها من ولجها (82/ 3).(@)(@)(@@) @HAD015 2081 سلوني قبل أن تفقدوني فإني بطرق السماء أخبر منكم بطرق الأرض (148/ 4).(@)(@)(@@) @HAD035 2082 سلوني قبل أن تفقدوني فو الله ما في القرآن آية إلا وأنا أعلم فيمن نزلت في سهل أو في جبل وإن ربي وهب لي قلبا عقولا ولسانا ناطقا. (149/ 4).(@)(@)(@@) @HAD016 2083 كنت إذا سألت رسول الله ص أعطاني وإذا أمسكت [سكت] ابتدأني (629/ 4).(@)(@)(@@) @HAD030 2084 
ms92	 لقد رقعت مدرعتي هذه حتى استحييت من راقعها فقال لي قائل ألا تنبذها فقلت له اعزب [اغرب] عني على الصباح [فعند الصباح] يحمد القوم السرى (33/ 5).(@)(@)(@@) @HAD014 2085 لقد كنت وما أهدد بالحرب ولا أرهب بالضرب (54/ 5).(@)(@)(@@) @HAD010 2086 لو كشف الغطاء ما ازددت يقينا (108/ 5).(@)(@)(@@) @HAD012 2087 لو استوت قدماي من هذه المداحض لغيرت أشياء (108/ 5).(@)(@)(@@) @HAD040 2088 لو شئت أن أخبر كل رجل منكم بمخرجه ومولجه وجميع شأنه لفعلت لكني أخاف أن تكفروا في ب رسول الله ص إلا أني مفضيه إلى الخاصة ممن يؤمن ذلك منه والذي بعثه بالحق واصطفاه على(@)(@)PageV01P119(@)(@)(@@) @HAD037 الخلق ما أنطق إلا صادقا ولقد عهد إلي بذلك كله وبمهلك من يهلك وبمنجى من ينجو وما أبقى شيئا يمر على رأسي إلا أفرغه في أذني وأفضى به إلي (121/ 5).(@)(@)(@@) @HAD010 2089 ما كذبت [أكذبت] ولا كذبت (55/ 6).(@)(@)(@@) @HAD011 2090 ما أنكرت الله تعالى منذ عرفته [عرف] (55/ 6).(@)(@)(@@) @HAD011 2091 ما شككت في الحق منذ أريته [رأيته] (55/ 6).(@)(@)(@@) @HAD010 2092 ما ضللت ولا ضل بي (55/ 6).(@)(@)(@@) @HAD035 2093 ما نزلت آية إلا وقد علمت فيما نزلت وأين نزلت في نهار أو في ليل في جبل أو سهل وإن ربي وهب لي قلبا عقولا ولسانا قئولا (102/ 6).(@)(@)(@@) @HAD042 2094 ما بات لرجل عندي موعد قط فبات يتململ على فراشه ليغدو بالظفر بحاجته أشد من تململي على فراشي حرصا على الخروج إليه من دين عدته وخوفا من عائق يوجب الخلف فإن خلف الوعد ليس من أخلاق الكرام (108/ 6).(@)(@)(@@) @HAD018 2095 وسئل (ع) عن مسافة ما بين المشرق والمغرب فقال مسير يوم للشمس (150/ 6).(@)(@)(@@) @HAD012 2096 نحن أقمنا عمود الحق وهزمنا جيوش الباطل (173/ 6).(@)(@)(@@) @HAD012 2097 نسأل الله سبحانه لمنته تماما وبحبله اعتصاما (176/ 6).(@)(@)(@@) @HAD011 2098 هيهات لو لا التقى لكنت أدهى العرب (203/ 6).(@)(@)(@@) @HAD016 2099 وا عجبا أن تكون الخلافة بالصحابة ولا تكون بالصحابة والقرابة (239/ 6).(@)(@)(@@) @HAD013 2100 والله ما كتمت وشمة ولا كذبت كذبة (240/ 6).(@)(@)(@@) @HAD025 2101 والله ما فجعني من الموت وارد كرهته ولا طالع أنكرته وما كنت إلا كغارب ورد أو طالب وجد (241/ 6).(@)(@)(@@) @HAD046 2102 والله لأن أبيت على حسك السعدان مسهدا وأجر في الأغلال مصفدا أحب إلي من أن 
ms93	 ألقى الله ورسوله ظالما لبعض العباد أو غاصبا لشيء من الحطام وكيف أظلم لنفس يسرع إلى البلى قفولها ويطول في الثرى حلولها (249/ 6).(@)(@)(@@) @HAD0129 2103 ولقد علم المستحفظون من أصحاب رسول الله ص أنني لم أرد على الله سبحانه ولا على رسوله ساعة قط ولقد واسيته بنفسي في المواطن التي تنكص فيها الأبطال وتتأخر عنها الأقدام نجدة أكرمني الله بها ولقد بذلت في طاعته ص جهدي وجاهدت أعداءه بكل طاقتي ووقيته بنفسي ولقد أفضى إلي من علمه بما لم يفض به إلى أحد غيري ولقد قبض رسول الله ص وإن رأسه على صدري ولقد سالت نفسه في كفي فأمررتها على وجهي ولقد وليت غسله ص والملائكة أعواني فضجت الدار والأفنية ملأ يهبط وملأ يعرج وما فارقت سمعي هينمة منهم يصلون عليه حتى واريناه ص في ضريحه فمن ذا أحق به مني حيا وميتا (250/ 6).(@)(@)PageV01P120(@)(@)(@@) @HAD055 2104 والذي فلق الحبة وبرأ النسمة لو لا حضور الحاضر وقيام الحجة بوجود الناصر وما أخذ الله سبحانه على العلماء أن لا يقاروا على كظة ظالم ولا سغب مظلوم لألقيت حبلها على غاربها ولسقيت آخرها بكأس أولها ولألفيتم دنياكم هذه عندي أزهد من عفطة عنز (256/ 6).(@)(@)(@@) @HAD013 2105 قد استدار الزمان كهيئته يوم خلق السماوات والأرض (491/ 4).(@)(@)(@@) @HAD016 2106 قد طلع طالع ولمع لامع ولاح لائح واعتدل مائل (482/ 4).(@)(@)(@@)(@@)(@@) ||| في مدح بعض أصحابه(@)(@)(@@) @HAD0151 2107 كان لي فيما مضى أخ في الله وكان يعظمه في عيني صغر الدنيا في عينه وكان خارجا عن سلطان بطنه فلا يشتهي ما لا يجد ولا يكثر إذا وجد وكان أكثر دهره صامتا فإن قال بذ القائلين ونقع غليل السائلين وكان ضعيفا مستضعفا فإن جاء الجد فهو ليث عاد وصل واد لا يدلي بحجة حتى يأتي قاضيا وكان لا يلوم أحدا على ما لا يجد العذر في مثله حتى يسمع اعتذاره وكان لا يشكو وجعا إلا عند برئه وكان يفعل ما يقول ولا يقول ما لا يفعل وكان إذا غلب على الكلام لم يغلب على السكوت وكان على أن يسمع 
ms94	 أحرص منه على أن يتكلم وكان إذا بدهه أمران نظر أيهما أقرب إلى الهوى فخالفه فعليكم بهذه الخلائق فالزموها وتنافسوا فيها فإن لم تستطيعوا فاعلموا أن أخذ القليل خير من ترك الكثير (636/ 4).(@)(@)(@@) @HAD029 2108 وقال (ع) في حق الأشتر النخعي لما بلغه وفاته (رحمه الله) لو كان جبلا لكان فندا لا يرتقيه الحافر ولا يوفي عليه الطائر (119/ 5).(@)(@)(@@) @HAD031 2109 وقال (ع) في مدح مالك الأشتر هو سيف الله لا ينبو عن الضرب ولا كليل الحد ولا تستهويه بدعة ولا تتيه به غواية (210/ 6).(@)(@)(@@) @HAD022 2110 وقال (ع) في حق من أثنى عليه لم يقتله قاتلات الغرور ولم تغم عليه مشتبهات الأمور (105/ 5).(@)(@)(@@) @HAD053 2111 قال (ع) في حق من أثنى عليهم هجم بهم العلم على حقيقة الإيمان وباشروا روح اليقين فاستسهلوا ما استوعر المترفون وأنسوا بما استوحش منه الجاهلون وصحبوا الدنيا بأبدان أرواحها معلقة بالمحل الأعلى أولئك خلفاء الله في أرضه والدعاة إلى دينه آه آه شوقا إلى رؤيتهم (214/ 6).(@)(@)(@@) @HAD010 2112 فتاح مبهمات دليل فلوات دفاع معضلات (427/ 4).(@)(@)(@@) @HAD011 2113 إن تكلموا ذكروا وإن سكتوا تفكروا (13/ 3).(@)(@)(@@) @HAD012 2114 إن نظروا اعتبروا وإن أعرضوا لم يلهوا (12/ 3).(@)(@)(@@)(@@)(@@) ||| مواعظه لأبي ذر(@)(@)(@@) @HAD033 2115 يا أبا ذر إنك إن غضبت لله فارج من غضبت له إن القوم خافوك على دنياهم وخفتهم على دينك فاترك في أيديهم ما خافوك عليه واهرب منهم بما خفتهم عليه(@)(@)PageV01P121(@)(@)(@@) @HAD048 فما أحوجهم إلى ما منعتهم وما أغناك عما منعوك ولو أن السماوات والأرض كانتا على عبد رتقا ثم اتقى الله لجعل له منهما مخرجا فلا يؤنسنك إلا الحق ولا يوحشنك إلا الباطل فلو قبلت دنياهم لأحبوك ولو قرضت منها لأمنوك (464/ 6).(@)(@)(@@)(@@)(@@) ||| ذم بعض أصحابه(@)(@)(@@) @HAD025 2116 قال في حق من ذمه عاش ركاب عشوات جاهل ركاب جهالات عاد على نفسه مزين لها سلوك المحالات وباطل الترهات (358/ 4).(@)(@)(@@) @HAD011 2117 فالصورة صورة إنسان والقلب قلب حيوان (436/ 4).(@)(@)(@@) @HAD021 2118 منهم تخرج الفتنة وإليهم تأوي الخطيئة يردون من شذ عنها فيها ويسوقون من تأخر عنها إليها (144/ 6)(@)(@)(@@) @HAD011 2119 ماتحا في غرب هواه كادحا سعيا لدنياه. (145/ 6).(@)(@)(@@) @HAD018 2120 نسيتم ما ذكرتم وأمنتم 
ms95	 ما حذرتم فتاه عليكم رأيكم وتشتت عليكم أمركم (181/ 6).(@)(@)(@@) @HAD019 2121 قال في وصف بني أمية هي مجاجة في لذيذ العيش يتطعمونها برهة ويلفظونها جملة (197/ 6).(@)(@)(@@) @HAD014 2122 هيهات ما تناكرتم إلا لما قبلكم من الخطايا والذنوب (201/ 6).(@)(@)(@@) @HAD052 2123 هو بالقول مدل ومن العمل مقل وعلى الناس طاعن ولنفسه مداهن هو في مهلة من الله يهوي مع الغافلين ويغدو مع المذنبين بلا سبيل قاصد ولا إمام قائد ولا علم مبين ولا دين متين هو يخشى الموت ولا يخاف الفوت (210/ 6).(@)(@)(@@) @HAD022 2124 والله ما منع الأمن أهله وأزاح الحق عن مستحقه إلا كل كافر جاحد ومنافق ملحد (242/ 6).(@)(@)(@@) @HAD032 2125 والذي فلق الحبة وبرأ النسمة ما أسلموا ولكن استسلموا وأسروا الكفر فلما وجدوا أعوانا عليه أعلنوا ما كانوا أسروا وأظهروا ما كانوا أبطنوا (245/ 6).(@)(@)(@@) @HAD022 2126 لا يحتسب رزية ولا يخشع تقية لا يعرف باب الهدى فيتبعه ولا باب الردى فيصد عنه (429/ 6).(@)(@)(@@) @HAD026 2127 يحب أن يطاع ويعصي ويستوفي ولا يوفي يحب أن يوصف بالسخاء ولا يعطي ويقتضي ولا يقتضى (473/ 6).(@)(@)(@@) @HAD08 2128 هلك من ادعى وخاب من افترى @HAD@ (196/ 6).(@)(@)(@@)(@@)(@@) ||| ذم زمانه وأهل زمانه(@)(@)(@@) @HAD034 2129 اللهم احقن دماءنا ودماءهم وأصلح ذات بيننا وبينهم وأنقذهم [اهدهم] من ضلالتهم حتى يعرف الحق من جهله ويرعوي عن الغي والغدر من لهج به (150/ 2).(@)(@)(@@) @HAD023 2130 ألا وإن الدنيا قد تصرمت وآذنت بانقضاء وتنكر معروفها وصار جديدها رثا وسمينها غثا (332/ 2).(@)(@)(@@) @HAD027 2131 إن كانت الرعايا قبلي تشكوا حيف رعاتها فإني اليوم أشكو حيف رعيتي كأني المقود وهم القادة والموزع [الموزوع] وهم الوزعة (16/ 3).(@)(@)PageV01P122(@)(@)(@@) @HAD012 2132 إن لم يصلحهم إلا إفسادي فلا أصلحهم الله (25/ 3).(@)(@)(@@) @HAD049 2133 إنكم في زمان القائل بالحق قليل واللسان فيه عن الصدق كليل واللازم فيه للحق ذليل أهله متعكفون على العصيان مصطلحون على الإدهان فتاهم عارم وشيخهم آثم وعاملهم منافق وقاريهم ممارق [ممازق] لا يعظم صغيرهم كبيرهم ولا يعول غنيهم فقيرهم (69/ 3).(@)(@)(@@) @HAD082 2134 فيا عجبا وما لي لا أعجب من خطإ هذه الأمة على اختلاف حججها في دياناتها لا يقتصون أثر نبي ولا يقتدون بعمل وصي ولا يؤمنون بغيب ولا يعفون عن عيب 
ms96	 يعملون في الشبهات ويسيرون في الشهوات المعروف فيهم ما عرفوا والمنكر عندهم ما أنكروا مفزعهم في المعضلات إلى أنفسهم وتعويلهم في المبهمات على آرائهم [رأيهم] كأن كلا منهم إمام نفسه قد أخذ فيما يرى بغير وثيقات بينات ولا أسباب محكمات (445/ 4).(@)(@)(@@) @HAD021 2135 خفت عقولكم وسفهت حلومكم فأنتم غرض لنابل وأكلة لآكل وفريسة لصائل [وفريسة الصائل] (455/ 3).(@)(@)(@@) @HAD010 2136 خذلوا الحق ولم ينصروا الباطل (456/ 3).(@)(@)(@@) @HAD024 2137 فالقلوب لاهية من رشدها قاسية عن حظها سالكة في غير مضمارها كأن المعني سواها وكأن الحظ في إحراز دنياها (429/ 4).(@)(@)(@@) @HAD013 2138 قد صرتم بعد الهجرة أعرابا وبعد الموالاة أحزابا (477/ 4).(@)(@)(@@) @HAD012 2139 قد تصافيتم على حب العاجل ورفض الآجل (481/ 4).(@)(@)(@@) @HAD015 2140 قد ذهب منكم الذاكرون والمتذكرون وبقي الناسون والمتناسون (481/ 4).(@)(@)(@@) @HAD014 2141 قد قادتكم أزمة الحين واستغلقت على قلوبكم أقفال الرين (481/ 4).(@)(@)(@@) @HAD020 2142 قد صار دين أحدكم لعقة على لسانه صنيع من فرغ من عمله وأحرز رضا سيده (482/ 4).(@)(@)(@@) @HAD017 2143 قد أمر من الدنيا ما كان حلوا وكدر منها ما كان صفوا (483/ 4).(@)(@)(@@) @HAD019 2144 قد خاضوا بحار الفتن وأخذوا بالبدع دون السنن وتوغلوا الجهل واطرحوا العلم (487/ 4).(@)(@)(@@) @HAD021 2145 قد أصبحنا في زمان عنود ودهر كنود يعد فيه المحسن مسيئا ويزداد الظالم فيه عتوا (488/ 4).(@)(@)(@@) @HAD021 2146 قد تواخى الناس على الفجور وتهاجروا على الدين وتحاببوا على الكذب وتباغضوا على الصدق (490/ 4).(@)(@)(@@) @HAD018 2147 قد ظهر أهل الشر وبطن أهل الخير وفاض الكذب وغاض الصدق (490/ 4).(@)(@)(@@) @HAD011 2148 قد كثر القبيح حتى قل الحياء منه (492/ 4).(@)(@)(@@) @HAD012 2149 قد كثر الكذب حتى قل من يوثق به (492/ 4).(@)(@)(@@) @HAD013 2150 كأن المعني سواها وكأن الحظ في إحراز دنياها (627/ 4).(@)(@)(@@) @HAD022 2151 ما لي أراكم أشباحا بلا أرواح وأرواحا بلا فلاح ونساكا بلا صلاح وتجارا بلا أرباح (90/ 6).(@)(@)PageV01P123(@)(@)(@@) @HAD017 2152 هدر فنيق [هدم رفيق] الباطل بعد كظوم وصال الدهر صيال السبع العقور (202/ 6).(@)(@)PageV01P124(@)(@)(@@)(@@)(@@) ||| الباب السادس المعاد(@)(@)PageV01P125(@)(@)(@@)(@@)(@@) ||| الفصل الأول في الدنيا(@)(@)(@@)(@@)(@@) ||| حقيقة الدنيا(@)(@)(@@) @HAD010 2153 الدنيا دار الغرباء وموطن الأشقياء (316/ 1).(@)(@)(@@) @HAD018 2154 ألا وإن اليوم المضمار وغدا السباق والسبقة الجنة والغاية النار (334/ 2).(@)(@)(@@) @HAD019 2155 إن الدنيا دار فجائع من عوجل فيها فجع بنفسه ومن أمهل فيها فجع بأحبته (623/ 2).(@)(@)(@@) @HAD041 2156 إن الدنيا 
ms97	 معكوسة منكوسة لذاتها تنغيص ومواهبها تغصيص وعيشها عناء وبقاؤها فناء تجمح بطالبها وتردي راكبها وتخون الواثق بها وتزعج المطمئن إليها وإن جمعها إلى انصداع ووصلها إلى انقطاع (624/ 2).(@)(@)(@@) @HAD029 2157 إن الدنيا كالحية لين مسها قاتل سمها فأعرض عما يعجبك فيها لقلة ما يصحبك منها وكن آنس ما تكون بها أحذر ما تكون منها (626/ 2).(@)(@)(@@) @HAD020 2158 إن الدنيا كالغول تغوي من أطاعها وتهلك من أجابها وإنها لسريعة الزوال وشيكة الانتقال (627/ 2).(@)(@)(@@) @HAD051 2159 إن الدنيا لهي الكنود العنود والصدود الجحود والحيود الميود حالها انتقال وسكونها زلزال وعزها ذل وجدها هزل وكثرتها قل وعلوها سفل أهلها على ساق وسياق ولحاق وفراق وهي دار حرب وسلب ونهب وعطب (630/ 2).(@)(@)(@@) @HAD023 2160 إن الدنيا عيشها قصير وخيرها يسير وإقبالها خديعة وإدبارها فجيعة ولذاتها فانية وتبعاتها باقية (635/ 2).(@)(@)(@@) @HAD028 2161 إن الدنيا دار أولها عناء وآخرها فناء في حلالها حساب وفي حرامها عقاب من استغنى فيها فتن ومن افتقر فيها حزن (635/ 2).(@)(@)(@@) @HAD041 2162 إن الدنيا دار شخوص ومحلة تنغيص ساكنها ظاعن وقاطنها بائن وبرقها خالب ونطقها كاذب وأموالها محروبة [مخروبة] وأعلاقها مسلوبة ألا وهي المتصدية العتون [للعيون] والمجامحة الحرون والمانية الخئون (636/ 2).(@)(@)(@@) @HAD08 2163 إن الدنيا تدني الآجال وتباعد الآمال(@)(@)PageV01P127(@)(@)(@@) @HAD024 وتبيد الرجال وتغير الأحوال من غالبها غلبته ومن صارعها صرعته ومن عصاها أطاعته ومن تركها أتته (638/ 2).(@)(@)(@@) @HAD033 2164 إن الدنيا كالشبكة تلتف على من رغب فيها وتتحرز عمن أعرض عنها فلا تمل إليها بقلبك ولا تقبل عليها بوجهك فتوقعك في شبكتها وتلقيك في هلكتها (641/ 2).(@)(@)(@@) @HAD028 2165 إن الدنيا تعطي وترتجع وتنقاد وتمتنع وتوحش وتؤنس وتطمع وتؤيس يعرض عنها السعداء ويرغب فيها الأشقياء (642/ 2).(@)(@)(@@) @HAD025 2166 إن الدنيا ظل الغمام وحلم المنام والفرح الموصول بالغم والعسل المشوب بالسم سلابة النعم أكالة الأمم جلابة النقم (644/ 2).(@)(@)(@@) @HAD039 2167 إن الله تعالى جعل الدنيا لما بعدها وابتلى فيها أهلها ليعلم أيهم أحسن عملا ولسنا للدنيا خلقنا ولا بالسعي لها أمرنا وإنما وضعنا فيها لنبتلى بها ونعمل فيها لما بعدها (659/ 2).(@)(@)(@@) @HAD044 2168 إن الدنيا دار منهالها الفناء ولأهلها منها الجلاء وهي حلوة خضرة قد عجلت للطالب والتبست 
ms98	 بقلب الناظر فارتحلوا عنها بأحسن ما يحضركم من الزاد ولا تسألوا فيها إلا الكفاف ولا تطلبوا منها أكثر من البلاغ (660/ 2).(@)(@)(@@) @HAD064 2169 إن الدنيا لا يسلم منها إلا بالزهد فيها ابتلي الناس بها فتنة فما أخذوا منها لها أخرجوا منه وحوسبوا عليه ما أخذوا منها لغيرها قدموا عليه وأقاموا فيه وإنها عند ذوي العقول كالظل بينا تراه سائغا حتى قلص وزائدا حتى نقص وقد أعذر الله سبحانه إليكم في النهي عنها وأنذركم وحذركم منها فأبلغ (661/ 2).(@)(@)(@@) @HAD016 2170 الدهر يخلق الأبدان ويجدد الآمال ويدني المنية ويباعد الأمنية (55/ 2).(@)(@)(@@) @HAD019 2171 الدنيا إن انجلت انجلت وإذا جلت ارتحلت [إن انحلت انحلت وإذا أحلت أوحلت] (78/ 2).(@)(@)(@@) @HAD014 2172 إن جد الدنيا هزل وعزها ذل وعلوها سفل (503/ 2).(@)(@)(@@) @HAD028 2173 إن الدنيا دار خبال ووبال وزوال وانتقال لا تساوي لذاتها تنغيصها ولا تفي سعودها بنحوسها ولا يقوم صعودها بهبوطها (515/ 2).(@)(@)(@@) @HAD017 2174 إن الدنيا لمفسدة الدين مسلبة اليقين وإنها لرأس الفتن وأصل المحن (532/ 2).(@)(@)(@@) @HAD038 2175 إنما مثل من خير [خبر] الدنيا كمثل قوم سفر نبا بهم منزل جديب فأموا منزلا خصيبا وجنابا مريعا فاحتملوا وعثاء الطريق وخشونة السفر وجشوبة المطعم ليأتوا سعة دارهم ومحل قرارهم (88/ 3).(@)(@)(@@) @HAD016 2176 جود الدنيا فناء وراحتها عناء وسلامتها عطب ومواهبها سلب (361/ 3).(@)(@)(@@) @HAD013 2177 حلو الدنيا صبر وغذاؤها سمام وأسبابها رمام (399/ 3).(@)(@)(@@) @HAD016 2178 خطر الدنيا يسير وحاصلها حقير وبهجتها زور ومواهبها غرور (454/ 3).(@)(@)(@@) @HAD014 2179 دار الفناء مقيل العاصين ومحل الأشقياء والمتعدين [المعتدين] (15/ 4).(@)(@)PageV01P128(@)(@)(@@) @HAD010 2180 صحة الدنيا أسقام ولذاتها آلام (198/ 4).(@)(@)(@@) @HAD016 2181 كثرة الدنيا قلة وعزها ذلة وزخارفها مضلة ومواهبها فتنة (597/ 4).(@)(@)(@@) @HAD025 2182 مثل الدنيا كمثل الحية لين مسها والسم القاتل في جوفها يهوي إليها الغر الجاهل ويحذرها اللبيب العاقل [ذو اللب] (138/ 6).(@)(@)(@@) @HAD027 2183 يا أهل الغرور ما ألهجكم بدار خيرها زهيد وشرها عتيد ونعيمها مسلوب ومسالمها محروب ومالكها مملوك وتراثها متروك (467/ 6).(@)(@)(@@)(@@)(@@) ||| طبيعة الدنيا(@)(@)(@@) @HAD07 2184 المواصل 