ms61	 صدور السمهري المقوم (@)(@@) 56 وأيام حجر ، إذ يحرق نخله ، %~% ثأرناكم يوما بتحريق أرقم (@)(@@) 57 كأن نخيل الشط غب حريقه ، %~% مآتم سود سلبت عند مأتم (@)(@@) 58 ونحن فككنا سيديكم فأرسلا %~% من الموت لما أسلما شر مسلم (@)(@@) 59 نلافاهما بشر من الموت بعدما %~% جرت لهما طير النحوس بأشأم (@)(@@) 60 فذلك من أيامنا وبلائنا ، %~% ونعمى عليكم إن شكرتم لأنعم PageV01P208(@)(@@) 61 فإن أنتم لم تعرفوا ذاك ، فاسألوا %~% أبا مالك أو سائلوا رهط أشيم (@)(@@) 62 وكائن لنا فضلا عليكم ومنة %~% قديما ، فما تدرون ما من منعم (@)PageV01P209(@)(@@) البحر : طويل (@)(@@) 1 بني عمنا لا تبعثوا الحرب بيننا %~% كرد رجيع الرفض وارموا إلى السلم (@)(@@) 2 وكونوا كما كنا نكون ، وحافظوا %~% علينا كما كنا نحافظ عن رهم (@)(@@) 3 نساء موالينا البواكي ، وأنتم %~% مددتم بأيدينا حلاف بني غنم (@)(@@) 4 فلا تكسروا أرماحهم في صدوركم %~% فتغشمكم ، إن الرماح من الغشم (@)PageV01P210(@)(@@) البحر : طويل (@)(@@) 1 ألم خيال من قتيلة بعدما %~% وهى حبلها من حبلنا فتصرما (@)(@@) 2 فبت كأني شارب بعد هجعة %~% سخامية حمراء تحسب عندما (@)(@@) 3 إذا بزلت من دنها فاح ريحها ، %~% وقد أخرجت من أسود الجوف أدهما (@)(@@) 4 لها حارس ما يبرح الدهر بيتها ، %~% إذا ذبحت صلى عليها وزمزما (@)(@@) 5 ببابل لم تعصر ، فجاءت سلافة %~% تخالط قنديدا ومسكا مختما (@)(@@) 6 يطوف بها ساق علينا متوم ، %~% خفيف ذفيف ما يزال مفدما (@)(@@) 7 بكأس وإبريق كأن شرابه ، %~% إذا صب في المصحاة خالط بقما (@)(@@) 8 لنا جلسان عندها وبنفسج ، %~% وسيسنبر ، والمرزجوش منمنما (@)(@@) 9 وآس وخيري ، ومرو وسوسن ، %~% إذا كان هنزمن ورحت مخشما (@)(@@) 10 وشاهسفرم والياسمين ونرجس %~% يصبحنا في كل دجن تغيما PageV01P211 (@)(@@) 11 ومستق سينين وون وبربط %~% يجاوبه صنج إذا ما ترنما (@)(@@) 12 وفتيان صدق لا ضغائن بينهم ، %~% وقد جعلوني فيسحاها مكرما (@)(@@) 13 فدع ذا ولكن رب أرض متيهة %~% قطعت بحرجوج ، إذا الليل أظلما (@)(@@) 14 بناجية كالفحل فيها تجاسر ، %~% إذا الراكب الناجي استقى وتعمما (@)(@@) 15 ترى عينها صغواء في جنب مؤقها %~% تراقب في كفي القطيع المحرما (@)(@@) 16 كأني ورحلي والفتان ونمرقي %~% على ظهر طاو أسفع الخد 
ms62	 أخثما (@)(@@) 17 عليه ديابوذ تسريل تحته %~% أرندج إسكاف يخالط عظلما (@)(@@) 18 فبات عذوبا للسماء كأنما %~% يوائم رهطا للعزوبة صيما (@)(@@) 19 يلوذ إلى أرطاة حقف تلفه %~% خريق شمال تترك الوجه أقتما (@)(@@) 20 مكبا على روقيه يحفر عرقها %~% على ظهر عريان الطريقة أهيما (@)PageV01P212 (@)(@@) 21 فلما أضاء الصبح قام مبادرا %~% وحان انطلاق الشاة من حيث خيما (@)(@@) 22 فصبحه عند الشروق غدية %~% كلاب الفتى البكري عوف بن أرقما (@)(@@) 23 فأطلق عن مجنوبها ، فاتبعنه %~% كما هيج السامي المعسل خشرما (@)(@@) 24 لدن غدوة حتى أتى الليل دونه ، %~% وجشم صبرا ورقه ، فتجشما (@)(@@) 25 وأنحى على شؤمى يديه ، فذادها %~% بأظمأ من فرع الذؤابة أسحما (@)(@@) 26 وأنحى لها إذ هز في الصدر روقه %~% كما شك ذو العود الجراد المخزما (@)(@@) 27 فشك لها صفحاتها صدر روقه %~% كما شك ذو العود الجراد المنظما (@)(@@) 28 وأدبر كالشعرى وضوحا ونقبة ، %~% يواعن من حر الصريمة معظما (@)(@@) 29 فذلك ، بعد الجهد ، شبهت ناقتي %~% ا ذا الشاة يوما في الكناس تجرثما (@)(@@) 30 تؤم ا ياسا ، ا ن ربى أبى له %~% يد الدهر إلا عزة وتكرما (@)PageV01P213 (@)(@@) 31 نماه الإله فوق كل قبيلة ، %~% أبا فأبا ، يأبى الدنية أينما (@)(@@) 32 ولم ينتكس يوما فيظلم وجهه %~% ليركب عجزا أو يضارع مأثما (@)(@@) 33 ولو أن عز الناس في رأس صخرة %~% ململمة تعيي الأرح المخد ما (@)(@@) 34 لأعطاك رب الناس مفتاح بابها ، %~% ولو لم يكن باب لأعطاك سلما (@)(@@) 35 فما نيل مصر ا ذ تسامى عبابه ، %~% ولا بحر دانقيا ا ذا راح مفعما (@)(@@) 36 بأجود منه نائلا ، إن بعضهم %~% ا ذا سئل المعروف صد وجمجما (@)(@@) 37 هو الواهب الكوم الصفايا لجاره ، %~% يشبهن دوما ، أونخيلا مكمما (@)(@@) 38 وكل كميت ، كالقناة محاله ، %~% وكل طمر كالهراوة أدهما (@)(@@) 39 وكل مزاق كالقناة طمرة ، %~% أجرد جياش الأجاري مرجما (@)(@@) 40 وكل ذمول كالنيق ، وقينة %~% تجر إلى الحانوت بردا مسهما PageV01P214(@)(@@) 41 ولم يدع ملهوف من الناس مثله %~% ليدفع ضيما ، أو ليحمل مغرما (@)PageV01P215(@)(@@) البحر : وافر تام (@)(@@) 1 عرفت اليوم من تيا مقاما ، %~% بجو ، أو عرفت لها خياما (@)(@@) 2 فهاجت شوق 
ms63	 محزون طروب ، %~% فأسبل دمعه فيها سجاما (@)(@@) 3 ويوم الخرج من قرماء هاجت %~% صباك حمامة تدعو حماما (@)(@@) 4 وهل يشتاق مثلك من رسوم %~% عفت ، ا لا الأياصر والثماما (@)(@@) 5 وقد قالت قتيلة ، ا ذ رأتني ، %~% وقد لا تعدم الحسناء ذاما (@)(@@) 6 أراك كبرت واستحد ثت خلقا ، %~% وودعت الكواعب والمداما (@)(@@) 7 فإن تك لمتي ، يا قتل ، أضحت %~% كأن على مفارقها ثغاما (@)(@@) 8 وأقصر باطلي ، وصحوت ، حتى %~% كأن لم أجر في ددن غلام (@)(@@) 9 فإن دوائر الأيام يفني %~% تتابع وقعها الذكر الحساما (@)(@@) 10 وقد أقري الهموم إذا اعترتني %~% عذافرة ، مضبرة ، عقاما (@)PageV01P216 (@)(@@) 11 مفرجة يئط النسع فيها ، %~% أطيط السمهرية أن تقاما (@)(@@) 12 إذا ما رعتها بالزجر ، أجت %~% أجبج مصلم يزفي نعما (@)(@@) 13 تشق الليل والسبرات عنها ، %~% بأتلع ساطع يشري الزماما (@)(@@) 14 وتقتال النسوع بجوز قرم %~% مواشكة ، إذا ما لا يوم صاما (@)(@@) 15 إذا ما الآثمات ونين ، حطت %~% على العلات تجترع الإكاما (@)(@@) 16 وأدكن عاتق ، جحل ، سبحل ، %~% صبحت براحه شربا كراما (@)(@@) 17 من اللاتي حملن على الروايا ، %~% كريح المسك تستل الزكاما (@)(@@) 18 مشعشعة كأن على قراها ، %~% إذا ما صرحت ، ة قطعا سهاما (@)(@@) 19 تخيرها أخو عانات شهرا ، %~% ورجى أولها عاما ، فعاما (@)(@@) 20 يؤمل أن تكون له ثراء ، %~% فأغلق دونها وعلا سواما PageV01P217 (@)(@@) 21 فأعطينا الوفاء بها ، وكنا %~% نهين لمثلها فينا السواما (@)(@@) 22 كأن شعاع قرن الشمس فيها ، %~% إذا ما فت عن فيها الختاما (@)(@@) 23 وبيضاء المعاصم إلف لهو ، %~% خلوت بشكرها ليلا تماما (@)(@@) 24 حلفت لكم على ما قد نعيتم %~% برأس العين إن نفض السقاما (@)(@@) 25 وشيكا ثم ثاب إليه جمع ، %~% ليلتمسن بلادكم إلى ما (@)(@@) 26 ليلتمسن بلادكم بمجر ، %~% يثير بكل بلقعة قتاما (@)(@@) 27 عريض تعجز الصحراء عنه ، %~% ويشرب قبل آخره الجماما (@)(@@) 28 يقود الموت يهديه إياس ، %~% على جرداء تستوفي الحزاما (@)(@@) 29 تباري ظل مطرد ممر ، %~% إذا ما هز أرعش واستقاما (@)(@@) 30 أخو النجدات لا يكبو لضر %~% ولا مرح ، إذا ما الخير داما (@)PageV01P218 (@)(@@) 31 له يومان : يوم لعاب خود ، %~% ويوم يستمي القحم العظاما (@)(@@) 32 منير يحسر الغمرات 
ms64	 عنه ، %~% ويجلو ضوء غرته الظلاما (@)(@@) 33 إذا ما عاجز رثت قواه %~% رأى وطء الفراش له ، فناما (@)(@@) 34 كفاه الحرب ، إذ لقحت إياس ، %~% فأعلى عن نمارقه فقاما (@)(@@) 35 إذا ما سار نحو بلاد قوم ، %~% أزارهم المنية ، والحماما (@)(@@) 36 تروح جياده مثل السعالي ، %~% حوافرهن تهتضم السلاما (@)(@@) 37 كصدر السيف أخلصه صقال ، %~% إذا ما هز مشهورا حساما PageV01P219(@)(@@) البحر : مجزوء الوافر (@)(@@) 1 يطن الناس بالملي %~% ن أنهما قد التأما (@)(@@) 2 فإن تسمع بلأمهما ، %~% فإن الخطب قد فقما (@)(@@) 3 وإن الحرب أمسى فح %~% لها في الناس محتلما (@)(@@) 4 حديدا نابه ، مستد %~% لقا ، متخمطا ، قطما (@)(@@) 5 أتانا عن بني الأحرا %~% ر قول لم يكن أمما (@)(@@) 6 أرادوا نحت أثلتنا ، %~% وكنا نمنع الخطما (@)(@@) 7 وكان البغي مكروها %~% وقول الجهل منتحما (@)(@@) 8 فباتوا ليلهم سمرا %~% ليسدوا غب ما نجما (@)(@@) 9 فغبوا نحونا لجبا ، %~% يهد السهل والأكما (@)(@@) 10 سوابغ محكم الماذ %~% ي ، شدوا فوقها الحزما PageV01P220 (@)(@@) 11 فجاء القيل هامرز ، %~% عليهم يقسم القسما (@)(@@) 12 يذوق مشعشعا حتى %~% يفيء السبي والنعما (@)(@@) 13 فلاقى الموت مكتنعا ، %~% وذهلا دون ما زعما (@)(@@) 14 أباة الضيم ، لا يعطو %~% ن من عادوه ما حكما (@)(@@) 15 أبت أعناقهم عزا ، %~% فما يعطون من غشما (@)(@@) 16 على جرد مسومة ، %~% عوابس تعلك اللجما (@)(@@) 17 تخال ذوابل الخط %~% ي في حافاتها أجما (@)(@@) 18 فتنا القيل هامرزا ، %~% وروينا الكثيب دما (@)(@@) 19 ألا يا رب ما حسرى %~% ستنكحها الرماح حما (@)(@@) 20 صبحناهم مشعشعة %~% تخال مصبها رذما PageV01P221 (@)(@@) 21 صبحناهم بنشاب ، %~% كيف قعقع الأدما (@)(@@) 22 هناك فدى لهم أمتي ، %~% غداة تواردوا العلما (@)(@@) 23 بضربهم حبيك البي %~% ض ، حتى ثلموا العجما (@)(@@) 24 بمثلهم غداة الرو %~% ع يجلو العز والكرما (@)(@@) 25 كتائب من بني ذهل ، %~% عليها الزغف قد نظما (@)(@@) 26 فلاقوا معشرا أنفا ، %~% غضابا ، أحرزوا الغنما PageV01P222(@)(@@) البحر : متقارب تام (@)(@@) 1 أتهجر غانية أم تلم ، %~% أم الحبل واه ، بها منجذم (@)(@@) 2 أم الصبر أحجى ، فإن امرأ %~% سينفعه علمه إن علم (@)(@@) 3 كما راشد تجدن امرأ %~% تبين ثم انتهى ، أو قدم (@)(@@) 4 عصى المشفقين إلى غيه ، %~% وكل نصيح له 
ms65	 يتهم (@)(@@) 5 وما كان ذلك إلا الصبى ، %~% وإلا عقاب امرئ قد أثم (@)(@@) 6 ونظرة عين ، على غرة ، %~% محل الخليط بصحراء زم (@)(@@) 7 ومبسمها عن شتيت النبا %~% ت غير أكس ، ولا منقضم (@)(@@) 8 فبانت وفي الصدر صدع لها ، %~% كصدع الزجاجة ما يلتئم (@)(@@) 9 فكيف طلابكها ، إذ نأت %~% وأدنى مزارا لها ذو حسم (@)(@@) 10 وصهباء طاف يهوديها ، %~% وأبرزها ، وعليها ختم PageV01P223 (@)(@@) 11 وقابلها الريح في دنها ، %~% وصلى على دنها وارتسم (@)(@@) 12 تمززتها غير مستدبر %~% عن الشرب أو منكر ما علم (@)(@@) 13 وأبيض كالسيف يعطي الجزي %~% ل يجود ويغزو إذا ما عدم (@)(@@) 14 تضيفت يوما على ناره %~% من الجود في ماله أحتكم (@)(@@) 15 ويهماء تعزف جنانها ، %~% مناهلها آجنات سدم (@)(@@) 16 قطعت برسامة جسرة %~% عذافرة كالفنيق القطم (@)(@@) 17 غضوب من السوط ، زيافة ، %~% إذا ما ارتدى بالسراة الأكم (@)(@@) 18 كتوم الرغاء ، إذا هجرت ، %~% وكانت بقية ذود كتم (@)(@@) 19 تفرج للمرء من همه ، %~% ويشفى عليها الفؤاد السقم (@)(@@) 20 إلى المرء قيس أطيل السرى ، %~% وآخذ من كل حي عصم PageV01P224 (@)(@@) 21 وكم دون بيتك من معشر %~% صباة الحلوم ، عداة غشم (@)(@@) 22 إذا أنا حييت لم يرجعوا %~% تحيتهم ، وهم غير صم (@)(@@) 23 وإدلاج ليل على خيفة ، %~% وهاجرة حرها يحتدم (@)(@@) 24 وإن غزاتك من حضر موت %~% أتتني ودوني الصفا والرجم (@)(@@) 25 مقادك بالخيل أرض العدو %~% وجذعانها كلفيظ العجم (@)(@@) 26 وجيشهم ينظرون الصبا %~% ح فاليوم من غزوة لم تخم (@)(@@) 27 وقوفا بما كان من لأمة ، %~% وهن صيام يلكن اللجم (@)(@@) 28 فأظعنت وترك من دارهم ، %~% ووترك في دارهم لم يقم (@)(@@) 29 تؤم ديار بني عامر ، %~% وأنت بآل عقيل فغم (@)(@@) 30 أذاقتهم الحرب أنفاسها ، %~% وقد تكره الحرب بعد السلم PageV01P225 (@)(@@) 31 تعود عليهم وتمضيهم ، %~% كما طاف بالرجمة المرتجم (@)(@@) 32 ولم يود من كنت تسعى له ، %~% كما قيل في الحي أودى درم (@)(@@) 33 وكانك كحبلى غداة الصبا %~% ح كانت ولادتها عن متم (@)(@@) 34 يقوعلى الوغم في قومه ، %~% فيعفو إذا شاء أو ينتقم (@)(@@) 35 أخو الحرب لا ضرع واهن ، %~% ولم ينتعل بقبال خذم (@)(@@) 36 ومامزبد من خليج 
ms66	 الفرا %~% ت ، جون غواربه ، تلتطم (@)(@@) 37 يكب الخلية ذات القلا %~% ع ، قد كاد جؤجؤها ينحطم (@)(@@) 38 تكأكأ ملاحها وسطها ، %~% من الخوف كوثلها يلتزم (@)(@@) 39 بأجود منه بما عنده ، %~% إذا ما سماؤهم لم تغم (@)(@@) 40 هو الواهب المائة المصطفا %~% ة كالنخل طاف بها المجترم PageV01P226(@)(@@) 41 وكل كميت كجذع الطري %~% ق يردي على سلطات لثم (@)(@@) 42 سنابكه كمداري الظبا %~% ء ، أطرافهن على الأرض شم (@)(@@) 43 يصيد النحوص ، ومسحلها ، %~% وجحشهما قبل أن يستحم (@)(@@) 44 ويوم إذا ما رأيت الصوا %~% ر أدبر كاللؤلؤ المنخرم (@)(@@) 45 تدلى حثيثا كأن الصوا %~% ر أتبعه أزرقي لحم (@)(@@) 46 فإن معاوية الأكرمين %~% عظام القباب ، طوال الأمم (@)(@@) 47 متى تدعهم للقاء الحرو %~% ب تأتك خيل لهم غير جم (@)(@@) 48 إذا ما هم جلسوا بالعيش %~% ي فأحلام عاد وأيدي هضم (@)(@@) 49 وعوراء جاءت ، فجاوبتها %~% بشنعاء ناقية للرقم (@)(@@) 50 بذات نفي لها سورة %~% إذا أرسلت فهي ما تنتقم PageV01P227 (@)(@@) 51 تقول ابنتي حين جد الرحيل %~% أرانا سواء ومن قد يتم (@)(@@) 52 أبانا فلا رمت من عندنا ، %~% فإنا بخير إذا لم ترم (@)(@@) 53 ويا أبتا لا تزل عندنا %~% فإنا نخاف بأن تخترم (@)(@@) 54 أرانا إذا أضمرتك البلا %~% د نجفى ، وتقطع منا الرحم (@)(@@) 55 أفي الطوف خفت علي الردى ، %~% وكم من رد أهله لم يرم (@)(@@) 56 وقد طفت للمال آفاقه : %~% عمان ، فحمص ، فأوريشلم (@)(@@) 57 أتيت التجاشي في أرضه ، %~% وأرض النبيط وأرض العجم (@)(@@) 58 فنجران فالسرو من حمير ، %~% فأي مرام له لم أرم (@)(@@) 59 ومن بعد ذاك إلى حضر موت ، %~% فأوفيت همي وحينا أهم (@)(@@) 60 ألم تري الحضر ، إذ أهله %~% بنعمى ، وهل خالد من نعم PageV01P228 (@)(@@) 61 أقام به شاهبور الجنو %~% د حولين يضرب فيه القدم (@)(@@) 62 فما زاده ربه قوة ، %~% ومثل مجاوره لم يقم (@)(@@) 63 فلما رأى ربه فعله %~% أتاه طروقا فلم ينتقم (@)(@@) 64 وكان دعا رهطه دعوة ، %~% هلم إلى أمركم قد صرم (@)(@@) 65 فموتوا كراما بأسيافكم %~% وللموت يجشمه من جشم (@)(@@) 66 وللموت خير لمن ناله ، %~% إذا المرء أمته لم تدم (@)(@@) 67 ففي ذاك للمؤتسي أسوة 
ms67	 ، %~% ومأرب قفى عليها العرم (@)(@@) 68 رخام بنته لهم حمير ، %~% إذا جاءه ماؤهم لم يرم (@)(@@) 69 فأروى الزروع وأعنابها ، %~% على سعة ماؤهم إذ قسم (@)(@@) 70 فعاشوا بذلك في غبطة ، %~% فجار بهم جارف منهزم PageV01P229 (@)(@@) 71 فطار القيول وقيلاتها ، %~% بيهماءفيها سراب يطم (@)(@@) 72 فطاروا سراعا وما يقدرو %~% ن منه لشرب صبي فطم PageV01P230(@)(@@) البحر : خفيف تام (@)(@@) 1 يا لقيس ! لما لقينا العاما ، %~% ألعبد أعرضنا أم على ما (@)(@@) 2 ليس عن بغضة حذاف ، ولكن %~% كان جهلا بذلكم ، وعراما (@)(@@) 3 لم نطأكم يوما بظلم ، ولم نه %~% تك حجابا ولم نحل حراما (@)(@@) 4 يابني المنذر بن عبيدان ، والبط %~% نة يوما قد تأفن الأحلاما (@)(@@) 5 لم أمرتم عبدا ليهجو قوما %~% ظالميهم من غير جرم ، كراما (@)(@@) 6 والتي تلبث الرؤوس من النع %~% مى ، ويأتي إسماعها الأقواما (@)(@@) 7 يوم حجر بما أزل إليكم ، %~% إذ تذكى في حافتيه الضراما (@)(@@) 8 جار فيه ، نافى العقاب ، فأضحى %~% آئد النخل يفضح الجراما (@)(@@) 9 فتراها كالخشن تسفحها الني %~% ران سودا مصرعا وقياما (@)(@@) 10 ثم بالعين عرة تكسف الشم %~% س ويوما ما ينجلي إظلاما PageV01P231 (@)(@@) 11 إذا أتتكم شيبان في شارق الصب %~% ح ، بكبش ترى له قداما (@)(@@) 12 فغدونا عليهم بكر الور %~% د ، كما تورد النضيح الهياما (@)(@@) 13 برجال كالأسد ، حربها الزج %~% ر ، وخيل ما تنكر الإقداما (@)(@@) 14 لا نقيها حد السيوف ولا نأ %~% لم جوعا ولا نبالي السهاما (@)(@@) 15 ساعة أكبر النهار كما شل %~% مخيل لنوئه أغناما (@)(@@) 16 من شباب تراهم غير ميل ؛ %~% وكهولا مرجحا أحلاما (@)(@@) 17 ثم ولوا عند الحفيظة والصب %~% ر ، كما يطحر الجنوب الجهاما (@)(@@) 18 ذاك في جبلكم لنا ، وعليكم %~% نعمة لو شكرتم الإنعاما (@)(@@) 19 وإذا ما الدخان شبهه الآ %~% نف يوما ، بشتوة ، أهضاما (@)(@@) 20 فلقد تصلق القداح على الني %~% ب ، إذا كان يسرهن غراما (@)PageV01P232 (@)(@@) 21 بمساميح في الشتاء يخالو %~% ن على كل فالج إطعاما (@)(@@) 22 قباب مثل الهضاب وخيل ، %~% وصعاد حمر ، يقين السماما (@)(@@) 23 في محل من الثغور غزاة ، %~% فإذا خالط الغوار السواما (@)(@@) 24 كان منا المطاردون عن الأخ %~% رى ، إذا أبدت 
ms68	 العذارى الخدما (@)PageV01P233(@)(@@) البحر : متقارب تام (@)(@@) 1 لعمرك ما طول هذا الزمن %~% على المرء ، إلا عناء معن (@)(@@) 2 يظل رجيما لريب المنون ، %~% وللسقم في أهله والحزن (@)(@@) 3 وهالك أهل يجنونه ، %~% كآخر في قفرة لم يجن (@)(@@) 4 وما إن أرى الدهر في صرفه ، %~% يغادر من شارخ أو يفن (@)(@@) 5 فهل يمنعني ارتيادي البلا %~% د من حذر الموت أن يأتين (@)(@@) 6 أليس أخو الموت مستوثقا %~% علي ، وإن قلت قد أنسأن (@)(@@) 7 علي رقيب له حافظ ، %~% فقل في امرئ غلق مرتهن (@)(@@) 8 أزال أذينة عن ملكه ، %~% وأخرج من حصنه ذا يزن (@)(@@) 9 وخان النعيم أبا مالك ، %~% وأي امرىء لم يخنه الزمن (@)(@@) 10 أزال الملوك ، فأفناهم ، %~% وأخرج من بيته ذا حزن PageV01P234 (@)(@@) 11 وعهد الشباب ولذاته ، %~% فإن يك ذلك قد نتدن (@)(@@) 12 وطاوعت ذا الحلم فاقتادني ، %~% وقد كنت أمنع منه الرسن (@)(@@) 13 وعاصيت قلبي بعد الصبى ، %~% وأمسى ، وما إن له من شجن (@)(@@) 14 فقد أشرب الراح قد تعلمي %~% ن ، يوم المقام ويوم الظعن (@)(@@) 15 وأشرب بالريف حتى يقا %~% ل : قد طال بالريف ما قد دجن (@)(@@) 16 وأقررت عيني من الغانيا %~% ت ، إما نكاحا وإما أزن (@)(@@) 17 من كل بيضاء ممكورة %~% لهابشر ناصع كاللبن (@)(@@) 18 عريضة بوص إذا أدبرت ، %~% هضيم الحشا شختة المحتضن (@)(@@) 19 إذا هن نازلن أقرانهن ، %~% وكان المصاع بما في الجون (@)(@@) 20 تعاطي الضجيع ، إذا أقبلت ، %~% بعيد الرقاد ، وعند الوسن PageV01P235(@)(@@) 21 صليفة طيبا طعمها ، %~% لها زبد بين كوب ودن (@)(@@) 22 يصب لها السقيان المزا %~% ج ، منتصف الليل من ماء شن (@)(@@) 23 وبيداء قفر كبرد السدير ، %~% مشاربها داثرات أجن (@)(@@) 24 قطعت ، إذا خب ريعانها ، %~% بدوسرة جسرة كالفدن (@)(@@) 25 بحقتها حبست في اللجي %~% ن ، حتى السديس لها قد أسن (@)(@@) 26 وطال السنام على جبلة ، %~% كخلقاء من هضبات الضجن (@)(@@) 27 فأفنيتها ، وتعللتها %~% على صحصح كرداء الردن (@)(@@) 28 تراقب من أيمن الجانبي %~% ن بالكف من محصد قد مرن (@)(@@) 29 تيممت قيسا ، وكم دونه %~% من الأرض من مهمة ذي شزن (@)(@@) 30 ومن شانىء كاسف وجهه ، %~% إذا ما انتسبت له أنكرن 
ms69	 PageV01P236 (@)(@@) 31 ومن آجن أولجته الجنو %~% ب دمنة أعطانه ، فاندفن (@)(@@) 32 وجار أجاورة إذ شتو %~% ت ، غير أمين ، ولا مؤتمن (@)(@@) 33 ولكن ربي كفى غربتي ، %~% بحمد الإله ، فقد بلغن (@)(@@) 34 أخا ثقة عاليا كعبه ، %~% جزيل العطاء ، كريم المنن (@)(@@) 35 كريما شمائله من بني %~% معاوية الأكرمين السنن (@)(@@) 36 فإن يتبعوا أمره يرشدوا ، %~% وإن يسألوا ماله لا يضن (@)(@@) 37 وإن يستضافوا إلى حكمه ، %~% يضاف إلى هادن قد رزن (@)(@@) 38 وما إن على قلبه غمرة ، %~% وما إن بعظم له من وهن (@)(@@) 39 وما إن على جاره تلفة %~% يساقطها كسقاط الغبن (@)(@@) 40 هو الواهب المائة المصطفا %~% ة ، كالنخل زينها بالرجن PageV01P237(@)(@@) 41 وكل كميت كجذع الخصا %~% ب ، يرنوا القناء ، إذا ما صفن (@)(@@) 42 تراه إذا ما عدا صحبه %~% بجانبه مثل شاة الأرن (@)(@@) 43 أضافوا إليه ، فألوى بهم %~% تقول جنونا ، ولما يجن (@)(@@) 44 ولم يلحقوه على شوطه ، %~% وراجع من ذلة فاطمأن (@)(@@) 45 سما بتليل كجذع الخصا %~% ب ، حر القذال ، طويل الغسن (@)(@@) 46 فلأيا بلأي ، حملنا الغلا %~% م ، كرها ، فأرسله ، فامتهن (@)(@@) 47 كأن الغلام نحا للصوا %~% ر ، أزرق ذا مخلب قد دجن (@)(@@) 48 يسافع غورية ، %~% ليدركها في حمام ثكن (@)(@@) 49 فثابر بالرمح حتى نحا %~% ه في كفل كسراة المجن (@)(@@) 50 ترى اللحم من ذابل قد ذوى ، %~% ورطب يرفع فوق العنن PageV01P238 (@)(@@) 51 يطوف العفاة بأبوابه ، %~% كطوف النصارى ببيت الوثن (@)(@@) 52 هو الواهب المسمعات الشرو %~% ب ، بين الحرير وبين الكتن (@)(@@) 53 ويقبل ذو البث ، والراغبو %~% ن في ليلة ، هي إحدى اللزن (@)(@@) 54 لبيتك ، إذ بعضهم بيته %~% من الشر ما فيه من مستكن (@)(@@) 55 ولم تسع للحرب سعي امرىء ، %~% إذا بطنة راجعنه سكن (@)(@@) 56 ترى همه نظرا خصره ، %~% وهمك في الغزو لا في السمن (@)(@@) 57 وفيكل عام له غزوة ، %~% تحت الدوابر حت السفن (@)(@@) 58 حجون تظل الفتى جاذبا %~% على واسط الكور عند الذقن (@)(@@) 59 ترى الشيخ منها لحب الإيا %~% ب يرجف كالشرف المستحن (@)(@@) 60 فلما رأى القوم من ساعة %~% من الرأي ما أبصروه اكتمن PageV01P239 (@)(@@) 61 ن من قطع يأس ولا من 
ms70	 يقن %~%(@)(@@) 62 تباري الزجاج مغاويرها ، %~% شماطيط في رهج كالدخن (@)(@@) 63 تدر على أسوق الممتري %~% ن ركضا إذا ما السراب ارجحن (@)(@@) 64 فبا عجب الرهن للقائلا %~% ت من آخر الليل ماذا احتجن (@)(@@) 65 وما قد أخذن ما قد ترك %~% ن في الحي من نعمة ودمن (@)(@@) 66 وأقبلن يعرضن نحو امرئ %~% إذا كسب المال لم يختزن (@)(@@) 67 وقد يشتريه بأغلى الثمن %~%(@)(@@) 68 ولا يدع الحمد أو يشتري %~% ه بوشك الفتور ولا بالتون (@)(@@) 69 عليه سلاح امرىء ماجد %~% تمهل في الحرب حتى اثخن (@)(@@) 70 سلاجم كالنحل أنحى لها %~% قضيب سراء قليل الأبن PageV01P240 (@)(@@) 71 وذا هبة غامضا كامه ، %~% وأجرد مطردا كالشطن (@)(@@) 72 وبيضاء كالنهي موضونة ، %~% لها قونس فوق جيب البدن (@)(@@) 73 وقد يطعن الفرج يوم اللقا %~% ء بالرمح يحبس أولى السنن (@)(@@) 74 فهذا الثناء ، وإني امرؤ %~% إليك بعد قطعت القرن (@)(@@) 75 وكنت امرأ ، زمنا بالعراق ، %~% عفيف المناخ ، طويل التغن (@)(@@) 76 وحولي بكر وأشياعها ، %~% ولست خلاة لمن أوعدن (@)(@@) 77 ونبئت قيسا ، ولم أبله %~% كما زعموا خير أهل اليمن (@)(@@) 78 رفيع الوساد ، طويل النجا %~% د ضخم الدسيعة رحب العطن (@)(@@) 79 يشق المور ويجتابها ، %~% كشق القراري ثوب الردن (@)(@@) 80 فجئتك مرتاد ما خبروا ، %~% ولولا الذي خبروا لم ترن PageV01P241 (@)(@@) 81 فلا تحرمني نداك الجزيل ، %~% فإني امرؤ قبلكم لم أهن PageV01P242(@)(@@) البحر : وافر تام (@)(@@) 1 ألا من مبلغ عني حريثا ، %~% مغلغلة أحان أم ازدرانا (@)(@@) 2 فإنا قد أقمنا ، إذ فشلتم ، %~% وإنا بالرداع لمن أتانا (@)(@@) 3 من النعم التي كحراج إيل ، %~% تحش الأرض شيما أو هجانا (@)(@@) 4 وكل طوالة شنج نساها ، %~% تبد بدا المعارق والعنانا (@)(@@) 5 وأجرد من فحول الخيل طرف %~% كأن على شواكله دهانا (@)(@@) 6 ويحمي الحي أرعن ذو دروع ، %~% من السلاف تحسبه إوانا (@)(@@) 7 فلا وأبيك ، لا نعطيك منها ، %~% طوال حياتنا ، إلا سنانا (@)(@@) 8 وإلا كل أسمر ، وهو صدق ، %~% كأن الليط أنبت خيزرانا (@)(@@) 9 وإلا كل ذي شطب صقيل ، %~% يقد ، إذا علا ، العنق الجرانا (@)(@@) 10 أكب عليه مصقلتيه يوما ، %~% أبو عجلان يشحذاه ، فتانا PageV01P243(@)(@@) 11 فظل عليه يرشح عارضاه %~% يحد 
ms71	 الشفرتين ، فما ألانا (@)(@@) 12 ولا نعطي المنى قوما علينا ، %~% كما ليس الأمور على منانا (@)(@@) 13 ولاكشف ، فنسأم حرب قوم ، %~% إذا أزمت رحى لهم رحانا (@)(@@) 14 يسوق لنا قلابة عبد عمر و %~% ليرمينا بهم ، فيمن رمانا (@)(@@) 15 ولو نظروا الصباح ، إذا لذاقوا %~% بأطراف الأسنة ، ما قرانا (@)(@@) 16 وإنا بالصليب وبطن فلج ، %~% جميعا ، واضعين بها لظانا (@)(@@) 17 ندخن بالنهار لتبصرينا ، %~% ولا نخفى على أحد بغانا (@)(@@) 18 فإن يحتف أبو عمران عنا %~% فإنا ، والثواقب ، لو رآنا (@)(@@) 19 لقال المعولات عليه منهم : %~% لقد حانت منيته وحانا PageV01P244(@)(@@) البحر : رمل تام (@)(@@) 1 خالط القلب هموم وحزن ، %~% وادكار ، بعدما كان اطمأن (@)(@@) 2 فهو مشغوف بهند هائم ، %~% يرعوي حينا ، وأحيانا يحن (@)(@@) 3 بلعوب طيب أردانها ، %~% رخصة الأطراف ، كالرئم الأغن (@)(@@) 4 وهي إن تقعد نقا من عالج ، %~% ثم أنشأت أفدي ، وأهن (@)(@@) 5 ينتهي منها الوشاحان إلى %~% حبلة ، وهي بمتن كالرسن (@)(@@) 6 خلقت هند لقلبي فتنة ، %~% هكذا تعرض للناس الفتن (@)(@@) 7 لاأرها في خلاء مرة ، %~% وهي في ذاك حياء لم تزن (@)(@@) 8 ثم أرسلت إليها أنني %~% معذر عذري فرديه بأن (@)(@@) 10 وأرجيها وأخشى ذعرها ، %~% مثل ما يفعل بالقود السنن (@)(@@) 11 رب يوم قد تجودين لنا %~% بعطايا ، لم تكدرها المنن PageV01P245 (@)(@@) 12 أنت سلمى هم نفسي ، فاذكري %~% سلم ، لا يوجد للنفس ثمن (@)(@@) 13 وعلال وظلال بارد ، %~% وفليج المسك والشاهسفرن (@)(@@) 14 وطلاء خسرواني ، إذا %~% ذاقه الشيخ تغنى وارجحن (@)(@@) 15 وطنابير حسان صوتها ، %~% عند صنج ، كلما مس أرن (@)(@@) 16 وإذا المسمع أفنى صوته ، %~% عزف الصنج فنادى صوت ون (@)(@@) 17 وإذا ما غض من صوتيهما ، %~% وأطاع اللحن غنانا مغن (@)(@@) 18 وإذا الدنث شربنا صفوه ، %~% أمروا عمرا ، فناجوه بدن (@)(@@) 19 بمتاليف أهانوا مالهم ، %~% لغناء ، وللعب ، وأذن (@)(@@) 20 فترى إبريقهم مسترعفا ، %~% بشمول صفقت من ماء شن (@)(@@) 21 غدوة حتى يميلوا أصلا ، %~% مثل ما ميل بأصحاب الوسن PageV01P246 (@)(@@) 22 ثم راحوا مغرب الشمس إلى %~% قطف المشي ، قليلات الحزن (@)(@@) 23 عد هذا في قريض غيره ، %~% واذكرن في الشعر دهقان اليمن (@)(@@) 24 بأبي الأشعث قيس ، إنه %~% يشتري الحمد بمنفوس الثمن (@)(@@) 25 
ms72	 جئته يوما ، فأدنى مجلسي ، %~% وحباني بلجوج في السنن (@)(@@) 26 وثمانين عشار ، كلها %~% آركات في بريم وحضن (@)(@@) 27 وغلام قائم ذي عدوة %~% وذلول جسرة مثل الفدن PageV01P247(@)(@@) البحر : طويل(@)(@@) 1 ذريني لك الويلات آتي الغوانيا %~% متى كنت ذراعا أسوق السوانيا (@)(@@) 2 ترجى ثراء من سياس ، ومثلها ، %~% ومن قلبها ما كنت للمال راجيا (@)(@@) 3 سأوصي بصيرا إن دنوت من البلى ، %~% وكل امرىء يوما فانيا (@)(@@) 4 بأن لا تأن الود من متباعد ، %~% ولا تنأ إن أمسى بقربك راضيا (@)(@@) 5 فذا الشنء فاشنأه وذا الوده فاخزه %~% على وده أو زد عليه العلانيا (@)(@@) 6 وآس سراة الحي حيث لقيتهم ، %~% ولا تك عن حمل الرباعة وانيا (@)(@@) 7 وإن بشر يوما أحال بوجهه %~% عليك فحل عنه وإن كان دانيا (@)(@@) 8 وإن تقى الرحمن لا شيء مثله ، %~% فصبرا إذا تلقى السحاق الغراثيا (@)(@@) 9 وربك لا تشرك به ، إن شركه %~% يحط من الخيرات تلك البواقيا (@)(@@) 10 بل الله فاعبد ، لا شريك لوجهه ، %~% يكن لك فيما تكدح اليوم راعيا (@)PageV01P248 (@)(@@) 11 وإياك والميتات لاتقربنها ، %~% كفى بكلام الله عن ذاك ناهيا (@)(@@) 12 ولا تعدن الناس ما لست منجزا ، %~% ولا تشتمن جارا لطيفا مصافيا (@)(@@) 13 ولا تزهدن في وصل أهل قرابة ، %~% ولا تك سبعا في العشيرة عاديا (@)(@@) 14 وإن امرؤ أسدى إليك أمانة ، %~% فأوف بها إن مت سميت وافيا (@)(@@) 15 وجارة جنب البيت لاتنع سرها ، %~% فإنك لا تخفى على الله خافيا (@)(@@) 16 ولا تحسدن مولاك إن كان ذا غنى ، %~% ولا تجفه إن كنت في المال غانيا (@)(@@) 17 ولا تخذلن القوم إن ناب مغرم ، %~% فإنك لا تعدم إلى المجد داعيا (@)(@@) 18 وكن من وراء الجار حصنا ممنعا ، %~% وأوفد شهابا يسفع الوجه حاميا (@)PageV01P249 
