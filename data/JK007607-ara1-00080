ms61	 عبيد عبيدك الدنف ال % % مشتاق حقق له بك الأملا % % 10(@)(@@) % ما لي عز إلا بجود يد % منك كحال السحاب إن هطلا % PageV01P325 11(@)(@@) % يا من غدا باهتمامه بطلا % % بغير ما حق منه أو بطلا % % 12(@)(@@) % مذ عدمت عيني له مثلا % أرسلت مدحي بجوده مثلا % % 13(@)(@@) % لأنظمن المديح من درر % لم تدر علياك بعده عطلا % 14(@)(@@) % اليوم يقضي الكريم موعده % والحر لو قال ما عسى فعلا % % PageV01P326 البحر : كامل تام 1(@)(@@) % بان الخيال وإن أبان نزيلا % % وسرى شذاك وإن منعت رسولا % 2(@)(@@) % فهممت أن أجفو خيالك غيرة % فمنحته قبلا له وقبولا % % 3(@)(@@) % وحفظت نسبته إليك محبة % من ظنه أني أراك بديلا % % 4(@)(@@) % وزعمت أن العهد ليس بضائع % وأرى الصدود لضد ذاك دليلا % % 5(@)(@@) % ووعدتني باللحظ منك زيارة % فوجدت ميعاد العليل عليلا % % 6(@)(@@) % لله عيسك يوم حنت للنوى % % لم يبق مطلقها لنا معقولا % % 7(@)(@@) % بنتم بكل حمولة قد أودعت % قلبا كما شاء الغرام حمولا % % 8(@)(@@) % كم لفظة خفت على الحادي وقد % ألقت جوى بين الضلوع ثقيلا % % 9(@)(@@) % يا هند لم تترك جفونك بالحمى % % إلا جريحا منك أو مقتولا % % 10(@)(@@) % هل أودعت لأبي المحاسن يوسف % فيهن أحكام قسمن فصولا % % PageV01P327 البحر : مديد تام 1(@)(@@) % مذ رأته الشمس في الحمل % لم تكد تبدو من الخجل % 2(@)(@@) % غصن بان مثمر قمرا % يخجل الأغصان بالميل % 3(@)(@@) % ورد خديه يضرجه % خجل من نرجس المقل % 4(@)(@@) % وسوى ذا أن مبسمه % جامع للخمر والعسل % 5(@)(@@) % من مجيري من لواحظه % إنني منها على وجل % 6(@)(@@) % كلما سلت صوارمها % % قال قلبي قد دنا أجلي % % PageV01P328 البحر : مجزوء الكامل 1(@)(@@) % من سحر طرفك يا علي % % قلب المتييم قد بلي % % 2(@)(@@) % يا زهرة يا نزهة % للمجتني والمجتلي % % 3(@)(@@) % يا من يروق جماله % لنواظر المتأمل % 4(@)(@@) % إن لم تجد لي باللقا % % كن بالوعود معللي % % 5(@)(@@) % يا ساكنا طول المدى % % في القلب لم يتحول % 6(@)(@@) % أهلا بأكرم نازل % قد حل أشرف منزل % PageV01P329 البحر : كامل تام 1(@)(@@) % قابلت عز هواكم بتذلل % مع أنني في ذاك لست بأول % 2(@)(@@) % يا جائرين 
ms62	 وعادلين إلى النوى % % ما دون معدل حسنكم من معدل % 3(@)(@@) % وحياتكم أنتم على إعراضكم % % عندي أعز من الشباب المقبل % 4(@)(@@) % إن تذكرون فإنني لم أنسكم % أو تسمحون فإنني لم أبخل % 5(@)(@@) % يا علو أين زماننا إذا جاركم % جاري ومنزلكم برامة منزلي % % 6(@)(@@) % ما كان أسرع ما تقشع غيمكم % % ومنعتم الوسمي عني والولي % % 7(@)(@@) % كم كنت أخشى البين قبل وقوعه % فأتى الذي حاذرت في المستقبل % 8(@)(@@) % وحذرت سهم فراقكم حتى إذا % % أرسلتموه أصابني في المقتل % % 9(@)(@@) % اليوم لست أجاب بعد سؤالكم % كم كنت قبل أجاب إذ لم أسأل % 10(@)(@@) % فالدار لم تبعد وفودي لم يشب % والمال لم ينفد وحبك ما سلي % % PageV01P330 البحر : مجتث 1(@)(@@) % بمن أباحك قتلي % % علام حرمت وصلي % % 2(@)(@@) % فكيف أقوى لهجر % وكيف أصغي لعذل % 3(@)(@@) % أنا لك المتمني % % وغيري المتملي % % 4(@)(@@) % يا أكرم الناس عندي % % قد لذ لي فيك ذلي % % 5(@)(@@) % ملكت يا نور عيني % % قلبي ولبي وكلي % % 6(@)(@@) % يا نافرا متجن % كن سافرا متجلي % % 7(@)(@@) % يا أحسن الناس طرا % في حسن خلق وشكل % 8(@)(@@) % في كل نوع وجنس % من الجمال وفضل % 9(@)(@@) % أرى معانيك تبدو % % حسنا فتحجب عقلي % % 10(@)(@@) % وليس مثلك تهوى فواصل % في الحب هجران مثلي % % PageV01P331 11(@)(@@) % ما دمت تهوى فواصل % فذا ربيع مولي % % 12(@)(@@) % حسبي وحسبك ذقن % تأتي بفرقة شملي % % 13(@)(@@) % وبعد ذاك إذا ما % % رأيت وجهي فول % PageV01P332 البحر : خفيف تام 1(@)(@@) % وعيون أمرضن جسمي وأض % رمن بقلبي لواعج البلبال % 2(@)(@@) % وخدود مثل الرياض زواه % ما لأيام حسنها من زوال % 3(@)(@@) % لم أكن من جناتها علم الل % ه وإني بحرها اليوم صالي % % PageV01P333 البحر : وافر تام 1(@)(@@) % خيالي أخاف الهجر منه % ولست أراه يرغب في وصالي % % 2(@)(@@) % وكنت عهدتني قدما شجاعا % فما لي اليوم أفزع من خيالي % % PageV01P334 البحر : مخلع البسيط 1(@)(@@) % يا ذا الذي نام عن جفوني % % ونبه الوجد والجوى لي % % 2(@)(@@) % جفني خراجيه دموع % شوقا إلى وجهك الهلالي % % PageV01P335 البحر : مجزوء الرمل 1(@)(@@) % قلت للائم في الدم % ع وقد نم بحالي % % 2(@)(@@) % منذ أحببت عليا % صار 
ms63	 دمعي متوالي % % PageV01P336 البحر : طويل 1(@)(@@) % أراك تشم الخل في زمن الوبا % % فخل حديثا للأطباء يا خلي % % 2(@)(@@) % فإن يك بالطاعون ربك قد قضى % % تموت إذا رغما وأنفك في الخل % PageV01P337 البحر : وافر تام 1(@)(@@) % أدام الله أيام الوصال % % وخلد عمر هاتيك الليالي % % 2(@)(@@) % وأسبغ ظل أغصان التداني % % وزاد قدودها حسن اعتدال % 3(@)(@@) % ولا زالت ثمار الأنس فيها % % تزيد لطافة في كل حال % 4(@)(@@) % ولا برحت لنا فيها عيون % تغازل مقلتي خشف الغزال % 5(@)(@@) % لقد مرت لنا فيها ليال % كأن نظامها عقد الآلي % % 6(@)(@@) % أقمنا في جناب أمير حسن % عقدن عليه ألوية الجمال % PageV01P338 البحر : كامل تام 1(@)(@@) % طالت إليك رسائلي ووسائلي % % يا ذا الملاحة والعذار السائل % 2(@)(@@) % أنجز بوصل منك لي فإلى متى % % يا نور عيني بالوعود مماطلي % % PageV01P339 البحر : كامل تام 1(@)(@@) % لو رمت إبقاء الوداد بحاله % لم تغر طرفك بارتياد نباله % 2(@)(@@) % أما وقد سلمت نفسك للهوى % % فأتت بما تلقاه من أهواله % 3(@)(@@) % حدق الجآذر كن أول شافع % للعقل حتى فك أسر عقاله % 4(@)(@@) % يا من يلوم الصب في برحائه % إبغ السلامة لا بليت بحاله % 5(@)(@@) % من شغله بالحب عن محبوبه % كيف الفراغ له إلى عذاله % 6(@)(@@) % هو ذلك القمر الذي القمر الذي % % متناقص بدر الدجى لكماله % 7(@)(@@) % لو كمت أملك خده أفنيته % باللثم أو أذبلت ورد جماله % 8(@)(@@) % الحرب بين عهوده ووفائه % كالسلم بين وعوده ومطاله % 9(@)(@@) % طالت مسافة هجره فكأنها % % من ليل عاشقه ومن آماله % 10(@)(@@) % داني المزار يروع قلبي صده % % يا قرب شقته وبعد مناله % PageV01P340 11(@)(@@) % كيف الخلاص لمن تقسم قلبه % ما بين بدر المنحنى وغزاله % % 12(@)(@@) % بالله يا ريح الشمال رسالة % فسواك لم أركن إلى إرساله % 13(@)(@@) % قولي لتياه الشمائل لم يزل % بيدي لنا مللا بشرع مطاله % 14(@)(@@) % عان التعطف حين تبصر عانيا % وإذا ظفرت بواله بك واله % 15(@)(@@) % يجني علي كما جنى الأثمار من % ام ابن يعقوب على إقلاله % % 16(@)(@@) % لولا التقى وهو الذي وهب التقى % % لعبدته وعبدت حسن خلاله % 17(@)(@@) % وجه تغار الشمس منه إذا 
ms64	 بدا % % وتود لو طبعت على أمثاله % 18(@)(@@) % متهلل القسمات يؤذن بالرضا % % وجه الكريم يبين عن أفعاله % 19(@)(@@) % سمت العلى عشقا له ودنا لها % % متواضعا فتمنعت بوصاله % 20(@)(@@) % إن رمت مجدا فاستدل بفعله % % أو رمت رشدا فاستفد بمقاله % PageV01P341 21(@)(@@) % أو حاربتك صروف دهرك فاستتر % بحماه منها واعتصم بحباله % 22(@)(@@) % أو شئت تلقى البحر عند هياجه % فانظر إليه تجده يوم جداله % 23(@)(@@) % يدري مقال الخصم قبل سماعه % لكلامه فيجيب قبل سؤاله % 24(@)(@@) % لمحمد في المجد معجز سؤدد % عجزت به الأيام عن أمثاله % 25(@)(@@) % بمبخل في عرضه وذمامه % سمح اليدين بجاهه وبماله % 26(@)(@@) % مغض عن الفحشاء يشفع حلمه % % حذق الذكي بغفلة المتباله % 27(@)(@@) % ويمارس الدنيا بهمة من يرى % % أيامها - شرفا - لوقع نصاله % 28(@)(@@) % أنى التفت رأيت من إحسانه % أثرا مشاهدة ومن إجماله % 29(@)(@@) % من مقتد بكماله أو مهتد % بجلاله أو مجتد لسؤاله % 30(@)(@@) % الليث بين أمامه وورائه % والبحر بين يمينه وشماله % PageV01P342 31(@)(@@) % أعطى بنيه حسن سيرته التي % % عن والديه فاعتجب لفعاله % 32(@)(@@) % شهدت مناقب آله في مجده % معنى مناقب مجده في آله % 33(@)(@@) % من معشر يهدى الدليل بنورهم % ويضل رشدا عن طريق ضلاله % 34(@)(@@) % وإذ استعنت بهم على كيد العدا % % نهضوا بأبطال على إبطاله % 35(@)(@@) % جلسوا على الفلك المحيط ودونهم % % هذا الزمان بشمسه وهلاله % % 36(@)(@@) % من كل من يلقاك قبل لقائه % ما شاء بل ما شئت من أفضاله % 37(@)(@@) % تتأخر القبلات عن أقدامه % من هيبة فتؤم ترب نعاله % 38(@)(@@) % مستغرق بالله يظهر بعضه % للعالمين ظهور طيف خياله % 39(@)(@@) % لولا مهابته التي ثنت الورى % % عن قربه صلوا على أذياله % 40(@)(@@) % لا يعرف الفحشاء لا عن ركة % بل عن تكرمه وعن إهماله % PageV01P343 41(@)(@@) % أغناه عن وصف الشجاعة نبله % لا عاجز ما رام في إهماله % 42(@)(@@) % ولمن يحارب في الأنام بأسرهم % عتقاء رأفته وبعض عياله % 43(@)(@@) % هيهات يبلغ وصفه مدح ولو % % أفنى البليغ الجهد في أفعاله % 44(@)(@@) % يا من لهم همم تفل شبا الظبي % % ظبة الحسام بحده وصقاله % 45(@)(@@) % خذ شهرك الآتي بهجة عالم % بنهاية الأقبال 
ms65	 في إقباله % 46(@)(@@) % شهرا حويت ثوابه وحكيت ما % % في حسن مقدمه وشبه هلاله % 47(@)(@@) % وقرنته بالبر في شعبانه % وبه يكون الزاد في شواله % 48(@)(@@) % لو لم يؤمل عوده لك ثانيا % لم يرض منك ببينه وزواله % 49(@)(@@) % خذ بنت ليلتها ومهد عذر من % % لم يستفق للنظم من أشغاله % 50(@)(@@) % مصفي الوداد يعد بأسك قوة % ويعد ذكرك فرصة في فاله % PageV01P344 51(@)(@@) % بصفاتك العليا محط رجائه % وببابك الأعلى محط رحاله % PageV01P345 البحر : كامل تام 1(@)(@@) % ما شئت من عبء الغرام وحمله % دع عنك وبلا لا يقوم بطله % 2(@)(@@) % يا مسعدي في حمل أثقال الهوى % % متجملا تبغي معونة حمله % 3(@)(@@) % هون عليك من التكلف واسترح % ليس الفقيد كمن ينوح بجعله % 4(@)(@@) % يا من له سوق الجمال يدله % % في حب معشوق الفؤاد بد له % 5(@)(@@) % متحكم أعطاه ملك جوانحي % % ملك الجمال أقله وأجله % % 6(@)(@@) % يا بدر رق لذي وداد صادق % لم تبله الأشجان لو لم تبله % 7(@)(@@) % فبماء حسن قد عززت بصونه % وبماء دمع قد ذللت بمذله % 8(@)(@@) % جد لي بعيش بالرضا منك انقضى % % وإذا استحال بعينه فبمثله % 9(@)(@@) % قد كنت أشكو من صدودك بعضه % فالآن كيف وقد بليت بكله % % 10(@)(@@) % يا موقف البين الذي قد كان لي % % علما بثارات الهوى من قبله % PageV01P346 11(@)(@@) % كم ليلة قضيتها بشكاية % أخذت على ليلي مجامع سبله % 12(@)(@@) % متنصلا من ذا الزمان وجوره % متوصلا لابن الأثير وعدله % 13(@)(@@) % حتى نفى ظلم الضلال بشمسه % عني وحر الحادثات بظله % 14(@)(@@) % عرف به الشرف المنيف ببابه % لتكون جئت بجنسه وبفضله % 15(@)(@@) % المحسنين لمن أساء زمانه % وتغربت أوطانه عن أهله % 16(@)(@@) % في الفرع ما في أصله وزيادة % % كالغصن خص بما جنى من أكله % 17(@)(@@) % والسهم يرسله الذي يرمي به % % فإذا أصاب رمية فبنصله % PageV01P347 البحر : سريع 1(@)(@@) % في غزلي من لحظ ذاك الغزال % أخبار صب قتلته النبال % 2(@)(@@) % غصن سقته أدمعي ثم ما % % أثمر لما مال إلا الملال % 3(@)(@@) % وهبته ياقوت دمعي ولا % يسمح لي مبسمه باللآل % 4(@)(@@) % حل ثلاثا يوم حمامه % ذوائبا تعبق منها 
ms66	 الغوال % % 5(@)(@@) % فقلت والقصد ذؤاباته % يا سهري في ذي الليال الطوال % PageV01P348 البحر : سريع 1(@)(@@) % أسير ألحاظ بخد أسيل % كليم أحشاء بطرف كليل % 2(@)(@@) % في حب من حظي من شعره % % لكن قصير ذا وهذا طويل % 3(@)(@@) % ليس خليلا لي ولكنه % % أضرم في الأحشاء نار الخليل % 4(@)(@@) % ظبي من الترك هضيم الحشا % % يهز عطفيه دلالا جميل % 5(@)(@@) % ذو وجنة توريدها شاهد % إن أنكرت قتلي بطرف كحيل % 6(@)(@@) % تلاعب الشعر على ردفه % أوقع قلبي في العريض الطويل % 7(@)(@@) % كم قلت من وجدي به مشفقا % ولي حشا من هجرة في غليل % 8(@)(@@) % يا ردفه جرت على خصره % رفقا به ما أنت إلا ثقيل % PageV01P349 البحر : وافر تام 1(@)(@@) % يقول وقد رنا عن لحظ ظبي يقول وقد رنا عن لحظ ظبي % وهز الغصن في ورق الغلائل % 2(@)(@@) % أأقتلكم بطرفي أم بعطفي % % فقلت بما تشا فالكل ذابل % 3(@)(@@) % سلام الله ما هبت شمال % على تلك المعاطف والشمائل % PageV01P350 البحر : متقارب تام 1(@)(@@) % خذوا قودي من أسير الكلل % فواعجبا لأسير قتل % 2(@)(@@) % وقولوا علي إذا نحتم % قتيل العيون جريح المقل % % 3(@)(@@) % ولي جلد عند بيض الظبى % % وبلأعين النجل ما لي قبل % % 4(@)(@@) % ولي قمر ما بدا في الدجى % % وأبصره البدر إلا أفل % 5(@)(@@) % فيا خجلة الظبي لما بدا % % شبيها له في اللمى والكحل % 6(@)(@@) % ويا خجلة الشمس لما بدت % ألم تر فيها احمرار الخجل % 7(@)(@@) % يضل بطرته من يشا % % ويهدي بغرته من أضل % 8(@)(@@) % وقد عدل الحسن في خلقه % على أنه جار لما عدل % 9(@)(@@) % فعمت معاطفه بالنشاط % وخصت روادفه بالكسل % 10(@)(@@) % وقد علم الناس أني امرؤ % أحب الغزال وأهوى الغزل % PageV01P351 11(@)(@@) % فلا تنكر اليوم يا عاذلي % % قلست أميل إلى من عذل % 12(@)(@@) % فألحفت قامته بالعناق % وأذبلت مرشفه بالقبل % 13(@)(@@) % وكم تهت في غور خصر له % وأشرفت من فوق ذاك الكفل % 14(@)(@@) % وأذنت حين تجلى الصباح % بحي على خير هذا العمل % 15(@)(@@) % وها أثر المسك في راحتي % % هداه فمي فيه طعم العسل % % 16(@)(@@) % دعاني إلى رشف تلك القبل % غرام 
ms67	 صحيح ومالي قبل % 17(@)(@@) % إذا فتكت في ألحاظه % بقد يقد فكيف العمل % 18(@)(@@) % هناك ترى أدمعي المنحني % % وقلبي برمي الجمار اشتعل % 19(@)(@@) % ودمعي من الشوق يا ما جرى % % عقيقا وبالله عقلي ذهل % 20(@)(@@) % فما ضره لو سمح بالكرى % % ولو ساعة بعد ما قد فعل % PageV01P352 21(@)(@@) % وسكنته في لظى مهجتي % % وذاك لعمري جرا من قتل % 22(@)(@@) % ومن عجب زار في ليلة % وعما جرى بيننا لا تسل % 23(@)(@@) % فصرت أشاهد تلك الرياض % على وجنتيه أنا في خجل كذا % % 24(@)(@@) % واقطف وردا بأغصانه % % ولم يك هذا بغير المقل % 25(@)(@@) % فلله درك من ليلة % تعادل أرواحنا بل أجل % 26(@)(@@) % تريك إذا أسفرت بهجة % وروض السرور بها قد حصل % 27(@)(@@) % ولا عيب فيها سوى أنها % % خلت من رقيب لنا أو عذل % % 28(@)(@@) % ألا فلل الله سيف المقل % فكم ذا تعدى وكم ذا قتل % 29(@)(@@) % وما من قتيل لأهل الهوى % % سوى ألف راض بما قد فعل % % 30(@)(@@) % لقد نصر الله جيش الملاح % ببدر لنا حسنه قد كمل % PageV01P353 31(@)(@@) % وما بطل في الوغى فارس % إذا قابل الغيد إلا بطل % 32(@)(@@) % إذا قاتلتني عيون الظبا % % فوا فرحي لو بلغت الأمل % % 33(@)(@@) % رعى الله ليلة زار الحبيب % وغاب الرقيب إلى حيث أل % 34(@)(@@) % فخبأته في سواد العيون % وقد غسل الدمع ذاك المحل % 35(@)(@@) % وألصقت خدي بأقدامه % % وأذبلت أخمصه بالقبل % 36(@)(@@) % فرق ومال بأعطافه % فدبت بروحي ذاك الميل % 37(@)(@@) % وعانقته وخلعت العذار % ومزقت ثوب الحيا والخجل % % 38(@)(@@) % وما زلت أشغله بالحديث % وستر الظلام علينا انسدل % % 39(@)(@@) % إلى أن غفا جفنه بالمنام % وعني تغافل أوقد غفل % 40(@)(@@) % وخليت عن خصره بنده % وأجفيت عن معطفيه الحلل % PageV01P354 41(@)(@@) % وبت أشاهد صنع الإله % تبارك رب البرايا وجل % 42(@)(@@) % فظن بنا الخير أو لا تظن % فلا تسأل اليوم عما حصل % PageV01P355 البحر : سريع 1(@)(@@) % أسرفت في اللوم ولم تقتصر % وزدت في لومك يا ذا العذول % 2(@)(@@) % قد رضيت نفسي بمحبوبها % % وإنما المولى كثير الفضول % PageV01P356 البحر : دو بيت 1(@)(@@) % العاذل في هواك قد زاد وقال % % والصب لما 
ms68	 يقول ملقيه وقال % % 2(@)(@@) % لا تحسب أن الحسن في وجهك حال % قد عم جمال خدك الورد بحال % % PageV01P357 البحر : كامل تام 1(@)(@@) % وافى وأرواح العذيب نواسم % والليل فيه من الصباح مباسم % 2(@)(@@) % أهلا بمن أسرى به وعد له % متأخر وهوى لنا متقادم % 3(@)(@@) % قد كنت أقنع عند رؤيته بما % % يهديه في التأويب طيف قادم % 4(@)(@@) % غض الشبيبة والملاحة يعذر ال % % مضني به ويلام فيه اللائم % 5(@)(@@) % النضر من أعطافه وكنانة % بلحاظه ولمهجتي هو هاشم % 6(@)(@@) % فرع به أصل الصبابة هل ترى % % بالقرب منه لجمع شمل ناظم % 7(@)(@@) % ونواظر هن الذوابل لو درى % % من قال حين فتكن هن صوارم % 8(@)(@@) % أمعنفين على الغرام وقلما % % يصغي لأوهام العواذل هائم % 9(@)(@@) % هو ناظر متعشق وجوانح % فيها مواطن للجوى ومعالم % 10(@)(@@) % وهوى لقلبي غارم أنا غارم % صبري به وأخو الملامة راغم % PageV01P358 11(@)(@@) % هيهات أن أثني عناني والصبا % % غض وغصن العمر رطب ناعم % 12(@)(@@) % أو اشتكي حالي ومن أحببته % أبدا لإخلاف القبول ملازم % 13(@)(@@) % أو أختشي خطبا أراه ببلدة % وبها بهاء الدين يوسف حاكم % 14(@)(@@) % يا خير من نيطت عليه للعلى % % ومن المهابة والجلال تمائم % 15(@)(@@) % ما كان قبلك من كريم يرتجى % % ى منه ولا ولدت سواك أكارم % 16(@)(@@) % لكن تجسم قبل خلقك جودك ال % % بادي وسماه البرية حاتم % 17(@)(@@) % حاشا لعزمك أن تقوم لهمة % والدهر عن إتمامها لك نائم % 18(@)(@@) % أو أن تلوح وليس يخفى عاقل % أو أن تقول وليس يخرس عالم % 19(@)(@@) % أو أن تجود وليس يثرى مملق % أو أن تشير وليس يعدل ظالم % 20(@)(@@) % أبني الزكي سقيتم ووقيتم % وبقيتم والأكرمون فداكم % PageV01P359 21(@)(@@) % نسب إذا ما قيل من هو أعربت % أحساب أعراب لكم وأكارم % PageV01P360 البحر : سريع 1(@)(@@) % الدمع هام والحشا هائم % والجفن دام والجوى دائم % 2(@)(@@) % يا من خلا من حسنهم ناظري % % في القلب مغناكم ومعناكم % 3(@)(@@) % والله ما سارت بأرض الحمى % ركابنا إلا ذكرناكم % 4(@)(@@) % ولا سرت من نحوه نسمة % إلا عرفناها برياكم % 5(@)(@@) % سقى ليالينا على حاجر % غيث وحياها وحياكم % 6(@)(@@) % لياليا 
ms69	 بالوصل قضيتها % % ما كان أحلاها وأحلاكم % 7(@)(@@) % أحبابنا ما الجزع ما المنحنى % % ما رامة ما الشعب لولاكم % 8(@)(@@) % ما قام هذا الكون إلا بكم % ولا الوجود المحض إلا كم % 9(@)(@@) % ولي بجرعاء الحمى شادن % بقتل أرباب الهوى عالم % 10(@)(@@) % ما القلب عنه في الهوى مائل % ولا له في حبه لائم % PageV01P361 11(@)(@@) % يصرم حبل الود من منصفي % % من صارم في لحظه صارم % 12(@)(@@) % أشكو إليه منه ما ألتقي % % ويلاه من خصم هو الحاكم % PageV01P362 البحر : طويل 1(@)(@@) % إذا بعدوا وافوك أسرى وإن دنوا % % لغزوك وافتهم قنا وصوارم % 2(@)(@@) % ولا غائب إلا أتى وهو تائب % ولا قادم إلا أتى وهو نادم % 3(@)(@@) % لأعناقهم بالبيض منك معانق % لغير هوى فيهم وبالسمر لاثم % 4(@)(@@) % تفتح منهم بالسيوف شقائقا % عليها الدروع الضافيات كمائم % 5(@)(@@) % بحرب تكون البيض منها بوارقا % نجيعهم فيها الغيوم السواجم % 6(@)(@@) % قتلهم بالذعر حتى كأنما % % تحاربهم فيه وأنت مسالم % 7(@)(@@) % وقد علم الأعداء أنك إن تقم % بقائم سيف فهو بالنصر قائم % 8(@)(@@) % إذا رمت أن ترقى إلى المجد سلما % صعدت إليه وصعا وسلالم % 9(@)(@@) % وحف بك الجيش الذي بك نصره % ومنك له إقدامه والعزائم % 10(@)(@@) % وسار ببيدر من سنا وجهك الذي % % به ظلمات تنجلي ومظالم % PageV01P363 11(@)(@@) % على الأعوجيات العتاق التي لها % % حوافر للهامات منها عمائم % 12(@)(@@) % تمد بها في السير أجيادها التي % % كأن لحى الأعداء فيها براجم % 13(@)(@@) % سهام على مثل السهام تبسمت % سيوفهم حيث الوجوه سواهم % 14(@)(@@) % وليس بناج منك جان بجرمه % إذا أعوزته من يديك المراحم % 15(@)(@@) % يكر بما تهوى الجديدان في الورى % % وتسري بما ترضي الرياح النواسم % 16(@)(@@) % وتحتقر الفرسان حتى كأنهم % وهم بهم يوم الهياج بهائم % 17(@)(@@) % وتعطي أياديك التي يدك احتوت % ولو جمعت في راحتيك الأقالم % 18(@)(@@) % كأنك أم والأنام بأسرهم % يتامى وبعل والأنام أيائم % 19(@)(@@) % تؤم رماح الخط بيضك في الوغى % % كما قابلت بيض الوجوه المعاصم % 20(@)(@@) % وتغضي عن الفحشاء لا عن جهالة % ولكن لمعنى آثرته المكارم % PageV01P364 21(@)(@@) % ولي مدح بالغت فيها بلاغة % وأثنيت فيها بالذي أنا 
ms70	 عالم % 22(@)(@@) % ولي فيك آمال عليك بلوغها % % فلا دافع دون الذي أنت حاكم % 23(@)(@@) % أبعدك يحوي المجد من هو فاخر % وبعدي يقول الشعر من هو ناظم % 24(@)(@@) % وإن لساني ذو الفقار عليه % علاك فمن مثلي ومثلك غانم % 25(@)(@@) % أجر وأجز واعطف وأعط فإنما % % يخص كريما بالنوال الأكارم % PageV01P365 البحر : دو بيت 1(@)(@@) % ما ذاب سقاما في الهوى لو لاكم % % ما أتلف قلبه جوى إلا كم % 2(@)(@@) % ما أعتبكم ما الذنب والله لكم % الذنب لإنسان غدا يهواكم % PageV01P366 البحر : كامل تام 1(@)(@@) % يا من دعوت له غداة دعوته % فأبى يجيب وللصدود علائم % 2(@)(@@) % قصدي أراك فإن أبيت فإنما % % قصدي أخبر عنك أنك سالم % PageV01P367 البحر : بسيط تام 1(@)(@@) % أحلى الهوى أن يطول الوجد والسقم % وأصدق الحب ما جلت به التهم % 2(@)(@@) % ليت الليالي أحلاما تعود لنا % % فربما قد شفى داء الهوى الحلم % 3(@)(@@) % لا آخذ الله جيران النقا بدمي % % هم أسلموني لوجد منه قد سلموا % % 4(@)(@@) % وحرموا في الهوى وصلي وما عطفوا % % وحللوا بالنوى قتلي وما رحموا % % 5(@)(@@) % وفيتهم حق حفظ العهد مغتبطا % بهم وما رعيت لي عندهم ذمم % 6(@)(@@) % يا غائبين ووجدي حاضر بهم % % وعاتبين وذنبي في الغرام هم % 7(@)(@@) % لا أوحشت منكم دار بكم شرفت % ولا خلت من مغاني حسنكم خيم % 8(@)(@@) % بنتم فلا طرف إلا وهو مضطرب % شوقا ولا قلب إلا وهو مضطرم % 9(@)(@@) % فكل أرض وطئتم تربها فلك % وكل واد حللتم ربعه حرم % 10(@)(@@) % هل عائد والأماني قلما صدقت % دهر مضى ومغاني حسنكم أمم % PageV01P368 11(@)(@@) % فالجسم مذ غبتم بالسفح متشح % والقلب مضطرب بالشوق مضطرم % 12(@)(@@) % لم ينسنا سالفا من عهدكم قدم % ولا سعت بالتسلي نحونا قدم % 13(@)(@@) % أستودع الله ركبا في هوادجهم % محجب ليس ترعى عنده الذمم % 14(@)(@@) % له من الغصن قد زانه هيف % ومن غزال الحمى طرف به سقم % 15(@)(@@) % يبيت قلبي عليه حرقة وجوى % وقلبه بارد من لوعتي شبم % 16(@)(@@) % ظللت فيه وأمسى قلبه حجرا % لم يشف قط محبا شفه ألم % 17(@)(@@) % فوا الذي زانه من طرفه سقم 
ms71	 % وأودع السحر فيه أنه قسم % 18(@)(@@) % لولا تثني رديني القوام به % حلفت ألف يمين أنه صنم % PageV01P369 البحر : طويل 1(@)(@@) % حديث غرامي في هواك قديم % وفرط عذابي في هواك نعيم % 2(@)(@@) % بمت شئت عذب غير سخطك إنه % وصدق ولائي في هواك أليم % 3(@)(@@) % تمثلك الأشواق وهما لخاطري % % فيدركني بالخوف منك وجوم % 4(@)(@@) % وتقنع منك الروح لمح توهم % فتحيا بها الأعضاء وهي رميم % 5(@)(@@) % هنيئا لطرف فيك لا يعرف الكرى % % وتبا لقلب فيك ليس يهيم % 6(@)(@@) % ولما جلاك الفكر يا غاية المنى % % فظل بقلبي مقعد ومقيم % 7(@)(@@) % وما الكون إلا صورة أنت روحها % % وجسم بغير الروح كيف يقوم % 8(@)(@@) % توهم صحبي أن بي مس جنة % وأنكر حالي صاحب وحميم % 9(@)(@@) % فبحت بما ألقاه منك مصرحا % وما نال لذات الغرام كتوم % 10(@)(@@) % أغصن النقا إني أغار إذا غدا % % يلاعب عطفيك الرشاق نسيم % PageV01P370 11(@)(@@) % ولما بدت في طور خدك جذوة % ولاحت لقلبي عاد وهو كليم % 12(@)(@@) % يلذ لقلبي في هواك عذابه % ولم لا وبالأحوال أنت عليم % 13(@)(@@) % يمينا بأصوات الحجيج على منى % وصحب لهم بالمأزمين زميم % 14(@)(@@) % لأنت وإن أصبحت بالوصل باخلا % علي احتقارا بي لدي كريم % 15(@)(@@) % ويا شرفي لما غدوت وللهوى % % على جسدي المضنى النحيل رسوم % 16(@)(@@) % ويا سائقا يضني الركائب طلحا % لها في الرسوم المقفرات رسيم % 17(@)(@@) % إذا عاينت عيناك بارق أبرق % يلوح كما في الأفق لاح نجوم % 18(@)(@@) % وباحت بأسرار الربا نسمة الصبا % % وعطر أقطار القفار شميم % 19(@)(@@) % وعاينت سلعا قف وسائل أحبتي % % فهذا الذي أصبحت منك أروم % 20(@)(@@) % فثم رشا شوقي إليه مبرح % وريم فؤادي عنه ليس يريم % PageV01P371 21(@)(@@) % أغالط عنه بالكلام مجاليسي % % وفي القلب من ذكري سواه كلوم % 22(@)(@@) % له من سويداء الفؤاد معاهد % وبين سواد المقلتين رسوم % 23(@)(@@) % وقل يا غريب الحسن رق لنازح % غريب له قلب لديك مقيم % 24(@)(@@) % ترحل عنه مذ ترحلت نافرا % فليس له حتى القدوم قدوم % 25(@)(@@) % عليك سلام من كئيب متيم % تظل سليما وهو منك سليم % PageV01P372 البحر : طويل 1(@)(@@) % عفا الله عن 
ms72	 قوم عفا الصبر منهم % فلو زمت ذكرى غيرهم خانني الفم % 2(@)(@@) % تجنوا كأن لا ود بيني وبينهم % % قديما وحتى ما كأنهم هم % 3(@)(@@) % فأعظم وصلا من يشير بطرفه % إلي وأوفى ذمة من يسلم % 4(@)(@@) % وبالجزع أحباب إذا ما ذكرتهم % % شرقت بدمع في أواخره دم % 5(@)(@@) % ألم وما في الركب من متيم % وعاد وما في الركب إلا متيم % 6(@)(@@) % وليس الهوى إلا التفاتة طامح % يروق لعينيه الجمال المنعم % 7(@)(@@) % خليلي ما للقلب هاجت شجونه % وعاوده داء من الشوق مؤلم % 8(@)(@@) % وما راعه إلا لأمر غرامه % % ولا اعتاده إلا هوى متقدم % 9(@)(@@) % أظن ديار الحي منا قريبة % وإلا فمنها نفحة تتنسم % PageV01P373 البحر : وافر تام 1(@)(@@) % أيرعى في محبتكم ذمام % ويعدل في رعيته الغرام % 2(@)(@@) % وينصف ظالم منا ومنكم % ولا قلنا ولا سمع الأنام % 3(@)(@@) % ويرجع عيشنا الماضي وتدنو % % خيانم للوصال لها ختام % 4(@)(@@) % ويصدق منكم وعد مقالا % ويحوي من له . . . مقامد % % 5(@)(@@) % ويسفر عن ثنايا الدر ظلم % يرى حسا وحبكم المدام % 6(@)(@@) % فإنا خبرتنا عن رضاكم % % أمانينا بأنكم كرام % 7(@)(@@) % وأقمار تضيء لكل سار % لها من نور حسنكم تمام % PageV01P374 البحر : طويل 1(@)(@@) % فيا شعره هل فيك ليلي ينقضي % % ويا صبحه هل فيك صبحي باسم % 2(@)(@@) % ويا طرفه كيف السبيل لمغرم % عليك إلى وصل وسفك صارم % 3(@)(@@) % تحكم بما تهوى فما أنا مائل % ولا عنك يثنيني من الوجد لائم % 4(@)(@@) % ولي مقلة قد أمطر الشوق سحبها % % ففي دمعها حتى تراكم تراكم % PageV01P375 البحر : طويل 1(@)(@@) % أفي مثل هذا الحسن يعذل مغرم % % لقد تعب اللاحي به والمتيم % 2(@)(@@) % أعد نظرا فيه عساك جهلته % تجد ما به تشقى العيون وتنعم % 3(@)(@@) % أعيذ محياه إذا رمت إنني % % أعيد إليه ناظرا يتوسم % 4(@)(@@) % وألقى سنا لو كان قلب حروفه % لعيني به لم يشك وحشته فم % PageV01P376 البحر : وافر تام 1(@)(@@) % تهددني بهجران وبعد % متى كان اجتماع والتئام % 2(@)(@@) % إذا أنا لا أراك وأنت جار % فسيان الترحل والمقام % PageV01P377 البحر : مجزوء الرجز 1(@)(@@) % قولوا لرسامكم % بك الفؤاد مغرم % 2(@)(@@) % قالوا متى 
ms73	 تذيبه % فقلت حتى يرسم % PageV01P378 البحر : كامل تام 1(@)(@@) % من للخلاف وللوفاق مسائلا % وخصائلا أو للعلى لولاكم % 2(@)(@@) % حسب المرجي في المعاد شفاعة % منكم ومن قبل المعاد نداكم % 3(@)(@@) % لو أطلق اسم النيرات ما سرى % % ذهن الذي هو سامع لسواكم % 4(@)(@@) % أو كان وحي بعد أحمد مرسل % % لبدت لكم آي به وعلائم % 5(@)(@@) % تتسابق الأذهان في إدراككم % ويفوت أسبقها أقل مداكم % 6(@)(@@) % عثمان جدكم وذلك حسبه % وكفى وذلك حسبكم وكفاكم % 7(@)(@@) % لا أوحشت شمس الشريعة منكم % فبقاؤها متعلق ببقاكم % PageV01P379 البحر : كامل تام 1(@)(@@) % لو أن قلبك لي يرق ويرحم % ما بت من خوف الهوى أتألم % 2(@)(@@) % ومن العجائب أنني والسهم لي % % من ناظريك وفي فؤادي أسهم % 3(@)(@@) % داريت أهلك في هواك وهم عدى % ولأجل عين ألف عين تكرم % 4(@)(@@) % يا جامع الضدين في وجناته % ماء يشف عليه نار تضرم % 5(@)(@@) % عجبي لطرفك وهو ماض لم يزل % فعلام يكسر عندما تتكلم % 6(@)(@@) % أمن المروءة والتواصل ممكن % والدهر يسمح والحوادث نوم % 7(@)(@@) % أني أروح وسلب ردي في الهوى % % قد حل والإيجاب منك محرم % 8(@)(@@) % وابيت مبذول الدموع معذبا % كلفا وأنت ممنع ومنعم % 9(@)(@@) % يا متهما قلبي بسلوة حبه % هيهات ينجده وأنت المتهم % PageV01P380 البحر : مجزوء الرمل 1(@)(@@) % بأبي أفدي حبيبا % تيم القلب غراما % % 2(@)(@@) % عذر العاذل فيه % مذ رأى العارض لاما % % PageV01P381 البحر : كامل تام 1(@)(@@) % لله كفتي أطاع صبابتي % % فيه الفؤاد وخالف اللواما % % 2(@)(@@) % مد الشريط على الحديد فخلته % قمرا يطرز بالبروق غماما % % PageV01P382 البحر : خفيف تام 1(@)(@@) % ليت شعري من قد أحل الخياما % % حفظ العهد أم أضاع الذماما % % 2(@)(@@) % عرب بالحمى حموا أن يسام ال % % وصل منهم وعزهم أن يسامى % % 3(@)(@@) % رحلوا بالفؤاد والطرف لكن % رجع الطرف والفؤاد أقاما % % 4(@)(@@) % حملوا بالبعاد إثما وزورا % % وحملنا صبابة وهياما % % 5(@)(@@) % ورأينا تلك الخدود رياضا % فجعلنا لها الجفون غماما % % 6(@)(@@) % وأطعنا دواعي الوجد فيهم % % وعصينا الوشاة واللواما % % 7(@)(@@) % أي صب قد غادر الوجد منه % مستقرا بقلبه ومقاما % % 8(@)(@@) % رشقته العيون من أسهم السح % ر فأصمت فؤاده المستهاما 
ms74	 % % 9(@)(@@) % فهو منهن بابن مصعب أضحى % % مستجيرا بعدله أن يضاما % % PageV01P383 البحر : مجزوء الكامل 1(@)(@@) % وافى وواصل عندما % % أجرى المدامع عندما % % 2(@)(@@) % ورنا إلي فسلما % % للوجد قلبي سلما % % 3(@)(@@) % وثنى القوام فهزما % % لجيوش صبري هزما % % 4(@)(@@) % وحمى مراشف ثغره % أرأيتم برق الحمى % % PageV01P384 البحر : طويل 1(@)(@@) % ولي واحد ما زال باثنين مغرما % % على واحد ما زال باثنين مغرما % % 2(@)(@@) % رأى جسدي والدمع والقلب والحشى % % فأضنى وأفنى واستمال وتيما % % PageV01P385 البحر : سريع 1(@)(@@) % لا تطلبن القوت من معشر % % ما عندهم لطف ولا رحمه % % 2(@)(@@) % من ليس في لحمهم فضلة % فليس في فضلهم لحمه % PageV01P386 البحر : مجزوء الكامل 1(@)(@@) % يا ذا الذي يروي الحدي % % ث وليس يروى بالقديم % 2(@)(@@) % عندي مدام نهارها % % عندي كجنات النعيم % 3(@)(@@) % ولقد شربت حبابها % % في عقد كاسات النظيم % 4(@)(@@) % فانهض إلي بهمة % نخلي حشاك من الهموم % % 5(@)(@@) % أحلى مدام قد طلب % % ت لشربها أحلى نديم % PageV01P387 البحر : وافر تام 1(@)(@@) % صبوت إلى الصبابة والغرام % % وودع ناظري طيب المنام % 2(@)(@@) % وسام القلب من أولاد سام % غزال طرفه من آل حام % 3(@)(@@) % يريني الموت في سيف ورمح % مقيم في اللواحظ والقوام % 4(@)(@@) % جعلت تصبري عنه ورائي % % وصيرت الغرام به أمامي % % 5(@)(@@) % فهل لي مسعد في الحب يرثي % % لما ألقاه من ألم السقام % PageV01P388 البحر : بسيط تام 1(@)(@@) % يا من شغلت به سري وأوهامي % % ومن لمغناه إنجادي وإتهامي % % 2(@)(@@) % ومن ألفت رضاه الرحب جانبه % وفزت منه بإحسان وإنعام % 3(@)(@@) % لم أنس أقدامك اللاتي سعت ومشت % بهن حينا على العلياء أقدامي % % 4(@)(@@) % وحسن أيامك الغر التي حسنت % بها ليالي من دهري وأيامي % % 5(@)(@@) % فما المدارس حتى كدرت نهلا % وردته صافيا من بحرك الطامي % % 6(@)(@@) % وغيرت خلقا ما زال يمنحني % % بضاحك من ثنايا الود بسام % 7(@)(@@) % كن كيف شئت فداك الناس كلهم % فالناس كلهم في ظلك السامي % % PageV01P389 البحر : كامل تام 1(@)(@@) % إمنع جفونك أن تريق دمي % % إن الجفون مظنة التهم % 2(@)(@@) % وأبن جبينك تتضح طرقي % % وأمط لثامك تنكشف ظلمي % % 3(@)(@@) % يا روضة أجني أزاهرها % % باللحظ لا بيدي ولا 
ms75	 بفمي % % 4(@)(@@) % مالي حرمت لذيذ وصلك في % % أيام هذي الأشهر الحرم % 5(@)(@@) % لو أن قربك يبتغى بشرا % % بالغت فيه بأنفس القيم % PageV01P390 البحر : كامل تام 1(@)(@@) % هذا الذي أنا قد سمحت لحبه % كرما بلؤلؤ دمعي المتنظم % 2(@)(@@) % لا تحرموني ضم أسمر قده % % ليس الكريم على القنا بمحرم % PageV01P391 البحر : مجزوء الرمل 1(@)(@@) % أنا كاس في كيس % لحديث أو قديم % 2(@)(@@) % لما أزل في كف ساق % أو على ثغر نديم % PageV01P392 البحر : مجزوء الرمل 1(@)(@@) % أنا من لطف مزاجي % % وصفا روحي وجسمي % % 2(@)(@@) % دائر بين الندامى % % والتثام الثغر رسمي % % PageV01P393 البحر : سريع 1(@)(@@) % يا حبذا طيفك من قادم % يا أحسن العالم في العالم % 2(@)(@@) % طيف تجلى نوره ساطعا % حتى رأته مقلة النائم % 3(@)(@@) % يا غائبا يحكم في مهجتي % % علي طالت غيبة الحاكم % 4(@)(@@) % عار على حسنك أن أشتكي % % حظي منه أنه ظالمي % % PageV01P394 البحر : كامل تام 1(@)(@@) % أمل سعيت أجد في إتمامه % فعلام حل الدهر عقد نظامه % 2(@)(@@) % وإلى متى يسعى الزمان لنقض ما % % أسعى بكل الجهد في إبرامه % 3(@)(@@) % وإذا الفتى قعدت قوائم حظه % قام الردى من خلفه وأمامه % 4(@)(@@) % دام الوزير ممتعا بخلوده % % فدوام تشييد العلى بدوامه % 5(@)(@@) % السعد في أبوابه والأمن في % % إقليمه والرزق في أقلامه % 6(@)(@@) % والشمس من قسماته والجود في % % تقسيمه والبر في أقسامه % 7(@)(@@) % والبأس في يقظاته والحلم في % % غفلاته والعلم ملء كلامه % 8(@)(@@) % والصدق في أقواله والحق في % % افعاله والعدل في أحكامه % % 9(@)(@@) % والله من حفائظه والنصر من % أعوانه والدهر من خدامه % 10(@)(@@) % ملكت سجيته الجميل بجيمه % وبميمه وبيائه وبلامه % PageV01P395 11(@)(@@) % جاء الكرام ببدء جودهم وقد % جاء الوزير ببدئه وختامه % 12(@)(@@) % مستعصم بالله في حركاته % وسكونه وقعوده وقيامه % % 13(@)(@@) % مغرى باعطاء المكارم حقها % % في حال يقظته وحال منامه % % 14(@)(@@) % ما بال حظي كلما قدمته % % دفعته أيامي إلى إحجامه % 15(@)(@@) % أأذل في أيام من قد كان لي % % ظن بنيل العز في أيامه % 16(@)(@@) % حاشا الرياسة والسيادة والندى % % حاشا الذي عودت من انعامه % 17(@)(@@) % يا ابن العلى وأبا العلى وأخا العلى 
ms76	 % % ومن النجوم الزهر دون مقامه % 18(@)(@@) % أيكون مثلي في الهوى متظلما % يشكو الزمان وأنت من حكامه % 19(@)(@@) % أين المروؤة والقيام بحق من % % ألقى إليك ذمامه بزمامه % % 20(@)(@@) % لا تحقرن صغير قوم ربما % % كبرت فضائله على أقوامه % % PageV01P396 21(@)(@@) % تعس الشباب فما سعدت بشرخه % % ولقد شقيت بظلمه وظلامه % % 22(@)(@@) % أمكلفي ذنب الزمان وليس لي % % ذنب يؤاخذني على إجرامه % 23(@)(@@) % الرزق أحقر أن أضيع مدتي % % بالعذر عند سواكم وملامه % PageV01P397 البحر : كامل تام 1(@)(@@) % هيهات أن يسخو ولو بسلامه % من لم يزل للحرب لابس لامه % 2(@)(@@) % متعرض للعاشقين بلحظه % نظر الكمي إلى محط سهامه % 3(@)(@@) % قمر جنيت الورد أول بدئه % وجنى علي الوجد عند تمامه % 4(@)(@@) % وألفته مذ كان يألف مهده % ورضعت ثدي هواه قبل فطامه % % 5(@)(@@) % تسديد أمري سد فيه بلثمة % وقوام حالي ضم غصن قوامه % 6(@)(@@) % ومتيم ذهب الغرام بحلمه % وجنت صبابته على أحلامه % 7(@)(@@) % أخذ الهوى بيمينه وشماله % واغتاله من خلفه وأمامه % PageV01P398 البحر : دو بيت 1(@)(@@) % لو رق فؤاده على مغرمه % ما ضن بنظم الدر من مبسمه % 2(@)(@@) % ما قصدي لثمه ولكن غرضي % % إبلاغ حويجة له في فمه % PageV01P399 البحر : كامل تام 1(@)(@@) % لما سمعت بفضل جودكم % % وبما يرام من الندى منكم % % 2(@)(@@) % وافيت أطرق باب فضلكم % فتصدقوا دفع البلا عنكم % PageV01P400 البحر : دو بيت 1(@)(@@) % العاذل قد عنف في الحب ولام % مذ عاين قد بدا على خدك لام % 2(@)(@@) % يا بدر دجى قدمت في عشقته % الهجر حلال منك والوصل حرام % PageV01P401 البحر : دو بيت 1(@)(@@) % ما ناح على الغصون في الدوح حمام % إلا ولقيت منك بالشوق حمام % 2(@)(@@) % فارحم دنفا قد زاده البعد سقام % لا يعرف مذ هجرته طعم منام % PageV01P402 البحر : سريع 1(@)(@@) % وذي ثنايا لم تدع عاشقا % إلا عصى في حبها من يلوم % % 2(@)(@@) % كم بت أرعى في لمى ثغرها % % وشيمة العاشق رعي النجوم % PageV01P403 البحر : منسرح 1(@)(@@) % حتام حظي لديك حرمان % وكم كذا جفوة وهجران % 2(@)(@@) % وأين ليال مضت ونحن بها % % أحبة في الهوى وجيران % 3(@)(@@) % وأين ود عهدت صحته % وأين عهد 
ms77	 وأين أيمان % 4(@)(@@) % أعانك الهجر والصدود على % % قتلي ومالي عليك أعوان % 5(@)(@@) % يا غائبا عاتبا تطاول ه % % ذا الهجر هل للدنو إمكان % 6(@)(@@) % قد رضي الدهر والعواذل % والحساد عني وأنت غضبان % 7(@)(@@) % فاسلم ولا تلتفت إلى مهج % بها جوى قاتل وأشجان % 8(@)(@@) % ونم خليا وقل كذا وكذا % % من كل ما أطلعت تلمسان % % PageV01P404 البحر : مجزوء الوافر 1(@)(@@) % ونحوي له نغم % يحار بوصفه الذهن % 2(@)(@@) % فيا لله نحوي % جميع حديثه لحن % PageV01P405 البحر : بسيط تام 1(@)(@@) % ومقرىء طيب الألحان هيج في % % قلبي غراما بما من فيه يلحنه % 2(@)(@@) % يموت في حبه تلميذه كلفا % لأجل ذاك إذا وافى يلقنه % PageV01P406 البحر : رمل تام 1(@)(@@) % ملبسي من هجره ثوب الضنى % % ومذيب القلب حزنا وعنا % % 2(@)(@@) % فبمن أعطاك يا كل المنى % % قامة تزري بأعطاف القنا % % 3(@)(@@) % ومحيا جل من صوره % مخجل البدر سناء وسنا % % 4(@)(@@) % يا مليك الحسن كن لي محسنا % لا يراك الله إلا محسنا % % PageV01P407 البحر : بسيط تام 1(@)(@@) % يا طائرا إذ طاح الحمام به % هيجت للصب يوم الحزن أحزانا % % 2(@)(@@) % فبات بالبان مشغوفا وليس به % شوق إليه ولكن من حكى البانا % % 3(@)(@@) % يا مخجل الغصن إذ يهتز ناعمه % لينا ويوسع من نهواه إليانا % % 4(@)(@@) % لو لاك ما هاجت الورقاء لي فننا % ولا أرقت لظبي بات وسنانا % % 5(@)(@@) % ورب ليل صحبنا في دجنته % % من الكواعب أقمارا وأغصانا % % 6(@)(@@) % بحيث نلثم تفاح الخدود على % % بان القدود ونجني منه رمانا % % 7(@)(@@) % بكل صاف لدى صاف يريك على % % لجينه من سقيط النور عقيانا % % PageV01P408 البحر : بسيط تام 1(@)(@@) % لا طل صوب الغوادي ساحتي قطنا % % ولا رعى الله من في أرضها قطنا % % 2(@)(@@) % ما أنصفوا الخضر الباني جارهم % % لما أراد بأن ينقض حين بنى % % 3(@)(@@) % فاستطعما أهلها موسى وصاحبه % % فلم يضيفوهما شيئا فكيف لنا % % 4(@)(@@) % هجاهم الله في القرآن فاهجهم % % والعنهم الدهر واشكر كل من لعنا % % PageV01P409 البحر : مجزوء الرجز 1(@)(@@) % لو أن من أحبه % % قرب مني بدنه % 2(@)(@@) % قربت شكرا للإله % % ألف ألف بدنه % PageV01P410 البحر : خفيف تام 1(@)(@@) % مالك قد أحل 
ms78	 قتلي برمح ال % % قد منه وراح قلبي طعينه % 2(@)(@@) % ليس يفتي سواه في قتل صب % كيف يفتي ومالك في المدينه % PageV01P411 البحر : كامل تام 1(@)(@@) % وحياتكم في عزكم وهواني % % قسما به الشاني يعظم شاني % % 2(@)(@@) % يا ساكني نعمان ما عرف الهوى % % لولاكم يا ساكني نعمان % 3(@)(@@) % سلت ظباؤكم الظبي من أعين % إنسانها طيب الكرى أنساني % % 4(@)(@@) % هلا رعين عهودنا يوم النوى % % والرعي منسوب إلى الغزلان % 5(@)(@@) % وبمهجتي وسنان يسطو قده % واللحظ منه بذابل وسنان % 6(@)(@@) % بالله يا أعطافه ونهوده % من أنبت الرمان في المران % 7(@)(@@) % جمران من وجدي به وصدوده % % جعلا دموعي فيه كالمرجان % 8(@)(@@) % وبوجنتيه وعارضيه بروق من % نظرت لواحظه له مرجان % 9(@)(@@) % عجبي لثعبان يجول على نقا % % أردافه في الحب كيف حواني % % 10(@)(@@) % ولعاذلي وقد بدا في خده % % من خطه لامان لم لاماني % % PageV01P412 البحر : مخلع البسيط 1(@)(@@) % يا ساكنا قلبي المعنى % % وليس فيه سواه ثاني % % 2(@)(@@) % لأي معنى كسرت قلبي % % وما التقى فيه ساكنان % PageV01P413 البحر : مجزوء الرمل 1(@)(@@) % قد تعشقت خلافي % ا وفيه معاني % % 2(@)(@@) % كلما جادلني العا % % ذل فيه ولحاني % % 3(@)(@@) % جئته من عارضيه % % بدليل الدوران % PageV01P414 البحر : دو بيت 1(@)(@@) % لا تعتقدوا عذاره الفتان % % قد وشح ورد الخد بالريحان % % 2(@)(@@) % ذا خالقه قد خظ في وجنته % % لاما كتبت بالقلم الريحاني % % PageV01P415 البحر : بسيط تام 1(@)(@@) % إني لفي كنف مولى جود راحته % كم راحة وصلت منه لإنسان % 2(@)(@@) % ما أسكتتني بالمعروف منه يد % إلا وسرح تسريحا بإحسان % PageV01P416 البحر : بسيط تام 1(@)(@@) % سمحت بيعا لمملوك يعاندني % % ولو تعدى عنادي ما تعداني % % 2(@)(@@) % قالوا : أينسب للعلان قلت لهم : % ما كنت بائعه لو كان علاني % % PageV01P417 البحر : دو بيت 1(@)(@@) % ما ناح حمام الأيك في الأغضان % إلا وتزايدت بكم أشجاني % % 2(@)(@@) % عودوا لمعنى هجركم أسقمه % فالصب بكم مضنى كئيب عاني % % PageV01P418 البحر : متقارب تام 1(@)(@@) % يمينا بطيب شباب الزمان % غداة الشباب ونيل الأماني % % 2(@)(@@) % وبرد الشباب وبرد الشراب % ووصل الكعاب وظل الأمان % 3(@)(@@) % وروح الجنان وراح الدنان % غداة التعطف من خيزران % 4(@)(@@) % وما رق من 
ms79	 نسمات الصبا % % وما راق من نغمات المثاني % % 5(@)(@@) % وكل رشا فاتر المقلتين % تكون بدرا على غصن بان % 6(@)(@@) % ألية بر قشيب العلى % % رحيب الفناء خصيب المجاني % % 7(@)(@@) % أبي الأباء وفي الوفاء % سني السناء مبين البيان % 8(@)(@@) % لأسعى إلى المجد أسمو به % على روق عز مكين المكان % PageV01P419 البحر : منسرح 1(@)(@@) % حتام يلحى عليك من خلت % الأحشاء منه من لاعج الحزن % 2(@)(@@) % هبه أطال الملام فيك فهل % يدخل ما قال قط في أذني % % 3(@)(@@) % كم جهد ما تفعل المواشط في % % وجه قبيح من آلة الحسن % PageV01P420 البحر : طويل 1(@)(@@) % تمشى بصحن الجامع اليوم شادن % على قده أغصان بان النقا تثني % % 2(@)(@@) % فقلت وقد لاحت عليه حلاوة % ألا فانظروا هذي الحلاوة في الصحن % PageV01P421 البحر : وافر تام 1(@)(@@) % أعز الله أنصار العيون % وخلد ملك هاتيك الجفون % 2(@)(@@) % وضاعف الفتور لها اقتدارا % وجدد نعمة الحسن المصون % 3(@)(@@) % وأبقى دولة الأعطاف فينا % % وإن جارت على قلبي الطعين % 4(@)(@@) % وأسبغ ظل ذاك الشعر منه % على قد به هيف الغصون % 5(@)(@@) % وصان حجاب هاتيك الثنايا % % وإن ثنت الفؤاد إلى الشجون % 6(@)(@@) % فكم في الحب من تلك المعاني % % وإن جعلت دموعي كالمعين % 7(@)(@@) % حملت تسهدي والشيب هذا % % على رأسي وذاك على عيوني % % PageV01P422 البحر : مجزوء الرمل 1(@)(@@) % إن تبدوا أو تثنوا % % فبدور في غصون % 2(@)(@@) % أو رنوا ظبي كناس % أو سطو ليث عرين % 3(@)(@@) % مزجوا الوصل بهجر % لمنايا ومنون % 4(@)(@@) % ولكم بالهجر أجروا % % لعيون من عيوني % % 5(@)(@@) % حبهم روحي وراحي % % وهو دنياي وديني % % 6(@)(@@) % أنا لا أسمع عذلا % فيهم إن عذولوني % % 7(@)(@@) % الأماني خبرتني % % براهم عن يقين % 8(@)(@@) % إنهم عرب كرام % في هواهم ينصفوني % % 9(@)(@@) % كم أضلوني بشعر % وهدوني بجبين % PageV01P423 البحر : سريع 1(@)(@@) % كان بعينين فلما طغى % % بسحره رد إلى عين % 2(@)(@@) % وذاك من لطف لعشاقه % ما يضرب الله بسيفين % PageV01P424 البحر : بسيط تام 1(@)(@@) % كأنني واللواحي في محبته % في يوم صفين قد قمنا بصفين % 2(@)(@@) % وكيف يطلب صلحا أو موافقة % ولحظه بيننا يسعى بسيفين % PageV01P425 البحر : - 1(@)(@@) % حي غزالا سل من أجفانه 
ms80	 % غضبا غدا يقتل في أجفانه % 2(@)(@@) % فالسحر ما استنبط من لحاظه % والدر ما ساتودع في مرجانه % 3(@)(@@) % كم بت أجني من جنى خده % % وردا نما فوق غصون بانه % 4(@)(@@) % حيث أسوغ العذب من مرشفه % % وأرشف الواضح من جمانه % 5(@)(@@) % منازلا كنت بها مصرفا % أعنة اللهو لدى ميدانه % % 6(@)(@@) % فيا رعى الله زمانا قد مضى % % والعيش منسوب لذي زمانه % PageV01P426 البحر : رجز تام 1(@)(@@) % مثل الغزال نظرة ولفتة % من رآه مقبلا ولا افتتن % 2(@)(@@) % أحسن خلق الله وجها وفما % إن لم يكن أحق بالحسن فمن % 3(@)(@@) % في جسمه وصدغه وشكله % الماء والخضرة والوجه الحسن % PageV01P427 البحر : دو بيت 1(@)(@@) % قاسيت بك الغرام والوجد سنين % ما بين بكاء وحنين وأنين % 2(@)(@@) % أرضيك وما تزداد إلا غضبا % الله كما أبلى بك القلب يعين % PageV01P428 البحر : دو بيت 1(@)(@@) % قد أصبح آخر الهوى أوله % فالعاذل في هواك مالي وله % 2(@)(@@) % بالله عليك خل ما أوله % وارحم دنفا حشو حشاه وله % PageV01P429 البحر : دو بيت 1(@)(@@) % الصب بحبه عليه وله % ولعاذل في هواك ما لي وله % 2(@)(@@) % إيضاح غرامه له تكمله % إن كان مفصل الهوى مجمله % PageV01P430 البحر : دو بيت 1(@)(@@) % يا من أمر الغرام والقلب له % قد أسقم جسمي في هواه وله % 2(@)(@@) % كم يعذلني اللائم فيه سفها % اللائم في هواك مالي وله % PageV01P431 البحر : دو بيت 1(@)(@@) % كم قلت مغالطا لكي أسأله % بالله دم المحب من حلله % 2(@)(@@) % قتلي لك بالصدود من سبله % من يعذلني عليك فالسب له % PageV01P432 البحر : دو بيت 1(@)(@@) % لب العاني بصده بلبله % والقلب بنار هجره أشعله % 2(@)(@@) % إن أنكر وجدي وعنا القلب به % ها دمعي سائل لكي يسأله % PageV01P433 البحر : منسرح 1(@)(@@) % يالله يا ذا النفور رق على % % مغرى الحشا في هواك مضناها % % 2(@)(@@) % وعامل الله في مواصلتي % % ما خاب عبد يعامل الله % % PageV01P434 البحر : طويل 1(@)(@@) % وما اسم بلا جسم وتمسكه يد % وأحقر شيء فيه أشرف ما فيه % 2(@)(@@) % يقابله بالكسر من رام جبره % ويضعفه بالضرب حين يقويه % PageV01P435 البحر : مخلع البسيط 1(@)(@@) % أسرع وسر طالب المعالي 