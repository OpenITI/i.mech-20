ms2081	 يأتي يوم القيامة مغلولة يده إلى عنقه ، يفكه عدله ، أو يوبقه إثمه ) )(@)(@@) أبو سعيد النقاش في القضاة عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19307 ) قال النبي :(@)(@@) | 30 ( ما من أحد أخذ شبرا من الأرض بغير حقه إلا طوقه من سبع أرضين ، لا يقبل الله منه صرفا ولا عدلا ) )(@)(@@) ابن جرير عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19308 ) قال النبي :(@)(@@) | 30 ( ما من أحد يكون في قوم يعمل فيهم بالمعاصي PageV06P361 يقدرون على أن يغيروا عليه إلا أصابهم الله بعقاب قبل أن يموتوا ) )(@)(@@) ابن النجار عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19309 ) قال النبي :(@)(@@) | 30 ( ما من أحد يحيي أرضا فيشرب منها كبد حرى ، أو يصيب منها عافية إلا كتب الله بها أجرا ) )(@)(@@) ( كر ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19310 ) قال النبي :(@)(@@) | 30 ( ما من أحد ترك صفراء أو بيضاء إلا كوي بها يوم القيامة ) )(@)(@@) ( حم ) و ابن مردويه ( هق ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19311 ) قال النبي :(@)(@@) | 30 ( ما من أحد من ولد آدم إلا وقد أخطأ أو هم بخطيئة إلا يحيى بن زكريا فإنه لم يهم بها وما ينبغي لأحد أن يقول أنا خير من يونس بن متى ) )(@)(@@) ( حم ع عد ض ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19312 ) قال النبي :(@)(@@) | 30 ( ما من أحد يموت فيترك صفراء أو بيضاء إلا كوي بها يوم القيامة مغفورا له بعد أو معزبا ) )(@)(@@) ابن مردويه عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19313 ) قال النبي :(@)(@@) | 30 ( ما من أحد ترك صفراء ولا بيضاء من ذهب ولا فضة إلا جعل الله له صفائح ثم كوي به من قرنه إلى قدمه ) )(@)(@@) ابن مردويه ( حل ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19314 ) قال النبي :(@)(@@) | 30 ( ما من أحد ينام إلا ضرب على صماخه بحرير معقد ، فإن هو استيقظ فذكر الله تعالى انحلت عقدة ، وإن استيقظ فتوضأ انحلت عقدة أخرى ، فإن قام فصلى انحلت العقد كلهن ، فإن هو استيقظ ولم يتوضأ ولم يصل الصبح أصبحت العقد كلها كهيئتها وبال 
ms2082	 الشيطان في أذنيه ) )(@)(@@) ابن النجار عن أبي سعيد رضي الله عنه .(@)(@@) PageV06P362(@)(@@)(@@)(@@) $ ( 19315 ) قال النبي :(@)(@@) | 30 ( ما من أحد تدرك له تدرك له ابنتان فيحسن إليهما ما صحبتاه وصحبهما إلا أدخلتاه الجنة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19316 ) قال النبي :(@)(@@) | 30 ( ما من أحد أمن علي في يده من أبي بكر : زوجني ابنته ، وأخرجني إلى دار الهجرة ، ولو كنت متخذا خليلا لاتخذت أبا بكر خليلا ، ولاكن أخا مودة إلى يوم القيامة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19317 ) قال النبي :(@)(@@) | 30 ( ما من أحد يموت سقطا ولا هرما ، وإنما الناس فيما بين ذالك إلا بعث ابن ثلاثين سنة فمن كان من أهل الجنة كان على مسحة آدم ، وصورة يوسف ، وقلب أيوب ، ومن كان من أهل النار عظموا وفخموا كالجبال ) )(@)(@@) ( طب ) عن المقدام بن معدي كرب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19318 ) قال النبي :(@)(@@) | 30 ( ما من أحد إلا جعل معه قرين من الجن ، قالوا : ولا أنت يا رسول الله ؟ قال : ولا أنا ، إلا أن الله أعانني عليه فأسلم فلا يأمرني إلا بخير ) )(@)(@@) ( طب ) عن المغيرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19319 ) قال النبي :(@)(@@) | 30 ( ما من أحد يقتل عصفورا إلا عج يوم القيامة يقول : يا رب هاذا قتلني عبثا ، فلا هو انتفع بقتلي ، ولا هو تركني فأعيش في أرضك ) )(@)(@@) ( طب ) عن عمر بن يزيد عن أبيه .(@)(@@)(@@)(@@) $ ( 19320 ) قال النبي :(@)(@@) | 30 ( ما من أحد يسمع بي من هاذه الأمة ، ولا يهودي ولا نصراني فلا يؤمن بي إلا دخل النار ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19321 ) قال النبي :(@)(@@) | 30 ( ما من أحد يدخل الجنة بعمله ، قالوا : ولا أنت يا رسول الله ؟ قال : ولا أنا إلا أن يتغمدني الله برحمته ) )(@)(@@) ( طب ) عن أسامة بن شريك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19322 ) قال النبي :(@)(@@) | 30 ( ما من أحد من المسلمين يصاب ببلاء في جسده PageV06P363 إلا أمر الله تعالى الحافظين اللذين يحفظانه فقال : اكتبا لعبدي في كل يوم وليلة مثل ما كان يعمل من الخير ما دام 
ms2083	 في وثاقي ) )(@)(@@) ( هناد ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19323 ) قال النبي :(@)(@@) | 30 ( ما من أحد أسدى إلى رجل من بني هاشم حسنة فلم يكافئه عليها إلا كنت أنا مكافئه يوم القيامة ( حل ) عن ع$ ثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19324 ) قال النبي :(@)(@@) | 30 ( ما من أحد إلا وعلى بابه ملكان ، فإذا خرج قالا : اغد عالما أو متعلما ولا تكن الثالث ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19325 ) قال النبي :(@)(@@) | 30 ( ما من أحد يموت إلا يوزن قوله وعمله ، فإن كان قوله أوزن من عمله لم يرفع عمله ، وإن كان عمله أوزن من قوله رفع عمله ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19326 ) قال النبي :(@)(@@) | 30 ( ما من أحد يغدو ويروح إلى المسجد ويؤثره على ما سواه إلا وله عند الله نزول يعده له في الجنة كلما غدا أو راح ، كما لو أن أحدكم زاره من يحب زيارته إلا اجتهد له في كرامته ) )(@)(@@) ابن زنجويه وابن لال وأبو الشيخ عن أبي هريرة وفيه عبد الرحمان بن زيد بن أسلم ، ضعفه ( حم قط ) وباقي رجاله ثقات .(@)(@@)(@@)(@@) $ ( 19327 ) قال النبي :(@)(@@) | 30 ( ما من أحد إلاص وهو يتمنى يوم القيامة أنه كان يأكل في الدنيا قوتا ) )(@)(@@) ( خط ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19328 ) قال النبي :(@)(@@) | 30 ( ما من أحد أصيب بمصيبة واسترجع إلا استوجب من الله ثلاث خصال ، كل خصلة خير من الدنيا وما فيها ) )(@)(@@) قال أبو عبيد : يعني : { أولائك عليهم صلوات من ربهم ورحمة وأولائك هم المهتدون } أخرجه عن PageV06P364 حجاج عن ابن جريج قال : بلغنا فذكره معضلا .(@)(@@)(@@)(@@) $ ( 19329 ) قال النبي :(@)(@@) | 30 ( ما منكم من أحد إلا لو شئت أخذت عليه بعض خلقه إلا أبو عبيدة بن الجراح ) )(@)(@@) ( كر ) عن مبارك بن فضالة عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 19330 ) قال النبي :(@)(@@) | 30 ( ما من آدمي إلا وقد أخطأ أو هم بخطيئة غير يحيى بن زكريا لم يهم بخطيئة ولم يعملها ) )(@)(@@) الحكيم ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19331 ) قال النبي :(@)(@@) | 30 ( ما 
ms2084	 من آدمي إلا في رأسه حكمة بيد ملك ، فإذا تواضع رفعه الله ، وإن ارتفع قمعه الله ، والكبرياء رداء الله ، فمن نازع الله قمعه ) )(@)(@@) ابن صصرى في أماليه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19332 ) قال النبي :(@)(@@) | 30 ( ما من آدمي إلا قلبه بين أصبعين من أصابع الرحمان إن شاء أن يزيغه أزاغه ، وإن شاء أن يقيمه أقامه ، وكل يوم الميزان بيد الله ، يرفع أقواما ويضع آخرين إلى يوم القيامة ) )(@)(@@) ( طب ) عن نعيم بن عمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19333 ) قال النبي :(@)(@@) | 30 ( ما من آدمي إلا وفي رأسه سلسلتان : سلسلة في السماء السابعة ، وسلسلة في الأرض السابعة فإذا تواضع رفعه الله بالسلسلة إلى السماء السابعة ، وإذا تجبر وضعه الله بالسلسلة إلى الأرض السابعة ) )(@)(@@) الخرائطي في مساوىء الأخلاق والحسن بن سفيان وابن لال والديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19334 ) قال النبي :(@)(@@) | 30 ( ما من آدمي إلا وفيه عرق من الجذام ، فإذا تحرك ذالك العرق سلط الله عليه الزكام فيسكنه ) )(@)(@@) الديلمي عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19335 ) قال النبي :(@)(@@) | 30 ( ما من آدمي إلا وفي رأسه حكمة بيد ملك ، فإذا تواضع رفعه بها وقال : ارتفع رفعك الله ، وإن رفع نفسه جذبه إلى الأرض وقال : PageV06P365 اخفض خفضك الله ) )(@)(@@) أبو نعيم والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19336 ) قال النبي :(@)(@@) | 30 ( ما من أصحابي إلا وقد كنت قائلا فيه لا بد ، إلا أبا عبيدة ) )(@)(@@) ( كر ) عن أبي بكر الصديق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19337 ) قال النبي :(@)(@@) | 30 ( ما من أصحابي أحد إلا ولو شاء أن أقول في خلقه إلا ما كان من أبي عبيدة بن الجراح ) )(@)(@@) ( كر ) عن محمد بن المنكدر مرسلا وعن داود بن شابور مرسلا .(@)(@@)(@@)(@@) $ ( 19338 ) قال النبي :(@)(@@) | 30 ( ما من أصحابي أحد إلا وقد وجدت عليه ، ولو شئت أن أقول فيه إلا أبو عبيدة بن الجراح ) )(@)(@@) تمام ( كر ) عن سعيد بن عبد العزيز مرسلا .(@)(@@)(@@)(@@) $ ( 19339 ) قال النبي :(@)(@@) | 30 ( ما من أصحابي أحد إلا ولو شئت لأخذت عليه في بعض خلقه غير أبي 
ms2085	 عبيدة بن الجراح ) )(@)(@@) ( ش ك ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 19340 ) قال النبي :(@)(@@) | 30 ( ما من أمتي عبد يعمل حسنة فيعلم أنها حسنة وإن الله عز وجل جازيه بها خيرا ، ولا يعمل بسيئة فيعلم أنها سيئة ويستغفر الله عز وجل منها ، ويعلم أنه لا يغفر الذنوب إلا هو ، إلا هو مؤمن ) )(@)(@@) ( حم طس ) عن أبي رزين العقيلي قال : قلت : يا رسول الله كيف لي بأن أعلم أني مؤمن قال : فذكره حسن .(@)(@@)(@@)(@@) $ ( 19341 ) قال النبي :(@)(@@) | 30 ( ما من أمتي أحد إلا وأنا أعرفه يوم القيامة ، قالوا : يا رسول الله من رأيت ومن لم تر ؟ قال : من رأيت ومن لم أر ، غرا محجلين من آثار الوضوء ) )(@)(@@) ( حم طب ض ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19342 ) قال النبي :(@)(@@) | 30 ( ما من أمتي أحد إلا وأنا أعرفه يوم القيامة ، قالوا : PageV06P366 كيف تعرفهم يا رسول الله في كثرة الخلائق ؟ قال : أرأيت لو دخلت صيرة فيها خيل دهم ، وفيها فرس أغر محجل ، أما كنت تعرفه منها ؟ قالوا : بلى ، قال : فإن أمتي يومئذ غر من السجود ، محجلون من الوضوء ) )(@)(@@) ( حم طب هب ض ) عن عبد الله بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19343 ) قال النبي :(@)(@@) | 30 ( ما من أمتي أحد يكون له ثلاث بنات ، أو ثلاث ءأخوات يعولهن حتى يبن أو يمتن إلا كان معي في الجنة هاكذا ، وجمع بين أصبعيه : السبابة والوسطى ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19344 ) قال النبي :(@)(@@) | 30 ( ما من امرىء من المسلمين يربط فرسا في سبيل الله إلا يكتب له بكل حبة يوافيه بها حسنة ، ويحط عنه بكل حبة سيئة ) )(@)(@@) ( كر ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19345 ) قال النبي :(@)(@@) | 30 ( ما من امرىء مسلم تصيبه مصيبة تحزنه فيرجع إلا قال الله عز وجل لملائكته : أوجعت قلب عبدي فصبر واحتسب ، اجعلوا ثوابه منها الجنة ، وما جعلت مصيبته فرجع إلا جدد الله له أجرا ) )(@)(@@) ( قط ) في الأفراد ( كر ) عن الزهري مرسلا .(@)(@@)(@@)(@@) $ ( 19346 ) قال النبي :(@)(@@) | 30 ( ما من مسلم يتطهر فيتم الطهور الذي كتب الله عليه 
ms2086	 فيصلي هاذه الصلوات الخمس إلا كانت كفارة لما بينهن ) )(@)(@@) ( ه ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19347 ) قال النبي :(@)(@@) | 30 ( ما من امرىء مسلم يركب دابته فيصنع كما صنعت إلا أقبل الله عز وجل عليه فضحك إليه كما ضحكت إليك ) )(@)(@@) ( حم ) عن ابن عباس أن رسول الله أردفه على دابته ، فكبر ثلاثا ، وسبح ثلاثا ، وهلل الله PageV06P367 واحدة ثم ضحك ، ثم أقبل عليه فقال : فذكره .(@)(@@)(@@)(@@) $ ( 19348 ) قال النبي :(@)(@@) | 30 ( ما من امرأتين من المسلمين هلك بينهما ولدان أو ثلاثة فاحتبساه وصبرا فيريان النار أبدا ) )(@)(@@) ابن سعد عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19349 ) قال النبي :(@)(@@) | 30 ( ما من امرأة تقدم ثلاثة من الولد تحتسبهم إلا دخلت الجنة ، قالت امرأة : أو اثنان ، قال : أو اثنان ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19350 ) قال النبي :(@)(@@) | 30 ( ما من امرأة تطيب للمسجد فيقبل الله لها صلاة حتى تغتسل منه اغتسالها للجنابة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19351 ) قال النبي :(@)(@@) | 30 ( ما من أمير ثلاثة إلا يؤتى به يوم القيامة مغلولة يده إلى عنقه ، أطلقه الحق أو أوبقه ) )(@)(@@) ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19352 ) قال النبي :(@)(@@) | 30 ( ما من أمير عشرة إلا يؤتى به يوم القيامة مغلولا يده إلى عنقه ، لا يفكه من غله ذالك إلا العدل ) )(@)(@@) ( ض ش حم ) و عبد بن حميد ( طب هب ) عن سعد بن عبادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19353 ) قال النبي :(@)(@@) | 30 ( ما من امرأة تخرج إلى المسجد يعصف ريحها فيقبل الله عز وجل منها صلاة حتى ترجع إلى بيتها فتغتسل ) )(@)(@@) ( هق كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19354 ) قال النبي :(@)(@@) | 30 ( ما من أمير ولا وال يغلق بابه دون ذوي الخلة والحاجة والمسكنة إلا أغلق الله أبواب السماء دون حاجته وخلته ومسكنته ) )(@)(@@) PageV06P368 ( ع كر ) عن عمرو بن مرة الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19355 ) قال النبي :(@)(@@) | 30 ( ما من أهل بيت لم يغدو عليهم فدان إلا ذلوا ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19356 
ms2087	 ) قال النبي :(@)(@@) | 30 ( ما من أهل بيت تروح عليهم ثلة من الغنم إلا باتت الملائكة تصلي عليهم حتى تصبح ) )(@)(@@) ابن سعد عن أبي ثفال عن خالد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19357 ) قال النبي :(@)(@@) | 30 ( ما من أهل بيت عندهم شاة إلا وفي بيتهم بركة ) )(@)(@@) ابن سعد عن أبي الهيثم بن التيهان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19358 ) قال النبي :(@)(@@) | 30 ( ما من أيام العمل الصالح فيهن أحب إلى الله من عشر ذي الحجة ، قالوا : ولا الجهاد في سبيل الله ، قال : ولا الجهاد في سبيل الله إلا رجل خرج بنفسه وماله فلم يرجع من ذالك بشيء ) )(@)(@@) ( ع ) و أبو عوانة ( حب ض ) عن جابر ( ت ه حب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19359 ) قال النبي :(@)(@@) | 30 ( ما من أيام أحب إلى الله أن يتعبد له فيها من عشر ذي الحجة ، يعدل صيام كل يوم منها بصيام سنة ، وقيام كل ليلة منها بقيام ليلة القدر ) )(@)(@@) ( ت ) غريب ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19360 ) قال النبي :(@)(@@) | 30 ( ما من إنسان يكون في مجلس فيقول حين يريد أن يقوم : سبحانك اللهم وبحمدك ، لا إلاه إلا أنت ، أستغفرك وأتوب إليك إلا غفر له ما كان في ذالك المجلس ) )(@)(@@) ( حم ) و الطحاوي ( طب ض ) عن السائب بن يزيد وعن إسماعيل بن عبد الله بن جعفر رضي الله عنه بلاغا .(@)(@@) PageV06P369(@)(@@)(@@)(@@) $ ( 19361 ) قال النبي :(@)(@@) | 30 ( ما من إنسان يتوب إلى الله عز وجل قبل أن يموت بنصف يوم إلا قبل الله توبته ) )(@)(@@) البغوي عن رجل .(@)(@@)(@@)(@@) $ ( 19362 ) قال النبي :(@)(@@) | 30 ( ما من إنسان يتوب إلى الله عز وجل قبل أن يموت بضحوة إلا قبل الله عز وجل توبته ) )(@)(@@) البغوي عن رجل .(@)(@@)(@@)(@@) $ ( 19363 ) قال النبي :(@)(@@) | 30 ( ما من إنسان يتوب إلى الله عز وجل قبل أن يغرغر بنفسه في سوقه إلا قبل الله توبته ) )(@)(@@) البغوي عن رجل .(@)(@@)(@@)(@@) $ ( 19364 ) قال النبي :(@)(@@) | 30 ( ما من إنسان أعظم أجرا من وزير صالح مع إمام يأمره بذات الله عز وجل فيطيعه ) )(@)(@@) ابن النجار عن 
ms2088	 عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19365 ) قال النبي :(@)(@@) | 30 ( ما من أهل الجنة أحد يسره أن يرجع إلى الدنيا وله عشر أمثالها إلا الشهيد فإنه يود أنه يرد إلى الدنيا عشر مرات فاستشهد لما رأى من الفضل ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19366 ) قال النبي :(@)(@@) | 30 ( ما من أيام العمل الصالح فيها أحب إلى الله من هاذه الأيام يعني أيام العشر قالوا : يا رسول الله ولا الجهاد في سبيل الله ؟ قال : ولا الجهاد في سبيل الله ، إلا رجل خرج بنفسه وماله ثم لم يرجع من ذالك بشيء ) )(@)(@@) ( حم خ ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19367 ) قال النبي :(@)(@@) | 30 ( ما من أيام أفضل فيهن من هاذه العشر ، قالوا : يا رسول الله ولا الجهاد ؟ قال : ولا الجهاد ، إلا أن يخرج رجل بنفسه وماله في سبيل الله ، ثم يكون مبهجة نفسه فيه ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19368 ) قال النبي :(@)(@@) | 30 ( ما من أيام الدنيا أحب إلى الله أن يتعبد له PageV06P370 فيها من أيام العشر ، يعدل صيام كل يوم منها بصيام سنة ، وقيام كل ليلة بقيام ليلة القدر ) )(@)(@@) ابن أبي الدنيا في فضل عشر ذي الحجة ( هب خط ) وابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19369 ) قال النبي :(@)(@@) | 30 ( ما من أيام العمل فيهن أفضل من أيام العشر ، قيل : ولا الجهاد في سبيل الله ؟ قال : ولا الجهاد في سبيل الله ، إلا من عقر جواده ، واهريق دمه ) )(@)(@@) ( طب حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19370 ) قال النبي :(@)(@@) | 30 ( ما من أيام أعظم عند الله ولا أحب إليه العمل فيهن من أيام العشر ، فأكثروا فيهن من التسبيح والتحميد والتكبير والتهليل ) )(@)(@@) ( طب ) عن ابن عباس ، ( حم ) وابن أبي الدنيا في فضل عشر ذي الحجة ، ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19371 ) قال النبي :(@)(@@) | 30 ( ما من أيام أحب إلى الله العمل فيهن من هاذه الأيام ، قيل : ولا الجهاد في سبيل الله ؟ قال : ولا الجهاد في سبيل الله ، إلا من خرج 
ms2089	 بنفسه وماله ثم لم يرجع حتى يهراق دمه ) )(@)(@@) ( حم ) و ابن أبي الدنيا في فضل عشر ذي الحجة ، ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19372 ) قال النبي :(@)(@@) | 30 ( ما من أيام أفضل عند الله ، ولا العمل فيهن أحب إلى الله تعالى من هاذه الأيام العشر ، فأكثروا فيهن من التهليل والتكبير وذكر الله ، وإن صيام يوم منها يعدل بصيام سنة ، والعمل فيهن يضاعف سبعمائة ضعف ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19373 ) قال النبي :(@)(@@) | 30 ( ما من أيام أفضل عند الله من أيام عشر ذي PageV06P371 الحجة ، قالوا : يا نبي الله ولا مثلها في سبيل الله ؟ قال : ولا مثلها في سبيل الله إلا من عفر وجهه في التراب ) )(@)(@@) ابن أبي الدنيا عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19374 ) قال النبي :(@)(@@) | 30 ( ما من أيام أفضل عند الله من أيام عشر ذي الحجة ، هي أفضل من عدتهن جهاد في سبيل الله إلا من عفر الغفر في التراب ، وما من يوم أفضل عند الله من يوم عرفة ، ينزل الله تبارك وتعالى إلى السماء فيباهي بأهل الأرض أهل السماء ، فيقول : انظروا إلى عبادي شعثا غبرا ضاحين جاؤوا من كل فج عميق يرجون رحمتي ، ولم يروا عذابي فلم ير يوم أكثر عتيقا من النار من يوم عرفة ) )(@)(@@) ( ع حب ) و ابن صصرى في أماليه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19375 ) قال النبي :(@)(@@) | 30 ( ما من بقعة يذكر الله تعالى فيها بصلاة إلا فخرت على ما حولها من البقاع واستبشرت لذكر الله ، منتهاها إلى سبع أرضين ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19376 ) قال النبي :(@)(@@) | 30 ( ما من بقعة يذكر اسم الله فيها إلا استبشرت بذكر الله إلى منتهاها من سبع أرضين وفخرت على ما حولها من البقاع ، وما من مؤمن يقوم بفلاة من الأرض إلا تزخرفت به الأرض ) )(@)(@@) ابن شاهين في الترغيب في الذكر عن أنس وفيه موسى بن عبيدة الربذي عن يزيد الرقاشي ضعيفان .(@)(@@)(@@)(@@) $ ( 19377 ) قال النبي :(@)(@@) | 30 ( ما من ثلاثة في قرية 
ms2090	 ولا بدو لا تقام فيهم الجماعة إلا استحوذ عليهم الشيطان ) )(@)(@@) ( د ن حب ك ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19378 ) قال النبي :(@)(@@) | 30 ( ما من خارج يخرج إلا ببابه رايتان : راية بيد ملك ، وراية بيد شيطان ، فإن خرج فيما يحب الله عز وجل تبعه الملك برايته ، فلم يزل تحت راية الملك حتى يرجع إلى بيته ، وإن خرج فيما يسخط الله تبعه PageV06P372 الشيطان برايته فلم يزل تحت راية الشيطان حتى يرجع إلى بيته ) )(@)(@@) ( حم طس هق ) في الزهد عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19379 ) قال النبي :(@)(@@) | 30 ( ما من خمسة أهل أبيات لا يؤذن فيهم بالصلاة وتقام فيهم الصلاة إلا استحوذ عليهم الشيطان ) )(@)(@@) ( حم طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19380 ) قال النبي :(@)(@@) | 30 ( ما من ثلاثة في بدو ولا حضر لا يقيمون الصلاة إلا كان الشيطان رابعهم ) )(@)(@@) ( كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19381 ) قال النبي :(@)(@@) | 30 ( ما من خطوة أعظم أجرا من خطوة مشاها رجل إلى صف بسده ) )(@)(@@) ابن الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19382 ) قال النبي :(@)(@@) | 30 ( ما من داع يدعو إلى هدى إلا كان له أجره وأجور من تبعه لا ينقص ذالك من أجورهم شيئا ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19383 ) قال النبي :(@)(@@) | 30 ( ما من دعاء إلا بينه وبين السماء حجاب حتى يصلى على النبي وعلى آله ، فإذا فعل ذالك انخرق ذالك الحجاب ودخل الدعاء ، وإذا لم يفعل ذالك رجع الدعاء ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19384 ) قال النبي :(@)(@@) | 30 ( ما من دعوة أحب إلى الله أن يدعوه بها عبد من أن يقول : اللهم أني أسألك المعافاة في الدنيا والآخرة ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19385 ) قال النبي :(@)(@@) | 30 ( ما من ذكر ولا أنثى إلا وعلى رأسه جرير معقود ثلاث عقد حين يرقد : فإن استيقظ فذكر الله انحلت عقدة ، وإذا قام فتوضأ انحلت PageV06P373 عقدة ، وإذا أتى الصلاة انحلت عقده كلها ) )(@)(@@) ( حم ) و الشاشي وابن نصر وابن 
ms2091	 خزيمة ( حب ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19386 ) قال النبي :(@)(@@) | 30 ( ما من ذي رحم يأتي ذا رحمه فيسأله فضلا أعطاه الله إياه فيبخل عليه إلا أخرج الله له يوم القيامة من جهنم حية يقال لها شجاع يتلمظ فيطوق به ) )(@)(@@) ( طب طس ) عن جرير بن جرير عن رجل .(@)(@@)(@@)(@@) $ ( 19387 ) قال النبي :(@)(@@) | 30 ( ما من رجل يدعو بهاذا الدعاء في أول نهاره إلا عصمه الله من إبليس وجنوده : بسم الله ذي الشأن ، عظيم البرهان ، شديد السلطان ، ما شاء الله كان ، أعوذ بالله من الشيطان ) )(@)(@@) ( ك ) في تايخه ( كر ) عن الزبير بن العوام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19388 ) قال النبي :(@)(@@) | 30 ( ما من رجل يشهد أن لا إلاه إلا الله إلا دخل الجنة وإن زنى وإن سرق ورغم أنف أبي الدرداء ) )(@)(@@) ( حم ) و مسدد ( ع حب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19389 ) قال النبي :(@)(@@) | 30 ( ما من رجل يستيقظ من الليل فيوقظ امرأته ، فإن غلبها النوم نضح في وجهها من الماء فيقومان في بيتهما فيذكران الله ساعة من الليل إلا غفر لهما ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19390 ) قال النبي :(@)(@@) | 30 ( ما من رجل يتوضأ فيحسن الوضوء ثم يصلي إلا غفر الله له ما بينه وبين الصلاة الأخرى حتى يصليها ) )(@)(@@) ( ش هق ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19391 ) قال النبي :(@)(@@) | 30 ( ما من رجل مسلم يتطهر فيحسن الطهور ثم يقوم PageV06P374 إلى الصلاة إلا كانت صلاته تلك كفارة لما قبلها من الخطايا ) )(@)(@@) ( هب ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19392 ) قال النبي :(@)(@@) | 30 ( ما من رجل يصوم يوما في سبيل الله إلا باعده الله من النار مقدار مائة عام ) )(@)(@@) ( سمويه طب ض ) عن عبد الله بن سفيان الأزدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19393 ) قال النبي :(@)(@@) | 30 ( ما من رجل يعلم كلمة أو كلمتين أو ثلاثا أو أربعا أو خمسا مما فرض الله تعالى ورسوله فيتعلمهن ويعلمهن إلا دخل الجنة ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19394 ) قال النبي :(@)(@@) | 30 
ms2092	 ( ما من رجل يكون في قوم يعمل بمعاصي الله فيهم وهم أكثر وأعز ثم يدهنوا في شأنه إلا عاقبهم الله ) )(@)(@@) ( طب حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19395 ) قال النبي :(@)(@@) | 30 ( ما من رجل ولي عشرة إلا أتي به يوم القيامة مغلولة يده إلى عنقه حتى يقضى بينه وبينهم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19396 ) قال النبي :(@)(@@) | 30 ( ما من رجل ينتبه من نومه فيقول : الحمد لله الذي خلق النوم واليقظة ، الحمد لله الذي بعثني سالما سويا ، أشهد أن الله يحيي الموتى وهو على كل شيء قدير إلا قال الله صدق عبدي ) )(@)(@@) ابن السدي والديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19397 ) قال النبي :(@)(@@) | 30 ( ما من رجل يكون بأرض فيء فيؤذن بحضرة الصلاة ، ويقيم الصلاة إلا صلى خلفه من الملائكة ما لا يرى قطراه ، يركعون بركوعه ، ويسجدون بسجوده ، ويؤمنون على دعائه ) )(@)(@@) ( هق ) عن سل مان مرفوعا وموقوفا قال : والصحيح موقوف .(@)(@@) PageV06P375(@)(@@)(@@)(@@) $ ( 19398 ) قال النبي :(@)(@@) | 30 ( ما من رجل يكون على الناس فيقوم على رأسه الرجال يحب أن يكثر الخصوم عنده فيدخل الجنة ) )(@)(@@) ( ك ) و أبو سعيد النقاش في القضاة عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19399 ) قال النبي :(@)(@@) | 30 ( ما من رجل يتوضأ فيحسن الوضوء ثم يأتي مسجدا من المساجد فيخطو خطوة إلا رفع بها درجة ، وحط عنه بها خطيئة أو كتب له بها حسنة ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19400 ) قال النبي :(@)(@@) | 30 ( ما من رجل يموت وفي قلبه مثقال حبة من خردل من كبر يحل له الجنة أن يريح ريحها أو يراها ، قال رجل : إني أحب الجمال حتى في علاقة سوطي ، وشراك نعلي ، قال : ليس ذالك الكبر ، إن الله جميل يحب الجمال ، ولاكن الكبر من سفه الحق ، وغمط الناس بعينيه ) )(@)(@@) ( حم ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19401 ) قال النبي :(@)(@@) | 30 ( ما من رجل يكون له ساعة من الليل يقومها فينام إلا كتب له أجر صلاته ، وكان نومه عليه صدقة يصدق بها عليه 
ms2093	 ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19402 ) قال النبي :(@)(@@) | 30 ( ما من رجل يحسن الوضوء فيغسل يديه ورجليه ووجهه ثم يمضمض فاه ثم يتوضأ كما أمره الله تعالى إلا حط عنه عمل يومه ، ما نطق فوه ، ومشى إليه ، حتى إن الذنوب لتتجاذب من أطرافه ، ثم إذا مشى إلى المسجد كانت له بكل خطوة يخطوها حسنة ، ثم تكون صلاته له نافلة ثم إذا هو دخل على أهله فسلم عليهم وأخذ مضجعه كانت له قيام ليلته ) )(@)(@@) ابن السني عن أبي أمامة رضي الله عنه .(@)(@@) PageV06P376(@)(@@)(@@)(@@) $ ( 19403 ) قال النبي :(@)(@@) | 30 ( ما من رجل يعود مريضا فيجلس عنده إلا غشيته الرحمة من كل جانب ما جلس عنده فإذا خرج من عنده كتب له أجر صيام يوم ) )(@)(@@) ( عق ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19404 ) قال النبي :(@)(@@) | 30 ( ما من رجل يموت فيدع إبلا أو بقرا أو غنما لا يؤدي زكاتها إلا جاءت يوم القيامة أسمن ما كانت وأعظم فتنطحه بقرونها ، وتطؤه بأخفافها حتى يقضي بين الناس ، كلما نفذت أخراها عادت عليه أولاها ) )(@)(@@) العسكري في المواعظ عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19405 ) قال النبي :(@)(@@) | 30 ( ما من رجل يغبار وجهه في سبيل الله إلا أمن الله تعالى وجهه يوم القيامة ، وما من رجل يغبار قدماه في سبيل الله إلا أمن الله قدميه من النار يوم القيامة ) )(@)(@@) ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19406 ) قال النبي :(@)(@@) | 30 ( ما من رجل مسلم يقرأ بعد صلاة الصبح ب { قل هو الله أحد } إحدى عشرة مرة يكررهن إلا بنى الله له برجا في الجنة ) )(@)(@@) الخرائطي في مكارم الأخلاق عن أبي عبد الرحمان السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19407 ) قال النبي :(@)(@@) | 30 ( ما من رجل كان يصلي صلاة الضحى ثم تركها إلا عرج بها إلى الله عز وجل فقالت : يا رب إن فلانا حفظني فاحفظه ، وإن فلانا ضيعني فضيعه ) )(@)(@@) أبو بكر الشافعي والديلمي عن سمحج الجني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19408 ) قال النبي :(@)(@@) | 30 ( ما من رجل يزور قبر حميمه فيسلم 
ms2094	 عليه ويقعد عنده إلا رد عليه السلام وأنس به حتى يقوم من عنده ) )(@)(@@) أبو الشيخ والديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19409 ) قال النبي :(@)(@@) | 30 ( ما من رجل يقول إذا ركب السفينة : بسم الله الملك PageV06P377 الرحمان الرحيم { بسم الله مجراها ومرساها إن ربي لغفور رحيم ، وما قدروا الله حق قدره } ، الآية . إلا أعطاه الله أمانا من الغرق حتى يخرج منها ) )(@)(@@) أبو الشيخ عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19410 ) قال النبي :(@)(@@) | 30 ( ما من رجل يصلي ثنتي عشرة ركعة غير الفريضة إلا بنى الله له بيتا في الجنة ) )(@)(@@) ( حب ) عن أم حبيبة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19411 ) قال النبي :(@)(@@) | 30 ( ما من رجل يتوضأ في بيته ثم يخرج يريد الصلاة إلا كان في صلاة حتى يقضي صلاته فلا يشبك من أصابعه في الصلاة ) )(@)(@@) ( عب ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19412 ) قال النبي :(@)(@@) | 30 ( ما من رجل يحم فيغتسل ثلاثة أيام متتابعة يقول عند كل غسل : باسم الله ، اللهم إني إنما أغتسل التماس شفائك ، وتصديق نبيك إلا ، كشف عنه ) )(@)(@@) ( ش ) عن مكحول رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19413 ) قال النبي :(@)(@@) | 30 ( ما من رجل يريد أن يقوم ساعة من الليل فتغلبه عيناه عنها إلا كتب الله له أجرها ، وكان نومه صدقة تصدق الله بها عليه ) )(@)(@@) ( عب ) عن أبي هريرة ، ( عب ) عن أبي الدرداء وأبي ذر رضي الله عنهم موقوفا .(@)(@@)(@@)(@@) $ ( 19414 ) قال النبي :(@)(@@) | 30 ( ما من رجل كان يمر بقبر كان يعرفه في الدنيا فسلم عليه إلا عرفه ورد عليه ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19415 ) قال النبي :(@)(@@) | 30 ( ما من رجلين تحابا في الله تعالى بظهر الغيب إلا كان أحبهما إلى الله أشدهما حبا لصاحبه ) )(@)(@@) ( حب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19416 ) قال النبي :(@)(@@) | 30 ( ما يحق الإسلام بحق الشيخ ) )(@)(@@) ( ش ) و الحكيم PageV06P378 ( ع ) وابن مردويه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19417 ) قال النبي :(@)(@@) | 30 ( ما من الصلوات صلاة أفضل من صلاة الفجر يوم الجمعة في الجماعة ، وما 
ms2095	 أحسب من شهدها منكم إلا مغفورا له ) )(@)(@@) ( طب طس ) و أبو نعيم في المعرفة عن أبي عبيدة بن الجراح رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19418 ) قال النبي :(@)(@@) | 30 ( ما من الناس أمن في صحبته وذات يده من ابن أبي قحافة ، فلو كنت متخذا خليلا لاتخذت ابن أبي قحافة ، ولاكن ود وإخاء وإيمان ، وإن صاحبكم خليل الله ) )(@)(@@) ابن السني في عمل يوم وليلة عن ابن المعلى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19419 ) قال النبي :(@)(@@) | 30 ( ما من رجل من المسلمين يرمي بسهم في العدو أصاب أو أخطأ إلا كان له أجر ذالك السهم كعدل نسمة ) )(@)(@@) عبد بن حميد وابن عساكر عن محمد بن سعد بن أبي وقاص عن أبيه .(@)(@@)(@@)(@@) $ ( 19420 ) قال النبي :(@)(@@) | 30 ( ما من رجل من المسلمين ابيضت شعرة منه في سبيل الله إلا كانت له نورا يوم القيامة يسعى بين يديه ومن خلفه ) )(@)(@@) عبد بن حميد وابن عساكر عن محمد بن سعد بن أبي وقاص عن أبيه .(@)(@@)(@@)(@@) $ ( 19421 ) قال النبي :(@)(@@) | 30 ( ما من رجل من المسلمين أعتق صغيرا أو كبيرا إلا كان حقا على الله أن يجزيه بكل عضو منه أضعاف مضاعفة ) )(@)(@@) عبد بن حميد وابن عساكر عن محمد بن سعد بن أبي وقاص عن أبيه .(@)(@@)(@@)(@@) $ ( 19422 ) قال النبي :(@)(@@) | 30 ( ما من شاب يدع لذة الدنيا ولهوها ، ويستقبل بشبابه طاعة الله إلا أعطاه أجر اثنتين وسبعين صديقا ثم يقول الله : أيها الشاب التارك شهوته في ، المسدل شبابه لي ، أنت عندي كبعض ملائكتي ) )(@)(@@) ( حل ) الحسن بن سفيان عن شريح قال : حدثني البدريون منهم عمر رضي الله عنهم .(@)(@@) PageV06P379(@)(@@)(@@)(@@) $ ( 19423 ) قال النبي :(@)(@@) | 30 ( ما من شيء يصيب من زرع أحدكم ولا ثمره من طير ولا سبع إلا وله فيه أجر ) )(@)(@@) الحسن بن سفيان والبغوي والباوردي ( طب ) وأبو نعيم ( ض ) عن خلاد بن السائب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19424 ) قال النبي :(@)(@@) | 30 ( ما من شيء أكرم على الله يوم القيامة من ابن آدم ، قيل : يا رسول الله ولا الملائكة ؟ قال : ولا الملائكة ، لأن الملائكة هم مجبورون ، هم بمنزلة 
ms2096	 الشمس والقمر ) )(@)(@@) ( طب ) و الخطيب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19425 ) قال النبي :(@)(@@) | 30 ( ما من شيء تحضره الملائكة من اللهو إلا ثلاثة : الرجل مع امرأته ، وإجراء الخيل والنصال ) )(@)(@@) الحاكم في الكنى ا عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19426 ) قال النبي :(@)(@@) | 30 ( ما من شيء عصي الله به وهو أعجل عقابا من البغي ، وما من شيء أطيع الله فيه أسرع ثوابا من الصلة ، واليمين الفاجرة تدع الديار بلاقع ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19427 ) قال النبي :(@)(@@) | 30 ( ما من شيء أحب إلى الله من شاب تائب ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19428 ) قال النبي :(@)(@@) | 30 ( ما من صاحب إبل إلا يؤتى به يوم القيامة إذا لم يكن يؤدي حقها فتمشي عليه بقاع تطؤه بأخفافها ، ويؤتى بصاحب البقر إذا لم يكن يؤدي حقها فتمشي عليه بقاع تطؤه بأظلافها وتنطحه بقرونها ، ويؤتى بصاحب الغنم إذا لم يؤدي حقها فتمشي عليه بقاع فتنطحه بقرونها وتطؤه بأظلافها ليس فيها جماء ولا مكسورة القرن ، ويؤتى بصاحب الكنز فيمثل له شجاعا أقرع فلا تجد شيئا فيدخل يده في فيه ) )(@)(@@) ( طب ) عن ابن الزبير رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19429 ) قال النبي :(@)(@@) | 30 ( ما من صباح إلا وملكان يناديان ، يقول أحدهما : PageV06P380 اللهم أعط منفقا خلفا ، ويقول الآخر : اللهم أعط ممسكا تلفا ، وملكان موكلان بالصور ينتظران متى يؤمران فينفخان ، وملكان يناديان يقول أحدهما : يا باغي الخير هلم ، ويقول الآخر : يا باغي االشر أقصر ، وملكان يناديان يقول أحدهما : ويل للرجال من النساء ، ويقول الآخر : ويل للنساء من الرجال ) )(@)(@@) ( ك ) وتعقب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19430 ) قال النبي :(@)(@@) | 30 ( ما من صدقة أفضل من صدقة تصدق بها على مملوك عند مليك سوء ) )(@)(@@) الحكيم والشيرازي في الألقاب ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19431 ) قال النبي :(@)(@@) | 30 ( ما من صدقة يتصدق بها رجل على أخيه أفضل من علم يعلمه إياه ) )(@)(@@) ابن النجار من طريق أبي بكر بن أبي مريم عن راشد بن سعد وحبيب بن 
ms2097	 عبيد وضمرة بن حبيب مرسلا .(@)(@@)(@@)(@@) $ ( 19432 ) قال النبي :(@)(@@) | 30 ( ما من صوت أحب إلى الله من صوت عبد لهفان ، عبد أصاب ذنبا كلما ذكر ذنبه امتلأ قلبه فرقا من الله فقال : يا رباه ) )(@)(@@) الحكيم ( حل ) والديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19433 ) قال النبي :(@)(@@) | 30 ( ما من عام بأمطر من عام ) )(@)(@@) أبو نعيم عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19434 ) قال النبي :(@)(@@) | 30 ( ما من عبد يسجد لله سجدة إلا كتب الله له بها حسنة وحط عنه بها خطيئة ) )(@)(@@) ( كر ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19435 ) قال النبي :(@)(@@) | 30 ( ما من عبد أتى أخا له يزوره في الله إلا نادى مناد من السماء : أن طبت وطابت لك الجنة ، وإلا قال الله عز وجل في ملكوت عرشه : عبي زارني وعلي قراه ، ولن يرضى الله لعبده بقرى دون الجنة ) )(@)(@@) ( ع حل ) و ابن النجار ( ض ) عن أنس رضي الله عنه .(@)(@@) PageV06P381(@)(@@)(@@)(@@) $ ( 19436 ) قال النبي :(@)(@@) | 30 ( ما من عبد يقول حين يتوضأ : بسم الله ، ثم يقول لكل عضو أشهد أن لا إلاه إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله ، ثم يقول حين يفرغ : اللهم اجعلني من التوابين واجعلني من المتطهرين إلا فتحت له ثمانية أبواب الجنة يدخل من أيها شاء ، فإن قام من فوره ذالك فصلى ركعتين يقرأ فيهما ما يقول ، انفتل من صلاته كيوم ولدته أمه ، ثم يقال له : استأنف العمل ) )(@)(@@) المستغفري في الدعوات وقال : حسن غريب عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19437 ) قال النبي :(@)(@@) | 30 ( ما من عبد يحب الله ورسوله إلا الفقر يسرع إليه من جره السيل على وجهه ، ومن أحب الله ورسوله فليعد للبلاء تجفافا ) )(@)(@@) ( هق كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19438 ) قال النبي :(@)(@@) | 30 ( ما من عبد يدخل الجنة إلا يجلس عند رأسه وعند رجليه ثنتان من الحور العين تغنيانه بأحسن صوت سمعت الجن والإنس ، وليس بمزامير الشيطان ولاكن بتحميد الله وتقديسه ) )(@)(@@) ( طب ) و أبو نصر السجزي في الإبانة ( كر ) عن 
ms2098	 أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19439 ) قال النبي :(@)(@@) | 30 ( ما من عبد يصرع صرعة من مرض إلا بعثه الله منها طاهرا ) )(@)(@@) ( طب وسمويه كر ض ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19440 ) قال النبي :(@)(@@) | 30 ( ما من عبد يحدث نفسه بقيام ساعة من الليل فنام عنها إلا كان نومه عليه صدقة تصدق الله بها عليه ، وكتب له أجر ما نوى ) )(@)(@@) ( حب ) عن أبي ذر وأبي الدرداء رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19441 ) قال النبي :(@)(@@) | 30 ( ما من عبد يموت فيترك أصفر أو أبيض إلا كوي به ) )(@)(@@) ( كر ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19442 ) قال النبي :(@)(@@) | 30 ( ما من عبد استرعاه الله رعية فلم يحطها بنصيحة PageV06P382 إلا حرم الله عليه الجنة ) )(@)(@@) ( كر ) عن عبد الرحمن بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19443 ) قال النبي :(@)(@@) | 30 ( ما من عبد يقول : لا إلاه إلا الله والله أكبر إلا أعتق الله ربعه من النار ، ولا يقولها اثنتين إلا أعتق الله شطره من النار ، ولا يقولها أربعا إلا أعتقه الله من النار ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19444 ) قال النبي :(@)(@@) | 30 ( ما من عبد يخرج من بيته إلى غدو أو رواح إلى المسجد إلا كانت خطاه خطوة كفارة ، وخطوة حسنة ) )(@)(@@) ( حم طب ) عن عتبة بن عبد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19445 ) قال النبي :(@)(@@) | 30 ( ما من عبد يقول حين ترد إليه روحه لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير ، إلا غفر الله له ذنوبه ولو كانت مثل زبد البحر ) )(@)(@@) ابن السني عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19446 ) قال النبي :(@)(@@) | 30 ( ما من عبد ولا أمة ينام فيمتلىء نوما إلا عرج بروحه إلى العرش ، فالذي لا يستيقظ دون العرش فتلك الرؤيا التي تصدق ، والذي يستيقظ دون العرش فتلك الرؤيا التي تكذب ) )(@)(@@) ( طس ك ) وتعقب .(@)(@@)(@@)(@@) $ ( 19447 ) قال النبي :(@)(@@) | 30 ( ما من عبد إلا في رأسه حكمة بيد ملك ، فإن تواضع رفع بها نفسه وقال : ارتفع رفعك الله ، وإن 
ms2099	 رفع نفسه جذبه إلى الأرض وقال : انخفض خفضك الله ) )(@)(@@) ابن صصرى في أماليه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19448 ) قال النبي :(@)(@@) | 30 ( ما من عبد يقوم في الدنيا مقام سمعة ورياء إلا سمع الله به على رؤوس الخلائق يوم القيامة ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19449 ) قال النبي :(@)(@@) | 30 ( ما من عبد ينصب وجهه إلى الله في مسألة إلا أعطاه الله إياها ، إما أن يعجلها ، وإما أن يدخرها له في الآخرة ما لم يعجل PageV06P383 بقول : قد دعوت ودعوت فلا أراه يستجاب لي ) )(@)(@@) ( ك هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19450 ) قال النبي :(@)(@@) | 30 ( ما من عبد يصاب بمصيبة فيقول : إنا ل| له وإنا إليه راجعون ، اللهم عندك أحتسب مصيبتي فأجرني فيها وأعقبني منها خيرا إلا أعطاه الله ذالك ) )(@)(@@) ( ط حم حل ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19451 ) قال النبي :(@)(@@) | 30 ( ما من عبد يصاب بمصيبة فيفزع إلى ما أمره الله به من قول : إنا ل| له وإنا إليه راجعون ،(@)(@@) $ 40 ( اللهم آجرني في مصيبتي ه ذه وعوضني خيرا منها إلا آجره الله في مصيبته وكان قمنا من ) 40(@)(@@) | اللهم آجرني في مصيبتي هاذه وعوضني خيرا منها إلا آجره الله في مصيبته وكان قمنا من أن يعوضه الله خيرا منها ) )(@)(@@) ابن سعد عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19452 ) قال النبي :(@)(@@) | 30 ( ما من عبد أذن في أرض قي فيبقى شجر ولا مدر ولا سراب ولا شيء إلا استجلاه البكاء لقلة ذكر الله في ذالك المكان ) )(@)(@@) سمويه والديلمي عن أبي برزة الأسلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19453 ) قال النبي :(@)(@@) | 30 ( ما من عبد يتوضأ إلا خرت خطاياه من يديه ، ثم يغسل وجهه إلا خرت خطاياه من وجهه ، ثم يغسل ذراعيه إلا خرت خطاياه من ذراعيه ، ثم يمسح رأسه إلا خرت خطاياه من رأسه ، ثم يغسل رجليه إلا خرت خطاياه من رجليه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19454 ) قال النبي :(@)(@@) | 30 ( ما من عبد يسجد فيقول : رب اغفر 
ms2100	 لي ثلاث مرات إلا غفر له قبل أن يرفع رأسه ) )(@)(@@) ( طب ) عن أبي مالك الأشجعي عن أبيه .(@)(@@)(@@)(@@) $ ( 19455 ) قال النبي :(@)(@@) | 30 ( ما من عبد يقرأ سورة من كتاب الله إلا وكل الله عز PageV06P384 وجل به ملكا لا يضره شيء حتى يهب متى هب ) )(@)(@@) ( هب ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19456 ) قال النبي :(@)(@@) | 30 ( ما من عبد يحسن وضوءه ويكمله ، ثم يخرج إلى صلاة الظهر حين يؤذن لها فيكمل ركوعها وسجودها وخشوعها إلا كفرت ما كان قبلها وما هو كائن بعدها في ذالك اليوم ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19457 ) قال النبي :(@)(@@) | 30 ( ما من عبد يسلم علي عند قبري إلا وكل الله بها ملكا يبلغني وكفي أمر آخرته ودنياه ، وكنت له شهيدا وشفيعا يوم القيامة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19458 ) قال النبي :(@)(@@) | 30 ( ما من عبد ينعم الله عليه نعمة فيحمد الله إلا كان الحمد أفضل منها ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19459 ) قال النبي :(@)(@@) | 30 ( ما من عبد يلقى الله لا يشرك به شيئا لم يتند بدم حرام إلا دخل الجنة من أي أبواب الجنة شاء ) )(@)(@@) ( هب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19460 ) قال النبي :(@)(@@) | 30 ( ما من عبد يقول لا إلاه إلا الله مائة مرة إلا بعثه الله عز وجل يوم القيامة كالقمر ليلة البدر ، ولم يرفع لأحد يومئذ عمل أفضل من عمله إلا من قال مثل قوله أو زاد عليه ) )(@)(@@) أبو الشيخ والديلمي عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19461 ) قال النبي :(@)(@@) | 30 ( ما من عبد يصلي علي صلاة إلا عرج بها ملك حتى يجيء بها وجه الرحمان فيقول الله عز وجل : اذهبوا بها إلى قبر عبدي يستغفر لقائلها وتقر بها عينه ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 19462 ) قال النبي :(@)(@@) | 30 ( ما من عبد يصلي الفجر ثم يقول حين ينصرف : لا PageV06P385 حول ولا قوة إلا بالله ، ولا حيلة ولا احتيال ولا منجا ولا ملجأ من الله 