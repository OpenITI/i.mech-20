ms161	 جنة % % محفوفة بالروح والريحان % % 20(@)(@@) % فرد من الأفراد بين رجاله % % لم يختصم بكماله إثنان % % PageV01P501 21(@)(@@) % تعم المشير عليه في آرائه % % الصادق العرفات في الثوران % % 22(@)(@@) % ما حل في بلد وآب لمنزل % إلا وآمنها من الحدثان % % 23(@)(@@) % لا تعجبن لنامق في فتكه % % ليث الحروب وفارس الفرسان % % 24(@)(@@) % تروي صوارمه الفخار عن الوغى % % لا عن فلان حديثها % % 25(@)(@@) % يفتضها بالمشرفية والقنا % % بكرا من الهيجاء غير عوان % % 26(@)(@@) % ولربما أغنته شدة بأسه % % عن كل هندي وكل يماني % % 27(@)(@@) % أعيان من رفع الوزارة شأنها % % ألفته عين أؤلئك العيان % % 28(@)(@@) % يا أيها الركن الأشد لدولة % % بنيت قواعدها على أركان % % 29(@)(@@) % دارت بشانيها رحى تدميرها % % فكأنها الأفلاك بالدوران % % 30(@)(@@) % أحكمتها بالصدق منك مبانيا % في غاية الإحكام والإتقان % % PageV01P502 31(@)(@@) % فحظيت من ملك الزمان بما به % % فخر على الأمثال والأقران % % 32(@)(@@) % ولقد بلغت من العناية مبلغا % يسمو برتبتها على كيوان % % 33(@)(@@) % سست العراق سياسة ملكية % % ما ساسها ذو التاج نوشروان % % 34(@)(@@) % وسعت كل الضيق من أحوالها % % حتى من الطرقات والبنيان % % 35(@)(@@) % قربت أرباب الصلاح بأسرهم % % ومحوت أهل البغي والعصيان % % 36(@)(@@) % وكذا الهماوند الذين تنمروا % % وتمردوا بالظلم والعدوان % % 37(@)(@@) % دمرتهم لما علمت فسادهم % % وضرارهم بالأهل والأوطان % % 38(@)(@@) % خلعوا من السلطان طاعته التي % % في غيرها نزع من الشيطان % % 39(@)(@@) % لله درك من حكيم عارف % % إن الحسام دواء داء الجاني % % 40(@)(@@) % جردت من همم الرئيس مهندا % % ما أغمدته القين في الأجفان % % PageV01P503 41(@)(@@) % وعلمت ما في بأسه من شدة % مع أنه في لطفه روحاني % % 42(@)(@@) % لباك حين دعوته لقتالهم % % لا بالبطيء لها ولا المتواني % % 43(@)(@@) % فمضى بأعناق العصاة غراره % والسيف لم يقطع بكف جبان % % 44(@)(@@) % فكسا به منطيب ذاتك نفخة % % عطرية الأنفاس والأردان % % 45(@)(@@) % هنيت بالولد الجميل ونيله % رتب العلى من حضرة السلطان % % 46(@)(@@) % أضحى أمير لوائه في عسكر % % لا زال منصورا مدى الأزمان % % 47(@)(@@) % وبما حباك الله في تأييده % % والفخر في نيشانك العثماني % % 48(@)(@@) % لاحت أشعته عليك لجوهر % % كالنجم بل كالشمس في اللمعان % % 49(@)(@@) % هذا محل الافتخار فدم به % % بالعز والتمكين 
ms162	 والإمكان % % 50(@)(@@) % فرن المؤيد جوهرا في جوهر % فرأت به بغداد سعد قران % % PageV01P504 51(@)(@@) % فرح على فرح يدوم سروره % % تجلو القلوب به من الأحزان % % PageV01P505 البحر : خفيف تام 1(@)(@@) % هذه الدار ما عسى أن تكونا % % فاقض فيها لها عليك ديونا % % 2(@)(@@) % كان عهدي بها ومن كان فيها % % أشرقت أوجها ولانت غصونا % % 3(@)(@@) % يا ديارا عهدتها قبل هذا % % جنة أزلفت وحورا وعينا % % 4(@)(@@) % كنت للشادن الأغن كناسا % مثلما كنت للهزير عرينا % % 5(@)(@@) % قد وقفنا على بقايا رسوم % دراسات كأسطر قد محينا % % 6(@)(@@) % فبذلنا لها ذخائر دمع % كان لولا الوقوف فيها مصونا % % 7(@)(@@) % ذكرتنا الهوى وعهد التصابي % % فذكرنا من عهدها ما نسينا % % 8(@)(@@) % هل عجبتم والحب أمر عجيب % كيف يستعذب العذاب المهينا % % 9(@)(@@) % أو سألتم بعد النوى عن فؤادي % % فسلوا الظاعنين والنازحينا % % 10(@)(@@) % وبنفسي أحبة يوم بانوا % % حرموا النوم أن يمس الجفونا % % PageV01P506 11(@)(@@) % عرضوا حين أعرضوا ثم قالوا % % قد فتناك في الغرام فتونا % % 12(@)(@@) % إن أطلنا الحنين شوقا إليكم % % فعلى الصب أن يطيل الحنينا % % 13(@)(@@) % رب ورقاء غردت فشجتني % % وكذاك الحزين يشجي الحزينا % % 14(@)(@@) % رددت نوحها فرددت مني % % جنة أزلفت وحورا وعينا % % 15(@)(@@) % رددي مااستطعت أيتها الورق % شجونا منالأسى ولحونا % % 16(@)(@@) % وأعيدي شكوى الغرام علينا % % أشرقت أوجها ولانت غصونا % % 17(@)(@@) % لو شكوناك ما بنا لشرحنا % % أن يطيع المتيم اللائمينا % % 18(@)(@@) % ما أطعنا اللوام والحب يأبى % % أن يطيع المتيم اللائمينا % % 19(@)(@@) % لهف نفسي على مراشف ألمى % % أودع الثغر منه درا ثمينا % % 20(@)(@@) % أن عطفا مهفهف القد قاس % كلما زاد قسوة زدت لينا % % PageV01P507 21(@)(@@) % يا شفائي من علة برحت بي % % إن في القلب منك داء دفينا % % 22(@)(@@) % يا ترى تجمع المقادير ما كان % % وأنى لنا بها أن تكونا % % 23(@)(@@) % في ليال أمضيتها بعناق % % لا يظن المريب فينا الظنونا % % 24(@)(@@) % فرقتنا أيدي النوى فافترقنا % % ورمينا ببينها وابتلينا % % 25(@)(@@) % بين شرق ومغرب ننتحيه % % فشمالا طورا وطورا يمينا % % 26(@)(@@) % أسعد الله فرقة العز لما % % فبذلنا لها ذخائر دمع % 27(@)(@@) % قدمته الولاة واتخذته % % في الملمات صاحبا ومعينا % % 28(@)(@@) % واستمدت من 
ms163	 رأيه فلق الصبح % بيانا منه وعلما رصينا % % 29(@)(@@) % جذب الناس بالجميل إليه % % وحباهم بفضله أجمعينا % % 30(@)(@@) % فرأت ما يسرها من كريم % % من سراة الأشراف والأنجبينا % % PageV01P508 31(@)(@@) % شيم عن إبائه في المعالي % % أسلكته طريقها المسنونا % % 32(@)(@@) % تستحيل الحزون فيه سهولا % % بعد ما كانت السهول حزونا % % 33(@)(@@) % ويهون الأمر العظيم لديه % % وحري بمثله أن يهونا % % 34(@)(@@) % زان ما شان في حوادث شتى % % ومحا ما يشين في ما يزينا % % 35(@)(@@) % فإذا قسته بأبناء عصري % % كان أعلى كعبا وأندى يمينا % % 36(@)(@@) % قد وجدناك والرجال ضروب % والتجاريب تظهر المكنونا % % 37(@)(@@) % عروة من عرا السعادة وثقى % % قد وثقنا بها وحبلا متينا % % 38(@)(@@) % هذه الناس منذ جثت إليها % % زجرت منك طائرا ميمونا % % 39(@)(@@) % كل أرض تحلها كان أهلو % % ها بما ترتجيه مستبشرينا % % 40(@)(@@) % وإذا روعت ومثلك فيها % % أصبحوا في ديارهم آمنينا % % PageV01P509 41(@)(@@) % يا شريف الأخلاق وابن شريف % أشرف الناس أثبت الناس دينا % % 42(@)(@@) % أحمد الله أن رأتك عيوني % % فرأت ما يقر فيك العيونا % % 43(@)(@@) % وشممنا من عرف ذاتك طيبا % فكأني إذ ذاك في دارينا % % 44(@)(@@) % ووردنا نداك عذبا فراتا % إنما أنت منهل الواردينا % % 45(@)(@@) % لك في الصالحات ما سوف يبقى % % ذكرها في الجميل حينا فحينا % % 46(@)(@@) % حزت فهما وفطنة وذكاء % وتفننت في الأمور فنونا % % 47(@)(@@) % وتوليت في الحقيقة أمرا % كان من لطفه المهيمن فينا % % 48(@)(@@) % سيرة ترتضى جبلت عليها % % ومزايا ترضي بها العالمينا % % 49(@)(@@) % فاهنا بالصوم والمثوبة فيه % % وجزيل الصيام في الصائمينا % % 50(@)(@@) % وبعيد يعود في كل عام % لك بالخير كافلا وضمينا % % PageV01P510 البحر : وافر تام 1(@)(@@) % أقول لصاحبي ورضيع كأسي % % رفيقي بالفسوق وبالفجور % 2(@)(@@) % علام صددت عن كأس الحميا % % لقد ضيعت أوقات السرور % % 3(@)(@@) % أبعد الشيب ويحك تبت عنها % % وما لك في متابك من عذير % % 4(@)(@@) % وكيف عدلت عن حالات سوء % تصير بها إلى بئس المصير % % 5(@)(@@) % لبست بها وإياك المخازي % % فأسحب ذيل مختال فخور % % 6(@)(@@) % أتنسى كيف قضينا زمانا % به الأيام باسمة الثغور % % 7(@)(@@) % وكنا كلما بتنا سكارى % % ورحنا بالمدام بلا شعور % % 8(@)(@@) % وقمنا بعد ذلك 
ms164	 واصطبحنا % % فما ندري المساء من البكور % % 9(@)(@@) % وأنت مع العواهر والزواني % % تطاعنهن بالرمح القصير % % 10(@)(@@) % وكنت تقول لي إشرب هنيا % وخذها بالكبير وبالصغير % % PageV01P511 11(@)(@@) % وكنت إذا نظرت ولو عجوزا % سللت سلول غرمول الحمير % % 12(@)(@@) % فإن الله يعفو عن كثير % % وميزت الإناث على الذكور % % 13(@)(@@) % تركت طريقتي وفررت عني % % فرار الكلب من أسد هصور % % 14(@)(@@) % وتوبتك التي كانت نفاقا % غرور وانغماسك في الغرور % % 15(@)(@@) % كصبغ الشيب ينصل بعد يوم % ولم يبعد مداه عن الظهور % % 16(@)(@@) % وماكتبت لتخطر لي ببال % % ولا اختلجت وشيبك في الضمير % % 17(@)(@@) % لئن أخذوا عليك بها عهودا % بما كتبت يداك من السطور % % 18(@)(@@) % فعد عنها إلى ما كنت فيه % % كمن شم الفسا بعد العبير % % 19(@)(@@) % وأكثر مااستطعت من المعاصي % % فإن يعفو عن كثير % % 20(@)(@@) % وننعم بالملاح بخفض عيش % % مدى الأوقات من بم وزير % % PageV01P512 21(@)(@@) % فإن حضر الفساد وغبت عنه % % ولم تك من يعد من الحضور % % 22(@)(@@) % لسودت الصحائف فيك هجوا % وإتي اليوم أهجى من جرير % % 23(@)(@@) % تطيع مشورتي وترى برأيي % % وحق المستشير على المشير % % 24(@)(@@) % لنقضي العمر في طرب ولهو % فمرجعنا إلى رب غفور % % 25(@)(@@) % وأنفق ما ملكت ولا تبال % فناصرنا ثراء للفقير % % 26(@)(@@) % فنحن بفضله وندى يديه % % كمن آوى إلى روض نضير % % 27(@)(@@) % ولا زلنا بشرعته ورودا % ورود الهيم من عذب نمير % % PageV01P513 البحر : منسرح 1(@)(@@) % يا ناجيا نحو كل مكرمة % يبلغ فيها أعالي الرتب % 2(@)(@@) % وطالبا بالكمال ما عجزت % فحول قوم عن ذلك الطلب % 3(@)(@@) % ومن سهام الآراء فكرته % % إن يرم فيها أغراضه يصب % 4(@)(@@) % إن الكتاب الذي نظرت به % % أبلغ ما ألفوه في الكتب % % 5(@)(@@) % فلو تأملت في دقائقه % % لقلت هذا من أعجب العجب % % 6(@)(@@) % إن أطلقوا لفظة الكتاب فما % % يشار إلا إليه في الكتب % % 7(@)(@@) % وغيره لا يفيدني أربا % وأين كتب النحاة من أربي % % 8(@)(@@) % لأن هذا الإمام أعلم خل % % ق الله في نحو منطق العرب % % 9(@)(@@) % ولم يزل وهو مرجعهم % % لدائرات العلوم كالقطب % % 10(@)(@@) % قد ناظرته الحساد من حسد % فغالبته بالزور والكذب % % PageV01P514 11(@)(@@) % وراح 
ms165	 يطوي الأحشاء من أسف % % لكتمهم فضله على لهب % % 12(@)(@@) % وأدركته فمات مغتربا % بأرض شيراز حرفة الأدب % % 13(@)(@@) % فإن تكن أنت عاشقه % % لما حوى طيه من النخب % % 14(@)(@@) % نقلته إن أردت نسخته % % ولا أبالي بشدة التعب % % 15(@)(@@) % وليس نقلي له على طمع % ولا لمال يرجى ولا نشب % % 16(@)(@@) % إن أياديك منك سابقة % علي قدما في سالف الحقب % % 17(@)(@@) % هذا لساني يعوقه ثقل % وذاك عندي من أعظم النوب % % 18(@)(@@) % فلو تسببت في معالجتي % % لنلت أجرا بذلك السبب % % 19(@)(@@) % وليس لي حرفة سوى أدب % جم ونظم القريض والخطب % % 20(@)(@@) % من بعد داوود لا حرمت منى % فقد مضت دولة الأدب % % PageV01P515 البحر : وافر تام 1(@)(@@) % نؤمل أن يطول بنا الثواء % % ونطمع بالبقاء ولا بقاء % % 2(@)(@@) % وتغرينا المطامع بالأماني % % وما يجري القضاء كما نشاء % % 3(@)(@@) % تحدثنا بآمال طوال % وليس حديثها إلا افتراء % % 4(@)(@@) % وإن حياتنا الدنيا غرور % وسعي بالتكلف واعتناء % % 5(@)(@@) % نسر بما نساء به ونشقى % % ومن عجب نسر بما نساء % % 6(@)(@@) % ونضحك آمنين ولو عقلنا % % لحق لنا التغابن والبكاء % % 7(@)(@@) % إلام يصدنا لعب ولهو % % عن العظة التي فيها ارعواء % % 8(@)(@@) % وتنذرنا المنون ونحن صم % إذا ما أسمع الصم الندراء % % 9(@)(@@) % وأية لذة في دار دنيا % % تلذ لنا وما فيها عناء % % 10(@)(@@) % ستدركنا المنية حيث كنا % % وهل ينجي من القدر النجاء % % PageV01P516 11(@)(@@) % ظهرنا للوجود وكل شيء % % له بدء لعمرك وانتهاء % % 12(@)(@@) % لئن ذهبت أوائلنا ذهابا % فأولنا وآخرنا سواء % % 13(@)(@@) % نودع كل آونة حبيبا % يعز على مفارقه العزاء % % 14(@)(@@) % فما يأتي الزمان له بثان % إلى حيث السعادة والشقاء % % 15(@)(@@) % ولو يفدى فديناه ولكن % أسير الموت ليس له فداء % % 16(@)(@@) % مضت أحبابنا عنا سراعا % إلى الأخرى وما نحن البطاء % % 17(@)(@@) % وما قلنا وقد ساروا خفافا % إلى أين السرى ومتى اللقاء % % 18(@)(@@) % بمن فيه المدائح والرثاء % % لما استوفى حقوقهم البكاء % % 19(@)(@@) % متى تصفو لنا الدنيا فنصفو % % ونحن - كما ترى - طين وماء % % 20(@)(@@) % فهذا السقم ليس له طبيب % وهذا الداء ليس له دواء % % PageV01P517 21(@)(@@) % فقدنا لا أبا لك من فقدنا 
ms166	 % % فحل الرزء إذ عظم البلاء % % 22(@)(@@) % وبعد محمد إذ بان عنا % % على الدنيا وأهليها العفاء % % 23(@)(@@) % لقد كانت به الأيام تزهو % % عليها رونق ولها بهاء % % 24(@)(@@) % وكان الكوكب الهادي لرشد % % يضل الفهم عنه والذكاء % % 25(@)(@@) % وكان العروة الوثقى وفاء % لمن فيه المودة والإخاء % % 26(@)(@@) % فيأوي من يضام إلى علاه % % ويعصمه من الضيم الإباء % % 27(@)(@@) % علا أقرانه شرفا ومجدا % كما تعلو على الأرض السماء % % 28(@)(@@) % عصامي الأبوة والمعالي % % له المجد المؤثل والسناء % % 29(@)(@@) % وما عقدت يد إلا عليه % % إذا عد الكرام الأتقياء % % 30(@)(@@) % سقاك الوابل الهطال قبرا % ثوت فيه المروءة والسخاء % % PageV01P518 31(@)(@@) % وحياك الغمام بمستهل % يصوب فترتوي الهيم الظماء % % 32(@)(@@) % قد ستودعت أكرم من عليها % % فأنت لكل مكرمة وعاء % % 33(@)(@@) % وقد واريت من لو كان حيا % لضاق بفضله الواقي الفضاء % % 34(@)(@@) % وقد أفعمت من كرم السجايا % % وطيبها كما فعم الإناء % % 35(@)(@@) % فأصبح منك في جنات عدن % % بدار الخلد لو كشف الغطاء % % 36(@)(@@) % مضى فيمن مضى وكذاك نمضي % % وغايتنا - وما نبقى - الفناء % % 37(@)(@@) % فما يأتي الزمان به بثان % إلى الدنيا ولا تلد النساء % % 38(@)(@@) % فقدناك ابن عثمان فقلنا % % فقدنا الجود وانقطع الرجاء % % 39(@)(@@) % ستبكيك الأيامى واليتامى % % وترثيك المكارم والعلاء % % 40(@)(@@) % وكنت علمت أنك سوف تمضي % % ويبقى الحمد بعدك والثناء % % PageV01P519 41(@)(@@) % فما قصرت عن تقديم خير % % تنال به المثوبة والجزاء % % 42(@)(@@) % تفوز ببرك الآمال منا % % ويرفع بالأكف لك الدعاء % % 43(@)(@@) % إذا وافت إلى مغناك فازت % % ذوو الحاجات واتصل الحباء % % 44(@)(@@) % رزقت سعادة الدارين فيها % % وإن رغمت عداك الأشقياء % % 45(@)(@@) % لوجه الله ما أنفقت لا ما % % يراد به افتخار واقتناء % % 47(@)(@@) % قضيت وما انقضى كمدي وحزني % % عليك وما أظن له انقضاء % % 48(@)(@@) % يذكرنيك ما وافى صباح % وما أنساك ما وافى مساء % % 49(@)(@@) % وما قصرت رجال بني زهير % % وفيك لها اقتفاء واقتداء % % 50(@)(@@) % بنيت لهم على العيوق نجما % وشيد بالعلى ذاك البناء % % 51(@)(@@) % بدور مجالس وأسود غيل % إذا الهيجاء حان بها اصطلاء % % PageV01P520 52(@)(@@) % شفاء للصدور بكل أمر % إذا مرضت وأعياها الشفاء % % 53(@)(@@) % وخير خليفة الماضين 
ms167	 عنا % % سليمان وفيه الاكتفاء % % 54(@)(@@) % وقاسم من زكا أصلا وفرعا % وما في طيب عنصره مراء % % 55(@)(@@) % إذا زكت الأصول زكت فروع % % فطاب العود منها واللحاء % % 56(@)(@@) % هو الشمس التي بزغت ضياء % فلا غربت ولا غرب الضياء % % 57(@)(@@) % أعزيه وإن عزيت نفسي % % 58(@)(@@) % عليه رحمة وسجال عفو % من الرحمن ما طلعت ذكاء % % PageV01P521 البحر : كامل تام 1(@)(@@) % لله منزل جابر من منزل % فيه الكرامة للمحب الزائر % 2(@)(@@) % رفعت قواعده وشيد بناؤه % % لمكارم وأكارم وأكابر % % 3(@)(@@) % ملأت قلوب الزائرين مسرة % فغدت تقر بها عيون الناظر % % 4(@)(@@) % من كل ما جمعت بخدمة جابر % من شادن أحوى وليث خادر % % 5(@)(@@) % حاز الشجاعة والسماحة فارتقى % % رتب العلى من سؤدد ومفاخر % % 6(@)(@@) % ترد العفاء مناهلا من جوده % % الوافي وتصدر بالعطاء الوافر % % 7(@)(@@) % شهدت مبانيه بحسن صنيعه % % وبما يجدد من بديع مآثر % % 8(@)(@@) % حل الأمير أبو المكارم جابر % فيها فزالت بالبهاء الباهر % % 9(@)(@@) % ولقد نزلت بها فقلت مؤرخا % دار الإمارة قد بنيت بجابر % % PageV01P522 البحر : خفيف تام 1(@)(@@) % ذكراني عهد الصبا بسعاد % % وخوافي الجوى علي بوادي % % 2(@)(@@) % ورواحي مع الهوى وغدوي % % لا عداها يوما مصب الغوادي % % 3(@)(@@) % وبياض المشيب سود حظي % % عند بيض المها سواد المداد % % 4(@)(@@) % يا ابن ودي وللمودة حق % فاقض إن شئت لي حقوق الوداد % % 5(@)(@@) % وأعد لي ما كان من برحاء % % كنت منها في طاعة وانقياد % % 6(@)(@@) % يوم حان الوداع من آل مي % فأرانا تفتت الأكباد % % 7(@)(@@) % تركوا عبرتي تصوب ووجدي % % في هياج ومهجتي في اتقاد % % 8(@)(@@) % هل علمتم في بينكم أن عيني % % لم تذق بعدكم لذيذ الرقاد % % 9(@)(@@) % لا أذوق الكرى ولا أطعم الغم % % ض ولا تنثني لطيف وسادي % % 10(@)(@@) % والليالي التي تمر وتمضي % % ألفت بين مقلتي والسهاد % % PageV01P523 11(@)(@@) % كل يوم أرى اصطباري عنكم % % في انتقاص ولوعتي في ازدياد % % 12(@)(@@) % قد أخذتم مني الفؤاد فردوا % % في تدانيكم علي فؤادي % % 13(@)(@@) % وأعيدوا ما كان منا ومنكم % % وليكن ما جرى على المعتاد % % 14(@)(@@) % أين عهدي بهم فقد طال عهدي % % فسقي عهدهم بصوب عهاد % % 15(@)(@@) % فمرضي في 
ms168	 هواك زدني سقاما % فلعلي أراك في عوادي % % 16(@)(@@) % فدموعي على هواك غزلر % وفؤادي إلى رضابك صادي % % 17(@)(@@) % يا عذولا يظن أن صلاحي % % في سلوي وذاك عين فسادي % % 18(@)(@@) % أنا فيما أراه عنك بواد % في هيامي وأنت عني بواد % % 19(@)(@@) % إنما أعين الظباء وما يج % % هل منها مصارع الآساد % % 20(@)(@@) % ما أراني من القوام المفدى % % ما أراني من القنا المياد % % PageV01P524 21(@)(@@) % ولحاظ كأنهن بقلبي % % مرهفات سلت ممن الأغماد % % 22(@)(@@) % أي قلب عذبته بصدود % ودنو نغصته ببعاد % % 23(@)(@@) % لم يفدني تطلبي من ثماد % أبتغيه ورقة من جماد % % 24(@)(@@) % ما لحظي من اغترابي وما لي % % مولع بالإتهام والإنجاد % % 25(@)(@@) % ويد البين طالما قذفتني % % غرة في دكادك ووهاد % % 26(@)(@@) % وتقلبت في البلاد وماذا % % أبتغي من تقلبي في البلاد % % 27(@)(@@) % ليت شعري وليتني كنت أدري % % ما مرامي من النوى ومرادي ؟ % 28(@)(@@) % وببغداد من أحاول فيها % % أشرف الحاضرين في بغداد % % 29(@)(@@) % وهو عبد الرحمن نجل علي % علوي الآباء والأجداد % % 30(@)(@@) % ألتقي النقي قولا وفعلا % والكريم الجواد وابن الجواد % % PageV01P525 31(@)(@@) % رفع الله ذكره في المعالي % % من علي العلى رفبع العماد % % 32(@)(@@) % شرف باذخ ورفعة ذكر % % رغمت عندها أنوف الأعادي % % 33(@)(@@) % هكذا هكذا المكارم تروى % % والمزايا من طارف وتلاد % % 34(@)(@@) % ساد بالعلم والتفى سيد النا % % س فخارا للسادة الأمجاد % % 35(@)(@@) % يقتني المال للنوال وإن كا % % ن لعمري فيه من الزهاد % % 36(@)(@@) % شرح الله صدره فأرانا % % في سواد الخطوب بيض الأيادي % % 37(@)(@@) % كم روتنا الرواة عنه حديثا % صح عندي بصحة الإسناد % % 38(@)(@@) % وأعدت الحديث عنه فقالوا % % ما أحيلى هذا الحديث المعاد % % 39(@)(@@) % فيريني حلاوة الجود جودا % وأريه حلاوة الإنشاد % % 40(@)(@@) % علم الله أنه في حجاه % مفرد العصر واحد الآحاد % % PageV01P526 41(@)(@@) % صيرفي الكلام لفظا ومعنى % من بصير بذوقه نقاد % % 42(@)(@@) % يعرف الفضل أهله وذووه % % وامتياز الأضداد بالأضداد % % 43(@)(@@) % إن تغابت عنه أناس لأمر % % أو عمت عنه أعين الحساد % % 44(@)(@@) % فكذاك البياض وهو نقي % مبتلى في نقائه بالسواد % % 45(@)(@@) % يابني الغوث والرجوع إليكم % % حين تعدو من الخطوب العوادي % % 46(@)(@@) % يكشف الله 
ms169	 فيكم الضر عنا % % وبكم نقتفي سبيل الرشاد % % 47(@)(@@) % كيف لا نستمد من روح قوم % % شفعاء لنا بيوم المعاد % % 48(@)(@@) % ورضي الله عنهم ورضوا عنه % % خيار العباد بين العباد % % 49(@)(@@) % فولائي لهم وخالص حبي % % هو ديني ومذهبي واعتقادي % % 50(@)(@@) % فعلى ذلك الجناب اعتمادي % % وإلى ذلك الجناب استنادي % % PageV01P527 51(@)(@@) % فضلكم يشمل العفاة جميعا % ونداكم للصادر الوارد % % 52(@)(@@) % إن الله فيكم كنز علم % ما له ما بقيتم من نفاد % % 53(@)(@@) % إن حدا هذه القصائد حاد % فلها من جميل فعلك حادي % % 54(@)(@@) % وعليكم تملي القوافي ثناء % عطرات الأنفاس في كل ناد % % 55(@)(@@) % وإذا ما أردت مدح سواكم % % فكأني اخترطت شوك القتاد % % 56(@)(@@) % ربحت فيكم تجارة شعري % % لارماها في غيركم بالكاد % % 57(@)(@@) % أنا في شكركم أروح وأغدو % % فأنا الرائح الشكور الغادي % % PageV01P528 البحر : طويل 1(@)(@@) % متى يشتفي هذا الفؤاد المتيم % ويقضي لبانات الهوى فيك مغرم % 2(@)(@@) % أبيت أداري الوجد فيك صبابة % وأسهر ليلي والخليون نوم % 3(@)(@@) % أجيب دواعي الشوق حيث دعونني % % وإن أكثرت لومي على الحب لوم % 4(@)(@@) % وأهرق من عيني ماء مدامع % % وفي القلب مني لوعة تتضرم % % 5(@)(@@) % وأشكو إليك الشوق لو كنت سامعا % ومن لي بمشكو يرق ويرحم % % 6(@)(@@) % إلام أذيع الوجد عندك أمره % % وأظهر ما أخفي عليك وأكتم % 7(@)(@@) % أعلل نفسي في تدانيك ضلة % % وما هو إلا من ذؤابة هاشم % % 8(@)(@@) % ولي حسرة ما تنقضي وتلهف % ومن مرسلات الدمع فذ وتوأم % % 9(@)(@@) % وللصب آيات تدل على الهوى % % تصرح أحيانا به وتجمجم % % 10(@)(@@) % وليل أقاسيه كأن نجومه % % غرانيق في موج من اليم عوم % PageV01P529 11(@)(@@) % بمعترك بين الأضالع والحشا % % ينازلني للهم جيش عرمرم % 12(@)(@@) % كأن بصدري من تباريح ما رأى % % صدور العوالي ، والقنا المتحطم % % 13(@)(@@) % أمض بأحشائي غرام مبرح % وأعضلني داء من الوجد مؤلم % % 14(@)(@@) % عدتك العوادي إنما هي زفرة % % تطيش بأحناء الضلوع وتحلم % % 15(@)(@@) % لقد برحت بي وهي في برحائها % % سواجع في أفنانها تترنم % % 16(@)(@@) % تعيد علينا ما مضى من صبابة % % وتملي أحاديث الغرام فنفهم % % 17(@)(@@) % ولم أنس لا أنسى الديار التي عفت % طلول 
ms170	 لها تشجي المشوق وأرسم % 18(@)(@@) % وقوفا عليها الركب يقضون حقها % % كأنهم طير على الماء حوم % % 19(@)(@@) % تذكرنا ما كان في زمن الصبا % % إن طال فيها عهدها المتقدم % % 20(@)(@@) % وعيشا قضيناه نعيما ولذة % % هو العيش إلا أنه يتصرم % % PageV01P530 21(@)(@@) % خليلي ما لي كلما عن ذكرهم % % وجئ بأخبار الأناشيد عنهم % 22(@)(@@) % أكفكف من عيني بوادر عبرة % % وأبكي لبرق شمته يتبسم % % 23(@)(@@) % رعى الله جيرانا منيت بحبهم % % أحلوا دمي في الحب وهو محرم % % 24(@)(@@) % رعيت بهم روض المحبة يانعا % وحكمتهم في مهجتي فتحكموا % % 25(@)(@@) % ألا في مجيري يالقومي ومسعدي % % على ظالم في حكمه يتظلم % % 26(@)(@@) % هم أعوزوني الصبر بعد فراقهم % % وسار فؤادي حيث ساروا ويمموا % % 27(@)(@@) % بنفسي الظعون السائرات كأنها % % بدور تداعت للمغيب وأنجم % % 28(@)(@@) % إذا زحزحت عنها اللئام عشية % أضاء بها جنح من الليل مظلم % % 29(@)(@@) % أيزعم واشي الحب أني سلوتهم % % ألا ساء واشي الحب ما يتوهم % % 30(@)(@@) % خلا عصرنا هذا من الناس فارتقب % % أناسا سواهم تحسن الظن فيهم % % PageV01P531 31(@)(@@) % وما بعد سليمان النقيب من امرئ % % ببغداد من يعزى إليه التكرم % % 32(@)(@@) % بذي طلعة تنبيك سيماؤها العلى % % ويصدق فيها القايف المتوسم % % 33(@)(@@) % عليه وقار ظاهر وسكينة % يمثل رضوى دونها ويلملم % % 34(@)(@@) % من السادة الغر الميامين سيد % % أعز بني الدنيا وأندى وأكرم % 35(@)(@@) % وما هو إلا من ذؤابة % % هو الرأس فيهم والرئيس المقدم % % 36(@)(@@) % تناخ لديه للمطامع أنيق % إذا حثحث لاركب المطي ويمموا % % 37(@)(@@) % فما دون هذا الشهم للوفد مقنع % % ولا عبده في البر للناس مغنم % % 38(@)(@@) % لنا من أياديه وشامل فضله % % مواهب تترى من لدنه وأنعم % % 39(@)(@@) % تصدر في دست النقابة سيدا % وما لسواه في الصدور التقدم % % 40(@)(@@) % نهز معاليه لكل ملمة % كما هز للطعن الوشيج المقوم % % PageV01P532 41(@)(@@) % وما زال كالسيف المهند ينتضى % % عرا كل خطب في غراريه تفصم % % 42(@)(@@) % تمسكت بالحيل الذي منه لم يرم % بحادثة الدنيا ولا يتصرم % % 43(@)(@@) % وفي كل يوم من أياديه نعمة % % مكارم تستوفى ورزق يقسم % % 44(@)(@@) % فللفضل في أيامه البيض موسم % وللجود منه والمكارم موسم % % 45 
ms171	(@)(@@) % بطلعته نستطلع الشمس في الضحى % % وينجاب من ليل الخطوب التجهم % % 46(@)(@@) % وذي همة أمضى من لاسيف حدها % % لأظفار أحداث الزمان تقلم % % 47(@)(@@) % تطير بذكراه القوافي شواردا % فتنجد في أقصى البلاد وتتهم % % 48(@)(@@) % أبا مصطفى لم أرو مدحك لامرىء % % من الناس ألا قال هذا مسلم % % 49(@)(@@) % لتهنا قريش حيث كنت زعيمها % % تبجل في أشرافها وتعظم % % 50(@)(@@) % ومن كان عبد القادر الشيخ جده % % فماذا يقول المفصح المتكلم % % PageV01P533 51(@)(@@) % وكم نعمة أوليتني فشكرتها % % ولو لم يفه مني لسان ولا فم % % 52(@)(@@) % فما ساغ لي إلا بفضلك مشرب % ولا لذ لي إلا بظلك مطعم % % 53(@)(@@) % لكل امرىء حظ لديك من الندى % % فلا أحد من نيل جدواك يحرم % % 54(@)(@@) % إليك ولا من عليك قوافيا % بأوصافك الحسنى تصاغ وتنظم % 55(@)(@@) % إذا أفصحت عن كنه ذاتك غادرت % % حسودك في إعرابها وهو أبكم % % 56(@)(@@) % ومنك ثرائي حيث كنت وثروتي % % وما زال يثرى في نوالك معدم % % 57(@)(@@) % رأيت بك الدنيا كما شئت طلقة % % وعيشي لولا شهد جودك علقم % % 58(@)(@@) % خدمتك بالمدح الذي أنت أهله % % ومثلك يا مولاي بالمدح يخدم % % 59(@)(@@) % أرى الشعر إلا فيك ينقص قدره % % وديناره في غير مدحك درهم % % 60(@)(@@) % ونثني عليك الخير في كل ساعة % ونبتدئ الذكر الجميل ونختم % % PageV01P534 البحر : رمل تام 1(@)(@@) % هذه ادار وهاتيك المغاني % % فسقاها بدم أحمر قاني % % 2(@)(@@) % دنف عبرته مهراقة % مثلما أهرقت الماء الأواني % % 3(@)(@@) % في رسوم دارسات لقيت % ما يلاقي الحر في هذا الزمان % % 4(@)(@@) % كان عهد اللهو فيها والهوى % % خضل المنبت حلوي المجاني % % 5(@)(@@) % تزدهي بالغيد حتى خلتها % % روضة تنبت بالبيض الحسان % % 6(@)(@@) % تتهادى مثل بانات النقا % % بقدود خطرت من خوط بان % % 7(@)(@@) % أثمرت بالحسن إلا أنها % % لم تكن مدت إليها كف جاني % % 8(@)(@@) % فاتكات بعيون من ظبا % طاعنات بقوام من سنان % % 9(@)(@@) % من مجيري من هواهن وما % % حيلتي بين ضراب وطعان % % 10(@)(@@) % أهون الأشياء فيهن دمي % % والهوى أكبر داع للهوان % % PageV01P535 11(@)(@@) % قد رماني شادن من يعرب % لا رمى الله بسوء من رماني % % 12(@)(@@) % مستبيحا دم صب طله % سهم 
ms172	 عينيه حراما غير واني % % 13(@)(@@) % حسرة أورثتها من نظرة % ما لها في ملتقى الصبر يدان % % 14(@)(@@) % يا لها من نظرة يشقى بها % % دون أعضائي طرفي وجناني % % 15(@)(@@) % نفرت أسراب هاتيك المها % % وذوى من بعدها غصن الأماني % % 16(@)(@@) % وتناثرن عقودا طالما % % نظمت في جمعنا نظم الجمان % % 17(@)(@@) % ما قضى ديني عني ماطل % % كلما استقضيته الدين لواني % % 18(@)(@@) % يا أحبائي على شطح النوى % % كم أعاني في هواكم ما أعاني % % 19(@)(@@) % مستلذا في أحاديثكم % % لذة الشارب من خمر الدنان % % 20(@)(@@) % ما صحا فيكم لعمري ثمل % لم يذق راحا ولا طاف بحان % % PageV01P536 21(@)(@@) % أترى الورقاء في أفنانها % % قد شجاها في هواكم ما شجاني % % 22(@)(@@) % فكأن قد أخذت من قبلها % % عن قماري الدوح أقمار القيان % % 23(@)(@@) % راب سلمى ما رأت من همة % % نهضت مني وحظ متوان % % 24(@)(@@) % لم تكن تدري ومن أين لها % % مبلغ العلم وما تعرف شاني % % 25(@)(@@) % واثقا بالله ربي والغنى % % من ندى عبد الغني في ضمان % % 26(@)(@@) % قرن الإحسان بالحسنى معا % فأراني فيهما سعد القران % % 27(@)(@@) % لم يرعني حادث أرهبه % % أنا ما عشت لديه في أمان % % 28(@)(@@) % هو ركن المجد مبنى فخره % % لا وهت أركان هاتيك المباني % % 29(@)(@@) % جعل الله به لي عصمة % فإذا استكفيته الأمر كفاني % % 30(@)(@@) % ففداه من لديه ما له % % بمكان الروح من نفس الجبان % % PageV01P537 31(@)(@@) % ثاني اثنين مع الدر سنى % واحد ليس له في الناس ثان % % 32(@)(@@) % عجب منه ومن أخلاقه % % لو تتبعت أعاجيب الزمان % % 33(@)(@@) % كرم محض وبأس وندى % % في نجيب قلما يجتمعان % % 34(@)(@@) % وأذل المال معطاء يرى % % عزة الأنفس بالمال المهان % % 35(@)(@@) % % خضل الراحة منهل البنان % % 36(@)(@@) % بسطت أنمله العشر فما % % زلت منها حشو جنات ثمان % % 37(@)(@@) % وله مبتكرات في العلى % % ترفع الذكر إلى أعلى مكان % % 38(@)(@@) % قائل في مثلها قائلها % % هكذا تفتض أبكار المعاني % % 39(@)(@@) % رجل في موقف الليث له % % فتكة البكر من الحرب العوان % % 40(@)(@@) % تحت ظل النقع في حر القنا % % فوق رحب الصدر موار العنان % % PageV01P538 41(@)(@@) % والمواضي البيض ما إن أشرقت % % شرقت ثم 
ms173	 بلون أرجواني % % 42(@)(@@) % ولك الله فقد أمنتني % % كلما عشت صروف الحدثان % % 43(@)(@@) % وإنما قيدتني في نعمة % % أطلقت في شكرها اليوم لساني % % 44(@)(@@) % دونك الناس جميعا والربا % % أبدا تنحط عن شم الرعان % % 45(@)(@@) % يا أبا محمود يا هذا الذي % % عم بالفضل الأقاصي والأداني % % 46(@)(@@) % منزلي قفر ودهري جائر % % فأجرني سيدي من رمضان % % 47(@)(@@) % وزمان منه حظي مثلما % % كان حظ الشيب من ود الغواني % % 48(@)(@@) % لست أدري والذي في مثله % % أنزل القرآن والسبع المثاني % % 49(@)(@@) % أفأيام صيام أقبلت % % هي أم أيام بؤس وامتحان % % 50(@)(@@) % ساءني منه لعمري شرف % لي من تلك الحروف الثلثان % % PageV01P539 51(@)(@@) % لو أدري لي سفرا قطعته % % إربا بالأنيق النجب الهجان % % 52(@)(@@) % نائيا عن وطن قاطنه % % يحسد اللاطم وجه الصحصحان % % 53(@)(@@) % يا غماما لم يزل صيبه % % وأكف الديمة آنا بعد آن % % 54(@)(@@) % صم كما شئت بخير واغتنم % % أجر شهر لاصوم بالخير المدان % % 55(@)(@@) % ما جزاء الصوم في أمثاله % % غير ما نوعد فيه بالجنان % % 56(@)(@@) % وتهنا بعده في عيده % % إن أعيادك أيام التهاني % % 57(@)(@@) % لا خلاك الله من دنيا بها % % كل شيء ما خلا مجدك فان % % 58(@)(@@) % في زمان أصبح الجود به % % والمعالي أثرا بعد عيان % % PageV01P540 البحر : كامل تام 1(@)(@@) % عاد الفؤاد من الجوى ما عادا % % أضحى يذيل له الدموع ورادا % % 2(@)(@@) % بل أنت قاتلة النفوس فربما % % يأبى قتيلك أن يكون مفادى % % 3(@)(@@) % قولي لطيفك يا سعاد يزورني % % إن سمت صبك جفوة وبعادا % % 4(@)(@@) % هيهات أن يصل الخيال لمقلة % % جفت الرقاد فما تمل سهادا % % 5(@)(@@) % ولكم أروح بلوعة أغدو بها % % ما راوح القلب النسيم وغادى % % 6(@)(@@) % خذ يا هذيم إليك قلبي إنه % % ملأ الجوانح كلها إيقادا % % 7(@)(@@) % واسلك بصحبك غير ما أنا سالك % % فيه وملق للنياق قيادا % % 8(@)(@@) % حذرا عليك من الصريم فربما % % قنصت لحاظ ظبائه الآسادا % % 9(@)(@@) % تلك الأحبة في الغميم ديارها % % جاد الغمام ديارها وأجادا % % 10(@)(@@) % من مثقلات المزن ألقى رحله % % فيها وشق على الطلول مزادا % % PageV01P541 11(@)(@@) % يستل منه البرق بيض سيوفه % % منها وما كانت لها أغمادا % % 12(@)(@@) % ما 
ms174	 قادت الريح الجنوب زمامه % % إلا وطاوع أمرها وانقادا % % 13(@)(@@) % وسقاك دفاع الحيا من أربع % % لم أخش فيها للدموع نفادا % % 14(@)(@@) % وقفت بنا فيها المطي فخلتها % % فقدت لها بالرقمتين فؤادا % % 15(@)(@@) % وأبت براحا عن طوامس أرسم % أضحت لها ولصحبها أقيادا % % 16(@)(@@) % هل أنت ذاكرة ، وهاج بك الجوى ، % مرعى وماء عندها مبرادا % % 17(@)(@@) % واها لعيشك بالغوير لقد مضى % % ورأيت بعد نعميه أنكادا % % 18(@)(@@) % ولقد رأيت الدار تدمي أعينا % غرقى ويحرق دمعها الأكبادا % % 19(@)(@@) % فنحرت هذا الطرف في عرصاتها % % فمدامعي مثنى لها وفرادى % % 20(@)(@@) % وسقيتها بالدمع حتى لو سقى % % وبل الغمام رسومها ما زادا % % PageV01P542 21(@)(@@) % يا ورق ! أين غرام قلبك من شج % جعل النواح لشجوه معتادا ؟ % 22(@)(@@) % أو تشبهين الصب عند نواحه % % ولقد بخلت بمدمعيك وجادا % % 23(@)(@@) % بلغ البكاء من الشجي مراده % % منه وما بلغ الشجي مرادا % % 24(@)(@@) % فمتى خمود النار بين جوانحي ، % والنار آونة تكون رمادا ؟ % 25(@)(@@) % ومسالمات الحادثات وأن أرى % % زمني لأمري طائعا منقادا % % 26(@)(@@) % أنى يسالمني الزمان وقد رأى % % هممي على حرب الزمان شدادا % % 27(@)(@@) % وعداوة الأيام ليست تنقضي % % والحر في هذا الزمان معادى % % 28(@)(@@) % لولا جميل أبي الثناء وإنه % % يولي الجميل ويكرم الوفادا % % 29(@)(@@) % قلقلت عن أرض العراق ركائبي % % وسكنت غيرك يا بلاد بلادا % % 30(@)(@@) % هو موردي ما لم أرده من الندى % % لولاه لم أك صادرا ورادا % % PageV01P543 31(@)(@@) % ومطوق جيدي بنائله الذي % % ملك الرقاب وطوق الأجيادا % % 32(@)(@@) % متفرد بالفضل يعرف قدره % % من يعرف الأفراد والآحادا % % 33(@)(@@) % إن قلت : ما بالخافقين نظيره ، % أوردت فيا قلته أشهادا % % 34(@)(@@) % هذي البلاد وهذه علماؤها % % هل فاخرت بنظره بغداد ؟ % 35(@)(@@) % إن الشريعة ألبست بجنابه % % تاجا وألبسه التقى أبرادا % % 36(@)(@@) % أجداده بنت العلاء وشيدت % فبنى على ذاك البناء وشادا % % 37(@)(@@) % وكأنما أقلام أنماه غدت % زرقا على أهل العناد حدادا % % 38(@)(@@) % وكأنما جعل الصباح لخطه % % معنى ومسود الظلام مدادا % % 39(@)(@@) % نهدي إلى عين القلوب سطوره % % نورا يخال على البياض سوادا % % 40(@)(@@) % لله فضلك في الوجود فإنه % % ترك البرية كلها حسادا % % PageV01P544 41(@)(@@) % عز النظير لمثل فضلك بينهم 
ms175	 % % فليطلبوا لك في السما أندادا % % 42(@)(@@) % لو أنصفوا شكروا مواهب ربهم % % إذ كنت للدين القويم عمادا % % 43(@)(@@) % أحييت علم الأنبياء وقد أرى % % بوجود ذاتك رجعة ومعادا % % 44(@)(@@) % ولأنت أجرى السابقين إلى مدى % ولأنت أورى القادحين زنادا % % 45(@)(@@) % لحقت مداك اللاحقون فقصرت % ولو أنها ركبت إليك جيادا % % 46(@)(@@) % ولقد جريت على مذاكي همة % % لا تسأم الإتهام والإنجادا % % 47(@)(@@) % ها أنت في الإسلام أكبر آية % لله تمحو الغي والإلحادا % % 48(@)(@@) % فإذا نطقت فحجة مقبولة % % أو قلت قلت من الكلام سدادا % % 49(@)(@@) % ما أم فضلك مستفيد في الورى % % إلا استفاد فضيلة وأفادا % % 50(@)(@@) % لولا ورود بحار علمك إذ طمت % % لم تعرف الإصدار والإيرادا % % PageV01P545 51(@)(@@) % ولكم زرعت من الجميل مكارما % لا ترتجي مما زرعت حصادا % % 52(@)(@@) % ولك الجميل إذا قبلت مدائحا % أنشدتها لك معلنا إنشادا % % 53(@)(@@) % فليهنك العيد الجديد ولم تزل % أيام دهرك كلها أعيادا % % PageV01P546 البحر : طويل 1(@)(@@) % تنفس عن وجد توقد جمره % فأجرى مسيل الدمع ينهل قطره % 2(@)(@@) % وبات يعاني الهم ليس ببارح % على قلبه إقدامه ومكره % % 3(@)(@@) % تمنى وما يغني التمني مطالبا % حري به لولا الدنية دهره % % 4(@)(@@) % ودون أمانيه عوائق جمة % % يضيق لها في المنزل الرحب صدره % % 5(@)(@@) % تحمل أعباء المتاعب والتقى % % على غرة صرف الزمان وغدره % % 6(@)(@@) % وأشقى بني هذا الزمان أريبه % % وأتعب من فيه من الناس حره % % 7(@)(@@) % ورب خميص البطن مما يشينه % % ينوء بأثقال الأبوة ظهره % % 8(@)(@@) % له كل يوم وقفة بعد وقفة % % يهيج جوى أحشائه وتقره % % 9(@)(@@) % يطول مع الأيام فيها عتابه % % ويسهر ليلا ما تبلج فجره % % 10(@)(@@) % يشيم سنا برق المطامع وامضا % تألق إلا إنه لا يغره % % PageV01P547 11(@)(@@) % فأمسى يغض الطرف عنه ودونه % % وقوف الفتى يفضي إلى الضيم أمره % % 12(@)(@@) % وحالف مختارا على العز نفسه % % إباء ولم يؤخذ على الذل إصره % % 13(@)(@@) % بنفسي امرؤ يقسو على الدهر ما قسا % % ولم يتصدع في الحوادث صخره % % 14(@)(@@) % إذا ما رأى المرعى الدني تنوشه % % يد الرذل يستحلى مع الهون مره % % 15(@)(@@) % تناول أفنان الخصاصة وارتدى % % بفاضل ذيل الفخر يسحب 
ms176	 طمره % % 16(@)(@@) % جليد على عسر الزمان ويسره % % وما ضره عسر الزمان ويسره % % 17(@)(@@) % فلا البؤس والإقلال مما يسوؤه % % وليس ثراء المال مما يسره % % 18(@)(@@) % لئن تخلص الإبريز نار التجارب سكبه % % إلى أن صفا من شائب الزيف تبره % % 19(@)(@@) % قريب مجاني الجود من مستميحه % % بعيد على من سامه الخسف غوره % % 20(@)(@@) % فلا يأمنن الدهر مكري فإنني % % من القوم لم يؤمن بمن ساء مكره % % PageV01P548 21(@)(@@) % وما أنا بالمدفوع إن ضيم شره % % ولا أنا بالممنوع إن سيم خيره % % 22(@)(@@) % منحت الصبا عذب الموارد في الهوى % % بمبتسم باللؤلؤ الرطب ثغره % % 23(@)(@@) % قضيت به عهد الشباب وعصره % % فهل راجع عهد الشباب وعصره ؟ % 24(@)(@@) % تفتح نوار المشيب بلمتي % % وأينع في روض الشبيبة زهره % % 25(@)(@@) % وما فاتني هذا الوقار الذي أرى % % إذا فاتني وصل المليح وهجره % % 26(@)(@@) % صحا والهوى العذري باق خماره % % بنشوان من خمر الصبابة سكره % % 27(@)(@@) % معذبتي من غير جرم يلومها % % وأعذب شيء في هواك أمره % % 28(@)(@@) % أرابك مني أن أقمت بموطن % % تجوع ضواريه وتشبع حمره % % 29(@)(@@) % وكيف أخاف الفقر أو أحرم الغنى % % هذا ندى عبد الغني ووفره % % 30(@)(@@) % فلا زال موصولا من الله لطفه % % إلي ومسبولا من الله ستره % % PageV01P549 31(@)(@@) % بأبلج وضاح الجبين أغره % % فلله وضاح الجبين أغره % % 32(@)(@@) % كما لم يزل مني عليه ولم يزل % ثنائي على طول الزمان ، وبره % % 33(@)(@@) % كفاني مهمات الأمور جميعها % % فما سرني أن ساءني الدهر غيره % % 34(@)(@@) % وما بات إلا وهو في الخطب كالئي % % بطرف يريع الدهر إذ ذاك شزره % % 35(@)(@@) % وما لامرئ عندي جميلا أعده % % وكيف وقد غطى على البحر نهره % % 36(@)(@@) % وإن الجميل المحض معنى وصورة % خلائقه بين الأنام وذكره % % 37(@)(@@) % حياة جميل الصنع فيها حياته % % وعمر المعالي والأبوة عمره % % 38(@)(@@) % حياض العطاء المستفاض أكفه % % ومن فيضها جزل العطاء وغمره % % 39(@)(@@) % يمين كصوب المزن يهرق جودها % % ووجه كروض الحزن قد راق بشره % % 40(@)(@@) % دعاه إلى المعروف من نفسه لها % % وتلك سجاياه وذلك طوره % % PageV01P550 41(@)(@@) % أدرت له أخلاف كل حلوبة % من المجد حتى قيل لله دره % % 42 
ms177	(@)(@@) % تتصل هذا الدهر من ذنبه به % % فلا تعتبن الليل والصبح عذره % % 43(@)(@@) % فما ذنبه من بعد ذلك ذنبه % % ولا وزره من بعد ذلك وزره % % 44(@)(@@) % ولي منه ما أهدي لديه وأبتغي % % ومني له المدح الذي طاب نشره % % 45(@)(@@) % فيا قمرا في أفق كل أبية % سريع إلى المعروف والبر سيره % % 46(@)(@@) % فداؤك نفسي والمناجيب كلها % % ومن سره في الناس أنك فخره % % 47(@)(@@) % أفي الناس إلا أنت من عم خيره % % بيوم على الدنيا تطاير شره % % 48(@)(@@) % وما غيرك المدعو إن شب جمرها % % وأنشب ناب الخطب فينا وظفره % % 49(@)(@@) % قواض على صرف الحوادث بيضه % % مواض لعمري في الكريهة سمره % % 50(@)(@@) % إذا ما غزا معروفه النكر مرة % فلله مغزاه وبالله نصره % % PageV01P551 51(@)(@@) % تدفق في حوض المكارم جوده % % وحلق في جو من الفخر صقره % % 52(@)(@@) % فهل يعلمن المجد أنك فخره % % وهل يعلمن الجود أنك بحره % % 53(@)(@@) % ومستعصم بالعز منك وثوقه % % إليك إذا هاب الدنايا مفره % % 54(@)(@@) % وما خفيت حال عليك ظهروها % % وكيف وسر العبد عندك جهره % % 55(@)(@@) % فلا تحسبني من ثراك مملقا % ورب غني ليس يبرح فقره % % 56(@)(@@) % وليس فقيرا من رآك له غنى % ولا آيسا من أنت ما عاش ذخره % % 57(@)(@@) % فشكرا لأيديك التي قد تتابعت % % إلي بما يستوجب الحمد شكره % % 58(@)(@@) % ولو نظم الجوزاء فيك لما وفى % % بها نظمه المثني عليك ونثره % % 59(@)(@@) % وما يملأ الأقطار إلا ثناؤه % % ويعذب إلا في مديحك شعره % % PageV01P552 البحر : وافر تام 1(@)(@@) % ليالينا على الجرعاء عودي % % بماضي العيش للصيب العميد % 2(@)(@@) % بحيث منازل الأحباب تزهو % % ونظم الشمل كالدر النضيد % % 3(@)(@@) % وفي تلك المنازل لا عداها % % حيا ينهل من ذات الرعود % % 4(@)(@@) % مسارح للمها يسخن فيها % % وإن كانت مرابض للأسود % % 5(@)(@@) % تعلقها هوى قيس لليلى % % سوانح ربرب وقطيع غيد % % 6(@)(@@) % هنالك تفتك اللحظات منها % % وتنتسب الرماح إلى القدود % % 7(@)(@@) % وكم فيا لحي من كبد تلظى % % وتصلى حر نيران الخدود % % 8(@)(@@) % ولما أن وقفت بدار مي % % 9(@)(@@) % سقتك بمستهل المزن قطر % وشاك الحيا وشي البرود % % 10(@)(@@) % فأين ملاعب الغزلان فيها 
ms178	 % % وصفو العيش في الزمن الرغيد % % PageV01P553 11(@)(@@) % وفي تلك الشفاه اللعس ري % فواظمأ الفؤاد إلى الورود % % 12(@)(@@) % وما أنسى الإقامة في ظلال % على ماء من الوادي برود % % 13(@)(@@) % تغنينا من الأوراق ورق % وتشدونا على الغصن الميود % % 14(@)(@@) % وتنشدنا الهوى طربا فنلهو % % وتطربنا بذياك النشيد % % 15(@)(@@) % لقد كانت ليالينا بجمع % مكان الخال من وجنات خود % % 16(@)(@@) % أبيت ومن أحب وكأس راح % كذوب التبر في الماء الجمود % % 17(@)(@@) % وقد غنت فأعربت الأغاني % % عن اللذات من ناي وعود % % 18(@)(@@) % فما مالت إلى الفحشاء نفس % % ولا ركنت إلى حسناء رود % % 19(@)(@@) % وما زالت بي الألحاظ حتى % % ألانت هذه الأيام عودي % % 20(@)(@@) % ولم تملك يمين الحرص نفسي % % ولا ألوت إلى الأطناع جيدي % % PageV01P554 21(@)(@@) % وليل قد لبست به دجاه % % بأردية من الظلماء سود % % 22(@)(@@) % لبيد يفرق الخريت فيها % % ولم أصحب سوى حنش وسيد % % 23(@)(@@) % يجاوبني لديها الحتف نفس % فيلمس ملمس الصعد الشديد % % 24(@)(@@) % وتمنع جانبي بيض شداد % ولي بأس أشد من الحديد % % 25(@)(@@) % وكم يوم ركبنا الفلك تطفو % % بسيط الماء في البحر المديد % % 26(@)(@@) % إذا عصفت بها ريح هوت بي % % كما يهوي المصلي للسجود % % 27(@)(@@) % فآونة تكون إلى هبوط % % وآونة تكون إلى صعود % % 28(@)(@@) % ولولا اليوسفان لما رمت بي % % مراميها إلى خطر مبيد % % 29(@)(@@) % وقد أهوى الكويت وأنتحيها % % إلى مغنى محمدها السعيد % % 30(@)(@@) % إذا طالعت بهجته أرتني % % مطالعها مطالع للسعود % % PageV01P555 31(@)(@@) % أنامله جداول للعطايا % % وبهجته رياض للوفود % % 32(@)(@@) % وأكرم من غدت تثني عليه % % بنو الدنيا بقافية شرود % % 33(@)(@@) % مفيد كل ذي أمل وحاج % يمد إليه راحة مستفيد % % 34(@)(@@) % ومنتجع العفاة ينال فيه % % مكانة رفعة ومنال جود % % 35(@)(@@) % تحط رحالها فيه الأماني % % وتعنيه المدائح من بعيد % % 36(@)(@@) % وتأوي كلما آوت إليه % % ومأواها إلى ركن شديد % % 37(@)(@@) % فتى من عقد سادات كرام % % يتيمة ذلك العقد الفريد % % 38(@)(@@) % نعمت فتى من الأشراف خلا % فيا لله من خل ودود % % 39(@)(@@) % ولولا جوده والفضل منه % % كما من الوجود على وجودي % % 40(@)(@@) % مناقب في المعالي أورثوها % % عن الآباء منهم والجدود % % PageV01P556 41(@)(@@) % أسود مواطن 
ms179	 الهيجاء قوم % لهم شرف العقول على الأسود % % 42(@)(@@) % هو الشرف الذي يبدو سناه % % فيخضع كل جبار عنيد % % 43(@)(@@) % ويخمد نورهم نارا تلظى % % وكان الظن آبية الخمود % % 44(@)(@@) % وما اعترف الجحود بها وفاقا % ولكن لا سبيل إلى الجحود % % 45(@)(@@) % رفاعي رفيع القدر سام % % أبي راغم أنف الحسود % % 46(@)(@@) % ومبدي كل مكرمة ، معيد % فيا لله من مبد معيد % % 47(@)(@@) % مكارم منعم ونوال بر % غني بالنجاز عن الوعود % % 48(@)(@@) % وما ملكت يداه من طريف % % فلم تضع الجميل ومن تليد % % 49(@)(@@) % عمود المجد من بيت المعالي % % وهل بين يقوم بلا عمود % % 50(@)(@@) % مدحت سواه من نقباء عصر % % فكنت كمن تيمم بالصعيد % % PageV01P557 51(@)(@@) % ولذت به فلذت إذن بظل % يمد ظلال جنات الخلود % % 52(@)(@@) % ولست ببارح عن باب قرم % % أقيد من نداه في قيود % % 53(@)(@@) % إذا جردته عضبا صقيلا % وقفت من الحديد على حديد % % 54(@)(@@) % وإن ذكروا له خلقا % فقل ما شئت بالخلق الحميد % % 55(@)(@@) % إليك بعثتها أبيات شعر % % يسير بها الرسول مع البريد % % 56(@)(@@) % كقطر المزن يسجم من نمير % % وروض المزن يبسم عن ورود % % 57(@)(@@) % لئن كانت بنو الدنيا قصيدا % فإنك بينهم بيت القصيد % % PageV01P558 البحر : رمل تام 1(@)(@@) % شرف البصرة مولانا المشير % وتوالى البشر منه والسرور % 2(@)(@@) % قرت الأعين في طلعته % % مذ بدا وانشرحت منا الصدور % % 3(@)(@@) % أشرقت في أفقنا وانتهجت % % وكذا تطلع في الأفق البدور % % 4(@)(@@) % يرفع الجور ويبدي عدله % % منصف بالحكم عدل لا يجور % % 5(@)(@@) % أوتي الحكمة والحكم وما % % هو إلا العالم البحر الغزير % % 6(@)(@@) % فوض الأمر إليه ملك % ما جرت إلا بما شاء الأمور % % 7(@)(@@) % من وزير أصبحت آراؤه % % يسعد السلطان فيها والوزير % % 8(@)(@@) % كان سر اللطف مكنوما وقد % % آن للرحمة واللطف الظهور % % 9(@)(@@) % من أمير المؤمنين انبعثت % حبذا المأمور فيها والأمير % % 10(@)(@@) % دولة أيدها الله به % % فلقد طالت وما فيها قصور % % PageV01P559 11(@)(@@) % وبشير لمليك همه % أن يرى الناس وما فيهم فقير % % 12(@)(@@) % أنت سيف صارم في يده % % وسحاب من أياديه مطير % % 13(@)(@@) % أنت ظل مده الله على % % أهل هذا القطر أن 
ms180	 حان الهجير % % 14(@)(@@) % جئت بالبأس وبالجود معا % إنما أنت بشير ونذير % % 15(@)(@@) % تمحق الباغين عن آخرهم % % مثلما يحمو الدجى الصبح المنير % % 16(@)(@@) % أصلحت بيضك ما قد أفسدوا % % وكبا بالمفسد الجد العثور % % 17(@)(@@) % في حروب تدرك الوتر بها % % حاضت البيض بها وهي ذكور % % 18(@)(@@) % عدت منصورا بجيش ظافر % وجناب الحق مولانا النصير % 19(@)(@@) % بذلوها أنفسا عن طاعة % % ضمنها الفوز وعقابها الحبور % % 20(@)(@@) % تخطف الأرواح من أعدائها % % مثلما تختطف الطير الصقور % % PageV01P560 21(@)(@@) % إنما قربتهم عن نظر % ما له في هذه الناس نظير % % 22(@)(@@) % عارفا إخلاص من قربته % % ولأنت الناقد الشهم البصير % % 23(@)(@@) % فتحت بابا لراجيك يد % سددت في حد ماضيها الثغور % % 24(@)(@@) % وحمى أطرافها ذو غيرة % % من مواضيك صليل وزئير % % 25(@)(@@) % مهلك أعداءك الرعب كما % % أهلكت عادا من الريح الدبرو % 26(@)(@@) % يا لك الله مشيرا بالذي % % يرتضى منه وبالخير مشير % % 27(@)(@@) % فإذا حاد فغيث ممطر % وإذا حارب فالليث الهصور % % 28(@)(@@) % وإذا حل بدار قد بغت % حل فيها الوبل منه والثبور % % 29(@)(@@) % إن تسل عمن بغى في حكمه % % فقتيل من ظباه وأسير % % 30(@)(@@) % أوقدوا النار التي أوروا بها % % وسعى في هلكهم ذاك السعير % % PageV01P561 31(@)(@@) % إذ يسير النصر في موكبه % % معلنا تأييده حيث يسير % % 32(@)(@@) % كيف لا يرجى ويخشى سطوة % لا الندى نزر ولا الباع قصير % % 33(@)(@@) % وإذا طاشت رجال لم يطش % أين رضوى من علاه وثبير % % 34(@)(@@) % ذو انتقام شقي الجاني به % % ولمن تاب عفو وغفور % % 35(@)(@@) % أبغض الشر فلا يصحبه % % وانطوى منه على الخير الضمير % % 36(@)(@@) % أنقذ الأخبار من أشرارها % % وشرار الشر فيهم مستطير % % 37(@)(@@) % فالعراق الآن في خفض وفي % % مجدك الباذخ مختال فخور % % 38(@)(@@) % أنت للناس جميعا مورد % ولها منك ورود وصدور % 39(@)(@@) % أنت للناس لعمري منهل % ونداك السائغ العذب النمير % % 40(@)(@@) % هذه البصرة منذ استبشرت % % بك وافاها من السعد بشير % % PageV01P562 41(@)(@@) % حدثت بالقرب من عمرانها % % بعدما أخربها الدهر المبير % % 42(@)(@@) % كبقايا أسطر من زبر % بليت وابليت تلك السطور % % 43(@)(@@) % فلعل الله أن يعمرها % % بك والله بما شاء قدير % % 44(@)(@@) % تتلافاها 