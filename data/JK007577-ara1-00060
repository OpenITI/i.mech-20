ms41	 % % رجعت كتائبه على الأدراج % % 13(@)(@@) % مالي سواك فلا تخيب مقصدي % % ما خاب فيك رجاء عبد راج % % 14(@)(@@) % وافيت من أرض بعيد خطوها % % من بعد طول تخبط ولجاج % % 15(@)(@@) % مهما ضحيت فظل حبك ملجأي % % ومتى مرضت ففي يديك علاجي % % 16(@)(@@) % ومددت كف الفقر أسأله فيا % % عز الغنى وذلة المحتاج % % 17(@)(@@) % فرأى افتقاري في يديه فجالي % % من جوده بالوابل الثجاج % % 18(@)(@@) % وأحلني من ديره في هضبة % % تنحط عنها الشهب في الأبراج % % 19(@)(@@) % وجلا علي الراح في أكواسها % % فشربتها صرفا بغير مزاج % % 20(@)(@@) % تخفى عن الإدراك إلا أنها % % يهدي سناها راحة المزاج % % PageV01P187 21(@)(@@) % فترى زجاجتها بغير مدامة % % وترى مدامتها بغير زجاج % % 22(@)(@@) % والى علي بها وقال هي التي % % فيها سمحت بخير النساج % % 23(@)(@@) % فاشرب وبح باسمي جهارا لا تخف % % في الدير من نصب ولا إحراج % % 24(@)(@@) % يا صاحبي وما أرى لي صاحبا % % غيري أعاطيه الهوى وأناجي % % 25(@)(@@) % عوجا على طلل الوجود وبلغا % % عني السلام فلات حين معاج % % 26(@)(@@) % لله إخوان الصفاء فإنهم % % سلكوا الطريق الواضح المنهاج % % 27(@)(@@) % من كل ذي طمرين أشعث أغبر % % عبثت بشملته يد الإنهاج % % 28(@)(@@) % وقفوا بأبواب اليقين وفتحوا % % ما كان منها قبل ذا إرتاج % % 29(@)(@@) % حتى إذا كادت سماة طريقهم % % تخفى بكل مموه ومداج % % 30(@)(@@) % نادت هلموا جددوا عهد الرضا % % أيام مولانا أبي الحجاج % % PageV01P188 31(@)(@@) % فاستقبلوا داعي المقام كأنما % % أتت المقام ركائب الحجاج % % 32(@)(@@) % أحيا الإلاه به رسوم طريقهم % % وحماهم من ملكه بسياج % % 33(@)(@@) % ملك يحب الصالحين ويقتدي % % في الدين من أنوارهم بسراج % % 34(@)(@@) % ويواصل الليل التمام مسهدا % % لله بين مراقب ومناج % % 35(@)(@@) % أبدى رسوم العلم بعد عفائها % % وأعاد وجه الحق ذا إبهاج % % 36(@)(@@) % وغدا الزمان بسيفه وبسيبه % % يومين يوم ندى ويوم هياج % % 37(@)(@@) % وأحق من ملك الخلافة ناصر % % ينميه صاحب صاحب المعراج % % 38(@)(@@) % كل الفضائل لم تحل بحمده % % لباتها فتمامها لخداج % % 39(@)(@@) % خذها أمير المسلمين قوافيا % % ثارت عجاجتها على العجاج % % 40(@)(@@) % أنا جوهري اللفظ لآعجب إذا % % جمعي منظمها بهذا التاج % % PageV01P189 41(@)(@@) % أبقيت بالذكر الجميل مدائحا % % لك في فم 
ms42	 الراوي وقلب الراجي % % 42(@)(@@) % واخلد ونصر الله جل جلاله % % يأتيك أفواجا على أفواج % % PageV01P190 البحر : بسيط تام 1(@)(@@) % ماذا أحدث عن بحر سبحت به % % حدث عن البحر لا إثم ولا حرج % % 2(@)(@@) % دحاه مبتدع الأشياء مستويا % % ما إن به درك كلا ولا درج % % 3(@)(@@) % حتى إذا ما المنار الفرد لاح لنا % % صحت أبشري يا مطايا جاءك الفرج % % 4(@)(@@) % قربت من عامر دارا ومنزلة % % والشاهد العدل هذا الطيب الأرج % % PageV01P191 البحر : منسرح 1(@)(@@) % هذي ثمان قد قطعن الحجا % % في سيرها معتبر للحجا % % 2(@)(@@) % مرت وقد نال بها آمن % % ما شاء من أوطاره وارتجا % % 3(@)(@@) % فجرد العزم الذي ما نبا % % والتحف الليل الذي قد سجا % % 4(@)(@@) % يرده الخوف ويدعو به % % إذا أطاع الخوف داعي الرجا % % 5(@)(@@) % قد قطع البر فقال الوجا % % واقتحم البحر فقال النجا % % 6(@)(@@) % والتذ بالباقي فحط الخطا % % ومر بالفاني فما عرجا % % 7(@)(@@) % مولاي هذا نهج أهل الهوى % % فاسمح لمن قارب أو لججا % % 8(@)(@@) % واسلك في السير به منهجا % % عن مادح جل وعمن هجا % % 9(@)(@@) % ولتقرأ النسخة واترك إلى % % سر المعاني خطها المدمجا % % 10(@)(@@) % فكيف لا تحرز إرث العلا % % من ورث الأنصار والخزرجا % % PageV01P192 البحر : كامل تام 1(@)(@@) % أهلا بطيف زار في غسق الدجى % % فأعاد ليلتنا صباحا أيلجا % % 2(@)(@@) % فتحت زيارته لصب هائم % % باب القبول وكان قدما مرتجا % % 3(@)(@@) % لله درك من خيال مطمع % % علقت لنا بحباله أبدي الرجا % % 4(@)(@@) % كيف اهتديت وهل بدا لك مضجع % % خطا النحول عليه خط مدمجا % % 5(@)(@@) % يا سالكا بمحبه طرق النوى % % هلا سلكت إلى التواصل منهجا % % 6(@)(@@) % أفديك من حكم تأول حكمه % % فقضى بقتل العاشقين تحرجا % % 7(@)(@@) % أو ما ترى طوفان فيض مدامعي % % يذكي جحيما بالضلوع تأججا % % 8(@)(@@) % أستنبىء البرق الخفوق إذا بدا % % وأساهر الليل الطويل إذا دجا % % 9(@)(@@) % هب لي رضاك فإنني مستشفع % % بعلى أمير المسلمين المرتجا % % PageV01P193 البحر : طويل 1(@)(@@) % إذا سرت سار النور حيث تعوج % % كأنك بدر والبلاد بروج % % 2(@)(@@) % لك الله من بدر على أفق العلا % % يلوح وبحر بالنوال يموج % % 3(@)(@@) % تفقدت أحوال الثغور 
ms43	 بنية % % لها نحو أبواب القبول عروج % % 4(@)(@@) % وسكنتها بالقرب منك ولم تزل % % تهيم هوى من قبله وتهيج % % 5(@)(@@) % مررت على وعد مع الغيث بعدها % % فمنظرها يعد العبوس بهيج % % 6(@)(@@) % فكم تلعة قد كلل النور تاجها % % ورف عليها للنبات نسيج % % 7(@)(@@) % ولا نجد إلا روضة وحديقة % % ولا غور إلا جدول وخليج % % 8(@)(@@) % أيوسف دم للدين تحمي ذماره % % إذا كان للخطب الأبي ولوج % % 9(@)(@@) % بفتية صدق إن دجا ليل حادث % % فهم سرج آفاقهن سروج % % 10(@)(@@) % بقيت قرير العين ما ذر شارق % % وما طاف بالبيت العتيق حجيج % % PageV01P194 البحر : بسيط تام 1(@)(@@) % يا سبتة العزفيين الألى درجوا % % وقد تضوع من أخبارهم أرج % % 2(@)(@@) % ما بال ربعك قد حط العفاء به % % رحل المقيم وأودى حسنك البهج % % 3(@)(@@) % أين المجالس أم أين الفهارس أم % % أين المدارس لا تنبو بها الحجج % % 4(@)(@@) % أين الأساطيل تزجى من سوابحها % % دهما معتقة بيداؤها اللجج % % 5(@)(@@) % أين الصدور إذا ما المعضلات دجت % % هدت إلى القصد من آرائهم حجج % % 6(@)(@@) % يصرفون من الخطى عاسلة % % سمرا تسيل على أعطافها المهج % % 7(@)(@@) % تخرموا لم يكن في الأرض منحدر % % يقي المنون ولا في الجو منعرج % % 8(@)(@@) % قالت تخونني صرف الزمان فلم % % يدخل لي الأنس قلبا من لدن خرجوا % % 9(@)(@@) % وكل ذي جدة يبلى إذا لعبت % % به الليالي وسارت دونه الحجج % % 10(@)(@@) % لعل فارس تحييني مكارمه % % إن الشدائد يأتي إثرها الفرج % % PageV01P195 البحر : منسرح 1(@)(@@) % مولاي ست من الظلام مضت % % كالمسك في صبغة وفي أرج % % 2(@)(@@) % أجزاء ليل مضت كما انطلقت % % كف على سبحة من السبج % % 3(@)(@@) % إلى محل القبول قد عرجت % % بفعلك البر خير منعرج % % 4(@)(@@) % فاسلم أبا سالم لنهج هدى % % جدده منك أي منتهج % % 5(@)(@@) % فليلة المولد الكريم على % % تقواك لله أصدق الحجج % % PageV01P196 البحر : سريع 1(@)(@@) % قل للأشوني ولا تحتشم % % قول امرىء بالحق محتج % % 2(@)(@@) % يا من براه الله لما برا % % من برد صرف ومن ثلج % % 3(@)(@@) % وقشر رمان وشب ومن % % سلك وعفص قابض فج % % 4(@)(@@) % عقدك كافور بلا مرية % % وعقلك الهلهل من بنج % % 5 
ms44	(@)(@@) % ولفظك البارد يا سيدي % % من زمهرير هب في فج % % 6(@)(@@) % لف على المعنى الضعيف القوى % % كخر وقط لف في خمج % % 7(@)(@@) % عجبت من زوجك ما بالها % % لم تستغث منك بقولنج % % 8(@)(@@) % ما بالها لم ينصرف خصمها % % بفالج منك بلا فلج % % 9(@)(@@) % ما بالها لم يعترض خدرها % % خدر على السكنى مع الثلج % % 10(@)(@@) % أظنها قد سحقت فلفلا % % فذلك السحق هو المنج % % PageV01P197 11(@)(@@) % سافته في وج وفي خردل % % ومن لذاك الوجه بالوج % % 12(@)(@@) % ما حال من داناك في بقعة % % ضيقة والله لا يلج % % 13(@)(@@) % ما حال من جاور منك الصبا % % والقرمض ضره مشج % % 14(@)(@@) % فلا فم يعمل في لفظة % % ولا يد تدنو إلى فرج % % 15(@)(@@) % وإن تشوفت إلى زوجة % % ثانية حسبك من زوج % % 16(@)(@@) % عجوز ينير بها تجتزي % % تأتيك للأرياح في فوج % % 17(@)(@@) % تضحك لحييك لها رعدة % % ضحك الحصى في مطرح الموج % % 18(@)(@@) % فسق لها خالك من بعدما % % تجعله للخبث في درج % % 19(@)(@@) % واحمل لها البين وبرد الكلا % % نوعين في تخت وفي خرج % % 20(@)(@@) % وبت بها في مسقط للندى % % في بردة أو مقطع برج % % PageV01P198 21(@)(@@) % وإن أردت الغسل فاعدد له % % خلا وبالقثاء فاستنج % % 22(@)(@@) % وامزج بما ميثا وحب الفنا % % لخلخة متقنة المزج % % 23(@)(@@) % وابن بفج الريح علية % % تقصدها في حذر الهرج % % 24(@)(@@) % واغن بقطن الثلج عن متجر % % يغنيك عن جمع وعن حلج % % 25(@)(@@) % واغزله بالريح وهيء له % % مرمة المصقول والكنج % % 26(@)(@@) % والصن والصنبر فاجعلها % % عيدا كعيد العج والثج % % 27(@)(@@) % واهجر مخيط الثوب واحلق به % % وطف طواف الناس في الحج % % 28(@)(@@) % ما أنت إلا البراد شارد % % من فلك البارد في أوج % % 29(@)(@@) % جفاؤك الفظ الذي نالني % % صيرني للفكر في هرج % % 30(@)(@@) % عمري ما إن نالني مثله % % من ضيم سبتي ولا طنج % % PageV01P199 31(@)(@@) % فاستغفر الله ولا تهف في % % كتب مدى الدهر ولا درج % % 32(@)(@@) % ولا تطع بردك في مثلها % % إلا لعبد لك أو علج % % 33(@)(@@) % لا زلت والشارب من خسة % % والريق من حامض نارنج % % 34(@)(@@) % ينير والجدي إذا عدلا % % حظك من شهر ومن برج 
ms45	 % % 35(@)(@@) % وجئت في صلبك من معشر % % من ولد عور ومن عرج % % 36(@)(@@) % بيض وسود فوق نطع الأذى % % كأنهم قطعات شطرنج % % 37(@)(@@) % تخالهم يا جوج دارت بذي القرنين % % يدعون إلى خرج % % 38(@)(@@) % وزينت عنقك نغنوغة % % كأنها عقدة أترنج % % 39(@)(@@) % ما هب ريح الصر في بقعة % % وارتفع الثلج على مرج % % PageV01P200 البحر : وافر تام 1(@)(@@) % بإسماعيل ثم أخيه قيس % % تأذن ليل همي بانبلاج % % 2(@)(@@) % دم الأخوين دوا جرح قلبي % % وعالجني وحسبك من علاج % % PageV01P201 البحر : كامل تام 1(@)(@@) % إن الهوى لشكاية معروفة % % صبر التصبر من أجل علاجها % % 2(@)(@@) % والنفس إن ألفت مرارة طعمها % % يوما ضمنت لها صلاح مزاجها % % PageV01P202 البحر : كامل تام 1(@)(@@) % لم لا تنال العلا أو يعقد التاج % % والمشتري طالع والشمس هيلاج % % 2(@)(@@) % والسعد يركض في ميدانها مرحا % % جذلان والفلك الدوار هملاج % % PageV01P203 البحر : بسيط تام 1(@)(@@) % قد صح في سنن النبي محمد % % فضلي على الموشي والديباج % % 2(@)(@@) % ولأجل هذا اختصني بلباسه % % ملك العلا الأرضي أبو الحجاج % % PageV01P204 البحر : طويل 1(@)(@@) % إذا سافر السلطان نحو منكب % % ولم أتبعه جاهدا سقط الحرج % % 2(@)(@@) % فمن عقب من ضل في شعبها هوى % % ومن درج من زل في ضنكها درج % % 3(@)(@@) % عسى من أضاق الصدر من حبه لها % % يتيح ببغض منه فيها لنا الفرج % % PageV01P205 البحر : طويل 1(@)(@@) % أأبصرتنا كالشهب والشمس فتية % % تهلل منا البر والبحر والموج % % 2(@)(@@) % رحلنا عن الأوج الرفيع محله % % مراحل شتى ثم عدنا إلى الأوج % % PageV01P206 البحر : طويل 1(@)(@@) % ولما تناهى ورد خدك نضرة % % وأنشأ في طي القلوب هياجا % % 2(@)(@@) % تشوق سراق العيون لقطفه % % فكان له شوك العذار سياجا % % PageV01P207 البحر : كامل تام 1(@)(@@) % قالوا كلفت به غلاما حالكا % % فأجبتهم لي فيه ما يشفي المهج % % 2(@)(@@) % مهما جننت به هوى وصبابة % % علقت فوقي منه حرزا من سبج % % PageV01P208 البحر : طويل 1(@)(@@) % هو النصر باد للعيون صباحه % % فما عذر صدر ليس يبدو انشراحه % % 2(@)(@@) % حديث تهاداه الركائب في السرى % % وتجلى على راح المسرة راحه % % 3(@)(@@) % وآية بشرى هز معطفه الهدى % % لها وتبدى للزمان ارتياحه % % 4(@)(@@) % وأصبح دين الله قد عز 
ms46	 جاره % % بموقعها والكفر هيض جناحه % % 5(@)(@@) % وآثار ملك ظاهر الفضل لم يزل % % يشفع فينا هديه وصلاحه % % 6(@)(@@) % إذا دهم الروع استقل دفاعه % % وإن أخلف الغيث استهل سماحه % % 7(@)(@@) % بيوسف لاح الحق أبلج واضحا % % وأصبح دين الله فازت قداحه % % 8(@)(@@) % يقصر نفح الطيب عن طيب ذكره % % ويزري بأزهار الرياض امتداحه % % 9(@)(@@) % تلافيت بالعزم البلاد وأهلها % % وقد عصفت للكفر فيها رياحه % % 10(@)(@@) % وحفت به الأعداء من كل جانب % % كما حف بالخصر الهضيم وشاحه % % PageV01P209 11(@)(@@) % وقدت إليها الجيش والعسكر الذي % % تروي عواليه وتروى صحاحه % % 12(@)(@@) % فدوخت ما ضمت عليه بلاده % % ونفلت ما زرت عليه بطاحه % % 13(@)(@@) % وصبحت جمع الكفر في مستقره % % فخابت مساعيه وساء صباحه % % 14(@)(@@) % فبين صريع بالفلاة مجدل % % طريح وعان لا يرجى سراحه % % 15(@)(@@) % ومن بين مكلوم بحد سيوفها % % تسيل على الأعقاب منه جراحه % % 16(@)(@@) % وأقبل منصور اللواء مؤيدا % % ذوابله قد ضرجت وصفاحه % % 17(@)(@@) % إذا الخطب لم يسمح بفضل قياده % % ولاقيته بالصبر لان جماحه % % 18(@)(@@) % وإن أنت في روض الجهاد غرسته % % تبسم عن زهر الفتوح افتتاحه % % 19(@)(@@) % ومهما استعنت الله في الأمر وحده % % أتاك به من كل أمر نجاحه % % 20(@)(@@) % فما ضل من كان الإله دليله % % وما ذل من حسن اليقين سلاحه % % PageV01P210 21(@)(@@) % فهنيته صنعا جميلا وموردا % % من النصر يندى في القلوب قراحه % % 22(@)(@@) % ودمت عزيز الجار سيفك فاصل % % وسيبك ممنوح النوال مباحه % % 23(@)(@@) % ودونكها مني إليك بديهة % % نتيجة حب طاب فيك صراحه % % PageV01P211 البحر : كامل تام 1(@)(@@) % خذها فقد وضح الصباح ولاحا % % والروض يهدي عرفه النفاحا % % 2(@)(@@) % ما زال يكتم من حديث نسيمه % % والآن أمكنه الحديث فباحا % % 3(@)(@@) % لما رأى جيش الصباح مشمرا % % عمت مضاربه ربى وبطاحا % % 4(@)(@@) % والأفق يرفع منه بندا مذهبا % % ويسل من بيض البروق صفاحا % % 5(@)(@@) % سل الجداول أنصلا مصقولة % % تبدو وهز من الغصون رماحا % % 6(@)(@@) % والزهر تسقط للغروب كما ذوى % % زهر الرياض وفارق الأدواحا % % 7(@)(@@) % والطير يدعو للصبوح مكررا % % فتراه قد نفض الجناح وصاحا % % 8(@)(@@) % فكأنما الظلماء طرف أدهم % % أخذ العنان فما يفيق جماحا % % 9(@)(@@) % لا توقد 
ms47	 المصباح واعلم أن لي % % من وجه من أحببته مصباحا % % 10(@)(@@) % حث الكؤوس وهاتنيها قهوة % % تنفي الهموم وتجلب الأفراحا % % PageV01P212 11(@)(@@) % من كف فاتنة اللحاظ غريرة % % سكرى الجفون وما سقين الراحا % % 12(@)(@@) % هي روضة تجنيك بين لثاثها % % خمرا ومن وجناتها تفاحا % % 13(@)(@@) % فإذا اعتنقت أو ارتشفت فإنما % % عانقت غصنا وارتشفت أقاحا % % 14(@)(@@) % وامزج بصرف الراح عذب رضابها % % ما ضر أن خلط الحرام مباحا % % 15(@)(@@) % قامت تقول وفي فتور جفونها % % سنة الكرى مولاي عمت صباحا % % 16(@)(@@) % واستنطقت عود الغناء فلم نجد % % إذ ذاك في خلع العذار جناحا % % 17(@)(@@) % واستنطقت عودا بمدحة يوسف % % مولى لنا شمل الوجود سماحا % % 18(@)(@@) % فسرى السرور بنا إلى أن لم نطق % % صبرا وكدنا نبذل الأرواحا % % 19(@)(@@) % رب الأيادي البيض من بثنائه % % زان القريض وعطر الأمداحا % % 20(@)(@@) % ذو همة علياء مد المشترى % % طرفا إلى غاياتها طماحا % % PageV01P213 21(@)(@@) % يزجي من النقع المثار سحائبا % % ركبت من العزم الشديد رياحا % % 22(@)(@@) % ويزيرها أرض العدو صوافنا % % تختال زهوا في الوغى ومراحا % % 23(@)(@@) % تنميه من أبناء نصر سادة % % سنوا الهدى والعدل والإصلاحا % % 24(@)(@@) % إن أغلقت أبوابها أيدي العدا % % جعل الإله سيوفهم مفتاحا % % 25(@)(@@) % يا واحد المجد الذي آثاره % % تروي حسانا في الزمان صحاحا % % 26(@)(@@) % أنسيتنا بحسامك الماضي الظبا % % ولوائك المنصور والسفاحا % % 27(@)(@@) % لا زال ملكك ساميا في عزة % % تستصحب الإمساء والإصباحا % % 28(@)(@@) % ما غردت وأرقاء فوق أراكة % % تبكي الهديل وما صباح لاحا % % PageV01P214 البحر : طويل 1(@)(@@) % أثار سناها والديار نوازح % % سنا بارق من مطلع الوحي لائح % % 2(@)(@@) % ركائب تستف الفلا فكأنها % % سفائن في بحر السراب سوابح % % 3(@)(@@) % إليك رسول الله شدت نسوعها % % وغادرها الإدلاج وهي طلائح % % 4(@)(@@) % تحملن من زوار قبرك فتية % % تواصل في ذات الهدى وتنازح % % 5(@)(@@) % هم القضب إن مالوا مع الذكر خشية % % وإن رجعوه فالحمام الصوادح % % 6(@)(@@) % حنانيكما يا صاحبي بمغرم % % جوانحه نحو الحجيج جوانح % % 7(@)(@@) % أقام يعاني الشوق عن قدر ومن % % أقام على عذر كمن هو رائح % % 8(@)(@@) % تداني هوى لما تباعد منزلا % % فها هو دان في الزيارة نازح % % 9(@)(@@) % وها أنت 
ms48	 يا إنسان عين يقينه % % بروضة من حاز المحاسن سارح % % 10(@)(@@) % كدحت إلى رب الجمال ملاقيا % % فيا أيها الإنسان إنك كادح % % PageV01P215 11(@)(@@) % هنيئا لكم يا زائري تربة الهدى % % بلوغ المنى والسعي في الله ناجح % % 12(@)(@@) % حللتم بمثوى خير من وطئ الثري % % وأكرم من ضمت صفا وصفائح % % 13(@)(@@) % معاعد فيهن الملائكة العلا % % غواد بتنزيل الكتاب روانح % % 14(@)(@@) % أفاء عليها الله أفياء نوره % % ففيهن من دار السلام ملامح % % 15(@)(@@) % تبوأها من خيرة الرسل من سمت % % به ليلة المعراج فيها المطامح % % 16(@)(@@) % وبالأفق الأعلى من العرش قد سمت % % سجاياه بالله تلك السجائح % % 17(@)(@@) % رسول البرايا جاء بالصدق فامحت % % بنور هداه الترهات الصحاصح % % 18(@)(@@) % مبلغهم أهدى رسالات ربه % % أمين على الإسلام في الله ناصح % % 19(@)(@@) % مغيث ودعوى المذنبين خطيئتي % % ونفسي نفسي والشهود الجوارح % % 20(@)(@@) % له المعجزات الزاهرات كأنها % % بروق بآفاق البقين لوائح % % PageV01P216 21(@)(@@) % كإخباره بالغائبات فعنده % % لأبواب أسرار الغيوب مفاتح % % 22(@)(@@) % وفي يوم إذ رمى قبضة الثرى % % فولت جموع الشرك وهي جوامح % % 23(@)(@@) % وأعطى عسيب النخل في حومة الوغى % % فهز حسام منه للدم سافح % % 24(@)(@@) % دعا الله يستسقي فلبت سماؤه % % بواكفه القطر السحاب الدوالح % % 25(@)(@@) % وألقى بأخلاف الشياه يمينه % % فجادت به وهي الضروع الشحائح % % 26(@)(@@) % وروى ظمآء الجيش ماء بنانه % % فلله أمواه هناك سوائح % % 27(@)(@@) % وفي ليلة الميلاد لاحت شواهد % % توالت بها لله فينا المنائح % % 28(@)(@@) % أضاءت قصور الشام منهن وانجلت % % معالم ما ضمت عليه الأباطح % % 29(@)(@@) % وهد لها إيوان كسرى مهابة % % وأخمد من نيران فارس لافح % % 30(@)(@@) % وغاض بها وادي السماوة فانشنت % % تقلص ذيل الخصب فيه المسارح % % PageV01P217 31(@)(@@) % وأبصر سيف الملك رؤيا فأصبحت % % لتذكارها ترتاع منه الجوارح % % 32(@)(@@) % وأعلمه كهانة أن أرضه % % أتيح لها من سيد العرب فاتح % % 33(@)(@@) % فمن كرسول الله للخلق ملجأ % % إذا طوحتهم للزمان الطوائح % % 34(@)(@@) % عنايته بالمذنبين عظيمة % % إذا عظمت يوم الحساب الفضائح % % 35(@)(@@) % وإنا اقتدينا فاهتدينا بصحبه % % وما صحبه إلا النجوم اللوائح % % 36(@)(@@) % أبادوا شياطين الضلال وزينت % % سماء رسوم الحق منهم مصابح % % 37(@)(@@) % وأذهب ليل الشك صبح يقينهم % % فأسفر 
ms49	 من فجر الحقائق واضح % % 38(@)(@@) % وقامت على الدين الحنيف أدلة % % تبين مرجوح بهن وراجح % % 39(@)(@@) % أولاك الألى بالأنفس اشتروا الهدى % % فتجرهم في جنة الخلد رابح % % 40(@)(@@) % رعوا لرسول الله حق وصاته % % فذاعت بهم في المسلمين النصائح % % PageV01P218 41(@)(@@) % ومازال في الإسلام منهم أيمة % % تناضل عن دين الهدى وتكافح % % 42(@)(@@) % وتنجب من أبنائها كل ناصر % % يفل شباة الخطب والخطب فادح % % 43(@)(@@) % فمن مثل مولانا الخليفة يوسف % % إذا عدد الفخر الملوك الجحاجح % % 44(@)(@@) % أياديه سحت في الورى بركاتها % % فأيامهم بيض الليالي صوالح % % 45(@)(@@) % إمام الهدى يا خير من بذل اللهى % % وشادت علاه المعلوات الصرائح % % 46(@)(@@) % إذا اشتبهت آيى الخلائف في الندى % % فأي نداك المحكمات الفواتح % % 47(@)(@@) % وإن رويت عنهم عوالي علائهم % % فآثار علياك الحسان الصحائح % % 48(@)(@@) % وإن مدح في المكرمات تعارضت % % فأنت إلى الأدنى من الله جانح % % 49(@)(@@) % أقمت لميلاد الرسول شعائرا % % بها الله عن ذنب المسلمين صافح % % 50(@)(@@) % تباهت بأمداح الرسول محمد % % فطابت بذكراها الرياح النوافح % % PageV01P219 51(@)(@@) % إذا نشرت فيها صحائف مدحه % % وذاعت بنشر الحمد منها الممادح % % 52(@)(@@) % تلقتك من أرض الهنود لطائم % % ينم بها من مسك دارين فائح % % 53(@)(@@) % هي الليلة الغراء حسبك ليلة % % بها نجم دين الله أزهر لائح % % 54(@)(@@) % إذا ما أضاءت لي مطالع نورها % % فقلبي لها زند الفصاحة قادح % % 55(@)(@@) % فيا ليلة الميلاد دونك مدحة % % وأيسر ما تهدى إليك المدائح % % 56(@)(@@) % وإن أنت بالإقبال قابلت وفدها % % فتسمح بالإمداح فيك القرائح % % 57(@)(@@) % وأنت لها أحييت يا محي الهدى % % فروضا بهن الله صدرك شارح % % 58(@)(@@) % يمينا لقد قرت بدولتك الرضا % % عيون بروض العدل منك سوارح % % 59(@)(@@) % فما الناس طرا غير صنفين حامد % % على فضل ما تولي وآخر مادح % % 60(@)(@@) % فدم ناصر للدين ما حن نازح % % وما افتن في غصن الأراكة صادح % % PageV01P220 البحر : طويل 1(@)(@@) % أمن جانب الغربي نفحة بارح % % سرت بتباريح الجوى في الجوارح % % 2(@)(@@) % قدحت بها زند الغرام وإنما % % تجافيت لدين السلو لقادح % % 3(@)(@@) % وما هي إلا نسمة حاجرية % % رمى الشوق منها كل قلب بجارح % % 4(@)(@@) % رجعنا لها من 
ms50	 غير سكر كأنها % % شمائل أخلاق الشريف ابن راجح % % 5(@)(@@) % فتى هاشم سبقا إلى كل غاية % % وصبرا مغار الحبل في كل فادح % % 6(@)(@@) % أصيل العلا جم السيادة ذكره % % طراز نضار في برود المدائح % % 7(@)(@@) % وفرقان مجد يصدع الشك نوره % % حبا الله منه كل صدر بشارح % % 8(@)(@@) % وفارس ميدان البيان إذا انتضى % % صحائفه أنست مضاء الصفائح % % 9(@)(@@) % رقيق كما راقتك نغمة ساجع % % وجزل كما راعتك صولة جارح % % 10(@)(@@) % إذا ما احتبى مسحنفرا في بلاغة % % وخيض خضم القول منه بسابح % % PageV01P221 11(@)(@@) % وقد شرعت في مجمع القول نحوه % % أسنة حرب للعيون اللوامح % % 12(@)(@@) % فما ضعضعت منه لصولة صادح % % ولا ذهبت منه بحكمة ناصح % % 13(@)(@@) % تذكرت قسا قائما في عكاظه % % وقد غص بالشم الأنوف الجحاجح % % 14(@)(@@) % ليهنك شمس الدين ما حزت من علا % % خواتمها موصولة بالفواتح % % 15(@)(@@) % رعى الله ركبا أطلع الصبح مصفرا % % بمرآك من فوق الربا والأباطح % % 16(@)(@@) % ولله ما أهدته كوماء أوضعت % % برحلك في قفر عن الإنسي نازح % % 17(@)(@@) % أقول لقومي عندما حط كورها % % وساعدها السعدان وسط المسارح % % 18(@)(@@) % ذروها وأرض الله لا تعرضوا لها % % بمعرض سوء فهي ناقة صالح % % 19(@)(@@) % إذا ما أردنا القول فيك فمن لنا % % بطوع القوافي وانبعاث القرائح % % 20(@)(@@) % بقيت منى نفس ونجعة رائد % % ومورد ظمآن وكعبة مادح % % PageV01P222 21(@)(@@) % ولا زلت تلقى السهل والرحب حيثما % % أرحت السرى من كل غاد ورائح % % PageV01P223 البحر : كامل تام 1(@)(@@) % يا قادما وافى بكل نجاح % % أبشر بما تلقاه من أفراح % % 2(@)(@@) % راحت تذكرني كؤوس الراح % % والقرب يخفض للجناح جناح % % 3(@)(@@) % وسرت تدل على القبول كمثل ما % % دل النسيم على انبلاج صباح % % 4(@)(@@) % حسناء قد عنيت بحسن صفائها % % عن دملج وقلادة ووشاح % % 5(@)(@@) % أمست تحض عن اللياذ بمن جرت % % بسعوده الأقلام في الألواح % % 6(@)(@@) % بخليفة الله المؤيد فارس % % قمر المعالي الأزهر الوضاح % % 7(@)(@@) % ما شئت من همم ومن شيم غدت % % كالروض أو كالزهر في الأدواح % % 8(@)(@@) % فضل الملوك فليس يدرك شأوه % % أنى يقاس الغمر بالضحضاح % % 9(@)(@@) % أنسى بني عباسهم بلوائه % % المنصور أو بحسامه السفاح % % 10 
ms51	(@)(@@) % وغدت معاني الملك لما حلها % % ترسى ببدر هدى وبحر سماح % % PageV01P224 11(@)(@@) % وحياة من أهداك تحفة قادم % % في العرف منها راحة الأرواح % % 12(@)(@@) % ما زلت أجعل ذكره وثناءه % % روحي وريحاني الأريج وراح % % 13(@)(@@) % ولقد تمازج حبه بجوارحي % % كتمازج الأجسام في الأرواح % % 14(@)(@@) % ولو أنني أبصرت يوما في يدي % % أمري لطرت إليه دون جناح % % 15(@)(@@) % فالآن ساعدني الزمان وأيقنت % % من قربه نفسي بفوز قداح % % 16(@)(@@) % إيه أبا عبد الإله وإنه % % لنداء ود في علاك صراح % % 17(@)(@@) % أما إذا استنجدتني من بعدما % % ركدت لما جنت الخطوب رياح % % 18(@)(@@) % فإليكها مهزولة وأنا الذي % % قررت عجزي واطرحت سلاحي % % PageV01P225 البحر : كامل تام 1(@)(@@) % مولاي منذ بعدت دياري لا تسل % % عن طول ليلي وارتقاب صباح % % 2(@)(@@) % جرح البعاد فؤاد عبدك فهو من % % أجل الترحل عنك رهن جراح % % 3(@)(@@) % لم نلق بعدك ما يلذ لناظري % % من حسن أرجاء وزهر بطاح % % 4(@)(@@) % وبقيت جسما دون روح لا تسل % % عن حال أجسام بلا أرواح % % 5(@)(@@) % وكأنني مذ غاب وجهك ذاهب % % في الليلة الظلماء بلا مصباح % % 6(@)(@@) % والآن حين قربت منك فآنست % % نفسي وعادت غضة أفراح % % 7(@)(@@) % لو كان يا مولاي أمري في يدي % % يوما لطرت إليك دون جناح % % PageV01P226 البحر : كامل تام 1(@)(@@) % السعد هذا بابه المفتوح % % والعز هذا سره المشروح % % 2(@)(@@) % آثار مولانا الإمام محمد % % مثل الكواكب في السماء تلوح % % 3(@)(@@) % إن كان دين الله جل جلاله % % جسما فدولته العلية روح % % PageV01P227 البحر : خفيف تام 1(@)(@@) % بلد قد غزاه صرف الليالي % % وأباح الحريم منه مبيح % % 2(@)(@@) % فالذي خر من بناه قتيل % % والذي خر منه بعض جريح % % 3(@)(@@) % وكأن الذي يزور طبيب % % قد تأتى له به التشريح % % 4(@)(@@) % أعجمت منه أربع وطلول % % صال قدما بها اللسان الفصيح % % 5(@)(@@) % كم معان غبت بتلك المعاني % % وجمال أخفاه ذاك الضريح % % 6(@)(@@) % وملوك تعبدوا الدهر حتى % % أصبح الدهر وهو عبد صريح % % 7(@)(@@) % دوخوا نازح البسيطة حتى % % نال ما شاء ذابل وصفيح % % 8(@)(@@) % حين شبت لهم من الباس نار % % ثم هبت لهم من النصر ريح % % 9(@)(@@) % أثر 
ms52	 يندب المؤثر لما % % طال بعد الدنو منه النزوح % % 10(@)(@@) % فقلوب النجوم تخفق وجدا % % وعيون السحاب حزنا تفوح % % PageV01P228 11(@)(@@) % ساكن الدار روحها كيف يبقى % % جسد بعدما تولى الروح % % PageV01P229 البحر : طويل 1(@)(@@) % ولم لا ولي قلب لبعدك خافق % % وجفن على حكم الدموع جريح % % 2(@)(@@) % تنازعني الضدان فيك على النوى % % فجسمي سقيم والوداد صحيح % % 3(@)(@@) % فلو أن ليلى أبصرتني أقسمت % % لما غال قيس بن الذريح ضريح % % PageV01P230 البحر : منسرح 1(@)(@@) % حييت يا مختط سيف ابن نوح % % بكل مزن يغتدي أو يروح % % 2(@)(@@) % وحمل الريحان ريح الصا % % أمانة فيك إلى كل روح % % 3(@)(@@) % دار أبي الفضل عياض التي % % أضحت برياه رياضا تفوح % % 4(@)(@@) % يا ناقل الآثار يعنى بها % % وواصلا في العلم سير الجموح % % 5(@)(@@) % طرفك في الفخر بعيد المدى % % طرفك للمجد شديد الطموح % % 6(@)(@@) % كفاك إعجازا كتاب الشفا % % والصبح لا ينكر عند الوضوح % % 7(@)(@@) % لله ما أجزلت فينا به % % من منحة تقصر عنها المنوح % % 8(@)(@@) % روض من العلم همى فوقه % % من صيب الفكر الغمام السفوح % % 9(@)(@@) % فمن بيان الحق زهر ند % % ومن لسان الصدق طير صدوح % % 10(@)(@@) % تأرج العرف وطاب الجنى % % وكيف لا يطعم أو لا يفوح % % PageV01P231 11(@)(@@) % وحلة من طيب خير الورى % % في الجيب والأعطاف منها نضوح % % 12(@)(@@) % ومعلم للدين شيدته % % فهذه الأعلام منه تلوح % % 13(@)(@@) % فقل لهامان كذا أو فلا % % يا من أضل الرشد تبنى الصروح % % 14(@)(@@) % في أحسن التقوم أنشأته % % خلقا جديدا بين جسم وروح % % 15(@)(@@) % فعمره المكتوب لا ينقضي % % وإن تقضى عمر سام ونوح % % 16(@)(@@) % كأنه في الحفل ريح الصبا % % وكل عطف فهو غصن مروح % % 17(@)(@@) % ما عذر مشغوف بخير الورى % % إن هاج منه الذكر أن لا يبوح % % 18(@)(@@) % عجبت من أكباد أهل الهوى % % وقد سطا البعد وطال النزوح % % 19(@)(@@) % إن ذكر المحبوب سالت دما % % ما هن أكباد ولكن جروح % % 20(@)(@@) % يا سيد الأوضاع يا من له % % بسيد الأرسال فضل الرجوح % % PageV01P232 21(@)(@@) % يا من له الفخر على غيره % % والشهب تخفى عند إشراف يوح % % 22(@)(@@) % يا خير مشروح وفى واكتفى % % منه ابن 
ms53	 مرزوق بخير الشروح % % 23(@)(@@) % فتح من الله حباه به % % ومن جناب الله تأتي الفتوح % % PageV01P233 البحر : طويل 1(@)(@@) % ملكت رسول الله رقي فمن يبرح % % وأوليتني الحظ الرغيب ومن يشرح % % 2(@)(@@) % فلا كان لي جفن لبعدكم لم يصب % % ولا كان لي قلب بقربك لم يفرح % % 3(@)(@@) % فسعيك مدعى لا يخيب من نأى % % ورعيك مرعى لا يضق بمن يسرح % % 4(@)(@@) % فداك فؤاد ضم حبك حبة % % كما يودع المبذور في الأرض أو يطرح % % 5(@)(@@) % فأصبح غصنا ذا مروح ونعمة % % وما عذره مهما ذكرت فلم يمرح % % 6(@)(@@) % رجاؤك سؤلي كلما جرح الأسى % % ولا يستوي آسي الكلوم ومن يجرح % % 7(@)(@@) % وقد كان في قلبي لبعدك قرحة % % وفودي لم يشهب وسني لم يقرح % % 8(@)(@@) % فكيف وقد رانت عليه ذنوبه % % وإن أنا لم أضرح فويلي متى أضرح % % 9(@)(@@) % فضلت النبيئين الكرام مزية % % وكم بين رب اشرح وبين ألم نشرح % % PageV01P234 البحر : كامل تام 1(@)(@@) % هل كنت تعلم في هبوب الريح % % نفسا يؤجج لاعج التبريح % % 2(@)(@@) % أهدتك من شيح الحجاز تحية % % غاضت بها غرض الفجاج الفيح % % 3(@)(@@) % بالله قل لي كيف نيران الهوى % % ما بين ريح بالفلاة وشيح % % 4(@)(@@) % وخضيبة المنقار تحسب أنها % % نهلت بمورد دمعي المسفوح % % 5(@)(@@) % فاحت بما تخفي وناحت في الدجى % % فرأيت في الآماق دعوة نوح % % 6(@)(@@) % نطقت بما يخفيه قلبي أدمعي % % ولطالما صمتت عن التصريح % % 7(@)(@@) % عجبا لأجفاني حملن شهادة % % عن خافت بين الضلوع جريح % % 8(@)(@@) % ولقبل ما كتبت رواة مدامعي % % في طرتيها حلية التجريح % % 9(@)(@@) % جاد الحمى بعدي وأجراع الحمى % % جود تكل به متون الريح % % 10(@)(@@) % هن المنازل ما فؤادي بعدها % % سال ولا وجدي بها بمريح % % PageV01P235 11(@)(@@) % حسبي ولوعا أن أزور بفكرتي % % زرواءها والجسم رهن نزوح % % 12(@)(@@) % فأبث فيها من حديث صبابتي % % وأحث فيها من جناح جنوحي % % 13(@)(@@) % ودجنة كادت تضل بني السرى % % لولا وميضا بارق وصفيح % % 14(@)(@@) % رعشت كواكب جوها فكأنها % % ورق تقلبها بنان شحيح % % 15(@)(@@) % صابرت منها لجة مهما ارتمت % % وطمت رميت عبابها بسبوح % % 16(@)(@@) % حتى إذا الكف الخضيب بأفقها % % مسحت بوجه للصباح 
ms54	 صبيح % % 17(@)(@@) % شمت المنى وحمدت إدلاج السرى % % وزجرت للآمال كل سنيح % % 18(@)(@@) % فكأنما ليلى نسيب قصيدتي % % والصبح فيه تخلصي لمديح % % 19(@)(@@) % لما حططت لخير من وطيء الثرى % % بعنان كل مولد وصريح % % 20(@)(@@) % رحمى إله العرش بين عباده % % وأمينه الأرضى على ما يوحي % % PageV01P236 21(@)(@@) % والآية الكبرى التي أنوارها % % ضاءت أشعتها بصفحة يوح % % 22(@)(@@) % رب المقام الصدق والآي التي % % راقت بها ورقات كل صحيح % % 23(@)(@@) % كهف الأنام إذا تفاقم معضل % % مثلوا بساحة بابه المفتوح % % 24(@)(@@) % يردون منه على مثابة راحم % % جم الهبات عن الذنوب صفوح % % 25(@)(@@) % لهفي على عمر مضى أنضيته % % في ملعب للترهات فسيح % % 26(@)(@@) % يا زاجر الوجناء يعتسف الفلا % % والليل يعثر في فضول مسوح % % 27(@)(@@) % يصل السرى سبقا إلى خير الورى % % والركب بين موسد وطريح % % 28(@)(@@) % لي في حمى ذاك الضريح لبانة % % إن أصبحت لبنى أنا ابن ذريح % % 29(@)(@@) % وبمهبط الروح الأمين أمانة % % واليمن فيها والأمان لروحي % % 30(@)(@@) % يا صفوة الله المكين مكانه % % يا خير مؤتمن وخير نصيح % % PageV01P237 31(@)(@@) % أقرضت فيك الله صدق محبتي % % أيكون تجري فيك غير ربيح % % 32(@)(@@) % حاشا وكلا أن تخيب وسائلي % % أو أن أرى مسعاي غير نجيح % % 33(@)(@@) % إن عاق عنك قبيح ما كسبت يدي % % يوما فوجه العفو غير قبيح % % 34(@)(@@) % واخجلتا من حلبة الفكر التي % % أغريتها بغرامي المشروح % % 35(@)(@@) % قصرت خضاها بعدما ضمرتها % % من كل موفور الجمام جموح % % 36(@)(@@) % مدحتك آيات الكتاب فما عسى % % يثني على علياك نضم مديحي % % 37(@)(@@) % وإذا كتاب الله أثنى مفصحا % % كان القصور قصار كل فصيح % % 38(@)(@@) % صلى عليك الله ما هبت صبا % % فهفت بغصن للرياض مرووح % % 39(@)(@@) % واستأثر الرحمن جل جلاله % % عن خلقه بخفي سر الروح % % PageV01P238 البحر : كامل تام 1(@)(@@) % عن باب والدك الرضا لا أبرح % % يأسوا الزمان لأجلها أو يجرح % % 2(@)(@@) % ضربت خيامي في حماه فصبيتي % % ترعى الجميم به وبهمي تسرح % % 3(@)(@@) % حتى يراعي وجهه في وجهتي % % بعناية تشفي الصدور وتشرح % % 4(@)(@@) % أيسوغ عن مثواه سيري خائبا % % ومنابر الدنيا بذكرك تصدح % % 5(@)(@@) % أنا في حماه وأنت أبصر بالذي % % يرضيه 
ms55	 منك فوزن عقلك أرجح % % 6(@)(@@) % في مثلها سيف الحمية ينتضى % % في مثلها زند العزيمة يقدح % % 7(@)(@@) % وعسى الذي بدأ الجميل يعيده % % وعسى الذي سد المذاهب يفتح % % PageV01P239 البحر : كامل تام 1(@)(@@) % مر الذباب على فم ابن كماشة % % فانفض عسكره وهيض جناحه % % 2(@)(@@) % فكأنهم صرعى وقد عصفت بهم % % مسمومة عند الصباح رياحه % % 3(@)(@@) % سرعان حرب من بني حرب وقد % % حمل السلاح عليهم سفاحه % % 4(@)(@@) % أعلي جل الله كم من حائن % % ناجيته صبحا فساء صباحه % % PageV01P240 البحر : طويل 1(@)(@@) % وذي حيل يعي التقية أمرها % % مكايده في لجة الليل تسبح % % 2(@)(@@) % يدب شبول الليث والليث ساهر % % ويسرق ناب الكلب والكلب ينبح % % PageV01P241 البحر : سريع 1(@)(@@) % قلت والناقوس في مرتش % % والليل قد مد علينا الجناح % % 2(@)(@@) % أغربت طولا يا غراب الدجى % % فلم تر الليلة عنا براح % % 3(@)(@@) % فخذ على نفسك لا تغترر % % قد حرك الجلجل بازي الصباح % % PageV01P242 البحر : بسيط تام 1(@)(@@) % أنظر إليها تجد حب الملوك بها % % وقد حكى نورها المبيض حين فتح % % 2(@)(@@) % قطنا تراكم في الأغصان إذ قذفت % % لفائف الثلج في أعلاه قوس قزح % % PageV01P243 البحر : كامل تام 1(@)(@@) % لك عاذل بثقيله وخفيفه % % بين الندام غبوقه وصبوحه % % 2(@)(@@) % أما الخفيف فكفه ودماغه % % أما الثقيل فقوله أو روحه % % PageV01P244 البحر : خفيف تام 1(@)(@@) % أنا من خالص الحديد غدير % % فترى وسطي الردى وهو سابح % % 2(@)(@@) % أنا سعد السعود في كف مولاي % % وإن قيل في سعد الذابح % % PageV01P245 البحر : متقارب تام 1(@)(@@) % وقاني أذى الناس أخذ الدواء % % وجاء بعذر لرفع الجناح % % 2(@)(@@) % كذا الحبارى إذا ضويقت % % يدافع عنها سلاح السلاح % % PageV01P246 البحر : متقارب تام 1(@)(@@) % أخي لا تقل كذبا إن نطقت % % فاللناس في الصدق فضل وضح % % 2(@)(@@) % وخف إن كذبت طرو افتضاح % % فما كذب الفجر إلا افتضح % % PageV01P247 البحر : مجتث 1(@)(@@) % قال من يعنى بأمري % % ليت ربي قد أراحك % % 2(@)(@@) % وطنا تسمع فيه % % أنعم الله صباحك % % PageV01P248 البحر : كامل تام 1(@)(@@) % عبد العزيز خليفة الله الذي % % ظفر الهدى منه بفوز قداحه % % 2(@)(@@) % ولذاك ما أهدت علاه هدية % % قد أعربت عن بأسه وسماحه % % 3(@)(@@) % حي 
ms56	 بها وطن الجهاد تحية % % أبدت عهود نشاطه ومراحه % % 4(@)(@@) % فالخيل عن أعراقه والتمر عن % % أخلاقه والطيب عن أقداحه % % 5(@)(@@) % ورقيقها من ليله الجم التقى % % وكتابها من فجره وصباحه % % 6(@)(@@) % وسلاحها ماض مضاء عزيمه % % أو سابغ واق سبوغ صلاحه % % 7(@)(@@) % جددت عهد أبيك في إمدادها % % لما قبست النور من مصباحه % % 8(@)(@@) % لا زال سعيك في الخلافة ناجحا % % تستمطر الدنيا مهب رياحه % % 9(@)(@@) % ولواء نصرك يستهل غمامة % % تذر الفتوح جثى بقضب رماحه % % PageV01P249 البحر : خفيف تام 1(@)(@@) % ما على القلب بعدكم من جناح % % أن يرى طائرا بغير جناح % % 2(@)(@@) % وعلى الشوق أن يشب إذا هب % % بأنفسكم نسيم الصباح % % 3(@)(@@) % جيرة الحي والحديث شجون % % والليالي تلين بعد الجماح % % 4(@)(@@) % أترون السلو خامر قلبي % % بعدكم لا وفالق الإصباح % % 5(@)(@@) % ولو أني أعطي اقتراحي على % % الأيام ما كان بعدكم باقتراح % % 6(@)(@@) % ضايقتني فيكم صروف الليالي % % واستدارت علي دور الوشاح % % 7(@)(@@) % وسقتني كأس الفراق دهاقا % % في اغتباق مواصل باصطباح % % 8(@)(@@) % واستباحت من جدتي وفتائي % % حرما لم أخله بالمستباح % % 9(@)(@@) % قصفت صعدة انتصاري وفلت % % غرب عزمي المعد يوم كفاح % % 10(@)(@@) % لم تدع لي من السلاح سوى مغفر % % شيب أهون به من سلاح % % PageV01P250 11(@)(@@) % عالجتني به وفي الوقت فضل % % لاهتزازي إلى الهوى وارتياح % % 12(@)(@@) % فكأن الشباب طيف خيال % % أو وميض خبا عقيب التماح % % 13(@)(@@) % ليل أنس دجى وأقصر بليل % % جاذبت برده يمين صباح % % 14(@)(@@) % صاح والوجد مشرب والورى صنفان % % من منتش وآخر صاح % % 15(@)(@@) % يا ترى والنفوس أسرى الأماني % % مالها عن وثاقها من براح % % 16(@)(@@) % هل يباح الورود بعد ذياد % % أو يتاح اللقاء بعد انتزاح % % 17(@)(@@) % وإذا أعوز الجسوم التلاقي % % ناب عنه تعارف الأرواح % % 18(@)(@@) % جاد عهد الهوى من السحب هام % % مستهل الوميض ضافي الجناح % % 19(@)(@@) % كلما اخضل الربوع بكاء % % ضحكت فوقها ثغور الأقاح % % 20(@)(@@) % عادني من تذكر العهد عيد % % كان مني للعين عيد الأضاح % % PageV01P251 21(@)(@@) % سفحت فيه للدموع دماء % % فهي فوق الخدود ذات انسياح % % 22(@)(@@) % وركاب سروا وقد شمل الليل % % بمسح الدجى جميع النواحي % % 23(@)(@@) % وكأن الظلام عسكر 
ms57	 زنج % % ونجوم الدجى نصول الرماح % % 24(@)(@@) % حملت منهم ظهور المطايا % % أي جد بحت وعزم صراح % % 25(@)(@@) % ستروا الوجد وهو نار وكان الستر % % يجدي لولا هبوب الرياح % % 26(@)(@@) % خلفوني من بعدهم ناكس الطرف % % ثقيل الخطا مهيضا جناحي % % 27(@)(@@) % وحدوها مثل القسي ضمورا % % قد برت منهم سهام قداح % % 28(@)(@@) % وطووا طوع لاعج الشوق والوجد % % إلى الأبطحي غبر البطاح % % 29(@)(@@) % مصطفى الكون من ظهور النبيئين % % هداة الأنام سبل الفلاح % % 30(@)(@@) % حجة الله حكمة الله نور الله % % في كل غاية وافتتاح % % PageV01P252 31(@)(@@) % حاشر الخلق عاقب الرسل % % والمثبت بالله بعدهم والماح % % 32(@)(@@) % صاحب المعجزات لا يتمارى % % العقل في آيها الحسان الصحاح % % 33(@)(@@) % من جماد يقر أو قمر ينشق % % والماء من بنان الراح % % 34(@)(@@) % دعوة الأنبياء منتظر الكهان % % دعوى البشير باستفتاح % % 35(@)(@@) % مظهر الوحي مطلع الحق معنى الخلق % % فتح المهيمن الفتاح % % 36(@)(@@) % أي غيث من رحمة الله هام % % وسراج بهديه وضاح % % 37(@)(@@) % ما الذي يشرح امرؤ في رسول % % عاجل الله صدره بانشراح % % 38(@)(@@) % شقه الروح ثم طهر منه القلب % % من بعد بالبرود القراح % % 39(@)(@@) % مدحتك الأيات يا خاتم الرسل % % فمن لي من بعدها بامتداح % % 40(@)(@@) % ولعجز النفوس عن درك الحق % % وإيقافها وقوف افتضاح % % PageV01P253 41(@)(@@) % مثل الله نوره في المثاني % % بمثال المشكاة والمصباح % % 42(@)(@@) % فأزل خجلتي بإغضائك المأمول % % واستر به عوار افتضاح % % 43(@)(@@) % صلوات الله يا نكتة الكون % % على مجدك اللباب الصراح % % 44(@)(@@) % عدد القطر والرمال وما % % عاقب دهر غدوه برواح % % 45(@)(@@) % وجزاك الإله أفضل ما يجزى % % كرام الأيمة النصاح % % 46(@)(@@) % أسفي كم أرى طريد ذنوب % % أو بقتني فليس لي من سراح % % 47(@)(@@) % قد غزتني الخطوب غزو الأعادي % % وبرتني الهموم برى قداح % % 48(@)(@@) % سبق الحكم واستقل وهل يمحى % % قضاء قد خط في الألواح % % 49(@)(@@) % لا لدنيا جنحت آلغ فيها % % لا لدين خلصت لا لصلاح % % 50(@)(@@) % قاطعا في الغرور برهة عمري % % خسرت صفقتي وخابت قداحي % % PageV01P254 51(@)(@@) % طمع الشيب باللجام المحلى % % حين أجريت أن يرد جماح % % 52(@)(@@) % فأبت نفسي اللجوج وجدت % % في سمو إلى الهوى وطماح % % 53(@)(@@) % يا طبيب 
ms58	 الذنوب تدبيرك الناجع % % في علتي ضمين النجاح % % 54(@)(@@) % يا مجلي العمى وكافي الدواهي % % ومداوي المرضى وآسي الجراح % % 55(@)(@@) % سد باب القبول دوني ومالي % % يا غياثي سواك من مفتاح % % 56(@)(@@) % خصك الله بالكمال وزند الكون % % لم تقترن بكف اقتداح % % 57(@)(@@) % قبل أن يوجد الوجود وأن يتحف % % بالنور ظلمة الأشباح % % 58(@)(@@) % وأضاءت من نور ميلادك الأرض % % وهزت له اهتزاز ارتياح % % 59(@)(@@) % فسرى الخصب في الجسوم الهزالى % % وجرى الرسل في الدروع الشحاح % % 60(@)(@@) % ولقد رعيت لديه حقوق % % أقطعتها العدا جناب اطراح % % PageV01P255 61(@)(@@) % بمعالي محمد بن الحجاج % % ليث العدا أو غيث السماح % % 62(@)(@@) % ناصر الحق مرسل النقع سحبا % % بين سمر القنا وبيض الصفاح % % 63(@)(@@) % ومزير الجياد أرض الأعادي % % وهي مختالة لفرط المراح % % 64(@)(@@) % يتلاعبن بالظلال عرابا % % غذيت في الفلى لبان اللقاح % % 65(@)(@@) % يا سراج النادي وحتف الأعادي % % وعماد الملك الكريم المناح % % 66(@)(@@) % جمع الله من حلى آل عباس % % لعلياك في سبيل امتداح % % 67(@)(@@) % بين رأي موفق واعتزام % % مستعين وصارم سفاح % % 68(@)(@@) % وخفضت الجناح في الأرض حتى % % لم تدع فوق ظهرها من جناح % % 69(@)(@@) % أنت مصباحها ونور دجاها % % دافع الله عنك من مصباح % % 70(@)(@@) % محض الله منك ياقوتة الملك % % وينبوع العدل والإصلاح % % PageV01P256 71(@)(@@) % بخطوب أرت حديث سليمان % % وجاءت بالحادث المجتاح % % 72(@)(@@) % بيدي هلهل الحجا فاقد الدين % % أخي جرأة ورب اجتراح % % 73(@)(@@) % نال منها عقبى مسيلمة الكذاب % % إذ عاند الهوى وسجاح % % 74(@)(@@) % ثم رد الأمور ردا جميلا % % لك من بعد فرقة وانتزاح % % 75(@)(@@) % فاجزه في الورى الجميل وعامل % % منه كنز الغنى ومثوى الرياح % % 76(@)(@@) % واشتر الحمد بالمواهب واعقد % % عقدها في مظنة الأرباح % % 77(@)(@@) % بركات السماء تبتدر الأرض % % إذا استودعت بدور السماح % % 78(@)(@@) % وتهنأ به بناء سعيدا % % جاء المعلوات وفق اقتراح % % 79(@)(@@) % وتمتع منه بهالة ملك % % أطلعت منك أي بدر لياح % % 80(@)(@@) % مشور الرأي مجمع الحفل مثوى % % كل ذمر وسيد جحجاح % % PageV01P257 81(@)(@@) % ومقام السلام في مدة السلم % % وغاب الأسود يوم الكفاح % % 82(@)(@@) % ملتقى حكمة وملقب الهام % % ومغنى السرور والأفراح % % 83(@)(@@) % أين كسرى أو أين إيوان كسرى % % لا 
ms59	 يقاس الخضم بالضحضاح % % 84(@)(@@) % أين نور الإله من عنصر النار % % إذا ما اعتبرته يا صاح % % 85(@)(@@) % بنية كان فخر ماله مذخورا % % كزهر الرياض في الأدواح % % 86(@)(@@) % حين طاب الزمان واعتدل الفصل % % استجدت وبادرت بافتتاح % % 87(@)(@@) % هاكها قد تتوجت بالمعاني % % واكتست حلة اللغات الفصاح % % 88(@)(@@) % حين غاض الشباب وارتجع الفكر % % وضاق خطو القريض الساح % % 89(@)(@@) % جهد قلب لفقت بعد جهاد % % نقطة من قليبه الملتاح % % 90(@)(@@) % ومعاني البيان هن عذارى % % لا يبحن الشيوخ عقد نكاح % % PageV01P258 91(@)(@@) % ما لشيخ سوى الرجوع إلى الله % % ونجوى أهل التقى والصلاح % % 92(@)(@@) % ولزوم الباب الذي جبر الكسر % % ووصل السؤال والإلحاح % % 93(@)(@@) % وعلى ذلك فهي ساحرة الأحداق % % تزري بكل خود رداح % % 94(@)(@@) % تنفث السحر في الجفون وتلوى % % طرر الحسن للوجوه الملاح % % 95(@)(@@) % دمت في عزة ورفعة قدر % % بين مغدى موفق ومراح % % 96(@)(@@) % ما تولت دهم الدجنة عدوا % % وجرت خلفهن شهب الصباح % % PageV01P259 البحر : طويل 1(@)(@@) % لك الله من قلب على الحب مصحا % % وجفن وشى بالسر مني وأفصحا % % 2(@)(@@) % روى عنه خدي مسندا ومسلسلا % % حديث دموع العين حتى تجرحا % % PageV01P260 البحر : بسيط تام 1(@)(@@) % يا سيدي الأوحد الأسمى ومعتمدي % % وذا الوسيلة من أهل ومن بلد % % 2(@)(@@) % العذر أوضح من نور على علم % % فعد إن غبت عن لهو وعن فند % % 3(@)(@@) % دعوت في يوم الاثنين الصحاب ضحى % % وفيه ما ليس في سبت ولا أحد % % 4(@)(@@) % يوم السلام على المولى وخدمته % % فاسمع وإن عثرت رجل فخذ بيدي % % 5(@)(@@) % بقيت في ظل عيش لا نفاذ له % % مصاحبا غير محصور إلى أمد % % PageV01P261 البحر : طويل 1(@)(@@) % ودرة نور في غلاف زبرجد % % كما لاح في الخضراء لألاء فرقد % % 2(@)(@@) % كأن فتاة جاءها من خليلها % % كتاب بشكوى الحب من غير موعد % % 3(@)(@@) % فلفت بمخضر البرود بنانها % % برورا وإجلالا عن اللمس باليد % % PageV01P262 البحر : متقارب تام 1(@)(@@) % يمينا بيانع ورد الخدود % % وعذب اللمى في الشهي البرود % % 2(@)(@@) % وزورة حب على غفلة % % ووصل ألم بربع الصدود % % 3(@)(@@) % وإلا بمنهل صوب الحيا % % وخفق البنود وقصف الرعود % % 4(@)(@@) % لأنت صباح ظلام الخطوب % % وكفك 
ms60	 مفتاح باب السعود % % 5(@)(@@) % جمالك معنى جمال الوجود % % وبابك معنى مضاء وجود % % 6(@)(@@) % ورضوان أعظم شيء يدل % % على أن دارك دار الخلود % % 7(@)(@@) % أعدت الخلافة أنوارها % % سواطع من بعد طول الخلود % % 8(@)(@@) % وألفت بالعدل بين القلوب % % وفرقت بين الظبا والغمود % % 9(@)(@@) % فهز بك الدين أعطافه % % كما اهتز غصن الرياض المجود % % 10(@)(@@) % إذا كان مدح ملوك الورى % % نظاما فمدحك بيت القصيد % % PageV01P263 11(@)(@@) % ألست من القوم حازوا الندى % % وخاضوا إلى الروع باب الحديد % % 12(@)(@@) % وسلوا عليه سيوفا تسيل % % على صفحتيها دماء الوريد % % 13(@)(@@) % فيا من يؤمل هذا الجناب % % أرحت بعقوة رعي العهود % % 14(@)(@@) % بلغت بيوسف مثوى الضيوف % % وورد الندى ومناخ الوفود % % 15(@)(@@) % ثمال الفقير ويسر العسير % % وكهف الغريب ومأوى الطريد % % 16(@)(@@) % تقيل أخلاق كسب الثنا % % فأيد طارفها بالتليد % % 17(@)(@@) % ولما استتم بناء العلى % % وأحرز شأو الجلال البعيد % % 18(@)(@@) % وأيقن أن لم يدع غاية % % لراج ولا موضعا للمزيد % % 19(@)(@@) % وأن الديار جسوم الجسوم % % تولى إقامة قصر مشيد % % 20(@)(@@) % تخير أعظمه مرمرا % % فجاءوا بكل قوي شديد % % PageV01P264 21(@)(@@) % لتحكم قوة تركيبه % % بطبع صحيح وعمر مديد % % 22(@)(@@) % وجاءت تجر إليه الصخور % % عمالقة من كفاة الحشود % % 23(@)(@@) % إذا جذبوها إليهم حنوا % % ظهورا ومدوا لها كل جيد % % 24(@)(@@) % كأنهم عبدوا صخرة % % وذلك هيمنة بالسجود % % 25(@)(@@) % كأن الأساطين مهما نظرت % % إليها موسدة فوق عود % % 26(@)(@@) % مهود توسدها توأم % % مقطمة من بنات الصلود % % 27(@)(@@) % كأن بأفلاك أعجالها % % سحابا بها قطع من جليد % % 28(@)(@@) % سفائن تخرق بحر الفلا % % وتلحق نحوك بيدا فبيد % % 29(@)(@@) % كأن الصواري على ظهرها % % طرحن مخافة هول شديد % % 30(@)(@@) % وإما أعدت فأعجاز نخل % % تفطرن عن طلع يمن نضيد % % PageV01P265 31(@)(@@) % تولى عطارد إتقانها % % وقابلها منك سعد السعود % % 32(@)(@@) % وعجم مهى ما عرفن الكلام % % عذارى بنيات أم ولود % % 33(@)(@@) % كواعب تخجل حور الحجال % % وبيض الجسوم طوال القدود % % 34(@)(@@) % لبسن رداء الصباح الجديد % % وجررن ذيل الزمان الجديد % % 35(@)(@@) % وقلن أبشري بلقاء الإمام % % فجاءت ميممة بالصعيد % % 36(@)(@@) % أمولاي عبدك ما إن له % % مدى الدهر عن بابكم من محيد % % 37(@)(@@) % أتتك تقرر عذر 