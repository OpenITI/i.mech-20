ms1051	 وتشديد الراء-: كم النخل؛ لأنه يستر في جوفه.(@)(@@) ...(@)(@@) {وتنحتون من الجبال بيوتا فارهين (149)}.(@)(@)(@@)(@@)(@@) || AUTO [149](@)(@)(@@) {وتنحتون من الجبال بيوتا فارهين} قرأ الكوفيون، وابن عامر: (فارهين) بألف بعد الفاء؛ أي: حاذقين، وقرأ الباقون: بغير ألف؛ أي: بطرين.(@)(@@) ...(@)(@@) {فاتقوا الله وأطيعون (150)}.(@)(@)(@@)(@@)(@@) || AUTO [150](@)(@)(@@) {فاتقوا الله وأطيعون} فإن في طاعتي طاعة الله تعالى.(@)(@@) ...(@)(@@) {ولا تطيعوا أمر المسرفين (151)}.(@)(@)(@@)(@@)(@@) || AUTO [151](@)(@)(@@) {ولا تطيعوا أمر المسرفين} المشركين.(@)(@@) ...(@)(@@) {الذين يفسدون في الأرض ولا يصلحون (152)}.(@)(@)(@@)(@@)(@@) || AUTO [152](@)(@)(@@) {الذين يفسدون في الأرض ولا يصلحون} بالمعاصي والكفر (¬1).(@)(@)PageV05P088(@)(@)(@@) {ولا يصلحون} بطاعة الله فيما أمرهم به.(@)(@@) ...(@)(@@) {قالوا إنما أنت من المسحرين (153)}.(@)(@)(@@)(@@)(@@) || AUTO [153](@)(@)(@@) {قالوا إنما أنت من المسحرين} المسحر: الذي سحر كثيرا حتى غلب على عقله.(@)(@@) ...(@)(@@) {ما أنت إلا بشر مثلنا فأت بآية إن كنت من الصادقين (154)}.(@)(@)(@@)(@@)(@@) || AUTO [154](@)(@)(@@) {ما أنت إلا بشر مثلنا} تأكل الطعام، وتشرب الشراب، ولست بملك.(@)(@@) {فأت بآية} على صحة ما تقول.(@)(@@) {إن كنت من الصادقين} أنك رسول الله إلينا.(@)(@@) ...(@)(@@) {قال هذه ناقة لها شرب ولكم شرب يوم معلوم (155)}.(@)(@)(@@)(@@)(@@) || AUTO [155](@)(@)(@@) {قال هذه ناقة} أي: بعد ما أخرجها الله من الصخرة بدعائه كما اقترحوها.(@)(@@) {لها شرب} نصيب من الماء {ولكم شرب يوم معلوم} فاقتصروا على شربكم، فكانت تشرب جميع الماء يوما، ويشربون يوما (¬1). فيه دليل على جواز قسمة المنافع بالمهايأة؛ لأن قوله: {لها شرب ولكم شرب يوم} من PageV05P089 (@@) المهايأة، واختلفوا في حكم المهايأة، فقال أبو حنيفة: يجبر عليها الممتنع إذا لم يكن الطالب متعنتا، وقال الثلاثة: هي جائزة بالتراضي، ولا إجبار فيها.(@)(@@) ...(@)(@@) {ولا تمسوها بسوء فيأخذكم عذاب يوم عظيم (156)}.(@)(@)(@@)(@@)(@@) || AUTO [156](@)(@)(@@) {ولا تمسوها بسوء} كضرب وعقر.(@)(@@) {فيأخذكم عذاب يوم عظيم} عظم اليوم لعظم ما يحل فيه.(@)(@@) ...(@)(@@) {فعقروها فأصبحوا نادمين (157)}.(@)(@)(@@)(@@)(@@) || AUTO [157](@)(@)(@@) روي أن عاقرها قال: لا أعقرها حتى ترضوا أجمعين، فاستؤذن صغارهم وكبارهم، فرضوا (¬1) {فعقروها} أسند العقر إلى كلهم؛ لأنهم رضوا بذلك، فأخذوا جميعا {فأصبحوا نادمين} على عقرها؛ خوفا من نزول العذاب، لا ندم توبة.(@)(@@) ...(@)(@@) {فأخذهم العذاب إن في ذلك لآية وما كان أكثرهم مؤمنين (158)}.(@)(@)(@@)(@@)(@@) || AUTO [158](@)(@)(@@) {فأخذهم العذاب} الموعود {إن في ذلك لآية وما كان أكثرهم مؤمنين}. 
ms1052	(@)(@)PageV05P090(@)(@)(@@) {وإن ربك لهو العزيز الرحيم (159)}.(@)(@)(@@)(@@)(@@) || AUTO [159](@)(@)(@@) {وإن ربك لهو العزيز الرحيم}.(@)(@@) ...(@)(@@) {كذبت قوم لوط المرسلين (160)}.(@)(@)(@@)(@@)(@@) || AUTO [160](@)(@)(@@) {كذبت قوم لوط المرسلين}.(@)(@@) ...(@)(@@) {إذ قال لهم أخوهم لوط ألا تتقون (161)}.(@)(@)(@@)(@@)(@@) || AUTO [161](@)(@)(@@) {إذ قال لهم أخوهم لوط ألا تتقون}.(@)(@@) ...(@)(@@) {إني لكم رسول أمين (162)}.(@)(@)(@@)(@@)(@@) || AUTO [162](@)(@)(@@) {إني لكم رسول أمين}.(@)(@@) ...(@)(@@) {فاتقوا الله وأطيعون (163)}.(@)(@)(@@)(@@)(@@) || AUTO [163](@)(@)(@@) {فاتقوا الله وأطيعون}.(@)(@@) ...(@)(@@) {وما أسألكم عليه من أجر إن أجري إلا على رب العالمين (164)}.(@)(@)(@@)(@@)(@@) || AUTO [164](@)(@)(@@) {وما أسألكم عليه من أجر إن أجري إلا على رب العالمين}.(@)(@@) ***(@)(@)PageV05P091(@)(@)(@@) {أتأتون الذكران من العالمين (165)}.(@)(@)(@@)(@@)(@@) || AUTO [165](@)(@)(@@) ثم استفهم منكرا فقال: {أتأتون الذكران من العالمين} من جميع الناس، عبر عن الفاحشة بالإتيان؛ كما عبر به عن الحلال في قوله: {فأتوا حرثكم} [البقرة: 223]، المعنى: أتطؤون الذكور من الناس، مع كثرة إناثهم؟!(@)(@@) ...(@)(@@) {وتذرون ما خلق لكم ربكم من أزواجكم بل أنتم قوم عادون (166)}.(@)(@)(@@)(@@)(@@) || AUTO [166](@)(@)(@@) {وتذرون} وتتركون {ما خلق لكم ربكم من أزواجكم} لأجل استمتاعكم.(@)(@@) {بل أنتم قوم عادون} متجاوزون الحلال إلى الحرام.(@)(@@) ...(@)(@@) {قالوا لئن لم تنته يالوط لتكونن من المخرجين (167)}.(@)(@)(@@)(@@)(@@) || AUTO [167](@)(@)(@@) {قالوا لئن لم تنته يالوط} عن إنكارك علينا.(@)(@@) {لتكونن من المخرجين} من قريتنا.(@)(@@) ...(@)(@@) {قال إني لعملكم من القالين (168)}.(@)(@)(@@)(@@)(@@) || AUTO [168](@)(@)(@@) {قال إني لعملكم من القالين} المبغضين.(@)(@@) ***(@)(@)PageV05P092(@)(@)(@@) {رب نجني وأهلي مما يعملون (169)}.(@)(@)(@@)(@@)(@@) || AUTO [169](@)(@)(@@) ثم دعا فقال: {رب نجني وأهلي مما يعملون} من العمل الخبيث؛ أي: من شؤمه وعذابه.(@)(@@) {فنجيناه وأهله أجمعين (170)}.(@)(@)(@@)(@@)(@@) || AUTO [170](@)(@)(@@) {فنجيناه} فعصمناه {وأهله} من العذاب {أجمعين}.(@)(@@) {إلا عجوزا في الغابرين (171)}.(@)(@)(@@)(@@)(@@) || AUTO [171](@)(@)(@@) {إلا عجوزا} هي امرأته {في الغابرين} الباقين في العذاب، تقديره: إلا عجوزا مقدرا غبورها أهلكناها؛ لأنها كانت معينة على الفاحشة، راضية بها، والاستثناء من الأهل؛ لأن الزوجة منهم.(@)(@@) {ثم دمرنا الآخرين (172)}.(@)(@)(@@)(@@)(@@) || AUTO [172](@)(@)(@@) {ثم دمرنا الآخرين} أي: أهلكناهم.(@)(@@) {وأمطرنا عليهم مطرا فساء مطر المنذرين (173)}.(@)(@)(@@)(@@)(@@) || AUTO [173](@)(@)(@@) {وأمطرنا عليهم} على شذاذهم ومسافريهم {مطرا} حجارة.(@)(@@) {فساء} أي: فقبح {مطر المنذرين} مطرهم.(@)(@@) ***(@)(@)PageV05P093(@)(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين (174)}.(@)(@)(@@)(@@)(@@) || AUTO [174](@)(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين}.(@)(@@) ...(@)(@@) {وإن ربك لهو العزيز الرحيم (175)}.(@)(@)(@@)(@@)(@@) || AUTO [175](@)(@)(@@) {وإن ربك لهو العزيز الرحيم}.(@)(@@) ...(@)(@@) {كذب أصحاب الأيكة 
ms1053	 المرسلين (176)}.(@)(@)(@@)(@@)(@@) || AUTO [176](@)(@)(@@) {كذب أصحاب الأيكة المرسلين} قرأ نافع، وأبو جعفر، وابن كثير، وابن عامر: (ليكة) بلام مفتوحة من غير ألف وصل قبلها، ولا همزة بعدها، وبفتح تاء التأنيث في الوصل مثل طلحة، وكذلك رسم في جميع المصاحف، وقرأ الباقون: بألف الوصل مع إسكان اللام وهمزة مفتوحة بعدها وخفض تاء التأنيث، وحمزة: على أصله يقف على الساكن قبل الهمز، وورش: ينقل حركة الهمزة إلى الساكن قبلها، وحمزة: له النقل إذا وقف بخلاف عنه؛ ف (أيكة) اسم نكرة لشجر كثير ملتف، ثم دخله التعريف، و (ليكة) أيضا غير مصروف؛ لتعريفه وتأنيثه: اسم علم لبلد، أو شجر (¬1)، وتقدم ذكر الأيكة ومحلها في سورة الأعراف، فمن قرأ: (الأيكة) أراد: الشجر، ومن قرأ: (ليكة) أراد: البلد كما تقول فيمن صرف ثمود PageV05P094 (@@) أراد: الأب، ومن لم يصرفه أراد: القبيلة، وكذلك اختلافهم في سورة (ص)، وأجمعوا على الألف واللام وجر التاء في (الحجر)، و (ق) لإجماع المصاحف على ذلك.(@)(@@) ...(@)(@@) {إذ قال لهم شعيب ألا تتقون (177)}.(@)(@)(@@)(@@)(@@) || AUTO [177](@)(@)(@@) {إذ قال لهم شعيب ألا تتقون} وإنما لم يقل في شعيب: أخوهم؛ لأنه لم يكن من أصحاب الأيكة في النسب، وإنما أرسل إليهم بعد مدين، وكان من أصحاب مدين، فلما ذكر مدين، قال: أخاهم شعيبا في سورتي الأعراف، وهود، وفي الحديث: "إن شعيبا أخا مدين أرسل إلى أصحاب مدين، وإلى أصحاب الأيكة" (¬1).(@)(@@) ...(@)(@@) {إني لكم رسول أمين (178)}.(@)(@)(@@)(@@)(@@) || AUTO [178](@)(@)(@@) {إني لكم رسول أمين}.(@)(@@) ...(@)(@@) {فاتقوا الله وأطيعون (179)}.(@)(@)(@@)(@@)(@@) || AUTO [179](@)(@)(@@) {فاتقوا الله وأطيعون}.(@)(@)PageV05P095(@)(@)(@@) {وما أسألكم عليه من أجر إن أجري إلا على رب العالمين (180)}.(@)(@)(@@)(@@)(@@) || AUTO [180](@)(@)(@@) {وما أسألكم عليه من أجر إن أجري إلا على رب العالمين} وإنما كانت دعوة الأنبياء كلهم فيما حكى الله عنهم على صيغة واحدة؛ لاتفاقهم على الأمر بالتقوى والطاعة، والامتناع من أخذ الأجر على تبليغ الرسالة.(@)(@@) ...(@)(@@) {أوفوا الكيل ولا تكونوا من المخسرين (181)}.(@)(@)(@@)(@@)(@@) || AUTO [181](@)(@)(@@) وكان أصحاب الأيكة يطففون، فقال: {أوفوا الكيل} أتموه.(@)(@@) {ولا تكونوا من المخسرين} الناقصين لحقوق الناس.(@)(@@) ...(@)(@@) {وزنوا بالقسطاس المستقيم (182)}.(@)(@)(@@)(@@)(@@) || AUTO [182](@)(@)(@@) {وزنوا بالقسطاس المستقيم} بميزان العدل. قرأ حمزة، والكسائي، وخلف، وحفص 
ms1054	 عن عاصم: (بالقسطاس) بكسر القاف، والباقون: بضمها (¬1).(@)(@@) ...(@)(@@) {ولا تبخسوا الناس أشياءهم ولا تعثوا في الأرض مفسدين (183)}.(@)(@)(@@)(@@)(@@) || AUTO [183](@)(@)(@@) {ولا تبخسوا الناس أشياءهم} لا تنقصوا شيئا من حقوقهم.(@)(@)PageV05P096(@)(@)(@@) {ولا تعثوا في الأرض مفسدين} بالقتل وقطع الطريق.(@)(@@) ...(@)(@@) {واتقوا الذي خلقكم والجبلة الأولين (184)}.(@)(@)(@@)(@@)(@@) || AUTO [184](@)(@)(@@) {واتقوا الذي خلقكم والجبلة الأولين} يعني: الأمم المتقدمين، والجبلة: الخلق، يقال: جبل؛ أي: خلق.(@)(@@) ...(@)(@@) {قالوا إنما أنت من المسحرين (185)}.(@)(@)(@@)(@@)(@@) || AUTO [185](@)(@)(@@) {قالوا إنما أنت من المسحرين}.(@)(@@) ...(@)(@@) {وما أنت إلا بشر مثلنا وإن نظنك لمن الكاذبين (186)}.(@)(@)(@@)(@@)(@@) || AUTO [186](@)(@)(@@) {وما أنت إلا بشر مثلنا} تقدم تفسير نظيره، وأتوا بالواو؛ للدلالة على أنه جامع بين وصفين منافيين للرسالة؛ مبالغة في تكذيبه.(@)(@@) {وإن نظنك لمن الكاذبين} في دعواك.(@)(@@) ...(@)(@@) {فأسقط علينا كسفا من السماء إن كنت من الصادقين (187)}.(@)(@)(@@)(@@)(@@) || AUTO [187](@)(@)(@@) {فأسقط علينا كسفا من السماء إن كنت من الصادقين} قرأ حفص عن عاصم: (كسفا) بفتح السين؛ أي: قطعا، وقرأ الباقون: بالإسكان؛ أي: قطعة (¬1)، واختلافهم في الهمزتين من (السماء إن) PageV05P097 (@@) كاختلافهم فيهما من قوله: (على البغاء إن) في سورة النور [الآية: 33].(@)(@@) ...(@)(@@) {قال ربي أعلم بما تعملون (188)}.(@)(@)(@@)(@@)(@@) || AUTO [188](@)(@)(@@) {قال ربي أعلم بما تعملون} فهو مجازيكم بأعمالكم. قرأ نافع، وأبو جعفر، وابن كثير، وأبو عمرو: (ربي) بفتح الياء، والباقون: بإسكانها (¬1).(@)(@@) ...(@)(@@) {فكذبوه فأخذهم عذاب يوم الظلة إنه كان عذاب يوم عظيم (189)}.(@)(@)(@@)(@@)(@@) || AUTO [189](@)(@)(@@) {فكذبوه فأخذهم عذاب يوم الظلة} هو أنه أصابهم حر شديد، وكانوا يدخلون الأسراب فيجدونها أشد حرا، فخرجوا، فجاءتهم سحابة، فدخلوا تحتها يستظلون، فأمطرت عليهم نارا، فاحترقوا {إنه كان عذاب يوم عظيم}.(@)(@@) ...(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين (190)}.(@)(@)(@@)(@@)(@@) || AUTO [190](@)(@)(@@) {إن في ذلك لآية وما كان أكثرهم مؤمنين}.(@)(@@) ...(@)(@)PageV05P098(@)(@)(@@) {وإن ربك لهو العزيز الرحيم (191)}.(@)(@)(@@)(@@)(@@) || AUTO [191](@)(@)(@@) {وإن ربك لهو العزيز الرحيم} هذا آخر القصص السبع المذكورة؛ تسلية لرسول الله - صلى الله عليه وسلم -، وتهديدا للمكذبين به، وكرر في هذه القصة ما كرره في غيرها تقريرا لمعانيها في الصدور؛ ليكون أبلغ في الوعظ والزجر.(@)(@@) ...(@)(@@) {وإنه لتنزيل رب العالمين (192)}.(@)(@)(@@)(@@)(@@) || AUTO [192](@)(@)(@@) {وإنه} أي: القرآن المنزل {لتنزيل رب العالمين}.(@)(@@) ...(@)(@@) {نزل به الروح الأمين (193)}.(@)(@)(@@)(@@)(@@) || AUTO [193](@)(@)(@@) {نزل به 
ms1055	 الروح الأمين} هو جبريل -عليه السلام-؛ لأنه أمين على الوحي. قرأ ابن عامر، وحمزة، والكسائي، ويعقوب، وخلف، وأبو بكر عن عاصم: (نزل) بتشديد الزاي ونصب (الروح الأمين) مفعولا، الفاعل الله تعالى؛ أي: نزل الله به جبريل -عليه السلام-؛ لقوله تعالى: {وإنه لتنزيل رب العالمين} وقرأ الباقون: بالتخفيف، ورفعهما الفاعل (الروح الأمين) (¬1).(@)(@@) ...(@)(@)PageV05P099(@)(@)(@@) {على قلبك لتكون من المنذرين (194)}.(@)(@)(@@)(@@)(@@) || AUTO [194](@)(@)(@@) {على قلبك} يا محمد حتى وعيته.(@)(@@) {لتكون من المنذرين} المخوفين.(@)(@@) ...(@)(@@) {بلسان عربي مبين (195)}.(@)(@)(@@)(@@)(@@) || AUTO [195](@)(@)(@@) {بلسان عربي مبين} قال ابن عباس: "بلسان قريش؛ ليفهموا ما فيه" (¬1)، المعنى: لتكون من الذين أنذروا بهذا اللسان، وهم خمسة: هود، وصالح، وشعيب، وإسماعيل، ومحمد صلوات الله عليهم أجمعين.(@)(@@) ...(@)(@@) {وإنه لفي زبر الأولين (196)}.(@)(@)(@@)(@@)(@@) || AUTO [196](@)(@)(@@) {وإنه} أي: ذكر إنزال (¬2) القرآن.(@)(@@) {لفي زبر الأولين} لمثبت في كتب الأنبياء قبلك.(@)(@@) ...(@)(@@) {أولم يكن لهم آية أن يعلمه علماء بني إسرائيل (197)}.(@)(@)(@@)(@@)(@@) || AUTO [197](@)(@)(@@) {أولم يكن لهم آية أن يعلمه علماء بني إسرائيل} على صحة القرآن، ونبوة محمد - صلى الله عليه وسلم - {أن يعلمه علماء بني إسرائيل} قرأ ابن عامر: (تكن) بالتاء PageV05P100 (@@) على التأنيث (آية) بالرفع، جعل الآية اسما، وخبره (أن يعلمه)، وقرأ الباقون: (يكن) بالتذكير (آية) بالنصب، جعلوا الآية خبر (يكن) (¬1)، معناه: أولم يكن لهؤلاء المتكبرين علماء بني إسرائيل آية؛ أي: علامة على نبوة محمد - صلى الله عليه وسلم -؛ لأنهم كانوا يخبرون بوجوده في كتبهم، وهم عبد الله بن سلام وأصحابه، وهم: بنيامين، وثعلبة، وأسد، وأسيد، وكان إخبارهم آية على صدقه، قال ابن عباس: "بعث أهل مكة إلى اليهود، وهم بالمدينة، فسألوهم عن محمد - صلى الله عليه وسلم -، فقالوا: إن هذا الزمان زمانه، وإنا نجد في التوراة نعته وصفته" (¬2).(@)(@@) ...(@)(@@) {ولو نزلناه على بعض الأعجمين (198)}.(@)(@)(@@)(@@)(@@) || AUTO [198](@)(@)(@@) {ولو نزلناه} يعني: القرآن {على بعض الأعجمين} جمع أعجم، وهو الذي لا يفصح، ولا يحسن العربية، وإن كان عربيا في النسب، والعجمي: المنسوب للعجم، وإن كان فصيحا.(@)(@@) ومعنى الآية: ولو نزلناه على رجل ليس بعربي اللسان.(@)(@@) ...(@)(@@) {فقرأه عليهم ما كانوا به مؤمنين (199)}.(@)(@)(@@)(@@)(@@) || AUTO [199](@)(@)(@@) {فقرأه عليهم} بغير لغة العرب {ما كانوا 
ms1056	 به مؤمنين}.(@)(@@) ...(@)(@)PageV05P101(@)(@)(@@) {كذلك سلكناه في قلوب المجرمين (200)}.(@)(@)(@@)(@@)(@@) || AUTO [200](@)(@)(@@) وقالوا: ما نفقه قولك {كذلك سلكناه} أي: أدخلنا الشك والشرك {في قلوب المجرمين}.(@)(@@) ...(@)(@@) {لا يؤمنون به حتى يروا العذاب الأليم (201)}.(@)(@)(@@)(@@)(@@) || AUTO [201](@)(@)(@@) {لا يؤمنون به} بالقرآن {حتى يروا العذاب الأليم} عند الموت.(@)(@@) ...(@)(@@) {فيأتيهم بغتة وهم لا يشعرون (202)}.(@)(@)(@@)(@@)(@@) || AUTO [202](@)(@)(@@) {فيأتيهم} فيأخذهم {بغتة} فجأة.(@)(@@) {وهم لا يشعرون} به في الدنيا.(@)(@@) ...(@)(@@) {فيقولوا هل نحن منظرون (203)}.(@)(@)(@@)(@@)(@@) || AUTO [203](@)(@)(@@) {فيقولوا هل نحن منظرون} مؤخرون؛ لنؤمن ونصدق، يتمنون الرجعة.(@)(@@) ...(@)(@@) {أفبعذابنا يستعجلون (204)}.(@)(@)(@@)(@@)(@@) || AUTO [204](@)(@)(@@) ولما أوعدهم النبي - صلى الله عليه وسلم - بالعذاب، قالوا: إلى متى توعدنا بالعذاب، ومتى هذا العذاب؟! فنزل قوله تعالى: {أفبعذابنا يستعجلون} PageV05P102 (@@) فيقولون: {فأمطر علينا حجارة} [الأنفال: 32]، {فأتنا بما تعدنا} [الأحقاف: 22].(@)(@@) ...(@)(@@) {أفرأيت إن متعناهم سنين (205)}.(@)(@)(@@)(@@)(@@) || AUTO [205](@)(@)(@@) ثم خاطب النبي - صلى الله عليه وسلم -؛ لإقامة الحجة عليهم في أن مدة الإرجاء والإمهال والإملاء لا تغني مع نزول العذاب بعدها، ووقوع النقمة، وذلك في قوله: {أفرأيت إن متعناهم سنين} كثيرة في الدنيا؛ يعني: كفار مكة، ولم نهلكهم. تقدم اختلاف القراء في (أرأيت) في سورة الفرقان عند تفسير قوله تعالى: {أرأيت من اتخذ إلهه هواه} [الآية: 43].(@)(@@) ...(@)(@@) {ثم جاءهم ما كانوا يوعدون (206)}.(@)(@)(@@)(@@)(@@) || AUTO [206](@)(@)(@@) {ثم جاءهم ما كانوا} يعني: العذاب.(@)(@@) ...(@)(@@) {ما أغنى عنهم ما كانوا يمتعون (207)}.(@)(@)(@@)(@@)(@@) || AUTO [207](@)(@)(@@) {ما أغنى عنهم ما كانوا يمتعون} لم يغن عنهم تمتعهم المتطاول بنعيم الدنيا في دفع العذاب عنهم.(@)(@@) ...(@)(@@) {وما أهلكنا من قرية إلا لها منذرون (208)}.(@)(@)(@@)(@@)(@@) || AUTO [208](@)(@)(@@) {وما أهلكنا من قرية إلا لها منذرون} رسل ينذرونهم.(@)(@@) ***(@)(@)PageV05P103(@)(@)(@@) {ذكرى وما كنا ظالمين (209)}.(@)(@)(@@)(@@)(@@) || AUTO [209](@)(@)(@@) {ذكرى} محلها نصب؛ أي: ينذرونهم تذكرة، وقيل: رفع؛ أي: تلك ذكرى {وما كنا ظالمين} في تعذيبهم؛ حيث قدمنا الحجة عليهم، وأعذرنا إليهم.(@)(@@) ...(@)(@@) {وما تنزلت به الشياطين (210)}.(@)(@)(@@)(@@)(@@) || AUTO [210](@)(@)(@@) {وما تنزلت به} أي: بالقرآن {الشياطين} وذلك أن المشركين كانوا يقولون: إن الشياطين يلقون القرآن على لسان محمد - صلى الله عليه وسلم -، فنزلت الآية.(@)(@@) ...(@)(@@) {وما ينبغي لهم وما يستطيعون (211)}.(@)(@)(@@)(@@)(@@) || AUTO [211](@)(@)(@@) {وما ينبغي لهم} أن يتنزلوا بالقرآن {وما يستطيعون} ذلك.(@)(@@) ...(@)(@@) {إنهم عن السمع لمعزولون (212)}.(@)(@)(@@)(@@)(@@) || AUTO [212](@)(@)(@@) {إنهم عن السمع} أي: عن استراقه من 
ms1057	 السماء.(@)(@@) {لمعزولون} أي: محجوبون بالشهب مرجومون.(@)(@@) ...(@)(@@) {فلا تدع مع الله إلها آخر فتكون من المعذبين (213)}.(@)(@)(@@)(@@)(@@) || AUTO [213](@)(@)(@@) {فلا تدع مع الله إلها آخر فتكون من المعذبين} قال ابن عباس:(@)(@)PageV05P104(@)(@)(@@) "يحذر به غيره، يقول: أنت أكرم الخلق علي، ولو اتخذت إلها غيري، لعذبتك" (¬1).(@)(@@) ...(@)(@@) {وأنذر عشيرتك الأقربين (214)}(@)(@)(@@)(@@)(@@) || AUTO [214](@)(@)(@@) {وأنذر عشيرتك الأقربين} فجمع - صلى الله عليه وسلم - قومه، وقال: "إني نذير لكم بين يدي عذاب شديد" (¬2).(@)(@@) ...(@)(@@) {واخفض جناحك لمن اتبعك من المؤمنين (215)}.(@)(@)(@@)(@@)(@@) || AUTO [215](@)(@)(@@) {واخفض جناحك} ألن جانبك، وتواضع.(@)(@@) {لمن اتبعك من المؤمنين} من عشيرتك وغيرهم؛ فإن الفاسق والمنافق لا يخفض له الجناح.(@)(@@) ...(@)(@@) {فإن عصوك فقل إني بريء مما تعملون (216)}.(@)(@)(@@)(@@)(@@) || AUTO [216](@)(@)(@@) أي: خالفوك.(@)(@@) {فقل إني بريء مما تعملون} من الكفر والمعاصي.(@)(@@) ...(@)(@)PageV05P105(@)(@)(@@) {وتوكل على العزيز الرحيم (217)}.(@)(@)(@@)(@@)(@@) || AUTO [217](@)(@)(@@) {وتوكل على العزيز الرحيم} ليكفيك كيد الأعداء. قرأ نافع، وأبو جعفر، وابن عامر: (فتوكل) بالفاء عطفا على (فقل)، وكذلك هو في مصاحف المدينة والشام، وقرأ الباقون: بالواو، وكذلك هو في مصاحفهم (¬1).(@)(@@) ...(@)(@@) {الذي يراك حين تقوم (218)}.(@)(@)(@@)(@@)(@@) || AUTO [218](@)(@)(@@) {الذي يراك حين تقوم} للتهجد.(@)(@@) ...(@)(@@) {وتقلبك في الساجدين (219)}.(@)(@)(@@)(@@)(@@) || AUTO [219](@)(@)(@@) أي: ويرى تقلبك {في الساجدين} أي: تصفح أحوال المتهجدين من أصحابك، وعن ابن عباس قال: "من نبي إلى نبي حتى أخرجك نبيا" (¬2).(@)(@@) ...(@)(@@) {إنه هو السميع العليم (220)}.(@)(@)(@@)(@@)(@@) || AUTO [220](@)(@)(@@) {إنه هو السميع} لما تقوله {العليم} بما تنويه.(@)(@@) ...(@)(@)PageV05P106(@)(@)(@@) {هل أنبئكم على من تنزل الشياطين (221)}.(@)(@)(@@)(@@)(@@) || AUTO [221](@)(@)(@@) ولما قال المشركون: إن الشيطان يلقي السمع (¬1) على محمد، نزل جواب قولهم: {هل أنبئكم على من تنزل الشياطين}؟(@)(@@) ...(@)(@@) {تنزل على كل أفاك أثيم (222)}.(@)(@)(@@)(@@)(@@) || AUTO [222](@)(@)(@@) ثم بين فقال: {تنزل} أي: تتنزل {على كل أفاك} كذاب.(@)(@@) {أثيم} مبالغة من آثم، وهم الكهنة الذين كانت تسرق الجن السمع فتلقيه إليهم. قرأ البزي: (تنزل) بتشديد التاء في الحرفين حالة الوصل (¬2).(@)(@@) ...(@)(@@) {يلقون السمع وأكثرهم كاذبون (223)}.(@)(@)(@@)(@@)(@@) || AUTO [223](@)(@)(@@) {يلقون السمع} أي: يلقون إلى الكهنة ما يسمعون من الملائكة عند استراق السمع {وأكثرهم} أي: الكهنة.(@)(@@) {كاذبون} لأنهم كانوا يخلطون مع ما يستمعون (¬3) كذبا كثيرا. جاء في الحديث: "الكلمة يخطفها الجني، فيقرها في أذن وليه، فيزيد فيها أكثر من مئة كذبة" 
ms1058	 (¬4).(@)(@)PageV05P107(@)(@)(@@) فإذا صدقت تلك الكلمة، كانت سبب ضلال من سمعها، وقال: (أكثرهم)؛ لأن من الأفاك من قد يصدق.(@)(@@) ...(@)(@@) {والشعراء يتبعهم الغاوون (224)}.(@)(@)(@@)(@@)(@@) || AUTO [224](@)(@)(@@) ونزل في جماعة من الكفار كانوا يقولون الشعر، ويقولون: نحن نقول كما يقول محمد، واتبعهم غواة على ذلك {والشعراء} مبتدأ، خبره:(@)(@@) {يتبعهم الغاوون} السفهاء الذين يروون هجاء المسلمين. قرأ نافع: (يتبعهم) بفتح الباء مخففا، والباقون: بكسر الباء مشددا (¬1).(@)(@@) ...(@)(@@) {ألم تر أنهم في كل واد يهيمون (225)}.(@)(@)(@@)(@@)(@@) || AUTO [225](@)(@)(@@) {ألم تر أنهم في كل واد} تمثيل لذهابهم في كل فن من القول.(@)(@@) روي عن يعقوب وقنبل: الوقف بالياء على (وادي).(@)(@@) {يهيمون} يذهبون على غير قصد، كما يذهب الهائم على وجهه.(@)(@@) ...(@)(@)PageV05P108(@)(@)(@@) {وأنهم يقولون ما لا يفعلون (226)}.(@)(@)(@@)(@@)(@@) || AUTO [226](@)(@)(@@) {وأنهم يقولون}: فعلنا {ما لا يفعلون}.(@)(@@) {إلا الذين آمنوا وعملوا الصالحات وذكروا الله كثيرا وانتصروا من بعد ما ظلموا وسيعلم الذين ظلموا أي منقلب ينقلبون (227)}.(@)(@)(@@)(@@)(@@) || AUTO [227](@)(@)(@@) ولما نزلت هذه الآية، جاء حسان بن ثابت، وعبد الله بن رواحة، وكعب بن مالك، ومن كان ينافح عن النبي - صلى الله عليه وسلم -، وكان غالب شعرهم توحيدا وذكرا، فقالوا: يا رسول الله! قد نزل هذا، والله يعلم أنا شعراء، فقال - صلى الله عليه وسلم -: "إن المؤمن يجاهد بسيفه ولسانه، وإن الذي ترمونهم به نضح النبل" (¬1)، ونزل: {إلا الذين آمنوا وعملوا الصالحات} استثناء لشعراء الإسلام {وذكروا الله كثيرا} أي: لم يشغلهم الشعر عن ذكر الله تعالى.(@)(@@) {وانتصروا} أي: بالرد على المشركين {من بعد ما ظلموا} أي: هجوا؛ لأن الكفار بدؤوهم بالهجاء، قال - صلى الله عليه وسلم - لحسان: "اهج المشركين؛ فإن جبريل معك" (¬2)، ثم أوعد شعراء المشركين فقال تعالى:(@)(@@) {وسيعلم الذين ظلموا} أشركوا {أي منقلب ينقلبون} أي مرجع يرجعون PageV05P109 (@@) إليه بعد مماتهم، قال ابن عباس: "إلى جهنم والسعير" (¬1)، و (أي) نعت لمصدر محذوف نصب ب: (ينقلبون)، لا ب (يعلم)، لأنها استفهام، تقديره: ينقلبون انقلابا أي منقلب، والله أعلم.(@)(@@) ...(@)(@)PageV05P110(@)(@)(@@)(@@)(@@) | AUTO سورة النمل(@)(@)(@@) مكية، وآيها: ثلاث وتسعون آية، وحروفها: أربعة آلاف وسبع مئة وتسعون حرفا، وكلمها: ألف ومئة وتسع وأربعون كلمة.(@)(@@) بسم الله 
ms1059	 الرحمن الرحيم(@)(@@) {طس تلك آيات القرآن وكتاب مبين (1)}.(@)(@)(@@)(@@)(@@) || AUTO [1](@)(@)(@@) {طس} تقدم الكلام (¬1) عليه، ومذاهب القراء فيه أول سورة الشعراء، وهو اسم من أسماء الله تعالى، قاله ابن عباس (¬2)، قيل: معناه هنا: لطيف وسميع.(@)(@@) {تلك} أي: هذه الآيات المذكورات {آيات القرآن وكتاب مبين} وهو اللوح المحفوظ؛ لأنه خط فيه ما هو كائن، فهو يبينه للناظرين. قرأ ابن كثير: (القران) و (قران) و (قرانا) حيث وقع: بالنقل، والباقون: بالهمز (¬3).(@)(@)PageV05P111(@)(@)(@@) {هدى وبشرى للمؤمنين (2)}.(@)(@)(@@)(@@)(@@) || AUTO [2](@)(@)(@@) {هدى} أي: هو هدى من الضلالة.(@)(@@) {وبشرى للمؤمنين} للمصدقين به.(@)(@@) ...(@)(@@) {الذين يقيمون الصلاة ويؤتون الزكاة وهم بالآخرة هم يوقنون (3)}.(@)(@)(@@)(@@)(@@) || AUTO [3](@)(@)(@@) {الذين يقيمون الصلاة} قرأ ورش: (الصلاة) بتغليظ اللام.(@)(@@) {ويؤتون الزكاة وهم بالآخرة هم يوقنون} المعنى: المؤمنون الموصوفون بهذه الصفات يوقنون بالبعث.(@)(@@) ...(@)(@@) {إن الذين لا يؤمنون بالآخرة زينا لهم أعمالهم فهم يعمهون (4)}.(@)(@)(@@)(@@)(@@) || AUTO [4](@)(@)(@@) {إن الذين لا يؤمنون بالآخرة زينا لهم أعمالهم} بخلق الشهوة فيهم، فاعتقدوا أعمالهم القبيحة حسنة؛ لشهوتهم إياها، لا أنا حسنا لهم الفواحش، وأمرناهم بها. قرأ أبو عمرو: (بالآخرة زينا) بإدغام التاء في الزاي (¬1).(@)(@@) {فهم يعمهون} يترددون بتحير.(@)(@@) ...(@)(@)PageV05P112(@)(@)(@@) {أولئك الذين لهم سوء العذاب وهم في الآخرة هم الأخسرون (5)}.(@)(@)(@@)(@@)(@@) || AUTO [5](@)(@)(@@) {أولئك الذين لهم سوء العذاب} في الدنيا؛ بالقتل والأسر.(@)(@@) {وهم في الآخرة هم الأخسرون} أشد الناس خسرانا؛ لفوت المثوبة، واستحقاق العقوبة.(@)(@@) ...(@)(@@) {وإنك لتلقى القرآن من لدن حكيم عليم (6)}.(@)(@)(@@)(@@)(@@) || AUTO [6](@)(@)(@@) {وإنك لتلقى القرآن} لتؤتاه.(@)(@@) {من لدن حكيم عليم} أي: وحيا من عند الله ذي الحكمة، وهذه الآية رد على كفار قريش في قولهم: إن القرآن من تلقاء محمد بن عبد الله.(@)(@@) ...(@)(@@) {إذ قال موسى لأهله إني آنست نارا سآتيكم منها بخبر أو آتيكم بشهاب قبس لعلكم تصطلون (7)}.(@)(@)(@@)(@@)(@@) || AUTO [7](@)(@)(@@) ثم قص تعالى خبر موسى عليه السلام، والتقدير: اذكر {إذ قال موسى لأهله} في مسيره من مدين إلى مصر:(@)(@@) {إني آنست} أبصرت {نارا سآتيكم منها بخبر} أخبركم به عن حال الطريق؛ لأنه كان قد ضل عنها. قرأ نافع، وأبو جعفر، وابن كثير، وأبو عمرو: (إني) بفتح الياء، والباقون: بإسكانها (¬1).(@)(@)PageV05P113(@)(@)(@@) {أو آتيكم بشهاب} 
ms1060	 هي الشعلة المضيئة. قرأ الكوفيون، ويعقوب: (بشهاب) بالتنوين، جعلوا القبس نعتا للشهاب، وقرأ الباقون: بغير تنوين على الإضافة (¬1).(@)(@@) {قبس} هو العود الذي في أحد طرفيه نار، قال في (طه): {فلما قضى} [الآية: 10] ترجيا، وهنا (سآتيكم) إخبارا؛ لأن الراجي إذا قوي ترجيه، ربما حكم بوقوع الفعل، المعنى: أن موسى قال لزوجته لما ضربها الطلق، ورأى النار: اثبتوا مكانكم، سآتيكم بجزء منها.(@)(@@) {لعلكم تصطلون} تستدفئون من البرد، وكان ذلك في شدة الشتاء.(@)(@@) ...(@)(@@) {فلما جاءها نودي أن بورك من في النار ومن حولها وسبحان الله رب العالمين (8)}.(@)(@)(@@)(@@)(@@) || AUTO [8](@)(@)(@@) {فلما جاءها نودي أن بورك من في النار} أي: بورك على من في طلب النار، وهو موسى عليه السلام {ومن حولها} وهم الملائكة، والمراد بالنار: النور؛ لأن موسى حسبه نارا، وهذا تحية من الله -عز وجل- لموسى -عليه السلام- بالبركة؛ كما حيا إبراهيم على ألسنة الملائكة حين دخلوا عليه فقالوا: {قالوا أتعجبين من أمر الله رحمت الله وبركاته عليكم أهل البيت} [هود: 73]، ثم نزه تعالى نفسه فقال:(@)(@)PageV05P114(@)(@)(@@) {وسبحان الله رب العالمين} من تمام ما نودي به؛ لئلا يتوهم من سماع كلامه تشبيها، وللتعجيب من عظمة ذلك الأمر.(@)(@@) ...(@)(@@) {ياموسى إنه أنا الله العزيز الحكيم (9)}.(@)(@)(@@)(@@)(@@) || AUTO [9](@)(@)(@@) ثم تعرف إلى موسى بصفاته فقال: {ياموسى إنه} والهاء في (إنه) ضمير الشأن، والشأن {أنا الله العزيز الحكيم} صفتان لله تعالى، وروي أن موسى لما سمع الخطاب، فلم ير أحدا، قال: من الذي يكلمني؟ فقيل: {إنه أنا الله} (¬1).(@)(@@) ...(@)(@@) {وألق عصاك فلما رآها تهتز كأنها جان ولى مدبرا ولم يعقب ياموسى لا تخف إني لا يخاف لدي المرسلون (10)}.(@)(@)(@@)(@@)(@@) || AUTO [10](@)(@)(@@) ثم أرى موسى آية على قدرته تعالى {وألق عصاك} عطف على {بورك} أي: نودي أن بورك من في النار، وأن ألق عصاك.(@)(@@) {فلما رآها تهتز} تتحرك باضطراب. وتقدم اختلاف القراء في (رآها) في سورة الأنبياء عند تفسير قوله تعالى: {وإذا رآك الذين كفروا} [الآية:36].(@)(@@) {كأنها جان} حية صغيرة.(@)(@@) {ولى مدبرا} وهرب من الخوف.(@)(@@) {ولم يعقب} لم يرجع بعد هربه.(@)(@)PageV05P115(@)(@)(@@) فقال الله تعالى: {ياموسى لا تخف 