ms1	(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0110.jpg)(@)(@)(@@) بسم الله الرحمن الرحیم(@)(@@)(@@)(@@) | باب اول(@)(@@)(@@)(@@) | [در توحید وعرفان](@)(@@) شیخ مجدالدین بغدادی(@)(@@) (@@) ای نسخهآ نامهآ الهی، که تویی %~% وی آینهآ جمال شاهی، که تویی(@)(@@) (@@) سیرون زتونیست، هر چه در عالم هست %~% در خود بطلب هرآنچه خواهی، که تویی(@)(@@)(@@)(@@) | شیخ اوحد کرمانی(@)(@@) (@@) هان، تا سر رشتهآ خرد گم نکنی %~% خود را زبرای نیک وبد گم نکنی(@)(@@) (@@) رهبر تویی، وراه توو، منزل تو %~% هش دار که راه خود، به خود گم نکنی(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) بی کفر، به پایگاه ایمان نرسی %~% بی جان دادن، به وصل جانان نرسی(@)(@@) (@@) مس نادره رسمی است، که در عالم عشق %~% اله %~% چون درد رها کنی، به درمان نرسی!(@)(@@) (@@) گر راست روی دلا، به مقصود رسی %~% ور نفس رها کنی، به معبود رسی(@)(@@) (@@) توشاهد حالی، چوبه عبرت نگری %~% در هر چه نگه کنی، به مشهود رسی PageV01P107(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0111.jpg)(@)(@)(@@)(@@)(@@) | باب اول - توحید وعرفان(@)(@@)(@@)(@@) | وله(@)(@@) (@@) گه، در ره دل یگانه ای می جویی %~% گاه، از کف دهر دانه ای می جویی(@)(@@) (@@) چون از سر خویش بر نمی دانی خاست %~% ای تردامن، بهانه ایمی جویی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) آن را که به هر نیک و بدش می جویی %~% با توست، ولیکن تو از و می پویی(@)(@@) (@@) تا باتوتویی تو، می نباشی با او %~% وان دم که توبا تونیستی، با او یی(@)(@@) (@@) اندر ره عشق، آرمیدن نتوان تا پای به سر برننهی چون پرگار %~% وله(@)(@@) %~% وین ره، به خودی خود بریدن نتوان %~% در نقطهآ این نکته، رسیدن نتوان(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) در غمکدهآ بندگیت شادیهاست %~% آن را که زبندگیت آزادیهاست(@)(@@) ~~شاگرد هوس، نداند این واقعه را در دانش این واقعه، استادیهاست(@)(@@)(@@)(@@) | اوله(@)(@@) ~~ره می نبریم و، هم طمع می نبریم کردیم هر آن حیله که عقل آن دانست(@)(@@) %~% نتوان دانست، بوک بتوان دانست %~% تا بوک توان رهی به جانان دانست(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 0کس را غم عشق توامان می ندهد %~% کس نیست که از عشق توجان می ندهد(@)(@@) (@@) درعشق تو، گم گشته سر رشتهآ خلق %~% وز وصل 
ms2	 تو، هیچ کس نشان می ندهد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 11 در راه، اگر به پیشوایی نرسی %~% وز درد دل خود، به دوایی نرسی(@)(@@) (@@) یا پای به گور خود فرو کوب تمام %~% یا دست بدار، از آنکه جایی نرسی(@)(@@)(@@)(@@) | فخرالدین رازی(@)(@@) (@@) 12 در خلوت دوست، پوست زحمت باشد %~% هرچ آن نه خیال اوست، زحمت باشد(@)(@@) (@@) توسایهآ دشمنی، کجا در گنجی %~% جایی، که خیال دوست زحمت باشد PageV01P108(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0112.jpg)(@)(@)(@@)(@@)(@@) | مجدالدین بغدادی(@)(@@) (@@) هر موی تورا، هزار صاحب هوس است %~% تا خود به تو از جمله که را دسترس است(@)(@@) (@@) آن کس که بیافت، دولتی یافت عظیم %~% اوله %~% وان را که نیافت، درد نایافت بس است(@)(@@) (@@) هر چند، تورا هزار صاحب هوس است %~% تا خود به وصال تو که را دسترس است(@)(@@) (@@) آن کس که بیافت، دولتی یافت عظیم %~% وان را که نیافت، درد نایافت بس است(@)(@@)(@@)(@@) | شیخ اوحدالدین کرمانی(@)(@@) (@@) زان پس که دلم بسی به غمهاش بزیست %~% و ین دیده به اشکهای خونین بگریست(@)(@@) (@@) یک راه به صد کرشمه در ما نگرید %~% پرسید زدیگران که : این باری کیست؟(@)(@@)(@@)(@@) | عز شروانی(@)(@@) (@@) ای دل، طلب یار به مشتاقی کن %~% وزبادهآ نیستی، دمی ساقی کن(@)(@@) (@@) خواهی که کمال معرفت دریابی %~% اوله %~% یک لحظه، از آن خویش در باقی کن(@)(@@) (@@) سررشتهآ مقصود کسی، یافته نیست %~% کان رشتبه، به اختیار کس تافته نیست(@)(@@) (@@) چون رشته زغم مپیچ کانجا کس را %~% زان رشته هنوز کسوتی بافته نیست(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) چون درنگرم به چشم بی خویشتنی گر یک نظر از تویی به من برفکنی %~%(@)(@@) اله %~% در خود غلطم، که من توام یا تومنی؟ %~% آثار منی همه به هم برشکنی(@)(@@) (@@) در عشق خود از غایت بی خویشتنی %~% می نشناسم که من توام، یا تومنی(@)(@@) ~~هم با من و هم بی منی، آری چه عجب خود دیدهآ ره بین توبس تاریک است(@)(@@) %~% وله %~% جانی که نه درتنی نه بیرون تنی %~% ورنه به توجانان توبس نزدیک است(@)(@@) ~~یک پرده حجاب است میان توواواندیشه قوی کن، 
ms3	 که سخن باریک است(@)(@@)(@@)(@@) | اله(@)(@@) ~~2زان روی که عشق از دوجهان حاصل ماست گویی تن ما زعشق و، عشق از گل ماست(@)(@@) (@@) از غایت عشق، فرق می نتوان کرد %~% کاندر دل ماست عشق، یاخود دل ماست PageV01P109(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0113.jpg)(@)(@)(@@) باب اول - توحید وعرفان(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 22ای دل، زوصال او نشان نیست پدید %~% چیزی مطلب، که در جهان نیست پدید(@)(@@) (@@) جان و دل و دیده هر سه از دوست برید %~% وین طرفه، که دوست در میان نیست پدید(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3آن دوست، که هست عشق او دشمن جان %~% بر باد همی دهد خمش خرمن جان(@)(@@) ~~من می دوم اندر طلبش، کوی به کوی او در دل و، دست کرده در گردن جان(@)(@@) کمال الاسلام خجندی(@)(@@) ~~24 در خود چونگه کنیم، بیگانگی است با او چونفس زنیم، دیوانگی است(@)(@@) ~~نه دوری نه نزدیک، نه پیدا، نه نهانمی دان و مپرس، کاین سخن خانگی است!(@)(@@) شیخ تاج الدین اشنهی(@)(@@) (@@) 2دوش این دل [ما] جامهآ جان شق می زد %~% خیمه زبر طارم ازرق میزد(@)(@@) (@@) اندر نظرش چوهیچ موجود نماند %~% بی واسطهای، دم انا الحق می زد(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~26 می گرچه حرام است، ز پیمانهآ اوس دل گرچه خراب می کند، خانهآ اوست(@)(@@) (@@) نشنید کسی که عقل دیوانه شود %~% من بندهآ آنکه عقل دیوانهآ اوست(@)(@@)(@@)(@@) | اادری(@)(@@) ~~22 زان می خوردم که روح پیمانهآ اوست وان مست شدم که عقل دیوانهآ اوست(@)(@@) (@@) بادی به من آمد، آتشی در من زد %~% زان شمع که آفتاب پروانهآ اوست(@)(@@) شرف الدین مرتضی(@)(@@) ~~28شهری است که نام او ندانم چون است از عالم عقل و وهم وحس بیرون است(@)(@@) (@@) بادش دم حسرت است، و آتش غم دل %~% خاکش همه حیرت است و، آبش خون است(@)(@@) (@@) 29هر روز، دلم غم جهانی بخورد %~% اوله %~% وز هرناکس، زخم زبانی بخورد(@)(@@) ~~خون گرید و جان کند وره ننماید(؟)این جمله، زبهر آنکه نانی بخورد(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~هرنامه، که سرعشق عنوان دارد توقیع رفیع خسروجان دارد(@)(@@) (@@) زان حرف، که عشق 
ms4	 بر وی انگشت نهاد %~% در عالم بی اشارتی، آن دارد PageV01P110(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0114.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3با زحمت جان، به وصل جانان نرسی %~% بر مورنشسته، با سلیمان نرسی(@)(@@) (@@) این قصه، به پایان نرسد بار نخست %~% تو، پیشتر از غصه به پایان نرسی(@)(@@) نجم الدین حمد سیمگر(@)(@@) (@@) یاری، که وجود وعدم توهمه اوست %~% سرمایهآ شادی وغم تو، همه اوست(@)(@@) (@@) تودیده نداری، که مگر در نگری %~% ورنه [که] زسر تا قدم تو همه اوست(@)(@@)(@@)(@@) | عمر خیام(@)(@@) (@@) تا راه قلندری نپویی نشود %~% رخساره به خون دل نشویی نشود(@)(@@) (@@) سودا چه پزی، تا که چو دلسوختگان %~% آزاد به ترک خود نگویی نشود(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) یک روز، زبند عالم آزاد نیم %~% یک دم زدن، از وجود خود شاد نیم(@)(@@) (@@) شاگردی روزگار کردم بسیار %~% در کارجهان، هنوز استاد نیم(@)(@@)(@@)(@@) | وله(@)(@@) (@@) هرگز، دل من زعلم محروم نشد %~% کم ماند زاسرار که مفهوم نشد(@)(@@) (@@) با این همه، چون بنگرم از روی خرد %~% عمرم بگذشت و، هیچ معلوم نشد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) دشمن به غلط گفت، که من فلسفیم %~% ایزد داند، که آنچه او گفت نیم(@)(@@) (@@) لیکن چو در این غم آشیان آمدهام %~% اله %~% آخر، کم از آنکه من بدانم که کیم(@)(@@) (@@) ستیم و بلندیم و، کمالیم وکمیم ماییم، که اصل شادی و کان غمیم %~% له(@)(@@) %~% ایینهآ زنگ خورده و، جام جمیم! %~% سرمایهآ دادیم و، نهاد ستمیم(@)(@@) (@@) ترکیب طبایع چوبه کام تودمی است %~% رو شاد بزی، اگر چه بر توستمی است(@)(@@) (@@) با اهل خرد باش، که اصل تن تو %~% گردی و نسیمی و شراری و نمی است!(@)(@@)(@@)(@@) | اوحد کرمانی(@)(@@) (@@) 2سر قدر، از جهانیان پنهان است %~% آن سر به طریق عقل نتوان دانست(@)(@@) (@@) در جستن آن نقطه که مقصود آن است %~% چون دایره، هر که هست سر گردان است PageV01P111(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0115.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 40تا دل زعلایقت یگانه نشود %~% یک تیر تو را سوی نشانه نشود(@)(@@) (@@) تا هر دو جهانت از میانه نشود %~% کشتی به سلامت به کرانه نشود(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 41 خاکش بر سر، کزین سرا اندیشد 
ms5	 %~% بر جای نماند و، زجا اندیشد(@)(@@) (@@) اندیشهآ نیستی چودامن گیرد %~% چون بنده زهستی خدا اندیشد(@)(@@)(@@)(@@) | معین الدین بختیار(@)(@@) (@@) 2،گر دل زبد و نیک جهان پردازی %~% بس برگ ره کوی سعادت سازی(@)(@@) (@@) جایی رسی از کمال، کز کاس مراد %~% می نوشی و، جرعه بر سپهر اندازی!(@)(@@)(@@)(@@) | حاجی شروانی(@)(@@) (@@) 3،از روز ازل، در هوسی وقت خوشم %~% هرگز نشدهست از کسی، وقت خوشم(@)(@@) (@@) بالله، که حسین وار بر دار شوم %~% وله %~% گر روی نماید نفسی وقت خوشم(@)(@@) (@@) 4 آن سر که نمی توان نشان یافتنش %~% الآ گه صبح از ره جان یافتنش(@)(@@) ~~5،کام دل از ان حضرت والا، در صبح و آن دم، که در و گنج بقا تعبیه(@)(@@) است %~% اوله %~% اندر نفس صبح توان یافتنش %~% در خواه، که هرگز نبود لا در صبح(@)(@@) (@@) کان گنج سعادت، که تواش می طلبی %~% کس را نشود میسر، الا در صبح(@)(@@)(@@)(@@) | جمال الدین خلیل(@)(@@) (@@) 46 آن کس که بود هواشناسی اورا %~% ممکن نبود خداشناسی او را(@)(@@) (@@) خواهی که خدای خویشتن بشناسی %~% خود را بشناس، تا شناسی اورا(@)(@@)(@@)(@@) | اله(@)(@@) ~~7، ای عقل مرا به خویشتن بازگذارزنهار، مگو هیچ، سخن باز گذار(@)(@@) (@@) برجان عزیز من ببخشا نفسی %~% وله %~% یعنی، نفسی مرا به من باز گذار(@)(@@) ~~8،چون هر دو یکی شدند جان من و تو شاید که یکی بود نشان من و تو(@)(@@) (@@) من تو شده ام، تومن شدستی، اکنون %~% فرقی نتوان کرد میان من وتو PageV01P112(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0116.jpg)(@)(@)(@@)(@@)(@@) | نمط سیوم(@)(@@)(@@)(@@) | درنصیحت(@)(@@)(@@)(@@) | شیخ احمد غزالی(@)(@@) (@@) ازدی که گذشت، اگر خوری غم نرسی %~% فردا چه عجب، اگر درین دم نرسی(@)(@@) (@@) خوش باش درین نفس که هستی تو دراو %~% دادش بدهی، که اندرین هم نرسی(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) در عالم معرفت، صفایی بطلب %~% وز نور محبتش، ضیایی بطلب(@)(@@) (@@) از عالم و آدم، قدمی برتر نه %~% بیرون زخود و نفس، خدایی بطلب(@)(@@)(@@)(@@) | امام شهاب خواری(@)(@@) ~~کم زن در دنیا، که جوابت ندهددر کوی خطا، ره صوابت ندهد(@)(@@) (@@) والله، که تورا تشنه برد بر لب جوی %~% وآنگه 
ms6	 بکشد تشنه و، آبت ندهد(@)(@@)(@@)(@@) | حاجی شروانی(@)(@@) (@@) ای دل، پی او مرو که مستی نرسی %~% او نیک بلند است، توپستی نرسی(@)(@@) (@@) خواهی که به خالق برسی راست شنو %~% وله %~% تا رحمت مخلوق پرستی نرسی(@)(@@) (@@) ای پیشهآ تو همیشه خلق آزاری %~% صد خون بخوری و، رخصه بیرون آری(@)(@@) (@@) با اینهمه، نام خویش هشیار نهی %~% مستی به بسی به ز چنین هشیاری!(@)(@@)(@@)(@@) | عمر خیام(@)(@@) (@@) 5خوش باش، که پخته اند سودای تودی %~% فارغ شدهاند از تمنای تودی(@)(@@) (@@) قصه چه کنم؟ که بی تقاضای تودی %~% دادند قرار کار فردای تودی!(@)(@@) (@@) از دی که گذشت، هیچ از و یاد مکن %~% اوله %~% فردا که نیامدهست، فریاد مکن(@)(@@) (@@) برنامده و گذشته بنیاد مکن %~% حالی خوش باش و، عمر بر باد مکن PageV01P113(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0117.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 52 پیش از من و تو، لیل و نهاری بودهست %~% گردنده فلک نیز به کاری بوده ست(@)(@@) (@@) هرجا که قدم نهی توبر روی زمین %~% آن، مردمک چشم نگاری بودهست(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 7هر ذره، که در خاک زمینی بودهست %~% پیش از من وتو، تاج ونگینی بودهست(@)(@@) (@@) گرد، از رخ نازنین به آزرم فشان %~% کان هم، رخ خوب نازنینی بودهست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 58 هر راز، که اندر دل دانا باشد %~% باید که نهفته تر زعنقا باشد(@)(@@) (@@) کاندر صدف، از نهفتگی گردد در %~% آن قطره، که راز دل دریا باشد(@)(@@)(@@)(@@) | اوحد کرمانی(@)(@@) (@@) 9ای دل، دل ازین جهان غدار ببر %~% گل، خود به کف آید طمع ازخار ببر(@)(@@) (@@) در کعبه و، بر میانت زنار چه سود %~% اوله %~% در گوشهآ دیر باش و، زنار ببر(@)(@@) (@@) 6 ای دل، زپی ریا خدا می طلبی %~% وز مردم بد عهد، وفا می طلبی(@)(@@) (@@) از لقمهآ او، کاف کدورت خیزد %~% در گوشه نشین، اگر صفا می طلبی(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1 جهدی بکن ای خواجه، کزین عالم دون %~% بیرون افتی، که نیست این جای سکون(@)(@@) (@@) ور زانکه به اختیار بیرون نشوی %~% وله %~% دست اجلت کند به سیلی بیرون(@)(@@) (@@) 62 تا معترفی به زشتخویی، نیکی می کوش، 
ms7	 که هیچ بدنگویی کس را %~% تا(@)(@@) عیب کسی دگر نجویی، نیکی %~% گر بد باشی و، بد نگویی نیکی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 63ای دل، زنفاق در گذر تا برهی %~% بر صدق همی دار نظر، تا برهی(@)(@@) (@@) غم می خوری و، مال نگه میداری %~% روغم مخور ومال بخود، تا برهی!(@)(@)PageV01P114(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0118.jpg)(@)(@)(@@) (@@) چون شه ره فکر بر گشادند تو را %~% وله %~% وز علم وخرد، نصیبه دادند تورا(@)(@@) (@@) مرگیر حساب عمر خود، پیش از مرگ %~% وانگار که در گور نهادند تورا(@)(@@)(@@)(@@) | عزیزالدین طغرایی(@)(@@) (@@) نه خادم کس بود، نه مخدوم کسی آن کو به سلامت است و نانی دارد %~% وز(@)(@@) بهر نشست، آشیانی دارد %~% گوشاد بزی، که خوش جهانی دارد!(@)(@@)(@@)(@@) | لا ادری(@)(@@) (@@) سلطان ممالک همه عالم اوست 3 آن کو به سلامت است و دارد نانی %~% یا(@)(@@) در پوشد به عافیت خلقانی %~% خود کی رسد این ملک به هر سلطانی!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) آزار کسان طلب مکن بی سببی %~% هان تا نکند یار لبی زیر لبی(@)(@@) (@@) چندین، چه کنی تکیه بر آن مال و جمال %~% کو، نیست شود یا به تبی، یا به شبی!(@)(@@)(@@)(@@) | صدرزنگانی(@)(@@) (@@) از یارب و ناله، ای شهنشاه، بترس دلهای شکستگان، نگه دار به داد %~%(@)(@@) اوله %~% وی آینهآ مملکت، از آه بترس %~% از بهر خدا، زآه سحرگاه بترس(@)(@@) (@@) شاها، دل هیچکس میازار، بترس %~% انفاس شکستگان نگه دار، بترس(@)(@@) (@@) وز آه جگر سوختگان، وقت سحر %~% زنهار وهزار بار زنهار، بترس(@)(@@)(@@)(@@) | صدر کرمانی(@)(@@) (@@) چون اندک و بسیار به جابگذاری بسیار بخور، اگر چه اندک داری %~% چه(@)(@@) فرق، میان اندک و بسیاری؟ %~% بسیار بود اندک برخورداری(@)(@@)(@@)(@@) | اثیراخسیکتی(@)(@@) (@@) آن را که بکشتند و بپرورد و بزاد %~% دانند که روزیش همی باید داد(@)(@@) (@@) در نیز در رزق نخواهند گشاد %~% پالودن دل چه سود، و پیمودن باد؟(@)(@)PageV01P115(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0119.jpg)(@)(@)(@@)(@@)(@@) | ابوعلی سینا(@)(@@) (@@) 72ای در دو نفس عمر تو افزاینده %~% بادی است نفس شونده و آینده(@)(@@) (@@) برباد نهاده ای، بنای همه عمر %~% بر باد، کجا بود بنا پاینده؟(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 73شادی مطلب 
ms8	 زعالم و، شاد بزی %~% تن در غم گردون ده و، آباد بزی(@)(@@) (@@) از هر چه زتو برید خواهد فردا %~% اولها %~% امروز ببر به نقد، و آزاد بزی(@)(@@) (@@) 74 در بند جهان مباش و، آزاد بزی %~% وز باده خراب گرد و، آباد بزی(@)(@@) (@@) تا زندهای، از مرگ مباش ایمن تو %~% یک بار بمیر و، تا ابد شاد بزی(@)(@@) فخرالدین مبار کشاه(@)(@@) (@@) 75هر دم که گزیدی، آن دمت بستانند %~% ور شاد شوی به غم، غمت بستانند(@)(@@) (@@) با محنت خوش باش، چودادندت از آنک %~% با آنت چوخوش فتد، همت بستانند(@)(@@) قاضی کمال مراغهای(@)(@@) (@@) 26 زین کشت دلا، به خوشهای قانع باش %~% چون رهگذری، به توشه ای قانع باش(@)(@@) (@@) بر رقعهآ شطرنج وفا راست برو %~% وآنگاه، چورخ به گوشهای قانع باش(@)(@@)(@@)(@@) | وله(@)(@@) ~~7امروز، ببر هر چه تورا پیوند است زیرا همه بر پای توفردا بند است(@)(@@) (@@) سودی طلب از عمر، که سرمایهآ عمر %~% روزی چند است و، کس نداند چند است(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~28اسرار چوسخت است، سخن سست مگو ره گم کن و، هر چه عقل واجست مگو(@)(@@) ~~دانستنیش، مرتبت توست بدان ناگفتنیش، مصلحت توست مگو(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 99 غافل منشین که همنشینان رفتند %~% ره نیک ببین، که راه بینان رفتند(@)(@@) (@@) قومی، که قرینان موافق بودند %~% آن قوم گذشت و، آن قرینان رفتند PageV01P116(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0120.jpg)(@)(@)(@@)(@@)(@@) | معین الدین بختیار(@)(@@) (@@) با طبع، مدام رای تصدیق زنی %~% وانگه، همه لاف از ره توفیق زنی(@)(@@) (@@) تحقیق زتقلید ندانسته هنوز %~% هم، شرم نداری دم تحقیق زنی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) نفس پاکت زمه سوی ماهی شد %~% زان روی که عمر تو، به گمراهی شد(@)(@@) (@@) ای غافل از آنکه از کجا آمدهای %~% خود را دریاب تا کجا خواهی شد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) ای نفس خبیث غافل دیو پرست %~% چندین سخن صفا چه گویی پیوست(@)(@@) (@@) زین آتش دل گر آب رو می طلبی %~% الغیره %~% خاکت بر سر، که باد داری در دست!(@)(@@) ~~ای دل، پس ازین به راه غفلت مشتاب از پیروی دیو هوا، رو بر تاب(@)(@@) (@@) چون 
ms9	 عمر عزیز رفت، غافل منشین %~% له %~% وین یک دو نفس را که در و بی، دریاب(@)(@@) (@@) بی عشق مشو، تارگ جان نبرندت %~% جانان مطلب، تا زجهان نبرندت(@)(@@) (@@) می بین نه به دیده، تات بینا خوانند %~% میدان و مگوی، تا زبان نبرندت!(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 8ای خواجه، تو در خرابت آباد بزی %~% گر داد نباشدت به بیداد بزی(@)(@@) ~~در هستی و نیستی چرا بندی دل؟ انگار که نیستی و، آزاد بزی(@)(@@) (@@) بیداد گری مکن، که دادت ندهند %~% لغیره %~% چشمی و دلی، روشن و شادت ندهند(@)(@@) (@@) ازآتش و از آب جهان بگذشتی %~% در خاک چنان شو ، که به بادت ندهند(@)(@@)(@@)(@@) | پسرا خطیب گنجه(@)(@@) (@@) 8 شاید که دلت زهر بدی پرهیزد %~% گآل کار، که خارا گر نکاری خیزد(@)(@@) (@@) تو دوست گزین، که با تو مهر آمیزد %~% دشمنت، زمانه خود هزار انگیزد(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 88 ای دل، چوبرفت کاروان همره باش %~% وی عمر، چو هرزه می روی کوته باش(@)(@@) (@@) وی دل، به یقین دان تو که هر دم که زنی %~% بر ناقد عرض می کنم، آگه باش PageV01P117(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0121.jpg)(@)(@)(@@)(@@)(@@) | سعد لحافی(@)(@@) ~~9از رشتهآ دل، تاب سخن نتوان برد رنگ از رخ اصحاب سخن نتوان برد(@)(@@) (@@) آتش نتوان فکند، در خرمن نفس %~% وز بهر دونان، آب سخن نتوان برد(@)(@@) (@@) 90از گنبد گردنده، بد افعالی بین %~% الغیره %~% وز صحبت دوستان، جهان خالی بین(@)(@@) (@@) تا بتوانی، یکی زمان خود را باش %~% فردا منگر، دی مطلب، حالی بین!(@)(@@)(@@)(@@) | عمر خیام(@)(@@) (@@) 91هم دانهآ اومید، به خرمن ماند %~% هم باغ وسرای، بی تو و من ماند(@)(@@) (@@) سیم و زرخویش، از درمی تا به جوی %~% با دوست بخور، گرنه به دشمن ماند!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 92تا چند، زجان مستمند اندیشی %~% تا کی، زجهان پرگزند اندیشی(@)(@@) (@@) آنچ از توتوان ستد، همین کالبد است %~% یک مز بله گومباش، چند اندیشی(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 93گاهی، کنی از زیر زمین اندیشه %~% گاهی، کنی از چرخ برین اندیشه(@)(@@) (@@) اندیشه بکن، ببین که شاید کردن %~% از بهر دو روزه عمر، این 
ms10	 اندیشه(@)(@@)(@@)(@@) | نمط چهارم(@)(@@)(@@)(@@) | در طامات(@)(@@)(@@)(@@) | شیخ اوحد کرهانی(@)(@@) (@@) 94از زهد، نبود هیچ راحت ما را %~% وز مدرسه نیز، جز جراحت ما را(@)(@@) (@@) روزی دوسهآ دگر، مباحی باشیم %~% تا خود چه گشاید از اباحت ما را(@)(@@) (@@) 95 ترسم، نستانند زدیوانه گرو %~% وله %~% ورنه کنمی، خرقه به میخانه گرو(@)(@@) (@@) مردان طریقت، از برای می ناب %~% کردند، بسی خرقه و کاشانه گرو PageV01P118(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0122.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) گر گل نبود نصیب ما، خار اینک! %~% ور نور به ما نمی رسد، نار اینک1(@)(@@) (@@) ور خرقه وخانقاه و شیخی نبود %~% ناقوس و کلیسیا و زنار اینک!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~9سهل است مرا بر سرخنجر بودندر پای مراد دوست بی سر بودن(@)(@@) (@@) تو آمدهای، که کافری را بکشی %~% غازی چوتویی، رواست کافر بودن!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 9 دی، دردکش درد کشان من بودم %~% در مجلسشان بدین نشان من بودم(@)(@@) (@@) گفتم: بدو نیکشان ببینم چون است؟ %~% چون نیک بدیدم، بدشان من بودم!(@)(@@)(@@)(@@) | شیخ احمد جام(@)(@@) (@@) اسرار خرابات، کسی را شاید %~% کاین کون ومکان، به چشمش اندر ناید(@)(@@) (@@) از چشمهآ معرفت، کسی آب خورد %~% کز آب حیات، تشنه بیرون آید(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 100 ای دل، ره آفات گزین گر مردی %~% در زهد خرافات مبین، گر مردی(@)(@@) (@@) در کعبه، زنان نیز توانند نشست %~% در کنج خرابات نشین، گر مردی!(@)(@@)(@@)(@@) | شیخ ابوسعید ابوالخیر(@)(@@) (@@) 101 ما را جز ازین زبان زبانی دگر است %~% جز دوزخ و فردوس، مکانی دگر است(@)(@@) (@@) قلاشی وعاشقی ([است]، سرمایهآ ما %~% قرایی و زاهدی، جهانی دگر است(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~101 هر روز، مقامم به مکانی دگر است در هر منزل، مرا نشانی دگر است(@)(@@) (@@) نه من دانم، نه هیچ کس احوالم %~% هر طایفه را به من گمانی دگر است PageV01P119(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0123.jpg)(@)(@)(@@)(@@)(@@) | فخرالدین رازی(@)(@@) ~~103 سیر آمدم، از ساز کژ آهنگ وجود زین پردهآ بی نوای ده رنگ وجود(@)(@@) (@@) صد سجدهآ شکر، در عدم بیش برم %~% گر باز رهد نام من، از ننگ وجود(@)(@@) شیخ شهاب الدین سهروردی(@)(@@) (@@) 104 امروز، منم در قفس تنگ وجود %~% محتاج 
ms11	 به بوی عدم از ننگ وجود(@)(@@) (@@) کوصیقل لطف، تا دمی بزداید %~% از آینهآ حقیقتم، زنگ وجود(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 105 تنگ آمدهام، زین قفس تنگ وجود %~% خون خوردهام، از وجود هم سنگ وجود(@)(@@) (@@) گه گه، زوجود خویش باز اندیشم %~% خواهم، که شوم با عدم از ننگ وجود(@)(@@) شیخ مجدالدین بغدادی(@)(@@) (@@) 106 عشق تو، ز من دل و جهان نیز ببرد %~% عقلی که نبود، ناله آن نیز ببرد(@)(@@) (@@) گفتم: دین هست، اگر دل و دنیا نیست %~% سیلاب قضا در آمد، آن نیز ببرد(@)(@@) لاادری قائله (ازحاشیه)(@)(@@) (@@) 107 گرمن زمی مغانه مستم، مستم %~% گر کافر [و] گبر بت پرستم، هستم(@)(@@) (@@) هر طایفه را به من گمانی دگر است %~% من مرد خودم خ. ........ هستم(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 108 زان باده، که عقل را کند مست، بیار %~% وان ساز، که می زنند بی دست، بیار(@)(@@) (@@) از هستی خویشتن به جان آمدهام %~% یک شربت نیستی، اگر هست، بیار(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 109 ای دل، زنشاط و عیش دوری تا چند %~% وز رود و سرود و می، صبوری تا چند(@)(@@) (@@) رویک دو سه نقش اختیاری بنما %~% اوله %~% تا چند ازین زهد ضروری، تا چند(@)(@@) (@@) 110 ماییم، بهم آمده بد نامی چند %~% ساقی، می آسوده بده جامی چند(@)(@@) (@@) در ده، کس نیست هان پیاپی در ده %~% وله %~% رغم دو سه قلتبان و نمامی چند(@)(@@) (@@) 112 زین پس، همگی در آرزوی آنم بعنی که از آن پیش کاجل بستاند %~%(@)(@@) خود را، نفسی مگر زخود بستانم %~% کاین یوسف جان، زگرگ غم برهانم PageV01P120(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0124.jpg)(@)(@)(@@)(@@)(@@) | عمر خیام(@)(@@) (@@) 11 بر شاخ امید، اگر بری یافتمی %~% هر رشتهآ خویش را، سری یافتمی(@)(@@) ~~تا چند زتنگنای زندان وجود 1 گر جام جهان نمای جم را دانی آن جام(@)(@@) چوبشکست، جهان ننماید %~% الغیره %~% ای کاش، سوی عدم دری یافتمی %~% جامی(@)(@@) وجمی و، به جهان پنهانی %~% جام تو چو بشکست جهان جانی(@)(@@)(@@)(@@) | نمط پنجم(@)(@@)(@@)(@@) | در مناجات(@)(@@) شیخ اوحدالدین کرهانی(@)(@@) (@@) یرم که من از چاره گری محرومم 11 یارب، کرم 
ms12	 تو بی نیاز است آخر %~%(@)(@@) وله %~% الطاف تو، بیچاره نواز است آخر %~% برخلق، در فضل تو باز است آخر(@)(@@) (@@) 11 بنیاد دل من، غم تو ویران کرد %~% جانم، هوس عشق تو سرگردان کرد(@)(@@) (@@) زانجا که تویی، مگر که لطفی بکنی %~% نیداست، از اینجا که منم چتوان کرد(@)(@@)(@@)(@@) | وله(@)(@@) ~~11 من، در ره عشق توچه پویم، که کیم گر لطف توام دست نگیرد، امروز(@)(@@) %~% وصلت به کدام مایه جویم، که کیم %~% فردا، به کجا روم چه گویم، که کیم(@)(@@)(@@)(@@) | وله(@)(@@) ~~در هر که گریختم زتو، سود نداشت ای از پی دیدنت منور چشمم 1 از(@)(@@) عقل، بلند اگر نیم پستم گیر %~% ال %~% هشیار غم تو گر نیم، مستم گیر %~%(@)(@@) نور تو گرفتهست، سراسر چشمم %~% از تو به تودر گریختم، دستم گیر(@)(@@) (@@) از خاک در تو، سرمه ای بخش مرا %~% تسا، جز تو کسی نیاید اندر چشمم PageV01P121(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0125.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~119 وصل تو، چومن گدا تواند دیدن؟هر ناکس و بینوا، تواند دیدن؟(@)(@@) (@@) این خواب دروغ است که من می بینم %~% خود جز تو، کسی تورا تواند دیدن؟(@)(@@) (@@) 120 چون از خم توست می، چه صافی و چه درد %~% وله %~% از تو، چه بزرگ تحفه ای جان و، چه خرد(@)(@@) (@@) هم ناز تو، گر ناز کسی باید برد %~% هم پیش تو، گر پیش کسی باید مرد!(@)(@@) (@@) 121 در عشق تو دادم دل ودین، بس باشد %~% اوله %~% دل گشت تهی زمهر و کین، بس باشد(@)(@@) (@@) نیک و بد خویش گفتنم، حاجت نیست %~% می دانی و می توانی، این بس باشد!(@)(@@) شیخ مجدالدین بغدادی(@)(@@) (@@) 122 گر تو، سگی از سگان خویشم خوانی %~% یا مرغی از آشیان خو یشم خوانی(@)(@@) (@@) هر نام که خوانی ام، روا میدارم %~% اینم نه بس است، کان خویشم خوانی؟(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 123 آنها، که مقیم آستان توزیند %~% کی کشته شوند، چون به جان توزیند(@)(@@) (@@) ازآب حیات، خود چنان نتوان زیست %~% کز آتش عشق، دوستان توزیند(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 124 تا جان دارم، چو پاسبان 
ms13	 کویت %~% می گردم، گرد آستان کویت(@)(@@) (@@) باشد روزی بر آید، ای جان وجهان %~% نامم به جریدهآ سگان کویت(@)(@@)(@@)(@@) | اسماعیل باخرزی(@)(@@) (@@) 125 آن کیست، که در عشق توجان می ندهد %~% یا در طلبت، جان و جهان می ندهد(@)(@@) (@@) سیار کسان، به تونشانها دادند %~% لیکن زتو، هیچ کس نشان می ندهد(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) 12 جان، از ازل آمد آشیان غم تو %~% دل، تا به ابد بود مکان غم تو(@)(@@) (@@) من، جان ودل خویش بدان دارم دوست %~% کاین داغ تو دارد، آن نشان غم تو(@)(@@)(@@)(@@) | اسعد گنجه ای(@)(@@) (@@) 127 در کوی توه ما را گذری بایستی %~% وز لعل تو، ما را شکری بایستی(@)(@@) (@@) تا از غم عشقت خبری وادادی %~% از هر دو جهان بیخبری بایستی PageV01P122(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0126.jpg)(@)(@)(@@)(@@)(@@) | جمال حاجی شروانی(@)(@@) (@@) 12 گر می خواهی که دل تورا بشناسد %~% و احوال بقا بعد فنا بشناسد(@)(@@) (@@) یک قطره می محبت از جام صفا %~% بر کام دلم بریز، تا بشناسد(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) ~~129 بیچاره دل خسته، به اول نظرت در دیدهآ خود دید چو نور بصرت(@)(@@) ~~اد هوس تو کرد تیز آتش عشق زین پس، من و آب دیده و خاک درت(@)(@@)(@@)(@@) | له(@)(@@) (@@) وزغایت جست وجوی من در طلبت 130 از خاک درت، بوی جنان می جویم %~%(@)(@@) جایی که ندانمت، نشان می جویم %~% وز بوی غمت، لذت جان می جویم PageV01P123(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0127.jpg)(@)(@)(@@)(@@)(@@) | باب دوم(@)(@@) ~~درمدح ودعا(@)(@@) ~~وآن دونمط است(@)(@@)(@@)(@@) | نمط اول(@)(@@)(@@)(@@) | در مدح(@)(@@) ~~سید اشرف گوید(@)(@@) ~~131 ای از تو فتاده در جهان آوازه بگذشت ممالک تو از اندازه(@)(@@) ~~برخور، که خدا می دهدت هر روزیشهری خوش و، تختی نو و، ملکی تازه(@)(@@)(@@)(@@) | اوله(@)(@@) ~~132 در رزم و به بزم، ای ملک عدل پرست شش چیز زشش چیز تو نازد پیوست:(@)(@@) ~~تیغ از کف و، رایت زصف و، تیر ازشستتاج از سر و، تخت ازقدم و، جود از دست(@)(@@)(@@)(@@) | وله(@)(@@) ~~133 ای داده ز ملک و دین ترا یزدان، بخش از رحمت تو هرچه بخواهند آن 
ms14	 بخش(@)(@@) (@@) جان بخشیدی، بستدی از فتنه جهان %~% احسنت، زهی جهانستان جان بخش!(@)(@)PageV01P124(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0128.jpg)(@)(@)(@@) (@@) 134 شاها، سوسن نمونهآ پروین شد در مدح تو، چون دهان سیمین بگشاد %~%(@)(@@) اوله %~% زان خطهآ بزم از و بهشت آیین شد %~% در حال، همه زبان او زرین شد(@)(@@)(@@)(@@) | رشید وطواط(@)(@@) (@@) 135 ای طالع توعهدهٔ‌ احکام فلک %~% بر بود سیاست تو آرام فلک(@)(@@) (@@) مأمور اشارت تو، اجزای زمین %~% منقاد ارادت تو، اجرام فلک(@)(@@) (@@) 132 ای ورد ملائکه دعای سر تو %~% معزی %~% سرنیست زمانه [را] بهای سر تو(@)(@@) (@@) با دشمن تونیام شمشیر تو گفت: %~% سردل من باد، قضای سر تو!(@)(@@)(@@)(@@) | ظهیر فاریابی(@)(@@) ~~1 پروین، خواهد که طرف ساز توشود مه را، شرف این نه بس که هر ماه(@)(@@) دوبار %~% چون نعل سمتد و، طبل باز توشود! %~% زهره، که به طبع رود ساز توشود(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 138 ای از تو بلند نام شاهنشاهی %~% بگرفته زماه رایتت تا ماهی(@)(@@) (@@) با عزم تو، کآسمان به گردش نرسد %~% وله %~% جز فتح وظفر که را رسد همراهی؟(@)(@@) (@@) 13 چون لشکر شه روی به راه آوردند %~% اسلام به تیغ در پناه آوردند(@)(@@) (@@) آن را که ز پیل رخ بتابید بر اسب %~% امروز، پیاده پیش شاه آوردند(@)(@@) (@@) 14 شاها، به تو دارد همه آفاق نیاز %~% وله %~% برخیز و، جهان بگیر و، بخرام به ناز(@)(@@) (@@) از هر طرفی که منزلی کوچ کنی %~% اقبال، دو منزلت به پیش آید بازا PageV01P125(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0129.jpg)(@)(@)(@@)(@@)(@@) | کمال اصفهانی(@)(@@) ~~141 از بحر کف تو، چون برآمد تیغتنشگفت، که پر زگوهر آمد تیغت(@)(@@) (@@) ز بس که دو ید در قفای دشمن %~% از تیزی خویش، در سر آمد تیغت(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 142 تیغ تو، که لب تا لب اودندان است %~% دندان اجل در لب او پنهان است(@)(@@) (@@) در چشم حسودت، ارچه آبی تنک است %~% بسیار جهانگیرتر از طوفان است!(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) ~~وان تیر، که زد بر دل بدخواه تومرگ 143 با تیغ تو، ار دشمنت آهن باشد(@)(@@) %~% چون تیغ تو، خونین دل و دامن باشد 
ms15	 %~% یاسج گردد، اگر چه سگ زن باشد(@)(@@)(@@)(@@) | شمس اسعد(@)(@@) (@@) 144 ای خاص ترین کل اشیا که تویی %~% وی زبدهآ کارگاه اعلا که تویی(@)(@@) (@@) در حال، بیفتد کله از تارک عرش %~% گر بر نکرد به رفعت، آنجا که تویی!(@)(@@) شرف الدین صالح بیلقانی(@)(@@) (@@) 145 در مغرکه، ای تیغ زن شیر شکر %~% بدخواه تو را که از خودش نیست خبر(@)(@@) (@@) تسیغ تو وتیر تو، چوخون و سوداست %~% کاین عزم دماغ دارد، آن قصد جگر(@)(@@)(@@)(@@) | نمط دوم(@)(@@)(@@)(@@) | دردعا(@)(@@) صدر الدین خجندی گوید(@)(@@) (@@) 142 ای برده ملوک پیش تخت تونماز %~% وی دست مبارک تو درمان نیاز(@)(@@) (@@) در کام دل وعیش خوش وعمر دراز %~% دشمن شکر و صف شکن و بنده نواز(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 147 یارب، که به کام دوستانش داری %~% وز چشم بد خلق نهانش داری(@)(@@) (@@) دانای به حق تویی، تودانی یارب %~% آنچ از همه به بود، چنانش داری PageV01P126(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0130.jpg)(@)(@)(@@)(@@)(@@) | 22(@)(@@) جمال حاجی شروانی(@)(@@) (@@) 14 در دست تو، گاه جام و گه خنجر باد %~% بر فرق تو، گاه تاج و گه افسر باد(@)(@@) (@@) اقبال و، تن حور و، کلاه شاهیت %~% این بر در و، آن در بر و، این بر سر بادا PageV01P127(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0131.jpg)(@)(@)(@@)(@@)(@@) | باب سیوم(@)(@@) در صفت شمع وشاهد(@)(@@) ظهیر فاریابی گوید(@)(@@) (@@) 149 ای شمع، کسی گریستن را ورزد %~% کز هیبت تو شمع فلک می لرزد(@)(@@) (@@) گیرم که عدوی خسرو وقت بمرد %~% آن مرده، بدین گریستن می ارزد(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) ~~150 ای شمع، به هرزه چند برخود خندیتو، سوز دل مرا کجا مانندی؟(@)(@@) (@@) فرق است میان سوز کزجان خیزد %~% با آنکه به ریسمانش بر خود بندی(@)(@@)(@@)(@@) | اوحد کرمانی(@)(@@) (@@) 151 ای تافته دل زغم، به جان خند چوشمع %~% کم خور غم جان و، بر جهان خند چوشمع(@)(@@) (@@) بر اهل جهان و، بر جهان نااهل %~% بی دیده گری و، بی دهان خند چوشمع(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) (@@) 152 هر دم زدنی، زشمع فرسوده رمق %~% دست اجل اندر .... .. . ورق(@)(@@) (@@) اندر تب مرگ کرده صد بار عرق %~% وآنگه خندان، 
ms16	 زهی دراز احمق!(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 153 ای شمع، به خنده در گشادی در خویش %~% چون روی بتی گرفتی اندر بر خویش(@)(@@) (@@) س غره شدی به تابش افسر خویش %~% زودا، که به طشت در ببینی سرخویش!(@)(@)PageV01P128(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0132.jpg)(@)(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 154 ای شمع، تو را نگفتم از نادانی %~% کزیار جدا مشو که تنها مانی(@)(@@) (@@) تا لاجرم امروز زبیفرمانی %~% وله %~% گریانی و سر بریده و سوزانی1(@)(@@) (@@) 155 دل نام توبرد، غم دهانش بگرفت مسکین دل من، چودل زجانش بگرفت %~%(@)(@@) چون جست کران، عشق میانش بگرفت %~% گفت آتش و، چون شمع زبانش بگرفت(@)(@@)(@@)(@@) | جمال خجندی(@)(@@) ~~ای عقل، نه جای توست، یک دم برخیز 15 ای دل، بر آن یار شکر لب بنشین(@)(@@) %~% در سایهآ آن زلف معقرب بنشین %~% ای شمع، نه وقت توست، یک شب بنشین!(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 15 خوش کرد زخوشی لبی، شمع لبی چون شمع، به سوز عمر بردیم به سر %~%(@)(@@) وله %~% اکنون، چومن است هر شبی جفت تبی %~% در حضرت شاهدی و شمعی و شبی(@)(@@) (@@) 158 با شمع، به سوختن چوپهلو سایم %~% از دیده، دل خونشده می پالایم(@)(@@) (@@) ینند زآه سرد، مانندهآ شمع %~% در اشک فسرده غرق سرتا پایم(@)(@@) (@@) 15 ای شمع به عمراندک و بسیار سرشک %~% وله %~% یک چشم تو و، هزار خروار سرشک(@)(@@) (@@) در گریه فزای، چون دهی سر بر باد %~% وله %~% بر باد همی ده سر و، می بار سرشک(@)(@@) (@@) 16 هر لحظه، زسوختن کمم همچون شمع %~% وزآب دو دیده، در نمم همچون شمع(@)(@@) (@@) با آنکه غمش کشت مرا، همچوچراغ %~% اله %~% من زنده به آتش غمم، همچون شمع(@)(@@) ~~161 در عشق تو، آن شب که بد- بدگریمبه زابر بهار و، از چنوصد گریم(@)(@@) (@@) یک چیز خوش آیدم زخود، آنکه چوشمع %~% چندان که بگریم، همه بر خود گریم(@)(@@)(@@)(@@) | اثیر اخسیکتی(@)(@@) ~~161 شمعم، که همه در سردل رفته تنم بی گریه شبی نبود خندان دهنم(@)(@@) (@@) پروانه، که گفت یار غار تو منم %~% او نیز، رضا داد به گردن زدنم PageV01P129(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0133.jpg) 
ms17	(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 163 در آتش هجرش همه تن می سوزم %~% مانندهآ شمع در لگن میسوزم(@)(@@) (@@) این طرفه، که اوست ماه و من می کاهم %~% و ین نادره، کوست شمع و من می سوزم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 164 گر نور مه و روشنی شمع توراست %~% این کاهش و سوزش من از بهر چراست؟(@)(@@) (@@) گرشمع تویی، مرا چرا باید سوخت %~% ور ماه تویی، مرا چرا باید کاست؟(@)(@@)(@@)(@@) | کمال اسعد زیاد(@)(@@) (@@) پروانه چوسوخت، شمع بگرفت برو 165 ای شمع، دلم به وصل بفروز آخر %~%(@)(@@) ای شمع، ز پروانه بیاموز آخر! %~% بخشای برین سوخته، یک روز آخر(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 166 از عشق تو ای دوست، روان می سوزد %~% شرحش چه دهم که برچه سان می سوزد(@)(@@) (@@) از ناله، چو چنگم رگ دل می گسلد %~% وزگریه، چو شمعم رگ جان می سوزد(@)(@@)(@@)(@@) | وله(@)(@@) ~~167 گر کارجهان جمله شود زیر و زبر در خدمت تو، شبی هم آریم به سر(@)(@@) (@@) کنجی زمن و تو و، زعالم که دگر؟ %~% شمعی، سر او زشام و پایش زسحر!(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~138 گر گرد تو گردم به شب، ای نوشین ل یا روزرخ تو جویم ای جان، چه عجب(@)(@@) (@@) ذره، رخ آفتاب جوید همه روز %~% پروانه، به گرد شمع گردد همه شب(@)(@@)(@@)(@@) | عزیزالدین شفروه(@)(@@) ~~169 شمعی، که چو پروانه برو شاید سوخت ما را، نه چنانکه در گمان آید سوخت(@)(@@) (@@) ازین سوز، اگرم آب نبودی در چشم %~% با شمع بگفتمی، که چون باید سوخت!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 170 دوش، ازغم هجرت، ای بت عهدشکن %~% چون دوست، همی گریست بر من دشمن(@)(@@) (@@) از بس که من از عشق تومی نالیدم %~% تا روز، همی سوخت دل شمع به من PageV01P130(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0134.jpg)(@)(@)(@@)(@@)(@@) | هستی(@)(@@) ~~17 ای رنج و غم تو برده و خوردهآ دل اندیشهآ تو، به ناز پروردهآ دل(@)(@@) ~~اد لب تو، نقش نهانخانهآ جاننور رخ تو، شمع سراپردهآ دل(@)(@@)(@@)(@@) | ظهیر فاریابی(@)(@@) (@@) 171 ای شمع، تو صوفی صفتی پنداری %~% کاین شش صفت از اهل صفا می داری:(@)(@@) (@@) شبخیزی و، 
ms18	 نور چهره و، زردی روی %~% سوز دل و، اشک دیده و، بیداری(@)(@@) جمال الدین عبدالرزاق(@)(@@) (@@) 17 ای گشته خجل زان رخ گلگون گل و شمع %~% وز رشک تو، درسرشک ودر خون گل و شمع(@)(@@) (@@) من، در طلب آن رخ چون شمع و چو گل %~% اله %~% کرده خوی سرد و گرم، همچون گل و شمع(@)(@@) (@@) 17 چاکر، غم عشقت به جهانی بخرد %~% بفروشد صد سود و، زیانی بخرد(@)(@@) (@@) در عشق تو، نیست کمتر از پروانه %~% کز شمع، یکی بوسه به جانی بخرد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 17 عاشق، باید که دل زجان برگیرد %~% وآنکگاه، بی وصال دلبر گیرد(@)(@@) (@@) روانه، نخست جان نهد بر کف دست %~% پس قصد کند، که شمع در بر گیرد!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~176 در هجر تو گر نمردم، ای مشکین خال درپای غمت کشته شوم، روز وصال(@)(@@) (@@) زیرا که چوآفتاب رخ بنماید %~% گر شمع نمیرد، بکشندش در حال!(@)(@@)(@@)(@@) | وله(@)(@@) ~~177 دل را گفتم: غم منت کم داردبر دیده ببخشای که خون نم دارد(@)(@@) (@@) دل گفت: چو شمع تن فرا آتش داد %~% از سوزش پروانه کجا غم دارد!(@)(@)PageV01P131(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0135.jpg)(@)(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 178 چون دید فسرده بر رخم ده تو اشک %~% کرد از رخ من به آستین یکسو اشک(@)(@@) ~~شمعم، که مرا به ریشخند آن دلبند 179 چون چنگ تو، تا رگیم درتن باشد(@)(@@) %~% ولا %~% سر می برد و، می سترد از رو اشک! %~% در گوش زمانه نالهآ من باشد(@)(@@) (@@) در ماتم و سور و هر کجا خواهی گیر %~% راه من و شمع بر گرستن باشد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 180 شمعم، که چوباد هوسم بر سر زد %~% بر تارک من، افسر خاکستر زد(@)(@@) (@@) آب از چشمم، دست به دامن در زد %~% و آتش ز دلم، سر به گریبان بر زد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 181 در سنبل او، شکست و تاب است به هم %~% در نرگس او، خمار و خواب است به هم(@)(@@) (@@) از چرب زبانی که فتادهست چو شمع %~% اندر دهنش، آتش و آب است به هم 
ms19	(@)(@@)(@@)(@@) | ه(@)(@@) (@@) 182 آن شب، که زتو برآتش غم سوزم %~% خشک وتر خود چوشمع، با هم سوزم(@)(@@) (@@) پنهان سوزم به گوشه ای در، چو سپند %~% وله %~% چون شمع، میان مردمان کم سوزم(@)(@@) ~~183 در پای تو، دل گرچه زبون افتادهست در جستن وصل بین، که چون افتادهست(@)(@@) (@@) شمعم، که مرا آب زسر بگذشته ست %~% وز تشنگیم، زبان برون افتادهست(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 184 شمعم، که سرم آفت تن می آید %~% وز پیرهنم بوی کفن می آید(@)(@@) (@@) از اشک، هرآنچه گرد من می آید %~% بر من، همه هم زخویشتن می آید PageV01P132(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0136.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~185 آن شمع دراز قد، که جز سرنکشد بیش ازیک شب، عمر وی اندر نکشد(@)(@@) (@@) ده تو دارد جامه و، از سر سبکی %~% اوله %~% می جوشد مغزش و، یکی بر نکشد!(@)(@@) (@@) 18 عاشق، که به یاد روی دلبر میرد %~% هر دم زدنی، به ذوق دیگر میرد(@)(@@) (@@) شمعی همه شب در آن هوس زنده کند %~% وله %~% تا، صبحدمی پیش رخ خور میرد!(@)(@@) ~~187 آنها، که مرا به عشوه مغرور کنند با روی توام، حکایت از حور کنند(@)(@@) (@@) لینند تنی چو ریسمان اندرتاب %~% چون شمع، اگرم جامه زتن دور کنند(@)(@@)(@@)(@@) | وله(@)(@@) ~~187 بس اشک، که از دیده به حاصل آرم از آب دو چشم، پای در گل دارم(@)(@@) (@@) در چشم نماند آب و، ترسم زین پس %~% چون شمع زدیده آتش دل بارم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 180 شمعم، که چوغم به قصد من برخیزد %~% صد خصم، مرا زخویشتن برخیزد(@)(@@) (@@) دل، خنده زنان برآورد جان زگلو %~% جان، رقص کنان از سر تن برخیزد!(@)(@@) (@@) 19 شمعم، که اگرچه زآتشم رنج تن است %~% اوله %~% هجران ویم، بتر زگردن زدن است(@)(@@) (@@) گر باز گرفته ام به جان آتش را %~% اوله %~% زان است، که روشنایی چشم من است(@)(@@) ~~19 از بس که تنم زآتش دل بگداختنتوان تنم از شمع همی بازشناخت(@)(@@) (@@) زین بیش مرا مسوز جانا، که چو شمع %~% هر شب، تنی ازموم نمی شاید ساخت!(@)(@)PageV01P133(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0137.jpg)(@)(@)(@@)(@@)(@@) | باب سوم 
ms20	 - شمع وشاهد(@)(@@)(@@)(@@) | وله(@)(@@) ~~192 آن را که به دست زلف دلکش بایدهمچون بادش، زآب مفرش باید(@)(@@) ~~وان دل، که ره هوای جانان سپرد پایش چو سر شمع زآتش باید(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 193 در خدمت تو، گرتن من برپای است %~% آن هم نه به زور خویشتن برپای است(@)(@@) (@@) شمعی که میان انجمن برپای است %~% ازضعف، تنش به پیرهن برپای است(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 194 شمعم، که شده ست جان من دشمن من %~% صد تو غم دل گرفته پیرامن من(@)(@@) (@@) بریاد لب تو، وقت جان دادن من %~% جان، خنده زنان برون شود ازتن من(@)(@@) (@@) 195 عشاق، نه ازغم جوانی گریند %~% وله %~% یا ازپی مال و سوزیانی گریند(@)(@@) (@@) چون چنگ، همه زتندرستی نالند %~% چون شمع، همه ز زندگانی گریند(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 196 روز آمد و، بر دوختم از دم لب را %~% پرداخته کردم از روان قالب را(@)(@@) (@@) اکنون، که مرا زنده همی دارد شب %~% شاید که چو شمع زنده دارم شب را(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 197 ماییم نگین خاتم جان، ماییم %~% ماییم که بیگار خرد فرماییم(@)(@@) (@@) در آتش غم، چو شمع از آن فرساییم %~% کزجسم بکاهیم و، به جان افزاییم(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 198 بر رشتهآ کار تو فتادیم چوشمع %~% تن، درتف و سوز عشق دادیم چو شمع(@)(@@) (@@) در کارغمت، پشت به کس ننماییم %~% چون پای درین میان نهادیم چو شمع PageV01P134(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0138.jpg)(@)(@)(@@) (@@) 19 ما، سر چو صراحی همه گردن شده ایم %~% اوله %~% بی گفت، همه زبان چوسوسن شده ایم(@)(@@) (@@) چون باده، به جوش آمدهایم از خامی %~% چون شمع، زسرکشی فروتن شده ایم(@)(@@)(@@)(@@) | جلال الدین خواری(@)(@@) (@@) 20 شمعم، که اگر چه تخت و افسر گیرم %~% در راه هوای دل، کم سر گیرم(@)(@@) (@@) در عشق، سیاستی که بر خود رانم %~% اول که قدم نهم، زسر در گیرم(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 2 خون می خورم، از دلی که قوتش غم توست %~% وز مهرتو، دشمن من و محرم توست(@)(@@) (@@) 1راز غم عشقت، دل وجان می سوزد جون شمع به زندگی همی سوزم، لیک %~%(@)(@@) وله %~% رازی 