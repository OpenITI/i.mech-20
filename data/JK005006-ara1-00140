ms123	 ) ( ! ) بين المغرب والعشاء .(@)(@@) تفرد به حماد بن زاذان ( 6 ) عن معتمر عنه . PageV02P104(@)(@@) 873 - حديث : من قاد أعمى ( 1 ) . . . الحديث .(@)(@@) لم يروه عن التيمي عن أنس غير يوسف بن عطية ومعلى بن هلال .(@)(@@) 874 - حديث : قال رسول الله إذا ابتليت عبدي ( 2 ) . . . الحديث .(@)(@@) تفرد به معلى عنه .(@)(@@) 875 - حديث : أن النبي كان يقرأ في الفجر ( 3 ) . . . . الحديث .(@)(@@) تفرد به أبو يوسف يعقوب بن إبراهيم القاضي عن التيمي .(@)(@@) 876 - حديث : أن النبي قال : لا يؤمن أحدكم ( 4 ) . . . . الحديث . PageV02P105(@)(@@) تفرد به محمد بن مطهر المصيصي عن يزيد بن هارون عنه .(@)(@@) 877 - حديث : إن الله جعل في كل جمعة ( 1 ) . . . . . الحديث .(@)(@@) تفرد به أزور بن غالب عن التيمي .(@)(@@) 878 - حديث : ( . . . . . . . . . ) ( 2 ) .(@)(@@) تفرد أسود بن عامر ( 3 ) عن أبي بكر بن عياش عن التيمي .(@)(@@) 879 - حديث : إنا نودي بالصلاة ( 4 ) . . . . الحديث . PageV02P106(@)(@@) هكذا رواه أبو زياد سهل بن زياد وتابعه عمران النعمان .(@)(@@) وتفرد به عنه أبو معاذ عبد الرحمن بن عمرو بن جبلة ( 1 ) الباهلي ورواه ابن المبارك عن منصور بن أبي الأسود ( 2 ) عن التيمي عن قتادة .(@)(@@) 880 - حديث : سافرنا مع النبي فيصوم منا الصائم ( 3 ) . . . . . الحديث .(@)(@@) تفرد به أبو زياد سهل بن زياد وتابعه عمرو عنه .(@)(@@) 881 - حديث : جعلت لي الأرض مسجدا ( 4 ) . . . . الحديث .(@)(@@) تفرد به أبو قلابة عبد الملك بن محمد الرقاشي عن قريش بن أنس / عن أبيه وما كتبناه إلا عن شيخنا أبي بكر محمد بن السري التمار ( المسي مع ) ( ) من كتابه .(@)(@@) 882 - حديث : أسألك من مناقب الحيز ( 5 ) . . . . . الحديث . PageV02P107(@)(@@) تفرد به أبو زياد سهل بن زياد عن التيمي .(@)(@@) 883 - حديث : وضأت رسول الله قبل موته بشهر . . . . . . الحديث .(@)(@@) تفرد به أبو زياد سهل بن زياد عن علي بن الفضيل ( 1 ) من أهل بلطية عن التيمي .(@)(@@) 884 - حديث : يا أنس أسبغ الوضوء ( 2 ) . . . . الحديث .(@)(@@) تفرد به الأزور بن غالب عنه .(@)(@@) 885 - حديث : أن رسول الله سئل عن الصائم يقبل ( 3 ) . . . . الحديث .(@)(@@) تفرد به غسان بن الربيع ( 4 ) عن ثابت عن التيمي . PageV02P108(@)(@@) 886 - حديث 
ms124	 : أن رجلا من ثقيف ورجلا من الأنصار . . . . . الحديث .(@)(@@) تفرد به موسى بن نصر بن دينار الرازي ( 1 ) عن جرير ولم نكتبه إلا عن أحمد بن علي بن عيسى الرازي عنه .(@)(@@) 887 - حديث : تسحروا ( 2 ) . . . . . الحديث .(@)(@@) تفرد به يحيى بن كثير أبو النضر البصري عنه .(@)(@@) 888 - حديث : إن ملكا موكل بالقرآن ( 3 ) . . . . الحديث .(@)(@@) تفرد به معلى بن هلال عنه .(@)(@@) 889 - حديث : بادر النبي هرة يمنعها ( 4 ) . . . . . . الحديث .(@)(@@) تفرد به مندل بن علي ( 5 ) عنه والمحفوظ عن أبي مجلز مرسل . PageV02P109(@)(@@) 890 - حديث : إلا إن الدنيا خضرة حلوة ( 1 ) . . . . الحديث .(@)(@@) تفرد به سعيد بن المغيرة عن عبد الله بن المبارك عنه .(@)(@@) 891 - حديث : إن رسول الله سئل عن الصائم يقبل ( 2 ) . . . . الحديث غريب من حديث التيمي عنه .(@)(@@) تفرد به ثابت بن يزيد أبو زيد ولم يروه عنه غير غسان بن الربيع .(@)(@@) 892 - حديث : إذا نودي بالصلاة فتحت أبواب السماء ( 3 ) . . . الحديث .(@)(@@) غريب من حديث التيمي عنه وتفرد به سهل بن زياد عنه .(@)(@@) 893 - حديث : قيل للنبي لو أتيت عبد الله بن أبي تعوده ( 4 ) . . . . الحديث تفرد به معتمر عن أبيه وهو صحيح أخرجه البخاري ومسلم ( 5 ) من حديثه عن أبيه . PageV02P110(@)(@@) 894 - حديث : كان أحدنا إذا رفع نبي الله ( كاته ) ( ) . . . . . الحديث تفرد به المعتمر ( 1 ) عن أبيه .(@)(@@) سليمان الأعمش ( 2 ) عن أنس(@)(@@) 895 - حديث : أن امرأة اعترفت بالزنا ( 3 ) . . . الحديث تفرد به أبو إسماعيل المؤدب إبراهيم بن سليمان ( 4 ) عنه .(@)(@@) 896 - حديث : كان النبي إذا رأى الريح ( 5 ) . . . . . الحديث .(@)(@@) تفرد به محمد بن فضيل ( 6 ) عن الأعمش . PageV02P111 897 - / حديث : ( ( كان النبي يستاك بفضل وضوءه . . ) ) الحديث .(@)(@@) تفرد به يوسف بن خالد السمتي ( 1 ) عنه وخالفه سعد بن الصلت ( 2 ) فرواه عن الأعمش عن مسلم الأعور ( 3 ) عن أنس . PageV02P112(@)(@@) وتفرد به سعد عنه أيضا .(@)(@@) 898 - حديث : ( ( إذا غربت الشمس أفطر الصائم ) ) .(@)(@@) تفرد به كلثوم بن مزيد ( 1 ) عنه .(@)(@@) 899 - حديث : ( ( من جاءته هدية وعنده قوم . . ) ) الحديث .(@)(@@) تفرد به عنبسة بن سعيد ( 2 ) عنه .(@)(@@) 900 - حديث : ( ( كان 
ms125	 النبي في مسير فمر على شجرة . . ) ) الحديث .(@)(@@) تفرد به الفضل بن موسى ( 3 ) عنه .(@)(@@) 901 - حديث : ( ( أتى رسول الله قوما فإذا امرأة تنتخ ( 4 ) بردة لها . . ) ) الحديث .(@)(@@) تفرد به الفضل بن موسى ( 5 ) عنه .(@)(@@) 902 - حديث : ( ( أن النبي لما تزوج أم سلمة أمر بنطع . . ) ) الحديث .(@)(@@) غريب من حديث الأعمش عنه ، تفرد به بكر بن خنيس ( 6 ) عنه ولم يروه عنه PageV02P113 غير يحيى بن سعيد الحمصي ( 1 ) .(@)(@@) 903 - حديث : ( ( ما كنا نحني ظهورنا . . ) ) الحديث .(@)(@@) تفرد به غنام بن علي عن الأعمش .(@)(@@) سماك بن حرب عن أنس(@)(@@) 904 - حديث : ( ( يعطي الشهيد ثلاثا . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به حماد بن سلمة ( 3 ) عنه ، وتفرد به عنه أبو عمر الضرير ( 4 ) .(@)(@@) 905 - حديث : ( ( كان علي بن أبي طالب مريضا فدخلت عليه . . ) ) الحديث .(@)(@@) غريب من حديث سماك عن أنس ، تفرد به ناصح أبو عبدة الله ( 5 ) ، ولم يروه عنه غير إسماعيل بن أبان . PageV02P114(@)(@@) سعيد بن الحبحاب عن أنس(@)(@@) 906 - حديث : ( ( لقد اكثرت عليكم من السواك ) ) ( 1 ) .(@)(@@) تفرد به الحسين بن منصور الرقي ( 2 ) عن أبي حذيفة عن الثوري عن يونس بن عبيد عنه .(@)(@@) 907 - حديث : ( ( أكمل الناس إيمانا أحسنهم خلقا . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به أبو مالك الطائي يحيى بن زكريا عن سعيد .(@)(@@) شرحبيل بن سعد ( 4 ) أبو سعد عن أنس(@)(@@) 908 - حديث : ( ( رأيت الذين أخذوا لقاح رسول الله . . ) ) الحديث . PageV02P115(@)(@@) غريب من حديثه عن أنس ، تفرد به محمد بن عبد الرحمن عن الحكم بن عتيبة ، ولم يروه عنه غير محمد بن إسماعيل بن أبي فديك ( 1 ) .(@)(@@) شبيب بن كثير عن أنس(@)(@@) 909 - حديث : ( ( أتى النبي رجل يستحمله . . ) ) الحديث .(@)(@@) وفيه / ( ( الدال على الخير كفاعله . . ) ) الحديث .(@)(@@) تفرد به أحمد بن بشير عن شبيب .(@)(@@) صفوان بن سليم ( 2 ) عن أنس(@)(@@) 910 - حديث : ( ( إن أفضل يوم يكون فيه الحجامة . . ) ) الحديث .(@)(@@) تفرد به يزيد بن عياض عن صفوان ( 3 ) .(@)(@@) 911 - حديث : ( ( إن العبد ليمرض . . ) ) الحديث ( 4 ) .(@)(@@) تفرد به عمرو بن الحصين عن سالم بن نوح ( 5 ) عن عمر بن المنهال عن صفوان 
ms126	 . PageV02P116(@)(@@) صالح بن محمد بن زائدة الليثي ( 1 ) عن أنس(@)(@@) 912 - حديث : ( ( موضع سوط في الجنة . . ) ) الحديث ( 2 ) .(@)(@@) غريب من حديث أبي واقد الليثي صالح بن محمد عن أنس ، تفرد به عبد الله بن الحارث الجمحي .(@)(@@) طلحة بن نافع ( 3 ) عن أنس(@)(@@) 913 - حديث : ( ( إن رجلا من الأشعريين كان يخدم النبي ) ) .(@)(@@) غريب من حديث طلحة عنه ، تفرد به عتبة بن أبي حكيم ( 4 ) عنه .(@)(@@) عبد الله بن الفضل ( 5 ) عن أنس(@)(@@) 914 - حديث : ( ( حزنت على من أصيب بالحرة من قومي . . ) ) الحديث . PageV02P117(@)(@@) غريب من حديث عبد الله عنه ، تفرد به موسى بن عقبة ( 1 ) عنه .(@)(@@) عبد الله بن محمد بن عقيل ( 2 ) عن أنس(@)(@@) 915 - حديث : قدم أنس المدينة وفيه ذكر عمر بن عبد العزيز ، غريب من حديث عبد الله عنه .(@)(@@) تفرد به جعفر بن برقان ( 3 ) عنه .(@)(@@) عبد الله بن عبد الله بن جبر ( 4 ) عن أنس(@)(@@) 916 - حديث : ( ( سألت أنس عن الوضوء . . ) ) الحديث ( 5 ) . PageV02P118(@)(@@) غريب من حديث عقبة بن أبي حكيم ( 1 ) عنه ، تفرد به بقية بن الوليد ( 2 ) عنه .(@)(@@) عبد الله بن أبي طلحة ( 3 ) عن أنس(@)(@@) 917 - حديث : ( ( إن بين الساعة سنين . . ) ) الحديث ( 4 ) .(@)(@@) غريب من حديث أبي طوالة عبد الرحمن عن عبد الله عنه ، تفرد به ابن لهيعة ( 5 ) .(@)(@@) 918 - حديث : ( ( ثلاث فيهن المقت . . ) ) الحديث ( 6 ) .(@)(@@) تفرد به محمد بن عمارة الجزمي ( 7 ) عن عبد الله عن عمه أنس . PageV02P119(@)(@@) عبد الله بن أبي بكر ( 1 ) عن أنس(@)(@@) 919 - حديث : ( ( ينفع الميت ثلاث ) ) ( 2 ) .(@)(@@) تفرد به سفيان بن عيينة عن عبد الله بن أبي بكر بن حزم ( 3 ) ، روي عن مالك ولا يصح عنه وهو صحيح عن ابن عيينة .(@)(@@) عبيد الله بن أبي بكر بن أنس ( 4 ) عن أنس(@)(@@) 920 - حديث : ( ( أنه رأى النبي معتما بعمامة سوداء ) ) ( 5 ) PageV02P120(@)(@@) تفرد به عنبسة بن سالم ( 1 ) عن عبيد الله .(@)(@@) 921 - / حديث : ( ( كان النبي يكره أن ينتعل الرجل وهو قائم ) ) ( 2 ) .(@)(@@) تفرد به عنبسة عنه .(@)(@@) 922 - حديث : ( ( إن قوما قدموا المدينة 
ms127	 فاجتووها . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به علي بن عاصم ( 4 ) عن عبيد الله .(@)(@@) 923 - حديث : ( ( من عاد جاريتين . . ) ) الحديث ( 5 ) .(@)(@@) تفرد به عبد الله بن المبارك عن روح شيخ له عن عبيد الله عن جده .(@)(@@) 924 - حديث : ( ( فقال : اخرجوا من النار . . ) ) الحديث ( 6 ) . PageV02P121(@)(@@) تفرد به مبارك بن فضالة ( 1 ) عن عبيد الله .(@)(@@) 925 - حديث : ( ( خرج رسول الله لحاجة وخرجت خلفه . . ) ) الحديث .(@)(@@) تفرد به معاذ بن عبيد الله بن أبي بكر عن أبيه ولم يروه عنه غير حاتم بن وردان ( 2 ) ، تفرد به محمد بن عبد الله بن النضر بن أنس عنه .(@)(@@) عبد الرحمن بن أبي ليلى ( 3 ) عن أنس(@)(@@) 926 - حديث : ( ( أمر أبو طلحة أم سليم قال : اصنعي طعاما . . ) ) الحديث .(@)(@@) غريب عن عبد الكريم بن مالك الجزري ( 4 ) عن ابن أبي ليلى ، تفرد به جندل بن والق ( 5 ) عن عبيد الله بن عمرو وغيره يرويه عن عبد الملك بن PageV02P122 عمير ( 1 ) وهو الصواب .(@)(@@) عبد العزيز بن عبد الرحمن الشيباني ( 2 ) عن أنس(@)(@@) 927 - حديث : ( ( إن رهطا من عكل . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به أيضا ابن الجارود ( 4 ) عن عبد العزيز وكان شيخا كبيرا .(@)(@@) عبد العزيز بن رفيع ( 5 ) عن أنس(@)(@@) 928 - حديث : ( ( تسحروا . . ) ) الحديث ( 6 ) .(@)(@@) غريب من حديث عبد العزيز بن رفيع عنه ، تفرد به طاهر بن خالد بن نزار ( 7 ) PageV02P123 عن أبيه عن إبراهيم بن طهمان عنه .(@)(@@) عبد العزيز بن صهيب ( 1 ) عن أنس(@)(@@) 929 - حديث : ( ( خدمت النبي اثنتي عشرة سنة . . ) ) الحديث ( 2 ) .(@)(@@) غريب من حديث ابن جريج ( 3 ) عن ابن علية ( 4 ) عنه وعن ابن علية عن معمر عن عبد العزيز .(@)(@@) تفرد به هشام بن سليم المخزومي عنه .(@)(@@) 930 - حديث : ( ( كنا نأتي إلى أنس فيقول اخلعوا نعالكم . . ) ) الحديث .(@)(@@) تفرد به سلام بن أبي الصهباء ( 5 ) عنه .(@)(@@) 931 - حديث : ( ( تسحروا . . ) ) الحديث ( 6 ) .(@)(@@) تفرد به أبو حمزة السكري عن رقبة ( 7 ) عن سلم ( 8 ) بن بشار عنه .(@)(@@) 932 - حديث : ( ( أن النبي نهى عن التزعفر ) ) ( 9 ) . PageV02P124(@)(@@) تفرد به عبد الله بن عاصم ( 1 
ms128	 ) عن حماد بن زيد عن عبد العزيز وثابت وشعيب عن أنس .(@)(@@) قال المقدسي : رواه مسدد وإسحاق بن راهوية ( 2 ) عن حماد بن زيد عن عبد / العزيز وإسماعيل ابن علية ( 3 ) وهو المحفوظ .(@)(@@) علي بن زيد بن جدعان ( 4 ) عن أنس(@)(@@) 933 - حديث : ( ( يا بني سلمة ألا تذكرون إتيانكم إلى المسجد . . ) ) الحديث . PageV02P125(@)(@@) قال ابن صاعد : هكذا وقع إلى عبد الجبار بن العلاء ( 1 ) يعني عن سفيان وغيره يرويه عن علي عن سعيد بن المسيب ( 2 ) عن النبي مرسلا .(@)(@@) 934 - حديث : ( ( ما آمن من بات شبعانا . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به حسين بن علي عن سفيان بن عيينة عنه .(@)(@@) 935 - حديث : أنزل في ابن أم مكتوم ( ^ غير أولي الضرر ) ( 4 ) .(@)(@@) تفرد به أبو نعيم الفضل بن دكين ( 5 ) عن ابن عيينة عنه . PageV02P126(@)(@@) 936 - حديث : ( ( يحشر الناس يوم القيامة ثمانية أصناف . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به سلام بن المنذر ( 2 ) عن ابن جدعان ( 3 ) .(@)(@@) 937 - حديث : ( ( أهدى الأكيدر إلى رسول الله خبزة من من . . ) ) الحديث ( 4 ) .(@)(@@) تفرد به سفيان بن حسين عنه .(@)(@@) عامر الشعبي ( 5 ) عن أنس(@)(@@) 938 - حديث : ( ( الحسد يأكل الحسنات . . ) ) الحديث ( 6 ) PageV02P127(@)(@@) تفرد به يعقوب بن محمد الزهري ( 1 ) عن محمد بن إسماعيل بن أبي فديك ( 2 ) عن عيسى الحناط ( 3 ) عن أبي الزناد عن الشعبي أدخل الشعبي من أبي الزناد وأنس ، ورواه يحيى والمغيرة وأبو سلمة المخزومي ( 4 ) عن ابن أبي فديك فلم يذكروا الشعبي في الإسناد .(@)(@@) 939 - حديث : ( ( كنت مع رسول الله فقال : من ( ( كلو ) ) ( 5 ) ما فعلت أنا . . ) ) الحديث .(@)(@@) غريب من حديث الشعبي عن أنس ، تفرد به عتبة بن عمرو عنه ، وتفرد به محمد بن الحسن الأسدي ( 6 ) عن عتبة بن عمرو . PageV02P128(@)(@@) 940 - حديث : ( ( من اقتراب الساعة أن يرى الهلال . . ) ) ( 1 ) الحديث .(@)(@@) غريب من حديث الشعبي عنه ، تفرد به العباس بن ذريح ( 2 ) عنه ، وتفرد به شريك عن العباس .(@)(@@) وتفرد به عبد الكريم بن أبي المخارق وابن عمران عن شريك .(@)(@@) 941 - حديث : ( ( أهدي لرسول الله لحم حبارى . . ) ) الحديث ( 3 ) .(@)(@@) تفرد 
ms129	 به الوليد بن عبد الملك أبو وهب ( 4 ) عن زميل بن المثنى ( 5 ) عن مخلد بن يزيد ( 6 ) عن فطر بن خليفة ( 7 ) عن الشعبي . PageV02P129(@)(@@) 942 - حديث : ( ( هلك رجل من الأنصار أو امرأة . . ) ) الحديث ( 1 ) .(@)(@@) غريب من حديث الشعبي عن أنس ، تفرد به جابر بن يزيد الجعفي ( 2 ) ، ولم يروه عنه غير الصباح بن صبيح ( 3 ) ، تفرد به عنه ابنه محمد بن الصباح الفزاري .(@)(@@) 943 - حديث : ( ( نعم الإدام الخل ) ) ( 4 ) .(@)(@@) وعن الشعبي عنه :(@)(@@) 944 - حديث : لا تغسلوا صبيانكم بالماء الذي يسخن / بالشمس وبه ( ( خير ثيابكم البياض ) ) ( 5 ) .(@)(@@) تفرد بالثلاثة زكريا بن حكيم ( 6 ) ، ولم يروها عنه غير أبي اليسع أيوب بن سليمان . PageV02P130(@)(@@) عاصم الأحول ( 1 ) عن أنس(@)(@@) 945 - حديث : قال لي النبي يا ذا الأذنين ( 2 ) .(@)(@@) تفرد به شيخنا أبو بكر محمد بن الحسين الهمداني ( 3 ) بالبصرة وإنما يعرف هذا من حديث موسى بن حبان عن حفص بن عمر ( 4 ) عن شعبة(@)(@@) 946 - حديث : ( ( من نسي أن يقول في أول طعامه بسم الله . . ) ) الحديث ( 5 ) .(@)(@@) غريب من حديث عاصم عنه ، تفرد به الحسن بن صالح بن حي ( 6 ) عنه ، وتفرد به إسماعيل بن يحيى عن الحسن ( 7 ) . PageV02P131(@)(@@) 947 - حديث : ( ( كان رسول الله يتنفس في الإناء ثلاثا ) ) ( 1 ) .(@)(@@) تفرد به يحيى بن إسحاق عن عبد الوارث عن عاصم عن أنس ، قال الدارقطني : قال لنا شيخنا أبو بكر بن حامد وقرأنا في أثره حديث أبي عاصم عن أنس الذي عند الناس .(@)(@@) 948 - حديث : ( ( كانوا يكرهون أن يصلوا على الجنائز بين القبور ) ) .(@)(@@) 949 - حديث : ( ( إن النبي صلى في ثوب واحد ) ) .(@)(@@) تفرد بهما الأجلح عن عاصم عن أنس .(@)(@@) عطاء بن أبي رباح عن أنس(@)(@@) 950 - حديث : ( ( المسلمون على شروطهم . . ) ) الحديث .(@)(@@) تفرد به إسماعيل بن زرارة ( 2 ) عن عبد العزيز بن عبد الرحمن القرشي ( 3 ) عن حصيف عنه . PageV02P132(@)(@@) عطاء بن عجلان ( 1 ) عن أنس(@)(@@) 951 - حديث : ( ( الطير ) ) ( 1 ) .(@)(@@) تفرد به أبو بكر الداهري ( 3 ) عن عطاء .(@)(@@) عطاء بن أبي ميمونة ( 4 ) عن أنس(@)(@@) 952 - حديث 
ms130	 : ( ( أن النبي دخل حائطا . . ) ) الحديث ( 5 ) .(@)(@@) غريب من حديث الحذاء عن عطاء ، تفرد به خالد الطحان ( 6 ) عنه . PageV02P133(@)(@@) عكرمة ( 1 ) عنه(@)(@@) 953 - حديث : ( ( أن النبي رأى رجلا يسوق بدنة . . ) ) الحديث ( 2 ) .(@)(@@) غريب من حديث عكرمة مولى ابن عباس عنه ، تفرد به أبو خالد الأحمر ( 3 ) عن ابن جريج ( 4 ) عن عبد الكريم الجزري ( 5 ) عنه .(@)(@@) عقبة بن وساج ( 6 ) عنه(@)(@@) 954 - حديث : ( ( نضر الله من سمع قولي . . ) ) الحديث ( 7 ) . PageV02P134(@)(@@) تفرد به هانئ بن عبد الرحمن ( 1 ) عن عمه إبراهيم بن أبي عيد عنه .(@)(@@) عمرو بن أبي عمرو ( 2 ) عنه(@)(@@) 955 - حديث : ( ( لست من دد ولا دد مني ) ) ( 3 ) . PageV02P135(@)(@@) غريب من حديث عمرو عنه يرويه أبو زكير يحيى بن محمد بن قيس عنه .(@)(@@) 956 - حديث : ( ( كان من دعاء النبي اللهم إني / أعوذ بك . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به جنادة بن سلم ( 2 ) عن عبد الله بن عمر عن عمرو .(@)(@@) عمرو بن عامر عنه(@)(@@) 957 - حديث : ( ( قال رجل لرسول الله يا خير البرية . . ) ) ( 3 ) الحديث .(@)(@@) تفرد به مهاجر عن عمر بن عبيد الطنافسي ( 4 ) عن مسعر عنه وخالفه ابن عيينة فرواه عن مسعر عن المختار بن فلفل ( 5 ) عن أنس وهو المحفوظ . PageV02P136(@)(@@) عيينة بن عبد الرحمن عنه(@)(@@) 958 - حديث : ( ( كان النبي يأكل كما يأكل العبيد ) ) .(@)(@@) غريب من حديث عيينة بن عبد الرحمن بن جوشن ( 1 ) عنه ، تفرد به مرجى بن رجاء ، ولم يروه عنه غير إسحاق بن منصور السلولي ( 2 ) .(@)(@@) غيلان بن جرير عن أنس(@)(@@) 959 - حديث : ( ( قال رسول الله أكمل المؤمنين إيمانا . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به بشار بن إبراهيم ( . . . . ) ( 4 ) أبو عون عن غيلان عن أنس .(@)(@@) فرقد السبخي ( 5 ) عن أنس(@)(@@) 960 - حديث : ( ( من أصبح وهمه غير الله عز وجل . . ) ) الحديث ( 6 ) . PageV02P137(@)(@@) تفرد به وهب بن راشد عن فرقد .(@)(@@) قيس بن أبي وهب عن أنس(@)(@@) 961 - حديث : ( ( أن النبي قال لاتتم مائة سنة من الهجرة وفيكم غير مطرف ) ) .(@)(@@) تفرد به أبو وكيع الجراح بن مليح ( 1 ) عن قيس عن أنس .(@)(@@) قتادة عن 
ms131	 أنس ( 2 ) الرواة عنه على الترتيب جرير بن حازم عنه(@)(@@) 962 - حديث : ( ( عق رسول الله عن حسن وحسين . . ) ) الحديث ( 3 ) . PageV02P138(@)(@@) تفرد به عبد الله بن وهب عن جرير عنه .(@)(@@) 963 - حديث : ( ( أن رجلا جاء إلى النبي وقد ترك موضع ظهر . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به جرير بن حازم ( 2 ) عنه ، فلم يروه عنه غير ابن وهب .(@)(@@) حميد الطويل ( 3 ) عنه(@)(@@) 964 - حديث : ( ( أن النبي أعتق صفية . . ) ) الحديث ( 4 ) .(@)(@@) غريب من حديث حميد عنه تفرد به الساباطي أحمد بن عبيد الله بن PageV02P139 المفضل ( 1 ) عن يزيد بن هارون عنه وعند يزيد هذا الحديث أيضا عن شعبة وابن أبي عروبة جميعا عن قتادة عن أنس .(@)(@@) 965 - حديث : ( ( إن رسول الله قال يوم الحديبية : دعوني أنطلق بالهدي . . ) ) الحديث ( 2 ) .(@)(@@) غريب من حديث حميد عنه ، تفرد به خلف بن سالم ( 3 ) عن ابن أبي عدي ( 4 ) / عنه ولا نعلم حدث به غير جعفر الطيالسي ( 5 ) ولم نكتبه إلا عن أبي بكر النجاد ( 6 ) . PageV02P140(@)(@@) 966 - حديث : ( ( أن نبي الله وأبا بكر وعمر وعثمان كانوا يستفتحون القراءة بالحمد لله رب العالمين ) ) ( 1 ) .(@)(@@) تفرد به ابن أبي عدي ( 2 ) عن حميد عنه ، ورواه يحيى بن معين وعمرو بن علي عن ابن أبي عدي وقال يحيى كان حميد إذا حدث به عن قتادة رفعه وإذا حدث به عن أنس لم يرفعه وكذلك قال العباس بن يزيد في حديثه .(@)(@@) 967 - حديث : ( ( سمع النبي رجلا وهو في مسير له يقول الله أكبر . . ) ) الحديث .(@)(@@) غريب من حديث حميد عن قتادة ، تفرد به عبد الأعلى الشامي عنه قال ابن صاعد : إسناد صحيح غريب ما سمعناه إلا من محمد بن يحيى بن الفياض ( 3 ) عن عبد الأعلى .(@)(@@) حسام بن مصك ( 4 ) عن قتادة(@)(@@) 968 - حديث : ( ( ما بعث الله نبيا إلا حسن الوجه ) ) .(@)(@@) تفرد به نوح بن قيس الطاحي عن حسام ولم يروه عنه غير العباس بن يزيد البحراني ( 5 ) .(@)(@@) 969 - حديث : ( ( أن النبي كان إذا صلى العيد استوى على راحلته . . ) ) الحديث ( 6 ) . PageV02P141(@)(@@) تفرد به 
ms132	 حسام عنه بهذا اللفظ وتفرد به الهيثم بن جميل ( 1 ) عنه .(@)(@@) خالد بن قيس ( 2 ) عن قتادة(@)(@@) 970 - حديث : ( ( أنت مني بمنزلة هارون من موسى ) ) .(@)(@@) غريب من حديث قتادة عن أنس .(@)(@@) تفرد به عبد الكريم بن يحيى عن نوح بن قيس عن أخيه خالد عنه ، وروي عن جرير بن يزيد بن هارون عن نوح بن قيس .(@)(@@) الخليل بن مرة ( 3 ) عن قتادة(@)(@@) 971 - حديث : ( ( من كان يؤمن بالله واليوم الآخر . . ) ) الحديث ( 4 ) . PageV02P142(@)(@@) تفرد به يحيى بن سلام ( 1 ) عن الخليل عنه .(@)(@@) خليد بن دعلج ( 2 ) عنه(@)(@@) 972 - حديث : ( ( ما طلعت الشمس . . ) ) الحديث ( 3 ) .(@)(@@) غريب من حديث قتادة عنه ، تفرد به خليد عنه ولا نعلم حدث به غير علي بن الحسين الشامي ( 4 ) وغيره ( 5 ) ، يرويه عن قتادة عن خالد بن عبد الله القصري ( 6 ) عن أبي الدرداء .(@)(@@) خلاد الصفار ( 7 ) عن قتادة(@)(@@) 973 - حديث : ( ( يحيى حديثه في ترجمة هارون عن قتادة ) ) . PageV02P143(@)(@@) سعيد بن بشير ( 1 ) عن قتادة(@)(@@) 974 - حديث : ( ( أن المرأة كالضلع . . ) ) الحديث ( 2 ) .(@)(@@) غريب من حديث قتادة عنه ، تفرد به سعيد بن بشير ( 3 ) وتفرد به الوليد بن الوليد الدمشقي عنه .(@)(@@) زيد بن الحواري ( 4 ) عن قتادة(@)(@@) 975 - حديث : / ( ( إذا نودي بالأذان إذا بالشيطان . . ) ) الحديث ( 5 ) .(@)(@@) غريب من حديث قتادة عنه ، وغريب من حديث زيد عنه ، تفرد به سلام بن سلم الطويل المدائني ( 6 ) عن زيد .(@)(@@) سعيد بن أبي عروبة عن قتادة(@)(@@) 976 - حديث : ( ( أن النبي صلى على ابنه إبراهيم فكبر عليه أربعا ) ) ( 7 ) . PageV02P144(@)(@@) غريب من حديث ابن أبي عروبة عن قتادة ، تفرد به أبو قتادة الحراني عبد الله بن واقد ( 1 ) عنه ، ولا نعمل حدث به غير أحمد بن عبد الله بن ميسرة ( 2 ) الحراني عنه .(@)(@@) 977 - حديث : ( ( هل تسمعون أطيط السماء . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به علي بن الحسين ( 4 ) عن ابن أبي عروبة .(@)(@@) 978 - حديث : ( ( اللهم اغفر للأنصار . . ) ) الحديث ( 5 ) . PageV02P145(@)(@@) تفرد به يزيد بن دريد عنه ، وتفرد به عمرو بن علي عن يزيد .(@)(@@) 979 - حديث : ( ( قلت لأنس 
ms133	 أكان النبي يمزح . . ) ) الحديث .(@)(@@) تفرد به الحسين بن إبراهيم الهين زربي عن عيسى بن يونس عنه .(@)(@@) 980 - حديث : ( ( أن النبي قطع في مجن . . ) ) الحديث ( 1 ) .(@)(@@) غريب من حديثه عن قتادة لم يسنده عنه غير سعيد بن عامر وعبيدة بن أبي الأسود ( 2 ) ، تفرد به حماد بن الحسن عن سعيد . PageV02P146(@)(@@) 981 - حديث : ( ( كان النبي أشد حياء من العذراء في خدرها . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به عمر بن سعيد الأبح عنه عن قتادة عن أنس والمحفوظ عن قتادة عن عبد الله بن عتبة عن الخدري .(@)(@@) 982 - حديث : وعدني ربي عز وجل في أهل بيتي من أقر . . الحديث ( 2 ) . PageV02P147(@)(@@) تفرد به عمر بن سعيد عنه عن قتادة .(@)(@@) 983 - حديث : ( ( افتخر الحيان الأوس والخزرج . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به عبد الوهاب بن عطاء ( 2 ) عنه عن قتادة .(@)(@@) 984 - حديث : ( ( خرجنا إلى حنين صبيحة تسعة عشر من رمضان . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به إسماعيل بن محمد بن جحادة ( 4 ) عنه عن قتادة .(@)(@@) 985 - حديث : ( ( الشفاعة لأهل الكبائر . . ) ) الحديث ( 5 ) . PageV02P148(@)(@@) تفرد به عمر بن سعيد الأبح ( 1 ) عنه عن قتادة .(@)(@@) 986 - حديث : ( ( كان النبي تعجبه الرؤيا . . ) ) الحديث ( 2 ) .(@)(@@) وفيه ذكر عائشة ، تفرد به عمر الأبح عنه .(@)(@@) سليمان التيمي عن قتادة(@)(@@) 987 - حديث : ( ( أن النبي قال لا سقف نجران أسلم تسلم . . ) ) الحديث .(@)(@@) تفرد به معتمر ( 3 ) عن أبيه ( 4 ) ، ورواه محمد بن أبي السري ( 5 ) عن معتمر عن أبيه وزاد فيه ألفاظا / حسانا وتفرد بها ابن أبي السري ( 6 ) أيضا عنه .(@)(@@) 988 - حديث : ( ( في الجنة شجرة ) ) ( 7 ) .(@)(@@) تفرد به معتمر عن أبيه . PageV02P149(@)(@@) 989 - حديث : ( ( الدعاء بين الأذان والإقامة ) ) ( 1 ) .(@)(@@) غريب من حديث القاسم عنه ، لم يروه عنه مرفوعا غير عبد الله بن المبارك ، تفرد به أسيد بن زيد ( 2 ) .(@)(@@) 990 - حديث : ( ( جاء رجل من قيس ورسول الله يخطب فأمره أن يصلي ركعتين . . ) ) الحديث ( 3 ) .(@)(@@) غريب من حديث قتادة عنه ومن حديث التيمي عنه .(@)(@@) تفرد به عبيد بن محمد العبدي ( 4 ) عن معتمر عن أبيه ورواه أحمد بن حنبل عن معتمر 
ms134	 عن أبيه مرسلا .(@)(@@) 991 - حديث : ( ( أنه أتى على رجل يسوق بدنة . . ) ) الحديث ( 5 ) .(@)(@@) تفرد به معتمر ( 6 ) عنه .(@)(@@) 992 - حديث : ( ( إذا أراد الله بعبد خيرا استعمله . . ) ) الحديث ( 7 ) .(@)(@@) تفرد به عمرو بن عثمان العبدي عن معتمر عن أبيه .(@)(@@) 993 - حديث : ( ^ إنما جزاء الذين يحاربون الله ) ( 8 ) الحديث . PageV02P150(@)(@@) تفرد به عباد بن صهيب ( 1 ) عن التيمي ، وتفرد به سفيان بن زياد عنه .(@)(@@) 994 - حديث : ( ( ليأتي المؤمنون آدم يوم القيامة . . ) ) حديث الشفاعة ( 2 ) .(@)(@@) تفرد به المعتمر عن أبيه .(@)(@@) 995 - حديث : ( ( أن رسول الله سئل حتى أصفوه بالمسألة . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به المعتمر عن أبيه .(@)(@@) 996 - حديث : ( ( قال إذا أبصرهم أهل الجنة قال هؤلاء الجهنميون ( 4 ) أو كما قال ) ) .(@)(@@) تفرد به المعتمر ( 5 ) . PageV02P151(@)(@@) 997 - حديث : ( ( إن الكافر إذا عمل حسنة . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به المعتمر .(@)(@@) 998 - حديث : ( ( بين عينيه يعني الدجال كافر . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به المعتمر .(@)(@@) 999 - حديث : ( ( لو كان لابن آدم واديان . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به المعتمر .(@)(@@) 1000 - حديث : ( ( إني لأتوب في اليوم سبعين مرة . . ) ) الحديث ( 4 ) .(@)(@@) تفرد به معتمر . PageV02P152(@)(@@) 1001 - حديث : ( ( لما رجعنا من غزوة الحديبية . . ) ) الحديث .(@)(@@) تفرد به معتمر .(@)(@@) 1002 - حديث : ( ( لما عرج بنبي الله إلى الجنة عرض لها نهر . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به المعتمر عن أبيه عن قتادة .(@)(@@) سلام بن أبي مطيع ( 2 ) عن قتادة(@)(@@) 1003 - حديث : ( ( أن النبي أعطي قوة ثلاثين رجلا في المباضعة ) ) ( 3 ) .(@)(@@) تفرد به سلام عنه ولم يروه عنه غير عبد الرحمن بن عمرو بن جبلة ( 4 ) .(@)(@@) سليم بن حبان ( 5 ) عنه(@)(@@) 1004 - حديث : ( ( أن رسول الله أعتق صفية . . ) ) الحديث ( 6 ) . PageV02P153(@)(@@) تفرد / به شيخنا محمد بن الحسين بن محمد بن حاتم ( 1 ) عن أبي الأحوص محمد بن الهيثم القاضي عن عبد الله بن رجاء عنه .(@)(@@) 1005 - حديث : ( ( إن في الجنة شجرة . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به عبد الرحمن بن مهدي عنه .(@)(@@) 1006 - حديث : ( ( اعتدلوا في السجود . . ) ) ( 3 ) .(@)(@@) 1007 - حديث : ( ( لا يبزق أحدكم . . ) ) ( 4 ) .(@)(@@) 1008 - حديث : ( ( كان رسول الله من أخف الناس صلاة في تمام ) ) . PageV02P154(@)(@@) تفرد 
ms135	 بهذه الثلاثة محمد بن سنان العوفي ( 1 ) عنه .(@)(@@) السري بن يحيى ( 2 ) عنه(@)(@@) 1009 - حديث : ( ( أخرج إلينا أنس شعر النبي . . ) ) الحديث .(@)(@@) تفرد به محمد بن يوسف الفريابي ( 3 ) عن السري عنه .(@)(@@) شعبة عنه(@)(@@) 1010 - حديث : ( ( إني لأدخل في الصلاة وأنا أريد إطالتها . . ) ) الحديث ( 4 ) . PageV02P155(@)(@@) تفرد به يوسف بن موسى ( 1 ) عن أبي أسامة حماد بن أسامة ( 2 ) عنه .(@)(@@) 1011 - حديث : ( ( سألت أنسا بأي شيء كان النبي يستفتح القرآن . . ) ) الحديث تفرد به حجاج بن محمد ( 3 ) عن شعبة عن قتادة ورواه أحمد بن حنبل عن حجاج بهذا الإسناد أيضا .(@)(@@) 1012 - حديث : ( ( انتهيت إلى سدرة المنتهى . . ) ) الحديث ( 4 ) . PageV02P156(@)(@@) تفرد به إبراهيم بن طهمان ( 1 ) عن شعبة ولم يروه عنه غير جعفر .(@)(@@) شيبان ( 2 ) عنه(@)(@@) 1013 - حديث : ( ( من تعلم العلم ليباهي به العلماء . . ) ) الحديث ( 3 ) . PageV02P157(@)(@@) غريب من حديث قتادة عنه ، تفرد به شيبان عنه ولم يروه عنه غير سليمان بن زياد الثقفي ( 1 ) الواسطي .(@)(@@) شهاب بن جراش ( 2 ) عنه(@)(@@) 1014 - حديث : ( ( أتيت السماوات السبع . . ) ) الحديث .(@)(@@) تفرد به أبو طاهر موسى بن محمد بن عطاء ( 3 ) عن شهاب عنه . PageV02P158(@)(@@) الصعق بن حزن ( 1 ) عنه(@)(@@) 1015 - حديث : ( ( تشرب أمتي الخمر . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به الصعق عنه .(@)(@@) عبد الله الجراني ( 3 ) عن قتادة(@)(@@) 1016 - حديث : ( ( أن النبي عق عن نفسه . . ) ) الحديث ( 4 ) . PageV02P159(@)(@@) قال أبو قتادة هذا أفادناه شعبة عن هذا الشيخ يعني عبد الله عن قتادة وقال : ليس يروي هذا الحديث غيره ، وتفرد به فضل بن يعقوب الرخامي ( 1 ) عن شعبة عن عبد الله بن محرز هكذا قال : وكان أبا قتادة سمعه من شعبة وشعبة يرويه عن عبد الله قال المقدمي : وأظن شعبة افادة أبا قتادة من هذا / الشيخ عبد الله غير هذا الحديث ، وليس لشعبة في هذا الحديث سند والله أعلم .(@)(@@) عبد الرحمن الأوزاعي عن قتادة .(@)(@@) 1017 - حديث : ( ( في أهل البدع هم شر الخلق . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به الحافظ ابن عمران عن الأوزاعي عن قتادة عن أنس وأبي سعيد الخدري .(@)(@@) 1018 - حديث : ( ( لبيك بحجة وعمرة 
ms136	 . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به عبد الرحمن بن مطرف عن ثابت بن بشير عن الأوزاعي عنه .(@)(@@) عمر بن نبهان ( 4 ) عن قتادة(@)(@@) 1019 - حديث : ( ( رأيت رسول الله يصلي في نعليه وفي خفيه ) ) ( 5 ) . PageV02P160(@)(@@) تفرد به عمر عنه .(@)(@@) عمر بن عامر ( 1 ) عن قتادة(@)(@@) 1020 - حديث : ( ( إن النبي أمر العرنين أن يشربوا من ألبان الإبل . . ) ) الحديث ( 2 ) غريب من حديث عمر عنه ، تفرد به سالم بن نوح ( 3 ) عنه .(@)(@@) 1021 - حديث : ( ( كأني أنظر إلى وبيص خاتم رسول الله . . ) ) الحديث ( 4 ) .(@)(@@) تفرد به خالد بن يحيى أبو عبيدة السدوسي ( 5 ) عن عمر بن عامر ( 6 ) وابن أبي عروبة وخالفه عباد بن العوام ( 7 ) وخالد الواسطي عن سعيد فقالا في يمينه . PageV02P161(@)(@@) عمران القطان ( 1 ) عنه(@)(@@) 1022 - حديث : ( ( إن هذا الشهر قد حضركم . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به عمران عنه ، وتفرد به محمد بن بلال عن عمران .(@)(@@) 1023 - حديث : ( ( لما مرض رسول الله أمر أبا بكر أن يصلي بالناس . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به عمران عنه . PageV02P162(@)(@@) عمران بن خالد ( 1 ) عنه .(@)(@@) 1024 - حديث : ( ( المؤمن لين المنكب . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به داود بن معاذ عن ابن خالد عنه .(@)(@@) عدي بن أبي عمارة ( 3 ) عنه(@)(@@) 1025 - حديث : ( ( إن هذه الخشوش محتضرة . . ) ) الحديث ( 4 ) .(@)(@@) غريب من حديث قتادة عنه ، تفرد به عدي عنه . PageV02P163(@)(@@) عتبة بن أبي حكيم ( 1 ) عنه(@)(@@) 1026 - حديث : ( ( أن النبي كان يصلي بعد الوتر ركعتين . . ) ) الحديث ( 2 ) .(@)(@@) قال أبو بكر بن أبي داود ( . . . ) ( 3 ) عتبة ، تفرد بها أهل البصرة وحفظها أهل الشام ، قال الدارقطني : غريب من حديث قتادة عنه ، تفرد به عتبة عنه ، وتفرد به بقية عن عتبة .(@)(@@) عمرو بن الحارث عنه(@)(@@) 1027 - حديث : ( ( أن النبي نهى أن يخلط . . ) ) الحديث .(@)(@@) تفرد به عبد الله بن وهب عنه .(@)(@@) عقبة بن عبد الله الرفاعي ( 4 ) عنه(@)(@@) 1028 - حديث : ( ( السلطان ظل الله عز وجل في الأرض . . ) ) الحديث ( 5 ) / . PageV02P164(@)(@@) غريب من حديث قتادة عنه ، تفرد به عقبة الأصم عنه .(@)(@@) قرة بن خالد ( 1 ) عنه(@)(@@) 1029 - حديث : ( ( أن النبي اتخد خاتما . . ) ) الحديث 
ms137	 ( 2 ) .(@)(@@) تفرد به عيسى بن سعيد عن قرة .(@)(@@) مسعر بن قتادة(@)(@@) 1030 - حديث : ( ( قام النبي حتى تورمت قدماه . . ) ) الحديث ( 3 ) . PageV02P165(@)(@@) تفرد به محمد بن بشر عنه ، ولم يحدث عنه عبد الله بن عون الخراز ( 1 ) ، قال البغوي في إسناده عنه : وكان من حسان عباد الله ، وتابعه الحسن بن علي بن الأسود ( 2 ) ، ورواه سفيان بن محمد عن مسعر عن عطية عن أبي سعيد الخدري ورواه أبو قتادة الحراني عن مسعر عن علي بن الأقمر عن أبي حنيفة ، ورواه محمد بن إسحاق عن مسعر عن زياد بن علاقة عن عمر عن المغيرة نب شعبة ، وخالفه أصحاب مسعر وكيع وأبو نعيم وأحمد بن بشير وخالد بن يحيى فرووه عن مسعر عن زياد بن علاقة أنه سمع المغيرة وهو الصواب .(@)(@@) 1031 - حديث : ( ( أن النبي مر على غلمان فسلم عليهم . . ) ) الحديث ( 3 ) . PageV02P166(@)(@@) غريب من حديث مسعر عن قتادة .(@)(@@) 1032 - حديث : ( ( أن النبي وأبا بكر وعمر لم يكونوا يجهرون ببسم الله الرحمن الرحيم ) ) ( 1 ) .(@)(@@) غريب من حديث مسعر عن قتادة عن أنس .(@)(@@) تفرد به محمد بن إبراهيم الحلواني ( 2 ) فما وجده في كتاب عمه عبد الرحمن بن شيبان عن عمر وأبي الحسن عن مسعر وشعبة عن قتادة .(@)(@@) مالك بن دينار عن قتادة(@)(@@) 1033 - حديث : ( ( من غشنا . . ) ) الحديث ( 3 ) .(@)(@@) غريب من حديث مالك عنه ، تفرد به حميد بن صبيح عن أبي هارون الهمداني ( 4 ) .(@)(@@) مطر الوراق ( 5 ) عنه(@)(@@) 1034 - حديث : ( ( يخرج من النار . . ) ) الحديث ( 6 ) PageV02P167(@)(@@) تفرد به إبراهيم بن طهمان ( 1 ) عنه ، وتفرد به عنه حفص بن عبد الله .(@)(@@) 1035 - حديث : ( ( أن النبي كان يأخذ الرطب ( . . . . ) ( 2 ) الحديث .(@)(@@) تفرد به يوسف بن عطية ( 3 ) عن مطر عنه .(@)(@@) مقاتل بن سليمان عنه(@)(@@) 1036 - حديث : ( ( عليكم بالأوضاح الثلاثة . . ) ) الحديث ( 4 ) .(@)(@@) في صوم أيام البيض ، غريب من حديث قتادة عنه ، تفرد به إبراهيم بن نافع الجلاب عن مقاتل عنه .(@)(@@) 1037 - حديث : ( ( من قرأ يس . . ) ) الحديث ( 5 ) . PageV02P168(@)(@@) تفرد به سليمان بن الربيع عن ( . . . . ) ( 1 ) عن مقاتل وإنما يعرف هذا من 
ms138	 رواية الحسن بن سالم عن هارون بن أبي محمد عن مقاتل .(@)(@@) نافع بن عامر عنه(@)(@@) 1038 - حديث : ( ( يأتيني جبريل على صورة دحية . . ) ) ( 2 ) الحديث .(@)(@@) تفرد به إسماعيل بن عياش ( 3 ) عن نافع عنه .(@)(@@) هشام الدستوائي ( 4 ) عنه(@)(@@) 1039 - حديث : ( ( أن النبي صلى على قبر بعد شهرين . . ) ) الحديث .(@)(@@) غريب من حديث / قتادة عنه .(@)(@@) وغريب من حديث هشام الدستوائي عنه .(@)(@@) تفرد به سعيد بن محمد بن ثواب ( 5 ) عن وهب بن جرير عنه .(@)(@@) هشام بن حسان ( 6 ) عنه(@)(@@) 1040 - حديث : ( ( سألنا أنسا أخضب رسول الله . . ) ) الحديث ( 7 ) . PageV02P169(@)(@@) غريب من حديث هشام بن حسان عنه .(@)(@@) تفرد به منصور بن عكرمة الكلابي ( 1 ) عنه .(@)(@@) 1041 - حديث : ( ( أن أعرابيا أتى النبي فسأله متى الساعة . . ) ) الحديث .(@)(@@) غريب من حديث عبد الله بن هشام عن أبيه .(@)(@@) تفرد به عمر بن شبة ( 2 ) عنه .(@)(@@) هارون بن سعد ( 3 ) عنه(@)(@@) 1042 - حديث : ( ( كان النبي إذا دخل الخلاء . . ) ) الحديث ( 4 ) . PageV02P170(@)(@@) تفرد به أبو جنادة حصين بن مخارق ( 1 ) عن خالد الصفار وهارون بن سعد عنه .(@)(@@) همام بن يحيى ( 2 ) عنه(@)(@@) 1043 - حديث : ( ( أن النبي كان يصلي على الخمرة قلت وما الخمرة قال : حصير بالمدينة ) ) ( 3 ) .(@)(@@) غريب من حديث قتادة عنه ، تفرد به همام عنه .(@)(@@) يحيى بن صبيح عنه(@)(@@) 1044 - حديث : ( ( أن النبي يوم أحد جمع النفر في القبر الواحد ) ) ( 4 ) . PageV02P171(@)(@@) غريب من حديث يحيى عنه ، تفرد به عبد الله بن وهب عن ابن جريح عن يحيى عنه .(@)(@@) أبو جعفر ( 1 ) عنه(@)(@@) 1045 - حديث : ( ( نهى رسول الله عن النهبة . . ) ) الحديث ( 2 ) .(@)(@@) تفرد بن محمد بن عامر بن العلاء عن ( الأشنب ) ( 3 ) عن أبي جعفر عن قتادة .(@)(@@) أبو بكر الهذلي ( 4 ) عنه(@)(@@) 1046 - حديث : ( ( كنا نتحدث أن أحب الألوان إلى رسول الله ( الخضرة ) . . ) ) ( 5 ) والحديث قصة تفرد به حجاج عن ابن جريح عن أبي بكر الهذلي عنه . PageV02P172(@)(@@) حديث لقتادة عن أنس انقطع على إسناده(@)(@@) 1047 - حديث : ( ( كان النبي إذا أفطر عند قوم . . ) ) الحديث .(@)(@@) تفرد به محمد بن ماهان بن ربيعة بهذا الإسناد 
ms139	 والمحفوظ عن هشام عن يحيى بن أبي كثير عن أنس ( . . . . ) ( 1 ) يحيى في ترجمة يحيى عن أنس ، إن شاء الله .(@)(@@) كهمس عن أنس بن مالك ( 2 )(@)(@@) 1048 - حديث : عن رسول الله قال : ( ( الشرب في ثلاثة أنفاس . . ) ) الحديث .(@)(@@) تفرد به أبو جعفر محمد بن سويد الأدمي ( 3 ) عن ابن عيينة عنه وكان من الثقات العباد .(@)(@@) ليث بن أبي سليم ( 4 ) عن أنس(@)(@@) 1049 - حديث : ( ( قال رسول الله إذا اغتسلت المرأة من حيضها . . ) ) الحديث ( 5 ) . PageV02P173(@)(@@) تفرد به مسلم بن صبيح ( 1 ) أبو عثمان عن حماد بن سلمة عن / ليث عن أنس .(@)(@@) محمد بن مسلم أبو بكر الزهري عن أنس الرواة عنه على الترتيب وإن لم تفرد أجمعهن(@)(@@) 1050 - حديث : ( ( أن رجلا أطلع على النبي ( . . . . ) ( 2 ) النبي مسلم . . ) ) الحديث .(@)(@@) تفرد عمار بن مطر عن إبراهيم بن سعد عنه والمحفوظ الزهري عن سهل .(@)(@@) 1051 - حديث : ( ( إذا قرأ الإمام فأنصتوا . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به الحسن بن علي بن شيبة العمري عن أبي الأشعت عن محمد بن عبد الرحمن الطفاوي ( 4 ) عن أيوب عنه . PageV02P174(@)(@@) 1052 - حديث : ( ( صرع النبي عن فرس . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به الطفاوي عن أيوب عنه .(@)(@@) 1053 - حديث : ( ( لبيك بحجة وعمرة . . ) ) الحديث .(@)(@@) تفرد به محمد بن عبد الرحمن بن أبي ليلى عن إسماعيل بن أمية عنه ، وهو غريب من حديث إسماعيل عنه .(@)(@@) تفرد به أبو الجواب عن عمار بن ( . . . . ) ( 2 ) .(@)(@@) 1054 - حديث : ( ( ثلاث من كن فيه . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به إسماعيل بن سالم عن الزهري .(@)(@@) 1055 - حديث : ( ( لبيك بحجة وعمرة معا ) ) .(@)(@@) تفرد به أبو معاوية عن إسماعيل بن مسلم عنه .(@)(@@) 1056 - حديث : ( ( لما كان يوم أحد مر النبي بحمزة . . ) ) الحديث ( 4 ) . PageV02P175(@)(@@) تفرد به أسامة بن زيد ( 1 ) عن الزهري عن أنس بهذه الألفاظ ، ورواه عثمان بن عمر عن أسامة عن الزهري عن أنس وزاد فيه جزا لم يأت به غيره فقال : ولم نصل على أحد من الشهداء غيره يعني حمزة .(@)(@@) 1057 - حديث : ( ( إن النبي أولم على زينب بمدين من تمر وسق . . ) الحديث .(@)(@@) غريب من 
ms140	 حديث بكر بن وائل عنه يرويه أبوه وائل بن داود ولم يروه عنه غير سفيان بن عيينة .(@)(@@) 1058 - حديث : ( ( من عزى أخاه المؤمن . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به بكير بن الأشج عن الزهري ، وتفرد به قدامة بن محمد بن خشرم عن أبيه عنه . PageV02P176(@)(@@) 1059 - حديث : ( ( أنزل علي بالمدينة طردوس . . ) ) الحديث .(@)(@@) تفرد به قدامة بن محمد عن مخرمة عن أبيه .(@)(@@) 1060 - حديث : ( ( أصابت خيل النبي جلدا سرق . . ) ) الحديث .(@)(@@) تفرد به أبو المليح الحسن بن عمر الرقي ( 1 ) عنه .(@)(@@) 1061 - حديث : ( ( خرجت مع رسول الله فصلى ( . . . . ) ( 2 ) على غلام . . ) ) الحديث .(@)(@@) تفرد به أبو المليح عنه .(@)(@@) 1062 - حديث : ( ( الإيمان قيد الفتك . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به حيوة عن إسماعيل بن عياش ( 4 ) عن الحجاج بن أرطأة عنه ( 5 ) .(@)(@@) 1063 - حديث : ( ( لا تطئوا السبايا حتى تضعن . . ) ) الحديث ( 6 ) . PageV02P177(@)(@@) / غريب من حديث الزهري عنه ، تفرد به إبراهيم عن الحجاج بن أرطأة ، ولم يروه عنه غير إسماعيل بن عياش .(@)(@@) 1064 - حديث : ( ( لا يحل لمسلم أن تحد على ميت . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به زمعة ( 3 ) عنه .(@)(@@) 1065 - حديث : ( ( أن النبي كان يأتي أحدكم . . ) ) الحديث .(@)(@@) تفرد به علي بن قادم ( 3 ) عن زمعة عنه .(@)(@@) 1066 - حديث : ( ( يأت النبي بعد ما تقام الصلاة ( . . . . ) ( 4 ) الرجال . . ) ) الحديث .(@)(@@) تفرد به عمان بن اليمان عن زمعة .(@)(@@) 1067 - حديث : ( ( من كذب علي متعمدا . . ) ) الحديث ( 5 ) .(@)(@@) تفرد به أحمد بن الصقر بن ثوبان ( 6 ) عن سدار عن أبي عاصم عن زمعة . PageV02P178(@)(@@) 1068 - حديث : ( ( لا تحل لامرأة تؤمن بالله . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به زمعة عنه .(@)(@@) 1069 - حديث ( ( قدر حوضي . . ) ) الحديث .(@)(@@) تفرد به زيد بن أبي أنيسة ( 2 ) عن الزهري وهو محفوظ عنه .(@)(@@) 1070 - حديث : ( ( لما ( . . . . ) ( 3 ) النبي من أصحابه . . ) ) الحديث .(@)(@@) تفرد به الحسين بن مصنور بن زياد مولى المهدي أبو علي عن إبراهيم بن إسحاق العيشي عن سفيان عنه والحسين شيخ لابن عقدة .(@)(@@) 1071 - حديث : ( ( توبوا إلى الله عز وجل قبل أن تموتوا . . ) ) الحديث ( 4 ) .(@)(@@) تفرد به الحسن عن إبراهيم عن سفيان عنه