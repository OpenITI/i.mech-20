ms81	 في ظلمة من الحال لكن % % بين شمسين قد أضاءت حياتي % % 2(@)(@@) % وغمامين ينشآن نباتا % يثمر الأجر من جميع الجهات % % 3(@)(@@) % نباتي المناسب كيف تلقى % % شتا شام به انهشم النبات % % 4(@)(@@) % وبرقا ضاربا من فوق بشت % فضربته لعمري والعباة % % 5(@)(@@) % يا سيدي هنئت عيدا أتى % % بالسعد يجلي من جميع الجهات % % 6(@)(@@) % لا غرو إن أحييتني بالندى % % إن الندى والشمس محيي النبات % % 7(@)(@@) % أهوى الصغار فان لاح العذار فقل % % في لوعة خمدت من بعد ما حميت % % 8(@)(@@) % وقل لمن قال في خدي زمردة % لذاك حية ايري عنك قد عميت % % PageV01P384 البحر : - 1(@)(@@) % نباتي المناسب كيف تلقى % % شتا شام به انهشم النبات % % 2(@)(@@) % وبرقا ضاربا من فوق بشت % فضربته لعمري والعباة % % PageV01P385 البحر : - 1(@)(@@) % يا سيدي هنئت عيدا أتى % % بالسعد يجلي من جميع الجهات % % 2(@)(@@) % لا غرو إن أحييتني بالندى % % إن الندى والشمس محيي النبات % % PageV01P386 البحر : - 1(@)(@@) % أهوى الصغار فان لاح العذار فقل % % في لوعة خمدت من بعد ما حميت % % 2(@)(@@) % وقل لمن قال في خدي زمردة % لذاك حية ايري عنك قد عميته % % PageV01P387 البحر : - 1(@)(@@) % بروحي من نص الغزال لها الولا % وأقسم مالي غير جفنك وارث % % 2(@)(@@) % وعد البرايا حسنها فهو أول % وشمس الضحى والبدر ثان وثالث % % 3(@)(@@) % وقد سألوا أهل الكؤس كريقها % % مدام فقالت للكؤس الخبائث % % 4(@)(@@) % وهل في الورى سحر وماغير لحظها % % ولفظ علاء الدين للسحر نافث % % 5(@)(@@) % أرى لعلي رتبة وفضائلا % تقر لها هذي النجوم المواكث % % 6(@)(@@) % فأحجم اجلالا عن القول واللقا % % ويبعثي من سائق البر باعث % % 7(@)(@@) % وأحلف مافي الدهر مثل عليه % % ويحلف أهل العصر ما أنا حانث % % 8(@)(@@) % عريق التقى وفي السيادة حقها % % فيا حبذا منه قديم وحادث % % 9(@)(@@) % سما وحمى الدنيا باقبال شخصه % % فدت شخصه سام وحام ويافث % % 10(@)(@@) % وطالت معاليه إلى الغاية التي % % جرى البرق في آثارها وهو لاهث % % PageV01P388 البحر : - 1(@)(@@) % رب راح بت أشربها % % من يدي عذب اللما خنث % % 2(@)(@@) % قابلت في الكاس وجنته % % فسقانيها على الثلث % % 3(@)(@@) % بأبي الساقي ولثغته % % ومعاني خلقه الدمث % % 4(@)(@@) % سل سيف 
ms82	 المزج فارتعشت % % وغدت تنزو من اللهث % % 5(@)(@@) % قلت دعها قال قد سرقت % % من سنا خدي ومن نفثي % % 6(@)(@@) % قسما لو لم تضم على % % كأسها طارت من العبث % 7(@)(@@) % خمرة بالجام ناهضة % نهضة الأرواح بالجثث % % 8(@)(@@) % لو ذكرناها لذي جدث % قام نشوانا من الجدث % % 9(@)(@@) % ظن قوم شربها رفثا % لا سقوا من ذلك الرفث % % 10(@)(@@) % هاتها راحا كلفظ فتي ع طاهر الأخلاق منبعثسقط شطرينص صهات مدح ابن الأثير تجد % % طاهرا يغني عن الخبث % % PageV01P389 11(@)(@@) % مجزل النعمى كأن به % % للثنا نوع من الغرث % % 12(@)(@@) % لعلاء الدين نشر ندى % لم منا كل ذي شعث % % 13(@)(@@) % ترفع اللأوا مواهبه % % مثل رفع الماء للحدث % 14(@)(@@) % ومعال عقد أقربها % % بالثريا غير منتكث % % 15(@)(@@) % ويراع خيف مضربه % % فذكور البيض في طمث % % 16(@)(@@) % نافث سحر البلاغة في % % عقد جلت عن النفث % % 17(@)(@@) % قالت العليا لسودده % % صن وقال المال قم فعث % 18(@)(@@) % ما على من أم ساحته % % أن عام الجدب لم يغث % % 19(@)(@@) % جاد حتى قال لائمه % % إن بعض الجود كاللوث % % 20(@)(@@) % وهمت نعمى يديه على % % كل ذي صفو وذي غلث % % PageV01P390 21(@)(@@) % كالحيا قد عم محترثا % و دقه أو غير محترث % % 22(@)(@@) % عذلوه في مكارمه % % وهو ماض غير مكترث % % 23(@)(@@) % أيها المستن في جدد % للعلى والناس في وعث % % 24(@)(@@) % والذي لو لم أخط له % % مدحا للمسك لم أمث % % 25(@)(@@) % لا تسل عن حال عبدك في % % زمن مستحكم المغث % % 26(@)(@@) % محن تأتي على عجل % % وأمان جمة اللبث % % 27(@)(@@) % أصغ ساعف قدم ارع أنل % % إعطف ارحم صن أعذ أغث % % 28(@)(@@) % شكرت نعماك أعظمنا % % في البقا والبعث والجدث % % PageV01P391 البحر : - 1(@)(@@) % قديمة راح في يمين حديثه % من السن عن شيخ التصابي محدثة % % 2(@)(@@) % تثنت على رغم القلى وتربعت % % لو صلي بحمى العاذلات مثلثه % % 3(@)(@@) % فدا لوزير الملك ملبس صحة % % لنار الأعادي والجناة مؤرثة % % 4(@)(@@) % ويمنا على مصر وشام أفاضه % وزير زمان ساعد السعد مبعثه % % 5(@)(@@) % وزير لديه العقد والحل راقنا % % فما عقدة في الحاسدين منفثه % % 6(@)(@@) % أخو السعد في كل الأمور أرادها % % يهذب 
ms83	 ما كان الزمان قد أحدثه % % 7(@)(@@) % نهني بلقياه حمى مصر إنها % % بغيبته حاشا المزاج مغلثه % % PageV01P392 البحر : - 1(@)(@@) % لله خال على خد الحبيب له % % في العاشقين كما شاء الهوى عبث % % 2(@)(@@) % أورثته حبة القلب القتيل به % % وكان عهدي أن الحال لا يرث % % PageV01P393 البحر : - 1(@)(@@) % ثلاث مآذن في الحسن زادت % % فرابعها لأجل العين جاثي % % 2(@)(@@) % و مانقصت محاسنها ولكن % % ليحلف واصفوها بالثلاث % % PageV01P394 البحر : - 1(@)(@@) % ووراثة الألحاظ من حدق المها % % غدت نار قلبي من هواها مؤرثة % % 2(@)(@@) % مذكرة الاسياف من لحظاتها % % وقالت علامات الفتور مؤنثة % % 3(@)(@@) % تغزلت فيها وامتدحت أخا العلى % % إمام التقى والنفس غير مغلثة % % 4(@)(@@) % ولم لا ومن نعماه للفكر باعث % % على أدب ما مات الا ليبعثه % % 5(@)(@@) % امام لهاه بالمعالي فقيهة % وامداحه بالمكرمات محدثه % % 6(@)(@@) % أمولاي شهرا جامع الشام أزمعا % % على موته من فكرة العبد محدثة % % 7(@)(@@) % وقد بنيت حمامها في أضالعي % % وعزم أناس أن تكون مثلثة % % PageV01P395 البحر : - 1(@)(@@) % واحيلتي بظلام الطرة الداجي % % واشقوتي بنعيم الملمس العاجي % % 2(@)(@@) % ويا ضلال رشادي في هوى صنم % لاشيء أهتك لي من طرفه الساجي % % 3(@)(@@) % يثج ماء دموعي خط عارضه % % ويلاه من عارض للدمع ثجاج % % 4(@)(@@) % إيها عذولي وباعد فيه عن بصري % % فما أظنك من سيل البكى ناجي % % 5(@)(@@) % قد أسرج الحسن خديه فدونك ذا % % سراج خد على الأكباد وهاج % % 6(@)(@@) % وألجم العذل واركض في محبته % % طرف الهوى بعد إلجام وإسراج % % 7(@)(@@) % وقسم الشعر فاجعل في محاسنه % % شذر القلا ئد واهد الدر للتاج % % 8(@)(@@) % الواصل الجود فينا غير منقطع % والفارج الحال منا بعد إرتاج % % 9(@)(@@) % بحر ترى المال سار من أنامله % % كأنه زبد من فوق أمواج % % 10(@)(@@) % وأصبحت هذه الافاق آمنة % بعدله بعد إرهاب وإرهاج % % PageV01P396 11(@)(@@) % كأن أراءه بين الديار بها % % كواكب تتجلى بين أبراج % % 12(@)(@@) % في كفه قلم ناهيك من قلم % للمال مجر وللغماء فراج % % 13(@)(@@) % سهم لمن رام تنفيذ الأمور به % % لكنه هدف للطالب الراحي % % 14(@)(@@) % اذا انتحى الامر فانظر في الطروس إلى % % محرك لسكون الخلق مزعاج % % 15(@)(@@) % لا يعدم الفضل منه 
ms84	 أي متجر % ولا رقوم المعاني أي نساج % % 16(@)(@@) % ياقالة الشعر في الاقطار طالبة % مراد قصد اليه يلتجي اللاجي % % 17(@)(@@) % سعيا لأبواب تاج الدين إن لها % % منهاج فضل بريء الفضل من هاجي % % 18(@)(@@) % يممته والغلا والفقر قد جمعا % % لحالتي بين طاعون وحجاج % % 19(@)(@@) % مجاوبا منه في سر وفي علن % ودا ورفدا ينادي كل محتاج % % 20(@)(@@) % لما دعا الدعوة الأولى فأسمعني % % لبست بردي واستمررت أدراجي % % PageV01P397 21(@)(@@) % فاستقبلت جذب أحوالي غمائمه % وبدلت حزن أفكاري بأبهاج % % 22(@)(@@) % وتابع الرفد حتى ما ظننت إذا % % أني من السيل في أبوابه ناجي % % 23(@)(@@) % ذاك الذي يحمل المهدي مدائحه % % جواهرا من حلاه بين إدراج % % 24(@)(@@) % ملكت شعري على الاشعار حين حوى % % ذكر اسمه فهو رب الملك والتاج % % PageV01P398 البحر : - 1(@)(@@) % كم عذول على هواك أداجي % % يا رشا من سطاه لست بناجي % % 2(@)(@@) % لك خد سناه يوهج قلبي % % حزني من سراجك الوهاج % % 3(@)(@@) % وعذار أظنه وهو خاف % حول خديك زئبر الديباج % % 4(@)(@@) % حبذا أنت من هلال سعود % بت فيه أرعى نجوم الدياجي % % 5(@)(@@) % وغرير قضى حجاي وعمري % % في هواه وما تقضيت حاجي % % 6(@)(@@) % كلما اشتقت سائغا من لماه % عوضتني عيني بدمع أجاج % % 7(@)(@@) % أقسم الحب لا يغير قلبي % % من شجون ولا يصح مزاحي % % 8(@)(@@) % سقم ثابت وعقل شريد % طالما احتجت فيهما للعلاج % % 9(@)(@@) % وعذول في الحب يجمع للمغ % % رم بين الطاعون والحجاج % % 10(@)(@@) % مطمئن على الملام وعندي % % شغل عن ملامه بانزعاج % % PageV01P399 11(@)(@@) % ولئن كان عن رضى الحب حزني % % فمن الحزن غاية الابتهاج % % 12(@)(@@) % لي من أدمعي ولفظي در % حسن الاتساق والإزدواج % % 13(@)(@@) % تلك منثورة على حلة الحس % % ن وهذا منظم في التاج % % 14(@)(@@) % الرئيس الذي تناجت عليه % % كلم المادحين أي تناح % % 15(@)(@@) % والكريم الذي به نفق القص % % د وراج القريض أي رواج % % 16(@)(@@) % كاتب يبذل النضار صحاحا % % ويصون الشذور في الأدراج % % 17(@)(@@) % عرف الملك منه تنبيه رأي % سائر في الهدى على منهاج % % 18(@)(@@) % ويراعا بصدره يتلقى % % كل راج يسعى اليه ولاجي % % 19(@)(@@) % يا له من يراع فضل وفيض % يوم سلم 
ms85	 يدعى ويوم هياج % % 20(@)(@@) % كلما لاح في عجاج سواد % وقر البيض من سواد عجاج % % PageV01P400 21(@)(@@) % ذي سطور مثل البساتين تجنى % % وهي حول الاسلام مثل السياج % % 22(@)(@@) % أنشأتها يد ابن خضر ففاحت % % وسرى عرفها بكل الفجاج % % 23(@)(@@) % سيد أجمع الثناء عليه % % يوم فضل فلات حين احتجاج % % 24(@)(@@) % كم عرضنا مقدمات أمان % لنداه فأحسنت في النتاج % % 25(@)(@@) % من أناس من التقى والمعالي % % وهم بين نطفة أمشاج % % 26(@)(@@) % وأضحى العلم والهدى بسناهم % % يتجلى عن الورى كل داجي % % 27(@)(@@) % يارئيسا أضحت به حلب الش % % هباء ملقى الأفواج فالأفواج % % 28(@)(@@) % كل نعمآء غير نعماك عندي % % في صلاة الصلاة مثل الخداج % % 29(@)(@@) % فأبق يا مرتجي الندى في معال % ما لأبواب سعدها من رتاج % % 30(@)(@@) % نتمنى بلا احتياج لمغنا % ك سرانا فكيف عند احتياج % % PageV01P401 البحر : - 1(@)(@@) % بروضة حسن والعذار سياجها % % أغث مهجة أضحى لديك احتياجها % % 2(@)(@@) % ودارك فتى أشفت على الموت نفسه % % ولو شاء ذاك الحسن هان علاجها % % 3(@)(@@) % فكم ليلة قد صح فيك مزاجها % % بكأس ثنايا منك كان مزاجها % % 4(@)(@@) % أحاشيك أن تقضى حشاشة مدنف % ولم تقض منك من عود التواصل حاجها % % 5(@)(@@) % وإني إلى حسن التجلد ساكن % فما بال عذالي يزيد انزعاجها % % 6(@)(@@) % أراقب من هم التفرق فرجة % وما الدهر إلا غمة وانفراجها % % 7(@)(@@) % نديمي هذا الغيث فامزج بقطره % % لنا قهوة قد كاد يذكو زجاجها % % 8(@)(@@) % وأنتج به در الحباب فهكذا % % قطار الحيا در البحار نتاجها % % 9(@)(@@) % وزاوج ثنايا بالحباب فانما % % يزين اللآلي في النظام ازدواجها % % 10(@)(@@) % وأطفيء بهذا الكاس همي فانني % % أرى السرج تطفأ وهي تطفي سراجها % % PageV01P402 11(@)(@@) % لئن زان هذا العقد جيدا للذة % لقد زان فرقا للفضائل تاجها % % 12(@)(@@) % رئيس اذا أجريت في المدح اسمه % % رأيت المعالي كيف يجري ابتهاجها % % 13(@)(@@) % فما رفعت إلا عليه بيوتها % % ولا نصبت إلا اليه فجاجها % % 14(@)(@@) % بأقلامه تحمى البلاد وتحتوي % % فيا حبذا منتاجها ورتاجها % % 15(@)(@@) % كأن ظبا أقلامه في طروسه % % أسنة جيش والمداد عجاجها % % 16(@)(@@) % لها من عيون اللفظ كل بديعة % يبشر أفكار الرواة اختلاجها % % 17(@)(@@) % يروقك 
ms86	 في سحر البيان وإنما % % يروعك من مثل الضلال مجاجها % % 18(@)(@@) % به انتظمت خير العقود وثقفت % % فهوم البرايا زيغها واعوجاجها % % 19(@)(@@) % ثوى بحرها في ساحل الشام وانبرت % % لآلي نماها عذبها لا أجاجها % % 20(@)(@@) % يكف كريم الأصل من طرفي علي % % يصوب نداها أو يصول هياجها % % PageV01P403 21(@)(@@) % أخو شيم قد سلمت لفخارها % % مفاخر قوم كان حما حجاجها % % 22(@)(@@) % كأن دروج الخط منه لحسنها % % خصور ملاح يستبين اندماجها % % 23(@)(@@) % كأن صلات البر عند نواله % % صلاة يوفي نقصها وخداجها % % 24(@)(@@) % فأحسن من صوب السحاب هباته % % وأحسن من تلك الهبات رواجها % % 25(@)(@@) % لئن قصرت أفكارنا عن مديحه % % لقد طال في ليل السطور ادلاجها % % 26(@)(@@) % لئن كان أخلى فج مصر لقد سرى % % فقالت لمرآه العزيز العجاج ها % % 27(@)(@@) % أمولاي لي شوق مؤرق مقلة % % ضعيف على بحث السهاد احتجاجها % % 28(@)(@@) % فللسهد ما طافت عليه جفونها % % وللدمع ما دارت عليه فجاجها % % 29(@)(@@) % بعثت مدى الأيام تحتي سيادة % % لبيتك قد جلت وجل نتاجها % % 30(@)(@@) % فلا سؤدد إلا اليك معاده % % ولا مدحة الا اليك معاجها % % PageV01P404 البحر : - 1(@)(@@) % حلفت بليل الشعر منه إذا سجى % % وضوء الضحى من وجهه متبلجا % % 2(@)(@@) % ومن أدمعي بالمرسلات من الأسى % % ومن أضلعي بالموريات من الشجى % % 3(@)(@@) % لقد ألجم العذال وجه معذبي % % وقد لاح في جنح الظلام فأسرجا % % 4(@)(@@) % وفرج غمي ذات يوم بزورة % فقلت لعيني انظرا وتفرجا % % 5(@)(@@) % ظلاما وبدرا فوق غصن على نقا % % دجى وتجلى وانثنى وترجرجا % % 6(@)(@@) % وخدا كفاني صبوة شم ورده % % فكيف وقد زاد العذار بنفسجا % % 7(@)(@@) % صحيفة حسن قابلتها ملاحة % % ألم تره سطرا عليها مخرجا % % 8(@)(@@) % بروحي في أفق المحاسن كوكب % على مثله قد طاب لي سهر الدجى % % 9(@)(@@) % نهاني عنه الهم قبل عواذلي % % وأخرجي عنه وما كنت مخرجا % % 10(@)(@@) % وأزعجني شيب بفودي طالع % وما كان وقع الشيب لي عنه مزعجا % % PageV01P405 11(@)(@@) % فيالك مقطوف العذار هجرته % % فما عرجت عيني له حين عرجا % % 12(@)(@@) % دنت داره مني وشط مزاره % فهل أبصرت عيناك ثغرا مفلجا % % 13(@)(@@) % كأني لم أنعم بدينار خده % % مشوقا على نقد العدى 
ms87	 أو مبهرجا % % 14(@)(@@) % ولم أصب من لهو بنقطة خاله % % إلى كرة من حولها الصدغ صولجا % % 15(@)(@@) % ولم أحجب العذال منه بحاجب % رأوا عنده حق الملاحة أبلجا % % 16(@)(@@) % ولم أترشف بعد فيه مدامة % على يده دفاعة حجة الحجى % % 17(@)(@@) % ولم أعط كأسا بالنضار وخده % % لمعطيه بالدر النظيم متوجا % % 18(@)(@@) % ولم أتلق النهد في الصدر جالسا % وأسرى به حالي الشكيم مهملجا % % 19(@)(@@) % إلى الروض فياحا من الزهر باسما % على الزهر رفاقا لدى الطل سجسجا % % 20(@)(@@) % أحبر في مدح الإمام محمد % من اللفظ أبهى الروضتين وأبهجا % % PageV01P406 21(@)(@@) % وما هو ممن لا أنقح مدحه % % فآني اليه بالمديح مروجا % % 22(@)(@@) % أخاف له نقدا فأبطئ في الثنا % % كجمع أبي جاد الحروف من الهجا % % 23(@)(@@) % ألم تر أني قد لجأت لظله % % ودافعت حرا من أذى الدهر موهجا % % 24(@)(@@) % أخلد تاريخ العلى بصفاته % % وأروي حديث الفضل عنه مخرجا % % 25(@)(@@) % وأصرف أمالي التي قد تقسمت % % إلى مرتجى ما باب نعماه مرتجا % % 26(@)(@@) % كريم اذا ما قدم الظن نحوه % % مقدمة من منطق المدح أنتجا % % 27(@)(@@) % ولا عيب فيه غير اسراع جوده % % فليس يمني بالمواعد محوجا % % 28(@)(@@) % وأفراط كتم للندى وهو ظاهر % % وهل مانع للروض أن يتأرجا % % 29(@)(@@) % وقى الدين والدنيا ليهلك ملحد % لديه وينجو راشد مع من نجا % % 30(@)(@@) % فتاوى على سمت الهدى وفتوة % % تجانس معنى لفظها وتدبجا % % PageV01P407 31(@)(@@) % وبر رعى قصد العفاة فغاثها % % وبأس كوى قلب العدو فانضجا % % 32(@)(@@) % وعلم أقامته المباحث ناصرا % فقل علم رد الأسود وهججا % % 33(@)(@@) % هو البحر يروى حول شطيه وارد % ويغرق من قد لج فيه ولججا % % 34(@)(@@) % له قلم يحمي الحمى برقاعه % % ويكتب بالنعمى وبالعلم مزوجا % % 35(@)(@@) % إذا قال لم يترك لذي القول موضعا % وان صال لم يترك لذي الصول مولجا % % 36(@)(@@) % فكم من بليغ في الورى متفصح % وعى لفظة من كتبه فتلجلجا % % 37(@)(@@) % وكم من كمي صار كالدج حيرة % % فلا غرو إن قالوا لكمي المدججا % % 38(@)(@@) % وكم منهج في القول أرشدني له % % وكم أمل أنشاه لي حين أنهجا % % 39(@)(@@) % وكم كسوة لي في 
ms88	 دمشق أفادها % % وقد كان ظهري من أذى البرد أعوجا % % 40(@)(@@) % وكم أنطقت نعماه مني مدائحا % سرى ذكرها غربا وشرقا فأدلجا % % PageV01P408 41(@)(@@) % وروى نباتيا من القول طالما % % سقاه أبوه الغيث نوا مثججا % % 42(@)(@@) % أبا الخير خذها من ثنائي كرائما % أبت عن سوى أكفائها أن تزوجا % % 43(@)(@@) % أوانس أبكار يحق لحسنها % % على ساكن الأمصار أن يتبرجا % % 44(@)(@@) % تهب للقياها الكرام من الحيا % % ويجري بذكراها المطي على الوجا % % 45(@)(@@) % لها إن تقم في دارة الأفق منزل % وإن تسر حلت من ثرياه هودجا % % PageV01P409 البحر : - 1(@)(@@) % مدت اليك المعالي طرف مبتهج % % وأعربت بلسان المادح اللهج % % 2(@)(@@) % وأشرق المنبر المسعود طالعه % % بخير بدر بدا في أشرف الدرج % % 3(@)(@@) % خطبت بالشام لما أن خطبت له % % فاهنأ بمتفق اللفظين مزدوج % % 4(@)(@@) % يا حبذا أفق عطرت جانبه % % حتى استدل بنو الآمال بالأرج % % 5(@)(@@) % صدر العلى فتمكن بالجلوس به % % فقد جلست بصدر غير ذي حرج % % 6(@)(@@) % وأصدع برأيك لا لفظ بمحتبس % إذا خطبت ولا فكر بمنزعج % % 7(@)(@@) % تصبو الورى لسواد قد ظهرت به % % كأنما من حكته أسود المهج % % 8(@)(@@) % عين الزمان تحلى في ملابسه % % وإنما تتحلى العين بالدعج % % 9(@)(@@) % أعظم بها من مساع عنك سائرة % % فقد سلكت طريقا غير ذي عوج % % 10(@)(@@) % ولجت للعلم أبوابا متى خطرت % % بها العزائم أبواب العلى تلج % % PageV01P410 11(@)(@@) % ودافعت يدك الآمال جائدة % % تدافع السيل في أثناء متعرج % % 12(@)(@@) % مناقب يهتدي وفد الثناء لها % % بواضح من ضياء البدر منبلج % % 13(@)(@@) % كأن نغمة عافيه بمسمعه % % أصوات معبد في الثاني من الهزج % % 14(@)(@@) % يا طالبا منه جودا أو مباحثة % % رد بحره العذب واحذر سورة اللجج % % 15(@)(@@) % بحر الندى والهدى ان شمت مورده % % شمت النجاة وان هيجته يهج % 16(@)(@@) % مبصر الرأي مأخوذ بفطنته % % إلى المراشد مدلول على النهج % % 17(@)(@@) % هذا دليل الشباب الجون منسدل % % فكيف لما يضيء الشيب بالسرج % % 18(@)(@@) % إيه بعيشك بدر الدين سد فلقد % % أدلجت للفضل فينا كل مدلج % % 19(@)(@@) % أنت الذي فضل الأخبار شاهده % % فيممته بنو الآمال بالحجج % % 20(@)(@@) % من فيض جودك جاد الفائضون ندى % % كأنك 
ms89	 البحر يروى عنه بالخلج % % PageV01P411 21(@)(@@) % لازال بابك للمغلوب جانبه % % وواجد الهم باب النصر والفرج % % PageV01P412 البحر : - 1(@)(@@) % أقسمت من فرعها المسبول بالداجي % % كالآبنوس بمشط الرجل في العاج % % 2(@)(@@) % لقد تورط قلبي في حبائلها % % فما أرى أنه من حبها ناج % % 3(@)(@@) % لم أنس يوم النوى دمعا بوجنتها % % كما نثرت لآل فوق ديباج % % 4(@)(@@) % وناظري حين أخلى الجزع ساكنه % % كعارض بعقيق الدمع ثجاج % % 5(@)(@@) % محجوبة ان أقل عمري انقضى فيها % % قضى حجاي ولم يقض اللقا حاجي % % 6(@)(@@) % لا عيب فيها سوى ريق على برد % % مبرد في الشتا والصيف ثلاج % % 7(@)(@@) % قسمت أغزال شعري والمديح لها % % نظم الشذور ونظم الدر في التاج % % 8(@)(@@) % يحيى الندى جعفر والفضل قد فنيا % % وظله لا عدمنا ظله ساج % % 9(@)(@@) % ذو الجود كم جمل من وفر راحته % % قد عوجلت قبل تحصيل باخراج % % 10(@)(@@) % والبر والمكرمات الغر كم هرعت % % إليه أفواج قصد بعد أفواج % % PageV01P413 11(@)(@@) % كم من بنات وأبناء قد اجتمعوا % % على قراه وزوجات وأزواج % % 12(@)(@@) % كم بين أبيات أمداحي له شيم % كأنهن نجوم بين أبراج % % 13(@)(@@) % بحر أرى مقبلات الخير أكثر من % % ماضي سراها فما عد لامواج % % 14(@)(@@) % في كفه القلمان الراجحان على % % سواهما بين كفات وأدراج % % 15(@)(@@) % يا حبذا قلم التصريف مع قلم ال % % إنشاء من سابق في الطرس هملاج % % 16(@)(@@) % وحبذا الطرس منشورا بنفع رجا % % وملتقي كل ذي هم بإفراج % % 17(@)(@@) % وحبذا من حباسي وأنعمه % فراجة لمثار الخطب مهتاج % % 18(@)(@@) % في الحمد والأجرذ وفكر وذو نظر % % إلى صميم العلى والفضل ولاج % % 19(@)(@@) % قضى له الله أن تعلو مراتبه % % وأن يكون ملاذ القاصد اللاجي % % 20(@)(@@) % مهنأ الجود مدلول النوال على % % أهل المقاصد دار حال محتاج % % PageV01P414 21(@)(@@) % إذا أراد قبول البر خالقنا % % هيا نوافله في وقت إحواج % % 22(@)(@@) % يا مذكري من كريم الدين أنعمه % % بمصر دم أنت تاجي العلى ناجي % % 23(@)(@@) % لقد منحت كثيرا من قليلك إذ % % قليله في كثير الوفر رواج % % 24(@)(@@) % فأنت عندي وعند الناس أكرم من % % ذاك الممكن يا نعم الفتى الراجي % % 25(@)(@@) % مولاي مولاي تاج 
ms90	 الدين ممتدحا % حاشا لمنهاج ذاك الباب من هاج % % 26(@)(@@) % أحسن بها جبة قد فرجت كربي % % عودية أطربتني بعد ازعاج % % 27(@)(@@) % شكرا لنساجها بل للجواد بها % % مستفتحا باب شعري بعد ارتاج % % 28(@)(@@) % إن يكسني ما سيبليه الزمان فقد % % كساه ما ليس يبلى نسج نساج % % 29(@)(@@) % لأجعلن لشعري عنده ملكا % على الرواة سني الملك والتاج % % PageV01P415 البحر : - 1(@)(@@) % أشرق الشام فما أي % % من ياطالع نهجك % % 2(@)(@@) % ثم لما فاح مس % % كا قيل من جاقلت منجك % % 3(@)(@@) % كم هلال كاد يا قا % % دم أن يحسد سرجك % % 4(@)(@@) % وابنه الكاتب قد و % % ذ إذا يكتب درجك % % 5(@)(@@) % واسترق الجود أحرا % % را أتوك الكل تنجك % % 6(@)(@@) % صيدك الأجر ودار ال % % عدل لا تبرح مزجك % % 7(@)(@@) % حج في هذي الرعايا % % قبل الرحمن حجك % % PageV01P416 البحر : - 1(@)(@@) % أسرت في الحب ياينجو فمن ينجي % % يا طفلة الترك من هجرانك الكرجي % % 2(@)(@@) % هل لثمة منك مثل الراح عند فمي % % وعند عاذلي الغيران كالبنج % % 3(@)(@@) % كالشهد لفظ علاء الدين نرقبه % % والسم عند عداة الدين نسترجي % % 4(@)(@@) % أهلا بمقدم من ود الهلال بأن % % يمسي لمركوبه المسعود كالسرج % % 5(@)(@@) % ملك الكتابة أي الأرض واصلها % % مسعاه كان سعيد الوصل والدرج % % 6(@)(@@) % إن بت في مرج ذكراه فإني من % % هم التباعد في هرج وفي مرج % % 7(@)(@@) % قد فقعت بالتنائي مهجة نسبت % % في الخاص قدما وقد عادت من الجرج % % PageV01P417 البحر : - 1(@)(@@) % مولاي مولاي نجم الدين دعوة من % % في قصد جودك لا يحتاج للحجج % % 2(@)(@@) % ومن اذا أبصرت عيناه عبدكم % في الباب أبصر ما يرجوه من فرج % % 3(@)(@@) % هذا رجا الدجن كم أرسى وكم لك من % % عقد من المن عندي واضح النهج % % 4(@)(@@) % در المقال وتبر الجود تبعثه % % فابعث لكانوننا شيئا من السبج % % PageV01P418 البحر : - 1(@)(@@) % يا قادما باليمن للمهتاج في % % أحواله والمن للمحتاج % % 2(@)(@@) % قسما بسؤددك الجلي فانه % % منهاج فضل ماله من هاج % % 3(@)(@@) % ما ترفع الأيام رأس رياسة % إلا اذا وسمت بهذا التاج % % PageV01P419 البحر : - 1(@)(@@) % حللت بمصر عن الحاكمين % % كأنا ذوي نسب مبهج % % 2(@)(@@) % إمام التقي دم 
ms91	 لنا مرتجى % % و ما باب فضلك بالمرتج % % 3(@)(@@) % فليس الدقيق كمثل الجليل % % وليس العللي كالخزرجي % % PageV01P420 البحر : - 1(@)(@@) % وافى الي بمدحه قد أخبرت % % عن كل بيت جيد من أين جا % % 2(@)(@@) % فسكت عنه فجاءني بهجائه % % لأجيبه هيهات أخلفه الدجى % % 3(@)(@@) % من كان في حال المدائح ساقطا % عندي فكيف يكون في حال الهجا % % PageV01P421 البحر : - 1(@)(@@) % أشكو السقام وتشكو مثله امراتي % % فنحن في الفرش والأعضاء نرتج % 2(@)(@@) % نفسان والعظم في نطع يجمعنا % % كأنما نحن في التمثيل شطرنج % PageV01P422 البحر : - 1(@)(@@) % إلهي سلمت من الضرب في % % بلاد لعيشي فيها حرج % % 2(@)(@@) % وأرجو الخلاص فقرب به % % لباب السلامة باب الفرج % % PageV01P423 البحر : - 1(@)(@@) % عذولي منك في أمر مريج % % وسمعي منك في ذكر أريج % % 2(@)(@@) % بذكرك طاب منطق وأغرت % % ملامته هوى قلبي اللجوج % % 3(@)(@@) % كما أغرى الملام نوال كفي % % ولي الدين ذي المدح البهيج % % 4(@)(@@) % كريم لو تفاخره كرام % % مضوا يعدوا بغيظ في ضجيج % % 5(@)(@@) % لو أن ابن الفرات النيل داجى % % تفرجنا على ذاك الخليج % % 6(@)(@@) % مليجي له في الجود باب % يكاد زحامه ينهى ولوجي % % 7(@)(@@) % بدا جودا فان احجب لعذر % % أتيت بطوخ فيه على مليج % % PageV01P424 البحر : - 1(@)(@@) % يا واعظ الشام والثناء له % % في سائر الأرض سائر الارج % % 2(@)(@@) % من بر كرسيك السني فقد % % رأى ابن جوزيها على درج % % 3(@)(@@) % يانور أفكارنا وأعيننا % % أغنيت أوقاتنا عن السرج % % 4(@)(@@) % فرجت بالوعظ عن خواطرنا % % فنحن نفديك يا أبا الفرج % % PageV01P425 البحر : - 1(@)(@@) % أخرجت قلبي الذي صيرته وطنا % أيام لم تك ذا زيغ ولا عوج % % 2(@)(@@) % فكدت بالرغم أخلي منك جانبه % % خوفا عليك من المستوطن الحرج % % PageV01P426 البحر : - 1(@)(@@) % جاء الطواشي بها نصفية % % كأنها الصبح اذا تبلجا % % 2(@)(@@) % مستورة بذيله فحبذا % % طرة صبح تحت أذيال الدجي % % PageV01P427 البحر : - 1(@)(@@) % بنفسج الخد داع % % مشيب خدي المثلج % % 2(@)(@@) % عندي هوى معرض لا % % يرضى بشم البنفسج % % PageV01P428 البحر : - 1(@)(@@) % خلعة قاضي القضاة لا برحت % % بك التهاني أوفى رجا الراجي % % 2(@)(@@) % للحكم كالملك أنت صالحة % يا خلعة الطيلسان والتاج % % PageV01P429 البحر : - 1(@)(@@) % الجمد لله كم عطاء له % % في كل قصد 
ms92	 وكل منهاج % % 2(@)(@@) % ملك العلى والعلوم جدده % % وخلعة الطيلسان والتاج % % PageV01P430 البحر : - 1(@)(@@) % عجبت لأنكاد الزمان وإن طمت % % و لا عجب في فكرة تتولج % % 2(@)(@@) % أجاور من أهوى ولا وصل بيننا % % كأني ومن أهواه ثغر مفلج % % PageV01P431 البحر : - 1(@)(@@) % أفدي الذي جبينه في شعره % % طرة صبح تحت أذيال الدجى % % 2(@)(@@) % مالي به مع قرب داري ملتقى % % فهل رأيت ثغره المفلجا % % PageV01P432 البحر : - 1(@)(@@) % كلفت بشائب لا عذل يثني % % جماجي في هواه ولا لجاجي % % 2(@)(@@) % أقبل من عذاري وجنتيه % % سياج الورد أو ورد السياج % % PageV01P433 البحر : - 1(@)(@@) % و أهيف القد فتان العيون قضى % % على الجوانح واستولى على المهج % % 2(@)(@@) % لثغره ولخديه وطرته % % شبه من الدر والياقوت والسبج % % PageV01P434 البحر : - 1(@)(@@) % يا لائمي في رشيق القد معتدل % أقصر فان غرامي غيرذي عوج % % 2(@)(@@) % أشكو الشدائد من وجد أكابده % % و لست أيأس في شكواي من فرج % % PageV01P435 البحر : - 1(@)(@@) % لتهن عين إلى مرآك قد طمحت % % ومهجة فيك بالأشجان قد صلحت % % 2(@)(@@) % يا من اذا باعت الأبصار أسودها % % بحبة فوق خديه فقد ربحت % % 3(@)(@@) % لا أشتكي فيك أشجاني وان مكثت % % ولا اكفكف أجفاني وإن نزحت % % 4(@)(@@) % أنا الذي كرمت أنفاس صبوته % % وكلما مس نارا ندها نفحت % % 5(@)(@@) % يزيدني العذل تبريحا ألذ به % % فليت عذال حبي فيك ما برحت % % 6(@)(@@) % ويعجب الدمع عيني حين يجرحها % % وما العدالة إلا حيثما جرحت % % 7(@)(@@) % ما أدمعي في هواك السمح باخلة % % وكيف وهي التي بالعين قد سمحت % % 8(@)(@@) % سقيا لأوقاتك اللآتي إذا ذكرت % % حلت على أنها بالحسن قد ملحت % % 9(@)(@@) % حيث الصبا بشذا الأزهار نافحة % % في فحمة الليل والأقداح قد قدحت % % 10(@)(@@) % وللقيان بورق الطير مشتبه % هذي وتلك على العيدان قد صدحت % % PageV01P436 11(@)(@@) % والزهر كالضيف أمسى وهو مبتسم % % على زقاق من الصهباء قد ذبحت % % 12(@)(@@) % والراح في يد ساقيها مشعشعة % % كأن وجنة ساقيها بها نضحت % % 13(@)(@@) % ساق إذا اغتبقت ندمان قهوته % % أضآء مبسمه الصبحي فاصطبحت % % 14(@)(@@) % لدن المعاطف يمناه ومقلته % % تسقيك إن حملت راحا وإن لمحت % % 15(@)(@@) % ذو ناظر بالحيا والسحر مكتحل % % فالموت إن غضت 
ms93	 الأجفان أو فتحت % % 16(@)(@@) % كم قابلته لكي تحكيه نرجسة % % فصح أن عيون النرجس انفتحت % % 17(@)(@@) % إذا اعتبرت معاني من كلفت به % % عجبت من حسن ما دقت وما وضحت % % 18(@)(@@) % تلك التي خلفت عيناي غارقة % % ترعى نجوم الليالي كلما سبحت % % 19(@)(@@) % آها لذكر ليال ما فطنت لها % % حتى أناخ عليها الدهر فانتزحت % % 20(@)(@@) % كم يقصد الدهر إغضابي بقادحة % % في الحال لكنها في الصبر ما قدحت % % PageV01P437 21(@)(@@) % إن عاب رونق ألفاظي ذوو إحن % ففي السماء بدور طالما نبحت % % 22(@)(@@) % دع الليالي إني قد غفرت لها % % بالافضل الملك ما كانت قد اجترحت % % 23(@)(@@) % جاءت به مغرب الأوصاف مشرقها % % مثال ما اقترح العليا وما اقترحت % % 24(@)(@@) % ملك لهاه عن الآمال قد فصحت % % وراحتاه عن الأيام قد صفحت % % 25(@)(@@) % له خطى جازت العليا وما فخرت % % وأنمل كفت الدنيا وما بجحت % % 26(@)(@@) % تندي حياء غداة الجود طلعته % % كأنما منعت كفاه ما بجحت % % 27(@)(@@) % كانت بنو الدهر غضبى مع زمانهم % لكن على يده الفياضة اصطلحت % % 28(@)(@@) % كم منطق فصحته بالثناء وكم % % نحو من الجود في أهل الرجاء نحت % % 29(@)(@@) % كم نعمة سبحت عن بيت سؤدده % % في الخافقين وكم من مدحة سرحت % % 30(@)(@@) % لاعيب في مجده العالي سوى أذن % في الجود لا تسمع العذال إن نصحت % % PageV01P438 31(@)(@@) % أما الرعايا فقد ردت بدولته % % لها وجوه الأماني بعد ما جمحت % % 32(@)(@@) % كل البيوت من الأموال باسمة % % إلا بيوتا من الأموال قد كلحت % % 33(@)(@@) % بين الصوارم والأقلام فكرته % % إن دبرت أفلحت أو صاولت فلحت % % 34(@)(@@) % سجية في بني أيوب قد نفرت % % وبين آل تقي الدين قد رجحت % % 35(@)(@@) % يمد زندا إلى العلياء وارية % أنوارها وهي ما عيبت وما قدحت % % 36(@)(@@) % إذا أطال كريم وعده اختصرت % % وإن طوى قلب باغ غلها شرحت % % 37(@)(@@) % ياابن الملوك جلت أنوار غرتهم % % غياهب الافك عن طرق الهدى ومحت % % 38(@)(@@) % لو لم يكن لك حق الملك من قدم % % لكن حقك بالنفس التي طمحت % % 39(@)(@@) % لو خط بعض اسمك العالي على علم % % وقابلته حصون الأرض لافتتحت % % 40(@)(@@) % أنت 
ms94	 الذي قدمت امداحه فكري % % فخرا على فكر من بعد قد مدحت % % PageV01P439 41(@)(@@) % أنت الذي فسحت نعماء والده % % حالي وفكرتي الغمآء فانفسحت % % 42(@)(@@) % وأودعتني جدوى كفه مننا % كأنها بعد من جفني قد رشحت % % 43(@)(@@) % كم مدحة لي من آثار أنعمه % % سيارة لنجوم الليل قد فضحت % % 44(@)(@@) % بطالع السعد لاجدي ولاحمل % جازت مدى الشهب والغفران ما انتطحت % % 45(@)(@@) % لله درك من ملك له شرف % % ثنى قرائحنا عنه وإن كدحت % % 46(@)(@@) % دامت لملكك أوقات الحبور اذا % % تقلدت من حلى إقبالها اتشحت % % 47(@)(@@) % وجاد قبر الشهيد الغيث ينشده % % يا ساكني السفح كم عين بكم سفحت % % PageV01P440 البحر : - 1(@)(@@) % بكى الشعر أيام المنى والمنائح % % ففي كل بيت للثنا صوت نائح % % 2(@)(@@) % وغاضت بحور المكرمات وطوحت % % بأهل الرجا والقصد أيدي الطوائح % % 3(@)(@@) % ولما ادلهمت صفحة الافق بالأسى % % علمنا بأن الشهب تحت الصفائح % % 4(@)(@@) % حيا المزن أسعدني على فقد سادة % % بدمع كجدواهم على الناس طافح % % 5(@)(@@) % أبعد بني شاد وقد سكنوا الثرى % % قريض لشاد أو سرور لفارح % % 6(@)(@@) % أبعد ملوك العلم والبأس والندى % % تشب العلى نار القرى والقرائح % % 7(@)(@@) % أما والذي أخلى حمى الملك منهم % وعمر بالعليا رسوم الضرائح % % 8(@)(@@) % لئن أوحشوا منهم بيوت مقامهم % % لقد أوحشت منهم بيوت المدائح % % 9(@)(@@) % يجرح قلبي بعدهم صوت ساجع % يذكرني عهد الأيادي السوافح % % 10(@)(@@) % فيا فرخ ضعفي حيث صرت فريسة % % وصار حمام الأيك في الطير جارحي % % PageV01P441 11(@)(@@) % تلا فقد إسماعيل فقد محمد % % فيا للأسى من فادح بعد فادح % % 12(@)(@@) % وزالا فما انسان عيني بممسك % بكاء ولا انسان قول بكادح % % 13(@)(@@) % كأن زناد الفضل لم يور منهما % % سنا شيم ما فيه قول لقادح % % 14(@)(@@) % كأن لم يقم بالمكرمات مطوق % % لدى الباب يشدو بالثناشد وصادح % % 15(@)(@@) % خذ الزاد يا ضيف المكارم وارتحل % % بنوح فقد أقوت ربوع المنائح % % 16(@)(@@) % نزحت دموعا أو نزحت ركائبا % فلله في الحالين حسرة نازح % % 17(@)(@@) % بروحي ديار الفضل صوح روضها % % كأن لم يجب فيها المنى صوت صائح % % 18(@)(@@) % بروحي غريب الدار والنعش عائد % إلى أرضه الثكلى غريب النوائح % % 19 
ms95	(@)(@@) % بروحي نظير الغصن في دوحة العلى % % رماه فأوداه الزمان ببارح % % 20(@)(@@) % رمى فرعه من بعد ما مد ظله % % على كل غاد م العفاة ورائح % % PageV01P442 21(@)(@@) % و جمل دنيانا ببث جميلة % و غطى على مكروهها والقبائح % % 22(@)(@@) % و ساس رعايا أرضه وأطاعه % % على جانب العاصي هوى كل جامح % % 23(@)(@@) % و أعطى عطاء السحب في حال عسرة % % تقوم بأعذار النفوس الشحائح % % 24(@)(@@) % و زواج بين الحلم والبأس ملكه % % فمن أعزل مثل السماك ورامح % % 25(@)(@@) % ورتل من أسلافه سور العلى % % خواتمها موصولة بالفواتح % % 26(@)(@@) % و قام إلى جمع المحامد طامحا % فوالله لم يعدل به عزم طامح % % 27(@)(@@) % و والله ما نقضي حقوق محمد % % إذا نحن أثنينا عليه بصالح % % 28(@)(@@) % و لو أمكن الغيث الفدى بوليه % % فدى صالحا من آل شاد بطالح % % 29(@)(@@) % ورد الردى عن فائض البر عنده % % أعز مكان في الدنى سرح سائح % % 30(@)(@@) % هو الموت لو يثنيه بأس ونائل % % ثنته سجايا كفه في الجوانح % % PageV01P443 31(@)(@@) % هو الموت ما يعييه ثاو بمغفل % % و لا واصل في النبذ من خطو سابح % % 32(@)(@@) % ولا أسد يرنو بأحمر أجزر % تكاد به تشوى لحوم الذبائح % % 33(@)(@@) % ولا أسد الأبراج في الشهب كاسرا % % بتكرارها سرت نفوس الصحائح % % 34(@)(@@) % كفى ببني أيوب للناس واعظا % وان صمتت أفواههم في الضرائح % % 35(@)(@@) % ومرقى المنايا نحو آفاق عرشهم % % وما كان يرقى نحوها طرف طامح % % 36(@)(@@) % سلام على جنات اجداثهم ولا % % سلام لنار الحزن بين الجوانح % % PageV01P444 البحر : - 1(@)(@@) % سرت قمرا من مسبل الشعر في جنح % % بسفح النقا آها على زمن السفح % % 2(@)(@@) % محجبة لا طعن فيها لعائب % % على أنها تمشي فتهتز كالرمح % % 3(@)(@@) % سقى الله ليلا صالحت فيه باللقا % % فما كان أشهى من لقاء ومن صلح % % 4(@)(@@) % أسد بطول اللثم فاها مخافة % على ليلتي أن يهجم الثغر بالصبح % % 5(@)(@@) % ويخطر في وشي الحرير قوامها % % ونجم الدجى بالغيظ يعثر في منح % % 6(@)(@@) % زمان مضى حلوالمراشف والجنى % % وعيش تقضى آمن السرب والسرح % % 7(@)(@@) % ولاعيب في تلك الليالي التي خلت % % سوى أنها مرت على الطرف 
ms96	 كاللمح % % 8(@)(@@) % تولى زمان الوصل وانقرض الصبى % % فيا عجبا للدهر قرحا على قرح % % 9(@)(@@) % سلام على العيش الوري زناده % % على أنه العيش البريء من القدح % % 10(@)(@@) % وغانية مثل الحياة أحبها % % وان كان في كد بها العمر أو كدح % % PageV01P445 11(@)(@@) % ومما غناني عاذل متنصح % وما الغش الا ما سمعت من النصح % % 12(@)(@@) % يطوف بسمعي لفظه وهو بارد % % وفي القلب ما فيه من الوقد واللفح % % 13(@)(@@) % و في الخفرات اللاء تغني بلفظها % % عن العقد والفرع الاثيث عن الرشح % % 14(@)(@@) % غزال رعت في الحب أخضر عيشي % % لقد أعرض الظبي الاغن عن الطلح % % 15(@)(@@) % و قد كان لي والدهر فيه وقائع % % فلما اجتمعنا آذن الدهر بالصلح % % 16(@)(@@) % تعشقتها والخد يشبه خدها % % أأعشقها والشيب ملتمع اللمح % % 17(@)(@@) % كأن جفوني اذ تكاثر دمعها % % بنان ابن فضل الله متصل المنح % % 18(@)(@@) % و قائلة ما بال عزمك صابرا % % على الفدح في الدنيا على أثر الفدح % % 19(@)(@@) % فقلت رأيت السمر أقوم ما ترى % % إذا صبرت عند النفاق من اللقح % % 20(@)(@@) % فقالت دع التقليل عنك وقم إلى % % نوافج فضل الله في زمن الفرح % % PageV01P446 21(@)(@@) % و بادر لمحيي الدين تلق شمائلا % مدربة لم تدر ما هيئة الشح % % 22(@)(@@) % فقمت ولكن بعد أن وضح الدجى % % و عدت بمشهور الثنا طاهر سمح % % 23(@)(@@) % يوري زناد الفضل بالمجد والعلى % % و لكنه الفعل البريء من القدح % % 24(@)(@@) % رئيس رأى آمالنا وهي تشتكي % % من الدهر أسقاما فقال لها صحي % % 25(@)(@@) % يسابق آمال العفاة بضعف ما % % تمنت ويمسي في النوال كما يضحي % % 26(@)(@@) % مغيث الرجا والخوف والذل والخطا % % ببذل الندى بالأمن بالجاه بالصفح % % 27(@)(@@) % اذا وصف المداح بعض صفاته % % فماذا بأكباد الاعادي من الشرح % % 28(@)(@@) % و ان فتح الراوي معاني فخاره % % فدع ما رواه آل خاقان للفتح % % 29(@)(@@) % و لما علا نحو السماء ثناؤه % % أتى بالنجوم الزهر والسحب السح % % 30(@)(@@) % سحائب آلاء تجول على الرجا % % و أنجم آراء تدل على النجح % % PageV01P447 31(@)(@@) % و سعد أفاد الملك أخبية الهنا % % و أنحى على أهل المكايد بالذبح % % 32(@)(@@) % كذلك فليحك 
ms97	 النظير نظيره % % بغر المعالي والمراشد والمنح % % 33(@)(@@) % فيا أيها الساعي لشقة شأوه % % تنح قصيا لست من ذلك الطرح % % 34(@)(@@) % و يا أيها البسام بشرا وفضله % % يعين على أعوامها الشهب الكلح % % 35(@)(@@) % فدي لك من لو أن ميعاد جوده % % كفرعون لم يحتج لهامان في الصرح % % 36(@)(@@) % و أنت الذي أغنيت بالرفد يمينهم % % و بالغت حتى خلت أنك في مزح % % 37(@)(@@) % تحيلت في كتم الذي أتت واهب % % و هيهات ما للمسك بد من النفح % % 38(@)(@@) % و كم جربت منك الملوك ميامنا % ونصحا على فقد الميامن والنصح % % 39(@)(@@) % و غصن يراع يستظل به الورى % % ويشهد قتل المارقين بلا جرح % % 40(@)(@@) % و أنك يا يحيى لتحيي ذوي الرجا % % وتحمي من اللأوا وتنجي من القدح % % PageV01P448 41(@)(@@) % و انك يا يحيى لفائض جعفر % % من الوفر تزداد امتلاء على النزح % % 42(@)(@@) % فلا زال للراجي جناحك موئلا % % وضدك للهم المقيم وللبرح % % 43(@)(@@) % تسامى على المداح قدرك رتبة % % فاقصارهم عن مدحه غاية المدح % % 44(@)(@@) % و كدت لعرفان المكارم لم ترم % % بحمد وما حمد السحاب على السح % % PageV01P449 البحر : - 1(@)(@@) % خلقت على مرادي واقتراحي % % فذكرك حضرتي في وقت راحي % % 2(@)(@@) % ولى من طرة لك أو جبين % % شجون في المساء وفي الصباح % % 3(@)(@@) % بروحي أنت ذو جفن كليل % % وعيني منه دامية الجراح % % 4(@)(@@) % غزالي جفنه وشكا فتورا % % فوا حرباه من شاكي السلاح % % 5(@)(@@) % و تياه سمحت له بدمع % % يرى أن السماح من الرباح % % 6(@)(@@) % و مالي لا أسيل اجاج دمعي % % على عذب بمبسمه قراح % % 7(@)(@@) % يحمر أوجه الكاسات هزؤا % % ويضحك في الرياض على الأقاحي % % 8(@)(@@) % أقمت به على نيران برح % % فما لي كابن قيس من براح % % 9(@)(@@) % سقى صوب الحيا زمنا أقامت % % عليه صبابتي ومحاه ماح % % 10(@)(@@) % و كاسات أشد يدي عليها % % مخافة أن تطير من الجماح % % PageV01P450 11(@)(@@) % صفت فصفا الزمان وبشرتنا % % فحلق درع بشراها النواحي % % 12(@)(@@) % و قد كال النديم بها نضارا % % علمنا أنها داعي السماح % % 13(@)(@@) % بكف مزركش الاصداغ تهوى % % لقبلتها وجوه للملاح % % 14(@)(@@) % عشوت لكأسه لا للثريا % % ونسر الشهب 
ms98	 خفاق الجناح % % 15(@)(@@) % كأني قد سلبت الديك عينا % فثار من المنام إلى الصباح % % 16(@)(@@) % كأني قد حملت على همومي % % بها رايات لهو وانشراح % % 17(@)(@@) % كأني اذ صحا بالمحل أفقي % % رأيت لقا الليالي غير ماح % % 18(@)(@@) % إذا أبصرت جدا من زمان % % فخالطه بشيء من مزاح % % 19(@)(@@) % و ليل ظلت فيه لفرط عزمي % % كأن الشهب من شرر اقتداحي % % 20(@)(@@) % و موحشة المفاوز في رباها % % طغت إبلي وسلن مع البطاح % % PageV01P451 21(@)(@@) % أرشح ذا الخمائل مشمعلا % بها وأحيد عن ذات الوشاح % % 22(@)(@@) % لعز أو لوفر أجتنيه % % على وفق احتياجي واجتياحي % % 23(@)(@@) % علي بها السرى وعلى أيادي % % بني الفاروق إدراك النجاح % % 24(@)(@@) % بني فضل الإله اذا أجيلت % % غداة المحل أيسار القداح % % 25(@)(@@) % نجوم العلم أنواء العطايا % % جياد السبق آساد الكفاح % % 26(@)(@@) % لآلي السلك في نسب نظيم % % ودعنا من أنابيب الرماح % % 27(@)(@@) % لأحمدهم منا هي الحمد عنهم % % فيا كرم اختتام وافتتاح % % 28(@)(@@) % أخو الاغضاء عن تقصير مثن % % وفي طلب العلاء أخو الطماح % % 29(@)(@@) % و ذو الجود الذي يروي عطاء % % لطالب راحتيه عن رباح % % 30(@)(@@) % و ذو القلم الذي ان قال أغني % % عن استسماع قعقعة السلاح % % PageV01P452 31(@)(@@) % سويد القلب قلب العيش منه % % وإلا فهو قادمة الجناح % % 32(@)(@@) % فطورا فائض العذب المهنى % % وطورا فائض السم الذباح % % 33(@)(@@) % أبا العباس قد حفظت ثغور % % برأيك فهي باسمة النواحي % % 34(@)(@@) % تسوك بالقنا مما حبتها % % بزاتك أو تمضمض بالصفاح % % 35(@)(@@) % و سامي الملك منك شهاب عزم % % كفى المراد قبل الالتماح % % 36(@)(@@) % و ذا همم اذا ضلت سيوف % % تنادي الجيش حي على الفلاح % % 37(@)(@@) % حللت بواديي مصر وشام % محل النيل والسحب الدلاح % % 38(@)(@@) % يمين مكارم أو صدر سر % % ملي بالمصون وبالمباح % % 39(@)(@@) % و أغرقت ابن بحر في بيان % % أطاف به على لجج فساح % % 40(@)(@@) % بيان جوهري الوصف تروي % % عوالي الحرب منه عن الصحاح % % PageV01P453 41(@)(@@) % و أن النرجس الحاكيك لفظا % لينبي عن عيون ربا وقاح % % 42(@)(@@) % و أن لراحتيك على الغوادي % % فخارا ما عليه من جناح % % 43(@)(@@) % فؤاد البرق منه في التهاب % % ووجه الدجن 
ms99	 منه في افتضاح % % 44(@)(@@) % أمالك رتبة العليا بلفظ % متين قوى وأخلاق سجاح % % 45(@)(@@) % و باعث فكرتي سيما جبين % % حمدت به السرى عند الصباح % % 46(@)(@@) % عطفت علي في زمن حرون % % وجدت برغم أيام شحاح % % 47(@)(@@) % و قربني جنابك بعد بعد % ونهنه حاسدي بعد الجماح % % 48(@)(@@) % و نطقني نداك وكنت حجلا % فصرت اليوم أنطق من وشاح % % 49(@)(@@) % اليك حسان شعر لم تعرها % % ولا أحوجتها حظ القباح % % 50(@)(@@) % من اللاتي زكت نسبا ورقت % % عليك شمائل الخود الرداح % % PageV01P454 51(@)(@@) % نزحت كلا الندى والعلم بحرا % فأخرجنا لآلي الإمتداح % % PageV01P455 البحر : - 1(@)(@@) % ما البرق في كانونه قد قدح % % والغيم في كف الثريا قدح % % 2(@)(@@) % أضوأ من ذهنك نارا ولا % % أرق من لفظك كأسا طفح % % 3(@)(@@) % أورى نداك الذهن زندا على % % أن امرأ في فضله ما قدح % % 4(@)(@@) % و كأس الفاظ عذاب اذا % % مازجها كافور ثلج نضح % % 5(@)(@@) % وصغت ثلجا فاكتسي برده % % ذكاء الفاظك حتى نفح % % 6(@)(@@) % و سبح الناس بدريهما % % حبا فيا لله من ذي السبح % % 7(@)(@@) % و صار بالثلج عذاب الورى % % عذبا وعاه غمه فانشرح % % 8(@)(@@) % لم أنسه كالشيب لما أضا % % في الرأس أو في الجلد لما جرح % % 9(@)(@@) % قد غسل الليل بصابونه % % وفاض في صبغ المسا فانمسح % % 10(@)(@@) % و خاف أن يغتبق الأفق من % % أندائه صدر الدجى فاصطبح % % PageV01P456 11(@)(@@) % و عاد خيط الليل من لونه % % أبيض كالفرق إذا ما وضح % % 12(@)(@@) % وسيرت منه الجبال التي % % رأى بها الساعة طرف طمح % % 13(@)(@@) % ما كان ذاك الوجد حوتا جرى % % في فلك الشهب وثورا نطح % % 14(@)(@@) % الأمر أدهى والذي غاب من % % شكوى الورى أكثر مما سنح % % 15(@)(@@) % سلت يد السعد على النحس من % % أهل الشقا سكينها فانذبح % % 16(@)(@@) % و ضاقت الأنفس من فرط ما % % يندف من رأس وقطن قزح % % 17(@)(@@) % و أبيض ذاك الطرف مما بكى % % وأزبد العواء مما نبح % % 18(@)(@@) % و انقصف الغصن فكم طائر % % ناح عليه بعد ما قد صدح % % 19(@)(@@) % كأنما البحر طفا ملحه % % فذره الأفق على ما جرح % % 20(@)(@@) % يا مدمل الجرح بألفاظه % % وناهيا 
ms100	 للدهر عما اجترح % % PageV01P457 21(@)(@@) % لله ما خائية خلدت % % في صفحة الدهر أجل الملح % % 22(@)(@@) % أقسمت لو وازنت الشمس في الم % % يزان دينار سناها رجح % % PageV01P458 البحر : - 1(@)(@@) % سلبت عقلي بأحداق وأقداح % % يا ساجي الطرف أو يا ساقي الراح % % 2(@)(@@) % سكران من قهوة الساقي ومقلته % % فاترك ملامك في السكرين يا صاحي % % 3(@)(@@) % و اطرح بعيشك أثقال الملام فما % % حملت وزري ولا كلفت إصلاحي % % 4(@)(@@) % دعني اذا صح نجمي في هوى قمري % % ببيت مالي أنشئ بيت أفراحي % % 5(@)(@@) % بجوهر الكأس يجلو لي بها عرضا % ظبي يفدى بأشباح وأرواح % % 6(@)(@@) % و فارسي من الأتراك تكملتي % % في نحو خديه قد صحت بإيضاح % % 7(@)(@@) % يردي الفوارس منه ملتقى رشاء % % باللحظ والقد سياف ورماح % % 8(@)(@@) % قلبي أبو طالب منه الوصال فما % % ينفك من نار شجو وسط ضحضاح % % 9(@)(@@) % يا مثري الخد بالمحمر من ذهب % دارك ضرورة محتاج ومجتاج % % 10(@)(@@) % يا فاضحي في اهوى خط بعارضه % % لقد نسخت على عشقي بفضاح % % PageV01P459 11(@)(@@) % ما أنس لا أنس لقيانا وقد غفلت % % عين الهوى عن قرير العين طماح % % 12(@)(@@) % قابلت شعرك بعد الوجه ملتفتا % فأنعم الله امسائي واصباحي % % 13(@)(@@) % حيث الرضى في جبين الصب مكتئب % % أيام لم يمح اسطار الصبي ماح % % 14(@)(@@) % و حامل الكأس تحت الدجن يعملها % % كأنه مدلج يمشي بمصباح % % 15(@)(@@) % و الغيم دان لكأس الراح يمزجها % % يكاد يمسكه من قام بالراح % % 16(@)(@@) % و الآن كاسي دموعي والتذكر إن % % أعي التذكر تشدو شدو مفصاح % % 17(@)(@@) % يا عنبر الخال في ريحان سالفه % % هل باب عيشي مسرور بمفتاح % % 18(@)(@@) % و هل إلى أرض مصر زورة لشج % بسائل من دموع الشوق ملحاح % % 19(@)(@@) % و هل أباكر بحر النيل منشرحا % فأشرب الحلو من أكواب ملاح % % 20(@)(@@) % و أشتكي النأي في باب العلاء إلى % % نعم الملي بأنجائي وإنجاحي % % PageV01P460 21(@)(@@) % ذاك الذي قال شعري أي ممتدح % % تدعو وقالت علاه أي مداح % % 22(@)(@@) % أما زمان علي مع شذا كلمي % % فقد تجانس نفاع بنفاح % % 23(@)(@@) % أغر طامي بحور الفضل ناسبها % % بغائص في بحور الشعر سباح % % 24(@)(@@) % من 