ms61	 الخليفة ذا عتزام % يذل لبأسه الخطب الجليل % 51(@)(@@) % إمام هذب الأيام رأي % له جزل ومعروف جزيل % 52(@)(@@) % ومد على البلاد جناح عدل % له ظل على الدنيا ظليل % 53(@)(@@) % أمير المؤمنين ومن إليه % مآثر كل مكرمة نؤول % 54(@)(@@) % حباه الله بالملك احتباء % وورثه خلافته الرسول % 55(@)(@@) % صفات لا يحيط بها بيان % ومجد لا تكيفه العقول % 57(@)(@@) % أبا بكر هناك جديد ملك % محالفه لك العمر الطويل % 58(@)(@@) % وجد ما لطائره وقوع % وسعد ما لطالعه أفول % PageV01P246 59(@)(@@) % ولا عدمت مواطنك التهاني % % وحل بربع طاعتك القيول % 60(@)(@@) % شكوتك قلة الإنصاف علما % بأنك منه لي كرما بديل % 62(@)(@@) % وإن قطعوا حبالهم جفاء % فأنت المحسن البر الوصول % 63(@)(@@) % عليك جلوتها غرا هجانا % أوانس في القلوب لها قبول % 65(@)(@@) % لها في قومها نسب عريق % إذا انتسبت وبيت حجى أصيل % 66(@)(@@) % فعماها المرعث و بن أوس % وجداها المبرد والخليل % 67(@)(@@) % مدائح مثل أنفاس الخزامى % % تمشت في نواحيها القبول % 68(@)(@@) % كما طرقت رياض الحزن وهنا % شآمية لها ذيل بليل % 69(@)(@@) % مفوهة إذا هدرت لنطق % شقاشقها تقاعست الفحول % 70(@)(@@) % تعز قناعة وتتيه صونا % وبعض الشعر ممتهن ذليل % PageV01P247 71(@)(@@) % وقبلك كنت أشفق أن يراها % % وقد مدت إليه يدا منيل % 72(@)(@@) % إذا أعيا على الكرماء مدحي % % فكيف يسومه مني البخيل % 73(@)(@@) % رأيت الشعر قالته كثير % عديدهم وجيده قليل % 74(@)(@@) % فلا تحدث لها مللا وحاشى % % علاك فغيرك الطرب الملول % PageV01P248 البحر : طويل 1(@)(@@) % سقاها الحيا من أربع وطلول % حكت دنفي من بعدهم ونحولي % % 2(@)(@@) % ضمنت لها أجفان عين قريحة % من الدمع مدرار الشؤون همول % 3(@)(@@) % لئن حال رسم الدار عما عهدته % فعهد الهوى في القلب غير محيل % 4(@)(@@) % خليلي قد هاج الغرام وشاقني % % سنا بارق بالأجرعين كليل % 5(@)(@@) % ووكل طرفي بالسهاد تنظري % % قضاء ملي بالديون مطول % 6(@)(@@) % إذا قلت قد أنحلت جسمي صبابة % تقول وهل حب بغير نحول % 7(@)(@@) % وإن قلت دمعي بالأسى فيك شاهد % تقول شهود الدمع غير عدول % 8(@)(@@) % فلا تعذلاني إن بكيت صبابة % على ناقض عهد الوفاء ملول % 9(@)(@@) % فأبرح ما 
ms62	 يمنى به الصب في الهوى % % ملال حبيب أو ملام عذول % 10(@)(@@) % ودون الكثيب الفرد بيض عقائل % لعبن بأهواء لنا وعقول % PageV01P249 11(@)(@@) % غداة لتقت ألحاظنا وقلوبنا % % فلم تخل إلا عن دم وقتيل % 12(@)(@@) % ألا حبذا وادي الأراك وقد وشت % برياك ريحا شمأل وقبول % 13(@)(@@) % وفي أبرديه كلما عتلت الصبا % % شفاء فؤاد بالغرام عليل % 14(@)(@@) % دعوت سلوا فيك غير مساعد % وحاولت صبرا عنك غير جميل % 15(@)(@@) % تعرفت أسباب الهوى وحملته % على كاهل للنائبات حمول % 16(@)(@@) % فلم أحظ من حب الغواني بطائل % سوى رعي ليل بالغرام طويل % 17(@)(@@) % أما تسأم الأيام ظلمي فتنقضي % % حقود تراءت بيننا وذحول % 18(@)(@@) % تلقيت منها كل بؤس ونعمة % وصاحبت في الحالين غير قليل % 19(@)(@@) % فلم يرتبط حبلي بغير مصارم % ولا اعتلقت كفي بغير بخيل % 20(@)(@@) % أضمن شكواي القوافي تعلة % وقد صنتها عن صاحب وخليل % PageV01P250 21(@)(@@) % مقيما وجرد الخيل ترقب نهضتي % % فشوس المطايا يقتضين رحيلي % % 22(@)(@@) % وليس حتمالي للأذى أن غاية % يقصر وخدي دونها وذميلي % % 23(@)(@@) % إلى كم تمنيني الليالي بماجد % رزين وقار الحلم غير عجول % 24(@)(@@) % أهز اختيالا في ذراه معاطفي % % وأسحب تيها في ذراه ذيولي % % 25(@)(@@) % لقد طال عهدي بالنوال وإنني % % لصب إلى تقبيل كف منيل % 26(@)(@@) % وإن ندى يحيى الوزير لكافل % بها لي وعون الدين خير كفيل % 27(@)(@@) % هو المرء لا ينفك صدر وسادة % لفصل القضايا أو إمام رعيل % 28(@)(@@) % جواد يبيت الوفد حول فنائه % بأكرم مثوى عنده ومقيل % 29(@)(@@) % إذا فلت البيض الرقاق وجدته % أخا عزمات غير ذات فلول % 30(@)(@@) % وتعنو له الحرب العوان لطول ما % % تحطم فيها من قنا ونصول % PageV01P251 31(@)(@@) % أشم هبيري المناسب يعتزي % % إلى خير بيت في أعز قبيل % 32(@)(@@) % من القوم لا راجي نداهم بخائب % ولا الجار في أبياتهم بذليل % 33(@)(@@) % إذا استصرخوا شنوا فضول دروعهم % على غرر وضاحة وحجول % 34(@)(@@) % فإن رفعت للحرب والجدب راية % رموها بأسد منهم وشبول % 35(@)(@@) % ثقال على الأعداء لا يستخفهم % نوازل خطب للزمان ثقيل % 36(@)(@@) % تراع صدور الخيل والليل منهم % بفتيان صدق رجح وكهول % 37 
ms63	(@)(@@) % فضلت بصيت سار في الأرض ذكره % ومجد منيف في السماء أثيل % 38(@)(@@) % ورأي كصدر السمهري مثقف % وعزم كمتن المشرفي صقيل % 39(@)(@@) % تخافك أطراف القنا فاهتزازها % % من الذعر لا من دقة وذبول % 40(@)(@@) % ومعترك ضنك المجال وموقف % زليق بأقدام الكماة زليل % PageV01P252 41(@)(@@) % صليت لظاه بارد القلب وادعا % كأنك منه في حمى ومقيل % 42(@)(@@) % وقتك الرقاق البيض لفح أواره % ويا رب ظل للسيوف ظليل % 43(@)(@@) % وأجريتها قب البطون كأنها % % تدافع سيل في قرار مسيل % 44(@)(@@) % فما اعتصمت منك الوعول بقلة % ولا متنعت منك الأسود بغيل % 45(@)(@@) % وسقت العدى سوق الرعاء ظوامئا % لورد من الموت الزؤام وبيل % 46(@)(@@) % فكل أبي في مقادة مصحب % وكل حرون في زمام ذلول % 47(@)(@@) % فلم يبق حي منهم غير موثق % ولا مطلق الكفين غير قتيل % 48(@)(@@) % فمن حر وجه بالصعيد معفر % وطرف كحيل بالتراب كحيل % 49(@)(@@) % دعوتك في اللأواء يا بن محمد % لنصري و ستنجدت غير خذول % 50(@)(@@) % فما أوضعت إلا إليك ركائبي % % ولا وضعت إلا لديك حمولي % % PageV01P253 51(@)(@@) % عدلت بها عن قائل غير فاعل % إلى رب جود قائل وفعول % 52(@)(@@) % كثير إذا قل الحباء حباؤه % وفي إذا عز الوفاء وصول % 53(@)(@@) % إلى بحر جود بالمواهب مزبد % وصوب حيا بالمكرمات هطول % 54(@)(@@) % وإني يا تاج الملوك لواثق % بسيب عطاء من نداك جزيل % 55(@)(@@) % وها أنا قد حملت مدحك حاجتي % % وحسبك ف نظر من جعلت رسولي % % PageV01P254 البحر : خفيف تام 1(@)(@@) % عد نصحا ملامي العذال % فمحال عنها السلو محال % 2(@)(@@) % أين مني السلو لا أين رعي العهد كلا كلاهما لا ينال % مال على ضع % 3(@)(@@) % في في الحب قده الميال % في الهوى لا بقلبك البلبال % 5(@)(@@) % كفلت أنني أذوب نحولا % في هواها الخصور والأكفال % 6(@)(@@) % وحبيب الإعراض حلو التجني % % فيه تيه معشق ودلال % 7(@)(@@) % عبدتني له وما كنت عبدا % صحة في جفونه واعتلال % 9(@)(@@) % حار طرفي فيه أبدر سماء % هو أم خوط بانة أم غزال % 10(@)(@@) % زارني موهنا تنم وشا % % حاه عليه ويكتم الخلخال % 12(@)(@@) % أعجلتني أناته حين أسرى % % و 
ms64	 ستخفت حلمي خطاه الثقال % 13(@)(@@) % بت أشكوا إليه غلة صدري % % وبفيه لو شاء عذب زلال % PageV01P255 14(@)(@@) % فحنا عاطفا مقيلا وكانت % عثرة الحب عنده لا تقال % 15(@)(@@) % وسقاني من كفه وثنايا % % ها وفيها من خده جريال % 17(@)(@@) % يا بعيد المثال غادرني طوعا % ق وفي فيك تضرب الأمثال % 18(@)(@@) % ب وقد طبق الثرى الإمحال % لك والحسن شاهد والجمال % 19(@)(@@) % عهدة في يديك منها بأن صر % ت أميرا عليهم إسجال % 21(@)(@@) % ألوفيون بالعهود إذا الأخلا % % ف آبت منها القوى والحبال % 23(@)(@@) % في ظهور الجياد منهم أسود % وصدور الدسوت منهم جبال % 25(@)(@@) % نهضات يوم الجلاد خفاف % وحلوم يوم الجدال ثقال % 27(@)(@@) % لقحت عنده الأماني وعهدي % % بأماني الصدور وهي حيال % 31(@)(@@) % شاب مع غرة الحداثة رأيا % واعتزاما فتم وهو هلال % PageV01P256 32(@)(@@) % سار سير السحاب في الناس جدوا % % ه فمنه في كل أرض سجال % 42(@)(@@) % يا أبا نصر المرجى إذا لم % % يبق خلق يرجى لديه النوال % 46(@)(@@) % فأعني بجبة أشهد الحر % ب بها قبل أن يجد القتال % 48(@)(@@) % لا عدت ربعك التهاني ولا زا % % ل منيخا ببابك الإقبال % 49(@)(@@) % وهنا الناس عيدهم بك فالنا % % س على جود راحتيك عيال % 50(@)(@@) % بالغا في غصون دوحتك ال % غناء أقصى ما تنتهي الآمال % 51(@)(@@) % تتقي زأرك الأسود وتستأ % سد من حول غيلك الأشبال % 52(@)(@@) % في بقاء لا يقتضيه انقضاء % ونعيم لا يعتريه زوال % PageV01P257 البحر : كامل تام 1(@)(@@) % أتظنني ما عشت أنعم بالا % % هيهات ظل العيش بعدك زالا % % 2(@)(@@) % غادرتني غرض النوائب ألتقي % % منها بصدري أسهما ونصالا % % 3(@)(@@) % وحدي على أن الرجال كثيرة % حولي وما كل الرجال رجالا % 4(@)(@@) % أنا رهن مظلمة بحفرتك التي % % ضاقت فلا ضاقت عليك مجالا % % 5(@)(@@) % متوجع وجل وأنت بمعزل % أن تعرف الأوجاع والأوجالا % 6(@)(@@) % جاوزت من يجفو الصديق وأنت في % % دار تجاور منعما مفضالا % % 7(@)(@@) % فلو طلعت علي يا ابن محمد % لعلمت أني منك أسوأ حالا % % 8(@)(@@) % ما لي وللسراء بعد معاشر % صدقوا هوى فتقاربوا آجالا % 9(@)(@@) % زهر أودع كل يوم منهم % قمرا وأودع في 
ms65	 الصعيد هلالا % 10(@)(@@) % إخوان صدق شردوا بفرقهم % نومي وكانوا للسرور عقالا % PageV01P258 11(@)(@@) % كانوا الأسود مهابة وحمية % والسحب جودا والبدور كمالا % 12(@)(@@) % نزلوا الهواجر بالقواء وعطلوا % % جنات عدن دونها وظلالا % 13(@)(@@) % ونأت بهم دار النعيم فأزمعوا % % عنها إلى دار البلا ترحالا % % 14(@)(@@) % ورماهم بصوائب من كيده % ريب الزمان فزلزلوا زلزالا % 15(@)(@@) % ودعتهم رسل المنون فأوجفوا % % يتتابعون إلى الردى أرسالا % % 16(@)(@@) % فكأنهم ظنوا الحمام دعاهم % لملمة فمشوا إليه عجالا % 17(@)(@@) % بأبي وجوههم النواضر عزها % % أمسى برغمي في التراب مذالا % 18(@)(@@) % بانوا وأبقوا في ضلوعي زفرة % ترقى وملء جوانحي بلبالا % 19(@)(@@) % يذكي ضرام النار منها شعلة % ماء الدموع تزيدها إشعالا % % 20(@)(@@) % سكنوا الثرى ورجعت أسأل عنهم الآثار لو كانت تجيب سؤالا % % ر لو كانت تجيب سؤالا % PageV01P259 21(@)(@@) % هم خلفوني بعدهم ذا حيرة % أبكي الرسوم وأندب الأطلالا % 22(@)(@@) % لم تقنع الأيام لا قنعت بأن % نسفت بحورا منهم وجبالا % 23(@)(@@) % حتى رمتني في الوزير بحادث % عز العزاء علي فيه منالا % % 24(@)(@@) % كرت علي فأجهرت بمصاب من % ترك الدموع مصابه أوشالا % 25(@)(@@) % من كان للإسلام مجدا باذخا % ولمنصب الدينش الحنيف جلالا % % 26(@)(@@) % قرن إذا غتصت مجالسه شفا % % بعطائه وبيانه السؤالا % % 27(@)(@@) % ضلال أو أسترفد البخالا % أعطى ولا حصر إذا ما قالا % 28(@)(@@) % قد كنت أطرد كل هول باسمه % حتى ركبت بموته الأهوالا % 29(@)(@@) % أردى جلال الدين خطب طال ما % % أردى الملوك ودوخ الأقيالا % % 30(@)(@@) % خطب يزيل عن الفرائس أسدها % % ويزل عن هضباتها الأوعالا % PageV01P260 31(@)(@@) % أودى فكادت أن تميل بأهلها % % أرض توسد تربها إجلالا % % 32(@)(@@) % إن رابه ريب المنون فقبله % هجم الحمام على الكرام وغالا % 33(@)(@@) % لله أي عباب بحر غاض يو % % م ثوى وأي عماد فخر مالا % % 34(@)(@@) % من يكشف الغماء إن نزلت ومن % يمسي لكل عظيمة حمالا % 35(@)(@@) % من يلبس السرد المضاعف في الوغى % % والحمد في يوم الندى سربالا % % 36(@)(@@) % من للقروم البزل يصدقها إذا % % سألت قراعا بالقنا ونزالا % % 37(@)(@@) % ولذبل تحت العجاج كأنما % % أرفعن من خرصانها ذبالا % 38(@)(@@) % من يخمد الحرب العوان بناره % يردي 
ms66	 الكماة ويحطم الأبطالا % % 39(@)(@@) % من للمغيرات الجياد يردها % % طردا على أعقابها جفالا % 40(@)(@@) % يبتزها الآساد من صهواتها % % غلبا وتلبسها الدماء جلالا % PageV01P261 41(@)(@@) % من يمتطيها كالذئاب عوابسا % قبا ويوطئها القنا العسالا % 43(@)(@@) % والبيض يختلس النفوس بهن إر % هاقا وتختطف العيون صقالا % 44(@)(@@) % من للمالك والرعايا سائسا % هيهات ضاعوا بعده إهمالا % % 45(@)(@@) % من للفتاوى والمسائل أشكلت % فيزيل عنها اللبس والإشكالا % % 47(@)(@@) % من للوفود تبيت حول فنائه % عصبا فيوسعهم قرى ونولا % 48(@)(@@) % من للمهاري القود أنحلها السرى % % حطت بساحته الرحال كلالا % 49(@)(@@) % من للغريب نبت به أوطانه % فأصاب أهلا من نداه وآلا % 50(@)(@@) % من لليتامى والأرامل ملجأ % تأوي إليه وعصمة ومآلا % % 51(@)(@@) % أودى أبو الفقراء فليبكوا أبا % % من جوده كانوا عليه عيالا % % 52(@)(@@) % أأبا المظفر كنت لي من عسرتي % % مآلا ومن جور الخطوب مآلا % % PageV01P262 53(@)(@@) % مازلت عونا في الحوادث لي إذا % % ضعفت يمين أن تعين شمالا % % 54(@)(@@) % ما بال ود في الزمان ذخرته % لشدائدي أمسى علي وبالا % % 55(@)(@@) % وملابسا من غبطة ألبستني % % جددا علام أعدتها أسمالا % 56(@)(@@) % ومبشراتك كيف عدن سمائما % هوجا وكن على القلوب شمالا % 57(@)(@@) % سلبت تجملها عليك وزارة % لبست بملكك رونقا وجمالا % 58(@)(@@) % يبكي لفقدك دستها ولقلما % % كانت تبكي غابة ريبالا % % 59(@)(@@) % يا موردي ماء الدموع ولم يزل % وردي نميرا تحمل الأثقالا % % 60(@)(@@) % أمسكت عن رد الجواب وطالما % % جادلت فرسان الكلام جدالا % % 61(@)(@@) % وقطعت آمال العفاة ولم تكن % لك شيمة أن تقطع الآمالا % 62(@)(@@) % وأعدت أيامي الحوالي بالأسى % % عطلا وليلاتي القصار طوالا % % PageV01P263 63(@)(@@) % ورزئت منك بهمة علوية % أحرزت منها الفضل والإفضالا % 65(@)(@@) % لم يسكن الأعداء من فرق بها % % حتى سكنت جنادلا ورمالا % 66(@)(@@) % وحللت بالبيداء منزل وحشة % وهجرت منزل غبطة محلالا % 68(@)(@@) % أرضى الحيا المدرار تربك من فتى % أرضى العفاة وأسخط العذالا % % 69(@)(@@) % وهمى عليك بمثل كفك ثرة % وسقاك خلقك باردا سلسالا % 70(@)(@@) % بسحائب قد كنت تسحب عزة % وجلالة من فوقها الأذيالا % % 73(@)(@@) % وليجعلن الدمع بعدك دأبه % والحزن ما امتد الزمان وطالا % % 75(@)(@@) % مكارة غرارة غدارة % كلفت دنياك الغدور محالا 
ms67	 % 76(@)(@@) % لا تخدعن بثروة وشبيبة % وارقب لأيام السرور زوالا % % PageV01P264 البحر : متقارب تام 1(@)(@@) % أطلت وقوفي على بابكم % وما كان لي منكم طائل % 2(@)(@@) % وأصبح بي مجدكم حاليا % وجيدي من رفدكم عاطل % 3(@)(@@) % وما زال ينصرني خاطري % % فأحسن والحظ لي خاذل % 4(@)(@@) % وكم قد أتتني من سخطكم % صواعق ما بعدها وابل % 5(@)(@@) % ولي فيكم مدح كالرياض % باكرها العارض الهاطل % 6(@)(@@) % تناقلها في البلاد الرواة % وعندكم ذكرها خامل % 7(@)(@@) % ومن عجب أن تثاب الرواة % عليها وقد حرم القائل % PageV01P265 البحر : متقارب تام 1(@)(@@) % فمن شبه العمر كأسا يقر % قذاه ويرسب في أسفله % 2(@)(@@) % فإني القذا طائفا % على صفحة الكأس في أوله % PageV01P266 البحر : سريع 1(@)(@@) % خلوا ملامي في هجاء امرئ % يصلح بعد الذبح للخل % 2(@)(@@) % لا تعجلوا إن العجيل الذي % % أطلتم من أجله عذلي % % 3(@)(@@) % عار من الإحسان والحسن بل % خال من الإفضال والفضل % 4(@)(@@) % قولوا له يا أجهل الناس إذ % أفاض في جد وفي هزل % 5(@)(@@) % قد عبد العجل فلا غرو أن % يعولوا منك على عجل % 6(@)(@@) % ولاية تهت بها بعد في القوة لم تخرج إلى الفعل % قوة لم تخرج إلى الفعل % 7(@)(@@) % قلدت منها يوم قلدتها % % نيابة غمدا بلا نصل % 8(@)(@@) % فهي وما أنت بأهل لها % % في غير أوطان ولا أهل % 9(@)(@@) % لم ترتضع درتها أو رما % % ها الله في الأولاد بالثكل % 10(@)(@@) % مذ نبت فيها لم توفق بحمد % الله في قول ولا فعل % PageV01P267 11(@)(@@) % فلا يغرنك أن لان في % % كفك منها ملمس الصل % PageV01P268 البحر : كامل تام 1(@)(@@) % يا رب كيف بلوتني بعصابة % ما فيهم فضل ولا إفضال % 2(@)(@@) % متنافري الأوصاف يصدق فيهم ال % هاجي وتكذب فيهم الآمال % 3(@)(@@) % غطى الثراء على عيوبهم وكم % من سوءة غطى عليها المال % 4(@)(@@) % جبناء ما ستنجدتهم لملمة % لؤماء ما استجديتهم بخال % 5(@)(@@) % فوجوههم عود على أموالهم % وأكفهم من دونها أقفال % 6(@)(@@) % هم في الرخاء إذا ظفرت بنعمة % آل وهم عند الشدائد آل % PageV01P269 البحر : كامل تام 1(@)(@@) % أبني أسامة كم تدوم مواتاة % اة الزمان لكم وكم 
ms68	 تملي % % 2(@)(@@) % لا كان دهر عشتم زمنا % فيه ولاة العقد والحل % 3(@)(@@) % لا تنكروا يقظات دهركم % كم يستمر بكم على الجهل % 4(@)(@@) % سدتم بلا حلم ولا كرم % فيكم ولا أدب ولا عقل % 5(@)(@@) % وفضلتم أهل الزمان بعد % واكم ولستم من ذوي الفضل % 6(@)(@@) % فعلمت حين رأيت شأنكم % يعلو بلا حسب ولا أصل % 7(@)(@@) % أن الزمان يعيد فكرته % فيكم فيسلك منهج العدل % 8(@)(@@) % فيخر عن كثب بناؤكم % وكذاك ما يبنى على الرمل % PageV01P270 البحر : بسيط تام 1(@)(@@) % مولاي يا من له أياد % ليس إلى عدها سبيل % 2(@)(@@) % ومن إذا قلت العطايا % % فجوده وافر جزيل % 3(@)(@@) % إليه إن جارت الليالي % % نأوي وفي ظله نقيل % 4(@)(@@) % إن كميتي العتيق سنا % له حديث معي طويل % 5(@)(@@) % كان شراي لرحلي % % فخاب ظني فيه الجميل % 6(@)(@@) % ولم أخل للشقاء أني % % لثقل أعبائه حمول % 7(@)(@@) % فإن أكن عاليا عليه % فهو على كاهلي ثقيل % 8(@)(@@) % أرحل كالبوم ليس فيه % خير كثير ولا قليل % 9(@)(@@) % ليس له مخبر حميد % ولا له منظر جميل % 10(@)(@@) % وهو حرون وفيه بطؤ % فلا جواد ولا ذلول % PageV01P271 11(@)(@@) % لا كفل معجب لراء % إذا رآه ولا تليل % 12(@)(@@) % مقصر إن مشى ولكن % إن حضر الأكل مستطيل % 15(@)(@@) % وليس فيه من المعاني % % شيء سوى أنه أكول % 16(@)(@@) % فهب له أنت ما تسنى % % وهبه من بعض ما تنيل % 17(@)(@@) % ولا تقل إن ذا قليل % فالجل في عينه جليل % PageV01P272 البحر : كامل تام 1(@)(@@) % يا مهدي الورد الجني لنا % % جريا على عاداته الأول % 2(@)(@@) % إن الزمان رمى وليكم % في مقلتيه بحادث جلل % 3(@)(@@) % فمتى يسر بمنظر حسن % والحظ عند الحسن للمقل % 4(@)(@@) % أهديتها مثل الخدود خدود % البيض قد دميت من الخجل % 5(@)(@@) % حسناء جاءت من ملابسها % % مختالة في أحسن الحلل % 6(@)(@@) % في غير موسمها وقد ذهبت % أيامها والدهر ذو دول % 7(@)(@@) % فكأنها كانت قد نفردت % عن جنسها تمشي على مهل % 8(@)(@@) % لم أحظ منها وهي حاضرة % عندي بغير الشم والقبل % 9(@)(@@) % فعرفت عرفك من روائحها % % وفهمت منها حسن رأيك لي 
ms69	 % % 10(@)(@@) % كم من يد لك لست أنكرها % % مشكورة أمثالها قبلي % % PageV01P273 11(@)(@@) % عذراء يضعف عن تحملها % % شكري كما يقوى بها أملي % % 12(@)(@@) % أذكرتني عصر الشباب بها % % ومواسم الأفراح والجذل % 13(@)(@@) % أيام لا أرعي لعاذلة % سمعي ولا أصغي إلى العذل % 14(@)(@@) % فاليوم عود الدهر محتطب % ذاو وشمس العمر في الطفل % 15(@)(@@) % لم يبق لي في لذة أرب % أنا من زحام الهم في شغل % 16(@)(@@) % أبكي على الدنيا وبهجتها % % وعلى قتراب مسافة الأجل % 17(@)(@@) % ف سحب ذيول سعادة فضلا % % في ظل عيش ناعم خضيل % PageV01P274 البحر : متقارب تام 1(@)(@@) % ألا يا أبا الفرج الأريحي % ويا من بجود يديه المثل % 2(@)(@@) % ويا من فكاهته للجليس % أنس وفاكهة لا تمل % 3(@)(@@) % بعثت به كخدود الحسان % سفرن فنقبهن الخجل % 4(@)(@@) % نقيا كعرضك قد أذكيت % كنار ذكائك فيه شعل % 5(@)(@@) % تراءت لنا تحت أوراقه % وجوه العذارى وراء الكلل % 6(@)(@@) % فغرت على حسنه أن ينال % منه بغير لحاظ المقل % 7(@)(@@) % وشبهته كف مهديه لي % % فما يصلحان لغير القبل % PageV01P275 البحر : رجز تام 1(@)(@@) % يا ابن الدوامي الذي % % صاب نداه وهطل % 2(@)(@@) % يا من إذا داوى شفا % % ومن إذا أدوى قتل % 3(@)(@@) % مختلف الطعمين في % % يوميه صاب وعسل % 4(@)(@@) % أهديت للقلب بما % % أهديت أنسا وجذل % 5(@)(@@) % هدية مثل العذارى % % رفعت عنها الكلل % 6(@)(@@) % أو كخدود الغانيا % % ت دميت من الخجل % 7(@)(@@) % كأنها رقراق ماء % في نواحيه شعل % 8(@)(@@) % كأنه من عرفك ال % فائح في الناس حتمل % 9(@)(@@) % كأنه من لطفه % على معانيك اشتمل % 10(@)(@@) % كأنه كفك لا % يصلح إلا للقبل % PageV01P276 البحر : رجز تام 1(@)(@@) % قوادة فارهة % لطيفة التوصل % 2(@)(@@) % تهوي إلى أغراضها % % مثل هوي الأجدل % 3(@)(@@) % لو شهدت صفين أو % وقعة يوم الجمل % 4(@)(@@) % توصلت في الصلح ما % % بين ابن هند وعلي % % 5(@)(@@) % وأصبحت عائشة % عن حربه بمعزل % PageV01P277 البحر : رجز تام 1(@)(@@) % يا رب بكر عاتق % حطت إلينا من عل % 2(@)(@@) % من حجر أم خدرها % % دون السماك الأعزل % 3(@)(@@) % مطعمة ضيوفها % % في كل عام ممحل % 4(@)(@@) % وطالما ديست على % % علوها بالأرجل 
ms70	 % 7(@)(@@) % لو لم يساعده أخ % من أمها لم تحصل % 8(@)(@@) % جاء بها عذراء حب % لى كالجراب الممتلي % % 9(@)(@@) % عاطلة كأنها % % ذراع خود عيطل % 10(@)(@@) % في حلة خفيفة % تروق عين المجتلي % % 11(@)(@@) % فشقها واستلها % % من غمدها كالمنصل % 12(@)(@@) % ف بتسمت عن لؤلؤ % في السلك لم ينفصل % PageV01P278 13(@)(@@) % كأنها إذ برزت % بيضاء كالسجنجل % 14(@)(@@) % سبيكة من فضة % في سفط من صندل % PageV01P279 البحر : مجتث 1(@)(@@) % بمن أباحك قتلي % % علام حرمت وصلي % % 2(@)(@@) % وما أرابك حتى % % صرمت بالهجر حبلي % % 3(@)(@@) % عذبت قلبي بجد % من الصدود وهزل % 4(@)(@@) % أنفقت فيك دموعي % % والدمع جهد المقل % 5(@)(@@) % أتعبت نفسك يا عا % % ذلي عليه بعذلي % % 6(@)(@@) % كيف السلو وقلبي % % رهن لديه وعقلي % % 7(@)(@@) % بليت بالحب منه % بظالم مستحل % 8(@)(@@) % بمثل وجدي عليه % مات المحبون قبلي % % PageV01P280 البحر : رمل تام 1(@)(@@) % كل يوم لك بين واحتمال % وبعاد عن حبيب وزيال % 2(@)(@@) % ووقوف في مغان درس % بان أهلوها وأطلال خوال % 3(@)(@@) % ما لليلات تقضت بالحمى % % مقمرات سبقت تلك الليال % 4(@)(@@) % قصرت أمس مع الوصل لنا % % وهي اليوم مع الهجر طوال % 5(@)(@@) % حيث حيران الغضا لي جيرة % والنوى ما خطرت منا ببال % PageV01P281 البحر : كامل تام 1(@)(@@) % قولا لمن أبدى بلا سبب % حربي وقطع بالجفا حبلي % % 2(@)(@@) % أوردتني ورد السقام فلم % خلأتني عن بارد الوصل % 3(@)(@@) % يا قائلي فاجهد لما بك بي % % كفارة لجريمة القتل % 4(@)(@@) % فلقد جعلتك من حرام دمي % % إن زرتني في أوسع الحل % 5(@)(@@) % يا صاحبي في كل نائبة % ومشاركي في الكثر والقل % 6(@)(@@) % ناشدتك الود الصريح إذا % % وسدت في جدث من الرمل % 7(@)(@@) % ونويت بالبيداء منفردا % نأيا عن الخلطاء والأهل % 8(@)(@@) % فأذل على قبري الدموع وقل % هذا صريع الأعين النجل % PageV01P282 البحر : طويل 1(@)(@@) % سقى منزلا بين الشقيقة والضال % جنا كل سحاح من المزن هطال % 2(@)(@@) % وحيا رسوم العامرية باللوى % % تحية لا سال هوها ولا قال % 3(@)(@@) % ولما وقفنا بالديار بدت لنا % % أوابد من حيران وحش وآجال % 4(@)(@@) % فما خدعتنا عن حوال أوانس % بنافرة من وحش وجرة معطال % 5(@)(@@) % ألا 
ms71	 حبذا بالبان مغنى وملعب % عصيت به عصر البطالة عذالي % % 6(@)(@@) % فكائن لنا من وقفة في ظلاله % ومن غدوات موبقات وآصال % 7(@)(@@) % وهل تشتكي الأوطان عمن تحبه % وما نفع آثار خوال وأطلال % 8(@)(@@) % وكيف تسلينا بقضبان إسحل % وأحقاف رمل عن قدود وأكفال % 9(@)(@@) % ليالي عود اللهو فينان مورق % وورد الهوى صفو وجيد الصبي حال % 10(@)(@@) % فلله ثوب من شباب سلبته % وغودرت في ثوب من الشيب أشمال % PageV01P283 11(@)(@@) % صحبت زماني وادع البال قلما % % خطرت لهم أو لبؤس على بال % 12(@)(@@) % جديد سرابيل الشبيبة رافلا % من العيش في ضافي المساحب ذيال % 13(@)(@@) % وها أنذا من بعد أمن وصحة % مسامر أوجاع مشاور أوجال % 14(@)(@@) % أرقع عمرا أخلقته بكرها % % الليالي إلى كم يرقع الخلق البالي % % 15(@)(@@) % عزفت عن الدنيا فما أنا طامح % بطرفي إلى وفر عداني ولا مال % 16(@)(@@) % وأعرضت عنها غير مكترث لها % % وسيان إكثاري لدي وإقلالي % % 17(@)(@@) % ولم يبق لي عند الليالي لبانة % كأني قد ماتت مع الشيب آمالي % % 18(@)(@@) % فلست أبالي اليوم كيف تقلبت % على عقب الأيام والدهر أدوالي % % 19(@)(@@) % ولولا زمان أخرتني صروفه % لطارت برحلي كل هوجاء مرقال % 20(@)(@@) % أجشمها الأخطار في غسق الدجى % % وأقذفها رأد الضحى لجج الآل % PageV01P284 21(@)(@@) % وما كنت أرضى بالقعود وإنما % % خطوب رمتني من أذاها بأهوال % 22(@)(@@) % وإني من جود الوزير لواثق % بأن سيريش اليوم ما نحط من حالي % % 23(@)(@@) % فيبسط آمالي وينهض عثرتي % % ويغرم ما قد فات من زمني الخالي % % 24(@)(@@) % سأجعله لي عدة وذخيرة % أعز به والعز خير من المال % 25(@)(@@) % أصون به عرضي وأمنع جانبي % % ومثل جلال الدين من صان أمثالي % % 26(@)(@@) % وإن طرقتني في الزمان ملمة % نزلت بحاجاتي عليه وأثقالي % % 27(@)(@@) % فأسرح في روض السماح ركائبي % % وأسحب في ربع المكارم أذيالي % % 28(@)(@@) % وعند عبيد الله ما اقترحته % على الدهر من فضل عميم وإفضال % 29(@)(@@) % وزير كسا دست الوزارة بهجة % وكان زمانا عاطلا جيدها الحالي % % 30(@)(@@) % وقام بتدبير الأمور فلم يبت % به بين تضييع يخاف وإهمال % PageV01P285 31(@)(@@) % لئن غبرت حينا من الدهر حائلا % لقد 
ms72	 طرقت بعد الحيال برئبال % 32(@)(@@) % بأغلب مسبوح الذراعين باسل % يزلزل أقدام العدى أي زلزال % 33(@)(@@) % يخوض سواد النقع والبيض شرع % بأيدي مغاوير كماة وأبطال % 34(@)(@@) % هو الذائد الحامي إذا شتجر القنا % % وإن صوحت سنهاء فالهانىء الطالي % % 35(@)(@@) % هو المتبع القول الفعال تكرما % وما كل قوال سواه بفعال % 36(@)(@@) % له عمل بالعلم يزداد زينة % ويا رب ذي علم وليس بعمال % 37(@)(@@) % بلاه أمير المؤمنين فلم يكن % بمنحرف عن منهج الحق ميال % 38(@)(@@) % وحمله أعباءه فأقلها % % بكاهل عزم للعظائم حمال % 39(@)(@@) % ليهنكم يا قالة الشعر أنكم % نزلتم على عذب الموارد سلسال % 40(@)(@@) % وأنكم بعد الإياس سقيتم % ظماء بنوء من عطاياه مفضال % PageV01P286 41(@)(@@) % فأثريتم من بعد دهر وضيقة % وأخصبتم من بعد جدب وإمحال % 42(@)(@@) % غنيتم به عن جوب كل تنوفة % بكل المطايا بين حل وترحال % 43(@)(@@) % وعن برم ما زال يبرم بالندى % % ويشغله المدح الرخيص عن الغالي % % 44(@)(@@) % وذي شنآن مشرجات ضلوعه % على الغل مطبوع على الغدر محتال % 45(@)(@@) % بنا بغرور أمره فكأنما % % بناه على حقف من الرمل منهال % 46(@)(@@) % ولم يدر أن الدهر تجري صروفه % وأن الليالي لا تدوم على حال % 47(@)(@@) % فأعمل رأيا كان فيه وباله % وأوقد نارا عاد وهو لها صال % 48(@)(@@) % وغرته من حسن ارتيائك ونية % ويا رب إبطاء كفيل بإعجال % 49(@)(@@) % وما تركك الأعداء بقيا عليهم % ولكنه ترك جتياز وإهمال % 50(@)(@@) % تمليتها من خلعة ناصرية % تسربلت منها اليوم أفضل سربال % PageV01P287 51(@)(@@) % فممزوجة وشي بها من ضيائها % % شعاع كبرق الشمس كاشفة البال % 52(@)(@@) % ودراعة من تحتها وعمامة % سوادهما في وجنة الدهر كالخال % 53(@)(@@) % وإبيض حال بالنضار مهند % عتاد ملوك أورثوه وأقيال % 54(@)(@@) % لص النجار كريم ال % جد والعم والخال % 55(@)(@@) % تسر بمرآه العيون كأنه % عقيلة خدر كاعب ذات خلخال % 56(@)(@@) % يمر على وجه الثرى فتخاله % تدفق رقراق من الماء سلسال % 57(@)(@@) % تبختر محتوما إليك وإنه % لمشي دلال لا تبختر إدلال % 58(@)(@@) % يتيه بسرج عسجدي كأنما % % هلالان منه في المقدم والتالي % % 59(@)(@@) % وليس كما ظنوه مركوب زينة % ولكنه مركوب عز 
ms73	 وإجلال % 60(@)(@@) % ومثقلة بالحلي سوداء حرة % عراقية بحرية أم أطفال % PageV01P288 61(@)(@@) % إذا ما درجن حولها يرتضعنها % % جرين بأرزاق تدر وآجال % 62(@)(@@) % فمن حاسر يخشاه كل مدجج % ومن صامت يزري على كل قوال % 63(@)(@@) % ومن مرهفات الحد تهزأ بالظبى % % ويفرق منها كل أسمر عسال % 64(@)(@@) % ومشترف من نسل أعوج خا % % وكائن لديها من وفود وسؤال % 65(@)(@@) % فهنئتها يابا المظفر رتبة % تبوأت منها مرقب الشرف العالي % % 66(@)(@@) % ولا زال معقولا بسيفك شارد الممالك موسوما به بعد إغفال % الممالك موسوما به بعد إغفال % 67(@)(@@) % ولا عدمت أذوادها وسروحها % % قبائل من راع عليها ومن وال % 68(@)(@@) % ومليت عيدا موذنا بوفوده % عليك بأعوام تكر وأحوال % 69(@)(@@) % إذا خلقت أثوابه وبروده % فغير بعز مستجد وإقبال % PageV01P289 البحر : كامل تام 1(@)(@@) % ولقد مدحتك يا بن نصر مدحة % ما كنت ترجو مثلها وتؤمل % 2(@)(@@) % وفتحت بابا من ودادك ليته % مستغلق بيني وبينك مقفل % 3(@)(@@) % ونظمت فيك من الثناء قلائدا % ستر الملوك بمثلها يتجمل % 4(@)(@@) % ونزعت من خدري إليك عقيلة % كانت يداي بها تضن وتبخل % 5(@)(@@) % ورضيت حرانا لها دارا وكم % حامت فما وصلت إليها الموصل % 6(@)(@@) % ورجوت أن تندى صفاتك لي فما % % رشح الحديد ولا ستلان الجندل % 7(@)(@@) % جاءتك رائعة الجمال كريمة ل % أعراق مهدي مثلها لا يخجل % 8(@)(@@) % فنبذتها من راحتيك وإنها % % في الذب عن عرض الكريم لمنصل % 9(@)(@@) % وغفلت عنها معرضا ووراءها % % مني حمية والد لا يغفل % 10(@)(@@) % ورميتها بالصد منك وما رما الشعراء بالإعراض يوما مقبل % شعراء بالإعراض يوما مقبل % PageV01P290 11(@)(@@) % فغدت مضيعة لديك قليلة ل % أنصار لا تدري بمن تتوسل % 12(@)(@@) % ف ردد مطلقة إلي مدائحي % % فطلاق من هو غير كفؤ أجمل % 13(@)(@@) % فسأقبلن بها على متبلج % كرما عليها بالمودة يقبل % 14(@)(@@) % طلق الأسرة باسم لعفاته % تعطي يداه ووجهه يتهلل % 15(@)(@@) % ولأنزلن وإن رغمت على نظام % الحضرتين بها ونعم المنزل % PageV01P291 البحر : سريع 1(@)(@@) % قضيت شطر العمر في مدحكم % ظنا بكم أنكم أهله % 2(@)(@@) % وعدت أفنيه هجاء لكم % فضاع فيكم عمري كله % PageV01P292 البحر : مجزوء الكامل 1 
ms74	(@)(@@) % بستان جعفر مثله % في ظرفه وشمائله % 2(@)(@@) % والبركة الفيحاء تخ % جل من نداه ونائله % 3(@)(@@) % فيه الأنابيب التي % % تنهل مثل أنامله % 7(@)(@@) % والغيم قد صدقت كوا % % ذب برقه ومخائله % 11(@)(@@) % زلرب يوم قد وهبت % الحق فيه لباطله % 12(@)(@@) % وشريت عاجل ما حتض % رت من السرور بآجله % 13(@)(@@) % فتشابهت حسنا أوا % % خر يومنا بأوائله % PageV01P293 البحر : كامل تام 1(@)(@@) % لو أن قلبك مثل قلبي مغرم % لم يثن عطفك ما تقول اللؤم % 2(@)(@@) % لكن عدتك صبابتي فأطعتهم % شتان خال قلبه ومتيم % 3(@)(@@) % عودي مريضا في يديك شفاؤه % إشفي وأنت بما يكابد أعلم % 4(@)(@@) % أو فاحسمي شكواه من داء الهوى % % إن كان داء هواك مما يحسم % 5(@)(@@) % ولقلما وجد المريض لدائه % برءا إذا كان الطبيب المسقم % 6(@)(@@) % ووراء ما يبدو لعينك من ضنى % وجد بأثناء الضلوع مكتم % 7(@)(@@) % إن كنت يقظى بالسلام بخيلة % فمري الخيال يمر بي فيسلم % 8(@)(@@) % وعدي بوصلك في المنام لعلها % % ترجو لقاءك مقلتي فتهوم % 9(@)(@@) % أعرضت عن شيبي وأنت جنيته % نفسي الفداء لمجرم يتجرم % 10(@)(@@) % إما نريني جاثما فلطالما % % ركضت أنجد في البلاد وأتهم % PageV01P294 11(@)(@@) % وجررت ذيل شبيبتي وخلاعتي % % وأسمت خيل بطالتي لا أسأم % 12(@)(@@) % فاليوم وجه مطالبي فدون ما % % أرجوه منها باب بأس مردم % 13(@)(@@) % ولئن رمينني الخطوب بمقصد % من صرفهن فللنوائب أسهم % 14(@)(@@) % أو أخرتني الحادثات ولم أزل % بفضائلي وخصائصي أتقدم % 15(@)(@@) % فالدهر لا شكرت مساعيه بتأ % خير الفضائل مستهام مغرم % 16(@)(@@) % دهر رماني في قرارة منزل % ضنك نهاري فيه ليل معتم % 17(@)(@@) % ليلي به ليل السليم وإنني % % للهم والبرجاء فيه لمسلم % 18(@)(@@) % متهضما فضلي الأبي ولم يكن % لولا الزمان وغدره يتهضم % 19(@)(@@) % فمتى يقوض راحلا عن ساحتي % % هم علي بما ينوء مخيم % 20(@)(@@) % أنا يا زماني إن تطأ من منكبي % % ضرعا لظلمي من خطوبك أظلم % PageV01P295 21(@)(@@) % هيهات لا يعبا بحمل عظيمة % من كان ناصره الإمام الأعظم % 22(@)(@@) % الناصر المنصور جيش لوائه % ومعاطس الأعداء جدع رغم % 23(@)(@@) % نصرته أملاك السماء فمردف % منهم يقاتل دونه ومسوم % 24(@)(@@) % الخاشع الأواب 
ms75	 يقدم حاسرا % في الروع وهو عن المحارم محجم % 25(@)(@@) % لا يرتضي لبس الحديد بسالة % فكأنه لبس الحديد محرم % 26(@)(@@) % فعتاده عضب المضارب باتر % وأصم عسال وأجرد شيظم % 27(@)(@@) % رأي يفل البيض وهي حدائد % وسطى ترد الجيش وهو عرمرم % 28(@)(@@) % يصلي الأعادي نار كل كريهة % يشوي الوجوه حريقها المتضرم % 29(@)(@@) % وبحبهم يرجو الشفاعة مجرم % زجل الكماة وصوب عارضها الدم % 30(@)(@@) % فزمانهم بالرعب منه ليلة % ليلاء أو يوم عبوس أيوم % PageV01P296 31(@)(@@) % فالبيض تغمد في المفارق والطلى % % والسمهرية في الضلوع تقوم % 32(@)(@@) % ورث النبوة منبرا وخلافة % وتقية فعليه منها ميسم % 33(@)(@@) % فلمنكب ولعاتق ولخنصر % منه ثلاث قدرهن معظم % 34(@)(@@) % برد وسيف لا يفل وخاتم % فمجلبب ومقلد ومختم % 36(@)(@@) % فالرفد تبسطه يد مبسوطة % والجور يحسمه حسام محذم % 37(@)(@@) % متيقظ يرعى الرعايا طرفه % يران الوقائع فهو مسد ملحم % 38(@)(@@) % ألقائد الغلب الكماة عوابسا % والبيض في أيمانهم تتبسم % 39(@)(@@) % من غلمة بجمالهم نار الهوى % % وببأسهم نار الوغى تتضرم % 40(@)(@@) % سيان سلمهم وحربهم فما % % ينفك يقطر من أكفهم الدم % 41(@)(@@) % ترك إذا لبسوا الترائك أيقنت % صم العوالي أنها ستحطم % PageV01P297 42(@)(@@) % يزداد إشراقا ضياء وجوههم % والجو بالهبوات أربد أقثم % 43(@)(@@) % فهم إذا حسروا ظباء خميلة % وهم أسود شرى إذا ما استلأموا % % 44(@)(@@) % ركبوا الدياجي والسروج أهلة % وهم بدور والأسنة أنجم % 45(@)(@@) % فكأن إيماض السيوف بوارق % وعجاج خيلهم سحاب مظلم % 46(@)(@@) % من كل ريان المعاطف خصره % كمحبه من ردفه يتظلم % 47(@)(@@) % في ثني بردته قضيب نقى ففي % % الدرع المفاضة منه طضود أيهم % 48(@)(@@) % بشر أرق من الزلال وتحته % كالصخر قلب لا يرق فيرحم % 49(@)(@@) % يصمي الخلي بطرفه وبكفه % يصمي الكمي فجؤذر أم ضيغم % 50(@)(@@) % هو تارة للحسن في أترابه % علم وطورا في الكتيبة معلم % 51(@)(@@) % خلط الحماسة بالنسيب فقل له % وغرار نصل في الرقاب محكم % PageV01P298 52(@)(@@) % عزمات منصور السرايا همه % في نصرة الدين الحنيف مقسم % 53(@)(@@) % قرم بأعباء الخلافة ناهض % صب بتدبير الممالك قيم % 54(@)(@@) % متبسم يوم الندى لعفاته % كرما وفي وجه الزمان تجهم % 55(@)(@@) % يغشى الطعان فلا يراع 
ms76	 جنانه % ويجود بالدنيا فلا يتندم % 57(@)(@@) % يا ابن الأئمة والهداة ومن إلى % % أحسابهم ينمى الحطيم وزمزم % 58(@)(@@) % ما عد مجد أول متقادم % إلا ومجدهم المؤثل أقدم % 59(@)(@@) % آل الرسالة بالصلاة عليهم % والحمد يفتتح الصلاة وتختم % 60(@)(@@) % قوم على أبياتهم تتنزل ال % أملاك والمبعوث أحمد منهم % 61(@)(@@) % بولائهم يعطى الوسيلة مؤمن % % 62(@)(@@) % وبهديهم عرف الضلال من الهدى % % وبفضلهم نزل الكتاب المحكم % PageV01P299 63(@)(@@) % من نور أوجههم إذا مروا به % يوم القيامة تستعيذ جهنم % 65(@)(@@) % ف سلم أمير المؤمنين فإننا % % بك ما سلمت من المخاوف نسلم % 66(@)(@@) % و نصت لها حضرية بدوية ال % أنساب لم يفتح بشرواها فم % 67(@)(@@) % ما جاوزت ريف العراق وإنها % % بلسان حاضر طيئ تتكلم % 68(@)(@@) % مدحا غدت لسماء مجدك أنجما % فبها شياطين العداوة ترجم % 69(@)(@@) % عربا فصاحا يستعير فطانة % وفصاحة منها البليد الأعجم % 70(@)(@@) % تروى فتحدث في المعاطف نشوة % فمديرها طربا بها يترنم % 71(@)(@@) % % أسلاف خمر في كؤوسك أم دم % 72(@)(@@) % لم يمدح الخلفاء قبل بمثلها % % فيما رويناه الوليد ومسلم % 73(@)(@@) % أشجي بها الحكمي لو حاكمته % لكن تعذر بيننا من يحكم % PageV01P300 74(@)(@@) % خدم تزورك في المواسم لا خلا % منها ولا من ظل ملكك موسمث % % PageV01P301 البحر : منسرح 1(@)(@@) % ملكت قلبي في الحكم ف حتكمي % % أفديك من مالك ومن حكم % 2(@)(@@) % قد سئم الليل فيك من سهري % % يا ليل والعائدات من سقمي % % 3(@)(@@) % تسفح عيني دموعها أسفا % على زمان بالسفح لم يدم % 4(@)(@@) % يحدث لي ذكر عهده طربا % إلى ليال من وصلنا قدم % 6(@)(@@) % قد أقسمت لا هتدى الخيال إلى % % جفني وبرت لمياء في القسم % 7(@)(@@) % يا عاذلي مهديا نصيحته % لو كان في النصح غير متهم % 8(@)(@@) % يلومني في الهوى وأحسبه % لو ذاق منه ما ذقت لم يلم % 9(@)(@@) % خل ملامي في حب ظالمة % لم يخل قلبي فيها من الألم % 10(@)(@@) % شيمتها الهجر % فهي تبخل بال % 11(@)(@@) % إن بخلت فالسماح لي خلق % أو غدرت فالوفاء من شيمي % % PageV01P302 12(@)(@@) % كم ليلة بت بين مرتشف % من ريقها بارد وملتثم % 13(@)(@@) % أمزج شكواي بالخضوع 
ms77	 لها % % ودمع عيني صبابة بدمي % % 14(@)(@@) % أما ودر من لفظها بدد % يمر من ثغرها بمنتظم % 15(@)(@@) % ومائس من قوامها ثمل % ومسكر من رضابها شيم % 19(@)(@@) % معيد شمل الإسلام ملتئما % وكان لولاه غير ملتئم % 20(@)(@@) % وناشر العدل في الأنام على % % فقر إليه ومنشر الكرم % 21(@)(@@) % هو الإمام الذي معانده % معاند الله بارئ النسم % 22(@)(@@) % حامي حمى الملك بالمثقفة ال % % سمر وبيض الصوارم الحذم % 23(@)(@@) % بثت يداه الآجال في الناس وال % أرزاق عدلا بالسيف والقلم % 24(@)(@@) % أكرم من مد بالنوال يدا % وخير ساع يسعى على قدم % PageV01P303 25(@)(@@) % طبق إحسانه البلاد فما % % يعدم في عصره سوى العدم % 26(@)(@@) % وعم بالجود كل ذي أمل % وخص بالعفو كل مجترم % 27(@)(@@) % قد نكرت بيضه الغمود لما % % يغمدها في التريب واللمم % 28(@)(@@) % نمته من هاشم ليوث وغى % % يفرق منها الليوث في الأجم % 29(@)(@@) % فروع مجد جلت مآثرهم % من العلى في الفروع والقمم % 30(@)(@@) % من كل قيل يقيل زلة عا % % ثر وقرم إلى الندى قرم % 31(@)(@@) % وصل علينا يقظى وفي الحلم % في الخطب تجلو حنادس الظلم % 32(@)(@@) % هم الوفيون بالعهود إذا % % قل وفاء الرجال بالذمم % 33(@)(@@) % ألضاربون الكماة في الغارة الشعواء والمطعمون في الإزم % شعواء والمطعمون في الإزم % 34(@)(@@) % جيران بيت الله الحرام إذا % % عد فخار وسادة الحرم % PageV01P304 35(@)(@@) % طالهم المستضيء باع على % وهمة والعلو بالهمم % 36(@)(@@) % ملكه الله أمر أمته % وكف عنها بوائق النقم % 37(@)(@@) % ورد كيد الأعداء باغية % بحد سيف من بأسه حذم % 38(@)(@@) % فكان للدين خير منتصر % وكان لله خير منتقم % 39(@)(@@) % يممته ظامئا فأوردني % % مناهلا من حياضه الفعم % 40(@)(@@) % وشارفت بي منه الأماني على % % بحر عطاء بالجود ملتطم % 41(@)(@@) % أعلقت كفي لما اعتلقت به % حبلا من الله غير منقصم % 42(@)(@@) % وذمة منه لو أذم بها % % لذي شباب ما ريع بالهرم % 43(@)(@@) % ف جتلها كالعروس تتبع في ال % إحسان أسلافها من الخدم % 44(@)(@@) % عذراء لم يجد مثلها كرما % قبلي زهير يوما على هرم % PageV01P305 45(@)(@@) % عون قواف أتتك تحمل أبكار معان لم تفترع بفم % كار معان 
ms78	 لم تفترع بفم % 46(@)(@@) % شواردا يقتفى مذاهبها % % فهي لقاح الخواطر العقم % 47(@)(@@) % وابل جديد البقاء ضافية % عليك منه ملابس النعم % PageV01P306 البحر : بسيط تام 1(@)(@@) % لولاك يا خير من يمشي على قدم % خاب الرجاء وماتت سنة الكرم % 2(@)(@@) % يا من رأينا عيانا من مكارمه % ما حدث الناس عن كعب وعن هرم % 3(@)(@@) % ومن إذا ستصرخ العافون راحته % لباهم جودها المأمول عن أمم % 4(@)(@@) % إذا سمحت لنا والسحب مخلفة % فجود كفك يغنينا عن الديم % 5(@)(@@) % أعاد ملكك للدنيا نضارتها % % وما تصرم من أيامها القدم % 6(@)(@@) % من بعد ما غبرت حينا وليس بها % % كهف لراج ولا طود لمعتصم % 7(@)(@@) % فالناس في جنة من عدل سيرتك ال % حسنى ومن بأسك المرهوب في حرم % 8(@)(@@) % يا من به نشر الله السماح ومن % أحيا به كرم الأخلاق والشيم % 9(@)(@@) % خير البلاد مكان أنت واطئه % وأمة أنت منها أفضل الأمم % 10(@)(@@) % بنيت دارا قضى بالسعد طالعها % % قامت لهيبتها الدنيا على قدم % PageV01P307 11(@)(@@) % سمت على كل دار رفعة وعلت % علو همة بانيها على الهمم % 12(@)(@@) % تعنو الكواكب إجلالا لعزتها % % وتستكين لها الأفلاك من عظم % 13(@)(@@) % تود لو أنها أمست تداس بأقادم الولائد في ناديك والخدم % مست تداس بأق % 14(@)(@@) % كأنها إرم ذات العماد وإن % زادت بمالكها فخرا على إرم % 15(@)(@@) % طفنا بأركانها طوف الحجيج فمن % مسلم حولها منا ومستلم % 16(@)(@@) % حللتموها فيا لله كيف حوت % تيار بحر بموج الحود ملتطم % 17(@)(@@) % يا دار لا زلت بالأفراح آهلة الم % غنى ومليت ما ألبست من نعم % 18(@)(@@) % ولا خلا ربعك المأهول من مدحي % % يوما ولا بابك المعمور من خدمي % % 19(@)(@@) % وألبستك التهاني من مواسمها % % قلائد الحمد من نظمي ومن كلمي % % 20(@)(@@) % مدائحا فيك لي تبقى مخلدة % بعدي إذا بليت تحت الثرى رممي % % PageV01P308 21(@)(@@) % وكيف لا أملأ الدنيا بمدحكم % وقد فتقتم لساني بالندى وفمي % % 22(@)(@@) % قد كان دهري لي حربا ومنذ درى % % أني انتصرت بكم ألقى يد السلم % 23(@)(@@) % فلو سكت ولم أنطق بشكركم % أثنت عظامي بما أوليتم ودمي % % 24(@)(@@) % فاليوم 
ms79	 لا عود أوراقي بمختبط % من الخطوب ولا فضلي بمهتضم % 25(@)(@@) % لولاكم يا بني العباس ما طلعت % شمس النهار ولا ضاءت على الأمم % 26(@)(@@) % سادات مكة والأشراف من مضر % أنتم وجيران بيت الله والحرم % 27(@)(@@) % المانعون حريم الجار إن نزلت % به الحوادث والوافون بالذمم % 28(@)(@@) % فليهنكم شرف ثان إلى شرف % طلتم به الناس من عرب ومن عجم % 29(@)(@@) % بالقائم المستضيء المستضاء به % إذا ادلهمت دياجي الظلم والظلم % 30(@)(@@) % خليفة الله في الدنيا ومن خضعت % له أقاليمها بالسيف والقلم % PageV01P309 31(@)(@@) % بقيتم في نعيم لا انقضاء له % عمر الزمان وملك غير منصرم % 32(@)(@@) % مهنئين بشمل غير منصدع % في خفض عيش وحبل غير منفصم % 33(@)(@@) % ما أومضت ب بتسام البرق سارية % تحت الدجا وبدت نار على علم % PageV01P310 البحر : كامل تام 1(@)(@@) % يا خير منتصر لخير إمام % حقا دعيت بناصر الإسلام % 2(@)(@@) % حكمت حد البيض في أعدائه % والمشرفية أعدل الحكام % 3(@)(@@) % ونصرت دين الله نصر مؤيد ل % آراء في نقض وفي إبرام % 4(@)(@@) % ووقفت أكرم موقف شهدته أملاك السماء وقمت خير مقام % لاك السماء وقمت خير مقام % 5(@)(@@) % دافعت عنه فكنت أملك ذائد % يحمي حقيقته وخير محامي % % 6(@)(@@) % ترك الفوارس وثبة الضرغام % غل الكماة وكل أبيض دامي % % 7(@)(@@) % برقاق بيض في الدماء نواهل % وعتاق جرد في الشكيم صيام % 8(@)(@@) % جهلوا القراع لدى الوغا فتعلموا % % من غرب سيفك كيف ضرب الهام % 9(@)(@@) % قذفوا بشهب من سطاك ثواقب % شبت عليهم من ورا وأمام % 10(@)(@@) % فديارهم وقلوبهم للنار في % % أرجائها والخوف أي ضرام % PageV01P311 11(@)(@@) % لولا عماد الدين لم تظفر يد % من حربهم ونزالهم بمرام % 12(@)(@@) % أضحوا وقد غدرت بهم أيامهم % غيرا وتلك سجية الأيام % 13(@)(@@) % فكأنما كانوا لوشك زوالها % % أضغاث أحلام وطيف منام % 14(@)(@@) % كانوا ملوكا بالعراق فأصبحوا % % لما بغوا نزلاء أهل الشام % 15(@)(@@) % غادرتهم مما ملأت قلوبهم % فرقا يرون ظباك في الأحلام % 16(@)(@@) % طلبوا ذماما منك لما سمتهم % سوء العذاب ولات حين ذمام % 17(@)(@@) % ورميت جيشهم اللهام بعسكر % مجر وجيش من سطاك لهام % 18(@)(@@) % ووسمتهم بالعار يوم 
ms80	 لقيتهم % زحفا بشمس كالشموس وسام % 19(@)(@@) % من كل من لو كان ينصف لاكتفى % % بلحاظه من ذابل وحسام % 21(@)(@@) % يصمي الرمية راشقا من كفه % طورا ومن أجفانه بسهام % PageV01P312 22(@)(@@) % قوم إذا اعتقلوا أنابيب القنا % % لوغى حسبت الأسد في آجام % 23(@)(@@) % غلب ولكن في المغافر منهم % حدق المها وسوالف الآرام % 24(@)(@@) % هذا يكر بذابل من قده % لدن وهذا باللواحظ رام % 25(@)(@@) % فهم إذا ركبوا أسود خفية % وإذا نتدوا كانوا بدور تمام % 26(@)(@@) % لولا التقية قلت إن وجوههم % صور تبيح عبادة الأصنام % 27(@)(@@) % راحوا نشاوى للقاء كأنهم % يتعاقرون عليه كأس مدام % 28(@)(@@) % وكأنما لمع الظبا بأكفهم % برق تألق من متون غمام % 29(@)(@@) % لبسوا الحديد على قلوب مثله % بأسا فشنوا اللأم فوق اللام % 30(@)(@@) % لغلامهم في الروع عزمة شائب % ولكهلهم فيه هجوم غلام % 31(@)(@@) % تبعوا الأمير أبا الفضائل فاقتدوا % % بفعاله في البأس والإقدام % PageV01P313 32(@)(@@) % فليهنك الظفر الذي لولاك ما % % خطرت بشائره على الأوهام % 33(@)(@@) % فتح جعلت به العدى أحدوثة % تبقى مدى الأحقاب والأعوام % 34(@)(@@) % إني لأعجب والكماة عوابس % من وجهك المتهلل البسام % 35(@)(@@) % وإذا دجى خطب فرأيك سافر % وإذا عرى جدب فبحرك طام % 36(@)(@@) % فتمل ما أولاك سيدنا أمير ال % مؤمنين به من الإنعام % 37(@)(@@) % واسعد بما أتيته من رتبة % خصتك بالتشريف والإكرام % 38(@)(@@) % وبخلعة شهدت بأنك حزت من % شرف الخلافة أوفر الأقسام % 39(@)(@@) % لا زلت ترفل في ثياب سعادة % فضلا وتسحب ذيل جد سام % 40(@)(@@) % تخشى وترجى سيف بأسك قاطع % بين الورى وسحاب جودك هام % PageV01P314 البحر : رجز تام 1(@)(@@) % إن أخلقت ثوب شبابي الأيام % وبددت شمل مراح ملتام % 2(@)(@@) % وزارني ضيف بغيض الإلمام % تنكره عين المها والآرام % 3(@)(@@) % ورب يوم عمره كالإبهام % ركبت فيه صهوات الأيام % 4(@)(@@) % وقهوة فضضت عنه الخاتام % مما صطفى أخو المجوس و عتام % 5(@)(@@) % أتت عليها في الدنان الأعوام % تنفي الهموم وتداوي الأسقام % 6(@)(@@) % ماكسني الخمار فيها واستام % ما رمت حتى بتعتها بما رام % 7(@)(@@) % نمت بوجدي والزجاج نمام % في ليلة عصيت فيها اللوام % 8(@)(@@) % يغبطني على السهاد النوام 