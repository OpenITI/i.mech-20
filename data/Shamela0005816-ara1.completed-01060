ms1041	 الأكوع روى عنه حبان بن هلال وموسى بن إسماعيل التبوذكي(@)(@@)(@@)(@@) $ 8346 - السائب مولى عائشة بنت عثمان يروي عن عروة بن الزبير روى عنه عثمان بن مرة الليثي(@)(@@)(@@)(@@) $ 8347 - السائب بن حبيش الكلاعي يروي عن معدان بن أبي طلحة البصري عن أبي الدرداء روى عنه زائدة بن قدامة وأهل الكوفة(@)(@@)(@@)(@@) $ 8348 - السائب الطائفي يروي عن يزيد بن عامر المراسيل روى عنه ابنه سعيد بن السائب(@)(@@)(@@)(@@) $ 8349 - السائب بن عمر بن عبد الرحمن بن السائب المخزومي يروي عن أبي مليكة روى عنه وكيع وأبو نعيم PageV06P413(@)(@@)(@@)(@@) $ 8350 - سليم بن أذنان النخعي يروي عن علقمة روى عنه الحكم وأبو إسحاق(@)(@@)(@@)(@@) $ 8351 - سليم أبو عبد الله المكي يروي عن مجاهد روى عنه الحجازيون(@)(@@)(@@)(@@) $ 8352 - سليم بن شداد يروي عن الربيع بن خثيم روى عنه عمرو بن ثابت(@)(@@)(@@)(@@) $ 8353 - سليم أبو اليسع مولى أبي خليفة العبدي من أهل البصرة يروي عن الحسن روى عنه عون بن موسى(@)(@@)(@@)(@@) $ 8354 - سليم مولى الشعبي كنيته أبو سلمة كوفي يروي عن الشعبي روى عنه عفيف بن سالم ومحمد بن دينار الطاحي(@)(@@)(@@)(@@) $ 8355 - سليم بن الحارث بن سليم الهجيمي أخو خالد بن الحارث من PageV06P414 أهل البصرة يروي عن جهضم بن الضحاك عن العداء بن خالد بن هوذة روى عنه قيس بن حفص الدارمي(@)(@@)(@@)(@@) $ 8356 - سليم بن الأخضر من أهل البصرة يروي عن حميد الطويل روى عنه بن مهدى والبصريون مات سنة ثمانين ومائة(@)(@@)(@@)(@@) $ 8357 - سليم بن عثمان أبو عثمان الطائي يروي عن جماعة من أهل الشام روى عنه سليمان بن سلمة الخبائري الأعاجيب الكثيرة ولست أعرفه بعدالة ولا جرح ولا له راو غير سليمان وسليمان ليس بشيء فإن وجد له راو غير سليمان بن سلمة اعتبر حديثه ويلزق به ما يتأهله من جرح أو عدالة(@)(@@)(@@)(@@) $ 8358 - سلام شيخ يروي عن الحسن روى عنه سعيد بن أبي عروبة وإن لم يكن سلام بن تميم فلا أدرى من هو PageV06P415(@)(@@)(@@)(@@) $ 8359 - سلام بن كركرة يروي عن عمرو بن دينار روى عنه محمد بن إسحاق 
ms1042	(@)(@@)(@@)(@@) $ 8360 - سلام الليثي والد القاسم بن سلام يروي عن عبد الله بن بريدة روى عنه يحيى بن واضح(@)(@@)(@@)(@@) $ 8361 - سلام بن تميم يروي عن الحسن روى عنه سعيد بن أبي عروبة(@)(@@)(@@)(@@) $ 8362 - سلام بن عبد الله أبو حفص من أهل البصرة يروي عن أبي العلاء بن الشخير روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8363 - سلام بن مسكين الأزدي من أهل البصرة كنيته أبو روح يروي عن الحسن روى عنه مسلم وأبو نعيم مات سنة أربع وستين ومائة وقد قيل سنة سبع وستين ومائة(@)(@@)(@@)(@@) $ 8364 - سلام بن سليمان أبو المنذر القاري مولى معقل بن يسار من أهل البصرة يروي عن ثابت وعاصم بن بهدلة وحماد بن أبى سليمان PageV06P416 روى عنه زيد بن الحباب وعفان وكان يخطىء وليس هذا بسلام الطويل ذاك ضعيف وهذا صدوق(@)(@@)(@@)(@@) $ 8365 - سلام بن سليم أبو الأحوص الحنفي من أهل الكوفة يروي عن أبي إسحاق ومنصور روى عنه قتيبة بن سعيد وأهل العراق مات سنة تسع وسبعين ومائة(@)(@@)(@@)(@@) $ 8366 - أبو رجاء مولى أبي قلابة اسمه سلمان من أهل البصرة يروي عن أبي قلابة روى عنه أيوب وابن عون وحميد الطويل(@)(@@)(@@)(@@) $ 8367 - سلمان الشامي يروي عن جنادة بن أبي أمية روى عنه عاصم الأحول(@)(@@)(@@)(@@) $ 8368 - سلمان بن عتبان أبو الرمكاء يروي عن نعيم بن أبي هند عن علي روى عنه محمد بن طلحة(@)(@@)(@@)(@@) $ 8369 - سهيل بن أبي صالح السمان واسم أبي صالح ذكوان PageV06P417 مولى جويرية بنت الأحمس الغطفانية من أهل المدينة يروي عن بن المسيب وأبي صالح أبيه روى عنه مالك والثوري وشعبة وكان يخطىء مات سهيل في ولاية أبي جعفر(@)(@@)(@@)(@@) $ 8370 - سهيل بن عمرو القرشي يروي عن سعيد بن المسيب روى عنه شعبة(@)(@@)(@@)(@@) $ 8371 - سهيل بن أبي الجعد مولى الأنصار كنيته أبو الأحدل يروي عن عروة بن الزبير والمقبري روى عنه سعيد بن أبي أيوب وحيوة بن شريح(@)(@@)(@@)(@@) $ 8372 - سهيل بن ذراع كان قاضيا بالشام يروي المقاطيع روى عنه عاصم بن كليب(@)(@@)(@@)(@@) $ 8373 - سهيل بن عمرو شيخ يروي عن أبيه روى 
ms1043	 عنه همام بن يحيى لا أدري من هو ولا من أبوه(@)(@@)(@@)(@@) $ 8374 - سهيل شيخ يروي عن الحسن روى عنه بن عجلان(@)(@@)(@@)(@@) $ 8375 - سهيل بن حسان أبو السحماء الكلبي من أهل مصر يروى عن PageV06P418 أبي قبيل وكعب بن علقمة روى عنه الليث بن سعد وخالد بن حميد(@)(@@)(@@)(@@) $ 8376 - سهيل بن أبي سهيل المدني العابد يروي عن أبيه عن عائشة روى عنه عمرو بن الحارث(@)(@@)(@@)(@@) $ 8377 - سلم بن عبد الرحمن النخعي أخو حصين بن عبد الرحمن من أهل الكوفة يروي عن أبي زرعة بن عمرو بن جرير عن أبي هريرة روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 8378 - سلم بن عطية من أهل الكوفة يروي عن مجاهد وعبد الله بن أبي الهذيل روى عنه محمد بن قيس الأسدي وشعبة(@)(@@)(@@)(@@) $ 8379 - سلم بن يسار مولى الحارث بن سعد بن أبي ذباب المدني يروي عن المدنيين روى عنه سعيد بن مسلم بن بانك(@)(@@)(@@)(@@) $ 8380 - سلم بن أبي الذيال من أهل البصرة يروي عن الحسن وابن PageV06P419 سيرين وكان متقنا روى عنه المعتمر بن سليمان حدثنا بن قتيبة قال ثنا بن أبي السري قال ثنا معتمر بن سليمان قال ثنا سلم بن أبي الذيال عن محمد بن سيرين عن أبي هريرة قال قال رجل للنبي صلى الله عليه وسلم أصلي في ثوب واحد فقال النبي صلى الله عليه وسلم أوكلكم يجد ثوبين(@)(@@)(@@)(@@) $ 8381 - سلم بن بشير بن جحل القيسي من أهل البصرة يروي عن عكرمة وعبد العزيز بن صهيب روى عنه رقبة مسقلة وأبو عاصم العباداني وهو الذي يروي عن أبي هريرة ولم يره بينه وبينه عكرمة(@)(@@)(@@)(@@) $ 8382 - سلم بن قتيبة بن مسلم بن عمرو بن حصين الباهلي من أهل البصرة وكان على خراسان يروي عن عمرو بن دينار روى عنه ابنه سعيد بن سلم بن قتيبة(@)(@@)(@@)(@@) $ 8383 - سلم بن إبراهيم الوراق يروي عن عكرمة بن عمار روى عنه محمد بن يحيى الذهلي PageV06P420(@)(@@)(@@)(@@) $ 8384 - سلم بن زرير العطاردي يروي عن أبي رجاء العطاردي روى عنه عبيد الله بن عبد 
ms1044	 المجيد الحنفي(@)(@@)(@@)(@@) $ 8385 - سيار بن قيس وقد قيل سنان بن قيس من أهل الشام يروي عن خالد بن معدان روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 8386 - سيار أبو حمزة من أهل الكوفة يروي عن قيس بن أبي حازم روى عنه عبد الملك بن سعيد بن أبجر(@)(@@)(@@)(@@) $ 8387 - سيار بن أبي سيار أبو الحكم الواسطي العنزي أخو مساور الوراق لأمه واسم أبي سيار وردان يروي عن طارق بن شهاب والشعبي روى عنه عبيد الله بن عمر العمري وبشير بن سلمان وهشيم العراقيون(@)(@@)(@@)(@@) $ 8388 - سيار بن عبد الرحمن الصدفي يروي عن يزيد بن قوذر روى عنه سعيد بن أبي أيوب والليث بن سعد PageV06P421(@)(@@)(@@)(@@) $ 8389 - سيار بن عبد الله شامي يروي عن أبي إدريس الخولاني قدم البصرة فحدثهم بها روى عنه سليمان التيمي قال حدثنا بن قتيبة قال ثنا بن أبي السري قال ثنا معتمر عن أبيه عن سيار عن أبي إدريس الخولاني أنه قال إن الذي يتعلم هذه الأحاديث ليراءي بها الناس لا يرح رائحة الجنة(@)(@@)(@@)(@@) $ 8390 - سوار بن داود أبو حمزة يروى عن ثابت البناني وعمرو بن شعيب روى عنه بن المبارك والنضر بن شميل يخطىء(@)(@@)(@@)(@@) $ 8391 - سوار بن حكم الخراساني ختن عطاء بن أبي رباح يروي عن عطاء روى عنه بن عيينة(@)(@@)(@@)(@@) $ 8392 - سوار الجرمي من أهل البصرة يروي عن أبي قلابة روى عنه ابنه قتادة بن سوار PageV06P422(@)(@@)(@@)(@@) $ 8393 - سوار الكندي من أهل الكوفة يروي عن موسى بن طلحة روى عنه ابنه أشعث بن سوار(@)(@@)(@@)(@@) $ 8394 - سوار بن عبد الله شيخ يروي عن رفيع أبي العالية روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 8395 - سوار بن عبد الله بن قدامة العنبري القاضي من أهل البصرة كنيته أبو عبد الله يروي عن الحسن وبكر بن عبد الله المزني وكان فقيها روى عنه أهل البصرة وابنه عبد الله بن سوار مات في ذي القعدة سنة ست وخمسين ومائة وهو يومئذ أمير البصرة وقاضيها وكان قد ولاه أبو جعفر القضاء سنة ثمان وثلاثين ومائة وبقى على 
ms1045	 القضاء إلى أن مات(@)(@@)(@@)(@@) $ 8396 - سوار بن عبد الله أبو سنان الهذلي من أهل البصرة يروي عن الحسن روى عنه أبو عبيدة الحداد ليس هذا بسوار القاضي(@)(@@)(@@)(@@) $ 8397 - سوار الشقري يروي عن قدامة بن حماطة عن أبي هريرة روى عنه أبو يحيى الحماني PageV06P423(@)(@@)(@@)(@@) $ 8398 - سنان بن قيس من أهل الشام يروي عن خالد بن معدان روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 8399 - سنان مولى عروة بن الزبير يروي عن عروة وكان عاملا لعمر بن عبد العزيز روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 8400 - سنان بن الحارث بن مصرف يروي عن عمه طلحة بن مصرف روى عنه القاسم بن الوليد الهمداني(@)(@@)(@@)(@@) $ 8401 - سيف أبو عائذ الأزدي يروي عن يزيد بن البراء عن البراء روى عنه سعيد بن إياس الجريري(@)(@@)(@@)(@@) $ 8402 - سيف بن عبد الحميد بن محمود يروي عن أبيه عن بن عباس روى عنه هشام بن حسان PageV06P424(@)(@@)(@@)(@@) $ 8403 - سيف شيخ يروي عن رشيد الهجري روى عنه الحكم بن عتيبة(@)(@@)(@@)(@@) $ 8404 - سيف بن سليمان كنيته أبو سليمان مولى بني مخزوم من أهل مكة وهو الذي يقال له سيف بن أبي سليمان يروي عن مجاهد وقيس بن سعد روى عنه الثوري وعبد الله بن الحارث المخزومي وأبو نعيم مات سنة ست وخمسين ومائة وكان يسكن البصرة في آخر عمره(@)(@@)(@@)(@@) $ 8405 - سيف بن خليد يروي عن أبيه عن علي روى يحيى بن سعيد الأموي عن أبيه عنه(@)(@@)(@@)(@@) $ 8406 - سيف بن ميسرة من أهل الكوفة يروي عن أبي سعيد عن الزبير روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 8407 - سيف شيخ يروي عن أبي وائل روى عنه شعبة بن الحجاج PageV06P425(@)(@@)(@@)(@@) $ 8408 - سماك بن الفضل الخولاني اليماني من أهل صنعاء يروي عن وهب بن منبه روى عنه معمر بن راشد(@)(@@)(@@)(@@) $ 8409 - سماك بن عبيد يروي عن عطاء روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 8410 - سماك بن عطية المربدي من أهل البصرة يروي عن الحسن وأيوب روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 8411 - سماك بن عمران بن مسلم يروي عن الحسن روى عنه البصريون(@)(@@)(@@)(@@) $ 8412 
ms1046	 - السرى بن عبد الرحمن الحجازي يروي عن عباد بن حمزة عن جابر بن عبد الله روى عنه موسى بن يعقوب الزمعي(@)(@@)(@@)(@@) $ 8413 - السرى بن عبد الرحمن من أهل البصرة يروي عن بكر بن عبد الله المزني روى عنه أبو معاوية الضرير PageV06P426(@)(@@)(@@)(@@) $ 8414 - السرى بن معارك من أهل الكوفة يروي عن إبراهيم النخعي روى عنه المغيرة بن مقسم(@)(@@)(@@)(@@) $ 8415 - السرى بن ينعم الجبلاني من أهل الشام يروي عن عمرو بن قيس ومريح بن مسروق الهوزني والشاميين روى عنه محمد بن حرب الأبرش وبقية بن الوليد(@)(@@)(@@)(@@) $ 8416 - السرى بن يحيى الشيباني من أهل البصرة كنيته أبو يحيى وقد قيل أبو الهيثم يروي عن الحسن وثابت روى عنه مسلم بن إبراهيم مات سنة تسع وستين ومائة بمكة وكان عاقلا(@)(@@)(@@)(@@) $ 8417 - السكن بن أبي خالد الأعرابي صاحب الغنم يروي عن الحسن وأبي نعامة روى عنه هشام بن حسان وقد بقي إلى أن كتب عنه قتيبة بن سعيد(@)(@@)(@@)(@@) $ 8418 - السكن بن أبي كريمة يروي عن الزهري ومحمد بن عباد بن جعفر روى عنه محمد بن إسحاق PageV06P427(@)(@@)(@@)(@@) $ 8419 - السكن بن أبي المغيرة القرشي مولى عثمان بن عفان كنيته أبو محمد يروي عن الحسن روى عنه عثمان بن عمر وأبو داود الطيالسي(@)(@@)(@@)(@@) $ 8420 - السكن بن أبي السكن البرجمي واسم أبي السكن سليمان يروي عن حميد الطويل ويونس بن عبيد روى عنه أزهر بن جميل والبصريون(@)(@@)(@@)(@@) $ 8421 - سوادة بن مسعود بن سهل يروي عن الحسن روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8422 - سوادة البرجمي يروي المقاطيع روى عنه صفوان بن عمرو السكسكي PageV06P428(@)(@@)(@@)(@@) $ 8423 - سوادة بن الصباح الكندي من أهل الرها يروي عن الجريريين روى عنه أهل بلده وأحسبه الذي يقال له سوادة الرقى الذي يروي عن أبي الحصين(@)(@@)(@@)(@@) $ 8424 - سوادة بن أبى الجعد أخو عمران وإبراهيم يروي عن أبي جعفر محمد بن علي روى عنه مطرف بن طريف(@)(@@)(@@)(@@) $ 8425 - سوادة بن حيان التميمي أبو عتبة يروي عن معاوية بن قرة روى عنه زيد بن الحباب وداود بن المحبر(@)(@@)(@@)(@@) $ 8426 - سوادة بن 
ms1047	 أبي العالية القطعي من أهل البصرة يروي عن الحسن روى عنه موسى بن إسماعيل التبوذكي(@)(@@)(@@)(@@) $ 8427 - سميع بن زاذان يروي عن هنيدة بنت قيس عن عائشة روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 8428 - سبرة بن عبد الله بن حنش الكوفي قدم البصرة وحدثهم بها يروي عن أبيه عن البراء وابن عمر روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8429 - سحيم بن هانئ جليس الأوزاعي يروي عن طاوس قال PageV06P429 ما رأيته إلا مقنعا باكيا روى عنه محمد بن مصعب القرقساني(@)(@@)(@@)(@@) $ 8430 - سليط بن أيوب الأنصاري من أهل المدينة يروي عن القاسم بن محمد روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 8431 - سليط بن عبد الله يروي عن بهية روى عنه الحجاج بن أرطأة(@)(@@)(@@)(@@) $ 8432 - سهم بن منجاب الضبي من أهل الكوفة يروي عن قزعة عن أبي سعيد وعن القرثع عن أبي أيوب روى عنه إبراهيم بن يزيد النخعي وأبو سنان ضرار بن مرة(@)(@@)(@@)(@@) $ 8433 - سهم بن شقيق يروي عن عامر بن عبد قيس روى عنه الوليد أبو بشر(@)(@@)(@@)(@@) $ 8434 - سهم بن يزيد الحمراوي مصري يروي عن المدنيين وعمر بن عبد العزيز روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 8435 - سهم بن المعتمر يروي عن الهجيمي روى عنه عبد الملك بن الحسن الجاري PageV06P430(@)(@@)(@@)(@@) $ 8436 - سهم مولى بني سليم يروي عن مولاته عن عائشة روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8437 - سعدان بن سالم الأيلي أبو الصباح يروي عن يزيد بن أبي سمية روى عنه بن المبارك ثنا بن قتيبة قال ثنا أبو عمير النحاس قال ثنا ضمرة عن سعدان بن سالم الأيلي عن يزيد بن أبي سمية قال سمعت بن عمر يقول ما قال رسول الله صلى الله عليه وسلم في الإزار فهو في القميص(@)(@@)(@@)(@@) $ 8438 - سعدان بن يحيى بن صالح اللخمي الكوفي كنيته أبو يحيى سكن دمشق يروي عن إسماعيل بن أبي خالد روى عنه سليمان بن عبد الرحمن وهشام بن عمار وقد قيل إن اسمه سعيد وسعدان لقب(@)(@@)(@@)(@@) $ 8439 - سريع مولى سوادة بن الربيع الجرمي يروي عن سوادة بن PageV06P431 الربيع روى عنه سلم 
ms1048	 بن عبد الرحمن(@)(@@)(@@)(@@) $ 8440 - سريع شيخ يروي عن وهب بن منبه روى عنه أبو قتيبة سلم بن قتيبة(@)(@@)(@@)(@@) $ 8441 - سعر بن نقادة الأسدي يروي عن نقادة روى عنه ابنه عاصم بن سعر(@)(@@)(@@)(@@) $ 8442 - سكين بن عبد العزيز بن قيس القطان من أهل البصرة يروي عن سيار بن سلامة وأبيه روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 8443 - سكين بن يزيد أبو قبيصة المجاشعي يروي عن ميمون بن مهران وعبد الله بن عبيد بن عمير روى عنه العراقيون(@)(@@)(@@)(@@) $ 8444 - سميط بن عجلان بصري يروي عن مؤذن بني عدي روى عنه الصعق بن حزن وليس هذا بوالد عبد الله بن شميط ذاك بالشين وهذا بالسين PageV06P432(@)(@@)(@@)(@@) $ 8445 - سمير أبو عاصم قوله روى عنه أبو الأحوص سلام بن سليم(@)(@@)(@@)(@@) $ 8446 - سابق بن عبد الله أبو سعيد البربري من أهل بربر سكن الرقة يروي عن مكحول وعمرو بن أبي عمرو روى عنه الأوزاعي وأهل الجزيرة وهو الذي يروي عن سعيد بن سمعان(@)(@@)(@@)(@@) $ 8447 - سابق أبو سهل مولى بني رفاعة يروي عن الحسن روى عنه يحيى بن اليمان(@)(@@)(@@)(@@) $ 8448 - سابق بن ناجية يروي عن أبي سلام عن رجل خدم النبي صلى الله عليه وسلم روى عنه أبو عقيل هاشم بن بلال(@)(@@)(@@)(@@) $ 8449 - سريج أبو حرب من أهل البصرة يروي عن الأحنف بن قيس روى عنه ابنه حرب بن سريج PageV06P433(@)(@@)(@@)(@@) $ 8450 - سراج بن عقبة بن طلق بن علي الحنفي من أهل اليمامة يروي عن عمته خلدة بنت طلق روى عنه ملازم بن عمرو وقد قيل إن اسم عمته جعدة(@)(@@)(@@)(@@) $ 8451 - سفر بن نسير الأزدي يروي عن يزيد بن شريح الحضرمي عن أبي أمامة روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 8452 - سقر بن حبيب الغنوي يروي عن المدنيين وعمر بن عبد العزيز روى عنه الحجاج بن حسان(@)(@@)(@@)(@@) $ 8453 - السيد بن عيسى شيخ من أهل الكوفة يروي عن أبي إسحاق السبيعي روى عنه العلاء بن عمرو الحنفي(@)(@@)(@@)(@@) $ 8454 - سمي مولى أبي بكر بن عبد الرحمن بن الحارث بن هشام المخزومي القرشي من 
ms1049	 أهل المدينة يروي عن أبي صالح وأبي بكر بن عبد الرحمن روى عنه مالك بن أنس وأهل المدينة قتل سنة ثلاثين ومائة قتله الحرورية يوم قديد PageV06P434(@)(@@)(@@)(@@) $ 8455 - سمي بن قيس يروي عن شمير بن عبد المدان روى عنه ثمامة بن شراحيل(@)(@@)(@@)(@@) $ 8456 - سعاد بن سليمان التميمي يروي عن زياد بن علاقة روى عنه سهل بن حماد وعبد الصمد بن النعمان(@)(@@)(@@)(@@) $ 8457 - سفاح بن مطر الشيباني يروي عن داود بن كردوس الثعلبي روى عنه أبو إسحاق الشيباني(@)(@@)(@@)(@@) $ 8458 - سدوس الثوري إمام الحي يروي عن الربيع بن خثيم عداده في أهل الكوفة روى عنه الثوري(@)(@@)(@@)(@@) $ 8459 - سليم بن حيان الهذلي من أهل البصرة يروي عن سعيد بن ميناء وأبيه روى عنه يزيد بن هارون والبصريون PageV06P435(@)(@@)(@@)(@@) $ 8460 - سعير بن الخمس التميمي من أهل الكوفة يروي عن حبيب بن أبي ثابت روى عنه عثام بن علي كان قد مرض مرضه فغشي عليه فصيح به وتوهموا أنه مات وغسل وكفن فلما أن وضع على النعش تحرك فرد إلى منزله فبرأ وعاش وولد له بعد ذلك مالك بن سعير ابنه(@)(@@)(@@)(@@) $ 8461 - سداد أبو الحسن الجعفي من أهل الكوفة يروي عن أم فاطمة روى عنه إسحاق بن منصور السلولي(@)(@@)(@@)(@@) $ 8462 - سماعة شيخ كوفي يروي عن عمرو بن مرة روى عنه الثوري(@)(@@)(@@)(@@) $ 8463 - سقيف بن بشر العجلي كوفي يروي عن طاوس روى عنه يعلى ومحمد ابنا عبيد الطنافسي(@)(@@)(@@)(@@) $ 8464 - السقعب بن زهير يروي عن زيد بن أسلم روى عنه جرير بن حازم PageV06P436(@)(@@)(@@)(@@) $ 8465 - سرور بن المغيرة بن زاذان السلمي بن أخي منصور بن زاذان كنيته أبو عامر ويقال أبو العباس أصله من البصرة سكن واسط يروي عن سليمان التيمي روى عنه الواسطيون(@)(@@)(@@)(@@) $ 8466 - سندي بن شماس السمان يروي عن عطاء وابن سيرين روى عنه موسى بن إسماعيل التبوذكي(@)(@@)(@@)(@@) $ 8467 - السقف شيخ يروي عن عطاء روى عنه هشام بن حسان(@)(@@)(@@)(@@) || (باب الشين)(@)(@@) قال أبو حاتم رضي الله عنه وممن شافه التابعين وروى عنهم ممن ابتدأ اسمه على الشين(@)(@@)(@@)(@@) $ 8468 
ms1050	 - شعيب بن محمد بن عبد الله بن عمرو بن العاص يروي عن أبيه لا يصح له سماع من عبد الله بن عمرو وروى عنه ابنه عمرو بن شعيب(@)(@@)(@@)(@@) $ 8469 - شعيب بن درهم أبو درهم مولى لقريش يروي عن أبي رجاء العطاردي وقد قيل كنيته أبو زياد من أهل البصرة روى عنه المعتمر بن سليمان PageV06P437(@)(@@)(@@)(@@) $ 8470 - شعيب أبو إسرائيل مولى بني جشم بن معاوية من أهل البصرة يروى عن جعدة بن هبيرة روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 8471 - شعيب بن أبي منيع يروي عن عيسى بن خثيم روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 8472 - شعيب بن أبي حمزة مولى بني أمية كنيته أبو بشر من أهل حمص واسم أبي حمزة دينار يروي عن الزهري ونافع روى عنه الوليد بن مسلم وعثمان بن سعيد القرشي مات سنة اثنتين وستين ومائة(@)(@@)(@@)(@@) $ 8473 - شعيب الجباي من أهل اليمن وجبأ جبل بالجند يروي عن الحكم بن عتيبة وكان قرأ الكتب روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 8474 - شعيب بن أبي الأشعث يروي عن نافع عن بن عمر روى عنه محمد بن حمير وشراحيل بن عبد الحميد وأهل الشام يعتبر بحديثه إذا لم يكن في إسناده ضعيف ولا بقية بن الوليد PageV06P438(@)(@@)(@@)(@@) $ 8475 - شعيب بن خالد الرازي خال يحيى بن العلاء الرازي يروي عن عطاء والزهري روى عنه عمرو بن أبي قيس(@)(@@)(@@)(@@) $ 8476 - شعيب بن طلحة بن عبد الرحمن بن أبي بكر الصديق أخو محمد بن طلحة يروي عن أبيه روى عنه معن بن عيسى(@)(@@)(@@)(@@) $ 8477 - شعيب بن عبد الرحمن يروي عن أبيه عن أبي هريرة روى عنه جهضم بن عبد الله(@)(@@)(@@)(@@) $ 8478 - شعيب بن إسحاق الدمشقي يروي عن هشام بن عروة روى عنه هشام بن عمار مات في رجب سنة تسع وثمانين ومائة وكان ينتحل مذهب الرأي(@)(@@)(@@)(@@) $ 8479 - شعيب بن محمد الغفاري يروي عن محمد بن زيد بن قنفذ عن أبي هريرة روى عنه أبو مصعب(@)(@@)(@@)(@@) $ 8480 - شعيب بن راشد الكوفي يروي عن أبي فزارة روى عنه قتيبة 
ms1051	 بن سعيد(@)(@@)(@@)(@@) $ 8481 - شعيب شيخ يروي عن أبي محمد الجزري روى عنه معاوية بن صالح PageV06P439(@)(@@)(@@)(@@) $ 8482 - شعيب الأصم يروي عن أبي رجاء الدمشقي روى عنه ثور بن يزيد(@)(@@)(@@)(@@) $ 8483 - شعيب صاحب الطيالسة يروي عن طاوس وابن سيرين عداده في أهل البصرة روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8484 - شعيب بن أبي سنان يروي عن الحسن روى سعيد بن أبي أيوب عن أبي عيسى محمد بن عبد الرحمن المؤذن الخراساني عنه حدثنا أحمد بن علي الصيرفي قال ثنا روح بن عبد المؤمن قال ثنا شعيب قال سئل طاوس عن العزل وأنا شاهد فقال قد فعل ذلك من هو خير منا ومنكم(@)(@@)(@@)(@@) $ 8485 - شعيب بن صفوان الثقفي كنيته أبو يحيى أصله من الكوفة سكن بغداد يروي عن عبد الملك بن عمير روى عنه علي بن حجر السعدي وكان كاتب بن شبرمة مات ببغداد في ولاية هارون يخطىء PageV06P440(@)(@@)(@@)(@@) $ 8486 - شداد بن أبي العالية مولى بني ثور كنيته أبو الفرات يروي عن مالك الأحمري عن حذيفة روى عنه الثوري وأبو حيان(@)(@@)(@@)(@@) $ 8487 - شداد بن سعيد من أهل البصرة يروي عن أبي الوازع عن عبد الله بن المغفل روى عنه أبو معشر البراء يوسف بن يزيد(@)(@@)(@@)(@@) $ 8488 - شداد بن أبي عمرو بن حماش الليثي يروي عن أبيه روى عنه أبو اليمان الرحال(@)(@@)(@@)(@@) $ 8489 - شداد بن عبد الرحمن من ولد شداد بن أوس يروي عن إبراهيم بن أبي عبلة روى عنه عبد الله بن مروان بن معاوية الفزاري مستقيم الحديث(@)(@@)(@@)(@@) $ 8490 - شداد الضرير من أهل دمشق يروي عن أبي سلام الأسود عن ثوبان في الحوض روى عنه سويد بن عبد العزيز الدمشقي(@)(@@)(@@)(@@) $ 8491 - شداد بن جابان يروي عن حجر المدرى روى عنه معمر بن راشد PageV06P441(@)(@@)(@@)(@@) $ 8492 - شداد القاري يروي المراسيل روى عنه يحيى بن حمزة وهو الذي يروي عن أبي الدرداء ولم يره(@)(@@)(@@)(@@) $ 8493 - شداد بن حي أبو عبد الله من أهل الشام يروي عن نوف البكالي روى عنه مهاجر النبال(@)(@@)(@@)(@@) $ 8494 - شريح بن أرطأة النخعي يروي عن الكوفيين 
ms1052	 روى عنه أهل بلده المقاطيع(@)(@@)(@@)(@@) $ 8495 - شريح الشامي يروي المراسيل روى عنه عبد الملك بن أبي بشير(@)(@@)(@@)(@@) $ 8496 - شريح بن عبيد شامي يروي عن عبد الرحمن بن جبير بن نفير روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 8497 - شبيب بن حوشب يروي عن القاسم بن محمد روى عنه هشيم بن بشير(@)(@@)(@@)(@@) $ 8498 - شبيب بن عجلان أبو فروة يروي عن الحسن روى عنه بهز بن أسد PageV06P442(@)(@@)(@@)(@@) $ 8499 - شبيب شيخ يروي عن أبي قلابة روى عنه سليمان التيمي(@)(@@)(@@)(@@) $ 8500 - شبيب بن شبيب يروي عن جدته أم شبيب عن عائشة روى عنه التبوذكي(@)(@@)(@@)(@@) $ 8501 - شبيب بن مهران أبو زياد القسملي البصري يروي عن قتادة روى عنه المعلى بن أسد(@)(@@)(@@)(@@) $ 8502 - شبيب بن عمر الحارثي يروي عن صالح بن روبة روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 8503 - شبيب بن الحكم بن ميناء يروي عن أبيه عن أبي هريرة روى عنه عبد الرحمن بن أبي الزناد(@)(@@)(@@)(@@) $ 8504 - شهاب بن شرنفة المجاشعي العابد من أهل البصرة يروي عن الحسن روى عنه بن المبارك(@)(@@)(@@)(@@) $ 8505 - شريك بن طارق يروي عن فروة بن نوفل عن عائشة روى عنه عبد الملك بن عمير PageV06P443(@)(@@)(@@)(@@) $ 8506 - شريك البرجمي يروي عن زاذان عن علي قوله روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 8507 - شريك بن عبد الله بن الحارث بن أوس بن الحارث النخعي كنيته أبو عبد الله كان مولده بخراسان قال منصور بن أبي مزاحم سمعت شريكا يقول ولدت ببخارى مقتل قتيبة بن مسلم سنة خمس وتسعين ويروي شريك عن أبي إسحاق وسلمة بن كهيل روى عنه بن المبارك وأهل العراق وولى القضاء بواسط سنة خمسين ومائة ثم ولى الكوفة بعد ذلك ومات بالكوفة سنة سبع أو ثمان وسبعين ومائة وكان في آخر أمره يخطىء فيما يروي تغير عليه حفظه فسماع المتقدمين عنه الذين سمعوا منه بواسط ليس فيه تخليط مثل يزيد بن هارون وإسحاق الأزرق وسماع المتأخرين عنه بالكوفة فيه أوهام كثيرة(@)(@@)(@@)(@@) $ 8508 - شيبة بن نصاح بن سرجس بن يعقوب مولى أم سلمة وقد قيل 
ms1053	 إنه سمع أم سلمة وهو صغير وقد ذكرناه في التابعين يروي عن بن المسيب والقاسم بن محمد وكان قاضيا بالمدينة روى عنه محمد PageV06P444 بن إسحاق وابن أبي الموالي وكان إمام أهل المدينة في القراءة ولا نعلم أحدا روى عن أبيه نصاح إلا ابنه شيبة(@)(@@)(@@)(@@) $ 8509 - شيبة بن هشام الراسبي يروي عن سالم بن عبد الله روى عنه شعبة وحماد بن زيد(@)(@@)(@@)(@@) $ 8510 - شيبة بن مساور يروي عن عبد الله بن عبيد بن عمير روى عنه عبد الكريم وعباد بن أبي على(@)(@@)(@@)(@@) $ 8511 - شيبة بن نعامة أبو نعامة الضبي من أهل الكوفة يروي عن العراقيين روى عنه الثوري وهشيم وجرير بن عبد الحميد(@)(@@)(@@)(@@) $ 8512 - شيبة بن الأحنف الأوزاعي من أهل الشام يروي عن أبي سلام الأسود روى عنه الوليد بن مسلم(@)(@@)(@@)(@@) $ 8513 - شيبة الحضرمي يروي عن عروة بن الزبير روى عنه إسحاق بن عبد الله بن أبي طلحة(@)(@@)(@@)(@@) $ 8514 - شيبة الكاتب يروي عن المدنيين وعمر بن عبد العزيز روى عنه إياس بن دغفل(@)(@@)(@@)(@@) $ 8515 - شيبة شيخ يروي عن أبي جعفر محمد بن علي بن الحسين روى عنه بن جريج إن لم يكن بن نصاح فلا أدري من هو PageV06P445(@)(@@)(@@)(@@) $ 8516 - شعبة بن الحجاج بن الورد الواسطي مولى عتيك كنيته أبو بسطام يروي عن قتادة وأبي إسحاق روى عنه الثوري وحماد بن سلمة والبصريون كان مولده سنة ثلاث وثمانين بنهريان قرية أسفل من واسط ومات سنة ستين ومائة في أولها وله يوم مات سبع وسبعون سنة وكان أكبر من سفيان بعشر سنين وكان من سادات أهل زمانه حفظا وإتقانا وورعا وفضلا وهو أول من فتش بالعراق عن أمر المحدثين وجانب الضعفاء والمتروكين حتى صار علما يقتدى به ثم تبعه عليه بعده أهل العراق حدثنا أحمد بن يحيى بن زهير قال ثنا بندار قال ثنا محمد بن جعفر قال ثنا شعبة قال رأيت الحسن بن أبي الحسن وعليه عمامة سوداء(@)(@@)(@@)(@@) $ 8517 - شعبة بن يزيد الحنفي يروي عن عبيد الله بن عبد الله بن عمر 
ms1054	 والقاسم بن محمد عداده في أهل اليمامة روى عنه عمر بن يونس وابنه يحيى بن شعبة(@)(@@)(@@)(@@) $ 8518 - شعبة بن عبد الرحمن المدني يروي عن سعيد بن المسيب روى عنه سعيد بن أبي أيوب والليث بن سعد PageV06P446(@)(@@)(@@)(@@) $ 8519 - شعبة بن دينار يروي عن عكرمة وأبي بردة بن أبي موسى الأشعري روى عنه بن عيينة حدثنا بن مكرم بالبصرة قال ثنا نصر بن علي قال ثنا سفيان بن عيينة قال ثنا كوفي لنا يقال له شعبة سمع أبا بردة عن أبي موسى عن النبي صلى الله عليه وسلم قال من أعتق رقبة مؤمنة أعتق الله بكل عضو منها عضوا منه من النار(@)(@@)(@@)(@@) $ 8520 - شعبة بن عجلان الإسكاف أبو عمرو العتكي من أهل البصرة يروى عن بن سيرين روى عنه موسى بن إسماعيل(@)(@@)(@@)(@@) $ 8521 - شعبة بن أبي روق يروي عن الشعبي روى عنه زكريا بن أبي زائدة(@)(@@)(@@)(@@) $ 8522 - شعبة شيخ يروي عن كريب بن أبرهة روى عنه سليط بن شعبة الشعباني لست أعرفه ولا أباه(@)(@@)(@@)(@@) $ 8523 - شقيق بن عبد الله الضبي قوله عداده في أهل الكوفة روى عنه أبو حصين وعاصم بن أبي النجود(@)(@@)(@@)(@@) $ 8524 - شقيق بن حيان يروي عن منصور بن صفية روى عنه محمد بن أبى يعقوب PageV06P447(@)(@@)(@@)(@@) $ 8525 - شرحبيل بن سعيد بن سعد بن عبادة الخزرجي من أهل المدينة يروي عن أبيه عن جده سعد بن عبادة روى عنه ابنه عمرو بن شرحبيل(@)(@@)(@@)(@@) $ 8526 - شرحبيل بن شريك المعافري كنيته أبو محمد من أهل مصر يروي عن أبي عبد الرحمن الحبلي روى عنه حيوة بن شريح(@)(@@)(@@)(@@) $ 8527 - شرحبيل بن مدرك الجعفي من أهل الكوفة يروي عن أبيه عن بن عباس روى عنه أبو أسامة(@)(@@)(@@)(@@) $ 8528 - شيبان الراعي من عباد أهل مرو يروي عن سفيان الثوري روى عنه أهل بلده وكان من الأمارين بالمعروف وسكة شيبان بمرو تعرف به وهو صاحب حكايات عجيبة مروية وكان بن المبارك لا يميل إليه لميله إلى مذهب الرأي(@)(@@)(@@)(@@) $ 8529 - شيبان بن زهير بن شقيق بن ثور أبو 
ms1055	 العوام السدوسي من أهل البصرة يروي عن قتادة وعبد الرحمن بن أبي بكرة روى عنه الحارث بن مرة الحنفي PageV06P448(@)(@@)(@@)(@@) $ 8530 - شيبان بن عبد الرحمن أبو معاوية النحوي التميمي المؤدب أصله من البصرة سكن الكوفة يروي عن الحسن وقتادة روى عنه عبيد الله بن موسى وأبو نعيم مات سنة أربع وستين ومائة ببغداد(@)(@@)(@@)(@@) $ 8531 - شيبان اللحام يروي عن بن الحنفية روى عنه سالم بن أبي حفصة(@)(@@)(@@)(@@) $ 8532 - شرقي بن قطامي يروي عن محمد بن زياد روى عنه يزيد بن هارون وقد قيل إن شرقي وقطامي جميعا لقبان وهو الوليد بن حصين بن حبيب بن جمال الكلبي كان اسم شرقي الوليد واسم قطامي حصين(@)(@@)(@@)(@@) $ 8533 - شرقي البصري يروي عن عكرمة روى عنه شعبة(@)(@@)(@@)(@@) $ 8534 - شرقي الجعفي يروي عن سويد بن غفلة روى عنه جابر الجعفي(@)(@@)(@@)(@@) $ 8535 - شرقي شيخ يروي عن أبي وائل روى عنه العوام بن حوشب(@)(@@)(@@)(@@) $ 8536 - شراحيل بن عمرو أبو عمرو العنسي من أهل الشام يروى PageV06P449 عن عمرو بن الأسود وعبادة بن نسي روى عنه شرحبيل بن مسلم الخولاني(@)(@@)(@@)(@@) $ 8537 - شراحيل بن مرثد الصنعاني أبو عثمان صاحب الفتوح يروي المراسيل روى عنه أهل الشام(@)(@@)(@@)(@@) $ 8538 - شراحيل بن يزيد المعافري من أهل مصر يروي عن مسلم بن يسار وعبد الرحمن بن رافع التنوخي روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 8539 - شملة بن عبد الله شيخ يروي عن رجاء بن حيوة روى عنه المبارك بن فضالة(@)(@@)(@@)(@@) $ 8540 - شمر بن عطية بن عبد الرحمن الأسدي الكابلي من أهل الكوفة يروي عن المغيرة بن سعد بن الأخرم وشهر بن حوشب وروى عنه الأعمش وفطر بن خليفة مات في ولاية خالد بن عبد الله على العراق(@)(@@)(@@)(@@) $ 8541 - شمر بن عكرمة بن صعصعة بن صوحان العبدي يروي عن مولى لهم روى عنه فضل بن مرزوق PageV06P450(@)(@@)(@@)(@@) $ 8542 - شوذب مولى الشعبي كنيته أبو عثمان وقد قيل أبو معاذ يروي عن الحسن والشعبي روى عنه شعبة والثوري(@)(@@)(@@)(@@) $ 8543 - شميط بن عجلان العابد التيمي من أهل البصرة كنيته أبو عبيد 
ms1056	 الله أخو الأخضر بن عجلان يروي عن مالك بن دينار والبصريين روى عنه ابنه عبيد الله بن شميط(@)(@@)(@@)(@@) $ 8544 - شجاع بن أبي شجاع صاحب السابري من أهل البصرة يروي عن معاوية بن قرة روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 8545 - شجاع بن الوليد بن قيس السكوني أبو بدر من أهل الكوفة سكن بغداد يروي عن إسماعيل بن أبي خالد ويحيى بن سعيد الأنصاري والأعمش مات سنة أربع أو خمس ومائتين روى عنه ابنه أبو همام الوليد بن شجاع وأهل العراق(@)(@@)(@@)(@@) $ 8546 - شعوذ بن عبد الرحمن أبو عمر الرحبي من أهل الشام يروى PageV06P451 عن بن عائذ وخالد بن معدان روى عنه معاوية بن صالح وجنادة بن محمد المزني(@)(@@)(@@)(@@) $ 8547 - شجرة بن عبد الله المصري أبو محمد يروي عن أبي عبد الرحمن المهري أنه سجد مع عمر بن الخطاب في الحج سجدتين روى عنه بكر بن مضر(@)(@@)(@@)(@@) $ 8548 - شهم بن المقدام من أهل الكوفة يروي عن الشعبي روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 8549 - شبة بن عقال بن صعصعة بن ناجية المجاشعي يروي عن أبيه عن جده صعصعة وله صحبة روى عنه ابنه عقال بن شبة من أهل حران(@)(@@)(@@)(@@) $ 8550 - شبل بن العلاء بن عبد الرحمن بن يعقوب مولى الحرقة كنيته أبو المفضل يروي عن أبيه روى عنه بن أبي فديك بنسخة مستقيمة حدثنا بها الفضل بن محمد العطار بأنطاكية قال ثنا أحمد بن الوليد بن برد الأنطاكي قال ثنا بن أبي فديك قال ثنا شبل بن العلاء عن أبيه PageV06P452(@)(@@)(@@)(@@) $ 8551 - شباك الضبي من أهل الكوفة يروي عن إبراهيم النخعي روى عنه المغيرة بن مقسم حدثنا محمد بن قتيبة قال ثنا الفرياناني قال ثنا محمد بن فضيل عن أبيه قال سمعت شباكا يقول رب شباك لو شئت جعلت شباكا يطيعك ولا يعصيك ثم يبكى حتى تبل لحيته(@)(@@)(@@)(@@) $ 8552 - شرحاف بن المختار التميمي يروي عن عكرمة روى عنه بكر بن بكار(@)(@@)(@@)(@@) $ 8553 - شعيث بن عبد الله بن زبيب العنبري الأعرابي التميمي يروي عن أبيه 
ms1057	 عن جده روى عنه موسى بن إسماعيل وأحمد بن عبدة الضبي PageV06P453(@)(@@)(@@)(@@) || (باب الصاد)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى عن التابعين من أتباعهم ممن ابتدأ اسمه على الصاد(@)(@@)(@@)(@@) $ 8554 - صالح بن إبراهيم بن محمد بن طلحة بن عبيد الله التيمي القرشي من أهل المدينة يروي عن أبيه عن سعد بن أبي وقاص روى عنه طلحة بن صالح(@)(@@)(@@)(@@) $ 8555 - صالح بن إبراهيم بن عبد الرحمن بن عوف يروي عن محمود بن لبيد الأشهلي عن محمد بن مسلمة روى عنه ابناه سالم وصالح ابنا صالح بن إبراهيم وقد قيل إنه سمع من أنس بن مالك(@)(@@)(@@)(@@) $ 8556 - صالح بن كيسان مولى بني غفار من أهل المدينة وكان مؤدبا لعمر بن عبد العزيز يروي عن عبيد الله بن عبد الله بن عتبة والزهري ونافع وكان من فقهاء المدينة والجامعين للحديث والفقه من ذوى الهيبة والمروة كنيته أبو محمد روى عنه عمرو بن PageV06P454 دينار ومالك وأهل المدينة وقد قيل إنه سمع من بن عمر وما أراه بمحفوظ ومات صالح بعد سنة أربعين ومائة(@)(@@)(@@)(@@) $ 8557 - صالح بن عطاء بن خباب مولى بني الديل يروي عن عطاء بن أبي رباح روى عنه جعفر بن ربيعة(@)(@@)(@@)(@@) $ 8558 - صالح بن عطاء المكي يروي عن عمرو بن دينار روى عنه سعيد بن أبي أيوب أحسبه الأول(@)(@@)(@@)(@@) $ 8559 - صالح بن أرتبيل يروي عن محارب بن دثار روى عنه جابر بن نوح(@)(@@)(@@)(@@) $ 8560 - صالح البراد من أهل البصرة يروي عن أبي الأسود الديلي روى عنه أبو هلال الراسبي(@)(@@)(@@)(@@) $ 8561 - صالح بن خباب الفزاري من أهل الكوفة يروي عن حصين بن عقبة الفزاري وخرشة بن الحر روى عنه العلاء بن PageV06P455 المسيب حدثنا بن مكرم بالبصرة قال ثنا عثمان بن أبي شيبة قال ثنا جرير بن عبد الحميد عن العلاء بن المسيب عن صالح بن خباب عن خرشة بن الحر عن عبد الله بن سلام قال لا أحدثكم إلا عن نبي مرسل وكتاب منزل أن عبدا لو أذنب كل ذنب ثم تاب 
ms1058	 إلى الله قبل موته بيوم قبل منه(@)(@@)(@@)(@@) $ 8562 - صالح بن جبلة يروي عن قيس بن عبدة روى عنه شهاب بن خراش الحوشبي(@)(@@)(@@)(@@) $ 8563 - صالح بن حسان يروي عن سعيد بن المسيب وأبي سلمة روى عنه بكير بن الأشج ويزيد بن أبي حبيب وابن أبي ذئب وليس هذا بصالح بن حسان الأنصاري ذاك ضعيف(@)(@@)(@@)(@@) $ 8564 - صالح بن أبي جبير مولى الحكم بن عمرو الغفاري يروي عن أبيه عن رافع بن عمرو روى عنه أبو تميلة يحيى بن واضح والفضل بن موسى الشيباني PageV06P456(@)(@@)(@@)(@@) $ 8565 - صالح بن درهم الدهان من أهل البصرة كنيته أبو الأزهر وقد قيل أبو روح يروي عن العراقيين روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 8566 - صالح بن رستم أبو عامر الخزاز من أهل البصرة يروى عن بن أبي مليكة والحسن روى عنه هشيم ويحيى القطان وابنه عامر بن صالح مات سنة ثنتين وخمسين ومائة(@)(@@)(@@)(@@) $ 8567 - صالح بن راشد أبو عبد الله الخياط بصري يروي عن الحسن ومالك بن دينار روى عنه حرمي بن عمارة والتبوذكي(@)(@@)(@@)(@@) $ 8568 - صالح بن رستم الدمشقي من أهل الشام يروي عن مكحول روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 8569 - صالح بن عبيد يروي عن قبيصة بن وقاص روى عنه عمار بن عمارة بن غزية(@)(@@)(@@)(@@) $ 8570 - صالح بن أبي عريب يروي عن كثير بن مرة روى عنه عبد الحميد بن جعفر PageV06P457(@)(@@)(@@)(@@) $ 8571 - صالح بن عبيد أبو مصعب يروي عن وهب بن منبه روى عنه علي بن عبد الله بن المديني(@)(@@)(@@)(@@) $ 8572 - صالح بن حصين بن صالح المدني يروي عن أبيه روى عنه إسماعيل بن أبي أويس(@)(@@)(@@)(@@) $ 8573 - صالح بن روبة يروي عن العراقيين روى عنه يونس بن أبي إسحاق(@)(@@)(@@)(@@) $ 8574 - صالح بن روبة السمان قوله روى عنه عثمان بن أبي زرعة وعبد الحميد بن أبي جعفر الفراء لست أدري هو الأول أم غيره(@)(@@)(@@)(@@) $ 8575 - صالح بن دينار الهلالي يروي عن عمرو بن الشريد عن أبيه روى عنه عامر الأحول(@)(@@)(@@)(@@) $ 8576 - صالح مولى مازن يروي عن عبيد بن 
ms1059	 عمير في قوله عز وجل يا أيها الرسل كلوا من الطيبات واعملوا صالحا قال لم يرض الله من PageV06P458 الرسل ولا من غيرهم إلا بالطيب روى عنه الحسين بن واقد(@)(@@)(@@)(@@) $ 8577 - صالح بن رافع يروي عن جبير بن نفير روى عنه حسان بن نوح(@)(@@)(@@)(@@) $ 8578 - صالح بن يحيى بن المقدام بن معدي كرب يروي عن أبيه عن جده المقدام روى عنه سلم بن سليم الكناني يخطىء(@)(@@)(@@)(@@) $ 8579 - صالح بن سعيد يروي عن المدنيين وعمر بن عبد العزيز روى عنه سعيد بن السائب(@)(@@)(@@)(@@) $ 8580 - صالح بن سلمان يروي المراسيل روى عنه بكير بن شهاب(@)(@@)(@@)(@@) $ 8581 - صالح بن رتبيل يروي المراسيل روى عنه عمران بن حدير وليس هذا بصالح بن أرتبيل الذي روى عنه جابر بن نوح(@)(@@)(@@)(@@) $ 8582 - صالح بن سعيد يروي عن نافع بن جبير روى عنه بن جريج PageV06P459(@)(@@)(@@)(@@) $ 8583 - صالح بن أبي سلمة يروي عن مجاهد روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 8584 - صالح بن سرج الشني يروي عن عمران بن حطان عن عائشة روى عنه عمرو بن العلاء اليشكري أبو العلاء(@)(@@)(@@)(@@) $ 8585 - صالح بن أبي شعيب العكلي يروي عن الشعبي روى عنه وكيع وأبو نعيم(@)(@@)(@@)(@@) $ 8586 - صالح بن أبي صالح السمان واسم أبيه ذكوان مولى جويرية بنت الأحمس الغطفاني يروي عن أبيه روى عنه هشام بن عروة وهو أخو سهيل وعباد بنى أبي صالح حدثني أبو بدر قال حدثنا أبي قال ثنا شعيب بن إسحاق قال ثنا هشام بن عروة عن صالح بن أبي صالح السمان عن أبيه عن أبي هريرة أن رسول الله صلى الله عليه وسلم قال لا يصبر أحد على لأواء المدينة وجهدها PageV06P460 إلا كنت له شفيعا وشهيدا(@)(@@)(@@)(@@) $ 8587 - صالح بن أبي صالح الأسدي يروي عن عبد خير روى عنه عطاء بن مسلم الحلبي(@)(@@)(@@)(@@) $ 8588 - صالح بن صالح بن مسلم بن حي الثوري الهمداني من أهل الكوفة كنيته أبو حي من ثور همدان والد على والحسن ابني صالح يروي عن الشعبي وأبي السفر روى عنه الثوري وابن عيينة 
ms1060	(@)(@@)(@@)(@@) $ 8589 - صالح بن عبيد الله بن أبي رافع مولى النبي صلى الله عليه وسلم يروي عن أبيه روى عنه ابنه رباح بن صالح رواه بن أبي أويس عن عبد الملك بن إبراهيم بن جبر عن رباح بن صالح PageV06P461(@)(@@)(@@)(@@) $ 8590 - صالح بن عبد الله مولى لآل على يروي عن أبيه عن على روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 8591 - صالح بن مرداس قال سمعت الحسن يقول في قوله ذلك ما كنت منه تحيد قال فاسق في الحياة حياد عند الموت روى عنه الحوضي(@)(@@)(@@)(@@) $ 8592 - صالح بن عبد الله بن أبي فروة القرشي الأموي مولى آل عثمان بن عفان من أهل المدينة يروي عن عامر بن سعد بن أبي وقاص روى عنه الزهري مات سنة أربع وعشرين ومائة كنيته أبو عروة وقد قيل أبو عفراء وهو أخو عبد الأعلى وعبد الحكيم وعمار وإسحاق بني عبد الله بن أبي فروة(@)(@@)(@@)(@@) $ 8593 - صالح بن قدامة بن عبد الله بن إبراهيم بن محمد بن حاطب الجمحي القرشي يروي عن عبد الله بن دينار روى عنه إسحاق بن راهويه وابن كاسب PageV06P462(@)(@@)(@@)(@@) $ 8594 - صالح بن أبي صالح الأسدي يروي عن الشعبي روى عنه زكريا بن أبي زائدة كذا عند بعض صالح بن صالح الأسدي وهو خطأ لأن صالح بن صالح الأسدي يروي عن الشعبي وعبد خير ولا يروي عن غيرهما وصالح بن أبي صالح سدوسي يروي عن علي بن أبي طالب ولم نذكره في التابعين(@)(@@)(@@)(@@) $ 8595 - صالح بن عبد الرحمن بن المسور المدني يروي عن عائشة بنت سعد روى عنه مزاحم بن زفر(@)(@@)(@@)(@@) $ 8596 - صالح بن غزوان الحفار يروي عن سعد بن مسعود التيمي عن بن عباس روى عنه حبان بن هلال(@)(@@)(@@)(@@) $ 8597 - صالح بن عجلان يروي المراسيل روى عنه سليمان بن بلال(@)(@@)(@@)(@@) $ 8598 - صالح بن مسلم العجلي يروي عن الشعبي روى عنه جرير PageV06P463 بن عبد الحميد ثنا محمد بن المنذر قال حدثنا أحمد بن منصور قال ثنا محمد بن كناسة قال ثنا صالح بن مسلم العجلي لقد نزلوا 