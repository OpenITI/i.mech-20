ms276	 %~% ناله آن از نوایب زار چون آواز زیر PageV1P0419(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 زهی ز بارگه ملک تو سفیر سفیر %~% زمان زمان سوی این بنده غریب اسیر(@)(@@) 2 زهی بنان تو توجیه رزق را قانون %~% خهی بیان تو آیات ملک را تفسیر(@)(@@) 3 به ظل جاه تو در پایه سپهر نهان %~% به چشم جود تو در مایه وجود حقیر(@)(@@) 4 نوال دست تو بطلان منت خورشید %~% نسیج کلک تو عنوان نامه تقدیر(@)(@@) 5 به سعی نام تو شد فال مشتری مسعود %~% ز عکس رای تو شد جرم آفتاب منیر(@)(@@) 6 گه نفاذ زهی فتنه‌بند کارگشای %~% گه وقار زهی جرم بخش عذرپذیر(@)(@@) 7 کند روانی حکم تو باد را حیران %~% دهد شمایل حلم تو خاک را تشویر(@)(@@) 8 که بود جز تو که در ملک شاه و ملک خدای %~% هرآنچه جست ز اقبال یافت جز که نظیر(@)(@@) 9 بر آستانه قدرت قضا نیارد گفت %~% که جست باد گمان یا نشست گرد ضمیر(@)(@@) 10 سموم حادثه از خصمت ار بگرداند %~% پیاز چرخ که در جنب قدر تست قصیر(@)(@@) 11 به انتقام تو نشگفت اگر قضا و قدر %~% بهانه‌جوی به لوزینه در دهندش سیر(@)(@@) 12 فکند رای تو در خاک راه رایت مهر %~% نبشت کلک تو بر آب جوی آیت تیر(@)(@@) 13 صریر کلک تو در حشر کشتگان نیاز %~% ز نفخ صور زیادت همی کند تاثیر(@)(@@) 14 بزرگوارا در حسب حال آن وعده %~% که شد به عون تو بیرون ز عقده تاخیر(@)(@@) 15 به وجه رمز در این شعر بیتکی چندست %~% که از تامل آن هیچگونه نیست گزیر(@)(@@) 16 سزد ز لطف توگر استماع فرمایی %~% بدان دقیقه که آن بیتها کندتقریر(@)(@@) 17 ز دست آن پدر فتح کز پی تعریف %~% ردیف کنیت او شد ز ابتدا دو امیر(@)(@@) 18 به من رسید ز همنام چشم و چشمه مهر %~% به قدر جزو نخست از دو حرف لفظ صریر(@)(@@) 19 چنین نمد که جزو دوم همی آرند 
ms277	 %~% درین دو هفته به فرمان شاه و امر وزیر(@)(@@) 20 به اهتمام خداوند کز عنایت اوست %~% هزار همچو تو فارغ دل از صغیر و کبیر(@)(@@) 21 دعات گفتم و جای دعات بود الحق %~% در آن مضیق که آنرا جز این نبد تدبیر(@)(@@) 22 بلی توقع من بنده خود همین بودست %~% چه در قدیم و حدیث و چه در قلیل و کثیر(@)(@@) 23 به لطف تو که نپذرفت کثرتش نقصان %~% به سعی تو که نیالود دامنش تقصیر(@)(@@) 24 همیشه تا نبود در قیاس پیر جوان %~% مطیع بخت جوان تو باد عالم پیر(@)(@@) 25 ز اشک دیده بدخواه تو سفید چو قار %~% زرشک روز بد اندیش تو سیاه چو قیر PageV1P0420(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای به نسبت با تو هرچه اندر ضمیر آمد حقیر %~% پایه تست آنکه ناید از بلندی در ضمیر(@)(@@) 2 از وزارت را جلال و آفرینش را کمال %~% ای جهان را صدر و دین را مجد و دنیا را مجیر(@)(@@) 3 صاحب صاحب نشانی خواجه سلطان نشان %~% راستی به می‌ندانم پادشاهی یا وزیر(@)(@@) 4 حضرتت قصریست او را کمترین سقفی سپهر %~% مسندت اصلی است او را کمترین فرعی مدیر(@)(@@) 5 رفق امید افکنت خواهندگان را پایمرد %~% جود عاجز پرورت افتادگان را دستگیر(@)(@@) 6 کهربا رنگ آمد اندر بیشه قهرت بقم %~% ارغوان رنگ آمد اندر باغ انصافت زریر(@)(@@) 7 در زمین دولتت چون طول و عرض آسمان %~% دور آسانی طویل و عمر دشواری قصیر(@)(@@) 8 داده سرهنگان درگاهت دو پیکر را کمر %~% کرده شاگردان دیوانت عطارد را دبیر(@)(@@) 9 طوف حاجت را به از کوی تو کو رکن مقام %~% کشت روزی را به از دست تو کو ابر مطیر(@)(@@) 10 با دل و دست تو هم در عرض اول گشته‌اند %~% آب از فوج سراب و بحر از خیل غدیر(@)(@@) 11 آستان دیگری کی قبله عالم شود %~% در جهان تا مرحبا گویان در تست از صریر(@)(@@) 12 بس بود در معرض آرام 
ms278	 و آشوب جهان %~% کارداران نفاذت هم بشیر و هم نذیر(@)(@@) 13 گرچه قومی در نظام کارها صورت کنند %~% کاسمان فرمان‌گذارست و زمین فرمان‌پذیر(@)(@@) 14 عاقلان دانند کاندر حل و عقد روزگار %~% کار کن بخت جوان تست نه گردون پیر(@)(@@) 15 زیر قهر منهیان حزم تو امروز هست %~% هرچه در فردا نهانست از قلیل و از کثیر(@)(@@) 16 نام امکان از چه معنی در جهان واقع شود %~% کان نیابی گر بخواهی جز یکی یعنی نظیر(@)(@@) 17 خصم اگر گوید که من همچون توام گو آب را %~% بس که بندد چون هوا جنبان شود نقش حریر(@)(@@) 18 لیک از ناهید گردون پرس تا بر شاهرود %~% هیچ تار عنکبوت انرد طنین آمد چو زیر(@)(@@) 19 کی بود ماه مقنع همچو ماه آسمان %~% گرچه کوته دیدگان را در خیال افتد منیر(@)(@@) 20 مشرق صبح حسود تو ز شام آبستن است %~% زانکه هرگز برنیاید هیچ صبحش جز که قیر(@)(@@) 21 بختی بخت تو نامد زیر ران کبریا %~% گو جرس چندان که خواهی می‌کن از جنبش نفیر(@)(@@) 22 آفتاب آسمان درع و مه کوکب حشم %~% از سپاه دی کی اندیشند تیز و زمهریر(@)(@@) 23 صاحبا صدرا خداوندا کریما بنده را %~% تا که باشد هست از این خدمت چو از جان ناگزیر(@)(@@) 24 احتیاج او که هرگز جز به درگاهت مباد %~% در اضافت هست با انعام تو چون طفل و شیر(@)(@@) 25 گر کمان التفات از ره فرو گردی رواست %~% در هوای تو بحمدالله دلی دارم چو تیر(@)(@@) 26 صدق او نقدیست اندر خدمتت نیکو عیار %~% چند بر سنگش زنی خود ناقدی داری بصیر(@)(@@) 27 عرضه کن بر رای خود گر هیچ غش یابی درو %~% بعد از آن گر کیمیا داری بخیلی برمگیر(@)(@@) 28 ده زبان چون سوسن و ده‌دل چو سیرم کس ندید %~% آخرم تا کی دهی بی‌جرم در لوزینه سیر(@)(@@) 29 گر فطیری در تنوری بستم آن دوران گذشت %~% چرخ از آن سهوم برون آورد 
ms279	 چون موی از خمیر(@)(@@) 30 تا که باشد آسمانی را که خاک صدر تست %~% شکل ذاتی احسن‌الاشکال و هوالمستدیر(@)(@@) 31 تا که باشد آفتابی را که عکس رای تست %~% لون ذاتی احسن‌الالوان و هوالمستنیر(@)(@@) 32 تابع رای تو بادا آسمان اندر مدار %~% مسرع حکم تو بادا آفتاب اندر مسیر(@)(@@) 33 طاعتت را سخت پیمان هم وضیع و هم شریف %~% خدمتت را نرم گردون هم صغیر و کم کبیر(@)(@@) 34 پاسبان و پرده‌دار حضرتت کیوان و ماه %~% مطرب و مدحت سرای مجلست ناهید و تیر PageV1P0421(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بر من آمد خورشید نیکوان شبگیر %~% به قد چو سرو بلند و برخ چو بدر منیر(@)(@@) 2 هزار جان لب لعلش نهاده بر آتش %~% هزار دل سر زلفش کشیده در زنجیر(@)(@@) 3 گشاده طره او بر کیمن جانها دست %~% کشیده غمزه او در کمان ابرو تیر(@)(@@) 4 بدین صفت به وثاق من اندر آمده بود %~% چنان که آمده بی‌اختیار و بی‌تدبیر(@)(@@) 5 نه در موافقتش زحمت رقیب و رهی %~% نه در مقدمه رنج رسول و گنج سفیر(@)(@@) 6 من از خرابی ومستی به عالمی که درو %~% خبر نبودم ازین عالم از قلیل و کثیر(@)(@@) 7 به صد لطیفه به بالین من فراز آمد %~% مرا چو در کف خواب و خمار دید اسیر(@)(@@) 8 به طعنه گفت زهی بی‌ثبات بی‌معنی %~% ز غفلت تو فغان و ز عادت تو نفیر(@)(@@) 9 هزار توبه بکردی ز می هنوز دمی %~% همی جدا نشوی زو چنانکه طفل از شیر(@)(@@) 10 چه جای خواب و خمارست چند خسبی خیز %~% پذیره شو که درآمد به شهر موکب میر(@)(@@) 11 امیر عادل مودود احمد عصمی %~% که عدل اوست به هر نیک و بد بشیر و نذیر(@)(@@) 12 بزرگ بار خدایی که گر قیاس کنند %~% همه جهان ز بزرگیش نیست عشر عشیر(@)(@@) 13 بر آستانه قدرش قضا نیارد گفت %~% که جست باد گمان و نشست گرد ضمیر(@)(@@) 14 هرآنچه خواسته در دهر 
ms280	 کرده جز که ستم %~% هرآنچه جستده ز اقبال دیده جز که نظیر(@)(@@) 15 مدبریست به ملک اندرون چنان صائب %~% که در جنیبت تدبیر او رود تقدیر(@)(@@) 16 نه با عمارت عدلش خرابی از مستی %~% نه در حمایت عفوش مخافت از تغییر(@)(@@) 17 ایا به دامن جاه تو در سپهر نهان %~% و یا به دیده جود تو در وجود حقیر(@)(@@) 18 فکنده رای تو در خاک راه رایت مهر %~% نبشته کلک تو برآب جوی آیت تیر(@)(@@) 19 کند لطافت طبع تو بحر را حیران %~% دهد شمایل حلم تو کوه را تشویر(@)(@@) 20 زرشک قدر تو اشک فلک چو شاخ بقم %~% ز بیم قهر تو روی اجل چو برگ زریر(@)(@@) 21 اگرچه دشمن جاهت همی به خواب غرور %~% همیشه هیچ نبیند مگر سرور و سریر(@)(@@) 22 هزار بار برفتست بر زبان قضا %~% که بر زبان سنان تو راندش تعبیر(@)(@@) 23 که بود با تو همه پوست در وفا چو پیاز %~% که روزگار به لوزینه در ندادش سیر(@)(@@) 24 صریر کلک تو در نشر کشتگان نیاز %~% ز نفخ صور زیادت همی کند تاثیر(@)(@@) 25 حدیث خاصیت نفخ صور و قصه آن %~% مسلمست و روا نیست اندر آن تغییر(@)(@@) 26 قیاس باشد از آن راست‌تر در این معنی %~% دلیل باشد از این خوبتر بر آن تاثیر(@)(@@) 27 که کشتگان جفای زمانه را قلمت %~% معاینه نه خبر زنده می‌کند به صریر(@)(@@) 28 زهی بیان تو اسرار غیب را حاکی %~% زهی بنان تو آیات جود را تفسیر(@)(@@) 29 اگر مقصرم اندر ثنات معذورم %~% که خاطریست پریشان و فکرتیست قصیر(@)(@@) 30 سخن به پایه قدرت نمی‌رسد ورنه %~% به قدر قدرت و قوت نمی‌کنم تقصیر(@)(@@) 31 هزار بار به هر بیت بیش گفت مرا %~% خرد که کل جهان را مدبرست و مشیر(@)(@@) 32 که هان و هان مبر این شعر پیش خدمت او %~% که نقدهای نفایه است و ناقدیست بصیر(@)(@@) 33 برو که فکرت تو نیست مرد این 