ms961	 عن عكرمة، روى عنه داود بن أبي هند.(@)(@@)(@@)(@@) ||| AUTO رضراض(@)(@@) شيخ يروي عن قيس بن ثعلبة، عن عبد الله، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO رمح بن نفيل الكلابي(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه مروان بن معاوية الفزاري، وأبو أسامة.(@)(@@)(@@)(@@) ||| AUTO رقيم بن الشابة(@)(@@) يروي عن أبيه، عن ابن عباس، عداده في أهل مكة، روى عنه ابن عيينة.(@)PageV01P002(@)(@@) [ج 3: ص 358](@)(@@)(@@)(@@) || AUTO باب الزاي(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن روى عن التابعين ممن ابتدأ اسمه على الزاي:(@)(@@)(@@)(@@) ||| AUTO زيد بن علي بن حسين بن علي بن أبي طالب(@)(@@) يروي عن أبيه، روى عنه ابنه حسين بن زيد، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO زيد بن واقد الدمشقي(@)(@@) من أهل الشام، يروي عن مكحول، وبسر بن عبيد الله، روى عنه يحيى بن حمزة، وصدقة بن خالد، يعتبر حديثه من غير رواية ابنه عبد الخالق بن زيد.(@)(@@)(@@)(@@) ||| AUTO زيد بن أرطأة(@)(@@) أخو عدي بن أرطأة الفزاري، يروي عن جبير بن نفير، عداده في أهل الشام، روى عنه ابن جابر، والعلاء بن الحارث.(@)(@@)(@@)(@@) ||| AUTO زيد بن الأخنس(@)(@@) يروي عن سعيد بن المسيب، روى عنه إسماعيل بن أمية.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الرحمن بن معمر بن حزم الأنصاري(@)(@@) أخو أبي طوالة، يروي عن عبد الرحمن الأعرج، روى عنه عبد الله بن أبي بكر بن محمد بن عمرو بن حزم.(@)(@@)(@@)(@@) ||| AUTO زيد بن أيمن(@)(@@) يروي عن عبادة بن نسي، وأهل الشام، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO زيد بن الحباب(@)(@@) يروي عن أبي سعيد مولى بني ليث، عن أبي هريرة، روى عنه صفوان بن سليم.(@)PageV01P002(@)(@@) [ج 3: ص 359](@)(@@)(@@)(@@) ||| AUTO زيد بن الحسن القرشي(@)(@@) من أهل الكوفة، يروي عن معروف بن خربوذ، روى عنه سعيد بن سليمان الواسطي.(@)(@@)(@@)(@@) ||| AUTO زيد بن رفيع الجزري(@)(@@) مولى أسماء بن خارجة، من أهل نصيبين، يروي عن أبي عبيدة بن عبد الله بن مسعود، روى عنه معمر، وأهل بلده، وكان فقيها ورعا فاضلا.(@)(@@)(@@)(@@) ||| AUTO زيد بن أبي أنيسة الجزري(@)(@@) مولى لغني، 
ms962	 كان يسكن الرها، يروي عن سعيد المقبري، روى عنه مالك، وأهل بلده، مات سنة خمس وعشرين ومائة، وهو ابن ست وثلاثين سنة، وكان فقيها ورعا، وهو أخو يحيى بن أبي أنيسة، يحيى ضعيف، وهو ثقة.(@)(@@)(@@)(@@) ||| AUTO زيد بن سلام بن أبي سلام الأسود(@)(@@) أخو معاوية بن سلام، من أهل دمشق، يروي عن أبي سلام، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO زيد، أبو رجاء الأحمسي(@)(@@) يروي عن زاذان عن علي، روى عنه راشد الصائغ.(@)(@@)(@@)(@@) ||| AUTO زيد بن سويد الرقاشي(@)(@@) يروي عن سعيد بن المسيب، روى عنه هارون بن رئاب، وابنه سويد بن زيد.(@)(@@)(@@)(@@) ||| AUTO زيد السراج(@)(@@) يروي عن أبي مجلز، روى عنه المغيرة بن مسلم.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الرحمن بن سعيد بن زيد بن عمرو بن نفيل العدوي القرشي(@)(@@) يروي المراسيل، روى عنه عبد الله بن الحارث المخزومي.(@)PageV01P002(@)(@@) [ج 3: ص 360](@)(@@)(@@)(@@) ||| AUTO زيد بن عطاء بن السائب(@)(@@) يروي عن محمد بن المنكدر، عن جابر، عن النبي صلى الله عليه وسلم قال: رحم الله رجلا كان فيكم سهلا إذا باع، سهلا إذا اشترى، سهلا إذا قضى، سهلا إذا اقتضى. روى عنه إسرائيل بن يونس.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الله بن أبي إسحاق(@)(@@) يروي عن أبيه، عن جده، قال: رأيت عليا بالبصرة وعليه عمامة سوداء من خز فأتيته، فقلت: أين تريد يا أمير المؤمنين؟، قال: شاعران يتهاجيان أفرق بينهما. روى عنه يعقوب بن إسحاق الحضرمي.(@)(@@)(@@)(@@) ||| AUTO زيد أبو عمرو(@)(@@) يروي عن أم حيان، روى عنه فضيل بن منبوذ.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الله بن معمر(@)(@@) يروي عن عبد الرحمن الأعرج، روى عنه عبد الله بن أبي بكر بن محمد بن عمرو بن حزم.(@)(@@)(@@)(@@) ||| AUTO زيد أبو أسامة الحجام(@)(@@) يروي عن عكرمة، عداده في أهل الكوفة، روى عنه أهلها.(@)(@@) (316) -[3: 360] ثنا ابن قتيبة، قال: ثنا يزيد بن موهب، قال: ثنا أبو معاوية، قال: ثنا أبو أسامة، عن عكرمة، عن ابن عباس، قال: لعن رسول الله صلى الله عليه وسلم المؤنثين من الرجال والمذكرات من 
ms963	 النساء.(@)(@@)(@@)(@@) ||| AUTO زيد بن حبان(@)(@@) يروي عن الزهري، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO زيد السلمي(@)(@@) يروي عن أبي جعفر محمد بن علي، روى عنه أبو عبد الله الجعفي.(@)(@@)(@@)(@@) ||| AUTO زيد بن عبد الله بن أبي أمية(@)(@@) يروي عن محمد بن كعب القرظي، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO زيد بن السائب أبو السائب(@)(@@) يروي المقاطيع، روى عنه زيد بن الحباب.(@)PageV01P002(@)(@@) [ج 3: ص 361](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زيد بن عبد الحميد الخطابي(@)(@@) من آل الخطاب، يروي عن أهل المدينة، وعمر بن عبد العزيز، روى عنه الأوزاعي.(@)(@@)(@@)(@@) ||| AUTO زيد بن معاوية العبسي(@)(@@) من أهل الكوفة، يروي عن علقمة، والأسود، روى عنه أبو إسحاق السبيعي، وابنه بشر بن زيد بن معاوية.(@)(@@)(@@)(@@) ||| AUTO زيد بن مرة بن أبي ليلى أبو المعلى(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه المعتمر بن سليمان، وأبو داود.(@)(@@)(@@)(@@) ||| AUTO زيد بن حيان(@)(@@) مولى ربيعة، من أهل البصرة، يروي عن الحسن، روى عنه الجزريون، مات سنة ثمان وخمسين ومائة، وهو أخو عمر بن حيان.(@)(@@)(@@)(@@) ||| AUTO زيد بن المخارق(@)(@@) يروي عن إبراهيم النخعي، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO زيد بن رباح(@)(@@) من أهل المدينة، يروي عن أبي عبد الله الأغر، عن أبي هريرة، روى عنه مالك بن أنس.(@)(@@)(@@)(@@) ||| AUTO زيد بن نفيع(@)(@@) يروي المراسيل، روى عنه أسيد بن أبي أسيد.(@)(@@) زيد(@)(@@) مولى بني هلال، يروي عن الشاميين، وعمر بن عبد العزيز، روى عنه شعبة.(@)(@@)(@@)(@@) ||| AUTO زيد بن صالح الأسدي(@)(@@) من أهل خراسان، يروي عن يحيى بن سعيد الأنصاري، روى عنه أهل بلده.(@)(@@) (317) -[3: 361] حدثني أبو بدر، بحران، قال: ثنا زيد بن صالح الأسدي، قال: ثنا يحيى بن سعيد الأنصاري، عن نافع، عن ابن عمر: أنه طلق امرأته في زمن رسول الله صلى الله عليه وسلم وهي PageV01P002 [ج 3: ص 362] حائض، وأن عمر ذكر ذلك لرسول الله صلى الله عليه وسلم فأمره أن يراجعها حتى تحيض ثم تطهر.(@)(@@)(@@)(@@) ||| AUTO زيد أبو هاشم(@)(@@) مولى بشر بن مالك بن سيار، يروي عن مالك بن يسار، روى عنه 
ms964	 حسين بن حسن.(@)(@@)(@@)(@@) ||| AUTO زياد بن خيثمة الجعفي(@)(@@) من أهل الكوفة، يروي عن أبي إسحاق، روى عنه زهير بن معاوية، وهشيم.(@)(@@)(@@)(@@) ||| AUTO زياد بن حصين بن قيس اليربوعي أبو جهمة(@)(@@) من أهل البصرة، يروي عن أبي العالية، عن ابن عباس، عن النبي صلى الله عليه وسلم قال: ارموا بني إسماعيل، فإن أباكم كان راميا. روى عنه الأعمش، وفطر بن خليفة.(@)(@@)(@@)(@@) ||| AUTO زياد بن سعد الخراساني، كنيته أبو عبد الرحمن(@)(@@) سكن مكة، وكان من الحفاظ المتقنين، يروي عن الزهري، وأبي الزبير، روى عنه ابن جريج، ومالك، وابن عيينة، وكان زياد شريكا لابن جريج.(@)(@@)(@@)(@@) ||| AUTO زياد بن الجعد بن أبي الجعد الأشجعي(@)(@@) من أهل الكوفة، يروي عن عبد الله بن أبي الجعد، روى عنه ابنه نافع بن زياد.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبان(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه إبراهيم بن طهمان.(@)(@@)(@@)(@@) ||| AUTO زياد بن إسماعيل القرشي المكي(@)(@@) يروي عن محمد بن عباد بن جعفر، روى عنه ابن جريج، والثوري.(@)PageV01P002(@)(@@) [ج 3: ص 363](@)(@@)(@@)(@@) ||| AUTO زياد بن أبي زياد الجصاص أبو محمد(@)(@@) من أهل واسط، يروي عن الحسن، وابن سيرين، روى عنه هشيم، ويزيد بن هارون، ربما وهم.(@)(@@) (318) -[3: 363] حدثنا أحمد بن علي بن المثنى، قال: ثنا عبد الله بن مطيع، قال: ثنا هشيم، عن زياد بن أبي زياد، عن الحسن بن أبي الحسن، عن قيس بن عاصم، قال: أتيت النبي صلى الله عليه وسلم فلما دنوت منه سمعته، يقول: هذا سيد أهل الوبر، فسلمت عليه، ثم قلت: يا رسول الله، المال الذي لا يكون علي فيه تبعة من ضيف أضافني، أو عيال إذا كثر؟ فقال: نعم المال الأربعون من الإبل، والأكثر ستون، وويل لأصحاب المئين إلا من أعطى في رسلها، ونجدتها، وأفقر ظهرها، وأطرق فحلها، ونحر سمينها، وأطعم القانع والمعتر، قلت: يا رسول الله، ما أكرم هذه الأخلاق وأحسنها أنه لا يحل بالوادي الذي أنا فيه أكثر من إبلي، قال: فكيف تصنع بالمنيحة؟، قال: قلت: إني لأمنح في كل عام مائة، قال: وكيف 
ms965	 تصنع بالعارية؟، قال: يغدو الإبل ويغدو الناس، فمن أخذ برأس بعير ذهب به، قال: فكيف تصنع بالإفقار؟، قال: إني لأفقر البكر الضرع والناب المدبر، قال: فمالك أحب إليك أو مال مولاك؟، قال: قلت: بل مالي، قال: فإنما لك من مالك ما أكلت فأفنيت، ولبست فأبليت، وأعطيت فأمضيت، وما بقي فلمولاك، قلت: لمولاي؟ قال: نعم، قال: أما والله لئن بقيت لأدعن عدتها قليلا. قال الحسن: ففعل رحمه الله، فلما حضرته الوفاة دعا بنيه، فقال: يا بني، خذوا عني فلا أحد أنصح لكم مني، إذا أنا مت فسودوا كباركم ولا تسودوا صغاركم فتستسفه الناس كباركم ويهونوا عليهم، وعليكم باستصلاح المال فإنه منبهة للكريم ويستغنى به عن اللئيم، وإياكم والمسألة، فإنها آخر كسب الرجل إن أحدا لم يسأل إلا بترك كسبه، وإذا أنا مت فلفوني في ثيابي الذي كنت أصلي فيها وأصوم، وإياكم والنياحة، فإني سمعت رسول الله صلى الله عليه وسلم ينهى عنها، وادفنوني في مكان لا يعلم به أحد، فإنه قد كانت بيننا وبين بكر بن وائل خماشات في الجاهلية، فأخاف أن يدخلوها عليكم في الإسلام فيعيبوا عليكم دينكم، قال الحسن: نصحا في الحياة ونصحا في الممات.(@)(@@)(@@)(@@) ||| AUTO زياد الأعلم الباهلي(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه الحمادان، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي حبيب(@)(@@) قوله، روى عنه صخر بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO زياد بن ثور(@)(@@) يروي المراسيل، روى عنه عبد الرحمن بن عمرو الأوزاعي.(@)PageV01P002(@)(@@) [ج 3: ص 364](@)(@@)(@@)(@@) ||| AUTO زياد أبو بشر(@)(@@) يروي عن الحسن، روى عنه موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO زياد بن حصين بن أوس النهشلي(@)(@@) يروي عن أبيه، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO زياد بن الجراح(@)(@@) مولى عثمان، يروي عن عمرو بن ميمون، وعبد الله بن معقل، روى عنه جعفر بن برقان، وعبد الكريم الجزريان.(@)(@@)(@@)(@@) ||| AUTO زياد بن رياح أبو رياح(@)(@@) يروي عن الحسن، روى عنه حكام الهذلي.(@)(@@)(@@)(@@) ||| AUTO زياد بن سعد المدني الأنصاري(@)(@@) يروي عن أبيه، عن ابن عمر، روى عنه ابنه سعيد بن زياد بن سعد 
ms966	 الأنصاري.(@)(@@)(@@)(@@) ||| AUTO زياد بن رياح أبو قيس(@)(@@) يروي عن الحسن، روى عنه غيلان بن جرير، أحسبه الأول.(@)(@@)(@@)(@@) ||| AUTO زياد بن سلم بن زياد بن أبي سفيان الزيادي، كنيته أبو المغيرة(@)(@@) يروي عن إبراهيم بن جرير، وإسحاق بن عبد الله بن الحارث.(@)(@@)(@@)(@@) ||| AUTO زياد بن عراق(@)(@@) يروي عن طيسلة بن علي الهذلي، عن ابن عمر، روى عنه إسماعيل بن علية في الكبائر السبع.(@)(@@)(@@)(@@) ||| AUTO زياد بن راشد، أبو سفيان(@)(@@) المدني الكاتب، يروي عن داود بن فراهيج، روى عنه علي بن المديني، والناس، وهو مولى محمد بن مسلم بن شهاب الزهري.(@)(@@)(@@)(@@) ||| AUTO زياد بن الشيخ الصنعاني(@)(@@) يروي عن عطاء، روى عنه يحيى بن عمير.(@)PageV01P002(@)(@@) [ج 3: ص 365](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زياد بن أبي هارون الحنفي(@)(@@) من أهل الكوفة، يروي عن عمرو بن مرة، وقيس بن مسلم، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO زياد بن الربيع اليحمدي الأزدي(@)(@@) من أهل البصرة، كنيته أبو خداش، يروي عن ثابت البناني، روى عنه أهل البصرة، مات سنة خمس وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبد الرحمن(@)(@@) يروي عن ابن سيرين، روى عنه عبد الواحد بن واصل.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي زياد أبو شعيب(@)(@@) يروي عن أبي حكيم، روى عنه عبد الله بن المبارك.(@)(@@)(@@)(@@) ||| AUTO زياد بن عباد(@)(@@) يروي عن كعب، روى عنه الضحاك بن يسار.(@)(@@)(@@)(@@) ||| AUTO زياد بن صيفي بن صهيب بن سنان(@)(@@) مولى ابن جدعان التيمي، يروي عن أبيه، روى عنه ابنه عبد الحميد بن زياد.(@)(@@) زياد(@)(@@) مولى عبد الله، يروي عن أم ولد لعبد الله، أحسبه ابن مسعود، روى عنه أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO زياد بن ضميرة بن سعد الضمري(@)(@@) من أهل الحجاز، ويقال: ابن ضمرة، يروي عن الحجازيين، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبد الله البلوي(@)(@@) يروي عن ابن سندر، روى عنه سعيد بن أبي أيوب.(@)PageV01P002(@)(@@) [ج 3: ص 366](@)(@@)(@@)(@@) ||| AUTO زياد(@)(@@) مولى عبيد بن عمير الليثي، من أهل مكة، يروي عن عمرو بن دينار، والقاسم بن أبي بزة، روى عنه عبد الله بن عبيد بن 
ms967	 عمير.(@)(@@)(@@)(@@) ||| AUTO زياد بن عمرو بن هند الجملي(@)(@@) من أهل الكوفة، يروي عن عمران بن حذيفة، عن ميمونة، روى عنه منصور بن المعتمر.(@)(@@)(@@)(@@) ||| AUTO زياد بن عمرو أبو سحابة(@)(@@) يروي عن شعيب بن محمد بن عبد الله، روى عنه حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO زياد بن عثمان(@)(@@) يروي عن عباد بن زياد، روى عنه الحجاج بن الحجاج الأسلمي.(@)(@@)(@@)(@@) ||| AUTO زياد بن المنذر(@)(@@) يروي عن نافع بن الحارث، عن أبي بردة، روى عنه يونس بن بكير.(@)(@@)(@@)(@@) ||| AUTO زياد بن عميرة الصيرفي(@)(@@) يروي عن مولى لعائشة، روى الليث بن سعد، عن أبي هانئ، عنه.(@)(@@)(@@)(@@) ||| AUTO زياد بن كليب، أبو معشر النخعي(@)(@@) من أهل الكوفة، يروي عن الشعبي، وإبراهيم النخعي، روى عنه يونس بن عبيد، وخالد الحذاء، وشعبة، وكان من الحفاظ المتقنين، مات سنة سبع عشرة ومائة.(@)PageV01P002(@)(@@) [ج 3: ص 367](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زياد بن أبي عثمان الحنفي(@)(@@) يروي عن الحسن، وعكرمة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO زياد مولى قيس الحذاء(@)(@@) يروي عن عكرمة، روى عنه أبو مودود.(@)(@@)(@@)(@@) ||| AUTO زياد بن أبي زياد(@)(@@) مولى بن عياش، من أهل المدينة، يروي عن عراك بن مالك، روى عنه ابن الهاد.(@)(@@)(@@)(@@) ||| AUTO زياد أبو العلاء(@)(@@) يروي عن الحسن، روى عنه هشيم بن بشير، وليس هذا بأبي العلاء الثقفي.(@)(@@)(@@)(@@) ||| AUTO زياد بن فياض، أبو الحسن الخزاعي(@)(@@) من أهل الكوفة، يروي عن أبي عياض، وعبد الرحمن بن أنعم، والهزهاز بن ميزن، روى عنه الثوري، وشعبة، مات سنة تسع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO زياد بن جبير بن حية(@)(@@) يروي عن أبيه، عن المغيرة بن شعبة، روى عنه أهل العراق: المبارك بن فضالة، وغيره.(@)(@@)(@@)(@@) ||| AUTO زياد المصفر(@)(@@) مولى مصعب، كنيته أبو عثمان، يروي عن الحسن، روى عنه الثوري.(@)(@@) (319) -[3: 367] حدثنا أبو خليفة، قال: ثنا علي بن المديني، ثنا وكيع، عن سفيان، عن زياد المصفر، عن الحسن، عن ابن مسعود، قال: " وسط كل في الركوع والسجود عشر تسبيحات. "(@)(@@) زياد(@)(@@) مولى محمد بن سيرين، يروي عن محمد بن سيرين، وكان خادمه، روى عنه حماد 
ms968	 بن زيد.(@)(@@)(@@)(@@) ||| AUTO زياد بن مخراق، كنيته أبو الحارث(@)(@@) من أهل البصرة، يروي عن معاوية بن قرة، روى عنه إسماعيل بن علية وأهل البصرة.(@)PageV01P002(@)(@@) [ج 3: ص 368](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زياد بن أبي مسلم(@)(@@) من أهل البصرة، كنيته أبو عمر، يروي عن صالح أبي الخليل، روى عنه وكيع، وأبو نعيم، وكان من عباد أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO زياد بن سوقة(@)(@@) شيخ من أهل المدينة، يروي عن أبي الزبير، روى عنه المنذر بن جهم، قليل الحديث فيما لا يتابع عليه، وقد وهم من زعم أنه أخو محمد بن سوقة، محمد لا أخ له، وهو كوفي، وهذا مدني.(@)(@@)(@@)(@@) ||| AUTO زياد بن عبد الله بن الربيع(@)(@@) يروي عن حميد الطويل، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO زياد بن مسلم(@)(@@) يروي عن أهل المدينة، وعمر بن عبد العزيز، روى عنه معمر بن راشد.(@)(@@) زياد(@)(@@) مولى معيقيب، يروي المراسيل، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO زياد بن مالك أبو السكينة(@)(@@) من أهل الشام، يروي المراسيل، روى عنه أبو بكر بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO زياد بن نعيم الحضرمي(@)(@@) من أهل مصر، يروي عن مسلم بن يسار، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO زياد بن نافع(@)(@@) يروي عن كعب الأحبار، روى عنه بكر بن سوادة.(@)(@@)(@@)(@@) ||| AUTO زياد بن نصر(@)(@@) من أهل وادي القرى، يروي عن سليم بن مطير، روى عنه عبد الرحمن بن شيبة.(@)(@@)(@@)(@@) ||| AUTO زياد أبو هشام(@)(@@) مولى عثمان بن عفان، يروي عن محجن، روى عنه ابنه هشام بن زياد.(@)PageV01P002(@)(@@) [ج 3: ص 369](@)(@@)(@@)(@@) ||| AUTO زياد(@)(@@) شيخ يروي عن زر، عن ابن مسعود، روى عنه إسماعيل السدي، ولا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO زياد بن محمد بن زيد بن عبد الله بن عمر بن الخطاب(@)(@@) أخو واقد، وعمر، وعاصم، وأبي بكر بني محمد بن زيد، من أهل المدينة، يروي عن أبيه، ونافع، روى عنه شعبة، وعمار بن زريق.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عثمان بن عبد الله بن سراقة بن مالك القرشي(@)(@@) من بني عدي بن كعب، يروي عن محمد بن عبد الرحمن بن ثوبان، روى 
ms969	 عنه موسى بن يعقوب الزمعي، قتل سنة إحدى أو ثنتين وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO الزبير بن هشام بن عروة بن الزبير(@)(@@) أخو محمد بن هشام، يروي عن أبيه، وأبوه رأى ابن عمر، ويروي عن أهل المدينة، روى عنه نافع بن يزيد، ومن قال: الزبير بن عروة فقد نسبه إلى جده.(@)(@@)(@@)(@@) ||| AUTO الزبير بن خبيب بن تابت بن عبد الله بن الزبير بن العوام(@)(@@) يروي عن نافع، ومحمد بن عباد بن جعفر، روى عنه معن بن عيسى القزاز.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عيسى(@)(@@) والد الحميدي، يروي عن هشام بن عروة، روى سلمة بن شبيب، عن الخليل بن يزيد، عنه.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عباد بن حمزة بن الزبير بن العوام(@)(@@) يروي عن المدنيين، روى عنه ابنه يحيى بن الزبير.(@)(@@)(@@)(@@) ||| AUTO الزبير بن موسى بن ميناء(@)(@@) يروي عن المدنيين، وعمر بن عبد العزيز، روى عنه المطلب بن كثير.(@)PageV01P002(@)(@@) [ج 3: ص 370](@)(@@)(@@)(@@) ||| AUTO الزبير بن السائب الثقفي(@)(@@) يروي عن عبيد بن عمير، روى عنه عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO الزبير بن خريت(@)(@@) من أهل البصرة، يروي عن عكرمة، روى عنه حماد بن زيد وجرير بن حازم.(@)(@@) (320) -[3: 370] ثنا أبو خليفة، قال: ثنا علي بن المديني، قال: ثنا حماد بن زيد، قال: ثنا الزبير بن خريت، عن عكرمة في الرجل يحلق رأسه يوم النحر، قال: كان لا يرى به بأسا بأن يغسله بالخطمي، ثم يحلقه.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عبيد(@)(@@) يروي عن نافع، ولست أدري من نافع هذا، روى عنه مخلد والد أبي عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO الزبير بن عبد الله بن رهيمة(@)(@@) من أهل المدينة، يروي عن القاسم، ونافع، روى عنه العقدي، وابن المبارك، وهو الذي يروي عن جدته رهيمة خادمة عثمان بن عفان.(@)(@@)(@@)(@@) ||| AUTO الزبير بن سعيد بن سليمان بن نوفل بن الحارث بن عبد المطلب(@)(@@) أمه حمادة بنت يعقوب بن سعيد بن نوفل بن الحارث بن عبد المطلب، مات في ولاية أبي جعفر، وهو يروي عن صفوان بن سليم، وقد أدرك ابن المبارك: الزبير هذا وروى عنه، ويروي عن 
ms970	 عبد الله بن علي بن يزيد بن ركانة، عن جده، أنه طلق امرأته البتة. الحديث.(@)(@@)(@@)(@@) ||| AUTO الزبير أبو عبد السلام(@)(@@) يروي عن أيوب بن عبد الله بن مكرز، عن وابصة بن معبد، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO الزبير أبو خالد(@)(@@) شيخ يروي عن أبان بن عثمان، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO الزبير بن جنادة، أبو عبد الله الهجري(@)(@@) المعلم، سكن مرو، يروي عن PageV01P002 [ج 3: ص 371] عطاء، وابن بريدة، روى عنه عيسى بن يونس، وأبو تميلة، وهو الذي يروي عن عطاء: أنه سئل عن رجل فقئت عينه ليس له عين غيرها، قال: إن كانت عينه أصيبت في سبيل الله فديتها كاملة، وإلا فالنصف. رواه عنه أبو تميلة.(@)(@@)(@@)(@@) ||| AUTO الزبير بن خزيمة(@)(@@) يروي عن أبيه، عن عبد الله بن مسعود، روى عنه محمد بن قيس الأسدي.(@)(@@)(@@)(@@) ||| AUTO الزبير بن خزيمة الخثعمي(@)(@@) قوله، روى عنه الوليد بن عبد الرحمن بن عمرو بن مسافع، وهو الذي يقال له: ابن خزيمة.(@)(@@)(@@)(@@) ||| AUTO الزبير بن الشعشاع(@)(@@) يروي عن أبيه، عن علي، روى عنه طلحة بن حسين الليثي.(@)(@@)(@@)(@@) ||| AUTO الزبير بن نجيح بن مغلس أبو المغلس(@)(@@) يروي عن عمر بن عبد العزيز، وأهل الشام، روى عنه الحسين بن علي الجعفي.(@)(@@)(@@)(@@) ||| AUTO زكريا بن أبي زائدة الهمداني الأعمى، كنيته أبو يحيى(@)(@@) واسم أبي زائدة: فيروز، وقد قيل: خالد، من أهل الكوفة، يروي عن الشعبي، وأبي إسحاق، روى عنه الثوري، ووكيع، وابنه يحيى بن زكريا، مات سنة ثمان أو تسع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO زكريا بن يحيى بن عمارة، أبو يحيى الذراع(@)(@@) من أهل البصرة، يروي عن عبد العزيز بن صهيب، روى عنه أهل بلده، مات سنة سبع وثمانين ومائة، يخطئ.(@)PageV01P002(@)(@@) [ج 3: ص 372](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO زكريا بن يحيى الكندي الأعمى(@)(@@) يروي عن الشعبي، وعكرمة، عداده في أهل الكوفة، روى عنه أبو أسامة، وجعفر بن عون.(@)(@@) زكريا(@)(@@) شيخ كان بالري، يروي عن أبي وائل، روى عنه الثوري.(@)(@@) زكريا(@)(@@) شيخ يروي عن القاسم، روى عنه المسعودي.(@)(@@)(@@)(@@) ||| AUTO زكريا بن 
ms971	 أبي العتيك(@)(@@)(@@)(@@) ||| AUTO وهو الذي يقال له: زكريا بن حكيم، يروي عن أبي جعفر، والشعبي، روى عنه هشيم، والمغيرة بن سليمان.(@)(@@)(@@)(@@) ||| AUTO زكريا بن عمر(@)(@@) يروي عن عطاء، روى عنه ابن جريج، وأحسبه الذي روى عنه منصور بن المعتمر.(@)(@@)(@@)(@@) ||| AUTO زكريا بن صهيب(@)(@@) يروي عن أبي صالح، روى عنه الثوري.(@)(@@) زكريا بن حكيم(@)(@@) يروي عن الحسن، روى عنه عنبسة بن عبد الواحد.(@)(@@)(@@)(@@) ||| AUTO زكريا بن خالد(@)(@@) يروي عن الزهري، روى عنه عنبسة الرازي.(@)(@@)(@@)(@@) ||| AUTO زكريا بن سياه، أبو يحيى(@)(@@) من أهل الكوفة، يروي عن عمران بن مسلم، روى عنه أبو أسامة.(@)(@@)(@@)(@@) ||| AUTO زكريا بن خالد بن زيد بن حارثة الأنصاري(@)(@@) يروي المراسيل، روى عنه مجمع بن يعقوب المدني.(@)PageV01P002(@)(@@) [ج 3: ص 373](@)(@@)(@@)(@@) ||| AUTO زكريا بن إسحاق المكي(@)(@@) يروي عن عمرو بن دينار، ويحيى بن عبد الله بن صيفي، روى عنه ابن المبارك، وأبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO زكريا بن جراد(@)(@@) يروي عن عبد الرحمن السلمي، روى عنه موسى بن قيس الكوفي.(@)(@@)(@@)(@@) ||| AUTO زكريا بن مازن الهذلي(@)(@@) يروي عن الحسن، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO زكريا بن يحيى بن أبي الحواجب(@)(@@) من أهل الكوفة، يروي عن الأعمش، والكوفيين، روى عنه أبو حاتم السجستاني، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO زهير بن سالم العبسي، أبو المخارق(@)(@@) يروي عن الحارث بن أنعم، روى عنه ثور بن يزيد، وصفوان بن عمرو السكسكي.(@)(@@)(@@)(@@) ||| AUTO زهير بن أبي ثابت الأسدي الأعمى، كنيته أبو الأزهر(@)(@@) وهو الذي يقال له: زهير بن حبيب العبسي، يروي عن سليم بن زافر، روى عنه الأجلح.(@)(@@)(@@)(@@) ||| AUTO زهير بن قيس البلوي(@)(@@) من أهل مصر، يروي عن علقمة بن رمثة، روى عنه سويد بن قيس.(@)(@@)(@@)(@@) ||| AUTO زهير بن محمد العنبري(@)(@@) أصله من خراسان، سكن الشام، PageV01P002 [ج 3: ص 374] كنيته أبو المنذر، يروي عن زيد بن أسلم، وهشام بن عروة، روى عنه عبد الرحمن بن مهدي، وأبو عامر العقدي، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO زهير بن معاوية بن الرحيل الجعفي، كنيته أبو خيثمة(@)(@@) من أهل الكوفة، سكن الجزيرة، يروي عن 
ms972	 أبي إسحاق، وأبي الزبير، روى عنه يحيى بن آدم، وأبو نعيم، مات سنة ثلاث أو أربع وسبعين ومائة في رجب، وكان حافظا متقنا، وكان أهل العراق يقولون في أيام الثوري: إذا مات الثوري ففي زهير خلف. وكانوا يقدمونه في الإتقان على غيره من أقرانه.(@)(@@)(@@)(@@) ||| AUTO زهير بن مالك أبو الوازع(@)(@@) يروي عن عاصم بن ضمرة، عداده في أهل الكوفة، روى عنه إسرائيل.(@)(@@)(@@)(@@) ||| AUTO زهير بن هنيد، أبو الذيال العدوي(@)(@@) من أهل البصرة، يروي عن أبي نعامة، روى عنه عبيد الله بن عمر القواريري.(@)(@@)(@@)(@@) ||| AUTO زفر بن صعصعة بن مالك(@)(@@) يروي عن أبيه، عن أبي هريرة، روى عنه إسحاق بن عبد الله بن أبي طلحة.(@)(@@)(@@)(@@) ||| AUTO زفر بن عقيل(@)(@@) يروي عن سعدى بنت الحارث امرأة طلحة بن عبيد الله، روى عنه بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO زفر بن أبي كثير السحيمي(@)(@@) من أهل اليمامة، يروي عن أبيه، واسم أبي كثير: يزيد بن عبد الرحمن، روى عنه ملازم بن عمرو.(@)(@@)(@@)(@@) ||| AUTO زفر بن عاصم(@)(@@) يروي عن أهل المدينة، وعمر بن عبد العزيز، روى عنه مالك بن أنس.(@)PageV01P002(@)(@@) [ج 3: ص 375](@)(@@)(@@)(@@) ||| AUTO زفر بن الهذيل بن قيس(@)(@@) من بلعنبر، كنيته أبو الهذيل الكوفي، وكان من أصحاب أبي حنيفة، يروي عن يحيى بن سعيد الأنصاري، روى عنه شداد بن حكيم البلخي، وأهل الكوفة، وكان زفر متقنا حافظا قليل الخطأ، لم يسلك مسلك صاحبه في قلة التيقظ في الروايات، وكان أقيس أصحابه وأكثرهم رجوعا إلى الحق إذا لاح له، ومات بالبصرة، وكان أبوه من أصبهان، وكان موته في ولاية أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO زائدة بن عمران الجعفي(@)(@@) من أهل الكوفة، يروي عن سويد بن غفلة، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO زائدة بن أوس الكندي(@)(@@) يروي عن أبي عبد الرحمن بن أبزى، روى عنه أبو فروة.(@)(@@)(@@)(@@) ||| AUTO زائدة بن نشيط(@)(@@) يروي عن أبي خالد الوالبي، روى عنه ابنه عمران بن زائدة، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO زائدة بن قدامة الثقفي(@)(@@) من أهل الكوفة، كنيته أبو الصلت، يروي عن أبي إسحاق، ومنصور، 
ms973	 روى عنه أبو أسامة، وأهل العراق، وكان من الحفاظ المتقنين، وكان لا يعد السماع حتى يسمعه ثلاث مرات، وكان لا يحدث أحدا حتى يشهد عنده عدل أنه من أهل .. .، مات سنة إحدى وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO زائدة، بياع الثياب(@)(@@) يروي عن الحسن، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO الزبرقان بن عبد الله بن عمرو بن أمية الضمري(@)(@@) يروي عن أبي سلمة بن عبد الرحمن، روى عنه ابن أبي ذئب، وعمرو بن أبي حكيم، وقد وهم من زعم أنه سمع من زيد بن ثابت، بينه وبين زيد في خبره: عروة بن الزبير.(@)PageV01P002(@)(@@) [ج 3: ص 376](@)(@@)(@@)(@@) ||| AUTO الزبرقان بن عبد الله العبدي(@)(@@) من أهل الكوفة، كنيته أبو الزرقاء، يروي عن كعب بن عبد الله، روى عنه الثوري، وإسرائيل.(@)(@@)(@@)(@@) ||| AUTO الزبرقان بن عبد الله الأسدي السراج(@)(@@) من أهل الكوفة، كنيته أبو بكر، يروي عن أبي وائل، وأبي رزين، روى عنه يحيى القطان، وأبو أسامة، وهو الذي قال: نهاني أبو وائل أن أجالس أصحاب أرأيت أرأيت.(@)(@@)(@@)(@@) ||| AUTO الزبرقان بن الحارث النميري(@)(@@) يروي عن الأحنف بن قيس، روى عنه شريك بن الخطاب.(@)(@@)(@@)(@@) ||| AUTO الزبرقان بن بشير بن عمرو الشيباني، كنيته أبو قيس(@)(@@) يروي عن زيد بن وهب، روى عنه العوام بن حوشب، وقد قيل: ابن يسير بن عمرو.(@)(@@)(@@)(@@) ||| AUTO زبيد بن الحارث الأيامي(@)(@@) من أهل الكوفة، كنيته أبو عبد الرحمن، يروي عن أبي وائل، ومرة، روى عنه منصور، والثوري، مات سنة ثنين وعشرين ومائة، وكان من العباد الخشن مع الفقه في الدين ولزوم الورع الشديد.(@)(@@)(@@)(@@) ||| AUTO زنكل(@)(@@) شيخ يروي(@)(@@) (321) -[3: 376] عن أبي عبيدة بن عبد الله بن مسعود، عن أبيه، قال: إن من خير أخلاق الدنيا والآخرة من رجى خيره وأمن شره، ومن شر أخلاق الدنيا والآخرة من لم يرج خيره ولم يؤمن شره، كيف أنتم إذا غشيتكم فتنة ينشأ فيها الصغير ويربو فيها الكبير، قيل: هذا منكر، فمتى ذلك يا أبا عبد الرحمن؟ قال: إذا كثرت أمراؤكم وقلت أمناؤكم، وكثرت قراءكم والتمس الدنيا بعمل الآخرة، وتفقه لغير 
ms974	 الله. حدثنا الحسن بن سفيان، قال: ثنا سعيد بن حفص النفيلي، قال: ثنا محمد بن سلمة، عن أبي عبد الرحمن، عن زيد بن أبي أنيسة، عن الأعمش، عن زنكل، عن أبي عبيدة، عن أبيه.(@)(@@)(@@)(@@) ||| AUTO زنكل بن علي بن محجن أبو فزارة(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل الجزيرة.(@)PageV01P002(@)(@@) [ج 3: ص 377](@)(@@)(@@)(@@) ||| AUTO زرارة بن مصعب الشني(@)(@@) يروي عن الحارث بن خالد بن العاص، عن عائشة: لو لا حداثة قومك بالكفر. الحديث. روى عنه ابنه عبد الله بن زرارة.(@)(@@)(@@)(@@) ||| AUTO زرارة بن عبد الله بن أسيد(@)(@@) يروي عن سعيد بن المسيب، روى عنه الحكم بن أبي نعم.(@)(@@)(@@)(@@) ||| AUTO زرارة بن ربيعة العتكي الأزدي، كنيته أبو ربيعة(@)(@@) من أهل البصرة، وهو الذي يقال له: زرارة بن أبي الحلال العتكي، أخو الحلال بن أبي الحلال، واسم أبي الحلال: ربيعة، يروي عن أبيه، ومجاهد، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO زرعة بن معبد بن عبد الله بن ليث بن بكر(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل فلسطين.(@)(@@)(@@)(@@) ||| AUTO زرعة بن عبد الله البياضي(@)(@@) وقيل: زرعة بن عبد الرحمن الأنصاري، يروي عن مولى لمعمر التيمي، عن أسماء بنت عميس، روى عنه يزيد بن زياد القرظي.(@)(@@)(@@)(@@) ||| AUTO زرعة بن إبراهيم الدمشقي الزبيدي(@)(@@) يروي عن عطاء، وخالد بن اللجلاج، روى عنه سعيد بن أبي هلال، ومحمد بن شعيب بن شابور، وهو الذي روى عنه بقية، ويقول: حدثني الزبيدي، في أشياء يرويها يوهم أنه محمد بن الوليد بن عمار الزبيدي، يجب أن يعتبر بحديثه من غير رواية بقية عنه.(@)(@@)(@@)(@@) ||| AUTO زرعة بن عمرو(@)(@@) يروي المراسيل، وكان أبوه عمرو أحد الأربعة الذين حملوا عثمان بن عفان يوم أصيب، روى عنه خالد بن يزيد القرشي.(@)(@@)(@@)(@@) ||| AUTO زهرة بن معبد أبو عقيل القرشي(@)(@@) يروي عن ابن المسيب، PageV01P002 [ج 3: ص 378] وجده عبد الله بن هشام، روى عنه حيوة بن شريح، وسعيد بن أبي أيوب، يخطئ ويخطأ عليه، وقد قيل: إنه من التابعين، وهو ممن استخير الله فيه.(@)(@@)(@@)(@@) ||| AUTO زهرة 
ms975	 بن عمرو بن منقذ التيمي(@)(@@) من أهل الحجاز، يروي عن أبي حازم، والوليد بن عمرو، روى عنه عبد العزيز بن عبد الله الأويسي، والناس.(@)(@@) (322) -[3: 378] حدثنا أبو يعلى، قال: ثنا داود بن عمرو الضمري الضبي، قال: ثنا زهرة بن عمرو بن منقذ التيمي، عن أبي حازم، عن سهل بن سعد، قال: قال رسول الله صلى الله عليه وسلم: قيد شوط من الجنة خير من الدنيا وما فيها، وغدوة أو روحة خير من الدنيا وما فيها.(@)(@@)(@@)(@@) ||| AUTO زحر بن الحسن الحضرمي(@)(@@) من أهل الكوفة، يروي عن عبد العزيز بن حكيم، روى عنه ابن المبارك، ووكيع.(@)(@@)(@@)(@@) ||| AUTO زامل بن عمرو السكسكي(@)(@@) من أهل الشام، يروي عن عريب الحبراني، روى عنه الزبيدي، وسعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO أبو عمرو بن العلاء(@)(@@) صاحب القراءات، اسمه: زبان بن العلاء بن عمار بن حصين بن حليم بن مازن بن خزاعي، من أهل البصرة، وهم إخوة أربعة: أبو عمرو، وأبو سفيان ومعاذ، وعمر، فأكبرهم سنا: أبو عمرو، ثم أبو سفيان، وكان يقال لأبي سفيان: سنسن، ثم معاذ، ثم عمر، فأما أبو عمرو فله نحو خمسين حديثا، فأما أبو سفيان فما له إلا حديثا واحدا عن الحسن، عن عبد الله بن المغفل: " لولا أن الكلاب أمة من الأمم لأمرت بقتلها ".(@)(@@) (323) -[3: 378] حدثنا أبو خليفة، قال: ثنا محمد بن سلام الجمحي، قال: ثنا سعيد بن عبيد، قال: كنا في جنازة أبي سفيان ومعنا شعبة، فقال شعبة حدثني صاحب هذه الجنازة، قال: قلت للحسن: من حدثك أن النبي صلى الله عليه وسلم قال: لولا أن الكلاب أمة من الأمم لأمرت بقتلها؟ فقال: حدثني والله الذي لا إله إلا هو عبد الله بن المغفل في هذا المسجد، وأومأ إلى مسجد الجامع بالبصرة. وأما معاذ بن العلاء فلست أحفظ له إلا حديثين: حديث الجوع، وحديث الغسل يوم الجمعة، رواهما جميعا عن نافع، عن ابن عمر. وعمر بن العلاء لا حديث له. ومات أبو عمرو بن العلاء في طريق الشام سنة أربع وخمسين ومائة، وله 
ms976	 بالبصرة عقب، وفي أبي عمرو، يقول الفرزدق:(@)PageV01P002(@)(@@) [ج 3: ص 379](@)(@@) ما زلت أفتح أبوابا وأغلقها حتى رأيت أبا عمرو بن عمار(@)(@@)(@@)(@@) ||| AUTO زبان بن عبد العزيز بن مروان بن الحكم(@)(@@) أخو عمر بن عبد العزيز، يروي المراسيل، روى عنه الليث بن سعد، وأسامة بن زيد.(@)(@@)(@@)(@@) ||| AUTO زبان بن يحيى بن الجزار(@)(@@) يروي عن أبيه، عن ابن مسعود، روى عنه محمد بن سيرين.(@)(@@)(@@)(@@) ||| AUTO زبان بن نزار(@)(@@) يروي عن خالد بن يزيد الجمحي، روى عنه خالد بن حيان.(@)(@@)(@@)(@@) ||| AUTO زريق بن حكيم الأيلي(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل الحجاز، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO زميل بن عباس(@)(@@) مولى عروة بن الزبير، يروي عن عروة بن الزبير، روى عنه ابن الهاد.(@)(@@)(@@)(@@) ||| AUTO زنجي بن خالد بن الحويرث القرشي(@)(@@) يروي عن أبيه، روى عنه أبو عبيدة الحداد، واسم أبي عبيدة: عبد الواحد بن واصل.(@)(@@)(@@)(@@) ||| AUTO زرزر بن صهيب(@)(@@) مولى لآل جبير بن مطعم، من أهل الحجاز، كان يسكن بشرجة، يروي عن عطاء، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO زريك بن أبي زريك(@)(@@) بصري، كنيته أبو نضر، ويقال:، أبو نضرة، يروي عن عطاء، والحسن، وابن سيرين، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO زرد البصري العمي(@)(@@) يروي عن عمرو بن قدامة، روى عنه موسى بن إسماعيل.(@)PageV01P002(@)(@@) [ج 3: ص 380](@)(@@)(@@)(@@) ||| AUTO زجلة(@)(@@) قال: حججت مع عبد الله بن أبي زكريا، روى عنه صدقة بن خالد الدمشقي.(@)(@@)(@@)(@@) || AUTO باب السين(@)(@@) قال أبو حاتم، رضي الله عنه:(@)(@@) وممن روى عن التابعين ممن ابتدأ اسمه على السين:(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبان بن سعيد بن العاص القرشي الأموي(@)(@@) والد يحيى، وعبد الله، وعنبسة، عداده في أهل الكوفة، يروي عن معاوية بن إسحاق، وأهل الكوفة، وكان صديقا لعمر بن عبد العزيز، روى عنه ابناه: يحيى، وعبد الله، وكان سعيد من خيار عباد الله، من أفاضل أهل بيته.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن حسان بن ثابت الأنصاري(@)(@@) يروي عن أبيه، روى عنه أهل المدينة، وكان شاعرا.(@)(@@)(@@)(@@) ||| AUTO سعيد بن خالد بن عمرو بن عثمان، 
ms977	 كنيته أبو عثمان(@)(@@) يروي عن عروة بن الزبير، وقبيصة بن ذؤيب، روى عنه الزهري.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عمرو بن سليم بن عمرو بن خلدة بن عامر بن مخلد بن عامر بن زريق الزرقي الأنصاري(@)(@@) من أهل المدينة، يروي عن أبيه، والقاسم بن محمد، روى عنه عبد الملك بن الحسن، مات سنة أربع وثلاثين ومائة، وأمه عبادة بنت عبادة، واسمه سعيد بن عثمان بن خلدة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن سليمان بن زيد بن ثابت الأنصاري المدني(@)(@@) أخو عبد الله بن سليمان، يروي عن عمه خارجة بن زيد، روى عنه مالك بن أنس، مات سنة PageV01P002 [ج 3: ص 381] اثنتين وثلاثين ومائة، وكان يلي قضاء المدينة لإبراهيم بن هشام بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الجبار بن وائل بن حجر الكندي(@)(@@) يروي عن أبيه، روى عنه محمد بن حجر، كنيته أبو الحسن، مات سنة ثمان وخمسين ومائة في السنة التي توفي فيها أبو جعفر.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي بكر بن حفص بن عمر بن سعد بن أبي وقاص القرشي(@)(@@) يروي عن سالم بن عبد الله: أن ابن عمر صام في السفر في رمضان. روى عنه سعيد بن مسلم بن بانك.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي بردة بن أبي موسى الأشعري(@)(@@) يروي عن أبيه، روى عنه قتادة، وزيد بن أبي أنيسة، وشعبة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن إياس الجريري، كنيته أبو مسعود(@)(@@) من أهل البصرة، من ولد جرير بن عباد، أخو الحارث بن عباد، وقد قيل: إنه مولى قيس بن ثعلبة بن بكر بن وائل، يروي عن أبي العلاء، وأبي نضرة، روى عنه الثوري، وشعبة، وأهل بلده، مات سنة أربع وأربعين ومائة، وكان قد اختلط قبل أن يموت بثلاث سنين، وقد رآه يحيى بن سعيد القطان، وهو مختلط، ولم يكن اختلاطا فاحشا، فلذلك أدخلناه في الثقات.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أيمن(@)(@@) يروي عن كثير بن عباس، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أوس(@)(@@) يروي عن سعيد بن المسيب، روى عنه سعيد بن أبي هلال، ومحمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO 
ms978	 سعيد بن عبد الرحمن بن مكمل الأعشى(@)(@@) من أهل المدينة، يروي PageV01P002 [ج 3: ص 382] عن أيوب بن بشير، روى عنه سهل بن أبي صالح، وشريك بن أبي نمر.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن أبزى(@)(@@) مولى خزاعة، من أهل الكوفة، يروي عن أبيه، روى قتادة، عن عزرة، عنه.(@)(@@)(@@)(@@) ||| AUTO سعيد بن جابر الرعيني(@)(@@) يروي عن أبيه، عن أبي بكر، روى عنه الشيباني.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن وائل الأنصاري(@)(@@) من أهل الحجاز، يروي عن عبد الله بن عبد الله بن عمر، روى عنه فليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حكيم(@)(@@) أخو بهز بن حكيم، يروي عن أبيه، عن جده، روى عنه داود الوراق من حديث سفيان بن حسين عنه.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن أبي سعيد الخدري(@)(@@) يروي عن أبيه، عداده من أهل المدينة، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبيد الهنائي(@)(@@) يروي عن عبد الله بن شقيق، وبكر بن عبد الله المزني، روى عنه سلم بن قتيبة، والعراقيون.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عمرو بن سعيد بن العاص بن أمية(@)(@@) يروي عن أبيه، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حريث(@)(@@) يروي عن الحسن قوله، روى عنه أهل العراق.(@)PageV01P002(@)(@@) [ج 3: ص 383](@)(@@)(@@)(@@) ||| AUTO سعيد بن أسعد(@)(@@) يروي عن يحيى بن سعيد الأنصاري، وأهل المدينة، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO أبو مسلمة سعيد بن يزيد(@)(@@) يروي عن أبي نضرة، روى عنه شعبة، والبصريون.(@)(@@)(@@)(@@) ||| AUTO سعيد بن جميل العبسي(@)(@@) يروي عن ربعي بن حراش، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبيد بن السباق(@)(@@) يروي عن أبيه، عن سهل بن حنيف، روى عنه محمد بن إسحاق بن يسار.(@)(@@)(@@)(@@) ||| AUTO سعيد بن عبد الرحمن بن أبي العمياء(@)(@@) يروي عن سهل بن أبي أمامة، روى عنه ابن وهب.(@)(@@)(@@)(@@) ||| AUTO سعيد بن دريك التميمي(@)(@@) يروي عن عطاء، ونافع، روى عنه الربيع بن زياد.(@)(@@) (324) -[3: 383] حدثنا علي بن أحمد بن سعيد، قال: ثنا محمد بن عبيد بن عبد الملك الأسدي، قال: ثنا الربيع بن 
ms979	 زياد، قال: ثنا سعيد بن دريك، عن عطاء عن جابر، قال: " نهى رسول الله صلى الله عليه وسلم عن كراء الأرض بالثلث والربع. "(@)(@@)(@@)(@@) ||| AUTO سعيد بن حدير، أبو غنيم(@)(@@) قوله، روى عنه صفوان بن عمرو السكسكي.(@)(@@)(@@)(@@) ||| AUTO سعيد بن غزوان(@)(@@) من أهل الشام، يروي عن صالح بن يحيى بن مقدام بن معدي كرب، روى عنه الحارث بن عبيدة الكلاعي.(@)(@@)(@@)(@@) ||| AUTO سعيد بن كعب(@)(@@) يروي عن جابر بن زيد، روى الثوري، عن عبد الحميد، عنه.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حيي الخولاني(@)(@@) ثم الجعلي، يروي عن أبيه، روى عنه عياش بن عباس القتباني.(@)PageV01P002(@)(@@) [ج 3: ص 384](@)(@@)(@@)(@@) ||| AUTO سعيد بن سالم الكندي(@)(@@) يروي(@)(@@) (325) -[3: 384] عن معاوية بن عياض بن غطيف، عن أبيه، عن جده، قال: سمعت رسول الله صلى الله عليه وسلم يقول: إن شرب الخمر فاجلدوه، وإن عاد فاجلدوه، وإن عاد فاجلدوه، وإن عاد فاقتلوه. حدثنا ابن قتيبة، ثنا عبد الوهاب بن الضحاك، قال: ثنا إسماعيل بن عياش، عن سعيد بن سالم(@)(@@)(@@)(@@) ||| AUTO سعيد بن جعفر بن المطلب بن أبي وداعة السهمي(@)(@@) يروي عن أبيه، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حيان بن جحدر الطائي(@)(@@) وهو الذي يقال له: سعيد بن أبي السمين، كان كنية حيان: أبا السمين، يروي عن عتبة بن أبي سليمان، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO سعيد بن زياد المكتب(@)(@@) مولى بني زهرة، من أهل المدينة، يروي عن سليمان بن يسار، روى عنه خالد بن مخلد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن الحارث(@)(@@) يروي عن شريح، روى عنه الحسن بن ذكوان.(@)(@@)(@@)(@@) ||| AUTO سعيد بن زياد الشيباني(@)(@@) يروي عن طاوس، روى عنه وكيع، ويحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO سعيد بن إبراهيم بن معقل(@)(@@) يروي عن عروة بن رويم، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO سعيد بن خرشيد(@)(@@) يروي عن أبي الشعثاء، والحسن بن محمد قولهما، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO أبو سنان الشيباني، اسمه: سعيد بن سنان(@)(@@) من أهل الكوفة، PageV01P002 [ج 3: ص 385] يروي عن عمرو بن مرة، كان أصله من قزوين، روى عنه يحيى بن 
ms980	 آدم، والكوفيون، وكان عابدا فاضلا.(@)(@@)(@@)(@@) ||| AUTO سعيد الصراف(@)(@@) يروي عن عطاء بن أبي رباح، روى عنه يحيى بن عبد الله بن عبد الرحمن بن أبي عمرة الأنصاري.(@)(@@)(@@)(@@) ||| AUTO سعيد بن حسان المخزومي(@)(@@) من أهل الحجاز، يروي عن عياض بن عدي بن الخيار النوفلي، روى عنه ابن عيينة، ووكيع.(@)(@@)(@@)(@@) ||| AUTO سعيد بن مسلم بن بانك(@)(@@) من أهل المدينة، يروي عن عامر بن عبد الله بن الزبير، روى عنه خالد بن مخلد القطواني.(@)(@@)(@@)(@@) ||| AUTO سعيد بن زياد(@)(@@) يروي عن جابر بن زيد، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO سعيد بن خالد بن عبد الله بن قارظ الزهري(@)(@@) أخو المسور بن خالد، من أهل المدينة، يروي عن أبي سلمة بن عبد الرحمن، روى عنه ابن أبي ذئب، مات في آخر ولاية بني أمية.(@)(@@) (326) -[3: 385] حدثنا إبراهيم بن خزيم، قال: ثنا عبد بن حميد، قال: ثنا أبو بكر الحنفي، قال: ثنا ابن أبي ذئب، قال: حدثني سعيد بن خالد القارظي، قال: أتيت أبا سلمة بن عبد الرحمن أزوره بقباء، فقال: سمعت أبا سعيد الخدري، يقول: قال رسول الله صلى الله عليه وسلم: إذا سقط الذباب في الطعام فامقلوه، فإن في أحد جناحيه سما وفي الآخر شفاء، وإنه يقدم السم ويؤخر الشفاء.(@)(@@)(@@)(@@) ||| AUTO سعيد بن زيد بن عقبة الفزاري(@)(@@) من أهل الكوفة، يروي عن أبيه، عن سمرة، روى عنه الحجاج بن أرطأة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن سلمة بن أبي الحسام(@)(@@) مولى آل عمر بن الخطاب، من أهل PageV01P002 [ج 3: ص 386] المدينة، كنيته أبو عمرو، يروي عن ابن المنكدر، وهشام بن عروة، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي صدقة أبو قرة(@)(@@) يروي عن محمد بن سيرين، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي زياد(@)(@@) يروي عن أبي سلمة بن عبد الرحمن، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO سعيد بن أبي حرة(@)(@@)(@@)(@@) ||| AUTO يروي عن نافع، روى عنه سعيد بن أبي عروبة.(@)(@@)(@@)(@@) ||| AUTO سعيد بن خازم، أبو عبد الرحمن(@)(@@) كوفي، يروي عن الأعمش، 