ms281	 زلف، همیشه مه در آغوشت باد برخورداری از آن بناگوشت باد(@)(@@) (@@) زان چشمهآ حیوان، که لبش می خوانند %~% خون دل من همی خوری، نوشت باد!(@)(@@) (@@) 281 بی یاد تو، عیشها فراموشم باد %~% درد تو، به جای تودر آغوشم باد!(@)(@@) (@@) در وصل توباده خوردم و، نوشم بود %~% در هجر توخون دل خورم، نوشم باد!(@)(@@)(@@)(@@) | عماد الشرف(@)(@@) (@@) 281 فرخ رخ تو، دژم مبادا هرگز %~% شادی دلت، به غم مبادا هرگز!(@)(@@) ~~با آنکه چوموی گشتم، اندر غم تو مویی زسر تو، کم مبادا هرگزا(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2816 عیشم، به هوای روی زیبای توباد %~% دردم، زجفای چشم رعنای تو باد!(@)(@@) (@@) هوشم، زجفای شادی افزای توباد %~% لغیره %~% گوشم، به سماع مجلس آرای توباد!(@)(@@) (@@) 2814 چون آب، سر زلف تو چین بر چین باد %~% بر آتش تو، زغالیه پر چین باد(@)(@@) (@@) باد، از سر [دو] زلف توعنبر چین باد %~% لغیره %~% خاک قدمت، تاج بتان چین باد!(@)(@@) ~~2815 دستم، ز سر زلف قو کوتاه مبادوین عیش دلم، به کام بدخواه میاد(@)(@@) (@@) هر چند، به کوی تومرا راهی نیست %~% در کوی غم تو، جز مرا راه مباد!(@)(@@)(@@)(@@) | لادری(@)(@@) (@@) 281 در دست منت همیشه، دامن بادا %~% وانجا که تو را پای، مرا تن بادا(@)(@@) (@@) برقم نبود، که کس تورا دارد دوست %~% ای دوست، همه جهانت دشمن بادا!(@)(@)PageV01P451(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0455.jpg)(@)(@)(@@)(@@)(@@) | نمط چهل ویکم(@)(@@)(@@)(@@) | در صفت نسائیات(@)(@@)(@@)(@@) | جمال حاجی گوید(@)(@@) (@@) 2817 زلفین تو، با چشم توهم پهدوبه %~% همسایهآ طرارتوه هم جادوبه!(@)(@@) (@@) رخسار تو را، نگه به آن گیسوبه %~% داند همه کس که: پاسبان هندو به!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2818 جانا، مه و خورشید به سیمای تونیست %~% وزخلق کسی به حسن، همتای تونیست(@)(@@) (@@) این طرفه، که بر روی زمین اززن و مرد %~% الغیره %~% جز گیسویت، کسی به بالای تو نیست!(@)(@@) (@@) 2819 گیسوی تو، رنگ بدوی می دارد %~% منشور حسب، چون علوی می دارد(@)(@@) (@@) افتاد برو شکن، ولیکن هرگز %~% رو بر نکند، پشت قوی می دارد!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2820 ای ماه، دل از نیاز پرداخته ای %~% وز 
ms282	 حسن، بسی ذخیرهها ساخته ای(@)(@@) (@@) زان گیسوی مشکین مرصع به گهر %~% سرمایهآ نیک، واپس انداخته ای!(@)(@@)(@@)(@@) | جمال حاجی(@)(@@) (@@) 2821 آن را، که دو گیسوی تو در مشت بود %~% مهر همه نیکوان، فرامشت بود(@)(@@) (@@) شاید، که مرصع به جواهر دارند %~% گیسوی تو را که آنچنان پشت بود(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2822 ای دوست، به نزد هر که صاحبنظر است جای تو چو گیسوی تو، بر فرق سر است(@)(@@) (@@) گوشت که جواهر زکمر خواست، مرنج %~% کاو نیز، چو گیسوی تو در بند زر است!(@)(@@)(@@)(@@) | بغیره(@)(@@) ~~2823 بس نیش، که بر دلم زنوش تو رسید تا، دست من امروز به دوش تو رسید(@)(@@) (@@) از دریتیم، علاقهای گوش تورا[ست] %~% اشک چشمم، مگر به گوش تو رسید!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2824 تلخی، که زلعل باده نوش تو رسدشیرین، چو لب شکر فروش تو رسد(@)(@@) (@@) ار در سخن، علاقه ها خواهم ساخت %~% باشد که، یکی از آن به گوش تورسد!(@)(@)PageV01P452(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0456.jpg)(@)(@)(@@)(@@)(@@) | لقائله(@)(@@) ~~2825 لعل آمد و، از سنگدلی رنگ آمیخت تا رنگ لب تو برد و، در سنگ گریخت(@)(@@) (@@) سودای تو، آورد ز سنگش بیرون %~% وز گردن و گوش تو، چو دزدان آو یخت!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) ~~282 بر گردن خویش، بسته ای عقد گهر وز گوش، بیاو یختهای حلقهآ زر(@)(@@) (@@) گویی غم عشق جلوه کرد، ای دلبر %~% اشک و رخ من، به گردن و گوش توبر!(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 2827 در گوش تو، هر چه زرو مروارید است %~% آن، از رخ و از دیدهآ من دزدیدهست!(@)(@@) (@@) زلفین، تو زان سایه برو پوشیدهست %~% کان، بر رخ و چشم من همه کس دیدهست!(@)(@@)(@@)(@@) | جمال نقاش(@)(@@) (@@) 2828 ای بستهآ آن دو زلف چون دال تو من %~% وی گشته اسیر رخ وآن خال تو من(@)(@@) (@@) روزی بینی : خمیده وزرد وضعیف %~% در پای تو افتاده چو خلخال تو، من!(@)(@@)(@@)(@@) | نظامی(@)(@@) (@@) 2829 چون دست نگتار من به گل پیوندد %~% جامی است بلورین، که به مل پیوندد(@)(@@) (@@) پیرامن رخ، زدهست در مقنعه گل %~% یعنی : همه جزوها به کل 
ms283	 پیوندب!(@)(@@)(@@)(@@) | در سرمه کشیدن(@)(@@) (@@) 2830 چشم و سرتو، همت شاهی دارد %~% بی آنکه کنی سرمه، سیاهی دارد(@)(@@) (@@) زین بیش مکن سرمه، به جان و سرتو %~% کان چشم تو، سرمهآ الهی دارد!(@)(@@)(@@)(@@) | در آرایش کردن(@)(@@) ~~2831 ای مه شده پیش رخ رخشان تو، پست ماهی و قصب در زنخ آورده و، من(@)(@@) %~% ایضا %~% با هوش آید از لب خندان تو، مست! %~% مانند قصب، پیش زنخدان توبست(@)(@@) (@@) 2832 ار حلقه ز زلف خویش، نگشایی به %~% ور رنگ و نگار چهره، نفزایی به(@)(@@) (@@) رخسارتو را، چو صنع ایزد آراست %~% آراسته را اگر نیارایی به PageV01P453(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0457.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2833 گر شانه، زبان در خم گیسوت کشد %~% گر آینه، روی سخت در روت کشد(@)(@@) (@@) سرمه که بود؟ که آید اندر چشمت %~% یا وسمه، که او کمان ابروت کشد؟(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2834 آن زلف تو، بارگاه من بایستی %~% وان چشم تو، خوابکاه من بایستی!(@)(@@) (@@) دست تو، که خون عاشقان می ریزد %~% در گردن پر گناه من بایستی!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 2835 با آنکه به کس دست به پیمان ندهی %~% زنجیر ز زر کنی و، بر دست نهی(@)(@@) (@@) بربست بیکبارگی، ای سروسهی %~% زر، دست تورا، چوبی زری دست رهی!(@)(@@) دررنگ به کاربردن(@)(@@) (@@) 2836 شبگیر، به من باز ده انگشت نمود %~% چون ده قلم سیم، همه خون آلود(@)(@@) (@@) آن ده قلم سیم، چویک ساعت بود %~% %~% ده ماهی سیم [شد]، همه مشک آلود!(@)(@@)(@@)(@@) | ایضا(@)(@@) (@@) 2837 تا دلبر من زلف کژ خود پیراست %~% تیر قد من، چو کژ کمانی شد راست(@)(@@) (@@) تا ده قلم سیم، به عناب آراست %~% %~% یکسر، قلم عافیت از ما برخاست!(@)(@@) دردست نگار کردن(@)(@@) ~~2838 از بس که سر زلف سیه تابد یار هر ده سر انگشت، سیه کرده چوقار(@)(@@) (@@) وزبس که زمن به دست پوشد رخسار %~% پذرفت دو دستش، از دو رخسار نگار(@)(@@)(@@)(@@) | در روی شستن(@)(@@) (@@) 2839 ای داده سر زلف توام، تاب به تاب %~% چشمت برده، زچشم من خواب به خواب(@)(@@) (@@) آن نیست عجب، که خون به 
ms284	 خون شویم من %~% این طرفه، که تو بشسته ای آب به آب!(@)(@@)(@@)(@@) | گلگونه کردن(@)(@@) ~~2840 هر گز به وفا رو نکنی، خوش باشد باما تو، از اینگونه کنی خوش باشد!(@)(@@) (@@) کلگونه، زروی توبرد لاله وگل %~% لغیره %~% و انگاه تو گلگونه کنی، خوش باشد!(@)(@@) (@@) 2841 ای بی رخ زیبای تو، کارم فریاد %~% بی روی نکوت، چند دارم فریاد؟(@)(@@) (@@) آمد گه آنکه همچو خلخال زرت %~% در پای توافتم و، بر آرم فریاد PageV01P454(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0458.jpg)(@)(@)(@@)(@@)(@@) | 455(@)(@@) (@@) 2842 ای جان و دلم به جان ودل در بندت %~% لغیره %~% فریاد از آن پستهآ شکر بندت(@)(@@) (@@) گر دسترسم باشد و، دستم برسد %~% در پای تو افتم، چو سر سربندت!(@)(@)PageV01P455(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0459.jpg)(@)(@)(@@)(@@)(@@) | باب دوازدهم(@)(@@)(@@)(@@) | ودر عشق](@)(@@)(@@)(@@) | نمط اول(@)(@@) درابتدای عشق(@)(@@)(@@)(@@) | معزی(@)(@@) ~~3843 ای دیده و دل هر دو، پسندیده تورا دارم زعزیزی، چودل و دیده تورا(@)(@@) (@@) از دیدن دیده، گر شود دل عاشق %~% دل عاشق گشت و، دیده نادیده تورا!(@)(@@)(@@)(@@) | یاضی(@)(@@) ~~2844 بگریستم از تو، باتو ناخندیدهعاشق شدم، از توخبری نشنیده(@)(@@) (@@) گر خلد برین نه ای؟ چرا نادیده %~% هم دل طلبد تو را [بتا]، هم دیده!(@)(@@)(@@)(@@) | غیره(@)(@@) ~~2845 آسوده دلی بود، خوش و شاد مرااز غم، نفسی نیامدی یاد مرا(@)(@@) (@@) ناگاه، به بازار بلا بگذشتم %~% تا، واقعه ای چنین بیفتاد مرا!(@)(@@)(@@)(@@) | ثیر الدین(@)(@@) ~~2840 عشق تو، به پیدا و نهانم کشته ستسودای تو، بی نام و نشانم کشته ست(@)(@@) (@@) ربیهده، نیستم چنین کشتهآ تو %~% چیزی زتو دیدهام، که آنم کشتهست!(@)(@)PageV01P456(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0460.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~28،7 دیدم که دل خسته غمین خواهد بودتن با غم هجر همنشین خواهد بود(@)(@@) ~~حالت نه چنان است، که هر کس می گفت ای وای من ارعشق چنین خواهد بود(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2848 عشق تو، زعالم هیولانی نیست %~% سودای تو، حد وصف انسانی نیست(@)(@@) (@@) ما را به تو، اتصال روحانی هست %~% سهل است، گر اتصال جسمانی نیست(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~پاد توچه آتش است، کاندر دل من 2849 عشق تو، نقاب خوابم از دیده گشاد(@)(@@) %~% وله %~% حالی 
ms285	 که در آمد، آبم از دیده گشاد! %~% خوناب دل کبابم، از دیده گشاد(@)(@@) (@@) 285 یک دم فتدت، که خوش گذاری با من؟ %~% وان غم - که مبادت- بگساری با من؟(@)(@@) (@@) در سر دارم، که سر نثار تو کنم %~% داری سر آنکه سر درآری با من؟(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 285 گاهی که به عافیت، دلم در بر بود %~% دستم، زجنون خویشتن بر سر بود(@)(@@) (@@) این حادثهآ عشق تو، ای جان وجهان %~% دیوانگی مرا، کجا در خور بود!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2852 عمری است، که با عشق تودر ساختهام %~% پنهان زتو، با توعشقها باخته ام!(@)(@@) (@@) زان با تونگفته ام، که هرگز خود را %~% شایستهآ خدمت تو نشناخته ام!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2856 گویند که : مایهآ جنون باشد عشق %~% وز دایرهآ عقل، برون باشد عشق(@)(@@) (@@) غافل بودم زعاشقی، تا اکنون %~% عشقت به من آموخت، که چون باشد عشق!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 285 آن دل، که ز دست دلبران بر بودم %~% هرگز به کسی ندادم و، ننمودم(@)(@@) (@@) از من، به یکی نظر چنان بر بودی %~% گویی که هزار سال بی دل بودم(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2855 ای سلسلهآ زلف تو، یکسر جنبان %~% دیوانه شدم، سلسله کمتر جنیبان(@)(@@) (@@) دارم سر آنکه سر کنم در سر تو %~% گر هست سر منت، سرای] در جنبان.(@)(@)PageV01P457(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0461.jpg)(@)(@)(@@)(@@)(@@) | حاقانی(@)(@@) ~~2856 در کار تو، هر زمان گرفتار ترم غمهای تو را به جان خریدار ترم(@)(@@) (@@) هر روز، به چشم من نکوروی تری %~% هر چند که بیش بینمت، زار ترم!(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 2857 عشق تو، مرا زیر و زبر کرد آخر %~% از سر پایم، زپای سر کرد آخر(@)(@@) (@@) وان دل، که مرا گم شده بد چندین وقت %~% هم، سر زگریبان توبر کرد آخرا(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2858 آنم، که زراحت به عنا افتادم من باز بدین غم به کجا افتادم(@)(@@) (@@) از سر سبکی، چو ذره پیرامن مهر %~% می گشتم و، در دام بلا افتادم!(@)(@@)(@@)(@@) | معزی(@)(@@) ~~2859 در هجر تو، با دو چشم پرخون باشمدر رنج، زهر چه گویی افزون باشم(@)(@@) (@@) یک بار بدیدمت، بدین حال 
ms286	 شدم %~% گر بار دگر ببینمت، چون باشم؟(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2860 دل در بر من، زدلبری می لرزد %~% جان در تن من، از خطری می لرزد(@)(@@) (@@) نشتیدستی که: از درختی، شاخی %~% چون می ببرند، دیگری می لرزد(@)(@@)(@@)(@@) | باخرزی(@)(@@) ~~2861 بر چهرهآ چون خون جگر نیست تورادل در کف صد گونه خطر نیست تورا(@)(@@) (@@) دردم زان است، زین همه درد دلم %~% یک ذره، ز درد من خبر نیست تورا(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2862 یک دم به مراد، با تو گر بنشینمچون خال تو، بر تنگ شکر بنشینم(@)(@@) ~~عمری است، که در پی تو برخاستهام تا، ساعتکی با تو مگر بنشینم!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2863 آن ماه، که در برم بدی کاش هنوز نابوده شبی، بی رخ زیباش هنوز(@)(@@) ~~جان خست و، دلم شکست و، تن رفت زدت این منزل اول است، خود باش هنوز!(@)(@)PageV01P458(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0462.jpg)(@)(@)(@@) (@@) 2864 چین سر زلف خلخت می بینم %~% لغیره %~% در خواب، خیال فرخت می بینم(@)(@@) (@@) هفت اندامم، چو بید لرزان گردد %~% هرگاه، که پرتو رخت می بینم!(@)(@@)(@@)(@@) | نمط دوم(@)(@@)(@@)(@@) | در دیده(@)(@@)(@@)(@@) | کمال الدین اسماعیل(@)(@@) (@@) 2865 زین پس، نکنم شکایتی زین دل ریش %~% کز دیده فتاد حالت من، کم وبیش(@)(@@) (@@) این عشق، به تنگنای دل راه نبرد %~% تا، دیده نداشت روشنایی در پیش!(@)(@@) (@@) وین مردمک چشم سیه کاسهآ من 2866 عشق تو، زلطفها که با ما کردهست %~%(@)(@@) اوله %~% وله %~% در دور غم تو، دل به دریا کردهست! %~% چشمم، صدف لؤلؤلالا کردهست(@)(@@) (@@) 2867 ای دانهآ در نهاده، در خوشهآ اشک %~% در راه غمت، شد سپری توشهآ اشک(@)(@@) ~~وین دیده، که بار داشت از قطرهآ آببر بوی تو، بفکند جگر گوشهآ اشک!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2868 تا کرد به روی تونظر، مردم چشمعیشی دارد، بس خوش وتر مردم چشم(@)(@@) (@@) هر شب زغمت، هزار میخی مژزه %~% بر خود بدرذ تا به سحر، مردم چشم(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2860 چشمم، که به گریه میغ از او می بارد صد حسرت و صد دریغ، از او می بارد(@)(@@) (@@) بل، تا همه خون 
ms287	 شود، که او داد مرا %~% مهری، که هزار تیغ از او می بارد!(@)(@)PageV01P459(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0463.jpg)(@)(@)(@@) با اق(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2870 دوش، این دل مستمندم از هر بابی %~% از زلف، همی فکند در جان تابی(@)(@@) (@@) خواب آمد و، خواست کآب رویم ببرد %~% هم دیده! که بر روی من آورد آبی!(@)(@@)(@@)(@@) | هجیر(@)(@@) (@@) 2871 چندانکه به کار خود فرو می بینم %~% بی دیدگی خویش، نکو می بینم(@)(@@) (@@) با زحمت چشم من چه خواهد کردن؟ %~% اکنون که همه جهان بدو می بینم!(@)(@@)(@@)(@@) | عبدالرزاق(@)(@@) (@@) 2872 زین چشم، که ابر آفرین خواند براو %~% کشتی مگر از آب توان راند بر او(@)(@@) (@@) چندان کردم به چشم مست تونگاه %~% کز مردمک دیده، نشان ماند بر او(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2873 ای دل، بشکن که نادرستیم زتو %~% کم یافته ایم، آنچه جستیم زتو(@)(@@) (@@) ای دیده، تونیز رو، که اندر ره عشق %~% چون خون گشتی، دست بشستیم زتو!(@)(@@)(@@)(@@) | غیره(@)(@@) (@@) 2874 از درد فراقت، ای به لب شکرناب %~% نه روز مرا قرار، نه در شب خواب(@)(@@) (@@) چشم و دل من زهجرت، ای در خوشاب %~% صحرای پر آتش است و، دریای پرآب!(@)(@@) عبدالعزیز گنجه ای(@)(@@) (@@) 2875 تا چند شوی زفرقت یار، ای چشم %~% همچون لب لعل او، گهر بار ای چشم؟(@)(@@) (@@) او، سوی تو از مهر نخواهد نگریست %~% ساکن شوو، آب خود نگهدار ای چشم!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2876 هر شب ببرد هجرتو، خواب از چشمم %~% مأوای دلم، شود خراب از چشمم(@)(@@) (@@) آتشکده را بکشت و دهقانان را %~% آتش زدلم براند و، آب از چشمم!(@)(@@)(@@)(@@) | جمال الملک(@)(@@) (@@) 2877 ای دیده، شدی باز بدان مه تشنه %~% کاو دل به زنخ بکشت در چه تشنه(@)(@@) (@@) در کار توعاجزم، که نادر افتد %~% در آب کسی غرقه و، آنگه تشنه!(@)(@)PageV01P460(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0464.jpg)(@)(@)(@@)(@@)(@@) | 461(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2878 دل در هوست باز، به زاری افتادوزجان عزیز، نک به خواری افتاد(@)(@@) ~~وان چشم، که حاجبانش پیوسته بدنددور از رویت، به آبداری افاد!(@)(@@)(@@)(@@) | ظهیرالدین مراغه ای(@)(@@) ~~2879 در دیده، ز آرزوت گر خون آرم تو......ز دست 
ms288	 تو چون آرم(@)(@@) (@@) هم خون بارم زدیده، تا بوک مگر %~% با خون دلت، ز دیده بیرون آرم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2880 گر دل ز تو بگسلد، به دارش بزنم %~% صد جعبه تیر بی شمارش بزنم(@)(@@) (@@) ور دیدهآ من، به جز تو در کس نگرد %~% تغیره %~% آتش، به همه اصل وتبارش بزنم!(@)(@@) (@@) 2881 دل را، که همه کار و کیاییش تویی %~% نیک و بد و فسق و پارساییش تویی(@)(@@) (@@) گردیدهآ من، به جزتو در کس نگرد %~% وله %~% از خود گله کن، که روشناییش تویی!(@)(@@) (@@) 2882 ای دل، زتو بخت من زبون می آید %~% کز دست توام صبر برون می آید(@)(@@) (@@) وی دیده، ازین رنگ که می آمیزی %~% بی هیچ شکیت، بوی خون می آید!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2883 تا پرتو روی یارم، اندر چشم است %~% مانند سپهر، پر زاختر چشم است(@)(@@) ~~بریاد وی آراسته ام بزم، ولیک ساقی غم و، می سرشک و، ساغر چشم است!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2884 گر چه دلم از حسن توتابی دارد %~% جان، هر نفسی از توعذابی دارد(@)(@@) (@@) جزدیدهآ خویشتن، نبینم کس را %~% از هر که به نزدیک تو آبی دارد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2885 رنگ شفق، از سرشک عنابی ماست صبح صادق، گواه بیخوابی ماست(@)(@@) ~~در عشق تو، من زدیده می بارم خون وین نیز، برت دلیل بی آبی ماست!(@)(@@) (@@) 2886 دیده زتو، اشکم به سبو می ریزد %~% در عشق کهن، سرشک نو می ریزد(@)(@@) (@@) چشمم به رخت، زخاک ره تشنه تر است %~% با اینهمه آبها، که او می ریزدا PageV01P461(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0465.jpg)(@)(@)(@@)(@@)(@@) | فرید(@)(@@) (@@) 2887 از دیدهآ من، چو اشک گلگون بچکد %~% هر لحظه، هزار قطره افزون بچکد(@)(@@) (@@) برآتش هجرتو، کباب است دلم %~% چون گرم شود کباب، از اوخون بچکد!(@)(@@)(@@)(@@) | معین(@)(@@) (@@) 2888 دل، روز و شب اندر تگ و پویم دارد %~% شوریدهآ زلف تو، چو مویم دارد(@)(@@) (@@) هم، دیده که اشک لعلش از گرمروی %~% در عشق رخ تو، سرخرو یم دارد!(@)(@@) (@@) 2889 ای از همه نیکوان یسندیدهآ من %~% زاهد %~% خود نیک و بد تو 
ms289	 هست، بگزیدهآ من(@)(@@) (@@) نا مردمیی نکرد دل با تو، چرا؟ %~% در خون دلی، چو مردم دیدهآ من!(@)(@@) (@@) 2890 ای عکس جمالت، فلک دیدهآ من %~% الغیره %~% وی دیدن رویت، نمک دیدهآ من(@)(@@) (@@) دریاب، که پر می شود از خون جگر %~% آب از دهن مردمک دیدهآ من(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~2891 تا سوی رخت کرد نظر، دیدهآ من پر کرد غم، از خون جگر دیدهآ من(@)(@@) (@@) گفتی که: «(شوم چوتیر در دوستیت» %~% چون تیر شدی، ولیک در دیدهآ من!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2892 روزی نظر از بتان بگردان، ای چشم %~% جز فتنه مدار چشم از ایشان، ای چشم(@)(@@) (@@) تا بار دگر، این دل محنت زده را %~% در حادثه ای نیفکنی هان، ای چشم(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2893 دی دیدهٔ‌ [من] زغایت خونریزی %~% بر چرخ فراشت، رایت خونریزی(@)(@@) (@@) گفتم: بنشین، ادب نگه دار و مکن %~% با غمزهآ او، حکایت خونریزی!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 289 شد دیده به عشق رهنمون دل من %~% تا کرد پر از غصه درون دل من(@)(@@) ~~2894 چون آفبت دل، زدیده بر می خیزد زنهار، اگر نماند این دل روزی(@)(@@) %~% لغیره %~% از دیده طلب کنید، خون دل من! %~% می شاید اگر دیده زدل بگریزد(@)(@@) (@@) خون دل من، زدیده می باید خواست %~% زیرا که همیشه خون دل می ریزد PageV01P462(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0466.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2896 دیده، زفراق تو زیان می بیندبر چهره زخون دل نشان می بیند(@)(@@) ~~با این همه، من زدیده ناخشنودمتا، بی رخ تو چرا جهان می بیندل(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2897 خاک قدمت، که هست رشک عنبرآورد به من، باد صبا وقت سحر(@)(@@) (@@) رخ پیش بداشتم که: بنشین، چشمم %~% فریاد بر آورد که: بر سر بهترا(@)(@@)(@@)(@@) | نجیب گنجه ای(@)(@@) (@@) 2898 هر چند که دل را غم عشق آیین است %~% چشم است، که آفت دل مسکین است(@)(@@) (@@) من معترفم که: شاهد دل معنی است %~% اوله %~% لیکن چه کنم؟ که چشم صورت بین است!(@)(@@) (@@) 2890 ای دل، هوست به گفت و گوننشیند %~% وین لابه گری، در دل او ننشیند(@)(@@) (@@) ای دیده، مریز 
ms290	 آب کاین آتش عشق %~% هرگز به چنین آب، فرو ننشیند!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2900 ابر آمد و، عارض چمن می شوید %~% تخت گل و، کرسی سمن می شوید(@)(@@) (@@) وین دیده، برای آنکه در من نگری %~% روزی صد بار، روی من می شوید!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2901 دل، دوش هزار کار سازی می کرد %~% با وعدهآ دوست، عشقبازی می کرد(@)(@@) (@@) تا، در کف پای تو تواند مالید %~% رخ را همه شب، دیده نمازی می کرد!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2901 با دیده دلم گفت: جوابت دارم %~% تدبیر خطاهای صوابت دارم(@)(@@) ~~در آتش غم فکندی، ای دیده مرا 2903 جان درتن من، غمت به پرواز آورد(@)(@@) %~% الغیره %~% گر عمر وفا کند، در آبت دارم! %~% صد راه، دلم را به دم گاز آورد(@)(@@) (@@) با آنکه بریخت خونم این دیده، به قهر %~% هم، دیده که آبی به رخم باز آورد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2904 ایام، چو دور از تو مرا تنها داشتاین دیده، نیابت غمت بر ما داشت(@)(@@) (@@) در هجر نو، هیچ کس نکردم یاری %~% هم دیده، که آب روی من برپا داشت.(@)(@)PageV01P463(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0467.jpg)(@)(@)(@@)(@@)(@@) | باب دوازدهم - عشق(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2905 با دل به خصومتم، که تا جان دارد %~% جز جان مرا به دست غم نسپارد(@)(@@) (@@) وز دیده هزار شکر دارم، کآخر %~% هر دم، آبی به روی من می آرد!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2906 اشکم، که ز دیده سر نگون می آید %~% دانی که چرا به رنگ خون می آید؟(@)(@@) (@@) بشکست دلی، که پر می مهر[توا بود %~% وان می، ز دو دیدهام برون می آید!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2907 وقت سحرش، چو عزم رفتن بگرفت %~% دل را، غم جان رفته ازتن، بگرفت(@)(@@) (@@) اشکم بدو ید، تا بگیرد راهش %~% در وی نرسید و، دامن من بگرفت!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~2908 چشم من و، چشم آن بت تنگ دهان دربیع و شری شدند و، در سود و زیان!(@)(@@) (@@) کردند تجارتی، زما هر دونهان %~% الغیره %~% آن آب بدین سپرد و، این خواب بدان!(@)(@@) (@@) 2909 هر روز، هزار بار می ساز کنم %~% تا از 
ms291	 رخ زیبای تو، خوباز کنم(@)(@@) (@@) خونریز بود، میان چشم و دل من %~% هرگه، که من این حدیث آغاز کنم!(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 2910 ای عشق تو در درون و بیرون دلم %~% بگرفته غم تو، ربع مسکون دلم(@)(@@) (@@) امرون، دلم حدیث هجران تو کرد %~% درحال، بریخت دیدهام خون دلم!(@)(@@)(@@)(@@) | عزیز علی(@)(@@) (@@) 2911 ای روی توبسته نقش چین در چشمم %~% وز چشم تو، سیل آتشین در چشمم(@)(@@) (@@) ار نیست یقینت، که تو در چشم منی %~% اینک! من وتو، بیا ببین در چشمم!(@)(@@)(@@)(@@) | [جمال] عبدالرزاق(@)(@@) (@@) 2912 ای دیده، غم دلم یکی صد کردی %~% کردی تو نگه برویش و، بد کردی!(@)(@@) (@@) و اکنون، به سرشک می کنی رازم فاش %~% غماز چرایی؟ چو گنه خود کردی!(@)(@)PageV01P464(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0468.jpg)(@)(@)(@@)(@@)(@@) | سجاسی(@)(@@) ~~2913 با آنکه رخت کرد، تباهی بردلبگماشت، غم نامتناهی بردل(@)(@@) ~~این دیده، که از سرشک در خون غرق استاو نیز، به خون داد گواهی بر دل!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2914 کوشب، که مرا زدیده دامن ترنیست؟ %~% وزاشک من، آشیانهآ من ترنیست؟(@)(@@) (@@) گرعادت دشمن همه خون ریختن است %~% ای دیده، مرا کس از تو دشمن ترنیست!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) ~~2915 پشتم چودلم زمانه بشکست، رواست شوری دارم عاشقم و مست، رواست(@)(@@) (@@) زد مردم دیده، دست در دامن دوست %~% اوله %~% غرقه به همه چیززند دست، رواست!(@)(@@) (@@) 2916 پیوسته، حدیث عشق می گوید دل %~% رخساره، به خون دیده می شوید دل(@)(@@) (@@) رحم آر، کز آسمان نمی بارد جان! %~% بخشای، که از زمین نمی رو ید دل!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2917 چون دید، فسرده بر رخم ده تو اشک کرد از رخ من، به آستین یک سواشک(@)(@@) (@@) شمعم، که مرا به ریشخند آن دلبر %~% سر می برد و، می سترد از رو اشک!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~2918 اشکی، که زدیده پیشرو ساختمشدر گرمروی، چونیک بشناختمش(@)(@@) (@@) او بود، که آبی به رخم باز آورد %~% با اینهمه، کز دیده بینداختمش!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2919 دلدار، مرا حال تبه می دارد %~% گوشم به در و، چشم به ره می دارد(@)(@@) (@@) تا لاجرم، این مردمک 
ms292	 دیدهآ من %~% از دست غمش، جامه سیه می دارد(@)(@@) (@@) 2920 برد آب رخم یار و، هنر پندارد %~% الغیره %~% چشمم شب و روز، اشک از آن می بارد(@)(@@) (@@) از مردمک دیده، فزود آب رخم %~% هم دیدهآ من، که آب رویی دارد!(@)(@)PageV01P465(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0469.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2921 چشمم، که رخ فلان بدو می بینم %~% سرمایهآ بحر و کان بدو می بینم(@)(@@) (@@) شاید اگرش به خون دل می دارم 2922 بارغمت ای جان، به دل ریش کشم %~%(@)(@@) لغیره %~% زیرا که همه جهان، بدو می بینم %~% چندانکه جفا بیش کنی، بیش کشم(@)(@@) (@@) ور فرمایی، دیدهآ دریا دل را %~% بر دامن اشک بندم و، پیش کشم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) در آب دو دیده، مردم چشم مرا 2923 دوشم، غمت آیت بلا می آموخت %~% وز(@)(@@) چشم من، ابر گریه ها می آموخت %~% یگانگی تو، آشنا می آموخت!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2924 تیری، که زغمزهآ تو پرتابی شد %~% در خون دل سوخته، عنابی شد(@)(@@) (@@) رحمی بکن ای نگار، کز آتش دل %~% این مردم دیده، مردم آبی شد!(@)(@@)(@@)(@@) | جمال غزنوی(@)(@@) (@@) 2925 از دیده، کنون همدمیی می بینم %~% وز گریهآ أو، خرمیی می بینم(@)(@@) (@@) هر لحظه، بر آتش دلم ریزد آب %~% هم دیده، کز او مردمیی می بینم!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~ای دیده، نگفتمت: نظر در رخ او 2926 ای دل، به غمش مشو که تابت برود(@)(@@) %~% گستاخ مکن، وگرنه آبت برود؟ %~% از عشق دو زلفش، خور و خوابت برود(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2927 دل، در سر زلف تو بپیوست مرا صد در زبلا گشاد دیده، بر من %~%(@)(@@) هم دیده، کزو گشایشی هست مرا! %~% جان، کرد به طرهآ [تو] پابست مرا(@)(@@)(@@)(@@) | نمط سوم(@)(@@) درنهان داشتن عشق(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) (292 سرسخن دوست، نمی یارم گفت %~% دری است گرانمایه، نمی یارم سفت(@)(@@) (@@) ترسم، که به خواب در بگویم به کسی %~% شبهاست، کزین بیم نمی یارم خفت PageV01P466(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0470.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2929 شبها، زتف جگر نمی یارم خفتوز نوک مژه، گهر نمی یارم سفت(@)(@@) (@@) این از همه طرفه تر، که از عشق 
ms293	 کسی %~% الغیره %~% می میرم و، با کسی نمی یارم گفت!(@)(@@) ~~293 من، مهر تو در میان جان ننهادمتا، مهر تو بر سر زبان ننهادم(@)(@@) (@@) تا دل، زهمه جهان کرانه نگرفت %~% با او، سخن تو در میان ننهادم!(@)(@@) (@@) 2931 دیدار تو، از نعمت دو جهان خوشتر %~% الغیره %~% وزعمر، وصال تو فراوان خوشتر(@)(@@) (@@) من عشق تو، ای عشق تو از جان خوشتر %~% پنهان دارم، که عشق پنهان خوشتر!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2932 دل گشت مهوسی، نمی یارم گفت %~% یعنی که: به هر خسی نمی یارم گفت(@)(@@) (@@) او زنده بماناد، که من در غم او %~% می میرم و، با کسی نمییارم گفت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2933 از دیده، اگگر نه خون روان داشتمی %~% رازت، زدل خسته نهان داشتمی(@)(@@) (@@) ور زانکه نبودی، دم سرد و رخ زرد %~% رازت نه زدل، نهان زجان داشتمی!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 293 گر چه زغمت، با غم و تیمارم جفت %~% اندوه تو، صبر از دل بیمارم رفت(@)(@@) (@@) راز دلم، از زبان چنان پنهان است %~% کز دل به زبان، هیچ نمییارم گفت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2935 ای کار غمت، ز دل قرارم بردن %~% مپسند، جفای بیشمارم بردن(@)(@@) (@@) خالی نیم از نام تویک دم، لیکن %~% خ %~% نامت، بر هر کسی نیارم بردن!(@)(@@) (@@) 293 با بوی غم تو، گر توان داشتمی %~% کی، چهره به رنگ ارغوان داشتمی؟(@)(@@) (@@) خون مژه، گر فاش نکردی رازم %~% درد تو، زخود نیز نهان داشتمی!(@)(@@)(@@)(@@) | خر(@)(@@) (@@) 2937 از غایت صبر، با خرد می سازم %~% وز بوالعجبی با دل خود می سازم(@)(@@) (@@) تا، یردهآ راز من دریده نشود %~% باهر بد و نیک و، نیک و بد می سازم!(@)(@)PageV01P467(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0471.jpg)(@)(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 2938 من درد تورا، دوای جان خواهم داشت %~% چون جانش، نهان از این وآن خواهم داشت(@)(@@) (@@) راز تونه [تنها] زدل، ای راحت جان %~% تا جان دارم، زجان نهان خواهم داشت!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2939 فرخ تن آنکه در غمت مرد، نگفت %~% و اسرارتو، با بزرگ و با خرد نگفت(@)(@@) (@@) سر در کفن خاک بپیچید و، برفت %~% راز 
ms294	 غم توبدان جهان برد، نگفت!(@)(@@)(@@)(@@) | نمط چهارم(@)(@@)(@@)(@@) | در رسوا شدن(@)(@@)(@@)(@@) | شیخ اوحد کرمانی(@)(@@) (@@) 2940 اندر طلب وصل تو، ای بینایی %~% تا کی باشم، شیفته و سودایی؟(@)(@@) (@@) گفتی: نرسی به وصل بی رسوایی %~% رسوا گشتم، دگر چه می فرمایی!(@)(@@)(@@)(@@) | صدر الشریعه(@)(@@) (@@) 2941 تا باز دکم دشمن جان و تن شد %~% از دوست بگشت و عالمی دشمن شد(@)(@@) (@@) وز دیدهآ من، که تیره می دارد آب %~% بر عالمیان، سر دلم روشن شد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2942 در عشق تو، دل برفت و جان پرخطر است زیرا که دو دیده، بر سرم نوحه گر است(@)(@@) (@@) من، عشق تو را چگونه دارم پنهان؟ %~% کزدیده به دل، هزار صاحبنظر است!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2943 ای عشق تو،خان و مان برانداز دلم هجر تو: زصبر خانه پردازدلم(@)(@@) (@@) از راز دلم، خبر که دارد هرگز %~% تا اشک بوذ نهان بر این راز ذلم؟(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2940 در عشق تودل برفت، جان را چه کنم؟ %~% وین شخص ضعیف ناتوان را چه کنم؟(@)(@@) (@@) گیرم، که من آن حدیث پیدا نکنم %~% خونابهآ ناب دیدگان را چه کنم؟(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~294 مسکین دل من، وصال جان می جوید رخسارهآ من، به زعفران می شوید(@)(@@) (@@) حالی، که به صد حیله نگفتم با کس %~% خود آب دو دیده، رایگان می گوید!(@)(@)PageV01P468(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0472.jpg)(@)(@)(@@)(@@)(@@) | لقائله(@)(@@) ~~294 بیداد نگر، که اشک ما با ما کردما را بر دشمنان خود، رسوا کرد(@)(@@) (@@) در دیده، به خون جگرش پروردم %~% بیرون شد و، راز دل من پیدا کرد!(@)(@@)(@@)(@@) | القائله(@)(@@) (@@) 2947 اندر طلب وصل بت سیم اندام %~% ما را به جهان، نه ننگ ماندهست و، نه نام(@)(@@) ~~وز بهر لبش، همچوزبان افتادیمدر هر دهن و، هم نرسیدیم به کام!(@)(@@) ~~2948 آن را که غمی بود، که بتواند گفتغم ازدل خود به گفت: بتواند رفت(@)(@@) ~~این طرفه گلی نگر، که ما را بشکفتنه رنگ توان نمود و، نه بوی نهفت!(@)(@@)(@@)(@@) | خر(@)(@@) (@@) 2949 ای یوسف مصر حسن هر انجمنی %~% فریاد وفغان زتوست، در هر وطنی(@)(@@) (@@) بی آنکه 
ms295	 برآید زلبت، کام دلم %~% هستم چوزبان، فتاده در هر دهنی!(@)(@@) (@@) 2950 عمری است، که آن پریوش حور نژاد %~% ناورد به هیچ نیک و بد از ما یاد(@)(@@) ~~این طرفه، که تا زبان زما باز گرفت ما را، چوزبان در دهن خلق نهاد!(@)(@@)(@@)(@@) | خ(@)(@@) (@@) 2951 ای دوست، مده به دست غوغا ما را %~% دستی برنه، میفکن از پا ما را!(@)(@@) (@@) چون سوختهآ عشق تو گشتیم، مکن %~% خا %~% یکباره، میان خلق رسوا مارا!(@)(@@) (@@) 2952 تا بر در تو چو آستان افتادم %~% چون آب، زچشم دوستان افتادم(@)(@@) ~~از بس که زبان من به یاد لب توستدر هر دهنی، همچو زبان افتادم!(@)(@@)(@@)(@@) | خ(@)(@@) ~~2953 تامن زمیانه بر کران افتادم دور از تو، به محنتی گران افتادم(@)(@@) (@@) چندان صفت لب ودهانت گفتم %~% کاندر دهن جهانیان افتادم!(@)(@)PageV01P469(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0473.jpg)(@)(@)(@@) ~~2954 یک شهر، گشادند زبان بر من و توبستند دروغ، این و آن بر من و تو(@)(@@) (@@) ای مردمک دیده، چه تدبیر آخر؟ %~% تا ظن نبرند مردمان بر من وتوا(@)(@@) (@@) 2955 دل، در غم تو هزار جانبازی کرد %~% خون گشت و،خموش بود و، دمسازی کرد(@)(@@) (@@) کوشید بسی، به جان نهان داشت غمت %~% بوی جگر سوخته غمازی کرد!(@)(@@) ~~آمد گه آنکه آشکارا، شب وروز 2956 جانم به لب آمدهست، این راه از او(@)(@@) %~% فبریاد کنان، زنم علی الله از او! %~% از بس که کنم به پرده در، آه از او(@)(@@)(@@)(@@) | نمط پنجم(@)(@@)(@@)(@@) | در بد ناهی(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 2957 یک چندهنهان نزد دلارام شدیم %~% آخر به عیان، جفت می وجام شدیم(@)(@@) (@@) ترس من ویار من، زبدنامی بود %~% لغیره %~% اکنون زچه ترسیم؟ که بد نام شدیم!(@)(@@) (@@) 2958 آوازهآ خویش، سخت بد می شنوم %~% این حال، نه از یکی، زصد می شنوم(@)(@@) (@@) رسوای جهان چنان شدم، کزچپ و راست %~% هر جا که رسم، حدیث خود می شنوم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2959 ای از تو مرا ذخیره ناکامی بس %~% پایان غم تو، بی سرانجامی بس(@)(@@) ~~گفتی که: «ازعشق من چه داری حاصل؟»آوازه و، گفت 
ms296	 و گو و، بد نامی بس!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) د نام شدم زبهر تو، میارزد 2960 در عشق تو، گرچه هست ناکامیها %~%(@)(@@) باشد همه پختگی پس خامیها %~% عشق توبه صد. هزار بدنامیها!(@)(@)PageV01P470(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0474.jpg)(@)(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~296 تا دیدهآ عقل خویش، بر دوخته ایمما، خرمن خود به دست خود سوخته ایم(@)(@@) (@@) افسوس، که در مدت این عمر عزیز %~% الغیره %~% نامی، به هزار ننگ اندوخته ایم!(@)(@@) (@@) 296 در عشق تو، شد آنهمه دانایی من %~% سرگشتهآ غم شد، دل سودایی من(@)(@@) ~~تا، روی زمین گرفت زیبایی توبر چرخ شد، آوازهآ رسوایی من!(@)(@@) (@@) 2962 دل می نشکیبد از تو، مشکل این است %~% جان بر سر دل نهم، اگر دل این است(@)(@@) ~~گفتی که: «زعشق من چه داری حاصل؟) بد نامی و عمر رفته، حاصل این است!(@)(@@) (@@) 296 گفتم که: مرا زوصل رنگی باید %~% گفتا که: تورا در آن درنگی باید(@)(@@) (@@) گفتم که: مگو، که نام و ننگم بشود %~% خر %~% گفتا که: نخست، نام و ننگی باید!(@)(@@) (@@) 296 دل، از توی تند خوچه دارد حاصل؟ %~% جز غصه ز چند رو، چه دارد حاصل؟(@)(@@) (@@) از مملکت حسن توو، خدمت خود %~% جز بد نامی، بگو چه دارد حاصل؟(@)(@@)(@@)(@@) | نمط ششم(@)(@@)(@@)(@@) | در سفر وباز آمدن(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~2963 چندانکه بخواهی، غم و رنجوری هست در دوستیت، و آفت مهجوری هست(@)(@@) (@@) هنگام وداع است، چه می فرمایی %~% یک ساعته دیدار تو، دستوری هست؟(@)(@@)(@@)(@@) | الها(@)(@@) ~~2962 هر ناله، که بر سر شتر می کردم در پای شتر، نشار در می کردم(@)(@@) ~~هر چاه، که کاروان تهی کرد زآبمن، باز به آب دیده پر می کردم!(@)(@)PageV01P471(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0475.jpg)(@)(@)(@@)(@@)(@@) | ها(@)(@@) (@@) 2969 سودا زدهآ جمال تو، باز آمد %~% تشنه شدهآ وصال تو، باز آمد(@)(@@) (@@) نو کن قفس و، دانهآ لطف تو بپاش %~% ولها %~% کان مرغ شکسته بال تو، باز آمد!(@)(@@) (@@) 2970 تا از تف آب، چرخ افراشتهاند %~% غم در دل من، چوآتش انباشتهاند(@)(@@) (@@) سرگشته چوباد، می دوم در عالم %~% تا خاک من، از چه جای برداشتهاند؟ 
ms297	(@)(@@) (@@) 2971 ببرید زیاران، فلک ناباکم %~% و آواره بکرد، گردش افلاکم(@)(@@) (@@) تا خود، زکدام چشمه نوشم آبی؟ %~% یا خود، به کدام خطه باشد خاکم؟(@)(@@) (@@) 2972 جز محنت و غم، نیست در این ره با من %~% خون می بارم زدیده، دامن دامن(@)(@@) (@@) کس چون من مستمند دلخسته مباد %~% چشم از پس و، راه پیش و، غم پیرامن!(@)(@@) ~~2973 ای بخت، چرا شدی زما سرگردان؟وی یار، چرایی ز وفا سرگردان؟(@)(@@) (@@) وی چرخ، بگو که تا به کی خواهی داشت %~% مانندهآ خویشتن، مرا سرگردان؟(@)(@@) (@@) 2974 خورد آتش غم در این سفر، پاک مرا %~% وز آب دو دیده، کرد غمناک مرا(@)(@@) (@@) چون باد، فتاده روز و شب درتگ و پوی %~% تا خود، به کجا همی برد خاک مرا؟(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~2975 ماییم، فتاده روز و شب درتگ و تاز برخیره، نهاده روی در شیب و فراز(@)(@@) (@@) نه هیچ ره آورد، به جز رنج سفر %~% لغیره %~% نه هیچ پس افکند، به جزراه دراز!(@)(@@) (@@) 2976 آمد به وداعم، از سر ناز و نوید %~% ناهید رخی، نوحه کنان تا ناهید(@)(@@) سیاره همی راند زغم بر خورشید %~% او اشک همی سترد و، من لوح امید!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2977 در کوی تو، هیچ کار من ناشده راست %~% ایام به کین خاستن من برخاست(@)(@@) (@@) آخر به دلت گذر کند؟ چون بروم %~% کان دلشده، کی رفت وچگونه ست وکجاست؟(@)(@)PageV01P472(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0476.jpg)(@)(@)(@@) ~~2978 محبوب فراقم، چو حبیبم تونه ای یاد آور از این عاشق رنجور غریب(@)(@@) %~% لغیره %~% بیمار گرانم، چو طبیبم تونه ای! %~% شکرانهآ آنکه من غریبم، تونه ای!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2979 گفتم: بروم، همه رخش چین بگرفت %~% عنابچه هاش کار پروین بگرفت(@)(@@) (@@) میمین ذقنش، ستون سیمین بگرفت %~% در فندق او دو برگ نسرین بگرفت(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~2980 در عشق تو چون چنگ رگ و پوست شدم و اندر سر تو گرچه نه نیکوست شدم(@)(@@) (@@) عمر تو دراز باد در حسن، که من %~% گر نیک بدم و گربد، ای دوست، شدم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 298 هر مرحله ای، 
ms298	 که رخت برداشته ام %~% از خون جگر، مرحله تر داشته ام(@)(@@) (@@) از تو، خبر وصل مبادم هرگز %~% گر بی تو، زخویشتن خبر داشته ام!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 2982 ای در زلفت کرده دل و دین منزل %~% وی در شکرت، ساخته پروین منزل(@)(@@) (@@) چون خواهم رفت، بی تو چندین منزل؟ %~% اوله %~% کز دست شدم، هم به نخستین منزل!(@)(@@) ~~در هر منزل، همی بباید کردن 2982 زان لحظه، که نوش کرده ام جام وداع(@)(@@) %~% اوله %~% ترسان ترسان، همی برم نام وداع %~% آن نوحه گری، که کرد هنگام وداع!(@)(@@) (@@) 2984 نه، یاد کند یار ز رنج سفرم %~% نه، نامه فرستد ونه پرسد خبرم(@)(@@) (@@) گر دارد از این، هزار باره بترم %~% هرگز، گلهآ دوست به دشمن نبرم!(@)(@@)(@@)(@@) | وله(@)(@@) ~~2985 ای چرخ، ازاین غربت بی پایان چند؟وززیستن بی سر و [بنی] سامان چند؟(@)(@@) (@@) آواره زخان ومان وکام دل خویش %~% از بهر خدای، ای مسلمانان چند؟(@)(@)PageV01P473(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0477.jpg)(@)(@)(@@) باب دوازدهم - عشق(@)(@@)(@@)(@@) | وله(@)(@@) ~~2986 گر سایهآ من، بود گران بر نظرت من رفتم وسایه رفت، دل ماند برت(@)(@@) (@@) هم زحمت من، زسایهآ تو برخاست %~% هم زحمت سایهآ من، از خاک درت(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2987 هنگام وداع، آن بت زهره نظر %~% گریان گریان، گرفت ما را در بر(@)(@@) (@@) در دیده و اشک او چو کردیم نگاه %~% دیدیم: هزار زهره، بر روی قمر!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2988 یادم، چو از آن عزم سفر می آید %~% بر من، همه خوشدلی به سر می آید(@)(@@) (@@) گلگون سرشکم، که چوآبی است روان %~% از گرمروی، به روی در می آید!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2989 جانا، نظری برتن بیمارم نه %~% دستی، به کرم بر دل غمخوارم نه(@)(@@) (@@) یک لحظه بیا، که من بخواهم رفتن %~% ره توشه ای از وصال، در بارم نه!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2990 ای دل، ز فراق یار رعنا بگری %~% چون ابر بنال و، همچو دریا بگری(@)(@@) (@@) بر وصل دروغ امشبین، خنده مزن %~% بر فرقت راستین فردا، بگری!(@)(@@)(@@)(@@) | وله(@)(@@) ~~2991 چاکر، به درت خسته جگر باز آمددرمانده و ناخوانده، 
ms299	 ز در باز آمد(@)(@@) (@@) این شوخ گریز پا، دگر بازآمد %~% بیچاره به پا رفت و، به سر باز آمد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 2992 عاشق، برت ای شمع چگل باز آمد %~% مسکین چه کند زدست دل؟ بازآمد!(@)(@@) (@@) تشنیع زنان، غمین غمین شد زبرت %~% تشو یر خوران، خجل خجل باز آمد!(@)(@)PageV01P474(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0478.jpg)(@)(@)(@@)(@@)(@@) | 75(@)(@@) (@@) 2993 گر وقت مرا پای به گل باز آمد %~% اوله %~% دیوانه بدم، عقل به دل باز آمد(@)(@@) (@@) آن بندهآ بگریخته از درگه تو %~% فریاد کنان، خجل خجل باز آمد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2994 رفتم به سفر، من از جفا کردن تو %~% وز محنت عاشقی و، غم خوردن تو(@)(@@) (@@) در غربت اگر بمیرم، ای جان و جهان %~% اوله %~% خون من مستمند، در گردن توا(@)(@@) (@@) 2995 گر باز آیم، یاد تو ساغر گیرم %~% خاک قدمت، چو تاج بر سر گیرم(@)(@@) (@@) گر رنجه کنی پای، به استقبالم %~% وله %~% گر دست رسد، پای تو در زر گیرم!(@)(@@) (@@) 2996 پالوده شدم، زخون دل پالودن %~% فرسوده شدم، زدل به غم فرسودن(@)(@@) (@@) با توبه حضر، قرار و آرامم نیست %~% بی تو به سفر، چگونه خواهم بودن؟(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 2997 رفتیم زشهرت، ای به رخ چون مه نو %~% کردیم دل خسته، به یک بوس گرو(@)(@@) (@@) ای راحت جان من، زیانی دارد؟ %~% لقائله %~% از روی نفاق، اگر بگویی که: مرو!(@)(@@) (@@) 2998 اینک رفتم من، ای بت بنده نواز %~% تا چون باشم بی تو، در این راه دراز؟(@)(@@) (@@) زنهار بتا، تا بر تو آیم باز %~% عشرت مکن و، می مخور و، رود مسازا(@)(@@) ~~بر مرکب غربت افکنم، مفرش عشق 2999 تا کی کشم، این فتنه و زرق خوش(@)(@@) عشق؟ %~% جان ودل من، بماند در ترکش عشق %~% جز آب غریبی، نگشد آتش عشق!(@)(@@) ~~3000 می نتوانم، فراقت اندیشیدنوین شربت چون زهر سفر نوشیدن(@)(@@) (@@) پیوسته، از آن پر آب دارم دیده %~% تا بی رخ تو، جهان نباید دیدن PageV01P475(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0479.jpg)(@)(@)(@@)(@@)(@@) | نمط هفتم(@)(@@) درپیام دادن و، کربابه(؟)(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 3001 ای باد، اگر چه باد می پیمایم 
