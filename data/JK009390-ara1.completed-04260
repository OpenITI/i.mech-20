ms4241	 :(@)(@@) | 30 ( اللهم أعز الإسلام بأبي جهل بن هشام أو بعمر بن الخطاب ، فأصبح عمر رضي الله عنه فغدا علاى رسول الله ثم خرج فصلى في المسجد ظاهرا ) ( كر ) . )(@)(@@) PageV13P303(@)(@@)(@@)(@@) $ ( 1179 ) عن نافع عن ابن عمر عن ابن عباس رضي الله عنهم أن النبي قال :(@)(@@) | 30 ( اللهم أعز الدين بعمر ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1180 ) عن ابن عمر رضي الله عنهما قال :(@)(@@) | 30 ( لما طعن عمر رضي الله عنه قال له ابن عباس : أبشر قد دعا لك رسول الله أن يعز بك الدين والمسلمون مختفون بمكة ، فلما أسلمت كان إسلامك عزا ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1181 ) عن ابن عباس رضي الله عنهما قال :(@)(@@) | 30 ( لما أسلم عمر رضي الله عنه نزل جبريل علاى النبي فقال : يا محمد استبشر أهل السماء بإسلام عمر ) ( قط في الأفراد ، كر ) . )(@)(@@)(@@)(@@) $ ( 1182 ) عن يعقوب القمي عن جعفر بن أبي المغيرة عن سعيد بن جبير عن ابن عباس رضي الله عنهم قال :(@)(@@) | 30 ( نزل جبريل علاى النبي فقال : أقرىء عمر عن ربه السلام واعلم أن رضاه حكم ، وغضبه عز ) ( عد ، كر ، قال عد : لم يقل ( عن ابن عباس ) غير إسماعيل بن أبان ، ورواه جماعة عن يعقوب عن جعفر عن سعيد بن جبير مرسلا ، ورواه بعضهم عن يعقوب عن أنس رضي الله عنه ) . )(@)(@@)(@@)(@@) $ ( 1183 ) عن ابن عباس رضي الله عنهما قال :(@)(@@) | 30 ( نظر النبي يوم إلاى عمر بن الخطاب رضي الله عنه فتبسم إليه فقال : يا ابن الخطاب أتدري لم تبسمت إليك ؟ قال : الله ورسوله أعلم ، قال : إن الله باهى ملائكته ليلة عرفة بأهل عرفة عامة ، وباهاى بك خاصة ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1184 ) عن ابن عباس رضي الله عنهما قال :(@)(@@) | 30 ( قال رسول الله : إن الله باهى بالناس يوم عرفة عامة وباهاى بعمر بن الخطاب خاصة ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1185 ) عن عائشة رضي الله عنها قالت :(@)(@@) | 30 ( زينوا مجالسكم بالصلاة علاى النبي وبذكر عمر بن الخطاب ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1186 ) عن ابن عمر رضي الله عنهما أن رسول الله قال :(@)(@@) | 30 ( اللهم أعز الإسلام بأحب هاذين الرجلين إليك : بعمر بن الخطاب 
ms4242	 أو بأبي جهل بن هشام PageV13P304 فكان أحبهما إلاى الله عمر بن الخطاب ) ( حم وعبد بن حميد ، ع ، كر ) . )(@)(@@)(@@)(@@) $ ( 1187 ) عن ابن عمر رضي الله عنهما قال : قال رسول الله :(@)(@@) | 30 ( اللهم اشدد الدين بأحب الرجلين إليك : بعمر بن الخطاب أو بأبي جهل بن هشام قال رسول الله : فشد بعمر ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1188 ) عن ابن عمر رضي الله عنهما قال : سمعت رسول الله يقول :(@)(@@) | 30 ( بينا أنا نائم رأيتني في الجنة ، فإذا أنا بامرأة تتوضأ إلاى جانب قصر فقلت : لمن هاذا القصر ؟ فقالوا : لعمر ، فذكرت غيرته فوليت مدبرا ، فبكى عمر وهو في المجلس فقال : عليك بأبي وأمي أنت يا رسول الله أغار . ( كر ) . )(@)(@@)(@@)(@@) $ ( 1189 ) عن ابن عباس رضي الله عنهما :(@)(@@) | 30 ( ركب عمر رضي الله عنه فرسا علاى عهد رسول الله فركضه فانكشف فخذه ، فرأى أهل نجران علاى فخذه شامة سوداء فقالوا : هاذا الذي نجده في كتابنا أنه يخرجنا من أرضنا ) ( أبو نعيم في المعرفة وسنده صحيح ) . )(@)(@@)(@@)(@@) $ ( 1190 ) عن الحسن رضي الله عنه قال :(@)(@@) | 30 ( لقد فرح أهل الإسلام بإسلام عمر رضي الله عنه ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1191 ) عن سعيد بن جبير رضي الله عنه قال :(@)(@@) | 30 ( كان النبي يصلي فمر رجل من المسلمين علاى رجل من المنافقين فقال له : النبي يصلي وأنت جالس فقال له : امض إلاى عملك إن كان لك عمل ، فقال : ما أظن إلا سيمر عليك من ينكر عليك ، فمر عليه عمر بن الخطاب فقال له : يا فلان النبي يصلي وأنت جالس فقال له مثلها ، فوثب عليه فضربه حتى انتهر ، ثم دخل المسجد فصلى مع النبي ، فلما انفتل النبي قام إليه عمر رضي الله عنه ، قال : يا نبي الله مررت آنفا علاى فلان وأنت تصلي فقلت له : النبي يصلي وأنت جالس قال : مر إلاى عملك إن كان لك عمل ، فقال النبي : فهلا ضربت عنقه ؟ فقام مسرعا ، فقال النبي : يا عمر ارجع ، فإن غضبك عز ورضاك حكم ، إن لله في السماوات السبع ملائكة يصلون له غني عن صلاة فلان ، فقال له PageV13P305 عمر 
ms4243	 : يا نبي الله وما صلاتهم فلم يرد عليه شيئا ، فأتاه جبريل فقال : يا نبي الله سألك عمر عن صلاة أهل السماء ؟ قال : نعم ، قال : أقرىء عمر السلام وأخبره أن أهل السماء الدنيا سجود إلاى يوم القيامة يقولون : سبحان ذي الملك والملكوت ، وأهل السماء الثانية قيام إلاى يوم القيامة يقولون : سبحان رب العزة والجبروت وأهل السماء الثالثة قيام إلاى يوم القيامة يقولون : سبحان الحي الذي لا يموت ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1192 ) عن ابن مسعود رضي الله عنه قال : قال رسول الله :(@)(@@) | 30 ( اللهم أيد الإسلام بعمر ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1193 ) عن ابن مسعود رضي الله عنه قال :(@)(@@) | 30 ( ما زلنا أعزة منذ أسلم عمر رضي الله عنه ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1194 ) عن ابن مسعود رضي الله عنه قال :(@)(@@) | 30 ( إن إسلام عمر رضي الله عنه كان عزا ، وإن هجرته كانت فتحا ونصرا ، وإمارته كانت رحمة ، والله ما استطعنا أن نصلي حول البيت ظاهرين حتى أسلم عمر رضي الله عنه ، فلما أسلم عمر قاتلهم حتى صلينا ، وإني لأحسب بين عيني عمر ملكا يسدده ، وإني لأحسب الشيطان يفرقه ، وإذا ذكر الصالحون فحي هلا بعمر ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1195 ) عن ابن مسعود رضي الله عنه قال :(@)(@@) | 30 ( ما كنا نتعاجم أن السكينة تنطق علاى لسان عمر رضي الله عنه ) ( كر ) . )(@)(@@)(@@)(@@) $ 1196 عن ابن مسعود رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : إن عمر من أهل الجنة ) ( عد ، كر ) . )(@)(@@)(@@)(@@) $ ( 1197 ) عن أبي عقيل عن جده قال :(@)(@@) | 30 كنا مع النبي وهو آخذ بيد عمر بن الخطاب رضي الله عنه فقال : أتحبني يا عمر ؟ قال : لأنت أحب إلي من كل شيء إلا نفسي ، فقال له النبي : لا والذي نفسي بيده حتى أكون أحب إليك من نفسك فقال عمر : فأنت يا رسول الله أحب إلي من نفسي ، فقال النبي : الآن يا عمر ) ( كر ) . )(@)(@@) PageV13P306(@)(@@)(@@)(@@) $ ( 1198 ) عن الشعبي قال :(@)(@@) | 30 ذكر عند علي قول عمر رضي الله عنه : ( قد ألقي في روعي أنكم إذا لقيتم العدو هزمتموهم ، فقال علي رضي الله عنه : ما كنا نبعد أن 
ms4244	 السكينة تنطق علاى لسان عمر رضي الله عنه ، وإن في القرآن لرأيا من رأي عمر ) . وقال الشعبي : ( إن لكل أمة محدثا وإن محدث هاذه الأمة عمر بن الخطاب ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1199 ) عن مجاهد قال :(@)(@@) | 30 ( كان عمر رضي الله عنه إذا رأى رأيا نزل به القرآن ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1200 ) عن علي رضي الله عنه قال :(@)(@@) | 30 ( كنا نتحدث أن السكينة تنطق علاى لسان عمر وقلبه ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1201 ) عن وهب السوائي قال :(@)(@@) | 30 ( خطب علي رضي الله عنه الناس فقال : من خير هاذه الأمة بعد نبيها ؟ قالوا : أنت يا أمير المؤمنين قال : لا ، بل أبو بكر ثم عمر رضي الله عنهما ، إنا كنا نظن أن السكينة لتنطق علاى لسان عمر ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1202 ) عن علي رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : اتقوا غضب عمر بن الخطاب رضي الله عنه فإنه إذا غضب غضب الله له ) ( ابن شاهين ) . )(@)(@@)(@@)(@@) $ ( 1203 ) عن علي رضي الله عنه قال :(@)(@@) | 30 ( إن ذكر الصالحون فحي هلا بعمر رضي الله عنه ، ما كنا نبعد أصحاب محمد أن السكينة تنطق علاى لسان عمر رضي الله عنه ) ( طس ) . )(@)(@@)(@@)(@@) $ ( 1204 ) عن عبد خير قال :(@)(@@) | 30 كنت قريبا من علي رضي الله عنه حين جاءه أهل نجران ، قلت : إن كان رادا علاى عمر رضي الله عنه شيئا فاليوم قال : فسلموا واصطفوا بين يديه ، ثم أدخل بعضهم يده في كمه وأخرج كتابا فوضعه في يد علي رضي الله عنه ، قالوا : يا أمير المؤمنين خطك بيمينك وأملأ رسول الله عليك ، قال : فرأيت عليا وقد جرت الدموع علاى خده ثم رفع رأسه إليهم وقال : يا أهل نجران إن هاذا لآخر كتاب كتبته بين يدي رسول الله ، قالوا : فأعطنا ما فيه ، قال : سأخبركم عن ذالك ، إن الذي أخذ منكم عمر لم يأخذه لنفسه ، إنما أخذه لجماعة المسلمين ، وكان الذي أخذ منكم خيرا مما أعطاكم ، والله لا أرد شيئا PageV13P307 صنعه عمر وإن عمر كان رشيد الأمر ) ( ق ) . )(@)(@@)(@@)(@@) $ ( 1205 ) عن سعد بن أبي وقاص رضي الله عنه قال :(@)(@@) | 30 
ms4245	 ( استأذن عمر علاى رسول الله وعنده نسوة من قريش يسألنه ويستكثرنه ، عالية أصواتهن علاى صوته ، فلما استأذن عمر رضي الله عنه تبادرن الحجاب فأذن له رسول الله فدخل ورسول الله يضحك ، فقال : بأبي أنت وأمي يا رسول الله أضحك الله سنك ما يضحكك ؟ فقال رسول الله : عجبت من هاؤلاء اللاتي كن عندي فلما سمعن صوتك تبادرن الحجاب ، فقال عمر : فأنت يا رسول الله بأبي أنت وأمي كنت أحق أن يهبن ، ثم أقبل عليهن فقال : أي عدوات أنفسهن أتهبنني ولا تهبن رسول الله ، قلن : نعم ، أنت أفظ وأغلظ من رسول الله ، فقال رسول الله : إيه يا ابن الخطاب والذي نفس محمد بيده ما لقيك الشيطان سالكا فجا إلا سلك فجا غير فجك ) ( خ ، م ) . )(@)(@@)(@@)(@@) $ ( 1206 ) عن الزبير رضي الله عنه قال :(@)(@@) | 30 ( قال رسول الله : اللهم أعز الإسلام بعمر بن الخطاب ) ( خيثمة في فضائل الصحابة ، كر ) . )(@)(@@)(@@)(@@) $ ( 1207 ) عن عمر بن رافع القزويني عن يعقوب القمي عن جعفر بن أبي المغيرة عن سعيد بن جبير عن أنس رضي الله عنه أن النبي قال :(@)(@@) | 30 ( قال لي جبريل ) أقرىء عمر السلام وأعلمه أن رضاه عدل وغضبه عز ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1208 ) عن إبراهيم بن رستم ، حدثنا يعقوب بن عبد الله القمي عن جعفر بن أبي المغيرة عن سعيد بن جبير عن أنس بن مالك رضي الله عنه أن جبريل أتاى النبي فقال :(@)(@@) | 30 ( أقرىء عمر السلام وأعلمه أن غضبه عز ورضاه عدل ) ( عد ، كر ، قال عد : هاذا الحديث لم يوصله عن يعقوب غير إبراهيم بن رستم ، ورواه جماعة عن يعقوب عن جعفر عن سعيد بن جبير مرسلا ) . )(@)(@@)(@@)(@@) $ ( 1209 ) عن أنس رضي الله عنه :(@)(@@) | 30 ( أن رسول الله كان في داره فدخل عليه نسوة من قريش يسألنه ويستخبرنه رافعات أصواتهن فأقبل عمر رضي الله عنه فاستأذن ، فلما سمعن صوت عمر بادرن الحجاب ، فأذن لعمر فدخل ، فاشتد ضحك PageV13P308 النبي ، فقال عمر : أضحك الله سنك يا نبي الله مم ضحكت ؟ قال : لا ، إلا أن نسوة من قريش دخلن 
ms4246	 علي يسألنني ويستخرنني رافعات أصواتهن فوق صوتي ، فلما سمعن صوتك بادرن الحجاب ، فقال عمر : يا عدوات أنفسهن تهبنني وتجترين علاى نبي الله ؟ قالت امرأة منهن : إنك أفظ وأغلظ ، فقال نبي الله : مه عن عمر فوالله ما سلك عمر واديا قط فسلكه الشيطان ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1210 ) عن طارق عن عمر بن الخطاب رضي الله عنه قال :(@)(@@) | 30 ( أسلمت رابع أربعين فنزلت : { يا أيها النبي حسبك الله ومن اتبعك من المؤمنين } ( أبو محمد إسماعيل بن علي الخطبي في الأول من حديثه ) . )(@)(@@)(@@)(@@) $ ( 1211 ) عن ابن عمر رضي الله عنه قال :(@)(@@) | 30 ( اجتمعت قريش فقالوا : من يدخل علاى هاذا الصابىء فيرده عما هو عليه فيقتله ؟ فقال عمر بن الخطاب : أنا ، فأتى العين رسول الله ، فقال : يا رسول الله إن عمر بن الخطاب يأتيك فكن منه علاى حذر فلما أن صلى رسول الله صلاة المغرب قرع عمر الباب وقال : افتحي يا خديجة فلما أن دنت قالت : من هاذا ؟ قال : عمر ، قالت : يا نبي الله هاذا عمر ، فقال من عنده من المهاجرين وهم تسعة صيام وخديجة عاشرتهم : ألا نشتفي يا رسول الله فنضرب عنقه ؟ قال : لا ، ثم قال : اللهم أعز الدين بعمر بن الخطاب فلما دخل قال : ما تقول يا محمد قال : أقول أن تشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، وتؤمن بالجنة والنار والبعث بعد الموت فبايعه وقبل الإسلام ، وصبوا عليه من الماء حتى اغتسل ، ثم تعشى مع رسول الله ، وبات يصلي معه ، فلما أصبح اشتمل علاى سيفه ورسول الله يتلوه والمهاجرون خلفه حتى وقف علاى قريش وقد اجتمعوا فقال : أشهد أن لا إلاه إلا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله ، فمن شاء فليؤمن ومن شاء فليكفر ، فتفرقت حينئذ قريش عن مجالسها ) ( كر وابن النجار ) . )(@)(@@)(@@)(@@) $ ( 1212 ) عن ابن إسحاق قال :(@)(@@) | 30 ( ثم إن قريشا بعثت عمر بن الخطاب وهو يومئذ PageV13P309 مشرك في طلب رسول الله ورسول الله في دار في أصل الصفا ولقيه النحام وهو 
ms4247	 نعيم بن عبد الله بن أسيد أخو بني عدي بن كعب قد أسلم قبل ذالك وعمر متقلدا سيفه فقال : يا عمر أين تراك تعمد ؟ فقال : أعمد إلاى محمد هاذا الذي سفه أحلام قريش وسفه آلهتها وخالف جماعتها ، فقال له النحام : لبئس الممشى مشيت يا عمر ولقد فرطت وأردت هلكة بني عدي بن كعب أو تراك سلمت من بني هاشم وبني زهرة وقد قتلت محمدا فتحاورا حتى ارتفعت أصواتهما ، فقال له عمر : إني لأظنك صبؤت ولو أعلم ذلك لبدأت بك ، فلما رأى النحام أنه غير منته قال : فإني أخبرك أن أهلك وأهل ختنك قد أسلموا وتركوك وما أنت عليه من ضلالتك ، فلما سمع عمر تلك المقالة يقولها قال : وأيهم ؟ قال : ختنك وابن عمك وأختك ، فانطلق عمر حتى أتى أخته ، وكان رسول الله إذا أتته الطائفة من أصحابه من ذوي الحاجة نظر إلاى أولي السعة فيقول : عندك فلان فوافق عليه ابن عم عمر وختنه زوج أخته سعيد بن زيد بن عمرو بن نفيل ، فدفع إليه رسول الله خباب بن الأرت مولاى ثابت ابن أم أنمار حليف بني زهرة وقد أنزل الله عز وجل : { طاه ، ما أنزلنا عليك القرآن لتشقى ، إلا تذكرة لمن يخشى } وكان رسول الله دعا ليلة الخميس فقال : اللهم أعز الإسلام بعمر بن الخطاب أو بأبي الحكم بن هشام فقال ابن عم عمر وأخته : نرجو أن تكون دعوة رسول الله لعمر رضي الله عنه ، فكانت ، قال : فأقبل عمر حتى انتهى إلاى باب أخته ليغير عليها ما بلغه من إسلامها فإذا خباب بن الأرت عند أخت عمر يدرس عليها { طاه } وتدرس عليه { إذا الشمس كورت } وكان المشركون يدعون الدراسة الهينمة ، فدخل عمر ، فلما أبصرته أخته عرفت الشر في وجهه فخبأت الصحيفة ، وراغ خباب فدخل البيت . فقال عمر لاخته : ما هاذه الهينمة في بيتك ؟ قالت : ما عدا حديثا نتحدث به بيننا ، فعذلها وحلف أن لا يخرج حتى تبين شأنها ، فقال له زوجها سعيد بن زيد بن عمرو بن نفيل : إنك لا تستطيع 
ms4248	 أن تجمع الناس علاى هواك يا عمر وإن كان الحق سواه فبطش PageV13P310 به عمر فوطئه وطأ شديدا وهو غضبان ، فقامت إليه أخته تحجزه عن زوجها ، فنفحها عمر بيده فشجها ، فلما رأت الدم قالت : هل تسمع يا عمر ، أرأيت كل شيء بلغك عني مما تذكره من تركي آلهتك وكفري باللات والعزى فهو حق ، أشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، فائتمر أمرك واقض ما أنت قاض ، فلما رأى ذالك عمر سقط في يديه ، فقال عمر لاخته : أرأيت ما كنت تدرسين أعطيك موثقا من الله لا أمحوها حتى أردها إليك ولا أريبك فيها ، فلما رأت ذالك أخته ورأت حرصه علاى الكتاب رجت أن تكون دعوة رسول الله له قد لحقته فقالت : إنك نجس ولا يمسه إلا المطهرون ، ولست آمنك علاى ذالك ، فاغتسل غسلك من الجنابة وأعطني موثقا تطمئن إليه نفسي ، ففعل عمر رضي الله عنه ، فدفعت إليه الصحيفة ، وكان عمر يقرأ الكتاب فقرأ : { طاه حتى بلغ : إن الساعة آتية أكاد أخفيها لتجزى كل نفس بما تسعى إلاى قوله : فتردى } ، وقرأ : { إذا الشمس كورت حتى إذا بلغ : علمت نفس ما أحضرت } فأسلم عند ذالك عمر رضي الله عنه ، فقال لاخته وختنه : كيف الإسلام ؟ قالا : تشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، وتخلع الأنداد وتكفر باللات والعزى ، ففعل ذالك عمر ، فخرج خباب وكان في البيت داخلا ، فكبر خباب وقال : أبشر يا عمر بكرامة الله فإن رسول الله قد دعا لك أن يعز الله الإسلام بك ، فقال عمر : دلوني علاى المنزل الذي فيه رسول الله ، فقال له خباب بن الأرت رضي الله عنه : أنا أخبرك ، فأخبره أنه في الدار التي في أصل الصفا ، فأقبل عمر وهو حريص علاى أن يلقى رسول الله وقد بلغ رسول الله أن عمر يطلبه ليقتله ولم يبلغه إسلامه ، فلما انتهى عمر إلاى الدار استفتح ، فلما رأى أصحاب رسول الله عمر متقلدا بالسيف أشفقوا منه ، فلما رأى 
ms4249	 رسول الله وجل القوم فقال : افتحوا له ، فإن كان الله يريد بعمر خيرا اتبع الإسلام وصدق الرسول ، وإن كان يريد غير ذالك يكن قتله علينا هينا ، فابتدره رجال من أصحاب رسول الله ورسول الله داخل البيت يوحى إليه ، فخرج رسول الله حين سمع صوت عمر وليس عليه رداء حتى أخذ بمجمع قميص عمر وردائه ، فقال له رسول الله : ما أراك منتهيا يا عمر حتى ينزل الله PageV13P311 بك من الرجز ما أنزل بالوليد بن المغيرة ثم قال : اللهم اهد عمر فضحك عمر فقال : يا نبي الله أشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ، فكبر أهل الإسلام تكبيرة واحدة سمعها من وراء الدار ، والمسلمون يومئذ بضعة وأربعون رجلا وإحدى عشرة امرأة ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1213 ) عن أسلم قال :(@)(@@) | 30 ( كتب عمر بن الخطاب رضي الله عنه في عام الرمادة إلاى عمرو بن العاص رضي الله عنه : من عبد الله عمر أمير المؤمنين إلاى العاصي بن العاصي ، إنك لعمري ما تبالي إذا سمنت ومن قبلك وأن أعجف أنا ومن قبلي ، فيا غوثاه فكتب عمرو : السلام ، أما بعد لبيك لبيك لبيك ، عير أولها عندك وآخرها عندي مع أني أرجو أن أجد سبيلا أن أحمل في البحر ، فلما قدم أول عير دعا الزبير فقال : اخرج في أول هاذه العير فاستقبل بها نجدا ، فاحمل إلي أهل كل بيت قدرت أن تحملهم إلي ، ومن لم تستطع حمله فمره لكل أهل بيت ببعير بما عليه ، ومرهم فليلبسوا كساءين ولينحروا البعير فليجملوا شحمه وليقددوا لحمه ، وليجلدوا جلده ، ثم ليأخذوا كبة من قديد وكبة من شحم وحفنة من دقيق فيطبخوا ويأكلوا حتى يأتيهم الله برزق ، فأبى الزبير أن يخرج ، فقال : أما والله لا تجد مثلها حتى تخرج من الدنيا ثم دعا آخر أظنه طلحة فأبى ، ثم دعا أبا عبيدة بن الجراح رضي الله عنه فخرج في ذالك ، فلما رجع بعث إليه بألف دينار ، فقال أبو عبيدة : إني لم أعمل لك يا ابن الخطاب إنما عملت لله ولست آخذ 
ms4250	 في ذالك شيئا ، فقال عمر رضي الله عنه : قد أعطانا رسول الله في أشياء بعثنا لها فكرهنا ذالك ، فأبى علينا رسول الله ، فاقبلها أيها الرجل واستعن بها علاى دينك ودنياك ، فقبلها أبو عبيدة ) ( ابن خزيمة ، ك ، ق ) . )(@)(@@)(@@)(@@) $ ( 1214 ) عن ابن عمر رضي الله عنه قال :(@)(@@) | 30 ( سمعت عمر رضي الله عنه يقول عام الرمادة : اللهم لا تجعل هلاك أمة محمد علاى يدي ) ( ابن سعد ) . )(@)(@@) PageV13P312(@)(@@)(@@)(@@) $ 1215 عن أسلم قال : قال عمر رضي الله عنهما :(@)(@@) | 30 ( بئس الوالي أنا إن أكلت طيبها وأطعمت الناس كراديسها ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1216 ) عن السائب بن يزيد قال :(@)(@@) | 30 ( ركب عمر بن الخطاب رضي الله عنه عام الرمادة دابة فراثت شعيرا ، فرآها عمر فقال : المسلمون يموتون هزلا وهاذه الدابة تأكل الشعير لا والله لا أركبها حتى يحيى الناس ) ( ابن سعد ، ق ، كر ) . )(@)(@@)(@@)(@@) $ ( 1217 ) عن أنس بن مالك رضي الله عنه قال :(@)(@@) | 30 ( تقرقر بطن عمر بن الخطاب رضي الله عنه وكان يأكل الزيت عام الرمادة وكان حرم عليه السمن ، فنقر بطنه بإصبعه وقال : تقرقر تقرقرك ، إنه ليس لك عندنا غيره حتى يحيى الناس ) ( ابن سعد ، حل ، كر ) . )(@)(@@)(@@)(@@) $ ( 1218 ) عن أسلم :(@)(@@) | 30 ( أن عمر رضي الله عنه حرم علاى نفسه اللحم عام الرمادة حتى يأكله الناس ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1219 ) عن أسلم رضي الله عنه قال : كنا نقول :(@)(@@) | 30 ( لو لم يرفع الله المحل عام الرمادة لظننا أن عمر رضي الله عنه يموت هما بأمر المسلمين ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1220 ) عن فراس الديلي قال :(@)(@@) | 30 ( كان عمر بن الخطاب رضي الله عنه ينحر كل يوم علاى مائدته عشرين جزورا من جزور بعث بها عمرو بن العاص رضي الله عنه من مصر ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1221 ) عن صفية بنت أبي عبيد قالت :(@)(@@) | 30 ( حدثني بعض نساء عمر رضي الله عنه قالت : ما قرب عمر امرأة زمن الرمادة حتى أحيى الناس هما ) ( ابن سعد ، كر )(@)(@@)(@@)(@@) $ ( 1222 ) عن عيسى بن معمر قال :(@)(@@) | 30 ( نظر عمر بن الخطاب رضي الله عنه عام الرمادة إلاى بطيخة 
ms4251	 في يد بعض ولده فقال : بخ بخ يا ابن أمير المؤمنين تأكل الفاكهة وأمة محمد هزلاى فخرج الصبي هاربا وبكى فأسكت عمر بعدما سأل عن ذالك ، فقالوا : اشتراها بكف من نوى ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1223 ) عن أنس بن مالك رضي الله عنه قال :(@)(@@) | 30 ( رأيت عمر بن الخطاب رضي PageV13P313 الله عنه وهو يومئذ أمير المؤمنين يطرح له صاع من تمر فيأكلها حتى يأكل حشفها ) ( مالك ، عب وابن سعد وأبو عبيد في الغريب ) . )(@)(@@)(@@)(@@) $ ( 1224 ) عن السائب بن يزيد عن أبيه قال :(@)(@@) | 30 ( رأيت عمر ابن الخطاب رضي الله عنه يصلي في جوف الليل في مسجد رسول الله زمان الرمادة وهو يقول : اللهم لا تهلكنا بالسنين وارفع عنا البلاء يردد هاذ الكلمة ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1225 ) عن كردم(@)(@@) | 30 أن عمر رضي الله عنه بعث مصدقا عام الرمادة فقال : ( أعط من أبقت له السنة غنما وراعيا ، ولا تعط من أبقت له السنة غنمين وراعينن ) ( أبو عبيد في الأموال وابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1226 ) عن يحيى بن عبد الرحمان بن حاطب :(@)(@@) | 30 ( أن عمر رضي الله عنه أخر الصدقة عام الرمادة فلم يبعث السعاة ، فلما كان قابل ورفع الله ذالك الجدب أمرهم أن يخرجوا ، فأخذوا عقالين فأمرهم أن يقسموا فيهم عقالا ويقدموا عليه بعقال ) ( ابن سعد ، عن ابن أبي ذباب مثله أبو عبيد في الأموال ) . )(@)(@@)(@@)(@@) $ ( 1227 ) عن أسلم قال :(@)(@@) | 30 ( سمعت عمر رضي الله عنه يقول : أيها الناس إني أخشى أن تكون سخطة عمتنا جميعا فأعتبوا ربكم وانزعوا وتوبوا إليه وأحدثوا خيرا ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1228 ) عن سليمان بن يسار قال :(@)(@@) | 30 ( خطب عمر بن الخطاب رضي الله عنه الناس في زمان الرمادة فقال : أيها الناس اتقوا الله في أنفسكم وفيما غاب عن الناس من أمركم ، فقد ابتليت بكم وابتليتم بي ، فما أدري السخطة علي دونكم أو عليكم دوني ، أو قد عمتني وعمتكم ، فهلموا فلندع الله يصلح قلوبنا وأن يرحمنا وأن يرفع عنا المحل ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1229 ) عن نيار الأسلمي قال :(@)(@@) | 30 ( لما أجمع عمر رضي الله عنه 
ms4252	 علاى أن يستسقي ويخرج بالناس كتب إلاى عماله أن يخرجوا يوم كذا وكذا وأن يتضرعوا إلاى ربهم ويطلبوا إليه أن يرفع هاذا المحل عنهم ، وخرج لذالك اليوم عليه برد رسول الله حتى انتهى إلاى المصلى فخطب الناس وتضرع ، وجعل الناس PageV13P314 يلحون ، فما كان أكثر دعائه إلا الاستغفار ، حتى إذا قرب أن ينصرف رفع يديه مدا وحول رداءه وجعل اليمين علاى اليسار ، ثم اليسار علاى اليمين ، ثم مد يديه وجعل يلح في الدعاء ، وبكى عمر رضي الله عنه بكاء طويلا حتى أخضل لحيته ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1230 ) عن الليث بن سعد :(@)(@@) | 30 ( أن الناس بالمدينة أصابهم جهد شديد في خلافة عمر بن الخطاب رضي الله عنه في سنة الرمادة فكتب إلاى عمرو بن العاص رضي الله عنه وهو بمصر : من عبد الله عمر أمير المؤمنين إلاى العاص بن العاص ، سلام أما بعد فلعمري يا عمرو ما تبالي إذا شبعت أنت ومن معك أن أهلك أنا ومن معي ، فيا غوثاه ثم يا غوثاه يردده قوله . فكتب إليه عمرو ابن العاص : لعبد الله عمر أمير المؤمنين من عمرو بن العاص ، أما بعد فيا لبيك ثم يا لبيك وقد بعثت إليك بعير أولها عندك وآخرها عندي ، والسلام عليك ورحمة الله وبركاته ، فبعث عمرو إليه بعير عظيمة فكان أولها بالمدينة وآخرها بمصر يتبع بعضها بعضا ، فلما قدمت علاى عمر رضي الله عنه وسع بها علاى الناس ، ودفع إلاى أهل كل بيت بالمدينة وما حولها بعيرا بما عليه من الطعام ، وبعث عبد الرحمان بن عوف والزبير بن العوام وسعد بن أبي وقاص رضي الله عنهم يقسمونها علاى الناس ، فدفعوا إلاى أهل كل بيت بعيرا بما عليه من الطعام أن يأكلوا الطعام وينحروا البعير فيأكلوا لحمه ويأتدموا شحمه ، ويحتذوا جلده وينتفعوا بالوعاء الذي كان فيه الطعام لما أرادوا من لحاف أو غيره ، فوسع الله بذالك علاى الناس ، فلما رأى ذالك عمر رضي الله عنه حمد الله وكتب إلاى عمرو بن العاص يقدم عليه هو وجماعة من أهل مصر 
ms4253	 ، فقدموا عليه ، فقال عمر : يا عمرو إن الله قد فتح علاى المسلمين مصر وهي كثيرة الخير والطعام ، وقد ألقي في روعي لما أحببت من الرفق بأهل الحرمين والتوسع عليهم حين فتح الله عليهم مصر وجعلها قوة لهم ولجميع المسلمين أن أحفر خليجا من نيلها حتى يسيل في البحر ، فهو أسهل لما نريد من حمل الطعام إلاى PageV13P315 المدينة ومكة ، فإن حمله علاى الظهر يبعد ولا نبلغ منه ما نريد ، فانطلق أنت وأصحابك فتشاوروا علاى ذالك حتى يعتدل فيه رأيكم ، فانطلق عمرو فأخبر بذالك من كان معه من أهل مصر ، فثقل ذالك عليهم وقالوا : نتخوف أن يدخل في هاذا ضرر علاى أهل مصر ، فنرى أن تعظم ذالك علاى أمير المؤمنين وتقول له : إن هاذا الأمر لا يعتدل ولا يكون ، ولا نجد إليه سبيلا ، فرجع عمرو إلاى عمر رضي الله عنهما فضحك عمر حين رآه وقال : والذي نفسي بيده لكأني أنظر إليك يا عمرو وإلاى أصحابك حين أخبرتهم بما أمرتك به من حفر الخليج ، فثقل ذالك عليهم وقالوا : يدخل في هاذا ضرر علاى أهل مصر ، فنرى أن تعظم ذالك علاى أمير المؤمنين وتقول له : إن هاذا الأمر لا يعتدل ولا يكون ولا نجد إليه سبيلا ، فعجب عمرو من قول عمر وقال : صدقت والله يا أمير المؤمنين لقد كان الأمر علاى ما ذكرت ، فقال له عمر رضي الله عنه : انطلق يا عمرو بعزيمة مني حتى تجد في ذالك ، ولا يأتي عليك الحول حتى تفرغ منه إن شاء الله ، فانصرف عمرو وجمع لذالك من الفعلة ما بلغ منه ما أراد ، وحفر الخليج الذي في جانب الفسطاط الذي يقال له : ( خليج أمير المؤمنين ) فساقه من النيل إلاى القلزم ، فلم يأت الحول حتى جرت فيه السفن ، فحمل فيه ما أراد من الطعام إلاى المدينة ومكة ، فنفع الله بذالك أهل الحرمين ، وسمي ( خليج أمير المؤمنين ) . ثم لم يزل يحمل فيه الطعام حتى حمل فيه بعد عمر بن عبد العزيز ، ثم ضيعه الولاة بعد ذالك فترك وغلب عليه الرمل 
ms4254	 فانقطع فصار منتهاه إلاى ذنب التمساح من ناحية طحاء القلزم ) ( ابن عبد الحكم ) . )(@)(@@)(@@)(@@) $ ( 1231 ) عن الحسن :(@)(@@) | 30 ( أن رجلا قال لعمر رضي الله عنه : اتق الله قال : وما فينا خير إن لم يقل لنا ، وما فيهم خير إن لم يقولوا لنا ) ( حم في الزهد ) . )(@)(@@)(@@)(@@) $ ( 1232 ) عن بحيرة قالت :(@)(@@) | 30 ( استوهب عمي خداش من رسول الله قصعة رآه يأكل فيها فكانت عندنا ، فكان عمر رضي الله عنه يقول : أخرجوها إلي فنملأها من ماء زمزم ، فنأتيه بها فيشرب منها ويصب علاى رأسه ووجهه ، ثم إن سارقا عدا علينا فسرقها مع متاع لنا ، فجاءنا عمر رضي الله عنه بعد ما سرقت فسألنا أن نخرجها له ، فقلنا : يا أمير المؤمنين سرقت في متاع لنا ، فقال : لله أبوه سرق صحفة PageV13P316 رسول الله فوالله ما سبه ولا لعنه ) ( ابن سعد ، وابن بشران في أماليه ) . )(@)(@@)(@@)(@@) $ ( 1233 ) عن طارق بن شهاب قال :(@)(@@) | 30 ( لما قدم عمر بن الخطاب رضي الله عنه الشام عرضت له مخاضة فنزل عمر رضي الله عنه عن بعيره ونزع خفيه فأخذهما بيده وأخذ بخطام راحلته ثم خاض المخاضة ، فقال له أبو عبيدة بن الجراح : لقد فعلت يا أمير المؤمنين فعلا عظيما عند أهل الأرض نزعت خفيك وقدت راحلتك وخضت المخاضة فصك عمر بيده في صدر أبي عبيدة رضي الله عنه وقال : اوه يمد بها صوته لو غيرك يقولها أنتم كنتم أذل الناس وأضل الناس فأعزكم الله بالإسلام فمهما تطلبواالعزة بغيره يذلكم الله عز وجل ) ( ابن المبارك وهناد ، ك ، حل ، هب ) . )(@)(@@)(@@)(@@) $ ( 1234 ) عن جابر رضي الله عنه قال : قال رجل لعمر بن الخطاب رضي الله عنه :(@)(@@) | 30 ( جعلني الله فداك قال : إذن يهينك الله ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ ( 1235 ) عن أنس بن مالك رضي الله عنه قال :(@)(@@) | 30 ( سمعت عمر بن الخطاب رضي الله عنه يوما وخرجت معه حتى دخل حائطا فسمعته يقول وبيني وبينه جدار وهو في جوف الحائط : أمير المؤمنين والله لتتقين الله أو ليعذبنك ) ( مالك وابن سعد وابن أبي الدنيا في محاسبة النفس وأبو 
ms4255	 نعيم في المعرفة ، كر ) . )(@)(@@)(@@)(@@) $ ( 1236 ) عن الضحاك قال : قال عمر رضي الله عنه :(@)(@@) | 30 ( يا ليتني كنت كبش أهلي سمنوني ما بدا لهم ، حتى إذا كنت أسمن ما أكون زارهم بعض من يحبون فجعلوا بعضي شواء وبعضي قديدا ثم أكلوني فأخرجوني عذرة ولم أكن بشرا ) ( هناد حل ، هب ) . )(@)(@@)(@@)(@@) $ ( 1237 ) عن جابر رضي الله عنه قال : قال رجل لعمر بن الخطاب رضي الله عنه :(@)(@@) | 30 ( جعلني الله فداك قال : إذن يهينك الله ) ( ابن جرير ) . )(@)(@@)(@@)(@@) $ ( 1238 ) عن عامر بن ربيعة قال :(@)(@@) | 30 ( رأيت عمر بن الخطاب رضي الله عنه أخذ PageV13P317 تبنة من الأرض فقال : يا ليتني كنت هاذه التبنة ليتني لم أخلق ليتني لم أك شيئا ليت أمي لم تلدني ليتني كنت نسيا منسيا ) ( ابن المبارك وابن سعد ، ش ومسدد ، كر ) . )(@)(@@)(@@)(@@) $ ( 1239 ) عن عمر رضي الله عنه(@)(@@) | 30 أنه سمع رجلا يقرأ : { هل أتى علا الإنسان حين من الدهر لم يكن شيئا مذكورا } فقال عمر : يا ليتها تمت ) ( ابن المبارك وأبو عبيد في فضائله وعبد بن حميد وابن المنذر ) . )(@)(@@)(@@)(@@) $ ( 1240 ) عن عمر رضي الله عنه قال :(@)(@@) | 30 ( لو نادى مناد من السماء : ( يا أيها الناس إنكم داخلون الجنة كلكم أجمعون إلا رجلا واحدا لخفت أن أكون أنا هو ، ولو نادى مناد : أيها الناس إنكم داخلون النار إلا رجلا واحدا لرجوت أن أكون أنا هو ) ( حل ) . )(@)(@@)(@@)(@@) $ ( 1241 ) عن ابن عمر رضي الله عنهما أن عمر لقي أبا موسى الأشعري فقال له :(@)(@@) | 30 ( يا أبا موسى أيسرك أن عملك الذي كان مع رسول الله خلص لك وأنك خرجت من عملك كفافا خيره بشره وشره بخيره كفافا لا لك ولا عليك ؟ قال : لا يا أمير المؤمنين والله لقد قدمت البصرة وأن الجفاء فيهم لفاش فعلمتهم القرآن والسنة ، وغزوت بهم في سبيل الله ، وإني لأرجو بذالك فضله ، قال عمر : لاكن وددت أني خرجت من عملي خيره بشره ، وشره بخيره كفافا ، لا علي ولا لي ، وخلص لي عملي مع رسول الله المخلص ) ( كر ) . )(@)(@@)(@@)(@@) $ ( 1242 ) عن حسن بن 
ms4256	 محمد بن علي بن أبي طالب رضي الله عنه أن عمر بن الخطاب رضي الله عنه كان يقرأ في خطبته يوم الجمعة :(@)(@@) | 30 { إذا الشمس كورت حتى بلغ : علمت نفس ما أحضرت } ثم ينقطع ) ( الشافعي ) . )(@)(@@)(@@)(@@) $ ( 1243 ) عن الحسن قال :(@)(@@) | 30 ( دخل عمر رضي الله عنه علاى ابنه عبد الله وإن عنده لحما فقال : ما هاذا اللحم ؟ قال : اشتهيته ، قال : وكلما اشتهيت شيئا أكلته PageV13P318 كفى بالمرء سرفا أن يأكل كل ما اشتهاه ) ( ابن المبارك ، عب ، حم في الزهد والعسكري في المواعظ ، كر ) . )(@)(@@)(@@)(@@) $ ( 1244 ) عن يسار بن نمير قال :(@)(@@) | 30 ( ما نخلت لعمر رضي الله عنه طعاما قط إلا وأنا له عاص ) ( ابن المبارك وسعد وهناد ) . )(@)(@@)(@@)(@@) $ ( 1245 ) عن سعيد بن جبير رضي الله عنه قال :(@)(@@) | 30 ( بلغ عمر بن الخطاب رضي الله عنه أن يزيد بن أبي سفيان يأكل ألوان الطعام ، فقال لمولاى له يقال له يرفأ : ( إذا علمت أنه حضر عشاؤه فأعلمني ، فلما حضر عشاؤه أعلمه ، فأتى عمر فسلم واستأذن فأذن له ، فدخل فقرب عشاؤه ، فجاء بثريد ولحم فأكل عمر رضي الله عنه معه ، ثم قرب شواء فبسط يزيد يده وكف عمر ، ثم قال عمر : الله يا يزيد بن أبي سفيان أطعام بعد طعام ؟ والذي نفس عمر بيده لئن خالفتم عن سنتهم ليخالفن بكم عن طريقهم ) ( ابن المبارك ) . )(@)(@@)(@@)(@@) $ 1246 عن أبي موسى الأشعري رضي الله عنه(@)(@@) | 30 أنه قدم علاى عمر بن الخطاب رضي الله عنه مع وفد أهل البصرة ، قال : ( فكنا ندخل عليه وله كل يوم خبز يلت ، وربما وافيناه مأدوما بسمن ، أحيانا بزيت وأحيانا بلبن ، وربما وافقنا القدائد اليابسة قد دقت ثم أغلي بماء ، وربما وافقنا اللحم الغريض وهو قليل ، فقال لنا يوما : إني والله لقد أرى تقديركم وكراهيتكم طعامي ، وإني والله لو شئت لكنت أطيبكم طعاما وأرقكم عيشا أما والله ما أجهل عن كراكر وأسنمة وعن صلاء وعن صلائق وصناب قال جرير بن حازم : الصلاء : الشواء ، والصناب : الخردل ، والصلائق : الخبز الرقاق ولاكني سمعت الله عير قوما بأمر فعلوه 
ms4257	 ، فقال : { أذهبتم طيباتكم في حياتكم الدنيا ، واستمتعتم بها } ، فقال أبو موسى : لو كلمتم أمير المؤمنين ففرض لكم من بيت المال طعاما تأكلونه فكلموه ، فقال : يا معشر PageV13P319 الأمراء أما ترضون لاءنفسكم ما أرضى لنفسي ، فقالوا : يا أمير المؤمنين إن المدينة أرض ، العيش بها شديد ، ولا نرى طعامك يعشى ولا يؤكل ، وإنا بأرض ذات ريف ، وإن أميرنا يعشى وإن طعامه يؤكل ، فنكس عمر ساعة ثم رفع رأسه فقال : قد فرضت لكم من بيت المال شاتين وجريبين ، فإذا كان الغداة فضع إحدى الشاتين على أحد الجريبين فكل أنت وأصحابك ، ثم ادع بشراب فاشرب يعني : الشراب الحلال ثم اسق الذي عن يمينك ثم الذي يليه ثم قم لحاجتك ، فإذا كان بالعشي فضع الشاة الغابرة علاى الجريب الغابر فكل أنت وأصحابك ، ألا وأشبعوا الناس في بيوتهم وأطعموا عيالهم فإن تجفيتكم للناس لا يحسن أخلاقهم ولا يشبع جائعهم ، فوالله مع ذالك ما أظن رستاقا يؤخذ منه كل يوم شاتان وجريبان إلا يسرع ذالك في خرابه ) ( ابن المبارك وابن سعد ، كر ) . )(@)(@@)(@@)(@@) $ ( 1247 ) عن عروة عن عامل لعمر كان على أذرعات قال :(@)(@@) | 30 ( قدم علينا عمر بن الخطاب رضي الله عنه وإذا عليه قميص من كربيس فأعطانيه فقال : اغسله وارقعه ، فغسلت ورقعته ثم قطعت عليه قميصا قبطيا فأتيته بهما فقلت : هاذا قميصك وهاذا قميص قطعته عليه لتلبسه ، فمسه فوجده لينا فقال : لا حاجة لنا فيه ، هاذا أنشف للعرق منه ) ( ابن المبارك ) . )(@)(@@)(@@)(@@) $ ( 1248 ) عن حميد بن هلال(@)(@@) | 30 أن حفص بن أبي العاص كان يحضر طعام عمر رضي الله عنهما وكان لا يأكل ، فقال له عمر : ما يمنعك من طعامنا ؟ قال : طعامك جشب غليظ ، وإني راجع إلى طعام لين قد صنع لي فأصيب منه ، قال : أتراني أعجز أن آمر بشاة فيلقى عنها شعرها ، وآمر بدقيق فينخل في خرقة ، ثم آمر به فيخبز خبزا رقاقا ، وآمر بصاع من زبيب فيقذف في سعن ثم يصب عليه من الماء فيصبح كأنه دم غزال ؟ فقال حفص : إني لأراك عالما بطيب العيش ، فقال عمر 
ms4258	 : أجل ، والذي نفسي بيده لولا كراهية أن ينقص من حسناتي يوم القيامة لشاركتكم في لين عيشكم ) ( ابن سعد وعبد بن حميد ) . )(@)(@@) PageV13P320(@)(@@)(@@)(@@) $ ( 1249 ) عن الربيع بن زياد الحارثي(@)(@@) | 30 أنه وفد إلى عمر بن الخطاب رضي الله عنه فأعجبته هيئته ونحوه ، فشكى عمر طعاما غليظا أكله فقال الربيع : يا أمير المؤمنين إن أحق الناس بطعام لين ومركب لين وملبس لين لأنت ، فرفع عمر جريدة معه فضرب بها رأسه وقال : أما والله ما أراك أردت بها الله ، وما أردت بها إلا مقاربتي ؟ ، ويحك هل تدري ما مثلي ومثل هاؤلاء ؟ قال : وما مثلك ومثلهم ؟ قال : مثل قوم سافروا فدفعوا نفقاتهم إلاى رجل منهم فقالوا له : أنفق علينا فهل يحل له أن يستأثر منها بشيء ؟ قال : لا يا أمير المؤمنين قال : فكذالك مثلي ومثلهم ) ( ابن سعد وابن راهويه ، كر ) . )(@)(@@)(@@)(@@) $ ( 1250 ) عن عمرو بن ميمون قال :(@)(@@) | 30 ( أمنا عمر بن الخطاب رضي الله عنه في بت ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1251 ) عن أنس بن مالك رضي الله عنه قال :(@)(@@) | 30 ( رأيت عمر بن الخطاب رضي الله عنه وهو يومئذ أمير المؤمنين وقد رقع بين كتفيه برقاع ثلاث لبد بعضها فوق بعض ) ( مالك ، هب ) . )(@)(@@)(@@)(@@) $ ( 1252 ) عن عاصم بن عبيد الله بن عاصم(@)(@@) | 30 أن عمر رضي الله عنه كان يمسح بنعليه ويقول : ( إن مناديل آل عمر نعالهم ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1253 ) عن السائب بن يزيد قال :(@)(@@) | 30 ( ربما تعشيت عند عمر ابن الخطاب رضي الله عنه فيأكل الخبز واللحم ثم يمسح يده علاى قدمه ثم يقول : هاذا منديل عمر وآل عمر ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1254 ) عن أنس رضي الله عنه قال :(@)(@@) | 30 ( كان أحب الطعام إلاى عمر الثفل ، وأحب الشراب إليه النبيذ ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1255 ) عن الأحوص بن حكيم عن أبيه قال :(@)(@@) | 30 ( أتي عمر رضي الله عنه بلحم فيه سمن فأبى أن يأكلهما وقال : كل واحد منهما أدم ) ( ابن سعد ) . )(@)(@@) PageV13P321(@)(@@)(@@)(@@) $ ( 1256 ) عن أبي حازم قال :(@)(@@) | 30 ( دخل عمر بن الخطاب رضي الله عنه علاى حفصة ابنته فقدمت إليه مرقا 
ms4259	 باردا وخبزا وصبت في المرق زيتا فقال : أدمان في إناء واحد لا أذوقه حتى ألقى الله ) ( ابن سعد ) . )(@)(@@)(@@)(@@) $ ( 1257 ) عن الحسن(@)(@@) | 30 أن عمر رضي الله عنه دخل علاى رجل فاستسقاه وهو عطشان ، فأتاه بعسل ، فقال : ما هاذا ؟ قال : عسل ، قال : ( والله لا يكون فيما أحاسب به يوم القيامة ) ( ابن سعد ، كر ) . )(@)(@@)(@@)(@@) $ ( 1258 ) عن أبي وائل(@)(@@) | 30 أن عمر رضي الله عنه أتي بطعام فقال : ( ائتوني بلون واحد ) ( هناد ) . )(@)(@@)(@@)(@@) $ ( 1259 ) عن أبي وائل قال لي عمر رضي الله عنهما :(@)(@@) | 30 ( يا غلام أنضج العصيدة تذهب حرارة الزيت ، وإن أقواما يعجلون طيباتهم في حياتهم الدنيا ) ( هناد ) . )(@)(@@)(@@)(@@) $ ( 1260 ) عن عتبة بن فرقد قال :(@)(@@) | 30 ( قدمت علاى عمر رضي الله عنه بسلال خبيص فقال : ما هاذا ؟ فقلت : طعام أتيتك به لأنك تقضي في حاجات الناس أول النهار فأحببت إذا رجعت أن ترجع إلاى طعام فتصيب منه فقواك ، فكشف عن سلة منها فقال : عزمت عليك يا عتبة أرزقت كل رجل من المسلمين سلة ؟ فقلت : يا أمير المؤمنين لو أنفقت مال قيس كلها ما وسعت ذالك ، قال : فلا حاجة لي فيه ، ثم دعا بقصعة ثريد خبزا خشنا ولحما غليظا وهو يأكل معي أكلا شهيا ، فجعلت أهوي إلاى البيضة البيضاء أحسبها سناما فإذا هي عصبة : والبضعة من اللحم أمضغها فلا أسيغها ، فإذا غفل عني جعلتها بين الخوان والقصعة ، ثم دعا بعس من نبيذ قد كاد أن يكون خلا فقال : اشرب ، فأخذته وما أكاد أسيغه ، ثم أخذه فشرب ثم قال : اسمع يا عتبة : إنا ننحر كل يوم جزورا ، فأما ودكها وأطايبها فلمن حضرنا من آفاق المسلمين ، وأما عنقها فلآل عمر يأكل هاذا اللحم الغليظ ويشرب هاذا النبيذ الشديد يقطع في بطوننا أن يؤذينا ) ( هناد ) . )(@)(@@)(@@)(@@) $ ( 1261 ) عن أبي عثمان النهدي قال :(@)(@@) | 30 ( لما قدم عتبة بن فرقد آذربيجان أتي PageV13P322 بالخبيص ، فلما أكله وجد شيئا حلوا طيبا فقال : لو صنعت لأمير المؤمنين من هاذا فأمر فجعل له سفطين عظيمين ثم حملهما علاى بعير مع رجلين فسرح بهما إلاى عمر 
ms4260	 ، فلما قدم عليه فتحهما فقال : أي شيء هاذا ؟ فقالوا : خبيص ، فذاقه فإذا شيء حلو ، فقال للرسول : أكل المسلمين شبع من هاذا في رحله ؟ لعله قال : لا ، قال : أما لا فارددهما . ثم كتب إليه : أما بعد فإنه ليس من كدك ولا من كد أبيك ولا من كد أمك ، أشبع المسلمين في رحالهم مما تشبع منه في رحلك ) ( ابن راهويه وهناد والحارث ، ع ، ك ، ق ) . )(@)(@@)(@@)(@@) $ ( 1262 ) عن عمر رضي الله عنه :(@)(@@) | 30 ( أنه دعي إلاى طعام فكانوا إذا جاؤوا بلون خلطه مع صاحبه ) ( هناد ) . )(@)(@@)(@@)(@@) $ ( 1263 ) عن حبيب بن أبي ثابت عن بعض أصحابه عن عمر رضي الله عنه :(@)(@@) | 30 ( أنه قدم عليه ناس من أهل العراق فيهم جرير بن عبد الله فأتاهم بحفنة قد صنعت بخبز وزيت ، فقال لهم : خذوا ، فأخذوا أخذا ضعيفا ، فقال لهم عمر : قد أرى ما تفعلون ، فأي شيء تريدون ؟ أحلوا وحامضا ، وحارا وباردا ، ثم قذفا في البطون ) ( هناد ، حل ) . )(@)(@@)(@@)(@@) $ ( 1264 ) عن مسروق قال : $ 30 ( خرج علينا عمر رضي الله عنه ذات يوم وعليه حلة قطن فنظر إليه الناس نظرا شديدا فقال :(@)(@@) لا شيء فيما تراى إلا بشاشته %~% يبقى الالاه ويودى المال والولد(@)(@@) والله ، ما الدنيا في الآخرة إلا كنفجة أرنب ) ( هناد وابن أبي الدنيا في قصر الأمل ) . ) $(@)(@@)(@@)(@@) $ ( 1265 ) عن قتادة قال :(@)(@@) | 30 ( كان عمر رضي الله عنه وهو خليفة يلبس جبة من صوف مرقوعة بعضها بأدم ويطوف بالأسواق علاى عاتقه الدرة يؤدب الناس ويمر بالنكث والنوى فيلقطه ويلقيه في منازل الناس لينتفعوا به ) ( الدينوري في المجالسة ، كر ) . )(@)(@@) PageV13P323(@)(@@)(@@)(@@) $ ( 1266 ) عن الحسن قال :(@)(@@) | 30 ( خطب عمر بن الخطاب رضي الله عنه الناس وهو خليفة وعليه إزار فيه اثنتا عشرة رقعة ) ( حم في الزهد وهناد وابن جرير وأبو نعيم ) . )(@)(@@)(@@)(@@) $ ( 1267 ) عن أبي وائل قال :(@)(@@) | 30 ( غزوت مع عمر رضي الله عنه الشام فنزلنا منزلا فجاء دهقان يستدل علاى أمير المؤمنين حتى أتاه ، فلما رأى الدهقان عمر سجد ، فقال عمر رضي الله عنه : ما هاذا السجود ؟ فقال : هاكذا نفعل بالملوك ، فقال عمر 