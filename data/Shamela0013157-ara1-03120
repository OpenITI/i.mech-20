ms3101	 أن يكون في البيت شيء يشغل المصلي» ، قال سفيان: لم تزل قرنا الكبش في البيت حتى احترق البيت فاحترقا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث بعض أزواج النبي صلى الله عليه وسلم(@)(@@) PageV27P197(@)(@@)(@@)(@@) | 16638 - (@)(@@) حدثنا يحيى بن سعيد، عن عبيد الله قال: حدثني نافع، عن صفية، عن بعض أزواج النبي صلى الله عليه وسلم، عن النبي صلى الله عليه وسلم قال: «من أتى عرافا فصدقه بما يقول لم تقبل له صلاة أربعين يوما»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث امرأة(@)(@@) PageV27P199(@)(@@)(@@)(@@) | 16639 - (@)(@@) حدثنا إسماعيل يعني ابن إبراهيم، قال: حدثنا حسين بن ذكوان، عن إسحاق بن عبد الله بن أبي طلحة، عن عبد الله بن محمد، عن امرأة منهم قالت: دخل علي رسول الله صلى الله عليه وسلم وأنا آكل بشمالي وكنت امرأة عسراء، فضرب يدي فسقطت اللقمة فقال: «لا تأكلي بشمالك وقد جعل الله تبارك وتعالى لك يمينا» ، أو قال: «قد أطلق الله عز وجل لك يمينك» ، قال: فتحولت شمالي يمينا فما أكلت بها بعد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث رجل من خزاعة(@)(@@) PageV27P200(@)(@@)(@@)(@@) | 16640 - (@)(@@) حدثنا سفيان بن عيينة، عن إسماعيل بن أمية، عن مولى لهم يعني يقال له: مزاحم بن أبي مزاحم، عن عبد العزيز بن عبد الله بن خالد بن أسيد، عن رجل منهم من خزاعة يقال: له مخرش أو محرش لم يكن سفيان يقيم على اسمه وربما قال: محرش ولم أسمعه أنا «أن النبي صلى الله عليه وسلم خرج من الجعرانة ليلا فاعتمر ثم رجع وأصبح بها كبائت، فنظرت إلى ظهره كأنه سبيكة فضة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث رجل من ثقيف عن أبيه(@)(@@) PageV27P201(@)(@@)(@@)(@@) | 16641 - (@)(@@) حدثنا سفيان، عن ابن أبي نجيح، عن مجاهد، عن رجل من ثقيف، عن أبيه، «أن النبي صلى الله عليه وسلم بال ونضح فرجه»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث أبي جبيرة بن الضحاك الأنصاري عن عمومة له(@)(@@) PageV27P202(@)(@@)(@@)(@@) | 16642 - (@)(@@) حدثنا حفص بن غياث، قال: حدثنا داود بن أبي هند، عن الشعبي، عن أبي جبيرة بن الضحاك الأنصاري، عن عمومة له، قدم النبي صلى الله عليه وسلم وليس أحد منا إلا له لقب أو لقبان قال: فكان إذا دعا بلقبه 
ms3102	 قلنا: يا رسول الله، إن هذا يكره هذا، قال: فنزلت: «ولا تنابزوا بالألقاب»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث معاذ بن عبد الله بن خبيب(@)(@@) PageV27P203(@)(@@)(@@)(@@) | 16643 - (@)(@@) حدثنا أبو عامر، قال: حدثنا عبد الله بن أبي سليمان، شيخ صالح حسن الهيئة مديني، قال: حدثنا معاذ بن عبد الله بن خبيب، عن أبيه، عن عمه قال: «كنا في مجلس فطلع علينا رسول الله صلى الله عليه وسلم» فذكره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث رجل من بني سليط(@)(@@) PageV27P204(@)(@@)(@@)(@@) | 16644 - (@)(@@) حدثنا أبو عامر، قال: حدثنا عباد يعني ابن راشد، عن الحسن، عن رجل من بني سليط، أنه مر على رسول الله صلى الله عليه وسلم وهو قاعد على باب مسجده محتب وعليه ثوب له قطر، ليس عليه ثوب غيره وهو يقول: «المسلم أخو المسلم، لا يظلمه ولا يخذله» ، ثم أشار بيده إلى صدره يقول: «التقوى هاهنا، التقوى هاهنا»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث رجل من الأنصار(@)(@@) PageV27P205(@)(@@)(@@)(@@) | 16645 - (@)(@@) حدثنا معاوية بن عمرو، قال: حدثنا زائدة، قال: حدثنا الركين بن الربيع بن عميلة، عن أبي عمرو الشيباني، عن رجل من الأنصار، عن النبي قال: " الخيل ثلاثة: فرس يربطه الرجل في سبيل الله عز وجل، فثمنه أجر، وركوبه أجر، وعاريته أجر، وعلفه أجر، وفرس يغالق عليه الرجل ويراهن، فثمنه وزر، وعلفه وزر، وفرس للبطنة، فعسى أن يكون سدادا من الفقر إن شاء الله تعالى "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث يحيى بن حصين بن عروة عن جدته(@)(@@) PageV27P206(@)(@@)(@@)(@@) | 16646 - (@)(@@) حدثنا يحيى بن سعيد، عن شعبة قال: حدثنا يحيى بن حصين بن عروة، قال: حدثتني جدتي قالت: سمعت رسول الله صلى الله عليه وسلم يقول: «ولو استعمل عليكم عبد يقودكم بكتاب الله عز وجل فاسمعوا له وأطيعوا»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16647 - (@)(@@) حدثنا وكيع، قال: حدثنا شعبة، عن يحيى بن حصين، عن جدته قالت: سمعت رسول الله صلى الله عليه وسلم يقول: «يرحم الله المحلقين» ، قالوا في الثالثة: والمقصرين، قال: «والمقصرين»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث ابن نجاد عن جدته(@)(@@) PageV27P208(@)(@@)(@@)(@@) | 16648 - (@)(@@) حدثنا وكيع، قال: حدثنا سفيان، عن منصور بن حيان الأسدي، عن ابن نجاد، عن جدته قالت: قال رسول الله صلى الله عليه وسلم: «ردوا 
ms3103	 السائل ولو بظلف محترق أو محرق»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث يحيى بن حصين عن أمه(@)(@@) PageV27P209(@)(@@)(@@)(@@) | 16649 - (@)(@@) حدثنا وكيع، عن إسرائيل، عن أبي إسحاق، عن يحيى بن الحصين، عن أمه قالت: سمعت رسول الله صلى الله عليه وسلم يخطب في حجة الوداع يقول: «يا أيها الناس، اتقوا الله واسمعوا وأطيعوا، وإن أمر عليكم عبد حبشي مجدع ما أقام فيكم كتاب الله عز وجل»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث امرأة(@)(@@) PageV27P210(@)(@@)(@@)(@@) | 16650 - (@)(@@) حدثنا يزيد بن هارون، قال: أخبرنا محمد بن إسحاق، عن ابن ضمرة بن سعيد، عن جدته، عن امرأة من نسائهم قال: وقد كانت صلت القبلتين مع رسول الله صلى الله عليه وسلم قالت: دخل علي رسول الله صلى الله عليه وسلم فقال لي: «اختضبي، تترك إحداكن الخضاب حتى تكون يدها كيد الرجل» ، قالت: فما تركت الخضاب حتى لقيت الله عز وجل، وإن كانت لتختضب وإنها لابنة ثمانين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث رباح بن عبد الرحمن بن حويطب، عن جدته(@)(@@) PageV27P211(@)(@@)(@@)(@@) | 16651 - (@)(@@) حدثنا الهيثم بن خارجة، قال عبد الله: وقد سمعته أنا من الهيثم قال: حدثنا حفص بن ميسرة، عن ابن حرملة، عن أبي ثفال المري أنه قال: سمعت رباح بن عبد الرحمن بن حويطب يقول: حدثتني جدتي، أنها سمعت أباها يقول: سمعت النبي صلى الله عليه وسلم يقول: «لا صلاة لمن لا وضوء له، ولا وضوء لمن لم يذكر الله تعالى، ولا يؤمن بالله من لم يؤمن بي، ولا يؤمن بي من لا يحب الأنصار» ،(@)(@@)(@@)(@@) | [ص: 213](@)(@@)(@@)(@@) | 16652 - (@)(@@) قال عبد الله بن أحمد: حدثنا شيبان، قال: حدثنا يزيد بن عياض، عن أبي ثفال، بهذا الحديث، وقال: سمعت أباها سعيد بن زيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حديث أسد بن كرز جد خالد القسري(@)(@@) PageV27P214(@)(@@)(@@)(@@) | 16653 - (@)(@@) قال عبد الله بن أحمد: حدثنا أبو معمر، حدثنا هشيم، قال: أخبرنا سيار، عن خالد بن عبد الله القسري، عن أبيه، أن النبي صلى الله عليه وسلم قال لجده يزيد بن أسد: «أحب للناس ما تحب لنفسك»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16654 - (@)(@@) قال عبد الله بن أحمد: حدثنا عقبة بن مكرم العمي، قال: حدثنا سلم بن قتيبة، عن 
ms3104	 يونس بن أبي إسحاق، عن إسماعيل بن أوسط، عن خالد بن عبد الله، عن جده أسد بن كرز، سمع النبي صلى الله عليه وسلم يقول: «المريض تحات خطاياه كما يتحات ورق الشجر»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16655 - (@)(@@) قال عبد الله بن أحمد: حدثني محمد بن عبد الله الرزي أبو جعفر، قال: حدثنا روح بن عطاء بن أبي ميمونة، قال: حدثنا سيار، أنه سمع خالد بن عبد الله القسري وهو يخطب على المنبر وهو يقول: حدثني أبي، عن جدي أنه قال: قال رسول الله صلى الله عليه وسلم: «أتحب الجنة؟» ، قال: قلت: نعم، قال: «فأحب لأخيك ما تحب لنفسك»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16656 - (@)(@@) قال عبد الله بن أحمد: حدثني أبو الحسن عثمان بن أبي شيبة بالكوفة سنة ثلاثين ومائتين، ويعقوب الدورقي، قالا: حدثنا هشيم بن بشير، قال عثمان بن أبي شيبة: أخبرنا سيار قال: سمعت خالد بن عبد الله القسري على المنبر يقول: حدثني أبي، عن جدي يزيد بن أسد قال: قال لي رسول الله صلى الله عليه وسلم: «يا يزيد بن أسد، أحب للناس الذي تحب لنفسك»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | بقية حديث الصعب بن جثامة(@)(@@) PageV27P218(@)(@@)(@@)(@@) | 16657 - (@)(@@) قال عبد الله بن أحمد، حدثنا محمد بن أبي بكر وهو المقدمي، قال: حدثنا محمد بن ثابت العبدي، قال: حدثنا عمرو بن دينار، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن الصعب بن جثامة، أنه أهدى لرسول الله صلى الله عليه وسلم لحم صيد فلم يقبله، فرأى ذلك في وجه الصعب فقال: «إنه لم يمنعنا أن نقبل منك إلا أنا كنا حرما»(@)(@@) PageV00P000(@)(@@) قال: وسئل عن الخيل يوطئونها أولاد المشركين بالليل، فقال: «هم يعني من آبائهم»(@)(@@) PageV27P218(@)(@@) وقال: «لا حمى إلا لله ولرسوله»(@)(@@) PageV27P218(@)(@@)(@@)(@@) | 16658 - (@)(@@) قال عبد الله بن أحمد: حدثني أبو خيثمة زهير بن حرب، قال: حدثنا سفيان، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن الصعب بن جثامة قال: مر بي رسول الله صلى الله عليه وسلم وأنا بالأبواء أو بودان فأهديت له لحم حمار وحش وهو 
ms3105	 محرم، فرده علي، فلما رأى في وجهي الكراهية قال: «ليس بنا رد عليك ولكنا حرم»(@)(@@) PageV00P000(@)(@@) قال: وسمعته يقول: «لا حمى إلا لله ولرسوله»(@)(@@) PageV27P219(@)(@@) قال: وسئل عن أهل الدار من المشركين يبيتون فيصاب من نسائهم وذراريهم، قال: «هم منهم»(@)(@@) PageV27P219(@)(@@)(@@)(@@) | 16659 - (@)(@@) قال عبد الله بن أحمد حدثنا مصعب هو الزبيري، قال: حدثني عبد العزيز بن محمد، عن عبد الرحمن بن الحارث بن(@)(@@)(@@)(@@) | [ص: 220](@)(@@) عبد الله بن عياش المخزومي، عن ابن شهاب، عن عبيد الله بن عبد الله بن عتبة بن مسعود، عن عبد الله بن عباس، عن الصعب بن جثامة الليثي، أن رسول الله صلى الله عليه وسلم حمى النقيع وقال: «لا حمى إلا لله ولرسوله»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16660 - (@)(@@) قال عبد الله بن أحمد: حدثنا مصعب بن عبد الله، قال: حدثني مالك بن أنس، عن ابن شهاب، عن عبيد الله بن عبد الله بن عتبة بن مسعود، عن عبد الله بن عباس، عن الصعب بن جثامة الليثي، عن النبي صلى الله عليه وسلم، أنه أهدى لرسول الله صلى الله عليه وسلم حمارا وحشيا وهو بالأبواء أو بودان، فرده رسول الله صلى الله عليه وسلم، فلما رأى رسول الله صلى الله عليه وسلم ما في وجهي قال: «إنا لم نرده عليك إلا أنا حرم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16661 - (@)(@@) قال عبد الله بن أحمد، حدثنا منصور بن أبي مزاحم، قال: حدثنا أبو أويس عبد الله بن أويس، سمعت منه في خلافة المهدي، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن الصعب بن جثامة قال: أهديت للنبي صلى الله عليه وسلم حمارا عقيرا وحشيا بودان، أو قال: بالأبواء، قال: فرده علي، فلما رأى شدة ذلك في وجهي قال: «إنا إنما رددناه عليك لأنا حرم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16663 - (@)(@@) قال عبد الله بن أحمد حدثني عبيد الله بن عمر القواريري، قال: حدثنا حماد بن زيد، قال: سمعت صالح بن كيسان يحدث، عن عبيد الله بن عبد الله، عن عبد الله بن عباس، عن الصعب بن جثامة، أن رسول الله صلى 
ms3106	 الله عليه وسلم بينما هو بودان إذ أتاه الصعب بن جثامة أو رجل ببعض حمار وحش فرده عليه فقال: «إنا حرم لا نأكل الصيد»(@)(@@) PageV00P000(@)(@@) قال عبد الله بن أحمد: حدثنا محمد بن أبي بكر، قال: حدثنا حماد بن زيد، قال: حدثنا عمرو بن دينار، عن ابن عباس، عن الصعب بن جثامة، أن رسول الله صلى الله عليه وسلم قال: «لا حمى إلا(@)(@@)(@@)(@@) | [ص: 223](@)(@@) لله ورسوله»(@)(@@) PageV27P222(@)(@@)(@@)(@@) | 16664 - (@)(@@) قال عبد الله بن أحمد: حدثنا محمد بن أبي بكر، قال: حدثنا حماد، حدثنا عمرو، عن ابن عباس، عن الصعب بن جثامة قال: قيل: يا رسول الله، إن خيلنا أوطت أولاد المشركين، فقال رسول الله صلى الله عليه وسلم: «هم من آبائهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16665 - (@)(@@) قال عبد الله بن أحمد: حدثني محمد بن أبي بكر، قال: حدثنا حماد، حدثنا عمرو بن دينار، عن ابن عباس(@)(@@)(@@)(@@) | [ص: 224](@)(@@) ، عن الصعب بن جثامة قال: أتي رسول الله صلى الله عليه وسلم بودان بحمار وحش فرده وقال: «إنا حرم لا نأكل الصيد»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16666 - (@)(@@) حدثنا عامر بن صالح الزبيري، سنة ثمانين ومائة، قال: حدثني يونس بن يزيد، عن ابن شهاب، عن عبيد الله بن عبد الله بن عتبة بن مسعود، عن ابن عباس، عن الصعب بن جثامة، قال: سمعت رسول الله صلى الله عليه وسلم يقول: «لا حمى إلا لله ولرسوله»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16667 - (@)(@@) قال عبد الله بن أحمد حدثني أبو حميد الحمصي أحمد بن محمد بن المغيرة بن سيار، قال: حدثنا حيوة، قال: حدثنا بقية، عن صفوان بن عمرو، عن راشد بن سعد قال: لما فتحت إصطخر نادى مناد: ألا إن الدجال قد خرج، قال: فلقيهم الصعب بن جثامة قال: فقال: لولا ما تقولون لأخبرتكم أني سمعت رسول الله صلى الله عليه وسلم يقول: «لا يخرج الدجال حتى يذهل الناس عن ذكره، وحتى تترك الأئمة ذكره على المنابر»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16668 - (@)(@@) قال عبد الله بن أحمد: حدثني أبو حميد، قال: حدثنا عبد الوهاب بن نجدة، قال: حدثنا إسماعيل بن عياش، قال: حدثني جعفر بن 
ms3107	 الحارث، عن محمد بن إسحاق، عن الزهري، عن عبيد الله بن عبد الله بن عتبة بن مسعود، عن ابن عباس، عن الصعب بن جثامة الليثي قال: سألت رسول الله صلى الله عليه وسلم عن الدار من دور المشركين نغشاها بياتا، فكيف بمن يكون تحت الغارة من الولدان؟ قال: «هم منهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16669 - (@)(@@) حدثنا عبد الله، قال: أخبرنا إسحاق بن منصور الكوسج من أهل مرو في سنة ثمان وعشرين ومائتين قال: أخبرنا سفيان بن عيينة، عن الزهري، عن عبيد الله يعني ابن عبد الله، عن ابن عباس، أخبره الصعب بن جثامة: سئل النبي صلى الله عليه وسلم عن أهل الدار من المشركين يبيتون فيصاب من نسائهم وذراريهم، قال: «هم(@)(@@)(@@)(@@) | [ص: 227](@)(@@) منهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16670 - (@)(@@) قال عبد الله بن أحمد: أخبرنا إسحاق بن منصور قال: أخبرنا عبد الرزاق قال: أخبرنا معمر، عن الزهري، عن عبيد الله بن عبد الله، عن ابن عباس، عن الصعب بن جثامة قال: قلت: يا رسول الله، إنا نصيب في البيات من ذراري المشركين، قال: «هم منهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16671 - (@)(@@) قال عبد الله بن أحمد: أخبرنا إسحاق بن منصور، قال: أخبرنا يعقوب بن إبراهيم يعني ابن سعد قال: حدثنا أبي، عن صالح يعني ابن كيسان، عن ابن شهاب، أن عبيد الله بن عبد الله أخبره، أن ابن عباس أخبره، أن الصعب بن جثامة أخبره، أنه أهدى لرسول الله صلى الله عليه وسلم حمار وحش وهو بودان، فرده عليه، قال: فلما رأى ما في وجهي قال: «إنا لم نرده عليك إلا أنا حرم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16672 - (@)(@@) قال عبد الله بن أحمد: أخبرنا إسحاق بن منصور، قال: حدثنا يعقوب بن إبراهيم يعني ابن سعد قال: حدثنا أبي، عن صالح يعني ابن كيسان، عن ابن شهاب، أن عبيد الله بن عبد الله أخبره، أن ابن عباس أخبره، أن الصعب بن جثامة أخبره، أنه أهدى لرسول الله صلى الله عليه وسلم حمار وحش وهو بودان، فرده عليه، فلما رأى ما في وجهي قال: «إنا لم نرده عليك إلا أنا 
ms3108	 حرم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16673 - (@)(@@) قال عبد الله بن أحمد: أخبرنا إسحاق، قال: أخبرنا يعقوب بن إبراهيم قال: حدثنا ابن أخي ابن شهاب، عن عمه قال: أخبرني عبيد الله بن عبد الله بن عتبة بن مسعود، أن عبد الله بن عباس كان يقول: سمعت الصعب بن جثامة بن قيس الليثي يقول: أهديت لرسول الله صلى الله عليه وسلم حمار وحش بالأبواء فرده علي، فلما عرف رسول الله صلى الله عليه وسلم في وجهي الكراهية قال: «إنه ليس بنا رد عليك ولكنا حرم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16674 - (@)(@@) قال عبد الله بن أحمد أخبرنا إسحاق بن منصور، قال: أخبرنا أبو اليمان الحكم بن نافع قال: أخبرنا شعيب، عن الزهري قال: أخبرني عبيد الله بن عبد الله بن عتبة بن مسعود، أن عبد الله بن عباس أخبره، أنه سمع الصعب بن جثامة الليثي، وكان من أصحاب النبي صلى الله عليه وسلم يخبر، أنه أهدى للنبي صلى الله عليه وسلم حمار وحش بالأبواء، أو بودان والنبي محرم، فرده النبي صلى الله عليه وسلم، قال الصعب: فلما عرف النبي صلى الله عليه وسلم في وجهي رده هديتي قال: «ليس بنا رد عليك ولكني حرم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16675 - (@)(@@) قال عبد الله بن أحمد: حدثنا محمد بن سليمان بن حبيب لوين، قال: حدثنا حماد بن زيد، عن صالح بن كيسان، عن عبيد الله بن عبد الله، عن ابن عباس، عن الصعب بن جثامة، أن النبي صلى الله عليه وسلم أقبل، حتى إذا كان بودان(@)(@@)(@@)(@@) | [ص: 230](@)(@@) أهدى له أعرابي لحم صيد فرده وقال: «إنا لا نأكل الصيد»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16676 - (@)(@@) قال عبد الله بن أحمد: حدثنا محمد بن سليمان، قال: حدثنا حماد بن زيد، عن عمرو بن دينار، عن ابن عباس، عن الصعب بن جثامة، أنه أتى النبي صلى الله عليه وسلم بحمار وحش فرده عليه وقال: «إنا حرم لا نأكل الصيد»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16677 - (@)(@@) قال عبد الله بن أحمد، حدثنا الحكم بن موسى، قال: حدثنا مسلم بن خالد، عن الزهري، عن عبيد الله بن عبد الله بن عتبة بن 
ms3109	 مسعود، عن ابن عباس، عن الصعب بن جثامة، أنه قال: يا رسول الله، نغشى الدار(@)(@@)(@@)(@@) | [ص: 231](@)(@@) أو الديار من المشركين ليلا معهم صبيانهم ونساؤهم، فنقتلهم؟ قال النبي صلى الله عليه وسلم: «هم منهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16678 - (@)(@@) حدثنا أبو القاسم بن أبي الزناد، عن الزنجي، قال: «رأيت الزهري، صابغا رأسه بسواد»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16679 - (@)(@@) قال عبد الله بن أحمد: حدثنا إسحاق بن منصور الكوسج، قال: أخبرنا ابن شميل يعني النضر، قال: أخبرنا محمد هو ابن عمرو، عن الزهري، عن عبيد الله بن عبد الله بن عتبة، عن ابن عباس، عن الصعب بن جثامة الليثي، قال: كان يحدث عن رسول الله صلى الله عليه وسلم أحاديث، قال: قال رسول الله صلى الله عليه وسلم: «لا حمى إلا لله ولرسوله»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16680 - (@)(@@) قال: وأهديت لرسول الله صلى الله عليه وسلم حمار وحش وهو محرم، فرده علي، فعرف ذلك في وجهي، فقال: «إنا لم نرده عليك إلا أنا حرم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16681 - (@)(@@) وسألته: عن أولاد المشركين، فقال: «اقتلهم معهم» ، قال: وقد نهى عنهم يوم خيبر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16682 - (@)(@@) قال عبد الله بن أحمد، حدثنا إسحاق بن منصور، قال: حدثنا عبد الله بن الزبير يعني الحميدي، قال: حدثنا سفيان، قال: حدثنا الزهري، قال: أخبرني عبيد الله بن عبد الله، أنه سمع ابن عباس، يقول: أخبرني الصعب بن جثامة الليثي، قال: سمعت رسول الله صلى الله عليه وسلم:(@)(@@)(@@)(@@) | [ص: 234](@)(@@) وسئل عن أهل الدار من المشركين، فيبيتون، فيصاب من نسائهم وذراريهم؟ فقال رسول الله صلى الله عليه وسلم: «هم منهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16683 - (@)(@@) وسمعت رسول الله صلى الله عليه وسلم يقول: «لا حمى إلا لله ولرسوله»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 16684 - (@)(@@) وأهديت لرسول الله صلى الله عليه وسلم لحم حمار وحش وهو بالأبواء أو بودان، فرده علي، فلما رأى الكراهية في وجهي، قال: «إنه ليس منا رد عليك، ولكنا حرم»(@)(@@)(@@)(@@) | 16685 - (@)(@@) قال سفيان: فحدثنا عمرو بن دينار، بحديث الصعب هذا، عن الزهري، قبل أن نلقاه، فقال فيه: «هم من آبائهم» . فلما قدم علينا الزهري، تفقدته، فلم يقل، وقال: «هم خير منهم»(@)(@@) PageV00P000(