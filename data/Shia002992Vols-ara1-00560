ms545	 1، ح 651، وفيه: سعد، عن أحمد بن الحسن عن عمرو بن سعيد فقط)، والتهذيب: ج 2، ح 771، (الاستبصار: ج 1، ح 1442، والتهذيب:(@)(@@) ج 4، ح 663، (الاستبصار: ج 1، ح 807، وفيه أحمد بن الحسن بن فضال)، والتهذيب: ج 5، ح 250.(@)(@@) وروى عنه علي بن خالد.(@)(@@) التهذيب: ج 2، ح 1081 (الاستبصار:(@)(@@) ج 1، ح 1057)، والتهذيب: ج 2، ح 109.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 3، ك 4، ب 21، ح 18، والتهذيب: ج 3، ح 1034.(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 1، ح 20 (الاستبصار: ج 1، ح 258)، والتهذيب: ج 1، ح 187 (الاستبصار: ج 1، ح 194)، والتهذيب:(@)(@@) ج 1، ح 339 (الاستبصار: ج 1، ح 374) التهذيب: ج 1، ح 802 (الاستبصار: ج 1، ح 675)، والتهذيب:(@)(@@) ج 2، ح 758 (الاستبصار: ج 1، ح 1437، وفيه عمرو بن سعيد فقط)، والتهذيب: ج 2، ح 911 (الاستبصار:(@)(@@) ج 1، ح 1526)، وفيه أحمد بن الحسن فقط)، والتهذيب: ج 3، ح 512 (الاستبصار: ج 1، ح 814).(@)(@@) * وروى عن يونس بن يعقوب، وروى عنه سعد.(@)(@@) التهذيب: ج 1، ح 966.(@)(@@) (أحمد بن الحسن الميثمي) * روى عن أبيه، وروى عنه علي بن الحسن الميثمي، أخوه، الفقيه: ج 4، ح 524. والتهذيب: ج 9، ح 1326 (الاستبصار: ج 4، ح 723).(@)(@@) * وروى عن أبان، وروى عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 7، ك 4، ب 7، ح 4. والتهذيب: PageV02P300(@)(@@) ج 10، ح 854 (الاستبصار: ج 4، ح 1064).(@)(@@) وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 4، ك 3، ب 101، ح 9، و ج 5، ك 2، ب 138، ح 10، وك 3، ب 31، ح 6، و ج 6، ك 5، ب 5، ح 5، و ج 7، ك 3، ب 15، ح 7، وك 4، ب 26، ح 12.(@)(@@) والتهذيب: ج 9، ح 222 و 1320، و ج 10 و 98.(@)(@@) وروى عنه الحسن بن محمد الكندي.(@)(@@) الكافي: ج 3، ك 3، ب 63، ح 7.(@)(@@) * وروى عن أبان بن عثمان، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 10، ح 631.(@)(@@) وروى عنه أحمد بن محمد، والحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 6، ك 8، ب 65، ح 10، و ج 7، ك 4، ب 5، ح 10.(@)(@@) وروى عنه أحمد بن محمد بن عيسى والحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 7، ك 5، ب 16، ح 1.(@)(@@) وروى عنه الحسن بن سماعة.(@)(@@) الكافي: ج 5، ك 3، ب 40، ح 3.(@)(@@) والتهذيب: ج 5، ح 51، و ج 
ms546	 9، ح 190 (الاستبصار: ج 4، ح 283).(@)(@@) وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 4، ك 3، ب 31، ح 6، و ج 6، ك 6، ب 6، ح 11، و ج 7، ك 3، ب 48، ح 18، وب 63، ح 18، وك 4، ب 53، ح 3.(@)(@@) والتهذيب: ج 9، ح 1010، و ج 10، ح 594 و 671 (الاستبصار: ج 4، ح 985).(@)(@@) وروى عنه الحسن بن محمد بن سماعة، وأحمد بن محمد.(@)(@@) الكافي: ج 6، ك 8، ب 65، ح 10، و ج 7، ك 4، ب 5، ج 10.(@)(@@) وروى عنه الحسن بن محمد بن سماعة، وأحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 7، ك 5، ب 16، ح 1.(@)(@@) وروى عنه الحسن بن محمد الأسدي.(@)(@@) الكافي: ج 2، ك 3، ب 8، ح 12، و وروى عنه الحسن بن محمد الكندي.(@)(@@) الكافي: ج 3، ك 3، ب 19، ح 15، و ب 27، ح 4، و ج 5، ك 2، ب 29، ح 3، و ح 7، ك 2، ب 14، ح 9. والروضة: ح 90، و 291، و 292، و 531، و 564.(@)(@@) والتهذيب: ج 1، ح 942، و ج 6، ح 493.(@)(@@) * وروى عن إبراهيم بن مهزم، وروى PageV02P301(@)(@@) عنه إبراهيم بن هاشم.(@)(@@) الكافي: ج 6، ك 6، ب 47، ح 15.(@)(@@) * وروى عن أحمد بن محمد بن عبد الله بن الزبير، وروى عنه موسى ابن عمر.(@)(@@) التهذيب: ج 1، ح 1303 (الاستبصار:(@)(@@) ج 1، ح 74).(@)(@@) * وروى عن الحسن بن أبي حمزة، وروى عنه يعقوب بن يزيد.(@)(@@) الفقيه: ج 4، ح 895.(@)(@@) * وروى عن الحسين بن المختار.(@)(@@) وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 6، ك 8، ب 16، ح 3.(@)(@@) * وروى عن سكين بن عمار، وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 6، ك 6، ب 76، ح 6.(@)(@@) * وروى عن علي بن يعقوب الهاشمي، وروى عنه أخوه علي بن الحسن الميثمي.(@)(@@) الكافي: ج 4، ك 3، ب 25، ح 4.(@)(@@) * وروى عن عنبسة بن عابد، وروى عنه الحسن بن محمد.(@)(@@) الكافي: ج 2، ك 4، ب 23، ح 15.(@)(@@) وروى عنه الحسن بن محمد الكندي.(@)(@@) الكافي: ج 2، ك 4، ب 23، ح 11.(@)(@@) * وروى عن فيض بن المختار، وروى عنه الحسين.(@)(@@) الكافي: ج 1، ك 4، ب 71، ح 9.(@)(@@) * وروى عن محمد بن إسحاق.(@)(@@) وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 6، ك 8، ب 37، ح 2.(@)(@@) * وروى عن معاوية بن وهب، وروى عنه الحسن بن محمد بن سماعة. 
ms547	(@)(@@) الكافي: ج 4، ك 3، ب 198، ح 12.(@)(@@) والتهذيب: ج 7، ح 80 (الاستبصار:(@)(@@) ج 3، ح 237).(@)(@@) * وروى عن يونس بن يعقوب، وروى عنه الحسن بن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 91، ح 12.(@)(@@) * وروى مرفوعا عن رسول الله صلى الله عليه وآله، وروى عنه يعقوب بن يزيد.(@)(@@) الكافي: ج 6، ك 6، ب 47، ح 8.(@)(@@) * وروى عن رجل من أصحابه عن أبي عبد الله عليه السلام، وروى عنه محمد بن الحسين، والحسن بن محمد الكندي، الروضة: ح 9. PageV02P302(@)(@@) (أحمد بن الحسين) * روى عن أبيه، وروى عنه ابن جمهور.(@)(@@) الكافي: ج 2، ك 1، ب 155، ح 2، كذا في النسخة القديمة وبعض النسخ الحديثة، وفي بعض النسخ الحديثة والمعربة، محمد ابن جمهور.(@)(@@) وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 5، ك 2، ب 31، ح 5.(@)(@@) والتهذيب: ج 6، ح 939.(@)(@@) * وروى عن الحسن بن علي بن يقطين، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 529.(@)(@@) * وروى عن علي بن الريان، وروى عنه علي بن محمد.(@)(@@) الكافي: ج 2، ك 2، ب 20، ح 18.(@)(@@) * وروى عن علي بن مهزيار.(@)(@@) التهذيب: ج 5، ح 1583.(@)(@@) * وروى عن عمر بن يزيد بياع السابري، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 7، ح 1051.(@)(@@) * وروى عن القاسم بن محمد، وروى عنه محمد بن علي بن محبوب.(@)(@@) التهذيب: ج 7، ح 1708 * وروى عن محمد بن إسماعيل، وروى عنه محمد بن أحمد.(@)(@@) الكافي: ج 6، ك 7، ب 30، ج 10.(@)(@@) * وروى عن محمد بن الطيب، وروى عنه محمد بن الحسن.(@)(@@) الكافي: ج 1، ك 4، ب 81، ح 9.(@)(@@) * وروى عن محمد بن عبد الله، وروى عنه جعفر بن محمد.(@)(@@) الكافي: ج 1، ك 4، ب 80، ح 31.(@)(@@) (أحمد بن حمزة) * روى عن أبي الحسن عليه السلام، وروى عنه عبد الله بن جعفر.(@)(@@) الكافي: ج 3، ك 5، ب 33، ح 7.(@)(@@) والتهذيب: ج 4، ح 144 (الاستبصار:(@)(@@) ج 2، ح 104).(@)(@@) وروى عنه محمد بن عيسى العبيدي، الفقيه: ج 4، ح 624.(@)(@@) * وروى عن أبي الحسن الثالث عليه السلام، وروى عنه عبد الله بن جعفر، وغيره.(@)(@@) التهذيب: ج 4، ح 122. PageV02P303(@)(@@) * وروى عن أبان، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 6، ح 610، و ج 9، ح 1093 (الاستبصار: ج 
ms548	 4، ح 595).(@)(@@) * وروى عن أبان بن عثمان، وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 1، ح 190.(@)(@@) * وروى عن الحسين بن المختار، وروى عنه محمد بن جمهور.(@)(@@) الكافي: ج 2، ك 1، ب 97، ح 20.(@)(@@) * وروى عن زكريا بن آدم، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 207.(@)(@@) * وروى عن محسن بن أحمد، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 104.(@)(@@) وروى عن محمد بن علي، وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 9، ح 303 (الاستبصار:(@)(@@) ج 4، ح 334).(@)(@@) * وروى مضمرة، وروى عنه علي ابن مهزيار.(@)(@@) الكافي: ج 7، ك 1، ب 37، ح 3. والفقيه:(@)(@@) ج 4، 611. والتهذيب: ج 9، ح 911.(@)(@@) (أحمد بن داود) * روى عن علي بن الحسن بن فضال، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6، ح 69 و 70.(@)(@@) * وروى عن علي بن الحسين أبي الحسن، وروى عنه ابنه محمد (أبو الحسن).(@)(@@) التهذيب: ج 1، ح 884، و 910 و 911 و 935 و 988 و 997.(@)(@@) * وروى عن محمد بن جعفر، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6، ح 164.(@)(@@) * وروى عن محمد بن جعفر المؤدب.(@)(@@) وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6 ح 147.(@)(@@) * وروى عن محمد بن السندي، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6، ح 155 و 169 و 175.(@)(@@) * وروى عن محمد بن عبد الله بن جعفر الحميري، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 6، ح 148 و 149.(@)(@@) * وروى عن محمد بن عبد الله الحميري، وروى عنه ابنه محمد.(@)(@@) التهذيب: ج 2، ح 898. PageV02P304(@)(@@) * وروى عن محمد بن قولويه. وروى عنه ابنه محمد، التهذيب: ج 6، ح 170 * وروى عن محمد بن يحيى، وروى عنه ابنه محمد (أبو الحسن).(@)(@@) التهذيب: ج 1، ح 810، 817.(@)(@@) (أحمد بن عائد) روى عن أبي الحسن عليه السلام، وروى عنه أحمد بن محمد بن أبي نصر.(@)(@@) التهذيب: ج 3، ح 131 (الاستبصار:(@)(@@) ج 1، ح 1664).(@)(@@) * وروى عن أبي الحسن السواق، وروى عنه الوشاء.(@)(@@) الكافي: ج 2، ك 2، ب 45، ح 1.(@)(@@) * وروى عن أبي خديجة، وروى عنه الحسن بن علي الخزاز.(@)(@@) الفقيه: ج 4، ح 785، والتهذيب: ج 9، ح 1329.(@)(@@) وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 
ms549	 6، ك 6، ب 23، ح 7.(@)(@@) وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 1، ك 2، ب 14، ح 2، و ج 3، ك 5، ب 31، ح 3، و ج 4، ك 1، ب 42، ح 6، وك 3، ب 3، ح 2، و ج 6، ك 8، ب 12، ح 2.(@)(@@) وروى عنه الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 47، ح 7، وب 116، ح 3، وب 127، ح 3، و ب 128، ح 2، و ج 2، ك 1، ب 69، ح 18، وب 121، ح 11، وب 139، ح 5، و ج 3، ك 2، ب 16، ح 1، و ج 5، ك 2، ب 49، ح 1، وب 159، ح 23، و ج 6، ك 1، ب 14، ح 2، وب 20، ح 2، و ك 6، ب 47، ح 3، وب 97، ح 11، وك 8، ب 35، ح 2، وك 9، ب 7، ح 4، و 5.(@)(@@) والتهذيب: ج 1، ح 844، و ج 6، ح 1197 (الاستبصار: ج 3، ح 231، وفيه الحسن بن علي الوشاء).(@)(@@) والتهذيب: ج 7، ج 1762 و 1775.(@)(@@) * وروى عن أبي سلمة.(@)(@@) الفقيه: ج 3، ح 32.(@)(@@) وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 5، ك 5، ب 96، ح 3.(@)(@@) * وروى عن أبيه، وروى عنه الحسن ابن علي.(@)(@@) الكافي: ج 1، ك 4، ب 7، ح 2.(@)(@@) * وروى عن ابن أذينة. وروى عنه الحسن بن علي الوشاء. PageV02P305(@)(@@) الكافي: ج 1، ك 4، ب 16، ح 1، وب 59، ح 1، وب 87، ح 1.(@)(@@) وروى عنه الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 19، ح 1، و ب 108، ح 21.(@)(@@) * وروى عن الحسين بن أبي العلاء، وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 4، ك 3، ب 96، ح 3، و ب 192، ح 1.(@)(@@) * وروى عن الحسين بن المختار، وروى عنه الحسن بن علي.(@)(@@) الكافي: ج 4، ك 3، ب 83، ح 13، والتهذيب: ج 5، ح 214.(@)(@@) وروى عنه الحسن بن علي الوشاء.(@)(@@) التهذيب: ج 1، ح 1395.(@)(@@) وروى عن سالم بن مكرم أبي خديجة، وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 1، ك 2، ب 3، ح 2.(@)(@@) وروى عنه الوشاء.(@)(@@) الكافي: ج 2، ك 1، ب 63، ح 2، وب 69، ح 17.(@)(@@) * وروى عن سالم بن مكرم أبي سلمة وهو أبو خديجة. وروى عنه الحسن بن علي الوشاء.(@)(@@) التهذيب: ج 4، ح 384 (الاستبصار:(@)(@@) ج 2، ح 189).(@)(@@) * وروى عن سالم بن مكرم الجمال أبى خديجة.(@)(@@) الفقيه: ج 3، ح 1.(@)(@@) * وروى عن عبد الله بن سنان، وروى عنه بعض الكوفيين.(@)(@@) الكافي: ج 4، ك 3، ب 42، ح 3.(@)(@@) * وروى عن عبيد الله الحلبي. وروى عنه عبيد 
ms550	 الله الدهقان.(@)(@@) الكافي: ج 2، ك 4، ب 3، ح 6.(@)(@@) * وروى عن عمر بن أذينة، وروى عنه الحسن بن علي الوشاء.(@)(@@) الكافي: ج 1، ك 4، ب 9، ح 2.(@)(@@) * وروى عن عمر بن حنظلة، وروى عنه الحسن بن علي الوشاء.(@)(@@) التهذيب: ج 2، ح 1253 (الاستبصار:(@)(@@) ج 1، ح 1528).(@)(@@) * وروى عن كليب الصيداوي، وروى عنه محمد بن عمر بن بزيع.(@)(@@) الكافي: ج 5، ك 2، ب 5، ح 11.(@)(@@) * وروى عن محمد بن أبي حمزة، وروى عنه محمد بن عيسى.(@)(@@) التهذيب: ج 6، ح 811.(@)(@@) * وروى عن محمد بن حكيم. وروى عنه الحسن بن علي بن فضال. PageV02P306(@)(@@) التهذيب: ج 8، ح 227.(@)(@@) (أحمد بن عبدون) روى عن أبي طالب الأنباري.(@)(@@) مشيخة التهذيب: في طريقه إلى حميد بن زياد وإلى الحسن بن محمد بن سماعة، وإلى أبي طالب الأنباري و (الاستبصار:(@)(@@) ج 1، ح 874).(@)(@@) وروى عن أحمد بن أبي رافع.(@)(@@) مشيخة التهذيب: في طريقه إلى محمد ابن يعقوب الكليني.(@)(@@) * وروى عن أحمد بن محمد بن الحسن.(@)(@@) مشيخة التهذيب: في طريقه إلى الحسن ابن محبوب، وإلى الحسين بن سعيد.(@)(@@) * وروى عن أحمد بن محمد بن الحسن بن الوليد.(@)(@@) مشيخة التهذيب: في طريقه إلى محمد بن الحسن الصفار.(@)(@@) * وروى عن الحسن بن حمزة العلوي.(@)(@@) مشيخة التهذيب: في طريقه إلى أحمد بن محمد بن عيسى، وإلى يونس بن عبد الرحمان.(@)(@@) * وروى عن الحسن بن حمزة العلوي أبي محمد.(@)(@@) مشيخة التهذيب: في طريقه إلى محمد بن أحمد بن يحيى الأشعري.(@)(@@) * وروى عن الحسن بن حمزة العلوي الحسيني الطبري.(@)(@@) مشيخة التهذيب: في طريقه إلى الفضل ابن شاذان، وإلى علي بن إبراهيم بن هاشم.(@)(@@) * وروى عن الحسين بن سفيان البزوفري أبي عبد الله.(@)(@@) مشيخة التهذيب: في طريقه إلى الحسن ابن محمد بن سماعة، وإلى الحسين بن سفيان البزوفري.(@)(@@) * وروى عن الحسين بن علي بن شيبان القزويني أبي عبد الله.(@)(@@) مشيخة التهذيب: في طريقه إلى علي بن الحاتم القزويني.(@)(@@) وروى عن عبد الملك بن عبد الله بن البزاز.(@)(@@) مشيخة التهذيب: في طريقه إلى محمد بن يعقوب الكليني.(@)(@@) * وروى عن علي بن محمد بن الزبير.(@)(@@) التهذيب: 
