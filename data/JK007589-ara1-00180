ms161	 أنت بمظلومة % في حكم أهل الشرق والغرب % 5(@)(@@) % بل إنما المظلوم عبد لكم % أصبح مقتولا بلا ذنب % 6(@)(@@) % غضبته جهرا على قلبه % لا تبت ما عشت من الغصب % 7(@)(@@) % ما بال من عاداك في راحة % وما لمن والاك في كرب % 8(@)(@@) % سالمت أهل الحرب طوبى لهم % لكن أهل السلم في حرب % 9(@)(@@) % أصبحت من ودي بلا كلفة % كالروح بين الجنب والجنب % 10(@)(@@) % أعانني الله على غلتي % % بشربة من ريقك العذب % PageV01P596 11(@)(@@) % يا حب مظلومة لا تنكشف % وازدد فمالي منك من حسب % % 12(@)(@@) % مظلوم قد أنهبت أرواحنا % % وكلنا راضون بالنهب % 13(@)(@@) % ضربك في صوتك لا خارج % عن حده والصوت في الضرب % 14(@)(@@) % كأنما وقعهما في الحشا % % وقع الحيا في الزمن الجدب % 15(@)(@@) % فقت المغنين كما فاقنا % % كواكب الدنيا بنو وهب % % 16(@)(@@) % حسنا وإحسانا قد استجمعا % % كلاهما ذو مطلب صعب % PageV01P597 البحر : - 1(@)(@@) % يا سمي الخليل إياك أدعو % % دعوة يممت سميعا مجيبا % % 2(@)(@@) % أمة من إماء طولك أجمع % % ت على نقلها إلي قريبا % % 3(@)(@@) % ما تزوجتها على غير تأمي % % لك فانظر أجائز أن أخيبا % % 4(@)(@@) % وقليل النوال في هذه الحا % % لة مما أراه شيئا عجيبا % % 5(@)(@@) % وحقيق لما تيسر أن يك % % ثر عند ابن حاجة ويطيبا % % 6(@)(@@) % فاغتنم خطة منحتك منها % % محملا هينا وحمدا رغيبا % % 7(@)(@@) % ومتى شئت أن تعاود عاود % ت وليس الغريب منك غريبا % % PageV01P598 البحر : - 1(@)(@@) % قدم الأمير أخو الأمي % % ير أبو الحسين المصعب % 2(@)(@@) % فالأهل والسهل المري % % ع لوجهه والمرحب % 3(@)(@@) % وعلى السعادة تبتنى % % حجراته وتطنب % 4(@)(@@) % ملك أغر محجب % معروفه لا يحجب % 5(@)(@@) % يغدو بعرض وافر % يحميه مال منهب % 6(@)(@@) % بدر كأن البدر مق % % رونا إليه كوكب % 7(@)(@@) % بحر كأن البحر مق % % رونا إليه مذنب % 8(@)(@@) % سيف له من كل نا % % حية ووجه مضرب % 9(@)(@@) % ليث له في كل جا % % رحة وعضو مخلب % 10(@)(@@) % خلعت عليه من المحا % % سن خلعة لا تسلب % PageV01P599 11(@)(@@) % عذبت خلائقه فكا % % د من العذوبة يشرب % 12(@)(@@) % وهبت له كف وهو % % ب كل ما لا 
ms162	 يوهب % 13(@)(@@) % عضد لسيدنا وغي % % ث للورى يتصبب % PageV01P600 البحر : - 1(@)(@@) % رأيتكم تستعدون السلاح ولا % % تقاتلون ولا يحمى لكم سلب % 2(@)(@@) % كالنخل يشرع شوكا لا يذود به % عن حمله كف جان فهو منتهب % PageV01P601 البحر : - 1(@)(@@) % رأيتكم تستعدون السلاح ولا % % تحمون في الروع من أعدائكم سلبا % % 2(@)(@@) % كالنخل يشرع شوكا لا يذود به % أيدي الجناة ولا يحميهم الرطبا % % PageV01P602 البحر : - 1(@)(@@) % النخل يشرع شوكا شائكا أشبا % % ولا يدافع كفا حاولت رطبا % % PageV01P603 البحر : - 1(@)(@@) % أشارت بالخضاب إلى الخضاب % كناظرة إلى شيء عجاب % 2(@)(@@) % وكن غرائرا إلا بشيب % يخيله المخيل بالشباب % PageV01P604 البحر : - 1(@)(@@) % صفا لك شرب العيش غير مثرب % ولا زلت تسمو بين بدر وكوكب % 2(@)(@@) % تدبر أمر الملك غير معنف % وتؤثر أمر الله غير مؤنب % 3(@)(@@) % وتجبي إلى السلطان أوفى خراجه % وتكسب حمد الناس من خير مكسب % 4(@)(@@) % أحين أسرت الدهر بعد عتوه % وفللت منه كل ناب ومخلب % 5(@)(@@) % فأصبحت مكفيا همومي مزايلا % غمومي موقى كل سوء ومعطب % 6(@)(@@) % ولم يبق لي إلا تمني بقائه % على الدهر ما أرست قواعد كبكب % 7(@)(@@) % تهضمني أنثى وتغصب جهرة % عقاري وفي هاتيك أعجب معجب % 8(@)(@@) % لقد أذكرتني لامرىء القيس قوله % % فإنك لم يغلبك مثل مغلب % 9(@)(@@) % وما قهر أنثى قرن جد ولم تكن % % لتقهر إلا قرن هزل وملعب % 10(@)(@@) % عرفنا لها غصب الغرير حقوقه % فما غضبها حق الحكيم المدرب % % PageV01P605 11(@)(@@) % لها كل سلطان على قلب أمرد % ولم تعط سلطانا على قلب أشيب % 12(@)(@@) % إليكم شكاتي آل وهب ولم تكن % % لتصمد إلا للوزير المهذب % 13(@)(@@) % لعمري لقد أعطيتم العدل حقه % فلا يتجاوزه ولا يتعتب % 14(@)(@@) % له أن يذب الليث عن ظلم ثعلب % وليس له إذلال ليث لثعلب % 15(@)(@@) % أجرني وزير الدين والملك إنني % % إليك بحقي هارب كل مهرب % 16(@)(@@) % توثب خصم واهن الركن والقوى % % على أيد الأركان لم يتوثب % 17(@)(@@) % هو النكر من وجهين غصب وبدعة % وفي النكر من وجهين موضع معتب % 18(@)(@@) % وكم غضبت للحق منك سجية % تؤدب بالتنكير من لم يؤدب % 19(@)(@@) % فلا تسلمني للأعادي وقولهم 
ms163	 % % ألا من رأى صقرا فريسة أرنب % 20(@)(@@) % أريد ارتجاع الدار لي كيف خيلت % بحكم ممر أو بلطف مسبب % PageV01P606 21(@)(@@) % وإن انتزاع الحق من كف غاصب % وقد نشبت أظفاره كل منشب % 22(@)(@@) % لخطة فصل من سديد قضاؤه % وخطة فضل من كريم المركب % 23(@)(@@) % وإن انتظام الفصل والفضل في يد % لشيء إلى السادات جد محبب % 24(@)(@@) % فرأيك في تيسير أمري بعزمة % كوقعة مسنون الغرارين مقضب % 25(@)(@@) % وتالله لا أرضى برد ظلامتي % % إلى أن أرى لي ألف عبد ومركب % 26(@)(@@) % وقد ساءني أني محب مقرب % وأن ليس لي إذن المحب المقرب % 27(@)(@@) % فمالي في قلب الوزير مرتبا % وفي داره حيران غير مرتب % 28(@)(@@) % ولا بد لي من رتبة ترغم العدا % % وتسهيل إذن بين أهل ومرحب % 29(@)(@@) % ولو لم أؤمل منك ذاك وضعفه % ذهبت من التأميل في غير مذهب % % 30(@)(@@) % فلا ينكرن المنكرون تسحبي % % فلولا الجناب السهل لم أتسحب % PageV01P607 31(@)(@@) % أتيتك لم أقصد إلى غير مقصد % بأمري ولم أرغب إلى غير مرغب % % 32(@)(@@) % ولي منك آمال عريض مرادها % % ووالله لا كانت مطامع أشعب % 33(@)(@@) % فإن أنت صدقت الرجاء ببغيتي % % فكم من رجاء فيك غير مكذب % 34(@)(@@) % وقد صدق الله الرجاء وإنما % % طلبت مزبد الخير من خير مطلب % 35(@)(@@) % وعش عيش مغشي الفناء محجب % جدا كفه في الناس غير محجب % PageV01P608 البحر : - 1(@)(@@) % وكم عائب قد عابني وهو صادق % وأدبر عني والذي فيه أعيب % 2(@)(@@) % رماني بسوء لست أعديه صاحبي % % ولا هو مما يستفاد ويكسب % 3(@)(@@) % وباء بسوء فيه يعديه غيره % ويجلبه والسوء يعدي ويجلب % 4(@)(@@) % وما ذاك إلا ثلبه الناس طائعا % وما برح الثلاب للناس تثلب % 5(@)(@@) % وكم بين ذي سوء تعداه سوءه % مريدا لما يأتيه يبغي ويشغب % 6(@)(@@) % وآخر لا يعدوه ما فيه طالب % زوال التي تنعى عليه وتندب % 7(@)(@@) % لشتان ما بين المعيبين ظالم % يحق عليه العتب والمتعتب % 8(@)(@@) % وآخر لم يظلم فكل مؤنب % تحداه بالتأنيب عمدا مؤنب % PageV01P609 البحر : - 1(@)(@@) % في جلنار وأختها دبسية % يا بن الوزير لعاتب متعتب % 2(@)(@@) % أحضرتموني جلنار وأحضرت 
ms164	 % دبسية الكبرى لغيري تجنب % 3(@)(@@) % فعتبت عتبا خلت فيه كفاية % ثم انصرفت إلى التي هي أصوب % 4(@)(@@) % فكظمت بالإغضاء كل مغصة % من ظلمكم ووهبت ما لا يوهب % 5(@)(@@) % وظننت توبتكم نصوحا بعدها % % ولقد يخالف من يظن ويحسب % 6(@)(@@) % فجرى علي بظلمكم من خرم % يوم كما علم الإله عصبصب % 7(@)(@@) % يوم يسمى حين يكنى غيره % % لا بل يكنى غيره ويلقب % 8(@)(@@) % وحدت شمول بالشمول لمعشر % % غيري وفيما دون ذلك مغضب % 9(@)(@@) % يا سادتي ما لي أذاد عن التي % % أبغي وأسعط بالتي أتجنب % 10(@)(@@) % أمشاهدي يوم الرفيهة تحتمى % % ومشاهدي يوم الكريهة تخطب % PageV01P610 11(@)(@@) % ذكرتموني بالتي أسديتم % مثلا لمثلي لا محالة يضرب % 12(@)(@@) % أإذا تكون كريهة أدعى لها % % وإذا يحاس الحيس يدعى جندب % PageV01P611 البحر : - 1(@)(@@) % صبا من شاب مفرقه تصابص وإن طلب الصبا والقلب صاب % أعاذل راضني لك شيب رأسي % % 2(@)(@@) % ولولا ذاك أعيا اقتضابي % % فلومي سامعا لك أو أفيقي % % 3(@)(@@) % فقد حان اتئابك واتئابي % % وقد أغناك شيبي عن ملامي % % 4(@)(@@) % كما أغنى العيون عن ارتقابي % % غضضت من الجفون فلست أرمي % % 5(@)(@@) % ولا أرمى بطرف مستراب % % وكيف تعرضي للصيد أنى % % 6(@)(@@) % وقد ريشت قداحي باللغاب % كفى بالشيب من ناه مطاع % 7(@)(@@) % على كره ومن داع مجاب % % حططت إلى النهى رحلي وكلت % 8(@)(@@) % مطية باطلي بعد الهباب % وقلت مسلما للشيب أهلا % 9(@)(@@) % بهادي المخطئين إلى الصواب % ألست مبشري في كل يوم % 10(@)(@@) % بوشك ترحلي إثر الشباب % لقد بشرتني بلحاق ماض % PageV01P612 11(@)(@@) % أحب إلي من برد الشراب % فلست مسميا بشراك نعيا % 12(@)(@@) % وإن أوعدت نفسي بالذهاب % % لك البشرى وما بشراك عندي % % 13(@)(@@) % سوى ترقيع وهيك بالخضاب % وأنت وإن فتكت بحب نفسيم % % 14(@)(@@) % وإن طلب الصبا والقلب صاب % أعاذل راضني لك شيب رأسي % % 15(@)(@@) % ولولا ذاك أعيا اقتضابي % % فلومي سامعا لك أو أفيقي % % 16(@)(@@) % فقد حان اتئابك واتئابي % % وقد أغناك شيبي عن ملامي % % 17(@)(@@) % كما أغنى العيون عن ارتقابي % % غضضت من الجفون فلست أرمي % % 18(@)(@@) % ولا أرمى بطرف مستراب % % وكيف تعرضي للصيد أنى % % 19(@)(@@) % وقد ريشت 
ms165	 قداحي باللغاب % كفى بالشيب من ناه مطاع % 20(@)(@@) % على كره ومن داع مجاب % % حططت إلى النهى رحلي وكلت % PageV01P613 21(@)(@@) % مطية باطلي بعد الهباب % وقلت مسلما للشيب أهلا % 22(@)(@@) % بهادي المخطئين إلى الصواب % ألست مبشري في كل يوم % 23(@)(@@) % بوشك ترحلي إثر الشباب % لقد بشرتني بلحاق ماض % 24(@)(@@) % أحب إلي من برد الشراب % فلست مسميا بشراك نعيا % 25(@)(@@) % وإن أوعدت نفسي بالذهاب % % لك البشرى وما بشراك عندي % % 26(@)(@@) % سوى ترقيع وهيك بالخضاب % وأنت وإن فتكت بحب نفسي % % 27(@)(@@) % وصاحب لذتي دون الصحاب % فقد أعتبتني وأمت حقدي % % 28(@)(@@) % بحثك خلفه عجلا ركابي % % إذا ألحقتني بشقيق عيشي % % 29(@)(@@) % فقد وفيتني فيه ثوابي % % وحسبي من ثوابي فيه أني % % 30(@)(@@) % وإياه نؤوب إلى مآب % لعمرك ما الحياة لكل حي % % PageV01P614 31(@)(@@) % إذا فقد الشباب سوى عذاب % فقل لبنات دهري فلتصبني % % 32(@)(@@) % إذا ولى بأسهمها الصياب % سقى عهد الشبيبة كل غيث % 33(@)(@@) % أغر مجلجل داني الرباب % ليالي لم أقل سقيا لعهد % 34(@)(@@) % ولم أرغب إلى سقيا سحاب % ولم أتنفس الصعداء لهفا % 35(@)(@@) % على عيش تداعى بانقضاب % أطالع ما أمامي بابتهاج % 36(@)(@@) % ولا أقفو المولي باكتئاب % % أجد الغانيات قلين وصلي % % 37(@)(@@) % وتطبيني إليهن الطوابي % % صددن بأعين عني نواب % % 38(@)(@@) % ولسن عن المقاتل بالنوابي % % ولم يصددن من خفر ودل % 39(@)(@@) % ولكن من بعاد واجتناب % وقلن كفاك بالشيب امتهانا % 40(@)(@@) % وبالصرم المعجل من عقاب % % وما أنصفن إذ يصرمن حبلي % % PageV01P615 41(@)(@@) % بذنب ليس مني باكتساب % وكن إذا اعتددن الشيب ذنبا % 42(@)(@@) % على رجل فليس بمستتاب % وما لك عند من يعتد ظلما % 43(@)(@@) % عليك بذنب غيرك من متاب % يذكرني الشباب صدى طويل % 44(@)(@@) % إلى برد الثنايا والرضاب % وشح الغانيات عليه إلا % 45(@)(@@) % عن ابن شبيبة جون الغراب % فإن سقينني صردن شربي % % 46(@)(@@) % ولم يك عن هوى بل عن خلاب % يذكرني الشباب هوان عتبي % % 47(@)(@@) % وصد الغانيات لدى عتابي % % ولو عتب الشباب ظهير عتبي % % 48(@)(@@) % رجعن إلي بالعتبى جوابي % % وأصغى المعرضات إلى عتاب % 49(@)(@@) % يحط به الوعول من الهضاب % وأقلق مضجع الحسناء سخطي 
ms166	 % % 50(@)(@@) % فأرضتني على رغم الغضاب % وبت وبين شخصينا عفاف % PageV01P616 51(@)(@@) % سخاب عناقها دون السخاب % ولو أني هناك أطيع جهلي % % 52(@)(@@) % لكنت حقابها دون الحقاب % يذكرني الشباب سهام حتف % 53(@)(@@) % يصبن مقاتلي دون الإهاب % % رمت قلبي بهن فأقصدته % % 54(@)(@@) % طلوع النبل من خلل النقاب % % فراحت وهي في بال رخي % 55(@)(@@) % ورحت بلوعة مثل الشهاب % وكل مبارز بالشيب قرنا % 56(@)(@@) % فمسبي لعمرك غير سابي % % ولو شهد الشباب إذا لراحتصبا من شاب مفرقه تصاب % 57(@)(@@) % وإن طلب الصبا والقلب صاب % أعاذل راضني لك شيب رأسي % % 58(@)(@@) % ولولا ذاك أعيا اقتضابي % % فلومي سامعا لك أو أفيقي % % 59(@)(@@) % فقد حان اتئابك واتئابي % % وقد أغناك شيبي عن ملامي % % 60(@)(@@) % كما أغنى العيون عن ارتقابي % % غضضت من الجفون فلست أرمي % % PageV01P617 61(@)(@@) % ولا أرمى بطرف مستراب % % وكيف تعرضي للصيد أنى % % 62(@)(@@) % وقد ريشت قداحي باللغاب % كفى بالشيب من ناه مطاع % 63(@)(@@) % على كره ومن داع مجاب % % حططت إلى النهى رحلي وكلت % 64(@)(@@) % مطية باطلي بعد الهباب % وقلت مسلما للشيب أهلا % 65(@)(@@) % بهادي المخطئين إلى الصواب % ألست مبشري في كل يوم % 66(@)(@@) % بوشك ترحلي إثر الشباب % لقد بشرتني بلحاق ماض % 67(@)(@@) % أحب إلي من برد الشراب % فلست مسميا بشراك نعيا % 68(@)(@@) % وإن أوعدت نفسي بالذهاب % % لك البشرى وما بشراك عندي % % 69(@)(@@) % سوى ترقيع وهيك بالخضاب % وأنت وإن فتكت بحب نفسي % % 70(@)(@@) % وصاحب لذتي دون الصحاب % فقد أعتبتني وأمت حقدي % % PageV01P618 71(@)(@@) % بحثك خلفه عجلا ركابي % % إذا ألحقتني بشقيق عيشي % % 72(@)(@@) % فقد وفيتني فيه ثوابي % % وحسبي من ثوابي فيه أني % % 73(@)(@@) % وإياه نؤوب إلى مآب % لعمرك ما الحياة لكل حي % % 74(@)(@@) % إذا فقد الشباب سوى عذاب % فقل لبنات دهري فلتصبني % % 75(@)(@@) % إذا ولى بأسهمها الصياب % سقى عهد الشبيبة كل غيث % 76(@)(@@) % أغر مجلجل داني الرباب % ليالي لم أقل سقيا لعهد % 77(@)(@@) % ولم أرغب إلى سقيا سحاب % ولم أتنفس الصعداء لهفا % 78(@)(@@) % على عيش تداعى بانقضاب % أطالع ما أمامي بابتهاج % 79(@)(@@) % ولا أقفو المولي باكتئاب % % أجد الغانيات قلين وصلي % % 80(@)(@@) % وتطبيني إليهن 
ms167	 الطوابي % % صددن بأعين عني نواب % % PageV01P619 81(@)(@@) % ولسن عن المقاتل بالنوابي % % ولم يصددن من خفر ودل % 82(@)(@@) % ولكن من بعاد واجتناب % وقلن كفاك بالشيب امتهانا % 83(@)(@@) % وبالصرم المعجل من عقاب % % وما أنصفن إذ يصرمن حبلي % % 84(@)(@@) % بذنب ليس مني باكتساب % وكن إذا اعتددن الشيب ذنبا % 85(@)(@@) % على رجل فليس بمستتاب % وما لك عند من يعتد ظلما % 86(@)(@@) % عليك بذنب غيرك من متاب % يذكرني الشباب صدى طويل % 87(@)(@@) % إلى برد الثنايا والرضاب % وشح الغانيات عليه إلا % 88(@)(@@) % عن ابن شبيبة جون الغراب % فإن سقينني صردن شربي % % 89(@)(@@) % ولم يك عن هوى بل عن خلاب % يذكرني الشباب هوان عتبي % % 90(@)(@@) % وصد الغانيات لدى عتابي % % ولو عتب الشباب ظهير عتبي % % PageV01P620 91(@)(@@) % رجعن إلي بالعتبى جوابي % % وأصغى المعرضات إلى عتاب % 92(@)(@@) % يحط به الوعول من الهضاب % وأقلق مضجع الحسناء سخطي % % 93(@)(@@) % فأرضتني على رغم الغضاب % وبت وبين شخصينا عفاف % 94(@)(@@) % سخاب عناقها دون السخاب % ولو أني هناك أطيع جهلي % % 95(@)(@@) % لكنت حقابها دون الحقاب % يذكرني الشباب سهام حتف % 96(@)(@@) % يصبن مقاتلي دون الإهاب % % رمت قلبي بهن فأقصدته % % 97(@)(@@) % طلوع النبل من خلل النقاب % % فراحت وهي في بال رخي % 98(@)(@@) % ورحت بلوعة مثل الشهاب % وكل مبارز بالشيب قرنا % 99(@)(@@) % فمسبي لعمرك غير سابي % % ولو شهد الشباب إذا لراحت % 100(@)(@@) % وإن بها وعيشك ضعف ما فيا غوثا هناك بقيد ثأري % % إذا ما الثأر فات يد الطلاب % PageV01P621 101(@)(@@) % فكم ثأر تلاقت لي يداه % ولو من بين أطراف الحرابصبا من شاب مفرقه تصاب % 102(@)(@@) % وإن طلب الصبا والقلب صاب % أعاذل راضني لك شيب رأسي % % 103(@)(@@) % ولولا ذاك أعيا اقتضابي % % فلومي سامعا لك أو أفيقي % % 104(@)(@@) % فقد حان اتئابك واتئابي % % وقد أغناك شيبي عن ملامي % % 105(@)(@@) % كما أغنى العيون عن ارتقابي % % غضضت من الجفون فلست أرمي % % 106(@)(@@) % ولا أرمى بطرف مستراب % % وكيف تعرضي للصيد أنى % % 107(@)(@@) % وقد ريشت قداحي باللغاب % كفى بالشيب من ناه مطاع % 108(@)(@@) % على كره ومن داع مجاب % % حططت إلى النهى رحلي وكلت % 109(@)(@@) % مطية باطلي بعد 
