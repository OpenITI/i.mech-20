ms161	 حلت في ديار بني % % عمران ليست لها أخت ولا مثل % 3(@)(@@) % ألوى بتيجانهم يوم أتيح له % نحس وأثقب فيه ناره زحل % 4(@)(@@) % ألوى به وهو ملو بالقنا لتوا % % ليها استواء وفي أعناقها ميل % 5(@)(@@) % كان الذي ليس في معجومه خور % للعاجمين ولا في هديه خلل % 6(@)(@@) % كان الذي يتقى ريب الزمان به % % إذا الزمان بدت أنيابه العصل % 7(@)(@@) % أحلنا الدهر في بطحاء مسهلة % لما تقوضت عنها أيها الجبل % 8(@)(@@) % ماكان أحسن حالات الأشاعر يا % % يحيى بن عمران لو أنسي لك الأجل % 9(@)(@@) % أي امرئ منك أثرى بين أعظمه % ثرى المقطم أو محلوده الرمل % 10(@)(@@) % لايتبع المن ماجادت يداه به % ولا تحكم في معروفه العلل % PageV01P541 11(@)(@@) % ماقال كان إذا ما القوم أكذب ما % % أطال من قولهم تقصير ما فعلوا % % 12(@)(@@) % يا موت حسبك إذ أقصدت مهجته % % أولا فدونك لا حسب ولا بجل % 13(@)(@@) % ماحالنا يا أبا العباس بعدك هل % تنمى الفروع ويودي أصلها الأصل % 14(@)(@@) % يا موت لو في وغى عاينته خلدت % عليه عوض دموع منك تنهمل % 15(@)(@@) % المشعل الحربض نارا وهي خامدة % والمستبيح حماها وهي تشتعل % 16(@)(@@) % بكل يوم وغى تصدى الكمأة به % % على يديه وتروى البيض والأسل % 17(@)(@@) % يغشى الوغى بالقنا والخيل عابسة % والخيل لاعاجز فيها ولاوكل % 18(@)(@@) % والكاشف الكرب اللاتي يحف بها % % إظلام أمر على البلدان ينسدل % 19(@)(@@) % بمشهد ليس يثنيه به زلل % ومنطق ليس يعروه به خطل % 20(@)(@@) % مستجمع لا يحل الريث عقدته % فيه ولا يمتطي إبلاغه العجل % PageV01P542 21(@)(@@) % بحيث لا يضع الآراء موضعها % % 22(@)(@@) % إذا الرجال رأوه وهو يفعل ما % % أعياهم فعله قالوا كذا الرجل % 23(@)(@@) % إما يدل منك بالموت العدى فبما % % دارت عليهم بلا موت لك الدول % 24(@)(@@) % أيام سيفك مشهور وبحرك مس % % جور وقرنك مقصور له الطول % 25(@)(@@) % إذ لابس الذلة المقطوع ذو رحم % قطعته وإذا الموصول من تصل % 26(@)(@@) % جرعك الدهر كاس الصبر في لجج % للموت يغرق في آذيها الجبل % 27(@)(@@) % موتا وقتلا كأن الدهر يظمأ ما % % عاشوا وينقع ما ماتوا وماقتلوا % % 28 
ms162	(@)(@@) % ياشاغل الدهر عنا ما لصولته % % مذ صال فيك الردى إلا بنا شغل % 29(@)(@@) % يا حلية المجد إن المجد عن عفر % بدا وحليته من بعدك العطل % 30(@)(@@) % يا موئلا كان مأوى الآمات به % % إذا ادلهمت بمكروهاتها العضل % PageV01P543 31(@)(@@) % فأي معتمد يزكو به عمل % وأي منتظر يحيا به أمل % 32(@)(@@) % لكن حسين وأمثال الحسين إاذ % % ما الناس يوم حفاظ حصلوا قلل % 33(@)(@@) % تنبي المواقف عنه أنه سند % ويخبر الروع عنه أنه بطل % 34(@)(@@) % يعطي فيجزل أو يدعى فينزل أو % يؤتى لمحمل أعباء فيحتمل % 35(@)(@@) % تظنه شيخه لولا شبيبته % % والزرع ينبت فذا ثم يكتهل % 36(@)(@@) % أضحى لنا بدلا منه تنوء به % والشبل من ليثه إما مضى بدل % PageV01P544 البحر : طويل 1(@)(@@) % أبادرها بالشكر قبل وصالها % % و إن هجرت يوما طلبت لهاعذرا % % 2(@)(@@) % و أجعلها في الغدر عندي وفية % و إن زعمت أني لها مضمر غدرا % % 3(@)(@@) % أتاها بطيب أهلها فتضاحكت % وقالت أيبغي العطر ويحكم العطرا ؟ % 4(@)(@@) % أحاديثها در ودر كلامها % % ولم أر درا قبله ينظم الدرا % % PageV01P545 البحر : سريع 1(@)(@@) % جرت له أسماء حبل الشموس % والوصل والهجر نعيم وبوس % 2(@)(@@) % ولم تجد بالري ريا ولم % تلمس فؤادا يتمته لميس % 3(@)(@@) % كواكب الدنيا السعود التي % % بدلها دلت عليك النحوس % 4(@)(@@) % أبا علي أنت وادي الندى ال % % أحوى ومغنى المكرمات الأنيس % 5(@)(@@) % البيت حيث النجم والكف حي % % ث الغيث في الأزمة والدار خيس % 6(@)(@@) % يا بن رجاء أفدت نية % ركوبها مني خيم وسوس % 7(@)(@@) % فامدد عناني بوأى ضلعه % % تثبت والعذرة منه تنوس % 8(@)(@@) % أقاتل الهم بإيجافه % فإن حرب الهم حرب ضروس % 9(@)(@@) % إذا المذاكي خطبت نقعه % فحظها منه اللفاء الخسيس % 10(@)(@@) % موضح ليس بذي رجلة % أشأم والأرجل منها بسوس % PageV01P546 11(@)(@@) % وكل لون فليكن ما خلا ال % % أشهب فالشهبة لون لبيس % 12(@)(@@) % ومجفر لم يصطلم كشحه % فالضمر المفرط فيها رسيس % 13(@)(@@) % إن زار ميدانا سابقا % أو ناديا قام إليه الجلوس % 14(@)(@@) % ترى رزان القوم قد أسمحت % أعينهم في حسنه وهي شوس % 15(@)(@@) % كأنما لاح لهم بارق % في المحل 
ms163	 أو زفت إليهم عروس % 16(@)(@@) % سام إذا اسعرضته زانه % أعلى رطيب وقرار يبيس % 17(@)(@@) % فإن خدا يرتجل المشي فال % موكب في إحسانه والخميس % 18(@)(@@) % كأنما خامره أولق % أو غازلت هامته الخندريس % 19(@)(@@) % عوذه الحاسد بخلا به % ورفرفت خوفا عليه النفوس % 20(@)(@@) % ومثله ذو العن السبط قد % % أمطيته والكفل المرمريس % PageV01P547 21(@)(@@) % غادرته وهو على سؤؤد % وقف وفي سبل المعالي حبيس % 22(@)(@@) % وحادث أخرق داويته % % رداعه ذا هيئة دردبيس % 23(@)(@@) % أخمدته والدهر من خطبه % كأنما أضرم فيه الوطيس % 24(@)(@@) % حتى انثنى العسر إلى يسره % وانحت عن خديه ذاك العبوس % 25(@)(@@) % لا طالبو جدواك أكدوا ولا % % عافيك منهم لليالي فريس % 26(@)(@@) % فاشدد على الحمد يدا إنه % إذا استحس العلق علق نفيس % 27(@)(@@) % واغد على موشيه إنه % برد لعمري تصطفيه النفوس % PageV01P548 البحر : طويل 1(@)(@@) % لنمنا وصرف الدهر ليس بنائم % خزمنا له قسرا بغير خزائم % 2(@)(@@) % ألست ترى ساعاته واقتسامها % % نفوس بني الدنيا اقتسام الغنائم ؟ % 3(@)(@@) % ليال إذا أنحت عليك عيونها % % أرتك اعتبارا في عيون الأراقم % 4(@)(@@) % شرقنا بذم الدهر يا سلم إنه % يسيء فما يألو وليس بظالم % 5(@)(@@) % إذا فقد المفقود من آل مالك % تقطع قلبي رحمة للمكارم % 6(@)(@@) % خليلي من بعد الأسى والجوى قفا % % ولاتقفا فيض الدموع السواجم % 7(@)(@@) % ألما فهذا مصرع البأس والندى % % وحسب البكا إن قلت مصرع هاشم % 8(@)(@@) % ألم تريا الأيام كيف فجعننا % % به ثم قد شاركننا في المآتم ؟ ! % 9(@)(@@) % خطون إليه من نداه وبأسه % خلائق أوقى من ستور التمائم % 10(@)(@@) % خلائق كالزغف المضاعف لم تكن % لتنفذها يوما شباه اللوائم % PageV01P549 11(@)(@@) % ولو عاش فينا بعض عيش فعاله % لأخلق أعمار النسور القشاعم % 12(@)(@@) % رأى الدهر منه عثرة ماأقالها % % وهل حازم يأوي لعثرة حازم % 13(@)(@@) % لئن كان سيف الموت أسود صارما % لقد فل منه حد أبيض صارم % 14(@)(@@) % أصاب امرءا كانت كرائم ماله % عليه إذا ما سيل غير كرائم % 15(@)(@@) % جرى المجد مجرى النوم منه فلم يكن % بغير طعان أو سماح بحالم % 16(@)(@@) % تبين في إشراقه وهو نائم % بأن الندى في روحه 
ms164	 غير نائم % 17(@)(@@) % فإن توه في الدنيا دعائم عمره % فما جوده فيها بواهي الدعائم % 18(@)(@@) % إذا المرء لم تهدم علاه حياته % فليس لها الموت الجليل بهادم % 19(@)(@@) % أهاشم صار الدمع ضربة لازم % وماكان لولا أنت ضربة لازم % 20(@)(@@) % أهاشم للحيين فيك مصائب % دلوه جمعت كانت لبعض المواسم % PageV01P550 21(@)(@@) % مساع تشظت في المواسم كلها % % ولو جمعت كانت كبعض المواسم % 22(@)(@@) % ليومك عند الأزد يوم تخزعت % خزاعة منها في بطون التهائم % 23(@)(@@) % وما يوم زرت اللحد يومك وحده % % علينا ولكن يوم عمر و وحاتم % 24(@)(@@) % فكم ملحد في يوم ذلك غانم % وكم منبر في يوم ذلك غارم ! % 25(@)(@@) % لئن عم ثكلا كل شيء مصابه % لقد خص أطراف السيوف الصوارم % 26(@)(@@) % تسلبت الدنيا عليه فأصبحت % خلائقها مثل الفجاج القواتم % 27(@)(@@) % وما نكبة فاتت به بعظيمة % ولكنها من أمهات العظائم % 28(@)(@@) % بني مالك قد نبهت خامل الثرى % % قبور لكم مستشرفات المعالم % 29(@)(@@) % رواكد قيس الكف من متناول % وفيها على لاترتقى بالسلالم % 30(@)(@@) % قضيتم حقوق الأرض منكم بأعظم % عظام قضت دهرا حقوق المقاوم % PageV01P551 31(@)(@@) % خدعت لئن صدقت أن غيابة % تكشف إلا عن وجوه الهيائم % 32(@)(@@) % رأيتهم ريش الجناح إذا ذوت % قوادم منها أيدت بقوادم % 33(@)(@@) % إذا اختل ثغر المجد أضحى جلادهم % ونائلهم من حوله كالعواصم % 34(@)(@@) % فلا تطلبوا أسيافهم في جفونها % % فقد أسكنت بين الطلى والجماجم % 35(@)(@@) % إذا ما رماح القوم في الروع أكرمت % مشاربها عاشوا كرام المطاعم % PageV01P552 البحر : بسيط تام 1(@)(@@) % قد صنف الحسن في خديك جوهره % وفيه قد خلف التفاح أحمره % 2(@)(@@) % و كل حسن فمن عينيك أوله % مذ خط هاروت في عينيك عسكره % 3(@)(@@) % و كان خدك دهرا مشرقا يققا % فمن تمكن فيه للحظ عصفره % PageV01P553 البحر : بسيط تام 1(@)(@@) % أقرم بكر تباهي أيها الحفض % ونجمها أيهذا الهالك الحرض % 2(@)(@@) % تنحي على صخرة صماء تحسبها % % عضوا خلت به تبري وتنتحض % 3(@)(@@) % في شامتين هو الشري الجني لهم % والصاب والشرق المسموم والحرض % 4(@)(@@) % مخامري حسد ما ضر غيرهم % كأنما هو في أبدانهم مرض % 5 
ms165	(@)(@@) % لا يهنء العصبة المحمر أعينها % % بثغر أران هذا الحادث العرض % 6(@)(@@) % أضحى الشجا مستطيلا في حلوقهم % من بعد ما جاذبوه وهو معترض % 7(@)(@@) % سهم الخليفة في الهيجا إذ سعرت % بالبيض والتفت الأحقاب والغرض % 8(@)(@@) % بذلك السهم ذي النصلين قد حفزا % % بريش نسرين يرمى ذلك الغرض % 9(@)(@@) % ظل من الله أضحى أمس منبسطا % به على الثغر فهو اليوم منقبض % 10(@)(@@) % لخالد عوض في كل ناحية % منه ، وليس له من خالد عوض % PageV01P554 11(@)(@@) % لم تنتقض عروة منه ولا سبب % لكن أمر بني الآمال ينتقض % PageV01P555 البحر : بسيط تام 1(@)(@@) % محمد بن حميد أخلقت رممه % أريق ماء المعالي مذ أريق دمه % 2(@)(@@) % تنبهت لبني نبهان يوم ثوى % % يد الزمان فعاثت فيهم وفمه % 3(@)(@@) % رأيته بنجاد السيف محتبيا % كالبدر حين جلت عن وجهه ظلمه % 4(@)(@@) % في روضة قد علا حافاتها زهر % علمت عند انتباهي أنها نعمه % 5(@)(@@) % فقلت والدمع من حزن ومن فرح % يجري ومد فلأ الخدين منسجمه % 6(@)(@@) % ألم تمت ياشقيق النفس مذ زمن ؟ % فقال لي : لم يمت من لم يمت كرمه % PageV01P556 البحر : خفيف تام 1(@)(@@) % وثناياك إنها إغريض % ولأل توم وبرق وميض % 2(@)(@@) % وأقاح منور في بطاح % هزه في الصباح روض أريض % 3(@)(@@) % وإرتكاض الكرى بعينيك في النو % م فنونا وما لعيني غموض % 4(@)(@@) % لتكاءدتني غمار من الأحد % % اث لم أدر أيهن أخوض % 5(@)(@@) % أتأرتني الأيام بالنظر الشز % ر وكانت وطرفها لي غضيض % 6(@)(@@) % كيف يضحي براس علياء مضح % وجناح السمو منه مهيض % 7(@)(@@) % همة تنطح النجوم وجد % آلف للحضيض فهو حضيض % 8(@)(@@) % كم فتى ذل للزمان وقد ال % % قى مقاليده إليه القبيض % 9(@)(@@) % لوذعي يهلل المشرفي ال % % عضب عنه والزاعبي النحيض % 10(@)(@@) % وبساط كأنما الآل فيه % وعليه سحل الملاء الرخيض % PageV01P557 11(@)(@@) % يصبح الداعري ذو الميعة المر % جم فيه كأنه مأبوض % 12(@)(@@) % قد فضضنا من بيده خاتم الخو % ف وما كل خاتم مفضوض % 13(@)(@@) % بالمهارى يجلن فيه وقد جا % % لت على مسنماتهن الغروض % 14(@)(@@) % جازعات سود المروراة ته % % ديها وجوه لمكرماتك بيض % 15 
ms166	(@)(@@) % سعم حث ركبهن أمان % فيك تترى حث القداح المفيض % 16(@)(@@) % فاشمعلوا يلجلجون دؤوبا % مضغا للكلال فيها أنيض % 17(@)(@@) % لن يهز التصريح للمجد والس % ؤدد من لم يهزه التعريض % 18(@)(@@) % كل يوم يقضيه نوع % وعروض يتلوه فيك عروض % 19(@)(@@) % وقواف قد ضج منها لما استع % % مل فيها المرفوع والمخفوض % 20(@)(@@) % المديح الجزيل والشكر والفك % % ر ومر العتاب والتحريض % PageV01P558 21(@)(@@) % وحياة القريض إحياؤك الجو % % د فإن مات الجود مات القريض % 22(@)(@@) % كن طويل الندى عريضا فقد ساد % % ثنائي فيك الطويل العريض % 23(@)(@@) % إنما صادت البحور بحورا % إنها كلما استفيضت تفيض % 24(@)(@@) % يامحب الإحسان في زمن أص % % بح فيه الإحسان وهو بغيض % 25(@)(@@) % قل لعا لابن عشرة ما له من % % ها بشيء سوى نداك نهوض % 26(@)(@@) % لاتكن لي ولن تكون كقوم % عودهم حين يعجمون رفيض % 27(@)(@@) % عندهم محضر من البشر مبسو % % ط لعاف ونائل مقبوض % 28(@)(@@) % وأقل الأشياء محصول نفع % صحة القول والفعال مريض % PageV01P559 البحر : خفيف تام 1(@)(@@) % رحم الله جعفرا فلقد كا % % ن أبيا شهما وكان رحيما % % 2(@)(@@) % مثل الموت بين عينيه والذلم % % فكلا رآه خطبا عظيما % % 3(@)(@@) % ثم سارت به الحمية قدما % فأمات العدى ومات كريما % % PageV01P560 البحر : كامل تام 1(@)(@@) % هذا هواك وهذه آثاره % أما الؤاد فما يقر قراره % 2(@)(@@) % يصل الأنين بزفرة موصولة % بغليل شوق ليس تطفا ناره % 3(@)(@@) % و دعا الدموع فأقبلت منهلة % شوقا وذاك قصارهاوقصاره % 4(@)(@@) % من طرف ممتنع الرقاد متيم % أرق سواء ليله ونهاره % PageV01P561 البحر : طويل 1(@)(@@) % مهاة النقا لولا الشوى والمآبض % وإن محض الإعراض لي منك ماحض % 2(@)(@@) % رعت طرفها في هامة قد تنكرت % وصوح منها نبتها وهو بارض % 3(@)(@@) % فصدت وعاضته أسى وصبابة % وما عائض منها وإن جل عائض % 4(@)(@@) % فما صقل السيف اليماني لمشهد % كما صقلت بالأمس تلك العوارض % 5(@)(@@) % ولا كشف الليل النهار وقد بدا % % كما كشفت تلك الشؤون الغوامض % 6(@)(@@) % ولاعملت خرقاء أوهت شعيبها % % كما عملت تلك الدموع الفوائض % 7(@)(@@) % وأخرى لحتني حين لم أمنع النوى % % قيادي ولم ينقض زماعي ناقض % 8 
ms167	(@)(@@) % أرادت بأن يحوي الرغيبات وادع % % وهل يفرس الليث الطلى وهو رابض % 9(@)(@@) % هي الحرة الوجناء وابن ملمة % وجأش على ما يحدث الدهر خافض % 10(@)(@@) % إذا ما رأته العيس ظلت كأنما % % عليها من الورد اليمامي نافض % PageV01P562 11(@)(@@) % إليك سرى بالمدح قوم كأنهم % على المييس حيات اللصاب النضانض % 12(@)(@@) % معيدين ورد الحوض قد هدم البلى % % نصائبه وانمح منه المراكض % 13(@)(@@) % نشيم بروقا من نداك كأنها % % وقد لاح أولاها عروق نوابض % 14(@)(@@) % فما زلن يستشرين حتى كأنما % % على أفق الدنيا سيوف روامض % 15(@)(@@) % فلم تنصرم إلا وفي كل وهدة % ونشز لها واد من العرف فائض % 16(@)(@@) % أخا الحرب كم ألحقتها وهي حائل % وأخرتها عن وقتها وهي ماخض % 17(@)(@@) % إذا عرض رعديد تدنس في الوغى % % فسيفك في الهيجا لعرضك راحض % 18(@)(@@) % إذا كانت الأنفاس جمرا لدى الوغى % % وضاقت ثياب القوم وهي فضافض % 19(@)(@@) % بحيث القلوب الساكنات خوافق % وماء الوجوه الأريحيات غائض % 20(@)(@@) % فأنت الذي تستيقظ الحرب باسمه % إذا جاض عن حد الأسنة جائض % PageV01P563 21(@)(@@) % إذا قبض النقع العيون سما له % همام على جمر الحفيظة قابض % 22(@)(@@) % وقد علم الحزم الذي أنت ربه % بأن لا يعي العظم الذي أنت هائض % 23(@)(@@) % وقد علم القرن المساميك أنه % سيغرق في البحر الذي أنت خائض % 24(@)(@@) % كما علم المستشعرون بأنهم % بطاء عن الشعر الذي أنا قارض % 25(@)(@@) % كأني دينار ينادي ألا فتى % % يبارز إذ ناديت من ذا يعارض % 26(@)(@@) % فلا تنكروا ذل القوافي فقد رأى % % محرمها أني لها الدهر رائض % PageV01P564 البحر : بسيط تام 1(@)(@@) % اليوم أدرج زيد الخيل في كفن % وانحل معقود دمع الأعين الهتن % 2(@)(@@) % بني حميد لو ان الدهر متزع % لصد من ذكركم عن جانب خشن % 3(@)(@@) % إن ينتخل حدثان الدهر أنفسكم % ويسلم الناس بين الحوض والعطن % 4(@)(@@) % فالماء ليس عجيبا أن أعذبه % % يفنى ويمتد عمر الآجن الأسن % 5(@)(@@) % رزء على طيىء ألقى كلاكله % % لابل على أدد لابل على اليمن % 6(@)(@@) % لم يثكلوا ليث حرب مثل قحطبة % من بعد قحطبة في سالف الزمن % 7(@)(@@) % إلا تكن 
ms168	 صدرت عن منظر حسن % حرب ، فقد صدرت عن مسمع حسن % 8(@)(@@) % نعم الفتى غير نكس في الجلاد ولا % % لدن الفؤاد لدى وقع القنا اللدن % 9(@)(@@) % حن إلى الموت حتى ظن جاهله % % بأنه حن مشتاقا إلى وطن % 10(@)(@@) % ولى الحماة وأضحى عند سورته % مع الحمية كالمشدود في قرن % PageV01P565 11(@)(@@) % رأى المنايا حبالات النفوس فلم % يسكن سوى الميتة العليا إلى سكن % 12(@)(@@) % لو لم يمت بين أطراف الرماح إذا % لمات إذ لم يمت من شدة الحزن % PageV01P566 البحر : خفيف تام 1(@)(@@) % إن يوم الفراق يوم عبوس % أي سيل تسيل منه النفوس % 2(@)(@@) % لم أزل ابغض الخميس ولم % % ر لماذا حتى دهاني الخميس % 3(@)(@@) % بأبي من إذا رآها أبوها % % شغفا قال ليت أنا مجوس % PageV01P567 البحر : كامل تام 1(@)(@@) % أهلوك أضحوا شاخصا ومقوضا % % ومزمما يصف النوى ومغرضا % % 2(@)(@@) % إن يدج ليلك أنهم أموا اللوى % % فلقد أضاء وهم على ذات الأضا % % 3(@)(@@) % بدلت من برق الثغور وبردها % % برقا إذا ظعن الأحبة أومضا % % 4(@)(@@) % لو كان أبغض قلبه فيما مضى % % أحد لكنت إذا لقلبي مبغضا % % 5(@)(@@) % قل الغضى لاشك في أوطانه % % مما حشدت إليه من جمر الغضى % % 6(@)(@@) % ما أنصف الزمن الذي بعث الهوى % % فقضى عليك بلوعة ثم انقضى % % 7(@)(@@) % عندي من الأيام ما لو أنه % أضحى بشارب مرقد ما غمضا % % 8(@)(@@) % لا تطلبن الرزق بعد شماسه % فتروضه سبعا إذا ما غيضا % % 9(@)(@@) % ما عوض الصبر امرؤ إلا رأى % % ما فاته دون الذي قد عوضا % % 10(@)(@@) % يا أحمد ابن أبي داود دعوة % ذلت بشكرك لي وكانت ريضا % % PageV01P568 11(@)(@@) % لما انتضيتك للخطوب كفيتها % % والسيف لا يكفيك حتى ينتضى % % 12(@)(@@) % ما زلت أرقب تحت أفياء المنى % % يوما بوجه مثل وجهك أبيضا % % 13(@)(@@) % كم محضر لم مرتضى لم تدخر % % محموده عند الإمام المرتضى % % 14(@)(@@) % لولاك عز لقاؤه فيما بقي % % أضعاف ما قد عزني فيما مضى % % 15(@)(@@) % قد كان صوح نبت كل قرارة % حتى تروح في نداك فروضا % % 16(@)(@@) % أوردتني العد الخسيف وقد أرى % % أتبرض الثمد البكي تبرضا % % 17(@)(@@) % أما القريض 
ms169	 فقد جذبت بضبعه % % جذب الرشاء مصرحا ومعرضا % % 18(@)(@@) % أحببته إذ كان فيك محببا % وازددت حبا حين صار مبغضا % % 19(@)(@@) % أحييته وظننت أني لاأرى % % شيئا يعود إلى الحياة وقد قضى % % 20(@)(@@) % وحملت عبء المجد معتمدا على % % قدم وقاك أمينها أن تدحضا % % PageV01P569 21(@)(@@) % ثقلا لو أن متالعا حمل اسمه % لا جسمه لم يستطع أن ينهضا % % 22(@)(@@) % قد كانت الحال اشتكت فأسوتها % % أسوا أبى إمراره أن ينقضا % % 23(@)(@@) % ما عذرها ألا تفيق ولم تزل % لمريضها بالمكرمات ممرضا % % 24(@)(@@) % كن كيف شئت فإن فيك خلائفا % أمسى إليهن الرجاء مفوضا % % 25(@)(@@) % فالمجد لا يرضى بأن ترضى بأن % يرضى امرؤ يرجوك إلا بالرضا % % PageV01P570 البحر : طويل 1(@)(@@) % ألم ترني خليت نفسي وشانها % % ولم أحفل الدنيا ولا حدثانها ؟ % 2(@)(@@) % لقد خوفتني النائبات صروفها % % ولو أمنتني ما قبلت أمانها % % 3(@)(@@) % وكيف على نار الليالي معرسي % % إذا كان شيب العارضين دخانها ! % 4(@)(@@) % أصبت بخود سوف أغبر بعدها % % حليف أسى أبكى زمانا زمانها % % 5(@)(@@) % عنان من اللذات قد كان في يدي % % فلما مضى الإلف استردت عنانها % % 6(@)(@@) % منحت الدمى هجري فلا محسناتها % % أود ولا يهوى فؤادي حسانها % % 7(@)(@@) % يقولون هل يبكي الفتى لخريدة % متى ما أراد اعتاض عشرا مكانها % % 8(@)(@@) % وهل يستعيض المرء من خمس كفه % % ولو صاغ من حر اللجين بنانها % % PageV01P571 البحر : بسيط تام 1(@)(@@) % دعني وشرب الهوى ياشارب الكاس % فإنني للذي حسيته حاسي % % 2(@)(@@) % لا يوحشنك ما استعجبت من سقمي % % فان منزله في أحسن الناس % 3(@)(@@) % من خلوتي فيه مبدا كل جائحة % % وفكرتي منه مبدا كل وسواس % 4(@)(@@) % من قطع ألفاظه توصيل مهلكتي % % ووصل ألفاظهش تقطيع أنفاسي % % 5(@)(@@) % رزقت رقة قلب منه نغصها % % منغص من رقيب قلبه قاسي % % 6(@)(@@) % متى أعيش بتأميل الرجاء اذا % % م كان قطع رجائي من يدي ياسي % % PageV01P572 البحر : خفيف تام 1(@)(@@) % بدلت عبرة من الإيماض % يوم شدوا الرحال بالإغراض % 2(@)(@@) % أعرضت برهة فلما أحست % بالنوى أعرضت عن الإعراض % 3(@)(@@) % غصبتها نحيبها عزمات % غصبتني تصبري واغتماضي % % 4(@)(@@) % نظرت فالتفت منها إلى أح % % لى سواد رأيته في 
ms170	 بياض % 5(@)(@@) % يوم ولت مريضة اللحظ والجف % % ن وليست دموعها بمراض % 6(@)(@@) % إن خيرا مما رأيت من الصف % ح عن النائبات والإغماض % 7(@)(@@) % غربة تقتدي بغربة قيس ب % ن زهير والحارث بن مضاض % 8(@)(@@) % غرضا نكبتين مافتلا رأ % يا فخافا عليه نكث انتقاض % 9(@)(@@) % من أبن البيوت أصبح في ثو % ب من العيش ليس بالفضفاض % 10(@)(@@) % والفتى من تعرقته الليالي % % والفيافي كالحية النضناض % PageV01P573 11(@)(@@) % صلتان أعداؤه حيث حلوا % % في حديث من عزمه مستفاض % 12(@)(@@) % كل يوم له بصرف الليالي % % فتكة مثل فتكة البراض % 13(@)(@@) % وإلى أحمد نقضت عرا العج % % ز بوخذ السواهم الأنقاض % 14(@)(@@) % فكأني لما حططت إليه الر % حل أطلقت حاجتي من إباض % 15(@)(@@) % حل في البيت من إياد إذا عد % ت وفي المنصب الطوال الععراض % 16(@)(@@) % معشر أصبحوا حصون المعالي % % ودروع الأحساب والأعراض % 17(@)(@@) % بك عاد النضال دون المساعي % % واهتدين النبال للأغراض % 18(@)(@@) % وغدت أسهم القبائل أيقا % % ظا وكانت قد نومت في الوفاض % 19(@)(@@) % عادت المكرمات بزلا وكانت % أدخلت بينها بنات مخاض % 20(@)(@@) % كم ظلام عن العلى قد تجلى % % بك والمكرمات عنك رواض % PageV01P574 21(@)(@@) % أي ذي سودد يناويك فيه % ظالما والندى بذلك قاض % 22(@)(@@) % كم معان وشيتها فيك قد أم % ست وأصبحت ضرائرا للرياض % 23(@)(@@) % بقواف هي البواقي على الده % % ر ولكن أثمانهن مواض % 24(@)(@@) % ما أبالي بعد انبساطك بالمع % % روف من كان منهم ذا انقباض % 25(@)(@@) % أنت لي معقل من الدهر إن را % % ب بريب أو حادث مضاض % 26(@)(@@) % ماشددت الأوذام في عقد الأك % راب حتى وردت ملء الحياض % 27(@)(@@) % أنت أمضى من أن تصد عن الرم % % ي إذا ما جددت في الإنباض % 28(@)(@@) % وإذا المجد كان عوني على المر % ء تقاضيته بترك التقاضي % % PageV01P575 البحر : كامل تام 1(@)(@@) % كف الندى أضحت بغير بنانكف الندى أضحت بغير بنان % وقناته أمست بغير سنان % 2(@)(@@) % جبل الجبال غدت عليه ملمة % تركته وهو مهدم الأركان % 3(@)(@@) % أنعى عمير بن الوليد لغارة % بكر من الغارات أو لعوان % 4(@)(@@) % % قولي وأنعى فارس الفرسان 
ms171	 % 5(@)(@@) % عثر الزمان ونائبات صروفه % بمقيلنا عثرات كل زمان % 6(@)(@@) % لم يترك الحدثان يوم سطا به % أحدا نصول به على الحدثان % 7(@)(@@) % قد كنت حشو الدرع ثم أراك قد % أصبحت حشو اللحد والأكفان % 8(@)(@@) % شغلت قلوب الناس ثم عيونهم % % مذ مت بالخفقان والهملان % 9(@)(@@) % واستعذبوا الأحزان حتى إنهم % % يتحاسدون مضاضة الأحزان % 10(@)(@@) % مايرعوي أحد إلى أحد ولا % % يشتاق إنسان إلى إنسان % PageV01P576 11(@)(@@) % أأصاب منك الموت فرصة ساعة % فعدا عليك وأنتما أخوان ؟ % 12(@)(@@) % فمن الذي أبقى ليوم تكرم % ومن الذي أبقى ليوم طعان ؟ % 13(@)(@@) % من يدفع الكرب العظام إذا التفت % في مأزق حلقات كل بطان ؟ % 14(@)(@@) % حمال مالو حل أصغره على % % ثهلان لانهدت ذرى ثهلان % PageV01P577 البحر : سريع 1(@)(@@) % ياشدنا صيغ من الشمس % ته بالملاحات على الإنس % 2(@)(@@) % في كل يوم انت في صورة % غير التي كنت بها أمس % 3(@)(@@) % تزداد طيبا كل يوم كما % % يزداد غصن البان في الغرس % 4(@)(@@) % والله لولا الله لا غيره % وخوفي النار على نفسي % % 5(@)(@@) % صليت خمسا لك من هيبة % وازددت ثنتين على الخمس ! % PageV01P578 البحر : منسرح 1(@)(@@) % أقلق جفن العينين عن غمضه % وشد هذا الحشا على مضضه % 2(@)(@@) % شجا بما عن للأمير أبي العبا % % س أمسى نصبا لمعترضه % 3(@)(@@) % لباسط الباع رحبه واجب الحق % م على العالمين مفترضه % 4(@)(@@) % من الألى نستجير من شرق الده % % ر بهم إن ألم أو جرضه % 5(@)(@@) % صاغهم ذو الجلال من جوهر المج % د وصاغ الأنام من عرضه % % 6(@)(@@) % إذا رموا عروة إليك فقد % أتيت حوض الأنام من فرضه % 7(@)(@@) % سهم من الملك لا يضيعه % باديه حتى يهتز في غرضه % 8(@)(@@) % صحته صحة الرجاء لنا % % في حين ملتاثه ومنتقضه % 9(@)(@@) % وإن يجد علة نعم بها % % حتى ترانا نعاد من مرضه % PageV01P579 البحر : بسيط تام 1(@)(@@) % إني أظن البلى لو كان يفهمه % % صد البلى عن بقايا وجهه الحسن % 2(@)(@@) % يا مؤتة لم تدع ظرفا ولا أدبا % إلا حكمت به للحد والكفن % 3(@)(@@) % لله ألحافظه والموت يكسرها % % كأن أجفانه سكرى من الوسن % 4(@)(@@) % يرد 
ms172	 أنفاسه كرها وتعطفها % % يد المنية عطف الريح للغصن % 5(@)(@@) % يا هول ما أبصرت عيني وما سمعت % أذني فلا بقيت عيني ولا أذني % % 6(@)(@@) % لم يبق من بدني جزء علمت به % % إلا وقد حله جزء من الحزن % 7(@)(@@) % كان اللحاق به أولى وأحسن بي % % من أن أعيش سقيم الروح والبدن % PageV01P580 البحر : منسرح 1(@)(@@) % يامن تردى بحلة الشمس % ومن رماني بأسهم خمس % 2(@)(@@) % بالطرف والثغر والسوالف والن % % حر وشيئ يطيبث في اللمس % 3(@)(@@) % هاأناذابالذنوب معترف % فهب لذلي جنايتي أمس % 4(@)(@@) % وجد لمستمطر الجفون دما % شغلته عن صلاته الخمس % 5(@)(@@) % سألتث عن وصفيك الصفات فما % % نطقن إلا بألسن خرس % PageV01P581 البحر : طويل 1(@)(@@) % أما إنه لولا الخليط المودع % وربع عفا منه مصيف ومربع % 2(@)(@@) % لردت على أعقابها أريحية % من الشوق واديها من الهم مترع % 3(@)(@@) % لحقنا بأخراهم وقد حوم الهوى % % قلوبا عهدنا طيرها وهي وقع % 4(@)(@@) % فردت علينا الشمس والليل راغم % بشمس لهم من جانب الخدر تطلع % 5(@)(@@) % نضا ضوء ها صبغ الدجنة فانطوى % % لبهجتها ثوب السماء المجزع % 6(@)(@@) % فوالله ما أدري أأحلام نائم % ألمت بنا أم كان في الركب يوشع % 7(@)(@@) % وعهدي بها تحيي الهوى وتميته % % وتشعب أعشار الفؤاد وتصدع % 8(@)(@@) % وأقرع بالعتبى حميا عتابها % % وقد تستقيد الراح حين تشعشع % 9(@)(@@) % وتقفو إلى الجدوى بجدوى وإنما % % يروقك بيت الشعر حين يصرع % 10(@)(@@) % ألم تر آرام الظباء كأنما % % رأت بي سيد الرمل والصبح أدرع % PageV01P582 11(@)(@@) % لئن جزع الوحشي منها لرؤيتي % % لإنسيها من شيب رأسي أجزع % 12(@)(@@) % غذا الهم مختطا بفودي خطة % طريق الردى منها إلى النفس مهيع % 13(@)(@@) % هو الزور يجفى ، والمعاشر يجتوى % % وذو الإلف يقلى ، والجديد يرقع % 14(@)(@@) % له منظر في العين أبيض ناصع % ولكنه في القلب أسود أسفع % 15(@)(@@) % ونحن نزجيه على الكره والرضا % % وأنف الفتى من وجهه وهو أجدع % 16(@)(@@) % لقد ساسنا هذا الزمان سياسة % سدى لم يسسها قط عبد مجدع % 17(@)(@@) % تروح علينا كل يوم وتغتدي % % خطوب كأن الدهر منهن يصرع % 18(@)(@@) % حلت نظف منها لنكس وذو النهى % % يداف له 
ms173	 سم من العيش منقعث % % 19(@)(@@) % فإن نك أهملنا فأضعف بسعينا % % وإن نك أجبرنا ففيم نتعتع % % 20(@)(@@) % لقد آسف الأعداء مجد ابن يوسف % وذو النقص في الدنيا بذي الفضل مولع % PageV01P583 21(@)(@@) % أخذت بحبل منه لما لويته % % عل مرر الأيام ظلت تقطع % 22(@)(@@) % هو السيل إن واجهته انقدت طوعه % وتقتاده من جانبيه فيتبع % 23(@)(@@) % ولم أر نفعا عند من ليس ضائرا % ولم أر ضرا عند من ليس ينفع % 24(@)(@@) % يقول فيسمع ويمشي فيسرع % ويضرب في ذات الإله فيوجع % 25(@)(@@) % ممر له من نفسه بعض نفسه % وسائرها للحمد والأجر أجمع % 26(@)(@@) % رأى البخل من كل فظيعا فعافه % على أنه منه أمر وأفظع % 27(@)(@@) % وكل كسوف في الداراري شنعة % ولكنه في الشمس والبدر أشنع % 28(@)(@@) % معاد الورى بعد الممات وسيبه % معاد لنا قبل الممات ومرجع % 29(@)(@@) % له تالد قد وقؤ الجود هامه % فقرت وكانت لاتزال تفزع % 30(@)(@@) % إذا كانت النعمى سلوبا من امرئ % غدت من خليجي كفه ، وهي متبع % PageV01P584 31(@)(@@) % وإن عثرت سود الليالي وبيضها % % بوحدته ألفيتها وهي مجمع % 32(@)(@@) % وإن خفرت أموال قوم أكفهم % من النيل والجدوى فكفاه مقطع % 33(@)(@@) % ويوم يظل العز يحفظ وسطه % بسمر العوالي والنفوس تضيع % 34(@)(@@) % مصيف من الهيجا ومن حاجم الوغى % % ولكنه من وابل الدم مربع % 35(@)(@@) % عبوس كسا أبطاله كل قونس % يرى المرء منه وهو أفرع أنزع % 36(@)(@@) % وأسمر محمر العوالي يومه % سنان بحبات القلوب ممتع % 37(@)(@@) % من اللاء يشربن النجيع من الكلى % % غريضا ، ويروى غيرهن فينقع % 38(@)(@@) % شققت إلى جباره حومة الوغى % % وقنعته بالسيف وهو مقنع % 39(@)(@@) % لدى سندبايا والهضاب وأرشق % وموقان والسمر اللذان تزعزع % 40(@)(@@) % وأبرشتويم والكذاج وملتقى % % سنابكها والخيل تردي وتمزع % PageV01P585 41(@)(@@) % غدت ظلعا حسرى وغادر جدها % % جدود أناس وهي حسرى وظلع % 42(@)(@@) % هو الصنع إن يعجل فنفع وإن يرث % فللريث في بعض المواطن أسرع % 43(@)(@@) % أظلتك آمالي وفي البطش قوم % وفي السهم تسديد وفي القوس منزع % 44(@)(@@) % وإن الغنى لي إن لحظت مطالبي % % من الشعر ، إلا في مديحك ، أطوع % 45(@)(@@) % وإنك إن أهزلت 
ms174	 في المحل لم تضع % ولم ترع إن أهزلت والروض ممرع % 46(@)(@@) % رأيت رجائي فيك وحدك همة % ولكنه في سائر الناس مطمع % 47(@)(@@) % وكم عاثر منا أخذت بضبعه % فأضحى له في قلة المجد مطلع % 48(@)(@@) % فصار اسمه في النائبات مدافعا % وكان اسمه من قبل وهو مدفع % 49(@)(@@) % وما السيف إلا زبرة لو تركته % على الخلقة الأولى لما كان يقطع % 50(@)(@@) % فدونكها لولا ليان نسيبها % % لظلت صلاب الصخر منها تصدع % PageV01P586 51(@)(@@) % لها أخوات قبلها قد سمعتها % % وإن لم تزع بي مدة فستسمع % PageV01P587 البحر : كامل تام 1(@)(@@) % نفسي فداء محمد ووقاؤه % وكذبت ما في العالمين فداؤه % 2(@)(@@) % أزعمت أن يحكي طرفه % % والقد غصن جال فيه ماؤه ؟ % 3(@)(@@) % أسكت فأين ضياؤه وبهاؤه % وكماله وذكاؤه وحياؤه % 4(@)(@@) % لاتغن أسماء الملاحة والحجى % % فيمن سواه فإنها أسماؤه % 5(@)(@@) % عري المحب من الضنا فقميصه % % طول التأوه والسقام رداؤه % 6(@)(@@) % لو قيل سل تعط المنى كان المنى % % أن لو رأى مولاه كيف بكاؤه % 7(@)(@@) % أحبابه لم تفعلون بقلبه % ماليس يفعله به أعداؤه % 8(@)(@@) % مطر من العبرات خدي أرضه % % حتى الصباح ومقلتاي سماؤه % PageV01P588 البحر : كامل تام 1(@)(@@) % يالابسا ثوب الملاحة أبله % فلأنت أولى لابسيه بلبسه % 2(@)(@@) % لم يعطك الله الذي أعطاكه % % حتى استخف ببدره وبشمسه % 3(@)(@@) % رشأ إذا ماكاد يطلق نفسه % % في فتكه أمر الحياء بحبسه % 4(@)(@@) % و أنا الذي اعطيته محض الهوى % % وصميمه وأخذت عذرة أنسه % 5(@)(@@) % فلئن جنيت ثماره وغرسته % ما كنت أول من جنى من غرسه % 6(@)(@@) % مولاك يا مولاي صاحبث لوعة % في يومه وصبابة في أمسه % 7(@)(@@) % دنف يجود بنفسه حتى لقد % أمسى ضعيفا أن يجود بنفسه ! % PageV01P589 البحر : وافر تام 1(@)(@@) % خذي عبرات عينك عن زماعي % % وصوني ما أزلت من القناع % 2(@)(@@) % أقلي قد أضاق بكاك ذرعي % % وما ضاقت بنازلة ذراعي % % 3(@)(@@) % أآلفة النحيب كم افتراق % أظل فكان داعية اجتماع ! % 4(@)(@@) % وليست فرحة الأوبات إلا % % لموقوف على ترح الوداع % 5(@)(@@) % توجع أن رأت جسمي نحيفا % كأن المجد يدرك بالصراع % 6(@)(@@) % فتى النكبات من يأوي إذا ما 
ms175	 % % قطفن به إلى خلق وساع % 7(@)(@@) % يثير عجاجة في كل ثغر % يهيم به عدي بن الرقاع % 8(@)(@@) % أبن مع السباع القفر حتى % % لخالته السباع من السباع % 9(@)(@@) % فلب الحزم إن حاولت يوما % بأن تسطيع غير المستطاع % 10(@)(@@) % فلم ترحل كناجية المهاري % % ولم تركب همومك كالزماع % PageV01P590 11(@)(@@) % بمهدي بن أصرم عاد عودي % % إلى إيراقه وامتد باعي % % 12(@)(@@) % أطال يدي على الأيام حتى % % جزيت صروفها صاعا بصاع % 13(@)(@@) % إذا أكدت سوام الشعر أضحت % عطاياه وهن لها مراعي % % 14(@)(@@) % رياض لا يشذ العرف عنها % % ولا تخلو من الهمم الرتاع % 15(@)(@@) % سعى فاستنزل الشرف اقتدارا % ولولا السعي لم تكن المساعي % % 16(@)(@@) % أمهديا لحييت على نوال % لقد حكت الملام لغير واع % 17(@)(@@) % أردت بحيث لاتعصى المعالي % % بأن يعصى الندى وبأن تطاعي % % 18(@)(@@) % عميد الغوث إن نوب الليالي % % سطت وقريعها عند القراع % 19(@)(@@) % كثيرا ما تشوقه العوالي % % وهمته إلى العلق المتاع % 20(@)(@@) % كأن به غداة الروع وردا % وقد وصفت له نفس الشجاع % PageV01P591 21(@)(@@) % لحسن الموت في كرم وتقوى % % أحب إليه من حسن الدفاع % 22(@)(@@) % ونغمة معتف يرجوه أحلى % % على أذنيه من نغم السماع % 23(@)(@@) % جعلت الجود لألاء المساعي % % وهل شمس تكون بلا شعاع % 24(@)(@@) % وما في الأرض أعصى لامتناع % % يسوق الذم من جود مطاع % 25(@)(@@) % ولم يحفظ مضاع المجد شيء % من الأشياء كالمال المضاع % 26(@)(@@) % رعاك الله للمعروف إني % % أراك لسرح مالك غير راعي % % 27(@)(@@) % فما في الأرض من شرف يفاع % سبقت به ولا خلق يفاع % 28(@)(@@) % لعزمك مثل عزم السيل شدت % قواه بالمذانب والتلاع % 29(@)(@@) % ورأيك مثل رأي السيف صحت % مشورة حده عند المصاع % 30(@)(@@) % فلو صورت نفسك لم تزدها % % على ما فيك من كرم الطباع % PageV01P592 البحر : كامل تام 1(@)(@@) % بيت قلبي من هواك على الطوى % % ورحلت من بلد الصبابة والجوى % % 2(@)(@@) % لو لم يجرني الهجر منك بلطفه % والله لاستأمنت فيك إلى النوى % % 3(@)(@@) % لم ترع لي حرقا بقلبي قد مضت % لو لم يذدها الدمع عنه لاشتوى % % 4(@)(@@) % هيهات كنت من الحداثة والصبا % % في غفلة 
ms176	 إن الهوى ينسي الهوى % % PageV01P593 البحر : طويل 1(@)(@@) % بنفسي حبيب سوف يثكلني نفسي % % ويجعل جسمي تحفة اللحد والرمس % 2(@)(@@) % جحدت الهوى ان كنت مذ جعل الهوى % % محاسنه شمسي نظرت إلى الشمس % 3(@)(@@) % لقد ضاقت الدنيا علي بأسرها % % بهجرانه حتى كأني في حبس % % 4(@)(@@) % أسكن قلبا هائما فيه مأتم % من الشوق إلا أن عيني في عرس % PageV01P594 البحر : خفيف تام 1(@)(@@) % قد كسانا من كسوة الصيف خرق % مكتس من مكارم ومساع % 2(@)(@@) % حلة سابرية ورداء % كسحا القيض أو رداء الشجاع % 3(@)(@@) % كالسراب الرقراق في النعت إلا % % أنه ليس مثله في الخداع % 4(@)(@@) % قصبيا تسترجف الريح متنيه % ه بأمر من الهبوب مطاع % 5(@)(@@) % رجفانا كأنه الدهر منه % كبد الصب أو حشا المرتاع % 6(@)(@@) % لازما ما يليه تحسبه جز % ءا من المتنتين والأضلاع % 7(@)(@@) % يطرد اليوم ذا الهجير ولو شب % به في حره بيوم الوداع % 8(@)(@@) % خلعة من أغر أروع رحب الص % % صدر رحب الفؤاد رحب الذراع % 9(@)(@@) % سوف أكسوك ما يعفي عليها % % من ثناء كالبرد برد الصناع % 10(@)(@@) % حسن هاتيك في العيون وهذا % % حسنه في القلوب والأسماع % PageV01P595 البحر : خفيف تام 1(@)(@@) % بت سلم الجوى وحرب النعاس % عرضة للزفير والأنفاس % 2(@)(@@) % دائبا ليلتي أكف بكفي % % كبدا حزها كحز المواسي % % 3(@)(@@) % فإذا حلت الهموم تأوهت % و ناديت يا أبا العباس % 4(@)(@@) % حزني منك لا أصابك معشار % الذي من هواك مر برأسي % % PageV01P596 البحر : منسرح 1(@)(@@) % أبو علي وسمي منتجعه % فاحلل بأعلى واديه أو جرعه % 2(@)(@@) % واغد قريب الخيال والحس من % منظره تارة ومستمعه % 3(@)(@@) % وحاسد لا يفيق قلت له % % من صاب قول يدمي ومن سلعه % 4(@)(@@) % لا تجزرن عرضك الأساود واس % % تخف بأنف باد ، لمجتدعه % 5(@)(@@) % لا يأمنن أخدعاك بادرة % من قدعه إن أمنت من قدعه % 6(@)(@@) % إياك والغيل أن تطيف به % إني أخشى عليك من سبعه % 7(@)(@@) % ترى الهمام المحجوب حاشية % له وتلقى المتبوع من تبعه % 8(@)(@@) % ينزل في الكاهل المنيف من الأم % ر وهم تحت ذاك من زمعه % 9(@)(@@) % يا رب يوم تلوح غرته % ساطع 
ms177	 صبح المعروف منصدعه % 10(@)(@@) % قد ذاب لي في يديك ذوب السنا % % م الجعد حكمت الرضف في قمعه % PageV01P597 11(@)(@@) % ولم تغير وجهي عن الصبغة ال % % أولى بمسفوع اللون ملتمعه % 12(@)(@@) % لا بل هنيء الندى هنيء السدى % % لم يتلوث راجيك في طمعه % 13(@)(@@) % وقد أتاني الرسول بالملبس الفخ % % م لصيف امرىء ومرتبعه % 14(@)(@@) % من شنع الخلعة الغريبة إن % م المجد مجد الرياش في شنعه % 15(@)(@@) % لو أنها جللت أويسا لقد % أسرعت الكبرياء في ورعه % 16(@)(@@) % رائق خز يلتذ ملمسه % سكب يدين الصبا لمدرعه % 17(@)(@@) % وسر وشي كأن شعري أح % % يانا نسيب العيون من بدعه % 18(@)(@@) % كأن غض الحوذان والدم من % صائكه جاسدا ومن دفعه % 19(@)(@@) % والنور نور العرار أجري في % % تسهيمه المجتلى على ينعه % 20(@)(@@) % لا في ريام ولا قراه ولا % % زبيده مثله ولا رمعه % PageV01P598 21(@)(@@) % لايتخطاه الطرف من أحد % ينصف إلا صلى على صنعه % 22(@)(@@) % تركتني سامي الجفون على % % أزلم دهر بحسنها جذعه % 23(@)(@@) % معاود الكبر والسمو على % % أعياده باذخا على جمعه % 24(@)(@@) % وغابط في نداك قلت له % ورب قول قومت من ضلعه : % 25(@)(@@) % نعت سيفا أغفلت قائمه % % وظبي قف سهوت عن تلعه % 26(@)(@@) % أنت أخونا وسيد ملك % نخلع ما نستزيد من خلعه % 27(@)(@@) % فالبس به مثلها لمثلك من % فضفاض ثوب القريض متسعه % 28(@)(@@) % صعب القوافي إلا لفارسه % % أبي نسج العروض ممتنعه % 29(@)(@@) % ساحر نظم سحر البياض من ال % % ألوان سائبه خبه خدعه % 30(@)(@@) % كسوة ود أصبحت دون الورى % % نجعته لا نقول من نجعه % PageV01P599 31(@)(@@) % سبقت حتى اقتطعت قبلهم % ما شئت من تمه ومن قطعه % 32(@)(@@) % والشعر فرج ليست خصيصته % طول الليالي إلا لمفترعه % PageV01P600 البحر : منسرح 1(@)(@@) % نأت به الدارعن أقاربه % فألقي الحبل فوق غاربه % 2(@)(@@) % عاشت لمحبوبه ممانعة % مات عليها رجاء طالبه % 3(@)(@@) % اتفق الحسن فيه واختلفت % مذاهب العقل في مذاهبه % 4(@)(@@) % لم أر بدرا سواك معتدلا % به افتقار إلى كواكبه % 5(@)(@@) % ويلم صب رمى صعوبتكم % % الأولى فلانت بلين جانبه % 6(@)(@@) % ألقاك في معجب أوائله % فما تفكرت في عواقبه % 7 
ms178	(@)(@@) % ومن يكن طيبا فلا عجب % أن يأكل الناس من أطايبه ! % PageV01P601 البحر : طويل 1(@)(@@) % غدا يتناءى صاحب كان لي انسا % % فلا مصبح لي في السرور ولا ممسا % % 2(@)(@@) % وتصبح أحزاني عليه كثيرة % ويصبح سعدي من مودته نحسا % % 3(@)(@@) % أخ لي لو أعطى المنى باسم فقده % بلا فقده كانت به ثمنا بخسا % % 4(@)(@@) % فلو أن نفسي الف نفس لما انثنت % % يد البين أو تودي بآخرها نفسا % % PageV01P602 البحر : سريع 1(@)(@@) % ها إن هذا موقف الجازع % أقوى وسؤر الزمن الفاجع % 2(@)(@@) % دار سقاها بعد سكانها % % صرف النوى من سمه الناقع % 3(@)(@@) % ولا تلوما ذا الهوى إنها % % ليست ببدع حنة النازع % 4(@)(@@) % لو قيل ما كان مزورا بها % % إذا لسر الربع بالرابع % 5(@)(@@) % فاعتبرا واستعبرا ساعة % فالدمع قرن للجوى الرادع % 6(@)(@@) % أخلت رباها كل سيفانة % تخلع قلب الملك الخالع % 7(@)(@@) % يصبح في الحب لها ضارعا % من ليس عند السيف بالضارع % 8(@)(@@) % رود إذا جردت في حسنها % % فكرك دلتك على الصانع % 9(@)(@@) % نوح صفا مذ عهد نوح له % % شرب العلى في الحسب الفارع % 10(@)(@@) % مطرد الآباء في نسبة % كالصبح في إشراقه الساطع % PageV01P603 11(@)(@@) % مناسب تحسب من ضوئها % % منازلا للقمر الطالع % 12(@)(@@) % كالدلو والحوت وأشراطه % والبطن والنجم إلى البالع % 13(@)(@@) % نوح بن عمرو بن حوي بن عم % % رو بن حوي بن الفتى ماتع % 14(@)(@@) % السكسكي المجد كنديه % وأددي السؤدد الناصع % 15(@)(@@) % للجدب في امواله مرتع % ومقنع في الخصب للقانع % 16(@)(@@) % قد أشرقت في قومه منهم % ناصية تنأى عن السافع % 17(@)(@@) % كم فارس فيهم إذا استصرخوا % % مثل سنان الصعدة اللامع % 18(@)(@@) % يكره صدر الرمح أو ينثني % % وقد تروى من دم مائع % 19(@)(@@) % بطعنة خرقاء تأتي على % % حزامة المستلئم الدارع % 20(@)(@@) % ينفذ في الآجال أحكامه % أمر مطاع الأمر في طائع % PageV01P604 21(@)(@@) % يخلى لها المأزق يوم الوغى % % عن فرجة في الصف كالشارع % 22(@)(@@) % إن حويا حاجتي فاقضها % % ورد جأش المشفق الجازع % 23(@)(@@) % فتى يمان كاليماني الذي % % يعرم حراه على الوازع % 24(@)(@@) % في حليه النابي وفي جفنه % وفي مضاء الصارم القاطع 
ms179	 % 25(@)(@@) % يجاوز الخفض وأفياءه % إلى السرى والسفر الشاسع % 26(@)(@@) % أدل بالقفر وأهدى له % % من الدعيميص ومن رافع % 27(@)(@@) % يعلم أن الداء مستحلس % تحت جمام الفرس الرائع % 28(@)(@@) % والطائر الطائر في شانه % يلوي بخط الطائر الواقع % 29(@)(@@) % أخفق فاستقدم في همة % وغادر الرتعة للراتع % 30(@)(@@) % ترمي العلى منه بمستيقظ % لا فاتر الطرف ولا خاشع % PageV01P605 31(@)(@@) % وإنما الفتك لذي لأمة % شبعان أو ذي كرم جائع % 32(@)(@@) % أنشر له أحدوثة غضة % تصغي إليها أذن السامع % 33(@)(@@) % إن يرفع السجف له اليوم ير % فعه غدا في المشهد البارع % 34(@)(@@) % فرب مشفوع له لم يرم % حتى غدا يشفع للشافع % 35(@)(@@) % إن أنت لم تنهض به صاعدا % في مستراد الزاهر اليانع % 36(@)(@@) % حتى يرى معتدلا ظنه % بعد التياث الأمل الظالع % 37(@)(@@) % أكدى الذي يعتده عدة % وضاع من يرجوه للضائع % PageV01P606 البحر : سريع 1(@)(@@) % عبدك يدعو باسطا خمسه % مبتهلا يدعو فلا تنسه % 2(@)(@@) % إن أنت لم تبك له رحمة % فلا تلمه إن بكى نفسه % 3(@)(@@) % كم حسرة لي في الفؤاد الذي % % أطلت في سجن الهوى حبسه % 4(@)(@@) % عبد اذا استوحشته لم تجد % % في الناس لو حفوا به أنسه % PageV01P607 البحر : بسيط تام 1(@)(@@) % أما الرسوم فقد أذكرن ما سلفا % % فلا تكفن عن شأنيك أو يكفا % % 2(@)(@@) % لا عذر للصب أن يقنى الحياء ولا % % للدمع بعد مضي الحي أن يقفا % % 3(@)(@@) % حتى يظل بماء سافح ودم % في الربع يحسب من عينيه قد رعفا % % 4(@)(@@) % وفي الخدور مها لو أنها شعرت % إذا ظغت فرحا أو أبلست أسفا % % 5(@)(@@) % لآلىء كالنجوم الزهر قد لبست % أبشارها صدف الإحسان لا الصدفا % % 6(@)(@@) % من كل خود دعاها البين فابتكرت % بكرا ولكن غدا هجرانها نصفا % % 7(@)(@@) % لا أظلم النأي قد كانت خلائقها % % من ، قبل وشك النوى عندي نوى قذفا % % 8(@)(@@) % غيداء جاد ولي الحسن سنتها % % فصاغها بيديه روضة أنفا % % 9(@)(@@) % مصقولة سترت عنا ترائبها % % قلبا برئيا يناغي ناظرا نطفا % % 10(@)(@@) % يضحي العذول على تأنيبه كلفا % بعذر من كان مشغوفا بها كلفا % % PageV01P608 11(@)(@@) % ودع فؤادك توديع الفراق 
ms180	 فما % % أراه من سفر التوديع منصرفا % % 12(@)(@@) % يجاهد الشوق طورا ثم يجذبه % % جهاده للقوافي في أبي دلفا % % 13(@)(@@) % بجوده انصاتت الأيام لابسة % شرخ الشباب وكانت جلة شرفا % % 14(@)(@@) % حتى لو ان الليالي صورت لغدت % أفعاله الغر في آذانها شنفا % % 15(@)(@@) % إذا علا طود مجد ظل في نصب % أو يعتلي من سواه ذروة شعفا % % 16(@)(@@) % فلو تكلم خلق لا لسان له % لقد دعته المعالي ملة طرفا % % 17(@)(@@) % جم التواضع والدنيا بسؤدده % % تكاد تهتز من أطرافها صلفا % % 18(@)(@@) % قصد الخلائق إلا في وغى وندى % كلاهما سبة ما لم يكن سرفا % % 19(@)(@@) % تدعى عطاياه وفرا وهي إن شهرت % كانت فخارا لمن يعفوه مؤتنفا % % 20(@)(@@) % ما زلت منتظرا أعجوبة عننا % حتى رأيت شؤالا يجتنى شرفا % % PageV01P609 21(@)(@@) % يقول قول الذي ليس الوفاء له % % عزما وينجز إنجاز الذي حلفا % % 22(@)(@@) % رأى الحمام شقيق الخلف فاتفقا % % في ناظريه وإن كانا قد اختلفا % % 23(@)(@@) % كلاهما رائح غاد يذل على % % معروفه وعلى حوبائه ائتلفا % % 24(@)(@@) % ولو يقال اقر حد السيف شرهما % % ما شام حديه حتى يقتل الخلفا % % 25(@)(@@) % إن الخليفة والأفشين قد علما % % من اشتفى لهما من بابك وشفى % % 26(@)(@@) % في يوم أرشق والهيجاء قد رشقت % من المنية رشقا وابلا قصفا % % 27(@)(@@) % فكان شخصك في أغفالها علما % وكان رأيك في ظلمائها سدفا % % 28(@)(@@) % نضوته دلفيا من كنانته % فأصبحت فوزة العقبى له هدفا % % 29(@)(@@) % به بسطت الخطا فاسحنفرت رتكا % إلى الجلاد وكانت قبله قطفا % % 30(@)(@@) % خطوا ترى الصارم الهندي منتصرا % به من المارن الخطي منتصفا % % PageV01P610 31(@)(@@) % ذمرت جمع الهدى فانقض منصلتا % وكان في حلقات الرعب قد رسفا % % 32(@)(@@) % ومر بابك مر العيشش منجذما % محلوليا دمه المعسول لو رشفا % % 33(@)(@@) % حيران يحسب سجف النقع من دهش % طودا يحاذر أن ينقض أو جرفا % % 34(@)(@@) % ظل القنا يستقي من صفه مهجا % إما ثمادا وإما ثرة خسفا % % 35(@)(@@) % من مشرق دمه في وجهه ، بطل ، % وواهل دمه للرعب قد نزفا % % 36(@)(@@) % فذاك قد سقيت منه القنا جرعا % وذاك قد سقيت منه القنا نطفا % % 37(@)(@@) % مثقفات 