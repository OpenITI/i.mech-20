ms401	 وجدت الماء فاغتسل .(@)(@@) 1374 - أخبرني أحمد بن شعيب ، قال : أنبأ يعقوب بن إبراهيم ، قال : حدثنا الحارث بن مرة ، قال : حدثنا أبو العوام شيبان بن زهير ، عن عبد الرحمن بن أبي بكرة ، قال : كنت أول مولود ولد بالبصرة ففرح بي المسلمون أن ولد مولود في مصر مصروه ، فذهب بي إلى أميرها فحباني ثمانين درهما ، ونحرت علي جزر يطعم منها جميع أهل البصرة .(@)(@@) 1375 - أخبرني أحمد بن شعيب ، قال : أنبا أزهر بن جميل ، قال : حدثنا أبو العوام العبدي أمية بن حكيم ، قال : حدثنا هلال بن خباب ، عن سعيد بن جبير ، أن الحسن بن علي خطب الناس ، فقال : يا أهل الكوفة ! لو لم تذهل نفسي عنكم إلا لثلاث خصال لذهلت مقتلكم أبي ، ولم يتمه . PageV02P791 سمعت العباس بن محمد ، عن يحيى [ بن معين ] ، قال : جعفر بن ميمون ، هو أبو العوام .(@)(@@)(@@)(@@) |||| ( من كنيته أبو عوانة )(@)(@@)(@@)(@@) $ * أبو عوانة وضاح بن عبد الله البصري ، يروي عنه : عبد الرحمن بن مهدي .(@)(@@)(@@)(@@) $ * وأبو عوانة القصاب ، يروي عنه : أبو كامل .(@)(@@) حدثنا أبو الربيع خالد بن يوسف بن خالد ، قال : حدثنا أبو عوانة وضاح بن عبد الله .(@)(@@) حدثنا إسحاق بن سيار النصيبي ، قال : حدثنا عمرو بن عاصم الكلابي ، قال : [ حدثنا ] أبو عوانة من سبي جرجان .(@)(@@) حدثني محمد بن يعقوب بن الفرجي ، قال : حدثنا أبو الربيع الزهراني ، قال : حدثنا أبو عوانة ، واسمه : وضاح بن الصلاح ، وكان مولى لبني المقرن ، وكان من سبي المهلب .(@)(@@) 1376 - حدثنا يزيد بن سنان ، قال : حدثنا أبو كامل ، قال : حدثنا أبو عوانة القصاب ينزل مربعة الأحنف قال : كان غلام الحسن يجيئني كل يوم بنصف درهم ، فيأخذ به مني لحما . PageV02P792(@)(@@)(@@)(@@) |||| ( من كنيته أبو عوف )(@)(@@)(@@)(@@) $ * أبو عوف يزيد بن الأصم .(@)(@@)(@@)(@@) $ * وأبو عوف حميد بن عبد الرحمن [ بن حميد ] الرواسي .(@)(@@) 1360 - أخبرني أحمد بن شعيب ، قال : أنبأ مخلد بن الحسن بغدادي ، قال : حدثنا أبو المليح ، عن يزيد بن يزيد [ الأزدي ، ( 2 / 48 ) عن يزيد ] بن الأصم ، عن أبي هريرة ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إني لأهم أن آمر 
ms402	 فتيتي ، فيجمعون حزما من حطب ، ثم آمر قوما يصلون في بيوتهم ليست بهم علة ، فأحرقها عليهم .(@)(@@) قال يزيد : فجئت إلى أصحابي فحدثتهم ، فقال : إنما عنى الجمعة ، فخرجت إلى يزيد بن الأصم ، فقلت : يا أبا عوف ! الحديث الذي حدثتنا ، عن أبي هريرة ، عن النبي [ صلى الله عليه وسلم ] : الجمعة عنى أو غيرها قال : يا ابن أخي ! لا سمعت بأذني هذه شيئا أبدا ، إن لم أكن سمعت أبا هريرة يأثره ، عن رسول الله [ صلى الله عليه وسلم ] ما ذكر فيه جمعة ولا غيرها .(@)(@@) [ و ] أخبرني أحمد بن شعيب ، قال : أنبأ عمار بن الحسن قال : ثنا حميد بن عبد الرحمن أبو عوف الرواسي . PageV02P793(@)(@@)(@@)(@@) |||| ( من كنيته أبو عون )(@)(@@)(@@)(@@) $ * أبو عون عبد الله بن [ عون ] الأرطبان .(@)(@@)(@@)(@@) $ * وأبو عون خصيف بن عبد الرحمن الجزري .(@)(@@)(@@)(@@) $ * وأبو عون جعفر بن عون بن عمرو بن حريث .(@)(@@)(@@)(@@) $ * وأبو عون الأنصاري ، يحدث عنه : الأحوص بن حكيم .(@)(@@)(@@)(@@) $ * وأبو عون محمد بن عبيد الله [ الثقفي ] .(@)(@@)(@@)(@@) $ * وأبو عون العلاء بن عبد الكريم .(@)(@@)(@@)(@@) $ * وأبو عون سيار بن إبراهيم العبدي .(@)(@@)(@@)(@@) $ * وأبو عون الحكم بن سنان [ بصري ] .(@)(@@) [ حدثنا أبي ، قال : حدثنا جعفر بن عون بن عمرو بن حريث وأبو عون الأنصاري يحدث عنه : الأحوص بن حكيم ] .(@)(@@) 1378 - حدثنا أ [ ي ، قال : حدثنا جعفر بن عون بن عمرو بن حريث أبو عون ، قال : حدثنا محمد بن شريك ، عن ابن أبي مليكة ، قال : قالت عائشة : توفي رسول الله [ صلى الله عليه وسلم ] في بيتي وفي ليلتي وفي يومي ، وبين سحري ونحري .(@)(@@) حدثنا إبراهيم بن يعقوب ، قال : حدثنا النفيلي ، قال : حدثنا عتاب بن PageV02P794 بشير ، عن خصيف ، قال : قال لي مجاهد : أنا أحبك يا أبا عون في الله جل ثناؤه .(@)(@@) سمعت العباس ، عن يحيى قال : خصيف كنيته أبو عون .(@)(@@) 1379 - حدثنا محمد بن المثنى ، قال : حدثنا محمد بن جعفر ، قال : حدثنا شعبة ، عن يزيد أبي خالد ، قال : سمعت أبا عون محمد بن عبيد الله ، يحدث عن القاسم بن عبد الرحمن ، عن أبيه ، عن عبد الله : في الرجل يوصي بأكثر من الثلث 
ms403	 ، فيجيزه الوارث ، ثم لا يجيزه بعد موته ، قال : ذاك المكره لا يجوز .(@)(@@) 1380 - حدثنا أبو شيبة ، قال : حدثنا عمر بن حفص ، قال : حدثني أبي ، قال : حدثنا الأعمش ، قال : حدثني أبو عون محمد بن عبيد الله الثقفي ، أنه رأى عبد الرحمن بن أبي ليلى ينثني على صدور قدميه .(@)(@@) 1381 - حدثنا يزيد بن سنان ، قال : حدثنا أبو كامل ، قال : حدثنا أبو معشر البراء قال : حدثنا يونس بن الحارث بن مندويه ، قال : حدثني محمد ابن عبيد الله بن سعيد أبو عون الثقفي ، عن أبيه ، عن المغيرة بن شعبة ، قال : كان رسول الله [ صلى الله عليه وسلم ] يستحب أن يصلي على حصير أو فروة .(@)(@@) 1382 - حدثنا مؤمل بن إهاب ، قال : حدثنا محمد بن بشر العبدي ، قال : حدثنا الأحوص بن حكيم .(@)(@@) وحدثنا الحسن بن علي بن عفان ، قال : حدثنا أبو أسامة ، عن الأحوص بن حكيم ، عن أبي عون ، عن سعيد بن المسيب ، قال : قال النبي PageV02P795 [ صلى الله عليه وسلم ] [ قلة الحياء ] كفر .(@)(@@) 1383 - أنبأ أحمد بن شعيب ، قال : حدثنا محمد بن يحيى بن أيوب ، قال : حدثنا أبو عون الحكم بن سنان ، قال : حدثنا ثابت ، عن أنس ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إن الله جل ثناؤه قبض قبضة فقال للجنة : برحمتي ، وقبض قبضة ، فقال : للنار ولا أبالي .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى [ بن معين ] يقول : العلاء بن عبد الكريم أبو عون .(@)(@@) قال يحيى : وأبو عون محمد بن عبيد الله ( 2 / 49 ) الثقفي .(@)(@@) قال أبو بشر : سيار بن إبراهيم أبو عون العبدي حدث عنه : معلى بن أسد . (@)(@@) 1384 - قال : حدثنا سيار بن إبراهيم أبو عون ، قال : حدثنا غيلان ابن جرير ، عن أنس ، قال : سئل رسول الله [ صلى الله عليه وسلم ] أي المؤمنين أفضل إيمانا ؟ قال : أحسنهم خلقا . PageV02P796(@)(@@)(@@)(@@) ||| ( حرف لا في العين )(@)(@@)(@@)(@@) |||| ( من كنيته أبو العلاء )(@)(@@)(@@)(@@) $ * أبو العلاء يزيد بن عبد الله بن الشخير .(@)(@@)(@@)(@@) $ * وأبو العلاء قبيصة بن جابر .(@)(@@)(@@)(@@) $ * وأبو العلاء صبيح ، يحدث عن : ابن بريدة ، روى عنه : عبد العزيز بن مسلم .(@)(@@)(@@)(@@) $ * وأبو 
ms404	 العلاء موسى ، عن أنس ، يروي عنه : حماد بن سلمة .(@)(@@)(@@)(@@) $ * وأبو العلاء المسيب بن رافع .(@)(@@)(@@)(@@) $ * وأبو العلاء عبد الرحمن بن أمين .(@)(@@)(@@)(@@) $ * وأبو العلاء عمرو بن العلاء ، يروي عنه : أبو الوليد الطيالسي .(@)(@@)(@@)(@@) $ * وأبو العلاء عقبة بن المغيرة الشيباني .(@)(@@)(@@)(@@) $ * وأبو العلاء عليلة بن بدر ، وهو الربيع بن بدر .(@)(@@)(@@)(@@) $ * وأبو العلاء [ يريم ] بن أسعد ، ويقال : ابن سعد ، يروي عنه : أبو إسحاق السبيعي .(@)(@@)(@@)(@@) $ * وأبو العلاء برد بن سنان .(@)(@@)(@@)(@@) $ * وأبو العلاء سالم المرادي .(@)(@@)(@@)(@@) $ * وأبو العلاء ناصح .(@)(@@)(@@)(@@) $ * وأبو العلاء صلة بن زفر .(@)(@@)(@@)(@@) $ * وأبو العلاء الضحاك بن يسار ، يروي عنه : وكيع . PageV02P797(@)(@@)(@@)(@@) $ * وأبو العلاء كامل بن العلاء ، يروي عنه : زيد بن حباب .(@)(@@)(@@)(@@) $ * وأبو العلاء كثير بن نباتة ، يروي عنه : المعتمر .(@)(@@)(@@)(@@) $ * وأبو العلاء جمهان .(@)(@@)(@@)(@@) $ * وأبو العلاء جنيد بن العلاء ، يروي عنه : أبو أسامة .(@)(@@)(@@)(@@) $ * وأبو العلاء حيان بن عمير .(@)(@@)(@@)(@@) $ * وأبو العلاء الحسن بن سوار .(@)(@@)(@@)(@@) $ * وأبو العلاء [ الخفاف ] خالد بن طهمان .(@)(@@)(@@)(@@) $ * وأبو العلاء هارون بن هارون .(@)(@@)(@@)(@@) $ * وأبو العلاء معاذ بن عوذ الله البصري .(@)(@@)(@@)(@@) $ * وأبو العلاء هلال بن خباب .(@)(@@)(@@)(@@) $ * وأبو العلاء مطر .(@)(@@)(@@)(@@) $ * وأبو العلاء أيوب بن مسكين ، يروي عنه : يزيد بن هارون .(@)(@@)(@@)(@@) $ * وأبو العلاء داود بن عبد الله الأودي .(@)(@@)(@@)(@@) $ * وأبو العلاء زياد مولى بني كلاب ، عن الحسن .(@)(@@)(@@)(@@) $ * وأبو العلاء زيد ، يروي عنه : معتمر بن سليمان .(@)(@@)(@@)(@@) $ * وأبو العلاء عبد الرحمن بن العلاء ، يحدث عنه : أبو سعيد مولى بني هاشم .(@)(@@)(@@)(@@) $ * [ وأبو العلاء يزيد بن درهم ] .(@)(@@) 1385 - حدثنا محمد بن منصور ، قال : حدثنا سفيان بن عيينة ، عن أبي العلاء مطر ، قال : سألت الحسن ، فقلت : قتلت قرادا قال : أطعم رغيفا . PageV02P798(@)(@@) 1386 - حدثنا عمرو بن علي ، قال : حدثنا أبو قتيبة ، قال : حدثنا مطر أبو العلاء ، عن الحسن قال : وقت الجمعة وقت الظهر .(@)(@@) 1387 - حدثنا أبو بكر الصنعاني ، قال : حدثنا معاذ بن عوذ الله أبو العلاء البصري ومنزله المربد ، قال : حدثنا عوف ، عن أبي الصديق ، عن أبي سعيد ، قال : قال رسول الله [ صلى الله عليه وسلم ] : ابن أخت القوم منهم . (@)(@@) 1388 - أخبرني أحمد بن شعيب ، قال : أنبأ علي بن حجر ، قال : أنبأ بقية ، عن أبي العلاء هارون بن هارون 
ms405	 ، عن عبد الله بن زياد ، عن مجاهد ، عن ابن عباس ، قال : قال رسول الله [ صلى الله عليه وسلم ] : هلاك أمتي في العصبية والقدرية .(@)(@@) والرواية من غير ثبت .(@)(@@) حدثنا الربيع [ بن سليمان ] صاحب الشافعي ، قال : حدثنا أسد بن موسى ، قال : حدثنا قيس بن الربيع ، عن أبي العلاء خالد بن طهمان .(@)(@@) 1389 - حدثنا أبي ، قال : حدثنا أبو أسامة ، قال : حدثنا جنيد أبو العلاء ، عن مجالد ، عن الشعبي ، عن مسروق ، قال : قدمت على عمر ، فقال : ما اسمك ، قلت : مسروق بن الأجدع ، قال : أنت مسروق بن عبد الرحمن ، سمعت رسول الله [ صلى الله عليه وسلم ] يقول : الأجدع شيطان .(@)(@@) 1390 - حدثنا أبو داود الحراني سليمان ( 2 / 50 ) بن سيف ، قال : حدثنا أبو عتاب ، قال : حدثنا الضحاك بن يسار أبو العلاء ، قال : أخبرني أبو سنان ، عن عثمان بن أبي سودة ، عن أبي هريرة ، عن النبي [ صلى الله عليه وسلم ] PageV02P799 قال : المسلم إذا أراد أن يعود أخاه أو يزوره ، نودي أن طبت وطاب ممشاك ، وتبوأت من الجنة مقعدا أو مجلسا .(@)(@@) أخبرني عبد الله بن أحمد بن حنبل ، عن أبيه ، قال : أيوب أبو العلاء القصاب ، ليس به بأس ، وكان [ مفتيهم ] بواسط .(@)(@@) حدثنا العباس [ بن محمد ] ، قال : حدثنا يحيى ، قال : اسم أبي العلاء بن الشخير يزيد بن عبد الله الشخير .(@)(@@) وحيان بن عمير أبو العلاء .(@)(@@) [ و ] حدثنا العباس بن محمد ، قال : سمعت يحيى [ بن معين ] ، يقول : أبو العلاء ليس بحديثه بأس ، كان شاميا نزل البصرة ، وروى الناس عنه عبد الأعلى بن عبد الأعلى وغيره .(@)(@@) قلت ليحيى : كم كان حديث سرد أبو العلاء ؟ قال : نحوا من مائتي حديث .(@)(@@) قال : وأبو العلاء الخفاف ، هو خالد بن طهمان .(@)(@@) قال : وأيوب بن مسكين واسطي [ قصاب ] ، وكنيته أبو العلاء .(@)(@@) [ قال : وهلال بن خباب ينزل المدائن ، هو أبو العلاء . PageV02P800(@)(@@) وقال : موسى القتبي هو أبو العلاء ] ، يروي عنه غير واحد .(@)(@@) 1391 - حدثني أبو بكر وكيل دار العباس بن الوليد ، قال : حدثنا عمرو الناقد ، قال : حدثنا معتمر ، عن زيد أبي العلاء ، قال : أتى إياس بن معاوية رجلان 
ms406	 في جارية ، فقال أحدهما : إنها حمقاء ، قال : وهل ترد من الحمق ؟ قال : إنه مثل الجنون ، قال : وهل ترد مثل الحمق [ قال : إنه أمثل من الجنون ] أو أشد مثل الجنون ؟ قال : فقال لها : تذكرين يوم ولدتك أمك ؟ قالت : نعم ، قال : فأي رجليك أطول ؟ قالت : هذه ومدت إحداهما ، قال : فردها .(@)(@@) 1392 - حدثنا أبو محمد الحسن بن علي بن عفان ، قال : حدثنا حسين الجعفي ، قال : حدثنا أبو العلاء الخفاف ، قال : أخبرني حبيب البجلي ، أن أنسا حدثه ، أنه من صلى أربعين ليلة في جماعة لم تفته ركعة كتب الله له براءتان براءة من النار ، وبراءة من النفاق .(@)(@@) 1393 - حدثنا محمد بن منصور ، قال : حدثنا أبو سعيد مولى بني هاشم ، قال : حدثنا عبد الرحمن بن العلاء أبو العلاء ، قال : حدثنا محمد بن مهاجر ، عن كيسان مولى معاوية ، عن معاوية ، أنه خطب الناس ، فقال : إن رسول الله [ صلى الله عليه وسلم ] نهى عن تسع ، وأنا أنهى عنهن : عن النوح ، والشعر ، والغناء ، والتبرج ، والتصاوير ، [ والجلوس على ] جلود السباع ، والذهب ، والحرير ، والخز . PageV02P801(@)(@@) 1394 - أخبرني أحمد بن شعيب ، قال : أنبأ سويد بن نصر ، قال : أنبأ عبد الله بن المبارك ، قال : حدثنا خالد أبو العلاء ، هو ابن طهمان ، عن عطية ، عن أبي سعيد ، قال : قال رسول الله [ صلى الله عليه وسلم ] : كيف أنعم وصاحب القرن قد التقم القرن ، واستمع الإذن حتى يؤمر بالنفخ فينفخ .(@)(@@) 1395 - أخبرني أحمد بن شعيب ، قال : أنبأ سوار بن عبد الله بن سوار ، قال : حدثنا معتمر بن سليمان ، قال : حدثنا أبي ، قال : حدثنا حيان ابن عمير أبو العلاء ، قال : سمعت عبيد بن عمير ، قال : إن تحميد الله يفتح أبواب السماء ، وإن تكبير الله يملأ ما بين السماء والأرض ، وإن تسبيح الله لا ينتهي دون الله والملائكة والعرش .(@)(@@) 1396 - [ و ] أخبرني أحمد بن شعيب ، قال : أنبأ إسحاق بن إبراهيم ، قال : حدثنا المعتمر ، قال : سمعت أبا العلاء كثير بن نباتة قال : قال الحسن : لا عتاقة إلا ما أريد به وجه الله .(@)(@@) 1397 - أخبرني أحمد بن شعيب ، قال : أنبأ 
ms407	 عبد الله بن سعيد ، قال : حدثنا عقبة بن المغيرة الشيباني أبو العلاء ، قال : حدثنا إسحاق بن أبي إسحاق الشيباني ، عن أبيه ، عن مخارق بن سليم ، قال : كنت مع عمار يوم الجمل ، فقال : يا مخارق ! إيت راية قومك ، فإني رأيت رسول الله [ صلى الله عليه وسلم ] PageV02P802 يستحب ان يقاتل الرجل تحت راية قومه .(@)(@@) 1398 - وأخبرني أحمد بن شعيب ، قال : أنبأ سويد بن نصر ، قال : أخبرنا عبد الله ، عن معمر ، قال : حدثني محمد بن واسع ، عن أبي العلاء يزيد بن عبد الله بن الشخير ، قال : أخبرني ابن أخي عامر بن عبد قيس ، أن عامر بن عبد ( 2 / 51 ) قيس كان يأخذ عطاءه فيجعله في طرف ثوبه ، ولا يلقى أحدا من المساكين إلا أعطاه ، فإذا دخل بيته رمى به إليهم فيعدونها فيجدونها سواء ، كما أعطاها .(@)(@@) 1399 - [ و ] أخبرني أحمد بن شعيب ، قال : أخبرنا محمد بن يحيى بن أيوب بن إبراهيم ، قال : حدثنا عبد الأعلى ، قال : حدثنا برد بن سنان أبو العلاء ، عن الزهري ، عن عروة ، عن عائشة قالت : إنما القرء ما بين الحيضتين ، فإذا دخلت في الحيضة الثالثة فقد بانت .(@)(@@) [ و ] أخبرني أحمد بن شعيب ، قال : حدثنا محمد بن بشار في حديثه ، عن عبد الرحمن يعني ابن مهدي ، عن سفيان ، عن الأعمش ، عن أبي وائل ، قال : قلت لأبي العلاء صلة بن زفر يا أبا العلاء ! .(@)(@@) 1400 - [ أخبرني يحيى بن عثمان بن صالح ، قال : حدثنا نعيم بن حماد ، قال : حدثنا عبد الله بن المبارك ، قال : حدثنا سفيان ، عن سليمان ، عن أبي وائل ، قال : لقيت أبا العلاء صلة بن زفر ، فقلت : يا أبا العلاء ] هل بأهلك شيء من هذا الوجع ، يعني الطاعون ؟ [ فقال ] : إنا لأن يخطئهم أخوف مني لأن يصيبهم . PageV02P803(@)(@@) 1401 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : أبو العلاء يريم بن أسعد الهمداني ، سمع من قيس بن [ سعد بن ] عبادة وشهد مع علي بصفين ، وكان من شرطة الخميس ، والخميس الجيش ، هلك في فتنة ابن الزبير .(@)(@@) 1402 - أخبرني القاضي 
ms408	 البرقي ، عن موسى بن إسماعيل ، عن حماد ابن سلمة ، قال : أنبأ موسى أبو العلاء ، عن أنس بن مالك ، قال : كان النبي [ صلى الله عليه وسلم ] يصلي الظهر في أيام الشتاء ، وما يدري ما مضى من النهار وما بقي .(@)(@@) 1403 - حدثنا بشر بن عبيد الله ، قال : حدثنا وكيع بن الجراح ، عن يزيد بن درهم أبي العلاء ، قال : سمعت أبا العالية ، عن ابن عباس ، قال : الفتيل الذي ينفتل بين أصبعي الرجل إذا دلكهما ، والنقير الذي ينقر بالسبابة فوق ظهر الإبهام كما ينقر الدرهم .(@)(@@) 1404 - حدثنا أحمد بن يحيى الأودي ، قال : حدثنا مخول بن إبراهيم ، قال : حدثنا كامل أبو العلاء ، عن الحسن بن عمرو ، وعامر بن السمط ، عن محارب بن دثار ، عن جابر بن عبد الله ، قال : حرمت الخمر ، وما كان شراب الناس يومئذ إلا البسر والتمر .(@)(@@) 1405 - حدثنا زياد بن أيوب ، قال : حدثنا عبيد الله بن موسى ، عن سكين بن عبد العزيز ، قال : حدثنا أبو العلاء هلال بن خباب ، قال : حدثني خالد بن جابر ، عن أبيه ، قال سمعت عليا عليه السلام قبل مقتله بأربع سنين ، وهو يقول : ما آن للشقي أن يخضب هذه من هذا ، يعني لحيته من رأسه . PageV02P804(@)(@@)(@@)(@@) |||| ( من كنيته أبو العلانية ، وأبو علاقة )(@)(@@)(@@)(@@) $ * أبو العلانية مسلم ، روى عنه : محمد بن سيرين .(@)(@@)(@@)(@@) $ * وأبو العلانية محمد بن أبي يحيى ، روى عنه : عبد الرحمن بن مهدي .(@)(@@)(@@)(@@) $ * وأبو العلانية محمد بن يحيى ، ويقال : ابن أعين .(@)(@@)(@@)(@@) $ * وأبو علاقة عبد الصمد بن محمد .(@)(@@) سمعت العباس بن محمد ، عن يحيى [ بن معين ] قال : أبو العلانية اسمه مسلم .(@)(@@) 1406 - أخبرني أحمد بن شعيب ، قال : أنبأ عبد الله بن عبد الرحمن ابن عبد العزيز بن محمد بن عطية ، قال : حدثنا أبو علاقة عبد الصمد بن محمد ، قال : حدثني عتبة بن ضمرة ، قال : كان أبو همدان ، يقول في فتنة القبر : الفتانون أربعة : أنكر ومنكر وناكور ، وسيدهم دومان . PageV02P805(@)(@@)(@@)(@@) ||| ( حرف الياء في العين )(@)(@@)(@@)(@@) |||| ( من كنيته أبو عيسى ، [ وأبو عياض ، وأبو عياش ، وأبو عيينة ] )(@)(@@)(@@)(@@) $ * أبو عيسى عبد الرحمن بن أبي ليلى .(@)(@@)(@@)(@@) $ * وأبو عيسى 
ms409	 حاضر بن مهاجر [ الباهلي ] ، روى عنه : شعبة .(@)(@@)(@@)(@@) $ * وأبو عيسى موسى بن طلحة .(@)(@@)(@@)(@@) $ * وأبو عيسى محمد بن عبد الرحمن ، روى عنه : الليث ، ويحيى بن أيوب .(@)(@@)(@@)(@@) $ * وأبو عيسى محمد بن القاسم المرادي ، ( 2 / 52 ) .(@)(@@)(@@)(@@) $ * وأبو عيسى موسى بن مسلم الصغير [ الطحان ] ، يحيى القطان عنه .(@)(@@)(@@)(@@) $ * وأبو عيسى موسى بن بكر الأنصاري .(@)(@@)(@@)(@@) $ * وأبو عيسى خلاد القارئ .(@)(@@)(@@)(@@) $ * وأبو عيسى فديك بن سليمان القيسراني ، روى عن : الأوزاعي .(@)(@@)(@@)(@@) $ * وأبو عيسى سليمان بن كيسان ، يحدث عنه : حيوة بن شريح ، وسعيد بن أبي أيوب .(@)(@@)(@@)(@@) $ * وأبو عيسى يحيى بن رافع ، سمع : عثمان بن عفان ، يروي عنه : إسماعيل بن أخي خالد .(@)(@@)(@@)(@@) $ * وأبو عياض عمرو بن الأسود العبسي شامي . PageV02P806(@)(@@)(@@)(@@) $ * وأبو عياض أبان بن راشد السروجي ، يحدث عن : المسعودي .(@)(@@)(@@)(@@) $ * وأبو عياش [ الزهري ] زيد بن عياش ، عن سعد في بيع البيضاء بالسلت .(@)(@@)(@@)(@@) $ * وأبو عيينة مضر بن غسان بن مضر .(@)(@@) 1407 - حدثنا محمد بن عوف ، قال : حدثنا محمد بن المبارك .(@)(@@) وحدثنا إبراهيم بن سليمان الأسدي ، قالا : حدثنا يحيى بن صالح ، قال : حدثنا معاوية بن [ سلام ] ، عن يحيى بن أبي كثير ، قال : أخبرني عبد الله بن يزيد ، أن زيدا أبا عياش أخبره ، أنه سمع سعدا ، قال : نهى رسول الله [ صلى الله عليه وسلم ] عن بيع الرطب بالتمر نسيئة .(@)(@@) حدثنا أبوحفص عمرو بن علي ، قال : حدثنا يحيى بن سعيد ، قال : حدثنا موسى بن مسلم الطحان أبو عيسى ، قال : أبو حفص ، وهو موسى الصغير .(@)(@@) سمعت العباس [ بن محمد ] ، عن يحيى بن معين قال : موسى الصغير هو موسى بن مسلم الطحان ، كنيته [ أبو عيسى ] .(@)(@@) 1408 - حدثنا محمد بن بشار ، قال : حدثنا محمد بن جعفر ، قال : حدثنا شعبة ، قال : سمعت [ أبا عيسى ] حاضر بن المهاجر الباهلي ، قال : PageV02P807 سمعت سليمان بن يسار ، يحدث عن زيد بن ثابت ، أن ذئبا نيب في شاة فذبحوها بمروة ، فرخص النبي [ صلى الله عليه وسلم ] في أكلها .(@)(@@) 1409 - حدثنا أبو بكر محمد بن علي بن أخت غزال ، قال : حدثنا أحمد بن حنبل ، قال : حدثنا محمد بن جعفر ، قال : حدثنا شعبة ، قال : سمعت حاضر بن المهاجر أبا 
ms410	 عيسى الباهلي ، قال : سمعت سليمان بن يسار ، يحدث عن زيد بن ثابت مثله سواء .(@)(@@) 1410 - أخبرني أحمد بن شعيب ، قال : أنبأ سويد بن نصر ، قال : حدثنا عبد الله ، عن إسماعيل بن أبي خالد ، قال : سمعت أبا عيسى يحيى بن رافع ، يقول : سمعت عثمان بن عفان يقول في قول الله جل ثناؤه : @QB@ وجاءت كل نفس معها سائق وشهيد @QE@ قال : سائق يسوقها إلى أمر الله ، وشهيد يشهد عليها بما عملت .(@)(@@) 1411 - أخبرني أحمد بن شعيب ، قال : حدثنا قتيبة بن سعيد ، قال : حدثنا مبارك بن سعيد الثوري ، عن موسى بن أبي عائشة ، قال : حدثني أبو الجهم ، قال : صحبت عبد الله بن عكيم ، و [ عبد الرحمن ] ابن أبي ليلى [ أبا عيسى ] عشرين عاما ، هذا علوي ، وهذا عثماني ، يتزاورون في اليوم مرارا ، فسمعت عبد الله يقول : لو صبر صاحبك يعني عليا عليه السلام لأتاه الناس حتى يبايعوه . PageV02P808(@)(@@) 1412 - وأخبرني أحمد بن شعيب ، قال : أنبأ هاشم بن القاسم ، قال : حدثنا عيسى ، عن عثمان بن حكيم ، عن خالد بن سلمة ، أن عبد الحميد ابن عبد الرحمن دعا موسى بن طلحة حين أعرس على ابنته ، فقال : يا أبا عيسى ! كيف بلغك الصلاة على النبي [ صلى الله عليه وسلم ] ؟ فقال موسى : أنا سألت زيد بن خارجة ، عن الصلاة على النبي [ صلى الله عليه وسلم ] ، فقال زيد : أنا سألت رسول الله [ صلى الله عليه وسلم ] ، فقلت : كيف الصلاة عليك ؟ قال : صلوا واجتهدوا ، ثم قولوا : اللهم بارك على محمد ، وعلى آل محمد ، كما باركت على إبراهيم ، وعلى آل إبراهيم ، إنك حميد مجيد .(@)(@@) 1413 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : [ عبد الرحمن ] بن أبي ليلى كنيته أبو عيسى ، أتى عمر بن الخطاب ولا أعلم أنه سمع من عمر شيئا ، وقد سمع من عثمان ، وعلي رضي الله عنهما ، وشهد ( 2 / 53 ) مع علي حروبه ، وكان أبو ليلى أبوه من أصحاب النبي [ صلى الله عليه وسلم ] ، وكان مع علي عليه السلام في مشاهده ، قتل عبد الرحمن [ بدجيل 
ms411	 ] مع عبد الرحمن بن الأشعث ، قتله الحجاج .(@)(@@) 1414 - حدثني عبيد الله بن سعيد بن كثير أبو القاسم ، قال : حدثنا أبي ، قال : حدثني سليمان بن أيوب بن سليمان بن عيسى بن موسى بن طلحة PageV02P809 ابن عبيد الله ، قال : كان موسى بن طلحة بن عبيد الله يكنى أبا عيسى ، وكان يشد أسنانه بالذهب ، ويخضب لحيته ورأسه بالسواد .(@)(@@) قال محمد بن إسماعيل البخاري ، عن علي بن المديني ، عن ابن عيينة : سألت يوسف بن يعقوب كيف كان الحكم بن أبان ؟ فقال : ذاك سيدنا أبو عيسى ، مات سنة أربع وخمسين ومائة ، وهو ابن أربع وثمانين ، وقدم عكرمة اليمن سنة مائة . PageV02P810(@)(@@)(@@)(@@) ||| ( ذكر من كنيته أبو عبد الله )(@)(@@)(@@)(@@) $ * أبو عبد الله إسماعيل بن أبي خالد الكوفي ، واسم أبي خالد سعد .(@)(@@)(@@)(@@) $ * وأبو عبد الله إسماعيل بن الخليل كوفي .(@)(@@)(@@)(@@) $ * وأبو عبد الله إسماعيل بن أبي أويس .(@)(@@)(@@)(@@) $ * وأبو عبد الله إسحاق ، سمع : أبا هريرة ، العلاء بن عبد الرحمن عنه .(@)(@@)(@@)(@@) $ * وأبو عبد الله إدريس بن يزيد الأودي .(@)(@@)(@@)(@@) $ * وأبو عبد الله أشعث بن عبد الله بن جابر الحداني ، وليس هو المكثر عن الحسن .(@)(@@)(@@)(@@) $ * وأبو عبد الله أصبغ بن زيد .(@)(@@)(@@)(@@) $ * وأبو عبد الله أصبغ بن الفرج .(@)(@@)(@@)(@@) $ * وأبو عبد الله أمية بن خالد .(@)(@@)(@@)(@@) $ * وأبو عبد الله أحمد بن عبد الله بن يونس .(@)(@@)(@@)(@@) $ * وأبو عبد الله أحمد بن محمد بن حنبل رحمه الله .(@)(@@) 1415 - حدثنا عمرو بن علي أبو حفص ، ويزيد بن سنان أبو خالد ، قالا : حدثنا أبو عاصم ، عن ابن جريج ، قال : وأخبرني العلاء بن عبد الرحمن ، عن إسحاق أبي عبد الله ، أنه سمع أبا هريرة ، يقول : قال رسول الله [ صلى الله عليه وسلم ] : لا تطلع الشمس ولا تغرب على يوم أفضل من يوم الجمعة . PageV02P811(@)(@@) قال محمد بن إسماعيل البخاري : حدثنا [ محمد بن ] علي بن نصر ، قال : أشعث بن عبد الله بن جابر أبو عبد الله .(@)(@@) قال البخاري : قد روى معمر ، عن أشعث بن عبد الله ، عن شهر بن حوشب ، عن أبي هريرة أحاديث لا يتابع على بعضها ، وروى يحيى القطان ، عن الأشعث ، قال 
ms412	 : الحداني عن شهر ، عن أبي هريرة ، وأشعث الحداني ، وأشعث الأعمى واحد .(@)(@@) سمعت العباس بن محمد ، يقول : قال يحيى بن معين : كنية إسماعيل بن أبي خالد أبو عبد الله . [(@)(@@) 1356 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : إسماعيل بن أبي خالد أبو عبد الله ] مولى بجيلة ، من نظراء حصين لقي ابن أبي أوفى ، وأبا جحيفة ، وأنسا وكان علويا ، هلك سنة خمس وأربعين ومائة ، وهو ابن خمس وتسعين سنة .(@)(@@)(@@)(@@) $ * وأبو عبد الله بكر بن عبد الله المزني .(@)(@@)(@@)(@@) $ * وأبو عبد الله بديل بن بشير ، روى عنه : أبو داود .(@)(@@)(@@)(@@) $ * وأبو عبد الله بشر بن بكر التنيسي .(@)(@@)(@@)(@@) $ * وأبو عبد الله بشر بن آدم .(@)(@@)(@@)(@@) $ * وأبو عبد الله بشر بن مسلم .(@)(@@)(@@)(@@) $ * وأبو عبد الله البركاني .(@)(@@) 1399 - حدثنا عمرو بن علي أبو حفص ، قال : حدثنا [ أبو داود ، قال : PageV02P812 حدثنا ] بديل بن بشير أبو عبد الله الخزاعي ، قال : سألت القاسم بن محمد ، وعطاء عن الصلاة بمنى ؟ فقال عطاء : يتم ، وقال القاسم صل صلاة إمامك .(@)(@@) حدثني عبد الله بن أحمد بن حنبل ، قال : حدثني أبو خيثمة زهير بن حرب ، عن أبي عبد الله البركاني ، عن محمد بن جابر ، عن الأعمش ، عن أبي وائل ، قال : قلما خبطتك الفصلان فأكلت العلهز .(@)(@@)(@@)(@@) $ * وأبو عبد الله ثمة بن لفافة العكي ، روى عنه محمد بن يوسف الفريابي .(@)(@@) 1416 - ( 2 / 54 ) حدثنا سعيد بن أبي زيدون ، قال : حدثنا محمد بن يوسف الفريابي ، قال : حدثنا ثمة بن لفافة أبو عبد الله العكي ، عن طاوس ، قال : من صلى العشاء ، ثم صلى بعدها أربعا ثم أوتر فكأنما صلى الليل أجمع .(@)(@@) 1417 - حدثنا سعيد بن أبي زيدون ، قال : حدثنا محمد بن يوسف ، قال : حدثنا ثمة بن لفافة أبو عبد الله العكي ، قال : نزل بنا طاوس فأتاه عريف لنا بقرى ، فقال يا فلان أو : يا ابن فلان ! لسنا نأكل من طعامك ، قال : لم ، قال : لأنك عريف تأكل السحت .(@)(@@)(@@)(@@) $ * وأبو عبد الله جعفر بن عبد الله الأسدي .(@)(@@)(@@)(@@) $ * [ وأبو عبد الله جعفر بن محمد بن علي بن 
ms413	 الحسين بن علي بن أبي طالب عليه السلام ] .(@)(@@)(@@)(@@) $ * وأبو عبد الله جعفر بن زياد الأحمر .(@)(@@)(@@)(@@) $ * وأبو عبد الله جعفر بن برقان .(@)(@@)(@@)(@@) $ * وأبو عبد الله جعفر بن سليمان الهاشمي . PageV02P813(@)(@@) سمعت زكريا بن خلاد أبو يعلى الساجي ، قال : سمعت عبد الملك بن قريب الأصمعي ، يقول : كان جعفر بن سليمان يكنى أبا عبد الله .(@)(@@) 1418 - حدثني سليمان بن سيف ، وعبد الرحمن بن يحيى ، قالا : حدثنا محمد بن سليمان ، قال : حدثنا أبو عبد الله جعفر بن برقان ، قال : حدثنا يزيد بن صهيب الفقير ، قال : سمعت ابن عمر ، يقول : نهى رسول الله [ صلى الله عليه وسلم ] عن نبيذ الجر ، والدباء ، والظروف المزفتة ، والنقير .(@)(@@)(@@)(@@) $ * وأبو عبد الله جرير بن عبد الحميد الضبي .(@)(@@)(@@)(@@) $ * وأبو عبد الله جنيد الفلسطيني ، عكرمة بن عمار عنه .(@)(@@)(@@)(@@) $ * وأبو عبد الله جنيد الحجام كوفي .(@)(@@) 1419 - أخبرني أبو عبد الرحمن النسائي ، قال : أنبأ قتيبة بن سعيد ، قال : سمعت جرير بن عبد الحميد ، يقول : قال لي عبد الله بن المبارك : يا أبا عبد الله ! رجل المصرين البصرة والكوفة ، وكيع بن الجراح .(@)(@@) 1420 - حدثنا محمد بن بشار ، قال : حدثنا عبد الرحمن بن مهدي ، قال : حدثنا عكرمة بن عمار ، عن جنيد أبي عبد الله الفلسطيني ، قال : حدثني عبد العزيز بن أخي حذيفة ، عن حذيفة قال : أول ما تفقدون من دينكم الخشوع ، وآخر ما تفقدون الصلاة ، موقوف .(@)(@@) وأخبرني أحمد بن شعيب ، قال : أنبأ قتيبة بن سعيد ، قال : حدثنا جنيد أبو عبد الله الحجام ، قال : حدثنا زيد ، عن عكرمة ، عن ابن عباس . PageV02P814 [ قال ] : حدثنا العباس بن محمد ، قال : سمعت يحيى بن معين ، يقول : أبو عبد الله الجدلي ، ليس بمتروك .(@)(@@)(@@)(@@) $ * وأبو عبد الله الحسن بن عمران العسقلاني ، [ يقول ] : روى عنه شعبة بن الحجام .(@)(@@)(@@)(@@) $ * وأبو عبد الله الحسن بن صالح بن حي .(@)(@@)(@@)(@@) $ * وأبو عبد الله الحسن بن أيوب الحضرمي ، عصام بن خالد عنه .(@)(@@)(@@)(@@) $ * وأبو عبد الله حمير بن بشير ، يروي عن : معقل بن يسار ، يحدث عنه : المثنى بن عوف .(@)(@@)(@@)(@@) $ * وأبو عبد الله حميد ، يحدث عن : سعد بن أوس ، يروي عنه : سهل 
ms414	 بن حماد أبو عتاب .(@)(@@)(@@)(@@) $ * وأبو عبد الله حماد الخياط ، يروي عنه : أحمد بن حنبل .(@)(@@)(@@)(@@) $ * وأبو عبد الله حسين بن علي الجعفي .(@)(@@)(@@)(@@) $ * وأبو عبد الله حسين بن الحسن .(@)(@@)(@@)(@@) $ * وأبو عبد الله حسين بن زيد الكوفي .(@)(@@)(@@)(@@) $ * وأبو عبد الله الحكم بن عتيبة .(@)(@@)(@@)(@@) $ * وأبو عبد الله الحكم بن عبد الله بن سعد الأيلي ، يكتب حديثه .(@)(@@) حدثنا إبراهيم بن يعقوب ، قال : حدثني إسحاق بن بهرام الكوسج ، عن أبي نعيم ، قال : أبو عبد الله حسن بن صالح [ بن صالح ] بن مسلم بن حي ، وحي : لقب . PageV02P815(@)(@@) 1421 - حدثنا أحمد بن شعيب ، قال : أخبرنا قتيبة بن سعيد ، قال : حدثنا أبو عبد الله ( 2 / 55 ) حماد الخياط ، عن محمد بن هلال ، عن أبيه ، عن أبي هريرة ، قال : كان يمين رسول الله [ صلى الله عليه وسلم ] لا ، وأستغفر الله .(@)(@@) 1422 - حدثنا عمران بن بكار بن راشد البراد ، قال : حدثنا عصام بن خالد قال : حدثنا أبو عبد الله الحسن بن أيوب الحضرمي ، قال : إن أبا عبد الله ابن بسر ، كان شامة في قرنه ، فوضعت أصبعي عليها ، فقال : وضع رسول الله [ صلى الله عليه وسلم ] أصبعه عليها ، وقال : لتبلغن قرنا ، وكان ذاجمة . (@)(@@) 1423 - حدثنا أبو شيبة بن أبي بكر بن أبي شيبة ، قال : حدثنا بكر بن عبد الرحمن بن محمد بن عبد الرحمن بن أبي ليلى القاضي ، قال : حدثنا عيسى بن المختار ، عن محمد بن عبد الرحمن بن أبي ليلى ، عن حميد أبي عبد الله ، عن أبي سلمة بن عبد الرحمن بن عوف ، عن أبيه ، عن رسول الله [ صلى الله عليه وسلم ] ، قال : رأيته يسجد في : @QB@ إذا السماء انشقت @QE@ عشر مرات .(@)(@@) أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : الحكم بن عتيبة كنيته أبو عبد الله .(@)(@@) 1424 - حدثنا أبو بكر بن أبي الدنيا ، قال : حدثنا أحمد بن إبراهيم ، عن سيار بن حاتم ، عن عمران بن خالد الخزاعي ، قال : رأيت حسان بن أبي ساسان ، وحوشب التقيا ، فقال حوشب لحسان : كيف أنت يا أبا عبد الله ! PageV02P816 كيف حالك 
ms415	 ؟ قال : ما حال من يموت ، ثم يبعث ، ثم يحاسب ، قال : وشهدتهما يوما ، قد التقيا ، فقال له حوشب : كيف أصبحت يا أبا عبد الله ؟ قال : أصبحت قريبا أجلي ، بعيدا أملي ، سيئا عملي .(@)(@@) قال البخاري : قال محمد بن أبان البلخي : قال وكيع : كان الحكم بن عتيبة مولى لكندة .(@)(@@) قال البخاري : قال معقل بن عبيد الله : كنية الحكم أبو محمد ، وقال سفيان بن عيينة : أبو عبد الله .(@)(@@) وقال أبو موسى محمد بن المثنى : سألت حسين بن حسن ، قلت : يا أبا عبد الله ! من كان أحفظكم زمن ابن عون ، قال : أزهر يعني السمان .(@)(@@)(@@)(@@) $ * وأبو عبد الله خالد بن معدان .(@)(@@)(@@)(@@) $ * وأبو عبد الله خالد الزيات .(@)(@@)(@@)(@@) $ * وأبو عبد الله خويل .(@)(@@) 1425 - حدثنا معاوية بن صالح الأشعري ، قال : حدثنا منصور بن أبي مزاحم ، قال : حدثنا خالد الزيات أبو عبد الله ، قال : رأيت على الشعبي مطرف خز أصفر .(@)(@@) 1426 - أنبأ علي بن حسن بن حرب ، قال : حدثنا زيد بن أخزم ، قال : حدثنا أبو داود ، قال أخبرنا خويل [ أبو عبد الله ] ، قال : حدثنا داود بن PageV02P817 أبي هند ، عن سعيد بن جبير ، قال : قلت لابن عباس : ما تقول في متعة النساء فقد أكثر الناس فيها حتى قال فيها الشاعر ؟ قال : وما قال فيها الشاعر ؟ قلت : قال الشاعر :(@)(@@) % قد قلت للشيخ لما طال محسبه % % يا صاح هل لك في فتيا بن عباس %(@)(@@) % هل لك في رخصة الأطراف آنسه % % تكون مثواك حين يصد الناس %(@)(@@) قال : وقد قيل الشعر ؟ قلت : نعم ، فكرهها ، ونهى عنها .(@)(@@)(@@)(@@) $ * وأبو عبد الله القراظ [ و ] اسمه دينار .(@)(@@)(@@)(@@) $ * وأبو عبد الله رزيق ، روى عنه : أرطأة بن المنذر .(@)(@@)(@@)(@@) $ * وأبو عبد الله ربيع بن أبي راشد .(@)(@@) 1427 - أخبرني أحمد بن شعيب ، قال : أنبأ علي بن حجر ، قال : حدثنا إسماعيل ، عن أرطأة بن المنذر ، عن رزيق أبي عبد الله ، قال : قال ابن الأسود : لا تخطين رقاب الناس يوم الجمعة ، فيجعلك الله لهم جسرا يوم القيامة .(@)(@@) قال مالك بن مغول : قلت لربيع بن راشد يا أبا عبد الله ( 2 / 56 ) .(@)(@@)(@@)(@@) $ * وأبو عبد الله زيد 
ms416	 بن المبارك الصنعاني .(@)(@@)(@@)(@@) $ * وأبو عبد الله زنفل بن عبد الله العرفي .(@)(@@) حدثنا موسى بن سهل ، وعبد العزيز بن منيب ، عن زيد بن المبارك الصنعاني الخراز أبو عبد الله . PageV02P818(@)(@@)(@@)(@@) $ * [ و ] أبو عبد الله ، ويقال : أبو عمر : سالم بن عبد الله بن عمر بن الخطاب .(@)(@@)(@@)(@@) $ * وأبو عبد الله سالم البراد ، روى عنه إسماعيل بن أبي خالد .(@)(@@)(@@)(@@) $ * وأبو عبد الله سالم سبلان .(@)(@@)(@@)(@@) $ * وأبو عبد الله سالم مولى شداد ، يروي عنه : بكير بن الأشج .(@)(@@)(@@)(@@) $ * وأبو عبد الله سليمان المدني ، عن : عبد الله بن دينار ، يحدث عنه : المعتمر بن سليمان .(@)(@@)(@@)(@@) $ * وأبو عبد الله سليمان بن أبي المغيرة .(@)(@@)(@@)(@@) $ * وأبو عبد الله سليم بن أخضر ، يروي عن : ابن عون .(@)(@@)(@@)(@@) $ * وأبو عبد الله سلمة بن الفضل الرازي .(@)(@@)(@@)(@@) $ * وأبو عبد الله سلمة بن تمام الشقر ، شعبة عنه .(@)(@@)(@@)(@@) $ * وأبو عبد الله سليمان الأغر .(@)(@@)(@@)(@@) $ * وأبو عبد الله سليمان ، صلى خلف ابن الزبير .(@)(@@)(@@)(@@) $ * وأبو عبد الله سعيد بن صبير السكسكي ، وكان قديما في الخير ، صفوان بن عمرو السكسكي ، عن رجل عنه .(@)(@@)(@@)(@@) $ * وأبو عبد الله سعيد بن جبير ، قتله الحجاج .(@)(@@)(@@)(@@) $ * وأبو عبد الله سفيان بن سعيد الثوري .(@)(@@)(@@)(@@) $ * وأبو عبد الله سفيان بن عبد الملك ، صاحب ابن المبارك .(@)(@@)(@@)(@@) $ * وأبو عبد الله سهل بن يوسف .(@)(@@) 1428 - حدثنا محمد بن منصور الجواز ، قال : حدثنا سفيان بن عيينة ، قال : حدثنا أبو عبد الله العبسي سليمان بن أبي المغيرة ، عن ابن أبي نعم ، عن أبي سعيد الخدري ، قال : ما يقبل من الحصى رفع . PageV02P819(@)(@@) 1429 - أخبرني أحمد بن شعيب ، قال : أنبأ سويد بن نصر ، قال : أنبأ عبد الله ، عن إسماعيل بن أبي خالد ، عن أبي عبد الله سالم ، قال : سمعت ابن عمر ، يقول : قال رسول الله [ صلى الله عليه وسلم ] : من صلى على جنازة ، فله قيراط ، قلنا له مثل قراريطنا هذه ؟ قال : لا مثل أحد .(@)(@@) 1430 - أخبرني أحمد بن شعيب ، قال : أنبأ الحسين بن حريث ، قال أنبأ الفضل بن موسى ، عن جعيد بن عبد الرحمن ، قال : أخبرني عبد الملك بن مروان بن الحارث بن أبي ذباب ، قال : أخبرني أبو 
ms417	 عبد الله سالم سبلان ، قال : وكانت عائشة تستعجب بأمانته وتستأجره [ قال ] : فأرتني كيف كان رسول الله [ صلى الله عليه وسلم ] يتوضأ ، قال : فتمضمضت ثلاثا ، واستنثرت ثلاثا ، وغسلت وجهها ثلاثا ، وغسلت يدها اليمنى ثلاثا ، ويدها اليسرى ثلاثا ، ومسحت رأسها واحدة إلى مؤخره ، ثم أمرت يدها بأذنيها ، ثم أمرت على الخدين .(@)(@@) 1431 - أخبرنا أحمد بن شعيب ، قال : أنبأ أبو بكر بن نافع ، قال : أنبأ المعتمر بن سليمان ، قال : حدثني سليمان أبو عبد الله المديني ، عن عبد الله بن دينار ، عن ابن عمر ، قال : قال نبي الله [ صلى الله عليه وسلم ] : إن PageV02P820 الله [ عز وجل ] لا يجمع أمتي [ أو قال ] : أمة محمد على ضلالة ، ويدا لله على الجماعة ، وإنه من شذ شذ في النار .(@)(@@) قال أبو عبد الرحمن : هذا حديث منكر .(@)(@@) أخبرني عبد الله بن أحمد بن حنبل ، قال : سمعت أبي ، قال : وأبو عبد الله الشقري سلمة بن تمام ، وليس هو قوي في الحديث .(@)(@@) سمعت العباس ، عن يحيى قال : أبو عبد الله الشقري سلمة بن تمام ، وهو ثقة .(@)(@@) 1432 - حدثني محمد بن يعقوب الفرجي ، قال : حدثنا عمرو بن علي ، قال : حدثنا يزيد بن زريع ، قال : حدثنا هشام بن أبي عبد الله ، وما كنت أدري ما اسم أبيه ، حتى زعم هؤلاء الصبيان أنه هشام بن سنبر .(@)(@@) 1433 - حدثنا محمد بن بشار ، قال : حدثنا عبد الرحمن بن مهدي ، قال : حدثنا شعبة ، عن أدهم السدوسي ، قال : سمعت سلمان أبا عبد الله ، قال : صليت خلف ابن الزبير ، فقرأ : ^ ( فقد كذب الكافرون فسوف يكون لزاما ) ^ .(@)(@@) قال البخاري : الأغر أبو عبد الله اسمه سلمان ، يروي عنه : الزهري ، وأبو بكر ( 2 / 57 ) ابن عمرو بن حزم ، ومحمد بن عمرو بن علقمة ، والوليد بن PageV02P821 رباح ، وعبد الله بن دينار ، ويحيى بن أبي إسحاق ، وسعد بن إبراهيم وغيرهم .(@)(@@) حدثنا محمد بن منصور الجواز ، قال : حدثنا يحيى بن [ أبي ] الحجاج البصري ، قال : حدثنا عبد الله بن مسلم بن هرمز المكي ، أن رجلا سأل سعيد بن جبير ، فقال : يا أبا عبد الله .(@)(@@) 1434 - حدثنا 
ms418	 أحمد بن عبد الجبار التميمي أبو عمرو ، قال : حدثنا أبو بكر ابن عياش ، عن أبي حصين ، قال : رأيت سعيد بن جبير يصلي في بيته فقلت : يا أبا عبد الله ! تصلي في بيتك ، وتدع المسجد ، قال : إني أكره أن أدع بيتي قبرا .(@)(@@)(@@)(@@) $ * وأبو عبد الله شعيب بن راشد .(@)(@@)(@@)(@@) $ * وأبو عبد الله شريك بن عبد الله القاضي .(@)(@@) 1435 - حدثنا معاوية بن صالح الأشعري ، قال : حدثنا منصور بن أبي مزاحم ، قال : حدثنا شعيب بن راشد أبو عبد الله ، عن أبي فزارة ، عن مطرف بن عبد الله بن الشخير ، قال : لما افتتح علي البصرة ، ودخل عمار بن ياسر دارا من دورها ، فبال فتوضأ ، ومسح على خفيه .(@)(@@) سمعت العباس بن محمد ، قال : سمعت يحيى [ بن معين ] ، يقول : حدثني منجاب بن الحارث [ قال : ] ، قال رجل لشريك بن عبد الله [ كيف تجدك ، قال : أجدني شاكيا ، غير شاك لله .(@)(@@) قال العباس : وحدثنا يحيى ، قال : حدثنا عباد بن العوام ، قال : أخبرنا PageV02P822 شريك بن عبد الله ] بن سنان .(@)(@@) قال يحيى : وهو شريك بن عبد الله القاضي ، أبو عبد الله .(@)(@@)(@@)(@@) $ * وأبو عبد الله ضمرة بن ربيعة الرملي .(@)(@@)(@@)(@@) $ * وأبو عبد الله طلحة بن عبد الله [ بن عوف .(@)(@@)(@@)(@@) $ * وأبو عبد الله طلحة بن مصرف .(@)(@@) 1436 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : طلحة بن مصرف أبو عبد الله ] ، وصاحبه زبيد اليامي ، كان طلحة عثمانيا ، وكان زبيد علويا ، وكانا جميعا مختلفين ، ولقبهما واحد ، وطلحة أكبرهما سنا .(@)(@@)(@@)(@@) $ * [ وأبو عبد الله عبد الرحمن بن عسيلة الصنابحي ] .(@)(@@)(@@)(@@) $ * وأبو عبد الله عبد الرحمن بن عائذ الأزدي الحمصي .(@)(@@)(@@)(@@) $ * وأبو عبد الله عبد الرحمن الأعمى ، يروي عنه : ابن جابر .(@)(@@)(@@)(@@) $ * وأبو عبد الله الجدلي ، [ و ] اسمه عبد الرحمن ، وقد قيل : عبد بن عبد الجدلي ، يروي عن : معاوية .(@)(@@)(@@)(@@) $ * وأبو عبد الله عبد الرحمن بن ثابت بن ثوبان .(@)(@@)(@@)(@@) $ * [ وأبو عبد الله عبد الرحيم بن سليمان ] .(@)(@@)(@@)(@@) $ * وأبو عبد الله عبد العزيز بن عبد الله بن أبي سلمة الماجشون .(@)(@@)(@@)(@@) $ * وأبو عبد الله عبيدة الحذاء . PageV02P823(@)(@@)(@@)(@@) $ * وأبو عبد الله عبد الصمد 
ms419	 [ بن مردويه ] الصائغ .(@)(@@)(@@)(@@) $ * [ وأبو عبد الله عبد الملك بن أبي سليمان .(@)(@@)(@@)(@@) $ * وأبو عبد الله عبد الملك بن إبراهيم الجدي .(@)(@@)(@@)(@@) $ * وأبو عبد الله عبد الله بن عتبة بن مسعود ] .(@)(@@) 1437 - أنبأ سليمان بن سيف أبو داود الحراني ، قال : حدثنا سعيد ابن بزيع ، عن ابن إسحاق ، قال : حدثني يزيد بن أبي حبيب ، عن مرثد بن عبد الله ، عن أبي عبد الله عبد الرحمن بن عسيلة الصنابحي ، عن عبادة بن الصامت ، قال : كنت ممن حضر العقبة الأولى ، قال : فكنا اثني عشر رجلا ، فبايعنا رسول الله [ صلى الله عليه وسلم ] .(@)(@@) سمعت العباس بن محمد ، يقول : سمعت يحيى [ بن معين ] يقول : الصنابحي عبد الرحمن بن عسيلة ، كنيته أبو عبد الله .(@)(@@) 1438 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : أبو عبد الله الجدلي أدرك أبا بكر ، ومن بعده شهد مع علي كل شيء ، هلك في فتنة ابن الزبير .(@)(@@) أخبرني عبد الله بن أحمد بن حنبل ، قال : سألت يحيى بن معين ، عن اسم أبي عبد الله الجدلي ، فقال : يقال عبد بن عبد . PageV02P824(@)(@@) حدثنا عمران بن بكار ، قال : حدثنا عصام بن خالد ، قال : ثنا أبو عبد الله عبد الرحمن بن ثابت بن ثوبان .(@)(@@) 1439 - أخبرنا أحمد بن شعيب ، قال : أنبأ أبو بكر بن علي ، قال : حدثنا أبو عبد الله عبد الصمد بن مردويه الصائغ ، قال : سمعت فضيل بن عياض ، يقول : قال لي ابن المبارك : ما أعياني شيء كما أعياني أن لا أجد أخا في الله .(@)(@@) وأخبرني أبو عبد الرحمن ، قال : أنبأ العباس بن عبد العظيم ، قال : عبيدة الحذاء أبو عبد الله هكذا أخبرني ابن ابنه ، وهو أيضا عبيدة .(@)(@@)(@@)(@@) $ * وأبو عبد الله عمرو بن ميمون الأودي .(@)(@@)(@@)(@@) $ * وأبو عبد الله عمرو بن ميمون بن مهران .(@)(@@)(@@)(@@) $ * [ وأبو عبد الله عمرو بن مرة .(@)(@@)(@@)(@@) $ * وأبو عبد الله عمرو بن قيس الملائي .(@)(@@)(@@)(@@) $ * وأبو عبد الله عمران بن يزيد .(@)(@@) 1440 - أخبرني محمد بن إبراهيم بن هاشم ، عن أبيه ، عن محمد بن عمر ، قال : ] عمرو بن مرة الجملي أبو عبد 
ms420	 الله ، لقي عبد الله بن سلمة المرادي ، وعبد الله بن الحارث البكري ، وهما من أصحاب علي وعبد الله ، PageV02P825 ولقي ( 2 / 58 ) إبراهيم ، وسعيد بن جبير ، وكان يعرف بالتشيع ، ثم صار بعد ذلك مرجئا ، وكان قد أخذ في القصص أيضا .(@)(@@)(@@)(@@) $ * وأبو عبد الله عمرو بن أيوب البزاز .(@)(@@)(@@)(@@) $ * وأبو عبد الله عمار [ بن أبي عمار مولى بني هاشم ] .(@)(@@) حدثني صالح بن أحمد ، قال : حدثنا علي ، قال : سمعت يحيى قال : عمرو بن مرة أبو عبد الله .(@)(@@) 1441 - أخبرني أحمد بن شعيب ، قال : أخبرني أبو بكر بن علي ، قال : حدثنا عمرو بن أيوب البزاز أبو عبد الله ، قال : حدثنا شريك ، عن أبي إسحاق ، عن شمر ، قال : اشترى مني ابن عمر قباء ديباج بثلاثمائة درهم ، وذكر أنه للتجارة .(@)(@@) 1442 - حدثنا محمد بن بشار ، قال : حدثنا أبو المساور ، قال : حدثنا عوف ، قال : حدثني عمار أبو عبد الله مولى بني هاشم ، قال : كنت بالمدينة زمن ماتت أم كلثوم بنت علي ، وابنها زيد بن عمر ماتا جميعا فجيء بجنازتيهما [ جميعا ] ، فوضع الرجل مما يلي الإمام ، ووضعت المرأة أمام ذلك .(@)(@@)(@@)(@@) $ * وأبو عبد الله عكرمة مولى ابن عباس .(@)(@@)(@@)(@@) $ * وأبو عبد الله عكرمة بن إبراهيم الأزدي .(@)(@@)(@@)(@@) $ * وأبو عبد الله عثمان بن سعيد المري ، يروي عن : مسعر .(@)(@@)(@@)(@@) $ * وأبو عبد الله عثمان بن معاوية ، يروي عن : ثابت ، عن أنس حديث خرافة ، يحدث عنه : عاصم بن علي بن عاصم . PageV02P826(@)(@@)(@@)(@@) $ * وأبو عبد الله عباس الجشمي .(@)(@@)(@@)(@@) $ * وأبو عبد الله عروة بن الزبير بن العوام .(@)(@@)(@@)(@@) $ * [ وأبو عبد الله المزني ] .(@)(@@) 1443 - أخبرني أحمد بن شعيب ، قال : أنبأ عبد الوارث بن عبد الصمد ، قال : حدثني أبي ، قال : حدثنا سعيد الجريري ، عن عباس أبي عبد الله الجشمي ، قال : حدثنا جندب ، قال : قال رسول الله [ صلى الله عليه وسلم ] : إن الله خلق مائة رحمة ، فأنزل رحمة يتعاطف بها الخلائق جنها وإنسها وبهائمها ، وعنده تسعة وتسعون ، مختصر .(@)(@@) 1444 - أخبرني أحمد بن شعيب ، قال : أنبأ محمد بن عقيل ، قال : أنبأ علي بن الحسين ، قال : حدثني أبي ، عن يزيد ، قال : كنت قاعدا عند عكرمة 