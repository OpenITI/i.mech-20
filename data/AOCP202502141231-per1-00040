ms21	 است نهان، که در نهان می سوزد %~% می میرم از آن باد، که نامش دم توست!(@)(@@) (@@) زان، راز تو بر زبان نرانم که مرا %~% چون شمع، زسوز دل زبان می سوزد(@)(@@)(@@)(@@) | اثیر اخسیکتی(@)(@@) ~~20 چون شمع، تن خود به گداز آوردم وز رخ، لگنی زود فراز آوردم(@)(@@) (@@) یروانه، زفراش رسول آمد و گفت: %~% ای سوخته، سربنه که گاز آوردم!(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 20 ای شمع، زسوزش منت نیست خبر %~% گریان تونه ای، من از توام گریان تر(@)(@@) (@@) با اینهمه، فرق است میان من وتو %~% کز گریه، تو فربه شوی و، من لاغر!(@)(@@) ملک فخرالدین مبارک شاه(@)(@@) ~~204 گفتم که: بسوخت این دل دیوانه داری خبر از واقعهآ او یا نه؟(@)(@@) (@@) خندید که: آخر چه خبر دارد شمع %~% از سوختن و فتادن پروانه!(@)(@@) کمال الدین مراغه ای(@)(@@) ~~205 عشقت، سر من به باد برداد چوشمع واشکم، زره دو دیده بگشاد چوشمع(@)(@@) ~~از بس که برآمد از دلم دود غمتدر رشتهآ جانم، آتش افتاد چو شمع PageV01P135(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0139.jpg)(@)(@)(@@)(@@)(@@) | خطیر ابوزید(@)(@@) (@@) 2007 ای شمع، تویی که دامن ترداری %~% زآن، دشمن جان خویش در برداری(@)(@@) (@@) در سر داری، که بر سر افسر داری %~% هم در سر آن شوی، که در سر داری!(@)(@@)(@@)(@@) | شمس اسعد گنجه ای(@)(@@) (@@) 208 ای شمع، چو من سوخته و مهجوری %~% وز دست فراق، خسته و رنجوری(@)(@@) (@@) زین غصه، که می گدازدت آتش دل 209 ای شمع، که جسم ناتوان می داری %~%(@)(@@) وله %~% گر زآنکه به خود فرو روی، معذوری %~% سردل خویشتن، عیان می داری(@)(@@) (@@) خورد همه، از سوی دهان است و، تورا %~% آن چیزخورد، که در دهان می داری(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 210 شمعم، که چو خود را به غمت پردازم %~% درپای تو، سر خنده زنان اندازم(@)(@@) (@@) در راه تو، هرگه که سری در بازم %~% وله %~% در حال، سری دگر زجان برسازم(@)(@@) ~~تا باتو کنم روشن و، برگویم راست 211 یک روز، شبی چو شمع برخواهم(@)(@@) خاست %~% ور نیز، زبانم زکسان باید خواست 
ms22	 %~% چون آتش و آب، سرگذشتی که مراست(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 212 ای شمع، زگریه هر دمی گرم شوی %~% در گریه مزن خنده، که بیشرم شوی(@)(@@) (@@) نرمی چه کنی چوزر، که آتش بینی %~% اوله %~% شمعی تو، نه شاهد که به زرنرم شوی!(@)(@@) ~~213 ای شمع، سرشک تو عجب گرمرو است بر عشق کهن، هر نفست گریه نو است(@)(@@) (@@) در صبح مکش زبان و، درتاب مشو %~% کز خندهآ او، سرت به بادی گرو است(@)(@@)(@@)(@@) | شمس سجاسی(@)(@@) (@@) 21 ای شمع، خرد گرت گزیند چه بود؟ %~% وردیده جهان را به تو بیند، چه بود؟(@)(@@) (@@) سوز دلم، زسوزخود دم چه زنی %~% سوزی که به بادی بنشیند، چه بود؟(@)(@)PageV01P136(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0140.jpg)(@)(@)(@@) (@@) 21 آنها، که در آرزوی جانان میرند %~% وله %~% گریان زپی وصل، به هجران میرند(@)(@@) (@@) عشق از گل و شمع شان بباید آموخت %~% کز غصه خورند خون و، گریان میرند!(@)(@@)(@@)(@@) | بدر تفلیسی(@)(@@) (@@) 21 شمعم، که به هیچ جای مسکن نکنم %~% تا، حال دل خویش معین نکنم(@)(@@) (@@) احوال دلم، بر همه پوشیده بود %~% تا، من به زبان خویش روشن نکنم(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 21 پروانه شدم زمهرت، ای مهر گسل %~% کز وصل توام، سوختن آمد حاصل(@)(@@) (@@) چون شمع من از دست تو، ای شمع چگل %~% شبخیزو شکسته رنگم و، تافته دل(@)(@@)(@@)(@@) | شیخ اوحد کرمانی(@)(@@) (@@) 21 آن شاهد معنوی، که جانم تن اوست %~% جان در بر من [زا صورت روشن اوست(@)(@@) (@@) وان روی نکو، که شاهدش می خوانی %~% اوله %~% آن شاهد نیست، لیکن آن مسکن اوست(@)(@@) (@@) 21 گر عشق مرا با تو مجازی نبود %~% این عشق و سماع ما به بازی نبود(@)(@@) (@@) هرجا، که دو اهل دل به هم بنشینند %~% شاهد بود(؟) ولیک بازی نبود(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 22 از شاهد دل، چوما نشانی بدهیم %~% خود را زغم جهان امانی بدهیم(@)(@@) (@@) تو، از نظری به غسل محتاج شوی %~% ما، از نظری غسل جهانی بدهیم(@)(@@)(@@)(@@) | شیخ شهاب الدین مقتول(@)(@@) (@@) 22 هر گه، که نظر از سر سودات افتد %~% لاشک، حرکتهای نه برجات افتد(@)(@@) (@@) گر بر 
ms23	 سر نفس خویشتن پای نهی %~% هرجای که شاهدی است، درپات افتد(@)(@@)(@@)(@@) | جمال حاجی شروانی(@)(@@) ~~22 آنم، که همه ساله به شاهد سازم در پردهآ عشق، پرده شاهد سازم(@)(@@) (@@) می طعنه زنی مرا، که شاهد بازی %~% شاهد بازم، ولیک شاهد یازم(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2 هر دل که نه عاشق است، ایمانش نیست %~% هرجان که نه آن می طلبد، جانش نیست(@)(@@) ~~این مجلس ما، اگرچه با عیش و صفاستبی آینهآ خوش پسری، آنش نیست PageV01P137(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0141.jpg)(@)(@)(@@) باب سوم - شمع وشاهد(@)(@@) عزیز علی شروانی(@)(@@) ~~224 جایی، که ازین شکرلبی مهوش نیست یادش مکن ای دوست، که چندان خوش نیست(@)(@@) ~~ر گردیدم گرد خوشیهای جهان فی الجمله، جهان بی پسری خوش، خوش نیست PageV01P138(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0142.jpg)(@)(@)(@@)(@@)(@@) | باب چهارم(@)(@@)(@@)(@@) | درخمریات(@)(@@)(@@)(@@) | وآن دونمط است(@)(@@)(@@)(@@) | نمط اول(@)(@@)(@@)(@@) | درشراب(@)(@@) ~~شمس الدین الیاس میدانی(@)(@@) (@@) 22 آنی، که به طبع آتش نابش خوانند نیراب جهان است، بر هر عاقل %~%(@)(@@) وله %~% مردم، زسر جهل شرابش خوانند %~% نه، نه غلطم، روح مذابش خوانند(@)(@@) (@@) 22 یک جرعه از آن بادهآ گلگون به دمی %~% در کش، چه کشی هزار من خون به دمی(@)(@@) ~~کان عقل، که بر کمیت می گشت سوار زان سوی جهان، برد شبیخون به دمی(@)(@@)(@@)(@@) | سراج قمری(@)(@@) (@@) 22 قرآن، که بهین کلام خوانند او را . %~% جاجای، نه بر دوام خوانند او را(@)(@@) (@@) در خط پیاله، آیتی هست زلطف %~% کاندر همه جا، مدام خوانند او را(@)(@@)(@@)(@@) | شیخ احمد غزالی(@)(@@) ~~(22 زان باده، که جان عقل ازویافت کمالپیش آور جانا، قدحی مالامال(@)(@@) (@@) مستم کن و، گو حرام باشد نه حلال %~% تا نیست شوم، که هستیم هست وبال PageV01P139(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0143.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 229 چون، دل زلب لعل تو بردارم شب %~% غمهای تو را، به باده بگسارم شب(@)(@@) (@@) باده، به خوشی کجا بود چون لب تو %~% لیکن، به بهانهای به روز آرم شب!(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 230 آنها، که بنای زهد بر زرق نهند %~% آیند و، میان من ومی فرق نهند(@)(@@) (@@) بر فرق نهم، خروس می راپس ازین %~% گو همچو 
ms24	 خروسم، اره بر فرق نهند(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 231 بی مطرب، اگر به عزم می برخیزی %~% یا بی رخ شاهدی، درو آو یزی(@)(@@) (@@) انگار که از قنینهای یا زخمی %~% وله %~% آن می، به پیاله در سبو می ریزی!(@)(@@) (@@) 232 عاقل، ز می ناب چرا پرهیزد %~% کو، با تن هر کسی چو روح آمیزد(@)(@@) (@@) بادی است، که گرد غم ازو بگریزد %~% آبی است، که آتش نشاط انگیزد(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) (@@) 233 کو مطرب و می تا بدهم داد صبوح %~% خوش بر طربی نهیم بنیاد صبوح(@)(@@) (@@) ما را به جهان سه چیز خوش می آید: %~% سر مستی و، عاشقی و، فریاد صبوح(@)(@@)(@@)(@@) | ظهیر(@)(@@) ~~234 می را، که همیشه بر خرد دندان است هم اوست، که مونس خردمندان است(@)(@@) ~~می، در خم اگر چه سر گرفتهست، رواست در شیشه نگر، چه خرم و خندان است!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 239 در ده می لعل لاله گون صافی %~% بگشای. ز حلق شیشه، خبون صافی(@)(@@) (@@) کامروز برون زجام می، نیست مرا %~% یک دوست، که دارد اندرون صافی(@)(@@)(@@)(@@) | عمر خیام(@)(@@) (@@) 236 یک جرعه می کهن، زملکی نوبه %~% وزهر چه نه می، طریق بیرون شوبه(@)(@@) (@@) درد است به از تخت فریدون، صد بار %~% خشت سر خم، زتاج کیخسرو به PageV01P140(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0144.jpg)(@)(@)(@@) (@@) 2 در دهر، چو آواز گل تازه دهند %~% اوله %~% فرمای بتا، که می به اندازه دهند(@)(@@) (@@) 238 گیرم که به اسرار معما نرسی از حور وقصور، وزبهشت و دوزخ %~% وله(@)(@@) %~% فارغ بنشین، که آن هر آوازه دهند %~% در شیوهآ عاقلان، همانا نرسی(@)(@@) (@@) از سبزه و می، خیز بهشتی برساز %~% کآنجا به بهشت یا رسی یا نرسی](@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 239 من، می نه زبهر تنگدستی نخورم %~% یا، از غم رسوایی ومستی نخورم(@)(@@) (@@) من، می زبرای خوشدلی می خوردم %~% اکنون که تو در دلم نشستی، نخورم!(@)(@@)(@@)(@@) | صدرخجندی(@)(@@) (@@) 24 یک دم ز زمانه گر مسلم یابی %~% یا نیم دمی باده دمادم یابی(@)(@@) (@@) مگذار که ضایع شود آن دم، زنهار %~% اوله %~% زیرا که چنان دمی، دگر کم 
ms25	 یابی!(@)(@@) (@@) 24 بسته ست لبت، گشاده می پنداری %~% جان بستدهای و، داده می پنداری(@)(@@) (@@) این ازهمه طرفهتر، که مسکین دل من %~% خون می خورد و، تو باده می پنداری!(@)(@@)(@@)(@@) | رشید خواری(@)(@@) (@@) 24 آن سرخی می، لعل به خروار ارزد %~% وان بوی خوشش، کلبهآ عطار ارزد(@)(@@) (@@) زان شیشه، که هوش عاقلان می ببرد %~% یک قطرهآ خون، هزار دینار ارزد(@)(@@) یمین سبط اصفهانی(@)(@@) (@@) 241 از عشق که کرد، ای دل ابله توبه %~% تا من کنم، از وصال آن مه توبه(@)(@@) (@@) شب تیره و، باده روشن و، مجلس خاص %~% من عاشق و، او حاضر و، آنگه توبه!(@)(@@)(@@)(@@) | خاقانی(@)(@@) (@@) 24 چشمم به گل است و، مرغ دستان زن وتو %~% میلم به مل است و، رطل مرد افکن وتو(@)(@@) (@@) زین پس، من وصحرا ومی روشن وتو %~% من چون تو و، توچون من و، توبی من وتو PageV01P141(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0145.jpg)(@)(@)(@@)(@@)(@@) | اثیراخسیکتی(@)(@@) (@@) 245 بشناخته ام، نبض درون دل خویش %~% آن به که به می برم، جنون دل خویش(@)(@@) ~~ناچار، چوخون دل همی باید خورد خون دل رزخورم، نه خون دل خویش!(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 246 داری ملکا، به دست بر جام شراب %~% چون ساخته، آب بسته با آتش ناب؟(@)(@@) (@@) بر داشته ای، مگر به تدبیر صواب %~% ناساختن، از میانهآ آتش و آب(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) ~~247 چون، در کف من جام غم انجام آیداز دیدهآ من، بوی می خام آید(@)(@@) (@@) هر می، که مرا زجام در کام آید %~% بر گردد و، از دو دیده در جام آید!(@)(@@)(@@)(@@) | جلال خواری(@)(@@) ~~248 یار نو و، باده کهن و، آب رواندر گوشهآ رزنشسته، در فصل خزان(@)(@@) (@@) وان بابزن مرغ در آتش گردان %~% هان سلطنت عالم و، هان ملک جهان!(@)(@@)(@@)(@@) | کمال خجندی(@)(@@) (@@) 249 نا اهل، چوخواندت مباحی، مندیش %~% ای خواجه، چه در بند صلاحی؟ مندیش(@)(@@) (@@) زان می، که لب پیاله پرخنده کند %~% می نوش، زگریهآ صراحی مندیش!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~250 اساقی، که رخش به آب و آتش ماند می در قدحش، آب در آتش راند(@)(@@) ~~نه 
ms26	 آتش می، آب قدح نیست کند نه آب قدح، آتش می بنشاند(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) (@@) 251 رحم آر، کز اندازه برون می گریم %~% وانگاه، به حیله بین که چون می گریم(@)(@@) (@@) چون شیشهآ می میان مجلس، به دروغ %~% در قهقههام، ولیک خون می گریم!(@)(@@)(@@)(@@) | پسر خطیب گنجه(@)(@@) (@@) 252 گویند: بهشت را کجا یابد مست %~% وز دوزخ آزاد که بتواند جست؟(@)(@@) (@@) گر میخواران جمله به دوزخ باشند %~% پس بنمایم بهشت را، چون کف دست!(@)(@)PageV01P142(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0146.jpg)(@)(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) کوزهآ می در آمد، آن رشک پری من، دوش به کاسهآ رباب شجری %~% گفتا(@)(@@) که: اگر کاسه زنی، کوزه خوری! %~% مستانه، ترانه ای زدم کاشغری(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) با ساغر وبا رباب، تا روز فراخ 2 من، دوش به آرزوی رویت هردم %~%(@)(@@) ریاد رخت، می زدم و می خوردم؟ %~% در رنگ گل و باده، نگه می کردم(@)(@@) ~~گفتا که: چه حالت است؟ گفتم: فریاد 2 دی، می رفتم مست و کش و خرم(@)(@@) وشاد %~% اوله %~% کان تو بهآ ما، بقای سوگند تو باد! %~% آن ماه دو هفته، پیش من باز افتاد(@)(@@) (@@) 25 دل، خوی فرا قفای غم خوردن کرد %~% وله %~% در بندگیت هر چه توان کردن، کرد(@)(@@) (@@) تا داشت رگی درتن و، خونی در رگ 251 از بهرچه عیش آشکارا نکنیم %~%(@)(@@) اوله %~% چون گل، علم نشاط برپا نکنیم؟ %~% خدمت چوصراحی به رگ گردن کرد(@)(@@) (@@) تا چند زکرد و خورد؟ یل تبا دوسه روز %~% اوله %~% جزمی نخوریم و، جزتماشا نکنیم!(@)(@@) (@@) 25 امشب، که نگارم از برای مستی %~% آمد برم، از سر هوای مستی(@)(@@) ~~دستی پر ما فکند: هم مستی نپز 24 می آمد و میرفت پیاله بر ما چون(@)(@@) چشم خروس، بس که شد در سرما %~% وله %~% خیزیم و، در افتبیم به پای مستی!(@)(@@) %~% چون تاج خروس، لعل گشت افسر ما %~% تا خون بنماند، در بر ساغر ما PageV01P143(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0147.jpg)(@)(@)(@@)(@@)(@@) | باب چهارم -خمرتات(@)(@@)(@@)(@@) | اوله(@)(@@) ~~260 اقطاع طرب، در نظر ساغر ماست سر سبزی عیش، در سر ساغر 
ms27	 ماست(@)(@@) (@@) بیم است، که از فروغ می لعل شود %~% فیروزه، که طرف کمر ساغر ماست(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 261 ماییم، نهاده سر به فرمان شراب %~% جان کرده، فدای لب خندان شراب(@)(@@) (@@) هم دست به جان آمده، از ساغر می %~% هم بر لب ساغر آمده، جان شراب!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 262 من، دوش شراب ارغوانی خوردم %~% با یار، به کام دوستگانی خوردم(@)(@@) (@@) تاریکی شب، شاهد حال است، که دوش %~% من، با خضر آب زندگانی خوردم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 23 در پنجه شدم، با قدح مرد گزای %~% تا کرد چنانم، که نجنبم ازجای(@)(@@) (@@) با ساغرباده، در کمردست که کرد %~% کو را، نه به عاقبت در آورد از پای؟(@)(@@)(@@)(@@) | اوله(@)(@@) ~~264 لب باز مگیر، یک زمان از لب جام تا بر داری کام جهان، ازلب جام(@)(@@) ~~درجام جهان، چوتلخ و شیرین به هم است این از لب یارخواه و، آن از لب جام(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 265 می ده، که دل ریش مرا مرهم اوست %~% سودا زدگان عشق را همدم اوست(@)(@@) ~~پیش دل من، خاک یکی جرعه به استاز چرخ، که کاسهآ سرعالم اوست(@)(@@)(@@)(@@) | اوله(@)(@@) ~~266 شادی زمانه، عاشق طبع من استاندیشه وغم، چه لایق طبع من است(@)(@@) (@@) زان، بی دم نای و آب انگور نیم %~% کاین آب و هوا، موافق طبع من است!(@)(@)PageV01P144(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0148.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~267 برخیره، غرور خویش پیوست مده بر باد، نبوده خرمن هست مده(@)(@@) (@@) چون نیست تورا به دست نقدی روشن %~% باری، رخ یار و باده از دست مده(@)(@@)(@@)(@@) | وله(@)(@@) (@@) امروز، پیاله کمر کین در بست 268 دی، توبهآ من زآستین بر زد دست %~%(@)(@@) اوله %~% و آمد، به قصاص توبهآ من بشکست! %~% بشکست پیاله را و، پنداشت که رست(@)(@@) (@@) 269 تاکی، ورق عمر به هم درشکنیم %~% و ین خندهآ می، در دل ساغر شکنیم(@)(@@) (@@) برخیز[وا]، پیاله را زمی پردل کن %~% تا بوک، مصاف غم به هم برشکنیم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 27 جامی که شراب ارغوانی است در او %~% آبی است، که آب زندگانی است در او(@)(@@) (@@) وان باده، 
ms28	 که ضد جان نهانی است دراو %~% پیری است، که آتش جوانی است در او!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 27 می، پنبهآ عقل هرزه گوداند کرد %~% می، چازهآ درد دل نکو داند کرد(@)(@@) (@@) تومی خور و، کارغم بدو باز گذار %~% وله %~% کاین، خدمت غم به شرط او داند کرد(@)(@@) ~~27 با ذوق لب تو، باده گرمی کوشد می دان به یقین، که خون رزمی جوشد(@)(@@) (@@) نی نی، که خود از شرم لبت دختررز %~% وله %~% رنگ آوردهست و، رخ به کف می پوشد!(@)(@@) (@@) 27 بییار، کسی که یار پنداشت تورا %~% و آسوده، دلی که خیره بگذاشت تورا(@)(@@) (@@) از بی آبی، به ساغری می مانی %~% کافتادهآ توست، هر که برداشت تورا PageV01P145(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0149.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 274 در هجر تو، من ز شمع افزون گریم %~% و آنگه، چو صراحی اشک گلگون گریم(@)(@@) (@@) چجون ساغر بادهام، که از تنگدلی %~% چون نالهآ چنگ بشنوم، خون گریم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 275 آن می، که زخون دختر رز باشد %~% در دایرهآ نشاط مرکز باشد(@)(@@) (@@) اندر شب غم، به دوست چشمم روشن %~% چون آتش غم، گر چه زبان گزباشد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 276 در خون جگر شدم عیان چون ساغر %~% بر بسته به خون خود میان، چون ساغر(@)(@@) (@@) در روی کسی، که می خورد خون دلم %~% می خندم، از میان جان چون ساغر(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 277 از حادثه ها، اگر چه دارم صد رنگ %~% وز واقعه ها، اگر چه باشم دلتنگ(@)(@@) (@@) کارم به نوا شود، چو پیدا گردد %~% رخسارهآ دختر رز، از پردهآ چنگ(@)(@@) (@@) 228 می خوردم دوش، تا کمال مستی %~% اوله %~% خواب آرزوم کرده ز حال مستی(@)(@@) (@@) آمد شدن دوست خیالم می کرد %~% یا خواب نمود، یا خیال مستی(@)(@@)(@@)(@@) | الیاس میدانی(@)(@@) (@@) 279 مطرب، دیشب کان سخن حق می رفت %~% واندریم می، عقل چوزورق می رفت(@)(@@) (@@) از ناخن چون نیش، رگ چنگ زدی %~% پس، خون روان چرا زراوق می رفت؟(@)(@@)(@@)(@@) | شیخ ابوعلی سینا(@)(@@) (@@) 280 آن آتش آب تن، که روح ثانی است %~% خون است نه خونی، چه سبب 
ms29	 زندانی است(@)(@@) (@@) آری، همه سالها به درد ارزانی است %~% تا مایهآ جان، چرا بدین ارزانی است!(@)(@)PageV01P146(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0150.jpg)(@)(@)(@@)(@@)(@@) | قطب اهری(@)(@@) ~~28 چون با همه کس فاش شد آمیختنت ای دختر رز، رواست خون ریختنت!(@)(@@) ~~نیکن، چو کسی فرو گرفتت زدرخت در شرط کرم نیست، بر آو یختنت.(@)(@@)(@@)(@@) | نمط دوم(@)(@@)(@@)(@@) | در ساقی(@)(@@) کمال الدین اصفهانی گوید(@)(@@) (@@) 38 در کارجهان، کسی چو اندیشه کند %~% از هر دو جهان، بیخردی پیشه کند(@)(@@) (@@) ز شیشه فرو ریز، می دیوانه %~% تا عقل مرا، چو دیو در شیشه کند(@)(@@) (@@) شکلی است، زنقشبندی دیباگر %~% اله %~% ابریشم چنگ و، ناخن خنیاگر(@)(@@) (@@) یناگر، از آبگینه گر لعل کند %~% عایشه %~% پس ساقی ما، نیست بجزمیناگر!(@)(@@) (@@) با بنده، گرت دل نگرانی باشد %~% از جام گران، کی اش گرانی باشد(@)(@@) (@@) کرباده، به طبع زهرقاتل گردد %~% از دست تو، آب زندگانی باشد(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 28 آن جام طرب شکار، بر دستم نه %~% و آن ساغر چون نگار، بر دستم نه(@)(@@) (@@) و آن می، که چو زنجیر بپیچد بر خود %~% دیوانه شدم، بیار بردستم نه!(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 280 زاهد نکند به زهد سود، ای ساقی %~% هر چند عیان عمل نمود، ای ساقی(@)(@@) (@@) یر کن قدحی شراب، زود ای ساقی %~% کاندر ازل آنچه بود، بود ای ساقی!(@)(@@) (@@) 287 ای ساقی خوب، جام و پیمانه کجاست؟ %~% و آن رطل حریف افکن مردانه کجاست؟(@)(@@) (@@) بیخود، به در افتادهام از میکدهای %~% ای مردم هشیار، ره خانه کجاست!(@)(@)PageV01P147(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0151.jpg)(@)(@)(@@)(@@)(@@) | اثیراخسیکتی(@)(@@) (@@) 288 مطرب، رگ چنگ را به ناخن کن رام %~% ساقی، به من سوخته ده بادهآ خام(@)(@@) (@@) ای شب، بنشین و لیک بر عارض یار %~% وی صبح، بدم ولیک از مشرق جام!(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 289 برهان زغمم، زود رهان ای ساقی %~% می ده ! مه جحیم و، مه جنان ای ساقی!(@)(@@) (@@) کاندر ره عاشقی، چه ایمان وچه کفر %~% وله %~% هستند به یک بها روان، ای ساقی!(@)(@@) ~~290 ساقی، چوبه من دهد می گلگون ر گلگون کنم از فروغ او، گردون را(@)(@@) (@@) چندان، 
ms30	 به جرع باده دهم هامون را %~% تا زیر زمین، مست کنم قارون را(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 291 افتاد زابر و آفتاب، ای ساقی %~% در زلف بنفشه پیچ و تاب، ای ساقی(@)(@@) (@@) برخاست گل خفته زخواب، ای ساقی %~% برخیز، شراب آر، شراب ای ساقی!(@)(@@)(@@)(@@) | سلطان خوارزمشاه(@)(@@) (@@) 292 ای نغمهآ تو برده دل فاخته را %~% بردار و، بساز چنگ ناساخته را(@)(@@) (@@) و آنگه، به کف عاشق مسکین برنه %~% در آب فسرده، لعل بگداخته را(@)(@@)(@@)(@@) | موفق عبدالجلیل(@)(@@) (@@) 23 حانا، به سحر وقت تماشای می است %~% برخیز، که در جان و دلم جای می است(@)(@@) (@@) چون چشم خروس، می درافکن به قدح %~% کآواز خروس، در تقاضای می است(@)(@@)(@@)(@@) | شرف صالح بیلقانی(@)(@@) ~~294 خود را، دمی از عشوه پرستان بستان(@)(@@) (@@) گرپخته حریفی، می نوشین دهد %~% اوله(@)(@@) ~~125 ا می، که خرد کفت رمستات بستان(@)(@@) ~~جامی، به تو گر سافی سرمس دهد(@)(@@)(@@)(@@) | عزیزالدین شروانی(@)(@@) ~~23 ای ساقی، از آن راح خوش روح وار PageV01P148(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0152.jpg)(@)(@)(@@)(@@)(@@) | اادری(@)(@@) ~~297 ساقی، نفتد تا قدح از دست مخسب در شیشه زمی تا اثری هست، مخسب(@)(@@) (@@) چون لاله، می لعل پیابی میده %~% بر طرف چمن چو نرگس مست مخسب PageV01P149(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0153.jpg)(@)(@)(@@)(@@)(@@) | باب پنجم(@)(@@)(@@)(@@) | درسماع(@)(@@)(@@)(@@) | و آن دو نمط است(@)(@@)(@@)(@@) | نمط اول(@)(@@)(@@)(@@) | دردف ونی(@)(@@) شیخ اوحدالدین کرمانی(@)(@@) ~~29 در عالم عشق، عقل چون مدهوشی است جان بر در دل، چوغاشیه بر دوشی است(@)(@@) (@@) از سر سماع، آن کس آگه باشد %~% کو رابه جزاین دوگوش صورت، گوشی است(@)(@@) جمال حاجی شروانی(@)(@@) ~~299 یارب، چه خوش است جان به جانان دادنوین امر روان، به امر فرمان دادن(@)(@@) (@@) جان خوش خویش را، به آسان آسان %~% جز در خوشی سماع، نتوان دادن!(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~300 ما را به جزاز رقص، تمیزی دگر است وین مصر خراب را، عزیزی دگر است(@)(@@) (@@) برجستن و، پاکوفتن و، دست زدن %~% بازی باشد، سماع چیزی دگر است!(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~30 در عالم عشق، دلر بایی چوتونیست وزروی یقین، غزلسرایی چو تونیست(@)(@@) (@@) بردار سماع ازپی دلها، 
ms31	 کامروز %~% در گلشن جان، طرب فزایی چوتونیست(@)(@@) قاضی کمال مراغهای(@)(@@) (@@) 30 این نی، که نوای زیریا بم نزند %~% کز زخمه هزار زخمه محکم نزند(@)(@@) (@@) گر نه ز شکر لبی بریدهست، چرا %~% تا، لب به لبی برننهد دم نزند؟(@)(@)PageV01P150(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0154.jpg)(@)(@)(@@)(@@)(@@) | نظامی گنجه ای(@)(@@) (@@) 302 نی گفت که: پای در گلم بود بسی %~% وانگه ببریدند سرم، در هوسی(@)(@@) (@@) نه زخم گران بخوردم، از دست خسی %~% معذورم اگر پنالم از دل، نفسی!(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 300 فریاد، که باز بوی می می شنوم %~% و آوازهآ های و هوی و هی می شنوم(@)(@@) (@@) در گوش دلم، راز بیابی بیحد %~% حق گوید، اگر چه من زنی می شنوم(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 30 نی گفت: چونیزن به لبانم گیرد %~% نه چرخ، زنه ثقبه فغانم گیرد(@)(@@) (@@) خواهم، که ز سوز سینه آهی بزنم %~% القائله %~% نیزن، به ده انگشت دهانم گیرد!(@)(@@) ~~30 نی گفت: خوشی ناله ام آن داند در مهر، که او زبان لالان داند(@)(@@) (@@) ی جرم اگر سرم بریدند، رواست %~% معشوق، زبان بی زبانان داند!(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 30 نی ناله زنان گفت: سرم ببریدند %~% چون مرغ، همه بال و پرم ببریدند(@)(@@) (@@) با این همه، اندیشهآ سر نیست مرا %~% می نالم از ان کز شکرم ببریدند!(@)(@@)(@@)(@@) | لا اعرف(@)(@@) (@@) 308 ای تن، ز فراق یار سرکش می نال %~% وی جان، توبراین حال مشوش می نال(@)(@@) (@@) وی مطرب خوش، به نغمه حالم می گو %~% وله %~% وی نی، به نیابت دلم خوش می نال(@)(@@) (@@) 30 ای نی، چه شدت که هر زمان می نالی %~% هر چشم زد، ازمیان جان می نالی(@)(@@) (@@) مانا، زشکر لبی بریدی کامروز %~% بی هیچ زبان، به صد زبان مینالی(@)(@@)(@@)(@@) | وله(@)(@@) ~~31 زین بارتوای نی، به خطا می نالی با عیش بدین خوشی، چرا می نالی؟(@)(@@) ~~لب بر لب یار و، آنگهی نالهآ زار انصاف، که از باد هوا می نالی!(@)(@@)(@@)(@@) | شمس اسعد گنجه ای(@)(@@) ~~31 ای دل،اگرت میل نواهای نی است یا در طبعت، همیشه سودای نی است(@)(@@) ~~این زخمهآ 
ms32	 خوب بین، که در چنگ و دف است وین نالهآ خوش نگر، که درنای و نی است PageV01P151(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0155.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 312 این دل، که زمحنتت جداییش مباد %~% جز با غم عشقت، آشنا ییش مباد(@)(@@) (@@) گر، نی صفت از جان نه هوای توزند %~% از چنگ تو، همچو دف رهاییش مباد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 313 تا، در هوس چهرهآ چون ماه توام %~% چون معتکفان، مجاور راه توام(@)(@@) (@@) چون دف، کم من بنده مگیر از پی آنک %~% مانند نی، از درون هوا خواه توام!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 314 عشق تو، مرا دودیده پرنم کردهست %~% بر من، در خوشدلی فراهم کردهست(@)(@@) (@@) با این همه، آن دو لعل چون شکرتو %~% با نی، به هلاک دل من دم کردهست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 315 آن وجد نبماشد، که پریشان گردی %~% نعره زنی و، چو چرخ گردان گردی(@)(@@) (@@) وجد آن باشد، که چون ببینی رخ او %~% سر در بازی، تا همه تن جان گردی!(@)(@@)(@@)(@@) | وله(@)(@@) ~~316 وخد آن نبود، کز خردت بستاند یک دم، زغم نیک و بدت بستاند(@)(@@) (@@) وجد آن باشد، که چون به خود غره شوی %~% یکبارگی، از دست خودت بستاند(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 317 وجد آن نبود، کاهل صفا را بینی %~% یا منزویان پارسا را بینی(@)(@@) (@@) وجد آن باشد، که چون زخود نیست شوی %~% در هر چه نظر کنی، خدا را بینی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 318 بوی جگر سوخته، از نی بشنو %~% هشیارنشین، سر پیاپی بشنو(@)(@@) (@@) موز دل عاشقان بی نام ونشان %~% گر می طلبی، از نفس نی بشنو(@)(@@) سیف الدین هارون تفلیسی(@)(@@) (@@) رخیز چونای، از سر عاریتی 310 ای دل، سر خود چو چنگ در پیش افکن %~%(@)(@@) مانندهآ نی، به نه دهن نعره مزن! %~% با زخم، چودف ساخته باش از همه تن PageV01P152(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0156.jpg)(@)(@)(@@)(@@)(@@) | جمال حاجی شروانی(@)(@@) ~~31 زان روز که کاینات محضر کردند هر خلق، به ذکر حق زبان تر کردند(@)(@@) (@@) اول سخن از معرفت حق، نی گفت %~% زان روی، دهانش پر ز شکر کردند!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~امروز، به رمز نی به آواز بلند 
ms33	 32 هر سر، که نهان بود میان من و او(@)(@@) %~% می گوید یک به یک، نشان من و او %~% بی واسطه گفته بود، جان من و او(@)(@@) (@@) 32 درد دل کهربا ز شنگرف شنو %~% وله %~% صرفی است درین به رمزتا صرف شنو(@)(@@) (@@) گوش دل خویش، چون محمد بگشا 3 زین نالهآ نی، قدم چونون می آید %~%(@)(@@) اوله %~% وزغتهآ او، جگربه خون می آید %~% وزغتهآ نی، کلام بی حرف شنو(@)(@@) (@@) وان سر، که نهان است درون جانم %~% مانند شکر، زنی برون می آید(@)(@@) (@@) از صورت صور و، قصهآ روز الست 3 دریاب، که نی حدیث جان می گوید %~%(@)(@@) اوله %~% با جان تو، نی به ترجمان می گوید %~% سری است زمعرفت، نهان می گوید(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 32 نی، جمله به صوت حال من می گوید %~% در غته، همه فعال من می گوید(@)(@@) (@@) امروز، زنی بدان شدم دیوانه %~% کو، راز تب و صال من می گوید(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 32 هرغنه، که بی لب و دهن گوید نی %~% گویی، همه حسب حال من گوید نی(@)(@@) (@@) ز آواز نی، این جنبش دل دانی چیست %~% با جان، به زبان جان سخن گوید نی(@)(@@) (@@) 327 وجد آن نبود، که جمع آلات شوی %~% له %~% وزعالم وهم، در مقالات شوی(@)(@@) جد آن باشد، که اندرین عاریه جای %~% شه، رخ چو نمود در زمان مات شوی(@)(@@)(@@)(@@) | اله(@)(@@) ~~328 وجد آن نبود، که بی میی مست شوی وزپای در اوفتی، و از دست شوی(@)(@@) (@@) وجد آن باشد، کزنفسی در نفسی %~% در واقعه، نیست گردی و هست شوی!(@)(@)PageV01P153(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0157.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 329 وجد آن نبود، که رقعهآ جسمانی %~% چون مهرهآ نرد، هر زمان گردانی(@)(@@) (@@) وجد آن باشد، که نقش یک برخوانی %~% وله %~% خود را، زچهار و پنج و شش برهانی(@)(@@) (@@) 330 وجد آن نبود، که هر زمان آه کنی %~% خلقی، ز تسلس خود آگاه کنی(@)(@@) (@@) وجد آن باشد، که بی همه واسطه ای %~% لبیک بود، ندا چو الله کنی(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 331 وجد آن نبود، 
ms34	 که خرقه ای پاره کنی %~% و آنگه زبرای دوختن، چاره کنی(@)(@@) (@@) وجد آن باشد، که چون تو را دریابد %~% خود، ترک وجود خویش یکباره کنی(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 332 وجد آن نبود، که هر میی نوش کنی %~% نایخته به آتش بلا، جوش کنی(@)(@@) (@@) وجد آن باشد، که هرچه ما دون حق است %~% چون یاد کنی زحق فراموش کنی(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 333 وجد آن نبود، که چرخ در سر گیری %~% چون رخش، همی دوی زبی تدبیری(@)(@@) (@@) وجد آن باشد، که چون در آید، به خدا %~% جان رشوه دهی، مگر که در وی میری(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 334 آن وجد نباشد، که زبویی بروی %~% یا از سر دست، از سر مویی بروی(@)(@@) (@@) وجد آن باشد، که چون نفس بگشایی %~% بی واسطه تا به هو، به هویی بروی(@)(@@)(@@)(@@) | معین بختیار(@)(@@) (@@) 335 نی، با دل ریش گفت و گویی دارد %~% در راه وصال، جست و جویی دارد(@)(@@) (@@) با ما، زمیان جان خوشک می نالد %~% او نیز، ز سکر عشق بویی دارد(@)(@@)(@@)(@@) | اوله(@)(@@) ~~336 نی، راز دو عالم به عیان می گوید اسرار زمین و آسمان می گوید(@)(@@) ~~در کشف حقایق، به کمال افتادهست زیرا که سخن زسرجان می گوید(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~337 نی، قصهآ کیمیای جان می گویدسری است شریف، رمز از آن می گوید(@)(@@) ~~خود، در دل پاکان صفا در ره عشقبیداست، هر آنچه نی نهان می گوید PageV01P154(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0158.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~33 نی، قصهآ درد عاشقان می گوید با مرده دلان، شرح روان می گوید(@)(@@) (@@) ای بلبل شوریدهآ جان، خفته مباش %~% نی، باز حدیث گلستان می گوید!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~این لحظه، به تازگی زنی رنجیدم 34 آن وجد نباشد، که به بازی بازی(@)(@@) 33 نی، شرح غم سوختگان می گوید %~% وله %~% اسرار نهان عاشقان می گوید %~%(@)(@@) کو راز دل از میان جان می گوید %~% خود را به ریا شیفته ای برسازی(@)(@@) (@@) وجد آن باشد، که بر سر کوی وصال %~% اوله %~% از جسم جدا شوی و، جان در بازی(@)(@@) (@@) 34 هر 
ms35	 صاحب دل، که او بر آلت باشد %~% از دم زدن خودش ملالت باشد(@)(@@) (@@) حالت، اثری است در طمأنینهٔ‌ دل %~% تاظن نبری، که رقص حالت باشد(@)(@@)(@@)(@@) | اوحدالدین کرمانی(@)(@@) (@@) 34 رقص آن نبود، که هر زمان برخیزی %~% بی درد، چو گرد از میان برخیزی(@)(@@) (@@) رقص آن باشد، که از میان برخیزی %~% اوله %~% دل خرقه کنی، ازسر جان برخیزی(@)(@@) (@@) 34 مرد آن باشد، که بی ریا رقص کند %~% از سوز دل و سر صفا رقص کند(@)(@@) (@@) آن سرو دراز است، که با دامن تر %~% وله %~% بر خیزد و، از باد هوا رقص کند(@)(@@) (@@) 34 می باید ساختن، گرت برگ صفاست %~% با نیک وبد و خرد و بزرگ از چپ و راست(@)(@@) (@@) در وقت سکون، چو خاک باید بودن %~% واندر حرکت، چو باد باید برخاست(@)(@@)(@@)(@@) | بدر الدین داود(@)(@@) ~~3،4 ای آنکه به حسن، ماه خدمتگر توستخووشید، پرستار رخ انور توست(@)(@@) (@@) آوازهآ شکر، همه از نی خیزد %~% وین طرفه، که آوازنی از شکرتوست(@)(@@)(@@)(@@) | سعد لحافی(@)(@@) (@@) 34 وجد آن نبود، رنگ زریرت باشد %~% هر لحظه، هوای بم و زیرت باشد(@)(@@) (@@) وجد آن باشد، که تا به زاری گیری %~% سر رشتهآ آنکه دستگیرت باشد PageV01P155(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0159.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~341 وجد آن نبود، چشم تو گریان گردد یک خلق، ز شور تو پریشان گردد(@)(@@) (@@) وجد آن باشد، که چون قدم برگیری %~% صحرای فلک، پیش تو میدان گردد(@)(@@)(@@)(@@) | شمس تبریزی(@)(@@) (@@) 348 وجد آن نبود، که چرخ در سر فکنی %~% صد شور ز بیخودی، به خود در فکنی(@)(@@) (@@) وجد آن باشد، که آستین همت %~% از پایهآ هفت چرخ، برتر فکنی(@)(@@) جمال نقاش اصفهانی(@)(@@) (@@) 349 آن بلبل خوش نوا، چو خاموش شود %~% امشب، زغمش تلخ تر از دوش شود(@)(@@) (@@) وان نرگس مست، باهزاران دیده %~% در وقت سماع او، همه گوش شود(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 350 ای نی، زدم تو غم پراکنده شود %~% ز آواز خوشت، چنگ سر افکنده شود(@)(@@) (@@) داری نفسی چنان، کزو گر نفسی 351 نی، دید که آن نگارغم می دهدم 
ms36	 %~%(@)(@@) اله %~% زان در تن مردهای شود زنده شود %~% در کوی وصال، راه کم می دهدم(@)(@@) (@@) مانندهآ آن یار شکر لب، او نیز %~% با آنکه زبانش نیست، دم می دهدم(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 352 ز آواز خوشت، پرده نیوشم کردی %~% هوشم بردی، باز به هوشم کردی(@)(@@) (@@) با آنکه کمم گرفته ای، همچون دف %~% همچون دف خود، حلقه به گوشم کردی(@)(@@)(@@)(@@) | اوله(@)(@@) ~~353 نی، گرزجفای دهر بیراه شدهست وز چرخ فلک، به کام بدخواه شده ست(@)(@@) ~~ینالد زار زار، مانا کاکنون از سوز درونی من، آگاه شدهست(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 354 نی، گر چو دلم از هوسی مینالد %~% گویی که زجور ناکسی می نالد(@)(@@) (@@) گر چه همگان نالهآ من می شنوند %~% وله %~% هم اوست، که با من از کسی می نالد(@)(@@) (@@) 355 ای نی، پیداست کز غمی می نالی %~% زین سان، که چنین به هر دمی می نالی(@)(@@) (@@) از نالهآ تو، وقت دلم خوش شد از آنک %~% همچون دل من، از ستمی می نالی PageV01P156(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0160.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~3 آن نی، که چومن به ها و هومی نالدمعلومم نیست کز چه رو می نالد(@)(@@) ~~این طرفه نگر، که زخم نونو بردلمن می خورم از زمانه، او می نالد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 35 ای مطرب خوش، من چودلت می جویم چون تازی و پارسی نمی دانی گفت %~%(@)(@@) زین پس با تو، مگر به ترکی گویم! %~% تو گفتهآ من، چند زنی بررو یم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 358 ترکیب دلم یافت، ز دلبر خللی %~% با دیده همی کند، دل من جدلی(@)(@@) (@@) خواهی، که دل مخالفم راست شود %~% در پردهآ راهوی بیاور غزلی(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 35 وجد آن نبود نفس توتاراج شود %~% خلقی به نظارهآ تو محتاج شود(@)(@@) (@@) وجد آن باشد، که چون محمد برجا %~% در هر نفست، هزار معراج شود(@)(@@)(@@)(@@) | وله(@)(@@) ~~32 وجد آن نبود، که اشک راند از تو یا، پیز خرد را برماند از تو(@)(@@) ~~وجد آن باشد، که چون از آن جان و جهان یابی اثری، اثرنماند از تو(@)(@@)(@@)(@@) | نمط دوم(@)(@@)(@@)(@@) | درچنگ 
ms37	 ونی و غیرهما(@)(@@) شمس الدین الیاس میدانی گوید(@)(@@) (@@) 36 خواهی که سرت چنگ صفت بفرازد %~% برقول مخالفت خرد جان بازد(@)(@@) (@@) نشین براستاد به زانو، چون چنگ %~% اوله %~% تا هم بزند تو را و، هم بنوازد!(@)(@@) (@@) 36 مطرب، چنگت نمی سراید، بزنش %~% بازوی توتشت می بساید، بزنش(@)(@@) (@@) با قول تو راست دارد آهنگ، او را %~% اوله %~% بنواز و، گرت مخالف آید بزنش!(@)(@@) (@@) 36 ساقی، برخیز نام بر ننگ بزن %~% قرابهآ زهد و توبه، بر سنگ بزن(@)(@@) (@@) مطرب، توطبیب زاست قولی، بنشین %~% قارورهآ میبین و، رگ چنگ بزن PageV01P157(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0161.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~364 در حیله گری، هزار رنگ آورمتتا همچودهان توم به تنگ آورمت!(@)(@@) (@@) هر چند که در پردهای، ار موزونی %~% آخر، به بهانه ای به چنگ آورمت!(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 325 از سیمبری، سیم به سنگ آوردی %~% وزخوش سخنی، شکربه تنگ آوردی(@)(@@) (@@) در پرده همی زنی که: «من زان توام!)» %~% می زن، که نوای خوش به چنگ آوردی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 366 تا چشم تو، ناچشیده می مست بود %~% مسکین دلم از خمار غم بست بود(@)(@@) (@@) تا بر ننهی چو چنگ، رخ بر رخ من %~% بر سر چو طر برود، مرا دست بود!(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 367 از بهر دمی، که با توبر کار کنم %~% چون نای، همیشه نالهآ زار کنم(@)(@@) (@@) یک لحظه، گر از کنار تو دور افتم %~% چون چنگ تو، روی سوی دیوار کنم(@)(@@) (@@) 368 همچون آواز، یک زمانم برکش %~% وله %~% و آنگاه چو چنگ، تنگم اندر برکش(@)(@@) ~~گر درتن من، رگی نه بر پردهآ توستبیرون کن و، دیگری به جایش درکش(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 369 از بس که چکیدهست مرا از هر رگ %~% خون برمژه همچنان که برنشتررگ(@)(@@) (@@) همچون نی و چنگم، که نماندهست مرا %~% نه مغز در استخوان و، نه خون در رگ(@)(@@)(@@)(@@) | وله(@)(@@) ~~370 آن دم، که ز خدمتت جدا می باشم با ناله و گریه، آشنا می باشم(@)(@@) (@@) چون شمع، ز گریه آب رویی دارم %~% چون چنگ، زناله با نوا می باشم(@)(@@)(@@)(@@) | وله 
ms38	(@)(@@) (@@) 371 رشک آیدم ای دوست، که با تو هر شب %~% هر رومی و هندوی نشیند به طرب(@)(@@) (@@) گه، چنگ سپید را نهی رخ بر رخ %~% گه، نای سیاه را نهی لب بر لب!(@)(@)PageV01P158(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0162.jpg)(@)(@)(@@) ~~37 ای دل، به شبی که در غمش بنشستی خامش چوپیاله، با دلی پرخون باش(@)(@@) %~% وله %~% اوله %~% تا چند چو چنگ، نالهآ سردستی؟ %~% از ناله، خروشی به جهان در بستی(@)(@@) (@@) چون غنچه، دلم ز روی نیکو بگرفت 37 از وصل سمنبران، چنان شد حالم %~%(@)(@@) آنم، که چو چنگ از خوشی می نالم! %~% کزناز، به سان گل نو می بالم(@)(@@) ~~37 گاهی، به خودم چوزلف گستاخ کنی تا لب ننهم بر لب تو، دم نزنم 37(@)(@@) گر باد شوم، در آیمت پیرامن سوی تو کشد، وگر بود بسته چو چنگ %~% اوله(@)(@@) %~% وله %~% گاهی، سرم از جفا به صد شاخ کنی %~% ور گرد شوم، نشینمت بر(@)(@@) دامن! %~% هریک رگ من، به ریسمان اندرتن! %~% جون نایم اگر چه کعب سوراخ کنی!(@)(@@) ~~370 ای بر دل من خشم تو، چون ناز تو خوش چون چنگ خود، امشب اربسازی(@)(@@) بامن %~% اوله %~% ما نیز، برآییم چو آواز تو خوش %~% چون موسم گل وقت من، از ساز تو خوش(@)(@@) سید شرف الدین مرتضی(@)(@@) ~~371 چون پرتو روی آن نکو می جویم چنگ است چومن خمیده پشت، ازپی آن(@)(@@) %~% یک جرعهآ می، به آرزو می جویم %~% در عشق تو، همنشین از او می جویم(@)(@@)(@@)(@@) | لغیر5(@)(@@) آهنگ وداع کرد، در پردهآ هجر 31 تا دل نه به کام خود، زجانان بگسست %~%(@)(@@) مانند رگ چنگ، رگ جان بگسست1 %~% با درد بپیوست و، ز درمان بگسست(@)(@@)(@@)(@@) | پسرقاضی قزوین(@)(@@) ~~379 آخر، خبری زین دل دلتنگ بپرس جانا، چو خوری باده به هنگام صبوح(@)(@@) %~% شرح غمم، از طرهآ شبرنگ بپرس %~% احوال دلم، زنالهآ چنگ بپرس PageV01P159(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0163.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 380 چنگی صنمی، که کار حسنش به نواست %~% با ما همه این ترانه می زد شبهاست(@)(@@) (@@) کایم به برت غزل 
ms39	 سرایان روزی %~% و آن قول مخالفش، نمی آید راست!(@)(@@)(@@)(@@) | اوحد کرمانی(@)(@@) (@@) 381 چنگ تو، زبیخودی نظر سوی تو کرد %~% تا قامت خود، چفته چوابروی تو کرد(@)(@@) (@@) این هم زکژیش بود، وز سرسبکی %~% کآمد پس از آن و، پشت بر روی تو کرد(@)(@@) ظهیر شوره (ظ: شوروه)(@)(@@) ~~382 در عشق تو، پشت من خمیدهست چو چنگ زخم تو، به هر رگی رسیده ست چوچنگ(@)(@@) ~~با زخم پیاپی تو، مسکین دل من یک پوست بر استخوان کشیدهست، چو چنگ(@)(@@) عزیز علی شروانی(@)(@@) (@@) 383 ای ماه بلند قامت، ای مایهآ ناز %~% از زخمهآ شیرین، چو شوی چنگ نواز(@)(@@) (@@) در قالب، مرده زندگی گیرد باز %~% هر گه، که تو با چنگ برآری آواز(@)(@@)(@@)(@@) | اوله(@)(@@) ~~38 چون چنگ تو، در پرده کند تیز آهنگ از چشم من آب ریزد، از رویم رنگ(@)(@@) (@@) از دست غم تو، آنچنان می نالم %~% کز زخم سرانگشت تو، ابریشم چنگ(@)(@@)(@@)(@@) | ناج خلاطی(@)(@@) ~~385 قانون دلم، به عشقت از ساز برفت صبری، که چونای بود دمساز، برفت(@)(@@) ~~ننگی، که چودف بی سر و پا بود نماند نامی، که چو چنگ بد سرافراز برفت(@)(@@) شمس الدین هروی(@)(@@) ~~386 چون بنوازی چنگ خوش ساخته را بر سرو، به ناله آوری فاخته را(@)(@@) (@@) بس کس که زسودای تو بیرون ریزد %~% از کورهآ دل عقیق بگداخته را(@)(@@) قاضی ابوالماجد(@)(@@) (@@) 38 سرنای تو، چندان زلبت می نوشید %~% کاندر دهنت مست شد و، بخروشید(@)(@@) (@@) انگشتانت، چو پرده بر وی پوشید %~% در پرده دریدن جهانی کوشید(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 388 چون دف، همه ضربت و بالم دادی %~% چون نای، خروش حسب حالم دادی(@)(@@) (@@) گفتم که: چو چنگ گیرمت در آغوش %~% مانند رباب، گوشمالم دادی!(@)(@)PageV01P160(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0164.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 38 در عشق، تنم سپرده بر پاست چو چنگ %~% وز زخم، هزار ناله درناست چو چنگ(@)(@@) (@@) توده دل وصد قول و، من ازساده دلی %~% بنهاده بی گفت تو، دل راست چوچنگ(@)(@@) (@@) 39 بستد زمن کم خرد، آهنگ توهنگ %~% اوله %~% شد بند غمم، زپردهآ 
ms40	 تنگ توتنگ(@)(@@) (@@) جون چنگ تو، حلقم به زه آو یخته باد %~% گر بازکشم زدامن چنگ تو، چنگ(@)(@@)(@@)(@@) | اثیر اخسیکتی(@)(@@) ~~39 چون ساز صبوح کرد ساقی آهنگیاقوت گداخته بر آورد زسنگ(@)(@@) (@@) اززاری ارغنون، صراحی بگریست %~% خون گشت دل پیاله، از نالهآ چنگ(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~39 بردل کردی کمین، به انگشت زدنخواهی بردن،، یقین به انگشت زدن(@)(@@) (@@) من، در غمت انگشت نمای زن و مرد %~% وانگه تو، زمن چنین به انگشت زدن(@)(@@)(@@)(@@) | جمال الدین خلیل(@)(@@) (@@) 39 ما را زغم آنکه نهیم، ای دلجوی %~% چون چنگ تو، بر روی تویک باری روی(@)(@@) (@@) جانی است، چوانگشت تو اندرتگ و پوی %~% چون ناخنت، آو یخته از تاری موی(@)(@@)(@@)(@@) | جمال نقاش اصفهانی(@)(@@) (@@) 394 دل، در خم زلف مشکبار تونهم %~% جانی است مرا، بر سر کارتونهم(@)(@@) (@@) یا سر، زتنم چونای تو بردارند %~% اوله %~% یا همچو رباب، بر کنارتونهم(@)(@@) (@@) 395 گفتم که: چو چنگ از زدنم ناسایی %~% گفتا: چو رباب ناله را می شایی!(@)(@@) (@@) گفتم که: چو بر بطم زمانی بنواز %~% گفتا که: چونای باد می پیمایی!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 39 بر من، زپی تو دشمنان کف بزنند %~% صبر است مرا، تا همگان صف بزنند(@)(@@) (@@) ای دوست، مکن که عاقبت راز دلم %~% از پرده برون افتد و، بردف بزنند!(@)(@)PageV01P161(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0165.jpg)(@)(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~397 معشوقهآ خانگی، به کاری ناید کودل ببرد، روی به کس ننماید(@)(@@) (@@) معشوقه، قلندری ومطرب باید %~% تا نیمشبان، زنان و کوبان آید!(@)(@@) شرف الدین شفروه(@)(@@) (@@) 398 هم فاش شود، راز نهان من و تو %~% در شهر، همه سود و زیان من و تو(@)(@@) (@@) زودا! که به هر انجمنی، خرد و بزرگ %~% بردف بزنند، داستان من و تو!(@)(@@)(@@)(@@) | خطیر جرفادقانی(@)(@@) (@@) 399 آن یار کزو کار، مرا ساز آید %~% گر هیچ خرامان ز درم باز آید(@)(@@) (@@) مانند دف و چنگ، مرا از شادی %~% در حال، رگ و پوست به آواز آید(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) (@@) 400 پیشش، چو دلم ناله برآورد چو چنگ %~% صد شور، بر آن عشوه گر آورد چو چنگ(@)(@@) (@@) میداشت 