ms3041	 آخذا قاتله وأوداجه تشخب دما عند PageV09P258 رب العزة فيقول : يا رب سل هاذا فيم قتلني ؟ فيقول : فيم قتلت فلانا ؟ قال : قتلته لتكون العزة لفلان ، قال : هي لله ) )(@)(@@) . ( طب ، عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28344 قال النبي :(@)(@@) | 30 ( يجيء قوم صغار العيون ، عراض الوجوه كأن وجوههم الحجف فيلحقون أهل الاسلام بمنابت الشيح ، كأني أنظر إليهم وقد ربطوا خيولهم بسواري المسجد ، قيل : يا رسول الله من هم ؟ قال : الترك ) )(@)(@@) . ( ك عن بريدة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28345 قال النبي :(@)(@@) | 30 ( يجيء قوم في آخر الزمان سفهاء الاحلام ، يقولون من خير قول البرية يقرأون القرآن لا يجاوز تراقيهم ، فمن لقيهم فليقتلهم فإن فيه أجرا لمن قتلهم ) )(@)(@@) . ( الحكيم عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28346 قال النبي :(@)(@@) | 30 ( يجيء صاحب القرآن يوم القيامة فيقول القرآن : يا رب حله ، فيلبسه تاج الكرامة ، ثم يقول : يا رب زده ، يا رب ارض عنه فيرضاى عنه ، ويقال له : اقرأ وارقه ، ويزاد بكل آية حسنة ) )(@)(@@) . ( هب عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28347 قال النبي :(@)(@@) | 30 ( يجيء قوم يميتون السنة ويوغلون في الدين ، فعلاى أولائك لعنة الله ولعنة اللاعنين والملائكة والناس أجمعين ) )(@)(@@) . ( الديلمي عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28348 قال النبي :(@)(@@) | 30 ( يجيء قوم يقولون : لا قدر ثم يخرجون منها إلاى الزندقة ، فإذا لقيتموهم فلا تسلموا عليهم وإن مرضوا فلا تعودوهم ، وإن ماتوا فلا تشهدوا جنائزهم فإنهم شيعة الدجال ) )(@)(@@) . ( ك ، في تاريخه عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28349 قال النبي :(@)(@@) | 30 ( يجيء يوم القيامة المصحف والمسجد والعترة ، PageV09P259 فيقول المصحف : يا رب حرقوني ومزقوني ، ويقول المسجد : يا رب خربوني وعطلوني وضيعوني ، وتقول العترة : يا رب طردونا وقتلونا وشردونا وأجثوا بركبتي للخصومة ، فيقول الله ذالك إلي وأنا أولاى بذالك ) )(@)(@@) . ( الديلمي عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28350 قال النبي :(@)(@@) | 30 ( يجيء المؤذنون أطول الناس أعناقا يعرفون بطول أعناقهم يوم القيامة ) )(@)(@@) . ( أبو الشيخ في الاذان عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28351 قال النبي :(@)(@@) | 30 ( يجيء قوم يقرأون القرآن لا يجاوز 
ms3042	 تراقيهم ، يمرقون من الدين كما يمرق السهم من الرمية علاى فوقه ) )(@)(@@) . ( ش عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28352 قال النبي :(@)(@@) | 30 ( يجيء قوم من بعدي من أمتي يقرأون القرآن لا يجاوز تراقيهم ، يمرقون من الدين كما يمرق السهم من الرمية ثم لا يعودون فيه أبدا هم شر الخلق والخليقة ) )(@)(@@) . ( ابن جرير عن أبي ذر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28353 قال النبي :(@)(@@) | 30 ( يجير علاى المسلمين بعضهم ) )(@)(@@) . ( حم عن أبي عبيدة ، حم ، طب ، عن أبي أمامة رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28354 قال النبي :(@)(@@) | 30 ( يجير علاى المسلمين أدناهم ) )(@)(@@) . ( طب عن أنس ، حم ، طب ، عن ابن عمرو ، طب عن أم سلمة رضي الله عنهم ) .(@)(@@) PageV09P260(@)(@@)(@@)(@@) ||| ( الياء مع الحاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28355 قال النبي :(@)(@@) | 30 ( يحب الله العامل إذا عمل أن يحسن ) )(@)(@@) . ( طب ، عن كل يب بن شهاب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28356 قال النبي :(@)(@@) | 30 ( يحرم من الرضاعة ما يحرم من النسب ) )(@)(@@) . ( حم ، ق ، د ، ن ، ه ، عن عائشة ، حم ، م ، ن ، ه ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28357 قال النبي :(@)(@@) | 30 ( يحسب ما خانوك وعصوك وكذبوك ، وعقابك إياهم ، فإن كان عقابك إياهم بقدر ذنوبهم كان كفافا لا لك ولا عليك ، وإن كان عقابك إياهم دون ذنوبهم كان فضلا لك ، وإن كان عقابك إياهم فوق ذنوبهم اقتص لهم منك الفضل : أما تقرأ كتاب الله { ونضع الموازين القسط ليوم القيامة } الآية ) )(@)(@@) . ( حم ، ت ، عن عائشة رضي الله عنها ، ز ) .(@)(@@)(@@)(@@) $ 28358 قال النبي :(@)(@@) | 30 ( يحشر المتكبرون يوم القيامة أمثال الذر في صور الرجال يغشاهم الذل من كل مكان ، يساقون إلاى سجن في جهنم يسمى بولس تعلوهم نار الانيار ، يسقون من عصارة أهل النار طينة الخبال ) )(@)(@@) . ( حم ، ت ، عن ابن عمرو رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28359 قال النبي :(@)(@@) | 30 ( يحشر الناس علاى ثلاث طرائق : راغبين راهبين ، واثنان علاى بعير ، وثلاثة علاى بعير ، وأربعة علاى بعير ، وعشرة علاى بعير ، ويحشر بقيتهم النار لتقيل معهم حيث قالوا ، وتبيت معهم حيث باتوا ، وتصبح معهم حيث PageV09P261 أصبحوا ، وتمسي معهم حيث 
ms3043	 أمسوا ) )(@)(@@) . ( ق ، ن ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28360 قال النبي :(@)(@@) | 30 ( يحشر الناس علاى نياتهم ) )(@)(@@) . ( ه ، عن جابر رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28361 قال النبي :(@)(@@) | 30 ( يحشر الناس يوم القيامة ثلاثة أصناف : صنفا مشاة ، وصنفا ركبانا ، وصنفا علاى وجوههم ، إن الذي أمشاهم علاى أقدامهم قادر أن يمشيهم علاى وجوههم ، أما إنهم يتقون بوجوههم كل حدب وشوك ) )(@)(@@) . ( حم ، ت ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28362 قال النبي :(@)(@@) | 30 ( يحشر الناس يوم القيامة حفاة عراة غزلا ، الامر أشد من أن ينظر بعضهم إلاى بعض ) )(@)(@@) . ( م ، ن ، ه ، عن عائشة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28363 قال النبي :(@)(@@) | 30 ( يحشر الناس يوم القيامة علاى أرض بيضاء عفراء كقرصة النقي ليس فيها معلم لاحد ) )(@)(@@) . ( ق ، عن سهل بن سعد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28364 قال النبي :(@)(@@) | 30 ( يحضر الجمعة ثلاثة نفر : رجل حضرها يلغو وهو حظه منها ، ورجل حضرها يدعو فهو رجل دعا الله عز وجل إن شاء أعطاه وإن شاء منعه ، ورجل حضرها بإنصات وسكون ولم يتخط رقبة مسلم ولم يؤذ أحدا فهو كفارة إلاى الجمعة التي تليها وزيادة ثلاثة أيام ، وذالك بأن الله يقول : { من جاء بالحسنة فله عشر أمثالها } ) )(@)(@@) . ( حم ، د ، عن ابن عمرو رضي الله عنه ، ز ) .(@)(@@) PageV09P262(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28365 قال النبي :(@)(@@) | 30 ( يحب الانسان الحياة ، والموت خير لنفسه ، ويحب الانسان كثرة المال ، وقلة المال أقل لحسابه ) )(@)(@@) . ( ابن السني وأبو موساى في المعرفة ، هب عن زرعة بن عبد الله الانصاري مريلا بزاي ثم راء ، وقيل : براء أوله ثم زاي ساكنة وقيل هو صحابي ) .(@)(@@)(@@)(@@) $ 28366 قال النبي :(@)(@@) | 30 ( يحبس أهل الجنة بعد ما يجاوزون الصراط علاى قنطرة فيؤخذ لبعضهم من بعض مظالمهم التي تظالموها في الدنيا حتى إذا هذبوا ونقوا أذن لهم في دخول الجنة فلاحدهم أعرف بمنزله في الآخرة منه بمنزله كان في الدنيا ) )(@)(@@) . ( ك عن أبي سعيد رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28367 قال النبي :(@)(@@) | 30 ( يحبنا الاطيبان من قريش : تيم بن مرة ، وزهرة بن 
ms3044	 كلاب ) )(@)(@@) . ( الرامهرمزي في الامثال عن عمرو بن الحصين عن أبي علافة عن جعفر بن محم ، عن أبيه عن جده ) .(@)(@@)(@@)(@@) $ 28368 قال النبي :(@)(@@) | 30 ( يحرم من الرضاع ما يحرم من النسب : من خال أو عم أو ابن أخ ) )(@)(@@) . ( ابن جرير عن ابن عباس عن عائشة رضي الله عنها ) .(@)(@@)(@@)(@@) $ 28369 قال النبي :(@)(@@) | 30 ( يحرم علاى النار كل هين لين قريب سهل ) )(@)(@@) . ( ابن النجار عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28370 قال النبي :(@)(@@) | 30 ( يحسر الفرات عن جبل من ذهب فيقتتلون عليه فيقتل من كل مائة تسعة وتسعون ، ولا تقوم الساعة إلا نهارا ) )(@)(@@) . ( كر ، عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28371 قال النبي :(@)(@@) | 30 ( يحسر الفرات عن جبل من ذهب وفضة ، فيقتل عليه من كل تسعة سبعة ، فإن أدركتموه فلا تقربوه ) )(@)(@@) . ( نعيم بن حماد في الفتن عن أبي هريرة رضي الله عنه ) .(@)(@@) PageV09P263(@)(@@)(@@)(@@) $ 28372 قال النبي :(@)(@@) | 30 ( يحشر الناس ما بين السقط إلاى الشيخ الفاني أبناء ثلاث وثلاثين في خلق آدم ، وحسن يوسف ، وخلق أيوب مكحلين ذوي أفانين ) )(@)(@@) . ( طب ، عن المقداد بن الاسود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28373 قال النبي :(@)(@@) | 30 ( يحشر رجلان من مزينة هما آخر الناس محشرا ، يقبلان من جبل حتى يأتيا معالم الناس فيجدان الاءرض وحوشا حتى يأتيا المدينة ، فإذا جاءا قالا أين الناس ؟ فلا يريان أحدا ، فيقول أحدهما لصاحبه : الناس في دورهم ، فيدخلان الدور ، فإذا ليس فيها أحد ، وإذا علاى الفرش الثعالب والسنانير فيقولان : أين الناس ؟ فيقول أحدهما لصاحبه : إذا هم في السوق شغلتهم الاسواق ، فيخرجان حتى يأتيا السوق فلا يجدان فيها أحدا ، فينطلقان حتى يأتيا المدينة فإذا عليها ملكان ، فيأخذان بأرجلهما فيسحبانهما إلاى أرض المحشر ، فهما آخر الناس حشرا ) )(@)(@@) . ( ك ، وابن مردويه وابن عساكر عن أبي شريحة الغفاري رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28374 قال النبي :(@)(@@) | 30 ( يحشر زيد بن عمرو بن نفيل أمة وحده بيني وبين عيساى بن مريم عليه السلام ) )(@)(@@) . ( ابن عساكر عن الشعبي عن جابر وعن عروة مرسلا ) .(@)(@@)(@@)(@@) $ 28375 قال النبي :(@)(@@) | 30 ( يحشر الناس يوم القيامة حفاة عرة ، قالت 
ms3045	 امرأة : يا رسول الله فكيف يراى بعضنا بعضا ، قال : إن الأبصار يومئذ شاخصة ) )(@)(@@) . ( طب ، عن السيد الحسن رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28376 قال النبي :(@)(@@) | 30 ( يحشر ما بين السقط إلاى الشيخ الفاني ، المؤمنون منهم أبناء ثلاث وثلاثين سنة في خلق آدم ، وحسن يوسف ، وقلب أيوب ، مردا مكحلين أولي أفانين قيل يا رسول الله فكيف بالكافر ؟ قال : يعظم للنار PageV09P264 حتى يصير غلظ جلده أربعين باعا ، وحتى يصير ناب من أنيابه مثل أحد ) )(@)(@@) . ( ع ، طب ، وابن مردويه عن المقدام بن معدي كرب رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28377 قال النبي :(@)(@@) | 30 ( يحشر الحكارون وقتلة الأنفس إلاى جهنم في درجة واحدة ) )(@)(@@) . ( عد وابن لال وابن عساكر عن أبي هريرة رضي الله عنه وأورده ابن الجوزي في الموضوعات فلم يصب ) .(@)(@@)(@@)(@@) $ 28378 قال النبي :(@)(@@) | 30 ( يحشر الناس يوم القيامة كما ولدتهم أمهاتهم : حفاة عراة غرلا ، قالت عائشة : ينظر بعضهم إلاى بعض ، قال : شغل الناس يومئذ عن النظر وسموا بأبصارهم إلاى السماء موقوفون أربعين سنة لا يأكلون ولا يشربون ) )(@)(@@) . ( ابن مردويه عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28379 قال النبي :(@)(@@) | 30 ( يحشر الله عز وجل الناس يوم القيامة عراة غزلا بهما ، قالوا : وما بهما ؟ قال : ليس معهم شيء ، ثم يناديهم بصوت يسمعه من بعد كما يسمعه من قرب : أنا الملك ، أنا الديان ، لا ينبغي لأحد من أهل النار أن يدخل وله عند أحد من أهل الجنة حق حتى أقضيه منه ، ولا ينبغي لأحد من أهل الجنة أن يدخل الجنة ولأحد من أهل النار عنده حق حتى أقضيه منه حتى اللطمة ، قالوا : كيف وإنا إنما نأتي الله عراة غرلا بهما ؟ قال : بالحسنات والسيئات ) )(@)(@@) . ( حم ، ع ، والخرائطي في مساوىء الأخلاق ، طب ، ك ، رضي الله عنه ، عن عبد الله بن أنيس الأنصاري رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28380 قال النبي :(@)(@@) | 30 ( يحشر الناس فينادي مناد : أليس عدلا مني أن أولي كل قوم ما كانوا يعبدون ، ثم ترفع لهم آلهتهم فيتبعونها ، حتى لا يبقاى أحد غير هاذه الأمة ، فيقال لهم : ما لكم ؟ قالوا : ما نراى 
ms3046	 إلاهنا الذي نعبد فيتجلى لهم تبارك PageV09P265 وتعالاى ) )(@)(@@) . ( طب ، عن أبي موساى رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28381 قال النبي :(@)(@@) | 30 ( يحشر المؤذنون أطول أعناقا لقولهم : لا إلاه إلا الله ) )(@)(@@) . ( أبو الشيخ في الأذان عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28382 قال النبي :(@)(@@) | 30 ( يحلها وتحل به ، رجل من قريش لو وزنت ذنوبه بذنوب الثقلين لوزنتها ) )(@)(@@) . ( حم ، عن ابن عمرو رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28383 قال النبي :(@)(@@) | 30 ( يحمل هاذا العلم من كل خلف عدوله ينفون عنه تحريف العالمين ، وانتحال المبطلين ، وتأويل الجاهلين ) )(@)(@@) . ( عد ، وأبو نصر السجزي في الابانة وأبو نعيم ، هق ، وابن عساكر عن إبراهيم بن عبد الرحمان العذري وهو مختلف في صحبته ، قال ابن منده : ذكر في الصحابة ولا يصح قال أبو نعيم : وروي عن أسامة بن زيد وأبي هريرة وكلها مضطربة غير مستقيمة ، عد ، هق ، وابن عساكر عن إبراهيم بن عبد الرحمان العذري ، حدثنا الثقة من أشياخنا الخطيب وابن عساكر عن أسامة بن زيد ، ابن عساكر عن أنس ، الديلمي عن ابن عمر ، عق ، عن أبي أمامة ، بز ، عق ، عن ابن عمرو وأبي بكر معا ، قال الخطيب : سئل أحمد بن حنبل عن هاذا الحديث وقيل له : كأنه كلام موضوع ، قال : لا ، هو صحيح سمعته من غير واحد ) .(@)(@@)(@@)(@@) $ 28384 قال النبي :(@)(@@) | 30 ( يحمل الناس يوم القيامة علاى الصراط فتتقادع بهم جنبتا الصراط تقادع الفراش في النار ، ثم ينجي الله برحمته من يشاء ، ثم يؤذن للملائكة والنبيين والصديقين والشهداء أن يشفعوا فيشفعون ويخرجون ويشفعون ويخرجون ، ويشفعون ويخرجون حتى لا يبقاى في النار أحد في قلبه مثقال ذرة من إيمان ) )(@)(@@) . ( حم ، طب ، عن أبي بكرة رضي الله عنه ) .(@)(@@) PageV09P266(@)(@@)(@@)(@@) ||| ( الياء مع الخاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 28385 قال النبي :(@)(@@) | 30 ( يختصم الشهداء والمتوفون علاى فرشهم إلاى ربنا في الذين يتوفون من الطاعون ، فيقول الشهداء : إخواننا قتلوا كما قتلنا ويقول المتوفون على فرشهم إخواننا ماتوا على فرشهم كما متنا ، فيقضي الله بينهم ، فيقول ربنا : انظروا إلاى جراحهم فإن أشبهت جراحهم جراح المقتولين فإنهم منهم ومعهم ، فينظرون إلاى 
ms3047	 جراح المطعونين فإذا جراحهم قد أشبهت جراح الشهداء فيلحقون بهم ) )(@)(@@) . ( حم ، ن ، طب ، عن العرباض بن سارية رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28386 قال النبي :(@)(@@) | 30 ( يخرج الدجال في أمتي فيمكث أربعين ، فيبعث الله تعالاى عيساى بن مريم كأنه عروة بن مسعود الثقفي فيطلبه فيهلكه ، ثم يمكث الناس سبع سنين ليس بين اثنين عداوة ، ثم يرسل الله ريحا باردة من قبل الشام فلا يبقاى علاى وجه الأرض أحد في قلبه مثقال ذرة من إيمان إلا قبضته ، حتى لو أن أحدكم دخل في كبد جبل لدخلت عليه حتى تقبضه ، فيبقاى شرار الناس في خفة الطير وأحلام السباع ، لا يعرفون معروفا ، ولا ينكرون منكرا فيتمثل لهم الشيطان فيقول : ألا تستجيبون ؟ فيقولون : بم تأمرنا ؟ فيأمرهم بعبادة الأوثان فيعبدونها وهم في ذالك دار رزقهم ، حسن عيشهم ، ثم ينفخ في الصور فلا يسمعه أحد إلا أصغاى ليتا ورفع ليتا ، وأول من يسمعه رجل يلوط حوض إبله فيصعق ويصعق الناس ، ثم يرسل الله مطرا كأنه الطل فينبت منه أجساد الناس ، ثم ينفخ فيه أخراى فإذا هم قيام ينظرون ، ثم يقال : يا أيها الناس هلموا إلاى ربكم وقفوهم إنهم مسؤولون ، ثم يقال : أخرجوا PageV09P267 بعث النار ، فيقال : من كم ؟ فيقال : من كل ألف تسعمائة وتسعة وتسعون ، فذالك يوم يجعل الولدان شيبا ، وذالك يوم يكشف عن ساق ) )(@)(@@) . ( حم ، م ، عن ابن عمر رضي الله عنهما ، ز ) .(@)(@@)(@@)(@@) $ 28387 قال النبي :(@)(@@) | 30 ( يخرج الدجال فيتوجه قبله رجل من المؤمنين فيلقاه المشايخ مشايخ الدجال فيقولون له أين تعمد ؟ فيقول : أعمد إلاى هاذا الذي خرج ، فيقولون له : أوما تؤمن بربنا ؟ فيقول : ما بربنا خفاء ، فيقولون اقتلوه ، فيقول بعضهم لبعض : أليس قد نهاكم ربكم أن تقتلوا أحدا دونه ، فينطلقون به إلاى الدجال ، فإذا رآه المؤمن قال : يا أيها الناس هاذا الدجال الذي ذكر رسول الله فيأمر الدجال به فيشج فيقول : خذوه وشجوه فيوسع بطنه وظهره ضربا فيقول أما تؤمن بي ؟ فيقول : أنت المسيح الكذاب ، فيؤمر به فينشر بالمنشار من مفرقه حتى يفرق بين رجليه ، ثم 
ms3048	 يمشي الدجال بين القطعتين ، ثم يقول له قم فيستوي قائما ، ثم يقول له : أتؤمن بي ؟ فيقول : ما ازددت فيك إلا بصيرة ، ثم يقول : يا أيها الناس إنه لا يفعل بعدي بأحد من الناس فيأخذه الدجال فيذبحه ، فيجعل ما بين رقبته إلاى ترقوته نحاسا فلا يستطيع إليه سبيلا ، فيأخذ بيديه ورجليه فيقذف به فيحسب الناس أنما قذفه في النار وإنما ألقي في الجنة ، هاذا أعظم الناس شهادة عند رب العالمين ) )(@)(@@) . ( م ، عن أبي سعيد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28388 قال النبي :(@)(@@) | 30 ( يخرج الدجال ومعه نهر ونار فمن دخل نهره وجب وزره وحط أجره ، ومن دخل ناره وجب أجره وحط وزره ، ثم إنما هي قيام الساعة ) )(@)(@@) . ( حم ، د ، ك ، عن حذيفة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28389 قال النبي :(@)(@@) | 30 ( يخرج الله قوما من النار فيدخلهم الجنة ) )(@)(@@) . ( حم ، ق ، عن جابر رضي الله عنه ، ز ) .(@)(@@) PageV09P268(@)(@@)(@@)(@@) $ 28390 قال النبي :(@)(@@) | 30 ( يخرج رجل من وراء النهر يقال له : الحارث ، حراث علاى مقدمته رجل يقال له : منصور يمكن لآل محمد كما مكنت قريش لرسول الله ، وجب علاى كل مسلم نصره ) )(@)(@@) . ( د ، عن علي رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28391 قال النبي :(@)(@@) | 30 ( يخرج عنق من النار يوم القيامة ، له عينان يبصران ، وأذنان يسمعان ، ولسان ينطق يقول : إني وكلت بثلاثة : بكل جبار عنيد ، وبكل من دعا مع الله إلاها آخر ، وبالمصورين ) )(@)(@@) . ( حم ، ت ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28392 قال النبي :(@)(@@) | 30 ( يخرج في آخر الزمان رجال يختلون الدنيا بالدين ، يلبسون للناس جلود الضأن ، من اللين ألسنتهم أحلاى من العسل ، وقلوبهم قلوب الذئاب ، يقول الله : أبي يغترون ، أم علي يجترئون ؟ فبي حلفت لأبعثن علاى أولائك منهم فتنة تدع الحليم منهم حيران ) )(@)(@@) . ( ت ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28393 قال النبي :(@)(@@) | 30 ( يخرج في آخر الزمان قوم أحداث الأسنان ، سفهاء الأحلام ، يقرءون القرآن بألسنتهم لا يجاوز تراقيهم ، يقولون من قول خير البرية ، يمرقون من الدين كما يمرق السهم من الرمية ، فمن لقيهم فليقتلهم ، فإن 
ms3049	 في قتلهم أجرا عظيما عند الله لمن قتلهم ) )(@)(@@) . ( حم ، ت ، ه ، عن ابن مسعود رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28394 قال النبي :(@)(@@) | 30 ( يخرج فيكم قوم تحقرون صلاتكم مع صلاتهم ، وصيامكم مع صيامهم ، وعملكم مع عملهم ، يقرأون القرآن لا يجاوز حناجرهم ، يمرقون من الدين كما يمرق السهم من الرمية ، ينظر الرامي في النصل فلا يراى شيئا ، وينظر في القدح فلا يراى شيئا ، وينظر في الريش فلا يراى شيئا ، ويتماراى في الفوق PageV09P269 هل علق به من الدم شيء ) )(@)(@@) . ( ق ، ه ، عن أبي سعيد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28395 قال النبي :(@)(@@) | 30 ( يخرج قوم في آخر الزمان يقرءون القرآن لا يجاوز تراقيهم ، سيماهم التحليق ، إذا لقيتموهم فاقتلوهم ) )(@)(@@) . ( ه ، عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28396 قال النبي :(@)(@@) | 30 ( يخرج قوم من النار بشفاعة محمد فيدخلون الجنة ويسمون الجهنميين ) )(@)(@@) . ( حم ، خ ، د ، عن عمران بن حصين رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28397 قال النبي :(@)(@@) | 30 ( يخرج قوم من أمتي يقرأون القرآن ليس قراءتكم إلاى قراءتهم بشيء ، ولا صلاتكم إلاى صلاتهم بشيء ، ولا صيامكم إلاى صيامهم بشيء ، يقرءون القرآن يحسبون أنه لهم وهو علي هم ، لا تجاوز صلاتهم تراقيهم يمرقون من الإسلام كما يمرق السهم من الرمية ، لو يعلم الجيش الذين يصيبونهم ما قضي لهم علاى لسان نبيهم لاتكلوا عن العمل ، وآية ذالك أن فيهم رجلا له عضد ليس فيه ذراع علاى رأس عضده مثل حلمة الثدي عليه شعرات بيض ) )(@)(@@) . ( م ، د ، عن علي رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28398 قال النبي :(@)(@@) | 30 ( يخرج من المشرق أقوام محلقة رؤوسهم ، يقرأون القرآن بألسنتهم لا يعدو تراقيهم ، يمرقون من الدين كما يمرق السهم من الرمية ) )(@)(@@) . ( حم ، ق ، عن سهل بن حنيف رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28399 قال النبي :(@)(@@) | 30 ( يخرج من النار أربعة فيعرضون علاى الله ، فيلتفت إليه أحدهم فيقول : أي رب إذ أخرجتني منها لا تعدني فيها فينجيه الله منها ) )(@)(@@) . ( م ، عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28400 قال النبي :(@)(@@) | 30 ( يخرج من النار قوم بالشفاعة كأنهم الثعارير 
ms3050	 ) )(@)(@@) PageV09P270 . ( ق ، عن جابر رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28401 قال النبي :(@)(@@) | 30 ( يخرج من النار قوم بعد ما احترقوا فيدخلون الجنة فيسميهم أهل الجنة الجهنميين ) )(@)(@@) . ( خ ، عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28402 قال النبي :(@)(@@) | 30 ( يخرج من النار من قال : لا إلاه إلا الله وكان في قلبه من الخير ما يزن شعيرة ، ثم يخرج من النار من قال لا إلاه إلا الله وكان في قلبه من الخير ما يزن برة ، ثم يخرج من النار من قال : لا إلاه إلا الله وكان في قلبه من الخير ما يزن ذرة ) )(@)(@@) . ( حم ، ق ، ت ، ن ، عن أنس رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28403 قال النبي :(@)(@@) | 30 ( يخرج من النار من كان في قلبه مثقال ذرة من الإيمان ) )(@)(@@) . ( ت ، عن أبي سعيد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28404 قال النبي :(@)(@@) | 30 ( يخرج من خراسان رايات سود ، فلا يردها شيء حتى تنصب بإيلياء ) )(@)(@@) . ( حم ، ت ، عن أبي هريرة رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28405 قال النبي :(@)(@@) | 30 ( يخرج ناس من المشرق فيوطئون للمهدي سلطانه ) )(@)(@@) . ( ه ، عن عبد الله بن الحارث بن جزء رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28406 قال النبي :(@)(@@) | 30 ( يخرج ناس من قبل المشرق يقرأون القرآن لا يجاوز تراقيهم ، يمرقون من الدين كما يمرق السهم من الرمية ، ثم لا يعودون فيه حتى يعود السهم إلاى فوقه ، سيماهم التحليق ) )(@)(@@) . ( حم ، خ ، عن أبي سعيد رضي الله عنه ، ز ) .(@)(@@)(@@)(@@) $ 28407 قال النبي :(@)(@@) | 30 ( يخرب الكعبة ذو السويقتين من الحبشة ) )(@)(@@) . ( ق ، ن ، عن أبي هريرة رضي الله عنه ) .(@)(@@) PageV09P271(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 28408 قال النبي :(@)(@@) | 30 ( يخرب الكعبة ذو السويقتين من الحبشة ويسلبها حليتها ، ويجردها من كسوتها ، فلكأني أنظر إليه أصيلع أفيدع يضرب عليها بمسحاته ومعوله ) )(@)(@@) . ( حم ، عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28409 قال النبي :(@)(@@) | 30 ( يخرج رجلان من النار فيعرضان علاى الله عز وجل ثم يؤمر بهما إلاى النار ، فيلتفت أحدهما فيقول : أي رب قد كنت أرجو إذا أخرجتني منها أن لا تعيدني فينجيه الله ) )(@)(@@) . ( حم ، وأبو عوانة 
ms3051	 ، حب ، عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28410 قال النبي :(@)(@@) | 30 ( يخرج قوم من النار منتنين قد محشتهم النار فيدخلون الجنة برحمة الله وشفاعة الشافعين فيسمون الجهنميين ) )(@)(@@) . ( ط ، حم ، وابن خزيمة عن حذيفة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28411 قال النبي :(@)(@@) | 30 ( يخرج الدجال في خفقة من الدين وإدبار من العلم ، فله أربعون ليلة يسيحها في الأرض اليوم منها كالسنة ، واليوم منها كالشهر ، واليوم منها كالجمعة ، ثم سائر أيامه كأيامكم هاذه ، وله حمار يركبه عرض ما بين أذنيه أربعون ذراعا ، فيقول للناس أنا ربكم وهو أعور وإن ربكم ليس بأعور ، مكتوب بين عينيه : كافر ، مهجاة يقرأه كل مؤمن : كاتب وغير كاتب ، يرد كل ماء ومنهل إلا المدينة ومكة حرمهما الله عليه ، وقامت الملائكة بأبوابهما ، ومعه جبال من خبز والناس في جهد إلا من اتبعه ، ومعه نهران أنا أعلم بهما منه ، نهر يقول الجنة ، ونهر يقول النار ، PageV09P272 فمن أدخله الذي يسميه الجنة فهي النار ، ومن أدخل الذي يسميه النار فهي الجنة ، ويبعث معه شياطين تكلم الناس ، ومعه فتنة عظيمة يأمر السماء فتمطر فيما يرى الناس ، ويقتل نفسا ثم يحييها ، لا يسلط علاى غيرها من الناس فيما يراى الناس فيقول للناس : أيها الناس هل يفعل مثل هاذا إلا الرب ؟ فيفر المسلمون إلاى جبل الدخان بالشام فيأتيهم فيحصرهم فيشتد حصارهم ويجهدوا جهدا شديدا ، ثم ينزل عيساى عليه السلام فينادي من السحر فيقول : يا أيها الناس ما يمنعكم أن تخرجوا إلاى الكذاب الخبيث ؟ فيقولون : هاذا رجل حي فينطلقون فإذا هم بعيساى عليه السلام فتقام الصلاة فيقال له تقدم يا روح الله ، فيقول ليتقدم إمامكم فليصل بكم ، فإذا صلوا صلاة الصبح فرجوا إليه فحين يراه الكذاب ينماث كما ينماث الملح في الماء ، فيمشي إليه فيقتله حتى أن الشجر والحجر ينادي : يا روح الله هاذا يهودي فلا يترك ممن كان يتبعه أحدا إلا قتله ) )(@)(@@) . ( حم ، وابن خزيمة ، ع ، ك ، ض ، عن جابر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28412 قال النبي :(@)(@@) | 30 ( يخرج أحدكم في غنيمته إلاى حاشية القرية فيشهد الصلاة ويؤوب 
ms3052	 إلاى أهله حتى إذا أكل ما حوله وتعذرت عليه الأرض ، قال : لو ارتفعت إلاى ردهة هي أعفا كلأ من هاذه ، فيرتفع فلا يشهد من الصلوات إلا الجمعة حتى إذا أكل ما حوله وتعذرت عليه الأرض قال : لو ارتفعت إلاى ردهة هي أعفا كلأ من هاذه ، فيرتفع حتى لا يشهد الصلوات ولا يدري ما الجمعة حتى يطبع علاى قلبه ) )(@)(@@) . ( الحسن بن سفيان البغوي والبارودي وابن قانع ، طب ، وابن نعيم ، هق ، عن حارثة بن النعمان رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28413 قال النبي :(@)(@@) | 30 ( يخرج الدجال من يهودية أصبهان حتى يأتي الكوفة فيلحقه قوم من المدينة وقوم من الطور وقوم من ذي يمن وقوم من قزوين ، قيل يا رسول الله وما قزوين ؟ قال : قوم يكونون بآخرة يخرجون من الدنيا زهدا فيها يرد الله بهم قوما من الكفر إلاى الإيمان ) )(@)(@@) . ( الخطيب في فضائل قزوين والرافعي عن ابن عباس PageV09P273 رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28414 قال النبي :(@)(@@) | 30 ( يخرج قوم من المشرق حلقان الرؤوس يقرأون القرآن لا يجاوز حناجرهم ، طوباى لمن قتلوه وطوباى لمن قتلهم ) )(@)(@@) . ( أبو نصر السجزي في الإبانة عن ابن عباس والخطيب وابن عساكر عن عمر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28415 قال النبي :(@)(@@) | 30 ( يخرج ناس من أمتي يمرقون من الدين كما يمرق السهم من الرمية ، يقتلون في جبل لبنان ) )(@)(@@) . ( والخليلي بن مندة ، طب ، هق ، وابن عساكر عن عبد الرحمان بن عديس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28416 قال النبي :(@)(@@) | 30 ( يخرج الدجال من قبل أصبهان ) )(@)(@@) . ( طب ، عن عمران بن حصين رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28417 قال النبي :(@)(@@) | 30 ( يخرج الأعور الدجال من يهودية أصبهان ، ثم يخلق له عين والاخراى كأنها كوكب ممزوجة من دم يشواى في الشمس شيا ، يتناول الطير من الجو له ثلاث صيحات يسمعها أهل المشرق والمغرب ، له حمار ما بين عرض أذنيه أربعين عاما ، يطأ كل منهل في كل سبعة أيام ، يسير معه جبلان أحدهما فيه أشجار وثمار وماء ، وأحدهما فيه دخان ونار ، يقول : هاذه الجنة وهاذه النار ) )(@)(@@) . ( ك ، وابن عساكر عن ابن عمر رضي الله 
ms3053	 عنهما ) .(@)(@@)(@@)(@@) $ 28418 قال النبي :(@)(@@) | 30 ( يخرج الأعور الدجال من يهودية أصبهان عينه اليمنى ممسوحة والاخراى كأنها زهرة ) )(@)(@@) . ( سمويه ، ك ، عن ابن عمر عن حذيفة رضي الله عنهم ) .(@)(@@)(@@)(@@) $ 28419 قال النبي :(@)(@@) | 30 ( يخرج في آخر الزمان قوم رؤساء جهال يفتون الناس فيضلون ويضلون ) )(@)(@@) . ( أبو نعيم والديلمي عن أبي هريرة رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28420 قال النبي :(@)(@@) | 30 ( يخرج من النار بشفاعة رجل من أمتي أكثر من ربيعة ومضر ) )(@)(@@) . ( أبو نعيم عن أبي أمامة رضي الله عنه ) .(@)(@@) PageV09P274(@)(@@)(@@)(@@) $ 28421 قال النبي :(@)(@@) | 30 ( يخرج الدجال ومعه سبعون ألفا من الحاكة علاى مقدمته أشعر من فيهم يقول بدو بدو ) )(@)(@@) . ( الديلمي عن علي رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28422 قال النبي :(@)(@@) | 30 ( يخرج من النار رجل فيقول له ربه تعالاى : ما تعطيني إن أخرجتك ؟ فيقول : يا رب أعطيك ما تسألني ، فيقول له : كذبت ، وعزتي قد سألتك ما هو أهون من ذالك فلم تعطني ، سألتك أن تسألني فأعطيك ، وتدعوني فأستجيب لك ، وتستغفرني فأغفر لك ) )(@)(@@) . ( الديلمي عن أنس رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28423 قال النبي :(@)(@@) | 30 ( يخرج الخمار من قبره مكتوب بين عينيه : آيس من رحمة الله ، ويقوم آكل الربا من قبره مكتوب بين عينيه : لا حجة له عند الله ، ويقوم المحتكر من قبره مكتوب بين عينيه : يا كافر تبوأ مقعدك من النار ) )(@)(@@) . ( الديلمي عن ابن مسعود رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28424 قال النبي :(@)(@@) | 30 ( يخرج الدجال من أرض يقال لها : خرسان ، يتبعه قوم كأن وجوههم المجان المطرقة ) )(@)(@@) . ( ابن جرير في تهذيبه عن أبي بكر رضي الله عنه ) .(@)(@@)(@@)(@@) $ 28425 قال النبي :(@)(@@) | 30 ( يخرج من عدن اثنا عشر ألفا ينصرون الله ورسوله هم خير من بيني وبينهم ) )(@)(@@) . ( حم ، عد ، طب ، عن ابن عباس رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28426 قال النبي :(@)(@@) | 30 ( يخرج من ثقيف مبير وكذاب ) )(@)(@@) . ( طب عن ابن عمر رضي الله عنهما ) .(@)(@@)(@@)(@@) $ 28427 قال النبي :(@)(@@) | 30 ( يخرج ناس من قبل المشرق يقرأون القرآن لا يجاوز تراقيهم ، كلما قطع قرن نشأ قرن حتى يكون آخرهم يخرج مع الدجال ) )(@)(@@) . ( حم ، طب ، ك 