ms1397	 ، رحم الله امرأة قامت من الليل فصلت ، ثم أيقظت زوجها فصلى ) )(@)(@@) ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 12511 ) قال النبي :(@)(@@) | 30 ( رحم الله عبدا سمع مقالتي فحفظها ، فرب حامل فقه غير فقيه ، ورب حامل فقه إلى من هو أفقه منه ، ثلاث لا يغل عليهن قلب مؤمن : إخلاص العمل لله ، ومناصحة ولاة المسلمين ، ولزوم جماعة المسلمين ) )(@)(@@) ( طب ) و ابن قانع وأبو نعيم ( كر ) عن النعمان بن بشير عن أبيه .(@)(@@)(@@)(@@) $ ( 12512 ) قال النبي :(@)(@@) | 30 ( رحم الله لوطا كان يأوي إلى ركن شديد ، وما بعث الله بعده نبيا إلا في ثروة من قومه ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12513 ) قال النبي :(@)(@@) | 30 ( رحم الله عمرو بن العاص إني كنت إذا ندبت الناس للصدفة جاء من الصدقة فأجزل فأقول : من أين لك هاذا يا عمرو ؟ فيقول : من عند الله ، وصدق عمرو ، إن لعمرو عند الله خيرا كثيرتا ) )(@)(@@) ( حم طب ك ) عن عل قمة بن رمثة العلوي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12514 ) قال النبي :(@)(@@) | 30 ( رحم الله خرافة إنه كان رجلا صالحا ) )(@)(@@) المفضل الضبي في الأمثال عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12515 ) قال النبي :(@)(@@) | 30 ( رحم الله حمير أفواههم سلام وأيديهم طعام ، PageV04P416 وهم أهل أمن وإيمان ) )(@)(@@) ( حم ت ) غريب عن أبي هريرة رضي الله عنها ( هب ) عن الصنائجي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12516 ) قال النبي :(@)(@@) | 30 ( رحم الله من كف لسانه عن أهل القبلة إلا بأحسن ما يقدر عليه ) )(@)(@@) ابن أبي الدنيا في الصمت عن هشام بن عروة رضي الله عنه معضلا .(@)(@@)(@@)(@@) $ ( 12517 ) قال النبي :(@)(@@) | 30 ( رحم الله رجلا قال حقا أو سكت ، رحم الله رجلا قام من الليل فصلى ، ثم قال لامرأته قومي فصلي ) )(@)(@@) ابن أبي الدنيا في الصمت عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 12518 ) قال النبي :(@)(@@) | 30 ( رحم الله عبدا تكلم فغنم ، أو سكت فسلم ) )(@)(@@) ابن أبي الدنيا في الصمت والعسكري في الأمثال ( هب ) عن الحسن مرسلا ، العسكري عن الحسن عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12519 ) قال النبي :(@)(@@) | 30 ( رحم الله عبدا قال خيرا فغنم ، أو سكت 
ms1398	 فسلم ) )(@)(@@) هناد والخرائطي في مكارم الأخلاق عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 12520 ) قال النبي :(@)(@@) | 30 ( رحم الله امرأ تكلم فغنم ، أو سكت فسلم ) )(@)(@@) ( عب ) و الديلمي عن ثابت عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12521 ) قال النبي :(@)(@@) | 30 ( رحم الله امرأ كف لسانه عن أعراض المسلمين ، لا تحل شفاعتي لطعان ولا للعان ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12522 ) قال النبي :(@)(@@) | 30 ( رحم الله رجلا تعلم فريضة أو فريضتين ، أو عمل بهما ، أو علمهما من يعمل بهما ) )(@)(@@) أبو الشيخ عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12523 ) قال النبي :(@)(@@) | 30 ( رحم الله رجلا صلى الغداة ثم خرج يقود مريضا يريد به وجه الله والدار الآخرة ، يكتب الله تعالى له بكل قدم حسنة ويمحو عنه PageV04P417 سيئة ، فإذا جلس عند رأس المريض غرق في الأجر ) )(@)(@@) ( ك ) في تاريخه ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12524 ) قال النبي :(@)(@@) | 30 ( رحم الله عبدا علق في بيته سوطا يؤدب به أهله ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12525 ) قال النبي :(@)(@@) | 30 ( رحم الله من حفظ لسانه ، وعرف زمانه ، واستقامت طريقته ) )(@)(@@) ( ك ) في تاريخه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12526 ) قال النبي :(@)(@@) | 30 ( رحم الله من سمع منا كلمة أو كلمتين أو ثلاثا أو أربعا أو خمسا أو ستا أو سبعا أو ثمانيا ثم علمهن ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12527 ) قال النبي :(@)(@@) | 30 ( رحم الله المتخللين من الطعام وفي الطهور ) )(@)(@@) الديلمي عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12528 ) قال النبي :(@)(@@) | 30 ( رحم الله امرأ سمع مني حديثا فحفظه حتى يبلغه غيره ، فرب حامل فقه إلى من هو أفقه منه ، أو رب حامل فقه ليس بفقيه ، ثلاث خصال لا يغل عليهن قلب مسلم : إخلاص العمل لله ، ومناصحة ولاة الأمور ، ولزوم الجماعة ، فإن دعوتهم تحيط من وراءهم ) )(@)(@@) ( حب ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12529 ) قال النبي :(@)(@@) | 30 ( رحم الله من سمع مني حديثا فبلغه كما سمعه ، فرب مبلغ أوعى له من سامع ) )(@)(@@) ( حب ) عن ابن مسعود 
ms1399	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12530 ) قال النبي :(@)(@@) | 30 ( رحمة الله علينا وعلى موسى لو صبر لرأى من صاحبه العجب ، ولاكنه قال : { إن سألتك عن شيء بعدها فلا تصاحبني قد بلغت من لدني عذرا } ) )(@)(@@) ( د ن ك ) عن ابن عباس وعن أبي بن كعب رضي الله PageV04P418 عنهما ، الباوردي بلفظ : لرأى العجب العجاب .(@)(@@)(@@)(@@) $ ( 12531 ) قال النبي :(@)(@@) | 30 ( رحم الله عبدا ، سمحا قاضيا وسمحا مقتضيا ) )(@)(@@) ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12532 ) قال النبي :(@)(@@) | 30 ( رحم الله إخواني بقزوين ، قيل : يا رسول الله وما قزوين ؟ قال : بلدة في آخر الزمان يقال لها : قزوين الشهيد فيها يعدل عند الله شهداء بدر ) )(@)(@@) الحافظ أبو العلاء العطار في فضائل قزوين والرافعي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12533 ) قال النبي :(@)(@@) | 30 ( رحم الله إخواني بقزوين ثلاثا ، قالوا : يا رسول الله وما قزوين ؟ قال : قزوين أرض من أرض هي اليوم في يد الديلم وستفتح على أمتي ، وتكون رباطا لطوائف من أمتي ، فمن أدرك ذالك فليأخذ بنصيبه من فضل رباط قزوين ، فإنه يستشهد بها قوم يعدلون شهداء بدر ) )(@)(@@) ابن أبي حاتم في فضائل قزوين عن أبي هريرة وابن عباس رضي الله عنهم معا .(@)(@@)(@@)(@@) $ ( 12534 ) قال النبي :(@)(@@) | 30 ( رحم الله إخواني بقزوين ثلاثا ، قالوا : يا رسول الله وما قزوين ؟ قال : باب من أبواب الجنة ، وهي اليوم في يد المشركين ، ستفتح في آخر الزمان على أمتي ، فمن أدرك ذالك الزمان فليأخذ نصيبه من فضل الرباط بقزوين ) )(@)(@@) الخليلي بن عبد الجبار في فضائل قزوين والرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12535 ) قال النبي :(@)(@@) | 30 ( رحمة الله على خلفائي ، قيل : ومن خلفاؤك يا رسول الله ؟ قال : الذين يحيون سنتي ويعلمونها الناس ) )(@)(@@) أبو النصر السجزي في الإبانة ( كر ) عن الحسن بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12536 ) قال النبي :(@)(@@) | 30 ( رحمة الله عليك ، قد كنت وصولا للرحم ، فعولا PageV04P419 للخيرات ، ولولا حزن من بعدك عليك لسرني أن أدعك حتى يجيء من أفواه شتى يعني حمزة ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12537 ) قال النبي :(@)(@@) | 30 
ms1400	 ( رحمك الله يا عثمان ما أصبت من الدنيا ولا أصابت منك يعني ابن مظعون ) )(@)(@@) ( حل ) عن عبد ربه بن سعيد المدني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12538 ) قال النبي :(@)(@@) | 30 ( رحمك الله إن كنت لأوابا تلاء للقرآن قاله لعبد الله ذي البجادين ) )(@)(@@) ( ت ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12539 ) قال النبي :(@)(@@) | 30 ( رحمك الله يا أمي ، كنت أمي بعد أمي ، تجوعين وتشبعينني ، وتعرين وتكسينني ، وتمنعين نفسك طيبا وتطيبينني ، تريدين بذالك وجه الله والدار الآخرة ، الله الذي يحيي ويميت وهو حي لا يموت ، اغفر لأمي فاطمة بنت أسد ، ولقنها حجتها ، ووسع عليه مدخلها بحق نبيك والأنبياء الذين من قبل ، فإنك أرحم الراحمين ) )(@)(@@) ( طب حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الراء مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 12540 ) قال النبي :(@)(@@) | 30 ( رد جواب الكتاب حق كرد السلام ) )(@)(@@) ( عد ) عن أنس بن لال عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 12541 ) قال النبي :(@)(@@) | 30 ( رد سلام المسلم على المسلم صدقة ) )(@)(@@) أبو الشيخ في الثواب عن أبي هريرة رضي الله عنه .(@)(@@) PageV04P420(@)(@@)(@@)(@@) $ ( 12542 ) قال النبي :(@)(@@) | 30 ( ردوا السائل ولو بظلف محرق ) )(@)(@@) ( حم تخ ن ) عن حواء بنت السكن رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12543 ) قال النبي :(@)(@@) | 30 ( ردوا السلام ، وغضوا البصر وأحسنوا الكلام ) )(@)(@@) ابن قانع عن أبي طلحة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12544 ) قال النبي :(@)(@@) | 30 ( ردوا القتلى إلى مضاجعها ) )(@)(@@) ( ت حب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12545 ) قال النبي :(@)(@@) | 30 ( ردوا المخيط والخياط ، من غل مخيطا أو خياطا كلف يوم القيامة أن يجيء به وليس بجاء ) )(@)(@@) ( طب ) عن المستورد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 12546 ) قال النبي :(@)(@@) | 30 ( ردوا مذمة السائل ولو بمثل رأس الذباب ) )(@)(@@) ( عق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 12547 ) قال النبي :(@)(@@) | 30 ( ردوا السائل ولو بظلف محرق ) )(@)(@@) مالك ( حم خ ) في تاريخه ( ن ه حب هق ) عن ابن بحيد الأنصاري عن جدته ابن سعد ( طب ) عن عمرو بن الأنصاري عن جدته حواء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 12548 ) قال النبي :(@)(@@) | 30 ( رديه فيه ثم اعجنيه ) )(@)(@@) ( ه 