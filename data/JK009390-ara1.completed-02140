ms2121	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19603 ) قال النبي :(@)(@@) | 30 ( ما من نفقة بعد صلة الرحم أعظم عند الله من هراقة دم ) )(@)(@@) ( خط ) عن ابن عباس رضي الله عنهما وقال : غريب .(@)(@@) PageV06P409(@)(@@)(@@)(@@) $ ( 19604 ) قال النبي :(@)(@@) | 30 ( ما من نفقة بعد صلة الرحم أفضل وأعظم أجرا من هراقة الدم أيام النحر ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19605 ) قال النبي :(@)(@@) | 30 ( ما من نفس تموت لها عند الله خير وأن لها الدنيا وما فيها يسرها أنها ترجع إلى الدنيا إلا الشهيد فإنه يتمنى أن يرجع إلى الدنيا فيقتل مرة أخرى لما يرى من فضل الشهادة ) )(@)(@@) ( ط حم خ م د ت ع ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19606 ) قال النبي :(@)(@@) | 30 ( ما من والي عشرة إلا جيء به يوم القيامة مغلوبا معذبا أو مغفورا له ) )(@)(@@) ابن منده وأبو نعيم عن الحارث بن محمد عن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19607 ) قال النبي :(@)(@@) | 30 ( ما من والي ثلاثة إلا لقي الله مغلولا يمينه إلى عنقه ، فكه عدله ، أو غله جوره ) )(@)(@@) ( كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19608 ) قال النبي :(@)(@@) | 30 ( ما من وال ولي من أمر المسلمين شيئا فلم يحط من ورائهم بالنصيحة إلا كبه الله على وجهه في جهنم يوم يجمع الله الأولين والآخرين ) )(@)(@@) الحاكم في الكنى ا ( طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19609 ) قال النبي :(@)(@@) | 30 ( ما من والي أمة كثرت أو قلت لم يعدل فيهم إلا كبه الله على وجهه في النار ) )(@)(@@) ( ش طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19610 ) قال النبي :(@)(@@) | 30 ( ما من والي عشرة إلا يأتي يوم القيامة مغلولة يده إلى عنقه ، أطلقه عدله ، وأوبقه جوره ) )(@)(@@) ( ض ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19611 ) قال النبي :(@)(@@) | 30 ( ما من وجع يصيبني أحب إلي من الحمى لأنها تعطي كل عضو قسطه من الأجر ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@) PageV06P410(@)(@@)(@@)(@@) $ ( 19612 ) قال النبي :(@)(@@) | 30 ( ما من وصب يصيب العبد في دار الدنيا ولا نكبة إلا 
ms2122	 كان كفارة لذنب قد سبق منه ، ولم يكن الله ليعود في ذنب قد عاقبه منه ) )(@)(@@) ( الروياني طب كر ) عن بلال بن أبي بردة عن أبيه عن جده أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19613 ) قال النبي :(@)(@@) | 30 ( ما من ولد بار ينظر إلى والديه نظر رحمة إلا كتب الله له بكل نظرة حجة مبرورة ، قالوا : وإن نظر كل يوم مائة مرة ؟ قال : نعم الله أكثر وأطيب ) )(@)(@@) ( ك ) في تاريخه و ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19614 ) قال النبي :(@)(@@) | 30 ( ما من يوم اثنين ولا خميس إلا يرفع فيها الأعمال إلا المتهاجرين ) )(@)(@@) ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19615 ) قال النبي :(@)(@@) | 30 ( ما منكم من أحد يدخله عمله الجنة ، قيل : ولا أنت يا رسول الله ؟ قال : ولا أنا إلا أن يتغمدني الله منه برحمة ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19616 ) قال النبي :(@)(@@) | 30 ( ما منكم من أحد يصيبه شيء إلا رآه في منامه قبل ذالك ، حفظه من حفظه ونسيه من نسيه ) )(@)(@@) ابن لال والديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19617 ) قال النبي :(@)(@@) | 30 ( ما منكم من أحد ينجيه عمله ، قيل : ولا أنت يا رسول الله ؟ قال : ولا أنا إلا أن يتغمدني الله برحمته ، ولاكن سددوا ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19618 ) قال النبي :(@)(@@) | 30 ( ما منكم من أحد إلا سيكلمه ربه ليس بينه وبينه حاجب ولا ترجمان ) )(@)(@@) ( بز ) ابن خزيمة ( ض ) عن عبد الله بن بريدة عن أبيه .(@)(@@)(@@)(@@) $ ( 19619 ) قال النبي :(@)(@@) | 30 ( ما منكم من أحد إلا وله شيطان ، قالوا : ولك يا رسول الله ؟ قال : ولي ، ولاكن الله أعانني عليه فأسلم ، وما منكم من أحد PageV06P411 يدخله عمله الجنة ، قالوا : ولا أنت يا رسول الله ؟ قال : ولا أنا إلا أن يتغمدني ربي برحمته ) )(@)(@@) ( حب ) و البغوي وابن قانع ( طب ) عن شريك بن طارق ، قال البغوي : ولا أعلم له غيره .(@)(@@)(@@)(@@) $ ( 19620 ) قال النبي :(@)(@@) | 30 ( ما منكن امرأة يموت لها ثلاثة من الولد إلا دخلت 
ms2123	 الجنة ، قالت امرأة : وذوات الإثنين ؟ قال : وذوات الإثنين ) )(@)(@@) ( حم طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19621 ) قال النبي :(@)(@@) | 30 ( ما منع قوم الزكاة إلا ابتلاهم الله بالسنين ) )(@)(@@) ( طس ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19622 ) قال النبي :(@)(@@) | 30 ( ما منعك أن تقول الأنصاري فإن مولى القوم منهم ) )(@)(@@) ابن منده عن رشيد الفارسي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19623 ) قال النبي :(@)(@@) | 30 ( ما منعكما من الصلاة معنا ، أفلا صليتم معنا فيكون تطوعا ، وصلاتكم الأولى هي الفريضة ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19624 ) قال النبي :(@)(@@) | 30 ( ما منعك أن تصلي مع الناس ألست برجل مسلم ؟ إذا جئت فصل مع الناس وإن كنت قد صليت ) )(@)(@@) ( طب ) عن ابن محجن عن أبيه .(@)(@@)(@@)(@@) $ ( 19625 ) قال النبي :(@)(@@) | 30 ( ما منعني أن أرد عليك إلا أني كنت غير طاهر ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19626 ) قال النبي :(@)(@@) | 30 ( ما ملأ آدمي وعاء شرا من بطنه ، بحسب ابن آدم PageV06P412 أكلات يقمن صلبه ، فإن كان لا بد فثلث لطعامه ، وثلث لشرابه ، وثلث لنفسه ) )(@)(@@) ابن المبارك ( حم ت ) حسن ( ه ) وابن سعد وابن جرير ( طب هب ك ) عن المقدم بن معديكرب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19627 ) قال النبي :(@)(@@) | 30 ( ما ملأ آدمي وعاء شرا من بطن ، حسبك يا ابن آدم لقيمات يقمن صلبك ، فإن كان لا بد : فثلث طعام ، وثلث شراب ، وثلث نفس ) )(@)(@@) ( حب هب ) عن المقدام بن معديكرب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19628 ) قال النبي :(@)(@@) | 30 ( ما من يوم طلعت شمسه إلا يقول : من استطاع أن يعمل في خيرا فليعمله فإني غير مكر عليكم أبدا ، وما من يوم إلا ينادي مناديان من السماء ، يقول أحدهما : يا طالب الخير أبشر ويقول الآخر : يا طالب الشر أقصر ، ويقول أحدهما : اللهم أعط منفقا خلفا ، ويقول الآخر : اللهم أعط ممسكا مالا تلفا ) )(@)(@@) ( هب ) عن عثمان بن محمد بن المغيرة بن الأخنس مرسلا ( الديلمي ) عنه عن سعيد بن المسيب عن ابن عباس رضي الله عنهما وزاد بعد قوله أبدا : وكذالك يقول الليل .(@)(@@)(@@)(@@) $ ( 19629 ) قال 
ms2124	 النبي :(@)(@@) | 30 ( ما من يوم إلا ينادي مناد : مهلا أيها الناس فإن لله سطوات وبسطات ، ولكم قروح داميات ولولا رجال خشع ، وصبيان رضع ، ودواب رتع لصب عليكم العذاب صبا ، ورضختم به رضخا ) )(@)(@@) ( حل ) عن أبي الزاهرية عن أبي الدرداء وحذيفة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19630 ) قال النبي :(@)(@@) | 30 ( ما من يوم إبليس فيه أدحر ولا أغيظ من يوم عرفة مما يرى من تنزل الرحمة والمجاوزة عن الأمور العظام إلا ما رأى العظام إلا ما رأى يوم بدر ، قيل : وما رأى يوم بدر ؟ قال : رأى جبريل وهو يزع الملائكة ) )(@)(@@) الديلمي عن طلحة بن عبد الله بن كريز عن من له صحبة .(@)(@@)(@@)(@@) $ ( 19631 ) قال النبي :(@)(@@) | 30 ( ما نزل من السماء ملك ، ولا صعد إلى السماء PageV06P413 ملك حتى يقول : لا حول ولا قوة إلا بالله ) )(@)(@@) الديلمي من طريق صفوان بن سليم عن أنس بن مالك عن أبي بكر الصديق عن أبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 19632 ) قال النبي :(@)(@@) | 30 ( ما نقصت صدقة من مال قط ، وما مد عبد يده بصدقة إلا ألقيت في يد الله قبل أن تقع في يد السائل ، ولا فتح عبد باب مسألة له عنها غنى إلا فتح الله عليه باب فقر ) )(@)(@@) ( طس ) و الخرائطي في مكارم الأخلاق عن أم سلمة عن أبي موسى ا رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19633 ) قال النبي :(@)(@@) | 30 ( ما هاذه الكتب التي تبلغني أنكم تكتبونها ، أكتاب مع كتاب الله ؟ يوشك أن يغضب الله لكتابه فيسري عليه ليلا فلا يترك في ورقة ولا قلب منه حرفا إلا ذهب به ، من أراد الله به خيرا أبقى في قلبه لا إلاه إلا الله ) )(@)(@@) ( طس ) عن ابن عباس وابن عمرو رضي الله عنهم معا .(@)(@@)(@@)(@@) $ ( 19634 ) قال النبي :(@)(@@) | 30 ( ما هلك قوم حتى يغدروا من أنفسهم ) )(@)(@@) ابن جرير عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19635 ) قال النبي :(@)(@@) | 30 ( ما هلكت أمة قط إلا بالشرك بالله ، وما أشركت أمة حتى يكون بدء شركها التكذيب بالقدر ) )(@)(@@) ( كر ) عن ابنه عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19636 
ms2125	 ) قال النبي :(@)(@@) | 30 ( ما هلكت أمة قط إلا بالشرك وما كان بدء شركها إلا التكذيب بالقدر ) )(@)(@@) ( كر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19637 ) قال النبي :(@)(@@) | 30 ( ما هممت بما كان أهل الجاهلية يهمون إلا مرتين ، كلاهما يعصمني الله منهما ، قلت ليلة لفتى كان معي من قريش في أعلا مكة في أغنام لأهلها يرعى : أبصر لي غنمي حتى أسمر هاذه الليلة بمكة كما يسمر الفتيان ، قال : نعم ، فخرجت فلما جئت أدنى دار من دور مكة سمعت غناء وصوت دفوف وزمير ، فقلت : ما هاذا ؟ قالوا : فلان تزوج ، فلهوت بذالك الغناء ، PageV06P414 وألهوت حتى غلبتني عيني ، فقمت فما أيقظني إلا مس الشمس ، فرجعت فسمعت مثل ذالك فغلبتني عيني أيضا ، فرجعت ، فقال لي صاحبي : ما فعلت ؟ قلت : ما فعلت شيئا ، فوالله ما هممت بعدها بسوء مما يعمل أهل الجاهلية حتى أكرمني الله تعالى بنبوته ) )(@)(@@) ( ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19638 ) قال النبي :(@)(@@) | 30 ( ما وجدت في طريق ميتاء أو قرية عامرة فعرفه سنة ، فإن لم تجد صاحبه فلك وما وجدت في قرية غير عامرة أو طريق غير ميتاء ففيه الخمس ) )(@)(@@) ( طب ) عن أبي ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19639 ) قال النبي :(@)(@@) | 30 ( ما نفعني مال قط إلا مال أبي بكر ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19640 ) قال النبي :(@)(@@) | 30 ( ما نقض قوم العهد قط إلا كان القتل بينهم ، ولا ظهرت الفاحشة في قوم قط إلا سلط الله عليهم الموت ، ولا منع قوم الزكاة إلا حبس الله عنهم القطر ) )(@)(@@) ( ع ) و الروياني ( ك هق ض ) عن عبد الله بن بريدة عن أبيه .(@)(@@)(@@)(@@) $ ( 19641 ) قال النبي :(@)(@@) | 30 ( ما هلكت أمة قط إلا بالشرك بالله عز وجل ، وما أشركت أمة قط حتى يكون بدء شركها التكذيب بالقدر ) )(@)(@@) ( طب ) و تمام ( كر ) عن يحيى بن القاسم عن أبيه عن جده عبد الله بن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19642 ) قال النبي :(@)(@@) | 30 ( ما هلك سدوم وما حولها من القرى حتى استاكوا بالمساويك ، ومضغوا العلك في المجالس ) )(@)(@@) ( طب 
ms2126	 ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19643 ) قال النبي :(@)(@@) | 30 ( ما هاذه معكم ، أهدية أم صدقة ؟ فإن الصدقة يبتغى بها وجه الله ، وإن الهدية يبتغى بها وجه الرسول وقضاء الحاجة ) )(@)(@@) ( كر ) عن عبد الرحمان بن علقمة رضي الله عنه .(@)(@@) PageV06P415(@)(@@)(@@)(@@) $ ( 19644 ) قال النبي :(@)(@@) | 30 ( ما هاذه ألقها ، وعليكم بهاذه وأشباهها وأرماح القنا ، فإنما يزيد الله لكم بها في الدين ، ويمكن لكم في البلاد ) )(@)(@@) ( ه ) عن علي رضي الله عنه قال : كان بيد رسول الله قوس عربية فرأى رجلا بيده قوس فارسية قال : فذكره .(@)(@@)(@@)(@@) $ ( 19645 ) قال النبي :(@)(@@) | 30 ( ما وضع الله تعالى داء إلا وضع له دواء إلا السام والهرم فعليكم بألبان البقر فإنه يخبط من كل الشجر ) )(@)(@@) ( طب ) و أبو نعيم في الطب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19646 ) قال النبي :(@)(@@) | 30 ( ما وضع من داء في الأرض إلا وقد جعل له شفاء ، علمه من علمه ، وجهله من جهله ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19647 ) قال النبي :(@)(@@) | 30 ( ما وقى به المؤمن عرضه فهو له صدقة ) )(@)(@@) ( ط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19648 ) قال النبي :(@)(@@) | 30 ( ما ورث والد ولده أفضل من أدب حسن ) )(@)(@@) العسكري في الأمثال وابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19649 ) قال النبي :(@)(@@) | 30 ( ما ولدني من سفاح أهل الجاهلية شيء ، ما ولدني إلا نكاح كنكاح الإسلام ) )(@)(@@) ( طب هق كر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19650 ) قال النبي :(@)(@@) | 30 ( ما ولدتني بغي قط منذ خرجت من صلب آدم ، ولم تزل تنازعني الأمم كابرا عن كابر حتى خرجت من أفضل حيين من العرب : هاشم وزهرة ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19651 ) قال النبي :(@)(@@) | 30 ( ما ولد في الإسلام مولود أزكى ولا أطهر ولا أفضل PageV06P416 من أبي بكر ثم عمر ) )(@)(@@) الديلمي ( كر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19652 ) قال النبي :(@)(@@) | 30 ( ما وليت قريش فعدلت ، واسترحمت فرحمت ، وعاهدت فوفت ، ووعدت خيرا فأنجزت ، فأنا والنبيون لها يوم القيامة على الحوض فرطين ) )(@)(@@) الشيرازي في 
