ms621	 عبد الله بن سنان وهو مقبول من الثانية أيضا تمييز(@)(@@)(@@)(@@) $ 8361 أبو مريم الرقي مكاتب عائشة مجهول من الثالثة ق(@)(@@)(@@)(@@) $$$ أبو مريم السلولي اسمه مالك بن ربيعة أو بن خرشه تقدم(@)(@@)(@@)(@@) $$$ أبو مزاحم السمرقندي هو سباع تقدم(@)(@@)(@@)(@@) $ 8362 أبو مزاحم المدني مجهول من الثالثه ت PageV01P672(@)(@@)(@@)(@@) $ 8363 أبو مزرد بتشديد الراء بعد الزاي اسمه عبد الرحمن بن يسار وهو والد معاوية مقبول من الثالثة بخ(@)(@@)(@@)(@@) $$$ أبو المساور هو الفضل بن مساور(@)(@@)(@@)(@@) $$$ أبو مسعود الأنصاري هو عقبة بن عمرو(@)(@@)(@@)(@@) $$$ أبو مسعود الجرار بالجيم وراءين هو عبد الأعلى(@)(@@)(@@)(@@) $$$ أبو مسعود الجريري بالجيم مصغر هو سعيد بن إياس(@)(@@)(@@)(@@) $$$ أبو مسعود الرازي هو أحمد بن الفرات تقدموا(@)(@@)(@@)(@@) $ 8364 أبو مسعود الأنصاري الزرقي مجهول من الثالثة وقيل هو مسعود بن الحكم د(@)(@@)(@@)(@@) $$$ أبو مسكين هو حر بن مسكين(@)(@@)(@@)(@@) $$$ أبو مسكين شيخ لبقية هو طلحة بن زيد(@)(@@)(@@)(@@) $$$ أبو مسلم هو الأغر(@)(@@)(@@)(@@) $$$ أبو مسلم قائد الأعمش هو عبيد الله بن سعيد تقدموا(@)(@@)(@@)(@@) $ 8365 أبو مسلم البجلي مقبول من الرابعة د س(@)(@@)(@@)(@@) $ 8366 أبو مسلم الجذمي بالجيم والمعجمة مقبول من الثالثة ت س(@)(@@)(@@)(@@) $ 8367 أبو مسلم الخولاني الزاهد الشامي اسمه عبد الله بن ثوب بضم المثلثة وفتح الواو بعدها موحدة وقيل بإشباع الواو وقيل بن أثوب بمثلثة وزن أحمر ويقال بن عوف أو بن مشكم ويقال اسمه يعقوب بن عوف ثقة عابد من الثانية رحل إلى النبي صلى الله عليه وسلم فلم يدركه وعاش إلى زمن يزيد بن معاوية م 4(@)(@@)(@@)(@@) $ 8368 أبو مسلم العبدي مولى زيد بن صوحان مقبول من الثالثة ق(@)(@@)(@@)(@@) $$$ أبو مسلمة هو سعيد بن يزيد الأزدي(@)(@@)(@@)(@@) $$$ أبو مسهر هو عبد الأعلى بن مسهر تقدما(@)(@@)(@@)(@@) $ 8369 أبو مشجعة بن ربعي الجهني مقبول من الثانية ق(@)(@@)(@@)(@@) $ 8370 أبو مصبح المقرئي بفتح الميم والراء بينهما قاف ثم همزة قبل ياء النسب ثقة نزل حمص من الثالثة د(@)(@@)(@@)(@@) $$$ أبو مصعب المدني هو أحمد بن أبي بكر(@)(@@)(@@)(@@) $$$ أبو مصعب هو عبد السلام بن مصعب تقدما(@)(@@)(@@)(@@) $ 8371 أبو المصفى المدني مجهول 
ms622	 من السادسة س PageV01P673(@)(@@)(@@)(@@) $ 8372 أبو مصلح الخراساني اسمه نصر بن مشارس بمعجمة ثم مهملة وقيل بتحتانية بدل الألف لين الحديث من السابعة ل(@)(@@)(@@)(@@) $ 8373 أبو مطر شيخ لحجاج بن أرطاة مجهول من السادسة بخ ت س(@)(@@)(@@)(@@) $$$ أبو المطرف بن أبي الوزير هو محمد بن عمر بن مطرف(@)(@@)(@@)(@@) $$$ أبو المطرف الخزاعي هو عبيد الله بن طلحة بن كريز تقدما(@)(@@)(@@)(@@) $ 8374 أبو المطوس هو يزيد وقيل عبد الله بن المطوس لين الحديث من السادسة 4(@)(@@)(@@)(@@) $$$ أبو المطيع بن عوف الأنصاري تقدم في رفاعة د اختلف في اسمه وكنيته على يحيى بن أبي كثير س(@)(@@)(@@)(@@) $$$ أبو معاذ الأزدي هو فضيل بن ميسرة(@)(@@)(@@)(@@) $$$ أبو معاذ البصري هو سليمان بن أرقم(@)(@@)(@@)(@@) $ 8375 أبو معاذ ويقال بالنون بدل الذال وهو أرجح مجهول من السادسة ق(@)(@@)(@@)(@@) $ 8376 أبو معاوية البجلي هو عمار الدهني وإلا فمجهول الحال من السادسة عس(@)(@@)(@@)(@@) $ 8377 أبو معاوية الأشجعي عمرو بن معاوية مجهول من السادسة أيضا ووهم من خلطه بالذي قبله تمييز(@)(@@)(@@)(@@) $$$ أبو معاوية الضرير هو محمد بن خازم(@)(@@)(@@)(@@) $$$ أبو معاوية النحوي هو شيبان بن عبد الرحمن(@)(@@)(@@)(@@) $$$ أبو معاوية النخعي هو عمرو بن عبد الله بن وهب(@)(@@)(@@)(@@) $$$ أبو معاوية العباداني هو سعيد بن زربي تقدموا(@)(@@)(@@)(@@) $$$ أبو معبد مولى بن عباس هو نافذ(@)(@@)(@@)(@@) $$$ أبو معبد السلمي هو مجالد بن مسعود(@)(@@)(@@)(@@) $$$ أبو المعتمر هو يزيد بن طهمان(@)(@@)(@@)(@@) $$$ أبو المعتمر هو حنش بن المعتمر تقدموا(@)(@@)(@@)(@@) $ 8378 أبو المعتمر بن عمرو بن رافع المدني مجهول الحال من السادسة د ق(@)(@@)(@@)(@@) $ 8379 أبو معدان المكي اسمه عبد الله بن معدان ويقال عامر بن زرارة مقبول من السابعة ت(@)(@@)(@@)(@@) $$$ أبو معدان ويقال بن معدان صوابه معدان وهو بن أبي طلحة الذي تقدم س(@)(@@)(@@)(@@) $$$ أبو معشر البراء بالتشديد هو يوسف بن يزيد(@)(@@)(@@)(@@) $$$ أبو معشر الكوفي هو زياد بن كليب(@)(@@)(@@)(@@) $$$ أبو معشر المدني هو نجيح تقدموا(@)(@@)(@@)(@@) $ 8380 أبو معقل الأسدي الأنصاري يقال اسمه الهيثم صحابي وهو والد معقل وزوج أم معقل س ق(@)(@@)(@@)(@@) $ 8381 أبو معقل عن أنس في المسح على 
ms623	 العمامة مجهول من الخامسة د ق PageV01P674(@)(@@)(@@)(@@) $ 8382 أبو المعلى بن لوذان الأنصاري قيل اسمه زيد بن المعلى صحابي له حديث ت(@)(@@)(@@)(@@) $$$ أبو المعلى العطار هو يحيى بن ميمون(@)(@@)(@@)(@@) $$$ أبو معمر الكوفي هو عبد الله بن سخبرة(@)(@@)(@@)(@@) $$$ أبو معمر المنقري هو عبد الله بن عمرو بن أبي الحجاج(@)(@@)(@@)(@@) $$$ أبو معمر الهذلي هو إسماعيل بن إبراهيم(@)(@@)(@@)(@@) $$$ أبو معن الرقاشي هو زيد بن يزيد تقدموا(@)(@@)(@@)(@@) $ 8383 أبو معن الإسكندراني الخولاني أصله من البصرة واسمه عبد الواحد بن أبي موسى ثقة زاهد من السادسة مات بعد الخمسين ومائة س(@)(@@)(@@)(@@) $ 8384 أبو معن محمد بن معن عن زهرة بن معبد وعنه بن المبارك مقبول من السابعة ويقال هو الذي أخرج له النسائي تمييز(@)(@@)(@@)(@@) $ 8385 أبو معن عن أنس مجهول من الخامسة ق(@)(@@)(@@)(@@) $$$ أبو معيد بالتصغير هو حفص بن غيلان(@)(@@)(@@)(@@) $$$ أبو المغلس المكي هو ميمون(@)(@@)(@@)(@@) $$$ أبو المغلس النميري هو عبد ربه بن خالد تقدموا(@)(@@)(@@)(@@) $$$ أبو مغيث بن عمرو هو أبو مروان الأسلمي المتقدم اختلف الرواة في إسناده س(@)(@@)(@@)(@@) $ 8386 أبو المغيرة البجلي أو الخارفي بمعجمة وفاء الكوفي اسمه عبيد بن المغيرة وقيل بن عمرو وقيل المغيرة بن أبي عبيد وقيل الوليد وقيل أبو الوليد المغيرة روى عنه أبو إسحاق السبيعي وحده فهو مجهول من الثالثة س ق(@)(@@)(@@)(@@) $ 8387 أبو المغيرة عن بن عباس في ذم البدعة مجهول من الرابعة ق(@)(@@)(@@)(@@) $ 8388 أبو المغيرة تابعي مجهول أرسل حديثا من الثالثة مد(@)(@@)(@@)(@@) $$$ أبو المغيرة عبد القدوس بن الحجاج تقدم(@)(@@)(@@)(@@) $$$ أبو المفضل في ترجمة أبي الفضل(@)(@@)(@@)(@@) $$$ أبو المقدام هو ثابت بن هرمز الحداد(@)(@@)(@@)(@@) $$$ أبو المقدام المدني هو هشام بن زياد(@)(@@)(@@)(@@) $ 8389 أبو مقاتل السمرقندي مقبول من الثامنة ت(@)(@@)(@@)(@@) $$$ أبو مكين نوح بن ربيعة تقدم(@)(@@)(@@)(@@) $ 8390 أبو المليح بن أسامة بن عمير أو عامر بن عمير بن حنيف بن ناجية الهذلي اسمه عامر وقيل زيد وقيل زياد ثقة من الثالثة مات سنة ثمان وتسعين وقيل ثمان ومائة وقيل بعد ذلك ع PageV01P675(@)(@@)(@@)(@@) $ 8391 أبو المليح الفارسي المدني الخراط اسمه صبيح وقيل 
ms624	 حميد ثقة من السابعة بخ ت ق(@)(@@)(@@)(@@) $$$ أبو المليح الرقي هو الحسن بن عمر(@)(@@)(@@)(@@) $$$ أبو مليكة هو زهير بن عبد الله بن جدعان(@)(@@)(@@)(@@) $$$ أبو المنذر الطفاوي هو محمد بن عبد الرحمن(@)(@@)(@@)(@@) $$$ أبو المنذر إسماعيل بن عمر تقدموا(@)(@@)(@@)(@@) $ 8392 أبو المنذر مولى أبي ذر مقبول من الثالثة د س ق(@)(@@)(@@)(@@) $ 8393 أبو المنذر تابعي من الثانية أرسل حديثا فذكره بعضهم في الصحابة مد(@)(@@)(@@)(@@) $$$ أبو المنذر عن أبي سلمة وعنه مالك صوابه سالم أبو النضر كن(@)(@@)(@@)(@@) $$$ أبو منصور الواسطي هو الحارث بن منصور(@)(@@)(@@)(@@) $ 8394 أبو منظور الشامي مجهول من السادسة د(@)(@@)(@@)(@@) $$$ أبو المنهال البصري هو سيار بن سلامة(@)(@@)(@@)(@@) $$$ أبو المنهال المكي هو عبد الرحمن بن مطعم تقدما(@)(@@)(@@)(@@) $$$ أبو المنهال في عبد الملك بن قتادة بن ملحان(@)(@@)(@@)(@@) $ 8395 أبو المنيب الجرشي بضم الجيم وفتح الراء بعدها معجمة الدمشقي ثقة من الرابعة د(@)(@@)(@@)(@@) $ 8396 أبو المنيب البصري الأحدب مقبول من الثانية ووهم من خلطه بالذي قبله تمييز(@)(@@)(@@)(@@) $$$ أبو المنيب العتكي هو عبيد الله بن عبد الله(@)(@@)(@@)(@@) $$$ أبو المهاجر هو سالم بن عبد الله بن أبي المهاجر تقدم(@)(@@)(@@)(@@) $$$ أبو المهاجر عن عمران بن حصين صوابه أبو المهلب وهم فيه الأوزاعي(@)(@@)(@@)(@@) $$$ أبو المهلب عن بريدة صوابه أبو المليح وهم فيه الأوزاعي أيضا(@)(@@)(@@)(@@) $$$ أبو مهدي الحمصي هو سعيد بن سنان(@)(@@)(@@)(@@) $ 8397 أبو المهزم بتشديد الزاي المكسورة التميمي البصري اسمه يزيد وقيل عبد الرحمن بن سفيان متروك من الثالثة د ت ق(@)(@@)(@@)(@@) $ 8398 أبو المهلب الجرمي البصري عم أبي قلابة اسمه عمرو أو عبد الرحمن بن معاوية أو بن عمرو وقيل النضر وقيل معاوية ثقة من الثانية بخ م 4(@)(@@)(@@)(@@) $$$ أبو المهلب بن يزيد هو مطرح(@)(@@)(@@)(@@) $$$ أبو مودود هو فضة(@)(@@)(@@)(@@) $$$ أبو مودود البصري هو بحر بن موسى(@)(@@)(@@)(@@) $$$ أبو مودود الهذلى هو عبد العزيز بن أبي سليمان تقدموا(@)(@@)(@@)(@@) $ 8399 أبو مودود عن زيد مولى قيس هو بحر بن موسى وإلا فمجهول من السابعة(@)(@@)(@@)(@@) $$$ أبو المورع عن علي هو أبو محمد الهذلي(@)(@@)(@@)(@@) $$$ أبو موسى الأشعري هو عبد الله بن قيس 
ms625	(@)(@@)(@@)(@@) $$$ أبو موسي البصري هو إسرائيل بن موسى تقدموا PageV01P676(@)(@@)(@@)(@@) $ 8400 أبو موسي الحذاء المكي اسمه صهيب مقبول من الرابعة وقيل هما اثنان س(@)(@@)(@@)(@@) $$$ أبو موسي العنزي هو محمد بن المثنى(@)(@@)(@@)(@@) $$$ أبو موسي الهمداني هو مالك بن الحارث تقدما(@)(@@)(@@)(@@) $$$ أبو موسي عن عمرو بن عبيد هو إسرائيل بن موسى المذكور(@)(@@)(@@)(@@) $ 8401 أبو موسي الهلالي مقبول من الثانية د(@)(@@)(@@)(@@) $ 8402 أبو موسى عن جابر في صلاة الخوف هو علي بن رباح وقيل مالك بن عبادة الغافقي الصحابي خت(@)(@@)(@@)(@@) $ 8403 أبو موسي شيخ لمعاوية بن صالح مجهول من السادسة د(@)(@@)(@@)(@@) $ 8404 أبو موسي عن وهب بن منبه مجهول من السادسة ووهم من قال إنه إسرائيل بن موسى د ت س(@)(@@)(@@)(@@) $ 8405 أبو المؤمن بتشديد الميم ويقال آخره راء مقبول من الثالثة عس(@)(@@)(@@)(@@) $ 8406 أبو ميسرة العابد مجهول الحال من التاسعة د(@)(@@)(@@)(@@) $$$ أبو ميسرة الكوفي هو عمرو بن شرحبيل تقدم(@)(@@)(@@)(@@) $ 8407 أبو ميمون عن رافع بن خديج مجهول من الرابعة س(@)(@@)(@@)(@@) $ 8408 أبو ميمونة الفارسي المدني الأبار قيل اسمه سليم أو سلمان أو سلمى وقيل أسامة ثقة من الثالثة ومنهم من فرق بين الفارسي والأبار وكل منهما مدني يروي عن أبي هريرة فالله أعلم PageV01P677(@)(@@)(@@)(@@) || ( حرف النون )(@)(@@)(@@)(@@) $$$ أبو نباتة المدني هو يونس بن يحيى(@)(@@)(@@)(@@) $$$ أبو النجاشي هو عطاء بن صهيب تقدما(@)(@@)(@@)(@@) $ 8409 أبو النجيب العامري مولى بن أبي سرح بالنون ويقال بالمثناة المضمومة يقال اسمه ظليم مقبول من الرابعة مات بإفريقية سنة ثمان وثمانين من الهجرة بخ د س(@)(@@)(@@)(@@) $$$ أبو نجيح السلمي صحابيان أحدهما عمرو بن عبسة والآخر العرباض بن سارية تقدما(@)(@@)(@@)(@@) $$$ أبو نجيح المكي والد عبد الله اسمه يسار تقدم في التحتانية(@)(@@)(@@)(@@) $ 8410 أبو نخيلة بالمعجمة ويقال بالمهملة البجلي صحابي له رواية عن جرير بن عبد الله حسب بخ س(@)(@@)(@@)(@@) $ 8411 أبو نصر الأسدي مجهول من الرابعة خت(@)(@@)(@@)(@@) $$$ أبو نصر التمار هو عبد الملك بن عبد العزيز(@)(@@)(@@)(@@) $$$ أبو نصر الضبي هو عبد الله بن عبد الرحمن(@)(@@)(@@)(@@) $$$ أبو نصر عن أنس هو خيثمة بن أبي خيثمة 
ms626	 تقدموا(@)(@@)(@@)(@@) $ 8412 أبو نصر الهلالي مجهول من السادسة س(@)(@@)(@@)(@@) $ 8413 أبو نصر الهلالي آخر يقال له صحبة والا فمجهول من شيوخ قتادة من الثالثة س(@)(@@)(@@)(@@) $$$ أبو نصر شيخ لعمرو بن مرة هو حميد بن هلال س(@)(@@)(@@)(@@) $ 8414 أبو نصيرة بالتصغير الواسطي اسمه مسلم بن عبيد ثقة من الخامسة د ت(@)(@@)(@@)(@@) $$$ أبو النضر البغدادي هو هاشم بن القاسم(@)(@@)(@@)(@@) $$$ أبو النضر الفراديسي هو إسحاق بن إبراهيم(@)(@@)(@@)(@@) $$$ أبو النضر سالم المدني(@)(@@)(@@)(@@) $$$ أبو نضرة العبدي هو المنذر بن مالك بن قطعة(@)(@@)(@@)(@@) $$$ أبو نعامة الحنفي هو قيس بن عباية(@)(@@)(@@)(@@) $$$ أبو نعامة العدوي هو عمرو بن عيسى تقدموا(@)(@@)(@@)(@@) $$$ أبو نعامة العدوي آخر اسمه حريث بن مالك ذكره بن حبان تمييز PageV01P678(@)(@@)(@@)(@@) $ 8415 أبو نعامة السعدي اسمه عبد ربه وقيل عمرو ثقة من السادسة م د ت س(@)(@@)(@@)(@@) $$$ أبو النعمان السدوسي هو محمد بن الفضل عارم تقدم(@)(@@)(@@)(@@) $ 8416 أبو النعمان عن أبي وقاص مجهول من السادسة د ت(@)(@@)(@@)(@@) $$$ أبو نعيم الملائي هو الفضل بن دكين(@)(@@)(@@)(@@) $$$ أبو نعيم الطحان هو ضرار بن صرد(@)(@@)(@@)(@@) $$$ أبو نعيم النخعي الكوفى الصغير هو عبد الرحمن بن هانئ تقدموا(@)(@@)(@@)(@@) $ 8417 أبو نعيم النخعي الكبير الكوفي هو عبد الرحمن بن نعيم مقبول من السابعه تمييز(@)(@@)(@@)(@@) $$$ أبو نعيم الحلبي هو عبيد بن هشام تقدم(@)(@@)(@@)(@@) $$$ أبو نهار الأزدي هو عقبة بن عبد الغافر مشهور باسمه تقدم(@)(@@)(@@)(@@) $ 8418 أبو نملة الأنصاري صحابي قال الواقدي اسمه عمار وقال بن سعد عمرو وقال غيره عمارة وهو بن معاذ بن زرارة من بني ظفر من الأوس شهد أحدا وقيل إنه شهد بدرا د(@)(@@)(@@)(@@) $ 8419 أبو نهيك بفتح أوله الأزدي البصري القارىء اسمه عثمان بن نهيك ثقة من الثالثة بخ د(@)(@@)(@@)(@@) $ 8420 أبو نهيك الأسدي أو الضبي اسمه القاسم بن محمد مقبول من السادسة تمييز(@)(@@)(@@)(@@) $$$ أبو نوح لقبه قراد بضم القاف وتخفيف الراء واسمه عبد الرحمن بن غزوان تقدم(@)(@@)(@@)(@@) $ 8421 أبو نوفل بن أبي عقرب الكناني العربجي بفتح المهملة وكسر الراء وبالجيم اسمه مسلم وقيل عمرو بن مسلم وقيل معاوية بن مسلم 
ms627	 ثقة من الثالثة خ م د س PageV01P679(@)(@@)(@@)(@@) || ( حرف الهاء )(@)(@@)(@@)(@@) $$$ أبو هارون العبدي اسمه عمارة بن جوين تقدم(@)(@@)(@@)(@@) $ 8422 أبو هارون الغنوي بفتح المعجمة والنون اسمه إبراهيم بن العلاء ثقة من السادسة له في البخاري موضع واحد في الجنائز خ(@)(@@)(@@)(@@) $$$ أبو هارون المدني هو موسى بن أبي عيسى تقدم(@)(@@)(@@)(@@) $ 8423 أبو هاشم بن عتبة بن ربيعة بن عبد شمس القرشي العبشمي قيل اسمه خالد وقيل شيبة وقيل هاشم وقيل مهشم وقيل هشام صحابي من مسلمة الفتح مات في خلافة عثمان ت س ق(@)(@@)(@@)(@@) $ 8424 أبو هاشم الدوسي بن عم أبي هريرة مجهول الحال من الثالثة د(@)(@@)(@@)(@@) $ 8425 أبو هاشم الرماني بضم الراء وتشديد الميم الواسطي اسمه يحيى بن دينار وقيل بن الأسود وقيل بن نافع ثقة من السادسة مات سنة اثنتين وعشرين وقيل سنة خمس وأربعين ع(@)(@@)(@@)(@@) $$$ أبو هاشم الخارفي اسمه القاسم بن كثير(@)(@@)(@@)(@@) $$$ أبو هاشم الزعفراني اسمه عمار بن عمارة(@)(@@)(@@)(@@) $$$ أبو هاشم المكي إسماعيل بن كثير تقدموا(@)(@@)(@@)(@@) $$$ أبو هانئ الخولاني هو حميد بن هانئ(@)(@@)(@@)(@@) $$$ أبو هبيرة الشيباني هو يحيى بن عباد(@)(@@)(@@)(@@) $$$ أبو هبيرة الدمشقي هو محمد بن الوليد بن هبيرة(@)(@@)(@@)(@@) $$$ أبو الهذيل غالب بن الهذيل تقدموا(@)(@@)(@@)(@@) $ 8426 أبو هريرة الدوسي الصحابي الجليل حافظ الصحابة اختلف في اسمه واسم أبيه قيل عبد الرحمن بن صخر وقيل بن غنم وقيل عبد الله بن عائذ وقيل بن عامر وقيل بن عمرو وقيل سكين بن ودمة بن هانئ وقيل بن مل وقيل بن صخر وقيل عامر بن عبد شمس وقيل بن عمير وقيل يزيد بن عشرقة وقيل عبد نهم وقيل عبد شمس وقيل غنم وقيل عبيد بن غنم وقيل عمرو بن غنم وقيل بن عامر وقيل سعيد بن الحارث هذا الذي وقفنا عليه من الاختلاف في ذلك ونقطع بأن عبد شمس وعبدنهم غير بعد أن أسلم واختلف في أيها أرجح فذهب كثيرون إلى الأول وذهب جمع من النسابين إلى عمرو بن عامر مات سنة سبع وقيل سنة ثمان وقيل تسع وخمسين وهو بن ثمان 
ms628	 وسبعين سنة ع PageV01P680(@)(@@)(@@)(@@) $$$ أبو هريرة الصيرفي اسمه محمد بن فراس تقدم(@)(@@)(@@)(@@) $$$ أبو هشام الرفاعي هو محمد بن يزيد بن رفاعة(@)(@@)(@@)(@@) $$$ أبو هشام المخزومي هو المغيرة بن سلمة تقدما(@)(@@)(@@)(@@) $$$ أبو همام الأهوازي هو محمد بن الزبرقان(@)(@@)(@@)(@@) $$$ أبو همام الدلال هو محمد بن محبب(@)(@@)(@@)(@@) $$$ أبو همام السكوني هو الوليد بن شجاع(@)(@@)(@@)(@@) $$$ أبو همام الكوفي هو عبد الله بن يسار تقدموا(@)(@@)(@@)(@@) $ 8427 أبو هند البجلي شامي مقبول من الثالثة د س(@)(@@)(@@)(@@) $ 8428 أبو هند الصديق مجهول قيل اسمه إبراهيم بن ميمون الصائغ وإلا فهو مجهول من السادسة ق(@)(@@)(@@)(@@) $ 8429 أبو هند الهمداني الكوفي اسمه الحارث بن عبد الرحمن مقبول من السابعة بخ عس(@)(@@)(@@)(@@) $$$ أبو هلال الراسبي محمد بن سليم تقدم(@)(@@)(@@)(@@) $$$ أبو هلال عن عمر بن عبد العزيز صوابه هلال وهو أبو طعمة المتقدم(@)(@@)(@@)(@@) $$$ أبو الهياج الأسدي حيان بن حصين تقدم(@)(@@)(@@)(@@) $$$ أبو الهيثم العتواري هو سليمان بن عمرو بن عبيد تقدم(@)(@@)(@@)(@@) $ 8430 أبو الهيثم بن نصر بن دهر الأسلمي مقبول من الثالثة وقيل اسمه عامر س(@)(@@)(@@)(@@) $ 8431 أبو الهيثم المرادي الكوفي صاحب القصب صدوق من السادسة وقيل اسمه عمار مد(@)(@@)(@@)(@@) $ 8432 أبو الهيثم المصري مولى عقبة بن عامر مقبول من الخامسة بخ د س PageV01P681(@)(@@)(@@)(@@) || 1 ( الواو )(@)(@@)(@@)(@@) $ 8433 أبو واقد الليثي صحابي قيل اسمه الحارث بن مالك وقيل بن عوف وقيل اسمه عوف بن الحارث مات سنة ثمان وستين وهو بن خمس وثمانين على الصحيح ع(@)(@@)(@@)(@@) $$$ أبو واقد الليثي الصغير هو صالح بن محمد بن زائدة تقدم(@)(@@)(@@)(@@) $$$ أبو وائل الأسدي هو شقيق بن سلمة(@)(@@)(@@)(@@) $$$ أبو وائل الصنعاني هو عبد الله بن بحير تقدما(@)(@@)(@@)(@@) $$$ أبو وجزة بفتح الواو وسكون الجيم بعدها زاي هو يزيد بن عبيد تقدم(@)(@@)(@@)(@@) $$$ أبو الوداك بفتح الواو وتشديد الدال وآخره كاف هو جبر بن نوف تقدم(@)(@@)(@@)(@@) $ 8434 أبو الورد بن ثمامة بن حزن القشيري البصري مقبول من السادسة بخ د ت عس(@)(@@)(@@)(@@) $ 8435 أبو الورد المازني صحابي سكن مصر اسمه حرب وقيل عبيد بن قيس وقيل ثمامة بن نهيك له حديث واحد 
ms629	 ق(@)(@@)(@@)(@@) $ 8436 أبو الورد صحابي آخر روى عنه ولده تمييز(@)(@@)(@@)(@@) $$$ أبو الورقاء هو فائد بن عبد الرحمن تقدم في الفاء(@)(@@)(@@)(@@) $$$ أبو الوضىء بفتح الواو وكسر المعجمة المخففة مهموز هو عباد بن نسيب تقدم(@)(@@)(@@)(@@) $ 8437 أبو وقاص شيخ لأبي النعمان مجهول من الثالثة د ت(@)(@@)(@@)(@@) $$$ أبو وكيع بن مليح هو الجراح(@)(@@)(@@)(@@) $$$ أبو وكيع الشيباني هو عنترة بن عبد الرحمن(@)(@@)(@@)(@@) $$$ أبو الوليد بن أبي الجارود المكي اسمه موسى(@)(@@)(@@)(@@) $$$ أبو الوليد البسري هو أحمد بن عبد الرحمن بن بكار(@)(@@)(@@)(@@) $$$ أبو الوليد الطيالسي هو هشام بن عبد الملك(@)(@@)(@@)(@@) $$$ أبو الوليد نسيب بن سيرين هو عبد الله بن الحارث(@)(@@)(@@)(@@) $$$ أبو الوليد المجاشعي اسمه بركة تقدموا(@)(@@)(@@)(@@) $ 8438 أبو الوليد المكي عن جابر هو سعيد بن مينا وقيل يسار بن عبد الرحمن شيخ مقبول من الرابعة م(@)(@@)(@@)(@@) $ 8439 أبو الوليد عن بن عمر قيل هو نسيب بن سيرين وقال أبو حاتم هو مولى رواحة وهو أرجح وهو مجهول من الرابعة د(@)(@@)(@@)(@@) $$$ أبو الوليد المغيرة أو أبو المغيرة الوليد تقدم في أبي المغيرة(@)(@@)(@@)(@@) $$$ أبو الوليد هو عبيد تقدم(@)(@@)(@@)(@@) $ 8440 أبو وهب الجشمي صحابي سكن الشام له حديث بخ د س PageV01P682(@)(@@)(@@)(@@) $ 8441 أبو وهب الجيشاني بفتح الجيم وسكون التحتانية بعدها معجمة المصري قيل اسمه ديلم بن هوشع وقال بن يونس هو عبيد بن شرحبيل مقبول من الرابعة د ت ق(@)(@@)(@@)(@@) $$$ أبو وهب الكلاعي اسمه عبيد الله بن عبيد(@)(@@)(@@)(@@) $ 8442 أبو وهب الكلاعي آخر مقبول من الرابعة تمييز(@)(@@)(@@)(@@) $$$ أبو وهب المروزي هو محمد بن مزاحم تقدم(@)(@@)(@@)(@@) || 1 ( اللام ألف )(@)(@@)(@@)(@@) $$$ أبو لاس الخزاعي صحابي ويقال له بن لاس قيل هو عبد الله بن عنمة والصواب أنه غيره خت PageV01P683(@)(@@)(@@)(@@) || 1 ( الياء )(@)(@@)(@@)(@@) $$$ أبو يحيى الأسلمي اسمه سمعان(@)(@@)(@@)(@@) $$$ أبو يحيى الأعرج ويقال الأجرد المعرقب اسمه مصدع(@)(@@)(@@)(@@) $$$ أبو يحيى البزاز صاعقة هو محمد بن عبد الرحيم(@)(@@)(@@)(@@) $$$ أبو يحيى التيمى الكوفي هو إسماعيل بن إبراهيم(@)(@@)(@@)(@@) $$$ أبو يحيى التيمي المدني هو عبيد الله بن عبد الله بن موهب تقدموا(@)(@@)(@@)(@@) $ 8443 أبو يحيى التيمي المدني آخر اسمه إسماعيل 
ms630	 بن عبد الله متروك من الثامنة تمييز(@)(@@)(@@)(@@) $$$ أبو يحيى الحماني هو عبد الحميد بن عبد الرحمن(@)(@@)(@@)(@@) $$$ أبو يحيى الطويل هو عمران بن زيد تقدم(@)(@@)(@@)(@@) $ 8444 أبو يحيى القتات بقاف ومثناة مثقلة وآخره مثناة أيضا الكوفي اسمه زاذان وقيل دينار وقيل مسلم وقيل يزيد وقيل زبان وقيل عبد الرحمن لين الحديث من السادسة بخ د ت ق(@)(@@)(@@)(@@) $$$ أبو يحيى القرشي هو زياد تقدم ويقال فيه مولى الأنصار ومولى قيس بن مخرمة(@)(@@)(@@)(@@) $ 8445 أبو يحيى المكي يقال هو مصدع وإلا فهو مجهول من السادسة ق(@)(@@)(@@)(@@) $ 8446 أبو يحيى المكي يقال هو سمعان الأسلمي مقبول من الرابعة عخ د س ق(@)(@@)(@@)(@@) $ 8447 أبو يحيى مولى آل جعدة المخزومي مدني مقبول من الرابعة بخ س ق(@)(@@)(@@)(@@) $$$ أبو يحيى عن سعيد بن أبي عروبة هو الحماني المتقدم ق(@)(@@)(@@)(@@) $ 8448 أبو يحيى عن أبي هشام الرفاعي اسمه عبد الحي بن سويد روى عنه بن ماجة لا يعرف حاله من الثانية عشرة والذي يظهر أنه من شيوخ بن القطان صاحب بن ماجة ق(@)(@@)(@@)(@@) $$$ أبو يزيد الأسدي الوالبي هو وقاء بن إياس تقدم(@)(@@)(@@)(@@) $ 8449 أبو يزيد الخولاني المصري مجهول من الرابعة ت(@)(@@)(@@)(@@) $ 8450 أبو يزيد الخولاني المصري آخر صدوق من السابعة وسماه الحاكم يزيد بن مسلم فوهم د ق(@)(@@)(@@)(@@) $ 8451 أبو يزيد الضني بكسر المعجمة وتشديد النون مجهول من الرابعة س ق(@)(@@)(@@)(@@) $ 8452 أبو يزيد المدني نزيل البصرة مقبول من الرابعة خ س PageV01P684(@)(@@)(@@)(@@) $ 8453 أبو يزيد المكي حليف بني زهرة يقال له صحبة وهو والد عبيد الله ووثقه بن حبان من الثانية د ت ق(@)(@@)(@@)(@@) $$$ أبو يزيد الهنائي هو يحيى بن يزيد تقدم(@)(@@)(@@)(@@) $$$ أبو يزيد آخر في ترجمة معن بن يزيد شيخ سهيل بن ذراع(@)(@@)(@@)(@@) $$$ أبو يسار عن وهب صوابه أبو سنان وهو سعيد بن سنان(@)(@@)(@@)(@@) $ 8454 أبو يسار عن أبي هاشم الدوسي مجهول الحال من السادسة د(@)(@@)(@@)(@@) $$$ أبو اليسر بفتحتين السلمي بفتحتين أيضا الصحابي هو كعب بن عمرو تقدم(@)(@@)(@@)(@@) $$$ أبو يعفور الأكبر اسمه واقد ويقال وقدان(@)(@@)(@@)(@@) $$$ أبو 
ms631	 يعفور الأصغر هو عبد الرحمن بن عبيد بن نسطاس تقدما(@)(@@)(@@)(@@) $$$ أبو يعقوب البغدادي هو إسحاق بن أبي إسرائيل(@)(@@)(@@)(@@) $$$ أبو يعقوب البويطي هو يوسف بن يحيى(@)(@@)(@@)(@@) $$$ أبو يعقوب التوأم هو عبد الله بن يحيى الثقفي تقدموا(@)(@@)(@@)(@@) $ 8455 أبو يعقوب التوأم آخر اسمه يوسف بن نافع بصري مستور من العاشرة تمييز(@)(@@)(@@)(@@) $$$ أبو يعقوب الثقفي اسمه إسحاق بن إبراهيم(@)(@@)(@@)(@@) $$$ أبو يعقوب الحنيني اسمه إسحاق بن إبراهيم أيضا تقدما(@)(@@)(@@)(@@) $$$ أبو يعلى هو محمد بن الصلت التوزي(@)(@@)(@@)(@@) $$$ أبو يعلى هو منذر بن يعلى الثوري تقدما(@)(@@)(@@)(@@) $$$ أبو اليقظان هو عثمان بن عمير البجلي تقدم(@)(@@)(@@)(@@) $$$ أبو اليمان هو الحكم بن نافع تقدم(@)(@@)(@@)(@@) $ 8456 أبو اليمان الرحال المدني اسمه كثير بن يمان ويقال بن جريج مستور من السابعة د(@)(@@)(@@)(@@) $$$ أبو اليمان هو معلى بن راشد النبال(@)(@@)(@@)(@@) $$$ أبو اليمان الهوزني هو عبد الله بن عامر بن لحي تقدما(@)(@@)(@@)(@@) $ 8457 أبو اليمان المصري وقع كذلك في الطهارة والصواب أبو لقمان واسمه محمد بن عبد الله بن خالد الخراساني مستور من الحادية عشرة ق(@)(@@)(@@)(@@) $$$ أبو يوسف الفارسي هو يعقوب بن سفيان تقدم(@)(@@)(@@)(@@) $$$ أبو يونس القشيري هو حاتم بن أبي صغيرة(@)(@@)(@@)(@@) $$$ أبو يونس القوي هو الحسن بن يزيد(@)(@@)(@@)(@@) $$$ أبو يونس مولى أبي هريرة هو سليم بن جبير(@)(@@)(@@)(@@) $$$ أبو يونس سالم هو بن أبي حفصة تقدموا(@)(@@)(@@)(@@) $ 8458 أبو يونس مولى عائشة ثقة من الثالثة بخ م د ت س PageV01P685(@)(@@)(@@)(@@) | ( باب من نسب إلى أبيه أو أمه أو جده أو عمه ونحو ذلك على ترتيب الحروف )(@)(@@)(@@)(@@) $$$ بن أبجر هو عبد الملك بن سعيد بن حيان(@)(@@)(@@)(@@) $$$ بن أبزى هو عبد الرحمن وأبناه عبد الله وسعيد(@)(@@)(@@)(@@) $$$ بن أبي بن كعب هو محمد وله بن آخر اسمه عبد الله(@)(@@)(@@)(@@) $$$ بن الأجلح هو عبد الله(@)(@@)(@@)(@@) $$$ بن إدريس الكوفي هو عبد الله(@)(@@)(@@)(@@) $$$ بن إدريس الشافعي هو محمد(@)(@@)(@@)(@@) $$$ بن أردك هو عبد الرحمن بن حبيب(@)(@@)(@@)(@@) $$$ بن أرقم هو عبد الله صحابي(@)(@@)(@@)(@@) $$$ بن أرقم أيضا سليمان من أتباع التابعين(@)(@@)(@@)(@@) $$$ بن إسحاق هو محمد(@)(@@)(@@)(@@) $$$ بن الأسقع البكري صحابي من أصحاب الصفة له 
ms632	 حديث وقيل هو واثلة(@)(@@)(@@)(@@) $$$ بن أبي الأسود هو عبد الله بن محمد يكنى أبا بكر(@)(@@)(@@)(@@) $$$ بن الأشجعي هو أبو عبيدة بن عبيد الله بن عبيد الرحمن(@)(@@)(@@)(@@) $$$ بن أشوع هو سعيد بن عمرو(@)(@@)(@@)(@@) $$$ بن الأصبهاني هو عبد الرحمن بن عبد الله وابن أخيه محمد بن سليمان وابن بن أخيه محمد بن سعيد بن سليمان(@)(@@)(@@)(@@) $$$ بن أعبد اسمه علي(@)(@@)(@@)(@@) $$$ بن أفلح هو عمرو ويقال عمر بن كثير(@)(@@)(@@)(@@) $$$ بن أقرم هو عبد الله(@)(@@)(@@)(@@) $$$ بن أكيمة هو عمارة وقيل عمرو وحفيده عمرو بن مسلم وقيل عمر(@)(@@)(@@)(@@) $$$ بن أبي أمية هو عامر(@)(@@)(@@)(@@) $$$ بن أبي أنس شيخ الزهري هو أبو سهيل نافع بن مالك بن أبي عامر(@)(@@)(@@)(@@) $$$ بن أنعم هو عبد الرحمن بن زياد(@)(@@)(@@)(@@) $ 8459 بن أبي أوس الثقفي يقال اسمه عبد الرحمن ويقال هو بن عمرو بن أوس PageV01P686(@)(@@)(@@)(@@) $$$ بن أبي أوفى هو عبد الله(@)(@@)(@@)(@@) $$$ بن أبي أويس هو إسماعيل(@)(@@)(@@)(@@) $$$ بن أبي أيوب هو سعيد(@)(@@)(@@)(@@) $$$ بن باباه ويقال بن بأبيه ويقال بن بابي اسمه عبد الله وقيل هم ثلاثة(@)(@@)(@@)(@@) $$$ بن بجدان هو عمرو(@)(@@)(@@)(@@) $$$ بن بجيد هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن بحينة هو عبد الله بن مالك(@)(@@)(@@)(@@) $$$ بن بذيمة اسمه علي(@)(@@)(@@)(@@) $$$ بن البراء هو عبيد(@)(@@)(@@)(@@) $$$ بن براد الأشعري هو عبد الله(@)(@@)(@@)(@@) $$$ بن أبي بردة هو سعيد(@)(@@)(@@)(@@) $$$ بن بريدة هو عبد الله وأخوه سليمان قال البزار حيث روى علقمة بن مرثد ومحارب ومحمد بن جحادة عن بن بريدة فهو سليمان وكذا الأعمش عندي وأما من عداهم فهو عبد الله(@)(@@)(@@)(@@) $$$ ابنا بسر السلميان هما عبد الله وعطية صحابيان(@)(@@)(@@)(@@) $$$ بن بشار هو محمد ولقبه بندار(@)(@@)(@@)(@@) $$$ بن بشر العبدي هو محمد(@)(@@)(@@)(@@) $$$ بن أبي بصير هو عبد الله العبدي(@)(@@)(@@)(@@) $$$ بن بكر البرساني هو محمد(@)(@@)(@@)(@@) $$$ بن أبي بكر عن أم سلمة هو عبد الله بن عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي بكرة هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن بكير هو يحيى بن عبد الله بن بكير نسب لجده(@)(@@)(@@)(@@) $$$ بن أبي بكير هو يحيى الكرماني(@)(@@)(@@)(@@) $$$ بن أبي بلال هو عبد الله(@)(@@)(@@)(@@) $$$ بن البيلماني هو محمد بن عبد الرحمن تقدموا 
ms633	(@)(@@)(@@)(@@) $$$ بن تعلى اسمه عبيد(@)(@@)(@@)(@@) $$$ بن التلب هو ملقام تقدما(@)(@@)(@@)(@@) $$$ بن أبي ثابت هو حبيب كوفي ولهم آخر اسمه عبد العزيز مدني(@)(@@)(@@)(@@) $$$ بن أبي الثلج هو محمد بن عبد الله بن إسماعيل(@)(@@)(@@)(@@) $$$ بن ثوبان هو محمد بن عبد الرحمن مدني وعبد الرحمن بن ثابت شامي PageV01P687(@)(@@)(@@)(@@) $$$ بن أبي ثور جعفر وعبيد الله بن عبد الله تقدموا(@)(@@)(@@)(@@) $$$ بن جابر بن عبد الله عن جابر في قتلى أحد هو عبد الرحمن أو محمد ق(@)(@@)(@@)(@@) $$$ بن جابر بن عتيك عن أبيه في الغيرة هو عبد الرحمن أو أخ له لم يسم د س(@)(@@)(@@)(@@) $$$ بن جابر هو عبد الرحمن بن يزيد بن جابر(@)(@@)(@@)(@@) $$$ بن الجارود هو عبد الحميد بن المنذر(@)(@@)(@@)(@@) $$$ بن جبر هو عبد الله بن عبد الله(@)(@@)(@@)(@@) $$$ بن جبير بن مطعم كأنه نافع(@)(@@)(@@)(@@) $$$ بن جدعان هو علي بن زيد بن جدعان(@)(@@)(@@)(@@) $$$ بن جرهد في ترجمة جرهد(@)(@@)(@@)(@@) $$$ بن جريج الفقيه هو عبد الملك بن عبد العزيز بن جريج(@)(@@)(@@)(@@) $$$ بن جرير البجلي كأنه عبيد الله(@)(@@)(@@)(@@) $$$ بن جرير الضبي هو غزوان(@)(@@)(@@)(@@) $$$ بن جزء هو عبد الله بن الحارث(@)(@@)(@@)(@@) $$$ بن جعدبة هو يزيد بن عياض(@)(@@)(@@)(@@) $$$ بن أبي الجعد هو سالم(@)(@@)(@@)(@@) $$$ بن أبي جعفر المصري هو عبيد الله تقدموا(@)(@@)(@@)(@@) $$$ بن جودان في جودان(@)(@@)(@@)(@@) $$$ بن أبي الجون هو عبد الرحمن بن سليمان تقدم(@)(@@)(@@)(@@) $$$ بن أبي حازم هو عبد العزيز(@)(@@)(@@)(@@) $$$ بن حبان بفتح الحاء المهملة عن بن سلام هو محمد بن يحيى بن حبان(@)(@@)(@@)(@@) $$$ بن حبتر هو قيس تقدموا(@)(@@)(@@)(@@) $$$ بن حبيب بن أبي ثابت في ترجمة يحيى بن حبيب بن إسماعيل بن عبد الله بن حبيب بن أبي ثابت(@)(@@)(@@)(@@) $$$ بن أبي حبيب المصري يزيد(@)(@@)(@@)(@@) $$$ بن أبي حبيبة إبراهيم بن إسماعيل(@)(@@)(@@)(@@) $$$ بن أبي حثمة هو سليمان وولداه أبو بكر ومحمد(@)(@@)(@@)(@@) $$$ بن أبي الحجاج هو يحيى تقدموا(@)(@@)(@@)(@@) $ 8460 بن الحجاج الطائي أرسل حديثا وهو مجهول من الثالثة لا يعرف اسمه مد(@)(@@)(@@)(@@) $ 8461 بن حجير العدوى لم يسم وهو مستور من الثانية د(@)(@@)(@@)(@@) $$$ بن حجيرة المصري اسمه عبد الرحمن(@)(@@)(@@)(@@) $$$ بن حجيرة الأصغر اسمه عبد الله 
ms634	 وهو ولد الذي قبله(@)(@@)(@@)(@@) $$$ بن أبي حدرد اسمه عبد الرحمن تقدموا PageV01P688(@)(@@)(@@)(@@) $ 8462 بن حدير بصري مستور لا يعرف اسمه من الرابعة د(@)(@@)(@@)(@@) $$$ بن أبي الحر هو حصين العنبري والمغيرة الكندي(@)(@@)(@@)(@@) $$$ بن حرب الأبرش الخولاني اسمه محمد تقدموا(@)(@@)(@@)(@@) $ 8463 بن حرشف الأزدي كأنه تميم الذي روى عن قتادة وهو مجهول من السادسة د(@)(@@)(@@)(@@) $$$ بن حرملة الأسلمى هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي حرملة اسمه محمد(@)(@@)(@@)(@@) $$$ بن حزم في حديث الإسراء هو أبو بكر بن محمد بن عمرو بن حزم(@)(@@)(@@)(@@) $$$ بن حزن صحابي له في رعي الغنم اسمه نصر وقيل عبدة وقيل بشر(@)(@@)(@@)(@@) $ 8464 بن حسنة الجهني مستور لم يسم من الثالثة بخ(@)(@@)(@@)(@@) $$$ بن أبي حسين عبد الله بن عبد الرحمن وعمر بن سعيد مكيان(@)(@@)(@@)(@@) $$$ بن الحضرمي هو العلاء(@)(@@)(@@)(@@) $$$ بن أبي حفصة عن الزهري هو محمد وشيخ شعبة هو عمارة ولهم ثالث وهو سالم تقدموا(@)(@@)(@@)(@@) $ 8465 بن أبي الحكم الغفاري قيل اسمه الحسن وقيل عبد الكبير مستور من السادسة د ق(@)(@@)(@@)(@@) $$$ بن أبي الحكم أو الحكم في الحكم(@)(@@)(@@)(@@) $$$ بن حلحلة هو محمد بن عمرو(@)(@@)(@@)(@@) $$$ بن حميد الرازي هو محمد(@)(@@)(@@)(@@) $$$ بن أبي حميد المدني هو محمد(@)(@@)(@@)(@@) $$$ بن حمير الحمصي هو محمد(@)(@@)(@@)(@@) $$$ بن حنبل هو الإمام أحمد بن محمد بن حنبل(@)(@@)(@@)(@@) $$$ بن حنظلة هو عبد الله(@)(@@)(@@)(@@) $$$ بن الحنظلية هو سهل(@)(@@)(@@)(@@) $$$ بن الحنفية هو محمد بن علي بن أبي طالب(@)(@@)(@@)(@@) $$$ بن حنين هو عبد الله وأخوه عبيد وإبراهيم بن عبد الله بن حنين(@)(@@)(@@)(@@) $$$ بن حوالة الأزدي هو عبد الله(@)(@@)(@@)(@@) $$$ بن الحوتكية هو يزيد تقدموا PageV01P689(@)(@@)(@@)(@@) $ 8466 بن حيان شيخ لهلال بن يساف لا يعرف ولم يسم من السادسة ويقال اسمه حيان بن غالب د س(@)(@@)(@@)(@@) $$$ بن حيويل هو قرة(@)(@@)(@@)(@@) $$$ بن حي صالح بن صالح وابناه الحسن وعلي تقدموا(@)(@@)(@@)(@@) $$$ بن خارجة هو عمرو(@)(@@)(@@)(@@) $$$ بن أبي خالد هو إسماعيل(@)(@@)(@@)(@@) $$$ بن أبي خثعم هو عمر بن عبد الله(@)(@@)(@@)(@@) $$$ بن خثيم هو عبد الله بن عثمان بن خثيم(@)(@@)(@@)(@@) $$$ بن أبي خداش هو عبد الله بن عبد الصمد(@)(@@)(@@)(@@) $$$ بن خراش هو أحمد 
ms635	 بن الحسن(@)(@@)(@@)(@@) $$$ بن خربوذ اسمه معروف ولهم آخر اسمه سالم بن سرج ويقال اسمه النعمان تقدموا(@)(@@)(@@)(@@) $ 8467 بن أبي خزامة عن أبيه وقيل عن أبي خزامة عن أبيه وهو الصحيح مجهول من الثالثة ت ق(@)(@@)(@@)(@@) $$$ بن خزيمة الأنصاري هو عمارة(@)(@@)(@@)(@@) $$$ بن خلدة الزرقي هو عمر(@)(@@)(@@)(@@) $$$ بن أبي خلف هو محمد بن أحمد(@)(@@)(@@)(@@) $$$ بن خلى اسمه خالد وولده محمد(@)(@@)(@@)(@@) $$$ بن الخليل هو عبد الله(@)(@@)(@@)(@@) $$$ بن خلاد الصحابي هو السائب(@)(@@)(@@)(@@) $$$ بن أبي خيرة هو سعيد وآخر متأخر عنه اسمه محمد بن هشام السدوسي(@)(@@)(@@)(@@) $$$ بن داب هو محمد(@)(@@)(@@)(@@) $$$ بن داود الخريبي هو عبد الله(@)(@@)(@@)(@@) $$$ بن دايه هو عيسى بن ميمون المكي(@)(@@)(@@)(@@) $$$ بن دكين هو الفضل(@)(@@)(@@)(@@) $$$ بن الديلمي هو عبد الله بن فيروز وأخوه الضحاك(@)(@@)(@@)(@@) $$$ بن دينار عبد الله وعمرو وليسا أخوين ومحمد بن إبراهيم تقدموا PageV01P690(@)(@@)(@@)(@@) $$$ بن أبي ذباب هو الحارث بن عبد الرحمن وعبد الله بن عبد الرحمن بن الحارث بن سعد(@)(@@)(@@)(@@) $$$ بن ذر هو عمر(@)(@@)(@@)(@@) $$$ بن ذكوان هو عبد الله بن أحمد بن بشير(@)(@@)(@@)(@@) $$$ بن أبي ذؤيب هو إسماعيل بن عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي ذئب هو محمد بن عبد الرحمن تقدموا(@)(@@)(@@)(@@) $$$ بن رافع بن خديج عن أبيه في النهي عن المزارعة له ولدان هرير وعباية تقدما م س(@)(@@)(@@)(@@) $$$ بن رافع عن جابر هو عبيد الله بن عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي رافع عن علي هو عبيد الله(@)(@@)(@@)(@@) $$$ بن أبي رافع عن عبد الله بن جعفر هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن رباح الأنصاري اسمه عبد الله(@)(@@)(@@)(@@) $$$ بن أبي رباح هو عطاء(@)(@@)(@@)(@@) $$$ بن ربيعة الأنصاري هو نافع بن محمود بن ربيعة نسب لجده(@)(@@)(@@)(@@) $$$ بن أبي ربيعة عن حفصة الحارث بن عبد الله المخزومي وهو الذي يروي عن عبد الله بن عمرو بن العاص في غالب الظن(@)(@@)(@@)(@@) $$$ بن رجاء المكي عبد الله(@)(@@)(@@)(@@) $$$ بن رجاء البصري الغداني عبد الله أيضا(@)(@@)(@@)(@@) $$$ بن أبي رجاء الهروي اسمه أحمد(@)(@@)(@@)(@@) $$$ بن أبي رجاء المصيصي هو أحمد بن محمد بن عبيد الله بن أبي رجاء(@)(@@)(@@)(@@) $$$ بن أبي الرجال هو عبد الرحمن وأخوه حارثة 
ms636	(@)(@@)(@@)(@@) $$$ بن أبي رزمة هو عبد العزيز وابنه محمد بن عبد العزيز(@)(@@)(@@)(@@) $$$ بن رقيش اسمه سعيد بن عبد الرحمن تقدموا(@)(@@)(@@)(@@) $ 8468 بن رفيع أو بن أبي رفيع عن طاوس لا يعرف من السابعة مد(@)(@@)(@@)(@@) $$$ بن الرماح هو عمر بن ميمون(@)(@@)(@@)(@@) $$$ بن أبي رواد هو عبد العزيز وولده عبد المجيد تقدموا(@)(@@)(@@)(@@) $$$ بن أبي زائدة هو زكريا وولده يحيى(@)(@@)(@@)(@@) $$$ بن زبر هو عبد الله PageV01P691(@)(@@)(@@)(@@) $$$ بن زحر هو عبيد الله(@)(@@)(@@)(@@) $$$ بن زرير هو عبد الله(@)(@@)(@@)(@@) $$$ بن زغب هو عبد الله(@)(@@)(@@)(@@) $$$ بن زغبة هو عيسى بن حماد وأخوه أحمد(@)(@@)(@@)(@@) $$$ بن أبي زكريا هو عبد الله(@)(@@)(@@)(@@) $$$ بن أبي زميل هو مخلد بن الحسن(@)(@@)(@@)(@@) $$$ بن زنجويه هو حميد(@)(@@)(@@)(@@) $$$ بن أبي الزناد هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن زنجويه أيضا هو محمد بن عبد الملك(@)(@@)(@@)(@@) $$$ بن أبي زياد هو يزيد(@)(@@)(@@)(@@) $$$ بن أبي زياد أيضا عبد الله بن الحكم وعبيد الله(@)(@@)(@@)(@@) $$$ بن زيد عن بن سيلان هو محمد بن زيد بن المهاجر تقدموا(@)(@@)(@@)(@@) $$$ بن سابط هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن سابق التميمي هو محمد(@)(@@)(@@)(@@) $$$ بن سابق أيضا محمد بن سعيد بن سابق تقدموا(@)(@@)(@@)(@@) $ 8469 بن سابق عند أبي داود في القدر من قوله لا يعرف ولم يسم من السادسة قد(@)(@@)(@@)(@@) $$$ بن سارة هو جعفر بن خالد(@)(@@)(@@)(@@) $$$ بن الساعدي المالكي هو عبد الله بن السعدي(@)(@@)(@@)(@@) $$$ بن سالم الحمصي هو عبد الله(@)(@@)(@@)(@@) $$$ بن سالم الأنصاري في عمرو(@)(@@)(@@)(@@) $$$ بن السائب هو عبد الله(@)(@@)(@@)(@@) $$$ بن أبي السائب هو الوليد بن سليمان(@)(@@)(@@)(@@) $$$ بن سباع هو محمد بن ثابت(@)(@@)(@@)(@@) $$$ بن السباق هو عبيد(@)(@@)(@@)(@@) $$$ بن أبي سبرة هو أبو بكر(@)(@@)(@@)(@@) $$$ بن سخبرة قيل هو عيسى بن ميمون(@)(@@)(@@)(@@) $$$ بن سرجس هو عبد الله(@)(@@)(@@)(@@) $$$ بن السرح هو أحمد بن عمرو(@)(@@)(@@)(@@) $$$ بن أبي سرح هو عياض بن عبد الله(@)(@@)(@@)(@@) $$$ بن أبي سريج هو أحمد بن الصباح(@)(@@)(@@)(@@) $$$ بن أبي السري هو محمد وأخوه الحسين(@)(@@)(@@)(@@) $$$ بن السعدي هو عبد الله تقدموا PageV01P692(@)(@@)(@@)(@@) $$$ بن لسعد بن أبي وقاص يحتمل أن يكون مصعبا(@)(@@)(@@)(@@) $$$ بن سعد بن عبادة هو عمرو بن شرحبيل بن سعيد بن سعد نسب لجده 
ms637	 الأعلى(@)(@@)(@@)(@@) $$$ بن سعيد بن جبير هو عبد الله(@)(@@)(@@)(@@) $$$ بن أبي سعيد الخدري هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي السفر هو عبد الله(@)(@@)(@@)(@@) $$$ بن سفيان هو أبو سلمة تقدموا(@)(@@)(@@)(@@) $$$ بن سفيان خطب رجل عند علي في ترجمة قيس(@)(@@)(@@)(@@) $$$ بن سفينة عن أم سلمة جزم بن منده بأنه عمر م(@)(@@)(@@)(@@) $$$ بن سلمة بن الأكوع هو إياس فيما يظهر(@)(@@)(@@)(@@) $$$ بن سلمة عن بن إسحاق هو محمد الحراني(@)(@@)(@@)(@@) $$$ بن أبي سلمة الماجشون هو عبد العزيز بن عبد الله(@)(@@)(@@)(@@) $$$ بن أبي سليمان العرزمي هو عبد الملك(@)(@@)(@@)(@@) $$$ بن سليط هو إسحاق بن عمر(@)(@@)(@@)(@@) $$$ بن سليط آخر هو عبد الكريم(@)(@@)(@@)(@@) $$$ بن سمرة شيخ لنعيم بن أبي هند قيل هو سفيان(@)(@@)(@@)(@@) $$$ بن السمط هو شرحبيل وابن السمط أيضا ثابت ويزيد(@)(@@)(@@)(@@) $$$ بن سمعان هو عبد الله بن زياد(@)(@@)(@@)(@@) $$$ بن أبي سنان الدولي هو سنان(@)(@@)(@@)(@@) $ 8470 بن سندر هو عبد الله(@)(@@)(@@)(@@) $$$ بن سواء هو محمد(@)(@@)(@@)(@@) $$$ بن سواد هو عمرو(@)(@@)(@@)(@@) $$$ بن سوادة هو عبد الله(@)(@@)(@@)(@@) $$$ بن سوقة هو محمد(@)(@@)(@@)(@@) $$$ بن أبي سويد هو محمد(@)(@@)(@@)(@@) $$$ بن سلام الصحابي هو عبد الله(@)(@@)(@@)(@@) $$$ بن سلام شيخ البخاري هو محمد(@)(@@)(@@)(@@) $$$ بن سيرين هو محمد(@)(@@)(@@)(@@) $$$ بن سيلان في جابر وعبد ربه تقدموا(@)(@@)(@@)(@@) $$$ بن شبرمة هو عبد الله(@)(@@)(@@)(@@) $$$ بن شبل هو عبد الرحمن PageV01P693(@)(@@)(@@)(@@) $ 8471 بن شبل أرسل شيئا وعنه سعيد بن أبي هلال لا يعرف ولم يسم من السادسة مد(@)(@@)(@@)(@@) $$$ بن شبويه هو أحمد بن محمد بن ثابت(@)(@@)(@@)(@@) $$$ بن أبي شبيب هو ميمون(@)(@@)(@@)(@@) $$$ بن الشخير هو مطرف بن عبد الله وأبوه(@)(@@)(@@)(@@) $$$ بن أبي الشعثاء هو أشعث(@)(@@)(@@)(@@) $$$ بن شفي هو حسين(@)(@@)(@@)(@@) $$$ بن شماسة هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن شهاب الزهري محمد بن مسلم(@)(@@)(@@)(@@) $$$ بن أبي الشوارب هو محمد بن عبد الملك(@)(@@)(@@)(@@) $$$ بن شوذب هو عبد الله(@)(@@)(@@)(@@) $$$ بن شيبة هو عبد الرحمن بن عبد الملك بن شيبة نسب لجده(@)(@@)(@@)(@@) $$$ بن أبي شيبة أبو بكر عبد الله بن محمد وأخوه عثمان(@)(@@)(@@)(@@) $$$ بن أبي الصعبة اسمه عبد العزيز(@)(@@)(@@)(@@) $$$ بن أبي صعصعة اسمه عبد الله بن عبد الرحمن وله ولدان محمد وعبد الرحمن(@)(@@)(@@)(@@) $$$ بن 
ms638	 أبي صعير ويقال بن صعير اسمه عبد الله بن ثعلبة ويقال ثعلبة بن عبد الله(@)(@@)(@@)(@@) $$$ بن صفوان صحابي اسمه محمد(@)(@@)(@@)(@@) $$$ بن صفوان عن كلدة هو أمية(@)(@@)(@@)(@@) $$$ بن صفوان شيخ أبي الزبير هو صفوان بن عبد الله بن صفوان نسب لجده(@)(@@)(@@)(@@) $$$ بن أبي صفوان هو محمد بن عثمان تقدموا(@)(@@)(@@)(@@) $ 8472 بن أبي صفية مستور من السادسة ويقال هو عثمان بن أبي صفية الكوفي ولا يثبت س(@)(@@)(@@)(@@) $$$ بن الصلت الأسدي هو محمد تقدم(@)(@@)(@@)(@@) $ 8473 بن صهبان عن العباس بن عبد المطلب اسمه عقبة فيما أظن فإن يكن فروايته منقطعة وإلا فمجهول من الثانية(@)(@@)(@@)(@@) $$$ بن أبي الضيف اسمه محمد(@)(@@)(@@)(@@) $$$ بن طاوس اسمه عبد الله(@)(@@)(@@)(@@) $$$ بن الطباع إسحاق بن عيسى وأخوه محمد(@)(@@)(@@)(@@) $$$ بن طحلاء اسمه محمد وله ولدان يحيى ويعقوب(@)(@@)(@@)(@@) $$$ بن طخفة الغفاري اسمه قيس تقدموا(@)(@@)(@@)(@@) $$$ بن طلحة روى عنه الشعبي هو يحيى PageV01P694(@)(@@)(@@)(@@) $$$ بن أبي طلحة هو إسحاق بن عبد الله بن أبي طلحة وله أخ اسمه إسماعيل وروى الزهري عن بن أبى طلحة عن أبيه في الوضوء فكأنه عبد الله والد إسحاق(@)(@@)(@@)(@@) $$$ بن ظالم اسمه عبد الله(@)(@@)(@@)(@@) $$$ بن عابس الكوفي اسمه عبد الرحمن تقدم(@)(@@)(@@)(@@) $ 8474 بن عابس الجهني عن النبي صلى الله عليه وسلم وعنه أبو عبد الله له حديث س(@)(@@)(@@)(@@) $$$ بن عامر عن عبد الله بن عمرو قيل اسمه عبد الرحمن وقيل عبيد د(@)(@@)(@@)(@@) $$$ بن عامر المقرىء اسمه عبد الله(@)(@@)(@@)(@@) $$$ بن عائش اسمه عبد الرحمن(@)(@@)(@@)(@@) $$$ بن عائشة هو عبيد الله بن محمد بن حفص(@)(@@)(@@)(@@) $$$ بن عباد بن عبد الله بن الزبير اسمه يحيى(@)(@@)(@@)(@@) $$$ بن عباد المكي اسمه محمد(@)(@@)(@@)(@@) $$$ بن عباد عن سمرة هو ثعلبة بن عباد(@)(@@)(@@)(@@) $$$ بن عباس الحبر هو عبد الله تقدموا(@)(@@)(@@)(@@) $$$ بن عبد الله بن أنيس عن أبيه في ذكر ليلة القدر هو ضمرة وقيل عمرو د(@)(@@)(@@)(@@) $ 8475 بن عبد الله بن بسر عن أبيه لا يعرف ولم يسم من الخامسة س(@)(@@)(@@)(@@) $$$ بن عبد الله بن الحارث بن نوفل يقال إنه عبيد الله(@)(@@)(@@)(@@) $$$ بن عبد الله بن ربيعة هو أبو 
ms639	 عائذ الله المتقدم في الكنى(@)(@@)(@@)(@@) $$$ بن لعبد الله بن عمر شيخ لأبي عقيل هو القاسم بن عبيد الله بن عبد الله بن عمر(@)(@@)(@@)(@@) $$$ بن عبد الله بن كعب بن مالك هو عبد الرحمن(@)(@@)(@@)(@@) $ 8476 بن عبد الله بن مغفل اسمه يزيد(@)(@@)(@@)(@@) $$$ بن عبد الله عن عائشة هو خبيب بن عبد الله بن الزبير تقدموا(@)(@@)(@@)(@@) $ 8477 بن أبي عبد الله الزرقي عن أبيه لا يعرف ولم يسم من الثالثة صد(@)(@@)(@@)(@@) $$$ بن عبد خير هو المسيب(@)(@@)(@@)(@@) $$$ بن عبد الرحمن بن أبزى هو سعيد وأخوه عبد الله وسعيد أشهر تقدما(@)(@@)(@@)(@@) $ 8478 بن عبد الرحمن بن سعيد بن يروع شيخ لزيد بن الحباب نسب لجده اسمه عمر ويقال عمرو مقبول من السابعة بخ(@)(@@)(@@)(@@) $$$ بن أبي عبلة هو إبراهيم(@)(@@)(@@)(@@) $$$ بن عبيد بن عمير هو عبد الله(@)(@@)(@@)(@@) $$$ بن عبيد بن نسطاس اسمه عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي عبيد هو يزيد مولى سلمة بن الأكوع تقدموا PageV01P695(@)(@@)(@@)(@@) $ 8479 بن أبي عبيد الزرقي مجهول لم يسم من الرابعة صد(@)(@@)(@@)(@@) $$$ بن عبيدة بن نشيط هو عبد الله(@)(@@)(@@)(@@) $$$ بن أبي عتاب اسمه زيد ويقال عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي عتيق هو عبد الله بن محمد بن عبد الرحمن بن أبي بكر وأبو عتيق كنية محمد ويعرف بها أيضا ابناه محمد وعبد الرحمن ولدا عبد الله المذكور(@)(@@)(@@)(@@) $$$ بن عتيك اسمه جابر(@)(@@)(@@)(@@) $$$ بن عثمة هو محمد بن خالد(@)(@@)(@@)(@@) $$$ بن عجلان هو محمد تقدموا(@)(@@)(@@)(@@) $ 8480 بن عدي بن عدي الكندي شيخ لعيسى بن يونس لم يسم ولا يعرف حاله من السادسة(@)(@@)(@@)(@@) $$$ بن أبي عدي اسمه محمد بن إبراهيم(@)(@@)(@@)(@@) $$$ بن عرق هو عبد الرحمن وولده محمد(@)(@@)(@@)(@@) $$$ بن أبي عروبة هو سعيد(@)(@@)(@@)(@@) $$$ بن عسكر هو محمد بن سهل(@)(@@)(@@)(@@) $$$ بن أبي العشرين هو عبد الحميد بن حبيب تقدموا(@)(@@)(@@)(@@) $ 8481 بن عصام المزني عن أبيه لا يعرف حاله قيل اسمه عبد الرحمن وقيل عبد الله من الثالثة د ت س(@)(@@)(@@)(@@) $ 8482 بن عطاء شيخ لأبي فروة كأنه يعقوب وإلا فمجهول من السابعة ت(@)(@@)(@@)(@@) $$$ بن عطاء عن عكرمة في الزاد والراحلة 
ms640	 هو عمر بن عطاء بن وراز(@)(@@)(@@)(@@) $$$ بن عفير هو سعيد بن كثير بن عفير نسب لجده(@)(@@)(@@)(@@) $$$ بن عقيل هو عبد الله بن محمد بن عقيل نسب لجده(@)(@@)(@@)(@@) $$$ بن عكيم هو عبد الله(@)(@@)(@@)(@@) $$$ بن علية هو إسماعيل بن إبراهيم بن مقسم(@)(@@)(@@)(@@) $$$ بن عمار الموصلي هو محمد بن عبد الله بن عمار نسب لجده(@)(@@)(@@)(@@) $$$ بن أبي عمار المكي هو عبد الرحمن بن عبد الله تقدموا(@)(@@)(@@)(@@) $ 8483 بن عمر بن أبي سلمة شيخ لثابت البناني قيل اسمه محمد وهو مقبول من السادسة د س(@)(@@)(@@)(@@) $$$ بن عمر هو عبد الله مشهور(@)(@@)(@@)(@@) $$$ بن أبي عمر هو محمد بن يحيى بن أبي عمر العدني نسب لجده(@)(@@)(@@)(@@) $$$ بن عمرة هو أبو الرجال المقدم ذكره وعمرة اسم أمه PageV01P696(@)(@@)(@@)(@@) $$$ بن عمرو بن أوس يقال اسمه عبد الرحمن تقدم في بن أوس(@)(@@)(@@)(@@) $$$ بن عمرو بن العاص هو عبد الله مشهور تقدم(@)(@@)(@@)(@@) $$$ بن أبي عميرة صحابي عنه جبير بن نفير س(@)(@@)(@@)(@@) $$$ بن أبي عميرة آخر اسمه محمد كأنه أخو الذي قبله(@)(@@)(@@)(@@) $$$ بن عنج هو محمد بن عبد الرحمن(@)(@@)(@@)(@@) $$$ بن عنمة بنون اسمه عبد الله(@)(@@)(@@)(@@) $$$ بن عوسجة هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن عوف هو عبد الرحمن الصحابي المشهور وفي المتأخرين محمد بن عوف الطائي المحدث المشهور(@)(@@)(@@)(@@) $$$ بن أبي عوف الجرشي هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن عون هو عبد الله الفقيه المشهور تقدموا(@)(@@)(@@)(@@) $ 8484 بن العلاء بن الحضرمي عن أبيه مقبول من الثالثة وأظن اسمه عبد الله د(@)(@@)(@@)(@@) $$$ بن العلاء بن كريب هو أبو كريب محمد(@)(@@)(@@)(@@) $$$ بن علاثة هو محمد(@)(@@)(@@)(@@) $$$ بن علاق هو عثمان بن حصن بن عبيدة(@)(@@)(@@)(@@) $$$ بن علاقة هو زياد(@)(@@)(@@)(@@) $$$ بن عياش هو عبد الله بن عياش بن أبي ربيعة وأبو بكر بن عياش الكوفي وأخوه الحسن وإسماعيل بن عياش الحمصي وعلي بن عياش شيخ البخاري تقدموا(@)(@@)(@@)(@@) $$$ بن عيينة هو سفيان تقدم(@)(@@)(@@)(@@) $$$ بن غانم الإفريقي هو عبد الله بن عمر(@)(@@)(@@)(@@) $$$ بن غزية هو عمارة(@)(@@)(@@)(@@) $$$ بن غنام هو عبد الله(@)(@@)(@@)(@@) $$$ بن غنم هو عبد الرحمن(@)(@@)(@@)(@@) $$$ بن أبي غنية هو عبد الملك وولده يحيى تقدموا 