ms4521	 ) .(@)(@@) | 1 ( عبد الرحمن بن ساعدة رضي الله عنه ) 1(@)(@@) 33491 - إن أدخلت الجنة أتيت بفرس من ياقوتة له جناحان فحملت عليه ثم طار حيث شئت .(@)(@@) % ( ت - عن أبي أيوب ) .(@)(@@) 33492 - إن يدخلك الله الجنة فلا تشاء أن تركب فرسا من ياقوتة حمراء تطير بك في أي الجنة شئت إلا ركبت .(@)(@@) % ( حم ، ت - عن بريدة ) ( أخرجه الترمذي كتاب صفة الجنة باب ما جاء في صفة خيل الجنة رقم ( 2543 و 2544 ) وقال ليس إسناده بالقوي ص ) .(@)(@@) PageV11P327(@)(@@) | 1 ( { الإكمال } من عبد الرحمن بن ساعدة رضي الله عنه ) 1(@)(@@) 33493 - إن أدخلك الله الجنة يا عبد الرحمن كان لك فيها فرس من ياقوت له جناحان يطير بك حيث شئت .(@)(@@) % ( طب - عن عبد الرحمن ابن ساعدة ) .(@)(@@) 33494 - يا عبد الرحمن ! إن أدخلك الله الجنة كان لك فيها فرس من ياقوتة لها جناحان تطير بك في الجنة .(@)(@@) % ( أبو نعيم - عن عبد الرحمن بن ساعدة ) .(@)(@@) | 1 ( عبد الرحمن بن عوف رضي الله عنه ) 1(@)(@@) 33495 - أتاني جبريل فقال : مر ابن عوف فليضف الضيف ، وليطعم المسكين ، وليعط السائل ، وليبدأ بمن يعول ؛ فإذا فعل ذلك كان تزكية ما هو فيه .(@)(@@) % ( ابن سعد ، طس ، ك ، هب - عن عبد الرحمن بن عوف ) ( أخرجه الترمذي كتاب صفة الجنة باب ما جاء في صفة خيل الجنة رقم ( 2543 و 2544 ) وقال ليس إسناده بالقوي ص ) .(@)(@@) | 1 ( { الإكمال } من عبد الرحمن بن عوف رضي الله عنه ) 1(@)(@@) 33496 - أنكحوا عبد الرحمن بن عوف ، فإنه من خيار المسلمين ، ومن خيارهم من كان مثله .(@)(@@) % ( عد ، كر - عن عبد الرحمن بن حميد عن أبيه عن أمه أم كلثوم بنت عقبة بن أبي معيط عن بسرة بنت صفوان ) .(@)(@@) 33497 - إن لم يكن عبد الرحمن بن عوف فاضت عينه فقد فاض قلبه .(@)(@@) % ( حل وابن عساكر - عن معتمر بن سليمان عن أبيه الحضرمي ) قال : قرأ رجل عند رسول الله صلى الله عليه وسلم لين الصوت فما بقي أحد من القوم إلا فاضت عينه غير عبد الرحمن بن عوف فقال 
ms4522	 رسول الله صلى الله عليه وسلم : فذكره .(@)(@@) 33498 - يا خالد ! ذروا لي أصحابي ، متى ينك ( ينك : وقولهم : لا تنك أي لا نكيت أي لا جعلك الله منكيا منهزما مغلوبا . لسان العرب ( 1 / 174 ) ب ) أنف المرء ينك المرء ولو كان أحد ذهبا تنفقه قيراطا قيراطا في سبيل الله لم تدرك غدوة أو روحة من غدوات أو روحات عبد الرحمن .(@)(@@) % ( الواقدي وابن عساكر - عن اياس بن سلمة عن أبيه ) .(@)(@@) 33499 - أول من يدخل الجنة من أغنياء أمتي عبد الرحمن بن عوف ، والذي نفس محمد بيده ! لن يدخلها إلا حبوا .(@)(@@) % ( بز وأبو نعيم في فضائل الصحابة عن أنس ؛ وضعف ) .(@)(@@) 33500 - رأيت عبد الرحمن بن عوف يدخل الجنة حبوا .(@)(@@) % ( حم ، طب - عن عائشة ) .(@)(@@) 33501 - قد رأيت عبد الرحمن يدخل الجنة حبوا .(@)(@@) % ( حم - عن أنس ، وأورده ابن الجوزي في الموضوعات ) .(@)(@@) 33502 - كأني بعبد الرحمن بن عوف على الصراط يميل مرة ويستقيم أخرى حتى يفلت ولم يكد ( يكد : الكد : الشدة في العمل وطلب الكسب وبابه رد . وكده : أتعبه فهو لازم ومتعد . المختار ( 447 ) ب ) .(@)(@@) % ( ابن عساكر - عن عائشة ) .(@)(@@) 33503 -(@)(@@) PageV11P328 كفاك الله أمر دنياك ، فأما آخرتك فأنا لها ضامن .(@)(@@) % ( أبو بكر الشافعي في الغيلانيات وأبو نعيم في فضائل الصحابة وابن عساكر - عن عمر ) قال : رأيت النبي صلى الله عليه وسلم والحسن والحسين يبكيان جوعا ويتضرعان فقال : من يصلنا بشيء ؟ فطلع عبد الرحمن بن عوف بصحفة فيها حيس ( حيس : الحيس : هو تمر إنخلط بسمن وأقط . المختار ( 127 ) ب ) ورغيفان بينهما اهالة ( إهالة : الاهالة : الودك وهو دسم اللحم . المختار ( 22 ) ) قال : فذكره .(@)(@@) 33504 - يا عبد الرحمن ! كفاك الله أمر دنياك ، فأما آخرتك فأنا لها ضامن - قاله لابن عوف .(@)(@@) % ( الديلمي - عن ابن عمر ) .(@)(@@) | 1 ( عبد الرحمن بن صخر أبو هريرة رضي الله عنه ) 1(@)(@@) 33505 - أبو هريرة وعاء للعلم .(@)(@@) % ( ك - عن أبي سعيد الخدري ) .(@)(@@) 33506 - سبقكما بها الدوسي .(@)(@@) % ( ك - عن زيد بن ثابت ) ( أخرجه الحاكم في المستدرك ( 3 / 508 ) وقال الذهبي في سنده : حماد ابن شعيب ضعيف .(@)(@@) وتوفي عبد 
ms4523	 الرحمن بن صخر سنة خمس وخمسين وعمره ( 78 ) عاما . انظر ترجمته في المستدرك ( 3 / 506 و 514 ) ص ) .(@)(@@) | 1 ( { الإكمال } من عبد الرحمن بن صخر أبو هريرة رضي الله عنه ) 1(@)(@@) 33507 - لكل أمة حكيم وحكيم هذه الأمة أبو هريرة .(@)(@@) % ( الديلمي عن ابن عباس ) .(@)(@@) | 1 ( عويمر بن عامر الأنصاري أبو الدرداء رضي الله عنه ) 1(@)(@@) 33508 - حكيم أمتي عويمر .(@)(@@) % ( طس - عن شريح بن عبيد مرسلا ) .(@)(@@) 33509 - إن لكل أمة حكيما وحكيم هذه الأمة أبو الدرداء .(@)(@@) % ( ابن عساكر - عن جبير بن نفير مرسلا ) .(@)(@@) 33510 - إن الله وعدني بإسلام أبي الدرداء .(@)(@@) % ( طب - عن أبي الدرداء ) .(@)(@@) | 1 ( { الإكمال } من عويمر بن عامر الأنصاري أبو الدرداء رضي الله عنه ) 1(@)(@@) 33511 - نعم الفارس عويمر ! نعم الرجل أبو الدرداء .(@)(@@) % ( طس - عن شريح بن عبيد وعن ابن عائذ ؛ وهما مرسلان ) .(@)(@@) | 1 ( عويمر بن ساعدة رضي الله عنه ) 1(@)(@@)(@)(@@) | 1 ( { الإكمال } من عويمر بن ساعدة رضي الله عنه ) 1(@)(@@) 33512 - نعم العبد من عباد الله والرجل من أهل الجنة عويمر بن ساعدة .(@)(@@) % ( الديلمي - عن جابر ) .(@)(@@) | 1 ( عبد الله بن عمر رضي الله عنه ) 1(@)(@@) 33513 - نعم العبد عبد الله بن عمر من وفد الرحمن ! وعمار بن ياسر من السابقين ! والمقداد بن الأسود من المجتهدين .(@)(@@) % ( فر - عن ابن عباس ) ( عبد الله بن عمر بن الخطاب رضي الله عنهما توفي بمكة ودفن بذي طوى سنة ( 74 ) وعمره ( 84 ) . المستدرك ( 3 / 557 ) ص ) .(@)(@@) PageV11P329(@)(@@) 33514 - إن عبد الله رجل صالح لو كان يكثر الصلاة من الليل .(@)(@@) % ( حم ، ق - عن حفصة ) .(@)(@@) 33515 - نعم الرجل عبد الله لو كان يصلي من الليل .(@)(@@) % ( حم ، ق - عن حفصة ) ( أخرجه البخاري في صحيحه كتاب فضائل الأصحاب باب مناقب عمر ( 5 / 31 ) ص ) .(@)(@@) | 1 ( { الإكمال } من عبد الله بن عمر رضي الله عنه ) 1(@)(@@) 33516 - لكل أمة عالم وعالم هذه الأمة عبد الله بن عمر ، ولكل نبي خليل وخليلي سعد بن معاذ .(@)(@@) % ( الديلمي - عن ابن عباس ) .(@)(@@) | 1 ( عبد الله بن سلام رضي الله عنه ) 1(@)(@@) 33517 - عبد 
ms4524	 الله بن سلام عاشر عشرة في الجنة .(@)(@@) % ( حم ، طب ، ك - عن معاذ ) ( الحديث أخرجه الحاكم في المستدرك ( 3 / 416 ) وقال : صحيح وأقره الذهبي . وتوفي بالمدينة سنة ( 73 ) ص ) .(@)(@@) | 1 ( { الإكمال } من عبد الله بن سلام رضي الله عنه ) 1(@)(@@) 33518 - يموت عبد الله بن سلام وهو آخذ بالعروة الوثقى .(@)(@@) % ( طب عن عبد الله بن سلام ) .(@)(@@) 33519 - كذبتم لن يقبل قولكم ، أما آنفا فتثنون عليه من الخير ما أثنيتم ، وأما إذا آمن فكذبتموه وقلتم فيه ، فلن يقبل قولكم .(@)(@@) % ( ك - عن عوف بن مالك ) ( الحديث أخرجه الحاكم في المستدرك ( 3 / 416 ) وقال : صحيح وأقره الذهبي . وتوفي بالمدينة سنة ( 73 ) ص ) .(@)(@@) | 1 ( عمار بن ياسر رضي الله عنه ) 1(@)(@@) 33520 - عمار خلط الله الإيمان ما بين قرنه إلى قدمه وخلط الإيمان بلحمه ودمه ، يزول مع الحق حيث زال ، وليس ينبغي للنار أن تأكل منه شيئا .(@)(@@) % ( ابن عساكر - عن علي ) .(@)(@@) 33521 - دم عمار ولحمه حرام على النار أن تأكله أو تمسه .(@)(@@) % ( ابن عساكر - عن علي ) .(@)(@@) 33522 - قاتل عمار وسالبه في النار .(@)(@@) % ( طب - عن عمرو بن العاص وعن ابنه ) .(@)(@@) 33523 - كم من ذي طمرين لا يؤبه له لو أقسم على الله لأبره منهم عمار بن ياسر .(@)(@@) % ( ابن عساكر - عن عائشة ) ( أورده الهيثمي في مجمع الزوائد ( 9 / 294 ) وقال : رواه الطبراني في الأوسط وفيه عيسى بن قرطاس وهو متروك . ص ) .(@)(@@) 33524 - ابن سمية ما عرض عليه أمران قط إلا أخذ بالأرشد منهما .(@)(@@) % ( حم ، ك - عن ابن مسعود ) .(@)(@@) 33525 - إذا اختلف الناس كان ابن سمية مع الحق .(@)(@@) % ( طب - عن ابن مسعود ) .(@)(@@) 33526 - عمار يزول مع الحق حيث يزول .(@)(@@) % ( ابن عساكر - عنه ) .(@)(@@) 33527 - ما خير عمار بين أمرين إلا اختار أرشدهما .(@)(@@) % ( ت ، ك عن عائشة ) ( أخرجه الترمذي كتاب المناقب باب مناقب عمار رقم ( 3799 ) وقال : حسن غريب ص ) .(@)(@@) PageV11P330(@)(@@) 33528 - عمار ما عرض عليه أمران إلا اختار الأرشد منهما .(@)(@@) % ( ه - عنها ) ( أخرجه ابن ماجه كتاب المقدمة باب فضل عمار بن ياسر رقم ( 147 و 148 ) . والحاكم في المستدرك ( 3 
ms4525	 / 392 ) وقال : صحيح ص ) .(@)(@@) 33529 - مليء عمار إيمانا إلى مشاشه ( مشاشه : في صفته عليه السلام ( جليل المشاش ) أي عظيم رؤوس العظام كالمرفقين والكتفين ، والركبتين . قال الجوهري : هي رؤوس العظام اللينة التي يمكن مضغها . النهاية ( 4 / 333 ) ب ) .(@)(@@) % ( ه ( أخرجه ابن ماجه كتاب المقدمة باب فضل عمار بن ياسر رقم ( 147 و 148 ) . والحاكم في المستدرك ( 3 / 392 ) وقال : صحيح ص ) - عن علي ؛ ك - عن ابن مسعود ) .(@)(@@) 33530 - عمار مليء إيمانا إلى مشاشه .(@)(@@) % ( حل - عن علي ) .(@)(@@) 33531 - ويح عمار تقتله الفئة الباغية ! يدعوهم إلى الجنة ويدعونه إلى النار .(@)(@@) % ( حم ، خ - عن أبي سعيد ) ( أخرجه البخاري كتاب الجهاد باب مسح الغبار على الناس ( 4 / 25 ) ص ) .(@)(@@) 33532 - بؤس لك يا ابن سمية ! تقتلك الفئة الباغية .(@)(@@) % ( حم ، م عن أبي قتادة ) ( أخرجه مسلم كتاب الفتن باب لا تقوم الساعة رقم ( 2915 ) ص ) .(@)(@@) 33533 - عمار تقتله الفئة الباغية .(@)(@@) % ( حل - عن أبي قتادة ) .(@)(@@) 33534 - من عادى عمارا عاداه الله ؛ ومن أبغض عمارا أبغضه الله .(@)(@@) % ( ن ، حب ، ك - عن خالد بن الوليد ) .(@)(@@) | 1 ( { الإكمال } من عمار بن ياسر رضي الله عنه ) 1(@)(@@) 33535 - ابن سمية ما خير بين أمرين إلا اختار أرشدهما .(@)(@@) % ( حم ، ك - عن ابن مسعود ) ( أخرجه الحاكم في المستدرك ( 3 / 388 ) ص ) .(@)(@@) 33536 - إن ابن سمية ما عرض عليه أمران قط إلا اختار الأرشد منهما .(@)(@@) % ( حم - عن ابن مسعود ) ( أخرجه الحاكم في المستدرك ( 3 / 388 ) ص ) .(@)(@@) 33537 - أبو اليقظان على الفطرة ، أبو اليقظان على الفطرة ، أبو اليقظان على الفطرة ، لا يدعها حتى يموت أو يمسه الهرم .(@)(@@) % ( ن وابن سعد عد وضعفه - عن حذيفة ) ( أخرجه الحاكم في المستدرك ( 3 / 384 ) ص ) .(@)(@@) 33538 - الحق مع عمار ما يغلب عليه دلهة ( دلهة : الدله والدله : ذهاب الفؤاد من هم أو نحوه كما يدله عقل الإنسان من عشق أو غيره ، والتدله : ذهاب العقل من الهوى . انتهى . لسان العرب ( 13 / 488 ) ب ) الكبر .(@)(@@) % ( عق ، كر - عن محمد بن سعد بن أبي وقاص عن أبيه ) .(@)(@@) 33539 - أما إنه سيشهد معك مشاهد 
ms4526	 أجرها عظيم وذكرها كثير وثناؤها حسن .(@)(@@) % ( حل - عن علي ) قال : ذكرت للنبي صلى الله عليه وسلم عمارا قال : فذكره .(@)(@@) 33540 - إن عمارا مليء إيمانا إلى مشاشه .(@)(@@) % ( ع ، طب وابن جرير ، كر - عن علي ) .(@)(@@) 33541 - إن عمارا مليء إيمانا من قرنه إلى قدمه .(@)(@@) % ( حل - عن ابن عباس ) .(@)(@@) 33542 - مليء عمار إيمانا إلى المشاش وهو ممن حرم على النار .(@)(@@) % ( ش - عن القاسم بن مخيمرة مرسلا ) .(@)(@@) 33543 - أولعتم ( أولعتم بعمار : يقال : ولعت بالشيء أولع ولعا وولوعا ، بفتح الواو ، المصدر والاسم جميعا . وأولعته بالشيء ، وأولع به فهو مولع ، بفتح اللام : أي مغرى به . ومنه الحديث ( أولعت قريشا بعمار ) أي صيرتهم يولعون به . النهاية ( 5 / 226 ) ب ) بعمار يدعوهم إلى الجنة وهم يدعونه إلى النار .(@)(@@) % ( طب - عن ابن عمر ) .(@)(@@) 33544 - اللهم ! أولعت قريش بعمار ، قاتل عمار وسالبه في النار .(@)(@@) % ( ك - عن عمرو بن العاص ) .(@)(@@) PageV11P331(@)(@@) 33545 - ما لهم ولعمار ؟ يدعوهم إلى الجنة ويدعونه إلى النار ، قاتله وسالبه في النار .(@)(@@) % ( ابن عساكر - عن مجاهد عن أسامة بن شريط أو ابن زيد ) .(@)(@@) 33546 - ما لهم ولعمار ؟ يدعوهم إلى الجنة ويدعونه إلى النار ، وذلك فعل الأشقياء الأشرار . وفي لفظ ش : وذلك دأب الأشقياء الفجار .(@)(@@) % ( ش وابن عساكر - عن مجاهد مرسلا ؛ قال ابن عساكر : هو المحفوظ ) .(@)(@@) 33547 - ابن سمية تقتله الفئة الباغية ، قاتله وسالبه في النار .(@)(@@) % ( خط كر - عن أنس ) .(@)(@@) 33548 - اللهم بارك في عمار ! ويحك ابن سمية ! تقتلك الفئة الباغية وآخر زادك من الدنيا ضياح ( ضياح : الضياح والضيح بالفتح : اللبن الخاثر يصب فيه الماء ثم يخلط . النهاية ( 3 / 107 ) ب ) من لبن .(@)(@@) % ( ابن عساكر - عن عائشة ) .(@)(@@) 33549 - تقتلك الفئة الباغية ، قاتلك في النار - قاله لعمار .(@)(@@) % ( ابن عساكر - عن أم سلمة ؛ حم ، ابن عساكر - عن عثمان ) .(@)(@@) 33550 - تقتلك الفئة الباغية .(@)(@@) % ( ع وأبو عوانة ، عن أبي رافع ؛ م عن أم سلمة ؛ ابن سعد ، ض ، حم - عن أبي سعيد ؛ طب والباوردي وابن قانع ، قط في الأفراد - عن أبي اليسر وزياد بن الفرد معا ؛ طب عن عمرو ؛ ع وابن منده في كتاب الموالاة 
ms4527	 ، طب ، قط في الأفراد عن بن ياسر ؛ ابن عساكر - عن ابن عباس وعن حذيفة وعن أبي هريرة وعن جابر بن سمرة وعن جابر بن عبد الله عن أبي أمامة ) ( أخرجه مسلم كتاب الفتن رقم ( 2916 ) عن أم سلمة والحاكم في المستدرك ( 3 / 391 ) وقال : صحيح وأقره الذهبي ص ) .(@)(@@) 33551 - تقتلك الفئة الباغية ، وآخر زادك من الدنيا ضيح من لبن .(@)(@@) % ( تمام وابن عساكر - عن عبد الله بن كعب بن مالك عن أبيه ؛ وابن عساكر - عن عمرو بن العاص ) .(@)(@@) 33552 - كف يا خالد عن عمار ؟ فإنه من يبغض عمارا يبغضه الله ، ومن يلعن عمارا يلعنه الله .(@)(@@) % ( ابن عساكر عن ابن عباس ) .(@)(@@) 33553 - من يحقر عمارا يحقره الله ، ومن يسب عمارا يسبه الله ، ومن يبغض عمارا يبغضه الله .(@)(@@) % ( ع وابن قانع ، طب ، ض - عن خالد بن الوليد ) .(@)(@@) 33554 - يا خالد ! لا تسب عمارا ، إنه من يعاد عمارا يعاده الله ، ومن يبغض عمارا يبغضه الله ، ومن يسب عمارا يسبه الله ، ومن يسفه عمارا يسفهه الله ، ومن يحقر عمارا يحقره الله .(@)(@@) % ( ط وسمويه ، طب ، ك عن خالد بن الوليد ) .(@)(@@) 33555 - تقتل عمارا الفئة الباغية عن الطريق ، وإن آخر رزقه من الدنيا ضياح من لبن .(@)(@@) % ( الخطيب - عن حذيفة ) .(@)(@@) 33556 - يا أبا اليقظان ! لن تموت حتى تقتلك الفئة الباغية عن الطريق .(@)(@@) % ( ك - عن حذيفة ) .(@)(@@) PageV11P332(@)(@@) 33557 - قاتل ابن سمية في النار .(@)(@@) % ( كر - عن عمرو بن العاص ) .(@)(@@) 33558 - لن تموت حتى تقتلك الفئة الباغية ، تشرب شربة ضياح من لبن تكن آخر رزقك من الدنيا .(@)(@@) % ( ك - عن حذيفة ) .(@)(@@) 33559 - ويح ابن سمية ! تقتله الفئة الباغية .(@)(@@) % ( ع ، ز ، ك عن حذيفة وابن مسعود معا ؛ ع - عن أبي هريرة ؛ ابن عساكر - عن أم سلمة ؛ الخطيب - عن عمرو بن العاص ) .(@)(@@) 33560 - ويحك ابن سمية ؟ تقتلك الفئة الباغية .(@)(@@) % ( ط ، حم وابن سعد - عن ابن سعيد ؛ ع - عن أبي قتادة ؛ قط في الأفراد - عن أبي اليسر وزياد بن الصرد معا ؛ حم وابن سعد - عن ابن عمر ) .(@)(@@) 33561 - يا عمار ! تقتلك الفئة الباغية .(@)(@@) % ( ابن عساكر - عن 
ms4528	 زيد ابن أبي أوفى ) .(@)(@@) 33562 - يا نار ! كوني بردا وسلاما على عمار كما كنت على إبراهيم تقتلك الفئة الباغية .(@)(@@) % ( ابن عساكر - عن عمرو بن ميمون ) قال : عذب المشركون عمارا بالنار فكان النبي صلى الله عليه وسلم يمر بيده على رأسه ويقول : فذكره قال ابن عساكر : عمرو بن ميمون أدرك النبي صلى الله عليه وسلم ولم يره .(@)(@@) 33563 - يدخل سالبك وقاتلك النار - قاله لعمار .(@)(@@) % ( تمام وابن عساكر - عن عمرو بن العاصي ) .(@)(@@) 33564 - يزعمون أنك ميت وأنك قد قتلت نفسك ، كلا والله ! ما أنت بميت حتى تقتلك الفئة الباغية - قاله لعمار .(@)(@@) % ( ابن عساكر - عن جابر ) .(@)(@@) 33565 - أبشروا يا آل عمار ! فإن موعدكم الجنة .(@)(@@) % ( طس ، ك ، ق ، كر ، ض - عن أبي الزبير عن جابر بن سعد عن أبي الزبير مرسلا ، وعن ابن يوسف المكي مرسلا ) .(@)(@@) 33566 - صبرا يا أبا ياسر وآل ياسر ! فإن موعدكم الجنة .(@)(@@) % ( الحاكم في الكنى - عن عبد الله بن جعفر ) .(@)(@@) 33567 - صبرا يا آل ياسر ! فإن مصيركم إلى الجنة .(@)(@@) % ( الحارث ، حل عن عثمان ) .(@)(@@) 33568 - اصبروا يا آل ياسر ! فإن موعدكم الجنة .(@)(@@) % ( طب - عن عمار ؛ البغوي وابن منده ، طب ، خط ، كر - عن عثمان ) .(@)(@@) 33569 - اللهم اغفر لآل ياسر ! وقد فعلت .(@)(@@) % ( حم وابن سعد - عن عثمان بن عفان ) .(@)(@@) | 1 ( عمرو بن العاصي رضي الله عنه ) 1(@)(@@) 33570 - إن عمرو بن العاصي من صالحي قريش .(@)(@@) % ( ت - عن طلحة ) ( أخرجه الترمذي كتاب المناقب باب مناقب لعمرو بن العاص رقم ( 3844 و 3845 ) وقال غريب ص ) .(@)(@@) 33571 - أسلم الناس وآمن عمرو بن العاص .(@)(@@) % ( حم ، ت - عن عقبة بن عامر ) ( أخرجه الترمذي كتاب المناقب باب مناقب لعمرو بن العاص رقم ( 3844 و 3845 ) وقال غريب ص ) .(@)(@@) PageV11P333(@)(@@) | 1 ( { الإكمال } من عمرو بن العاصي رضي الله عنه ) 1(@)(@@) 33572 - نعم أهل البيت عبد الله وأبو عبد الله وأم عبد الله .(@)(@@) % ( ابن عساكر - عن عمرو بن دينار عن جابر ) أن النبي صلى الله عليه وسلم دخل على عمرو بن العاص فقال : فذكره .(@)(@@) % ( حم وابن عساكر - عن ابن أبي مليكة 
ms4529	 عن طلحة بن عبيد الله بن سعد عن المطلب بن حنطب مرسلا ؛ وعن ابن أبي مليكة مرسلا ؛ وعن عمر بن دينار مرسلا ) .(@)(@@) 33573 - إن عمرو بن العاص لرشيد الأمر .(@)(@@) % ( ابن عساكر - عن طلحة بن عبيد الله ) .(@)(@@) 33574 - إن عمرو بن العاص لمن صالحي قريش ، ونعم أهل البيت عبد الله وأبو عبد الله .(@)(@@) % ( حم ، ع ، عد - عن طلحة بن عبيد الله ) .(@)(@@) 33575 - اللهم اغفر لعمرو بن العاص - ثلاثا ، كنت إذا ناديته للصدقة جاءني بها .(@)(@@) % ( عد - عن جابر ) .(@)(@@) 33576 - يا عمرو ! لذو رأي رشيد في الإسلام .(@)(@@) % ( طب ، ص - عن طلحة ) .(@)(@@) 33577 - يا عمرو ! إني أريد أن أبعثك على جيش فيغنمك الله ويسلمك ، وأرغب لك في المال رغبة صالحة ، يا عمرو ! نعما بالمال الصالح للرجل الصالح .(@)(@@) % ( حم ، ك وابن سعد ، ع ، طب ، هب - عن عمرو ابن العاص ) ( عمرو بن العاص توفي ( 51 ) ه وعمره ( 94 ) ودفن بالمقطم بمصر . المستدرك ( 3 / 452 ) ص ) .(@)(@@) | 1 ( عمرو بن تغلب رضي الله عنه ) 1(@)(@@) 33578 - أما بعد فوالله إني لأعطي الرجل وأدع الرجل ، والذي أدع أحب إلي من الذي أعطي ، ولكن أعطي أقواما لما رأى في قلوبهم من الجزع ( الجزع : هو الحزن والخوف . النهاية ( 1 / 269 ) ب ) والهلع ( الهلع : أشد الجزع والضجر . النهاية ( 5 / 269 ) ب ) ، وأكل أقواما إلى ما جعل الله في قلوبهم من الغنى والخير منهم عمرو بن تغلب .(@)(@@) % ( خ ( أخرجه البخاري في صحيحه كتاب الجمعة باب من قال في الخطبة بعد الثناء ( 2 / 13 ) ص ) - عن عمرو بن تغلب ) .(@)(@@) | 1 ( { الإكمال } من عمرو بن تغلب رضي الله عنه ) 1(@)(@@) 33579 - إني أعطي قوما أخاف ظلعهم ( ظلعهم : هو بفتح اللام أي : ميلهم عن الحق وضعف إيمانهم . النهاية ( 3 / 159 ) ب ) وجزعهم ، وأكل أقواما إلى ما جعل الله في قلوبهم من الخير والغنى منهم عمرو بن تغلب .(@)(@@) % ( خ ( أخرجه البخاري كتاب الخمس باب ما كان النبي صلى الله عليه وسلم يعطى المؤلفة . . ) ( 4 / 114 ) ص ) - عن عمرو بن تغلب ) .(@)(@@) 33580 - إني أعطي أناسا والذي أدع أحب 
ms4530	 إلي من الذي أعطي ، أعطي أناسا لما في قلوبهم من الجزع والهلع ، وأكل أقواما إلى ما جعل الله في قلوبهم من الغنى والخير منهم عمرو بن تغلب .(@)(@@) % ( حم - عن عمرو ابن تغلب ) .(@)(@@) | 1 ( عبد الله بن عباس رضي الله عنه ) 1(@)(@@)(@)(@@) | 1 ( { الإكمال } من عبد الله بن عباس رضي الله عنه ) 1(@)(@@) 33581 - إن حبر هذه الأمة لعبد الله بن عباس .(@)(@@) % ( ك وتعقب - عن ابن عمر ) ( عبد الله بن عباس توفي النبي صلى الله عليه وسلم وعمره خمسة عشر عاما وتوفي سنة ثمان وستين المستدرك للحاكم ( 3 / 543 ) ص ) .(@)(@@) 33582 - نعم ترجمان القرآن أنت .(@)(@@) % ( حل - عن ابن عباس ) ( أخرجه الحاكم في المستدرك ( 3 / 537 ) وقال : صحيح وأقره الذهبي ص ) .(@)(@@) PageV11P334(@)(@@) 33583 - نعم الترجمان أنت .(@)(@@) % ( طب - عن ابن عباس ) .(@)(@@) 33584 - اللهم ! اعط ابن عباس الحكمة وعلمه التأويل .(@)(@@) % ( حم ، طب ، حل - عن ابن عباس ؛ ابن سعد ، حم ، طب ، ك - عن ابن عباس ) .(@)(@@) 33585 - اللهم ! بارك فيه وانشر منه - قاله لابن عباس .(@)(@@) % ( حل - عن ابن عمر ) .(@)(@@) 33586 - اللهم ! علمه الحكمة وتأويل الكتاب .(@)(@@) % ( ه وابن سعد ، طب - عن ابن عباس ) .(@)(@@) 33587 - اذهبي بأبي الخلفاء .(@)(@@) % ( خط - عن ابن عباس عن أمه أم الفضل ) .(@)(@@) | 1 ( عبد الله بن حذافة رضي الله عنه ) 1(@)(@@)(@)(@@) | 1 ( { الإكمال } من عبد الله بن حذافة رضي الله عنه ) 1(@)(@@) 33588 - أبوك حذافة ، أنجبت أم حذافة ، الولد للفراش .(@)(@@) % ( ابن سعد ، ك - عن أبي وائل ) قال : قام عبد الله بن حذافة فقال : يا رسول الله من أبي ؟ قال - فذكره ( أخرجه الحاكم في المستدرك : ( 3 / 631 ) ولم يذكر الحاكم كعادته من تصحيح لهذا الحديث وكذا الذهبي لم يعرج كعادته في التصحيح لهذا الحديث وكذا الذهبي لم يعرج كعادته في التصحيح أو غيره فالحاكم والذهبي سكتا عن هذا الحديث ص ) .(@)(@@) | 1 ( عبد الله بن رواحة رضي الله عنه من الإكمال ) 1(@)(@@) 33589 - نعم الرجل عبد الله بن رواحة .(@)(@@) % ( ابن عساكر - عن أبي هريرة ) .(@)(@@) 33590 - رحم الله ابن رواحة ! إنه يحب المجالس التي تتباهى بها الملائكة .(@)(@@) % ( حم 
ms4531	 - عن أنس ) .(@)(@@) | 1 ( عبد الله بن الزبير رضي الله عنه من الإكمال ) 1(@)(@@) 33591 - ويل لك من الناس ! وويل للناس منك ! لا تمسك النار إلا قسم اليمين - قاله لابن الزبير .(@)(@@) % ( حل - عن كيسان مولى عبد الله ابن الزبير ) ( أول مولود ولد بعد الهجرة عبد الله بن الزبير وأمه أسماء بنت أبي بكر الصديق . الحاكم في المستدرك ( 3 / 550 ) ص ) .(@)(@@) | 1 ( عبد الله بن جعفر رضي الله عنه ( ولدت أسماء بنت عميس عبد الله بن جعفر بن أبي طالب بأرض الحبشة وتوفي سنة ( 80 ) وعمره كذلك ( 80 ) سنة . الحاكم في المستدرك ( 3 / 566 ) ص ) من الإكمال ) 1(@)(@@) 33592 - أما محمد فشبيه عمنا أبي طالب ، وأما عبد الله فشبيه خلقي وخلقي .(@)(@@) % ( ط وابن سعد ، حم ، طب ، حل وأبو نعيم في المعرفة ، ك ، كر - عن عبد الله بن جعفر ) .(@)(@@) 33593 - يا عبد الله هنيئا لك مريئا ! خلقت من طيني ، وأبوك يطير مع الملائكة في السماء .(@)(@@) % ( ابن عساكر - عن علي بن عبد الله بن جعفر عن أبيه ) .(@)(@@) | 1 ( عبد الله ذو البجادين رضي الله عنه من الإكمال ) 1(@)(@@) 33594 - رحمك الله ! إن كنت لأواها تلاء للقرآن - قاله لعبد الله ذي البجادين .(@)(@@) % ( ت ( أخرجه الترمذي كتاب الجنائز باب ما جاء في الدفن بالليل رقم ( 1057 ) وقال : حسن . ص ) ، طس ، حل - عن ابن عباس ) .(@)(@@) PageV11P335(@)(@@) | 1 ( عبد الله بن بسر رضي الله عنه من الإكمال ) 1(@)(@@) 33595 - يعيش هذا الغلام قرنا - قاله لعبد الله بن بسر .(@)(@@) % ( حم ( أورده الهيثمي في مجمع الزوائد ( 9 / 404 و 405 ) وقال : رواه الطبراني والبزار ورجال أحد إسنادي البزار رجال الصحيح غير الحسن بن أيوب الحضرمي وهو ثقة . ص ) وابن جرير طب وابن منده وتمام ، ك ، هق في الدلائل - عن عبد الله بن بسر ) .(@)(@@) | 1 ( عبد الله بن أنيس رضي الله عنه من الإكمال ) 1(@)(@@) 33596 - تخصر بهذه حتى تلقاني بها يوم القيامة وأقل الناس المتخصرون .(@)(@@) % ( حل - عن عبد الله بن أنيس ) أن رسول الله صلى الله عليه وسلم أعطاه مخصرة وقال 
ms4532	 : فذكره .(@)(@@) 33597 - خذ هذه فتخصر بها يوم القيامة فإن المتخصرين يومئذ قليل ، قال : يا رسول الله ! مماذا ؟ قال : آية بيني وبينك يوم القيامة .(@)(@@) % ( ابن سعد ، حم ، ع وابن خزيمه ، حب ، طب ، ص - عن عبد الله ابن أنيس الأنصاري ) .(@)(@@) | 1 ( عبد الله أبو سلمة بن عبد الأسد رضي الله عنه من الإكمال ) 1(@)(@@) 33598 - أول من يعطى كتابه بيمينه أبو سلمة بن عبد الأسد ، وأول من يعطى كتابه بشماله أخوه أبو سفيان بن عبد الأسد .(@)(@@) % ( الديلمي عن ابن عباس ؛ وفيه حبيب بن زريق كاتب مالك ) .(@)(@@) 33599 - اللهم اغفر لأبي سلمة وارفع درجته في المقربين واخلفه في عقبه في الغابرين واغفر لنا وله يا رب العالمين ، وافسح له في قبره ونور له فيه .(@)(@@) % ( حم ، م ، د - عن أم سلمة ) ( أخرجه أحمد في مسنده ( 5 / 297 ) ومسلم في صحيحه كتاب الجنائز باب في أغماض الميت . . . ) رقم ( 920 ) وأول الحديث : ( إن الروح إذا قبض تبعه البصر . . . ) ص ) .(@)(@@) | 1 ( أبو هند عبد الله وقيل يسار وقيل سالم رضي الله عنه من الإكمال ) 1(@)(@@) 33600 - من سره أن ينظر إلى من صور الله الكتاب في قلبه فلينظر إلى أبي هند . أنكحوا أبا هند وانكحوا إليه .(@)(@@) % ( عد - عن عائشة ) ( قال ابن الأثير في أسد الغابة ( 6 / 322 ) أبو هند الحجام البياضي مولى فروة بن عمرو ، اسمه عبد الله وقيل يسار وذكر الحديث - وكذا ذكره ابن الأثير في أسد الغابة ( 5 / 519 ) ص ) .(@)(@@) | 1 ( عبيد بن سليم أبو عامر رضي الله عنه من الإكمال ) 1(@)(@@) 33601 - اللهم اجعل عبيدا أبا عامر فوق أكثر الناس يوم القيامة .(@)(@@) % ( ابن سعد ، طب - عن أبي موسى ) ( أبو عامر الأشعري ، اسمه عبيد بن سلم بن حضار . راجع أسد الغابة ( 6 / 188 ) ص ) .(@)(@@) 33602 - اللهم اغفر لعبيد أبي عامر ! اللهم اجعله يوم القيامة فوق كثير من خلقك ! اللهم اغفر لعبد الله بن قيس ذنبه وأدخله يوم القيامة مدخلا كريما .(@)(@@) % ( خ ، م - عن أبي موسى ) ( أخرجه مسلم كتاب فضائل الصحابة باب من فضائل أبي موسى 
ms4533	 رقم ( 2498 ) . ص ) .(@)(@@) | 1 ( عبيدة بن صيفي الجعفي رضي الله عنه ( أورده ابن الأثير في أسد الغابة ( 3 / 552 ) ص ) من الإكمال ) 1(@)(@@) 33603 - يا عبيدة ! أنتم أهل البيت لا يصيبكم خصاصة إلا فرجها الله عز وجل .(@)(@@) % ( أبو نعيم - عن عبيدة بن صيفي الجعفي ) .(@)(@@) PageV11P336(@)(@@) | 1 ( عتاب بن أسيد رضي الله عنه ( عتاب بن أسيد بن أبي العيص . وأورد الحديث ابن الأثير في أسد الغابة ( 3 / 551 ) ص ) من الإكمال ) 1(@)(@@) 33604 - رأيت فيما يرى النائم كأن عتاب بن أسيد أتى باب الجنة فأخذ بحلقة الباب فقلقلها حتى فتح له فدخل .(@)(@@) % ( الديلمي - عن أنس ) .(@)(@@) | 1 ( عتبة بن أبي لهب ( هو ابن عم النبي صلى الله عليه وسلم وأمه أم جميل . راجع ترجمته في أسد الغابة ( 3 / 569 ) ص ) رضي الله عنه من الإكمال ) 1(@)(@@) 33605 - إني استوهبت ابني عمي هذين من ربي فوهبهما لي - يعني عتبة بن أبي لهب وأخاه معتبا .(@)(@@) % ( ابن سعد - عن ابن عباس ) .(@)(@@) | 1 ( عثمان بن مظعون رضي الله عنه ( عثمان بن مظعون بن حبيب وهو أول رجل مات بالمدينة سنة اثنتين من الهجرة وهو أول من دفن بالبقيع . ص ) من الإكمال ) 1(@)(@@) 33606 - الحق بسلفنا الصالح عثمان بن مظعون .(@)(@@) % ( طب - عن الأسود ابن سريع ) قال : لما مات إبراهيم بن رسول الله صلى الله عليه وسلم قال : فذكره .(@)(@@) 33607 - ذهبت ولم تلبس منها بشيء .(@)(@@) % ( ابن سعد - عن أبي النضر ) قال : لما مر بجنازة عثمان بن مظعون قال رسول الله صلى الله عليه وسلم : فذكره ( حل عن أبي النضر عن زياد عن ابن عباس ) .(@)(@@) 33608 - الحقي بسلفنا الخير عثمان بن مظعون .(@)(@@) % ( ط وابن سعد ، طب ، ك - عن ابن عباس ) قال : لما ماتت زينب بنت رسول الله صلى الله عليه وسلم قال : فذكره .(@)(@@) 33609 - إن ابن مظعون لحي ستير .(@)(@@) % ( ابن سعد ، طب - عن سعد ابن مسعود وعمارة بن غراب اليحصبي ) .(@)(@@) 33610 - رحمك الله يا عثمان ! ما أصبت من الدنيا وما أصابت منك يعني ابن مظعون .(@)(@@) % ( حل - عن عبد ربه بن 
ms4534	 سعيد المدني ) .(@)(@@) 33611 - اذهب عنها أبا السائب ! فقد خرجت منها ولم تلبس منها بشيء - يعني ابن مظعون .(@)(@@) % ( حل - عن ابن عباس ) .(@)(@@) | 1 ( عثمان بن عامر أبو قحافة رضي الله عنه من الإكمال ) 1(@)(@@) 33612 - لو أقررت الشيخ في بيته لأتيناه تكرمة لأبي بكر .(@)(@@) % ( حم وأبو عوانة ، حب ، ك - عن أنس ) ( أخرجه الحاكم في المستدرك ( 3 / 244 ) صحيح وأقره الذهبي ص ) .(@)(@@) 33613 - هلا تركت الشيخ في بيته حتى أجيئه - يعني أبا بكر .(@)(@@) % ( ك - عن أسماء ) .(@)(@@) 33614 - هلا تركت الشيخ عني آتيه ؟ إنا لنحفظه لأيادي ابنه علينا .(@)(@@) % ( ك وتعقب - عن القاسم بن محمد عن أبيه عن أبي بكر ؛ قال الذهبي : القاسم لم يدرك أباه ولا أبوه أبا بكر ) ( أخرجه الحاكم في المستدرك ( 3 / 244 ) وقال الذهبي : عبد الله منكر الحديث . ص ) .(@)(@@) PageV11P337(@)(@@) | 1 ( عروة بن مسعود رضي الله عنه من الإكمال ) 1(@)(@@) 33615 - مثل عروة مثل صاحب يس دعا قومه إلى الله تعالى فقتلوه .(@)(@@) % ( طب ، ك - عن عروة مرسلا ) ( أخرجه الحاكم في المستدرك ( 3 / 616 ) ولم يذكر الحاكم ولا الذهبي عن هذا الحديث بشيء ولكن في سنده : ابن لهيعة ص ) .(@)(@@) | 1 ( عقيل بن أبي طالب ( أخرجه الحاكم في المستدرك ( 3 / 576 ) وسكتا عن درجة الحديث . وعقيل بن أبي طالب يكنى أبا يزيد أمه فاطمة بنت أسد وتوفي في خلافة معاوية . أسد الغابة ( 4 / 66 ) ص ) رضي الله عنه من الإكمال ) 1(@)(@@) 33616 - يا عقيل ! والله إني لأحبك لخصلتين : لقرابتك ، ولحب أبي طالب إياك ؛ وأما أنت يا جعفر ! فإن خلقك يشبه خلقي ؛ وأما أنت يا علي فأنت مني بمنزلة هارون من موسى غير أنه لا نبي بعدي .(@)(@@) % ( ابن عساكر - عن عبد الله بن عقيل عن أبيه عن جده عقيل بن أبي طالب ) .(@)(@@) 33617 - يا أبا يزيد ! إني لأحبك حبين : حبا لقرابتك مني ، وحبا لما كنت أعلم من حب عمي إياك - قاله لعقيل بن أبي طالب .(@)(@@) % ( ابن سعدج والبغوي ، طب ، وابن عساكر - عن أبي إسحاق مرسلا ؛ ك - عن أبي حذيفة ) .(@)(@@) 33618 - إني أحبك حبين : حبا 
ms4535	 لقرابتك مني وحبا لما كنت أعلم من حب عمي إياك - قاله لعقيل بن طالب .(@)(@@) % ( ابن سعد والبغوي ، طب ، ك وابن عساكر - عن أبي إسحاق مرسلا ؛ ك - عن أبي حذيفة ) .(@)(@@) 33619 - إني لأحبك حبين : حبا لك وحبا لحب أبي طالب لك .(@)(@@) % ( ابن عساكر - عن عبد الرحمن بن سابط ) قال : كان النبي صلى الله عليه وسلم يقول لعقيل : فذكره .(@)(@@) 33620 - مرحبا بك يا أبا يزيد ! كيف أصبحت - قاله لعقيل .(@)(@@) % ( الديلمي - عن جابر ) .(@)(@@) | 1 ( عكرمة بن أبي الجهل رضي الله عنه ) 1(@)(@@) 33621 - رأيت لأبي جهل عذقا في الجنة فلما أسلم عكرمة قلت : هذا هو .(@)(@@) % ( طب ، ك - عن أم سلمة ) ( أورده ابن الأثير في أسد الغابة ( 4 / 73 ) ص ) .(@)(@@) | 1 ( { الإكمال } من عكرمة بن أبي الجهل رضي الله عنه ) 1(@)(@@) 33622 - لا ، ولكني تبسمت إذ كانا جميعا في درجة واحدة في الجنة .(@)(@@) % ( ابن عساكر - عن يزيد بن أبي حبيب ) أن عكرمة بن أبي جهل قتل رجلا من الأنصار يقال له المحذر فأخبر رسول الله صلى الله عليه وسلم بذلك فتبسم ، فقال له رجل من الأنصار : يا رسول الله ! تبسمت أن قتل رجل من قومك رجلا من قومنا ؟ قال : فذكره .(@)(@@) 33623 - ما ذاك أضحكني ولكنه قتله وهو معه في درجته .(@)(@@) % ( ابن عساكر - عن أنس ) قال : قتل عكرمة بن أبي جهل صخرا الأنصاري فبلغ ذلك النبي صلى الله عليه وسلم فضحك ،(@)(@@) PageV11P338 فقالت الأنصار : يا رسول الله ! تضحك أن قتل رجل من قومك رجلا من قومنا ؟ قال : فذكره .(@)(@@) 33624 - مرحبا بالراكب المهاجر ! مرحبا بالراكب المهاجر .(@)(@@) % ( ت وضعفه ، وابن سعد ، ك - عن عكرمة بن أبي جهل ) .(@)(@@) 33625 - يأتيكم عكرمة بن أبي جهل مؤمنا مهاجرا فلا تسبوا أباه ، فإن سب الميت يؤذي الحي ولا يبلغ الميت .(@)(@@) % ( الواقدي وابن سعد وابن عساكر - عن عبد الله بن الزبير ) .(@)(@@) | 1 ( حرف الفاء ) 1(@)(@@)(@)(@@) | 1 ( فرات بن حيان رضي الله عنه ) 1(@)(@@) 33626 - إن منكم رجالا لا أعطيهم شيئا ، أكلهم إلى إيمانهم ، منهم فرات بن حيان .(@)(@@) % ( حم ، ه ، ك ، هق - عن فرات 
ms4536	 ) ( أخرجه أبو داود كتاب الجهاد باب الجاسوس الذمي رقم ( 2652 ) ص ) .(@)(@@) | 1 ( فاتك بن فاتك رضي الله عنه ) 1(@)(@@)(@)(@@) | 1 ( { الإكمال } من فاتك بن فاتك رضي الله عنه ) 1(@)(@@) 33627 - اللهم ! بارك على آل فاتك كما آوى هذا المصاب .(@)(@@) % ( أبو عبيدة ( أورد الحديث ابن الأثير في أسد الغابة ( 4 / 348 ) ص ) وابن عساكر - عن أيوب ) قال : نبئت أن رسول الله صلى الله عليه وسلم أتى على رجل قد قطعت يده في سرقة وهو في فسطاط فقال : من آوى هذا المصاب ؟ ؟ قالوا : فاتك بن فاتك أو خزيمة بن فاتك ، قال : فذكره .(@)(@@) | 1 ( حرف القاف ) 1(@)(@@)(@)(@@) | 1 ( قيس بن سعد بن عبادة ( يكنى أبا الفضل وتوفي سنة تسع وخمسين . أسد الغابة ( 4 / 426 ) ص ) رضي الله عنه من الإكمال ) 1(@)(@@) 33628 - إن الجود لمن شيمة أهل ذلك البيت .(@)(@@) % ( أبو بكر في الغيلانيات وابن عساكر - عن جابر بن عبد الله ) أن رسول الله صلى الله عليه وسلم بعث بعثا عليهم قيس بن سعد بن عبادة فجهدوا فنحر لهم قيس تسع ركائب فلما قدموا ذكروا ذلك لرسول الله صلى الله عليه وسلم فقال : فذكره ( وابن عساكر عن جابر بن سمرة أيضا ) .(@)(@@) | 1 ( قضاعة بن معدويه رضي الله عنه ) 1(@)(@@) 33629 - قضاعة بن معدويه كان يكنى .(@)(@@) % ( ابن السني - عن عائشة ) .(@)(@@) | 1 ( قبيصة بن المخارق رضي الله عنه من الإكمال ) 1(@)(@@) 33630 - يا قبيصة ! ما مررت بحجر ولا شجر ولا مدر إلا استغفر لك ، يا قبيصة ! إذا صليت الفجر فقل ثلاثا : سبحان الله العظيم وبحمده ، تعافى من العمى والجذام(@)(@@) PageV11P339 والفالج ، يا قبيصة ! قل : اللهم ! إني أسألك مما عندك فأفض علي من فضلك ، وانشر علي من رحمتك ، وأنزل علي من بركاتك .(@)(@@) % ( حم - عن قبيصة بن المخارق ) ( عداده في أهل البصرة ويكنى أبا بشر . أسد الغابة ( 4 / 384 ) . والحديث في مسند الإمام أحمد بن حنبل . ( 6 / 60 ) ص ) .(@)(@@) | 1 ( حرف الميم ) 1(@)(@@)(@)(@@) | 1 ( معاذ بن جبل رضي الله عنه ) 1(@)(@@) 33631 - دع عنك معاذا ، فإن الله يباهي به 
ms4537	 الملائكة .(@)(@@) % ( الحكيم عن معاذ ) ( توفي في طاعون عمواس سنة ( 18 ) ه وكان عمره ( 38 ) . راجع أسد الغابة ( 5 / 197 ) وراجع المستدرك ( 3 / 268 ) ص ) .(@)(@@) 33632 - إذا حضرت العلماء ربهم يوم القيامة كان معاذ بن جبل بين أيديهم بقذفة حجر .(@)(@@) % ( ابن عساكر - عن عمر ) .(@)(@@) 33633 - إن العلماء إذا حضروا ربهم كان معاذ بن جبل بين أيديهم رتوة ( رتوة : وفي حديث معاذ ( أنه يتقدم العلماء يوم القيامة برتوة ) أي برمية سهم . النهاية ( 2 / 195 ) ب ) بحجر .(@)(@@) % ( حل - عن عمر ) ( أخرجه أبو نعيم في الحلية ( 1 / 228 ) ص ) .(@)(@@) 33634 - معاذ بن جبل أعلم الناس بحلال الله وحرامه .(@)(@@) % ( حل - عن أبي سعيد ) .(@)(@@) 33635 - معاذ بن جبل أمام العلماء يوم القيامة برتوة .(@)(@@) % ( طب ، حل عن محمد بن كعب مرسلا ) .(@)(@@) | 1 ( { الإكمال } من معاذ بن جبل رضي الله عنه ) 1(@)(@@) 33636 - معاذ بن جبل أعلم الأولين والآخرين بعد النبيين والمرسلين وإن الله تعالى يباهي به الملائكة .(@)(@@) % ( ك وتعقب - عن أبي عبيدة وعبادة ابن الصامت معا ) .(@)(@@) 33637 - معاذ بن جبل بين يدي العلماء طائفة يوم القيامة .(@)(@@) % ( حل عن عمر ) .(@)(@@) 33638 - معاذ بين يدي العلماء يوم القيامة رتوة .(@)(@@) % ( ش - عن محمد ابن عبيدة الله الثقفي مرسلا ) .(@)(@@) 33639 - معاذ بين يدي العلماء نبذة ( نبذة : وجلس نبذة - بضم النون وفتحها - أي : ناحية . المختار ( 510 ) ب ) .(@)(@@) % ( ش - عن الحسن مرسلا ) .(@)(@@) 33640 - إن معاذ بن جبل يحشر يوم القيامة بين يدي العلماء نبذة .(@)(@@) % ( حم - عن عمران ) .(@)(@@) 33641 - معاذ بن جبل أمام العلماء يوم القيامة ، لا يحجبه من الله إلا المرسلون ، وإن سالما مولى أبي حذيفة شديد الحب لله ، لو لم يخف الله ما عصاه .(@)(@@) % ( الديلمي - عن عمر ) .(@)(@@) 33642 - يأتي معاذ بن جبل يوم القيامة بين يدي العلماء برتوة .(@)(@@) % ( ابن عساكر - عن عمر ؛ ابن سعد - عن محمد بن كعب القرظي مرسلا وعن ابن عون مرسلا وعن الحسن مرسلا ) .(@)(@@) PageV11P340(@)(@@) 33643 - آمن كل شيء من معاذ حتى خاتمه .(@)(@@) % ( ابن سعد - عن محمد ابن عبد الله بن عمر بن عثمان ) .(@)(@@) | 1 ( ماعز رضي الله عنه ( ماعز 
ms4538	 بن مالك الأسلمي معدود في المدنيين . أسد الغابة ( 5 / 8 ) . والحديث أخرجه مسلم كتاب الحدود رقم ( 1695 ) ص ) . ) 1(@)(@@) 33644 - استغفروا لماعز بن مالك ، لقد تاب توبة لو قسمت بين أمة لوسعتهم .(@)(@@) % ( م ، د ، ن - عن بريدة ) .(@)(@@) 33645 - لا تسبوا ماعزا .(@)(@@) % ( طب - عن أبي الطفيل ) .(@)(@@) | 1 ( { الإكمال } من ماعز رضي الله عنه ) 1(@)(@@) 33646 - إن ماعزا البكائي أسلم آخر قومه وإنه لا تجني عليه الأيدي .(@)(@@) % ( ابن سعد ، طب - عن عبد الرحمن بن ماعز ) ( ماعز أبو عبد الله بن ماعز وأورد الحديث ابن الأثير في أسد الغابة ( 5 / 8 ) وهذا غير ماعز بن مالك المتقدم الذكر ص ) .(@)(@@) 33647 - لقد رأيته يتخضخض في أنهار الجنة - يعني ماعزا .(@)(@@) % ( أبو عوانة ، حب ، ص - عن جابر ) .(@)(@@) 33648 - والذي نفسي بيده ! إنه لفي نهر من أنهار الجنة ينغمص فيه - يعني ماعزا فقال هزال : أنا أمرته أن يأتيك يا رسول الله ! قال : لو سترته بملحفتك كان خيرا .(@)(@@) % ( ابن عساكر - عن أبي هريرة ) ( آخر فقرة من الحديث هي في سنن أبي داود كتاب الحدود باب في الستر على أهل الحدود رقم ( 4377 ) ص ) .(@)(@@) | 1 ( مالك بن سنان رضي الله عنه ) 1(@)(@@) ( مالك بن سنان والد أبي سعيد الخدري قتل يوم أحد شهيدا . أسد الغابة ( 5 / 27 ) وأورد الحديث .(@)(@@) والحديث كذلك في المستدرك ( 3 / 563 ) وقال الذهبي : إسناده مظلم ص ) من الإكمال(@)(@@) 33649 - من أحب أن ينظر إلى من خالط دمي دمه فلينظر إلى مالك بن سنان .(@)(@@) % ( البغوي ، طب ، ك وتعقب - عن أبي سعيد ) .(@)(@@) | 1 ( مصعب بن عمير رضي الله عنه من الإكمال ) 1(@)(@@) 33650 - انظروا إلى هذا الذي نور الله قلبه ، لقد رأيته بين أبوين يغذوانه بأطيب الطعام والشراب ، ولقد رأيت عليه حلة شراها بمائة درهم فدعاه حب الله وحب رسوله إلى ما ترون .(@)(@@) % ( حل - عن عمر ؛ ق ، كر - عن ابن عمر ) قال : نظر النبي صلى الله عليه وسلم إلى مصعب بن عمير مقبلا وعليه إهاب كبش قد تنطق به فقال : فذكره .(@)(@@) 33651 - لقد رأيت هذا - يعني مصعب 
ms4539	 بن عمير - عند أبويه بمكة يكرمانه وينعمانه وما فتى من فتيان قريش مثله ، ثم خرج من ذلك ابتغاء مرضاة الله تعالى ونصرة رسوله ، أما ! إنه لا يأتي عليكم إلا كذا وكذا حتى يفتح عليكم فارس والروم فيغدوا أحدكم في حلة ويروح في حلة أخرى ويغدى عليكم بقصعة ويراح عليكم بأخرى ، قالوا : يا رسول الله ! نحن اليوم خير أو ذلك اليوم ؟ قال : بل أنتم اليوم خير ، أما ! لو تعلمون من الدنيا ما أعلم لاستراحت أنفسكم منها .(@)(@@) % ( ك - عن الزبير ) ( أخرجه الحاكم في المستدرك ( 3 / 629 ) وسكت عنه وكذا الذهبي ص ) .(@)(@@) PageV11P341(@)(@@) | 1 ( معاوية بن أبي سفيان ( معاوية بن صخر بن أبي سفيان أسلم هو وأبوه وأخوه يزيد وأمه هند يوم فتح مكة وتوفي معاوية سنة ستين وهو ابن ثمان وسبعين سنة وذكر ابن الأثير في أسد الغابة ( 5 / 209 / 212 ) الأحاديث ص ) رضي الله عنه من الإكمال ) 1(@)(@@) 33652 - يبعث الله معاوية يوم القيامة وعليه رداء من نور الإيمان .(@)(@@) % ( ابن عساكر - عن ابن عمر ؛ حب في الضعفاء ومحمد بن الحسين الرازي في فوائده وابن عساكر والرافعي - عن حذيفة ؛ وأورده ابن الجوزي في الموضوعات ) .(@)(@@) 33653 - يا معاوية ! إن وليت أمرا فاتق الله واعدل .(@)(@@) % ( حم وابن سعد ، ع وابن عساكر - عن معاوية ) .(@)(@@) 33654 - يا معاوية ! إن ملكت فأحسن .(@)(@@) % ( طب ، ق في الدلائل وابن عساكر - عن معاوية ؛ وفيه إسماعيل بن إبراهيم بن مهاجر ؛ قال ق : ضعيف إلا أن للحديث شواهد ) .(@)(@@) 33655 - إن معاوية لا يصارع أحدا إلا صرعه معاوية .(@)(@@) % ( الديلمي عن ابن عباس ) .(@)(@@) 33656 - اللهم علم معاوية الكتاب والحساب وقه العذاب .(@)(@@) % ( حم ، ع ، طب وأبو نعيم - عن العرباض بن سارية ؛ الحسن بن سفيان والحسن بن عرفة في حزبه والبغوي وابن قانع وأبو نعيم ، كر - عن الحارث بن زياد ؛ عد ، كر - عن ابن عباس ؛ طس ، طب وتمام - عن عبد الله بن أبي عميرة المزني ؛ ابن الجوزي في الواهيات - عن أبي هريرة ) .(@)(@@) 33657 - اللهم ! علمه الكتاب والحساب ومكن له في البلاد وقه العذاب - قاله لمعاوية .(@)(@@) % ( ابن سعد 
ms4540	 ، طب وابن عساكر - عن مسلمة ابن مخلد ) .(@)(@@) 33658 - اللهم ! علمه العلم واجعله هاديا مهديا واهده واهد به قاله لمعاوية .(@)(@@) % ( حم ، ت ( أخرجه الترمذي كتاب المناقب رقم ( 3824 ) وقال : حسن صحيح ص ) : حسن غريب ، طس ، حل وتمام وابن عساكر عن عبد الرحمن بن أبي عميرة المزني ؛ ابن عساكر - عن عمر ) .(@)(@@) | 1 ( المغيرة أبو سفيان بن الحارث رضي الله عنه من الإكمال ) 1(@)(@@) 33659 - أبو سفيان بن الحارث خير أهلي .(@)(@@) % ( طب ، ك - عن أبي حبة البدري ) ( أبو سفيان بن الحارث بن عبد المطلب اسمه المغيرة توفي سنة ( 20 ) وصلى عليه عمر بن الخطاب . المستدرك ( 3 / 255 ) . والحديث كذلك أخرجه الحاكم في المستدرك ( 3 / 255 ) وقال : صحيح ، وأقره الذهبي ص ) .(@)(@@) | 1 ( حرف النون ) 1(@)(@@)(@)(@@) | 1 ( نعمان بن بشير رضي الله عنه ) 1(@)(@@) 33660 - أما ترضى أن يبلغ ما بلغت ثم يأتي الشام فيقتله منافق من أهل الشام .(@)(@@) % ( ابن سعد - عن عبد الملك بن عمير ) أن بشير بن سعد جاء بالنعمان بن بشير إلى النبي صلى الله عليه وسلم فقال : يا رسول الله ! ادع لابني هذا قال : فذكره .(@)(@@) | 1 ( نعيم بن سعد رضي الله عنه ) 1(@)(@@) 33661 - دخلت الجنة فسمعت نجمة من نعيم .(@)(@@) % ( ابن سعد - عن أبي بكر العدوي مرسلا ) .(@)(@@) PageV11P342(@)(@@) | 1 ( نعيمان رضي الله عنه من الإكمال ) 1(@)(@@) 33662 - لا تقولوا لنعيمان إلا خيرا ، فإنه يحب الله ورسوله .(@)(@@) % ( ابن سعد - عن أيوب بن محمد مرسلا ) ( النعيمان بن عمرو بن رفاعة وتوفي في خلافة معاوية وذكر ابن سعد في الطبقات ( 3 / 494 ) الحديث . ص ) .(@)(@@) | 1 ( حرف الواو ) 1(@)(@@)(@)(@@) | 1 ( وحشي بن حرب الحبشي رضي الله عنه من الإكمال ) 1(@)(@@) 33663 - يا وحشي ! اغز وقاتل في سبيل الله كما قاتلت لتصد عن سبيل الله .(@)(@@) % ( طب - عن وحشي ) ( وحشي بن حرب الحبشي أبو دسمة وهو من سودان مكة . أسد الغابة ( 5 / 438 ) ص ) .(@)(@@) | 1 ( حرف الهاء ) 1(@)(@@)(@)(@@) | 1 ( هبار بن الأسود رضي الله عنه من الإكمال ) 1(@)(@@) 33664 - قد عفوت عنك وقد أحسن الله بك حيث هداك 