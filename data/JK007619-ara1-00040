ms21	 لقينا من أخي تيم % % ومن أرجاف قومه % 2(@)(@@) % كلما جئناه قالوا % % شغل القاضي بصومه % 3(@)(@@) % يجلس الخصم لديه % % وهو في أطيب نومه % PageV01P140 البحر : منسرح 1(@)(@@) % إن أبا رهم في تكرمه % % بلغه الله منتهى هممه % PageV01P141 البحر : طويل 1(@)(@@) % فتى لا تراه لابسا ظل نبوة % % ولا راكبا إلا ظهور العزائم % 2(@)(@@) % ولا ساحبا ذيلا ولا باسطا يدا % ولا قدما إلا على فم لائم % 3(@)(@@) % غذا اشتكت وقع المناسم بلدة % % تشكت إليه الأرض وقع المناسم % PageV01P142 البحر : سريع 1(@)(@@) % مالي على صومك من رشفة % % فاك وإن أظماك من لوم % 2(@)(@@) % فاز على عاشقه صومه % % إني أرى الصوم من القوم % PageV01P143 البحر : وافر تام 1(@)(@@) % أجر على سنام الأرض ذيلي % % وأعقد بردتي على شمام % PageV01P144 البحر : خفيف تام 1(@)(@@) % قد تركت الرياح يا ابن رياح % % وهي حسرى إن هف منها نسيم % 2(@)(@@) % نهكت مالك الحقوق فأضحى % % لك مال نضو وفعل جسيم % PageV01P145 البحر : مجزوء المتقارب 1(@)(@@) % أعاذلتي أقصري % % أبع جدتي بالمنن % 2(@)(@@) % ذريني أجد بالثرا % % ء حمدا فنعم الثمن % 3(@)(@@) % أرى الناس أحدوثة % فكوني حديثا حسن % 4(@)(@@) % أمن على المجتدي % % وما أتبع المن من % 5(@)(@@) % كأن لم يزل ما أتى % % وما قد مضى لم يكن % 6(@)(@@) % وكل امرئ بالردى % % إلى أمد مرتهن % 7(@)(@@) % إذا وطن رابني % % فكل بلاد وطن % 8(@)(@@) % إذا عز يوما أخو % % ك في بعض أمر فهن % PageV01P146 البحر : طويل 1(@)(@@) % هي النفس تجزي الود بالود أهله % % وإن سمتها الهجران فالهجر دينها % % 2(@)(@@) % إذا ما قريت بت منها حباله % % فأهون مفقود عليها قرينها % % 3(@)(@@) % لبئس معار الود من لا يربه % ومستودع الأسرار من لا يصونها % % PageV01P147 البحر : بسيط تام 1(@)(@@) % ناديته وظلام الليل معتكر % % تحت الرواق دفينا في الرياحين % 2(@)(@@) % فقلت قم : قال رجلي لا تطاوعني % % فقلت : خذ قال : كفي لا تواتيني % % 3(@)(@@) % إني غفلت عن الساقي قصيرني % % كما تراني سليب العقل والدين % PageV01P148 البحر : سريع 1(@)(@@) % إن كنت قد صفرت أذن الفتى % % فطالما صفر آذانا % % 2(@)(@@) % لا تعجبي إن كنت كشخنته % فإنما كشخت كشخانا % % PageV01P149 البحر : متقارب تام 1 
ms22	(@)(@@) % إذا لم يزرني ندمانيه % % خلوت فنادمت بستانيه % 2(@)(@@) % فنادمته خضرا مونقا % % يهيج لي ذكر أشجانيه % 3(@)(@@) % يقرب مفرحة المستلذ % % ويبعد همي وأحزانيه % 4(@)(@@) % أرى فيه مثل مدارى الظباء % % تظل لأطلائها حانيه % 5(@)(@@) % ونور أقاح شتيت النبات % % كما ابتسمت عجبا غانيه % 6(@)(@@) % ونرجسه مثل عين الفتاة % % إلى وجه عاشقها رانيه % PageV01P150 البحر : بسيط تام 1(@)(@@) % القلب بعدك لم يسكن إلى سكن % والعين مذ غبت لم تنظر إلى حسن % 2(@)(@@) % كأنما الروح لما غبتم بعدت % حتى إذا عدتم عادت إلى البدن % PageV01P151 البحر : كامل تام 1(@)(@@) % يابن الخلائف وابن كل مبارك % رأس الدعائم سابق الأغصان % 2(@)(@@) % إن العلوج على ابن عمك أصفقوا % % فأتوك عنه بأعظم البهتان % 3(@)(@@) % قرفوه عندك بالتعدي ظالما % وهم ابتدوه بأعظم العدوان % 4(@)(@@) % شتموا له عرضا أغر مهذبا % % أعراضهم أولى بكل هوان % 5(@)(@@) % وسموا بأجسام إليه مهينة % وصلت بالأم أذرع وبنان % 6(@)(@@) % خلقت لمد القلس لا لتناول % % عرض الشريف ولا لمد عنان % 7(@)(@@) % لم يحفظوا قرباه منك فينتهوا % % إذ لم يهابوا حرمة السلطان % 8(@)(@@) % أيذل مظلوما وجدك جده % % كيما يعز بذله علجان % 9(@)(@@) % وينال أقلف ، كربلاء بلاده % % ذل ابن عم خليفة الرحمان % 10(@)(@@) % إني أعيذك أن تنال بك التي % % تطغى العلوج بها على عدنان % PageV01P152 البحر : كامل تام 1(@)(@@) % أفنى بحد السيف آجال العدا % % وسيوفه وعوالي المران % 2(@)(@@) % والضرب يفعل بالحسام وحده % % ما تفعل الآجال بالإنسان % PageV01P153 البحر : متقارب تام 1(@)(@@) % أطاع الفريضة والسنة % % فتاه على الأنس والجنه % 2(@)(@@) % كأن لنا النار من دونه % % وأفراده الله بالجنه % 3(@)(@@) % وينظر نحوي إذ زرته % % بعين حماة إلى كنه % PageV01P154 البحر : بسيط تام 1(@)(@@) % لو كان يعطى المنى الأعمام في ابن أخ % % أصبحت في جوف قرقور إلى الصين % 2(@)(@@) % قد كان هما طويلا لا يقام له % % لو كان رؤيتنا أياك في الحين % 3(@)(@@) % فكيف بالصبر إذ أصبحت أكثر في % % مجال أعيننا من رمل ( يبرين ) % 4(@)(@@) % يا أبغض الناس في عسر وميسرة % % وأقذر الناس في دنيا وفي دين % 5(@)(@@) % تيه الملوك إذا فلس ظفرت به % % وحين تفقده ذل 
ms23	 المساكين % 6(@)(@@) % لو شاء ربي لأضحى واهبا لأخي % % بمر ثكلك أجرا غير ممنون % 7(@)(@@) % وكان خيرا له لو كان مؤتزرا % % في السالفات على غرمول عنين % 8(@)(@@) % وقائل لي : ما أضناك ؟ قلت له : % شخص ترى وجهه عيني فيضنيني % % 9(@)(@@) % إن القلوب لتطوى منك يا ابن أخي % % إذا رأتك على مثل السكاكين % 10(@)(@@) % لا يحمدونك في خلق ولا خلق % % إذا رأوك ولا دنيا ولا دين % PageV01P155 11(@)(@@) % وكيف تخشى شهادات يقوم بها % % ثلاثة شاهدا زور ومجنون % PageV01P156 البحر : خفيف تام 1(@)(@@) % طيلسان لو كان لفظا إذا ما % % شك خلق في أنه بهتان % 2(@)(@@) % فهو كالطور إذ تجلى له الله % % فهدت قواه والأركان % 3(@)(@@) % يا ابن حرب فكيف يبقى على البذ % % لة ثوب يذوب وهو يصان % 4(@)(@@) % يا ابن حرب رفونا حتى % % بقي الرفو وانقضى الطيلسان % PageV01P157 البحر : خفيف تام 1(@)(@@) % لم أنله فنلته بالأماني % % في منامي سرا من الهجران % 2(@)(@@) % واصل الحلم بيننا بعد هجر % % فاجتمعنا ونحن مفترقان % 3(@)(@@) % غير أن الأرواح خافت رقيبا % % فطوت سرها عن الأبدان % 4(@)(@@) % منظر كان لذة القلب إلا % انه منظر بغير عيان % PageV01P158 البحر : وافر تام 1(@)(@@) % أبو إسحق صاحبه معنى % % يروح ويغتدي في غير معنى % % 2(@)(@@) % وينظر في القضاء بغير علم % % وأجهل مايكون إذا تأنى % % PageV01P159 البحر : خفيف تام 1(@)(@@) % هي عوراء باليمين وهذا % % أعور باليسار وافق شنا % % 2(@)(@@) % بين شخصيهما ضرير إذا ما % % قعدت عن شماله تتغنى % % PageV01P160 البحر : بسيط تام 1(@)(@@) % يا من فدت نفسه نفسي ومن جعلت % له وقاء لما يخشى واخشاه % 2(@)(@@) % أبلغ أخانا أدام الله نعمته % % أني وإن كنت لا ألقاه ألقاه % 3(@)(@@) % وان طرفي موصول برؤيته % % وان تباعد عن مثواي مثواه % 4(@)(@@) % ما نعمة قدمت عندي ولا حدثت % % إلا ومنه بها أحظاني الله % 5(@)(@@) % ولا بلاء جميل جر لي حسنا % % إلا به نلت أولاه وأخراه % 6(@)(@@) % الله يعلم اني لست أذكره % % وكيف يذكره من ليس ينساه % 7(@)(@@) % عدوا فهل حسن لم يحوه ( حسن % % وهل فتى عدلت جدواه جدواه % 8(@)(@@) % البحر يفنى ولا تفنى مكارمه % % والقطر 
ms24	 يحصى ولا تحصى عطاياه % % 9(@)(@@) % أراني الله ما قلبي يزاوله % % وحاطه وتولاه وأبقاه % % PageV01P161 10(@)(@@) % لا شيء مما نرى إلا له شبه % % وما لكم ' آل إبراهيم ' أشباه % PageV01P162 البحر : مجزوء الرمل 1(@)(@@) % لي حبيب أنا أهوا % % ه على ما كان فيه % 2(@)(@@) % لي موتان بجبي % % ه وبغضي لأبيه % 3(@)(@@) % ليس بغضي لأبيه % % دون بغضي لأخيه % 4(@)(@@) % أشتهي موتهما مث % % ل اشتهائي لثم فيه % PageV01P163 البحر : خفيف تام 1(@)(@@) % لي حبيب أضر بي ما أقاسي % % من فتوني به وبغض أبيه % 2(@)(@@) % سامني القرب من أبيه ، وبغضي % % لأبيه أشد من حبيه % 3(@)(@@) % لي موتان من هوى ذا ومن بغ % % ضي لهذا فليس لي من شبيه % PageV01P164 البحر : مجزوء الرمل 1(@)(@@) % نسب الجماز % % مقصور إليه منتهاه % 2(@)(@@) % يتراءى نسب النا % % س فما يخفى سواه % 3(@)(@@) % يتحاجى في أبي % % الجماز من هو كاتباه % 4(@)(@@) % ليس يدري من أبو الجم % % از إلا من يراه % PageV01P165 البحر : خفيف تام 1(@)(@@) % من لدان هواه ناء هواه % % قد شكته شكواه من شكواه ؟ % 2(@)(@@) % ومرى شوقه المدامع حتى % % صار يبكيه من بكاه بكاه % 3(@)(@@) % بأبي غائب بشوقي وفكري % % فيه ألقاه حين لا ألقاه % 4(@)(@@) % مثلته المنى لقلبي وطرفي % % فكأني أراه إذ لا أراه % 5(@)(@@) % يا أبا جعفر لقد نال من لم % % ير يوما مناه فينا مناه % PageV01P166 البحر : خفيف تام 1(@)(@@) % موقف للرقيب لا أنساه % % لست أختاره ولا آباه % 2(@)(@@) % مرحبا بالرقيب من غير وعد % % جاء يجلو علي من أهواه % PageV01P167 البحر : طويل 1(@)(@@) % بدت بين أثواب الحداد كأنها % % هلال أتى من غمرة فتموها % % 2(@)(@@) % فسقيا لذاك الوجه يوم لقيته % % صبيحة يوم النحر اشعث أمرها % % 3(@)(@@) % لقد حاولت تشويهه كنه جهدها % % وهل يستطيع البدر أن يتشوها % % PageV01P168 البحر : وافر تام 1(@)(@@) % رأتنا أم عمرو فازدرتنا % % ونقض الحرب منظره زري % % 2(@)(@@) % إذا لم تقدحي زنديك يوما % % فما يدريك أيهما الوري % 3(@)(@@) % سلي بي تخبري أني طروب % % إلى الأيسار أبلج بختري % 4(@)(@@) % وإني حين تختلف العوالي % % إلى الأبطال أكيس قسوري % 5(@)(@@) % كليني للندى والباس إني % % بكل بسالة وندى حري 
ms25	 % PageV01P169 البحر : وافر تام 1(@)(@@) % أراك الله يا ذلفاء ما قد % % لقيه قعنب يوم الهنيه % 2(@)(@@) % غدا يبغي النكاح فعاد فيه % % أيور كالعصي مهلبيه % 3(@)(@@) % تشقق دبره ويقول هذا % % جزاء ذوي التلوط بالنسيه % PageV01P170 البحر : سريع 1(@)(@@) % من حل ( شروين ) له منزلا % % فلتنهه الأولى عن الثانيه % 2(@)(@@) % فليس يدعوه إلى بيته % % إلا فتى في بيته زانيه % PageV01P171 البحر : - - 1(@)(@@) % مت من حبه وبغض أبيه % % PageV01P172 البحر : - - 1(@)(@@) % بذ حسن الوجوه حسن قفاكا % % PageV01P173 
