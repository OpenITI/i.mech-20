ms121	 غدوة وعشيا(@)(@@)(@@)(@@) | 1659 - (@)(@@) ابن عمر أهل فارس من ولد إسحق بن إبراهيم(@)(@@)(@@)(@@) | 1660 - (@)(@@) أبو هريرة(@)(@@) أهل شغل الله في الدنيا هم أهل شغل الله(@)(@@) PageV00P000(@)(@@) في الآخرة وأهل شغل أنفسهم في الدنيا هم أهل شغل أنفسهم في الآخرة(@)(@@)(@@)(@@) | 1661 - (@)(@@) أبو سعيد(@)(@@) أهل بدر كلهم في الجنة(@)(@@) فصل(@)(@@)(@@)(@@) | 1662 - (@)(@@) أنس بن مالك(@)(@@) أمتي لا تجتمع على ضلالة فإذا رأيتم الاختلاف فعليكم بالسواد الأعظم(@)(@@)(@@)(@@) | 1663 - (@)(@@) معاذ بن جبل(@)(@@) أمتي مرحومة متاب عليها تدخل قبورها بذنوبها وتخرج من قبورها لا ذنوب عليها ممحصا عنها ذنوبها(@)(@@)(@@)(@@) | 1664 - (@)(@@) أنس بن مالك(@)(@@) أمتي على خمس طبقات فأربعون سنة أهل بر وتقوى ثم الذين يلونهم إلى عشرين ومائة سنة أهل تراحم وتواصل ثم الذين يلونهم إلى ستين ومائة أهل تدابر وتقاطع ثم(@)(@@) PageV00P000(@)(@@) الهرج الهرج النجا النجا(@)(@@)(@@)(@@) | 1665 - (@)(@@) أبو الدرداء(@)(@@) أمتي على ثلاثة أثلاث يدخلون الجنة بغير حساب وهم الذين ذكرهم الله ومنهم سابق بالخيرات بإذن الله وثلاث يحاسبون حسابا يسيرا ثم يدخلون الجنة وهم الذين ذكرهم الله ومنهم مقتصد وأما الثلث الباقي فيحاسبون حتى يطول همهم وبكاؤهم ويكثر فزعهم ثم يدخلون الجنة(@)(@@)(@@)(@@) | 1666 - (@)(@@) أبو هريرة(@)(@@) أمتي في الأرض أكثر من عدد الحصا(@)(@@) فصل(@)(@@)(@@)(@@) | 1667 - (@)(@@) ابن عباس(@)(@@) أمان أمتي من الغرق إذا ركبوا السفن أن يقولوا بسم الله وما قدروا الله حق قدره والأرض جميعا الآية بسم الله مجراها ومرساها إن ربي لغفور رحيم(@)(@@)(@@)(@@) | 1668 - (@)(@@) أبو هريرة(@)(@@) أعمار أمتي ما بين الستين إلى السبعين وأقلهم من يجوز ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1669 - (@)(@@) ابن عباس(@)(@@) أمان أهل الأرض من الغرق القوس وأمان أهل الأرض من الاختلاف الموالاة لقريش(@)(@@)(@@)(@@) | 1670 - (@)(@@) أبو هريرة(@)(@@) آمين خاتم رب العالمين على عباده يعني يدفع عن قائلها العاهات والبلايا(@)(@@)(@@)(@@) | 1671 - (@)(@@) أبو هريرة(@)(@@) آيتان هما قرآن وهما يشفيان وهما مما يحبهما الله عز وجل الآيتان من آخر البقرة(@)(@@)(@@)(@@) | 1672 - (@)(@@) جابر بن عبد الله(@)(@@) أميران وليسا بأميرين المرأة تحج مع(@)(@@) PageV00P000(@)(@@) القوم فتحيض قبل أن تطوف بالبيت طواف الزيارة فليس لأصحابها أن ينفروا حتى يستأمروها والرجل يتبع الجنازة فيصلي عليها فليس له 
ms122	 أن يرجع حتى يستأمر أهلها(@)(@@)(@@)(@@) | 1673 - (@)(@@) أبو هريرة اثنان فما فوقهما جماعة(@)(@@)(@@)(@@) | 1674 - (@)(@@) أنس(@)(@@) اثنان لا ينظر الله إليهما يوم القيامة قاطع رحم وجار السوء(@)(@@)(@@)(@@) | 1675 - (@)(@@) عمران بن حصين(@)(@@) اثنان لا يعذبان في قبورهم من مات يوم الجمعة ومن مات في رمضان(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 1676 - (@)(@@) جبير بن مطعم(@)(@@) أيام التشريق كلها ذبح(@)(@@)(@@)(@@) | 1677 - (@)(@@) نبيشة الهذلي(@)(@@) أيام التشريق أيام أكل وشرب وذكر الله عز وجل(@)(@@)(@@)(@@) | 1678 - (@)(@@) أنس بن مالك(@)(@@) أيام التشريق أيام أكل وشرب وقرام الحجاب(@)(@@)(@@)(@@) | 1679 - (@)(@@) أبو هريرة(@)(@@) أيام التشريق أيام أكل وشرب وبعال(@)(@@)(@@)(@@) | 1680 - (@)(@@) أبو هريرة(@)(@@) إمام القوم ومؤذنهم أميرهم في السفر أقطفهم داية والخافض والخادم هو أعظمهم أجرا الخافض الذي يداوي الجرحى(@)(@@)(@@)(@@) | 1681 - (@)(@@) أنس بن مالك(@)(@@) إمام القوم وافدهم إلى الله فليقدموا أفضلم وأقرأهم فإن قدموه فلا يحل له أن يأبى ولا يخص نفسه بشيء من الدعاء دونهم(@)(@@)(@@)(@@) | 1682 - (@)(@@) علي وجابر(@)(@@) إستتمام المعروف أفضل من إبتدائه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1683 - (@)(@@) ابن عباس(@)(@@) إسم الله الأعظم الذي إذا دعي به أجاب قل اللهم مالك الملك إلى قوله وترزق من تشاء بغير حساب(@)(@@)(@@)(@@) | 1684 - (@)(@@) أسماء بنت يزيد(@)(@@) إسم الله الأعظم في هاتين الآيتين والهكم إله واحد لا إله إلا هو العزيز الحكيم وفاتحة سورة آل عمران آلم الله لا إله إلا هو الحي القيوم(@)(@@)(@@)(@@) | 1686 - (@)(@@) ابن عباس(@)(@@) إسم الله الأعظم في ست آيات من آخر سورة الحشر(@)(@@)(@@)(@@) | 1687 - (@)(@@) عقبة بن عامر(@)(@@) أما بعد فإن أصدق الحديث كتاب الله(@)(@@) PageV00P000(@)(@@) وأحسن القصص هو القرآن(@)(@@)(@@)(@@) | 1688 - (@)(@@) عبادة بن الصامت(@)(@@) أم القرآن عوض عن غيرها وليس غيرها عوضا منها(@)(@@)(@@)(@@) | 1689 - (@)(@@) بريدة الأسلمي(@)(@@) أم القرى مكة وأم خراسان مرو(@)(@@)(@@)(@@) | 1690 - (@)(@@) ابن عباس(@)(@@) أم الولد حرة وإن كان سقطا(@)(@@)(@@)(@@) | 1691 - (@)(@@) ابن مسعود(@)(@@) انتهاء الإيمان إلى الورع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1692 - (@)(@@) أنس بن مالك(@)(@@) آل محمد كل تقي(@)(@@)(@@)(@@) | 1693 - (@)(@@) ابن عمر(@)(@@) آل فارس من ولد إسحق بن إبراهيم صلى الله عليهما(@)(@@)(@@)(@@) | 1694 - (@)(@@) أنس بن مالك(@)(@@) أرواح المؤمنين إلى الحابية وأرواح الكافرين إلى واد بحضرموت يقال له برهوت ترد عليها هام الكفار في ليلة إلهام 
ms123	 الأرواح(@)(@@)(@@)(@@) | 1695 - (@)(@@) أنس بن مالك(@)(@@) آجال البهائم كلها وخشاش الأرض والدواب كلها في التسبيح فإذا انقضى تسبيحها قبض الله أرواحها وليس إلى ملك الموت في ذلك شيء(@)(@@)(@@)(@@) | 1696 - (@)(@@) ابن مسعود(@)(@@) آكل الربا وموكله وشاهده وكاتبه إذا علموا والواشمة والمستوشمة للحسن ملعونون على لسان محمد صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1697 - (@)(@@) جابر(@)(@@) أصل نبات القمح من عرق آدم كلما قطر قطرة نبتت القمح(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1698 - (@)(@@) أنس بن مالك(@)(@@) أصل كل داء من البردة(@)(@@)(@@)(@@) | 1699(@)(@@) أبو هريرة أكل كل ذي ناب من السباع حرام(@)(@@)(@@)(@@) | 1700 - (@)(@@) علي أكل الطين والأسنان وقرض اللحية من الوسواس(@)(@@)(@@)(@@) | 1701 - (@)(@@) أنس(@)(@@) أكل الطين على كل مسلم حرام(@)(@@)(@@)(@@) | 1702 - (@)(@@) جابر(@)(@@) أكل الطين يورث النفاق(@)(@@)(@@)(@@) | 1703 - (@)(@@) أبو هريرة(@)(@@) أكل التمر أمان من القولنج(@)(@@)(@@)(@@) | 1704 - (@)(@@) أنس(@)(@@) أكل السفرجل يذهب بطخاء القلب الطخاء الثقل والظلمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1705 - (@)(@@) أبو أمامة(@)(@@) أكل السمك يذهب بالجسد(@)(@@)(@@)(@@) | 1706 - (@)(@@) عائشة(@)(@@) أسرع الصلوات فوتا المغرب(@)(@@) فصل(@)(@@)(@@)(@@) | 1707 - (@)(@@) أبو أمامة(@)(@@) أقسم ربكم عز وجل ليعذبن آكل الطين كعذاب شارب الخمر(@)(@@)(@@)(@@) | 1708 - (@)(@@) عائشة أذن جبريل فظنت الملائكة أنه يصلي بهم فقدمني فصليت بالملائكة(@)(@@)(@@)(@@) | 1709 - (@)(@@) عقبة بن عامر(@)(@@) أسلم الناس وآمن عمرو بن العاص(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1710 - (@)(@@) أبو الدرداء(@)(@@) أفلح من كان سكوته تفكرا ونظره تعبرا أفلح من وجد في صحيفته استغفارا كثيرا(@)(@@)(@@)(@@) | 1711 - (@)(@@) أبو هريرة(@)(@@) ألح رجل بيا أرحم الراحمين فنودي أن قد أسمعت فما حاجتك(@)(@@)(@@)(@@) | 1712 - (@)(@@) ابن عمر(@)(@@) أتى الشيطان العراق فقضى حاجته فيها ثم دخل الشام فطردوه حتى بلغ بصرا ثم دخل مصر فباض فيها وفرخ وبسط عبقرية(@)(@@)(@@)(@@) | 1713 - (@)(@@) أبو هريرة(@)(@@) أما يخشى الذي يرفع رأسه قبل الإمام أن يحول الله رأسه رأس حمار(@)(@@)(@@)(@@) | 1714 - (@)(@@) علي(@)(@@) أبى الله عز وجل أن يرزق عبده المؤمن إلا من حيث لا يعلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1715 - (@)(@@) أنس(@)(@@) أبى الله عز وجل أن يجعل للبلاء سلطانا على بدن عبده المؤمن(@)(@@)(@@)(@@) | 1716 - (@)(@@) أبو هريرة(@)(@@) آتخذ الله إبراهيم خليلا وموسى نجيا واتخذني حبيبا ثم قال وعزتي لأوترن حبيبي على خليلي ونجيي(@)(@@)(@@)(@@) | 717 - (@)(@@) أبو هريرة(@)(@@) أتحبون أن تجتهدوا في الدعاءقولوا اللهم أعنا على 
ms124	 ذكرك وشكرك وحسن عبادتك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1718 - (@)(@@) أنس بن مالك(@)(@@) آتي يوم القيامة باب الجنة فأستفتح فيقول الخازن من أنت فأقول محمد فيقول بك أمرت أن لا أفتح لأحد قبلك(@)(@@)(@@)(@@) | 1719 - (@)(@@) معاذ بن جبل(@)(@@) الذي يراك حين تقوم وتقلبك في الساجدين في أصلاب الأباء من الرسل منهم آدم ومنهم نوح ومنهم إبراهيم وإسماعيل عليهم السلام(@)(@@)(@@)(@@) | 1720 - (@)(@@) أبو هريرة(@)(@@) استودعك الله الذي لا تضيع ودائعه(@)(@@)(@@)(@@) | 1721 - (@)(@@) ابن عمر(@)(@@) أستودع الله دينك وأمانتك وخواتيم عملك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1722 - (@)(@@) معاوية(@)(@@) أرجو للمنافق ما دام يستحي(@)(@@)(@@)(@@) | 1723 - (@)(@@) أبو هريرة(@)(@@) أيس عدو الله أن يعبد فرضي بالوسوسة(@)(@@)(@@)(@@) | 1724 - (@)(@@) ابن عباس(@)(@@) أو أثاره من علم الخط(@)(@@)(@@)(@@) | 1725 - (@)(@@) المهلب بن أبي صفرة(@)(@@) أطولكن طاقة أعظمكن أجرا وهو يطرد الشيطان ويذهب بحديث النفس(@)(@@) فصل(@)(@@)(@@)(@@) | 1726 - (@)(@@) أبو هريرة(@)(@@) اليك إنتهت الأماني يا صاحب العافية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1717 - (@)(@@) إبن مسعود(@)(@@) إليك ربي حببني وفي نفسي لك ربي ذللني وفي أعين الناس عظمني ومن سيء الأخلاق جنبني(@)(@@)(@@)(@@) | 1728 - (@)(@@) الأغر المزني(@)(@@) إنه ليغان على قلبي فأستغفر الله عز وجل في اليوم مائة مرة يعني يتغشى القلب ما يلبسه(@)(@@)(@@)(@@) | 1729 - (@)(@@) أبو سعيد(@)(@@) اهتز عرش الرحمن لموت سعد بن معاذ زاد أبو سعيد فرحا به(@)(@@)(@@)(@@) | 1730 - (@)(@@) ابن عباس(@)(@@) اشتد غضب الله على من زعم أنه ملك الأملاك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1731 - (@)(@@) علي(@)(@@) اشتدي أزمة تنفرجي الأزمة الجدبة(@)(@@)(@@)(@@) | 1733 - (@)(@@) البراء بن عازب(@)(@@) أي إخواني لمثل هذا فأعدوا يعني للقبر(@)(@@)(@@)(@@) | 1733 - (@)(@@) جابر(@)(@@) ألا رجل يحملني إلى قومه فإن قريشا قد منعوني أن أبلغ كلام الله عز وجل(@)(@@)(@@)(@@) | 1734 - (@)(@@) عبد الله بن ربيعة(@)(@@) إلى ما يجلد أحدكم امرأته ولعله يضاجعها من آخر يومه(@)(@@)(@@)(@@) | 1735 - (@)(@@) رويفع بن ثابت(@)(@@) أخبرك أنه من استنجى بعظم أو رجيع أنه بريء من محمد ومما أنزل على أمة محمد صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1736 - (@)(@@) ابن عباس(@)(@@) ابن آدم أو لك نطفة وآخرك جيفة فهو بين ذلك لا يملك ضرا ولا نفعا فأدخل بطنك حلالا وأبعد جوارحك عن المعاصي تسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1737 - (@)(@@) أبو أمامة(@)(@@) أيها الناس أذكروا الموت وهول المطلع وما تقدمون عليه من 
ms125	 أعمالكم فإنما أنتم عابري سبيل إلى دار خلود لا يخرب قصورها ولا يبلى سرورها ولا يموت سكانها بنو ثلث وثلاثين مردا مكحلين(@)(@@)(@@)(@@) | 1738 - (@)(@@) أبو هريرة(@)(@@) ابن السبيل أول شارب يعني من زمزم(@)(@@)(@@)(@@) | 1739 - (@)(@@) أبو هريرة(@)(@@) الياس والخضر أخوان أبوهما من الفرس وأمهما من الروم(@)(@@) فصل آخر مما أمر به النبي أمته وأوصاهم(@)(@@)(@@)(@@) | 1740 - (@)(@@) سمرة بن جندب(@)(@@) أوصيكم بتقوى الله والقرآن فإنه نور الظلمة وهدى النهار فاقبلوه على ما كان من فقر وفاقه فإن عرضك(@)(@@) PageV00P000(@)(@@) بلاء فاجعل مالك دون دمك فإن جاوزك البلاء فاجعل مالك ودمك دون دينك فإن المسلوب من سلب دينه وإن المخروب من خرب دينه إنه لا فاقة بعد الجنة ولا غنى بعد النار فإن النار لا يستغني فقيرها ولا يفك أسيرها(@)(@@)(@@)(@@) | 1741 - (@)(@@) ابن عمر(@)(@@) أوصيكم بطلبة العلم احفظوهم وارفعوهم فإنهم يوم القيامة يحشرون مع الأخيار ويثابون ثواب الأخيار(@)(@@)(@@)(@@) | 1742 - (@)(@@) جابر أوصيكم بالنساء خيرا فإنكم أخذتموهن بأمانة الله واستحللتم فروجهن بكلمة الله عز وجل(@)(@@)(@@)(@@) | 1743 - (@)(@@) علي(@)(@@) أوصيكم بذكر الموت فإنه يسلبك عن الدنيا(@)(@@)(@@)(@@) | 1744 - (@)(@@) معاذ(@)(@@) أوصيكم بتقوى الله وصدق الحديث ووفاء بعهد وبذل السلام(@)(@@)(@@)(@@) | 1745 - (@)(@@) علي(@)(@@) أوصيكم معاشر المسلمين بتقوى الله الذي فاز به الفائزون وخسر بتركه الخاسرون فإنه من يتق الله يجعل له مخرجا ويرزقه من حيث لا يحتسب وأوصيكم عباد الله بالعروة الوثقى التي لا أنفصام لها وإياكم وهذه الأهواء الضالة البعيدة من الجنة القريبة من النار(@)(@@)(@@)(@@) | 1746 - (@)(@@) أبو سعيد(@)(@@) أوصيكم بهذين خيرا يعني علي والعباس لا يكف عنهما أحد ولا يحفظهما إلا أعطاه الله نورا يرد به علي يوم القيامة(@)(@@)(@@)(@@) | 1747 - (@)(@@) عبد الرحمن بن عوف(@)(@@) أوصيكم بالمهاجرين الأولين(@)(@@) PageV00P000(@)(@@) وبأبنائهم من بعدهم وبأبنائهم من بعدهم إلا تفعلوا لا يقبل الله عز وجل منكم صرفا ولا عدلا(@)(@@)(@@)(@@) | 1748 - (@)(@@) أبو موسى(@)(@@) أوصيكم بتقوى الله اغزوا في سبيل الله ولا تغلو ولا تغدروا ولا تمثلوا ولا تقتلوا وليدا ولا عسيفا(@)(@@)(@@)(@@) | 1749 - (@)(@@) سعيد بن زيد(@)(@@) أوصيك أن تستحي من الله عز وجل كما تستحي رجلا صالحا من قومك(@)(@@)(@@)(@@) | 1750 - (@)(@@) أبو 
ms126	 سلامة(@)(@@) أوصي إمرأ بأمه ثلاثا أوصي إمرأ بأبيه مرتين أوصي إمرأ بمولاه الذي يليه وإن كان عليه منه أذى يؤذيه(@)(@@)(@@)(@@) | 1751 - (@)(@@) عمار بن ياسر(@)(@@) أوصي من آمن بي وصدقني بموالاة علي(@)(@@) PageV00P000(@)(@@) ابن أبي طالب فمن تولاه فقد تولاني ومن تولاني فقد تولى الله عز وجل ومن أحبه فقد أحبني ومن أحبني فقد أحب الله تعالى ومن أبغضه فقد أبغضني ومن أبغضني فقد أبغض الله عز وجل(@)(@@)(@@)(@@) | 1752 - (@)(@@) ابن عباس(@)(@@) أبغض أن أوصي المجنون أو الشاعر(@)(@@) فصل(@)(@@)(@@)(@@) | 1753 - (@)(@@) أبو بكره(@)(@@) أغد عالما أو متعلما أو مستمعا أو محبا ولا تكن الخامسة فتهلك(@)(@@)(@@)(@@) | 1154 - (@)(@@) أبو الدرداء(@)(@@) أخبر تقله ثق بالناس رويدا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1755 - (@)(@@) أنس بن مالك(@)(@@) أذكر الموت في صلاتك فإن الرجل إذا ذكر الموت في صلاته لحري أن يحسن صلاته وصل صلاة رجل لا يظن أن يصلي صلاة غيرها وإياك وكل امرىء يعتذر منه(@)(@@)(@@)(@@) | 1756 - (@)(@@) عبد الله بن عمرو(@)(@@) أطلب العافية لغيرك ترزقها لنفسك(@)(@@)(@@)(@@) | 1757 - (@)(@@) أنس وعائشة(@)(@@) أنصر أخاك ظالما أو مظلوما إن كان ظالما فخذ على يديه وإن كان مظلوما فخذ له بحقه(@)(@@)(@@)(@@) | 1758 - (@)(@@) سهل بن سعد(@)(@@) أزهد في الدنيا يحبك الله وأزهد فيما في(@)(@@) PageV00P000(@)(@@) أيدي الناس يحبك الناس(@)(@@)(@@)(@@) | 1759 - (@)(@@) عمر(@)(@@) أنفق بلال ولا تخش من ذي العرش إقلالا(@)(@@)(@@)(@@) | 1760 - (@)(@@) ابن عباس(@)(@@) إسمح يسمح لك(@)(@@)(@@)(@@) | 1761 - (@)(@@) علي(@)(@@) إقرأ القرآن على كل حال إلا وأنت جنب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1762 - (@)(@@) ابن مسعود(@)(@@) إقبل الحق ممن أتاك به من صغير أو كبير وإن كان بغيضا أو بعيدا وأردد الباطل على من جاء به من صغير أو كبير وإن كان حبيبا قريبا(@)(@@)(@@)(@@) | 1763 - (@)(@@) معاوية بن جندة(@)(@@) احفظ عورتك إلا من زوجتك أو ما ملكت يمينك وإن استطعت أن لا يرى عورتك أحد فلا ترينها فالله أحق أن يستحى منه من الناس(@)(@@)(@@)(@@) | 1764 - (@)(@@) عبد الله بن عمرو(@)(@@) إقرأ القرآن في سبع لا تزد(@)(@@)(@@)(@@) | 1765 - (@)(@@) أبو سعيد(@)(@@) إقرأ القرآن ما نهاك فإذا لم ينهك فلست تقرأه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1766 - (@)(@@) أبو حميد(@)(@@) إبدأ المودة لمن واددت فإنها هي أثبت(@)(@@)(@@)(@@) | 1767 - (@)(@@) أنس(@)(@@) اطلع 
ms127	 في القبور واعتبر بالنشور(@)(@@)(@@)(@@) | 1768 - (@)(@@) أبو هريرة(@)(@@) أد الأمانة إلى من ائتمنك ولا تخن من خانك(@)(@@)(@@)(@@) | 1769 - (@)(@@) بلال(@)(@@) إلق الله فقيرا ولا تلقه غنيا إذا رزقت فلا تخبىء(@)(@@) PageV00P000(@)(@@) وإذا سئلت فلا تمنع هو ذاك وإلا فالنار(@)(@@)(@@)(@@) | 1770 - (@)(@@) أبو الطفيل(@)(@@) الزم هذا البيت ولولم تصب شيئا تأكله إلا المسك يعني مكة(@)(@@)(@@)(@@) | 1771 - (@)(@@) علي بن أبي طالب(@)(@@) أحب حبيبك هونا ما عسى أن يكون بغيضك يوما ما وأبغض بغيضك هونا ما عسى أن يكون حبيبك يوما ما(@)(@@)(@@)(@@) | 1772 - (@)(@@) معاذ بن جبل(@)(@@) أخلص دينك يكفيك القليل من العمل(@)(@@)(@@)(@@) | 1773 - (@)(@@) علي(@)(@@) أقرض الملهوف إذا احتاج إليك يكتب الله عز وجل لك أجر سبعين نبيا وسبعين شهيدا ولك المؤمنين يستغفر لك(@)(@@)(@@)(@@) | 1774 - (@)(@@) ابن عمر(@)(@@) أقل من الذين تكن حرا وأقل من الذنوب(@)(@@) PageV00P000(@)(@@) يهن عليك الموت وأنظر في أي نصاب تضع ولدك فإن العرق دساس(@)(@@) فصل(@)(@@)(@@)(@@) | 1775 - (@)(@@) أبو هريرة(@)(@@) أبا هر أحسن جوار من جاورك تكن مسلما وأحسن مصاحبة من صاحبك تكن مؤمنا(@)(@@)(@@)(@@) | 1776 - (@)(@@) أبو هريرة(@)(@@) أبا هر إن استطعت أن لا يكون لفاجر عندك يدا فافعل(@)(@@)(@@)(@@) | 1777 - (@)(@@) أبو هريرة(@)(@@) أبا هر إلق الله بثلاثة وثلاثين زينة ولا تلقه بدرهم ربا(@)(@@)(@@)(@@) | 1778 - (@)(@@) أبو هريرة(@)(@@) أبا هر إن لأدنى أهل الجنة سبعون دارا في كل دار سبعون قصر في كل قصر سبعون بيتا في كل بيت سبعون سريرا كل سرير عرضه الفرسخ في طول فرسخ حور جالسة طابت لهم الجنة وطابوا لها(@)(@@) PageV00P000(@)(@@) فصل(@)(@@) في فضائل أبي بكر وعمر وعثمان وعلي وغيرهم رضوان الله عليهم(@)(@@)(@@)(@@) | 1779 - (@)(@@) حميد بن عبد يغوث(@)(@@) أبو بكر أخي وأنا أخوه وأبو بكر أفضل هذه الأمة ولا نفعني مال أحد ما نفعني مال أبي بكر(@)(@@)(@@)(@@) | 1780 - (@)(@@) عائشة(@)(@@) أبو بكر مني وأنا منه وأبو بكر أخي في الدنيا والآخرة(@)(@@)(@@)(@@) | 1781 - (@)(@@) علي(@)(@@) أبو بكر وعمر سيدا كهول أهل الجنة من الأولين والآخرين إلا النبيين والمرسلين يا علي لا تخبرهما(@)(@@)(@@)(@@) | 1782 - (@)(@@) أنس بن مالك(@)(@@) أبو بكر وزيري يقوم مقامي وعمر ينطق بلساني وأنا من عثمان وعثمان مني 
ms128	 وعلي ابن عمي وأخي وحامل رايتي كأني بك يا أبا بكر تشفع لأمتي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1783 - (@)(@@) أبو هريرة(@)(@@) أبو بكر وعمر خير أهل السموات وخير أهل الأرض وخير من بقي إلى يوم القيامة(@)(@@)(@@)(@@) | 1784 - (@)(@@) عائشة(@)(@@) أبو بكر عتيق في السماء وعتيق في الأرض(@)(@@)(@@)(@@) | 1785 - (@)(@@) ابن عباس(@)(@@) أبو بكر عماد الدين وعمر غلق الفتنة وعثمان محنة المنافقين وعلي مني وأنا من علي حيث يكون أكون وحيث أكون يكون(@)(@@)(@@)(@@) | 1786 - (@)(@@) ابن عمر(@)(@@) أبو بكر خير أمتي وأعدلها وعمر أعزها وأعدلها وعثمان بن عفان أحياها وأكرمها وعلي أبهاها وأوسمها يقال رجل أوسيم بين الوسامة يعني صبيح(@)(@@)(@@)(@@) | 1787 - (@)(@@) شداد بن أوس(@)(@@) أبو بكر أرق أمتي وأرحمها وعمر بن الخطاب أخير أمتي وأعدلها وعثمان بن عفان أخي وأكرمها وعلي بن أبي طالب ألب أمتي وأسماها وعبد الله بن مسعود أبر أمتي وأمنها وأبو ذر أزهد أمتي وأصدقها وأبو الدرداء أعبد أمتي وأتقاها ومعاوية بن أبي سفيان أحلم أمتي وأجودها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1788 - (@)(@@) ابن مسعود(@)(@@) أبو بكر الصديق تاج الإسلام وعمر بن الخطاب حلة الإسلام وعثمان بن عفان إكليل الإسلام وعلي بن أبي طالب طيب الإسلام فمن أحب أن يتتوج ويتحلى ويتكلل ويتطيب فليحب أئمة الهدى ومصابيح الدجى فإن مثل حبهم كمثل الغيث حيث وقع سقط نفع(@)(@@)(@@)(@@) | 1789 - (@)(@@) جبيش بن خالد(@)(@@) أبو بكر وعمر وعثمان وعائشة آل الله وعلي والحسن والحسين وفاطمة آلي وسيجمع الله يوم القيامة آلي وآله في روضة من رياض الجنة(@)(@@) ذكر الأدعية التي دعا به النبي عليه السلام في أوقات شتى(@)(@@)(@@)(@@) | 1790 - (@)(@@) أم سلمة(@)(@@) اللهم أنت الأول فليس قبلك شيء وأنت الآخر فليس بعدك شيء أعوذ بك من كل دابة ناصيتها بيدك وأعوذ بك من الإثم والكسل وعذاب النار وفتنة الغنى والفقر وأعوذ بك من المأثم والمغرم(@)(@@)(@@)(@@) | 1791 - (@)(@@) عائشة(@)(@@) اللهم أنت لا إله إلا أنت خلقتني وأنا على عهدك ووعدك ما استطعت أعوذ بك من شر ما صنعت أبوء لك بنعمتك علي وأبوء لك بذنبي فاغفر لي فإنه لا يغفر الذنوب إلا أنت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1792 - (@)(@@) ابن عمر 
ms129	(@)(@@) اللهم أنت خلقت نفسي وأنت توفاها لك مماتها ومحياها اللهم إن توفيتها فاغفر لها وإن أحييتها فاحفظها اللهم إني أسألك العافية اللهم أنت أجل من ذكر وأحق من عبد وأنصر من ابتغى وأرأف من ملك وأجود من سئل وأوسع من أعطى أنت الملك لا شريك لك وأنت الفرد لا تهلك وكل شيء هالك إلا وجهك لا تطاع إلا بإذنك ولم تعصى إلا بعلمك تطاع فتشكر وتعصى فتغفر أقرب شهيد وأدنى حفيظ(@)(@@)(@@)(@@) | 1793 - (@)(@@) أنس بن مالك(@)(@@) اللهم أنت ثقتي وأنت رجاي اللهم إكفني ما همني وما لا أهتم به وما أنت أعلم به مني اللهم زودني التقوى واغفر لي ذنبي ووجهني للخير أينما توجهت(@)(@@)(@@)(@@) | 1794 - (@)(@@) أبو هريرة(@)(@@) اللهم أنت ربنا لا رب لنا غيرك تميتنا وتحيينا وإليك معادنا(@)(@@)(@@)(@@) | 1795 - (@)(@@) أنس بن مالك(@)(@@) اللهم أنت عضدي ونصيري وبك أقاتل(@)(@@)(@@)(@@) | 1796 - (@)(@@) ابن مسعود(@)(@@) اللهم أنت العدل في قضائك(@)(@@)(@@)(@@) | 1797 - (@)(@@) صهيب(@)(@@) اللهم أنت لست باله استحدثناه ولا برب إبتدعناه ولا كان لنا قبلك من إله نلجأ إليه ونذرك ولا أعانك على خلقنا أحد فنشركه فيك تباركت وتعاليت(@)(@@)(@@)(@@) | 1798 - (@)(@@) جابر(@)(@@) اللهم أمرت بالدعاء وتكفلت بالإجابة لبيك(@)(@@) PageV00P000(@)(@@) اللهم لبيك لا شريك لك لبيك إن الحمد والنعمة لك والملك لا شريك لك أشهد أنك ربي واحد صمد لم يلد ولم يولد ولم يكن له كفوا أحد وأشهد أن وعدك حق ولقاؤك حق والجنة حق والنار حق وأن الساعة آتية لا ريب فيها وأن الله يبعث من في القبور(@)(@@) فصل(@)(@@)(@@)(@@) | 1799 - (@)(@@) بريدة الأسلمي(@)(@@) اللهم إنك تعلم سري وعلانيتي فاقبل معذرتي وتعلم حاجتي فاعطني سؤلي وتعلم ما عندي فاغفر لي ذنوبي أسألك إيمانا يباشر به قلبي ويقينا صادقا حتى أعلم أنه لن يصيبني إلا ما كتب لي ورضني بقضائك(@)(@@)(@@)(@@) | 1800 - (@)(@@) جابر بن عبد الله(@)(@@) اللهم إنك خلاق عظيم إنك سميع عليم إنك غفور رحيم إنك رب العرش العظيم إنك البر الجواد الكريم إغفر لي وارحمني وعافني وارزقني واجبرني وارفعني واهدني ولا تضلني وأدخلني الجنة برحمتك يا أرحم الراحمين(@)(@@)(@@)(@@) | 1801 
ms130	 - (@)(@@) ابن عباس(@)(@@) اللهم إنك إن غفرت لي فلا معذب لي وإن هديتني فلا مضل لي وإن رزقتني فلا محرم لي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1802 - (@)(@@) ابن عباس(@)(@@) اللهم إنك رب عظيم لا يمنعك شيء مما خلقت وأنت ترى ولا ترى وأنت بالمنظر الأعلى وإن لك الآخرة والأولى وإن لك المحيا والممات وإن إليك المنتهى والرجعى نعوذ بك أن نزل ونخزي(@)(@@)(@@)(@@) | 1803 - (@)(@@) ابن عباس(@)(@@) اللهم تسمع كلامي وترى مكاني وتعلم سري وعلانيتي لا يحفى عليك شيء من أمري أنا اليأس الفقير المستغيث المستجير الوجل المشفق المغرور المعترف بذنبه أسألك مسألة المسكين وأبتهل إليك ابتهال المذنب الذليل وأدعوك دعاء الخائف الضرير من خضعت لك رقبته وفاضت لك عبرته وذلل لك جسده ورغم لك أنفه(@)(@@) فصل(@)(@@) علي بن أبي طالب(@)(@@) اللهم لك الحمد حمدا دائما خالدا مع خلودك ولك الحمد حمدا دائما لا منتهى له دون مشيئتك ولك الحمد حمدا لا جزاء لقائلها إلا رضاك ولك الحمد حمدا وعند كل طرفة عين وتنفس نفس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1805 - (@)(@@) الحرث بن الحرث الأزدي(@)(@@) اللهم لك الحمد أطعمت وأسقيت وأشبعت وأرويت فلك الحمد غير مكفور ولا مودع ولا مستغنى عنه(@)(@@)(@@)(@@) | 1806 - (@)(@@) علي(@)(@@) اللهم لك الحمد كالذي نقول وخير مما نقول اللهم لك صلاتي ونسكي ومحياي ومماتي وإليك مآبي اللهم إني أعوذ بك من عذاب القبر ووسوسة الصدور وشتات الأمر(@)(@@)(@@)(@@) | 107 - (@)(@@) ابن مسعود(@)(@@) اللهم لك الحمد وإليك المشتكى وبك المستغاث وأنت المستعان ولا حول ولا قوة إلا بالله(@)(@@)(@@)(@@) | 1808 - (@)(@@) أبو هريرة(@)(@@) اللهم لك الحمد حمدا يكافئ مزيدك ويوافي نعمك علي وعلى جميع خلقك(@)(@@)(@@)(@@) | 1809 - (@)(@@) فاطمة بنت قيس(@)(@@) اللهم لك الحمد شكرا ولك المن فضلا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1810 - (@)(@@) ابن عباس(@)(@@) اللهم لك الحمد نور السموات والأرض ولك الحمد أنت قيام السموات والأرض ولك الحمد أنت رب السموات والأرض ومن فيهن أنت حق ووعدك حق ولقاؤك حق والجنة حق والنار حق والساعة حق(@)(@@)(@@)(@@) | 1811 - (@)(@@) علي بن أبي طالب(@)(@@) اللهم لك سجدت وبك آمنت ولك أسلمت أنت ربي سجد وجهي للذي شق سمعه وبصره تبارك الله أحسن الخالقين 
ms131	(@)(@@)(@@)(@@) | 1812 - (@)(@@) ابن عباس(@)(@@) اللهم لك أسلمت وبك آمنت وعليك(@)(@@) PageV00P000(@)(@@) توكلت وإليك أنبت وبك خاصمت اللهم أعوذ بعزتك لا إله إلا أنت أن تضلني أنت الحي الذي لا يموت والجن والإنسان يموتون(@)(@@)(@@)(@@) | 1813 - (@)(@@) أنس(@)(@@) اللهم لك الشرف على كل شرف ولك الحمد على كل حال(@)(@@) فصل(@)(@@)(@@)(@@) | 1814 - (@)(@@) زيد بن ثابت(@)(@@) اللهم لبيك وسعديك والخير في يديك ومنك وبك وإليك اللهم ما قلت من قول أو نذرت من نذر أو حلفت من حلف فمشيئتك بين يديه ما شئت كان وما لم تشأ لم يكن ولا حول ولا قوة إلا بالله العلي العظيم والله على كل شيء قدير(@)(@@)(@@)(@@) | 1815 - (@)(@@) أبو بكر(@)(@@) اللهم رحمتك أرجوا فلا تكلني إلى نفسي طرفة(@)(@@) PageV00P000(@)(@@) عين وأصلح لي شأني كله لا إله إلا أنت(@)(@@)(@@)(@@) | 1816 - (@)(@@) أنس بن مالك(@)(@@) اللهم بقدرتك خلقتني وبقدرتك هديتني وبعلمك فيهما ننقلب إليك فاغفر لنا ذنوبنا(@)(@@)(@@)(@@) | 1817 - (@)(@@) عمار بن ياسر(@)(@@) اللهم بعلمك الغيب وقدرتك على ي الخلق أحيني ما كانت الحياة خيرا لي وتوفني ما كانت الوفاة خيرا لي(@)(@@)(@@)(@@) | 1818 - (@)(@@) حذيفة(@)(@@) اللهم باسمك أحيا وأموت الحمد لله الذي أحيانا بعد ما أماتنا وإليه النشور(@)(@@)(@@)(@@) | 1819 - (@)(@@) ابن عباس(@)(@@) اللهم بك أحول وبك أصول وبك أقاتل(@)(@@)(@@)(@@) | 1820 - (@)(@@) أبو هريرة(@)(@@) اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك المصير(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 1821 - (@)(@@) أبو هريرة(@)(@@) اللهم رب السموات السبع ورب العرش العظيم ربنا ورب كل شيء منزل التوراة والإنجيل والقرآن العظيم أنت الأول فليس قبلك شيء وأنت الأخر فليس بعدك شيء وأنت الظاهر فليس فوقك شيء وأنت الباطن فليس دونك شيء إقض عنا الدين وأغننا من الفقر(@)(@@)(@@)(@@) | 1822 - (@)(@@) جد أبي مروان الأسلمي(@)(@@) اللهم رب السموات السبع(@)(@@) PageV00P000(@)(@@) وما أظللن ورب الأرضين السبع وما أقللن ورب الشياطين وما أضللن إنا نسألك خير هذه القرية وخير ما فيها ونعوذ بك من شر هذه القرية وشر ما فيها(@)(@@)(@@)(@@) | 1823 - (@)(@@) عائشة(@)(@@) اللهم رب جبريل وميكائيل وإسرافيل آجرني من النار وعذاب النار إهدني لما اختلف فيه من الحق إنك تهدي إلى صراط مستقيم(@)(@@)(@@)(@@) | 1824 
ms132	 - (@)(@@) عائشة(@)(@@) اللهم رب محمد النبي الأمي أذهب غيظ قلبي وآجرني من مضلات الفتن(@)(@@)(@@)(@@) | 1825 - (@)(@@) ابن عمر(@)(@@) اللهم رب الأرواح الفانية والأجساد البالية أسألك بطاعة الأرواح الراجعة إلى الأجساد البالية بالطاعة وبطاعة(@)(@@) PageV00P000(@)(@@) الأجساد الممتلئة بعروقها بالكلمة التامة وأخذك بالحق منهم والخلائق بين يديك ينتظرون فصل قضائك ويرجون رحمتك ويخافون عذابك أن تجعل النور في بصري واليقين في قلبي وذكرك بالليل والنهار على لساني وعملا صالحا فارزقني(@)(@@)(@@)(@@) | 1826 - (@)(@@) أنس بن مالك(@)(@@) اللهم رب الناس مذهب الباس واشف وأنت الشافي لا شافي إلا أنت اشفه شفاء لا يغادره سقما(@)(@@)(@@)(@@) | 1827 - (@)(@@) أبو أمامة(@)(@@) اللهم رب هذه الدعوة التامة الصادقة الحق المستجابة المستجاب لها كلمة الحق وكلمة التقوى أحينا عليها محيانا ومماتنا(@)(@@)(@@)(@@) | 1828 - (@)(@@) عبد الله بن أبي أوفى(@)(@@) اللهم ربنا لك الحمد حمدا كثيرا طيبا مباركا فيه(@)(@@)(@@)(@@) | 1829 - (@)(@@) أنس(@)(@@) اللهم ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1830 - (@)(@@) زيد بن أرقم(@)(@@) اللهم ربنا ورب كل شيء أنا شهيد أنك أنت الرب وحدك لا شريك لك وأن محمدا عبدك ورسولك وإن العباد كلهم إخوة اجعلني مخلصا لك وأهلي كل ساعة في الدنيا والآخرة ذا الجلال والإكرام إسمع واستجب الله الأكبر الله الأكبر الله نور السموات والأرض حسبي الله ونعم الوكيل الله اكبر الله اكبر(@)(@@)(@@)(@@) | 1831 - (@)(@@) أبو هريرة(@)(@@) اللهم إني اسألك يا الله يا رحمن يا رحيم يا جار المستجيرين يا مأمن الخائفين يا عماد من لا عماد له يا سند من لا سند له يا ذخر من لا ذخر له يا حرز الضعفاء يا كنز الفقراء يا عظيم الرجاء يا منقذ الهلكى يا منجي الغرقى يا محسن يا مجمل يا منعم يا مفضل يا عزيز يا جبار يا متكبر أنت الذي سجد لك سواد الليل وضوء النهار وشعاع الشمس وحفيف الشجر ودوي الماء ونور القمر يا الله لا شريك لك أسألك بهذه الأسماء أن تصلي على محمد عبدك ورسولك وعلى آل محمد(@)(@@) فصل(@)(@@)(@@)(@@) | 1832 - (@)(@@) علي بن أبي طالب(@)(@@) اللهم إني أسألك إيمانا 
ms133	 دائما وقلبا خاشعا وأسألك يقينا صادقا وأسألك علما وأسألك دينا قيما وأسألك(@)(@@) PageV00P000(@)(@@) العافية من كل بلية وأسألك تمام العافية وأسألك دوام العافية وأسألك الشكر على العافية وأسألك الغنى عن الناس(@)(@@)(@@)(@@) | 1833 - (@)(@@) جابر بن عبد الله(@)(@@) اللهم إني أسألك علما نافعا وأعوذ بك من علم لا ينفع(@)(@@)(@@)(@@) | 1834 - (@)(@@) أم سلمة(@)(@@) اللهم إني أسألك رزقا طيبا وعلما نافعا وعملا متقبلا(@)(@@)(@@)(@@) | 1835 - (@)(@@) أبو أمامة(@)(@@) اللهم إني أسألك نفسا بك مطمئنة تؤمن بلقائك وترضى بقضائك وتقنع بعطائك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1836 - (@)(@@) ابن عباس(@)(@@) اللهم أني أسألك رحمة من عندك تهدي بها قلبي وتجمع بها شملي وتلم بها شعثي وتصلح بها غائبي وترفع بها شاهدي وتزكي بها عملي وتلهمني بها رشدي وترد بها ألفتي وتعصمني بها من كل سوء(@)(@@)(@@)(@@) | 1837 - (@)(@@) عبد الله بن عمرو(@)(@@) اللهم إني أسألك عيشة سوية وميتة تقية ومرادا غير مخزي ولا فضح(@)(@@)(@@)(@@) | 1838 - (@)(@@) ابن عمر(@)(@@) اللهم إني أسألك صحة إيمان وإيمانا في حسن خلق وفلاحا يتبعه نجاحا ورحمة منك وعافية ومغفرة منك ورضوانا(@)(@@)(@@)(@@) | 1839 - (@)(@@) أبو هريرة(@)(@@) اللهم إني أسألك ثواب الشاكرين(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 1839 - (@)(@@) أبو هريرة(@)(@@) اللهم إني أسألك ثواب الشاكرين ونزل المقربين ومرافقة النبيين ويقين الصديقين وإخبات الموقنين وذلة المتقين حتى توفاني على ذلك يا أرحم الراحمين(@)(@@)(@@)(@@) | 1840 - (@)(@@) معاذ بن جبل(@)(@@) اللهم إني أسألك فعل الخيرات وترك المنكرات وحب المساكين وأن تغفر لي وترحمني وإذا أردت فتنة أو بلاء في قوم فتوفني غير مفتون(@)(@@)(@@)(@@) | 1841 - (@)(@@) ابن عباس(@)(@@) اللهم إني أسألك توفيق أهل الهدى وأعمال أهل اليقين ومناصحة أهل التوبة وعزم أهل الصبر وجد أهل الخشية وطلبة أهل الرغبة وتعبد أهل الورع وعرفان أهل العلم حتى أخافك(@)(@@)(@@)(@@) | 1842 - (@)(@@) أبو مالك الأشعري(@)(@@) اللهم إني أسألك خير هذا اليوم فتحه ونصره ونوره وبركته وهداه وأعوذ بك من شر ما فيه وشر ما قبله وشر ما بعده(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1843 - (@)(@@) أم سلمة(@)(@@) اللهم إني أسألك خير المسئلة وخير الدعاء وخير النجاح وخير العمل وخير الثواب وخير الحياة وخير الممات وثبتني وثقل موازيني وأحق إيماني وارفع درجاتي وتقبل صلاتي واغفر خطيئتي 
ms134	 وأسألك الدرجات العلى من الجنة آمين(@)(@@)(@@)(@@) | 1844 - (@)(@@) عائشة(@)(@@) اللهم إني أسألك تعجيل عافيتك وصبرا على بلائك وخروجا من الدنيا إلى رحمتك(@)(@@) فصل(@)(@@)(@@)(@@) | 1845 - (@)(@@) ابن مسعود(@)(@@) اللهم إني أسألك بمعاقد العز من عرشك ومنتهى الرحمة من كتابك وباسمك الأعظم ورضوانك الأكبر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1846 - (@)(@@) جابر بن عبد الله(@)(@@) اللهم إني أسألك بلا إله إلا أنت الحليم وسبحان الله رب العرش الكريم أن تغفر لي(@)(@@)(@@)(@@) | 1847 - (@)(@@) حمزة بن عبد المطلب(@)(@@) اللهم إني أسألك باسمك الأعظم ورضوانك الأكبر(@)(@@)(@@)(@@) | 1848 - (@)(@@) ابن مسعود(@)(@@) اللهم إني أسألك بأسمائك كلها الحميدة الكريمة التي إذا وضعت على شيء ذل لها وإذا طلب بها الحسنات أدركت وإذا ادرىء بها السيئات صرفت(@)(@@)(@@)(@@) | 1849 - (@)(@@) ابن مسعود(@)(@@) اللهم إنس أسألك بنعمتك السابغة علي وبلاؤك الحسن الذي أبليتني به وفضلك العظيم الذي أفضلت علي أن تدخلنيا لجنة بمنك وفضلك ورحمتك(@)(@@) فصل(@)(@@)(@@)(@@) | 1850 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني أسألك الجنة التي ظلها عرشك ونورها وجهك وحشوها رحمتك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1851 - (@)(@@) عائشة اللهم إني أسألك الجنة وما قرب إليها من قول وعمل وأعوذ بك من النار وما قرب إليها من قول وعمل وأسألك أن تجعل كل قضاء تقضيه لي خيرا(@)(@@)(@@)(@@) | 1852 - (@)(@@) عبد الله بن عمرو اللهم إني أسألك الصحة والعفة والأمانة وحسن الخلق والرضا بالقدر(@)(@@)(@@)(@@) | 1853 - (@)(@@) شداد بن أوس اللهم إني أسألك التثبت في الأمر وأسألك عزيمة الرشد وأسألك شكر نعمتك وحسن عبادتك وأسألك قلبا سليما ولسانا صادقا وأستغفرك لما تعلم وأعوذ بك من شر ما تعلم وأسألك من خير ما تعلم(@)(@@)(@@)(@@) | 1854 - (@)(@@) ابن عمر اللهم إني أسألك العفو والعافية في ديني ودنياي وأهلي ومالي اللهم إستر عوراتي وآمن روعاتي واحفظني من بين يدي ومن خلفي وعن يميني وعن شمالي ومن فوقي وأعوذ بك أن أغتال من تحتي يعني أن أخسف من تحتي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1855 - (@)(@@) زيد بن ثابت(@)(@@) اللهم إني أسألك الرضا بالقدر وبرد العيش بعد الموت ولذة النظر إلى وجهك وشوقا إلى لقائك من غير ضراء مضرة ولا فتنة مضلة(@)(@@)(@@)(@@) | 1856 - (@)(@@) ابن مسعود(@)(@@) اللهم إني أسألك الهدى والتقى والعفاف 
ms135	 والغنى(@)(@@) فصل(@)(@@)(@@)(@@) | 1857 - (@)(@@) عائشة(@)(@@) اللهم إني أسألك من الخير كله عاجله وآجله ما علمت منه وما لم أعلم اللهم إني أسألك من الخير ما سألك عبدك ونبيك وأعوذ بك من شر ما عاذ به عبدك ونبيك(@)(@@)(@@)(@@) | 1858 - (@)(@@) بريدة الأسلمي(@)(@@) اللهم إني أسألك خير هذا السوق وخير ما فيها وأعوذ بك من شر هذا السوق وشر ما فيها اللهم إني أعوذ بك أن أصيب فيها يمينا فاجرة أو صفقة خاسرة(@)(@@)(@@)(@@) | 1859 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني أسألك من فجأة الخير وأعوذ(@)(@@) PageV00P000(@)(@@) بك من فجأة الشر فإن العبد لا يدري ما يفجأه(@)(@@)(@@)(@@) | 1860 - (@)(@@) عبد الله بن أبي أوفى(@)(@@) اللهم إني أسألك موجبات رحمتك وعزائم مغفرتك والغنيمة من كل بر والسلامة من كل إثم وأسألك أن لا تدع لي ذنبا إلا غفرته ولا هما إلا فرجته ولا حاجة هي لك رضا إلا قضيتها(@)(@@)(@@)(@@) | 1861 - (@)(@@) ابن عمر(@)(@@) اللهم إني أسألك في سفري هذا التقى ومن العمل الصالح ما ترضى اللهم هون علينا السفر وأطو لنا الأرض اللهم أنت الصاحب في السفر والخليفة في الأهل اللهم اصحبنا في سفرنا وأخلفنا في أهلنا(@)(@@)(@@)(@@) | 1862 - (@)(@@) زيد بن ثابت(@)(@@) اللهم إني أسألك غنى الأهل والمولى وأعوذ بك أن أدعو على رحم قطعتها(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1863 - (@)(@@) أبو سعيد(@)(@@) اللهم إني أستغفرك لذنبي وأسألك رحمتك اللهم زدني علما ولا تزغ قلبي بعد إذ هديتني وهب لي من لدنك رحمة إنك أنت الوهاب(@)(@@)(@@)(@@) | 1864 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني بك أدفع ما لا أطيق وبك أستعين على ما أريد يا ذا الجلال والإكرام(@)(@@) فصل(@)(@@)(@@)(@@) | 1865 - (@)(@@) شكل بن حميد اللهم إني أعوذ بك من شر سمعي وشر بصري وشر لساني وشر قلبي وشر منيتي يعني ماءه(@)(@@)(@@)(@@) | 1866 - (@)(@@) ابن عمر اللهم إني أعوذ بك من شر الأعميين السيل والحريق(@)(@@)(@@)(@@) | 1867 - (@)(@@) عائشة(@)(@@) اللهم إني أعوذ بك من شر ما قد عملت وأعوذ بك من شر ما لم أعمل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1868 - (@)(@@) ابن مسعود(@)(@@) اللهم إني أعوذ بك من شر هذا اليوم وشر ما بعده وأعوذ بك من الكسل 
ms136	 وسوء الكبر وعذاب القبر وعذاب النار(@)(@@)(@@)(@@) | 1869 - (@)(@@) ابن عباس(@)(@@) اللهم إني أعوذ بك من شر من يمشي على بطنه ومن شر من يمشي على رجلين ومن شر من يمشي على أربع(@)(@@)(@@)(@@) | 1870 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني أعوذ بك من شح نفسي وإسرافها ووساوسها(@)(@@)(@@)(@@) | 1871 - (@)(@@) أبو قتادة(@)(@@) اللهم إني أعوذ بك من بطر الغني ومدخل الفقير يا من وعد فوفى وأوعد فعفا وأغفر لمن ظلم وأسألك يا من تسره طاعتي ولا تضره معصيتي هب لي ما يسرك واغفر لي ما لا يضرك(@)(@@)(@@)(@@) | 1872 - (@)(@@) ابن عمر(@)(@@) اللهم إني أعوذ بك من زوال نعمتك وتحول عافيتك وفجأة نقمتك وجميع سخطك وغضبك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1873 - (@)(@@) عقبة بن عامر(@)(@@) اللهم إني أعوذ بك من يوم السوء وساعة السوء وصاحب السوء وجار السوء في دار المقامة(@)(@@)(@@)(@@) | 1874 - (@)(@@) أبو هريرة(@)(@@) اللهم إني أعوذ بك من موت الهدم وأعوذ بك من موت الهدم وأعوذ بك من الجوع فإنه بئس الضجيع وأعوذ بك من الخيانة فإنها بئست البطانة(@)(@@)(@@)(@@) | 1875 - (@)(@@) عبد الله بن سرجس(@)(@@) اللهم إني أعوذ بك من وعثاء السفر وكآبة المنقلب ومن الخور بعد الكور ودعوة المظلوم وسوء المنظر في الأهل والمال(@)(@@)(@@)(@@) | 1876 - (@)(@@) ابن عباس(@)(@@) اللهم إني أعوذ بك من غلبة الدين وغلبة العدو ومن بوار الأيم ومن فتنة المسيح الدجال(@)(@@)(@@)(@@) | 1877 - (@)(@@) أبو مالك الأشعري اللهم أني أعوذ بك من طوارق(@)(@@) PageV00P000(@)(@@) هذا الليل إلا طارقا يطرق بخير آمنت بالله وكفرت بالطاغوت ووعد الله حق وصدق المرسلون(@)(@@) فصل(@)(@@)(@@)(@@) | 1878 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني أعوذ بك من عمل يخزيني اللهم إني أعوذ بك من غنى يطغيني اللهم إني أعوذ بك من صاحب يرديني اللهم إني أعوذ بك من أمل يلهيني اللهم إني أعوذ بك من فقر ينسيني(@)(@@)(@@)(@@) | 1879 - (@)(@@) أبو هريرة(@)(@@) اللهم إني أعوذ بك من أربع من علم لا ينفع ومن قلب لا يخشع ومن نفس لا تشبع ومن دعاء لا يسمع(@)(@@)(@@)(@@) | 1880 - (@)(@@) علي بن أبي طالب(@)(@@) اللهم إني أعوذ بك من إمرأة تشيبني قبل المشيب وأعوذ بك من ولد 
ms137	 يكون علي وأعوذ بك من مال يكون علي عذابا وأعوذ بك من صاحب خديعة إن رأى حسنة دفنها وإن رأى سيئة أفشاها(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 1881 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني أعوذ بك من العجز والكسل وأعوذ بك من الهم والحزن وأعوذ بك من البخل والجبن وضلع الدين وغلبة الرجال(@)(@@)(@@)(@@) | 1882 - (@)(@@) البراء بن عازب(@)(@@) اللهم إني أعوذ بك من العجز والكسل وأعوذ بك من الشك في الحق بعد اليقين وأعوذ بك من الشيطان الرجيم وأعوذ بك من شر يوم الدين(@)(@@)(@@)(@@) | 1883 - (@)(@@) أبو هريرة(@)(@@) اللهم إني أعوذ بك من الشقاق والنقاق وسوء الأخلاق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1884 - (@)(@@) عائشة(@)(@@) اللهم إني أعوذ بك من الفقر وأسألك أن تقضي عني المغرم(@)(@@)(@@)(@@) | 1885 - (@)(@@) أبو ليلى(@)(@@) اللهم إني أعوذ بك من النار ويل لأهل النار(@)(@@)(@@)(@@) | 1886 - (@)(@@) أبو النسر السلمي(@)(@@) اللهم إني أعوذ بك من الهرم وأعوذ بك من التردي وأعوذ بك من الغرق وأعوذ بك أن يتخبطني الشيطان عند الموت وأعوذ بك أن أموت في سبيلك مدبرا وأعوذ بك أن أموت لديغا(@)(@@)(@@)(@@) | 1887 - (@)(@@) ميمونة(@)(@@) اللهم إني أعوذ بك أن أضل أو أضل أو أذل أو أذل أو أجهل أو يجهل علي أو أظلم أو أظلم(@)(@@)(@@)(@@) | 1888 - (@)(@@) عبد الله بن جعفر(@)(@@) اللهم إني أعوذ بنور وجهك الذي أضاءت له السموات(@)(@@)(@@)(@@) | 1889 - (@)(@@) علي(@)(@@) اللهم إني أعوذ بوجهك الكريم وكلماتك التامة من شر ما أنت آخذ بناصيته اللهم اكشف المغرم والمأثم اللهم لا تهزم جندك ولا تخلف وعدك ولا ينفع ذا الجد منك الجد سبحانك وبحمدك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1890 - (@)(@@) عائشة(@)(@@) اللهم إني أعوذ برضاك من سخطك وبمعافاتك من عقوبتك وبك منك لا أحصي ثناء عليك أنت كما أثنيت على نفسك(@)(@@) فصل(@)(@@)(@@)(@@) | 1891 - (@)(@@) بريدة الأسلمي(@)(@@) اللهم إني ضعيف فقو في رضاك ضعفي وخذ إلى الخير بناصيتي واجعل الإسلام منتهى رضاي اللهم إني ضعيف فقوني وإني ذليل فأعزني وإني فقير فارزقني(@)(@@)(@@)(@@) | 1892 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني أصبحت أشهدك وأشهد حملة عرشك وملائكتك وجميع خلقك إنك أنت الله الذي لا إله إلا أنت وحدك لا شريك لك 
ms138	 وأن محمدا عبدك ورسولك(@)(@@)(@@)(@@) | 1893 - (@)(@@) أبو بكر الصديق(@)(@@) اللهم إني ظلمت نفسي ظلما كثيرا(@)(@@) PageV00P000(@)(@@) ولا يغفر الذنوب إلا أنت فاغفر لي مغفرة من عندك وارحمني إنك أنت الغفور الرحيم(@)(@@)(@@)(@@) | 1894 - (@)(@@) أبو هريرة(@)(@@) اللهم إني أتخذ عندك عهدا لن تخلفه إنما أنا بشر فأي المؤمنين آذيته أو شتمته أو جلدته أو لعنته فاجعلها له صلاة وزكاة وقربة يوم القيامة(@)(@@)(@@)(@@) | 1895 - (@)(@@) أبو موسى الأشعري(@)(@@) اللهم إني أنا عبدك ابن عبدك ابن أمتك في قبضتك ناصيتي بيدك ماض في حكمك عدل في قضاؤك أسألك بكل اسم هو لك سميت به نفسك أو أنزلته في كتابك أو إستأثرت به في علم الغيب عندك أن تجعل القرآن ربيع قلبي ونور بصري وجلاء حزني وذهاب همي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1896 - (@)(@@) جابر بن عبد الله(@)(@@) اللهم إني أستخيرك بعلمك وأستقدرك بقدرتك وأسألك من فضلك العظيم فإنك تقدر ولا أقدر وتعلم ولا أعلم أنت علام الغيوب اللهم إن كنت تعلم أن هذا الأمر خير لي في ديني ومعادي ومعاشي وعاقبة أمري فاقدره لي ويسره لي ثم بارك لي فيه وإن كنت تعلمه شرا لي في مثل ذلك فاصرفه عني واصرفني عنه واقدر لي الخير حيث كان وأرضني به(@)(@@)(@@)(@@) | 1897 - (@)(@@) أنس بن مالك(@)(@@) اللهم إني أشهد بما شهدت به على نفسك وشهدت به ملائكتك وأنبياؤك وأولو العلم ومن لم يشهد بما شهدت به فاكتب شهادتي مكان شهادته أنت السلام ومنك السلام تباركت ربنا يا ذا الجلال والإكرام اللهم إني أسألك فكاك رقبتي من النار(@)(@@)(@@)(@@) | 1898 - (@)(@@) عبد الله بن أبي أوفى(@)(@@) اللهم إني لم أخرج أشرا ولا بطرا ولا رياء ولا سمعة خرجت اتقاء سخطك وابتغاء مرضاتك أسألك أن تدخلني الجنة وتنقذني من النار(@)(@@)(@@)(@@) | 1899 - (@)(@@) أبو هريرة(@)(@@) اللهم إني أخرج من الضعيفين اليتيم والمرأة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1900 - (@)(@@) الحسن بن علي(@)(@@) اللهم إنما أنا بشر فلا تعذبني بشتم رجل من المسلمين شتمته أو آذيته(@)(@@) فصل(@)(@@)(@@)(@@) | 1901 - (@)(@@) عمر بن الخطاب(@)(@@) اللهم احفظني بالإسلام قائما واحفظني بالإسلام قاعدا واحفظني بالإسلام راقدا ولا تطغ في عدوا حاسدا وأعوذ بك 
ms139	 من كل دابة أنت آخذ بناصيتها(@)(@@)(@@)(@@) | 1902 - (@)(@@) عمران بن حصين(@)(@@) اللهم ألهمني رشدي وأعذني من شر نفسي(@)(@@)(@@)(@@) | 1903 - (@)(@@) جابر(@)(@@) اللهم استرني بالعافية في الدنيا والآخرة(@)(@@)(@@)(@@) | 1904 - (@)(@@) أنس بن مالك(@)(@@) اللهم انفعني بما علمتني وعلمني ما تنفعني وارزقني علما تنفعني به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1905 - (@)(@@) أبو بكر الصديق(@)(@@) اللهم ألبسني العافية في الدنيا واليقين في الآخرة(@)(@@)(@@)(@@) | 1906 - (@)(@@) الحسين بن علي(@)(@@) اللهم أغنني بالعلم وزيني بالحلم وأكرمني بالتقوى وجملني بالعافية(@)(@@)(@@)(@@) | 1907 - (@)(@@) ابن عباس(@)(@@) اللهم أغنني بحلالك عن حرامك وأغنني بفضلك عمن سواك(@)(@@)(@@)(@@) | 1908 - (@)(@@) ابن عباس(@)(@@) اللهم ارزقني عينين هطالتين تبكيان بذروف الدموع وتشفيان من خشيتك قبل أن يكون الدمع دما والأضراس جمرا(@)(@@)(@@)(@@) | 1909 - (@)(@@) أنس بن مالك(@)(@@) اللهم ارزقني شهادة منك في يسر وعافية(@)(@@)(@@)(@@) | 1910 - (@)(@@) أبو العصير الكناني(@)(@@) اللهم أرني الدنيا التي تريها صالح عبادك(@)(@@)(@@)(@@) | 1911 - (@)(@@) أنس بن مالك(@)(@@) اللهم اهدني من عندك وافض علي من فضلك وأسبغ علي رحمتك وأنزل علي بركاتك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1912 - (@)(@@) أبو الدرداء(@)(@@) اللهم أرحمني بترك المعاصي أبدا ما أبقيتني وارحمني بترك ما لا يعنيني وارزقني حسن النظر فيما يرضيك عني والزم قلبي حفظ كتابك كما علمتني ونور به صدري واشرح به صدري واجعلني أتلوه كما يرضيك عني وأفرح به قلبي وأطلق به لساني(@)(@@) فصل(@)(@@)(@@)(@@) | 1913 - (@)(@@) علي بن أبي طالب(@)(@@) اللهم أعني على ديني بالدنيا وعلى آخرتي بالتقوى واحفظني فيما غبت عنه ولا تكلني إلي فيما حضرت يا من لا تضره الذنوب ولا تنقصه المغفرة هب لي ما لا ينقصك واغفر لي ما لا يضرك(@)(@@)(@@)(@@) | 1914 - (@)(@@) معاذ بن جبل(@)(@@) اللهم أعني على ذكرك وشكرك وحسن عبادتك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1915 - (@)(@@) ابن عباس(@)(@@) اللهم نجني من النار سالما وأدخلني الجنة غانما(@)(@@)(@@)(@@) | 1916 - (@)(@@) ابن عمر(@)(@@) اللهم وفقني لما تحب وترضى من القول والعمل والفعل والنية والهدى إنك على كل شيء قدير(@)(@@)(@@)(@@) | 1917 - (@)(@@) ابن عباس(@)(@@) اللهم قنعني بما رزقتني وبارك لي فيه واخلف علي كل غائبة لي بخير(@)(@@)(@@)(@@) | 1918 - (@)(@@) عمر بن زيادة(@)(@@) اللهم جنبني منكرات الأخلاق والأعمال والأهواء والأدواء(@)(@@)(@@)(@@) | 1919 - (@)(@@) عبادة بن الصامت(@)(@@) اللهم سلمني لرمضان وسلم رمضان لي 
ms140	 وتسلمه لي مقبلا(@)(@@)(@@)(@@) | 1920 - (@)(@@) البراء بن عازب(@)(@@) اللهم قني عذابك يوم تبعث عبادك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1921 - (@)(@@) أنس بن مالك(@)(@@) اللهم عافني من الغل يوم القيامة(@)(@@)(@@)(@@) | 1922 - (@)(@@) عائشة(@)(@@) اللهم حاسبني حسابا يسيرا(@)(@@) فصل(@)(@@)(@@)(@@) | 1923 - (@)(@@) عائشة(@)(@@) اللهم اجعلني من الذين إذا أحسنوا استبشروا وإذا أساءوا إستغفروا(@)(@@)(@@)(@@) | 1924 - (@)(@@) أنس(@)(@@) اللهم أجعلني ممن توكل عليك فكفيته واستهداك فهديته واستنصرك فنصرته(@)(@@)(@@)(@@) | 1925 - (@)(@@) أبو هريرة(@)(@@) اللهم اجعلني أخشاك كأنني أراك أبدا حتى ألقاك وأسعدني بتقواك ولا تشقني بمعصيتك وأخر لي في قضائك وبارك لي(@)(@@) PageV00P000(@)(@@) في قدرك حتى لا أحب تعجيل ما أخرت ولا تأخير ما عجلت اجعل غناي في نفسي(@)(@@)(@@)(@@) | 1926 - (@)(@@) بريدة الأسلمي(@)(@@) اللهم اجعلني صبورا اللهم اجعلني شكورا اللهم اجعلني في عيني صغيرا اللهم اجعلني في أعين الناس كبيرا(@)(@@)(@@)(@@) | 1927 - (@)(@@) أبو هريرة(@)(@@) اللهم اجعلني أعظم شكرك وأكثر ذكرك وأتبع نصيحتك وأحفظ وصيتك(@)(@@)(@@)(@@) | 1928 - (@)(@@) معاذ بن جبل(@)(@@) اللهم إجعلني سهل البيع سهل الشراء سهل القضاء سهل الاقتضاء فإن رأس الربح السماح(@)(@@)(@@)(@@) | 1929 - (@)(@@) أم سلمة(@)(@@) اللهم اجعلني أقرب من يقرب إليك وأوجه من توجه إليك وأنجح من سألك وطلب إليك يا الله يا الله يا الله(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 1930 - (@)(@@) المعاصر(@)(@@) اللهم اجعل وساوس قلبي خشيتك وذكرك واجعل همي وهواي فيما تحب وترضى اللهم وما ابتلتني به رخاء وشدة فمكني سنة الحق وشريعة الإسلام(@)(@@)(@@)(@@) | 1931 - (@)(@@) ابن عباس(@)(@@) اللهم إجعل لي نورا في قبري ونورا في قلبي ونورا بين يدي ونورا من خلفي ونورا عن يميني ونورا عن شمالي ونورا من فوقي ونورا من تحتي ونورا في سمعي ونورا في بصري ونورا في شعري ونورا في بشري ونورا في لحمي ونورا في دمي ونورا في عظامي اللهم أعظم لي نورا وأعطني نورا(@)(@@)(@@)(@@) | 1932 - (@)(@@) البراء بن عازب(@)(@@) اللهم اجعل لي عندك عهدا واجعل لي عندك ودا واجعل لي في صدور المؤمنين مودة(@)(@@)(@@)(@@) | 1933 - (@)(@@) جابر(@)(@@) اللهم أصلح لي في سمعي وبصري واجعلهما الوارثان مني وانصرني على من ظلمني وأرني فيه ثأري(@)(@@)(@@)(@@) | 1934 - (@)(@@) أبو هريرة(@)(@@) اللهم أصلح لي ديني الذي هو عصمة أمري وأصلح لي 