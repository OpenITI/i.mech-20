ms93	 %~% اوله %~% از نقد تو کم عیارتر، کم دیدم(@)(@@) (@@) 92 چون نامهآ مهر تو فرو خواند دل %~% بر کار غم تو، سخت درماند دل(@)(@@) (@@) گیرم، به غم تو جان برافشاند دل %~% قدر غم عشق تو، کجا داند دل!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 924 ماییم، زمانه را زمین پیمایی %~% بگذاشته هر شهر به شهر آرایی(@)(@@) (@@) ی دیده و دل، بمانده در سودایی %~% تن جایی و، دل جایی و، دلبر جایی!(@)(@@)(@@)(@@) | با اعرف(@)(@@) (@@) 920 هان، ای دل دیوانهآ مدهوش، مکن %~% جام غم عشق دیگری نوش مکن(@)(@@) (@@) بر تو لب لعل او، حق جان دارد %~% حقهای قدیم را فراموش مکن PageV01P227(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0231.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 927 ای دل، زسر لجاج برخیز، مکن %~% وین آتش ساکن شده را تیز مکن(@)(@@) (@@) با این جگر سوخته، زنهار مخور %~% با جان به لب رسیده مستیز، مکن(@)(@@)(@@)(@@) | ظهیر فاریابی(@)(@@) (@@) 928 گفتم که مگر دل نه چو دلدار آید %~% در هر غم و شادیی، مرا یار آید(@)(@@) (@@) اکنون، چو برون نهاد از دایره پای %~% بگذارم، تا سرش به دیوار آید!(@)(@@)(@@)(@@) | تاج الدین خواری(@)(@@) (@@) 929 عشق تو، سزای کار من کرد آخر %~% سرمایهآ عمر من، غمت خورد آخر(@)(@@) (@@) دی، با توبه جان معاملت کرد دلم %~% امروز، دو دست بر سر آورد آخر!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 930 ای دل، هستی نشان که دادهست تورا %~% برخاستی ازجان، چه فتادهست تورا(@)(@@) (@@) زان خسته شدی در غم رخسارهآ او %~% کان دستهآ گل، خار نهادهست تورا(@)(@@) (@@) 931 هر گه، که به هجران تو درماند دل %~% وله %~% از دیده، سرشکهای خون راند دل(@)(@@) (@@) با دیده دلم هر چه کند، شاید از آنک %~% نادیدن تو، ز دیده می داند دل!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 932 پیوسته زمن کشیده دامن، دل توست %~% فارغ زمن سوخته خرمن، دل توست(@)(@@) (@@) گر چرخ امان دهد، من از تودل خویش %~% فارغ تر از آن کنم، که از من دل توست!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 833 زنگار گرفت، در برم تو تو دل %~% آرام نمی کند دمی، بی او دل(@)(@@) (@@) نی نی غلطم من، این خطا می 
ms94	 گویم %~% گر وقتی دل داشتم، اکنون کودل!(@)(@@)(@@)(@@) | بغیره PageV01P228(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0232.jpg)(@)(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 935 با دل گفتم: (چو دلبری بگزیدی %~% بنشین و، بگو که: با منش چون دیدی؟»(@)(@@) (@@) دل گفت که: «از توجان طمع می دارد! %~% می دان و، تو این سخن زمن نشنیدی!»)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 936 بی زلف تو، شد ز چشم من ابر خجل %~% وز چشم تو، پای دل فرو رفت به گل(@)(@@) (@@) گویی که در آن زلف، چه می بیند چشم؟ %~% اوله %~% گویی که در آن چشم، چه می بیند دل؟(@)(@@) (@@) 931 ای دل، طمع از جفا پرستی بردار %~% هشیار شو، اومید زمستی بردار!(@)(@@) (@@) در کار خلاص توء دعا خواهم کرد %~% اله %~% ای پای زجای رفته، دستی بردارا(@)(@@) (@@) 933 خوش باش و، مرا به عیش ناخوش بگذار %~% کارم، به سر زلف مشوش بگذار(@)(@@) (@@) دل گر چه از آن توست، آبش بمبر %~% اوله %~% این خانه [ازا برای آتش بگذار!(@)(@@) (@@) 93 مگذار، که سودم به زیان در برود %~% و آوازهآ جورت، به جهان در برود(@)(@@) (@@) جانا، زپی بوس و کناری که نبود %~% شاید که دل من به میان در برود(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 94 ای دل ز وصال، این چه بیگانگی است؟ %~% دردم ز غم عشق فلان خانگی است(@)(@@) (@@) با اینهمه صبر، این چه رسوا شدن است؟ %~% با آنهمه عقل، این چه دیوانگی است؟(@)(@@) شیخ مجد الدین بغدادی(@)(@@) (@@) 94 هر عقد، که در زلف نگارم افتد %~% صد وخنه، از او به روزگارم افتد(@)(@@) (@@) او در دل و، دل خون شد و در دیده بماند %~% آن بخت کجا، که در کنارم افتد(@)(@@)(@@)(@@) | لهستی(@)(@@) (@@) 941 دی، گر دل خود را به تو ننموده امی %~% امروز، ز هجران تو آسوده امی(@)(@@) (@@) شکر ایزد را که دل توداری، ارنه %~% همچون جگر، از دیده بپالوده امی PageV01P229(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0233.jpg)(@)(@)(@@) (@@) 943 دل برد زمن به قهر و، من نستیزم %~% الها %~% ور باز دهد، نگیرم و بگریزم(@)(@@) (@@) تا، روز مخاصمت چو بیدل خیزم %~% آخر، به بهانه ای در او آو یزم! 
ms95	(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 944 یکتا دلم از زلف دو تا جان نبرد %~% خود دست نداد یارم تا جان نبرد(@)(@@) (@@) بی دل، چه کنم به نیم جانی که مراست %~% چون باز نداد دل، چرا جان نبرد؟(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) (@@) 948 گر زور تنم نیست، تن زارم هست %~% ور یار غمم نیست، غم یارم هست(@)(@@) ~~خون خوردن و، جان بدادن و، دم نزدن 946 یارب، اگرم عشق تو افزون گردد(@)(@@) %~% وله %~% گر کاردلم نیست، دل کارم هست! %~% تا عاقبت کار دلم چون گردد؟(@)(@@) (@@) عشق تو چو کوهی است، که از وی یک جو %~% بر دل نه، که بر کوه نهی خون گردد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 947 جوری که مرا از آن جفا کیش آید %~% بر هر چه براندازم، از آن بیش آید(@)(@@) (@@) از کس گله ای نیست مرا، هم زخود است %~% چون من پی دل روم، چنین پیش آید!(@)(@@)(@@)(@@) | خاقانی(@)(@@) (@@) 948 پیغام غمت، سوی دلم می آید %~% زخمت، همه بر روی دلم می آید(@)(@@) (@@) حان، پیش درت به خاک خواهم کردن %~% کز خاک درت، بوی دلم(@)(@@) (@@) 949 دی، پیش من آمد آن به قد سرو روان %~% خوافی %~% بی رنگ شدیم هر دو و، بسته زبان(@)(@@) (@@) او برد گمان، که باز خواهم زودل %~% من ترسیدم، که همچو دل خواهد جان!(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) (@@) 950 با دل گفتم که: «مهربانی با او %~% در باقی کن، اگر توانی با او!))(@)(@@) ~~دل گفت که: «زونمی شکیبم، چه کنم؟)جان گفت که: «من شدم، تو دانی با او!») PageV01P230(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0234.jpg)(@)(@)(@@)(@@)(@@) | اشهری(@)(@@) (@@) 95 چشمی، که به خونابه ترش می دارم %~% تا روی تو دید، بر سرش می دارم(@)(@@) (@@) دل، از غم تو به یاد گار است مرا %~% زان است، که نیک در برش می دارم!(@)(@@) (@@) 95 در شیوهآ عاشقی، اگر مقبلمی در حسرت آنم، که دلم در غم تو %~%(@)(@@) الغیره %~% یک ذره، ز خاک پای تو نگسلمی %~% چون می گرید، که کاشکی من دلمی(@)(@@)(@@)(@@) | سلطان محقد(@)(@@) (@@) 952 ای دل همه سال دردمندت بینم 
ms96	 %~% در کوی فراق مستمدت بینم(@)(@@) (@@) شرمت ناید، همیشه عاشق باشی %~% رسوا شده بیش خلق، چندت بسنم PageV01P231(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0235.jpg)(@)(@)(@@)(@@)(@@) | باب دهم(@)(@@) درغم وذکر غم ومدح وذم غم و شکر و شکایت از غم(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) ~~954 ای نازده یک دم، غم تو بی شادی در دل ز غمت، گرفته مأوی شادی(@)(@@) (@@) گویی که قضا با غم تو گفت: ای غم %~% غم باش به صورت و، به معنی شادی!(@)(@@)(@@)(@@) | وله(@)(@@) ~~955 بگسست دل از نشاط و، در غم پیوست ببرید زچشم نور و، در نم پیوست(@)(@@) (@@) غمهای پراکنده ز عالم بنگر %~% وله %~% کز بهر دلم، چگونه در هم پیوست(@)(@@) ~~956 جانا، دل غم پرست را رنجه مدار مستم زغم تو، مست را رنجه مدار(@)(@@) (@@) قصد توبه خون است، من این خدمت را %~% از دیده کنم، تودست را رنجه مدار!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~957 تا کی گویم: کجا روم؟ یا چه کنم؟افتاد حدیث من همه با چکنم(@)(@@) (@@) گفتی که: «دراز باد عمرت!) گفتم: %~% وله %~% عمری که غم است حاصلش، تا چه کنم!(@)(@@) ~~958 عشقی، که همه درد دل افزاید هستیاری، که ز پرده روی ننماید هست(@)(@@) (@@) گر زانکه ز شادی آنچه می باید نیست %~% شاید! که زغم آنچه نمی باید، هست PageV01P232(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0236.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 959 دل، تیرغم عشق توتا برجان خورد %~% بس غم که چه آشکار و، چه پنهان خورد(@)(@@) (@@) ای دل، چوزعشق جزغمت روزی نیست %~% غم خور، که به جز روزی خود نتوان خورد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 96 دل، دوش زدیده غرق خون دید مرا %~% رحم آمدش، از بس که زبون دید مرا(@)(@@) (@@) هم خصم من است، بی من از وی توبپرس %~% تا شرح دهد، که بی تو چون دید مرا(@)(@@) (@@) 961 غم، مسکن من زهر دهن می پرسد %~% اوله %~% حال دل من، زمرد و زن می پرسد(@)(@@) (@@) روزی، به غلط اگر غمی گم گردد %~% بر هر که رسد، خانهآ من می پرسد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 96 ما را، غمت آوارهآ کشورها کرد %~% واندر طلبت، حلقه زن درها 
ms97	 کرد(@)(@@) (@@) رسوای غم عشق تو گشتیم چنان %~% کز قصهآ ما، زمانه دفترها کرد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 963 آنم، که غم است ازجهان حاصل من %~% گویی که سرشته اند غم با گل من(@)(@@) (@@) بنگر، که جهان جانستان را هرگز %~% یک غم، به گلو فرو شود بی دل من؟(@)(@@)(@@)(@@) | اله(@)(@@) ~~96 هر گل، که از او خزان بهاری گردد در دیدهآ من، خلیده خاری گردد(@)(@@) (@@) هر غم، که کله با همه عالم بنهد %~% در مالش ما، کلاهداری گردد!(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 965 تا هست دلم زوصل تو کم روزی %~% کم نایدم از دیده ازاین نم، روزی(@)(@@) (@@) آنجا که غم تو در جهان کس نبرد %~% دانی که خورد غمت؟ من غم روزی!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 96 درد تو، نشاط گستری داند کرد %~% واندوه تو، روح پروری داند کرد(@)(@@) (@@) انذر غم تو، کدام شادی باشد %~% وله %~% کو، با غم تو برابری داند کرد؟(@)(@@) (@@) 967 دل را چوشد ازعشق فزون برغم غم %~% گفتم: دل عشق باره، و آنگه کم غم(@)(@@) ~~دل، چون رفمه بهان وف بعم وی فریاد بر آورد که : هم غم، هم غم1 PageV01P233(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0237.jpg)(@)(@)(@@) ~~پس، دست به هر غم که بود نالاید 968 افغان ز دلم، که جزبه غم نگراید(@)(@@) %~% وله %~% در جستن غم، جهان به سر پیماید %~% هر غم که نه جان بود، به هیچش ناید!(@)(@@) (@@) 969 ای اشک، غم ار به سر دوانید تورا %~% وله %~% ز اندازهآ خویش بگذرانید تو را(@)(@@) (@@) وی ناله، شکایت مکن از هجرانش %~% وله %~% آخر، نه به آسمان رسانید تورا؟(@)(@@) (@@) 970 طاق از تو، وبا هزارغم جفت منم %~% وانک از تو چو دیوانه بر آشفت، منم(@)(@@) (@@) گفتی : «از غمم زیر و زبر کیست؟ بگو» %~% وله %~% چون حال بگفت، حال من گفت: منم!(@)(@@) ~~گر لعل شد از بیم غم اشکم، چه عجب 971 غم بر دل من بس، که جهان تنگ(@)(@@) آرد %~% اشکی که ز غم بوی برد، رنگ آرد! %~% با غم، دل هیچ کس کجا سنگ آرد1(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 972 آمد شب و، 
ms98	 باز رفتم اندر غم دوست %~% هم با سر گریه ای، که چشمم را خوست(@)(@@) (@@) در هجر، مرا هر مژه کز پلک فروست %~% سیخی است، که پارهآ جگر بر سر اوست(@)(@@) (@@) 973 ای دوست، دلم به جان رسانیدهآ توست %~% اوله %~% وین کارن به استخوان رسانیدهآ توست(@)(@@) (@@) مگذار، که بر زمین فتد نالهآ من %~% اوله %~% آخر، نه برآسمان رسانیدهآ توست؟(@)(@@) (@@) 974 این بار، مرا از توبه انبار غم است %~% کاندک غم تو، مایهآ بسیار غم است(@)(@@) (@@) تنگی زچه بر دلم فراخ است؟ از آنک %~% دریک دل من، هزار خروار غم است!(@)(@@) (@@) 975 ای دل، چو دلارام دهد دم، دم خور %~% اوله %~% چندانکه فرستد به توغم، در هم خور(@)(@@) (@@) آمد به جهان، زبهر هر کس کاری %~% چون غم خوردن کار تو آمد، غم خور!(@)(@@) (@@) 872 دل، گرچه به غم سوخته تر می گردد %~% وله %~% هردم، به تو آموخته تر می گردد(@)(@@) (@@) زنهار، مده دم که درین خسته دلم %~% آتش، به دم افروخته تر می گردد PageV01P234(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0238.jpg)(@)(@)(@@) ~~971 هر روز، که روزم از تو شبرنگ تراست دل، ییش سبک تر است و بی سنگ تر است(@)(@@) (@@) تنگی مکن ارفراخی آید، که دلم %~% چندانکه غمش فراختر، تنگ تراست(@)(@@) (@@) 978 تا در بر من دل است، جای غم توست %~% اوله %~% هر دل که دل است، مبتلای غم توست(@)(@@) (@@) زان بوسه دهم بر سر وپای دل خویش %~% کآنجاست سر دلم، که پای غم توست!(@)(@@) (@@) 97 در کارتو، هر که دید زیر و زبرم %~% اوله %~% جز خون خوردن، ندید کار دگرم(@)(@@) (@@) خوردم ز توخون و، غم آن هم خوردم %~% اوله %~% کان روز که این غمت نباشد، چه خورم؟(@)(@@) (@@) 98 ای دل، ز غمش چو در رسد شیرینی %~% تا بی غم او، نخیزی و ننشینی(@)(@@) (@@) زنهار، برین غم بدلی نگزینی %~% زین غم تو نبینی، که چه شادی بینی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 98 گفتم که: دل من از جهان همدم توست %~% پیوسته، اسیر عهد نامحکم توست(@)(@@) (@@) گفتا: چو دل تو باد 
ms99	 پرغم، دل من %~% گر بر دل من، نه کمترین غم غم توست!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~98 در کار تو، بسته بس دل ریش که هست وز نوش تو، خون بس دل پرنیش که هست(@)(@@) (@@) تا چند، که هردم غم دل بادت بیش %~% وله %~% آید غم دل مرا ازین بیش که هست(@)(@@) (@@) 983 بگرفت دل مرا و غم زآ ذرغم %~% یک لحظه، جدا نمی شود از بر غم(@)(@@) ~~جایی است کنون جای دل من، که دراواز بی جایی، نشسته غم بر سر غم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 984 یک دل چه کند؟ هزار جانبازی کرد %~% خون خورد و خموش بود و، دمسازی کرد!(@)(@@) ~~بسیار بکوشید، و نهان داشت غمت بوی جگر سوخته، غمازی کرد!(@)(@@)(@@)(@@) | ول 985 غم، بر دل من همی گمارد تنگی %~% دود، از دل من همی برآرد تنگی(@)(@@) (@@) گویی، به جهان زبهر آن آمد غم %~% تا بر دل من، فراخ دارد تنگی PageV01P235(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0239.jpg)(@)(@)(@@)(@@)(@@) | له(@)(@@) (@@) 986 دوش، ای زده نور رخ تو راه سحر %~% در خدمت غم بدیم، تا گاه سحر(@)(@@) (@@) صبر وخرد وجمله حریفان، رفتند %~% من ماندم و، آب دیده و آه سحرا(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) (@@) 987 تا ظن نبری که کم کمت می بینم %~% بی زحمت دیده، هردمت می بینم(@)(@@) (@@) در وصف نگنجد و، صفت نتوان داد %~% آن شادیها، که در غمت می بینم!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 988 کم بود شبی که هجر شبگیر نکرد %~% کس، کار مرا چاره و تدبیر نکرد(@)(@@) (@@) در ریختن خون من، القصه غمت %~% تا بتوانست، هیچ تقصیر نکرد!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 989 چاکر، زغمت کرانهای می جوید %~% در کوی مراد، خانه ای می جوید(@)(@@) (@@) آیین ستم نگر، که دل خود زغمت %~% وله %~% تا خون گردد، بهانه ای می جوید!(@)(@@) (@@) 990 سوز دل بنده، در تو تأثیر نکرد %~% وین کار مرا، وصل تو تدبیر نکرد(@)(@@) (@@) فی الجمله، غم تو گرچه بر بود دلم %~% چون جان بگذاشت، هیچ تقصیر نکرد!(@)(@@) (@@) 991 پرغم داری، دلی که مهر تودر اوست %~% اثیر %~% و آنگه، به دلت بنگذرد 
ms100	 کاین نه نکوست(@)(@@) ~~ای جان و جهان، تو را نه این عادت و خوست کزغم بکشی، هر که تورا دارد دوست!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 992 شادم به غمت، که جان جان کرده امش %~% روزی، به کم و کیف نیازرده امش(@)(@@) (@@) با آنکه چنین به ناز پرورده امش %~% ترسم که نماند، که بسی خورده امش!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 993 پپرامن دل، محنت و اندوه بسی است %~% غمهای بسی گران تر از کوه، بسی است(@)(@@) (@@) دل تاب یک اندوه و دو دارد، لیکن %~% اندوه از آن است، که اندوه بسی است!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 994 ای ساقی خوش، برو مسلم بنشین %~% از خوردن باده توبه کردم، بنشین(@)(@@) (@@) ای شادی دل، بروبه ماتم بنشین %~% وی غم، توبه دل درآو، خرم بنشین!(@)(@)PageV01P236(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0240.jpg)(@)(@)(@@) (@@) 995 ای مهر گسسته و، به کین پیوسته %~% اوله %~% در هجر به تعجیل و، به وصل آهسته(@)(@@) (@@) بگشاده به هجر دست و، پایم بسته %~% برخاسته شاد و، من به غم بنشسته!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 99 بر لوح، همه بودنیی رفت قلم %~% نه بیش کنند از آنچه رفتهست-نه کم(@)(@@) ~~از شادی و غم مباش شادان و دژم چون هر دو نمانند چه شادی و، چه غم!(@)(@@)(@@)(@@) | صدر زنگانی(@)(@@) (@@) 997 ای دل، ز غمش همیشه پر آتش باش %~% کا حان داری، به جان و دل غمکش باش(@)(@@) (@@) زنهار، نگویی: «غم او چند خورم؟» %~% آخر، نه ز بهر اوست این غم؟ خوش باش!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 998 دل، دامن آن دلبر خونخواره گرفت %~% زنهار از آن شوخ ستمکاره گرفت(@)(@@) (@@) سلطان غمش در آمد و، شهر دلم %~% دروازه به دروازه، بیکباره گرفت(@)(@@)(@@)(@@) | سلطان خوارزمشاه(@)(@@) (@@) دل رفت زدست و، یار نامد حاصل ه99 دادم دل خود به دست آن شمع چگل %~%(@)(@@) اکنون غم معشوق خورم، یا غم دل؟ %~% زین روی، مرا فتاد کاری مشکل(@)(@@)(@@)(@@) | صدر خوارزمی(@)(@@) ~~هر روز کم است، هر چه دارم زغمت 1000 پرسید ز دل یار که: حالت چون(@)(@@) است؟ %~% الا غم تو، که هر زمان افزون است! %~% دل گفت: چه 