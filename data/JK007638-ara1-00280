ms261	 الخطى على الركبان % % 77(@)(@@) % هو صبح الأيام سعد الليالي % % بهجة الدهر نور عين الزمان % % 78(@)(@@) % تتلقاه من شذا حسبيه % % عطر الجيب طيب الأردان % % 79(@)(@@) % ومن البشر في محياه بدر % وبكفيه للندى ( جعفران ) % 80(@)(@@) % والأغر ' الهادي ' إذا حار وفد % فسناه دلالة الحيران % % PageV01P890 81(@)(@@) % هو طلق العنان في الجود طلق ال % % وجه طلق اليدين طلق اللسان % % 82(@)(@@) % ومزاياه في سما المجد شهب % وهو فيها وصنوه القمران % % 83(@)(@@) % و ' أمين التقى وهل ضم مثلا % لأمين في عصرنا المشرقان ؟ % 84(@)(@@) % طاهر النفس طاهر الجيب والأب % % راد عف في السر والإعلان % % 85(@)(@@) % أبدا في تقاه لم تتغبر % % بغبار الآثام منه اليدان % % 86(@)(@@) % وهو في صدق لهجة ( كأبي ذر % وتقوى تحكى تقى ' سلمان ' % 87(@)(@@) % والمرجى ( محمد حسن ) الطل % % عة ينضو اللثام عن كيوان % % 88(@)(@@) % مخبرات مخايل الفضل فيه % % أن سيسموا فخرا على الأقران % % 89(@)(@@) % يا ( أبا المصطفى ) وحلمك أرسى % % في لقاء الخطوب من ثهلان % % PageV01P891 90(@)(@@) % لك نفس قدسية الذات فيها % % حزت أعلى مراتب العرفان % % 91(@)(@@) % وصف الله أن قلبك للتق % % وى مشيرا بآية الامتحان % % 92(@)(@@) % وأرى الصابرين في عصرنا أنت % % عناك الإله في القرآن % % 93(@)(@@) % حيث لو قيل عددوهم عددنا % % ك ونعيا عن أن نجيء بثاني % % 94(@)(@@) % هو جمع اريد بالذكر منه % % واحد وهو أنت عند البيان % % 95(@)(@@) % فرغ القلب من جوى الثكل يا من % % هو في الفضل ملء عين الزمان % % PageV01P892 البحر : متقارب تام 1(@)(@@) % كذا تفقد العين إنسانها % % فتدمي المدامع أجفانها % % 2(@)(@@) % كذا يقرع الخطب صم الجبال % % إلى أن يزلزل ثهلانها % % 3(@)(@@) % كذا للمراقب كف الزمان % % تمد فتأسر عقبانها % % 4(@)(@@) % كذا تغمد البيض تحت الصعيد % % فتغدو الضرايح أجفانها % % 5(@)(@@) % كذا وأبيك عوالي الرماح % % تدق يد الدهر مرانها % % PageV01P893 البحر : متقارب تام 1(@)(@@) % لقيت من الوجد واللائمينا % % ضنى شف جسمي وأقذى العيونا % % 2(@)(@@) % فلم أدر ماذا بقلبي أمض % وجدي أم عذل العاذلينا ؟ % 3(@)(@@) % الائمتي بعض هذا الملام % % فالأمر ليس كما تزعمينا % % 4(@)(@@) % ذريني ادمي غروب الجفون % % واستشعر الحزن حينا فحينا % % 5(@)(@@) % لقد جذم الدهر يسري يدي % فبانت 
ms262	 وألحق فيها اليمينا % % 6(@)(@@) % أصبرا وإنسان عيني يسل % بظفر الردى ساء ما تأمرينا % % 7(@)(@@) % كفى حزنا أن جسمي أقام % % وقلبي استقل مع الظاعنينا % % 8(@)(@@) % أعيني شأنكما والدموع % % فما يترك الدهر دمعا مصونا % % 9(@)(@@) % له الذم بالأمس قد بزني % % وشيمته الغدر علقا ثمينا % % 10(@)(@@) % فغادر حجري منه خميصا % وبطن الثرى منه أمسى بطينا % % PageV01P894 11(@)(@@) % وغصن نما في تراب العلى % % وأينع في روضة المجد حينا % % 12(@)(@@) % ذوى بعدما أن زها برهة % وراق النواظر حسنا ولينا % % 13(@)(@@) % وكنت متى عن لي ذركه % أطلت عليه البكا والحنينا % % 14(@)(@@) % مضى ما نسيناه لكن ثنى % % بآخر يذكرنا ما نسينا % % 15(@)(@@) % أهلت عليه تراب القبور % % وعدت أكابد داء دفينا % % 16(@)(@@) % على أنني لم أزل منذ سبع % أعد الشهور له والسنينا % % 17(@)(@@) % توسمت منه سمات الكمال % % وقلت يكون لبيبا فطينا % % 18(@)(@@) % فلما مخائله بشرت % بتحقيق ما ارتجى أن يكونا % % 19(@)(@@) % وقامت على ما تفرست فيه % % شواهد حققن فيه الظنونا % % 20(@)(@@) % رمته المنون بسهم الحمام % % من حيث لا أتوقى المنونا % % PageV01P895 21(@)(@@) % فأصبحت أسمح للترب فيه % % وكنت على اللحظ فيه ضنينا % % 22(@)(@@) % بمن أتعلل في النائبات % % إذا غادرتني كئيبا حزينا % % 23(@)(@@) % ومن مؤنسي حيث ليل الخطوب % % يمر علي الهزيع الدجينا % % 24(@)(@@) % فقل لليالي بلغت المنى % % وأدركت مني ما تأملينا % % 25(@)(@@) % لقد كنت بالأمس ذا مقلتين % % أرى بهما ما يقر العيونا % % 26(@)(@@) % فقأت بسهمك يسراهما % % وسرعان ما قد فقأت اليمينا % % 27(@)(@@) % قعدت بعمياء مستصحبا % تريني أيامي البيض جونا % % 28(@)(@@) % ولا تحسبيني لما شكوت % صنيعك لي عاجزا مستكينا % % PageV01P896 البحر : طويل 1(@)(@@) % أما والهوى العذري ما بت ساليا % % حبيبا بعيني الكرى كان ثانيا % % 2(@)(@@) % سلوت إذا والله حتى حشاشتي % % على عزها إن كنت أمسيت ساليا % % 3(@)(@@) % وريان من ماء الصبا غصن قده % % برغمي يمس في ثرى اللحد ذاويا % % 4(@)(@@) % فجعت به حلو الشمائل بعدما % % ولعت به غض الشبيبة ناشيا % % 5(@)(@@) % تطلع نفسي من ثنايا اشتياقها % % إلى طلعة منه تنير الدياجيا % % 6(@)(@@) % وأطلب في الأحياء رؤية شخصه % % على وله مني وأنسى افتقاديا % % 7(@)(@@) % فكم 
ms263	 لي على الذكر إليه التفاتة % كأن لم يكن بالأمس وسد ثاويا % % 8(@)(@@) % ولائمة لامت ولم تدر ما الجوى % % ولا كيف يرعى المستهام الدراريا % % 9(@)(@@) % تلوم ولا سمعي لها فيجيبها % % إلى سلوة قلبي ولا قلبها ليا % % 10(@)(@@) % ولو وجدت للبين ما قد وجدته % % غدا آمري بالحزن من كان ناهيا % % PageV01P897 11(@)(@@) % أميمة هل أدميت إلا بنانيا % % وهل غير دمعي بل فضل ردائيا % % 12(@)(@@) % أقلي فلم أنضح جواي بأدمع % اكفكفها عن مقلتيك جواريا % % 13(@)(@@) % ولا قلبت كف لأسى لك مهجة % % حشاي على جمر توقد ذاكيا % % 14(@)(@@) % عذلت وعندي يعلم الله لوعة % % أكابد منها ما يدك الرواسيا % % 15(@)(@@) % غلبت وأحداث الزمان غوالب % وفي أي دار ما أقمن النواعيا % % 16(@)(@@) % وكيف انتصاري يوم طارقة النوى % % وعند الليالي يا ابنة القوم ثاريا ؟ % 17(@)(@@) % حدت ظعن الأحباب عني وغادرت % % مع السقم تعتاد الهموم وساديا % % 18(@)(@@) % وفي الجيرة النائين لو تعلمينها % % علاقة حب همت فيها لياليا % % 19(@)(@@) % فلو جمعتنا الدار من بعد هذه % % إذا لأطلنا يا أميم التشاكيا % % 20(@)(@@) % بمن أتداوى من جوى الهم لا بمن % % وهل دفن الأقوام إلا دوائيا ؟ % PageV01P898 21(@)(@@) % وغادين قد أتبعتهم يوم ظعنهم % % جفونا يعلمن البكاء الغواديا % % 22(@)(@@) % وقفت لهم في مدرج البين وقفة % تكسر أنى ملت مني عظاميا % % 23(@)(@@) % وقفت ونفسي رغبة في لقائهم % % تمني على كذب الرجاء الأمانيا % % 24(@)(@@) % ومن ذهبت أيدي المنايا بشخصه % % فهيهات فيه يرجع الدهر ثانيا % % 25(@)(@@) % أحباى حال الموت بيني وبينكم % % فما حيلتي فيكم عدمت احتياليا ؟ % 26(@)(@@) % فقوا لا أقام البين صدر مطيكم % % لمستعطف بالدمع يخشى التنائيا % % 27(@)(@@) % قفوا خبروني عنكم هل أراكم % % ولو شبحا ما بين عيني ساريا ؟ % 28(@)(@@) % وتلك الليالي السالفات على منى % تطيب وتحلو هل تعود كما هيا ؟ % 29(@)(@@) % ليالي أنس بالوصال لبستها % % رقاق الحواشي نيرات زواهيا % % 30(@)(@@) % دعوا إلى قلبي أو خذوه مع الجوى % % فها هو خلف الركب أصبح ساريا % % PageV01P899 31(@)(@@) % أحباي لا والله ما عشت سلوة % ولا بكم استبدلت خلا مصافيا % % 32(@)(@@) % ولما سرى الناعي بكم فاستفزني % % ونادى منادي البين أن لا تدانيا 
ms264	 % % 33(@)(@@) % ربطت الحشا بالراحتين ولم أخل % تطيح شظايا مهجتي ببنانيا % % 34(@)(@@) % وعندي مما ثقف البين أضلع % غدون على جمر الفراق حوانيا % % 35(@)(@@) % وعين بلا غمض كأن جفونها % % حلفن بمن تهواه أن لا تلاقيا % % 36(@)(@@) % وقلب متى يا برق يقدحك الأسى % % قدحت به زندا من الشوق واريا % % 37(@)(@@) % ولي في زوايا ذلك النعش مهجة % ترف رفيف الطير يفحص داميا % % 38(@)(@@) % قضى الله أن لا أبرح الدهر اشتكي % % لو أعج يدمين الحشا والمآفيا % % 39(@)(@@) % فيا عين سيلي بالدموع صبابة % ويا نفس مني قد بلغت التراقيا % % PageV01P900 البحر : متقارب تام 1(@)(@@) % أتى اليوم حاتم أهل النهى % % على أنه للندى فاتح % 2(@)(@@) % أغر غدا السعد لما استهل % وهو لغرته ماسح % % 3(@)(@@) % وهنا به المجد وفاده % % وبشرها الشرف الواضح % % 4(@)(@@) % وقالوا جميعا وقد أرخوا : % نرى ولد الخلف الصالح % PageV01P901 البحر : كامل تام 1(@)(@@) % إن يطو مصباح المكارم ضارح % % فلقد أضاءت في علاه مصابح % 2(@)(@@) % طف حيث حل فئم جود باهر % وعلى مؤثلة ، ومجد راجح % % 3(@)(@@) % ملك له الشرف الرفيع مشيع % وعليه حتى المكرمات نوائح % % 4(@)(@@) % شكت البرية داءه لما شكا % % فقضى وألحد والقلوب ضرائح % % 5(@)(@@) % من جاره ، ' هود ' دعاه فأرخوا : % اسعد جوارك ذا محمد صالح % % PageV01P902 البحر : خفيف تام 1(@)(@@) % ذا محمد رشيد باشا بباني % % شاد للحكم دار عز ومجد % % 2(@)(@@) % تزدهي في مقاصر لو ( لكسرى % % مثلت قال : هذه فوق جهدي % % 3(@)(@@) % إنما ' آصف ' أتانا بصرح % من أتاه يجده جنة خلد % % 4(@)(@@) % قد دعا الملك مطربا أرخوه : % شاد بدر البهاء دارة سعد % % PageV01P903 البحر : رجز تام 1(@)(@@) % وليلة قد ولدت بصبحها % % شمس على تشع في سعودها % % 2(@)(@@) % سرت بها أهل المعالي ولها % % أهدت ' بمهدي ' سرور عيدها % % 3(@)(@@) % قد طرب الدهر غداة أرخوا : % فلتزدهي الليلة في مولودها % % PageV01P904 البحر : طويل 1(@)(@@) % لقد ولدت ام المفاخر ماجدا % تضوع من أعطافه طيب محتده % % 2(@)(@@) % تربى بحجر المجد واسترضع النهى % % وشب يفدى وهو ناش بحسده % % 3(@)(@@) % وأضحى عليه الفخر بعقد تاجه % % ويلقي مقاليد المعالي إلى يده % % 4(@)(@@) % فيا مولدا فيه بنعمة يمنه % % لنا السعد 
ms265	 غنى لا بنغمة معبده % % 5(@)(@@) % به خمدت نار العدا حين أرخوا : % أتى المصطفى يا عز آية مولده % % PageV01P905 البحر : طويل 1(@)(@@) % ألا بكر الناعي بثاو ثواءه % % توسد والمعروف تحت ثرى اللحد % % 2(@)(@@) % وعاش الهدي فيه ومات بموته % % فأرخ معا غاب الهدى هو والمهدي % % PageV01P906 البحر : خفيف تام 1(@)(@@) % عج لنادي التقى وحي البشيرا % % إن فيه الزوراء تزهو سرورا % % 2(@)(@@) % قد حباها يا سعد بشراك سعدا % كل قطر لنوره شع نورا % % 3(@)(@@) % إذ بإقبال أزهريها من الكع % % بة قد جاءها يبث الحبورا % % 4(@)(@@) % برضاها النقي وابن أبيه % % مصطفاها يدعو وردت سفيرا % % 5(@)(@@) % وجه بغداد حين أما لإنسا % % ن الحجى فيهما وصلت بشيرا % % 6(@)(@@) % فغدا حين صبحاه بهيا % بل حديث الهنا حلا منشورا % % 7(@)(@@) % أنت قطب التقى عليك لدأبا % % فلك العز قد يرى مستديرا % % 8(@)(@@) % بل جواد العليا ورب فخار % طيبه ضاع بالندي عبيرا % % 9(@)(@@) % وقرين السخاء من جاد طفلا % بنداه وساد شيخا كبيرا % % 10(@)(@@) % عش بطرف ما زال زهوا قريرا % يا أبا المصطفى فتحوي الحبورا % % PageV01P907 11(@)(@@) % كل عام كذا لدارك طلقا % يوفد السعد بالتهاني بشيرا % % 12(@)(@@) % بل ومغناك طيبا كل يوم % تجتليه به سنيا منيرا % % 13(@)(@@) % وكذا فليرق نديك مبد % من بهاء ما يخجل البدر نورا % % 14(@)(@@) % بل كذا اعقد رواق جدك حاو % كل وقت جلالة محبورا % % 15(@)(@@) % هاك القيت معجزا فانتحى يل % % قف عفوا ما زبرجوا تسطيرا % % 16(@)(@@) % حي منه مؤرخا عام ردا % % كل شطر أبدى فعد الشطورا % % PageV01P908 البحر : خفيف تام 1(@)(@@) % قل لأم العلى : ولدت كريما % شاد عليا أبيه فوق السماك % 2(@)(@@) % سخط الحاسدون مذ قيل أرخ : % ولد المجد يا وفود رضاك % % PageV01P909 البحر : كامل تام 1(@)(@@) % بشرى بمولود به ابتهج الزمن % وغدت تهنى المكرمات به ' الحسن ' % 2(@)(@@) % ولدته أم المجد أبلج طاهرا % في الأرض ترضعه المعارف لا % % 3(@)(@@) % فيه مخائل من أبيه وجده % % يخبرن أن سيطول عالية القنن % % 4(@)(@@) % وسيغتدي للحمد أشرف كاسب % وعلى كنوز المجد أكرم مؤتمن % % 5(@)(@@) % غصن نمته دوحة الكرم التي % % منها العفاة كم اجتنت ثمر المنن % % 6 
ms266	(@)(@@) % تتفيأ الأشراف بارد ظلها % % لتقيهم من حر هاجرة المحن % % 7(@)(@@) % وكفاك بالحسن المهذب شاهدا % لقديمه بحديث مفخرة الحسن % % 8(@)(@@) % هذا الذي ملأ الزمان عوارفا % بالبعض منها عاش كل بني الزمن % % 9(@)(@@) % إن لم نوجه مدحنا وثناءنا % % لمحمد الحسن الفعال ، فقل : لمن % % 10(@)(@@) % هو عقد فضل زان عاطل عصره % % لو لم يهبه الله عز على الثمن % % PageV01P910 11(@)(@@) % يفديه من تلقاه يرحض ثوبه % % يبغي نظافته وفي العرض الدرن % % 12(@)(@@) % إن لذ لي فيه الثناء فإنه % % لألذ في عين المحب من الوسن % % 13(@)(@@) % ندعوه يا ملكا بكاعبة العلى % % هو لا بكاعبة النهود قد افتتن % % 14(@)(@@) % يهنيك مولود سررت به العلى % % من سعد مولده بسعدكما اقترن % % 15(@)(@@) % طربت وقد غنى البشير مؤرخا : % ولدت محمد صالحا تقوى حسن % % PageV01P911 البحر : خفيف تام 1(@)(@@) % وقف المجد ناعيا عند قبر % وأرت المكرمات فيه شاها % % 2(@)(@@) % ودعا أنت جنة قلت : أرخ % % طاب مأوى نعيمها لرضاها % % PageV01P912 البحر : رجز تام 1(@)(@@) % للمصطفى والحسن الفعل معا % مرآة رأي حسن مرئيها % % 2(@)(@@) % كم قد أعدا للتجار رابح % خانا وهذا بالغنا مليها % % 3(@)(@@) % باليمين فيها عقدا شراكة % % لفتية مجموعها حظيها % % 4(@)(@@) % كواكب كل يروق المشترى % % فلا تسلني أيها دربها % % 5(@)(@@) % بعينه الرحمن قد رعاهم % لله عين آمن مرعيها % % 6(@)(@@) % أهلة بورك باجتماعها % % ببرج سعد زانه وضيها % % 7(@)(@@) % شراكة جاء حميد فألها % % للربح أرخ ( مصطفى غنيها ) % PageV01P913 البحر : خفيف تام 1(@)(@@) % نسيت في عرفانك الحكماء % فقبيح أن تذكر الشعراء % 2(@)(@@) % أي فضل لهم يبين وهل للبد % % ر نور إذا استنارت ذكاء % % 3(@)(@@) % جئت في النظم مبصر الفكر ووالدت % % يا جميعا بصيرة عمياء % % 4(@)(@@) % فأزلت العمى بآيات فضل % أذعنت طاعة لها البلغاء % % 5(@)(@@) % نشرت طيء الفصاحة لكن % % طويت في انتشارها الفصحاء % % 6(@)(@@) % حكم حلوة الينابيع عفوا % سلسلتها روية سمحاء % % 7(@)(@@) % يرشف السمع لفظها العذب راحا % % لجميع العقول منه انتشاء % % 8(@)(@@) % لو تلاها مرددا لفظها المرء % لما احتجن روحه الأعضاء % % 9(@)(@@) % وكفى شاهدا بفضلك ماتر % % ويه عنك الهمزية الغراء % % 10(@)(@@) % بنت فكر مجلوة في قواف % % PageV01P914 11(@)(@@) % ألفات مثل 
ms267	 الغصون تلتها % % لك من كل همزة ورقاء % % 12(@)(@@) % لبست من جمان نظمك عقدا % ما تحلت بمثله عذراء % % 13(@)(@@) % أين ( يا ابن الفاروق ) منك الذي أبدع في نظمها ولا إطراء % % 14(@)(@@) % لو رأى ما أودعت فيها لأضحى % % هو والنظم ( واصل ) والراء % % 15(@)(@@) % زبرة قد أشعت في المتن منها % % جوهرا في فرنده يستضاء % % 16(@)(@@) % فهي فيه عادت كمثل عصا مو % % سى وتخميسك اليد البيضاء % % PageV01P915 البحر : طويل 1(@)(@@) % أرب القوافي قد غدا لك مذعنا % بها محرز الفضل اكتسابا ووارثه % 2(@)(@@) % لو ( المتنبي ) شاهد الحكم التي % % نطقت بها ما شك أنك باعثه % % 3(@)(@@) % هي ' الباقيات الصالحات ' أطايب ال % % قريض ، ولكن ما سواها خبائثه % % 4(@)(@@) % فحسبك منها معجزا بمديح من % % معاجز كل الأنبياء موارثه % % 5(@)(@@) % غدت كعصا موسى ولكنما بها % % قد التقفا سحر القريض ونافثه % % 6(@)(@@) % كفى انها في أمة الشعر قبلة % إليها قديم النظم صلى وحادثه % % PageV01P916 البحر : كامل تام 1(@)(@@) % هذا كتاب أم حديقة روضة % تنزه الأحداق في أورادها % % 2(@)(@@) % وتود لو شرت العيون بياضه % % وسواده ببياضها وسوادها % % 3(@)(@@) % نظمت به غرر الكلام مصاقع % روح الفصاحة قام في أجسادها % % 4(@)(@@) % غررا بدت كالشهب إلا أنها % % بزغت بليل من سواد مدادها % % 5(@)(@@) % لو شنف الشادي الحمام بها إذن % % خلعت له الأطواق من أجيادها % % 6(@)(@@) % يهوى فؤاد المرء يغدو مسمعا % ليحوز حظ السمع من إنشادها % % 7(@)(@@) % لفظ أرق من الصبا وفخامة % % معناه تحسب قد من أطوادها % % 8(@)(@@) % دع ما يزخرفه الربيع وإن زهت % % أزهاره بين الربى ووهادها % % 9(@)(@@) % وتصفح ' الروض الخميل ' فرغبة % لثراه تنسى العين طيب رقادها % % 10(@)(@@) % تحظى بكل طريفة من حسنها % % غدت العقول العشر من روادها % % PageV01P917 11(@)(@@) % ويعد من ' آل الجميل ' مناقبا % تهوى النجوم تكون من أعدادها % % PageV01P918 البحر : خفيف تام 1(@)(@@) % يا أبا الفضل كلما قلت شعرا % فيه أودعت من بيانك سحرا % % 2(@)(@@) % وإذا ما بعثت غائص فكر % في بحور القريض أبرزت درا % % 3(@)(@@) % كم تعاطيت غاية جئت فيها % % سابق الحلبتين نظما ونثرا % % 4(@)(@@) % لك حر من النظام رقيق % ورقيق النظام ما كان حرا 
ms268	 % % 5(@)(@@) % إن تصفحته تجد كل شطر % فيه يحوي من المحاسن شطرا % % 6(@)(@@) % لف في نشره بديع القوافي % % ببديع ترويه لفا ونشرا % % 7(@)(@@) % كلم كله سباثك تبر % ما سبكن الأفكار شرواه تبرا % % 8(@)(@@) % صغته باهر المعاني فقلنا % % إن لله في معانيك سرا % % 9(@)(@@) % قد تجلى بدر نظمك عصر % جئت فردا به فناهيك عصرا % % 10(@)(@@) % وهدت قالة القريض نجوم % طلعت في سماء طرسك زهرا % % PageV01P919 11(@)(@@) % ذكرتنا ( ذكرى حبيب ) فقلنا % % إن في هذه القوافي لذكرى % % 12(@)(@@) % وسقتنا ' غيث الوليد ' فقلنا % % أنت بالانسجام يا غيث أحرى % % 13(@)(@@) % وتلت ' معجزا لأحمد ' يدعو % % من وعاه : آمنت سرا وجهرا % % 14(@)(@@) % فاجتنينا للأنس زهرة روض % واجتلينا كالشمس عذراء بكرا % % 15(@)(@@) % ينثني العقل حين تتلى كأن ال % % لفظ كأس والسمع يرتاح سكرا % % 16(@)(@@) % فأرى ' الخضر ' أنت لكن لديه(@)(@@) % عين ماء الحياة ) تنبع خمرا % % 17(@)(@@) % هي آيات مرسل بالقوافي % % ربها قد أحاط بالنظم خبرا % % 18(@)(@@) % قد قرأنا عزائم الشعر منها % % وسجدنا لله حمدا وشكرا % % PageV01P920 البحر : مجزوء الكامل 1(@)(@@) % أنطقت بارعة يرى % % حتى العدو وفاقها % % 2(@)(@@) % تأبى النزاهة أن يذم % ذوو الكمال نفاقها % % 3(@)(@@) % فهي الهدي لكفؤها % % والصدق كان صداقها % % 4(@)(@@) % عذبت مقالتها فما % % أحلى الغداة مذاقها % % 5(@)(@@) % إني رأيت ' محمدا ' % فضل الأنام وفاقها % % 6(@)(@@) % فات الأفاضل لاحقا % حتى شأى سباقها % % 7(@)(@@) % ورقى معارج ما امتطى % % أحد سواه براقها % % 8(@)(@@) % ما زال يخرق من سما % % وات العلوم طباقها % % 9(@)(@@) % حتى لقد ضربت على % % السبع الطباق رواقها % % 10(@)(@@) % وغدت لخدمة سعده ال % % جوزا تشد نطاقها % % PageV01P921 11(@)(@@) % هذا الذي راقته أبكار % % ر العلاء وراقها % % 12(@)(@@) % بمناقب غر أهل % تها أمن محاقها % % 13(@)(@@) % زهرت سماه الفضل لم % ا زينت آفاقها % % 14(@)(@@) % يا من لحلبة فضله % % أجرى يروم لحاقها % % 15(@)(@@) % قف حيث أنت وخل % محرزة المدى وسباقها % % 16(@)(@@) % قد أحرز الغايات من % % أجرى لهن عتاقها % % 17(@)(@@) % فإليك عن لجج نهي % % ينك أن تخوض عماقها % % 18(@)(@@) % هذي رسائله فقف % % متصفحا أوراقها % % 19(@)(@@) % ترها عقائل فكرة % أخذ النهى ميثاقها % % 20(@)(@@) % وحدائقا فيها المعا % % لي نزهت أحداقها % % PageV01P922 21 
ms269	(@)(@@) % وشدت بها ورق الثنا % % مذ شاهدت إيراقها % % 22(@)(@@) % تلذذ الذوق السليم % % بها عشية ذاقها % % PageV01P923 البحر : خفيف تام 1(@)(@@) % طرح الدهر في حمى المجد رحله % % عند مولى يميره اليوم كله % % 2(@)(@@) % ولدته العلى وآلت بأن لا % % تلد الدهر في بنى الدهر مثله % % 3(@)(@@) % سيف عز لقد تقلده المجد % وبالجود أحسن الفخر صقله % % 4(@)(@@) % ملك تطلع العلى منه بدرا % في عيون الحواسد اشتب شعله % % 5(@)(@@) % أفرشته الخدود منهم ولكن % % حسدت فوقها الكواكب نعله % % 6(@)(@@) % لم يعب من خصاله الغر شيء % غير بشر ينسى به الضيف أهله % % 7(@)(@@) % خفر الناس ذمة الجود لكن % % حسن الفعل قد رعى اليوم أله % % 8(@)(@@) % وحد المدح منه للفضل ربا % والثنا في سواه يحمد عجله % % 9(@)(@@) % درجت في العلى أماجدها الغ % % ر وكانوا شيخ العلاء وكهله % % 10(@)(@@) % ثم أبقت ' محمدا حسن ' الفعل % % على فخرها بها مستدله % % PageV01P924 11(@)(@@) % ولعمري لا يكمل الفخر حتى % % يصف الفرع طيبا لك أصله % % 12(@)(@@) % في لسان الثناء رحلة ندب % كل يوم له إلى الفخر رحله % % 13(@)(@@) % وصف البيد كيف أنضى المطايا % % فطوى رحبها لينشر فضله % % 14(@)(@@) % يا مباري الصبا بصغرى بنان % بالعطايا سماؤها مستهله % % 15(@)(@@) % عجبا يبتغي علاك ابن نقص % ما حوى من خصالك الغر خصله % % 16(@)(@@) % رفعت قدرك المعالي عليه % % فلها أنت عمدة وهو فضله % % 17(@)(@@) % وقواف منظومة لقبوها % % رحلة حط عندها الشعر رحله % % 18(@)(@@) % منك ألفاظها مجاجة مسك % مزجت حلوة بشهدة نحله % % 19(@)(@@) % كم جلت لأمرئ عقيلة معنى % أمهرتها يد التعجب عقله % % 20(@)(@@) % ليت من مقتلي بدت بسواد % في بياض لكن بخط ابن مقله % % PageV01P925 21(@)(@@) % كلمات في وصف حجك جاءت % % كعطاياك في المكارم جزله % % 22(@)(@@) % قد روته لنا فناديت أرخ % % حي حجا يتلو مساع برحله % % PageV01P926 البحر : خفيف تام 1(@)(@@) % هو طرس أم خد عذراء تجلى % % خط فيها الإبداع ما كان أملي % % 2(@)(@@) % وسطور تلألأت أم ثغور % من غوان يبسمن زهوا ودلا % 3(@)(@@) % بل كتاب ( محمد ) جاء فيه % % بلسان الإعجاز في الناس يتلى % % 4(@)(@@) % لا تشبه عقوده بفصول % ناعمات الصبا به تتحلى % % 5 
ms270	(@)(@@) % فمن الدر نظم كل ولكن % % در هذي الفصول أحلى وأعلى % % 6(@)(@@) % إن تصفحته بعقل تجده % % كيف يهدي لمن تفهم عقلا % % 7(@)(@@) % يا صناع اليراع بل يا إمام ال % % حرمين استطل على الناس فضلا % % 8(@)(@@) % إن من بعض ما بنانك خطت % % ه كتابا حوى المحاسن كلا % % 9(@)(@@) % ولدته روية لك يقظى % % إنها لم يلد لها الدهر مثلا % % 10(@)(@@) % غير بدع إذا تحلى به العصر % فأنت السيف الصقيل المحلى % % PageV01P927 11(@)(@@) % بل ذكاء الهدى واقسم حقا % بنهار للفضل منك تجلى % % 12(@)(@@) % إن هذا الكتاب روض فنون % يجتنى مثمرا كنانا ونبلا % % 13(@)(@@) % ظل أوراقه النهى فتصفح % % نا عليها منثور لفظك طلا % 14(@)(@@) % فنظمنا له وقد راق حسنا % عقد مدح وكان للمدح أهلا % % 15(@)(@@) % فشممنا ريحانة النقل منه % % وهجرنا سواه إذ كان بقلا % % PageV01P928 البحر : منسرح 1(@)(@@) % أكرر الطرف لا أرى أبدا % إلا غبيا أنى تلفت % 2(@)(@@) % من كل من ذقنه كعانته % % والفم منه كأنه أست % 3(@)(@@) % ومعجبا كل مشيه مرح % ومترفا كل أكله سحت % PageV01P929 البحر : بسيط تام 1(@)(@@) % وحش من الإنس من يعلق بصحبتهم % % يكن كمستبدل سقما بصحته % % 2(@)(@@) % كأنني بينهم مسك أحاط به % % ريح البطون فأخفى طيب نفحته % % PageV01P930 البحر : خفيف تام 1(@)(@@) % كم تراني أستولد الأوقانا % % فرجا في انتظاره الصبر ماتا % % 2(@)(@@) % وإذا هبت الحظوظ فحظى % % يقطع الليل والنهار سباتا % % PageV01P931 البحر : بسيط تام 1(@)(@@) % إن يبلغنك عن جود امرىء خبر % % فكذب السمع حتى يشهد البصر % 2(@)(@@) % ولا يغرك إن راقت ظواهره % % فرب دوح نضير ما له ثمر % % PageV01P932 البحر : كامل تام 1(@)(@@) % أفلان لا تبغى الثناء فما % % لك في الثنا من نعمة تجزى % % 2(@)(@@) % إن الذي يثني عليك كمن % % دون المهيمن يعبد الرجزا % % PageV01P933 البحر : متقارب تام 1(@)(@@) % فويل القريض لقد أصبحت % به أغبياء الورى تدعي % % 2(@)(@@) % بقية عار دني الهجاء % % ترفع عن قدرها الأوضع % % PageV01P934 البحر : خفيف تام 1(@)(@@) % سعدت من عشية زار فيها % % قمر المجد ربعنا فأضاءا % % 2(@)(@@) % وأظن الرياح قد حسدتنا % % فهي وجدا تنفس الصعداءا % % PageV01P935 البحر : متقارب تام 1(@)(@@) % أهذا نبي الهدى أحمد % وهذا 
ms271	 الذي ضمنا المسجد % 2(@)(@@) % من الدمع محمرة أرضه % % وسقف السماء به أسود % 3(@)(@@) % وجبريل إذ قام ينعي الحسين % % وتبكي الملائك إذ تنشذ % 4(@)(@@) % نعم وأبيك بها أحمد % % وأملاك رب السما تشهد % 5(@)(@@) % فما عذر عينكم في لجمود % % وعين الملائك لا تجمد % % PageV01P936 البحر : خفيف تام 1(@)(@@) % ليت مني نياط قلبي إلى قسطنط % % ين يمتد من أقاصي العراق % % 2(@)(@@) % فيؤدي إليك أضعاف ما أد % يت بالتلغراف من أشواقي % % 3(@)(@@) % أنت بدر العلى فما برحت في % % ك إلينا مضيئة الآفاق % % 4(@)(@@) % فعلى البدر نالنا منك ما ن % % لنا على البعد منك بالإشراق % % PageV01P937 البحر : مجزوء الكامل 1(@)(@@) % قل للنسيم وقد سرى % % سحرا بأنفاس رقيقه % % 2(@)(@@) % يا مشبها عندي ' أبا % % محمود ' في طيب الخليقه % % 3(@)(@@) % أحمل إليه رسالة % % تحكي سجاياه الأنيقه % % 4(@)(@@) % من شيق في لجة الأس % % واق مهجته غريقه % % 5(@)(@@) % ولأنت والبرق أزويا % % عن قلب وامقة خفوقه % % 6(@)(@@) % شوقا لحضرته التي % % كل النفوس لها مشوقه % % 7(@)(@@) % هو فرع أصل قد غدت % % يثرى على الجوزا عروقه % % 8(@)(@@) % من دوحة في ري ماء ال % % مكرمات غدت وريقه % % 9(@)(@@) % يا من تمنى النجم حين % % سما إلى العليا لحوقه % % 10(@)(@@) % من ذا لمجدك يرتقى % % وسواك لم يسلك طيقه % % PageV01P938 11(@)(@@) % إن الكرام هم المجاز % % وأنت للكرم الحقيقة % % PageV01P939 البحر : متقارب تام 1(@)(@@) % سلام برقته قد حكى % % ونفسك رقة أخلاقها % % 2(@)(@@) % حباك به مغرم أحكمت % % مودته صدق ميثاقها % % 3(@)(@@) % ترف بمهجته دائما % إليك نوازع أشواقها % % 4(@)(@@) % رآك تفرعت من دوحة % زكا في العلى طيب أعراقها % % 5(@)(@@) % وأيكة مجدك قد غردت % % حمام الثناء على ساقها % % 6(@)(@@) % وغر مساعيك في المكرمات % % تطول بزينة أعناقها % % 7(@)(@@) % وفخرك لم تحك شمس السما % % سناه بباهر إشراقها % % 8(@)(@@) % فأهدى كأخلاقك الزاهرات % % إليك تحية مشتاقها % % PageV01P940 البحر : سريع 1(@)(@@) % اليوم قد صوت ناعي الهدى اليوم قد صوت ناعي الهدى % % يفصح بالنعي ولا يكنى % % 2(@)(@@) % ينعى قتيل الطف عند ابنه % % المهدي مولى الأنس والجن % % 3(@)(@@) % وقائل ذا السقف ما باله % % أبيض وعهدي فيه كالدجن % % 4(@)(@@) % قلت : رأى المهدي مستشعر ال 
ms272	 % % سواد حزنا باكي الجفن % % 5(@)(@@) % فصار عينا كله للبكا % % فها هو ابيض من الحزن % % PageV01P941 البحر : وافر تام 1(@)(@@) % خذي قلبي إليك فقلبيه % % تري لا موضعا للصبر فيه % % 2(@)(@@) % وهل للصبر منزلة بقلبي % % باسهمها النوائب تدريه % % PageV01P942 
ms273	