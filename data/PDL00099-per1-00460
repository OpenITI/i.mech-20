ms441	 اساس دولت و دینست استوار(@)(@@) 56 گاهش چو عقل در سرگردنکشان مقر %~% گاهش چو روح در تن کند او زان قرار(@)(@@) 57 نبود شگفت اگر ملک‌الموت خوانمش %~% از بسکه‌ هست‌ چون‌ ملک‌الموت جان‌شکار(@)(@@) 58 جز مور جوهرش که به ‌کین اژدها کش است %~% نادیده در زمانه کسی مور مارخوار(@)(@@) 59 ویحک ز چارباغ سپاهان‌ که سعی تو %~% کردش چنان ‌که آیدش از هشت خلد عار(@)(@@) 60 داغ جنان و باغ جنانست ساحتش %~% ز ازهار گونه ‌گونه وز اشجار پر ثمار(@)(@@) 61 باغ زرشک تا تو درویی ز رشک خلد %~% روی از سرشک خونین دارد ز رشک‌وار(@)(@@) 62 خون ‌گردد از زرشک مصفا و خون چرخ %~% در دل ز داغ باغ زرشک تو گشت تار(@)(@@) 63 صدرا خدایگانا ده سال بی‌توام %~% جان بود دردمند و جگرخون و دل‌فکار(@)(@@) 64 منت خدای را که بدیدم به ‌کام دل %~% بازت به صدر قدر ظفرمند و بختیار(@)(@@) 65 تا خاص و عام‌ گاه بلندند و گاه پست %~% تا شیخ و شاب ‌گاه عزیزند و گاه خوار(@)(@@) 66 از چهر نیکخواه تو بادا شکفته‌ گل %~% در چشم بدسگال تو بادا خلیده خار(@)(@@) 67 تا چار ربع شانزدهست و سه ثلث نه %~% تا هفت نصف چاردهست و دو جذر چار(@)(@@) 68 هر کاو که هفت و هشت‌ کند با تو در جهان %~% باکید نه سپهر سه روحش بود دو چار PageV1P229(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بوده جای یک جهان جان این قبای شهریار %~% کآمد اینک زیور اندام صاحب‌اختیار(@)(@@) 2 جسم یک‌برباز اندر یک‌جهان‌جان چون‌کند %~% جز که خواهد یک جهان جان از خدا بهر نثار(@)(@@) 3 بخردان‌ گویند جای جان پاک اندر تنست %~% ورکسی پرسد ز من‌ گویم ندارم استوار(@)(@@) 4 زانکه‌ من تن‌بینم اندر یک‌جهان جان جای‌گیر %~% راستی قول حکیمان را نباشد اعتبار(@)(@@) 5 چشم یک تن روشنی جست ار به بوی پیرهن %~% چشم خلقی ‌گشت روشن زین قبای شهریار(@)(@@) 6 این قبا گویی سپهر چارمین بودست از 
ms442	 آنک %~% بوده در وی آفتاب عالم‌ آرا را قرار(@)(@@) 7 یا بهشت جاودان بودست زیراکاندرو %~% بوده‌ طوبایی‌ که‌ هستش‌ فضل‌ و رحمت ‌برگ‌ و بار(@)(@@) 8 یا نه همچون عرش اعظم جایگاه جبرئیل %~% یا نه همچون قلب عارف مظهر پروردگار(@)(@@) 9 پای تا سر آفرینش را همی ماند ملک %~% وین قبا بودست ملک آفرینش را حصار(@)(@@) 10 آنکه‌گفتی بر تن هستی نمی‌گنجد لباس %~% کاش دیدی این قبا بر جسم شاه‌ کامگار(@)(@@) 11 این قبا را آسمان ابره است و گیتی آستر %~% شهپر جبریل پود و پرتو خورشید تار(@)(@@) 12 کرم هر ابریشمی را هست قوت از برگ توت %~% کرم این اطلس‌کرم پودست و قوتش افتخار(@)(@@) 13 کرم این خارا همانا بوده ‌کرم هفت واد %~% کاردشیر بابکان از هیبتش جستی فرار(@)(@@) 14 مرد نساجی‌که دیبای قبای شاه بافت %~% حور و غلمان هر دو از جنت دویدند آشکار(@)(@@) 15 آن ز بهر پود زلف خویشتن دادش به دست %~% وین برای تار جعد خود نهادش در کنار(@)(@@) 16 پرتوش از فرش هر ساعت تتق بندد به عرش %~% پرتو خواجه است‌ گویی این قبای شاهوار(@)(@@) 17 این قبا را فی‌المثل بندی اگر بر چوب خشک %~% چوب ‌گردد سز و خرم همچو سرو جویبار(@)(@@) 18 دوش‌ گفتم این قبا از شأن ‌گردون برترست %~% جبر محضست ‌اینکه ‌بخشد شه به ‌صاحب ‌اختیار(@)(@@) 19 عقل ‌گفتا اختیار و جبر یکسو نه‌ که هست %~% کمترین سرباز شه سالار چرخ و روزگار(@)(@@) 20 آب شش پیر آمد از سوی امیر ملک جم %~% از قبای پیکر خود شه فزودش اعتبار(@)(@@) 21 این قبا گویی بود تشریف عمر جاودان %~% کز پی آب بقا بگرفت خضر ازکردگار(@)(@@) 22 چون قبا قلب بقا آمد پس این آب بقاست %~% زان‌که بهر آب بخشیدش خدیو نامدار(@)(@@) 23 گر به قدر آنکه آب آورد یابد آبرو %~% آبرو جایی نماند بلکه در رخسار یار(@)(@@) 24 پارسایان نیز می‌ترسم‌که تردامن شوند %~% زان همه آبی‌ که جاری‌ کرده است 
ms443	 از هر کنار(@)(@@) 25 فضل شاه و التفات خواجه از وی نگسلد %~% چون زگیتی پرتو خورشد و مه لیل و نهار(@)(@@) 26 گه شهش بخشد لباس از جسم جان بخشای خویش %~% گه نشان‌گوهرآگین‌گاه تیغ شاهوار(@)(@@) 27 گاه بخشد خواجه اعظم مر او را خاتمی %~% کش توانم خواند از مهر سلیمان یادگار(@)(@@) 28 تا به ‌گیتی فضل یزدان را نیارد کس شمرد %~% باد همچون فضل یزدان عمر خسرو بیشمار PageV1P230(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بوی مشک آید چو بویم آن دو زلف مشکبار %~% من به قربان سر زلفی‌ که آرد مشک‌بار(@)(@@) 2 عید قربانست و ناچارم‌ که جان قربان ‌کنم %~% گر ز بهر عید قربانی ز من خواهد نگار(@)(@@) 3 هرکه را سیمست قربانی نماید بهر عید %~% من که بی‌سیمم نمایم عید را قربان یار(@)(@@) 4 یک جهان حسنست آن مه لاجرم دارم یقین %~% کاوکنار از من چوگیرد از جهان‌گیرم‌کنار(@)(@@) 5 سرو خیزد ازکنار جوی و هر ساعت مرا %~% از غم آن سرو قامت جوی خیزد از کنار(@)(@@) 6 روی‌او نورست‌و خویش‌نار و من‌زان نار و نور %~% گه فروزم همچو نور وگاه تنورم همچو نار(@)(@@) 7 خط‌ او مورست ‌و مویش ‌مار و من ‌زان‌ مار و مور %~% گه‌بدن‌کاهم چو مور و گه به‌خود پیچم چو مار(@)(@@) 8 خار خار مار تار زلف او دارم به دل %~% بختم از آن خار زار و در دلم زان مار بار(@)(@@) 9 تار زلفش زاده‌الله دام مکرست و فریب %~% ترک‌ چشمش ‌صابه ‌الله مست ‌خوابست و خمار(@)(@@) 10 بر رخش گر سجده آرد زلف بس نبود عجب %~% سجده ‌بر خورشید کردن ‌هست‌ هندو را شعار(@)(@@) 11 هست‌رومی‌روی ‌و زنگی‌موی ‌از آن‌ رو هر نفس %~% یا خیال روم دارم یا هوای زنگبار(@)(@@) 12 بر دو مار زلف او عاشق شدم غافل ازین %~% کان دو مار از جان من روزی برانگیزد دمار(@)(@@) 13 تا به ‌کی قاآنی از عشق بتان ‌گویی سخن %~% هرچه بت در سینه داری بشکن 
ms444	 ابراهیم‌وار(@)(@@) 14 دست زن بر دامن آل پیمبر تا تو را %~% در کنار رحمت خود پرورد پروردگار(@)(@@) 15 معرفت‌آموز تا ناجی شوی در راه عشق %~% ورنه ندهد سود اگر حاجی شوی هفتاد بار(@)(@@) 16 در طواف‌کعبه دل‌کوش اگر جویی نجات %~% کز طواف کعبه گل برنیاید هیچ‌کار(@)(@@) 17 صدر و قدر ار خواهی اندر راستی‌کوش آنچنان %~% کاعتمادالدوله گشت از راستی صدرکبار(@)(@@) 18 بدر عالم صدر اعظم غوث ملت غیث ملک %~% فخر دنیا ذخر دین‌ کان‌ کرم‌ کوه وقار(@)(@@) 19 هم به جسم ملک عدلش را خواص عافیت %~% هم به چشم فتنه پاسش را مزاج ‌کوکنار(@)(@@) 20 روز مهر او ز صحرا عنبرین خیزد نسیم %~% گاه خشم او ز دریا آتشین جوشد بخار(@)(@@) 21 چون قضای آسمانی حکم اوبی‌بازگشت %~% چون نعیم ناگهانی جود او بی‌انتظار(@)(@@) 22 صعوه او باز صید و پشه او فیل‌ کش %~% روبه او شیرگیر و کبک او شاهین‌شکار(@)(@@) 23 حمله آرد شیر شادروان او بر خصم او %~% راست پنداری روان دارد چو شیر مرغزار(@)(@@) 24 قدرش از رفعت چو اوج چرخ ناید در نظر %~% جودش ازکثرت چو موج بحر ناید در شمار(@)(@@) 25 ای میان خلق عالم در سرافرازی علم %~% چون میان سبزه‌زاران قد سرو جویبار(@)(@@) 26 مدح اندر گوش سامع بانگ وحی جبرئیل %~% جودت اندر طبع سائل فیض ابر نوبهار(@)(@@) 27 تا نجنبد محور کلکت نجنبد آسمان %~% تا نگردد توسن عزمت نگردد روزگار(@)(@@) 28 آفرینش را مرادی جز تو اندر دل نبود %~% فضل یزدان بر مراد دل نمودش کامگار(@)(@@) 29 امر تو چون نور بی‌رنج قدم آفاق‌گرد %~% حکم تو چون وهم بی‌طی زمین‌ گیهان‌سپار(@)(@@) 30 با سوم سطوتت حظل چکد از نوش نحل %~% با نسیم رحمتت سبل دمد از نیش خار(@)(@@) 31 آب‌و آتش را بهم دادست عدلت دوستی %~% خواهی ار برهان قاطع نک حسام شهریار(@)(@@) 32 تا نگوی کار خصمت از شرف بالا گرفت %~% مشت‌ خاکی‌ هست از آن‌ بالا رود همچون غبار(@)(@@) 33 بر سر 
ms445	 پیکان چوبی نام عزمت‌گر دمند %~% نوک آن پیکان ‌کند از صخره صماگذار(@)(@@) 34 بر فراز موج دریا نقش حزمت‌گرکشند %~% موج دریا جاودان چون‌ کوه ماند استوار(@)(@@) 35 افتخار عالمی ‌گر چه درون عالمی %~% چون روان در پیکر و دانش به مغز هوشار(@)(@@) 36 نوک‌کلکت آن‌کند با چشم بدخواهان‌که‌کرد %~% نوک تیر تهمتن با دیده اسفندیار(@)(@@) 37 دین و دولت را نشاید فرق‌کرد از یکدگر %~% بسکه‌بیوستست‌از عدلت‌به‌هم‌چون پود و تار(@)(@@) 38 گرچه یکسر اختیار کارها با رای تست %~% در ولای شاه و در بخشش نداری اختیار(@)(@@) 39 ورچه سررشه قرار عالمی در دست تست %~% سیم و زر در دست فیاضت نمی‌گیرد قرار(@)(@@) 40 تا جهان را اعتبار از گوهر مسعود تست %~% خواند نتواند جهان را هیچ‌کس بی‌اعتبار(@)(@@) 41 تا که مغناطیس را میلیست پنهانی به طبع %~% کز یمین قطب ‌گه مایل شود گاه از یسار(@)(@@) 42 میل مغناطیس الطافت به هر جانب که هست %~% زایسر و ایمن به هرکس از یمین بخشد یسار(@)(@@) 43 تا به محشر باد هر امروز تو بهتر زدی %~% تا قیامت باد هر امسال تو خوشتر ز پار PageV1P231(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بهار آمد و دی را گرفت و کرد مهار %~% چنین‌ کنند بزرگان چو کرد باید کار(@)(@@) 2 نمود رنگین شمشیر خود به خون خزان %~% چنین نماید شمشیر خسروان آثار(@)(@@) 3 دو هفته پیشتر از آنکه پادشاه ختن %~% ز برج حوت به‌کاخ حمل‌گشاید بار(@)(@@) 4 بهار را که بدو پشت عشرتست قوی %~% بخواند و گفت که ای جیش عیش را سالار(@)(@@) 5 شنیده‌یی به ‌گلستان چه ظلم‌ کرده خزان %~% که شاخ شو‌کت او خشک ‌باد و زرد و نزار(@)(@@) 6 کفیده حنجر بلبل دریده معجر گل %~% گسسته طره سنبل شکسته پشت چنار(@)(@@) 7 ردای سبزه ربودست و گوشوار سمن %~% ازار لاله دریدست و طیلسان بهار(@)(@@) 8 ربوده‌است و گرفتست‌ و برده‌است ‌به عنف %~% ز لاله تاج و زگل یاره از سمن دستار(@)(@@) 9 ز فرق غنچه درافکنده بسدین 
ms446	 مغفر %~% ز ساق سبزه برون‌ کرده زمردین شلوار(@)(@@) 10 دهان‌ کبک‌ گرفتست تا نخندد خوش %~% گلوی ابر گشادست تا بگرید زار(@)(@@) 11 بهار خورد به اقبال پادشا سوگند %~% که من سپاه خزان را برافکنم ز دیار(@)(@@) 12 سپه‌ کشم ز ریاحین و سازم از پی جنگ %~% هرآن سیلح‌که باید نبرد را ناچار(@)(@@) 13 کمان ز قوس قزح سازم و تبیره ز رعد %~% درفش ازگل سوری طلایه از انهار(@)(@@) 14 ز ابر رانم جمازهای آتش سیر %~% ز برق سازم زنبورهای آتشبار(@)(@@) 15 پیادگان ز ریاحین برم گروه گروه %~% سوارگان ز درختان ‌کشم قطار قطار(@)(@@) 16 قلاوزان ز غزالان و رهبران ز نسیم %~% منادیان ز تذروان و چاوشان ز هزار(@)(@@) 17 یزک ز باد بهاران قراول از باران %~% علم ز برگ شقایق جنیبت از اشجار(@)(@@) 18 سنان ز لاله‌ کمند از بنفشه خود از گل %~% زره ز سبزه تبرزین ز غنچه تیر از خار(@)(@@) 19 بگفت این و به تعجیل نامه‌یی به خزان %~% نوشت پر شغب و شعور و فتنه و پیکار(@)(@@) 20 که ای خزان به تو اتر خبر دهند که تو %~% به ملک مادر طغیان زدی به سنت پار(@)(@@) 21 شدم حمول و گزیدم خمول بو که ز شرم %~% بسا تحمل بیجا که خواری آرد بار(@)(@@) 22 به ‌گوشمال تو اینک دو اسبه آمده‌ام %~% یکی بمان ‌که برآرم ز لشکر تو دمار(@)(@@) 23 خزان‌ چو نامه فرو خواند با حواشی خویش %~% چه ‌گفت ‌گفت ‌که باید فرار جست فرار(@)(@@) 24 برید باد صبا در میانه بود و شنید %~% دوان دوان همه جا ره برید تا کهسار(@)(@@) 25 به ابرگفت چه غافل نشسته‌ای‌که خزان %~% گریخت خواهد و فردا بپرسد از تو بهار(@)(@@) 26 ز کوه ابر فرود آمد و بلارک برف %~% کشید و خون خزان را بریخت درگلزار(@)(@@) 27 هنوز ازو رمقی مانده بود کز در باغ %~% بهار آمد و دی را گرفت و کرد مهار(@)(@@) 28 بدین بهانه هم از 
ms447	 ابر ترجمان بگرفت %~% که از چه‌ کشتش‌ و ناورد زنده در صف بار(@)(@@) 29 نداده ابر مگر ترجمان هنوزکه رعد %~% به تازیانه قهرش همی کند آزار(@)(@@) 30 گمان برم گه بخیلست ابر زانکه همی %~% به تازیانه جواهر همی‌کند ایثار(@)(@@) 31 جواهری‌که بباید به تازیانه‌گرفت %~% به‌راستی‌ که من از آن جواهرم بیزار(@)(@@) 32 جواهر ازکف صدر زمانه خواهم و بس %~% که تازیانه به سائل زندکه می‌بردار(@)(@@) 33 امان ملک امین ملک جهان‌ کرم %~% سحاب جود محیط شرف سپهر وقار(@)(@@) 34 نگین خاتم اقبال حاجی آقاسی %~% که هست حامی دین محمد مختار(@)(@@) 35 وجود بی‌مدد جود او رهین عدم %~% حیات بی‌اثر ذات او قرین بوار(@)(@@) 36 سرود مدحت او مرده را کند زنده %~% نشاط خدمت او خفته را کند بیدار(@)(@@) 37 به صرصر ار نگرد حزم او شود ساکن %~% به ثابت ارگذرد عزم او شود سیار(@)(@@) 38 زهی دریچه طبع تو مخزن الایات %~% زهی نتیجه فکر تو مطلع الانوار(@)(@@) 39 به مهر دوست‌نوازی به قهر خصم‌گداز %~% به عزم ‌ملک‌ستانی به جود ملک‌سپار(@)(@@) 40 شرف ز خلق تو زاید چو از شر‌اب سرور %~% کرم ز طبع تو خیزد چو از بحار بخار(@)(@@) 41 بهثت بزم ترا نانبشه ظل و حرور %~% جهان جاه ترا ناسپرده لیل و نهار(@)(@@) 42 به خاکپای تو خوردت روزگار یمین %~% ز فیض دست تو بردست کاینات یسار(@)(@@) 43 چو با رضای تو از مرگ‌ کس نیارد ننگ %~% چو با ولای تو از نار کس ندارد عار(@)(@@) 44 نهال قدر ترا جود بار و همت برگ %~% نسیج بخت ترا مجد پود و شوکت تار(@)(@@) 45 قرار یافته هر چیز در زمانه تو %~% بغیر مال‌کش اندرکف تو نیست قرار(@)(@@) 46 کسی‌که شخص تو بیند‌ گمان برد که خدای %~% به‌گرد عرصه هستی‌کشیده است حصار(@)(@@) 47 تنی ‌که ‌کاخ تو یابد یقین‌ کنند که قضا %~% بنا فکنده بر اطراف آسمان دیوار(@)(@@) 48 برون ز جاه تو جایی خرد نداده نشان %~% فزون ز قدر 
ms448	 تو نقشی قضا نبرده به‌کار(@)(@@) 49 معاند تو ز نفرت به خود کند نفرین %~% مخالف تو ز دهشت ز خود بود بیزار(@)(@@) 50 جهان جاه ترا ناممهدست ‌کران %~% محیط جود ترا نامعینست‌کنار(@)(@@) 51 کفایت تو دهد نظم ملک و رونق دین %~% کفالت تو نهد رزق مورو روزی مار(@)(@@) 52 به وقت خشم تو از آب می‌نخیزد نم %~% به روز مهر تو از سنگ می‌نزاید نار(@)(@@) 53 تو عین عدلی آخر چه خواهی از درهم %~% تو محض فضلی آخر چه جویی از دینار(@)(@@) 54 کسی معاند خود را چنان نسازد پست %~% کسی مخالف خود را چنین‌ نخواهد خوار(@)(@@) 55 گر آن نمود گناهی بدین غلام ببخش %~% ور این نموده خطایی بدین رهی بسپار(@)(@@) 56 تبارک الله ازان‌ کلک ملک‌پرور تو %~% که دایمش کف جود تو پرورد به کنار(@)(@@) 57 برید عقل و رسول کمال و پیک هنر %~% عمود دین و عماد جهان و اصل فخار(@)(@@) 58 ستون امن و کلید امان و رایت عدل %~% منار فصل و ترازوی جود وکان یسار(@)(@@) 59 نهال فکرت و بیخ سخا و شاخ و کرم %~% سحاب حکمت و بحر عطا وگنج نثار(@)(@@) 60 دماغ ناطقه پستان فضل دایه فیض %~% امین حافظه دستور فهم‌کهف‌کبار(@)(@@) 61 همای خوانمش ار خود همای را باشد %~% کمال بال و خرد مخلب و هنر منقار(@)(@@) 62 زمانه‌ایست‌که او را به حکم تست مسیر %~% ستارهست‌که او را به دست تست مدار(@)(@@) 63 گهی به صفحه‌کافور برفشاند مشک %~% گهی به توده سیماب درنشاند قار(@)(@@) 64 ظفر درو متهاجم‌کرم درو مملو %~% خرد درو متراکم هنر درو انبار(@)(@@) 65 مثل بودکه نگوید سر بریده سخن %~% بریده سر ز چه آید هماره درگفتار(@)(@@) 66 سرش به ‌عذر خوشی ررند و طرفه ‌تز آنک %~% ز بیم ‌گفتن خواهد سر از زبان زنهار(@)(@@) 67 بزرگوارا از دوری تو بر تن من %~% شدست هر سر مو اژدهای جان اوبار(@)(@@) 68 جدایی توگناهی عظیم بود و مرا %~% از آن‌گناه همی‌کرد 
ms449	 باید استغفار(@)(@@) 69 ولی به جاه تو سوگندکزکمال خلوص %~% محامد تو شب و روزکرده‌ام تکرار(@)(@@) 70 زمان عمر تو باد از شمار و حصر برون %~% چنانکه جود ترا نیست در زمانه شمار PageV1P232(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا چه معجز کرده امشب باز عدل شهریار %~% کاتش سوزنده با آب روان گشتست یار(@)(@@) 2 آب و آتش بسکه از عدلش بهم آمیختند %~% کس ترشح را نیارد فرق‌کردن از شرار(@)(@@) 3 از چراغان خاک پنداری سپهری دیگرست %~% یا فلک پروین و مه راکرده برگیتی نثار(@)(@@) 4 حزم صاحب اختیاری بین ‌که از عزم ملک %~% آب و آتش را بهم‌کردست امشب سازگار(@)(@@) 5 اختیار از جبر خیزد ور همی خواهی دلیل %~% حال میر ملک جم بنگر به چشم اعتبار(@)(@@) 6 تا نشد مجبول و مجبورش روان از مهر شه %~% شاه دریادل نکردش نام صاحب‌اختیار(@)(@@) 7 آب ششپیر آمد این آتش ازان افروخت میر %~% تا میان آب و آتش هم نماند گیرودار(@)(@@) 8 یا نه چون آن آب از دیر آمدن دلگیر بود %~% خواست دلگرمش‌کند زالطاف شاه بختیار(@)(@@) 9 راست ‌گویم معجز حزم شهنشاهست و بس %~% کاتش سوزنده را زاب روان سازد حصار(@)(@@) 10 سرخ‌رو گشت‌آب‌ششپیر امشب‌از بخت‌ملک %~% زانکه از دیر آمدن شرمنده بود و خاکسار(@)(@@) 11 یا نه باز از هجر خاکپای شه شرمنده است %~% زان‌رخش سرخست زآتش‌همچو روی‌شرمسار(@)(@@) 12 آتش اندر ابر می‌بارند امشب یا به طبع %~% آتش سوزنده همچون تیغ شه شد آبدار(@)(@@) 13 یا خیال تیغ شه اندر دل آتش‌گذشت %~% پای تا سر آب شد از شرم تیغ شهریار(@)(@@) 14 یا چو مهر و کین شه خلاق آب و آتشند %~% مهر و کین شه بهم‌ گشتند امشب سازگار(@)(@@) 15 راست‌ گویی آتشین گلها درون موج آب %~% هست‌چون‌عکس‌می گلگون‌ به ‌سیمین‌چهریار(@)(@@) 16 یا نشان آتش موسی است اندر آب خضر %~% یا نه شاخ ارغوان رستست زآب جویبار(@)(@@) 17 یا میان حقه الماس یاقوت مذاب %~% یا درون بوته سیماب زر خوش‌عیار(@)(@@) 18 آب امشب 
ms450	 شعله‌انگیزست و آتش رشحه‌ریز %~% عدل شه را بین‌ کزو شد نار آب و آب نار(@)(@@) 19 دود آتش پیچد اندر آب‌گویی در نهفت %~% لشکر دیو و پری دارند با هم‌کارزار(@)(@@) 20 وادی طورست ‌گویی باغ تخت امشب از آنک %~% آتشی موسی شدست از هر درختی آشکار(@)(@@) 21 مارهای آتشین بنگر شتابان در هوا %~% با وجود اینکه از آتش‌گریزانست مار(@)(@@) 22 در به باغ تخت از بس آتش افتد لخت لخت %~% سبزه‌هایش را چو برگ لاله بینی داغدار(@)(@@) 23 راست‌گویی‌ باغ را صد داغ حسرت بر دلست %~% از فراق طلعت میمون شاه‌ کامگار(@)(@@) 24 بسکه اخترها ز اخگرها همی ریزد در آب %~% از شمار اختران عاجز بود اخترشمار(@)(@@) 25 بس که تیر آتشین در باغ آید از هوا %~% خشم شه ‌گویی درون خلق شه دارد قرار(@)(@@) 26 یا نه‌گویی باژگون‌ گشتست دوزخ در بهبشت %~% تا عیان‌گردد به مردم قدرت پروردگار(@)(@@) 27 تیر تخش اندر هوا ماند به سروی بارور %~% کز شعاعش ‌هست ‌برگ ‌و از شر‌ارش هست بار(@)(@@) 28 یا پی رجم شیاطین از سپهر آید شهاب %~% کیست می‌دانی شیاطین خصم شاه نامدار(@)(@@) 29 ای‌ که دیدستی بسی فوارهای موج‌خیز %~% اینک اندر آب بین فوارهای شعله‌بار(@)(@@) 30 از چنارکهای آتش دیدم امشب آنچه را %~% می‌شنیدم‌کاتش سوزنده خیزد از چنار(@)(@@) 31 آب ز آتش رنگ خون دارد تو گویی آب نیل %~% بر گروه قبطیان خون شد به امر کردگار(@)(@@) 32 شاه آری موسی است و آب ششپیر آب نیل %~% سبطی احباب ملک قبطی عدوی نابکار(@)(@@) 33 سبطیان را بهره از آن نهر آب روح‌بخش %~% قبطیان را قسمت از آن رود خون ناگوار PageV1P233(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تبارک‌الله از فارس آن خجسته دیار %~% که می‌نبیند چون آن دیار یک دیار(@)(@@) 2 به زیر بقعه‌ گردون به روی رقعه خاک %~% ندیده دیده بینا چنان خجسته دیار(@)(@@) 3 کسی ندیده در آفاق اینچنین معمور %~% به هیچ عصری از اعصار مصری از امصار(@)(@@) 4 نسیم او همه 
