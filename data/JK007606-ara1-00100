ms81	 % % 6(@)(@@) % فزار من الديرين إلفا ومألفا % و جاد على النهرين عهدا ومعهدا % % 7(@)(@@) % مراقد من بسط الرياضإذا اكتفى % % بهن صريع الراح لم ينب مرقدا % % 8(@)(@@) % و ليل كأن الترب تحت رواقه % % مندى بماء الورد ما باشر الندى % % 9(@)(@@) % تعانقنا فيه الرياح مريضة % كأنا لقيناها مع الصبح عودا % % 10(@)(@@) % أرتنا الليالي قصدها دون جورها % % و شأن الليالي أن تجور وتقصدا % % PageV01P291 11(@)(@@) % و من عجب أن الغبيين أبرقا % % مغيرين في أقطار شعريو أرعدا % % 12(@)(@@) % فقد نقلاه عن بياض مناسبي % % إلى نسب في الخالدية أسودا % % 13(@)(@@) % و إن عليا بائع الملح بالنوى % % تجرد لي بالسب فيمن تجردا % % 14(@)(@@) % و عندي له لو كان كفء قوارضي % % قوارض ينثرن الدلاص المسردا % % 15(@)(@@) % و مغموسة في الشري والأري هذه % % ليردى بها باغ و تلك لترتدى % % 16(@)(@@) % إذا رام علج الخالدية نيلها % % أخذن بأعنان النجوم وأخلدا % % 17(@)(@@) % لك الويل إن أطلقت بيض سيوفها % % و أطلقتها خزر النواظر شردا % % 18(@)(@@) % و لست لجد القول أهلا فإنما % % أطير سهام الهزل مثنى وموحدا % % 19(@)(@@) % نصبت لفتيان البطالة قبة % ليدخلها الفتيان كهلا وأمردا % % 20(@)(@@) % و كان طريق القصف وعرا عليهم % فسهلته حتى رأوه معبدا % % PageV01P292 21(@)(@@) % و كم لذة لا من فيها ولا أذى % % هديت لها خدن الضلال فأفسدا % % 22(@)(@@) % قصدتهم وزنا فساويت بينهم % % و لم تأخذ السيف الشديد لتقصدا % % 23(@)(@@) % و جئتهم قبل ارتداد جفونهم % % بمائدة تكسى الشرائح والمدى % % 24(@)(@@) % و مبيضة مما قراه محمد % أبوك لكي تبيض عرضا ومحتدا % % 25(@)(@@) % نثرت عليها البقل غضا كأنما % % نثرت على حر اللجين الزبرجدا % % 26(@)(@@) % و مصبوغة بالزعفران عريضة % كأن على أعضائها منه مجسدا % % 27(@)(@@) % ترقبها الصياد يوما فقادها % % كما قدت بالرفق الجواد المقيدا % % 28(@)(@@) % و لم يدر إذ أنجى لها بردائه % % أكان ردا ما ارتد منه أم ردى % % 29(@)(@@) % تريكو قد علت بياضا بصفرة % مثالا من الكافور ألبس عسجدا % % 30(@)(@@) % يحف بها منهم كهول وفتية % كأنهم عقد يحف مقلدا % % PageV01P293 31(@)(@@) % فلا نظر الداعي إلى الزاد كفهم % % و لا خجلة المدعو ردت لهم يدا 
ms82	 % % 32(@)(@@) % و ملت بهم من غير فضل عليهم % إلى الورد غضا والشراب موردا % % 33(@)(@@) % فيا لك يوما ما أخف مؤونة % و أعذب في تلك النفوس وأرغدا % % 34(@)(@@) % مناهدة إن بات مثلك طيها % % تنفس مجروح الحشاأو تنهدا % % 35(@)(@@) % فلا عدم الفتيان منك قرارة % أيسلهم سعدا علي مسعدا % % 36(@)(@@) % معدا لهم في كل يوم مجود % من الراح والريحانعيشا مجددا % % 37(@)(@@) % إذا وصلوا أضحى الخوان مدبجا % و إن وصلوا أمسى الخوان مجردا % % 38(@)(@@) % و إن شرعوا في لذة كنت بيعة ؛ % و إن طعموا في مرفق كنت مسجدا % % 39(@)(@@) % لك القبة العلياء أوضحت فتقها % % و أطلعت منها للفتوة فرقدا % % 40(@)(@@) % يصادف فيها الزور جديا مبرزا % و باطية ملأى و ظبيا مغردا % % PageV01P294 41(@)(@@) % و قد فضلت بيض القباب لأنني % % نصبت عليها بالقصائد مطردا % % PageV01P295 البحر : - 1(@)(@@) % إسمع مقالا من أخ ذي ود % و ذاك أني كنت حلف وجد % 2(@)(@@) % بشادن في كل حسن فرد % مليح وجه ورشيق قد % 3(@)(@@) % كبدر تم في قضيب رند % فزارني الآن بغير وعد % 4(@)(@@) % جاء مفاجأةو ليس عندي % % إلا طعام غير مستعد % 5(@)(@@) % دجاجة في شبه السمند % تليدة و فخرها بالهند % 6(@)(@@) % عظيمة الزور بصدر نهد % أجريت منها في مجال العقد % 7(@)(@@) % مرهفة ذات شبا وحد % لغير ما ذحل وغير حقد % 8(@)(@@) % بل رغبة فيها شيبة الزهد % و لم تزل بالماء كف العبد % 9(@)(@@) % و فصلت أعضاؤها من بعد % مع لب أترج كلون الشهد % 10(@)(@@) % بل طعمه عن طعمه ذو بعد % حتى إذا أسعرها بالوقد % PageV01P296 11(@)(@@) % صب عليها اللوز مثل الزبد % و غليت بعد بماء الورد % 12(@)(@@) % ثم أتى يسعى بها كالمهدي % % كأنها قد بخرت بالند % PageV01P297 البحر : - 1(@)(@@) % أعاذلإن النائبات بمرصد % و إن سرور المرء غير مخلد % 2(@)(@@) % إذا ما مضى يوم من العيش % فصله بيوم صالح العيشمرغد % 3(@)(@@) % و حالية من حسنها وجمالها % % و إن برزت عطل الشوى والمقلد % 4(@)(@@) % تعاطيك كأسا غير ملأى كأنما % % فواقعها أحداق درع مزرد % 5(@)(@@) % كأن أعاليها بياض سوالف % تلوح على توريد جيب مورد % PageV01P298 البحر 
ms83	 : - 1(@)(@@) % و ابنة بر لم تبن عن زهد % أضحى بها البحر قريب العهد % 2(@)(@@) % تعافهو هو زلال الورد % فليس تحبوه بصفو الود % 3(@)(@@) % إلا بربط عنده وشد % لما نضت ملاحف الإفرند % 4(@)(@@) % و اتشحت من الدجى ببرد % توسطت سكر صفيح صلد % 5(@)(@@) % و أشبهت واسطة في عقد % مطلة على ركاب الوفد % 6(@)(@@) % كأنها أم النعام الربد % عجاجها شيب فود المرد % 7(@)(@@) % واجدة بالبر أي وجد % تذكرت طيب ثراه الجعد % 8(@)(@@) % أيام تغذى بجنى كالشهد % و لمع برق وحنين رعد % 9(@)(@@) % فهي تعيد أنة وتبدي % % كما يئن موثق في القيد % 10(@)(@@) % لولا امتداد الطنب الممتد % لشمرت تشمير ذات الجد % PageV01P299 11(@)(@@) % فصافحت خد الثرى بخد % % PageV01P300 البحر : - 1(@)(@@) % رب أيام على القفص لنا % % لا نرى أمثالها طول الأبد % 2(@)(@@) % غضة ريحاننا الغض بها % % أسد من غابة الورد ورد % 3(@)(@@) % ما رأى الناس شروبا مثلنا % % شربوا الراح على وجه الأسد % PageV01P301 البحر : - 1(@)(@@) % و بكر شربناها على الورد بكرة % فكانت لنا وردا إلى ضحوة الغد % 2(@)(@@) % إذا قام مبيض اللباس يديرها % % توهمته يسعى بكم مورد % PageV01P302 البحر : - 1(@)(@@) % أمير الندى إن الثناء خلود ؛ % و إن القوافي السائرات جنود % 2(@)(@@) % إذا انفض من حول الملوك عديدها % % فحولك منها عدة وعديد % 3(@)(@@) % فهنإذا ناضلن عنك صوارم ؛ % و هنإذا لاحت عليك عقود % 4(@)(@@) % و لي من ندى كفيك رسم تضاءلت % معالمهحتى تكاد تبيد % 5(@)(@@) % غدا خلقا و الحمد فيه مجدد % و منتقصا و الشكر فيه يزيد % 6(@)(@@) % فلا يك رسمي من نوالك دارسا % فرسمك غض من ثناي جديد % PageV01P303 البحر : - 1(@)(@@) % قد وفت المزن بميعادها % % و خصت الروض بإسعادها % % 2(@)(@@) % و أخمدت شعلة إبراقها % % و سكنت ضجة إرعادها % % 3(@)(@@) % و أضحت الأغصان قد نظمت % % غرائب الحلي بأجيادها % % 4(@)(@@) % و أوجه الأيام مبيضة % تخبر عن رقة أكبادها % % 5(@)(@@) % و العيش في طيب أثانينها % % إذا تفكرت وآحادها % % 6(@)(@@) % و قد صفت بالزهر المجتلى % % موارد الراح لورادها % % 7(@)(@@) % فزر بنا سوداء مصفودة % في غمرة الماء بأصفادها % % 8(@)(@@) % كأنها زنجية واصلت % حنينها من ضيق 
ms84	 أقيادها % % 9(@)(@@) % إذا نضى الصبح سواد الدجى % % لم ينض عنها سود أبرادها % % 10(@)(@@) % طريق من خاف لها لجة % يقطع في أحشاء أولادها % % PageV01P304 البحر : - 1(@)(@@) % ينافسني في الشعرو الشعر كاسد % حسود كبا عن غايتيو معاند % 2(@)(@@) % و كل غبي لو يباشر برده % لظى النار أضحى حرهاو هو بارد % 3(@)(@@) % إذا سئلوا عما يلوح تبلدوا % % كأنهم عند السؤال جلامد % 4(@)(@@) % قيام يهزون النسوعكأنما % % بأيديهم حيات رمل أساود % 5(@)(@@) % يموت ذكاء الطفل ما دام عندهم % و كيف صلاح الفرع والأصل فاسد % 6(@)(@@) % أفيقوا فلن يعطى القريض معلم % و هل يتولى الأغبياء عطارد % 7(@)(@@) % فلا تمنحوا منه الكرام قلائدا % فليس من الحصباء تهدى القلائد % PageV01P305 البحر : - 1(@)(@@) % يا دهرصافيت اللئام مساعدا % % لهمو جانبت الكرام معاندا % % 2(@)(@@) % فغدوت كالميزان يرفع ناقصا % فيناو يخفضلا محالةزائدا % % PageV01P306 البحر : - 1(@)(@@) % أقول لحنان العشي المغرد % يهز صفيح البارق المتوقد % 2(@)(@@) % تبسم عن ري البلاد حبيه % % و لم يبتسم إلا لإنجاز موعد % 3(@)(@@) % على الشرف المعمور بالعمرفالربا % % فتلك الثنايافالطريق المعبد % 4(@)(@@) % فسود الليالي من بنية جعفر % فدمنة آثار الخليفة أحمد % 5(@)(@@) % بصفحة مصقول الأديمكأنما % % سفائنه ربد النعام المشرد % 6(@)(@@) % شوائل أذناب يخيل أنها % % عقارب دبت فوق صرح ممرد % 7(@)(@@) % فمشهد عمرو حيث يلعن ظالم % و تبكي على المظلوم آل محمد % 8(@)(@@) % محل الهوى العذري في غير حلة % و عهد الشباب الغض في غير معهد % 9(@)(@@) % مضت نومة التعريس في ظل أمنه % و أعقبها ليل السليم المسهد % 10(@)(@@) % أمج له العذب النميركأنه % % مجاجة محمر الحماليق أسود % PageV01P307 11(@)(@@) % و لا وصل إلا أن أروح مغررا % بأدهم في تيار أخضر مزبد % 12(@)(@@) % إذا ما أهل الركب فيه جرى لهم % % على سنن كالمشرفي المجرد % 13(@)(@@) % إذا ما ارتدى الليل البهيمفإنني % % بليلين منه والدجنة مرتدي % % 14(@)(@@) % أرى بلدا يشكو من الماء مثل ما % % شكا الغمد من حد الحسام المهند % 15(@)(@@) % تحيف غربي القصور كأنما % % رمين على الأيام منه بمبرد % 16(@)(@@) % مكفرة الجدران للمد لا تني % % تخر عليه من ركوع وسجد % 17(@)(@@) % و عهدي بها مثل الفراقد تنتضى 
ms85	 % % ذوائبها ما بين نسر وفرقد % 18(@)(@@) % بقية أبشار البناء كأنما % % تصوغ لها الآصال تيجان عسجد % 19(@)(@@) % فيا سطوة الأيام عودي لسلمها % % كما كنت قبل اليوم مغلولة اليد % 20(@)(@@) % و يا جانبيها بالمناخ سقيتما % % بأعذب مما يسقيان وأبرد % PageV01P308 21(@)(@@) % و يا ديرها الشرقي لازال رائح % يحل عقود المزن فيك ويغتدي % % 22(@)(@@) % موارد لهو صفقت في ظلالها % % موارد من ماء الكروم مورد % 23(@)(@@) % عليلة أنفاس الرياحكأنما % % يعل بماء الورد نرجسها الندي % % 24(@)(@@) % يشق جيوب الورد في شجراتها % % نسيم متى ينظر إلى الماء يبرد % 25(@)(@@) % و ملعب إفرندية الروض يعتلي % % عليه خلوقي البناء المشيد % 26(@)(@@) % صوامع في سرو أناف كأنها % % قباب عقيق في قباب زبرجد % PageV01P309 البحر : - 1(@)(@@) % أجر المدام على نجح المواعيد % و جد علي بريا النحر والجيد % 2(@)(@@) % فقد تنبه من إغفائه زهر % كأن رياه ريا المسك والعود % 3(@)(@@) % و شرد الصبح عنا الليلفاتضحت % سطوره البيض في راياته السود % 4(@)(@@) % و لاح للعين نارنج كما اختضبت % بالزعفران ثدي النهد الغيد % PageV01P310 البحر : - 1(@)(@@) % دونكها نرجسية الجسد % على أفانين مسمع غرد % 2(@)(@@) % فقد حلا النرجس الجني لنا % % عن عيشة في قدومهرغد % 3(@)(@@) % يجمع ضدين قل ما اجتمعا % % من لهب ساطع ومن برد % 4(@)(@@) % فهو كشهل العيونمن كثب % و هو كزهر النجوم من بعد % 5(@)(@@) % أظن نجل العيون تحسده % % فهي مراض من شدة الحسد % 6(@)(@@) % قد قلتإذ أنجد الزمان به % % كتائب اللهوغير متئد % 7(@)(@@) % أهلا بما أمرض العيونفما % % تفرق من دائها مدى الأبد % PageV01P311 البحر : - 1(@)(@@) % إزدد من الراح وزد % فالغي في الراح رشد % 2(@)(@@) % يديرها ذو غنة % أغيد يثنيه الغيد % 3(@)(@@) % كأنها في كفه % جمرة نار تتقد % 4(@)(@@) % مد إليها يده % % فالتهبت إلى العضد % 5(@)(@@) % و الجو قد كادت ثري % ياه على الغرب ترد % % 6(@)(@@) % كأنها شابورة % مذهبة من الزرد % PageV01P312 البحر : - 1(@)(@@) % قصد الدهر فيك من بعد جور % و أرى الدهر فيك جورا وقصدا % % 2(@)(@@) % فاسقني كالعروس ألبسها الما % % ء وشاحا من الحباب وعقدا % 3(@)(@@) % قد ظمئنافكان ريقك وردا % و ثملنافكان خدك وردا % 4(@)(@@) % جمع 
ms86	 الله شملنافوددنا % % أن بين الصباح والليل سدا % % PageV01P313 البحر : - 1(@)(@@) % لا سقيت حانة أترجة % غيثا و لا حانة مولودها % % 2(@)(@@) % مخضوبة بالخمر جاءت به % مختضبا من دم عنقودها % % 3(@)(@@) % تعذيبه العشاق تعذيبها % % و وعده نسخة موعودها % % 4(@)(@@) % فبظرهاإذ ولدت مثله % أولى بعقد الدر من جيدها % % 5(@)(@@) % كنت لها صيدا و لكنني % % أفلت من ورطة سفودها % % PageV01P314 البحر : - 1(@)(@@) % و حية في رأسها درة % تسبح في بحر قصير المدى % % 2(@)(@@) % إن هي غابتفالعمى ظاهر % و إن بدت بان طريق الهدى % % PageV01P315 البحر : - 1(@)(@@) % تقربت من هذي القوارب راكبا % وياليتني منهاالغداةبعيد % 2(@)(@@) % فبت أرى جند الحماموليس لي % % إذا اعتزلتإلا الدعاء جنود % 3(@)(@@) % تلاعب بي أمواج بحر كأنها % % شواهق بر تنثني وتميد % 4(@)(@@) % فإن أنقلب منها إلى الأرض واطئا % على الترب يوما إنني لسعيد % PageV01P316 البحر : - 1(@)(@@) % نوائب دهر مكثرات عنادها % % أجاهدها حتى أمل جهادها % % 2(@)(@@) % و ما الدهر إلا عثرة لا أقالها % % و فائدة محمودة لا أفادها % % 3(@)(@@) % و لست أرى أن ابن حسان مخبث % إذا هو أبدى عفة وأعادها % % 4(@)(@@) % أخو الظلم يخفي كيده بسكونه % كذا النار تخفي بالرماد اتقادها % % 5(@)(@@) % و كم من كتاب نمقت فيه كفه % % شهادة زور لا تساوي مدادها % % 6(@)(@@) % و مالكة إرثا حوى الإرث دونها % % و قد أملكته النائبات قيادها % % 7(@)(@@) % فراحت وما امتدت إلى الزاد كفها % % و راح رخي البال يأكل زادها % % 8(@)(@@) % فلو أن ما يأتي من الظلم ظلمة % على الأفق لم يجل الصباح سوادها % % PageV01P317 البحر : - 1(@)(@@) % لما مضى اليوم حميدا فانجرد % و نشر الليل جناحا فركد % 2(@)(@@) % دعوت فتيان الطراد والطرد % % و مارد الخضر على الصيد مرد % 3(@)(@@) % يكشر عن مثل الحرابأو أحد % يقصد في آثاره حيث قصد % % 4(@)(@@) % فاحتملوا زهر مصابيح تقد % و كل صفراء من الصفر تعد % 5(@)(@@) % حنانة في الليل من غير كمد % % كأن ماء البئر فيها يطرد % % 6(@)(@@) % يقرع للصيد يلموم الجسد % % كأنه لولا استوا الرأس وتد % % 7(@)(@@) % فتوقه الوحش صحيحا إن رقد % % حتى إذا عاينها السرب صدد % % 8(@)(@@) % مجدة تهدي له الحين 
ms87	 المجد % بصفحة البدر ورنات الأسد % % 9(@)(@@) % فحيرت غزلانهفلم تجد % % و أقبلت تركض كالسرب الفرد % % 10(@)(@@) % ثم غشيناهن أما وولد % % و شادنا يعطي القياد من وجد % % PageV01P318 11(@)(@@) % يوردها حوض المنايا فترد % فحين لاح الفجر منصات العمد % % 12(@)(@@) % و صار بحر الليل ضحضاحا ثمد % % خلنا المدى وردا له الورد سجد % % 13(@)(@@) % و أضحت الأهب شباريق قدد % % كأنها في الروض نظما وبدد % % 14(@)(@@) % مصندلات القمص تغري و تقد % فنحن والضيفان في عيش رغد % % 15(@)(@@) % نعد للزور كريمات العدد % % فمثلنا بمثلهن مستبد % PageV01P319 البحر : - 1(@)(@@) % أحل بعقوة الشرف التليد % و ألبس جنة الفخر العتيد % 2(@)(@@) % و أعلم أنني شرق المعادي % % ببرد شرابهو شجا الحسود % 3(@)(@@) % وأصفح والمنايا الحمر حولي % % تبرج والصواعق من جنودي % % 4(@)(@@) % أرى الآداب تصعد والقوافي % % معفرة الترائب في الصعيد % 5(@)(@@) % فيا أسفي على خلق جديد % تعز لديهأو جد سعيد % 6(@)(@@) % فليت الله أنجدها بحر % سريع عند دعوتها نجيد % 7(@)(@@) % و حجام يقول الشعر جاءت % غرائبه إلي على البريد % 8(@)(@@) % مزحت فجد في عتب تلظت % على آثاره شعل القصيد % 9(@)(@@) % فيا بعد السلامة من أكف % تغر بهن ضارية الأسود % 10(@)(@@) % فلا تبعد سيوفك من سيوف % فكم فتكت بجبار عنيد % PageV01P320 11(@)(@@) % صوارم تضرب الأعناق جهلا % و تحكم في الجياد وفي الخدود % 12(@)(@@) % تعلل من سطوت بها عليه % % بلفظ مثل تفويف البرود % 13(@)(@@) % فمن نظم تدبجه مليح ؛ % و من نثر تهذبه سديد % 14(@)(@@) % و كم تتدرج المنديل منه % % على أدراج شعرك والحديد % 15(@)(@@) % فينشده الذي حبرت فيه % % و يحلق رأسه بعد النشيد % PageV01P321 البحر : - 1(@)(@@) % شيخ لنا من شيوخ بغداد % أغذ في اللهو أي إغذاذ % 2(@)(@@) % رق طباعا ومنطقا فغدا % % و راح في المستشف كاللاذ % 3(@)(@@) % تطن تحت الأكف هامته % % إذا علتها طنين فولاذ % 4(@)(@@) % قواد إخوانهفإن ظمئوا % % سقاهم الراح سقي نباذ % 5(@)(@@) % له على الشط غرفة جمعت % كل خليع نشا ببغداذ % 6(@)(@@) % أعد فيها بنة الشباك لهم % % مقهورة الجنب وابنة الداذي % % 7(@)(@@) % و كدة من صباح قطربل % و جؤذرا من ملاح كلواذ % 8(@)(@@) % يقول للزائر 
ms88	 الملم به % أوصل هذا ألذ أم هذي % % 9(@)(@@) % و شاعر جوهر الكلام له % % ملك فمن تارك وأخاذ % 10(@)(@@) % كأن ألفاظه لرقتها % % و حسنها خمر طير ناباذ % PageV01P322 11(@)(@@) % تصد عن نكهة له ضبت % و هي عذاب كينع آذاد % % 12(@)(@@) % كم كبد بالعراق ناجية % منهاو أخرى بجز أفلاذ % 13(@)(@@) % قل لعلي سقتك غادية % مسفة الودق ذات إرذاذ % 14(@)(@@) % فخير ما فيه أنه رجل % يخدمنيالدهرو هو أستاذي % % PageV01P323 البحر : - 1(@)(@@) % ناديك من مطر الإحسان ممطور % و مرتجيك بغمر الجود مغمور % 2(@)(@@) % و البيض ظل عليكالدهر منتشر % و النقع جيب عليكالدهرمزرور % 3(@)(@@) % و الشرك قد هتكت أستار بيضته % % بحد سيفكو الإسلام منشور % 4(@)(@@) % كم وقعة لك شبت في ديارهم % نارا و أشرق منها في الهدى نور % 5(@)(@@) % بنهضة خر فسطاط الكفور لها % % خوفا و أذعن بالفسطاط كافور % 6(@)(@@) % إن تشتك الحدث الحسناء حادثة % سعى بها حائن منهم ومغرور % 7(@)(@@) % فإنها نشوة ولت عذوبتها % % و خر ذو التاج عنهاو هو مخمور % 8(@)(@@) % يستنقص الوتر من أعدائه ملك % عدوه حيث كانالدهرموتور % 9(@)(@@) % مجاور وزرا منهو هل وزر % و السيف في يد سيف الله مشهور % 10(@)(@@) % يا من يمن على الأسرى فيأسرهم % % علما بأن طليق المن مأسور % PageV01P324 11(@)(@@) % و من لديه رياض الحمد مونقة % فزهرها فيه منظوم ومنثور % 12(@)(@@) % إن تعمر السورأو تهمل عمارته % % فإنه بك ما عمرت معمور % 13(@)(@@) % محلك الغاب يحمي الليث حوزته % % فإن خلا منه يوما فهو مجذور % 14(@)(@@) % لله سور على الأيام يكلؤه % و أنتلا شك فيهذلك السور % 15(@)(@@) % حميته برماح الخط مشرعة % و كل حصن سوى أطرافها زور % 16(@)(@@) % أنت الهمام الذي من همه أبدا % جر الحديدو ذيل النقع مجرور % 17(@)(@@) % من أسرة قهروا كسرى وأسرته % % و الناس مهتضم منهم ومقهور % 18(@)(@@) % لهم من البر مصطاف ومرتبع % و محضر في ظلال الحضر محظور % 19(@)(@@) % و لا معاقل إلا كل سابغة % يطوي الفجاج سناهاو هو منشور % 20(@)(@@) % و كوكب في ذرى سمراء مغربة % إذا تمادى القنانحر وتامور % PageV01P325 21(@)(@@) % تمل فارسك المذكور في شيم % بمثلها 
ms89	 الذكر الصمصام مذكور % 22(@)(@@) % وافى ومولده الموفي يخبرنا % % بأنه ناصر للمجد منصور % 23(@)(@@) % جرى فرند أبيه في مضاربه % % فجاء وهو حديد الحد مأثور % 24(@)(@@) % فعاش ما نشر الديجور حلته % % و ما انطوى بضياء الفجر ديجور % 25(@)(@@) % حتى نراهو حد السيف في يده % مثلم و سنان الرمح ماطور % 26(@)(@@) % إن السماحة أخلاق عرفت بها % % و المكرمات حديث عنك مسطور % 27(@)(@@) % و الدهر يا بن أبي الهيجاء يفعل ما % % أمرتهفهو منهي و مأمور % 28(@)(@@) % لو هم بأسك بالطود الذي شمخت % هضابه لهوى من بأسك الطور % PageV01P326 البحر : - 1(@)(@@) % عفر الظباء لدى الكثيب الأعفر % سفحت دموعك يوم سفح محجر % 2(@)(@@) % أقبلت بين معرض بك معرض % حذر الوشاةو ضاحك مستعبر % 3(@)(@@) % يلطمن بالبرد العقيقو إنما % % يقتص من ورد الخدود الأحمر % 4(@)(@@) % و إذا الفراق أساء في أفعاله % كانت إساءته بأحسن منظر % 5(@)(@@) % سفرت فشمت لها بوارق شيمة % وثق الهوى منها بحظ مسفر % 6(@)(@@) % ثم اكتست خفر الحياءفخبرت % وجناتها عن ذمة لم تخفر % 7(@)(@@) % لا تنكري جزع الشجيفإنه % % لم يأت يوم الجزع منه بمنكر % 8(@)(@@) % نفر الكرى عن مقلتيه وأحدقت % بفؤاده حدق الظباء النفر % 9(@)(@@) % و لربما أغضتو في أحشائه % % ما شاء من جمر الغضا المتسعر % 10(@)(@@) % فعلى الليالي الغر يأسي أم على % % ما فات من عيش أغر مشهر % PageV01P327 11(@)(@@) % لا بد من شعث تطالع موهنا % أرض الشآم بكل أشعث أغبر % 12(@)(@@) % ما كنت آمن في المقام منيتي % % فأخافها بين القلاص الضمر % 13(@)(@@) % لما بدت رايات صبح مقبل % يخفقن في أعجاز ليل مدبر % 14(@)(@@) % و تقطرت خيل السحاب بمنزل % ركض الصبا فيه فلم يتقطر % 15(@)(@@) % ملنا فعفرنا الوجوهديانة % في الترب بين محلق ومقصر % 16(@)(@@) % متوشحين بكل أبيض مرهف % نيطت حمائله بأبيض أزهر % 17(@)(@@) % نطوي على المدح الصدورو إنما % % تطوى على أمثال يمنة عبقر % 18(@)(@@) % تلقى الأمير إلى السماح مشوقة % شوق الرياض إلى السحاب الممطر % 19(@)(@@) % ملك ثنا الآمال صفو نواله % % عن كل مطروق النوال مكدر % 20(@)(@@) % يأتيك عن فهم الثناء نواله % % عفوا و تلك سجية المستبصر 
ms90	 % PageV01P328 21(@)(@@) % كرم تكشف عن حلى آدابه % كالبحر يكشف غمره عن جوهر % 22(@)(@@) % فكأن أيدي الشكرإذ عبثت به % % أيدي الصبا عبثت بمسك أذفر % 23(@)(@@) % لمعت بوارقهفكن سحائبا % في معشر و صواعقا في معشر % 24(@)(@@) % و غدت ملوك الأرض تخطب سلمه % % من منجد نائي المحل ومغور % 25(@)(@@) % حلاهم مننا فحلوا باسمه % يوم العروبة كل ذروة منبر % 26(@)(@@) % و رأوه شمسا في غمامة نائل % تهميو بدرا في دجنة عثير % 27(@)(@@) % عم السباسب بالكتائب والقنا % % ببنانه في كل قاع مقفر % 28(@)(@@) % و أقام يقظان العزيمة ساهرا % بالثغر يكلأ نائما لم يسهر % 29(@)(@@) % موف على قمم المكارمموقد % نيرانها للطارق المتحير % 30(@)(@@) % ما شمر الأعداء إلا راعهم % % بنهوض أروع للقاء مشمر % PageV01P329 31(@)(@@) % سالوا فسال عليهم مطر الردى % % من كل أجرد سابح متمطر % 32(@)(@@) % و دنوافلم تنب القنا عن جنة % منهمو لا نبت الظبا عن مغفر % 33(@)(@@) % حتى انثنى والخيل تسحب فوقهم % % بالركضأردية العجاج الأكدر % 34(@)(@@) % لو أن مصطلما بكته رمة % لبكتهم في الترب رمة قيصر % 35(@)(@@) % أعلى لا زالت علاك سوافرا % تختال بين مثقف ومذكر % 36(@)(@@) % فلقد جريت أمام تغلب سافرا % جري السنان أمام لدن الأسمر % 37(@)(@@) % شرفا تبين قبابه مضروبة % في كل مبدى للفخار ومحضر % 38(@)(@@) % و مكارما يسعى إليهن المنى % % سعي الحجيج إلى الصفا والمشعر % 39(@)(@@) % موصولة بشمائل الأدب التي % % إن فاخرت جاءت بأفضل مفخر % 40(@)(@@) % إن السماح موارد مخصوصة % بالحمد بين ورودها والمصدر % PageV01P330 41(@)(@@) % و أعلها ما كان عذبا سائغا % حفت مناهله بروض أخضر % 42(@)(@@) % آليت لا أهدي كرائم منطقي % % إلا إلى الملك الكريم العنصر % 43(@)(@@) % من كل مشرقة النظام تلألأت % فحكت نظام اللؤلؤ المتخير % 44(@)(@@) % عبقتو قد فصلتها بخلاله % حتى كأن فصولها من عنبر % 45(@)(@@) % و دعت ينابيع الندى فتفجرت % كرما على ينبوعها المتفجر % 46(@)(@@) % كثرت محاسنهاو قل كلامها % % فأتتك تخبر عن مقل مكثر % PageV01P331 البحر : - 1(@)(@@) % أغرتك الشهاب أم النهار ؛ % و راحتك السحاب أم البحار % 2(@)(@@) % خلقت منية ومنىفأضحت % تمور بك البسيطة أو تمار % 3(@)(@@) % تحلي الدينأو تحمي حماه % % فأنت عليه سور 
ms91	 أو سوار % 4(@)(@@) % سيوفك من شكاة الثغر برء % و لكن للعدا فيها بوار % 5(@)(@@) % و كفاك الغمام الجود يسري % % و في أحشائه ماء ونار % 6(@)(@@) % يسار من سجيتها المنايا % % و يمنى من عطيتها اليسار % 7(@)(@@) % عصفت بحاتم كرما فأضحى % % و جل فعاله المشهور عار % 8(@)(@@) % فقد شهدتو ما حابتك طي % بأن الجود معدنه نزار % 9(@)(@@) % يحف الوفد منك بأريحي % تحف به السكينة والوقار % 10(@)(@@) % و سيف من سيوف الله مغرى % % بسفك دما العدامنه الفرار % PageV01P332 11(@)(@@) % و بدر ما استسر البدرإلا % % تعالى أن يحيط به السرار % 12(@)(@@) % حضرناو الملوك له قيام % تغض نواظرا فيها انكسار % 13(@)(@@) % و زرنا منه ليث الغاب طلقا % و لم نر قبله ليثا يزار % 14(@)(@@) % فكان لجوهر المجد انتظام ؛ % و كان لجوهر الحمد انتثار % 15(@)(@@) % بعثت إلى الثغور سحاب عدل % و بذل لا يغب له انهمار % 16(@)(@@) % و أسكنت السكينة ساحتيها % % فقرت بعدما امتنع القرار % 17(@)(@@) % و علمت النفير بها رجالا % عداهم عن عدوهم نفار % 18(@)(@@) % و فضت على عدوهمفقلنا % % أفاض البحر أم سح القطار % 19(@)(@@) % مكارم يعجز المداح عنها % % فجل مديحهم فيها اختصار % 20(@)(@@) % فعشت مخيرا أعلى الأماني % % و كان على العدو لك الخيار % PageV01P333 21(@)(@@) % و ضيفك للحيا المنهل ضيف % و جارك للربيع الطلق جار % PageV01P334 البحر : - 1(@)(@@) % تذكر نجدا فحن ادكارا % % و أرقه البرق لما استطارا % % 2(@)(@@) % أماتت صبابته صبره % % و كان يرى أن يموت اصطبارا % % 3(@)(@@) % و جار الهوى فاستجار الدموع % إذا لم يجد غيرها مستجارا % % 4(@)(@@) % وقفنافكم خفر عارض % يعصفر ورد الخدود احمرار % % 5(@)(@@) % و أدم إذا رام ظلم الفراق % % عذن بفيض الدموع انتصارا % % 6(@)(@@) % يجدن علي بأجيادهن % و يبدين لي الورد والجلنارا % % 7(@)(@@) % و إن أعر من سلوة أو أحد % عن الرشد لم يكسني الغي عارا % % 8(@)(@@) % فغدر المحب سواد العذار % إذا خلع الحب منه العذارا % % 9(@)(@@) % و حاشا لغاوي الصبا أن يقال % عصى غيه وأطاع الوقارا % % 10(@)(@@) % و بكر إذا جنبتها الجنوب % حسبت العشار تؤم العشارا % % PageV01P335 11(@)(@@) % ترى البرق يبسم سرا بها 
ms92	 % % إذا انتحب الرعد فيها جهارا % % 12(@)(@@) % إذا ما تنمر وسميها % % تعصفر بارقهافاستطارا % % 13(@)(@@) % يعارضها في الهواء النسيم % فينشر في الروض درا صغارا % % 14(@)(@@) % تكاد تسير إليه الرياض % إذا اطرد الماء فيهافسارا % % 15(@)(@@) % فطورا تشق جيوب الحياء ؛ % و طورا تسح الدموع الغزارا % % 16(@)(@@) % كأن الأمير أعار الربا % % شمائله فاشتملن المقارا % % 17(@)(@@) % هو الغيث تغنى به بلدة % و أخرى تحن إليه افتقارا % % 18(@)(@@) % أياد سحائبها ثرة % تفيض رواحا وتهمي ابتكارا % % 19(@)(@@) % و باع إذا طال يوم اللقاء % % غادر أعمار قوم قصارا % % 20(@)(@@) % و لن يرهب السيف حتى يرى % % على صفحة السيف ماء ونارا % % PageV01P336 21(@)(@@) % أبا الحسن اخترت حسن الثناء % و مثلك من يحسن الاختيارا % % 22(@)(@@) % و كم قد وطئت ديار العدا % % على الرغم منهمفجست الديارا % % 23(@)(@@) % بخيل تمد عليها الدجى % % و بيض ترد عليها النهارا % % 24(@)(@@) % و أطلعت فيها نجوم القنا % % فليست تغورإذا النجم غارا % % 25(@)(@@) % و يوم المدائنإذ زرتها % % و قد منعتها الظبا أن تزارا % % 26(@)(@@) % و خاضت جيادك فيها الدماء % و من قبل جاءت تثير الغبارا % % 27(@)(@@) % فلو أن كسرى بإيوانها % % لأهدت سطاك إليه انكسارا % % 28(@)(@@) % سقيت الرماح دما فانثنت % نشاوى كأن قد شربن العقارا % % 29(@)(@@) % يقصرن إذ طلن خطو العدا % % و يبدين في كل نحر عثارا % % 30(@)(@@) % و كم من ملوك تواعدتهم % % على النأي منهمفماتوا حذارا % % PageV01P337 31(@)(@@) % جريتفأنضيت شأو الرياح % و جاوزت في السبق من أن تجارى % % 32(@)(@@) % نأيتفأصبحت جار الفرات % و كنت لدجلةمن قبلجارا % % 33(@)(@@) % فقد عذن منك بمستلئم % يبيح التليد ويحمي الذمارا % % 34(@)(@@) % بغيث يجودإذا الغيث ضن % و ليث يثورإذا النقع ثارا % % 35(@)(@@) % و أغلب إن سار في تغلب % سمعت لسمر الرماح اشتجارا % % 36(@)(@@) % تغار عليه قوافي المديح % فيأبينإن ريتإلا ابتدارا % % 37(@)(@@) % و حق لقافية لم تكن % مآثره حليها أن تغارا % % 38(@)(@@) % لأذكرني بشره عارض % أضاء دجى الليل حتى أنارا % % 39(@)(@@) % و مر على الروض مر الخليع % يغنيو يسحب فيه الإزارا % % 40(@)(@@) % فأيقنت أن سأطيع النوى % % و أعصي الهوى صائرا حيث صارا % % PageV01P338 41(@)(@@) % دعتك الثغورو قد عاينت 
ms93	 % حماما مطلا وحتفا بوارا % % 42(@)(@@) % و صادف بعدك وفد الثناء % % وردا ثمادا وربعا قفارا % % 43(@)(@@) % يقولون إن طرقت أزمة % أأنجد ذاك الندى أم أغارا % % 44(@)(@@) % فليس المحل محلا لهم % % إذا فقدوكو لا الدرا دارا % % PageV01P339 البحر : - 1(@)(@@) % قليل لها أن يتبع الدمع غيرها % % و قد أزمعتيوم الفراقمسيرها % % 2(@)(@@) % شفا كمدي أنس الظباءو إنما % % عرت فرقة شتى الظباء نفورها % % 3(@)(@@) % و ما عاقنييوم العقيق عن الجوى % % سفور دمى أبدت لبين سفورها % % 4(@)(@@) % إذا ردها كر العناق عواطلا % من الحلي حلت بالدموع نحورها % % 5(@)(@@) % غدا الشوق في الأحشاء ثاني عطفه % غداة ثنت أعطافها وخصورها % % 6(@)(@@) % دعتني إساءات الخطوب إلى السرى ؛ % و كم من سرى أهدت لنفس سرورها % % 7(@)(@@) % فبحت بما استودعت صدري من الهوى ؛ % و باحت بما استودعت منه صدورها % % 8(@)(@@) % فبعت وصالا لا أمل أصيله % % بأيام هجر لا أمل هجيرها % % 9(@)(@@) % لقد حاولت سلم الأمير عداته % % لتحمد في سلم الأمير أميرها % % 10(@)(@@) % فزارته من أعلى الصعيدو قد ثنى % % إليها عنان السير كيما يزورها % % PageV01P340 11(@)(@@) % مطل على أرض العراق بعزمة ؛ % و ثاو بأرض الشام يحمي ثغورها % % 12(@)(@@) % معد ليوم الروع بيضا تذكرت % ظباء الأعاديفاستقالت ذكورها % % 13(@)(@@) % و سمرا تثنى في الطعان كأنها % % نشاوى سقتها الأندرينخمورها % % 14(@)(@@) % فقد تاركته الترك لما تأملت % سطاهو لو لاقته لاقت مبيرها % % 15(@)(@@) % أزارهم أسد العرين خوادرا % تردد في غاب الرماح زئيرها % % 16(@)(@@) % كتائب لو لاقين كسرى و قد سمت % لإيوان كسرى غادرته كسيرها % % 17(@)(@@) % و رامت حماة الروم لقياهفاغتدت % مواقفهايوم اللقاءقبورها % % 18(@)(@@) % أمال إليهم أوجه الخيل آلفا % سراها إلى أوطانهم وبكورها % % 19(@)(@@) % و جاءهم في الريح ريا عجاجة % تبث الصبا كافورها وعبيرها % % 20(@)(@@) % فحل بنصل السيف لؤلؤ تاجها % % و حط بأطراف الرماح سريرها % % PageV01P341 21(@)(@@) % و شن على الحور الكواعب غارة % أغار بها غيد النساء وحورها % % 22(@)(@@) % فإن تطغ يوما عاينت منه حتفها ؛ % و إن تستجر يوما أضلت مجيرها % % 23(@)(@@) % و كم حومة حامت عقاب لوائها % % عليك ونار الحرب تذكي سعيرها % % 24(@)(@@) % و شاهقة يحمي الحمام سهولها % % و تمنع 
ms94	 أسباب المنايا وعورها % % 25(@)(@@) % إذا سترت غر السحابو قد سرت % جوانبهاخلت السحاب ستورها % % 26(@)(@@) % و إن عاد خوفا من سيوفك ربها % % بدرتها أضحى لديك أسيرها % % 27(@)(@@) % مقيم تمر الطير دون مقامه % % فليس ترى عيناه إلا ظهورها % % 28(@)(@@) % ثنيت إلى غاياتها الأسدفانثنت % تساور بالبيض الصوارم سورها % % 29(@)(@@) % و آثرت بالعدل الخلافةفاعتلى % % سناهاو كاد الجور يخمد نورها % % 30(@)(@@) % بعثت إليها تغلب ابنة وائل % فكانتو قد عم الظلامبدورها % % PageV01P342 31(@)(@@) % فإن تدع دون الأولياء لنصرة % علي بن عبد اللهتدع نصيرها % % 32(@)(@@) % أتتك القوافي ظامئات إلى الندى % % فأوردتها عذب المياه نميرها % % 33(@)(@@) % و عادت بكفء منك يكثر مهرها % % و قد عدمت أكفاءها ومهورها % % 34(@)(@@) % فأيقنت بالنجح الذي كنت أرتجي % % لديكو عاينت المنى وغرورها % % PageV01P343 البحر : - 1(@)(@@) % ما ضر ليلتنا بسفح محجر % لو باعدت سفر الصباح المسفر % 2(@)(@@) % بات العناق يهز من أعطافنا % % غصنين في ورق الشباب الأخضر % 3(@)(@@) % إلفان وردهما المدام على الظما % % و جناهما زهر الحديث الأزهر % 4(@)(@@) % لا تنكري خفقان قلب خافق % نفرت به غيد الظباء النفر % 5(@)(@@) % شرفا من الأيام يوما صالحا % شفيا به حر الجوى المتسعر % 6(@)(@@) % لله صادرة اللياليإنها % % صدرت بطيب العيش أسرع مصدر % 7(@)(@@) % عندي لها نفس المشوقإذا جرت % خطراتهن وأنة المتذكر % 8(@)(@@) % و لرب ساق توجت يده يدي % % بإناء ياقوت المدام الأحمر % 9(@)(@@) % و غريرة جاهرت غيران الهوى % % بوصالهافنعمت غير مغرر % 10(@)(@@) % أيام كان رداي يفضل قامتي % % فتذاك في عرف الصبا والمنكر % PageV01P344 11(@)(@@) % و حدائق يسبيك وشي برودها % % حتى تسب لها سبائب عبقر % 12(@)(@@) % يجري النسيم خلالهاو كأنما % % غمست فضول ردائه في العنبر % 13(@)(@@) % باتت قلوب المحل تخفق بينها % % كخفوق رايات السحاب الممطر % 14(@)(@@) % من كل نائي الحجرتين مقنع % بالبرق داني الطرتين مشهر % 15(@)(@@) % يحدى بألسنة الرعود عشاره % % فتسير بين مغرد ومزمجر % 16(@)(@@) % طارت عقيقة برقهفكأنما % % صدعت ممسك غيمه بمعصفر % 17(@)(@@) % فالروض بين مزنر ومدنر % فيهاو بين مسير ومحبر % 18(@)(@@) % و الغدرفي أرجائهمصقولة % مثل الدراهم أشرقت في منثر % 19(@)(@@) % و كأنما عرضت لزاهر زهرها % % كف الأمير بعارض متعنجر % 20 
ms95	(@)(@@) % ملك إذا ما مد خمس أنامل % في الجود فاض بهن خمسة أبحر % PageV01P345 21(@)(@@) % تلقاه يوم الروع فارس معرك % ضنك و يوم السلم فارس منبر % 22(@)(@@) % تبكي سحائبه ويضحك بشره % فنواله من ضاحك مستعبر % 23(@)(@@) % متفرع من دوحة عدوية % هي والسماح تفرعا من عنصر % 24(@)(@@) % جبر الولي نوالهو تناهبت % أسيافه جبرية المتجبر % 25(@)(@@) % مثل الشهاب أضاء حلة معشر % بحريقهو أصاب حلة معشر % 26(@)(@@) % شرف يقول لمن يناوئهاكتئب % و على يقول لمن يجاريهاخسر % 27(@)(@@) % و يد تساوى الناس في معروفها % % فيد المقل تناله والمكثر % 28(@)(@@) % يا تغلب الغلباء طلت بطوله % % و نجاره قمم الكواكبففخري % % 29(@)(@@) % بمطوق طوق المحامدساحب % برد المكارمبالثناء مسور % 30(@)(@@) % و أغر مغرى بالصفوف يشقها % % و ظبا السيوف يشق جيب المغفر % PageV01P346 31(@)(@@) % كر أعل سلاحهفضرابه % % بمثلم وطعانه بمكسر % 32(@)(@@) % غمرتأبا الهيجاءربعك نعمة % موصولة بك عمر سبعة أنسر % 33(@)(@@) % و سقتك طيبة النسيمكأنما % % تهمي عليك بها حياض الكوثر % 34(@)(@@) % أسهرت ليليإذ عتبتفلم أذق % غمضا و من تعتب عليه يسهر % 35(@)(@@) % لو لم تكن متنكرا لي لم أكن % % لاذم صرف الحادث المتنكر % 36(@)(@@) % و إذا رميت بعتب مثلك خانني % % جلديفلم أصبر ولم أتصبر % 37(@)(@@) % أنسيت غر مدائح حليتها % % بعلاكباقية بقاء الأدهر % 38(@)(@@) % تغدو عليك من الثناء بناهد % معشوقة و تروح منك بمعصر % 39(@)(@@) % بدع تضوع نشرهافكأنما % % كتبت صحائفها بمسك أذفر % 40(@)(@@) % هذا ولم أجن القبيحفأجتبي % % غضبا و لم أهجر لديك فأهجر % PageV01P347 41(@)(@@) % بل قد ركبت من الذنوب عظيمها % % و رجوت عفوك فاعف عني واغفر % 42(@)(@@) % فلقد تعمد ثغرتي بسهامه % % واش تعمدني بقبح المحضر % 43(@)(@@) % يا سيد الأمرا دعوتك شاكرا % إن تعط أو تحرمصنيعك يشكر % 44(@)(@@) % و مظفر بندى يديكو لو غدا % % بالحمد غيرك عاد غير مظفر % 45(@)(@@) % أذكى له المريخ جمر نحوسه % % و تغيبت عنه سعود المشتري % % 46(@)(@@) % نوب أطلن عليه شعلة أبيض % عضب المضاربأو شرارة أسمر % 47(@)(@@) % و رمت به شقراء تحسب بردها % % ينقد من شية الجواد الأشقر % 48(@)(@@) % ترمي بمحمر الشراركأنما % % ترمى جوانبها بورد أحمر % 49(@)(@@) % خلعت عليه من الحرير 
ms96	 يلامقا % صفرا فبين محلل ومزرر % 50(@)(@@) % فالدهر يعجب منه لما مسه % % بجهنم الصغرى فلم يتفطر % PageV01P348 51(@)(@@) % هي وعكة كانت ثقاف مقوم % لدن المهزة أو صقال مذكر % 52(@)(@@) % تاج كبدر التم عاد ضياؤه % بعد الكسوف فراق عين المبصر % 53(@)(@@) % أو كالحسام جلا الصياقل متنه % حتى ترقرق منه ماء الجوهر % 54(@)(@@) % إن النضارإذا تتابع سبكه % خلص النضارو زاد نضرة منظر % 55(@)(@@) % فليكمد الأعداءأو فليحمدوا % % إذ قدروا فيه الذي لم يقدر % PageV01P349 البحر : - 1(@)(@@) % لحظ عينيك للردى أنصار % و سيوف شفارها الأشفار % 2(@)(@@) % فتكت بالمحب من غير ثأر % فلها في فؤاده آثار % 3(@)(@@) % وقعة باللوى استباحت نفوسا % قمرتها غراءها الأقمار % 4(@)(@@) % و مها تكتم البراقع منها % % صورا هن للعيون صوار % 5(@)(@@) % أعرب البان بينهنفمن أث % ماره الياسمين والجلنار % 6(@)(@@) % قد صرفنا الأبصار عنهن خوفا % إذ رمتنا بلحظها الأبصار % 7(@)(@@) % هاتها لم تباشر النارو اعلم % أنها في المعاد للشرب نار % 8(@)(@@) % قصرت ليلة الخورنق حسنا % و الليالي الطوال فيه قصار % 9(@)(@@) % بكر ترتعي جنى اللهو غضا % و اللذاذات بينها أبكار % 10(@)(@@) % إذ وجوه الأيام فيه رياض % و مياه السرور فيه خمار % PageV01P350 11(@)(@@) % وجنات تحير الورد فيها % % و ثغور جرت عليها العقار % 12(@)(@@) % كلما كرت الجباه بصبح % عطفت ليلها عليه الطرار % 13(@)(@@) % فضحاه من الذوائب ليل ؛ % و دجاه من الخدود نهار % 14(@)(@@) % غنيت عن سحائب المزن أرض % هن من راحة الأمير تمار % 15(@)(@@) % ظلها سجسج و زهر رباها % % عطر و الحيا بها مدرار % 16(@)(@@) % حيث لا وردنا ثماد و لا الوع % % د غرور و لا الهجوع غرار % 17(@)(@@) % يتصدى لظاهر البشر طلق ال % % وجهفيه سكينة ووقار % 18(@)(@@) % لا يصد الثناء عنهولا تر % غب عن ورده النفوس الحرار % 19(@)(@@) % سائل الديلمي كيف رأى سن % جار لما تنمرت سنجار % 20(@)(@@) % إذ تلاقى بأرضها الحطب الجز % ل ونار يحثها إعصار % PageV01P351 21(@)(@@) % معشر أصبحوا وجودا و أمسوا % % عدما و الخطوب فيها اعتبار % 22(@)(@@) % لم يسر حينهم إليهمو لكن % زجروا نحوه الجياد وساروا % % 23(@)(@@) % خطرت بالقنا الأسود عليهم % % فارتوى منهم القنا 
ms97	 الخطار % 24(@)(@@) % في برار تكشف النقع عنها % % و هي من رونق الحديد بحار % 25(@)(@@) % موقف لو أطل كسرى عليه % % لانثنى كاسفا وفيه انكسار % 26(@)(@@) % جبر الملك فيه جبار حرب % رافع من لوائه الجبار % 27(@)(@@) % أسد في الحديد تستوحش الأس % د لديهو يأنس الزوار % 28(@)(@@) % قبح الضرب في الوجوه ولكن % % حسنت عن سيوفك الأخبار % 29(@)(@@) % و تحلت بك المدائححتى % % هي شدو القيان والأسمار % 30(@)(@@) % و اشرأبت لك الديارفلو تس % % طيع سيرا سرت إليك الديار % PageV01P352 31(@)(@@) % نعم للسيوف لا ينفد الشك % ر عليهاأو تنفد الأعمار % 32(@)(@@) % أبرأتنا كما أبارت عدانا % % فهي فينا برء و فيهم بوار % 33(@)(@@) % قد أطاعتك في العدو المنايا % % و جرت بالمنى لك الأقدار % 34(@)(@@) % لا تقد جحفلا فأنت من النج % % دة والبأس جحفل جزار % 35(@)(@@) % أيها اللائمي على صون وجهي % % إن بذل الوجوه شين وعار % 36(@)(@@) % أملي في الملوك عسر و لكن % أملي في أبي المرجى اليسار % PageV01P353 البحر : - 1(@)(@@) % مرضت جفونك والحتوف شعارها % % هن السيوف شفارها أشفارها % % 2(@)(@@) % جاورت من شيم الكواعب في الهوى % % من لا يجار من الصبابة جارها % % 3(@)(@@) % لله موقفنا بمنعرج اللوى % % و محارنا في لوعة ومحارها % % 4(@)(@@) % نضت البراقع عن محاسن روضة % ريضت بمحتفل الحيا أنوارها % % 5(@)(@@) % فمن الثغور المشرقات لجينها % % و من الخدور المذهبات نضارها % % 6(@)(@@) % مصقولة بسنا الصباح جباهها % % مصبوغة بدجى الظلام طرارها % % 7(@)(@@) % أغصان بان أغربت في حملها % % فغرائب الورد الجني ثمارها % % 8(@)(@@) % طالت ليالي الحب بعد فراقها % % و أحبهن إلى المحب قصارها % % 9(@)(@@) % و لرب ليلات بهن تفرجت % أسدافها وتأرجت أسحارها % % 10(@)(@@) % ما كان ذاك العيش إلا سكرة % رحلت لذاذتها وحل خمارها % % PageV01P354 11(@)(@@) % الله أكبر فرق السيف العدا % % فتفرقت أيدي سبا أخبارها % % 12(@)(@@) % لا تجبر الأيام كسر عصابة % كسرت وذل بجابر جبارها % % 13(@)(@@) % رحلتفكان إلى السيوف رحيلها % % و ثوتفكان على الحتوف قرارها % % 14(@)(@@) % سجرت بحارهم دما فتيقنت ؛ % أن الأسود عرينها سنجارها % % 15(@)(@@) % برزت لها أسد الرهاإذ حوصرت % و الأسد تأنف أن يطول حصارها % % 16(@)(@@) % ثبتوا إلى أجدارهافكأنهم % % و الطعن يقتلع 
ms98	 الكماةجدارها % % 17(@)(@@) % مستعصمين من الأمير بهضبة % عدوية لا ترتقى أوعارها % % 18(@)(@@) % يغشون قارعة القراع بأوجه % ألفت مباشرة القنا أبشارها % % 19(@)(@@) % علم الأعاجم أن وقع سيوفكم % نار تشبو أنتم إعصارها % % 20(@)(@@) % من ذا ينازعكم كريمات العلى % % و هي البروجو أنتم أقمارها % % PageV01P355 21(@)(@@) % الحرب تعلم أنكم آسادها ؛ % و الأرض تعلم أنكم أمطارها % % 22(@)(@@) % هي وقعة لك عزها وسناؤها % % و على عدوك نارها وشنارها % % 23(@)(@@) % ركب السفين مشرقا في معشر ؛ % من قال تغرب خيفة أبصارها % % 24(@)(@@) % موتورة بشبا الأسنة لو بغت % وترا إليك تضاعفت أوتارها % % 25(@)(@@) % عمرت ديارك من قبور ملوكهم % % و خلت من الأنس المقيم ديارها % % 26(@)(@@) % وردت بآساد الشرى مبيضة % أفعالهامحمرة أظفارها % % 27(@)(@@) % و السمر قد خضب الطعان صدورها % % فكأنها قد أذهبت أشطارها % % 28(@)(@@) % و المرهفات جميلة أفعالها % % في الملك غير جميلة آثارها % % 29(@)(@@) % فلتشكرنك دولة جددتها % % فتجددت أعلامها ومنارها % % 30(@)(@@) % حليتها وحميت بيضة ملكها % % فغرار سيفك سورها وسوارها % % PageV01P356 31(@)(@@) % و غريبة تجري عليك رياحها % % أرجا إذا لفحت عدوك نارها % % 32(@)(@@) % ممن له غرر الكلام تفتحت % أبوابهاو ترفعت أستارها % % 33(@)(@@) % تجري وتطلبه عصائب قصرت % عن شأوهفقصارها أقصارها % % 34(@)(@@) % يحوي له الأسد البعيد نجاره % و يعوقها عما حواه نجارها % % 35(@)(@@) % فتعيش بعد مماته أشعاره ؛ % و تموت قبل مماتها أشعارها % % PageV01P357 البحر : - 1(@)(@@) % أكف تغلب أنواء الحيا الجاري ؛ % و نار بأسهم أذكى من النار % 2(@)(@@) % و الحمد حلي بني حمدان تعرفه ؛ % و الحق أبلج لا يلقى بإنكار % 3(@)(@@) % قوم إذا نزل الزوار ساحتهم % % تفيؤوا ظل جنات وأنهار % 4(@)(@@) % مؤمرونإذا ثارت قرومهم % أفضت إلى الغاية القصوى من الثار % 5(@)(@@) % فكل أيامهم يوم الكلابإذا % % عدت وقائعهمأو يوم ذي قار % 6(@)(@@) % تتابعت بركات الله نازلة % على أبي البركات المانع الجار % 7(@)(@@) % على الحيا الغمر والبحرالذي رسبت % فيه جواهرهو الضيغم الضاري % % 8(@)(@@) % على الأمير الذي أضحت مناقبه % % مثل النجومتضيء الليل للساري % % 9(@)(@@) % إذا عزمت على إحصائها ازدحمت % فكاثرت مدحي فيهو إكباري % % 10(@)(@@) % و هل يقاس فضاء البحر منحرفا % بأذرع قصرت عنه وأشبار % PageV01P358 11(@)(@@) % أصبحت أظهر شكرا عن صنائعه 
ms99	 % % و أضمر الود فيها أي إضمار % 12(@)(@@) % كيانع النخل يبدي للعيون ضحى % % طلعا نضيدا و يخفي غض جمار % 13(@)(@@) % أأكرم الناس إلا أن تعد أبا % فات الكرام بآباء وآثار % 14(@)(@@) % أشكو إليك حليفي غارة شهرا % % سيف الشقاق على ديباج أشعاري % % 15(@)(@@) % ذئبين لو ظفرا بالشعر في حرم % لمزقاه بأنياب وأظفار % 16(@)(@@) % سلا عليه سيوف البغي مصلتة % في جحفل من شنيع الظلم جرار % 17(@)(@@) % و أرخصاهفقل في العطر منتهبا % لديهمايشترى من غير عطار % 18(@)(@@) % لطائم المسك والكافور فائحة % منهومنتهب الهندي والغار % 19(@)(@@) % و كل مسفرة الألفاظ تحسبها % % صفيحة بين إشراق وإسفار % 20(@)(@@) % أرقت ماء شبابي في محاسنها % % حتى ترقرق فيها ماؤها الجاري % % PageV01P359 21(@)(@@) % كأنما نفس الريحان يمزجه % صبا الأصائل من أنفاس نوار % 22(@)(@@) % باعا عرائس شعري بالعراقفلا % % تبعد سباياه من عون وأبكار % 23(@)(@@) % مجهولة القدر مظلوم عقائلها % % مقسومة بين جهال وأغمار % 24(@)(@@) % و ما يضرهماو الدر ذو خطر % إن حلياه ملوكا ذات أخطار % 25(@)(@@) % و ما رأى الناس سبيا مثل سبيهما % % بيعت نفيسته ظلما بدينار % 26(@)(@@) % إذا كساك ثياب المدح سالبها % % يوما فإنك أنت المكتسي العاري % % 27(@)(@@) % و الله ما مدحا حيا و لا رثيا % % ميتا و لا افتخرا إلا بأشعاري % % 28(@)(@@) % إن توجاك بدر فهو من لججي ؛ % أو ختماك بياقوت فأحجاري % % 29(@)(@@) % هذاو عندي من لفظ أشعشعه % سلافة ذات أضواء وأنوار % 30(@)(@@) % كريمة ليس من كرم و لا التثمت % عروسها بخمار عند خمار % PageV01P360 31(@)(@@) % تنشو خلال شغاف القلبإن نشأت % ذات الحباب خلال الطين والقار % 32(@)(@@) % لم يبق لي من قريض كان لي وزرا % على الشدائدإلا ثقل أوزاري % % 33(@)(@@) % أراه قد هتكت أستار حرمته % % و سائر الشعر مستور بأستار % 34(@)(@@) % كأنه جنة راحت حدائقها % % من الغبيين في نار وإعصار % 35(@)(@@) % عار من النسب الوضاح منتسب % في الخالدية بين الذل والعار % 36(@)(@@) % و ما أظن دعي الأرد ينصفني % % حتى تموج به أمواج تياري % % 37(@)(@@) % غضبانيستر عني وجهه بيد % وددت لو سمرت فيه بمسمار % 38(@)(@@) % لقد تحيف شعري معشر عرر % منهم قريب و 
ms100	 منهم نازح الدار % 39(@)(@@) % يفوقونو نبلي في كنانته % % إلي كل كليل النصل خوار % 40(@)(@@) % و لو تفوق سهمي راكبا وترا % يوما لطال عليهم نقض أوتاري % % PageV01P361 41(@)(@@) % إياكم أن تشيموا برق غادية % مسفة بذعاف السم مدرار % 42(@)(@@) % و لا يغرنكم أمطار مبتسم % يزجي الصواعق في أثناء أمطار % 43(@)(@@) % فالسيف يبدي ابتساما عند هزته % % و قد أسر المنايا أي إسرار % 44(@)(@@) % و ما رأيتم شجاعا قبل رؤيته % % قراكمو هو مود شهد مشتار % 45(@)(@@) % يبر منكم شبابا ما لهم حزن % على الصباو شيوخا غير أبرار % 46(@)(@@) % من كان يعجز عن سهلي إذا استبقت % خيل القريضفكم تجتاب أوعاري % % 47(@)(@@) % و هل يقوم لجمعي حين أضرمه % مغرر عن زناد قلبه واري % % 48(@)(@@) % لو كنتم العنبر الورد الشبيه به % % و المندل الرطبشبت منكم ناري % % 49(@)(@@) % لكنكم حطب بال تحرقه % سعير شمس الضحى من قبل أشعاري % % PageV01P362 البحر : - 1(@)(@@) % يؤرقهإذا البرق استنارا % % هوى يقتاد عبرته اقتسارا % % 2(@)(@@) % بدا مشقا ترود العين فيه % % فتقرأ من لوامعه ادكارا % % 3(@)(@@) % و نمنمة تضيء له وتخبو % % كما طيرت عن زند شرارا % % 4(@)(@@) % و إيماضا يشق الجو شقا % كما قتبست إماء الحي نارا % % 5(@)(@@) % فرحت أسائل الركبان عنه % % بأي جنوب كاظمة استطارا % % 6(@)(@@) % لأذكرني أعز الناس جارا % و أحلى الأرض في عيني دارا % % 7(@)(@@) % و عدل الحب من قوم تعدى % % علي الشوق بعدهمفجارا % % 8(@)(@@) % و ناعمة الصبا تسجوفتشجو % % قلوبا من صبابتها مرارا % % 9(@)(@@) % أقول لهاإذا سفرت ومارت % أغصن البان أثمر جلنارا % % 10(@)(@@) % أصابهمو إن بعدوا منالا % على العشاقأو بعدوا مزارا % % PageV01P363 11(@)(@@) % نسيم الريح ما راحت جنوبا % و صوب المزن ما ابتكرت عشارا % % 12(@)(@@) % سأعفي الدهر من تكدير عذلي % % فأعذرهو إن خلع العذارا % % 13(@)(@@) % لقينا من حوادثه جيوشا % و خضنا من نوائبه غمارا % % 14(@)(@@) % فلم نظهر له إلا قراعا ؛ % و لم نلبس له إلا وقارا % % 15(@)(@@) % و من يكن الأمير له مجيرا % يكن للكوكب العلوي جارا % % 16(@)(@@) % هو الجبل الأشم حمى وعزا % ترفع أن ترى جبلا مغارا % % 17(@)(@@) % فررت إليه من صرف الليالي % % فنكب 