ms4341	 صلى الله عليه وسلم وصفاته ، رقم ( 2289 ) ص ) - عن جابر بن سمرة ) .(@)(@@) 31889 - أنا دعوة إبراهيم وكان آخر من بشر بي عيسى بن مريم .(@)(@@) % ( ابن عساكر - عن عبادة بن الصامت ) .(@)(@@) 31890 - آتي باب الجنة فأستفتح فيقول الخازن : من أنت ؟ فأقول : محمد ، فيقول : بك أمرت أن لا أفتح لأحد قبلك .(@)(@@) % ( حم ، م - عن أنس ) .(@)(@@) 31891 - أتاني جبريل فقال : إن ربي وربك يقول لك : تدري كيف رفعت ذكرك ؟ قلت : الله أعلم ، قال : لا أذكر إلا ذكرت معي .(@)(@@) % ( ع ، حب ، والضياء في المختارة - عن أبي سعيد ) .(@)(@@) 31892 - أتاني آت من عند ربي فخيرني بين أن يدخل نصف أمتي الجنة وبين الشفاعة فاخترت الشفاعة ، وهي لمن مات لا يشرك بالله شيئا .(@)(@@) % ( حم - عن أبي موسى ؛ ت ، حب - عن عوف بن مالك الأشجعي ) .(@)(@@) 31893 - اتخذ الله إبراهيم خليلا وموسى نجيا واتخذني حبيبا ثم قال : وعزتي وجلالي لأؤثرن حبيبي على خليلي ونجي .(@)(@@) % ( هب - عن أبي هريرة ) .(@)(@@) PageV11P182(@)(@@) 31894 - أتيت بمقاليد الدنيا على فرس أبلق جاءني جبريل عليه قطيفة من سندس .(@)(@@) % ( حم ، حب والضياء - عن جابر ) .(@)(@@) 31895 - أدبني ربي فأحسن تأديبي .(@)(@@) % ( ابن السمعاني في أدب الإملاء - عن ابن مسعود ) ( قال المناوي في الفيض ( 1 / 224 ) واسناده ضعيف ، وقال السخاوي : ضعيف . ص ) .(@)(@@) 31896 - أتاني جبريل بقدر يقال له الكفيت فأكلت منه أكلة فأعطيت قوة أربعين رجلا في الجماع .(@)(@@) % ( ابن سعد ، حل - عن صفوان بن سليم عن عطاء بن يسار عن أبي هريرة ) .(@)(@@) 31897 - أتاني جبريل بقدر فأكلت منها فأعطيت قوة أربعين رجلا في الجماع .(@)(@@) % ( ابن سعد - عن صفوان بن سليم مرسلا ) .(@)(@@) 31898 - إذا كان يوم القيامة كنت إمام النبيين وخطيبهم وصاحب شفاعتهم غير فخر .(@)(@@) % ( حم ، ت ، ه ( أخرجه الترمذي من حديث طويل كتاب المناقب رقم ( 3610 ) وقال : حسن غريب . ص ) ، ك - عن أبي ) .(@)(@@) 31899 - بعثت بجوامع الكلم ، ونصرت بالرعب ، وبينا أنا نائم أتيت بمفاتيح خزائن الأرض فوضعت في يدي .(@)(@@) % ( ق ( أخرجه البخاري كتاب الاعتصام باب قول النبي صلى الله عليه وسلم بعثت بجوامع الكلم ( 9 / 113 ) ص ) ، ن - عن 
ms4342	 أبي هريرة ) .(@)(@@) 31900 - تنام عيناي ولا ينام قلبي .(@)(@@) % ( ابن سعد - عن الحسن مرسلا ) .(@)(@@) 31901 - جعلت لي الأرض مسجدا وطهورا .(@)(@@) % ( ه - عن أبي هريرة د - عن أبي ذر ) .(@)(@@) 31902 - جعلت لي كل أرض طيبة مسجدا وطهورا .(@)(@@) % ( حم والضياء - عن أنس ) .(@)(@@) 31903 - حياتي خير لكم تحدثون ويحدث لكم ، فإذا أنا مت كانت وفاتي خيرا لكم ، تعرض علي أعمالكم فإن رأيت خيرا حمدت الله تعالى وإن رأيت شرا استغفرت لكم .(@)(@@) % ( ابن سعد - عن بكر بن عبد الله مرسلا ) ( قال المناوي في الفيض ( 3 / 401 ) وظاهر صنيع المصنف أي الإمام السيوطي أنه لم يره موصولا فقد رواه البزار من حديث ابن مسعود قال الهيثمي : ورجاله رجال الصحيح ص ) .(@)(@@) 31904 - حياتي خير لكم ومماتي خير لكم .(@)(@@) % ( الحارث - عن أنس ) .(@)(@@) 31905 - خيار ولد آدم خمسة : نوح وإبراهيم وموسى وعيسى ومحمد وخيرهم محمد .(@)(@@) % ( ابن عساكر - عن أبي هريرة ) .(@)(@@) 31906 - رأت أمي حين وضعتني سطع منها نور أضاءت له قصور بصرى .(@)(@@) % ( ابن سعد - عن أبي العجفاء ) .(@)(@@) 31907 - رأت أمي كأنه خرج منها نور أضاءت منه قصور الشام .(@)(@@) % ( ابن سعد - عن أبي أمامة ) .(@)(@@) 31908 - سلم علي ملك ثم قال لي : لم أزل أستأذن ربي عز وجل في لقائك حتى كان هذا أوان أذن لي ، وأنا أبشرك أنه ليس أحد أكرم على الله منك .(@)(@@) % ( ابن عساكر - عن عبد الرحمن بن غنم ) .(@)(@@) PageV11P183(@)(@@) 31909 - السباق أربعة : أنا سابق العرب ، وصهيب سابق الروم وسلمان سابق الفرس ، وبلال سابق الحبش .(@)(@@) % ( البزار ، طب ، ك - عن أنس ؛ طب - عن أم هانئ ؛ عد - عن أبي أمامة ) .(@)(@@) 31910 - عرضت علي الجنة والنار آنفا في عرض هذا الحائط فلم أر كاليوم في الخير والشر ، ولو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا .(@)(@@) % ( م - عن أنس ) ( أخرجه مسلم كتاب الفضائل باب توقيره صلى الله عليه وسلم رقم ( 2359 ) ص ) .(@)(@@) 31911 - عرضت علي أمتي البارحة لدى هذه الحجرة حتى لأنا أعرف بالرجل منهم من أحدكم بصاحبه ، صوروا لي في الطين .(@)(@@) % ( طب والضياء - عن حذيفة بن أسيد ) .(@)(@@) 31912 - فضلنا على الناس بثلاث 
ms4343	 : جعلت صفوفنا كصفوف الملائكة وجعلت لنا الأرض كلها مسجدا ، وجعلت تربتها لنا طهورا إذا لم نجد الماء ، وأعطيت هذه الآيات من آخر سورة البقرة من كنز تحت العرش لم يعطها نبي قبلي .(@)(@@) % ( حم ، م ( أخرجه مسلم كتاب المساجد رقم ( 522 ) ص ) ، ن - عن حذيفة ) .(@)(@@) 31913 - قال لي جبريل : قلبت مشارق الأرض ومغاربها فلم أجد رجلا أفضل من محمد ، وقلبت مشارق الأرض ومغاربها فلم أجد بني أب أفضل من بني هاشم .(@)(@@) % ( الحاكم في الكنى وابن عساكر - عن عائشة ) .(@)(@@) 31914 - كل سبب ونسب منقطع يوم القيامة إلا سببي ونسبي .(@)(@@) % ( طب ، ك هق - عن عمر ؛ طب - عن ابن عباس وعن المسور ) .(@)(@@) 31915 - كل نسب وصهر ينقطع يوم القيامة إلا نسبي وصهري .(@)(@@) % ( ابن عساكر - عن ابن عمر ) .(@)(@@) 31916 - كنت أول الناس في الخلق وآخرهم في البعث .(@)(@@) % ( ابن سعد عن قتادة مرسلا ) .(@)(@@) 31917 - كنت نبيا وآدم بين الروح والجسد .(@)(@@) % ( ابن سعد ( أخرجه الترمذي كتاب المناقب باب فضل النبي صلى الله عليه وسلم رقم ( 3609 ) ، وقال : حسن صحيح غريب ص ) ، حل - عن ميسرة الفجر ؛ ابن سعد - عن ابن أبي الجدعاء ؛ طب - عن ابن عباس ) .(@)(@@) 31918 - لقد رأيت الآن منذ صليت لكم الجنة والنار ممثلتين في قبلة هذا الجدار فلم أر كاليوم من الخير والشر .(@)(@@) % ( خ - عن أنس ) ( أخرجه البخاري كتاب الصلاة باب رفع البصر إلى الإمام في الصلاة ( 1 / 190 ) ص ) .(@)(@@) 31919 - ليس منكم رجل إلا وأنا ممسك بحجزته ( بحجزته : أي مشد إزاره ، وتجمع على حجز . النهاية ( 1 / 344 ) ب ) أن يقع في النار .(@)(@@) % ( طب - عن سمرة ) .(@)(@@) 31920 - مثلي ومثلكم كمثل رجل أوقد نارا فجعل الفراش والجنادب يقعن فيها وهو يذبهن ( يذبهن : ذب عن جريمه ذبا من باب قتل : حمى ودفع . المصباح المنير ( 1 / 280 ) ب ) عنها وأنا آخذ بحجزكم عن النار وأنتم تفلتون من يدي .(@)(@@) % ( حم ، م ( أخرجه مسلم كتاب الفضائل باب شفقته صلى الله عليه وسلم رقم ( 2285 ) ص ) عن جابر ) .(@)(@@) PageV11P184(@)(@@) 31921 - إن الله تعالى لم يحرم حرمة إلا وقد علم أنه سيطلعها منكم 
ms4344	 مطلع الفجر ، ألا ! وإني ممسك بحجزكم أن تهافتوا في النار كما يتهافت الفراش والذباب .(@)(@@) % ( حم ، طب - عن ابن مسعود ) .(@)(@@) 31922 - ما من الأنبياء من نبي إلا وقد أعطي من الآيات ما مثله آمن عليه البشر ، وإنما كان الذي أوتيته وحيا أوحاه الله إلي فأرجو أن أكون أكثرهم تابعا إلى يوم القيامة .(@)(@@) % ( حم ، ق - عن أبي هريرة ) ( أخرجه مسلم كتاب الإيمان باب جوب الإيمان برسالة محمد صلى الله عليه وسلم رقم ( 152 ) ص ) .(@)(@@) 31923 - ما من شيء إلا يعلم أني رسول الله إلا كفرة الجن والإنس .(@)(@@) % ( طب - عن يعلى بن مرة ) .(@)(@@) 31924 - من كرامتي على ربي أني ولدت مختونا ولم ير أحد سوأتي .(@)(@@) % ( طس - عن أنس ) .(@)(@@) 31925 - نصرت بالصبا وأهلكت عاد بالدبور ( بالدبور : الدبور وزان رسول : ريح تهب من جهة المغرب تقابل الصبا المصباح المنير ( 1 / 257 ) ب ) .(@)(@@) % ( حم ، ق - عن ابن عباس ) .(@)(@@) 31926 - نصرت بالصبا وكانت عذابا على من كان قبلي .(@)(@@) % ( الشافعي - عن محمد بن عمر مرسلا ) .(@)(@@) 31927 - ولد آدم كلهم تحت لوائي يوم القيامة ، وأنا أول من يفتح له باب الجنة .(@)(@@) % ( ابن عساكر - عن حذيفة ) .(@)(@@) 31928 - أعطيت ما لم يعط أحد من الأنبياء قبلي : نصرت بالرعب ، وأعطيت مفاتيح الأرض ، وسميت أحمد ، وجعل لي التراب طهورا ، وجعلت أمتي خير الأمم .(@)(@@) % ( حم - عن علي ) .(@)(@@) 31929 - أعطيت فواتح الكلم وجوامعه وخواتمه .(@)(@@) % ( ش ، ع ، طب - عن أبي موسى ) .(@)(@@) 31930 - أعطيت خمسا لم يعطهن أحد من الأنبياء قبلي : نصرت بالرعب مسيرة شهر ، وجعلت لي الأرض مسجدا وطهورا ، فأيما رجل من أمتي أدركته الصلاة فليصل ، وأحلت لي الغنائم ولم تحل لأحد قبلي ، وأعطيت الشفاعة ، وكان النبي يبعث إلى قومه خاصة ، وبعثت إلى الناس عامة .(@)(@@) % ( ق ( أخرجه مسلم كتاب المساجد رقم ( 521 ) ص ) ، ن - عن جابر ؛ حم طب عن ابن مسعود ) .(@)(@@) 31931 - أعطيت سبعين ألفا من أمتي يدخلون الجنة بغير حساب ، وجوههم كالقمر ليلة البدر ، قلوبهم على قلب رجل واحد فاستزدت ربي عز وجل فزادني مع كل واحد سبعين ألفا .(@)(@@) % ( حم - عن أبي بكر ) .(@)(@@) 31932 - فضلت 
ms4345	 على الأنبياء بستة : أعطيت جوامع الكلم ، ونصرت بالرعب ، وأحلت لي الغنائم ، وجعلت لي الأرض طهورا ومسجدا ، وأرسلت إلى الخلق كافة ، وختم بي النبيون .(@)(@@) % ( م ( أخرجه مسلم كتاب المساجد رقم ( 523 ) ص ) ، ت - عن أبي هريرة ) .(@)(@@) PageV11P185(@)(@@) 31933 - فضلت على الأنبياء بخمس : بعثت إلى الناس كافة ، وذخرت شفاعتي لأمتي ، ونصرت بالرعب شهرا أمامي وشهرا خلفي ، وجعلت لي الأرض مسجدا وطهورا ، وأحلت لي الغنائم ولم تحل لأحد قبلي .(@)(@@) % ( طب - عن السائب بن يزيد ) .(@)(@@) 31934 - فضلت بأربع : جعلت لي الأرض مسجدا وطهورا فأيما رجل من أمتي أتى الصلاة فلم يجد ما يصلي عليه وجد الأرض مسجدا وطهورا ، وأرسلت إلى الناس كافة ، ونصرت بالرعب من مسيرة شهرين يسير بين يدي ، وأحلت لي الغنائم .(@)(@@) % ( هق عن أبي أمامة ) .(@)(@@) 31935 - فضلت على الناس بأربع : بالسخاء ، والشجاعة ، وكثرة الجماع ، وشدة البطش .(@)(@@) % ( طس والإسماعيلي في معجمه - عن أنس ) .(@)(@@) 31936 - فضلت على آدم بخصلتين : كان شيطاني كافرا فأعانني الله عليه حتى أسلم ، وكن أزواجي عونا لي ؛ وكان شيطان آدم كافرا ، وكانت زوجته عونا على خطيئته .(@)(@@) % ( البيهقي في الدلائل - عن ابن عمر ) .(@)(@@) 31937 - أما والله ! إني لأمين في السماء ، أمين في الأرض .(@)(@@) % ( طب - عن أبي رافع ) .(@)(@@) 31938 - والله ! لا تجدون بعدي أعدل عليكم مني .(@)(@@) % ( طب ، ك - عن أبي برزة ؛ حم - عن أبي سعيد ) .(@)(@@) 31939 - إن الله تعالى أبى لي أن أتزوج أو أزوج إلا أهل الجنة .(@)(@@) % ( ابن عساكر - عن هند بن أبي هالة ) .(@)(@@) 31940 - إن الله تعالى اتخذني خليلا كما اتخذ إبراهيم خليلا ، وإن خليلي أبو بكر .(@)(@@) % ( طب - عن أبي أمامة ) .(@)(@@) 31941 - أخذ الله عز وجل مني الميثاق كما أخذ من النبيين ميثاقهم ، وبشر بي المسيح عيسى ابن مريم ، ورأت أمي في منامها أنه خرج من بين رجليها سراج أضاءت له قصور الشام .(@)(@@) % ( طب وأبو نعيم في الدلائل وابن مردويه - عن أبي مريم الغساني ) .(@)(@@) 31942 - أدبني ربي ونشأت في بني سعد .(@)(@@) % ( ابن عساكر - عن محمد ابن عبد الرحمن الزهري عن أبيه عن جده ) .(@)(@@) 31943 - أما شعرت أن الله عز وجل قد 
ms4346	 زوجني في الجنة مريم بنت عمران وكلثم أخت موسى وامرأة فرعون .(@)(@@) % ( طب عن أبي أمامة ) .(@)(@@) 31944 - إن الله تعالى أعطاني خصالا ثلاثا : صلاة الصفوف ، والتحية ، والتأمين .(@)(@@) % ( ابن خزيمة - عن أنس ) .(@)(@@) PageV11P186(@)(@@) 31945 - إن الله تعالى أعطاني ثلاث خصال لم يعطها ؟ ؟ أحد قبلي : الصلاة في الصفوف ، والتحية من تحية أهل الجنة ، وآمين إلا أنه أعطى موسى أن يدعو ويؤمن هارون .(@)(@@) % ( عد ، هب - عن أنس ) .(@)(@@) 31946 - فضلت بأربع : جعلت أنا وأمتي في الصلاة كما تصف الملائكة ، وجعل الصعيد لي وضوءا ، وجعلت لي الأرض مسجدا وطهورا وأحلت لي الغنائم .(@)(@@) % ( طب - عن أبي الدرداء ) .(@)(@@) 31947 - إن الله تعالى بعثني بتمام مكارم الأخلاق وكمال محاسن الأعمال .(@)(@@) % ( طس - عن جابر ) .(@)(@@) 31948 - إن الله تعالى بعثني إلى كل أحمر وأسود ، ونصرت بالرعب ، وأحل لي المغنم ، وجعلت لي الأرض مسجدا وطهورا ، وأعطيت الشفاعة للمذنبين من أمتي يوم القيامة .(@)(@@) % ( ابن عساكر - عن علي ) .(@)(@@) 31949 - إن الله تعالى خلق خلقه فجعلهم فريقين فجعلني في خير الفريقين ، ثم جعلهم قبائل فجعلني في خير قبيلة ، ثم جعلهم بيوتا فجعلني في خيرهم بيتا ؛ فأنا خيركم قبيلة وخيركم بيتا .(@)(@@) % ( ك - عن ربيعة ابن الحارث ) ( ؟ ؟ الحديث في سن الترمذي كتاب المناقب باب فضل النبي صلى الله عليه وسلم رقم ( 3607 و 3608 ) وقال : حسن ص ) .(@)(@@) 31950 - أنا محمد بن عبد الله بن عبد المطلب ! إن الله تعالى خلق الخلق فجعلني في خيرهم ، ثم جعلهم فرقتين فجعلني في خيرهم فرقة ، ثم جعلهم قبائل فجعلني في خيرهم قبيلة ، ثم جعلهم بيوتا فجعلني في خيرهم بيتا ؛ فأنا خيركم بيتا وخيركم نفسا .(@)(@@) % ( حم ، ت - عن المطلب ابن أبي وداعة ) ( كلا الحديثين في سنن الترمذي كتاب المناقب باب فضل النبي صلى الله عليه وسلم رقم ( 3607 و 3608 ) وقال : حسن ص ) .(@)(@@) 31951 - إن الله تعالى فضلني على الأنبياء بأربع : أرسلني إلى الناس كافة ، وجعل الأرض كلها لي ولأمتي طهورا ومسجدا فأينما أدرك رجل من أمتي الصلاة فعنده مسجده وعنده طهوره ، ونصرني بالرعب مسيرة شهر ، وأحل لي الغنائم .(@)(@@) % ( طب والضياء - عن أبي 
ms4347	 أمامة ) .(@)(@@) 31952 - إن الله تعالى قد اتخذني خليلا .(@)(@@) % ( ك - عن جندب ) .(@)(@@) 31953 - إن الجنة حرمت على الأنبياء كلهم حتى أدخلها وحرمت على الأمم حتى تدخلها أمتي .(@)(@@) % ( ابن النجار - عن عمر ) .(@)(@@) 31954 - إن عدو الله ابليس جاء بشهاب من نار ليجعله في وجهي فقلت : أعوذ بالله منك ثلاث مرات ! ثم قلت : ألعنك بلعنة الله التامة ، فلم يستأخر ثلاث مرات ، ثم أردت أن آخذه ، والله ! لولا دعوة أخينا سليمان لأصبح موثقا يلعب به ولدان أهل المدينة .(@)(@@) % ( م ، ن - عن أبي الدرداء ) ( أخرجه مسلم كتاب المساجد باب جواز لعن الشيطان رقم ( 542 ) ص ) .(@)(@@) PageV11P187(@)(@@) 31955 - إن الشيطان عرض لي فشد علي ليقطع الصلاة علي فأمكنني الله منه فدعته ، ولقد هممت أن أوثقه إلى سارية حتى تصبحوا فتنظروا إليه فذكرت قول سليمان : { رب هب لي ملكا لا ينبغي لأحد من بعدي } فرده الله خاسئا .(@)(@@) % ( خ ( أخرجه البخاري كتاب الصلاة باب ما يجوز من العمل في الصلاة ( 2 / 81 ) فذعته : بالذال وفدعته من قول الله يوم يدعون أي يدفعون ، والصواب فدعته إلا أنه كذا قال بتشديد العين والتاء . ص ) عن أبي هريرة ) .(@)(@@) 31956 - إن عفريتا من الجن تفلت ( تفلت : أي تعرض لي في صلاتي فجأة . النهاية ( 3 / 467 ) ب ) علي البارحة ليقطع علي الصلاة فأمكنني الله منه فدعته وأردت أن أربطه إلى سارية من سواري المسجد حتى تصبحوا وتنظروا إليه كلكم فذكرت قول أخي سليمان : { رب اغفر لي وهب لي ملكا لا ينبغي لأحد من بعدي } فرده الله خاسئا .(@)(@@) % ( حم ، ق ( أخرجه مسلم كتاب المساجد باب جواز لعن الشيطان رقم ( 541 ) ص ) ، ن - عن أبي هريرة ) .(@)(@@) 31957 - إن عدو الله إبليس لما علم أن الله قد استجاب دعائي وغفر لأمتي أخذ التراب فجعل يحثوه على رأسه ويدعو بالويل والثبور فأضحكني ما رأيته من جزعه .(@)(@@) % ( ه ، عم - عن العباس بن مرداس ) ( أخرجه ابن ماجه كتاب المناسك باب الدعاء بعرفة رقم ( 2013 ) وقال في الزوائد في إسناده عبد الله بن كنانة قال البخاري لم يصح حديثه ص ) .(@)(@@) 31958 
ms4348	 - إنه ليس شيء بين السماء والأرض إلا يعلم أني رسول الله إلا عاصي الجن والإنس .(@)(@@) % ( حم والدارمي والضياء - عن جابر ) .(@)(@@) 31959 - إني سألت ربي وشفعت لأمتي فأعطاني ثلث أمتي فخررت ساجدا شكرا لربي ثم رفعت رأسي فسألت ربي لأمتي فأعطاني ثلث أمتي فخررت ساجدا لربي شكرا ، ثم رفعت رأسي فسألت ربي لأمتي فأعطاني الثلث الآخر فخررت ساجدا لربي .(@)(@@) % ( د - عن سعد ) ( أخرجه أبو داود كتاب الجهاد باب في سجود الشكر رقم ( 2758 ) ، وقال المنذري في عون المعبود ( 7 / 465 ) وقال في إسناده موسى بن يعقوب الزمعي وفيه مقال . ص ) .(@)(@@) 31960 - إني عند الله في أم الكتاب لخاتم النبيين وإن آدم لمنجدل في طينته وسأخبركم بتأويل ذلك ، دعوة أبي إبراهيم وبشارة عيسى بي ورؤيا أمي التي رأت حين وضعت أنه خرج منها نور أضاءت له قصور الشام وكذلك أمهات النبيين يرين .(@)(@@) % ( حم ، طب ، ك ، حل ، هب - عن عرباض ابن سارية ) .(@)(@@) 31961 - إني لأراكم من ورائي كما أراكم .(@)(@@) % ( خ - عن أنس ) ( أخرجه البخاري كتاب الصلاة باب عظة الإمام الناس في اتمام الصلاة وذكر القبلة ( 1 / 114 ) ( 1 / 189 ) ص ) .(@)(@@) 31962 - هل ترون قبلتي ههنا ؟ فوالله ما يخفى علي خشوعكم ولا ركوعكم ! إني لأراكم من وراء ظهري .(@)(@@) % ( مالك ، ق - عن أبي هريرة ) ( أخرجه البخاري كتاب الصلاة باب عظة الإمام الناس في اتمام الصلاة وذكر القبلة ( 1 / 114 ) ( 1 / 189 ) ص ) .(@)(@@) 31963 - إني حين ضربت الضربة الأولى رفعت لي مدائن كسرى وما حولها ومدائن كثيرة حتى رأيتها بعيني ، ثم ضربت الضربة الثانية فرفعت لي مدائن قيصر وما حولها حتى رأيتها بعيني ، ثم ضربت الثالثة فرفعت لي مدائن الحبشة وما حولها من القرى حتى رأيتها بعيني ، دعوا الحبشة ما ودعوكم ! واتركوا الترك ما تركوكم .(@)(@@) % ( ن - عن رجل ) .(@)(@@) PageV11P188(@)(@@) 31964 - أنا أتقاكم لله وأعلمكم لحدود الله .(@)(@@) % ( حم - عن رجل من الأنصار ) .(@)(@@) 31965 - أنا أول من يأخذ بحلقة باب الجنة فأقعقعها ( فأقعقعها : أي أحركها لتصوت . والقعقعة : حكاية حركة الشيء يسمع له صوت . النهاية ( 4 / 88 ) ب ) .(@)(@@) % ( حم ، والدارمي 
ms4349	 ت - عن أنس ) ( أخرجه الترمذي كتاب تفسير القرآن تفسير بني إسرائيل رقم ( 3148 ) وقال : حسن صحيح . ص ) .(@)(@@) 31966 - أنا أول شفيع في الجنة لم يصدق نبي من الأنبياء ما صدقت ، وإن من الأنبياء نبيا ما يصدقه من أمته إلا رجل واحد .(@)(@@) % ( م - عن أنس ) ( أخرجه مسلم كتاب الإيمان رقم ( 196 ) ص ) .(@)(@@) 31967 - أنا أول الناس يشفع في الجنة ، وأنا أكثر الأنبياء تبعا .(@)(@@) % ( م - عن أنس ) ( أخرجه مسلم كتاب الإيمان رقم ( 196 ) ص ) .(@)(@@) 31968 - ألا تعجبون كيف يصرف الله عني شتم قريش ولعنهم ؟ يشتمون مذمما ويلعنون مذمما وأنا محمد .(@)(@@) % ( خ ، ن - عن أبي هريرة ) ( أخرجه البخاري كتاب المناقب باب ما جاء في أسماء رسول الله صلى الله عليه وسلم ( 4 / 25 ) ص ) .(@)(@@) 31969 - بعثت لأتمم مكارم الأخلاق .(@)(@@) % ( ك - عن أبي هريرة ) .(@)(@@) 31970 - قد سمعت كلامكم وعجبكم إن إبراهيم خليل الله وهو كذلك ، وموسى نجي الله وهو كذلك ، وعيسى روحه وكلمته وهو كذلك ، وآدم اصطفاه الله وهو كذلك ، ألا ! وأنا حبيب الله ولا فخر ، وأنا حامل لواء الحمد يوم القيامة ولا فخر ، وأنا أول شافع وأول مشفع يوم القيامة ولا فخر ، وأنا أول من يحرك حلق الجنة فيفتح الله لي فيدخلنيها ومعي فقراء المؤمنين ولا فخر ، وأنا أكرم الأولين والآخرين ولا فخر .(@)(@@) % ( ت - عن ابن عباس ) ( أخرجه الترمذي كتاب المناقب باب في فضل النبي صلى الله عليه وسلم رقم ( 3616 ) وقال : غريب . ص ) .(@)(@@) 31971 - إن الله تعالى قد رفع لي الدنيا فأنا أنظر إليها وإلى ما هو كائن فيها إلى يوم القيامة كأنما أنظر إلى كفي هذه جليان من الله جلاه لنبيه كما جلاه للنبيين من قبله .(@)(@@) % ( طب ، حل - عن ابن عمر ) .(@)(@@) 31972 - قد رأيت الآن منذ صليت لكم الصلاة الجنة والنار ممثلتين لي في قبل هذا الجدار فلم أر كاليوم في الخير والشر .(@)(@@) % ( خ عن أنس ) . مر برقم [ 31918 ] .(@)(@@) 31973 - ما رأيت في الخير والشر كاليوم قط ! إنه صورت لي الجنة والنار حتى رأيتهما وراء الحائط .(@)(@@) % ( خ - عن أنس ) ( أخرجه البخاري 
ms4350	 كتاب الفتن باب التعوذ من الفتن ( 9 / 67 ) ص ) .(@)(@@) 31974 - لتخرجن الظعينة من المدينة حتى تدخل الحيرة لا تخاف أحدا .(@)(@@) % ( حل - عن جابر بن سمرة ) .(@)(@@) 31975 - من أحب أن يسأل عن شيء فليسأل عنه ، فوالله ! لا تسألوني عن شيء إلا أخبرتكم به ما دمت في مقامي هذا ، والذي نفسي بيده ! لقد عرضت علي الجنة والنار آنفا في عرض هذا الحائط وأنا أصلي فلم أر كاليوم في الخير والشر .(@)(@@) % ( حم ، ق - عن أنس ( أخرجه البخاري كتاب مواقيت الصلاة باب وقت الظهر ( 1 / 143 ) ص ) ) .(@)(@@) 31976 - نحن بنو النضر بن كنانة لا نقفو ( لا نقفو أمنا : أي لا نتهمهما ولا نقذفها . يقال : قفا فلان فلانا إذا قذفه بما ليس فيه . النهاية ( 4 / 95 ) ص ) أمنا ولا ننتفي من أبينا .(@)(@@) % ( حم ، ه - عن الأشعث بن قيس ) ( أخرجه ابن ماجه كتاب الحدود باب من نفى رجلا من قبيلته رقم ( 2612 ) وقال في الزوائد : هذا إسناد صحيح رجاله ثقات . ص ) .(@)(@@) PageV11P189(@)(@@) 31977 - وعدني ربي أن يدخل الجنة من أمتي سبعين ألفا لا حساب عليهم ولا عذاب ، مع كل ألف سبعون ألفا وثلاث حثيات من حسيات ربي .(@)(@@) % ( حم ، ت ، ه ، حب - عن أبي أمامة ) ( أخرجه الترمذي كتاب صفة القيامة باب 12 ( 2437 ) وقال حسن غريب ص ) .(@)(@@) 31978 - لا تسألوني عن شيء إلى يوم القيامة إلا حدثتكم .(@)(@@) % ( حم ، ق - عن عائشة ) .(@)(@@) 31979 - يا عائشة إن عيني تنامان ولا ينام قلبي .(@)(@@) % ( خ ، ن - عن عائشة ) ( أخرجه البخاري كتاب باب التهجد ( 2 / 66 ) ص ) .(@)(@@) 31980 - ألا تأمنوني وأنا أمين من في السماء ؟ يأتيني خبر السماء صباحا ومساء .(@)(@@) % ( حم ، ق - عن أبي سعيد ) ( أخرجه مسلم كتاب الزكاة باب ذكر الخوارج رقم ( 144 ) ص ) .(@)(@@) 31981 - مثلي في النبيين كمثل رجل بنى دارا فأحسنها وأكملها وأجملها وترك فيها موضع لبنة لم يضعها فجعل الناس يطوفون بالبنيان ويعجبون منه ويقولون : لو تم موضع هذه اللبنة ! فأنا في النبيين موضع تلك اللبنة .(@)(@@) % ( حم ، ت - عن أبي ؛ حم ، ق ، ت - عن جابر ؛ حم ، ق - عن أبي 
ms4351	 هريرة ؛ حم ، م ( أخرجه مسلم كتاب الفضائل باب ذكر كونه صلى الله عليه وسلم خاتم النبيين رقم ( 21 / 2286 ) ص ) - عن أبي سعيد ) .(@)(@@) 31982 - لقد لقيت من قومك ما لقيت وكان أشد ما لقيت منهم يوم العقبة إذ عرضت نفسي على ابن عبد يا ليل بن عبد كلال فلم يجيبني إلى ما أردت فانطلقت وأنا مهموم على وجهي فلم أستفق إلا وأنا بقرن الثعالب فرفعت رأسي فإذا أنا بسحابة قد أظلتني فنظرت فإذا فيها جبرئيل فناداني فقال : إن الله عز وجل قد سمع قول قومك لك وما ردوا عليك وقد بعث الله إليك ملك الجبال لتأمره بما شئت فيهم فناداني ملك الجبال فسلم علي ثم قال : يا محمد ! فقال ذلك فما شئت إن شئت أن أطبق عليهم الأخشبين ، قلت بل أرجو أن يخرج الله من أصلابهم من يعبد الله وحده لا يشرك به شيئا .(@)(@@) % ( حم ، ق - عن عائشة ) ( أخرجه مسلم كتاب الجهاد باب ما لقي النبي صلى الله عليه وسلم من أذى المشركين والمنافقين رقم ( 1795 ) ص ) .(@)(@@) 31983 - إن الله عز وجل اصطفى كنانة من ولد إسماعيل ، واصطفى قريشا من كنانة ، واصطفى من قريش بني هاشم ، واصطفاني من بني هاشم .(@)(@@) % ( ت - عن واثلة ) ( أخرجه الترمذي كتاب المناقب باب في فضل النبي صلى الله عليه وسلم ( 3605 ) ورقم ( 3606 ) وقال : حسن صحيح ص ) .(@)(@@) 31984 - إن الله عز وجل اصطفى من ولد إبراهيم إسماعيل ، واصطفى من ولد إسماعيل بني كنانة ، واصطفى من كنانة قريشا ، واصطفى من قريش بني هاشم ، واصطفاني من بني هاشم .(@)(@@) % ( ت - عن واثلة ) ( أخرجه الترمذي كتاب المناقب باب في فضل النبي صلى الله عليه وسلم ( 3605 ) ورقم ( 3606 ) وقال : حسن صحيح ص ) .(@)(@@) 31985 - إن الله تعالى بعثني رحمة مهداة وبعثني برفع قوم وخفض آخرين .(@)(@@) % ( ابن عساكر - عن ابن عمر ) .(@)(@@) 31986 - إن الله تعالى جعلني عبدا كريما ولم يجعلني جبارا عنيدا .(@)(@@) % ( د ( أخرجه أبو داود كتاب الأطعمة باب في الأكل من أعلى الصحفة رقم ( 3755 ) ص ) ه - عن عبد الله 
ms4352	 بن بسر ) .(@)(@@) PageV11P190(@)(@@) 31987 - إن الله تعالى خلق الخلق فجعلني من خير فرقهم وخير الفريقين ، ثم تخير القبائل فجعلني من خير قبيلة ، ثم تخير البيوت فجعلني من خير بيوتهم ، فأنا خيرهم نفسا وخيرهم بيتا .(@)(@@) % ( ت - عن العباس بن عبد المطلب ) ( أخرجه الترمذي كتاب المناقب باب في فضل النبي صلى الله عليه وسلم رقم ( 3607 ) و ( 3608 ) ؟ ؟ وقال : حسن ص ) .(@)(@@) 31988 - إن الله زوجني في الجنة مريم بنت عمران وامرأة فرعون وأخت موسى .(@)(@@) % ( طب - عن سعد بن جنادة ) .(@)(@@) 31989 - إن الله تعالى لم يبعثني معنتا ولا متعنتا ( معنتا : أي مشددا على الناس وملزما إياهم ما يصعب عليهم . ولا متعنتا : أي طالبا زلتهم أصل العنت : المشقة . متن صحيح مسلم ( 2 / 105 ) ب ) ولكن بعثني معلما ميسرا .(@)(@@) % ( م - عن عائشة ) ( أخرجه مسلم كتاب الطلاق باب بيان أن تخبير امرأته رقم ( 1478 ) ص ) .(@)(@@) 31990 - إن الله تعالى لم يجعلني لحانا ، اختار لي خير الكلام كتابه القرآن .(@)(@@) % ( الشيرازي في الألقاب - عن أبي هريرة ) .(@)(@@) 31991 - إن أتقاكم وأعلمكم بالله أنا .(@)(@@) % ( خ - عن عائشة ) ( أخرجه البخاري كتاب الإيمان باب قول النبي صلى الله عليه وسلم : أنا أعلمكم بالله . ( 1 / 12 ) ص ) .(@)(@@) 31992 - إن لكل نبي ولاة من النبيين وإن وليي منهم أبي وخليل ربي .(@)(@@) % ( ت ( أخرجه الترمذي كتاب التفسير سورة آل عمران رقم ( 2995 ) ص ) - عن ابن مسعود ) .(@)(@@) 31993 - إنا معشر الأنبياء تنام أعيننا ولا تنام قلوبنا .(@)(@@) % ( ابن سعد - عن عطاء مرسلا ) .(@)(@@) 31994 - إنما بعثت فاتحا وخاتما ، وأعطيت جوامع الكلم وفواتحه ، واختصر لي الحديث اختصارا فلا يهلكنكم المتهوكون ( المتهوكون : التهوك كالتهور ، وهو الوقوع في الأمر بغير روية . والمتهوك : الذي يقع في كل أمر . النهاية ( 5 / 282 ) ب ) .(@)(@@) % ( هب - عن أبي قتادة مرسلا ) .(@)(@@) 31995 - أنا رحمة مهداة .(@)(@@) % ( ابن سعد والحكيم - عن أبي صالح مرسلا ؛ ك - عن أبي هريرة ) .(@)(@@) 31996 - إنما بعثت لأتمم صالح الأخلاق .(@)(@@) % ( ابن سعد ، خد ، ك هب - عن أبي هريرة ) .(@)(@@) 31997 - إنما بعثت رحمة ولم أبعث عذابا .(@)(@@) % ( تخ - عن أبي هريرة ) .(@)(@@) 31998 - إنما بعثني الله تعالى مبلغا 
ms4353	 ولم يبعثني متعنتا .(@)(@@) % ( ت عن عائشة ) ( أخرجه الترمذي كتاب التفسير من حديث طويل رقم ( 3318 ) وقال : حسن صحيح . ص ) .(@)(@@) 31999 - أوتيت مفاتيح كل شيء إلا الخمس { إن الله عنده علم الساعة } الآية .(@)(@@) % ( طب - عن ابن عمر ) .(@)(@@) 32000 - إني لأعرف حجرا بمكة كان يسلم علي قبل أن أبعث .(@)(@@) % ( حم ، م ( أخرجه مسلم كتاب الفضائل باب فضل نسب النبي صلى الله عليه وسلم رقم ( 2277 ) وتمام الحديث : إني لأعرفه الآن . ص ) ، ت - عن جابر بن سمرة ) .(@)(@@) 32001 - تستفتحون منابت الشيح .(@)(@@) % ( طب - عن معاوية ) .(@)(@@) 32002 - أوتي موسى الألواح وأوتيت المثاني .(@)(@@) % ( أبو سعيد النقاش في فوائد العراقيين - عن ابن عباس ) .(@)(@@) PageV11P191(@)(@@) 32003 - أول من تنشق عنه الأرض أنا ولا فخر ، ثم تنشق عن أبي بكر وعمر ، ثم تنشق عن الحرمين مكة والمدينة ، ثم أبعث بينهما .(@)(@@) % ( ك - عن ابن عمر ) .(@)(@@) 32004 - بعثت إلى الناس كافة ! فإن لم يستجيبوا لي فإلى العرب ، فإن لم يستجيبوا لي فإلى قريش ، فإن لم يستجيبوا لي فإلى بني هاشم ، فإن لم يستجيبوا لي فإلي وحدي .(@)(@@) % ( ابن سعد - عن خالد بن معدان مرسلا ) .(@)(@@) 32005 - بعثت من خير قرون بني آدم قرنا فقرنا حتى كنت من القرن الذي كنت فيه .(@)(@@) % ( خ - عن أبي هريرة ) ( أخرجه البخاري كتاب المناقب باب صفة النبي صلى الله عليه وسلم ( 4 / 229 ) ص ) .(@)(@@) 32006 - سألت ربي أن لا يعذب اللاهين ( اللاهين : هم البله الغافلون . النهاية ( 4 / 283 ) ب ) من ذرية البشر فأعطانيهم .(@)(@@) % ( ش ، قط في الأفراد والضياء - عن أنس ) .(@)(@@) 32007 - سألت ربي أبناء العشرين من أمتي فوهبهم لي .(@)(@@) % ( ابن أبي الدنيا - عن أبي هريرة ) .(@)(@@) 32008 - يا أم فلان ! اجلسي في أي نواحي السكك شئت أجلس إليك .(@)(@@) % ( حم ، م ، د عن أنس ) ( أخرجه مسلم كتاب الفضائل باب قرب النبي صلى الله عليه وسلم من الناس رقم ( 2326 ) ص ) .(@)(@@) 32009 - ما اختلط حبي بقلب عبد إلا حرم الله جسده على النار .(@)(@@) % ( حل - عن ابن عمر ) .(@)(@@) | 1 ( { الإكمال } من فضائل متفرقة تنبيء عن التحدث بالنعم ) 1(@)(@@) 32010 - كنت وآدم في الجنة 
ms4354	 في صلبه ، وركب بي السفينة في صلب أبي نوح ، وقذف بي في النار في صلب إبراهيم ، لم يلتق أبواي قط على سفاح ، ولم يزل الله ينقلني من الأصلاب الحسنة إلى الأرحام الطاهرة ، صفي مهدي لا يتشعب شعبتان إلا كنت في خيرهما ، قد أخذ الله بالنبوة ميثاقي ، وبالإسلام عهدي ، ونشر في التوراة والانجيل ذكري ، وبين كل نبي صفتي ، تشرق الأرض بنوري والغمام لوجهي ، وعلمني كتابه ، ورقاني في سمائه ، وشق لي اسما من أسمائه فذو العرش محمود وأنا محمد ، وعدني أن يحبوني ( يحبوني : يقال : حباه كذا وبكذا : إذا أعطاه . والحباء : العطية . انتهى . النهاية ( 1 / 336 ) ب ) بالحوض والكوثر وأن يجعلني أول شافع وأول مشفع ، ثم أخرجني من خير قرن لأمتي وهم الحمادون يأمرون بالمعروف وينهون عن المنكر .(@)(@@) % ( ابن عساكر - عن ابن عباس ؛ وقال : غريب جدا ) .(@)(@@) 32011 - لما بلغ ولد معد بن عدنان أربعين رجلا وقعوا على عسكر موسى فانتهبوه فدعا عليهم موسى قال : يا رب ! هؤلاء ولد معد قد أغاروا على عسكري فأوحى الله إليه يا موسى ! لا تدعو عليهم فإن منهم النبي الأمي النذير البشير نخبتي ومنهم الأمة المرحومة أمة محمد الذين يرضون من الله باليسير من الرزق ويرضى الله منهم بالقليل من(@)(@@) PageV11P192 العمل فيدخلهم الجنة بقول لا إله إلا الله لأن فيهم نبيهم محمد بن عبد الله بن عبد المطلب المتواضع في هيبته ، المجتمع له اللب في سكوته ، ينطق بالحكمة ويستعمل الحكم ، أخرجته من خير جيل من أمته قرشيا ، ثم أخرجته من بني هاشم صفوة قريش ، فهم خير من خير يصير هو وأمته إلى خير يصيرون .(@)(@@) % ( طب - عن أبي أمامة ) .(@)(@@) 32012 - نحن بنو النضر بن كنانة لا نقفوا أمنا ولا ندعو لغير أبينا .(@)(@@) % ( ابن سعد - عن الزهري مرسلا ) .(@)(@@) 32013 - إنما ذلك شيء كان يقوله العباس بن عبد المطلب وأبو سفيان ابن حرب ليأمنا باليمن ، معاذ الله أن نزني أمنا أو نقفو أبانا ! نحن بنو النضر بن كنانة ، من قال غير ذلك فقد كذب .(@)(@@) % ( ابن سعد - عن ابن أبي ذئب عن 
ms4355	 أبيه ) . أنه قيل لرسول الله صلى الله عليه وسلم : إن ههنا ناسا من كندة يزعمون أنك منهم قال : فذكره .(@)(@@) 32014 - إني خرجت من نكاح ولم أخرج من سفاح .(@)(@@) % ( طب ، عب وابن جرير - عن جعفر بن محمد مرسلا ) .(@)(@@) 32015 - إنما خرجت من نكاح ولم أخرج من سفاح من لدن آدم ، ولم يصبني من سفاح أهل الجاهلية شيء ، لم أخرج إلا من طهره .(@)(@@) % ( ابن سعد - عن محمد بن علي بن حسين مرسلا ) .(@)(@@) 32016 - خرجت من نكاح ولم أخرج من سفاح .(@)(@@) % ( عب - عن جعفر محمد عن أبيه مرسلا ) .(@)(@@) 32017 - خرجت من نكاح ولم أخرج من سفاح من لدن آدم إلى أن ولدني أبي وأمي ولم يصبني من سفاح الجاهلية شيء .(@)(@@) % ( ابن أبي عمر ) .(@)(@@) 32018 - ما ولدني من سفاح أهل الجاهلية شيء ، ما ولدني إلا نكاح كنكاح الإسلام .(@)(@@) % ( طب ، هق وابن عساكر - عن ابن عباس ) .(@)(@@) 32019 - ما ولدتني بغي قط منذ خرجت من صلب آدم ، ولم تزل تنازعني الأمم كابرا عن كابر حتى خرجت من أفضل حيين من العرب : هاشم وزهرة .(@)(@@) % ( ابن عساكر - عن أبي هريرة ) .(@)(@@) 32020 - أنا محمد بن عبد الله بن عبد المطلب - فانتسب حتى بلغ النضر ابن كنانة ، فمن قال غير ذلك فقد كذب .(@)(@@) % ( ابن سعد - عن عمرو بن العاص ) .(@)(@@) 32021 - مضر بن نزار بن معد بن عدنان بن أدد بن الهميسع بن ثابت ابن إسماعيل بن إبراهيم خليل الرحمن بن آزر .(@)(@@) % ( ابن عساكر - عن شريك ابن عبد الله بن أبي نمر عن أبيه ) .(@)(@@) PageV11P193(@)(@@) 32022 - معد بن عدنان بن أدد بن زيد بن ثرى بن أعراق الثرى .(@)(@@) % ( ابن سعد - عن كريمة بنت المقداد بن الأسود البهراني ) .(@)(@@) 32023 - معد بن عدنان بن أدد بن زيد بن ثرى بن أعراق الثرى ، أهلك عادا وثمود وأصحاب الرس وقرونا بين ذلك كثيرا لا يعلمهم إلا الله .(@)(@@) % ( طس ، كر وابن عساكر - عن أم سلمة ) .(@)(@@) 32024 - أدبني ربي ونشأت في بني سعد .(@)(@@) % ( كر - عن محمد بن عبد الرحمن الزهري عن أبيه عن جده ) أن أبا بكر قال 
ms4356	 : يا رسول الله ! لقد طفت في العرب وسمعت فصحاءهم فما سمعت أفصح منك ، فمن أدبك ؟ قال : فذكره .(@)(@@) 32025 - أتاني جبريل فقال : يا محمد ! لولاك ما خلقت الجنة ، ولولاك ما خلقت النار .(@)(@@) % ( الديلمي - عن ابن عباس ) .(@)(@@) 32026 - أتاني ملك جرمه يساوي الكعبة فقال : اختر أن تكون نبيا ملكا أو نبيا عبدا ، فأومى إلي جبريل أن تواضع لله ، فقلت : بل أحب أن أكون نبيا عبدا ، فشكر ربي عز وجل ذلك فقال : أنت أول من تنشق عنه الأرض وأول شافع .(@)(@@) % ( كر - عن عائشة وابن عباس ؛ حم ، ع - عن أبي هريرة ) .(@)(@@) 32027 - لقد هبط علي ملك من السماء ما هبط على نبي قبلي ولا يهبط على أحد بعدي وهو إسرافيل وعندي جبريل فقال : السلام عليك يا محمد ! ثم قال : أنا رسول ربك إليك ، أمرني أن أخيرك إن شئت نبيا عبدا وإن شئت نبيا ملكا ، فنظرت إلى جبريل فأومى جبريل إلي أن تواضع ، فقلت : نبيا عبدا ، فلو أني قلت : نبيا ملكا ، ثم شئت لسارت الجبال معي ذهبا .(@)(@@) % ( طب - عن ابن عمر ) .(@)(@@) 32028 - يا عائشة ! لو شئت لسارت معي جبال الذهب ، جاءني ملك إن حجزته لتساوي الكعبة فقال : إن ربك يقرأ عليك السلام ويقول لك : إن شئت نبيا عبدا وإن شئت نبيا ملكا ، فنظرت إلى جبريل فأشار إلي أن ضع نفسك ، فقلت نبيا عبدا .(@)(@@) % ( ابن سعد ، ع وابن عساكر - عن عائشة ) .(@)(@@) 32029 - خيرني ربي بين أن أكون نبيا ملكا أو أكون نبيا عبدا ولم أدر ما أقول وكان صفيي من الملائكة فنظرت إليه فقال بيده أن تواضع ، فقلت : نبيا عبدا .(@)(@@) % ( هناد - عن الشعبي مرسلا ) .(@)(@@) 32030 - يا عائشة ! لو شئت لسارت معي جبال الذهب والفضة .(@)(@@) % ( ابن سعد والخطيب - عن عائشة ) .(@)(@@) 32031 - إذا كان يوم القيامة كنت أول من تنشق الأرض عني ولا فخر ، ويتبعني بلال المؤذن ويتبعه سائر المؤذنين وهو واضع يده في أذنه وهو ينادي : أشهد أن لا إله(@)(@@) PageV11P194 إلا الله وأن محمدا رسول الله أرسله بالهدى ودين الحق ليظهره على الدين كله ولو كره المشركون 
ms4357	 ، وسائر المؤذنين ينادون معه حتى نأتي أبواب الجنة .(@)(@@) % ( عق ، كر - عن أنس ! وفيه حكاية بنت عثمان بن دينار ، قال عق : أحاديثها تشبه أحاديث القصاص ليس لها أصول ) .(@)(@@) 32032 - أنا أول من تنشق عنه الأرض ولا فخر .(@)(@@) % ( ش ، طب - عن ابن عباس ) .(@)(@@) 32033 - أنا سيد ولد آدم يوم القيامة ولا فخر ، وأنا أول من تنشق عنه الأرض ولا فخر ، وأول شافع ومشفع ، لواء الحمد بيدي يوم القيامة ، تحتي آدم فمن دونه .(@)(@@) % ( طب - عن عبد الله بن سلام ) .(@)(@@) 32034 - أنا أول من تنشق الأرض عن جمجمتي ( جمجمتي : الجمجمة : الرأس ، وهو أشرف الأعضاء . انتهى . النهاية ( 10 / 299 ) ص ) يوم القيامة ولا فخر ، وأعطى لواء الحمد ، ولا فخر ، وأنا سيد الناس يوم القيامة ولا فخر .(@)(@@) % ( الخرائطي في مكارم الأخلاق - عن أنس ) .(@)(@@) 32035 - أنا أول من تنشق عنه الأرض ثم أبو بكر ثم عمر ، فنحشر فنذهب إلى البقيع فيحشرون معي ، ثم أنتظر أهل مكة فيحشرون معي ، ونبعث بين الحرمين .(@)(@@) % ( ت : حسن ( أخرجه الترمذي كتاب المناقب باب مناقب عمر بن الخطاب رقم ( 3692 ) وقال : هذا حديث غريب . ص ) غريب ، وأبو عروبة في الأوائل ، طب ، ك وابن عساكر وأبو نعيم في فضائل الصحابة - عن ابن عمر ) .(@)(@@) 32036 - أنا أول من تنشق عنه الأرض فأكون أول من يبعث فأخرج أنا وأبو بكر إلى أهل البقيع فيبعثون ثم يبعث أهل مكة فأحشر بين الحرمين .(@)(@@) % ( ابن عساكر - عن أبي هريرة ) .(@)(@@) 32037 - أنا أول من تنشق عنه الأرض وأول شافع .(@)(@@) % ( ش - عن الحسن مرسلا ) .(@)(@@) 32038 - إني لسيد الناس يوم القيامة ، لا فخر ولا رياء ، وما من الناس من أحد إلا وهو تحت لوائي يوم القيامة ينتظر الفرج وأنا بيدي لواء الحمد فأمشي ويمشي الناس معي حتى آتي باب الجنة فأستفتح فيقال : من هذا ؟ فأقول : محمد ، فيقال : مرحبا بمحمد ! فإذا رأيت ربي عز وجل خررت له ساجدا شكرا له فيقال : ارفع رأسك ، وقل تطاع ، واشفع تشفع ، فيخرج من النار من قد احترق برحمة الله وشفاعتي .(@)(@@) % ( ك وابن عساكر - عن عبادة بن الصامت 
ms4358	 ) .(@)(@@) 32039 - أنا سيد النبيين ولا فخر .(@)(@@) % ( سمويه ، ص - عن جابر ) .(@)(@@) 32040 - أنا سيد ولد آدم ولا فخر .(@)(@@) % ( ك - عن جابر ) .(@)(@@) | 1 ( تتمة الإكمال من فضائل متفرقة تنبيء عن التحدث بالنعم ) 1(@)(@@) 32041 - يبعث الناس يوم القيامة فأكون أنا وأمتي على تل ويكسوني ربي حلة خضرا ، ثم يؤذن لي فأقول ما شاء الله أن أقول ، فذلك المقام المحمود .(@)(@@) % ( حم ، طب ، ك وابن عساكر - عن كعب بن مالك ) .(@)(@@) PageV11P195(@)(@@) 32042 - أنا سيد الناس يوم القيامة يدعوني ربي فأقول : لبيك وسعديك والخير بيديك والشر ليس إليك والمهدي من هديت وعبدك بين يديك ولا ملجأ ولا منجا منك إلا إليك تباركت رب البيت .(@)(@@) % ( ك والخرائطي في مكارم الأخلاق وابن عساكر - عن حذيفة ) .(@)(@@) 32043 - أنا سيد المرسلين إذا بعثوا ، وسابقهم إذا وردوا ، ومبشرهم إذا أيسوا ، وإمامهم إذا سجدوا ، وأقربهم مجلسا إذا اجتمعوا ، أتكلم فيصدقني ، وأشفع فيشفعني ، وأسأل فيعطيني .(@)(@@) % ( ابن النجار - عن أم كرز ) .(@)(@@) 32044 - أنا أشرف الناس حسبا ولا فخر ، وأكرم الناس قدرا ولا فخر . أيها الناس ! من أتانا أتيناه ، ومن أكرمنا أكرمناه ، ومن كاتبنا كاتبناه ، ومن شيع موتانا شيعنا موتاه ، ومن قام بحقنا قمنا بحقه ؛ أيها الناس ! حاسبوا الناس على قدر أحسابهم ، وخالطوا الناس على قدر أديانهم ، وأنزلوا الناس على قدر مرواتهم ، وداروا الناس بعقولكم .(@)(@@) % ( الديلمي - عن جابر ) .(@)(@@) 32045 - أنا أول الناس خروجا إذا بعثوا ، وخطيبهم إذا وفدوا ، وأنا مبشرهم إذا أيسوا ، لواء الحمد بيدي ، وأنا أكرم ولد آدم على ربي ولا فخر .(@)(@@) % ( الدارمي ، ت : حسن غريب - عن أنس ) .(@)(@@) 32046 - إن أول لواء يقرع باب الجنة لوائي ، وإن أول من يؤذن له في الشفاعة أنا ولا فخر .(@)(@@) % ( ش - عن أبي إسحاق عن رجل ) .(@)(@@) 32047 - أنا أول من يقرع باب الجنة فيقوم الخازن فيقول : من أنت ؟ فأقول : أنا محمد ، فيقول : أقوم فأفتح لك ولم أقم لأحد قبلك ولا أقوم لأحد بعدك .(@)(@@) % ( الخليلي في مشيخته - عن أنس ) .(@)(@@) 32048 - أنا أول من يدخل الجنة وأول من يشفع .(@)(@@) % ( ابن خزيمة - عن أنس ) .(@)(@@) 32049 - حرمت الجنة على الأنبياء كلهم حتى 
ms4359	 أدخلها ، وحرمت على الأمم كلهم حتى تدخلها أمتي .(@)(@@) % ( قط في الأفراد - عن عمر ؛ قال الحافظ ابن حجر في أطرافه : وهو صحيح على شرط الحاكم ) .(@)(@@) 32050 - أنا أول شفيع في الجنة ، لم يصدق نبي من الأنبياء ما صدقت ، وإن من الأنبياء نبيا ما يصدقه من أمته إلا رجل واحد .(@)(@@) % ( ش ، م ( أخرجه مسلم كتاب الإيمان باب قول النبي صلى الله عليه وسلم أنا أول الناس رقم ( 330 و 331 و 332 ) ص ) ، والدارمي وابن خزيمة ، حب - عنه ) .(@)(@@) 32051 - أنا ؟ ؟ الناس يشفع في الجنة ، وأنا أكثر الناس تبعا .(@)(@@) % ( م - عنه ) ( أخرجه مسلم كتاب الإيمان باب قول النبي صلى الله عليه وسلم أنا أول الناس رقم ( 330 و 331 و 332 ) ص ) .(@)(@@) 32052 - أنا أول أكثر الأنبياء تبعا يوم القيامة ، وأنا أول من يقرع باب الجنة .(@)(@@) % ( م - عنه ) ( أخرجه مسلم كتاب الإيمان باب قول النبي صلى الله عليه وسلم أنا أول الناس رقم ( 330 و 331 و 332 ) ص ) .(@)(@@) PageV11P196(@)(@@) 32053 - أول عين تنظر إلى الله عز وجل عيني .(@)(@@) % ( الديلمي - عن أنس ) .(@)(@@) 32054 - والله ! لا تجدون أعدل مني .(@)(@@) % ( طب ، حم - عن أبي هريرة ) .(@)(@@) 32055 - أنا قائد المرسلين ولا فخر ، وأنا خاتم النبيين ولا فخر ، وأنا أول شافع ومشفع ولا فخر .(@)(@@) % ( الدارمي وابن عساكر - عن جابر ) .(@)(@@) 32056 - لما خلق الله عز وجل آدم خبره ( خبره : إذا بلاه ، واختبره ، وبابه نصر . المختار ( 129 ) ب ) ببنيه فجعل يرى فضائل بعضهم على بعض فرأى نورا ساطعا في أسفلهم فقال : يا رب ! من هذا ؟ قال : هذا ابنك أحمد ، هو الأول وهو الآخر ، وهو أول شافع وأول مشفع .(@)(@@) % ( ابن عساكر - عن أبي هريرة ) .(@)(@@) 32057 - أريت قبل الغداة كأني أعطيت المقاليد .(@)(@@) % ( الحاكم في الكنى - عن ابن عمر ) .(@)(@@) 32058 - أعطيت خمسا لم يعطهن نبي قبلي ولا أقوله فخرا : بعثت إلى الناس كافة الأحمر والأسود وكان النبي قبلي يبعث إلى قومه ، ونصرت بالرعب أمامي مسيرة شهر ، وأحلت لي الغنائم ولم تحل لأحد قبلي ، وجعلت لي الأرض مسجدا وطهورا . وأعطيت الشفاعة فأخرتها لأمتي فهي 
ms4360	 لمن لا يشرك بالله شيئا .(@)(@@) % ( حم والحكيم - عن ابن عباس ) .(@)(@@) 32059 - أعطيت خمسا لم يعطهن أحد قبلي من الأنبياء : جعلت لي الأرض طهورا ومسجدا ولم يكن نبي من الأنبياء يصلي حتى يبلغ محرابه ، وأعطيت الرعب مسيرة شهر يكون بيني وبين المشركين مسيرة شهر فيقذف الله الرعب في قلوبهم ، وكان النبي يبعث إلى خاصة قومه وبعثت أنا إلى الجن والأنس ، وكانت الأنبياء يعزلون الخمس فتجيء النار فتأكله وأمرت أن أقسمها في فقراء أمتي ، ولم يبق نبي إلا أعطي سؤله ، وأخرت شفاعتي لأمتي .(@)(@@) % ( ق - عن ابن عباس ) .(@)(@@) 32060 - أعطيت خمسا لم يعطهن أحد قبلي : أرسلت إلى الأبيض والأسود والأحمر ، وجعلت الأرض لي مسجدا وطهورا ، ونصرت بالرعب مسيرة شهر ، وأحلت لي الغنائم ولم تحل لأحد قبلي ، وأعطيت جوامع الكلم .(@)(@@) % ( العسكري في الأمثال - عن علي ) .(@)(@@) 32061 - أعطيت خمسا لم يعطهن أحد قبلي : بعثت إلى الأحمر والأسود ، وجعلت لي الأرض مسجدا وطهورا ، وأحلت لي الغنائم ولم تحل لأحد قبلي ، ونصرت بالرعب فيرعب العدو مني وهو مني مسيرة شهر ، وقيل لي : سل تعطه ، فاختبأت دعوتي شفاعة لأمتي وهي نائلة منكم إن شاء الله تعالى من لقي الله عز وجل لا يشرك به شيئا .(@)(@@) % ( ط ، حم والدارمي ، ع ، حب ، ك ، ص عن أبي ذر ) .(@)(@@) PageV11P197(@)(@@) 32062 - أعطيت خمسا لم يعطهن أحد من الأنبياء قبلي : نصرت بالرعب مسيرة شهر ، وجعلت لي الأرض مسجدا وطهورا فأيما رجل من أمتي أدركته الصلاة فليصل ، وأحلت لي الغنائم ولم تحل لأحد قبلي ، وأعطيت الشفاعة ، وكان النبي يبعث إلى قومه خاصة وبعثت إلى الناس عامة .(@)(@@) % ( الدارمي وعبد بن حميد ، حم ، ن وأبو عوانة ، حب - عن جابر ) .(@)(@@) 32063 - أعطيت خمسا لم يعطهن نبي قبلي : أرسلت إلى الأحمر والأسود وكان النبي يرسل إلى خاصته ، ونصرت بالرعب حتى إن العدو ليخافني من مسيرة شهر أو شهرين ، وأحلت لي الغنائم ولم تحل لمن قبلي ، وجعلت لي الأرض مسجدا وطهورا ، وقيل لي : سل تعطه ، فادخرت دعوتي شفاعة لأمتي فهي نائلة إن شاء الله تعالى لمن مات لا يشرك بالله 