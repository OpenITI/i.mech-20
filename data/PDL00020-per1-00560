ms543	 یار اوست %~% در جهان آوازه شادی رسان انگیخته(@)(@@) 43 از سر کفار روس انگیخته گردی چنانک %~% از سران روم شاه الب ارسلان انگیخته(@)(@@) 44 یک دو روز این سگ‌دلان انگیخته در شیرلان %~% شورشی کارژنگ در مازندران انگیخته(@)(@@) 45 سهم شاه انگیخته امروز در دربند روس %~% شورشی کان سگ‌دلان در شیرلان انگیخته(@)(@@) 46 پیش تخت خسرو موسی کف هارون زبان %~% این منم چون سامری سحر از بیان انگیخته(@)(@@) 47 عنصری کو یا معزی یا سنائی کاین سخن %~% معجز است از هر سه گرد امتحان انگیخته(@)(@@) 48 تا جهان پیر جوان سیماست باد اندر جهان %~% رای پیرش را مدد بخت جوان انگیخته(@)(@@) 49 تا طراز ملک را نام است نامش باد و بس %~% بر طراز ملک نقش جاودان انگیخته(@)(@@) 50 فر او بر هفت بام و چار دیوار جهان %~% کارنامه هشت بنیان جنان انگیخته PageV1P0606(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دور فلک ده جام را از نور عذرا داشته %~% چون عده داران چار مه در طارمی واداشته(@)(@@) 2 در آب خضر آتش زده خم‌خانه زو مریمکده %~% هم حامل روح آمده هم نفس عذرا داشته(@)(@@) 3 جام بلور از جوهرش سقلاب و روم اندر برش %~% از نار موسی پیکرش در کف بیضا داشته(@)(@@) 4 مجلس ز می زیورزده وز جرعه خاک افسر زده %~% صبح از جگر دم برزده مرغ از که آوا داشته(@)(@@) 5 خصم صرع‌دار آشفته‌سر کف بر لب آورده ز بر %~% و آن خیک مستسقی نگر در سینه صفرا داشته(@)(@@) 6 می عطسه آدم شده یعنی که عیسی دم شده %~% داروی جان جم شده در دیر دارا داشته(@)(@@) 7 مرغ سحر تشنیع زن بر قتل مرغ باب زن %~% مرغ صراحی در دهن تریاق غمها داشته(@)(@@) 8 مجلس دو آتش داده بر این حجر آن از شجر %~% این کرده منقل را مقر آن جام را جا داشته(@)(@@) 9 منقل مربع کعبه‌سان آشفته در وی رومیان %~% لبیک گویان در میان تن محرم آسا داشته(@)(@@) 10 این 
ms544	 سبز طشت سرنگون طاس‌زر آورده برون %~% بر یاد طاس سرنگون ما جام صهبا داشته(@)(@@) 11 ساقی به رخ ریحان جان خطش دبیرستان جان %~% در ملک دل سلطان جان وز مشک طغرا داشته(@)(@@) 12 بر گوهر دل برده پی جام صدف ز انگشت وی %~% و انگشت او با جام می ماهی است دریا داشته(@)(@@) 13 می چون شفق صفرا زده مستان چو شب سودا زده %~% آتش درین خضرا زده دستی که حمرا داشته(@)(@@) 14 می آتش و کف دود بین آن کف سیم‌اندود بین %~% مریخ خون‌آلود بین بر سر ثریا داشته(@)(@@) 15 از عکس می مجلس چنان چون باغ زرین در خزان %~% باغ از دم رامش‌گران مرغان گویا داشته(@)(@@) 16 داود صوت انده زدای الحان موسیقی سرای %~% ادریس دم صنعت نمای اعجاز پیدا داشته(@)(@@) 17 بر بط کشیده رگ برون رگ‌هاش آلوده به خون %~% ساقی به طاس زر درون خون مصفا داشته(@)(@@) 18 و آن چنگ گردون‌وش سرش ده ماه نو خدمتگرش %~% ساعات روز و شب درش مطرب مهیا داشته(@)(@@) 19 نای از دو آتش باد خور نی طوق و نارش تاج سر %~% باد و نی و نارش نگر هر سه زبان ناداشته(@)(@@) 20 دف چون هلال بدرسان گرد هلالش اختران %~% هر سو دو اختر در قران جفتی چو جوزا داشته(@)(@@) 21 درجان سماع آویخته مستان خروش انگیخته %~% نقل نو اینجا ریخته جام می آنجا داشته(@)(@@) 22 من زان گره گوشه نشین نه دردکش نه جرعه چین %~% می ناب و شاهد نازنین ساقی محابا داشته(@)(@@) 23 یاران شدند آتش سخن کاین چیست کار آب کن %~% نوروز نو ز آب کهن خط تبرا داشته(@)(@@) 24 گفتم پسندد داورم کز فیض عقلی بگذرم %~% حیض عروس رز خورم در حوض ترسا داشته(@)(@@) 25 خاصه که خضرم در عرب از آب زمزم شسته لب %~% من گرد کعبه چند شب شب زنده عذرا داشته(@)(@@) 26 مقصود اگر مستی است هست از جود شاه دین پرست %~% آنک 
ms545	 می جان بخش و دست از عقل والا داشته(@)(@@) 27 خاقان اکبر کز قدر دارد قدش درع ظفر %~% یک میخ درعش برکمر نه چرخ مینا داشته(@)(@@) 28 کیخسرو رستم کمان جمشید اسکندر مکان %~% چون مهدی آخر زمان عدل هویدا داشته(@)(@@) 29 ایوانش جنت را بدل جام از کفش کوثر عمل %~% اصوات غلمان زین غزل ابیات غرا داشته PageV1P0607(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای در دل سودائیان از غمزه غوغا داشته %~% من کشته غوغائیان دل مست سودا داشته(@)(@@) 2 جان خاک نعل مرکبت وز آب طوق غبغبت %~% در آتش موسی لبت باد مسیحا داشته(@)(@@) 3 دلهای خون‌آلود بین بر خاک راهت بوسه چین %~% من خاک آن خاکم همین بوسی تمنا داشته(@)(@@) 4 گوئی به مجلس هردمی کو مست من ها عالمی %~% گوئی به میدان درهمی کو رخش تنها داشته(@)(@@) 5 هستم سگت ای چه ذقن زنجیرم آن مشکین رسن %~% سگ را ز دم طوق است و من آن قد یکتا داشته(@)(@@) 6 زان زلف هاروتی‌نشان لرزان ترم از زهره دان %~% ای زهره را هاروت سان زلف تو دروا داشته(@)(@@) 7 تو گل‌رخی من سالها پاشیده بر گل مالها %~% چون لاله مشکین خالها گل‌برگ رعنا داشته(@)(@@) 8 شمعی ولی هر شب مرا از لرز زلفت تب مرا %~% عمری به میگون لب مرا سرمست و شیدا داشته(@)(@@) 9 در حال خاقانی نگر بیمار آن خندان شکر %~% ز آن چشم بیمار از نظر چشم مداوا داشته(@)(@@) 10 تو رشک ماه چارده او چون مه نو چارمه %~% مهر شفا در پنج گه از شاه دنیا داشته(@)(@@) 11 خاقان اکبر کز دها بگشاد نیلی پرده‌ها %~% دید آتشین هفت اژدها در پرده ماوا داشته(@)(@@) 12 از خنجر زهر آبگون هفت اژدها را ریخت خون %~% همت ز نه پرده برون دل هشت مرعا داشته(@)(@@) 13 بل فارغ آن دل در برش از هشت خلد و کوثرش %~% صد ساله ره ز آنسوترش جای تماشا داشته PageV1P0608(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 این آتشین کاسه 
ms546	 نگر دولاب مینا داشته %~% از آب کوثر کاسه‌تر و آهنگ دریا داشته(@)(@@) 2 در دلو نور افشان شده ز آنجا به ماهی دان شده %~% ماهی از او بریان شده یک ماهه نعما داشته(@)(@@) 3 ماهی و قرص خور بهم حوت است و یونس در شکم %~% ماهی همه گنج درم خور زر گونا داشته(@)(@@) 4 انجم نثار افشان او اجرا خوران از خوان او %~% از ماهی بریان او نزل مهنا داشته(@)(@@) 5 خورشید نو تاثیر بین حوتش بهین توفیر بین %~% جمشید ماهی گیر بین نو ملک زیبا داشته(@)(@@) 6 گنج بهار اینک روان میغ اژدهای گنج‌بان %~% رخش سحاب اینک دوان وز برق هرا داشته(@)(@@) 7 چون روغن طلق است طل بحر دمان زیبق عمل %~% خورشید در تصعید وحل آتش در اعضا داشته(@)(@@) 8 چون آتش آمد آشنا زیبق پرید اندر هوا %~% اینک هوا سیمین هبا زیبق مجزا داشته(@)(@@) 9 زین پس و شاقان چمن نو خط شوند و غمزه زن %~% طوق خط و چاه ذقن پر مشک سارا داشته(@)(@@) 10 در هر چمن عاشق وشان بر ساقی و می جان‌فشان %~% پیر خرد ز انصافشان با می مواسا داشته(@)(@@) 11 گردان بر هر نوبری گل سارغ از مل ساغری %~% وان مل محک هر زری با گل محاکا داشته(@)(@@) 12 جام است یا جوز است آن یا خود بیضاست آن %~% یا تیغ بوالهیجاست آن در قلب هیجا داشته(@)(@@) 13 نوروز پیک نصرتش میقات‌گاه عشرتش %~% نه مه بهار از حضرتش دل ناشکیبا داشته(@)(@@) 14 نوروز نو شروان‌شهی چل صبح و شش روزش رهی %~% جاسوس بختش ز آگهی دل علم فردا داشته(@)(@@) 15 خاقان اکبر کز دمش عشری است جان عالمش %~% نه چرخ زیر خاتمش هر هفت غبرا داشته(@)(@@) 16 برجیس حکم افلاک ظل ادریس جان جبریل دل %~% از خط کل تا شط گل عالم به تنها داشته(@)(@@) 17 تا عالمش دریافته پیران سر افسر یافته %~% هم شرع داور یافته هم ملک دارا داشته(@)(@@) 18 
ms547	 پروانه چرخ اخضرش پرواز نسرین از فرش %~% پرواز سعدین بر سرش چندان که پروا داشته(@)(@@) 19 شمشیر او طوبی مثال او را جنان تحت الظلال %~% انوار عز فوق الکمال از حق تعالی داشته(@)(@@) 20 گردون و هفت اجرام او تحت الشعاع جام او %~% فوق الصفه ز اکرام او دین مجد والا داشته(@)(@@) 21 دریای عقلی در دلش صحرای قدسی منزلش %~% از نفس کل آب و گلش صفوت در اجزا داشته(@)(@@) 22 ذاتش مراد کاف و نون از علت عالم برون %~% دل را به عصمت رهنمون بر ترک اشیا داشته(@)(@@) 23 لب‌های شاهان درگهش کوثر دم از خاک رهش %~% جنت به خاک درگهش روی تولا داشته(@)(@@) 24 خوانده به چتر شاه بر چرخ آیة الکرسی ز بر %~% چترش همائی زیر پر عرش معلا داشته(@)(@@) 25 چل صبح آدم هم‌دمش ملک خلافت ز آدمش %~% هم بوده اسم اعظمش هم علم اسما داشته(@)(@@) 26 چون از عدم درتاخته دیده فلک دست آخته %~% انصاف پنهان ساخته ظلم آشکارا داشته(@)(@@) 27 ملکت گرفته رهزنان برده نگین اهریمنان %~% دین نزد این تردامنان نه جا نه ملجا داشته(@)(@@) 28 هر خوک خواری بر زمین دهقان و عیسی خوشه چین %~% هر پشه طارم نشین پیلان به سرما داشته(@)(@@) 29 شاه است عدل انگیخته دست فلک بربیخته %~% هم خون ظالم ریخته هم ملک آبا داشته(@)(@@) 30 چندان برون رانده سپه کاتش گرفته فرق مه %~% نه باد را بر خاک ره نی آب مجرا داشته(@)(@@) 31 چرخ و زمان کرده ندا کای تیغ تو جان هدی %~% ما خاک پایت را فدا تو دست بر ما داشته(@)(@@) 32 ملک ابد را رایگان مخلص بر او کرد آسمان %~% ملکی ز مقطع کم زیان وز عدل مبدا داشته(@)(@@) 33 از فتح اران نام را زیور زده ایام را %~% فتح عراق و شام را وقتی مسما داشته(@)(@@) 34 بحری است تیغش و آسمان بر گوهرش اختر فشان %~% ز آن گوهری تیغ اختران چشم مدارا 
ms548	 داشته(@)(@@) 35 آن روض دوزخ بار بین حور زبانی سار بین %~% بحر نهنگ اوبار بین آهنگ اعدا داشته(@)(@@) 36 معمار دین آثار او دین زنده از کردار او %~% گنجی است آن دیوار او از خضر بنا داشته(@)(@@) 37 جسته نظیر او جهان نادیده عنقا را نشان %~% اینک جهان را غیب دان زین خرده برپا داشته(@)(@@) 38 خط کفش حرز شفا تیغش در او عین الصفا %~% چون نور مهر مصطفی جان بحیرا داشته(@)(@@) 39 دهر است خندان بر عدو کو جاه شه کرد آرزو %~% مقل است بار نخل او او چشم خرما داشته(@)(@@) 40 پران ملک پیرامنش چون چرخ دائر بر تنش %~% چون بادریسه دشمنش یک چشم بینا داشته(@)(@@) 41 ای تاج گردون گاه تو مهدی دل آگاه تو %~% یک بنده درگاه تو صد چین و یغما داشته(@)(@@) 42 بر بندگان پاشی گهر هر بنده‌ای را بر کمر %~% ز آن لعبتان کز صلب خور ارحام خارا داشته(@)(@@) 43 افلاک تنگ ادهمت خورشید موم خاتمت %~% دل مرده گیتی از دمت امید احیا داشته(@)(@@) 44 خوش غمزه چشم خور ز تو شب طره پر عنبر ز تو %~% پیشانی اختر ز تو داغ اطعنا داشته(@)(@@) 45 خصمت ز دولت بینوا و آنگه درت کرده رها %~% چشمش به درد او توتیا بر باد نکبا داشته(@)(@@) 46 گر با تو خصم آرش بود هم جفت او آتش بود %~% صحنات کمتر خوش بود با صحن حلوا داشته(@)(@@) 47 هر موی رخشت رستمی مدهامتان وش ادهمی %~% طاس زرش هر پرچمی از زلف حورا داشته(@)(@@) 48 باد سلیمان در برش و زنار موسی منظرش %~% طیر است گوئی پیکرش طور است مانا داشته(@)(@@) 49 از نعل او مه را گله بر چشم خورشید آبله %~% کاه و جوش ز آن سنبله کاین سبز صحرا داشته(@)(@@) 50 باد از سعادات ابد بیت الحیاتت را مدد %~% هیلاج عمرت را عدد غایات اقصی داشته(@)(@@) 51 برتر ز عرشت قدر و قد رایت ورای حزر 
ms549	 و حد %~% ذاتت به دست جود و جد گیتی مطرا داشته(@)(@@) 52 در سجده صف‌های ملک پیش تو خاشع یک به یک %~% چندان که محراب فلک پیران و برنا داشته(@)(@@) 53 مولات بی‌نام آسمان باجت رساد از اختران %~% صف غلامانت جهان شرقا و غربا داشته PageV1P0609(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای در عجم سلاله اصل کیان شده %~% وی در عرب زبیده اهل زمان شده(@)(@@) 2 نی نی تو را زبیده نخوانم کز این قیاس %~% روی سخات در خوی خجلت نهان شده(@)(@@) 3 ای صد زبیده پیش صف خادمان تو %~% دستار دار خوان و پرستار خوان شده(@)(@@) 4 جان زبیده موکب تو دیده در حجاز %~% بسته میان به خدمت و هارون زبان شده(@)(@@) 5 نعمانت در عرب چو نجاشی است در حبش %~% مولی صفت نموده و لالا زبان شده(@)(@@) 6 هرگز کس از کیان ره کعبه نرفته بود %~% تو رفته راه کعبه و فخر کیان شده(@)(@@) 7 آن آرزو که جان منوچهر داشته %~% تو یافته به صدق دل و شاد جان شده(@)(@@) 8 ز آن رای کان برادر عیسی نفس زده %~% دولت نصیب خواهر مریم مکان شده(@)(@@) 9 این طرفه بین که دست برادر فشانده تخم %~% هم‌شیره برگرفته برو شادمان شده(@)(@@) 10 تو کعبه عجم شده او کعبه عرب %~% او و تو هر دو قبله انسی و جان شده(@)(@@) 11 قبله به قبله رفته و کوس سخا زده %~% کعبه به کعبه آمده وکامران شده(@)(@@) 12 تو میهمان کعبه شده هفته‌ای و باز %~% هم‌شهریان کعبه تو را میهمان شده(@)(@@) 13 خوان ساخته به رسم کیان اهل مکه را %~% رسم کیان ربیع دل مکیان شده(@)(@@) 14 تو هفت طوف کرده و کعبه عروس‌وار %~% هر هفت کرده پیش تو و عشق دان شده(@)(@@) 15 نظاره در تو چشم ملایک که چشم تو %~% دیده جمال کعبه و زمزم فشان شده(@)(@@) 16 تو بوسه داده چهره سنگ سیاه را %~% رضوان ز خاک پای تو بوسه ستان شده(@)(@@) 17 
ms550	 سنگ سیاه بهر نثارت ز سیم و زر %~% ابر سیه نموده و برف خزان شده(@)(@@) 18 آری سپاه صبح دریده لباس شب %~% لیک آفتاب سلطنه‌دار جهان شده(@)(@@) 19 پرواز کرده جان منوچهر سوی تو %~% دیده تو را به کعبه و خرم روان شده(@)(@@) 20 پیش آمده روان فریدون گهر فشان %~% تا ز آن گهر زمین علم کاویان شده(@)(@@) 21 کردند خاندان تو غربت نه زین صفت %~% ای کرده غربت و شرف خاندان شده(@)(@@) 22 رفته ایاز بر در محمود زاولی %~% طالب معاش غزنی و شرف خاندان شده(@)(@@) 23 تو دیده حضرتی که چو محمود صد هزار %~% آنجا ایاز نام کمر بر میان شده(@)(@@) 24 سالار پیر کرده به مافارقین سفر %~% سالار شام رزق ورا در ضمان شده(@)(@@) 25 تو کرده آن سفر که ضمان‌دار جنت است %~% سالار شام پیش تو سالار خوان شده(@)(@@) 26 جد تو نیز شاه فریبرز رفته هم %~% دیده در ملک شه و در اصفهان شده(@)(@@) 27 تو ملک و شاهی از حرمی یافته که هست %~% صد چون ملک‌شهش گرو آستان شده(@)(@@) 28 یک چند اگر برادر و مادرت رفته هم %~% بغداد و بصره دیده و مطلق عنان شده(@)(@@) 29 تو بخششی نموده به بغداد کز سخات %~% بر دجله هفت دجله دیگر روان شده(@)(@@) 30 با بانگ نام توست که دجله ز شرم و لرز %~% شنگرف رنگ گشته و سیماب سان شده(@)(@@) 31 حجاب آستان خلیفه ز جاه تو %~% برده نشان که جاه تو سلطان نشان شده(@)(@@) 32 گر زخم یافته دلت از رنج بادیه %~% دیدار کعبه مرهم راحت رسان شده(@)(@@) 33 چون ناخنی ز کعبه نه‌ای دور و زین حسد %~% در چشم دیو ناخنه است استخوان شده(@)(@@) 34 کوثر به ناودان شده آندم که پای تو %~% کرده طواف کعبه و زی ناودان شده(@)(@@) 35 هر خون که رانده از تن قربان خواص تو %~% گلگونه عذار خواص جنان شده(@)(@@) 36 خون بهیمه ریخته هر میزبان به شرط 
ms551	 %~% تو خون نفس ریخته و میزبان شده(@)(@@) 37 چون زی مدینه آمده مهد رفیع تو %~% ز ابر عطات شوره ستان بوستان شده(@)(@@) 38 تو عنبرین نفس به سر روضه رسول %~% وز یاد تو ملائکه مشکین دهان شده(@)(@@) 39 وقت قدوم روضه تو را مرحبا زده %~% صدق دلت به حضرت او نورهان شده(@)(@@) 40 آن شاخ سیم بر سر بالین مصطفی %~% از بس نثار لعل و زرت گلستان شده(@)(@@) 41 تو شب به روضه نبوی زنده داشته %~% عین اللهت به لطف نظر پاسبان شده(@)(@@) 42 اشک نیاز ریخته چشم تو شمع‌وار %~% وز نور روضه نبوی شمعدان شده(@)(@@) 43 هنگام بازگشت همه ره ز برکتت %~% شب بدروار بدرقه کاروان شده(@)(@@) 44 در موکبت برای خبر چون کبوتران %~% شام و سحر دو نامه بر رایگان شده(@)(@@) 45 وز بهر محملت که فلک بوده غاشیه‌اش %~% خورشید ناقه گشته و مه ساربان شده(@)(@@) 46 تاریخ گشته رفتن مهد تو در عرب %~% چون در عجم کرامت تو داستان شده(@)(@@) 47 ای آسیه کرامت و ای ساره معرفت %~% حوای وقت و مریم آخر زمان شده(@)(@@) 48 این هر چهار طاهره را خامسه توئی %~% هر ناخن از تو رابعه دودمان شده(@)(@@) 49 ای اعتقاد نه زن و ده یار مصطفات %~% از نوزده زبانیه حرز امان شده(@)(@@) 50 هستند ده ستاره و نه حور با دلت %~% همراه هشت جنت و هفت آسمان شده(@)(@@) 51 گر شاه بانوان ز خلاط آمده به حج %~% نامش به جود در همه علام عیان شده(@)(@@) 52 تو قحط مکه برده و نامت به شرق و غرب %~% تا حد قندهار و خط قیروان شده(@)(@@) 53 صد ماه بانوان به برت پیشکار هست %~% صد شاه ارمنت رهی قهرمان شده(@)(@@) 54 خاقانی ار ز خدمت مهد تو دور ماند %~% عمرش بخورده در سر تشویر آن شده(@)(@@) 55 اکنون ز روی بی‌طمعی خوانده مدح تو %~% بر مدح خوان تو ملکان مدح خوان شده(@)(@@) 56 زین شعر کرده بر 
ms552	 قد و صفت قبای فخر %~% وز بهر فتنه نیز فلک چون کمان شده(@)(@@) 57 بادت بقای خضر و هم از برکت دعات %~% اسکندر جهان شه شرق اخستان شده(@)(@@) 58 بادت سعادت ابد وهم به همتت %~% قیدافه زمین و سر قیروان شده PageV1P0610(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عید است و پیش از صبح‌دم مژده به خمار آمده %~% بر چرخ دوش از جام جم یک نیمه دیدار آمده(@)(@@) 2 عید آمد از خلد برین شد شحنه روی زمین %~% هان ماه نو طغراش بین امروز در کار آمده(@)(@@) 3 کرده در آن خرم فضا صید گوزنان چند جا %~% شاخ گوزن اندر هوا اینک نگون‌سار آمده(@)(@@) 4 پرچم ز شب پرداخته مه طاس پرچم ساخته %~% بیرق ز صبح افراخته روزش سپهدار آمده(@)(@@) 5 بر چرخ بگشاده کمین داغش نهاده بر سرین %~% هان عین عید اینک ببین بر چرخ دوار آمده(@)(@@) 6 عید همایون فر نگر سیمرغ زرین پر نگر %~% ابروی زال زر نگر بر فرق کهسار آمده(@)(@@) 7 از گرد راهش آسمان ترمغز گشته آن‌چنان %~% کز عطسه مغزش جهان پر مشک تاتار آمده(@)(@@) 8 گیتی ز گرد لشکرش طاوس بسته زیورش %~% در شرق رنگین شهپرش در غرب منقار آمده(@)(@@) 9 پی گم کنان سی شب دوان از چشم قرایان نهان %~% دزدیده در کوی مغان نزدیک خمار آمده(@)(@@) 10 ساقی صنم پیکر شده باده صلیب آور شده %~% قندیل ازو ساغر شده تسبیح زنار آمده(@)(@@) 11 هر نی ز کویش شکری هر می ز جویش کوثری %~% هر خو ز رویش عبهری بر برگ گلنار آمده(@)(@@) 12 ریحان روح از بوی وی جان را فتوح از روی وی %~% بزم صبوح از جوی می فردوس کردار آمده(@)(@@) 13 می عاشق‌آسا زرد به هم‌رنگ اهل درد به %~% درد صفا پرورد به تلخ شکربار آمده(@)(@@) 14 خورشید رخشان است می زان زرد و لرزان است می %~% جوجو همه جان است می فعلش به خروار آمده(@)(@@) 15 آن خام خم پرورد کو آن 
ms553	 شاهد رخ زرد کو %~% آن عیسی هر درد کو تریاق بیمار آمده(@)(@@) 16 می آفتاب زرفشان جان بلورش آسمان %~% مشرق کف ساقیش دان مغرب لب یار آمده(@)(@@) 17 در ساغر صهبا نگر در کشتی آن دریا نگر %~% بر خشک‌تر صحرا نگر کشتی به رفتار آمده(@)(@@) 18 مطرب چو طوطی بوالهوس انگشت و لب در کارو بس %~% از سینه بربط نفس در حلق مزمار آمده(@)(@@) 19 آن آبنوسین شاخ بین مار شکم سوراخ بین %~% افسونگر گستاخ بین لب بر لب مار آمده(@)(@@) 20 بربط چو عذرا مریمی کابستنی دارد همی %~% وز درد زادن هر دمی در ناله زار آمده(@)(@@) 21 نالان رباب از عشق می دستینه بسته دست وی %~% بر ساعدش چون خشک نی رگ‌های بسیار آمده(@)(@@) 22 آن چنگ ازرق سار بین زر رشته در منقار بین %~% در قید گیسووار بین پایش گرفتار آمده(@)(@@) 23 آن لعب دف گردان نگر بر دف شکارستان نگر %~% وان چند صف حیوان نگر باهم به پیکار آمده(@)(@@) 24 کبکان به بانگ زیر و بم چندان سماع آورده هم %~% تا حلق نازکشان ز دم تا سینه افگار آمده(@)(@@) 25 راز سلیمانی شنو زان مرغ روحانی شنو %~% اشعار خاقانی شنو چون در شهوار آمده(@)(@@) 26 صف‌های مرغان کن نگه در صفه‌های بزم شه %~% چون عندلیبان صبحگه فصال گلزار آمده(@)(@@) 27 و آن کوس عیدی بین نوان بر درگه شاه جهان %~% مانند طفل لوح خوان در درس و تکرار آمده(@)(@@) 28 جام و می رنگین بهم صبح وشفق را بین بهم %~% تخت و جلال الدین بهم کیخسرو آثار آمده(@)(@@) 29 شروان شه سلطان نشان افسرده گردن کشان %~% دستش سحاب درفشان چون لعل دلدار آمده PageV1P0611(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای با دل سودائیان عشق تو در کار آمده %~% ترکان غمزت را به جان دلها خریدار آمده(@)(@@) 2 آئینه بردار و ببین آن غمزه سحر آفرین %~% با زهر پیکان در کمین ترکان خون‌خوار آمده(@)(@@) 3 تو بادی و من خاک 
ms554	 تو تو آب و من خاشاک تو %~% با خوی آتش‌ناک تو صبر من آوار آمده(@)(@@) 4 دانم که ندهی داد من روزی نیاری یاد من %~% بشنو شبی فریاد من داغ شب تار آمده(@)(@@) 5 ای خون من در گردنت زین دیر یادآوردنت %~% وز دست زود آزردنت جانم به آزار آمده(@)(@@) 6 هم خواب خرگوشم دهی داغ جگر جوشم نهی %~% ای از تو آغوشم تهی خوابم همه خار آمده(@)(@@) 7 خاقانی و درد نهان خون دل از ناخن چکان %~% وز ناخن غم هر زمان مجروح رخسار آمده(@)(@@) 8 او بلبل است ای دلستان طبعش چو شاخ گلستان %~% در مجلس شاه اخستان لعل و زرش بار آمده PageV1P0612(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مهر است یا زرین صدف خرچنگ را یار آمده %~% خرچنگ ناپروا ز تف پروانه نار آمده(@)(@@) 2 بیمار بوده جرم خور سرطانش داده زور و فر %~% معجون سرطانی نگر داروی بیمار آمده(@)(@@) 3 آن کعبه محرم نشان وان زمزم آتش فشان %~% در کاخ مه دامن کشان یک مه به پروار آمده(@)(@@) 4 هر سنگ را گر ساحری کرده صبا میناگری %~% از خشت زر خاوری میناش دینار آمده(@)(@@) 5 شمع روان بین در هوا آتش فشان بین در هوا %~% بر کرکسان بین در هوا پرواز دشوار آمده(@)(@@) 6 خورشید زرین دهره بین صحرای آتش چهره بین %~% در مغز افعی مهره بین چون دانه نار آمده(@)(@@) 7 روی سپهر چنبری بگرفت رنگ اغبری %~% بر آینه اسکندری خاکستر انبار آمده(@)(@@) 8 هر فرش سقلاطون که مه صباغ او بوده سه مه %~% از آتش گردون سیه چون داغ قصار آمده(@)(@@) 9 آفاق را از جرم‌خور هم قرص و هم آتش نگر %~% هم مطبخ و هم خوان زر هم میده سالار آمده(@)(@@) 10 گر بلبل بسیار گو بست از فراق گل گلو %~% گلگون صراحی بین در او بلبل به گفتار آمده(@)(@@) 11 گر می‌دهی ممزوج ده کاین وقت می ممزوج به %~% بر می گلاب ناب نه چون 
