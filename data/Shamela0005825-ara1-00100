ms96	 بن أبي زائدة كوفي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1343 - (@)(@@) عمر بن سعد بن أبي وقاص مدني ثقة كان يروي عن أبيه أحاديث وروى الناس عنه وهو الذي قتل الحسين قلت كان أمير الجيش ولم يباشر قتله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1344 - (@)(@@) عمر بن سعد أبو داود الحفري كوفى ثقة ثبت في الحديث عابد صالح وهو اثبت في سفيان من جماعة(@)(@@)(@@)(@@) | 1345 - (@)(@@) عمر بن سعيد الثوري أخو سفيان الثوري روى عنه بن عيينة وهو اسن من سفيان وكان بعض الكوفيين يفضله على سفيان كوفى ثقة وكان رجلا صالحا يفضل على سفيان(@)(@@)(@@)(@@) | 1346 - (@)(@@) عمر بن سعيد بن أبي حسين النوفلي ثقة(@)(@@)(@@)(@@) | 1347 - (@)(@@) عمر بن سفينة مدني تابعي ثقة(@)(@@)(@@)(@@) | 1348 - (@)(@@) عمر بن أبي سلمة من أصحاب النبي صلى الله عليه وسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1349 - (@)(@@) عمر بن أبي سلمة بن عبد الرحمن بن عوف مدني لا باس به(@)(@@)(@@)(@@) | 1350 - (@)(@@) عمر بن عامر بصرى ثقة(@)(@@)(@@)(@@) | 1351 - (@)(@@) عمر بن عبد الله مدني ثقة رجل صالح(@)(@@)(@@)(@@) | 1352 - (@)(@@) عمر بن عبد الله الأشج مدني ثقة نزل مصر(@)(@@)(@@)(@@) | 1353 - (@)(@@) عمر بن عبد الله المدني أبو حفص مولى غفرة يكتب حديثه وليس بالقوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1354 - (@)(@@) عمر بن عبد الله بن يعلى بن مرة كوفي(@)(@@)(@@)(@@) | 1355 - (@)(@@) عمر بن عبد الرحمن بصرى ثقة وأبوه ثقة(@)(@@)(@@)(@@) | 1356 - (@)(@@) عمر بن عبد الواحد دمشقي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1357 - (@)(@@) عمر بن عبيد أخو محمد بن عبيد الطنافسي ويعلى بن عبيد وهو أسنهم وكان دونهم في الحديث وكان صدوقا وقال مرة لا بأس به(@)(@@)(@@)(@@) | 1358 - (@)(@@) عمر بن عطاء بن أبي الخوار مولى بني عامر ثقة(@)(@@)(@@)(@@) | 1359 - (@)(@@) عمر بن علي بن أبي طالب تابعي ثقة(@)(@@)(@@)(@@) | 1360 - (@)(@@) عمر بن على بن عطاء بن مقدم المقدمي ثقة(@)(@@)(@@)(@@) | 1361 - (@)(@@) عمر بن كثير بن افلح مولى أبي أيوب الأنصاري ثقة(@)(@@)(@@)(@@) | 1362 - (@)(@@) عمر بن محمد العمرى مدني ثقة(@)(@@)(@@)(@@) | 1363 - (@)(@@) عمر بن محمد بن عبد الله العرزمي ضعيف الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1364 - (@)(@@) عمر بن هارون بن يزيد الثقفي ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (باب من اسمه عمرو)(@)(@@)(@@)(@@) | 1365 - (@)(@@) عمرو بن الأسود شامي ثقة تابعي(@)(@@)(@@)(@@) | 1366 - (@)(@@) عمرو بن أمية الضمري من أصحاب النبي 
ms97	 صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1367 - (@)(@@) عمرو بن بجدان بصرى تابعي ثقة(@)(@@)(@@)(@@) | 1368 - (@)(@@) عمرو بن تغلب بصرى من أصحاب النبي صلى الله عليه وسلم روى عنه الحسن حديثين(@)(@@)(@@)(@@) | 1369 - (@)(@@) عمرو بن ثابت بن هرمز البكري شديد التشيع غال فيه واهي الحديث(@)(@@)(@@)(@@) | 1370 - (@)(@@) عمرو بن جابر الحضرمي مصرى تابعي ثقة وكان يغلو في التشيع(@)(@@)(@@)(@@) | 1371 - (@)(@@) عمرو بن الحارث مصرى ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1372 - (@)(@@) عمرو بن الحارث بن المصطلق سمع من عبد الله(@)(@@)(@@)(@@) | 1373 - (@)(@@) عمرو بن حريث المخزومي كوفى من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1374 - (@)(@@) عمرو بن الحكم بن ثوبان مدني تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1375 - (@)(@@) عمرو بن الحمق لم يرو عمرو بن الحمق عن النبي صلى الله عليه وسلم إلا حديثين حديث إذا أراد الله بعبد خيرا عسله وحديث آخر من ائتمن على نفسه رجلا فقتله(@)(@@)(@@)(@@) | 1376 - (@)(@@) عمرو بن خالد ثبت ثقة مصري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1377 - (@)(@@) عمرو بن دينار المكى تابعي ثقة وكان سفيان بن عيينة من أروى الناس عنه(@)(@@)(@@)(@@) | 1378 - (@)(@@) عمرو بن دينار البصري قهرمان آل الزبير يكتب حديثه وليس بالقوي(@)(@@)(@@)(@@) | 1379 - (@)(@@) عمرو بن رافع مولى عمر بن الخطاب مدني تابعي ثقة(@)(@@)(@@)(@@) | 1380 - (@)(@@) عمرو بن ربيع بن طارق كوفى ثقة كتبنا عنه بمصر(@)(@@)(@@)(@@) | 1381 - (@)(@@) عمرو بن أبي زائدة كوفى ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1382 - (@)(@@) عمرو بن سعيد ثقة(@)(@@)(@@)(@@) | 1383 - (@)(@@) عمرو بن سفيان كوفى تابعي ثقة(@)(@@)(@@)(@@) | 1384 - (@)(@@) عمرو بن سفينة مدني تابعي ثقة(@)(@@)(@@)(@@) | 1385 - (@)(@@) عمرو بن سلمة كوفى تابعي ثقة(@)(@@)(@@)(@@) | 1386 - (@)(@@) عمرو بن سليم الزرقي مدني تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1387 - (@)(@@) عمرو بن الشريد حجازي تابعي ثقة وأبوه من أصحاب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1388 - (@)(@@) عمرو بن شعيب بن محمد بن عبد الله بن عمرو بن العاص ثقة(@)(@@)(@@)(@@) | 1389 - (@)(@@) عمرو بن صالح العودى بصرى ثقة(@)(@@)(@@)(@@) | 1390 - (@)(@@) عمرو بن صليع المحاربي كوفى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1391 - (@)(@@) عمرو بن العاص من أصحاب النبي صلى الله عليه وسلم مات وهو بن تسع وسبعين سنة ومات سنة ثلاث وأربعين بمصر وصلى عليه ابنه عبد الله(@)(@@)(@@)(@@) | 1392 - (@)(@@) عمرو بن عبد الله بن الأشج مدني ثقة نزل 
ms98	 مصر(@)(@@)(@@)(@@) | 1393 - (@)(@@) عمرو بن عبد الله الحضرمي شامي تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1394 - (@)(@@) عمرو بن عبد الله أبو إسحاق السبيعي كوفى تابعي ثقة ولم يسمع أبو إسحاق من علقمة شيئا ولم يسمع من حارث الأعور إلا أربعة وسائر ذلك إنما هو كتاب أخذه وروى أبو إسحاق السبيعي عن ثمانية وثلاثين من أصحاب النبي صلى الله عليه وسلم حدثنا أبي عبد الله قال كان أبو إسحاق يقول لإسرائيل الزم هؤلاء الثلاثة فإنهم أصحاب علم وفصاحة عبد الملك بن عمير والأعمش وسماك بن حرب حدثنا أبو مسلم عن أبيه أحمد عن جده عبد الله قال كان أبو إسحاق السبيعي يحرض الشباب يقول ما أستطيع ان أستوى قائما حتى أعتمد على رجلين فإذا اعتدلت قائما قرأت بألف آية وأبو إسحاق أكبر من عبد الملك بن عمير بسنتين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1395 - (@)(@@) عمرو بن عتبة بن فرقد من أصحاب عبد الله ثقة وكان خيارا هو بابة الربيع حدثنا أبو مسلم حدثني أبي أخبرنا موسى بن أيوب النصيبي أنا النعمان بن عياش عن بن مبارك عن عيسى بن عمر عن السدي قال خرج عمرو بن عتبة في غزو فاشترى فرسا بأربعة آلاف فعنفوه يستغلونه فقال ما خطوة تتقدمها إلى عدو إلا هى أحب إلى من أربعة آلاف(@)(@@)(@@)(@@) | 1396 - (@)(@@) عمرو بن عثمان يعنى بن عفان مدني تابعي ثقة من كبار التابعين(@)(@@)(@@)(@@) | 1397 - (@)(@@) عمرو بن عمران بن قيس الماضر ضعيف الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1398 - (@)(@@) عمرو بن أبي عمرو مولى المطلب بن عبد الله بن حنطب ثقة ينكر عليه حديث البهيمة(@)(@@)(@@)(@@) | 1399 - (@)(@@) عمرو بن عون بن أوس الواسطي ثقة صاحب سنة رجل صالح يكنى أبا عثمان(@)(@@)(@@)(@@) | 1400 - (@)(@@) عمرو بن عيسى أبو نعامة العدوى بصرى ثقة(@)(@@)(@@)(@@) | 1401 - (@)(@@) عمرو بن أبي قرة الكندي كوفى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1402 - (@)(@@) عمرو بن قيس الملائي كوفى ثقة من كبار الكوفيين متعبد وكان سفيان يأتيه يسلم عليه يتبرك به وكان يبيع الملاء كان إذا نظر إلى أهل السوق مكسدين قال إني(@)(@@) PageV00P000(@)(@@) لأرحم هؤلاء المساكين لو كان أحدهم إذا كسد في الدنيا ذكر 
ms99	 الله تمنى يوم القيامة انه كان أكثر أهل الدنيا كسادا في الدنيا حدثنا أبو مسلم حدثني أبي عن أبيه عبد الله قال جاءت امرأة إلى عمرو بن قيس بثوب فقالت يا عبد الله اشتر هذا الثوب واعلم أن غزله فيه ضعف قال فكان إذا جاء إنسان فعرضه عليه قال إن صاحبته أخبرتني أنه كان في غزله ضعف حتى جاءه رجل فاشتراه قال قد أبرئناك منه حدثنا أبو مسلم حدثني أبي أحمد حدثني أبي عبد الله قال قال عمرو بن قيس وجدنا أنفع الحديث لنا ما ينفعنا في أمر آخرتنا من قال كذا فله كذا حدثنا أبو مسلم حدثني أبي أحمد عن أبيه قال ويروي عن موسى الجهني قال جاءني عمرو بن قيس الملائي وسفيان الثوري فقالا لي لا تحدث بهذا الحديث بالكوفة أن النبي صلى الله عليه وسلم قال لعلي أنت منى بمنزلة هارون من موسى حدثنا أبو مسلم حدثني أبي حدثني أبي قال قال عمرو بن قيس الملائي لرقبة أنا عندك فقال له رقبة والله ما أنت من القريتين بعظيم وما مكانك من الحاكة بمهجور قال فضحك(@)(@@) PageV02P183(@)(@@)(@@)(@@) | 1403 - (@)(@@) عمرو بن قيس مكي ثقة وابنه عمرو ضعيف الحديث(@)(@@)(@@)(@@) | 1404 - (@)(@@) عمرو بن قيس الكندي تابعي ثقة(@)(@@)(@@)(@@) | 1405 - (@)(@@) عمرو بن مالك مصرى تابعي ثقة(@)(@@)(@@)(@@) | 1406 - (@)(@@) عمرو بن محمد العنقزي ثقة جائز الحديث(@)(@@)(@@)(@@) | 1407 - (@)(@@) عمرو بن مرزوق بصري ضعيف يحدث عن شعبة ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1408 - (@)(@@) عمرو بن مرة الجملي من مراد كوفى ثقة ثبت روى عنه الأعمش وشعبة بن الحجاج وسفيان الثوري وكان عمرو بن مرة يرى الإرجاء قال نظرت في هذه الآراء فلم أر قوما خيرا من المرجئة فأنا مرجىء فقال له سليمان الأعمش لم تسم باسم غير الإسلام قال أنا كذلك ولم يكن أحد أروى عن عبد الله بن سلمة منه وعبد الله بن سلمة يكنى أبا العالية سمع منه بعد ما كبر(@)(@@)(@@)(@@) | 1409 - (@)(@@) عمرو بن معديكرب كوفى تابعي ثقة(@)(@@)(@@)(@@) | 1410 - (@)(@@) عمرو بن المهاجر شامي ثقة(@)(@@)(@@)(@@) | 1411 - (@)(@@) عمرو بن موهب مدني 
ms100	 تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1412 - (@)(@@) عمرو بن ميمون الأودي كوفي تابعي ثقة جاهلي أسلم في حياة النبي صلى الله عليه وسلم ولم ير النبي صلى الله عليه وسلم من أصحاب عبد الله ثقة حدثنا يزيد بن معروف ثنا جرير عن حصين عن عمرو بن ميمون قال فذهب حتى أتو الوادي حصروا ولم يكن سأل قبل ذلك بخمس عشرة سنة فعاموا إلى أن كانوا فيه أرسل عليهم السيل فغرقهم(@)(@@)(@@)(@@) | 1413 - (@)(@@) عمرو بن نضرة القرشي مصري تابعي ثقة(@)(@@)(@@)(@@) | 1414 - (@)(@@) عمرو بن هرم ثقة لا بأس به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1415 - (@)(@@) عمرو بن وهب الثقفي بصري تابعي ثقة(@)(@@)(@@)(@@) | 1416 - (@)(@@) عمرو بن يحيى بن عمارة ثقة(@)(@@)(@@)(@@) | 1417 - (@)(@@) عمرو البكالي تابعي ثقة شامي من كبار التابعين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1418 - (@)(@@) عمرو ذو مر تابعي ثقة كوفى(@)(@@)(@@)(@@) | (باب عمران)(@)(@@)(@@)(@@) | 1419 - (@)(@@) عمران بن أبان السلمي ليس بثقة(@)(@@)(@@)(@@) | 1420 - (@)(@@) عمران بن أبي أنس مدني ثقة(@)(@@)(@@)(@@) | 1421 - (@)(@@) عمران بن الحارث كوفى تابعي ثقة(@)(@@)(@@)(@@) | 1422 - (@)(@@) عمران بن حصين أبو نجيد وأبوه قد أتى النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1423 - (@)(@@) عمران بن حطان بصرى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1424 - (@)(@@) عمران بن داور العمى بصرى ثقة(@)(@@)(@@)(@@) | 1425 - (@)(@@) عمران بن سليم مصرى تابعي ثقة(@)(@@)(@@)(@@) | 1426 - (@)(@@) عمران بن طلحة بن عبيد الله تابعي ثقة(@)(@@)(@@)(@@) | 1427 - (@)(@@) عمران بن عوف المعافري مصري تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1428 - (@)(@@) عمران بن عيينة صدوق(@)(@@)(@@)(@@) | 1429 - (@)(@@) عمران بن قيس الماضر مكي ثقة(@)(@@)(@@)(@@) | 1430 - (@)(@@) عمران بن مسلم الجعفي كوفى ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1431 - (@)(@@) عمران بن يزيد العطار بصرى ثقة وكان يرى القدر(@)(@@)(@@)(@@) | (باب عمير وعميرة)(@)(@@)(@@)(@@) | 1432 - (@)(@@) عمير بن أبي إسحاق الزهرى قتل يوم بدر قلت هكذا وجدته في الأصلين وهو مضبب عليه وصوابه عمير بن أبي وقاص وهو أخو سعد والله أعلم(@)(@@)(@@)(@@) | 1433 - (@)(@@) عمير بن سعيد النخعي ثقة سمع من عبد الله(@)(@@)(@@)(@@) | 1434 - (@)(@@) عمير بن عمير التيمى كوفى تابعي ثقة وكان خيارا(@)(@@)(@@)(@@) | 1435 - (@)(@@) عمير بن فيض مصرى تابعي ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1436 - (@)(@@) عمير بن قيس مصري تابعي ثقة(@)(@@)(@@)(@@) | 1437 - (@)(@@) عمير بن هانئ العنسى شامي تابعي ثقة(@)(@@)(@@)(@@) | 1438 - (@)(@@) عمير بن يزيد الخطمي ثقة(@)(@@)(@@)(@@) | 1439 - (@)(@@) عمير مولى بن عباس 