ms161	 عنه اضطراب ثم ساق له حديثين مضطربي الاسناد والاضطراب من غيره وأخطأ العقيلي في إيراده في كتاب الضعفاء(@)(@@)(@@)(@@) | 3159 - (@)(@@) ق(@)(@@) عبد الله بن دينار الشامي لا المدني عن عمر بن عبد العزيز فيه ضعف(@)(@@)(@@)(@@) | 3160 - (@)(@@) عبد الله بن ذكوان عن ابن المنكدر في الاذان قال البخاري حديثه منكر(@)(@@)(@@)(@@) | 3161 - (@)(@@) عبد الله بن ذكوان عن ابن عمر لا يعرف(@)(@@)(@@)(@@) | 3162 - (@)(@@) ع(@)(@@) عبد الله بن ذكوان ابو الزناد امام ثبت تكلم فيه بعضهم بلا حجة(@)(@@)(@@)(@@) | 3163 - (@)(@@) م د ت(@)(@@) عبد الله بن ابي صالح السمان هو عباد قال البخاري منكر الحديث(@)(@@)(@@)(@@) | 3164 - (@)(@@) د ت ق(@)(@@) عبد الله بن راشد عن ابي سعيد قال الدارقطني ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3165 - (@)(@@) عبد الله بن ابي راشد عن علي رضي الله عنه لا يعرف(@)(@@)(@@)(@@) | 3166 - (@)(@@) عبد الله بن رافع بن خديج عن ابيه قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) | 3167 - (@)(@@) عبد الله بن ابي رفاعة الاسكندراني عن الليث منكر الحديث(@)(@@)(@@)(@@) | 3168 - (@)(@@) خ س(@)(@@) عبد الله بن رجاء الغداني صدوق قال ابو حاتم ثقة رضي وقال ابو حفص الفلاس كثير الغلط والتصحيف ليس بحجة(@)(@@)(@@)(@@) | 3169 - (@)(@@) عبد الله بن رشيد عن مجاعة بن الزبير وعنه السري بن سهل ليس بقوي وفيه جهالة(@)(@@)(@@)(@@) | 3170 - (@)(@@) عبد الله بن ابي الزغباء الحنفي عن عكرمة نكرة والخبر منكر(@)(@@)(@@)(@@) | 3171 - (@)(@@) عبد الله بن رقيم قال ابن خراش لم يرو عنه إلاعبد الله ابن شريك(@)(@@)(@@)(@@) | 3172 - (@)(@@) عبد الله بن ابي رومان المعافري عن ابن وهب ضعفه غير واحد وله حديث باطل(@)(@@)(@@)(@@) | 3173 - (@)(@@) ق(@)(@@) عبد الله بن الزبير الباهلي عن ثابت حسن الحديث قال ابو حاتم مجهول(@)(@@)(@@)(@@) | 3174 - (@)(@@) عبد الله بن الزبير والد ابي احمد الزبيري ضعفه ابو نعيم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3175 - (@)(@@) عبد الله بن زمل الجهني تابعي ارسل حديثا ولا يكاد يعرف له مناكير(@)(@@)(@@)(@@) | 3176 - (@)(@@) ق(@)(@@) عبد الله بن زياد بن سليمان بن سمعان المدني الفقيه تركوه(@)(@@)(@@)(@@) | 3177 - (@)(@@) عبد الله بن زياد بن سليم عن عكرمة لا يعرف(@)(@@)(@@)(@@) | 3178 - (@)(@@) عبد الله بن زياد عن عكرمة بن عمار منكر الحديث(@)(@@)(@@)(@@) | 3179 
ms162	 - (@)(@@) عبد الله بن زياد بن درهم عن عبد الملك بن سويد مجهول(@)(@@)(@@)(@@) | 3180 - (@)(@@) ق(@)(@@) عبد الله بن زياد عن ابي عبيدة لا يعرف من هو(@)(@@)(@@)(@@) | 3181 - (@)(@@) ت س(@)(@@) عبد الله بن زيد بن اسلم عن ابيه ضعفه جماعة وقال احمد ثقة(@)(@@)(@@)(@@) | 3182 - (@)(@@) عبد الله بن ابي زينب عن ابي ادريس الخولاني مجهول(@)(@@)(@@)(@@) | 3183 - (@)(@@) عبد الله بن السائب عن ابيه مجهول(@)(@@)(@@)(@@) | 3184 - (@)(@@) عبد الله بن سبأ من غلاة الشيعة ضال مضل(@)(@@)(@@)(@@) | 3185 - (@)(@@) عبد الله بن سخبرة عن ابيه لا يعرف(@)(@@)(@@)(@@) | 3186 - (@)(@@) د ت(@)(@@) عبد الله بن سراقة عن ابي عبيدة بن الجراح لا يعرف(@)(@@)(@@)(@@) | 3187 - (@)(@@) عبد الله بن السري المدائني بانطاكية عن ابي عمران الجوني ضعفوه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3188 - (@)(@@) د(@)(@@) عبد الله بن سعد عن الصنابحي مجهول(@)(@@)(@@)(@@) | 3189 - (@)(@@) عبد الله بن سعد الرقي عن هشام بن عمار كذاب(@)(@@)(@@)(@@) | 3190 - (@)(@@) عبد الله بن ابي سعيد عن الحسن مجهول(@)(@@)(@@)(@@) | 3191 - (@)(@@) ع(@)(@@) عبد الله بن سعيد بن ابي هند ثقة ضعفه ابو حاتم ووثقه احمد وابن معين وقال القطان صالح تعرف وتنكر(@)(@@)(@@)(@@) | 3192 - (@)(@@) عبد الله بن سعد الرقي القاضي قال الدارقطني كان يضع الحديث(@)(@@)(@@)(@@) | 3193 - (@)(@@) عبد الله بن سعيد بن خازم عن بعض التابعين لا يعرف(@)(@@)(@@)(@@) | 3194 - (@)(@@) ت ق(@)(@@) عبد الله بن سعيد بن ابي سعيد المقري عن ابيه تركوه(@)(@@)(@@)(@@) | 3195 - (@)(@@) خ م(@)(@@) عبد الله بن سعيد ابو صفوان الاموي صدوق ضعفه ابن معين(@)(@@)(@@)(@@) | 3196 - (@)(@@) س(@)(@@) عبد الله بن سفيان الثقفي عن ابيه وعنه يعلى بن عطاء وحده(@)(@@)(@@)(@@) | 3197 - (@)(@@) عبد الله بن سفيان الخزاعي الواسطي عن يحيى بن سعيد الانصاري تكلم فيه العقيلي(@)(@@)(@@)(@@) | 3198 - (@)(@@) عبد الله بن سفيان الصنعاني قال ابن معين كذاب(@)(@@)(@@)(@@) | 3199 - (@)(@@) م عه(@)(@@) عبد الله بن سلمة عن علي صدوق قال ابو(@)(@@) PageV00P000(@)(@@) حاتم والنسائي تعرف وتنكر وكذا قال قبلهما عمرو بن مرة(@)(@@)(@@)(@@) | 3200 - (@)(@@) عبد الله بن سلمة البصري الافطس عن الاعمش تركوه(@)(@@)(@@)(@@) | 3201 - (@)(@@) عبد الله بن سلمة بن اسلم عن عبد الرحمن بن المسور ابن مخرمة ضعفه الدارقطني(@)(@@)(@@)(@@) | 3202 - (@)(@@) عبد الله بن سلمة 
ms163	 عن الزهري قال ابو زرعة منكر الحديث(@)(@@)(@@)(@@) | 3203 - (@)(@@) عبد الله بن سلم بصري عن ابن عون لا يعرف(@)(@@)(@@)(@@) | 3204 - (@)(@@) د(@)(@@) عبد الله بن سليمان بن جنادة عن ابيه عن جده قال البخاري في حديثه نظر(@)(@@)(@@)(@@) | 3205 - (@)(@@) عبد الله بن سليمان البعلبكي عن ابن المبارك ليس بذاك القوي(@)(@@)(@@)(@@) | 3206 - (@)(@@) ت(@)(@@) عبد الله بن سليمان النوفلي لم يرو عنه سوى هشام بن يوسف(@)(@@)(@@)(@@) | 3207 - (@)(@@) عبد الله بن سليمان السجستاني ثقة كذبه ابوه يعني في غير الحديث ووثقه الناس(@)(@@)(@@)(@@) | 3208 - (@)(@@) عبد الله بن السمط عن صالح بن علي روى خبرا موضوعا(@)(@@)(@@)(@@) | 3209 - (@)(@@) عبد الله بن سنان عن ابن المنكدر ضعفه ابو حاتم وغيره واسطي(@)(@@)(@@)(@@) | 3210 - (@)(@@) عبد الله بن سيدان الربذي تابعي عن ابي ذر قال البخاري لا يتابع في حديثه(@)(@@)(@@)(@@) | 3211 - (@)(@@) عبد الله بن سيف عن مالك بن مغول لا يعرف(@)(@@) PageV00P000(@)(@@) وحديثه منكر روى عنه سعد بن نصر وذكر انه خوارزمي والحسين بن عيسى البسطامي(@)(@@)(@@)(@@) | 3212 - (@)(@@) عبد الله بن شبيب الربعي الاخباري واه قال ابو احمد الحاكم ذاهب الحديث(@)(@@)(@@)(@@) | 3213 - (@)(@@) عبد الله بن ابي شديدة روى عنه مغيرة بن سعد ارسل حديثا مجهول(@)(@@)(@@)(@@) | 3214 - (@)(@@) عبد الله بن الشرود والد بكر قال الدارقطني هو وابنه ضعيفان(@)(@@)(@@)(@@) | 3215 - (@)(@@) س(@)(@@) عبد الله بن شريك العامري عن ابن عمر وكان من اصحاب المختار في شبيبته وثقه احمد وابن معين وغيرهما ولينه النسائي وقال الجوزجاني كذاب(@)(@@)(@@)(@@) | 3216 - (@)(@@) م عه(@)(@@) عبد الله بن شقيق العقيلي ثقة ناصبي كان سليمان التيمي سيء الرأي فيه(@)(@@)(@@)(@@) | 3217 - (@)(@@) عبد الله بن ابي شقيق السلولي عن ابي زيد احد الصحابة مجهول(@)(@@)(@@)(@@) | 3218 - (@)(@@) خ د ت ق(@)(@@) عبد الله بن صالح كاتب الليث مكثر صالح الحديث له مناكير والصحيح ان البخاري روى عنه في الصحيح وروى عنه ابن معين قال ابو زرعة كان حسن الحديث وقال الفضل الشعراني ما رأيته الا وهو يحدث او يسبح وقال ابن عدي(@)(@@) PageV00P000(@)(@@) هو عندي مستقيم الحديث وله اغاليط وقال ابو حاتم لم يكن ممن يكذب واما الحافظ جزرة فقال 
ms164	 كان يكذب وقال النسائي ليس بثقة وقال غيره ضعيف(@)(@@)(@@)(@@) | 3219 - (@)(@@) م عه(@)(@@) عبد الله بن الصامت عن عمه ابي ذر صدوق ومنهم من لم يحتج به(@)(@@)(@@)(@@) | 3220 - (@)(@@) عبد الله بن صدقة عن ابيه يروي عنه البرجلاني لا يعرف(@)(@@)(@@)(@@) | 3221 - (@)(@@) عبد الله بن صفوان عن وهب بن منبه قال هشام بن يوسف ضعيف(@)(@@)(@@)(@@) | 3222 - (@)(@@) ت(@)(@@) عبد الله بن صهبان عن عطية قال ابو حاتم في حديثه شيء(@)(@@)(@@)(@@) | 3223 - (@)(@@) عبد الله بن ضرار الاسدي عن ابن مسعود قال ابو حاتم ليس بالقوي(@)(@@)(@@)(@@) | 3224 - (@)(@@) عبد الله بن ضرار عن ابيه وغيره قال يحيى لا يكتب حديثه(@)(@@)(@@)(@@) | 3225 - (@)(@@) عه(@)(@@) عبد الله بن ظالم عن سعيد بن زيد العشرة في الجنة قال البخاري لم يصح(@)(@@)(@@)(@@) | 3226 - (@)(@@) ق(@)(@@) عبد الله بن عامر الاسلمي المدني عن نافع ضعفه غير واحد(@)(@@)(@@)(@@) | 3227 - (@)(@@) عبد الله بن ابي عامر القرشي المدني قال احمد ضعيف(@)(@@)(@@)(@@) | 3228 - (@)(@@) عبد الله بن عباد بصري نزل مصر عن المفضل بن فضالة ضعيف(@)(@@)(@@)(@@) | 3229 - (@)(@@) عبد الله بن عبد الله بن ابي امية عن ام سلمة لم يثبت حديثه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3230 - (@)(@@) م متابعة عه(@)(@@) عبد الله بن عبد الله بن ابي عامر ابو أويس عن الزهري قال ابن معين صالح وليس بذاك وبعضهم قواه وقال احمد ضعيف وقال ابن معين هو مثل فليح في حديثه ضعف(@)(@@)(@@)(@@) | 3231 - (@)(@@) عبد الله بن عبد الله بن محمد ابو بكر بن ابي سبرة في الكنى كذبه احمد بن حنبل(@)(@@)(@@)(@@) | 3232 - (@)(@@) ق(@)(@@) عبد الله بن عبد الله الاموي عن الحسن بن الحر لا يعرف قال العقيلي لا يتابع على حديثه(@)(@@)(@@)(@@) | 3233 - (@)(@@) عبد الله بن عبد الله شيخ لمحمد بن قيس قال ابن معين لا اعرفه(@)(@@)(@@)(@@) | 3234 - (@)(@@) م د س ق(@)(@@) عبد الله بن عبد الرحمن بن يعلى الطائفي عن عطاء قال ابو حاتم والنسائي ليس بالقوي(@)(@@)(@@)(@@) | 3235 - (@)(@@) عبد الله بن عبد الرحمن عن ابن عمر مجهول(@)(@@)(@@)(@@) | 3236 - (@)(@@) عبد الله بن عبد الرحمن الجزري عن الثوري قال ابن حبان كان يأتي بالأوابد(@)(@@)(@@)(@@) | 3237 - (@)(@@) عبد 
ms165	 الله بن عبد الرحمن الكلبي عن مالك حدث بالطامات ببخارى وكذب(@)(@@)(@@)(@@) | 3238 - (@)(@@) عبد الله بن عبد الرحمن الجمحي عن الزهري لا يعرف وقاله ابن معين قلت روى عنه معن وجماعة قال الدارقطني ليس بالقوي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3239 - (@)(@@) عبد الله بن عبد الرحمن بن مليحة النيسابوري عن عكرمة بن عمار قال الحاكم ابو عبد الله الغالب على رواياته المناكير(@)(@@)(@@)(@@) | 3240 - (@)(@@) عبد الله بن عبد الرحمن بن موهب عن القاسم بن محمد ضعفه ابن معين(@)(@@)(@@)(@@) | 3241 - (@)(@@) عبد الله بن عبد الرحمن بن زيد عن مجهول روى عنه عبد الكريم(@)(@@)(@@)(@@) | 3242 - (@)(@@) عبد الله بن ابي عبد الرحمن عن ابيه مجهول وعنه فطر بن خليفة(@)(@@)(@@)(@@) | 3243 - (@)(@@) عبد الله بن عبد الرحمن بن اسيد الازدي عن انس قال البخاري فيه نظر(@)(@@)(@@)(@@) | 3244 - (@)(@@) عبد الله بن عبد الرحمن المسمعي عن ابيه اتى بحديث منكر لا يعرف ساقه العقيلي(@)(@@)(@@)(@@) | 3245 - (@)(@@) ق(@)(@@) عبد الله بن عبد العزيز بن ابي ثابت الليثي عن الزهري ضعفوه(@)(@@)(@@)(@@) | 3246 - (@)(@@) عبد الله بن عبد العزيز بن ابي رواد عن ابيه قال ابو حاتم وغيره احاديثه منكرة وقال ابن الجنيد لا يساوي فلسا(@)(@@)(@@)(@@) | 3247 - (@)(@@) عبد الله بن عبد العزيز عن مالك اتهمه ابن حبان وقال وحديثه كذب عن نافع عن ابن عمر مرفوعا الرباط على رأس السبعين ومائة افضل فأما(@)(@@)(@@)(@@) | 3248 - (@)(@@) عبد الله بن عبد العزيز العمري الزاهد فوثقه النسائي(@)(@@)(@@)(@@) | 3249 - (@)(@@) عبد الله بن العزيز الحضرمي احد التابعين مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3250 - (@)(@@) عبد الله بن عبد العزيز المديني هو الليثي قد ذكر وقيل الزهري روى عن اخيه خبرا باطلا(@)(@@)(@@)(@@) | 3251 - (@)(@@) ت(@)(@@) عبد الله بن عبد القدوس كوفي نزل الري عن الاعمش ضعفوه(@)(@@)(@@)(@@) | 3252 - (@)(@@) عبد الله بن عبد الكريم الثقفي عن ابي رجاء قال ابو زرعة مجهول(@)(@@)(@@)(@@) | 3253 - (@)(@@) عبد الله بن عبد الملك عن يزيد بن رومان قال ابن حبان لا يشبه حديثه حديث الثقات يروي العجائب(@)(@@)(@@)(@@) | 3254 - (@)(@@) عبد الله بن عبد الملك بن كرز ينسب الى جده(@)(@@)(@@)(@@) | 3255 - (@)(@@) عبد الله بن عبد الملك الاسكندراني عن ابن وهب ضعفه 
ms166	 ابن يونس(@)(@@)(@@)(@@) | 3256 - (@)(@@) عبد الله بن عبيد الله هو ابو عاصم العباداني يأتي(@)(@@)(@@)(@@) | 3257 - (@)(@@) عبد الله بن عبدوس روى عن الانصاري قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) | 3258 - (@)(@@) خ(@)(@@) عبد الله بن عبيدة الربذي اخو موسى عن سهل ابن سعد وثقه غير واحد وقال ابن عدي الضعف على حديثه بين وقال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 3259 - (@)(@@) عبد الله بن عتبة بن ابي سفيان عن ام حبيبة فيه جهالة(@)(@@)(@@)(@@) | 3260 - (@)(@@) م عه(@)(@@) عبد الله بن عثمان بن خثيم وثقه ابن معين مرة(@)(@@) PageV00P000(@)(@@) ومرة قال ليس بالقوي وقال ابو حاتم لا يحتج به(@)(@@)(@@)(@@) | 3261 - (@)(@@) عبد الله بن عثمان بن سعد قال ابن معين لا اعرفه(@)(@@)(@@)(@@) | 3262 - (@)(@@) ق(@)(@@) عبد الله بن عرادة السدوسي عن الرقاشي قال البخاري منكر الحديث(@)(@@)(@@)(@@) | 3263 - (@)(@@) عبد الله بن عصم ابو علوان عن ابن عباس قال ابن حبان منكر الحديث جدا(@)(@@)(@@)(@@) | 3264 - (@)(@@) عبد الله بن عصمة عن حماد بن سلمة لينه العقيلي وغيره(@)(@@)(@@)(@@) | 3265 - (@)(@@) م عه عبد الله بن عطاء المكي شيخ لشعبة وثق وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) | 3266 - (@)(@@) عبد الله بن عطاء بن ابراهيم مولى آل الزبير شيخ لابن إسحاق قال ابن معين لا شيء(@)(@@)(@@)(@@) | 3267 - (@)(@@) عبد الله بن عطاء الابراهيمي متأخر وثقه يحيى بن منده وكذبه السقطي(@)(@@)(@@)(@@) | 3268 - (@)(@@) عبد الله بن عطارد عن مسعر روى احاديث لا يتابع عليها(@)(@@)(@@)(@@) | 3269 - (@)(@@) ق(@)(@@) عبد الله بن عطية لم يرو عنه سوى منيب بن عبد الله(@)(@@)(@@)(@@) | 3270 - (@)(@@) عبد الله بن علي بن نعجة الجهني عن ابيه قال البخاري فيه نظر(@)(@@)(@@)(@@) | 3271 - (@)(@@) عبد الله بن علي بن سويدة التكريتي عن الكروخي قال ابن الدبيثي فيه تساهل في الرواية(@)(@@)(@@)(@@) | 3272 - (@)(@@) عبد الله بن علي بن مهران روى عنه موسى بن عقبة مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3273 - (@)(@@) عبد الله بن علي الباهلي الوضاحي قال ابن طاهر كان يضع الحديث(@)(@@)(@@)(@@) | 3274 - (@)(@@) د ت(@)(@@) عبد الله بن علي أبو أيوب الافريقي عن ابن المنكدر لينه أبو زرعة(@)(@@)(@@)(@@) | 3275 - (@)(@@) عبد الله بن العلاء بن أبي نبقة بيض له مجهول(@)(@@)(@@)(@@) | 3276 - (@)(@@) عبد 
ms167	 الله بن أبي علاج الموصلي عن مالك اتهم بالوضع وقد مر(@)(@@)(@@)(@@) | 3277 - (@)(@@) عبد الله بن عمار اليمامي عن أبي الصلت مجهول(@)(@@)(@@)(@@) | 3278 - (@)(@@) د(@)(@@) عبد الله بن عمر بن غانم الافريقي مجهول الحال واتهمه ابن حبان وذكر له عن نافع عن ابن عمر رفعه الشيخ في بيته كالنبي في قومه وبالسند ما من شجرة احب إلى الله من الحناء(@)(@@)(@@)(@@) | 3279 - (@)(@@) عبد الله بن عمر السعيدي الأموي معاصر لمالك فيه جهالة(@)(@@)(@@)(@@) | 3280 - (@)(@@) عبد الله بن عمر بن أبان قال صالح جزرة كان غاليا في التشيع(@)(@@)(@@)(@@) | 3281 - (@)(@@) م متابعة عه(@)(@@) عبد الله بن عمر بن حفص العمري صدوق حسن الحديث قال أحمد صالح الحديث وقال ابن معين(@)(@@) PageV00P000(@)(@@) يكتب حديثه وقال ابن عدي لا بأس به وعن ابن معين ايضا صويلح وقال س ليس بالقوي(@)(@@)(@@)(@@) | 3282 - (@)(@@) عبد الله بن عمر الخراساني عن الليث لا يعرف وقال ابن عدي له مناكير(@)(@@)(@@)(@@) | 3283 - (@)(@@) عبد الله بن عمران البصري عن أبي عمران الجوني قيل ليس بقوي ذكره العقيلي(@)(@@)(@@)(@@) | 3284 - (@)(@@) عبد الله بن عمرو الواقعي عن أبان العطار قال أبو حاتم يفتعل الحديث وقال في أبيه عمر وقال الرافعي هكذا وقع في كتاب ابن أبي حاتم عن أبيه وقال الكتاني سألت أبا حاتم عن عبد الله بن عمرو الواقعي فقال ضعيف(@)(@@)(@@)(@@) | 3285 - (@)(@@) م عه(@)(@@) عبد الله بن عمرو المخزومي عن عبد الله بن السائب تفرد عنه محمد بن عباد بن جعفر(@)(@@)(@@)(@@) | 3286 - (@)(@@) د(@)(@@) عبد الله بن عمرو بن الفغواء عن أبيه وله صحبة لا يعرف(@)(@@)(@@)(@@) | 3287 - (@)(@@) عبد الله بن عمرو بن هند المخزومي روى عنه عوف قال الدارقطني ليس بقوي(@)(@@)(@@)(@@) | 3288 - (@)(@@) عبد الله بن عمرو بن حسان عن شعبة وغيره متهم بالكذب(@)(@@)(@@)(@@) | 3289 - (@)(@@) عبد الله بن عمرو ببن خداش عن أبي جعفر الباقر مجهول(@)(@@)(@@)(@@) | 3290 - (@)(@@) عبد الله بن عمير القرشي في زمن التابعين مجهول ايضا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3291 - (@)(@@) د ت ق(@)(@@) عبد الله بن عميرة لا يعرف قال البخاري لا يعرف له سماع من الأحنف وذكره ابن حبان في الثقات 
ms168	(@)(@@)(@@)(@@) | 3292 - (@)(@@) م ق(@)(@@) عبد الله بن عياش القتباني المصري عن الاعرج صالح الحدبث قال أبو حاتم صدوق ليس بالمتين وقال أبو داود والنسائي ضعيف(@)(@@)(@@)(@@) | 3293 - (@)(@@) ع(@)(@@) عبد الله بن عيسى بن عبد الرحمن بن أبي ليلي ثقة قال ابن المديني هو عندي منكر الحديث وقال الدارقطني متروك الحديث(@)(@@)(@@)(@@) | 3294 - (@)(@@) عبد الله بن عيسى بن أبي المكدم مصري عن زيد بن سعد وعنه يحيى بن عثمان بن صالح وقال لا يسوى شيئا(@)(@@)(@@)(@@) | 3295 - (@)(@@) ت(@)(@@) عبد الله بن عيسى أبو خلف الخزاز عن يونس بن عبيد ضعفوه(@)(@@)(@@)(@@) | 3296 - (@)(@@) عبد الله بن عيسى الجندي شيخ لعبد الرزاق لا يعرف والحديث منكر(@)(@@)(@@)(@@) | 3297 - (@)(@@) عبد الله بن عيسى أبو مسعود حدث عنه إبراهيم الكندي قال ابن المديني مجهولان(@)(@@)(@@)(@@) | 3298 - (@)(@@) عبد الله بن عيسى أبو علقمة الفروي قال ابن حبان يقلب الأخبار عن الثقات(@)(@@)(@@)(@@) | 3299 - (@)(@@) عبد الله بن عيسى الخزري عن عفان قال الدارقطني كذاب(@)(@@)(@@)(@@) | 3300 - (@)(@@) عبد الله بن عيسى عن أبي الحكم مجهول(@)(@@)(@@)(@@) | 3301 - (@)(@@) عبد الله بن غزوان عن عمرو بن سعد هو وشيخه مجهولان(@)(@@)(@@)(@@) | 3302 - (@)(@@) د(@)(@@) عبد الله بن فضالة عن أبيه ولفضالة صحبة لا يعرفان والخبر منكر في وقت الصلاة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3303 - (@)(@@) عبد الله بن أبي فراس روى عنه قادم بن ميسور مجهول(@)(@@)(@@)(@@) | 3304 - (@)(@@) م د(@)(@@) عبد الله بن فروخ عن عائشة مجهول قلت بل ثقة مشهور(@)(@@)(@@)(@@) | 3305 - (@)(@@) د(@)(@@) عبد الله بن فروخ الأفريقي عن ابن جريج قال البخاري تعرف وتنكر وقال ابن عدي أحاديثه غير محفوظة(@)(@@)(@@)(@@) | 3306 - (@)(@@) عبد الله بن قبيصة عن هشام بن عروة قال العقيلي لا يتابع على كثير من حديثه(@)(@@)(@@)(@@) | 3307 - (@)(@@) عبد الله بن قدامة عن عبد الله بن دينار نكرة له موضوعات(@)(@@)(@@)(@@) | 3308 - (@)(@@) عبد الله بن قنبر عن أبيه عن علي بخبر منكر جدا ذكره العقيلي في الضعفاء(@)(@@)(@@)(@@) | 3309 - (@)(@@) عبد الله بن قيس الخزاز عن حميد الطويل قال الأزدي كذاب(@)(@@)(@@)(@@) | 3310 - (@)(@@) عبد الله بن قيس تابعي أرسل وعنه أبو معاوية المدني مجهولان(@)(@@)(@@)(@@) | 3311 - (@)(@@) عبد الله بن قيس عن ابن 
ms169	 عباس لا يدرى من هو(@)(@@)(@@)(@@) | 3312 - (@)(@@) عبد الله بن كثير المديني عن المقبري قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) | 3313 - (@)(@@) عبد الله بن كرز أبو كرز قاضي الموصل عن نافع قال البخاري هو عبد الله بن عبد الملك بن كرز متروك عنه علي بن الجعد(@)(@@)(@@)(@@) | 3314 - (@)(@@) عبد الله بن كليب عن يحيى بن يعمر مجهول(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3315 - (@)(@@) عبد الله بن كيسان أبو مجاهد عن عكرمة مروزي ضعفه أبو حاتم(@)(@@)(@@)(@@) | 3316 - (@)(@@) خ م(@)(@@) عبد الله بن أبي لبيد المدني عن أبي سلمة ثبت لكنه كان يرى القدر(@)(@@)(@@)(@@) | 3317 - (@)(@@) د ت ق(@)(@@) عبد الله بن لهيعة قاضي مصر ضعيف قال أحمد من كان مثله بمصر في كثرة حديثه وضبطه وقال بعض الناس ما روى عنه مثل ابن وهب وابن المبارك فهو أجود وأقوى(@)(@@)(@@)(@@) | 3318 - (@)(@@) عبد الله بن أبي ليلي عن علي لا يعرف وخبره منكر(@)(@@)(@@)(@@) | 3319 - (@)(@@) د س(@)(@@) عبد الله بن مالك تابعي ماروى عنه إلا كثير بن فرقد(@)(@@)(@@)(@@) | 3320 - (@)(@@) ت ق(@)(@@) عبد الله بن المثني الأنصاري عن عمومته وعنه ابنه محمد قال أبو حاتم صالح الحديث وقال أبو داود لا أخرج حديثه وقال ابن معين ليس بشيء(@)(@@)(@@)(@@) | 3321 - (@)(@@) عبد الله بن محمد بن إبراهيم المروزي عن سليمان بن معبد بخبر باطل(@)(@@)(@@)(@@) | 3322 - (@)(@@) عبد الله بن محمد بن أسامة عن الليث وابن لهيعة اتهمه ابن حبان بالوضع(@)(@@)(@@)(@@) | 3323 - (@)(@@) عبد الله بن محمد بن جعفر بن شاذان عن أحمد بن محمد ابن مهران الرازي بحديث كذب في فاطمة في مشيخة ابن المهتدي بالله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3324 - (@)(@@) عبد الله بن محمد بن جعفر المخرمي كذبه الدارقطني(@)(@@)(@@)(@@) | 3325 - (@)(@@) عبد الله بن محمد بن جعفر أبو القاسم القزويني الفقيه مشهور كذبه الدارقطني(@)(@@)(@@)(@@) | 3326 - (@)(@@) عبد الله بن محمد بن زاذان عن هشام بن عروة ضعفه أبو حاتم(@)(@@)(@@)(@@) | 3327 - (@)(@@) عبد الله بن محمد بن ربيعة القدامي عن مالك ضعفه ابن عدي(@)(@@)(@@)(@@) | 3328 - (@)(@@) عبد الله بن محمد بن سعيد بن أبي مريم عن الفريابي الكبير قال ابن عدي يحدث بالأباطيل فأما ان 
ms170	 يكون مغفلا أو أنه يتعمد(@)(@@)(@@)(@@) | 3329 - (@)(@@) عبد الله بن محمد بن سنان الروحي عن أبي الوليد في حدود سنة سبعين ومائتين اعتنى بحديث روح بن القاسم قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) | 3330 - (@)(@@) عبد الله بن محمد بن أبي الأشعث عن الأعمش جاء في خبر منكر(@)(@@)(@@)(@@) | 3331 - (@)(@@) د(@)(@@) عبد الله بن محمد بن عبد الله بن زيد الأنصاري في الأذان لينه البخاري(@)(@@)(@@)(@@) | 3332 - (@)(@@) عبد الله بن محمد بن عبد الغفار بن ذكوان البعلبكي عن ابن جوصاء تكلم فيه الكتاني(@)(@@)(@@)(@@) | 3333 - (@)(@@) عبد الله بن محمد بن عبد الملك الرقاشي عن جده قال البخاري فيه نظر(@)(@@)(@@)(@@) | 3334 - (@)(@@) عبد الله بن محمد بن عبد المؤمن القرطبي شيخ ابن عبد البر(@)(@@) PageV00P000(@)(@@) تأخر صدوق قال ابن الفرضي لم يكن ضبطه جيدا فربما أخل بالهجاء(@)(@@)(@@)(@@) | 3335 - (@)(@@) عبد الله بن محمد بن عبد الوهاب أبو سعيد الرازي اتهمه الخليلي(@)(@@)(@@)(@@) | 3336 - (@)(@@) عبد الله بن محمد بن عجلان عن أبيه قال ابن حبان لا يحل كتب حديثه(@)(@@)(@@)(@@) | 3337 - (@)(@@) د ت ق(@)(@@) عبد الله بن محمد بن عقيل حسن الحديث احتج به أحمد واسحاق وقال ابن خزيمة لا أحتج به وقال أبو حاتم وغيره لين الحديث(@)(@@)(@@)(@@) | 3338 - (@)(@@) عبد الله بن محمد بن عقيل الباوردي عن النجاد قال عبد الرحمن بن منده قال لي من لم يكن معتزليا فليس بمسلم فتركته(@)(@@)(@@)(@@) | 3339 - (@)(@@) عبد الله بن محمد بن عمار بن سعد القرظ عن أبائه ضعفه ابن معين(@)(@@)(@@)(@@) | 3340 - (@)(@@) عبد الله بن محمد بن عمر بن علي والد عيسى قال بن المديني هو وسط وقال غيره صالح الحديث(@)(@@)(@@)(@@) | 3341 - (@)(@@) عبد الله بن محمد بن قاسم عن يزيد بن هارون تكلم فيه ابن حبان(@)(@@)(@@)(@@) | 3342 - (@)(@@) عبد الله بن محمد بن محارب الاصطخري عن أبي خليفة(@)(@@) PageV00P000(@)(@@) أحاديثه عنه مقلوبة هي بروايات ابن دريد أشبه توفي سنة أربع وثمانين وثلاثمائة(@)(@@)(@@)(@@) | 3343 - (@)(@@) م د(@)(@@) عبد الله بن محمد بن معن عن أم هشام وثق وليس بمعروف(@)(@@)(@@)(@@) | 3344 - (@)(@@) عبد الله بن محمد بن المغيرة الكوفي بمصر عن الثوري 
ms171	 واه قال ابن عدي عامة حديثه لا يتابع عليه(@)(@@)(@@)(@@) | 3345 - (@)(@@) عبد الله بن محمد بن المغيرة المدني عن هشام بن عروة ضعفه ابن عدي وغيره(@)(@@)(@@)(@@) | 3346 - (@)(@@) عبد الله بن محمد بن وهب الدينوري الحافظ قال الدارقطني متروك(@)(@@)(@@)(@@) | 3347 - (@)(@@) عبد الله بن محمد بن يحيى بن عروة تركه أبو حاتم وغيره وقال ابن حبان لا يحل كتبة حديثه 3348(@)(@@) عبد الله بن محمد بن اليسع المقريء الأنطاكي عن أبي عروبة قال الأزهري ليس بحجة كان يقول قرأت الختمة في ساعة(@)(@@)(@@)(@@) | 3349 - (@)(@@) عبد الله بن محمد بن يعقوب البخاري قال أبو سعيد الرواس يتهم بالوضع(@)(@@)(@@)(@@) | 3350 - (@)(@@) عبد الله بن محمد اليمامي عن أدم بن علي مجهول(@)(@@)(@@)(@@) | 3351 - (@)(@@) ق(@)(@@) عبد الله بن محمد العدوي شيخ للوليد بن بكير مجهول وقيل كان وضاعا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3352 - (@)(@@) ق(@)(@@) عبد الله بن محمد الليثي عن تابعي صغير لا يدرى من هو في القدرية(@)(@@)(@@)(@@) | 3353 - (@)(@@) عبد الله بن محمد أبو الحباب عن الزهري قال وكيع كان يضع الحديث(@)(@@)(@@)(@@) | 3354 - (@)(@@) عبد الله بن محمد أبو القاسم البغوي ثقة تكلم فيه بعضهم بلا حجة(@)(@@)(@@)(@@) | 3355 - (@)(@@) عبد الله بن محمد أبو بكر الخزاعي حفيد عبد الرحمن ابن غزوان قراد عن محمود بن خداش وضاع متروك(@)(@@)(@@)(@@) | 3356 - (@)(@@) عبد الله بن محمد أبو القاسم بن الثلاج عن البغوي قال الأزهري كان يضع الحديث(@)(@@)(@@)(@@) | 3357 - (@)(@@) عبد الله بن محمد بن الشرقي أخو الحافظ ابي حامد تكلموا فيه لادمانه المسكر(@)(@@)(@@)(@@) | 3358 - (@)(@@) عبد الله بن محمد المقرىء الحذاء عن ابن المظفر قال ابن خيرون كان يكذب في القراءات(@)(@@)(@@)(@@) | 3359 - (@)(@@) عبد الله بن محمد أبو عباد السراج شيخ للحاكم متهم(@)(@@)(@@)(@@) | 3360 - (@)(@@) ق(@)(@@) عبد الله ابن المحرر يروي عن زيد بن الاصم وقتادة قال أحمد ترك الناس حديثه(@)(@@)(@@)(@@) | 3361 - (@)(@@) عبد الله بن أبي محرز يروي عنه عبد الرحمن بن أبي عمار مجهول(@)(@@)(@@)(@@) | 3362 - (@)(@@) عبد الله بن مروان عن ابن جريج قال ابن عدي حدث عنه سليمان بن عبد الرحمن بمناكير(@)(@@)(@@)(@@) | 3363 - (@)(@@) عبد الله بن مروان عن ابن ابي ذئب 
ms172	 قال ابن حبان لا يحل الاحتجاج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3364 - (@)(@@) عبد الله بن أبي مريم والد أبي بكر الغساني لا يعرف وخبره منكر(@)(@@)(@@)(@@) | 3365 - (@)(@@) د ت ق(@)(@@) عبد الله بن أبي مرة الزوفي وقيل ابن مرة عن خارجة في الوتر لم يصح خبره(@)(@@)(@@)(@@) | 3366 - (@)(@@) عبد الله بن مسلم بن قتيبة ابو محمد صاحب التصانيف صدوق سمع اسحاق بن راهوية قال الحاكم أجمعت الأمة على أن القتيبي كذاب قلت هذا بغي وتخرص بل قال الخطيب هو ثقة(@)(@@)(@@)(@@) | 3367 - (@)(@@) ق(@)(@@) عبد الله بن مسلم بن هرمز عن مجاهد ضعفه ابن معين وقال الإمام أحمد صالح الحديث(@)(@@)(@@)(@@) | 3368 - (@)(@@) د ت س(@)(@@) عبد الله بن مسلم أبو طيبة عن ابن بريدة قال أبو حاتم لا يحتج به وقواه غيره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3369 - (@)(@@) عبد الله بن مسلم بن رشيد عن الليث متهم بوضع الحديث ذكره ابن حبان(@)(@@)(@@)(@@) | 3370 - (@)(@@) عبد الله بن المسور بن عون بن جعفر بن أبي طالب قال أحمد وغيره أحاديثه موضوعة وقال النسائي والدارقطني متروك وهوأبو جعفر عرف بالمدائني في زمن المنصور(@)(@@)(@@)(@@) | 3371 - (@)(@@) عبد الله بن مسعر بن كدام قال أبو حاتم متروك(@)(@@)(@@)(@@) | 3372 - (@)(@@) عبد الله مساور تابعي مجهول(@)(@@)(@@)(@@) | 3373 - (@)(@@) عبد الله بن مصعب بن خالد الجهني عن أبيه عن جده فرفع خطبة منكرة طويلة وعنه عبد الله بن نافع الصائغ(@)(@@)(@@)(@@) | 3374 - (@)(@@) عبد الله بن مصعب الزبيري والد مصعب ضعفه ابن معين(@)(@@)(@@)(@@) | 3375 - (@)(@@) عبد الله بن مضارب من صغار التابعين كذا لا يعرف(@)(@@)(@@)(@@) | 3376 - (@)(@@) عبد الله بن مطر أبو ريحانة في الكنى(@)(@@)(@@)(@@) | 3377 - (@)(@@) س(@)(@@) عبد الله بن المطلب عن أنس لا يعرف(@)(@@)(@@)(@@) | 3378 - (@)(@@) ت ق(@)(@@) عبد الله بن معاذ الصنعاني كان عبد الرزاق يكذبه وله عن معمر ونحوه وأما أبو حاتم فقال هو أوثق من عبد الرزاق(@)(@@)(@@)(@@) | 3379 - (@)(@@) عبد الله بن معانق الأشعري تابعي لينه أبو الحسن الدارقطني(@)(@@)(@@)(@@) | 3380 - (@)(@@) م عه(@)(@@) عبد الله بن معبد الزماني عن أبي قتادة ثقة قال البخاري لا يعرف له سماع منه(@)(@@)(@@)(@@) | 3381 - (@)(@@) عبد الله بن معاوية بن عاصم عن هشام 
ms173	 بن عروة قال البخاري منكر الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3382 - (@)(@@) عبد الله بن مكنف عن أنس مجهول قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) | 3383 - (@)(@@) عبد الله بن ملاذ الأشعري شيخ لجرير بن حازم لا يعرف(@)(@@)(@@)(@@) | 3384 - (@)(@@) عبد الله بن منصور أبو بكر الباقلاني المقريء قال ابن المديني ادعى رواية غير العشرة عن القلانسي فتكلموا فيه وأصر شرها منه(@)(@@)(@@)(@@) | 3385 - (@)(@@) عبد الله بن المنكدر بن محمد بن المنكدر فيه جهالة وله خبر منكر(@)(@@)(@@)(@@) | 3386 - (@)(@@) د ق(@)(@@) عبد الله بن منين المصري لم يرو عنه غير الحارث بن سعيد(@)(@@)(@@)(@@) | 3387 - (@)(@@) عبد الله بن موسى بن كريد عن ابن صاعد صاحب مناكير وأوابد(@)(@@)(@@)(@@) | 3388 - (@)(@@) ق(@)(@@) عبد الله بن موسى التيمي عن أسامة بن زيد ليس بحجة(@)(@@)(@@)(@@) | 3389 - (@)(@@) عبد الله بن موسى هو عمر بن موسى هالك(@)(@@)(@@)(@@) | 3390 - (@)(@@) ت ق(@)(@@) عبد الله بن المؤمل المخزومي عن عطاء ضعفه الدارقطني وجماعة(@)(@@)(@@)(@@) | 3391 - (@)(@@) ق(@)(@@) عبد الله بن ميسرة شيخ لهشيم هو أبو ليلى وهو أبو اسحاق وأبو جرير وأبو الخليل روى عن مجاهد ضعفه النسائي وجماعة(@)(@@)(@@)(@@) | 3392 - (@)(@@) ت(@)(@@) عبد الله بن ميمون القداح المكي عن جعفر بن محمد(@)(@@) PageV00P000(@)(@@) قال أبو حاتم متروك وقال البخاري ذاهب الحديث وقال آخر ليس بحجة(@)(@@)(@@)(@@) | 3393 - (@)(@@) عبد الله بن ميمون عن زهير بن منقذ لا يدرى من هو ولا شيخه(@)(@@)(@@)(@@) | 3394 - (@)(@@) عه(@)(@@) عبد الله بن نافع بن أبي العمياء عن ربيعة بن الحارث قال البخاري لم يصح حديثه(@)(@@)(@@)(@@) | 3395 - (@)(@@) عبد الله بن نافع مولى ابن عمر أخو أبوي بكر وعمر ضعفوه(@)(@@)(@@)(@@) | 3396 - (@)(@@) م عه(@)(@@) عبد الله بن نافع الصائغ عن مالك وثق وقال البخاري في حفظه شيء وقال احمد بن حنبل لم يكن بذاك في الحديث(@)(@@)(@@)(@@) | 3397 - (@)(@@) د س ق(@)(@@) عبد الله بن نجي الحضرمي عن علي قال البخاري فيه نظر(@)(@@)(@@)(@@) | 3398 - (@)(@@) ع(@)(@@) عبد الله بن أبي نجيح المكي المفسر ثقة قال القطان لم يسمع التفسير كله من مجاهد بل كله عن القاسم عن أبي بزة وقد ذكره الجوزجاني فيمن رمي بالقدر هو وزكريا 
ms174	 بن إسحاق وعبد الحميد ابن جعفر وإبراهيم بن نافع وابن إسحاق وعمر بن أبي زائدة وشبل بن عباد وابن أبي ذئب وسيف بن سليمان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3399 - (@)(@@) عبد الله بن نصر الأنطاكي الأصم عن وكيع منكر الحديث(@)(@@)(@@)(@@) | 3400 - (@)(@@) عبد الله بن نصر شيخ يروي عنه حاتم بن اسماعيل المدني مجهول(@)(@@)(@@)(@@) | 3401 - (@)(@@) عبد الله بن نعيم الدمشقي عن الضحاك بن عرزب تكلم فيه(@)(@@)(@@)(@@) | 3402 - (@)(@@) عبد الله بن هارون بن أبي علقمة الفروي له عن القعنبي وغيره مناكير(@)(@@)(@@)(@@) | 3403 - (@)(@@) عبد الله بن هارون الحجازي شيخ معاصر للثوري لا يعرف(@)(@@)(@@)(@@) | 3404 - (@)(@@) عبد الله بن هارون الصوري عن الأوزاعي لا يعرف بخبر كذب في أخلاق الأبدال(@)(@@)(@@)(@@) | 3405 - (@)(@@) عبد الله بن هارون البجلي عن ليث بن أبي سليم فيه لين(@)(@@)(@@)(@@) | 3406 - (@)(@@) عبد الله بن هانئ بن أبي عبلة عن أبيه أدركه أبو حاتم متهم بالكذب(@)(@@)(@@)(@@) | 3407 - (@)(@@) ت س(@)(@@) عبد الله بن هانئ أبو الزعراء عن ابن مسعود قال البخاري لا يتابع عليه(@)(@@)(@@)(@@) | 3408 - (@)(@@) عبد الله بن هبة الله الحلي البزاز عن سبط الخياط أبي محمد ونحوه مات سنة تسع وستماية ظهر أن السماع لأخ له قديم(@)(@@)(@@)(@@) | 3409 - (@)(@@) عبد الله بن هشام الدستوائي عن أبيه قال أبو حاتم متروك الحديث(@)(@@)(@@)(@@) | 3410 - (@)(@@) عبد الله بن أبي هند روى عنه أبو مالك الأشجعي قال خ حديثه منكر(@)(@@)(@@)(@@) | 3411 - (@)(@@) عبد الله بن واقد أبو قتادة الحراني مشهور بالحديث والزهد قال أبو حاتم ذهب حديثه وقال الدارقطني وغيره ضعيف وأما أحمد فقال ما به بأس وربما أخطأ وقال البخاري تركوه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3412 - (@)(@@) عبد الله بن واقد قال عباس عن ابن معين روى عن أبي الزبير وقتادة ليس بشيء ذكره العقيلي(@)(@@)(@@)(@@) | 3413 - (@)(@@) ق(@)(@@) عبد الله بن واقد أبو رجاء الخراساني عن ابن عجلان قال ابن عدي مظلم الحديث(@)(@@)(@@)(@@) | 3414 - (@)(@@) د ت س(@)(@@) عبد الله بن الوليد العدني صدوق سمع الثوري قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) | 3415 - (@)(@@) عبد الله بن وهب شيخ عراقي روى عنه أبو سعيد الأشج فأما(@)(@@)(@@)(@@) | 3416 - (@)(@@) عبد الله بن وهب 
ms175	 المصري الإمام ثقة ثبت تناكد ابن عدي بذكره في الكامل وكذا ذكر(@)(@@)(@@)(@@) | 3417 - (@)(@@) عبد الله بن يوسف التنيسي وهو ثقة حجة(@)(@@)(@@)(@@) | 3418 - (@)(@@) عبد الله بن وهب النسوي عن يزيد بن هارون قال ابن حبان دجال يضع الحديث(@)(@@)(@@)(@@) | 3419 - (@)(@@) عبد الله بن وهب من رؤس الحرورية زائغ(@)(@@)(@@)(@@) | 3420 - (@)(@@) عبد الله بن يحيى الألهاني شيخ لبقية والوليد بن مسلم صدوق إن شاء الله تعالى(@)(@@)(@@)(@@) | 3421 - (@)(@@) عبد الله بن يحيى بن موسى السرخسي لقيه ابن عدي واتهمه(@)(@@)(@@)(@@) | 3422 - (@)(@@) عبد الله بن يحيى الثقفي التوأم عن ابن أبي مليكة ضعف(@)(@@)(@@)(@@) | 3423 - (@)(@@) عبد الله بن يحيى المؤدب عن اسماعيل بن عياش بخبر كذب في فضل معاوية لا يعرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3424 - (@)(@@) عبد الله بن يحيى البرلسي قال الدارقطني مجهول قلت صالح الحديث سمع حيوة بن شريح(@)(@@)(@@)(@@) | 3425 - (@)(@@) عبد الله بن يزيد بن آدم الدمشقي تابعي قال أحمد أحاديثه موضوعة(@)(@@)(@@)(@@) | 3426 - (@)(@@) عبد الله بن يزيد بن تميم السلمي أخو عبد الرحمن وثقه دحيم وقال أحمد ثنا عنه الوليد بن مسلم بمناكير(@)(@@)(@@)(@@) | 3427 - (@)(@@) عبد الله بن يزيد أبو عقيل قال الجوزجاني أحاديثه منكرة(@)(@@)(@@)(@@) | 3428 - (@)(@@) عبد الله بن يزيد بن قنطس عن أنس قال البخاري متهم بأمر عظيم وأما احمد بن حنبل ويحيى بن معين فوثقاه(@)(@@)(@@)(@@) | 3429 - (@)(@@) عبد الله بن يزيد مولى المنبعث صدوق قال الدارقطني يعتبر به(@)(@@)(@@)(@@) | 3430 - (@)(@@) عبد الله بن يزيد بن الحداني عن سليمان بن زريق عن الحسن بحديث منكر ولا يعرف(@)(@@)(@@)(@@) | 3431 - (@)(@@) عبد الله بن يزيد البكري عن عكرمة بن عمار ضعفه أبو حاتم(@)(@@)(@@)(@@) | 3432 - (@)(@@) عبد الله بن يزيد محمش النيسابوري عن هشام بن عبيد الله كذاب(@)(@@)(@@)(@@) | 3433 - (@)(@@) عبد الله بن يسار تابعي هو ابن أبي نجيح ثقة مر قال ابن الجوزي قال يحيى كان من رؤس الدعاة الى القدر(@)(@@)(@@)(@@) | 3434 - (@)(@@) عبد الله بن يعقوب الكرماني شيخ ابن محمش ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3435 - (@)(@@) عبد الله بن يعلى بن مرة الثقفي عن أبيه ضعفه غير واحد(@)(@@)(@@)(@@) | 3436 - (@)(@@) د س(@)(@@) عبد الله بن يونس تابعي لم يرو عنه غير يزيد 
