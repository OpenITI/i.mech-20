ms621	 روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عدي بن الخيار بن عدي القرشي(@)(@@) من بني نوفل بن عبد مناف، عن: عمر، وعثمان، روى عنه: عروة بن الزبير، وحميد بن عبد الرحمن، مات سنة خمس وتسعين، وأمه أم قتال بنت أسيد بن أبي العاص بن أمية بن عبد شمس.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الرحمن بن عوف(@)(@@) يروي عن: أبيه، استشهد بأفريقية هو وأولاده، وسمى أبا الشهداء من كثرة من قتل من أولاده معه، لم ينشر له كثير حديث.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الحارث الشيباني(@)(@@) من أهل الكوفة، يروي عن: جماعة من الصحابة، روى عنه: الكوفيون.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن جرير بن عبد الله البجلي(@)(@@) يروي عن: أبيه، روى عنه: أبو إسحاق السبيعي.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن رفاعة بن رافع(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: ابنه إسماعيل بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن محصن الأنصاري(@)(@@) عن: أبيه، ولأبيه صحبة، روى عنه: عبد الرحمن بن أبي شميلة الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن أبي ثور(@)(@@) من بني نوفل، عن:(@)PageV01P002(@)(@@) [ج 2: ص 297] ابن عباس، عداده في أهل المدينة، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي بكر بن أنس بن مالك الأنصاري(@)(@@) يروي عن: أنس بن مالك، عداده في أهل البصرة، روى عنه: شعبة، وحماد بن سلمة، وهشيم.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الأعجم(@)(@@) يروي عن: ابن عباس، عداده في أهل الكوفة، روى عنه: أبو إسحاق السبيعي، قال:(@)(@@) (182) -[2: 297] ثنا خليفة، قال: ثنا ابن كثير، قال: ثنا سفيان الثوري، عن أبي إسحاق، عن عبيد الله بن الأعجم، قال: سألت ابن عباس عن " الجعائل تخرج إلينا في البعث في كل أربعة واحدا ومن كل ثلاثة واحدا، فقال: إن جعلتها في كراع أو سلاح فلا بأس، وإن جعلتها في عبد أو أمة أو غنم فهو غير طائل "(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الحر الجعفي(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: سليمان بن يسار.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن خليفة الخزاعي(@)(@@) كوفي، يروي 
ms622	 عن: عمر، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن بسر(@)(@@) يروي عن: أبي أمامة، عداده في أهل الشام، روى عنه: صفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن رفاعة(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن جبير بن حبة الثقفي(@)(@@) أخو زياد، وعبد الله، يروي عن: أبي موسى الأشعري، عداده في أهل الكوفة، روى عنه: ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي جروة العبدي(@)(@@) يروي عن: عائشة، عداده في أهل البصرة، روى عنه: أهلها.(@)PageV01P002(@)(@@) [ج 2: ص 298](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن خنيس(@)(@@) من أهل المدينة، يروي عن: عبد الله بن سلام، روى عنه: محمد بن أبي يحيى.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن رافع بن خديج(@)(@@) يروي عن: أبيه، روى عنه: أهل المدينة، كنيته أبو الفضل، مات سنة إحدى عشرة ومائة وهو ابن خمس وثمانين سنة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الرحمن العدوي(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عاصم بن المنذر.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عمرو(@)(@@) يروي عن: أبي هريرة، عداده في البصريين، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أسد الخولاني(@)(@@) ربيب ميمونة زوجة النبي صلى الله عليه وسلم يروي عن: عثمان بن عفان، وزيد بن خالد، عداده في أهل المدينة، روى عنه: عاصم بن عمر بن قتادة، وبشر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله أبو الخطاب(@)(@@) ومنزله في ربعة بالبصرة، يروي عن: أنس بن مالك، روى عنه: النضر بن شميل.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عمرو الحارثي الهمداني(@)(@@) يروي عن: علي، وعبد الله، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن دهقان(@)(@@) مولى أنس بن مالك، يروي عن: أنس بن مالك، روى عنه: هشام بن عروة، وهشام بن حسان.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي رافع(@)(@@) مولى النبي صلى الله عليه وسلم يروي عن: علي بن أبي طالب، وكان كاتبه، وأبي هريرة، عداده في أهل المدينة، روى عنه: الأعرج، وبسر بن سعيد.(@)PageV01P002(@)(@@) [ج 2: ص 299](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن خليفة الهمداني أبو الغريف(@)(@@) يروي 
ms623	 عن: صفوان بن عسال المرادي، عداده في أهل الكوفة، روى عنه: أبو روق عطية بن الحارث الهمداني.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن علي بن أبي رافع(@)(@@) مولى رسول الله صلى الله عليه وسلم يروي عن: جدته سلمى بنت قيس مولاة رسول الله صلى الله عليه وسلم ولها صحبة، روى عنه: فائد مولى عبيد الله بن علي بن أبي رافع من حديث الفضل بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الأرقم بن أبي الأرقم(@)(@@) يروي عن: أبيه، روى عنه: داود بن قيس الفراء، استشهد بدمشق في خلافة عمر بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن سالم(@)(@@) يروي عن: ابن عمر، روى عنه: سعيد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عتبة بن غزوان المازني(@)(@@) من بني مازن بن منصور، قتل يوم الحرة سنة ثلاث وستين.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن عباس بن عبد المطلب(@)(@@) يروي(@)(@@) (183) -[2: 299] عن أبيه، روى عنه: أبو جهضم موسى بن سالم حديثه " أمرنا رسول الله صلى الله عليه وسلم أن لا ننزي الحمار على الفرس، وأن لا نأكل الصدقة، وأن نسبغ الوضوء ". هكذا قال معاذ بن هشام: عن أبيه، عن أبي جهضم، فقال: عبيد الله بن عبد الله، وقال: ابن علية، عن أبي جهضم، عن عبد الله بن عبيد الله بن عباس(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن الحارث بن نوفل بن الحارث بن عبد المطلب(@)(@@) يروي عن: أم هانئ، روى عنه: الزهري في سبحة الضحى.(@)PageV01P002(@)(@@) [ج 2: ص 300](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن الحصين الخطمي الأنصاري(@)(@@) يروي عن: جابر بن عبد الله، وعبد الله بن عمرو، عداده في أهل المدينة، روى عنه: محمد بن إسحاق، وعبد الرحمن بن النعمان، وابن الهاد، وهو الذي يروي عن: هرمى بن عبد الله بن خزيمة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن رواحة(@)(@@) يروي عن: أنس بن مالك، عداده في البصريين، روى عنه: إسماعيل بن أبي خالد، وحماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن طلحة التيمي(@)(@@) يروي عن: أبي هريرة، روى فليح بن 
ms624	 سليمان، عن محمد بن عبد الرحمن بن حصين عنه.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن رافع بن خديج(@)(@@) يروي عن: أبيه، روى عنه: سليط بن أبي أيوب، مات سنة إحدى عشرة ومائة، وهو ابن خمس وثمانين سنة، وكنيته أبو الفضل.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن زياد الكندي أبو زيادة البكري(@)(@@) يروي عن: بلال، عداده في أهل الشام، روى عنه: ابن جابر، وأهلها.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الرحمن بن رافع بن خديج(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: هشام بن عروة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن زاذويه(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى ربيعة بن كلثوم، عن أبيه عنه.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله بن موهب القرشي(@)(@@) من أهل المدينة، يروي PageV01P002 [ج 2: ص 301] عن: أبي هريرة، روى عنه: ابنه يحيى بن عبيد الله، وهو لا شيء، وأبوه ثقة، وإنما وقع المناكير في حديث أبيه من قبل ابنه يحيى، وهم أخوة ثلاثة عبيد الله، وعثمان، ويحيى بنو عبيد الله بن موهب، وقد روى أبو بكر الحنفي، عن عبيد الله بن عبد الرحمن بن موهب، عن عمه عبيد الله بن موهب، عن أبي هريرة، أسقط من النسبة عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عياض بن عمرو المكي(@)(@@) يروي عن: عائشة، وجابر، وأبي سعيد، روى عنه: عمرو بن دينار المكي.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن جبير(@)(@@) يروي عن: أبي موسى الأشعري، روى عنه: محمد ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله الخولاني(@)(@@) من أهل المدينة، يروي عن: عثمان بن عفان، وابن عباس، روى عنه: محمد بن طلحة بن يزيد بن ركانة، وعاصم بن عمر بن قتادة.(@)(@@)(@@)(@@) ||| AUTO أبو المدله(@)(@@) يروي عن: أبي هريرة، وهو مولاه، اسمه عبيد الله بن عبد الله، روى عنه: سعد الطائي.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله الأعشى(@)(@@) يروي عن: عائشة، روى عنه: حصين بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن باباه(@)(@@) يروي عن: ابن عمر، روى عنه: عيسى بن عبيد.(@)(@@)(@@)(@@) ||| AUTO 
ms625	 عبيد الله بن غني العقيلي(@)(@@) يروي عن: عمر، روى عنه: قرة بن خالد السدوسي.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن كعب بن مالك بن أبي القين السلمي الأنصاري(@)(@@) أخو معبد، وعبد الرحمن، وعبد الله، يروي عن: أبيه، عداده في أهل المدينة، روى عنه: أهلها، وكنيته PageV01P002 [ج 2: ص 302] أبو فضالة، وقد سمع عثمان بن عفان.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي يزيد(@)(@@) مولى آل قارظ، حليف لبني زهرة، يروي عن: ابن عباس، وابن عمر، عداده في أهل مكة، روى عنه: شعبة، وابن جريج، وابن عيينة، مات سنة ست وعشرين ومائة، وله ست وثمانون سنة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الحارث(@)(@@) يروي عن: عبد الله بن عمر، روى عنه: عبد العزيز بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن مقسم المدني(@)(@@) يروي عن: جابر، وابن عمر، وأبي هريرة، روى عنه: يحيى بن أبي كثير، وإسحاق بن حازم، وداود بن قيس، وأبو حازم.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن القبطية(@)(@@) من لخم من رهط عبد الملك بن عمير، يروي عن: جابر بن سمرة، وأم سلمة، عداده في أهل الكوفة، روى عنه: مسعر، وفرات القزاز، وعبد العزيز بن رفيع.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي نهيك(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: ابن أبي مليكة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي سليمان(@)(@@) يروي عن: علي، روى عنه: فضالة بن نافع.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن معمر القرشي التيمي(@)(@@) يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم كان واليا على البصرة، روى عنه: ابن سيرين، قتل في خلافة عمر بن الخطاب في وقعة اصطخر وهو أمير القوم يومئذ.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن كريز الخزاعي(@)(@@) يروي عن: عبد الله بن المغفل، عداده في أهل البصرة، روى عنه: ابنه طلحة بن عبيد الله بن كريز.(@)PageV01P002(@)(@@) [ج 2: ص 303](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عسيلة، أبو عبد الله الصنابحي(@)(@@) هاجر من اليمن إلى النبي صلى الله عليه وسلم فلما قدم الجحفة لقيه راكب فسأله ما الخبر؟ فقال: دفنا النبي صلى الله عليه وسلم منذ خمس 
ms626	 ليال، فدخل المدينة وقد استخلف أبو بكر، فأقام بها مدة ثم انتقل إلى الشام فسكنها، روى عنه: عطاء بن يسار، والشاميون.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عويم بن ساعدة(@)(@@) ولد في عهد رسول الله صلى الله عليه وسلم يروي عن: جماعة، مات سنة تسع وتسعين.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مل، أبو عثمان النهدي من قضاعة(@)(@@) أدرك الجاهلية، يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه الناس، وهو عبد الرحمن بن مل بن عمرو بن أبي عمرو بن عدي بن وهب بن ربيعة بن خزيمة بن كعب بن رفاعة بن مالك، مات سنة خمس وتسعين وهو ابن ثلاثين ومائة سنة، أسلم على عهد عمر، وأدى إليه الصدقات، وغزا في عهد عمر القادسية، وجلولاء، وتستر، ونهاوند، وأذربيجان، وقد قيل: مات أبو عثمان النهدي سنة مائة، وكان مقيما بالكوفة، فلما قتل الحسين بن علي انتقل منها إلى البصرة، وقال: " لا أسكن بلدا قتل فيها ابن بنت النبي صلى الله عليه وسلم وكان أبو عثمان، يقول: بلغت ثلاثين ومائة سنة كل شيء مني عرفت فيه النقص إلا أملي فإني أراه كما هو ".(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن مسعود الهذلي(@)(@@) يروي عن: أبيه، عداده في أهل الكوفة، روى عنه: عبد الملك بن عمير، مات سنة تسع وسبعين سنة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الأسود بن عبد يغوث بن وهب بن عبد مناف بن زهرة القرشي الزهري(@)(@@) يروي عن: أبي بن كعب، عداده في أهل المدينة، روى عنه: أهلها، ومن زعم أنه عبد الله بن الأسود فقد وهم، قاله إبراهيم بن سعد وهو يعد في الصحابة أيضا، أمه PageV01P002 [ج 2: ص 304] آمنة بنت نوفل بن أهيب بن عبد مناف بن زهرة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حاطب بن أبي بلتعة(@)(@@) يروي عن: عمر وعثمان، روى عنه: ابنه يحيى بن عبد الرحمن بن حاطب بن أبي بلتعة، مات عبد الرحمن سنة ثمان وستين، وقد قيل: إنه ولد في زمن النبي صلى الله عليه وسلم 
ms627	 عبد الرحمن بن رافع بن خديج الأنصاري أخو عبد الله، يروي عن: أبيه، روى عنه: ابنه هرير بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن صبيحة بن الحارث بن جبلة بن عامر بن كعب بن سعد بن تيم بن مرة(@)(@@) يروي عن: جماعة من أصحاب النبي صلى الله عليه وسلم روى عنه: أهل المدينة، أمه بنت عميرة بن عبد العزى.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن جابر بن عبد الله الأنصاري(@)(@@) يروي عن: أبيه، عداده في أهل المدينة، روى عنه: سليمان بن يسار، وعاصم بن عمر بن قتادة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي سعيد الخدري، كنيته أبو محمد(@)(@@) وقد قيل: أبو حفص، يروي عن: أبيه، روى عنه: زيد بن أسلم، وعمارة بن غزية، وابناه سعيد بن عبد الرحمن، وربيح بن عبد الرحمن، مات بالمدينة سنة ثنتي عشرة، ومائة وهو ابن سبع وسبعين سنة، أمه بنت عبد الله بن الحارث بن قيس.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي بكرة الثقفي، كنيته أبو بحر(@)(@@) وهو أول مولود ولد بالبصرة من المسلمين، يروي عن: أبيه، وعلي، روى عنه: محمد ابن سيرين، وعبد الملك بن عمير.(@)PageV01P002(@)(@@) [ج 2: ص 305](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الأسود بن يزيد النخعي(@)(@@) من أهل الكوفة، كنيته أبو حفص، يروي عن: عائشة، وابن أبي أوفى، روى عنه: أهل الكوفة، مات سنة تسع وتسعين، وقد قيل: إنه مات في ولاية خالد بن عبد الله، وصلى عليه خالد بن عبد الله، وكان سنه سن إبراهيم النخعي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعيد بن يربوع بن عنكثة بن عامر بن مخزوم المخزومي القرشي(@)(@@) كان اسم أبيه صرما، فسماه النبي صلى الله عليه وسلم سعيدا، يروي عن: أبيه، روى عنه: ابن ابنه عمر بن عثمان بن عبد الرحمن بن سعيد، مات عبد الرحمن سنة تسع ومائة وهو ابن ثمانين سنة، كنيته أبو محمد، أمه بنت عك.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن غنم الأشعري(@)(@@) سكن الشام، زعموا أن له صحبة، وليس ذلك بصحيح عندي، مات سنة ثمان وسبعين.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن 
ms628	 خالد بن الوليد بن المغيرة المخزومي القرشي(@)(@@) قوله، روى عنه: عمرو بن قيس الشامي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الحارث بن هشام بن المغيرة القرشي(@)(@@) من أهل المدينة، كنيته أبو محمد، يروي عن: عمر، وعثمان، وعائشة، روى عنه: أبو بكر بن عبد الرحمن بن الحارث، مات سنة ثلاث وأربعين.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن جبير بن نفير بن مالك بن عامر الحضرمي(@)(@@) سمع عبد الله بن عمرو، روى عن: جماعة من الصحابة، روى عنه: أهل الشام، مات سنة ثمان عشرة ومائة، كنيته أبو حميد، وقد قيل: أبو حمير، والزبيدي، وصفوان، يكثران الرواية عنه.(@)PageV01P002(@)(@@) [ج 2: ص 306](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد القاري(@)(@@) يروي عن: عمر، عداده في أهل المدينة، وكان عامل عمر على بيت المال، روى عنه: عروة بن الزبير، وحميد بن عبد الرحمن، مات سنة ثمان وثمانين، وهو ابن ثمان وسبعين سنة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن جبير القرشي(@)(@@) مولى نافع مولى ابن عمرو، يروي عن: عبد الله بن عمرو، عداده في أهل مصر، روى عنه: دراج، وكعب بن علقمة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن أبي ذؤيب الأسدي(@)(@@) وكان يتيما في حجر الزبير بن العوام، يروي عن: الزبير بن العوام، روى عنه: محمد بن كعب القرظي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حيان الأنصاري(@)(@@) يروي عن: حكيم بن حزام، روى عنه: بكير بن عبد الله بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن كعب بن مالك السلمي الأنصاري، كنيته أبو الخطاب(@)(@@) يروي عن: أبيه، روى عنه: الزهري، مات في ولاية سليمان أو هشام بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الأسود العنسي(@)(@@) يروي عن: عمر، عداده في أهل الشام، روى عنه: أبو بكر بن أبي مريم الغساني.(@)(@@)(@@)(@@) ||| AUTO أبو عبد رب الزاهد اسمه عبد الرحمن(@)(@@) مولى لابن غيلان الثقفي، وكان روميا اسمه قسطنطين، فلما أسلم يسمى بعبد الرحمن، يروي عن: معاوية، عداده في أهل الشام، روى عنه: أهلها، وكان من أيسر أهل دمشق مالا فتصدق بماله كله، وكان يقول: " لو أن بردا 
ms629	 سال ذهبا وفضة ما أتيته لآخذ منه شيئا، ولو قيل: من مس هذا العمود مات لقمت إليه حتى أمسه ".(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن المطلب بن أبي وداعة السهمي(@)(@@) يروي عن: أبيه، روى عنه: أبو سفيان بن عبد الرحمن ابنه، وحفص بن عبد الله بن صيفي.(@)PageV01P002(@)(@@) [ج 2: ص 307](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن نافع بن عبد الحارث خزاعي(@)(@@) يروي عن: جماعة من الصحابة، روى عنه: الناس.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي هريرة(@)(@@) يروي عن: أبيه، روى عنه: الحجازيون.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن بشر بن مسعود الأنصاري(@)(@@) يروي عن: أبي سعيد، وأبي مسعود، روى عنه: محمد ابن سيرين، وإبراهيم النخعي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعيد بن وهب الهمداني(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي قتادة(@)(@@) أخو عبد الله بن أبي قتادة، واسم أبي قتادة الحارث بن ربعي، يروي عن: أبيه، روى عنه: ابنه كعب بن عبد الرحمن، وموسى بن عبد الله بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن رزين(@)(@@) مولى قريش، يروي عن: سلمة بن الأكوع، قال: بايعت بيدي هذه رسول الله صلى الله عليه وسلم فقبلناها فلم ينكر ذلك، عداده في أهل الشام، روى عنه: أهلها، والعطاف بن خالد المخزومي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن صفوان بن قدامة(@)(@@) يروي عن: أبيه، ولأبيه صحبة، روى عنه: ابنه موسى بن عبد الرحمن بن صفوان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن زياد(@)(@@) شيخ، يروي عن: قباث بن أشيم، روى عنه: يونس بن سيف.(@)PageV01P002(@)(@@) [ج 2: ص 308](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الحباب السلمي(@)(@@) يروي عن: أبي قتادة، روى عنه: بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الأخنس(@)(@@) يروي عن: سعيد بن زيد، روى عنه: الحر بن الصباح النخعي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن آدم صاحب السقاية(@)(@@) مولى أم برثن، يروي عن: جابر، وأبي هريرة، عداده في أهل البصرة، روى عنه: قتادة، وسليمان التيمي بن قتيبة، قال:(@)(@@) (184) -[2: 308] ثنا معتمر بن سليمان، عن أبيه، عن عبد الرحمن صاحب السقاية، عن جابر 
ms630	 بن عبد الله، عن النبي صلى الله عليه وسلم قال: " ما من نفس منفوسة اليوم تأتي عليها مائة سنة "(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن بشر اليحصبي(@)(@@) يروي عن: أبي أمامة، روى عنه: حريز بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن جوشن الغطفاني(@)(@@) يروي عن: أبي بكرة، روى عنه: عيينة بن عبد الرحمن ابنه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أيمن المخزومي(@)(@@) يروي عن: ابن عمر، وأبي سعيد، عداده في أهل مكة، روى عنه: عمرو بن دينار، قال: سألت ابن عمر، عن صلاة المغرب، أوتر النهار هي؟ قال: نعم.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن أم الحكم(@)(@@) يروي المراسيل، وسمع من عثمان بن عفان، روى عنه: العيزار بن حريث، مات سنة ثلاث وثمانين في ولاية عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يعلى بن مرة الثقفي(@)(@@) يروي عن: أبيه، ولأبيه صحبة، روى PageV01P002 [ج 2: ص 309] عنه: أهل الحجاز، وهو عم عمر بن عبد الله بن يعلى بن مرة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سلمة(@)(@@) أخو شقيق بن سلمة، رأى جماعة من الصحابة، روى عنه: أخوه أبو وائل، قال: قال أخي عبد الرحمن بن سلمة: " ما كذبت منذ أسلمت إلا أن الرجل يدعوني إلى طعامه فأقول لا أشتهي، وعسى أن يكون كذبا ".(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن بجيد الحارثي الأنصاري(@)(@@) أحد بني حارثة، من أهل المدينة، يروي عن: جدته أم بجيد، وكانت من المبايعات، روى عنه: محمد بن إبراهيم التيمي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سليمان بن عبد الله بن حنظلة بن الغسيل الأنصاري(@)(@@) من أهل المدينة، كنيته أبو سليمان، يروي عن: سهل بن سعد، روى عنه: عبد الله بن إدريس.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن علقمة(@)(@@) يروي عن: ابن عباس، وابن عمر، روى عنه: الثوري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أذينة العبدي(@)(@@) يروي عن: أبيه، روى عنه: عبد الملك بن أعين، وكان على قضاء البصرة زمن شريح، فلما مات طلب أبو قلابة للقضاء، فهرب إلى الشام مخافة أن يولى، ومات في أول ولاية الحجاج بن يوسف على العراق.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن 
ms631	 بن عداء الكندي(@)(@@) يروي عن: أبي أمامة، عداده في أهل الشام، روى عنه: شعبة.(@)PageV01P002(@)(@@) [ج 2: ص 310](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حصين بن أوس(@)(@@) يروي عن: ابن عمر، روى عنه: عمرو بن وهب بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يزيد النخعي الهمداني(@)(@@) أخو الأسود بن يزيد، من أهل الكوفة، كنيته أبو بكر، يروي عن: علي، وحذيفة، روى عنه: إبراهيم بن سويد أبو إسحاق السبيعي، قتل في الجماجم سنة ثلاث وثمانين.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الرحمن بن سليمان أبو الأعيس(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم عداده في أهل الشام، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي هلال المصري(@)(@@) يروي عن: أبي هريرة، روى عنه: محمد بن الحجاج الخولاني.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أذنان(@)(@@) يروي عن: علي، روى عنه: أبو إسحاق.(@)(@@) عبد الرحمن بن سليمان(@)(@@) أدرك أصحاب النبي صلى الله عليه وسلم وتوفي بعد الحرة، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أنس السلمي(@)(@@) يروي عن: العباس بن مرداس، روى عنه: الزهري في قصة إسلامه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن الجرمي(@)(@@) يروي عن: سمرة بن جندب، روى عنه: ابنه أشعث بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أوس(@)(@@) يروي عن: أبي هريرة، روى عنه: بكر بن سوادة.(@)PageV01P002(@)(@@) [ج 2: ص 311](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الرحمن بن يزيد الأنصاري(@)(@@) من بني عمرو بن عوف، يروي عن: عمه مجمع بن جارية، روى عنه: عبد الله بن ثعلبة الأنصاري من حديث الزهري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن زيد بن عقبة بن كريم(@)(@@) يروي عن: أنس بن مالك، عداده في أهل المدينة، روى عنه: موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن الجندي(@)(@@) يروي عن: عبد الله بن بسر، روى صفوان بن عمرو، عن عبد الله بن الحجاج، وسوادة البرجمي، عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حماد(@)(@@) يروي عن: علي، روى عنه: عثمان بن إبراهيم الحاطبي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حميد بن عبد الرحمن بن عوف(@)(@@) سمع عمر بن عبد العزيز يسأل السائب بن يزيد: ما سمعت 
ms632	 في سكنى مكة، والسائب له صحبة، روى عنه: سفيان الثوري.(@)(@@) عبد الرحمن(@)(@@) والد القاسم بن عبد الرحمن الشامي، يروي عن: أبي هريرة، روى عنه: ابنه القاسم بن عبد الرحمن، لا يعتبر برواية ابنه عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يعلى بن أمية الثقفي(@)(@@) يروي عن: أبيه يعلى بن أمية، روى عنه: الناس.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سمير(@)(@@) وقد قيل: سميرة، يروي عن: ابن عمر، روى عنه: عون بن أبي جحيفة.(@)PageV01P002(@)(@@) [ج 2: ص 312](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حسان بن ثابت، كنيته أبو سعيد(@)(@@) يروي عن: أبيه، روى عنه: أهل المدينة، وعبد الرحمن بن بهمان، وقد قيل: أن حراما أبا المنذر عاش عشرين ومائة سنة، وعاش ابنه المنذر عشرين ومائة سنة، وعاش ابن ابنه ثابت بن المنذر عشرين ومائة سنة، وكان حسان بن ثابت، قد عاش عشرين ومائة سنة، وكان عبد الرحمن بن حسان إذا ذكر هذا الحديث استلقى على فراشه، وضحك، وتمدد مات سنة أربع ومائة وهو ابن اثنين وسبعين سنة، وقيل: وهو ابن ثمان وأربعين سنة، أمه سيرين أخت مارية القبطية.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سلمة الجمحي القرشي(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: سعيد بن عبد العزيز.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي أمية(@)(@@) يروي عن: ابن عمر، روى عنه: طلق بن جعبان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن معدان الرعيني(@)(@@) يروي عن: جماعة من الصحابة، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن معقل بن يسار(@)(@@) يروي عن: عمر، أو ابن عمر، روى عنه: قرة بن خالد السدوسي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن دينار الثقفي(@)(@@) يروي عن: عمر، روى عنه: الحسن بن عبيد الله الكوفي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الأصم العبدي، كنيته أبو بكر(@)(@@) يروي عن: أنس بن مالك، روى عنه: الثوري، وأبو عوانة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عمرو بن سهل المدني(@)(@@) يروي عن: سعيد بن زيد، PageV01P002 [ج 2: ص 313] روى عنه: نافع، وطلحة بن عبد الله بن عوف، وكان عامل الوليد بن عقبة على الصدقات.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن 
ms633	 بن السائب(@)(@@) يروي عن: أبي هريرة، روى عنه: عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي حدرد الأسلمي(@)(@@) يروي عن: أبي هريرة، روى عنه: أبو مودود.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي عمرة النجاري(@)(@@) من أهل المدينة، يروي عن: عثمان بن عفان، وزيد بن خالد، روى عنه: عثمان بن حكيم، وهلال بن علي، ومحمد بن إبراهيم بن المطلب بن حنطب، أمه هند بنت المقوم بن عبد المطلب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن البيلماني(@)(@@) مولى عمر بن الخطاب، يروي عن: ابن عمر، روى عنه: زيد بن أسلم، وسماك بن الفضل، وهو عبد الرحمن البيلماني من الأبناء، وكان ينزل بحران، مات في أول ولاية الوليد بن عبد الملك، لا يجب أن يعتبر بشيء من حديثه إذا كان من رواية ابنه لأن ابنه محمد بن عبد الرحمن يضع على أبيه العجائب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن طرفة(@)(@@) يروي عن: عرفجة بن أسعد، روى عنه: أبو الأشهب العطاردي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الخشخاش(@)(@@) يروي عن: فضالة بن عبيد، روى عنه: أنس بن أبي أنس.(@)PageV01P002(@)(@@) [ج 2: ص 314](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن عبد الرحمن بن سابط بن أبي حميضة بن عمرو بن أهيب الجمحي(@)(@@) يروي عن: جماعة من الصحابة منهم جابر بن عبد الله، روى عنه: أهل مكة، وفطر بن خليفة، وليث بن أبي سليم، عداده في أهل مكة، مات سنة ثمان عشرة ومائة بمكة. عبد الرحمن بن حبيب: خال منصور بن عبد الرحمن، يروي عن: ابن عمر، روى عنه: منصور بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعد(@)(@@) مولى لآل عمر، يروي عن: ابن عمر، أن النبي صلى الله عليه وسلم على بعيره في السفر، روى عنه: منصور بن المعتمر السلمي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن شرحبيل بن حسنة(@)(@@) يروي عن: أبيه، ولأبيه صحبة، روى عنه: أهل مصر.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خربوذ(@)(@@) يروي عن: ابن عمر، وأبي هريرة، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن السائب الهلالي(@)(@@) ابن أخي ميمونة، يروي عن: ميمونة، 
ms634	 روى عنه: أزهر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مهران(@)(@@) مولى بني هاشم، من أهل المدينة، يروي عن: أبي هريرة، ويروي عن: عبد الرحمن بن سعد، عن أبي هريرة، روى عنه: محمد بن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن أبي عمار(@)(@@) يروي عن: جابر بن عبد الله، PageV01P002 [ج 2: ص 315] روى عنه: عبد الله بن عبيد بن عمير.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن امرئ القيس(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى ابن عجلان، عن أبي المصفى عنه، ولا أدرى من أبو المصفى.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبيد العدوي(@)(@@) يروي عن: أبي هريرة، روى عنه: ابن عون.(@)(@@) (185) -[2: 315] ثنا عبد الله بن محمد، قال: ثنا إسحاق بن إبراهيم، قال: ثنا النضر بن شميل، عن ابن عون، عن عبد الرحمن بن عبيد، عن أبي هريرة، قال: كنت مع رسول الله صلى الله عليه وسلم في جنازة، فكنت إذا مشيت يسبقني، فأهرول، فقال رجل إلى جنبي: " إن الأرض تطوى له "(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حبيب(@)(@@) مولى بني تميم، يروي عن: ابن عمر، روى عنه: وائل بن داود.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن صحار العبدي(@)(@@) يروي عن: أبيه، روى عنه: يزيد بن عبد الله بن الشخير.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعد(@)(@@) من أهل المدينة، يروي عن: أبي هريرة، روى عنه: عبد الرحمن بن مهران.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن بزرج(@)(@@) يروي عن: أبي هريرة، روى عنه: سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حرملة بن قيس(@)(@@) يروي عن: ابن مسعود، روى عنه: ابن أخيه القاسم بن حسان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن رافع التنوخي(@)(@@) يروي عن: عبد الله بن عمرو، PageV01P002 [ج 2: ص 316] روى عنه: المصريون، لا يحتج بخبره إذا كان من رواية عبد الرحمن بن زياد بن أنعم الإفريقي، وإنما وقع المناكير في حديثه من أجله، مات في ولاية هشام بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ثابت بن الصامت(@)(@@) يروي عن: أبيه، روى عنه: ابنه عبد الله بن عبد الرحمن. 
ms635	(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن شماسة المهري(@)(@@) يروي عن: زيد بن ثابت، وعقبة بن عامر، عداده في أهل مصر، روى عنه: يزيد بن أبي حبيب، وحرملة بن عمران.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حجيرة الأكبر(@)(@@) يروي عن: ابن عمرو، وأبي هريرة، روى عنه: دراج، وابنه عبد الله بن عبد الرحمن، قلب اسميهما خالد بن يزيد، فقال: عبد الرحمن بن عبد الله بن حجيرة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن شيبة بن عثمان بن عبد الدار القرشي(@)(@@) خادم الكعبة، أخو صفية بنت شيبة، يروي عن: عائشة، وأم سلمة، روى عنه: أبو قلابة.(@)(@@)(@@)(@@) ||| AUTO أبو قيس الأودي اسمه عبد الرحمن بن ثروان الأودي(@)(@@) سمع من ابن أبي أوفى، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن صفوان بن أمية الجمحي(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: ابن أبي مليكة.(@)PageV01P002(@)(@@) [ج 2: ص 317](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن بأبي(@)(@@) يروي عن: أبي هريرة، قوله، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعد القرشي(@)(@@) مولى ابن عمر، يروي عن: ابن عمر، كان يكون بالكوفة، روى عنه: منصور، وحماد بن أبي سليمان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن السائب بن يزيد ابن أخت نمر(@)(@@) يروي عن: أبيه، روى عنه: ابنه محمد بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الصامت(@)(@@) ابن عم أبي هريرة، يروي عن: أبي هريرة، روى عنه: أبو الزبير المكي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن مكمل القرشي(@)(@@) يروي عن: ابن عباس، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي ثور(@)(@@) وفد إلى معاوية، روى عنه: أبو السفر الهمداني.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن خالد(@)(@@) يروي عن: ابن عمر، روى عنه: يحيى بن جعدة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعد بن معاذ المعاوي(@)(@@) يروي عن: أبيه قصة طويلة، روى عنه: محمد بن زياد من حديث الربيع بن مسلمة عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خلاد الأنصاري(@)(@@) يروي عن: أم ورقة ولها صحبة، روى عنه: الوليد بن جميع الكوفي.(@)PageV01P002(@)(@@) [ج 2: ص 318](@)(@@)(@@)(@@) ||| AUTO عبد 
ms636	 الرحمن بن أبزى(@)(@@) من أهل الكوفة، عن: أبي بن كعب، روى عنه: أهل الكوفة، وابنه سعيد بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن زبيبة(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: عبد العزيز بن أبي رواد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عابس بن ربيعة(@)(@@) من أهل الكوفة، يروي عن: ابن عباس، روى عنه: شعبة، والثوري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سلم(@)(@@) يروي عن: ابن عمر، روى عنه: الحارث بن عيينة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الزجاج(@)(@@) يروي عن: شيبة بن عثمان، روى عنه: عبد الله بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن صفوان(@)(@@) يروي عن: أبي هريرة، روى عنه: وائل بن داود.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عوسجة النهمي الهمداني(@)(@@) من أهل الكوفة، يروي عن: البراء بن عازب، روى عنه: الكوفيين: طلحة بن مصرف، والضحاك بن مزاحم، قتل يوم الزاوية، وكان مع ابن الأشعث سنة ثلاث وثمانين.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن زامرد العدني(@)(@@) يروي عن: جابر بن عبد الله، روى عنه: الحكم بن أبان.(@)PageV01P002(@)(@@) [ج 2: ص 319](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عرق اليحصبي(@)(@@) يروي عن: حبيب بن مسلمة، روى عنه: ابنه محمد بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن العلاء الحضرمي(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن شريح الجعفي(@)(@@) يروي عن: أبيه، وله صحبة، روى عنه: ابن ابنه مخلد بن عقبة بن عبد الرحمن بن شريح.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي ليلى(@)(@@) واسم أبي ليلى: يسار، رأى عليا، وعثمان، عن جماعة من أصحاب النبي صلى الله عليه وسلم عداده في أهل الكوفة، روى عنه: أهلها: الشعبي، ومجاهد، ولد لست سنين مضين من خلافة عمر، ومات سنة ثلاث وثمانين، غرق في دجيل هو وعبد الله بن شداد بن الهاد يوم الجماجم، وقد قيل: إنه مات في ولاية مروان بن محمد، وقتل مروان سنة إحدى وثلاثين ومائة والأول أصح، كنيته أبو عيسى.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مسور بن مخرمة(@)(@@) يروي عن: أبيه، وأبي رافع، 
ms637	 كنيته أبو المسور، روى عنه: أهل المدينة، وحبيب بن أبي ثابت، مات سنة تسعين، أمه نسيمة بنت شرحبيل بن حسنة بن عبد الله بن المطاع.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عمير بن سعيد(@)(@@) كان عاملا على فلسطين، يروي المراسيل، روى عنه: العباس بن أبي سعيد.(@)PageV01P002(@)(@@) [ج 2: ص 320](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عقبة(@)(@@) مولى جابر بن عتيك الأنصاري، يروي المراسيل، روى عنه: محمد بن يحيى بن حيان، وداود بن الحصين.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الحارث بن أبي ذباب(@)(@@) يروي عن: عثمان بن عفان، عداده في أهل المدينة، روى عنه: ابنه عبد الله بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد رب الكعبة(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: الشعبي، وزيد بن وهب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الفضل بن العباس الهاشمي(@)(@@) يروي المراسيل، روى عنه: يزيد بن أبي زياد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مخراق(@)(@@) يروي عن: أبي ذر، روى عنه: يزيد بن عياض بن جعدبة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد أبو عبد الله الجدلي(@)(@@) يروي عن: عائشة، وخزيمة بن ثابت، وقد قيل: عبد بن عبد، روى عنه: إبراهيم النخعي، والحكم بن عتيبة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن محمد بن زيد بن جدعان القرشي(@)(@@) يروي عن: عائشة، روى عنه: عبد الرحمن بن أبي الضحاك، وهو الذي روى عنه: أبو جعفر الفراء، فقال: عبد الرحمن بن جدعان، قال: سمعت ابن عمر يقول في السلام.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حرملة(@)(@@) يروي(@)(@@) (186) -[2: 320] عن عبد الله بن مسعود، أن النبي صلى الله عليه وسلم " كره PageV01P002 [ج 2: ص 321] عشرة: الصفرة يعني الخلوق، وجر الإزار، والتبرج بالزينة لغير أهلها، الحديث. روى عنه: القاسم بن حسان بن حرملة ابن أخيه، ثنا ابن قتيبة، قال: ثنا ابن أبي السري، ثنا معتمر بن سليمان، قال: ثنا الركين بن الربيع، عن القاسم بن حسان(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عويم بن ساعدة الأنصاري(@)(@@) يروي عن: جماعة من أصحاب النبي صلى الله عليه وسلم عداده في أهل المدينة، روى عنه: عروة بن الزبير.(@)(@@)(@@)(@@) ||| AUTO عبد 
ms638	 الرحمن بن قيس أبو صالح الحنفي(@)(@@) أخو طليق بن قيس، يروي عن: ابن مسعود، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي عائشة(@)(@@) يروي عن: أبي هريرة، وابن عباس، روى عنه: أخوه عبد الله بن أبي عائشة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن محيريز الجمحي(@)(@@) يروي عن: أبي أمامة، روى عنه: أبو قلابة.(@)(@@)(@@)(@@) ||| AUTO أبو الحويرث اسمه عبد الرحمن بن معاوية(@)(@@) يروي عن: ابن عباس، روى عنه: الناس، مات سنة ثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مسعود بن نيار الأنصاري(@)(@@) يروي عن: سهل بن أبي حثمة، روى عنه: خبيب بن عبد الرحمن المدني.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن معاوية بن حديج التجيبي(@)(@@) يروي عن: أبيه، وله صحبة، عداده في أهل مصر، روى عنه: عقبة بن مسلم.(@)PageV01P002(@)(@@) [ج 2: ص 322](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي لبيد التغلبي(@)(@@) يروي عن: أبي جحيفة، روى عنه: الزبير بن عدي، وأشعث بن أبي الشعثاء.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبيد بن نسطاس البكائي، أبو يعفور، العبدي العامري(@)(@@) يروي عن: ابن أبي أوفى، وأنس، عداده في أهل الكوفة، روى عنه: الثوري، وابن المبارك، والناس، وهو الذي روى عنه: عبد الواحد بن زياد، فقال: ثنا عبد الرحمن بن عبيد بن أبي صعبة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن طارق بن علقمة(@)(@@) يروي عن: جماعة من الصحابة، روى عنه: أهل الحجاز.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبيد النميري(@)(@@) يروي عن: معاوية، روى عنه: ابن الديلمي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي عوف الجرشي(@)(@@) قاضي حمص، يروي عن: عمرو بن العاص، والمقدام بن معدي كرب، روى عنه: الزبيدي، وصفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن وعلة(@)(@@) يروي عن: ابن عباس، روى عنه: زيد بن أسلم، والقعقاع بن حكيم، وأبو الخير، عداده في أهل مصر.(@)(@@) عبد الرحمن بن عبيد(@)(@@) من أهل الكوفة، يروي عن: علي، روى عنه: قنان بن عبد الله النهمي.(@)PageV01P002(@)(@@) [ج 2: ص 323](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن علي بن شيبان الحنفي(@)(@@) من أهل اليمامة، يروي عن: أبيه، روى عنه: عبد الله بن بدر.(@)(@@)(@@)(@@) ||| AUTO 
ms639	 عبد الرحمن بن أبي علقمة(@)(@@) يروي عن: ابن مسعود، روى عنه: عبد الله بن الوليد المدني.(@)(@@) (187) -[2: 323] ثنا أبو يعلى بالموصل، قال: ثنا حيان بن بشر، قال: ثنا يحيى بن آدم، قال: ثنا الحسن بن ثابت، عن عبد الله بن الوليد بن المغفل، عن أبي صخرة جامع بن شداد، عن عبد الرحمن بن أبي علقمة، عن ابن مسعود، قال: " كان معنا ليلة نام رسول الله صلى الله عليه وسلم صبيحتها حتى طلعت الشمس حاديان "(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ميمون(@)(@@) يروي عن: عمر، روى عنه: سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مسعود اليشكري(@)(@@) يروي عن: أبي سعيد الخدري، وأبي هريرة، روى عنه: جعفر بن أبي وحشية.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن معاوية بن أبي ذباب(@)(@@) يروي عن: سهل بن سعد، روى عنه: عبد الرحمن بن إسحاق المدني.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مهران(@)(@@) مولى أبي هريرة، يروي عن: أبي هريرة، روى عنه: سعيد المقبري، والحارث بن عبد الرحمن بن أبي ذباب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن اليحصبي(@)(@@) يروي عن: وائل بن حجر، عداده في الكوفيين، روى عنه: أبو البختري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عائذ الثمالي الأزدي، كنيته أبو عبد الله(@)(@@) يروي PageV01P002 [ج 2: ص 324] عن: أبي ذر، وقد قيل: إنه لقى عليا، عداده في أهل الشام، روى عنه: أهلها.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن هرمز بن كيسان الأعرج(@)(@@) مولى محمد بن ربيعة بن الحارث بن عبد المطلب، كنيته أبو داود، وقد قيل: أبو حازم، يروي عن: أبي هريرة، روى عنه: الزهري، وأبو الزناد، والناس، مات بالإسكندرية سنة سبع عشرة ومائة، وكان يكتب المصاحف.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعد(@)(@@) يروي عن: كعب بن مالك، روى عنه: هشام بن عروة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن معبد بن عمير الليثي(@)(@@) ابن أخي عبيد بن عمير، يروي عن: عمر، وعلي، روى عنه: عمرو بن دينار المكي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي ذئب السدي(@)(@@) من أهل الكوفة، يروي عن: أبي هريرة، روى عنه: ابنه إسماعيل بن عبد الرحمن السدي، كاتبته زينب بنت 
ms640	 قيس بن مخرمة على عشرة آلاف درهم وتركت له ألفا فهو مولى زينب كتابة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي مسعود الفزاري(@)(@@) يروي عن: أبي الدرداء، عداده في أهل الشام، روى حريز بن عثمان عن: عمران بن عوف، عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مطعم أبو المنهال(@)(@@) يروي عن: إياس بن عبد، والبراء، وزيد بن أرقم، وابن عباس، عداده في أهل الكوفة، روى عنه: عمرو بن دينار، وحبيب بن أبي ثابت، وأبو التياح.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يعقوب الحرقي(@)(@@) مولى جهينة، وحرقه من(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 2: ص 325] همدان، يروي عن: أبي سعيد، وأبي هريرة، عداده في أهل المدينة، روى عنه: ابنه العلاء بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عثمان الكندي(@)(@@) يروي عن: الأشعث بن قيس، روى عنه: عبيد الله بن شريك.(@)(@@) عبد الرحمن(@)(@@) مولى سليمان بن عبد الملك، يروي عن: أنس بن مالك، روى عنه: مسرة بن معبد اللخمي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ماعز العامري(@)(@@) يروي عن: سفيان بن عبد الله الثقفي، روى عنه: الزهري، كذا قال معمر، وأما الزبيدي، فإنه قال: ماعز بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ميسرة الحضرمي(@)(@@) يروي عن: أبي أمامة، والمقدام بن معدي كرب، روى عنه: حريز بن عثمان الرحبي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي حسين(@)(@@) والد عبد الله بن عبد الرحمن بن أبي حسين، يروي عن: جبير بن مطعم، روى عنه: سليمان بن موسى.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عمرو أبو المهلب، ويقال أيضا: معاوية بن عمرو(@)(@@) وقد قيل: عمرو بن معاوية الجرمي الأزدي، وهو عم أبي قلابة، يروي عن: عمران بن حصين، روى عنه: أبو قلابة، والحسن، وعوف الأعرابي، وهو الذي روى الأوزاعي في نسخته، عن: يحيى بن أبي كثير، عن أبي قلابة، عن أبي المهاجر ثعلبة، وإنما هو أبو المهلب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يزيد بن جارية بن العطاف بن ضبيعة بن زيد بن مالك الأنصاري(@)(@@) من بني عمرو بن عوف، كنيته أبو محمد، يروي عن: جماعة من PageV01P002 [ج 2: ص 326] أصحاب رسول الله صلى 