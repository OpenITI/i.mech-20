ms1221	 أصل الإيمان : الكف عمن قال لا إلاه إلا الله ولا يكفره بذنب ولا يخرجه من الإسلام بعمل والجهاد ماض منذ بعثني الله إلاى أن يقاتل آخر : أمتي الدجال لا يبطله جور جائر ولا عدل عادل ، والإيمان بالأقدار ) )(@)(@@) ( د ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10765 ) قال النبي :(@)(@@) | 30 ( ثلاث من الإيمان : الإنفاق من الإقتار ، وبذل PageV04P150 السلام للعالم ، والإنصاف من نفسك ) )(@)(@@) البزار ( طب ) عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10766 ) قال النبي :(@)(@@) | 30 ( ثلاث من الإيمان : الحياء والعفاف والعي عي اللسان غير عي الفقه والعلم ، وهن مما ينقصن من الدنيا ويزدن في الآخرة ، وما يزدن في الآخرة أكثر مما ينقصن من الدنيا ، وثلاث من النفاق : البذاء والفحش والشح ، وهن مما يزدن في الدنيا وينقصن من الآخرة ، وما ينقصن من الآخرة أكثر مما يزدن في الدنيا ) )(@)(@@) ( رستة ) عن عون بن عبد الله بن عتبة رضي الله عنه بلاغا .(@)(@@)(@@)(@@) $ ( 10767 ) قال النبي :(@)(@@) | 30 ( ثلاث من الجفاء : أن يبول الرجل قائما ، أو يمسح جبهته قبل أن يفرغ من صلاته أو ينفخ في سجوده ) )(@)(@@) ( ن ) البزار عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10768 ) قال النبي :(@)(@@) | 30 ( ثلاث من الفواقر : إمام إن أحسنت لم يشكر وإن أسأت لم يغفر ، وجار إن رأى خيرا دفنه وإن رأى شرا أشاعه ، وامرأة إن حضرت آذتك وإن غبت عنها خانتك ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10769 ) قال النبي :(@)(@@) | 30 ( ثلاث من الكفر بالله : شق الجيب ، والنياحة ، والطعن في النسب ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10770 ) قال النبي :(@)(@@) | 30 ( ثلاث من الميسر : القمار ، والضرب بالكعاب ، والصفير بالحمام ) )(@)(@@) ( د ) في مراسيله عن يزيد بن شريح التيمي مرسلا .(@)(@@)(@@)(@@) $ ( 10771 ) قال النبي :(@)(@@) | 30 ( ثلاث من أوتيهن فقد أوتي مثل ما أوتي آل داود : العدل في الغضب والرضا ، والقصد في الفقر والغنى ، وخشية الله تعالى في السر والعلانية ) )(@)(@@) الحكيم عن أبي هريرة رضي الله عنه .(@)(@@) PageV04P151(@)(@@)(@@)(@@) $ ( 10772 ) قال النبي :(@)(@@) | 30 ( ثلاث من تمام الصلاة : إسباغ الوضوء ، وعدل الصف ، والاقتداء بالإمام ) )(@)(@@) ( عب ) عن 
ms1222	 زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ ( 10773 ) قال النبي :(@)(@@) | 30 ( ثلاث من جاء بهن مع الإيمان دخل من أي أبواب الجنة شاء وزوج من الحور العين حيث شاء ، من عفا عن قاتله ، وأدى دينا خفيا ، وقرأ في دبر كل صلاة مكتوبة عشر مرات قل هو الله أحد ) )(@)(@@) ( ع ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10774 ) قال النبي :(@)(@@) | 30 ( ثلاث منجيات : خشية الله تعالى في السر والعلانية ، والعدل في الرضا والغضب ، والقصد في الفقر والغنى ، وثلاث مهلكات : هوى متبع ، وشح مطاع ، وإعجاب المرء بنفسه ) )(@)(@@) أبو الشيخ في التوبيخ ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10775 ) قال النبي :(@)(@@) | 30 ( ثلاث من حفظهن فهو ولي حقا ، ومن ضيعهن فهو عدوي حقا : الصلاة ، والصيام ، والجنابة ) )(@)(@@) ( طس ) عن أنس رضي الله عنه ( ص ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 10776 ) قال النبي :(@)(@@) | 30 ( ثلاث من فعل أهل الجاهلية لا يدعهن أهل الإسلام : استسقاء بالكواكب ، وطعن في النسب ، والنياحة على الميت ) )(@)(@@) ( تخ طب ) عن جنادة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10777 ) قال النبي :(@)(@@) | 30 ( ثلاث من فعلهن أطاق الصوم : من أكل قبل أن يشرب ، وتسحر ، وقال ) )(@)(@@) البزار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10778 ) قال النبي :(@)(@@) | 30 ( ثلاث من فعلهن ثقة بالله واحتسابا كان حقا على الله تعالى أن يعينه وأن يبارك له : من سعى في فكاك رقبة ثقة بالله واحتسابا كان حقا PageV04P152 على الله تعالى أن يعينه وأن يبارك له ، ومن تزوج ثقة بالله واحتسابا كان حقا على الله تعالى أن يعينه وأن يبارك له ، ومن أحيا أرضا ميتة ثقة بالله واحتسابا كان حقا على الله تعالى أن يعينه وأن يبارك له ) )(@)(@@) ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10779 ) قال النبي :(@)(@@) | 30 ( ثلاث من فعلهن فقد أجرم : من عقد لواء في غير حق ، أو عق والديه ، أو مشى مع ظالم لينصره ) )(@)(@@) ابن منيع ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10780 ) قال النبي :(@)(@@) | 30 ( ثلاث من فعلهن فقد طعم طعم الإيمان : من عبد الله وحده وأنه لا إلاه إلا الله ، وأعطى زكاة ماله 
ms1223	 طيبة بها نفسه وافدة عليه كل عام ، ولا يعطى الهرمة ولا الدرنة ولا المريضة ولا الشرط اللئيمة ، ولاكن من أوسط أموالكم ، فإن الله لم يسألكم خيره ، ولم يأمركم بشره ، وزكى نفسه ) )(@)(@@) عن عبد الله بن معاوية الغاضري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10781 ) قال النبي :(@)(@@) | 30 ( ثلاث من كل شهر ، ورمضان إلاى رمضان فهاذا صيام الدهر كله ) )(@)(@@) ( م د ن ) عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10782 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه آواه الله كنففه ونشر عليه رحمته وأدخله جنته : من إذا أعطى شكر ، وإذا قدر غفر ، وإذا غضب فتر ) )(@)(@@) ( ك هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10783 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه استوجب الثواب واستكمل الإيمان : خلق يعيش به في الناس ، وورع يحجزه عن محارم الله تعالاى ، وحلم يرده عن جهل الجاهل ) )(@)(@@) البزار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10784 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه أظله الله تحت ظل عرشه يوم لا ظل إلا ظله : الوضوء علاى المكاره ، والمشي إلاى المساجد في الظلم ، وإطعام الجائع ) )(@)(@@) أبو الشيخ في الثواب والأصبهاني في الترغيب عن جابر رضي الله عنه .(@)(@@) PageV04P153(@)(@@)(@@)(@@) $ ( 10785 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن أو واحدة منهن فليتزوج من الحور العين حيث شاء : رجل ائتمن علاى أمانة فأداها مخافة الله عز وجل ، ورجل خلى عن قاتله ، ورجل قرأ في دبر كل صلاة قل هو الله أحد حشر مرات ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10786 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه حاسبه الله تعالاى حسابا يسيرا وأدخله الجنة برحمته : تعطي من حرمك ، وتعفوا عمن ظلمك ، وتصل من قطعك ) )(@)(@@) ابن أبي الدنيا في ذم الغضب ( طس ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10787 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فإن الله تعالى يغفر له ما سوى ذالك : من مات لا يشرك بالله شيئا ، ولم يكن ساحرا يتبع السحرة ، ولم يحقد على أخيه ) )(@)(@@) ( خد طب ) عن ابن عباس رضي الله عنهما 
ms1224	 .(@)(@@)(@@)(@@) $ ( 10788 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فقد ذاق طعم الإيمان : من كان لا شيء أحب إليه من الله ورسوله ، ومن كان أن يحرق بالنار أحب إليه من أن يرتد عن دينه ، ومن كان يحب لله ويبغض لله ) )(@)(@@) ( سمويه طب ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10789 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فهو من الأبدال : الرضا بالقضاء ، والصبر عن محارم الله ، والغضب في ذات الله عز وجل ) )(@)(@@) ( فر ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10790 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فهو منافق ، وإن صام وصلى وحج واعتمر وقال إني مسلم : من إذا حدث كذب ، وإذا وعد أخلف ، وإذا ائتمن خان ) )(@)(@@) رسته في الإيمان وأبو الشيخ في التوبيخ عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10791 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فهي راجعة على صاحبها : البغي PageV04P154 والمكر والنكث ) )(@)(@@) أبو الشيخ وابن مردويه معا في التفسير ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10792 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه نشر الله تعالى عليه كنفه وأدخله جنته : رفق بالضعيف ، وشفقة على الوالدين ، والإحسان إلى المملوك ) )(@)(@@) ( ت ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10793 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه وجد حلاوة الإيمان : أن يكون الله ورسوله أحب إليه مما سواهما ، وأن يحب المرء لا يحبه إلا لله ، وأن يكره أن يعود في الكفر بعد إذ أنقذه الله منه كما يكره أن يلقى في النار ) )(@)(@@) ( حم ق ت ن ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10794 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه وقي شح نفسه : من أدى الزكاة ، وقرى الضيف ، وأعطى في النائبة ) )(@)(@@) ( طب ) عن خالد بن زيد بن حارثة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10795 ) قال النبي :(@)(@@) | 30 ( ثلاث من كنوز البر : إخفاء الصدقة ، وكتمان المصيبة ، وكتمان الشكوى ، يقول الله تعالى : إذا ابتليت عبدي فصبر ولم يشكني إلى عواده ، أبدلته لحما خيرا من لحمه ، ودما خيرا من دمه ، فإن أبرأته أبرأته ولا ذنب له ، وإن توفيته فالى رحمتي ) )(@)(@@) ( طب 
ms1225	 حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10796 ) قال النبي :(@)(@@) | 30 ( ثلاث من كنوز البر : كتمان الأوجاع والبلوى والمصيبات ، ومن بث لم يصبر ) )(@)(@@) تمام عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10797 ) قال النبي :(@)(@@) | 30 ( ثلاث من نعيم الدنيا وإن كان لا نعيم لها : PageV04P155 مركب وطيء ، والمرأة الصالحة ، والمنزل الواسع ) )(@)(@@) ( ش ) عن ابن قرة أو قرة .(@)(@@)(@@)(@@) $ ( 10798 ) قال النبي :(@)(@@) | 30 ( ثلاث مهلكات ، وثلاث منجيات ، وثلاث كفارات ، وثلاث درجات ، فأما المهلكات : فشح مطاع ، وهوى متبع ، وإعجاب المرء بنفسه ، وأما المنجيات : فالعدل في الغضب والرضا ، والقصد في الفقر والغنى ، وخشية الله تعالى في السر والعلانية ، وأما الكفارات : فانتظار الصلاة بعد الصلاة ، وإسباغ الوضوء في السبرات ، ونقل الأقدام إلى الجماعات ، وأما الدرجات : فاطعام الطعام ، وإفشاء السلام ، والصلاة بالليل والناس نيام ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10799 ) قال النبي :(@)(@@) | 30 ( ثلاث وثلاث وثلاث ، فثلاث لا يمين فيهن ، وثلاث ملعون فيهن ، وثلاث أشك فيهن ، فأما الثلاث التي لا يمين فيهن : فلا يمين للولد مع والده ، ولا للمرأة مع زوجها ، ولا للمملوك مع سيده ، وأما الملعون فيهن فملعون من لعن والديه ، وملعون من ذبح لغير الله ، وملعون من غير تخوم الأرض ، وأما التي أشك فيهن : فعزير لا أدري أكان نبيا أم لا ؟ ولا أدري ألعن تبع أم لا ؟ ولا أدري الحدود كفارة لأهلها أم لا ؟ ) )(@)(@@) الإسماعيلي في معجمه وابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10800 ) قال النبي :(@)(@@) | 30 ( ثلاث هن علي فريضة ، وهن لكم تطوع : الوتر ، وركعتا الضحى ، وركعتا الفجر ) )(@)(@@) ( حم ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10801 ) قال النبي :(@)(@@) | 30 ( ثلاث لا تؤخروهن : الصلاة إذا أتت ، والجنازة إذا حضرت ، والأيم إذا وجدت كفؤا ) )(@)(@@) ( ت ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10802 ) قال النبي :(@)(@@) | 30 ( ثلاث لا ترد : الوسائد ، والدهن ، واللبن ) )(@)(@@) ( ت ) PageV04P156 عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10803 ) قال النبي :(@)(@@) | 30 ( ثلاث لازمات لامتي : سوء الظن والحسد والطيرة ، فإذا ظننت فلا تحقق ، وإذا حسدت فاستغفر الله ، وإذا تطيرت فامض ) )(@)(@@) أبو الشيخ في 
ms1226	 التوبيخ ( طب ) عن حارثة بن النعمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10804 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يجوز اللعب فيهن : الطلاق والنكاح والعتق ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10805 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يحاسب بهن العبد : ظل خص يستظل به ، وكسرة يشد بها صلبه ، وثوب يواري به عورته ) )(@)(@@) ( حم ) في الزهد ( هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 10806 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يحل لأحد أن يفعلهن : لا يؤم رجل قوما فيخص نفسه بالدعاء دونهم ، فإن فعل فقد خانهم ، ولا ينظر في قعر بيت قبل أن يستأذن ، فإن فعل فقد دخل ، ولا يصل وهو حقن حتى يتخفف ) )(@)(@@) ( د ت ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10807 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يعاد صاحبهن : الرمد ، وصاحب الضرس ، وصاحب الدمل ) )(@)(@@) ( طس عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10808 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يفطرن الصائم : الحجامة ، والقيء ، والاحتلام ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10809 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يمنعن : الماء ، والكلا ، والنار ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10810 ) قال النبي :(@)(@@) | 30 ( ثلاث يجلين البصر : النظر إلى الخضرة ، وإلى الماء الجاري ، وإلى الوجه الحسن ) )(@)(@@) ( ك ) في تاريخه عن علي وعن ابن عمرو ( أبو نعيم ) PageV04P157 في الطب عن عائشة ( الخرائطي في اعتلال القلوب ) عن أبي سعيد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 10811 ) قال النبي :(@)(@@) | 30 ( ثلاث يدخلون الجنة بغير حساب : رجل غسل ثيابه فلم يجد له خلفا ، ورجل لم ينصب على مستوقده قدران ، ورجل دعا بشراب فلم يقل له أيها تريد ) )(@)(@@) أبو الشيخ في الثواب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10812 ) قال النبي :(@)(@@) | 30 ( ثلاث يدرك بهن العبد رغائب الدنيا والآخرة : الصبر على البلاء ، والرضا بالقضاء ، والدعاء في الرضا ) )(@)(@@) أبو الشيخ عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10813 ) قال النبي :(@)(@@) | 30 ( ثلاث يزدن في قوة البصر : الكحل بالإثمد ، والنظر إلى الخضرة ، والنظر إلى الوجه الحسن ) )(@)(@@) أبو الحسن الفراء في فوائده عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10814 ) قال النبي :(@)(@@) | 30 
ms1227	 ( ثلاث يصفين لك ود أخيك : تسلم عليه إذا لقيته ، وتوسع له في المجلس ، وتدعوه بأحب أسمائه إليه ) )(@)(@@) ( طس ك هب ) عن عثمان بن طلحة الحجبي ( هب ) عن عمر رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 10815 ) قال النبي :(@)(@@) | 30 ( ثلاثة إذا رأيتهن فعند ذالك تقوم الساعة : خراب العامر ، وعمارة الخراب ، وأن يكون المعروف منكرا والمنكر معروفا ، وأن يتمرس الرجل بالأمانة تمرس البعير بالشجرة ) )(@)(@@) ابن عساكر عن محمد بن عطية السعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10816 ) قال النبي :(@)(@@) | 30 ( ثلاثة أصوات يباهي الله بهن الملائكة : الآذان ، والتكبير في سبيل الله ، ورفع الصوت بالتلبية ) )(@)(@@) ابن النجار ( فر ) عن جابر رضي الله عنه .(@)(@@) PageV04P158(@)(@@)(@@)(@@) $ ( 10817 ) قال النبي :(@)(@@) | 30 ( ثلاثة أعين لا تمسها النار : عين فقئت في سبيل الله ، وعين حرست في سبيل الله ، وعين بكت من خشية الله ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10818 ) قال النبي :(@)(@@) | 30 ( ثلاثة إنا خصمهم يوم القيامة ، ومن كنت خصمه خصمته : رجل أعطى بي ثم غدر ، ورجل باع حرا فأكل ثمنه ، ورجل استأجر أجيرا فاستوفى منه ولم يوفه ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10819 ) قال النبي :(@)(@@) | 30 ( ثلاثة تحت العرش يوم القيامة : القرآن له ظهر وبطن يحاج العباد ، والرحم تنادي صل من وصلني واقطع من قطعني ، والأمانة ) )(@)(@@) الحكيم ومحمد بن نصر عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10820 ) قال النبي :(@)(@@) | 30 ( ثلاثة تستجاب دعوتهم : الوالد ، والمسافر ، والمظلوم ) )(@)(@@) ( حم طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10821 ) قال النبي :(@)(@@) | 30 ( ثلاثة حق على الله تعالى عونهم : المجاهد في سبيل الله ، والمكاتب الذي يريد الأداء ، والناكح الذي يريد العفاف ) )(@)(@@) ( حم ت ن ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10822 ) قال النبي :(@)(@@) | 30 ( ثلاثة على كثبان المسك يوم القيامة لا يهولهم الفزع ولا يفزعون حين يفزع الناس : رجل تعلم القرآن فقام به يطلب وجه الله وما عنده ، ورجل نادى في كل يوم وليلة خمس صلوات يطلب وجه الله وما عنده ، ومملوك لم يمنعه رق الدنيا من طاعة 
ms1228	 ربه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10823 ) قال النبي :(@)(@@) | 30 ( ثلاثة على كثبان المسك يوم القيامة يغبطهم الأولون PageV04P159 والآخرون : عبد أدى حق الله وحق مواليه ، ورجل يؤم قوما وهم به راضون ، ورجل ينادي بالصلوات الخمس في كل يوم وليلة ) )(@)(@@) ( حم ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10824 ) قال النبي :(@)(@@) | 30 ( ثلاثة في ضمان الله عز وجل : رجل خرج إلى مسجد من مساجد الله عز وجل ، ورجل خرج غازيا في سبيل الله تعالى ، ورجل خرج حاجا ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10825 ) قال النبي :(@)(@@) | 30 ( ثلاثة في ظل العرش يوم القيامة يوم لا ظل إلا ظله : واصل الرحم يزيد الله في رزقه ويمد في أجله ، وامرأة مات زوجها وترك عليها أيتاما صغارا فقالت : لا أتزوج ، أقيم على أيتامي حتى يموتوا أو يغنيهم الله ، وعبد صنع طعاما فأضاف ضيفه وأحسن نفقته ، فدعا عليه اليتيم والمسكين فأطعمهم لوجه الله عز وجل ) )(@)(@@) أبو الشيخ في الثواب والأصبهاني ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10826 ) قال النبي :(@)(@@) | 30 ( ثلاثة في ظل الله عز وجل يوم لا ظل إلا ظله : رجل حيث توجه علم أن الله تعالى معه ، ورجل دعته امرأة إلى نفسها فتركها من خشية الله ، ورجل أحب لجلال الله ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10827 ) قال النبي :(@)(@@) | 30 ( ثلاثة قد حرم الله عليهم الجنة : مدمن الخمر ، والعاق ، والديوث الذي يقر في أهله الخبث ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10828 ) قال النبي :(@)(@@) | 30 ( ثلاثة كلهم ضامن على الله : رجل خرج غازيا في سبيل الله فهو ضامن على الله حتى يتوفاه فيدخله الجنة أو يرده بما نال من أجر أو PageV04P160 غنيمة ، ورجل راح إلى المسجد فهو ضامن على الله حتى يتوفاه فيدخله الجنة أو يرده بما نال من أجر ، ورجل دخل بيته بسلام فهو ضامن على الله ) )(@)(@@) ( د حب ك ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10829 ) قال النبي :(@)(@@) | 30 ( ثلاثة ليس عليهم حساب فيما طعموا إذا 
ms1229	 كان حلالا : الصائم ، والمتسحر ، والمرابط في سبيل الله عز وجل ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10830 ) قال النبي :(@)(@@) | 30 ( ثلاثة من أعمال الجاهلية لا يتركهن الناس : الطعن في الأنساب ، والنياحة على الميت ، وقولهم مطرنا بنوء كذا وكذا ) )(@)(@@) ( طب ) عن عمرو بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10831 ) قال النبي :(@)(@@) | 30 ( ثلاثة من الجاهلية : الفخر بالأحساب ، والطعن في الأنساب ، والنياحة ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10832 ) قال النبي :(@)(@@) | 30 ( ثلاثة من السحر : الرقى ، والتول ، والتمائم ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10833 ) قال النبي :(@)(@@) | 30 ( ثلاثة من السعادة ، وثلاثة من الشقاء ، فمن السعادة : المرأة الصالحة تراها فتعجبك ، وتغيب عنها فتأمنها على نفسها ومالك ، والدابة تكون وطيئة فتلحقك بأصحابك ، والدار تكون واسعة كثيرة المرافق ، ومن الشقاء : المرأة تراها فتسوءك وتحمل لسانها عليك وإن غبت عنها لم تأمنها على نفسها ومالك ، والدابة تكون قطوفا فإن ضربتها أتعبتك ، وإن تركتها لم تلحقك بأصحابك ، والدار تكون ضيقة قليلة المرافق ) )(@)(@@) ( ك ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10834 ) قال النبي :(@)(@@) | 30 ( ثلاثة من قالهن دخل الجنة : من رضي بالله ربا ، وبالإسلام دينا ، وبمحمد رسولا ، والرابعة لها من الفضل كما بين السماء والأرض وهي الجهاد في سبيل الله عز وجل ) )(@)(@@) ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@) PageV04P161(@)(@@)(@@)(@@) $ ( 10835 ) قال النبي :(@)(@@) | 30 ( ثلاثة من كن فيه يستكمل إيمانه : رجل لا يخاف في الله لومة لائم ، ولا يرائي بشيء من عمله ، وإذا عرض عليه أمران أحدهما للدنيا والآخر للآخرة اختار أمر الآخرة على الدنيا ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10836 ) قال النبي :(@)(@@) | 30 ( ثلاثة من مكارم الأخلاق عند الله : أن تعفو عمن ظلمك ، وتعطي من حرمك ، وتصل من قطعك ) )(@)(@@) ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10837 ) قال النبي :(@)(@@) | 30 ( ثلاثة مواطن لا ترد فيها دعوة عبد : رجل يكون في برية حيث لا يراه أحد إلا الله فيقوم فيصلي ، ورجل يكون معه فئة فيفر عنه أصحابه فيثبت ، ورجل يقوم من آخر الليل ) )(@)(@@) ابن منده 
ms1230	 وأبو نعيم في الصحابة عن ربيعة بن وقاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10838 ) قال النبي :(@)(@@) | 30 ( ثلاثة نفر كان لأحدهم عشرة دنانير فتصدق منها بدينار ، وكان لآخر عشرة أواق فتصدق منها باوقية ، وآخر كان له مائة أوقية فتصدق منها بعشرة أواق في الأجر سواء كل تصدق بعشر ماله ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10839 ) قال النبي :(@)(@@) | 30 ( ثلاثة هم حداث الله يوم القيامة : رجل لم يمم بين اثنين بمراء قط ، ورجل لم يحدث نفسه بزنا قط ، ورجل لم يخلط كسبه بربا قط ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10840 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تجاوززصلاتهم آذانهم : العبد الآبق حتى يرجع ، وامرأة باتت وزوجها عليها ساخط ، وإمام قوم وهم له كارهون ) )(@)(@@) ( ت ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10841 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تحرم عليك أعراضهم : المجاهر بالفسق ، PageV04P162 والإمام الجائر ، والمبتدع ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 10842 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ترى أعينهم النار يوم القيامة : عين بكت من خشية الله ، وعين حرست في سبيل الله ، وعين غضت عن محارم الله ) )(@)(@@) ( طب ) عن معاوية بن حيدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10843 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ترد دعوتهم : الإمام العادل ، والصائم حين يفطر ، ودعوة المظلوم يرفعها الله تعالى فوق الغمام وتفتح لها أبواب السماء ويقول الرب تبارك وتعالى : وعزتي لأنصرنك ولو بعد حين ) )(@)(@@) ( حم ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10844 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ترفع صلاتهم فوق رؤوسهم شبرا : رجل أم قوما وهم له كارهون ، وامرأة باتت وزوجها عليها ساخط ، وأخوان متصارمان ) )(@)(@@) ( ه ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10845 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تسأل عنهم : رجل فارق الجماعة وعصى إمامه ومات عاصيا ، وأمة أو عبد أبق من سيده فمات ، وامرأة غاب عنها زوجها وقد كفاها مؤونة الدنيا فتبرجت بعده ، فلا تسأل عنهم ) )(@)(@@) ( خد ع طب ك هب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10846 ) قال النبي :(@)(@@) | 30 
ms1231	 ( ثلاثه لا تسأل عنهم : رجل ينازع الله إزاره ، ورجل ينازع الله رداءه ، فإن رداءه الكبرياء وإزاره العز ، ورجل في شك من أمر الله والقنوط من رحمة الله ) )(@)(@@) ( خد ع طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10847 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تقربهم الملائكة : السكران ، والمتضمخ بالزعفران ، والحائض والجنب ) )(@)(@@) البزار عن بريدة رضي الله عنه .(@)(@@) PageV04P163(@)(@@)(@@)(@@) $ ( 10848 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تقربهم الملائكة : جيفة الكافر ، والمتضمخ بالخلوق ، والجنب إلا أن يتوضأ ) )(@)(@@) ( د ) عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10849 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تقربهن الملائكة بخير : جيفة الكافر ، والمتضمخ بالخلوق ، والجنب إلا أن يبدو له أن يأكل أو ينام فيتوضأ وضوءه للصلاة ) )(@)(@@) ( طب ) عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10850 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يحبهم ربك عز وجل : رجل نزل بيتا خربا ، ورجل نزل على طريق السبيل ، ورجل أرسل دابته ثم جعل يدعو الله أن يحبسها ) )(@)(@@) ( طب ) عن عبد الرحمان بن عائذ الثمالي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10851 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يحجبون عن النار : المنان ، وعاق والده ، ومدمن الخمر ) )(@)(@@) رسته في الإيمان عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10852 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يدخلون الجنة أبدا : الديوث ، والرجلة من النساء ، ومدمن الخمر ) )(@)(@@) ( طب ) عن عمار بن ياسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10853 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يدخلون الجنة : العاق لوالديه ، والديوث ، ورجلة النساء ) )(@)(@@) ( ك هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10854 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يدخلون الجنة : مدمن الخمر ، وقاطع الرحم ، ومصدق بالسحر ، ومن مات وهو مدمن للخمر سقاه الله من نهر الغوطة ، نهر يجري من فروج المومسات يؤذي أهل النار ريح فروجهن ) )(@)(@@) ( حم طب ك ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10855 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يرد الله دعاءهم : الذاكر الله كثيرا ، PageV04P164 والمظلوم ، والإمام المقسط ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10856 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يريحون رائحة الجنة : رجل ادعى إلى غير أبيه ، ورجل كذب 
ms1232	 علي ، ورجل كذب على عينيه ) )(@)(@@) ( خط ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10857 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يستخف بحقهم إلا منافق بين النفاق : ذو الشيبة في الإسلام ، والإمام المقسط ، ومعلم الخير ) )(@)(@@) أبو الشيخ في التوبيخ عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10858 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يستخف بحقهم إلا منافق : ذو الشيبة في الإسلام ، وذو العلم ، وإمام مقسط ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10859 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يقبل الله لهم صلاة ولا ترفع لهم إلى السماء حسنة : العبد الآبق حتى يرجع إلى مواليه ، والمرأة الساخط عليها زوجها حتى يرضى ، والسكران حتى يصحو ) )(@)(@@) ابن خزيمة ( حب هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10860 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يقبل الله تعالى منهم صلاة : الرجل يؤم قوما وهم له كارهون ، والرجل لا يأتي الصلاة إلا دبارا ، ورجل اعتبد محررا ) )(@)(@@) ( د ه ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10861 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يقبل الله منهم يوم القيامة صرفا ولا عدلا : عاق ، ومنان ، ومكذب بالقدر ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10862 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يكلمهم الله يوم القيامة ولا ينظر إليهم : رجل حلف على سلعته لقد أعطي بها أكثر مما أعطي وهو كاذب ، ورجل حلف على PageV04P165 يمين كاذبة بعد العصر ليقتطع بها مال رجل مسلم ، ورجل منع فضل مائه فيقول الله : اليوم أمنعك فضلي كما منعت فضل ما لم تعمل يداك ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10863 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يكلمهم الله يوم القيامة ولا ينظر إليهم ولا يزكيهم ولهم عذاب أليم : المسبل إزاره ، والمنان الذي لا يعطي شيئا إلا منه ، والمنفق سلعته بالحلف الكاذب ) )(@)(@@) ( حم م 4 ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10864 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يكلمهم الله يوم القيامة ولا ينظر إليهم ولا يزكيهم ولهم عذاب إليم : رجل على فضل ماء بالفلاة يمنعه من ابن السبيل ، ورجل بايع رجلا بسلعة بعد العصر فحلف له 
ms1233	 بالله لأخذها بكذا وكذا فصدقه وهو على غير ذالك ، ورجل بايع إماما لا يبايعه إلا لدنيا ، فإن أعطاه منها وفى ، وإن لم يعطه منها لم يف ) )(@)(@@) ( حم ق 4 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10865 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يكلمهم الله يوم القيامة ولا يزكيهم ولا ينظر أليهم ولهم عذاب إليم : شيخ زان ، وملك كذاب ، وعائل مستكبر ) )(@)(@@) ( م ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10866 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينظر الله إليهم غدا : شيخ زان ، ورجل اتخذ الأيمان بضاعة يحلف في كل حق وباطل ، وفقير مختال يزهو ) )(@)(@@) ( طب ) عن عصمة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10867 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينظر الله إليهم يوم القيامة : العاق لوالديه ، والمرأة المترجلة المتشبهة بالرجال ، والديوث ، وثلاثة لا يدخلون الجنة : PageV04P166 العاق لوالديه ، والمدمن الخمر ، والمنان بما أعطى ) )(@)(@@) ( حم ن ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10868 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينظر الله إليهم يوم القيامة : المنان عطاءه ، والمسبل إزاره خيلاء ، ومدمن الخمر ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10869 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينظر الله إليهم يوم القيامة : حر باع حرا ، وحر باع نفسه ، ورجل أبطأ كراء أجير حين جف رشحه ) )(@)(@@) الإسماعيلي في معجمه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10870 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينظر الله إليهم يوم القيامة ولا يزكيهم ولهم عذاب أليم : أشيمط زان ، وعائل مستكبر ، ورجل جعل الله بضاعته ، لا يشتري إلا بيمينه ، ولا يبيع إلا بيمينه ) )(@)(@@) ( طب هب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10871 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا ينفع معهن عمل : الشرك بالله ، وعقوق الوالدين ، والفرار من الزحف ) )(@)(@@) ( طب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10872 ) قال النبي :(@)(@@) | 30 ( ثلاثة يؤتون أجرهم مرتين : رجل من أهل الكتاب آمن بنبيه وأدرك النبي فآمن به واتبعه وصدقه فله أجران ، وعبد مملوك أدى حق الله وحق سيده فله أجران ، ورجل كانت له أمة فغذاها فأحسن غذاءها ، ثم أدبها فأحسن تأديبها ، وعلمها 
ms1234	 فأحسن تعليمها ، ثم أعتقها وتزوجها فله أجران ) )(@)(@@) ( حم ق ت ن ه ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10873 ) قال النبي :(@)(@@) | 30 ( ثلاثة يتحدثون في ظل العرش آمنين والناس في PageV04P167 الحساب : رجل لم تأخذه في الله لومة لائم ، ورجل لم يمد يديه إلى ما لا يحل له ، ورجل لم ينظر إلى ما حرم الله عليه ) )(@)(@@) الأصبهاني في ترغيبه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10874 ) قال النبي :(@)(@@) | 30 ( ثلاثة يحبها الله عز وجل : تعجيل الفطر ، وتأخير السحور ، وضرب اليدين ، إحداهما بالأخرى في الصلاة ) )(@)(@@) ( طب ) عن يعلى بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10875 ) قال النبي :(@)(@@) | 30 ( ثلاثة يحبهم الله عز وجل : رجل قام من الليل يتلو كتاب الله ، ورجل تصدق صدقة بيمينه يخفيها من شماله ، ورجل كان في سرية فانهزم أصحابه فاستقبل العدو ) )(@)(@@) ( ت ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10876 ) قال النبي :(@)(@@) | 30 ( ثلاثة يحبهم الله وثلاثة يبغضهم الله ، فأما الذين يحبهم الله : فرجل أتى قوما فسألهم بالله ولم يسألهم لقرابة بينه وبينهم فمنعوه فتخلف رجل بأعقابهم فأعطاه سرا لا يعلم بعطيته إلا الله والذي أعطاه ، وقوم ساروا ليلتهم حتى إذا كان النوم أحب إليهم مما يعدل به فوضعوا رؤوسهم فقام أحدهم يتملقني ويتلو آياتي ، ورجل كان في سرية فلقي العدو فهزموا فأقبل بصدره حتى يقتل أو يفتح له ، والثلاثة الذين يبغضهم الله : الشيخ الزاني ، والفقير المختال ، والغني الظلوم ) )(@)(@@) ( ت ن حب ك ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10877 ) قال النبي :(@)(@@) | 30 ( ثلاثة يحبهم الله وثلاثة يشنؤهم الله ، فأما الذين يحبهم الله : الرجل يلقى العدو في فئة فينصب لهم نحره حتى يقتل أو يفتح لأصحابه ، والقوم يسافرون فيطول سراهم حتى يحبوا أن يمسوا الأرض فينزلون فيتنحى أحدهم فيصلي حتى يوقظهم لرحيلهم ، والرجل يكون له الجار يؤذيه جاره فيصبر على أذاه حتى يفرق بينهما موت أو ظعن ، والذين يشنؤهم الله : التاجر PageV04P168 الحلاف ، والفقير المختال ، والبخيل المنان ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10878 ) قال النبي :(@)(@@) | 30 ( ثلاثة يدعون 
ms1235	 الله عز وجل فلا يستجاب لهم : رجل كانت تحته امرأة سيئة الخلق فلم يطلقها ، ورجل كان له على رجل مال فلم يشهد عليه ، ورجل آتى سفيها ماله ، وقال الله تعالى : { ولا تؤتوا السفهاء أموالكم } ) )(@)(@@) ( ك ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10879 ) قال النبي :(@)(@@) | 30 ( ثلاثة يضحك الله إليهم : الرجل إذا قام من الليل يصلي ، والقوم إذا صفوا للصلاة ، والقوم إذا صفوا للقتال ) )(@)(@@) ( حم ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10880 ) قال النبي :(@)(@@) | 30 ( ثلاثة يظلهم الله في ظله يوم لا ظل إلا ظله : التاجر الأمين ، والإمام المقتصد ، وراعي الشمس بالنهار ) )(@)(@@) ( ك ) في تاريخه ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10881 ) قال النبي :(@)(@@) | 30 ( ثلاثة يهلكون عند الحساب : جواد ، وشجاع ، وعالم ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10882 ) قال النبي :(@)(@@) | 30 ( ثلاثون خلافة نبوة ، وثلاثون خلافة وملك ، وثلاثون تجبر ، ولا خير فيما وراء ذالك ) )(@)(@@) يعقوب بن سفيان في تاريخه عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 10883 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه وجد حلاوة الإيمان : من كان الله PageV04P169 ورسوله أحب إليه مما سواهما ، والرجل يحب القوم لا يحبهم إلا في الله ، والرجل إن قذف في النار أحب إليه من أن يرجع يهوديا أو نصرانيا ) )(@)(@@) ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10884 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يمنعن الصيام : الحجامة ، والقيء ، والاحتلام ، ولا يتقيا الصائم متعمدا ) )(@)(@@) ( طب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10885 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يتركهن العرب وهم بهم كفر : الاستسقاء بالأنواء ، والطعن في النسب ، والنوح ) )(@)(@@) الخطيب وابن عساكر عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10886 ) قال النبي :(@)(@@) | 30 ( ثلاث في المنافق : إذا حدث كذب ، وإذا وعد أخلف ، وإذا اؤتمن خان ) )(@)(@@) ( طس ) و الخرائطي في مكارم الأخلاق عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10887 ) قال النبي :(@)(@@) | 30 ( ثلاث جدهن جد ، وهزلهن جد : الطلاق ، والنكاح ، والعتاق ) )(@)(@@) القاضي أبو علي عبد الله بن علي الطبري في الأربعين عن أبي هريرة رضي الله عنه 
ms1236	 .(@)(@@)(@@)(@@) $ ( 10888 ) قال النبي :(@)(@@) | 30 ( ثلاث مهلكات ، وثلاث منجيات ، وثلاث درجات ، وثلاث كفارات ، قيل : يا رسول الله ما المهلكات ؟ قال : شح مطاع ، وهوى متبع ، وإعجاب المرء بنفسه ، قيل : فما المنجيات ؟ قال : تقوى الله في السر والعلانية ، والاقتصاد في الفقر والغنى ، والعدل في الرضا والغضب ، قيل : فما الكفارات ؟ قال : نقل الأقدام إلى المساجد ، وانتظار الصلاة بعد الصلاة ، وإتمام الوضوء في اليوم البارد عند السبرات ) )(@)(@@) العسكري في الأمثال وأبو إسحاق إبراهيم بن أحمد المراعي في كتاب ثواب الأعمال والخطيب عن ابن عباس رضي الله عنهما .(@)(@@) PageV04P170(@)(@@)(@@)(@@) $ ( 10889 ) قال النبي :(@)(@@) | 30 ( ثلاث من لم يكن فيه فليس مني ولا من الله : حلم يرد به جهل الجاهل ، وحسن خلق يعيي به في الناس ، وورع يحجزه عن معاصي الله ) )(@)(@@) الرافعي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10890 ) قال النبي :(@)(@@) | 30 ( ثلاث من كنوز البر : كتمان الشكوى ، وكتمان المصيبة ، وكتمان الصدقة ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10891 ) قال النبي :(@)(@@) | 30 ( ثلاث خلال من جمعهن فقد جمع خلال الإيمان : الإنفاق من الإقتار ، والإنصاف من نفسك ، وبذل السلام للعالم ) )(@)(@@) ( حل ) عن عمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10892 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه حرم على النار وحرمت النار عليه : إيمان بالله ، وحب لله تبارك وتعالى ، وأن يلقى في النار فيحترق أحب إليه من أن يرجع في الكفر ) )(@)(@@) ( حم ع حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10893 ) قال النبي :(@)(@@) | 30 ( ثلاث من لم يأت بهن يوم القيامة فلا شيء له : ورع يحجزه عن محارم الله ، وخلق يداري به الناس ، وحلم يرد به جهل السفيه ) )(@)(@@) الحكيم عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10894 ) قال النبي :(@)(@@) | 30 ( ثلاث من لم يكن فيه أو واحدة منهن فلا يعتدن بشيء من عمله : من لم تكن فيه تقوى تحجزه عن معاصي الله ، أو خلق يعيش به في الناس ، أو حلم يرد به السفيه ) )(@)(@@) الخرائطي في مكارم الأخلاق وابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10895 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فهو منافق : إذا حدث 
ms1237	 كذب ، وإذا وعد أخلف ، وإذا اؤتمن خان ، قال رجل : يا رسول الله فإن ذهبت اثنتان PageV04P171 وبقيت واحدة ؟ قال : فإن عليه شعبة من نفاق ما بقي فيه منهن شيء ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10896 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فهو منافق وإن صام وصلى قال إني مؤمن : إذا حدث كذب ، وإذا اؤتمن خان ، وإذا وعد أخلف ) )(@)(@@) ابن النجار عن أنس الخرائطي في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10897 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه وجد طعم الإيمان وحلاوته : أن يكون الله ورسوله أحب إليه مما سواهما ، وأن يحب في الله ويبغض في الله ، ولو أن أوقدت نارا عظيمة فوقع فيها أحب من أن يشرك بالله ) )(@)(@@) عن وجل بن أبي الدنيا في كتاب الإخوان عن أنس مرسلا .(@)(@@)(@@)(@@) $ ( 10898 ) قال النبي :(@)(@@) | 30 ( ثلاث من لم يكن فيه واحدة منهن فإن الله عز وجل يغفر له ما سوى ذالك : من مات لا يشرك بالله شيئا ، ولم يكن ساحرا يتبع السحرة ، ولم يحقد على أخيه ) )(@)(@@) ( طب ) و ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10899 ) قال النبي :(@)(@@) | 30 ( ثلاث مهلكات : شح مطاع ، وهوى متبع ، وإعجاب المرء بنفسه من الخيلاء ، وثلاث منجيات : العدل في الرضى والغضب ، والقصد في الغنى والفقر ، ومخافة الله في السر والعلانية ) )(@)(@@) ( طس ) و أبو الشيخ في التوبيخ ( هب ) والخطيب في المتفق والمفترق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10900 ) قال النبي :(@)(@@) | 30 ( ثلاث إن كان في شيء شفاء : فشرطة محجم ، أو شربة عسل ، أو كية تصيب الداء وأنا أكره الكي ولا أحبه ) )(@)(@@) ( حم ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10901 ) قال النبي :(@)(@@) | 30 ( ثلاث مهلكات : شح مطاع ، وهوى متبع ، وإعجاب المرء برأيه ) )(@)(@@) ( بز ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10902 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فهو منافق ، وإن كان PageV04P172 فيه خصلة منها ففيه خصلة من النفاق حتى يدعها : إذا حدث كذب ، وإذا اؤتمن خان ، وإذا وعد أخلف ) )(@)(@@) ( بز ) و الخطيب 
ms1238	 في مكارم الأخلاق عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10903 ) قال النبي :(@)(@@) | 30 ( ثلاث من توقير جلال الله : إكرام ذي الشيبة في الإسلام ، وحامل كتاب الله ، وحامل العلم من كان صغيرا أو كبيرا ) )(@)(@@) الميانشي في المجالس المسكية عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10904 ) قال النبي :(@)(@@) | 30 ( ثلاث كلهن سحت : كسب الحجام ، ومهر البغي ، وثمن الكلب إلا كلبا ضاريا ) )(@)(@@) ( هق ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10905 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فليس مني ولا أنا منه : بغض علي ، ونصب أهل بيتي ، ومن قال إن الإيمان كلام ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10906 ) قال النبي :(@)(@@) | 30 ( ثلاث من فعلهن أطاق الصيام : من أكل قبل أن يشرب ، وتسحر ، وقال ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10907 ) قال النبي :(@)(@@) | 30 ( ثلاث من حفظهن حفظ الله له دينه ودنياه ، ومن ضيعهن لم يحفظ الله له شيئا : حرمة الإسلام ، وحرمتي ، وحرمة رحمي ) )(@)(@@) ( ك ) في تاريخه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10908 ) قال النبي :(@)(@@) | 30 ( ثلاث من السنة : الصلاة خلف كل إمام لك صلاتك وعليه إثمه ، والجهاد مع كل أمير لك جهادك وعليه شره ، والصلاة على كل ميت من أهل التوحيد وإن كان قاتل نفسه ) )(@)(@@) ( قط ) و الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10909 ) قال النبي :(@)(@@) | 30 ( ثلاث فاتنات : الشعر الحسن ، والوجه الحسن ، والصوت الحسن ) )(@)(@@) الديلمي عن أبان عن أنس رضي الله عنه .(@)(@@) PageV04P173(@)(@@)(@@)(@@) $ ( 10910 ) قال النبي :(@)(@@) | 30 ( ثلاث أخافهن على أمتي من بعدي : الضلالة بعد المعرفة ، ومضلات الفتن ، وشهوة البطن والفرج ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10911 ) قال النبي :(@)(@@) | 30 ( ثلاث يبقين للعبد بعد موته : صدقة أجراها ، وعلم أفشاه ، وذرية يبقون بعده يذكرون الله ) )(@)(@@) أبو الشيخ في الثواب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10912 ) قال النبي :(@)(@@) | 30 ( ثلاث قد فرغ الله من القضاء فيهن : لا يبغين أحدكم فإن الله تعالى يقول : يا أيها الناس إنما بغيكم على أنفسكم ، ولا يمكر أحدكم فإن الله تعالى يقول : ولا يحيق المكر 
ms1239	 السيء إلا بأهله ، ولا ينكثن أحدكم فإن الله تعالى يقول : فمن نكث فإنما ينكث على نفسه ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10913 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يعرضن أحدكم نفسه لها وهو صائم : الحمام ، والحجامة ، والنظر إلى المرأة الشابة ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10914 ) قال النبي :(@)(@@) | 30 ( ثلاث خصال لا يفعلها إلا أهل الجنة : طلب العلم ، والترحم على أهل القبور ، وحب الفقراء ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10915 ) قال النبي :(@)(@@) | 30 ( ثلاث خصال تورث القسوة في القلب : حب الطعام ، وحب النوم ، وحب الراحة ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10916 ) قال النبي :(@)(@@) | 30 ( ثلاث من كن فيه فقد برىء من الشح : من أدى زكاة ماله طيبة بها نفسه ، وقرى الضيف ، وأعطى في النوائب ) )(@)(@@) ( طص ) عن جابر رضي الله عنه .(@)(@@) PageV04P174(@)(@@)(@@)(@@) $ ( 10917 ) قال النبي :(@)(@@) | 30 ( ثلاث من أمر الجاهلية لا يدعهن الناس : الطعن في النسب ، والنياحة ، وقولهم مطرنا بنوء كذا ) )(@)(@@) البزار عن عمرو بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10918 ) قال النبي :(@)(@@) | 30 ( ثلاث لا يهلك عليهن ابن آدم : الخطا ، والنسيان ، وما أكره عليه ) )(@)(@@) ( عب ) عن قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 10919 ) قال النبي :(@)(@@) | 30 ( ثلاث تسبيحات ركوعا ، وثلاث تسبيحات سجودا ) )(@)(@@) ( عب ش ) عن جعفر بن محمد عن أبيه معضلا .(@)(@@)(@@)(@@) $ ( 10920 ) قال النبي :(@)(@@) | 30 ( ثلاث قاصمات الظهر ؛ فقر داخل لا يجد صاحبه متلذذا ، وزوجة يأمنها صاحبها وهي تخونه ، وإمام يسخط الله ويرضي الناس ، وبر المرأة المؤمنة كعمل سبعين صديقا ، وفجور المرأة الفاجرة كفجور ألف فاجر ) )(@)(@@) ابن زنجويه عن ابن عمر رضي الله عنهما وهو ضعيف .(@)(@@)(@@)(@@) $ ( 10921 ) قال النبي :(@)(@@) | 30 ( ثلاث من عمل الجاهلية لا يتركها الناس أبدا : الطعن في النسب ، والنياحة على الميت ، والاستمطار بالنجوم ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10922 ) قال النبي :(@)(@@) | 30 ( ثلاث من عمل الجاهلية لا تدعهن أمتي : الطعن في النسب ، والاستسقاء بالأنواء ، والنياحة على الميت ) )(@)(@@) ابن جرير عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10923 ) قال النبي :(@)(@@) | 30 ( ثلاث من لقي الله وهن فيه حرم على 
ms1240	 النار وحرمت عليه : إيمان بالله ورسوله ، والثانية : حب الله عز وجل ، والثالثة : أن توقد نار فيلقى فيها أحب إليه من أن يرجع إلى الكفر ) )(@)(@@) ابن النجار عن ثابت عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10924 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يدخلون الجنة أبدا : الديوث ، والرجلة PageV04P175 من النساء ، ومدمن الخمر ، قيل : يا رسول الله ما الديوث ؟ قال : الذي لا يبالي من دخل على أهله ، قيل : فما الرجلة : قال : التي تتشبه بالرجال ) )(@)(@@) ( طب ) عن عمار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10925 ) قال النبي :(@)(@@) | 30 ( ثلاثة من نجا منها فقد نجا : من نجا عند موتي فقد نجا ، ومن نجا عند قتل خليفة يقتل مظلوما وهو مصطبر يعطي الحق من نفسه فقد نجا ، ومن نجا من فتنة الدجال فقد نجا ) )(@)(@@) ( طب ) و الخطيب في المتفق والمفترق عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10926 ) قال النبي :(@)(@@) | 30 ( ثلاثة أيام ولياليهن للمسافر ، ويوم وليلة للمقيم ، لا ينزعه من نوم ولا بول ولا غائط ، إلا من جنابة ) )(@)(@@) ( طب ) عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10927 ) قال النبي :(@)(@@) | 30 ( ثلاثة معصومون من شر إبليس وجنوده : الذاكرون الله كثيرا بالليل والنهار ، والمستغفرون بالأسحار ، والباكون من خشية الله ) )(@)(@@) أبو الشيخ في الثواب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 10928 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تجاوز صلاتهم رؤوسهم : رجل أم قوما وهم له كارهون ، وامرأة باتت وزوجها ساخط عليها ، ومملوك فر من مولاه ) )(@)(@@) ( هق ) عن أبي سعيد ( هق ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 10929 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا تجاوز صلاتهم آذانهم : عبد أبق من سيده حتى يأتي فيضع يده في يده ، وامرأة بات زوجها غضبان عليها ، ورجل أم قوما وهم له كارهون ) )(@)(@@) ( هق ) عن قتادة مرسلا .(@)(@@)(@@)(@@) $ ( 10930 ) قال النبي :(@)(@@) | 30 ( ثلاثة علي فريضة وهن لكم سنة : الوتر ، والسواك ، وقيام الليل ) )(@)(@@) ( هق ) وضعفه عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 10931 ) قال النبي :(@)(@@) | 30 ( ثلاثة لا يعجزهن ابن آدم : الطيرة ، وسوء الظن ، PageV04P176 والحسد ، فينجيك من الطيرة أن لا تعمل بها ، وينجيك من سوء الظن أن لا 