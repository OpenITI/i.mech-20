ms1321	 أبي مالك قال: {كأن لم يغنوا فيها} [الأعراف: 92] كأن لم يكونوا فيها(@)(@@) PageV05P1524(@)(@@)(@@)(@@) | قوله تعالى: {فتولى عنهم وقال يا قوم لقد أبلغتكم رسالات ربي ونصحت لكم} (@)(@@) [الأعراف: 93](@)(@@) PageV05P1524(@)(@@) حدثنا أبو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، في قول الله: " {فتولى عنهم وقال يا قوم لقد أبلغتكم رسالات ربي ونصحت لكم} [الأعراف: 93] نبي الله شعيب صلى الله عليه وسلم أسمع قومه، وإن نبي الله صالحا صلى الله عليه وسلم أسمع قومه، والله أسمع محمد صلى الله عليه وسلم قومه "(@)(@@) PageV05P1524(@)(@@) حدثنا علي بن الحسين، ثنا محمد بن عيسى، ثنا سلمة، حدثني محمد بن إسحاق، قال: " بلغني والله أعلم أن الله سلط عليهم الحر حتى إذا أنضجهم أنشأ لهم الظلة كالسحابة السوداء، فلما رأوها ابتدروها يستغيثون ببردها مما هم فيه، حتى إذا دخلوا تحتها أطبقت فهلكوا جميعا، ونجا الله عز وجل شعيبا والذين آمنوا معه، فأصابه على قومه حزن لما نزل بهم من نقمة الله، ثم قال: يعزي نفسه فيما ذكر الله عنه: {يا قوم لقد أبلغتكم رسالات ربي ونصحت لكم فكيف آسى على قوم كافرين} [الأعراف: 93] "(@)(@@) PageV05P1524(@)(@@)(@@)(@@) | قوله تعالى: {فكيف آسى} (@)(@@) [الأعراف: 93](@)(@@) PageV05P1524(@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {فكيف آسى} [الأعراف: 93] بقوله: فكيف أحزن؟ "(@)(@@) PageV05P1524(@)(@@)(@@)(@@) | قوله تعالى: {وما أرسلنا في قرية من نبي إلا أخذنا أهلها بالبأساء} (@)(@@) [الأعراف: 94](@)(@@) PageV05P1524(@)(@@) حدثنا أبو سعيد بن يحيى بن سعيد القطان، ثنا عمرو بن محمد(@)(@@)(@@)(@@) | [ص: 1525](@)(@@) العنقزي، ثنا أسباط، عن السدي، عن مرة، عن عبد الله بن مسعود، رضي الله عنه قوله: " بالبأساء، قال: البأساء الفقر وروي عن ابن عباس، وأبي العالية، والحسن في أحد قوليه، ومرة الهمداني، وسعيد بن جبير، ومجاهد، والضحاك، والربيع بن أنس، والسدي، ومقاتل بن حيان نحو ذلك(@)(@@) PageV05P1524(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1525(@)(@@) حدثنا الحسن بن أحمد، ثنا إبراهيم بن عبد الله بن بشار، حدثني سرور بن المغيرة، عن عباد بن منصور، عن الحسن، " {بالبأساء} [الأنعام: 42] ، قال: البلاء "(@)(@@) PageV05P1525(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1525(@)(@@) ذكر عن المطلب 
ms1322	 بن زياد، عن سالم الأفطس، عن سعيد بن جبير، " {فأخذناهم بالبأساء} [الأنعام: 42] ، قال: خوفا من السلطان "(@)(@@) PageV05P1525(@)(@@)(@@)(@@) | قوله تعالى: {والضراء} (@)(@@) [البقرة: 177](@)(@@) PageV05P1525(@)(@@) حدثنا أبو سعيد بن يحيى بن سعيد القطان، ثنا عمرو بن محمد العنقزي، ثنا أسباط، عن السدي، عن مرة، عن عبد الله بن مسعود، في قوله: " {والضراء} [البقرة: 177] ، قال: الضراء السقم " وروي عن ابن عباس، وأبي العالية، ومرة الهمداني، وأبي مالك، والضحاك، والحسن، ومجاهد، والسدي، والربيع بن أنس، ومقاتل بن حيان نحو ذلك(@)(@@) PageV05P1525(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1525(@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {والضراء} [البقرة: 177] يعني حين البلاء والشدة "(@)(@@) PageV05P1525(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1525(@)(@@) حدثنا الحسن بن أحمد، ثنا إبراهيم بن بشار، حدثني سرور بن المغيرة، عن عباد بن منصور، عن الحسن، " {والضراء} [البقرة: 177] ، قال: هذه الأمراض والجوع ونحو ذلك "(@)(@@) PageV05P1525(@)(@@)(@@)(@@) | قوله تعالى: {لعلهم يضرعون} (@)(@@) [الأعراف: 94](@)(@@) PageV05P1526(@)(@@) حدثنا موسى بن أبي موسى الخطمي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن أبي حماد، عن أسباط، عن السدي، عن أبي مالك، قوله: " {لعلهم} [الأعراف: 94] يعني: كي "(@)(@@) PageV05P1526(@)(@@)(@@)(@@) | قوله تعالى: {ثم بدلنا مكان السيئة الحسنة} (@)(@@) [الأعراف: 95](@)(@@) PageV05P1526(@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {ثم بدلنا مكان السيئة الحسنة} [الأعراف: 95] ، يقول: مكان الشدة الرخاء "(@)(@@) PageV05P1526(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1526(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {مكان السيئة الحسنة} [الأعراف: 95] ، قال: السيئة الشر "(@)(@@) PageV05P1526(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قول الله: " {ثم بدلنا مكان السيئة الحسنة} [الأعراف: 95] ، يقول: بدلنا ما كان كرهوا ما أحبوا في الدنيا "(@)(@@) PageV05P1526(@)(@@)(@@)(@@) | قوله تعالى: {الحسنة} (@)(@@) [الأعراف: 95](@)(@@) PageV05P1526(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، " {ثم بدلنا مكان السيئة الحسنة} [الأعراف: 95] ، قال: والحسنة: الرخاء، والعدل والولد "(@)(@@) PageV05P1526(@)(@@) حدثنا أبو زرعة، ثنا صفوان، ثنا الوليد، ثنا 
ms1323	 سعيد بن بشير، عن قتادة، قال: " بدلوا مكان السيئة الجهد والبلاء، وبالحسنة الغاية قوله: {حتى عفوا} [الأعراف: 95] "(@)(@@) PageV05P1526(@)(@@) حدثنا أبو زرعة، ثنا منجاب بن الحارث، أنبأ بشر بن عمارة، عن أبي روق، عن الضحاك، عن ابن عباس، قوله: " {حتى عفوا} [الأعراف: 95] ، حتى جموا: يعني كثروا(@)(@@) PageV05P1526(@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {حتى عفوا} [الأعراف: 95] ، يقول: حتى كثروا وكثرت أموالهم "(@)(@@) PageV05P1526(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1527(@)(@@) ذكره أبو زرعة، ثنا عبيد بن جناد، ثنا ابن المبارك، عن محمد بن يسار، عن يزيد بن أبي سعيد، عن عكرمة، " {حتى عفوا} [الأعراف: 95] ، قال: أشروا، وبطروا "(@)(@@) PageV05P1527(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1527(@)(@@) حدثنا أبي، ثنا محمد بن عبد الأعلى، ثنا محمد بن ثور، عن معمر، عن قتادة: " {حتى عفوا} [الأعراف: 95] ، يقول: حتى سروا بذلك "(@)(@@) PageV05P1527(@)(@@)(@@)(@@) | والوجه الرابع(@)(@@) PageV05P1527(@)(@@) حدثنا علي بن الحسين، ثنا الحسن بن عمر بن شقيق، ثنا الحسن بن سهيل الثقفي، عن أبي حمزة العطار، عن الحسن، في قوله: " {حتى عفوا} [الأعراف: 95] ، قال: حتى سمنوا "(@)(@@) PageV05P1527(@)(@@)(@@)(@@) | والوجه الخامس(@)(@@) PageV05P1527(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ، قال: سمعت عبد الرحمن بن زيد بن أسلم، يقول: " {حتى عفوا} [الأعراف: 95] من ذلك العذاب "(@)(@@) PageV05P1527(@)(@@)(@@)(@@) | قوله تعالى " {وقالوا قد مس آباءنا الضراء والسراء} (@)(@@) [الأعراف: 95](@)(@@) PageV05P1527(@)(@@) أخبرنا موسى بن هارون الطوسي، فيما كتب أبي، ثنا الحسين بن محمد المروذي، ثنا شيبان، عن قتادة، قوله: " {وقالوا قد مس آباءنا الضراء والسراء} [الأعراف: 95] ، قال: قالوا: قد أتى على آبائنا مثل هذا فلم يكن شيئا "(@)(@@) PageV05P1527(@)(@@)(@@)(@@) | قوله تعالى: {فأخذناهم} (@)(@@) [الأنعام: 42](@)(@@) PageV05P1527(@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل، ثنا أسباط، عن السدي، قوله: " {فأخذناهم بغتة} [الأعراف: 95] ، يقول: أخذهم العذاب بغتة "(@)(@@) PageV05P1527(@)(@@)(@@)(@@) | قوله تعالى: {وهم لا يشعرون} (@)(@@) [الأعراف: 95](@)(@@) PageV05P1527(@)(@@) أخبرنا موسى بن هارون الطوسي، فيما كتب إلي، ثنا الحسين بن محمد المروذي، ثنا شيبان، عن قتادة، قوله: " {فأخذناهم بغتة وهم لا يشعرون} [الأعراف: 95] ، قال: بغت(@)(@@)(@@)(@@) | [ص: 1528](@)(@@) القوم أمر الله، وما أخذ الله قوما قط إلا عند سلوتهم، وغرتهم، ونعمتهم 
ms1324	 فلا تغتروا بالله إنه لا يغتر بالله إلا القوم الفاسقون "(@)(@@) PageV05P1527(@)(@@) حدثنا علي بن الحسين، ثنا محمد بن أبي حماد، ثنا مهران، عن سفيان، قوله: " {فأخذناهم بغتة} [الأعراف: 95] ، قال: بعد ستين سنة "(@)(@@) PageV05P1528(@)(@@) حدثنا أبي، حدثني أحمد بن إبراهيم بن كثير الدروقي، ثنا محمد بن شيبة ابن أخت ابن المبارك، ثنا ابن المبارك، عن محمد بن النضر الحارثي، في قوله: " {فأخذناهم بغتة} [الأعراف: 95] ، قال: أمهلوا عشرين سنة "(@)(@@) PageV05P1528(@)(@@)(@@)(@@) | قوله تعالى: {ولو أن أهل القرى آمنوا} (@)(@@) [الأعراف: 96](@)(@@) PageV05P1528(@)(@@) حدثنا محمد بن يحيى، أنبأ العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {ولو أن أهل، القرى آمنوا} [الأعراف: 96] ، قال: آمنوا بما أنزل "(@)(@@) PageV05P1528(@)(@@)(@@)(@@) | قوله تعالى: {واتقوا} (@)(@@) [البقرة: 48](@)(@@) PageV05P1528(@)(@@) وبه، عن قتادة، قوله: " {آمنوا واتقوا} [البقرة: 103] ، قال: اتقوا ما حرم الله "(@)(@@) PageV05P1528(@)(@@)(@@)(@@) | قوله تعالى: {لفتحنا عليهم بركات من السماء والأرض} (@)(@@) [الأعراف: 96](@)(@@) PageV05P1528(@)(@@) حدثنا علي بن الحسين، ثنا المقدمي، ثنا مسلم، حدثني المنهال بن عيسى، حدثني معاذ بن رفاعة، عن موسى الطايفي، قال: قال رسول الله صلى الله عليه وسلم: «أكرموا الخبز، فإن الله أنزله من بركات السماء، وأخرجه من بركات الأرض»(@)(@@) PageV05P1528(@)(@@)(@@)(@@) | (@)(@@)(@@)(@@) | قوله تعالى: {أفأمن أهل القرى} (@)(@@) </span>[الأعراف: 97](@)(@@) PageV05P1528(@)(@@) حدثنا أبي، ثنا سعيد بن داود، ثنا يوسف بن عطية، عن المعلى بن زياد القردوسي، قال: كان هرم بن حيان، يخرج في وسط الليل، ثم يقرأ: {أفأمن أهل القرى أن يأتيهم بأسنا بياتا وهم نائمون} [الأعراف: 97](@)(@@) PageV05P1528(@)(@@) حدثنا أبي، ثنا ابن أبي زياد القطواني، ثنا سيار، ثنا جعفر، قال: سمعت مالك بن دينار، يقول: " قالت ابنة الربيع لأبيها: " يا أبتاه مالي أرى الناس ينامون ولا أراك تنام، قال: يا ابنتاه «إني أخاف البيات»(@)(@@) PageV05P1528(@)(@@) حدثنا أبي، ثنا ابن أبي زياد، ثنا سيار، ثنا جعفر، قال: سمعت مالك بن دينار: " لو استطعت أن لا أنام لم أنم مخافة أن ينزل العذاب وأنا نائم، ولو وجدت أعوانا لفرقتهم في منازل الأرض كلها ينادون أيها الناس: النار النار "(@)(@@) PageV05P1528(@)(@@)(@@)(@@) | قوله تعالى: {أفأمن أهل القرى} (@)(@@) [الأعراف: 97](@)(@@) PageV05P1529(@)(@@) ذكر عن المقدمي، ثنا هارون الخزاز، عن علي بن المبارك، 
ms1325	 ثنا أبو عمران الشقري، قال: كان ابن عباس يقول: " لا تتخذوا الدجاج والكلاب، فتكونوا من أهل القرى وتلا: {أوأمن أهل القرى أن يأتيهم بأسنا ضحى وهم يلعبون} "(@)(@@) PageV05P1529(@)(@@)(@@)(@@) | قوله تعالى: {أفأمنوا مكر الله فلا يأمن مكر الله} (@)(@@) [الأعراف: 99](@)(@@) PageV05P1529(@)(@@) حدثنا أبي، ثنا أبو بكر بن مروان بن الحكم الأسيدي، ثنا أبو عروة الزبير بن عيسى بن عروة بن يحيى بن عروة بن الزبير، عن هشام بن عروة، قال: " كتب رجل إلى صاحب له: وإذا رضيت من الله شيئا يسرك فلا تأمن أن يكون فيه من الله مكر {فلا يأمن مكر الله إلا القوم الخاسرون} [الأعراف: 99] "(@)(@@) PageV05P1529(@)(@@) حدثنا علي بن الحسين، ثنا هارون بن سعيد، أنبأ ابن وهب، أنبأ ابن زيد، عن أبيه، " أن الله، تبارك وتعالى قال للملائكة: ما هذا الخوف الذي قد بلغكم وقد أنزلتكم المنزلة التي لم أنزلها غيركم؟ فقالوا: «ربنا لا نأمن مكرك، لا يأمن مكرك إلا القوم الخاسرون»(@)(@@) PageV05P1529(@)(@@) حدثنا أبي، ثنا حماد بن حميد العسقلاني، ثنا أيوب بن سويد، عن إسماعيل بن رافع، قال: «من الأمن لمكر الله إقامة العبد على الذنب يتمنى على الله المغفرة»(@)(@@) PageV05P1529(@)(@@)(@@)(@@) | قوله تعالى: {أولم يهد} (@)(@@) [الأعراف: 100](@)(@@) PageV05P1529(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {أولم يهد} [الأعراف: 100] يبين " وروي عن السدي، وعطاء الخراساني مثل ذلك(@)(@@) PageV05P1529(@)(@@)(@@)(@@) | قوله تعالى: {للذين يرثون الأرض} (@)(@@) [الأعراف: 100](@)(@@) PageV05P1529(@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل(@)(@@)(@@)(@@) | [ص: 1530](@)(@@) ، ثنا أسباط، عن السدي، قوله: " {للذين يرثون الأرض من بعد أهلها} [الأعراف: 100] ، قال: المشركون "(@)(@@) PageV05P1529(@)(@@)(@@)(@@) | قوله تعالى: {أن لو نشاء أصبناهم بذنوبهم} (@)(@@) [الأعراف: 100](@)(@@) PageV05P1530(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، يقول في قوله: " {أولم يهد للذين يرثون الأرض من بعد أهلها أن لو نشاء أصبناهم بذنوبهم} [الأعراف: 100] ، قال: " والهدي: البيان للذين يبعث هاديا لهم مبينا لهم حتى يعرفوا لولا البيان لم يعرفوا "(@)(@@) PageV05P1530(@)(@@)(@@)(@@) | قوله تعالى: {تلك القرى نقص عليك من أنبائها} (@)(@@) [الأعراف: 
ms1326	 101](@)(@@) PageV05P1530(@)(@@) حدثنا أبو بكر بن أبي موسى، ثنا هارون بن حاتم، ثنا عبد الرحمن بن أبي حماد، عن أسباط، عن السدي، عن أبي مالك، قوله: " {أنباء} [آل عمران: 44] يعني: أحاديث "(@)(@@) PageV05P1530(@)(@@)(@@)(@@) | قوله تعالى: {فما كانوا ليؤمنوا بما كذبوا من قبل} (@)(@@) [الأعراف: 101](@)(@@) PageV05P1530(@)(@@) حدثنا كثير بن شهاب القزويني، ثنا محمد بن سعيد، ثنا أبو جعفر، عن الربيع، عن أبي العالية، عن أبي بن كعب، " {فما كانوا ليؤمنوا بما كذبوا من قبل} [الأعراف: 101] ، كان في علم الله يوم أقروا به، ومن يصدق به، ومن يكذب به "(@)(@@) PageV05P1530(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، " {بما كذبوا من قبل} [الأعراف: 101] مثل قوله: {ولو ردوا لعادوا لما نهوا عنه} [الأنعام: 28] "(@)(@@) PageV05P1530(@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن المفضل، ثنا أسباط، عن السدي، قوله: " {فما كانوا ليؤمنوا بما كذبوا من قبل} [الأعراف: 101] ، قال ذلك يوم أخذ منهم الميثاق فآمنوا كرها "(@)(@@) PageV05P1530(@)(@@)(@@)(@@) | قوله تعالى: {وما وجدنا لأكثرهم من عهد} (@)(@@) [الأعراف: 102](@)(@@) PageV05P1530(@)(@@) حدثنا علي بن حرب الموصلي، ثنا بشر بن عمر الزهراني، ثنا معتمر بن سليمان، عن أبيه، عن الربيع بن أنس، عن أبي العالية، " {وما وجدنا لأكثرهم من عهد} [الأعراف: 102] ، قال: هو ذلك العهد يعني يوم أخذ الميثاق "(@)(@@) PageV05P1530(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1531(@)(@@) حدثنا أبو زرعة، ثنا صفوان، عن الوليد، ثنا سعيد بن بشير، عن قتادة، قال: " قدم الله عند ذلك أكثرهم، فقال: {وما وجدنا لأكثرهم من عهد وإن وجدنا أكثرهم لفاسقين} [الأعراف: 102] "(@)(@@) PageV05P1531(@)(@@) حدثنا أبي، ثنا أبو سلمة، ثنا مبارك، عن الحسن، " {وما وجدنا لأكثرهم من عهد} [الأعراف: 102] ، قال: العهد الوفاء "(@)(@@) PageV05P1531(@)(@@)(@@)(@@) | قوله تعالى: {وإن وجدنا أكثرهم لفاسقين} (@)(@@) [الأعراف: 102](@)(@@) PageV05P1531(@)(@@) أخبرنا محمد بن سعد العوفي، فيما كتب إلي، حدثني أبي، حدثني عمي، عن أبيه، عن أبيه، عن ابن عباس، قوله: " {وإن وجدنا أكثرهم لفاسقين} [الأعراف: 102] «وذلك أن الله إنما أهلك القرى، لأنهم لم يكونوا حفظوا ما أوصاهم به»(@)(@@) PageV05P1531(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {أكثرهم لفاسقين} 
ms1327	 [الأعراف: 102] ، القرون الماضية "(@)(@@) PageV05P1531(@)(@@)(@@)(@@) | قوله تعالى: {ثم بعثنا من بعدهم موسى بآياتنا إلى فرعون وملئه فظلموا بها} (@)(@@) [الأعراف: 103](@)(@@) PageV05P1531(@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو يحيى الرازي، عن موسى بن عبيدة، عن محمد بن المنكدر، قال: «عاش فرعون ثلاثمائة سنة، منها مائتان وعشرون سنة لم ير فيها ما يقذي عينه ودعاه موسى ثمانين سنة»(@)(@@) PageV05P1531(@)(@@) حدثنا أبي، ثنا إبراهيم بن سعيد الجوهري، ثنا أبو أسامة، ثنا شبل، عن ابن أبي نجيح، عن مجاهد، قال: «كان فرعون فارسيا من أهل إصطخر»(@)(@@) PageV05P1531(@)(@@) قرئ على يونس بن عبد الأعلى، أنبأ ابن وهب، أخبرني ابن لهيعة: «أن فرعون، كان من أبناء مصر»(@)(@@) PageV05P1531(@)(@@)(@@)(@@) | قوله تعالى: {وقال موسى يا فرعون إني رسول من رب العالمين} (@)(@@) [الأعراف: 104](@)(@@) PageV05P1531(@)(@@) ذكر عن ابن أبي عمر السعدني، ثنا سفيان، عن أبي سعيد، عن عكرمة، عن ابن عباس، قال: " ما زاده إلا رغما قال: {إني رسول من رب العالمين} [الأعراف: 104] "(@)(@@) PageV05P1531(@)(@@)(@@)(@@) | قوله تعالى: {حقيق على أن لا أقول على الله إلا الحق} [الأعراف: 105] إلى {الصادقين} (@)(@@) [المائدة: 119](@)(@@) PageV05P1532(@)(@@) حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، عن أصبغ بن زيد، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس، قال: " فقال فرعون لموسى: ما تريد؟ قال: " أريد أن تؤمن بالله، وأن ترسل معي بني إسرائيل فأبى عليه ذلك، وقال: آتي بآية إن كنت من الصادقين "(@)(@@) PageV05P1532(@)(@@)(@@)(@@) | قوله تعالى: {فألقى عصاه} (@)(@@) [الأعراف: 107](@)(@@) PageV05P1532(@)(@@) حدثنا أبي، ثنا عبد الأعلى بن حماد النرسي، ثنا أبو بدر شجاع بن الوليد عن ابن أبي غنية، عن الحكم، قال: «كانت عصى موسى عليه الصلاة والسلام من عوسج ولم يسخر العوسج لأحد بعده»(@)(@@) PageV05P1532(@)(@@) أخبرنا أبو عبد الله محمد بن حماد الطهراني فيما كتب إلي، ثنا إسماعيل بن عبد الكريم، عن عبد الصمد بن معقل، قال: سمعت وهب بن منبه، قال: " قال فرعون لموسى: {ألم نربك فينا وليدا} [الشعراء: 18] ، قال: فرد إليه موسى الذي رد، فقال فرعون: خذوه فبادره موسى {فألقى عصاه فإذا هي ثعبان مبين} [الأعراف: 107] فحملت على الناس فانهزموا منها 
ms1328	 فمات منهم خمسة وعشرون ألفا قتل بعضهم بعضا، فقام فرعون منهزما حتى دخل البيت "(@)(@@) PageV05P1532(@)(@@)(@@)(@@) | قوله تعالى: {فإذا هي ثعبان مبين} (@)(@@) [الأعراف: 107](@)(@@) PageV05P1532(@)(@@) حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، عن أصبغ بن زيد، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس: «فألقى عصاه فتحولت حية عظيمة فاغرة فاها، مسرعة إلى فرعون فلما رآها فرعون أنها قاصدة إليه خافها فاقتحم على سريره، واستغاث بموسى أن يكفها عنه ففعل»(@)(@@) PageV05P1532(@)(@@) حدثنا أبو سعيد الأشج، ثنا عبيدة، عن جويبر، عن الضحاك، عن ابن عباس، في قوله: " {ثعبان مبين} [الأعراف: 107] ، قال: الحية الذكر "(@)(@@) PageV05P1532(@)(@@) حدثنا أبي، ثنا محمد بن عبد الأعلى الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة، " {فإذا هي ثعبان مبين} [الأعراف: 107] ، قال: تحولت حية عظيمة ". وقال غيره: مثل المدينة، وقال قتادة: «فأكلت سحرهم كله»(@)(@@) PageV05P1533(@)(@@)(@@)(@@) | قوله تعالى: {ونزع يده} (@)(@@) [الأعراف: 108](@)(@@) PageV05P1533(@)(@@) حدثنا عمار بن خالد الواسطي، ثنا يزيد بن هارون، عن أصبغ بن زيد، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس، في قوله: " {ونزع يده} [الأعراف: 108] ، قال: فأخرج يده من جيبه "(@)(@@) PageV05P1533(@)(@@)(@@)(@@) | قوله تعالى: {فإذا هي بيضاء للناظرين} (@)(@@) [الأعراف: 108](@)(@@) PageV05P1533(@)(@@) حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، عن أصبغ بن زيد، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس، قوله: " {فإذا هي بيضاء للناظرين} [الأعراف: 108] ، قال: أخرج يده من جيبه فرآها بيضاء من غير سوء يعني به البرص، ثم أعادها في كمه فصارت إلى لونها الأول "(@)(@@) PageV05P1533(@)(@@)(@@)(@@) | قوله تعالى: {قال الملأ من قوم فرعون إن هذا لساحر عليم} (@)(@@) [الأعراف: 109](@)(@@) PageV05P1533(@)(@@) وبه، عن ابن عباس، قال: " فاستشار الملأ فيما رأى، فقالوا: {إن هذان لساحران يريدان أن يخرجاكم من أرضكم} [طه: 63] "(@)(@@) PageV05P1533(@)(@@)(@@)(@@) $ 8797 - قوله تعالى: {يريد أن يخرجكم من أرضكم فماذا تأمرون} [الأعراف: 110](@)(@@) PageV05P1533(@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد بن طلحة، ثنا أسباط، عن السدي، قوله: " {يريد أن يخرجكم من أرضكم} [الأعراف: 110] ، قال: يستخرجكم من أرضكم "(@)(@@) PageV05P1533(@)(@@)(@@)(@@) | قوله تعالى: {قالوا أرجه 
ms1329	 وأخاه} (@)(@@) [الأعراف: 111](@)(@@) PageV05P1533(@)(@@) حدثنا أبي، ثنا إبراهيم بن موسى، أنبأ هشام، عن ابن جريج، عن عطاء الخراساني، عن ابن عباس، " {أرجه} [الأعراف: 111] ، يقول: أخره وأخاه "(@)(@@) PageV05P1533(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1533(@)(@@) حدثنا محمد بن يحيى، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {أرجه وأخاه} [الأعراف: 111] احبسه وأخاه "(@)(@@) PageV05P1533(@)(@@)(@@)(@@) | قوله تعالى: {وأرسل في المدائن حاشرين} (@)(@@) [الأعراف: 111](@)(@@) PageV05P1534(@)(@@) قال أبي:، قال سهل بن بكار: ثنا أبو عوانة، عن يزيد بن زياد، عن مقسم، عن ابن عباس، " {وأرسل في المدائن حاشرين} [الأعراف: 111] وكانت السحرة يخشون من فرعون، فلما أرسل إليهم، قال: قد احتاج إليكم إلهكم، قال: إن هذا فعل كذا وكذا "(@)(@@) PageV05P1534(@)(@@) حدثنا عمار بن خالد، ثنا محمد بن الحسن، وزيد بن هارون، واللفظ لمحمد بن أصبغ بن زيد الوراق، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس، قال: " قالوا له يعني لفرعون: أجمع السحرة فإنهم بأرضك كثير حتى تغلب بسحرهم، فأرسل في المدائن فحشر له كل ساحر متعالم "(@)(@@) PageV05P1534(@)(@@) حدثنا أبي، ثنا موسى بن عدي، ثنا ابن أبي زائدة، عن إسماعيل بن إبراهيم بن مهاجر، عن أبيه، عن مجاهد، عن ابن عباس، في قوله: {في المدائن حاشرين} [الأعراف: 111] ، قال: الشرط "(@)(@@) PageV05P1534(@)(@@)(@@)(@@) | قوله تعالى: {يأتوك بكل ساحر عليم} (@)(@@) [الأعراف: 112](@)(@@) PageV05P1534(@)(@@) حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، واللفظ، لمحمد بن الحسن، عن أصبغ بن زيد الوراق، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس يعني قوله: " {يأتوك بكل ساحر عليم} [الأعراف: 112] ، فحشر له كل ساحر متعالم "(@)(@@) PageV05P1534(@)(@@)(@@)(@@) | قوله تعالى: {وجاء السحرة فرعون} (@)(@@) [الأعراف: 113](@)(@@) PageV05P1534(@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو يحيى الرازي، عن موسى بن عبيدة، عن محمد بن كعب، قال: «السحرة الذين توفاهم الله مسلمين ثمانين ألفا»(@)(@@) PageV05P1534(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1534(@)(@@) حدثنا أبي، ثنا عثمان بن أبي شيبة، ثنا جرير، عن عبد العزيز بن رفيع، عن خيثمة، عن أبي سودة، عن كعب، قال: «كانت سحرة فرعون اثني عشر ألفا»(@)(@@) PageV05P1534(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1534(@)(@@) ذكر، عن زكريا بن يحيى الكسائي، ثنا 
ms1330	 أبو بكر بن عياش، عن عبد العزيز بن رفيع، عن أبي سودة، عن كعب، قال: «كانت سحرة فرعون تسعة عشر ألفا»(@)(@@) PageV05P1534(@)(@@)(@@)(@@) | والوجه الرابع(@)(@@) PageV05P1535(@)(@@) ذكر، عن معاوية بن هشام، عن سفيان، عن عبد العزيز بن رفيع، عن أبي ثمامة، قال: «سحرة فرعون سبعة عشر ألفا»(@)(@@) PageV05P1535(@)(@@)(@@)(@@) | والوجه الخامس(@)(@@) PageV05P1535(@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد بن طلحة، ثنا أسباط، عن السدي، قال: «كان يعين السحرة بضعة وثلاثون ألفا ليس منهم رجل إلا ومعه حبل أو عصا»(@)(@@) PageV05P1535(@)(@@)(@@)(@@) | قوله تعالى: {أئن لنا لأجرا إن كنا نحن الغالبين} (@)(@@) [الشعراء: 41](@)(@@) PageV05P1535(@)(@@) وحدثنا عمار بن خالد الواسطي، ثنا محمد بن الحسن، ويزيد بن هارون، عن أصبغ بن زيد، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس، " فلما أتوا فرعون، قالوا: بم يعمل هذا الساحر. قالوا: عمله بالحيات، قالوا: فلا والله ما في الأرض قوم يعملون بالسحر بالحيات والحبال والعصى الذي نعمل، فما أجرنا إن غلبنا، قال: فقال لهم: أنتم أقاربي وخاصتي، وأنا صانع إليكم كما أحببتم "(@)(@@) PageV05P1535(@)(@@)(@@)(@@) | قوله تعالى: {قالوا يا موسى إما أن تلقي وإما أن نكون نحن الملقين} (@)(@@) [الأعراف: 115](@)(@@) PageV05P1535(@)(@@) وبه، عن ابن عباس، قال: " اليوم الذي أظهر الله فيه موسى على السحرة وفرعون هو يوم عاشورا، فلما اجتمعوا في صعيد، قال الناس بعضهم لبعض: انطلقوا فلنحضر هذا الأمر، ونتبع السحرة إن كانوا هم الغالبين، يعني بذلك موسى، وهارون صلى الله عليهما وسلم استهزاء بهما، قالوا يا موسى لقدرتهم بسحرهم: إما أن تلقي وإما أن نكون نحن الملقين، قال: ألقوا، فألقوا حبالهم وعصيهم وقالوا: بعزة فرعون إنا لنحن الغالبون، فرأى موسى من سحرهم ما أوجس في نفسه خيفة، فأوحى الله عز وجل إليه أن ألق العصا "(@)(@@) PageV05P1535(@)(@@)(@@)(@@) | قوله تعالى: {وأوحينا إلى موسى أن ألق عصاك} (@)(@@) [الأعراف: 117](@)(@@) PageV05P1535(@)(@@) وبه، عن ابن عباس، قوله: " {وأوحينا إلى موسى أن ألق عصاك} [الأعراف: 117] ، قال: فأوحى الله إليه أن ألق العصا، فلما ألقاها صارت ثعبانا عظيما فاغرة فاها "(@)(@@) PageV05P1535(@)(@@) حدثنا محمد بن يحيى، أنبأ أبو غسان، ثنا جرير، عن يعقوب، عن جعفر، 
ms1331	 عن سعيد بن جبير، عن ابن عباس، قال: «وعصى موسى اسمها ماسا، وهي مع يوشع بن نون»(@)(@@) PageV05P1536(@)(@@)(@@)(@@) | قوله تعالى: {فإذا هي تلقف} (@)(@@) [الأعراف: 117](@)(@@) PageV05P1536(@)(@@) حدثنا عمار بن خالد الواسطي، ثنا محمد بن الحسن، ويزيد بن هارون، عن أصبغ بن زيد، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس، قال: «فجعلت العصا بدعوة موسى تلتبس بالحبال، فصارت جرزا إلى الثعبان حتى تدخل فيه حتى ما بقيت عصا ولا حبل إلا ابتلعته»(@)(@@) PageV05P1536(@)(@@) ذكر، عن وهب بن جرير، عن قرة بن خالد، عن الحسن، " {فإذا هي تلقف ما يأفكون} [الأعراف: 117] ، قال: يشترط حبالهم وعصيهم "(@)(@@) PageV05P1536(@)(@@)(@@)(@@) | قوله تعالى: {ما يأفكون} (@)(@@) [الأعراف: 117](@)(@@) PageV05P1536(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {يأفكون} [الأعراف: 117] يكذبون "(@)(@@) PageV05P1536(@)(@@)(@@)(@@) | قوله تعالى: {فوقع الحق} (@)(@@) [الأعراف: 118](@)(@@) PageV05P1536(@)(@@) حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، عن أصبغ بن زيد، عن القاسم بن أبي أيوب، حدثني سعيد بن جبير، عن ابن عباس يعني قوله: " {فوقع الحق} [الأعراف: 118] ، قال: ظهر الحق " وروي، عن مجاهد نحو ذلك(@)(@@) PageV05P1536(@)(@@)(@@)(@@) | قوله تعالى: {وبطل ما كانوا يعملون} (@)(@@) [الأعراف: 118](@)(@@) PageV05P1536(@)(@@) وبه، عن ابن عباس، قوله: " {وبطل ما كانوا يعملون فغلبوا هنالك وانقلبوا صاغرين} [الأعراف: 119] ، فكسر الله ظهر فرعون في ذلك الموطن وأشياعه "(@)(@@) PageV05P1536(@)(@@)(@@)(@@) | قوله تعالى: {وألقي السحرة ساجدين} (@)(@@) [الأعراف: 120](@)(@@) PageV05P1536(@)(@@) ذكر، عن سعيد بن سلام، ثنا إسماعيل بن عبد الله بن سلمان، عن سالم الأفطس، عن سعيد بن جبير، " {وألقي السحرة ساجدين} [الأعراف: 120] ، قال: رأوا منازلهم تبنى لهم وهم في سجودهم "(@)(@@) PageV05P1536(@)(@@)(@@)(@@) | قوله تعالى: {آمنا برب العالمين رب موسى وهارون} (@)(@@) [الأعراف: 122](@)(@@) PageV05P1537(@)(@@) حدثنا عمار، ثنا محمد، وزيد، عن أصبغ، عن القاسم، حدثني سعيد بن جبير، عن ابن عباس: " فلما عرفت السحرة ذلك، قالوا: لو كان هذا سحرا لم يبلغ من سحرنا كل هذا ولكن هذا أمر من الله، آمنا بالله وبما جاء به موسى، ونتوب إلى الله مما كنا عليه "(@)(@@) PageV05P1537(@)(@@) أخبرنا أبو عبد الله محمد بن حماد الطهراني فيما كتب إلي، أنبأ عبد الرزاق، أنبأ 
ms1332	 معمر، عن رجل، عن أبي صالح، عن ابن عباس، في قوله: " {آمنا برب العالمين} [الأعراف: 121] ، قال: كانوا سحرة في أول النهار، وشهداء آخر النهار، يعني حين قتلوا "(@)(@@) PageV05P1537(@)(@@) حدثنا أبي، ثنا إبراهيم بن سعيد الجوهري، ثنا أبو أسامة، ثنا شبل، عن ابن أبي نجيح، عن مجاهد، قال: «كان فرعون فارسيا من أهل إصطخر»(@)(@@) PageV05P1537(@)(@@)(@@)(@@) | قوله تعالى: {إن هذا لمكر مكرتموه في المدينة} (@)(@@) [الأعراف: 123](@)(@@) PageV05P1537(@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد بن طلحة، عن أسباط، عن السدي، " قال فرعون: {إن هذا لمكر مكرتموه في المدينة} [الأعراف: 123] إذ التقيتما لتتظاهرا فتخرجا منها أهلها "(@)(@@) PageV05P1537(@)(@@)(@@)(@@) | قوله تعالى: {لأقطعن أيديكم وأرجلكم من خلاف} (@)(@@) [الأعراف: 124](@)(@@) PageV05P1537(@)(@@) حدثنا محمد بن يحيى، أنبأ يوسف بن واقد، ثنا يعقوب، عن جعفر بن أبي المغيرة، عن سعيد بن جبير، " {لأقطعن أيديكم وأرجلكم من خلاف ثم لأصلبنكم} [الأعراف: 124] ، وكان أول من قطع الأيدي والأرجل وصلب فرعون "(@)(@@) PageV05P1537(@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد، ثنا أسباط، عن السدي، " {لأقطعن أيديكم وأرجلكم من خلاف} [الأعراف: 124] ، فقتلهم وقطعهم كما قال "(@)(@@) PageV05P1537(@)(@@)(@@)(@@) | قوله تعالى: {قالوا إنا إلى ربنا منقلبون} (@)(@@) [الأعراف: 125](@)(@@) PageV05P1537(@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، ثنا ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {إنا إلى ربنا منقلبون} [الأعراف: 125] ، يعني: إنا إلى ربنا راجعون "(@)(@@) PageV05P1537(@)(@@)(@@)(@@) | قوله تعالى: {ربنا أفرغ علينا صبرا وتوفنا مسلمين} (@)(@@) [الأعراف: 126](@)(@@) PageV05P1538(@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد، ثنا أسباط، عن السدي، قال: قال عبد الله بن عباس: حين قالوا: " {ربنا أفرغ علينا صبرا وتوفنا مسلمين} [الأعراف: 126] ، قال: فكانوا في أول النهار سحرة، وفي آخر النهار شهداء "(@)(@@) PageV05P1538(@)(@@)(@@)(@@) | قوله تعالى: {ويذرك وآلهتك} (@)(@@) [الأعراف: 127](@)(@@) PageV05P1538(@)(@@) حدثنا محمد بن عبد الله بن يزيد المقرئ، ثنا سفيان بن عيينة، عن عمرو بن دينار، عن محمد بن حسن، كذا قال: إن ابن عباس كان يقرأ: " {ويذرك وآلهتك} [الأعراف: 127] ، قال: إنما كان فرعون يعبد ولا يعبد "(@)(@@) PageV05P1538(@)(@@) حدثنا أبي، ثنا موسى بن إسماعيل، ثنا جرير بن حازم، عن الزبير بن خريت، عن عكرمة، عن ابن عباس، في 
ms1333	 قوله: " {ويذرك وآلهتك} [الأعراف: 127] ، قال: عبادتك "(@)(@@) PageV05P1538(@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {ويذرك وآلهتك} [الأعراف: 127] ، قال: يترك عبادتك "(@)(@@) PageV05P1538(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1538(@)(@@) حدثنا محمد بن حماد الطهراني، أنبأ حفص بن عمر، ثنا الحكم بن أبان، عن عكرمة، " {ويذرك وآلهتك} [الأعراف: 127] ، قال: ليس يعنون به الأصنام، إنما يعنون تعظيمه "(@)(@@) PageV05P1538(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1538(@)(@@) ذكره أبو زرعة، ثنا نصر بن علي، أنبأ المعتمر، عن أبيه، قال: قرأت على بكر بن عبد الله {ويذرك وآلهتك} [الأعراف: 127] ، قال بكر: «أتعرف هذا في العربية؟» ، فقلت: نعم، فجاء الحسن فاستقرأني بكر فقرأتها كذلك، فقال الحسن: {ويذرك وآلهتك} [الأعراف: 127] فقلت للحسن: أو كان يعبد شيئا؟ قال: إي والله، إن كان ليعبد، قال معتمر، قال أبي: بلغني أنه كان يجعل في عنقه شيئا يعبده "(@)(@@) PageV05P1538(@)(@@) قال: وبلغني أيضا عن ابن عباس أنه قال: " كان يعبد البقر(@)(@@) PageV05P1538(@)(@@) حدثنا أبي، حدثني أبو حصين بن يحيى بن سليمان، ثنا مروان، ثنا هارون، عن نصير بن يزيد، عن الحسن، ذكر قول الله: " {ويذرك وآلهتك} [الأعراف: 127] ، قال: كان فرعون له آلهة يعبدها سرا "(@)(@@) PageV05P1538(@)(@@) قوله تعالى: {سنقتل أبناءهم ونستحيي(@)(@@)(@@)(@@) | [ص: 1539](@)(@@) نساءهم} [الأعراف: 127](@)(@@) PageV05P1538(@)(@@) حدثنا علي بن الحسين، ثنا محمد بن أبي حماد، ثنا مهران، عن سفيان، في قوله: " {ونستحيي نساءهم} [الأعراف: 127] ، قال: لا نقتلهن "(@)(@@) PageV05P1539(@)(@@)(@@)(@@) | قوله تعالى: {واصبروا} (@)(@@) [الأعراف: 128](@)(@@) PageV05P1539(@)(@@) حدثنا علي بن محمد بن أبي الخصيب، ثنا وكيع، عن سفيان، عن أبي إسحاق، عن جري بن كليب، عن رجل من بني سليم، عن النبي صلى الله عليه وسلم، قال: «الصوم نصف الصبر»(@)(@@) PageV05P1539(@)(@@) حدثنا أبي، ثنا عبيد الله بن حمزة بن إسماعيل، ثنا إسحاق بن سليمان، عن أبي سنان، عن عمر بن الخطاب، قال: " الصبر صبران: صبر عند المصيبة حسن وأفضل منه، الصبر عن محارم الله " وروي عن الحسن نحو قول عمر(@)(@@) PageV05P1539(@)(@@) حدثنا أبي، ثنا عبدة بن سليمان المروزي، أنبأ ابن المبارك، أنبأ ابن لهيعة، عن عطاء بن دينار، أن سعيد بن جبير قال: «الصبر اعتراف العبد لله بما أصاب 
ms1334	 منه واحتسابه عند الله رجاء ثوابه، وقد يجزع الرجل وهو متجلد لا يرى منه إلا الصبر»(@)(@@) PageV05P1539(@)(@@)(@@)(@@) | قوله تعالى: {إن الأرض لله يورثها من يشاء من عباده} (@)(@@) [الأعراف: 128](@)(@@) PageV05P1539(@)(@@) حدثنا أبي، ثنا أبو صالح، كاتب الليث، حدثني الليث، حدثني أبي، ثنا عيسى بن حماد التجيي، ثنا الليث، عن 3280 سعيد بن أبي سعيد المقبري، عن أبيه، عن أبي هريرة، قال: فبينما نحن في المسجد إذ خرج علينا رسول الله صلى الله عليه وسلم فقال: «انطلقوا إلى اليهود» . فخرجنا معه حتى جئنا المدارس. فقام وناداهم فقال في الثالثة:، «اعلموا إنما الأرض لله ولرسوله، وأني أريد أن أخرجكم من هذه الأرض»(@)(@@) PageV05P1539(@)(@@)(@@)(@@) | قوله تعالى: {والعاقبة للمتقين} (@)(@@) [الأعراف: 128](@)(@@) PageV05P1539(@)(@@) حدثنا أحمد بن سنان، ثنا أبو النضر هاشم بن القاسم، ثنا أبو عقيل عبد الله بن عقيل، عن عبد الله بن يزيد، عن ربيعة بن يزيد، وعطية بن قيس، عن عطية السعدي، وكان، من أصحاب رسول الله صلى الله عليه وسلم قال: قال رسول الله صلى الله عليه وسلم: «لا يكون الرجل من المتقين حتى يدع ما لا بأس به حذرا لما به البأس»(@)(@@) PageV05P1539(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1540(@)(@@) حدثنا أبي، ثنا عبد الله بن عمران، ثنا إسحاق بن سليمان الرازي، عن المغيرة بن مسلم، عن ميمون أبي حمزة، قال: " كنت جالسا عند أبي وائل فدخل علينا رجل، يقال له: أبو عفيف من أصحاب معاذ، فقال له شقيق بن سلمة: يا أبا عفيف من أصحاب معاذ، فقال له شقيق بن سلمة: يا أبا عفيف ألا تحدثنا، عن معاذ بن جبل، قال بلى: سمعته يقول: " يحبس الناس يوم القيامة في بقيع واحد فينادي مناد أين المتقون؟ فيقومون في كنف من الرحمن، لا يحتجب الله عز وجل منهم ولا يستتر، قلت: من المتقون؟، قال: قوم اتقوا الشرك، وعبادة الأوثان، وأخلصوا لله العبادة، فيمرون إلى الجنة "(@)(@@) PageV05P1540(@)(@@)(@@)(@@) | الوجه الثالث(@)(@@) PageV05P1540(@)(@@) حدثنا محمد بن يحيى، ثنا أبو غسان محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن إسحاق، قال: فيما حدثني محمد بن أبي محمد، مولى زيد 
ms1335	 بن ثابت، عن عكرمة أو سعيد بن جبير، عن ابن عباس، «يقول الله سبحانه وبحمده للمتقين أي الذين يحذرون من الله عقوبته في ترك ما يعرفون من الهدى ويرجون رحمته بالتصديق بما جاء منه»(@)(@@) PageV05P1540(@)(@@)(@@)(@@) | والوجه الرابع(@)(@@) PageV05P1540(@)(@@) حدثنا أبو زرعة، ثنا عمرو بن حماد، ثنا أسباط، عن السدي، " {للمتقين} [الأعراف: 128] ، قال: هم المؤمنون "(@)(@@) PageV05P1540(@)(@@)(@@)(@@) | قوله تعالى: {قالوا أوذينا من قبل أن تأتينا} (@)(@@) [الأعراف: 129](@)(@@) PageV05P1541(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {من قبل أن تأتينا} [الأعراف: 129] قبل إرسال الله إياك "(@)(@@) PageV05P1541(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1541(@)(@@) حدثنا أبو زرعة، ثنا عبد الله بن سعد بن إبراهيم، ثنا الحسن بن موسى الأشيب، ثنا حماد، عن أبي سنان، عن وهب بن منبه، في قوله: " {أوذينا من قبل أن تأتينا} [الأعراف: 129] ، قال: قالت بنو إسرائيل لموسى: كان فرعون يكلفنا اللبن من قبل أن تأتينا "(@)(@@) PageV05P1541(@)(@@)(@@)(@@) | قوله تعالى: {ومن بعد ما جئتنا} (@)(@@) [الأعراف: 129](@)(@@) PageV05P1541(@)(@@) حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، يعني قوله: " {ومن بعد ما جئتنا} [الأعراف: 129] ، قال: من بعد إرسال الله إياك "(@)(@@) PageV05P1541(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1541(@)(@@) حدثنا أبي، ثنا عبد الله بن سعد بن إبراهيم، ثنا الحسن بن موسى الأشيب، ثنا حماد، عن أبي سنان، عن وهب بن منبه، " في هذه الآية {ومن بعد ما جئتنا} [الأعراف: 129] ، قالت بنو إسرائيل لموسى: كان فرعون يكلفنا اللبن قبل أن تأتينا، فلما جئت كلفنا اللبن مع التبن أيضا فقال موسى: أي رب أهلك فرعون، حتى متى تبقيه فأوحى الله عز وجل إليه إنهم لم يعملوا الذنب الذي أهلكهم به "(@)(@@) PageV05P1541(@)(@@)(@@)(@@) | قوله تعالى: {قال عسى ربكم أن يهلك} (@)(@@) [الأعراف: 129](@)(@@) PageV05P1541(@)(@@) حدثنا علي بن الحسين، ثنا أحمد بن عبد الرحمن الدشتكي، من كتابه، حدثني أبي، عن أبيه، ثنا أبي، عن علي بن علي قاضي الري، عن عمر بن قيس، عن جابر، عن تميم بن حذلم، قال: سمعت عبد الله بن عباس، يقول: إن رسول الله صلى الله عليه وسلم، قال: «إن بنا أهل البيت يفتح ويختم» فلابد 
ms1336	 أن تقع دولة بني هاشم، فانظروا فيمن تكونوا من بني هاشم وفيم نزلت {عسى ربكم أن يهلك عدوكم ويستخلفكم في الأرض فينظر كيف تعملون} [الأعراف: 129] "(@)(@@) PageV05P1541(@)(@@)(@@)(@@) | قوله تعالى: {ولقد أخذنا آل فرعون} (@)(@@) [الأعراف: 130](@)(@@) PageV05P1542(@)(@@) حدثنا محمد بن يحيى، أنبأ العباس، أنبأ يزيد، عن سعيد، عن قتادة، قوله: " {ولقد أخذنا آل فرعون بالسنين} [الأعراف: 130] جهدهم الله بالسنين بالجوع عاما فعاما، ونقص من الثمرات، فأما السنون فكان ذلك في باديتهم، وأهل مواشيهم، وأما نقص الثمرات فكان في أمصارهم وقراهم "(@)(@@) PageV05P1542(@)(@@)(@@)(@@) | قوله تعالى: {بالسنين} (@)(@@) [الأعراف: 130](@)(@@) PageV05P1542(@)(@@) حدثنا أبي، ثنا عمرو بن عون، أنبأ شريك، عن أبي إسحاق، عن أبي عبيدة، عن عبد الله، في قوله: " {ولقد أخذنا آل فرعون بالسنين} [الأعراف: 130] ، قال: سنين الجوع "(@)(@@) PageV05P1542(@)(@@) حدثنا أبي، ثنا محمد بن عمران بن أبي ليلى، ثنا بشر، عن أبي روق، عن الضحاك، عن ابن عباس، قال: " لما أخذ الله آل فرعون بالسنين يبس كل شجر لهم وذهبت مواشيهم حتى يبس نيل مصر واجتمعوا إلى فرعون، فقالوا له: إن كنت تزعم كما تزعم فآتينا في نيل مصر بماء، قال: غدوة يصبحكم الماء، فلما خرجوا من عنده، قال: أي شيء صنعت، أنا أقدر على أن أجري في نيل مصر ماء، غدوة أصبح فيكذبوني، فلما كان في جوف الليل قام واغتسل ولبس مدرعة صوف، ثم خرج ماشيا حتى أتى نيل مصر، فقام في بطنه فقال: اللهم إنك تعلم أني أعلم أنك تقدر على أن تملأ نيل مصر ماء فاملأه ماء، فما علم إلا بجرير الماء يقبل، فخرج يحفز وأقبل النيل يزخ بالماء لما أراد الله بهم من الهلكة "(@)(@@) PageV05P1542(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV05P1542(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {السنين} [الأعراف: 130] الجوايح "(@)(@@) PageV05P1542(@)(@@)(@@)(@@) | قوله تعالى: {ونقص من الثمرات} (@)(@@) [الأعراف: 130](@)(@@) PageV05P1542(@)(@@) حدثنا أبي، ثنا عبد الله بن رجاء، أنبأ شيبان، عن أبي إسحاق، عن رجاء بن حيوة، " {ونقص من الثمرات} [الأعراف: 130] ، قال: حتى لا تحمل النخلة إلا بسرة واحدة "(@)(@@) PageV05P1542(@)(@@) حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، 
ms1337	 عن مجاهد، " {ونقص من الثمرات} [الأعراف: 130] دون ذلك يعني دون الجائحة "(@)(@@) PageV05P1543(@)(@@)(@@)(@@) | قوله تعالى: {فإذا جاءتهم الحسنة} (@)(@@) [الأعراف: 131](@)(@@) PageV05P1543(@)(@@) وبه، عن مجاهد، " {فإذا جاءتهم الحسنة} [الأعراف: 131] العافية والرخاء "(@)(@@) PageV05P1543(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قوله: " {فإذا جاءتهم الحسنة} [الأعراف: 131] ، قال: الحسنة ما يحبون "(@)(@@) PageV05P1543(@)(@@)(@@)(@@) | قوله تعالى: {قالوا لنا هذه} (@)(@@) [الأعراف: 131](@)(@@) PageV05P1543(@)(@@) حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، " {قالوا لنا هذه} [الأعراف: 131] ونحن أحق بها "(@)(@@) PageV05P1543(@)(@@)(@@)(@@) | قوله تعالى: {وإن تصبهم سيئة} (@)(@@) [النساء: 78](@)(@@) PageV05P1543(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قوله: " {وإن تصبهم سيئة} [النساء: 78] ، قال: إذا كان ما يكرهون قالوا: إنما أصابنا هذا بشؤم هؤلاء الذين بين أظهرنا، كما قال قوم صالح: إنا تطيرنا بك وبمن معك. فقال الله: {طائركم عند الله بل أنتم قوم تفتنون} [النمل: 47] "(@)(@@) PageV05P1543(@)(@@)(@@)(@@) | قوله تعالى: {يطيروا بموسى ومن معه} (@)(@@) [الأعراف: 131](@)(@@) PageV05P1543(@)(@@) حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {يطيروا بموسى ومن معه} [الأعراف: 131] ، تشائموا بموسى صلى الله عليه وسلم "(@)(@@) PageV05P1543(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ، قال: سمعت عبد الرحمن بن زيد، في قوله: " {وإن تصبهم سيئة يطيروا بموسى ومن معه} [الأعراف: 131] قالوا: ما أصابنا هذا الشر إلا بك يا موسى ومن معك، وما رأينا شرا ولا أصابنا حتى رأيناك "(@)(@@) PageV05P1543(@)(@@)(@@)(@@) | قوله تعالى: {ألا إنما طائرهم عند الله} (@)(@@) [الأعراف: 131](@)(@@) PageV05P1543(@)(@@) أخبرنا أحمد بن الأزهر بن منيع، فيما كتب إلي، ثنا وهب بن جرير، ثنا أبي، عن علي بن الحكم، عن الضحاك، في قوله: " {طائركم عند الله} [النمل: 47] يقول: الأمر من قبل الله ما أصابكم من أمر الله فمن الله فبما كسبت أيديكم "(@)(@@) PageV05P1543(@)(@@)(@@)(@@) | قوله تعالى: {وقالوا مهما تأتنا به من آية} (@)(@@) [الأعراف: 132](@)(@@) PageV05P1544(@)(@@) حدثنا علي بن الحسين، ثنا المقدمي، ثنا حصين بن نمير، ثنا سفيان بن حسين، " {مهما تأتنا به من آية} [الأعراف: 132] مهما تأتنا به 
ms1338	 من شيء لتسحرنا بها "(@)(@@) PageV05P1544(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، يقول: في قول الله: " {مهما تأتنا به من آية} [الأعراف: 132] قال: إن ما تأتنا به من آية قال: وهذه فيها زيادة ما "(@)(@@) PageV05P1544(@)(@@)(@@)(@@) | قوله تعالى: {فأرسلنا عليهم} (@)(@@) [الأعراف: 133](@)(@@) PageV05P1544(@)(@@) حدثنا أبي، ثنا عبد العزيز بن منيب، ثنا أبو معاذ، عن عبيد بن سليمان، عن الضحاك، " {فأرسلنا عليهم الطوفان} [الأعراف: 133] ، قال: أمطر الله عليهم السماء حتى امتنع عنهم كل شيء "(@)(@@) PageV05P1544(@)(@@)(@@)(@@) | قوله تعالى: {الطوفان} (@)(@@) [الأعراف: 133](@)(@@) PageV05P1544(@)(@@) حدثنا أبي، ثنا ابن الأصبهاني، أنبأ يحيى بن يمان، عن المنهال بن خليفة، عن الحجاج، عن الحكم بن مينا، عن عائشة، عن النبي صلى الله عليه وسلم قال: " الطوفان: الموت "(@)(@@) PageV05P1544(@)(@@) وحدثنا أبي، ثنا الحماني، ثنا يحيى بن يمان، عن المنهال بن خليفة، عن عطاء، عن عائشة، عن النبي صلى الله عليه وسلم قال: " الطوفان: الموت "(@)(@@) PageV05P1544(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1544(@)(@@) حدثنا أبو زرعة، ثنا منجاب بن الحارث، أنبأ بشر بن عمارة، عن أبي روق، عن الضحاك، عن ابن عباس، قوله: " {فأرسلنا عليهم الطوفان} [الأعراف: 133] ، قال: مطروا بالليل والنهار ثمانية أيام " وروي، عن أبي مالك، والضحاك، وقتادة أنه الماء، وروي عن سعيد بن جبير، والسدي قالا: المطر(@)(@@) PageV05P1544(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1544(@)(@@) حدثنا أبي، ثنا يحيى بن المغيرة، ثنا جرير، عن قابوس، عن أبيه، عن ابن عباس، قال: " {الطوفان} [الأعراف: 133] أمر من أمر ربك، ثم قرأ {فطاف عليها طائف من ربك} [القلم: 19] "(@)(@@) PageV05P1544(@)(@@)(@@)(@@) | والوجه الرابع(@)(@@) PageV05P1545(@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو عبد الرحمن الحارثي، عن جويبر، عن الضحاك، قال: «الغرق»(@)(@@) PageV05P1545(@)(@@)(@@)(@@) | والوجه الخامس(@)(@@) PageV05P1545(@)(@@) ذكر، عن أبي عاصم، عن عيسى بن أبي نجيح، عن مجاهد: «الطوفان، الماء والطاعون»(@)(@@) PageV05P1545(@)(@@) حدثنا أبي، ثنا أبو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {فأرسلنا عليهم الطوفان} [الأعراف: 133] وهو المطر حتى خافوا الهلاك فأتوا موسى، قالوا يا موسى: ادع لنا ربك يكشف عنا المطر فإنا نؤمن لك ونرسل معك بني إسرائيل، فدعا 
ms1339	 ربه فكشف عنهم المطر، فأنبت الله حرثهم، وأخصبت بلادهم، فقالوا: ما نحب أنا لم نمطر فلن نترك آلهتنا، ولن نؤمن لك، ولن نرسل معك بني إسرائيل، فأرسل الله عز وجل عليهم الجراد "(@)(@@) PageV05P1545(@)(@@) حدثنا أبي، ثنا محمد بن وهب بن عطية الدمشقي، ثنا الهيثم ابن عمران العبسي، قال: سمعت إسماعيل بن عبيد الله، يقول: «كان الطوفان الذي أصاب الناس في نيسان»(@)(@@) PageV05P1545(@)(@@)(@@)(@@) | قوله تعالى: {والجراد} (@)(@@) [الأعراف: 133](@)(@@) PageV05P1545(@)(@@) حدثنا أبي، ثنا أبو صالح، حدثني معاوية بن صالح، عن علي بن أبي طلحة، عن ابن عباس، قوله: " {والجراد} [الأعراف: 133] ، قال: فأرسل الله عليهم الجراد فأسرع في فساد ثمارهم وزروعهم، قالوا: يا موسى، ادع لنا ربك يكشف عنا الجراد، فإنا سنؤمن لك: ونرسل معك بني إسرائيل، فدعا ربه فكشف عنهم الجراد، وكان قد بقي لهم من زرعهم ومعايشهم بقايا، فقالوا: قد بقي لنا ما هو كافينا، فلن نؤمن لك ولن نرسل معك بني إسرائيل "(@)(@@) PageV05P1545(@)(@@) حدثنا علي بن الحسين، ثنا عثمان بن أبي شيبة، ثنا جرير، عن يعقوب، عن جعفر، عن سعيد بن جبير، عن ابن عباس، قال: " فقالوا: " يا موسى ادع لنا ربك يكشف عنا المطر فنؤمن لك، ونرسل معك بني إسرائيل، فدعا ربه فكشف الله عنهم(@)(@@)(@@)(@@) | [ص: 1546](@)(@@) المطر، قال: فأنبت الله لهم في تلك السنة شيئا لم ينبته قبل ذلك من الزرع، والكلإ، والثمر، فقالوا: هذا ما كنا نتمنى فأرسل الله عليهم الجراد فسلطه على الكلإ فلما رأوا أثره في الكلأ، عرفوا أنه لا يبقي الزرع، قالوا: يا موسى ادع لنا ربك يكشف عنا الجراد، فنؤمن لك، ونرسل معك بني إسرائيل، فدعا ربه، فكشف عنهم الجراد، فداسوا فأحرزوا في البيوت، فقالوا: قد أحرزنا "(@)(@@) PageV05P1545(@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {فأرسلنا عليهم الطوفان والجراد} [الأعراف: 133] ، قال: والجراد تأكل مسامير زنجهم يعني أبوابهم وثيابهم "(@)(@@) PageV05P1546(@)(@@) حدثنا أبي، ثنا عبد العزيز بن منيب بن معاذ، عن عبيد بن سليمان، عن الضحاك، قوله: " {والجراد} [الأعراف: 133] فأرسل الله عليهم الجراد الذي لا 
ms1340	 أجنحة له فتتبع ما بقي من حروفهم وشجرهم، وسائر نباتهم "(@)(@@) PageV05P1546(@)(@@) حدثنا المنذر بن شاذان، ثنا يعلى، ثنا سفيان، عن أبي خالد، عن ابن عباس، قال: " {الجراد} [الأعراف: 133] : نثرة من حوت في البحر "(@)(@@) PageV05P1546(@)(@@)(@@)(@@) | قوله تعالى: {والقمل} (@)(@@) [الأعراف: 133](@)(@@) PageV05P1546(@)(@@) حدثنا أبي، ثنا مسلم بن إبراهيم، ثنا عبد الوارث، ثنا عامر الأحول، عن عكرمة، عن ابن عباس، " قول الله {والقمل} [الأعراف: 133] ، قال: هو الدبا "(@)(@@) PageV05P1546(@)(@@) حدثنا أبو زرعة، ثنا منجاب بن الحارث، أنبأ بشر بن عمارة، عن أبي روق، عن الضحاك، عن ابن عباس، في قوله: " {والقمل} [الأعراف: 133] ، قال: الجراد الذب ليس له أجنحة وهو الدبى " وروي عن الضحاك، وقتادة، وسعيد بن جبير، وعطاء الخراساني مثل ذلك(@)(@@) PageV05P1546(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV05P1547(@)(@@) حدثنا علي بن الحسين، ثنا عثمان بن أبي شيبة، ثنا جرير، عن يعقوب، عن جعفر، عن سعيد بن جبير، عن ابن عباس: " فأرسل الله عليهم القمل: وهو هذا السوس الذي يخرج من الحنطة، فكان الرجل يخرج بالحنطة عشرة أجربة إلى الرحى فلا يرد منها بثلاثة أقفزة قالوا: يا موسى ادع لنا ربك يكشف عنا هذا القمل، فنرسل معك بني إسرائيل، فدعا ربه، فكشف عنهم، فأبوا أن يرسلوا معه بني إسرائيل "(@)(@@) PageV05P1547(@)(@@)(@@)(@@) | والوجه الثالث(@)(@@) PageV05P1547(@)(@@) حدثنا أبي، ثنا مسلم بن إبراهيم، ثنا عبد الوارث، ثنا عامر الأحول، قال: وقال الحسن: " هو القمل يعني قوله: {القمل} [الأعراف: 133] " وروي، عن زيد بن أسلم مثل ذلك(@)(@@) PageV05P1547(@)(@@)(@@)(@@) | والوجه الرابع(@)(@@) PageV05P1547(@)(@@) حدثنا علي بن الحسن الهسنجاني، ثنا سعيد بن الحكم بن أبي مريم، ثنا مفضل، حدثني أبو صخر، أنه قال: " {القمل} [الأعراف: 133] : الجراد الذي يطير " وروي، عن عكرمة أنه قال: القمل بنات الجراد(@)(@@) PageV05P1547(@)(@@)(@@)(@@) | الوجه الخامس(@)(@@) PageV05P1547(@)(@@) أخبرنا عمرو بن ثور القيساري، فيما كتب إلي، ثنا الفريابي، ثنا قيس بن الربيع، عن سعيد بن مسروق، عن حبيب بن أبي ثابت، قال: " {القمل} [الأعراف: 133] الجعلان "(@)(@@) PageV05P1547(@)(@@)(@@)(@@) | والوجه السادس(@)(@@) PageV05P1547(@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، يقول: في قول الله: " {فأرسلنا عليهم الطوفان والجراد والقمل والضفادع} [الأعراف: 133] ، قال: 