ms81	 صفة الموصوف بالقدم % % 169(@)(@@) % لم تقترن بزمان وهي تخبرنا % % أخبار حق علا عن وصمة التهم % % 170(@)(@@) % عن كل آت وماض نص معلمها % % عن المعاد وعن عاد وعن إرم % % PageV01P282 171(@)(@@) % دامت لدينا ففاقت كل معجزة % % للمرسلين وبرهان لحزبهم % % 172(@)(@@) % لا تنقضي كصنوف المعجزات مضت % % من النبيين إذ جاءت ولم تدم % % 173(@)(@@) % محكمات فما يبقين من شبه % % لما حكمن به من محكم الحكم % % 174(@)(@@) % ولا يدعن طريقا في محاكمة % % لذي شقاق ولا يبغين من حكم % % 175(@)(@@) % ما حوربت قط إلا عاد من حرب % % وليها صابغا أعداءه بدم % % 176(@)(@@) % ما غولبت في وغى إلا رأيت به % % أعدى الأعادي إليها ملقي السلم % % 177(@)(@@) % ردت بلاغتها دعوى معارضها % % بعد البلاغ رفيق الحزن والسدم % % 178(@)(@@) % وردت الجاحد المحتج حجتها % % رد الغيور يد الجاني عن الحرم % % 179(@)(@@) % لها مكان كموج البحر في مدد % % يرمي بفوجين منهل ومنسجم % % 180(@)(@@) % ففوق سلطانه سلطان حكمتها % % وفوق جوهره في الحسن والقيم % % PageV01P283 181(@)(@@) % فما تعد ولا تحصى عجائبها % % كأنها طالعات الزهر في الظلم % % 182(@)(@@) % فلا تمس يد الإقلال رونقها % % ولا تسام على الإكثار بالسأم % % 183(@)(@@) % قرت بها عين قاريها فقلت له % % قر بالأمان وفي ظل بالنبي نم % % 184(@)(@@) % وقم دجى الليل واقرأ حزبها فيها % % لقد ظفرت بحبل الله فاعتصم % % 185(@)(@@) % إن تتلها خيفة من حر نار لظى % % أمنت لا ريب من نار ومن ضرم % % 186(@)(@@) % وإن ذكرت بها الرحمن متثقا % % أطفأت حر لظى من وردها الشيم % % 187(@)(@@) % كأنها الحوض تبيض الوجوه به % % يوم القدوم على خلاقها الحكم % % 188(@)(@@) % تحيي به أنفس يزهي عناصرها % % من العصاة وقد جاؤه كالحمم % % 189(@)(@@) % وكالصراط وكالميزان معدلة % % حكما على ما مضى في اللوح والقلم % % 190(@)(@@) % مصونة من غبار الظلم طاهرة % % فالقسط في غيرها للناس لم يقم % % PageV01P284 191(@)(@@) % لا تعجبن لحسود راح ينكرها % % إن الحسود عدو الفضل والنعم % % 192(@)(@@) % رآى هداها وأغضى غير مكترث % % تجاهلا وهو عين الحاذق الفهم % % 193(@)(@@) % قد تنكر العين ضوء الشمس من رمد % % وينكر الشيخ فعل الكهل من هرم % % 194(@)(@@) % وينكر الأكمه الأشكال من 
ms82	 كمه % % وينكر الفم طعم الماء من سقم % % 195(@)(@@) % يا خير من يمم العافون ساحته % % وأمه زمر القصاد لتكرم % % 196(@)(@@) % وحج أبطال أهل الله مرقده % % سعيا وفوق متون الانيق الرسم % % 197(@)(@@) % ومن هو الآية الكبرى لمعتبر % % ومن هو الملجأ الأعلى لمعتصم % % 198(@)(@@) % ومن هو المنة الوفرى لمفتقر % % ومن هو النعمة العظمى لمغتنم % % 199(@)(@@) % سريت من حرم ليلا إلى حرم % % إلى مقام علا عن فكرة الهمم % % 200(@)(@@) % وسرت تكشف سر الأفق مرتفعا % % كما سرى البدر في داج من الظلم % % PageV01P285 201(@)(@@) % وبت ترقى إلى أن نلت منزلة % % لم ترق بالوهم فضلا عن قوى القدم % % 202(@)(@@) % منيعة برحاب القدس دانية % % من قاب قوسين لم تدرك ولم ترم % % 203(@)(@@) % وقدمتك جميع الأنبياء بها % % كما تقدمتهم في عالم القدم % % 204(@)(@@) % ذا في النبيين تقديم أبنت به % % والرسل تقديم مخدوم على خدم % % 205(@)(@@) % وأنت تخترق السبع الطباق بهم % % سلطان كبكبة سارت بجندهم % % 206(@)(@@) % ضمن السرادق والأنوار مطبقة % % في موكب كنت فيه صاحب العلم % % 207(@)(@@) % حتى إذا لم تدع شأوا لمستبق % % في مصدر وورود من صدورهم % % 208(@)(@@) % ولا تركت مقاما يستقر به % % من الدنو ولا مرقى لمستنم % % 209(@)(@@) % خفضت كل مقام بالإضافة إذ % % فتحت باب الهدى فردا بجمعهم % % 210(@)(@@) % جزمت ميم المنى عن لاحقيك كما % % نوديت بالرفع مثل المفرد العلم % % PageV01P286 211(@)(@@) % كما تفوز بوصل أي مستتر % % عن علم كل عليم من فحولهم % % 212(@)(@@) % وكي ترى نور قدس أي محتجب % % عن العيون وسر أي مكتتم % % 213(@)(@@) % فحزت كل فخار غير مشترك % % وكل سهم نوال غير مقتسم % % 214(@)(@@) % وطلت كل مطال غير مطلع % % وجزت كل مقام غير مزدحم % % 215(@)(@@) % وجل مقدار ما وليت من رتب % % شم وأوليت من عفو لمجترم % % 216(@)(@@) % وأعظم الله ما أدركت من عظم % % وعز إدراك ما أوليت من نعم % % 217(@)(@@) % بشرى لنا معشر الإسلام إن لنا % % مواهبا فوق حصر الخط والرقم % % 218(@)(@@) % بنى لنا الله بالمختار سيدنا % % من العناية ركنا غير منهدم % % 219(@)(@@) % لما دعى الله داعينا لطاعته % % ونحن سرنا بذاك الإثر والقدم % % 220(@)(@@) % واحكم الله 
ms83	 فينا حكم سنته % % بأكرم الرسل كنا أكرم الأمم % % PageV01P287 221(@)(@@) % راعت قلوب العدا أنباء بعثته % % بطارق من أفانين القضا صدم % % 222(@)(@@) % جاءتهمو فأخافتهم طوارقها % % كنبأة أجفلت غفلا من الغنم % % 223(@)(@@) % ما زال يلقاهم في كل معترك % % يرد كيدهم فيه لنحرهم % % 224(@)(@@) % يدير فيهم مناياهم ويصرعهم % % حتى حكوا بالقنا لحما على وضم % % 225(@)(@@) % ودوا الفرار وكادوا يغبطون به % % قرون قوم عفوا من شر أهلهم % % 226(@)(@@) % تظنهم وخيول الله تلحقهم % % أشلاء شالت مع العقبان والرخم % % 227(@)(@@) % تمضي الليالي ولا يدرون عدتها % % لما بهم من توالي نار حربهم % % 228(@)(@@) % كأن تلك الليالي لا تمر بهم % % ما لم تكن من ليالي الاشهر الحرم % % 229(@)(@@) % كأنما الدين ضيف حل ساحتهم % % فهد ركنا منيعا من مشيدهم % % 230(@)(@@) % وجاءهم ولواء النصر يقدمه % % كل قرم إلى لحم العدا قرم % % PageV01P288 231(@)(@@) % يجر بحر خميس فوق سابحة % % بفتكة فول فتك الصارم الخذم % % 232(@)(@@) % يجري بسيال آساد مدرعة % % يرمي بموج من الأبطال ملتطم % % 233(@)(@@) % من كل منتدب لله محتسب % % رام بسهم بنار البأس مضطرم % % 234(@)(@@) % يصول كالقدر المنقض من أفق % % يسطو بمستأصل للكفر مصطلم % % 235(@)(@@) % حتى غدت ملة الإسلام وهي بهم % % في مشهد شامخ الأركان محترم % % 236(@)(@@) % عزيزة بحصون السعد ريضة % % من بعد غربتها موصولة الرهم % % 237(@)(@@) % مكفولة ابدا منهم بخير أب % % وخير عم كريم الطور والشيم % % 238(@)(@@) % وخير إلف غيور من ذوي حسب % % وخير بعل فلم تيتم ولم تئم % % 239(@)(@@) % هم الجبال فسل عنهم مصادمهم % % وهم على الشهب من باد وملتثم % % 240(@)(@@) % يوم العراك ونار الموت شاعلة % % ماذا رآى منهم في كل مصطدم % % PageV01P289 241(@)(@@) % وسل حنينا وسل بدرا وسل أحدا % % وخيبرا يوم هدوا ركن خصمهم % % 242(@)(@@) % وسل حصونا دعوها لا رسوم لها % % فصول حتف لهم أدهى من الوخم % % 243(@)(@@) % ألمصدري البيض حمرا بعد ما وردت % % عيون أوداج قوم من عدوهم % % 244(@)(@@) % ألموردي الزان كالبرق الملح دجى % % من العدى كل مسود من اللمم % % 245(@)(@@) % والكاتبين بسمر الخط ما تركت % % اكفهم صحفا إلا لدينهم % % 246(@)(@@) % لم تبق في كل جلد من معارضهم % % أقلامهم 
ms84	 حرف جسم غير منعجم % % 247(@)(@@) % شاكي السلاح لهم سيما تميزهم % % أكرم بذي رأفة بالفتك متسم % % 248(@)(@@) % قد مازهم باجتثاث الظلم عدلهم % % والورد يمتاز بالسيما عن السلم % % 249(@)(@@) % تهدي إليك رياح النصر نشرهم % % فيملأ الكون طيبا طيب نشرهم % % 250(@)(@@) % يمر عسكرهم والفتح يكنفه % % فتحسب الزهر في الأكمام كل كمي % % PageV01P290 251(@)(@@) % كأنهم في ظهور الخيل نبت ربى % % أو كالرواسي بناها طول حزمهم % % 252(@)(@@) % رسوا على الجرد أوتادا مطنبة % % من شدة الحزم لا من شدة الحزم % % 253(@)(@@) % طارت قلوب العدا من بأسهم فرقا % % أجل على الضد سم مس بأسهم % % 254(@)(@@) % راعوا عقول أعاديهم بسطوتهم % % فما تفرق بين البهم والبهم % % 255(@)(@@) % ومن تكن برسول الله نصرته % % فذاك لا شك من كل الهموم حمي % % 256(@)(@@) % تراه والنصر يجلى فوق جبهته % % إن تلقه الأسد في آجامها تجم % % 257(@)(@@) % فلن ترى من ولي غير منتصر % % بجاهه ضمن حصن أي معتصم % % 258(@)(@@) % ولا محب صدوق غير متصل % % به ولا من عدو غير منقصم % % 259(@)(@@) % أحل أمته في حرز ملته % % وصانهم وكفاهم شر وزرهم % % 260(@)(@@) % تراه وهو بهم في سوح رأفته % % كالليث حل مع الأشبال في الأجم % % PageV01P291 261(@)(@@) % كم جدلت كلمات الله من جدل % % ذي منطق فيه حتى صار كالبكم % % 262(@)(@@) % وكم أقيمت براهين لمعتقد % % فيه وكم خصم البرهان من خصم % % 263(@)(@@) % كفاك بالعلم في الأمي معجزة % % عظيمة هي فوق العلم بالعظم % % 264(@)(@@) % جلته بدارا زها بالفضل أبرزه % % في الجاهلية والتأديب في اليتم % % 265(@)(@@) % خدمته بمديح أستقيل به % % وزرا كساني من فرعي إلى قدمي % % 266(@)(@@) % وأمحون بذكري نور طلعته % % ذنوب عمر مضى في الشعر والخدم % % 267(@)(@@) % إذ قلداني ما تخشى عواقبه % % من حمل جرم به أصبحت لم أقم % % 268(@)(@@) % وقيداني بقيد منهما وأنا % % كأنني بهما هدي من النعم % % 269(@)(@@) % أطعت غي الصبا في الحالتين وما % % صحوت إلا على أثقال مجترم % % 270(@)(@@) % وراح وقتي سدى في المذهبين وهل % % حصلت إلا على الآثام والندم % % PageV01P292 271(@)(@@) % فيا خسارة نفس في تجارتها % % تبغي المكاسب كالسارين في الحلم % % 272(@)(@@) % طاشت فلا رأس مال تقتنيه 
ms85	 كما % % لم تشتر الدين بالدنيا ولم تسم % % 273(@)(@@) % ومن يبغ آجلا منه بعاجله % % هو الذي استبدل الأنوار بالظلم % % 274(@)(@@) % وبعد كشف غطاء عن بصيرته % % يبن له الغبن في بيع وفي سلم % % 275(@)(@@) % إن آت ذنبا فما عهدي بمنتقض % % من الرسول ولا وجهي بمهتضم % % 276(@)(@@) % ولا ولائي وميثاقي بمنقطع % % من النبي ولا حبلي بمنصرم % % 277(@)(@@) % فإن لي ذمة منه بتسميتي % % بإسمه وإليه ينتهي رحمي % % 278(@)(@@) % أبو الهدى كنيتي والإسم أذكره % % محمدا وهو أوفى الخلق بالذمم % % 279(@)(@@) % إن لم تكن في معادي آخذا بيدي % % وراحمي يا عنا قلبي ويا ندمي % % 280(@)(@@) % وإن تكن لم تقلني عثرتي بغد % % فضلا وإلا فقل يا زلة القدم % % PageV01P293 281(@)(@@) % حاشاه أن يحرم الراجي مكارمه % % ومنه في الخلق فاضت أبحر الكرم % % 282(@)(@@) % أنى يرى عبده ردا بساحته % % أو يرجع الجار منه غير محترم % % 283(@)(@@) % ومنذ ألزمت أفكاري مدائحه % % غنيت فيه عن الأنصار واللزم % % 284(@)(@@) % ومذ لزمت بصدقي باب منته % % وجدته لخلاصي خير ملتزم % % 285(@)(@@) % ولن يفوت الغنى منه يدا تربت % % ولا مواهبه تعدو أولي العدم % % 286(@)(@@) % تحيي قلوبا عفت أنواء رأفته % % إن الحيا ينبت الأزهار في الأكم % % 287(@)(@@) % ولم أرد زهرة الدنيا التي اقتطفت % % نفسيها أمم زلوا بمدحهم % % 288(@)(@@) % ولم أرم بدر الورق التي جمعت % % يدا زهير بما أثنى على هرم % % 289(@)(@@) % يا أكرم الخلق مالي من ألوذ به % % وصرت للضنك والأكاد كالعلم % % 290(@)(@@) % وليس لي إمام الرسل من سند % % سواك عند حلول الحادث العمم % % PageV01P294 291(@)(@@) % ولن يضيق رسول الله جاهك بي % % إن أبخس الخصم طيشا في الورى قيمي % % 292(@)(@@) % ولن أرى الضيم إن أوليتني نظرا % % إذا الكريم تحلى باسم منتقم % % 293(@)(@@) % فإن من جودك الدنيا وضرتها % % وأنت أكرم من يمشي على قدم % % 294(@)(@@) % فمن فهومك تفسير الكتاب بدا % % ومن علومك علم اللوح والقلم % % 295(@)(@@) % يا نفس لا تقنطى من زلة عظمت % % ولا زمى باب باب الله واعتصمى % % 296(@)(@@) % ولا تراعى وحسن الظن فادخري % % إن الكبائر في الغفران كاللمم % % 297(@)(@@) % يا رب فاجعل رجائي غير منعكس % % ومنك حبل 
ms86	 ظنوني غير منصرم % % 298(@)(@@) % واجعل سفاسف أعمالي منزهة % % لديك واجعل حسابي غير منخرم % % 299(@)(@@) % والطف بعبدك في الدارين إن له % % عزما على غير سوء الحال لم يقم % % 300(@)(@@) % أقام بالطبع تسويفا وأرفقه % % صبرا متى تدعه الأهوال ينهزم % % PageV01P295 301(@)(@@) % وأذن لسحب صلاة منك دائمة % % تسقي بيثرب قبر الطاهر الشيم % % 302(@)(@@) % ما رنحت عذبات البان ريح صبا % % وفاح من آل طه عطر ذكرهم % % 303(@)(@@) % تمدها أبحر التسليم وافدة % % على النبي بمنهل ومنسجم % % 304(@)(@@) % ما رنحت عذبات البان ريح صبا % % وفاح من آله طه عطر ذكرهم % % 305(@)(@@) % وأشبع الركب من مدح الصحاب شذا % % وأطرب العيس حادي العيس بالنغم % % PageV01P296 البحر : طويل 1(@)(@@) % لجأت بأعتاب الحبيب ابن هاشم % % إمام صدور المرسلين الأكارم % % 2(@)(@@) % منيع الحمى رب المعالي محمد % % رسول الرضا مفتاح كنز الغنائم % % 3(@)(@@) % سراج بطاح القبلتين وكوكب % % الوجود ومصباح الهدى للعوالم % % 4(@)(@@) % كتاب علوم الغيب كشاف مغلق % % الخفايا ملاذ العرب غوث الأعاجم % % 5(@)(@@) % دليل المصلين الكرام وسيلة % % الملبين مولى كل داع وصائم % % 6(@)(@@) % حبيب آله العالمين حقيقة % % الحقائق شمس الأنبياء الأعاظم % % 7(@)(@@) % له الموكب المسعود في الحشر واللقا % % له العلم المرفوع من قبل آدم % % 8(@)(@@) % له المدد الفياض والرفرف الذي % % له في ذرى العلياء أعلى الدعائم % % 9(@)(@@) % له الهيكل المكنوز علما وحكمة % % بحكمة علم من حكيم وعالم % % 10(@)(@@) % تجلت له أسرار كل حقيقة % % فحل معانيها بغير مزاحم % % PageV01P297 11(@)(@@) % وترجم ألواح الغيوب بمنطق % % بديع تندت فيه بيض العصائم % % 12(@)(@@) % معاليه لا تحصى وآيات فضله % % لقد هطلت من أفقه بالمكارم % % 13(@)(@@) % هو البحر بحر العلم والدين والتقى % % وبحر المعاني والهدى والمراحم % % 14(@)(@@) % فمظهره الأعلى وسلطان ذاته % % تسامي عن التعريف في شعر ناظم % % 15(@)(@@) % إليه انتهت آمال كل مؤمل % % وفي بابه تفريج كل العظائم % % 16(@)(@@) % نعم هو سلطان البرايا وأنه % % لجحفل رسل الله أشرف خاتم % % 17(@)(@@) % وسيد سادات الوجود وتاجهم % % وأعظمهم من كل ماض وقادم % % 18(@)(@@) % أناديه مولوع الفؤاد مهيما % % ودفتر أعمالي دجا بالجرائم % % 19(@)(@@) % وأني به أحسنت ظني وبحره % % بساحله العالي حصول المغائم % % 20(@)(@@) % وأسئله عطفا 
ms87	 على حالتي التي % % لها مقلتي سالت كسيل الغمائم % % PageV01P298 21(@)(@@) % فحاشاه أن يرضى بردي وبابه % % محط رحال القوم أهل العزائم % % 22(@)(@@) % عليه صلاة الله والآل كلهم % % وصحب وذي حب صميم وخادم % % PageV01P299 البحر : كامل تام 1(@)(@@) % عذر الكرام لئامة الأيام % % كم ظاهر الأيام ظهر لئام % % 2(@)(@@) % تهفو بتسلية الكرام هنيهة % % ولتلك أضغاث من الأحلام % % 3(@)(@@) % وكأنهم سقط المتاع فإن علوا % % سقطوا لطعان ورمية رام % % 4(@)(@@) % حرب مع الزمن المريع كأنما % % فيه وجودهم من الآثام % % 5(@)(@@) % عجبا تراه عليهم متهجما % % وعن الأسافل واللئام يحامى % % 6(@)(@@) % طارت مناقبهم فطبقت الورى % % وزمانهم عن نورها متعامى % % 7(@)(@@) % تبكى لهم مقل المعالي حسرة % % وتلهفا من كل جفن دام % % 8(@)(@@) % وتئن أفئدة وتزهق أنفس % % ما بين موج مدامع وضرام % % 9(@)(@@) % لله من هم الزمان فإنه % % أودت نوائبه بكل همام % % 10(@)(@@) % كم فيه من متخطىء عنق العلى % % خطأ ولولا النطق رب خطام % % PageV01P300 11(@)(@@) % أضحى دعي الفضل يعلف نعمة % % بشرا وفي المعنى من الأنعام % % 12(@)(@@) % ولكم فتى بالعلم سهم ثوبه % % هدفا أقيم لرشق كل سهام % % 13(@)(@@) % ولكم نقى خاض فيه ملوث % % وكساء بالإحرام ثوب حرامى % % 14(@)(@@) % هي تلك أحوال الزمان قديمة % % من عهد سام في الأيام وحام % % 15(@)(@@) % تقف العقول فلا تشق غبار ما % % صنع الزمان كليلة الأفهام % % 16(@)(@@) % وترد قافلة الرجا لمحمد % % شرف الوجود وصفوة العلام % % 17(@)(@@) % حلال دهم المشكلات بهمة % % نبوية منشورة الأعلام % % 18(@)(@@) % نور مذ انحبست لوامع ضوئه % % شق الهدى أستار كل ظلام % % 19(@)(@@) % ومحا الضلال بدينه ولقد أتى % % للعالمين برحمة الإسلام % % 20(@)(@@) % وأقام أركان العلى بشريعة % % كالراسيات متينة الإحكام % % PageV01P301 21(@)(@@) % حكم المهيمن نظمت بسلوكها % % فلذا انجلت وضاحة الأحكام % % 22(@)(@@) % والمرسلون به اقتدوا فإمامهم % % هو في محجتهم وأي إمام % % 23(@)(@@) % خدمته أملاك السما وتود لو % % مست بأعينها على الأقدام % % 24(@)(@@) % يا طالما انصرفت عوارف رأفة % % من ذلك المخدوم للخدام % % 25(@)(@@) % في كل طرفة طارف من فضله % % منن تجود بألف بحر طام % % 26(@)(@@) % لو لامس الواوي ظل وصيده % % لعدا بشوكته على الضرغام % % 27(@)(@@) % أو مس نار لظى شراك 
ms88	 نعاله % % لجرت بفيض الفضل والإنعام % % 28(@)(@@) % أو شم مضجعه بصدق أخرس % % لغدا بلا ريب فصيح كلام % % 29(@)(@@) % أين القلوب العارفات بقدره % % والأمر فوق تصور الأوهام % % 30(@)(@@) % أعي العقول فلن تحيط بوصفه % % دهرا ولو سمحت بكل نظام % % PageV01P302 31(@)(@@) % ضاقت صحاف الغيب في سفر العمى % % عنه فأين الرقم بالأقلام % % 32(@)(@@) % قامت بملك الله آية مدحه % % وسرت مع الأيام والأعوام % % 33(@)(@@) % وتبوأت بحبوحة العليا كما % % تتبوأ الأرواح بالأجسام % % 34(@)(@@) % برهان مظهره الشريف وحقه % % تعنو له الأخصام في الإفحام % % 35(@)(@@) % ما قمت أنشر فضله إلا وذقت % % حلاوة الإفحام للأخصام % % 36(@)(@@) % هو صاحب الأمر الإلهي الذي % % للحق هز كهزة الصمصام % % 37(@)(@@) % تنحط أسرار القلوب جلية % % في بابه الرحب المنيع السامي % % 38(@)(@@) % دارت بألسنة الملائك خطها % % قلم الجلال بأبدع الأرقام % % 39(@)(@@) % آياته نطقت فأخرس قولها % % الفصحاء من عرب ومن أعجام % % 40(@)(@@) % كم مرة خاض السهام مقابلا % % بيض النصول بوجهه البسام % % PageV01P303 41(@)(@@) % كدعامة الأقدار تحت عجاجه % % صلد العزيمة ثابت الأقدام % % 42(@)(@@) % في مشهد صعب المواقف زلزلت % % للخوف فيه ثوابت الأعلام % % 43(@)(@@) % والموت يقطر والكريهة نارها % % عبثت بكل ملثم مقدام % % 44(@)(@@) % وحمى حمى الدين المبين وصانه % % وكفى الشريعة غصة اللوام % % 45(@)(@@) % مولاي يا تاج النبيين الألى % % يا معدن الإحسان والإكرام % % 46(@)(@@) % يا من إذا عز الدواء مديحه % % فيه الشفاء لمعضل الأسقام % % 47(@)(@@) % يا من أدافع باسمه نوب العدا % % يا من أصول به على الأيام % % 48(@)(@@) % قسما بوجهك يا حماي وأنه % % من أعظم الأيمان والأقسام % % 49(@)(@@) % إني على حلو الزمان ومره % % ما حط إلا في حماك مرامي % % 50(@)(@@) % فانظر بعين اارفق لي وتولني % % وأغث إذا نقض الزمان زمامي % % PageV01P304 51(@)(@@) % أنا منك يا غوث اللهيف وإنني % % مع شؤم عيبي من ذوي الأرحام % % 52(@)(@@) % وإليك لي نسب تنظم سلكه % % من كل قطب جهبذ وإمام % % 53(@)(@@) % رام الجهول الخبل محو مفاخري % % وهل الضحى يمحوه سف قتام % % 54(@)(@@) % ولأنت عزي في الوجود وموئلي % % وحماك دار تنقلي ومقامي % % 55(@)(@@) % وقد انقطعت إليك متصلا ببحر % % مزبد بعميم فضلك طام % % 56(@)(@@) % فصل القطيع فقد دعاك بلوعة 
ms89	 % % يرجو القبول ولو بطيف منام % % 57(@)(@@) % كم كربة فتاكة فرجتها % % عن نادبيك فأصبحوا بسلام % % 58(@)(@@) % وكفيتهم وقطعت دابر ضدهم % % ونصرت خائفهم بحد حسام % % 59(@)(@@) % وأنا دعوتك سيدي متجردا % % لك عن ذوي خال وعن أعمام % % 60(@)(@@) % صلى عليك الله ما هطل الحيا % % وتبسم الأزهار بالأكمام % % PageV01P305 61(@)(@@) % وبنيك والصحب الكرام جميعهم % % ما طاب مبتدأ بمسك ختام % % PageV01P306 البحر : كامل تام 1(@)(@@) % هون عليك أخي فالأيام % % مهما استطال مطالها أحلام % % 2(@)(@@) % واصبر لغصتها فآيتها وإن % % ضاقت مدار ما لديه دوام % % 3(@)(@@) % كادت تشابه إبرة الفلك التي % % ثبتت ودارت حولها الأجرام % % 4(@)(@@) % تجري لغاية مستقر شمسها % % فيحفها عند العمود ظلام % % 5(@)(@@) % قد كورت لفا ودارت أرضها % % والناس بالشبر البسيط نيام % % 6(@)(@@) % ما أعجب المهد الذي خفت على % % مقدارها في دورها الأعلام % % 7(@)(@@) % هو كالسرير تهزه من نفسه % % كروية البرهان وهو مقام % % 8(@)(@@) % خذ منه فيما صارعتك يد النوى % % معنى فعل تذيعه الأقلام % % 9(@)(@@) % قد يحسب الناس الجبال جوامدا % % ومرورها للنص فيه نظام % % 10(@)(@@) % فاصبر لعمرك فالزمان حوادث % % تمضي ورأس المال فيه كلام % % PageV01P307 11(@)(@@) % خبر يطيب وعكسه فأصلح به % % شأنا إذا ذكر الشؤن كرام % % 12(@)(@@) % واجعل لشمس الروح قطبا ثابتا % % يرضى بما يقضى به العلام % % 13(@)(@@) % واقرأ إذا أرخت نفسك ذكرها % % فرجا بما نسجت لك الأرقام % % 14(@)(@@) % فلأنت عالم كل شيء نابت % % شكلا وشكلك هيكل لمام % % 15(@)(@@) % من كل زوجين المثال ونوعها % % بك صيغة حارت بها الأفهام % % 16(@)(@@) % كم آدم من قبل آدمك انطوى % % نصا وأنت تغرك الأوهام % % 17(@)(@@) % منها خلقناكم تتمة آيها % % يخبرك كيف تسلسل الأجسام % % 18(@)(@@) % فاسهر إذا نام الخلى لحكمة % % يعلى شرافة مجدها الأحكام % % 19(@)(@@) % وافتح من القرآن كنز معارف % % فالدين عند الخالق الإسلام % % 20(@)(@@) % وخذ الرسول وسيلة فمن التجا % % لرحابه المعمور ليس يضام % % PageV01P308 21(@)(@@) % واذكره للخطب الثقيل فإنه % % ركن بذيل ظلاله الإنعام % % 22(@)(@@) % واهرع له إن سود الصحف الخطا % % أوطم مثلي رأسك الآثام % % 23(@)(@@) % فهو الحبيب الهاشمي المرتضى % % سر الإله وسيفه الحسام % % 24(@)(@@) % بحر العطايا واحد النوع الذي % % شيدت بقوة دينه الأحكام 
ms90	 % % 25(@)(@@) % فرقان علم الغيب مصدر وحيه % % ليث الملاحم فحلها المقدام % % 26(@)(@@) % شرف البرية نور مقلتها الذي % % لجأت له الأعراب والأعجام % % 27(@)(@@) % روح الحقائق سر طرز العدل من % % شرف الليالي فيه والأيام % % 28(@)(@@) % نبراس كل حقيقة غيبية % % خضعت لشأن ظهورها الأعلام % % 29(@)(@@) % عين النبيين الكرام ومن هو الذخر % % الذي هو للجميع ختام % % 30(@)(@@) % روحي وأرواح الوجود فداؤه % % والكل قل وحقه الإعظام % % PageV01P309 31(@)(@@) % صلى عليه الله ما انبلج الضحى % % وامتد من نفس الحضيض غمام % % 32(@)(@@) % والآل والأصحاب ما شف الهوى % % بردا عراه من الخليط قتام % % 33(@)(@@) % والتابعين وتابعيهم ما زكى % % مسك الختام وقد غشاه سلام % % PageV01P310 البحر : خفيف تام 1(@)(@@) % يا رسول الرضا عليك السلام % % ضقت ذرعا وقد جفاني المنام % % 2(@)(@@) % فتدارك صلى عليك إله % % العرش وانظر ففيك يأتي المرام % % 3(@)(@@) % وتوجه بلفته وانعطاف % % لعبيد قد ضاق فيه المقام % % 4(@)(@@) % وتحنن فأنت أعطف خلق الله % % قلبا وللبلا حسام % % 5(@)(@@) % وتكرم يا أكرم الرسل طرا % % لضعيف أدهت به الآثام % % 6(@)(@@) % ها أنا الخاطىء الذليل وما لي % % موئل أرتجيه حين أضام % % 7(@)(@@) % لا ولا لي مال ولا من يوالي % % إن دهاني الحساد والأخصام % % 8(@)(@@) % دون أعتابك الرفيعة فارحم % % مستجيرا قد مله الأرحام % % 9(@)(@@) % يا صراط الشهود يا معدن الجود % % ويا من به علا الإسلام % % 10(@)(@@) % يا صباح الرضا ويا مظهر الحق % % ويا من تصفو به الأيام % % PageV01P311 11(@)(@@) % يصرف الكرب إذ يحال إلى أبواب % % علياك زادك العلام % % 12(@)(@@) % أنت روح الأشياء من عالم الأسماء % % غيبا وللوجود إمام % % 13(@)(@@) % أنت بعد الإله أعظم من قام % % بشأن وحقك الإعظام % % 14(@)(@@) % أنت كنز الكتاب والهازم الأحزاب % % قدما والسيد المقدام % % 15(@)(@@) % أنت طه وفيك للناس طه % % أنزلت أين من علاك النظام % % 16(@)(@@) % قد سموت السما ودست بنعل % % بسطها والملائك الخدام % % 17(@)(@@) % وحباك الرحمن عزا ونورا % % ضاء منه لما سريت الظلام % % 18(@)(@@) % وبعين شهدت ما غاب عن كلل % % وضلت عن دركه الأفهام % % 19(@)(@@) % قصرت عن مروره عليها قلوب % % العارفين العظام والأوهام % % 20(@)(@@) % أنت باب الرحمن والرحمة العظمى % % إذا ما ادلهمت الأرقام 
ms91	 % % PageV01P312 21(@)(@@) % أنت يا سيد البرية مجلى % % حضرة الله في حمى لا يرام % % 22(@)(@@) % أنت يا علة العوالم حرف الكون % % شكلا وبدؤه والختام % % 23(@)(@@) % أنت فراج كل هم وغم % % بيد بعض وصفها الإنعام % % 24(@)(@@) % أنت والله عدتي لمعادي % % وزماني ولانتصاري حسام % % 25(@)(@@) % أنت يا سيدي معيني وغوثي % % رغم خصمى والناصرون نيام % % 26(@)(@@) % كم وكم صنتني بسر خفي % % وبك الخطب زيج والآلام % % 27(@)(@@) % كم وكم جدت لي بسر وبر % % وغياث وقد دناني الحمام % % 28(@)(@@) % كم وكم سيدي صرفت كروبي % % وسترت العيوب قبل ألام % % 29(@)(@@) % كم وكم يا شفيع أهل الخطايا الخطايا % % قلت هذا له علي زمام % % 30(@)(@@) % كم وكم رامني العدو بسوء % % فرماه من راحتيك السهام % % PageV01P313 31(@)(@@) % كم وكم مد لي الخديعة خب % % قده منك بالخفا الصمصام % % 32(@)(@@) % كم وكم منك رحمة وحنانا % % حرستني لأمرك الأيام % % 33(@)(@@) % كم وكم مدني حبال الليالي % % منك في عسكر له أعلام % % 34(@)(@@) % كم وكم لاطمئنان قلبي فضلا % % بشرتني رؤياك لا الأحلام % % 35(@)(@@) % ألغياث الغياث والنخوة النخوة % % عطفا فقد أحاط الضرام % % 36(@)(@@) % مع ضعفي علي قد هجم الكرب % % فواحسرتي كواني السقام % % 37(@)(@@) % غربتي طال عن دياري مداها % % وبها الدين طمني والأوام % % 38(@)(@@) % كل يوم كأنني فوق نار % % أقلى وللهموم اضطرام % % 39(@)(@@) % يا أبا القاسم المعونة إني % % قد مني القوى وهد القوام % % 40(@)(@@) % يا أبا إبراهيم حسبي إذا كنت % % معيني وللضعاف الكرام % % PageV01P314 41(@)(@@) % أنت مولى الكرام إنسا وجنا % % ولمثلي يا مصطفى الإكرام % % 42(@)(@@) % لا تدعني مقطوع حبل بروم % % تحت بأس قعوده والقيام % % 43(@)(@@) % أو ترضى وأنت حاشاك ترضى % % ذلتي والدموع مني سجام % % 44(@)(@@) % أتمنى واليأس أم التمني % % وبي القاع ضاق والآكام % % 45(@)(@@) % فأغثني بفضل قدرك عند الله % % يا من علت به الأحكام % % 46(@)(@@) % وتفضل علي بالنصر والفتح % % وقل أبو الهدى لا يضام % % 47(@)(@@) % وتدارك فقد فقدت اصطباري % % يا رسول الرضا عليك السلام % % PageV01P315 البحر : بسيط تام 1(@)(@@) % راح الأصم ووافى الآن شعبان % % والقلب باق على ما فيه حيران % % 2(@)(@@) % أضره سقم الأكدار وا ألمي % % بلى لأن ملم الهم ثعبان 
ms92	 % % 3(@)(@@) % والعين يا حسرتا لا زال مدمعها % % يجري دما فهو فوق الخد هتان % % 4(@)(@@) % وغربتي أثقلتني كربة وضنى % % وليس لي في ديار الروم أعوان % % 5(@)(@@) % يبكي علي حسودي حين يعلم بي % % فكيف لو شام ما ألقاه خلان % % 6(@)(@@) % وذاب مني وجودي والفؤاد به % % مما ألاقيه إضرام ونيران % % 7(@)(@@) % يا ويح قلبي من وقت بليت به % % إخوانه يعد حذف البعض خوان % % 8(@)(@@) % صارت معالي الأيادي عندهم سمرا % % وأعقب الصدق تزوير وبهتان % % 9(@)(@@) % أين المرؤة والعهد الصحيح غدت % % تلك المعاهد تتلو ذكر من بانوا % % 10(@)(@@) % كأنها سيرة القوم الألى ومضت % % وأنهم وهي لا كانت ولا كانوا % % PageV01P316 11(@)(@@) % في الدهر موعظة للمرء كافية % % إن حل في قلبه فهم وإيمان % % 12(@)(@@) % مثل الخيال وبل عين الظلال فما % % لدار دنيا امرىء ركن وبنيان % % 13(@)(@@) % أين الأكاسرة الماضون أين بنوا % % العليا الذين بها عزوا وما هانوا % % 14(@)(@@) % أين الملوك وأين المرسلون ومن % % ساسوا البلاد بدين والحمى صانوا % % 15(@)(@@) % ماتوا جميعا كأن الكل ما خلقوا % % ولا أعانوا ولا هم للورى عانوا % % 16(@)(@@) % ولا بمصر ابن يعقوب غدا ملكا % % يوما ولا ملك الدنيا سليمان % % 17(@)(@@) % فإن تفكر رب الذوق معتبرا % % نهاه عن همه والغم عرفان % % 18(@)(@@) % وإن تغلب جيش الكرب منقلبا % % عليه واحتاطه ضيق وأحزان % % 19(@)(@@) % فليس إلا العريض الجاه من شرفت % % بعز طينته في العرب عدنان % % 20(@)(@@) % محمد خير من وافى الوفود له % % وأمه لرضا الرحمن ركبان % % PageV01P317 21(@)(@@) % سر الوجود وبحر الجود والمدد % % الممد إن خان أعوان وإخوان % % 22(@)(@@) % فجر الهداية شمس الرشد كافلنا % % لدى الحساب إذا ما قام ميزان % % 23(@)(@@) % أبو البتول الرسول الهاشمي ومن % % له على الخلق أفضال وإحسان % % 24(@)(@@) % أصل البرية فيما صح عن سبب % % لولاه ما كان في الأكوان إنسان % % 25(@)(@@) % جد الحسين الذي جاز السما وسما % % له على الرفرف المرفوع ديوان % % 26(@)(@@) % صدر الرسالة إنسان الدلالة من % % بدا بمظهره للدين برهان % % 27(@)(@@) % وقام من شأنه في الخافقين لإعلاء % % الشريعة رغم الخصم سلطان % % 28(@)(@@) % وجاء بالمعجزات الزهر فانفصمت % % عرى الضلال وأفنى الجهل قرآن 
ms93	 % % 29(@)(@@) % ومهد الدين والأخلاق فاندرست % % من عصبة الغي أخلاق وأديان % % 30(@)(@@) % ومن أقام عنادا في الضلالة لا % % يشك في أن ما ألفاه بطلان % % PageV01P318 31(@)(@@) % ألله أكبر إن الفضل ما شهدت % % به الأعادي وما للحق خذلان % % 32(@)(@@) % تلك الحنيفة السمحاء شيدها % % أبو البتول وتم العز والشان % % 33(@)(@@) % فالحمد لله ربح الدين حصتنا % % وللجحود القبيح الحظ خسران % % 34(@)(@@) % طبنا بنفحة من طاب الوجود به % % ونال منه الهدى عجم وعربان % % 35(@)(@@) % صلى عليه وإله العرش ما دفع % % الأدناس عن حزبه المنصور فرقان % % 36(@)(@@) % وآله والصحاب الغر ما تليت % % آياته وانجلى نشر وميزان % % PageV01P319 البحر : وافر تام 1(@)(@@) % أجل طرف اعتبارك في الزمان % % تر عجب العجاب بلا توان % % 2(@)(@@) % مشى متبهنسا ينساب لؤما % % وجاوز لدغه طعن السنان % % 3(@)(@@) % تلمظ بعد أن أكل الأعالي % % بنضنضة وحال إلى الأداني % % 4(@)(@@) % تعاتبه الخصال الغر عمن % % أخاف وحقهم كل الأمان % % 5(@)(@@) % فأعرض مثل ذي صلخ وبكم % % فقيد السمع معقود اللسان % % 6(@)(@@) % لحا الله الزمان فقد تعدى % % ونام فلا غفت عين الزمان % % 7(@)(@@) % رآى الرسل الكرام به البلايا % % وضيق دونهم رحب المكان % % 8(@)(@@) % مصيبة آدم لما تدلى % % لعالمه مفارقة الجنان % % 9(@)(@@) % وهرق دم ابنه وفراق حوا % % غني لو فقهت عن البيان % % 10(@)(@@) % وما دهم الخليل بيوم نار % % من النمرود فصل في القرآن % % PageV01P320 11(@)(@@) % وقصة يوسف وأبيه فيها % % إشارات رقيقات المباني % % 12(@)(@@) % وموسى من يدي فرعون ما قد % % دهاه من الأذى والإمتحان % % 13(@)(@@) % ومريم وابنها ما عاركاه % % يكل لشرحه قلم البنان % % 14(@)(@@) % وتاج الرسل من بالجسم وافى % % مقاما فوق هام الزبرقان % % 15(@)(@@) % وخاطبه الجليل على بساط % % وأكرمه هنالك بالعيان % % 16(@)(@@) % طوى الأيام وهو على حصير % % وكسرى فوق عرش من جمان % % 17(@)(@@) % على فرش من الديباج حيكت % % بها قطع اليواقيت الثمان % % 18(@)(@@) % يلقم وهو كلب النار زادا % له اتخذت من الذهب الأواني % % 19(@)(@@) % حفته الملوك بلا نزاع % % كأن بناره نعم الجنان % % 20(@)(@@) % وقاتل أحمدا قوم غلاظ % % وصالوا بالرديني واليماني % % PageV01P321 21(@)(@@) % وقد شجوه لا كانوا بسهم % % ونالوا من ثناياه الحسان % % 22(@)(@@) % دعاهم للهدى 
ms94	 فبغوا عنادا % % كذلك طبع ذي الغدر الجبان % % 23(@)(@@) % لقد أحي ببعثته البرايا % % وأعلى الدين في إنس وجان % % 24(@)(@@) % ولاقى الله متعوبا بصبر % % عليه تشهد السبع المثاني % % 25(@)(@@) % وصاحبه أبو بكر توفي % % على أخلاقه ثبت الجنان % % 26(@)(@@) % رجاة همة وصحيح عزم % % وقدر حط عنه النيران % % 27(@)(@@) % وعقل ساس فيه الملك حتى % % قضى والملك في سوح الأمان % % 28(@)(@@) % وفضل دونه الأصحاب طرا % % وبعد الرسل لم يعطي لثان % % 29(@)(@@) % وظل على بساط الفقر بين % % المسير والرسوب الهندواني % % 30(@)(@@) % يعاني عبء أعداء لئام % % وضيق يد وحسبك ما يعاني % % PageV01P322 31(@)(@@) % ومولانا أبو حفص إمام الصحابة % % شيخهم قاص ودان % % 32(@)(@@) % أمير ذوي الهدى عمر المعالي % % سراج المرسلين بكل آن % % 33(@)(@@) % ومن شهدت بهمته البرايا % % وقام الدين فيه بعنفوان % % 34(@)(@@) % وآخر قيروان الغرب أهدت % % بخطبته ثناه لأصفهان % % 35(@)(@@) % وسار العدل منبسطا بشكل % % كسا العدوان ثوب الزعفران % % 36(@)(@@) % وسربل تحت منبر المعلى % % عثور الظلم مقطوع البنان % % 37(@)(@@) % وأراده بخنجره عبيد % % لئيم قدتطيلس بالصنان % % 38(@)(@@) % فمات وقد نعاه الغرب حزنا % % وعن ألم بكاه المشرقان % % 39(@)(@@) % ولم يجمع له أدمان يوما % % رضاء بالحلال على خوان % % 40(@)(@@) % وذو النورين من لمعت عليه % % من الصهر الشريف الزهرتان % % PageV01P323 41(@)(@@) % ومن جمع الكتاب بخير حفظ % % وشأن عز عن إدراك شان % % 42(@)(@@) % شهيد الدار محمود المزايا % % رفيع القدر ممدوح المعاني % % 43(@)(@@) % سقاه زمانه كأسا أليما % % يرق له فؤاد القهرمان % % 44(@)(@@) % وقد تركته والأسياف روح % % دنت من مقعد الصدق المصان % % 45(@)(@@) % وسيدنا علي ذو الأيادي % % إذا دهم الوغا بالزعزعان % % 46(@)(@@) % يخب بمكفر دم الأعادي % % وحاصل ضربهم كالتهتهان % % 47(@)(@@) % ويضحك إذ يلاقي الموت علما % % بأن الموت يصرع في أوان % % 48(@)(@@) % إذا ما قسطل نشرته زرق % % الحوافر فوق أبطال الطعان % % 49(@)(@@) % وثار عقنقل البيداء حتى % % غشاها حين جلجل بالدخان % % 50(@)(@@) % رأيت لدى الصفوف أبا حسين % % عمود الصبح قام بطيلسان % % PageV01P324 51(@)(@@) % أذل جحا جح الكفار حطما % % بسيف هابه قلب الكيان % % 52(@)(@@) % وفي الصفين من صفين سارت % % مآثر بطشه للنهروان % % 53(@)(@@) % فعلم جل عن حصر وعقل % % يقاد للفظتيه العسكران % % 54 
ms95	(@)(@@) % ومجد دونه الميزان حدا % % وسبطاه بذاك الشاهدان % % 55(@)(@@) % وقد ملأ البلاد هدى ورشدا % % تعطر من شذاه العالمان % % 56(@)(@@) % وجندله ابن ملجم وهو خبل % % دني الأصل من حسب مهان % % 57(@)(@@) % سقاه بسيفه كأس المنايا % % وأردى الليث غدر الثعلبان % % 58(@)(@@) % وصارت درة الرأس المفدى % % مخضبة العناصر بالدهان % % 59(@)(@@) % وعن سبطيه كوكبي المعالي % % سل الزهراء أين الفرقدان % % 60(@)(@@) % فقد كانت لنورهما مقاما % % بتوليا محيطا كالقران % % PageV01P325 61(@)(@@) % فهذا مات مسموما وهذا % % بكته بكربلاء الشعريان % % 62(@)(@@) % وكان أبوهما سهم التجلى % % وأنهما لديه الأبهران % % 63(@)(@@) % وما حفظ الزمان لهم عهودا % % على الإيمان راسخة المباني % % 64(@)(@@) % بهم سر النبوة قام قدما % % وهم لنظامه كالترجمان % % 65(@)(@@) % جرى حكم الكتاب على يديهم % % وحكمته فطاب الخافقان % % 66(@)(@@) % وكدر عيشهم زمن لئيم % % به يعلو الغطارفة الغواني % % 67(@)(@@) % وعدد بعضهم آلا وصحبا % % وأتباعا مصابيح الأمان % % 68(@)(@@) % ولا تنس الملوك الشوس من قد % % أناخت تحت ظلهم الأماني % % 69(@)(@@) % ترى أن الزمان بغى عليهم % % وبانوا بين مقهور وعان % % 70(@)(@@) % فكيف يؤمل الفضلاء فيه % % غياثا من فلان أو فلان % % PageV01P326 71(@)(@@) % وسيرته بأهل الفضل ما قد % % رأيت وذا بديهي البيان % % 72(@)(@@) % أجل إن المكارم والمساوي % % لديه كما شهدنا ضرتان % % 73(@)(@@) % وظلما طلق الأولى فأنى % % يصح لأهلها منه التداني % % 74(@)(@@) % فكن بالصبر مدرعاوسلم % % أمورك للكريم المستعان % % PageV01P327 البحر : سريع 1(@)(@@) % يا أكرم الخلق على ربه % % وأقرب الناس إلى الله % % 2(@)(@@) % يا تاج كل الأنبياء الألى % % والمصطفى من رسل الله % % 3(@)(@@) % بحرمة الزهراء ذات العلى % % وآلك الغر أولي الجاه % % 4(@)(@@) % بالصحب والأتباع والأولياء % % الخلص الداعين لله % % 5(@)(@@) % أدرك بإسعافي وجد بالرضا % % ودلني عطفا على الله % % 6(@)(@@) % وخذ زمام القلب مني إلى التقوى % % وذكر سري اللاهي % % 7(@)(@@) % واجعل إلى حضرتك المنتهى % % في السير إذ ما القصد إلا هي % % 8(@)(@@) % عليك صلى الله يا مصطفى % % يا مجتبى يا خيرة الله % % 9(@)(@@) % والآل والأصحاب من دأبهم % % ذكرك بعد الله لله % % 10(@)(@@) % ألله ألله تفضل على % % قطعي بوصل الحبل بالله % % PageV01P328 11(@)(@@) % فأنت باب الله يا سيدي % % وقائد الخلق إلى الله % % PageV01P329 البحر : مجزوء الكامل 
ms96	 1(@)(@@) % يا من له الفخر انتهى % % وببابه سجد السهى % % 2(@)(@@) % ولمجده انتسب العلى % % وبنوره الكون ازدهى % % 3(@)(@@) % وله الغطارف أخرست % % ولقد تكلمت المها % % 4(@)(@@) % وهو الرسول المجتبى % % والغوث إن كرب دهى % % 5(@)(@@) % قلب عن الرحمن في % % كل المواطن ما لها % % 6(@)(@@) % ولسان معرفة له % % نشر المهيمن ما اشتهى % % 7(@)(@@) % وبه الإله تكرما % % أهدى البرية سبلها % % 8(@)(@@) % هي فرعه في نشئها % % إذ كان غيبا أصلها % % 9(@)(@@) % كم عقدة تحت العمى % % بلطيف لفت حلها % % 10(@)(@@) % وعصابة غدارة % % بالطرف منه أذلها % % PageV01P330 11(@)(@@) % وبسهم دولة قلبه % % دار البوار أحلها % % 12(@)(@@) % إن أزمة عظمت وأو % % تركف كرب نبلها % % 13(@)(@@) % أو مدلهم مذ دهي % % صبر الضعيف له وهي % % 14(@)(@@) % فالجأ أخي بباب طه % % إنه كفؤ لها % % PageV01P331 البحر : سريع 1(@)(@@) % أشكو إلى الله وأني على % % ظن جميل صح بالله % % 2(@)(@@) % والمصطفى واسطتي للرجا % % وباب إيصالي إلى الله % % 3(@)(@@) % واسأل الله به رحمة % % وقد توكلت على الله % % 4(@)(@@) % ما خاب عبد جاء مستشفعا % % بالمصطفى يرجو من الله % % PageV01P332 البحر : بسيط تام 1(@)(@@) % ليل الكروب علينا طال يا طه % % غوثاه كم آه تلا آها % % 2(@)(@@) % بالله يا صاحب الجاه العظيم أغث % % بنظرة قبل وقت الفجر نلقاها % % 3(@)(@@) % فرج بجاهك كربا مسنا عظمت % % بلواه فاصرف بسر اللطف بلواها % % 4(@)(@@) % حول ركابك ياسر الوجود وقل % % باتوا بليلة خير طاب مثواها % % 5(@)(@@) % غوثاه يا مصطفاه انظر بمرحمة % % عصابة قد أضرتها خطاياها % % 6(@)(@@) % ويا أبا القاسم الغوث الغياث فقد % % ضاقت بنا الأرض أقصاها وأدناها % % 7(@)(@@) % يا تاج كل رسول للإله أغث % % فمن سواك لعين سال مجريها % % 8(@)(@@) % يا أغير الخلق يا سيف الإله ويا % % من قام في كل طور ينصر الله % % 9(@)(@@) % ألله ألله بالقوم الضعاف فما % % يحمي الضعاف بخطب غير أقواها % % 10(@)(@@) % مولاي يا موئل الآل الذين لهم % % إليك آمال ظن جل معناها % % PageV01P333 11(@)(@@) % خذ بالتصرف واصنع بالمرؤة ما % % يطوي بليلتنا إصلاح مجلاها % % 12(@)(@@) % واسبل رداء المعالي فوقنا كرما % % بحالة لا يشين الدهر علياها % % 13(@)(@@) % ذلت قلوب حسام الكرب جرحها % % وطال من ألم 
ms97	 العصيان مدماها % % 14(@)(@@) % فداوها بعزيز النصر يا سند % % اللاجين واسبل عليها الستر يا طه % % PageV01P334 البحر : كامل تام 1(@)(@@) % والنجم من سمك الغيوب إذا هوى % % ما ضل قلبي في هواك وما غوى % % 2(@)(@@) % طارت به لبقاع طيبة لهفة % % قطعته في كل الشؤن عن السوى % % 3(@)(@@) % يا أيها القمر المنير ومن له % % فزعت قلوب العاشقين أولي الهوى % % 4(@)(@@) % أبدا عليك الله صلى ما انجلى % % نشر وما المنشور بالحكم انطوى % % 5(@)(@@) % لاحظ برأفتك انكسار أبي الهدى % % فلقد غزاه تهجما جيش النوى % % PageV01P335 البحر : كامل تام 1(@)(@@) % لولا النوى قرب الأحبة ما حلا % % والفجر لولا الليل ما كان انجلى % % 2(@)(@@) % فاصبر فؤادي للنوى وهمومه % % فلرب قلب تجتليه يد القلا % % 3(@)(@@) % لما دعا الداعي قلوب أولي الهوى % % بعلى ألست بربكم قالوا بلى % % 4(@)(@@) % طرق الحنين جميعها في طيها % % ولصدقها نشرت على ذاك الولا % % 5(@)(@@) % جذبتهم النفحات من شمس الهدى % % قمر التدلي المرتقى لذرى العلى % % 6(@)(@@) % فهو النبي الهاشمي محمد % % من قام في نسق الوجود الأكملا % % 7(@)(@@) % طابت به الأرواح فهو صفاؤها % % وبه لها انجلت الحقائق في الملا % % 8(@)(@@) % عكفت عليه فنوره نبراسها % % وغياثها إن صعب أمر أشكلا % % 9(@)(@@) % يا صاحب القبر الذي التمس الملائك % % جانبيه مكبرا ومهللا % % 10(@)(@@) % دارك بطول حنان قلبك مظهري % % وارحم عبيدا عنك لن يتحولا % % PageV01P336 11(@)(@@) % وعليك صلى الله والأل الألى % % والصحب ما تال مفاخركم تلا % % PageV01P337 البحر : رمل تام 1(@)(@@) % ما الذي أصنع بالنفس الأبية % % تطلب المجد ولا تخشى المنية % % 2(@)(@@) % وترى أن المعالي تبتغى % % بكمالات وأخلاق زكية % % 3(@)(@@) % ما عليها لو مع البعض ارتدت % % لمنال القصد أثوابا دنية % % 4(@)(@@) % طبعت قدما مع الخلق على % % همم لو ساعد الحظ عليه % % 5(@)(@@) % تعشق المعروف للناس وإن % % قوبلت عنه بأنواع الأذية % % 6(@)(@@) % وتكف السؤ عن حسادها % % لرضا الرحمن عن خالص نية % % 7(@)(@@) % وتحب البذل من ما وجدت % % وترى النقص إذا أبقت بقية % % 8(@)(@@) % ولديها والذي صورها % % هي والناس جميعا بالسوية % % 9(@)(@@) % وعلى ما حملت من عزة % % عرفت كالقوم حد البشرية % % 10(@)(@@) % تشتهي طائفة الفقر وما 
ms98	 % % عندها للثوب والمال مزية % % PageV01P338 11(@)(@@) % شرفت نهجا فلما عظمت % % رتبة صارت من المال خلية % % 12(@)(@@) % أخلصت طبعا ولما رضيت % % عدها أهل النهى نفسا رضية % % 13(@)(@@) % قنعت فالتحفت ثوب الغنى % % كل نفس قنعت تلك غنية % % 14(@)(@@) % واعنائي هذه متعبتي % % إنما النفس إذا عزت بلية % % 15(@)(@@) % تك ترفق ذل وترجو أنها % % تبلغ العليا بخلق وسجية % % 16(@)(@@) % ما وساعدني الأماني أصبحت % % تحت مطوي ضلوع أشعبية % % 17(@)(@@) % وفي الصبا من زمن % % أهله ساؤا بحكم الأغلبية % % 18(@)(@@) % كاد يؤمن من كرام وإذا % % ذكروا قيل أمور أولية % % 19(@)(@@) % وإذا طالبت أهليه الوفا % % فاذكر الحمى ولا تذكر حمية % % 20(@)(@@) % وقضا الحجات للناس بهم % % تحته للطعن أسرار خفية % % PageV01P339 21(@)(@@) % طمست شمس المرؤات وهل % % تطلع الشمس إذ الوقت عشية % % 22(@)(@@) % ولكم ينظر بالشخص الحيا % % وإذا غاب له لسعة حية % % 23(@)(@@) % صاح إن كنت زكي النفس لا % % تبغ للنفس الأماني الدنيوية % % 24(@)(@@) % وإذا ضاقت بك الحال فقف % % راجيا بالعتبات النبوية % % 25(@)(@@) % وضع الخد على الباب الذي % % ظله لاذت به كل البرية % % 26(@)(@@) % والق عنك الحمل مثلي عند من % % شرفت فيه البطاح اليثيربية % % 27(@)(@@) % مصطفى الحق إمام الأنبيا % % من سمت فيه البطون القرشية % % 28(@)(@@) % علم الإرشاد والهادي إلى % % سبل الحق وكشاف الرزية % % 29(@)(@@) % سيد الخلق الملاذ المرتجى % % مدة الدهر إلى كل قضية % % 30(@)(@@) % سيف رب العرش مصباح الهدى % % صبحه معنى الصفات الأزلية % % PageV01P340 31(@)(@@) % هيكل الحكمة ناسوت الرضا % % مقتدى كل ولي وولية % % 32(@)(@@) % رحمة الله التي قد وسعت % % كل شيء غوث للجوء حبة % % 33(@)(@@) % مفزع الأكوان معقودا اللوا % % مطلق الأمة % % 34(@)(@@) % لا يرى العبد مهما أبدا % % إن غدا مولاه % % 35(@)(@@) % هو باب الله والبحر الذي % % أضمرت فيه المعاني القدسية % % 36(@)(@@) % وهو المرجو في يوم غد % % حينما تبدو من الذنب الخبية % % 37(@)(@@) % وهو المدعو للخطب إذا % % بعد الأهل وفل العصبية % % 38(@)(@@) % وهو المأمول إن ضاق الفضا % % وتوالت كرب الدهر العدية % % 39(@)(@@) % أو ينسى ما له من مدد % % وأياد في البرايا أحمدية % % 40(@)(@@) % وبراهين بدت مفحمة % % جاحديها دونها الشمس المضية % % PageV01P341 41(@)(@@) % وهو للخلق وكل 
ms99	 الأنبيا % % علة للخلق كانت سببية % % 42(@)(@@) % وله القرآن أعلى شاهد % % قائم بالمعجزات الأبدية % % 43(@)(@@) % أخرس الفصح بما في سلكه % % نظم الآي عقودا جوهرية % % 44(@)(@@) % فكأن العرب عجم حينما % % تنجلي منه المعاني العربية % % 45(@)(@@) % ولهذا المجتبى من آدم % % فوق وصف الناس أوصاف سنية % % 46(@)(@@) % وعلى أخلاقه صح الثنا % % بكتاب الله يا نعم المزية % % 47(@)(@@) % ولنا من بابه السامي الذرى % % نفحات الغوث تأتي عبهرية % % 48(@)(@@) % وعلى مر الليالي ذيله % % فوقنا منه مروط سندسية % % 49(@)(@@) % يا أجل الرسل يا من باعه % % موصلي فضلا لآمالي القصية % % 50(@)(@@) % راعني بالعطف في الدنيا وقل % % لك منا العيشة الحلوى الهنية % % PageV01P342 51(@)(@@) % ومن النار احمني إني أرى % % لن يرى النار امرؤ كنت نبيه % % 52(@)(@@) % وأجرني سيدي من دفتر % % قد أحاط الوزر منه كل طيه % % 53(@)(@@) % وأغثني رحمة من زمن % % بك فيه رتبتي أضحت عليه % % 54(@)(@@) % فأنا المسكين يا مولى الورى % % عبدك المحتاج إحسان العطية % % 55(@)(@@) % جاء اللأعتاب والليل له % % ضجة في عالم الملك قوية % % 56(@)(@@) % فتدارك يا رسول الله بالهمة % % العليا وبالأيدي الندية % % 57(@)(@@) % وعليك الله صلى سرمدا % % بسلام ضمنه أزكى التحية % % 58(@)(@@) % وعلى آلك والصحب الألى % % وعلى فاطمة الطهر النقية % % 59(@)(@@) % وعلى أبنائها من فيهم % % منك صحت لذوي الدين الوصية % % PageV01P343 البحر : وافر تام 1(@)(@@) % ترفق بي فديتك يا صفيي % % ولا تقس المشوق على الخلى % % 2(@)(@@) % وساعدني على غصصي فإني % % ولعت بريم منعرج الغري % % 3(@)(@@) % وفي الصدرين من تلك المضاحي % % صدرت عن المناهل لا بري % % 4(@)(@@) % أمر بها وينفحني شميم % % يفوق لطافه المسك الشذي % % 5(@)(@@) % يناجي الغرام لها بفكري % % فوا لهفاه من ذاك النجي % % 6(@)(@@) % وينشر في الهوى مطوي سري % % فيمضي العمر في نشر وطي % % 7(@)(@@) % وليل عجت الركبان فيه % % وقد رج البقاع من الدوي % % 8(@)(@@) % سبقت به الجنائب حين طارت % % ضيف الجسم ذا وجد قوي % % 9(@)(@@) % أروم ملاعب الغزلان مضنى % % فحالة ميت بطراز حي % % 10(@)(@@) % أشم من الغرى عرار نجد % % على شطط النوى بعد العشي % % PageV01P344 11(@)(@@) % ولي من هذه الأسرار معنى % % أذوب لسر مشهده الخفي % % 12(@)(@@) % كأن 
ms100	 لطائف الآثار منه % % رموز قد أشرن إلى النبي % % 13(@)(@@) % هو المختار من كل البرايا % % محمد صاحب النور الجلي % % 14(@)(@@) % أجل الأنبياء بكل حال % % وسيد حزبهم في كل زي % % 15(@)(@@) % دعته المرسلون إمام مجد % % تبوأ ذروة الشرف السني % % 16(@)(@@) % ولاذ به الوجود وقام فردا % % عظيم الخلق ذا قدر علي % % 17(@)(@@) % سمو تقصر الأفلاك عنه % % بمركزها الرفيع الأنوري % % 18(@)(@@) % فداه أنا وجيلي من رسول % % وصول هاشمي أبطحي % % 19(@)(@@) % تحاضره القلوب مهيمات % % فيجذبها إلى النهج السوي % % 20(@)(@@) % وتحرز هدية في كل شأن % % وتشهد نوره في كل حي % % PageV01P345 21(@)(@@) % جداول بحره بالجود ماجت % % فأغنت للفقير وللغني % % 22(@)(@@) % جرت من فيض همته الأيادي % % وعمت للقريب وللقصي % % 23(@)(@@) % أذاق بعزمه للخصم سما % % وترياق السعادة للولي % % 24(@)(@@) % أحط برحبه رحلي وأني % % نزلت بساحة البر الوفي % % 25(@)(@@) % وأسأله التوسل للإله المهيمن % % ربنا الملك العلي % % 26(@)(@@) % فينصب الشفاء على مريضي % % وينشط سالما من كل غي % % 27(@)(@@) % وتشملني وعائلتي وقومي % % يد الرحمن باللطف الخفي % % 28(@)(@@) % فنجلى في مروط الستر دهرا % % بدائرة الأمان السرمدي % % 29(@)(@@) % ونحشر بعد أن نلقى المنايا % % مع الهادي بروض عبقري % % 30(@)(@@) % بسدرة مقعد الصدق المعلى % % بعين الله في عيش هني % % PageV01P346 31(@)(@@) % لدى أبائنا عقدا فعقدا % % لفاطمة وسيدنا علي % % PageV01P347 البحر : مجزوء الرمل 1(@)(@@) % يا إمام الأنبياء % % يا ملاذ الأولياء % % 2(@)(@@) % داوني وارحم خضوعي % % إنني عز دوائي % % 3(@)(@@) % لازمه % % 4(@)(@@) % يا ختام المرسلين % % يا أمان الخائفين % % 5(@)(@@) % يا غياث اللائذين % % يا دليل الأصفياء % % 6(@)(@@) % دور % % 7(@)(@@) % لك عن إخلاص نيه % % جئت أرجوك العطية % % 8(@)(@@) % أنت يا روح البرية % % بك من دائي شفائي % % 9(@)(@@) % دور % % 10(@)(@@) % أنت عنوان الجلال % % أنت سلطان الجمال % % PageV01P348 11(@)(@@) % أنت ناسوت الكمال % % أنت كنز الفقراء % % 12(@)(@@) % دور % % 13(@)(@@) % أنت برهان التدلي % % ضمن أستار التجلي % % 14(@)(@@) % صل بحبل الله حبلى % % واكفني هم عنائي % % 15(@)(@@) % دور % % 16(@)(@@) % لك آيات الكتاب % % فصلت فصل الخطاب % % 17(@)(@@) % سيدي فاجعل جوابي % % منك تحقيق رجائي % % 18(@)(@@) % دور % % 19(@)(@@) % وصلاة الله تتلى % % لك ما الله تجلى % % 20(@)(@@) % ولكل الآل فضلا % % والصحاب الأتقياء % % PageV01P349 البحر : مجزوء 