ms141	 حضرة مقدسة فيك % % وقبرا عليك منك جلال % % 8(@)(@@) % فبأبوابها تناخ المطايا % % وبأفنانها تحط الرحال % % 9(@)(@@) % فاز من زارها ومنحل فيها % % وعليه الخضوع والإذلال % % 10(@)(@@) % يا مفيضا من روحه نفخات % % منك يستوهب الكمال كمال % % PageV01P432 11(@)(@@) % سار بالشوق قاصدا من فروق % وإليك المسير والانتقال % % 12(@)(@@) % زورة تمحق الذنوب وفيها % % للمنيبين منحة نوال % % 13(@)(@@) % عن خلوص وعن ثبات اعتقاد % % أوقفته ببابك الآمال % % 14(@)(@@) % ودعاه إليك وهو بعيد % % سفر عن بلاده وارتحال % % 15(@)(@@) % لم تعقه فدافد وحزون % % وقفار مهولة وجبال % % 16(@)(@@) % فطوى في مسيرة الأرض طيا % حين وافى ومااعتراه ملال % % 17(@)(@@) % إن يصادف منك القبول فقد % % فاز وثم الإسعاد والإقبال % % 18(@)(@@) % لم يخب آمل بما يرتجيه % % وله فيك عزة واتصال % % 19(@)(@@) % أنت قطب في عالم العلم منه % % تستمد الأقطاب والأبدال % % 20(@)(@@) % بك في العالمين يرحمنا الل % ه وعنا تخفف الأثقال % % PageV01P433 البحر : خفيف تام 1(@)(@@) % أي جمع هذا وأي اتفاق % % وصحاب أماجد ورفاق % 2(@)(@@) % خالفوا داعي الشقاق وشقوا % % بالتئام منهم عصي الشقاق % % 3(@)(@@) % كل فرد منهم من الفضل كنز % % ليس يخشى الإملاق في الإنفاق % % 4(@)(@@) % أي ناد نادي الأجل شها % % ب الدين بحر العلوم مفتي العراق % % 5(@)(@@) % لو أفيضت علومه في البرايا % % شمل العالمين بالأغراق % % 6(@)(@@) % محرق حجة الغياد ولا بدع % فإن الشهاب للإحراق % % 7(@)(@@) % كاشف الغم إن توالت غموم % % فارج الهم عند ضيق الخناق % % 8(@)(@@) % فإلى فضله تهادى المطايا % % وإلى ربعه حنين النياق % % 9(@)(@@) % فهو إذا ذاك ملجأ الناس طرا % وأجل الورى على الإطلاق % % 10(@)(@@) % فتأمل فيما حوى اليوم نادي % % ه ففيه مكارم الأخلاق % % PageV01P434 11(@)(@@) % جمعوا بين شدة البأس في % % الجد وفي الهزل رقة العشاق % % 12(@)(@@) % إنما الساعة التي جمعتهم % % جمعت لي محاسن الآفاق % % 13(@)(@@) % فغدت مثل روضة باكرتها % % غاديات بالوابل المهراق % % 14(@)(@@) % فكأن الحديث فيه مدام % % حملتها إلي كف الساقي % % 15(@)(@@) % مجلس ما انطوى على غير أنس % وخلا من تحاسد ونفاق % % 16(@)(@@) % يا له مجلس بأحمد قد أشر % % في الحسن غاية الإشراق % % 17(@)(@@) % دب فيه السرور من كل وجه % % بأديب الزمان عبد الباقي 
ms142	 % % 18(@)(@@) % وتعالى إلى المعالي علي % بالعوالي وبالسيوف الرقاق % % 19(@)(@@) % وعلا قدره بقدر علي % وتسامى فكان في الفخر راقي % % 20(@)(@@) % قلد الناس أيديا من نداه % % فهي مثل الأطواق في الأعناق % % PageV01P435 21(@)(@@) % كم شكرنا غداة يقتسم الوفد % % نداه مقسم الأزرق % % 22(@)(@@) % أسعد الله السعيد لديهم % % كل عذب الكلام حلو المذاق % % 23(@)(@@) % فأراعوا هذا الزمان بجمع % % لا أريعوا من بعدها بالفراق % % PageV01P436 البحر : رمل تام 1(@)(@@) % جدد اللذة حتى نتجدد % واسقنيها في لجين الكأس عسجد % % 2(@)(@@) % وخذ اليوم بها لذتنا % % وأعدها يا نديمي لي في غد % % 3(@)(@@) % لو رآه تائب من ذنبه % % كل فرد منهم بالفضل مفرد % % 4(@)(@@) % نظمت شملهم كأس الطلا % % فهو كالعقد وكالدر المنضد % % 5(@)(@@) % برز الروض بأبهى هيبة % % فتهيا للسرور اليوم واعتد % % 6(@)(@@) % ولقد جرد من عمد الدجى % % صارم الفجر عيانا فتجدد % % 7(@)(@@) % وبقايا غلس أبصرتها % % ما تبقى من دخان العود والغد % % 8(@)(@@) % نبه الورقاء حتى نبهت % % للحيما أعينا للشرب هجد % % 9(@)(@@) % أطربتنا الورق في ألحانها % % يا فدتها في الغواني أم معبد % % 10(@)(@@) % في رياض نضرات أنبتت % % ورق الياقوت من قضب الزبرجد % % PageV01P437 11(@)(@@) % ولكم عدنا إلى أمثالها % % بعد حين فوجدنا العود أحمد % % 12(@)(@@) % وشهدنا مشهد الأنس بها % % وقعدنا للهوى كل مقعد % % 13(@)(@@) % وقضينا عجبا من روضة % % شرب الغصن فما للطير عربد % % 14(@)(@@) % ومدير الكاس في أرجائها % % قمر يبدو وغصن يتأود % % 15(@)(@@) % إن أشهى الراح ما تأخذه % % من يدي ساق الخد أمرد % % 16(@)(@@) % خلت ما في يده في خده % % فسواء بين ما في اليد والخد % % 17(@)(@@) % بابلي الطرف حلوي اللمى % % لين الجانب قاسي القلب جلمد % % 18(@)(@@) % ألعس مذ بردت ريقته % % أورثتنا نار شوق تتوقد % % 19(@)(@@) % فشربنا خده من يده % % واقتطفنا منه غصن الآس والورد % % 20(@)(@@) % واتخذناه وإن يأب التقى % % صنما لكنه للحسن يعبد % % PageV01P438 21(@)(@@) % يبعث الوجد إلى كل حشا % % لخلي من هواه حيث لا وجد % % 22(@)(@@) % % قد تبدى وهو مثل البدر لا رتد % % 23(@)(@@) % جحدت أعينه سفك دمي % % وعليه حده في الوجه يشهد % % 24(@)(@@) % لست أدري أيما أمضى شبا % في فؤادي ذلك 
ms143	 الطرف أم القد % % 25(@)(@@) % إن هاروت وماروت لقد % % أخذا عنه حديث السحر مسند % % 26(@)(@@) % لين الأعطاف حتى إنه % % كاد من شدة ذاك اللين يعقد % % 27(@)(@@) % يا له من مطرب يعجبني % % غزلي فيه ومدحي لمحمد % % 28(@)(@@) % ذي يد طولى فشكرا ليد % % من عريق في المعالي الغر ذي يد % % 29(@)(@@) % ضم برداه تقيا ماجدا % وجد التقوى مزادا فتزود % % 30(@)(@@) % قد نظرنا جده أو جده % % فنظرنا بالعلى ما يصنع الجد % % PageV01P439 31(@)(@@) % يقتفي آثار آباء له % % أثر المجد اقتفى عنهم وقلد % % 32(@)(@@) % وعلى ما عودت آباؤه % % عودته من قديم فتعود % % 33(@)(@@) % ولكم حل بهم من مشكل % % وهم إذا ذاك أهل الحل والعقد % % 34(@)(@@) % رفعت آثاره أعلامهم % % فبنى بي معاليهم وشيد % % 35(@)(@@) % ماجد يعلو على أقرانه % % وقد احتل رعان العز والمجد % % 36(@)(@@) % ليس يخفى فهمه أو علمه % % 37(@)(@@) % قصدت وفاده إحسانه % % قل من يرجى لإحسان ويقصد % % 38(@)(@@) % غير بدع إن تحرينا له % % مكرمات من كريم الأب والجد % % 41(@)(@@) % علماء عملوا في علمهم % % مهدوا الدين من المهد إلى اللحد % % 45(@)(@@) % % لاح للعالم مثل العلم الفرد % % PageV01P440 48(@)(@@) % فإذا أفسد حالا زمن % أصلحت ما أقصد الدهر وأفسد % % 49(@)(@@) % وأمدتني يداه بالندى % % وكذاك البحر يوم الجزر والمد % % 50(@)(@@) % إذ حللنا ناديا حل به % % لم نحل إلا بغاب الأسد الورد % % 51(@)(@@) % وإلى ناديه في يوم الندى % % أدب يجبى ومال يتبدد % % 52(@)(@@) % عارض من فضله ممطرنا % % لا كما العارض إن أبرق أرعد % % 53(@)(@@) % لا أزال الله عن أبصارنا % % طالعا منه يزيل النحس بالسعد % % 54(@)(@@) % فلك الأيدي على طول المدى % % أبدا بيض بجنح الخطب أسود % % 55(@)(@@) % فتول من ثنائي مدحة % أيها المولى فقد لاذ بك العبد % % 56(@)(@@) % قد مضى صياما وتقى % فابق واسلم دائم العز مخلد % % 57(@)(@@) % و هنا بالعيد فقد عاد بما % % تشهيه أنت من عز وسؤدد % % PageV01P441 58(@)(@@) % لست أدري أؤهنيك به % % أم أهني بك في إكرامك الوفد % % 59(@)(@@) % وجزاك الله عني خير ما % % جوزي المنعم بالشكران والحمد % % PageV01P442 البحر : سريع 1(@)(@@) % في رحمة الله مضى وانقضى % % قرم له بين الورى شان 
ms144	 % 2(@)(@@) % قد كان طود المجد حتى هوت % % له برغم المجد أركان % % 3(@)(@@) % مات شهيدا فإلى روحه % % من ربه عفو وغفران % % 4(@)(@@) % وكم مضت قوم لهم صولة % حتى كأن القوم ما كانوا % % 5(@)(@@) % مات ابن غنام فأرخته % % في الخلد قد راح سليمان % % PageV01P443 البحر : رمل تام 1(@)(@@) % أعد اللهو فإن اللهو أحمد % وأدرها في لجين الكأس عسجد % % 2(@)(@@) % واسقنيها قهوة عادية % أخبرت عما مضى في ذلك العهد % % 3(@)(@@) % لو رأى كسرى سنا أنوارها % % ظنها النار التي في الفرس تعبد % % 4(@)(@@) % لبست من حبب المزج لها % % تاج إسكندر ذي القرنين والسد % % 5(@)(@@) % فاسقني اليوم أفاويق الطلا % % وأعدها يا نديمي لي في غد % % 6(@)(@@) % قدمت لكننا في شربها % % كل يوم سرور يتجدد % % 7(@)(@@) % في رياض لعبت فيها الصبا % % وأذاعت سر نشر الشيح والرند % % 8(@)(@@) % أخذت زخرفها من بعد ما % % حاكت المزن لها أثواب خرد % % 9(@)(@@) % نثر الطل عليها لؤلؤا % أدمعا سالت من العين على الخد % % 10(@)(@@) % فانثنت أغصانها مائسة % طرب النشوان راحت تتأود % % PageV01P444 11(@)(@@) % % فعلام الطير في الأفنان عربد % % 12(@)(@@) % زمن الورد وما يعجبني % % زمن للهو إلا زمن الورد % % 13(@)(@@) % تنقضي أيامه محمودة % في أمان الله من حر ومن برد % % 14(@)(@@) % فاغتنمها فرصة ما أمكنت % % قبل أن تذهب يا صاح وتفقد % % 15(@)(@@) % بين شاد تطرب النفس به % % يتغنى ومليح يتأود % % 16(@)(@@) % ما ألذ الراح يسقاها امرؤ % % من يدي ساق نقي الخد أمرد % % 17(@)(@@) % بخجل الأقمار حسنا وجهه % % وغصون البان لينا ذلك القد % % 18(@)(@@) % فالعوالي والغوالي إنما انتس % % بت منه انتساب القد والند % % 19(@)(@@) % أرأيت السحر فيما زعموا % % إنه راح إلى عينيه يسند % % 20(@)(@@) % أنزلت للحسن آيات به % % آمن العاشق فيهن وما ارتد % % PageV01P445 21(@)(@@) % ما رمى قلبي إلا عامدا % قاتل لي ولقتلي يتعمد % % 22(@)(@@) % يأخذ الأرواح من أربابها % % لعبا منه فما قولك إن جد % % 23(@)(@@) % سمح المهجة لا ممتنع % % عن محب خضل الطرف مسهد % % 24(@)(@@) % لا يشوب الوصل بالصد ويا % % رب إلف لا يشوب الوصل بالصد % % 25(@)(@@) % بأبي الأغيد لا بمزجها % % من لماء بسوى العذب 
ms145	 المبرد % % 26(@)(@@) % وبأحشائي من الوجد إلى % % بارد الريقة نار تتوقد % % 27(@)(@@) % حبذا العيش بمن قد تصطفي % % لا النوى باد ولا الشمل مبدد % % 28(@)(@@) % تحت ظلي مالكي رقي وما % % غير محمود ولا غير محمد % % 29(@)(@@) % النجيبين اللذين انتدبا % % بجميل الصنع والذكر المخلد % % 30(@)(@@) % والمجيدين وكل منهما % % طيب العنصر زاكي الأصل والجد % % PageV01P446 31(@)(@@) % والكريمين وما صوب الحيا % % إن يكن أبرق بالجود وأرعد % % 32(@)(@@) % والرفيقين كأني بهما % % بلغا الغاية من مجد وسؤدد % % 33(@)(@@) % إن أفاخر بهما غيرهما % % فلقد أفخر بالحر على الوغد % % 34(@)(@@) % خلقا للفضل وارتاحا له % % لا كمن عود قسرا فتعود % % 35(@)(@@) % إن هذين هما ما برحا % % للمعالي بمحل الكف والزند % % 36(@)(@@) % فتأمل بهما أيهما الذا % % بل الخطي والسيف المنهد % % 37(@)(@@) % إن يكونا قلداني نعمة % أنا فيها فنعما أتقلد % % 38(@)(@@) % وصلا حبلي وشادا مفخري % % ولمثلي فيهما الفخر المشيد % % 39(@)(@@) % هكذا فلتك أبناء العلى % % تقتفي الأبناء إثر الأب والجد % % 40(@)(@@) % إنما الشبل من الليث وما % % يلد الأصيد يوما غير أصيد % % PageV01P447 41(@)(@@) % من أب يفتخر المجد به % % إن رمى أصمى وإن ساعد أسعد % % 42(@)(@@) % هو بحر ما له من ساحل % % وحسام لم نقف منه على حد % % 43(@)(@@) % وهزبر باسل برثنه الأسمر % العسال والعضب المجرد % % 44(@)(@@) % هو مولاي إذا استعطفته % % عطف المولى من البر على العبد % % 45(@)(@@) % مالك حكمني في ماله % % فلي الأخذ خيارا ولي الرد % % 46(@)(@@) % وحباني نعما أشكرها % % فله الشكر عليها وله الحمد % % 47(@)(@@) % لا أبالي إن لي جنة % بزمان كان لي الخصم الألندد % % 48(@)(@@) % طاول الأيدي فطالت يده % % ما على أيدي للعالم من يد % % 49(@)(@@) % حفظ الحافظ نجليه ولا % % برحا في أطيب العيش وأرغد % % 50(@)(@@) % لم يلد مثل أبيهم والد % لم يلد قبل ولا من بعد يولد % % PageV01P448 51(@)(@@) % نصروا المجد وكانوا حزبه % % فهم الأنصار والحزب المؤيد % % 52(@)(@@) % فلقد طابوا وطابت خيمهم % % طيبو الأعراق من قبل ومن بعد % % 53(@)(@@) % نبتوا فيها نباتا حسنا % وغذاهم بلبان العز والمجد % % 54(@)(@@) % وإذا امعنت فيهم نظرا % لم تجد إلا شهابا ثاقب الزند % % 55(@)(@@) % كلما زاد وقارا زدته 
ms146	 % % مدحا تتلى مدى الدهر وتنشد % % 56(@)(@@) % وعذار مذ بدا أرخته % % لاح كالمسك عذار لمحمد % % PageV01P449 البحر : وافر تام 1(@)(@@) % أرى في لفظ هذا الشهم معنى % ينبىء عن مدى علم عظيم % % 2(@)(@@) % ومهما زدته نظرا بفكري % % رأيت نهاه قسطاس العلوم % % PageV01P450 البحر : خفيف تام 1(@)(@@) % أي نار بها الجوانح تصلى % % وجفون تصوب بالدمع وبلا % % 2(@)(@@) % كلما لاح بارق هاج وجد % % وجرى مدمع له واستهلا % 3(@)(@@) % مغرم لا يعي الملامة في الح % % ب ولا يرعوي فيقبل عذلا % % 4(@)(@@) % ما يف يد المشوق يا سعد أمسى % % مكثرا من بكائه أو مقلا % 5(@)(@@) % صرعته العيون نجلا وهل تص % % رع إلا عيونها الغيد نجلا % % 6(@)(@@) % وسقته كأس الغرام وما كا % % ن ليشفي الغرام علا ونهلا % % 7(@)(@@) % ما يعاني من الصبابة صب % كان قبل الهوى عزيزا فذلا % 8(@)(@@) % قد أذل الغرام كل عزيز % % والهوى يترك الأعز الأذلا % % 9(@)(@@) % وبنفسي مهفهف العطف أحوى % % حرم الله من دمي ما استحلا % % 10(@)(@@) % قل لأحبابنا وهل يجمع الده % % ر على بعدهم من الدار شملا % % PageV01P451 11(@)(@@) % ما تسليت في سواكم ومن لي % % بفؤاد في غيركم يتسلى % % 12(@)(@@) % فرق الدهر بيننا بالتنائي % % وقضى بالنوى وما كان عدلا % % 13(@)(@@) % عللونا منكم ولو بخيال % يهتدي طيفه فيطرق ليلا % 14(@)(@@) % فعسى المهجة التي أظمأتها % % زفرة الوجد بعدكم أن تبلا % % 15(@)(@@) % إن ورقا ناحت على الغصن شجوا % أنا منها بذلك النوح أولى % % 16(@)(@@) % وشجتنا بنوحها حين ناحت % % فكأن الورقاء إذ ذاك ثكلى % % 17(@)(@@) % ذكرتني وربما هيج الذكر % زمانا مضى وعصرا تولى % % 18(@)(@@) % وهو مربع لظلمياء أقوى % % تسحب المزن في مغانيه ذيلا % % 19(@)(@@) % فسقى ملعب الغزال وميض % من هطول يسقي رذاذا وهطلا % % 20(@)(@@) % أفأشفي الجوى بآرام ربع % صح فيه نسيمه واعتلا % PageV01P452 21(@)(@@) % رب طيف من آل مي طروق % % زار همأ فقلت أهلا وسهلا % % 22(@)(@@) % نولتني الأحلام منه الأماني % % وانقضى عهده وما نلت نيلا % % 23(@)(@@) % إذ تصدى لمغرم مات صدا % وتولى حر الغرام وولى % % 24(@)(@@) % زائرا كالسراب لاح لصاد % قبل أن يذهب الظماء اضمحلا % % 25(@)(@@) % والليالي تريك كل عجيب % % وتزيد 
ms147	 الخطوب بالشهم عقلا % % 26(@)(@@) % وإذا ما محت أعاجيب شكل % % أثبتت من عجائب الدهر شكلا % % 27(@)(@@) % قد أكلت الزمان حلوا ومرا % وشربت الأيام خمرا وخلا % 28(@)(@@) % وأبت لي أبوتي أن أداري % % معشرا عن مدارك الفضل غفلا % % 29(@)(@@) % لا أداري ولا أماري ولا أش % % هد زورا ولا أبدل نقلا % % 30(@)(@@) % قد كفاني ربي استماحة قوم % % أشربوا في الصدور غلا وبخلا % % PageV01P453 31(@)(@@) % بأبي القاسم الذي في النا % % س نجارا وطاب فرعا وأصلا % % 32(@)(@@) % وإذا عددت بنيها المعالي % % كان أعلى بني المعالي محلا % 33(@)(@@) % فخر آل الزهير والجبل الباذخ % % أضحى على الجبال مطلا % % 34(@)(@@) % ظل من يستظل منه بظل % لا عدمناه في الأماجد ظلا % 35(@)(@@) % أي ناد ولم يكن لك فيه % % يجتدي سائل ويبلغ سؤلا % % 36(@)(@@) % بأبي وافر العطايا إذا ما % % أكثر النيل بالعطاء استقلا % % 37(@)(@@) % وعيال ذوو العقول عليه % % في أمور تدق فهما وعقلا % % 38(@)(@@) % عصمة للأفكار من خطأ الرأ % % ي وهاد للفكر من أن يضلا % 39(@)(@@) % نور الله منك قلبا ذكيا % ظلم الشك فيه لا شك تجلى % % 40(@)(@@) % غادر المح لفي أياديه خصبا % في زمان يغادر الخصب محلا % % PageV01P454 41(@)(@@) % كم أياد تلك الأيادي أفاضت % % وأسالت من وابل الجود سيلا % % 42(@)(@@) % سابق من يجيء بالفضل بعدا % لاحق بالجميل من كان قبلا % % 43(@)(@@) % شهد الله والأنام جميعا % أنه الصارم الذي لن يفلا % 44(@)(@@) % إن تجرده كاشفا لملم % فكما جردت يمينك نصلا % % 45(@)(@@) % وعلى ما يلوح لي منه مرآى % قرأ المجد سطره واستملا % 46(@)(@@) % يا حساما هززته مشرفيا % صقلته قين المروءة صقلا % % 48(@)(@@) % من جليل أعزك الله في العا % % لم قدرا سما فعز وجلا % 49(@)(@@) % أي ناد ولم يكن فيه % % آية من جميل ذكرك تتلى % % 50(@)(@@) % قد حكيت الشم الرواسي وقارا % وثباتا في الحادثات ونبلا % % 51(@)(@@) % لبس الشعر من مديحك حليا % ولا أراه بغيره يتحلى % % PageV01P455 52(@)(@@) % وبنات الأفكار لم ترض إلا % كفؤها من أكارم الناس بعلا % % 53(@)(@@) % أيها المنعم المؤمل للفضل % % حباك الإل ه ما دمت فضلا % % 54(@)(@@) % ألبستني نعمالك من قبل هذا % % من مفاخر 
ms148	 ليس تبلى % % 55(@)(@@) % كل يوم تراك عيناي عيد % عند مثلي ولا أرى لك مثلا % % 56(@)(@@) % فإذا قلت في ثنائك قولا % قيل لي أنت أصدق الناس قولا % % 57(@)(@@) % فبما نعمة علي وفضل % أثقلتني أيديك بالشكر حملا % % 58(@)(@@) % لا يزال العيد الذي أنت فيه % % عائدا بالسرور حولا فحولا % % PageV01P456 البحر : كامل تام 1(@)(@@) % أعلمت أي معالم ومعاهد % تذري عليها الدمع عبرة واجد % % 2(@)(@@) % وقف المشوق بها فشق فؤاده % % وأهاج نارا ما لها من خامد % % 3(@)(@@) % ولذلك الركب المناخ بها جوى % لا يستقر بها فؤاد الفاقد % % 4(@)(@@) % من ناشد لي في المنازل مهجة % % لو كان يجديها نشيد الناشد % % 5(@)(@@) % وتردد الزفرات بين جوانحي % % مما يصوب بمدمعي المتصاعد % % 6(@)(@@) % أضناني الشوق المبرح في الحشا % % حتى خفيت من الضنى عن عابدي % % 7(@)(@@) % ظعن الألى فتسابقت أظعانهم % % تجتاب بين دكادك وفدافد % % 8(@)(@@) % قل للطعنين من الهوى بقوامهم % % ماذا لقيت من القوام المائد % % 9(@)(@@) % إني لأذكرهم على حر الظما % % قد كدت أشرق بالزلازل البارد % % 10(@)(@@) % منعوا طروق الطيف في سنة الكرى % % هيهات يطرق ساهرا من راقد % % PageV01P457 11(@)(@@) % بانوا فشيعهم فؤاد وامق % ورجعت عنهم باصطبار بائد % % 12(@)(@@) % جاهدت فيهم لوم كل مفند % % لو أن لي في الحب أجر مجاهد % % 13(@)(@@) % مه يا عذول فقد أطلت مقصرا % في واجد تلحوه لا متواجد % % 14(@)(@@) % يا دار حياك الغمام بصيب % % ينهل بين بوارق ورواعد % % 15(@)(@@) % وسقى زمان اللهو فيك فإنه % % زمن مضى طربا وليس بعائد % % 16(@)(@@) % زمن لهوت به بكل خريدة % % لعبت محاسنها بلب العابد % % 17(@)(@@) % دارت علي الكأس في غسق الدجى % % فشربتها ذهبا بماء جامد % % 18(@)(@@) % وجريت طلقا في ميادين الهوى % % لمصارع من غنية ومصائد % % 19(@)(@@) % ولقد صحوت من الشباب وسكره % % ونظرت للدنيا بعيني زاهد % % 20(@)(@@) % من راح تغريه مطالع نفسه % % فيما يشان به فليس براشد % % PageV01P458 21(@)(@@) % إن كادني الطمع المبيد بكيده % % فلينظرن مخادعي ومكايدي % % 22(@)(@@) % وإذا قسا الخطب الملم فلا تلم % % حارب زمانك ما استطعت وجالد % % 23(@)(@@) % أعرضت عن بغداد إعراض امرىء % يرتاد ما يرضي مراد الرائد % % 24(@)(@@) % من بعد 
ms149	 ما غال الحمام أحبتي % % ولوى يدي بالنائبات وساعدي % % 25(@)(@@) % حتى رأيت الخير يخصب ربعه % % بأبي الخصيب ووجه عبد الواحد % % 26(@)(@@) % بأجل من أفرادته بفرائدي % % وأجل من قلدته بقلائدي % % 27(@)(@@) % وجه عليه من الجمال أسرة % تبدو فتنبي عن جميل عوائد % % 28(@)(@@) % في صبح ذاك الوجه سعد المشتري % % وشهاب ذاك الوجه حدس عطارد % % 29(@)(@@) % ابن المبارك لاسمه وسماته % % ومبارك في الناس أكرم والد % % 30(@)(@@) % سوق الأفاضل للفضائل كلها % % في سوقه إنفاق شعر الكاسد % % PageV01P459 31(@)(@@) % تفني أياديه الحطام تكرما % فيفوز يومئذ بذكر خالد % % 32(@)(@@) % تنهل راحته بصيب جوده % % عذب المراد منهل للوارد % % 33(@)(@@) % لم تبق راحته وجود يمينه % % من طارق للمكرمات وتالد % % 34(@)(@@) % لا زال في نعمائه وولائه % % فرح الودود ورغم أنف الحاسد % % 35(@)(@@) % لا تنكر الحساد من معروفه % % شيءا وليس لفضله من جاحد % % 36(@)(@@) % وأغر قد خفض الجناح لآمل % % بر رفعت إليه غر قصائدي % % 37(@)(@@) % ومن السعادة أن أجيء بسابق % % من بره أسعى إليه وقائد % % 38(@)(@@) % فأفوز منه بطلعة تجلو الدجى % % وتضيء بالحسب الصميم الماجد % % 39(@)(@@) % ولكم زردت مواردا من سيله % % فحمدت فيه مصادري ومواردي % % 40(@)(@@) % فإذا اعترفت من الكرام بفضله % % جاءت مكارمه بألفي شاهد % % PageV01P460 41(@)(@@) % شهد الرجال بفضله وبرأيه % % بموطن شتى مضت ومشاهد % % 42(@)(@@) % يمضي معاديه ويخطو هابطا % وترى مواليه بفخر صاعد % % 43(@)(@@) % يا من يغر لجهله في حلمه % % إياك من وثبات ليث لابد % % 44(@)(@@) % نقد الرجال رفيعهم ووضيعهم % % والزيف يظهر عند نقد الناقد % % 45(@)(@@) % بعدت عن الفحشاء خلائق % % بعد الصلاح من الزمان الفاسد % % 46(@)(@@) % يوم النوال تراه أول منعم % ولدى الصلاة تره أول ساجد % % 47(@)(@@) % لو لامست صم الجلامد كفه % % لتفجرت بالماء صم جلامد % % 48(@)(@@) % أطلقت ألسنة الثناء عليه في % % شعر يقيد في علاه شواردي % % 49(@)(@@) % قامت بخدمته السعادة عن رضى % كم قائم يسعى بخدمة قاعد % % 50(@)(@@) % وفدت عليك مع الخلوص قصيدة % % ولأنت أول مكرم للوافد % % PageV01P461 51(@)(@@) % لا غرو إن قصدتك ترغب بالغنى % % أرأيت غيرك مقصدا للقاصد % % 52(@)(@@) % فاقبل من الداعي إليك ما قدمته % % لا زلت ترفع بالفخار قواعدي % % PageV01P462 البحر 
ms150	 : - 1(@)(@@) % من أبي الهدى لاح فينا مظهر % فتجلى لنا بنور أزهر % 2(@)(@@) % هو كالبحر إن ترده تراه % % معدن الدر بل مقر الجوهر % % 3(@)(@@) % عدم الفضل من تباعد عنه % % ذاك في الغي قد أبى واستكبر % % PageV01P463 البحر : طويل 1(@)(@@) % زواج ابن ياسين زواج مبارك % يقر به عينا ويهنا ويسعد % % 2(@)(@@) % به الخير مجلوب إليه جميعه % % وفيه التهاني كلها تتولد % % 3(@)(@@) % تسر به من آل ياسين عصبة % لهم شرف في الأكرمين وسؤدد % % 4(@)(@@) % من القوم لم يصنع سواهم صنيعهم % % بل البر بل سادوا به وتفردوا % % 5(@)(@@) % وقد ورثوها عن أبيهم مكارما % وها هي في أبنائهم تتجدد % % 6(@)(@@) % ولم يبرحوا أبناء ياسين في الندى % % مناهل جود كالمناهل تورد % % 7(@)(@@) % هما ما هما في المكرمات كلاهما % % محمد في النجب الكرام وأحمد % % 8(@)(@@) % تعد كرام الناس في بلديهما % % فعدا ولم تعقد وراءهما يد % % 9(@)(@@) % بقيت بقاء النيرين محمد % % بناعم خفض العيش لا تتنكد % % 10(@)(@@) % وفي البشر والأرواح قولي مؤرخا % تزوجت فابقى في الهنا يا محمد % % PageV01P464 البحر : بسيط تام 1(@)(@@) % طهر فؤادك بالراحات تطهيرا % % ودم على نهبك اللذات مسرورا % % 2(@)(@@) % بادر إلى أخذ صفو العيش مبتهجا % فما أود لوقت الأنس تأخيرا % % 3(@)(@@) % فالوقت راق وقد راقت مسرته % % واليوم أصبح طي الزهر منشورا % % 4(@)(@@) % أما ترى الورق بالأوراق صادحة % % كأنها ضربتت بالروح صنطيرا % % 5(@)(@@) % والبرق مثل انقضاض الصقر وامضه % % تخاله من غراب الليل مذعورا % % 6(@)(@@) % يبدو فتحسبه في جنح داجية % بكف حام حساما لاح مشهورا % % 7(@)(@@) % ورب ليلة أنس بت أسهرها % % مسترا بظلام الليل تستبرا % % 8(@)(@@) % غصبت فيها الهنا من كأس غانية % % فطاعني الدهر مغصوبا ومجبورا % 9(@)(@@) % مزجت بالريق صرفا من معتقة % % 10(@)(@@) % وبت ملتثما وجنات ذي حور % % وبات يلثم ليث الغيل يعفورا % % PageV01P465 11(@)(@@) % فالواشي يعذلني والوجد يعذرني % % والصب غزال معذولا ومعذورا % % 12(@)(@@) % وعنبر الليل ما ولت عساكره % % حتى رأى من جيوش الصبح كافورا % % 13(@)(@@) % لله أحوى إذا صالت لواحظه % % أمسى بصارمها المشتاق منذورا % % 14(@)(@@) % إذا تجلى بأنوار الجبن على % % عشاقه دك من أحشائهم طورا % % 15(@)(@@) % كأن صورته 
ms151	 للعين إذ جليت % من فضة قدرت بالحسن تقديرا % % 16(@)(@@) % قد خط في خده لام العذار به % % مسكا فأصبح تخطيطا وتحريرا % % 17(@)(@@) % يا أيها الرشأ المغري بناظره % % قد عاد هاروت من جفنيك مسحورا % % 18(@)(@@) % لقد نصرت على كسر القلوب به % % مالي أرى طرفك المنصور مكسورا % % 19(@)(@@) % عهدي وعهدك لا زال اختلافهما % % كانا كحظي منسيا ومذكورا % % 20(@)(@@) % صفا لي العيش مخضرا جوانبه % % فما وجدت بحمد الله تكديرا % % PageV01P466 21(@)(@@) % لم لا أسر بأيام الهنا وأنا % % إن سر محمود يوما كنت مسرورا % % 22(@)(@@) % هو المشار إذا أمت حوادثها % % 23(@)(@@) % % فهما وعلما وأخلاقا وتدبيرا % % 24(@)(@@) % بالسعي لا بالمنى والعجز أدركها % % 25(@)(@@) % هذا الإمام شهاب الدين ثاقبه % % أزال في نور صبح الحق ديجورا % % 26(@)(@@) % كم ملحد هو بالبرهان أفحمه % % من ينصر الله يوما كان منصورا % % 27(@)(@@) % إن الشريعة باهت منه في بطل % % حامي حماها وباني حولها سورا % % 28(@)(@@) % لو لامست حجر الصماء راحته % % تفجرت بزلال الماء تفجيرا % % 29(@)(@@) % سعى إلى المجد في سيف وفي قلم % % وعانق البيض حتى عانق الحورا % % 30(@)(@@) % لو صور المجد تصويرا على رجل % % ما كان إلاك أوصافا وتصويرا % % PageV01P467 31(@)(@@) % وكم نثرت على الأسماع در فم % فكان ذيالك المنثور منثورا % % 32(@)(@@) % فأنت أدرك من فيها غوامضها % % وأنت أفصح أهل العلم تقريرا % % 33(@)(@@) % حجت لبيتك أهل العلم أجمعهم % % فكان حجهم إذ ذاك مبرورا % % 34(@)(@@) % لقد زهت بك دار العلم حيث غدت % % 35(@)(@@) % غمرتنا بأياديك التي سلفت % % لا زالت في نعماء الله مغمورا % % 36(@)(@@) % أرى اجنماع الغنى لي والكمال إذا % % رأيتني منك ملحوظا ومنظورا % % 37(@)(@@) % وإن أنخت لدى علياك راحلتي % % كنت الأمير وكان الدهر مأمورا % % 38(@)(@@) % ليهنك اليوم أبناء لهم نسب % % أضحى على جبهة الأيام مسطورا % % 39(@)(@@) % إن الرواة التي تروي مناقبهم % % عنهم روت خبرا بالمجد مأثورا % % 40(@)(@@) % اليوم إن كنت مولانا مطهرهم % % فالله طهرهم من قبل تطهيرا % % PageV01P468 البحر : وافر تام 1(@)(@@) % لآل المصطفى علم وجود % يحوزهما مجيد أو نجيب % 2(@)(@@) % وفي هذا الزمان من البرايا % % لمحمودين ساقهما النصيب % % 3(@)(@@) % تورث علمهم قمر الفتاوى % % وشمس 
ms152	 ما لها أبدا مغيب % % 4(@)(@@) % وحاز فخارهم وكذا علاهم % % وجودهم تورثه النقيب % % PageV01P469 البحر : رمل تام 1(@)(@@) % هذه يا صاح أوقات الهنا % % وبلوغ النفس أقصى الأمل % 2(@)(@@) % جمعت من كل شيء أحسنا % % لذة في غيرها لم تكمل % 3(@)(@@) % فخذا من عيشنا صفوته % بكؤوس الراح والساقي مليح % % 4(@)(@@) % بين روض آخذ زينته % % ولسان البم والزير فصيح % 5(@)(@@) % ضرج الورد بها وجنته % % والشقيق الغض إذ ذاك جريح % 6(@)(@@) % تحسب النرجس فيها أعينا % % شاخصات نحونا بالمقل % 7(@)(@@) % مال غصن البان تيها وانثى % % في هواها ميلان الثمل % 8(@)(@@) % مربع للهو منذ انتظما % % أطرب الأنفس في روح وراح % % 9(@)(@@) % ما بكاه القطر إلا ابتسما % % لبكاه بثغور من أقاح % 10(@)(@@) % وشدت في الدوح ورقاء الحمى % % ما على الورقاء في الشدو جناح % PageV01P470 11(@)(@@) % مغروم ليس له عنه غنى % % حبين يملي رجزا في زجل % % 12(@)(@@) % ولقد أصغى إليها أذنا % فشجت قلب الخلي دون الملي % % 13(@)(@@) % زادنا لحن الأغاني طربا % خبرا يطربنا عن وتر % 14(@)(@@) % والأماني بلغتنا أربا % فقضيناها إذن بالوطر % 15(@)(@@) % ونظرنا فقضينا عجبا % تطلع الشمس بكف القمر % 16(@)(@@) % في ليال أظفرتنا بالمنى % % وكؤوس الراح فيها تنجلي % % 17(@)(@@) % تذهب الهم وتنفي الحزنا % % بنشاط مطلق من كسل % 18(@)(@@) % بحياة الطاس والكاس عليك % نزه المجلس من كل ثقيل % 19(@)(@@) % وتحكم إنما الأمر إليك % % ولك الحكم ومن هذا القبيل % % 20(@)(@@) % كيف لا والكأس تسقى من يديك % % ما على المحسن فيها من سبيل % PageV01P471 21(@)(@@) % ولك الله حفيظا ولنا % % حيثما كنت وما شئت افعل % 22(@)(@@) % و جر حكم الحب فينا وبنا % % أنت مرضي وإن لم تعدل % % 23(@)(@@) % حبذا مجلسنا من مجلس % جامع كل غريب وعجيب % % 24(@)(@@) % نغم العود وشعر الأخرس % % ومحب مستهام وحبيب % % 25(@)(@@) % يتعاطون حياة الأنفس % في بديع اللفظ والمعنى الغريب % 26(@)(@@) % بابلي السحر معسول الجنى % % أين هذا مشتيار العسل % 27(@)(@@) % وإذا مر نسيم بيننا % % قلت هذا ويحكم من غزلي % % 28(@)(@@) % آه ممن ساءني في نسكه % ويراني حاملا عبء الذنوب % 29(@)(@@) % قد عرفنا زيفه في سكبه % % فإذا كل مزاياه عيوب % 30(@)(@@) % قال لي 
ms153	 تبت وذا إفكه % % أنا لا والله لا أرضي أتوب % % PageV01P472 31(@)(@@) % عن مليح صرحت عنه الكنى % % توبة في حبه لم تقبل % 32(@)(@@) % وإذا ساء غيور أحسنا % % بحميا رشفات القبل % % 33(@)(@@) % أترك المغبق والمصطحبا % % زمن الورد وأيام الربيع % 34(@)(@@) % بعد أن أغدو بها منشرحا % فلقد جئت لعمري بشنيع % 35(@)(@@) % فأدرها وانتهب لي زمنا % بحلول الشمس برج الحمل % % 36(@)(@@) % وأرخني إنما ألقى العنا % % من خليل مغرم بالعذل % 37(@)(@@) % أجتلي الكاسات تهوي أنجما % % ولها فينا طلوع ومغيب % 38(@)(@@) % وأرى أوقاتها مغتنما % وإليها رحت ألهو وأطيب % 39(@)(@@) % لم أضعها فرصة لاسيما % % في ختان الغر أبناء النقيب % 40(@)(@@) % علوي الأصل علوي الثنا % % سيد السادات مولانا علي % % PageV01P473 41(@)(@@) % الرفيع القدر والعالي البنا % % مستهل الوبل عذب المنهل % 42(@)(@@) % ابن باز الله عبد القادر % % علم الشرق وسلطان الرجال % 43(@)(@@) % لم يزالوا طاهرا من طاهر % فهم الطهر على أحسن حال % % 44(@)(@@) % وهم في كل وقت حاضر % في جمال مستفاض وجلال % % 45(@)(@@) % يلحظون السعد يغشون السنا % % يلبسون الفخر أسنى الحلل % % 46(@)(@@) % لهم التشبيه في هذي الدنا % % ملة الإسلام بين الملل % 47(@)(@@) % لأويقات زمان الاعتدال % قد تحريتم وما أحراكم % 48(@)(@@) % لختان النجب البيض الفعال % % الميامين وما أدراكم % 49(@)(@@) % فلقد أرخه العبد فقال % % آل بيت المصطفى بشراكم % % 50(@)(@@) % بختان في سرور وهنا % % دائم بالوصل لم ينفصل % % PageV01P474 51(@)(@@) % وبحمد الله قد نلنا المنى % % وظفرنا منكم بالأمل % PageV01P475 البحر : بسيط تام 1(@)(@@) % متى أرى هذه الأيام مسعفة % والدهر ينجز وعدا غير موعود % 2(@)(@@) % والنفس تقضي بمطلوب لها وطرا % ينوب عن كل مفقود بموجود % % 3(@)(@@) % ألقى خطوب الليالي وهي عابسة % كما تصادم جلمود بجلمود % % 4(@)(@@) % فما أطعت الهوى فيما يراد به % % ولا تطريت بين الناي والعود % % 5(@)(@@) % ولا ركنت إلى صهباء صافية % قديمة العصر من عصر العناقيد % % 6(@)(@@) % إني لأنزع مشتاقا إلى وطني % % والنوق تنزع بي شوقا إلى البيد % % 7(@)(@@) % وطالما قذفت بي في مفاوزها % % أخفاف تلك المطايا الضمر القود % % 8(@)(@@) % لئن ظفرت بمحمود وإخوته % % ظفرت من هذه الدنيا بمقصودي % % 9(@)(@@) % بيض الوجوه كأمثال البدور سنا % يطلعن 
ms154	 في أفق تعظيم وتمجيد % % 10(@)(@@) % تروي شمائلهم ما كان والدهم % % يرويه من كرم الأخلاق والجود % % PageV01P476 11(@)(@@) % فياله والد عز النظير له % % وجاء منه لعمري خير مولود % % 12(@)(@@) % من طيب طاب في الأنجاب محتده % % كما يطيب عبير الند والعود % % 13(@)(@@) % إذا ذكرت أياديه التي سلفت % جاذبت بالمدح أطراف الأناشيد % % 14(@)(@@) % قلدت جيد القوافي في مدايحه % % ما لا يقلد جيد الخرد الغيد % % 15(@)(@@) % يغرد الطرب النشوان حينئذ % فيها بأحسن تغريد وترديد % % 16(@)(@@) % أبو الخصيب خصيب في مكارمه % % ومنزل السعد لا يشقى بمعود % % 17(@)(@@) % لا تصدر الناس إلا عنه في جدة % % ونائل من ندى كفيه موردود % % 18(@)(@@) % يزيدني شكره فضلا ومكرمة % % كأنني قلت يا نعماءه زيدي % % 19(@)(@@) % يرجو المؤمل فيه ما يؤمله % % ليس الدعاء له يوما بمردود % % 20(@)(@@) % تجري محبته في قلب عارفه % % لفضله مثل مجرى الماء في العود % % PageV01P477 21(@)(@@) % فكلما سرت مشتاقا لزورته % % وجدت مسراي محمودا لمحمود % % 22(@)(@@) % وإن أتته القوافي الغر أتحفها % % بشاهد من معاليه ومشهود % % 23(@)(@@) % تلك المكارم تروى عن أب فأب % من الأكارم عن آبائه الصيد % % 24(@)(@@) % لله درك ما أنداك من رجل % % بيض أياديك في أيامنا السود % % 25(@)(@@) % ليهنك العيد إذا وافاك مبتهجا % بطلعة منك زانت بهجة العيد % % PageV01P478 البحر : رجز تام 1(@)(@@) % قدمت بالبشر وبالبشائر % % وزرتنا فحبذا من زائر % 2(@)(@@) % وجئت بالخير علينا مقبلا % لكل باد ولكل حاضر % % 3(@)(@@) % فكنت كالمزن همت بماطر % % وكنت كالروض زها لناظر % % 4(@)(@@) % لو نظر الناظر ما صنعته % % نمقه بدفتر المفاخر % % 5(@)(@@) % أنضيت للعمران فلك همة % فعمرت كل مكان داثر % % 6(@)(@@) % وهذه العمارة اليوم لكم % % معمورة الأكتاف بالعشائر % % 7(@)(@@) % نظمت بالتدبير منك شملها % % بناظم للعدل غير ناثر % % 8(@)(@@) % وإنما دانت لحكم عادل % ولم يدن ممتنع لجائر % % 9(@)(@@) % أمنتها من شر ما ينوبها % % بالناس في أمن وخير وافر % % 10(@)(@@) % ولم تخن عهد امرىء عاهدته % % حوشيت من عهد الخؤون الغادر % % PageV01P479 11(@)(@@) % جبرت بالإنصاف كسرا ماله % % غيرك فيما بينهم من جابر % % 12(@)(@@) % عفوت عن كبارهم تكرما % وهذه من شيم الأكابر % % 13(@)(@@) % وقمت في الحكم مقام نامق 
ms155	 % وأنت أهدى لذوي البصائر % % 14(@)(@@) % فتارة تزجر في مواعظ % وتارة تطعن بالزواجر % % 15(@)(@@) % إذا هززت بالبنان قلما % أغناك عن هز الحسام الباتر % % 16(@)(@@) % هذا وأنت واحد منفرد % تغني عن الألف من العساكر % % 17(@)(@@) % يريك رأي بشهاب فطنة % % بواطن الأشياء كالظواهر % % 18(@)(@@) % ملكت باللطف رقاب عصبة % أمنع من ليث هصور خادر % % 19(@)(@@) % فكم لكم حينئذ من حامد % % وكم لكم يومئذ من شاكر % % 20(@)(@@) % عمرتموها فغدت عمارة % كما أردتم لمراد الخاطر % % PageV01P480 21(@)(@@) % فقل لمن يسأل عن تاريخها % % قد عمرت أيام عبد القادر % % PageV01P481 البحر : وافر تام 1(@)(@@) % نقيب السادة الأشراف زانت % % بطلعته المنازل والقصور % 2(@)(@@) % بنى مقصورة شرفت بناء % أعدت بالسرور لمن يزور % 3(@)(@@) % فقلت لسيد النقباء أرخ % % مبانيها يشرفها المشير % PageV01P482 البحر : متقارب تام 1(@)(@@) % نهني العراق بحكم جديد % وسر الحجاز برأي سديد % 2(@)(@@) % بحكم الرشيد مشير العراق % % ملاذ الطريد مجير الرشيد % 3(@)(@@) % مشير إذا استمطر البارقات % % أغاث الأنام بودق الحديد % % 4(@)(@@) % حميد مجيد لقد خصه % % بأهل العراق الحميد المجيد % 5(@)(@@) % فنامت به فتن بأسها % % يبيد الطريف ويفني التليد % 6(@)(@@) % وقد أقبل السعد إذ أرخوا % % أمام المشير محمد رشيد % PageV01P483 البحر : طويل 1(@)(@@) % وظبي دعتني للحروب لحاظه % % وهيهات من تلك اللحاظ خلاص % 2(@)(@@) % تصدى لحرب المستهام وما له % % سوى اللحظ سهم والنقاب دلاص % 3(@)(@@) % فلما أجلت الطرف أدميت خده % % وأدمى فؤادي والجروح قصاص % PageV01P484 البحر : طويل 1(@)(@@) % يمينا برب النجم والنجم إذ يسري % % ومن أنزل الآيات في محكم الذكر % 2(@)(@@) % لقد أشرقت بغداد منذ أتيتها % % كم تشرق الظلماء من طلعة البدر % % 3(@)(@@) % فراحت كما راحت خميلة روضة % سقتها الغوادي المستهل من القطر % % 4(@)(@@) % وما سرها شيء كمقدمك الذي % % يبدل منها صورة اليسر بالعسر % % 5(@)(@@) % وكم فرح من بعد حزن وراحة % % من النصب الجاني على العدل بالجور % % 6(@)(@@) % فلا ذنب للأيام من بعد هذه % % فقد جائت الأيام للناس بالعذر % % 7(@)(@@) % تناءيت عنها لا ملالا ولا قلى % % ولكن رأيت الوصل من ثمر الهجر % % 8(@)(@@) % وما غبت عنها حين غبت حقيقة % % وكيف ولم تخرج هنيهة من فكر % % 9 
ms156	(@)(@@) % رأيت مقاما لا يرى الفرق عنده % % من العالم النحير والجاهل الغمر % % 10(@)(@@) % ولا بد للأشياء من نقد عارف % يميز بين الصفر والذهب التبر % % PageV01P485 11(@)(@@) % غضبت ولا يرضيك إلا نهوضه % % إذا ربض الليث الهصور على الضر % 12(@)(@@) % يجر عليها فيك أردية الفخر % % تتبع آثار الخطوب وتستقري % % 13(@)(@@) % وأقلعت عن دار جدير بأنها % % تشين أباة الضيم فيها وإن تزري % % 14(@)(@@) % وما زلت تطوي كل بيداء نفنف % % وتركب منها ظهر شاهقة وعر % % 15(@)(@@) % وسرت إلى مجد وسؤدد % % فمن منزل عز إلى منزل فخر % % 16(@)(@@) % إلى الغاية القصوى التي ما وراءها % % إذا عدت الغايات مأوى لذي حجر % % 17(@)(@@) % نشرت بأرض الروم علما طويته % % بجنبيك حتى ارتاع في ذلك النشر % % 18(@)(@@) % وسر أمير المؤمنين بما رأى % % ولاح وايم الله منشرح الصدر % % 19(@)(@@) % أشار إليك الدين أنك ركنه % % وقال له الإسلام أشدد به أزري % % 20(@)(@@) % وما ظنت الروم العراق بأنه % % يجر عليهما فيك أردية الفخر % % PageV01P486 21(@)(@@) % وما شاد قسطنطين ما شدت من على % مؤيدة تبقى على أبد الدهر % % 22(@)(@@) % فدتك الأعادي من رفيع محلق % % كأن يبتغي وصلا من الأنجم الزهر % % 23(@)(@@) % كفى الروم فخرا لو درت مثلما تدري % % وهيهات أن تدري وهيهات أن تدري % % 24(@)(@@) % بما قد حباك الله منه بفضله % % من الهيبة العظمى ومن شرف النجر % % 25(@)(@@) % وآيتك الآيات جئت بما انطوت % عليها من الأسرار في السر والجهر % % 26(@)(@@) % كشفت معمها وخضت غمارها % % وأنفقت في تفسيرها أنفس العمر % % 27(@)(@@) % وأوضحت أسرار الكتاب بفطنة % تزيل ظلام الليل عن غرة الفجر % % 28(@)(@@) % وقفت على إيضاح كل عويصة % مواقف لم تعرف لزيد ولا عمرو % % 29(@)(@@) % وأغنيت بالأسفار وهي كوامل % % ثمانية عن ما حوت مائتا سفر % % 30(@)(@@) % ومن حاز ما قد حزت علما فإنه % % غنى عن الدنيا ملي من الوفر % % PageV01P487 31(@)(@@) % إذا احتاجك السلطان تعلم أنه % % بذلك يمتاز المقل من المثري % % 32(@)(@@) % أرى دولة أصبحت من علمائها % % مؤيدة الأحزاب بالفتح والنصر % % 33(@)(@@) % أرعت أولي الألباب منها بحكمة % % بروح أرسطاليس منها على ذعر % % 34(@)(@@) % قضت عجبا منها العقول بما رأت 
ms157	 % % وما بصرت يوما بمثلك في عصر % % 35(@)(@@) % برزت مع البرهان في كل موطن % % من البحث لا يبقي اللباب مع القشر % % 36(@)(@@) % فأفسدت للإلحاد أمرا دحضته % % فليس له فيها ولي من الأمر % % 37(@)(@@) % عذوبة لفظ في فصاحة منطق % وعينيك لولا حرمة الخمر كالخمر % % 38(@)(@@) % ورب بيان في كلام تصوغه % % إذا لم يكن سحرا فضرب من السحر % % 39(@)(@@) % وما زالت بالحساد حتى تركتها % % وقد طويت منها الضلوع على الجمر % % 40(@)(@@) % فتكت بها فتك الكمي بسيفه % % كما يفتك الإيمان في ملة الكفر % % PageV01P488 41(@)(@@) % وكنت أمني النفس فيك بأن أرى % % صديقك في خير وخصمك في شر % % 42(@)(@@) % وما زال قولي قبل هذا وهذه % % لعلي أرى الأيام باسمة الثغر % % 43(@)(@@) % فلله عندي نعمة لا يفي بها % % بما قد بلغت اليوم حمدي ولا شكري % % 44(@)(@@) % وما نلت مقدار الذي أنت أهله % على عظم ما نولت من رفعة القدر % % 45(@)(@@) % كأني بقوم فارقوك فأصبحو % % ولوعتهم تذكو وعبرتهم تجري % % 46(@)(@@) % تحن إلى مرآك في كل ساعة % فتأسف إن سافرت عنهم مع السفر % % 47(@)(@@) % وإن سمحت منهم بمثلك أنفس % فما هي إلا أسمح الناس بالبر % 48(@)(@@) % وما صبرت عنك النفوس وإنما % % يصبرها تعليل عاقبة الصبر % % 49(@)(@@) % تغربت عاما طال كالشهر يومه % % ويا رب يوم كان أطول من شهر % % 50(@)(@@) % تكلفت أمر للحلاوة بعده % % ولا تخطب الحسناء إلا على مهر % % PageV01P489 51(@)(@@) % وإني بتذكاريك آنا فمثله % % صريع مدام لا يفيق من السكر % % 52(@)(@@) % مللت الثوى حتى طربت إلى النوى % % وحتى رأيت الأرض أضيق من شبر % % 53(@)(@@) % ولو أنني أسطيع عنه تتزحزحا % قذفت إليك العيس في المهمة القفر % % 54(@)(@@) % وليس لنفسي عنك في أحد غنى % وكيف يرى الظامي غنيا عن البحر % % 55(@)(@@) % بعثت إلينا بالحياة لأنفس % على رمق يدعو إلى البعث والنشر % % 56(@)(@@) % فضم إلينا من يعيد حياتنا % % كما ضم شطر الشيء يوما إلى شطر % % 57(@)(@@) % فيا كثر ما قد نولتنا يد المنى % % وعادتها الإمساك بالنائل النزر % % 58(@)(@@) % لتصفو لنا الدنيا فقد طاب عيشنا % % وضاء محياها بأيامك الغر % % 59(@)(@@) % أعادت علينا العرف 
ms158	 من بعد فقده % % فلا قابلتنا بعد ذلك بالنكر % % 60(@)(@@) % نشير إلى هذا الجناب كأننا % % نشير إلى رؤيا الهلال من الفطر % % PageV01P490 61(@)(@@) % وما كان يوم العيد بمثله % % إذا كان في فطر وإن كان في نحر % % 62(@)(@@) % وذلك يوم يعلم الله أنه % % ليذهب تعبيس الحوادث بالبشر % 63(@)(@@) % لك الفضل والحسنى قريبا ونائيا % وأيد لأيد من أناملها العشر % 64(@)(@@) % ولو حصدت أيديك فينا حصرتها % % ولكنها مما يجل عن الحصر % % PageV01P491 البحر : وافر تام 1(@)(@@) % أتنكر منك ما تطوي الضلوع % وقد شهدت عليك به الدموع % 2(@)(@@) % ولولا أن قلبك مستهام % لما أودى بك البرق اللموع % % 3(@)(@@) % ولا هاجت شجونك هاتفات % % تكتم ما تكابد أو تذيع % % 4(@)(@@) % تشوقك الربوع وكل صب % تشوقه المنازل والربوع % % 5(@)(@@) % ليال بالتواصل ما ضيات % % بحيث الشمل جميع % 6(@)(@@) % وأقمار غربن فليت شعري % % ألا بعد الغروب لها طلوع % % 7(@)(@@) % أمرت القلب أن يسلو هواها % % على مضض ولكن لا يطيع % % 8(@)(@@) % وما أشكو الهوى لو أن قلبي % % تحمل بالهوى ما يستطيع % % PageV01P492 البحر : وافر تام 1(@)(@@) % أنيخاها فقد بلغت مناها % % وغادرها المسير كما تراها % % 2(@)(@@) % سلكت بها فجاج الأرض حتى % % أضر بها وأوهنها قواها % % 3(@)(@@) % فسلني كيف جابتها قفارا % وكيف فدافدها خطاها % % 4(@)(@@) % وما أنسى الوقوف على رسوم % عناني في الصبابة ماعناها % % 5(@)(@@) % قضى بوقوفه المشتاق فيها % % وجوها يا أميمة لا أراها % % 6(@)(@@) % وقفت أناشد الأطلال منها % % ديونا للمنازل ما قضاها % % 7(@)(@@) % واذكر ما هنالك طيب عيش % به تجري النفوس على مداها % % 8(@)(@@) % جرينا في ميادين التصابي % % إلى اللذات نستحلي جناها % % 9(@)(@@) % فواها للذائذ كيف ولت % % وآها من تصرمها وآها % % 10(@)(@@) % تدار من المدام على الندامى % % كؤوس الراح تشرق في سناها % % PageV01P493 11(@)(@@) % وألحان المثالث والمثاني % % يغنيها فتطرب في غناها % % 12(@)(@@) % وينظما اجتماع في رياض % نثار الطل يلبسها حلاها % % 13(@)(@@) % وقد أملت حمائمها علينا % % من الأوراق شيئا من أساها % % 14(@)(@@) % كأن الورق حين بكت وأبكت % رماها بالقطيعة من رماها % % 15(@)(@@) % تكتم أدمعا وتبوح وجدا % وتعرب ما هنالك عن جواها % % 16(@)(@@) % ورب مديرة كأس الحميا % % أخذت 
ms159	 بكفها ورشفت فاها % % 17(@)(@@) % ومسود الإهاب من الدياجي % % كشفت بشهب أكؤسنا دجاها % % 18(@)(@@) % وعانقت القوام اللدن منها % % و عين الواشي يحجبها عماها % % 19(@)(@@) % فآونة ترشفني طلاها % % وآونة ترشفني لماها % % 20(@)(@@) % ومن عجب أذل لذات دل % وتسبيني المحاسن في هواها % % PageV01P494 21(@)(@@) % ولي نفس متى دعيت لذل % نهاها عن إجابته نهاها % % 22(@)(@@) % أبت نفسي مداناة الدنايا % % وأغنتها القناعة عن غناها % % 23(@)(@@) % وهل تستعبد الأطماع حرا % إذا عرضت له الدنيا ازدراها % % 24(@)(@@) % ولست ألين والأيام تقسو % % بشدتها ولم أطلب رخاها % % 25(@)(@@) % وأرض يفرق الخريت فيها % % ويفزع من مهالك ما يراها % % 26(@)(@@) % سلكت فجاجها ومرقت منها % % مروق النبل يبعد مرتماها % % 27(@)(@@) % سليني كيف جربت الليالي % % وكيف عرفتها وعرفت داها % % 28(@)(@@) % بلوت الناس قرنا بعد قرن % وكنت بها أحق من ابتلاها % % 29(@)(@@) % فلم أزدد بها إلا اختبارا % ولم أزدد بها إلا انتباها % % 30(@)(@@) % وفي عبد الحميد بديع شعري % % مناقب عن معاليه رواها % % PageV01P495 31(@)(@@) % نعمت بفضله وشكرت منه % % يدا لا زال يغمرني نداها % % 32(@)(@@) % فما استعذبت غير ندى يديه % % وما استعذبته مما عداها % % 33(@)(@@) % فلو أني وردت البحر عذبا % أنفت من الموارد ما خلاها % % 34(@)(@@) % وإن الله أودع فيه معنى % لتسمية المكارم مذ براها % % 35(@)(@@) % من السادات من أعلى قريش % سلالة خير خلق الله طه % % 36(@)(@@) % شديد البأس ألطف من نسيم % % تعطره الأزاهر من شذاها % % 37(@)(@@) % يخوض غمارها الهيجاء خوضا % وماء الموت يرشح من ظباها % % 38(@)(@@) % ويرفع راية المنصور فيها % % ويخفض من أعاديه الجباها % % 39(@)(@@) % % إليه العز يتجه اتجاها % % 40(@)(@@) % تريه بوطن الآراء تبدو % % فلم تحجب لعمرك ما زراها % % PageV01P496 41(@)(@@) % أرته زينة الأمجاد تزهو % % بأردية المحاسن فارتداها % % 42(@)(@@) % تولى والولاية فيه أضحت % % 43(@)(@@) % وأحيا بالعمارة كل أرض % وأجرى في ضواحيها المياها % % 44(@)(@@) % وأمن بالصيانة ساكنيها % % وأصبح فيه محميا حماها % % 45(@)(@@) % حماها حيث كانت من لدنه % % بعين عناية ممن رعاها % % 46(@)(@@) % ودبرها بلطف لا بعنف % فأرشدها وألهمها هداها % % 47(@)(@@) % % فما مدت إلى أحد يداها % % 48(@)(@@) % فهل من مبلغ عني ثناء % تقي الدين يشكره شفاها % % 49(@)(@@) % ربما أسدى 
ms160	 من الحسنى إلينا % % وماعرف الأماجد فاجتباها % % 50(@)(@@) % تفرس بالرجال فزاد علما % فولاها الأمور بمقتضاها % % PageV01P497 51(@)(@@) % وسيرنا فالساحته الأماني % % 52(@)(@@) % إليك ركبتها في البحر تجري % % من الفلك السوابق في سراها % % 53(@)(@@) % تنفس بالدخان وفي حشاها % % لظى نار مسعرة لظاها % % 54(@)(@@) % ويخفق وهي مثل الطير سبحا % جناحاها إذا دارت رحاها % % 55(@)(@@) % جرت مجرى الرياح بلا توان % فما احتاجت إلى ريح سواها % % 56(@)(@@) % وما زلنا بها حتى بلغنا % % من الامال أقصى مبتغاها % % 57(@)(@@) % بقيت لنا مدى الأيام ذخرا % نراها فيك أحسن ما نراها % % 58(@)(@@) % فمثلك في المكارم لا يجارى % % ومثلك في الأكارم لا يضاهى % % PageV01P498 البحر : بسيط تام 1(@)(@@) % في الأربعاء لخمس كن من صقر % بدر المسرة شاهدنا مطالعه % 2(@)(@@) % أرخت طالع داود بمولده % % كانت الشمس بالجوزاء طالعه % PageV01P499 البحر : كامل تام 1(@)(@@) % هنيت بالفرمان والنيشان % % من جانب الملك العظيم الشان % 2(@)(@@) % ملك إذا عد الملوك وجدتها % % من دونه بالعز والسلطان % 3(@)(@@) % متفرد في العالمين وواحد % بين الأنام فما له من ثان % % 4(@)(@@) % وتقول إن أبصرته في موكب % فحلاله وجماله سيان % % 5(@)(@@) % نعمت بدولته البلاد وأشرقت % إشراق دين الله في الأديان % % 6(@)(@@) % وأمدها من سيرة نبوية % % في حكمة بالأمن والإيمان % % 7(@)(@@) % ولقد تلافى الله فيه عباده % % فالناس منه بحوزة وأمان % % 8(@)(@@) % فالله يعلم والبرية كلها % % أن المليك خليفة الرحمن % % 9(@)(@@) % كالشمس في كبد السماء وضوؤها % % يغشى بكل النفع كل مكان % % 10(@)(@@) % قد كان سر اللطيف فيه مكتمتا % % حتى استبان وضاق بالكتمان % % PageV01P500 11(@)(@@) % ولقد أراد الله في تأييده % % أن يرجع الطاغين بالخذلان % % 12(@)(@@) % وإذا نظرت إلى طوية ذاته % % نظرا إلى المعروف والإحسان % % 13(@)(@@) % أيقنت أن وجوده لوجودنا % % كالماء ينقع غلة الظمآن % % 14(@)(@@) % ملك إذا زخرت بحار نواله % % يخشى على الدنيا من الطوفان % % 15(@)(@@) % فاقت بنو عثمان في سطانها % % بالدين والدنيا بني ساسان % % 16(@)(@@) % فتحوا البلاد ودوخوها عنوة % وجرت مدائحهم بكل لسان % % 17(@)(@@) % فهم العباد الصالحون وذكرهم % % قد جاء بعد الذكر في لاقرآن % % 18(@)(@@) % هذا أمير المؤمنين وهذه % % آثاره من حازم يقظان % % 19(@)(@@) % جعل العراق بنامق في 