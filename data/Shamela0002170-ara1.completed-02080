ms2061	 وأبا زرعة يقولان ذلك.(@)(@@)(@@)(@@) $ 179 -(@)(@@) عطارد روى عن ابن عمر أنه قال من تضييع الامانات النظر في الدور والجحرات روى عنه وهيب بن الورد المكى العابد سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 180 -(@)(@@) عطارد بن عبد الله روى عن معاوية بن ثابت روى عنه أبو يعفور عبد الرحمن بن عبيد بن نسطاس العامري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 181 -(@)(@@) عطارد بن عبد الله روى عنه عنبسة بن سعيد بن غنيم الكلاعى سمعت أبي يقول ذلك وسمعته يقول هو مجهول. PageV07P033(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عبيسا(@)(@@)(@@)(@@) $ 182 -(@)(@@) عبيس بن بيهس بصرى روى عن ابيه وعطاء واشعث بن عثمان ويقال اشعث بن عمرو التميمي سمعت أبي يقول ذلك، وسألته عنه فقال صالح(@)(@@) الحديث.(@)(@@)(@@)(@@) $ 183 -(@)(@@) عبيس بن ميمون أبو عبيدة التميمي البصري روى عن ثابت البناني وأبي المهزم ويزيد الرقاشي وبكر بن عبد الله المزني روى عنه مسلم بن ابراهيم والقوار يرى واحمد بن عبدة سمعت أبي يقول ذلك، قال أبو محمد وروى عن معاوية بن قرة وعون بن أبي راشد روى عنه أبو داود الطيالسي ومعلى بن اسد وهشام الرازي وابراهيم بن حسن العلاف (نا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال سألت أحمد بن حنبل عن عبيس بن ميمون فقال له أحاديث منكرة - 1) .(@)(@@) نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى ابن معين يقول عبيس بن ميمون (ليس بشئ، نا عبد الرحمن نا محمد بن إبراهيم نا عمرو بن على قال عبيس بن ميمون - 2) كثير الخطاء والوهم متروك الحديث، حدثنا عبد الرحمن قال سألت أبي وأبا زرعة عن عبيس بن ميمون فقال ابى هو ضعيف الحديث منكر الحديث وقال أبو زرعة هو ضعيف الحديث.(@)(@@)(@@)(@@) $ 184 -(@)(@@) عبيس بن مرحوم بن عبد العزيز العطار المدينى بصري روى عن أبيه وعن بكير بن ابى السميط وحاتم بن اسمعيل والنضر بن عربي وروى عنه أبي، نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلي قال 
ms2062	 نا عثمان بن سعيد قال سألت يحيى بن معين عن عبيس كيف حديثه؟ فقال ثقة، نا عبد الرحمن سمعت أبي يقول نا عبيس بن مرحوم وكان ثقة وفى حديثه شئ.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عياذا(@)(@@)(@@)(@@) $ 185 -(@)(@@) عياذ بن عبد عمرو (3) الأزدي روى أبو عاصم النبيل قال حدثنا PageV07P034(@)(@@) بشر بن صحار بن معارك بن بشر بن عياذ بن عبد عمرو الازدي انه سمع مارك ابن بشر بن عياذ أن عياذ بن عبد عمر وحدثهم أنه أتى النبي صلى الله عليه وسلم فحدثه وكان تبعه قبل فتح مكة ودعا له قال فرأيت خاتم النبوة، سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 186 -(@)(@@) عياذ بن مغراء العتكى روى عن عاصم بن المنذر روى عنه القاسم بن الفضل الحداني سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عنترة(@)(@@)(@@)(@@) $ 187 -(@)(@@) عنترة أبو وكيع الكوفى روى عن عثمان وعلي وابن عباس روى عنه ابنه هارون بن عنترة وأبو سنان الشيباني سمعت أبي يقول ذلك، نا عبد الرحمن قال سئل أبو زرعة عن عنترة والد هارون بن عنترة فقال كوفى ثقة.(@)(@@)(@@)(@@) $ 188 -(@)(@@) عنترة بن أبي العيص المازني روى عن حصين بن عرفطة اليربوعي روى عنه معلى بن أسد وعلى بن عثمان اللاحقي سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 189 -(@)(@@) عنترة أبو ماوية الكوفى روى عن على في يوم عاشوراء روى عنه الشيباني والعوام بن حوشب.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عابسا(@)(@@)(@@)(@@) $ 190 -(@)(@@) عابس الغفاري ويقال عبس الغفاري له صحبة روى عنه زاذان أبو عمر سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 191 -(@)(@@) عابس بن ربيعة النخعي روى عن عمر وعلي وابن مسعود(@)(@@) وعائشة روى عنه ابراهيم النخعي وابنه عبد الرحمن بن عابس سمعت أبي يقول ذلك.(@)(@@) PageV07P035(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عتبان(@)(@@)(@@)(@@) $ 192 -(@)(@@) عتبان بن مالك الانصاري احد بنى سالم وكان اعمى يؤم قومه على عهد النبي صلى الله عليه وسلم روى عنه محمود بن الربيع سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 193 -(@)(@@) عتبان بن عمرو بن 
ms2063	 اياس روى عن السائب بن يزيد روى عنه الضحاك بن عثمان الحزامي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عفيرا(@)(@@)(@@)(@@) $ 194 -(@)(@@) عفير بن ابى عفير الانصاري له صحبة روى شبابة ويزيد بن هارون عن عبد الرحمن بن أبي بكر عن محمد بن طلحة بن عبد الرحمن بن أبي بكر عن ابيه طلحة أن أبا بكر رضي الله عنه صحبه رجل يقال له عفير فقال أبو بكر ما سمعت النبي صلى الله عليه وسلم يقول في الود؟ فقال سمعت النبي صلى الله عليه وسلم يقول الود يتوارث والعداوة تتوارث، سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 195 -(@)(@@) عفير بن معدان الحضرمي الحمصى أبو عائذ المؤذن روى عن عطاء وسليم بن عامر روى عنه الوليد بن مسلم وبقية وابو اليمان ويحيى بن صالح الوحاظي سمعت أبي يقول ذلك، حدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عفير بن معدان لا شئ.(@)(@@) نا عبد الرحمن حدثني أبي قال سمعت دحيما يقول عفير بن معدان ليس بشئ لزم الرواية عن سليم بن عامر، وشبهه بجعفر بن الزبير وبشر بن نمير، نا عبد الرحمن قال سألت ابى عن عفير بن معدان فقال هو ضعيف الحديث يكثر(@)(@@) الرواية عن سليم بن عامر عن ابى امامة عن النبي صلى الله عليه وسلم بالمناكير ما لا اصل له لا يشتغل بروايته.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عيزارا(@)(@@)(@@)(@@) $ 196 -(@)(@@) عيزار بن حريث الكندى الكوفي روى عن ابن عباس والحسين(@)(@@) PageV07P036(@)(@@) ابن علي روى عنه أبو إسحاق الهمداني ويونس بن أبي إسحاق سمعت أبي يقول ذلك، نا عبد الرحمن أنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول العيزار بن حريث ثقة.(@)(@@)(@@)(@@) $ 197 -(@)(@@) عيزار بن جرول التنعى (1) من رهط سلمة بن كهيل روى عن علي رضي الله عنه روى عنه علقمة بن مرثد سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن 
ms2064	 إسحاق بن منصور عن يحيى بن معين انه قال العيزار بن جرول الحضرمي ثقة.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عثيما(@)(@@)(@@)(@@) $ 198 -(@)(@@) عثيم بن نسطاس المدينى مولى لآل كثير بن الصلت (الكندي - 3) روى عن سعيد بن المسيب وسعيد المقبرى وعطاء بن يسار روى عنه سفيان الثوري وعبد الله بن مسلمة القعنبي سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 199 -(@)(@@) عثيم بن كليب (3) روى عن أبيه عن جده قال ابن جريج اخبرت عن عثيم بن كليب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عائذ الله(@)(@@)(@@)(@@) $ 200 -(@)(@@) عائذ الله بن عبد الله أبو ادريس الخولانى ولد عام حنين روى عن معاذ بن جبل وابى الدرداء وعبادة بن الصامت وابى ثعلبة الخشني (سمعت أبي يقول ذلك - 2) قال أبو محمد روى عنه الزهري، نا عبد الرحمن حدثني أبي(@)(@@) نا دحيم نا عبد العزيز بن ابى السائب عن ابيه قال سمعت مكحولا يقول ما ادركت مثل ابى ادريس الخولانى، نا عبد الرحمن نا محمد بن عزيز الايلى حدثنى سلامة يعنى ابن روح عن عقيل قال ابن شهاب اخبرني أبو ادريس الخولانى وهو عائذ الله PageV07P037(@)(@@) ابن عبد الله وكان من فقهاء اهل الشام، نا عبد الرحمن قال سئل ابى عن ابى ادريس الخولانى فقال ثقة.(@)(@@)(@@)(@@) $ 201 -(@)(@@) عائذ الله المجاشعى روى عن أبي داود نفيع بن الحارث روى عنه سلام بن مسكين سمعت أبي يقول ذلك، وسمعته يقول هو منكر الحديث.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عريان(@)(@@)(@@)(@@) $ 202 -(@)(@@) عريان بن الهيثم بن الاسود النخعي روى عن ابيه وقبيصة ابن جابر روى عنه عبد الملك بن عمير سمعت أبي يقول ذلك (ويقول هو مجهول - 1)(@)(@@)(@@)(@@) $ 203 -(@)(@@) (عريان سمع ابن سيرين روى عنه سليمان الجرمي سمعت أبي يقول ذلك ويقول هو مجهول - 2)(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى عراكا(@)(@@)(@@)(@@) $ 204 -(@)(@@) عراك بن مالك روى عن ابن عمر وابى هريرة وعبيد الله ابن عبد الله بن عتبة روى عنه ابنه خثيم بن عراك وعبد العزيز بن 
ms2065	 عمر بن عبد العزيز وعبيد الله بن أبي سلمة الماجشون سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن قال سمعت أبي يقول عراك بن مالك ثقة، نا عبد الرحمن قال سئل أبو زرعة عن عراك بن مالك فقال مديني ثقة.(@)(@@)(@@)(@@) $ 205 -(@)(@@) عراك بن خالد بن يزيد بن صالح بن صبيح المرى روى عن يحيى بن الحارث الذمارى روى عنه هشام بن عمار ومحمد بن وهب بن عطية وعبد الله بن ذكوان المقري سمعت أبي يقول ذلك وسألته عنه فقال مضطرب الحديث ليس بالقوى.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى علوان(@)(@@)(@@)(@@) $ 206 -(@)(@@) علوان بن اسمعيل الفرقسانى روى عن حميد بن عبد الرحمن بن PageV07P038(@)(@@) حميد بن عبد الرحمن (1) بن عوف روى عنه الليث وأبو صالح وابن عفير سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 207 -(@)(@@) علوان بن ابى مالك روى عن الشعبي قوله روى عنه الثوري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم من الأفراد ممن ابتداء اسمائهم على حرف العين(@)(@@)(@@)(@@) $ 208 -(@)(@@) عرباض بن سارية السلمي له صحبة روى عنه أبو رهم السماعي سمعت أبي يقول ذلك، قال أبو محمد روى عنه حبيب بن عبيد وجبير بن نفير وعبد الرحمن بن عمرو السلمى وعبد الله بن أبي بلال وسويد بن جبلة وعبد الاعلى ابن هلال.(@)(@@)(@@)(@@) $ 209 -(@)(@@) عداء بن خالد بن هوذة بن (2) قيس عيلان العامري له صحبة روى عنه عبد المجيد بن أبي يزيد سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 210 -(@)(@@) عكاشة بن محصن الاسدي له صحبة روت عنه اخته ام قيس بنت محصن.(@)(@@)(@@)(@@) $ 211 -(@)(@@) عثامة بن قيس البجلى له صحبة وروى عن عبد الله بن سفيان وله صحبة ايضا سمعت أبي يقول هما مجهولان.(@)(@@)(@@)(@@) $ 212 -(@)(@@) عرزب الكندى روى عن النبي صلى الله عليه وسلم روى عنه عبد الملك بن ابى عياش سمعت أبي يقول ذلك ويقول هما مجهولان.(@)(@@)(@@)(@@) $ 213 -(@)(@@) عرس بن عميرة له صحبة روى عنه عدى الكندي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 214 -(@)(@@) العركى روى عن النبي صلى الله عليه وسلم انه سئل عن 
ms2066	 ماء البحر روى عنه عبد الله بن زرير سمعت أبي يقول ذلك. PageV07P039(@)(@@)(@@)(@@) $ 215 -(@)(@@) عكراش بن ذؤيب (له صحبة - 1) روى عنه ابنه عبيد الله ابن عكراش بن ذؤيب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 216 -(@)(@@) عس العذري له صحبة روى عنه مطير أبو شعيب الوادي يعنى من وادي القرى سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 217 -(@)(@@) عبس الغفاري قال سمعت النبي صلى الله عليه وسلم يقول بادروا بالاعمال ستا روى زاذان عن عليم عنه ويقال روى زاذان عنه نفسه وروى عنه حنش الكندى.(@)(@@)(@@)(@@) $ 218 -(@)(@@) عسعس بن سلامة أبو صفرة التيمى (2) البصري روى عنه الأزرق بن قيس الحارثي سمعت أبي يقول ذلك.(@)(@@) قال أبو محمد.(@)(@@)(@@)(@@) $ 219 -(@)(@@) عقفان بن شعثم اخو ذؤيب أنه أتى النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 220 -(@)(@@) عليبه بن حرملة العنبري روى عن أبيه عن النبي صلى الله عليه وسلم روى عنه ابنه ضرغامة سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 221 -(@)(@@) عقال البجلى روى عن ابى عباس روى عنه ابنه عيسى بن عقال البجلي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 222 -(@)(@@) عليم الكندى روى عن سلمان روى عنه مسلم بن يزيد أبو صادق الأزدي (3) سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 223 -(@)(@@) عنبس بن عقبة روى عن عبد الله بن مسعود روى عنه يزيد ابن حيان سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال عنبس بن عقبة ثقة (ثقة - 1) .(@)(@@)(@@)(@@) $ 224 -(@)(@@) عتريس بن عرقوب سمع ابن مسعود روى عنه إبراهيم النخعي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 225 -(@)(@@) عائش بن انس بكرى روى عن على رضي الله عنه روى عنه PageV07P040(@)(@@) عطاء بن أبي رباح سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 226 -(@)(@@) عدسة الطائى روى عن ابن مسعود روى عنه سلمة بن كهيل سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 227 -(@)(@@) عزوان بن زيد الرقاشى بصرى قوله روى عنه الحسن سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 228 -(@)(@@) عتى بن ضمرة السعدى روى عن أبي بن كعب روى عنه الحسن سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 229 -(@)(@@) عتيك بن الحارث بن 
ms2067	 عتيك بن قيس بن هيشة روى عن جابر ابن عتيك روى عنه عبد الله بن عبد الله بن جبر بن عتيك سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 230 -(@)(@@) عقيصا أبو سعيد التيمى صاحب الكراش روى عن على رضي الله عنه روى عنه الأعمش ومحمد بن جحادة ومطر سمعت أبي يقول ذلك، حدثنا عبد الرحمن قال قرئ على العباس بن محمد الدوري عن يحيى بن معين أنه قال أبو سعيد عقيصا ليس بشئ شر من رشيد الهجري وحبة العرنى واصبغ بن نباتة.(@)(@@)(@@)(@@) $ 231 -(@)(@@) علاقة بن عبد الله بن زيد بن مربع من بنى حارثة اخو زيادة الانصاري المدينى سمع سهل بن سعد الساعدي روى عنه كثير بن جعفر (بن أبي كثير - 1) سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 232 -(@)(@@) عطوان أبو اسماء الخياط روى عن مولاته (2) جمرة روى عنه بكر بن الأسود العائذى الكوفى وابو معمر القطيعى، نا عبد الرحمن قال سألت ابى عنه فقال كتبنا عن رجلين عنه أبو معمر القطيعى وبكر بن الاسود وهو شيخ ليس بمنكر الحديث.(@)(@@)(@@)(@@) $ 233 -(@)(@@) علاج بن عمرو (رأى عمر رضي الله عنه - 3) (روى عنه - 4) PageV07P041(@)(@@) أبو صخرة جامع بن شداد وأشعث بن أبي الشعثاء سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 234 العاص بن عمرو الطفاوى سمع عمته ام الغادية روى عنه تمام بن بزيع الطفاوى سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 235 -(@)(@@) عجيبة بن عبد الحميد بن عقبة بن طلق روى عن قيس بن طلق روى عنه ملازم بن عمرو سمعت أبي يقول ذلك، نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلى قال نا عثمان بن سعيد قال قلت ليحيى ين معين عجيبة بن عبد الحميد؟ قال ثقة.(@)(@@)(@@)(@@) $ 236 -(@)(@@) عقار بن المغيرة بن شعبة روى عن ابيه روى عنه حسان بن ابى وجزة روى عن عبد الله بن عمرو في شرب الخمر وروى عن أبيه روى عنه يعلى بن عطاء سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 237 -(@)(@@) عناس بن خليفة سمع ابا محمد النهدي عن ابن مسعود قوله روى عنه (عبد الصمد بن عبد 
ms2068	 الوارث سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 238 -(@)(@@) عفاق المحاربي روى عن عمرو بن ميمون روى عنه - 1) محمد ابن جحادة ومسعر سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 239 -(@)(@@) عمرد بن الحسن روى عن حيي بن يعلي بن أمية روى عنه ابن جريج سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 240 -(@)(@@) عصية (أو عصيبة - 2) بن سعد البلوى سمع حسنا وحسينا روى عنه عروة بن أبي قيس سمعت أبي يقول ذلك ويقول هما مجهولان.(@)(@@)(@@)(@@) $ 241 -(@)(@@) عرفطة بن أبي الحارث روى عن الحسن روى عنه عبد الله بن زياد بن درهم، نا عبد الرحمن قال سألت أبي عنه فقال لا أدري من عرفطة هذا مجهول.(@)(@@)(@@)(@@) $ 242 -(@)(@@) عسل بن سفيان روى عن عطاء بن أبي رباح روى عنه شعبة وابن أبي عروبة وحماد بن سلمة ووهيب وعبد العزيز بن المختار ومرحوم بن عبد العزيز العطار سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل PageV07P042(@)(@@) فيما كتب إلي قال سمعت ابى يقول عسل بن سفيان ليس هو عندي قوى الحديث، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال عسل بن سفيان ضعيف، نا عبد الرحمن قال سألت ابى عن عسل بن سفيان فقال منكر الحديث.(@)(@@)(@@)(@@) $ 243 -(@)(@@) عقيل بن خالد الايلى مولى عثمان بن عفان رضي الله عنه روى عن الزهري وعكرمة سمعت أبي يقول ذلك، قال أبو محمد وروى عقيل عن زيد بن أسلم ومحمد بن اسحاق وعمه زياد بن عقيل روى عنه الليث بن سعد وابن لهيعة وابن اخيه سلامة (بن روح بن خالد، نا عبد الرحمن نا أبي نا محمود بن ابراهيم ابن سميع - 1) حدثنى موسى بن ايوب نا مخلد بن الحسين قال سمعت يونس بن يزيد الايلى يقول كان عقيل يصحب الزهري في السفر والحضر.(@)(@@) (نا أبو بكر بن أبي خيثمة فيما كتب إلي نا الوليد بن شجاع نا مخلد بن الحسين قال سمعت يونس ابن يزيد الايلى قال كان عقيل يصحب الزهري في 
ms2069	 سفره وحضره - 2) .(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال قال ابى عقيل ثقة، نا عبد الرحمن قال قرئ على العباس بن محمد قال قال يحيى بن معين أثبت الناس في الزهري مالك بن أنس ومعمر ويونس وعقيل وشعيب بن ابى حمزة وسفيان بن عيينة، نا عبد الرحمن قال سألت أبي عن عقيل بن خالد احب اليك ام يونس؟ فقال عقيل احب إلى من يونس وعقيل لا بأس به.(@)(@@) نا عبد الرحمن قال سئل أبو زرعة عن عقيل بن خالد فقال ثقة صدوق، نا عبد الرحمن قال سئل ابى عن عقيل ومعمر ايهما اثبت؟ فقال عقيل اثبت كان صاحب كتاب وكان الزهري يكون بايلة وللزهرى هناك ضيعة فكان يكتب عنه هناك.(@)(@@)(@@)(@@) $ 244 -(@)(@@) عبثر بن القاسم أبو زبيد الزبيدى روى عن الشيباني والاعمش ومطرف روى عنه الاشجعى والحسن بن الربيع وعبد الله بن صالح بن مسلم سمعت أبي يقول ذلك، نا عبد الرحمن نا صالح بن أحمد بن حنبل قال سمعت ابى يقول عبثر ثقة PageV07P043(@)(@@) صدوق، نا عبد الرحمن قال أخبرنا أبو بكر بن أبي خيثمة فيما كتب إلي قال سمعت يحيى بن معين يقول عبثر بن القاسم أبو زبيد ثقة سنى، نا عبد الرحمن قال سألت ابى عن عبثر بن القاسم فقال صدوق.(@)(@@)(@@)(@@) $ 245 -(@)(@@) عافية بن ايوب روى عن أسامة بن زيد بن أسلم روى عنه عبد العزيز بن عمران، نا عبد الرحمن قال سئل أبو زرعة عن عافية بن ايوب فقال أبو عبيدة عافية بن ايوب هو مصرى ليس به بأس.(@)(@@)(@@)(@@) $ 246 -(@)(@@) عريف بن درهم (الجمال - 1) الكوفى أبو هريرة روى عن زيد بن وهب وعبد الله بن أبي الهذيل وجبلة بن سحيم وابراهيم النخعي روى عنه وكيع ومروان بن معاوية وأبو نعيم سمعت أبي يقول ذلك، نا عبد الرحمن نا محمد بن إبراهيم بن شعيب نا عمرو بن علي قال سمعت يحيى بن سعيد يسئل عن (حديث - 1) عريف بن درهم الجمال 
ms2070	 فامتنع وقال روى حديثا منكرا عن جبلة ابن سحيم عن ابن عمر ثم حدثنا عنه، نا عبد الرحمن قال سألت ابى عن عريف ابن درهم الهمداني فقال هو صالح (الحديث - 2) لا بأس به ثنا أبو نعيم عنه.(@)(@@)(@@)(@@) $ 247 -(@)(@@) عثام بن على العامري الكلابي أبو على روى عن الاعمش واسمعيل بن أبي خالد وهشام بن عروة روى عنه ابن نفيل وابن نمير سمعت أبي يقول ذلك، قال أبو محمد روى عنه أبو سعيد الأشج، نا عبد الرحمن قال سألت أبي عن عثام بن على فقال صدوق وهو أحب إلي من يحيى بن عيسى (بن يونس - 1)(@)(@@) الرملي، نا عبد الرحمن قال سئل أبو زرعة عن عثام بن على فقال ثقة.(@)(@@)(@@)(@@) $ 248 -(@)(@@) عكير بن شمير (3) القيسي سمع اباه روى عنه سعيد بن سليمان الواسطي وابو سلمة المنقري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 349 -(@)(@@) عيصا بن أبي بكر بن عبد الرحمن بن أبي سفيان بن حويطب روى عن أبيه أبي بكر بن عبد الرحمن عن امه ام عبد الله بنت ابى سبرة عن PageV07P044(@)(@@) زينب بنت ام سلمة عن امها أم سلمة عن النبي صلى الله عليه وسلم قال لا تقوم الساعة حتى يكون اسعد الناس بالدنيا لكع بن لكع، روى أبو غسان محمد بن يحيى الكنانى قال حدثنى غسان بن عبد الحميد عن عيصا بن ابى بكر بذلك.(@)(@@)(@@)(@@) $ 250 -(@)(@@) عرابى بن معاوية أبو زمعة ويقال أبو ربيعة الحضرمي روى عن سليمان بن زياد الحضرمي وعبد الله بن هبيرة روى عنه يحيى بن غيلان ويحيى بن عبد الله بن بكير سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 251 -(@)(@@) عرار بن سويد سمع عميرة بن سعد روى عنه حماد بن سلمة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 252 -(@)(@@) عباءة بن كليب قدم الرى وكتب عنه الرازيون وروى عنه إسحاق بن موسى الخطمى ومحمد بن آدم بن سليمان المصيصى والحسن بن علي بن عفان سمعت أبي يقول ذلك وسألته عنه فقال صدوق، قال أبو محمد روى عن اسمعيل بن ابراهيم عن الحسن ومبارك 
ms2071	 بن فضالة وداود الطائى وفى حديثه انكار اخرجه البخاري في كتاب الضعفاء فسمعت أبى يقول يحول(@)(@@) من هناك.(@)(@@)(@@)(@@) $ 253 -(@)(@@) عوبد (1) بن أبي عمران الجوني روى عن ابيه روى عنه احمد ابن ايوب بن راشد ونصر بن علي ومحمد بن المثنى سمعت أبي يقول ذلك، نا عبد الرحمن قال قرئ (2) على العباس بن محمد الدوري قال سئل يحيى بن معين عن عوبد بن ابى عمران الجونى فقال ليس بشئ، نا عبد الرحمن قال سألت ابى وابا زرعة عن عوبد بن ابى عمران الجونى فقالا ضعيف الحديث، وزاد ابى فقال ضعيف منكر الحديث.(@)(@@)(@@)(@@) $ 254 -(@)(@@) عواد (3) روى عن عمر رضي الله عنه مرسل انه بلغه عنه روى PageV07P045(@)(@@) عنه غفان بن سيار الجرجاني.(@)(@@) 255 عنبس بن سعيد البزاز التنوخى كوفى روى عن حبان بن علي العنزي روى عنه أحمد بن يحيى الصوفى، نا عبد الرحمن قال سألت ابى عنه فقال هو من بعض الكوفيين لا اعرفه.(@)(@@)(@@)(@@) $ 256 -(@)(@@) عتيق أو ابن عتيق (1) روى عن.. (2) روى عنه شعبة سألت أبي عنه فقال شيخ.(@)(@@)(@@)(@@) $ 257 -(@)(@@) عتيبة روى عن يزيد بن اصرم روى عنه جعفر بن سليمان الضبعي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 258 -(@)(@@) عطى بن مجدي الضمري روى عن أبيه روى عنه ابنه أبو المفرج ابن عطى، نا عبد الرحمن قال سمعت ابى يقول هما مجهولان.(@)(@@)(@@)(@@) $ 259 -(@)(@@) عنطوانة روى عن الحسن البصري روى عنه عبيد بن(@)(@@) عقيل.(@)(@@)(@@)(@@) $ 260 -(@)(@@) عرعرة بن البرند بن النعمان السامى روى عن عبد الله بن عون وأشعث بن عبد الملك وروح بن القاسم والحجاج بن زيد روى عنه عثمان وعبد الله ابنا أبي شيبة وإبراهيم بن محمد بن عرعرة وعمرو بن علي ومحمد بن المثنى سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 261 -(@)(@@) عتيق بن يعقوب مدينى الزبيري أبو بكر وهو ابن يعقوب بن صديق بن موسى بن عبد الله بن الزبير بن العوام روى عن الزبير بن حبيب وعبد العزيز بن محمد الدراوردي روى عنه أبو زرعة وعلي بن حرب الموصلي، نا عبد الرحمن قال سمعت 
ms2072	 أبا زرعة يقول بلغني أن عتيق بن يعقوب الزبيري حفظ الموطأ في حياة مالك.(@)(@@)(@@)(@@) $ 262 -(@)(@@) عكى بن زياد الرازي روى عن حكام بن سلم روى عنه عمرو بن سهل بن صرخاب أبو على. PageV07P046(@)(@@)(@@)(@@) ||| باب تسمية من روى عنه العلم ممن ابتداء حروف اسمه على الغين(@)(@@)(@@)(@@) |||| ذكر من اسمه غالب(@)(@@)(@@)(@@) $ 263 -(@)(@@) غالب بن ابجر المزني كوفي له صحبة روى عنه عبد الله بن معقل سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 264 -(@)(@@) غالب بن عبد الله الليثى قال بعثنى النبي صلى الله عليه وسلم عام الفتح على المقدمة لاسهل له الطريق روى عنه قطن بن عبد الله سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 265 -(@)(@@) (غالب بن عبد الله بن سعد روى عن زهدم روى عنه أبو التياح سمعت ابى يقول ذلك - 1) 266 - غالب بن غيلان الانصاري كوفي روى عن ابن عباس روى عنه شريك سمعت أبي يقول ذلك، قال أبو محمد كذا روى الحمانى عن شريك عن غالب بن غيلان عن ابن عباس في خلق الايام وروى هذا الحديث يزيد بن هارون عن شريك عن غالب بن غيلان عن عطاء عن ابن عباس فبان ان غالبا لم يدرك ابن عباس إذا ادخل بينهما عطاء.(@)(@@)(@@)(@@) $ 267 -(@)(@@) غالب الرياحي بصري روى عن ابن عمر روى عنه الجريري سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 268 -(@)(@@) غالب بن عجرد بصري روى عن ابن عمر روى عنه ثابت البنانى وعوف الأعرابي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 269 -(@)(@@) غالب أبو الهذيل وهو ابن الهذيل كوفى اودى روى عن ابراهيم وكليب الاودى روى عنه سفيان الثوري وشريك سمعت أبي يقول ذلك وسمعته يقول لا بأس به قلت يحتج بحديثه؟ قال واى شئ عنده؟ عنده قليل. PageV07P047(@)(@@)(@@)(@@) $ 270 -(@)(@@) غالب القطان وهو ابن الخطاف (1) وهو ابن ابى غيلان الراسبى يقال مولى عبد الله بن عامر بن كريز ويقال مولى راسب ويقال مولى ابن (2) تميم ويقال مولى ابن (2) غنم بصرى يكنى ابا سلمة روى عن الحسن وبكر ابن عبد الله المزني روى عنه شعبة وعبد الله بن شوذب وبشر بن 
ms2073	 المفضل واسمعيل ابن علية سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلى قال قال ابى غالب القطان ثقة ثقة، ثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال غالب القطان ثقة، نا عبد الرحمن قال سألت ابى عن غالب القطان فقال صدوق صالح.(@)(@@)(@@)(@@) $ 271 -(@)(@@) غالب بن نجيح أبو بشر كوفي روى عن حماد بن أبي سليمان وقيس بن مسلم وعمرو بن مرة ومغيرة روى عنه أبو الاحوص وجرير بن عبد الحميد وأبو أحمد الزبيري وعبيد الله بن موسى سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 272 -(@)(@@) غالب بن عبيد الله الجزرى العقيلى روى عن عطاء روى عنه عبيد الله بن عمرو سمعت أبي يقول ذلك ويقول لم يرو عنه يحيى بن سعيد القطان ولا عبد الرحمن بن مهدي، نا عبد الرحمن حدثني أبي قال سألت علي بن المديني عن غالب الجزرى فقال ما كتبت منذ صغرى إلى الآن من حديثه شيئا، نا عبد الرحمن قال سألت ابى عن غالب الجزرى قال متروك الحديث منكر الحديث.(@)(@@)(@@)(@@) $ 273 -(@)(@@) غالب بن سليمان العتكى أبو صالح روى عن الضحاك وكثير ابن زياد ويحيى بن عقيل روى عنه جرير بن حازم وحماد بن زيد وحرمي بن عمارة ومسلم بن ابراهيم وسليمان بن حرب وعبد الله بن اسمعيل الجودانى الجهضمى، نا عبد الرحمن سمعت أبي يقول ذلك، وسمعته يقول سمعت سليمان بن حرب وذكر غالب بن سليمان الجهضمى فأثنى عليه خيرا وقال وقع إلى خراسان، ثنا عبد الرحمن قال سألت ابى عن غالب بن سليمان فقال ثقة. PageV07P048(@)(@@)(@@)(@@) $ 274 -(@)(@@) غالب التمار العبدى البصري وهو ابن مهران روى عن حميد ابن هلال والشعبى ومسروق بن اوس ورجل من بنى نمير روى عنه شعبة وابن(@)(@@) ابى عروبة واسمعيل ابن علية، (نا عبد الرحمن سمعت أبي يقول ذلك، نا عبد الرحمن قال - 1) سئل ابى عن غالب التمار فقال بصرى صالح الحديث.(@)(@@)(@@)(@@) $ 275 -(@)(@@) غالب بن حجرة 
ms2074	 بن التلب بن ثعلبة العنبري تميمي روى عن ملقام بن التلب روى عنه محمد بن عبد الله الرقاشى وموسى بن اسمعيل وحرمى بن حفص، نا عبد الرحمن سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 276 -(@)(@@) غالب الحنفي قوله روى عنه يونس بن أبي اسحاق، نا عبد الرحمن سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 277 -(@)(@@) غالب الوراق روى عن ابن سيرين قوله روى عنه مسعدة بن اليسع، حدثنا عبد الرحمن سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 278 -(@)(@@) غالب بن حبيب اليشكرى روى عن العوام بن حوشب روى عنه.. (2) نا عبد الرحمن قال سمعت أبي يقول ذلك وسمعته يقول هو مجهول.(@)(@@)(@@)(@@) $ 279 -(@)(@@) غالب بن فائد الاسدي المقرئ روى عن سفيان الثوري وإسرائيل وحمزة الزيات وقيس بن الربيع وأبي بكر بن عياش روى عنه سهل ابن عثمان العسكري وابو سعيد الاشج وابو عقيل يحيى بن حبيب بن اسمعيل (بن عبد الله - 1) بن حبيب بن أبي ثابت، نا عبد الرحمن قال سئل أبي عنه فقال هو مقرئ ليس به بأس، نا عبد الرحمن قال سئل أبو زرعة عنه فقال هو شيخ كوفي لا اعرفه.(@)(@@)(@@)(@@) $ 280 -(@)(@@) غالب بن قرار (3) الهذلى روى عن ابى نعامة روى عنه نصر ابن على، نا عبد الرحمن قال سألت أبي عنه فقال هو شيخ.(@)(@@)(@@)(@@) $ 281 -(@)(@@) غالب روى عن السدي روى عنه فياض بن محمد الرقي، نا عبد الرحمن قال سألت أبي عنه فقال لا أدري من هو. PageV07P049(@)(@@)(@@)(@@) $ 282 -(@)(@@) غالب أبو عبد الرحمن المعلم روى عن ابى الدرداء مرسلا روى عنه جعفر بن برقان سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 283 -(@)(@@) غالب بن حلبس بن محمد الكلبى روى عن مهدي بن ميمون وعن ابيه كتب عنه أبي في الرحلة الثانية روى عنه أبي وأبو زرعة، نا عبد الرحمن قال سئل أبي عنه فقال شيخ.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى غسان(@)(@@)(@@)(@@) $ 284 -(@)(@@) غسان روى عن ابن الرسيم وكان في الوفد الذين وفدوا إلى رسول الله صلى الله عليه وسلم فنهاهم عن الاوعية روى يحيى الجابر عن يحيى بن غسان 
ms2075	 عن أبيه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 285 -(@)(@@) غسان بن الأغر بن حصين أبو الاغر النهشلي روى عن زياد ابن حصين روى عنه بهز بن أسد وحبان بن هلال وابو همام الصلت بن محمد الخاركى وموسى بن اسمعيل، نا عبد الرحمن قال سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 286 -(@)(@@) غسان بن برزين أبو المقدام الطهوى بصرى روى عن سيار ابن سلامة وثابت البناني روى عنه مسلم بن إبراهيم وحجاج بن المنهال ومسدد نا عبد الرحمن قال سمعت أبي يقول ذلك، نا عبد الرحمن قال ذكره أبي عن اسحاق ابن منصور عن يحيى بن معين انه قال غسان بن برزين ثقة.(@)(@@)(@@)(@@) $ 287 -(@)(@@) غسان بن سيار أبو مالك العوذى بصرى روى عن قتادة وثمامة روى عنه معلى بن أسد، نا عبد الرحمن قال سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 288 -(@)(@@) غسان بن مالك بن عباد أبو عبد الرحمن السلمى بصري روى عن حماد بن سلمة وسلام بن مسكين وحيان بن عبد الله وسلام ابى المنذر سمعت أبي يقول ذلك، نا عبد الرحمن قال سألت ابى عنه فقال اتيته ولم يقض لى السماع منه وليس بقوى، بين في حديثه الانكار، قال أبو محمد روى عنه أبو زرعة.(@)(@@) PageV07P050(@)(@@)(@@)(@@) $ 289 -(@)(@@) غسان بن مضر أبو مضر الازدي النمري البصري روى عن سعيد بن يزيد ابى مسلمة روى عنه مسلم بن إبراهيم وابنه مضر ونصر بن علي وعمرو بن على وعون بن الحكم بن سنان ومحمد بن مهران الجمال وأبو بكر بن أبي شيبة ويحيى بن المغيرة سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت أبي يقول غسان بن مضر شيخ ثقة ثقة.(@)(@@) نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال غسان بن مضر ثقة، نا عبد الرحمن قال سألت ابى عن غسان بن مضر قال لا بأس به صالح الحديث، نا عبد الرحمن قال سئل أبو زرعة عن غسان بن 
ms2076	 مضر فقال صدوق.(@)(@@)(@@)(@@) $ 290 -(@)(@@) غسان بن عبد الحميد بن عبيد بن سيار (1) القرشى الكنانى روى عن محمد بن إسحاق وابى بكر بن عثمان، نا عبد الرحمن قال سمعت أبي يقول ذلك، قال أبو محمد روى عن محمد بن المنكدر روى عنه مسلم بن إبراهيم، حدثنا عبد الرحمن قال سألت أبي عنه فقال شيخ مدينى نزل البصرة مجهول.(@)(@@)(@@)(@@) $ 291 -(@)(@@) غسان بن عمر أبو الهذيل العجلى الكوفى يروى عن سفيان الثوري روى عنه محمد بن سلام، نا عبد الرحمن قال سمعت أبي يقول ذلك، وسألته عنه فقال منكر الحديث، قال أبو محمد ويروى عن عائذ بن شريح الكندى روى عنه عبد الله بن عمر بن محمد بن أبان بن صالح القرشى.(@)(@@)(@@)(@@) $ 292 -(@)(@@) غسان بن الفضل أبو عمرو السجستاني نزيل مكة روى عن حماد ابن زيد وصبيح بن سعيد النجاشي وبشر بن ميمون، نا عبد الرحمن قال سمعت(@)(@@) أبي يقول ذلك قال أبو محمد وكتب عنه أبو زرعة.(@)(@@)(@@)(@@) $ 293 -(@)(@@) غسان بن عبيد الرقى موصلي روى عن عكرمة بن عمار روى عنه الحكم بن موسى وكثير بن ابى صابر القنسرينى، نا عبد الرحمن قال سمعت أبي يقول ذلك، قال أبو محمد روى عنه أيوب بن محمد الوزان الرقى. PageV07P051(@)(@@)(@@)(@@) $ 294 -(@)(@@) غسان بن الربيع الموصلي روى عن عبد العزيز بن عبد الله الماجشون روى عنه محمد بن عبد الله بن عمار الموصلي، نا عبد الرحمن قال سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 295 غسان بن المفضل الغلابى روى عن خالد بن الحارث وعمر ابن على بن مقدم وبشر بن المفضل روى عنه محمد بن مسلم بن واره وعباس بن ابى طالب.(@)(@@)(@@)(@@) $ 296 -(@)(@@) غسان بن ناقد روى عن ابى الاشهب النخعي عن الأعمش روى عنه محمد بن شعيب بن شابور، نا عبد الرحمن قال سألت أبي عن غسان هذا فقال (شيخ - 1) مجهول والحديث الذي رواه عن ابى الاشهب النخعي عن الأعمش عن أبي صالح عن أبي هريرة عن النبي صلى الله عليه وسلم أنه قال لكل امة مجوس وان 
ms2077	 مجوس امتى القدرية ان مرضوا فلا تعودوهم وان ماتوا فلا تصلوا عليهم،.(@)(@@) ثنا عبد الرحمن سمعت أبي يقول هذا حديث باطل، قلت باطل ممن هو؟ قال من هؤلاء المجاهيل غسان هذا، قال أبو محمد أبو الاشهب النخعي جعفر بن الحارث (2) الواسطي يقول يحيى بن معين ليس بشئ وابى وابو زرعة يقولان ليس به بأس.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى غيلان(@)(@@)(@@)(@@) $ 297 -(@)(@@) غيلان بن جرير المعولى بصرى روى عن انس ومطرف بن عبد الله بن الشخير وعبد الله بن معبد الزماني وابى بردة روى عنه قتادة وشعبة ومهدي بن ميمون وحماد بن زيد وابان العطار وابو هلال الراسبى، نا عبد الرحمن PageV07P052(@)(@@) قال سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن أحمد بن محمد بن حنبل فيما كتب إلي قال سألت ابى عن غيلان بن جرير فقال ثقة، نا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال غيلان بن حرير ثقة، نا عبد الرحمن قال سألت ابى عن غيلان بن جرير فقال ثقة.(@)(@@)(@@)(@@) $ 298 -(@)(@@) غيلان بن جامع المحاربي قاضى الكوفة روى عن الحكم واياس ابن سلمة وجبلة بن سحيم وعبد الملك بن ميسرة روى عنه الثوري وشعبة ويعلى ابن الحارث المحاربي وهو (غيلان الذى روى عن النبي صلى الله عليه وسلم مرسلا روى عنه اسمعيل بن ابى خالد وفرق بعض الناس بينهما وهو عندي وأحد سمعت أبي يقول ذلك، روى عنه حماد بن أبي سليمان وميمون بن مهران ذكره أبي عن إسحاق بن منصور عن يحيى بن معين انه قال - 1) غيلان بن جامع ثقة، نا عبد الرحمن قال سألت ابى عن غيلان بن جامع فقال شيخ.(@)(@@)(@@)(@@) $ 299 -(@)(@@) غيلان بن عبد الله الواسطي مولى قريش سمع ابن عمر سمع منه شعبة وهشيم، نا عبد الرحمن سمعت أبي يقول ذلك، نا عبد الرحمن أنا عبد الله بن(@)(@@) أحمد بن محمد بن حنبل فيما كتب إلي قال سمعت أبي يقول غيلان بن عبد 
ms2078	 الله مولى قريش الذى حدثنا عنه هشيم وروى عنه شعبة هو احب إلى من سهيل بن ذكوان.(@)(@@)(@@)(@@) $ 300 -(@)(@@) غيلان بن عبد الله العامري روى عن أبي زرعة بن عمرو ابن جرير روى عنه عيسى بن عبيد المرورى، نا عبد الرحمن قال سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 301 -(@)(@@) غيلان بن معثر المقر إى وقال بعضهم المقرى شامي روى عن أبي إمامة روى عنه معاوية بن صالح وحريز بن عثمان وارطاة بن المنذر، نا عبد الرحمن سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 302 -(@)(@@) غيلان بن عميرة سمع من ابن عمر قوله سمع منه أبو خالد البصري أو أبو خلف سمعت ابى يقول ذلك.(@)(@@) * PageV07P053(@)(@@)(@@)(@@) $ 303 -(@)(@@) غيلان بن غالب روى عن عطاء عن ابن عباس قال خلق الله عزوجل الايام روى عنه شريك بن عبد الله النخعي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 304 -(@)(@@) غيلان بن بشر روى عن يعلى بن الوليد روى عنه الأعمش سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 305 -(@)(@@) غيلان بن يزيد روى عن أبي عبيدة بن عبد الله روى عنه الشيباني سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 306 -(@)(@@) غيلان بن عدى روى عن أبيه روى عنه ليث بن أبي سليم سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 307 -(@)(@@) غيلان بن ميسره بصرى روى عن أبي المليح روى عنه سعيد(@)(@@) ابن عامر الضبعي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 308 -(@)(@@) غيلان بن انس الدمشقي روى عن عمر بن عبد العزيز روى عنه الأوزاعي وشعيب بن أبي حمزة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 309 -(@)(@@) غيلان بن صهيب روى عن مكحول مرسلا روى عنه علي بن أبي سارة سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 310 -(@)(@@) غيلان بن ابى غيلان أبو مروان مولى عثمان بن عفان رضي الله عنه روى عنه يعقوب بن عتبة سمعت أبي يقول ذلك، قال أبو محمد روى محمد بن بشار عن معاذ بن معاذ عن ابن عون قال مررت بغيلان فإذا هو مصلوب بالشام، ثنا عبد الرحمن قال سمعت ابى يقول لا ادرى غيلان أبو مروان هو هذا ام لا.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن 
ms2079	 يسمى غضيفا(@)(@@)(@@)(@@) $ 311 -(@)(@@) غضيف بن الحارث أبو اسماء السكوني الكندى واختلف في اسمه فقال بعضهم الحارث بن غضيف وقال ابى وابو زرعة الصحيح غضيف ابن الحارث له صحبة روى عن بلال روى عنه ابنه عياض بن غضيف وابو راشد الحبرانى وحبيب بن عبيد الرحبى ويونس بن سيف ومكحول وعبادة بن(@)(@@) PageV07P054(@)(@@) نسي سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 312 -(@)(@@) غضيف أبو عبد الكريم روى عن عبد الله بن عمر وروى سعيد ابن زيد عن رجل من أهل الشام عنه سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 313 -(@)(@@) غضيف بن أبي سفيان روى عن نافع بن عاصم وعمرو بن اوس روى عنه سعيد بن السائب وعمرو بن وهب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 314 -(@)(@@) غضيف بن سفيان روى عن.. (1) روى عنه الحكم بن(@)(@@) هشام الثقفي سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 315 -(@)(@@) غضيف بن اعين الشيباني الجزرى روى عن مصعب بن سعد روى عنه عبد السلام بن حرب سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى غزوان(@)(@@)(@@)(@@) $ 316 -(@)(@@) غزوان بن عتبة بن غزوان من بنى مازن بن منصور حليف بنى نوفل روى عن أبيه روى عنه عمر بن الفضل سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 317 -(@)(@@) غزوان بن جرير روى عن ابيه روى عنه الأخضر بن عجلان وعبد السلام بن شداد سمعت أبى يقول ذلك.(@)(@@)(@@)(@@) $ 318 -(@)(@@) غزوان أبو مالك الغفاري روى عن عمار بن ياسر وابن عباس وابن ابزى روى عنه سلمة بن كهيل والسدى وحصين بن عبد الرحمن سمعت أبي يقول ذلك، حدثنا عبد الرحمن نا أبو بكر بن أبي خيثمة فيما كتب إلي قال سألت يحيى بن معين عن ابى مالك الذى روى عنه حصين قال هو الغفاري كوفى ثقة واسمه غزوان.(@)(@@)(@@)(@@) $ 319 -(@)(@@) غزوان بن يوسف العامري البصري روى عن الحسن روى عنه نصر بن علي الجهضمي نا عبد الرحمن سمعت أبي يقول ذلك ويقول هو متروك الحديث. PageV07P055(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى غضبان(@)(@@)(@@)(@@) $ 320 - غضبان بن يزيد روى عن أبيه عن النبي صلى الله 
ms2080	 عليه وسلم(@)(@@) وروى عن ابن مسعود روى عنه أبو العميس ومحمد بن عجلان سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 321 -(@)(@@) غضبان بن حنظلة بن نعيم الغنوى (2) روى عن أبيه روى عنه المثنى بن عوف وابو غاضرة(@)(@@) محمد بن أبي بكر سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 322 -(@)(@@) غضبان بن القبعثرى الشيباني كان يدخل على عبد الملك بن مروان روى عنه عياش الهمداني والد عبد الله بن عياش المنتوف سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى غاضرة(@)(@@)(@@)(@@) $ 323 -(@)(@@) غاضرة العنبري وهو ابن سمرة بن عمرو احد بنى عدى روى عن عمر رضي الله عنه روى عنه عبد الله بن عون سمعت أبي يقول ذلك.(@)(@@)(@@)(@@) $ 324 -(@)(@@) (غاضره بن عروة الفقيمى بصري روى عن أبيه روى عنه عاصم بن هلال أبو النضر سمعت أبي يقول ذلك، حدثنا عبد الرحمن - 3) نا محمد ابن أحمد بن البراء قال قال على بن المدينى غاضرة بن عروة الفقيمى شيخ مجهول لم يرو عنه غير عاصم بن هلال.(@)(@@)(@@)(@@) $ 325 -(@)(@@) غاضرة بن فرهد روى عن.. (4) روى عنه.. (4) ، نا عبد الرحمن قال سألت أبي عنه فقال شيخ، نا عبد الرحمن أنا يعقوب بن إسحاق فيما كتب إلي قال نا عثمان بن سعيد قال سألت يحيى بن معين قلت غاضرة ابن فرهد؟ قال ليس به بأس. PageV07P056(@)(@@)(@@)(@@) |||| باب من روى عنه العلم ممن يسمى غياثا(@)(@@)(@@)(@@) $ 326 -(@)(@@) غياث الحبرانى روى عن سفيان بن وهب الخولانى روى عنه مبشر بن اسمعيل سمعت ابى يقول ذلك.(@)(@@)(@@)(@@) $ 327 -(@)(@@) غياث بن ابراهيم النخعي الكوفى أبو عبد الرحمن ابن عم حفص ابن غياث روى عن مجالد وابراهيم بن أبي عبلة روى عنه محمد بن حمران وبقية بن الوليد سمعت أبي يقول ذلك.(@)(@@) نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال قال أحمد بن حنبل غياث بن ابراهيم متروك الحديث ترك الناس حديثه، حدثنا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول غياث كذاب ليس بثقة 