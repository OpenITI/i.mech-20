ms1201	 مؤمنا ويمسي كافرا ، ويمسي مؤمنا ويصبح كافرا ، يبيع أقوام دينهم بعرض من الدنيا ) )(@)(@@) ( ت ) عن أنس رضي الله عنه ( ز ) .(@)(@@) PageV04P120(@)(@@)(@@)(@@) $ ( 10564 ) قال النبي :(@)(@@) | 30 ( تكون دعاة على أبواب جهنم من أجابهم إليها قذفوه فيها ، هم قوم من جلدتنا يتكلمون بألسنتنا ، فالزم جماعة المسلمين وإمامهم ، فإن لم تكن جماعة ولا إمام فاعتزل تلك الفرق كلها ولو أن تعض بأصل شجرة حتى يدركك الموت وأنت كذالك ) )(@)(@@) ( ه ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10565 ) قال النبي :(@)(@@) | 30 ( تكون فتنة تستنظف العرب ، قتلاها في النار ، اللسان فيها أشد وقعا من السيف ) )(@)(@@) ( حم ت ه ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 10566 ) قال النبي :(@)(@@) | 30 ( تكون فتن لا يستطيع أن يغير فيها بعيد ولا لسان ) )(@)(@@) ( رستة في الإيمان ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10567 ) قال النبي :(@)(@@) | 30 ( تكون لأصحابي زلة يغفرها الله تعالى لهم لسابقتهم معي ) )(@)(@@) ( ابن عساكر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10568 ) قال النبي :(@)(@@) | 30 ( تكون هدنة على دخن ، قلوب لا تعود على ما كانت عليه ، ثم تكون دعاة الضلالة ، فإن رأيت يومئد خليقة الله في الأرض فالزمه وإن نهك جسمك وأخذ مالك ، وإن لم تره فاضرب في الأرض ولو أن تموت وأنت عاض على جذل شجرة ) )(@)(@@) ( حم د ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 10569 - قال النبي صلى الله عليه وسلم : ' تكاتفا ولا تعاصيا ويسرا ولا تعسرا ' ( طب ) عن | أبي موسى رضي الله عنه . |(@)(@@)(@@)(@@) $ 10570 - قال النبي صلى الله عليه وسلم : ' تكاتفا ولا تعاصيا ، ويسرا ولا تنفرا ' ( طس ) عن | ابن عمر رضي الله عنهما . | PageV04P121 |(@)(@@)(@@)(@@) $ 10571 - قال النبي صلى الله عليه وسلم : ' تكثر الصواعق عند اقتراب الساعة حتى يأتي الرجل | القوم فيقول : من صعق فيكم الغداة ؟ فيقولون : صعق فلان وفلان وفلان ' ( حم ) | وأبو الشيخ في العظمة ( ك ) عن أبي سعيد رضي الله عنه |(@)(@@)(@@)(@@) $ 10572 - قال النبي صلى الله عليه وسلم : ' تكلف لك أخوك وصنع ، ثم تقول إني صائم ، كل | وصم يوما مكانة ' ( قط ) عن أبي سعيد رضي 
ms1202	 الله عنه . |(@)(@@)(@@)(@@) $ 10573 - قال النبي صلى الله عليه وسلم : ' تكفيك قراءة الإمام خافت أو جهر في القراءة ' | وضعفه عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 10574 - قال النبي صلى الله عليه وسلم : ' تكمل يوم القيامة سبعون أمة نحن آخرها وخيرها ' | ( ه ) عن بهران بن حكيم عن أبيه عن جده . |(@)(@@)(@@)(@@) $ 10575 - قال النبي صلى الله عليه وسلم : ' تكون فتنة ، النائم فيها خير من المضطجع ، | والمضطجع فيها خير من القاعد ، والقاعد فيها خير من القائم ، والقائم فيها خير من | الماشي ، والماشي فيها خير من الراكب ، والراكب خير من المجري ، قتلاها كلها | في النار ، قيل : ومتى ذلك ؟ قال : ذلك أيام الهرج حين لا يأمن الرجل جليسه ، | قيل : فما تأمرني إن أدركت ذلك ؟ قال : اكفف يدك ونفسك وادخل دارك ، قيل | أرأيت إن دخل على داري ، قال : فادخل بيتك ، قيل أرأيت إن دخل على بيتي ، | قال : فادخل مسجدك فقل هكذا ، وقبض بيمينه على الكوع ، وقل ربي الله حتى | تموت على ذلك ' ( حم طب ك ) وابن عساكر عن ابن مسعود رضي الله عنه . |(@)(@@)(@@)(@@) $ 10576 - قال النبي صلى الله عليه وسلم : ' تكون جنود أربعة فعليكم بالشام فإن الله عز وجل | قد تكفل لي بالشام ' ( طب كر ) عن أبي طلحة الخولاني واسمه ذرع رضي الله | عنه . | PageV04P122 |(@)(@@)(@@)(@@) $ 10577 - قال النبي صلى الله عليه وسلم : ' تكون في بيت المقدس بيعة هدي ' ابن سعد عن | عبد الرحمن بن أبي عميرة المزني رضي الله عنه . |(@)(@@)(@@)(@@) $ ( 10578 ) قال النبي :(@)(@@) | 30 ( تكون في أمتي قزعة فيصير الناس إلى علمائهم فإذا هم قردة وخنازير ) )(@)(@@) الحكيم عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10579 ) قال النبي :(@)(@@) | 30 ( تكون وقعة بين زوراء ، قالوا : وما الزوراء يا رسول الله ؟ قال : مدينة بين أنهار في أرض جوخاء يسكنها جبابرة أمتي ، تعذب بأربعة أصناف : بخسف ومسخ وقذف وريح حمراء ) )(@)(@@) الخطيب عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10580 ) قال النبي :(@)(@@) | 30 ( تكون مدينة بين الفرات ودجلة يكون فيها ملك بني العباس وهي الزوراء ويكون فيها حرب مقطعة ، تسبى فيها النساء ، وتذبح فيها الرجال كما 
ms1203	 تذبح الغنم ) )(@)(@@) الخطيب عن علي وقال : إسناده شديد الضعف قلت : وقعت هاذه الحرب والذبح بعد الخطيب بأكثر من مائتي سنة وذالك مما يقوي الحديث .(@)(@@)(@@)(@@) $ ( 10581 ) قال النبي :(@)(@@) | 30 ( تكون أمراء يظلمون ويكذبون يأتيهم غواش من الناس ، فمن دخل عليهم فصدقهم بكذبهم وأعانهم على ظلمهم فليس مني ولست منه ، ومن لم يدخل عليهم ولم يصدقهم بكذبهم ولم يعنهم على ظلمهم فهو مني وأنا منه ) )(@)(@@) ( ط حم ع حب ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10582 ) قال النبي :(@)(@@) | 30 ( تكون فتنة ، القاعد فيها خير من القائم ، والقائم فيها خير من الماشي ، والماشي فيها خير من الساعي ، والساعي فيها خير من الراكب ، والراكب فيها خير من الموضع ) )(@)(@@) ( ش كر ) عن سعد بن مالك رضي الله عنه .(@)(@@) PageV04P123(@)(@@)(@@)(@@) $ ( 10583 ) قال النبي :(@)(@@) | 30 ( تكون قرية يقال لها البصرة ، أقوم الناس قبلة ، وأكثره مؤذنين يدفع الله عنهم ما يكرهون ) )(@)(@@) ابن عساكر عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10584 ) قال النبي :(@)(@@) | 30 ( تكون النبوة فيكم ما شاء الله أن تكون ثم يرفعها إذا شاء أن يرفعها ، ثم تكون ملكا عضوضا فيكون ما شاء الله أن تكون ثم يرفعها ، ثم تكون ملكا جبرية ، ثم تكون خلافة على منهاج النبوة ) )(@)(@@) ( ط بز حم ) و الروياني ( ض ) عن النعمان بن بشير عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10585 ) قال النبي :(@)(@@) | 30 ( تكون في أمتي رجفة يهلك فيها عشرة آلاف ، عشرون ألفا ، ثلاثون ألفا ، يجعلها الله موعظة للمتقين ، ورحمة للمؤمنين ، وعذابا على الكافرين ) )(@)(@@) ابن عساكر عن عروة بن رويم الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10586 ) قال النبي :(@)(@@) | 30 ( تكون فتنة أسلم الناس فيها الجند الغربي ) )(@)(@@) ( طب ك ) و ابن عساكر عن عمرو بن الحمق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10587 ) قال النبي :(@)(@@) | 30 ( تكون فتنة تشمل الناس كلهم ، لا يسلم منها إلا الجند الغربي ) )(@)(@@) نعيم بن حماد في الفتن عن يزيد بن أبي حبيب رضي الله عنه بلاغا .(@)(@@)(@@)(@@) $ ( 10588 ) قال النبي :(@)(@@) | 30 ( تكون النسم طيرا تعلق شجرة ، حتى إذا كان يوم القيامة دخلت في جثتها 
ms1204	 ) )(@)(@@) ابن عساكر عن أم بشر امرأة أبي معروف .(@)(@@)(@@)(@@) $ ( 10589 ) قال النبي :(@)(@@) | 30 ( تكون فتنة ، القاعد فيها خير من القائم ، والقائم فيها خير من الماشي ، والماشي فيها خير من الساعي ، والساعي في النار ، فإن أدركت ذالك فكن عبد الله المقتول ولا تكن عبد الله القاتل ) )(@)(@@) ( عب حم قط طب ) عن عبد الله بن خباب عن أبيه .(@)(@@)(@@)(@@) $ ( 10590 ) قال النبي :(@)(@@) | 30 ( تكون بعدي فتن وأمور وأحداث ) )(@)(@@) أبو نصر السجزي في الإبانة PageV04P124 وقال : غريب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 10591 ) قال النبي :(@)(@@) | 30 ( تكون هجرة بعد هجرة حتى تهاجر الناس إلى مهاجر إبراهيم ، وحتى لا يبقى على الأرض إلا شرار أهلها ، يقدرهم روح الله ، وتلقطهم أرضهم ، وتحشرهم النار من عدن مع القردة والخنازير تبيت معهم أينما باتوا ، وتقيل معهم أينما قالوا ، ولها ما سقط منهم ) )(@)(@@) ( حم طب ك ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 10592 قال النبي :(@)(@@) | 30 ( تكون فتن على أبوابها دعاة إلى النار ، فإن تمت وأنت عاض على جذل شجرة خير لك من أن تتبع أحدا منهم ) )(@)(@@) ( ه ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 10593 قال النبي :(@)(@@) | 30 ( تكون فتنة تقتلون عليها على دعواى جاهلية قتلاها في النار ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 10594 قال النبي :(@)(@@) | 30 ( تكون أربع فتن : الأولى يستحل فيها الدم ، والثانية يستحل فيها الدم والمال ، والثالثة يستحل فيها الدم والمال والفرج ، والرابعة الدجال ) ) نعيم بن حماد عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ 10595 قال النبي :(@)(@@) | 30 ( تكون أيام الدجال سنون خوادع يكثر فيها المطر ويقل فيها النبت ، ويكذب فيها الصادق ويصدق فيها الكاذب ، ويؤتمن فيها الخائن ويخون فيها الأمين ، وينطق فيها الرويبضة ، قيل : يا رسول الله ! وما الرويبضة ؟ قال : من لا يؤبه له ) )(@)(@@) ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ 10596 قال النبي :(@)(@@) | 30 ( تكون بين الناس فرقة واختلاف ، فيكون هاذا وأصحابه على الحق يعني عليا ) )(@)(@@) ( طب ) عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ 10597 قال النبي :(@)(@@) | 30 ( تكون في أمتي أربع فتن 
ms1205	 يصيب أمتي في آخرها فتن مترادفة ، فالأولى يصيبهم فيها بلاء حتى يقول المؤمن هاذه مهلكتي ثم تنكشف ، PageV04P125 والثانية حتى يقول المؤمن هذه مهلكتي ثم تنكشف ، والثالثة كلما قيل انقطعت تمادت ، والفتنة الرابعة يصيرون فيها إلى الكفر ، إذ كانت الأمة مع هاذا مرة ، ومع هاذا مرة بلا إمام وجماعة ، ثم المسيح ، ثم طلوع الشمس من مغربها ، ودون الساعة اثنان وسبعون دجالا ، منهم من لا يتبعه إلا رجل واحد ) ) نعيم بن حماد في الفتن عن الحكم بن نافع بلاغا .(@)(@@)(@@)(@@) $ 10598 قال النبي :(@)(@@) | 30 ( تكون فتنة تعوج فيها عقول الرجال حتى ما تكاد ترى رجلا عاقلا ) ) نعيم عن حذيفة رضي الله عنه وهو صحيح .(@)(@@)(@@)(@@) $ 10599 قال النبي :(@)(@@) | 30 ( تكون فتنة لا ينجو منها إلا من لم يصب من مالها ، ومن أصاب من مالها كمن أصاب من دمها ) ) نعيم عن أبي جعفر مرسلا .(@)(@@)(@@)(@@) $ 10600 قال النبي :(@)(@@) | 30 ( تكون بين أصحابي فتنة يغفرها الله لهم بسابقتهم ، إن اقتدى بهم قوم من بعدهم كبهم الله في نار جهنم ) ) نعيم عن يزيد بن أبي حبيب مرسلا .(@)(@@)(@@)(@@) ||| ( التاء مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 10601 قال النبي :(@)(@@) | 30 ( تلقي الأرض أفلاذ كبدها أمثال الأسطوان من الذهب والفضة ، فيجيء القاتل فيقول في هاذا قتلت ، ويجيء القاطع فيقول : في هاذا قطعت رحمي ، ويجيء السارق فيقول : في هاذا قطعت يدي ثم يدعونه فلا يأخذون منه شيئا ) )(@)(@@) ( م ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV04P126(@)(@@)(@@)(@@) ||| ( التاء مع الميم )(@)(@@)(@@)(@@) |||| ( من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 10602 قال النبي :(@)(@@) | 30 ( تمام البر أن تعمل في السر عمل العلانية ) )(@)(@@) ( طب عن أبي عامر السكوني رضي الله عنه .(@)(@@)(@@)(@@) $ 10603 قال النبي :(@)(@@) | 30 ( تمم التحية الأخذ باليد والمصافحة باليمنى ) )(@)(@@) ( الحاكم في الكنى ا ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 10604 قال النبي :(@)(@@) | 30 ( تمام الرباط أربعون يوما ، ومن رابط أربعين يوما لم يبع ولم يشتر ولم يحدث حدثا خرج من ذنوبه كيوم ولدته أمه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 10605 قال النبي :(@)(@@) | 30 ( تمام النعمة 
ms1206	 دخول الجنة والفوز من النار )(@)(@@) ( حم خدت ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 10606 قال النبي :(@)(@@) | 30 ( تمرق مارقة عند فخرقة بين المسلمين فيقتلها أولى الطائفتين بالحق ) )(@)(@@) ( م د ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 10607 قال النبي :(@)(@@) | 30 ( تمسحوا بالأرض فإنها بكم برة ) )(@)(@@) ( طص ) عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ 10608 قال النبي :(@)(@@) | 30 ( تمضمضوا واستنشقوا ، والأذنان من الرأس ) )(@)(@@) ( حل ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 10609 قال النبي :(@)(@@) | 30 ( تمعددوا واخشوشنوا وانتضلوا وامشوا حفاة ) )(@)(@@) ( طب ) عن ابن أبي حدرد رضي الله عنه . PageV04P127(@)(@@) الإكمال من الجامع الكبير(@)(@@)(@@)(@@) $ 10610 قال النبي :(@)(@@) | 30 ( تمام إسلامكم أداء الزكاة ) ) ابن منده والديلمي عن ناجية بنت الحارث الخزاعي رضي الله عنه .(@)(@@)(@@)(@@) $ 10611 قال النبي :(@)(@@) | 30 ( تمثلت لي الحيرة كأنياب الكلاب ، وإنكم ستفتحونها ) )(@)(@@) ( طب ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ 10612 قال النبي :(@)(@@) | 30 ( تمد الأرض يوم القيامة مدا لعظمة الرحمان ، ثم لا يكون لبشر من بني آدم إلا موضع قدميه ، ثم أدعى أول الناس فأخر ساجدا ، ثم يؤذن لي فأقوم فأقول : يا رب أخبرني هاذا ، لجبريل ، وهو عن يمين الرحمان ، والله ما رآه جبريل قبلها قط ، إنك أرسلته إلي ، وجبريل ساكت لا يتكلم حتى يقول الله صدق ، ثم يؤذن لي في الشفاعة فأقول : يا رب عبادك عبدوك في أطراف الأرض فذاك المقام المحمود ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 10613 قال النبي :(@)(@@) | 30 ( تمد الأرض يوم القيامة لعظمة الرحمان ولا يكون فيها لأحد إلا موضع قدمه فأكون أول من يدعى ، فأجد جبريل قائما عن يمين الرحمان ، لا والذي نفسي بيده ما رأى الله قبلها ، فأقول : يا رب إن هاذا جاءني فزعم أنك أرسلته إلي وجبريل ساكت ، فيقول عز وجل : صدق أنا أرسلته إليك حاجتك ، فأقول : يا رب إني تركت عبادا من عبادك قد عبدوك في أطراف البلاد ، وذكروك في شعب الآكام ينتظرون جواب ما أجيء به من عندك ، فيقول : أما إني لا أخزيك فيهم ، فهاذا المقام المحمود الذي قال الله : عسى أن يبعثك 
