ms61	 من صفات عنك مخبرة % وإن تظنى جهول أنها لقب % 38(@)(@@) % كل الملابس يبلى عند بذلته % وتلك باقية أثوابها قشب % 39(@)(@@) % إن النباهة أدنى ما سعيت له % فإن خصصت بأقصاها فلا عجب % 40(@)(@@) % لك الهناء الذي للشانئيك به % لذع الهناء وإن لم يذهب الجرب % PageV01P176 41(@)(@@) % من كل مظهر ود ليس يضمره % وضاحك لك خوفا وهو مكتئب % 42(@)(@@) % ومن أحق التنويه من ملك % ماضي الغرار إذا ما كلت القضب % 43(@)(@@) % ترضى الملوك بأن يدعى لها شرفا % وتعتلي باسمه الأشعار والخطب % 44(@)(@@) % أناله الجود والإقدام منزلة % ما نالها سالفا آباؤه النجب % 45(@)(@@) % وتاج ملة خير الأنبياء له % جد وتاج ملوك الخافقين أب % 46(@)(@@) % وإن معاليهم طالت فقد بلغت % به المآثر مالا يبلغ الحسب % 47(@)(@@) % لقد ظفرت من المجد الصريح % نصيب طلابه الإكداء والنصب % 48(@)(@@) % منافيا كل من تخفيه همته % فليس يعرف إلا حين ينتسب % 49(@)(@@) % بك اقتضى الدين دينا حان ماطله % فيسر الله ما ترجو وترتقب % 50(@)(@@) % فليس يعصيك إلا من حشاشته % يستاقها الحتف أو يشتاقها العطب % PageV01P177 51(@)(@@) % وصلتني بصلات لا يجود بها % % إلا امرؤ ماله في ماله أرب % 52(@)(@@) % فمن بيانك ماء الفضل منهمر % ومن بنانك ماء الجود منسكب % 53(@)(@@) % والمجد إن كان في الأقوام مكتسبا % فإنه فيك مولود ومكتسب % 54(@)(@@) % سطوت فاستصغر الأنجاد من غلبوا % % وجدت فاستنزر الأجواد ما وهبوا % % 55(@)(@@) % كم من لهى جمة أتبعتها بلهى % كذبن من قال إني جارك الجنب % 56(@)(@@) % وزاد برك حتى صار ناسبكم % يعدني من ذوي القربى إذا نسبوا % % 57(@)(@@) % فقد تركت غنيا غير مقلية % لما تجدد لي في عامر نسب % 58(@)(@@) % وسوف أبقي على ذا الملك من كلمي % % مالا تحفيه الأحوال والحقب % 59(@)(@@) % من كل مطرية للفضل مطربة % من ليس يطرب والأوتار تصطخب % 60(@)(@@) % قول يضاعف بعد الدار قيمته % كالمسك يزداد قدرا حين يغترب % PageV01P178 61(@)(@@) % وكيف أمدحه من بعد معرفتي % % ألا أقوم بمعشار الذي يجب % 62(@)(@@) % لن يبلغ المدح أدنى ما تجود به % فلست تحرز إلا دون ما تهب % PageV01P179 البحر : طويل 1(@)(@@) % ليهن العلى 
ms62	 فرع غدوت له أصلا % % وغرس نمته تربة تنبت الفضلا % % 2(@)(@@) % ونعمى لشهر الصوم مد ظلالها % % سيشكرها من صام فيه ومن صلا % 3(@)(@@) % ويوم به أضحى المهيمن شائدا % لدين الهدى عزا يزيد العدى ذلا % 4(@)(@@) % لقد راعهم ليث الشرى وهو وحده % فكيف إذا لا قوه مستصحبا شبلا % % 5(@)(@@) % لعمري لقد أهدى البشير بشارة % ترد على الشيب الشباب الذي ولا % 6(@)(@@) % بأسعد مولود أتى فتضمنت % سعادته أن تطرد الخوف والمحلا % % 7(@)(@@) % سيفرع من قبل الفطام محلة % يرى زحلا منها لأخمصه نعلا % % 8(@)(@@) % ويبلغ من قبل البلوغ إلى مدى % تعذر أدناه على غيره كهلا % % 9(@)(@@) % فعشت له حتى يرى جد أسرة % يبيتون عن جد من المشتري أعلا % % 10(@)(@@) % ويلفى له عزم كعزمك والظبى % % تصل ونار الحرب ترهب أن تصلا % % PageV01P180 11(@)(@@) % فهمة مسعود كهمتك التي % % بنت شرفا يبلى الزمان وما يبلا % % 12(@)(@@) % فذاك شهاب مصطفى الملك زنده % وبالغصن قدما يعرف الرائد الحملا % % 13(@)(@@) % بعدة مولانا الإمام وسيفه % جلا الله من ريب النوائب ما جلا % 14(@)(@@) % وحل عقودا لو تيممها الورى % % بأجمعهم لم يستطيعوا لها حلا % 15(@)(@@) % فكم ملك خلاه في الناس مثلة % ولولاه لم تذهب طريقته المثلا % % 16(@)(@@) % أصاين وجهي عن معاشر أصبحوا % % لصدر العلى غلا وفي نحرها غلا % 17(@)(@@) % رويدك كم خففت عني بمنة % فحملتني من شكر آلائها ثقلا % % 18(@)(@@) % ومن أين يعدو النجع فيك وسائلي % % وما نزلت إلا بأوفى الورى إلا % 19(@)(@@) % فلا زال عني ظل مجدك إنه % عتاد لمن أكدى وهاد لمن ضلا % 20(@)(@@) % ولازلت مسموع التهاني بحضرة % عرائس أبكاري بها أبدا تجلى % % PageV01P181 البحر : كامل تام 1(@)(@@) % هل فوق مجدك غاية لطلاب % أم عن ذراك معرج لركاب % 2(@)(@@) % ما المنزل الآمال عندك مخفق % كلا ولا المرتاد بالمرتاب % 3(@)(@@) % فطل الورى وتمل رتبتك التي % % خطبتك وهي كثيرة الخطاب % 4(@)(@@) % وتملك العلياء بالسعي الذي % % أغناك عن متعالم الأنساب % 5(@)(@@) % بسواد نقع واحمرار صوارم % وبياض عرض واخضرار جناب % 6(@)(@@) % وافخر بعم عم جود يمينه % وأب لأفعال الدنية آب % 7(@)(@@) % بوراثة الأفعال أدركت المدى % % لا 
ms63	 شك قبل وراثة الألقاب % 8(@)(@@) % حسنات فعلك جمة فبأيها % % أصبحت منفردا من الأضراب % 9(@)(@@) % بمضائك المجتاح أم بقضائك المنتاش أم بعطائك المنتاب % تاش أم بعطائك المنتاب % 10(@)(@@) % أم بذل عفوك والذنوب كثيرة % أم قطع عزمك والسيوف نواب % PageV01P182 11(@)(@@) % في الأرض أهل ممالك ساحاتهم % وصدورهم قي المحل غير رحاب % 12(@)(@@) % لم يعجزوا في المكرمات وأعجبوا % % ولديك إعجاز بلا إعجاب % 13(@)(@@) % ولحلمك الإغضاء في الإغضاب % ولنيلك الإجداء في الإجداب % 14(@)(@@) % ولأنت غرة أسرة أيمانها % % ملأى من الإعطاء والإعطاب % 15(@)(@@) % من رازق في لزبة أو سابق % في حلبة أو ناطق بصواب % 16(@)(@@) % قوم إذا طلع العجاج عليهم % قتلوا العدى فانجاب عن أنجاب % 17(@)(@@) % وإذا تعذرت الغيوث بأرضهم % نابوا عن الأنواء خير مناب % 18(@)(@@) % حربوا الزمان فنال منهم ثأره % بشيا خطوب لا بحد حراب % 19(@)(@@) % وأتيت في أعقاب قومك عالما % في الروع فضل فوارس الأعقاب % 20(@)(@@) % فأخفته حتى انبرت أحداثه % مفلولة الأظفار والأنياب % PageV01P183 21(@)(@@) % ما بين خطب رعته بعزيمة % تردي وخطب ذدته بخطاب % 22(@)(@@) % يا أحضر الأمراء في حسم الأذى % % قولا وأحصرهم غداة سباب % 23(@)(@@) % شرف الندي وأنت فيه المحتبي % % شرف الندى المعطى وأنت الحابي % % 24(@)(@@) % لو راء ما يأتي أوائل وائل % بمحض الفخر منك لباب % 25(@)(@@) % للناصر بن الناصر الشرف الذي % % ما شمسه محجوبة بضباب % 26(@)(@@) % ملك إذا اجتاب المفاضة في وغى % عانيت ليثا في قميص حباب % 27(@)(@@) % يلفي طنين ذباب كل مهند % في سمعه عزا طنين ذباب % 28(@)(@@) % شفع الشجاعة بالخشوع لربه % ما أحسن المحراب في المحراب % 29(@)(@@) % وغدا يحاسب نفسه لمعاده % وهباته تترى بغير حساب % 30(@)(@@) % إن القوافي مذ أتتك موادحا % أمنت من الإكداء و الإكذاب % PageV01P184 31(@)(@@) % فلتفخر الأيام منك بباسل % غمر الثواب مطهر الأثواب % 32(@)(@@) % يقظان أوجده التناهي في النهى % % عدم اللعاب بربعه والعاب % 33(@)(@@) % قد كنت عن حوك القريض منكبا % فأتيح لي عرفان وجه صوابي % % 34(@)(@@) % فلأكسون علاك من حبراته % حلل الملوك وحلية الأداب % 35(@)(@@) % ولأهدين المدح عز نظيره % لأعز فرع في أجل نصاب % 36(@)(@@) % ولأبقين على عدي مثل 
ms64	 ما % % أبقى حبيب في بني عتاب % PageV01P185 البحر : بسيط تام 1(@)(@@) % بالحول نلت ونال الناس بالحيل % فسد جميع الورى مستوجبا وطل % 2(@)(@@) % وارسم لدهرك ما تختار يجر على % % عادات مستمع للرسم ممتثل % 3(@)(@@) % مازلت تلتذ طعم العفو مقتدرا % حتى ابتغي عندك الإحسان بالزلل % 4(@)(@@) % هذي الفضائل لم نعرف لها شبها % ضل الورى حين قالوا الفضل للأول % 5(@)(@@) % فكيف يثبت هذا في قياسهم % وخيرة الخلق أضحى خاتم الرسل % 6(@)(@@) % أجلت أعيننا في كل معجزة % لم تجر في خلد منهم ولم تجل % 7(@)(@@) % فإن أتى حسن من فعل بعضهم % فقد يصح وقوع السعد عن زحل % 8(@)(@@) % لله رأي إمام الخلق كيف سرى % % إليك والوقت داج مظلم السبل % 9(@)(@@) % ألفى الوزارة لم تسند إلى وزر % يوما ولم يخل طرف العين من خلل % 10(@)(@@) % فربها منك نحو الكفء يمهرها % % آراء مكتهل في عزم مقتبل % PageV01P186 11(@)(@@) % ما زال إن طغت الأعداء جللها % % رأيا يفل شباة الحادث الجلل % 12(@)(@@) % أزلت قرة عن دار القرار بما % % أعملته من سداد الرأي والعمل % 13(@)(@@) % مالوا عن الحق فاستنهضت نحوهم % فوارسا غير ما ميل ولا عزل % 14(@)(@@) % لو لم ينم صهيل الخيل تحتهم % ظنوا شموس ضحى وافت على قلل % 15(@)(@@) % تهديهم و دياجي الليل مظلمة % لمع الأسنة في الخطية الذبل % 16(@)(@@) % أولغتها من دم الأوداج ظامئة % وزدتها دفعا في العل والنهل % 17(@)(@@) % فحين ما ثملت هزت معاطفها % % وغير بدع تثني الشارب الثمل % 18(@)(@@) % أشرقت حين تركت الشمس شاحبة % كأنما ألبست دكنا من الحلل % 19(@)(@@) % وراح نقعك في أجفانها كحلا % وما عهدنا بجفن الشمس من كحل % 20(@)(@@) % عزائم مغربيات تناذرها % % أهل العراقين قبل السهل والجبل % PageV01P187 21(@)(@@) % لقد رأى طغلبك في تخوفها % % رأيا بعيدا من التثريب والخطل % 22(@)(@@) % أضحى يظن ضياء الصبح من قضب % سلت وأن نجوم الليل من أسل % 23(@)(@@) % تركت أعضاءه تنقد من وجل % رعبا وأضلعه تنقض من وهل % 24(@)(@@) % فلا تلمه إذا لم يشك علته % فالميت لا يتشكى حادث العلل % 25(@)(@@) % قد أصبحت صفحات الملك مشرقة % وصافحتك بتسليم يد الدول 
ms65	 % 26(@)(@@) % فاحكم بسعدك رفيما أنت فاعله % وجاوز الحكم بالجوزاء والحمل % 27(@)(@@) % فالسبعة الشهب لو نالت أمانيها % % لأصبحت خولا مع هذه الخول % 28(@)(@@) % بالكامل الأوحد استخذى الزمان لنا % % وصار ينعت بالهيابة الوكل % 29(@)(@@) % آباؤه الغر طالوا الناس كلهم % وأصبح المجد منهم محصد الطول % 30(@)(@@) % زالوا وخلدت العلياء ذكرهم % كأن أشخاصهم في الناس لم تزل % PageV01P188 31(@)(@@) % الحاكمين بما في الشرع من حكم % والناصريه على الأديان والملل % 32(@)(@@) % لم يبق في كبد المعروف من غلل % بهم ولا في قناة المجد من ميل % 33(@)(@@) % ومتربون من العلياء تربهم % ألمى الشفاه من التعفير والقبل % 34(@)(@@) % أصخ إلى الدهر تسمع قوله طربا % هذا ولي علي صفوة ابن علي % % 35(@)(@@) % يا سامعا صوت أهل الأرض من بعد % وليس يسمع نجوى اللوم في العذل % 36(@)(@@) % لقد حقنت دم العليا بجود يد % مخضوبة بدماء المحل والبخل % 37(@)(@@) % أظما إلى رشفها يوما فيصدفني % % عنها تعرض سيل العارض الهطل % 38(@)(@@) % هذي كواعب قد وافتك مقسمة % أن لم تزف إلى بعل ولم تنل % 39(@)(@@) % قد صنتهن عن الخطاب قاطبة % كما تصان ذوات الخدر بالكلل % 40(@)(@@) % لولاك ما حليت يوما ترائبها % % ولا نضا الدهر عنها حلة العطل % PageV01P189 41(@)(@@) % إن غاب شخصي عن هذا المقام فقد % صحبته بالرجاء المحض والأمل % 42(@)(@@) % فانعم بتخفيف ما أسديت من نعم % بكثرة النور يعشى ناظر المقل % 43(@)(@@) % واستبق مهجة عبد رحت مالكه % فرب حتف جناه كثرة الجذل % 44(@)(@@) % ولتمهلن الليالي حاسديك فقد % سقتهم المهل والغسلين في مهل % 45(@)(@@) % وافن الزمان بعز غير منصرم % وسؤدد بنواصي النجم متصل % PageV01P190 البحر : كامل تام 1(@)(@@) % إن العلى المعيي الملوك طلابها % % لك دون هذا الخلق يفتح بابها % % 2(@)(@@) % خطبتك العلى راغبة إليك وطالما % % ردت على أعقابها خطابها % % 3(@)(@@) % ولقد فرعت بما صنعت محلة % لولا النجوم تعذرت أترابها % % 4(@)(@@) % وبك انجلى عن مقلة الحق القذى % % وانجاب عن ليل الخطوب حجابها % % 5(@)(@@) % وأعدت أيام الخلافة غضة % فمضى شباها منذ عاد شبابها % % 6(@)(@@) % مسترجعا بالمرهفات ممالكا % لولاك ما غصت بها غصابها % % 7(@)(@@) % فافخر فإنك غرة في 
ms66	 أسرة % دلت على أنسابها أحسابها % % 8(@)(@@) % وتملها خيما حباك النصر من % مدت لنصرة دينه أطنابها % % 9(@)(@@) % طلعت بأعلاها نجوم دجى ضحى % زهرت فمن أنوارها جلبابها % % 10(@)(@@) % وبها الحيا والشمس طالعة فهل % عقدت على الفلك المدار قبابها % % PageV01P191 11(@)(@@) % قصر إذا الشعراء رامت وصفه % عجزت وقصر دونه إطنابها % % 12(@)(@@) % في كل فتر منه حرب لم ترع % من قاتلته سيوفها وحرابها % % 13(@)(@@) % كثرت مهاواة الرجال مشيرة % بظبى صوارمها وقل ضرابها % % 14(@)(@@) % تحمي الرماة بها حقائقها ولم % يسطع فراق قسيها نشابها % % 15(@)(@@) % فترى الأسود به فوارس حيث لا % تعدو ولا تفري الطلى أنيابها % % 16(@)(@@) % وترى الفوارس لا تمل جيادها % % تزجي الظعائن لا تكل ركابها % % 17(@)(@@) % أبدا تسير ولا تزول فهل ترى % % عرفت غيوث الجود أين مصابها % % 18(@)(@@) % عزم متى تصل العدى أخباره % قبل العيان تقطعت أسبابها % % 19(@)(@@) % يا متعب النفس النفيسة حسب من % قارعت عنه راحة إتعابها % % 20(@)(@@) % من هم بالعلياء هام فؤاده % وجدا بها وحلا بفيه صابها % % PageV01P192 21(@)(@@) % أينال من صعبت عليه سهولها % % ما نال من سهلت عليه صعابها % % 22(@)(@@) % تفديك من غير الزمان خلائق % في راحتيك ثوابها وعقابها % % 23(@)(@@) % إن السماء رأت فعالك في الورى % % فإذا دعوا لك فتحت أبوابها % % 24(@)(@@) % والأرض إن خافت فمنك ذهاب ما % % تخشى وإن ظمئت فمنك ذهابها % % 25(@)(@@) % لا تشتكي ظلما وعدلك جارها % % كلا ولا ظلما وأنت شهابها % % 26(@)(@@) % خبثت فمذ طهرتها بدماء من % خبثت بهم طهرت وطاب ترابها % % 27(@)(@@) % لولا فعالك بالطواغي لم تلذ % حذر البوار برومها أعرابها % % 28(@)(@@) % هيهات لا عز يتاح وقد % دانت لملكك كلبها وكلابها % % 29(@)(@@) % وبلاد أرمانوس سوف تشيمها % % إن حان مالكها وحان خرابها % % 30(@)(@@) % والملك لا يبقى له إلا كما % % يبقى على وجه المدام حبابها % % PageV01P193 31(@)(@@) % والروم ثابتة كما زعمت إذا % % ثبتت على وقع السيوف رقابها % % 32(@)(@@) % ولها من البيض الرقاق رهافها % % إن لم تنب ومن العتاق صلابها % % 33(@)(@@) % خيل إذا ركضت تساوى عندها % % من كل أرض وهدها وهضابها % % 34(@)(@@) % تردي بآساد خوادر في القنا % % منها أظافرها ومنها غابها % % 35(@)(@@) % وأمامها 
ms67	 ظفر يذل له العدى % % ويفل ظفر النائبات ونابها % % 36(@)(@@) % إذعر جيوشهم بجيشك إنها % % نعم وأطراف الوشيج ذئابها % % 37(@)(@@) % والقوم إن شطت بعزهم النوى % % فابن المفرج لا تشك غرابها % % 38(@)(@@) % إن زرت مملكة النصارى زورة % أعيا على أصحابها إصحابها % % 39(@)(@@) % ثبتت بأفئدة العدى لك هيبة % ستزول من إلبابها ألبابها % % 40(@)(@@) % همم يهيب بها الولي لدفع ما % % يخشى ولكن العدو يهابها % % PageV01P194 41(@)(@@) % عزت وجادت فالمروع طريدها % % في كل أرض والمريع جنابها % % 42(@)(@@) % يا مصطفى الملك المظفر دعوة % عدواك أن عدت الخطوب جوابها % % 43(@)(@@) % حسنت بك الدنيا فإن هي أعجبت % تيها فليس بمنكر إعجابها % % 44(@)(@@) % إن القوافي وهي غير ملومة % مذ أصبحت دأبي فمدحك دابها % % 45(@)(@@) % ف لبس من الحمد المؤثل موقنا % أن المحامد لن ترث ثيابها % % 46(@)(@@) % حللا علي وما أكافئ نسجها % % وعلى مناقبك العلى إذهابها % % 47(@)(@@) % وإذا الخيول تسابقت في حلبة % بانت هناك هجانها وعرابها % % 48(@)(@@) % قد صح لي كدر الملوك وغدرها % % لما وفى لي صفوها ولبابها % % 49(@)(@@) % غريت صروف الدهر بي إن غرني % % من بعد أن هطلت يداك سرابها % % 50(@)(@@) % أحليت لي العيش الأمر بأنعم % صدقت بوارقها وسح سحابها % % PageV01P195 51(@)(@@) % ونظرتني كرما بمقلة عالم % أن الرجال حليها آدابها % % 52(@)(@@) % فاسلم وإن رغمت عداك لأمة % لولاك طال على الزمان عتابها % % PageV01P196 البحر : خفيف تام 1(@)(@@) % ضل من يستزير طيف الخيال % هل تداوى حقيقة بالمحال % 2(@)(@@) % سنة سنها المحبون جهلا % كسؤال الربوع والأطلال % 3(@)(@@) % أو كمزجي القلاص في غير قصد % أو مرجي مكارم البخال % 4(@)(@@) % أو كلاح سعى بمن لا أسمي % % موقنا أن سعيه في ضلال % 5(@)(@@) % بأبي من عدا فجاوز أعدا % % ئي ولو كان منهم لرثى لي % % 6(@)(@@) % والتعدي يسلي المحب فما با % % لي لا يخطر السلو ببالي % % 7(@)(@@) % ذو عتاب لغير معنى وسخط % لا لجرم وهجرة عن ملال % 8(@)(@@) % سلب الوحش خلتين تصولا % ن وكلتاهما طريق وبال % 9(@)(@@) % فهو طورا يردي بسطوة ضرغا % % م وطورا يعدو بعيني غزال % 10(@)(@@) % زاد فتكا واستجمعت خدعة المح % تال فيه ووثبة المغتال % PageV01P197 11(@)(@@) % فلذا ما 
ms68	 أزال أنشد قلبا % ضل بين الدلال والإدلال % 12(@)(@@) % لامني ضلة وما كنت أخشى % % أن يصير الحبيب من عذالي % % 13(@)(@@) % ولقد آن أن أداوي صبابا % % تي بداء من المشيب عضال % 14(@)(@@) % عادلا بالقريض عن سنن العش % ق إلى عاشق لحسن الفعال % 15(@)(@@) % من إذا ما الكمال أعلى ملوكا % طال بالإزدياد فوق الكمال % 16(@)(@@) % عزها وابن تاجها منشر الآما % % ل جودا وقاتل الأقيال % 17(@)(@@) % هام بالهمة الحصان فؤادا % فهو عاصي الملام قاصي الملال % 18(@)(@@) % وسما شارخا فزاد على السا % % مين بعد المشيب والإكتهال % 19(@)(@@) % وخضم يأبى وإن كثر الورا % % د أن يظفروا بغير زلال % 20(@)(@@) % فترى الجار عنده ناعم البا % % ل ويحيى به الرجاء البالي % % PageV01P198 21(@)(@@) % أوضح المجد للورى وحماه % فهو بادي المنار صعب المنال % 22(@)(@@) % در نيل المنى وإن أغرت الأط % % ماع قوما غرتهم بالمحال % 23(@)(@@) % فلوات تجاب بالجود والإق % % دام لا بالذميل والإرقال % 24(@)(@@) % مقفرات يكون من سار فيها % % عرضا للبوار أو للضلال % 25(@)(@@) % جازها سابق بن محمود السا % % بق يوم الندى ويوم النزال % 26(@)(@@) % وسعى سعي أوليه فأربى % % باختيار الفضائل الأعقال % 27(@)(@@) % ووفى لاسمه وكنيته العز % % م فقاما معا مقام الفال % 28(@)(@@) % ملك إن أتى الوفود ذراه % صدهم عرفه عن الإرتحال % 29(@)(@@) % حيث لم يفصموا عرى الظن باليأ % % س ولم يوصموا بذل السؤال % 30(@)(@@) % ووقور الأطراب إن زفت الصه % باء بين الأهزاج والأرمال % PageV01P199 31(@)(@@) % وطروب أوان تجتمع الأط % % راب بين الصليل والتصهال % 32(@)(@@) % وله من بني بويه جدود % ذهبوا بالإعظام والإجلال % 33(@)(@@) % كل ملك قد حاز فضل أبيه % مثل حوز البهاء فضل الجلال % 34(@)(@@) % فمساعي الأجداد لن يبعد العه % % د بها وهي وضح في الحال % 35(@)(@@) % قد كفاها أبو الفوارس أن يق % دح فيها تنقل الأحوال % 36(@)(@@) % يا بن من ذاد عن رجائي ومدحي % % كل غث الحباء رث الحبال % 37(@)(@@) % عصب موقع الوسائل منهم % موقع الشيب من ذوات الحجال % 38(@)(@@) % وعدهم معوز فإن بذلوه % فهو وقف على المطال المطال % 39(@)(@@) % وإذا ما الحاجات حلت لديهم % متن طوع الإمهال والإهمال 
ms69	 % 40(@)(@@) % زرته كي يظلني فأصارت % % ني عطياته مديد الظلال % PageV01P200 41(@)(@@) % لم يدع حاسدا يفوه بإخفا % % قي وقد جئت حاشدا آمالي % % 42(@)(@@) % إذ رجائي لديه وقف على النج % ح وفألي مصدق مذ وفى لي % % 43(@)(@@) % نضلت مأثراته ولهاه % كل سهم أعددته للنضال % 44(@)(@@) % وحباني بالانبساط إلى أن % حزت فعل العبيد عند الموالي % % 45(@)(@@) % وببعض الذي أنال من الإك % رام رب النوال رب النوال % 46(@)(@@) % ولو أني أدللت في غير مغنا % % ه لكف الإدلال بالإذلال % 47(@)(@@) % فسقى الله تربة حل فيها % % موطن الفضل معدن الإفضال % 48(@)(@@) % الأسد الأشد إن كان سلم % أو وغى والألد عند الجدال % 49(@)(@@) % طالما قلت للمسائل عنكم % واعتمادي هداية الضلال % 50(@)(@@) % إن ترد علم حالهم عن يقين % فالقهم في مكارم أو قتال % PageV01P201 51(@)(@@) % تلق بيض الأعراض سود مثار ال % % نقع خضر الأكناف حمر النصال % 52(@)(@@) % أشر إن طغى بهم أشر العز % أزالوا رواسي الأجبال % 53(@)(@@) % وإذا حاربوا رأيت قلوب الأ % سد قد أودعت صدور الرجال % 54(@)(@@) % وبهم زلزلت بمن قارعوا الأر % ض وهم أمنها من الزلزال % 56(@)(@@) % ولكم في المديح أبقى سمات % تركتها الأقوال في الأقيال % 57(@)(@@) % لو أتيحت لدارم بن تميم % بضعة من فخارك المتوالي % % 58(@)(@@) % حجبوا حاجبا إذا عدد الفخ % ر ولم يطلقوا عقال عقال % 59(@)(@@) % منع الناس أن يروموا مداكم % فرط حب النفوس والأموال % 60(@)(@@) % واكتفى محدث بذكر قديم % راضيا بالملابس الأسمال % 61(@)(@@) % فإذا طولبوا بما يوجب الحم % % د أحالوا على العظام البوالي % % PageV01P202 62(@)(@@) % وامتنعتم من أن يباح لكم جا % % ر ببيض الظبى وسمر العوالي % % 63(@)(@@) % كامتناع النجوم في حيث حلت % لا امتناع الليوث في الأغيال % 64(@)(@@) % وهمى جودكم جزافا إلى أن % زال حكم الميزان والمكيال % 65(@)(@@) % وقديما عرفتم مذ ملكتم % أن يفوق المتلو فضل التالي % % 66(@)(@@) % ولهذا ننسى بأفعال محمو % % د معالي نصر ومجد ثمال % 67(@)(@@) % أنت أنداهم إذا أجدب العا % % م وأهداهم لطرق المعالي % % 68(@)(@@) % قصر السابقون دون مداها % % وتملكتها بست خصال % 69(@)(@@) % مكرمات مع اعتذار وعفو % باقتدار وعفة في جمال % 70(@)(@@) % وبحق 
ms70	 أن ظلت فيها بلا مث % ل وقد سدتها بغير مثال % 71(@)(@@) % لقم جبته بغير دليل % وهو خافي المجاز ضنك المجال % PageV01P203 72(@)(@@) % آخذ باليمين ما أوجبته % لك قبل اليمين أخت الشمال % 73(@)(@@) % ما ذكرت الأوطان مذ ظل طرفي % % راتعا في جلال هذي الخلال % 74(@)(@@) % بجناب إذالة المال فيه % أعربت عن إنالة الآمال % 75(@)(@@) % ومتى قلت أنت بعض كرام ال % عصر قست الأتي بالأوشال % 76(@)(@@) % وبنات الجديل إن عن ركض % لا تجاري بنات ذي العقال % 77(@)(@@) % كم سبقت المنى بصوب يمين % في العطايا كثيرة الإرتجال % 78(@)(@@) % هي أغلت بالعز كل رخيص % واستهلت فأرخصت كل غال % 79(@)(@@) % كلما أخلفت مواعيد برق % خلفت كل وابل هطال % 80(@)(@@) % مكرمات إذا الصفات نحتها % % وقعت دونها سهام المغالي % % 81(@)(@@) % لو تعديتها فواقا إذا عد % % ت بظن على محال محال % PageV01P204 82(@)(@@) % ما بغاها من عند غيرك من يف % رق بين الأطواق والأغلال % 83(@)(@@) % دمت فيما حوت يداك وتحوي % % آمنا من تغير أو زوال % 84(@)(@@) % إن شهر الصيام أظهر أمرا % ما عهدناه في العصور الخوالي % % 85(@)(@@) % ليلة القدر فيه كانت خصوصا % خلقت للعباد والأبدال % 86(@)(@@) % وأتتنا في ذا الأوان عموما % قبل ميقاتها بسبع ليال % 87(@)(@@) % فشكرنا له ولم يعدم الشك % % ر هلال أفضى إلى شوال % 88(@)(@@) % ولقد فاز بالثناء هلال % بشر البدر قبله بهلال % 89(@)(@@) % خبر ما وعته أسماع أعدا % % ئك حتى أغصهم بالزلال % 90(@)(@@) % رهبة من نضاله وإلى الآ % % ساد قدما تنجل الأشبال % 91(@)(@@) % فتهن العيدين باليمن زارا % % من مقيم وظاعن في الحال % PageV01P205 92(@)(@@) % سبقت بالجميل أفعالك الغر % فجاءت وراءها أقوالي % % 93(@)(@@) % أثقلتها أعباء نعماك فابسط % عذرها إن أتتك غير عجال % 94(@)(@@) % ثم لا تلحها إذا هي ضلت % بين آلائك العراض الطوال % 95(@)(@@) % قد توالى شكري وصح ولائي % % فتقبل عذر الموالي الموالي % % 96(@)(@@) % وأقلني إذا عجزت وإن كا % % ن عثار المقال غير مقال % 97(@)(@@) % مع أني لم أخل ملكك من نظ % % م لآل تبقى بقاء الليالي % % 98(@)(@@) % ضل غيلان إذ بغاها فلم يح % % ظ بلال من بحرها ببلال 
ms71	 % PageV01P206 البحر : طويل 1(@)(@@) % بقيت لذا العز الذي عز مطلبا % % ولا زال ظن الحاسديك مخيبا % % 2(@)(@@) % لقد جلت البشرى بتكذيب ما حكوا % % فأهلا بما قال البشير ومرحبا % % 3(@)(@@) % ولله قول كان للشمل جامعا % وللبغي مجتاحا وللهم مذهبا % 4(@)(@@) % ويا حبذا القول بان مينه % إذا كان عما في الضمائر معربا % % 5(@)(@@) % عرفت به ما في القلوب فلم تجد % بها عنك معتاضا ولا عنك مرغبا % % 6(@)(@@) % جنيت ومن الإحسان والعدل والتقى % % هوى عدمت فيه القلوب التقلبا % % 7(@)(@@) % يفوق هوى من يعشق الطرف أحورا % وصبوة من يصبو إلى الثغر أشنبا % % 8(@)(@@) % فلا طوت الأقدار أيامك التي % % تذكر أيام الصبا كل أشيبا % % 9(@)(@@) % ولا أقلع النوء الذي أنت غيثه % فلسنا نرى عاما بظلك مجدبا % % 10(@)(@@) % ونبت الوهاد كان قبلك ذاويا % فلما أتيت اخضر ما تنبيت الربا % % PageV01P207 11(@)(@@) % طلعت على ذي الأرض أيمن طالع % فأمنت مرتاعا وأرهبت مرهبا % % 12(@)(@@) % فإن لم تكن أفعالك المجد نفسه % فلا شك أن المجد منها تركبا % % 13(@)(@@) % فلا يلتمس إدراك رتبتك الورى % % فما عرضت للخاطبين فتخطبا % % 14(@)(@@) % لقيدتها بالمأثرات محوطا % عليها فلم تترك لها عنك مذهبا % % 15(@)(@@) % فما هي إلا حوز من طاب مولدا % ونشرا وأخبارا وعرقا ومنصبا % % 16(@)(@@) % وذي شيم سيفية ناصرية % قضين له ورث العم والأبا % % 17(@)(@@) % فأصبح مدعوا بما دعيا به % فلا فرق فيها أن يسمى وينسبا % % 18(@)(@@) % إذا نزل العافون مغناه جادهم % حيا مزنة عاداتها أن تصوبا % % 19(@)(@@) % ولم يجدوا غيم المواعيد زبرجا % لديه ولا برق الطلاقة خلبا % % 20(@)(@@) % فوازن به أهمى الغيوث إذا حبا % % ووازن به أرسى الجبال إذا أحتبا % % PageV01P208 21(@)(@@) % ولو لم يصدق ناصر الدولة المنى % % بأنعمه لم تلق إلا مكذبا % % 22(@)(@@) % من القوم لم يغضوا لباغ على قذى % فواقا ولم يرضوا سوى الحمد مكسبا % % 23(@)(@@) % أناس سقوا در الإباء لينتخوا % % كما سقي الماء الحديد ليصلبا % % 24(@)(@@) % أطاعتهم الأيام في نيل ما بغوا % % ولو غالبتهم أحرزوه تغلبا % % 25(@)(@@) % لئن كان هذا الدهر مالك أهله % فإنكم ملاكه شاء أو أبا % % 26(@)(@@) % وأنتم مقر الملك قدما وإنما 
ms72	 % % يرى نازلا في غيركم إن تغربا % % 27(@)(@@) % أتى ملككم من مطلع الشمس مشبها % سناها فلما طبق الأرض غربا % % 28(@)(@@) % وكان يود الغرب لو كان مشرقا % فصار يود الشرق لو كان مغربا % % 29(@)(@@) % إذا ما شهدتم مأزقا شهد الورى % % بأنكم أجرى وأمضى من الظبا % % 30(@)(@@) % ملأتم قلوب العالمين مهابة % وحق لأسد الغاب أن تتهيبا % % PageV01P209 31(@)(@@) % فكم غضت الأبصار عند لقائكم % خضوعا وفضت عند ذكركم الحبا % % 32(@)(@@) % وكم قال رائي جودكم ووفائكم % وبأسكم ما الفخر إلا لتغلبا % % 33(@)(@@) % فيا ملكا ما زال لله مرضيا % وللإفك في نصح الخلافة مغضبا % % 34(@)(@@) % ويامن طوى عز الأعادي وما انتضى % % حساما ولا أنضى من الركض مقربا % % 35(@)(@@) % بلى أسكن البيض الجفون مجردا % صوارم عزم لا يفل لها شبا % % 36(@)(@@) % وثاقب آراء يضيء لها الدجى % % وصادق أفكار تريه المغيبا % % 37(@)(@@) % لقد طال ما استنقذت بالأمن خائفا % وقوع الردى وانتشت بالعفو مذنبا % % 38(@)(@@) % إذا عد أمجاد الدنا كنت واحدا % وإن سعرت نار الوغى كنت مقنبا % % 39(@)(@@) % جمعت فخرت الفخر نفسا نفيسة % وقلبا على صرف النوائب قلبا % % 40(@)(@@) % وطرفا إلى غير الفضائل ما رنا % % وسمعا إلى غير المحامد ما صبا % % PageV01P210 41(@)(@@) % مناقب قد خصت نزار يزينها % % مواهب قد عمت نزار ويعربا % % 42(@)(@@) % فهنيت أعياد الزمان مملكا % ذرى شرف من رامه زل أو كبا % % 43(@)(@@) % وبلغت أقصى غاية السؤل في أبي % % علي فما أسخى وأنخى وأنجبا % % 44(@)(@@) % جرى في مدى جليت فيه مصليا % وما كل فرع طيب الأصل طيبا % % 45(@)(@@) % لقد أظهر الدهر الذي هو عينه % به اليوم إعجابا ومنه تعجبا % % 46(@)(@@) % إذا زرته لم أدر هل جئت مجلسا % حوى جمل العلياء أم جئت مكتبا % % 47(@)(@@) % بحيث ألاقي حلة الفضل بالحجى % % مطرزة والحلم يستغرق الصبا % % 48(@)(@@) % رأيت أخاه مثله و { ايته % يساير من أبنائه الغر موكبا % % 49(@)(@@) % هما كوكبا سعد أنافا وأشرقا % % فلا أفلا ما أطلع الليل كوكبا % % 50(@)(@@) % سماعك قولي من أجل جوائزي % % فقل للهى مهلا فما حلل الربا % % PageV01P211 51(@)(@@) % سأثني بقدر الجهد للعي غالبا % ولا أبتغي ما تستحق 
ms73	 فأغلبا % % 52(@)(@@) % ولو كنت أرجو أن تقوم مدائحي % % بأيسر ما تأتي لأشبهت أشعبا % % 53(@)(@@) % أصار لماء المدح جودك مسربا % % و أصفيته من جودك الغمر مشربا % % 54(@)(@@) % فلا عذر للعشر الذي فاض بحره % إذا لم يكن في وصف فضلك مطنبا % % 55(@)(@@) % وهذي المساعي عن صفاتي غنية % ولكنها لم تمل إلا لأكتبا % % 56(@)(@@) % ولا برح المولي بك العدل مانعا % مكانك من أعلى من الناس أو حبا % % 57(@)(@@) % ولا زلت تجلو الحادثات وتجتلي % % عذارى القوافي ما جلى الصبح غيهبا % % PageV01P212 البحر : وافر تام 1(@)(@@) % ظلامة من أعدك لليالي % % ومن أثنى بفضلك غير آل % 2(@)(@@) % أيا ثقة الثقات أصخ فواقا % لتسمع ما يشق على المعالي % % 3(@)(@@) % أما أنا مثبت الحجج القواضي % % لكم بالمجد في الحجج الخوالي % % 4(@)(@@) % ومفردكم للا سبب بشكر % تعالمه المعادي والموالي % % 5(@)(@@) % ثناء لم أشبه باختلاق % % ووصف لم أشنه بانتحال % 6(@)(@@) % إليكم دون ذا الخلق اعتزائي % % وعنكم كان صدي واعتزالي % % 7(@)(@@) % وقد سمع الورى في كل أرض % وليس المين من شيمي مقالي % % 8(@)(@@) % إذا ذكر البيوت عدا قصيا % فآل أبي عقيل خير آل % 9(@)(@@) % وأنت أعزهم جارا ونفسا % وأغلبهم على شرف الخلال % 10(@)(@@) % علوتهم بنانا في العطايا % % وفتهم ثباتا في النضال % PageV01P213 11(@)(@@) % ألست ابن المنبي عن سجايا % % بهن تفاوتت قيم الرجال % 12(@)(@@) % يظل جنابه مأوى الأماني % % ويمسي بابه ملقى الرحال % 13(@)(@@) % يحكم في الذخائر سائليه % ويمنعهم من الأسل الطوال % 14(@)(@@) % وذاك الوفر بال وهو باق % بهذا الشكر باق وهو بال % 15(@)(@@) % وإنك في اكتساب الحمدش حقا % لتأتي سابقا وأبوك تالي % % 16(@)(@@) % تحيفني الزمان بكل فن % فما أنفك من داء عضال % 17(@)(@@) % وأعوزت الأمانة فيه حتى % % تخوفت اليمين من الشمال % 18(@)(@@) % وأذهب كل ما أحوي ضياعا % فها أنا ذا بنار الفقر صال % 19(@)(@@) % وقد أودعت ما أبقى صديقا % فعرضت البقية للوبال % 20(@)(@@) % وقصر عن أمانته كأني % % طلبت الوخد من جمل ثقال % PageV01P214 21(@)(@@) % فلا تركن إلى زمن خؤون % لآمله سريع الإنتقال % 22(@)(@@) % فما يك فيه من خير وشر % قليل اللبث منتظر الزوال % 23(@)(@@) % لقد 
ms74	 ضل امرؤ رام اهتضامي % % ولست مشايعا أهل الضلال % 24(@)(@@) % وأقدم من بغى إغضاب مثلي % % على أمر ثناه على مثال % 25(@)(@@) % وتلك حكومة عزت مراما % فما خطرت لذي ظلم ببال % 26(@)(@@) % سقى ذو العرش رهبان النصارى % % وجادهم بمنهل العزالي % % 27(@)(@@) % فما منعوا الودائع مودعيها % % لضرب من ضروب الإعتلال % 28(@)(@@) % ولا شدوا أكفهم عليها % % لتؤخذ بالخصومة والجدال % 29(@)(@@) % كتبت إليه أعطفه بذل % فأضرب عن مقال أو فعال % 30(@)(@@) % وما قرأ الكتاب ولا كتابا % به عرف الحرام من الحلال % PageV01P215 31(@)(@@) % وما أسميه إبقاء لود % سلا عنه وما أنا عنه سال % 32(@)(@@) % وإن كان الوداد اليوم بين ال % % رجال كود ربات الحجال % 33(@)(@@) % ولما سيل في وفاض جودا % أحال على التعلل والمطال % 34(@)(@@) % فشد بذا قوى ضعفت حياء % وسد طريق صبري واحتمالي % % 35(@)(@@) % وأنت إذا عدا باغ سلاحي ال % % حصين وإن عرا خطب ثمالي % % 36(@)(@@) % وأمرك نافذ فينا فأطلق % بمحض العدل حقي من عقال % 37(@)(@@) % فإنك لا تمل العدل بين ال % خصوم ولا تميل ولا تمالي % % 38(@)(@@) % لقد آلت بي الدنيا فقبحا % لما صنعت إلى هذا المآل % 39(@)(@@) % وغال الدهر منزلتي ووفري % % فأرخص من مديحي كل غال % 40(@)(@@) % مضى الكرماء صانوا ماء وجهي % % بما بذلوه عن ذل السؤال % PageV01P216 41(@)(@@) % وها أنا بعدهم في الناس أبغي % % كريما يشتري شكري بمالي % % 42(@)(@@) % أرى الأكدار يشرق شاربوها % % فواشرقي من الماء الزلال % 43(@)(@@) % لعلك يابن عبد الله ترعى % % قديم الود أو ترثي لحالي % % 44(@)(@@) % ولا تحبس جميلك عن موال % لكم ولنشر فضلكم موالي % % 45(@)(@@) % وفي الأمرين من منع وبذل % فإني شاكر في كل حال % 46(@)(@@) % وماذا القول تمهيدا لظلمي % % ومثلك لا يميل إلى المحال % 47(@)(@@) % وليس بغامض وأبيك أمري % % فأنسبه إلى جور الليالي % % 48(@)(@@) % ولولا فاقة فاقت فعاقت % لصنت علاك عن هذا المقال % 49(@)(@@) % سأترك ذي البلاد بلا اختيار % وأهجر أهلها لا عن تقال % 50(@)(@@) % بحال لو تأملها عدوي % % لساهمني الرزية أو رثى لي % % PageV01P217 51(@)(@@) % فزودني بما تأتي حديثا % سيروى في العراق وفي الشمال % 52(@)(@@) % فإني فقت غيلانا 
ms75	 مقالا % يسير وأنت أكرم من بلال % 53(@)(@@) % أدام لك العلى والنصر مولى % إليه في حراستك ابتهالي % % PageV01P218 البحر : طويل 1(@)(@@) % بسعدك دارت في السماء الكواكب % وسارت لتشييد العلاء المواكب % 2(@)(@@) % ولولاك لم يقحم جواد بمأزق % ولا فتكت في الأسد تلك الثعالب % 3(@)(@@) % بحيث التقت سمر القنا وصدورهم % وبيض المواضي والطلى والترائب % 4(@)(@@) % عناق يزيل الشوق عن مستقره % يرى واصلا وهو القطوع المجانب % 5(@)(@@) % بيوم أحم الجو حام وطيسه % كأن حصاه من تلظيه ذائب % 6(@)(@@) % صبغت به ما ابيض من فلق الضحى % % بكل بياض تجتويه الكواعب % 7(@)(@@) % وراجعت شيب الهندواني حلكة % وأبهجه ما سمته وهو شائب % 8(@)(@@) % على أنه صبغ يحدث سائلا % بما كان من تأثيره وهو غائب % 9(@)(@@) % وناب وإن لم يرض عزمك قاطعا % ومن أين كفؤ عنه يوجد نائب % 10(@)(@@) % فريت به غرب الزمان وغاية ال % % صوارم أن تفرى بهن الغوارب % PageV01P219 11(@)(@@) % وملمومة دبت وألسنة القنا % % لها حمة والمقربات العقارب % 12(@)(@@) % يعاطي بها الندمان كأسا من الردى % % بها نال ريا في المنية شارب % 13(@)(@@) % وعانق فيها مبغض لبغيضه % كما اعتنقت يوم اللقائ الحبائب % 14(@)(@@) % سماعهم فيها الصليل وخمرهم % دم القوم لاما استحلب الكرم حالب % 15(@)(@@) % سرت بك في ليل من النقع أليل % تعمى على من سار فيه المذاهب % 16(@)(@@) % فأطلعت فيه بالأسنة أنجما % لها من نواصي الدارعين ذوائب % 17(@)(@@) % عزائم خراج إذا ما تضايقت % مخارجه لا لاعبا وهو لاعب % 18(@)(@@) % وطعن لسمر السمهري محطم % على أنه للمجد بان وناصب % 19(@)(@@) % وضرب لبيض المشرفي مهدم % به ولأعداد المعادين حاصب % 20(@)(@@) % وأرعن موار الحواشي لأرضه % بعثيره من ناظر الجو حاجب % PageV01P220 21(@)(@@) % له من سطا فخر الملوك مؤيد % يطاعن عن أقرانه ويضارب % 22(@)(@@) % فتى هذبت فيه التجارب نفسه % فكيف بها إذ هذبتها التجارب % 23(@)(@@) % يسد مسد الألف بأسا ونجدة % إذا رد ضرب الألف في الألف حاسب % 24(@)(@@) % ودبر أمر الملك قبل بلوغه % وما نزعت عنه السخاب الربائب % 25(@)(@@) % وتلك لأبناء المسيب شيمة % يسود وليد مثلما ساد شائب % 26(@)(@@) % أناس أساءت حكمها في لهاهم 
ms76	 % أكفهم إذ أحسنوا والمواهب % 27(@)(@@) % وسدوا بتسديد الطعان من العلى % % ثغورا تولت كشفهن النوائب % 28(@)(@@) % فمن رأيه الواري عواليه أشرعت % ومن عزمه الماضي تسل القواضب % 29(@)(@@) % سواك يامن له الفضل صاحب % فحيث تراه ناقما فهو واهب % 30(@)(@@) % يصول ولو أن النجوم كتائب % ويعطي وكف الجدب للستر جاذب % PageV01P221 31(@)(@@) % وكنت إذا ما الشر صرح باسمه % ولاذت بأعناق الصياصي الذوائب % 32(@)(@@) % جعلت غرار المشرفي مصاحبا % ألا إنه نعم الرفيق المصاحب % 33(@)(@@) % وفي إذا خان الشقيق ودافع % إذا حاص عن دفع الملم المحارب % 34(@)(@@) % ولما أبى قوم سوى البغي مركبا % وللذل فيه والمذلة راكب % 35(@)(@@) % سددت عليهم كل باب وثغرة % يخالون منه النجح والنجح عازب % 36(@)(@@) % وأمهلتهم حتى لظنوك عاجزا % وما يستوي المغلوب والمتغالب % 37(@)(@@) % وقد تنفذ الأقدار حتى يرى امرؤ % من الصدق ظنا وعدها وهو كاذب % 38(@)(@@) % وعزمك ماض حين تنبو صوارم % ورأيك لما أظلم الجو ثاقب % 39(@)(@@) % ولكنهم من عامر في أرومة % لها منك عز لا يرام وجانب % 40(@)(@@) % فإن يهف فرع منهم فاغتفار ما % % جناه على معروف فضلك زاجب % PageV01P222 41(@)(@@) % بنوا العم والأرحام في الناس شجنة % رعايتها في الدين والعقل واجب % 42(@)(@@) % فكن بهم لا فيهم الخطب ضاربا % ففيهم قوى تعيا بهن الضرائب % 43(@)(@@) % ولما هجرت الشام حاشاك أن ترى % % له هاجرا أو عنه رأيك راغب % 44(@)(@@) % فلا حله من وحشة ما أستفزه % عن الأمن وأرتاب النزيل المصاقب % 46(@)(@@) % مددت عليه ظل عزك فاحتمى % % ولولاك يوما ما احتمى فيه جانب % 47(@)(@@) % وصيرته للأمن ربعا وقبلها % % غدا لذيول الخوف وهو مساحب % 48(@)(@@) % وأنقذت قوما فيه من كفة الردى % % وقد نشبت أظفارها والمخالب % 49(@)(@@) % بعزك لاذوا وهو أمنع موئل % وغيثك أموا وهو للبر ساكب % 50(@)(@@) % تركت لهم رأيا كساهم مذلة % ولذت برأي جانبته المعائب % 51(@)(@@) % أساؤوا وجاؤا لائذين بشيمة % لمذهبها في العفو تعفو المذاهب % PageV01P223 52(@)(@@) % فمال إلى جنب التجاوز عنهم % كريم قدير للرضى منه جانب % 53(@)(@@) % يمن وطول الإقتدار مساعد % ويحلم في وقت به الحلم عازب % 54(@)(@@) % تجاوز صفحا عن عقوبة جاهل 
ms77	 % يسيء وينسى ما تجر العواقب % 55(@)(@@) % وأدبهم بالعفو والعفو سوطه % لكل كريم فيه تلقى المآدب % PageV01P224 البحر : مجزوء الرجز 1(@)(@@) % يا غابرا وجد الندى % % قيدا فما أرجو قفوله % 2(@)(@@) % إن كنت مني في بلو % % غك ما أردت أدق حيله % 3(@)(@@) % لا كان رأيك ذا الصحي % % ح ولا مودتك العليله % 4(@)(@@) % فمتى أردت بصاحب % ضد النجاح فكن رسوله % 5(@)(@@) % ومتى بغيت ضلاله % % يوما فكن أيضا دليله % 6(@)(@@) % لصددت عما رمته % صد الذليل عن الحليله % 7(@)(@@) % وتطلبي منك المنا % % ب من الأمور المستحيلة % 8(@)(@@) % وأظنه مستنبطا % من قول دمنة أو كليله % 9(@)(@@) % هي قصة أعربت فيها % % عن سجيتك البخيله % 10(@)(@@) % ولقد نزلت بحضرة % من كل نائبة مزيله % PageV01P225 11(@)(@@) % يشتاقني إنعامها % % والمطل يمنعني سبيله % 12(@)(@@) % إن أغضبت ذا الدين ما % % طلة فقد أرضت وكيله % 13(@)(@@) % فكتبت تذكر ما أنا % % لت من مواهبها الجزيله % 14(@)(@@) % فأتى كتابك شاهدا % لك في الكتابة والفضيله % 15(@)(@@) % لولا عبارتك لقبي % % حة عن زيارتك الجميله % 16(@)(@@) % يممتها في حالة % ينسى الخليل بها خليله % 17(@)(@@) % وهربت من شظف المعا % % ش إلى التنعم والربيله % 18(@)(@@) % من حل في ذاك الجنا % % ب سلا عن الدمن المحيله % 19(@)(@@) % وكفاك فخرا موقف % تأبى نباهته خموله % 20(@)(@@) % ومديح من عشق الثنا % % ء فأدرك الراجيه سوله % PageV01P226 21(@)(@@) % بغرائب الشعر الذي % % حظ المسامع أن تطوله % 22(@)(@@) % فقر يحل أبو عبا % % دة دونها وتفوق قيله % 23(@)(@@) % أصبحت أنبذ بالعرا % % ء وأنت ترتع في الخميله % 24(@)(@@) % إن جادك الغيث الهطو % % ل فإنني راج سيوله % 25(@)(@@) % يفدي أبا الحسن الكرا % % م فلم أجد فيهم عديله % 26(@)(@@) % أنداهم في عام مس % غبة وأكرمهم قبيله % 27(@)(@@) % منن تخف إلى المحا % % مد وهي إن حملت ثقيله % 28(@)(@@) % وسحابة للطالبي % % ن سواي صادقة المخيله % 29(@)(@@) % ولو انها بالعدل تق % ضي كنت أقواهم وسيله % PageV01P227 البحر : خفيف تام 1(@)(@@) % يطمع الناس في البقاء وتأبى % % نوب تسلب النفوس اغتصابا % % 2(@)(@@) % ومتى ترعوي حوادث دهر % دأبها أن تفرق الأحبابا % % 3(@)(@@) % يذهب اللوم والعتاب هباء % في خطوب لا تعرف الإعتابا 
ms78	 % % 4(@)(@@) % اب ولو صافح % ت حديدا لذابا % % 5(@)(@@) % وإذا ما سطت فمن ذا يداجى % % من جميع الأنام أم من يحابا % % 6(@)(@@) % إن ريب المنون ألوى بملك % دا ولكن صرفه لن يهابا % % 7(@)(@@) % عم نصرا وصالحا ومنيعا % وشبيبا ولم يهب وثابا % % 8(@)(@@) % أين تلك الأملاك زادوا على الخلق % % ق وزانوا الأحساب والأنسابا % % 9(@)(@@) % إن دعاهم إلى الكريهة داع % جعلوا الطعن والضراب جوابا % % 10(@)(@@) % ولقوا الحرب دارعين من الصب % % ر دروعا ليست تحل العيابا % % PageV01P228 11(@)(@@) % نزلوا مكرهين عن ذروة الع % % ز وكان وا قدما له أربابا % % 12(@)(@@) % فكأن لم يصاقبوا أرض حرا % % ن ولا حل حيهم جلابا % % 13(@)(@@) % قصدتهم بوائق الدهر حتى % % أسكنتهم بعد القصور الترابا % % 14(@)(@@) % واستزادت أبا سلامة لما % % تم ملكا وقدرة وشبابا % % 15(@)(@@) % حادث عم عامرا بالرزابا % % فاستكانت له وخص كلابا % % 16(@)(@@) % % لو رماه غير الردى ما أصابا % % 17(@)(@@) % لم يغالب فضاء ذي العرش إذ وا % % فى وما زال للعدى غلابا % % 18(@)(@@) % لايخاف الأملاك مذ فارق المه % د وهل ترهب الأسود الذئابا % % 19(@)(@@) % من أناس توارثوا البأس والنخو % % ة واستحقبوا العلى أحقابا % % 20(@)(@@) % يكره الوعد والمطال فتنثا % % وحلوا منه الربى والهضابا % % PageV01P229 21(@)(@@) % لهف نفسي على المسافر لا ير % جو له طالب النوال إيابا % % 22(@)(@@) % أكرم العالمين نفسا وأخلا % % قا وأما ووالدا ونصابا % % 23(@)(@@) % كان في ذا الورى غريبا ووافى % % قدر لم يزده إلا اغترابا % % 24(@)(@@) % جاز حد الندى وآمن سربي % % فكفى أن أرتاد أو أرتابا % % 25(@)(@@) % عقلتني في ظله فعلات % تمنع الإنتجاع و الإظطرابا % % 26(@)(@@) % بين جود يسيره يطرد الفق % ر و قربى تعلم الأدابا % % 27(@)(@@) % وعطايا لما تعالمها العا % % لم لم ينكروا لبحر عبابا % % 28(@)(@@) % وكساني ملابسا ألبستني % % مذ توارى من الأسى جلبابا % % 29(@)(@@) % يا ابنة الأكرمين قدرك في النا % % س عظيم وإن عظمت مصابا % % 30(@)(@@) % ف سترد الوهاب ما كان أعطا % % ك ومن ذا ينازع الوهابا % % PageV01P230 31(@)(@@) % لم تسودي ذا الخلق إلا بفضل % فقت فيه الأشكال و الأضرابا % % 32(@)(@@) % فدعي رأي أمة لست منهم % وافعلي فعل من 
ms79	 يخاف الحسابا % % 33(@)(@@) % وتأسي برأي داود في الفت % نة إذ خر راكعا وأنابا % % 34(@)(@@) % لا تعاصي مولاك فيما قضاه % وذري الحزن إن أردت الثوابا % % 35(@)(@@) % قدر الله لا يدافع إن حم % فصبرا لحكمه واحتسابا % % 36(@)(@@) % أي عذر وقد أحطت بصرف الد % ل يداه بالعكرمات اقتضابا % % 37(@)(@@) % وحقيق بالصبر من لزم المص % حف دينا وواصل المحرابا % % 38(@)(@@) % ولعذر تأخرت هذه الخد % مة لا أنني عدمت الصوابا % % 39(@)(@@) % نابت العين بالبكاء وأفحم % % ت فما أحسن اللسان المنابا % % 40(@)(@@) % زال لبي في علة جمعت لي % % فقد تاج الملوك والأوصابا % % PageV01P231 41(@)(@@) % ليتني لم أفق فقد جاء من فق % % ديه ما سهل الحمام فطابا % % 42(@)(@@) % لا يوازي معشار ما كان يولي % % قطعي العمر حسرة واكتئابا % % 43(@)(@@) % سرني حاضرا و أدنى و أغنى % % فعدمت السرور لما غابا % % 44(@)(@@) % وبرغمي أن أجعل المدح تأيي % % نا وأدعو من لو وعى لأجابا % % 45(@)(@@) % بمقال لا أستزيد به زل % % فى ولا أبتغي عليه ثوابا % % 46(@)(@@) % سائر لا يزال يشكر نعما % % ه كما تشكر الرياض السحابا % % PageV01P232 البحر : وافر تام 1(@)(@@) % أما وهوى عصيت له العواذل % لقد أسمعت نصحك غير قابل % 2(@)(@@) % وما سمعي إلى العذال مصغ % ولا قلبي عن الأحباب ذاهل % 3(@)(@@) % ولو أنصفت لم تنكر وقوفي % % على طلل بذات الضال ماثل % 4(@)(@@) % أأجحد ربع ريى وهو عاف % زمانا مر فيه وهو آهل % 5(@)(@@) % وما أعطى الصبابة ما استحقت % عليه ولا قضى حق المنازل % 6(@)(@@) % ملاحظها بعين غير عبرى % % وزائرها بجسم غير ناحل % 7(@)(@@) % يميلني إلى وطني هنات % جرت ما بين علمية وداعل % 8(@)(@@) % وأذكر دائما ثمرات عيش % جبين بدير قانون وآبل % 9(@)(@@) % تهيج بلابلي نغم الأغاني % % مجاوبة لأصوات البلابل % 10(@)(@@) % ليالي لي إلى ما أشتهيه % تلطف وارش وهجوم واغل % PageV01P233 11(@)(@@) % ومحموداتها أتباع أمري % % ومذموماتها عني غوافل % 12(@)(@@) % وكم قطع الظلام بغير وعد % غزال دأبه قطع الحبائل % 13(@)(@@) % براح بات يمزجها بريق % كفاها المزج بالعذب السلاسل % 14(@)(@@) % وأشربها على ظمأ فأروى % % كرمح الخط يروى وهو ذابل % 15(@)(@@) % ولما راحت الأظعان باحت 
ms80	 % بما نخفي مدامعنا الهوامل % 16(@)(@@) % وقفنا والإشارة ثم رسل % معبرة وأدمعنا الرسائل % 17(@)(@@) % فعقرا للركاب غداة ولت % بنزال الحمى تطوي المراحل % 18(@)(@@) % فقد حملت جمالا واعتدالا % تجنهما البراقع والغلائل % 19(@)(@@) % لمفغمة بيوت الحي طيبا % ومفعمة الأساور والخلاخل % 20(@)(@@) % ومفردة وما وضعت حبيبا % كما انفردت عن السرب الخواذل % PageV01P234 21(@)(@@) % تفرد بالتعتب والتجني % % وتذهب بالمحاسن والشمائل % 22(@)(@@) % تروق العين راضية وغضبى % % وتصبي القلب حالية وعاطل % 23(@)(@@) % مذيبة مهجتي طال اقتضائي % % عداتك والغريم بها مماطل % 24(@)(@@) % أمنى بانعطافك وهو غال % وأمنى بانحرافك وهو غائل % 25(@)(@@) % لقد أنفقت في الصبوات عمري % % وكنت كبائع حقا بباطل % 26(@)(@@) % إلى أن ثاب رأي ضل حينا % فعدت إلى الفروض من النوافل % 27(@)(@@) % وزارت آل مرداس ركابي % % فأغنتني البحار عن الجداول % 28(@)(@@) % وكنت أذم آمالا نحت بي % % ممالك لم أفز فيها بطائل % 29(@)(@@) % بحيث أبو سلامة لم يجدها % % ونصر بعده وأبو الفضائل % 30(@)(@@) % ملوك أمنوا خيلي ورجلي % % مكابدة الهواجر والهواجل % PageV01P235 31(@)(@@) % وأمضوا في الذي يحوون حكمي % % ففزت بعاجل منه وآجل % 32(@)(@@) % مكارم مبتغيها من سواهم % كباغي الرسل من أخلاف حائل % 33(@)(@@) % زروا كرما على من غاصروه % وإقداما وأزروا ب لأوائل % % 34(@)(@@) % وثالثهم وإن عزوا وجادوا % % أمر عداوة وأعم نائل % 35(@)(@@) % أظلته نوائب لم تنبهم % فقارعها برأي غير فائل % 36(@)(@@) % وفل شبا المواضي بالمواضي % % ولاقى بالزرافات الجحافل % 37(@)(@@) % مواقف تشخص الأبصار منها % % وتعيا عن إبانتها المقاول % 38(@)(@@) % وما خرست بها الأبطال حتى % % تكلمت الصوارم والصواهل % 39(@)(@@) % حروب لم تكن لبني بغيض % ولا عزيت إلى أبناء وائل % 40(@)(@@) % وفرسان تحن إلى رداها % % حنين الهائمات إلى المناهل % PageV01P236 41(@)(@@) % وشردها إباء سابقي % تعز به العقائل والمعاقل % 42(@)(@@) % ثناها عن مطامعها همام % له بالنصر رب العرش كافل % 43(@)(@@) % وما غمد الظبى حتى أزالت % جبالا لا تحركها الزلازل % 44(@)(@@) % وكان يزيرها في كل عام % عرابا شزبا قب الأياطل % 45(@)(@@) % لها نظر الأجادل إذ تخلى % % وعند الأرض أجنحة الأجادل % 46(@)(@@) % إذا نزع الوجيف اللحم عنها % % كساها ما تثير من القساطل % 47(@)(@@) % وإن عضت شكائمها وطاحت % أتاحت 