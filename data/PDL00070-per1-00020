ms8	 درهای جنت برو(@)(@@) 57 دلت مست آزاست هشیار باش %~% به خواب غرور است بیدار باش(@)(@@) 58 که چون بگذرد نیز این هفته عمر %~% ز خواب اندر آئی بود رفته عمر(@)(@@) 59 برو سینه خاک را باز کن %~% ببین در دلش رازهای کهن(@)(@@) 60 در او نازکان گل اندام بین %~% همه خشت بالین و بستر زمین(@)(@@) 61 بر آنی که ایشان ازین خاکدان %~% برفتند و تو زنده‌ای جاودان(@)(@@) 62 همه در پی یکدگر می‌رویم %~% نماند کسی سر به سر می‌رویم(@)(@@) 63 دلا برگ این راه نیکو بساز %~% که راهی است باریک و دور و دراز(@)(@@) 64 شب زندگانی به آخر کشید %~% شبت روز شد وقت رفتن رسید(@)(@@) 65 یکایک برفتند یاران تو %~% رفیقان و اندوه گساران تو(@)(@@) 66 رسیدند هر یک به ماوای خویش %~% تو مسکین گرانباری و راه پیش(@)(@@) 67 در این منزل آخر چرا خفته‌ای %~% رباطی است ویران کجا خفته‌ای(@)(@@) 68 بسی کاروان شد درین ره روان %~% نیامد کسی باز از این کاروان(@)(@@) 69 که ز آن رفتگان باز گوید خبر %~% که چون است احوالشان در سفر(@)(@@) 70 بسا کاروانا کزین پل گذشت %~% مگر نیست ز آنسو ره بازگشت(@)(@@) 71 شبی بنده را شاه پیروز بخت %~% طلب کرد و بنشاند در پیش تخت(@)(@@) 72 در آمد ز راه سخن گستری %~% سخن راند از نظم در دری(@)(@@) 73 که از در معنی چه پرورده‌ای %~% ز درای خاطر چه آورده‌ای(@)(@@) 74 بیاور ز نو گوهری پر ثمن %~% که داند خرد لایق گوش من(@)(@@) 75 در گنج معنی دلم باز کرد %~% سخن را ز هر گونه‌ای ساز کرد(@)(@@) 76 گهرهای من شاه در گوش کرد %~% شکرهای نغزم همه نوش کرد(@)(@@) 77 ز من نامه‌ای خواست اندر فراق %~% که آن نامه باشد سراسر فراق(@)(@@) 78 برین طرز نظمی روان از نوی %~% بیارای در کسوت مثنوی(@)(@@) 79 طلب کردم آن را به هر کشوری %~% ز هر قصه خوانی و هر دفتری(@)(@@) 80 پس از 
ms9	 روزگار کهن روزگار %~% در آموختم داستان دو یار(@)(@@) 81 که با یکدیگر هر دو را مدتی %~% دم صحبتی بود و خوش صحبتی(@)(@@) 82 یکی پادشاه جهان جلال %~% یکی آفتاب سپهر جمال(@)(@@) 83 یکی داور کشور آب و گل %~% یکی حاکم خطه جان و دل(@)(@@) 84 یکی بر فلک سوده پر کلاه %~% یکی تکیه گه جسته زلفش ز ماه(@)(@@) 85 به ملک جلال آن یکی شاه بود %~% به اوج جمال این یکی ماه بود(@)(@@) 86 چنان بود با ماه شه را نظر %~% که از جان خود داشتش دوست‌تر(@)(@@) 87 به آخر میانشان جدائی فتاد %~% که کس در بلای جدائی مباد(@)(@@) 88 به فرمان دارای فرمان روان %~% نهادم من آغاز این داستان(@)(@@) 89 که تا ماند از من بسی روزگار %~% به گیتی از این داستان یادگار(@)(@@) 90 همی خواهم از داور کردگار %~% که چندان امانم دهد روزگار(@)(@@) 91 که ده نامه زین نامه خسروی %~% دهم جلوه در کسوت مثنوی(@)(@@) 92 سخن را بر آرم به خورشید نام %~% به نام شهنشاه سازم تمام(@)(@@) 93 کنون از زبان من ای هوشیار %~% بیا گوش کن قصه آن دو یار PageV01P04(@)(@@) 1 شنیدم که شاهی به ایران زمین %~% سزاوار دیهیم و تاج و نگین(@)(@@) 2 زر افشان چو خورشید در گاه بزم %~% سر افشان چو شمشیر درگاه رزم(@)(@@) 3 ز آب کفش بحر گریان شده %~% ز تاب تفش ببر بریان شده(@)(@@) 4 اگر با فلک در کمر دست کین %~% زدی آسمان را زدی بر زمین(@)(@@) 5 به رمح از فلک عقده را می‌گشود %~% ز چوگان او گوی مه می‌ربود(@)(@@) 6 چو دستش کمان را بیاراستی %~% ز هازه ز هر گوشه برخاستی(@)(@@) 7 چو بر گوش مرکب نهادی قدم %~% زدی خامه را پای کردی قلم(@)(@@) 8 زهی زور دست شهنشاه زه %~% که بست از سر دست بر چرخ زه(@)(@@) 9 همه رادی و مردی و بخردی %~% ز سر تا به پا فره ایزدی(@)(@@) 10 قدش در لطافت که 
ms10	 جانی است پاک %~% فرو برده آب روان را به خاک(@)(@@) 11 اگر مانی آن روی دیدی یقین %~% به هم برزدی صورت نقش چین(@)(@@) 12 خرامان قدش با رخ ماهتاب %~% چو سروی که بار آورد آفتاب(@)(@@) 13 چو خورشید ماهیش منظور بود %~% ز سر تا قدم پایه نور بود(@)(@@) 14 فرشته نهادی پری پیکری %~% لطیفی ظریفی هنر پروری(@)(@@) 15 ز سر تا به پا و ز پا تا به سر %~% همه جان و دل بود و هوش و هنر(@)(@@) 16 دو گنجش نهان در دو کنج دهن %~% نبودش در آن کنج گنج سخن(@)(@@) 17 ز شور لب لعل شیرین وی %~% به تلخی همی داد جان جام می(@)(@@) 18 به هر گوشه نرگسش دلربا %~% در آن گوشه‌ها جاودان کرده جا(@)(@@) 19 جوانی به قد راست چون نیشکر %~% تراشیده اندام و بسته کمر(@)(@@) 20 لبانش سراسر ز قند و نبات %~% دهانش لبالب ز آب حیات(@)(@@) 21 از او پر هنر‌تر جوانی نبود %~% به حسن رخش دلستانی نبود(@)(@@) 22 ز معشوق عاشق به خوبی بسی %~% فرون بود و دانست این هر کسی(@)(@@) 23 خرد وزنشان کرد با یکدگر %~% به شیرینی این بود از آن چرب‌تر(@)(@@) 24 در آیینه می‌دید رخسار خویش %~% که او بود صد ره به از یار خویش(@)(@@) 25 ولی عشق را با چنین‌ها چه کار %~% هوی پادشاهی‌ است بس کامگار(@)(@@) 26 گهی خیمه را بر سرابی زند %~% گهی بر کند بر سر آبی زند(@)(@@) 27 گهش راه روم است و گه ز نگبار %~% گهش جای هند است و گه قندهار(@)(@@) 28 شهنشاه را مونس و یار بود %~% شب و روز دلجوی و دلدار بود(@)(@@) 29 مه و سالشان چون مه و آفتاب %~% نظر بود با همه به روز شباب(@)(@@) 30 کشیدی گه و بیگه از جام کی %~% به شادی روی دلارام می(@)(@@) 31 چو چشم و لب خویشتن کامیاب %~% گهی در شکار و گهی در شراب(@)(@@) 32 چو ابروی خود گاه 
