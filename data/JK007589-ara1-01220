ms1201	 ليله إلى سكن % 2(@)(@@) % لا تنفسا عبرة أجود بها % % فلست أبكي بها على الدمن % % 3(@)(@@) % لم يخلق الدمع لامريء عبثا % % الله أدرى بلوعة الحزن % % 4(@)(@@) % أساء بي ما أتيت من حسن % إلي فيما مضى من الزمن % % 5(@)(@@) % منعتني بعدك العزاء به % % يا ليت ما كان منك لم يكن % PageV01P4549 البحر : - 1(@)(@@) % مراد عينيك منه بين شمس ضحى % % وناعم من غصون البان ريان % 2(@)(@@) % خفت أعاليه والتفت أسافله % كأنما صاغ نصفيه لبانان % PageV01P4550 البحر : - 1(@)(@@) % يا واحد الناس في الآلاء والمنن % والمستجار به من نوبة الزمن % 2(@)(@@) % وابن الذين بنوا أساس دولتهم % % على النبوة والقرآن والسنن % % 3(@)(@@) % أشد ما بي من شكو ومن ألم % % فقدي جنى مقلتي من وجهك الحسن % % 4(@)(@@) % وفوت ما كنت تلقيه إلى أذني % % من فضل علم يجلى عنه باللسن % % 5(@)(@@) % ومن بدائع ظرف ذات أوشية % تدق عن أن تراها أعين الفطن % % 6(@)(@@) % كتبت طولا بأبيات وجدت بها % % خفا وقد كنت في ثقل من المحن % % 7(@)(@@) % وكيف أشكر لطفا ساق عافية % هيهات ليس لذاك اللطف من ثمن % % 8(@)(@@) % وقبل ذلك بر منك آنسني % % حتى سلوت عن الخلان والوطن % % 9(@)(@@) % أعجب ببر تعلمت العقوق به % % فما أحن إلى إلف ولا سكن % 10(@)(@@) % يا زينة الدين والدنيا إذا احتفلا % % وأظهرا ما أعداه من الزين % PageV01P4551 11(@)(@@) % يا من يرى حاسدوه أن تركهم % حسن الثناء عليه أعظم الغبن % % 12(@)(@@) % نعماك عندى في مثواه معتقد % والشكر عندك في مثواه مرتهن % % 13(@)(@@) % أجريت حبيك بالذي اصطنعت % يداك عندي مجرى الروح في البدن % % 14(@)(@@) % أطال عمرك في النعماء واهبها % % مقرونة لك والعلياء في قرن % % 15(@)(@@) % مسلم النفس والأحباب من محن % تكدر العيش أحيانا ومن فتن % % PageV01P4552 البحر : - 1(@)(@@) % رقعة من معاتب لك ظلت % ولها في ذراك مثوى مهان % 2(@)(@@) % جالت الريح في الزوايا بها يو % % ما كما جال في الرباط الحصان % % 3(@)(@@) % غير مستورة عن الناس لكن % % مجتلاة وإنها لحصان % % 4(@)(@@) % ورأيت الأكف قد لعبت في % % ها فأمست وظهرها ميدان % 5(@)(@@) % سطر العابثون فيها أساطي % % ر عفت متنها 
ms1202	 فما يستبان % % 6(@)(@@) % خط ولدانكم أفانين فيها % % أو رجال كأنهم ولدان % % 7(@)(@@) % حين لم يحلفوا بحرمة ما في % % ها وفي بطنها معان حسان % 8(@)(@@) % كحليف العمى تغوط في الإي % % وان جهلا بأنه الإيوان % % 9(@)(@@) % وكثيرا يمنى بأمثالها البس % % تان مالم يحصن البستان % 10(@)(@@) % يخرأ الخارئون فيه وفيه % % طيبات الثمار والريحان % % PageV01P4553 11(@)(@@) % وقبيح يجوز كل قبيح % % رقعة من معاتب لا تصان % % 12(@)(@@) % شد ما هان عندك الخطب فيها % % لا يكن للتي أهنت الهوان % % 13(@)(@@) % توبة بعد حوبة من عتابي % % ك فهل أنت قابل يا فلان % % PageV01P4554 البحر : - 1(@)(@@) % عيدان أضحى ومهرجان % ما ضم مثليهما أوان % 2(@)(@@) % اعيد نسك وعيد لهو % تجاورا أبدع الزمان % % 3(@)(@@) % ألف شكليهما إمام % أفعاله فيهما حسان % % 4(@)(@@) % فالله يبقي الإمام حتى % % يرى لمثليهما اقتران % % 5(@)(@@) % معتمد لم يزل عميدا % ينطق عن فضله البيان % % 6(@)(@@) % في كل أرض وكل قوم % % يثني بآلائه لسان % 7(@)(@@) % أشرق للناس منه بدر % لم يخل من نوره مكان % % 8(@)(@@) % ما زانه الملك إذ حواه % % بل كل شيء به يزان % % 9(@)(@@) % جرى ففات الملوك سبقا % % فليس قدامه عنان % % 10(@)(@@) % ولم يزل للإمام سعي % بمثله تحرز الرهان % % PageV01P4555 11(@)(@@) % نالت يداه ذرى معال % يعجز عن نيلها العيان % % 12(@)(@@) % مكرم عرضه معز % والمال من دونه مهان % % 13(@)(@@) % ليس لأمواله لديه % % حق ولا حرمة تصان % % 14(@)(@@) % لكل عين رأته يوما % % من ريب أزمانها الأمان % % 15(@)(@@) % بذاك في وجهه ضمين % يقبل من مثله الضمان % % 16(@)(@@) % حياته ما أقام فينا % % فضل من الله وامتنان % % 17(@)(@@) % نهارنا الدهر منه طلق % وليلنا منه إضحيان % % 18(@)(@@) % فلا يزل في نعيم عيش % مزاجه الخفض والليان % % 19(@)(@@) % حتى يرى فيه كل سؤل % ومنية عنده بنان % % PageV01P4556 البحر : - 1(@)(@@) % إما تريني قالبا مجني % % مرددا سيفي على مسني % % 2(@)(@@) % لصاحب السوء بعيد ضني % % به ومني صافيا من مني % % 3(@)(@@) % كم مدخل كذبت عنه ظني % % وقلت إني ظالم وإني % % 4(@)(@@) % آخذ لوميه عن التجني % % بلوته فصدق التظني % % 5(@)(@@) % في أمره وكذب التمني % % فما قرعت من ندام سني % % 6(@)(@@) % ولا وجدت 
ms1203	 الظلم كان مني % % ولن يغيب غائب عن جني % % PageV01P4557 البحر : - 1(@)(@@) % جرى الأضحى رسيل المهرجان % كأنهما معا فرسا رهان % 2(@)(@@) % فجاءا ليس بينهما انتظار % جوادا حلبة متتابعان % % 3(@)(@@) % ولم يتتابع العيدان إلا % تنافس رؤية الملك الهجان % % 4(@)(@@) % عبيد الله قرم بني زريق % وما أدراك ما يتنافسان % % 5(@)(@@) % سلوا الكبراء عن عيدين شتى % % متى كانا كذا يتجاوران % % 6(@)(@@) % أعيد النسك جاور عيد لهو % لأمر ألف المتنافران % 7(@)(@@) % ببر أميرنا في كل عيد % تواصل منهما المتقاطعان % % 8(@)(@@) % فلا عدماه حتى يستدير % % فيقترنا كهذا الاقتران % % 9(@)(@@) % غدا معروفه نسبا قريبا % يؤلف بين أشتات الزمان % % 10(@)(@@) % فقولا للأمير وقته نفسي % % صروف الحادثات وإن جفاني % % PageV01P4558 11(@)(@@) % تفيأنا السعادة إذ نظرنا % % إلى الأضحى أمام المهرجان % % 12(@)(@@) % تقدم في المقدم منك نسك % وبر بالأباعد والأداني % % 13(@)(@@) % وأعقب في أخيرهما نعيم % ولهو منك بالنعم الحسان % % 14(@)(@@) % فدلانا على عمل ذكي % % بعقباه نعيمك في الجنان % % 15(@)(@@) % وذاك إذا قطعت مدى الليالي % % ونلت وحزت غايات الأماني % % 16(@)(@@) % حليف سلامة وصحاح جسم % % وشرخ من شباب غير فاني % % 17(@)(@@) % تبشرني الظنون بصوب غيث % مغيث منك في هذا الأوان % % 18(@)(@@) % وقد حان الولي فلا تجزني % % كوسمي عداني ما عداني % % 19(@)(@@) % أتحرمني وقد أعطيت كلا % عطا مفضل خضل البنان % % 20(@)(@@) % عطايا لا يجمجمها كفور % % ولا للشاكرين بها يدان % % PageV01P4559 21(@)(@@) % عطايا بين بشر واعتذار % وليست بين عبس وامتنان % % PageV01P4560 البحر : - 1(@)(@@) % أيها السيد الذي وهنت % أنصار مواله ولم يهن % % 2(@)(@@) % فأصبحت في يد الضعيف وذي ال % % قوة والباقلي واللسن % % 3(@)(@@) % غيري على أنني مؤملك الأ % % قدم سائل بذاك وامتحن % % 4(@)(@@) % مادح عشرين حجة كملا % محرومها منك غير مضطغن % % 5(@)(@@) % فضلك أو عدلك الذي ائتمن ال % % له علينا أجل مؤتمن % % 6(@)(@@) % إن كنت في الشعر ناقدا فطينا % فليعطني الحق حصة الفطن % % 7(@)(@@) % وإن أكن فيه ساقطا زمنا % فليعطني الحق حصة الزمن % % 8(@)(@@) % سم بي ديوانك الذي عدت % % جدواه بين الصحيح والضمن % % 9(@)(@@) % كثر بشخصي من اصطنعت % من الناس وإن لم أزنك لم أشن % % 10(@)(@@) % ما حق من لان 
ms1204	 صدره لك بال % % ود لقاء لجانب خشن % % PageV01P4561 البحر : - 1(@)(@@) % أرى الشعراء حظوا عندكم % جميعا عييهم واللسن % 2(@)(@@) % سواي فإني أراني امرأ % هزلت وكلهم قد سمن % % 3(@)(@@) % فإن كنت منهم أخا فطنة % فلا تبخسوني حق الفطن % % 4(@)(@@) % وإن كنت من بعض زمناهم % فلا تبخسوني حق الزمن % 5(@)(@@) % سموا بي ديوان زمناكم % % وإن كنت في مدحكم لم أهن % % 6(@)(@@) % إلى الله شكواي من غبنكم % ولست بأول حر غبن % % 7(@)(@@) % إذا جئتكم زمنا قلتم % مبين الزمانة والممتحن % % 8(@)(@@) % وإن جئتكم زمنا قلتم % % أتاكم أبو الليث صولر تكن % 9(@)(@@) % يناقض حكمكم نفسه % ويقرن ما ليس بالمقترن % % 10(@)(@@) % فلا أنا رزق أصحائكم % ولا رزق زمناكم أتزن % % PageV01P4562 11(@)(@@) % سأرفع عدوى إلى خالقي % % فلا يأمن الله من قد أمن % % 12(@)(@@) % أحاطت بكم حجتي دررا % ومن ذا يبين إذا لم أبن % % PageV01P4563 البحر : - 1(@)(@@) % متى استحسنت مطلك يا بن يحيى % % فأنت لدي في حد الغواني % % 2(@)(@@) % لما أحسنت في قولي وعقلي % % متى استحسنت منك سوى الحسان % % PageV01P4564 البحر : - 1(@)(@@) % حصلنا من فتوحك يا سليمى % % على أن تسلمي وتهنئينا % % 2(@)(@@) % إذا حمي الوطيس نجوت ركضا % وغادرت الكماة مجدلينا % % 3(@)(@@) % فلا وألت هنالك نفس سوء % عليها يا سليم تحاذرينا % % 4(@)(@@) % هي النفس التي إما أصيبت % % فأهون ما تصيب المسلمينا % % PageV01P4565 البحر : - 1(@)(@@) % إن إسماعيل قرد مجرم % إن سقاني دمه الله شفاني % % 2(@)(@@) % لو رأى آدم جهلي لمحة % يوم شاورت اليهودي نفاني % % 3(@)(@@) % سلط الله عليه طبه % وكفاه طبه لا بل كفاني % % 4(@)(@@) % لو يداوي نفسه من علة % لتداعى بالتلاشي والتفاني % % PageV01P4566 البحر : - 1(@)(@@) % أقول إذ هتف الداعي بمصرعه % لبيك لبيك من داع بتبيين % 2(@)(@@) % نعيت من جمدت غزر العيون له % % فلم تفض عبرة من عين محزون % % 3(@)(@@) % ومن يقل له الداعي بمغفرة % وينشد الناس فيه بيت يقطين % % 4(@)(@@) % فإن تصبك من الأيام جائحة % لم يبك منك على دنيا ولا دين % % 5(@)(@@) % يا منكرا ونكيرا أوجعاه فقد % خلوتما بقليل الخير ملعون % % 6(@)(@@) % بعدا وسحقا له من هالك نطف % مشوه الخلق من نسل الشياطين % % PageV01P4567 البحر : - 1 
ms1205	(@)(@@) % يا باطلا وهمتنيه مخائله % % بلا دليل ولا تثبيت برهان % % 2(@)(@@) % قل لابن بوران إن كان ابن بوران % وما إخال ابن بوران بإنسان % % 3(@)(@@) % ما أنت إلا خيال طاف طائفه % ولا هجائيك إلا هجر وسنان % % 4(@)(@@) % قد كنت أحسبه شيئا فأهجوه % حتى أزال ظنوني فيه حسباني % % PageV01P4568 البحر : - 1(@)(@@) % ظهور الأمور خلاف البطون % وغيب الصدور خفي الكمون % 2(@)(@@) % وكم صاحب غرني حبله % % فأعصمت منه بغير الأمون % % 3(@)(@@) % تناسيت عهدي أبا جعفر % كأني من سالفات القرون % % 4(@)(@@) % لئن كان غيبك لي هكذا % % فلا زلت مني بدار شطون % % 5(@)(@@) % أظن القراطيس في مصركم % تخونها ريب دهر خئون % % 6(@)(@@) % فلو أنها صفحات الخدود % % يكتب فيها بماء العيون % % 7(@)(@@) % لما أعوزتك ولكن جفوت % فألغيت شأني خلال الشؤون % % 8(@)(@@) % تراه إذا أنت فكرت في % % ه كالعبء تحمله بالجفون % % 9(@)(@@) % تهاب دواتك حتى كأن % ن حوض دواتك حوض المنون % % 10(@)(@@) % وظل كتابي ملقى لديك % % بدار اطراح ومثواة هون % PageV01P4569 11(@)(@@) % إذا ما دخلت فلاحظته % نظرت إليه بطرف شفون % % 12(@)(@@) % أبا جعفر عد عني وعن % ك ودا تزينه بالعهون % % 13(@)(@@) % ولا تخدعني ولا يخدعن % ك لفظ تزينه بالرقون % % 14(@)(@@) % فإني امرؤ قل من لا أرى % % له شجنا فيرى من شجوني % % 15(@)(@@) % ولست أكد أخي بالعتا % % ب عند تماديه كد الحرون % % 16(@)(@@) % ولا أشتري ود شكس به % % ولا يشتري الناس ودي بدون % % 17(@)(@@) % وما كان مثلك في شأنه % ليحجب عن سر نفسي المصون % % 18(@)(@@) % فلا تغضبن أبا جعفر % فإني صدقتك عين اليقين % % PageV01P4570 البحر : - 1(@)(@@) % أيها المتحفي بحول وعور % أين كانت عنك الوجوه الحسان % 2(@)(@@) % قد لعمري ركبت أمرا مهينا % ساءنا فيك أيها الخلصان % % 3(@)(@@) % فتحك المهرجان بالحول والعو % % ر أرانا ما أعقب المهرجان % % 4(@)(@@) % كان من ذاك فقدك ابنتك الحر % رة مصبوغة بها الأكفان % % 5(@)(@@) % وتجافي مؤمل لي خليل % لج منه الجفاء والهجران % % 6(@)(@@) % وعزيز علي تقريع خل % لا يدانيه عندي الخلان % % 7(@)(@@) % غير أني رأيت إذ كاره الحز % م وإشعاره شعارا يصان % % 8(@)(@@) % لا تهاون بطيرة أيها النظ % ظار واعلم 
ms1206	 بأنها عنوان % % 9(@)(@@) % قف إذا طيرة تلقتك وانظر % واستمع ثم ما يقول الزمان % % 10(@)(@@) % فلما غاب من أمورك عنوا % % ن مبين وللزمان لسان % % PageV01P4571 11(@)(@@) % لا يقدك الهوى إلى نصرة الأخ % % بار حتى تهين مالا يهان % % 12(@)(@@) % إن عقبى الهوى هوي وعقبى % % طول تلك التهاونات هوان % % 13(@)(@@) % لا تصدق عن النبيين إلا % بحديث يلوح فيه البيان % 14(@)(@@) % قد أتى عن نبينا حبه الفأ % % ل مضيئا بذلك البرهانص ومحب الحبيب لا شك فيه % % 15(@)(@@) % كاره للكريه يا إنسان % % فدع الهزل والتضاحك بالط % 16(@)(@@) % رة فالنصح مثمن مجان % % أترى من يرى البشير بشيرا % 17(@)(@@) % يمتري في النذير يا وسنان % % خبر الله أن مشأمة كا % % 18(@)(@@) % نت لقوم وخبر القرآن % % أفزور الحديث تقبل أم ما % % 19(@)(@@) % قاله ذو الجلال والفرقان % % لا تكره مواعظي لكريه ال % 20(@)(@@) % حق فيها فإنها بستان % % فيه دفلى وفيه شوك وفيه % % PageV01P4572 21(@)(@@) % من ثمار كرائم ألوان % % ن % PageV01P4573 البحر : - 1(@)(@@) % ليس مستحسنا لك المطل والخل % ف سوى من يراك مثل الغواني % % 2(@)(@@) % يقبح الصدق بالغواني لأمر % % هن فيه إذا صدقن زواني % % PageV01P4574 البحر : - 1(@)(@@) % ألا أيها الموسوم باسم وكنية % وجدناهما اشتقا من الحمد والحسن % 2(@)(@@) % أتبخل بالقرطاس والخط عن أخ % وكفاك أندى بالعطايا من المزن % % 3(@)(@@) % لعمري لقد قوى جفاؤك ظنتي % % وأوهن تأميلي وما كان ذا وهن % 4(@)(@@) % ولم لا وقد ألغيت شأني مخسسا % بذلك قدري مستخفا به وزني % % 5(@)(@@) % أبا حسن يا إلف نفسي وأنسها % % ويا سندي في النائبات ويا ركني % % 6(@)(@@) % أمثلك بعد الحلم والعلم والنهى % % يبر ويجفو للإقامة والظعن % % 7(@)(@@) % ويأتم بالإيام وهي ذميمة % فينسى الذي تقصي ويرعى الذي تدني % % 8(@)(@@) % إذا كنت خلصاني من الناس كلهم % وأعرضت عن ذكراي إعراض مستغني % % 9(@)(@@) % فياليت شعري ما تركت لمبغض % يصرح بالبغضاء لي ثم لا يكني % % 10(@)(@@) % ألا أيها الحكام أعدو مظلما % على بطل في ظلمة غير ذي قرن % % PageV01P4575 11(@)(@@) % أيعرض عني باخلا بكتابه % أخ لي قلبي عنده غلق الرهن % % 12(@)(@@) % لك الخير كم من لوعة قد جنيتها % % علي وما تدري 
ms1207	 هناك ما تجنى % % 13(@)(@@) % جفوت فجافيت الجفون عن الكرى % % وعرضت رأيي للزراية والطعن % % 14(@)(@@) % ومن يتخير صاحبا غير عاطف % عليه فمنسوب إلى الجهل والأفن % 15(@)(@@) % وكم قائل قد قال لي متمثلا % ليوهن مني أو يشد قوى متني % % 16(@)(@@) % ألا إن من يدعو مودة معرض % ويعني بصدق الوجد من غير ما يعني % % 17(@)(@@) % لكالمرتجي أن يقطع البحر فارسا % أو المبتغي أن يقطع البر في سفن % % 18(@)(@@) % أو المبتني بنيانه فوق هائل % من الرمل لا ينفك يهوي بما يبني % % 19(@)(@@) % وقلبت أمري كي أرى لي إساءة % فلم أرها في الظهر منه ولا البطن % 20(@)(@@) % سألتك بالبيت الممسح ركنه % وبالمشهد المشهود من منحر البدن % % PageV01P4576 21(@)(@@) % أرقى إليك الكاشحون نميمة % % طويت لها كشحيك مني علي ضغن % % 22(@)(@@) % فيا عجبا إن كان ذاك وقد طوت % % عجائب هذا الدهر قرنا إلى قرن % % 23(@)(@@) % عهدتك لا تعتد بالعين شاهدا % علي فلم أصبحت تعتد بالأذن % % 24(@)(@@) % أم استفسدت ذاك الوفاء ملالة % فأصبحت لا يثني عليك به المثني % % 25(@)(@@) % حبست أخا في سجن هم وما جنى % % فأطلقه بالإعتاب من ذلك السجن % % 26(@)(@@) % ولا تكن المبذول للوم سمعه % % وقرطاسه بين الصيانة والحزن % % 27(@)(@@) % أجرني من حزني لرفضك حرمتي % % فحزني لشحط الدار ناهيك من حزن % % 28(@)(@@) % كأني وقد فارقت دارا وبلدة % تحلهما أخرجت من جنتي عدن % % 29(@)(@@) % وما العيش إلا تارتان فتارة % مناخ على سهل وأخرى على حزن % % 30(@)(@@) % أتذكر أياما بها ولياليا % محاسنها كالروض في صبحة الدجن % % PageV01P4577 31(@)(@@) % عهود خلت محمودة وكأنها % % معانقة اللذات في حلة الأمن % % 32(@)(@@) % عطفناك فاعطف إن كل ابن حرة % أخو مكسر صلب وذو معطف لدن % % 33(@)(@@) % وإن سقطا بي في كتابي تتابعت % فلا تلحني فيما جنيت على ذهني % % 34(@)(@@) % ظلمت فإن ألحن فظلمك خلتي % % جنى زلتي والظلم شر من اللحن % % PageV01P4578 البحر : - 1(@)(@@) % قد يفي للصديق غير أمينه % ويخون الصديق غير ظنينه % 2(@)(@@) % ويرى غائب الصواب غبي % ويغيب الصواب عن مستبينه % % 3(@)(@@) % نذرت عصبة بأني أستو % % في رغيفا وجانبا من قرينه % % 4(@)(@@) % فتداعت تداعي القوم في 
ms1208	 الثل % % لة لليث طالعا من عرينه % % 5(@)(@@) % ثم صاحوا السلاح فانصات كهل % فيلسوف وبندهم في يمينه % % 6(@)(@@) % قلت لابأس إن في ابن أبي القا % % سم شغلا عن غثكم بسمينه % % 7(@)(@@) % لا تخافوا وأيقنوا أيها القو % % م ببيعي خسيسكم بثمينه % % 8(@)(@@) % بأبي من غنيت عن كل غزر % % غير عذب بعذبه ومعينه % % 9(@)(@@) % بأبي من غنيت عن كل زور % % وغرور بحقه ويقينه % % 10(@)(@@) % سوءة سوءة لحاقر حر % وهوانا معجلا لمهينه % % PageV01P4579 11(@)(@@) % سوءة سوءة لشاهد ود % غرني من مكمن وكمينه % % PageV01P4580 البحر : - 1(@)(@@) % رجل من آل يحيى % % أبواه أبوانص منهما شيخ جليل % % 2(@)(@@) % من رسول الله داني % % وغلام من بني الأص % % 3(@)(@@) % فر فحل كالحصان % % فهو حقا لا مجازا % 4(@)(@@) % أبواه رجلان % % ن % PageV01P4581 البحر : - 1(@)(@@) % قدوم سعادة وقفول يمن % هي السراء تنسخ كل جزن % % 2(@)(@@) % بدا قمر البهاء يزف زفا % % وركن الملك معضودا بركن % % 3(@)(@@) % وهب نسيمه وذكا نثاه % % فيالله من طيب وحسن % 4(@)(@@) % أظلته السلامة ما تغنت % مطوقة ترنم فوق غصن % % PageV01P4582 البحر : - 1(@)(@@) % أيها الحاسدي على صحبتي العس % % ر وذمي الزمان والإخوانا % % 2(@)(@@) % حسدا هاجه على ثلب شعري % % ولقائي معبسا غضبانا % % 3(@)(@@) % وانتقاضي مع العدو وقد كا % % ن يرى لي نقائصي رجحانا % % 4(@)(@@) % ليت شعري ماذا حسدت عليه % % أيها الظالمي إخائي عيانا % % 5(@)(@@) % أعلى أنني ظمئت وأضحى % % كل من كان صاديا ريانا % % 6(@)(@@) % أم على أنني أمشي حسيرا % وأرى الناس كلهم ركبانا % % 7(@)(@@) % أم على أنني ثكلت شقيقي % % وعدمت الثراء والأوطانا % % 8(@)(@@) % عد كريما إلى كريم كما كن % % ت وإلا لقيت مني هوانا % % 9(@)(@@) % لا عقابا بما تقول ولكن % بجفاء أردفته هجرانا % % 10(@)(@@) % وتيقن أني مقيم على العه % % د حياتي وخذ بذاك ضمانا % % PageV01P4583 11(@)(@@) % لا أعد الذنوب منك ذنوبا % بل هدايا مقبولة وحنانا % % 12(@)(@@) % وكذا ذنب كل دهر يليه % % آل وهب أعده إحسانا % % 13(@)(@@) % وأرى يومهم ضمينا وفيا % بغد يجعل العدا خلانا % % 14(@)(@@) % قسما لو جهدت جهدك ما اع % % تدتك نفسي إلا أخا خلصانا % % 15(@)(@@) % فارقب الإل أن تكون على % % خلك قدما مع 
ms1209	 الزمان زمانا % % PageV01P4584 البحر : - 1(@)(@@) % وصفعان يجود بمصفعيه % % ويصفع نفسه في الصافعينا % % 2(@)(@@) % كهدم المشركين بيوت سوء % بأيديهم وأيدي المؤمنينا % % 3(@)(@@) % أبا حفص جزاك الله خيرا % فأنت السيد المفضال فينا % % 4(@)(@@) % قفاك لمن أراد الصفع وقف % وعرسك منحة للنائكينا % % PageV01P4585 البحر : - 1(@)(@@) % زعم الناس أن للسعد نجما % % واحدا لا يزيد أو نجمين % 2(@)(@@) % قلت مهلا ستلتقي الشمس والبد % % ر فكم يطلعان من سعدين % % 3(@)(@@) % ستلاقي الإمام عما قليل % بنت مولاه سيد المغربين % 4(@)(@@) % وسيعطى الإمام منها سعودا % كلها للإمام قرة عين % PageV01P4586 البحر : - 1(@)(@@) % حيتك عنا شمال طاف طائفها % % بجنه فجرت روحا وريحانا % % 2(@)(@@) % هبت سحيرا فناجى الغصن صاحبه % % موسوسا وتنادى الطير إعلانا % % 3(@)(@@) % ورق تغنى على خضر مهدلة % تسمو بها وتشم الأرض أحيانا % % 4(@)(@@) % تخال طائرها نشوان من طرب % % والغصن من هزة عطفيه نشوانا % % PageV01P4587 البحر : - 1(@)(@@) % صبرا أمير المؤمنينا % % فالله يجزي الصابرينا % % 2(@)(@@) % كنا نهني بالخلا % % فة قبلك المتنعمينا % % 3(@)(@@) % حتى إذا صارت إلي % % ك هديت هدي الراشدينا % % 4(@)(@@) % فمنعت نفسك درها % % ومريتها للحالبينا % % 5(@)(@@) % ولما غبنت متاعها % % بل بعتها بيعا ثمينا % % 6(@)(@@) % فاصبر لها زال عو % نك من رضيت به معينا % % 7(@)(@@) % هي محنة للمتقي % % ن وفتنة للمترفينا % % PageV01P4588 البحر : - 1(@)(@@) % قائل ماله أدناه مجنى % من الأيدي جميعا والأماني % % 2(@)(@@) % كذاك فوارض الثمرات تحنو % % هواديها فتمكن كل جاني % % PageV01P4589 البحر : - 1(@)(@@) % نفائس ماله أدناه مجنى % من الأيدي جميعا والأماني % % 2(@)(@@) % كذاك قواعد الثمرات تدنو % % مجانيها فتمكن كل جاني % % PageV01P4590 البحر : - 1(@)(@@) % يا مجير الورى من الحدثان % وربيع العفاة كل أوان % 2(@)(@@) % ما الذي ينشر المدائح ممن % قد طوى جوده صنوف الزمان % % 3(@)(@@) % كللت كفه سماء المعالي % % بنجوم المعروف والإحسان % % 4(@)(@@) % فبها يستضيء كل رجاء % وبها تهتدي إليه الأماني % % 5(@)(@@) % يا شقيق الندى وترب المعالي % % وسراج الهدى بكل مكان % % 6(@)(@@) % كثرت من العلا معانيك حتى % % أعورتنا أسماء تلك المعاني % % 7(@)(@@) % أنت عيد للناس في كل عيد % بل لعمري في سائر الأزمان % % 8(@)(@@) % شرق الناس بالذبائح في الأض % % حى وأعطوا طوابق اللحمان % % 9(@)(@@) % ورأينا الأمير شرق 
ms1210	 فيه % ببدور اللجين والعقيان % % 10(@)(@@) % جعل الله يوم أضحاك يوما % ضامنا للسعود أوفى ضمان % % PageV01P4591 11(@)(@@) % قصر القول في الأمير وفيه % طول ما طال منه في المهرجان % % 12(@)(@@) % شفقا من أذى الأمير المرجى % % وحذارا من مجة الآذان % % PageV01P4592 البحر : - 1(@)(@@) % م مكر الزمان علينا غير مأمون % فلا تظنن ظنا غير مظنون % 2(@)(@@) % بل المخوف علينا مكر أنفسنا % % ذات المنى دون مكر البيض والجون % % 3(@)(@@) % إن الليالي والأيام قد كشفت % من كيدها كل مستر ومكنون % 4(@)(@@) % وخبرتنا بأنا من فرائسها % % نواطقا بفصيح غير ملحون % % 5(@)(@@) % واستشهدت من مضى منا فأنبأنا % % عن ذاك كل لقى منا ومدفون % % 6(@)(@@) % من هالك وقتيل بين معتبط % % وبين فان بترك الدهر مطحون % % 7(@)(@@) % فكيف تمكر وهي الدهر تنذرنا % % من الحوادث بالإبكار والعون % % 8(@)(@@) % ووالدين حقيق أن يعقهما % % راعي الأمور بطرف غير مكمون % % 9(@)(@@) % أب وأم لهذا الخلق كلهم % كلاهما شر مقرون بمقرون % % 10(@)(@@) % دهر ودنيا تلاقي كل من ولدا % % لديهما بمحله الخسف والهون % % PageV01P4593 11(@)(@@) % للذبح من غذوا منا ومن حضنا % % لا بل ومن تركاه غير محضون % % 12(@)(@@) % إن ربيا قتلا أو أسمنا أكلا % فما دم طمعا فيه بمحقون % % 13(@)(@@) % أب إذا بر أبلانا وأهرمنا % % قبحا له من أب بالذم ملسون % % 14(@)(@@) % نضحي له كقداح في يدي صنع % % فكلنا بين مبري ومسفون % % 15(@)(@@) % يغادر الجلد منا بعد مرته % عظما دقيقا وجلدا غير مودون % % 16(@)(@@) % نضوا تراه إذا ماقام معتصما % بالأرض يعجن منها شر معجون % % 17(@)(@@) % حتى إذا مارزئنا صاح صائحه % ليس الخلود لذي نفس بمضمون % % 18(@)(@@) % هذا وإن عففالأدواء معرضة % من بين حمى وبلسام وطاعون % 19(@)(@@) % والحرب تضرمها فينا حوادثه % حتى نرى بين مضروب ومطعون % % 20(@)(@@) % وأم سوء إذا مارام مرتضع % إخلافها صد عنها صد مزبون % % PageV01P4594 21(@)(@@) % تجفوا وإن عانقت يوما لها والدا % % كانت كمطرورة في نحر موتون % % 22(@)(@@) % ونحن في ذاك نصفيها مودتنا % % تبا لكل سفيه الرأي مغبون % % 23(@)(@@) % نشكو إلى الله جهلا قد أضر بنا % % بل ليس جهلا ولكن علم مفتون % % 24(@)(@@) % أغوى الهوى كل ذي عقل 
ms1211	 فلست ترى % % إلا صحيحا له أفعال مجنون % % 25(@)(@@) % نعصي الإله ونعصي الناصحين لنا % % ونستجيب لمقبوح وملعون % % 26(@)(@@) % هوى غوي وشيطان له خدع % مضللات وكيد غير مأمون % % 27(@)(@@) % أعجب به من عدو ذي منابذة % مصغى إليه طوال الدهر مزكون % % 28(@)(@@) % وفي أبينا وفيه أي معتبر % لو اعتبرنا برأي غير مأفون % % 29(@)(@@) % حتى متى نشتري دنيا بآخرة % سفاهة ونبيع الفوق بالدون % % 30(@)(@@) % معللين بآمال تخادعنا % % وزخرف من غرور العيش موصون % % PageV01P4595 31(@)(@@) % نجري مع الدهر والآجال تخلجنا % % والدهر يجري خليعا غير معنون % % 32(@)(@@) % إنا نجاري خليعا غير متزع % ونحن من بين معنون ومرسون % % 33(@)(@@) % يبقى ونفنى ونرجو أن نماطله % % أشواط مضطلع بالجري أفنون % % 34(@)(@@) % تأتي على القمر الساري حوادثه % % حتى يرى ناحلا في شخص عرجون % 35(@)(@@) % نبني المعاقل والأعداء كامنة % فينا بكل طرير الخد مسنون % % 36(@)(@@) % ونجمع المال نرجو أن يخلدنا % % وقد أبى قبلنا تخليد قارون % % 37(@)(@@) % نظل نستنفق الأعمار طيبة % عنها النفوس ولا نسخو بماعون % % 38(@)(@@) % مع اليقين بأنا محرزون به % قسطا من الأجر موزونا بموزون % % 39(@)(@@) % يا باني الحصن أرساه وشيده % % حرزا لشلو من الأعداء مشحون % % 40(@)(@@) % انظر إلى الدهر هل فاتته بغيته % في مطمح النسر أو في مسبح النون % % PageV01P4596 41(@)(@@) % بنيت حصنا وأم السوء قد خبنت % لك المنية فانظر أي مخبون % % 42(@)(@@) % ومن تحصن محبوسا على أجل % فإنما حصنه سجن لمسجونمكر الزمان علينا غير مأمون % 43(@)(@@) % فلا تظنن ظنا غير مظنون % بل المخوف علينا مكر أنفسنا % % 44(@)(@@) % ذات المنى دون مكر البيض والجون % % إن الليالي والأيام قد كشفت % 45(@)(@@) % من كيدها كل مستر ومكنون % وخبرتنا بأنا من فرائسها % % 46(@)(@@) % نواطقا بفصيح غير ملحون % % واستشهدت من مضى منا فأنبأنا % % 47(@)(@@) % عن ذاك كل لقى منا ومدفون % % من هالك وقتيل بين معتبط % % 48(@)(@@) % وبين فان بترك الدهر مطحون % % فكيف تمكر وهي الدهر تنذرنا % % 49(@)(@@) % من الحوادث بالإبكار والعون % % ووالدين حقيق أن يعقهما % % 50(@)(@@) % راعي الأمور بطرف غير مكمون % % أب وأم لهذا الخلق كلهم % PageV01P4597 51(@)(@@) % كلاهما شر مقرون بمقرون % % دهر ودنيا تلاقي كل 
ms1212	 من ولدا % % 52(@)(@@) % لديهما بمحله الخسف والهون % % للذبح من غذوا منا ومن حضنا % % 53(@)(@@) % لا بل ومن تركاه غير محضون % % إن ربيا قتلا أو أسمنا أكلا % 54(@)(@@) % فما دم طمعا فيه بمحقون % % أب إذا بر أبلانا وأهرمنا % % 55(@)(@@) % قبحا له من أب بالذم ملسون % % نضحي له كقداح في يدي صنع % % 56(@)(@@) % فكلنا بين مبري ومسفون % % يغادر الجلد منا بعد مرته % 57(@)(@@) % عظما دقيقا وجلدا غير مودون % % نضوا تراه إذا ماقام معتصما % 58(@)(@@) % بالأرض يعجن منها شر معجون % % حتى إذا مارزئنا صاح صائحه % 59(@)(@@) % ليس الخلود لذي نفس بمضمون % % هذا وإن عففالأدواء معرضة % 60(@)(@@) % من بين حمى وبلسام وطاعون % والحرب تضرمها فينا حوادثه % PageV01P4598 61(@)(@@) % حتى نرى بين مضروب ومطعون % % وأم سوء إذا مارام مرتضع % 62(@)(@@) % إخلافها صد عنها صد مزبون % % تجفوا وإن عانقت يوما لها والدا % % 63(@)(@@) % كانت كمطرورة في نحر موتون % % ونحن في ذاك نصفيها مودتنا % % 64(@)(@@) % تبا لكل سفيه الرأي مغبون % % نشكو إلى الله جهلا قد أضر بنا % % 65(@)(@@) % بل ليس جهلا ولكن علم مفتون % % أغوى الهوى كل ذي عقل فلست ترى % % 66(@)(@@) % إلا صحيحا له أفعال مجنون % % نعصي الإله ونعصي الناصحين لنا % % 67(@)(@@) % ونستجيب لمقبوح وملعون % % هوى غوي وشيطان له خدع % 68(@)(@@) % مضللات وكيد غير مأمون % % أعجب به من عدو ذي منابذة % 69(@)(@@) % مصغى إليه طوال الدهر مزكون % % وفي أبينا وفيه أي معتبر % 70(@)(@@) % لو اعتبرنا برأي غير مأفون % % حتى متى نشتري دنيا بآخرة % PageV01P4599 71(@)(@@) % سفاهة ونبيع الفوق بالدون % % معللين بآمال تخادعنا % % 72(@)(@@) % وزخرف من غرور العيش موصون % % نجري مع الدهر والآجال تخلجنا % % 73(@)(@@) % والدهر يجري خليعا غير معنون % % إنا نجاري خليعا غير متزع % 74(@)(@@) % ونحن من بين معنون ومرسون % % يبقى ونفنى ونرجو أن نماطله % % 75(@)(@@) % أشواط مضطلع بالجري أفنون % % تأتي على القمر الساري حوادثه % % 76(@)(@@) % حتى يرى ناحلا في شخص عرجون % نبني المعاقل والأعداء كامنة % 77(@)(@@) % فينا بكل طرير الخد مسنون % % ونجمع المال نرجو أن يخلدنا % % 78(@)(@@) % وقد أبى قبلنا تخليد قارون % % نظل نستنفق الأعمار طيبة % 79 
ms1213	(@)(@@) % عنها النفوس ولا نسخو بماعون % % مع اليقين بأنا محرزون به % 80(@)(@@) % قسطا من الأجر موزونا بموزون % % يا باني الحصن أرساه وشيده % % PageV01P4600 81(@)(@@) % حرزا لشلو من الأعداء مشحون % % انظر إلى الدهر هل فاتته بغيته % 82(@)(@@) % في مطمح النسر أو في مسبح النون % % بنيت حصنا وأم السوء قد خبنت % 83(@)(@@) % لك المنية فانظر أي مخبون % % ومن تحصن محبوسا على أجل % 84(@)(@@) % فإنما حصنه سجن لمسجون % % أما رأيت ابن إسحاق ومصرعه % 85(@)(@@) % ودونه ركن عز غير موهون % % بأس الأمير وأبطال مدججة % 86(@)(@@) % وكل أجرد ملحوف وملبون % % خاضت إليه غمار العز ميتته % 87(@)(@@) % فربعه منه قفر غير مسكونه مكر الزمان علينا غير مأمون % فلا تظنن ظنا غير مظنون % 88(@)(@@) % بل المخوف علينا مكر أنفسنا % % ذات المنى دون مكر البيض والجون % % 89(@)(@@) % إن الليالي والأيام قد كشفت % من كيدها كل مستر ومكنون % 90(@)(@@) % وخبرتنا بأنا من فرائسها % % نواطقا بفصيح غير ملحون % % PageV01P4601 91(@)(@@) % واستشهدت من مضى منا فأنبأنا % % عن ذاك كل لقى منا ومدفون % % 92(@)(@@) % من هالك وقتيل بين معتبط % % وبين فان بترك الدهر مطحون % % 93(@)(@@) % فكيف تمكر وهي الدهر تنذرنا % % من الحوادث بالإبكار والعون % % 94(@)(@@) % ووالدين حقيق أن يعقهما % % راعي الأمور بطرف غير مكمون % % 95(@)(@@) % أب وأم لهذا الخلق كلهم % كلاهما شر مقرون بمقرون % % 96(@)(@@) % دهر ودنيا تلاقي كل من ولدا % % لديهما بمحله الخسف والهون % % 97(@)(@@) % للذبح من غذوا منا ومن حضنا % % لا بل ومن تركاه غير محضون % % 98(@)(@@) % إن ربيا قتلا أو أسمنا أكلا % فما دم طمعا فيه بمحقون % % 99(@)(@@) % أب إذا بر أبلانا وأهرمنا % % قبحا له من أب بالذم ملسون % % 100(@)(@@) % نضحي له كقداح في يدي صنع % % فكلنا بين مبري ومسفون % % PageV01P4602 101(@)(@@) % يغادر الجلد منا بعد مرته % عظما دقيقا وجلدا غير مودون % % 102(@)(@@) % نضوا تراه إذا ماقام معتصما % بالأرض يعجن منها شر معجون % % 103(@)(@@) % حتى إذا مارزئنا صاح صائحه % ليس الخلود لذي نفس بمضمون % % 104(@)(@@) % هذا وإن عففالأدواء معرضة % من بين حمى وبلسام وطاعون % 105(@)(@@) % والحرب تضرمها فينا حوادثه % حتى نرى بين مضروب 
ms1214	 ومطعون % % 106(@)(@@) % وأم سوء إذا مارام مرتضع % إخلافها صد عنها صد مزبون % % 107(@)(@@) % تجفوا وإن عانقت يوما لها والدا % % كانت كمطرورة في نحر موتون % % 108(@)(@@) % ونحن في ذاك نصفيها مودتنا % % تبا لكل سفيه الرأي مغبون % % 109(@)(@@) % نشكو إلى الله جهلا قد أضر بنا % % بل ليس جهلا ولكن علم مفتون % % 110(@)(@@) % أغوى الهوى كل ذي عقل فلست ترى % % إلا صحيحا له أفعال مجنون % % PageV01P4603 111(@)(@@) % نعصي الإله ونعصي الناصحين لنا % % ونستجيب لمقبوح وملعون % % 112(@)(@@) % هوى غوي وشيطان له خدع % مضللات وكيد غير مأمون % % 113(@)(@@) % أعجب به من عدو ذي منابذة % مصغى إليه طوال الدهر مزكون % % 114(@)(@@) % وفي أبينا وفيه أي معتبر % لو اعتبرنا برأي غير مأفون % % 115(@)(@@) % حتى متى نشتري دنيا بآخرة % سفاهة ونبيع الفوق بالدون % % 116(@)(@@) % معللين بآمال تخادعنا % % وزخرف من غرور العيش موصون % % 117(@)(@@) % نجري مع الدهر والآجال تخلجنا % % والدهر يجري خليعا غير معنون % % 118(@)(@@) % إنا نجاري خليعا غير متزع % ونحن من بين معنون ومرسون % % 119(@)(@@) % يبقى ونفنى ونرجو أن نماطله % % أشواط مضطلع بالجري أفنون % % 120(@)(@@) % تأتي على القمر الساري حوادثه % % حتى يرى ناحلا في شخص عرجون % PageV01P4604 121(@)(@@) % نبني المعاقل والأعداء كامنة % فينا بكل طرير الخد مسنون % % 122(@)(@@) % ونجمع المال نرجو أن يخلدنا % % وقد أبى قبلنا تخليد قارون % % 123(@)(@@) % نظل نستنفق الأعمار طيبة % عنها النفوس ولا نسخو بماعون % % 124(@)(@@) % مع اليقين بأنا محرزون به % قسطا من الأجر موزونا بموزون % % 125(@)(@@) % يا باني الحصن أرساه وشيده % % حرزا لشلو من الأعداء مشحون % % 126(@)(@@) % انظر إلى الدهر هل فاتته بغيته % في مطمح النسر أو في مسبح النون % % 127(@)(@@) % بنيت حصنا وأم السوء قد خبنت % لك المنية فانظر أي مخبون % % 128(@)(@@) % ومن تحصن محبوسا على أجل % فإنما حصنه سجن لمسجون % % 129(@)(@@) % أما رأيت ابن إسحاق ومصرعه % ودونه ركن عز غير موهون % % 130(@)(@@) % بأس الأمير وأبطال مدججة % وكل أجرد ملحوف وملبون % % PageV01P4605 131(@)(@@) % خاضت إليه غمار العز ميتته % فربعه منه قفر غير مسكون % % 132(@)(@@) % تبكي له كل معلاة ومكرمة % بمستهل حثيث السح مشنون % % 133(@)(@@) % مادافعت عنه 
ms1215	 أبواب محجبة % كلا ولا حجر مغشية الخون % % 134(@)(@@) % مملوءة ذهبا عينا تجيش به % % جنات نخل وأعناب وزيتون % % 135(@)(@@) % قل للأمير وإن ضافته نازلة % يمسي لها الجلد في سربال محزون % % 136(@)(@@) % صبرا جميلا وهل صبر تفات به % % وإن فجعت بمنفوس ومضنون % 137(@)(@@) % خانتك إلفك عبد الله خائنة % هي التي فجعت موسى بهارون % % 138(@)(@@) % يستثقل المرء رزء الخل يرزؤه % وإنما حط عنه ثقل مديون % % 139(@)(@@) % للموت دين من الخلان كلهم % يقضاه من كل مذخور ومخزون % % 140(@)(@@) % عذرت باكي شجو لو رأيت أخا % بما أصاب أخاه غير مرهون % % PageV01P4606 141(@)(@@) % وما تأخر حي بعد ميتته % % إلا تأخر نقد بعد عربون % % 142(@)(@@) % وللأمير بقاء لا انقطاع له % % أخرى الليالي وأجر غير ممنون % % 143(@)(@@) % في نعمة كرياض الحزن ضاحكة % في ظل بال من الأيام مدجون % % 144(@)(@@) % تدور منه أمور الملك قاطبة % على وزير أمين الغيب ميمون % % 145(@)(@@) % يرجى ويخشى وتغشى داره أبدا % غشيان بيت لآل الله مسدون % % PageV01P4607 البحر : - 1(@)(@@) % أستغفر الله من ذنبي ومن خطئي % % إلا هجائي دعي القحطبينا % % 2(@)(@@) % فإن ذلك ذنب لست أحفله % % لا يغفر الله ذاك الذنب آمينا % % PageV01P4608 البحر : - 1(@)(@@) % كان للأرض مرة ثقلان % فلها اليوم ثالث بفلان % 2(@)(@@) % أتقي غصة اسمه علم الل % ه فأكني عن ذكره بالمعاني % % 3(@)(@@) % يا ثقيل الثقال أقذيت عيني % % ليت أني كما أراك تراني % % 4(@)(@@) % من يكن عانيا بحب حبيب % % ففؤادي ببغضك الدهر عاني % % PageV01P4609 البحر : - 1(@)(@@) % أغضى أبو بكر على الهون % كأنه ليس يباليني % % 2(@)(@@) % يا بن حريث هذه حيلة % يحتالها بعض المجانين % 3(@)(@@) % إذا رأى الصبيان يرمونه % % داراهم بالرفق واللين % % 4(@)(@@) % كأنه ليس يباليهم % وعنده ما ليس بالدون % % 5(@)(@@) % أمي إذا أمك إن لم تكن % % مني على مثل الطياجين % % 6(@)(@@) % فلا تخادعني فلست الذي % % يخدع إخوان الشياطين % % PageV01P4610 البحر : - 1(@)(@@) % تعالت قرون أبي يوسف % علوا كبيرا وسبحانها % % 2(@)(@@) % أبا يوسف كم ربوخ لدي % % ك أوطأت طرفي ميدانها % % 3(@)(@@) % إذا قادها لي شيطانها % % أطرت بأيري شيطانها % % 4(@)(@@) % جسست بفيشلتي قلبها % % وزلزلت بالرهز أركانها % % 5(@)(@@) % أخلط موضع إخلاصها % % فألقى 
ms1216	 هنا لك كفرانها % % 6(@)(@@) % كأني في جس مكنونها % % بعثت لأسبر إيمانها % % 7(@)(@@) % لمثل قرونك يا كسروي % % شيدت الفرس إيوانها % % PageV01P4611 البحر : - 1(@)(@@) % حببت درة القيان إلينا % % مثل ما بغضت إلينا القيانا % % 2(@)(@@) % حببتهن أن غدت وهي منهن % ن وإن كن دونها أوزانا % % 3(@)(@@) % ولقد فزن إذ يناغين فاها % % ويديها وعودها الألحانا % % 4(@)(@@) % وتحرمن إذ غدون إماء % مذعنات بحقها إذعانا % % 5(@)(@@) % تلبس التاج فالقيان لديها % % واضعات لتاجها الأذقانا % % 6(@)(@@) % تاج حسن يثنيه تاج من الإحس % % سان تاجان طالما ملكانا % % 7(@)(@@) % غير أني رأيتها بغضتهن % ن بأن لم تدع لهن مكانا % % 8(@)(@@) % نزلت في الدور منزل من % % برز حسنا ومن علا إحسانا % % 9(@)(@@) % فنفتهن عن قلوب وقد % كن تبوأن حبها أوطانا % % 10(@)(@@) % فغدا البائسات منهن يطلب % ن على دفع ظلمها أعوانا % % PageV01P4612 11(@)(@@) % ظلمت من صبا وغنى % % فكل يشتكي من دريرة العدوانا % % 12(@)(@@) % أنصف الله صاحب العذل منها % % عاشقا والمحسنات الحسانا % % 13(@)(@@) % ما نبالي إذا دريرة أبدت % نزهتيها ألا نرى بستانا % % 14(@)(@@) % نزهة الطرف شفعها نز % % هة السمع إذا ناغمت لك العيدانا % % 15(@)(@@) % ذات وجه كأنما قيل كن % فردا بديعا بلا نظير فكانا % % 16(@)(@@) % فيه عينان ترميان بلحظ % نافذ النبل يصرع الأقرانا % % 17(@)(@@) % فوق غصن مهفهف تلثم التف % فاح فيه وتلمس الرمانا % % 18(@)(@@) % تجتلي خلقها فتلقى قواما % خيزرانا وصبغة أرجوانا % % 19(@)(@@) % لونها الدهر واحد كجني الور % % د وإن كان ودها ألوانا % % 20(@)(@@) % بينما وصلها لذي الود وصل % إذ أحالته بالقلى هجرانا % % PageV01P4613 21(@)(@@) % كملت كلها فلست ترى في % % ها سوى سوء عهدها نقصانا % % 22(@)(@@) % فمتى ما أجلت طرفك فيها % % فهي كالشمس صورت إنسانا % % 23(@)(@@) % ومتى ما سمعت منها فشدو % يطرد الهم عنك والأحزانا % % 24(@)(@@) % قادر أن يميت أشجان قوم % % قادر أن يهيج الأشجانا % % 25(@)(@@) % ومتى ما لثمت فاها فشيء % تجد الراح فيه والريحانا % % 26(@)(@@) % ريقة كالشمول طيبا ونشر % كنسيم خاض الجنانا % % 27(@)(@@) % صغروها مخافة العين عمدا % وهي أعلى القيان قدرا وشانا % % 28(@)(@@) % فدعوها دريرة وهي الدر % رة تغلو فتأخذ الأثمانا % % 29(@)(@@) % لو رآها في الجاهلية 
ms1217	 قوم % عبدوها وجانبوا الأوثانا % % 30(@)(@@) % هي حلمي إذا رقدت وهمي % وسروري ومنيتي يقظانا % % PageV01P4614 31(@)(@@) % مع أن الرقاد قد خان عهدي % % مذ تكلفت حبلها الخوانا % % 32(@)(@@) % لاتزال القلوب تصبو إليها % % أو تراها تقلب الأجفانا % % 33(@)(@@) % فإذا تابعت سهام الهوى المح % % ض طلبنا هناك منها الأماناص غير حنانة على عاشقيها % % 34(@)(@@) % حين تحتث عودها الحنانا % % غير أنا نحبها كيف كانت % 35(@)(@@) % ما أحبت أرواحنا الأبدانا % % إن تسلط على القلوب بلا جر % % 36(@)(@@) % م فأحلى مسلط سلطانا % % قل لمن عابها أحلت وأبطل % 37(@)(@@) % ت وناقضت بل بهت العيانا % % ليت شعري أوجهها عبت كلا % % 38(@)(@@) % أم تنقصت جيدها الحسانا % % أم شواها إذا أغض براها % % 39(@)(@@) % أم حشاها أم فرعها الفينانا % % أم ندى صوتها إذا رجعته % 40(@)(@@) % في المثاني أم دلها الفتانا % % ليس فيها شيء يعاب لدينا % % PageV01P4615 41(@)(@@) % غير بخل بنيلها قد شجانا % % عندها البخل بالنوال ولو بالط % 42(@)(@@) % طيف منها يزورنا أحيانا % % نعمة كالغرام أوسعنا الل % 43(@)(@@) % ه امتنانا بوصلها وامتحانا % % طال ما طولت على حبها اليو % % 44(@)(@@) % م وما قصرت عليه الزمانا % % تتغنى فالدهر يوم قصير % 45(@)(@@) % وإذا ما جفت عدمنا كرانا % % أيها السائلي بها كيف حمدي % % 46(@)(@@) % لجداها لقيت عندي بيانا % % قد أرتنا وأسمعتنا ولكن % 47(@)(@@) % تركت كل عاشق ظمآنا % % أفلا قائل لها ذو احتساب % 48(@)(@@) % حين تحمي رضابها العطشانا % % متعي هذه المراشف من ري % % 49(@)(@@) % قك يا من يمتع الآذانا % % واقسمي العدل في جوارح قوم % % 50(@)(@@) % ترك الظلم بعضها هيمانا % % لا تنيلي جوارحا ما تمنت % PageV01P4616 51(@)(@@) % وتنيلي جوارحا حرمانا % % أرشفينا كما أريت وأسمع % 52(@)(@@) % ت ولا تتركي الهوى صديانا % % أنا والله يا دريرة أهوا % % 53(@)(@@) % ك وإن ذقت في هواك الهوانا % % ياكثيبا عليه غصن من البا % % 54(@)(@@) % ن وفرع يمج مسكا وبانا % % أشتهي أن أعض منك بنانا % 55(@)(@@) % طال عضي عليه مني البنانا % % حين تستمطرين أوتارك الدر % 56(@)(@@) % ر على السامعين والمرجانا % % لم أنل منك مذ هويتك حظا % % 57(@)(@@) % من نوال سرا ولا إعلانا % % غير أني أبيت ليلي حيرا % % 58(@)(@@) % ن 
ms1218	 أراعي من نجمه حيرانا % % قد وصفنا فمن غدا يتمارى % % 59(@)(@@) % فليزرنا نقم له البرهانا % % عندنا منظر لها وسماع % 60(@)(@@) % كفيانا لطالب تبيانا % % ن % PageV01P4617 البحر : - 1(@)(@@) % إليك طابق ممنون المطي بنا % % نرجو لديك عطاء غير ممنون % % 2(@)(@@) % طورا إذا ما استظلت كل ضاحية % وتارة حين يضحى كل مكنون % % PageV01P4618 البحر : - 1(@)(@@) % أتيت أبا جنادة مستنيلا % ويخلف بعض ماتعد الظنون % 2(@)(@@) % فسام النفس تنويلي فسافت % بذلك مشربا فيه أجون % % 3(@)(@@) % فألقى عذرة كذبا ومينا % % من العذرات يأباها الحقين % % PageV01P4619 البحر : - 1(@)(@@) % يا ليت أهل العقل إذ حرموا % % عصموا من الشهوات والفتن % 2(@)(@@) % لكنهم حرموا وما عصموا % % فقلوبهم مرضى من الحزن % % 3(@)(@@) % وكأن أهل العقل إذ خلقوا % % وقفت قلوبهم على المحن % 4(@)(@@) % وهم أحسوا على بليتهم % من غيرهم بمضاضة الغبن % % PageV01P4620 البحر : - 1(@)(@@) % يا أيها الرجل المسود شيبه % كيما يعد به من الشبان % 2(@)(@@) % أقصر فلو سودت كل حمامة % بيضاء ما عدت من الغربان % % PageV01P4621 البحر : - 1(@)(@@) % نعيد أقاويل مملولة % إذا ما أعيدت على السامعينا % % 2(@)(@@) % فطورا دعاء بما قد قضى % % بذلك قاضي القضايا جنينا % % 3(@)(@@) % وطورا ثناء بما قد جرى % % قديما على ألسن العالمينا % % 4(@)(@@) % وأنت تعيد لنا نائلا % إعادته منية الراغبينا % % 5(@)(@@) % فشتان شتان ما بيننا % % لقد فت بالفضل مبينا % % 6(@)(@@) % أقول لطلاب ما نلتة % % قصاركم نيله واصفينا % % 7(@)(@@) % صفوه ووفوه حقا له % % من الوصف نعددكم فاضلينا % % 8(@)(@@) % ووفد ثناء أناخوا به % % عفاة لمعروفه آملينا % % 9(@)(@@) % فآبوا وقد صدقوا آملي % % ن وفقا لما صدقوا مادحينا % % 10(@)(@@) % كذلك راجوه والمادحوه % % لا يكذبون ولا يكذبونا % % PageV01P4622 البحر : - 1(@)(@@) % إن يفلت السيف من كفيك منصلتا % فليس منك وقدما كان خوانا % % 2(@)(@@) % بل لو يكون مكان السيف من رجل % كمخلب الليث منه حان من حانا % % PageV01P4623 البحر : - 1(@)(@@) % ألذ من معتق الرساطون % وقهوتي قطربل وكركين % % 2(@)(@@) % رجرجة من ماء ليل تشرين % % كرونق السف اليمان المسنون % % 3(@)(@@) % بات على طود نياف العرنين % % تنفحها الريح برش ممنون % 4(@)(@@) % في شطر كوز صنع طب أفنون % % أخضر في حضرة جرو اليقطين % % 5(@)(@@) % ألست يا محرومها 
ms1219	 بمغبون % % PageV01P4624 البحر : - 1(@)(@@) % أعانقها والنفس بعد مشوقة % إليها وهل بعد العناق تداني % % 2(@)(@@) % فألثم فاها كي تموت حزازتي % % فيشتد ما ألقي من الهيمان % % 3(@)(@@) % وما كان مقدار الذي بي من الجوى % % ليشفيه ما ترشف الشفتان % 4(@)(@@) % كأن فؤادي ليس يشفي غليله % % سوى أن يرى الروحين يمتزجان % % PageV01P4625 البحر : - 1(@)(@@) % أأبكتك المعاهد والمغاني % % كدأبك قبلهن من الغواني % % 2(@)(@@) % وقفت بهن فاستمطرت بيني % % غياثا والتذكر قد شجاني % % 3(@)(@@) % فجاد سحابها تمريه ريح % من الزفرات تلحى من لحاني % % 4(@)(@@) % أجلت بها جمانا من دموعي % % لذكري غير جائلة الجمان % % 5(@)(@@) % وما إن زلت أنعي الصبر مني % % إلى ذي خلتي حتى نعاني % % 6(@)(@@) % ولم تر مثل دمع مستغاث % % ولا كزفير صدر مستعان % 7(@)(@@) % معينا مغرم إذ لا معين % نصيرا مسلم متظاهران % % 8(@)(@@) % أعاناني على البرحاء لما % % أعان علي ثم العاذلان % % 9(@)(@@) % عدمتهما لقد خذلا وضنا % % هناك برعيتي عمن رعاني % % 10(@)(@@) % ألا أسقي دموعي دار ظبي % % لو استسقيت ريقته سقاني % % PageV01P4626 11(@)(@@) % بلى لاسيما وبي اشتفاء % % بسحي عبرتي مما عراني % % 12(@)(@@) % قضى حقين في حق عميد % بكى شجو الأحبة والمغاني % % 13(@)(@@) % وداوى قلبه من داء وشوق % % عراه ففيم لام اللائمان % % 14(@)(@@) % ولكن لا ارتجاع لما تقضى % % فما استشعار باق ذكر فاني % % 15(@)(@@) % وفي هذا الأوان وفي نهاه % شواغل عن صبى ذاك الأوان % % 16(@)(@@) % برئت من الصبابة والتصابي % % إلى الغزلان والنفر الرواني % % 17(@)(@@) % وزارية علي بأن رأتني % % من الهزلى حقيرا في السمان % % 18(@)(@@) % صبرت لها وقلت مقال حر % إليك فإنني بالله غاني % % 19(@)(@@) % وليست خسة الأجفان مما % % يخس قيمة النصل اليماني % % 20(@)(@@) % وليست إن نظرت بزائدات % حلى الأغماد في السيف الددان % PageV01P4627 21(@)(@@) % فمن يك سائلا ما وجه فخري % % فإني فاخر أدبي زهاني % % 22(@)(@@) % ونحن معاشر الشعراء ننمي % % إلى نسب من الكتاب داني % % 23(@)(@@) % وإن كانوا أحق بكل فضل % وأبلغ باللسان وبالبنان % % 24(@)(@@) % أبونا عند نسبتنا أبوهم % % عطارد السماوي المكان % % 25(@)(@@) % أديب لم يلد إلا أديبا % ذكي القلب مشحوذ اللسان % % 26(@)(@@) % مليئا إن توسم بالمعاني % % وفيا إن تكلم بالبيان % % 27 
ms1220	(@)(@@) % أإخوتنا من الكتاب رقوا % % علينا من مغالطة الزمان % % 28(@)(@@) % فإن لم تفعلوا وجفوتمونا % % على إثرائكم فيمن جفاني % % 29(@)(@@) % فإن أبا الحسين أخا المعالي % % طبيب إن تفرد بي شفاني % % 30(@)(@@) % طبيب كم شفاني من سقام % وما جدح الدواء ولا رقاني % % PageV01P4628 31(@)(@@) % فهل يرضيه شكر أعجزته % يداه فما له بهما يدان % % 32(@)(@@) % نعم إن الفتى سمح تمام % وفي السمحاء منقوص المعاني % % 33(@)(@@) % يجود أبو الحسين ولا يعاني % % منافسة الجراء كما نعاني % % 34(@)(@@) % غدا عن كل محمدة سخيا % وليس بها عليه من هوان % % 35(@)(@@) % ولكن همة رفعته حتى % % سمت قدماه فوق الفرقدان % % 36(@)(@@) % وتخفيف عن الإخوان منه % % وإن هم ثقلوا في كل آن % 37(@)(@@) % ولم تر طالبا للحمد أحظى % % به من طالب فيه تواني % % 38(@)(@@) % إذا نام الجواد عن التقاضي % % أتاه الحمد يركض غير واني % % 39(@)(@@) % أعدد لابن أحمد بن يحيى % % مكارم غير خاشعة المباني % % 40(@)(@@) % فتى ضمن الصيانة وهي سؤلي % % فكان ضمانه أملى ضمان % % PageV01P4629 41(@)(@@) % وآمنني تلون حالتيه % فكان أمانه أوفى أمان % % 42(@)(@@) % بل انتقد الحياة من المنايا % % بجود كالجلاد وكالطعان % % 43(@)(@@) % قسطت على الزمان به فأضحى % % وقد أعفى بحقي واتقاني % % 44(@)(@@) % فتى الكتاب نبلا واضطلاعا % وصدق أمانة وعلو شان % % 45(@)(@@) % شكرت له نداه وإن أراني % % نداه تخلفي فيما أراني % % 46(@)(@@) % أنال وقلت يعطيني وأثنى % % فما جاريته حتى شآني % % 47(@)(@@) % أبر علي إبرار المعادي % % ولي منه بر فما اتلاني % % 48(@)(@@) % فلولا أنه رجل كريم % لقلتهناك ممدوحي هجاني % % 49(@)(@@) % ولولا أنني رجل سليم % لقابلت الصنيعة باضطغان % % 50(@)(@@) % ولو سخط امرؤ يولي جميلا % سخطت وحق لي مما اعتلاني % % PageV01P4630 51(@)(@@) % وما سخطي على من جاء يجري % % إلي وغبطتي فرسي رهان % % 52(@)(@@) % وما حسدي امرءا ما زال يغري % % بي الحساد وهو علي حاني % % 53(@)(@@) % حلفت لقد غدا في الناس فردا % فليت الله يؤنسه بثاني % % 54(@)(@@) % وليت الله يغفر لي اشتطاطي % % فقد جاز اشتطاط ذوي الأماني % % 55(@)(@@) % محمد يابن أحمد يابن يحيى % % أخا الآلاء والنعم الحسان % % 56(@)(@@) % أما لقد ارتهنت الدهر شكري % % بعرفك غير معتمد ارتهان % % 57 