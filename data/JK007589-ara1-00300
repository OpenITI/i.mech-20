ms281	 الفضائل غيركم أشباحه % 79(@)(@@) % والعلم مقتسم فعند سواكم % أفياضه ولديكم أمحاحه % % 80(@)(@@) % أصبحتم بيت القضاء فنحوكم % تهوي بطالب فيصل أطلاحه % % PageV01P1059 81(@)(@@) % وبعدلكم أضحى مرادا واسع ال % % بنيان فيه سروحه وسراحه % % 82(@)(@@) % أصحاب مالك الذي لم يعده % من كل علم محضه وصراحه % % 83(@)(@@) % ذاك الذي ما اشتد قفل قضية % % إلا ومن أصحابه فتاحه % % 84(@)(@@) % ولكم بحماد بن زيد ممتح % في العلم يصدر بالرضا متاحه % % 85(@)(@@) % لا يخدع المتعللون ولا يعم % في البحر إلا الحوت أو سباحه % % 86(@)(@@) % بحديث حماد ومقبس مالك % يشفي الأحاح من استحر أحاحه % % 87(@)(@@) % لا يبعدا من حالبين كلاهما % % يمري الشفاء فتستدر لقاحه % % 88(@)(@@) % وكأنما هذا وذاك كلاهما % % من في محمد استقت ألواحه % % 89(@)(@@) % ومخالف أضحى بكم مغمودة % أسيافه مركوزة أرماحه % % 90(@)(@@) % خاطبتموه بالجلية فاتقى % % بيد السلام وقد أظل شياحه % % PageV01P1060 91(@)(@@) % قسما لقد نظر الخليفة نظرة % فرأى بنور الله أين صلاحه % % 92(@)(@@) % وإذا امرؤ وصل الفلاح بسعيكم % % فهو الخليق لأن يتم فلاحه % % 93(@)(@@) % أنى يخيب ولا يفوز مساهم % والحاكمون الفاصلون قداحه % % 94(@)(@@) % علماء دين محمد فقهاؤه % % صلحاؤه صرحاؤه أقحاحه % % 95(@)(@@) % والله أعلم حيث يجعل حكمه % % وإن امترى شغب المراء وقاحه % % 96(@)(@@) % ولئن محضتم للخليفة نصحكم % % ولشر ما يقري النصيح ضياحه % % 97(@)(@@) % فلقد قدحتم لابن ليث قدحكم % حتى توقد في الدجى مصباحه % % 98(@)(@@) % فرأت به عيناه أين خساره % % ورأت به عيناه أين رباحه % % 99(@)(@@) % لما استضاء بنوركم في أمره % % عمرو أضاء مساؤه وصباحه % % 100(@)(@@) % لولا مشورتكم لناطح جده % % جد يبير مناطحيه نطاحه % % PageV01P1061 101(@)(@@) % يا ليت شعري حين يمدح مثلكم % ماذا تراه يزيده مداحه % % 102(@)(@@) % لكنكم كالمسك طاب لعينه % % ويزيد حين تخوضه جداحه % % 103(@)(@@) % لا زلتم من كل عيش صالح % أبدا بحيث دماثه وفساحه % % 104(@)(@@) % بأبي يد لكم صناع أصلحت % دهري وقد أعيا يدي إصلاحه % 105(@)(@@) % بيضاء وادعني بها وثابه % % عمري وضاحكني بها مكلاحه % 106(@)(@@) % تالله لا أنسى دفاع أكفكم % % عني البوار وقد هوى مرضاحه % % 107(@)(@@) % وإذا أظلني البلاء دعوتكم % % فبكم يكون زواله ورواحه % % 108(@)(@@) % وشريد مدح لا يزال مباريا 
ms282	 % سياح سيب أكفكم سياحه % % 109(@)(@@) % قد قلته فيكم ولم أر قائلا % أنبأت عن غيب فما إيضاحه % % 110(@)(@@) % والشكر منتوج علي نتاجه % % وعليكم بالعارفات لقاحه % % PageV01P1062 111(@)(@@) % والعرف أعجم حين يولى مفحما % وبأن يضمن شاعرا إفصاحه % 112(@)(@@) % أسمعت يا حسن المكارم فاستمع % واكبت عدوك أسمعت انواحه % % 113(@)(@@) % أره مكارمك اللواتي لم تزل % % منها يطول ضغاؤه وضباحه % % 114(@)(@@) % خذها هدية شاعر لك شاكر % نطقت بمدحك عجمه وفصاحه % % 115(@)(@@) % نحو المعشق من حديثك سمعه % أبدا ونحو نسيمك استرواحه % % 116(@)(@@) % أهدى إليك عقيلة من شعره % % بكرا يقل بمثلها إسماحه % % 117(@)(@@) % فامهر كريمته التي أنكحتها % % كيما يطيب لدى النكاح نكاحه % % 118(@)(@@) % لا تمنعن مهيرة من مهرها % % إن السري من الفري سفاحه % 119(@)(@@) % بكرت عليك سلامة وكرامة % وعلى عدوك آفة تجتاحه % % PageV01P1063 البحر : - 1(@)(@@) % لابن أبي الجهم وجه سوء % مقبح ظاهر قبوحه % 2(@)(@@) % يعلوه بغض له شديد % % على قلوب الورى طفوحه % % 3(@)(@@) % بغض تراه ولا يراه % % ولم يقصر به وضوحه % % 4(@)(@@) % لولا عمى ناظريه عنه % % لذاب حتى يخف روحه % % PageV01P1064 البحر : - 1(@)(@@) % مستقبل خائفه الصفح % مستقبل آمنه المنح % 2(@)(@@) % خرق إذا استنجدت معروفه % % جاءك نصر الله والفتح % 3(@)(@@) % شارك فيه الحسن إحسانه % وزال عنه القبح والقبح % 4(@)(@@) % شؤبوب غيث مصعق مغدق % تهتانه الوابل لا الرشح % 5(@)(@@) % ألهوب نار فاستنر واستتر % منه فقد أنذرك اللفح % 6(@)(@@) % في بذله وشك وفي بطشه % % بطء ولكن أمره لمح % 7(@)(@@) % ليس تأنيه ونى فترة % كلا ولا جريته جمح % 8(@)(@@) % الخير في مرضاته كله % وإنما سخطته برح % 9(@)(@@) % كالسيف ذو لين لمن مسه % % صفحا وفي شفرته الذبح % 10(@)(@@) % فإن تأتى للظى ناره % % ذو نهية أطفأها النضح % PageV01P1065 11(@)(@@) % وإن قدحت النار من فكره % في ليل خطب أثقب القدح % 12(@)(@@) % أصبح من حلم ومن عزة % % لم يخل من هيبته كشح % 13(@)(@@) % كالطود لا ينطح لكنه % % يوهي رؤوسا شأنها النطح % 14(@)(@@) % من ذاك ذاك الوائلي الذي % % للشعر في أوصافه سبح % 15(@)(@@) % تبجح عدنان بأيامه % % طرا وما من شأنه البجح % 16(@)(@@) % ممن إذا قرظه مادح % ساعده الإجمال والشرح % 17 
ms283	(@)(@@) % مرهوب شيبان ومأمولها % % والجبل الشامخ والسفح % 18(@)(@@) % ذو الجود والبأس الذي باسمه % جاد الحيا وانتشر السرح % 19(@)(@@) % ذو الرفق واليمن الذي باسمه % % فل الشبا واندمل القرح % 20(@)(@@) % من مزحه جد بمعروفه % يفديه قوم جدهم مزح % PageV01P1066 21(@)(@@) % كم عائل ليست له ضيعة % ولا به سعي ولا كدح % 22(@)(@@) % أضحى أبو الصقر له ضيعة % عمرانها التقريظ والمدح % 23(@)(@@) % لولا نداه هلكت أمة % لكن لها من روحه نفح % 24(@)(@@) % يعطي وينمي الله أمواله % والبحر لا ينضبه النزح % 25(@)(@@) % لا برحت آلاؤه في الورى % % مزروعة ما زرع القمح % 26(@)(@@) % أصبح سمحا باللها في العلا % فالشعر فيه مثله سمح % 27(@)(@@) % له نثا ينشر أرواحه % مدح له في ماله متح % 28(@)(@@) % كالمسك مج الورد من مائه % فيه وأذكاه به الجدح % PageV01P1067 البحر : - 1(@)(@@) % يا لائمي في الراح غير مقصر % لا زال رأيك سيئا في الراح % 2(@)(@@) % فأقل ما في ترك مثلك شربها % % توفيرها وطهارة الأقداح % 3(@)(@@) % ما سرني بدلا بما وفرته % منها مكانك واصلا لجناحي % % 4(@)(@@) % أنت لا من ذوي اليور فتهوا % % ك ولا من ذوي الوجوه الصباح % % 4(@)(@@) % أربحتني منها نصيبك محسناخفيف % % فربحت خيرا منك في الأرباح % 4(@)(@@) % قل لنجح أخطأت باب النجاح % % بل تعاطيتهبلا مفتاح % 4(@)(@@) % إن ودان لا تود خصيا % فاصح عنهافقلبها عنك صاحي % % 4(@)(@@) % هي تهوى النكاح والدلك مجهو % % دك فيها والدلك زور نكاح % 4(@)(@@) % لست بالسابح المجيد فدع عن % ك ركوب البحور للسباح % 4(@)(@@) % قطع الجب بالخصي كما يق % طع فقد المردي بالملاح % % PageV01P1068 4(@)(@@) % ليت شعري بما تظنك تصبي % % قلب ودان يا كسير الجناح % 4(@)(@@) % أبوجه كأنه وجه قرد % حائل اللون خامد المصباح % % 4(@)(@@) % أي حرز فيه من الطير أن لو % % جعلوه فزاعة في قراح % % 4(@)(@@) % فيه خدان أنمشان بعيدا % % ن لعمري من حمرة التفاح % % 4(@)(@@) % نمشة فوق صفرة فتراه % % كونيم الذباب في اللقاح % % 4(@)(@@) % وإذا ما التمست منها نوالا % منعت منك كل شيء مباح % % 4(@)(@@) % قال فيما يقول حين أجدت % % جبتها عانتيهما في النطح % % 4(@)(@@) % معشر أشبهوا القرود ولكن % % خالفوها في 
ms284	 خفة الأرواح % % 4(@)(@@) % ليس حمد الخصيان في الناس إلا % % شدة الصبر عند شق الفقاح % % 4(@)(@@) % لا أبا مؤمنا يعد ولا ابنا % % مؤمنا خاب قدحه في القداح % % PageV01P1069 4(@)(@@) % حين يلقى إلهه لم يلده % % ذو صلاح ولم يلد ذا صلاح % % 4(@)(@@) % أم بأير اتى الخصاء عليه % % غير مبق فاجتيح أي اجتياح % % 4(@)(@@) % حين لم يحمداك إذ ذك لكن % % حمدا نفح طيبك النفاح % % 4(@)(@@) % أم بقد كأنه قد زق % % زيد عرضا ببطنك المنداح % 4(@)(@@) % أنت تهدي وتلك هدايا % % ك إلى كل أير نكاح % % 4(@)(@@) % ضل إهداؤك الخرائط يا نجح وأل % % وت به سوافي الرياح % % 4(@)(@@) % لن يكن الطعان إلا برمح % % فاتركوا الطعن للطوال الرماح % % 4(@)(@@) % إنما من يعشق النساء بلا أي % % ر كمثل الغازي بغير سلاح % % 4(@)(@@) % من عذيريم جوركم معشر الخص % % يان إذ تطلبون وصل الملاح % % 4(@)(@@) % أين هذا من دلك نجحفقالت % % طرق الجد غير طرق المزاح % PageV01P1070 4(@)(@@) % بات يلهو بها وباتت تغني % % خاب وجه الخصي يوم الفلاح % % PageV01P1071 البحر : - 1(@)(@@) % ما مدمعي حذر النوى بقريح % فدع الغراب يصيح كل مصيح % 2(@)(@@) % شغلي بإطراء الذي مهما ادعى % % مطريه أعرب عنه بالتصحيح % 3(@)(@@) % أعني المسمى باسم أصدق واعد % % وعدا ذبيح الله خير ذبيح % 4(@)(@@) % لله إسماعيل جدل كتابة % أعني أخا شيبان لا ابن صبيح % 5(@)(@@) % حمل الفوادح فاستقل ومثله % % حمل الفوادح غير ذي تبليح % 6(@)(@@) % ما ضر من زم الكتابة زمة % أن كان منبته بأرض الشيح % 7(@)(@@) % ما ضره أن لم تكن سمراته % نخلا يلقحه ذوو التلقيح % 8(@)(@@) % حل العصاب عن الذين يليهم % وأدر بالإبساس والتمسيح % 9(@)(@@) % وأراح من أهل الفداء فأصبحت % غاراتهم مأمونة التصبيح % 10(@)(@@) % إلا يزح علل الرعية عدله % فيهم فما شيء لها بمزيح % PageV01P1072 11(@)(@@) % ولقد بلاه إمامه وأميره % % فكلاهما ألفاه حق نصيح % 12(@)(@@) % وأراه لا ينسى الوفاء لشدة % تنسي الوفاء ولا لفترة ريح % % 13(@)(@@) % كم ضربة رعلاء بل كم طعنة % نجلاء بل كم رمية إذبيح % 14(@)(@@) % خطرت بها كفاه دون إمامه % % في ظل يوم للأكف مطيح % 15(@)(@@) % سائل بذلك عنه حرب 
ms285	 المهتدي % % وكباشها من ناطح ونطيح % 16(@)(@@) % فلتخبرنك عن جلاد مغامس % ولتخبرنك عن طراد مشيح % 17(@)(@@) % ولتخبرنك عن نضال مطمح % % باليثربية أيما تطميح % 18(@)(@@) % ممن إذا حفز السهام بقوسه % % فحت أفاعيهن أي فحيح % 19(@)(@@) % أعطى الكريهة حقها عن غيره % وكفى كفاح الموت كل كفيح % 20(@)(@@) % والحرب تعذم بالسيوف مدلة % دلا على الخطاب غير مليح % PageV01P1073 21(@)(@@) % صعب إذا صعبت عليه قرينة % حتى تسمح أيما تسميح % 22(@)(@@) % فإذا القرينة سمحت لم يولها % % خلقا من الأخلاق غير سحيح % 23(@)(@@) % خلقت يداه يد لتجرح في العدا % % ويد لتأسو جرح كل جريح % 24(@)(@@) % وإذا ارتأى رأيا فأثقب ناظر % نظرا وأبعده مدى تطريح % 25(@)(@@) % تبدي له سر الغيوب كهانة % يوحي بها رئي كرئي سطيح % 26(@)(@@) % سبقت بحنكته التجارب فطرة % كالشوكة استغنت عن التنقيح % 27(@)(@@) % لولا أبو الصقر الفسيح خلائقا % أضحى فسيح الأرض غير فسيح % 28(@)(@@) % رحبت به الدنيا على سكانها % % من بعدما كانت كحظ ضريح % 29(@)(@@) % طلق المحيا واليدين سميدع % سهل المباءة ذو عراض فيح % 30(@)(@@) % نهك الحياء جفونه وكلامه % فغدا مريضا في ثياب صحيح % PageV01P1074 31(@)(@@) % لا من قراف دنية لكنه % % كرم بلا مذق ولا تضييح % 32(@)(@@) % تبدو لسائله صفيحة وجهه % % وكأنها سيف بكف مليح % 33(@)(@@) % وكأن فيه أريحية نشوة % من قهوة ترخي الإزار قديح % 34(@)(@@) % أعلى المحامد بعد رخص إنه % % يبتاع كاسدها بكل ربيح % 35(@)(@@) % بذل الكرائم في المكارم تاجر % جلت تجارته عن الترقيح % 36(@)(@@) % حام حقيقه مبيح ماله % ناهيك من حام به ومبيح % 37(@)(@@) % يعطي اللها إعطاء سمح باللها % % لحز على الحسب التليد شحيح % 38(@)(@@) % إلا يتح صرف الزمان لماله % حينا يتحه دون كل متيح % % 39(@)(@@) % أضحت حياض المعطشين بجوده % % فهفت جوانبها من التطفيح % 40(@)(@@) % وردوا مناهله فماحوا واستقوا % % منهن أعذب مستقى ومميح % % PageV01P1075 41(@)(@@) % لو أنه وسم الرياض بجوده % أمنت حدائقها من التصويح % 42(@)(@@) % ذو صورة قمرية بشرية % تستنطق الأفواه بالتسبيح % % 43(@)(@@) % وإذا تأمل نفسه لم يقتصر % منها على التصوير والتشبيح % 44(@)(@@) % حتى يزينها بزينة ماجد % ليست بتطويق ولا توشيح % 45(@)(@@) % برعت محاسنه فأقسم صادقا 
ms286	 % أن لا يعرضهن للتقبيح % 46(@)(@@) % لكن لتلويح الهواجر طالبا % إسفارهن بذلك التلويح % % 47(@)(@@) % ما زال يبعث بالعطاس ركابه % % ويروع قائلهن بالترويح % 48(@)(@@) % وتقود كل نوى شطون همة % ونوى الكريم بعيدة التطويح % 49(@)(@@) % حتى تعمم بالسيادة ناشئا % ولذاك رشحه ذوو الترشيح % 50(@)(@@) % عشق العلا وعشقنه فكأنما % % وافى هوى لبنى هوى ابن ذريح % PageV01P1076 51(@)(@@) % وهبت له القلم المعلى همة % رفضت من الأقلام كل منيح % 52(@)(@@) % لم أمتدحه لخلة ألفيتها % % في مجده فسددتها بمديح % 53(@)(@@) % لكن لكي تزهى محاسن وصفه % شعري فيحسن منه كل قبيح % 54(@)(@@) % خبرت شعري باسمه إن اسمه % في الشعر كالتحبير والتسبيح % 55(@)(@@) % لما رأيت الشعر أصبح خاملا % نبهته بفتى أغر صريح % 56(@)(@@) % لا يضرب الركب الطلائح نحوه % بل باسمه يزجون كل طليح % 57(@)(@@) % تحدى الركاب بذكره فترى الحصى % % من بين منجول وبين ضريح % 58(@)(@@) % ويهز كل مبلد أعطافه % % طربا كفعل الشارب المريح % 59(@)(@@) % من بعد ما انتقيت أواخر مخه % % وخوت محاجره من التقديح % 60(@)(@@) % ثقة بسيب منه ليس يعوقه % % مهما جرى من سانح وبريح % PageV01P1077 61(@)(@@) % ملك إذا الحاجات شد عقالها % % وثقت لديه بعاجل التسريح % 62(@)(@@) % مما تراه الدهر يصدر واردا % عن نائل قبل السؤال نجيح % 63(@)(@@) % يا من إذا التعريض صافح سمعه % غني العفاة به عن التصريح % 64(@)(@@) % أشكو إليك خصاصة وتجملا % قد برحا بي أيما تبريح % 65(@)(@@) % لتصون وجهي عن وجوه وقحت % بالرد توقيحا على توقيح % 66(@)(@@) % سئلت وقد سالت ففي صفحاتها % % للرد تكديح على تكديح % % 67(@)(@@) % يا من أراح عوازب الشعر التي % % لولاه أعزبهن كل مريح % 68(@)(@@) % أنطقت مفحمنا فأصبح شاعرا % وأعرت أعجمنا لسان فصيح % 69(@)(@@) % بلها فتحن لها الرجال فكلهم % ذو منطق سلس عليه سريح % % 70(@)(@@) % أحييت ميت الشعر بعد ثوائه % في الرمس تحت جنادل وصفيح % PageV01P1078 71(@)(@@) % حتى لقال الناس فيك فأكثروا % % هذا المسيح ولات حين مسيح % PageV01P1079 البحر : - 1(@)(@@) % أراها فأزداد اشتياقا وصبوة % وإن نزحت فالموت دون نزوحها % % 2(@)(@@) % فليس شفاء النفس مما أحبه % % لعفراء إلا لز روحي بروحها % % PageV01P1080 البحر : - 1(@)(@@) % ألا ليست الدنيا بدار فلاح 
ms287	 % بعينيك صرعاها مساء صباح % % 2(@)(@@) % لنا من كلا العصرين ساق كلاهما % % يدور فيسقينا بكأس ذباح % 3(@)(@@) % أراني وأمي بعد فقدان أختها % % وإن كنت في رفه بها وصلاح % % 4(@)(@@) % كفرخ قطاة الدو بان جناحها % % فبات إلى حصن بغير جناح % PageV01P1081 البحر : - 1(@)(@@) % قل للذي أعجبت محاسنه % وعجبت فهي للورى سبح % 2(@)(@@) % ومن غدا والنوال من يده % يطلب والرأي منه يقتدح % 3(@)(@@) % حرم مدحي عليك أنك تستأ % هل ما لا تطيقه المدح % 4(@)(@@) % وساق مدحي إليك أن جوا % % باتك عند المدائح المنح % 5(@)(@@) % أقبل بي إنني رأيتك أقبل % % ت على الشعر وهو مطرح % 6(@)(@@) % قدرت أن تنفق الزيوف على % % طولك لا أن يزيف الوضح % 7(@)(@@) % وأنت ذاك الذي به انفسح الضي % % ق لا من ضاقت به الفسح % 8(@)(@@) % مفتاحك العفو لا التشدد بل % لست بمستغلق فتفتتح % PageV01P1082 البحر : - 1(@)(@@) % استقبل المهرجان بالفرح % فقد مضت عنك دولة الترح % 2(@)(@@) % وحي ندمانك المساعد بالنر % جس بين الإبريق والقدح % 3(@)(@@) % واسمع من المسمعات فيك وهل % تسمع إلا ما فيك من مدح % % 4(@)(@@) % يا مشبه المهرجان مفتتحا % من دولة الغيث خير مفتتح % 5(@)(@@) % كل إذا ما اصطبحت مصطبح % من جود كفيك خير مصطبح % 6(@)(@@) % عمرك الله في السرور وأع % لاك بتلك العلا عن المدح % 7(@)(@@) % يا من إذا عددت محاسنه % نابت لأعدائه عن السبح % 8(@)(@@) % فاقترح المطربات معتقدا % أنك للسؤل خير مقترح % 9(@)(@@) % ما اقترح السؤل مثلك ابن أبي % % بكر لما نرتجي من المنح % 10(@)(@@) % ولا انتقدنا على تأنقنا % % مثلك يا ذا الخلائق الوضح % % PageV01P1083 11(@)(@@) % فاطرب على ذاك عند مغتبق % واطرب على ذاك عند مصطبح % % PageV01P1084 البحر : - 1(@)(@@) % قل للحكيم أبي الحسين ومن جلا % ليل الشكوك عن القلوب فأصبحا % % 2(@)(@@) % وتتبع الإخوان ينعش عثرة % منهم ويستر عورة أن تفضحا % % 3(@)(@@) % لله أنت لسائل ومسائل % ما أسرح الرفدين منك وأنجحا % % 4(@)(@@) % أنت الذي إن قيل جد غمر المنى % % بنواله أو قيل أوضح أوضحا % % 5(@)(@@) % ما إن تزال منورا ومنولا % كالغيث أبرق في الظلام وسحسحا % % 6(@)(@@) % تزجيه ريح وكلت بشؤونه % تذكي 
ms288	 سناه وتمتريه ليسفحا % % 7(@)(@@) % فيشب آونة بروقا لمحا % ويصب آونة غروبا نضحا % % 8(@)(@@) % متضمنا كشف الغيوب وتارة % سح السيوب دوافقا لا رشحا % % 9(@)(@@) % وأقول إنك حين تدأب دأبة % أروى لمستسق وأورى مقدحا % % 10(@)(@@) % ما زلت قبل العشر أو لكمالها % % تعلو العلاة وتستخف الرجحا % % PageV01P1085 11(@)(@@) % مسترفدا ضخم اللها مسترشدا % جم النهى مستمنحا مستفتحا % % 12(@)(@@) % عرفا ومعرفة تبجح معشر % عدموهما وعلوت أن تتبجحا % % 13(@)(@@) % أسمى من أمر الإله بذبحه % حتى إذا أشفى نهى أن يذبحا % % 14(@)(@@) % فز فوزه واسعد بمثل نجاته % % ووقاك شانئك البوار المجوحا % % 15(@)(@@) % مع أنه ذبح يقصر قدره % عن أن يقوم مقام كبش أملحا % % 16(@)(@@) % متخير لا للزكاء ألية % لكن ليجرح دون نفسك مجرحا % % 17(@)(@@) % فاعذر أخاك وإن فداك بتافه % محض الخساسة طالبا لك مصلحا % % 18(@)(@@) % لولا هواي ردى عدوك لم أكن % أرضى لفديتك الأخس الأوتحا % % 19(@)(@@) % أكرم بنائلك الذي أمتاحه % عن أي ما ضرع وذل زحزحا % % 20(@)(@@) % لو لم تصن وجهي به وتكفه % أمسى وأصبح بالهوان ملوحا % % PageV01P1086 21(@)(@@) % أعفيت وجه محرم لم يعتقد % % وفرا ولم يك بالسؤال موقحا % % 22(@)(@@) % أبصرت عودي عاريا فكسوته % وقد التحى منه زماني ما التحى % % 23(@)(@@) % لا أستزيدك غير إذنك أن ترى % % مدحي عليك محبرا ومسيحا % % 24(@)(@@) % بدأ امتنانك فاهتززت ورعتني % % عن نشر ما تسدي فمدت مرنحا % % 25(@)(@@) % من ترحة كادت تكدر فرحة % وأراك تكره أن أعيش مترحا % % 26(@)(@@) % وإذا أبيت الشكر من متقبل % جدوى يديك حميته أن يفرحا % % 27(@)(@@) % ومتى رددت القيل في فم قائل % لفح الفؤاد وحقه أن يلفحا % % 28(@)(@@) % هي ضربة بالسيف إلا أنه % % سيف ضربت به وليك مصفحا % % 29(@)(@@) % وإذا ضربت بصفح سيفك صاحبا % خاف الشبا والموت فيه إن انتحى % % 30(@)(@@) % وكأن من عذل امرأ في مدحه % إياك من عذل امرأ إن سبحا % % PageV01P1087 31(@)(@@) % قل لي وقد أيقنت أني عارف % % بالحق معطى في البلاغة مندحا % % 32(@)(@@) % أاميت ذكرى من حييت بفضله % % ورعيت بعد الجدب مرجا أفيحا % % 33(@)(@@) % ما ذاك في حكم الحكيم بجائز % % إن كان يعلم ما وعى مما وحى 
ms289	 % % 34(@)(@@) % أوليت صالحة وليتك لا تزل % % بالصالحات مبيتا ومصبحا % % 35(@)(@@) % وأمرته أن لا يفوه بذكرها % % في الناطقين وغير ذلك رشحا % % 36(@)(@@) % وإذ اصطنعت صنيعة وكتمتها % % وطويتها فجديرة أن تمصحا % % 37(@)(@@) % وكأنها عار تحاول ضرحه % عنا وما يسدى الجميل ليضرحا % % 38(@)(@@) % ما حق عرف لم يذعه وليه % أن يصمت المولاه بل أن يصدحا % % 39(@)(@@) % أولى بطول الجحد عرف مبخل % منانه رفض الفعال ورقحا % % 40(@)(@@) % يغشى فينبح كلبه دون القرى % % لؤما ويخرس كلبه مستنبحا % % PageV01P1088 41(@)(@@) % ولقد هممت بعلي عرفك طاعة % فغدت شواهده بسري بوحا % % 42(@)(@@) % إني أعيذك أن توهم حاسدا % أن قد طرحت ثناء حر مطرحا % % 43(@)(@@) % أغرست عندي نعمة وأمرتني % % ألا أذيع بها الثناء الأفصحا % % 44(@)(@@) % هيهات قد سمت الذي حاولته % نفسي فعز جموحها أن يكبحا % % 45(@)(@@) % إن التي أسديتها ريحانة % أنشأتها لا بد من أن تنفحا % % 46(@)(@@) % لا تعنتني بعد ملئك باطني % % شكرا بمنعك ظاهري أن يطفحا % % 47(@)(@@) % أعيا علي فلو أجمجم بينت % عنه حلاه ولو أعرض صرحا % % 48(@)(@@) % كفكف يديك عن النوال وبذله % حتى أكفكف مقولي أن يمدحا % % 49(@)(@@) % كلا لقد رمنا خلاف سبيلنا % % فغدا كلا الخيمين يجمح مجمحا % % 50(@)(@@) % لم أستطع كفرا كما لم تستطع % % بخلا ولم تجنح إليه مجنحا % % PageV01P1089 51(@)(@@) % ولو اهتبلت إذ زاولته % % لحسبت وديك الصريح مضيحا % % 52(@)(@@) % عجبا لمنعك مقولي من شأنه % ولقد جعلت له بفضلك مسرحا % % 53(@)(@@) % أأردت ترفيهي فلم يك فادح % أرجو به الزلفى لديك ليفدحا % % 54(@)(@@) % وأنا امرؤ أجد الثناء على الذي % % يوليني النعمى أخف وأروحا % % 55(@)(@@) % وأراك تحسب منطقي مستكرها % يأتي وقد كد الضمير وبرحا % % 56(@)(@@) % كلا ولو أضحى كذاك ورضته % بنداك أذعن لي هناك وسمحا % % 57(@)(@@) % هون عليك فإن مدحك مسعدي % % عفوا ولم أكدح بفكري مكدحا % % 58(@)(@@) % ما رمت بالميسور مدحك مرة % إلا رأيت وجوهه لي سنحا % % 59(@)(@@) % أم خلت أني إن مدحتك خلتني % % كافأت طولك حاش لي أن أطمحا % % 60(@)(@@) % فأروح أظهر شاهدا مستحسنا % مني وأبطن غائبا مستقبحا % % PageV01P1090 61(@)(@@) % إني إذا إن كان ذاك لكالذي % % لاقى بمبتسم وأضمر مكلحا 
ms290	 % % 62(@)(@@) % أم خفت إن جمعت لنفسي نعمتا % % حظ وشكر ناطق أن أمرحا % % 63(@)(@@) % تالله أنحو نحو ذلك ما هدى % % نفسي هداك وإن نحاه من نحا % % 64(@)(@@) % لا بل حقرت لي الجزيل من الجدا % % في جنب همتك البعيدة مطمحا % % 65(@)(@@) % ورأيت شكري فوق ما أوليتني % % فكرهت غبن مكاتب قد بلحا % % 66(@)(@@) % وكذا يرى من لا يزال إذا جرى % % مسحت به الأيدي جوادا أقرحا % % 67(@)(@@) % ولمثل وجهك لاح أول سابق % وغدا مفدى في الكرام ممسحا % % 68(@)(@@) % وعلي إذ أكبرت شكري أنني % % أبغي الزيادة فيه حتى أطلحا % % 69(@)(@@) % إن أبتسم عما فعلت فزينة % أولا فما واريت ثغرا أقلحا % % 70(@)(@@) % يفديك كتاب الملوك وإن لحا % % في ذاك من حساد فضلك من لحا % % PageV01P1091 71(@)(@@) % يا خيرهم نفسا وأنداهم يدا % وأجمهم علما وأرساهم رحى % % 72(@)(@@) % ما أغفل القلم الموشح خصره % يمناك عن كرم هناك توشحا % % 73(@)(@@) % قلم إذا جدح الدواة رأيته % لجميع ما تحت السياسة مجدحا % % 74(@)(@@) % تتحرك الأشياء بعد سكونها % % عند احتثاثكه ذنوبا أرسحا % % 75(@)(@@) % لله من قلم هناك إذا جرى % % أجرى المنافع والمضاير سيحا % % 76(@)(@@) % بيد امرىء إن شاء كان معسلا % يشفي الجوى أو شاء كان مذرحا % % 77(@)(@@) % يسقي به ماء الحياة وربما % % عادى فقلب منه صلا أفطحا % % 78(@)(@@) % تلقى هناك منجدا ومنجدا % تأتاله ومنقحا ومنقحا % % 79(@)(@@) % لو وازر الماء استفاد قوى الصفا % % جلدا ولو كاد الصفا لتضيحا % % 80(@)(@@) % كم من ذليل قد أعز وما اعتدى % % حقا وكائن من عزيز طحطحا % % PageV01P1092 81(@)(@@) % ما زلت مذ زايلت ظلك لابسا % ظل الندامة ضاحيا فيمن ضحا % % 82(@)(@@) % وأعد محمود العهود فلا أرى % % فيها كعهدك لا أمح ولا امحى % % 83(@)(@@) % ما كنت عند بليتي إذ شبهت % وجليتي إلا كذي سكر صحا % % 84(@)(@@) % أثني عليك بأن كل مطالب % % جدواك قد أضحى يلقب أفلحا % % 85(@)(@@) % وبأن عرضك لا يزال ممنعا % وبأن مالك لا يزال ممنحا % % 86(@)(@@) % ولقد أطاف بك البغاة ولم تكن % ورعا ولا عريض شر متيحا % % 87(@)(@@) % فلقوا وراء الحلم منك شكيمة % تثني المذاكي منهم والقرحا % % 88(@)(@@) % ورأوك مثل 
ms291	 الطود ليس بناطح % لكنه يوهي الرؤوس النطحا % % 89(@)(@@) % فاسلم وما يدعو بها إلا امرؤ % لم يدخر عن نفسه لك منصحا % % 90(@)(@@) % نصح المحب لك السلامة نفسه % % قسما وإياها بذاك استصلحا % % PageV01P1093 91(@)(@@) % وأراك في الغرر الثلاثة كل ما % % تهوى وإن ساء العداة الكشحا % % 92(@)(@@) % مليتهم حتى تحق كناهم % فترى بنيهم باكرين وروحا % % 93(@)(@@) % مستوسقين على سبيلك كلهم % يهدي ذوي عمه وينهض رزحا % % 94(@)(@@) % لا يعدمون مقالة من قائل % ما أحسن الصفحات والمتصفحا % % 95(@)(@@) % فتدرع اليوم القصير بأنسهم % وتعمر العمر الطويل مصححا % % 96(@)(@@) % من حيث لا مرر الطباع تنقضت % كبرا ولا ورق الشباب تصوحا % % 97(@)(@@) % لم لا نود لك البقاء منفلا % طول السلامة والمعاش الأفسحا % % 98(@)(@@) % وإذا أبى المسؤول إلا قول لا % للسائل استحييت أن تتنحنحا % % 99(@)(@@) % وإذا أجد جواد قوم في الندى % % ومزحت أنت فحسبنا أن تمزحا % % 100(@)(@@) % وإذا تأمل ناظر في خطة % ولمحت أنت فحسبنا أن تلمحا % % PageV01P1094 101(@)(@@) % يا سائلي بأبي الحسين وفضله % تكفيك جملة ذكره أن تشرحا % % 102(@)(@@) % أعجب بأنك تجتلي بشعيلة % وجه الصباح وقد بدا لك أجلحا % % 103(@)(@@) % ساءلته وسألته فوجدته % % كالبحر يعظم قدره أن ينزحا % % 104(@)(@@) % وتضحضحت حولي بحور جمة % وأبى ابن إبراهيم أن يتضحضحا % % 105(@)(@@) % لم ألق في غمرات قوم مشربا % ووجدت في ضحضاحه لي مسبحا % % 106(@)(@@) % من كان شبه لي وشبح باطلا % فسواه كان مشبها ومشبحا % % 107(@)(@@) % ما كان مثل الآل خيل لجة % ثم استغيث به فأبرز ضحضحا % % 108(@)(@@) % جبل بناه الله حول حريمه % ليحوط من يرعى ويثبت مادحا % % 109(@)(@@) % شهدت مآثره الجميلة أنه % % ممن تمكن في العلا وتبحبحا % % 110(@)(@@) % كم من علاء قد علاه لو ارتقى % % مرقاته أحد سواه تطوحا % % PageV01P1095 111(@)(@@) % باع المناعم بالمكارم رابحا % وابتاع حمد الحامدين فأربحا % % 112(@)(@@) % ملك الرقاب بفكها وبأنه % ما ملك الأحرار إلا أسجحا % % 113(@)(@@) % لا تغمر النعم الجلائل قدره % كلا ولا تزهاه حتى يمرحا % % 114(@)(@@) % لا بل تقاس بقدره فيطولها % % ألوى تصادفه الملابس شرمحا % % 115(@)(@@) % أضحت بمجد أبي الحسين وجوده % علل الممجد والمؤمل زوحا % % 116(@)(@@) % فإذا مدحت أصاب 
ms292	 مدحك ممدحا % وإذا منحت أصاب منحك ممنحا % % 117(@)(@@) % خذها نتيجة هاجس ألقحته % وبحقه نتج أمرؤ ما ألقحا % % PageV01P1096 البحر : - 1(@)(@@) % يا مانعي قوت جسمي % % ومانعي قوت روحي % % 2(@)(@@) % منعتني من سلامي % % عليك حين صبوحي % % 3(@)(@@) % ومن سروحي فيما % % تنيل حين سروحي % % 4(@)(@@) % جرحت حالي وقد كن % ت آسيا لجروحي % % PageV01P1097 البحر : - 1(@)(@@) % لك ريحان وراح % ومجيدات ملاح % 2(@)(@@) % كمها الرمل تناغي % % هن أوتار فصاح % 3(@)(@@) % وألذ العيش ما في % % ه صبوح وصباح % 4(@)(@@) % وسماع معبدي % % لم يجاوزه اقتراح % 5(@)(@@) % وغزال ذو دلال % % كله داح وماح % 6(@)(@@) % هو دعص وهو غصن % تتهاداه الرياح % % 7(@)(@@) % فمقباه رشيق % ومخباه رداح % 8(@)(@@) % لي إلى ذاك ارتياح % وعليه مستراح % 9(@)(@@) % أيها العاذل لا أخ % طأك الحين المتاح % 10(@)(@@) % إن يكن عندك لي نص % ح فما عندي انتصاح % PageV01P1098 11(@)(@@) % لا تلمني فالهوى في % % ه جماح وطماح % 12(@)(@@) % أفتلحاني وتحتي % % مركب فيه جماح % 13(@)(@@) % ما على المفتون فيما % % غلب الصبر جناح % 14(@)(@@) % كل شيء غلب الصب % ر إليه فمباح % 15(@)(@@) % إنما الدنيا ملاه % % واغتباق واصطباح % 16(@)(@@) % والمزاح الجد إن فك % رت والجد المزاح % 17(@)(@@) % إن يكن عندك لب % فأقاويلي صحاح % 18(@)(@@) % مثل ما صح لعبد ال % له في الناس السماح % 19(@)(@@) % ليس فيما قلت شك % كشف الليل الصباح % 20(@)(@@) % ماجد يحمي لديه % حسب محض صراح % PageV01P1099 21(@)(@@) % وحريم المال مذ كا % % ن لديه مستباح % PageV01P1100 البحر : - 1(@)(@@) % ألا يا أيها الشاك % ر والمطنب في المدح % 2(@)(@@) % لئن أبدى أبو عيسى % % لأهل الصفح والمنح % 3(@)(@@) % فأمل خير مأمول % لحمل الثقل ذي الفدح % 4(@)(@@) % ورده الغب والرفه % فحاشاه من النزح % 5(@)(@@) % ومن أن يرجع المات % ح عنه خائب المتح % 6(@)(@@) % فتى نزهه الله % % عن التقبيح والقبح % 7(@)(@@) % لنا في مدحه سبح % طويل أيما سبح % 8(@)(@@) % غدا الشعر لنا سمحا % بحمد السيد السمح % 9(@)(@@) % نأتي فيه إسجاحا % بلا كد ولا كدح % 10(@)(@@) % ولولاه لما دان % ولا لان على المسح % PageV01P1101 11(@)(@@) % حبا الله أبا أدا % % ه بالنصر وبالفتح % 12(@)(@@) % ولا أعراه من عيش % كظل السدر 
ms293	 والطلح % 13(@)(@@) % بما يجبر من كسر % وما يدمل من جرح % 14(@)(@@) % فقد أضحى به الملك % محوطا آمن السرح % 15(@)(@@) % وزير ناصح الجيب % % نقي الصدر والكشح % 16(@)(@@) % حليم راجح الحلم % % حمي صادق الضرح % 17(@)(@@) % علت حالاه من سخط % ومرضاة عن المزح % 18(@)(@@) % فما يضرم بالنفخ % ولا يطفأ بالنضح % 19(@)(@@) % وكم في السيف من لين % % وكم في السيف من ذبح % 20(@)(@@) % فقولا للذي أصب % ح ذا حطب وذا قدح % PageV01P1102 21(@)(@@) % هناة يتلقاها % % وزير الصدق بالصفح % 22(@)(@@) % ألا أهون على البدر % بكلب لج في النبح % 23(@)(@@) % ولا يخرج ذوو الجهل % من الجري إلى الجمح % 24(@)(@@) % فيلقى المتمادون % لجاما صادق الكبح % % 25(@)(@@) % نهت عن نفسها النار % بما فيها من اللفح % 26(@)(@@) % ولا يغتر مغتر % من الطوفان بالرشح % 27(@)(@@) % تصبح رامي الليل % بمن ترميه أو أضح % 28(@)(@@) % ولا تستضعف الحلم % فيلحى منك مستلحى % % 29(@)(@@) % حذار الحلم إن الحل % م ذو أسو وذو جرح % 30(@)(@@) % وقد ترسو مراسيه % وقد تجري له أرحي % % PageV01P1103 31(@)(@@) % وما عند الرحى بقيا % % إذا دارت على القمح % 32(@)(@@) % غدا صاعد الصاع % د يعلو منتهى اللمح % % 33(@)(@@) % هو الطود الذي أضحى % % عتاد الناس للبرح % 34(@)(@@) % فآو منه في كهف % وراع منه في سفح % 35(@)(@@) % فمهلا أيها الكا % % ئد ذاك الطود بالنطح % % 36(@)(@@) % فرأس الناطح الصفوا % % ن أدنى منه للرضح % PageV01P1104 البحر : - 1(@)(@@) % ومدامة أغنت عن المصباح % يلقى المساء إناؤها بصباح % 2(@)(@@) % لطفت مسالكها وخص محلها % % فكأنها انشقت من الأرواح % 3(@)(@@) % تجلو السرور على الفتى في قلبه % % والحسن في الكاسات والأقداح % 4(@)(@@) % أعلي لا أخطأت قصد سبيلها % % ورزقت فيها طاعة النصاح % 5(@)(@@) % أعلي لا فارقت ظل سعادة % أبدا ولا أخطأت باب فلاح % 6(@)(@@) % بكر الشباب على الحياة وليته % بعد البكور مساعف برواح % 7(@)(@@) % هيهات إلا بالشمول فإنها % % نافي الهموم وجالب الأفراح % 8(@)(@@) % فامزج غناء المحسنات لكأسها % % بغناء عجم في الجنان فصاح % 9(@)(@@) % تهتز من طرب إذا ما هزها % % فوق الغصون الخضر نفح رياح % 10(@)(@@) % خذها ولا تخسر لذيذ مذاقها % % ونسيمها يا طالب الأرباح % PageV01P1105 11(@)(@@) % بكرا 
ms294	 ترد على الكبير شبابه % % فتراه بين صبابة ومراح % 12(@)(@@) % حسناء تكسو من محاسنها الفتى % % فتراه أحمر أزهر المصباح % 13(@)(@@) % من كرمة تهب المكارم للفتى % % فتراه بين شجاعة وسماح % 14(@)(@@) % وتعير نكهتها نديم أحبة % فيقبل التفاح بالتفاح % 15(@)(@@) % تالله ما أدري لأية علة % % يدعونها في الراح باسم الراح % 16(@)(@@) % ألريحها ولروحها تحت الحشى % % أم لارتياح نديمها المرتاح % 17(@)(@@) % شاهدت منها مشهدا فرأيته % % حسنا مليحا بين سرب ملاح % 18(@)(@@) % حسدت قيانا كالظباء ونرجسا % غضا على صور هناك صباح % % 19(@)(@@) % فتغللت من تبرها بغلالة % وتوشحت من درها بوشاح % % 20(@)(@@) % فإذا بها محسودة معبودة % بين الضرائر جمة المداح % PageV01P1106 21(@)(@@) % عدل المحلل والمحرم شربها % % ولذي المقال مذاهب في الراح % 22(@)(@@) % إن حرمت فبحقها من حرة % ما كان مثل حريمها بمباح % 23(@)(@@) % أو حللت فبحقها من نشرة % % تنفي سقام قلوبنا بصحاح % 24(@)(@@) % أو لا يحرمها الحليم لأنها % % تدع القباح لديه غير قباح % 25(@)(@@) % أو لا يحللها الكريم لأنها % % تحذي الهدان سجية المرتاح % 26(@)(@@) % دع ذا وقل في آل شيخ إنهم % % أقصى مطامح همة الطماح % 27(@)(@@) % لا تعدلن بآل شيخ معشرا % فهم الشفاء لغلة الملتاح % 28(@)(@@) % أعددهم للنائبات فإنهم % حسب المعد غداة كل شياح % 29(@)(@@) % وافتح مغاليق الأمور بأيدهم % أو كيدهم فكفاك من مفتاح % 30(@)(@@) % قوم يرون النصح في أموالهم % % غشا فقد سخطوا على النصاح % PageV01P1107 31(@)(@@) % زرهم على ثقة مزار محصل % مالا فلست كضارب بقداح % 32(@)(@@) % واعلم بأن سنيحهم لك سانح % أبدا وليس بريحهم بمتاح % 33(@)(@@) % فمتى أطرت لهم بريح عداوة % فلك البريح وأبرح الأبراح % 34(@)(@@) % من معشر قرن الثناء لديهم % % بالجود والملكات بالأسجاح % 35(@)(@@) % لم يمنعوا الشاكين ريب زمانهم % % أذنا ولا سمعوا ملامة لاحي % % 36(@)(@@) % يا ليت شعري حين يمدح مثلهم % % ماذا تراه يراد بالتمداح % 37(@)(@@) % لكنهم كالمسك طاب لعينه % % ويزيد حين يخاض بالمجداح % 38(@)(@@) % يعطون عفوا كلما أعفيتهم % % ويلح نائلهم على الإلحاح % 39(@)(@@) % وعطاؤهم فوق العطاء لأنهم % يعطون كسب مناصل ورماح % 40(@)(@@) % وكأن من أعطاك كسب سلاحه % % أعطاك مهجته بغير سلاح % PageV01P1108 41(@)(@@) % جاءته في تعب 
ms295	 وعسرة مطلب % % وأتتك في دعة به وسراح % % 42(@)(@@) % ولما حباك بحظه لجهالة % لكن لفضل ممنح مناح % % 43(@)(@@) % فمتى يرون من الشحاح على اللها % % وهم على الأرواح غير شحاح % 44(@)(@@) % من بأسهم يقع الردى وبحلمهم % % تتماسك الأرواح في الأشباح % % 45(@)(@@) % كالهندوانيات حد مضارب % عند اختبارهم ولين صفاح % 46(@)(@@) % أضحى الورى قيضاهم أمحاحه % % شتان بين القيض والأمحاح % 47(@)(@@) % وبسيد الأمراء أنجح سعيهم % فيما ابتغوا من ذاك أي نجاح % 48(@)(@@) % لله أحمد بن شيخ إنه % % مأوى الطريد ومورد الممتاح % 49(@)(@@) % الدهر يفسد ما استطاع وأحمد % يتتبع الإفساد بالإصلاح % 50(@)(@@) % ما زال يقدح في الدجى بزناده % % حتى رأى الإمساء كالإصباح % PageV01P1109 51(@)(@@) % أما الندى فندى غرير ناشيء % % والرأي رأي محنك جحجاح % % 52(@)(@@) % فكأنه للأريحية شارب % وكأنه للألمعية صاحي % % 53(@)(@@) % ملك له قبل السؤال وبعده % % بدء الجواد وعودة المسماح % 54(@)(@@) % ومن الملوك ذوي المواهب من له % % بدء الجواد وعودة المدلاح % 55(@)(@@) % لا تعرضن لغمرة من سيبه % % إن لم تكن بطلا من السباح % 56(@)(@@) % فالبر يهلك في مضيق فنائه % % والبحر يغرق منه في الضحضاح % 57(@)(@@) % أنذرت بل بشرت أن مقالتي % % ميعاد جد في وعيد مزاح % 58(@)(@@) % ضمن إذا حصل الوفاء بما وأى % % عنه الرجاء ثناه بالإرجاح % % 59(@)(@@) % ما إن يزال مساجلا لسحائب % % بعطائه ومباريا لرياح % % 60(@)(@@) % غرس الرجال بسيفه واجتاحهم % لا فل سيف الغارس المجتاح % % PageV01P1110 61(@)(@@) % سيف مليء عرفه ونكيره % بإقامة المداح والأنواح % 62(@)(@@) % يحيي ويهلك في يدي ذي قدرة % وسمته بالسفاح والنفاح % 63(@)(@@) % مداح معمل مضربيه بمنشد % حفل وأنواح العدا بمناح % 64(@)(@@) % فمتى استكنوا من نداه وبأسه % فالمستكن هناك في قرواح % % 65(@)(@@) % طوفان معروف ونكر مانجا % % أحد تعوذ منهما بوجاح % % 66(@)(@@) % فإذا تبسل للعدا في مأقط % % أبصرت سطوة قابض الأرواح % % 67(@)(@@) % وإذا أراك نداه يوما زهده % أبصرت زهد محالف الأمساح % 68(@)(@@) % وإذا أشار أو ارتأى في خطة % أبصرت حكمة صاحب الألواح % 69(@)(@@) % وإذا أراك مزاحه من جده % أجناك صفو ودائع الأجباح % 70(@)(@@) % ليقل عفاتك لا جناح عليهم % رفع الجناح فلات حين جناح % PageV01P1111 71(@)(@@) % أنت امرؤ للصدق 
ms296	 فيه مذاهب % % سقط الجناح بها عن المداح % 72(@)(@@) % ما زال من يطري سواك ملاحيا % لكن من يطريك غير ملاحي % % 73(@)(@@) % في مدح غيرك للخطيئة مثبت % لكن مدحك للخطيئة ماحي % % 74(@)(@@) % فالباكرون على ثنائك إنما % % بكروا وما شعروا على مسباح % 75(@)(@@) % كم عارض رجلا علي مشبها % % لأميل عنك إليه بالأمداح % 76(@)(@@) % ردت نصيحته عليه فكافحت % أسرار جبهته أشد كفاح % 77(@)(@@) % وقصبت صاحبه إليه كأنما % % قاومته فيه مقام فضاح % 78(@)(@@) % ما قست بينكما هناك ولم أكن % % لأقيس بين محمد وسجاح % 79(@)(@@) % الناس أدهم أنت فيه غرة % مرفوعة عن سائر الأوضاح % % 80(@)(@@) % لا جف واديك المحلل إنه % % لمناخ أطلاح على أطلاح % % PageV01P1112 81(@)(@@) % إن الذي يضحي وأنت جناحه % في النائبات لناهض بجناح % % 82(@)(@@) % شام ابتسامك مرتجوك فإنما % % شاموا مضاحك مبرق لماح % % 83(@)(@@) % ومرى نوالك معتفوك فإنما % % حلوا عزالي مغدق نضاح % % PageV01P1113 البحر : - 1(@)(@@) % بؤسا لوهب ماله % بين الخليقة قد فضح % 2(@)(@@) % كثر الألى يهجونه % % جدا وقل الممتدح % 3(@)(@@) % قد سيروه بضرطة % في الخافقين وما برح % 4(@)(@@) % حتى كأن لم يجترح % ما جاء منه مجترح % 5(@)(@@) % يا وهب أقسم بالمقا % % م وبالحطيم إذا مسح % 6(@)(@@) % لو كنت مبذول الندى % % من قبلها لم تفتضح % 7(@)(@@) % لكن رفضت العرف مط % طرحا وحظك تطرح % 8(@)(@@) % وربحت مالك ضلة % والعرض أفضل ما ربح % 9(@)(@@) % لو كنت غيثا صائبا % لم يهج رعدك بل مدح % PageV01P1114 البحر : - 1(@)(@@) % ازجر القلب إذا القلب جمح % واردع الطرف إذا الطرف طمح % 2(@)(@@) % واصرف النفس إلى عدنية % ذات غنج ودلال ومرح % 3(@)(@@) % زانها الله بخد مشرق % لو مشى الذر عليه لجرح % % 4(@)(@@) % لو بدت غرتها من خدرها % % قلت برق في ذرا المزن لمح % % 5(@)(@@) % أو رآها البدر في مطلعه % لاكتسى ذلا وهونا وافتضح % 6(@)(@@) % فاز من عاطت يداها يده % عاتق الراح بكأس وقدح % 7(@)(@@) % ببنان كمداري فضة % طرفت بالنور في مجرى السبح % 8(@)(@@) % كلما سر بها قالت له % % زادك الله سرورا وفرح % % 9(@)(@@) % يا حبيبي ومدى أمنيتي % % بك زاد العيش طيبا وصلح % 10(@)(@@) % وهما في روضة عدنية 
ms297	 % يفسح الطرف مداها ما انفسح % % PageV01P1115 11(@)(@@) % تتغنى الطير في حافاتها % % بلحون تدع القلب فرح % 12(@)(@@) % ونسيم الريح يهدي لهما % % نفحات الورد من تلك الفسح % 13(@)(@@) % عوضت عيناهما قرتها % % ثمن الدمع الذي كان سفح % 14(@)(@@) % هاكها درية منظومة % شاكل الخاتم منها المفتتح % PageV01P1116 البحر : - 1(@)(@@) % أبشر بفتح لك مفتوح % من نافح بالخير منفوح % 2(@)(@@) % واشرب على النرجس مقدوحة % في الكأس لم تطبخ بمقدوح % 3(@)(@@) % كأنها بالمسك مجدوحة % بل هي مسك غير مجدوح % 4(@)(@@) % بين ندامى كلهم جامح % ليس عن الغي بمكبوح % 5(@)(@@) % زفاقهم في الدار مبطوحة % وعودهم ليس بمبطوح % 6(@)(@@) % أجوف مرنان ومملوءة % أعذب مكروع ومنشوح % 7(@)(@@) % من بين مذبوح لنا جودهم % وبين حي غير مذبوح % 8(@)(@@) % يا حبذا النرجس ريحانة % لأنف مغبوق ومصبوح % 9(@)(@@) % كأنه من طيب أرواحه % ركب من روح ومن روح % 10(@)(@@) % أبدى وجوها غير مقبوحة % في زمن ليس بمقبوح % PageV01P1117 11(@)(@@) % يا حسنه في العين يا حسنه % % من لامح للشرب ملموح % % 12(@)(@@) % كأنما الطل على نوره % ماء عيون غير مطروح % 13(@)(@@) % لو شاهد الورد أحايينه % لو تر وردا غير مسفوح % 14(@)(@@) % أما ترى الحمرة في وجهه % تنطق عن حجلة مفضوح % 15(@)(@@) % ميلا عن الورد إلى سيد % من سادة الريحان ممدوح % 16(@)(@@) % كأنما تنشر أيامه % من بين مطلول ومنضوح % 17(@)(@@) % ما ينشر المداح عن قاسم % % من مجمل فيه ومشروح % 18(@)(@@) % واها لأنفاس له في الدجى % % وعند ممشى النور في اللوح % 19(@)(@@) % قاسم يا قاسم أمواله % لا زلت بحرا غير منزوح % 20(@)(@@) % أنت الذي لم يلقه ناظر % إلا بقدوس وسبوح % PageV01P1118 21(@)(@@) % ولا تعداه وأسبابه % بالميل إلا كل متروح % % 22(@)(@@) % ولا رأينا المدح في غيره % % إلا سواما غير مسروح % 23(@)(@@) % ولا انثنى مبضع تمجيده % إلا بربح منه مربوح % 24(@)(@@) % طوفان نوح دون هذا الندى % % فابقى بقاء المصطفى نوح % 25(@)(@@) % محملا في دعة حاملا % ثقل المعالي غير مفدوح % 26(@)(@@) % لا يعدم الناس جدا مانح % % للعرف واستبشار ممنوح % 27(@)(@@) % تجرح في مالك للمجتدى % % من دون عرض غير مجروح % 28(@)(@@) % يا آل وهب بات أعداؤكم 
ms298	 % % من بين مبرح ومشبوح % 29(@)(@@) % ولا خلا ضد لكم ناطح % من ناطح يودي بمنطوح % 30(@)(@@) % ولا خلا حظ لكم منفس % من كاشح في ثوب مكشوح % PageV01P1119 31(@)(@@) % ومات حسادكم حسرة % من بين مسيوف ومرموح % 32(@)(@@) % أصبحت الدنيا بكم هشة % مرتاحة فياحة السوح % 33(@)(@@) % مأوى لجار غير مستهلك % مثوى لضيف غير منبوح % 34(@)(@@) % ليلجأ الناس إلى ظلكم % % أدى نصيح حق منصوح % PageV01P1120 البحر : - 1(@)(@@) % مديحك من تعفوه تحسب رفده % منيعا متى لم ترقه بالمدائح % 2(@)(@@) % بفيشة مملوة ء تستسلحه % % مفسدة تحسبها تستصلحه % % 2(@)(@@) % وتارة على القفا اسطحه % % أسوه من أدواته وأجراحه % % 2(@)(@@) % أبركه طورا أبطحه % % وتارة للجنب لا أروحه % % 2(@)(@@) % رب غلام وجهه لا يفضحه % % في بيت عز لا يرام مسرحه % % 2(@)(@@) % ومن ظن بالممدوح ذاك فإنه % % بنيته هاج له غير مادح % PageV01P1121 البحر : - 1(@)(@@) % إن كنت ضنا بي عتبت لأنني % % أخللت فاقصد في العتاب واسجح % 2(@)(@@) % لا تفسدني بالتعسف بعدما % % بلغ التألف غاية المستصلح % 3(@)(@@) % واعلم بأني إن أسأت جناية % وأسأت أنت رعاية لم ترجح % 4(@)(@@) % أربح معاملك التساهل عاليا % عن أن تعد معاملا لم يربح % PageV01P1122 البحر : - 1(@)(@@) % رأيتك لا تلذ بطعم شيء % % تطعمه سوى طعم السماح % 2(@)(@@) % وما يهدى إليك من امتياح % أحب إليك من كل امتداح % 3(@)(@@) % فما بالي أقوم متن شعري % % إذا يممت بابك لامتياح % 4(@)(@@) % ولكني ألقي العرف عرفا % وليس على المكافىء من جناح % PageV01P1123 البحر : - 1(@)(@@) % حرك مناك إذا همم % ت فإنهن مراوح % 2(@)(@@) % لا تيأسن فإن رز % ق الله غاد رائح % PageV01P1124 البحر : - 1(@)(@@) % أجعفر حزت جميع العيوب % فما فيك من خلة تمدح % 2(@)(@@) % كلامك أكذب من يلمع % يخيله بالضحى صحصح % 3(@)(@@) % وحلمك أطيش من ريشة % % وروحك من هضبة أرجح % 4(@)(@@) % ووجهك من وجه يوم الفرا % % ق في مقلتي عاشق أقبح % 5(@)(@@) % فما في حياتك لي مفرح % ولا في مماتك لي مترح % PageV01P1125 البحر : - 1(@)(@@) % لم يضحك الشيب في فوديه بل كلحا % % سم القبيح من الأسماء ما قبحا % % 2(@)(@@) % قلت علا الناس إلا أنت قلت لها % % كذاك يسفل عند الوزن 
ms299	 من رجحا % % 3(@)(@@) % علا سليمان بعد اليوم فاتئبي % % أن لا تريني بدار الهون مطرحا % % PageV01P1126 البحر : - 1(@)(@@) % الطرف يقطف من خديك تفاحا % % والثغر منك يمج المسك والراحا % % 2(@)(@@) % أصبحت للشمس شمسا غير آفلة % حسنا كما قمرا تمسي ومصباحا % % 3(@)(@@) % لا عذب الله ذاك الوجه منك وإن % عذبت بالهجر أجساما وأرواحا % % 4(@)(@@) % يا مغلقا كل باب منه عن فرجي % % تركت للسقم في أحشاي مفتاحا % % PageV01P1127 البحر : - 1(@)(@@) % حتى متى يوري سواي وأفتدح % حتى متى يعطى سواي وأمتدح % 2(@)(@@) % حتام لا شعري أمام المجتني % % فأحظ منه ولا وراء المطرح % 3(@)(@@) % كم أستميح المقرفين وأغتدي % % صفر الدلاء كأنني لم أستمح % 4(@)(@@) % تالله ما سمع الأنام بطالب % مثلي ولا رأوا امرأ مثلي اطرح % 5(@)(@@) % كم مكثر طالبت فدية عرضه % % فأباحني منه الذي لم أستبح % 6(@)(@@) % وإخال أني لو سطوت لقال لي % % لا تسلب السلب الكريم ولو جرح % 7(@)(@@) % وجوابه إن قال ذاك لجهله % % بل ذو النذالة لا يجود ولو ذبح % % 8(@)(@@) % يتعرض المتعرضون وأنتئي % % في ساحة المجد الفسيح وأنتدح % 9(@)(@@) % مستبقيا ماء الحياء لأنني % % أعتد ما يهمي دما لي قد سفح % 10(@)(@@) % ومن الوقاحة أن تكون معيشتي % % كسب القريض وليس لي وجه وقح % % PageV01P1128 11(@)(@@) % بكت الكرام إذا رأت مستنبحا % مثلي بأفنية اللئام وما نبح % 12(@)(@@) % يا راكبا وهمينياء قصاره % ثقلت كرة رابح في من ربح % 13(@)(@@) % تجلي أبا عبد الإله فقل له % % لا زلت تغتبق السرور وتصطبح % 14(@)(@@) % يا من إذا نشر الثناء على امرىء % ختم الثناء بذكره وبه فتح % 15(@)(@@) % أنا من عرفت صفاءه ووفاءه % % وغناءه وثناءه غير الوتح % 16(@)(@@) % ومن العجائب أن رزقي مغلق % ونداك مفتاح ولما أفتتح % 17(@)(@@) % كم قد هتفت وما أريد سواكم % برح الخفاء ولو عدلتم ما برح % 18(@)(@@) % يا معشر الإخوان طال عقوقكم % بأخ لكم غبق الجفاء كما صبح % 19(@)(@@) % أعريتموني من جداكم كله % وعريتم من كل عذر متضح % 20(@)(@@) % أيخيب تأميلكم وقرينه % شفقي عليكم والقوارع تنتطح % PageV01P1129 21(@)(@@) % عرج أبا عبد الإله وربما % % كف الجواد عن الجماح وما كمح % % 22 
ms300	(@)(@@) % إن كنت أزمعت نفعي محسنا % فأرح بسرعته وليك واسترح % 23(@)(@@) % واسدد به خللي ولما أنهتك % وأزح به عللي ولما أفتضح % 24(@)(@@) % ماذا أردت وقد وقفت بحاجتي % % وقفات مفدوح وظهرك ما فدح % 25(@)(@@) % أأهش من رجل برأيك يقتدي % % أأخف من رجل بكفك يتشح % 26(@)(@@) % هلا كتبت بحاجتي متفصلا % متطولا لتزيد في فرح الفرح % 27(@)(@@) % وجعلتها تبع الكتاب منازلا % في ذاك صاحبك السميع إذا نصح % 28(@)(@@) % بمودتيك وحرمتي بك أنها % % سبقت قرابتها بوجه ما قبح % 29(@)(@@) % امنح أبا العباس في نصيحة % تجدي علي فإنه لك منتصح % 30(@)(@@) % عرفه أني للصنيعة موضع % حمدا وشكرا لا يبيد ولا يمح % PageV01P1130 31(@)(@@) % ودليل شكري طول صبري إنه % % في طول شعري فيه علمي لو مسح % 32(@)(@@) % كم قد صبرت ونال غيري نيله % وفسحت في عذر وإن لم ينفسح % 33(@)(@@) % لا أجتديه ولا أريه زهادة % فيما لديه ولا أكف ولا ألح % 34(@)(@@) % وترى الصبور هو الشكور ولا ترى % % إلا الجزوع هو الكفور إذا منح % 35(@)(@@) % فأرح بفضلك إن بحرك لم يغض % واظفر بمدحي إن بحري ما نزح % 36(@)(@@) % واجعل لكفك شركة مع كفه % في نفع ذي ود بزندك يقتدح % 37(@)(@@) % أولا فجد لي بالكلام فإنه % ربح بلا خسر هنالك فارتبح % 38(@)(@@) % أولا فعرفني الحقيقة إنها % % نعم الدواء لقرحة القلب القرح % 39(@)(@@) % واكتب إلي كأن شعرك تحفة % قد كوفئت أو أنه ذنب صفح % 40(@)(@@) % أصبحتما متعاونين على التقى % % وعلى العلا والدهر فوقي مجتنح % PageV01P1131 41(@)(@@) % لم تسمعا بعد الصياح شكيتي % % وسمعتما شكوى سواي ولم يصح % 42(@)(@@) % وقد اقترحت عليكما أن تحسنا % % بي وادعا فتغاضيا للمقترح % 43(@)(@@) % فقد اجترحت خلاف ما أومأتما % % لي نحوه فتجافيا للمجترح % 44(@)(@@) % لا تأثما في منح شعري مهره % يا صالحان فإنه فرج نكح % PageV01P1132 البحر : - 1(@)(@@) % نار الروية نار جد منضجة % وللبديهة نار ذات تلويح % 2(@)(@@) % وقد يفضلها قوم لعاجلها % % لكنه عاجل يمضي مع الريح % PageV01P1133 البحر : - 1(@)(@@) % خل الزمان إذا تقاعس أو نجح % واشك الهموم إلى المدامة والقدح % 2(@)(@@) % واحفظ فؤادك إن شربت ثلاثة % واحذر عليه أن 