ms1461	 عبد الصمد بن عبد الوارث وأهل العراق(@)(@@)(@@)(@@) $ 13228 - رباح بن زيد الصنعاني يروي عن معمر وعمر بن حبيب قاصيهم روى عنه بن المبارك وإبراهيم بن خالد الصنعاني مات سنة سبع وثمانين ومائة وهو بن إحدى وثمانين سنة وكان شيخا صالحا فاضلا كان أحمد بن حنبل يقول إني أحب رباحا وأحب حديثه وأحب ذكره وهو من موالي مصعب PageV08P241(@)(@@)(@@)(@@) $ 13229 - رباح بن صالح بن عبيد الله بن أبي رافع مولى النبي صلى الله عليه وسلم يروي عن أبيه عن جده روى عنه عبد الملك بن إبراهيم الجدي(@)(@@)(@@)(@@) $ 13230 - رباح شيخ يروي عن أبي عبيد الله عن مجاهد روى عنه سفيان الثوري لست أعرفه ولا أدري من أبوه(@)(@@)(@@)(@@) $ 13231 - رباح بن خالد الكوفي يروى عن بن عيينة روى عنه أهل العراق سمعت بن خزيمة يقول سمعت أبا موسى محمد بن المثنى يقول سمعت رباح بن خالد الكوفى يقول لسفيان بن عيينة في المسجد الحرام يا أبا محمد أبو معاوية يحدث عنك بشيء لست تحفظه اليوم ووكيع يحدث عنك بشيء لست تحفظه اليوم قال صدقهم فإني كنت قبل اليوم أحفظ منى اليوم قال أبو موسى وهذا سمعته يقول سنة إحدى وتسعين ومائة(@)(@@)(@@)(@@) $ 13232 - رباح بن بشير وقيل بشر يروي عن يزيد بن أبي سعيد روى عنه بن أبي فديك(@)(@@)(@@)(@@) $ 13233 - رباح شيخ يروي عن بن المبارك عداده في أهل الكوفة روى عنه إبراهيم بن موسى الفراء لست أعرفه ولا أباه إن لم يكن PageV08P242 رباح بن خالد فلا أدرى من هو(@)(@@)(@@)(@@) $ 13234 - رباح بن الجراح أبو الوليد الموصلي يروي عن سابق بن عبد الله حدثنا عنه محمد بن إسحاق الثقفي وكان من خيار الناس(@)(@@)(@@)(@@) $ 13235 - روح بن يزيد بن بشر يروي عن أبيه روى عنه الأوزاعي وهو الذي يروي عن أبيه عن عمر بن عبد العزيز قال إياك وجز الرأس فإنه مثله(@)(@@)(@@)(@@) $ 13236 - روح بن عبادة القيسي كنيته أبو محمد من قيس بن ثعلبة يروي عن مالك وشعبة وابن أبي عروبة روى عنه أحمد بن 
ms1462	 حنبل وعلي بن المديني ويحيى بن معين وإسحاق بن إبراهيم مات بالبصرة سنة خمس ومائتين(@)(@@)(@@)(@@) $ 13237 - روح بن الفضل البصري سكن الطائف يروي عن حماد بن سلمة روى عنه الحجازيون وأهل العراق(@)(@@)(@@)(@@) $ 13238 - روح بن أسلم الباهلي كنيته أبو حاتم من أهل البصرة يروي عن وهيب وحماد بن سلمة روى عنه شداد وأهل العراق(@)(@@)(@@)(@@) $ 13239 - روح بن عبد الواحد الحراني يروي عن موسى بن أعين وأهل PageV08P243 الجزيرة روى عنه محمد بن أحمد بن الوليد بن برد الأنطاكي(@)(@@)(@@)(@@) $ 13240 - روح بن صلاح من أهل مصر يروي عن يحيى بن أيوب وأهل بلده روى عنه محمد بن إبراهيم البوشنجي وأهل مصر(@)(@@)(@@)(@@) $ 13241 - روح بن عبد المؤمن المقرئ مولى هذيل كنيته أبو الحسن من أهل البصرة يروي عن حماد بن زيد وأبى عوانة والبصريين ثنا عنه أبو يعلى وخليفة مات سنة ثلاث وثلاثين ومائتين أو قبلها أو بعدها بقليل(@)(@@)(@@)(@@) $ 13242 - روح بن حاتم أبو غسان من أهل الكوفة يروي عن وكيع ثنا عنه عبد الرحمن بن محمد بن حماد الطهراني وغيره مستقيم الحديث(@)(@@)(@@)(@@) $ 13243 - روح بن حاتم البغدادي أبو الفضل يروي عن هشيم ثنا عنه أبو يعلى وليس هذا بروح أبى حاتم المقرىء ذاك لم يلق هشيما(@)(@@)(@@)(@@) $ 13244 - رحمة بن مصعب الباهلي من أهل واسط كنيته أبو هشام يروي عن عزرة بن ثابت روى عنه القاسم بن عيسى الطائي الواسطي(@)(@@)(@@)(@@) $ 13245 - ربعى بن علية أخو إسماعيل بن علية مولى بني أسد من أهل PageV08P244 البصرة علية أمهما وأبوهما إبراهيم كنية ربعي أبو الحسن يروي الجريري روى عنه عمر بن يزيد السياري وأهل البصرة(@)(@@)(@@)(@@) $ 13246 - رقاد بن إبراهيم من أهل بخارا يروى عن بن المبارك روى عنه المراوزة وأهل بلده(@)(@@)(@@)(@@) $ 13247 - رويم بن يزيد القارىء يروي عن الليث بن سعد روى عنه أبو بكر الأعين ربما أخطأ(@)(@@)(@@)(@@) $ 13248 - ريحان بن سعيد أبو عصمة الناجي الشامي إمام مسجد عباد بن منصور من أهل البصرة يروي عن عباد بن منصور روى عنه إبراهيم بن سعيد الجوهري يعتبر 
ms1463	 حديثه من غير روايته عن عباد بن منصور(@)(@@)(@@)(@@) $ 13249 - رزيق بن نجيح السلمي يروي المقاطيع روى عنه أبو عامر العقدى PageV08P245(@)(@@)(@@)(@@) $ 13250 - رزيق أبو جعفر الحجازي مولى آل عبد الله بن جعفر بن أبي طالب يروي المقاطيع روى عنه معن بن عيسى المقاطيع(@)(@@)(@@)(@@) $ 13251 - ربيح شيخ يروي عن ربيع بن أبي راشد روى عنه جرير بن عبد الحميد ولست أدرى من أبوه(@)(@@)(@@)(@@) $ 13252 - رضى بن أبي عقيل يروي عن أبيه روى عنه محمد بن فضيل بن غزوان(@)(@@)(@@)(@@) $ 13253 - رديني بن مرة أبو المحجل يروي عن علقمة بن مرثد روى عنه أبو جناب القصاب وقد قيل إنه ردين بن مخلد البكري(@)(@@)(@@)(@@) $ 13254 - رواد بن الجراح أبو عصام العسقلاني يروي عن الثوري روى عنه ابنه عصام بن رواد وأهل الشام كان يخطىء ويخالف(@)(@@)(@@)(@@) $ 13255 - رحال القريعي يروي المقاطيع روى عنه عتاب بن عبد العزيز(@)(@@)(@@)(@@) $ 13256 - رجاء بن سهل الصغاني سكن بغداد يروي عن إسماعيل بن علية والبصريين حدثنا عنه العباس بن حمزة ربما غرب وخالف PageV08P246(@)(@@)(@@)(@@) $ 13257 - رجاء بن المرجى بن رافع أبو محمد المروزي سكن سمرقند يروي عن يزيد بن هارون روى عنه سمرقنديون وأهل العراق مات سنة تسع وأربعين ومائتين وكان متيقظا ممن جمع وصنف(@)(@@)(@@)(@@) $ 13258 - رجاء بن عبد الله الصنعاني يروي عن يعلى بن عبيد روى عنه أهل بلخ(@)(@@)(@@)(@@) $ 13259 - رجاء بن السندي يروي عن وكيع روى عنه يحيى بن عبد الله بن ماهان الكرابيسي وهو جد أبي بكر محمد بن رجاء(@)(@@)(@@)(@@) $ 13260 - رجاء بن الجارود شيخ من أهل بغداد يروي عن عبيد الله بن يربى روى عنه أهل العراق(@)(@@)(@@)(@@) $ 13261 - رجاء بن محمد العدوي يروي عن يزيد بن هارون حدثنا عنه بن خزيمة مستقيم الحديث(@)(@@)(@@)(@@) $ 13262 - رزق الله بن موسى أبو الفضل من أهل البصرة سكن بغداد يروي عن أبي ضمرة ويحيى القطان حدثنا عنه بن خزيمة وغيره كان يحدث بسامرا مات سنة ستين ومائتين قبله أو بعده بقليل PageV08P247(@)(@@)(@@)(@@) || (باب الزاي)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى عن 
ms1464	 أتباع التابعين ممن ابتدأ اسمه على الزاي(@)(@@)(@@)(@@) $ 13263 - زياد بن لاحق المحاربي من أهل الكوفة يروي عن أبيه وجدته روى عنه بن المبارك وأبو نعيم(@)(@@)(@@)(@@) $ 13264 - زياد بن يونس الإسكندراني يروي عن نافع بن أبى نعيم القارىء ومالك بن أنس وابن أبي الزناد وأهل المدينة روى عنه محمد بن داود بن أبي ناجية الإسكندراني مستقيم الحديث جدا(@)(@@)(@@)(@@) $ 13265 - زياد بن بيان كان شيخا صالحا يروي عن علي بن نفيل جد أبي جعفر النفيلي عن سعيد بن المسيب روى عنه أبو المليح الرقى(@)(@@)(@@)(@@) $ 13266 - زياد بن النضر أبو النضر الجعفي يروي عن أبيه وعبد الله بن نافع روى عنه الكوفيون(@)(@@)(@@)(@@) $ 13267 - زياد بن السكن السعدي مولى باهلة من بنى قتيبة بن مسلم يروي عن علقمة بن مرثد روى عنه علي بن حجر السعدي(@)(@@)(@@)(@@) $ 13268 - زياد بن الحسن بن فرات أبو عبد الرحمن القزاز التميمي من أهل الكوفة يروي عن أبيه روى عنه الحكم بن المبارك الخاشتى PageV08P248 وأبو سعيد الأشج(@)(@@)(@@)(@@) $ 13269 - زياد بن عبد الله بن خزاعي بن زياد بن عبد الله بن معقل المزني يروي عن مروان بن معاوية الفزاري ثنا عنه شيوخنا ربما أغرب(@)(@@)(@@)(@@) $ 13270 - زياد بن يحيى الحساني أبو الخطاب من أهل البصرة يروي عن يزيد بن هارون والبصريين حدثنا عنه أبو عروبة وغيره مات سنة أربع وخمسين ومائتين(@)(@@)(@@)(@@) $ 13271 - زياد بن أيوب أبو هاشم الطوسي لقبه دلويه من أهل بغداد يروي عن هشيم حدثنا عنه شيوخنا مات ببغداد سنة ثنتين وخمسين ومائتين(@)(@@)(@@)(@@) $ 13272 - زيد بن عبد الله بن حميد بن زيد بن ثابت الأنصاري الخزرجي كنيته أبو حميد يروي عن إسحاق بن عبد الله بن خارجة روى عنه إبراهيم بن حمزة الزبيري(@)(@@)(@@)(@@) $ 13273 - زيد بن بكر يروي عن إبراهيم بن حجر روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 13274 - زيد بن يزيد أبو محمد الموصلي وقد قيل بزيد يروى عن PageV08P249 إبراهيم بن نافع روى عنه إبراهيم بن موسى الفراء(@)(@@)(@@)(@@) $ 13275 - زيد بن إسحاق يروي عن عبيد الله بن أبي جعفر 
ms1465	 روى عنه المصريون(@)(@@)(@@)(@@) $ 13276 - زيد بن يحيى الأنماطي يروي عن شعبة بن الحجاج روى عنه عمرو بن شعبة الحرف بعد الحرف(@)(@@)(@@)(@@) $ 13277 - زيد بن الحباب العكلي التيمي كنيته أبو الحسين من أهل الكوفة يروي عن الثوري ومعاوية بن صالح روى عنه أحمد بن حنبل وأهل العراق مات بالكوفة سنة ثلاث ومائتين وكان ممن يخطىء يعتبر حديثه إذا روى عن المشاهير وأما روايته عن المجاهيل ففيها المناكير(@)(@@)(@@)(@@) $ 13278 - زيد بن يحيى بن عبيد الدمشقي كنيته أبو عبد الله يروى عن بن ثوبان والليث ومالك روى عنه أيوب بن محمد الوزان وأهل بلده مات بدمشق سنة سبع ومائتين ودفن في مقبرة باب الصغير(@)(@@)(@@)(@@) $ 13279 - زيد بن أبي الزرقاء الرملي أبو محمد يروي عن سفيان الثوري PageV08P250 روى عنه ابنه هارون بن زيد بن أبي الزرقاء الرملي وأهل الشام يغرب مات بعد سنة مائتين(@)(@@)(@@)(@@) $ 13280 - زيد بن علي بن أبي أسامة النخعي الرقى كنيته أبو أسامة يروي عن جعفر بن برقان روى عنه ابنه محمد بن زيد بن أبي أسامة وأهل حران مات سنة مائتين واسم أبي أسامة دينار(@)(@@)(@@)(@@) $ 13281 - زيد بن بشر الحضرمي أبو بشر من أهل مصر يروي عن الحجازين وابن وهب روى عنه الحارث بن مسكين والناس يغرب(@)(@@)(@@)(@@) $ 13282 - زيد بن الحريش الأهوازي يروي عن عمران بن عيينة ثنا عنه عبد الله بن أحمد بن موسى القاضي عبدان ربما أخطأ(@)(@@)(@@)(@@) $ 13283 - زيد بن المبارك الصنعاني كتب عن بن عيينة وأهل بلده سكن الشام وكان من العباد روى عنه اليمانيون(@)(@@)(@@)(@@) $ 13284 - زيد بن أخزم أبو طالب الطائي من أهل البصرة يروي عن أبي عاصم وأهل العراق حدثنا عنه بن خزيمة وغيره مستقيم الحديث مات بعد الخمسين والمائتين(@)(@@)(@@)(@@) $ 13285 - زيد بن تميم بن يحيى بن حفص بن عمرو بن عباد التميمي من PageV08P251 أهل سرجس بن ابنه المؤمل بن خارجة يروي عن عمه حفص بن يحيى حدثنا عنه محمد بن عبد الرحمن وأهل بلده مات سنة ست وستين ومائتين(@)(@@)(@@)(@@) $ 13286 - زيد بن إسماعيل الصائغ 
ms1466	 أبو الحسن يروي عن أبي نعيم ومعاوية بن هشام حدثنا عنه أحمد بن عيسى بن السكين البلدي بواسط مستقيم الحديث(@)(@@)(@@)(@@) $ 13287 - زكريا بن سليم أبو عمران البصري يروي عمن سمع عبيد الله بن أبي بكرة روى عنه بن المبارك ووكيع(@)(@@)(@@)(@@) $ 13288 - زكريا بن سلام أبو تحيى يروي عن سعيد بن مسروق وعبيدة بن حسان روى عنه هارون بن المثنى وحكام بن سلم(@)(@@)(@@)(@@) $ 13289 - زكريا بن عبد الله بن يزيد النخعي الصهباني من أهل الكوفة كنيته أبو يحيى يروي عن أبيه روى عنه قتيبة بن سعيد(@)(@@)(@@)(@@) $ 13290 - زكريا بن عطية البحراني سكن البصرة يروي عن سلام أبي المنذر روى عنه أهل البصرة(@)(@@)(@@)(@@) $ 13291 - زكريا بن نافع الأرسوفي أبو يحيى يروي عن بن عيينة وعباد PageV08P252 بن عباد روى عنه يعقوب بن سفيان والناس يغرب(@)(@@)(@@)(@@) $ 13292 - زكريا بن عدى أبو يحيى الكوفي الرقى سكن مصر يروي عن بن المبارك وعبيد الله بن عمرو روى عنه أبو حاتم الرازي وأهل مصر مات ببغداد يوم الخميس بيومين مضيا من جمادى الآخرة سنة ثنتي عشرة ومائتين(@)(@@)(@@)(@@) $ 13293 - زكريا بن أبي عبيدة الناجي واسم أبي عبيدة شامي العياص يروي عن أبيه روى عنه أحمد بن عبد المؤمن المروزي ساكن مصر(@)(@@)(@@)(@@) $ 13294 - زكريا بن يحيى بن صبيح زحمويه من أهل واسط يروي عن هشيم وخالد ثنا عنه شيوخنا الحسن بن سفيان وغيره وكان من المتقنين في الروايات مات سنة خمس وثلاثين ومائتين(@)(@@)(@@)(@@) $ 13295 - زكريا بن زياد أبو يحيى صاحب الأمشاط من أهل البصرة يروي عن أبي هلال الراسبي والبصريين روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 13296 - زكريا بن يحيى أبو يحيى الوقار من أهل مصر يروي عن سفيان بن عيينة ثنا عنه إسماعيل بن داود بن وردان المصري وغيره من شيوخنا يخطىء ويخالف أخطأ في حديث موسى حيث قال عن مجالد عن أبي الوداك عن أبي سعيد عن عمر إنما هو الثوري أن PageV08P253 النبي صلى الله عليه وسلم قال قال أخي موسى يا رب أرني الذي كنت أريتني في 
ms1467	 السفينة فذكره بطوله(@)(@@)(@@)(@@) $ 13297 - زكريا بن يحيى بن عبد الله بن أبي سعيد الرقاشي الحزار المقرىء أبو عبد الله يروي عن سعيد بن عبد الرحمن الجمحي ومعاذ بن معاذ والعراقيين حدثنا عنه أبو يعلى بالموصل وغيره من شيوخنا وليس هذا بن حمويه يغرب ويخطىء(@)(@@)(@@)(@@) $ 13298 - زكريا بن يحيى أبو السكين الطائي يروي عن المحاربي وأبى أسامة ثنا عنه إبراهيم بن جعفر بن الوليد وغيره مات سنة إحدى وخمسين ومائتين(@)(@@)(@@)(@@) $ 13299 - زكريا بن يحيى اللآل أبو يحيى من أهل بلخ يروي عن بن نمير ووكيع وكان صاحب سنة وفضل ممن يرد على أهل البدع روى عنه أحمد بن سيار وأهل بلده وهو زكريا بن يحيى بن صالح بن سليمان صاحب كتاب الإيمان(@)(@@)(@@)(@@) $ 13300 - زكريا بن يحيى بن القاسم البصري سكن مصر يروي عن أهل البصرة حدثنا محمد بن أيوب بن مشكان ثنا زكريا بن يحيى بن القاسم ثنا يوسف بن عطية الصفار قال رأيت الحسن البصري قاعدا في الشمس يفت لباب الخبز للنمل PageV08P254(@)(@@)(@@)(@@) $ 13301 - زكريا بن يحيى الكناني الكوفي يروى عن بن فضيل والكوفيين ثنا عنه أبو يعلى بالموصل(@)(@@)(@@)(@@) $ 13302 - زكريا بن يحيى بن زكريا بن أبي زائدة يروي عن أبي نعيم وأبيه ووكيع ثنا عنه محمد بن محمد بن يوسف بنسأ(@)(@@)(@@)(@@) $ 13303 - زكريا بن الحكم الأسدي الرسعني من رأس العين كنيته أبو يحيى يروي عن يزيد بن هارون وعبد الله بن بكر السهمي وأهل العراق حدثنا عنه أبو عروبة وأهل الجزيرة مات برأس العين سنة ثلاث وخمسين ومائتين وكان يخضب رأسه ولحيته(@)(@@)(@@)(@@) $ 13304 - زكريا بن يحيى بن جناح من أهل البصرة يروي عن مكي بن إبراهيم روى عنه أهل بلده(@)(@@)(@@)(@@) $ 13305 - زكريا بن يحيى الربضي يروي عن أبي نعيم كان أحمد بن محمد بن سعد العراقي يذاكرنا عنه بالشيء بعد الشيء(@)(@@)(@@)(@@) $ 13306 - زكريا بن يحيى بن خلاد المنقري أبو يعلى من أهل البصرة يروي عن أبي عاصم حدثنا عنه أحمد بن حمدان التستري بعبادان وكان من جلساء الأصمعي(@)(@@)(@@)(@@) $ 13307 - زكريا 
ms1468	 بن يحيى بن أسد المروزي أبو يحيى شيخ كان ببغداد سمع من سفيان بن عيينة مستقيم الحديث كتب عنه أصحابنا(@)(@@)(@@)(@@) $ 13308 - زكريا بن الحارث أبو يحيى يروي عن معاذ بن هشام وأبى عاصم ثنا عنه محمد بن إسحاق PageV08P255(@)(@@)(@@)(@@) $ 13309 - زهير بن العلاء العبدي من أهل البصرة يروي عن سعيد بن أبي عروبة روى عنه أبو الأشعث أحمد بن المقدام وأهل البصرة(@)(@@)(@@)(@@) $ 13310 - زهير بن نعيم بن محمد بن جعفر بن باب البابي سكن البصرة ومولده سجستان من العباد الخشن يروي عن بن المبارك روى عنه أهل بلده(@)(@@)(@@)(@@) $ 13311 - زهير بن إسحاق السلولي السلمي كنيته أبو إسحاق من أهل الكوفة يروي عن داود بن أبي هند والكوفيين عداده في أهل البصرة روى عنه محمد بن أبي بكر المقدمي(@)(@@)(@@)(@@) $ 13312 - زهير بن هنيد من أهل البصرة كنيته أبو الذيال يروي عن أبي نعامة روى عنه أحمد بن عبدة الضبي(@)(@@)(@@)(@@) $ 13313 - زهير بن عباد الرواسي بن عم وكيع بن الجراح كنيته أبو محمد من أهل الكوفة سكن مصر يروي عن مالك وابن عيينة ثنا عنه الحسن بن سفيان يخطىء ويخالف(@)(@@)(@@)(@@) $ 13314 - أبو خيثمة اسمه زهير بن حرب بن شداد أصله من نسا سكن بغداد يروي عن بن عيينة ثنا عنه أبو يعلى وغيره من شيوخنا مات PageV08P256 في ربيع الأول سنة أربع وثلاثين ومائتين وكان متقنا ضابطا من أقران أحمد بن حنبل ويحيى(@)(@@)(@@)(@@) $ 13315 - زهير بن محمد بن قمير من أهل بغداد يروي عن يزيد بن هارون وعبد الرزاق روى عنه البغداديون عمر حتى كتب عنه الكهول وكان أصله من مرو كنيته أبو عبد الرحمن وقد قيل أبو محمد(@)(@@)(@@)(@@) $ 13316 - زين بن شعيب من أهل مصر يروي عن مالك بن أنس روى عنه عبد الأعلى بن عبد الواحد الكلامي والبصريون مستقيم الحديث(@)(@@)(@@)(@@) $ 13317 - زبان بن عبد العزيز يروي عن عمر بن عبد العزيز أن النبي صلى الله عليه وسلم قال له جبريل هذه صلاتك وصلاة من كان قبلك من الرسل روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 13318 
ms1469	 - الزبير بن بكار أبو عبد الرحمن يروي عن أبي ضمرة ثنا عنه أحمد بن عمر بن يوسف كان عالما بالأنساب(@)(@@)(@@)(@@) $ 13319 - الزبير بن محمد الرهاوي يروي عن قتادة بن الفضيل عن PageV08P257 إبراهيم بن أبي عبلة روى عنه أهل الشام والغرباء حدثني عمر بن المسيب ثنا الزبير بن محمد الرهاوي ثنا قتادة بن الفضيل عن إبراهيم بن أبي عبلة قال سألت أنس بن مالك كيف تتوضأ قال تسألني كيف تتوضأ ولا تسألني كيف رأيت رسول الله صلى الله عليه وسلم كيف يتوضأ فقلت نعم فقال رأيت رسول الله صلى الله عليه وسلم يتوضأ ثلاثا ثلاثا ويقول أمرني بذلك جبريل عليه السلام(@)(@@)(@@)(@@) $ 13320 - زفر بن عبد الرحمن بن أردك من أهل المدينة يروي عن محمد بن سليمان بن والبة روى عنه بن أبي أويس(@)(@@)(@@)(@@) $ 13321 - زائدة بن موسى الهمداني يروي عن بشار بن أبي كريب عن شريح روى عنه بن المبارك(@)(@@)(@@)(@@) $ 13322 - زائدة بن سليم يروي عن عمران بن عمير روى عنه الكوفيون(@)(@@)(@@)(@@) $ 13323 - زائدة بن قدامة بن زائدة بن قدامة الكاهلي من أهل الكوفة يروي عن أبيه والكوفيين روى عنه محمد بن الحسين بن أبي الخير الكوفي(@)(@@)(@@)(@@) $ 13324 - زحر بن حصن الطائي كنيته أبو الفرج يروي عن عمه وأبيه PageV08P258 روى عنه زكريا بن يحيى الطائي مات سنة أربع ومائتين(@)(@@)(@@)(@@) $ 13325 - زريق بن السخت أبو عبد الله البصري يروي عن أبي عاصم وجعفر بن عون وأهل العراق ثنا عنه شيوخنا أبو عمر الفرار وغيره مستقيم الحديث إذا روى عن الثقات(@)(@@)(@@)(@@) $ 13326 - زاهر بن خالد أبو الأزهر الوراق من أهل سمرقند يروي عن الأنصاري روى عنه أهل بلده مات بسمرقند يوم السبت ودفن يوم الأحد لخمس بقين من شعبان سنة ست وخمسين ومائتين رحمه الله تعالى(@)(@@)(@@)(@@) || (باب السين)(@)(@@) قال أبو حاتم رضي الله عنه وممن روى من أتباع الأتباع ممن ابتدأ اسمه على السين(@)(@@)(@@)(@@) $ 13327 - سعيد بن أبي أيوب الخزاعي كنيته أبو يحيى من أهل مصر واسم أبي أيوب مقلاص يروي عن عقيل 
ms1470	 بن خالد روى عنه بن المبارك مات سنة تسع وأربعين ومائة ليس له عن تابعي سماع صحيح فلذلك أدخلناه في هذه الطبقة وروايته عن زيد بن أسلم وأبى حازم إنما هي كتاب(@)(@@)(@@)(@@) $ 13328 - سعيد بن عبيد الله الثقفي يروي عن زياد بن جبير بن حية عن PageV08P259 أبيه عن المغيرة بن شعبة روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 13329 - سعيد بن عبيد قال كنا في جنازة أبي سفيان بن العلاء ومعنا شعبة فلما دفن قال شعبة حدثني هذا وأشار إلى قبر أبي سفيان بن العلاء قال قلت للحسن يا أبا سعيد من حدثك أن النبي صلى الله عليه وسلم قال لولا أن الكلاب أمة من الأمم لأمرت بقتلها فقال عبد الله بن المغفل والله الذي لا إله إلا هو لقد حدثني في هذا المسجد وأومأ إلى مسجد الجامع ثناه أبو خليفة ثنا محمد بن سلام الجمحي ثنا سعيد بن عبيد وساقه(@)(@@)(@@)(@@) $ 13330 - سعيد بن عمرو بن شرحبيل بن سعيد بن سعد بن عبادة الأنصاري الخزرجي من أهل المدينة يروي الوجادات روى عنه أبو أويس وعبد العزيز بن المطلب(@)(@@)(@@)(@@) $ 13331 - سعيد بن عبد الله بن سعيد الأبلى يروي عن عباس بن عبد الله بن معبد بن عباس روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 13332 - سعيد بن عيسى القرشي يروي عن جدته أم الربيع روى عنه الوليد بن مسلم ويحيى بن حسان(@)(@@)(@@)(@@) $ 13333 - سعيد بن عبد الرحمن بن عبد الله الزبيري كنيته أبو شيبة من PageV08P260 أهل الري يروي المقاطيع وهو الذي يقول يعجبني من القراء كل سهل طلق فأما أن يلقاه ببشر ويلقاك بعبوس فلا كثر الله في القراء ضرب هذا(@)(@@)(@@)(@@) $ 13334 - سعيد بن السائب الطائفي يروي عن أبيه ونوح بن صعصعة روى عنه معن بن عيسى القزاز(@)(@@)(@@)(@@) $ 13335 - سعيد بن سفيان الأسلمي يروي عن جعفر بن محمد روى عنه بن أبي فديك(@)(@@)(@@)(@@) $ 13336 - سعيد بن عبد الله الجهني يروي عن محمد بن عمرو بن علي روى عنه بن وهب(@)(@@)(@@)(@@) $ 13337 - سعيد بن عبد 
ms1471	 الجبار يروي عن هارون بن هارون روى عنه محمد بن شعيب بن سابور(@)(@@)(@@)(@@) $ 13338 - سعيد بن عبد الله بن سعيد الأيلي أخو الحكم بن عبد الله يروي عن عقيل بن خالد روى عنه محمد بن طلحة(@)(@@)(@@)(@@) $ 13339 - سعيد بن عيسى بن تليد الرعيني من أهل مصر يروي المقاطيع PageV08P261 روى عنه بن وهب(@)(@@)(@@)(@@) $ 13340 - سعيد بن عبد الله العبدي يروي عن يحيى بن أبي كثير روى عنه الحجاج بن الحجاج الأسلمي(@)(@@)(@@)(@@) $ 13341 - سعيد بن سفيان الأسلمي يروي عن جعفر بن محمد روى عنه بن أبي فديك(@)(@@)(@@)(@@) $ 13342 - سعيد بن سويد يروي عن زياد عن أبي الصديق روى عنه زيد بن الحباب(@)(@@)(@@)(@@) $ 13343 - سعيد بن زياد المؤذن يروي عن عثمان بن عبد الرحمن التيمي عن بن أبي مليكة روى عنه زياد بن يونس الإسكندراني(@)(@@)(@@)(@@) $ 13344 - سعيد بن عبد الله بن أبي مريم يروي عن أبيه روى عنه معن بن عيسى القزاز(@)(@@)(@@)(@@) $ 13345 - سعيد بن كعب يروي عن محمد بن عبد الرحمن بن يزيد روى عنه محمد بن طلحة الكوفي(@)(@@)(@@)(@@) $ 13346 - سعيد بن عبد الله أمام مسجد أبي الوليد الطيالسي يروي عن أبيه عن الحسن روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 13347 - سعيد بن صدقة الكوفي أبو مهلهل يروي عن سفيان الثوري أنه قال يا أبا مهلهل إن استطعت أن لا تخالط في زمانك هذا أحدا فافعل روى PageV08P262 عنه عياش بن خصم الكلبي(@)(@@)(@@)(@@) $ 13348 - أبو الوليد سعيد بن عمر من أهل سابور فارس يروي عن يونس بن خباب روى عنه عثمان بن زفر(@)(@@)(@@)(@@) $ 13349 - سعيد بن إبراهيم بن أبي العطوف الحراني يروي عن أبي يوسف القاضي روى عنه إبراهيم بن أيوب الحوارني(@)(@@)(@@)(@@) $ 13350 - سعيد بن سابق بن الأزرق الرشيدي أبو عثمان من أهل مصر يروي عن حيوة بن شريح والمصريين روى عنه عبيد الله بن سعيد بن كثير بن عفير وأهل بلده(@)(@@)(@@)(@@) $ 13351 - سعيد بن زكريا القرشي المدائني كنيته أبو عمرو يروي عن الزبير بن سعيد الهاشمي روى عنه أحمد بن سليمان ومحمد بن 
ms1472	 خداش(@)(@@)(@@)(@@) $ 13352 - سعيد بن عبد الله بن الربيع بن خيثم من أهل الكوفة يروي عن أبيه روى عنه مسدد بن مسرهد وقتيبة بن سعيد(@)(@@)(@@)(@@) $ 13353 - سعيد بن عبد الله بن زياد بن جبير بن حية الثقفي من أهل البصرة يروي عن آبائه روى عنه عبد الواحد بن واصل بن علي بن نصر الجهضمي(@)(@@)(@@)(@@) $ 13354 - سعيد بن يحيى بن حسين بن عثمان بن عبد الرحمن بن عوف PageV08P263 الزهري كنيته أبو غسان يروي عن عمه إبراهيم بن حسن روى عنه يعقوب بن حميد بن كاسب(@)(@@)(@@)(@@) $ 13355 - سعيد بن خثيم الهلالي يروي عن حنظلة بن أبي سفيان روى عنه عمرو بن محمد الناقد وليس هذا بسعيد بن خثيم الذي يقال له أبو معمر الذي يروي عن جده وأبيه ذاك من أتباع التابعين قد تقدم ذكره(@)(@@)(@@)(@@) $ 13356 - سعيد بن عمرو الزبيدي من أهل المدينة يروي عن عبد الرحمن بن أبي الزناد روى عنه إبراهيم بن المنذر الحزامي(@)(@@)(@@)(@@) $ 13357 - سعيد بن عبد الله الوصافي من أهل الكوفة يروي عن أبيه روى عنه محمد بن عمران بن أبي ليلى(@)(@@)(@@)(@@) $ 13358 - سعيد بن شرحبيل الكندي من أهل الكوفة يروي عن الليث بن سعد روى عنه الكوفيون(@)(@@)(@@)(@@) $ 13359 - سعيد بن عامر الضبعي أبو محمد مولى بنى العجيف من أهل البصرة PageV08P264 وأخواله بنى ضبيعة يروي عن محمد بن عمرو وشعبة روى عنه بندار وأبو موسى كان مولده سنة ثنتين وعشرين ومائة ومات سنة ثمان ومائتين وهو بن ست وثمانين لأربع مضين من شوال(@)(@@)(@@)(@@) $ 13360 - سعيد بن الحسن العيني يروي عن مضيف عن عكرمة روى عنه حمزة بن حبيب الزيات(@)(@@)(@@)(@@) $ 13361 - سعيد بن يحيى أبو سفيان الحميري الحذاء من أهل واسط يروي عن معمر وسفيان بن حسين روى عنه أهل العراق مات يوم الأربعاء لأربع بقين من شعبان سنة ثنتين ومائتين(@)(@@)(@@)(@@) $ 13362 - سعيد بن سفيان الجحدري كنيته أبو الحسن من أهل البصرة يروي عن شعبة مات سنة أربع أو خمس ومائتين وكان ممن يخطىء حمل عليه علي بن المديني وليس 
ms1473	 من يسلك مسلك الأثبات ثم لم يتعر عن الوهم والخطأ استحق الحمل عليه حتى يعدل به عن مسلك الأثبات إلى غيرهم(@)(@@)(@@)(@@) $ 13363 - سعيد بن الربيع أبو زيد الهروي الحرشي العامري من أهل البصرة وإنما قيل له هروي لأنه كان يبيع الثياب الهروية فنسب PageV08P265 إليها وكان جده مكاتبا لزرارة بن أوفي يروي عن شعبة روى عنه أحمد بن المقدام العجلي وأهل العراق مات سنة إحدى عشرة ومائتين(@)(@@)(@@)(@@) $ 13364 - سعيد بن واصل الجرشي من أهل البصرة يروي عن وهيب بن خالد روى عنه محمد بن سفيان بن أبي الزرد الأبلى ربما أغرب(@)(@@)(@@)(@@) $ 13365 - سعيد بن كثير بن عفير أبو عثمان الأنصاري من أهل مصر يروي عن الليث بن سعد ويعقوب الإسكندراني روى عنه محمد بن يحيى الذهلي وأهل بلده مات سنة بضع وعشرين ومائتين(@)(@@)(@@)(@@) $ 13366 - سعيد بن المغيرة أبو عثمان الصياد من أهل المصيصة يروي عن عيسى بن يونس روى عنه الحسن بن الصباح البزار وأهل بلده ربما أغرب(@)(@@)(@@)(@@) $ 13367 - سعيد بن عثمان بن عبد الله بن العاص القرشي يروي عن أبي بكر بن عياش روى عنه محمد بن عون الحمصي(@)(@@)(@@)(@@) $ 13368 - سعيد بن الحكم بن أبي مريم الجهني كنيته أبو محمد من أهل مصر يروي عن الليث بن سعد ويحيى بن أيوب روى عنه محمد بن يحيى الذهلي والناس كان مولده سنة أربع وأربعين ومائة ومات PageV08P266 سنة أربع وعشرين ومائتين(@)(@@)(@@)(@@) $ 13369 - سعيد بن سليمان بن كنانة الواسطي كنيته أبو عثمان سكن بغداد وهو الذي يعرف بسعدويه البزاز يروي عن الليث بن سعد روى عنه أهل العراق مات في ذي الحجة ببغداد سنة خمس وعشرين ومائتين يوم الثلاثاء لأربع مضين منه(@)(@@)(@@)(@@) $ 13370 - سعيد بن عمرو بن سهل بن إسحاق بن محمد بن الأشعث الأشعثي من أهل الكوفة يروي عن عبثر أبى زبيد وسفيان بن عيينة ووكيع روى عنه بن كرامة مات سنة ثلاثين ومائتين(@)(@@)(@@)(@@) $ 13371 - سعيد بن زنبويه أبو إسحاق شيخ يروي عن هشيم عن أبيه قال كان الحسين يحدثني وهو راكب 
ms1474	 وأنا أمشي معه روى عنه أحمد بن علي الأبار مات سنة ثلاثين ومائتين(@)(@@)(@@)(@@) $ 13372 - سعيد بن النضر أبو عثمان البغدادي يروي عن هشيم روى عنه البخاري محمد بن إسماعيل(@)(@@)(@@)(@@) $ 13373 - سعيد بن عبد الملك بن واقد الحراني أخو أحمد بن عبد الملك يروى عن بن عيينة ومحمد بن سلمة روى عنه محمد بن يحيى الذهلي(@)(@@)(@@)(@@) $ 13374 - سعيد بن عبد الجبار من أهل البصرة يروي عن مالك بن أنس حدثنا عنه أبو خليفة وغيره من شيوخنا PageV08P267(@)(@@)(@@)(@@) $ 13375 - سعيد بن عيسى بن تليد القتباني من أهل مصر يروي عن بن عيينة وكان روايا لعبد الرحمن بن القاسم صاحب مالك روى عنه علي بن عثمان النفيلي وهو عم المقدام بن داود القتباني المصري(@)(@@)(@@)(@@) $ 13376 - سعيد بن أبي الربيع السمان أبو بكر من أهل البصرة يروي عن أبيه حدثنا عنه الحسن بن سفيان وأبو يعلى يعتبر حديثه من غير روايته عن أبيه(@)(@@)(@@)(@@) $ 13377 - سعيد بن نخى من أهل مكة يروى عن بن إدريس روى عنه يعقوب بن سفيان الفارسي(@)(@@)(@@)(@@) $ 13378 - سعيد بن محمد الجرمي من أهل الكوفة يروى عن بن أبجر وأبي تميلة روى عنه أبو زرعة الرازي(@)(@@)(@@)(@@) $ 13379 - سعيد بن عثمان بن محمد بن عبد الله بن سعيد بن العاص أبو عثمان من أهل الكوفة يروى عن بن المبارك روى عنه يعقوب بن سفيان الفارسي(@)(@@)(@@)(@@) $ 13380 - سعيد بن عنبسة يروى عن بن إدريس والكوفيين روى عنه محمد بن إبراهيم البوشنجي ربما خالف(@)(@@)(@@)(@@) $ 13381 - سعيد بن جمادى الأنصاري من أهل مصر يروى عن بن عيينة روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 13382 - سعيد بن منصور أبو عثمان الخراساني سكن مكة يروي عن هشيم وخالد حدثنا عنه محمد بن عبد الرحمن الشامي مات بمكة سنة سبع PageV08P268 وعشرين ومائتين وكان ممن جمع وصنف من المتقنين الأثبات(@)(@@)(@@)(@@) $ 13383 - سعيد بن القاسم بن الحسن بن راشد الهاشمي أبو عثمان من أهل مصر يروي عن نوفل بن سالم الهاشمي روى عنه(@)(@@)(@@)(@@) $ 13384 - سعيد بن إسماعيل المشاجعي يروي عن عيسى بن 
ms1475	 يونس روى عنه أهل الشام وكان ممن يغرب ثنا الحسن بن إسحاق يوسف بن بحر العجلي قاضي حمص ثنا سعيد بن إسماعيل المشاجعى ثنا عيسى بن يونس عن الأوزاعي عن يحيى بن أبي كثير عن أنس بن مالك قال كان النبي صلى الله عليه وسلم إذا أفطر عند أهل بيت قال أفطر عندكم الصائمون وأكل طعامكم الأبرار ونزلت عليكم الملائكة(@)(@@)(@@)(@@) $ 13385 - سعيد بن نصير يروى عن بن عيينة حدثنا مكحول ثنا محمد بن يحيى بن كثير الحراني ثنا سعيد بن نصير قال سألت سفيان بن عيينة فقلت يا أبا محمد عندنا قوم يلبسون الشعر ويحجون ولا يتزودون ويزعمون أن من حمل الزاد فليس بمؤمن فقال كذبوا هؤلاء أعداء السنة لا تجالسوهم ولا تحدثوهم(@)(@@)(@@)(@@) $ 13386 - سعيد بن حفص بن عمر بن نفيل الحراني كنيته أبو عمرو وهو PageV08P269 خال أبي جعفر النفيلي يروي عن معقل بن عبيد الله حدثنا عنه شيوخنا الحسن بن سفيان وعمرو بن سنان وغيرهما مات سنة سبع وثلاثين ومائتين(@)(@@)(@@)(@@) $ 13387 - سعيد بن يعقوب الطالقاني أبو بكر يروى عن بن المبارك وحماد بن زيد وهشيم وابن عياش ثنا عنه شيوخنا إسحاق بن إبراهيم القاضي وغيره مات سنة أربعين ومائتين(@)(@@)(@@)(@@) $ 13388 - سعيد بن يحيى بن سعيد بن أبان الأموي القرشي كنيته أبو عثمان يروى عن بن المبارك حدثنا عنه الناس مات سنة تسع وأربعين ومائتين ببغداد ربما أخطأ(@)(@@)(@@)(@@) $ 13389 - سعيد بن يحيى الأصبهاني يعرف ب سعدويه من أهل أصبهان يروي عن مسلم بن خالد الزنجي روى عنه أهل بلده(@)(@@)(@@)(@@) $ 13390 - سعيد بن ذؤيب من أهل نسا يروي عن أبي ضمرة وابن عيينة حدثنا عنه الحسن بن سفيان وهو جد أبي الحسن أحمد بن محمد بن سعيد بن ذؤيب مات سنة سبع وثلاثين ومائتين(@)(@@)(@@)(@@) $ 13391 - سعيد بن عبد الرحمن بن حسان أبو عبيد الله المخزومي من أهل مكة يروي عن بن عيينة حدثنا عنه شيوخنا بن خزيمة وغيره مات سنة تسع وأربعين ومائتين PageV08P270(@)(@@)(@@)(@@) $ 13392 - سعيد بن كليب العدني يروي عن وكيع 
ms1476	 بن أبان روى عنه بن موسى(@)(@@)(@@)(@@) $ 13393 - سعيد بن جناح أبو الحسن الزاهد من أهل بخارا يروي عن وكيع وإبراهيم بن عيينة روى عنه أهل بلده(@)(@@)(@@)(@@) $ 13394 - سعيد بن عيسى الوراق أبو عثمان من أهل بغداد يروي عن يزيد بن هارون روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 13395 - سعيد بن يحيى بن الأزهر الواسطي يروي عن يزيد بن هارون حدثنا عنه شيوخنا سهل بن أبي سهل وغيره مات سنة ثلاث وأربعين ومائتين(@)(@@)(@@)(@@) $ 13396 - سعيد بن مطرف أبو كثير الباهلي شيخ يروي عن أهل المدينة مستقيم الحديث ثنا عنه أبو يعلى(@)(@@)(@@)(@@) $ 13397 - سعيد بن أسد بن موسى السنة من أهل مصر يروي عن بن عيينة وضمرة روى عنه يعقوب بن سفيان الفارسي(@)(@@)(@@)(@@) $ 13398 - سعيد بن زنجل من أهل بلخ يروي عن مكي بن إبراهيم روى عنه أهل بلده ربما أخطأ كنيته أبو عثمان(@)(@@)(@@)(@@) $ 13399 - سعيد بن مسعود المروزي يروي عن يزيد بن مروان وعبيد الله بن موسى حدثنا عنه عبد الله بن عمار وأهل بلده وهو والد PageV08P271 أبي العباس بن سعيد(@)(@@)(@@)(@@) $ 13400 - سعيد بن عمرو السكوني أبو عثمان من أهل حمص يروي عن بقية بن الوليد ثنا عنه مكحول وغيره(@)(@@)(@@)(@@) $ 13401 - سعيد بن محمد بن ثواب الحصري من أهل البصرة يروي عن أبي عاصم وأهل العراق حدثنا عنه عبد الكبير بن عمر الخطابي وغيره مستقيم الحديث كنيته أبو عثمان(@)(@@)(@@)(@@) $ 13402 - سعيد بن يحيى القراطيسي من أهل بغداد يروي عن زيد بن هارون حدثنا عنه شيوخنا مات سنة ثلاث وخمسين ومائتين(@)(@@)(@@)(@@) $ 13403 - سعيد بن هاشم الكاغذي أبو توبة من أهل سمرقند يروي عن أبي نعيم والعراقيين حدثني عنه محمد بن صالح وأهل سمرقند مستقيم الحديث صاحب سنة مات يوم الإثنين لسبع بقين من ربيع الأول سنة تسع وخمسين ومائتين(@)(@@)(@@)(@@) $ 13404 - سليمان بن أبي زينب السبأى يروي عن سعيد بن سلمة روى عنه نافع بن يزيد(@)(@@)(@@)(@@) $ 13405 - سليمان بن محمد بن زريق من أهل رأس العين يروي عن أبي نعيم وأهل العراق ثنا عنه 
ms1477	 جماعة من أهل رأس العين مستقيم الأمر في الحديث(@)(@@)(@@)(@@) $ 13406 - سليمان بن سليمان شامي يروي عن يونس بن يزيد الأيلي PageV08P272 روى عنه إسماعيل بن عياش يخطىء ويخالف(@)(@@)(@@)(@@) $ 13407 - سليمان بن وهب الأبناوي شيخ من جشم يروي عن النعمان بن بزرج روى عنه محمد بن الحسن الصنعاني(@)(@@)(@@)(@@) $ 13408 - سليمان بن سالم أبو أيوب مولى عبد الرحمن بن حميد بن عبد الرحمن بن عوف من أهل المدينة يروي عن عبد الرحمن بن حميد روى عنه إبراهيم بن حمزة الزبيري(@)(@@)(@@)(@@) $ 13409 - سليمان بن الحجاج الطائفي يروي عن المدنيين وقد رأى محمد بن عبد الله بن عمرو بن عثمان بن عفان روى عن بن المبارك(@)(@@)(@@)(@@) $ 13410 - سليمان بن داود بن سليمان المخزومي يروي عن إسماعيل بن يعقوب التميمي روى عنه الزبير بن بكار(@)(@@)(@@)(@@) $ 13411 - سليمان بن داود أبو داود الكوفي يروي عن جعفر بن سعيد من ولد سمرة روى عنه الوليد بن مسلم PageV08P273(@)(@@)(@@)(@@) $ 13412 - سليمان بن أبي سليمان يروي عن يحيى بن أبي كثير روى عنه عمر بن يونس اليمامي ربما خالف(@)(@@)(@@)(@@) $ 13413 - سليمان بن أبي شيخ من أهل واسط يروي عن حماد بن سلمة والبصريين روى عنه عبد الله بن محمد الأموي وأهل العراق كان صاحب أخبار وحكايات(@)(@@)(@@)(@@) $ 13414 - سليمان بن فروخ يروي عن الضحاك بن مزاحم روى عنه محمد بن خازم(@)(@@)(@@)(@@) $ 13415 - سليمان بن هارون العبدي يروي عن إبراهيم بن يزيد الخوزي روى عنه سهل بن إبراهيم الجارودي الحزاز(@)(@@)(@@)(@@) $ 13416 - سليمان بن عتبة الدمشقي السلمي أبو الربيع يروي عن يونس بن ميسرة بن حلبس والشاميين روى عنه الهيثم بن خارجة وسليمان بن عبد الرحمن(@)(@@)(@@)(@@) $ 13417 - سليمان بن أبي خالد البزار يروي عن أبيه روى عنه القعنبي PageV08P274(@)(@@)(@@)(@@) $ 13418 - سليمان بن محمد بن عاصم العمرى يروي عن أبي حازم الأعرج روى عنه أبو النضر هاشم بن القاسم(@)(@@)(@@)(@@) $ 13419 - سليمان بن سليم أبو حمام المطوعي يروي عن هلال بن عبد الرحمن عن علي بن زيد بن جدعان روى عنه زكريا بن يحيى القزاز الرقاشي(@)(@@)(@@)(@@) $ 13420 
ms1478	 - سليمان بن داود بن قيس الصنعاني يروي عن أبيه عن يحيى بن سعيد الأنصاري وزيد بن أسلم روى عنه محمد بن إسحاق المسيبي(@)(@@)(@@)(@@) $ 13421 - سليمان بن سعيد أبو داود المؤدب يروي عن إبراهيم بن سعد روى عنه محمد بن يزيد المستملى(@)(@@)(@@)(@@) $ 13422 - سليمان بن الحكم بن عوانة الكلبي يروي عن العلاء بن كثير عن مكحول ربما أخطأ روى عنه أبو جعفر النفيلي وكان يزعم أنه ثقة(@)(@@)(@@)(@@) $ 13423 - سليمان بن داود أبو داود الطيالسي أصله من فارس سكن البصرة وكان أبوه مولى لقريش وأمه مولاة لبنى نصر بن معاوية يروي عن شعبة وأهل العراق روى عنه أحمد بن حنبل والناس وكان مولده سنة ثلاث وثلاثين ومات سنة ثلاث ومائتين في ربيع الأول وكان دخل أصبهان فحدثهم بها بثلاثين ألف حديث حفظا PageV08P275 ووقف يوما على معلم فإذا صبي يقرأ عليه إذا الشمس كورت فقال يا بنى أعده على فأعاده عليه فقال ما في الدنيا أحفظ من هذا الصبي(@)(@@)(@@)(@@) $ 13424 - سليمان بن النعمان الشيباني بصرى يروي عن الحسن بن أبو جعفر روى عنه سهل بن بحر القناد الجنديسابوري(@)(@@)(@@)(@@) $ 13425 - سليمان بن أبي سوداء يروي عن بن المبارك روى عنه علي بن حرب السكوني البزازي(@)(@@)(@@)(@@) $ 13426 - سليمان بن أحمد الواسطي يروي عن الوليد بن مسلم وشعيب بن إسحاق روى عنه وهب بن بقية يغرب وكنية سليمان أبو محمد(@)(@@)(@@)(@@) $ 13427 - سليمان بن أبي حجر الأيلي يروي عن أبي صدقة بكر بن صدقة روى عنه ابنه أيوب بن سليمان بن أبي حجر ربما أغرب(@)(@@)(@@)(@@) $ 13428 - سليمان بن حرب أبو أيوب الواشحي الأزدي من أهل البصرة وكان على قضاء مكة يروي عن شعبة وحماد بن سلمة ثنا عنه الفضل بن الحباب الجمحي كان مولده سنة أربعين ومائة في صفر ومات بالبصرة سنة أربع وعشرين ومائتين PageV08P276(@)(@@)(@@)(@@) $ 13429 - سليمان بن يزيد أبو داود مولى بنى هاشم من أهل البصرة يروي عن أبي عاصم وأبى نعيم روى عنه محمد بن أيوب بن ضريس(@)(@@)(@@)(@@) $ 13430 - سليمان الخواص من عباد أهل الثغر 
ms1479	 كان لا يأكل إلا الحلال المحض فإن وجده وإلا استف الرمل من أقران إبراهيم بن أدهم حكاياته في تعبده أشهر من أن يحتاج إلى الإغراق في ذكره ما له حديث مستقيم يرجع إليه(@)(@@)(@@)(@@) $ 13431 - سليمان بن داود بن داود بن علي بن عبد الله بن عباس بن عبد المطلب أبو أيوب الهاشمي سكن بغداد يروي عن أبي الزناد وإبراهيم بن سعد روى عنه إسماعيل بن سعيد الشالنجي والناس(@)(@@)(@@)(@@) $ 13432 - سليمان بن عبد الرحمن الإسكندراني شيخ يروي عن القاسم بن معن روى عنه رجل مجهول يقال له موسى بن عيسى الجزري(@)(@@)(@@)(@@) $ 13433 - سليمان بن عمر بن الوليد بن عبد ربه بن مسعود بن خالد بن عبد العزيز بن سلامة الكعبي أحد بنى حتر من أهل مكة يروي عن عمه سعيد بن الوليد أبي معرف روى عنه يعقوب بن سفيان الفارسي PageV08P277(@)(@@)(@@)(@@) $ 13434 - سليمان بن محمد المباركي أبو داود يروي عن أبي شهاب الحناط حدثنا عنه الحسن بن عبد الجبار ببغداد ومبارك التي ينتسب إليها قرية على الدجلة فوق واسط دخلتها مات سنة إحدى وثلاثين ومائتين(@)(@@)(@@)(@@) $ 13435 - سليمان بن عبد الرحمن بن ابنة شرحبيل من أهل دمشق كنيته أبو أيوب يروي عن الوليد بن مسلم والشاميين روى عنه أبو زرعة وأبو حاتم كان مولده سنة ثلاث وخمسين ومائة ومات سنة ثلاث وثلاثين ومائتين وصلى عليه مالك بن نطوف يعتبر حديثه إذا روى عن الثقات المشاهير فأما روايته عن الضعفاء والمجاهيل ففيها مناكير كثيرة لا اعتبار بها وإنما يقع السبر في الأخبار والاعتبار بالآثار برواية العدول والثقات دون الضعفاء والمجاهيل(@)(@@)(@@)(@@) $ 13436 - أبو الربيع الزهراني العتكي اسمه سليمان بن داود من أهل البصرة يروي عن حماد بن زيد وفليح حدثنا عنه الحسن بن سفيان وأبو يعلى وذووهما مات في آخر سنة أربع وثلاثين ومائتين(@)(@@)(@@)(@@) $ 13437 - سليمان بن داود أبو الربيع الختلي البغدادي يروي عن محمد بن حرب الأبرش ثنا عنه أبو يعلى الموصلي وليس هذا بالزهراني PageV08P278(@)(@@)(@@)(@@) $ 13438 - سليمان بن أيوب صاحب البصري يروي عن حماد 
ms1480	 بن زيد والبصريين ثنا عنه الحسن بن سفيان وغيره(@)(@@)(@@)(@@) $ 13439 - سليمان بن منصور البلخي يروي عن مسلم بن خالد الزنجي روى عنه أحمد بن علي الأبار مستقيم الحديث(@)(@@)(@@)(@@) $ 13440 - سليمان بن عبيد الله أبو أيوب الرقى يروي عن عبيد الله بن عمر الرقى والجزريين روى عنه عمرو بن محمد الناقد مات قبل سنة أربعين ومائتين(@)(@@)(@@)(@@) $ 13441 - سليمان بن داود بن حماد بن سعد بن أخي رشدين بن سعد كنيته أبو الربيع كان عابدا من العباد يروى عن بن بكير وابن وهب مات بعد سنة خمس ومائتين(@)(@@)(@@)(@@) $ 13442 - سليمان بن داود الشاذكوني أبو أيوب المنقري يروي عن أهل العراق وكان يحفظ حتى ذكر في الحفاظ إلا أنه لم يصف نفسه حتى يرد في القلوب ثنا عنه أبو يعلى وغيره من شيوخنا ونحن نسأل الله تعالى جميل الستر بمنه وفضله(@)(@@)(@@)(@@) $ 13443 - سليمان بن عثمان بن الوليد بن عبد الله بن مسعود بن خالد بن عبد العزيز بن سلامة الكثى أحد بنى حبثر من أهل مكة يروي عن PageV08P279 عمه سعيد بن الوليد وأهل النجار روى عنه يعقوب بن سفيان(@)(@@)(@@)(@@) $ 13444 - سليمان بن عمر بن خالد المعروف بابن الأقطع من أهل الرقة كنيته أبو أيوب يروي عن مطرف بن زمان وأهل بلده حدثنا عنه شيوخنا الخضر بن أحمد بن قيدهوز بحران وغيره مات سنة تسع وأربعين ومائتين(@)(@@)(@@)(@@) $ 13445 - سليمان بن قريش من أهل مرو الروذ يروي عن حرير وأبى معاوية ووكيع روى عنه أحمد بن سيار مستقيم الحديث(@)(@@)(@@)(@@) $ 13446 - سليمان بن داود بن صالح بن حسان الثقفي القزاز أبو أحمد من أهل الري يروي عن أبي أسامة وأبى عاصم روى عنه أهل بلده كان أصله من جرجان(@)(@@)(@@)(@@) $ 13447 - سليمان بن عبد الجبار أبو أيوب البغدادي يروي عن عبيد الله بن موسى وأبى عاصم حدثنا عنه محمد بن إسحاق بن إبراهيم مولى ثقيف(@)(@@)(@@)(@@) $ 13448 - سليمان بن حسان أبو عبد الله من أهل الشام يروي عن شريك روى أبو زرعة الرازي عن علي بن هاشم بن 