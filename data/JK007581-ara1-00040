ms21	 الدجى % % ونازعت شمس الضحى أوجها % % 2(@)(@@) % لما كنت أفضل في حالة % من الكلب كلا ولا أوجها % % PageV01P195 البحر : - 1(@)(@@) % إن لي في الهوى لسانا كتوما % وجنانا يخفي حريق جواه % % 2(@)(@@) % غير أني أخاف دمعي عليه % % ستراه يفشي الذي ستراه % % PageV01P196 البحر : - 1(@)(@@) % نبت بك عن أوطان عزك غيبة % فكنا كزند عطلت من سوارها % % 2(@)(@@) % وكنت الثريا حين عادت وأشرقت % أمنا بها الآفات بعد حذارها % % PageV01P197 البحر : - 1(@)(@@) % أقول لشادن في الحسن فرد % يصيد بلحظة قلب الكمي % 2(@)(@@) % ملكت الحسن أجمع في قوام % فاد زكاة منظرك البهي % 3(@)(@@) % وذلك أن تجود لمستهام % بريق من مقبلك الشهي % % 4(@)(@@) % فقال أبو حنيفة لي إمام % فعندي لا زكاة على الصبي % PageV01P198 البحر : - 1(@)(@@) % تفاءلت للمولود في بطن مصحف % فبشر بإبن قادم إسمه يحيى % % 2(@)(@@) % فأصدق به من مخبر ومبشر % وأحر بأن أسميه يحيى لكي يحيا % % 3(@)(@@) % وإني لأرجو الله يسعد جده % % فيحظى بفوز في الممات وفي المحيا % % 4(@)(@@) % ويكسى رداء العلم والحلم والتقى % % فيدرك عقبى من تعفف واستحيا % % 5(@)(@@) % ومما يقوى فيه ظني أنه % % سمي نبي مرسل شافه الوحيا % % PageV01P199 البحر : - 1(@)(@@) % قد كان من زهرات العيش لي غصن % يميس لطفا وطول الدهر أجنيه % % 2(@)(@@) % إذا خلوت فريحان أشممه % % وإن خلوت فقمري أنا غيه % % 3(@)(@@) % وإن شكوت من الأيام نازلة % سليت قلبي به مما أقاسيه % % 4(@)(@@) % أضحى يرفرف قلبي حوله شفقا % ويشفق النفس من سوء يدانيه % % 5(@)(@@) % من يدي حتى شوى كبدي % % كيد من الدهر لا تعدي مراميه % % 6(@)(@@) % لم أنسه والردى يمحو ملاحته % % ولحظه قاصد طرفي يناجيه % % 7(@)(@@) % حيران يبغي دواعي ما ألم به % % وليس بي حيلة فيه فأكفيه % % 8(@)(@@) % وقد تبدل من سكر الشباب ضحى % بسكرة الموت تعلو في تراقيه % % 9(@)(@@) % وللحياة وجود في جوارحه % % وللوسامة ذوب في مآقيه % % 10(@)(@@) % تحنوالمنون إلى حوبائه ولعا % يهدم الشيء يأبى أن يدانيه % % PageV01P200 11(@)(@@) % مبد أسرته مما يساورها % % رشحا تنافسه حسنا لآليه % % 12(@)(@@) % ما زال في أنة موصولة بشجى % % يديم لي نفسا تدمي مجاريه % % 13(@)(@@) % حتى خبا نور وجه لا خفاء 
ms22	 به % % وألهبت نار وجد كنت أخفيه % % 14(@)(@@) % آليت لا أقتني علقا بقاسمه % % أيدي الردى قسما يوما أواليه % % PageV01P201 البحر : - 1(@)(@@) % أبا بشر فقدت لذيذ عيشي % % بفقدي طيب عشرتك الرضيه % % 2(@)(@@) % قضى دهر بتفريق علينا % % خؤون شأنه جور القضيه % % 3(@)(@@) % دجت أيامنا مذ غبت عنا % % وكانت منك مشرقة مضيه % % PageV01P202 
