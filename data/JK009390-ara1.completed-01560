ms1549	 رغبة فيما عندي وشفقة مما عندي ، ورجل غزا في سبيل الله فانهزم فعلم ما عليه فرجع حتى أهريق دمه ، فيقول الله عز وجل لملائكته : انظروا إلى عبدي رجع رغبة فيما عندي وشفقة مما عندي حتى أهريق دمه ) )(@)(@@) ( حم ) و ابن نصر ( طب حب ك هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14077 ) قال النبي :(@)(@@) | 30 ( عجبا لغافل ولا يغفل عنه ، وعجبا لطالب دنيا والموت يطلبه ، وعجبا لضاحك ملء فيه لا يدري أأرضى الله أم أسخطه ) )(@)(@@) ( أبو الشيخ حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14078 ) قال النبي :(@)(@@) | 30 ( عجليها يا أ| م أنس ، إذا ملأ الليل بطن كل واد فقد حل وقت الصلاة فصلي ولا إثم عليك ) )(@)(@@) ( طب ) عن أم أنس قالت : قلت : يا رسول الله إن عيني تغلبني عن عشاء الآخرة قال : فذكره .(@)(@@) PageV05P162(@)(@@)(@@)(@@) ||| ( العين مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14079 ) قال النبي :(@)(@@) | 30 ( عدة المؤمن دين ، وعدة المؤمن كالأخذ باليد ) )(@)(@@) ( فر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14080 ) قال النبي :(@)(@@) | 30 ( عدد آنية الحوض كعدد نجوم السماء ) )(@)(@@) أبو بكر بن أبي داود في البعث عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14081 ) قال النبي :(@)(@@) | 30 ( عد الأي في الفريضة والتطوع ) )(@)(@@) ( خط ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14082 ) قال النبي :(@)(@@) | 30 ( عدد آنية الجنة ع 2 دد آي القرآن ، فمن دخل الجنة من أهل القرآن فليس فوقه درجة ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14083 ) قال النبي :(@)(@@) | 30 ( عدل صوم عرفة بسنتين : سنة مقبلة ، وسنة متأخرة ) )(@)(@@) ( قط ) في الأفراد و ابن مردويه ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14084 ) قال النبي :(@)(@@) | 30 ( عد من لا يعودك ، وأهد لمن لا يهدي لك ) )(@)(@@) ( تخ هب ) عن أيوب بن ميسرة مرسلا .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 14085 ) قال النبي :(@)(@@) | 30 ( عدد درج الجنة عدد آي القرآن ، فمن دخل الجنة من أهل القرآن فليس فوقه درجة ) )(@)(@@) ( ك ) في تاريخه ( هب ) عن عائشة وقال ( هب ) إسناده صحيح وهو من الشواذ ( ش ) عن عائشة رضي الله عنه موقوفا 
ms1550	 .(@)(@@)(@@)(@@) $ ( 14086 ) قال النبي :(@)(@@) | 30 ( عدهن بين يدي جبريل وقال جبريل : هاكذا أنزلت PageV05P163 من عند رب العزة : اللهم صل على محمد وعلى آل محمد كما صليت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد ، اللهم بارك على محمد وعلى آل محمد كما باركت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد ، اللهم وترحم على محمد وعلى آل محمد كما ترحمت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد ، اللهم وتحنن على محمد وعلى آل محمد كما تحننت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد ، اللهم وسلم على محمد وعلى آل محمد كما سلمت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد ) )(@)(@@) ( هب ) وضعفه و الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14087 ) قال النبي :(@)(@@) | 30 ( عدد آنية الحوض كعدد نجوم السماء ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14088 ) قال النبي :(@)(@@) | 30 ( عدل يوم واحد أفضل من عبادة ستين سنة ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( العين مع الذال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14089 ) قال النبي :(@)(@@) | 30 ( عذاب القبر حق ) )(@)(@@) ( خط ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14090 ) قال النبي :(@)(@@) | 30 ( عذاب القبر حق ، فمن لم يؤمن به عذب فيه ) )(@)(@@) ابن منيع عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14091 ) قال النبي :(@)(@@) | 30 ( عذاب القبر من أثر البول فمن أصابه بول PageV05P164 فليغسله ، فإن لم يجد ماء فليمسحه بتراب طيب ) )(@)(@@) ( طب ) عن ميمونة بنت سعد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14092 ) قال النبي :(@)(@@) | 30 ( عذاب أمتي في دنياها ) )(@)(@@) ( طب ك ) عن عبد الله بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14093 ) قال النبي :(@)(@@) | 30 ( عذاب هاذه الأمة جعل بأيديها في دنياها ) )(@)(@@) ( ك ) عن عبد الله بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14094 ) قال النبي :(@)(@@) | 30 ( عذبت امرأة في هرة حبستها حتى ماتت جوعا فدخلت فيها النار ، قال الله : لا أنت أطعمتيها ولا سقيتيها حين حبستيها ، ولا أنت أرسلتيها فأكلت من خشاش الأرض ) )(@)(@@) ( حم ق ) عن ابن عمر ( قط ) في الأفراد عن أبي هريرة رضي الله عنهم ( ز 
ms1551	 ) .(@)(@@)(@@)(@@) $ ( 14095 ) قال النبي :(@)(@@) | 30 ( عذبت امرأة في هر ربطته حتى مات ولم ترسله فيأكل من خشاش الأرض ، فوجبت لها النار بذالك ) )(@)(@@) ( حم ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) ||| ( العين مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14096 ) قال النبي :(@)(@@) | 30 ( عرى الإسلام وقواعد الدين ثلاثة عليهن أسس الإسلام ، من ترك واحدة منهن فهو بها كافر حلال الدم : شهادة أن لا إلاه إلا الله ، والصلاة المكتوبة ، وصوم رمضان ) )(@)(@@) ( ع ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV05P165(@)(@@)(@@)(@@) $ ( 14097 ) قال النبي :(@)(@@) | 30 ( عرامة الصبي في صغره زيادة في عقله في كبره ) )(@)(@@) الحكيم عن عمرو بن معدي كرب ، أبو موسى المديني في أماليه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14098 ) قال النبي :(@)(@@) | 30 ( عربوا العربي ، وهجنوا الهجين ، للعربي سهمان وللهجين سهم ) )(@)(@@) ( عد هق ) عن مكحول عن زيادة بن حارثة عن حبيب بن مسلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 14099 ) قال النبي & : ' عربوا العربي ، وهجنوا الهجين ، للعربي سهمان وللهجين سهم ' ( عد هق ) عن مكحول عن زيادة بن حارثة عن حبيب بن مسلمة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14100 ) قال النبي :(@)(@@) | 30 ( عرج بي حتى ظهرت بمستوى أسمع فيه صريف الأقلام ) )(@)(@@) ( خ طب ) عن ابن عباس وأبي حبة البدري رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14101 ) قال النبي :(@)(@@) | 30 ( عريش كعريش موسى ) )(@)(@@) ( هق ) عن سالم بن عطية مرسلا .(@)(@@)(@@)(@@) $ ( 14102 ) قال النبي :(@)(@@) | 30 ( عرضت علي أجور أمتي حتى القذاة يخرجها الرجل من المسجد ، وعرضت علي ذنوب أمتي فلم أر ذنبا أعظم من سورة من القرآن أو آية أوتيها رجل ثم نس يها ) )(@)(@@) ( د ت ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14103 ) قال النبي :(@)(@@) | 30 ( عرضت علي الأمم فرأيت النبي ومعه الرهط ، والنبي ومعه الرجل والرجلان ، والنبي وليس معه أحد ، إذا رفع لي سواد عظيم فظننت أنهم أمتي ، فقيل لي : هاذا موسى وقومه ، ولاكن انظر إلى الأفق فإذا سواد عظيم ، فقيل لي : انظر إلى الأفق الآخر فإذا سواد عظيم فقيل لي : هاذه أمتك ومعهم سبعون ألفا يدخلون الجنة بغير حساب ولا عذاب ، هم الذين لا يرقون ولا PageV05P166 يسترقون 
ms1552	 ، ولا يتطيرون ولا يكتوون وعلى ربهم يتوكلون ) )(@)(@@) ( حم ق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 14104 ) قال النبي :(@)(@@) | 30 ( عرضت علي الأيام فعرض علي فيها يوم الجمعة فإذا هي كامرأة بيضاء ، وإذا في وسطها نكتة سوداء : فقلت : ما هاذه ؟ قيل : الساعة ) )(@)(@@) ( طس ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14105 ) قال النبي :(@)(@@) | 30 ( عرضت علي الجنة حتى لو مددت يدي تناولت من قطوفها ، وعرضت علي النار فجعلت أنفخ خشية أن يغشاكم حرها ، ورأيت فيها سارق بدنة رسول الله ، ورأيت فيها أخا بني دعدع سارق الحجيج فإذا فطن له قال : هاذا عمل المحجن ، ورأيت فيها امرأة طويلة سوداء تعذب في هرة ربطتها فلم تطعمها ولم تسقها ولم تدعها تأكل من خشاش الأرض حتى ماتت ، وإن الشمس والقمر لا ينكسفان لموت أحد ولا لحياته ولاكنهما آيتان من آيات الله ، فإذا انكسف أحدهما فاسعوا إلى ذكر الله عز وجل ) )(@)(@@) ( ن ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 14106 ) قال النبي :(@)(@@) | 30 ( عرضت علي الجنة والنار آنفا في عرض هاذا الحائط فلم أر كاليوم في الخير والشر ، ولو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا ) )(@)(@@) ( م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14107 ) قال النبي :(@)(@@) | 30 ( عرضت علي أمتي البارحة لدى هاذه الحجرة حتى لأنا أعرف بالرجل منهم من أحدكم بصاحبه ، صوروا لي في الطين ) )(@)(@@) ( طب ) و الضياء عن حذيفة بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14108 ) قال النبي :(@)(@@) | 30 ( عرضت علي أمتي بأعمالها حسنها وسيئها ، فرأيت PageV05P167 في محاسن أعمالها : إماطة الأذى عن الطريق ، ورأيت في سيء أعمالها : النخاعة في المسجد لم تدفن ) )(@)(@@) ( حم م ه ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14109 ) قال النبي :(@)(@@) | 30 ( عرض علي الأنبياء ، فإذا موسى ضرب من الرجال كأنه من رجال شنوءة ، ورأيت عيسى بن مريم فإذا أقرب من رأيت به شبها عروة بن مسعود ، ورأيت إبر اهيم فإذا أقرب من رأيت به شبها صاحبكم يعني نفسه ورأيت جبريل فإذا أقرب من رأيت به شبها دحية ) )(@)(@@) ( م ت ) عن جابر 
ms1553	 رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14110 ) قال النبي :(@)(@@) | 30 ( عرض علي أول ثلاثة يدخلون الجنة : شهيد ، وعفيف متعفف ، وعبد أحسن عبادة الله تعالى ونصح لمواليه ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14111 ) قال النبي :(@)(@@) | 30 ( عرض علي أول ثلاثة يدخلون الجنة ، وأول ثلاثة يدخلون الجنة : فالشهيد ، ومملوك أحسن عبادة ربه ونصح لسيده ، وعفيف متعفف ؛ وأما أول ثلاثة يدخلون النار : فأمير مسلط ، وذو ثروة من مال لا يؤدي حق الله في ماله ، وفقير فخور ) )(@)(@@) ( حم ك هف ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14112 ) قال النبي :(@)(@@) | 30 ( عرض علي ربي ليجعل لي بطحاء مكة ذهبا فقلت : لا يا رب ولاكني أشبع يوما وأجوع يوما ، فإذا جعت تضرعت إليك وذكرتك ، وإذا شبعت حمدتك وشكرتك ) )(@)(@@) ( حم ت ) عن أبي أمامة رضي الله عنه .(@)(@@) PageV05P168(@)(@@)(@@)(@@) $ ( 14113 ) قال النبي :(@)(@@) | 30 ( عرف الحق لأهله ) )(@)(@@) ( حم ك ) عن الأسود بن سريع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14114 ) قال النبي :(@)(@@) | 30 ( عرفت جعفرا في رفقة من الملائكة يبشرون أهل بيته بالمطر ) )(@)(@@) ( عد ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14115 ) قال النبي :(@)(@@) | 30 ( عرفة اليوم الذي يعرف فيه الناس ) )(@)(@@) ابن منده وابن عساكر عن عبد الله بن خالد بن أسيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14116 ) قال النبي :(@)(@@) | 30 ( عرفة كلها موقف ) )(@)(@@) ( ن ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14117 ) قال النبي :(@)(@@) | 30 ( عرفة كلها موقف وارتفعوا عن بطن عرنة ، ومزدلفة كلها موقف وارتفعوا عن بطن محسر ، ومنى كلها منحر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14118 ) قال النبي :(@)(@@) | 30 ( عريشا كعريش موسى : ثمام وخشيبات والأمر أعجل من ذالك ) )(@)(@@) المخلص في فوائده وابن النجار عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 14119 ) قال النبي :(@)(@@) | 30 ( عرج بي إلى السماء ، فما مررت بسماء إلا وجدت فيها اسمي مكتوبا : محمد رسول الله وأبو بكر الصديق خلفي ) )(@)(@@) الحسن بن عرفة في جزئه ( عد حل ) في فضائل الصحابة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14120 ) قال النبي :(@)(@@) | 30 ( عرض إلي ملك استأذن أن يسلم 
ms1554	 علي ويبشرني PageV05P169 ببشرى أن فاطمة سيدة نساء أهل الجنة ، وأن الحسن والحسين سيدا شباب أهل الجنة ) )(@)(@@) الروياني ( حب ك ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14121 ) قال النبي :(@)(@@) | 30 ( عرضت علي الذنوب فلم أر فيها شيئا أعظم من حامل القرآن وتاركه ) )(@)(@@) ( ش ) عن الوليد بن عبد الله بن أبي مغيث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14122 ) قال النبي :(@)(@@) | 30 ( عرضت علي النار فرأيت فيها عمرو بن لحي بن قمعة بن خندف يجر قصبه في النار وهو أول من غير عهد إبراهيم فسيب السوائب وغير البحائر ، وحمى الحامي ، ونصب الأوثان ، وأشبه من رأيت به أكتم بن أبي الجون ، فقال أكتم : يا رسول الله أيضرني شبهه ؟ قال : لا ، إنك مسلم وإنه كافر ) )(@)(@@) ( حم ش ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14123 ) قال النبي :(@)(@@) | 30 ( عرضت علي الجنة بما فيها من الزهرة فتناولت منها قطفا من عنب لآتيكم به فحيل بيني وبينه ، ولو أتيتكم به لأكل منه من بين السماء والأرض ولا ينقص منه ، ثم عرضت علي النار فلما وجدت سفعها تأخرت عنها ، وأكثر من رأيت فيها النساء اللاتي إن ائتمن أفشين ، وإن سألن ألحفن ، وإن سئلن يخلفن ، ورأيت فيها عمرو بن لحي يجر قصبه في النار وأشبه من رأيت به معبد بن أكتم الكعبي ، فقال معبد : يا رسول الله أيخشى علي من شبهه ؟ قال : لا ، أنت مؤمن وهو كافر ، وكان أول من حمل العرب على عبادة الأصنام ) )(@)(@@) ( حم ) عبد بن حميد ( ع ) والشاشي ( ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14124 ) قال النبي :(@)(@@) | 30 ( عرضت علي الجنة فذهبت أتناول منها قطفا أريكموه فحيل بيني وبينه ، قيل : يا رسول الله مثل ماء الحبة من العنب ؟ قال : كأعظم دلو فرت أمك قط ) )(@)(@@) ( خ ض ) عن أبي سعيد رضي الله عنه .(@)(@@) PageV05P170(@)(@@)(@@)(@@) $ ( 14125 ) قال النبي :(@)(@@) | 30 ( عرضت علي الأنبياء باسمها فجعل النبي يمر ومعه الثلاثة ، والنبي ومعه العصابة ، والنبي ومعه النفر ، والنبي وليس معه أحد ، حتى عرض علي موسى معه كبكبة من بني إسرائيل فأعجبوني ، فقلت : من هاؤلاء ؟ فقيل 
ms1555	 : هاذا أخوك موسى ومعه بنو إسرائيل ، قلت : فأين أمتي ؟ قيل : انظر عن يمينك فنظرت فإذا الظرب تدسه بوجوه الرجال ، ثم قيل لي : انظر عن يسارك ، فنظرت ، فإذا الأفق قد سد بوجوع الرجال ، فقيل لي : أرضيت ؟ فقلت : رضيت يا رب ، رضيت يا رب ، فقيل : إن مع هاؤلاء سبعين ألفا يدخلون الجنة بغير حساب ، فدى لكم أبي وأمي إن استطعتم أن تكونوا من السبعين ألفا فافعلوا ، فإن قصرتم فكونوا من أهل الظراب ، فإن قصرتم فكونوا من أهل الأفق ، فإني قد رأيت أنا سآتيها وشرق كثير إني لأرجو أن يكون من تبعني ربع أهل الجنة ، إني لأرجو أن تكونوا شطر أهل الجنة ، فقام عكاشة فقال : ادع لي يا رسول الله أن يجعلني من السبعين ألفا ، فقال : قد سبقك بها عكاشة ، فقيل : من هاؤلاء السبعون الألف ؟ قال : هم الذين لا يكتوون ولا يسترقون ولا يتطيرون وعلى ربهم يتوكلون ) )(@)(@@) ( عب ) عن المصنف ( حم طب ك ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14126 ) قال النبي :(@)(@@) | 30 ( عرف الحق لأهله ) )(@)(@@) ( حم طب ك هب ض ) عن الأسود بن سريع قال : جيء بأسير إلى رسول الله فقال : أتوب إلى الله ولا أتوب إلى محمد قال : فذكره .(@)(@@)(@@)(@@) $ ( 14127 ) قال النبي :(@)(@@) | 30 ( عرفة كلها موقف ) )(@)(@@) ( م ن ) عن جابر رضي الله عنه .(@)(@@) PageV05P171(@)(@@)(@@)(@@) $ ( 14128 ) قال النبي :(@)(@@) | 30 ( عرفة كلها موقف إلا بطن عرنة ، والمزدلفة كلها موقف إلا بطن محسر ) )(@)(@@) ابن قانع ( حل ) عن حبيب بن خماشة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14129 ) قال النبي :(@)(@@) | 30 ( عرفوا عليكم عرفاء وأدوا زكاتكم فلا دين إلا بزكاة ، قيل : وما الزكاة يا رسول الله ؟ قال : زكاة الرقاب وكاة الأموال ) )(@)(@@) ابن منده عن نعيم بن طريف في معروف بن عمرو بن حزابة عن أبيه عن جده عن أبيه حزابة بن نعيم الضباني وفي سنده من لا يعرف .(@)(@@)(@@)(@@) ||| ( العين مع الزاي(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14130 ) قال النبي :(@)(@@) | 30 ( عزمة على أمتي أن لا يتكلموا في القدر ) )(@)(@@) ( خط ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14131 ) قال النبي :(@)(@@) | 30 ( عزمة 
ms1556	 على أمتي أن لا يتكلموا في القدر ، ولا يتكلم في القدر إلا شرار أمتي في آخر الزمان ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14132 ) قال النبي :(@)(@@) | 30 ( عزير على الله تعالى أن يأخذ كريمتي عبد مسلم ثم يدخله النار ) )(@)(@@) ( حم طب ) عن عائشة بنت قدامة رضي الله عنها .(@)(@@) PageV05P172(@)(@@)(@@)(@@) ||| ( العين مع السين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14133 ) قال النبي :(@)(@@) | 30 ( عسى رجل يحدث بما يكون بينه وبين أهله ، أو عسى امرأة تحدث بما يكون بينها وبين زوجها فلا تفعلوا ، فإن مثل ذالك مثل شيطان لقي شيطانة في ظهر الطريق فغشيها والناس ينظرون ) )(@)(@@) ( طب ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 14134 ) قال النبي :(@)(@@) | 30 ( عسى أن تدركوا أقواما يؤثرون أموالا ، وإنما يكفي أحدكم من الدنيا دار ومركب في سبيل الله ) )(@)(@@) ( طب ) عن أبي هاشم بن عتبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14135 ) قال النبي :(@)(@@) | 30 ( عسى أحدكم أن يكذبني وهو متكىء على أريكته يبلغه الحديث عني فيقول : ما قال ذا رسول الله ، دع هاذا وهات ما في القرآن ؟ ) )(@)(@@) أبو يعلى أبو نصر السجزي في الإبانة وقال : حسن غريب عن جابر أبو ثغر عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14136 ) قال النبي :(@)(@@) | 30 ( عسى رجل يحضر الجمعة وهو على قدر ميل من المدينة لا يحضر الجمعة ، عسى رجل يحضر الجمعة وهو على قدر ميلين من المدينة لا يحضر الجمعة عسى رجل يكون على قدر ثلاثة أميال من المدينة لا يحضر الجمعة فيطبع الله على قلبه ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14137 ) قال النبي :(@)(@@) | 30 ( عسى أحدكم أن يتخذ الصبة من الغنم على رأس الميلين أو الثلاثة فتكون الجمعة فلا يشهدها ، ثم تكون فلا يشهدها ، ثم تكون فلا PageV05P173 يشهدها فيطبع الله على قلبه ) )(@)(@@) ( ش ) عن محمد بن عباد بن جعفر مرسلا .(@)(@@)(@@)(@@) ||| ( العين مع الشين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14138 ) قال النبي :(@)(@@) | 30 ( عشر خصال عملها قوم لوط بها أهلكوا وتزيدها أمتي بخلة : إتيان الرجال بعضهم بعضا ، ورميهم بالجلاهق والخذف 
ms1557	 ، ولعبهم بالحمام ، وضرب الدفوف ، وشرب الخمور ، وقص اللحية ، وطول الشارب ، والصفير والتصفيق ، ولباس الحرير ، وتزيدها أمتي بخلة : إتيان النساء بعضهن بعضا ) )(@)(@@) ابن عساكر عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 14139 ) قال النبي :(@)(@@) | 30 ( عشر من الفطرة : قص الشارب ، وإعفاء اللحية ، والسواك ، واستنشاق الماء ، وقص الأظفار ، وغسل البراجم ، ونتف الإبط ، وحلق العانة ، وانتقاص الماء ) )(@)(@@) ( حم م 4 ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14140 ) قال النبي :(@)(@@) | 30 ( عشرة أبيات بالحجاز أبقى من عشرين بيتا بالشام ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14141 ) قال النبي :(@)(@@) | 30 ( عشرة في الجنة : النبي في الجنة ، وأبو بكر في الجنة ، وعمر في الجنة ، وعثمان في الجنة ، وعلي في الجنة ، وطلحة في الجنة ، والزبير بن العوام في الجنة ، وسعد بن مالك في الجنة ، وعبد الرحمان بن عوف في الجنة ، وسعيد بن زيد في الجنة ) )(@)(@@) ( حم د ه ) و الضياء عن سعيد بن زيد رضي الله عنه .(@)(@@) PageV05P174(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 14142 ) قال النبي :(@)(@@) | 30 ( عشر بين يدي الساعة : خسف بالمغرب ، وخسف بالمشرق ، وخسف بجزيرة العرب ، والدجال ، ونزول عيسى بن مريم ، والدجال ، ودابة الأرض ، ويأجوج ومأجوج ، وريح تسفيهم فتطرحهم بالبحر ، وطلوع الشمس من مغربها ) )(@)(@@) البغوي ( طب ) عن الربيع بن عصيلة عن أبي سريحة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14143 ) قال النبي :(@)(@@) | 30 ( عشر آيات بين يدي الساعة ) )(@)(@@) ابن السكن عن ربيعة الجرشي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14144 ) قال النبي :(@)(@@) | 30 ( عشر من قالهن في دبر صلواته إذا صلى : لا إلاه إلا الله وحده لا شريك له ، له الملك وله الحمد وهو على كل شيء قدير كتب الله بهن عشر حسنات عدل عشر رقاب ، وكن له حرسا من الشيطان حتى يمسي ، ومن قالهن حين يمسي كان مثل ذالك حتى يصبح ) )(@)(@@) ( طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14145 ) قال النبي :(@)(@@) | 30 ( عشرة من قريش في الجنة : أبو بكر في الجنة ، وعمر في الجنة ، وعثمان في الجنة ، وعلي في الجنة ، وطلحة في الجنة ، والزبير في الجنة ، وسعد في الجنة ، وسعيد في الجنة ، وعبد الرحمان بن عوف في 
ms1558	 الجنة ، وأبو عبيدة بن الجراح في الجنة ) )(@)(@@) ( طب كر ) عن ابن عمر ( ت ) وابن سعد ( قط ) في الأفراد ( ك ) وأبو نعيم في المعرفة ( كر ) عن سعد بن رجب رضي الله عنه .(@)(@@) PageV05P175(@)(@@)(@@)(@@) ||| ( العين مع الصاد(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14146 ) قال النبي :(@)(@@) | 30 ( عصبة من المسلمين يفتحون البيت الأبيض بيت كسرى ) )(@)(@@) ( حم م ) عن جابر بن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 14147 ) قال النبي :(@)(@@) | 30 ( عصابتان من أمتي أحرزهما الله من النار : عصابة تغزو الهند ، وعصابة تكون مع عيسى بن مريم ) )(@)(@@) ( حم ن ) و الضياء عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) ||| ( العين مع الضاد(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14148 ) قال النبي :(@)(@@) | 30 ( عضة نملة أشد على الشهيد من مس السلاح ، بل هو أشهى عنده من شراب ماء بارد لذيذ في يوم صائف ) )(@)(@@) أبو الشيخ عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) ||| ( العين مع الظاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14149 ) قال النبي :(@)(@@) | 30 ( عظم الأجر عند عظم المصيبة وإذا أحب الله قوما PageV05P176 ابتلاهم ) )(@)(@@) المحاملي في أماليه عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 14150 ) قال النبي :(@)(@@) | 30 ( عظم الله أجرك ورزقك العافية في دينك وجسمك إلى منتهى أجلك ، إن لك من وجعك خلالا ثلاثا : أما واحدة فتذكرة من ربك تذكره بها ، وأما الثانية فتمحيص لما سلف من ذنوبك ، وأما الثالثة : فادع بما شئت فإن دعاء المبتلى مجاب ) )(@)(@@) ابن أبي الدنيا ( كر ) عن يحيى بن أبي كثير قال : أتى رسول الله يعوده قال : فذكره .(@)(@@)(@@)(@@) ||| ( العين مع الفاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 14151 ) قال النبي :(@)(@@) | 30 ( عفوا تعف نساؤكم ) )(@)(@@) أبو القاسم بن بشران في أماليه ( عد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14152 ) قال النبي :(@)(@@) | 30 ( عفوا تعف نساؤكم ، وبروا آباءكم تبركم أبناؤكم ، ومن اعتذر إلى أخيه المسلم من شيء بلغه عنه فلم يقبل عذره لم يرد علي الحوض ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14153 ) قال النبي :(@)(@@) | 30 ( عفوا عن نساء الناس تعف نساؤكم ، وبروا آباءكم تبركم أبناؤكم ، ومن أتاه أوه 
