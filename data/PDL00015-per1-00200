ms193	 نجوم %~% از تو شادان اهل سنت همچو بیمار از شفا(@)(@@) 3 کس ندیده میل در حکمت چو در گردون فساد %~% کس ندیده جور در صدرت چو در جنت وبا(@)(@@) 4 بدر دین از نور آثار تو می‌گردد منیر %~% شاخ حرص از ابر احسان تو می‌یابد نما(@)(@@) 5 هر که شاگرد تو شد هرگز نگردد مبتدع %~% هر که مداح تو شد هرگز نگردد بی‌نوا(@)(@@) 6 ملک شرع مصطفا آراستی از عدل و علم %~% همچنان چون بوستانها را به فروردین صبا(@)(@@) 7 بدعت و الحاد و کفر از فر تو گمنام شد %~% شاد باش ای پیشکار دین و دنیا مرحبا(@)(@@) 8 تا گریبان قدر بگشاد چرخ آب گون %~% پاک دامن‌تر ز تو قاضی ندید اندر قضا(@)(@@) 9 گر چه ناهموار بود از پیشکاران کار حکم %~% پیش ازین لیکن ز فر عدلت اندر عهد ما(@)(@@) 10 آن چنان شد خاندان حکم کز بیم خدای %~% می‌کند مر خاک را از باد عدل تو جدا(@)(@@) 11 شد قوی دست آنچنان انصاف کز روی ستم %~% شمع را نکشد همی بی امر تو باد هوا(@)(@@) 12 روز و شب هستند همچون مادران مهربان %~% در دعای نیک تو هم مدعی هم مدعا(@)(@@) 13 دستها برداشته عمر تو خواهان از خدای %~% از برای پایداریت اهل شهر و روستا(@)(@@) 14 چون به شاهین قضا انصاف سنجی‌گاه حکم %~% جبرئیل از سد ره گوید با ملایک در ملا(@)(@@) 15 حشمت قاضی امین باید درین ره بدرقه %~% دانش قاضی امین زیبد درین در پادشا(@)(@@) 16 رایت دین هر زمان عالی همی گردد ز تو %~% ای نکو نام از تو شهر و ملک شاهنشه علا(@)(@@) 17 هر کسی صدر قضا جوید بی‌انصاف و عدل %~% لیک داند شاه ما از دانش و عقل و دها(@)(@@) 18 گرگ را بر میش کردن قهرمان باشد ز جهل %~% گربه را بر پیه کردن پاسبان باشد خطا(@)(@@) 19 از لقا و صدر و باد و داد و برد ابر 
ms194	 دو ریش %~% هیچ جاهل کی شدست اندر شریعت مقتدا(@)(@@) 20 علم و اصل و عدل و تقوی باید اندر شغل حکم %~% ور نه شوخی را به عالم نیست حد و منتها(@)(@@) 21 دان که هر کو صدر دین بی‌علم جوید نزد عقل %~% بر نشان جهل او خود قول او باشد گوا(@)(@@) 22 خود گرفتم هر کسی برداشت چوبی چون کلیم %~% معجزی باری بباید تا کند چوب اژدها(@)(@@) 23 هر کسی قاضی نگردد بی‌ستحقاق از لباس %~% هرکسی موسی نگردد بی‌نبوت از عصا(@)(@@) 24 دانش عبدالودودی باید اندر طبع و لفظ %~% تا بود مر مرد را در صدر دین زیب و بها(@)(@@) 25 ور نه بس فخری نباشد مر سها را از فلک %~% چون ندارد نور چون خورشید و مه نجم سها(@)(@@) 26 از قلب مفتی نگردد بی‌تعلم هیچ کس %~% علم باید تا کند درد حماقت را دوا(@)(@@) 27 صد علی در کوی ما بیش‌ست با زیب و جمال %~% لیک یک تن را نخواند هیچ عاقل مرتضا(@)(@@) 28 حاسدت روزه خموشی نذر کرد از عاجزی %~% تا تو بر جایی و بادت تا به یوم‌الدین بقا(@)(@@) 29 تا خمش باشد حسودت زان که تا بر چرخ شمس %~% جلوه‌گر باشد نباشد روزه بگشودن روا(@)(@@) 30 ای نبیره قاضی با محمدت محمود آنک %~% بود چون تو پاک طبع و پاک دین و پارسا(@)(@@) 31 دان که از فر تو و از دولت مسعود شاه %~% ملک دین شد با صیانت کار دین شد با نوا(@)(@@) 32 شاه ما محمودی و تو نیز محمودی چو او %~% شاد باش ای جان ما پیش دو محمودی فدا(@)(@@) 33 ملک چون در خانه محمودیان زیبد همی %~% همچنان در خانه محمودیان زیبد قضا(@)(@@) 34 هیچ چشم از هیچ قاضی آن ندید اندر جهان %~% کز تو دید این چشم من ز انعام و احسان و سخا(@)(@@) 35 لیک اگر همچون به خیلا بودی آن وعده دراز %~% گر دو چندان صله بودی هم 
ms195	 هبا بودی هبا(@)(@@) 36 هر عطا کاندر برات وعده افتاد ای بزرگ %~% آن عطا نبود که باشد مایه رنج و عنا(@)(@@) 37 لاجرم هر جا که رفتم نزد هر آزاد مرد %~% من ثنا گفتم ترا وان کو شنید از من دعا(@)(@@) 38 درها در رشته کردم بهر شکرت کز خرد %~% جوهری عقل داند کرد آن در را بها(@)(@@) 39 تو مرا این شکر و ثناها را غنیمت دان از آنک %~% بر صحیفه عمر نبود یادگاری چون ثنا(@)(@@) 40 تا بیابد حاجی و غازی همی اندر دو اصل %~% در مناسک حکم حج وندر سیر حکم غزا(@)(@@) 41 از چنین ارکانها چون حاجیان بادت ثواب %~% وز چنین انصافها چون غازیان بادت جزا(@)(@@) 42 باد شام حاسدت تا روز عقبی بی‌صباح %~% باد صبح تا صحت چون روز محشر بی مسا(@)(@@) 43 بادی اندر دولت و اقبال تا باشد همی %~% از ثنا و شکر و مدح تو سنایی را سنا PageV1P0439(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 کفر و ایمان را هم اندر تیرگی هم در صفا %~% نیست دارالملک جز رخسار و زلف مصطفا(@)(@@) 2 موی و رویش گر به صحرا نا وریدی مهر و لطف %~% کافری بی‌برگ ماندستی و ایمان بی‌نوا(@)(@@) 3 نسخه جبر و قدر در شکل روی و موی اوست %~% این ز «واللیل» ت شود معلوم آن از «والضحا»(@)(@@) 4 گر قسیم کفر و ایمان نیستی آن زلف و رخ %~% کی قسم گفتی بدان زلف و بدان رخ پادشا(@)(@@) 5 کی محمد: این جهان و آن جهانی نیستی %~% لاجرم اینجا نداری صدر و آنجا متکا(@)(@@) 6 رحمتت زان کرده‌اند این هر دو تا از گرد لعل %~% این جهان را سرمه بخشی آن جهان را توتیا(@)(@@) 7 اندرین عالم غریبی زان همی گردی ملول %~% تا «ارحنا یا بلالت» گفت باید برملا(@)(@@) 8 عالمی بیمار بودند اندرین خرگاه سبز %~% قاید هر یک وبال و سایق هر یک وبا(@)(@@) 9 زان فرستادیمت اینجا تا ز روی عاطفت %~% عافیت 
ms196	 را همچو استادان درآموزی شفا(@)(@@) 10 گر ز داروخانه روزی چند شاگردت به امر %~% شربتی ناوردشان این جا به حکم امتلا(@)(@@) 11 گر ترا طعنی کنند ایشان مگیر از بهر آنک %~% مردم بیمار باشد یافه گوی و هرزه لا(@)(@@) 12 تابش رخسار تست آن را که می‌خوانی صباح %~% سایه زلفین تست آنجا که می‌گویی مسا(@)(@@) 13 روبروی تو کز آنجا جانت را «ما و دعک» %~% شو به زلف تو کزین آتش دلت را «ما قلا»(@)(@@) 14 در دو عالم مر ترا باید همی بودن پزشک %~% لیکن آنجا به که آنجا به بدست آید دوا(@)(@@) 15 هر که اینجا به نشد آنجا برو داروش کن %~% کاین چنین معلول را به سازد آن آب و هوا(@)(@@) 16 لاجرم چندان شرابت بخشم از حضرت که تو %~% از عطا خشنود گردی و آن ضعیفان از خطا(@)(@@) 17 دیو از دیوی فرو ریزد همی در عهد تو %~% آدمی را خاصه با عشق تو کی ماند جفا(@)(@@) 18 پس بگفتش: ای محمد منت از ما دار از آنک %~% نیست دارالملک منتهای ما را منتها(@)(@@) 19 نه تو دری بودی اندر بحر جسمانی یتیم %~% فضل ما تاجیت کرد از بهر فرق انبیا(@)(@@) 20 نی تو راه شهر خود گم کرده بودی ز ابتدا %~% ما ترا کردیم با همشهریانت آشنا(@)(@@) 21 غرقه دریای حیرت خواستی گشتن ولیک %~% آشنایی ما برونت آورد ازو بی‌آشنا(@)(@@) 22 بی نعمت خواست کردن مر ترا تلقین حرص %~% پیش از آن کانعام ما تعلیم کردت کیمیا(@)(@@) 23 با تو در فقر و یتیمی ما چه کردیم از کرم %~% تو همان کن ای کریم از خلق خود با خلق ما(@)(@@) 24 مادری کن مر یتیمان را بپرورشان به لطف %~% خواجگی کن سایلان را طعمشان گردان وفا(@)(@@) 25 نعمت از ما دان و شکر از فضل ما کن تا دهیم %~% مر ترا زین شکر نعمت نعمتی دیگر جزا(@)(@@) 26 از زبان خود ثنایی گوی ما را 
ms197	 در عرب %~% تا زبان ما ترا اندر عجم گوید ثنا(@)(@@) 27 آفتاب عقل و جان اقضی القضاة دین که هست %~% چون قضای آسمان اندر زمین فرمانروا(@)(@@) 28 آن سر اصحاب نعمان کز پی کسب شرف %~% هر زمانی قبله بر پایش دهد قبله دعا(@)(@@) 29 با بقای عدل او نشگفت اگر در زیر چرخ %~% شخص حیوان همچو نوع و جنس نپذیرد فنا(@)(@@) 30 تا نسیم او بر بوستان دین نجست %~% شاخ دین نشو بود و بیخ سنت بی‌نما(@)(@@) 31 در حریم عدل او تا او پدید آید به حکم %~% خاصیت بگذاشت گاه که ربودن کهربا(@)(@@) 32 تا بگفت او جبریان را ماجرای امر و نهی %~% تا بگفت او عدلیان را رمز تسلیم و رضا(@)(@@) 33 باز رستند از بیان واضحش در امر و حکم %~% جبری از تعطیل شرع و عدی از نفی قضا(@)(@@) 34 این کمر ز «ایاک نعبد» بست در فرمان شرع %~% وان دگر تاجی نهاد از «یفعل الله مایشا»(@)(@@) 35 ای بنانت حاجب اندر شاهراه مصطفا %~% وی زبانت نایب اندر زخم تیغ مرتضا(@)(@@) 36 هر کجا گام تو آمد افتخار آرد زمین %~% هر کجا عدل تو آمد انقیاد آرد سما(@)(@@) 37 سیف حقی از پی آن سیف حق آمد روان %~% مفتی شرقی از آن مشرق شدست اصل ضیا(@)(@@) 38 مفتی شرقت نه زان خواند همی سلطان که هست %~% جز تو در مغرب دیگر مفتی و دگر مقتدا(@)(@@) 39 بلکه سلطان مفتی شرقت بدان خواند همی %~% هر کجا مفتی تو باشی غرب خود نبود روا(@)(@@) 40 همقرینی علم دین را همچو فکرت را خرد %~% همنشینی ظلم و کین را همچو فطنت را ذکا(@)(@@) 41 چون تو موسی وار بر کرسی برآیی گویدت %~% عیسی از چرخ چهارم کی محمد مرحبا(@)(@@) 42 جان پاکان گرسنه علم تواند از دیرباز %~% سفره اندر سفره بنهادی و در دادی صلا(@)(@@) 43 لطف لفظت کی شناسد مرد ژاژ و ترهات %~% «من و سلوی» را چه داند 
ms198	 مرد سیر و گندنا(@)(@@) 44 هر که از آزار تو پرهیز کرد از درد رست %~% راست گفتند این مثل «الا حتما اقوی الدوا»(@)(@@) 45 مالش دشمن ترا حاجت نیفتد بهر آنک %~% چاکری داری چو گردون کش همی درد قفا(@)(@@) 46 هر شقی کز آتش خشم تو گردد کام خشک %~% بر لب دریا به جانش آب نفروشد سقا(@)(@@) 47 لاف «نحن الغالبون» بسیار کس گفتند لیک %~% «غالبون» شان گشت «آمنا» چو ثعبان شد عصا(@)(@@) 48 زرق سیماب و رسن هرگز کجا ماندی بجای %~% چون برآید ناگه از دریای قدرت اژدها(@)(@@) 49 گه طلب کن بی سراج ماه در صحرای خوف %~% گه طلب کن بی‌مزاج زهره در باغ رجا(@)(@@) 50 ماه را آنجا نبود کو ترا گوید که چون %~% زهره را آن زهر نبود کو ترا گوید چرا(@)(@@) 51 رو که نیکو جلوه کردت روزگار اندر خلا %~% شو که زیبا پروریدت کردگار اندر ملا(@)(@@) 52 ای ز تو اعقاب تو طاهر چو سادات از نبی %~% وی ز تو اسلاف تو ظاهر چو ز آصف بر خیا(@)(@@) 53 باز یابی آنچه ایزد کرد با تو نیکویی %~% هم درین صورت که گفتی صورت این ماجرا(@)(@@) 54 این نه بس کاندر ادای شکر حق بر جان تو %~% دعوی انعام او را «واضحی» باشد گوا(@)(@@) 55 روز و شب در عالم اسلام علم و حلم تست %~% آن یکی از آل عباس این دگر ز آل عبا(@)(@@) 56 گر چه روزی چند گشتی گرد این مشکین بساط %~% گر چه روزی چند بودی گرد این نیلی غطا(@)(@@) 57 همچنان کاندر فضای آسمان مطلقی %~% صورتست این دار و گیر و حبس و بند اندر قضا(@)(@@) 58 نی به علم و حلم تو سوگند خوردست آفتاب %~% کز تو هرگز لطف یزدانی نخواهد شد جدا(@)(@@) 59 ای همه اعدای دین را اندرین نیلی خراس %~% آس کرده زیر پر فطنت و فر و دها(@)(@@) 60 بازتاب اکنون عنان هم سوی آن اقلیم 
ms199	 از آنک %~% آرد چون شد کرده اکنون خانه بهتر کاسیا(@)(@@) 61 تا همه آن بینی آنجا کت کند چشم آرزو %~% تا همه آن یابی آنجا کت کند رای اقتضا(@)(@@) 62 نی ز قصد حاسدانت در بدایت شهر تو %~% بر تو چونان بود چون بر آل یاسین کربلا(@)(@@) 63 نی ز اول دوستانت را نبودی با تو الف %~% نی چنان گشتی کنون کز خطبه چین و ختا(@)(@@) 64 از برای مهر چهر جانفزایت را همی %~% بر دو چشم مردمان غیرت بود مردم گیا(@)(@@) 65 نی کنون از لطف ربانی همه اقلیم شرع %~% از تو خرم شد چه بر داوودیان شهر سبا(@)(@@) 66 نی تو حیران مانده بودی در تماشاگه عجب %~% نی تو ره گم کرده بودی در بیابان ریا(@)(@@) 67 آن چنانت ره نمود ایزد به پاکی تا شدند %~% خرقه‌پوشان فلک در جنب تو ناپارسا(@)(@@) 68 نی تو در زندان چاه حاسدان بودی ببند %~% هم‌نشین ذل و غریبی هم عنان رنج و عنا(@)(@@) 69 نی خدا از چاه و بند حاسدانت از روی فضل %~% بر کشید و برنشاندت بر بساط کبریا(@)(@@) 70 بی‌پدر بودی ولیک اکنون چنانی کز شرف %~% پادشاه دین همی در دین پدر خواند ترا(@)(@@) 71 آن چنان گشتی که بد گویت کنون بی‌روی تو %~% نه همی در دل بهی بیند نه اندر جان بها(@)(@@) 72 ای یتیمی دیده اکنون با یتیمان لطف کن %~% وی غریبی کرده اکنون با غریبان کن وفا(@)(@@) 73 «الفلق» می‌خوان و می‌دان قصد این چندین حسود %~% «والضحی» می‌خوان و می‌کن شکر این چندین عطا(@)(@@) 74 ای مرا از یک نعم پیوسته با چندین نعم %~% وی مرا از یک بلی ببریده از چندین بلا(@)(@@) 75 شکرت ار بر کوه برخوانم به یک آواز من %~% از برای حرص مدحت صد همی گردد صدا(@)(@@) 76 شعر من نیک از عطای نیک تست ایرا که مرغ %~% هر کجا به برگ بیند به برون آرد نوا(@)(@@) 77 قربت تو 
ms200	 باز هستم کرد در صحرای انس %~% شربت تو باز مستم کرد در باغ صفا(@)(@@) 78 گر غنی شد جان و عقل از تو عجب نبود از آنک %~% آمدست این از پیمبر «طائف الحج الغنا»(@)(@@) 79 ور چه تن را این غرض حاصل نیامد زان مدیح %~% ای بداگر جان ما را افتد از مدحت بدا(@)(@@) 80 مانده‌ام مخمور آن شربت هنوز از پار باز %~% پای سست و سر گران این از طمع آن از حیا(@)(@@) 81 دی به دل گفتم که این را چیست دار و نزد تو %~% گفت دل: داروی این نزدیک من «منهابها»(@)(@@) 82 تا کلاه از روح دارد عامل کون و فساد %~% تا قبا از عقل دارد قابل علم و بقا(@)(@@) 83 فرق و شخص دشمنت پوشیده بادا تا ابد %~% هم به مقلوب کلاه و هم به تصحیف قبا(@)(@@) 84 باد برخوان وجودت روز و شب تصحیف صیف %~% باد بر جان حسودت سال و مه قلب شتا(@)(@@) 85 عالم از علم تو چونان باد کز مادر صبی %~% خلقت از خلق تو چونان باد کز گلبن صفا(@)(@@) 86 خلعت و احسان شاعر سنت هم نام تست %~% باد ز احسان تو زین سنت سنایی را سنا PageV1P0440(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای نهاده پای همت بر سر اوج سما %~% وی گرفته ملک حکمت گشته در وی مقتدا(@)(@@) 2 بر سریر حکمت اندر خطه کون و فساد %~% از تو عادل‌تر نبد هرگز سخن را پادشا(@)(@@) 3 مشرق و مغرب ز راه صلح بگرفتی بکلک %~% ناکشیده تیغ جنگی روز کین اندر وغا(@)(@@) 4 لاجرم ز انصاف تو روی ز من شد پر درر %~% همچو از اوصاف تو چشم زمانه پر ضیا(@)(@@) 5 گوی همت باختی با خلق در میدان عقل %~% باز پس ماندند و بردی و برین دارم گوا(@)(@@) 6 نی غلط کردم که رای صایبت با اهل عصر %~% کی پسندد از تو بازی یا کجا دارد روا(@)(@@) 7 چون زر و طاعت عزیزی 