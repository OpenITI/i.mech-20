ms501	 % % فأخفتك فيها أظهر وبطون % 24(@)(@@) % وما كل حصباء البحار جواهر % ولا كل أعضاء الجسوم عيون % 25(@)(@@) % ولا المجد إلا دوحة فارسية % لها من بني عبد الرحيم غصون % 26(@)(@@) % هم المانعون الجار ترمح ظهره % % على الوتر عسراء المراس زبون % 27(@)(@@) % مزمجرة تغلى الحقائد وسطها % % رحاها لحبات القلوب طحون % % 28(@)(@@) % إذا سال واديها فلا الطود معقل % لناج ولا الحصن الأشم حصين % 29(@)(@@) % فبات عزيزا لا يداس ترابه % وجار رجال آخرين يهون % 30(@)(@@) % تراه على قرب المدى مقل لنا % % بعيدا خفي الشخص وهو يبين % PageV01P1550 31(@)(@@) % بنوا في جوار الشمس بيتا عقابه % على المرتقي خشن الظهور حزون % 32(@)(@@) % بنوه قطينا بالنجوم مشيدا % % إذا حجر شاد البيوت وطين % 33(@)(@@) % ميامين بسامون والجو قاطب % مساميح والبحر الجواد ضنين % 34(@)(@@) % إذا سئلوا لم ينكتوا بعصيهم % % ولم يعتقوا بالعذر وهو مبين % 35(@)(@@) % ولا يحسبون البخل يخلد ربه % % ولا حين نفس بالعطاء يحين % 36(@)(@@) % نمى المجد منهم كل أغلب ناهض % له الحزم ترب والحسام قرين % 37(@)(@@) % سقى الفخر عرقيه وتم فؤاده % % علا باعث من نفسه ومعين % 38(@)(@@) % إذا جئته مسترضعا در كفه % % حلبت وما كل الأكف لبون % 39(@)(@@) % كفى بأبي سعد عليهم طليعة % تريك كمال المرء كيف يكون % 40(@)(@@) % فتى عذبت أخلاقه فكأنه % % ضعيف وحبل العزم منه متين % PageV01P1551 41(@)(@@) % وحمل أعباء السيادة يافعا % % فقام قوي في الخطوب أمين % 42(@)(@@) % وقى الملك من آرائه البيض ما وقت % سواد العيون الرامقات جفون % 43(@)(@@) % ولما هفت أمس الحلوم بربها % % وشوور مدخول الحفاظ صنين % 44(@)(@@) % ونيطت قلادات الأمور بغيره % % وبين الرجال في التحدث بون % 45(@)(@@) % درى الملك أي الساعدين يمينه % % وأي حساميه يفي ويخون % 46(@)(@@) % وأي الجياد السابقات وأيها % % قيام بأكتاد الكلال صفون % 47(@)(@@) % حمى السرب بالجماء يبغى ذيادها % % فيالك نطحا لو يكون قرون % 48(@)(@@) % فعاد على الأعقاب يقرق كفه % % له الهم خدن والندامة دين % 49(@)(@@) % يلم انتشار الحبل من حيث حله % % ويجبر من حيث اعترته وهون % 50(@)(@@) % ويعطى صقالا ما استطاع وحلية % ظبا لم تدنس فوقهن جفون % PageV01P1552 51(@)(@@) % تزين بعطفيك الحمائل والكسى 
ms502	 % % وغيرك محبوا بهن يشين % 52(@)(@@) % ويمطيك إعظاما قرا كل سابق % مكانك منه في العلاء مكين % 53(@)(@@) % منى إن تراءتك اللواحظ فوقه % % فأما على الأعداء فهو منون % 54(@)(@@) % نسجنا لما ألبست فهي تمائم % تحوطك من غش الردى وتصون % 55(@)(@@) % وعطفا على الأمر الذي لك قاده % % نزاع إلى أوطانه وحنين % 56(@)(@@) % فككت وقد راجعته عنقه وفي % % حبالهم شكوى لهم وأنين % 57(@)(@@) % فداؤك من يشقى بسعدك جده % % ويحييك طيب الذكر وهو دفين % 58(@)(@@) % إذا ما رآك اعتاض لونا بلونه % % ودير به حتى يقال جنون % 59(@)(@@) % يساميك لا كسرى أبوه ولا لهال % % مدائن دار والجبال حصون % 60(@)(@@) % يعد أبا في الملك أوقص لم يطل % % له بنجاد عاتق ووتين % PageV01P1553 61(@)(@@) % ولا صر أعواد السرير به ولا % % تغضن تحت التاج منه جبين % 62(@)(@@) % بعثت بآمالي الغرائب نحوكم % % ومغناكم أنس لها وقطين % 63(@)(@@) % فما لبث الغادي الخميص بجوكم % % يطوف حتى راح وهو بطين % 64(@)(@@) % وكم حملتنا نبتغي المجد عندكم % % أو الرفد فتلاء الذراع أمون % 65(@)(@@) % بنية عام وابن عامين قارح % تشابه نسع فوقه ووضين % 66(@)(@@) % نواحل مدت كالحنايا شخوصنا % % عليها سهام والظلام طعين % 67(@)(@@) % إذا ذرعت من نفنف عرضه انبرت % نفانف لم تذرع لهن صحون % 68(@)(@@) % وإن علقت حبل الدجى عاد متنه % % بأسحم لا تبقى عليه متون % 69(@)(@@) % تعج بأثقال الرجاء كأنها % % عواتم في بحر السراب سفين % 70(@)(@@) % إلى أن حططنا والثرى روضة بكم % % وماء الندى للواردين معين % PageV01P1554 71(@)(@@) % بجودكم استعلت يداي وأعذبت % % بفي نطاف المدح وهو أجون % 72(@)(@@) % لكل قبيل من بني المجد شاعر % يزيد علاهم رفعة ويزين % 73(@)(@@) % ومنى لكم كف وسيف وجنة % وخل وعبد شاكر وخدين % 74(@)(@@) % وفى لي هذا الشعر فيكم وإنه % % خذول لبعض القائلين خئون % 75(@)(@@) % بقيت له وحدي فلى عظم شأنه % % وللناس فيما يخبطون شئون % 76(@)(@@) % وكم غرت من قوم ولي في بيوتكم % % غرائب أبكار تزف وعون % 77(@)(@@) % تهش لها الأسماع شوقا كأنها % % وإن بعدت منها اللحون لحون % 78(@)(@@) % على أنها ملذوعة بجفائكم % % عطاش أوانا والسحاب هتون % 79(@)(@@) % وغضبى بأن تلوى 
ms503	 لديكم وتقتضى % % حقوق لها ممطولة وديون % 80(@)(@@) % وكم ثوب عز أغفل القسمث حظه % % وقد غض منه والتغافل هون % PageV01P1555 81(@)(@@) % ووعد ولم ينجزه أمس لعله % % من اليوم أن يلقى النجاح قمين % 82(@)(@@) % صبرت لعام الجدب والظلم كله % % مع الخصب أن أضوى وأنت سمين % 83(@)(@@) % ولا بد من قسمي إذا نعمة طرت % % ومن أثر فيها علي يبين % 84(@)(@@) % ومن لبسة تشجا صدور بغيظها % % علي وترنو للجمال عيون % 85(@)(@@) % فلا تجعلوها عن كريم استماعكم % % بمزلقة إن الكريم أذين % 86(@)(@@) % أناقشكم قولا وسري سامح % وشري وإن حاف اللسان أمين % 87(@)(@@) % وأنفخ بالشكوى وقلبي شاكر % % وكم حركات تحتهن سكون % 88(@)(@@) % شريتكم بالناس مغتبطا بما % % ملكت إذا عض البنان غبين % 89(@)(@@) % وملكتكم نفسي فربوا جوارها % % وغالوا بها إن العزيز ثمين % 90(@)(@@) % فليت صريح الود بيني وبينكم % % فداه دخيل في الوداد هجين % PageV01P1556 91(@)(@@) % وليت الليالي بعد أن قد ولدنكم % % عقمن فلم تنجب لهن بطون % PageV01P1557 البحر : - 1(@)(@@) % عجلت بحطك فيها الرحالا % % أثرها أمنت عليك الكلالا % % 2(@)(@@) % وقدها محدبة كالقسي % من الضال تسبي الفيافي نضالا % % 3(@)(@@) % كما انتحل الشدني الحنين % بطونا خماصا وسوقا خدالا % % 4(@)(@@) % ركائب من لا يخاف النها % % ر يعلى ولا طارق الليل عالا % % 5(@)(@@) % أعذني فقد كدني في اللئا % % م سومي بها حاجة لن تنالا % % 6(@)(@@) % وإن بواسط جودا يكون % % لرأس عقالا ورجل شكالا % % 7(@)(@@) % ومجدا إذا المجد كان الغريب % لقيت به منه حيا حلالا % % 8(@)(@@) % وإلا فصف أنت حالي وقل % % إن الدهر دون منى النفس حالا % % 9(@)(@@) % أيا جامعا فرق الخافقين % % أوانس كن شماساملالا % % 10(@)(@@) % خلت تتوافق فيها البلاد % فهاهي فيك اختصاما تقالى % % PageV01P1558 11(@)(@@) % وإن لبغداد دينا عليك % % وقد ضعفت أن تطيق المطالا % % 12(@)(@@) % وفيها وفي أهلها عزة % أساء الولاة لها الإبتذالا % % 13(@)(@@) % تسرع لإصلاح قوم ترى % % خلال أمورهم الاختلالا % % 14(@)(@@) % سوام تطاول نوم الرعا % % ة عن هديهم فتفانوا ضلالا % % 15(@)(@@) % تدارك بعدلك أرماقهم % % فما أبق النار إلا الذبالا % % 16(@)(@@) % غرائس إحسانك الأولون % % بجودك أعطوا الحيا والظلالا % % 17(@)(@@) % ومذ لم تزل تبعث المكرما % % ت بينهم 
ms504	 وتبث النوالا % % 18(@)(@@) % وترعى لهم حرمة الإختلاط % بهم والمزار لهم والوصالا % % 19(@)(@@) % عبيد وأنت بحكم الوفاء % % تخالهم لك عما وخالا % % 20(@)(@@) % ودار ندى لك بل ندوة % نحرت البدور بها لا الفصالا % % PageV01P1559 21(@)(@@) % مراتع يرتادها القانصو % % ن صادوا غزالتها والغزالا % % 22(@)(@@) % تفاني الملوك على حبها % % وعق لها ابن أباه قتالا % % 23(@)(@@) % أما اشتقت مغنى الهوى حيث طاب % % ومنبت غصن الهوى حيث طالا % % 24(@)(@@) % أما آن من نازح أن يحن % وللوصل من هاجر أن يذالا % % 25(@)(@@) % وبعدك قد أنكرت حسنها % % وحالت على الطيب حالا فحالا % % 26(@)(@@) % وكانت بعيدا عن الحادثات % % فقد أخذ الدهر منها ونالا % % 27(@)(@@) % أعرها بقربك من دائها % % شفاء وإن كان داء عضالا % % 28(@)(@@) % وكذب على الرغم من حاسديك % % أحاديث تحسب منها المحالا % % 29(@)(@@) % ومعتبرين بعجز الولا % % ة عنها نكولا ومنها نكالا % % 30(@)(@@) % يسوون في البطش كلتا اليدين % % وينسون فضل اليمين الشمالا % % PageV01P1560 31(@)(@@) % فظنوك تعيا بحمل العراق % % كأن لم يروك حملت الجبالا % % 32(@)(@@) % وأنزلت بالعصم العازبا % % ت عنها وما طاولتك النزالا % % 33(@)(@@) % وكم زاحمتها صروف الزما % % ن قبل فكانت عليها ثقالا % % 34(@)(@@) % ولو لم تكن في العلق السماء % لما كان غنمك منها هلالا % % 35(@)(@@) % سريت إليه فكنت السرار % له ولبدر أبيه الكمالا % % 36(@)(@@) % جديد التجارب غر اللقا % % ء ما رددته الحروب انتقالا % % 37(@)(@@) % وأعجبه عدد زاده % % غداة تولى هزيما خبالا % % 38(@)(@@) % رأى حربك النار تذكي فسا % % ق حشدا ليطفئها واحتفالا % % 39(@)(@@) % ولم يدر مختبطا أنها % % بفضل الوقود تزيد اشتعالا % % 40(@)(@@) % بعثت سيوفا إذا الدهر زل % جئن به صاغرا فاستقالا % % PageV01P1561 41(@)(@@) % فداويته من سقام العقوق % وعلمته الصبر والإحتمالا % % 42(@)(@@) % وبدلت من حلقات الدروع % خفافا له الحلقات الثقالا % % 43(@)(@@) % فقصر مشيته مكرها % % نتيجة أدهم بالأمس حالا % % 44(@)(@@) % تؤمل رجلاه جدوى يديه % % إذا رفع الخيط فترا فشالا % % 45(@)(@@) % ومذخورة من كنوز الزما % % ن جر عليها السنين الطوالا % % 46(@)(@@) % وأودعها الحق مستظهر % توثق ما اسطاع جهدا وعالى % % 47(@)(@@) % أقام الكواكب حراسيها % % عيونا له لا تخاف اغتيالا % % 48(@)(@@) % وباع بها نفسه والنفوس % زمانا فأرخص منها 
ms505	 وغالى % % 49(@)(@@) % شجا قائما في حلوق الملوك % % إذا حلموا أبصروه خيالا % % 50(@)(@@) % إلى أن بعثت لها آية % نسخت بهديك فيها الضلالا % % PageV01P1562 51(@)(@@) % وعلمت فيها البخيل السماح % % وحسنت للكادح الإتكالا % % 52(@)(@@) % فلا حصن الناس من بعدها % % مآلا ولا ادخروا قط مالا % % 53(@)(@@) % وكائن ببغداد من آمل % ومن زاجر فيك فالا ففالا % % 54(@)(@@) % ومن عاطش فمه فاغر % يراقب واديك من أين سالا % % 55(@)(@@) % يعد النهار بساعاته % % يسائل عنك الضحى والزوالا % % 56(@)(@@) % ومثلي من خادم خامل % ولو طاول النجم بالفضل طالا % % 57(@)(@@) % ومن جامع حسنات الخلال % % وقد قبح الفقر تلك الخلالا % % 58(@)(@@) % لعلك تحي الحظوظ الرفات % وتسمن هذي الجدود الهزالا % % 59(@)(@@) % تلاشى مع الكرماء الثناء % فلا قول معناه أن لا فعالا % % 60(@)(@@) % وما زال مسئولهم جافيا % % وحاشاك حتى جفونا السؤالا % % PageV01P1563 61(@)(@@) % سكت طويلا إلى أن وجدت % مقاما أصدق فيه مقالا % % 62(@)(@@) % لسان حسام ولا مضرب % فلو ذاب سيف لذاب انفلالا % % 63(@)(@@) % أعد لوصفك آياته % ليظهر صفوا له وانتخالا % % 64(@)(@@) % وقدم مستقبلا هذه % % شبيه مدحك واقتبالا % % 65(@)(@@) % تزاحم حولك وفد الثناء % % وإن عدمت في الزحام المنالا % % 66(@)(@@) % فلا تجعلن كثرة الزائرين % % لها فترة وعليها اعتلالا % % 67(@)(@@) % فمن كان لا غيره في الزما % % ن كان الأنام عليه عيالا % % PageV01P1564 البحر : - 1(@)(@@) % إن تسأليني بعد قو % % مي كيف أوجدني الزمان % 2(@)(@@) % وبقيت من بعد الجما % % ح ومقودي سلس ليان % 3(@)(@@) % فردا يزعزعني الأذى % % ويشل جانبي الهوان % 4(@)(@@) % كالراحة بالبتراء خو % % لس من أشاجعها البنان % 5(@)(@@) % بخلائق للدهر تن % % صر بالمقادر أو تعان % 6(@)(@@) % طاحت بأسنمة العلا % % ونجا الذنابى والعجان % 7(@)(@@) % عصفت فلم تنج الحصو % % ن ولا بفارسه الحصان % 8(@)(@@) % خلت بفارس بركها % % وعلى الجبال لها جران % 9(@)(@@) % وهفا ببيضاء المدا % % ئن يوم بؤس أرونان % 10(@)(@@) % وببلخ لم تبد الذيو % % ل من الهضاب ولا القنان % PageV01P1565 11(@)(@@) % درج الملوك بها كما % % درجت مع النفس السنان % 12(@)(@@) % هم أنبضوا ذاك المعي % % ن بها وهم ذاك المعان % 13(@)(@@) % طلبوا الأمان فكان يؤ % % خذ من سيوفهم الأمان % 14(@)(@@) % إن أرجلوا هزلى فكم 
ms506	 % % ركبوا الزمان وهم سمان % 15(@)(@@) % وعتوا وكل عزيز قو % % م تحت أرجلهم مهان % 16(@)(@@) % ينتاب ناديهم وتف % % هق في بيوتهم الجفان % 17(@)(@@) % وإذا علت نيرانهم % % فالمندلي لها دخان % 18(@)(@@) % أبكيهم أثرا وما % % لي أن أبرهم عيان % 19(@)(@@) % لله منهم جدى ال % % وضاح أو أبى الهجان % 20(@)(@@) % وبنفسي الغرر الوضا % % ء بلين والسنن الحسان % PageV01P1566 21(@)(@@) % وجبين كل متوج % هو لا البخيل ولا الجبان % 22(@)(@@) % هم خلفوني كالرذ % % ية لا أدين كما أدان % 23(@)(@@) % إن تنكري قومي فعن % % دك من بقيتهم بيان % 24(@)(@@) % وسلى النجابة كيف كن % % ت لتعلمي بي كيف كانوا % % PageV01P1567 البحر : - 1(@)(@@) % أروم الوفاء الصعب بالمطلب السهل % وأرتاد جود الحب في منبت البخل % 2(@)(@@) % وآمن خوان الضمان وأقتضي % % ديوني مقتول المواعيد بالمطل % 3(@)(@@) % إلى كم وفي صبري على هجركم دمي % % أعينكم يا هاجرين على قتلي % % 4(@)(@@) % فظنت فلا قلبي يقر على الأذى % % إباء ولا عيني تنام على الذل % 5(@)(@@) % متى سقت العين الربوع فلا تزل % % ربوعكم من بخل جفني في محل % 6(@)(@@) % أأستاق بالبيداء جسما أرثه % % وأبلي وقلبي مستعار بلا شغل % 7(@)(@@) % وأحلو ولي بين الضلوع مرارة % لصماء منكم لا تمر ولا تحلي % % 8(@)(@@) % وأترك في بغداد من لا يبيعني % % بمال ولا يرتاح دوني إلى أهل % 9(@)(@@) % غدرتم وقد ترقا دموع كما جرت % % ويبرد شوق نافر بعد ما يغلي % % 10(@)(@@) % ومالي وفخر الملك جارى نصره % % بنفس كنفس لا أضن ولا أغلي % % PageV01P1568 11(@)(@@) % وعلم عزا كل قلب ووسمت % يداه ببسط الجود كل يد غفل % 12(@)(@@) % رأى غير معقول على الغيب رأيه % % وجاد فخيط المزن ليس بمنحل % 13(@)(@@) % وأعجز قول السائلين نواله % % وإن كان حظي منه يمشي على مهل % 14(@)(@@) % أرى عارضا قد طبق الأرض ماؤه % % وعتم وربعي منه ليس بمتبل % 15(@)(@@) % وجارين لو مسوا غباري تجملوا % % وقد وصلوا بعدي وقد وصلوا قبلي % % 16(@)(@@) % ولم أغن عنهم غير من طال نبته % % وطاب ولم أذهب إلى نابت البقل % 17(@)(@@) % أتوسع قدامي وحاش قياسكم % % خطى قدم لو قد حذت ما حذت نعلي % % 18(@)(@@) % وألقي 
ms507	 ضياعا لا لساني ولا يدي % % ببسط وقبض لا لعقد ولا حل % 19(@)(@@) % شرائط نعماكم وإحسان جودكم % % ترى جذبكم ضبعي وحملكم ثقلي % % 20(@)(@@) % فإنكم لو تنفضون عيابكم % % لعز على التفتيش أن تجدوا مثلي % % PageV01P1569 21(@)(@@) % فلا تحملوا سر الأمور وغيبها % % على ظاهر تحت القناعة مختل % 22(@)(@@) % وكم من حسام قاطع بفلوله % % وآخر ناب بالطلاوة والصقل % 23(@)(@@) % ومنتخبات إن دهى الشعر هجنة ال % % أبوة راحت وهي مخبورة الأصل % 24(@)(@@) % إذا ما رأيت النجم منها مشرقا % % شهدت ولم ينسب أبا أنه نجلي % % 25(@)(@@) % خدمت قريبا قائما فمشافها % % بها وبعيدا قبل بالكتب والرسل % 26(@)(@@) % فلم أحظ من إحسانها واحتوائها % % على كل معنى دق أو منطق فصل % 27(@)(@@) % وهل نافعي يوما وحظي قاعد % إذا نهضت بي همتي أوسعت رجلي % % 28(@)(@@) % ولما مننتم بالندى فعطفتم % % علي وأعلقتم بمعروفكم حبلي % % 29(@)(@@) % حماني نداكم صفوه وحلاله % % خبيث اللسان دونكم كدر الفعل % 30(@)(@@) % إذا مضغ الأعراض كان عدوه % % ومولاه في فيه خليقين بالأكل % PageV01P1570 31(@)(@@) % أأعدله هيهات أظلمه إذن % % ومن لم ير الإحسان لم يصغ للعذل % 32(@)(@@) % أماني لي فيكم أمات نشاطها % % فلا كان من قبل الأماني في حل % 33(@)(@@) % وما والذي أحيا بك الجود بعدما % % لها الناس عنه واطمأنوا إلى الثكل % % 34(@)(@@) % جزعت لوفر أخطأتني سماؤه % % وصابت بطل أرض غيري أو وبل % 35(@)(@@) % فإني على عض الزمان وحمله % % صليب قناة الصبر جلد على الثقل % 36(@)(@@) % أحب الجدا يأتي جميلا منوها % % وأقلي الغنى المجنوب في رسن الذل % 37(@)(@@) % ولكن يظن الناس أنك مانعي % % لزهدك في مدحي وشكك في فضلي % % 38(@)(@@) % ويقضون في أنني غير موضع % بطرحك أمري للصنيع ولا أهل % 39(@)(@@) % ومن كان في أيام ملكك خاملا % % ففي أي ملك يستريش ويستعلي % % 40(@)(@@) % نحلنا ملوكا قبلك المدح فانتفت % % خلائق غش لن تصح على النحل % PageV01P1571 41(@)(@@) % وكنا حلى دولاتهم فتضاءلت % على الطوق عنق عودت حلق الغل % 42(@)(@@) % فما استعذبوا طعم الثناء ولا رأوا % % مفارقة بين السماحة والبخل % 43(@)(@@) % ولا فطنوا أن يجلسوا ووفودهم % % يميسون في الألطاف منهم وفي الفضل % % 44(@)(@@) % فسووا بحكم 
ms508	 اللؤم في المنع بيننا % % وعموا كما سويت في الجود والبذل % 45(@)(@@) % علا عشيت أيامهم عن شعاعها % % فمروا وخلوها لأيامك النجل % 46(@)(@@) % نشرت أساطير الكرام فشوهدت % % أخابير كانت تستراب مع النقل % 47(@)(@@) % فأحييتهم بالجود ثم فضحتهم % % بفضل وكانوا من جنابك في قتل % 48(@)(@@) % أبني ونوه بي فرب صنيعة % زكا لك فرعاها ولم تشق بالأصل % 49(@)(@@) % بقيت بلا بعد تراعي انتظاره % % كما أنت إن عد الملوك بلا قبل % 50(@)(@@) % يعد لك الأعياد متصل العرى % % من العمر منظوم العلائق في الشمل % PageV01P1572 51(@)(@@) % مدى الدهر ما لبوا فطافوا فحللوا % % عن البدن يوم النحر مثنية العقل % 52(@)(@@) % وما نسلوا للنفر داعين من منى % % رعى الله فخر الملك للحرث والنسل % 53(@)(@@) % تمد بحبل غير منتقض القوى % % وتسكن عزا غير منتقل الظل % PageV01P1573 البحر : - 1(@)(@@) % خذ من يدي صفقة الأماني % % على عطاياك يا زماني % % 2(@)(@@) % واخشن كما شئت أو فلن لي % % فليس جنبي بمستلان % 3(@)(@@) % ملكت عنقي فلم أقدها % % تضغط في ربقة الأماني % % 4(@)(@@) % وأعطشتني الدنيا ولكن % % لا أشرب الماء بالهوان % 5(@)(@@) % كم غرني من بنيك آل % أنضى ركابي وما سقاني % % 6(@)(@@) % فعدني قد قتلت حظي % % خبرا وجربت ما كفاني % % 7(@)(@@) % ما جمعت ثروة وفضل % والماء والنار يجمعان % 8(@)(@@) % طر بجناح النقصان فيهم % % محلقا عالى المكان % 9(@)(@@) % وطامن الشخص إن توافت % % فيك مع المال خلتان % 10(@)(@@) % صرفت وجهي عن كل حظ % حتى عن الأوجه الحسان % PageV01P1574 11(@)(@@) % واعتن وهنا فلم يشقني % % على جواي البرق اليماني % % 12(@)(@@) % واستحلمتني الصبا وقدما % جن بأنفاسها جناني % % 13(@)(@@) % فأي كف تكف شأوي % % والحب لم يئن من عناني % % 14(@)(@@) % لو صادني بالغنى منيل % لصادني بالهوى الغواني % % 15(@)(@@) % ولي من الناس أهل بيت % له من المجد ظلتان % 16(@)(@@) % ممتنع لا أرى صروف ال % % أيام فيه ولا تراني % % 17(@)(@@) % حلفت بالراقصات خبطا % يطرحن سلمى على أبان % 18(@)(@@) % كل أمون خرقاء تمحو % % بالرجل ما تكتب اليدان % 19(@)(@@) % نواجيا غير خاضعات % لغارب جب أو جران % 20(@)(@@) % ترمي بألحاظ مضرحي % من المحاني إلى الرعان % PageV01P1575 21(@)(@@) % إذا ادلهم الظلام أمسى % % لها 
ms509	 سليطان يوقدان % 22(@)(@@) % تقذفها ليلة جماد % في يوم رمضاء معمعان % 23(@)(@@) % يحملن شعثا عبر الفيافي % % أشهى اليهم من المغاني % % 24(@)(@@) % شروا بتلك النفوس يوما % % يغلي به بائع الجنان % 25(@)(@@) % حتى توافوا جمعا فقاموا % % رامين تالين للمثاني % % 26(@)(@@) % ما انهدمت سورة عليها % % من آل عبد الرحيمباني % % 27(@)(@@) % المال خصم السماح فيها % % والجار والأمن صاحبان % 28(@)(@@) % تفيئوا في العلا ظلالا % % قطوفها غضة دواني % % 29(@)(@@) % واقتعدوا الذروة القدامى % % بيتا على كاهل الزمان % 30(@)(@@) % بيت قرى أخضر الأداوى % % إذا شتوا أحمر الجفان % PageV01P1576 31(@)(@@) % بناه قدما على العطايا % % أبناء ساسان ذي الطعان % 32(@)(@@) % لم ينتقل عزه وقوفا % % دون أوان على أوان % 33(@)(@@) % فرسان يوم الهياج منهم % وفيهم ألسن البيان % 34(@)(@@) % إن عزموا الغارة استشاروا % % نصيحة الرمح والجنان % 35(@)(@@) % أو احتبوا للكلام ردوا % % ما أخذ السيف باللسان % 36(@)(@@) % كم عط ثوب البأساء منهم % % بواضح في الندى هجان % 37(@)(@@) % كل فتى فيه من أبيه % % إذا ادعى المجد شاهدان % 38(@)(@@) % إذا الدقاق الفخر استعاروا % % زور التسامي أو التكاني % % 39(@)(@@) % فقد غدت في أبي المعالي % % أسماؤهم تصدق المعاني % % 40(@)(@@) % أبلج تجلى الخطوب سودا % بقمر منه إضحيان % PageV01P1577 41(@)(@@) % وتسند المشكلات منه % % بغير واه وغير واني % % 42(@)(@@) % إن خار عودالآراء شد ال % % حزم بآرائه المتان % 43(@)(@@) % أو عز غيث البلاد أرعى ال % % ربيع من ماله المهان % 44(@)(@@) % فارس ظهر النشاط إما % % قطر بالعاجز التواني % % 45(@)(@@) % ينتهز المكرمات وثبا % % بنهضة الطالب المعاني % % 46(@)(@@) % ثقف عزماته سدادا % % آمنة عيب ما يعاني % % 47(@)(@@) % وبات بالبشر من دبيب ال % % غيبة والشر في أمان % 48(@)(@@) % سرحت ذود الآمال فيه % % بين جذاع إلى مثاني % % 49(@)(@@) % فلم تزل عشبه إلى أن % % أربت عجافى على السمان % 50(@)(@@) % كاثرني بالنوال حتى % % حبوت من فضل ما حباني % % PageV01P1578 51(@)(@@) % فلو تمكنت من زماني % % بفضله وحده كفاني % % 52(@)(@@) % إن جئته طالبا فحكمي % % أو أنا أجممته ابتداني % % 53(@)(@@) % كل نفيس على اقتراحي % % منه وشرطي الذي أتاني % % 54(@)(@@) % أصبح والشمس من جمال % عليه والبدر يحسدان % 55(@)(@@) % مواهب لو أسرت منها % % بالود أعياه في ارتهاني % % 56 
ms510	(@)(@@) % بكم زكت طينتي وأثري % % جوي وساء العدا مكاني % % 57(@)(@@) % قسا زماني فلم يرعني % % لما حنتكم لي الحواني % % 58(@)(@@) % فابقوا فلا مال ما بقيتم % % عندي بالأنفس الغواني % % 59(@)(@@) % سيارة وهي لم ترمكم % % بكل قاص في المدح داني % % 60(@)(@@) % للعيد ما للنيروز منها % % في الحظ منكم والمهرجان % % PageV01P1579 61(@)(@@) % حتى أرى كل يوم ملك % لكم يسمى سعد القران % 62(@)(@@) % ما أربى في ضمانكم لي % % والحمد والشكر في ضمان % PageV01P1580 البحر : - 1(@)(@@) % لو حملت عتبى الليالي % % أو سمعت قلت ما بدا لي % % 2(@)(@@) % لكن عذلا كالنصح ضاعت % % سلوكه في رقوع بالي % % 3(@)(@@) % أخطب منهن ناشزات % لا يتعطفن للبعال % 4(@)(@@) % عواقما لا يلدن إلا % % ما عق قلبي وعز حالي % % 5(@)(@@) % ما لزماني على احتشامي % % في بسطه الجور لي ومالي % % 6(@)(@@) % لو شاء مما احتملت منه % % أخجله كثرة احتمالي % % 7(@)(@@) % ولم يكن لي إلا صديقا % لو فطن الدهر للرجال % % 8(@)(@@) % عش واحدا أو فمت ولما % % يعرك بجنبيك حب قالي % % 9(@)(@@) % ولم ترد فعلة أجاجا % % تشرع من قولة زلال % 10(@)(@@) % عرفت نفسي وما أعادي % % فهو سواء وما أوالي % % PageV01P1581 11(@)(@@) % وقاد قلبي ألا أبالي % % قلة إنصاف من أبى لي % % 12(@)(@@) % مالي من صاحبي إلا % من لم أرعه ثلم مال % 13(@)(@@) % وأرخص الناس بي سماحا % % من أنا في حبه أغالي % % 14(@)(@@) % لامت على جلستي فظنت % % خيرا بمطرورة النصال % 15(@)(@@) % رأت سيوفا ولا مضاء % وراء ما راق من صقال % 16(@)(@@) % وأنكرت صونى القوافي % % عنهم وفي بذلها ابتذالي % % 17(@)(@@) % لولا ابن عبد الرحيم يصغي % % ما وجد الشعر من مقالي % % 18(@)(@@) % نشاطه للوفاء أضحى % % نشط لساني من عقال % 19(@)(@@) % داوى بتأنيسه نفاري % % طب بأدوائه العضال % 20(@)(@@) % أكسبه الحمد بين ثاو % من أثر في العلا وخالي % % PageV01P1582 21(@)(@@) % ببنت شمس وبنت مال % % تهتز ميلا من الهزال % 22(@)(@@) % فطنبوا مائلات أزر ال % % حبى وأرخوا سجف الحجال % 23(@)(@@) % بيض البنى والوجوه سود ال % % قدور حصا حمر اللآلي % % 24(@)(@@) % من حاضري البدو لم تدسهم % % في البدو مستافة الرمال % 25(@)(@@) % ولم يسمهم هجر انقلاب ال % % جنوب منهم إلى الشمال 
ms511	 % 26(@)(@@) % كل طويل النجاد زلت % % عنه فضول البرد المذال % 27(@)(@@) % يوضح في الترب أخمصاه % % ما ترسم الخيل بالنعال % 28(@)(@@) % إن قصر السيف عن ضريب % % أرفده بالخطى الطوال % 29(@)(@@) % أبناء كسرى نشرت مجدا % % ما أدرجت منهم الليالي % % 30(@)(@@) % واليوم عن ملكهم حديث % ينبي بأيامه الأوالي % % PageV01P1583 31(@)(@@) % بنوا على العدل كل شيء % % فانتخبوه يوم اعتدال % 32(@)(@@) % خمص الربى عنده بطان % وعاطل الروض منه حالي % % 33(@)(@@) % ما مطلت أرضها سماء % % فهو شفاء من المطال % 34(@)(@@) % قابل به الفطر خير آت % % يلقاك ثوباهما وتالي % % 35(@)(@@) % ذا نعمة لا أخاف فيها % % عليك إلا من الكمال % % 36(@)(@@) % قلت لقوم خفوا وبنتم % % بينة الرشد في الضلال % 37(@)(@@) % لا تعجبوا والدجى بهيم % أن شدخت غرة الهلال % 38(@)(@@) % غضوا له حاسدين زرقا % % فالحكل في مقلة الغزال % 39(@)(@@) % حطهم وارتفعت عنهم % % أنك خاطرت في الكمال % % PageV01P1584 البحر : - 1(@)(@@) % يا دار لهوي بالنجيل من قطن % جنتك الفيحاء بعد من ظعن % 2(@)(@@) % أصامت بناطق ونافر % بآنس وذو خلا بذي شجن % 3(@)(@@) % سرنا وعهدي بك مغنى غبطة % أمس وعدنا اليوم في مغنى حزن % 4(@)(@@) % تشبهت حور الظباء بهم % أن سكنت فيك ولا مثل سكن % 5(@)(@@) % مشتبه أعرفه وإنما % % مغالطا قلت لصحبي دار من % 6(@)(@@) % يا صاحبي عونا وإن أشفني % % مع جلدي قولي لخوار أعن % 7(@)(@@) % قف باكيا فيها وإن كنت أخا % مواسيا فبكها عنك وعن % 8(@)(@@) % لم يبق لي يوم الفراق فضلة % من دمعة أبكي بها يوم الدمن % 9(@)(@@) % يا زمنا مر كما اقترحته % % بالعنف إن عاد الصبا فعد إذن % 10(@)(@@) % والعيش في كف المراح ذاهب % برأسه يقتاده بلا رسن % PageV01P1585 11(@)(@@) % وصاحبي كل فتى مساعد % ما فطن الدهر له وقد فطن % 12(@)(@@) % معي إلى ما سره أو ضره % % حبا لأن يقال خل مؤتمن % 13(@)(@@) % ما في من صالحة أذاعها % % بجهده أوتك عوراء دفن % 14(@)(@@) % وحامل على الشرور حامل % في طرفه وكفه سيف الفتن % 15(@)(@@) % قد كتب الشعر على عارضه % ما أقبح الإعراض بالوجه الحسن % 16(@)(@@) % يدير مما اختار عسجدية % ما قطعت عن مثلها هامة 
ms512	 دن % 17(@)(@@) % صيغت وسحر عينه من طينة % واحدة وبابل أم المدن % 18(@)(@@) % تفتر عن فأرة مسك كأسها % % إذا انتشى وثغره إذا أذن % 19(@)(@@) % كأنما أعداهما بخلقه % % محمد بن جعفر أبو الحسن % 20(@)(@@) % قالوا الرحيل فمسحت عبرة % زادت على بل الرداء والردن % PageV01P1586 21(@)(@@) % في كل يوم عزمة يعلمني % % شقاؤها أن النعيم في الوطن % 22(@)(@@) % يا رحلتي أين يريد الدهر بي % % ومن من الناس ترى قالت تمن % 23(@)(@@) % قلت الذي إن جاد لي دهري به % % فما أبالي بسواه كيف ضن % 24(@)(@@) % من بان بالمجد على اتحاده % % كم من كثير جمعه ولم يبن % 25(@)(@@) % يد تصيب حيث سال صوبها % % قصدا وكم قد أخطأت به المزن % 26(@)(@@) % تجمع بين الفتك والجود له % % وقلما يبخل إلا من جبن % 27(@)(@@) % خف نوالا ونزالا وله % % حلم إذا وازن ثهلان وزن % 28(@)(@@) % يا نفس بشرى إنه محمد % والمشرب السائغ والمغنى الأغن % 29(@)(@@) % لا حق لي عند بخيل ناقص ال % % فضل وإن جمع مالا واختزن % 30(@)(@@) % يجهلني بديهة وإنه % % يزداد جهلا بي كلما امتحن % PageV01P1587 31(@)(@@) % لا أحسد المثرى على ما عنده % % من خيره وعرضه فيما وهن % 32(@)(@@) % ولا أحط الدهر كعبا أن أرى % % وهو سواء إن صفرت واحتجن % 33(@)(@@) % لي عفتي عنه وما نال له % % وخيرنا من عارك العيش الخشن % 34(@)(@@) % والمال حلو والذي يحيله % % عندي مرا أنه يتلوه من % 35(@)(@@) % قناعة صانت لوجهي ماءه % % كم من حريص لم يجد ولم يصن % 36(@)(@@) % يخدعني دهري بتسويفاته % % عنها وهل يخدع جفن عن وسن % 37(@)(@@) % ما أكثر الشاكين من دنياهم % فليت شعري هذه الدنيا لمن % 38(@)(@@) % وقد قلبت الناس في حالاتهم % % فما وجدت راضيا عن الزمن % 39(@)(@@) % قد جعلوا الشكوى طريق بخلهم % % يعتذرون في النعيم بالمحن % 40(@)(@@) % لذاك ما صبحت منهم برقة % تخطف بالشام ويوماباليمن % PageV01P1588 41(@)(@@) % أقل خوفي أن أضل بينهم % % والماء إن أزمن في الحوض أجن % 42(@)(@@) % لولاك ما حث رجائي طمع % في مطلب محا اليقين كل ظن % 43(@)(@@) % جئتك أهديها على ضني بها % % عذراء لا تفتض إلا بالفطن % 44 
ms513	(@)(@@) % ناشزه لم ترض لولاك فتى % % بعلا ولم أرض لها قط ختن % 45(@)(@@) % مما ابتكرت لم تكن مجلوبة % بغارة أضحت على الشعر تشن % 46(@)(@@) % إذا امرؤ قال لراويها أعد % أطربه كأنما قال تغن % 47(@)(@@) % فخلها ما شئت واقسم شرفا % أذخر منه لهزالي ما سمن % 48(@)(@@) % مكارم أوجبها حبك لي % % وسنها والحر يمضي حيث سن % 49(@)(@@) % فإنها في الناس بين مؤثر % لم يجتهد وذي اجتهاد لم يعن % 50(@)(@@) % تكلفوها بعد ما قد هرموا % % وإنما رضعتها مع اللبن % PageV01P1589 البحر : - 1(@)(@@) % سلا من سلا من بنا استبدلا % % وكيف محا الآخر الأولا % % 2(@)(@@) % وأي هوى حادث العهد أم % % س أنساه ذاك الهوى المحولا % % 3(@)(@@) % وأين المواثيق والعاذلات % يضيق عليهن أن تعذلا % % 4(@)(@@) % أكانت أضاليل وعد الزما % % ن أم حلم الليل ثم انجلى % % 5(@)(@@) % ومما جرى الدمع فيه سؤا % % ل من تاه بالحسن أن يسألا % % 6(@)(@@) % أقول برامة يا صاحبي % معاجا وإن فعلا أجملا % % 7(@)(@@) % قفا لعليل فإن الوقوف % وإن هو لم يشفه عللا % % 8(@)(@@) % بغربي وجرة ينشدنه % % وإن زادنا صلة منزلا % % 9(@)(@@) % وحسناء لو أنصفت حسنها % % لكان من القبح أن تبخلا % % 10(@)(@@) % رأت هجرها مرخصا من دمي % % على النأي علقا قديما غلا % % PageV01P1590 11(@)(@@) % وربت واش بها منبض % % أسابقه الرد أن ينبلا % % 12(@)(@@) % رأى ودها طللا ممحلا % % فلفق ما شاء أن يمحلا % % 13(@)(@@) % وألسنة كأعالي الرماح % % رددت وقد شرعت ذبلا % % 14(@)(@@) % ويأبى لحسناء إن أقبلت % % تعرضها قمرا مقبلا % % 15(@)(@@) % سقى الله ليلاتنا بالغوي % % ر فيما أعل وما أنهلا % % 16(@)(@@) % حيا كلما أسبلت مقلة % حنينا له عبرة أسبلا % % 17(@)(@@) % وخص وإن لم تعد ليلة % خلت فالكرى بعدها ما حلا % % 18(@)(@@) % وفى الطيف فيها بميعاده % % وكان تعود أن يمطلا % % 19(@)(@@) % فما كان أقصر ليلى به % % وما كان لو لم يزر أطولا % % 20(@)(@@) % مساحب قصر عني المشي % % ب ما كان منها الصبا ذيلا % % PageV01P1591 21(@)(@@) % ستصرفني نزوات الهمو % % م بالأرب الجد أن أهزلا % % 22(@)(@@) % وتنحت من طرفي زفرة % مباردها تأكل المنصلا % % 23(@)(@@) % وأغرى بتأبين آل النب % % ي إن نسب الشعر 
ms514	 أو غزلا % % 24(@)(@@) % بنفسي نجومهم المخمدات % ويأبى الهدى غير أن تشعلا % % 25(@)(@@) % وأجسام نور لهم في الصعي % % د تملؤه فيضيء الملا % % 26(@)(@@) % ببطن الثرى حمل ما لم تطق % على ظهرها الأرض أن تحملا % % 27(@)(@@) % تفيض فكانت ندى أبحرا % % وتهوى فكانت علا أجبلا % % 28(@)(@@) % سل المتحدي بهم في الفخا % % ر أين سمت شرفات العلا % % 29(@)(@@) % بمن باهل الله أعداءه % % فكان الرسول بهم أبهلا % % 30(@)(@@) % وهذا الكتاب وإعجازه % % على من وفي بيت من نزلا % % PageV01P1592 31(@)(@@) % وبدر ووبدر به الدين ت % % م من كان فيه جميل البلا % % 32(@)(@@) % ومن نام قوم سواه وقام % % ومن كان أفقه أو أعدلا % % 33(@)(@@) % بمن فصل الحكم يوم الحنين % % فطبق في ذلك المفصلا % % 34(@)(@@) % مساع أطيل بتفصيلها % % كفى معجزا ذكرها مجملا % % 35(@)(@@) % يمينا لقد سلط الملحدون % % على الحق أو كاد أن يبطلا % % 36(@)(@@) % فلولا ضمان لنا في الطهور % % قضى جدل القول أن نخجلا % % 37(@)(@@) % أألله يا قوم يقضي النبي % مطاعا فيعصى وما غسلا % % 38(@)(@@) % ويوصى فنخرص دعوى علي % % ه في تركه دينه مهملا % % 39(@)(@@) % ويجتمعون على زعمهم % % وينبيك سعد بما أشكلا % % 40(@)(@@) % فيعقب إجماعهم أن يبي % % ت مفضولهم يقدم الأفضلا % % PageV01P1593 41(@)(@@) % وأن ينزع الأمرمن أهله % % لأن عليا له أهلا % % 42(@)(@@) % وساروا يحطون في آله % % بظلمهم كلكلا كلكلا % % 43(@)(@@) % تدب عقارب من كيدهم % % فتفنيهم أولا أولا % % 44(@)(@@) % أضاليل ساقت مصاب الحسين % % وما قبل ذاك وما قد تلا % % 45(@)(@@) % أمية لابسة عارها % % وإن خفي الثأر أو حصلا % % 46(@)(@@) % فيوم السقيفة يا بن النب % % ي طرق يومك في كربلا % % 47(@)(@@) % وغصب أبيك على حقه % % وأمك حسن أن تقتلا % % 48(@)(@@) % أيا راكبا ظهر مجدولة % تخال إذا انبسطت أجدلا % % 49(@)(@@) % شأت أربع الريح في أربع % إذا ما انتشرن طوين الفلا % % 50(@)(@@) % إذا وكلت طرفها بالسما % % ء خيل بإدراكها وكلا % % PageV01P1594 51(@)(@@) % فعزت غزالتها غرة % وطالت غزال الفلا أيطلا % % 52(@)(@@) % كطيك في منتهى واحد % % لتدرك يثرب أو مرقلا % % 53(@)(@@) % فصل ناجيا وعلي الأمان % لمن كان في حاجة موصلا % % 54(@)(@@) % تحمل رسالة صب حملت % فناد بها 
ms515	 أحمد المرسلا % % 55(@)(@@) % وحي وقل يا نبي الهدى % % تأشب نهجك واستوغلا % % 56(@)(@@) % قضيت فأرمضنا ما قضيت % وشرعك قد تم واستكملا % % 57(@)(@@) % فرام ابن عمك فيما سنن % % ت أن يتقبل أو يمثلا % % 58(@)(@@) % فخانك فيه من الغادري % % ن من غير الحق أو بدلا % % 59(@)(@@) % إلى أن تحلت بها تيمها % % وأضحت بنو هاشم عطلا % % 60(@)(@@) % ولما سرى أمر تيم أطا % % ل بيت عدي لها الأحبلا % % PageV01P1595 61(@)(@@) % ومدت أمية أعناقها % % وقد هون الخطب واستسهلا % % 62(@)(@@) % فنال ابن عفان ما لم يكن % % يظن وما نال بل نولا % % 63(@)(@@) % فقر وأنعم عيش يكو % % ن من قبله خشنا قلقلا % % 64(@)(@@) % وقلبها أردشيرية % فحرق فيها بما أشعلا % % 65(@)(@@) % وساروا فساقوه أو أوردوه % % حياض الردى منهلا منهلا % % 66(@)(@@) % ولما امتطاها علي أخو % % ك رد إلى الحق فاستثقلا % % 67(@)(@@) % وجاؤا يسومونه القاتلين % % وهم قد ولوا ذلك المقتلا % % 68(@)(@@) % وكانت هناة وأنت الخصيم % غدا والمعاجل من أمهلا % % 69(@)(@@) % لكم آل ياسين مدحي صفا % % وودي حلا وفؤادي خلا % % 70(@)(@@) % وعندي لأعدائكم نافذا اذا ضاق بالسير ذرع الرفيق ملأت بهن فروج الملا % % ت قولي ما صاحب المقولاسقط بيت ص % % PageV01P1596 71(@)(@@) % فواقر من كل سهم تكون % % له كل جارحة مقتلا % % 72(@)(@@) % وهلا ونهج طريق النجاة % % بكم لاح لي بعد ما أشكلا % % 73(@)(@@) % ركبت لكم لقمي فاستننت % وكنت أخابطه مجهلا % % 74(@)(@@) % وفك من الشرك أسري وكا % % ن غلا على منكبي مقفلا % % 75(@)(@@) % أواليكم ما جرت مزنة % وما اصطخب الرعد أو جلجلا % % 76(@)(@@) % وأبرأ ممن يعاديكم % فإن البراءة أصل الولا % % 77(@)(@@) % ومولاكم لا يخاف العقاب % فكونوا له في غد مؤئلا % % PageV01P1597 البحر : - 1(@)(@@) % ما أنت بعد البين من أوطاني % % دار الهوى والدار بالجيران % 2(@)(@@) % كنت المنى من قبل طارقة النوى % % والشمل شملي والزمان زماني % % 3(@)(@@) % ولئن خلوت فليس أول حادث % خلت الكناس له من الغزلان % 4(@)(@@) % طرب الحمام بطبعهن وإنما اس % % تملين فيك النوح من أحزاني % % 5(@)(@@) % أمخيمون على اللوى من عالج % % أم لاحقون الماء في ماوان % 6(@)(@@) % دعهم وقلبي ما وفوا بضمانه % % ودع البكاء لهم 
ms516	 يفي بضمان % 7(@)(@@) % رحلوا بأحلامي فقلت لمقلتي % % إن النهى حجر على الأجفان % 8(@)(@@) % بيضاء في الغادين يومي أسود % من بعدها وبكاي أحمر قاني % % 9(@)(@@) % عطف الفؤاد على الحدائق أنها % % خلعت تعطفها على الأغصان % 10(@)(@@) % يا شمس طال الليل بعد فراقها % % طال الصباح وأنت في الأظعان % PageV01P1598 11(@)(@@) % إن النمير لواردي فتعلما % % يا صاحبي من الذي تردان % 12(@)(@@) % يتعاور الحساد أخذي طائعا % % بيد لحق الله من شيطاني % % 13(@)(@@) % هي فطرة مازلت من ثقتي بها % % قدما أشم العز من أرداني % % 14(@)(@@) % وقناعة بالعفو تؤذن أنها % % للفضل إن الحرص للنقصان % 15(@)(@@) % ما ضر من أفقرت فيه خواطري % % وهو الغني لو أنه أغناني % % 16(@)(@@) % ليت البخيل القابلي والباخسي % % حقي كما هو مانعي ياباني % % 17(@)(@@) % ما سرني منه وفي أفعاله % سخط المكارم أنه يرضاني % % 18(@)(@@) % لا شيء في ميزان شعري عنده % % وأخف شيء في الجدا ميزاني % % 19(@)(@@) % في الناس من يرضى بجبن يمينه % % إن عد يوم الروع غير جبان % 20(@)(@@) % ولقد تكون يد الكمي قصيرة % بالبخل وهي مع السماح يدان % PageV01P1599 21(@)(@@) % كثر الحديث عن الكرام وكل من % % جربت ألفاظ بغير معاني % % 22(@)(@@) % إلا بسعد من تنبه للعلا % % هيهات نومهم من اليقظان % 23(@)(@@) % مهلا بني الحسد الدخيل فإنها % % لا تدرك العلياء بالأضغان % 24(@)(@@) % سعد بن أحمد أبيض من أبيض % في المجد فانتسبوا بني الألوان % 25(@)(@@) % بين الجبال الصم بحر ثامن % يحوى جلامدها وبدر ثاني % % 26(@)(@@) % من معشر سبقوا إلى حاجاتهم % % شوط الرياح وقد جرت لرهان % 27(@)(@@) % قوم إذا وزروا الملوك برأيهم % % أمرت عمائمهم على التيجان % 28(@)(@@) % ضربوا بمدرجة السبيل قبابهم % % يتقارعون بها على الضيفان % 29(@)(@@) % ويكاد موقدهم يجود بنفسه % % حب القرى حطبا على النيران % 30(@)(@@) % أبناء ضبة واسعون وفي الرغى % % يتضايقون تضايق الأسنان % PageV01P1600 31(@)(@@) % يا راكبا زهر الكواكب قصده % % قرب لعلك عندها تلقاني % % 32(@)(@@) % قف ناد يا سعد الملوك رسالة % من عبدك القاصي بحب داني % % 33(@)(@@) % غالطت شوقي فيك قبل لقائنا % % والقرب ظن والمزار أماني % % 34(@)(@@) % حتى إذا ما الوصل أطفأ غلتي % % بك كان أعطش لي من 
ms517	 الهجران % 35(@)(@@) % ولرب وجد تواصف ناهضته % % وضعفت لما صار وجد عيان % 36(@)(@@) % ولقد عكست علي ذاك لأنني % % كنت الحبيب إليك قبل تراني % % 37(@)(@@) % ومن العجائب والزمان ملون % أن الدنو هو الذي أقصاني % % 38(@)(@@) % خبرتكم تتناقلون محاسني % % قبل اللقاء تناقل الريحان % 39(@)(@@) % حتى اغتررت فزرتكم وكأنني % % كل طرقت بمنكبي ثهلان % % 40(@)(@@) % وعرائس لك عذرها مهجورة % % من عاتق أهديتها وعوان % PageV01P1601 41(@)(@@) % ما أنشدت كانت أشد تعلقا % % أبدا من الأقراط بالآذان % 42(@)(@@) % لو أنصفت لازداد ضعفا حسنها % % ما أجلب الإحسان للإحسان % 43(@)(@@) % فتلافين فرط الجفاء فبعد ما % % بلت رباي إذ السحاب جفاني % % 44(@)(@@) % جد غائبا لي مثل جودك حاضرا % % إني أراك على البعاد تراني % % PageV01P1602 البحر : - 1(@)(@@) % دمعي وإن كان دما سائلا % % فما أسوم الدية القاتلا % % 2(@)(@@) % من حكم الألحاظ في قلبه % % دل على مقتله النابلا % % 3(@)(@@) % بعثت طرفي بمنى قانصا % وكان في كفته حابلا % % 4(@)(@@) % سل نافث السحر بنجد متى % % حول نجد بعدنا بابلا % % 5(@)(@@) % وناد لمياء سهرنا لها ال % % ليل فلم نحرز به طائلا % % 6(@)(@@) % دينى على فيك فلا تقنعي % % وهو ملى أن يرى ماطلا % % 7(@)(@@) % أستعجل النفر المطايا فهل % % من موعد ننظره آجلا % % 8(@)(@@) % لو جمع الرأي بجمع لنا % % لم نزج من يعملة ناحلا % % 9(@)(@@) % أو كان في الركب الحسين انبرت % % كفاه أو علمك النائلا % % 10(@)(@@) % لبى بنو عبد الرحيم الندى ال % % داعي وحلوا ربعه الماحلا % % PageV01P1603 11(@)(@@) % واعتقلوا المجد بأعنانه % % بحيث يحط النسب الخاملا % % 12(@)(@@) % تمسى حقوق الجود في وفرهم % % تأخذ منه الحق والباطلا % % 13(@)(@@) % لا تعرف الجائر أحكامهم % % وما لهم لا يعرف العادلا % % 14(@)(@@) % حامون من ذابل أقلامهم % % بما يفوت الأسل الذابلا % % 15(@)(@@) % وخلفوا مجدهم لابنهم % % فقلدوه الراعي الكافلا % % 16(@)(@@) % كالسيف يحلو سلمه حاليا % % زينا ويرضي حربه عاطلا % % 17(@)(@@) % سهل إذا ما فغرت أزمة % يأكل منها الراكب الراجلا % % 18(@)(@@) % صاح على ظلمائها موقدا % % لله من ينشد لي سائلا % % 19(@)(@@) % أنحله المجد وقدما جنى الر % % أي السمين البدن الناحلا % % 20(@)(@@) % ليم على البذل فلما أبى الس % % حاب إلا أن يرى باذلا 
ms518	 % % PageV01P1604 21(@)(@@) % وافقه في الجود عذاله % % من جمع العاشق والعاذلا % % 22(@)(@@) % إذا غلا في القول سوامه % % جربت منه القائل الفاعلا % % 23(@)(@@) % والخلق الفضفاض لا ناشزا % % في جانب العجب ولا خائلا % % 24(@)(@@) % إذا السجايا خضن لؤما نجا % % مطهرا من عارها ناصلا % % 25(@)(@@) % جاد عليك الشعر شؤبوبه % مصطفيا مدحك أو ناخلا % % 26(@)(@@) % إن حل أجرى مثلا سائرا % % أو سار بقى طللا ماثلا % % 27(@)(@@) % فردا بحكم الحسن لكن ترى % % حولك منه ناديا حافلا % % 28(@)(@@) % ما استلم الركن وما أصبح ال % % حطيم من وفد منى آهلا % % 29(@)(@@) % وساقها يملأ أنساعها % % مهد رجا الله لها قابلا % % 30(@)(@@) % كوماء مع شدة تصيرها % % مجذعة أو قارحا بازلا % % PageV01P1605 31(@)(@@) % تنجزني فيك المنى وعدها % % إذا اقتضى أبناؤها ماطلا % % PageV01P1606 البحر : - 1(@)(@@) % نقيل مع الدنيا وقد أورقت لنا % % إلى دوحة لا ظل فيها ولا جنى % % 2(@)(@@) % ونغتر عجبا بالبقاء وإنما % % بقاؤك يا مغرور ساق لك الفنا % % 3(@)(@@) % أقمت وسار السابقون فسرني % % وماظعن الجيران إلا لأظعنا % % 4(@)(@@) % وصوت دهري باسم غيري مغالطا % % وإنيوإن لم يسم أول من عنى % % 5(@)(@@) % وكيف نرجي ود يوم وليلة % يزيدان مما يعديان بنقصنا % % 6(@)(@@) % يسيغ أبونا الدهر منا دماءنا % % وتأكلنا من هذه الأرض أمنا % % 7(@)(@@) % ألا طرقت صماء لا تفهم الرقى % % ولا ترهب الحاوين مسرى ومكمنا % % 8(@)(@@) % لأبنائنا ما فوقت من نبالها % % رمت أعزلا أو دارعا متحصنا % % 9(@)(@@) % أصابت صميما من رجال أعزة % علي نحتهم والمصاب بها أنا % % 10(@)(@@) % أحباي مد الدهر نحو حبيبهم % % يدا لم تصافح قط إلا لتغبنا % % PageV01P1607 11(@)(@@) % تراءت عيون الخطب خزرا لعينهم % % ألا ليت أعمى ناظرا لهم رنا % % 12(@)(@@) % سقى الله قبرا بالخضيرية الحيا % % فخضره ما أمطر المزن أدكنا % % 13(@)(@@) % أميلوا أميلوا من هوادي جيادكم % % إليه فحيوا نخبة المجد والسنا % % 14(@)(@@) % قفوا جردوها واعقلوها عقيرة % ليهزلها فقدان من كان أسمنا % % 15(@)(@@) % ومجرورة مبروزة من سروجها % % مكسرة من حولها البيض والقنا % % 16(@)(@@) % لعل أبا نصر يرد تحية % وما هو إلا فاعل لو تمكنا % % 17(@)(@@) % أيا صاحبي والترب بيني وبينه % % برغمي ما اخترت الثرى لك مسكنا 
ms519	 % % 18(@)(@@) % عهدتك مناعا أبيا فما الذي % % خدعت به فانقدت للموت مذعنا % % 19(@)(@@) % نعاك لي الناعي فما كدت منكرا % % ليومك وهو الحق أن أتيقنا % % 20(@)(@@) % فشككته مستوحشا من سماعه % % وعميته حتى انجلى وتبينا % % PageV01P1608 21(@)(@@) % أصاب الردى من شاء بعدك إنني % % أرى كل يوم بعد يومك هينا % % 22(@)(@@) % لخولست منك البدر ليلة تمه % وجوذبت منك الغصن ساعة يجتنى % % 23(@)(@@) % وكنت لآمالي الفسيحة مسرحا % % لو أن المنايا فيك أمهلت المنى % % 24(@)(@@) % عركت بقرن لا هوادة عنده % % فعمق مااسطاع الجروح وأثخنا % % 25(@)(@@) % إلى ساعة لا يبلغ الكي داءها % % ولم تشف منها جلدة القرف بالهنا % % 26(@)(@@) % ومازلت من أخذ الضنا منك مشفقا % % عليك إلى أن جاء ما هون الضنا % % 27(@)(@@) % وأستبعد اليوم الذي فيه راحة % لما تشتكي حتى دنا شر ما دنا % % 28(@)(@@) % أبا طالبصبرا وإن كان معوزا % % فلا فضل في صبر إذا كان ممكنا % % 29(@)(@@) % سلبت أخا فاحفظ عليك ثوابه % % فما نمن الله الثواب لتحزنا % % 30(@)(@@) % بكرهى أصفيت المودة باكيا % % له وقضيت الحق فيه مؤبنا % % PageV01P1609 31(@)(@@) % على أنه لو هالك رده البكا % % نثرنا خدودا في ثراه وأجفنا % % 32(@)(@@) % وكان خبالا في رزية مثله % ولؤما بدمع أن يصان ويخزنا % % 33(@)(@@) % ولكنه ما لان جنب لطارق % من الدهر إلا كان أصعب أخشنا % % 34(@)(@@) % ومن نازل الأحداث بالدمع والبكا % % فمقلته أدمى وأضلعه حنا % % PageV01P1610 البحر : - 1(@)(@@) % حملوك لو علموا من المحمول % فارتاض معتاص وخف ثقيل % 2(@)(@@) % واستودعوا بطن الثرى بك هضبة % فأقلها إن الثرى لحمول % 3(@)(@@) % هالوا التراب على دقيق شخصه % معنى التراب وقد حواه جليل % 4(@)(@@) % جسد حبست على التبلغ زاده % % فسمنت من طرفيك وهو هزيل % 5(@)(@@) % لو تعقل الدنيا بأي بقية % زال الردى عنها وأنت تزول % 6(@)(@@) % علمت ببيعك أن يومك صفقة % مغبونة ومن البيوع غلول % 7(@)(@@) % ويل أمها لا يستقيل عثارها % % عذر وأين من الحمام مقيل % 8(@)(@@) % جهل الزمان على عداوته بها % % ومن النوائب عارف وجهول % 9(@)(@@) % لم يرع صحبتك القديمة عازفا % % عنها وأين من الوفاء ملول % 10(@)(@@) % غدرت بك الأيام بعد وثيقة % كرب العراقي 
ms520	 حبلها المفتول % PageV01P1611 11(@)(@@) % أفلم يرعها منك نفس حرة % كنت الوحيد بها وأنت قبيل % 12(@)(@@) % غنيت عن الآمال باستعفافها % % ولكل صاحب حاجة تأميل % 13(@)(@@) % ورأت على بعد السؤال نصيبها % % إن النباهة بالسؤال خمول % 14(@)(@@) % ما عابها ذم الحسود إباءها % % ولها الصيان ووجهه المبذول % 15(@)(@@) % لو شئت نلت بها السماء وفسحة % في المال تبذل فضلها وتنيل % 16(@)(@@) % ولما عداك كثير حظ عازب % لما فطنت كفاك منه قليل % 17(@)(@@) % ولقلدتك على الأمور قلائدا % جيد الزمان بحليهن ثقيل % 18(@)(@@) % من صائدات صائبات مقتلا % % وهوى فمأسور بها وقتيل % 19(@)(@@) % يوما تكون أسنة مذروبة % لوليجها خلف الدروع وصول % 20(@)(@@) % لا يبلغ المسبار قعر جراحها % % وبه وفى كف المعالج طول % PageV01P1612 21(@)(@@) % فإذا وسمن على لئيم عرضه % عارا فليس لما علطن نصول % 22(@)(@@) % ويطفن يوما بالملوك حواليا % % تحفا لهن الشم والتقبيل % 23(@)(@@) % أبكارهن المطمعات نواشز % % وإناثهن المغزلات فحول % 24(@)(@@) % من كل بيت أمره بك نافذ % وعلى اشتطاطك حكمه مقبول % 25(@)(@@) % وجه الصحيفة حط عنه لثامها % % حسن على قبح المداد جميل % 26(@)(@@) % وصف الرجال المعجبون نفوسهم % % سرف المقال وكنت حيث تقول % 27(@)(@@) % يا ناشد الكلم الغرائب أعرضت % % شبها فليس لآيها تأويل % 28(@)(@@) % قم ناد في النادي ألابن نباتة % أذن فيسمع أو فم فيقول % 29(@)(@@) % واسئل غطارف من تميم أمهم % % يوم انطوى عبد العزيز ثكول % 30(@)(@@) % لم أغمدت عن نصره أسيافكم % % ولسانه من دونكم مسلول % PageV01P1613 31(@)(@@) % أو ما لبستم ما كسا أعراضكم % % رقشاء يعرض نسجها ويطول % 32(@)(@@) % ضيعتم رحما رعاها برهة % ويبيسها بكلامها مبلول % 33(@)(@@) % بادون عنك وأين منك غناؤهم % % لو أنهم حي لديك حلول % 34(@)(@@) % شنت عليك مغيرة لا تقتضى % % ذحلا ولا يودى لها مقتول % 35(@)(@@) % غابوا وأشهدك الوفاء عشيرة % منا فروعهم الكرام أصول % 36(@)(@@) % ويحول عهد بني أبيك وودهم % % لك والتراب عليك ليس يحول % 37(@)(@@) % أكرومة في حفظك اعتقلوا بها % % إذ لا يرى لأخي القبور خليل % 38(@)(@@) % يبني بنو عبد الرحيم سياجها % % حوطا عليك كما يحاط الغيل % 39(@)(@@) % وإذا ابن أيوب جرى فوراءه % % واد على الأعداء منك يسيل 