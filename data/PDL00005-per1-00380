ms361	 %~% قوام الدین ابوالقاسم نظام الدین و الدوله(@)(@@) 11 زمهمانان او خالی ز مداحان او بی کس %~% نه اندر شهرها خانه نه اندر بادیه رحله(@)(@@) 12 ز بس برسختن زرش بجای مادحان هزمان %~% زناره بگسلد کپان ز شاهین بگسلد پله(@)(@@) 13 ایا فرمان سلطان را نشسته بر لب جیحون %~% ازین پس هم بدان فرهان سپه بگذاری از دجله(@)(@@) 14 چو اندر آب روشن روز پنداری همی بینم %~% غلامان تو اسبان کرده همبر بر در رمله(@)(@@) 15 زعالم عدل تو چیزی کند نیکوتر از عالم %~% نه ممکن باشد این کاید ز شاخ رومی ار بیله(@)(@@) 16 نهانیهای اسکندر بایران آری از یونان %~% خزینه شاه زنگستان به غزنین آری از کله(@)(@@) 17 اگر تو در خور همت جهان خواهی گرفت ای شه %~% به جای هفت کشور هفتصد باشد علی القله(@)(@@) 18 جهانی وز تو یک فرمان سپاهی وز تو یک جولان %~% حصاری وز تو یک ناوک مصافی وز تو یک حمله(@)(@@) 19 به تیر از دور بربایی زباره آهنین کنگر %~% به باد حمله برگیری ز کوه بیستون قله(@)(@@) 20 چنان چون سوزن از وشی و آب روشن از توزی %~% زدوش ویل بگذری به آماج اندرون بیله(@)(@@) 21 کس کاندر خلافت جامه یی پوشد همان ساعت %~% ز بهر سوک او مادر بپوشد جامه نیله(@)(@@) 22 ز بهر جنگ دشمن دست نابرده بزه گردد %~% غلامان ترا هر دم کمان اندر کمان چوله(@)(@@) 23 عدو در صدر خویش از حبس تو ترسان بود دایم %~% نباشد بس عجب گر مار ترسان باشد از سله(@)(@@) 24 زبهر آن که از بند تو فردا چون رها گردد %~% کنون دائم همی خواند کتاب حیله دله(@)(@@) 25 به صورت گرکسی گوید: من و تو گو: روا باشد %~% ولیکن گر بخود گوید: من و تو گو معاذ الله(@)(@@) 26 محال اندیش و خام ابله بود هر کاین سخن گوید %~% نباید بود مردم را محال اندیش و خام ابله(@)(@@) 27 امیرا تا تو 
ms362	 در بلخی به چین در خانه هر ماهی %~% روان خانیان در تن همی سوزد ترا غله(@)(@@) 28 ز بیم تیغ توتا چین ز ترکان ره تهی گردد %~% اگر زین سوی جیحون گرد بادی خیزد از میله(@)(@@) 29 همیشه تا به صورت یوز دیگر باشد از آهو %~% همیشه تا به قوت شیر برتر باشد از دله(@)(@@) 30 مظفر باشد و گیتی دار و نهمت یاب و شادی کن %~% جهان خالی کن از نامردم بدگوهر سفله(@)(@@) 31 به شادی بگذران نوروز با دیدار ترکانی %~% که لبشان قبله را قبله است و قبله از در قبله PageV1P231(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بامدادان پگاه آمد با روی چو ماه %~% آنکه آراسته زو گردد هر عید سپاه(@)(@@) 2 اندکی غالیه بر زلف سیه برده به کار %~% عید را ساخته و تاخته از حجره به گاه(@)(@@) 3 گفتم ای ماه ترا زلف ز مشک سیه است %~% غالیه خیره چه اندایی برمشک سیاه(@)(@@) 4 غالیه چون به بر مشک رسد نیک شود %~% لیکن از غالیه گردد صنما مشک تباه(@)(@@) 5 مایه غالیه مشکست و بداند همه کس %~% تو ندانسته ای ای ساده دلک چندین گاه(@)(@@) 6 از کجا سرو به کار آید باقد چو سرو %~% ازکجا ماه به کار آید با روی چو ماه(@)(@@) 7 روی شستن به گلاب از چه قبل چون رخ تو %~% بی گل تازه ندیده ست کس اندر دی ماه(@)(@@) 8 گر گلاب از قبل بوی کنی نیز مکن %~% وقت گل خوش نبود بوی گلاب ای دلخواه(@)(@@) 9 مشک زلف و گل رخ را لطفی خواهی کرد %~% پیش گرد آی به ره چون به نماز آید شاه(@)(@@) 10 ملک عالم عادل پسر شاه جهان %~% میر ابو احمد بن محمود آن داد پناه(@)(@@) 11 آنکه برتر ملکی خوارترین بنده ش را %~% دست بوسد ز پی آنکه بدان یابد جاه(@)(@@) 12 شهریاران را بینی بدر خانه او %~% در شرف پیشتر و بیشتر از تخت و کلاه(@)(@@) 13 
ms363	 راه دولت زدر خانه او باید جست %~% هر کسی را که سوی دولت گم گردد راه(@)(@@) 14 بس کسا کز در او باز همی خواهد گشت %~% همچو میران و شهان با کمرو تاج و کلاه(@)(@@) 15 ران گوران خورد آن کس که رود در پی شیر %~% درگه شاه پی شیرست آنگه درگاه(@)(@@) 16 هر که دولت طلبد خدمت اوباید کرد %~% خدمتش را سبب دولت ماکرد اله(@)(@@) 17 خدمتش روز فرونست و چو کشتست درست %~% آخرش گندم پاکیزه بود اول کاه(@)(@@) 18 ره نمودن به سوی دولت کاری سره است %~% من نمودم ره و کردم همه را زین آگاه(@)(@@) 19 هر کجا از ملکان و سخیان یادکنند %~% چو ازو گفتی گفتی و سخن شد کوتاه(@)(@@) 20 خانه دانم که تهی بوده و از بخشش او %~% کان زرگشت و چنین خانه فزون از پنجاه(@)(@@) 21 هرچه در شرط جوانمردی باشد بدهد %~% هیچ کس دید جوانمرد چنین لا والله(@)(@@) 22 از پی آنکه ببخشد گنه کهتر خویش %~% شادمان گردد چون کهتر او کرد گناه(@)(@@) 23 نکند کندی وقتی که کند پاداشن %~% نکند تندی وقتی که دهد بادافراه(@)(@@) 24 از کریمی دل هر بنده نگه داند داشت %~% دل فرزند گرامی نتوان داشت نگاه(@)(@@) 25 خنک آن میر که در خانه این بار خدای %~% پسر و دختر آن میر بود بنده و داه(@)(@@) 26 مهر بانست و عجایب بود این از مهتر %~% برد بارست و شگفتی بود این از برناه(@)(@@) 27 ای بر حلم گران تو که اندر خور که %~% ای بر همت تو چرخ برین در تک چاه(@)(@@) 28 حق هر کس بشناسی چه به جاه و چه به مال %~% زین قبل نیست نراهیچ شبیه از اشباه(@)(@@) 29 از کریمی که تویی هر که حدیث تو شنید %~% نتواند که نگوید احسن الله جزاه(@)(@@) 30 بوسه ای کان ملکان پیش تو بر خاک دهند %~% خوشتر از بوسه معشوق بود سیصد راه(@)(@@) 31 شرفی داردبر چشم 
ms364	 جبین زانکه نهند %~% شهریاران جهان پیش تو بر خاک جباه(@)(@@) 32 با پدر یکدل و یکتایی اندر همه کار %~% زین قبل نیست دل هیچ کسی بر تو دوتاه(@)(@@) 33 از تو زیبد که بیاموزد هر کس پسری %~% پسری نیک شود هر که به تو کرد نگاه(@)(@@) 34 هر که او سیرت تو پیشه گرفت از همه عیب %~% پاک و پاکیزه برون آید چون زر از گاه(@)(@@) 35 کی توان بود چوتو آیت و فضل توکراست %~% آنچه ممکن نتواند بود از خلق مخواه(@)(@@) 36 بی فضایل سیر تو نتوانند گرفت %~% هر کجا آب نباشد نتوان کرد شناه(@)(@@) 37 بس هزبرا که بدین دل که توداری امروز %~% پیش تو فردا صد لابه کند چون روباه(@)(@@) 38 تانه دیر از قبل خدمت یک بنده تو %~% قیصر از قصر برون آید و خان از خرگاه(@)(@@) 39 تابه دی ماه بود کوه به رنگ مصمت %~% تا به نوروز شود دشت به رنگ دیباه(@)(@@) 40 تا به فروردین گردد چورخ و چون خط دوست %~% باغ و راغ از گل نو رسته و از سبز گیاه(@)(@@) 41 شادمان باش و بداندیش کش و دوست نواز %~% کامران باش و مخالفت شکن و دشمن کاه(@)(@@) 42 دولت و فتح نهاده سوی تو روی چنان %~% چون به آزار ز کهسار سوی بحر میاه(@)(@@) 43 عید توفرخ و تو با طرب و شادی و لهو %~% دشمنان تو همه با غم و با ناله و آه PageV1P232(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عید خوبان سرای آمد و خورشید سپاه %~% جامه عید بپوشید و بیاراست پگاه(@)(@@) 2 زلف را شانه زدو حلقه و بندش بگشاد %~% دامنی مشک فرو ریخت از آن زلف سیاه(@)(@@) 3 باد شبگیری برزلف سیاهش بوزید %~% طبل عطار شد از بوی همه لشکر گاه(@)(@@) 4 بر خر گاه فراز آمد و بر عادت خویش %~% سر خرگاه بر افکند و به من کرد نگاه(@)(@@) 5 شب تاریک فرو رفته مه اندر پس کوه %~% همه 
ms365	 خر گاه بر افروخت از آن روی چو ماه(@)(@@) 6 من در آن حال ز خواب خوش بیدار شدم %~% بنگریدم بت من داشت سر اندر خرگاه(@)(@@) 7 گفتم: این کیست مرا گفت: کمین بنده تو %~% تا دلم گشت بر آن ماه دگر باره تباه(@)(@@) 8 آفرین کردم بر شاه فراوان وسزید %~% که چنان ماه به کف کردم در خدمت شاه(@)(@@) 9 روی شاهان جهان یوسف بن ناصر دین %~% میرعادل عضد دولت سالار سپاه(@)(@@) 10 آنکه پیوسته سخاوت سوی او دارد روی %~% از پی آنکه ز گیتی سوی او داند راه(@)(@@) 11 بر او مال بهم کردن منکر گنهیست %~% نکند مال بهم زانکه بترسد ز گناه(@)(@@) 12 هر چه آمد به کف او به کف دیگر داد %~% من ازین آگهم و لشکر سلطان آگاه(@)(@@) 13 تنگدل گردد اگر گویی روزی به جهان %~% مردمی بود که دینار و درم داشت نگاه(@)(@@) 14 با چنین همت شاهانه که اندر سر اوست %~% زود باشد که به نهمت رسد ان شائالله(@)(@@) 15 فلک برشده زانجای کجا همت اوست %~% همچنان باشد کآب از بن صد بازی چاه(@)(@@) 16 دست رادان جهان کوته کرد از رادی %~% که کنددست بزرگان ز بزرگی کوتاه(@)(@@) 17 بکندهر چه شه ایران در خواهد ازو %~% هر چه دشوارترای شاه تو از میر بخواه(@)(@@) 18 میر یوسف عضد دولت شیریست دلیر %~% که همه شیران باشند بر او روباه(@)(@@) 19 همه میران جهاندیده کزو یاد کنند %~% خاک بوسند و بیالاینداز خاک جباه(@)(@@) 20 مهترین میر مبارز که به او نامه کند %~% بر نویسد ز بر نامه که: «عبده » و «فداه »(@)(@@) 21 شهریارا چو سپهدار تو این میرد لیر %~% به سپهداری کس بر ننهاده ست کلاه(@)(@@) 22 هر مصافی که بدو خویشتن اندر فکند %~% زان مصاف ایچ سخن نشنوی الا همه آه(@)(@@) 23 سپه آرای تو رو کردچون هنگام نبرد %~% رویهای چوگل سرخ کند زرد چو کاه(@)(@@) 24 جاه دارد بر شاهان زبر و بازوی 
ms366	 خویش %~% لیکن از دولت و از خدمت تو جوید جاه(@)(@@) 25 از وفای تو سرشته ست دل او و تو خود %~% آزمودستی او را به وفا چندین راه(@)(@@) 26 نهمت او همه اینست که از روی زمین %~% بکند نام عدوی تو و نام بدخواه(@)(@@) 27 دل بدخواه تو پیش تو بدوزد به خدنگ %~% همچنان چون دل آن شیر بدان سوی بیاه(@)(@@) 28 عادتی دارد نیکو و خویی دارد خوب %~% همچنین زیبد زان روی چو رنگین دیباه(@)(@@) 29 آزرانیست پناهی بجز ازدرگه او %~% زانکه جودش دهد او را به نکو جای پناه(@)(@@) 30 خادم او ز سرشوق جهان بی منت %~% چاکر او زبن گوش فلک بی اکراه(@)(@@) 31 تا همه روزه سوی ابر بود چشم زمین %~% تا همه ساله سوی بحر بود میل میاه(@)(@@) 32 تا بود هیچ شهی را به جهان خیل و حشم %~% تا بود هیچ مهی را به جهان بنده و داه(@)(@@) 33 به مراد دل او باد همه کار جهان %~% بشنواد از من این دعوت و این لفظ اله(@)(@@) 34 فرخش بادو خداوندش فرخنده کناد %~% عید فرخنده بهمنجنه بهمن ماه(@)(@@) 35 دولت اورا به همه کام و هوا راهنمای %~% ایزد او رابه همه حادثه ها پشت و پناه PageV1P233(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 از پی تهنیت روز نو آمد برشاه %~% سده فرخ روز دهم بهمن ماه(@)(@@) 2 به خبر دادن نو روز نگارین سوی میر %~% سیصد وشصت شبانروز همی تاخت به راه(@)(@@) 3 چه خبر داد خبر داد که تا پنجه روز %~% روی بنماید نو روز و کندعرض سپاه(@)(@@) 4 در کف لاله خودروی نهد سرخ قدح %~% راغ همچون پر طوطی شود از سبز گیاه(@)(@@) 5 آهو از پشته به دشت آید و ایمن بچرد %~% چون کسی کو را باشد نظر میر پناه(@)(@@) 6 میر آزاده سیر یوسف بن ناصر دین %~% پشت اسلام و هم از پشت پدر ایران شاه(@)(@@) 7 آنکه هر مهتر از طاعت او دارد قدر 
