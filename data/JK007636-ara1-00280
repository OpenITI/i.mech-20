ms261	 عود منبر % % لما عجب الرائي وان قيل أينعا % % 19(@)(@@) % كرامات من مدت يدا دعواته % % ظلالا إلى أن عمت الناس أجمعا % % 20(@)(@@) % اليك خطيب الشام لابن خطيبها % % براعة مدح كان برك أبرعا % % PageV01P1200 21(@)(@@) % مديحك فرض لازم لي فطالما % % بدأت فأسديت الجميل تطوعا % % PageV01P1201 البحر : - 1(@)(@@) % كفوا حديث العذل عن مسمعي % % فأين من يعقل أو من يعي % % 2(@)(@@) % ياعاذلي في الحسن ان كنت لم % % تبصر فاني منك لم أسمع % % 3(@)(@@) % لاتزد القلب على شجوه % % ان كنت لا تأرق لي فاهجع % % 4(@)(@@) % انا الذي يروي حديث الاسى % % مسلسلا في الحب عن مدمعي % % 5(@)(@@) % واعجبي في الحب أشكو الجفا % % من ساكن في منحنى أضلعي % % 6(@)(@@) % ان شئت يا بدر الدجى ان بدا % % فاطلع وان شئت فلا تطلع % % 7(@)(@@) % وأنت يا أغصان بان النقا % % اذا تثنى فاسجدي واركعي % % 8(@)(@@) % لا آخذ الله ليالي اللقا % % فإنها أصل الأسى الموجع % % 9(@)(@@) % لو نسيت عيناي إنسانها % % ما نسيت ليلى على الأجرع % % 10(@)(@@) % وغفلة الواشين عن وصلنا % % ونحن كالواجد في مضجع % % PageV01P1202 11(@)(@@) % يا مقلتي بالوصل قري ويا % % مدائحي في ابن حميد ارتعي % % 12(@)(@@) % شمس ينادى ذكره سرويا % % طرف الاعادي خاسئا فارجعي % % 13(@)(@@) % مستحكم الرأي ولكن متى % % تخدعه باغي نشب يخدع % % 14(@)(@@) % يزدحم اللثم على كفه % % تزاحم البهم على المكرع % % 15(@)(@@) % اذا بدا أبصرت حساده % % من مهطع الرأس ومن مقنع % % 16(@)(@@) % آراء عمر و ولهى حاتم % وحلم قيس وذكا الأصمعي % % 17(@)(@@) % جننت يا غيث متى شئت أن % % تحكي أياديه فطر أوقع % % 18(@)(@@) % ذاك الذي عم جدى بره % % وأنت في الموضع والموضع % % 19(@)(@@) % أصبح لا حرز لأمواله % % فلو عدا السارق لم يقطع % % 20(@)(@@) % تهب نعماه وبأساؤه % % من سجسج طورا ومن زعزع % % PageV01P1203 21(@)(@@) % لطافة حفت بها هيبة % كالسيف ذي الرونق والمقطع % % 22(@)(@@) % وهمة علياء تعبانة % % أي ربى في المجد لم تقرع % % 23(@)(@@) % لو أنها ألفت هلال السما % % مكان شسع النعل لم تقنع % % 24(@)(@@) % وأنمل تحنو على معدم % تحنن الثدي على المرضع % % 25(@)(@@) % وليس يعيي جودها ذا غنى % جود الحيا في الجدول المترع % % 26 
ms262	(@)(@@) % شم فضله واللفظ وانظر إلى % % صوب الغوادي والحمى الممرع % % 27(@)(@@) % نظم ونثر في عقول الورى % % كالخمر أو كالسحر أوأصنع % % 28(@)(@@) % لا غرو إن تسكر شمسية % % لموعة تصدر عن ألمعي % % 29(@)(@@) % ذو قلم يجني الغنى والفنا % % من شهده أو سمه المنقع % % 30(@)(@@) % ينهل منه القصد في منجح % % ويلجأ الجيش إلى منجع % % PageV01P1204 31(@)(@@) % أي رديني بغى حربه % % من ندم للسن لم يقرع % % 32(@)(@@) % يا سابق الناس لشأو العلى % % من حاصر باق ومن مرتع % % 33(@)(@@) % كأنما يسلك في مجهل % % وأنت في متضح مهيع % % 34(@)(@@) % تهن بالحجة مقبولة % % فائزة المقصد والمرجع % % 35(@)(@@) % والحجر المدني اليه يدا % بأكرم الحالك والأصنع % % 36(@)(@@) % وانعم ودم واسمع معاني الثنا % % على قصور الخلق واستمتع % % 37(@)(@@) % جلت معاليك على واصف % حتى غدا المادح كالمقدع % % 38(@)(@@) % وأبعدت عن حاسد كائد % أين السهى من مقعد أقطع % % 39(@)(@@) % وأبعدت علياك لي في الندى % % فجبتها بالكلم المبدع % % 40(@)(@@) % ورد نعماك الي الرجا % % فأنت شمسي والرجا يوشعي % % PageV01P1205 البحر : - 1(@)(@@) % أذات الحجى إن الحجاب ليمنع % % عن اللفظ حتى في رثائك يسمع % % 2(@)(@@) % ولكن تطويقي لهى ناصرية % % تحث على أني أنوح وأسجع % % 3(@)(@@) % ولم لا وقد أبصرته متحرقا % بفرقة حب راحل ليس يرجع % % 4(@)(@@) % أيسرع لي بالمال جودا ولا أرى % % بماء جفوني جائدا أتسرع % % 5(@)(@@) % وأما دموعي بالبكاء كأنها % % على صحن خدي من دم القلب تهمع % % 6(@)(@@) % لقد عمنا ما خصه من رزية % بأمثالها تدمي الجفون وتدمع % % 7(@)(@@) % رزية من كانت له أصل بهجة % % وكل بهيج ضمنها يتفرع % % 8(@)(@@) % فمالي لا أرثي تقاها وفضلها وأندب للمحراب قنديل غرة بنور التقى طول الدجى يتشعشع % % وأرثي له والقلب حران موجعسقط بيت ص % % 9(@)(@@) % وأندب للمعروف والبر راحة % ترى راحة تعبانها حين ينفع % % 10(@)(@@) % وأندبها للترب من حجب العلى % % وديعة أستار إلى عدن تودع % % PageV01P1206 11(@)(@@) % وأندبها لليوم صوما وللدجى % % صلاة وأذكارا ونسكا يوزع % % 12(@)(@@) % وللبيت بيت الفضل كدر صفوه % % وللبيت من ذات الصفاحين يهرع % % 13(@)(@@) % فيالك من بيت جديد بكى لها % % وبيت عتيق نحوها يتطلع % % 14(@)(@@) % ويالك من حزن تجدد 
ms263	 عندنا % % به حزن يعقوب الذي كاد يقلع % % 15(@)(@@) % وحزن أخ قد جاورته كرامة % % لها وإلى بيت الكرامات ينزع % % 16(@)(@@) % وحزن كبار أو صغار تتابعوا % % أسودا وغزلانا تسير وتتبع % % 17(@)(@@) % هو الموت كأسا من حميا حمامها % % ومن حسرات قبلها تتجرع % % 18(@)(@@) % وصرف لأرواح البرية ناقد % على أنه في أخذ نقديه مجمع % % 19(@)(@@) % وسبع ليال دائرات على الورى % % بنوع افتراس فيهمو ليس يشبع % % 20(@)(@@) % ألا في سبيبل الله نقد عزيزة % % تولت وأبقت لاعج الحزن يرتع % % PageV01P1207 21(@)(@@) % سلام ورضوان عليه ورحمة % وروح وريحان وخمر منوع % % 22(@)(@@) % على جهة إن قيل ست فانها % % عليها من الست الجهات تفجع % % 23(@)(@@) % يعز عليها نار حزن تمسه % % وتلك بجنات العلى تتمتع % % 24(@)(@@) % ولو بلغت ما مسه من مصابها % % لكادت به في جنة الخلد تجزع % % 25(@)(@@) % وما رحلت حتى رأت فيه كلما % % تمنت فليست من حمام تروع % % 26(@)(@@) % ولو خيرت لم ترض إلا بقاءه % % ونقلتها فليهنها القصد أجمع % % 27(@)(@@) % وكم مرة فداه بالنفس نطقها % % فقد صح ما كانت له تتوقع % % 28(@)(@@) % وشيعها بالبر زادا تسننا % فلله منه سنة وتشيع % % 29(@)(@@) % تهن بنو نعش لمطلع نعشها % % نعم وبنات النعش أيان تطلع % % 30(@)(@@) % وما هي إلا روعة من رزية % ولكن لها ثبت العزائم أروع % % PageV01P1208 31(@)(@@) % بليغ عرفنا صنعة اللفظ عنده % % فما قدر ما في وعظه يتصنع % % 32(@)(@@) % سقى لحدها الروضي غيث كأنه % % نداه علينا وارف وممرع % % 33(@)(@@) % وخفف عن أحشاه وهجا لو أنه % % سحائب ضيف عن قريب تقشع % % 34(@)(@@) % طمعنا بحدس في رجوع مفارق % % وفي غير من قد وارت الأرض يرجع % % 35(@)(@@) % وان منع الماضون من سعيهم لنا % % فانا عن المسعى لهم ليس نمنع % % PageV01P1209 البحر : - 1(@)(@@) % هل لك يا أرفع البرايا % % في قرية شأنها رفيع % % 2(@)(@@) % قد أحوجت عبدك الليالي % % لسفرة أمرها فظيع % % 3(@)(@@) % لم يستطع مكتري حمار % % فكيف للملك يستطع % % 4(@)(@@) % هذا وفي حظه نزول % % نعم وفي رجله طلوع % % 5(@)(@@) % ليس له طاقة ليجري % % إلا إذا فاضت الدموع % % 6(@)(@@) % فاجعل له في الانام شأد % % بفرس سوقها بديع % % 7(@)(@@) % اذا 
ms264	 تسمى الجواد بحرا % فبحرها في الفلا سريع % % 8(@)(@@) % ودم مدا الدهر في أمان % % يفديك أبناؤه الجميع % % 9(@)(@@) % فحبذا رفدك المعنى % % وحبذا وقتنا المريع % % 10(@)(@@) % شهر وفضل جود كف % % ثلاثة كلها ربيع % % PageV01P1210 البحر : - 1(@)(@@) % تسلسلت في خدي الأدمع % % معربة فاعجب لما يسمع % % 2(@)(@@) % قد رجع الدمع إلى غربة % % وعن غزال الشرق لا أرجع % % 3(@)(@@) % حبي له حب علي العلى % % وفيهما المخلص والمقطع % % 4(@)(@@) % في ذا وذا وصفي ومدحي فما % % للغير في شعري مستمتع % % 5(@)(@@) % يا من يهنى العيد والعلم والز % % مان والناس به أجمع % % 6(@)(@@) % زد كل يوم في العلى رفعة % وليصنع الحساد ما يصنعوا % % 7(@)(@@) % عيشك والقدر كما تشتهي % % تخفض هذاك وذا ترفع % % PageV01P1211 البحر : - 1(@)(@@) % أصبحت لم أخش للزمان أذى % وشافعي الزمان لي شافع % % 2(@)(@@) % حيتك قاضي القضاة من مدح % % نجوم حمد سعيدة الطالع % % 3(@)(@@) % وجاء قبر الامام سيدنا الح % % سين صوب من الرضا هامع % % 4(@)(@@) % ذاك الحسين الذي مضى فأنا % % لا هو ظام إلى اللقا جائع % % 5(@)(@@) % ذاك الذي كنت من عوارفه % % أسند عن عاصم وعن المنى نافع % % 6(@)(@@) % مباشروا الجامع الذين هم % صحبي ولكن على المنى مانع % % 7(@)(@@) % لولا نداك العميم يشملنا % % ماكان بيني وبينهم جامع % % PageV01P1212 البحر : - 1(@)(@@) % جاء البشير بها فقلت لدره % % لفظا وفضلا شنف الأسماعا % % 2(@)(@@) % سمراء إلا أنها حنطية % % تروي عطاشا للقا وجياعا % % 3(@)(@@) % وكريمة الانساب أصدقها الندى % % كفوءا اذ أمر القريض أضاعا % % 4(@)(@@) % يا آل فضل الله دمتم في الثنا % % والأجر كنزا للعفاة مشاعا % % 5(@)(@@) % يسقى نداكم من نباتي الثنا % % زرعا يغاث فيعجب الزراعا % % 6(@)(@@) % وتؤمرون قصائدي من بعد ما % % كابدت من حالي الضعيف ضياعا % % 7(@)(@@) % كم ضيعة للحال كانت قطعة % % فغدت بضيعة غلة أقطاعا % % PageV01P1213 البحر : - 1(@)(@@) % نعم لي وقفة لا للدموع % % على تلك المنازل والربوع % % 2(@)(@@) % لجيران العقيق أفضت دمعي % % مناسبة بمحمر النجيع % % 3(@)(@@) % وفي تاج الزمان نظمت درا % % فيا لله من عقد بديع % % 4(@)(@@) % كريم الوصف والانساب قالت % % أضف لسنا الأصول سنا الفروع % % 5(@)(@@) % كذا قاضي القضاة مدا الليالي % % محلى التاج بالنظم 
ms265	 الرفيع % % 6(@)(@@) % لقد طلعت علينا من سناه % % نجوم اليمن بالخصب المريع % % 7(@)(@@) % نداه وفصلنا والشهر فيه % % ربيع في ربيع في ربيع % % PageV01P1214 البحر : - 1(@)(@@) % على اليمن والنعمى قدوم أحبة % تخب بهم عيس الركاب وتوضع % % 2(@)(@@) % لركبهم المصري قلبي هدية % % على أن دمعي بالمسرة ينبع % % 3(@)(@@) % أمولاي نور الدين هنئت حجة % زكا لكم فيها مسير ومرجع % % 4(@)(@@) % أتمت مساعيك الزكية نسكها % % وما فاتنا من جود كفك منجع % % 5(@)(@@) % فان فاز مولانا بحج أتمه % % فها نحن في نعمائه نتمتع % % 6(@)(@@) % وإن لم يكن في وقفة جمعية % % فها نحن فيكم بالهنا نتجمع % % 7(@)(@@) % مدائحنا فيكم وفي مثل بيتكم % % فروض وفي بعض الأنام تطوع % % PageV01P1215 البحر : - 1(@)(@@) % برغمي أن شرعت له رثاء % ولم ألزم بتهنئة شروعا % % 2(@)(@@) % وليد كان يا أسفي حبيبا % أبى تسيار كوكبه رجوعا % % 3(@)(@@) % وما قلبي اذا حجر فيسلو % % هلالا قبل ما اكتمل الطلوعا % % 4(@)(@@) % فيا ولدي تولد حزن قلب % فعم أصول بيتك والفروعا % % 5(@)(@@) % ومس عيون من فارقت شر % فأصبح كل إنسان جزوعا % % 6(@)(@@) % أما والجاريات بصحن خد % بكت والموريات ورت ضلوعا % % 7(@)(@@) % لقد أطفا شميعة نور بيت % ردى كم مثلها أطفا شموعا % % PageV01P1216 البحر : - 1(@)(@@) % يا اماما لم يزل في الفض % % ل ذا كف صناعي % % 2(@)(@@) % باهر قولا وفعلا % % في عيان وسماع % % 3(@)(@@) % مااسم ذي حجم لطيف % % بين أيدي القوم ساعي % % 4(@)(@@) % ناحل أصفر من % % غير سقام وارتياع % % 5(@)(@@) % وهو مصري ومطب % % وع لذيذ الاجتماع % % 6(@)(@@) % وهو في الخط خماس % % ي وفي اللفظ رباعي % % PageV01P1217 البحر : - 1(@)(@@) % يقولون تبكي والديار قريبة % % اذا بعدت أوطانهم كيف تصنع % % 2(@)(@@) % دعوا مقلتي العبري تجود بمائها % % عسى أن حزن من الجفن يوضع % % 3(@)(@@) % وثقت بتنكيد الفراق فأسبلت % % جفوني وعجلت الذي أتوقع % % 4(@)(@@) % وما هي الا مهجة ذاب شطرها % % فسالت بها من فوق خدي أدمع % % 5(@)(@@) % وعما قليل ينفذ البين سهمه % % فلا مهجة تبقى ولا دمع يهمع % % PageV01P1218 البحر : - 1(@)(@@) % عملت للمولى الذي ذاته % % على فنون الفضل مجموعه % % 2(@)(@@) % روضة نرد كم هزار بها % % نغمته في الطاس مسموعه % % 3 
ms266	(@)(@@) % ان كان للشطرنج منصوبة % % فرتبتي في الحسن مرفوعه % % PageV01P1219 البحر : - 1(@)(@@) % للبغلة الشهباءعذر بين % % اذ قيل قد وقعت ووصف جامع % % 2(@)(@@) % هي كوكب حملت مطالع نير % % بين التقى والفضل نعم الطالع % % 3(@)(@@) % فمن المسرة فهي نسر طائر % % ومن المهابة فهي نسر واقع % % PageV01P1220 البحر : - 1(@)(@@) % يا منزل ابن علي حيتك الصبا % % وسقى مرابعك الغمام الهامع % % 2(@)(@@) % صفت بك الاغصان صف جماعة % % والغصن إما قائم أو راكع % % 3(@)(@@) % ورقى لديك الطيرمنبر ايكة % % فعلمت أنك للمسرة جامع % % PageV01P1221 البحر : - 1(@)(@@) % سل عن مقامي والرؤوس حوائم % تحت العجاجة والنسور وقوع % % 2(@)(@@) % والمرهفات على الجسوم شوابك % % حتى كأن المرهفات دروع % % 3(@)(@@) % هل أكشف الغمى ووجهي مسفر % فأروق عادية الوغى وأروع % % PageV01P1222 البحر : - 1(@)(@@) % تفترس الناس في هواها % % مالكة للقلوب تدعو % % 2(@)(@@) % مليحة حجبت وشاعت % % فخاب طرس وفاز شمع % % 3(@)(@@) % عجيبة الإسم قيل خمس % و قيل ست وقيل سبع % % PageV01P1223 البحر : - 1(@)(@@) % و صديق أنشدته لي بي % % تين حوت في الصداع معنى بديعا % % 2(@)(@@) % فادعاها لأجنبي ولو كا % % ن ادعاها لخاف أمرا شنيعا % % 3(@)(@@) % فقلت ليسا له ولا لي تعزى % % و استرحنا من الصداع جميعا % PageV01P1224 البحر : - 1(@)(@@) % تحمل حيث كنت صداع قصدي % % فقصد سوك مالا يستطاع % % 2(@)(@@) % إذا ما كنت للرؤساء رأسا % فلا تنكر اذا حصل الصداع % % PageV01P1225 البحر : - 1(@)(@@) % دع من شفيع صحبة ما أذنبت % % و اهنأ بمحبوب الجمال بديع % % 2(@)(@@) % و اذا الحبيب أتى بذنب واحد % جاءت محاسنه بألف شفيع % % PageV01P1226 البحر : - 1(@)(@@) % عملت لمن جود أقلامه % % ربيع ومنطقه بارع % % 2(@)(@@) % إذا طلع الخط رملته % % فيا حبذا الرمل والطالع % % PageV01P1227 البحر : - 1(@)(@@) % لئن ضاع مثلي عند مثلك انني % % لعمر المعالي عند أضيع % % 2(@)(@@) % متى تنجع الشكوى اذا أنا لم أجد % % لديك اعتنآء غير أنك تسمع % % 3(@)(@@) % و ما كان صعبا لو مننت بلفظة % % ترد بها عني الخطوب وتردع % % 4(@)(@@) % و قلت امرؤ للشكر والأجر قابل % و للبر فيه والصنيعة موضع % % 5(@)(@@) % و مغترب عن قومه ودياره % % أساعده والله يعطي ويمنع % % 6(@)(@@) % سأصبر حتى تنتهي مدة الجفا % % و ما الصبر الا بعض 
ms267	 ما أتجرع % % 7(@)(@@) % عسى ظلمة الحي التي قد تعرضت % % سحابة صيف عن قريب تقشع % % 8(@)(@@) % على أنني راض بما أنا صانع % % وصول الولا لو أنني أتقطع % % 9(@)(@@) % حبست لضيق الرزق حبس حمامة % % فها أنا فيكم بالمدائح أسجع % % 10(@)(@@) % و أصبح فكري كالعبير سواده % % إذا نفحته جذوة يتضوع % % PageV01P1228 11(@)(@@) % شاب فود الصب حزنا مثل ما % % هم بالهجر حبيب ودعه % % 12(@)(@@) % يالشيب عم وجها فبكى % % كيف لا يبكي لشيب قنعه % % 13(@)(@@) % يا لقلب مودع سر الأسى % % ودع الصب وماذا أودعه % % 14(@)(@@) % يا عليا لست أنسى بره % % و هو لا ينسى مديحا يسمعه % % 15(@)(@@) % سيدي كن غوث ألفاظي فقد % % أصبحوا من شامهم في مضيعه % % 16(@)(@@) % حسرتي مع اذ ومع ذا فأنا % % معهم مع بعدهم في معمه % % 17(@)(@@) % غير أني قائل قول فتى % % كضه صد فأبدى جزعه % % 18(@)(@@) % لا تهني بعد ما أكرمتني % % فشديد عادة منتزعه % % 19(@)(@@) % و ابق ذا الفضلين فضلا حازه % % وارث العليا وفضلا جمعه % % 20(@)(@@) % واهن بالعيد وألف مثله % % في سناء أو هناء أودعه % % PageV01P1229 21(@)(@@) % قل لوزير الملك يا من له % % عزائم مثل الظبا تقطع % % 22(@)(@@) % يا زارعا مني النبات الذي % % يعجب بالأمداح مع يزرع % % 23(@)(@@) % هنئتها ياسيدي خلعة % قلوب أعداك بها تخلع % % 24(@)(@@) % بيضاء كم ظرف عدى بيضت % % حتى تمنى أنه يقلع % % 25(@)(@@) % من فوق خضراء سقى روضها % % غيث أياديك التي تهمع % % 26(@)(@@) % قالت وقد راق لها منظر % كالبدر من أزرارها يطلع % % 27(@)(@@) % زد كل يوم في العلى رفعة % و ليصنع الحاسد ما يصنع % % 28(@)(@@) % عش لعفاة طوقوا بالندى % % فالكل في دوح الثا يسجع % % 29(@)(@@) % الدهر نحوي كما ينبغي % % يدري الذي يخفض أو يرفع % % 30(@)(@@) % حلفت لها بالعاديات دموعي % % و بالموريات النار وهي ضلوعي % % PageV01P1230 31(@)(@@) % لئن كان من قد لامني غير مبصر % % محاسنها إني لغير سميع % % 32(@)(@@) % محجبة تفتر عن مبسم كما % % ينظم في أزكى الأنام بديعي % % 33(@)(@@) % فريد العلى والعلم والحلم والتقى % % فيا لفريد حائز لجميع % % 34(@)(@@) % يضوع قريضي في الورى بامتداحه % % و ما جوده لي في الورى بمضيع 
ms268	 % % 35(@)(@@) % أصوغ بسيطا في الثنا وكاملا % على وافر من جوده وسريع % % 36(@)(@@) % و لا عيب في احسانه غير أنني % % شرهت فمالي وصف قنوع % % 37(@)(@@) % بشهر ربيع قد أتيت مهنئا % و كل زماني منه شهر ربيع % % 38(@)(@@) % فلا زال من خدام مدحي لفضله % % صوابي ونجحي مقبلا وشفيعي % % 39(@)(@@) % كتم الحب جهده فأزاعه % % مدمع زاد قسمه فأشاعه % % 40(@)(@@) % ليس لي من ذوي الملاحة الا الد % % مع قامت به علي الشناعة % % PageV01P1231 41(@)(@@) % أمرتني الاشجان أمر الندى لاب % % ن علي فقلت سمعا وطاعه % % 42(@)(@@) % دام قاضي القضاة بحر علوم % % وندى عم سنة وجماعة % % 43(@)(@@) % من هبات الوهاب في الخلق تبقى % % طول دهر وفي العدى سم ساعه % % 44(@)(@@) % ليس فيه عيب سوى فرط جود % % قد نهانا عن مستحب القناعة % % 45(@)(@@) % علمتنا نعماه وصف علاه % % فلها الفضل بالغنى والبراعة % % 46(@)(@@) % لله طرف غداة البين قد همعا % % وحملته الليالي فوق ما وسعا % % 47(@)(@@) % بين السهاد وبين الدمع مقتسم % % فيكم فما جف من شوق ولاهجعا % % 48(@)(@@) % يخادع الشوق طرفي عن مدامعه % % أن الكريم اذا خادعته انخدعها % % 49(@)(@@) % ويقتضي الهم تسهادي فيا حربا % من قاتلين على انساني اجتمعا % % 50(@)(@@) % سحقا ليوم النوى ماذا رمى بصري % % حتى استهل وماذا بالحشا صنعا % % PageV01P1232 51(@)(@@) % وقائل ماالذي أبكاك قلت له % % شخص رمى بالنوى طرفي فقد دمعا % % 52(@)(@@) % قل للامام محمد % % ذي الفضل والكرم المذاع % % 53(@)(@@) % يا صاحب القصد الجمي % % ل يحف بالأمر المطاع % % 54(@)(@@) % حاشاك أن تنسى له ال % % كتاب ذا حال مضاع % % 55(@)(@@) % في الطرس من فرجيتي ال % % بيضاء أكتب بالرقاع % % 56(@)(@@) % ألا رب ذي ظلم كمنت لحربه % % فأوقعه المقدار أي وقوع % % 57(@)(@@) % وماكان لي إلا سلاح تهجد % % وأدعية لا تتقى بدروع % % 58(@)(@@) % وهيهات أن ينجو الظلوم وخلفه % % سهام دعاء من قسي ركوع % % 59(@)(@@) % مريشة بالهدب من جفن ساهر % % منصلة أطرافها بدموع % % 60(@)(@@) % يفوت عياني مشهد من جمالكم % % فيجمع طرفي والمدامع جامع % % PageV01P1233 61(@)(@@) % هوى مطمع إنسان عيني وإنما % % تقطع أعناق الرجال المطامع % % 62(@)(@@) % بروحي من نظمت في خصرها الثنا % % فرحت وفي لاشيء 
ms269	 نظمي ضائع % % 63(@)(@@) % وأودعتها قلبي وصبري والكرى % % وحكم الهوى أن لا ترد الودائع % % 64(@)(@@) % أيا تاج دين الله شكرا لأنعم % أجبت بها راجيبك من قبل ما دعا % % 65(@)(@@) % وأبقيتها تستنطق الخلق بالثنا % % وتشهد بالأجر الملائك أجمعا % % 66(@)(@@) % وإن قصرت عن بارع الحمد قدرتي % % فو الله ما قصرت عن نافع الدعا % % 67(@)(@@) % لقد قنعت رجواي من قبل ما رأت % % شهاب العلى والعلم في الشام يطلع % % 68(@)(@@) % فلما رأتك الآن اسفر وجهها % % وأقسم لا والله لا تتقنع % % 69(@)(@@) % فما الغيث إلا من بنانك قطرة % % وما الغيث من يمينك أصبع % % 70(@)(@@) % قل لوزير الملك يا من به % % تروي بلاد الشام عن نافع % % PageV01P1234 71(@)(@@) % حاشاك أن تروي البنات الذي % % كم ارتوى من غيثك الهامع % % 72(@)(@@) % وحق إنعامك يا مالكي % % مالي سوى عطفك من شافع % % 73(@)(@@) % هنئت بالأعوام تلبس بردها % % متجددا ويماط عنك خليع % % 74(@)(@@) % في نعمة جزمت بأنك خافض % قدر الحسود وقدرك المرفوع % % 75(@)(@@) % قد أعجبت فيها الشهور وأعشبت % % للقاصدين فكلهن ربيع % % 76(@)(@@) % ناعورة نشأت على عهد الأسى % % مثلي فما تنفك ذات توجع % % 77(@)(@@) % كانت قضيبا قبل ذلك يانعا % في أيكة نبتت بإثرة موضع % % 78(@)(@@) % ناح الحمام بها وأبكاني الأسى % % فتعلمت نوح الحمام وأدمعي % % 79(@)(@@) % وناعورة كانت قضيبا فأصبحت % % إلى القضيب شوقا كالحمامة تسجع % % 80(@)(@@) % شكوت لها ضر الغرام وحالها % % كحالي بكاء أو حنينا يرجع % % PageV01P1235 81(@)(@@) % ولا بد من شكوى إلى ذي مروءة % % يواسيك أو يسليك أو يتوجع % % 82(@)(@@) % أمين العلى والعلم هنئت حجة % وعودا لديه الأجر والذكر أجمع % % 83(@)(@@) % وقصدا سعيدا لم تضع فيه ثروة % % و ما ضاع إلا نشرها المتضوع % % 84(@)(@@) % تمتع مولانا بعمرة حجة % وها نحن في نعمائه نتمتع % % 85(@)(@@) % في كل يوم خلعة بدرية % % طلعت بها الآمال أشرف مطلع % % 86(@)(@@) % قالت للابسها سعادة نطقه % % قل يا محمد في الممالك أودع % % 87(@)(@@) % الفضل إرثك والمهابة والنهى % % فافخر وأوقع بالعداة ووقع % % 88(@)(@@) % يا تاج دين الله كم نعمة % لنعمة بين الورى تتبع % % 89(@)(@@) % عش لعفاة طوقوا بالندى % % فالكل في دوح الثنا يسجع 
ms270	 % % 90(@)(@@) % عيشك والقدر كما ترتضي % % يخفض هذاك وذا يرفع % % PageV01P1236 91(@)(@@) % هنئت بالعيد السعيد وحبذا % % لبقاء شملك بالهنا مجموع % % 92(@)(@@) % في رفعة وسعادة ما برها % % في الخلق مقطوع ولا ممنوع % % 93(@)(@@) % ولحالنا المكسور يدعو برك ال % % منصوب يا من قدره المرفوع % % 94(@)(@@) % قاضي قضاة الدين دم في علي % لا تلحن الأيام في رفعها % % 95(@)(@@) % وانظر بنعماك إلى حال ذي % % ضرورة يعجز عن دفعها % % 96(@)(@@) % قد أدبر الصوم ولي مقلة % % ما نظرت قط سوى دمعها % % 97(@)(@@) % عش مهنا بألف عام وعيد % بين جزم من الأمور ورفع % % 98(@)(@@) % يا اماما ان هان قدري فلي من % % خمس بمناك عائدات بنفع % % 99(@)(@@) % حبذا عشرنا ويا حبذا الخم % % س ولو أنها بنفع وصفع % % 100(@)(@@) % تتوارد المداح في أوصافكم % % يا آل فضل الله نظما مبدعا % PageV01P1237 101(@)(@@) % مسكية الأقلام في أطراسها % % بين القصائد سجدا أو ركعا % % 102(@)(@@) % ان قصرت في مدحة مع بذلها % % جهدا فلا والله ما قصر الدعا % % 103(@)(@@) % أيا ملكا فاق الكرام وفاتهم % % أما آن تحظى لديك ذرائعي % % 104(@)(@@) % أيحسن بعدي عن بلادك بعد ما % % عرفت بقول في صفاتك بارع % % 105(@)(@@) % وما أسفي أن الثواء يفوتني % % ولكن لقدر عند غيرك ضائع % % 106(@)(@@) % أيا ملك الشجاعة والمعالي % % ونشر العلم والحسب الرفيع % % 107(@)(@@) % قدومك هذه الأيام فيه % % جناس مذكر كتب البديع % % 108(@)(@@) % كريم ثم فضل ثم شهر % ربيع في ربيع في ربيع % % 109(@)(@@) % يا من تبينت السيادة أنه % % في الناس ملء عيونها وسماعها % % 110(@)(@@) % ما بالوسائل فضل رأيك يقتضي % % ان الشموس منيرة بطباعها % % PageV01P1238 111(@)(@@) % قدمت أميرا في بني الدهر آمرا % على الدهر يصغي سامعا ويطيع % % 112(@)(@@) % ولا عجب للشهر وافق مقدما % فكل زمان في حماك ربيع % % 113(@)(@@) % وعيشك لولا سقم جسمي والبكى % % لما كان سري في هواك بذائع % % 114(@)(@@) % لئن لم يسر في بحر شعري فقد سرى % % بأشعار سقمي في بحور مدامعي % % 115(@)(@@) % يا ناصب القد عالي الحسن مرتفع % % فالحب ما بين منصوب ومرفوع % % 116(@)(@@) % جوارحي وكتابي قد نهبتهما % % ففي يديك على الحالين مجموعي % % 117(@)(@@) % سلت مهجة قد 
ms271	 كان صدعها الاسى % % فلا آخذ الله الاسى بصدوعها % % 118(@)(@@) % وعينا على حالي بعاد وجفوة % % عفا الله عما جرى من دموعها % % 119(@)(@@) % وقائلة لي بعد ما شاب مفرقي % % وفكري في تيه الشبيبة يرتع % % 120(@)(@@) % أترجع عن لهو الصبا بملامة % % فقلت ولا والله بالشيب أرجع % % PageV01P1239 121(@)(@@) % وناعورة قسمت حسنها % % على ناظر وعلى سامع % % 122(@)(@@) % وقد ضاع نشر الربى فاغتدت % % تدور وتبكي على الضائع % % 123(@)(@@) % أحسن بها ناعورة في روضة % % عن جعفر يروي الهناء ربيعها % % 124(@)(@@) % هذا وليس يعد موج دموعها % % وتعد من فرط السقام ضلوعها % % 125(@)(@@) % نعتوك حقا بالامام لما حوت % % علياك من نسك وعلم بارع % % 126(@)(@@) % وأعنت أرباب المقاصد شافعا % لهم فأهلا بالامام الشافع ي % % 127(@)(@@) % وزير التقى هل أنت في العشر عاطف % % على فاقتي بين الورى وخضوعي % % 128(@)(@@) % وماالعشر الا العسر في كل حالة % % ولكنني نقطته بدموعي % % 129(@)(@@) % ياسائلي عن حظ خطي وقد % % أهملت في كتاب هذي البقاع % % 130(@)(@@) % معلومي الثلث ويا ليته % % ورسمي النسخ وثوبي الرقاع % % PageV01P1240 131(@)(@@) % قد أفقرتني غيداء واصلة % % فدمع عيني غير مقطوع % % 132(@)(@@) % وكنت أبكي من الغرام بها % % فصرت أبكي منها من الجوع % % 133(@)(@@) % يا إمام التقى مضى ربع عام % من وصولي ولم يصل لي ربع % % 134(@)(@@) % سنة إن غفلت عني فيها % % كسرتني وكيف لا وهي سبع % % 135(@)(@@) % يا مديد النوال دعوة راج % حثه جودك البسيط السريع % % 136(@)(@@) % لا نبالي ان قيل شهر جمادى % % كل شهر براحتيك ربيع % % 137(@)(@@) % صحاب قصدنا عن لقاهم منافعا % فلم نر شيئا من وجوه المنافع % % 138(@)(@@) % رجا شافع نسج المودة بيننا % % ولا خير في ود يكون بشافع % % 139(@)(@@) % اصبروا للرقاع أكتب فيها % % كل يوم حوائجي وصداعي % % 140(@)(@@) % واحسبوا أنها كما حكم الده % % ر عراة تسمى بذات الرقاع % % PageV01P1241 141(@)(@@) % سيدي ان الذي أوصل لي % % فقده من ظنه أن يمنعا % % 142(@)(@@) % سلم المعلوم شهرا واحدا % ثم ما سلم حتى ودعا % % 143(@)(@@) % يا جاعل الجامع المعمور منتظرا % محاسنا منه في الأوصاف مبتدعه % % 144(@)(@@) % تركت للشوق حرا في جوانحنا % % فلا خلا منك لا صف ولا 
ms272	 جمعه % % 145(@)(@@) % صف مكرمات وزير مصر عزيزها % % فالفخر ثم الفخر حيث يشاع % % 146(@)(@@) % فاذا حسبت فعنده القلم الذي % % شهد الحساب بأنه نفاع % % 147(@)(@@) % أكرم بأوقات لنا شمسية % % ما ضر وفق زمانها تربيع % % 148(@)(@@) % عدلت وعدلت الزمان فكلها % % في المكرمات وفي الشهور ربيع % % 149(@)(@@) % بروحي مهاة تفضل الشمس مطلعا % وتسكن أحشاء الأديب المروع % % 150(@)(@@) % وقد صرعت قلبي وشقته فاعجبوا % % لبيت لها في الحالتين مصرع % % PageV01P1242 151(@)(@@) % ما انقطع المملوك عن ترداده % % وأنت تدري أن ذاك ممتنع % % 152(@)(@@) % فالحمد لله على علمك يا % % مولاي إني بشر لا ينقطع % % 153(@)(@@) % ترى هل يبلغ المخدوم أني % % لدى الكتاب في حال مضاع % % 154(@)(@@) % أرجي درهم المعلوم ثلثا % واكتب في ثيابي بالرقاع % % 155(@)(@@) % اشكو لفضلك حرفة % % مالي بها مستمتع % % 156(@)(@@) % أحوال معلومي تسو % % ء وصاحب لا ينفع % % 157(@)(@@) % جواب أتاني في ساعة % % يدل على نفث أصل اليراعة % % 158(@)(@@) % ومن عجب الدهر أني به % % تلذذت مع أنه سم ساعه % % 159(@)(@@) % بكيت على لقيا أناس وددتهم % % وان كان لاضري يعد ولا نفعي % % 160(@)(@@) % وان قيل دون القلتين مكانه % % فما في دون القلتين ولا دمعي % % PageV01P1243 161(@)(@@) % ياشيخ علم وشيخ علم % % فمن عيان ومن سماع % % 162(@)(@@) % رفعت قدري عطا ولفظا % يا سيدي أحمد الرفاعي % % 163(@)(@@) % نوالك السعدي يا سيدي % % أرجو على عاداته مربعه % % 164(@)(@@) % لي أشهر أربعة أخرت % % فحظي المشؤوم بالأربعة % % 165(@)(@@) % أفدي صديقا كنت وهو بغيظه % % متطارحين من الكلام بديعه % % 166(@)(@@) % مازالت الحساد تسعى بيننا % % حتى تناكرنا الكلام جميعه % % 167(@)(@@) % أفدي سطورا من كتابك أقبلت % % بعد الجفاء وآذنت برجوع % % 168(@)(@@) % قبلتها فاحمر نقش حروفها % % فكأنني رملتها بدموعي % % 169(@)(@@) % ولما رنت لي ألحاظه % % رفعت بتكبيري الصوت رفعا % % 170(@)(@@) % فيالك في الحسن من أغيد % % تبدى غزالا فكبرت سبعا % % PageV01P1244 171(@)(@@) % بعثت به واثقا أن لي % % شفاعة ذي أمل نافع % % 172(@)(@@) % ولا شيء أحسن من مالك % % تجود يداه على شافع % % 173(@)(@@) % جبين سلطاننا المرجى % % مبارك المطلع البديع % % 174(@)(@@) % يا بهجة الدهر ان تبدى % % هلال شعبان في ربيع % % 175(@)(@@) % تأخرت عنكم يا بني ويا أبي 
ms273	 % % وما أنا إلا البعض ماض جميعه % % 176(@)(@@) % وعود نباتي متى يرتجي بقا % % وقد مات منه أصله وفروعه % % 177(@)(@@) % ألا يارب خل أرتجيه % % كما يرجى من الوثن انتفاع % % 178(@)(@@) % رميت بوده وصدفت عنه % % فلا ود لدي ولا سواع % % 179(@)(@@) % لهفي لشعر بارع نظمته % % تحتاج بهجته لرفد بارع % % 180(@)(@@) % در يتيم قد تضوع نشره % % يا من يرق على اليتيم الضائع % % PageV01P1245 181(@)(@@) % أبثك يا أخا العلياء أني % % سئمت من الليالي كم تروع % % 182(@)(@@) % أما ينفك قدري في نزول % % ببلدتكم وفي جسمي طلوع % % PageV01P1246 البحر : - 1(@)(@@) % ألا في سبيل الحب حال مسهد % لثعلب هذا الفجر عنه مراغ % % 2(@)(@@) % يراعي نجوم اليل تبرا ودأبه % % أماني من عهد الوصال تصاغ % % 3(@)(@@) % دعا شجوه فقد الأحبه والصبا % % فما للكرى في مقلتيه مساغ % % 4(@)(@@) % أحباي لي في اليوم شغل بصبونتي % % وشيبي وفي أهل الملام فراغ % % 5(@)(@@) % وكم عاقب اللوام والشيب في الهوى % % محبا وفي جلد المحب دباغ % % 6(@)(@@) % صبغت مشيبي راجيا عودة الصبا % % وهيهات منه دعوة وبلاغ % % 7(@)(@@) % كذلك أفكار المشيب اذا سرت % % وفي بعض باذنجانهن صباغ % % 8(@)(@@) % دع الغي بعد الأربعين فكم دعا % % هداة الورى داعي الغواة فزاغوا % % 9(@)(@@) % وقد أسقط العالي بناثر ساقط % % كطاهر ماء المزن حين بلاغ % % 10(@)(@@) % تبارك من صان العلى بعليها % % على حين رام السائدون وراغوا % % PageV01P1247 11(@)(@@) % ثنى كل باع عن مداها ممدح % % كأن ثناه في البسيطة باغ % % 12(@)(@@) % ووافى وأوقات الزمان كثيفة % % فها هي كالبيض الحسان رفاغ % % 13(@)(@@) % أخو الفضل والالفاظ قالت وعلمت % % فأصغى اليها المادحون وصاغوا % % 14(@)(@@) % وقاضي قضاة الشام والذكر والندى % % بحيث ثبير فالحسا فأباغ % % 15(@)(@@) % على كل واد للندى منه مبسم % وفي كل حي للصنائع داغ % % 16(@)(@@) % من المعشر السامين كاد وليدهم % % يقول لنظام المدائح ناغوا % % 17(@)(@@) % كأن العلى شخص لهم منه قد سعا % وفي الناس كعب للعلى ودماغ % % 18(@)(@@) % أمولاي خذ ها ذات نظم موشع % % على أوجه الأنداد ذاك رداغ % % 19(@)(@@) % وما القول إلا كالورى متفاوت % فمنه صهيل أو فمنه تواغ % % PageV01P1248 البحر : - 1(@)(@@) % رشأ رشفت رضا به أو ثعلب 
ms274	 % % ما للمحب إلى رضاه بلوغ % % 2(@)(@@) % حلو اللمى متمنع يعطيك من % % طرف اللسان حلاوة ويروغ % % 3(@)(@@) % لا مثل أقلام بيمنى سعدها % % لفظا وفضلا كلهن بليغ % % 4(@)(@@) % لسطورها صبغ يرد شبيبة % % منا وللنعمى لديه سبوغ % % 5(@)(@@) % نبغت فضائله وجدوى كفه % % ناهيك نابغة له ونبوغ % % 6(@)(@@) % فليهنه العيد السعيد لمثله % % مدح تساغ لوارد وتسوغ % % 7(@)(@@) % من جوده ذهب ومن ألفاظه % % درر تباح لنا ونحن نصوغ % % PageV01P1249 البحر : - 1(@)(@@) % هنئت يا أعلى الورى رتبة % % مدائحا حكمتها بالغه % % 2(@)(@@) % شقيقها في الحب ياسيدي % % ما كان في النعمان للنابغة % % 3(@)(@@) % كم نعمة أسبغتها للورى % % فهي على عرض الورى سابغة % % PageV01P1250 البحر : - 1(@)(@@) % ولا ئط ألثغ قلنا له % % أفلست قال استمعوا الفدغا % % 2(@)(@@) % أنا امرؤ درهم تحصيله % % يخرج من بغا إلى بغا % % PageV01P1251 البحر : - 1(@)(@@) % مائت إنسان عيني عسجدا % من خدود قد ملاها الحسن صبغا % % 2(@)(@@) % قلت والردف أريني فانثنت % % ثم قالت هكذا الانسان يطغى % % PageV01P1252 البحر : - 1(@)(@@) % شكرا لها من أنعم سعدية % غنى بها المثنى غناء سائغا % % 2(@)(@@) % منديل بعض الناس كأس مكارم % % يعطيك ملآنا ويأخذ فارغا % % PageV01P1253 البحر : - 1(@)(@@) % قاسي الجوانح لين الاعطاف % % أهواه في الحالين غصن خلاف % % 2(@)(@@) % رشأ من الأتراك إلا أن في % % جفنيه ما في الهند من أسياف % % 3(@)(@@) % أدنى حياصته إلى أردافه % % فانظر لزخرفها على الاحقاف % % 4(@)(@@) % واعجب لشكوى الخصررقة حاله % % ومن الغنى لشكاية الأرداف % % 5(@)(@@) % ولتاركي في حبه وكأنما % % إنسان عيني مبتلى برعاف % % 6(@)(@@) % أفديه عسال القوام اذا مشى % % واذا يشاء فمعسل الترشاف % % 7(@)(@@) % تلتف قامته بوارد شعره % % فأرى الشقا في جنة ألفاف % % 8(@)(@@) % ولقد أرى طرق الرشاد بتركه % % لكن قلبي مولع بخلافي % % 9(@)(@@) % واشقوتي منه بخصر مخطف % % نهب السلو وناظر خطاف % % 10(@)(@@) % إن خاب سائل أدمعي في حبه % % فلكثرة الإلحاح والإلحاف % % PageV01P1254 11(@)(@@) % وأكاد أصدق ثم يطمعني به % % بشر يغير الدر في الأصداف % % 12(@)(@@) % لا اليأس يثبت لي عليه ولا الرجا % % فكأنني في موقف الأعراف % % 13(@)(@@) % ولرب ذي عذل اذا بل البكى % % ردني باكر مسمعي بنشاف % % 14(@)(@@) % مالي وللعذل في متحكم % لي في الهوى 
ms275	 مضن لديه وشاف % % 15(@)(@@) % إني لأطلب لا لشيء وصله % % إلا لينظر في الوصال عفافي % % 16(@)(@@) % ما كان في العشرين يهفو منطقي % % أيكون في الخمسين فعل هاف % % 17(@)(@@) % شيم عن السلف الذكي ورثتها % % لا في الصبي عييت علي ولا في % % 18(@)(@@) % لي حين أنسب أسرة عربية % كادت تعد الشهب من أحلافي % % 19(@)(@@) % وفضائل ما قد سمعت وأنها % % لمسامع الأشراف كالأشناف % % 20(@)(@@) % ولرب ورد عفته لتدلك % ولو أنه نهر المجرة طاف % % PageV01P1255 21(@)(@@) % ما أجور الأيام في إهمالها % % حقي وأعدلها عن الانصاف % % 22(@)(@@) % أشكو التأخر في الزمان وهذه % % شيمي لديه وهذه أسلافي % % 23(@)(@@) % عطفا أحال الدين والدنيا على % % حالي فعندك يحسن استعطافي % % 24(@)(@@) % إن لم أبت ضيفا لبابك قادما % فاجعل كتابي واحد الأضياف % % 25(@)(@@) % وأجزت باب قرى عوائد نحوه % % أن لا يجوز لديه حذف مضاف % % 26(@)(@@) % من أين للآمال مثلك كافل % أم أين للأحوال غيرك كاف % % 27(@)(@@) % أنت الغياث اذا الغمائم أخلفت % % وعد الثرى بالدر في الاخلاف % % 28(@)(@@) % والمسماحة في الندى آلافه % % والواحد المربي على الآلاف % % 29(@)(@@) % غيث الشآم ونيل مصر اذا شئت % % يوما وضاقت رحلة الإيلاف % % 30(@)(@@) % مدت إلى قاضي القضاة يد الرجا % % فأمدها بعوائد الإتحاف % % PageV01P1256 31(@)(@@) % هو كعبة الفضل التي قد أغربت % % أهل المقاصد حولها بطواف % % 32(@)(@@) % أقلامه مثل السهام سديدة % لكنها للوفد كالأهداف % % 33(@)(@@) % حفيت بوفد الآملين فكلها % % يسعى إلى لفيا المؤمل حاف % % 34(@)(@@) % في كف فياض النوال كأنها % % لمع البروق بعارض وكاف % % 35(@)(@@) % لا عيب فيه سوى عطاء مخجل % جهد المدائح زائد الإسراف % % 36(@)(@@) % وثنا يشف ضياؤه فكأنما % % في أعين الاعداء منه أشافي % % 37(@)(@@) % أوصاف مجد أينعت فترنمت % % بالسجع فيها ألسن الوصاف % % 38(@)(@@) % ومناقب قد يممت أمد العلا % % فقفت سوابقها الحسان قواف % % 39(@)(@@) % وفخار بيت في السيادة وازن % ما بيت نظم فخاره بزحاف % % 40(@)(@@) % بيت أبو دلف بناه وبالغت % % انباه في شرف وفي إشراف % % PageV01P1257 41(@)(@@) % ما فاخرته العرب الا هاشما % فغدت لديه هشيمة الاناف % % 42(@)(@@) % أو سامت الفرس الاوائل عزه % % لتقطعت اكتاف ذي الاكتاف % % 43(@)(@@) % تبقى على مر الزمان 
ms276	 وغيره % % عاف الذرى متوعر الاكناف % % 44(@)(@@) % يا من مقام فخاره المحمود لم % % تحتج دلائله إلى كشاف % % 45(@)(@@) % وضحت بهمتك العلوم فكلها % % إجماع متفق بغير خلاف % % 46(@)(@@) % ووراك صلى السابقون وسلمت % % آداؤهم من مثبت أو ناف % % 47(@)(@@) % وبك ازدهى الشرع المنيف مقامه % % وأقر رائد روضه المستاف % % 48(@)(@@) % يحميه رمح من يراعك نافذ % ويقيك درع من سجلك ضاف % % 49(@)(@@) % واذا استشار الملك رأيك في دجى % % أمر ثنيت الصبح في الإسراف % % 50(@)(@@) % عجبا لمثلك كيف يهمل حالتي % % من بعد ذاك العطف والاسعاف % % PageV01P1258 51(@)(@@) % ولي المصيف وفي حشاي حرارة % للهم فوق حرارة المصطاف % % 52(@)(@@) % وكفى عداتي أنني مافي أن % % ورد الشتا إلا لساني داف % % 53(@)(@@) % ومن الحوادث أن عزمي والصبى % % أودى فليت الحادثات كفاني % % 54(@)(@@) % ولبعد بابك وقد نار في الحشا % % ترمي بكل شرارة كطراف % % 55(@)(@@) % بالرغم أن يجفو ترابك مبسمي % % لكنه غدر الزمان الجافي % % 56(@)(@@) % ولئن قعدت فان ركب مدائحي % % متواصل الاعناق والايجاف % % 57(@)(@@) % خذها اليك كلامة مسرودة % يوم الفخار وحلة أفواف % % 58(@)(@@) % نظمتها لك والنجوم كأنها % % في الافق من تعب المسير غواف % % 59(@)(@@) % والنسر ينهض بينها بقوادم % لكنهن عن العيان خواف % % 60(@)(@@) % فأتتك من صنف الجمال بديعة % % والنظم مثل بنيه ذو إنصاف % % PageV01P1259 61(@)(@@) % في الناس من يمشي على رجلين في % % نظم ومن يمشي على أخلاف % % PageV01P1260 البحر : - 1(@)(@@) % مسلسل من حديث الدمع مذروف % % ينبيك ان حديث الصبر مصروف % % 2(@)(@@) % وان كل مقال العذل مخرفة % وكل ما نقل الواشون تحريف % % 3(@)(@@) % ليت الوشاة على خيط فكلهم % % يداه مشلولة واللحظ مكفوف % % 4(@)(@@) % آها لقدك غصنا كله ثمر % لو أنه ببنان اللثم مقطوف % % 5(@)(@@) % وتبر خدك دينارا له لمع % لو أنه لعيان الطرف مصروف % % 6(@)(@@) % أفدي التي تشتكي مني هوى ولها % % بالردف والخصر تثقيل وتخفيف % % 7(@)(@@) % تدعو على الكثب والأغصان لاعبة % % فالكثب مهتوفة والغصن مقصوف % % 8(@)(@@) % لي في القصائد تشبيب بها ولها % % على جريح الحشا باللحظ تذفيف % % 9(@)(@@) % قالوا حكى القمر التمي طلعتها % % قلنا صدقتم ولكن فيه تكليف % % 10(@)(@@) % كما حكى نيل مصر جود سائدها % % لو 
ms277	 لم يكن في وفاء النيل تسويف % % PageV01P1261 11(@)(@@) % ندب عطفت أماديحي على نسق % من فضله حبذا للفضل معطوف % % 12(@)(@@) % مدبر الملك بالأقلام يقدمها % % في الجود والبأس تحويل وتخويف % % 13(@)(@@) % بادي السعادة لو بثت مناقبه % % في الافق لم يبد في الاقمار مخسوف % % 14(@)(@@) % طلق الاسرة يعطي حيث وجه ذكا % % كأنه بغبار المحل مكسوف % % 15(@)(@@) % يا من يعنفه في صنع مكرمة % هيهات أن يروع العشاق تعنيف % % 16(@)(@@) % في كفه قلم الانشاد منشأه % % فضل وفصل وتعريف ومعروف % % 17(@)(@@) % فتوح ملك من الاسجاع خص به % % هذا وذاك وسجع الناس توقيف % % 18(@)(@@) % وفضل نظم له من بيته شرف % فهو الرضي وباقي النظم مشروف % % 19(@)(@@) % خطافة لب رائيه براعته % % ووجه حاسدها بالروع مخطوف % % 20(@)(@@) % وصاحب السر قد سر الزمان به % % صدر الندي وللآلاء توطيف % % PageV01P1262 21(@)(@@) % كم قاصد جاء في جهر وآخر في % % سر وللكل إنعام وتشريف % % 22(@)(@@) % وكم تلطف كتب في رسائله % % وطيها لمزاج الخطب تلطيف % % 23(@)(@@) % تسيل في الطرس أرواح العداة به % % حتى كأن يراع الطرس مرعوف % % 24(@)(@@) % فالبر والبحر ذا بالأمن منبسط % وذاك من خجل بالجود مرجوف % % 25(@)(@@) % وكل عاف بحرف الخط متصل % وكل عاد بحرف السيف محذوف % % 26(@)(@@) % شكرا لعطف واعراض لديك هما % % لعبد أبوابكم بر وتثقيف % % 27(@)(@@) % أعرضت عنه فوالت حربه فئة % شاكوا السلاح فتضريب وتسييف % % 28(@)(@@) % وما شكوت وماالشكوى إلى بشر % من خلق مثلي والاقدار تصريف % % 29(@)(@@) % حتى اذا غبطت المكرمات عفت % % تلك الهناة وكروا بعد ما عيفوا % % 30(@)(@@) % ان ساء قوما مقامي منشدا مدحا % لساءهم لي تشريف وتسريف % % PageV01P1263 31(@)(@@) % كم خلعة قلت للاحي وقد حضرت % % وعض لحيته للغيظ ذي صوف % % 32(@)(@@) % وحبذا وبر قد غصت فيه غنى % وكان لي وبر بالفقر منتوف % % 33(@)(@@) % وغلة طاف أولادي فقلت لهم % % أسعوا لها يا عفاة البيت أو طوفوا % % 34(@)(@@) % سمراء حنطية يغتر مبسمها % % فكلها بشفاه اللثم مرشوف % % 35(@)(@@) % دقت يد الرزق بابي وهي ناشزة % فقلت كس اخت رزق فيه تعسيف % % 36(@)(@@) % وعلمتني نظم الشعر من درر % ما بيت واحدها بالفقر مزحوف % % 37(@)(@@) % هذا هو 
ms278	 الخبز يا أجناد أدعية % % وفي المجاريب حرب الليل مصفوف % % 38(@)(@@) % خبز وخير وجبر بعد ما نطقت % % فللمحامد تجنيس وتصحيف % % 39(@)(@@) % لينطق الجود بعد العي ذا مدح % تأتي وما عندها في القول تكليف % % 40(@)(@@) % لا زلت ممتدحا مني بنظم فتى % في المادحين فلا يثنيه معروف % % PageV01P1264 41(@)(@@) % تجل عن نظم وراق مدائحه % % وعن ثنا فيه للجزاز تقطيف % % 42(@)(@@) % نظفت فكري لكم من حب ذي قلم % % فان شرط وعآء الحب تنظيف % % PageV01P1265 البحر : - 1(@)(@@) % بقيت لحمد مثل فضلك واف % % وكافاك عنا الله خير مكاف % % 2(@)(@@) % ولا زلت مسرورا بنشر محامد % وذخر أجور واتصال عواف % % 3(@)(@@) % ومجد على الأنصار شف سناؤه % % وعلم لأدواء البصائر شاف % % 4(@)(@@) % وبر اذا خان الزمان موكل % برآء وفآء للأنام وقاف % % 5(@)(@@) % ومنح وصفح ذاك معف لمخطيء % وذاك صريح المكرمات لعاف % % 6(@)(@@) % ولفظ هو العذب الطهور وطالما % % أدار على الأفهام صرف سلاف % 7(@)(@@) % لك الله بحرا إن خبا البحر دره % % فأحسن منه در بحرك طافي % % 8(@)(@@) % وندبا أطارت طائر المدح واجبا % قوادم من نعمائه وخواف % % 9(@)(@@) % فما رأيه عن قاصديه بغافل % وما طرفه عن وافديه بغاف % % 10(@)(@@) % وتدبير ملك مع تورع زاهد % إلى وثب عزم مع سكون عفاف % % PageV01P1266 11(@)(@@) % أخا العلم في عقل ونقل حوى المدى % % وفاق على الماضي بغير خلاف % % 12(@)(@@) % وذا المجد في دنيا وأخرى فياله % % مضافا اليه واصلا بمضاف % % 13(@)(@@) % أتى جودك المروي صداي ولم أسل % % ولا طرق السمع الكريم نشاف % % 14(@)(@@) % ودق علي الباب رزق ولم أسر % % أدق بكعبي متعبا بطوافي % % 15(@)(@@) % و قابلتها غر الوجوه كثيرة % % جرت بحروف قد صرعن حرافي ش % % 16(@)(@@) % ثقالا بمنديلي ألذ بثقلها % % و أخطر من بعد الحفا بخفاف % % 17(@)(@@) % و أسحب والأولاد فضل ملابس % نصافي بها الأيام حين نصافي % % 18(@)(@@) % و نشكر والأعضاء ألسنه ندى % % يديك وندعو والزمان مواف % % 19(@)(@@) % دعا صالح منا ومدح مؤيد % % و حقك لا في ذا بعثت ولا في % % 20(@)(@@) % رعى الله أيام الإمام محمد % % فكم نعم ردت إلى شراف % % PageV01P1267 21(@)(@@) % و لو سمته رد الشباب لرده 
ms279	 % % علي وقد مرت علي سوافي % % 22(@)(@@) % ألم تر أني قد حرمت بمدحه % % إلى غزل للشائبين مناف % % 23(@)(@@) % فآها لعلات الروادف برحت % % بأكباد قوم مستنين عجاف % % 24(@)(@@) % و آها على عصر الشباب الذي مضى % % وأودى فليت الحادثات كفافي % % 25(@)(@@) % فراشي كما قيل الحسان نواعما % لديه ومسحوب الشعور لحافي % % 26(@)(@@) % زمان لقا أستغفر الله ليته % % تقضى ولم أنعم زمان تجافي % % 27(@)(@@) % فيا آمري اليوم بالغي أمسكا % % فقد مر من تلك الغواية كاف % % 28(@)(@@) % و يا سابق النعمى لراجيه لا تزل % % تلافي حياة المرء عند تلافي % % 29(@)(@@) % فبطني شبعان وظهري كأنه % % لساني ما بين البرية داف % % PageV01P1268 البحر : - 1(@)(@@) % كل الجوانح قلب فيك مشغوف % % وما لحاصل حبي عنك مصروف % % 2(@)(@@) % ذكري بخاطرك الناسي مصادفة % % وخاطري عن سوى ذكراك مصدوف % % 3(@)(@@) % يا ظبية من ظباء الحي نافرة % % حتام هجرك شيء منك مألوف % % 4(@)(@@) % ويل لجفني لا جفنيك من سهر % % لكيله في الدجى خسر وتطفيف % % 5(@)(@@) % ياباذل الوفر في الدنيا لآخرة % % بشراك فرض على الأخرى وتسليف % % 6(@)(@@) % عذرا لنظمي والدنيا مطابقة % % شكواي مستورة والحال مكشوف % % 7(@)(@@) % وضعف فكري عن نظم القريض له % % كالعد في رقعة الشطرنج تضعيف % % 8(@)(@@) % لا زلت أنشد قولي فيك من قدم % % وأنت بالخلعة الزهراء محفوف % % 9(@)(@@) % أهل يهنيك بالتشريف محتفلا % % يا من بأيامه المعروف معروف % % 10(@)(@@) % لكنني بك أختار الهناء لها % % فإن قدرك للتشريف تشريف % % PageV01P1269 البحر : - 1(@)(@@) % كم لي على حب طرفه % % بنثرة الدمع صرفه % % 2(@)(@@) % وكم لها من شجون % % أمام قلبي وخلفه % % 3(@)(@@) % وكم بجود علي % أغنى رجا الوفد كفه % % 4(@)(@@) % وفاض لي منه بحر % في جنبه البحر غرفه % % 5(@)(@@) % وشل كف افتقار % % عن راحتي وكفه % % 6(@)(@@) % للمال سرا وجهرا % % لصاحب السر عطفه % % 7(@)(@@) % ياقادما لي ومثلي % % بفضل رؤياه طرفه % % 8(@)(@@) % ليهنك العام تلقى % % ألف السعادة ألفه % % 9(@)(@@) % أكرم بقصدك حجا % وحول بابك وقفه % % PageV01P1270 البحر : - 1(@)(@@) % يا من له في طريق زهد % % حال وفي المشكلات كشف % % 2(@)(@@) % قل لي ما مبهم جلي % % وفيه للواصفين خلف % % 3(@)(@@) % يعد حرفان حين يملى % % بغير 
ms280	 شد وقيل حرف % % 4(@)(@@) % وهو كما قد ترى خفيف % % وفيه لطف وفيه ظرف % % 5(@)(@@) % مع أنه من عجيب أمر % يجر طودا وفيه لطف % % 6(@)(@@) % وان عسكت الحروف منه % % فبلدة ما تكاد تصفو % % 7(@)(@@) % ألغازه في ضحى وممسى % % فليس يخفى وليس يخفو % % 8(@)(@@) % ذكرته في عديد وصف % % فلا يفت مسمعيك وصف % % 9(@)(@@) % وان خفى زائدا فأعرض % % عنه ودع منطقي يكف % % 10(@)(@@) % فان لفظي الفداة مثلي % % أصبح والله فيه ضعف % % PageV01P1271 البحر : - 1(@)(@@) % زادت شجوني فيه عن حد السرف % % وجرى عليه مدمعي حتى وقف % % 2(@)(@@) % متمنع تلقاه في حال الرضا % % وكأنه غصبان من فرط الصلف % % 3(@)(@@) % ألف الصدود تجنبا وتحجبا % فلو أنه رام التواصل ما عرف % % 4(@)(@@) % ومن الشقا أن الجفا وتشوقي % % لا ينتهي هذا وذاك إلى طرف % % 5(@)(@@) % ما مال غصن قوامه عن فكرتي % % يوما ولا دينار وجنته انصرف % % PageV01P1272 البحر : - 1(@)(@@) % سكنت بالنيل لو لم تكن % % جيرانه لم تك بالشافي % % 2(@)(@@) % كفاك جيران نيل الأذى % % فحبذا النيل بالكاف % % PageV01P1273 البحر : - 1(@)(@@) % أحاجيك ما حلو اللسان وأنه % % لأخرس لا تعزى اليه المعارف % % 2(@)(@@) % يرى جالسا في الصدر مادام كاملا % فإن نقصوه فهو في الأرض طائف % % PageV01P1274 البحر : - 1(@)(@@) % مننت بحل اللغز معنى وصورة % فلله موصوف لديك وواصف % % 2(@)(@@) % ووطنني ان بل بالقطر جسمه % % فها هو مبلول وها أنا ناشف % % PageV01P1275 البحر : - 1(@)(@@) % يحير الغصن بين اللين والهيف % % ويفضح الظبي بعد الجيد والعطف % % 2(@)(@@) % أغن لم يبق مرأى حسنه بشرا % خال من الوجد يلحاني على شغفي % % 3(@)(@@) % يا حبذا البدر حاز التم أجمعه % % وزاد في مهج العشاق بالكلف % % 4(@)(@@) % غزال رمل ولكن غير ملتفت % و غصن بان ولكن غير منعطف % % 5(@)(@@) % يشكو السقام إلى أجفانه جسدي % % فاعجب له دنفا يشكوا إلى دنف % % 6(@)(@@) % متى يحقق وعدا من تواصله % % و المنع ينظر من وجه إلي خفي % % 7(@)(@@) % في الخد لام وفي عطف الصبا الف % % و آلة المنع بين اللام والألف % % 8(@)(@@) % هلا سوى سحر ألفاظ تلفت به % % فكان في قصد موسى مانع تلفى % % 9(@)(@@) % مشير ملك تجلى رأيه 