ms141	(@)(@@) % أعل صدور السمرو هو حبيبها % % وحل شفار البيضو هو ضجيعها % % 29(@)(@@) % و قد علمت أمواله حين سامها % % حفاظ المعالي أنه سيضيعها % % 30(@)(@@) % و معركة يسود للنقع أفقها % % و تحمر من فيض الدماء ربوعها % % PageV01P535 31(@)(@@) % إذا ازدحمت فيها السيوف حسبتها % % ينابيع ماء ضاق عنها وسيعها % % 32(@)(@@) % قسمت حميا الموت بين حماتها % % فراح سواء جلدها وجزوعها % % 33(@)(@@) % و كم خطة حاولتهافاستطعتها % % بسيفكو الأيام لا تستطيعها % % 34(@)(@@) % إليك أطرنا من ديار ربيعة % نعائم في أرض العراق وقوعها % % 35(@)(@@) % ركايب تحدوها الشمالكأنها % % قلاع إذا أوفت عليها قلوعها % % 36(@)(@@) % تمادى بها السير الحثيثفلم تجل % لبعد المدى أغراضها ونسوعها % % 37(@)(@@) % يزيد سواد الليل صبغ سوادها % % و لا يتجلى في الصباح هزيعها % % 38(@)(@@) % فيذهب منها في سريع ذهابها % % و يرجع منها في بطيء رجوعها % % 39(@)(@@) % تمد على الأمواج باعا كأنه % % يعانقها في مده ويبوعها % % 40(@)(@@) % أشيع عطاياكالتي لو سترتها % % لقام الغنى عني خطيبا يشيعها % % PageV01P536 41(@)(@@) % و أصدع بالحسنى التي طار ذكرها % % و أكباد قوم تستطير صدوعها % % 42(@)(@@) % لقد أولعت منك المكارم بامرىء % حبيب إليه إلفها وولوعها % % 43(@)(@@) % فموردها عذب المياه نميرها % % و مربعها سهل الرياض مريعها % % 44(@)(@@) % قواف إذا كانت دروع معاشر % فأنتم حلى أجيادها ودروعها % % 45(@)(@@) % تراءت منيعات فلما دعوتها % % لمجدكم أعطى القياد منيعها % % 46(@)(@@) % و ما زال ريحان المديح وصبحه % % يضيء قلوبا منكم ويضوعها % % PageV01P537 البحر : - 1(@)(@@) % أمن رقبة عاف السلام مودعا % % و رد جموح الدمع حين تسرعا % % 2(@)(@@) % و صد عن البيض الحسانو قد بدت % % فأبدت لعينيه المحاسن أجمعا % % 3(@)(@@) % برزنفمن بدر تقنع بالدجى % % يغازل ليثا بالحديد مقنعا % % 4(@)(@@) % و من غصن رطب تأزر بالنقا % % إذا هز عطفيه القناع تزعزعا % % 5(@)(@@) % مزجن له عذب الهوى بمرارة % يجرع من مكروهها ما تجرعا % % 6(@)(@@) % إذا ما الهوى يوما تصدع شمله % % فأخلق بشمل الصبر أن يتصدعا % % 7(@)(@@) % عدتني من زور إذا زار عاشقا % أعاد المنى مرأىو قد كان مسمعا % % 8(@)(@@) % يداري عذوبة الحليو قد علا % % ترنمهو المسك حين تضوعا % % 9(@)(@@) % و يبذل لي في النوم ما لو طلبته 
ms142	 % % على يقظة مني ومنه تمنعا % % 10(@)(@@) % هل الدهر ملق من مخالب % % شجاعا على ألا مشيعا % % PageV01P538 11(@)(@@) % صبورا على الأحداث يعشق عدمه % % و إقلالهكيلا يذل ويخضعا % % 12(@)(@@) % و مرتدع رامي البريء بتهمة % فقد سار فيها في الأنام وأوضعا % % 13(@)(@@) % أ رب القوافي الغر يرقى بمثلها % % لقد فر أفعى ينفث السم منقعا % % 14(@)(@@) % و كيفو قد شعشعت كل غريبة % من القول تزري بالرحيق مشعشعا % % 15(@)(@@) % و أجريت من عذب الكلام مواردا % تروح وتغدو للبرية مشرعا % % 16(@)(@@) % و برزت سبقا في غرائبه إلى % % يقصر عنها سابق القوم إن سعى % % 17(@)(@@) % فهل سامع مني الأمير براءة % أقوم بها بين السماطين مسمعا % % 18(@)(@@) % ثناءإذا عاينت عقد نظامه % % توهمته للجوهر التبر مجمعا % % 19(@)(@@) % فتى ساور العلياء قبل فطامه % % و راع العدا من قبل أن يترعرعا % % 20(@)(@@) % جواد إذا أدى الفريضة جوده % % تنفل من حب الندى فتطوعا % % PageV01P539 21(@)(@@) % نقابل منه الشمس في قرب ضوئها % % و إن بعدت في صفحة الجو مطلعا % % 22(@)(@@) % و نسأل منه بارعا في سماحة % فإن نحن أغفلنا السؤال تبرعا % % 23(@)(@@) % إذا أبدع المداح أبدع عرفه % % فكان بما يسدي من العرف أبدعا % % 24(@)(@@) % و إن لج في إضراره الدهر أصبحت % خلائقه فيها أضر وأنفعا % % 25(@)(@@) % مكارم وضاح إذا ما تذرعت % ملوك الورى في المكرمات تذرعا % % 26(@)(@@) % له راحة ما قيس بالغيث صوبها % % لدى المحلإلا كان أندى وأوسعا % % 27(@)(@@) % ترى طمع العافين يحتاج وفره % % و ليست ترى أعداؤه فيه مطمعا % % 28(@)(@@) % صنائع مشهور الصنائع يبتدي % % طباعا إذا المسؤول يوما تصنعا % % 29(@)(@@) % إذا ما مضى صدر النهار بسيله % % تولى و أبقى آخر الليلمربعا % % 30(@)(@@) % شمائل أبهى من حلى الروض منظرا % و أحسن من فعل السحائب مرتعا % % PageV01P540 31(@)(@@) % أبا تغلب لازلت للقرن غالبا % إذا ارتد للروع الكمي مروعا % % 32(@)(@@) % تنازله بالسيف غير مخادع % فتورده منه وريدا وأخدعا % % 33(@)(@@) % أعد دارسا من رسم برك واضحا % فقد وضح العذر انكشافا وأقنعا % % 34(@)(@@) % فلي فيك من حسن الثناء ذريعة % تمكن عندي للصنيعة موضعا % % 35(@)(@@) % و ثانية إن ابن عمك شافعي 
ms143	 % % و لو ناشد الغيث استهلفأسرعا % % PageV01P541 البحر : - 1(@)(@@) % أبا جعفر لم تنسى الصنيعا % % و قد كنت تحسن في الصنيعا % % 2(@)(@@) % أراك تناسيت عهدي القديم % فضاعو ما حقه أن يضيعا % % 3(@)(@@) % فلا نازح الود يدني الدنو % و لا غائب الشر ينوي الرجوعا % % 4(@)(@@) % فلولا الحياء أراك العتاب % بديعا من النظم يتلو بديعا % % 5(@)(@@) % ملوم و يخضع بعد الملام % فيلذع لوما و يأسو خضوعا % % PageV01P542 البحر : - 1(@)(@@) % و لقد مررت على المحدث مرة % و إذا بحضرته ظباء رتع % 2(@)(@@) % و إذا ظباء الأنس تكتب كل ما % % يمليو تثبت ما يقول وتسمع % 3(@)(@@) % يتجاذبون الحبر من ملمومة % بيضاءتحملها علائق أربع % 4(@)(@@) % من خالص البلور غبر لونه % % فكأنه سبج يلوح ويلمع % 5(@)(@@) % إن نكسوها لم تسلفمليكها % % فيما حوته عاجلا لا يطمع % 6(@)(@@) % و متى أمالوها لرشف رضابها % % أداه فوهاو هي لا تتمنع % 7(@)(@@) % فكأنه قلبي يضن بسره % أبدا و يكتم كل ما يستودع % 8(@)(@@) % رجلاه رأس عندهالكنه % % يلفى وبرء حفاه ساعة يقطع % 9(@)(@@) % و كأنهو الحبر يخضب رأسه % % شيخ لوصل خريدة يتصنع % 10(@)(@@) % لم لا ألاحظه بعين جلالة % و به إلى الله الصحائف ترفع % PageV01P543 البحر : - 1(@)(@@) % و أدهم يسفر عن ضده % كما سفر الليلإذ ودعا % % 2(@)(@@) % بعثت إليك به أخرسا % يناجي العيون بما استودعا % % 3(@)(@@) % صموت إذا زر جلبابه % أريتفإن حله أمتعا % % 4(@)(@@) % محبر أنواره جامع % يروح ويغدو لها مجمعا % % 5(@)(@@) % و روضته غيث أقلامه % و قد كان من قبله بلقعا % % 6(@)(@@) % تلاقي النفوس سرورا به % % و تلقى الهموم به مصرعا % % 7(@)(@@) % فلا تعدلن به نزهة % فقد حاز ما يبتغي أجمعا % % PageV01P544 البحر : - 1(@)(@@) % عذلتو هل عذل المتيم نافعه % % و أسمعت لو أصغى إلى اللوم سامعه % % 2(@)(@@) % تعرقه الصبر الجميلو في الحشا % % رسيس هوى تنهل عنه مدامعه % % 3(@)(@@) % و هل لمحب طاوع الشوق دمعه % % على بعد من يهواهصبر يطاوعه % % 4(@)(@@) % وقفنا نذود الدمعو الدمع سابح % و عجنا نحيي الربعو الشوق رابعه % % 5(@)(@@) % فألبسني جزعاه حلة جازع % و جرعني ماء الغرام أجارعه % % 6(@)(@@) % أعاتب طرفي أن يفيض دموعه 
ms144	 % % و إن جر قلبي أن تذاع ودائعه % % 7(@)(@@) % و لست أضيع الحزم في فيض عبرة % لفقد شباب ليس يوجد ضائعه % % 8(@)(@@) % و كم في عدي من كهول وفتية % كرام لهم كهل السماح ويافعه % % 9(@)(@@) % جزيناهم حمدا لحسن صنيعهم % % و كل امرىء يجزى بما هو صانعه % % 10(@)(@@) % إذا المجد أمسى في الملوك مفرقا % ففي تغلب يمسي ويصبح جامعه % % PageV01P545 11(@)(@@) % و إن كان عبد الله شاد لها العلا % % فإن عليا في الذي شادتابعه % % 12(@)(@@) % فتى شرع المجد المؤثلفالعلا % % مآربهو المكرمات شرائعه % % 13(@)(@@) % فلا جود إلا ما تفيد يمينه ؛ % و لا مجد إلا ما تشيد وقائعه % % 14(@)(@@) % إذا وعد السراء أنجز وعده % % و إن أوعد الضراءفالعفو مانعه % % 15(@)(@@) % يحن إلى ورد المنية حاسر % % إذا حان عن ورد المنية دارعه % % 16(@)(@@) % هو الدهر يجري في البرية بأسه % % ببؤسى و تجري بالسعود صنائعه % % 17(@)(@@) % رمى الله أرض الروم منه بقاسم % يروع العدا قبل الكريهة رائعه % % 18(@)(@@) % يعود إلى الرمح الرديني ماؤه % % و يورق إن ضمت عليه أصابعه % % 19(@)(@@) % و لما تراءى للعدو مصمما % تراءت له تحت العجاج مصارعه % % 20(@)(@@) % فآب سليب الغمض تحسب أنه % % من الرعب صب قد أقضت مضاجعه % % PageV01P546 21(@)(@@) % و إن عفت الأقدار عنهفقد عفت % مصايفه منهو أقوت مرابعه % % 22(@)(@@) % ليهن الأمير التغلبي قدومه % % و فتح توالت بالسعود طوالعه % % 23(@)(@@) % نشرت له في كل شرق ومغرب % ثناء تروي السامعين بدائعه % % 24(@)(@@) % فأي لبيب ليس يبسم قلبه % % سرورا إذا أصغت إليه مسامعه % % 25(@)(@@) % ملكت زمام الدهر في كل حالة % فليس يضر الدهر من أنت نافعه % % 26(@)(@@) % و أومض لي من جود كفك لامع % و ما الغيث إلا حيث يومض لامعه % % 27(@)(@@) % فأغنيتني بالجود عن كل ممسك % أكافحه عن جوده وأقارعه % % PageV01P547 البحر : - 1(@)(@@) % و مبنية من خيزران مفضض % يقدمها خشف من الإنس أروع % 2(@)(@@) % لها قبة كالحيتين صبيلة % و وجه بتجذيف الشوانين يلمع % 3(@)(@@) % عجاجتها دكناء في كل مجلس % و ياقوتها الجمر الذي يتضوع % 4(@)(@@) % إذا استودعت سرا أذاعت بسرها % % تشتت أنفاسا بها العيش يجمع 
ms145	 % PageV01P548 البحر : - 1(@)(@@) % و لما اصطبحناو الخمار يصدنا % % عن الكأس عجناو الغلائل تنزع % 2(@)(@@) % إلى وسع حمام كأن سماءه % عقيق بجامات اللجين مرصع % 3(@)(@@) % و في الصدر قينات وشرب مدامة % يلذ بها مرأى وما ثم مسمع % 4(@)(@@) % على سبج من أرضهو جيوشه % % قيام على أرجائهاو هي خشع % 5(@)(@@) % قضينا به عند الصباح لبانة % و عجنا إليها والعواتق هجع % PageV01P549 البحر : - 1(@)(@@) % له قلم تجري النجوم بجريه % % يطيع له حتم القضاء ويسمع % 2(@)(@@) % يدير سعودا أو نحوسا و إنه % % من الفلك الدوار في الجو أسرع % 3(@)(@@) % إذا ما امتطى منه ثلاث أنامل % بدا ساجدا من تحتهاو هي ركع % PageV01P550 البحر : - 1(@)(@@) % أيها السيد الذي راحتاه % مزنة ما لصوبها إقلاع % 2(@)(@@) % عجب الناس كيف ضعتو مثلي % % بفناء الأمير ليس يضاع % 3(@)(@@) % قلتإذ أعوز الشفيع وأعيا الأ % % ذن فيما أروم والاستماع % 4(@)(@@) % هذه جنة الخلودو ما لي % % من حميم و لا شفيع يطاع % PageV01P551 البحر : - 1(@)(@@) % بنفسي من رد التحية ضاحكا % فجدد فيه بعد يأسي مطمعي % % 2(@)(@@) % إذا ما بدا أبدى الغرام سرائري % % و أظهر للعذال ما بين أضلعي % % 3(@)(@@) % و حالت دموع العين بيني وبينه % % كأن دموع العين تعشقه معي % % PageV01P552 البحر : - 1(@)(@@) % أهلا به من عارض ترك الدجى % % ببياض مزنته غرابا أبقعاحذف % % 2(@)(@@) % نثرت يد الأرياح لؤلؤ ثلجه % % فبدا بأجياد الغصون مرصعاحذف % % 3(@)(@@) % و كأنما عبثت لوامع برقه % % بسحابهفرمت به فتقطعاحذف % % PageV01P553 البحر : - 1(@)(@@) % أقارع أعداء النبي و آله % قراعا يفل البيض عند قراعهحذف % % 2(@)(@@) % و أعلم كل العلم أن وليهم % سيجزى غداة البعث صاعا بصاعهحذف % % 3(@)(@@) % فلازال من والاهم في علوه % ولازال من عاداهم في اتضاعهحذف % % 4(@)(@@) % و معتزلي رام عزل ولايتي % % عن الشرف العالي بهم وارتفاعهحذف % % 5(@)(@@) % فما طاوعتني النفس في أن أطيعه % ولا آذن القرآن لي في اتباعهحذف % % 6(@)(@@) % طبعت على حب الوصي و لم يكن % لينقل مطبوع الهوى عن طباعهحذف % % PageV01P554 البحر : - 1(@)(@@) % و محجوبة بالماء عن كل ناظر % و لكنها من حجبها تتخطف % 2(@)(@@) % أخذنا عليهن السبيل بأعين % رواصدإلا أنها ليس تطرف % 3 
ms146	(@)(@@) % فجاءت به شتى النجارو لم تزل % تجمع من أشتاتها وتؤلف % 4(@)(@@) % تصافحها بيض المتون كأنها % % خناجر في أيماننا تتعطف % PageV01P555 البحر : - 1(@)(@@) % عندي ضيف لم يزل مضيفا % % مقدما في مجده شريفا % % 2(@)(@@) % زار ليحيا نعمة وريفا % % و الصبح قد قابلنا منيفا % % 3(@)(@@) % و رفعت ظلماؤه السجوفا % % و الكأس قد سارت بنا الوجيفا % % 4(@)(@@) % حتى توارت شمسها كسوفا % % فأهد لي خلوقها المدوفا % % 5(@)(@@) % مدرعا بلوره المشوفا % % مثل العروس ادرعت شفوفا % % 6(@)(@@) % تحوي من السكر به صنوفا % % و كبر الظرف تكن ظريفا % % 7(@)(@@) % و الطففمازلت بنا لطيفا % % في سابح تحسبه معلوفا % % 8(@)(@@) % كان لقعر لجة حليفا % % لاقى و قد فارقهالحتوفا % % 9(@)(@@) % خطفة صياد غدا مخطوفا % % و من يكن يعرفه معروفا % % 10(@)(@@) % صب إلى السكر به مشغوفا % % ترى الذي حاولته خفيفا % % PageV01P556 البحر : - 1(@)(@@) % تزداد منعا إذا ما رمت إسعافا % % و تعلن الظلمإن حاولت إنصافا % % 2(@)(@@) % غصن يحملني عبء الهوى فمتى % % ضعفت عنه حبتني منه أضعافا % % 3(@)(@@) % ماذا عليهاو قد خفت ركائبها % % لو كان يأمن منها الصب ما خافا % % 4(@)(@@) % بل ما على السربإذ فاجاكلو عطفت % ظباؤه لك أجيادا وأعطافا % % 5(@)(@@) % أقبلن يكسرن أجفانا مفترة % إلى الصبابةأو يمددن أطرافا % % 6(@)(@@) % تثنى مثقلة منها مخففة % كأنما قسمت قضبا وأخفافا % % 7(@)(@@) % و ربما عن ديباج الخدود لنا % % و قد كساه وشيك البين أفوافا % % 8(@)(@@) % و أومضت من خلال السجف بارقة % أطاعها مطر الأجفان تذرافا % % 9(@)(@@) % أيام يحسد عطفيه الحسامإذا % % ما هزهو ثنى عطفيه إرهافا % % 10(@)(@@) % حيا الكثيب ونادى الشوق من كثب % فلم يطق لغروب الدمع إيقافا % % PageV01P557 11(@)(@@) % و ما خفا البرق إلا عاد يذكره % % من الثنية أجزاعا وأخيافا % % 12(@)(@@) % ألية بالكرى المجفو تبعده % % عنا الركائب إرفالا وإيجافا % % 13(@)(@@) % لقد أبحت شريف القول ذا حسب % في الأزد موف على العلياء إشرافا % % 14(@)(@@) % إلى ابن فهد زففنا كل آنسة % عذراءتتحفه بالحمد إتحافا % % 15(@)(@@) % جاءته لا تتقاضى عنده عدة ؛ % أنى و قد أخذت جدواه أسلافا % % 16(@)(@@) % ألفن منه فناء ما حللن به % % إلا وجدن جنان العيش ألفافا % % 17(@)(@@) % أغر يكشف 
ms147	 عنا كل نائبة % كالصبح مازال للظلماء كشافا % % 18(@)(@@) % يجري إلى الجوديوم الجود مبتسما % إذا البخيل غدا للبخل وقافا % % 19(@)(@@) % سام إذا القوم راموا نيل سؤدده % علا سموا فحط القوم إسفافا % % 20(@)(@@) % إن خالفوا المجد لم يعدل مخالفة % أو أخلفوا الوعد لم يتبعه إخلافا % % PageV01P558 21(@)(@@) % دعا السماح سقيفا منه حين دعا % % من الملوك أخلاء وأحلافا % % 22(@)(@@) % نزور منه وساع الجود نوسعه % % حمدا و يوسعنا برا وألطافا % % 23(@)(@@) % يفل عنا سهام الخطب مقتدرا % حتى يعيد سهام الخطب أهدافا % % 24(@)(@@) % من ذا يفاخره إن عدمفتخرا % من سر يعرب أمجادا وأشرافا % % 25(@)(@@) % علا تطيب برياها مدائحنا % % كالمسك تأخذ منه الريح أعرافا % % 26(@)(@@) % و شيمة إن رأينا الجود مقتصدا % فيمن سواهأرتنا الجود إسرافا % % 27(@)(@@) % و عزمة لا تزالالدهرنجدته % % تهز منها على الأعداء أسيافا % % 28(@)(@@) % إن وفر السيف يوم الروعتالده % % أعاد توفيره بالبذل إتلافا % % 29(@)(@@) % بينا تراه عطوفا في مكارمه % % حتى تراه على الأقران عطافا % % 30(@)(@@) % يمشي بضوء الظبا في كل معترك % مدت عليه سجوف النقع أسدافا % % PageV01P559 31(@)(@@) % أبا الفوارسلازالت مدائحنا % % تعتدنا لك زوارا وأضيافا % % 32(@)(@@) % ما فوق الدهر لي سهما جزعت له % % إلا وجدتك لي درعا وتجفافا % % 33(@)(@@) % جاءتك معنى وألفاظا مدبجة % كأنها درر شققن أصدافا % % 34(@)(@@) % وافت تهنيك بالأجر الجزيل على % % شهر الصيامو بالعيد الذي وافى % % PageV01P560 البحر : - 1(@)(@@) % لنا روضة في الدار صيغ لزهرها % % قلائد من حلي الندى وشنوف % 2(@)(@@) % يطيف بنا منهاإذا ما تنفست % نسيم كعقل الخالدي ضعيف % 3(@)(@@) % و ندمان صدق نثره ونظامه % % ربيع إذا فاوضتهو خريف % 4(@)(@@) % و ماء حكى أشعار حمد ببرده % % و لكنه محيا و تلك حتوف % 5(@)(@@) % و قد رق ثوب الغيمحتى كأنما % % تنشر دون الأفق منه سجوف % 6(@)(@@) % فزر مجلسا قد فضل الله أهله % % و شرفهمإن الأديب شريف % 7(@)(@@) % و لا تعد أفعال الشريففإنه % % دمان رقيق الحلتين ظريف % PageV01P561 البحر : - 1(@)(@@) % هذي المعارف منهم فتعرفا % % وقفا لعل الركب أن يتوقفا % % 2(@)(@@) % إن تجفها ريم السحاب فما جفا % % أطلالها دمع يرقرقه الجفا % % 3(@)(@@) % و لئن شكت حيف الزمان لقد 
ms148	 مشى % % بالبين في حافاتها متحيفا % % 4(@)(@@) % عقلت ركاب سرورنا في ظلها % % و لكم سرى فيه السرورفأوجفا % % 5(@)(@@) % أيامإن وعد الحبيب متيما % وصلا وفى و إذا توعد أخلفا % % 6(@)(@@) % و مهفهف كالشمس سالم نوره % % ظلم الدجى أو كالقضيب تعطفا % % 7(@)(@@) % يهدي لعاشقه الحتوففإن بدا % % أنسته سالفتاه ما قد أسلفا % % 8(@)(@@) % و كأنما أبدى لنا بمدامه % % و جماله صاع العزيز ويوسفا % % 9(@)(@@) % فعلام تقرفني الوشاةو إنما % % نازعته صهباء كرم قرقفا % % 10(@)(@@) % و الليل قد ضعفت قوى ظلمائه % % فالنجم فيه يدير لحظا مدنفا % % PageV01P562 11(@)(@@) % حتى تكشف صبحهفحسبته % % لضيائهخلق الأمير تكشفا % % 12(@)(@@) % ملك خلائقه الزمانو صرفه % % فبفعله جار الزمان وأنصفا % % 13(@)(@@) % إن قطب البخلاء أسفر وجهه % % أو أسرفوا في المنع حارفأسرفا % % 14(@)(@@) % متبرع بنوالهجار على % % كرم الطباعإذا اللئيم تكلفا % % 15(@)(@@) % و مشتت شمل اللهى بأنامل % جمعت له شمل العلى فتألفا % % 16(@)(@@) % لولا نوال يد الغضنفر أصبحت % عرصات هذا المجد قاعا صفصفا % % 17(@)(@@) % لحظ الولي فعاد منه مؤملا % و رمى العدوفراح منه مخوفا % % 18(@)(@@) % شيم أرق من النسيمو ربما % % عصفت جنائبهافعادت حرجفا % % 19(@)(@@) % كم موقف لم يلق فيه كماته % % إلا على أجسام قوم موقفا % % 20(@)(@@) % ضنك إذا جلت السيوف قناته % % رفعت حوافره ظلاما مغدفا % % PageV01P563 21(@)(@@) % أقدمت فيه تهز أسمر ذابلا % لدنا لأرواح العدا متخطفا % % 22(@)(@@) % فإذا تأود صدره من طعنة % نجلاء عاد بغيرها فتثقفا % % 23(@)(@@) % فاسلم لكل فضيلة معروفة % لولاك طال على الورى أن تعرفا % % 24(@)(@@) % و البس غرائب مدحة دبجتها % % فكأنما دبجت منها مطرفا % % 25(@)(@@) % من كل بيت لو تجسم لفظه % % لرأيته وشيا عليك مفوفا % % 26(@)(@@) % و لئن توقف جود كفك معرضا % عنيفلم يك قبلها متوقفا % % 27(@)(@@) % خلفت في حظي لديكو إنني % % لأحب شكري أن يرى متخلفا % % PageV01P564 البحر : - 1(@)(@@) % هل للعليل سوى ابن قرة شافي % % بعد الإلهو هل له من كاف % % 2(@)(@@) % أحيا لنا علم الفلاسفة الذي % % أودى و أوضح رسم طب عاف % % 3(@)(@@) % فكأنه عيسى بن مريم ناطقا % يهب الحياة بأيسر الأوصاف % 4(@)(@@) % مثلت له قارورتيفرأى بها % % ما اكتن بين جوانحي وشغافي % % 5 
ms149	(@)(@@) % يبدو له الداء الخفي كما بدا % % للعين رضراض الغدير الصافي % % PageV01P565 البحر : - 1(@)(@@) % قضى بوقوف الركب حق المواقف % فروى صداها بالدموع الذوارف % 2(@)(@@) % رسوم كأن الطرف يقرأكلما % % تأملهاآي الهوى من صحائف % 3(@)(@@) % أباري بها دمع الحياو هو ذارف % و أخلفه في ربعها غير ذارف % 4(@)(@@) % و أعرفها لولا الذي فعل البلى % % و أنكرها لولا نسيم المعارف % 5(@)(@@) % سقاك الهوى صوب الدموع ملاطفا % و أي هوى يلقاك غير ملاطف % 6(@)(@@) % فلم تنسني الأيام فيكو قد دجت % % سوالف أيام مضت كالسوالف % 7(@)(@@) % و أخضر من وشي الحدائق معلم % تجر عليه السحب وشي المطارف % 8(@)(@@) % إذا انصات في قرن من الشمس ضاحك % تمايل في دمع من المزن واكف % 9(@)(@@) % و لابسة في كأسها ثوب آمن % جلاها علينا الماء في ثوب خائف % 10(@)(@@) % إذا رعفت منها الأباريق خيلت % لأعيننا سرب الظباء الرواعف % PageV01P566 11(@)(@@) % تمسكت بالإنجيل لما أباحها % % و خالفت فيها نص ما في المصاحف % 12(@)(@@) % أردد لحظ العين بين شمامس % مصورة في كأسها وأساقف % 13(@)(@@) % فمن بين عار لم ينل من ثيابها % % و ملتحف منها بحمر الملاحف % 14(@)(@@) % أ أطلب إسعاف الزمانو قد ثنى % % إلى العاجز المأفون عطف مساعف % 15(@)(@@) % و آمل أن يجلو لذي اللب بعدما % % ترشفه ذو الجهل حلو المراشف % 16(@)(@@) % إذا لم يكن للنقص يوما بمنكر % فما هو للفضل المبين بعارف % 17(@)(@@) % سأمنح حلي الشعر صائغ حليه % % و إن لم يصغه لارتياد العوارف % 18(@)(@@) % ثناءكأفواف الرياض يشوبه % % عتاب كأنفاس الرياح الضعائف % 19(@)(@@) % ترقرق ماء الطبع في وجناته % % ترقرق إفرند السيوف الرهائف % 20(@)(@@) % أبا حسن إن المكارم جمة % و أحسنها إنصاف خل مناصف % PageV01P567 21(@)(@@) % تناسيت ودي من قديم وحادث % و أغفلت شكري من تليد وطارف % 22(@)(@@) % و أهملتنيحتى تحيفني العدا % % و كم ذدت عني الحيف من كل حائف % 23(@)(@@) % عصائب رق الستر بيني وبينهم % % فمن ساتر ما في الضمير وكاشف % 24(@)(@@) % يدبون في ليل النفاق كأنهم % % عقارب دبت في دجى متكاثف % 25(@)(@@) % إذا نسمت ريح الصديق عليهم % أهبوا عليها كل نكباء عاصف % 26 
ms150	(@)(@@) % و ما نقموا إلا مقالة معلن % بأن أبا السبطين خير الخلائف % 27(@)(@@) % إذا شئت أن تهدي لغل صدورهم % فأغضبهم يبدو كمون الكثائف % 28(@)(@@) % ألست تراهمإن رأوا لك نعمة % يفيضون غيظا من صدور لواهف % 29(@)(@@) % ترى أوجها تصفر حقدا كأنما % % يداف على أبشارها ورس رائف % 30(@)(@@) % و خزر عيون لم تكن لحظاتها % % لتصدر إلا عن قلوب رواجف % PageV01P568 31(@)(@@) % ألم ترني أقصرت غير مقصر % و أعرضت عن أعراضهم غير خائف % 32(@)(@@) % و كيف يبيع الحر عرض ابن حرة % بأعراض أبناء الإماء المقارف % 33(@)(@@) % أغرك منهم ذو لسان ملاطف % و قلب لإفراط الغليلمسايف % 34(@)(@@) % فأعطيتهم مدحا كزاهرة الربا % % و ودا كإيماض البروق الخواطف % 35(@)(@@) % و كنت جديرا أن تحث إليهم % قواصف لفظ كالرعود القواصف % 36(@)(@@) % و تسلم عن أعراضهم بشوارد % مسومة توهي صفاة المقارف % 37(@)(@@) % فليس يكون المرء سلم صديقه % إذا لم يكن حرب العدو المخالف % PageV01P569 البحر : - 1(@)(@@) % فؤادي بك مشغوف % و دمعي فيك مذروف % 2(@)(@@) % و في وعدك إن جدت % به مطل وتسويف % 3(@)(@@) % أ أنسى موقف البين % و وجدي فيك موقوف % 4(@)(@@) % و قد شيعني طرف % بماء الشوق مطروف % 5(@)(@@) % و جادت حدق نجل % و مادت قضب هيف % 6(@)(@@) % و جالت حمرة الخد % كما جال التطاريف % 7(@)(@@) % فعقد الدمع محلول % و عقد الثغر مرصوف % 8(@)(@@) % و في الدمع لمن حم % ل ثقل البين تخفيف % 9(@)(@@) % و روض فيه تدبيج % من النور وتفويف % 10(@)(@@) % ألفنا طيب مثواه % % و طيب العيش مألوف % PageV01P570 11(@)(@@) % و صرف الدهر عنا ب % % أبي العباس مصروف % 12(@)(@@) % فتى بالجود مشغوف % و بالمعروف معروف % 13(@)(@@) % خلال لصلاح الده % % ر في أفيائها ريف % 14(@)(@@) % فيوم الجود بسام ؛ % و يوم الروع غطريف % 15(@)(@@) % له في الوفر تشتيت ؛ % و في العلياء تأليف % 16(@)(@@) % ندى لو كان من بحر % لأمنو هو منزوف % PageV01P571 البحر : - 1(@)(@@) % صب بغرات الصبا مكلف % منسحب مئزره والمطرف % 2(@)(@@) % يرغم من يلحى ومن يعنف % تشوقه حتى يكاد يتلف % 3(@)(@@) % خد أسيل و قوام أهيف % فصاحباه فتية وقرقف % 4(@)(@@) % و عدتاه 
ms151	 سابح ومرهف % هاج هواه الدير والمستشرف % 5(@)(@@) % و روضه المدبج المفوف % ترب صحيح و هواء مدنف % 6(@)(@@) % للعين فيهأي وجه تصرف % بساط منثور نداه ينطف % 7(@)(@@) % له من الآس الجني رفرف % و جدول لجته لا تنزف % 8(@)(@@) % تصقل متنيه الرياح العصف % حيتانه دانية تلقف % 9(@)(@@) % فماؤه مروق منطف % مثل السراب افتر عنه النفنف % 10(@)(@@) % فهي على ساحاته ترفرف % كل بسهم حتفه مستهدف % PageV01P572 11(@)(@@) % ألحفتهنو الحمام ألحف % شبهته بالدرع حين ترصف % 12(@)(@@) % بها عيون لحظهن أوطف % يطرفها الماءو ليست تطرف % 13(@)(@@) % ثم تلاها قصب مجوف % مثل القنا ثقفه المثقف % 14(@)(@@) % و كل عقفاء إليه توصف % مثل الهلالو هي منه أنحف % 15(@)(@@) % من صفتيها الرفق والتعجرف % فلم تزل ترسل ثم تخطف % 16(@)(@@) % و نحن من أشتاتها نؤلف % كأنها خناجر تعطف % 17(@)(@@) % أحل لي عذابهن المصحف % و ليس عن صرف الحمام مصرف % PageV01P573 البحر : - 1(@)(@@) % تلاف السهم أثبت في الشغاف % و هل ينجيك من تلف تلافي % % 2(@)(@@) % تذكرني العفافو ليس هذا % % أوان العفو عنكو لا العفاف % 3(@)(@@) % و قد برق الهجاء بقاصفات % تهم لها قناتك بانقصاف % 4(@)(@@) % فرشت لك البسيطة منه جمرا % يضر بذي الحذاءو أنت حافي % % 5(@)(@@) % و كيف تنال عارفتي وعفوي % % و لم تمح اعترافك باعتراف % 6(@)(@@) % أرى الجزار هيجني وولى % % و كاشفني وأسرع في انكشافي % % 7(@)(@@) % ورفع شعره بعيون شعري % % فشاب الشهد بالسم الزعاف % 8(@)(@@) % لقد شقيت بمديتك الأضاحي % % كما شقيت بغارتك القوافي % % 9(@)(@@) % توعر نهجها بكو هو سهل % وكدر وردها بكو هو صافي % % 10(@)(@@) % فتكت بها مثقفة النواحي % % على فكر أسد من الثقاف % PageV01P574 11(@)(@@) % لها أرج السوالف حين تجلى % % على الأسماعأو أرج السلاف % 12(@)(@@) % جمعن الحسنيينفمن رياح % معنبرة و أرواح خفاف % 13(@)(@@) % و ما عدمت مغيرا منك يرمي % % رقيق طباعها بطباع جافي % % 14(@)(@@) % كأن محاسن الأشعار شرع % تحببهفجاء على الخلاف % 15(@)(@@) % معان تستعار من الدياجي % % و ألفاظ تقد من الأثافي % % 16(@)(@@) % كأنك قاطف منها ثمارا % سبقت إليه إبان القطاف % 17(@)(@@) % و شر الشعر ما أداه فكر % تعثر بين كد واعتساف 
ms152	 % 18(@)(@@) % لقد شكت القصائد منك ضيما % فهل حام يقيها الضيم كافي % % 19(@)(@@) % جريتو طرفها السباق جار % و ضقت وباعها الممتد وافي % % 20(@)(@@) % و تزعم أنك المشهور فضلا % فلم تخفى و برق الحين خافي % % PageV01P575 21(@)(@@) % تفاوتناو هل تخفى القدامى % % على لحظ العيون من الخوافي % % 22(@)(@@) % و فضل الهام من بغض الذنابى % % و عز التاج من ذل الخصاف % 23(@)(@@) % رميت من الهجاء بذي غمار % إذا ما فاض غرق ذا النطاف % 24(@)(@@) % و ضاق بك الفضاء الرحب لما % % عطفت عليك فضفاض العطاف % 25(@)(@@) % و لست أسيء مبتدئا و لكن % أجازي بالإساءة أو أكافي % % 26(@)(@@) % سأشفي الشعر منك بنظم شعر % تبيت له على مثل الأثافي % % 27(@)(@@) % و أبعد بالمودة منك جهدي % % فقف لي بالمودة خلف قاف % PageV01P576 البحر : - 1(@)(@@) % أمعنفيإن زدت في التعنيف % فاردد سوابق دمعي المذروف % 2(@)(@@) % سلت على قلبي ظبا أسيافها % % يوم النوى مقل الظباء الهيف % 3(@)(@@) % و أعدن برق الشوق يومض في الحشا % % بوميض برق من خلال سجوف % 4(@)(@@) % و رجوت أن أحيا برد تحية % فحييت من أجفانها بحتوف % 5(@)(@@) % أقمار تم في سواد حنادس % و غصون بان في رقاق شفوف % 6(@)(@@) % لازال صوب المزن صبا آلفا % ينهل في ربع الصبا المألوف % 7(@)(@@) % وطن عهدت الدهر غير مخالف % في ظلهو الحي غير خلوف % 8(@)(@@) % ودعتهم شغفا بهمو جهلت ما % % يجني الوداع على الفتى المشغوف % 9(@)(@@) % فعرفت يوم البين منهجهكما % % عرف ابن نصر منهج المعروف % 10(@)(@@) % ملك رجوت نوالهفوجدته % % كثبا على الراجين غير قذيف % PageV01P577 11(@)(@@) % و لجأت من دهري إليهفكان لي % % ركنا على الحدثان غير ضعيف % 12(@)(@@) % و سريت في ليل الخطوب بوجهه % % فحمدت إشراق الهلال الموفي % % 13(@)(@@) % سبق الأمير إلى السماحفأتبعت % كفاه جودا سابقا برديف % 14(@)(@@) % و احتال في نظم الثناءو نثره % % في مشرقات قلائد وشنوف % 15(@)(@@) % شمس الندى يسموبعزم لو بدا % % للشمس يوما آذنت بكسوف % 16(@)(@@) % و ثقيل حلم منه أصبح كامنا % في حد مصقول الذباب خفيف % 17(@)(@@) % سادت بنو حمدان مجدا لم يزل % يثنى بحد أسنة وسيوف % 18(@)(@@) % وصلوا التليد 
ms153	 بطارف فغدا لهم % % حبلا فخار تالد وطريف % 19(@)(@@) % و حوى أبو العباس كل فضيلة % تركت شريف القوم غير شريف % 20(@)(@@) % حنق على الأموال غير مبخل % قاس على الأعداء غير رؤوف % PageV01P578 21(@)(@@) % مدت إلي يد الخطوب فكفها % % عني بكف للنوال ألوف % 22(@)(@@) % و أحلني جدواه ذروة شاهق % متمنع صعب المرام منيف % 23(@)(@@) % لم ترمني الأيام فيه بنظرة % إلا انثنين بناظر مطروف % PageV01P579 البحر : - 1(@)(@@) % عاف الوقوف على المحل العافي % % و أقام إلف مودة الألاف % 2(@)(@@) % صب يواصلللصبابةقاطعا % و يلم من ألم الغرام بحاف % % 3(@)(@@) % ظام إلى الوجنات يورده الردى % % ورد بها يجنى بغير قطاف % 4(@)(@@) % و يزيده ضعف الخصورإذا انثنت % للوجدأضعافا على أضعاف % 5(@)(@@) % أيام يعطفهعلى لذاته % % خنث الشمائل مائس الأعطاف % 6(@)(@@) % و الشرب قد صبوا الصباح على الدجى % % ما بين ضوء سوالف وسلاف % 7(@)(@@) % و البدر يظهر في السحابكأنه % % عذراء تنظر من وراء سجاف % 8(@)(@@) % و الراح قد حملت لها ريح الصبا % % نفحات مسك بالعبير مداف % 9(@)(@@) % و تناهبت كاساتها ظلم الدجى % % نهب العفاة ندى أبي العطاف % 10(@)(@@) % حكم على الأيام يحكم في العدا % % و المال حكم مجانب الإنصاف % PageV01P580 11(@)(@@) % فمحله خضر الجناب من الندى % % عذب الموارد آمن الأكناف % 12(@)(@@) % حالي الثرى يجري النسيمإذا جرى % % صبحا بأنفاس عليه ضعاف % 13(@)(@@) % قطع الوفود به المسيرو طالما % % وصلوا الذميل إليه بالإيجاف % 14(@)(@@) % عرفوا الأمير مواصلا معروفه % % بخلائق مسكية الأعراف % 15(@)(@@) % و كسوه من بدع القريض مدائحا % موشية كبدائع الأفواف % 16(@)(@@) % أعطى فقصر في العطاء بحاتم % وسطا فأخمل سطوة الجحاف % 17(@)(@@) % في معرك طاف الردى بكماته % % عند اختلاف الطعن أي طواف % 18(@)(@@) % فإذا السنابك أنشأت ليلا به % % ثقب الصباح له سنا الأسياف % 19(@)(@@) % من أسرة أسرت لها صيد العلى % % وقفافا أصيد في الردى وقاف % 20(@)(@@) % جعلوا السيوف لكل خطب معقلا ؛ % إن السيوف معاقل الأشراف % % PageV01P581 21(@)(@@) % و كساهم صفو النجاة خلائقا % أصفى من الماء الزلال الصافي % % 22(@)(@@) % فلهم عزائم ما امتضين صوارما % إلا جلين بها دجى الأسياف % 23(@)(@@) % و محل عز شامل ما احتله % % باغ 
ms154	 كساه البغي ثوب خلاف % 24(@)(@@) % إلا رأى الرايات تخفق حوله % % و رأى الوشيج مخضب الأطراف % PageV01P582 البحر : - 1(@)(@@) % قد عقلت اللسان دونكو الخا % % ئن من سلطت عليه القوافي % % 2(@)(@@) % و أرى الوعد منك في كل يوم % ثمرا غير مؤذن بقطاف % 3(@)(@@) % فتنبهفأنت ما بين شهد % من لساني وبين سم ذعاف % PageV01P583 البحر : - 1(@)(@@) % ألا يا بن فهد وقيت الردى % % فأنت الجواد الأديب الشريف % 2(@)(@@) % صرفنا الأعنة نحو المدام % و ما للزمان علينا صروف % 3(@)(@@) % فغابت كواكب لذاتنا % % و أعجل شمس المدام الكسوف % 4(@)(@@) % فجد بالتي عندها للسرور % حياة و للهم فيها حتوف % 5(@)(@@) % فما جاد بالراح إلا الجواد % و ما كبر الظرف إلا الظريف % PageV01P584 البحر : - 1(@)(@@) % رفق الزمان بناو كان عنيفا % % و غدا لنا بعد القراع حليفا % % 2(@)(@@) % و دنت ظلال المكرماتو ذللت % أثمارها للطالبين قطوفا % % 3(@)(@@) % أهلا بمن رعت المدائح روضه % % فعرفن في أيامه المعروفا % % 4(@)(@@) % و حنته رأفته على زواره % فأراهم خلق النوائب ريفا % % 5(@)(@@) % قدمت بمقدمه المكارمفاغتدت % خضرا ترف على العفاة رفيفا % % 6(@)(@@) % و زهت بلاد الحصن بالقمر الذي % % أهدى إلى القمر المنير كسوفا % % 7(@)(@@) % نظم الأمير لها قلائد سؤدد % أشرفن في لباتهاو شنوفا % % 8(@)(@@) % و غدا الفرات لبيته متضائلا % لا يستبين ضؤولة ونحوفا % % 9(@)(@@) % فلو استطاع إليه قصدا لا نكفى % % حتى يرى عن قصده مصروفا % % 10(@)(@@) % لولا أبو العطاف لم تلق الندى % % غضا و لم يكن الزمان عطوفا % % PageV01P585 11(@)(@@) % ملك يراه عدوه متحننا ؛ % و يراه طالب رفده مألوفا % % 12(@)(@@) % مغض و ليس لحاظه إن بثها % % إلا حياة غضة وحتوفا % % 13(@)(@@) % و أغر يأنف أن يصد عن الوغى % % حتى يذل معاطسا وأنوفا % % 14(@)(@@) % و فتى إذا شغف الملوك بحفظهم % % أضحى بخفض عدوه مشغوفا % % 15(@)(@@) % سائل بصولته ابن مزروع وقد % % ولى يشق من العجاج سجوفا % % 16(@)(@@) % و أرته خيفة سيفه وسنانه % % لين المهاد أسنة وسيوفا % % 17(@)(@@) % أوفى عليه مقارعا حتى إذا % % أعطى القياد أجاره ملهوفا % % 18(@)(@@) % طوقته بالمنحين ملكته % % طوقا ثقيلا في الرقاب خفيفا % % 19(@)(@@) % و الديلمي هفت به أمنية 
ms155	 ؛ % غرر يفيد اللوم والتعنيفا % % 20(@)(@@) % وافاك كالمحتال يختل صيده % % فأثار منك الأصيد الغطريفا % % PageV01P586 21(@)(@@) % و أحق من يضحي فريسة ضيغم % من راح مقتحما عليه عريفا % % 22(@)(@@) % قيدت لحظ جفونهفأريته % % رأد الضحى ليلا عليه كثيفا % % 23(@)(@@) % و تركته ما إن يعاين إلفه % إلا خيالا في المنام مطيفا % % 24(@)(@@) % و كذاك من شبت بأرضك ناره % أضحى بنارك طرفه مطروفا % % 25(@)(@@) % لا تعد منك ربيعة الفرس التي % % عمرت جنابك مربعا ومصيفا % % 26(@)(@@) % أحللتها للجود روضا معشبا % سهلا و طودا للفخار منيفا % % 27(@)(@@) % فاسلمفكم شيدت من أكرومة % و هدمت تالد ثروة وطريفا % % 28(@)(@@) % و تملها غراء لست بملبس % أفوافها إلا أغر شريفا % % 29(@)(@@) % رقت ورق كلامهافكأنما % % جلبت ربيع محاسن وخريفا % % 30(@)(@@) % و كأن لابسها يعاين جوهرا % من لفظها أو يستشف شفوفا % % PageV01P587 31(@)(@@) % لو صافحت سمع ابن أوس لم يقل % أطلالهم سلبت دماها الهيفا % % PageV01P588 البحر : - 1(@)(@@) % شعر ابن أوس رياض جمة الطرف % فنحن منه مدى الأيام في تحف % 2(@)(@@) % لكن كرهناه لما سار في طرق % من فيك مكروهة الأنفاس والنطف % 3(@)(@@) % و الشعر كالريح إن مرت على زهر % طابتو تخبث إن مرت على الجيف % PageV01P589 البحر : - 1(@)(@@) % قمر تفرد بالمحاسن كلها % % فإليه ينسب كل حسن يوصف % 2(@)(@@) % فجبينه صبح و طرته دجى % % و قوامه غصن رطيب أهيف % 3(@)(@@) % لله ذاك الوجه كيف تألفت % فيه بدائع لم تكن تتألف % 4(@)(@@) % ورد يعصفره الحياءو نرجس % يغضيإذا طال العتابو يطرف % PageV01P590 البحر : - 1(@)(@@) % ألا سقني الصهباء صرفا فإنني % % لمن لام فيها ما حييت مخالف % 2(@)(@@) % ألست ترى وشي الرياض كأنما % % تنشر في أرجائهن المطارف % 3(@)(@@) % و مشمولة شج السقاة كؤوسها % % فأشرق وجه الصبحو الليل عاكف % 4(@)(@@) % و لاح على الكاسات فاضلهاكما % % تلوح على حمر الخدود السوالف % PageV01P591 البحر : - 1(@)(@@) % يا ابن حسانو الأنام ضروب % حين تتلو أخبارهمو صنوف % 2(@)(@@) % غرني منك ناظر يكثر الإط % % راق سمتا و شارب محفوف % 3(@)(@@) % و تكشفتفالعوار الذي ما % % زلت تخفيه ظاهر مكشوف % 4(@)(@@) % مولع بالقطوب يظهر سخطا % و رضاهإذا استشاططفيف % 5(@)(@@) % كنت أبقي على العذولو 
ms156	 ما أد % % ري بأن العذول طرا لفيف % PageV01P592 البحر : - 1(@)(@@) % رب منيف في ذرى منيف % أركانه مرهفة السيوف % 2(@)(@@) % تخفق تحت عارض كثيف % كهودج ممسك السحوف % 3(@)(@@) % لفتية على الهوى عكوف % قد بكروا للقنص المألوف % 4(@)(@@) % بحالك الجلباب والنصيف % أوضاحه من درعه الرصيف % 5(@)(@@) % فرد تخيرناه من ألوف % مؤيد بعسكر الحتوف % 6(@)(@@) % يكشر عن خناجر صفوف % تضمن للصحب قرى الضيوف % 7(@)(@@) % تراه قبل شده العنيف % مخضب الظفر من الغضروف % 8(@)(@@) % عناقه للخائن الملهوف % عناق لا بر ولا عطوف % 9(@)(@@) % آنس في مطمورة الحتوف % موشيةكالبرد ذي التفويف % 10(@)(@@) % تضحك عن دمع الحيا المذروف % سرب مها كاللؤلؤ المشوف % PageV01P593 11(@)(@@) % أسلمها المشتى إلى المصيف % فرتعت في نعم الخريف % 12(@)(@@) % فشامها بمقلتي غطريف % و امتد كالصعدة في التثقيف % 13(@)(@@) % و انصب للحين انصباب موف % فشك بين النحر والشرسوف % 14(@)(@@) % مثل سنان القين ذي التأنيف ؛ % طراد لا وان ولا ضعيف % 15(@)(@@) % و أخذ جبار بها عسوف % و راح قد جل عن التعنيف % 16(@)(@@) % في يوم قر جادع الأنوف % ينقض مثل الكرسف النديف % 17(@)(@@) % أو مثل كافورته السفوف % عن أذنيه وعن الصليف % 18(@)(@@) % مثل انفصام العقد والشنوف % فنحن من عطائه في ريف % 19(@)(@@) % و نعمة دانية الرفيف % بين قديد اللحم والصفيف % 20(@)(@@) % نعمة رحمان بنا رؤوف % % PageV01P594 البحر : - 1(@)(@@) % أبا بكر أسأت الظن فيمن % % سجيته التمنع والخلاف % 2(@)(@@) % و خفت عليه في الخلوات مني % % و لم تك بيننا حال تخاف % 3(@)(@@) % جفوت من الصبا ما ليس يجفى % % و عفت من الهوى ما لا يعاف % 4(@)(@@) % فلو أني هممت بقبح فعل % لدى الإغفاء أيقظني العفاف % PageV01P595 البحر : - 1(@)(@@) % هواء كالهوى حسنا و ظرفا % % و خيش ليس يترك أن يجفاحذف % % 2(@)(@@) % و فتيان كرام باكروه % % و نجم صباحهم يبدو و يخفى حذف % % 3(@)(@@) % فإن بادرتهم جعلوك بدرا % و إن خالفتهم جعلوك خلفاحذف % % PageV01P596 البحر : - 1(@)(@@) % أنى يعود من الصبابة مفرقا % % و لقاؤهم للبين غادره لقا % % 2(@)(@@) % لم تعترض غزلانهم يوم النقا % % إلا لكي يخجلن غزلان النقا % % 3(@)(@@) % رفعوا القبابو فرقت أظعانهم % % فرقا 
ms157	 أمرن الصبر أن يتفرقا % % 4(@)(@@) % و وراءهم دمع إذا أوطأته % % يوم النوى عنق التجلد أعنقا % % 5(@)(@@) % هن الحيا حرم الغميم غمامه % % و سرت بوارقه يجدن الأبرقا % % 6(@)(@@) % لم يغن من تلك المحاسن منزل % إلا تقاضاه الفراقفأملقا % % 7(@)(@@) % ترقا الدموعو لي على آثارهم % % دمع رقاه العاذلون فما رقا % % 8(@)(@@) % لا أحسب الأجفان يلقى بعضها % % بعضا إذا كان الفراق الملتقى % % 9(@)(@@) % أشقيقة الجزعينأية لوعة % عجنا عليكغداة عجنا الأينقا % % 10(@)(@@) % منحتك أنفاس الصبا ما استودعت % و سقاك رقراق الحيا ما روقا % % PageV01P597 11(@)(@@) % أيشوقني طرب الشبابو إنما % % شغف الهلال بحيث تم وأشرقا % % 12(@)(@@) % و العود ليس يعد تربا موطنا % إلا إذا ما اهتز فيه وأورقا % % 13(@)(@@) % و لقد وصلت إلى الجواد مغربا % من بعد ما خضت اللئام مشرقا % % 14(@)(@@) % و زجرت أمثال الأهلة بل ترى % % أجرامهن من الأهلة أمحقا % % 15(@)(@@) % و خلعت جلباب الظلام ممسكا % و لبست جلباب الصباح مخلقا % % 16(@)(@@) % فالآن ناضلت الخطوب بصائب % يصميو كم ناضلتهن بأفوقا % % 17(@)(@@) % و رأيت سيف الدولة السيف الذي % % يزداد في ظلم الكريهة رونقا % % 18(@)(@@) % أوفى فكان محلقا و مضى فكا % % ن مزلقا وسطا فكان محرقا % % 19(@)(@@) % متبسم ينهل في استهلاله % % ماء الحياةفإن تلهب أصعقا % % 20(@)(@@) % نالت يداه أقاصي المجد الذي % % بسط الحسود إليه باعا ضيقا % % PageV01P598 21(@)(@@) % أعدوههل للسماك جريرة % في أن دنوت من الحضيض وحلقا % % 22(@)(@@) % أم هل لممتلىء اليدين من العلا % % ذنب إذا ما كنت منها مملقا % % 23(@)(@@) % صبرا فلست تنال أدنى سعيه % % إلا إذا نلت الصبير المبرقا % % 24(@)(@@) % عذبت بصفو المكرمات صفاته % % فأتى خليقا بالمكارم أخلقا % % 25(@)(@@) % في جمرة الحسب التي لا تصطلى % % و ذؤابة الشرف التي لا ترتقى % % 26(@)(@@) % يدنو إلى الأمل البعيد بهمة % تغتال أبعد من مداه وأسحقا % % 27(@)(@@) % فحذار من لحظ الشجاعإذا رنا ؛ % و حذار من عزماته إن أطرقا % % 28(@)(@@) % ركز الرماح على الثغورفأصبحت % % سورا على تلك الفجاج وخندقا % % 29(@)(@@) % مستيقظا لو رنقت أجفانه % % عن مشرب الأيام عاد مرنقا % % 30(@)(@@) % لم يسر عارضه إلى أعدائه % % إلا ليمطرهم دما متدفقا % % PageV01P599 31(@)(@@) % حرقت 
ms158	 سراياه الدروبكأنها % % بحر تدافع موجهفتخرقا % % 32(@)(@@) % حتى أباح حريمهملا ظالما % و حنا على أبكارهم لا مشفقا % % 33(@)(@@) % رفع القنا عن حمل هام ملوكهم % % فغدا وراح على الخليج مفلقا % % 34(@)(@@) % في كل أفق منه سهم منية % يرنو إلى كبد العدو مفوقا % % 35(@)(@@) % خيل تمزق كل يوم مأزقا % و ظبا تفلق كل يوم فيلقا % % 36(@)(@@) % إسعد بعيدك والق ما تهوى به % % و ليلق من عاداك خطبا موبقا % % 37(@)(@@) % نحر نحرت البدن فيه مسددا % و فتكت بالأعداء فيه موفقا % % 38(@)(@@) % دميان ما تاق الشجاع إليهما % % إلا إذا خلط الشجاعة بالتقى % % 39(@)(@@) % حملتني نعما شرفت بحملها % % فإذا نطقت بها نطقت مصدقا % % 40(@)(@@) % لا تفصم الأيام طوقيإنني % % أصبحت بالإحسان منك مطوقا % % PageV01P600 البحر : - 1(@)(@@) % أما الخيالفما يغب طروقا % % يدنو بوصلك شائقا ومشوقا % % 2(@)(@@) % وفى فحقق لي الوفاءو لم يزل % خدن الصبابة بالوفاء حقيقا % % 3(@)(@@) % و مضى و قد منع الجفون خفوقها % % قلب لذكرك لا يقر خفوقا % % 4(@)(@@) % هل عهدنا بلوى الشقيقة راجع % فيعود لي فيه الوصال شقيقا % % 5(@)(@@) % أيام وصلك في الصبابة مجهلا % لا يعرف السلوان فيه طريقا % % 6(@)(@@) % أهوى أنيق الحسن مقتبل الصبا % % و أزور مخضر الجناب أنيقا % % 7(@)(@@) % راح الغمام به صفيقا ثوبه % % و غدا به ثوب النسيم رقيقا % % 8(@)(@@) % هي غدرة للدهر غادرت الهوى % % بعد الوفاءمكدرا مطروقا % % 9(@)(@@) % لا ألحظ الأيام لحظة وامق % حتى يعيد زماننا الموموقا % % 10(@)(@@) % و ركائب يخرجن من غلس الدجى % % مثل السهام مرقن منه مروقا % % PageV01P601 11(@)(@@) % و الفجر مصقول الرداء كأنه % % جلباب خود أشبعته خلوقا % % 12(@)(@@) % أغمامة بالشام شمن بروقها % % أم شمن من بشر الأمير بروقا % % 13(@)(@@) % ملك تسهل بالسماح يمينه % % حزنا و توسع بالصوارم ضيقا % % 14(@)(@@) % يلقى الندى برقيق وجه مسفر % فإذا التقى الجمعان عاد صفيقا % % 15(@)(@@) % رحب المنازل ما أقامفإن سرى % % في جحفل ترك الفضاء مضيقا % % 16(@)(@@) % ما انفك يطلع بالحتوف على العدا % % صبحاو يطرق بالحمام طروقا % % 17(@)(@@) % فإذا جرى للمجد نال صبوحه % % سبقا ونال الناس منه غبوقا % % 18(@)(@@) % و إذا طمى بحر الكريهة خاضه % % فأمات من 
ms159	 عاداه فيه غريقا % % 19(@)(@@) % مهلا عداة الدينإن لخصمكم % % خلقا بإرغام العدو خليقا % % 20(@)(@@) % أنذرتكم حامي الحقيقة لا يرى % % إلا لمرهفة السيوف حقوقا % % PageV01P602 21(@)(@@) % سدت عزائمه الثغورو حالفت % آراؤه التسديد والتوفيقا % % 22(@)(@@) % و رمى بلاد الروم بالعزم الذي % % مازال صبحا في الظلام فتيقا % % 23(@)(@@) % رزحت مخائل بأسه في عارض % متألق يغشى العيون بريقا % % 24(@)(@@) % جيش إذا لاقى العدو صدوره % % لم تلق للأعجاز منه لحوقا % % 25(@)(@@) % حجبت له شمس النهارو أشرقت % شمس الحديد بجانبيه شروقا % % 26(@)(@@) % أخلى معاقلهم وحاز نهابهم % % قسرا و فرق جمعهم تفريقا % % 27(@)(@@) % فتضرجت تلك البطاح به دما % و تضرمت تلك الفجاج حريقا % % 28(@)(@@) % و ثنى الجياد يشق جيب عجاجها % % و مضى السيوف فينثني مشقوقا % % 29(@)(@@) % و الدهر مبتسم يروق كأنما % % أبدى بطلعته الثنايا الروقا % % 30(@)(@@) % فتح جليل القدر زيد به الهدى % % برا كما زيد الضلال عقوقا % % PageV01P603 31(@)(@@) % أعليكم نعم منحت جليلة % منحتك معنى في الثناء دقيقا % % 32(@)(@@) % و ندى رفعت به لحيي تغلب % شرفا أناففعانق العيوقا % % 33(@)(@@) % فاسلم لمكرمة شغلت بحبها % % قلبا بحب المكرمات علوقا % % 34(@)(@@) % و تمل مدحيإنه ريحانة % نفحتفباشرها اللبيب طليقا % % 35(@)(@@) % شعشعت منه اللفظ ثم نظمته % % فكأنما شعشعت منه رحيقا % % 36(@)(@@) % قد كان غفلا قبل جودكفاغتدى % % علما بجودك في الورى مرموقا % % PageV01P604 البحر : - 1(@)(@@) % أعددت لليلإذا الليل غسق % و قيد الألحاظ من دون الطرق % 2(@)(@@) % أغصان تبر عريت عن الورق % ثمارها مثل مصابيح الأفق % 3(@)(@@) % يغني الندامى ضوؤها عن الفلق % شفاؤها إن مرضت ضرب العنق % % PageV01P605 البحر : - 1(@)(@@) % أمحل صبوتنادعاء مشوق % يرتاح منك إلى الهوى الموموق % 2(@)(@@) % هل أطرقنالعمربين عصابة % سلكوا إلى اللذات كل طريق % 3(@)(@@) % أم هل أرى القصر المنيف معمما % برداء غيم كالرداء رقيق % 4(@)(@@) % و قلالي الدير التي لولا النوى % % لم أرمها بقلىو لا بعقوق % 5(@)(@@) % محمرة الجدران ينفح طيبها % % فكأنها مبنية بخلوق % 6(@)(@@) % و محل خاشعة القلوب تفردوا % % بالذكر بين فروقه وفروق % 7(@)(@@) % أغشاه بين منافق متجمل % و مناضل عن كفره زنديق % 8(@)(@@) % و أغن تحسب جيده إبريقه % % ما قام يسفح عبرة الإبريق 
ms160	 % 9(@)(@@) % يتنازعون على الرحيق غرائبا % يحسبن زاهرة كؤوس رحيق % 10(@)(@@) % صدرت عن الأفكارو هي كأنها % % رقراق صادرة عن الراووق % PageV01P606 11(@)(@@) % دهر ترفق بي فواقا صرفه % % وسطا عليفكان غير رفيق % 12(@)(@@) % فمتى أزور قباب مشرفة الذرى % % فأرود بين النسر والعيوق % 13(@)(@@) % و أرى الصوامع في غوارب أكمها % % مثل الهوادج في غوارب نوق % 14(@)(@@) % حمرا تلوح خلالها بيض كما % % فصلت بالكافور سمط عقيق % 15(@)(@@) % كلف تذكر قبل ناهية النهى % % ظلينظل هوىو ظل حديق % 16(@)(@@) % فتفرقت عبراته في خده % % إذ لا مجير له من التفريق % PageV01P607 البحر : - 1(@)(@@) % نفسي فداؤك هاديا % تهدى بها عصب الرفاق % 2(@)(@@) % كالبدر يحسب في التما % % مو قد ترفع بالمحاق % 3(@)(@@) % أوفى على طرق أقا % % م فليس يؤذن بانطلاق % 4(@)(@@) % متوشحا فيه دما % كحمائل البيض الرقاق % 5(@)(@@) % و مضارع الجوزاء لي % % لا في علو واتساق % 6(@)(@@) % فكأنه وكأنها % % إلفان هما باعتناق % PageV01P608 البحر : - 1(@)(@@) % ألست ترى ركب الغمام يساق % و أدمعه بين الرياض تراق % 2(@)(@@) % و قد رق جلباب النسيم على الندى % % و لكن جلابيب الغيوم صفاق % 3(@)(@@) % و عندي من الريحان نوع تحبه % و كأس كرقراق الخلوق دهاق % 4(@)(@@) % و ذو أدب جلت صنائع كفه % % و لكن معاني الشعر فيه دقاق % 5(@)(@@) % لنا أبدا من نثره ونظامه % % بدائع حلي ما لهن حقاق % 6(@)(@@) % و أغيد مهتز على صحن خده % غلائل من صبغ الحياء رقاق % 7(@)(@@) % أحاطت عيون العاشقين بخصره % % فهن لهدون النطاق نطاق % 8(@)(@@) % و قد نظم المنثورفهو قلائد % عليناو عقد مذهب وخناق % 9(@)(@@) % و غرفتنا بين السحائب تلتقي % % لهن عليهاكلة ورواق % 10(@)(@@) % تقسم زوار من الهند سقفها % % خفاف على قلب النديم رشاق % PageV01P609 11(@)(@@) % أعاجم تلتذ الخصام كأنها % % كواعب زنج راعهن طلاق % 12(@)(@@) % أنسن بنا أنس الإماء تحببت % و شيمتها غدر بنا وإباق % 13(@)(@@) % مواصلة و الورد في شجراته ؛ % مفارقة إن حان منه فراق % 14(@)(@@) % فزر فتية برد الشراب لديهم % حميم إذا فارقتهم وغساق % 15(@)(@@) % إذا اشتهرت بالحسن أخلاق صاحب % فليسلمخلوق جفاه خلاق % PageV01P610 البحر : - 1(@)(@@) % لم يشف بالدمع عليل الفراق 