ms365	 عنه مسعر مجهول(@)(@@)(@@)(@@) | 7162 - (@)(@@) يزيد أبو طلحة عن عبد الرحمن بن الخيار لا يعرف(@)(@@)(@@)(@@) | 7163 - (@)(@@) يزيد الرشك ثقة مشهور قال أبو احمد الحاكم ليس بالمتين عندهم(@)(@@)(@@)(@@) | 7164 - (@)(@@) يسار البناني عن ثابت البناني قال يحيى لا شيء(@)(@@)(@@)(@@) | 7165 - (@)(@@) يسر بن ابراهيم عن أبيه لا يعرف والخبر منكر كان قبل المأتين(@)(@@)(@@)(@@) | 7166 - (@)(@@) يسر بن عبد الله عن النبي لا شيء يأتي بالطامات أو لا وجود له(@)(@@)(@@)(@@) | 7167 - (@)(@@) اليسع بن إسماعيل البغدادي عن ابن عيينة ضعفه الدارقطني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 71680 - (@)(@@) اليسع بن سهل الزيني عن ابن عيينة لم أر لهم فيه كلاما وخبره موضوع(@)(@@)(@@)(@@) | 7169 - (@)(@@) اليسع بن طلحة عن عطاء بن أبي رباح ضعفوه قال البخاري منكر الحديث(@)(@@)(@@)(@@) | 7170 - (@)(@@) اليسع بن عيسى عن أبي ظبية وعنه مبارك بن همام مجهول(@)(@@)(@@)(@@) | 7171 - (@)(@@) اليسع بن عيسى بن حزم الغافقي تكلم في نقله ويظهر على عبارته مجازفة(@)(@@)(@@)(@@) | 7172 - (@)(@@) اليسع بن محمد عن أبي سليمان الأيلي قال الأزدي منكر الحديث(@)(@@)(@@)(@@) | 7173 - (@)(@@) اليسع بن المغيرة المخزومي عن ابن سيرين صدوق وقال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) | 7174 - (@)(@@) خ م / يسير بن جابر ويقال أسير له في قصة أويس ثقة قال ابن حزم ليس بالقوي(@)(@@)(@@)(@@) | 7175 - (@)(@@) يعقوب بن إبراهيم القاضي الزهري عن هشام بن عروة لا يدرى من هو ليس بابن بعد(@)(@@)(@@)(@@) | 7176 - (@)(@@) يعقوب بن إبراهيم القاضي عن عطاء بن السائب قال الفلاس(@)(@@) PageV02P756(@)(@@) صدوق كثير الغلط وقال خ تركوه وقال المزني أبو يوسف أتبع القوم للحديث وقال عمرو الناقد كان صاحب سنة وقال أبو حاتم يكتب حديثه(@)(@@)(@@)(@@) | 7177 - (@)(@@) يعقوب بن إبراهيم النيلي عن ابن عجلان لا يتابع على حديثه(@)(@@)(@@)(@@) | 7178 - (@)(@@) يعقوب بن إسحاق بن ابراهيم بن مجمع قال البخاري روى عنه يعقوب بن محمد الزهري حديثا منكرا قلت ويعقوب ابن محمد منكر الحديث(@)(@@)(@@)(@@) | 7179 - (@)(@@) يعقوب بن إسحاق بن تحية الواسطي عن يزيد بن هارون ليس بثقة قد اتهم(@)(@@)(@@)(@@) | 7180 - (@)(@@) يعقوب بن إسحاق البيهسي الضبي عن عفان ضعفه الدارقطني(@)(@@)(@@)(@@)