ms2360	 بوجهه ليس عليه لحم ، ومن فتح على نفسه باب مسألة من غير فاقة نزلت به أو عيال لا يطيقهم ، فتح الله عليه باب فاقة من حيث لا يحتسب ) )(@)(@@) ابن جرير في تهذيبه ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 22015 ) قال النبي :(@)(@@) | 30 ( من سأل مسألة وهو عنها غني ، جاءت يوم القيامة كدوحا في وجهه ، ولا تحل الصدقة لمن له خمسون درهما أو عرضها من الذهب ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22016 ) قال النبي :(@)(@@) | 30 ( من سأل عني أو سره أن ينظر إلي ، فلينظر إلى أشعث شاحب مشمر لم يضع لبنة على لبنة ، ولا قصبة على قصبة ، رفع له عمل فشمر إليه ، اليوم المضمار ، وغدا السباق ، والغاية الجنة أو النار ) )(@)(@@) ( حل ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 22017 ) قال النبي :(@)(@@) | 30 ( من سأل مسألة عن ظهر غنى استكثر بها من رضف جهنم ، قالوا : ما ظهر غنى ؟ قال : عشاء ليلة ) )(@)(@@) ( حم ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22018 ) قال النبي :(@)(@@) | 30 ( من سأل وله أوقية أو عدلها فقد سأل إلحافا ) )(@)(@@) ( حم هق ) عن رجل من بني أسد .(@)(@@) PageV07P219(@)(@@)(@@)(@@) $ ( 22019 ) قال النبي :(@)(@@) | 30 ( من سأل الناس وعنده ما يكفيه ، جاء يوم القيامة وليس في وجهه مزعة لحم ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22020 ) قال النبي :(@)(@@) | 30 ( من سأل أخاه المسلم أن يقيله فأقاله ، أقال الله له عثرته ، فإن لم يقله لا أقاله الله تعالى عثرته وكبه في النار على وجهه ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22021 ) قال النبي :(@)(@@) | 30 ( من سأل الناس ليثري ماله كان خموشا في وجهه ، ورضفا من جهنم يأكله يوم القيامة ، فمن شاء فليقل ومن شاء فليكثر ) )(@)(@@) ابن جرير في تهذيبه ( طب ) عن أحمد بن جنادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22022 ) قال النبي :(@)(@@) | 30 ( من سأل الناس في غير مصيبة حاجته ، فكأنما يلقم الرضفة ) )(@)(@@) ( طب ) عن أحمد بن جنادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 22023 ) قال النبي :(@)(@@) | 30 ( من سأل الناس ليثرى ماله فإنما هو رضف من النار يلقمه ، من شاء 