ms452	 أستهديك لأرشد أمري ، وأعوذ بك من شر نفسي ) )(@)(@@) ( ش حم طب ) عن عثمان بن أبي العاصي رضي الله عنه وامرأة من قريش .(@)(@@)(@@)(@@) $ ( 4278 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بوجهك الكريم واسمك العظيم من الكفر والفقر ) )(@)(@@) ( طب ) في السنة عن عبد الرحمن بن أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4279 ) قال النبي :(@)(@@) | 30 ( اللهم انصرني على من بغى علي ، وأرني ثأري ممن ظلمني ، وعافني في جسدي ، ومتعني بسمعي وبصري واجعلهما الوارث مني ) )(@)(@@) الباوردي عن سعد بن زرارة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4280 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الصمم والبكم ، وأعوذ بك من المأثم والمغرم ، وأعوذ بك من موت الغم ، وأعوذ بك من موت الهرم ، وأعوذ بك من الهرم ، وأعوذ بك من الجوع فإنه بئس الضجيع ، وأعوذ بك من الخيانة فإنها بئست البطانة ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4281 ) قال النبي :(@)(@@) | 30 ( اللهم من ظلم أهل المدينة وأخافهم فأخفه وعليه لعنة الله والملائكة والناس أجمعين ، لا يقبل منه صرف ولا عدل ) )(@)(@@) ابن النجار عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4282 ) قال النبي :(@)(@@) | 30 ( اللهم إنك تسمع كلامي وترى مكاني وتعلم سري PageV02P115 وعلانيتي ، لا يخفى عليك شيء من أمري وأنا البائس الفقير المستغيث المستجير الوجل المشفق المقر المعترف بذنبه ، أسألك مسألة المسكين ، وأبتهل إليك ابتهال المذنب الذليل ، وأدعوك دعاء الخائف الضرير من خضعت لك رقبته ، وفاضت لك عبرته ، وذل لك جسمه ، ورغم لك أنفه ، اللهم لا تجعلني بدعائك شقيا وكن بي رؤوفا رحيما يا خير المسؤولين ويا خير المعطين ) )(@)(@@) ( طب ) و الخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4283 ) قال النبي :(@)(@@) | 30 ( اللهم بارك لامتي في سحورها ، تسحروا ولو بشربة من ماء ولو بتمرة ولو بحبات زبيب إن الملائكة تصلي عليكم ) )(@)(@@) ( قط ) في الأفراد عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4284 ) قال النبي :(@)(@@) | 30 ( اللهم اسقنا غيثا مغيثا مريعا طبقا عاجلا غير راث ، نافعا غير ضار ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4285 ) قال النبي :(@)(@@) | 30 
ms453	 ( اللهم من شغلنا عن صلاة الوسطى امءلا بيوتهم نارا وامءلا أجوافهم نارا واملأ قبورهم نارا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4286 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الكسل والهرم وفتنة الصدر وعذاب القبر ) )(@)(@@) ( طب ض ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4287 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لعبد القيس ثلاثا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4288 ) قال النبي :(@)(@@) | 30 ( اللهم عليك ببني عصية فإنهم عصوا الله ورسوله ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4289 ) قال النبي :(@)(@@) | 30 ( اللهم إني أحرج عن حق الضعيفين اليتيم والمرأة ) PageV02P116 )(@)(@@) ( ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4290 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ذنوبي كلها صغيرها وكبيرها ، دقيقها وجليلها ، قديمها وحديثها ) )(@)(@@) ( طب ) .(@)(@@)(@@)(@@) $ ( 4291 ) قال النبي :(@)(@@) | 30 ( اللهم فقه قريشا في الدين وأذقهم من يومي هاذا إلى آخر الأبد نوالا فقد أذقتهم نكالا ) )(@)(@@) ( طب ) عن العباس بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4292 ) قال النبي :(@)(@@) | 30 ( اللهم هاذا إقبال ليلك وإدبار نهارك وأصوات دعاتك فاغفر لي ) )(@)(@@) ( د ) عن أم سلمة رضي الله عنها قالت : علمني رسول الله أن أقول عند أذان المغرب فذكره .(@)(@@)(@@)(@@) $ ( 4293 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من فتنة النار ومن عذاب القبر ومن شر الغنى والفقر ) )(@)(@@) ( د ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4294 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الأربع : من علم لا ينفع ، ومن قلب لا يخشع ، ومن نفس لا تشبع ، ودعاء لا يسمع ) )(@)(@@) ( ش حم د ن ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4295 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الهدم وأعوذ بك من التردي ، وأعوذ بك أن أموت في سبيلك مدبرا ، وأعوذ بك أن أموت لديغا ) )(@)(@@) ( حم د ن طب ) عن أبي اليسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4296 ) قال النبي :(@)(@@) | 30 ( اللهم لا تكلهم إلي فأضعف عنهم ، ولا تكلهم إلى أنفسهم فيعجزوا عنها ، ولا تكلهم إلى الناس فيستأثروا عليهم