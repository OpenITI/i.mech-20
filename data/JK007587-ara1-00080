ms61	 الأصفياء حتى التأسي % % وجفا حتى الخيال الطروق % PageV01P313 11(@)(@@) % وإذا نهنه الدموع استجمت % % وهمت وهي لؤلؤ وعقيق % % PageV01P314 البحر : وافر تام 1(@)(@@) % نظام الدين كم فارقت خلا % % وكم صليت حشاي لظى اشتياق % % 2(@)(@@) % فلم أجزع لفجئات التنائي % % ولم أفرق لروعات الفراق % 3(@)(@@) % وهأنذا لبعدك إلف هم % تفيض له النفوس من المآقي % % 4(@)(@@) % أمني قلبي الخفاق شوقا % إليك بقرب أيام التلاقي % % PageV01P315 البحر : طويل 1(@)(@@) % أبا الحارث اسلم من حوادث دهرنا % % ومن حر أنفاس المشوق المفارق % % 2(@)(@@) % أذم إليك البين ، إن وشيكه % % رمى كل عظم من عظامي بعارق % % 3(@)(@@) % وأضللت شمسي ، ثم أصبحت ناشدا % لها ، وهي في غريب ، بأرض المشارق % 4(@)(@@) % أروح وأغدو في هموم تعودني % % فيا لي من همين : غاد ، وطارق % % PageV01P316 البحر : طويل 1(@)(@@) % أبا حسن ، قدران ، بعد بعادكم % % على القلب هم ما أراه يزول % % 2(@)(@@) % أعلل نفسي أنني سأبثه % % إذا ما التقينا والرجاء مطول % % 3(@)(@@) % إذا قلت : في أعقاب ذا العام نلتقي % % تمادى وأيام الهموم تطول % % 4(@)(@@) % وأقتل أدوائى بعاد أحبتي % % وداء التنائي ما علمت قتول % % 5(@)(@@) % وقد ساءني أن الليالي غيرت % % أخلاي حتى ما يدوم خليل % % 6(@)(@@) % وجفوة مجد الدين أعدل شاهد % % على أن أهواء القلوب تحول % % 7(@)(@@) % أساء التنائي ظنه بي ، وإننى % % لأعهده في القرب وهو جميل % % 8(@)(@@) % جفاني زمانا لا ملالا وإنما % % نهته حزون بيننا وسهول % 9(@)(@@) % مفاوز لا يسطيع قطع فجاجها % % رسول ولو أن الخيال رسول % % 10(@)(@@) % ولا ذنب إلا للبعاد فما لنا % % دنونا ، وحظي في الدنو قليل % PageV01P317 البحر : بسيط تام 1(@)(@@) % وافى كتابك مفتوحا فبشرني % % بفتح سبل اللقاء الزجر والفال % % 2(@)(@@) % فقلت : أحبب بها بشرى إلى ، وإن % % تعرضت ، دون ما نرجوه ، أهوال % 3(@)(@@) % ثم اعترتني أشواق تجهلني % % كيف اطمانت بقلبي بعدك الحال % 4(@)(@@) % وكيف يبقى وما ينفك ذا وجل % % خوفا عليك وفي الأوجال آجال % % PageV01P318 البحر : بسيط تام 1(@)(@@) % يا خير من علقت كفي مودته % % وصدقت لي في علياه آمال % 2(@)(@@) % ماذا أقول ، وقلبي قد تخلف عن % % جسمي ، وزمت لوشك البين أجمال % 3(@)(@@) % وكم فجعت بروعات الفراق ولا 
ms62	 % % كهذه ، لم يرعني قط ترحال % 4(@)(@@) % وقبل وشك النوى قد كنت أحذرها % % كأن ذاك التوقي قبلها فال % % 5(@)(@@) % فإن تمادت بنا أيام فرقتنا % % وكل ساعات بعدي عنك آجال % 6(@)(@@) % فاحفظ فؤادا مقيما فى ذراك ، ولا % % تسلمه للشوق ، إن الشوق قتال % PageV01P319 البحر : خفيف تام 1(@)(@@) % أين سمعي عما يقول العذول % أنا بالهجر والنوى مشغول % % 2(@)(@@) % وسبيل السلو باد لعي % % ني ولكن مالي إليه سبيل % % 3(@)(@@) % ما قليل الغرام ، يا مستريح الق % % لب مما يلقى المحب قليل % % 4(@)(@@) % بالهوى هام في الفلا قيس ليلى % وبه مات عروة وجميل % 5(@)(@@) % فاعف من لومك المحب ، كفاه % من جواه تسهيده والنحول % % 6(@)(@@) % لا تظنن وجد من فارق الأظ % % عان يحتثهن حاد عجول % % 7(@)(@@) % تقطع البيد حاملات شموسا % ما لها في سوى الخدور أفول % % 8(@)(@@) % كل شمس تنير فوق قضيب % يتهادى به كثيب مهيل % % 9(@)(@@) % لا ولا وجد نازح فارق الأو % % طان ، يهتاجه الضحى والأصيل % 10(@)(@@) % كلما لامه العذول مرى دم % عا تباريه زفرة وعويل % PageV01P320 11(@)(@@) % مثل وجد لفرقة الملك الص % % الح ، وهو المرجو والمأمول % 12(@)(@@) % يا أمير الجيوش يا أعدل الح % % كام في فعله وفيما يقول % % 13(@)(@@) % أنت تقضي بالحق لست وإن زا % % لت جبال الأرضين عنه تزول % % 14(@)(@@) % فبماذا قضيت يا سيد الح % % كام طرا علي أني ملول % % 15(@)(@@) % من يمل الحياة ، أم من عليه % من توالي أنفاسه تثقيل % % 16(@)(@@) % لا ترعني بالعتب ، فهو ، على قط % ع رسوم التشريف عني ، دليل % 17(@)(@@) % لي رسوم ، منها مواصلة الكت % وأنت البر الكريم الوصول % % 18(@)(@@) % وسواها أغنيتني عنه بالإنع % % أم حتى لم يبق لي تأميل % % 19(@)(@@) % فأعذني من قطعها فهي لي فخ % % ر به أدرك العلا وأطول % % 20(@)(@@) % فبودي لو اطلعت على قل % % بي فيبدو لك الولاء الدخيل % % PageV01P321 21(@)(@@) % وترى أن ما زرعت من الإن % % عام لم يحص ريعه التجميل % % PageV01P322 البحر : مجزوء الكامل 1(@)(@@) % أبني السرى والبيد لا % % أغرى الزمان بكم عرامه % % 2(@)(@@) % هل فيكم من مبلغ % % عني السلام أبا سلامه % % 3(@)(@@) % وتحية كشذا فتي % % يق المسك 
ms63	 صفق بالمدامه % % 4(@)(@@) % تهدى يضوع نسيمها % % لأغر عصاء ملامه % % 5(@)(@@) % من جامح العزمات لا % % يرضى على هون مقامه % 6(@)(@@) % وقعن غاربه الخطو % % ب ولم يزل يأبى الظلامه % % 7(@)(@@) % يا بن الخضارمة الكرا % % م أولي المكارم والكرامه % % 8(@)(@@) % من كل بسام تس % % ح يداه للعافين سامه % 9(@)(@@) % خضل الجناب إذا ترد % ى الجو من محل قتامه % 10(@)(@@) % أأسام خسفا ثم لا % % آبى ، فلست إذا أسامه % PageV01P323 11(@)(@@) % هيهات لا ترضى المعا % % لي صاحبا يرضى اهتضامه % 12(@)(@@) % وعلام يخشى الناس من % % لم يخش فى حال حمامه % 13(@)(@@) % من لا تراه إثر شي % % ء فائت يبدي الندامه % 14(@)(@@) % وإذا حوى الرغبات أم % % ضى للعلا فيها احتكامه % 15(@)(@@) % لو أنكرت أجفانه % % طيف الخيال جفا منامه % % PageV01P324 البحر : بسيط تام 1(@)(@@) % وكيف أشكر من أسدى إلى يدا % سرت سرى الطيف من مصر إلى الشام % % 2(@)(@@) % رأى مكاني على بعدي ، وقد عشيت % عنى عيون أخلائي ، وأيامي % % 3(@)(@@) % محافظا لعهودي حين أفردني % % ظلي وأعرض عني طيف أحلامي % % PageV01P325 البحر : بسيط تام 1(@)(@@) % قصرت في خدمي تقصير معترف % وما كذا يفعل الإخوان والخدم % % 2(@)(@@) % حتى تعصفر لون الطرس من وجل % % فإن صفحت جرى في وجنتيه دم % % 3(@)(@@) % وبعد عذري فقد أقرحت من أسف % % جفنى ، وأدمى بنائي بعدك الندم % 4(@)(@@) % أطعت حكم الليالي في فراقي من % % وجداننا كل شيء بعده عدم % % 5(@)(@@) % لم لا تصاممت عن داعي الفراق وما % % بالي صليت لظاه وهو يحتدم % % 6(@)(@@) % فإن تقلني الليالي عثرتي ، وأفز % % بالقرب منك فميعاد اللقا الردم % 8(@)(@@) % % خوف الهلاك على من إبطائه % % 9(@)(@@) % فأعاد لي روح الحياة وصوله % % ولقيت قاصية المنى بلقائه % % PageV01P326 البحر : بسيط تام 1(@)(@@) % يلط بالدين من مولاه مسلمه % % حتى يخلصه السلطان والحكم % % 2(@)(@@) % لكن مولاي يقضي ما استدنت ولا % % يلقى سؤالي منه الصد والسأم % 3(@)(@@) % فكفه البحر ، لكن موجه بدر % وجوده الغيث لكن وبله نعم % % PageV01P327 البحر : بسيط تام 1(@)(@@) % يا راكبا تقطع البيداء همته % % والعيس تعجز عما تدرك الهمم % % 2(@)(@@) % بلغ أميري معين الدين مألكة % من نازح الدرا لكن وده 
ms64	 أمم % % 3(@)(@@) % وقل له : أنت خير الترك فضلك الحي % % حياء والدين والإقدام والكرم % % 4(@)(@@) % وأنت أعدل من يشكى إليه ، ولي % % شكية ، أنت فيها الخصم والحكم % 5(@)(@@) % هل في القضية يا من فضل دولته % % وعدل سيرته بين الورى علم % 6(@)(@@) % تضييع واجب حقي بعد ما شهدت % % به النصيحة والإخلاص والخدم % % 7(@)(@@) % وما ظننتك تنسى حق معرفتي % % إن المعارف في أهل النهى ذمم % % 8(@)(@@) % ولا اعتقدت الذي بيني وبينك من % % ود وإن أجلب الأعداء ينصرم % % 9(@)(@@) % لكن ثقاتك ما زالوا بغشهم % حتى استوت عندك الأنوار والظلم % % 10(@)(@@) % باعوك بالبخس ، يبغون الغنى ، ولهم % لو أنهم عدموك ، الويل ، والعدم % PageV01P328 11(@)(@@) % والله ما نصحوا ، لما استشرتهم % وكلهم ذو هوى في الرأي متهم % % 12(@)(@@) % كم حرفوا من مقال في سفارتهم % % وكم سعوا بفساد ، ضل سعيهم % 13(@)(@@) % أين الحمية والنفس الأبية إذ % % ساموك خطة خسف عارها يصم % % 14(@)(@@) % هلا أنفت حياء أو محافظة % من فعل ما أنكرته العرب والعجم % 15(@)(@@) % أسلمتنا وسيوف الهند مغمدة % % ولم يرو سنان السمهوري دم % 16(@)(@@) % وكنت أحسب من والاك في حرم % لا يعتريه به شيب ولا هرم % 17(@)(@@) % وأن جارك جار للسموءل ، لا % % يخشى الأعادي ، ولا تغتاله النقم % 18(@)(@@) % وما طمان بأولى من أسامة بال % % فاء ، لكن جرى بالكائن القلم % 19(@)(@@) % هبنا جنينا ذنوبا ، لا يكفرها % % عذر فماذا جنى الأطفال والحرم % % 20(@)(@@) % ألقيتهم في يد الإفرنج متبعا % رضا عدى يسخط الرحمن فعلهم % % PageV01P329 21(@)(@@) % هم الأعادي وقاك الله شرهم % % وهم بزعمهم الأعوان والخدم % 22(@)(@@) % إذا نهضت إلى مجد تؤثله % % تقاعدوا فإذا شيدته هدموا % % 23(@)(@@) % وإن عرتك من الأيام نائبة % فكلهم للذي يبكيك مبتسم % 24(@)(@@) % حتى إذا ما انجلت عنهم غيابتها % % بحد عزمك وهو الصارم الخذم % % 25(@)(@@) % رشفت آجن عيش ، كله كدر % ووردهم من نداك السلسل الشبم % 26(@)(@@) % وإن أتاهم بقول عنك مختلق % واش ، فذاك الذي يحبى ، ويحترم % 27(@)(@@) % وكل من ملت عنه قربوه ، ومن % % والاك فهو الذي يقص ويهتضم % % 28(@)(@@) % بغيا ، وكفرا لما أوليت من منن % ومرتع البغي لولا جهلهم وخم % % 29(@)(@@) % جربهم 
ms65	 مثل تجريبي ، لتخبرهم % % فللرجال إذا ما جربوا قيم % % 30(@)(@@) % هل فيهم رجل يغني غناي إذا % % جلا الحوادث حد السيف والقلم % PageV01P330 31(@)(@@) % أم فيهم من له في الخطب ضاق به % % ذرع الرجال يد يسطو بها وفم % % 32(@)(@@) % لكن رأيك أدناهم وأبعدني % % فليت أنا بقدر الحب نقتسم % % 33(@)(@@) % وما سخطت بعادي إذ رضيت به % % وما لجرح إذا أرضاكم ألم % 34(@)(@@) % ولست آسى على الترحال عن بلد % % شهب البزاة سواء فيه والرخم % % 35(@)(@@) % تعلقت بحبال الشمس منه يدي % % ثم انثنت وهي صفر ملؤها ندم % % 36(@)(@@) % لكن فراقك آساني ، وآسفني % % ففي الجوانح نار منه تضطرم % 37(@)(@@) % فاسلم فما عشت لي فالدهر طوع يدي % % وكل ما نالني من بؤسه نعم % PageV01P331 البحر : بسيط تام 1(@)(@@) % يا ناصر الدين ، يا بن الأكرمين ، ومن % % يغنى ندى كفه عن وابل الديم % % 2(@)(@@) % ومن حوى السبق في فضل وفي روع % % وفي عفاف وفي دين وفي كرم % % 3(@)(@@) % أنت العيي على ما فيك من لسن % % عن لا وأفصح خلق الله في نعم % % 4(@)(@@) % تولى الجميل بلا من تكدره % % لا كدر الله ما أولاك من نعم % % 5(@)(@@) % هذا ابن عمك في أسر الفرنج له % % حول تجرم ، في الأغلال والظلم % 6(@)(@@) % يدعوك لا بل أنا الداعي نداك له % % يا خير من علقته كف معتصم % % 7(@)(@@) % وأنت أكرم من تثنيه عاطفة الق % ربى ، ويرجوه للجلى ذوو الرحم % 8(@)(@@) % ومن تكن أنت مولاه وناصره % فكيف تسطو عليه كف مهتضم % 9(@)(@@) % لا تحوجني إلى من الرجال ، فما % % حمل الأيادي وإن أعسرت من شيمي % % 10(@)(@@) % ولا تظنني أدعو سواك ، ولا % % يفوه مجتديا إلا إليك فمي % % PageV01P332 11(@)(@@) % علام أرتشف الرنق الأجاج ، وقد % % رويت كل صد من بحرك الشبم % % 12(@)(@@) % أنا ابن عمك فاجعلني بفك أخي % % من أسره لك عبدا ما مشت قدمي % % 13(@)(@@) % فملك مثلي لا يغلو بما بذل ال % % تاع فيه ، ولا يستام بالقيم % PageV01P333 البحر : كامل تام 1(@)(@@) % هذا كتاب فتى أحلته النوى % % أوطانها ونبت به أوطانه % % 2(@)(@@) % شطت به عمن يحب دياره % % وتفرقت أيدي سبا إخوانه 
ms66	 % 3(@)(@@) % متتابع الزفرات بين ضلوعه % % قلب يبوح بسره خفقانه % % 4(@)(@@) % تأوي إليه مع الظلام همومه % % وتذوده عن نومه أشجانه % % 5(@)(@@) % ألفت مقارعة الكماة جياده % % وسرى الهواجر لا بني ذملانه % % 6(@)(@@) % يومان أجمع دهره إما سرى % أو يوم حرب تلتظى نيرانه % % 7(@)(@@) % لكنه لا يستكين لحادث % % خوف الحمام ، ولا يراع جنانه % PageV01P334 البحر : طويل 1(@)(@@) % أحن إليكم ، والمهامه بيننا % % حنين ألوف بان عنها قرينها % % 2(@)(@@) % وأستر أشواقي ، وأعلم أن لي % % لدى ذكركم ، أنفاس وجد تبينها % % PageV01P335 البحر : كامل تام 1(@)(@@) % نفسي الفداء لمن أذود بذكره % % عني عوادي الهم والأشجان % 2(@)(@@) % وإذا فررت من الخطوب جعلته % % فئتي فيفرقها امتناع مكاني % % 3(@)(@@) % وكأن معجزة المسيح كتابه % % فإذا قضيت من الأسى أحياني % % PageV01P336 البحر : طويل 1(@)(@@) % وإن امرأ أضحى ( بإربل ) داره % % وفي شيزر أحبابه وشجونه % % 2(@)(@@) % لغير ملوم في الحنين إليهم % ومعذورة أن تستهل جفونه % % PageV01P337 البحر : بسيط تام 1(@)(@@) % إن ألقه سره قربي وآنسه % % وإن أغب صد عني معرضا ، ولها % % 2(@)(@@) % كأنني ميت في النوم يبهجه % % لقاؤه ، ثم ينساه إذا انتبها % % PageV01P338 البحر : كامل تام 1(@)(@@) % وافى كتابك معلنا بملامة % % قدحت زنادا في الجوانح واريا % % 2(@)(@@) % وقرأته فوجدت طرفي ضاحكا % فرحاص برؤيته وقلبي باكيا % % 3(@)(@@) % وتعمدتني نافذات سهامه % % حتى إذا أصمين عدن مكاويا % % 4(@)(@@) % وتطلعت منه أراقم رملة % % يردي السليم لعابها والراقيا % % 5(@)(@@) % فكأن ذاك الطرس أضحى سلة الح % حاوي وهاتيك السطور أفاعيا % % PageV01P339 البحر : خفيف تام 1(@)(@@) % رقصت أرضه عشية غنى الر % عد في الجو والكريم طروب % % 2(@)(@@) % وتثنت حيطانه ، فأمالت % ها شمال بزمرها وجنوب % % 3(@)(@@) % لا هبوب لنائم من أماني % % ه وللعاصفات فيها هبوب % % 4(@)(@@) % وأرى البرق شامتا ضاحك الس % ن ، وللجو بالغمام قطوب % 5(@)(@@) % ذكروا أنه تذوب به السح % % ب ، فما للصخور أيضا تذوب % 6(@)(@@) % أبذنب أصابها قدر الل % % ه فللأرض كالأنام ذنوب % % PageV01P340 البحر : بسيط تام 1(@)(@@) % وصاحب لا تمل الدهر صحبته % % يشقى لنفعي ، ويسعى سعي مجتهد % % 2(@)(@@) % لم ألقه مذ تصاحبنا فحين بدا % % لناظري افترقنا فرقة الأبد % % PageV01P341 البحر : طويل 1(@)(@@) % أنيسي في ليل القطيعة مشبهي 
ms67	 : % نحولا وتسهيدا ولونا وأدمعا % % 2(@)(@@) % أواجه وجها منه حيث رأيته % % منيرا إلى من أمه متطلعا % % 3(@)(@@) % كملبس جسمي سقم جفنيه حيثما % % بدا لي عاينت الملاحة أجمعا % % PageV01P342 البحر : طويل 1(@)(@@) % ومفردة تبكي إذا جن ليلها % % خفاتا ، وفي أحشائها النار واللذع % 2(@)(@@) % تذوب جوى ، إما لصد وهجرة % وإما لبين ، ما لتشتيته جمع % 3(@)(@@) % فلم أر جمرا ذائبا غير دمعها % % ولا جسم باك قبلها كله دمع % % PageV01P343 البحر : منسرح 1(@)(@@) % وسل عنك الهموم إن طرقت % ببنت كرم ، في الكأس تأتلق % 2(@)(@@) % إذا فراها المزاج أضرمها % % وقلت أيدي السقاة تحترق % % 3(@)(@@) % توجها الماء من فواقعه % % تاجا به ترتدي وتنتطق % % 4(@)(@@) % يقال ما تستقر والهم في % % صدر ، فيا نعمتاه لو صدقوا % % 5(@)(@@) % وأين من همي المدام ، وقد % % سدت عليها من دونه الطرق % % PageV01P344 البحر : بسيط تام 1(@)(@@) % أعجب لمحتجب عن كل ذي نظر % % صحبته الدهر لم أسبر خلائقه % % 2(@)(@@) % حتى إذا رابني قابلته ، فقضى % % حياؤه وإبائي أن أفارقه % % PageV01P345 البحر : كامل تام 1(@)(@@) % وافتك حالكة السواد ، يخالها % % صبغ الشباب الناظر المتوسم % 2(@)(@@) % فيها رماح الخط مرهفة الشبا % % تردي الطعين ولا يضرجها دم % % 3(@)(@@) % من كل أهيف إن جرى في طرسه % % ناجى فأفهم وهو لا يتكلم % % 4(@)(@@) % بيض الأيادي في سواد لعابه % % فكأنما الأرزاق منه تقسم % % 5(@)(@@) % تحوي مسلطة عليها ، يختشى % % من حدها الماضي الحسام المخذم % % 6(@)(@@) % تأديبها لهم بقطع رووسهم % % إن قصروا في السعي عما ترسم % 7(@)(@@) % فانعم بحسن قبولها متطولا % فالشكر لا يحويه إلا منعم % PageV01P346 البحر : منسرح 1(@)(@@) % قولا لريم في حلة العرب % % إليك أشكو ما يصنع اسمك بي % % 2(@)(@@) % بما استجازت عيناك سفك دمي % % وأخذ قلبي في جملة السلب % % 3(@)(@@) % جارك أولى برعي ذمته % % إن أنت راعيت حرمة الصقب % % 4(@)(@@) % لولاك ، والدهر كله عجب % ما خفرت في ذمة العرب % 5(@)(@@) % هذا هوى ، كنت في بلهنية % عنه فيا للرجال للعجب % % 6(@)(@@) % أيسترق الكريم ذا النسب الوا % % ضح عبد مستعجم النسب % % 7(@)(@@) % ويحمل الثأر من به خور % عن احتمال الحجال والقلب % % 8(@)(@@) % نشدتك الله في احتمال دمي % % فمعشري 
ms68	 ما يفوتهم طلبي % % 9(@)(@@) % ما فات قومي آل المهلب من % % قبلي ثأر في سالف الحقب % 10(@)(@@) % فلا تريقي دما لذي أدب % يسطو بأقلامه على القضب % PageV01P347 البحر : سريع 1(@)(@@) % متى أرى الطوبان قد مهدت % % حيطانه السود المحاريث % 2(@)(@@) % ما فيه إلا ريح عاد وأج % % لاف طغام ويراغيث % % PageV01P348 البحر : طويل 1(@)(@@) % شبيهة حبات القلوب لك الهوى % % وهل لفؤاد عن سويدائه صبر % % 2(@)(@@) % على نحرك الداجي زها الدر مثلما % % زهت في دياجي الليل أنجمه الزهر % % 3(@)(@@) % لأنت شباب ما يشين سواده % % بياض مشيب ، والشباب هو لقد % % 4(@)(@@) % لقد أكثر اللوام فيك وجهلهم % % إذا عنفوني في هواك هو العذر % % PageV01P349 البحر : كامل تام 1(@)(@@) % انظر إلى الأيام ، كيف تقودنا % % قسرا إلى الإقرار بالأقدار % 2(@)(@@) % ما أوقد ابن طليب قط بداره % % نارا ، وكان هلاكها بالنار % PageV01P350 البحر : بسيط تام 1(@)(@@) % أميرنا زاهد ، والناس قد زهدوا % % له فكل على الطاعات منكمش % % 2(@)(@@) % أيامه مثل شهر الصوم طاهرة % % من المعاصي وفيها الجوع والعطش % % PageV01P351 البحر : - 1(@)(@@) % رمان مصر كأنه ذرة % % آكله شاخص من الغصص % % 2(@)(@@) % والريق فيها ، فدع سواه ، إذا % % أساغه المرء كان بالنغص % % 3(@)(@@) % وليس يرضى اللبيب عيشته % % فيها ، ولكن زريق في القفص % % PageV01P352 البحر : وافر تام 1(@)(@@) % إذا صاحبت عمرا في طريق % فقد سايرت ظلك في الطريق % 2(@)(@@) % فإن لم تلق إنسانا سواه % ترافقه ، فأنت بلا رفيق % PageV01P353 البحر : بسيط تام 1(@)(@@) % عابوا هوى شادن في رجله قصر % من سكر ألحاطه في مشيه ثمل % 2(@)(@@) % وما هوى خوط بان ماس من هيف % عيب ، وإن كان عيبا فهو محتمل % PageV01P354 البحر : وافر تام 1(@)(@@) % نزلت بأرض بالوا وهي حصن % % علا ، حتى تمنطق بالنجوم % 2(@)(@@) % بروم لا تلائمهم طباعي % % وما العربي ذو إلف بروم % % 3(@)(@@) % سلامهم هزار باريك ماذا % % شبيه سلام خزان النعيم % % 4(@)(@@) % وإن كلمتهم قالوا : اشكديم % % ولست بعالم معنى اشكديم % % 5(@)(@@) % وما تسوى لغى كوم وإن هي % % سجا ليلي بها ، وصفا نسيمى % % 6(@)(@@) % وبرد مياهها وجنى جنان % % تحيط بها ويانعة الكروم % % 7(@)(@@) % مقامي بين قوم إن تداعوا % % سمعت دعاء أصداء وبوم 
ms69	 % PageV01P355 البحر : وافر تام 1(@)(@@) % عتيق كالهلال ، إذا تبدى % % لسارى الليل من تحت الغيوم % 2(@)(@@) % تقول ، إذا به الأتراب حفوا : % أهذا البدر ما بين النجوم % % PageV01P356 البحر : بسيط تام 1(@)(@@) % يا ساكنى جنة ، رضوان خازنها % % هنيتم العيش في روح وريحان % % 2(@)(@@) % مروا النسيم إذا ما الفجر أيقظه % % بحمله طيب نشر منه أحياني % % 3(@)(@@) % أو فابعثوا نغمة منه يعيش بها % % قلبي فقد مات مذ حين وأزمان % % 4(@)(@@) % ظبي أغن تردى بالدجى وجلا % % شمس النهار على غصن من البان % % 5(@)(@@) % في فيه ما في جنان الخلد من درر % % ومن رحيق ، ومن مسك ، ومرجان % 6(@)(@@) % إذا بدا وشدا في مجلس ظفروا % % بمنية النفس من حسن وإحسان % % 7(@)(@@) % لا تنسني يا أبا نصر ، إذا حضرت % قلوبكم بين مزموم وطرخاني % % 8(@)(@@) % كن لي وكيلا على الرؤيا ووكل لي % % سواك يسمع عني شدو رضوان % % 9(@)(@@) % وقل له : يتغنى من قلائده % % صوتا يجدد لي شجوى ، وأشجاني % % 10(@)(@@) % نسيمه يتقلقاني بزورته % % مبشرا لي به من قبل يلقاني % % PageV01P357 البحر : خفيف تام 1(@)(@@) % وصفوا لي بغداد حينا فلما % % جئتها جئت أحسن البلدان % % 2(@)(@@) % منظر مبهج ، وقوم سراة % قد تحلوا بالحسن والإحسان % % 3(@)(@@) % ليس فيهم عيب سوى أن في ك % % ل بنان علاقة الميزان % % 4(@)(@@) % وسمعنا وما رأينا سوى % % أم ظلوم فيها من النسوان % % 5(@)(@@) % وهي جنية كأقبح ما ش % % وهه ربنا من الغيلان % % 6(@)(@@) % إن فيها من الصبايا شموسا % في غصون تهتز في كثبان % % 7(@)(@@) % شغلتنا السبعون والحج عنه % % ن فقلنا بالسمع دون العيان % % PageV01P358 البحر : طويل 1(@)(@@) % لقد عم جود الأفضل السيد الورى % % وأغنى غناء الغيث حيث يصوب % % 2(@)(@@) % أعدت ربيع الناس في كل بلدة % فليس بها للرائدين جدوب % % 3(@)(@@) % وجادت لهم بالمال يمناك ، إنها % % بذول على بخل الزمان وهوب % 4(@)(@@) % وفي كل حي قد خبطت بنعمة % % فحق لشأس من نداك ذنوب % PageV01P359 البحر : خفيف تام 1(@)(@@) % غرني لامع السراب وهذا ال % % حر دوني عذب المياه شروب % 2(@)(@@) % سرت أستقرىء المحول ، وفي أر % % ضي مرعى عين وواد قشيب % % 3(@)(@@) % وسحاب منه تعلمت السح 
ms70	 % % ب ، وإن لم تشبهه ، كيف تصوب % 4(@)(@@) % سوء حظ أنأى عن الملك الص % الح ، والحظ ينتهى ويثوب % 5(@)(@@) % وإلى بابه مآلي وللآ % % بق حسن القبول حين ينيب % % 6(@)(@@) % غاب عنه جسمي ، وقلبي مازا % % ل مقيما ببابه لا يغيب % % 7(@)(@@) % فإذا ما سمعت بالنازح الد % % اني فإني ذاك البعيد القريب % 8(@)(@@) % ومتى ما قربت منه فحظي % % من علاه التقريب والترحيب % 9(@)(@@) % وبما نلت من ندى الملك الصا % % لح أقسمت صادقا لا أحوب % % 10(@)(@@) % % لت أعاد من دونه وحروب % % PageV01P360 11(@)(@@) % أو يروي برؤيتي وجهه المي % % مون قلبي الصادي وطرفي السكوب % % 12(@)(@@) % ويقول الأنام آدم قد عا % % د إلى الخلد إن ذا لعجيب % % 13(@)(@@) % فحياتي ، وإن بلغت به المأ % % مول ، في غير ظله لا تطيب % 14(@)(@@) % يا أخا البيد والسرى وأخي البر % % بر إذا عقني أخ ونسيب % 15(@)(@@) % قل لغيثي الهتون في أزمة المح % % ل ، وغوثي إن أرهقتني الخطوب % 16(@)(@@) % كاشف الغمة المبر على السح % % حب بجود مدى الزمان يصوب : % 17(@)(@@) % يا ربيعي المريع حاشاك أن تم % % حل ربعي وأنت ذخري الجدوب % % 18(@)(@@) % أنا أشكو إليك دهرا لحا عو % % دى ، وأعراه ؛ فهو يبس سليب % 19(@)(@@) % وخطوبا رمى بها حادث الد % % هر سوادى ، وكلهن مصيب % 20(@)(@@) % أذهبت تالدى وطارفي الطا % % ري فضاع الموروث والمكسوب % PageV01P361 21(@)(@@) % فهو شطران بين مصر وبحر % % ذا غريق فيء وذا منهوب % % 22(@)(@@) % وإبائي أراه عن حمله المن % % ضعيفا وهو القوي الركوب % % 23(@)(@@) % ويرى كل منة لسوى الصا % % لح غلا في حمله تعذيب % 24(@)(@@) % ما اعتذار المنى إذا مطلتني % % بطلابي ، وفضلك المطلوب % 25(@)(@@) % أو ليست مصرا ، وكل بنان % لك بحر وكل عبد خصيب % % 26(@)(@@) % والندى طبعك الكريم ؛ فما أه % نى نوالا تنيله وتثيب % % 27(@)(@@) % جاءني والبعاد دوني كما جا % % بت فيافي البلاد ريح هبوب % 28(@)(@@) % وعجيب أن المواهب تسري % % ويقيم المسترفد الموهوب % 29(@)(@@) % سنة سنها ندى الملك الص % لح فيها لكل خلق نصيب % % 30(@)(@@) % من ثنائي طوى إليه الفيافي % % وهو من كل ذي اقتراب قريب % % PageV01P362 31(@)(@@) % وله بالنوال باع طويل % ويد 
ms71	 سبطة وصدر رحيب % % 32(@)(@@) % وبأيامه تبسمت الدن % يا سرورا ، فلا اعتراها قطوب % 33(@)(@@) % فأجابه بهذه القصيدة % % الن % 34(@)(@@) % يا أخلاي بالشآم لئن غب % % تم فشوقي إليكم لا يغيب % % 35(@)(@@) % غصبتنا الأيام قربكم من % % ولا بد أن ترد الغصوب % 36(@)(@@) % ولكم إن نشطتم عندنا الإ % % كرام ، والرفد ، والمحل الخصيب % 37(@)(@@) % قد علمتم بأن غيث أيادين % اعلى الناس بالنضار سكوب % 38(@)(@@) % وبنا يدرك المؤمل ما ير % % جوه قدما ، وينقذ المكروب % 39(@)(@@) % نحن كالسحب : بالبوارق والرع % % د لدينا الترغيب والترهيب % % 40(@)(@@) % تارة نسعر الحروب على النا % % اس ، وطورا بالمكرمات نصوب % PageV01P363 41(@)(@@) % كره الشام أهله فهو محق % % وق بألا يقيم فيه لبيب % % 42(@)(@@) % إن تجلت عنه الحروب قليلا % خلفتها زلازل وخطوب % % 43(@)(@@) % أن ظني والظن مثل سهام الرمي % % منها المخطي ومنها المصيب % % 44(@)(@@) % إن هذا لأن غدت ساحة القد % % س وما للإسلام فيها نصيب % % 45(@)(@@) % منزل الوحي قبل بعث رسول ال % % ه فهو المحجوج والمحجوب % % 46(@)(@@) % نزلت وسطه الخنازير والخم % % ر ، وبارى الناقوس فيها الصليب % 47(@)(@@) % لو رآه المسيح لم يرض فعلا % ذكروا أنه له منسوب % % 48(@)(@@) % أبعد الناس عن عبادة رب ال % % ناس قوم إلهم مصلوب % % 49(@)(@@) % ولعمري إن المناصح للدي % % ن على الله أجره محسوب % % 50(@)(@@) % وجهاد العدو بالفعل والقو % % ل على كل مسلم مكتوب % % PageV01P364 51(@)(@@) % ولك الرتبة العلية في الأم % % رين مذ كنت ، إذ تشب الحروب % 52(@)(@@) % أنت فيها الشجاع مالك في الطع % % ن ، ولا في الضراب يوما ضريب % 53(@)(@@) % وإذا ما حرضت فالشاعر المف % % لق فيما تقوله والخطيب % % 54(@)(@@) % % كر أن التدبير منك مصيب % 55(@)(@@) % لك رأي مذقط ، إن ضعف الرأ % ي على حاملي الصليب صليب % % 56(@)(@@) % فانهض الآن مسرعا فبأمثا % % لك ما زال يدرك المطلوب % 57(@)(@@) % والق عنا رسالة عند نور الد % % ين ، ما في إلقائها ما يريب % 58(@)(@@) % قل له ، دام ملكه ، وعليه % من لباس الإقبال برد قشيب % % 59(@)(@@) % أيها العادل الذي هو للدي % % ن شباب وللحروب شبيب % % 60(@)(@@) % والذي لم يزل قديما عن الإس % % لام بالعزم منه 
ms72	 تجلى الكروب % % PageV01P365 61(@)(@@) % وغدا منه للفرنج إذا لا % % قوه يوم من الزمان عصيب % % 62(@)(@@) % إن يرم نزف حقدهم فلأشط % % ان قناه في كل قلب قليب % 63(@)(@@) % غيرنا من يقول ما ليس يمضي % % ه بفعل وغيرك المكذوب % % 64(@)(@@) % قد كتبنا إليك فاوضح لنا الآ % % ن بما ذا عن الكتاب تجيب % % 65(@)(@@) % قصدنا أن يكون منا ومنكم % % أجل في مسيرنا مضروب % % 66(@)(@@) % فلدينا من العساكر ما ضا % % ق بأدناهم الفضاء الرحيب % % 67(@)(@@) % وعلينا أن يستهل على الشا % % م مكان الغيوث مال صبيب % % 68(@)(@@) % أو تراها مثل العروس : ثراها % % كله من دم العدا مخضوب % % 69(@)(@@) % لطنين السيوف في فلق الصب % % ح على هام أهلها تطريب % 70(@)(@@) % ولجمع الحشود من كل حصن % سلب مهمل لهم ونهوب % PageV01P366 71(@)(@@) % وبحول الإله ذاك ومن غا % % لب ربي فإنه مغلوب % % PageV01P367 البحر : بسيط تام 1(@)(@@) % يا منتهى الأمل امتدت مطارحه % % ويا حمى من إليه في الخطوب لجا % % 2(@)(@@) % هذي نتيجة فكر كان في الزمن ال % % ماضي عقيما ولولا أنت ما نتجا % % 3(@)(@@) % أتتك تحمل شكرا لوقرنت به % % لطيمة لاكتست من نشره أرجا % % PageV01P368 البحر : بسيط تام 1(@)(@@) % فيا أخا العزم يطوي البيد منصلتا % في سيره عن مسير العاصفات وحى % % 2(@)(@@) % قل للمهذب في فضل وفي خلق % % وللبليغ ، إذا ما جد أو مزحا % % 3(@)(@@) % من ينثر الدر في نثر الكتابة إنش % اء وينظمه في النظم إن مدحا % % 4(@)(@@) % من لفظه تسكر الصاحي فصاحته % % ولو وعى فضله ذو سكرة لصحا % % 5(@)(@@) % أتتك مغربة الأنباء معربة % عن مخلص ، إن دنا في الود ، أو نزحا % % 6(@)(@@) % فاسمع ، فلا زلت للخيرات مستمعا % أعجوبة مثلها في الكتب ما شرحا % % 7(@)(@@) % مولاي إن سد عني باب أنعمه % % ولم يزل للورى بالفضل منفتحا % % 8(@)(@@) % ولم يجد لي بطرف من مواهبه % % وكم حباني ، وكم أسنى لي المنحا % % 9(@)(@@) % فجوده السكب إن أكدت مخايله % % يوما فكم سح بالنعمى وكم سفحا % % 10(@)(@@) % وكم له من يد عندي تزيد على % % ما سامه الأمل المشتط واقترحا % % PageV01P369 11(@)(@@) % أقل ما نلت من جدوى يديه 
ms73	 غنى % % ما ساءني بعده من ضن أو سمحا % % 12(@)(@@) % لقد غنيت به عنه ، كما غني الغ % % دير بالسحب عنها ، بعد ما طفحا % % 13(@)(@@) % لكن بقلبي هم زاد سورته % % وهم إذا قلت يخبو زنده قدحا % % 14(@)(@@) % أظن بي العجز في الحرب العوان ، وهل % % لها سواي من الأبطال قطب رحى % % 15(@)(@@) % فقل له جدد الله البقاء له % % ما شق جيب الدجى صبح وما وضحا : % 16(@)(@@) % كم قد بعثت إلى علياك من أمل % أنلتنيه وكم من مطلب نجحا % % 17(@)(@@) % وأنت من لو حبا الدنيا بأجمعها % % لم يرضه ما حبا منها وما منحا % % 18(@)(@@) % وما سلمت فذنب الدهر معتفر % وصرفه ما جنى جرما ولا اجترحا % % PageV01P370 البحر : بسيط تام 1(@)(@@) % كناس سرب المها عريسة الأسد % % فكيف بالوصل للمستهتر الكمد % % 2(@)(@@) % والبيض دون خدور البيض مصلتة % % حكت جدول ماء غير مطرد % % 3(@)(@@) % وكل أسمر فيه لهذم ذرب % كجذوة النار لم تقبس ولم تقد % % 4(@)(@@) % إذا تسدد داوى كل ذي لدد % وإن تأود ساوى ميل ذي الأود % % 5(@)(@@) % والبيض والسمر لا تروى بغير دم % % من كل جائشة الأرجاء بالزبد % % 6(@)(@@) % صدين حتى جلاها في النحور وفي ال % % هامات أورع يروى غل كل صد % 7(@)(@@) % من أظهر الجود والإقدام إذ عدما % % إلى الوجود بضرب الهام والصفد % % 8(@)(@@) % ونفق العلم من بعد الكساد ، فما % % ترى سوى طالب للعلم مجتهد % % 9(@)(@@) % من عدله أمن الشاء المهمل في ال % % عرين أن يتوقى وثبة الأسد % 10(@)(@@) % من يلتقي المذنبين المسلمين بما % % جنوه قصدا بعفو غير مقتصد % % PageV01P371 11(@)(@@) % يسني المواهب مسرورا بها جذلا % فمنه غير ممنون ولا نكد % 12(@)(@@) % وما تذمر من غيظ ومن غضب % إلا جلا عن محيا بالحياء ند % % 13(@)(@@) % كالمشرفية فيها حسن رونقها % % في السلم والحرب والهامات والغمد % % PageV01P372 البحر : كامل تام 1(@)(@@) % يا منقذي ، ويد الزمان تنوشني % % ومقيل جدي وهو كاب عاثر % % 2(@)(@@) % حتام أنت لثقل همي حامل % ولما يهيض الدهر مني جابر % % 3(@)(@@) % ومقارع دوني الزمان وأهله % % مستلئمين وأنت فذ حاسر % % 4(@)(@@) % مهلا ، فدى لك مهجة دافعت عن % % حوبائها 
ms74	 ، إذ ليس غيرك ناصر % 5(@)(@@) % خفض عليك فللأمور نهاية % % وإلى النهاية كل شيء صائر % % PageV01P373 البحر : خفيف تام 1(@)(@@) % كل يوم فتح مبين ونصر % % واعتلاء على الأعادي وقهر % % 2(@)(@@) % قد أتاك الزمان بالعذر والإع % % تاب مما جناه إذ هو غر % % 3(@)(@@) % صدق النعت فيك ، أنت معين ال % % دين إن النعوت فأل وزجر % % 4(@)(@@) % أنت سيف الإسلام حقا ، فلا % % ل غراريك أيها السيف دهر % % 5(@)(@@) % بك زاد الإسلام يا سيفه المخ % % ذم عزا وذل شرك وكفر % % 6(@)(@@) % ثق بإدراك ما تؤمل ؛ إن ال % % له يجزي العباد عما أسروا % % 7(@)(@@) % لم تزل تضمر الجهاد مسرا % ثم أعلنت حين أمكن جهر % % 8(@)(@@) % كل ذخر الملوك يفنى وذخرا % % ك هما الباقيان : أجر وشكر % % 9(@)(@@) % للندى مالك المباح ، وما ما % % لك إلا جرد وبيض وسمر % % 10(@)(@@) % عم أهل الشآم عدلك لكن % % ا بعدنا وغاية البعد مصر % % PageV01P374 11(@)(@@) % فحرمنا من بينهم ريع ما كنا % % زرعنا ، وقال زيد ، وعمرو % % 12(@)(@@) % أمن العدل أننا في بلاد الكف % % ر شفع ، وأنت في الغزو وتر % 13(@)(@@) % كان حظي من ذاك ذكرا شنيعا % % ثم ما لي فيمن يجاهد ذكر % % 14(@)(@@) % لا تناسى من كان ظلك في العس % % ر وضيق الزمان إذ جاء يسر % % 15(@)(@@) % إن حسن الوفاء من ملك مث % % لك فضل يرويه بدو وحضر % % 16(@)(@@) % فابق واسلم وزد على رغم أعدا % % ئك جدا ما أعقب الليل فجر % % 17(@)(@@) % لا أغب الزمان قصد أعادي % % ك ولا شد من تهيضت جبر % % PageV01P375 البحر : طويل 1(@)(@@) % صديق لنا كالليل : يستر ال % % دخان ، ويبدي النور للمتنور % % 2(@)(@@) % يواري إساءاتي ، ويبدي محاسني % % ويحفظ غيبي في مغيبي ومحضري % % PageV01P376 البحر : كامل تام 1(@)(@@) % يا من يهين المال في كسب العلا % % ويرى الثناء أجل ذخر يذخر % % 2(@)(@@) % أغربت في بذل النوال وخاطب ال % % لياء ليس بضائع ما يمهر % 3(@)(@@) % وسعيت للمجد الذي في مثله % % إلا عليك حزونة وتوغر % 4(@)(@@) % وبذلت جودك للعفاة ، فما لهم % % ورد سواه ، وليس عنه مصدر % 5(@)(@@) % كم من يد أوليتنيها أثمرت % % عندي ، وما كل الأيادي تثمر 
ms75	 % 6(@)(@@) % وكرامة أبدا أبوح بشكرها % % إن الكريم على الكرامة يشكر % % 7(@)(@@) % والشكر من مثلي يزين ، وإنما % % بثناء من يثنى عليه يفخر % 8(@)(@@) % وصنائع المعروف كالوسمي : ذا % % من قطره نبت ، وهذا جوهر % PageV01P377 البحر : منسرح 1(@)(@@) % لكن مكاني من أنعم الملك الصا % % لح لا تهتدي له الغير % % 2(@)(@@) % أنهلني ، ثم علني جوده الغم % ر ، فبعدي عن بابه صدر % 3(@)(@@) % فقل لمن سره بعادي ما % % تبعد أرض يؤمها المطر % % 4(@)(@@) % ما ضرني البعد عن ندى ملك % يبلغ ما ليس يبلغ الخبر % 5(@)(@@) % يطلب طلاب جوده فلمن % % يرجو مقام وللندى سفر % % 6(@)(@@) % أبقت عطاياه لي غناي ، كما % % تبقى عقيب السحائب الغدر % % PageV01P378 البحر : وافر تام 1(@)(@@) % سأرحل عن جنابك غير قال % % بشكر يفغم الآفاق نشرا % % 2(@)(@@) % وما شكري لما أوليت كفء % % ولكني سأبلي فيه عذرا % % PageV01P379 البحر : كامل تام 1(@)(@@) % لله درك من فتى أبدت به % % أيامنا بشر الزمان العابس % % 2(@)(@@) % صدقت أماني الخير فيه ، فلم تدع % % صدرا يضم على فؤاد ا يس % 3(@)(@@) % نال العلا ، حتى أقر بفضله % وعلاه كل معاند ومنافس % 4(@)(@@) % جود كماء المزن طلق خالص % % من من منان ومنع مماكس % % 5(@)(@@) % ومواهب لو قسمت بين الورى % % ما كان يوجد فيهم من بائس % % 6(@)(@@) % وندى يد لو أنها مبسوطة % في الأرض أثمر كل عود يابس % % PageV01P380 البحر : طويل 1(@)(@@) % ومن علقت بالصالح الملك كفه % % فليس له دون العلا والغنى شرط % 2(@)(@@) % ومن دونه ، إن راب خطب ، ذوابل % وبيض وجرد لا القتادة والخرط % % 3(@)(@@) % أبارت جدودي مذ علقت بحبله % % وكان لها في خطب عشوائها له % % 4(@)(@@) % له نائل يسري إلى كل آمل % % إذا جيرة سيموا النوال فلم ينطوا % % 5(@)(@@) % على كل وجه نضرة من نواله % % وفي كل جيد من صنائعه قرط % 6(@)(@@) % وكم أمل جعد أتى اليأس دونه % % تلقاه من إنعامه نائل سبط % % 7(@)(@@) % وكنت أرجى منه ما دونه الغنى % % إذا ما غدا في كفه الرفع والحط % 8(@)(@@) % فلما ورى زند المعالي بكفه % % وقال نداه للوفود ألا حطوا % % 9(@)(@@) % نأت بي الليالي عنه ، لكن جوده 
ms76	 % % أتاني ، ولم يحجزه نأي ولا شط % 10(@)(@@) % كذا الغيث يسري طالبا كل طالب % % فكل له من فيض وابله قسط % PageV01P381 11(@)(@@) % وإنعامه كالشمس يغشى ضياؤها % % لمن زاغ ، أو حاذاه من أفقها خط % 12(@)(@@) % فأنزر حظى من مواهبه الغنى % % وأيسر تخويلي العشيرة والرهط % 13(@)(@@) % حباني نفوسا لا نفيسا من اللهى % % ونولني ما لم ينل ملك قط % % 14(@)(@@) % وماالناس إلا ا ل رزيك ؛ إنهم % % هم الذادة الشبان ، والسادة الشمط % 15(@)(@@) % بنو الحرب في يوم الوغى وبنو الندى % % إذا ما بلاد الناس جردها القحط % 16(@)(@@) % إذا ما احتبوا فالراسيات رجاحة % وإن ركبوا فالأسد هيجت ، لها نحط % 17(@)(@@) % لهم جبل ، لا زعزع الخطب ركنه % % به تؤمن الأحداث والميتة العبط % 18(@)(@@) % أقر الورى أن ليس كفئا لملكه % % سواه فقد زال التنافس والغبط % % 19(@)(@@) % فلا زالت الأقدار تجري بأمره % % وفي يده حل الممالك والربط % 21(@)(@@) % هي البدر لكن الثريا لها قرط % % ومن أنجم الجوزاء في نحرها سمط % PageV01P382 22(@)(@@) % مشت ، وعليها للغمام ظلائل % تظل ومن نسج الربيع لها بسط % % 23(@)(@@) % تؤم صريعا في الرحال كأنه % % من السقم والأيدي تقلبه خط % % 24(@)(@@) % فما اخضر ترب الأرض إلا لأنها % % عليه إذا زارت بأقدامها تخطو % % 25(@)(@@) % ولا طاب نشر الروض إلا لأنه % % يصد كما صدت ، ويعطو ، كما تعطو % % 26(@)(@@) % من البيض مثل الصبح ، ما للظلام في % % محاسنها لولا ذوائبها قسط % % 27(@)(@@) % إلى العرب الأمحاض يعزى قبيلها % % وقد ضمها في الحسن مع يوسف سبط % % 28(@)(@@) % ولما غدت كالعاج زين صدرها % % بحقين منه ، قد أجادهما الخرط % 29(@)(@@) % وأرسل فوق الخد صدغ مكلل % % كما انساب في الروضات حياتها الرقط % 30(@)(@@) % ذوائب زار الخصر منهن فاحم % % تحدر ، لا جعد النبات ، ولا سبط % 31(@)(@@) % ينافي سنا الكافور إن مشطت به % % ويخفي سواد المسك ، فهو لها و % % PageV01P383 32(@)(@@) % لما نأت عنا على كل حالة % تساوى الرضا والسخط والقرب والشحط % % 33(@)(@@) % فأذكرنا ذاك البعاد معاشرا % نأوا فكأنا ما لقيناهم قط % % 34(@)(@@) % وألقوا ، وقد شطوا ، فؤاد محبهم % % إلى بحر شوق ما للجته شط % % 35(@)(@@) % وليس تشق السفن أمواجه ولا 
ms77	 % % بساحله للعيس رفع ولا حط % 36(@)(@@) % أأحبابنا بالشام ، عفتم جوارنا % % فجاوركم في أرضها الخوف والقحط % % 37(@)(@@) % وما كان بعد النيل والنيل زاخرا % بمصر ليغنى عنكم ذلك الخط % % 38(@)(@@) % وقد عشتم فيها زمانا فما اعترى % % رضاكم بها لولا تخوفكم سخط % % 39(@)(@@) % وكنتم لنا دون الأقارب أسرة % ونحن لكم من دون رهطكم رهط % % 40(@)(@@) % وإنا أناس ، ليس يبرح جارنا % % يحكم في الأموال منا ، فيشتط % 41(@)(@@) % ويمتاحنا زوارنا فكأنما % % غدا لهم شرط علينا ولا شرط % % PageV01P384 42(@)(@@) % ويصبح بسط الكف بالمال عندنا % % وكل مليك عنده القبض والبسط % 43(@)(@@) % وتخرق شرق الأرض والغرب خيلنا % % عليها الشباب المرد ، والجلة الشمط % 44(@)(@@) % وظلماء للشهب الدراري إذا سرت % % هناك مع السارين في جنحها خبط % % 45(@)(@@) % كما أول الفجرين سقط يسل من % % حشاها ، كذاك البرق في جوها سقط % 46(@)(@@) % سللنا بها بيض السيوف فلاح في % % شباب الدجى ، لما بدا لمعها ، وخط % 47(@)(@@) % سيوف لها في كل درع وجنة % % إذا ما اعتلت قد ، أو اعترضت قط % 48(@)(@@) % ذخرنا سطاها للفرنج ؛ لأنها % % بهم دون أهل الأرض أجدر أن تسطو % % 49(@)(@@) % لهم قسطهم في الحرب منها ، وما لها % % عليهم لدى الهيجاء عدل ولا قسط % % 50(@)(@@) % وقد كاتبوا في الصلح لكن جوابهم % % بحضرتنا ما ينبت الخط لا الخط % % 51(@)(@@) % سطور خيول لا تغب ديارهم % % لها بالمواضي والقنا الشكل والنقط % PageV01P385 52(@)(@@) % وحرب لها الأرواح زاهقة لما % % تعاين والأصوات من دهش لغط % % 53(@)(@@) % إذا أرسلت فرعا من النقع فاحما % % أثيثا فأسنان الرماح لها مشط % % 54(@)(@@) % كأن القنا فيها أنامل حاسب % % أجد بها في السرعة الجمع واللقط % % 55(@)(@@) % رددنا بها ابن الفنش عنا وإنما % % يثبته في سرجه الشد والربط % 56(@)(@@) % فقولوا لنور الدين : ليس لجائف الجر % احات إلا الكي في الطب والبط % 57(@)(@@) % وحسم أصول الداء أولى لعاقل % % لبيب ، إذا استولى على المدنف الخلط % 58(@)(@@) % فدع عنك ميلا للفرنج وهدنة % بها أبدا يخطى سواهم ، ولم يخطوا % % 59(@)(@@) % تأمل ، فكم شرط شرطت عليهم % قديما ، وكم غدر به نقض الشرط % 60(@)(@@) % وشمر ، فإنا قد أعنا بكل ما % % سألت 
ms78	 ، وجهزنا الجيوش ، ولن يبطوا % % 61(@)(@@) % ودونك ، مجد الدين ، عذراء ، زفها % % إليك الوفاء المحض والكرم السبط % % PageV01P386 62(@)(@@) % هديا تهادى بين حسن وفائنا % % وإنعامنا ذا التاج زان وذا القرط % % 63(@)(@@) % على أنها تشتط إن هي ساجلت % % أجيرة قلبي ، إن تدانوا وإن شطوا % % PageV01P387 البحر : طويل 1(@)(@@) % لئن شتتت أيدي الحوادث شملنا % % فجود أبي الغارات للشمل جامع % % 2(@)(@@) % هو الملك الجزل الندى الصالح الذي % % بحار نداه كلهن شرائع % % 3(@)(@@) % يجود بلا من على عظم منه % % كأن عطاياه لديه ودائع % 4(@)(@@) % يحكم مشتط المنى في نواله % % فتعجب من جدوى يديه المطامع % PageV01P388 البحر : كامل تام 1(@)(@@) % فإليك بنت الفكر من بعد المدى % % تهدى فشرفها بحسن سماع % % 2(@)(@@) % وصداقها الإكرام لا ما سيق في % % نحل الكرائم : من لهى ومتاع % 3(@)(@@) % فهي الكريمة ، ليس في أعراقها % % عرق إلى الأطماع بالنزاع % PageV01P389 البحر : بسيط تام 1(@)(@@) % هو الجواد الذي يلقاه ما دحه % % وإن غلا فوق ما أثنى وما وصفا % % 2(@)(@@) % معذل في الندى ، لكن راحته % % تأبى مع العذل إلا البذل والسرفا % % 3(@)(@@) % صعب الإباء ، إذا ما هجت سورته % % نزر الرضا ، فإذا استعطفته عطفا % % 4(@)(@@) % بادى الحقود على أعدائه ، فإذا % % نالتهم قدرة منه حبا ، وعفا % % 5(@)(@@) % نغشى موارد من أخلاقه كرمت % وردا ونرتاد منها روضة أنفا % % 6(@)(@@) % مستهتر بالمعالي ، لا يزال على % % تقلب الدهر مشغوفا بها كلفا % % 7(@)(@@) % إن أخلف الغيث لم تخلف مواهبه % % أو فظ دهر على أبنائه لطفا % % 8(@)(@@) % عدل القضية إلا في مواهبه % % لم يقض في المال إلا جار واعتسفا % % 9(@)(@@) % تعم نعماه ذا نقص وذا شرف % كأنه البحر يحوي الدر والصدفا % % 10(@)(@@) % منزه الخلق عن فعل يعاب به % % فما ترى لكمال عنه منصرفا % % PageV01P390 البحر : بسيط تام 1(@)(@@) % من كان لي من حماه خيس ذي لبد % ضار ، ولي من نداه روضة أنف % 2(@)(@@) % من لم يزل لي من جدوى يديه غنى % وفي ذراه من الأيام لي كنف % % 3(@)(@@) % الملك الصالح الهادي الذي شهدت % % بفضل أيامه الأنباء والصحف % % 4(@)(@@) % ملك أقل عطاياه الغنى فإذا % % أدناك منه ، فأدنى حظك الشرف 
ms79	 % 5(@)(@@) % أغز أروع في كفيه سحب ندى % تمتار سحب الحيا منها ، وتغترف % 6(@)(@@) % هو الوزير الذي يأوي إلى وزر % منه الأنام فيكفوا كل ما كلفوا % % 7(@)(@@) % تريه آراؤه في يومه غده % % فيحسم الخطب فيه قبل يكتنف % 8(@)(@@) % بصيرة كشفت ما في القلوب له % % وأطلعته عليه قبل ينكشف % 9(@)(@@) % سعت إلى زهده الدنيا برغبتها % % طوعا ، وفيها على خطابها صلف % 10(@)(@@) % ولم تزف إلى كفء سواه ، وما % % زالت إلى مجده تصبو وتشترف % % PageV01P391 11(@)(@@) % حبر ، إذا الليل آواه بحندسه % % بحر من العلم طام ليس ينتزف % 12(@)(@@) % ومحرب ما أتى المحراب مبتهلا % % إلا وأدمعه من خشية تكف % 13(@)(@@) % مسهد ، وعيون الخلق هاجعة % على التجهد والقرآن معتكف % % 14(@)(@@) % وتشرق الأرض من لألاء غرته % % في دسته ، فتكاد الشمس تنكسف % 15(@)(@@) % لم يدر ما القصد في جود ويعجبه % % في بذل أمواله الإفراط والسرف % 16(@)(@@) % إذا حبا عادت الآمال راضية % وإن سطا كادت الآفاق ترتجف % % 17(@)(@@) % يأيها الملك الموفي بذمته % % ومن تجلى عن الدنيا به السدف % 18(@)(@@) % إليك يا عادلا في حكمه وعلى % % أمواله من قضايا جوده الجنف % 19(@)(@@) % أشكو زمانا قضى بالجور في ، ولم % % يزل يجور على مثلي ويعتسف % % 20(@)(@@) % لحت نوائبه عودي وأنفد مو % % جودي وشتت شملي وهو مؤتلف % % PageV01P392 21(@)(@@) % وقد دعوتك مظلوما ومرتجيا % وفي يديك الغنى ، والعدل ، والخلف % 22(@)(@@) % فاجمع بجودك شملا كان مجتمعا % فعاد بعد ائتلاف وهو مختلف % % 23(@)(@@) % وانشر بمعروفك المعروف ميتهم % % وشكر من هو بالإحسان معترف % % 24(@)(@@) % فهو القريب موالاة ومعتقدا % وإن أتت دونه الغبراء والنطف % 25(@)(@@) % وعش على رغم من يشناك مقتدرا % في دولة ما لها حد ولا طرف % % 27(@)(@@) % % في كل سمع بدا من حسنه طرف % 28(@)(@@) % نقول لما أتانا ما بعثت به % % هذا كتاب أتى ، أم روضة أنف % 29(@)(@@) % خط تنزهت الأزهار حين بدا % % كأنه الدر ، عنه فتح الصدف % 30(@)(@@) % إن نظمه طرق الأسماع كان لها % % وإن حوت عطلا من حلية ، شنف % 31(@)(@@) % رقت حواشي كلام أنت ناظمه % % فيه ، فجاء كزهر الروض يقتطف % PageV01P393 32(@)(@@) % وردت بحر القوافي فاغترقت كما 
ms80	 % % قد حل يوما بمد النيل مغترف % 33(@)(@@) % زهت على البدر نورا إذ أتت بسوا % % د النفس يشبهه من خده كلف % % 34(@)(@@) % قرطست رميا وكم رام بأسهمه % % إذا تحقق منه يسلم الهدف % % 35(@)(@@) % بخاطر فاق غزر العد لا وشل % % ولا ببرض إذا ما حل ينتزف % % 36(@)(@@) % إذا تطلع فوق الأرض ذو أدب % فأنت منه على العيوق تشترف % % 37(@)(@@) % وإن تعرى دعي من فضائله % % فأنت مدرع منها وملتحف % % 38(@)(@@) % إذا تخفى لقبح وجه قافية % % فعن قوافيك شيلت دوننا السجف % % 39(@)(@@) % لأعين الناس نهب من محاسنها % % كما القلوب تلاقيها فتختطف % % 40(@)(@@) % إذا ذكرناك مجد الدين ، عاودنا % % شوق تجدد منه الوجد والأسف % 41(@)(@@) % ودون ما قد وجدناه لفرقتكم % % يحيط بالقلب من أرجائه التلف % PageV01P394 42(@)(@@) % ولو عرفت الذي في القلب منك لما % % إن كنت عنا على الأحوال تختلف % 43(@)(@@) % ولا عجيب إذا حاف الزمان على % % حر ، وكل قضاياه بها جنف % 44(@)(@@) % فلا تكن جازعا ، إن التجاوز عن % % إنفاقك الصبر في شرع الهوى سرف % 45(@)(@@) % فإن حصلت على الصبر احتويت على % % الأجر الجزيل وفي إحرازه شرف % % 46(@)(@@) % يا من جفانا ولو قد شاء كان إلى % % جنابنا دون أهل الأرض ينعطف % 47(@)(@@) % وحق من أمه وفد الحجيج ومن % % ظلت إلى بيته الركبان تختلف % 48(@)(@@) % إنا لنوفي على حال البعاد كما % % نوفي لمن ضمه في قربنا كنف % % 49(@)(@@) % ونغفر الذنب إن رام المسيء بنا % % عفوا ، ونستره في حين ينكشف % 50(@)(@@) % وإن جنى من رأى أنا نعاقبه % % يردنا الصفح أو يعتاقنا الأنف % % 51(@)(@@) % نعم ونحفظ عند الغيب صاحبنا % % وليس يدركنا كبر ولا صلف % % PageV01P395 52(@)(@@) % فما لإيعادنا يوم الوغى ميل % ولا لموعدنا يوم الندى خلف % 53(@)(@@) % فعندنا جنة تدنو الثمار بها % % إذا دنا مجتن منها ومقتطف % % 54(@)(@@) % هدى مصاحبنا ضوء النهار وكم % % قد ضل من في الظلام الليل يعتسف % % 55(@)(@@) % فمل إلينا بآمال محققة % % وكف غرب دموع لم تزل تكف % 56(@)(@@) % كفى اغترابا ، فعجل بالإياب لنا % % فمنك لا عوض يلقى ولا خلف % % 57(@)(@@) % وقد أجبنا إلى ما أنت طالبه % % فالآن 