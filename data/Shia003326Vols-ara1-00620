ms601	 عثمان بن عاصم (1).(@)(@@) * - أبو حصين بالضم الحجري بفتح المهملة وسكون الجيم اسمه الهيثم بن شفي تقدما (2).(@)(@@) 8088 - أبو الحصين الفلسطيني مجهول من السابعة وقيل هو مروان بن رؤبة التغلبي / فق.(@)(@@) * - أبو حفص بن عمرو وقيل أبو عمرو بن حفص تقدم في عبد الله بن حفص (1).(@)(@@) * - أبو حفص بن العلاء تقدم في ترجمة عمر بن العلاء (3).(@)(@@) * - أبو حفص الأبار بالموحدة هو عمر بن عبد الرحمن تقدما (3).(@)(@@) 8089 - أبو حفص البصري شيخ السري بن يحيى مجهول من السادسة.(@)(@@) / س. PageV02P385(@)(@@) 8090 - أبو حفص الدمشقي مجهول من الخامسة قيل هو عمر الدمشقي وقيل عثمان بن أبي العاتكة / د ق.(@)(@@) * - أبو حفص الفلاس الصيرفي هو عمرو بن علي الحافظ (1).(@)(@@) 8091 - أبو حفصة مولى عائشة مقبول من الثالثة / س.(@)(@@) * - أبو حفصة أو أبو حفص الحبشي الشامي اسمه حبيش بن شريح.(@)(@@) / د (1).(@)(@@) * - أبو الحكم البجلي اسمه عبد الرحمن بن أبي نعم تقدما (2).(@)(@@) 8092 - أبو الحكم البجلي مستور من الثالثة وقيل هو الذي قبله / ت.(@)(@@) * - أبو الحكم السلمي اسمه عمران بن الحارث (1).(@)(@@) * - أبو الحكم العنزي البصري اسمه زيد بن أبي الشعثاء (2).(@)(@@) * - أبو الحكم العنزي الواسطي اسمه سيار [له ذكر في يوسف، تقدموا] (3).(@)(@@) 8093 - أبو الحكم مولى بني ليث مقبول من الثالثة / س ق.(@)(@@) 8094 - أبو حكيم والد إسماعيل قيل هو مولى عثمان مجهول من الثالثة / ت. PageV02P386(@)(@@) 8095 - أبو حلبس بفتح أوله وسكون اللام وفتح الموحدة بعدها مهملة، مجهول من مشايخ بقية من السابعة / ق.(@)(@@) * - أبو حمان بكسر أوله وتشديد الميم تقدم في حمان (1).(@)(@@) 8096 - أبو الحمراء مولى النبي صلى الله عليه وسلم وخادمه اسمه هلال بن الحارث أو ابن ظفر نزل حمص / ق (1).(@)(@@) * - أبو حمزة بن سليم اسمه عيسى (1).(@)(@@) * - أبو حمزة الأعور القصاب اسمه ميمون (2).(@)(@@) * - أبو حمزة البصري اسمه عبد الله بن حازم.(@)(@@) * - أبو حمزة الثمالي بضم المثلثة وتخفيف الميم اسمه ثابت بن أبي صفية (3).(@)(@@) * - أبو حمزة السكري المروزي اسمه محمد بن ميمون (4).(@)(@@) * - أبو حمزة الصيرفي اسمه سوار بن داود (5).(@)(@@) * - أبو حمزة العطار اسمه إسحاق بن الربيع (6).(@)(@@) * - أبو 
ms602	 حمزة القصاب بياع القصب اسمه عمران بن أبي عطاء (7).(@)(@@) * - أبو حمزة مولى الأنصار اسمه طلحة بن يزيد تقدموا (8). PageV02P387(@)(@@) * - أبو حمزة جار شعبة تقدم في عبد الرحمن بن عبد الله (9).(@)(@@) * - أبو حمزة الكوفي تقدم في سيار (10).(@)(@@) 8097 - أبو حميد الرعيني مجهول من السادسة / د.(@)(@@) 8098 - أبو حميد الساعدي صحابي مشهور اسمه المنذر بن سعد بن المنذر أو ابن مالك وقيل اسمه عبد الرحمن وقيل عمرو شهد أحدا وما بعدها، وعاش إلى أول (1) خلافة يزيد سنة ستين / ع.(@)(@@) * - أبو حميد العوهي بمهملة واو ساكنة اسمه أحمد بن محمد بن المغيرة (1).(@)(@@) * - أبو حميد المصيصي اسمه عبد الله بن محمد بن تميم تقدم (2).(@)(@@) 8099 - أبو حميد مولى مسافع قيل هو عبد الرحمن بن سعد المقعد وإلا فمجهول من الثالثة / ق.(@)(@@) 8100 - أبو حنيفة الكوفي والد عبد الأكرم مجهول من الثالثة أيضا.(@)(@@) / ق.(@)(@@) * - أبو حنيفة: النعمان بن ثابت الإمام المشهور (1).(@)(@@) * - أبو الحواري بفتح أوله وتخفيف الواو وكسر الراء اسمه زيد بن الحواري (2). PageV02P388(@)(@@) * - أبو الحوراء السعدي اسمه ربيعة بن شيبان تقدموا (3).(@)(@@) 8101 - أبو حومل ويقال بالراء بدل الواو وهو الراجح عند أبي داود، مجهول من السادسة / د.(@)(@@) * - أبو الحويرث بالتصغير الزرقي اسمه عبد الرحمن بن معاوية (1).(@)(@@) 8102 - أبو الحويرث عن عائشة إن لم يكن الذي قبله وإلا فمجهول من الثالثة / فق.(@)(@@) * - أبو حي المؤذن اسمه شداد بن حي (1).(@)(@@) * - أبو حيان بتشديد التحتانية اسمه يحيى بن سعيد بن حيان تقدموا (2).(@)(@@) 8103 - أبو حية بن قيس الوادعي الكوفي قيل اسمه عمرو بن نصر وقيل اسمه عبد الله وقيل اسمه عامر بن الحارث وقال * - أبو أحمد الحاكم وغيره لا يعرف اسمه مقبول من الثالثة / ع.(@)(@@) 8104 - أبو حية الكلبي والد أبي جناب مجهول من الرابعة / ق.(@)(@@) * - أبو حياة الحضرمي اسمه شريح بن يزيد الحمصي تقدم (1). PageV02P389(@)(@@) / حرف الخاء المعجمة * - أبو خالد الأحمر اسمه سليمان بن حيان (2).(@)(@@) * - أبو خالد الواسطي اسمه عمرو بن خالد تقدما (3).(@)(@@) 8105 - أبو خالد البجلي الأحمسي والد إسماعيل اسمه سعد أو هرمز أو كثير مقبول من الثالثة 
ms603	 / بخ د ت ق.(@)(@@) 8106 - أبو خالد الدالاني الأسدي الكوفي اسمه يزيد بن عبد الرحمن، صدوق يخطئ كثيرا وكان يدلس من السابعة / ع.(@)(@@) 8107 - أبو خالد الوالبي بموحدة قبلها كسرة الكوفي اسمه هرمز ويقال هرم مقبول من الثانية وفد على عمر وقيل حديثه عنه مرسل فيكون من الثالثة / د ت ق.(@)(@@) 8108 - أبو خالد مولى جعدة بن هبيرة المخزومي مجهول من الثالثة.(@)(@@) / د.(@)(@@) 8109 - أبو خالد شيخ لابن جريج يحتمل أن يكون الدالاني وإلا فمجهول من السادسة / د. PageV02P390(@)(@@) * - أبو خالد القرشي هو عبد العزيز بن أبان (1).(@)(@@) * - أبو خالد مهاجر بن مخلد (2).(@)(@@) * - أبو خداش بكسر أوله وآخره معجمة اسمه حبان بن زيد تقدموا (3).(@)(@@) 8110 - أبو خراش براء بدل الدال الرعيني مجهول من الثالثة / ق.(@)(@@) * - أبو خراش الأسلمي اسمه حدرد بن أبي حدرد تقدم (1).(@)(@@) 8111 - أبو خزامة بزاي قبلها كسرة بن يعمر بفتح التحتانية وسكون المهملة السعدي أحد بني الحارث بن سعد بن هذيم يقال اسمه زيد بن الحارث ويقال الحارث وكلاهما وهم وهو صحابي له حديث في الرقي وقلبه بعض الرواة / قد ت ق.(@)(@@) 8112 - أبو خزيمة العبدي البصري اسمه نصر بن مرداس وقيل صالح صدوق من كبار السابعة / ق.(@)(@@) * - أبو خزيمة المزني اسمه عمرو بن خزيمة (1).(@)(@@) * - أبو خشينة بمعجمة مصغرا اسمه حاجب بن عمر (2).(@)(@@) * - أبو الخصيب (3) اسمه زياد بن عبد الرحمن (4).(@)(@@) * - أبو الخطاب اسمه زياد بن يحيى الحساني تقدموا (5). PageV02P391(@)(@@) 8113 - أبو الخطاب الدمشقي عن رزيق اسمه حماد وهو مجهول من السابعة / ق.(@)(@@) 8114 - أبو الخطاب المصري مجهول من الثالثة / س.(@)(@@) 8115 - أبو الخطاب الهجري اسمه عمرو وقيل عمر مجهول من السابعة / ق.(@)(@@) * - أبو الخطاب البصري اسمه حميد بن يزيد تقدم (1).(@)(@@) 8116 - أبو الخطاب شيخ الليث بن أبي سليم مجهول من السادسة / ت.(@)(@@) * - أبو خلدة بسكون اللام اسمه خالد بن دينار تقدم (1).(@)(@@) 8117 - أبو خلف الأعمى نزيل الموصل خادم أنس قيل اسمه حازم بن / عطاء متروك ورماه بن معين بالكذب من الخامسة ومن زعم أنه مروان الأصفر فقد وهم ومروان أيضا 
ms604	 يكنى أبا خلف فيما قال مسلم والله أعلم / ق.(@)(@@) * - أبو خلف العمي البصري موسى بن خلف (1).(@)(@@) * - أبو خليفة أو ابن خليفة هو عبد الله بن خليفة تقدما (2).(@)(@@) 8118 - أبو خليفة الطائي البصري عن علي مقبول من الثالثة / عس.(@)(@@) * - أبو الخليل الحضرمي عبد الله بن خليل (1). PageV02P392(@)(@@) * - أبو الخليل الضبعي صالح بن أبي مريم تقدما (2).(@)(@@) 8119 - أبو خلاد صحابي يقال اسمه عبد الرحمن بن زهير ق.(@)(@@) * - أبو خيثمة زهير بن معاوية الجعفي (1).(@)(@@) * - أبو خيثمة زهير بن حرب البغدادي (2).(@)(@@) * - أبو الخير مرثد بن عبد الله اليزني تقدموا (3). PageV02P393(@)(@@) / حرف الدال المهملة * - أبو داود الأعمى اسمه نفيع (4).(@)(@@) * - أبو داود الحراني اسمه سليمان بن سيف (5).(@)(@@) * - أبو داود الحفري اسمه عمر بن سعد (6).(@)(@@) * - أبو داود السجستاني صاحب السنن اسمه سليمان بن الأشعث (7).(@)(@@) * - أبو داود السنجي سليمان بن معبد (8).(@)(@@) * - أبو داود الطيالسي اسمه سليمان بن داود (9).(@)(@@) * - أبو داود عن أبي سعيد صوابه داود السراج تقدموا (10).(@)(@@) * - أبو الدرداء تقدم في عويمر (11).(@)(@@) * - أبو الدهماء العدو البصري تقدم في قرفة (12).(@)(@@) 8120 - أبو الدهماء البصري الصغير مقبول من الثامنة / تمييز.(@)(@@) * - أبو دوس الحمصي عثمان بن عبيد تقدم (1) PageV02P394(@)(@@) حرف الذال المعجمة * - أبو ذبيان التميمي اسمه خليفة بن كعب (2).(@)(@@) 8121 - أبو ذر الغفاري الصحابي المشهور اسمه جندب بن جنادة على الأصح وقيل برير بموحدة مصغرا أو مكبر واختلف في أبيه فقيل جندب أو عشرقة أو عبد الله أو السكن تقدم () إسلامه وتأخرت هجرته فلم يشهد بدرا ومناقبه كثيرة جدا مات سنة اثنتين وثلاثين في خلافة عثمان / ع. PageV02P395(@)(@@) حرف الراء 8122 - أبو راشد الحبراني بضم المهملة وسكون الموحدة الشامي قيل اسمه أخضر وقيل النعمان ثقة من الثانية / بخ د ت ق.(@)(@@) 8123 - أبو راشد عن عمار مقبول من الثالثة / د.(@)(@@) * - أبو رافع الصائغ اسمه نفيع (1).(@)(@@) * - أبو رافع المدني القاص اسمه إسماعيل بن رافع [تقدما] (2).(@)(@@) 8124 - أبو رافع القبطي مولى رسول الله صلى الله عليه وسلم اسمه إبراهيم وقيل أسلم أو ثابت أو هرمز مات في أول خلافة علي على الصحيح / ع.(@)(@@) 8125 - أبو رافع روى 
ms605	 عنه رافع بن خديج في المزارعة يحتمل أن يكون أحد عميه اللذين روى عنهما في الصحيح واسمهما ظهير ومهير / د.(@)(@@) * - أبو رافع عن جابر أو ابن رافع أو رافع صوابه عبيد الله بن عبد الرحمن بن رافع بن خديج وقد تقدم (1) / س.(@)(@@) * - أبو الربيع الزهراني اسمه سليمان بن داود (2). PageV02P396(@)(@@) * - أبو الربيع اسمه أشعث بن سعيد (3).(@)(@@) * - أبو الربيع المهري اسمه سليمان بن داود تقدموا (4).(@)(@@) 8126 - أبو الربيع المدني مقبول من الثالثة / بخ ت.(@)(@@) 8127 - أبو ربيعة الإيادي مقبول من السادسة قيل اسمه عمر بن ربيعة / د ت ق.(@)(@@) 8128 - أبو رجاء مولى أبي بكر الصديق مجهول من الثانية / د ت * - أبو رجاء الحداني اسمه محمد بن سيف (1).(@)(@@) * - أبو رجاء الجزري اسمه محرز بن عبد الله (2).(@)(@@) * - أبو رجاء الهروي اسمه عبد الله بن واقد (3).(@)(@@) * - أبو رجاء العطاردي اسمه عمران بن ملحان (4).(@)(@@) * - أبو رجاء مولى أبي قلابة اسمه سلمان تقدموا (5).(@)(@@) 8129 - أبو رجاء عن أبي الصلت قيل هو الهروي وإلا فمجهول من طبقته / د.(@)(@@) * - أبو الرجال بكسر الراء وتخفيف الجيم الأنصاري اسمه محمد بن عبد الرحمن تقدم (1). PageV02P397(@)(@@) 8130 - أبو الرحال بفتح الراء وتشديد المهملة الأنصاري البصري اسمه محمد بن خالد وقيل خالد بن محمد ضعيف من الخامسة / ت (2).(@)(@@) 8131 - أبو الرحال الطائي الكوفي اسمه عقبة بن عبيد مقبول من الخامسة / خت (1).(@)(@@) * - أبو الرداد الليثي تقدم في رداد (1).(@)(@@) * - أبو رزين الأسدي هو مسعود بن مالك (2) / تقدم.(@)(@@) * - أبو رزين العقيلي اسمه لقيط (3) / تقدم.(@)(@@) * - أبو رزين عن علي صوابه بن زرير وهو عبد الله تقدم (4).(@)(@@) 8132 - أبو رزيق المدني مجهول من السابعة / بخ.(@)(@@) * - أبو رشدين هو كريب مولى بن عباس تقدم () 8133 - أبو رفاعة العدوي الصحابي اسمه تميم بن أسد وقيل عبد الله بن الحارث نزل البصرة يقال استشهد سنة أربع وأربعين / بخ م س.(@)(@@) * - أبو رفاعة عن أبي سعيد تقدم في رفاعة (1). PageV02P398(@)(@@) 8134 - أبو رفيع بالتصغير المخدجي بالخاء المعجمة ثم جيم ويقال اسمه رفيع مقبول من الثالثة / د س ق.(@)(@@) 8135 - أبو الرقاد بضم أوله 
ms606	 ثم قاف خفيفة النخعي الكوفي مقبول من السادسة / عس.(@)(@@) 8136 - أبو رمثة بكسر الراء وسكون الميم بعدها مثلثة البلوي ويقال التيمي ويقال التميمي ويقال هما اثنان قيل اسمه رفاعة بن يثربي ويقال عكسه ويقال عمارة بن يثربي ويقال حيان بن وهيب وقيل جندب وقيل خشخاش صحابي قال ابن سعد مات بإفريقية / د ت س.(@)(@@) * - أبو رملة هو عامر (1).(@)(@@) * - أبو رهم السمعي هو أحزاب (2).(@)(@@) * - أبو رهم الغفاري هو كلثوم (3).(@)(@@) * - أبو رواحة الشامي هو يزيد بن أيهم (4).(@)(@@) * - أبو روح الشامي هو شبيب بن نعيم (5).(@)(@@) * - أبو روح العتكي هو عبد الرحمن بن قيس (6).(@)(@@) * - أبو روق الهمداني هو عطية بن الحارث (7).(@)(@@) * - أبو ريحانة المدني هو شمعون (8). PageV02P399(@)(@@) * - أبو ريحانة السعدي هو عبد الله بن مطر تقدموا (9).(@)(@@) 8137 - أبو ريمة بكسر أوله وسكون التحتانية صحابي له حديث هكذا ضبطه بن منده وتبعه المزي والذي في نسخ أبي داود * - أبو رمثة وهو المتقدم.(@)(@@) / د. PageV02P400(@)(@@) حرف الزاي * - أبو الزاهرية هو حدير بن كريب تقدم (1) * - أبو زائد في أبي زيد (2) * - أبو زبيد هو عبثر بن القاسم (3) * - أبو الزبير المكي هو محمد بن مسلم (4) * - أبو زرارة المصري هو ليث بن عاصم تقدموا (5) 8138 - أبو زرعة بن عمرو بن جرير بن عبد الله البجلي الكوفي قيل اسمه هرم وقيل عمرو وقيل عبد الله وقيل عبد الرحمن وقيل جرير ثقة من الثالثة / ع.(@)(@@) * - أبو زرعة الدمشقي الحافظ هو عبد الرحمن بن عمرو (1) * - أبو زرعة الرازي الحافظ هو عبيد الله بن عبد الكريم (2) * - أبو زرعة السيباني بالمهملة هو يحيى بن أبي عمرو تقدموا (3) PageV02P401(@)(@@) 8139 - أبو زرعة عن أبي إدريس الخولاني قيل هو ابن عمرو بن جرير وإلا فهو مجهول من الخامسة / ت.(@)(@@) * - أبو الزعراء الأزدي الأكبر اسمه عبد الله بن هانئ (1) * - أبو الزعراء الجشمي الأصغر هو عمرو بن عمرو (2) * - أبو الزعراء الطائي هو يحيى بن الوليد (3) * - أبو زكير بالتصغير يحيى بن محمد بن قيس (4) * - أبو زميل بالتصغير هو سماك بن الوليد (5) * - أبو الزناد هو عبد الله بن ذكوان (6) * - أبو زهير هو عبد الرحمن 
ms607	 بن مغراء (7) * - أبو زهير الأزدي هو العلاء بن زهير تقدموا (8) * - أبو زهير تقدم في أبي الأزهر (9) 8140 - أبو زهير الثقفي هو معاذ بن رباح وقيل هو ابن معاذ بن رباح وقيل اسمه عمار بن حميد وقيل عمارة بن روبية صحابي له حديث / ق.(@)(@@) * - أبو زياد الشامي هو خيار بن سلمة أو ابن سلامة تقدم (1) PageV02P402(@)(@@) 8141 - أبو زياد الشامي الغساني آخر اسمه يحيى بن عبيد مقبول من السادسة / تمييز.(@)(@@) 8142 - أبو زياد الكلابي اللغوي قيل اسمه يزيد بن عبد الله بن الحارث مقبول من العاشرة / د.(@)(@@) * - أبو زيادة هو عبيد الله بن زيادة (1) * - أبو زيد الأنصاري هو عمرو بن أخطب (2) * - أبو زيد الأنصاري النحوي سعيد بن أوس تقدموا (3) 8143 - أبو زيد المخزومي مولى عمرو بن حريث وقيل أبو زائد مجهول من الثالثة / د ت ق.(@)(@@) * - أبو زيد الهروي هو سعيد بن الربيع تقدم (1) 8144 - أبو زيد مولى بني ثعلبة قيل اسمه الوليد مجهول من الرابعة / د ق.(@)(@@) 8145 - أبو زيد عن أبي المغيرة مجهول من السابعة وقيل هو عبد الملك بن ميسرة / ق.(@)(@@) 8146 - أبو زيد شيخ لأبي الجهم مجهول من الثالثة / س.(@)(@@) 8147 - أبو زينب مولى حازم بن حرملة الغفاري مجهول من الرابعة / ق. PageV02P403(@)(@@) حرف السين المهملة * - أبو ساسان هو حضين بن المنذر * - أبو سالم الجيشاني هو سفيان بن هانئ تقدما (1) 8148 - أبو (1) السائب الأنصاري المدني مولى بن زهرة يقال اسمه عبد الله بن السائب ثقة من الثالثة / م 4.(@)(@@) * - أبو السائب هو سلم بن جنادة (1) * - أبو سبأ بالموحدة التنوخي هو عتبة بن تميم تقدما (2) / مد.(@)(@@) 8149 - أبو سبرة بسكون الموحدة النخعي الكوفي يقال اسمه عبد الله بن عابس مقبول من الثالثة / د ت ق.(@)(@@) 8150 - أبو سخيلة بالمعجمة مصغرا مجهول من الثالثة / عس.(@)(@@) * - أبو سروعة بكسر أوله وسكون الراء وفتح الواو بعدها هو عقبة بن الحارث وقيل أخوه (1) * - أبو سريحة بفتح أوله وكسر الراء هو حذيفة بن أسيد تقدما (2) PageV02P404(@)(@@) 8151 - أبو سعد بن أبي فضالة بفتح الفاء والمعجمة الخفيفة ويقال 
ms608	 أبو سعيد بن فضالة بن أبي فضالة صحابي له حديث / ت ق.(@)(@@) * - أبو سعد الأزدي الكوفي قارئ الأزد ويقال أبو سعيد مقبول من الثالثة / ت ق.(@)(@@) * - أبو سعد هو شرحبيل بن سعد تقدم (1) * - أبو سعد الأنصاري يأتي في أبي سعيد (2) * - أبو سعد البقال هو سعيد بن المرزبان تقدم (3) 8153 - أبو سعد الحميري الحمصي ويقال أبو سعيد مجهول من الرابعة / د ق.(@)(@@) 8154 - أبو سعد الساعدي مجهول من الخامسة / ق.(@)(@@) * - أبو سعد الصغاني هو محمد بن ميسر تقدم / ق (1).(@)(@@) * - أبو سعد المدني عن أبي رافع قيل هو شرحبيل بن سعد / ق (2).(@)(@@) * - أبو سعد المكي الأعمى مجهول من الثالثة / ق.(@)(@@) * - أبو سعد الخير ويقال * - أبو سعيد الحبراني يأتي (1) * - أبو سعيد بن رافع المدني مقبول من الرابعة / قد س. PageV02P405(@)(@@) 8157 - أبو سعيد بن المعلى الأنصاري المدني يقال اسمه رافع بن أوس وقيل الحارث ويقال بن نفيع صحابي مات سنة ثلاث وسبعين وقيل غير ذلك / خ د س ق.(@)(@@) 8158 - أبو سعيد بن أبي المعلى ويقال بن المعلى المدني مقبول من الثالثة / ت.(@)(@@) * - أبو سعيد الأزدي في أبي سعد (1) 8159 - أبو سعيد الأزدي مقبول من الثالثة / د.(@)(@@) * - أبو سعيد الأشج هو عبد الله بن سعيد (1) * - أبو سعيد البراد هو أسيد بن أبي أسيد (2) * - أبو سعيد الجعفي هو يحيى بن سليمان تقدموا (3) 8160 - أبو سعيد الأنصاري ويقال أبو سعد يقال هو عمر بن حفص بن ثابت الحلبي مقبول من العاشرة / س.(@)(@@) 8161 - أبو سعيد الحبراني بضم المهملة وسكون الموحدة الحمصي اسمه زياد وقيل عامر وقيل عمر مجهول من الثالثة / د ق.(@)(@@) 8162 - أبو سعيد الخير بفتح المعجمة وسكون التحتانية الأنماري صحابي له حديث وقد وهم من خلطه بالذي قبله ووهم أيضا من صحف الذي قبله به / تمييز. PageV02P406(@)(@@) 8163 - أبو سعيد الحميري شامي مجهول من الثالثة وروايته عن معاذ بن جبل مرسلة / د ق.(@)(@@) * - أبو سعيد الخدري هو سعد بن مالك (1) * - أبو سعيد الرعيني هو جعثل بالجيم والمثلثة بن هاعان تقدما (2) 8164 - أبو سعيد الزرقي الأنصاري 
ms609	 وقيل أبو سعد صحابي اسمه عمارة بن سعيد أو بالعكس وصححه بن حبان وقيل عامر بن مسعود وهو خطأ وجزم بن حبان بأنه أبو سعيد الخير المذكور قبل / س ق.(@)(@@) 8165 - أبو سعيد الشامي عن وراد مولى المغيرة بن شعبة قيل هو كثير رضيع عائشة وقيل عمرو بن سعيد الثقفي وقيل عبد ربه وقيل هو الحسن البصري وقيل آخر مجهول لا يعرف اسمه من السادسة / م.(@)(@@) 8166 - أبو سعيد الشامي عن تثبت مجهول من السابعة / ق.(@)(@@) * - أبو سعيد المقبري هو كيسان (1) * - أبو سعيد المؤدب هو محمد بن مسلم (2) * - أبو سعيد مولى بني هاشم هو عبد الرحمن بن عبد الله تقدموا (3) 8167 - أبو سعيد مولى بن عامر الخزاعي مقبول من الرابعة / م س ق.(@)(@@) 8168 - أبو سعيد مولى المهري مقبول من الثالثة / م د ت س. PageV02P407(@)(@@) 8169 - أبو سعيد عن عبد الملك الزبيري مجهول من السابعة / ق.(@)(@@) * - أبو السفر بفتحتين هو سعيد بن يحمد (1) * - أبو سفيان هو صخر بن حرب (2) * - أبو سفيان بن عبد ربه هو عبد الرحمن تقدموا (3) 8170 - أبو سفيان بن سعيد بن المغيرة بن الأخنس الثقفي المدني مقبول من الثالثة / د س (1).(@)(@@) * - أبو سفيان الأصبهاني هو صالح بن مهران (1) * - أبو سفيان الألهاني هو محمد بن زياد (2) * - أبو سفيان الحميري هو سعيد بن يحيى (3) * - أبو سفيان السعدي هو طريف بن شهاب (4) * - أبو سفيان المعمري هو محمد بن حميد (5) * - أبو سفيان عن جابر هو طلحة بن نافع تقدموا (6) 8171 - أبو سفيان مولى بن أبي أحمد قيل اسمه وهب وقيل قزمان ثقة من الثالثة / ع. PageV02P408(@)(@@) 8172 - أبو سفيان عن عمرو بن حريش مقبول من السادسة / د.(@)(@@) * - أبو السكين الطائي هو زكريا بن يحيى تقدم (1) 8173 - أبو سكينة الحمصي قيل اسمه محلم مختلف في صحبته له حديث / د س.(@)(@@) 8174 - أبو سلمان الليثي قيل اسمه همام مقبول من الثالثة / س.(@)(@@) 8175 - أبو سلمان مؤذن الحجاج آخر مقبول من الثالثة أيضا / تمييز.(@)(@@) 8176 - أبو سلمى راعي النبي صلى الله عليه وسلم صحابي قيل 
ms610	 اسمه حريث / س.(@)(@@) * - أبو سلمة بن سفيان المخزومي اسمه عبد الله (1) * - أبو سلمة بن عبد الأسد المخزومي هو عبد الله تقدما (2) 8177 - أبو سلمة بن عبد الرحمن بن عوف الزهري المدني قيل اسمه عبد الله وقيل إسماعيل ثقة مكثر من الثالثة مات سنة أربع وتسعين أو أربع ومائة وكان مولده سنة بضع وعشرين / ع.(@)(@@) 8178 - أبو سلمة بن نبيه بنون وموحدة مصغرا المدني مجهول من السابعة / د.(@)(@@) * - أبو سلمة الشحام البصري هو عثمان (1) PageV02P409(@)(@@) * - أبو سلمة التبوذكي هو موسى بن إسماعيل (2) * - أبو سلمة الحمصي هو سليمان بن سليم (3) * - أبو سلمة الحنفي البصري هو الربيع بن حبيب (4) * - أبو سلمة الربيع بن حبيب (5) * - أبو سلمة الخراساني هو المغيرة بن مسلم السراج (6) * - أبو سلمة الخزاعي هو منصور بن سلمة تقدموا (7) 8179 - أبو سلمة الحمصي عن بلال مجهول من الثالثة / ق.(@)(@@) 8180 - أبو سلمة العاملي الشامي هو الحكم بن عبد الله بن خطاف وقيل اسمه عبد الله بن سعد متروك ورماه أبو حاتم بالكذب من السابعة / ق.(@)(@@) 8181 - أبو سلمة الكندي شيخ لزيد بن الحباب مجهول من السابعة / ت.(@)(@@) * - أبو سلمة هو يحيى بن المغيرة (1) * - أبو السليل هو ضريب بن نقير (2) * - أبو سليمان الجهني هو زيد بن وهب (3) PageV02P410(@)(@@) * - أبو سليمان العصري هو خليد بن عبد الله (4) * - أبو السمح بسكون الميم هو دراج تقدموا (5) 8182 - أبو السمح خادم رسول الله صلى الله عليه وسلم قيل اسمه إياد صحابي له حديث واحد قطعه بعضهم / د س ق.(@)(@@) 8183 - أبو سمية بالتصغير عن جابر مقبول من الرابعة / ق.(@)(@@) 8184 - أبو السنابل بنون خفيفة ثم موحدة ثم لام بن بعكك بموحدة وزن جعفر وبعكك هو ابن الحارث بن عميلة بالفتح بن السباق بن عبد الدار القرشي قيل اسمه عمرو وقيل لبيد ربه وقيل حبة بالموحدة وقيل بالنون ويقال عامر ويقال أصرم صحابي مشهور / ت (2) س ق.(@)(@@) * - أبو سنان الدؤلي هو يزيد بن أمية (1) * - أبو سنان الشيباني الأكبر هو ضرار بن مرة (2) * - أبو سنان الشيباني الأصغر هو سعيد بن سنان 
ms611	 (3) * - أبو سنان القسملي هو عيسى بن سنان (4) * - أبو سهل هو كثير بن زياد (5) * - أبو سهل عن الشعبي هو محمد بن سالم تقدموا (6) PageV02P411(@)(@@) 8185 - أبو سهل شيخ لداود بن سليك مجهول من الرابعة / قد.(@)(@@) * - أبو سهل الأنصاري هو محمد بن عمرو (1) * - أبو سهلة هو السائب بن خلاد تقدما (2) 8186 - أبو سهلة مولى عثمان بن عفان ويقال بالمعجمة ثقة من الثالثة / ت ق.(@)(@@) * - أبو سهم يأتي في المعجمة (1) * - أبو سهيل بن مالك بن أبي عامر الأصبحي اسمه نافع (2) * - أبو السوار العنبري هو عبد الله بن قدامة تقدما (3) 8187 - أبو السوار العدوي البصري قيل اسمه حسان بن حريث وقيل بالعكس وقيل حريف آخره فاء وقيل منقذ وقيل حجير بن الربيع ثقة من الثانية / خ م س.(@)(@@) * - أبو السوداء النهدي هو عمرو بن عمران تقدم (1) * - أبو السوداء عن ابن عمر مقبول من الرابعة / س.(@)(@@) * - أبو سودة يأتي قريبا (1) 8189 - أبو سورة بفتح أوله وسكون الواو بعدها راء الأنصاري ابن أخي أبي أيوب ضعيف من الثالثة / د ت ق. PageV02P412(@)(@@) 8190 - أبو سويد أو أبو سودة بفتح أوله وكسر الواو وتشديد التحتانية بصري هو عبيد بن سوية وقيل بن حميد ومن قال فيه أبو سودة فقد وهم / د.(@)(@@) * - أبو سلام الأسود الحبشي هو ممطور (1) * - أبو سلام الحنفي هو عبد الملك بن مسلم تقدما (2) 8191 - أبو سلام خادم رسول الله صلى الله عليه وسلم كذا وقع والصواب: عن أبي سلام وهو ممطور المذكور عن رجل خدم النبي صلى الله عليه وسلم / ق.(@)(@@) * - أبو سلامة في خداش بالمعجمتين (1) / ق.(@)(@@) 8192 - أبو سيارة بتشديد التحتانية المتعي بضم الميم وفتح المثناة بعدها صحابي قيل اسمه عميرة بن الأعزل وقيل عمر وقيل عمير وقيل الحارث بن مسلم / ق (1). PageV02P413(@)(@@) حرف الشين المعجمة * - أبو شجاع هو سعيد بن يزيد (1) * - أبو شجرة هو كثير بن مرة تقدما (2) 8193 - أبو شريح الخزاعي الكعبي اسمه خويلد بن عمرو أو عكسه وقيل عبد الرحمن بن عمرو وقيل هانئ وقيل كعب صحابي نزل المدينة مات سنة ثمان وستين 
ms612	 على الصحيح / ع.(@)(@@) * - أبو شريح الكندي هو هانئ بن يزيد (1) * - أبو شريح المعافري هو عبد الرحمن بن شريح تقدما (2) 8194 - أبو شريح عن أبي مسلم العبدي مقبول من السادسة / ق.(@)(@@) 8195 - أبو شعبة المزني (1) مولاهم الكوفي مقبول من الثالثة / بخ م س.(@)(@@) * - أبو الشعثاء بالمثلثة هو جابر بن زيد (1) * - أبو الشعثاء المحاربي هو سليم بن أسود (2) PageV02P414(@)(@@) * - أبو شعيب المجنون هو الصلت بن دينار تقدموا (3) * - أبو شعيب صاحب الطيالسة هو شعيب تقدم في الأسماء (4) 8196 - أبو الشمال بكسر أوله وتخفيف الميم مجهول من الثالثة / ت.(@)(@@) 8197 - أبو شمر بكسر أوله وسكون الميم الضبعي البصري مقبول من الرابعة / م س.(@)(@@) 8198 - أبو الشموس البلوي صحابي له حديث / خت.(@)(@@) * - أبو شهاب الحناط بالنون هو موسى بن نافع (1) * - أبو شهاب الحناط آخر وهو الأصغر اسمه عبد ربه بن نافع تقدما (2) 8199 - أبو شهم بالمعجمة وقيل بالمهملة صحابي نزل الكوفة يقال اسمه يزيد بن أبي شيبة / س.(@)(@@) 8200 - أبو شهم عن أبي هريرة كذا وقع والصواب أبو سلمة وهو ابن عبد الرحمن / ق.(@)(@@) * - أبو شيبة بن أبي شيبة هو إبراهيم بن عبد الله (1) * - أبو شيبة الجوهري هو يوسف بن إبراهيم (2) * - أبو شيبة هو يحيى بن يزيد (3) PageV02P415(@)(@@) * - أبو شيبة الزبيدي هو سعيد بن عبد الرحمن (4) * - أبو شيبة الكبير هو إبراهيم بن عثمان (5) * - أبو شيبة هو يحيى بن عبد الرحمن الكندي (6) * - أبو شيبة الواسطي هو عبد الرحمن بن إسحاق تقدموا (7) 8201 - أبو شيبة عن عبد الله بن عكيم يحتمل أن يكون أحد هؤلاء والا فمجهول من السادسة / ت ق.(@)(@@) 8201 - أبو شيخ الهنائي بضم الهاء وتخفيف النون البصري قيل اسمه حيوان بالمهملة أو المعجمة بن خالد وهو ثقة من الثالثة / د س. PageV02P416(@)(@@) حرف الصاد المهملة 8203 - أبو صادق الأزدي الكوفي قيل اسمه مسلم بن يزيد وقيل عبد الله بن ناجد صدوق وحديثه عن علي مرسل من الرابعة / س ق.(@)(@@) 8204 - أبو صالح الأشعري الشامي مقبول من الثالثة / ق.(@)(@@) 8205 - أبو صالح الأشعري أو الأنصاري عن أبي أمامة 
ms613	 قيل هو الذي قبله والا فمجهول من الخامسة / فق.(@)(@@) * - أبو صالح غالبا الليث هو عبد الله بن صالح (1) * - أبو صالح الحراني هو عبد الغفار بن داود تقدما (2) 8206 - أبو صالح الحارثي وقيل الخازن أو الحادي مقبول من الخامسة / س.(@)(@@) * - أبو صالح الحنفي هو عبد الرحمن بن قيس تقدم (1) 8207 - أبو صالح الحنفي آخر اسمه سميع الزيات مقبول من السادسة / تمييز.(@)(@@) 8208 - أبو صالح الخوزي لين الحديث من الثالثة / بخ ت ق. PageV02P417(@)(@@) * - أبو صالح السمان هو ذكوان (1) * - أبو صالح الغفاري هو سعيد بن عبد الرحمن (2) * - أبو صالح بن زنبور اسمه محمد (3) * - أبو صالح مولى التوأمة اسمه نبهان تقدموا (4) 8209 - أبو صالح مولى طلحة أو أم سلمة مقبول من الثالثة يقال اسمه زاذان / ت.(@)(@@) 8210 - أبو صالح مولى عثمان مقبول من الثالثة اسمه الحارث ويقال تركان بمثناة أوله ثم راء ساكنة / ت س (1).(@)(@@) * - أبو صالح الكوفي اسمه ميسرة (1) * - أبو صالح مولى أم هانئ اسمه باذان ويقال ذكوان تقدما (2) 8211 - أبو صالح مولى ضباعة لين الحديث من الثالثة (1) واسمه مينا بكسر الميم وسكون التحتانية بعدها نون / ت.(@)(@@) * - أبو صالح عن ابن عباس اسمه ميزان تقدم (1) * - أبو صالح عن ابن زرير صوابه أبو أفلح (2) PageV02P418(@)(@@) * - أبو صالح صاحب بن المبارك سلمويه واسمه سليمان تقدم (3) * - أبو الصباح الأيلي اسمه سعدان بن سالم (4) * - أبو الصباح مولى إبراهيم اسمه سليمان بن بشير.(@)(@@) * - أبو الصباح الرعيني اسمه محمد بن شمير (5) * - أبو صخر الأيلي هو يزيد بن أبي سمية (6) * - أبو صخر الخراط هو حميد بن زياد (7) * - أبو صخرة هو جامع بن شداد (8) * - أبو صدقة العجلي هو سليمان بن كندير (9) * - أبو صدقة مولى أنس اسمه توبة بالمثناة (10) * - أبو الصديق بتشديد الدال المكسورة هو بكر بن عمرو الناجي بالنون والجيم تقدموا (1) 8212 - أبو صرمة بكسر أوله وسكون الراء المازني الأنصاري صحابي اسمه مالك بن قيس وقيل قيس بن صرمة وكان شاعرا / بخ م 4.(@)(@@) * - أبو الصعبة هو عبد العزيز بن أبي الصعبة تقدم (1) * - أبو صفوان الأموي هو عبد الله بن سعيد (2) PageV02P419(@)(@@) * - أبو صفوان 
ms614	 عن ابن عباس اسمه مهران تقدما (3) * - أبو صفوان بن عميرة في سويد بن قيس.(@)(@@) 8213 - أبو الصلت الثقفي مقبول من الثانية / قد (1).(@)(@@) 8214 - أبو الصلت عن أبي هريرة مجهول من الثالثة / ق.(@)(@@) * - أبو الصلت الهروي هو عبد السلام بن صالح تقدم (1) 8215 - أبو الصلت شيخ لأبي رجاء قيل هو شهاب بن خراش والا فمجهول من السادسة / د.(@)(@@) 8216 - أبو الصهباء الكوفي مقبول من السادسة / ت فق.(@)(@@) * - أبو الصهباء مولى بن عباس اسمه صهيب (1) * - أبو صيفي الواسطي اسمه بشير بن ميمون تقدما (2) PageV02P420(@)(@@) حرف الضاد المعجمة * - أبو الضحى هو مسلم بن صبيح تقدم (3) 8217 - أبو الضحاك عن أبي هريرة مقبول من الثالثة / فق.(@)(@@) * - أبو ضمرة المدني هو أنس بن عياض تقدم (1) PageV02P421(@)(@@) حرف الطاء المهملة 8218 - أبو طارق السعدي البصري مجهول من السابعة / ت.(@)(@@) * - أبو طالب هو زيد بن أخزم (1) تقدم.(@)(@@) 8219 - أبو طالوت الشامي مجهول من الخامسة / ت.(@)(@@) * - أبو طالوت بن أبي حازم اسمه عبد السلام (1) * - أبو الطاهر بن السرح هو أحمد بن عمرو تقدما (2) 8220 - أبو طريف مولى عبد الرحمن بن طلحة مجهول من الثالثة / قد.(@)(@@) 8221 - أبو طريف آخر صحابي هذلي لا يعرف اسمه وقيل اسمه كيسان وقيل سنان ووهم من خلطه بالذي قبله / تمييز.(@)(@@) 8222 - أبو طعمة بضم أوله وسكون المهملة شامي سكن مصر وكان مولى عمر بن عبد العزيز يقال اسمه هلال مقبول من الرابعة ولم يثبت أن مكحولا رماه بالكذب / د س ق.(@)(@@) * - أبو طعمة هو نسير بن ذعلوق في النون (1) PageV02P422(@)(@@) 8223 - أبو طعمة شيخ ليحيى بن أبي كثير قيل هو هلال المذكور أولا والا فمجهول من الثالثة / د س.(@)(@@) * - أبو الطفيل عامر بن واثلة (1) * - أبو طلحة الأنصاري زيد بن سهل (2) * - أبو طلحة الأنماري نعيم بن زياد تقدموا (3) 8224 - أبو طلحة الأسدي مقبول من الرابعة / د.(@)(@@) 8225 - أبو طلحة الخولاني مقبول من الثالثة وحديثه عن النبي صلى الله عليه وسلم مرسل وقد قيل اسمه سفيان بن عبد الله / ت.(@)(@@) 8226 - أبو طلحة الخولاني نزيل مصر مقبول من 
ms615	 الثانية وقد اختلف في صحبته واسمه ذرع بالمعجمة أو المهملة ولعله الذي قبله / تمييز.(@)(@@) * - أبو طلحة الراسبي هو شداد بن سعيد تقدم (1) * - أبو طهفة الغفاري في طهفة (2) * - أبو طوالة بضم أوله وتخفيف ثانيه هو عبد الله بن عبد الرحمن (3) الأنصاري تقدم.(@)(@@) * - أبو طيبة الكلاعي ويقال بالمعجمة (4) * - أبو طيبة المروزي هو عبد الله بن مسلم تقدم (5) PageV02P423(@)(@@) حرف الظاء المعجمة * - أبو ظبيان الجنبي هو حصين بن جندب تقدم (6) 8227 - أبو ظبيان القرشي عن عمر مجهول من الثانية / تمييز (1).(@)(@@) 8228 - أبو ظبية بفتح أوله وسكون الموحدة بعدها تحتانية ويقال بمهملة وتقديم التحتانية والأول أصح السلفي بضم المهملة الكلاعي بفتح الكاف نزل حمص مقبول من الثانية / بخ د س ق.(@)(@@) * - أبو ظفر بفتحتين هو عبد السلام بن مطهر (1) * - أبو ظلال بكسر أوله والتخفيف هو هلال بن أبي هلال (2) PageV02P424(@)(@@) حرف العين المهملة 8229 - أبو عاتكة البصري أو الكوفي اسمه طريف بن سلمان أو بالعكس ضعيف وبالغ السليماني فيه من الخامسة / ت.(@)(@@) 8230 - أبو عازب الكوفي اسمه مسلم بن عمرو أو ابن أراك مستور من الرابعة / ق.(@)(@@) * - أبو عاصم الثقفي هو محمد بن أبي أيوب (1) * - أبو عاصم الحنفي هو أحمد بن جواس تقدما.(@)(@@) 8231 - أبو عاصم العباداني البصري اسمه عبد الله بن عبيد الله أو بالعكس ويقال بن عبد بغير إضافة لين الحديث من الثامنة / ق.(@)(@@) 8232 - أبو عاصم الغنوي بالمعجمة والنون مقبول من الخامسة / د.(@)(@@) * - أبو عاصم النبيل هو الضحاك بن مخلد (1) * - أبو عاصم بن أصرم هو خشيش بمعجمات مصغرا (2) * - أبو العالية الرياحي بالتحتانية هو رفيع تقدموا (3) 8233 - أبو العالية البراء بالتشديد البصري اسمه زياد وقيل كلثوم PageV02P425(@)(@@) وقيل أذينة وقيل بن أذينة ثقة من الرابعة مات في شوال سنة تسعين / خ م س.(@)(@@) 8234 - أبو عامر الأشعري صحابي اسمه عبد الله وقيل عبيد بن هانئ أو ابن وهب عاش إلى خلافة عبد الملك / خت ت.(@)(@@) 8235 - أبو عامر الأشعري صحابي آخر اسمه عبيد وهو عم أبي موسى الأشعري استشهد بحنين / تمييز.(@)(@@) * - أبو عامر الألهاني اسمه 
ms616	 عبد الله بن عامر (1) * - أبو عامر الأوصابي اسمه لقمان بن عامر تقدما (2) 8236 - أبو عامر الحجري بفتح المهملة وسكون الجيم المصري اسمه عبد الله بن جابر وقيل اسمه عامر والصحيح أبو عامر مقبول من الثالثة / د س.(@)(@@) * - أبو عامر العقدي اسمه عبد الملك بن عمرو (1) * - أبو عامر الخزاز بمعجمات هو صالح بن رستم (2) * - أبو عامر الهوزني هو عبد الله بن لحي تقدموا (3) 8237 - أبو عائذ الله بن ربيعة أو ابن عبد الله بن ربيعة هو إبراهيم بن عبد الله والا فمجهول قاله الذهلي من الثالثة / س.(@)(@@) 8238 - أبو عائشة الأموي مولاهم جليس أبي هريرة مقبول من الثانية / د. PageV02P426(@)(@@) * - أبو عباد الضبعي هو يحيى بن عباد (1) * - أبو عبادة بضم أوله والتخفيف الزرقي هو عيسى بن عبد الرحمن تقدما (2) 8239 - أبو عبادة الزرقي آخر لا يعرف اسمه مدني من الثالثة / تمييز.(@)(@@) * - أبو العباس الشاعر الأعمى هو السائب بن فروخ تقدم (1) 8240 - أبو العباس القلوري بكسر القاف وتشديد اللام المفتوحة وسكون الواو بعدها راء العصفري البصري اسمه أحمد وقيل محمد بن عمرو بن العباس بن عبيدة وقيل عبدك ثقة من الحادية عشرة مات سنة ثلاث وستين / د.(@)(@@) 8241 - أبو عبد الله الأشعري الشامي ثقة من الثانية / د ق.(@)(@@) * - أبو عبد الله الأغر هو سلمان.(@)(@@) * - أبو عبد الله الألهاني هو رزيق (1) * - أبو عبد الله البراد هو سالم (2) * - أبو عبد الله البصري هو ميمون تقدموا (3) 8242 - أبو عبد الله التميمي من ولد أبي هالة مجهول من السادسة قيل اسمه يزيد بن عمر / تم. PageV02P427(@)(@@) 8243 - أبو عبد الله الجدلي اسمه عبد أو عبد الرحمن بن عبد ثقة رمي بالتشيع من كبار الثالثة / د ت س.(@)(@@) * - أبو عبد الله الجسري اسمه حميري (1) * - أبو عبد الله الشقري اسمه سلمة بن تمام (2) * - أبو عبد الله القراظ اسمه دينار تقدموا (3) 8244 - أبو عبد الله الجشمي بضم الجيم وفتح المعجمة شيخ لسعيد الجريري مجهول من الثالثة / د.(@)(@@) 8225 - أبو عبد الله الدوسي بن عم أبي هريرة مقبول من الثالثة قيل اسمه 
ms617	 عبد الرحمن بن تستدلون وقيل بن الصامت / د ق.(@)(@@) 8246 - أبو عبد الله الزرقي صحابي له حديث في فضل الأنصار وقيل أبو عبيدة / صد.(@)(@@) * - أبو عبد الله الصنابحي اسمه عبد الرحمن بن عسيلة (1) تقدم.(@)(@@) 8247 - أبو عبد الله القرشي وقيل بالتصغير مصري مقبول من السادسة / د.(@)(@@) 8248 - أبو عبد الله المدني مولى الجندعيين ثقة من الثالثة وقيل هو نافع بن أبي نافع / س. PageV02P428(@)(@@) 8249 - أبو عبد الله المصري مولى إسماعيل مجهول من السادسة / د.(@)(@@) * - أبو عبد الله عن معاذ بن جبل تقدم في ترجمة مسلم (1) 8250 - أبو عبد الله رجل له صحبة وحديث في الصوم روى عنه عرفجة / س.(@)(@@) 8251 - أبو عبد الله مولى بني تيم مجهول من السادسة / د س.(@)(@@) * - أبو عبد الله مولى شداد هو سالم بن عبد الله تقدم (1) 8252 - أبو عبد الله مولى آل أبي بردة الأشعري مجهول من السادسة / د.(@)(@@) 8253 - أبو عبد الله المدني مقبول من الثالثة / س.(@)(@@) 8254 - أبو عبد الله صحابي روى عنه أبو قلابة قيل هو حذيفة / بخ د.(@)(@@) 8255 - أبو عبد الدائم الهدادي بفتح الهاء وتخفيف الدال البصري اسمه عبد الملك بن كردوس مستور من السابعة / مد.(@)(@@) 8256 - أبو عبد رب الدمشقي الزاهد ويقال أبو عبد ربه أو عبد رب العزة قيل اسمه عبد الجبار وقيل عبد الرحمن وقيل قسطنطين وقيل فلسطين وهو غلط مقبول من الثالثة مات سنة اثنتي عشرة / ق.(@)(@@) * - أبو عبد الرحمن الإفريقي هو عبد الله بن عمر بن غانم (1) PageV02P429(@)(@@) * - أبو عبد الرحمن الحبلي هو عبد الله بن يزيد تقدما (2) * - أبو عبد الرحمن عن قتادة قيل هو سعيد بن بشير (3) 8257 - أبو عبد الرحمن التميمي شامي مجهول من السادسة / ق.(@)(@@) 8258 - أبو عبد الرحمن الجهني صحابي قيل اسمه زيد نزل مصر / ق.(@)(@@) * - أبو عبد الرحمن الخراساني اسمه إسحاق بن أسيد (1) * - أبو عبد الرحمن السلمي اسمه عبد الله بن حبيب (2) * - أبو عبد الرحمن الفزاري اسمه النضر بن منصور تقدموا (3) 8259 - أبو عبد الرحمن الفهري صحابي وقيل اسمه يزيد 
ms618	 بن إياس وقيل الحارث بن هشام وقيل عبيد وقيل كرز بن ثعلبة شهد حنينا ثم فتح مصر / د.(@)(@@) 8260 - أبو عبد الرحمن عن بلال قيل هو مسلم بن يسار وإلا فمجهول من الثانية / د س.(@)(@@) * - أبو عبد الرحمن المقرئ اسمه عبد الله بن يزيد (1) * - أبو عبد الرحيم الحراني اسمه خالد بن أبي يزيد (2) PageV02P430(@)(@@) * - أبو عبد السلام اسمه صالح بن رستم (3) * - أبو عبد الصمد العمي هو عبد العزيز بن عبد الصمد (4) * - أبو عبد العزيز الأردني هو يحيى بن عبد العزيز وتقدموا (5) 8261 - أبو عبد العزيز مجهول من الثالثة / بخ.(@)(@@) 8261 - أبو عبد الملك مولى أم مسكين مجهول من الثالثة أيضا / بخ.(@)(@@) * - أبو عبد الملك عن القاسم هو علي بن يزيد تقدم (1) 8263 - أبو عبس بن جبر بفتح الجيم وسكون الموحدة بن زيد بن جشم الأنصاري اسمه عبد الرحمن وقيل عبد الله وقيل معبد صحابي شهد بدرا وما بعدها ومات سنة أربع وثلاثين عن سبعين سنة / خ ت س.(@)(@@) * - أبو عبلة صوابه إبراهيم بن أبي عبلة (1) * - أبو عبيد الله الأشعري بالتصغير هو معاوية بن صالح (2) * - أبو عبيد الله الخزاعي هو مسلم بن مشكم (3) * - أبو عبيد الله المخزومي هو سعيد بن عبد الرحمن (4) * - أبو عبيد الله بن أخي بن وهب هو أحمد بن عبد الرحمن بن وهب (5). PageV02P431(@)(@@) * - أبو عبيد الله المكي مولى أم علي اسمه سليم (6) * - أبو عبيد الله الوراق هو حماد بن الحسن (7) * - أبو عبيدة بن سلام هو القاسم تقدموا (8) * - أبو عبيدة الزرقي في أبي عبد الله (9) 8264 - أبو عبيدة المذحجي حاجب (1) سليمان قيل اسمه عبد الملك وقيل حي أو حيي أو حوي ثقة من الخامسة مات بعد المائة / خت م د س.(@)(@@) 8265 - أبو عبيدة مولى النبي صلى الله عليه وسلم صحابي له حديث / تم.(@)(@@) * - أبو عبيدة مولى بن أزهر اسمه سعد بن عبيد (1) * - أبو عبيدة بن الجراح هو عامر بن عبد الله بن الجراح الفهري تقدما (2) 8266 - أبو عبيدة بن حذيفة بن وابنه الكوفي مقبول من الثانية / س ق.(@)(@@) 8267 
ms619	 - أبو عبيدة بن عبد الله بن زمعة بن الأسود بن المطلب بن أسد بن عبد العزى القرشي الأسدي مقبول من الثالثة / م د س ق.(@)(@@) 8268 - أبو عبيدة بن عبد الله بن مسعود مشهور بكنيته والأشهر أنه لا اسم له غيرها ويقال اسمه عامر كوفي ثقة من كبار الثالثة والراجح أنه لا يصح سماعه من أبيه مات بعد سنة ثمانين / ع. PageV02P432(@)(@@) * - أبو عبيدة بن أبي السفر اسمه أحمد بن عبد الله تقدم (1) 8269 - أبو عبيدة بن عبيد الله بن عبيد الرحمن الأشجعي يقال اسمه عباد مقبول من التاسعة / د.(@)(@@) 8270 - أبو عبيدة بن عقبة بن نافع الفهري يقال اسمه مرة مقبول من الثالثة مات سنة سبع ومائة / م د س.(@)(@@) 8271 - أبو عبيدة بن محمد بن عمار بن ياسر أخو سلمة وقيل هو هو مقبول من الرابعة / 4.(@)(@@) * - أبو عبيدة بن معن المسعودي في عبد الملك (1) 8272 - أبو عبيدة عن أنس يقال هو حميد الطويل وإلا فمجهول من الخامسة / ز.(@)(@@) * - أبو عبيدة الحداد اسمه عبد الواحد بن واصل تقدم (1) * - أبو عبيدة عن عبد الله بن محمد هو ابن أبي السفر تقدم (2) / س.(@)(@@) * - أبو عبيدة شيخ لسهيل بن أبي صالح صوابه أبو عبيد بغير هاء (3) وهو المذحجي تقدم.(@)(@@) * - أبو العبيدين بالتثنية اسمه معاوية بن سبرة (4) * - أبو عتاب هو سهل بن حماد (5) PageV02P433(@)(@@) * - أبو عتبة هو أحمد بن الفرج تقدموا.(@)(@@) 8273 - أبو عتبة شيخ لمسعر مجهول من الثالثة / س.(@)(@@) 8274 - أبو عثمان بن سنة بفتح المهملة وتشديد النون الخزاعي الدمشقي مقبول من الثانية ووهم من زعم أن له صحبة فإن حديثه مرسل / س ق (1).(@)(@@) * - أبو عثمان بن نصر صوابه: أبو الهيثم بن نصر (1) 8275 - أبو عثمان بن يزيد شيخ لابن جريج مجهول من الخامسة وحديثه مرسل / مد.(@)(@@) 8276 - أبو عثمان الأنصاري المدني قاضي مرو قيل اسمه عمر وقيل عمرو وأبو سالم أو سالم (1) أو سليم مقبول من الرابعة / زت.(@)(@@) * - أبو عثمان هو الجعد بن دينار (1) * - أبو عثمان الصنعاني هو شراحيل بن مرثد (2).(@)(@@) * - أبو عثمان 
ms620	 الطنبذي هو مسلم بن يسار (3) * - أبو عثمان النهدي هو عبد الرحمن بن مل تقدموا (4) 8277 - أبو عثمان شيخ لسليمان التيمي قال في روايته عنه وليس بالنهدي قيل اسمه سعد مقبول من الرابعة / د س ق. PageV02P434(@)(@@) 8278 - أبو عثمان الخراساني مجهول من الثالثة قيل اسمه مروان / عس.(@)(@@) 8279 - أبو عثمان التبان بمثناة ثم موحدة ثقيلة مولى المغيرة بن شعبة قيل اسمه سعد وقيل عمران مقبول من الثالثة / خت د ت س.(@)(@@) 8280 - أبو عثمان شيخ لربيعة بن يزيد الدمشقي قيل هو سعيد بن هانئ الخولاني وقيل حريز بن عثمان وإلا فمقبول من الثالثة / م د ت س.(@)(@@) * - أبو عثمان عن أنس وعنه إبراهيم بن طهمان هو الجعد وتقدم (1) / س.(@)(@@) 8281 - أبو عثمان شيخ لعبد الرحمن بن زياد هو مسلم بن يسار وإلا فمجهول من الثالثة / ت.(@)(@@) 8282 - أبو عثمان شيخ للأوزاعي قال أبو داود: أظنه جسر بن الحسن وإلا فمجهول من السادسة / مد.(@)(@@) 8283 - أبو العجفاء بفتح أوله وسكون الجيم السلمي البصري قيل اسمه هرم بن نسيب وقيل بالعكس وقيل بالصاد بدل السين المهملتين مقبول من الثانية مات بعد التسعين فيما ذكره البخاري / 4.(@)(@@) 8284 - أبو العجلان المحاربي وقيل فيه أبو المخارق مقبول من الرابعة / بخ. PageV02P435(@)(@@) 8285 - أبو العدبس بفتح المهملتين والموحدة المشددة بعدها مهملة كوفي مجهول من السادسة / د ق (1).(@)(@@) 8286 - أبو العدبس الأشعري أو الأسدي الكوفي وهو أكبر من الذي قبله واسمه منيع بن سليمان مقبول من الرابعة وجعله بعضهم هو والذي قبله واحدا / تمييز.(@)(@@) 8287 - أبو عذرة بضم أوله وسكون المعجمة له حديث في الحمام وهو مجهول من الثانية ووهم من قال له صحبة / د ت ق.(@)(@@) * - أبو العريان هو الهيثم بن الأسود النخعي (1) / بخ.(@)(@@) * - أبو عزة الهذلي بفتح أوله وتشديد الزاي هو يسار بن عبد (2) * - أبو عشانة بضم أوله وتشديد المعجمة وبعد الألف نون هو حي بن يؤمن المصري تقدموا (3) 8288 - أبو العشراء بضم أوله وفتح المعجمة والراء والمد الدارمي قيل اسمه أسامة بن مالك بن قهطم وقيل 