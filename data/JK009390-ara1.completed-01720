ms1701	 ) عن ابن عمرو ( ت ) عن أنس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15491 ) قال النبي :(@)(@@) | 30 ( القتيل في سبيل الله شهيد ، والمبطون شهيد ، والمطعون شهيد ، والغريق شهيد ، والنفساء شهيدة ) )(@)(@@) ( طب ) عن عبد الله بن بسر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15492 ) قال النبي :(@)(@@) | 30 ( القدر سر الله ، فلا تفشوا سر الله عز وجل ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15493 ) قال النبي :(@)(@@) | 30 ( القدر نظام التوحيد ، فمن وحد الله وآمن بالقدر فقد استمسك بالقدر بالعروة الوثقى ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15494 ) قال النبي :(@)(@@) | 30 ( القدرية مجوس هاذه الأمة ، إن مرضوا فلا تعودوهم ، وإن ماتوا فلا تشهدوهم ) )(@)(@@) ( د ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15495 ) قال النبي :(@)(@@) | 30 ( القرآن ألف ألف حرف ، وسبعة وعشرون ألف حرف ، فمن قرأه صابرا محتسبا كان له بكل حرف زوجة من الحور العين ) )(@)(@@) ( طس ) عن عمر رضي الله عنه .(@)(@@) PageV05P384(@)(@@)(@@)(@@) $ ( 15496 ) قال النبي :(@)(@@) | 30 ( القرآن شافع مشفع ، وماحل مصدق ، من جعله أمامه قاده إلى الجنة ، ومن جعله خلفه ساقه إلى النار ) )(@)(@@) ( حب هب ) عن جابر ( طب هب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15497 ) قال النبي :(@)(@@) | 30 ( القرآن غنى لا فقر بعده ، ولا غنى دونه ) )(@)(@@) ( ع ) و محمد بن نصر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15498 ) قال النبي :(@)(@@) | 30 ( القرآن هو الدواء ) )(@)(@@) السنجري في الإبانة والقضاعي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15499 ) قال النبي :(@)(@@) | 30 ( القرآن هو النور المبين ، والذكر الحكيم ، والصراط المستقيم ) )(@)(@@) ( هب ) عن رجل .(@)(@@)(@@)(@@) $ ( 15500 ) قال النبي :(@)(@@) | 30 ( القرآن يقرأ على سبعة أحرف ، فلا تماروا في القرآن ، فإن مراء في القرآن كفر ( ( حم ) عن أ$ بي جهيم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15501 ) قال النبي :(@)(@@) | 30 ( القراء عرفاء أهل الجنة ) )(@)(@@) ابن جميع في معجمه ، والضياء عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15502 ) قال النبي :(@)(@@) | 30 ( القصاص ثلاثة : أمير ، أو مأمور ، أو مختال ) )(@)(@@) ( طب ) عن عوف بن مالك ، وعن كعب بن عياض رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15503 ) قال النبي :(@)(@@) | 30 ( القضاة ثلاثة ، اثنان في النار وواحد في الجنة : رجل 
ms1702	 علم الحق فقضى به فهو في الجنة ، ورجل قضى للناس على جهل فهو في النار ، ورجل عرف الحق فجار في الحكم فهو في النار ) )(@)(@@)(@@)(@@) $ ( 4 ك ) عن بريدة رضي الله عنه .(@)(@@) PageV05P385(@)(@@)(@@)(@@) $ ( 15504 ) قال النبي :(@)(@@) | 30 ( القضاة ثلاثة : قاضيان في النار ، وقاض في الجنة : قاض قضى بالهوى فهو في النار ، وقاض قضى بغير علم فهو في النار ، وقاض قضى بالحق فهو في الجنة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15505 ) قال النبي :(@)(@@) | 30 ( القلب ملك وله جنود ، فإذا صلح الملك صلحت جنوده ، وإذا فسد الملك فسدت جنوده ، والأذنان قمع ، والعينان مسلحة ، واللسان ترجمان ، واليدان جناحان ، والرجلان بريد ، والكبد رحمة ، والطحال ضحك ، والكليتان مكر ، والرئة نفس ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15506 ) قال النبي :(@)(@@) | 30 ( القلس حدث ) )(@)(@@) ( قط ) عن الحسين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15507 ) قال النبي :(@)(@@) | 30 ( القناعة مال لا ينفذ ) )(@)(@@) القضاعي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15508 ) قال النبي :(@)(@@) | 30 ( القنطار اثنتا عشرة ألف أوقية ، كل أوقية خير مما بين السماء والأرض ) )(@)(@@) ( ه حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15509 ) قال النبي :(@)(@@) | 30 ( القنطار ألف ومائتا دينار ) )(@)(@@) ابن جرير عن الحسن مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 15510 ) قال النبي :(@)(@@) | 30 ( القنطار ألفا أوقية ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15511 ) قال النبي :(@)(@@) | 30 ( القنطار ألف أوقية ، ومائتا أوقية ) )(@)(@@) ابن جرير ، عن أبي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 15512 ) قال النبي :(@)(@@) | 30 ( القهقهة من الشيطان ، والتبسم من الله ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV05P386(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 15513 ) قال النبي :(@)(@@) | 30 ( القبر حفرة من جهنم ، أو روضة من رياض الجنة ) )(@)(@@) ( هق ) في كتاب عذاب القبر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15514 ) قال النبي :(@)(@@) | 30 ( القتل كفارة ) )(@)(@@) الحسن بن سفيان وأبو نعيم عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15515 ) قال النبي :(@)(@@) | 30 ( القتيل في سبيل الله شهيد ، والمبطون شهيد ، والغريق شهيد ، والطاعون شهادة ، والغريب شهيد ، والنفساء يجرها ولدها بسرره الى الجنة ) )(@)(@@) سمويه عن عبادة بن الصامت رضي الله عنه 
ms1703	 .(@)(@@)(@@)(@@) $ ( 15516 ) قال النبي :(@)(@@) | 30 ( القدري أوله مجوسي وآخره زنديق ) )(@)(@@) أبو نعيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15517 ) قال النبي :(@)(@@) | 30 ( القدرية مجوس أمتي ) )(@)(@@) ( خ ) في تاريخه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15518 ) قال النبي :(@)(@@) | 30 ( القدرية الذين يقولون : الخير والشر بأيدينا ، ليس لهم في شفاعتي نصيب ولا أنا منهم ولا هم مني ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15519 ) قال النبي :(@)(@@) | 30 ( القرآن يقرأ على سبعة أحرف ، ولا تماروا في القرآن فإن مراء في القرآن كفر ) )(@)(@@) ( حم ) عن أبي جهيم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15520 ) قال النبي :(@)(@@) | 30 ( القرآن أفضل من كل شيء دون الله ، وفضل القرآن على سائر الكلام ، كفضل الله على خلقه ، فمن وقر القرآن فقد وقر الله ، PageV05P387 ومن لم يوقر القرآن فقد استخف بحق الله ، وحرمة القرآن عند الله تعالى كحرمة الوالد على ولده ، القرآن شافع مشفع ، وماحل مصدق ، فمن شفع له القرآن شفع ، ومن محل به القرآن صدق ، ومن جعله أمامه قاده إلى الجنة ، ومن جعله خلفه ساقه إلى النار ، حملة القرآن هم المحفوفون برحمة الله ، الملبسون نور الله ، المتعلمون كلام الله ، من عاداهم فقد عادى الله ، ومن والاهم فقد والى الله ، يقول الله عز وجل : يا حملة كتاب الله استجيبوا لله بتوقير كتابه يزدكم حبا ، ويحببكم إلى خلقه ، يدفع عن مستمع القرآن سوء الدنيا ، ويدفع عن تالي القرآن بلوى الآخرة ، ولمستمع آية من كتاب الله خير له من صبير ذهبا ، ولتالي آية من كتاب الله خير له مما تحت أديم السماء ، وإن في القرآن لسورة تدعى العظيمة عند الله ، يدعى صاحبها الشريف عند الله يشفع صاحبها يوم القيامة في أكثر من ربيعة ومضر ، وهي سورة ياس ) )(@)(@@) أبو نصر السجري في الإبانة عن عائشة رضي الله عنها وقال : هاذا من أحسن الحديث وأعزبه وليس في إسناده إلا مقبول ثقة ، الحكيم عن محمد بن علي مرسلا ( ك ) في تاريخه عن محمد بن الحنفية عن علي بن أبي طالب رضي الله عنه موصولا .(@)(@@)(@@)(@@) $ ( 15521 ) قال النبي :(@)(@@) | 30 ( القرآن 
ms1704	 كلام الله عز وجل فليجل صاحب القرآن ربه عن إتيان محارمه ) )(@)(@@) أبو نعيم عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15522 ) قال النبي :(@)(@@) | 30 ( القرآن ذو وجوه فأحملوه على أحسن وجوهه ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15523 ) قال النبي :(@)(@@) | 30 ( القرآن صعب مستصعب على من كرهه ، ميسر على من تبعه وهو الحكم ، وحديثي صعب وهو الحكم ، فمن استمسك بحديثي وفهمه وحفظه جامع القرآن ، ومن تهاون بالقرآن وبحديثي خسر الدنيا والآخرة ) )(@)(@@) أبو نعيم عن الحكم بن عمير رضي الله عنه .(@)(@@) PageV05P388(@)(@@)(@@)(@@) $ ( 15524 ) قال النبي :(@)(@@) | 30 ( القرآن لم ينزل بالكسكسة ولا بالكشكشة ولاكن بلسان عربي مبين ) )(@)(@@) أبو نعيم عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15525 ) قال النبي :(@)(@@) | 30 ( القرى المحفوظة : مكة ، والمدينة ، وإيلياء ، ونجران ، وما من ليلة إلا وينزل بنجران سبعون ألف ملك يصلون على أهل الأخدود ثم لا يعودون إليها أبدا ) )(@)(@@) نعيم بن حماد في الفتن عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 15526 ) قال النبي :(@)(@@) | 30 ( القريب من قربته المودة وإن بعد نسبه ، والبعيد من باعدته البغضاء وإن قرب نسبه ، ولا شيء أقرب من يد إلى جسد ، وإن اليد إذا غلت قطعت ، وإذا قطعت حسمت ) )(@)(@@) أبو نعيم والديلمي عن جعفر بن محمد عن أبيه معضلا ، ابن النجار عنه عن علي بن الحسين عن الحسين عن علي بن أبي طالب رضي الله عنهم موصولا .(@)(@@)(@@)(@@) $ ( 15527 ) قال النبي :(@)(@@) | 30 ( القرآن كله صواب ) )(@)(@@) ( خ ) في تاريخه عن رجل له صحبة .(@)(@@)(@@)(@@) $ ( 15528 ) قال النبي :(@)(@@) | 30 ( القرآن أربعون سنة ) )(@)(@@) ابن جرير عن ابن سيرين مرسلا .(@)(@@)(@@)(@@) $ ( 15529 ) قال النبي :(@)(@@) | 30 ( القضاة ثلاثة ، قاضيان في النار ، وقاض في الجنة : قاض قضى بغير الحق وهو يعلم فذاك في النار ، وقاض قضى وهو لا يعلم فأهلك حقوق الناس فذاك في النار ، وقاض قضى بالحق فذاك في الجنة ) )(@)(@@) ( هق ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 15530 ) قال النبي :(@)(@@) | 30 ( القلوب أربعة : فقلب أجرد فيه مثل السراج PageV05P389 يزهر ، وقلب أغلف مربوط على غلافه ، وقلب منكوس ، وقلب مصفح ، فأما القلب الأجرد فقلب المؤمن ، سراج