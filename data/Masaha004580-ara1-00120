ms111	 الله عبدا ألهمه الصدق(@)(@)(@@)(@@)(@@) ||| 128(@)(@)(@@) @HAD08 إذا أكرم الله عبدا أعانه على إقامة الحق(@)(@)(@@)(@@)(@@) ||| 129(@)(@)(@@) @HAD06 إذا لوحت للعاقل فقد أوجعته عتابا(@)(@)(@@)(@@)(@@) ||| 130(@)(@)(@@) @HAD07 إذا حلمت عن الجاهل فقد أوسعته جوابا(@)(@)(@@)(@@)(@@) ||| 131(@)(@)(@@) @HAD09 إذا قدمت الفكر فى أفعالك حسنت عواقبك وفعالك(@)(@)(@@)(@@)(@@) ||| 132(@)(@)(@@) @HAD010 إذا وصلت إليكم أطراف النعم فلا تنفروا أقصاها بقلة الشكر(@)(@)(@@)(@@)(@@) ||| 133(@)(@)(@@) @HAD015 إذا صعبت عليك نفسك فاصعب لها تذل لك وخادع نفسك عن نفسك تنقد لك(@)(@)(@@)(@@)(@@) ||| 134(@)(@)(@@) @HAD03 إذا خفت صعوبة(@)(@)PageV01P288(@)(@)(@@) @HAD012 أمر فاصعب له يذل لك وخادع الناس عن أمثاله تهن عليك(@)(@)(@@)(@@)(@@) ||| 135(@)(@)(@@) @HAD021 إذا حدتك القدرة على ظلم الناس فاذكر قدرة الله سبحانه على عقوبتك وذهاب ما أتيت إليهم عنهم وبقاءه عليك(@)(@)(@@)(@@)(@@) ||| 136(@)(@)(@@) @HAD011 إذا أحب الله عبدا بغض إليه المال وقصر منه الآمال(@)(@)(@@)(@@)(@@) ||| 137(@)(@)(@@) @HAD012 إذا أراد الله بعبد شرا حبب إليه المال وبسط منه الآمال(@)(@)(@@)(@@)(@@) ||| 138(@)(@)(@@) @HAD011 إذا أراد الله بعبد خيرا منحه عقلا قويما وعملا مستقيما(@)(@)(@@)(@@)(@@) ||| 139(@)(@)(@@) @HAD010 إذا أحب الله عبدا رزقه قلبا سليما وخلقا قويما(@)(@)(@@)(@@)(@@) ||| 140(@)(@)(@@) @HAD09 إذا أراد الله بعبد خيرا أعف بطنه وفرجه(@)(@)(@@)(@@)(@@) ||| 141(@)(@)(@@) @HAD011 إذا أراد الله بعبد خيرا ألهمه القناعة وأصلح له زوجه(@)(@)(@@)(@@)(@@) ||| 142(@)(@)(@@) @HAD013 إذا أراد الله بعبد خيرا أعف بطنه عن الطعام وفرجه عن الحرام(@)(@)(@@)(@@)(@@) ||| 143(@)(@)(@@) @HAD015 إذا أراد الله سبحانه صلاح عبد ألهمه قلة الكلام وقلة الطعام وقلة المنام(@)(@)(@@)(@@)(@@) ||| 144(@)(@)(@@) @HAD015 إذا بنى الملك على قواعد العدل ودعائم العقل نصر الله مواليه وخذل معاديه(@)(@)(@@)(@@)(@@) ||| 145(@)(@)(@@) @HAD07 إذا هممت بأمر فاجتنب ذميم العواقب فيه(@)(@)PageV01P289(@)(@)(@@)(@@)(@@) ||| 146(@)(@)(@@) @HAD09 إذا أنت هديت لقصدك فكن أخشع ما تكون لربك(@)(@)(@@)(@@)(@@) ||| 147(@)(@)(@@) @HAD07 إذا عجز عن الضعفاء نيلك فلتسعهم رحمتك(@)(@)(@@)(@@)(@@) ||| 148(@)(@)(@@) @HAD07 إذا كان الرفق خرقا كان الخرق رفقا(@)(@)(@@)(@@)(@@) ||| 149(@)(@)(@@) @HAD011 إذا كنت فى إدبار والموت فى إقبال فما أسرع الملتقى(@)(@)(@@)(@@)(@@) ||| 150(@)(@)(@@) @HAD08 إذا أمكنك الفرصة فانتهزها فإن إضاعة الفرصة غصة(@)(@)(@@)(@@)(@@) ||| 151(@)(@)(@@) @HAD019 إذا أراد الله سبحانه إزالة نعمة عن عبد كان أول ما يغير منه عقله وأشد شيىء عليه فقده(@)(@)(@@)(@@)(@@) ||| 152(@)(@)(@@) @HAD014 إذا أقبلت الدنيا على عبد كسته محاسن غيره وإذا أدبرت عنه سلبته محاسنه(@)(@)(@@)(@@)(@@) ||| 153(@)(@)(@@) @HAD022 إذا أراد أحدكم أن لا يسئل الله سبحانه شيئا 
ms112	 إلا أعطاه فلييأس من الناس ولا يكن له رجاء إلا الله سبحانه(@)(@)(@@)(@@)(@@) ||| 154(@)(@)(@@) @HAD012 إذا هبت أمرا فقع فيه فإن شدة توقيه أشد من الوقوع فيه(@)(@)(@@)(@@)(@@) ||| 155(@)(@)(@@) @HAD06 إذا زادك السلطان تقريبا فزده إجلالا(@)(@)(@@)(@@)(@@) ||| 156(@)(@)(@@) @HAD06 إذا زادك اللئيم إجلالا فزده إذلالا(@)(@)(@@)(@@)(@@) ||| 157(@)(@)(@@) @HAD05 إذا أمطر التحاسد نبت التفاسد(@)(@)(@@)(@@)(@@) ||| 158(@)(@)(@@) @HAD07 إذا ثبت الود وجب الترافد والتعاضد(@)(@)PageV01P290(@)(@)(@@)(@@)(@@) ||| 159(@)(@)(@@) @HAD011 إذا أراد الله بعبد خيرا فقهه فى الدين وألهمه اليقين(@)(@)(@@)(@@)(@@) ||| 160(@)(@)(@@) @HAD012 إذا فاتك من الدنيا شيىء فلا تحزن وإذا أحسنت فلا تمنن(@)(@)(@@)(@@)(@@) ||| 161(@)(@)(@@) @HAD012 إذا جمعت المال فأنت فيه وكيل لغيرك يسعد به وتشقى أنت(@)(@)(@@)(@@)(@@) ||| 162(@)(@)(@@) @HAD024 إذا قدمت مالك لاخرتك واستخلفت الله سبحانه على من خلفته من بعدك سعدت بما قدمت وأحسن الله لك الخلافة على من خلفت(@)(@)(@@)(@@)(@@) ||| 163(@)(@)(@@) @HAD012 إذا أراد الله بعبد خيرا ألهمه القناعة فاكتفى بالكفاف واكتسى بالعفاف(@)(@)(@@)(@@)(@@) ||| 164(@)(@)(@@) @HAD016 إذا أراد الله بعبد خيرا ألهمه الإقتصاد وحسن التدبير وجنبه سوء التدبير والإسراف(@)(@)(@@)(@@)(@@) ||| 165(@)(@)(@@) @HAD09 إذا ملىء البطن من المباح عمى القلب عن الصلاح(@)(@)(@@)(@@)(@@) ||| 166(@)(@)(@@) @HAD020 إذا أعرضت عن دار الفناء وتولهت بدار البقاء فقد فاز قدحك وفتحت لك أبواب النجاح وظفرت بالفلاح(@)(@)(@@)(@@)(@@) ||| 167(@)(@)(@@) @HAD014 إذا اتخذت وليك فكن له عبدا وامنحه صدق الوفاء وحسن الصفاء(@)(@)(@@)(@@)(@@) ||| 168(@)(@)(@@) @HAD09 إذا كان فى الرجل خلة رائقة فانتظر منه أخواتها(@)(@)(@@)(@@)(@@) ||| 169(@)(@)(@@) @HAD08 إذا دعاك القران إلى خلة جميلة فخذ نفسك(@)(@)PageV01P291(@)(@)(@@) @HAD01 بأمثالها(@)(@)(@@)(@@)(@@) ||| 170(@)(@)(@@) @HAD010 إذا أتتك المحن فاقعد لها فإن قيامك فيها زيادة لها(@)(@)(@@)(@@)(@@) ||| 171(@)(@)(@@) @HAD013 إذا أحسنت القول فأحسن العمل لتجمع بذلك بين مزية اللسان وفضيلة الإحسان(@)(@)(@@)(@@)(@@) ||| 172(@)(@)(@@) @HAD015 إذا امنت بالله سبحانه واتقيت محارمه أحلك دار الأمان وإذا أرضيته تغمدك بالرضوان(@)(@)(@@)(@@)(@@) ||| 173(@)(@)(@@) @HAD019 إذا سئلت فاسئل تفقها ولا تسئل تعنتا فإن الجاهل المتعلم شبيه بالعالم وإن العالم المتعنت شبيه بالجاهل(@)(@)(@@)(@@)(@@) ||| 174(@)(@)(@@) @HAD016 إذا اتقيت المحرمات وتورعت عن الشبهات وأديت المفترضات وتنفلت بالنوافل فقد أكملت بالفضائل(@)(@)(@@)(@@)(@@) ||| 175(@)(@)(@@) @HAD034 إذا غضب الله على أمة لم ينزل العذاب عليهم غلت أسعارها وقصرت أعمارها ولم تربح تجارها ولم تزك ثمارها ولم تغرز أنهارها وحبس عنها أمطارها وسلط عليها أشرارها(@)(@)(@@)(@@)(@@) ||| 176(@)(@)(@@) @HAD047 إذا طففت المكيال أخذهم 
ms113	 الله بالسنين والنقص وإذا منعوا الزكاة منعت الأرض بركاتها من الزرع والثمار والمعادن وإذا جاروا فى الحكم تعاونوا على الظلم والعدوان وإذا نقضوا العهود سلط الله عليهم عدوهم وإذا قطعوا الأرحام جعلت الأموال فى أيدي(@)(@)PageV01P292(@)(@)(@@) @HAD017 الأشرار وإذا لم يأمروا بالمعروف ولم ينهوا عن المنكر لم يتبعوا الأخيار من أهل بيتي(@)(@)(@@)(@@)(@@) ||| 177(@)(@)(@@) @HAD032 إذا كانت لك إلى الله تعالى حاجة فابدء بالصلاة على النبى (صلوات الله عليه) ثم اسئل الله تعالى حاجتك فإن الله سبحانه أكرم من أن يسئل حاجتين فيقضي إحداهما ويمنع الأخرى(@)(@)(@@)(@@)(@@) ||| 178(@)(@)(@@) @HAD020 إذا استولى الصلاح على الزمان وأهله ثم أساء الظن رجل برجل لم تظهر منه خزية فقد ظلم واعتدى(@)(@)(@@)(@@)(@@) ||| 179(@)(@)(@@) @HAD014 إذا استولى الفساد على الزمان وأهله ثم أحسن الظن رجل برجل فقد غر(@)(@)(@@)(@@)(@@) ||| 180(@)(@)(@@) @HAD023 إذا رأى أحدكم المنكر ولم يستطع أن ينكره بيده ولسانه وأنكره بقلبه وعلم الله صدق ذلك منه فقد أنكره(@)(@)(@@)(@@)(@@) ||| 181(@)(@)(@@) @HAD036 إذا زكي أحد من المتقين خاف مما يقال له فيقول أنا أعلم بنفسي من غيرى وربى أعلم بي مني أللهم لا تؤاخذني بما يقولون واجعلني أفضل ما يظنون واغفر لي ما لا يعلمون(@)(@)(@@)(@@)(@@) ||| 182(@)(@)(@@) @HAD022 إذا رأيتم الخير فسارعتم إليه وإذا رأيتم الشر فتباعدتم عنه وكنتم بالطاعات عاملين وفى المكارم متنافسين كنتم محسنين فائزين(@)(@)(@@)(@@)(@@) ||| 183(@)(@)(@@) @HAD08 إذا وجدت من أهل الفاقة من يحمل لك(@)(@)PageV01P293(@)(@)(@@) @HAD027 الزاد إلى يوم القيمة فيوافيك به غدا حيث تحتاج إليه فاغتنمه وحمله إياه وأكثر من تزويده وأنت قادر عليه فلعلك أن تطلبه فلا تجده(@)(@)(@@)(@@)(@@) ||| 184(@)(@)(@@) @HAD011 إذا أنكرت من عقلك شيئا فاقتد برأي عاقل يزيل ما أنكرته(@)(@)(@@)(@@)(@@) ||| 185(@)(@)(@@) @HAD011 إذا سمعتم العلم فانطووا عليه ولا تشوبوه بهزل فتمجه القلوب(@)(@)(@@)(@@)(@@) ||| 186(@)(@)(@@) @HAD013 إذا رمتم الإنتفاع بالعلم فاعملوا به وأكثروا الفكر فى معانيه تعه القلوب(@)(@)(@@)(@@)(@@) ||| 187(@)(@)(@@) @HAD06 إذا غلبت عليك الشهوة فاغلبها بالإختصار(@)(@)(@@)(@@)(@@) ||| 188(@)(@)(@@) @HAD08 إذا غلب عليك الغضب فاغلبه بالحلم و