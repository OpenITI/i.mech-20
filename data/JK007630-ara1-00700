ms681	 أهديتها % % ولم أسمها ميسما باديا % % PageV01P2136 51(@)(@@) % لكنها من معدن لم يكن % % بسره ينبع إلا ليا % % 52(@)(@@) % بديعة حسناء فكري لها % % ظئر وفي صدري ربت ناشيا % % 53(@)(@@) % فإن شكرتم مهديا فاشكروا % % إهداي منها بعض أعضائيا % % PageV01P2137 البحر : - 1(@)(@@) % ما لي شرقت بماء ذي الأثل % هل كده الوراد من قبلي % % 2(@)(@@) % أم بان سكان فأملح لي % % ماكان قبل البين أستحلي % % 3(@)(@@) % ونعم لهم تلك النطاف صفت % وامتد سابغ ذلك الظل % 4(@)(@@) % وبحيهم يشتاق حاضره % % بالريف باديه على الرمل % 5(@)(@@) % لا ابيض لي في الدار بعدهم % يوم وهل دار بلا أهل % 6(@)(@@) % رحلوا بأيامي الرقاق على % % آثارهم وبعيشي السهل % % 7(@)(@@) % وعكفت بعدهم على ضمن % عرف الهوى فبلي كما بيلي % % 8(@)(@@) % جسدي ودمنته بما نحلا % % يشاكيان تصدع الشمل % 9(@)(@@) % مغنى وضعنا أمس من شعف % سافى ثراه مواضع الكحل % 10(@)(@@) % فاليوم نحن على الوفاء له % % نستافه بمناسم الإبل % PageV01P2138 11(@)(@@) % في الظاعنين علاقة عقدت % عندي الحفاظ فلم تخف حلي % % 12(@)(@@) % أودعتها قلبي فما قنعت % بالقلب حتى استفضلت عقلي % % 13(@)(@@) % فعلى محاسنها وقد هلكت % تلك الوديعة قيمة المثل % 14(@)(@@) % لما جلا التوديع صفحته % عن وقفة زفراتها تغلي % % 15(@)(@@) % قالت وقلبي من لواحظها % % ينصاع بين النصل والنصل % 16(@)(@@) % ما ذنب أجفاني إذا خلقت % من طينة البلبال والخبل % 17(@)(@@) % إني لأرحم من يناضلني % % نظرا وبين محاجري نبلي % % 18(@)(@@) % قد خوف العشاق قبلك من % % فتكات هذي الأعين النجل % 19(@)(@@) % فلحاظ عيني من دم سفكت % بعد النذير إليك في حل % 20(@)(@@) % ما لمت طرفك أخت غاضرة % % في السقم عن شك ولا جهل % PageV01P2139 21(@)(@@) % ما قلت لا تسب العقول وإنما % % خوفته الإسراف في القتل % 22(@)(@@) % قد كنت أعلم أنه أجل % لكن ظننت زمانه يملي % % 23(@)(@@) % ومعنفين وما لهم ولهى % % لم يكترث بفراغهم شغلي % % 24(@)(@@) % قد نازل اللوام قبلكم % سمعي فما افتتحوه بالعذل % 25(@)(@@) % وخدعت عن وفري وما خدعت % عن ذمة نفسي ولا إل % 26(@)(@@) % نسب الوفاء الحر في شيمي % % نسب المكارم في بني عجل % 27(@)(@@) % المانعين فخار بيتهم % للعز والجيران للذل % 28(@)(@@) % ويحل 
ms682	 للأيام كل حمى % وسروحهم في جانب بسل % 29(@)(@@) % لا تطمع الغارات في طرف % جمعوه في طرد ولا شل % 30(@)(@@) % والمطعمين إذا انبرت سنة % عضاضة بنيوبها العصل % PageV01P2140 31(@)(@@) % بسطوا مكان الغيث أيديهم % فيها فكن قواتل المحل % 32(@)(@@) % من كل وافى الحلم معتدل ال % % أخلاق ما لم يلق بالجهل % 33(@)(@@) % حتى إذا التمست هضيمته % % لمس المغرر جلدة الصل % 34(@)(@@) % يغشى الطعان بغشم منصلت % غر ورأى مجرب كهل % 35(@)(@@) % وإذا السواعد بالقنا ارتعشت % % دعم القناة بساعد عبل % 36(@)(@@) % وإذا ارتأى النادي أو انعقدت % % حلقاته للعقد والحل % 37(@)(@@) % كانت له والحزم مشترك % أم الكلام وقولة الفصل % 38(@)(@@) % قوم إذا نسبوا أبا دلف % ذهبوا بجل البأس والبذل % 39(@)(@@) % وكفاهم فخرا بواحدهم % % فخر القبيل بكثرة النسل % 40(@)(@@) % سارت بهم أيام سؤدده % % سير الحديث بمعجز الرسل % PageV01P2141 41(@)(@@) % وأتى الوزير فكان بينة % كفلت لهم بسلامة النقل % 42(@)(@@) % وصفت شهادته مغيبهم % % والفرع مبني على الأصل % 43(@)(@@) % رويت لنا قولا فضائلهم % % ونصرت ذاك القول بالفعل % 44(@)(@@) % أديت عنهم وافيا لهم % بأمانة التبليغ والحمل % 45(@)(@@) % ورأيت نفسك تقتضي شرفا % % فضل المزيد فزدت بالفضل % 46(@)(@@) % أعطوا على سعة الزمان كما % % تعطى وتضعف أنت في الأزل % 47(@)(@@) % وكفوا ولو قاموا مقامك في ال % % أحداث لم يبلوا كما تبلي % % 48(@)(@@) % جذبت بك الهمم الكبار فقد % % نلت السماء وأنت تستعلي % % 49(@)(@@) % وهدتك آراء مظفرة % فتحت عليك مغالق السبل % 50(@)(@@) % ونهضت بالملك الذي لويت % منه ظهور الجلة البزل % PageV01P2142 51(@)(@@) % أعيا الرجال أوان خفته % وحملته متفاوت الثقل % 52(@)(@@) % أرسلت فيه بآية خرقت % ما كان في العادات والعقل % 53(@)(@@) % جرح تواكله الأساة على % % ولغ المسابر فيه والفتل % 54(@)(@@) % بعلوا به مستضعفين له % % فحسمته من جانب سهل % 55(@)(@@) % عضدت كفايتك السعود كما % % عضد القران الحبل بالحبل % 56(@)(@@) % وأمدك الله المعونة في % % عزميك من سير ومن حل % 57(@)(@@) % أرضاه باطنك المخلص من % % غش يرين عليه أو غل % 58(@)(@@) % ولاك أمر عباده نظرا % % منه فما تدهى من العزل % 59(@)(@@) % وحمتك منه أن تنال يد % تنجو بها من زلة الرجل % 60(@)(@@) % وملكت 
ms683	 أهواء القلوب فما % % تسلى على هجر ولا وصل % PageV01P2143 61(@)(@@) % عافيت أهل الأرض من سقم % عرضوا له بالمال والأهل % 62(@)(@@) % وغدوا يعدون البقاء ردى % والعز للأوطان كالذل % 63(@)(@@) % في فترة عمياء جائرة % فظهرت بالإحسان والعدل % 64(@)(@@) % ومزجت بالبشر المهابة وال % % إرهاب بالإرفاق والمهل % 65(@)(@@) % والسيف يقطع عن طبيعته % % ويروق بالشعشاع والصقل % 66(@)(@@) % عقمت فلم تلد الوزارة مذ % % ولدتك بل زكيت في الحمل % 67(@)(@@) % ما طرقت بك وهي راجية % جريان مثلك في مطا فحل % 68(@)(@@) % كنت ابنها البر الوصول فلا % % ذاقت بفقدك جرعة الثكل % 69(@)(@@) % وفداك كل محافز حسدا % % جاريته ففلجت بالخصل % 70(@)(@@) % تجري وتعقله وراءك أر % % ساغ من التقصير في شكل % PageV01P2144 71(@)(@@) % وقدمت أيمن قادم وضعت % % رجلاه عن سرج وعن رحل % 72(@)(@@) % أوب الغمامة بعد ما انقشعت % % بمفوف الأخلاف منهل % 73(@)(@@) % وهنتك ضافية تعلق في % % عطفيك من ظهر ومن قبل % 74(@)(@@) % شد النضار ضعيف منكبها % % حتى أقام بها على رجل % 75(@)(@@) % لحمت على قدر صبائغها % % فالشكل موضوع على الشكل % 76(@)(@@) % وعريقة في القريتين لها % % بيتان من دق ومن جل % 77(@)(@@) % فإهابها من بيت خفتها % % وحليها من بيتها الجثل % 78(@)(@@) % بأخي وتفضله لقد جمعت % زنة الوقار وخفة الحمل % 79(@)(@@) % ألقى عليك الملك تكرمة % لم تلق عن كتفيه من ثقل % 80(@)(@@) % فلبستها للصون تسحبها % % ومساحب الأذيال للبذل % PageV01P2145 81(@)(@@) % بك عزت الآداب واثأرت % من بعد ما نامت على الذحل % 82(@)(@@) % رخصت على قوم فقام لها % % منك المنافس دونها المغلي % % 83(@)(@@) % ورددت عن لحمي أراقمه % % دودا وهن يد على أكلي % % 84(@)(@@) % أنهضتني بالدهر أحمله % % وصروفه كل على كل % 85(@)(@@) % وفعمت لي بحرا وقد قنطت % شفتي من الأوشال والضحل % 86(@)(@@) % وفسحت فانفسحت مضيقة % مجموعة الطرفين في عقل % 87(@)(@@) % قبضت خطاي فلم تكن قدمى % % فيها لتملأ حافتي نعلي % % 88(@)(@@) % ولقد أنست بها على مضض % % أنس الأسير بحلقة الكبل % 89(@)(@@) % فوصلت في المقطوع ممتثلا % % أمر العلا ووسمت في الغفل % 90(@)(@@) % ونسخت لي بالجود كل يد % % وضعت شريعتها على البخل % PageV01P2146 91(@)(@@) % نقد المكارم عندها عدة % حتى يموت الوعد بالمطل 
ms684	 % 92(@)(@@) % فلئن جزى جزل العطاء فتى % حر اللسان بمنطق جزل % 93(@)(@@) % فلأصفينك كل سائرة % في الريح سائلة مع الوبل % 94(@)(@@) % رفاعة في الأرض خافضة % بالشكر من حزن إلى سهل % 95(@)(@@) % لا ترهب الشق المخوف ولا % % تظما إلى نهل ولا عل % 96(@)(@@) % ووراء أبواب الملوك لها % % رفع الحجاب ورتبة القبل % 97(@)(@@) % ومتى نكلت عن الجزاء فلم % % ينهض بكثرك في العلا قلي % % 98(@)(@@) % علمتني ووصفت نفسك لي % % فطفقت أكتب عنك ما تملي % % 99(@)(@@) % تلقاك أيام السعود بها % % وصالة محبوبة الوصل % 100(@)(@@) % يتخايل النيروز إن جعلت % حليا على أعضائه العطل % PageV01P2147 101(@)(@@) % فتملها وتمله أبدا % % ما خولف الإحرام بالحل % 102(@)(@@) % وأعن وتمم ما ابتدأت به % % فالبعض مرتهن على الكل % 103(@)(@@) % واعرف لهذي الأرض أن ولدت % أزمان ملكك مادحا مثلي % % PageV01P2148 البحر : - 1(@)(@@) % طالبني بالعتب حتى إذا % % عوتب ظل العتب يجفو عليه % 2(@)(@@) % فاليوم أشكوه إلى من ترى % % وكنت أشكو الناس طرا إليه % PageV01P2149 البحر : - 1(@)(@@) % تموق الليالي فيكم ثم تعقل % وتقسط في أحكامها ثم تعدل % 2(@)(@@) % ويعرض وجه الملك عنكم علالة % فيلفته شوق إليكم فيقبل % 3(@)(@@) % إذا جرب الأبدال أصلحه لكم % % على كثرة التقليب من يتبدل % 4(@)(@@) % وكم هجرة لم تتفق عن ملالة % وصد يريب الحب وهو تدلل % 5(@)(@@) % مكانكم منه لكم أين كنتم % مقيمكم والظاعن المتحول % 6(@)(@@) % وهل يسكن الأفلاك إلا نجومها % % وإن غر قوما أنها تتنقل % 7(@)(@@) % وما أنت إلا البدر نأيا وأوبة % تحل على حكم السعود وترحل % 8(@)(@@) % على كل قطب ثابت لك مطلع % وفي كل برج سائر لك منزل % 9(@)(@@) % فكيف يساميك الإمارة والعلا % % خفي دقيق الشخص يعلو وينزل % 10(@)(@@) % إذا تم بدرا أو تنصف شهره % فإنك منه في سرارك أكمل % PageV01P2150 11(@)(@@) % إذا غبت عنا فالسحابة أقلعت % بجمتها الوطفاء والعام ممحل % 12(@)(@@) % ويقدمك الإقبال حتى ترى الحصى % % يروض خصبا والجلاميد تبقل % 13(@)(@@) % وما الملك يخلو منك إلا فريسة % % تمضغ ما بين النيوب فتؤكل % 14(@)(@@) % إذا ذدت عنها فهو واد محرم % وإن غبت شيئا فهو نهب محلل % 15(@)(@@) % وقد ألفت منك الوزارة موطنا 
ms685	 % % تفيأ في أكنافه وتظلل % 16(@)(@@) % ربت فهي ذات الودع في حجراته % % وشبت فهذا شيبها والتكهل % 17(@)(@@) % أخو ثديها والناس أبناء علة % وكافلها إن زوجت وهي تعضل % 18(@)(@@) % ووالدها الحاني الشفيق وبعضهم % % إذا ولد ابنا لم يبل كيف يثكل % 19(@)(@@) % فلا ضامها يتم وأنت لها أب % ولا عرفت يا بعلها كيف ترمل % 20(@)(@@) % ولا عدمت مشكور سعيك دولة % عليك إذا ذم السعاة تعول % PageV01P2151 21(@)(@@) % نهضت بها والدهر تحت وسوقها % % يناشد جنبيه النهوض فينكل % 22(@)(@@) % فراحوا وألقوها على متمرن % % يخف عليه الأمر من حيث يثقل % 23(@)(@@) % إلى كم تراهم يسبرون اجتهادهم % % وعفوك فيها ثم عفوك أفضل % 24(@)(@@) % وكم تتزوى هضبة بعد هضبة % بهم ولرضوى منكب لا يزيل % 25(@)(@@) % وقد حطها منبوذة واستقالها % % مطا كل ظهر ظن أن سوف يحمل % 26(@)(@@) % تناكص عنها الناس إذ قربوا لها % % ومنهم قروم في الحبال وبزل % 27(@)(@@) % ألم يك في التجريب وعظ فينتهي % % إليه ولا للحزم وعظ فيقبل % 28(@)(@@) % أقول وركن الدين سمع مصدق % معي ولسان شاهد لي معدل % 29(@)(@@) % إذا هو شام المرهفات وسلها % % درى أنها أمضى شباة وأعمل % 30(@)(@@) % رأى بك وجه الرشد والوقت فترة % وباب الهدى والملك شرع مضلل % PageV01P2152 31(@)(@@) % ولا أمن إلا أن سيفك يتقى % % ولا رزق إلا أن كفك تهطل % 32(@)(@@) % كأنك في التدبير وحي منزل % لنا أو نبي في السياسة مرسل % 33(@)(@@) % فلولا اتقاء العجب لم يمل طرفه % % على القرب منك الناظر المتأمل % 34(@)(@@) % ولو شئت أن تعطي علاءك حقه % % سموت فخاطبت الكواكب من عل % 35(@)(@@) % خليلي والأنباء حق وباطل % وتسند أخبار الكرام وترسل % 36(@)(@@) % بدينكما هل في فخار سمعتها % % به الذكر يروى والأحاديث تنقل % 37(@)(@@) % كمجد بنو عبد الرحيم ولاته % يشيد في أبياتهم ويؤثل % 38(@)(@@) % وهل في بدور الأرض بعد ظهورها % % وجوه لهم يوم السؤال وأنمل % 39(@)(@@) % أقيما فلا الأخطار تركب دونهم % % لحظ ولا العيس المراسيل ترحل % 40(@)(@@) % قعا بالأماني الطائرات حوائما % % ترف على باب الوزير وترفل % PageV01P2153 41(@)(@@) % إلى ملك لا الحق يدفع عنده % % بعذر ولا الميعاد بالمطل يقتل % 42 
ms686	(@)(@@) % يعاقب إصلاحا ويعطى تبرعا % % وكالمنع إعطاء الفتى وهو يسأل % 43(@)(@@) % صبا بالمعالي وهو في خرز الصبا % % يدارى بها في مهده ويعلل % 44(@)(@@) % وأصفى خليليك الذي كنت تربه % وأحلى حبيبك الذي هو أول % 45(@)(@@) % على سرجه إن أركبته حمية % أخو لبد بادي الطوى متبسل % 46(@)(@@) % غضوب إلى أن تغسل العار كفه % % ولو بدم والعار بالدم يغسل % 47(@)(@@) % وفي دسته يوم الرضا البدر ضاحكا % % إلى وفده والعارض المتهلل % 48(@)(@@) % حمى الله للأيام منك بقية % هي الدهر والأيام أو هي أفضل % 49(@)(@@) % مددت يدا بالمكرمات بسطتها % % فطالت تنال النجم أو هي أطول % 50(@)(@@) % فكيف إليها الرزق وهي مخوفة % وكيف إليها الموت وهي تقبل % PageV01P2154 51(@)(@@) % ولا كان هذا الشمل مما يروعه % % صدوع ولا ذا الظل مما يحول % 52(@)(@@) % إذا غبت طارت بي على النأى لوعة % تقيم المطايا وهي نحوك ترقل % 53(@)(@@) % وخلفتني أما نهاري فمطلق % كعان وأما لون ليلي فأليل % 54(@)(@@) % يراني صحيحا من يراني صابرا % % وما ذاك إلا أنني أتجمل % 55(@)(@@) % ولا وجه إلا وهو عني معرض % ولا كف إلا وهو دوني مقفل % 56(@)(@@) % إذا ذكروا ما موضعي منك والذي % % إليك به من حرمة أتوسل % 57(@)(@@) % وأنى قد حرمت نفسي عليهم % ورقى ملك في يديك محلل % 58(@)(@@) % رأيت أخي فيهم عدوا مكاشحا % % ومطري فيهم عائبا يتعلل % 59(@)(@@) % فلا ينحسم داء هواك يجره % % ولا عز قلب في ودادك يبذل % 60(@)(@@) % ولا فاتني هذا الذرا الرحب موطنا % % لعزي ولا هذا البساط المقبل % PageV01P2155 61(@)(@@) % وكان الذي بقى لي العمر فضلة % لمدحكم تبقى وفيكم تؤجل % 62(@)(@@) % تسدي لكم في كل يوم وشائعا % من الفخر مصبوغاتها ليس تنصل % 63(@)(@@) % لها من علاط الجهد وسم مخلد % يمر عليه الدهر والدهر مغفل % 64(@)(@@) % نجائب أمات القريض بمثلها % % عقائم إلا أن فكري ينسل % 65(@)(@@) % نوازي من بين الضلوع كأنما % % يجيش بها من بين جنبي مرجل % 66(@)(@@) % على اسمك تحدى أو بوصفك تقتضى % % صعابا فتعنو في الحبال وتسهل % 67(@)(@@) % فلو كنت فيها خائفا بخل خاطري % % لسمحه إحسانك المتقبل % 68(@)(@@) % تضوع بها أوصاف 
ms687	 فخرك ما جرت % على الأرض رعناء التنسم شمأل % 69(@)(@@) % كأني إذا جررت فيك ذيولها % % أمسك في أذيالها وأمندل % 70(@)(@@) % وينصرني فيها على الخصم أنني % % على المجد فيكم والعلا أتوكل % PageV01P2156 71(@)(@@) % بقيت لها وحدي وفي الناس أهلها % % كثير ولكن يدعون وأعمل % 72(@)(@@) % ومنها ليوم المهرجان قلادة % تحليه والأيام تحلى وتعطل % 73(@)(@@) % وإن كان يوما سابقا بجماله % % فجلوته فيها أتم وأجمل % 74(@)(@@) % تلين لكم أعطافها وهي شمس % وتطلق من أرساغها وهي تشكل % 75(@)(@@) % ثناء عليكم آخر الدهر عاكف % وود بكم دون الأنام موكل % PageV01P2157 البحر : - 1(@)(@@) % هل عند هذا الطلل الماحل % من جلد يجدي على سائل % % 2(@)(@@) % أصم بل يسمع لكنه % % من البلى في شغل شاغل % 3(@)(@@) % وقفت فيه شبحا ماثلا % % مرتفدا من شبح ماثل % 4(@)(@@) % ولا ترى أعجب من ناحل % يشكو ضنا الجسم إلى ناحل % 5(@)(@@) % لهفك يا دار ولهفي على % % قطنيك المحتمل الزائل % 6(@)(@@) % قلبي للأحزان بعد النوى % % وأنت للسافي وللناخل % 7(@)(@@) % مثلك في السقم ولي فضلة % بالعقل والبلوى على العاقل % 8(@)(@@) % يا أهل نعمان اسمعوا دعوة % إن أسمعتكم من لوى عاقل % 9(@)(@@) % هل زورة تمتعنا منكم % وهنا بميعاد الكرى الباطل % 10(@)(@@) % أم هل لجسم قاطن أن يرى % % عودة قلب معكم راحل % PageV01P2158 11(@)(@@) % قد وصلت فانتظمت أضلعي % % سهام ذاك الهاجر الواصل % 12(@)(@@) % رمى فأصماني على بابل % مقرطس لا شل من نابل % 13(@)(@@) % ألحاظه السحر وألفاظه الس % % كر وهذا لكمن بابل % 14(@)(@@) % ردوا ولو يوما ولو ساعة % على الغضا من عيشنا الزائل % 15(@)(@@) % لي ذلة السائل ما بينكم % % فلا تفتكم عزة الباذل % 16(@)(@@) % أفقرني الحب إلى نيلكم % % ولم أكن أرغب في النائل % 17(@)(@@) % لا أسأل الأجواد ما عندهم % % وأجتدي منكم ندى الباخل % 18(@)(@@) % ولا يرى المنجز عطفي له % % وجهي وأرجو عدة الماطل % 19(@)(@@) % لم تغمز الأطماع لي جانبا % % ولا أمالت منة كاهلي % % 20(@)(@@) % نغص عندي العرف أني أرى % % طول يد المعطى على القابل % PageV01P2159 21(@)(@@) % جربت أقسامي فما أشبه ال % % جائر من حظي بالعادل % 22(@)(@@) % آليت لا أحمل فرض العلا % % ونفلها إلا على 
ms688	 حامل % 23(@)(@@) % ممن يرى أن التماس الغنى % % يد على المأمول للآمل % 24(@)(@@) % سهل على العابث في ماله % % وإن طغى صعب على العاذل % 25(@)(@@) % من طينة في المجد مجبولة % تبعث طيبا كرم الجابل % 26(@)(@@) % لاطفت الأرض بها مزنة % تصفقت من مائها الهاطل % 27(@)(@@) % واستودعتها من قراراتها % % حمى على الشارب والغاسل % 28(@)(@@) % أو درة جاد بها بحرها % % عفوا فألقاها على الساحل % 29(@)(@@) % شق بها عبد الرحيم الثرى % % عن كوكب أو قمر كامل % 30(@)(@@) % فانتشرت تملأ عرض الفلا % % بورك في النسل وفي الناسل % PageV01P2160 31(@)(@@) % قوم إذا شدوا الحبى وانتموا % % شقوا على النابه والخامل % 32(@)(@@) % فطامنت شهب الدراري لهم % % تطامن المفضول للفاضل % % 33(@)(@@) % أو ركبوا جريا إلى معشر % تبادروا بالقدر النازل % 34(@)(@@) % يزهى بأن لامس أيمانهم % % ما هز من نصل ومن ذابل % 35(@)(@@) % ويستطيل القرن لاقى الردى % % بهم وما في الموت من طائل % 36(@)(@@) % فيشرف السيف بمن شامه % % ويفخر المقتول بالقاتل % 37(@)(@@) % والناس إما طالب جودهم % % أو هارب ما هو بالوائل % 38(@)(@@) % تكسر بالخارج أيديهم % % وتفتح الأرزاق بالداخل % 39(@)(@@) % كم أصلحوا الفاسد من دهرهم % % وقوموا المائد بالعادل % 40(@)(@@) % واحتكموا بالعدل في دولة % تحكم الحق على الباطل % PageV01P2161 41(@)(@@) % مفوض الملك إلى غيرهم % % معزب في النعم الهامل % 42(@)(@@) % دافعت دهري خائفا منهم % بناصر في الزمن الخاذل % 43(@)(@@) % وشد ظهري من علي فتى % % لم أستند منه إلى مائل % 44(@)(@@) % إلى زعيم الدين خضنا بها % % غمار تيه البلد الماحل % 45(@)(@@) % كل فتاة جائل نسعها % % على عسيب في الفلا جائل % 46(@)(@@) % تلاعب الأرض حسا أو زكا % قدحين بالخافض والشائل % 47(@)(@@) % تحمل أشباحا خفافا وآ % % مالا ثقيلات على الناقل % 48(@)(@@) % فوق حواياها وأعجازها % % من اسمه وسم على القافل % 49(@)(@@) % حتى أنخنا بربيع المنى الز % % اكي وربع الكرم الآهل % 50(@)(@@) % فكان لا خوف على الآمن ال % % جار ولا حرمان للسائل % PageV01P2162 51(@)(@@) % على يد تهزأ في جامد ال % % عام بماء المزنة السائل % 52(@)(@@) % وغرة تخلق في سنة ال % % بدر خشوع الغائر الآفل % 53(@)(@@) % يقدح للوفد بها بشره % % شعشعة البارق في الوابل % 54 
ms689	(@)(@@) % أحرز خصل السبق في عشره ال % % أولى على القارح والبازل % 55(@)(@@) % وساد في المهد فما فاته % شبلا مكان الأسد الباسل % 56(@)(@@) % بوالد من قبله تالد % وزائد من نفسه فاضل % 57(@)(@@) % بعت بك الناس فلم أنصرف % بندم من غبن الناس لي % % 58(@)(@@) % وأعلقتني بك ممسودة % ما أسحلت منها يد الفاتل % 59(@)(@@) % تلون الناس فما كنت لي % % بحائل الود ولا ناصل % 60(@)(@@) % متى أثقف صعدة تدفع ال % % أحداث عن صدري وعن كاهلي % % PageV01P2163 61(@)(@@) % يكن بنو الدنيا أنابيبها % % وأنت منها موضع العامل % 62(@)(@@) % فلتجزني نعماك من مقولي % % إن كوفئ الفاعل بالفاعل % 63(@)(@@) % كل بعيد في السرى شوطها % % تسابق الفارس بالراجل % 64(@)(@@) % قاطنة تحمل أبياتها ال % % أمثال في المنتسخ الراحل % 65(@)(@@) % زادا لمن سافر يبغي الغنى % % ومغنما للقادم القافل % 66(@)(@@) % مطاربا في الجد والهزل ما % % وسمن بالمادح والغازل % 67(@)(@@) % عدوها مع حبه عيبها % % في خبل من حسنها خابل % 68(@)(@@) % مبشرات بالتهاني لكم % % في كل يوم علم ماثل % 69(@)(@@) % وكلما ودع عام بها % % أعطاكم الذمة في القابل % 70(@)(@@) % تقصر الأقدار عن ملككم % % ما قصر الحافي عن الناعل % PageV01P2164 البحر : - 1(@)(@@) % لها كل يوم نشطة وعقال % وفي كل دار حلة وزيال % 2(@)(@@) % فلا شوق إلا بالزيارة يشتفى % % ولا بعد إلا باللقاء يزال % 3(@)(@@) % إذا العيس حنت للمعاطن لم يصح % بأعناقها إلف عليه يمال % 4(@)(@@) % سفا البيد مرعاها الجميم ووردها ال % % زلال سراب بالفلاة وآل % 5(@)(@@) % فمن حاكم بين الدؤوب وبينها % % إذا ما تقاضت أظهر ورحال % 6(@)(@@) % ومنصف أيديها إذا ما تقاصرت % % خطاها وبوع الليل بعد طوال % 7(@)(@@) % يرامى بها الأخطار كل ممرن % بحمل خطوب الدهر وهي ثقال % 8(@)(@@) % بصير بكيد الليل لا يعتشي به % % ظلام وأبصار النجوم ذبال % 9(@)(@@) % أخو قفرة لا يؤنس الذئب ريحها % % فما هي إلا خابط وضلال % 10(@)(@@) % وأسهم ذاوى الشخص خاف كأنه % % مع الصبح في خد السماوة خال % PageV01P2165 11(@)(@@) % يرى الوطن المحبوب حيث تفيأت % عليه العلا لا قلة وظلال % 12(@)(@@) % ويبدنه عرق الهواجر لحمه % وأسمن مجد ما اقتناه هزال % 13(@)(@@) % جب الأرض ما 
ms690	 دامت عليها نشيطة % وفيها لسار مسرح ومجال % 14(@)(@@) % فإما ذرى أفق مسحت هلاله % % وإما ثرى أرض عليك يهال % 15(@)(@@) % يخوفني فيما أطوف بالردى % % كأنى إن قايلت منه أقال % 16(@)(@@) % وهل يئل الإنسان مما وراءه % وقدامه مفضى له ومآل % 17(@)(@@) % وللموت خير من حياة مضيمة % ومن عيشة أعلى بها وأطال % 18(@)(@@) % ورزق يد السئول مفتاح بابه % % وشر نوال ما جناه سؤال % 19(@)(@@) % دعيني أعادي الدهر إن صديقه % % يكاد ينادى وده ويغال % 20(@)(@@) % وأنضو قناع السلم بيني وبينه % % كفاحا وسلم الغادرين قتال % PageV01P2166 21(@)(@@) % فلو كان حرا نفسه ووفاؤه % % لما كان حر العرض منه يذال % 22(@)(@@) % ولو كرمت أخلاقه الهجن لم تحل % لديه لأبناء المكارم حال % 23(@)(@@) % وعز بنو عبد الرحيم ونالهم % % فما كان بالأيدي القصار ينال % 24(@)(@@) % ولم يتغور كوكب من سمائهم % % ولم يتخمر بالسرار هلال % 25(@)(@@) % ومن موقه لم يدرئهم بصرفه % % وهم جنن من صرفه ونصال % 26(@)(@@) % ولن تشظى شقة من عصاهم % لها قوة من كفه وصيال % 27(@)(@@) % بمن وتعرت دولة من جمالهم % % يكون عليها شارة وجمال % 28(@)(@@) % ومن ظل تستأسى الملوك برأيه % % ويحسم داء الملك وهو عضال % 29(@)(@@) % تهاوت سلوك العقد فهي بدائد % وأرخيت الأمراس فهي سحال % 30(@)(@@) % فكيف يبين الخرت والعين عورة % ويبرم أمر واليمين شمال % PageV01P2167 31(@)(@@) % يريدون أن تستنهضوا بوسوقها % % مطايا خطاها بالحمول ثقال % 32(@)(@@) % وقد علقوا البزل القروم وقرنت % % بكار تضاغى تحتها وفصال % 33(@)(@@) % فأوشك سار أن يقيده الونى % % وأوثق أقتاد المطي كلال % 34(@)(@@) % سيقصم ظهر بالحوية نافر % وتسقط حتى أنسع وجلال % 35(@)(@@) % قضاء سقيم ثم يعقب صحة % وإن طال من داء السقام مطال % 36(@)(@@) % وسقيا قليب ما صفت وتكدرت % % تداولها بين الرجال سجال % 37(@)(@@) % وكم زحمتكم قبلهامن ملمة % فطاحت رفاتا والجبال جبال % 38(@)(@@) % وجادلكم في حقكم متكبر % بباطله ثم المجال مجال % 39(@)(@@) % ينور قدحا من زنيد ورى له % % من الظن لا مرخ ولا هو ضال % 40(@)(@@) % تلاعا شفوفا للعيون ومالها % % إذا احتلبت فوق التراب بلال % PageV01P2168 41(@)(@@) % وستة أيام الدوام بهائم % منصفة إلقاحهن حيال % 42(@)(@@) % على الله 
ms691	 فاحملها وثق بعوائد % % لها في عداكم عثرة ونكال % 43(@)(@@) % فإن ولغت في نعمة بعد نكبة % % فقد تيبس الغدران ثم تسأل % 44(@)(@@) % وللشر أيام تمر وتنقضي % % كما لمسرات النعيم زوال % 45(@)(@@) % إذا سلمت أعيانكم وأصولكم % % فكل الذي فوق التراب جفال % 46(@)(@@) % كأنك بالإقبال قد قام عنكم % يرامي وأبراج السعود نبال % 47(@)(@@) % وقد خفقت تهفو برايات نصركم % % رياح العلا منها صبا وشمال % 48(@)(@@) % فما عزلكم إلا خديعة ليلة % وما سر منه الشامتين خيال % 49(@)(@@) % فلا يفرح الباغي عليكم بسعيه % % فما كل عثرات السعاة تقال % 50(@)(@@) % فإن كان بعض الصلح أغراه مرة % فسوف بما قد كال بعد يكال % PageV01P2169 51(@)(@@) % وما مبتغ نقل الوزارة عنكم % سوى سائل بالطود كيف يشال % 52(@)(@@) % يدرون منها غير جار وإنها % % رحى بيتكم قطب لها وثفال % 53(@)(@@) % لها بينهم ذل الغريب وأنتم % قبيل لها دون الأنام وآل % 54(@)(@@) % إذا فارقتكم لم تكن عن خيانة % نواها ولا جر الفراق ملال % 55(@)(@@) % فيعطفها شوق إليكم وصبوة % ويصرفها عنكم صبا ودلال % 56(@)(@@) % وأنت الذي لا الخوف يسطو بصبره % % ولا بتهاويل الزمان يهال % 57(@)(@@) % تجربك الأحداث لا السيف يلتوي % % هزيما ولا الهضب الأشم يزال % 58(@)(@@) % سموت فما يسمو سموك شارق % كأنك علو والنجوم سفال % 59(@)(@@) % وأعطيت في المعروف مالك كله % % فما لك في دفع النوائب مال % 60(@)(@@) % وصدقت وصف المادحين فإن غلوا % % فلا قول إلا وهو منك فعال % PageV01P2170 61(@)(@@) % خلقت كما سر العلا وشجا العدا % % فأنت صلاح مرة ووبال % 62(@)(@@) % قسائم ماء المنع منها محرم % وكف نبات الرزق منه حلال % 63(@)(@@) % فلا تفجع الدنيا بمجدك إنه % % لمجد بنيها قبلة ومثال % 64(@)(@@) % ولا برحت تشقى وتندم دولة % لها عوض من غيركم وبدال % 65(@)(@@) % لقد عكسوا ألقابهم وسماتها % % إلى أن وهى ركن وذل جلال % 66(@)(@@) % وليدة ناديكم وغرس أكفكم % % ترب بتدبيراتكم وتعال % 67(@)(@@) % فعادت بكم أيامكم مثلما بدت % % وسعدكم عال فليس يطال % 68(@)(@@) % يراضعكم كأس المودة شربها % % رضاع دوام ليس عنه فصال % 69(@)(@@) % ولاح لعين الملك وجه صباحه % فإن السرى تحت الظلام ضلال % 70(@)(@@) % لقد 
ms692	 نزعته من أخيك إذا انتدى % % ومنك مقام في العلا ومقال % PageV01P2171 71(@)(@@) % فهل في تميم نهضة بمفاخر % إذا بز منها صاحب وعقال % 72(@)(@@) % وزادتك حفظا للعهود خرائد % لها الفم حال والفؤاد حجال % 73(@)(@@) % تعوذ بمهديها وبالله أن ترى % % أواصر منها قطعت وحبال % 74(@)(@@) % وأن تتبع الأقلام في مدح غيركم % % وذلك عار عندها وخبال % 75(@)(@@) % بقاؤك يغنيها وودك مهرها % % متى فاتها رفد لكم ونوال % 76(@)(@@) % لها منك كفؤ لا تقر لغيره % % إذا كان مما تشتهيه بعال % 77(@)(@@) % يسوم فيها المهرجان طريرة % لها يوم هجر العاشقين وصال % 78(@)(@@) % تعود بها بشرى بعود زمانكم % % له عائف جربتموه وفال % PageV01P2172 البحر : - 1(@)(@@) % ألا فتى يسأل قلبي ماله % % ينزو إذا برق الحمى بدا له % % 2(@)(@@) % أصبوة إلى رخى باله % عن وجده تسقى البروق باله % % 3(@)(@@) % وهبه شام بارقا تبله % % أرواحه فكيف شام خاله % % 4(@)(@@) % خاطفه كما اخترطت صارما % % جاذب جهد قينه صقاله % % 5(@)(@@) % فهب يرجو خبرا من الغضا % % يسنده عنه فما روى له % % 6(@)(@@) % أراد نجدا معهببابل % إرادة هاجت له بلباله % % 7(@)(@@) % وانتسم الريح الصبا ومن له % % بنفحة من الصبا طواله % % 8(@)(@@) % وبالنخيل نائم عن أرقى % % ما استعرض الليل وما استطاله % % 9(@)(@@) % أحببت فيه كل ما أحببته % % حتى تعشقت له عذاله % % 10(@)(@@) % أصغى إلى الواشي فحل عهده % % والغدر ما غير عندي حاله % % PageV01P2173 11(@)(@@) % وملني على النوى ولم أكن % % أحذر مع بعاده ملاله % % 12(@)(@@) % مر وبقاني أغادي ربعه % % بجسد يحسبه تمثاله % % 13(@)(@@) % ولا أكون كلفا بحبه % % ما لم يناحل بدني أطلاله % % 14(@)(@@) % ويوم ذي البان وما أسأرت من % % ذي البان إلا أن أقول ما له % % 15(@)(@@) % وأفرخت عن فتن جفونه % % سبت مهاة الرمل أو غزاله % % 16(@)(@@) % لا والذي لو عرف النصف حنا % % على أسير الشوق أو أوى له % % 17(@)(@@) % لولا خشوعي لهواه لم يدس % ظهر الثرى من أجتدي نواله % % 18(@)(@@) % مشى فيا سبحان من عدله % % غصنا ويا سبحان من أماله % % 19(@)(@@) % إلا بنو عبد الرحيم فالندى % % يعدهم قبيله وآله % % 20(@)(@@) % قوم بأسمائهم استغنى الذي % % أقسم لا يسأل خلقا 
ms693	 ماله % % PageV01P2174 21(@)(@@) % مباركو الأوجه تلقى بهم % غرة شهر الخصب أو هلاله % % 22(@)(@@) % إن أخلف الربيع واستخلفهم % % على العباد فعلوا فعاله % % 23(@)(@@) % أو أثبتت أخلاق قوم نعمة % كانوا سيوف الدهر ورجاله % % 24(@)(@@) % واستخرجوا من طينة كانت بهم % % عنصر بيت الفخر أو صلصاله % % 25(@)(@@) % بنى عليها يزدجرد لهم % ما كان كسرى قبله بنى له % % 26(@)(@@) % صفتهم الأيام حتى استخلصت % % منهم سلاف المجد وزلاله % % 27(@)(@@) % يرى أب من ابنه أنجب ما % % سر ابن غيل أن يرى أشباله % % 28(@)(@@) % لو ذارع الأفق غلام منهم % ببيته لناله وطاله % % 29(@)(@@) % أو طالع السؤدد من ثنية % لعمه أبصر منها خاله % % 30(@)(@@) % وانتفض الملك فسل منهم % مهندا صيره كماله % % PageV01P2175 31(@)(@@) % ألقى إليه حبله فقاده % % على السواء فهدى ضلاله % % 32(@)(@@) % أبلج لا تبصر من هيبته % جماله حتى ترى جلاله % % 33(@)(@@) % تنهال أطواد الخطوب حوله % % فلا ترى منهن خطبا هاله % % 34(@)(@@) % شد على الدولة ضبطا فهي لا % % تجذب مذ ناط بها حباله % % 35(@)(@@) % قام لها وقام غيران بها % % وزارة ما صلحت إلا له % % 36(@)(@@) % خائفة تطلب من يجيرها % % في الناس حتى علقت أذياله % % 37(@)(@@) % ولم تزل من قبل أن يقبلها % % تكثر في العطف بها سؤاله % % 38(@)(@@) % فظفرت بمن سلت كل أبى % % غدر بها مذ رزقت وصاله % % 39(@)(@@) % من بعد ما دارت زمانا صده % % بوجهه واحتملت دلاله % % 40(@)(@@) % أقرها تدبيره في منصب % لو زاله المقدار ما أزاله % % PageV01P2176 41(@)(@@) % بالصارمين سيفه ورأيه % نال من اشتراطها ما ناله % % 42(@)(@@) % وكرم لو كاثر السحب به % % لوازن القطار أو لكاله % % 43(@)(@@) % إذا سقى البحر المحيط ملحه % % سقى السؤال معذبا سلساله % % 44(@)(@@) % تدفق يريك ما أناله % % تحت يديه واديا أساله % % 45(@)(@@) % لا يألم الفقر الذي محضه % % يوما إذا عم الغنى سؤاله % % 46(@)(@@) % ولا يبالي أملا فات إذا % % بلغ كل طالب آماله % % 47(@)(@@) % حببه إلى النفوس خلق % لو ذاقه عدوه حلا له % % 48(@)(@@) % وبشر وجه لو سكبت ماءه % % في كأسه حسبته جرياله % % 49(@)(@@) % والحلم حتى لو وزنت حلمه % إلى أبان لم يزن مثقاله % % 50(@)(@@) % مشت على محجة 
ms694	 سوية % أفعاله تابعة أقواله % % PageV01P2177 51(@)(@@) % وقود الناس بحبل عادل % لم ينتكث مذ ولي أنفتاله % % 52(@)(@@) % فمحسن يرجوالنجاة عنده % % إلى مسئ يتقى نكاله % % 53(@)(@@) % والناس بين آمن وخائف % % كل يرى حاضرة أعماله % % 54(@)(@@) % من حامل ألوكة من ظالع % % مخفف يبثها أثقاله % % 55(@)(@@) % قريبة المطرح لاجياده % % في طرقها ينضي ولا جماله % % 56(@)(@@) % يستأذن السؤدد في إدآبها % % والمجد حتى يليا إيصاله % % 57(@)(@@) % قل للوزير إن أصاخ سمعه % % إلى الهوى المظلوم أو وعى له % % 58(@)(@@) % يا لمحب مغضب لو أنه % % في حبكم مستعذب خباله % % 59(@)(@@) % لو جد في أن يستقيل ساعة % من الغرام بك ما استقاله % % 60(@)(@@) % تغير الأحوال بالناس ولا % % يغير الوجد بكم أحواله % % PageV01P2178 61(@)(@@) % نسى فيما يخطر يوما ذكره % ببالكم وقد شغلتم باله % % 62(@)(@@) % ومل غير واصل وإنما ال % % مملول من كاثركم وصاله % % 63(@)(@@) % تركتموه والزمان وحده % ملاقيا بغدره أهواله % % 64(@)(@@) % مخاوضا بمنة مضعوفة % بحاره مزاحما جباله % % 65(@)(@@) % منتبذا نبذ الحصاة إن جفا % % أو زار لم يحفل به إحفاله % % 66(@)(@@) % أين زماني الرطب فيكمتربت % يد زمان قلصت ظلاله % % 67(@)(@@) % وعهدى التالد فيكم ما الذي % % بدله عندكم أو غاله % % 68(@)(@@) % ها أنا أبكيه فهل من ردة وذلك البشر الذي ألفته منك حفيا بي ما بدا له % % لفائت على فتى بكى لهسقط بيت ص % % 69(@)(@@) % وملبس هو الجمال لم تزل % % تكسوه لم سلبتني سرباله % % 70(@)(@@) % الله يا أهل الندى في رجل % إن فات عز أن تروا أمثاله % % PageV01P2179 71(@)(@@) % لا تلد الأرض الولود أبدا % % لنصر أحسابكم أخا له % % 72(@)(@@) % أنتم ربيعي فإذا أعطشتم % أرضي من يبل لي بلاله % % 73(@)(@@) % كيف يكون مثلا في صدكم % % مسير في مدحكم أمثاله % % 74(@)(@@) % قد طبق الغبراء ما أرسله % فيكم وليس تاركا إرساله % % 75(@)(@@) % من كل متروك عليه شوطه % % قد سلم السبق له خصاله % % 76(@)(@@) % لا تطمع النكباء أن تدركه % ولا يد الجوزاء أن تناله % % 77(@)(@@) % يجتمع الناس على توحيده % % ويجلس الإفصاح إجلالا له % % 78(@)(@@) % فكل مسموع سواه وثن % يضل من يعبده ضلاله % % 79(@)(@@) % أنشده مستعذبا لمثله % % في زمني كأن 
ms695	 غيري قاله % % 80(@)(@@) % يزوركم في كل يوم غبطة % يختال في دوركم اختياله % % PageV01P2180 81(@)(@@) % تعرفون فضل إقبالكم % إذا رأيتم نحوكم إقباله % % 82(@)(@@) % وقد عرفتم صدقه مبشرا % % ويمنه إذا زجرتم فاله % % 83(@)(@@) % فكاثروا أبياته بعدد % من عمركم وسايروا محاله % % 84(@)(@@) % واستخدموا الأقدار في أمركم % تسمعه وتسرع امتثاله % % 85(@)(@@) % لكم من الملك الذي أطابه % % قاسمه بالعز وأطاله % % 86(@)(@@) % مكتسب بسعيكم إلى العلا % % حتى يكون حلوه حلاله % % 87(@)(@@) % وغدرة الأيام لعدوكم % % أولى لمن عاداكم أولى له % % PageV01P2181 البحر : - 1(@)(@@) % ما المجد إلا بالعزيمة فاعزم % من لم يغامر لم يفز بالمغنم % 2(@)(@@) % كم ذا القنوع بوقفة المردود عن % % باب العلاء وجلسة المتظلم % 3(@)(@@) % متأخرا بالفضل أبخس حقه % % وأرى مكان العاجز المتقدم % 4(@)(@@) % حتى كأن خليج قلبي ليس في % % صدري ولا سيف انتصاري في فمي % % 5(@)(@@) % قد كان يرتاب الغبي بفطنتي % % ويريبني بالعجز فرط تلومي % % 6(@)(@@) % ومشى إلى الضيم مشى تسلط % وطماعة في عفتي وتسلمي % % 7(@)(@@) % وأصاتت الأيام بي قم تحتشم % % وأشارت العلياء خاطر تعظم % 8(@)(@@) % إن كنت تنكر يا زماني جلستي % % فلأنهضن لها نهوض مصمم % 9(@)(@@) % ولتدعوني ثائرا مستيقظا % % إن كنت أمس دعوتني في النوم % 10(@)(@@) % ولأنفضن من الهوينى منكبي % % نفض العقاب سقيط طل معتم % PageV01P2182 11(@)(@@) % ولألقينك راكبا من عزمتي % % جرداء تفتح في الطريق المبهم % 12(@)(@@) % في كف راكبها عنان مسمح % % في السبق غرة وجهه لم تلطم % 13(@)(@@) % يكفيه وزعة سوطه ولجامه % % ما مس في فخذيه إثر المحزم % 14(@)(@@) % تنضو الجياد كأنها ملمومة % هوت انحدارا من فقار يلملم % % 15(@)(@@) % تحت الدجى منها شهاب ثاقب % جن الخطوب بمثله لم ترجم % 16(@)(@@) % تهفو على أثر الطراد كأنها % % قبس تهافت عن زناد مصرم % 17(@)(@@) % تجتاب بي أجواز كل تنوفة % % عذراء ما وطئت وخرق أعجم % 18(@)(@@) % وإذا حفظت النجم فيها لم أبل % ما ضاع من أثر بها أو معلم % 19(@)(@@) % ولقد ركبت إلى المآرب قبلها % % ظهر الخطار سلمت أو لم أسلم % 20(@)(@@) % أبتاع عزا بالحياة ومن يمل % حب الحياة به يهن أو يظلم % PageV01P2183 21(@)(@@) % في فتية يتصافنون مياههم % % بالراح من 
ms696	 حلب السحاب المصرم % 22(@)(@@) % وإذا عياب الزاد فيهم أصفرت % كان الممول كله للمعدم % 23(@)(@@) % متهافتين على الرحال فناكس % سئم الكلال وناصب لم يسأم % 24(@)(@@) % والليل يطويه السرى في مخرم % عنا وينشره الدجى في مخرم % 25(@)(@@) % والنجم في الأفق المغرب راية % بيضاء أو خد الحصان الملجم % 26(@)(@@) % حتى صبحنا المجد في أبياته % % والعز في عادية المتقدم % 27(@)(@@) % كرماء يمسى الضيم من أعراضنا % % وشخوصنا في مزلق متهدم % 28(@)(@@) % فكأن أيدينا الطوال علقن من % % حبل الوزير بذمة وتحرم % 29(@)(@@) % وكأن مسرانا بغرة وجهه % % ومرادنا من نيله المتقسم % 30(@)(@@) % شعب الممالك رأي طب لم يكن % % صدع الزجاجة قبله بملأم % PageV01P2184 31(@)(@@) % جلى على غلوائه متعود % لم يجر طاعة حازم أو ملجم % 32(@)(@@) % ماض يرى أن التأخر سبة % ما آنست علياه وجه تقدم % 33(@)(@@) % خفق اللواء على أغر جبينه % % قبل اللقاء بشارة بالمغنم % 34(@)(@@) % يصل القناة بفضلة من زنده % % ويزيد حد لسانه في اللهذم % 35(@)(@@) % وامتد باع الملك منه بساعد % % متوغل قبل الحسام المخذم % 36(@)(@@) % تزهى الدسوت إذا احتبى متوسدا % % وتضاءل الأحساب ساع ينتمي % % 37(@)(@@) % ويرد في صدر الزمان براحة % تزرى أناملها بنوء المرزم % % 38(@)(@@) % بيضاء يخضر العنان بمسها % % وتشيب ناصية الحصان الأدهم % 39(@)(@@) % وإذا تدوفعت السياسة أسندت % % من رأيه بجنوب طود معصم % 40(@)(@@) % وإذا الملوك دعوا بخالص مالهم % % كان الدعاء مؤيد الملك اسلم % PageV01P2185 41(@)(@@) % يسمون خير ملقب وضعوا له % % تاج الفخار على جبين الميسم % 42(@)(@@) % ويقلدون أمورهم متعطفا % % يرعى لحادثهم حقوق الأقدم % 43(@)(@@) % طبا بأدواء البلاد إذا سرت % % للجور فيها علة لم تحسم % 44(@)(@@) % جاءت به أم الوزارة فارسا % % ولدته بعد تعنس وتعقم % 45(@)(@@) % متمرنا أحيا دروس رسومها الاولى % % وزاد فخط مالم يرسم % 46(@)(@@) % فغدت ظبا الأقلام يخدمها الظبا % % ويقاد ألف متوج بمعمم % 47(@)(@@) % لله درك والقنا يزع القنا % % بك والفوارس بالفوارس ترتمي % % 48(@)(@@) % والخيل تعثر بالقنا برءوسها % % متبرقعات بالعجاج الأقتم % 49(@)(@@) % وعليك من طيش الحلوم سكينة % وعلى سفاه الحرب ثوب تحلم % % 50(@)(@@) % ومفاضة الأذيال يحسب متنها % % أدراج ماء في الغدير منمنم % PageV01P2186 51(@)(@@) % رتقاء يزلقبالأسنة 
ms697	 سردها % % زلق الصفاة بليلة بالمنسم % 52(@)(@@) % ما زرها جبن عليك وإنما % % حكموا بفضل الحزم للمستلئم % 53(@)(@@) % كم قدت من عنق بسيفك لم يقد % فإذا ظفرت رحمت من لم يرحم % 54(@)(@@) % وإذا الإباء الحر قال لك انتقم % % قالت خلائقك الكرام بل احلم % 55(@)(@@) % شرع من العفو انفردت بدينه % % وفضيلة لسواك لم تتقدم % 56(@)(@@) % حتى لقد ود البرئ لو أنه % % أدلى إليك بفضل جاه المجرم % 57(@)(@@) % لا تصلح الدنيا بغير معدل % يسقي بكأسى شهدها والعلقم % 58(@)(@@) % يقظان يبسط راحة أخاذة % بحقوقها من مغنم أو مغرم % 59(@)(@@) % إن سيل رفدا فهي ينبوع الندى % % أو سيم ضيما فهي ينبوع الدم % 60(@)(@@) % والناس إما راغب أو راهب % فاملكهم بالسيف أو بالدرهم % PageV01P2187 61(@)(@@) % ضحكت بك الأيام بعد عبوسها % % وأضاء عدلك في الزمان المظلم % 62(@)(@@) % وتذللت لك كل بكر صعبة % في الملك فاركت الرجال وأيم % 63(@)(@@) % كم نعمة لك ألحقت متأخرا % % بالسابقات وحلقت بمحوم % 64(@)(@@) % وعطية أسرفت فيها لم تعد % في إثرها بلواحظ المتندم % 65(@)(@@) % أنا غرس نعمتك ارتوت بك أيكتي % % بعد الجفوف وقام عندك موسمي % % 66(@)(@@) % أبصرت موضع خلتي وسمعت لي % % وسواك من قد صم عني أو عمي % % 67(@)(@@) % أغنيتني بجداك حلا واسعا % عن ضيق بندى سواك محرم % % 68(@)(@@) % ورفعت عن بلل اللئام ورشحهم % % شفتي ببحر من نوالك مفعم % 69(@)(@@) % وحقنت طولا ماء وجهي عنهم % % فكأنما حقنت يمينك لي دمي % % 70(@)(@@) % قد كنت عن مدح الملوك بمعزل % % وعن السؤال على طريق أيهم % PageV01P2188 71(@)(@@) % لا يشفق البخلاء من غضبي ولا % % أرضى بفضل عطية المتكرم % 72(@)(@@) % فنقلت بالإحسان تالد شيمتي % % ونقضت شرط تقللي وتحشمي % % 73(@)(@@) % وأنلتني ما لم أنل فعلمت من % % عادات شعري فيك مالم أعلم % 74(@)(@@) % ولبست أنعمك التي من بعضها % % أن صرت مضطلعا بشكر المنعم % 75(@)(@@) % فلئن أطاعك خاطري أو أفصحت % لك من إباي بنات فكر معجم % 76(@)(@@) % وملكت من مدحي الذي لم يملكوا % % إلا بفرط تكلف وتجشم % 77(@)(@@) % فبما نشرت منوها من سمعتي % % وشهدت غير مقلد بتقدمي % % 78(@)(@@) % ونصرت في الحق غير مراقب % % وحكمت بالإنصاف 
ms698	 غير محكم % 79(@)(@@) % ولئن بقيت لتسمعن غرائبا % % لم تعطها قبلي قوى متكلم % 80(@)(@@) % تلك المحاسن منجبات بطونها % % لك بين فذ في الرجال وتوأم % PageV01P2189 81(@)(@@) % يفضي الحسود لها قضاء ضرورة % بفضيلة الطاري على المتقدم % 82(@)(@@) % تنقاد بين يديك يوم نشيدها % % لفمي خطامة كل سمع أصلم % 83(@)(@@) % يتزاحمون على ارتشاف بيوتها % % حشد الحجيج على جوانب زمزم % % 84(@)(@@) % ذخر الزمان لعصر ملكك كنزها % % حتى تكون منيرة بالأنعم % 85(@)(@@) % وإذا زففت لديك من نحلاتها % % عظم الفصاحة في المقال الأعظم % 86(@)(@@) % نطقت فصاحتها بأنى واحد % والشعر بين ملجلج ومجمجم % 87(@)(@@) % قد عطلت سبل القريض فكلهم % % يتخابطون بجنح أعشى مظلم % % 88(@)(@@) % ما بين حيرة قائل لم يحتشم % % كشف العيوب وسامع لم يفهم % 89(@)(@@) % وتكاثر الشعراء كثرة قلة % فغدا السكوت فضيلة للمفحم % 90(@)(@@) % فتمل مدحى واحتفظ بي إنني % % زاد المقل ونهزه المتغنم % PageV01P2190 91(@)(@@) % واعطف علي وقد عطفت وإنما % % أبغي المزيد وقد بدأت فتمم % 92(@)(@@) % أعطيتني سرا ولكن لم يبن % % بالمال عندك شهرتي وتوسمي % % 93(@)(@@) % فأجل على عطفي علامة مفخر % % يثني برأيك في من لم يعلم % 94(@)(@@) % يعلو بها بين الأعادي ناظري % % ويبين فضل تحققي وتحرمي % % 95(@)(@@) % وأعن على دنيا حملت ثقيلها % % بك مع تلاشي بنيتي وتهدمي % % 96(@)(@@) % لا تبلني فيها بغيرك حاكما % % لم أخل من شكوى بها وتظلم % 97(@)(@@) % وسنان عن حقي إذا نبهته % % قالت خلائقه الجعاد له نم % 98(@)(@@) % لولاك لم أظفر بنهلة طائر % من ماله المتأجن المتأجم % 99(@)(@@) % يا برد أحشائي صبيحة قال لي % % هذا الوزير فطب صباحا وانعم % 100(@)(@@) % فكأن أوبة مالك ولك البقا % % طرقت بها الأخبار سمع متمم % PageV01P2191 101(@)(@@) % عادت إلى دار السلام سعودها % % بك فارعها وأقم عليها واسلم % 102(@)(@@) % وهب الوصال لأنفس مشتاقة % شوق العطاش إلى السحاب المرهم % 103(@)(@@) % لا حولت عنا ظلالك إنها % % متقيل الضاحي ومأوى المعتم % 104(@)(@@) % وخلا الزمان وعمر ملكك خالد % % لم ينتقض هرما ولم يتخرم % 105(@)(@@) % وطلعت بالإقبال أشرف طالع % % من أفقه وقدمت أسعد مقدم % 106(@)(@@) % ولبست للعيدين ثوبي دولة % أرجين بين مرقش ومرقم % 107(@)(@@) % يصفان طولك بين 
ms699	 ماض معرب % بلسان تحلية وآت معجم % 108(@)(@@) % فخرت بك الأيام حتى كلها % % عيد إلى أيام ملكك ينتمي % % 109(@)(@@) % وغدت عيون الناس عنك كليلة % فأعيذ مجدك من عيون الأنجم % PageV01P2192 البحر : - 1(@)(@@) % ما على منجد رأى ما أهمه % فامتطى ليله وجرد عزمه % % 2(@)(@@) % وسرى هاربا من الضيم يعدو % % غارة بالسرى ويغسل وصمه % 3(@)(@@) % يستنير النجم الخفي ويستق % % دح أيدي القلاص والليل فحمه % 4(@)(@@) % وإذا رابه مريب من الوح % % شة شام الحسام أنسا وضمه % 5(@)(@@) % أنكرت صبغتين خنساء في شع % % ري بياضا وفي أديمي أدمه % 6(@)(@@) % فاعجبي أن جنى البياض على المف % % رق سهم جنى على الوجه سهمه % 7(@)(@@) % ليت هذي البيضاء تأتثيرها في ال % % وجه أعدى تأثيرها في اللمه % 8(@)(@@) % ولكم عيشة من الغر بيضا % % ء تسرت من ليلة مدلهمه % 9(@)(@@) % أنحلتني الدنيا ولم ينحل العم % % ر ومن عز قلبه كد جسمه % 10(@)(@@) % واقتسمت الهموم في صدع دهر % ليس من خلقه اعتدال القسمه % PageV01P2193 11(@)(@@) % ماحقات من الحوادث لو غط % ت على الهلال لم نر تمه % 12(@)(@@) % كل يوم تقودني حاجة الدن % % يا ويعتاص بي علق الهمه % 13(@)(@@) % فيدى تبتغي مجاذبة الرز % % ق ورأسي يأبى جذاب الأزمه % 14(@)(@@) % لو أطعت العفاف ما دنستني % % خلطة في رعاع هذي اللمه % 15(@)(@@) % أو شكرت الصنع الجميل كفتتى % % نعمة الله في ربيب النعمه % 16(@)(@@) % وهب الله للعلا من بنيها % % حسن البر إن فتى عق أمه % 17(@)(@@) % وأضاءت على المحاسن شمس % تتجلى بنورها كل ظلمه % 18(@)(@@) % وسقى المجد من أراكه إسما % % عيل غصنا أطاله وأتمه % 19(@)(@@) % عم بالجود والوفاء أبي % مشبها فيهما أباه وعمه % 20(@)(@@) % ورعى الفضل مبرم العهد لم تخ % % فر لديه ولم ترع قط ذمه % PageV01P2194 21(@)(@@) % أريحي إذا ذكرت الندى أص % % غى بأذنيه مخليا لك فهمه % 22(@)(@@) % وإذا قيل سائل ظنها فغ % % مة مسك من طيبها أو نغمه % 23(@)(@@) % طاهر الشيمتين معتدل الأخ % % لاق جم العطاء عذب الجمه % 24(@)(@@) % لو تعاطيت عصر أخلاقه من % % كرم لاعتصرت ماء الكرمه % 25(@)(@@) % من رجال نشوا ملوكا على الأف % % ق 
ms700	 وداسوا شمس الفخار ونجمه % 26(@)(@@) % ومضوا راكبين في طلب السؤ % % دد شهب الزمان قدما ودهمه % 27(@)(@@) % سمحا لا يصرمون شهور ال % % محل عن ثلة ولا عن صرمه % 28(@)(@@) % ججح في الندى إذا اتبعوا في % % سنن المكرمات كانوا أئمه % 29(@)(@@) % وإذا ثوب الصريخ توافوا % % يملأؤن الفضا كهولا وغلمه % 30(@)(@@) % كل غمر كأن في كفه من % % حتفه في الوغى أمانا وعصمه % PageV01P2195 31(@)(@@) % يمنع الجانب العريض إذا سد % ت به ثغرة الأمور المهمه % 32(@)(@@) % يزن الراسيات حلما فإن كف % يدا بالقناة أنكر حلمه % 33(@)(@@) % يكتفي في الدجى بشعلة عيني % % ه ويكفي الحسام إن شهر اسمه % 34(@)(@@) % وإذا أخدج النساء تمطت % عنه في المنجبات أم متمه % % 35(@)(@@) % درجوا طيبي الحديث وبقو % ك على شعث مجدهم لتلمه % 36(@)(@@) % وإذا كنت عقب ميت فلم تع % % ف له آية ولم تبل رمه % 37(@)(@@) % لا خلت منك أربع الدهر تحيى % % ذكره دارسا وتحفظ رسمه % 38(@)(@@) % وفدى ترب أخمصيك بعيني % % ه أصم الأذنين إن سيل أكمه % 39(@)(@@) % مات هزلا بالذم واللؤم حتى % % أسمن البخل ماله وأجمه % 40(@)(@@) % يتمنى أثواب فخرك عريا % % ن ومن للحليق يوما بجمه % PageV01P2196 41(@)(@@) % أبصرت مقلتاك طرق المساعي % % وهو يعمى عن ضيقهن ويعمه % 42(@)(@@) % ونسبت الجبال وهو يداري % % نسبة مستدقة مسترمه % 43(@)(@@) % أنا من قيد الهوى لك والو % % د بحبل لا يملك الغدر فصمه % 44(@)(@@) % حببتني لك الأيادي الفسيحا % % ت فأسمحت والعطايا الضخمه % 45(@)(@@) % وحلت لي طعوم أخلاقك الغر % وكم صاحب تمررت طعمه % 46(@)(@@) % بك جاريت من يروض وحارب % % ت زماني من بعد ما كنت سلمه % 47(@)(@@) % وتيقنت أن لي ناصرا يد % % فع دوني في صدر كل ملمه % 48(@)(@@) % لم تزل بي تختص كل مكان % من فؤادي حتى ملكت أعمه % 49(@)(@@) % طاهر طاهر من الغش لم يس % % بق إليه ريب ولم تسر تهمه % 50(@)(@@) % غير أن الجفاء مستتر في % % ه ومعط معناه ما يفسد اسمه % PageV01P2197 51(@)(@@) % كلما قلت ينصف الوصل أمضى ال % % هجر من جوره على القلب حكمه % 52(@)(@@) % فنواحي الهوى وثاق مصونا % % ت وفي جانب 