ms1721	 فالله أكرم من أن يعود في شيء قد عفا عنه .(@)(@@) % ( حم وابن جرير وصححه عن علي ) ( أخرجه الحاكم في المستدرك كتاب الحدود ( 4 / 388 ) وقال : صحيح الإسناد . ص ) .(@)(@@) 12966 - من أصاب منكم ذنبا مما نهى الله عنه فأقيم عليه حده فهو كفارة ذنبه .(@)(@@) % ( الحسن بن سفيان وأبو نعيم عن خزيمة بن ثابت ) .(@)(@@) 12967 - أيما عبد أصاب شيئا مما نهى الله عنه ثم أقيم عليه [ حده ] كفر عنه ذلك الذنب .(@)(@@) % ( ك عن خزيمة بن ثابت ) ( أخرجه الحاكم في المستدرك كتاب الحدود ( 4 / 388 ) وقال : صحيح الإسناد . وما بين الحاصرتين من المستدرك . ص ) .(@)(@@) PageV05P122(@)(@@) 12968 - من قتل صبرا كان كفارة لخطاياه .(@)(@@) % ( ابن النجار عن عمرو بن شعيب عن أبيه عن جده ) .(@)(@@) 12969 - لا يمر السيف بذنب إلا محاه .(@)(@@) % ( عق عن أنس ) .(@)(@@) 12970 - الرجم كفارة ما صنعت .(@)(@@) % ( ن طب وسمويه ص عن الشريد بن سويد ) ( الشريد بن سويد الثقفي له صحبة وعداده في ثقيف ، ووفد على النبي صلى الله عليه وسلم فسماه الشريد وشهد بيعة الرضوان . تهذيب التهذيب ( 4 / 332 ) ص ) .(@)(@@) | 1 ( الفصل الثاني في التسامح والاغضاء في الحدود ) 1(@)(@@) 12971 - ادرؤا الحدود عن المسلمين ما استطعتم ، فإن وجدتم للمسلم مخرجا فخلوا سبيله ، فإن الإمام لأن يخطئ في العفو خير من أن يخطئ في العقوبة .(@)(@@) % ( ش ت ك هق عن عائشة ) ( أخرجه الحاكم في المستدرك كتاب الحدود ( 4 / 384 ) ، وقال الذهبي : قال النسائي : يزيد بن زياد شامي متروك . وأخرجه الترمذي كتاب الحدود باب ماجاء في درء الحدود رقم ( 1424 ) وقال : يزيد بن زياد الدمشقي ضعيف في الحديث . ص ) .(@)(@@) 12972 - ادرؤا الحدود بالشبهات ، وأقيلوا الكرام عثراتهم إلا في حد من حدود الله .(@)(@@) % ( عد في جزء له من حديث أهل مصر والجزيرة عن ابن عباس ) .(@)(@@) 12973 - ادرؤا الحدود ولا ينبغي للإمام أن يعطل الحدود .(@)(@@) % ( قط هق عن علي ) .(@)(@@) 12974 - ادفعوا الحدود عن عباد الله ما وجدتم له مدفعا .(@)(@@) % ( ه عن أبي هريرة ) .(@)(@@) 12975 - أقيلوا ذوي الهيئآت عثراتهم إلا الحدود .(@)(@@) % ( حم خد عن عائشة ) ( وأخرجه أبو داود 
ms1722	 كتاب الحدود باب في الحد يشفع فيه رقم ( 4353 )(@)(@@) قال المنذري : فيه عبد الملك بن زيد : ضعيف ، وقال النسائي : لا بأس به ووثقه ابن حبان فالحديث : حسن . راجع عون المعبود ( 12 / 39 ) ص ) .(@)(@@) 12976 - أقيلوا السخي زلته ، فإن الله آخذ بيده كلما عثر .(@)(@@) % ( الخرائطي في مكارم الأخلاق عن ابن عباس ) .(@)(@@) 12977 - إن الله يحب أن يعفى عن ذنب السري ( السري : أي السخي ، ومنه حديث أم زرع ' فنكحت بعده سريا ' ، أي نفيسا شريفا . وقيل سخيا ذا مروءة . انتهى . النهاية ( 3 / 363 ) ب ) .(@)(@@) % ( ابن أبي الدنيا في ذم الغضب وابن لال عن عائشة ) .(@)(@@) 12978 - اهتبلوا العفو عن عثرات ذوى المروءات .(@)(@@) % ( أبو بكر ابن المرزبان في كتاب المروءة عن عمر ) .(@)(@@) 12979 - تعافوا ( تعافوا الحدود : أي تجاوزو عنها ولا ترفعوها إلي ، فإني متى علمتها أقمتها النهاية ( 3 / 265 ) ب ) الحدود فيما بينكم فما بلغني من حد فقد وجب .(@)(@@) % ( د ن ك عن ابن عمر ) ( أخرجه الحاكم في المستدرك كتاب الحدود ( 4 / 383 ) وقال : صحيح وأبو داود كتاب الحدود باب يعفى عن الحدود رقم ( 4354 ) ص ) .(@)(@@) 12980 - تجافوا عن عقوبة ذي المروءة إلا في حد من حدود الله .(@)(@@) % ( طس عن زيد بن ثابت ) .(@)(@@) 12981 - تجافوا عن عقوبة ذي المروءة .(@)(@@) % ( أبو بكر بن المرزبان في كتاب المروءة طب في مكارم الأخلاق عن ابن عمر ) .(@)(@@) 12982 - تجافوا عن ذنب السخي ، فإن الله تعالى أخذ بيده كلما عثر .(@)(@@) % ( قط في الأفراد عن ابن مسعود ) .(@)(@@) PageV05P123(@)(@@) 12983 - تجاوزوا عن ذنب السخي وزلة العالم وسطوة السلطان العادل فإن الله تعالى أخذ بيدهم كلما عثر عاثر منهم .(@)(@@) % ( خط عن ابن عباس ) .(@)(@@) 12984 - تجاوزوا لذوي المروءة عن عثراتهم ، فو الذي نفسي بيده إن أحدهم ليعثر وإن يده لفي يد الله .(@)(@@) % ( ابن المرزبان عن جعفر بن محمد ) مرسلا .(@)(@@) 12985 - هلا تركتموه لعله أن يتوب فيتوب الله عليه يعني ماعزا .(@)(@@) % ( د ك عن نعيم بن هزال ) ( أخرجه الحاكم في المستدرك كتاب الحدود ( 4 / 363 ) وقالا : صحيح .(@)(@@) وأخرجه أبو داود في سننه كتاب الحدود عن ماعز 
ms1723	 بن مالك رقم ( 4396 ) ص ) .(@)(@@) 12986 - يا هزال لو سترته بثوبك لكان خيرا لك .(@)(@@) % ( حم د ك عن نعيم بن هزال ) ( أخرجه أبو داود كتاب الحدود باب الستر على أهل الحدود رقم ( 4355 ) والحاكم في المستدرك كتاب الحدود ( 4 / 363 ) وقالا : صحيح . ص ) .(@)(@@) | 1 ( الإكمال من الفصل الثاني في التسامح والاغضاء في الحدود ) 1(@)(@@) 12987 - أقيلوا ذوي الهيئات زلاتهم .(@)(@@) % ( قط خط عن ابن مسعود ) ( الحاكم في الكنى عن أنس ) ( حب ق والعسكري في الأمثال عن عائشة ) .(@)(@@) 12988 - أقيلوا ذوي الهيئة عثراتهم إلا حدا من حدود الله .(@)(@@) % ( ابن جرير والعسكري عن عائشة ) .(@)(@@) ( ؟ ؟ راجع كشف الخفاء للعجلوني فقد أطال البحث عند هذا الحديث رقم ( 488 ) وقال ابن حجر في التحفة : للحديث المشهور من طرق ربما يبلغ درجة الحسن بل صححه ابن حبان بغير استثناء . انتهى . من كشف الخفاء ( 1 / 162 ) ص ) .(@)(@@) | 1 ( الباب الثاني في أنواع الحدود وفيه فصول أربعة ) 1(@)(@@)(@)(@@) | 1 ( الفصل الأول في الزنا - وفيه خمسة فروع ) 1(@)(@@)(@)(@@) | 1 ( الفرع الأول في الوعيد على الزنا ) 1(@)(@@) 12989 - الزنا يورث الفقر .(@)(@@) % ( القضاعي هب عن ابن عمر ) .(@)(@@) 12990 - الزاني بحليلة جاره لا ينظر الله إليه يوم القيامة ولا يزكيه ويقول له : ادخل النار مع الداخلين .(@)(@@) % ( الخرائطي في مساوي الأخلاق عن ابن عمر ) .(@)(@@) 12991 - من زنى خرج منه الإيمان فإن تاب تاب الله عليه .(@)(@@) % ( طب عن شريك ) .(@)(@@) 12992 - إن الإيمان سربال يسربله الله من يشاء فإذا زنى العبد نزع منه سربال الإيمان ، فإذا تاب رد عليه .(@)(@@) % ( هب عن أبي هريرة ) .(@)(@@) 12993 - من زنى أو شرب الخمر نزع الله منه الإيمان كما يخلع الإنسان القميص من رأسه .(@)(@@) % ( ك عن أبي هريرة ) .(@)(@@) PageV05P124(@)(@@) 12994 - ما ذنب بعد الشرك أعظم عند الله من نطفة وضعها رجل في رحم لا يحل له .(@)(@@) % ( ابن أبي الدنيا عن الهيثم بن مالك الطائي ) .(@)(@@) 12995 - من قعد على فراش مغيبة قيض الله له ثعبانا يوم القيامة .(@)(@@) % ( حم عن أبي قتادة ) .(@)(@@) 12996 - المقيم على الزنا كعابد وثن .(@)(@@) % ( الخرائطي في مساوي الأخلاق وابن عساكر 
ms1724	 عن أنس ) .(@)(@@) 12997 - إن التي تورث المال غير أهله ، عليها نصف عذاب الأمة .(@)(@@) % ( عب عن ثوبان ) .(@)(@@) 12998 - من زنى زني به ولو بحيطان داره .(@)(@@) % ( ابن النجار عن أنس ) .(@)(@@) 12999 - إذا زنى العبد خرج منه الإيمان ، فكان على رأسه كالظلة فإذا أقلع رجع إليه .(@)(@@) % ( د ك عن أبي هريرة ) ( رواه أبو داود كتاب الحدود باب الدليل على زيادة الإيمان ونقصاته . رقم ( 4665 ) . ص ) .(@)(@@) 13000 - إذا ظهر الزنا والربا في قرية فقد أحلوا بأنفسهم عذاب الله .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 13001 - اشتد غضب الله على الزناة .(@)(@@) % ( أبو سعد الجرباذقاني في جزئه وأبو الشيخ في عواليه فر عن أنس ) .(@)(@@) 13002 - اشتد غضب الله على امرأة أدخلت على قوم ولدا ليس منهم يطلع على عوراتهم ويشركهم في أموالهم .(@)(@@) % ( البزار عن ابن عمر ) .(@)(@@) 13003 - إن الله تعالى يدنو من خلقه فيغفر لمن استغفر إلا البغي بفرجها والعشار .(@)(@@) % ( طب عد عن عثمان بن أبي العاص ) .(@)(@@) 13004 - إن الزناة يأتون تشتعل وجوههم نارا .(@)(@@) % ( طب عن عبد الله بن بشر ) ( ذكره الهيثمي في مجمع الزوائد كتاب الحدود باب ذم الزنا ( 6 / 255 ) وقال : رواه الطبراني من طريق محمد بن عبد الله بن بسر عن أبيه ولم أعرفه وبقية رجاله ثقات . ص ) .(@)(@@) 13005 - إن السموات السبع والأرضين السبع والجبال لتلعن الشيخ الزاني ، وإن فروج الزناة ليؤذي أهل النار نتن ريحها .(@)(@@) % ( البزار عن بريدة ) ( روى عن بريدة موقوفا ومرفوعا رواهما البزار وفي إسناديهما صالح بن حبان وهو ضعيف . مجمع الزوائد ( 6 / 255 ) . ص ) .(@)(@@) 13006 - أوشك أن تستحل أمتي فروج النساء والحرير .(@)(@@) % ( ابن عساكر عن علي ) .(@)(@@) 13007 - إياكم والزنا ، فإن فيه أربع خصال : يذهب البهاء عن الوجه ، ويقطع الرزق ، ويسخط الرحمن والخلود في النار .(@)(@@) % ( طس عد عن ابن عباس ) ( فيه عمرو بن جميع وهو متروك . مجمع الزوائد ( 6 / 255 ) . ص ) .(@)(@@) 13008 - أيما امرأة أدخلت على قوم من ليس منهم فليست من الله في شيء ، ولن يدخلها الله جنته ، وأيما رجل جحد ولده وهو ينظر إليه احتجب الله تعالى منه وفضحه على 
ms1725	 رؤس الأولين والآخرين يوم القيامة .(@)(@@) % ( د ن ه حب ك عن أبي هريرة ) ( رواه أبو داود كتاب النكاح باب التغليظ في الانتفاء رقم ( 2246 ) .(@)(@@) وابن ماجه كتاب الفرائض باب من أنكر ولده رقم ( 3743 ) .(@)(@@) وقال في الزوائد : هذا إسناد ضعيف ، فيه يحيى بن حرب . ص ) .(@)(@@) 13009 - السحاق بين النساء زنا بينهن .(@)(@@) % ( طب عن واثلة ) ( رواه أبو يعلى ولفظه : سحاق النساء بينهن زنا ، ورجاله ثقات . مجمع الزوائد ( 6 / 256 ) ص ) .(@)(@@) PageV05P125(@)(@@) 13010 - سحاق النساء زنا بينهن .(@)(@@) % ( هب عن واثلة ) .(@)(@@) 13011 - عفوا عن نساء الناس تعف نساؤكم وبروا آباءكم تبركم أبناؤكم ، ومن أتاه أخوه متنصلا ( متنصلا : أي انتفى من ذنبه واعتذر إليه . النهاية ( 5 / 67 ) . ب ) فليقبل ذلك منه محقا كان أو مبطلا فإن لم يفعل لم يرد علي الحوض .(@)(@@) % ( ك عن أبي هريرة ) ( أخرجه الحاكم في المستدرك كتاب البر والصلة ( 4 / 154 ) .(@)(@@) وقال الذهبي : فيه سويد ضعيف . ص ) .(@)(@@) 13012 - عفوا تعف نساؤكم وبروا آباءكم تبركم أبناؤكم ومن اعتذر على أخيه المسلم من شيء بلغه منه ، فلم يقبل عذره لم يرد علي الحوض .(@)(@@) % ( طس عن عائشة ) .(@)(@@) 13013 - عفوا تعف نساؤكم .(@)(@@) % ( أبو القاسم بن بشران في أماليه عد عن ابن عباس ) .(@)(@@) 13014 - عشر خصال عملها قوم لوط بها أهلكوا وتزيدها أمتي بخلة ( بخلة : الخلة مثل الخصلة وزنا ومعنى . انتهى . المصباح المنير ( 1 / 246 ) ب ) إتيان الرجال بعضهم بعضا ورميهم بالجلاهق ( الجلاهق : بضم الجيم ، البندق المعمول من الطين ؛ الواحدة جلاهقة . المصباح المنير ( 1 / 146 ) ب ) والخذف ولعبهم بالحمام وضرب الدفوف ، وشرب الخمور ، وقص اللحية ، وطول الشارب والصفير والتصفيق ، ولباس الحرير ، ويزيدها أمتي بخلة إتيان النساء بعضهن بعضا .(@)(@@) % ( ابن عساكر عن الحسن ) مرسلا .(@)(@@) 13015 - لا تزوج المرأة المرأة ، ولا تزوج المرأة نفسها ، فإن الزانية التي تزوج نفسها .(@)(@@) % ( ه عن أبي هريرة ) ( رواه ابن ماجه كتاب النكاح باب لا نكاح إلا بولي رقم ( 1882 ) .(@)(@@) وقال في الزوائد : في إسناده جميل بن الحسين العتكي ، قال مسلمة الأندلسي : ثقة وباقي رجال الإسناد ثقات . ص ) .(@)(@@) | 1 ( الإكمال من الفصل الأول 
ms1726	 في الزنا - الفرع الأول في الوعيد على الزنا ) 1(@)(@@) 13016 - إن أعمال أمتي تعرض على في كل يوم جمعة واشتد غضب الله على الزناة .(@)(@@) % ( حل عن أنس ) ( أخرجه أبو نعيم في الحلية ( 6 / 179 ) ) .(@)(@@) 13017 - الزنا يورث الفقر .(@)(@@) % ( هب عد ك في تاريخه والقضاعي عن ابن عمر ) .(@)(@@) 13018 - لا ينظر الله عز وجل إلى الشيخ الزاني والعجوز الزانية .(@)(@@) % ( طب في السنة عن أبي هريرة ) ( رواه الطبراني في الأوسط عن شيخه موسى بن سهل ولم أعرفه : وبقية رجاله ثقات . مجمع الزوائد ( 6 / 255 ) . ص ) .(@)(@@) 13019 - يا شباب قريش ، لا تزنوا ألا من حفظ فرجه فله الجنة .(@)(@@) % ( ك عن ابن عباس ) .(@)(@@) 13020 - يا فتيان قريش ، لا تزنوا فإنه من أسلم له شبابه دخل الجنة .(@)(@@) % ( طب هب عن ابن عباس ) .(@)(@@) 13021 - يا معشر شباب قريش ، احفظوا فروجكم ، ولا تزنوا ألا من حفظ فرجه فله الجنة .(@)(@@) % ( طب هب عن ابن عباس ) .(@)(@@) 13022 - يا معشر المسلمين ؛ اتقوا الزنا ، فإن فيه ست خصال : ثلاث في الدنيا ، وثلاث في الآخرة ، فأما اللواتي في الدنيا ، فيذهب ببهاء الوجه ويورث الفقر وينقص العمر ، وأما اللاتي في الآخرة فيورث السخط وسوء الحساب والخلود في النار .(@)(@@) PageV05P126(@)(@@) % ( الخرائطي في مساوي الأخلاق حل هب وضعفه وأبو الفتح الراشدي في جزئه والرافعي عن حذيفة ) .(@)(@@) 13023 - لا يدخل الجنة من زنى بذات محرم .(@)(@@) % ( عب عن مجاهد ) مرسلا .(@)(@@) 13024 - لا يدخل الجنة من أتى ذات محرم .(@)(@@) % ( الخرائطي عن ابن عمرو ) ( طب حل عن ابن عباس ) .(@)(@@) 13025 - التي تورث المال غير أهله ، عليها نصف عذاب الأمة .(@)(@@) % ( عب عن الحكم بن ثوبان ) مرسلا .(@)(@@) 13026 - على كل نفس من بني آدم كتب حظ من الزنا أدرك ذلك لا محالة ، فالعين زناها النظر ، والرجل زناها المشي ، والأذن زناها الاستماع ، واليد زناها البطش ، واللسان زناه الكلام ، والقلب أن يتمنى ويصدق ذلك أو يكذبه الفرج .(@)(@@) % ( ك عن أبي هريرة ) .(@)(@@) | 1 ( الفرع الثاني في مقدمات الزنا والخلوة بالأجنبية ) 1(@)(@@) 13027 - رأيت شابا وشابة فلم آمن الشيطان عليهما .(@)(@@) % ( حم ت عن علي ) ( رواه الترمذي 
ms1727	 كتاب الحج باب ما جاء أن عرفة كلها موقف رقم ( 885 ) من حديث طويل أوله : هذه عرفة ، وقال حديث : حسن صحيح . ص ) .(@)(@@) 13028 - لا تلجوا على المغيبات فإن الشيطان يجري من أحدكم مجرى الدم [ قلنا ومنك ؟ قال ] ومني ولكن الله أعانني عليه فأسلم .(@)(@@) % ( حم ت عن جابر ) ( ما بين الحاصرتين استدركته من سنن الترمذي كتاب الرضاع باب رقم 17 رقم 1172 وقال : حديث غريب . ص ) .(@)(@@) 13029 - [ ألا ] لا يبيتن رجل عند امرأة في بيت إلا أن يكون ناكحا أو ذا محرم .(@)(@@) % ( م عن جابر ) ( ما بين الحاصرتين من صحيح مسلم كتاب السلام باب تحريم الخلوة بالأجنبية والدخول عليها رقم 2171 .(@)(@@) ورواية الصحيح : ' ثيب ' . بدل من : ' في بيت ' كما تراه وهكذا هو في نسخ بلادنا . كما ذكره في الصحيح ( 4 / 1710 ) ص ) .(@)(@@) 13030 - أو كلما نفرنا في سبيل الله تخلف أحدهم له نبيب كنبيب ( نبيب النبيب : صوت التيس عند السفاد . انتهى . النهاية ( 4 / 5 ) . ب ) التيس منح إحداهن الكثبة ( الكثبة : أي بالقليل من اللبن والكثبة : كل قليل جمعته من طعام أو لبن أو غير ذلك ، والجمع كثب . انتهى . النهاية ( 4 / 151 ) . ب ) من اللبن ، لا أقدر على أحدهم إلا نكلت به .(@)(@@) % ( حم م عن جابر بن سمرة ) ( م عن أبي سعيد ) ( رواه مسلم في صحيحه كتاب الحدود باب من اعترف على نفسه بالزنى ، رقم ( 1694 ) . ص ) .(@)(@@) 13031 - لا يدخلن رجل بعد يومي هذا على مغيبة إلا ومعه رجل أو اثنان .(@)(@@) % ( حم م عن ابن عمر ) ( رواه مسلم في صحيحه كتاب السلام باب تحريم الخلوة على الأجنبية رقم ( 2173 ) . ومعنى المغيبة : هي التي غاب عنها زوجها . ص ) .(@)(@@) 13032 - لا يفضين ( لا يفضين : أي لا يعلمه بالسر الذي بينه وبين زوجته ، يقال : أفضيت إليه بالسر إذا أعلمته به . انتهى . المصباح المنير ( 2 / 652 ) ب ) رجل إلى رجل ، وامرأة إلى امرأة ، إلا إلى ولد أو والد .(@)(@@) % ( د عن أبي هريرة ) ( رواه أبو داود كتاب الحمام باب في التعري رقم ( 4000 ) قال المنذري فيه : رجل 
ms1728	 مجهول .(@)(@@) والحديث أخرجه الترمذي كتاب الاستئذان ، والنسائي في الزنية .(@)(@@) راجع عون المعبود ( 11 / 61 ) . ص ) .(@)(@@) | 1 ( الإكمال من الفرع الثاني في مقدمات الزنا والخلوة بالأجنبية ) 1(@)(@@) 13033 - أما بعد فما بال أقوام إذا غزونا تخلف أحدهم في عيالنا له نبيب كنبيب التيس أما إني علي أن لا أوتي بأحد فعل ذلك إلا نكلت به .(@)(@@) % ( ك عن أبي سعيد ) .(@)(@@) 13034 - مثل الذي يجلس على فراش المغيبة مثل الذي ينهشه أسود من أساود يوم القيامة .(@)(@@) % ( طب والخرائطي في مساوي الأخلاق عن ابن عمرو ) ( أورده الهيثمي في مجمع الزوائد ( 6 / 258 ) وقال رواه الطبراني ورجاله ثقات . ص ) .(@)(@@) PageV05P127(@)(@@) 13035 - إياك والخلوة بالنساء ، فو الذي نفسي بيده ما خلا رجل بامرأة إلا دخل الشيطان بينهما ، وليزحم رجل خنزيرا متلطخا بطين أو حمأة خير له من أن يزحم منكبه منكب امرأة لا تحل له .(@)(@@) % ( طب عن أبي أمامة ) .(@)(@@) 13036 - إياكم ونساء الغزاة ، فإن حرمتهن كحرمة أمهاتكم .(@)(@@) % ( أبو الشيخ عن أنس ) .(@)(@@) 13037 - لا تدخلوا على النساء ولو كن كنائنا ، قالوا : يا رسول الله افرأيت الحمو ( الحمو : الحم أحد الأحماء : أقارب الزوج . النهاية ( 1 / 448 ) ب ) قال : الحمو الموت .(@)(@@) % ( طب عن عقبة بن عامر ) .(@)(@@) 13038 - لا تدخلوا على هؤلاء المغيبات فإن الشيطان يجري من ابن آدم مجرى الدم ، قيل : يا رسول الله ومنك ؟ قال : ومني إلا أن الله أعانني عليه فأسلم .(@)(@@) % ( ن عن جابر ) .(@)(@@) 13039 - لا تلجوا على المغيبات ، فإن الشيطان يجري مجرى الدم .(@)(@@) % ( حل عن ابن مسعود ) .(@)(@@) 13040 - لا يحل لرجل يؤمن بالله واليوم الآخر أن يخلوا بامرأة ليست ذات محرم ومعها ذو محرم .(@)(@@) % ( عب عن طاوس ) مرسلا .(@)(@@) 13041 - لا يخلون رجل بامرأة إلا ومعها ذو محرم ، ولا تسافر امرأة إلا مع محرم .(@)(@@) % ( طب هب عن ابن عباس ) .(@)(@@) 13042 - لا يخلون رجل بامرأة فإن الشيطان ثالثهما .(@)(@@) % ( طب عن سليمان بن بريدة عن أبيه ) ( وأخرجه الحاكم في المستدرك كتاب العلم ( 1 / 114 ) وهو فقرة من حديث طويل وقال : صحيح على شرط الشيخين ووافقه الذهبي . ص ) .(@)(@@) 13043 - لا يدخل 
ms1729	 رجل على امرأة إلا ومعها محرم من دخل فليعلم أن الله معه .(@)(@@) % ( هب عن ابن عباس ) .(@)(@@) 13044 - لا يدخلن رجل على امرأة ولا يسافر معها إلا ومعها ذو محرم .(@)(@@) % ( ق عن ابن عباس ) .(@)(@@) 13045 - لأن يكون في رأس رجل مشط من حديد حتى يبلغ العظم خير من أن تمسه امرأة ليست له بمحرم .(@)(@@) % ( هب عن معقل ) .(@)(@@) 13046 - لعن الله بيتا يدخله مخنث .(@)(@@) % ( ابن النجار عن ابن عباس ) .(@)(@@) 13047 - يا أنة اخرج من المدينة إلى حمراء الأسد فليكن بها منزلك ولا تدخلن المدينة إلا أن يكن للناس عيد فتشهده .(@)(@@) % ( الباوردي عن عائشة ) .(@)(@@) PageV05P128(@)(@@) | 1 ( { النظر } ) 1(@)(@@) 13048 - لكل ابن آدم حظه من الزنا ، فزنا العينين النظر ، وزنا اللسان المنطق ، والأذنان زناهما الاستماع ، واليدان تزنيان ، فزناهما البطش ، والرجلان تزنيان ، فزناهما المشي ، والفم يزني فزناه القبل .(@)(@@) % ( د عن أبي هريرة ) ( رواه أبو داود كتاب النكاح باب في ما يؤمر به من غض البصر رقم ( 2139 ) . ص ) .(@)(@@) 13049 - إن الله تعالى كتب على ابن آدم حظه من الزنا أدرك ذلك لا محالة ، فزنا العين النظر ، وزنا اللسان المنطق ، والنفس تتمنى وتشتهي والفرج يصدق ذلك أو يكذبه .(@)(@@) % ( ق د عن أبي هريرة ) ( رواه أبو داود كتاب النكاح - باب في ما يؤمر به من غض البصر ، رقم ( 2138 ) . وقال المنذري : أخرجه البخاري ومسلم كتاب القدر رقم ( 2657 ) . والنسائي عون المعبود شرح سنن أبي داود ( 6 / 190 ) ص ) .(@)(@@) 13050 - إذا رأى أحدكم المرأة التي تعجبه فليرجع إلى أهله حتى يقع بهم فإن ذلك معهم .(@)(@@) % ( حب عن جابر ) .(@)(@@) 13051 - إن المرأة إذا أقبلت أقبلت في صورة شيطان فإذا رأى أحدكم امرأة تعجبه ، فليأت أهله فإن الذي معها مثل ما معها .(@)(@@) % ( ت حب عن جابر ) ( رواه الترمذي كتاب الرضاع باب ما جاء في الرجل يرى المرأة تعجبه رقم ( 1158 ) وقال : صحيح حسن غريب . ص ) .(@)(@@) 13052 - لا ينظر الرجل إلى عورة الرجل ، ولا تنظر المرأة إلى عورة المرأة ، ولا يفضي الرجل إلى الرجل في ثوب واحد ، ولا تفضي المرأة إلى المرأة 
ms1730	 في الثوب الواحد .(@)(@@) % ( حم م د ت عن أبي سعيد ) وروى ( ه ) صدره .(@)(@@) 13053 - يا علي لا تتبع النظرة النظرة فإن لك الأولى وليست لك الآخرة .(@)(@@) % ( حم د ت ك عن بريدة ) ( أخرجه الحاكم في المستدرك كتاب النكاح ( 2 / 194 ) وقال : صحيح على شرط مسلم ووافقه الذهبي على التصحيح .(@)(@@) ورواه أبو داود كتاب النكاح باب في ما يؤمر به من غض البصر رقم ( 2135 ) والترمذي كتاب الأدب باب ما جاء في نظرة المفاجأة رقم ( 2777 ) وقال : حسن غريب . ص ) .(@)(@@) 13054 - إذا رأى أحدكم امرأة حسناء فأعجبته فليأت أهله فإن البضع ( البضع : يطلق على عقد النكاح والجماع معا ، وعلى الفرج . انتهى . النهاية ( 1 / 133 ) . ب ) واحد ومعها مثل الذي معها .(@)(@@) % ( خط عن عمر ) .(@)(@@) 13055 - زنا العين النظر .(@)(@@) % ( ابن سعد طب عن علقمة بن الحارث ) ( أخرجه ابن سعد في الطبقات الكبرى ( 7 / 77 ) عن علقمة بن الحويرث الغفاري ، وذكره الهيثمي في مجمع الزوائد ( 6 / 256 ) وقال : رواه الطبراني ، وجد محمد بن مطرف لم أعرفه وبقية رجاله ثقات ص ) .(@)(@@) 13056 - إن المراة تقبل في صورة شيطان وتدبر في صورة شيطان فإذا رأى أحدكم امرأة فأعجبته فليأت أهله ، فإن ذلك يرد ما في نفسه .(@)(@@) % ( حم د عن جابر ) .(@)(@@) 13057 - زنا اللسان الكلام .(@)(@@) % ( أبو الشيخ عن أبي هريرة ) .(@)(@@) 13058 - اصرف بصرك .(@)(@@) % ( حم م 3 عن جرير ) .(@)(@@) 13059 - ما من مسلم ينظر امرأة أول رمقة ( أول رمقة : أي أول نظرة يقال : رمقه بعينه رمقا من باب قتل أطال النظر إليه . انتهى . المصباح المنير ( 1 / 326 ) ب ) ثم يغض بصره إلا أحدث الله تعالى له عبادة يجد حلاوتها في قلبه .(@)(@@) % ( حم طب عن أبي أمامة ) .(@)(@@) 13060 - إياكم والدخول على النساء .(@)(@@) % ( حم ق ن عن عقبة بن عامر ) .(@)(@@) 13061 - إياكم ومحادثة النساء فإنه لا يخلو رجل بامرأة ليس لها محرم إلا هم بها .(@)(@@) % ( الحكيم في كتاب أسرار الحج عن سعد بن مسعود ) .(@)(@@) PageV05P129(@)(@@) 13062 - العينان تزنيان ، واليدان تزنيان ، والرجلان تزنيان ، والفرج يزني .(@)(@@) % ( حم طب عن ابن مسعود ) .(@)(@@) 13063 - غضوا 
ms1731	 الأبصار ، واهجروا الدعار ( الدعار : الدعارة : الفساد والشر ورجل داعر : خبيث مفسد ، ومنه حديث عدى ' فأين دعار طيء ' أراد بهم قطاع الطريق . انتهى . النهاية ( 2 / 119 ) . ب ) واجتنبوا أعمال أهل النار .(@)(@@) % ( طب عن الحكم بن عمير ) .(@)(@@) 13064 - كتب على ابن آدم نصيبه من الزنا مدرك ذلك لا محالة فالعينان زناهما النظر ، والأذنان زناهما الاستماع ، واللسان زناه الكلام ، واليد زناها البطش ، والرجل زناها الخطا ، والقلب يهوى ويتمنى ، ويصدق ذلك الفرج ويكذبه .(@)(@@) % ( م عن أبي هريرة ) ( رواه مسلم في صحيحه كتاب القدر باب قدر على ابن آدم حظه من الزنا وغيره رقم ( 21 ) ص ) .(@)(@@) 13065 - لأن يطعن في رأس أحدكم بمخيط من حديد خير له من أن يمس امرأة لا تحل له .(@)(@@) % ( طب عن معقل بن يسار ) .(@)(@@) | 1 ( الإكمال من النظر ) 1(@)(@@) 13066 - أفعمياوان أنتما ؟ ألستما تبصرانه .(@)(@@) % ( حم د ت حسن صحيح عن أم سلمة ) ( رواه أحمد في مسنده عن أم سلمة ( 6 / 296 ) والترمذي كتاب الأدب باب ما جاء في احتجاب النساء من الرجال رقم ( 2778 ) وقال : حسن صحيح . ص ) .(@)(@@) 13067 - إن المرأة سهم من سهام إبليس ، فمن رأى امرأة ذات جمال فغض بصره عنها ابتغاء مرضاة الله أعقبه الله عبادة يجد لذتها .(@)(@@) % ( ابن النجار عن أبي هريرة ) .(@)(@@) 13068 - إن النظر سهم من سهام إبليس مسموم ، من تركها مخافتي أبدلته إيمانا يجد حلاوته في قلبه .(@)(@@) % ( طب عن ابن مسعود ) .(@)(@@) 13069 - مرت بي فلانة فوقعت في نفسي شهوة النساء ، فقمت إلى بعض أهلي فوضعت شهوتي فيها وكذلك فافعلوها ، فإنه من أماثل أعمالكم إتيان الحلال .(@)(@@) % ( حم والحكيم طب عن أبي كبشة ) .(@)(@@) 13070 - أيما رجل رأى امرأة فأعجبته فليقم إلى أهله ، فإن معها مثل الذي معها .(@)(@@) % ( هب عن ابن مسعود ) .(@)(@@) 13071 - إنه يكره للنساء أن ينظرن إلى الرجال ، كما يكره للرجال أن ينظروا إلى النساء .(@)(@@) % ( طب عن أم سلمة ) وضعف .(@)(@@) 13072 - إياك والنظرة بعد النظرة ، فإن الأولى لك والثانية عليك .(@)(@@) % ( الحاكم في الكنى عن بريدة ) .(@)(@@) 13073 - النظرة الأولى خطأ ، والثانية عمد ، والثالثة تدمر ، ونظر المؤمن 
ms1732	 في محاسن المرأة سهم من سهام إبليس مسموم ، من تركها من خشية الله ورجاء ما عنده آتاه الله بذلك عبادة تبلغه لذتها .(@)(@@) % ( حل عن ابن عمر ) .(@)(@@) PageV05P130(@)(@@) 13074 - اصرف بصرك .(@)(@@) % ( حم م ت حسن صحيح ن عن أبي زرعة بن عمرو بن جرير عن جده ) قال : سألت رسول الله صلى الله عليه وسلم عن نظرة الفجاءة قال فذكره . مر برقم [ 13058 ] .(@)(@@) 13075 - النظرة سهم من سهام إبليس مسمومة فمن تركها من خوف الله أثابه الله إيمانا يجد حلاوته في قلبه .(@)(@@) % ( ك وتعقب عن حذيفة ) .(@)(@@) 13076 - النظرة إلى محاسن المرأة سهم من سهام إبليس مسمومة فمن صرف بصره عنها رزقه الله عبادة يجد حلاوتها .(@)(@@) % ( الحكيم عن علي ) .(@)(@@) 13077 - لا تملئوا أعينكم(@)(@@) من أبناء الملوك ، فإن لهم فتنة أشد من فتنة العذارى .(@)(@@) % ( عد وابن عساكر عن أبي هريرة ) وفيه عمرو بن عمرو الطحان حدث بالبواطيل عن الثقات قال ( عد ) هذا الحديث موضوع وقال في الميزان هو من بلاياه ( ذكره العجلوني في كشف الخفاء رقم ( 3053 ) قال في اللآلئ : موضوع . ص ) .(@)(@@) 13078 - من نظر إلى عورة أخيه متعمدا لم يقبل الله له صلاة أربعين ليلة .(@)(@@) % ( ابن عساكر عن أبي هريرة ) .(@)(@@) 13079 - نظر الرجل إلى عورة أخيه كنظره إلى الفرج الحرام .(@)(@@) % ( الحاكم في الكنى والديلمي عن ابن عمر ) .(@)(@@) 13080 - لا يحل لرجل أن ينظر إلى سوءة أخيه .(@)(@@) % ( عد والحاكم في الكنى وابن عساكر عن ابن عمر ) .(@)(@@) 13081 - كان خطيئة داود النظر .(@)(@@) % ( الديلمي عن سمرة ) .(@)(@@) 13082 - لتغضن أبصاركم ، ولتحفظن فروجكم ، ولتقيمن وجوهكم ، أو ليكسفن وجوهكم .(@)(@@) % ( طب عن أبي أمامة ) .(@)(@@) | 1 ( ذيل الفصل من الإكمال ) 1(@)(@@) 13083 - لا تباشر المرأة المرأة إلا وهما زانيتان ، ولا يباشر الرجل الرجل إلا وهما زانيان .(@)(@@) % ( طب عن أبي موسى ) .(@)(@@) 13084 - لا يباشر الرجل الرجل في الثوب الواحد ، ولا تباشر المرأة المرأة في الثوب الواحد .(@)(@@) % ( حم ص عن جابر ) .(@)(@@) 13085 - لا يباشر الرجل الرجل ، إلا الولد والوالد .(@)(@@) % ( ك في تاريخه عن أبي هريرة ) .(@)(@@) 13086 - لا يباشر الرجل الرجل ولا المرأة المرأة .(@)(@@) % ( حم 
ms1733	 طب ك عن ابن عباس ) .(@)(@@) 13087 - لا يباشر رجل رجلا ولا امرأة امرأة ، ولا يحل الرجل أن ينظر إلى عورة رجل ولا المرأة إلى عورة المرأة .(@)(@@) % ( عبد الرزاق عن زيد بن أسلم ) مرسلا .(@)(@@) PageV05P131(@)(@@) | 1 ( الفرع الثالث { في ولد الزنا } ) 1(@)(@@) 13088 - ولد الزنا شر الثلاثة إذا عمل بعمل أبويه .(@)(@@) % ( طب هق عن ابن عباس ) ( رواه الطبراني في الكبير والأوسط وفيه محمد بن أبي ليلى وهو سيء الحفظ ومندل وثق وفيه ضعف . مجمع الزوائد ( 6 / 257 ) ص ) .(@)(@@) 13089 - فرخ الزنا لا يدخل الجنة .(@)(@@) % ( عد عن أبي هريرة ) .(@)(@@) 13090 - ولد الزنا شر الثلاثة .(@)(@@) % ( حم د ك هق عن أبي هريرة ) .(@)(@@) 13091 - ليس على ولد الزنا من وزر أبويه شيء .(@)(@@) % ( ش ك عن عائشة ) .(@)(@@) | 1 ( الإكمال من الفرع الثالث في ولد الزنا ) 1(@)(@@) 13092 - لا تزال أمتي بخير متماسك أمرها ما لم يظهر فيهم ولد الزنا فإذا ظهروا خشيت أن يعمهم الله تعالى بعقاب .(@)(@@) % ( حم طب عن ميمونة ) ( وفيه محمد بن عبد الرحمن بن لبيبة وثقه ابن حبان وضعفه ابن معين ومحمد بن إسحاق قد صرح بالسماع فالحديث صحيح أو حسن . مجمع الزوائد ( 6 / 257 ) .(@)(@@) راجع مسند أحمد بن حنبل ( 6 / 333 ) وعن ميمونة زوج النبي صلى الله عليه وسلم . ص ) .(@)(@@) 13093 - لا يبغي على الناس إلا ولد بغي ، والابن فيه عرق منه .(@)(@@) % ( طب عن أبي موسى ) .(@)(@@) 13094 - لا يبغي على الناس إلا ولد عنه أو فيه شيء منه .(@)(@@) % ( الخرائطي وابن عساكر عن بلال بن أبي بردة بن أبي موسى عن أبيه عن جده ) .(@)(@@) 13095 - لا يدخل الجنة ولد الزنا ، ولا ولده ولا ولد ولده .(@)(@@) % ( ابن النجار عن أبي هريرة ) .(@)(@@) 13096 - لا يدخل الجنة ولد زنية ( ولد زنية : الزنية بالفتح والكسر : آخر ولد الرجل والمرأة كالعجزة . النهاية ( 2 / 317 ) ب ) .(@)(@@) % ( ق عن ابن عمرو ) .(@)(@@) 13097 - إن الله عز وجل درأ لجهنم من ذرأ ( ذرأ : أي خلق . يقال ذرأ الله الخلق يذرؤهم ذرءا إذا خلقهم . انتهى . النهاية ( 2 / 156 ) ب ) كان ولد الزنا فيمن 
ms1734	 ذرأ لجهنم .(@)(@@) % ( الديلمي عن ابن عمر ) .(@)(@@) | 1 ( الفرع الرابع { في حد الزنا } ) 1(@)(@@) 13098 - خذوا عني خذوا عني ، قد جعل الله لهن سبيلا البكر بالبكر جلد مائة ونفي سنة ، والثيب ( والثيب : الثيب من ليس ببكر ويقع على الذكر والأنثى . انتهى . النهاية ( 1 / 231 ) ب ) بالثيب جلد مائة والرجم .(@)(@@) % ( حم م 4 عن عبادة بن الصامت ) .(@)(@@) 13099 - لو رجمت أحدا بغير بينة لرجمت هذه .(@)(@@) % ( ق عن ابن عباس ) .(@)(@@) 13100 - الإحصان إحصانان : إحصان نكاح ، وإحصان عفاف .(@)(@@) % ( ابن أبي حاتم طس وابن عساكر عن أبي هريرة عن عبد الله ) .(@)(@@) 13101 - الثيبان يجلدان ويرجمان ، والبكران يجلدان وينفيان .(@)(@@) % ( ك في تاريخه عن أبي ) .(@)(@@) 13102 - والذي نفسي بيده ، لأقضين بينكما بكتاب الله الوليدة والغنم رد عليك ، وعلى ابنك جلد مائة وتغريب عام ، وعلى امرأة هذا الرجم ، واغد يا أنيس إلى امرأة هذا فإن اعترفت فارجمها .(@)(@@) % ( حم ق 4 عن أبي هريرة وزيد بن خالد الجهني ) .(@)(@@) PageV05P132(@)(@@) 13103 - إذا أتى الرجل الرجل فهما زانيان ، وإذا أتت المرأة المرأة فهما زانيتان .(@)(@@) % ( هق عن أبي موسى ) .(@)(@@) 13104 - إذا زنت أمة أحدكم فتبين زناها فليجلدها ولا يثرب ، ثم إن زنت فليجلدها ولا يثرب ( ولا يثرب : أي لا يوبخها ولا يقرعها بالزنا بعد الضرب . انتهى . النهاية ( 1 / 209 ) ب ) ، ثم إن زنت الثالثة فليبعها ولو بحبل من شعر .(@)(@@) % ( حم ق د ت عن أبي هريرة وزيد بن خالد ) ( رواه الترمذي كتاب الحدود - باب ما جاء في إقامة الحد على الإماء رقم ( 1440 ) وقال : حسن صحيح .(@)(@@) رواه أبو داود كتاب الحدود باب في الأمة تزني ولم تحصن رقم ( 4446 ) وقال المنذري : أخرجه مسلم ، والنسائي وابن ماجه وأخرجه البخاري تعليقا . عون المعبود ( 12 / 168 ) .(@)(@@) وابن ماجه كتاب الحدود باب إقامة الحدود على الإماء رقم ( 2566 ) .(@)(@@) وقال في الزوائد : في إسناده عمار بن أبي فروة - ضعيف . ص ) .(@)(@@) 13105 - إذا زنت الأمة فاجلدوها ثم إن زنت فبيعوها ولو بضفير ( الضفير : الحبل المفتول من الشعر . انتهى . النهاية ( 3 / 93 ) ب ) .(@)(@@) % ( حم عن عائشة ) .(@)(@@) 13106 - كفى بالسيف شاهدا 
ms1735	 .(@)(@@) % ( ه عن سلمة بن المحبق ) .(@)(@@) | 1 ( الإكمال من الفرع الرابع في حد الزنا ) 1(@)(@@) 13107 - إذا اعترف الرجل بالزنا سبع مرات فأمر به ليرجم ثم هرب ترك .(@)(@@) % ( الديلمي عن أبي هريرة ) .(@)(@@) 13108 - لا نقتل ما في بطنك لأجلك ، اذهبي حتى تضعي .(@)(@@) % ( ابن عساكر عن أنس ) . إن امرأة قالت : يا رسول الله ، إن في بطني حدثا فأقم علي حد الله قال : فذكره .(@)(@@) 13109 - لو كنت راجما أحدا بغير بينة لرجمت فلانة ، فقد ظهر منها الريبة في منطقها وهيئتها ، ومن يدخل عليها .(@)(@@) % ( ه طب عن ابن عباس ) ( رواه ابن ماجه كتاب الحدود باب من أظهر الفاحشة رقم ( 2559 ) وقال في الزوائد : إسناده صحيح ورجاله ثقات . ص ) .(@)(@@) 13110 - كفى بالسيف شاهدا إني أخاف أن يتتابع في ذلك السكران والغيران ( والغيران : أي الغيور ، يقال : رجل غيور وغيران والمرأة غيور وغيرى . انتهى . المصباح المنير ( 2 / 627 ) ب ) .(@)(@@) % ( ه عن سلمة ابن المحبق ) ( رواه ابن ماجه كتاب الحدود باب الرجل يجد مع امرأته رجلا رقم ( 2606 ) . وقال في الزوائد : في إسناده قبيصة بن حريث ، قال البخاري في حديثه نظر وذكره ابن حبان في الثقات وباقي رجال الإسناد موثقون . ص ) .(@)(@@) 13111 - يا أبا ذر ، ألم تر إلى صاحبكم غفر له وأدخل الجنة ، يعني الذي رجم .(@)(@@) % ( حم عن أبي ذر ) .(@)(@@) 13112 - يا هزال بئس ما صنعت بيتيمك لو سترت عليه بطرف ردائك لكان خيرا لك .(@)(@@) % ( ابن سعد عن يزيد بن نعيم بن هزال عن أبيه عن جده ) ( أخرجه ابن سعد في الطبقات الكبرى بطوله ( 4 / 324 ) . ص ) .(@)(@@) 13113 - أذكركم بالله الذي نجاكم من آل فرعون وأقطعكم البحر وظلل عليكم الغمام وأنزل عليكم المن والسلوى وأنزل عليكم التوراة على موسى أتجدون في كتابكم الرجم .(@)(@@) % ( د عن عكرمة ) مرسلا ( أخرجه أبو داود كتاب الشهادات باب الذمى كيف يستحلف رقم ( 3609 ) وقال المنذري : مرسل . ص ) .(@)(@@) | 1 ( { حد الأمة من الإكمال } ) 1(@)(@@) 13114 - إذا زنت أمة أحدكم فليجلدها ثلاثا بكتاب الله ، فإن عادت فليبعها ولو بحبل من شعر .(@)(@@) % ( ت حسن صحيح عن 
ms1736	 أبي هريرة ) .(@)(@@) PageV05P133(@)(@@) 13115 - إذا زنت أمة أحدكم فليجلدها ولا يعيرها ولا يقيدها ثم إذا زنت فليجلدها ولا يعيرها ولا يقيدها ، ثم إذا زنت الثالثة فليبعها ولو بحبل من شعر .(@)(@@) % ( عب وابن جرير عن أبي هريرة ) .(@)(@@) 13116 - إذا زنت أمة أحدكم فليجلدها ولا يثرب عليها فإن عادت فليجلدها فإن عادت فليبعها ولو بضفير من شعر .(@)(@@) % ( ش عن أبي هريرة ) .(@)(@@) 13117 - إن الأمة قد ألقت فروة رأسها .(@)(@@) % ( ش عن عطاء ) مرسلا .(@)(@@) | 1 ( الفرع الخامس في حد اللواطة وإتيان البهيمة ) 1(@)(@@) 13118 - من وجدتموه يعمل عمل قوم لوط ، فاقتلوا الفاعل والمفعول به .(@)(@@) % ( حم 4 قط ك هق والضياء عن ابن عباس ) ( أخرجه الحاكم في المستدرك كتاب الحدود ( 4 / 355 ) وقال : صحيح الإسناد ووافقه الذهبي على التصحيح . ص ) .(@)(@@) 13119 - إن أخوف ما أخاف على أمتي عمل قوم لوط .(@)(@@) % ( حم ت ه ك عن جابر ) ( أخرجه في المستدرك ( 4 / 357 ) وقال : صحيح الإسناد ووافقه الذهبي .(@)(@@) وابن ماجه كتاب الحدود باب من عمل عمل قوم لوط رقم ( 2563 ) ص ) .(@)(@@) 13120 - من مات من أمتي يعمل عمل قوم لوط نقله الله إليهم حتى يحشر معهم .(@)(@@) % ( خط عن أنس ) .(@)(@@) 13121 - من وجدتموه وقع على بهيمة ، فاقتلوه واقتلوا البهيمة .(@)(@@) % ( ت ك عن ابن عباس ) .(@)(@@) 13122 - من وقع على ذات محرم فاقتلوه ، ومن وقع على بهيمة فاقتلوه واقتلوا البهيمة .(@)(@@) % ( ه ك عن ابن عباس ) ( رواه ابن ماجه كتاب الحدود باب من أتى ذات محرم ومن أتى بهيمة رقم ( 2564 ) وعن ابن عباس . ص ) .(@)(@@) 13123 - من أتى بهيمة ؛ فاقتلوه واقتلوها معه .(@)(@@) % ( د عن ابن عباس ) ( رواه أبو داود كتاب الحدود باب فيمن أتى بهيمة رقم ( 4440 ) .(@)(@@) وذكر الهيثمي في مجمع الزوائد ( 6 / 273 ) وقال : رواه أبو يعلى وفيه محمد بن عمرو بن علقمة وحديثه حسن وبقية رجاله ثقات . انتهى . ص ) .(@)(@@) | 1 ( الإكمال من الفرع الخامس في حد اللواطة وإتيان البهيمة ) 1(@)(@@) 13124 - ارجموا الأعلى والأسفل ، ارجموها جميعا [ يعني الذي يعمل عمل قوم لوط ] .(@)(@@) % ( ه عن أبي هريرة ) ( رواه ابن ماجه كتاب 
ms1737	 الحدود - باب من عمل عمل قوم لوط رقم ( 2562 ) . ص ) .(@)(@@) 13125 - اقتلوا الفاعل والمفعول به في عمل قوم لوط ، والبهيمة والواقع على البهيمة ومن وقع على ذات محرم فاقتلوه .(@)(@@) % ( حم عن ابن عباس ) .(@)(@@) 13126 - إن أخوف ما أخاف على أمتي عمل قوم لوط .(@)(@@) % ( حم ت حسن غريب وابن منيع ع ك هب ص عن جابر ) .(@)(@@) 13127 - من أتى شيئا من النساء أو الرجال في أدبارهن فقد كفر .(@)(@@) % ( عق عن أبي هريرة ) .(@)(@@) 13128 - من أتى امرأة في دبرها لم ينظر الله إليه يوم القيامة .(@)(@@) % ( الدارمي عن أبي هريرة ) .(@)(@@) PageV05P134(@)(@@) 13129 - من عمل عمل قوم لوط فارجموا الفاعل والمفعول به .(@)(@@) % ( ك عن أبي هريرة ) ( أخرجه الحاكم في المستدرك كتاب الحدود ( 4 / 355 ) وقال الذهبي : فيه عبد الرحمن ساقط . ص ) .(@)(@@) 13130 - من عمل عمل قوم لوط فاقتلوه .(@)(@@) % ( الخرائطي في مساوي الأخلاق عن جابر وابن جرير ) .(@)(@@) 13131 - من مات وهو يعمل عمل قوم لوط سار به قبره حتى يصير معهم ويحشر يوم القيامة معهم .(@)(@@) % ( ابن عساكر عن وكيع قال : سمعنا في حديث فذكره ) .(@)(@@) 13132 - من وجدتموه يعمل عمل قوم لوط فارجموا الأعلى والأسفل جميعا .(@)(@@) % ( الخرائطي في مساوي الأخلاق وابن جرير عن أبي هريرة ) .(@)(@@) 13133 - سيكون في آخر الزمان أقوام يقال لهم اللوطية على ثلاثة أصناف : فصنف ينظرون ويتكلمون ، وصنف يصافحون ويعانقون وصنف يعملون ذلك العمل ، فلعنة الله عليهم إلا أن يتوبوا فمن تاب تاب الله عليه .(@)(@@) % ( الديلمي عن أبي سعيد ) .(@)(@@) 13134 - لا تزال شعبة من اللوطية في أمتي إلى يوم القيامة .(@)(@@) % ( الحسن بن سفيان عن عبد الله بن ناسح ) .(@)(@@) 13135 - كان اللواط في قوم لوط في النساء قبل أن يكون في الرجال بأربعين سنة .(@)(@@) % ( ابن أبي الدنيا في ذم الملاهي وابن أبي حاتم هب وابن عساكر عن أبي صخرة ( جامع بن شداد المحاربي أبو صخرة الكوفي أحد الفضلاء قال أبو حاتم : ثقة ، قال ابن سعد توفي سنة 118 ه .(@)(@@) خلاصة تذهيب الكمال ( 1 / 159 ) . ص ) جامع بن شداد ) مرسلا .(@)(@@) 13136 - من أحب عمل قوم لوط 
ms1738	 شرا كان أو خيرا فهو كمن عمله .(@)(@@) % ( ابن النجار والديلمي عن محمد بن علي عن أبيه عن جده ) .(@)(@@) | 1 ( الفصل الثاني { في حد الخمر } وفيه ثلاثة فروع ) 1(@)(@@)(@)(@@) | 1 ( الفرع الأول في الوعيد على شارب المسكر مطلقا ) 1(@)(@@) 13137 - اجتنبوا كل مسكر .(@)(@@) % ( طب عن عبد الله بن معقل ) .(@)(@@) 13138 - اجتنبوا ما أسكر .(@)(@@) % ( الحلواني عن علي ) .(@)(@@) 13139 - احذروا كل مسكر ، فإن كل مسكر حرام .(@)(@@) % ( طس عن بريدة ) .(@)(@@) 13140 - إن الأوعية لا تحرم شيئا فانتبذوا فيما بدا لكم واجتنبوا كل مسكر .(@)(@@) % ( طب عن قرة بن ياسر ) .(@)(@@) 13141 - حرام قليله ما أسكر كثيره .(@)(@@) % ( البغوي عن واقد ) .(@)(@@) PageV05P135(@)(@@) 13142 - أهل اليمن ، قليل ما أسكر كثيره حرام .(@)(@@) % ( حب عن جابر ) .(@)(@@) 13143 - كل مخمر خمر ، وكل مسكر حرام ، ومن شرب مسكرا بخست ( بخست : أي نقصت يقال : بخست الكيل بخسا نقصته وثمن بخس ناقص انتهى . المصباح المنير ( 1 / 52 ) . ب ) صلاته أربعين صباحا فإن تاب تاب الله عليه ، فإن عاد الرابعة كان حقا على الله أن يسقيه من طينة الخبال ، قيل : ماطينة الخبال يا رسول الله ؟ قال : صديد أهل النار ومن سقاه صغيرا لا يعرف حلاله من حرامه كان حقا على الله أن يسقيه من طينة الخبال .(@)(@@) % ( د عن ابن عباس ) ( رواه أبو داود كتاب الأشربة باب ما جاء في السكر رقم ( 3663 ) ص ) .(@)(@@) 13144 - كل مسكر حرام وإن على الله لعهدا لمن شرب المسكر أن يسقيه من طينة الخبال عرق أهل النار .(@)(@@) % ( حم م عن جابر ) .(@)(@@) 13145 - كل مسكر حرام على كل مؤمن .(@)(@@) % ( ه عن معاوية ) .(@)(@@) 13146 - كل ما أسكر عن الصلاة فهو حرام .(@)(@@) % ( م عن أبي موسى ) .(@)(@@) 13147 - أنهى عن كل مسكر أسكر عن الصلاة .(@)(@@) % ( م عن أبي موسى ) .(@)(@@) 13148 - أنهاكم عن قليل ما أسكر كثيره .(@)(@@) % ( ن عن سعد ) .(@)(@@) 13149 - كل شراب أسكر فهو حرام .(@)(@@) % ( حم ق عد عن عائشة ) .(@)(@@) 13150 - لا تشرب مسكرا فإني حرمت كل مسكر .(@)(@@) % ( ن عن أبي موسى ) .(@)(@@) 13151 - كل مسكر حرام .(@)(@@) % ( حم ق د ن ه عن أبي موسى ) ( حم ن 
ms1739	 عن أنس ) ( حم د ه ن عن ابن عمر ) ( حم ن ه عن أبي هريرة ) ( ه عن ابن مسعود ) .(@)(@@) 13152 - كل مسكر حرام ، وما أسكر منه الفرق ( الفرق : الفرق بالتحريك مكيال يسع ستة عشر رطلا وهي اثنا عشر مدا ، أو ثلاثة آصع عند أهل الحجاز . انتهى . النهاية ( 3 / 437 ) . ب ) فملأ الكف منه حرام .(@)(@@) % ( د ت عن عائشة ) ( رواه الترمذي كتاب الأشربة باب ما جاء ما أسكر كثيره فقليله حرام رقم ( 1866 ) وقال : حسن .(@)(@@) وأبو داود كتاب الأشربة باب النهي عن المسكر رقم ( 3670 ) ص ) .(@)(@@) 13153 - كنت نهيتكم عن الأوعية ، فانتبذوا واجتنبوا كل مسكر .(@)(@@) % ( ه عن بريدة ) .(@)(@@) 13154 - ما أسكر كثيره فقليله حرام .(@)(@@) % ( حم د ت حب عن جابر ) ( حم ن ه عن ابن عمرو خ ) .(@)(@@) 13155 - ما أسكر منه الفرق فملئ الكف منه حرام .(@)(@@) % ( حم عن عائشة خ ) .(@)(@@) 13156 - من شرب مسكرا ما كان ، لم يقبل الله له صلاة أربعين يوما .(@)(@@) % ( طب عن السائب بن يزيد ) ( رواه الطبراني وفيه : يزيد بن عبد الملك النوفلي وهو متروك . مجمع الزوائد ( 5 / 71 ) . ص ) .(@)(@@) 13157 - المزر ( المزر : بالكسر : نبيذ يتخذ من الذرة . وقيل : من الشعير أو الحنطة النهاية ( 4 / 324 ) . ب ) كله حرام أبيضه وأحمره وأسوده وأخضره .(@)(@@) % ( طب عن ابن عباس ) .(@)(@@) 13158 - نهى عن كل مسكر ومفتر ( ومفتر : المفتر : الذي إذا شرب أحمى الجسد وصار فيه فتور ، وهو ضعف وانكسار . يقال : أفتر الرجل فهو مفتر : إذا ضعفت جفونه وانكسر طرفه . انتهى . النهاية ( 3 / 408 ) . ب ) .(@)(@@) % ( حم د عن أم سلمة ) ( رواه أبو داود كتاب الأشربة - باب ما جاء في النهي عن المسكر ، رقم ( 3669 ) . ص ) .(@)(@@) | 1 ( { الخمر } ) 1(@)(@@) 13159 - اجتنبوا الخمر فإنها مفتاح كل شر .(@)(@@) % ( ك هب عن ابن عباس ) .(@)(@@) PageV05P136(@)(@@) 13160 - أشهد بالله وأشهد بالله لقد قال لي جبريل : يا محمد إن مدمن الخمر كعابد وثن .(@)(@@) % ( الشيرازي في الألقاب وأبو نعيم في مسلسلاته وقال صحيح ثابت عن علي ) .(@)(@@) 13161 - أول ما نهاني عنه ربي بعد عبادة الأوثان شرب الخمر ، وملاحاة الرجل .(@)(@@) % ( طب 
ms1740	 عن أبي الدرداء وعن معاذ ) ( رواه البزار والطبراني وفيه عمرو بن واقد ، وهو متروك رمى بالكذب وقال محمد بن المبارك الصوري ، كان صدوقا ورد قوله والجمهور ضعفوه مجمع الزوائد ( 5 / 53 ) وملاحاة الرجال : مقاومتهم ومخاصمتهم . ص ) .(@)(@@) 13162 - إياك والخمر فإن خطيئتها تفرع الخطايا كما أن شجرتها تفرع الشجرة .(@)(@@) % ( ه عن خباب ) ( رواه ابن ماجه كتاب الأشربة باب الخمر مفتاح كل شر رقم ( 3372 ) وفي الزوائد : نمير ابن الزبير الشامي الأزدي ، وهو ضعيف . ص ) .(@)(@@) 13163 - كل مسكر خمر ، وكل مسكر حرام ، ومن شرب الخمر في الدنيا فمات وهو يدمنها لم يتب لم يشربها في الآخرة .(@)(@@) % ( حم م 4 عن ابن عمر ) .(@)(@@) 13164 - ليستحلن طائفة من أمتي الخمر باسم يسمونها إياه .(@)(@@) % ( حم والضياء عن عبادة بن الصامت ) .(@)(@@) 13165 - لا يزال العبد في فسحة من دينه ما لم يشرب الخمر ؛ فإذا شربها خرق الله عنه ستره ، وكان الشيطان وليه وسمعه وبصره ورجله يسوقه إلى كل شر ، ويصرفه عن كل خير .(@)(@@) % ( طب عن قتادة بن عياش ) .(@)(@@) 13166 - ليشربن أناس من أمتي الخمر يسمونها بغير اسمها .(@)(@@) % ( حم د عن أبي مالك الأشعري ) .(@)(@@) 13167 - ليشربن أناس من أمتي الخمر يسمونها بغير اسمها ، ويضرب على رؤسهم بالمعازف والقينات ( القينات : القينة : الأمة غنت أو لم تغن ، والماشطة وكثيرا ما تطلق على المغنية من الإماء وجمعها قينات وتجمع على قيان أيضا . انتهى . النهاية ( 4 / 135 ) . ب ) يخسف الله بهم الأرض ويجعل منهم قردة وخنازير .(@)(@@) % ( حب طب هب عنه ) .(@)(@@) 13168 - ليكونن في هذه الأمة خسف وقذف ومسخ ، وذلك إذا شربوا الخمور واتخذوا القينات وضربوا بالمعازف .(@)(@@) % ( ابن أبي الدنيا في ذم الملاهي عن أنس ) .(@)(@@) 13169 - ليمسخن قوم وهم على أريكتهم ( أريكتهم : الأريكة : السرير في الحجلة من دونه ستر ، ولا يسمي منفردا أريكة وقيل هو كل ما اتكئ عليه من سرير أو فراش أو منصة . انتهى . النهاية ( 1 / 40 ) ب ) قردة وخنازير لشربهم الخمر وضربهم بالبرابط ( بالبرابط : البربط : ملهاة تشبه العود . انتهى . ( 1 / 112 ) ب ) والقيان .(@)(@@) % ( ابن أبي الدنيا في ذم الملاهي 