ms811	 ار یک جهان خصم است آن کس را که گر خواهد %~% جهانی نو پدید آرد جهاندار از پی کامش(@)(@@) 56 دریغا گنجه خرم که اکنون جای ماتم شد %~% که از فر چنین صدری فراق افتاد فرجامش(@)(@@) 57 اگر در جنبش آید باز خاک او عجب نبود %~% گر این کوه شریعت بود چندین گاه آرامش(@)(@@) 58 زهی صدری که خصمت را گیا نفرین همی خواند %~% نگر تا آنکه جان دارد چه نفرین بر زبان راند(@)(@@) 59 مبارک حضرتا ایام در ظل تو آساید %~% مقدس خاطرا اسلام را رای تو پیراید(@)(@@) 60 روان صاحب الاعراف موقوف است تا محشر %~% میان دوزخ و فردوس که تا رایت چه فرماید(@)(@@) 61 کسی کز خیل اعدای تو شد بر روزگار او %~% قضا خندان همی آید قدر دندان همی خاید(@)(@@) 62 بفرساید ز سوز دولت تو سد اسکندر %~% چه باشد جان یاجوجی کز آن آتش نفرساید(@)(@@) 63 حسودان تو گرچه دیگ‌ها پختند می‌دانم %~% که در وی نیست آن چیزی که زا شهر شما زاید(@)(@@) 64 حدیث و فعلشان بی‌حرف گویی صفر بر جانش %~% چو گفتم در دگر جایش دگر گفتن چه می‌باید(@)(@@) 65 عروسان سر کلک تو در پرده شدند از من %~% مرا هم هدیه‌ای باید که هر یک روی بنماید(@)(@@) 66 من این تحفه طرازیدم به دندان مزدشان آری %~% عروس آخر چو هدیه دید دانم روی بگشاید(@)(@@) 67 چو یزدان وحی کرد از غیب سوی نحل می‌شایست %~% اگر تو سوی خاقانی فرستی نامه‌ای شاید(@)(@@) 68 اگر ذات تو یزدان وار فیض فضل می‌بارد %~% ضمیرم نیز نحل آسا شفای جان می‌افزاید(@)(@@) 69 به جان تو که گردون را ولیعهد است جاه تو %~% اگر درعهد تو چون من سخن‌گویی پدید آید(@)(@@) 70 سخن پیرایه کهنه است و طبع من مطرا گر %~% مرا بنمای استادی کز این سان کهنه آراید PageV1P1357(@)(@@)(@@)(@@) || [genre: Tk](@)(@@) 1 خوش خوش به روی ساقیان دیدند خندان صبح را %~% گوئی به عود سوخته شستند دندان 
ms812	 صبح را(@)(@@) 2 یا نخل بندی کرد شب زان خوشه پروین رطب %~% کان صنعت نغز ای عجب کرده است خندان صبح را(@)(@@) 3 گردون ز مشک و زعفران سازد حنوط اختران %~% بر سوک آن دامن تران درد گریبان صبح را(@)(@@) 4 یا آه عاشق بود خود بر صبح سوزی نامزد %~% کان تیر آتش پاش زد بدرید خفتان صبح را(@)(@@) 5 کو ساقی دریاکشان کو ساغر دریا نشان %~% کز عکس آن گوهر فشان بینی صدف سان صبح را(@)(@@) 6 دریاب عیش صبح دم تا نگذرد بگذر ز غم %~% کانگه به عمری نیم دم دریافت نتوان صبح را(@)(@@) 7 مرد از دو رنگی طاق به این رنگ‌ها بر طاق نه %~% هم دور خود هم دور ده و انصاف بستان صبح را(@)(@@) 8 با صبح خوش درکش عنان برجه رکاب می ستان %~% کز کم حیاتی در جهان تنگ است میدان صبح را(@)(@@) 9 بر روی صبح از ژاله خوی خوی سرد بین بر روی وی %~% گوئی زدش زنبور دی چون دید عریان صبح را(@)(@@) 10 بستان ز ساقی جام زر هم بر رخ ساقی بخور %~% وقت دو صبح آن لعل‌تر در ده سه گردان صبح را(@)(@@) 11 کیخسروانه جام می خون سیاوش رنگ وی %~% چون آتش کاوس کی کرده زر افشان صبح را(@)(@@) 12 از جرعه ریز شاه بین بر خاک عقد عنبرین %~% گوئی بدان عنبر زمین آلود دامان صبح را(@)(@@) 13 نزل صباحی پیش خوان تا حور برخوان آیدت %~% خون صراحی بیش ران تا نور در جان آیدت(@)(@@) 14 ز آن سوی کوه است آفتاب از بوی می مست و خراب %~% از سر برآرد نیم خواب افتان و خیزان آیدت(@)(@@) 15 در بزم عیش افروختن کوه از سماع آموختن %~% همچون سپند از سوختن در رقص و افغان آیدت(@)(@@) 16 چون رطل‌ها رانی گران خیل نشاط از هر کران %~% همچون خیال دلبران ناخوانده مهمان آیدت(@)(@@) 17 دل بر سر خوان طرب چون مرغ 
ms813	 فردوسی طلب %~% یک نیمه گویا ای عجب یک نیمه بریان آیدت(@)(@@) 18 هست این زمین را نه به نو کاس کریمان آرزو %~% یک جرعه کن در کار او آخر چه نقصان آیدت(@)(@@) 19 چون جرعه‌ها رانی گران باری بهش باش آن زمان %~% کز زیر خاک دوستان آواز عطشان آیدت(@)(@@) 20 آن نازنینان زیر خاک افکنده چرخ‌اند پاک %~% ای بس که نالی دردناک ار یاد ایشان آیدت(@)(@@) 21 گر داد آزادی دهی قد خم کنی در خم جهی %~% ور پی ز خود بیرون نهی آتش گلستان آیدت(@)(@@) 22 چون از نیازت بوی نه کعبه پرستی روی نه %~% چون آبت اندر جوی نه پل کردن آسان آیدت(@)(@@) 23 تا زهد تو زرق است بس بر کفر داری دست رس %~% می گیر و صافی کن نفس تا کفر ایمان آیدت(@)(@@) 24 بگذار زهد بی‌نمک هل تا فرود آید فلک %~% هر رخنه کید یک به یک بر طاق ویران آیدت(@)(@@) 25 مجلس پری خانه شمر بزم سلیمان بین در او %~% در صفه‌ها بستان نگر صف‌های مرغان بین در او(@)(@@) 26 کام قنینه خون فشان چون اشک داود از نشان %~% مرغ صراحی جان کنان داودی الحان بین در او(@)(@@) 27 گر فاسقان را از گنه در باغ رضوان نیست ره %~% در روی ساقی کن نگه صد باغ رضوان بین در او(@)(@@) 28 ور بت پرستان را به جان ندهند در کعبه امان %~% کوی بتان را کعبه دان زمزم خمستان بین در او(@)(@@) 29 چون شد هوا سنجاب‌گون گیتی فنک دارد کنون %~% در طارم آتش کن فزون روباه خزران بین در او(@)(@@) 30 شکل تنوره چون قفس طاوس و زاغش هم‌نفس %~% چون ذروه افلاک بس مریخ و کیوان بین در او(@)(@@) 31 خیک است شش پستان زنی رومی دل زنگی تنی %~% مریم صفت آبستنی عیسی دهقان بین در او(@)(@@) 32 چون نیش چوبین را کنون رگ‌های زرین شد زبون %~% خیز از رگ خم ریز خون قوت 
ms814	 رگ جان بین در او(@)(@@) 33 بربط تنی بی‌جان نگر موزون به چار ارکان نگر %~% هر هشت رگ میزان نگر زهره به میزان بین در او(@)(@@) 34 نالان رباب از بس‌زدن هم کفچه سر هم کاسه تن %~% چو بین خرش زرین رسن بس تنگ میدان بین در او(@)(@@) 35 چنگ است عریان وش سرش صدره بریشم در برش %~% بسته پلاسین میزرش زانوش پنهان بین در او(@)(@@) 36 نایست چون طفل حبش ده دایگانش ترک وش %~% نه چشم دارد شوخ و خوش صد چشم حیران بین در او(@)(@@) 37 دف را خم چوگان شه با صورت ایوان شه %~% هم‌چون شکارستان شه اجناس حیوان بین در او(@)(@@) 38 شرطی کز اول داشتی با عشق خوبان تازه کن %~% با یوسفان گرگ آشتی پیش آر و پیمان تازه کن(@)(@@) 39 ای عاشق جان بر میان با دوست نه جان در میان %~% نقش زر سودائیان از مهر سلطان تازه کن(@)(@@) 40 ساقی فریب آمیز بین مطرب نشاط انگیز بین %~% بازار می زان تیز بین مرسوم جان زان تازه کن(@)(@@) 41 ز انگشت ساقی خون رز بستان وز آن انگشت مز %~% بر زاهدان انگشت گز با شاهدان جان تازه کن(@)(@@) 42 در پهلوی خم پشت خم بنشین و دریاکش بدم %~% برچین به مژگان جرعه هم از خاک مژگان تازه کن(@)(@@) 43 می‌ساز تسکین هر زمان عید طرب بین هر زمان %~% از گاو سیمین هر زمان خون ریز و قربان تازه کن(@)(@@) 44 خوش عطسه روز است می ریحان نوروز است می %~% در شب افروز است می زان در شبستان تازه کن(@)(@@) 45 این گنبد نارنج گون بازیچه دارد ز اندرون %~% ز آه سحرگاهش کنون رو سنگ‌باران تازه کن(@)(@@) 46 از صور آه اخترشکن طاق فلک‌ها درشکن %~% بند طبایع برشکن هر چار طوفان تازه کن(@)(@@) 47 خاقانیا سگ‌جان شدی کانده کش جانان شدی %~% در عشق سر دیوان شدی نامت به دیوان تازه کن(@)(@@) 48 عشق آتشی کابت 
ms815	 ربود از عشق نگریزی چه سود %~% آن دل که در بغداد بود اکنون به شروان تازه کن(@)(@@) 49 چون جام گیری داد ده می تا خط بغداد ده %~% بغداد ما را یاد ده سودای خوبان تازه کن(@)(@@) 50 تا بر کنار دجله دوش آن آفت جان دیده‌ام %~% از خون کنارم دجله شد تا خود چرا آن دیده‌ام(@)(@@) 51 سروی ز بستان ارم شمع شبستان حرم %~% رویش گلستان عجم کویش دلستان دیده‌ام(@)(@@) 52 بغداد جان‌ها روی او طرار دل‌ها موی او %~% دل دل کنان در کوی او چون خود فراوان دیده‌ام(@)(@@) 53 باشد به بغداد اندرون طرار پنهان از فسون %~% در زلف طرارش کنون بغداد پنهان دیده‌ام(@)(@@) 54 دجله ز زلفش مشک دم زلفش چو دال دجله خم %~% نازک تنش چون دجله هم کش کش خرامان دیده‌ام(@)(@@) 55 آمیخته مه با قصب انگیخته طوق از غبب %~% دستارچه بسته ز شب بر ماه تابان دیده‌ام(@)(@@) 56 افتاده چون اشک منش نور غبب بر دامنش %~% زان نور سیمین گردنش زرین گریبان دیده‌ام(@)(@@) 57 زلفش چلیپا خم شده لعلش مسیحا دم شده %~% زلف و لبش باهم شده ظلمات و حیوان دیده‌ام(@)(@@) 58 جان از تنش تیمار کش چون چشم او بیمار و خوش %~% دل چون دهانش پسته‌وش خونین و خندان دیده‌ام(@)(@@) 59 او سرگران با گردنان من در پیش بر سر زنان %~% دلها دوان دندان‌کنان دامن به دندان دیده‌ام(@)(@@) 60 تیز است چون بازار او عاجز شدم در کار او %~% جان در خط دلدار او مدهوش و حیران دیده‌ام(@)(@@) 61 زلفش بسان زنگیان درهم شده بر هر کران %~% بر عارضش بازی‌کنان افتان و خیزان دیده‌ام(@)(@@) 62 دجله ز تف آه خود کردم تیمم‌گاه خود %~% بغداد را در راه خود از دیده طوفان دیده‌ام(@)(@@) 63 خاقانیا جان برفشان در من یزید عاشقان %~% کان گوهر ار بخری به جان ارزد که ارزان دیده‌ام(@)(@@) 64 چون عزم داری راه را چون دل دهی دل‌خواه را %~% فرمان شروان 
ms816	 شاه را بر جان نگهبان دیده‌ام(@)(@@) 65 نی نی ز خوبان غافلم در کار ایشان نیستم %~% آزاد کرد همتم در بند خوبان نیستم(@)(@@) 66 خود کوی سودا نسپرم خود روی زیبا ننگرم %~% بر دام خوبان نگذرم چون مرغ ایشان نیستم(@)(@@) 67 یاد بتان تا کی کنم فرش هوس را طی کنم %~% این اسب چوبین پی کنم چون مرد میدان نیستم(@)(@@) 68 شیدای هر مهوش نیم جویای هر دلکش نیم %~% پروانه آتش نیم مرغ سلیمان نیستم(@)(@@) 69 بس نقب کافکندم نهان بر حقه لعل بتان %~% صبح خرد چون شد عیان نقاب پنهان نیستم(@)(@@) 70 ساقی غم را ز اندرون چون سوخته بیدم کنون %~% تا چند بارم اشک خون گر رواق افشان نیستم(@)(@@) 71 هستم به چشم دوستان هستی که پیدا نیست آن %~% بهر چه هستم بی‌نشان گر وصل جانان نیستم(@)(@@) 72 گر کس بود سگ‌جان منم این چرخ سگ‌دل دشمنم %~% تا کی زید زرین تنم گر آهنین جان نیستم(@)(@@) 73 جستم سراپای جهان شیب و فراز آسمان %~% گر هیچ اهلی در جهان دیدم مسلمان نیستم(@)(@@) 74 مانم به خاک کم بها لب تشنه آب وفا %~% کز جرعه هیچ آشنا آلوده دامان نیستم(@)(@@) 75 برد آبرویم آرزو ایمه کدام آب و چه رو %~% روی از کجا و آب کو خود در غم آن نیستم(@)(@@) 76 سلطان برنائی مگر بهر سواری شد بدر %~% تا کی پیاده بر اثر پویم که سگبان نیستم(@)(@@) 77 هرکس به قدر کام خود جوید به دیوان نام خود %~% من باز جستم نام خود در هیچ دیوان نیستم(@)(@@) 78 آتش ز من بنهفت دم گر زند خوانم دید کم %~% مصحف ز من بگریخت هم کز اهل ایمان نیستم(@)(@@) 79 نه کعبه را محرم نیم مرد کنیسه هم نیم %~% نه بابت زمزم نیم مرد خمستان نیستم(@)(@@) 80 گر کعبه می‌دانی نیم ور دیر می‌خوانی نیم %~% مشغول خاقانی نیم مقبول خاقان نیستم(@)(@@) 81 گردون علم برخوانمش انجم سپه ران بینمش %~% طاس 
ms817	 از مه نو دانمش پرچم ز کیوان بینمش(@)(@@) 82 ضرغام زهره گوهرش بهرام دهره لشکرش %~% بینام بهره ز اخترش فتحی که توران بینمش(@)(@@) 83 نپسندم از خود اینقدر کز دولت او ما حضر %~% زیر نگین و خطبه در بلغار و خزران بینمش(@)(@@) 84 خواهم ز بخت یک دلش در عرش بینم منزلش %~% زرادخانه بابلش مر بط خراسان بینمش(@)(@@) 85 لفظم کند گوهرفشان کز فتح شه یابم نشان %~% چون گردن گردن‌کشان در طوق فرمان بینمش(@)(@@) 86 چون کاسه یوزش جهان حلقه به گوش آمد چنان %~% کو تاج شیر سیستان نعلین سگبان بینمش(@)(@@) 87 نعلی که افکند ادهمش شمشیر سازد رستمش %~% مومی که گیرد خاتمش حرز سلیمان بینمش(@)(@@) 88 اسبی کبود است آسمان هرای زرین اختران %~% باشد به نام اخستان داعی که بر ران بینمش(@)(@@) 89 چون با رضا گردد قرین جبریل بینم بر زمین %~% ور در فلک بیند بکین هر چار طوفان بینمش(@)(@@) 90 از بس که لب‌های سران بوسد سم اسبش عیان %~% چون جویم از نعلش نشان مسمار مرجان بینمش(@)(@@) 91 انجم بریزند از حسد جان‌ها گریزند از جسد %~% کاید چو شمس اندر اسد وز چرخ میدان بینمش(@)(@@) 92 آن پیل مست انگیخته وز دست شست آمیخته %~% با بحر دست آمیخته تمساح پیچان بینمش(@)(@@) 93 جوزا لگام مرکبش وز گرد قلب عقربش %~% روی آفتاب و تن شبش دم جو ز هر سان بینمش(@)(@@) 94 خورشید چون مولای او بوسه زند بر پای او %~% هر صبح از سودای او بر خاک غلطان بینمش(@)(@@) 95 امید عدلش ملک را چون عقل در جان پرورد %~% خورشید فضلش خلق را چون لعل در کان پرورد(@)(@@) 96 خلقش که گل را برد آب از تابش رای صواب %~% آن گل‌شکردان کافتاب اندر صفاهان پرورد(@)(@@) 97 اقبال او خزران ستان با عدل شد هم‌داستان %~% پیل آرد از هندوستان آنگه به خزران پرورد(@)(@@) 98 بستان دولت کشورش در دست صلت گسترش %~% شمشیر صولت پرورش ابری که بستان پرورد 
