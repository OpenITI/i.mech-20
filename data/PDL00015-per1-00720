ms701	 جهان در دست روحست آن جهان در دست عقل %~% پای همت بر قفای هر دو ده سالار زن(@)(@@) 22 هفت چرخ و چار طبع و پنج حس محرم نیند %~% خیمه عشرت برون زین هفت و پنج و چار زن(@)(@@) 23 در میان عاشقان بی آگهی چشم و دهان %~% اشک عاشق‌وار پاش و نعره عاشق‌وار زن(@)(@@) 24 گر همی خواهی که گردی پیشوای عاشقان %~% شو نوای بیخودی چون ساز موسیقار زن(@)(@@) 25 سنگ در قندیل طالب علم عالم جوی کوب %~% چنگ در فتراک صاحب درد دردی خوار زن(@)(@@) 26 گر ز چاه جاه خواهی تا برآیی مردوار %~% چنگ در زنجیر گوهردار عنبربار زن(@)(@@) 27 تا تو بر پشت ستوری بار او بر جان تست %~% چون به ترک خر بگفتی آتش اندر بار زن(@)(@@) 28 از برای آنکه گل شاگرد رنگ روی اوست %~% گر هزارت بوسه باشد بر سر یک خار زن(@)(@@) 29 ور همی دندان ما را از لطف خواهی شکرین %~% یاد آب لب گیر و بوسی بر دهان مار زن(@)(@@) 30 چهره چون دینار گردان در سرای ضرب دوست %~% پس به نام مفخر دین مهر بر دینار زن(@)(@@) 31 چون قبول مفخر دین بلمفاخر یافتی %~% آتش اندر لاف دی و کفر و فخر و عار زن(@)(@@) 32 آنکه از شمشیر شرع اندر مصاف کفر و شر %~% رایت همنام خود را کرد همانم پدر(@)(@@) 33 آنکه پیش رای و لفظش گویی اندر کار دین %~% روشنی گوهر فرامش کرد و شیرینی شکر(@)(@@) 34 آن نکو نامی که بیرون برد چون همنام خویش %~% رخت عشق از هشت باغ و هفت بام و پنج در(@)(@@) 35 آنکه بهر ارغوانی رنگش از ایثار نور %~% کرد خالی بر درخت ارغوان کیسه قمر(@)(@@) 36 کاذبات را حلم او چون صبح کاذب پرده‌وار %~% صادقان را علم او چون صبح صادق پرده‌در(@)(@@) 37 هست پیش مدعی و مدعا از روی عدل %~% آفتاب سایه‌دار و سایه خورشیدفر(@)(@@) 38 گر قضا 
ms702	 دریای ژرف آمد از آن او را چه باک %~% آفتاب و سایه را هرگز نکردست آب تر(@)(@@) 39 شد ز نور رای او چشم بداندیشان چو سیم %~% گشت از فضل علومش کار ملت همچو زر(@)(@@) 40 هر که بر وی دوزبانی کرد چون پرگار و کلک %~% و آنکه در صدرش دورویی کرد چون تیغ و تبر(@)(@@) 41 آن چو تیغ کند کرد اول دل اندر کار تن %~% وین چو کلک سست کرد آخر تن اندر کار سر(@)(@@) 42 رتبت سامیش چون بسم‌الله آمد نزد عقل %~% ز آنکه آن تاج سور گشتست و این تاج صور(@)(@@) 43 او و بسم‌الله تو گویی دو درند از یک صدف %~% او و بسم‌الله تو گویی دو برند از یک شجر(@)(@@) 44 این دو عالم علم دارد در نهاد منتخب %~% وان جهانی رمز دارد در حروف مختصر(@)(@@) 45 کنیت و نام وی و نام پدرش اکنون ببین %~% حرف آن و این گرت باور نیاید بر شمر(@)(@@) 46 نوزده حرفست این و نوزده حرفست آن %~% هر یکی زین حرف امان از یک عوان اندر سقر(@)(@@) 47 تا نقاب از چهره جان مقدس بر گرفت %~% هر که صاحب دیده بود آنجا دل از دل بر گرفت(@)(@@) 48 حسن عقلش آب و آتش بود و این کس را نبود %~% کاتش از بام اندر آمد آب راه در گرفت(@)(@@) 49 عیسی اندر دور او ناید که او اندر جهان %~% ناوک اندر دیده دجال و گوش خر گرفت(@)(@@) 50 مهره‌ای کش می‌ندید اندر هه دریا سپهر %~% یک صدف بگشاد و کشورها همه گوهر گرفت(@)(@@) 51 آنهمه نوری که عقل و جان نمود از وی نمود %~% آنقدر برگی که شاخ تر گرفت زو برگرفت(@)(@@) 52 عقل کاری داشت در سر لیکن اندر خدمتش %~% چون سر و کاری بدینسان دید کار از سر گرفت(@)(@@) 53 بود شاگرد خرد یک چند لیک اکنون چو باد %~% همتش ز استاد برتر شد دکان برتر گرفت 
ms703	(@)(@@) 54 از سخای بی قیاسش مدح ناخوانده تمام %~% کلک او چون شخص خود مداح را در زر گرفت(@)(@@) 55 رفت عشقش در ترقی تا به طوافان عرش %~% هم وداعیشان بکرد و راه پیشی در گرفت(@)(@@) 56 لاجرم در دور او هر دم همی گویند این: %~% یاد باد آنشب که یار ما ز منزل برگرفت(@)(@@) 57 چون درین عالم به صورت نام پیغمبرش بود %~% رفت از آن عالم به سیرت خوی پیغمبر گرفت(@)(@@) 58 نفس را چونان مخالف شد که نفس از بهر عز %~% هر کرا بر سر گرفت اندر زمان سر بر گرفت(@)(@@) 59 او ز حکمت صدهزاران رمز دید و دم نزد %~% حاسدش از صورتی بادی چنین در سر گرفت(@)(@@) 60 برد آب روی بد دینان صفای رای او %~% تا دل ایشان ازین غم شعله آذر گرفت(@)(@@) 61 لیکن اندر جنب آن آبی که ناگه یافت خضر %~% باد بود آن خاکدانی چند کاسکندر گرفت(@)(@@) 62 آفتاب از طارم نیلوفری در عاشقی %~% از برای راه و رویش رنگ نیلوفر گرفت(@)(@@) 63 چون گرفت اندر نظر تیغ یمانی در یمین %~% بر نهد مر خصم را داغ غلامی بر جبین(@)(@@) 64 گه ز صدقش چون هوا عزلی دگر بیند گمان %~% گه ز حذقش چون خرد ملکی دگر گیرد یقین(@)(@@) 65 تا امام اندر خراسان بلمفاخر شد کنون %~% با خراسانی جز آسانی نباشد همنشین(@)(@@) 66 کنیتش با این لقب ز آنگونه در خورشید هست %~% این و آن ده حرف اکنون خواهی آن و خواه این(@)(@@) 67 آسمان دانست چندین گه که هست ارواح را %~% این چنین دردی در اجزای چنین خاکی دفین(@)(@@) 68 خاکبیزی از پی آن کرد چندین سال و ماه %~% تا چنین دری به دست آورد ناگه بر زمین(@)(@@) 69 گرت باید تا هم اندر خطه کون و فساد %~% نفس کلی را ببینی نفس جزیی را ببین(@)(@@) 70 شاد باش ای شرع بی تو همچو موسا بی‌عصا %~% دیر زی ای علم 
ms704	 بی تو چون سلیمان بی‌نگین(@)(@@) 71 اندوه و شادیت چو ز آرام و جنبش برترست %~% کی تواند کرد طبعت شاد و چرخ اندوهگین(@)(@@) 72 جنبش از نور ملک داری نه از نار فلک %~% عادت از ما معین داری نه از ما مهین(@)(@@) 73 چون به کرسی برشوی خوانند بر جانت همی %~% «قل اعوذ» و «آیة الکرسی» به جنت حور عین(@)(@@) 74 چون تو دامنهای در پاشی بدانگه عقل را %~% از شتاب در چدن گردد گریبان آستین(@)(@@) 75 زهره در چرخ سیم تا شد مریدت زین سپس %~% زهره را بی‌سبحه ننگارد همی نقاش چین(@)(@@) 76 روح قدسی را ترقی نیست زان منزل که هست %~% ورنه از پند تو کروبی شدی روح‌الامین(@)(@@) 77 تا تو سلمانی دگر گشتی مرا در مدح تو %~% بوذر دیگر همی خواند کرام‌الکاتبین(@)(@@) 78 ای ز عصمت بر تو هر ساعت نگهبانی دگر %~% وز بر ما هر زمان فضلی و احسانی دگر(@)(@@) 79 ای ترا از روی همت هم درین ایوان صدر %~% از ورای آفرینش صدر و ایوانی دگر(@)(@@) 80 جز به تعلیم تو اندر عالم ایمان که ساخت %~% هر زمان نو خاتم از بهر سلیمانی دگر(@)(@@) 81 هر که چون شب دامن اقبال تو بگرفت سخت %~% چاک زد چون صبح هر روزی گریبانی دگر(@)(@@) 82 سیف حقی رو که تا تایید حق افسان تست %~% حاجتت ناید به افسون و به افسانی دگر(@)(@@) 83 تا ترا صدر خراسان خواند سلطان عراق %~% شد خراسان بر زمین زین فخر سلطانی دگر(@)(@@) 84 بهر آن تا زین شرف خالی نماند عقل و روح %~% نام کردند آسمان‌ها را خراسانی دگر(@)(@@) 85 در حق خود هم ز حق تشریف او چون می‌رسد %~% هر زمان از حضرت سلطانت فرمانی دگر(@)(@@) 86 خاطر تیز تو تا در دین پدید آمد نماند %~% نیز مر روح‌القدس را هیچ پنهانی دگر(@)(@@) 87 اندرین میدان مر این گوی سیاه و سبز را %~% نیست گویی جز اشارات تو چوگانی دگر 
ms705	(@)(@@) 88 تا بدان ایوان رسانیدت که کیوان را نمود %~% میخ نعل مرکب جاه تو کیوانی دگر(@)(@@) 89 از ورای پرده‌های کن فکان در علم عشق %~% گوهری آری همی هر ساعت از کانی دگر(@)(@@) 90 هست در نفس طبیعی روح حیوانیت را %~% از برای قرب حق هر لحظه قربانی دگر(@)(@@) 91 تا کنون از استواری علت اولا نیافت %~% زندگانی را چو ترکیب تو زندانی دگر(@)(@@) 92 جاودان زی کز برای عمرت از درگاه روح %~% نامزد باشد همی هر ساعتی جانی دگر(@)(@@) 93 ای به همت بوده بی‌سعی سپهر و آفتاب %~% خشکسال خاطر دریاب ما را فتح باب(@)(@@) 94 ای مرا در روضه فضل آوریده بعد از آنک %~% دیده بودم در دو ماه از ده فضولی صد عذاب(@)(@@) 95 گاهم این گفتی تو مردم نیستی از بهر آنک %~% با خران هم صحبتت بینم همیشه چو ذباب(@)(@@) 96 گر نه‌ای از ما چو عیسا چون نپری بر هوا %~% ور ز مایی همچو ما چون خر نرانی در خلاب(@)(@@) 97 گاهم آن گفتی چه مرغی کز برای حس و جسم %~% سر به مر داری فرو ناری و هستی چون عقاب(@)(@@) 98 گاهم آن گفتی سنایی نیستی ار هستیی %~% دلت مشغول ثنایستی نه مشغول ثواب(@)(@@) 99 گویم ار تو هم بدین مشغول باشی به بود %~% زان که به سازد خرف را گرم دار دار خضاب(@)(@@) 100 تشنه چون قانع بود دیرش به پای آرد بحار %~% باز چون طامع بود زودش به دست آرد سراب(@)(@@) 101 گاهم این گفتی که در تو هیچ حکمت نیست زانک %~% چون حکیمانت نبینم ساعتی مست و خراب(@)(@@) 102 گویم او را بل که تا من خر بوم بس بی خرد %~% خاک بر سر حکمتی را کو نیاید بی شراب(@)(@@) 103 گر تو بشناسی حکیم آن مالداری را که او %~% پاسبان خویش را ندهد همی داروی خواب(@)(@@) 104 پس حکیمی هم بدانم جامه شویی را که او %~% رو زدی خورشید را 
ms706	 ز ابر سیه سازد نقاب(@)(@@) 105 نظم من زین یافه گویان تا کنون افسرده بود %~% وین عجب نبود که از سردی فسرده گردد آب(@)(@@) 106 ور کنون از رای تو بگشاد هم نبود عجب %~% زان که چون آتش کلید آب بستست آفتاب(@)(@@) 107 مدح گفتن جز ترا از چون منی باشد خطا %~% مکرمت کردن ترا با مادحت باشد صواب(@)(@@) 108 ای به تو روشن دو موضع هم سرای و هم سریر %~% وی به تو جامع دو جامع هم صغیر و هم کبیر(@)(@@) 109 عزم را سلطان نهادی حزم را شیطان فریب %~% حلم را خاکی مزاجی علم را پاکی پذیر(@)(@@) 110 قابل مدحی نداری چون خط اول همال %~% قایل مدحم ندارم چون دم آخر نظیر(@)(@@) 111 نه ز بد شعری به هر صدری ندارم اختلاط %~% لیک بی‌معنی همی در پیش هر خر خیر خیر(@)(@@) 112 از برای پاره‌ای نان برد نتوان آبروی %~% وز برای جرعه‌ای می‌رفت نتوان در سعیر(@)(@@) 113 عقل آزادم بنگذارد همی چون دیگران %~% از پی نانی به دست فاسقی باشم اسیر(@)(@@) 114 حرص گوید: چون نگردی گرد خمر و قمر و رمز %~% عقل گوید: رو بخوان «قل فیهما اثم کبیر»(@)(@@) 115 اهل دنیا بیشتر همچون کمانند از کژی %~% بد نپنداریدم ار من راست باشم همچو تیر(@)(@@) 116 چون کریمان یک درم ندهندم از روی کرم %~% تا ندارندم دو سال از انتظار اندر زحیر(@)(@@) 117 سرمه بخشش چه سود آنرا که دیده مدح گوی %~% کرده باشد انتظار وعده صلت ضریر(@)(@@) 118 تا ابد هرگز نگشتی محترق از آفتاب %~% گر عطارد یک نفس در صدر تو بودی دبیر(@)(@@) 119 ای بلند اصلی که کم زادست چون تو خاک پست %~% وی جوانبختی که کم دیدست چون تو چرخ پیر(@)(@@) 120 روی زی صدرت نهادم بادل امیدوار %~% پشت چفته چون کمان از بیم تیز زمهریر(@)(@@) 121 چون ترا کردم به دل بر دیگران «نعم البدل» %~% ور بدیشان بازگردم ز ابلهی «بس المصیر» 
ms707	(@)(@@) 122 حاجت از تو خواست باید من چه جویم از خسان %~% در ز دریا جست باید من چه جویم از غدیر(@)(@@) 123 تا همی زاید ازل زو قسم سرت سور باد %~% تا همی پاید ابد زو قسم عمرت نور باد(@)(@@) 124 سیرتت را چون بقای بارنامه صورتست %~% سیرتت را زندگی چون بارنامه صور باد(@)(@@) 125 آب دستت در دماغ یافه‌گویان مشک گشت %~% خاک پایت در مزاج کافران کافور باد(@)(@@) 126 خانه حاسد چو قلب نامت و نام پدرت %~% زیر و بالا باد و در نام محن محصور باد(@)(@@) 127 در دوام بی‌نیازی بر مثال عقل و نفس %~% جسمت از آرامش و جانت ز جنبش دور باد(@)(@@) 128 آنکه آخرتر ز انواع تو با توقیع باد %~% و آنکه سابق‌تر به ابداع تو با منشور باد(@)(@@) 129 نز برای آنکه تو در بند شعر و شاعری %~% از پی تشریف شاعر سعی تو مشکور باد(@)(@@) 130 ای سرور میوه دلهای اهل روزگار %~% طبع من از خلعتت چون جان تو مسرور باد(@)(@@) 131 نقش لفظ جانفزایت گوشوار روح باد %~% گرد صحن حلقه جایت توتیای حور باد(@)(@@) 132 تا به روز عدل دارالحکمة از تاثیر عدل %~% همچو دارالملک انصاف عمر معمور باد(@)(@@) 133 مجلس حکمت ز ناپاکان عالم پاک باد %~% منبر علمت ز مهجوران دین مهجور باد(@)(@@) 134 هر که از دل بر سریر حکم تو بوسه دهد %~% تا ابد چون جان ز ایمان مومن مسرور باد(@)(@@) 135 گر چه نزد دوستان نامت محمد به ولیک %~% بر عدو نام تو چون نام پدر منصور باد(@)(@@) 136 عزمت از نفس ارادی سال و مه مختار باد %~% حزمت از روح طبیعی روز و شب مجبور باد(@)(@@) 137 هفت آبا بهر تایید تو بر چار امهات %~% همچنان کت بود و هست از بعد این مامور باد(@)(@@) 138 همچو خاک و باد و آب و آتشت در هر صفت %~% عمر باد و امر باد و لطف باد و نور 
ms708	 باد(@)(@@) 139 ای بی‌وفا ای پاسبان آشوب کم کن یکزمان %~% چندین چرا داری فغان ای بی‌وفا ای پاسبان(@)(@@) 140 گر خود نخسبی یکزمان ای کافر نامهربان %~% افتاد کار من به جان ای بی‌وفا ای پاسبان(@)(@@) 141 همراه عاشق گشته‌ای با عاشق سرگشته‌ای %~% هم یار دیرین گشته‌ای ای بی‌وفا ای پاسبان(@)(@@) 142 از بانگ های و هوی تو کمتر شدم در کوی تو %~% گشت این تنم چون موی تو ای بی‌وفا ای پاسبان(@)(@@) 143 آرام گیر و کم خروش آخر به خون ما مکوش %~% در خون دل ما را مجوش ای بی‌وفا ای پاسبان(@)(@@) 144 آخر نه من زار توام در درد بسیار توام %~% زار و گرفتار توام ای بی‌وفا ای پاسبان(@)(@@) 145 خاک درت را بنده‌ام دایم ترا جوینده‌ام %~% هستم بدین تا زنده‌ام ای بی‌وفا ای پاسبان(@)(@@) 146 بر ما چنین پستی مکن تندی و بد مستی مکن %~% جور و زبردستی مکن ای بی‌وفا ای پاسبان(@)(@@) 147 زان قد علم نالم همی در خون دل پالم همی %~% از او بدین حالم همی ای بی‌وفا ای پاسبان(@)(@@) 148 از تو سنایی خسته شد درد دلش پیوسته شد %~% بر جان او این بسته شد ای بی‌وفا ای پاسبان(@)(@@) 149 ای سنگدل ای پاسبان کمتر این بانگ و فغان %~% تا خواب مانم یک زمان ای سنگدل ای پاسبان(@)(@@) 150 هر دو خروشانم چو تو گردان و گریانم چو تو %~% با داغ هجرانم چو تو ای سنگدل ای پاسبان(@)(@@) 151 آواز کم کن ساعتی بر چشم ما کن رحمتی %~% بر جان من نه منتی ای سنگدل ای پاسبان(@)(@@) 152 آخر هم آواز توام با داغ دمساز توام %~% آخر نه همراز توام ای سنگدل ای پاسبان(@)(@@) 153 معشوق خود را بنده‌ام در عالمش جوینده‌ام %~% هستم برین تا زنده‌ام ای سنگدل ای پاسبان(@)(@@) 154 از من ستانی رشوتی تا من بباشم ساعتی %~% نزدیک حورا صورتی ای سنگدل ای پاسبان(@)(@@) 155 من روز و شب گریان‌ترم وز 
