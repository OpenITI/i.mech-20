ms1574	 عنه .(@)(@@)(@@)(@@) $ ( 14329 ) قال النبي :(@)(@@) | 30 ( علم القرآن على ثلاثة أجزاء : حلال فاتبعه ، وحرام فاجتنبه ، ومتشائه يشكل عليك فكله إلى عالمه ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14330 ) قال النبي :(@)(@@) | 30 ( علماء هاذه الأمة رجلان : رجل آتاه الله علما فبذله للناس ولم يأخذ عليه طمعا ولم يشر به ثمنا فذالك يستغفر له حيتان البحر ودواب الأرض والطير في جو السماء ، ويقدم على الله سيدا شريفا حتى يرافق المرسلين ورجل آتاه الله علما فبخل به عن عباد الله وأخذ عليه طمعا وشرى به ثمنا فذاك يلجم بلجام من نار يوم القيامة وينادي مناد : هاذا الذي آتاه الله علما فبخل به عن عباد الله وأخذ عليه طمعا واشترى به ثمنا وكذالك حتى يفرغ من الحساب ) )(@)(@@) ( طس ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14331 ) قال النبي :(@)(@@) | 30 ( علم الله تعالى آدم ألف حرفة من الحرف وقال له : قل لولدك وذريتك : إن لم تصبروا فاطلبوا الدنيا ، فهاذه الحرف فلا تطلبوها بالدين فإن الدين لي وحدي خالصا ، ويل لمن طلب الدنيا بالدين ويل له ) )(@)(@@) ( ك ) في تاريخه عن عطية بن بسر المازني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14332 ) قال النبي :(@)(@@) | 30 ( علمهم الشرائع واقض بينهم ، اللهم اهده للقضاء قاله لعلي لما بعثه إلى اليمن ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14333 ) قال النبي :(@)(@@) | 30 ( علمها عند ربي لا يجليها لوقتها إلا هو ، ولاكن سأخبركم بمشاريطها وما يكون بين يديها إن بين يديها فتنة وهرجا ، قالوا : PageV05P200 يا رسول الله ، الفتنة قد عرفناها فالهرج ما هو ؟ قال بلسان الحبشة : القتل ، ويلقى بين الناس التناكر فلا يكاد أحد يعرف أحدا ) )(@)(@@) ( حم ض ) عن حذيفة رضي الله عنه قال : سئل رسول الله عن الناس قال فذكره .(@)(@@)(@@)(@@) $ ( 14334 ) قال النبي :(@)(@@) | 30 ( علام يقتل أحدكم أخاه ؟ ألا بركت ؟ اغتسل به ) )(@)(@@) ( حب ) عن أبي أمامة بن سهل بن حنيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14335 ) قال النبي :(@)(@@) | 30 ( علام يقتل أحدكم أخاه إذا رأى أحدكم من أخيه ما يعجبه فليدع له بالبركة ) )(@)(@@) ( ن ه طب ) عن 
ms1575	 أبي أمامة وسعد بن سهل بن حنيف ( طب ) عنه عن أبيه .(@)(@@)(@@)(@@) $ ( 14336 ) قال النبي :(@)(@@) | 30 ( علام يقتل أحدكم أخاه ؟ ألا بركت عليه ؟ إن العين حق ، توضأ له ، وفي لفظ : اغتسل له ، إذا رأى أحدكم شيئا يعجبه فليبرك ) )(@)(@@) مالك ( ط حم طب ك طب ض ) عن أبي أمامة بن سهل بن حنيف عن أبيه .(@)(@@)(@@)(@@) $ ( 14337 ) قال النبي :(@)(@@) | 30 ( علام يقتل أحدكم أخاه وهو عن قتله غني ؟ إن العين حق ، فمن رأى من أحد شيئا يعجبه أو من ماله فليبرك عليه فإن العين حق ) )(@)(@@) ابن قانع عنه عن أبيه .(@)(@@)(@@)(@@) $ ( 14338 ) قال النبي :(@)(@@) | 30 ( علام تعذبن أولادكن ، إنما تكفي إحداكن أن تأخذ قسطا هنديا فتحكه بماء سبع مرات ثم تؤجره إياه ) )(@)(@@) ( حم ) عن جابر قال : دخل رسول الله على أم سلمة وعندها صبي ينبعث منخاره دما ، قال : ما لهاذا ؟ قالوا : به العذرة قال فذكره .(@)(@@)(@@)(@@) $ ( 14339 ) قال النبي :(@)(@@) | 30 ( علام تذعرن أولادكن بهاذا الإعلاق ، عليكن PageV05P201 بهاذا العود الهندي فإن فيه سبعة أشفية من سبعة أدواء ، منها : ذات الجنب ، يسعط به من العذره ويلد به من ذات الجنب ) )(@)(@@) ( حم خ م د ه حب ) عن أضم قيس بنت محصن قالت : دخلت بابن لي على النبي وقد أعلقت عليه من العذرة قال فذكره وأخرجه عبد الرزاق إلى قوله : شهادت الجنب ، قال الزهري : فيسعط للعذرة ويلد من ذات الجنب وظاهره أن هادا القدر مدرج .(@)(@@)(@@)(@@) $ ( 14340 ) قال النبي :(@)(@@) | 30 ( علام تؤمنون بأيديكم كأنها أذناب خيل شمس ، إنما يكفي أحدكم أن يضع يده على فخذه ثم يسلم على أخيه من على يمينه وشماله ) )(@)(@@) ( م ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14341 ) قال النبي :(@)(@@) | 30 ( على الخير والبركة ، بارك الله لك وبارك عليك ) )(@)(@@) ( كر ) عن عقيل بن أبي طالب أنه تزوج فقيل له بالرفاء والبنين ، قال : لا تقولوا هاكذا ولاكن قولوا كما قال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 14342 ) قال النبي :(@)(@@) | 30 ( على كل مسلم غسل في سبعة أيام في كل جمعة ) )(@)(@@) ( حم ) و عبد بن حميد والطحاوي ( ض ) عن جابر 
ms1576	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14343 ) قال النبي :(@)(@@) | 30 ( على كل مسلم صدقة ، قالوا : يا نبي الله فمن لم يجد ؟ قال : يعتمل بيديه فينفع نفسه ويتصدق ، قالوا : فإن لم يستطع ؟ قال : يعين ذا الحاجة الملهوف ، قالوا : فإن لم يستطع ؟ قال : يأمر بالمعروف أو الخير ، قالوا : أرأيت إن لم يفعل ؟ قال : ليمسك عن الشر فإنها له صدقة ) )(@)(@@) ( حم خ م ن ) عن سعيد بن أبي بردة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 14344 ) قال النبي :(@)(@@) | 30 ( على كل منسم من الإنسان صلاة كل يوم ، فقال PageV05P202 بعض القوم : هاذا شديد يا رسول الله ، قال : إن أمرا بالمعروف ونهيا عن المنكر صلاة ، وإن حملا على الضعيف صلاة ، وكل خطوة يخطوها أحدكم إلى الصلاة صلاة ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14345 ) قال النبي :(@)(@@) | 30 ( على كل منسم من بني آدم صدقة كل يوم ، قيل : ومن يطيق هاذا ؟ قال : أمر بالمعروف ، ونهي عن المنكر صدقة ، والحمل على الضعيف صدقة ، وكل خطوة يخطوها أحدكم إلى الصلاة صدقة ) )(@)(@@) ( حب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14346 ) قال النبي :(@)(@@) | 30 ( على كل أهل بيت من المسلمين أضحاة وعتيرة ) )(@)(@@) ( طب ن ) عن مخنف بن سليم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14347 ) قال النبي :(@)(@@) | 30 ( على صاحبكم دين ، صلوا على صاحبكم ) )(@)(@@) ( طب ) عن أسماء بنت يزيد رضي الله عنها .(@)(@@)(@@)(@@) $ ( 14348 ) قال النبي :(@)(@@) | 30 ( على كل نفس من ابن آدم كتب حظ من الزنا أدرك ذالك لا محالة ، فالعين زناها النظر ، والرجل زناها المشي ، ولأذن زناها الاستماع ، واليد زناها البطش ، واللسان زناه الكلام ، والقلب أن يتمنى ويصدق ذالك أو يكذبه الفرج ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14349 ) قال النبي :(@)(@@) | 30 ( على كل مسلم في كل يوم صدقة ، قالوا : ومن يطيق ذالك يا رسول الله ؟ قال : السلام على المسلم صدقة ، وعيادتك المريض صدقة ، وصلاتك على الجنازة صدقة ، وإماطتك الأذى عن الطريق صدقة ، وعونك الضعيف صدقة ) )(@)(@@) ( حل ) فب تاريخ اصبهان ( خط كر ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14350 ) قال النبي :(@)(@@) | 30 ( على كل ورقة 
ms1577	 من الهندباء حبة من ماء الجنة ) )(@)(@@) ( عد هب ) وضعفه عن جعفر بن محمد عن أبيه مرسلا .(@)(@@) PageV05P203(@)(@@)(@@)(@@) $ ( 14351 ) قال النبي :(@)(@@) | 30 ( على رسلك يا عبد الرحمان أخذ اللواء زيد بن حارثة ، فقاتل زيد حتى قتل رحم الله زيدا ، ثم أخذ اللواء عبد الله بن رواحة فقاتل فقتل رحم الله عبد الله ، ثم أخذ اللواء خالد ففتح الله تعالى بخالد ، فخالد سيف من سيوف الله تعالى ) )(@)(@@) الحكيم عن عبد الرحمان بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14352 ) قال النبي :(@)(@@) | 30 ( عليك بالشام وأهله ، ثم الزم من الشام عسقلان ، فإنها إذا دارت الرحى في أمتي كان أهلها في راحة وعافية ) )(@)(@@) ( كر ) و الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14353 ) قال النبي :(@)(@@) | 30 ( عليك بالتبن فإن رأس ماله يسير ، وربحه كثير ، وعليك بالبر فإن فيه تسعة أعشار البركة ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14354 ) قال النبي :(@)(@@) | 30 ( عليك بالتراب ) )(@)(@@) عبد الرزاق عن أبي هريرة أن أعرابيا قال : يا رسول الله إني أكون في الرمل أربعة أشهر أو خمسة ، فيكون فينا النفساء أو الحائض أو الجنب فما ترى ؟ قال فذكره .(@)(@@)(@@)(@@) $ ( 14355 ) قال النبي :(@)(@@) | 30 ( عليك وعلى أبيك السلام ) )(@)(@@) ( حم ) و ابن السني في عمل يوم وليلة عن رجل من بني نمير عن أبيه عن جده أنه أتى النبي فقال : أن أبي يقرأ عليك السلام قال فذكره .(@)(@@)(@@)(@@) $ ( 14356 ) قال النبي :(@)(@@) | 30 ( عليك بالحال المرتحل صاحب القرآن يضرب في أوله حتى يبلغ آخره ، ويضرب في آخره حتى يبلغ أوله ، كلما حال ارتحل ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14357 ) قال النبي :(@)(@@) | 30 ( عليك بقراءة القرآن ) )(@)(@@) ( هب ) عن واثلة أن رجلا شكى إلى رسول الله وجعا في حلقه قال فذكره .(@)(@@) PageV05P204(@)(@@)(@@)(@@) $ ( 14358 ) قال النبي :(@)(@@) | 30 ( عليك بتلاوة القرآن وذكر الله عز وجل فإنه ذكر لك في السماء ونور لك في الأرض ، وعليك بطول الصمت فإنه مطردة للشياطين وعون لك على أمر دينك ، وقل الحق وإن كان مرا ) )(@)(@@) ابن لال عن أبي ذر ، أبو الشيخ عن أبي 
ms1578	 سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14359 ) قال النبي :(@)(@@) | 30 ( عليك بالسمع والطاعة في عسرك ويسرك ، ومنشطك ومكرهك وآثره عليك ولا تنازع الأمر أهله ، وإن رأيت أن لك إلا أن يأمروك بإثم بواحا عندك تأويله في الكتاب ) )(@)(@@) ( طب ) و الروياني ( كر ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14360 ) قال النبي :(@)(@@) | 30 ( عليك بالصعيد فإنه يكفيك ) )(@)(@@) ( ش خ م ن ) عن عمران بن حصين رضي الله عنه أن رجلا قال : يا رسول الله أصابتني جنابة ولا ماء ؟ قال : فذكره .(@)(@@)(@@)(@@) $ 14361 قال النبي :(@)(@@) | 30 ( عليك بالشام ، هل تدرون ما يقول الله ؟ يقول الله : يا شام يدي عليك ، يا شام أنت صفوتي من بلادي ، أدخل فيك خيرتي من عبادي ، أنت سيف نقمتي وسوط عذابي ، أنت الأندر وإليك المحشر ، ورأيت ليلة أسري بي عمودا أبيض كأنه لؤلؤة تحمله الملائكة ، قلت : ما تحملون ؟ قالوا : عمود الإسلام أمرنا أن نضعه بالشام ، وبين أنا نائم رأيت كتابا اختلس من تحت وسادتي فظننت أن الله تخلى عن أهل الأرض ، فأتبعت بصري فإذا هو نور ساطع بين يدي حتى وضع بالشام ، فمن أبى أن يلحق بالشام فليلحق بيمنه ، وليستق من غدره ، فإن الله قد تكفل لي بالشام وأهله ) )(@)(@@) ( طب كر ) عن عبد الله بن حوالة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14362 ) قال النبي :(@)(@@) | 30 ( عليك ببيت المقدس فلعله أو ينشو لك ذرية يغدون إلى ذالك المسجد ويروحون ) )(@)(@@) ( عم طب ) و البغوي والبارودي وابن قانع وسمويه وابن شاهين PageV05P205 ( حل ) عن ذي الأصابع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14363 ) قال النبي :(@)(@@) | 30 ( عليك بتقوى الله ، وإذا قمت من عند القوم فسمعتهم يقولون لك ما يعجبك فائته ، وإذا سمعتهم يقولون لك ما تكره فاتركه ) )(@)(@@) ابن سعد عن ضرغامة بن عليبة بن حرملة عن أبيه جده .(@)(@@)(@@)(@@) $ ( 14364 ) قال النبي :(@)(@@) | 30 ( عليك بالصوم فإنه لا عدل له ) )(@)(@@) ( حب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14365 ) قال النبي :(@)(@@) | 30 ( عليك يا ابن مظعون بالصيام فإنه مجفرة ) )(@)(@@) ( طب هب ) عن عائشة بنت قدامة بن مظعون عن أبيها عن أخيه عثمان بن 
ms1579	 مظعون رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14366 ) قال النبي :(@)(@@) | 30 ( عليك بالسابعة ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما قال : يا نبي الله إني شيخ كبير عليل يشق علي القيام فمرني بليلة لعل الله تعالى يوفقني فيها لليلة القدر قال فذكره .(@)(@@)(@@)(@@) $ ( 14367 ) قال النبي :(@)(@@) | 30 ( عليك بالرفق والعفو في غير ترك الحق ، يقول الجاهل : قد ترك من حق الله ، وأمت أمر الجاهلية إلا ما حسنه الإسلام ، وليكن أكبر همك الصلاة فإنها رأس الإسلام بعددالإقرار بالله عز وجل ) )(@)(@@) ابن لال عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14368 ) قال النبي :(@)(@@) | 30 ( عليكم بحصى الخذف الذي يرمى به الجمرة ) )(@)(@@) ( حم م حب ن ) عن الفضل بن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14369 ) قال النبي :(@)(@@) | 30 ( عليكم بالأبكار فإنهن أعذب أفواها ، وأنتق PageV05P206 أرحاما ، وأرضى باليسير ) )(@)(@@) ( ه طب حل ) في الطب ( هق ) عن عبد الرحمان بن سالم بن عويم بن ساعدة عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 14370 ) قال النبي :(@)(@@) | 30 ( عليكم بكتاب الله وسترجعون إلى قوم يحبون الحديث عني ، ومن قال علي ما لم أقل فليتبوأ مقعده من النار ، فمن حفظ شيئا فليحدث به ) )(@)(@@) ابن الضريس عن عقبة بن عامر ( حم ك ) عن أبي موسى الغافقي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 14371 ) قال النبي :(@)(@@) | 30 ( عليكم بالقرآن فإنكم سترجعون إلى قوم يشتهون الحديث عني ، فمن عقل شيئا فليحدث به ، ومن افترى علي فليتبوأ مقعدا وبيتا من جهنم ) )(@)(@@) ( حم ك ) عن مالك بن عبد الله الغافقي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14372 ) قال النبي :(@)(@@) | 30 ( عليكم بالقرآن فإنه كلام رب العالمين هو منه ، فآمنوا بمتشابهه ، واعتبروا بأمثاله ) )(@)(@@) الديلمي عن جابر رضي الله عنه وفيه الكريمي .(@)(@@)(@@)(@@) $ ( 14373 ) قال النبي :(@)(@@) | 30 ( عليكم بالأسود منه يعني الكباث فإنه أطيبه ، فإني كنت أجنيه ، أو كنت أرعى الغنم قالوا : وكنت ترعى الغنم ؟ قال : نعم ، وهل من نبي إلا وقد رعاها ) )(@)(@@) ( حم خ م ) و ابن سعد عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14374 ) قال النبي :(@)(@@) | 30 ( عليكم بالدلجة فإن الأرض تطوى بالليل ، فإذا تغولت لكم الغيلان فنادوا بالأذان ) )(@)(@@) ( ش ) عن جابر 
ms1580	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14375 ) قال النبي :(@)(@@) | 30 ( عليكم بالنسلان ) )(@)(@@) ( ن ع ) وابن خزينة ( حب PageV05P207 ك حل ) في الطب ( هق ض ) عن جابر شكى ناس إلى رسول الله المشي قال فذكره .(@)(@@)(@@)(@@) $ ( 14376 ) قال النبي :(@)(@@) | 30 ( عليكم بالأسود البهيم ذي النقطتين فإنه شيطان ) )(@)(@@) ( م حب ) عن جابر قال : نهى النبي عن قتل الكلاب وقال فذكره .(@)(@@)(@@)(@@) $ ( 14377 ) قال النبي :(@)(@@) | 30 ( عليكم بالصدق فإنه يهدي إلى البر وهما في الجنة ، وإياكم والكذب فإنه يهدي إلى الفجور وهما في النار ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14378 ) قال النبي :(@)(@@) | 30 ( عليكم بالجهاد في سبيل الله فإنه باب من أبواب الجنة ، يذهب الله به الهم والغم ، وجاهدوا في سبيل الله القريب والبعيد ، وأقيموا حدود الله في القريب والبعيد ، ولا تأخذكم في الله لومة لائم ) )(@)(@@) ( ك هق ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14379 ) قال النبي :(@)(@@) | 30 ( عليكم أيها الناس من الأعمال ما تطيقون ، فإن الله لا يمل حتى تملوا ، وإن أحب الأعمال إلى الله أدومها وإن قل ) )(@)(@@) محمد بن نصر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14380 ) قال النبي :(@)(@@) | 30 ( عليكم بالسمع والطاعة فيما أحببتم وكرهتم ، في منشطكم ومكرهكم وأثرة عليكم ، ولا تنازعوا الأمر أهله ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 14381 ) قال النبي :(@)(@@) | 30 ( عليكم عقد ، فإذا وضأ يده انحلت عقدة ، وإذا وضأ وجهه انحلت عقدة ، وإذا مسح برأسه انحلت عقدة ، وإذا وضأ رجليه انحلت عقدة ، فيقول الله للذي وراء الحجاب : انظروا إلى عبدي هاذا يعالج نفسه يسألني ما سألني عبدي فهو له ) )(@)(@@) ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@) PageV05P208(@)(@@)(@@)(@@) $ ( 14382 ) قال النبي :(@)(@@) | 30 ( عليكم بالشام ) )(@)(@@) ( طب ) عن بهز بن حكيم عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 14383 ) قال النبي :(@)(@@) | 30 ( عليكم منازلكم فإنها تكتب آثاركم ) )(@)(@@) ( عب ) عن أبي سعيد قال : شكت بنو سلمة إلى رسول الله بعد منازلهم من المسجد ، فأنزل الله : { سنكتب ما قدموا وآثارهم } قال : فذكره .(@)(@@)(@@)(@@) $ ( 14384 ) قال النبي :(@)(@@) | 30 ( عليكم بالعدس فإنه قدس على لسان سبعين نبيا ) )(@)(@@) أبو نعيم 