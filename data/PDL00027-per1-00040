ms28	 همی گردی بحلقه(@)(@@) 87 زهی حالت نگر از عشق پیوست %~% که تا روز قیامت گردشت هست(@)(@@) 88 کمال عشق را شایسته تو %~% شدن زین بند نتوانسته تو(@)(@@) 89 چو ما این بند مشکل برگشاییم %~% بر قاضی بدرگاه تو آییم(@)(@@) 90 بقوال افکنیم این خرقه خویش %~% نگین گردیم اندر حلقه خویش(@)(@@) 91 ورای بحر تو غواص گردیم %~% توعامی باشی و ما خاص گردیم(@)(@@) 92 وز آنجا هم بسوی فوق تازیم %~% گهی زان شوق و گه زان ذوق تازیم(@)(@@) 93 در آن دریا بغواصی درآییم %~% وز آن شادی برقاصی درآییم(@)(@@) 94 همی آییم دم دم همچو اکنون %~% بهر پرده چو مار از پوست بیرون(@)(@@) 95 ترا گر فسحتی باید ز عقبی %~% تفکر کن دمی در سر دنیا(@)(@@) 96 نه در دنیا در اول خون بدی تو %~% در آخر بین که زینجا چون شدی تو(@)(@@) 97 گهی آب و گهی خون و گهی شیر %~% گهی کودک گهی برنا گهی پیر(@)(@@) 98 گهی سلطان دین گه پیر خمار %~% گهی مردار می گه پیر اسرار(@)(@@) 99 هزاران پرده در دنیا گذشتی %~% که تا از صورت و معنی بگشتی(@)(@@) 100 دران وادی که آنرا عشق نامست %~% مثالت پرده دنیا تمامست(@)(@@) 101 که داند کین چه اسرار نهانست %~% سخن نیست این که نور عقل جانست(@)(@@) 102 اگر چشم دلت گردد بدین باز %~% برون گیرد ز یک یک ذره صدراز(@)(@@) 103 همه ذرات عالم را درین کوی %~% نه بیند یک نفس جز در روش روی(@)(@@) 104 همه در گردش‌اند و در روش هست %~% تو بی چشمی و در تو این روش هست(@)(@@) 105 الا ای بی‌خبر از عشق بازی %~% تو پنداری که هست این عشق بازی(@)(@@) 106 تراچون نیست نقدی درخوردوست %~% که آن را رونقی باشد بر دوست(@)(@@) 107 ازو می‌خواه تا دریا بباشی %~% هم اندر خویش نابینا بباشی(@)(@@) 108 دلت در عشق بحری کن پر اسرار %~% همه قعرش جواهر موجش انوار(@)(@@) 109 که تا چون رفتی آن 
ms29	 بحر معانی %~% براه آورد بر راهش فشانی(@)(@@) 110 چنین دریا کن آن ره را نثاری %~% که تا نبود در این راهت غباری(@)(@@) 111 اگر جانت نثار راه او شد %~% دو عالم در نثار تو فرو شد PageV05P001(@)(@@) 1 ز کویی زی نظام آورد آن پیر %~% که پر زر کن مکن زنهار تقصیر(@)(@@) 2 نظامش گفت این رکوه بزرگست %~% که در من می‌افتد کویی که گرگست(@)(@@) 3 ندارد گفت سودت پر زرش کن %~% مکن نیمه ولیکن تا سرش کن(@)(@@) 4 گشادند آن دم از درجی یکی در %~% که تادر رکوه کردند اندکی زر(@)(@@) 5 نه آن رکوه تهی بستد نه شد دور %~% سته در دست او درمانده دستور(@)(@@) 6 بده بار دگر زر کرد بیشش %~% چو رکوه پر نبد می‌بود پیشش(@)(@@) 7 بآخر رکوه پر زر کرد او را %~% ز پیش خود فراتر کرد او را(@)(@@) 8 چو صوفی زرستد درحالت افتاد %~% بنزدیک نظام آمد باستاد(@)(@@) 9 نثارش کرد بر سر رکوه زر %~% چو شد رکوه تهی افکند بر در(@)(@@) 10 بدو گفتا نشستم روزگاری %~% که تا فرق ترا آرم نثاری(@)(@@) 11 چو اندر خورد تو چیزی ندیدم %~% ز تو بر تو فشاندم وارهیدم(@)(@@) 12 ز تو زر هم برای تو پذیرم %~% ز تو گیرم زر و بر تونگیرم(@)(@@) 13 عزیزا چون تو نقد آن نداری %~% که سلطان را نثاری درخورآری(@)(@@) 14 ز حق می‌خواه جانت را معانی %~% که تا هرچت دهد بروی فشانی(@)(@@) 15 چه دولت بیش از آن دانی گدا را %~% که جانی برفشاند پادشا را(@)(@@) 16 منم در عشق سرگردان بمانده %~% ز خود بی خود شده حیران بمانده(@)(@@) 17 میان خواب و بیداریم حالیست %~% که جانم را در آن حد کمالیست(@)(@@) 18 اگر آن دم نبودی حاصل من %~% تهی کردی از آن دم دم دل من(@)(@@) 19 دلم را از جهان لذت جز آن نیست %~% چه می‌گویم که آن دم از جهان نیست(@)(@@) 20 کسی کو نیست عاشق آدمی 
