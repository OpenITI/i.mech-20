ms3661	 حدثنا يعقوب بن عبد الرحمن عن أبي حازم أنه رأى سهل بن سعد توضأ ومسح على الخفين فقلت : ألا تنزع خفيك ؟ قال : لا قد رأيت خيرا مني ومنك ويمسح عليهما .(@)(@@) 27660 - { من مسند عبادة بن الصامت } عن أبي العسر الرازي عن أبيه قال : رأيت رسول الله صلى الله عليه وسلم بال وتوضأ ومسح على خفيه .(@)(@@) % ( كر ) .(@)(@@) 27661 - عن سليمان بن زياد الحضرمي أنه سمع عبد الله بن الحارث الزبيدي صاحب رسول الله صلى الله عليه وسلم يمسح على الخفين .(@)(@@) % ( ص ) .(@)(@@) 27662 - عن خالد بن سعد وهمام بن الحارث قالا : كان أبو مسعود الأنصاري يمسح على الجوربين والنعلين .(@)(@@) % ( عب ، ص ) .(@)(@@) 27663 - عن عياض بن نضلة قال : جلست أتطهر فأتى علي أبو موسى وأنا أريد أن أخلع خفي فقال : أقرهما وامسح عليهما .(@)(@@) % ( ص ) .(@)(@@) 27664 - عن أبي هريرة أن النبي صلى الله عليه وسلم مسح على الخفين .(@)(@@) % ( ش ) .(@)(@@) 27665 - عن عطاء بن يسار عن عبد الله بن رواحة وأسامة بن زيد أن رسول الله صلى الله عليه وسلم دخل دار حمل هو وبلال فخرج إليهما بلال فأخبرهما أن رسول الله صلى الله عليه وسلم توضأ ومسح على الموقين ( الموقين : الموق : الخف ، فارسي معرب . انتهى . النهاية 4 / 372 . ب ) .(@)(@@) % ( كر ) .(@)(@@) 27666 - عن أبي صهبان قال : رأيت عليا بال قائما حتى أرغى ثم توضأ ومسح على نعليه ، ثم دخل المسجد فخلع نعليه وجعلهما في كمه ، ثم صلى قال معمر : فأخبرني زيد بن أسلم عن عطاء بن يسار عن ابن عباس عن النبي صلى الله عليه وسلم بمثل صنيع علي هذا .(@)(@@) % ( عب ) .(@)(@@) 27667 - عن ابن عباس في المسح على الخفين قال : ثلاثة أيام ولياليهن للمسافر ويوم وليلة للمقيم .(@)(@@) % ( عب ، ش ، ص ) .(@)(@@) PageV09P267(@)(@@) 27668 - عن موسى بن سلمة الهذلي قال : سألت ابن عباس عن الخفين فقال : ثلاثة أيام ولياليهن للمسافر ، ويوم وليلة للمقيم .(@)(@@) % ( د ) .(@)(@@) 27669 - عن عطاء عن ابن عباس مثله .(@)(@@) % ( ابن جرير ) .(@)(@@) 27670 - عن مقسم قال : قال ابن عباس لسعد بن أبي وقاص : قد علمنا أن رسول 
ms3662	 الله صلى الله عليه وسلم قد مسح قبل المائدة فهل مسح بعد المائدة فسكت سعد .(@)(@@) % ( ابن جرير ) .(@)(@@) 27671 - عن عطاء قال : كان ابن عباس يقول : امسح على الخفين وإن دخلت الخلاء .(@)(@@) % ( ابن جرير ) .(@)(@@) 27672 - عن طاوس عن ابن عباس قال : امسح إذا أدخلت رجليك وهما طاهرتان .(@)(@@) % ( ابن جرير ) .(@)(@@) 27673 - عن محمد بن سعد وكان يتوضأ بالراوية فخرج علينا ذات يوم من البراز فتوضأ ومسح على خفيه فتعجبنا وقلنا : يا هذا فقال : حدثني أبو أمامة أنه رأى رسول الله صلى الله عليه وسلم فعل ما فعلت .(@)(@@) % ( ش ) .(@)(@@) 27674 - عن يحيى بن إسحاق أنه سمع أنس بن مالك سئل عن المسح على الخفين ؟ فقال : امسح عليهما فقالوا : أسمعته من النبي صلى الله عليه وسلم ؟ قال : لا ولكن سمعته ممن لم يتهم من أصحابنا .(@)(@@) % ( ش ) .(@)(@@) 27675 - { مسند أسامة بن زيد } أن النبي صلى الله عليه وسلم مسح على الخفين .(@)(@@) % ( طب ) .(@)(@@) 27676 - { مسند أنس } عن سعيد بن عبد الله بن ضرار قال : رأيت أنس بن مالك أتى الخلاء ، ثم خرج وعليه قلنسوة بيضاء مزرورة فمسح على القلنسوة وعلى جوربين له من عزا ( الحديث عند البيهقي كتاب الطهارة ( 1 / 285 ) . وعزا من مرعزين بكسر أوله وتشديد ثانيه والقضر : كفر عزا ناحية من أعمال الموصل . معجم البلدان 6 / 165 . ص ) أسودين ، ثم صلى .(@)(@@) % ( عب ) .(@)(@@) 27677 - { أيضا } عن عاصم قال : رأيت أنس بن مالك بال ثم قام فتوضأ ومسح على خفيه وعلى عمامته فصلى صلاة مكتوبة .(@)(@@) % ( عب ) .(@)(@@) 27678 - { أيضا } عن مورق أن أنس بن مالك سئل عن الذي يخلع خفيه لا يمسح عليهما ؟ قال : ذاك التكلف .(@)(@@) % ( ابن جرير ) .(@)(@@) 27679 - { أيضا } عن يحيى بن أبي إسحاق : سمعت أنس بن مالك يقول : كنا نمسح على أخفافنا فقال له رجل : أسمعته من النبي صلى الله عليه وسلم ؟ قال : لا ولكن ممن لا يتهم من أصحابنا .(@)(@@) % ( ص وابن جرير ) .(@)(@@) 27680 - { مسند علي } أمرني رسول الله صلى الله عليه وسلم بالمسح على الخفين .(@)(@@) % ( قط ) .(@)(@@) 27681 - عن أبي العسر الدارمي قال : رأيت أبي 
ms3663	 بال وتوضأ ومسح على خفيه فقلت له في ذلك : فقال : رأيت رسول الله صلى الله عليه وسلم بال وتوضأ ومسح على خفيه .(@)(@@) % ( كر ) .(@)(@@) PageV09P268(@)(@@) 27682 - عن ابن عباس في المسح على الخفين قال : مرة واحدة .(@)(@@) % ( ص ) .(@)(@@) 27683 - { مسند عبد الله بن عمر } أن رسول الله صلى الله عليه وسلم أمر بالمسح على الخفين يوما وليلة في الحضر ، وللمسافر ثلاثا .(@)(@@) % ( الخطيب في المتفق والمفترق ) .(@)(@@) 27684 - عن إبراهيم قال : من ترك المسح فقد رغب عن السنة ولا أعلمه إلا من الشيطان .(@)(@@) % ( ابن جرير ) .(@)(@@) 27685 - عن إبراهيم قال : من ترك المسح كان ذلك من الشيطان وقد رغب عن السنة .(@)(@@) % ( ص ) .(@)(@@) 27686 - عن إبراهيم قال : من رغب عن المسح فقد رغب عن السنة ، وإني لأعلم ذلك من الشيطان .(@)(@@) % ( ص ) .(@)(@@) 27687 - عن الحسن قال : المسح على الخفين خطوطا بالأصابع .(@)(@@) % ( ص ) .(@)(@@) 27688 - عن الحسن أنه سئل عن المسح على الخفين أفضل أو غسل القدمين ؟ فقال : الغسل في كتاب الله ، والمسح في سنة رسول الله صلى الله عليه وسلم .(@)(@@) % ( ص ) .(@)(@@) 27689 - عن إبراهيم أن ابن مسعود كان يمسح على خفيه ويمسح على جوربيه .(@)(@@) % ( عب ) .(@)(@@) 27690 - عن الحارث بن سويد وأبي وائل عن عبد الله بن مسعود قال : ثلاثة أيام للمسافر يمسح على الخفين ويوم للمقيم .(@)(@@) % ( عب ) .(@)(@@) 27691 - عن ابن مسعود أنه كان يقول في المسح على الخفين : ثلاثة أيام ولياليهن للمسافر ، ويوم وليلة للمقيم .(@)(@@) % ( ص ) .(@)(@@) 27692 - عن قيس رجل من الموالي قال : سمعت منادي علي بن أبي طالب ينادي ياأيها الناس إن الكتاب قد سبق ؛ المسح على الخفين ثلاث مرات .(@)(@@) % ( ابن جرير ) .(@)(@@) 27693 - عن رجل أنه سمع عليا يخطب على المنبر قال : سبق الكتاب الخفين .(@)(@@) % ( ابن جرير ) .(@)(@@) 27694 - { مسند علي } حدثنا عبد الملك بن سلع الهمداني قال : رأيت عبد خير يمسح على الخفين فسألته عن ذلك فقال : رأيت من هو خير مني يمسح على الخفين يعني علي بن أبي طالب .(@)(@@) % ( أبو عروبة الحراني في مسند القاضي أبي يوسف ) .(@)(@@) 27695 - { أيضا } عن عبد خير قال : رأيت عليا وهو يعرض 
ms3664	 أهل السجون بال ، ثم توضأ ومسح على جوربيه .(@)(@@) % ( ص ) .(@)(@@) 27696 - { مسند ابن عوف } عن الزهري عن أبي سلمة عن أبيه قال : مسح النبي صلى الله عليه وسلم على الخفين .(@)(@@) % ( كر ) .(@)(@@) PageV09P269(@)(@@) | 1 ( طهارة المعذور ) 1(@)(@@) 27697 - { مسند علي } قال : انكسر إحدى زندي فسألت رسول الله صلى الله عليه وسلم فأمرني أن أمسح على الجبائر .(@)(@@) % ( عب وابن السني وأبو نعيم معا في الطب وسنده حسن ) .(@)(@@) 27698 - عن علي قال : أصابني جرح في يدي فعصبت عليه الجبائر فأتيت النبي صلى الله عليه وسلم فقلت : أمسح عليها أو أنزعها ؟ قال : بل امسح عليها .(@)(@@) % ( ابن السني ) .(@)(@@) 27699 - عن المسور بن مخرمة أنه دخل على عمر حين طعن فقال الصلاة فقال عمر : نعم إنه لا حظ في الإسلام لمن ترك الصلاة ، فصلى عمر وجرحه ينفث دما .(@)(@@) % ( مالك ، عب وابن سعد ، ش ، حم في الزهد ورسته في الإيمان ، طس ) .(@)(@@) 27700 - عن عبد الله بن دارة أن عثمان كان قد سلس بوله فداواه ثم أرسله فكان يتوضأ لكل صلاة .(@)(@@) % ( ابن سعد ) .(@)(@@) 27701 - عن خارجة بن زيد قال : كبر زيد حتى سلس منه البول فكان يداويه ما استطاع فإذا غلبه توضأ وصلى .(@)(@@) % ( عب ) .(@)(@@) 27702 - عن ابن عمر قال : إذا كان الجرح معصوبا فامسح حول العصابة .(@)(@@) % ( عب ) .(@)(@@) | 1 ( فصل في الحيض والنفاس والاستحاضة ) 1(@)(@@)(@)(@@) | 1 ( الحيض ) 1(@)(@@) 27703 - عن الحسن قال : سئل عمر بن الخطاب عن المرأة الحائض تناول الرجل وضوءا فتدخل يدها فيه ؟ قال : إن حيضتها ليست في يدها .(@)(@@) % ( عب ) .(@)(@@) 27704 - عن عمر قال : سألت النبي صلى الله عليه وسلم عن مواكلة الحائض فقال : واكلها .(@)(@@) % ( حل ) .(@)(@@) 27705 - عن إبراهيم عن عمر بن الخطاب وابن مسعود أنهما قالا في الحائض إذا انقطع دمها هي حائض ما لم تغتسل .(@)(@@) % ( ابن الضياء في مسند أبي حنيفة ، قط ) .(@)(@@) 27706 - عن عمر قال : قال رسول الله صلى الله عليه وسلم أخبرني حبيبي جبريل أن الله بعثه إلى أمنا حواء حين دميت فنادت ربها : جاء مني دم لا أعرفه فناداها لأدمينك وذريتك ولأجعلنه كفارة وطهورا 
ms3665	 .(@)(@@) % ( قط في الأفراد والديلمي ) .(@)(@@) 27707 - عن أبي الجوزاء قال : كان عمر ينهى النساء أن ينمن عند العشاء أو عن العشاء مخافة الحيض .(@)(@@) % ( ص ) .(@)(@@) 27708 - عن محمد بن سيرين قال : نبئت أن النبي صلى الله عليه وسلم كانت ترجله الحائض ويقول : إن حيضتها ليست في يدها .(@)(@@) % ( ش ) .(@)(@@) PageV09P270(@)(@@) 27709 - { مسند عائشة رضي الله عنها } عن معاذة العدوية قالت : سألت عائشة فقلت : ما بال الحائض تقضي الصوم ولا تقضي الصلاة ؟ قالت : كان يصيبنا ذلك مع رسول الله صلى الله عليه وسلم فنؤمر بقضاء الصوم ولا نؤمر بقضاء الصلاة .(@)(@@) % ( عب ، ص ) .(@)(@@) 27710 - { أيضا } كنا عند رسول الله صلى الله عليه وسلم فلم يأمر امرأة منا أن تقضي الصلاة .(@)(@@) % ( عب ) .(@)(@@) 27711 - عن ابن عباس قال : إذا طهرت الحائض بعد العصر صلت الظهر والعصر ، وإذا طهرت بعد العشاء صلت المغرب والعشاء .(@)(@@) % ( ض ) .(@)(@@) 27712 - عن عائشة أنها كانت إذا جاءها النساء فسألتها عن الحيضة تقول : ويلكن لا تصلين حتى ترين القصة ( القصة : هو أن تخرج القطنة أو الخرقة التي تحتشى بها الحائض كأنها قصة بيضاء لا يخالطها صفرة . انتهى . النهاية 4 / 71 . ب ) البيضاء .(@)(@@) % ( ص ) .(@)(@@) 27713 - عن عائشة قالت : كان رسول الله صلى الله عليه وسلم يأمر إحدانا إذا كانت حائضا أن تأزر ( تأزر : وفي الحديث ( كان يباشر بعض نسائه وهي مؤتزرة في حالة الحيض ) أي مشدودة الإزار . انتهى . النهاية 1 / 44 . ب ) ثم يباشرها .(@)(@@) % ( ص ) .(@)(@@) 27714 - عن عائشة أنها كانت تنام مع النبي صلى الله عليه وسلم في لحاف وهي حائض .(@)(@@) % ( ص ) .(@)(@@) 27715 - عن عائشة أنها سئلت ما يحل للرجل من امرأته وهي حائض ؟ قالت : ليعتزل الرجل امرأته عن فور ( فور : فور كل شيء : أوله . انتهى . النهاية 3 / 478 . ب ) المحيض ، فإذا سكن فوره فليجعل بينه وبينها إزارا .(@)(@@) % ( ص ) .(@)(@@) 27716 - عن علقمة بن أبي علقمة قال : أخبرتني أمي أن نسوة سألت عائشة عن الحائض تغتسل إذا رأت الصفرة وتصلي ؟ فقالت عائشة : لا حتى ترى القصة البيضاء .(@)(@@) % ( عب ) .(@)(@@) 27717 - عن عائشة أنها كانت تأمر النساء إذا طهرن 
ms3666	 من الحيض أن يتبعن أثر الدم بالصفرة يعني بالخلوق أو بالذريرة الصفراء .(@)(@@) % ( عب ) .(@)(@@) 27718 - عن عائشة قالت : إذا رأت الحامل الصفرة توضأت وصلت ، وإذا رأت الدم اغتسلت فصلت ولا تدع الصلاة على كل حال .(@)(@@) % ( عب ) .(@)(@@) 27719 - عن عائشة قالت : ليباشر الرجل امرأته إذا كانت حائضا تجعل على سفلتها ثوبا .(@)(@@) % ( عب ) .(@)(@@) 27720 - عن نافع أن ابن عمر أرسل إلى عائشة يستفتيها في الحائض أيباشرها ؟ فقالت عائشة : نعم يجعل على سفلتها ثوبا .(@)(@@) % ( عب ) .(@)(@@) 27721 - عن مسروق قال : دخلت على عائشة فقلت : يا أم المؤمنين ما يحل للرجل من امرأته حائضا ؟ قالت : ما دون الفرج ، قلت : فما يحل لي منها صائما ؟ قالت : كل شيء إلا الجماع .(@)(@@) % ( عب ) .(@)(@@) PageV09P271(@)(@@) 27722 - عن واصل مولى ابن عيينة عن رجل سأل ابن عمر عن امرأة تطاول بها دم الحيضة ، فأرادت أن تشرب دواء يقطع الدم عنها ؟ فلم ير ابن عمر به بأسا ونعت ابن عمر ماء الأراك .(@)(@@) % ( عب ) .(@)(@@) 27723 - { مسند أم عطية } قالت : كنا لا نرى الصفرة والكدرة شيئا .(@)(@@) % ( عب ، ص ) .(@)(@@) 27724 - عن أم عطية قالت : كنا لا نرى التربة شيئا .(@)(@@) % ( ش ) .(@)(@@) 27725 - عن إبراهيم قال : كان أزواج النبي صلى الله عليه وسلم وبناته إذا حضن لم يأمرهن بقضاء الصلاة كما يأمرهن بقضاء الصيام .(@)(@@) % ( ص ) .(@)(@@) 27726 - عن إبراهيم قال : كن أزواج النبي صلى الله عليه وسلم وبناته ونساء المؤمنين لا يعدن الصلاة أيام حيضهن .(@)(@@) % ( ص ) .(@)(@@) 27727 - عن سعيد بن جبير قال : الحائض لا تقرأ من القرآن شيئا ولكن تذكر الله متى شاءت .(@)(@@) % ( ص ) .(@)(@@) 27728 - عن ابن مسعود قال : الحائض تضع في المسجد الشيء ونأخذه منه .(@)(@@) % ( عب ، ص ) .(@)(@@) 27729 - حدثنا هشيم أنبأنا ليث عن عطاء وطاوس أنهما قالا : إذا طهرت المرأة من الدم وأدرك الرجل الشبق ( الشبق : بالتحريك شدة الغلمة وطلب النكاح . انتهى . النهاية 2 / 441 . ب ) فليأمرها أن تتوضأ ، ثم يصيب منها إن شاء .(@)(@@) % ( ص ) .(@)(@@) 27730 - حدثنا عبد العزيز عن صفوان بن سليم عن عطاء بن يسار قال : قال رجل : يا رسول الله ما يحل لي من امرأتي 
ms3667	 وهي حائض ؟ قال : تشد إزارها ، ثم شأنك بما علاها ( الحديث هنا خال من العزو فأقول : أورده الهيثمي في مجمع الزوائد 2 / 281 وقال رواه الطبراني في الكبير وفيه أبو نعيم ضرار بن صرد ضعيف ) .(@)(@@) 27731 - حدثنا يعقوب بن عبد الرحمن وعبد العزيز بن محمد عن زيد ابن أسلم أن رسول الله صلى الله عليه وسلم قال ذلك .(@)(@@) 27732 - عن عبد الرحمن بن عوف قال : إذا طهرت المرأة قبل غروب الشمس صلت صلاة النهار كلها ، وإذا طهرت قبل طلوع الفجر صلت صلاة الليل كلها .(@)(@@) % ( عب ، ص ) .(@)(@@) | 1 ( تتمة الحيض ) 1(@)(@@) 27733 - عن علي قال : إذا رأت المرأة بعد الطهر ما يريبها مثل غسالة اللحم أو مثل غسالة السمك أو مثل قطرة الدم قبل الرعاف فإن تلك ركضة من ركضات الشيطان في الرحم ؛ فلتنضح بالماء ولتتوضأ ولتصل ؛ فإن كان دما عبيطا لا خفاء به فلتدع الصلاة .(@)(@@) % ( عب ) .(@)(@@) PageV09P272(@)(@@) 27734 - عن أنس قال : يا رسول الله الحائض تقرب إلي الوضوء في الإناء تدخل يدها فيه ؟ قال : نعم لا بأس ليس حيضها في يدها .(@)(@@) % ( كر وفيه عمر بن أبي عمر الدمشقي الكلاعي منكر الحديث عن الثقات ما روى عنه إلا بقية ) .(@)(@@) | 1 ( النفاس ) 1(@)(@@) 27735 - عن أنس قال : تنتظر البكر إذا ولدت ويتطاول بها الدم أربعين ليلة ثم تغتسل .(@)(@@) % ( عب ) .(@)(@@) 27736 - عن عمر قال : تنتظر النفساء أربعين ليلة ثم تغتسل .(@)(@@) % ( عب ، قط ) .(@)(@@) 27737 - عن أم سلمة قالت : كانت النفساء تجلس على عهد رسول الله صلى الله عليه وسلم أربعين يوما وكنا نطلي وجوهنا بالورس من الكلف .(@)(@@) % ( كر ) .(@)(@@) 27738 - عن عثمان بن أبي العاص قال : وقت للنفساء أربعون يوما .(@)(@@) % ( ص ) .(@)(@@) 27739 - عن عثمان بن أبي العاص أنه كان يقول للمرأة من نسائه إذا نفست : لا تقربيني أربعين ليلة .(@)(@@) % ( عب ) . الاستحاضة(@)(@@) 27740 - عن علي قال : المستحاضة إذا انقضى حيضها اغتسلت كل يوم واتخذت صوفة فيها سمن أو زيت .(@)(@@) % ( د ) .(@)(@@) 27741 - { مسند حمنة بنت جحش } قالت : كنت أستحاض حيضة كبيرة طويلة فجئت النبي صلى الله عليه وسلم أستفتيه 
ms3668	 وأخبره فوجدته في بيت أختي زينب فقلت : يا رسول الله إن لي حاجة قال : وما هي أي هنتاه ( هنتاء : أي يا هذه ، وتفتح النون وتسكن وتضم الهاء الآخرة وتسكن . انتهى . النهاية 5 / 280 . ب ) ؟ قلت : إني أستحاض حيضة طويلة كبيرة قد منعتني الصلاة والصوم فما ترى فيها ؟ قال : أنعت لك الكرسف فإنه يذهب الدم ، قلت : هو أكبر من ذلك ؟ قال : فتلجمي ، قلت : هو أكبر من ذلك ؟ قال : فاتخذي ثوبا ، قلت : هو أكبر من ذلك يا رسول الله إنما يثج ( يثج : الثج : سيلان دماء الهدى والأضاحي يقال ثجه يثجه ثجأ . ومنه حديث أم معبد ( فحلب فيه ثجا ) أي لبنا سائلا كثيرا . وحديث المستحاضة ( إني أثجه ثجا ) . انتهى . النهاية 1 / 207 ب(@)(@@) وثج الماء والدم : سيلة ، وبابه رد ، ومطر ثجاج . أي : منصب جدا . انتهى . المختار 61 . ب ) ثجا قال : سآمرك بأمرين أيهما فعلت أجزأ عنك من الآخر وإن قويت عليهما فأنت أعلم ، إنما هذه ركضة من ركضات الشيطان فتحيضي ستة أيام أو سبعة أيام في علم الله ، ثم اغتسلي حتى إذا رأيت أنك قد طهرت واستنقأت فصلي ثلاثا وعشرين ليلة أو أربعا وعشرين ليلة وأيامها وصومي ، فإن ذلك يجزئك وكذلك فافعلي كل شهر كما تحيض النساء وكما يطهرن لميقات حيضهن وطهرهن ، وإن قويت على أن تؤخري الظهر وتعجلي العصر فتغتسلي لهما جميعا وتجمعين بين الصلاتين الظهر والعصر وتؤخرين المغرب وتعجلين العشاء ثم تغتسلين لهما جميعا وتجمعين بين الصلاتين فافعلي ، وتغتسلين مع الفجر ثم تصلين وكذلك فافعلي ، وصومي إن قدرت على ذلك وهذا أعجب الأمرين إلي .(@)(@@) % ( حم ، عب ، ش ، د ، ت ( أخرجه الترمذي كتاب الطهارة باب في المستحاضة رقم / 118 / وقال حسن صحيح . ص ) : حسن صحيح ، ه ، ك ) .(@)(@@) PageV09P273(@)(@@) 27742 - عن عائشة قالت : جاءت فاطمة بنت أبي حبيش إلى النبي صلى الله عليه وسلم فقالت : يا رسول الله إني امرأة أستحاض فلا أطهر فأدع الصلاة ؟ قال : لا إنما ذلك عرق وليس بالحيضة اجتنبي الصلاة أيام حيضتك ثم اغتسلي وتوضأي لكل صلاة ، ثم صلي وإن 
ms3669	 قطر الدم على الحصير .(@)(@@) % ( ش ) .(@)(@@) 27743 - عن ابن عباس قال : إذا استحيضت المرأة فلتقعد أيام أقرئها ( أقرائها : قد تكررت هذه اللفظة في الحديث مفردة ومجموعة ، والمفردة بفتح القاف وتجمع على أقراء وقروء ، وهو من الأضداد يقع على الطهر وإليه ذهب الشافعي وأهل الحجاز ، وعلى الحيض ، وإليه ذهب أبو حنيفة وأهل العراق والأصل في القرء : الوقت المعلوم فلذلك وقع على الضدين ؛ لأن لكل منهما وقتا ، وأقرأت المرأة إذا طهرت وإذا حاضت ، وهذا الحديث أراد بالأقراء فيه الحيض ؛ لأنه أمرها فيه بترك الصلاة . انتهى . النهاية 4 / 32 . ب ) التي كانت تقعد بعده يوما أو يومين وتؤخر الظهر إلى العصر ، وتغتسل لهما وتؤخر المغرب إلى العشاء وتغتسل لهما وتغتسل للصبح ويأتيها زوجها .(@)(@@) % ( ص ) .(@)(@@) 27744 - عن ابن عباس قال : تدع المستحاضة الصلاة أيام حيضها ثم تغتسل ثم تتوضأ عند كل صلاة ؛ فإنما هو عرق عاند أو قال تلعب من الشيطان .(@)(@@) % ( ص ) .(@)(@@) 27745 - عن ابن عباس قال : المستحاضة لا بأس أن يجامعها زوجها .(@)(@@) % ( عب ) .(@)(@@) 27746 - عن عكرمة قال : كان ابن عباس لا يرى بالتربة والصفرة بأسا ويرى فيها الوضوء .(@)(@@) % ( عب ) .(@)(@@) 27747 - عن عائشة أن أم حبيبة كانت تستحاض فتمكث السنين وأنها كانت تدخل المركن حتى يعلو الدم فقال رسول الله صلى الله عليه وسلم : ليست بالحيضة إنما هو عرق وكانت تغتسل لكل صلاة .(@)(@@) % ( ص ) .(@)(@@) 27748 - عن عائشة أنها سئلت عن المستحاضة ؟ فقالت : تجلس أيام أقرائها ثم تغتسل غسلا واحدا وتتوضأ لكل صلاة .(@)(@@) % ( عب ، ص ) .(@)(@@) 27749 - عن عائشة قالت : تغتسل المستحاضة من الظهر إلى الظهر كل يوم مرة عند صلاة الظهر .(@)(@@) % ( عب ) .(@)(@@) 27750 - { مسند أم حبيبة بنت جحش } عن أم حبيبة أنها استحيضت فجعل النبي صلى الله عليه وسلم أجل حيضتها ستة أيام أو سبعة .(@)(@@) % ( عب ) .(@)(@@) 27751 - عن أم حبيبة أنها استحيضت سبع سنين فاشتكت ذلك إلى رسول الله صلى الله عليه وسلم فقال النبي صلى الله عليه وسلم : ليست تلك بحيضة ولكنه عرق فاغتسلي ؛ فكانت تغتسل عند كل صلاة وكانت تغتسل في المركن فيرى صفرة 
ms3670	 الدم في المركن .(@)(@@) % ( عب ) .(@)(@@) 27752 - عن أم سلمة قالت : سألت امرأة النبي صلى الله عليه وسلم فقالت : إني أستحاض فلا أطهر أفأدع الصلاة ؟ قال : لا ولكن دعي قدر الأيام والليالي التي كنت تحيضين وقدرهن ثم اغتسلي واستدفري وصلي .(@)(@@) % ( ش ) .(@)(@@) 27753 - عن أم سلمة أن امرأة كانت تهراق الدماء في عهد رسول الله صلى الله عليه وسلم فاستفتت لها رسول الله صلى الله عليه وسلم ؟ قال : لتنظر عدد الليالي والأيام التي كانت تحيضهن قبل أن(@)(@@) PageV09P274 يصيبها الذي أصابها فلتترك الصلاة قدر ذلك من الشهر فإذا خلفت ذلك فلتغتسل ، ثم لتستثفر ( ثم لتستثفر : في الحديث ( أنه أمر المستحاضة أن تستثفر ) هو أن تشد فرجها بخرقة عريضة بعد أن تحتشي قطنا ، وتوثق طرفيها في شيء تشده على وسطها ، فتمنع بذلك سيل الدم ، وهو مأخوذ من ثفر الدابة الذي يجعل تحت ذنبها . انتهى . النهاية 1 / 214 . ب ) بثوب ثم لتصل .(@)(@@) % ( مالك ( أخرجه مالك في الموطأ كتاب الطهارة باب المستحاضة رقم / 107 / . وأخرجه أبو داود كتاب الطهارة باب في المرأة تستحاض . رقم / 274 / . والنسائي كتاب الطهارة باب ذكر الاغتسال من الحيض رقم / 209 / . ص ) ، عب ، ص ) .(@)(@@) 27754 - حدثنا إسماعيل بن إبراهيم حدثنا هشام الدستوائي عن يحيى ابن أبي كثير قال : حدثني أبو سلمة أن أم حبيبة ابنة جحش كانت تهراق الدم وأنها سألت رسول الله صلى الله عليه وسلم فأمرها أن تغتسل عند كل صلاة وتصلي .(@)(@@) % ( ص ) .(@)(@@) 27755 - حدثنا سفيان عن يحيى بن سعيد عن القعقاع بن حكيم قال : سألت سعيد بن المسيب عن المستحاضة ؟ فقال : ما بقي في الناس أعلم بها مني ، إذا أقبلت الحيضة فلتدع الصلاة ، وإذا أدبرت فلتغتسل ثم توضأ لكل صلاة .(@)(@@) 27756 - عن عكرمة أن أم حبيبة بنت جحش استحيضت على عهد رسول الله صلى الله عليه وسلم فسألت عن ذلك النبي صلى الله عليه وسلم أو سئل لها ؟ فأمرها أن تنظر أيام أقرائها ، ثم تغتسل فإن رأت بعد ذلك احتشت واستذفرت وتوضأت وصلت .(@)(@@) % ( ص ) .(@)(@@) 27757 - حدثنا سفيان عن عبد الرحمن 
ms3671	 بن القاسم عن أبيه أن امرأة من المسلمين استحيضت فسألت رسول الله صلى الله عليه وسلم فأمرها أن تغتسل للظهر غسلا وللعصر والمغرب والعشاء غسلا وللفجر غسلا وتدع الصلاة أيام أوقاتها وقال : إنما هو عرق .(@)(@@) % ( عب ) .(@)(@@) 27758 - { مسند علي } أبو يوسف أنبأنا أبو حنيفة عن حماد وعن سعيد بن جبير عن ابن عباس أنه قال في المستحاضة : تدع الصلاة أيام حيضها وتغتسل إذا مضت ، وتؤخر من الظهر ، وتقدم من العصر ، وتغتسل غسلا واحدا ، وتصليهما جميعا ، وتؤخر المغرب ، وتقدم العشاء ، ثم تغتسل غسلا واحدا فتصليهما ، وتغتسل للفجر فتصليها .(@)(@@) % ( أبو عروبة الحراني في مسند القاضي أبي يوسف ) .(@)(@@) 27759 - عن سعيد بن جبير أن امرأة من أهل الكوفة كتبت إلى ابن عباس بكتاب فيه : إني امرأة مستحاضة أصابني بلاء وضر وإني أدع الصلاة الزمان الطويل ، وإن علي بن أبي طالب سئل عن ذلك فتاني أن أغتسل عند كل صلاة فقال ابن عباس : اللهم لا أجد لها إلا ما قال علي غير أنها تجمع بين الظهر والعصر بغسل واحد ، والمغرب والعشاء بغسل واحد وتغتسل للفجر ، فقيل له : إنه يشق عليها ؟ قال : لو شاء الله لابتلاها بأمثل من ذلك .(@)(@@) % ( عب ، ص ) .(@)(@@) | 1 ( اغتسال المرأة ) 1(@)(@@) 27760 - عن عبيد بن عمير قال : بلغ عائشة أن عبد الله بن عمرو يأمر النساء إذا اغتسلن أن ينقضن رؤسهن فقالت : يا عجبا لابن عمرو هذا يأمر النساء إذا اغتسلن أن ينقضن رؤسهن ! أفلا يأمرهن أن يحلقن رؤسهن ؟ قد كنت أنا ورسول الله صلى الله عليه وسلم يغتسل من إناء واحد فلا أزيد أن أفرغ على رأسي ثلاث إفراغات .(@)(@@) % ( ش ( أخرجه مسلم في صحيحه كتاب الحيض باب حكم ضفائر المغتسلة رقم / 331 / . ص ) ، م ، ن ) .(@)(@@) PageV09P275(@)(@@) 27761 - عن عائشة قالت : دخلت أسماء بنت شكل على رسول الله صلى الله عليه وسلم فقالت : يا رسول الله كيف تغتسل إحدانا إذا تطهرت من الحيض ؟ قال : تأخذ سدرها وماءها فتوضأ وتغسل رأسها وتدلكه حتى يبلغ الماء أصول شعرها ، ثم تفيض الماء على جسدها ، ثم 
ms3672	 تأخذ فرصتها ( فرصتها : ( في حديث الحيض ) ( خذي فرصة ممسكة فتطهرى بها ) الفرصة بكسر الفاء : قطعة من صوف أو قطن أو خرقة . يقال : فرصت الشيء إذا قطعته . والممسكة : المطيبة بالمسك . يتتبع بها أثر الدم فيحصل منه الطيب والتنشيف . انتهى . النهاية 3 / 431 . ب ) فتطهر بها ، فقالت : يا رسول الله كيف أتطهر بها ؟ قال : تطهري بها ، فقالت عائشة : فعرفت الذي يكني عنه فقلت لها : تتبعي أثر الدم .(@)(@@) % ( ص ، ش ) .(@)(@@) 27762 - عن عائشة أن النبي صلى الله عليه وسلم قال لها في الحيض : انقضي شعرك واغتسلي .(@)(@@) % ( ش ) .(@)(@@) 27763 - عن عائشة قالت : استفتت امرأة رسول الله صلى الله عليه وسلم عن المرأة تحتلم ؟ فقلت لها ، فضحت النساء أو ترى المرأة ذلك ؟ فالتفت رسول الله صلى الله عليه وسلم فقال : فمن أين يكون الشبه تربت يمينك ؟ وأمر النبي صلى الله عليه وسلم بالغسل إذا أنزلت المرأة .(@)(@@) % ( عب ) .(@)(@@) 27764 - عن عائشة أنها قالت : نعم النساء نساء الأنصار لم يكن يمنعهن الحياء أن يتفقهن في الدين وأن يسألن عنه ، ولما نزلت سورة النور شققن حجز ( حجز : الحجز : المآزر . انتهى . النهاية 1 / 344 . ب ) مناطقهن فاتخذنها خمرا ، وجاءت فلانة فقالت : يا رسول الله إن الله لا يستحيي من الحق كيف أغتسل من الحيض ؟ قال : لتأخذ إحداكن سدرها وماءها ثم تطهر فتلتمس الطهور ثم لتفض على رأسها ولتلصق ستور رأسها ثم لتفض على جسدها ولتأخذ فرصة ممسكة فلتطهر بها قالت : كيف أتطهر بها ؟ فاستحيي منها رسول الله صلى الله عليه وسلم واستتر منها وقال : سبحان الله تطهري بها فلمحت الذي قال ، فأخذت بجيب درعها فقلت : تتبعين بها آثار الدم .(@)(@@) % ( عب ) .(@)(@@) 27765 - عن عائشة قالت : كانت المرأة إذا اغتسلت من الحيض تأخذ فرصة مسك فتتبع بها أثر الدم .(@)(@@) % ( ص ، ش ) .(@)(@@) 27766 - { مسند عبد الله بن عمرو بن العاص } جاءت امرأة يقال لها بسرة إلى النبي صلى الله عليه وسلم فقالت : يا رسول الله إحدانا ترى أنها مع زوجها في المنام ؟ قال : إذا وجدت بللا فاغتسلي يا بسرة .(@)(@@) % ( ش ) .(@)(@@) 27767 - { مسند 
ms3673	 أنس } أن أم سليم سألت النبي صلى الله عليه وسلم عن المرأة ترى في منامها ما يرى الرجل ؟ فقال : إذا رأت ذلك فأنزلت فعليها الغسل فقالت أم سلمة : يا رسول الله أيكون هذا ؟ قال : ماء الرجل غليظ أبيض ، وماء المرأة رقيق أصفر ، فأيهما سبق أو علا أشبهه الولد .(@)(@@) % ( ش ، حم ) .(@)(@@) 27768 - { أيضا } قالت أم سليم : يا رسول الله المرأة ترى ما يرى الرجل في المنام ؟ فقالت عائشة : فضحت النساء ، قالت : إن الله لا يستحيي من الحق فقال النبي صلى الله عليه وسلم : تربت يداك فمن أين يكون الاشتباه .(@)(@@) % ( عب ) .(@)(@@) PageV09P276(@)(@@) 27769 - عن أنس قال : جاءت امرأة من الأنصار فقالت : المرأة تري في المنام ما يرى الرجل أتغتسل ؟ فقال : إن خرج منها ما يخرج من الرجل فتغتسل ، فقالت لها عائشة : فضحت النساء فقال : مهلا يا عائشة إن نساء الأنصار يسألن عن الفقه .(@)(@@) % ( الديلمي وابن النجار ) .(@)(@@) PageV09P277(@)(@@) | 1 ( الكتاب الثاني من حرف الطاء ) 1(@)(@@)(@)(@@) | 1 ( كتاب الطلاق من قسم الأقوال وفيه فصلان ) 1(@)(@@)(@)(@@) | 1 ( الفصل الأول في أحكام الطلاق وما يتعلق به وفيه فرعان ) 1(@)(@@)(@)(@@) | 1 ( الفرع الأول في الأحكام ) 1(@)(@@) 27770 - الطلاق بيد من أخذ بالساق .(@)(@@) % ( طب عن ابن عباس ) ( أورده الهيثمي في مجمع الزوائد ( 4 / 334 ) وعن عصمة . . . الخ ) وقال فيه الفضل بن المختار وهو ضعيف . ص ) .(@)(@@) 27771 - كل طلاق جائز إلا طلاق المعتوه المغلوب على عقله .(@)(@@) % ( ت ( أخرجه الترمذي كتاب الطلاق باب ما جاء في طلاق المعتوه رقم / 1191 / وفي سنده عطاء بن عجلان ضعيف . ص ) - عن أبي هريرة ) .(@)(@@) 27772 - ليس على الرجل طلاق فيما لا يملك ولا عتاق فيما لا يملك ولا بيع فيما لا يملك .(@)(@@) % ( حم ، ن - عن ابن عمرو ) .(@)(@@) 27773 - من لعب بطلاق أو عتاق فهو كما قال .(@)(@@) % ( طب - عن أبي الدرداء ) .(@)(@@) 27774 - إذا ادعت المرأة طلاق زوجها فجاءت على ذلك بشاهد عدل استحلف زوجها فإن حلف بطلت شهادة الشاهد ، فإن نكل فنكوله بمنزلة شاهد آخر وجاز طلاقه .(@)(@@) % ( ه - عن ابن عمرو ( أخرجه ابن ماجه كتاب الطلاق باب 
ms3674	 الرجل يجحد الطلاق رقم / 2038 / وقال في الزوائد : هذا إسناده صحيح ورجاله ثقات . ص ) ) .(@)(@@) 27775 - ليراجعها ثم ليمسكها حتى تطهر ثم تحيض فتطهر ، فإن بدا له أن يطلقها فليطلقها طاهرا قبل أن يمسها فتلك العدة التي أمر الله أن يطلق بها النساء .(@)(@@) % ( ق ( أخرجه البخاري في كتاب الأحكام باب هل يقضي الحاكم أو يفتي وهو غضبان 9 / 82 . ص ) ، د ، ن ، ه - عن ابن عمر ) .(@)(@@) PageV09P278(@)(@@) 27776 - من طلق للبدعة ألزمناه بدعته .(@)(@@) % ( هق - عن معاذ ) .(@)(@@) 27777 - ما بال أقوام يلعبون بحدود الله يقول : قد طلقتك قد راجعتك طلقتك راجعتك .(@)(@@) % ( ه ، هق - عن أبي موسى ) .(@)(@@) 27778 - لا طلاق قبل النكاح .(@)(@@) % ( ه - عن علي ؛ ك - عن جابر ) .(@)(@@) 27779 - لا طلاق إلا فيما تملك ، ولا عتق إلا فيما تملك ، ولا بيع إلا فيما تملك ، ولا وفاء نذر إلا فيما تملك ، ولا نذر إلا فيما ابتغي به وجه الله ، ومن حلف على معصية فلا يمين له ، ومن حلف على قطيعة رحم فلا يمين له .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطلاق باب في الطلاق قبل النكاح رقم / 2176 / وقال المنذري الحديث حسن . عون المعبود 6 / 260 . ص ) ، ك - عن ابن عمرو ) .(@)(@@) 27780 - يا أيها الناس ما بال أحدكم يزوج عبده أمته ، ثم يريد أن يفرق بينهما إنما الطلاق لمن أخذ بالساق .(@)(@@) % ( ه - عن ابن عباس ) .(@)(@@) 27781 - يا عباس ألا تعجب من حب مغيث بريرة ومن بغض بريرة مغيثا .(@)(@@) % ( خ ، د ، ن ، ه - عن ابن عباس ) ( أخرجه البخاري كتاب الطلاق باب شفاعة النبي صلى الله عليه وسلم في زوج بريرة . ( 7 / 62 ) . ص ) .(@)(@@) 27782 - لا طلاق قبل النكاح ، ولا عتاق قبل ملك .(@)(@@) % ( ه - عن المسور ) .(@)(@@) 27783 - لا طلاق ولا عتاق في إغلاق ( إغلاق : أي في إكراه ، لأن المكره مغلق عليه في أمره ومضيق عليه في تصرفه ، كما يغلق الباب على الإنسان . قال الهروي : وقيل معناه : لا تغلق التطليقات في دفعة واحدة حتى لا يبقى منها شيء ، لكن يطلق طلاق السنة ) . انتهى . النهاية 3 / 380 . ب ) .(@)(@@) % ( حم ، د 
ms3675	 ، ه ( أخرجه أبو داود كتاب الطلاق باب في الطلاق على غضب رقم / 2179 / وقال المنذري في عون المعبود ( 6 / 262 ) وفي إسناده محمد بن عبيد بن صالح المكي وهو ضعيف . ص ) ، ك - عن عائشة ) .(@)(@@) 27784 - لا طلاق إلا لعدة ، ولا عتاق إلا لوجه الله .(@)(@@) % ( طب - عن ابن عباس ) .(@)(@@) 27785 - ثلاث جدهن جد وهزلهن جد : الطلاق ، والنكاح ، والرجعة .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطلاق باب من له في الطلاق على الهزل رقم / 2180 / وقال الترمذي في كتاب الطلاق رقم / 1184 / حديث حسن غريب . ص ) ، ت ، ه - عن أبي هريرة ) .(@)(@@) 27786 - ثلاث لا يجوز اللعب فيهن : الطلاق ، والنكاح ، والعتق .(@)(@@) % ( طب - عن فضالة بن عبيد ) .(@)(@@) | 1 ( { الإكمال } من الفرع الأول في الأحكام ) 1(@)(@@) 27787 - ثلاث جدهن جد وهزلهن جد : الطلاق ، والنكاح ، والعتاق .(@)(@@) % ( القاضي أبو يعلى عن عبد الله بن علي الطبري في الأربعين - عن أبي هريرة ) .(@)(@@) 27788 - من طلق أو حرم أو نكح أو أنكح جادا أو لاعبا فقد جاز عليه .(@)(@@) % ( ه وابن جرير وابن أبي حاتم - عن الحسن مرسلا ) .(@)(@@) 27789 - من طلق أو حرم أو نكح أو أنكح فقال : إني كنت لاعبا فهو جاد .(@)(@@) % ( طب - عن الحسن عن أبي الدرداء ) .(@)(@@) 27790 - لا طلاق إلا بعد نكاح .(@)(@@) % ( ك - عن ابن عمرو ؛ ش - عن طاوس مرسلا ؛ ش - عن علي وعائشة موقوفا ) .(@)(@@) 27791 - لا طلاق قبل نكاح ، ولا نذر فيما لا يملك .(@)(@@) % ( عبد الرزاق - عن معاذ ) .(@)(@@) PageV09P279(@)(@@) 27792 - لا طلاق فيما لا تملك ولا عتاقة فيما لا تملك .(@)(@@) % ( طب - عن معاذ ؛ عبد الرزاق - عن ابن عمرو ) .(@)(@@) 27793 - لا طلاق من غير نكاح .(@)(@@) % ( ص - عن أنس ) .(@)(@@) 27794 - لا طلاق لمن لم ينكح ، ولا عتاق لمن لم يملك .(@)(@@) % ( ظ ، ك ، ق ، ض - عن جابر ؛ عب - عن طاوس مرسلا وعن ابن عباس موقوفا ) .(@)(@@) 27795 - لا طلاق إلا بعد نكاح ولا عتق إلا بعد ملك .(@)(@@) % ( الخطيب عن علي ؛ ك - عن عائشة ؛ عب ، ك ، ق - عن معاذ ؛ ط ، ش ، ق - عن ابن عمرو ) .(@)(@@) 27796 - لا طلاق إلا من بعد ملك ولا 
ms3676	 عتاق إلا من بعد ملك .(@)(@@) % ( طب - عن ابن عباس ) .(@)(@@) 27797 - لا طلاق لمن لا يملك .(@)(@@) % ( ك عن ابن عباس ) .(@)(@@) 27798 - لا طلاق قبل نكاح ، ولا عتاق قبل ملك ، ولا رضاع بعد فصال ، ولا وصال في الصيام ، ولا صمت يوم إلى الليل .(@)(@@) % ( ق - عن جابر ؛ ق - عن علي ) .(@)(@@) 27799 - لا طلاق قبل ملك ، ولا قصاص فيما دون الموضحة ( الموضحة : هي التي تبدي وضح العظم : أي بياضه . انتهى . النهاية 5 / 196 . ب ) من الجراحات .(@)(@@) % ( ق - عن طاوس مرسلا ) .(@)(@@) 27800 - من طلق ما لا يملك فلا طلاق له ، ومن أعتق ما لا يملك فلا عتاق له ومن نذر فيما لا يملك فلا نذر له ، ومن حلف على معصية فلا يمين له ، ومن حلف على قطيعة رحم فلا يمين له .(@)(@@) % ( ك ، ق - عن عمرو ابن شعيب عن أبيه عن جده ) .(@)(@@) 27801 - ما بال أقوام يزوجون عبيدهم وإماءهم ثم يريدون أن يفرقوا بينهم ألا إنما يملك الطلاق من أخذ بالساق .(@)(@@) % ( هق - عن ابن عباس ) .(@)(@@) 27802 - من قال لامرأته : أنت طالق إن شاء الله ، أو غلامه أنت حر إن شاء الله أو عليه المشي إلى بيت الله إن شاء الله ؛ فلا شيء عليه .(@)(@@) % ( عد ، هق - عن ابن عباس ) .(@)(@@) 27803 - إذا قال الرجل لامرأته : أنت طالق إن شاء الله لم تطلق ، وإذا قال لعبده : أنت حر إن شاء الله فإنه حر .(@)(@@) % ( الديلمي - عن معاذ ) .(@)(@@) 27804 - إذا قال الرجل لامرأته : أنت طالق إن شاء الله إلى سنة فلا حنث عليه .(@)(@@) % ( ك في التاريخ ، كر عن الجارود بن يزيد النيسابوري - عن بهز بن حكيم عن أبيه عن جده ، قال ك الحمل فيه على الجارود وهو متروك ) .(@)(@@) 27805 - إذا قال الرجل لامرأته : أنت طالق بمشيئة الله أو بإرادة الله ؛ المشيئة هي خاصة لله لا يقع الطلاق والإرادة يقع الطلاق .(@)(@@) % ( خط - عن ابن مسعود ) .(@)(@@) 27806 - طلاق التي لم يدخل بها واحدة .(@)(@@) % ( ق - عن الحسن مرسلا ) .(@)(@@) PageV09P280(@)(@@) 27807 - أما اتقى الله جدك ، أما ثلاثة فله ، وأما تسعمائة وسبع وتسعون فعدوان وظلم ، إن شاء 
ms3677	 الله عذبه ، وإن شاء الله غفر له .(@)(@@) % ( طب - عن عبادة بن الصامت ) قال : طلق جدي امرأة له ألف تطليقة فسألت عن النبي صلى الله عليه وسلم قال - فذكره ) .(@)(@@) 27808 - إن أباكم لم يتق الله فيجعل له من أمره مخرجا بانت ( بانت : بان الشيء إذا انفصل فهو بائن وأبنته بالألف فصلته ، وبانت المرأة بالطلاق فهي بائن بغير هاء ، وأبانها زوجها فهي مبانة . انتهى . المصباح المنير 1 / 97 . ب ) منه بثلاث على غير السنة ، وتسع مائة وسبع وتسعون اثم في عنقه .(@)(@@) % ( طب وابن عساكر - عن إبراهيم بن عبيد الله بن عبادة بن الصامت عن أبيه عن جده ) قال طلق رجل امرأته ألفا فانطلق بنوه إلى رسول الله صلى الله عليه وسلم فسألوه هل من مخرج قال - فذكره .(@)(@@) 27809 - إن أحدهم يقول : قد نكحت قد طلقت وليس هذا بطلاق المسلمين طلقوا المرأة قبل عدتها .(@)(@@) % ( طب - عن أبي موسى ) .(@)(@@) 27810 - لم يقول أحدكم لامرأته : قد طلقتك قد راجعتك ؟ ليس هذا بطلاق المسلمين طلقوا المرأة في قبل طهرها .(@)(@@) % ( هق - عن أبي موسى ) .(@)(@@) 27811 - مره فليراجعها ثم ليطلقها طاهرا أو حاملا .(@)(@@) % ( ت ( أخرجه الترمذي كتاب الطلاق باب ما جاء في طلاق السنة رقم / 1176 / وقال حسن صحيح . ص ) : حسن صحيح - عن ابن عمر ) .(@)(@@) 27812 - لا يجوز للعبد ولا للمعتوه طلاق ولا بيع ولا شراء .(@)(@@) % ( عد والديلمي - عن جابر ) ( وهكذا أورده الترمذي قريبا من لفظه ومعناه كتاب الطلاق باب ما جاء في طلاق المعتوه رقم / 1195 / وقال ضعيف . ص ) .(@)(@@) | 1 ( الفرع الثاني في العدة والاستبراء والتحليل ) 1(@)(@@) 27813 - إنما هي أربعة أشهر وعشر وقد كانت إحداكن في الجاهلية ترمي بالبعرة على رأس الحول .(@)(@@) % ( مالك ، ق ، ت ، ن ، ه - عن أم سلمة ) ( أخرجه البخاري في صحيحه كتاب الطلاق باب تحد المتوفى عنها 7 / 77 ص ) .(@)(@@) 27814 - المتوفى عنها لا تلبس المعصفر من الثياب ولا الممشقة ( الممشقة : وفي حديث عمر ( رأى علي طلحة ثوبين مصبوغين وهو محرم ، فقال : ما هذا ؟ قال : إنما هو مشق ) المشق بالكسر : المغرة . وثوب ممشق 
ms3678	 ، مصبوغ به . انتهى . النهاية 4 / 334 . ب ) ولا المحلى ولا تختضب ولا تكتحل .(@)(@@) % ( حم ، ن - عن أم سلمة ) .(@)(@@) 27815 - لا يحل لامرأة تؤمن بالله واليوم الآخر أن تحد ( تحد : وفي الحديث ( لا يحل لامرأة أن تحد على ميت أكثر من ثلاث ) أحدت المرأة على زوجها : تحد فهي محد ، وحدت تحد وتحد فهي حاد : إذا حزنت عليه ، ولبست ثياب الحزن ، وتركت الزينة . انتهى . النهاية 1 / 352 . ب ) على ميت فوق ثلاث ليال إلا على زوج فإنها تحد عليه أربعة أشهر وعشرا .(@)(@@) % ( حم ، ق ، 3 - عن ( أخرجه البخاري في صحيحه كتاب الطلاق باب الكحل للحادة 7 / 77 . ص ) أم حبيبة وزينب بنت جحش ؛ حم ، م ، ن ، ه - عن حفصة وعائشة ؛ ن - عن أم سلمة ) .(@)(@@) 27816 - لا يحل لامرأة تؤمن بالله واليوم الآخر تحد فوق ثلاث إلا على زوج أربعة أشهر وعشرا ؛ فإنها لا تكتحل ، ولا تلبس ثوبا مصبوغا إلا ثوب عصب ، ولا تمس طيبا إلا إذا طهرت من محيضها نبذة من قسط ( قسط : القسط : ضرب من الطيب . انتهى . النهاية 4 / 60 . ب ) أو أظفار ( أظفار : الأظفار : جنس من الطيب لا واحد له من لفظه . انتهى . النهاية 3 / 158 . ب ) .(@)(@@) % ( حم ، ق ، د ، ن ه - عن أم عطية ) ( أخرجه البخاري في صحيحه كتاب الطلاق باب القسط للحادة عند الطهر 7 / 77 . ص ) .(@)(@@) PageV09P281(@)(@@) | 1 ( { الإكمال } من العدة والاستبراء والتحليل ) 1(@)(@@) 27817 - امكثي في بيتك حتى يبلغ الكتاب أجله .(@)(@@) % ( ت ( أخرجه الترمذي كتاب الطلاق باب ما جاء أن تعتد المتوفى عنها زوجها رقم / 1204 / وقال حسن صحيح . ص ) : حسن صحيح ، ن ، ه ، ك - عن الفريعة بنت مالك أخت أبي سعيد ) .(@)(@@) 27818 - امكثي في بيتك الذي أتاك نعي زوجك حتى يبلغ الكتاب أجله قالت فاعتددت فيه أربعة أشهر وعشرا .(@)(@@) % ( حم ، طب ، ن - عنها ) .(@)(@@) 27819 - لا تختضب المتوفى عنها زوجها ولا تكتحل ولا تطيب ولا تلبس ثوبا مصبوغا ولا تلبس حليا .(@)(@@) % ( طب - عن أم سلمة ) .(@)(@@) 27820 - تسلبي ( تسلبي : أي البسي ثوب الحداد وهو السلاب والجمع سلب وتسلبت 
ms3679	 المرأة إذا لبسته . وقيل : هو ثوب أسود تغطي به المحد رأسها . انتهى . النهاية 2 / 387 . ب ) ثلاثة أيام ، ثم اصنعي ما شئت .(@)(@@) % ( حم وابن منيع ، هق - عن أسماء بنت عميس ) .(@)(@@) | 1 ( عدة الطلاق ومتعتها ) 1(@)(@@) 27821 - قد حللت حين وضعت حملك .(@)(@@) % ( عب - عن سبيعة ) .(@)(@@) 27822 - سبق الكتاب أجله اخطبها إلى نفسها .(@)(@@) % ( ه - عن الزهير ) .(@)(@@) 27823 - لا نفقة لك ولا سكنى .(@)(@@) % ( م - عن فاطمة بنت قيس ) ( أخرجه مسلم في صحيحه كتاب الطلاق باب المطلقة ثلاثا لا نفقة لها رقم 37 ص ) .(@)(@@) 27824 - لا نفقة لك إلا أن تكوني حاملا .(@)(@@) % ( د - عنها ) ( أخرجه أبو داود كتاب الطلاق باب في نفقة المبتوتة رقم / 2273 / . ص ) .(@)(@@) 27825 - اخرجي فجدي ( فجدي : الجداد بالفتح والكسر : صرام النخل وهو قطع ثمرتها . يقال جد الثمرة يجدها جدا . انتهى . النهاية 1 / 244 . ب ) نخلك لعلك أن تصدقي منه أو تفعلي خيرا .(@)(@@) % ( د ( أخرجه أبو داود كتاب الطلاق باب في المبتوتة تخرج بالنهار رقم / 2280 / والحديث أخرجه مسلم في صحيحه كتاب الطلاق باب جواز خروج المعتدة اليائس رقم / 1483 / . ص ) ، ن ، ه ، ك - عن جابر ) .(@)(@@) 27826 - إنما النفقة والسكنى للمرأة إذا كان لزوجها عليها الرجعة .(@)(@@) % ( ن - عن فاطمة بنت قيس ) .(@)(@@) 27827 - المطلقة ثلاثا ليس لها سكنى ولا نفقة .(@)(@@) % ( ك - عن فاطمة بنت قيس ) .(@)(@@) 27828 - متعها ولو بصاع .(@)(@@) % ( خط - عن جابر ) .(@)(@@) 27829 - ليس للحامل المتوفى عنها زوجها نفقة .(@)(@@) % ( قط - عن جابر ) .(@)(@@) | 1 ( { الإكمال } من عدة الطلاق ومتعتها ) 1(@)(@@) 27830 - إذا وضعت حملك فقد حل أجلك .(@)(@@) % ( عب - عن أم سلمة ) .(@)(@@) 27831 - إن تفعل فقد حل أجلها .(@)(@@) % ( ت ، ه ، طب - عن الأسود ابن أبي السنابل بن بعك ) قال : وضعت سبيعة بعد وفاة زوجها بثلاثة وعشرين يوما فلما تغسلت تشوقت للنكاح فقال النبي صلى الله عليه وسلم - فذكره ، وقال ت : حديث مشهور ولا نعرف للأسود شيئا عن أبي السنابل وسمعت محمدا يقول : لا أعرف أن أبا السنابل عاش بعد وفاة النبي صلى الله عليه وسلم .(@)(@@) PageV09P282(@)(@@) 27832 - نسخت سورة النساء القصرى ( القصرى : وفي حديث سبيعة 
ms3680	 الأسلمية ( نزلت سورة النساء القصرى بعد الطولى ) القصرى : تأنيث الأقصر ، تريد سورة الطلاق ، والطولى . سورة البقرة ، لأن عدة الوفاة في البقرة أربعة أشهر وعشر ، وفي سورة الطلاق وضع الحمل ، وهو قوله : ( وأولات الأحمال أجلهن أن يضعن حملهن ) . انتهى . النهاية 4 / 70 . ب ) كل عدة وأولات الأحمال أجلهن أن يضعن حملهن .(@)(@@) % ( ك في تاريخه - عن ابن مسعود ) .(@)(@@) 27833 - يا فاطمة إنما السكنى والنفقة للتي لزوجها عليها رجعة .(@)(@@) % ( ابن سعد - عن فاطمة بنت قيس ) .(@)(@@) 27834 - لا نفقة لك ولا سكنى .(@)(@@) % ( م ( أخرجه مسلم في صحيحه كتاب الطلاق باب المطلقة ثلاثا لا نفقة لها رقم 37 2 / 1115 . ومر الحديث برقم / 27823 / . ص ) - عن فاطمة بنت قيس ، أن زوجها طلقها البتة فقال النبي صلى الله عليه وسلم - فذكره ) .(@)(@@) 27835 - المطلقة ثلاثا لها السكنى والنفقة .(@)(@@) % ( قط - عن جابر ) .(@)(@@) | 1 ( الاستبراء ) 1(@)(@@) 27836 - استبرؤهن بحيضة يعني السبايا .(@)(@@) % ( ابن عساكر - عن أبي سعيد ) .(@)(@@) 27837 - لقد هممت أن ألعنه لعنا يدخل معه في قبره ، كيف يورثه وهو لا يحل له ؟ كيف يستخدمه وهو لا يحل له .(@)(@@) % ( حم ( أخرجه مسلم كتاب النكاح باب تحريم وطء الحامل المسبية رقم / 1441 / ص ) ، م ، د - عن أبي الدرداء ) .(@)(@@) 27838 - من كان يؤمن بالله واليوم الآخر فلا يسقي ماءه زرع غيره ، ومن كان يؤمن بالله واليوم الآخر فلا يأتي شيئا من السبي حتى يستبرئها ، ومن كان يؤمن بالله واليوم الآخر فلا يبيعن مغنما حتى يقسم ، ومن كان يؤمن بالله واليوم الآخر فلا يركبن دابة من فيء المسلمين حتى إذا أعجفها ردها فيه ، ومن كان يؤمن بالله واليوم الآخر فلا يلبسن ثوبا من فيء المسلمين حتى إذا أخلقه رده فيه .(@)(@@) % ( د ( أخرجه أبو داود كتاب النكاح باب في وطء السبايا رقم / 2144 / وأخرجه الترمذي مختصرا وقال حديث حسن رقم / 1131 / . ص ) ، ت - عن رويفع بن ثابت ) .(@)(@@) 27839 - لا توطأ حامل حتى تضع ، ولا غير ذات حمل حتى تحيض .(@)(@@) % ( حم ، د ، ك - عن أبي سعيد ) .(@)(@@) 27840 - لا يحل لامرئ يؤمن بالله واليوم الآخر أن 