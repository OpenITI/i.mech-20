ms74	(@)(@@) 1705 - (4692) - بذيمة = علي بن بذيمة (بفتح الباء الموحدة وكسر الذال المعجمة الخفيفة بعدها ياء مثناة من تحت ساكنة).(@)(@@) 1706 - (4695) - الأسفذني = علي بن أبي بكر الأسفذني (بفتح الهمزة وسكون السين المهملة وفتح الفاء وسكون الذال المعجمة بعدها نون، قبل ياء النسب) نسبة إلى قرية بمرو.(@)(@@) 1707 - (4700) - حجر = علي بن حجر (بضم الحاء المهملة وسكون الجيم).(@)(@)PageV01P208(@)(@)(@@) 1708 - (4702) - الجنديسابوري = علي بن حرب الجنديسابوري (بضم الجيم وسكون النون وفتح الدال المهملة بعدها ياء مثناة من تحت ساكنة ثم سين مهملة وبعد الألف باء موحدة مضمومة).(@)(@@) 1709 - (4703) - الحزور = علي بن الحزور (بفتح الحاء المهملة والزاي والواو المشددة).(@)(@@) 1710 - (4707) - الدارابجردي = علي بن الحسن الدارابجردي (بكسر الباء الموحدة والجيم وسكون الراء).(@)(@@) 1711 - (4708) - اللاني = علي بن الحسن، اللاني (بالنون).(@)(@@) 1712 - (4710) - كراع = علي بن الحسن، يعرف بكراع (بضم الكاف).(@)(@@) 1713 - (4712) - الهزثمي = علي بن الحسن الهرثمي (بسكون الراء بعدها ثاء مثلثة).(@)(@@) 1714 - (4713) - إشكاب = علي بن الحسين بن إشكاب (بكسر الهمزة وسكون الشين المعجمة وآخره باء موحدة).(@)(@@) 1715 - (4720) - نشيط = علي بن الحسن بن نشيط (بفتح النون وكسر الشين المعجمة).(@)(@@) 1716 - (4721) - ظبيان = علي بن الحكم بن ظبيان (بفتح الظاء المعجمة وسكون الباء الموحدة بعدها ياء مثناة من تحت).(@)(@)PageV01P209(@)(@)(@@) 1717 - (4722) - البناني = علي بن الحكم، البناني (بضم الباء الموحدة ونونين، الأولى خفيفة).(@)(@@) 1718 - (4723) - ذبيان = علي بن حكيم بن ذبيان (بذال معجمة بعدها باء موحدة ساكنة ثم ياء مثناة من تحت).(@)(@@) 1719 - (4726) - الجحدري = علي بن حكيم الجحدري (بفتح الجيم وسكون الحاء المهملة).(@)(@@) 1720 - (4727) - حوشب = علي بن حوشب (بالحاء المهملة وشين معجمة، وزن جعفر).(@)(@@) 1721 - (4729) - خشرم = علي بن خشرم (بخاء وشين معجمتين، وزن جعفر).(@)(@@) 1722 - (4730) - القنطري = علي بن داود القنطري (بفتح القاف وسكون النون).(@)(@@) 1723 - (4731) - دؤاد - الناجي = علي بن داود، ويقال: ابن دؤاد(@)(@@) (بضم الدال، بعدها واو بهمز) أبو المتوكل الناجي (بنون وجيم).(@)(@@) 1724 - (4732) - علي = علي بن ربا