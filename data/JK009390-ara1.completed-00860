ms841	 ) عن محمود بن لبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7589 ) قال النبي :(@)(@@) | 30 ( إن صدقة السر تطفىء غضب الرب ) )(@)(@@) ( طب كر ) عن بهز بن حكيم عن أبيه عن جده ( طب ) عن معاوية بن حيدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7590 ) قال النبي :(@)(@@) | 30 ( إن صدقة المسلم تزيد في العمر وتمنع ميتة السوء ، ويذهب الله بها الكبر والفخر ) )(@)(@@) ( طب ) عن كثير بن عبد الله عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 7591 ) قال النبي :(@)(@@) | 30 ( إن صدقة الفطر حق واجب على كل مسلم ، صغير أو كبير ، ذكر أو أنثى ، حر أو مملوك ، حاضر أو باد ، صاع من شعير أو من تمر ) )(@)(@@) ( ك هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7592 ) قال النبي :(@)(@@) | 30 ( إن صريح ولد آدم من الأولين والآخرين ابنا كلاب بن مرة قصي وزهرة لفاطمة بنت سعد ابن سبيل الأزدي وهو أول من جدد PageV03P110 البيت بعد كلاب بن مرة ) )(@)(@@) ابن عساكر عن أبي سعيد وعن جبير بن مطعم رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 7593 ) قال النبي :(@)(@@) | 30 ( إن صوم يوم عرفة يكفر العام الذي قبله ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7594 ) قال النبي :(@)(@@) | 30 ( إن صلاة المرابط تعدل خمسمائة صلاة ، ونفقة الدينار والدرهم منه أفضل من تسعمائة دينار ينفقه من غيره ) )(@)(@@) أبو الشيخ ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7595 ) قال النبي :(@)(@@) | 30 ( إن طرف صاحب الصور مذ وكل به مستعد ينظر نحو العرش مخافة أن يؤمر قبل أن يرتد إليه طرفه ، كأن عينيه كوكبان دريان ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7596 ) قال النبي :(@)(@@) | 30 ( إن طفيلا قد رأى رؤيا أخبر بها من أخبر منكم ، وإنكم كنتم تقولون كلمة كان يمنعني الحياء منكم أن أنهاكم عنها ، فلا تقولوا ، ما شاء الله وشاء محمد ) )(@)(@@) ( حم ) و الدارمي ( ع طب ض ) عن طفيل بن سخبرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7597 ) قال النبي :(@)(@@) | 30 ( إن طلاق أم سليم لحوب ) )(@)(@@) ( ك هق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7598 ) قال النبي :(@)(@@) | 30 ( إن طير الجنة كأمثال البخت ترعى في شجر 
ms842	 الجنة ، قال أبو بكر رضي الله عنه : يا رسول الله إن هاذه لطير ناعمة ؟ فقال : PageV03P111 أكلها أنعم منها ، وإني لأرجو أن تكون ممن يأكل منها ) )(@)(@@) ( حم ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7599 ) قال النبي :(@)(@@) | 30 ( إن طيبة المدينة ، وما نقب من أنقابها إلا عليه ملك شاهر سيفه لا يدخلها الدجال أبدا ) )(@)(@@) ( طب ) عن تميم الداري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7600 ) قال النبي :(@)(@@) | 30 ( إن ظل المؤمن يوم القيامة صدقته ) )(@)(@@) ابن زنجويه عن بعض الصحابة .(@)(@@)(@@)(@@) $ ( 7601 ) قال النبي :(@)(@@) | 30 ( إن عائد المريض يخوض في الرحمة ، فإذا جلس غمرته ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7602 ) قال النبي :(@)(@@) | 30 ( إن عبدا في جهنم ينادي ألف سنة يا حنان يا منان فيقول الله لجبريل : اذهب ائتني بعبدي هاذا ، فينطلق جبريل فيجد أهل النار مكبين يبكون ، فيرجع إلى ربه عز وجل فيخبره ، فيقول : إئتني به فإنه في مكان كذا وكذا ، فيجيء به فيوقفه على ربه ، فيقول له : يا عبدي كيف وجدت مكانك ومقيلك ؟ فيقول : يا رب شر مكان وشر مقيل ، فيقول : ردوا عبدي ، فيقول : يا رب ما كنت أرجو إذ أخرجتني منها أن تعيدني فيها ، فيقول : دعوا عبدي ) )(@)(@@) ( حم ) و ابن خزيمة ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7603 ) قال النبي :(@)(@@) | 30 ( إن عبدا خيره الله تعالى بين أن يؤتيه زهرة الدنيا وبين ما عنده ، فاختار ما عنده ) )(@)(@@) ( م ت ) عن أبي سعيد الخدري ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7604 ) قال النبي :(@)(@@) | 30 ( إن عبدا خيره الله بين أن يعيش في الدنيا ما شاء أن يعيش فيها ، يأكل ما شاء أن يأكل منها ، وبين لقائه ) )(@)(@@) ابن السني في عمل يوم وليلة PageV03P112 عن أبي المعلى .(@)(@@)(@@)(@@) $ ( 7605 ) قال النبي :(@)(@@) | 30 ( إن عثمان ليتحول من منزل إلى منزل فتبرق له الجنة ) )(@)(@@) ( ك ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7606 ) قال النبي :(@)(@@) | 30 ( إن عقوبة هاذه الأمة السيف ، وموعدهم الساعة ، والساعة أدهى وأمر ) )(@)(@@) ( طب ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7607 ) قال النبي :(@)(@@) | 30 
ms843	 ( إن على ذورة سنام كل بعير شيطانا ، فإذا ركبتموها فإذكروا اسم الله عليها ثم امتهنوها ، فإنما يحمل الله عز وجل ) )(@)(@@) الشيرازي في الألقاب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7608 ) قال النبي :(@)(@@) | 30 ( إن على ظهر كل بعير شيطانا فإذا ركبتموها فقولوا : بسم الله ) )(@)(@@) ابن السني في عمل يوم وليلة عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7609 ) قال النبي :(@)(@@) | 30 ( إن على جهنم جسرا أدق من الشعر وأحد من السيف ، أعلاه نحو الجنة دحض مزلة ، بجنبيه كلاليب وحسك النار ، يحشر الله به من يشاء من عباده ، الزالون والزالات يومئذ كثير ، والملائكة بجانبيه قيام ينادون : اللهم سلم سلم ، فمن جاء بالحق جاز ، ويعطون النور يومئذ على قدر إيمانهم وأعمالهم ، فمنهم من يمضي عليه كلمح البرق ، ومنهم من يمضي عليه كمر الريح ، ومنهم من يعطى نورا إلى موضع قدميه ، ومنهم من يحبو حبوا وتأخذ النار منه بذنوب أصابها وهي تحرق من يشاء الله منهم على قدر ذنوبهم حتى ينجو ، وينجو أول زمرة سبعون ألفا لا حساب عليهم ولا عذاب ، كأن وجوههم القمر ليلة البدر ، والذين يلونهم كأضواء نجم في السماء حتى يبلغوا إلى الجنة برحمة الله تعالى ) )(@)(@@) ( هب ) وضعفه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7610 ) قال النبي :(@)(@@) | 30 ( إن على كل أهل بيت في كل عام أضحية PageV03P113 وعتيرة ) )(@)(@@) ( هق ) عن مخنف بن سليم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7611 ) قال النبي :(@)(@@) | 30 ( إن عليك من الحق أن تعدل بين ولدك ، كما عليهم من الحق أن يبروك ) )(@)(@@) ( ط هق ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7612 ) قال النبي :(@)(@@) | 30 ( إن عليك السلام تحية الموتى إذا لقي أحدكم أخاه فليقل : السلام عليكم ورحمة الله وبركاته ) )(@)(@@) ابن السني في عمل يوم وليلة عن رجل .(@)(@@)(@@)(@@) $ ( 7613 ) قال النبي :(@)(@@) | 30 ( إن عليك السلام تحية الميت : سلام عليكم ، سلام عليكم ، سلام عليكم ) )(@)(@@) ( حم ك ) عن جابر بن سليم الهجيمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7614 ) قال النبي :(@)(@@) | 30 ( إن عليك لباس من لا يعقل ) )(@)(@@) ( طب ) عن ابن عمرو قال : أتى رجل رسول الله 
ms844	 عليه جبة سيحان مزرورة بالديباج قال : فذكره .(@)(@@)(@@)(@@) $ ( 7615 ) قال النبي :(@)(@@) | 30 ( إن عليا مني وأنا منه ، وهو ولي كل مؤمن ) )(@)(@@) ( ط ) و الحسن بن سفيان في فضائل الصحابة عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7616 ) قال النبي :(@)(@@) | 30 ( إن عليا سبقك بالهجرة ) )(@)(@@) قاله للعباس ( طب ) عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7617 ) قال النبي :(@)(@@) | 30 ( إن عمارا ملىء إيمانا إلى مشاشه ) )(@)(@@) ( ع طب ) و ابن جرير ( كر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7618 ) قال النبي :(@)(@@) | 30 ( إن عمارا ملىء إيمانا من فرقه إلى قدمه ) )(@)(@@) ( حل ) عن PageV03P114 ابن عباس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7619 ) قال النبي :(@)(@@) | 30 ( إن عمرو بن العاص لرشيد الأمر ) )(@)(@@) ابن عساكر عن طلحة بن عبيد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7620 ) قال النبي :(@)(@@) | 30 ( إن عمرو بن العاص لمن صالحي قريش ، ونعم أهل البيت عبد الله وأبو عبد الله وأم عبد الله ) )(@)(@@) ( حم ع عد ) عن طل حة بن عبيد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7621 ) قال النبي :(@)(@@) | 30 ( إن عند كل أذانين ركعتين ما خلا المغرب ) )(@)(@@) ( قط ) عن عبد الله بن بريدة عن أبيه عن ابن بريدة عن عبد الله بن مغفر المزني قال ( قط ) وهو المحفوظ .(@)(@@)(@@)(@@) $ ( 7622 ) قال النبي :(@)(@@) | 30 ( إن عند الله رجالا مكتوبون بأسمائهم وأسماء آبائهم ، قال أبو بكر رضي الله عنه : أخبرنا بهم يا رسول الله ، قال : إنك منهم ، وعمر منهم ، وعثمان منهم ) )(@)(@@) ابن عساكر عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7623 ) قال النبي :(@)(@@) | 30 ( إن عيبتي التي آوي إليها أهل بيتي ، وإن الأنصار كرشي ، فاعفوا عن مسيئهم ، واقبلوا من محسنهم ) )(@)(@@) ابن سعد والرامهرمزي في الأمثال عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7624 ) قال النبي :(@)(@@) | 30 ( إن فاتحة الكتاب ، وآية الكرسي ، والآيتين من آل عمران { شهد الله أنه لا إلاه إلا هو } إلى { العزيز الحكيم } و { قل اللهم PageV03P115 مالك الملك } . . . إلى : { ويرزق من يشاء بغير حساب } معلقات ، ما بينهن وبين الله تعالاى حجاب قلن : تهبطنا إلى أرضك وإلى من يعصيك ! فقال 
ms845	 الله عز وجل : بي حلفت ، لا يقرأكن أحد من عبادي دبر كل صلاة إلا جعلت الجنة مثواه على ما كان منه ، وإلا أسكنته حظيرة القدس ، وإلا نظرت إليه بعيني المكنونة كل يوم سبعين نظرة ، وإلا قضيت له كل يوم سبعين حاجة ، أدناها المغفرة ، وأعذته من كل عدو ونصرته منه )(@)(@@) ) ابن السني عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 7625 قال النبي :(@)(@@) | 30 ( إن فاطمة أحصنت فرجها ، وإن الله أدخلها بإحصان فرجها وذريتها الجنة )(@)(@@) ) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 7626 قال النبي :(@)(@@) | 30 ( إن فتنة كائنة ، فالقاتل والمقتول في النار ، إن المقتول قد أراد قتل القاتل )(@)(@@) ) ( طب ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7627 قال النبي :(@)(@@) | 30 ( إن فجور المرأة الفاجرة كفجور ألف فاجر ، وإن بر المرأة المؤمنة كعمل سبعين صديقا )(@)(@@) ) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 7628 قال النبي :(@)(@@) | 30 ( إن فخذ المؤمن عورة )(@)(@@) ) أبو نعيم عن جرهد .(@)(@@)(@@)(@@) $ 7629 قال النبي :(@)(@@) | 30 ( إن فقراء المسلمين يزفون كما يزف الحمام ، فيقال لهم : قوموا للحساب ، فيقولون : والله ما تركنا شيئا نحاسب به ، فيقول الله عز وجل : صدق عبادي فيدخلون الجنة قبل الناس بسبعين عاما )(@)(@@) ) ( طب ) عن سعيد بن عامر بن جذيم .(@)(@@)(@@)(@@) $ 7630 قال النبي :(@)(@@) | 30 ( إن عيسى عليه السلام قال : يا بني إسرائيل ! إنما الأمور ثلاثة : أمر يبين لكم رشده فاتبعوه وأمر نهيتن عنه فاجتنبوه ، وأمر اختلف فيه PageV03P116 فكلوه إلى الله تعالى وفي لفظ : فردوه إلى عالمه )(@)(@@) ) ( طب ) وأبو نصر السجزي في الإبانة عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7631 قال النبي :(@)(@@) | 30 ( إن عيسى بن مريم كان يمشي على الماء ، ولو ازداد يقينا لمشى في الهواء )(@)(@@) ) الحكيم عن زافر بن سليمان معضلا .(@)(@@)(@@)(@@) $ 7632 قال النبي :(@)(@@) | 30 ( إن عيسى بن مريم كان في بني إسرائيل فقال : يا بني إسرائيل ! لا تظلموا ظالما ، ولا تكافئوا ظالما فيبطل فضلكم عند ربكم )(@)(@@) ) العسكري في الأمثال عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7633 قال النبي :(@)(@@) | 30 ( إن فضل كلام الله عز وجل على سائر الكلام 
ms846	 كفضل الله على سائر خلقه )(@)(@@) ) ابن الضريس عن شهر بن حوشب مرسلا .(@)(@@)(@@)(@@) $ 7634 قال النبي :(@)(@@) | 30 ( إن فضل القرآن على سائر الكلام ، كفضل الله على خلقه ، وذلك أن القرآن منه خرج وإليه يعود )(@)(@@) ) ابن النجار عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ 7635 قال النبي :(@)(@@) | 30 ( إن فلانا مأسور بدينه )(@)(@@) ) ( ن ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7636 قال النبي :(@)(@@) | 30 ( إن في الجنة قيعانا فأكثروا غراسها ، قالوا : يا رسول الله ! وما غراسها ؟ قال : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر )(@)(@@) ) ( طب ) عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ 7637 قال النبي :(@)(@@) | 30 ( إن في الجنة شجرة مستقلة على ساق واحد ، عرض ساقها مسير سبعين سنة )(@)(@@) ) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7638 قال النبي :(@)(@@) | 30 ( إن في الجنة لغرفا ، إذا كان ساكنها فيها لم يخف عليه ما خارجها ، وإذا خرج منها لم يخف عليه ما فيها ، قيل : لمن هي PageV03P117 يا رسول الله ؟ قال : لمن أطاب الكلام ، وأدام الصيام ، وأطعم الطعام ، وأفشى السلام ، وصلى بالليل والناس نيام ، قيل : يا رسول الله ، وما طيب الكلام ؟ قال : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، ولله الحمد ، إنها تأتي يوم القيامة ولها مقدمات ومعقبات ومجنبات ، قيل : فما إدامة الصلاة ؟ قال : من أدرك رمضان فصامه ، ثم أدرك رمضان فصامه ، قيل : فما إطعام الطعام ؟ قال : كل من قات عياله وأطعمهم ، قيل : فما إفشاء السلام ؟ قال : مصافحة أخيك إذا لقيته ، وتحيته ، قيل : فما الصلاة والناس نيام ؟ قال : صلاة عشاء الآخرة ، واليهود والنصارى نيام )(@)(@@) ) الخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7639 قال النبي :(@)(@@) | 30 ( إن في الجنة درجة لا يبلغها إلا ثلاثة : إمام عادل ، أو ذو رحم وصول ، أو ذو عيال صبور لا يمن على أهله بما ينفق عليهم )(@)(@@) ) الديلمي وأبو نعيم في أحاديث العادلين والتيمي في الترغيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7640 قال النبي :(@)(@@) | 30 ( إن في الجنة لغرفا ، يرى من في ظاهرها من في باطنها ، ويرى من في بعاطنها من في 
ms847	 ظاهرها ، لمن أطاب الكلام ، وأفشى السلام ، وأطعم الطعام ، وأدام الصيام ، وبات لله قائما والناس نيام )(@)(@@) ) أبو نصر عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 7641 قال النبي :(@)(@@) | 30 ( إن في الجنة بابا يقال له الريان ، فإذا كان يوم القيامة ، قيل : أين الصائمون ؟ فإذا دخلوا أغلق عليهم فيشربون منه ، فمن شرب منه لم يظمأ أبدا )(@)(@@) ) ابن زنجويه عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 7642 قال النبي :(@)(@@) | 30 ( إن في الجنة لطيرا فيه سبعون ألف ريشة ، فيجيء فيقع على صحفة الرجل من أهل الجنة ثم ينتفض فيخرج من كل ريشة لون أبيض مثل الثلج ، والألين من الزبد ، وأعذب من الشهد ، ليس فيه لون يشبه صاحبه ، ثم يطير فيذهب )(@)(@@) ) ( هناد ) عن أبي سعيد رضي الله عنه .(@)(@@) PageV03P118(@)(@@)(@@)(@@) $ 7643 قال النبي :(@)(@@) | 30 ( إن في الجنة شجرة يقال لها شجرة البلوى ، يؤتى بأهل البلاء يوم القيامة ، فلا يرفع لهم ديوان ، ولا ينصب لهم ميزان ، يصب عليهم الأجر صبا ، وقرأ { إنما يوفى الصابرون أجرهم بغير حساب } )(@)(@@) ) ( طب ) عن السيد الحسن بن علي رضي الله عنه وضعف .(@)(@@)(@@)(@@) $ 7644 قال النبي :(@)(@@) | 30 ( إن في الجنة لشجرة يخرج من أعلاها الحلل ، ومن أسفلها خيل بلق من ذهب مسرجة ملجمة بالدر والياقوت ، لا تبول ولا تروث ، ذوات أجنحة فيجلس عليها أولياء الله ، فتطير بهم حيث شاءوا ، فيقول الذي أسفل منهم : يا أهل الجنة ! يا ناصفونا ! يا رب ما بلغ بهؤلاء هاذه الكرامة ؟ فقال الله : إنهم كانوا يصومون وكنتم تفطرون ، وكانوا يقومون الليل وكنتم تنامون ، وكانوا ينفقون وكنتم تبخلون ، وكانوا يجاهدون العدو وكنتم تجبنون )(@)(@@) ) أبو الشيخ في العظمة والخطيب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 7645 قال النبي :(@)(@@) | 30 ( إن في بعض ما أنزل الله على نبي ، يقول الله تعالى : ابن آدم ! أخلقك وأرزقك وتعبد غيري ، ابن آدم ! أدعوك وتفر مني ، ابن آدم ! أذكرك وتنساني ، ابن آدم ! اتق الله ونم حيث شئت )(@)(@@) ) أحمد بن فارس في أماليه والخليلي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 7646 قال النبي :(@)(@@) | 30 ( إن في جهنم واديا ، وفي 
ms848	 ذالك الوادي بئر يقال لها : هبهب ، حق على الله أن يسكنه كل جبار عنيد )(@)(@@) ) ( عد طب كل ) وابن عساكر عن أبي موسى رضي الله عنهم .(@)(@@)(@@)(@@) $ 7647 قال النبي :(@)(@@) | 30 ( إن في جهنم أرحية تدور بالعلماء ، فيشرف عليهم من كان عرفهم في الدنيا ! فيقولون : ما صيركم إلى هاذا ، وكنا نتعلم منكم ؟ PageV03P119 فيقولون : إنا كنا نأمركم بأمر ونخالفكم إلى غيره )(@)(@@) ) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7648 قال النبي :(@)(@@) | 30 ( إن في النار حجرا يقال له ويل ، يصعد عليه العرفاء وينزلون فيه )(@)(@@) ) البزار عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 7649 قال النبي :(@)(@@) | 30 ( إن في النار حيات كأمثال أعناق البخت ، تلسع إحداهن اللسعة فيجد حموتها أربعين خريفا ، وإن في النار عقارب كأمثال البغال الموكفة تلسع إحداهن اللسعة ، فيجد حموتها أربعين سنة )(@)(@@) ) ( حم حب طب ك ض ) عن عبد الله بن الحارث بن جزء الزبيدي رضي الله عنه .(@)(@@)(@@)(@@) $ 7650 قال النبي :(@)(@@) | 30 ( إن في جهنم لواديا تستعيد جهنم من ذالك الوادي في كل يوم أربعمائة مرة ، أعد ذالك الوادي للمرائين من أمة محمد : لحامل كتاب الله ، وللمصدق في غير ذات الله ، وللحاج إلى غير بيت الله الحرام ، وللخارج في غير سبيل الله )(@)(@@) ) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 7651 قال النبي :(@)(@@) | 30 ( إن في هاذه الحبة السوداء شفاء من كل داء إلا أن يكون السام )(@)(@@) ) ( ه ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 7652 قال النبي :(@)(@@) | 30 ( إن في جهنم واديا يقال له : لملم ، إن أودية جهنم لتستعيذ بالله من حره )(@)(@@) ) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7653 قال النبي :(@)(@@) | 30 ( إن في ابن آدم ثلاثمائة وستين عظما ، فعليه لكل عظم منها في كل يوم صدقة ، قالوا : يا رسول الله ! ومن يستطيع ذالك ؟ قال : إرشادك ابن السبيل صدقة ، وإماطتك الأذى عن الطريق صدقة ، وإن فضل بيانك عن الارتم صدقة قالوا : فمن لم يستطع ذالك ؟ قال : يكف شره عن الناس فإنها PageV03P120 صدقة يتصدق به على نفسه )(@)(@@) ) ابن السني في الطب ( حل ) عن أبي هريرة 
ms849	 رضي الله عنه .(@)(@@)(@@)(@@) $ 7654 قال النبي :(@)(@@) | 30 ( إن في الليل ساعة تفتح فيها أبواب السماء فيقول : هل من سائل فأعطيه ؟ هل من داع فأستجيب له ؟ هل من مستغفر فأغفر له ، وإن داود خرج ذات ليلة فقال : لا يسأل الله الليلة أحد شيئا إلا أعطاه إياه ، إلا ساحر أو عشار )(@)(@@) ) ( حم طب ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ 7655 قال النبي :(@)(@@) | 30 ( إن في الجمعة لساعة لا يسأل الله العبد المسلم فيها شيئا إلا أعطاه إياه )(@)(@@) ) الخطيب في المتفق والمفترق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7656 قال النبي :(@)(@@) | 30 ( إن في الجمعة ساعة لا يوافقها عبد مؤمن وهو يصلي فيسأل الله فيها شيئا إلا استجاب الله له قيل : أي الساعات هي يا رسول الله ؟ قال : ما بين صلاة العصر إلى غروب الشمس )(@)(@@) ) الحاكم في الكنى ا عن أبي رزين العقيلي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7657 قال النبي :(@)(@@) | 30 ( إن في الجمعة لساعة ، ما دعا الله فيها عبد مسلم بشيء إلا استجاب له )(@)(@@) ) ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 7658 قال النبي :(@)(@@) | 30 ( إن في السماء ملكا يقال له إسماعيل ، على سبعين ألف ملك ، كل ملك منهم على سبعين ألف ملك )(@)(@@) ) ( طس ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 7659 قال النبي :(@)(@@) | 30 ( إن في جهنم واديا تستعيذ منه كل يوم سبعين مرة ، أعده الله للقراء المرائين بأعمالهم ، وإن أبغض الخلق إلى الله عالم السلطان )(@)(@@) ) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV03P121(@)(@@)(@@)(@@) $ ( 7660 ) قال النبي :(@)(@@) | 30 ( إن في الرجل مضغة إذا صحت صح لها سائر جسده ، وإن سقمت سقم لها سائر جسده : قلبه ) )(@)(@@) ابن السني أبو نعيم في الطب ( هب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7661 ) قال النبي :(@)(@@) | 30 ( إن في الجنة غرفا ، إذا كان ساكنها فيها لم يخف عليه ما خلفه ، وإذا خرج منها لم يخف عليه ما فيها ، لمن أطاب الكلام ، وواصل الصيام ، وأطعم الطعام ، وأفشى السلام ، وصلى بالليل والناس نيام ) )(@)(@@) الخرائطي في 
ms850	 مكارم الأخلاق عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7662 ) قال النبي :(@)(@@) | 30 ( إن في السماء لملكين ما لهما عمل إلا أن يقول أحدهما : اللهم أعط منفقا خلفا ، ويقول الآخر : اللهم ابغ ممسكا تلفا ) )(@)(@@) ( هناد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7663 ) قال النبي :(@)(@@) | 30 ( إن في المعاريض ما يغني الرجل العاقل عن الكذب ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7664 ) قال النبي :(@)(@@) | 30 ( إن في الجمعة لساعة لا يوافقها مسلم يسأل الله تعالى فيها خيرا إلا أعطاه إياه ، إذا تدلى نصف الشمس للغروب ) )(@)(@@) ( هب ) عن فاطمة الزهراء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7665 ) قال النبي :(@)(@@) | 30 ( إن في المال لحقا سوى الزكاة ) )(@)(@@) ( ت ) وضعفه عن فاطمة بنت قيس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7666 ) قال النبي :(@)(@@) | 30 ( إن في أصلاب أصلاب أصلاب رجال من أصحابي رجالا ونساء يدخلون الجنة بغير حساب ) )(@)(@@) ( طب ) و ابن مردويه ( ض ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7667 ) قال النبي :(@)(@@) | 30 ( إن في رمضان ينادي مناد بعد ثلث الليل الأول أو PageV03P122 ثلث الليل الآخر ألا سائل يسأل فيعطى ، ألا مستغفر يستغفر فيغفر له ، ألا تائب يتوب فيتوب الله عليه ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7668 ) قال النبي :(@)(@@) | 30 ( إن في أحاديث الأولين عجبا حدثني خاصتي أبو كبشة عن مشيخة لخزاعة أنهم أرادوا دفن سلول ابن حبشية ، وكان سيدا فيهم مطاعا ، قال : فانتهى بنا الحفر إلى أزج له بلق ، فإذا رجل على سرير شديد الأدمة ، كث عليه ثياب تقعقع الجلود ، وعند رأسه كتاب بالمسند : أنا شمر ذو النون ، مأوى المساكين ، ومستغاث الغارمين ، ورأس مثوبة المستصرخين ، أخذني الموت غضا ، وأوردني بقوته أرضا ، وقد أعيا الملوك الجبابرة والأبالخة والقساورة ) )(@)(@@) الديلمي عن العباس بن هشام بن محمد بن السائب عن أبيه عن جده عن أبي صالح عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7669 ) قال النبي :(@)(@@) | 30 ( إن في حكمة آل داود عبرة ينبغي للعاقل اللبيب أن لا يشغل نفسه إلا في أربع ساعات : ساعة يناجي فيها ربه ، وساعة يحاسب فيها 
ms851	 نفسه ، وساعة يلقى فيها إخوانه الذين ينصحونه في نفسه ويخبرونه بعيوبه ، وساعة يخلو بين نفسه وبين أربها فيما يحل ويجمل ، فإن في هاذه الساعة عونا على هاذه الساعات ، واستجمام القلوب بفضل بلغة ، وينبغي للعاقل اللبيب أن يكون مالكا للسانه ، عارفا بزمانه ، مقبلا على شأنه ، مستوحشا من أوثق إخوانه ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7670 ) قال النبي :(@)(@@) | 30 ( إن في أمتي أربعا من أمر الجاهلية ليسوا بتاركيهم : الفخر بالإحسان ، والطعن في الأنساب ، والاستسقاء بالنجوم ، والنياحة على الميت ) )(@)(@@) ابن جرير عن أنس بن مالك وقال : هو وهم والصحيح عن أبي مالك الأشعري .(@)(@@) PageV03P123(@)(@@)(@@)(@@) $ ( 7671 ) قال النبي :(@)(@@) | 30 ( إن فيك صدقة كثيرة : إن في فضل بيانك عن الارتم تعبر عنه حاجته صدقة ، وفي فضل سمعك على السيى السمع تعبر عنه حاجته صدقة ، وفي مباضعتك أهلك صدقة ، قيل : يا رسول الله أيأتي أحدنا شهوته ويؤجر ؟ قال : أرأيت لو جعلته في غير حله أكان عليك وزر ؟ قال : نعم ، قال : أفتحاسبون بالشر ولا تحاسبون بالخير ) )(@)(@@) ( هق ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7672 ) قال النبي :(@)(@@) | 30 ( إن فيكم النبوة ، ثم تكون خلافة على منهاج النبوة ، ثم يكون ملكا وجبرية ) )(@)(@@) ( طب ) عن أبي عبيدة بن الجراح وبشير بن سعد والد النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7673 ) قال النبي :(@)(@@) | 30 ( إن فيكم قوما يعبدون ويدينون حتى يعجبوا الناس ويعجبهم أنفسهم ، يمرقون من الدين كما يمرق السهم من الرمية ) )(@)(@@) ( حم ) عن أنس قال : ذكر لي أن النبي قال : لم أسمعه منه .(@)(@@)(@@)(@@) $ ( 7674 ) قال النبي :(@)(@@) | 30 ( إن فيكم مغربين ، قيل : وما المغربون ؟ قال : الذي تشرك فيهم الجن ) )(@)(@@) الحكيم عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7675 ) قال النبي :(@)(@@) | 30 ( إن فيهم يعني قريشا لخصالا أربعة ، إنهم أصلح الناس عند فتنة ، وأسرعهم إقامة بعد مصيبة ، وأوشكهم كرة بعد فرة ، وخيرهم لمسكين ويتيم ، وأمنعهم من ظلم المملوك ) )(@)(@@) ( حل ) عن المستورد الفهري .(@)(@@)(@@)(@@) $ ( 7676 ) قال النبي :(@)(@@) | 30 ( إن قريشا أعطيت ما لم يعط الناس : أعطيت ما أمطرت السماء ، وما جرت به الأنهار ، وما سالت 
ms852	 به السيول ، ولمن مضى منهم خير ممن بقي ، ولا يزال رجل من قريش يتصدى لهاذا الأمر ، أما وايم الله لئن أطعتم قريشا لتقطعنكم في الأرض أسباطا ، أيها الناس اسمعوا قول قريش ولا تعملوا PageV03P124 بأعمالهم ) )(@)(@@) نعيم بن حماد في الفتن عن أبي الزاهرية مرسلا الديلمي عنه عن حليس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7677 ) قال النبي :(@)(@@) | 30 ( إن قصر الخطبة وطول الصلاة مئنة من فقه الرجل ، فأطيلوا الصلاة وأقصروا الخطبة ، فإن من البيان سحرا ، وإنه سيأتي بعدكم قوم يطيلون الخطبة ، ويقصرون الصلاة ) )(@)(@@) البزار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7678 ) قال النبي :(@)(@@) | 30 ( إن قلوب بني آدم بين إصبعين من أصابع الله عز وجل ، فإذا شاء صرفه ، وإذا شاء بصره ) )(@)(@@) ابن خزيمة عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7679 ) قال النبي :(@)(@@) | 30 ( إن قلوب بني آدم بين إصبعين من أصابع الرحمان كقلب واحد يقول بها هاكذا ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7680 ) قال النبي :(@)(@@) | 30 ( إن قوائم منبري رواتب في الجنة ) )(@)(@@) ( طب ) عن أبي واقد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7681 ) قال النبي :(@)(@@) | 30 ( إن قول لا حول ولا قوة إلا بالله تدفع عن قائلها تسعا وتسعين بابا أدناها الهم ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7682 ) قال النبي :(@)(@@) | 30 ( إن قول لا إلاه إلا الله والله أكبر والحمد لله وسبحان الله تحط الخطايا كما يحط ورق هاذه الشجرة ، خذهن يا أبا الدرداء قبل أن يحال بينك وبينهن فإنهن الباقيات الصالحات وهن من كنوز الجنة ) )(@)(@@) ابن عساكر عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7683 ) قال النبي :(@)(@@) | 30 ( إن قول لا إلاه إلا الله وسبحان الله والحمد لله والله أكبر يحططن الخطايا كما يتحاث ورق هاذه الشجرة ) )(@)(@@) ابن صصرى في أماليه عن أبي سعيد رضي الله عنه .(@)(@@) PageV03P125(@)(@@)(@@)(@@) $ ( 7684 ) قال النبي :(@)(@@) | 30 ( إن قوما يشربون الخمر يسمونها بغير اسمها ) )(@)(@@) ( ابن قانع ) عن حجر ابن عدي بن الأدبر الكندي .(@)(@@)(@@)(@@) $ ( 7685 ) قال النبي :(@)(@@) | 30 ( إن قوما كانوا أهل ضعف ومسكنة قاتلهم أهل تجبر وعداوة فأظهرهم الله 
ms853	 عليهم يعني أهل الضعف فعمدوا إلى أهل التجبر وهم عدوهم فاستعملوهم وسلطوهم ، فأسخطوا الله عليهم إلى يوم القيامة ) )(@)(@@) ( حم ع ) و ابن مردويه ( ض ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7686 ) قال النبي :(@)(@@) | 30 ( إن قوما يخرجون من النار بالشفاعة ) ( ط ) عن ج$ ابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7687 ) قال النبي :(@)(@@) | 30 ( إن قوما أحبوا قوما حتى هلكوا في حبهم فلا تكونوا مثلهم ، وإن قوما أبغضوا قوما حتى هلكوا في بغضهم ، فلا تكونوا مثلهم ) )(@)(@@) الديلمي عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7688 ) قال النبي :(@)(@@) | 30 ( إن قومك حين بنوا البيت قصرت بهم النفقة فتركوا بعض البيت في الحجر ، فإذهبي فصلي في الحجر ركعتين ) )(@)(@@) ( هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7689 ) قال النبي :(@)(@@) | 30 ( إن قوما يحبوني فاعطيهم ما يتأبطون إلا النار ، قيل : لم تعطيهم ؟ قال : إنهم يخيروني بين أن أعطيهم أو أبخل وإني لست ببخيل ، وإن الله لم يرض لي البخل ) )(@)(@@) الخرائطي في مكارم الأخلاق عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7690 ) قال النبي :(@)(@@) | 30 ( إن قومك استقصروا من بنيان الكعبة ، ولولا حداثة عهدهم بالشرك أعدت فيه ما تركوا منه ، ( سقط : فهل لي أريك ما تركوا منه ، ) PageV03P126 فلما أراها قريبا من سبع أذرع في الحجر ، ولجعلت لها بابين موضوعين في الأرض شرقيا وغربيا ، أتدرين لم كان قومك رفعوا بابها ؟ تعززا أن لا يدخلها إلا من أرادوا ، وكان الرجل إذا كرهوا أن يدخل يدعونه حتى إذا كاد أن يدخل رفعوه حتى يسقط ) )(@)(@@) ابن سعد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7691 ) قال النبي :(@)(@@) | 30 ( إن كرسيه وسع السماوات والأرض ، وإن له أطيطا كأطيط الرحل الجديد إذا ركب من قلة ) )(@)(@@) ( بز ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7692 ) قال النبي :(@)(@@) | 30 ( إن كسوف الشمس آية من آيات الله ، فإذا رأيتم ذالك فافزعوا إلى الصلاة ) )(@)(@@) ( ش ) عن عبد الرحمان بن أبي ليلى قال : حدثني فلان ابن فلان .(@)(@@)(@@)(@@) $ ( 7693 ) قال النبي :(@)(@@) | 30 ( إن كل جارية بها حبل ، حرام على صاحبها حتى تضع ما في بطنها ، وإن كل 
ms854	 حمار يعتمل عليه حرام لحمه ، وإن الثوم حرام ، ثم إن النبي أحل الثوم وأمر من أكله أن لا يخرج إلى المسجد حتى يذهب ريحه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7694 ) قال النبي :(@)(@@) | 30 ( إن كل فحل يمذي ، فإذا كان المني ففيه الغسل ، وإذا كان المذي ففيه الوضوء ) )(@)(@@) ( ش ) عن المقداد بن الأسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7695 ) قال النبي :(@)(@@) | 30 ( إن كلبة كانت في بني إسرائيل تنبح ، فضاف أهلها ضيف ، فقالت : لا أنبح ضيفنا الليلة فعوا جراؤها في بطنها ، فأوحى إلى رجل منهم إن مثل هاذه الكلبة مثل أمة يأتون من بعدكم ، يستعلي سفهاؤها على علمائها ) )(@)(@@) ( طس ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7696 ) قال النبي :(@)(@@) | 30 ( إن لابراهيم ظئرا في الجنة يتم رضاعه ) )(@)(@@) ابن عساكر عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7697 ) قال النبي :(@)(@@) | 30 ( إن لأبي طالب عندي رحما سأبلها ببلالها ) )(@)(@@) ابن عساكر عن عمرو بن العاص رضي الله عنه .(@)(@@) PageV03P127(@)(@@)(@@)(@@) $ ( 7698 ) قال النبي :(@)(@@) | 30 ( إن لأحدكم ثلاثة أخلاء ، منهم من يمتعه بما سأله فذالك ماله ، ومنهم خليل ينطلق معه حتى يلج القبر ولا يعطيه شيئا ولا يصحبه بعد ذالك فاولائك قريبه ، ومنهم خليل يقول : أنا والله ذاهب معك حيث ذهبت ولست مفارقك فذالك عمله ، إن كان خيرا ، وإن كان شرا ) )(@)(@@) ( طب ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7699 ) قال النبي :(@)(@@) | 30 ( إن لأهل الجنة سوقا يأتونها كل جمعة ، فيها كثبان المسك ، فإذا خرجوا إليها هبت الريح فتملا وجوههم وثيابهم وبيوتهم مسكا فيزدادون حسنا وجمالا ، فيأتون أهلهم فيقول لهم أهلوهم : لقد ازددتم بعدنا حسنا وجمالا ، ويقولون لهم : وأنتم والله لقد ازددتم بعدنا حسنا وجمالا ) )(@)(@@) ( حم م ) و الدارمي وأبو عوانة ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7700 ) قال النبي :(@)(@@) | 30 ( إن لبني العباس رايتين أعلاها كفر ومركزها ضلالة ، فإن أدركتها فلا تضل ) )(@)(@@) ( طب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7701 ) قال النبي :(@)(@@) | 30 ( إن لبني أبي طالب عندي رحما سأبلها ببلالها ) )(@)(@@) ( طب ) عن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7702 ) قال النبي :(@)(@@) | 30 
ms855	 ( إن لجعفر بن أبي طالب جناحين يطير بهما في الجنة مع الملائكة ) )(@)(@@) ابن سعد عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7703 ) قال النبي :(@)(@@) | 30 ( إن لجهنم بابين أحدهما يسمى الجوانية ، والآخر يسمى البرانية ، فأما الجوانية فالتي لا يخرج منها أحد ، وأما البرانية فالتي يعذب الله تعالى فيها أهل الذنوب والموجبات من أهل الإيمان ما شاء الله أن يعذبهم ، ثم يأذن الله للملائكة والرسل والأنبياء ولمن شاء من عباده الصالحين فيشفعون فيخرجون PageV03P128 منها وهم فحم ، فيلقون على شاطىء نهر في الجنة يسمى نهر الحيوان ، فينضح عليهم فينبتون كما تنبت الحبة في الحميل ، فإذا استوت أجسادهم قيل : ادخلوا النهر ، فيدخلون فيشربون منه ويغتسلون فيخرجون فيقال لهم ادخلوا الجنة ) )(@)(@@) ( هناد ) عن أبي سعيد وأبي هريرة رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 7704 ) قال النبي :(@)(@@) | 30 ( إن لحوم الحمر الآيسة لا تحل لمن شهد أني رسول الله ) )(@)(@@) ( حم ) عن أبي ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7705 ) قال النبي :(@)(@@) | 30 ( إن لقمان قال لابنه : يا بني عليك بمجالس العلماء ، واستمع كلام الحكماء ، فإن الله عز وجل يحي القلب الميت بنور الحكمة كما تحيى الأرض الميتة بوابل المطر ) )(@)(@@) ( طب ) و الرامهرمزي في الأمثال عن أبي أمامة رضي الله عنه وسنده ضعيف أن لقمان كان عبدا .(@)(@@)(@@)(@@) $ ( 7706 ) قال النبي :(@)(@@) | 30 ( إن لك نصيب رجل ممن شهد بدرا وسهمه ) )(@)(@@) ( خ ) عن ابن عمر قال : إنما تغيب عثمان رضي الله عنه عن بدر ، فإنه كان تحته بنت رسول الله وكانت مريضة فقال له فذكره .(@)(@@)(@@)(@@) $ ( 7707 ) قال النبي :(@)(@@) | 30 ( إن لكم في كل جمعة حجة وعمرة ، فالحجة الهجير للجمعة ، والعمرة انتظار العصر بعد الجمعة ) )(@)(@@) ( عد هق ) وضعفه عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7708 ) قال النبي :(@)(@@) | 30 ( إن لكل أمة رهبانية ، ورهبانية هاذه الأمة الجهاد في سبيل الله ) )(@)(@@) ( هب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7709 ) قال النبي :(@)(@@) | 30 ( إن لكل أمة مجوسا ، وإن مجوس أمتي هاذه القدرية ) )(@)(@@) الشيرازي في الألقاب عن جعفر بن محمد عن أبيه عن جده .(@)(@@) PageV03P129(@)(@@)(@@)(@@) $ ( 7710 ) قال النبي :(@)(@@) | 30 ( إن 
ms856	 لكل آدمي حظا من النار ، وحظ المؤمن منها الحمي تحرق جلده ولا تحرق جوفه وهي حظه منها ) )(@)(@@) ( هناد ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 7711 ) قال النبي :(@)(@@) | 30 ( إن لكل بني أب عصبة ينتمون إليها إلا ولد فاطمة فأنا وليهم وأنا عصبتهم وهم عترتي خلقوا من طينتي ، ويل للمكذبين بفضلهم ، من أحبهم أحبه الله ، ومن أبغضهم أبغضه الله ) )(@)(@@) ( ك ) و ابن عساكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7712 ) قال النبي :(@)(@@) | 30 ( إن لكل دين خلقا ، وإن خلق هاذا الدين الحياء ) )(@)(@@) البغوي عن يزيد بن ركانة عن أبيه ، الخرائطي في مكارم الأخلاق عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7713 ) قال النبي :(@)(@@) | 30 ( إن لكل شيء بابا يدخل منه ، وإن مدخل القبر من نحو الرجلين ) )(@)(@@) ابن عساكر عن خالد بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7714 ) قال النبي :(@)(@@) | 30 ( إن لكل شيء شرفا ، وإن أشرف المجالس ما استقبل به القبلة ، وإنما تجالسون بالأمانة فلا تصلوا خلف النائم والمحدث ، واقتلوا الحية والعقرب وإن كنتم في صلاتكم ، ولا تستروا الجدر بالثياب ، ومن نظر في كتاب أخيه بغير إذن أخيه ، فكأنما نظر في النار ، ومن أحب أن يكون أكرم الناس فليتق الله ، ومن أحب أن يكون أقوى الناس فليتوكل على الله ، ومن أحب أن يكون أغنى الناس فليكن بما في يد الله عز وجل أوثق منه بما في يديه ، ألا أنبئكم بشراركم ؟ من نزل وحده ومنع رفده ، وجلد عبده ، أفلا أنبئكم بشر من هاذا ؟ من يبغض الناس ويبغضونه ، أفلا أنبئكم بشر من هاذا ؟ من لا يقيل عثرة ، ولا يقبل معذرة ، ولا يغفر ذنبا ، أفلا أنبئكم بشر من هاذا ؟ من لا يرجى خيره ، ولا يؤمن PageV03P130 شره ، إن عيسى بن مريم قام في قومه فقال : يا بني إسرائيل لا تكلموا بالحكمة عند الجهال فتظلموها ، ولا تمنعوها أهلها فتظلموها ، ولا تظالموا ، ولا تكافئوا ظالما فيبطل فضلكم عند ربكم ، يا بني إسرائيل إنما الأمر ثلاثة : أمر تبين رشده فاتبعوه ، وأمر تبين غيه فاجتنبوه ، وأمر اختلف فيه فردوه إلى الله عز وجل ) )(@)(@@) ( طب عق ك 
ms857	 ) وتعقب ( هق ) و ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7715 ) قال النبي :(@)(@@) | 30 ( إن لكل شيء سناما ، وإن سنام القرآن سورة البقرة ) )(@)(@@) ( ك هب ) عن أبي هريرة ( ك ) عن ابن مسعود رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 7716 ) قال النبي :(@)(@@) | 30 ( إن لكل شيء خلقا ، وإن خلق الإسلام الحياء ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7717 ) قال النبي :(@)(@@) | 30 ( إن لكل صداء جلاء وإن جلاء القلوب الاستغفار ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7718 ) قال النبي :(@)(@@) | 30 ( إن لكل عمل شرة ، وإن لكل شرة فترة ، فمن كانت شرته إلى سنتي فقد أفلح ، ومن كانت شرته إلى غير ذالك فقد هلك ) )(@)(@@) ( حب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7719 ) قال النبي :(@)(@@) | 30 ( إن لكل عمل شرة ، والشرة إلى الفترة ، فمن كانت فترته إلى سنتي فقد اهتدى ، ومن كانت فترته إلى غير ذالك فقد ضل ) )(@)(@@) البزار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7720 ) قال النبي :(@)(@@) | 30 ( إن لكل قوم مادة ، ومادة قريش مواليهم ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 7721 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي يوم القيامة منبرا من نور الحديث بطوله PageV03P131 في الشفاعة ) )(@)(@@) ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7722 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي دعوة تعجلها في الدنيا ، وإني اختبأت دعوتي شفاعة لأمتي يوم القيامة للمذنبين ) )(@)(@@) الخطيب عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7723 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي حواري ، وأنتما حواري ، قاله لطلحة والزبير رضي الله عنهما ) )(@)(@@) ( طب ) عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7724 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي حواري ، وإن حواري الزبير وابن عمتي ) )(@)(@@) أبو نعيم عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7725 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي منبرا من نور يوم القيامة ، وإن لعلي أطولها وأنورها ) )(@)(@@) ( الضياء المقدسي المختارة ) .(@)(@@)(@@)(@@) $ ( 7726 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي تركة أو ضيعة وإن الأنصار تركتي وضيعتي ، وإن الناس يكثرون ويقلون ، فاقبلوا من محسنهم ، واعفوا عن مسيئهم ) )(@)(@@) ابن سعد عن النعمان 
ms858	 بن مرة بلاغا .(@)(@@)(@@)(@@) $ ( 7727 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي رفيقا ، وإن رفيقي في الجنة عثمان ) )(@)(@@) الخطيب في المتفق ( كر ) عن طلحة بن عبيد الله رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7728 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي رفيقا في الجنة ورفيقي فيها عثمان بن عفان ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7729 ) قال النبي :(@)(@@) | 30 ( إن لكل نبي حرما ، وحرمي المدينة ، اللهم إني أحرمها بحرمتك ، لا يوافيها محدث ، ولا يختلى خلاها ، ولا تؤخذ لقطتها إلا لمنشد ) )(@)(@@) ابن جرير عن ابن عباس رضي الله عنهما .(@)(@@) PageV03P132(@)(@@)(@@)(@@) $ ( 7730 ) قال النبي :(@)(@@) | 30 ( إن لكم في كل جمعة حجة وعمرة ، فالحجة الهجيرة للجمعة ، والعمرة انتظاره العصر بعد الجمعة ) )(@)(@@) ( هب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7731 ) قال النبي :(@)(@@) | 30 ( إن لك في مالك ثلاث شركاء أنت والتلف والوارث ، فإن استطعت أن لا تكون أعجزهم فافعل ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7732 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى عبادا ليسوا بأنبياء ولا شهداء ، يغبطهم النبيون والشهداء بقربهم ومقعدهم من الله يوم القيامة ، عباد من عباد الله من بلدان شتى ، وقبائل من شعوب أرحام القبائل ، لم يكن بينهم أرحام يتواصلون بها ، ولا دنيا يتباذلون بها ، يتحابون بروح الله ، يجعل الله وجوههم نورا ، يجعل لهم منابر من لؤلؤ قدام الرحمان تعالى ، يفزع الناس ولا يفزعون ، ويخاف الناس ولا يخافون ) )(@)(@@) ( حم طب هق ) في الأسماء عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7733 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل عبادا يجلسهم يوم القيامة على منابر من نور ، ويغشى وجوههم النور ، حتى يفرغ من حساب الخلائق ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7734 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى جلساء يوم القيامة عن يمين العرش ، وكلتا يدي الله يمين ، على منابر من نور ، وجوههم من نور ، ليسوا بأنبياء ولا شهداء ولا صديقين ، هم المتحابون بجلال الله عز وجل ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7735 ) قال النبي :(@)(@@) | 30 ( إن لله تعالى عبادا ليسوا بأنبياء ولا 
ms859	 شهداء ، يغبطهم النبيون والشهداء يوم القيامة ، يقربهم ويجلسهم منه ، قوم من أفناء الناس من نزاع القبائل ، تصافوا في الله وتحابوا فيه ، يضع الله لهم يوم القيامة منابر من نور فيجلسهم ، يخاف الناس ولا يخافون ، هم أولياء الله لا خوف عليهم ولا هم PageV03P133 يحزنون ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7736 ) قال النبي :(@)(@@) | 30 ( إن لله عبادا يضن بهم عن الأمراض والأسقام في الدنيا ، يحييهم في عافية ويميتهم في عافية ، ويدخلهم الجنة في عافية ) )(@)(@@) الحكيم عن شهر بن حوشب مرسلا .(@)(@@)(@@)(@@) $ ( 7737 ) قال النبي :(@)(@@) | 30 ( إن لله عبادا يضن بهم عن البلاء ، يحييهم في عافية ، ويدخلهم الجنة في عافية ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7738 ) قال النبي :(@)(@@) | 30 ( إن لله عبادا على منابر من نور في ظل العرش يوم القيامة ، يغبطهم النبيون والشهداء وهم المتحابون في الله عز وجل ) )(@)(@@) ابن أبي الدنيا في كتاب الإخوان عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7739 ) قال النبي :(@)(@@) | 30 ( إن لله عبادا اختصهم بالنعم لمنافع العباد ، فمن بخل بتلك المنافع على عباد الله ، نقل الله تلك النعم عنهم وحولها إلى غيرهم ) )(@)(@@) تمام عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 7740 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل سرايا من الملائكة تحل وتقف على مجالس الذكر في الأرض فارتعوا في رياض الجنة ، قالوا : وأين رياض الجنة ؟ قال : مجالس الذكر فاغدوا وروحوا في ذكر الله واذكروه بأنفسكم ، من كان يحب أن يعلم منزلته عند الله فلينظر كيف منزلة الله عنده ، فإن الله تعالى ينزل العبد منه حيث أنزله من نفسه ) )(@)(@@) عبد بن حميد والحكيم ( ك ) وابن شاهين في الترغيب في الذكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7741 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل حرمات ثلاث من حفظهن حفظ الله له أمر دينه ودنياه ، ومن لم يحفظهن لم يحفظ الله له شيئا : حرمة الإسلام ، وحرمتي ، وحرمة رحمي ) )(@)(@@) ( طب ) و أبو نعيم عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7742 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل تسعة 
ms860	 وتسعين اسما من أحصاها أو PageV03P134 دعا بها دخل الجنة ) )(@)(@@) ابن مردويه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7743 ) قال النبي :(@)(@@) | 30 ( إن لله مائة اسم غير اسم ، من دعا بها استجاب الله له ) )(@)(@@) ابن مردويه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7744 ) قال النبي :(@)(@@) | 30 ( إن لله تسعة وتسعين اسما كلهن في القرآن ، من أحصاهن دخل الجنة ) )(@)(@@) ابن جرير عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7745 ) قال النبي :(@)(@@) | 30 ( إن لله على كل مسلم من كل سبعة أيام يوما يغسل كل شيء منه ، وأن يستن ، وأن يمس طيبا إن كان له ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7746 ) قال النبي :(@)(@@) | 30 ( إن لله سيفا لا يسله على عباده حتى يسلوه على أنفسهم ، فإذا سلوه على أنفسهم لم يغمد عنهم إلى يوم القيامة ) )(@)(@@) ( ك ) في تاريخه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7747 ) قال النبي :(@)(@@) | 30 ( إن لله ما أخذ وله ما أعطى ، وكل شيء عنده بأجل مسمى فمرها فلتصبر ولتحتسب ) )(@)(@@) ( ط حم خ م د ن ه حب ) عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7748 ) قال النبي :(@)(@@) | 30 ( إن لله ملائكة يمشون مع الجنازة يقولون : سبحان من تعزز بالقدرة ، وقهر العباد بالموت ) )(@)(@@) الرافعي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 7749 ) قال النبي :(@)(@@) | 30 ( إن لله ملائكة ترعد فرائصهم من مخافته ، ما منهم ملك يقطر من عينيه دمعة إلا وقعت ملكا قائما يسبح ، وملائكة سجودا منذ خلق الله السماوات والأرض لم يرفعوا رؤوسهم ولا يرفعونها إلى يوم القيامة ، وصفوفا لم ينصرفوا عن مصافهم ولا ينصرفون إلى يوم القيامة ، فإذا كان يوم القيامة تجلى لهم ربهم فنظروا إليه وقالوا : سبحانك ما عبدناك كما ينبغي لك ) )(@)(@@) أبو الشيخ في العظمة PageV03P135 ( هب ) والخطيب وابن عساكر عن رجل من الصحابة .(@)(@@)(@@)(@@) $ ( 7750 ) قال النبي :(@)(@@) | 30 ( إن لله عز وجل سيارة من الملائكة يتتبعون حلق الذكر ، فإذا مروا بحلق الذكر قال بعضهم لبعض : اقعدوا ، فإذا دعى القوم أمنوا على دعائهم ، فإذا صلوا على النبي صلوا 