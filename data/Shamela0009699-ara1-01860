ms1841	 المبارك، عن الحسن: {ولذلك خلقهم} [هود: 119] قال: «خلقهم للاختلاف»(@)(@@) PageV06P2096(@)(@@)(@@)(@@) | قوله تعالى: {وتمت كلمة ربك لأملأن جهنم من الجنة والناس أجمعين} (@)(@@) [هود: 119](@)(@@) PageV06P2096(@)(@@)(@@)(@@) | 11299 - (@)(@@) حدثنا أبو سعيد الأشج، وعلي بن حرب الموصلي قالا: ثنا ابن فضيل، ثنا عطاء بن السائب، عن عون بن عبد الله، عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: " اختصمت الجنة والنار، فقالت الجنة: ما لي لا يدخلني إلا الضعفاء والمسكين، وقالت النار: ما لي لا يدخلني إلا الجبارون، والمتكبرون والأشراف، وأصحاب الأموال، فقال الله جل ذكره للجنة أنت رحمتي أدخلك من شئت، وقال للنار: أنت عذابي أعذب بك من شئت، وكلاهما سأملأ "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وكلا نقص عليك من أنباء الرسل} [هود: 120] الآية بياض(@)(@@) PageV06P2096(@)(@@)(@@)(@@) | قوله تعالى: {وجاءك في هذه الحق} (@)(@@) [هود: 120](@)(@@) PageV06P2096(@)(@@) حدثنا أبو سعيد الأشج ثنا أبو أسامة، عن أبي عوانة، عن أبي بشير، عن عمرو قال: خطبنا ابن عباس فقرأ: {وجاءك في هذه الحق} [هود: 120] قال: «هذه السورة»(@)(@@) PageV06P2096(@)(@@)(@@)(@@) | 11301 - (@)(@@) حدثنا أبي، ثنا محمد بن محمد، عن عبد الأعلى، ثنا محمد بن ثور، عن معمر، عن الأعمش، عن سعيد بن جبير قال: سمعت ابن عباس يقرأ هذه السورة على المنبر حتى إذا بلغ: {وجاءك في هذه الحق} [هود: 120] قال: «في هذه السورة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11302 - (@)(@@) حدثنا أبي سهل بن عثمان، ثنا عبيدة بن حميد، عن عطاء بن السائب، عن سعيد بن جبير قوله: {وجاءك في هذه الحق} [هود: 120] قال: «وجاءه في هذه السورة الحق»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني(@)(@@) PageV06P2096(@)(@@)(@@)(@@) | 11303 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا وكيع، عن شعبة قال: سمعت قتادة: {وجاءك في هذه الحق} [هود: 120] قال: «الدنيا»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11304 - (@)(@@) حدثنا أبي، ثنا هشام بن خالد، ثنا شعيب بن إسحاق، ثنا ابن أبي عروبة، عن قتادة: {وجاءك في هذه الحق} [هود: 120] قال الحسن: «في الدنيا»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وموعظة} (@)(@@) [البقرة: 66](@)(@@) PageV06P2097(@)(@@)(@@)(@@) | 11305 - (@)(@@) حدثنا الحسن بن أبي الربيع، ثنا عبد الرزاق، أخبرني الثوري، عن بيان، عن الشعبي قوله: {وموعظة} [هود: 120] قال: «موعظة من الجهل»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وذكرى للمؤمنين} (@)(@@) [الأعراف: 2](@)(@@) PageV06P2097(@)(@@)(@@)(@@) | 11306 - (@)(@@) حدثنا أبي، ثنا هشام 
ms1842	 بن عمار، ثنا الوليد بن مسلم، ثنا خليد، عن قتادة قال: المؤمنين " هم العجاجون بالليل والنهار والله ما زالوا يقولون: ربنا، حتى استجيب لهم " قد تقدم تفسير المؤمن غير مرة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {على مكانتكم} (@)(@@) [الأنعام: 135](@)(@@) PageV06P2097(@)(@@)(@@)(@@) | 11307 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا الحازمي، عن جويبر، عن الضحاك: {اعملوا على مكانتكم} [هود: 121] «على ناحيتكم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11308 - (@)(@@) حدثنا علي بن الحسن، ثنا أبو الجماهر، ثنا سعيد بن بشر، عن قتادة قوله: {اعملوا على مكانتكم} [هود: 121] «أي منازلكم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وانتظروا إنا منتظرون} (@)(@@) [هود: 122](@)(@@) PageV06P2097(@)(@@)(@@)(@@) | 11309 - (@)(@@) حدثنا أبي، ثنا أحمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن أبي جعفر الرازي، عن أبيه، عن الربيع في قوله: {وانتظروا} [هود: 122] قال: «خوفهم عذابه، وعقوبته ونقمته»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ولله غيب السموات والأرض وإليه يرجع الأمر كله}(@)(@@) PageV06P2097(@)(@@)(@@)(@@) | 11310 - (@)(@@) حدثنا عصام بن رواد، ثنا آدم، ثنا أبو جعفر، عن الربيع بن أنس، عن أبي العالية قال: «يرجعون إليه بعد الحياة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فاعبده وتوكل عليه وما ربك بغافل عما تعملون} (@)(@@) [هود: 123](@)(@@) PageV06P2097(@)(@@)(@@)(@@) | 11311 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير في قول الله تعالى: (عما يعملون) يعني: «بما يكون»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | سورة يوسف (@)(@@) أول السورة التي يذكر فيها يوسف عليه الصلاة والسلام، بسم الله الرحمن الرحيم(@)(@@) PageV06P2097(@)(@@)(@@)(@@) | قوله عز وجل: {الر} (@)(@@) [يونس: 1](@)(@@) PageV07P2098(@)(@@)(@@)(@@) | 11312 - (@)(@@) حدثنا أبي، ثنا أبو غسان، ثنا شريك، ثنا عطاء بن السائب، قال شريك: لا أراه إلا، عن أبي الضحى يعني: مسلم بن صبيح، عن ابن عباس: {الر} [يوسف: 1] قال: «أنا الله، أرى» وروي عن الضحاك، مثله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني:(@)(@@) PageV07P2098(@)(@@)(@@)(@@) | 11313 - (@)(@@) حدثنا علي بن الحسين، ثنا هدبة بن عبد الوهاب، ثنا علي بن الحسين بن واقد، عن أبيه، عن يزيد النحوي، عن عكرمة، عن ابن عباس: {الر} [يوسف: 1] : «حروف الرحمن مفرقه» ، فحدثت به الأعمش فقال: «عندك مثل هذا ولا تخبرناه»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11314 - (@)(@@) حدثنا الحجاج بن حمزة، ثنا يحيى بن آدم، ثنا مندل العنزي، عن عطاء بن السائب، عن 
ms1843	 سعيد بن جبير، أنه قال: " {الر} [يوسف: 1] و {حم} [غافر: 1] و {ن} [القلم: 1] هو الرحمن مقطع ". وروي عن سالم بن عبد الله، مثله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث:(@)(@@) PageV07P2098(@)(@@)(@@)(@@) | 11315 - (@)(@@) حدثنا أبي، ثنا محمد بن عبد الأعلى، ثنا محمد بن ثور، عن معمر، عن قتادة، قال: " {الر} [يوسف: 1] اسم من أسماء القرآن "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الرابع:(@)(@@) PageV07P2098(@)(@@)(@@)(@@) | 11316 - (@)(@@) حدثنا أبي، ثنا عثمان، ثنا يحيى بن أبي زائدة، قال ابن جريج: قال مجاهد: " {الر} [يوسف: 1] قال: هذا فواتح يفتتح الله بها القرآن، قال: قلت: ألم تكن تقول هي أسماء؟ قال: لا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {تلك آيات} (@)(@@) [البقرة: 252](@)(@@) PageV07P2098(@)(@@)(@@)(@@) | 11317 - (@)(@@) حدثنا أبو بكر بن أبي موسى، ثنا هارون بن حاتم، ثنا عبد الرحمن بن أبي حماد، ثنا أسباط، عن السدي، عن أبي مالك، قوله: {تلك} [يوسف: 1] يعني: هذه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {الكتاب} (@)(@@) [البقرة: 2](@)(@@) PageV07P2099(@)(@@)(@@)(@@) | 11318 - (@)(@@) حدثنا الحسن بن محمد الصباح، ثنا أسباط بن محمد، عن أبي بكر الهذلي، عن الحسن، في قول الله: " {الكتاب} [يوسف: 1] قال: القرآن " وروي عن عطية، عن ابن عباس، نحو ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {المبين} (@)(@@) [المائدة: 92](@)(@@) PageV07P2099(@)(@@)(@@)(@@) | 11319 - (@)(@@) حدثنا علي بن الحسن الهسنجاني، ثنا أبو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {الر تلك آيات الكتاب المبين} [يوسف: 1] أي: والله المبين بركته وهداه، ورشده "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إنا أنزلناه} (@)(@@) [يوسف: 2](@)(@@) PageV07P2099(@)(@@)(@@)(@@) | 11320 - (@)(@@) حدثنا أبي، ثنا عبد الله بن رجاء، أنا عمران أبو العوام القطان، عن قتادة، عن أبي المليح، عن واثلة بن الأسقع: أن النبي صلى الله عليه وسلم قال: «أنزل القرآن لأربع وعشرين خلت من رمضان»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {قرآنا عربيا} (@)(@@) [يوسف: 2](@)(@@) PageV07P2099(@)(@@)(@@)(@@) | 11321 - (@)(@@) حدثنا علي بن الحسين، ثنا عبد الرحيم الرزيقي، ثنا زيد بن الحباب، حدثني سيف بن سليمان، قال: سمعت مجاهدا، يقول: «نزل القرآن بلسان قريش، وهو كلامهم»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {لعلكم تعقلون} (@)(@@) [البقرة: 73](@)(@@) PageV07P2099(@)(@@)(@@)(@@) | 11322 - (@)(@@) حدثنا أبو زرعة، ثنا يحيى بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {لعلكم} [يوسف: 2] يعني: لكي "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {نحن نقص عليك أحسن القصص} (@)(@@) [يوسف: 3](@)(@@) PageV07P2099(@)(@@)(@@)(@@) | 11323 - (@)(@@) حدثنا أبو 
ms1844	 يحيى محمد بن سعيد بن غالب العطار، ثنا عمرو بن محمد العنقزي، ثنا خلاد وهو ابن مسلم الصفار، عن عمرو بن قيس الملائي، عن عمرو بن مرة، عن مصعب بن سعد، عن سعد، قال: " نزل على رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) | [ص: 2100](@)(@@) القرآن، فتلاه عليهم زمانا فقالوا: يا رسول الله، لو قصصت علينا، فأنزل الله: {الر تلك آيات الكتاب المبين} [يوسف: 1] إلى قوله: {نحن نقص عليك أحسن القصص} [يوسف: 3] فتلاه عليهم زمانا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11324 - (@)(@@) حدثنا أبي، ثنا إسماعيل بن الخليل، ثنا علي بن مسهر، عن عبد الرحمن بن إسحاق، عن خليفة بن قيس، عن خالد بن عرفطة، قال: كنت عند عمر بن الخطاب إذ أتى برجل من عبد القيس، مسكنه بالسوس، فقال له عمر: أنت فلان ابن فلان العبدي؟ قال: نعم، قال: وأنت النازل بالسوس، فضربه بقناة معه فقال العبدي: ما لي؟ فقرأ عليه: {الر تلك آيات الكتاب المبين} [يوسف: 1] إلى قوله: {وإن كنت من قبله لمن الغافلين} [يوسف: 3] فقرأها عليه ثلاث مرات فضربه ثلاث مرات، ثم قال له عمر: أنت الذي انتسخت كتاب دانيال؟ قال: نعم. قال: اذهب فامحه بالحميم والصوف الأبيض، ولا تقرأه ولا تقرئه أحدا من الناس "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11325 - (@)(@@) حدثنا أبي، ثنا محمد بن أبي عمر العدني، ثنا سفيان، عن المسعودي، عن القاسم، قال: " مل أصحاب رسول الله صلى الله عليه وسلم ملة فقالوا: حدثنا يا رسول الله، فأنزل الله: {نحن نقص عليك أحسن القصص} [يوسف: 3] ثم ملوا ملة. فقالوا: يا رسول الله: حدثنا فنزلت: {الله نزل أحسن الحديث} [الزمر: 23] ثم ملوا ملة، فقالوا: حدثنا يا رسول الله فأنزل الله: {ألم يأن للذين آمنوا أن تخشع قلوبهم لذكر الله} [الحديد: 16] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11326 - (@)(@@) حدثنا علي بن الحسن، ثنا أبو الجماهر، أنا سعيد بن بشير، عن قتادة، قوله: " {نحن نقص عليك أحسن القصص} [يوسف: 3] قال: في الكتب الماضية وأمور الله السالفة في الأمم {بما أوحينا إليك هذا القرآن} [يوسف: 3] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وإن كنت من قبله لمن الغافلين} (@)(@@) [يوسف: 3](@)(@@) PageV07P2100(@)(@@)(@@)(@@) | 11327 - (@)(@@) وبه، عن 
ms1845	 قتادة: {وإن كنت من قبله لمن الغافلين} [يوسف: 3] أي: من قبل هذا القرآن "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إذ قال يوسف لأبيه يا أبت إني رأيت أحد عشر كوكبا} (@)(@@) [يوسف: 4](@)(@@) PageV07P2101(@)(@@)(@@)(@@) | 11328 - (@)(@@) حدثنا أحمد بن سنان الواسطي، ثنا أبو أحمد الزبيري، ثنا سفيان، عن سماك، عن سعيد بن جبير، عن ابن عباس، قوله: " {إني رأيت أحد عشر كوكبا} [يوسف: 4] قال: كانت رؤيا الأنبياء وحيا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أحد عشر كوكبا} (@)(@@) [يوسف: 4](@)(@@) PageV07P2101(@)(@@)(@@)(@@) | 11329 - (@)(@@) حدثنا علي بن الحسين، ثنا أبو الجماهر، أنا سعيد بن بشير، عن قتادة: قوله: " {إذ قال يوسف لأبيه يا أبت إني رأيت أحد عشر كوكبا} [يوسف: 4] أي: إخوته. وروي عن السدي مثل ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11330 - (@)(@@) حدثنا أبو يزيد القراطيسي، فيما كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن يزيد بن أسلم، في قوله: " {إني رأيت أحد عشر كوكبا والشمس والقمر رأيتهم لي ساجدين} [يوسف: 4] قال: أبواه وإخوته فبغاه إخوته، وكانوا أنبياء، فقالوا: ما رضي أن يسجد له إخوته، حتى سجد له أبواه، حين بلغهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {والشمس والقمر} (@)(@@) [الأنعام: 96](@)(@@) PageV07P2101(@)(@@)(@@)(@@) | 11331 - (@)(@@) حدثنا علي بن الحسين، ثنا أبو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {والشمس والقمر} [يوسف: 4] قال: والشمس: يعقوب، والقمر: أم يوسف، راحيل {رأيتهم لي ساجدين} [يوسف: 4] " وروي، عن السدي مثل ذلك(@)(@@) PageV00P000(@)(@@) قال الحسن بن عرفة، ثنا الحكم بن ظهير، عن السدي، عن عبد الرحمن بن سابط، عن جابر بن عبد الله، قال: أتى النبي صلى الله عليه وسلم، رجل من اليهود، يقال له: بستاني، فقال: يا محمد أخبرني عن الكواكب التي رآها يوسف أنها ساجدة له ما أسماؤها؟ فلم يجبه نبي الله صلى الله عليه وسلم بشيء، ونزل جبريل عليه السلام فأخبر النبي صلى الله عليه وسلم بأسمائها. قال: فبعث النبي صلى الله عليه وسلم إلى بستاني، فلما جاء قال له: «هل أنت مؤمن إن أخبرتك بأسمائها؟» قال: نعم. قال: " جربان وطارق والذيال وذو الكتفين وقابس(@)(@@) PageV07P2101(@)(@@) ودثاب وعمودان والفليق والمصبح والضروح وذو الفرع والضياء والنور، رآها ساجدة له في 
ms1846	 أفق السماء، فلما قصها يوسف على يعقوب، قال يعقوب: هذا أمر مشتت يجمعه الله من بعده. قال: يقول بستاني: أي والله هذه لأسماؤها "(@)(@@) PageV07P2102(@)(@@)(@@)(@@) | قوله تعالى: {قال يا بني لا تقصص رؤياك على إخوتك فيكيدوا لك كيدا} (@)(@@) [يوسف: 5](@)(@@) PageV07P2102(@)(@@)(@@)(@@) | 11333 - (@)(@@) حدثنا عبد الله بن سليمان بن الأشعث، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، ثنا أسباط، عن السدي، قال: " فكان الغلامان يوسف وبنيامين في حجر يعقوب، أحبهما وعطف عليهما ليتمهما من أمهما، وكان أحب الخلق إليه يوسف، فلما قدموا نحو الشام قال يعقوب لرعاته وغلمانه: إن أتاكم أحد يسألكم: من أنتم فقولوا: نحن ليعقوب عبد عيصا، فلقيهم عيصا فقال: من أنتم؟ فقالوا نحن ليعقوب عبد عيصا، قال: فكف، عن يعقوب، فذلك حين قال: وإذ غلبتني على الدعوة فلا تغلبني على القبر، فنزل يعقوب الشام فكان ليس له هم إلا يوسف وأخاه فحسده إخوته مما رأوا من حب أبيه له ورأى يوسف في النوم رؤيا أن {أحد عشر كوكبا والشمس والقمر رأيتهم لي ساجدين} [يوسف: 4] فحدث أباه بها فقال له يعقوب {يا بني لا تقصص رؤياك على إخوتك فيكيدوا لك كيدا} [يوسف: 5] فبلغ إخوة يوسف الرؤيا فحسدوه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11334 - (@)(@@) حدثنا محمد بن العباس، مولى بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن إسحاق: يقول الله عز وجل في كتابه، لمحمد، صلى الله عليه وسلم، وهو يذكر له خبر يوسف وإخوته: " {إذ قال يوسف لأبيه يا أبت إني رأيت أحد عشر كوكبا} [يوسف: 4] الآية، فعرف يعقوب تأويلها، وخشي عليه بغي إخوته فيما عرف من التأويل أن الشمس والقمر والأحد عشر كوكبا أبوه وأمه وإخوته، فقال: {يا بني لا تقصص رؤياك على إخوتك فيكيدوا لك كيدا إن الشيطان للإنسان عدو مبين} [يوسف: 5] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11335 - (@)(@@) حدثنا محمد بن يحيى، أنا العباس بن الوليد النرسي، ثنا يزيد بن(@)(@@)(@@)(@@) | [ص: 2103](@)(@@) زريع، عن سعيد، عن قتادة، قوله: " {إن الشيطان للإنسان عدو مبين} [يوسف: 5] قال: عادوه، فإنه يحق على كل مسلم عداوته، وعداوته، أن تعاديه 
ms1847	 بطاعة الله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وكذلك} (@)(@@) [البقرة: 143](@)(@@) PageV07P2103(@)(@@)(@@)(@@) | 11336 - (@)(@@) حدثنا أبو بكر بن أبي موسى، ثنا هارون بن حاتم، ثنا عبد الرحمن بن أبي حماد، ثنا أسباط، عن السدي، عن أبي مالك، قوله: " {وكذلك} [يوسف: 6] يعني: هكذا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {يجتبيك ربك} (@)(@@) [يوسف: 6](@)(@@) PageV07P2103(@)(@@)(@@)(@@) | 11337 - (@)(@@) حدثنا أبو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة، قوله: " {وكذلك يجتبيك ربك} [يوسف: 6] قال: يصطفيك بتأويل الأحاديث " قال أبو محمد: ليس عند أبي الجماهر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11338 - (@)(@@) حدثنا أبي، ثنا هشام بن خالد، عن شعيب بن إسحاق، عن ابن أبي عروبة، عن قتادة: " {اجتباه} [النحل: 121] : اصطفاه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ويعلمك من تأويل الأحاديث} (@)(@@) [يوسف: 6](@)(@@) PageV07P2103(@)(@@)(@@)(@@) | 11339 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {من تأويل الأحاديث} [يوسف: 6] قال: عبارة الرؤيا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11340 - (@)(@@) حدثنا أبي، ثنا هشام بن خالد، ثنا شعيب، ثنا ابن أبي عروبة، عن قتادة، قوله: " {ويعلمك من تأويل الأحاديث} [يوسف: 6] ففعل وعلمه من عبر الأحاديث، وهي: تأويل الأحاديث "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11341 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، أنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، يقول في قوله تعالى: " {ويعلمك من تأويل الأحاديث} [يوسف: 6] قال: تأويل الكلام: العلم والحكم، وكان يوسف أعبر الناس، وقرأ: {ولما بلغ أشده آتيناه حكما وعلما} [يوسف: 22] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ويتم نعمته عليك وعلى آل يعقوب} (@)(@@) [يوسف: 6](@)(@@) PageV07P2104(@)(@@) حدثنا يونس بن حبيب، ثنا أبو داود، ثنا حماد، عن داود بن أبي هند، عن سعيد بن جبير، في قوله: " {ويتم نعمته عليك} [يوسف: 6] قال: من تمام النعمة، دخول الجنة أن الله لم يتم على أحد نعمه فيدخله النار "(@)(@@) PageV07P2104(@)(@@)(@@)(@@) | قوله تعالى: {كما أتمها على أبويك من قبل إبراهيم وإسحاق}(@)(@@) PageV07P2104(@)(@@)(@@)(@@) | قوله تعالى: {إن ربك عليم حكيم} (@)(@@) [يوسف: 6](@)(@@) PageV07P2104(@)(@@)(@@)(@@) | 11343 - (@)(@@) حدثنا محمد بن العباس، ثنا زنيج، ثنا سلمة، ثنا محمد بن إسحاق، قوله: " {عليم} [يوسف: 6] أي: عليم بما تخفون "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11344 - (@)(@@) حدثنا عصام بن رواد، ثنا آدم، ثنا أبو جعفر، عن الربيع بن أنس، عن أبي العالية، في قوله: " {حكيم} [يوسف: 6] قال: 
ms1848	 حكيم في أمره "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11345 - (@)(@@) حدثنا محمد بن يحيى، أنا أبو غسان، ثنا سلمة، ثنا محمد بن إسحاق، قوله: " {حكيم} [يوسف: 6] ، في عذره وحجته إلى عباده "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى {لقد كان في يوسف وإخوته آيات للسائلين} (@)(@@) [يوسف: 7](@)(@@) PageV07P2104(@)(@@)(@@)(@@) | 11346 - (@)(@@) ذكر، عن يحيى بن راشد، ثنا صفوان بن عيسى، ثنا عثمان بن سعد، عن الحسن: " {لقد كان في يوسف وإخوته آيات للسائلين} [يوسف: 7] قال: عبر "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {للسائلين} (@)(@@) [يوسف: 7](@)(@@) PageV07P2104(@)(@@)(@@)(@@) | 11347 - (@)(@@) حدثنا أبي، ثنا هشام بن خالد، ثنا شعيب بن إسحاق، ثنا سعيد بن أبي عروبة، عن قتادة، قوله: " {لقد كان في يوسف وإخوته آيات للسائلين} [يوسف: 7] يقول: من سأل عن ذلك، فهو هكذا ما قص الله عليكم وأنبأكم به "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إذ قالوا ليوسف وأخوه أحب إلى أبينا منا} (@)(@@) [يوسف: 8](@)(@@) PageV07P2104(@)(@@)(@@)(@@) | 11348 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا أسباط، عن السدي، قوله: " {إذ قالوا ليوسف وأخوه أحب إلى أبينا منا} [يوسف: 8] وأخوه: بنيامين "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11349 - (@)(@@) حدثنا علي بن الحسين، ثنا محمد بن عيسى الدامغاني، ثنا عمرو بن(@)(@@)(@@)(@@) | [ص: 2105](@)(@@) حمران، عن سعيد، عن قتادة: " {إذ قالوا ليوسف وأخوه} [يوسف: 8] يعني: بنيامين، وهو أخو يوسف لأبيه وأمه "(@)(@@) PageV00P000(@)(@@) قوله تعالى: {ونحن عصبة} [يوسف: 8](@)(@@)(@@)(@@) | 11350 - (@)(@@) حدثنا أبي، ثنا هشام بن خالد، ثنا شعيب بن إسحاق، ثنا سعيد بن أبي عروبة، عن قتادة، قوله: " {ونحن عصبة} [يوسف: 8] قال: العصبة: ما بين العشرة إلى الأربعين وروي عن أبي المليح مثل ذلك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11351 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن أسباط، عن السدي، " {ونحن عصبة} [يوسف: 8] قال: كانوا عشرة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثاني(@)(@@) PageV07P2105(@)(@@)(@@)(@@) | 11352 - (@)(@@) حدثنا علي بن الحسين، ثنا عثمان بن أبي شيبة، ثنا سلمة بن الفضل، ثنا حجاج، عن الحكم، قال: " العصبة: أربعون رجلا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث:(@)(@@) PageV07P2105(@)(@@)(@@)(@@) | 11353 - (@)(@@) حدثنا علي بن الحسين، ثنا سعيد بن الربيع، ثنا أبو عوانة، عن أبي بشر، عن سعيد بن جبير، قال: " قلت: كم العصبة؟ قال: ستة أو سبعة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11354 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما 
ms1849	 كتب إلي، ثنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قول الله تعالى: " {ونحن عصبة} [يوسف: 8] قال: العصبة: الجماعة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {إن أبانا لفي ضلال مبين} (@)(@@) [يوسف: 8](@)(@@) PageV07P2105(@)(@@)(@@)(@@) | 11355 - (@)(@@) حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا أسباط، عن السدي، " {إن أبانا لفي ضلال مبين} [يوسف: 8] قالوا: في ضلال من أمرنا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {اقتلوا يوسف أو اطرحوه} (@)(@@) [يوسف: 9](@)(@@) PageV07P2105(@)(@@)(@@)(@@) | 11356 - (@)(@@) حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا أسباط، عن السدي، في قوله: " {اقتلوا يوسف أو اطرحوه أرضا يخل لكم وجه أبيكم وتكونوا من بعده قوما صالحين} [يوسف: 9] يقول: تتوبون مما صنعتم به "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {قال قائل منهم لا تقتلوا يوسف} (@)(@@) [يوسف: 10](@)(@@) PageV07P2106(@)(@@)(@@)(@@) | 11357 - (@)(@@) حدثنا علي بن الحسين، ثنا أبو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {قال قائل منهم لا تقتلوا يوسف} [يوسف: 10] قال: كنا نحدث أنه روبيل، وهو أكبر إخوته، وهو ابن خالة يوسف "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثاني:(@)(@@) PageV07P2106(@)(@@) حدثنا عبد الله، ثنا الحسين، أنا عامر، عن أسباط، عن السدي، " {قال قائل منهم لا تقتلوا يوسف} [يوسف: 10] وهو: يهوذا "(@)(@@) PageV07P2106(@)(@@)(@@)(@@) | والوجه الثالث:(@)(@@) PageV07P2106(@)(@@)(@@)(@@) | 11359 - (@)(@@) حدثنا أبي، ثنا ابن أبي عمر، ثنا سفيان، عن رجل، عن مجاهد، قال أبي: وفي كتاب غيري، عن ابن جريج، عن مجاهد، " {قال قائل منهم لا تقتلوا يوسف} [يوسف: 10] قال: هو شمعون "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11360 - (@)(@@) حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، قال: قال محمد بن إسحاق: " {قال قائل منهم لا تقتلوا يوسف} [يوسف: 10] فذكروا والله أعلم أن الذي قال ذلك منهم روبيل الأكبر من بني يعقوب، وكان أقصدهم فيه رأيا وكل قد عظم فيه جرمه، وكان أيسرهم جرما، وكفى بجرمه جرما لما اجتمعوا عليه من قطيعة الرحم، وعقوق الوالد، وقلة الرأفة بالصغير الضرع، الذي لا ذنب له، وبالكبير الفاني ذي الحق والحرمة والفضل عليهم، وخطره عند الله مع حق الوالد على ولده , ليفرقوا بينه وبين ولده , وحبيبه على كبر سنه، ورقة عظمه، مع مكانه من الله وبين من أحبه طفلا صغيرا 
ms1850	 على ضعف قوته، وصغر سنه، وحاجته إلى لطف والده، وسكونه إليه يغفر الله لهم، وهو أرحم الراحمين، فقد احتملوا أمرا عظيما "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وألقوه في غيابة الجب} (@)(@@) [يوسف: 10](@)(@@) PageV07P2106(@)(@@)(@@)(@@) | 11361 - (@)(@@) أخبرنا محمد بن سعد، فيما كتب إلي، حدثنا أبي، حدثني عمي، حدثني أبي، عن أبيه، عن ابن عباس، في قوله: " {قال قائل منهم لا تقتلوا يوسف وألقوه في غيابة الجب} [يوسف: 10] يعني: الركية "(@)(@@) PageV00P000(@)(@@) حدثنا علي بن الحسين، ثنا أبو الجماهر، أنا سعيد بن بشير، عن قتادة، قوله " {وألقوه في غيابة الجب} [يوسف: 10] : في بعض نواحيه أسفله "(@)(@@) PageV07P2107(@)(@@)(@@)(@@) | 11363 - (@)(@@) حدثنا أبي، ثنا محمد بن عبد الأعلى، ثنا محمد بن ثور، عن معمر، عن قتادة، في قوله: " {في غيابة الجب} [يوسف: 10] قال: بئر ببيت المقدس "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11364 - (@)(@@) حدثنا يونس بن عبد الأعلى، أنا ابن وهب، أخبرني ابن زيد، قال: «الجب الذي جعل فيه يوسف بحذاء طبرية بينه وبينها أميال»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11365 - (@)(@@) حدثنا أبي، ثنا أحمد بن عبد الله بن يونس، ثنا أبو بكر بن عياش، قال: «كان يوسف في الجب ثلاثة أيام»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {يلتقطه بعض السيارة} (@)(@@) [يوسف: 10](@)(@@) PageV07P2107(@)(@@)(@@)(@@) | قوله تعالى: {قالوا يا أبانا ما لك لا تأمنا على يوسف وإنا له لناصحون} (@)(@@) [يوسف: 11](@)(@@) PageV07P2107(@)(@@)(@@)(@@) | 11366 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن أسباط، عن السدي: " فلما أجمعوا أمرهم على ذلك، أتوا أباهم فقالوا: {يا أبانا ما لك لا تأمنا على يوسف وإنا له لناصحون} [يوسف: 11] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أرسله معنا غدا} (@)(@@) [يوسف: 12](@)(@@) PageV07P2107(@)(@@)(@@)(@@) | 11367 - (@)(@@) حدثنا علي بن الحسين، ثنا شيبان، ثنا قزعة بن سويد، عن مطرف الشقري: " أن يعقوب، لما أرسل ابنه مع بنيه قال: اللهم صافحهم بيمين الرحمة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11368 - (@)(@@) حدثنا علي بن الحسين، ثنا محمد بن عيسى، ثنا سلمة، عن ابن إسحاق: " فلم يزالوا يأتونه حتى أرسله معهم على وجل وتخوف، فذكر لي أنه لما أرسله معهم دعاه حين أرادوا الذهاب به، فضمه إليه ثم دعا له، وقال: اللهم اجعل دعائي جنة مما أتخوف عليه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {يرتع ويلعب وإنا له 
ms1851	 لحافظون} (@)(@@) [يوسف: 12](@)(@@) PageV07P2107(@)(@@)(@@)(@@) | 11369 - (@)(@@) حدثنا محمد بن عبد الله بن يزيد المقرئ، ثنا سفيان، عن ابن جريج، عن مجاهد، في قوله: " {يرتع ويلعب} [يوسف: 12] قال: نتحارس ونتكالأ، يحفظ بعضنا بعضا وربما قال: يكلأ بعضنا بعضا "(@)(@@) PageV00P000(@)(@@) حدثنا أبو سعيد الأشج، ثنا عبيد الله، عن إسرائيل، عن أبي يحيى، عن مجاهد: " {يرتع ويلعب} [يوسف: 12] قال: ننشط ونلعب "(@)(@@) PageV07P2108(@)(@@)(@@)(@@) | 11371 - (@)(@@) حدثنا أبي، ثنا محمد بن عبد الأعلى، ثنا محمد بن ثور، عن معمر، عن قتادة: " {يرتع} [يوسف: 12] قال: يسعى ويلهو ". وروي، عن مقاتل بن حيان، قال: يلهو ويلعب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11372 - (@)(@@) أخبرنا أبو يزيد القراطيسي، فيما كتب إلي، أنا أصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن أسلم، في قول الله: " {أرسله معنا غدا يرتع ويلعب} [يوسف: 12] قال: يرعى غنمه، وينظر، ويعقل ويعرف ما يعرف الرجال "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {قال إني ليحزنني أن تذهبوا به} [يوسف: 13] إلى قوله: {غافلون} (@)(@@) [الأنعام: 131](@)(@@) PageV07P2108(@)(@@)(@@)(@@) | 11373 - (@)(@@) حدثنا محمد بن العباس، مولى بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: قال محمد بن إسحاق: " {قال إني ليحزنني أن تذهبوا به وأخاف أن يأكله الذئب وأنتم عنه غافلون} [يوسف: 13] فلم يزالوا يأتونه حتى أرسله معهم دعاه حين أرادوا الذهاب به فضمه إليه ودعا له "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11374 - (@)(@@) حدثنا أبي، ثنا أبو ذر محمد بن ثابت بن مهران، ثنا عبد الوهاب بن عطاء، عن عمران بن حدير، عن أبي مجلز، قال: " لا ينبغي لأحد أن يلقن ابنه الشر، فإن بني يعقوب لم يدروا أن الذئب يأكل الناس، حتى قال لهم أبوهم: إني أخاف أن يأكله الذئب "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {قالوا لئن أكله الذئب ونحن عصبة} (@)(@@) [يوسف: 14](@)(@@) PageV07P2108(@)(@@)(@@)(@@) | 11375 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا أسباط، عن السدي: قال: " لن أرسله معكم، أخاف أن يأكله الذئب: {قالوا لئن أكله الذئب ونحن عصبة إنا إذا لخاسرون} [يوسف: 14] ، فأرسله معهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فلما ذهبوا به وأجمعوا} (@)(@@) [يوسف: 15](@)(@@) PageV07P2108(@)(@@)(@@)(@@) | 11376 - (@)(@@) وبه عن السدي، قوله: " {فلما ذهبوا به} [يوسف: 15] ، أخرجوه وبه عليهم كرامة(@)(@@)(@@)(@@) | [ص: 
ms1852	 2109](@)(@@) ، فلما خرجوا به إلى البرية أظهروا به، فلما أخرجوه، وبه عليهم كرامة، فلما خرجوا به إلى البرية، أظهروا له العداوة، فجعل يضربه أحدهم فيستغيث بالآخر فيضربه، فجعل لا يرى منهم رحيما فضربوه حتى كادوا يقتلونه، فجعل يصيح، يا أبتاه يا يعقوب، لو تعلم ما صنع بابنك بنو الإماء، فلما كادوا أن يقتلوه قال يهوذا: أليس قد أعطيتموني موثقا ألا تقتلوه، فانطلقوا به إلى الجب ليطرحوا فيه فجعلوا يدلونه في البئر فيتعلق بشفة البئر فربطوا يديه، ونزعوا قميصه، فقال: يا إخوتاه، ذروا علي قميصي أتوارى به في الجب، قالوا له: ادع الأحد عشر كوكبا والشمس والقمر يؤنسوك، قال: فإني لم أر شيئا فدلوه في البئر، حتى إذا بلغ نصفها ألقوه إرادة أن يموت فكان في البئر ماء فسقط فيه فلم يضره، ثم أوى إلى صخرة في البئر، فقام عليها فجعل يبكي فناداه إخوته فظن أنها رحمة أدركتهم، فأجابهم فأرادوا أن يرضخوه، بصخرة فقام يهوذا فمنعهم، وقال: قد أعطيتموني موثقا ألا تقتلوه، فكان يهوذا يأتيه بالطعام "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وأوحينا إليه لتنبئنهم بأمرهم هذا وهم لا يشعرون} (@)(@@) [يوسف: 15](@)(@@) PageV07P2109(@)(@@)(@@)(@@) | 11377 - (@)(@@) حدثنا علي بن الحسن، ثنا أبو الجماهر، ثنا سعيد، عن قتادة، قوله: " {وأوحينا إليه لتنبئنهم بأمرهم هذا} [يوسف: 15] قال: أوحى الله إليه وحيا وهو في الجب، فهون ذلك الوحي عليه ما صنع به "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11378 - (@)(@@) حدثنا علي بن الحسين، ثنا يحيى بن خلف، ثنا أبو عاصم، عن عيسى بن ميمون، عن ابن أبي نجيح، عن مجاهد: {وأوحينا إليه} [يوسف: 15] قال: إلى يوسف "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11379 - (@)(@@) حدثنا أبي، ثنا هشام بن خالد، ثنا شعيب بن إسحاق، ثنا ابن أبي عروبة، عن قتادة، " {وأوحينا إليه لتنبئنهم بأمرهم هذا} [يوسف: 15] أتاه الوحي من الله، وهو في البئر بما يريدون أن يفعلوا به: {وهم لا يشعرون} [يوسف: 15] بما أطلع الله عليه رسوله من أمرهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11380 - (@)(@@) ذكره أبي، عن أبي حذيفة، عن شبل، عن ابن أبي نجيح، عن مجاهد، " {وأوحينا إليه} [يوسف: 15] إلى يوسف: لتنبئن إخوتك "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وهم لا يشعرون} (@)(@@) [الأعراف: 
ms1853	 95](@)(@@) PageV07P2109(@)(@@)(@@)(@@) | 11381 - (@)(@@) حدثنا علي بن الحسين، ثنا محمد بن أبي حماد، ثنا كنانة، ثنا إبراهيم(@)(@@)(@@)(@@) | [ص: 2110](@)(@@) بن طهمان، عن عياد بن إسحاق، عن ابن الحويرث وهو أبو الحويرث، عن ابن عباس، " {وأوحينا إليه لتنبئنهم بأمرهم هذا وهم لا يشعرون} [يوسف: 15] قال: فلم يعلموا بوحي الله إليه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11382 - (@)(@@) حدثنا علي بن الحسن، ثنا أبو الجماهر، ثنا سعيد بن بشير، عن قتادة، " {وهم لا يشعرون} [يوسف: 15] أي إخوته "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله {وجاءوا أباهم عشاء يبكون}(@)(@@) PageV07P2110(@)(@@)(@@)(@@) | 11384 - (@)(@@) ذكر عن أبي سعيد الأشج، قال: سمعت أبا بكر بن عياش، يذكر عن جراد الضبي، قال: انتهيت إلى الحسن وهو يقص وهو يقول: «آتو أباهم كذبة آثمة»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11385 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، عن أسباط، عن السدي، قال: «ثم إنهم رجعوا إلى أبيهم فأخذوا جديا من الغنم فذبحوه، ونضحوا دمه على القميص، ثم أقبلوا على أبيهم عشاء يبكون»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11386 - (@)(@@) حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: قال محمد بن إسحاق: " فلما انطلقت به العير، وعرف إخوته أن قد ذهب به: {جاءوا أباهم عشاء يبكون} "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى {قالوا يا أبانا إنا ذهبنا نستبق} (@)(@@) [يوسف: 17](@)(@@) PageV07P2110(@)(@@)(@@)(@@) | 11387 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن أسباط، عن السدي، قال: " ثم أقبلوا إلى أبيهم عشاء يبكون، فلما سمع أصواتهم، فزع وقال: يا بني ما لكم؟ هل أصابكم في غنمكم شيء؟ قالوا: لا، قال: فما فعل يوسف؟ {قالوا يا أبانا إنا ذهبنا نستبق وتركنا يوسف عند متاعنا فأكله الذئب} [يوسف: 17] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وما أنت بمؤمن لنا} (@)(@@) [يوسف: 17](@)(@@) PageV07P2110(@)(@@)(@@)(@@) | 11388 - (@)(@@) وبه، عن السدي، قوله: " {وما أنت بمؤمن لنا} [يوسف: 17] قال: وما أنت بمصدق لنا، ولو كنا صادقين "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11389 - (@)(@@) حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: قال محمد بن إسحاق: " {وما أنت بمؤمن لنا} [يوسف: 17] أي: ما أنت بمصدقنا {ولو كنا صادقين} [يوسف: 17] وإن كنا قد صدقنا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وجاءوا على قميصه بدم كذب}(@)(@@) PageV07P2111(@)(@@)(@@)(@@) | 11390 
ms1854	 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو أحمد الزبيري، عن سفيان، عن سماك، عن سعيد بن جبير، عن ابن عباس، في قوله: " {وجاءوا على قميصه بدم كذب} قال: لو كان أكله السبع لخرق قميصه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11391 - (@)(@@) حدثنا الحسن بن أبي الربيع، أنا عبد الرزاق، عن إسرائيل، عن سماك، عن عكرمة، عن ابن عباس، في قوله: " {بدم كذب} [يوسف: 18] قال: كان دم سخلة " وروي عن مجاهد أنه قال: سخلة شاة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11392 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو أسامة، أحسبه عن سماك، عن الشعبي، قال: " كانت في قميص يوسف ثلاث آيات، حيث جاءوا بقميصه إلى أبيه فقالوا: أكله الذئب، فقال أبوه: لو أكله الذئب لشق قميصه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11393 - (@)(@@) حدثنا علي بن الحسن، ثنا أبو الجماهر، ثنا سعيد، عن قتادة، قوله: " {وجاءوا على قميصه بدم كذب} قال: صادوا ظبيا فذبحوه فلطخوا به القميص، فجعل يقلب القميص فيقول: ما أرى به أثر ناب ولا ظفر، إن هذا لسبع رحيم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11394 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، عن أسباط، عن السدي، قال: " فبكى الشيخ وصاح بأعلى صوته ثم قال: أين القميص؟ فجاءوا بقميصه عليه دم كذب فأخذ القميص، فطرحه على وجهه، ثم بكى حتى خضب وجهه من دم القميص. ثم قال: إن هذا الذئب يا بني لرحيم، فكيف أكل لحمه ولم يخرق قميصه؟ "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {قال بل سولت لكم أنفسكم أمرا} (@)(@@) [يوسف: 18](@)(@@) PageV07P2111(@)(@@)(@@)(@@) | 11395 - (@)(@@) حدثنا أبو زرعة، ثنا منجاب بن الحارث، أنا بشر بن عمارة، عن أبي روق، عن الضحاك، عن ابن عباس، قوله: " {بل سولت لكم أنفسكم أمرا} [يوسف: 18] قال: أمرتكم أنفسكم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11396 - (@)(@@) حدثنا علي بن الحسن، ثنا أبو الجماهر، أنا سعيد بن بشير، عن قتادة، قوله: {قال بل سولت لكم أنفسكم أمرا} [يوسف: 18] ، أي: زينت لكم أنفسكم أمرا فصبر جميل "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فصبر جميل} (@)(@@) [يوسف: 18](@)(@@) PageV07P2112(@)(@@)(@@)(@@) | 11397 - (@)(@@) حدثنا أبي، ثنا ابن الطباع، ثنا هشيم، عن عبد الرحمن بن يحيى، عن حبان بن أبي جبلة، قال: سئل النبي صلى الله عليه وسلم عن قوله: 
ms1855	 " {فصبر جميل} [يوسف: 18] قال: لا شكوى فيه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11398 - (@)(@@) حدثنا عمار بن خالد، ثنا محمد بن زيد، عن ورقاء، عن ابن أبي نجيح، عن مجاهد، في قوله: " {فصبر جميل} [يوسف: 18] قال: ليس فيه جزع "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11399 - (@)(@@) حدثنا أبي، ثنا ابن الطباع، ثنا أبو خلف الخزاز، عن يونس، عن الحسن، قال: " الصبر الجميل: الذي ليس فوقه جزع إلا إلى الله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {والله المستعان على ما تصفون} (@)(@@) [يوسف: 18](@)(@@) PageV07P2112(@)(@@)(@@)(@@) | 11400 - (@)(@@) حدثنا علي بن الحسن، ثنا أبو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {والله المستعان على ما تصفون} [يوسف: 18] أي: تكذبون "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11401 - (@)(@@) حدثنا محمد بن العباس، مولى بني هاشم ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن إسحاق، قوله: " {والله المستعان على ما تصفون} [يوسف: 18] فعرف، يعني: يعقوب أن قد كادوه واستعان الله على ما يسمع من قولهم لما بلغ كرب ذلك منه، فنزل البلاء بيعقوب على كبره بفراق حبيبه قد وله عنه، لا يدري أحي هو أم ميت؟ ويوسف على صغره وضعفه بلا ذنب أجرمه إلى من صنع ذلك به أكب على يعقوب حزنه، وانطلق بيوسف في رقه قد أنزله البلاء عبدا، وهو حر ابن أحرار، قد أسلمه بغي إخوته عليه إلى ما هو فيه، وبعين الله ذلك كله يرى ويسمع، ولو شاء أن يكف ذلك من بغيهم، عن يوسف في صغره فعل، وعن يعقوب في كبره فعل، ولكنه أراد أن يبتليه لينظر كيف عزمه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وجاءت سيارة} (@)(@@) [يوسف: 19](@)(@@) PageV07P2112(@)(@@)(@@)(@@) | 11402 - (@)(@@) حدثنا أبي، ثنا عبد العزيز بن منيب، ثنا أبو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك، قوله: " {وجاءت سيارة} [يوسف: 19] فنزلوا على الجب والجب: البئر "(@)(@@) PageV00P000(@)(@@) حدثنا محمد العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن إسحاق، قال: «فلما انتهوا به إلى المكان الذي أرادوا به ما أرادوا، جردوه من قميصه، وهو يناشدهم الله ورحمه وقلة ذنبه فيما بينه وبينهم، فلم تعطفهم عليه عاطفة، وقذفوه في الجب بغلظة وفظاظة، وقلة رأفة، ثم قعدوا فيما بلغني ينظرون 
ms1856	 بقية يومهم ذلك ما هو صانع في الجب، أو مصنوع به، إذ أقبلت سيارة من العرب فأرسلوا واردهم فأدلى دلوه»(@)(@@) PageV07P2113(@)(@@)(@@)(@@) | قوله تعالى: {فأرسلوا واردهم} (@)(@@) [يوسف: 19](@)(@@) PageV07P2113(@)(@@)(@@)(@@) | 11404 - (@)(@@) حدثنا أبي، ثنا هشام، ثنا شعيب بن إسحاق، ثنا ابن أبي عروبة، عن قتادة، قوله: " {فأرسلوا واردهم} [يوسف: 19] يقول: أرسلوا رسولهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {فأدلى دلوه} (@)(@@) [يوسف: 19](@)(@@) PageV07P2113(@)(@@)(@@)(@@) | 11405 - (@)(@@) وبه، عن قتادة، قوله: " {فأدلى دلوه} [يوسف: 19] فلما أدلى دلوه تشبث به الغلام "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11406 - (@)(@@) حدثنا أبي، ثنا عبد العزيز بن منيب، ثنا أبو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك، قوله: " {فأرسلوا واردهم فأدلى دلوه} [يوسف: 19] فاستقى من الماء، فاستخرج يوسف "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {قال يا بشرى هذا غلام} (@)(@@) [يوسف: 19](@)(@@) PageV07P2113(@)(@@)(@@)(@@) | 11407 - (@)(@@) حدثنا أبو زرعة، ثنا منجاب، أنا بشر بن عمارة، عن أبي روق، في قوله: " {يا بشرى} [يوسف: 19] فيقول: يا بشارة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11408 - (@)(@@) حدثنا أبي، ثنا هشام بن خالد، ثنا شعيب بن إسحاق: ثنا ابن أبي عروبة، عن قتادة، قوله: " {يا بشرى هذا غلام} [يوسف: 19] فلما أدلى دلوه تشبث به الغلام، فقال: يا بشرى هذا غلام، تباشروا به حين استخرجوه، وهي بئر ببيت المقدس، معلوم مكانها "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني:(@)(@@) PageV07P2113(@)(@@)(@@)(@@) | 11409 - (@)(@@) حدثنا حجاج بن حمزة، ثنا يحيى بن آدم، ثنا قيس، عن السدي، قال: " كان اسم صاحبه: يعني قوله: {يا بشرى} [يوسف: 19] "(@)(@@) PageV00P000(@)(@@) حدثنا عبد الله بن سليمان بن الأشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا أسباط، عن السدي، قال: " {فأدلى دلوه} [يوسف: 19] فتعلق يوسف بالحبل، فخرج، فلما رآه صاحب الدلو، دعا رجلا من أصحابه، يقال له بشرى، فقال: يا بشرى هذا غلام فسمع به إخوة يوسف، فجاءوا فقالوا: هذا عبد لنا أبق ورطنوا له بلسانهم فقالوا: لئن أنكرت أنك عبد لنا لنقتلنك، أترانا نرجع بك إلى يعقوب، وقد أخبرناه أن الذئب قد أكلك؟ قال: يا إخوتاه: ارجعوا بي إلى يعقوب فأنا أضمن لكم رضاه ولا أذكركم هذا أبدا. فأبوا. فقال الغلام: أنا عبد لهم "(@)(@@) PageV07P2114(@)(@@)(@@)(@@) | قوله تعالى: {وأسروه بضاعة} (@)(@@) [يوسف: 19](@)(@@) PageV07P2114(@)(@@)(@@)(@@) | 11411 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا 
ms1857	 ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {وأسروه بضاعة} [يوسف: 19] صاحب الدلو ومن معه فقالوا لأصحابهم: إنا استبضعناه خيفة أن يستشركوهم فيه، إن علموا به، واتبعهم إخوته يقولون للمدلي وأصحابه: استوثقوا منه، لا يأبقن حتى وافوه بمصر، فقال: من يبتاعني ويبشر فاشتراه الملك، والملك مسلم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11412 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا أبو أحمد الزبيري، عن سفيان، عن رجل، عن مجاهد: " {وأسروه بضاعة} [يوسف: 19] قال: أسروه التجار بعضهم عن بعض قالوا: هو بضاعة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11413 - (@)(@@) حدثنا أبي، ثنا عبيد بن آدم، حدثنا أبي، ثنا شيبان، عن جابر، عن مجاهد، قوله: " {وأسروه بضاعة} [يوسف: 19] يقول: استبضعوه أهل الماء، وقد باعوه سرا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11414 - (@)(@@) أخبرنا العباس بن الوليد بن مزيد، قراءة، أخبرني محمد بن شعيب، أخبرني عثمان بن عطاء، عن أبيه، عطاء: وأما قوله: " {وأسروه بضاعة} [يوسف: 19] فدسوه بينهم بيعا سرا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11415 - (@)(@@) حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن أسباط، عن السدي: " فلما اشتراه الرجلان فرقا من الرفقة أن يقولا: اشتريناه(@)(@@)(@@)(@@) | [ص: 2115](@)(@@) فيسألونهما الشركة، فقالوا: تقول إن سألونا: ما هذا؟ نقول: بضاعة استبضعناها من أهل البئر فذلك قوله: {وأسروه بضاعة} [يوسف: 19] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11416 - (@)(@@) حدثنا علي بن الحسن الهسنجاني، ثنا عبد الرحمن بن أبي الغمر، ثنا مفضل بن فضالة، قال: سألته يعني: أبا صخر عن قوله: " {وأسروه بضاعة} [يوسف: 19] قال: إنهم لما ألقوه في الجب، بصروا العير قد أقبلت، فلما أرسل أهل العير واردهم، وأدلى دلوه أحس بالغلام، فنادى أصحابه فلما أتوا، قال لهم إخوة يوسف: هذا الغلام الذي في الجب غلام لنا مملوك، فهل لكم أن تبتاعوه منا؟ وأسروا بيعهم بينهم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {والله عليم بما يعملون} (@)(@@) [يوسف: 19](@)(@@) PageV07P2115(@)(@@)(@@)(@@) | 11417 - (@)(@@) حدثنا محمد بن العباس، مولى بني هاشم ثنا زنيج، ثنا سلمة، ثنا محمد بن إسحاق: " {عليم} [يوسف: 19] أي: علم بما يخفون "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وشروه بثمن بخس} (@)(@@) [يوسف: 20](@)(@@) PageV07P2115(@)(@@)(@@)(@@) | 11418 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا ابن إدريس، عن أبيه، عن عطية، عن أبيه: " {وشروه} [يوسف: 20] قال: باعوه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11419 - (@)(@@) حدثنا أبي، ثنا 
ms1858	 موسى بن إسماعيل، ثنا مبارك، عن الحسن، في قول الله: " {وشروه} [يوسف: 20] قال: لم يبعه إخوته إنما باعه التجار "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {بثمن بخس} (@)(@@) [يوسف: 20](@)(@@) PageV07P2115(@)(@@)(@@)(@@) | 11420 - (@)(@@) حدثنا أبو عبد الله الطهراني، أنا حفص بن عمر العدني، ثنا الحكم بن أبان، عن عكرمة، في قول الله تعالى: " {وشروه بثمن بخس دراهم معدودة} [يوسف: 20] قال: بخس عنق يوسف حين بيع بعشرين درهما " وروي عن أبي صخر نحوه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11421 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا ابن إدريس، عن أبيه، عن عطية: " {بثمن بخس} [يوسف: 20] قال: ظلم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11422 - (@)(@@) حدثنا الأشج، ثنا هانئ بن سعيد، عن جويبر، عن الضحاك: " {بخس} [يوسف: 20] : الحرام، كان ثمنه حراما "(@)(@@) PageV00P000(@)(@@) حدثنا أبي، ثنا هشام بن خالد، ثنا شعيب، ثنا سعيد بن أبي عروبة، عن قتادة: " {وشروه بثمن بخس} [يوسف: 20] يقول: باعوه بثمن ظلم والبخس: هو الظلم، وكان بيع يوسف حراما عليهم بيعه وثمنه "(@)(@@) PageV07P2116(@)(@@)(@@)(@@) | قوله تعالى: {دراهم معدودة} (@)(@@) [يوسف: 20](@)(@@) PageV07P2116(@)(@@)(@@)(@@) | 11424 - (@)(@@) حدثنا عبد الله بن رجاء، أنا إسرائيل، عن مسلم، عن مجاهد، عن ابن عباس، في قوله: " {بثمن بخس دراهم معدودة} [يوسف: 20] قال: عشرون درهما "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11425 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا ابن إدريس، عن عطية: " {معدودة} [البقرة: 80] قال: عشرون درهما قال: كانوا عشرة اقتسموا درهمين درهمين "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثاني:(@)(@@) PageV07P2116(@)(@@)(@@)(@@) | 11426 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا عقبة بن خالد، عن إسرائيل، عن جابر، عن عكرمة، يعني قوله: " {دراهم معدودة} [يوسف: 20] قال: أربعون "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الثالث:(@)(@@) PageV07P2116(@)(@@)(@@)(@@) | 11427 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {دراهم معدودة} [يوسف: 20] اثنان وعشرون درهما لإخوة يوسف أحد عشر رجلا، هم باعوه حين أخرجه المدلي دلوه "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11428 - (@)(@@) حدثنا أبي، ثنا عمرو بن محمد الناقد، ومحمد بن أبي عمر العدني، قالا: ثنا سفيان، عن ابن أبي خالد، قال: سمعت السدي يحلف بالله «لما باعوه إلا باثنين وعشرين درهما اشتروا به خفافا وثقالا السياق لمحمد »(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وكانوا فيه من الزاهدين} (@)(@@) [يوسف: 20](@)(@@) PageV07P2116(@)(@@)(@@)(@@) | 11429 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا ابن إدريس، عن أبيه، عن عطية: " {وكانوا فيه من 
ms1859	 الزاهدين} [يوسف: 20] قال: حين باعوه "(@)(@@) PageV00P000(@)(@@) حدثنا أبي، ثنا عبد العزيز بن منيب، ثنا أبو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك يعني قوله: " {وكانوا فيه من الزاهدين} [يوسف: 20] فزهدوا فيه فباعوه، وكان بيعه حراما، وباعوه "(@)(@@) PageV07P2117(@)(@@)(@@)(@@) | 11431 - (@)(@@) حدثنا علي بن الحسين، ثنا القاسم بن خليفة الشيعي، ثنا عمرو بن محمد العنقزي، عن أبي روق، عن جويبر، عن الضحاك: " {وكانوا فيه من الزاهدين} [يوسف: 20] قال: لم يعلموا بنبوته، ولا بمنزلته من الله "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11432 - (@)(@@) حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن أسباط، عن السدي: " {وكانوا فيه من الزاهدين} [يوسف: 20] قال: كانوا في يوسف من الزاهدين "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وقال الذي اشتراه من مصر لامرأته} (@)(@@) [يوسف: 21](@)(@@) PageV07P2117(@)(@@)(@@)(@@) | 11433 - (@)(@@) أخبرنا محمد بن سعد، فيما كتب إلي، حدثني أبي، ثنا عمي، حدثني أبي، عن أبيه، عن ابن عباس: يعني قوله: " {وقال الذي اشتراه من مصر لامرأته} [يوسف: 21] قال: وكان اسم الذي اشتراه قطفيير "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11434 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، عن ورقاء، عن ابن أبي نجيح، عن مجاهد، قال: " واتبعهم إخوته يقولون للمدلي وأصحابه: استوثقوا منه لا يأبقن، حتى أوقفوه بمصر، فقال: من يبتاعني ويبشر؟ فاشتراه الملك، والملك مسلم "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11435 - (@)(@@) حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن أسباط، عن السدي، قال: «فانطلقوا به إلى مصر فاشتراه العزيز ملك مصر، فانطلق به إلى بيته»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {لامرأته} (@)(@@) [يوسف: 21](@)(@@) PageV07P2117(@)(@@)(@@)(@@) | 11436 - (@)(@@) حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، عن محمد بن إسحاق، قال: «فلما قبضه قطفيير دفعه إلى امرأته، وكان اسم امرأته راعيل بنت رعائيل»(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {أكرمي مثواه} (@)(@@) [يوسف: 21](@)(@@) PageV07P2117(@)(@@)(@@)(@@) | 11437 - (@)(@@) حدثنا أبو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة: " {أكرمي مثواه} [يوسف: 21] : منزلته "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {عسى أن ينفعنا أو نتخذه ولدا} (@)(@@) [يوسف: 21](@)(@@) PageV07P2118(@)(@@)(@@)(@@) | 11438 - (@)(@@) حدثنا أحمد بن سنان، ثنا عبد الرحمن بن مهدي، عن سفيان، عن أبي إسحاق، عن أبي عبيدة، عن عبد الله بن مسعود: " أفرس الناس ثلاثة: صاحب يوسف حيث قال: {أكرمي مثواه عسى أن ينفعنا أو نتخذه 
ms1860	 ولدا} [يوسف: 21] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {وكذلك مكنا ليوسف في الأرض} (@)(@@) [يوسف: 21](@)(@@) PageV07P2118(@)(@@)(@@)(@@) | 11439 - (@)(@@) حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن أسباط، عن السدي، قوله: " {عسى أن ينفعنا، أو نتخذه ولدا} [يوسف: 21] يقول الله: {وكذلك مكنا ليوسف في الأرض} [يوسف: 21] "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ولنعلمه من تأويل الأحاديث} (@)(@@) [يوسف: 21](@)(@@) PageV07P2118(@)(@@)(@@)(@@) | 11440 - (@)(@@) حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن أبي نجيح، عن مجاهد، قوله: " {من تأويل الأحاديث} [يوسف: 6] قال: عبارة الرؤيا "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {والله غالب على أمره} (@)(@@) [يوسف: 21](@)(@@) PageV07P2118(@)(@@)(@@)(@@) | 11441 - (@)(@@) حدثنا علي بن الحسين، ثنا شيخ سعيد البغدادي، ثنا عبد العزيز، عن إسرائيل، عن أبي حصين، عن سعيد بن جبير، في قوله: " {والله غالب على أمره} [يوسف: 21] قال: فعال "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11442 - (@)(@@) حدثنا علي بن الحسين، ثنا سعيد، ثنا عبد العزيز، عن رجل، عن مجاهد: " قال: لغة عربية "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | قوله تعالى: {ولما بلغ أشده} (@)(@@) [يوسف: 22](@)(@@) PageV07P2118(@)(@@)(@@)(@@) | 11443 - (@)(@@) حدثنا أبو سعيد الأشج، ثنا عبد الله بن إدريس، عن عبد الله بن عثمان، عن مجاهد، عن ابن عباس: " {حتى إذا بلغ أشده} [الأحقاف: 15] قال: ثلاثا وثلاثين " وروي عن مجاهد، وقتادة مثله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثاني:(@)(@@) PageV07P2118(@)(@@)(@@)(@@) | 11444 - (@)(@@) حدثنا أبي، ثنا سعيد بن سليمان، ثنا هشيم، عن منصور بن زاذان، عن الحسن، في قوله: " {بلغ أشده} [يوسف: 22] قال: أربعين سنة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الثالث:(@)(@@) PageV07P2119(@)(@@)(@@)(@@) | 11445 - (@)(@@) حدثنا أبو عبد الله الطهراني، أنا حفص بن عمر العدني، ثنا الحكم بن أبان، عن عكرمة، في قوله: " {بلغ أشده} [يوسف: 22] قال: خمسا وعشرين سنة "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | والوجه الرابع:(@)(@@) PageV07P2119(@)(@@)(@@)(@@) | 11446 - (@)(@@) أخبرنا يونس بن عبد الأعلى، قراءة، أنا ابن وهب، حدثني يحيى بن أيوب، عن عمرو بن الحارث، عن ربيعة: " {ولما بلغ أشده} [يوسف: 22] قال: الأشد: الحلم(@)(@@)(@@)(@@) | 11447 - (@)(@@) قال ابن وهب: وحدثني عبد الرحمن بن زيد بن أسلم، عن أبيه، مثله وقال مالك مثله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 11448 - (@)(@@) حدثنا أبي، ثنا عمرو بن رافع، ثنا هشيم، عن مجالد، عن الشعبي، أنه قال: " الأشد: الحلم. إذا كتبت له الحسنات، وكتبت عليه السيئات "(@)(@@) PageV00P000(@)(@@)(@@)(@@) | الوجه الخامس:(@)(@@) PageV07P2119(@)(@@)(@@)(@@) | 11449 - (@)(@@) أخبرنا أحمد بن عثمان بن حكيم، فيما كتب إلي، ثنا أحمد بن مفضل، 