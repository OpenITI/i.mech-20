ms61	 الصديق مرسل(@)(@@)(@@)(@@) | 585 - (@)(@@) قال أبو زرعة عكرمة عن علي مرسل(@)(@@)(@@)(@@) | 298 - (@)(@@) عكرمة بن خالد(@)(@@)(@@)(@@) | 586 - (@)(@@) حدثنا محمد بن حمويه بن الحسن قال سمعت أبا طالب يعني أحمد بن حميد قال قال أحمد بن حنبل(@)(@@)(@@)(@@) | عكرمة بن خالد (@)(@@) لم يسمع من عمر وقد سمع من ابن عمر(@)(@@)(@@)(@@) | 587 - (@)(@@) قال أبو زرعة عكرمة بن خالد أبو العاص عن عثمان مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 299 - عامر بن واثلة أبو الطفيل(@)(@@)(@@)(@@) | 588 - (@)(@@) حدثنا عباس بن محمد الدوري سمعت يحيى بن معين يقول أبو الطفيل وعامر بن واثلة هو واحد هو الذي يروي عنه فطر وهو الذي روى عنه معروف بن خربوذ وقد رأى النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 300 - عامر بن شراحيل الشعبي(@)(@@)(@@)(@@) | 589 - (@)(@@) قرىء على العباس بن محمد الدوري قال سمعت يحيى ابن معين يقول ما روى الشعبي عن عائشة مرسل(@)(@@)(@@)(@@) | 590 - (@)(@@) سألت أبي عن حديثين رواهما همام عن قتادة عن عزرة عن الشعبي أن أسامة بن زيد حدثه أنه كان ردف النبي صلى الله عليه وسلم عشية عرفة هل أدرك الشعبي أسامة قال لا يمكن أن يكون الشعبي سمع من أسامة هذا ولا أدرك الشعبي الفضل بن العباس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 591 - (@)(@@) سمعت أبي يقول لم يسمع الشعبي من عبد الله بن مسعود والشعبي عن عائشة مرسل إنما يحدث عن مسروق عن عائشة(@)(@@)(@@)(@@) | 592 - (@)(@@) سمعت أبي وأبا زرعة يقولان الشعبي عن عمر مرسل(@)(@@)(@@)(@@) | 593 - (@)(@@) قال أبو زرعة الشعبي عن معاذ مرسل(@)(@@)(@@)(@@) | 594 - (@)(@@) سمعت أبي يقول لا أدري سمع الشعبي من سمرة أم لا لأنه أدخل بينه وبينه رجل(@)(@@)(@@)(@@) | 595 - (@)(@@) ذكره أبي عن إسحق بن منصور قلت ليحيى قال الشعبي أن الفضل حدثه وأن أسامة حدثه قال لا شيء وقال أحمد وعلي لا شيء(@)(@@)(@@)(@@) | 596 - (@)(@@) سمعت أبي يقول لم يسمع الشعبي من ابن عمر ولم يدرك عاصم بن عدي لأنه قديم وما يمكن أن يكون سمع من عوف بن مالك الأشجعي ولا أعلم سمع الشعبي بالشام إلا من المقدام أبي كريمة(@)(@@)(@@)(@@) | 301 - (@)(@@) عامر بن مسعود(@)(@@)(@@)(@@) | 597 - (@)(@@) قال أبو زرعة 
ms62	(@)(@@)(@@)(@@) | عامر بن مسعود (@)(@@) من التابعين(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 302 - عامر بن عبد الله بن قيس أبو بردة بن أبي موسى(@)(@@)(@@)(@@) | 598 - (@)(@@) قال أبو زرعة أبو بردة واسمه عامر بن عبد الله بن قيس عن أبي عبيدة بن الجراح مرسل وعن معاذ بن جبل مرسل(@)(@@)(@@)(@@) | 303 - (@)(@@) عباد بن كثير(@)(@@)(@@)(@@) | 599 - (@)(@@) قال أبي(@)(@@)(@@)(@@) | عباد بن كثير (@)(@@) لم يدرك عمرو بن شعيب(@)(@@)(@@)(@@) | 304 - (@)(@@) عنبسة بن سعيد بن غنيم الكلاعي(@)(@@)(@@)(@@) | 600 - (@)(@@) سئل أبو زرعة عن(@)(@@)(@@)(@@) | عنبسة بن سعيد بن غنيم الكلاعي (@)(@@) المدني روى عن عكرمة روى عنه عمر بن بشر بن السرح قال لم يسمع من عكرمة شيئا(@)(@@)(@@)(@@) $ 305 - عباس بن خليد الحجري(@)(@@)(@@)(@@) | 601 - (@)(@@) سمعت أبي يقول عباس بن خليد لا أعلم سمع من ابن عمر شيئا(@)(@@)(@@)(@@) $ 306 - عطية بن الحارث أبو روق(@)(@@)(@@)(@@) | 602 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال سمعت أبي يقول أبو روق لم يسمع من مسروق شيئا وأنكر أشد الإنكار(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 307 - العلاء النهدي أبو محمد(@)(@@)(@@)(@@) | 603 - (@)(@@) قال أبو زرعة أبو محمد العلاء النهدي الذي روى عنه عقبة ابن أبي الصبهاء عن علي مرسل(@)(@@)(@@)(@@) | 308 - (@)(@@) عرفطة بن حكيم الأفريقي(@)(@@)(@@)(@@) | 604 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | عرفطة بن حكيم الأفريقي (@)(@@) عن عبد الله بن عمرو مرسل وعرفطة إنما يحدث عن الحسن ولم يدرك عبد الله بن عمرو(@)(@@)(@@)(@@) $ 309 - عرس بن قيس(@)(@@)(@@)(@@) | 605 - (@)(@@) سمعت أبي يقول لأهل الشام عرسان عرس بن عميرة وله صحبة وعرس بن قيس ليست له صحبة(@)(@@)(@@)(@@) | 310 - (@)(@@) عراك بن مالك(@)(@@)(@@)(@@) | 606 - (@)(@@) كتب إلي علي بن أبي طاهر نا أحمد بن محمد بن هانىء سمعت أبا عبد الله وذكر حديث خالد بن الصلت عن(@)(@@)(@@)(@@) | عراك بن مالك (@)(@@) عن عائشة رضي الله عنها عن النبي صلى الله عليه وسلم قال حولوا مقعدي إلى القبلة فقال مرسل فقلت له عراك بن مالك قال سمعت عائشة رضي الله عنها فأنكره وقال عراك بن مالك من أين سمع عائشة ماله ولعائشة إنما يروي عن عروة هذا خطأ قال لي من روى هذا قلت حماد بن 
ms63	 سلمة عن خالد الحذاء فقال رواه غير واحد عن خالد الحذاء ليس فيه سمعت وقال غير واحد أيضا عن حماد بن سلمة ليس فيه سمعت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 311 - (@)(@@) عبيد(@)(@@)(@@)(@@) | 607 - (@)(@@) سمعت أبا زرعة يقول في حديث واصل مولى أبي عيينة عن يحيى بن(@)(@@)(@@)(@@) | عبيد (@)(@@) عن أبيه قال كان رسول الله صلى الله عليه وسلم يتبوأ لبوله فقال أبو زرعة هذا مرسل ليس لوالد يحيى بن عبيد صحبة(@)(@@)(@@)(@@) $ 312 - عمير بن عقبة بن نيار والد سعيد(@)(@@)(@@)(@@) | 608 - (@)(@@) سألت أبي عن حديث رواه أبو أسامة عن سعيد بن سعيد أبي الصباح التغلبي عن سعيد بن عمير بن عقبة بن نيار عن عمه أبي بردة بن نيار الأنصاري قال قال النبي صلى الله عليه وسلم من صلى على عبد من أمتي صلاة وذكر الحديث وروى هذا الحديث وكيع عن سعيد بن سعيد التغلبي عن سعيد ابن عمير عن أبيه وكان بدريا عن النبي صلى الله عليه وسلم فقلت لأبي أيهما أصح قال حديث وكيع أشبه ولا أعلم لعمير صحبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 313 - عياش بن عباس(@)(@@)(@@)(@@) | 609 - (@)(@@) سمعت أبي يقول عباس بن عياش لم يدرك عبد الله بن سعد وعبد الله بن سعد له صحبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الغين(@)(@@)(@@)(@@) | 314 - (@)(@@) غنيم بن قيس(@)(@@)(@@)(@@) | 610 - (@)(@@) سألت أبي عن حديث رواه شعبة عن سعيد الجريري قال سمعت(@)(@@)(@@)(@@) | غنيم بن قيس (@)(@@) يقول كنا نؤمر إذا طلع الفجر أن نبادر الشيطان {قل هو الله أحد} فسألت أبي هل له صحبة فقال هو تابعي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الفاء(@)(@@)(@@)(@@) | 315 - (@)(@@) فروة بن نوفل(@)(@@)(@@)(@@) | 611 - (@)(@@) سألت أبي عن(@)(@@)(@@)(@@) | فروة بن نوفل (@)(@@) له صحبة فقال ليس له صحبة ولأبيه صحبة(@)(@@)(@@)(@@) | 316 - (@)(@@) فرات بن سلمان(@)(@@)(@@)(@@) | 612 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | فرات بن سلمان (@)(@@) عن علي رضي الله عنه مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب القاف(@)(@@)(@@)(@@) $ 317 - قرة المزني(@)(@@)(@@)(@@) | 613 - (@)(@@) أخبرنا العباس بن محمد الدوري نا يحيى بن معين نا حجاج بن محمد نا شعبة عن أبي إياس يعني معاوية بن قرة قال جاء أبي إلى النبي صلى الله عليه وسلم وهو غلام صغير فمسح رأسه واستغفر 
ms64	 له قال شعبة فقلت له صحبة قال لا ولكن كان على عهده وقد حلب وصر(@)(@@)(@@)(@@) | 318 - (@)(@@) القاسم مولى أبي بكر(@)(@@)(@@)(@@) | 614 - (@)(@@) قيل لأبي زرعة(@)(@@)(@@)(@@) | القاسم مولى أبي بكر (@)(@@) له صحبة قال ما أرى(@)(@@)(@@)(@@) | 319 - (@)(@@) قيس بن زيد(@)(@@)(@@)(@@) | 615 - (@)(@@) سمعت أبي وسئل عن(@)(@@)(@@)(@@) | قيس بن زيد (@)(@@) هل له صحبة قال لا(@)(@@)(@@)(@@) | 616 - (@)(@@) قال أبو محمد بن أبي حاتم روى عن النبي صلى الله عليه وسلم أنه طلق حفصة قال فأتاني جبريل عليه السلام فقال راجع حفصة فإنها صوامة قوامة وإنها زوجتك في الجنة قال أبي روى عنه أبو عمران الجوني ولا أعلم له صحبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 320 - (@)(@@) قيس بن أبي حازم(@)(@@)(@@)(@@) | 617 - (@)(@@) حدثنا محمد بن أحمد بن البراء قال قال علي بن المديني لم يسمع(@)(@@)(@@)(@@) | قيس بن أبي حازم (@)(@@) من أبي الدرداء ولا من سلمان(@)(@@)(@@)(@@) | 618 - (@)(@@) حدثنا محمد بن أحمد بن البراء قال قال علي بن المديني روى قيس بن أبي حازم عن بلال ولم يلقه وروى عن عقبة بن عامر فلا أدري سمع منه أم لا(@)(@@)(@@)(@@) $ 321 - قتادة بن دعامة السدوسي(@)(@@)(@@)(@@) | 619 - (@)(@@) أخبرنا حرب بن إسماعيل فيما كتب إلي قال قال أحمد بن حنبل ما أعلم قتادة روى عن أحد من أصحاب النبي صلى الله عليه وسلم إلا عن أنس رضي الله عنه قيل فابن سرجس فكأنه لم يره سماعا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 619 - (@)(@@) ب قال أبو محمد حديث ابن جرجس ما يرويه غير معاذ بن هاشم عن أبيه عن قتادة عن عبد الله بن سرجس أن النبي صلى الله عليه وسلم نهى عن البول في الأحجرة(@)(@@)(@@)(@@) | 620 - (@)(@@) قال حرب فقلت شيخ يقال له دغفل بن حنظلة له صحبة يروي عنه قتادة قال ما أعرفه(@)(@@)(@@)(@@) | 621 - (@)(@@) ذكره أبي عن إسحق بن منصور عن يحيى بن معين قال قتادة لا أعلمه سمع من أبي بردة(@)(@@)(@@)(@@) | 622 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال قال أبي كان يحيى بن سعيد لا يحدث عن قتادة عن خلاس بن عمرو شيئا يعني كأنه لم يسمع 
ms65	 منه(@)(@@)(@@)(@@) | 623 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال سمعت أبي يقول قال شعبة لم يسمع قتادة من أبي رافع شيئا قال أبي أدخل بينه وبين أبي رافع خلاس والحسن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 624 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي حدثني أبو بكر بن خلاد سمعت يحيى بن سعيد يقول قال شعبة أو غيره قتادة لم يسمع من حميد بن عبد الرحمن ومات قبل مسلم ولم أسمعه ذكره في الفتنة(@)(@@)(@@)(@@) | 625 - (@)(@@) أخبرنا علي بن أبي طاهر فيما كتب إلي نا أحمد بن محمد الأثرم قال قلت لأبي عبد الله أحمد بن حنبل قتادة سمع من يحيى بن معمر قال لا أدري قد روى عنه وقد روى عن رجل عنه(@)(@@)(@@)(@@) | 626 - (@)(@@) أخبرنا علي بن أبي طاهر فيما كتب إلي نا أبو بكر أحمد بن محمد الأثرم قال قال أحمد بن حنبل قتادة لم يسمع من عبد الله بن الحارث الهاشمي شيئا لأنه قديم سمع منه عوف قلت له ثابت وحميد يرويان عن ابنه قال نعم قال أبو عبد الله وقتادة يروي عن إسحق بن عبد الله ابن الحارث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 627 - (@)(@@) أخبرنا حرب بن إسماعيل فيما كتب إلي قال قال أبو عبد الله يعني أحمد بن حنبل يقال إن قتادة لم يسمع من سليمان بن يسار بينهما أبو الخليل ولم يسمع من مجاهد بينهما أبو الخليل(@)(@@)(@@)(@@) | 628 - (@)(@@) حدثنا صالح بن أحمد بن حنبل نا علي بن المديني قال سمعت يحيى بن سعيد قال قال شعبة لم يسمع قتادة من أبي العالية إلا ثلاثة أشياء قلت ليحيى عدها قال قول علي رضي الله عنه القضاة ثلاثة وحديث لا صلاة بعد العصر وحديث يونس بن متي(@)(@@)(@@)(@@) | 629 - (@)(@@) ذكره أبي عن إسحق بن منصور عن يحيى بن معين قال قتادة لم يسمع من حميد بن عبد الرحمن(@)(@@)(@@)(@@) | 630 - (@)(@@) حدثنا محمد بن حمويه بن الحسن قال سمعت أبا طالب يعني أحمد بن حميد قال قال أحمد بن حنبل لم يسمع قتادة من 
ms66	 أبي قلابة شيئا إنما بلغه عنه ولم يسمع قتادة من أبي رافع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 631 - (@)(@@) ذكره أبي عن إسحق بن منصور عن يحيى بن معين وقلت له قتادة عن ابن أبي مليكة أسمع منه قال لا لم يسمع منه قال ولم يسمع قتادة من حميد بن عبد الرحمن الحميري قلت قتادة سمع من علي الأزدي قال لا أدري قد روى عنه قلت قتادة سمع من حكيم بن عقال قال لا أدري قلت سمع من سليمان بن يسار قال لا قلت قتادة سمع من أبي قلابة قال لا قلت سمع من مسلم بن يسار قال لا قلت من رجاء بن حيوة قال لا 632 أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال قيل لأبي رحمه الله قتادة سمع من سعيد بن جبير(@)(@@) PageV00P000(@)(@@) قال لا يقول كتبنا إلي سعيد بن جبير قيل له فطا وسمع منه قتادة قال رآه طاوس فتعوذ منه قيل له فالقاسم وعروة وسالم قال لم يسمع منهم قيل فعبد الله بن مغفل قال لم يسمع منه(@)(@@)(@@)(@@) | 633 - (@)(@@) ذكره أبي عن إسحق بن منصور عن يحيى بن معين قال قتادة عن عبد الرحمن مولى أم برثن قال لا لم يسمع(@)(@@)(@@)(@@) | 634 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال حدثني أبو بكر ابن خلاد قال سمعت يحيى بن سعيد يقول قتادة لم يسمع من سليمان بن يسار(@)(@@)(@@)(@@) | 635 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي نا أبو بكر بن خلاد سمعت يحيى بن سعيد يقول قتادة أراه لم يسمع من طاوس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 635 - (@)(@@) ب قال وحدثني أبو بكر بن خلاد قال سمعت يحيى يعني ابن سعيد يذكر أن قتادة لم يسمع من سليمان بن يسار شيئا(@)(@@)(@@)(@@) | 636 - (@)(@@) قال وحدثني أبو بكر بن خلاد قال وسمعت يحيى يقول قتادة لم يصح عن معاذة(@)(@@)(@@)(@@) | 637 - (@)(@@) سمعت أبي يقول قتادة عن أبي الأحوص مرسل بينهما مورق(@)(@@)(@@)(@@) | 638 - (@)(@@) سألت أبي يقول قتادة لم يسمع من أبي موسى 
ms67	(@)(@@)(@@)(@@) | 639 - (@)(@@) سألت أبا زرعة عن حديث حدثنا به عن سليمان بن حرب وموسى بن إسماعيل عن أبي هلال عن قتادة عن معقل بن يسار قال ما كان شيء أعجب إلى رسول الله صلى الله عليه وسلم من الخيل ثم قال اللهم اغفر لأهل الشاء قال أبو زرعة قتادة عن معقل مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 640 - (@)(@@) سمعت أبي يقول قتادة عن أبي هريرة مرسل وقتادة عن عائشة مرسل ولم يلق قتادة من أصحاب النبي صلى الله عليه وسلم إلا أنسا وعبد الله بن سرجس(@)(@@)(@@)(@@) | 322 - (@)(@@) القاسم بن عبد الرحمن(@)(@@)(@@)(@@) | 641 - (@)(@@) حدثنا محمد بن أحمد بن البراء قال قال علي بن المديني لم يلق(@)(@@)(@@)(@@) | القاسم بن عبد الرحمن (@)(@@) من أصحاب النبي صلى الله عليه وسلم غير جابر بن سمرة قيل له فلقي ابن عمر قال كان يحدث عن ابن عمر بحديثين ولم يسمع من ابن عمر شيئا(@)(@@)(@@)(@@) | 642 - (@)(@@) أخبرنا حرب بن إسماعيل فيما كتب إلي قال قلت لأبي حفص يعني عمرو بن علي القاسم بن عبد الرحمن لقي أحدا من الصحابة قال لا ولكنه يروي عن ابن عمر ولا أشك إلا أنه قد لقيه(@)(@@)(@@)(@@) | 643 - (@)(@@) قال أبو زرعة القاسم بن عبد الرحمن عن أبي عبيدة بن الجراح مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 644 - (@)(@@) سمعت أبي يقول القاسم بن عبد الرحمن عن سعد مرسل(@)(@@)(@@)(@@) $ 323 - القاسم أبو عبد الرحمن(@)(@@)(@@)(@@) | 645 - (@)(@@) سألت أبي عن حديث رواه يحيى بن حمزة عن عروة بن رويم عن القاسم أبي عبد الرحمن قال زارنا سلمان فوقفنا نسلم عليه فقال سمعت النبي صلى الله عليه وسلم يقول إن رباط يوم كصيام سنة فقال أبي الذي عندي أن القاسم لم يدرك سلمان(@)(@@)(@@)(@@) | 324 - (@)(@@) القاسم مولى عبد الرحمن(@)(@@)(@@)(@@) | 646 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | القاسم مولى عبد الرحمن (@)(@@) بن يزيد بن معاوية عن علي مرسل قلت روى ابن وهب عن معاوية بن صالح عن كثير بن الحارث عن القاسم مولى معاوية أنه سمع عليا فلم يعبأ أبو زرعة بهذه الرواية وقطع بأنه مرسل وكذلك رواه عبيد الله بن زحر عن 
ms68	 علي بن يزيد عن القاسم عن علي فقطع أبو زرعة بأنه القاسم مولى عبد الرحمن بن يزيد بن معاوية(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 325 - قرة بن خالد السدوسي(@)(@@)(@@)(@@) | 647 - (@)(@@) سمعت أبي يقول جماعة بالبصرة قد رأوا أنس بن مالك ولم يسمعوا منه منهم قرة بن خالد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الكاف(@)(@@)(@@)(@@) | 326 - (@)(@@) كدير الضبي(@)(@@)(@@)(@@) | 648 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | كدير الضبي (@)(@@) عن النبي صلى الله عليه وسلم روى عنه أبو إسحق الهمداني قال لا نعلم له صحبة(@)(@@)(@@)(@@) | 327 - (@)(@@) كعب بن سور(@)(@@)(@@)(@@) | 649 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | كعب بن سور (@)(@@) ليست له صحبة(@)(@@)(@@)(@@) $ 328 - كعب بن عمرو جد طلحة بن مصرف اليامي(@)(@@)(@@)(@@) | 650 - (@)(@@) حدثنا صالح بن أحمد بن حنبل قال سألت أبي قلت طلحة بن مصرف عن أبيه عن جده له صحبة وما اسم جده قال لا أدري وقد بلغنا عن سفيان بن عيينة أنه أنكر أن يكون له صحبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 651 - (@)(@@) حدثنا العباس بن محمد الدوري قال قيل ليحيى بن معين طلحة بن مصرف عن أبيه عن جده رأى جده النبي صلى الله عليه وسلم فقال يحيى المحدثون يقولون قد رآه وأهل بيت طلحة يقولون ليست له صحبة(@)(@@)(@@)(@@) | 652 - (@)(@@) سألت أبي عن حديث رواه ليث بن أبي سليم عن طلحة عن أبيه عن جده عن النبي صلى الله عليه وسلم أنه مسح برأسه من مقدم رأسه حتى أتى إلى آخر رأسه إلى تحت لحيته فقال أبي يقال أنه طلحة رجل من الأنصار ومنهم من يقول طلحة بن مصرف ولو كان طلحة بن مصرف لم يختلف فيه سئل أبو زرعة عن طلحة الذي يروي عن أبيه عن جده قال رأيت النبي صلى الله عليه وسلم يتوضأ فقال لا أعرف أحدا سمى والد طلحة إلا أن بعضهم يقول ابن مصرف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب اللام(@)(@@)(@@)(@@) | 329 - (@)(@@) الليث بن سعد(@)(@@)(@@)(@@) | 654 - (@)(@@) حدثنا أبي نا إبراهيم بن المنذر نا ابن وهب قال قال(@)(@@)(@@)(@@) | الليث بن سعد (@)(@@) لم أسمع من عبيد الله بن أبي جعفر إنما كان صحيفة كتب إلي ولم أعرضه عليه(@)(@@)(@@)(@@) | 655 - (@)(@@) سئل أبو زرعة عن 
ms69	 الليث بن سعد هل سمع من الأعرج قال أدركه ولم يسمع منه شيئا(@)(@@)(@@)(@@) | 656 - (@)(@@) حدثنا أبو زرعة حدثنا يحيى بن عبد الله بن بكير وسمعته يقول لم يسمع الليث من مشرح بن هاعان شيئا ولا يروى عنه(@)(@@)(@@)(@@) | 657 - (@)(@@) سمعت أبا زرعة وذكر هذا بعقب حديث رواه أبو صالح كاتب الليث وعثمان بن صالح السهمي عن الليث عن مشرح ابن هاعان عن عقبة بن عامر عن النبي صلى الله عليه وسلم أنه قال ألا أخبركم بالتيس المستعار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 330 - (@)(@@) ليث بن أبي سليم(@)(@@)(@@)(@@) | 658 - (@)(@@) سئل أبو زرعة عن(@)(@@)(@@)(@@) | ليث بن أبي سليم (@)(@@) هل سمع من مكحول قال لا هو مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | - باب الميم(@)(@@)(@@)(@@) $ 331 - محمد بن أبي بكر الصديق رضي الله عنه(@)(@@)(@@)(@@) | 659 - (@)(@@) قال أبو زرعة خرج النبي صلى الله عليه وسلم من المدينة في حجته لخمس بقين من ذي القعدة فولدت أسماء بنت عميس محمد بن أبي بكر بذي الحليفة لأربع بقين من ذي القعدة وقدم النبي صلى الله عليه وسلم مكة صبيحة الرابع من ذي الحجة وقبض النبي صلى الله عليه وسلم في شهر ربيع الأول وكانت خلافة أبي بكر سنتين وأشهرا وولد محمد بن أبي بكر في حجة الإسلام بذي الحليفة سنة عشر وتوفي أبو بكر ولمحمد بن أبي بكر أقل من ثلاث سنين(@)(@@)(@@)(@@) | 660 - (@)(@@) وقال أبو زرعة محمد بن أبي بكر عن أبيه مرسل(@)(@@)(@@)(@@) | 132 - (@)(@@) محمد بن عبد الله الشعيثي(@)(@@)(@@)(@@) | 661 - (@)(@@) سألت أبي عن(@)(@@)(@@)(@@) | محمد بن عبد الله الشعيثي (@)(@@) وما حكي عنه شجاع بن أبي نصر أنه لقي أربعة من أصحاب النبي صلى الله عليه وسلم فقال لقيت الحارث بن بدل فقال لم يدرك من أصحاب رسول الله صلى الله عليه وسلم أحدا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 333 - (@)(@@) محمد بن عطية السعدي(@)(@@)(@@)(@@) | 662 - (@)(@@) سألت أبي عن حديث الأوزاعي عن محمد بن خراشة عن عروة بن(@)(@@)(@@)(@@) | محمد بن عطية السعدي (@)(@@) لجده صحبة قال يقولون عن أبيه ولا يذكرون عن جده والحديث عن أبيه وليس بمسند هو مرسل(@)(@@)(@@)(@@) | 434 - (@)(@@) محمد بن حاطب(@)(@@)(@@)(@@) | 663 - (@)(@@) قرىء على 
ms70	 العباس بن محمد الدوري قال قلت ليحيى ابن معين(@)(@@)(@@)(@@) | محمد بن حاطب (@)(@@) قال له رؤية ولا يذكر له صحبة(@)(@@)(@@)(@@) | 664 - (@)(@@) ذكره أبي عن إسحق بن منصور قال قلت ليحيى محمد بن حاطب له رؤية أو صحبة قال رؤية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 335 - (@)(@@) محمد بن عبيد الله الثقفي(@)(@@)(@@)(@@) | 665 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | محمد بن عبيد الله الثقفي (@)(@@) عن سعد مرسل(@)(@@)(@@)(@@) $ 336 - محمد بن عبد الرحمن بن لبيبة ويقال ابن أبي لبيبة(@)(@@)(@@)(@@) | 666 - (@)(@@) سمعت أبي يقول محمد بن عبد الرحمن بن لبيبة لم يدرك سعدا(@)(@@)(@@)(@@) | 667 - (@)(@@) قال أبو زرعة محمد بن عبد الرحمن بن لبيبة عن سعد مرسل(@)(@@)(@@)(@@) | 668 - (@)(@@) قال أبو زرعة محمد بن عبد الرحمن بن لبيبة عن علي مرسل(@)(@@)(@@)(@@) | 337 - (@)(@@) محمد بن عبد الرحمن بن ثوبان(@)(@@)(@@)(@@) | 669 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | محمد بن عبد الرحمن بن ثوبان (@)(@@) عن عثمان مرسل(@)(@@)(@@)(@@) | 338 - (@)(@@) محمد بن عبد الرحمن بن حصين(@)(@@)(@@)(@@) | 670 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | محمد بن عبد الرحمن بن حصين (@)(@@) يروي عنه محمد بن إسحق عن سعد مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 339 - (@)(@@) محمد بن عبد الرحمن بن أبي ليلى(@)(@@)(@@)(@@) | 671 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | محمد بن عبد الرحمن بن أبي ليلى (@)(@@) لم يسمع من أبيه مات لي بوه وهو وهو طفل(@)(@@)(@@)(@@) $ 340 - محمد بن علي بن الحسين بن علي بن أبي طالب عليهم السلام أبو جعفر(@)(@@)(@@)(@@) | 672 - (@)(@@) أخبرنا محمد بن حمويه بن الحسن قال سمعت أبا طالب يعني أحمد بن حميد يقول سألت أحمد بن حنبل عن محمد بن علي سمع من أم سلمة شيئا قال لا يصح أنه سمع قلت فسمع من عائشة فقال لاماتت عائشة قبل أم سلمة(@)(@@)(@@)(@@) | 673 - (@)(@@) سمعت أبي يقول أبو جعفر محمد بن علي لم يلق أم سلمة(@)(@@)(@@)(@@) | 674 - (@)(@@) قال أبو زرعة محمد بن علي بن الحسين عن عمر مرسل(@)(@@)(@@)(@@) | 675 - (@)(@@) قال أبو زرعة محمد بن علي بن الحسين عن علي مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 676 - (@)(@@) سمعت أبا زرعة يقول محمد بن علي بن الحسين بن علي بن أبي طالب رضي الله عنهم لم يدرك هو ولا أبوه علي 
ms71	 عليا رضي الله عنه(@)(@@)(@@)(@@) $ 341 - محمد بن محمود بن محمد بن مسلمة(@)(@@)(@@)(@@) | 677 - (@)(@@) سمعت أبي يقول محمد بن محمود ليست له صحبة هو محمد بن محمود بن محمد ابن مسلمة(@)(@@)(@@)(@@) | 342 - (@)(@@) محمد بن عمرو(@)(@@)(@@)(@@) | 678 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | محمد بن عمرو (@)(@@) الذي يروي سعدان بن يحيى عن موسى بن عبيدة عن أخيه عبد الله بن عبيدة عن محمد بن عمرو روايته عن علي مرسل(@)(@@)(@@)(@@) | 343 - (@)(@@) محمد بن سيرين(@)(@@)(@@)(@@) | 679 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال قال أبي لم يسمع(@)(@@)(@@)(@@) | محمد بن سيرين (@)(@@) من ابن عباس كان يقول في كلها نبئت عن ابن عباس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 680 - (@)(@@) حدثنا محمد بن أحمد بن البراء قال قال علي يعني ابن المديني قال شعبة أحاديث محمد بن سيرين عن ابن عباس إنما سمعها محمد من عكرمة لقية أيام المختار ولم يسمع ابن سيرين من ابن عباس شيئا(@)(@@)(@@)(@@) | 681 - (@)(@@) أخبرنا حرب بن إسماعيل فيما كتب إلي قال قال أحمد بن حنبل ابن سيرين لم يجيء عنه سماع من ابن عباس(@)(@@)(@@)(@@) | 682 - (@)(@@) حدثنا صالح بن أحمد بن حنبل ثنا علي بن المديني قال سمعت الوليد بن خالد الأعرابي قال قال لي شعبة ما أرى محمد بن سيرين سمع عن عقبة بن عبد الغافر(@)(@@)(@@)(@@) | 683 - (@)(@@) سئل أبي عن ابن سيرين سمع من أبي الدرداء قال قد أدركه ولا أظنه سمع منه ذاك بالشام وهذا بالبصرة(@)(@@)(@@)(@@) | 684 - (@)(@@) سمعت أبي يقول ابن سيرين عن كعب بن عجرة مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 685 - (@)(@@) سمعت أبي يقول ابن سيرين لا أعلم سمع من أبي برزة(@)(@@)(@@)(@@) | 686 - (@)(@@) سمعت أبي يقول ابن سيرين لم يسمع من عبيد الله بن عبد الله بن عباس يروي عن يحيى ابن أبي إسحق عن سليمان بن يسار عن عبيد الله بن عبد الله بن عباس(@)(@@)(@@)(@@) | 687 - (@)(@@) سمعت أبي يقول ابن سيرين لم يسمع من عائشة شيئا(@)(@@)(@@)(@@) | 688 - (@)(@@) سمعت أبي يقول لم يلق الحسن ومحمد بن سيرين أبا ذر الغفاري(@)(@@)(@@)(@@) | 689 - (@)(@@) سمعت أبي يقول محمد بن سيرين لم 
ms72	 يدرك أبا بكر رضي الله عنه(@)(@@)(@@)(@@) | 344 - (@)(@@) محمد بن إبراهيم التيمي(@)(@@)(@@)(@@) | 690 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | محمد بن إبراهيم التيمي (@)(@@) عن سعد مرسل(@)(@@)(@@)(@@) | 691 - (@)(@@) سمعت أبي يقول محمد بن إبراهيم التيمي لم يسمع من جابر ولا من أبي سعيد وروى عن أنس حديثا ولم يسمع من عائشة وهو من أقران الزهري وسمع من أنس ورأى ابن عمر وسمع عبد الرحمن بن عثمان التيمي وهو من رهطه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 345 - (@)(@@) محمد بن محمد بن الأسود(@)(@@)(@@)(@@) | 692 - (@)(@@) قال أبو رزعة(@)(@@)(@@)(@@) | محمد بن محمد بن الأسود (@)(@@) عن سعد مرسل(@)(@@)(@@)(@@) | 346 - (@)(@@) محمد بن المنكدر(@)(@@)(@@)(@@) | 693 - (@)(@@) قرىء على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول(@)(@@)(@@)(@@) | محمد بن المنكدر (@)(@@) لم يسمع من أبي هريرة(@)(@@)(@@)(@@) | 694 - (@)(@@) سمعت أبا زرعة يقول محمد بن المنكدر لم يلق أبا هريرة رضي الله عنه(@)(@@)(@@)(@@) $ 347 - محمد بن مسلم بن عبيد الله بن عبد الله بن شهاب الزهري(@)(@@)(@@)(@@) | 695 - (@)(@@) حدثنا صالح بن أحمد بن حنبل نا علي بن المديني قال سمعت سفيان يقول كان عمرو بن دينار أكبر من الزهري سمع من جابر والزهري لم يسمع منه(@)(@@)(@@)(@@) | 696 - (@)(@@) أخبرنا علي بن أبي طاهر فيما كتب إلي نا أحمد بن محمد الأثرم قال قلت لأبي عبد الله أحمد بن حنبل الزهري سمع من أبان بن عثمان قال ما أراه سمع منه وما أدري أو نحو هذا إلا أنه قد أدخل بينه وبينه عبد الله بن أبي بكر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 697 - (@)(@@) حدثنا محمد بن أحمد بن البراء قال قال علي بن المديني قد سمع الزهري من ابن عمر حديثين فيما حدثنا به عبد الرزاق ولم يحفظهما عبد الرزاق إلا أنه ذكر عن الزهري أنه شهد ابن عمر مع الحجاج بعرفات فروى مالك فأدخل بين الزهري وبين ابن عمر في هذا الحديث سالم بن عبد الله(@)(@@)(@@)(@@) | 698 - (@)(@@) حدثنا علي بن الحسن قال قال أحمد بن صالح لم يسمع الزهري من عبد الرحمن بن كعب بن ملك لصلبه شيئا وهو الذي يروي عنه عبد الرحمن بن عبد الله 
ms73	 بن كعب بن مالك(@)(@@)(@@)(@@) | 699 - (@)(@@) حدثنا محمد بن حمويه بن الحسن قال سمعت أبا طالب أحمد بن حميد قال قلت لأحمد بن حنبل الزهري سمع من ابن عمر قال لا(@)(@@)(@@)(@@) | 700 - (@)(@@) أخبرنا علي بن أبي طاهر فيما كتب إلي نا أبو بكر الأثرم قال قلت لأبي عبد الله يعني أحمد بن حنبل الزهري سمع من عبد الرحمن بن أزهر قال ما أراه سمع من عبد الرحمن بن أزهر ثم قال إنما يقول الزهري كان عبد الرحمن بن أزهر يحدث كذا يقول معمر وأسامة سمعت عبد الرحمن بن أزهر ولم يصنعا عندي شيئا ما أراه حفظ وقد أدخل بينه وبينه طلحة بن عبد الله بن عوف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 701 - (@)(@@) قال أبي لم أختلف أنا وأبو زرعة وجماعة من أصحابنا أن الزهري لم يسمع من أبان بن عثمان شيئا وكيف سمع من أبان وهو يقول بلغني عن أبان قيل له فإن محمد بن يحيى النيسابوري كان يقول قد سمع قال محمد بن يحيى كان بابه السلامة(@)(@@)(@@)(@@) | 702 - (@)(@@) قال أبي والزهري لا يثبت له سماع من المسور بن مخرمة يدخل بينه وبينه سليمان بن يسار وعروة بن الزبير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 703 - (@)(@@) قال أبي الزهري لم يسمع من أبان بن عثمان شيئا لا لأنه لم يدركه قد أدركه وأدرك من هو أكبر منه ولكن لا يثبت له السماع منه كما أن حبيب بن أبي ثابت لا يثبت له السماع من عروة بن الزبير وهو قد سمع ممن هو أكبر منه غير أن أهل الحديث قد اتفقوا على ذلك واتفاق أهل الحديث على شيء يكون حجة(@)(@@)(@@)(@@) | 704 - (@)(@@) سألت أبي عن الزهري هل سمع من عاصم بن عمر بن الخطاب فإن الوليد يروي عن مرزوق بن أبي الهذيل عن الزهري عن عاصم بن عمر قال لما أتي بالهرمزان صاحب الأهواز فقال أبي لم يدرك الزهري عاصم بن عمر(@)(@@)(@@)(@@) | 705 - (@)(@@) سمعت أبي يقول الزهري لم يسمع من أبان بن عثمان(@)(@@)(@@)(@@) | 706 - (@)(@@) سمعت أبي يقول الزهري لم يصح سماعه من ابن عمر 
ms74	 رآه ولم يسمع منه ورأى عبد الله بن جعفر ولم يسمع منه(@)(@@)(@@)(@@) | 707 - (@)(@@) سألت أبي عن حديث رواه ابن إسحق فقال ذكر الزهري عن عطاء بن أبي ميمونة فقال الزهري لا يروي عن عطاء بن أبي ميمونة وإنما يروي هذا الحديث شعبة عن عطاء بن أبي ميمونة ولو ذكر ابن إسحق في هذا الحديث خبرا لترك حديث ابن إسحق(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 348 - محمد بن مسلم بن تدرس أبو الزبير(@)(@@)(@@)(@@) | 708 - (@)(@@) حدثنا أبي نا ابن الطباع نا سفيان بن عيينة قال يقولون أبو الزبير المكي لم يسمع من ابن عباس(@)(@@)(@@)(@@) | 709 - (@)(@@) قرىء على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول أبو الزبير المكي لم يسمع من عبد الله بن عمرو بن العاص(@)(@@)(@@)(@@) | 710 - (@)(@@) سمعت أبي يقول أبو الزبير رأى ابن عباس رؤية ولم يسمع من عائشة(@)(@@)(@@)(@@) | 711 - (@)(@@) سألت أبي عن أبي الزبير عن عبد الله بن عمرو فقال هو مرسل لم يلق أبو الزبير عبد الله بن عمرو(@)(@@)(@@)(@@) | 349 - (@)(@@) محمد بن زياد الألهاني(@)(@@)(@@)(@@) | 712 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | محمد بن زياد الألهاني (@)(@@) لم يدرك عوف بن مالك ولم يسمع منه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 350 - (@)(@@) محمد بن عجلان(@)(@@)(@@)(@@) | 713 - (@)(@@) قال أبي(@)(@@)(@@)(@@) | محمد بن عجلان (@)(@@) لم يسمع من صالح مولى التؤمة(@)(@@)(@@)(@@) | 351 - (@)(@@) محمد بن قيس بن الأشعث(@)(@@)(@@)(@@) | 714 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | محمد بن قيس بن الأشعث (@)(@@) مؤذن لكندة عن عمر مرسل(@)(@@)(@@)(@@) | 352 - (@)(@@) محمد بن يحيى بن حبان(@)(@@)(@@)(@@) | 715 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | محمد بن يحيى بن حبان (@)(@@) عن علي مرسل ومحمد بن يحيى بن حبان عن عثمان مرسل(@)(@@)(@@)(@@) | 353 - (@)(@@) محمد بن الوليد الزبيدي(@)(@@)(@@)(@@) | 716 - (@)(@@) سئل أبو زرعة عن(@)(@@)(@@)(@@) | محمد بن الوليد الزبيدي (@)(@@) عن جبير بن نفير فقال هو مرسل لم يدرك الزبيدي جبير بن نفير(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 354 - (@)(@@) محمد بن إسحق بن يسار(@)(@@)(@@)(@@) | 717 - (@)(@@) حدثنا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال قلت لأحمد بن حنبل سمع محمد بن إسحق من مجاهد قال لا(@)(@@)(@@)(@@) | 718 - (@)(@@) قرىء على العباس بن محمد الدوري قال سمعت يحيى يقول محمد 
ms75	 بن إسحق لم يسمع من طلحة بن نافع شيئا(@)(@@)(@@)(@@) | 719 - (@)(@@) سمعت أبي يقول وحدثنا عن محمد بن إبراهيم الأسباطي عن أسباط بن محمد عن مطرف عن خالد السجستاني عن محمد بن إسحق عن سليط عن أبي سعيد الخدري عن النبي صلى الله عليه وسلم في بئر بضاعة قال أبي(@)(@@)(@@)(@@) | : محمد بن إسحق بن يسار (@)(@@) صاحب المغازي بينه وبين سليط رجل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 720 - (@)(@@) سئل أبو زرعة عن ابن إسحق هل سمع من حكيم بن حكيم فقال لم يسمع من حكيم بن حكيم(@)(@@)(@@)(@@) $ 355 - محمد بن ميمون أبو حمزة السكري(@)(@@)(@@)(@@) | 721 - (@)(@@) سمعت أبي يقول كنت أرى أن أبا حمزة السكري أدرك بكير بن الأخنس حتى قيل لي أن المراوزة يدخلون بيهما أيوب بن عائذ(@)(@@)(@@)(@@) $ 356 - محمد بن عبد الرحمن بن أبي ذئب(@)(@@)(@@)(@@) | 722 - (@)(@@) سئل أبو زرعة عن حديث جابر لا طلاق قبل النكاح قال لم يسمع ابن أبي ذئب من عطاء رواه ابن أبي ذئب عن من سمع من عطاء(@)(@@)(@@)(@@) | 723 - (@)(@@) قرىء على العباس بن محمد الدوري قال سمعت يحيى يقول ابن أبي ذئب لم يسمع من عجلان والد محمد بن عجلان وعجلان والد محمد بن عجلان هو مولى فاطمة بنت عتبة بن ربيعة ولكن سمع من عجلان مولى المشمعل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 724 - (@)(@@) سمعت أبي يقول عجلان الذي يروي عنه ابن أبي ذئب هو عجلان مولى المشمعل ولا أعلم روى عن أبي محمد بن عجلان شيئا إنما يروي عن مولى المشمعل وحده(@)(@@)(@@)(@@) | 357 - (@)(@@) محمد بن بشر العبدي(@)(@@)(@@)(@@) | 725 - (@)(@@) قرىء على العباس بن محمد الدوري أنه ذكر ليحيى بن معين حديثا عن(@)(@@)(@@)(@@) | محمد بن بشر العبدي (@)(@@) عن مجاهد بن رومي فقال والله ما سمع محمد بن بشر من مجاهد بن رومي شيئا قط ولكنه مرسل(@)(@@)(@@)(@@) $ 358 - المهلب بن أبي صفرة العتكي(@)(@@)(@@)(@@) | 726 - (@)(@@) حدثنا عمر بن شبه قال سمعت شيخا من آل المهلب قال قيل لشعبة للمهلب بن أبي صفرة صحبة قال لو كان للمهلب صحبة زاد في ذراع قال أبو زيد عمر بن شبه وكان شعبة 
ms76	 مولى عتيك مولى المهلب(@)(@@)(@@)(@@) | 359 - (@)(@@) مسلمة بن مخلد(@)(@@)(@@)(@@) | 727 - (@)(@@) حدثنا محمد بن حمويه بن الحسن قال سمعت أبا طالب يعني أحمد بن حميد قال قال أحمد بن حنبل رحمه الله(@)(@@)(@@)(@@) | مسلمة بن مخلد (@)(@@) ليست له صحبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 360 - مروان بن الحكم بن أبي العاص(@)(@@)(@@)(@@) | 728 - (@)(@@) سمعت أبا زرعة يقول مروان بن الحكم لم يسمع من النبي صلى الله عليه وسلم شيئا كان مروان على عهد النبي صلى الله عليه وسلم ابن خمس سنين أو نحوه(@)(@@)(@@)(@@) | 361 - (@)(@@) منصور بن المعتمر(@)(@@)(@@)(@@) | 729 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | : منصور بن المعتمر (@)(@@) لم يرو عن عكرمة شيئا وذلك أن أبا هانىء إسماعيل ابن خليفة روى عن سفيان عن منصور ومجاهد عن عكرمة في تفسير آية فسمعت أبي يقول ذلك وقال الحديث منكر(@)(@@)(@@)(@@) $ 362 - منصور بن زاذان(@)(@@)(@@)(@@) | 730 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل في كتابه قال قال أبي لم يسمع منصور بن زذان من نافع شيئا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 731 - (@)(@@) قرى على العباس بن محمد الدوري سمعت يحيى ابن معين يقول لم يسمع منصور من الشعبي شيئا(@)(@@)(@@)(@@) | 363 - (@)(@@) مطر بن عكامس(@)(@@)(@@)(@@) | 732 - (@)(@@) ذكره أبي عن إسحق بن منصور عن يحيى بن معين قلت(@)(@@)(@@)(@@) | مطر بن عكامس (@)(@@) له صحبة قال لا وقال أحمد بن حنبل لا(@)(@@)(@@)(@@) | 733 - (@)(@@) سألت أبي عن مطر بن عكامس هل له صحبة قال لا نعرف له صحبة قلت رأى النبي صلى الله عليه وسلم قال لا يدري لم يرو إلا هذا الحديث(@)(@@)(@@)(@@) | 734 - (@)(@@) سألت أبي مرة أخرى عن مطر بن عكامس السلمي الذي يروي عنه أبو إسحق الهمداني هل له صحبة قال لا نعرف له صحبة قلت رأى النبي صلى الله عليه وسلم قال لا يدري لم يرو عن النبي صلى الله عليه وسلم إلا حديثا واحدا وهو إذا كان أجل الرجل بأرض جعل له إليها حاجة(@)(@@)(@@)(@@) | 364 - (@)(@@) محمود بن الربيع(@)(@@)(@@)(@@) | 735 - (@)(@@) حدثنا محمد بن أحمد بن البراء قال قال علي بن المديني(@)(@@)(@@)(@@) | محمود بن الربيع (@)(@@) يعقل مجة مجها النبي صلى الله عليه وسلم في وجهه 
ms77	 من دلو(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 736 - (@)(@@) سمعت أبي يقول محمود بن الربيع ويقال ابن ربيعة الأنصاري الخزرجي أدرك النبي صلى الله عليه وسلم ليست له صحبة وله رؤية مدني(@)(@@)(@@)(@@) | 365 - (@)(@@) محمود بن لبيد(@)(@@)(@@)(@@) | 737 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | محمود بن لبيد (@)(@@) لا نعرف له صحبة وكان البخاري قد كتب أن له صحبة فخط عليه أبي رحمه الله(@)(@@)(@@)(@@) | 366 - (@)(@@) مخلد الغفاري(@)(@@)(@@)(@@) | 738 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | مخلد الغفاري (@)(@@) ليست له صحبة وكان البخاري يقول له صحبة(@)(@@)(@@)(@@) | 367 - (@)(@@) معاوية بن حديج(@)(@@)(@@)(@@) | 739 - (@)(@@) أخبرنا حرب بن إسماعيل فيما كتب إلي قال سئل أحمد بن حنبل عن(@)(@@)(@@)(@@) | معاوية بن حديج (@)(@@) سمع من النبي صلى الله عليه وسلم فسكت(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 740 - (@)(@@) أخبرنا علي بن أبي طاهر فيما كتب إلي نا أحمد بن محمد الأثرم قال قال أبو عبد الله أحمد بن حنبل ليس لمعاوية بن حديج صحبة(@)(@@)(@@)(@@) | 368 - (@)(@@) معاوية بن قرة(@)(@@)(@@)(@@) | 741 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | معاوية بن قرة (@)(@@) عن علي مرسل(@)(@@)(@@)(@@) | 369 - (@)(@@) مسعود بن حراش أخو ربعي بن حراش(@)(@@)(@@)(@@) | 742 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | مسعود بن حراش أخو ربعي بن حراش (@)(@@) هو قديم لم تصح صحبته مع النبي صلى الله عليه وسلم وكان البخاري رحمه الله يقول له صحبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 370 - (@)(@@) مرثد بن وداعة أبو قتيلة الحمصي(@)(@@)(@@)(@@) | 743 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | مرثد بن وداعة أبو قتيلة الحمصي (@)(@@) ليس له صحبة وكان البخاري رحمه الله قد كتب أن له صحبة فخط عليه أبي رحمه الله(@)(@@)(@@)(@@) | 371 - (@)(@@) معقل بن مقرن أخو النعمان بن مقرن(@)(@@)(@@)(@@) | 744 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | معقل بن مقرن أخو النعمان بن مقرن (@)(@@) روى عن النبي صلى الله عليه وسلم مرسل(@)(@@)(@@)(@@) $ 372 - مسعود بن مالك أبو رزين(@)(@@)(@@)(@@) | 745 - (@)(@@) حدثنا صالح بن أحمد بن حنبل نا علي بن المديني قال سمعت يحيى بن سعيد القطان يقول سمعت شعبة ينكر أبو رزين سمع من ابن مسعود(@)(@@)(@@)(@@) | 746 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال أبو رزين مسعود بن مالك قال أبي وكان شعبة ينكر أن يكون سمع من عبد الله بن 
ms78	 مسعود شيئا(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 373 - مجاهد بن جبر(@)(@@)(@@)(@@) | 747 - (@)(@@) حدثنا العباس بن محمد الدوري قال سمعت يحيى بن معين يقول قال يحيى بن سعيد القطان لم يسمع مجاهد عن عائشة رضي الله عنها(@)(@@)(@@)(@@) | 748 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال سمعت أبي يقول كان شعبة ينكر أن يكون مجاهد سمع من عائشة وقال يحيى بن سعيد في حديث موسى الجهني عن مجاهد أخرجت إلينا عائشة أو حدثتني عائشة قال يحيى بن سعيد فحدثت به شعبة فأنكره يعني فأنكره أن يكون مجاهد سمع من عائشة(@)(@@)(@@)(@@) | 749 - (@)(@@) حدثنا صالح بن أحمد بن حنبل نا علي بن المديني قال سمعت يحيى بن سعيد القطان يقول سمعت شعبة ينكر أن يكون مجاهد سمع من عائشة(@)(@@)(@@)(@@) | 750 - (@)(@@) قرىء على العباس بن محمد الدوري قال سمعت يحيى بن معين وسئل عن حديث مجاهد عن عائشة فقال كان يحيى بن سعيد ينكره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 751 - (@)(@@) أخبرنا عبد الله بن أحمد بن حنبل فيما كتب إلي قال سمعت أبي يقول مجاهد لم يسمع من يعلى بن أمية(@)(@@)(@@)(@@) | 752 - (@)(@@) سمعت أبي يقول سمعت يحيى بن معين يقول لم يسمع مجاهد من عائشة(@)(@@)(@@)(@@) | 753 - (@)(@@) قرىء على العباس بن محمد الدوري قال قيل ليحيى بن معين يروي عن مجاهد أنه قال خرج علينا علي رضي الله عنه فقال ليس هذا بشيء(@)(@@)(@@)(@@) | 754 - (@)(@@) حدثنا محمد بن إبراهيم بن شعيب نا عمرو بن علي قال سمعت أبا داود يقول كنا عند شعبة فجاء الحسن بن دينار فقال شعبة يا أبا سعيد ههنا فجلس فقال حدثنا حميد بن هلال عن مجاهد قال سمعت عمر بن الخطاب يقول فجعل شعبة يقول مجاهد سمع عمر فقام الحسن فذهب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 755 - (@)(@@) سمعت أبا زرعة يقول مجاهد عن ابن مسعود مرسل(@)(@@)(@@)(@@) | 756 - (@)(@@) سمعت أبي يقول مجاهد عن سراقة مرسل(@)(@@)(@@)(@@) | 757 - (@)(@@) سمعت أبي يقول مجاهد لم يدرك سعدا إنما يروي عن مصعب بن سعد عن سعد(@)(@@)(@@)(@@) | 758 - (@)(@@) سمعت أبي يقول مجاهد عن عائشة مرسل وعن أبي ذر مرسل(@)(@@)(@@)(@@) | 759 
ms79	 - (@)(@@) سمعت أبي يقول مجاهد عن معاوية مرسل(@)(@@)(@@)(@@) | 760 - (@)(@@) قال أبي بين مجاهد وبين معاوية رجل ليس بمتصل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 761 - (@)(@@) قال أبو زرعة مجاهد عن معاوية مرسل(@)(@@)(@@)(@@) | 762 - (@)(@@) قال أبو زرعة مجاهد عن سعد مرسل(@)(@@)(@@)(@@) | 763 - (@)(@@) قال أبو زرعة مجاهد عن علي مرسل(@)(@@)(@@)(@@) | 764 - (@)(@@) قال أبي رحمه الله مجاهد أدرك عليا لا يذكر رؤية ولا سماع(@)(@@)(@@)(@@) | 765 - (@)(@@) سمعت أبي يقول مجاهد لم يدرك كعب بن عجرة(@)(@@)(@@)(@@) | 374 - (@)(@@) مصعب بن سعد(@)(@@)(@@)(@@) | 766 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | مصعب بن سعد (@)(@@) لم يسمع من معاذ بن جبل(@)(@@)(@@)(@@) | 767 - (@)(@@) قال أبو زرعة مصعب بن سعد لم يسمع من علي(@)(@@)(@@)(@@) | 375 - (@)(@@) ميمون بن مهران(@)(@@)(@@)(@@) | 768 - (@)(@@) حدثنا محمد بن حمويه بن الحسن قال سمعت أبا طالب قال قلت لأحمد بن حنبل(@)(@@)(@@)(@@) | ميمون بن مهران (@)(@@) عن حكيم بن حزام قال لا من أين لقيه لم يرو إلا عن ابن عباس وابن عمر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 769 - (@)(@@) قال أبو زرعة ميمون بن مهران عن سعد مرسل(@)(@@)(@@)(@@) | 376 - (@)(@@) المسيب بن رافع(@)(@@)(@@)(@@) | 770 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | المسيب بن رافع (@)(@@) عن ابن مسعود مرسل(@)(@@)(@@)(@@) | 771 - (@)(@@) سمعت أبي يقول مرة أخرى المسيب بن رافع لم يلق ابن مسعود ولم يلق عليا إنما يروي عن مجاهد ونحوه(@)(@@)(@@)(@@) | 772 - (@)(@@) قال أبو زرعة المسيب بن رافع عن سعيد مرسل(@)(@@)(@@)(@@) | 773 - (@)(@@) قيل لأبي زرعة المسيب بن رافع سمع من عبد الله فقال لا برأسه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 774 - (@)(@@) قال أبي المسيب بن رافع روى عن جابر بن سمرة حديثا ولا أظن سمع منه يدخل بينه وبينه تميم بن طرفة(@)(@@)(@@)(@@) | 377 - (@)(@@) مرة الهمداني(@)(@@)(@@)(@@) | 775 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | مرة الهمداني (@)(@@) عن عمر مرسل(@)(@@)(@@)(@@) | 776 - (@)(@@) سمعت أبي مرة أخرى يقول مرة لم يدرك عمر(@)(@@)(@@)(@@) | 777 - (@)(@@) قال أبو زرعة مرة الهمداني عن عمر مرسل(@)(@@)(@@)(@@) | 378 - (@)(@@) موسى بن يسار الدمشقي(@)(@@)(@@)(@@) | 778 - (@)(@@) سمعت أبي يقول(@)(@@)(@@)(@@) | موسى بن يسار الدمشقي (@)(@@) روى عن أبي هريرة مرسل ولم يدرك أبا هريرة يروي عن محول وعطاء ونافع والزهري روى عنه الأوزاعي وسعيد بن أيوب ويحيى بن حمزة وهو غير عم محمد بن إسحق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 379 - (@)(@@) موسى 
ms80	 بن طلحة بن عبيد الله(@)(@@)(@@)(@@) | 779 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | موسى بن طلحة بن عبيد الله (@)(@@) عن عمر مرسل(@)(@@)(@@)(@@) | 380 - (@)(@@) المطلب بن عبد الله بن حنطب(@)(@@)(@@)(@@) | 780 - (@)(@@) سمعت أبي وذكر(@)(@@)(@@)(@@) | المطلب بن عبد الله بن حنطب (@)(@@) فقال عامة روايته مرسل روى عن عبادة مرسلا لم يدركه وعن أبي هريرة مرسلا وروى عن ابن عباس وابن عمر لا ندري سمع منهما أم لا لا يذكر الخبر وروي عن الأوزاعي عن المطلب قال حدثني رجل عن أصحاب رسول الله صلى الله عليه وسلم ولم يسمه أيضا وقال أيضا حدثني أبو سلمة بن عبد الرحمن فتعجبت منه أنه قد أدرك الصحابة فإذا هو يروي عن التابعين عن أبي سلمة وعن عبد الرحمن بن أبي عمرة عن أبيه غير أني رأيت حديث المطلب يقول حدثني خالي أبو سلمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 781 - (@)(@@) وسألت أبي مرة أخرى قلت المطلب سمع من ابن عباس قال نرى أنه لم يسمع منه(@)(@@)(@@)(@@) | 782 - (@)(@@) قال أبو زرعة المطلب بن عبد الله بن حنطب عن أبي بكر الصديق مرسل(@)(@@)(@@)(@@) | 783 - (@)(@@) قال أبو زرعة المطلب بن عبد الله بن حنطب عن سعد مرسل(@)(@@)(@@)(@@) | 784 - (@)(@@) قال أبي المطلب بن عبد الله لم يدرك عائشة رضي الله عنها(@)(@@)(@@)(@@) | 785 - (@)(@@) سمعت أبي يقول المطلب بن عبد الله بن حنطب عامة حديثه مراسيل لم يدرك أحدا من أصحاب النبي صلى الله عليه وسلم إلا سهل بن سعد وأنسا وسلمة بن الأكوع ومن كان قريبا منهم ولم يسمع من جابر ولا من زيد بن ثابت ولا من عمران بن حصين(@)(@@)(@@)(@@) | 381 - (@)(@@) مسلم بن يسار(@)(@@)(@@)(@@) | 786 - (@)(@@) قال أبو زرعة(@)(@@)(@@)(@@) | مسلم بن يسار (@)(@@) ن ظن عمر مرسل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 787 - (@)(@@) سمعت أبي يقول مسلم بن يسار لم يسمع من عمر بينهما نعيم بن ربيعة(@)(@@)(@@)(@@) $ 382 - مكحول الشامي(@)(@@)(@@)(@@) | 788 - (@)(@@) حدثنا محمد بن حمويه قال سمعت أبا طالب قال قال أحمد بن حنبل مكحول لم يسمع من زيد شيئا إنما هو بلغه(@)(@@)(@@)(@@) | 789 - (@)(@@) حدثنا أبي قال سألت أبا سهر هل سمع مكحول من أحد من أصحاب 