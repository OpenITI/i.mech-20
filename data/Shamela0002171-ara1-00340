ms321	 ذر وعنه الاعمش وحصين مات 96 وقيل بضع وثمانين ع(@)(@@)(@@)(@@) | 1759- (@)(@@) زيد بن يثيع عن أبي بكر وأبي ذر وعنه أبو إسحاق فقط وثق حب ت(@)(@@)(@@)(@@) | 1760- (@)(@@) زيد بن يحيى بن عبيد الدمشقي عن خليد بن دعلج والاوزاعي وعنه أحمد والدارمي ثقة توفي 207 د س ق(@)(@@)(@@)(@@) | 1761- (@)(@@) زيد بن يزيد أبو معن الرقاشي بصري عن معتمر وغندر وعنه مسلم والحسين بن إسحاق التستري ثقة م(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1762- (@)(@@) زيد أبو أسامة الحجام كوفي عن الشعبي ومجاهد وعنه أبو معاوية وأبو نعيم ثقة س(@)(@@)(@@)(@@) | 1763- (@)(@@) زيد أبو يسار صحابي عنه ابنه يسار د ت(@)(@@)(@@)(@@) | 1764- (@)(@@) زيد عن أبي موسى وعنه سبطه الربيع بن أنس د(@)(@@) *- زيد الخثعمي هو بن عطية 1747(@)(@@) *- زيد العمي هو بن الحواري 1732 زيد أبو الحكم هو بن أبي الشعثاء(@)(@@) *- زيد أبو الحكم هو بن أبي الشعثاء 1741(@)(@@) *- زيد أبو عتاب هو بن أبي عتاب 1745(@)(@@) *- زيد أبو عياش هو بن عياش 1752(@)(@@) PageV00P000(@)(@@)(@@)(@@) | حرف السين(@)(@@)(@@)(@@) | 1765- (@)(@@) سابق بن ناجية عن أبي سلام وعنه هاشم بن بلال وثق حب د ق(@)(@@)(@@)(@@) | 1766- (@)(@@) سالم بن أبي أمية أبو النضر المدني عن أنس وعن بن أبي أوفى إجازة وعنه مالك والليث ثقة نبيل توفي 129 ع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1767- (@)(@@) سالم بن أبي الجعد الاشجعي مولاهم الكوفي عن عمر وعائشة وهو مرسل وعن بن عمر(@)(@@) وابن عباس وعنه منصور والاعمش توفي سنة مائة ثقة ع(@)(@@)(@@)(@@) | 1768- (@)(@@) سالم بن أبي حفصة أبو يونس الكندي عن الشعبي وإبراهيم بن يزيد التيمي وعنه السفيانان وابن فضيل شيعي لا يحتج بحديثه توفي تقريبا 14 ت(@)(@@)(@@)(@@) | 1769- (@)(@@) سالم أبو جميع القزاز بصري عن الحسن ومحمد وعنه مسدد والتبوذكي صدوق وثقه بن معين وقال أبو زرعة لين د(@)(@@) *- سالم بن رزين الاحمري عن سالم بن عبد الله وعلقمةبن مرثد وقيل رزين بن سليمان س ق 1574(@)(@@)(@@)(@@) | 1770- (@)(@@) سالم بن أبي سالم الجيشاني عن أبيه وعبد الله بن عمرو وعنه عبيد الله بن أبي جعفر ويزيد بن أبي حبيب ثقة م د س(@)(@@)(@@)(@@) | 1771- (@)(@@) سالم بن سرج ويقال بن النعمان عن مولاته أم صبية 
ms322	 وعنه أسامة بن زيد وخارجة بن الحارث ثقة د ق(@)(@@)(@@)(@@) | 1772- (@)(@@) سالم بن شوال عن مولاته أم حبيبة وعنه عطاء وعمرو بن دينار ثقة م س(@)(@@)(@@)(@@) | 1773- (@)(@@) سالم بن عبد الله بن عمر أحد فقهاء التابعين عن أبيه وأبي هريرة وعنه الزهري وصالح بن كيسان قال مالك لم يكن أحد في زمان سالم أشبه بمن مضى في الزهد والفضل والعيش الخشن منه توفي 106 ع(@)(@@)(@@)(@@) | 1774- (@)(@@) سالم بن عبد الله النصري وهو سالم مولى شداد وسالم سبلان وسالم مولى المهري وسالم مولى دوس عن أبي سعيد وأبي هريرة وعنه نعيم المجمر ويحيى بن أبي كثير م د س ق(@)(@@)(@@)(@@) | 1775- (@)(@@) سالم بن عبد الله البصري ثم المكي الخياط عن الحسن وابن أبي مليكة وعنه عبيد الله بن(@)(@@) PageV00P000(@)(@@) موسى وأبو عاصم ضعف ت ق(@)(@@)(@@)(@@) | 1776- (@)(@@) سالم بن عبد الله أبو المهاجر الرقي عن ميمون بن مهران ومكحول وعنه إسماعيل بن عياش ومعمر بن سليمان وثقه أحمد توفي 161 ق(@)(@@)(@@)(@@) | 1777- (@)(@@) سالم بن عبد الواحد أبو العلاء المرادي الكوفي عن ربعي بن حراش والحسن وعنه وكيع ويعلى ضعف وقد وثق حب ت(@)(@@)(@@)(@@) | 1778- (@)(@@) سالم بن عبيد له صحبة عنه نبيط بن شريط وهلال بن يساف 4(@)(@@)(@@)(@@) | 1779- (@)(@@) سالم بن عتبة بن عويم عن أبيه عن جده وعنه محمد بن طلحة التيمي ق(@)(@@)(@@)(@@) | 1780- (@)(@@) سالم بن عجلان الحراني الافطس عن سعيد بن جبير وأبي عبيدة بن عبد الله وعنه سفيان ومروان بن شجاع وثقه أحمد قتله عبد الله بن علي 132 خ د س ق(@)(@@)(@@)(@@) | 1781- (@)(@@) سالم بن غيلان التجيبي عن يزيد بن أبي حبيب والوليد بن قيس وعنه بن لهيعة وابن وهب صدوق د ت س(@)(@@) *- سالم بن أبي المهاجر هو بن عبد الله 1776(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1782- (@)(@@) سالم بن نوح العطار أبو سعيد البصري عن الجريري ويونس بن عبيد وعنه أحمد وبندار قال أبو حاتم وغيره لا يحتج به وقال أبو زرعة صدوق م د ت س(@)(@@)(@@)(@@) | 1783- (@)(@@) سالم البراد كوفي عن بن مسعود وأبي مسعود وعنه عبد الملك بن عمير وإسماعيل بن أبي خالد 
ms323	 ثقة صالح د س(@)(@@)(@@)(@@) | 1784- (@)(@@) سالم الفراء عن زيد بن أسلم وعدة وعنه عمرو بن الحارث وثق حب د(@)(@@)(@@)(@@) | 1785- (@)(@@) سالم مكي عن صحابي أعرابي وعنه بن إسحاق د(@)(@@)(@@)(@@) | 1786- (@)(@@) سالم أبو الغيث مولى عبد الله بن مطيع عن أبي هريرة وعنه ثور بن زيد وصفوان بن سليم حجة ع(@)(@@)(@@)(@@) | 1787- (@)(@@) سالم عن عمرو بن وابصة وعنه إسحاق بن راشد د(@)(@@) *- سالم الافطس بن عجلان 178(@)(@@) *- سالم الخياط بن عبد الله 1775(@)(@@) *- سالم سبلان بن عبد الله 1774(@)(@@) *- سالم المرادي بن عبد الواحد 1777(@)(@@) *- سالم أبو جميع هو بن دينار 1769(@)(@@) *- سالم أبو المهاجر بن عبد الله 1776(@)(@@) *- سالم أبو النضر بن أبي أمية 1766(@)(@@)(@@)(@@) | 1788- (@)(@@) السائب بن حبيش الكلاعي عن معدان بن أبي طلحة وعنه زائدة وحفص بن عمر الحلبي صدوق د س(@)(@@)(@@)(@@) | 1789- (@)(@@) السائب بن خباب أبو مسلم المدني صاحب المقصورة يقال له صحبة عنه إسحاق بن سالم ومحمد بن عمرو بن عطاء ق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1790- (@)(@@) لسائب بن خلاد بن سويد الخزرجي صحابي عنه ابنه خلاد وعطاء بن يسار 4(@)(@@)(@@)(@@) | 1791- (@)(@@) السائب بن أبي السائب صيفي بن عابد المخزومي شريك النبي صلى الله عليه وسلم قبل الوحي ووالد قارئ مكة عبد الله من الطلقاء عنه قائده د س ق(@)(@@)(@@)(@@) | 1792- (@)(@@) السائب بن عمر المخزومي عن بن أبي مليكة وجماعة وعنه القطان وأبو عاصم ثقة د س(@)(@@)(@@)(@@) | 1793- (@)(@@) السائب بن فروخ أبو العباس المكي الشاعر الاعمى عن عبد الله بن عمرو وابن عمر وعنه عطاء وعمرو بن دينار ثقة ع(@)(@@) *- السائب بن أبي لبابة في ترجمة ابنه حسين(@)(@@)(@@)(@@) | 1794- (@)(@@) السائب بن مالك ويقال بن زيد عن علي وعمار وعنه ابنه عطاء وأبو إسحاق ثقة 4(@)(@@)(@@)(@@) | 1795- (@)(@@) السائب بن يزيد بن أخت نمر الكندي صحابي وله عن عمر وعنه ابنه عبد الله والزهري ويحيى بن سعيد توفي 91 وقيل 86 ع(@)(@@)(@@)(@@) | 1796- (@)(@@) السائب عن مولاه أبي محذورة وعنه ابنه عثمان وثق حب د س(@)(@@)(@@)(@@) | 1797- (@)(@@) سباع بن ثابت عن عمر وأم كرز وعنه عبيد الله بن أبي يزيد وثق 4(@)(@@)(@@)(@@) | 1798- (@)(@@) سباع بن النضر أبو مزاحم 
ms324	 السمرقندي عن بن المديني وعنه الترمذي ت(@)(@@)(@@)(@@) | 1799- (@)(@@) سبرة بن عبد العزيز الجهني أخو حرملة عن أبيه وعمه عبد الملك وعنه هشام بن عمار وابن كاسب وثق د(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1800- (@)(@@) سبرة بن الفاكه صحابي عنه سالم بن أبي الجعد وعمارة بن خزيمة س(@)(@@)(@@)(@@) | 1801- (@)(@@) سبرة بن معبد الجهني له صحبة نزل ذا المروة عنه ابنه الربيع م 4(@)(@@)(@@)(@@) | 1802- (@)(@@) سبيع بن خالد عن حذيفة وعنه نصر بن عاصم وقتادة د(@)(@@)(@@)(@@) | 1803- (@)(@@) سحيم مولى بني زهرة عن أبي هريرة وعنه بن شهاب وثق س(@)(@@)(@@)(@@) | 1804- (@)(@@) سخبرة بن عبد الله يقال له صحبة عنه ابنه عبد الله ت(@)(@@)(@@)(@@) | 1805- (@)(@@) سراج بن مجاعة اليمامي عن أبيه وعنه هلال وثق د(@)(@@)(@@)(@@) | 1806- (@)(@@) سرار بن مجشر أبو عبيدة بصري ثقة عن أيوب وعطاء السليمي وعنه سيف بن عبيد الله وعمار بن عثمان الحلبي توفي 165 س(@)(@@)(@@)(@@) | 1807- (@)(@@) سراقة بن مالك بن جعشم المدلجي نزيل قديد صحابي عنه بن المسيب ومجاهد مرسلا توفي سنة أربع وعشرين خ 4(@)(@@)(@@)(@@) | 1808- (@)(@@) سرق بن أسد صحابي نزل مصر روى عنه رجل يجهل ق(@)(@@)(@@)(@@) | 1809- (@)(@@) سريج بن النعمان البغدادي اللؤلؤي أبو الحسين ثقة عالم عن بن الماجشون وفليح وعنه البخاري وإبراهيم الحربي ثقة مات 217 خ 4(@)(@@)(@@)(@@) | 1810- (@)(@@) سريج بن يونس أبو الحارث البغدادي العابد الحافظ عن إسماعيل بن جعفر وعباد بن عباد وعنه مسلم والبغوي قال أبو حاتم صدوق توفي 235 خ م س(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1811- (@)(@@) سريع بن عبد الله الواسطي الجمال عن إسحاق الازرق وعنه النسائي وبحشل س(@)(@@)(@@)(@@) | 1812- (@)(@@) السري بن إسماعيل الهمداني عن قيس بن أبي حازم والشعبي وعنه مكي وعبيد الله بن موسى تركوه ق(@)(@@)(@@)(@@) | 1813- (@)(@@) السري بن مسكين عن بن أبي ذئب وغيره وعنه جعفر بن مسافر والزبير بن بكار صدوق ق(@)(@@)(@@)(@@) | 1814- (@)(@@) السري بن يحيى الشيباني البصري عن الحسن وعمرو بن دينار وعنه بن وهب ومسلم قال(@)(@@) القطان ثقة ثبت مات 167 س(@)(@@)(@@)(@@) | 1815- (@)(@@) السري بن ينعم الجبلاني عن أبيه وعامر بن جشيب وعنه بقية وأبو المغيرة وثق س(@)(@@)(@@)(@@) | 1816- (@)(@@) سعاد بن سليمان عن عون بن أبي