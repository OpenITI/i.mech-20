ms1081	 وأبو الوليد يعتبر حديثه إذا روى عنه الثقات.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن عبد الحميد الحنفي(@)(@@) من أهل اليمامة، يروي عن هوذة بن قيس، روى عنه ملازم بن عمرو والسرى بن هوذة. 9273 عبد الحميد بن مسافع قوله، روى عنه ابن عون. 9274 عبد الحميد مولى بني هاشم، يروي عن أبيه، روى عنه عمرو بن الحارث عن سالم الفراء عنه. 9275 أبو يحيى الحماني عبد الحميد بن عبد الرحمن الذي يقال له: بشمين وحمان من تميم، يروي عن الأعمش، وابن أبي خالد، روى عنه ابنه يحيى بن عبد الحميد، وكان يحيى بن معين يقول الحماني، وأبوه ثقات.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن صيفي بن صهيب بن سنان القرشي(@)(@@) مولى بني PageV01P002 [ج 4: ص 73] جدعان، يروي عن أبيه عن جده، روى عنه ابن المبارك، والرقاع بن دغفل.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن جعفر بن عبد الله بن الحكم بن رافع بن سنان أبو حفص الأوسي الأنصاري(@)(@@) من أهل المدينة، وقد قيل: كنيته أبو الفضل، يروي عن محمد بن عمرو بن عطاء وأبيه، روى عنه هشيم ويحيى القطان، مات سنة ثلاث وخمسين ومائة وهو ابن سبعين ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن عبد الله بن كثير المكي القرشي(@)(@@) من بني عبد الدار، يروي عن سعيد بن ميناء، روى عنه عبد الرحمن بن مهدي والعقدي وأحسبه أخا صدقة بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن سنان(@)(@@) يروي عن عبيد بن عمير الليثي، روى عنه يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن حبيب أبو عبد الغفار(@)(@@) يروي عن عطاء، روى عنه عبد الله بن عثمان بن جبلة.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن أبي البداح بن عاصم بن عدي الأنصاري(@)(@@) أحد بني العجلان من أهل المدينة، يروي عن عبد الرحمن بن يزيد بن جارية، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن المثنى(@)(@@) يروي عن نافع بن عبد الحارث عن عمر، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن زياد العبدي(@)(@@) من أهل البصرة، كنيته أبو بشر مولى لعبد 
ms1082	 قيس، يروي عن حميد الطويل، روى عنه ابن مهدي وأهل بلده، مات سنة ست وسبعين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 74](@)(@@)(@@)(@@) ||| AUTO عبد الواحد المالكي(@)(@@) يروي عن سالم بن عبد الله، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن قيس الشامي(@)(@@) يروي عن عروة بن الزبير، روى عنه الأوزاعي وثور بن يزيد وهو الذي، يروي عن أبي هريرة، ولم يره ولا يعتبر بمقاطيعه ولا بمراسيله ولا برواية الضعفاء عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن سليم(@)(@@) يروي عن عطاء، روى عنه أبو داود الحفري وعلي بن الجعد.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن أبي عون الدوسي(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل المدينة يخطئ، مات بطرف القدوم سنة أربع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن صفوان بن أبي عياش(@)(@@) من أهل المدينة سكن البصرة، يروي عن أبيه، وعكرمة، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن زيد العابد، كنيته أبو عبيدة(@)(@@) من أهل البصرة له حكايات كثيرة في الزهد والرقائق، يروي عن الحسن ومالك بن دينار، روى عنه أهل بلده، يعتبر بحديثه إذا كان دونه وفوقه ثقات ويجتنب ما كان من حديثه من رواية سعيد بن عبد الله بن دينار فإن سعيدا يأتى بما لا أصل له عن الإثبات.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن موسى(@)(@@) يروي عن محرر بن أبي هريرة، روى عنه ضمرة بن ربيعة.(@)PageV01P002(@)(@@) [ج 4: ص 75](@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن موسى بن أبي موسى أبو معن(@)(@@) قوله، روى عنه أسامة بن زيد.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن أيمن(@)(@@) مولى أبي عمرو المخزومي المكي، كنيته أبو القاسم وهو والد القاسم بن عبد الواحد بن أيمن، يروي عن عروة بن الزبير وأبيه، روى عنه وكيع بن الجراح والكوفيون.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن حمزة بن عبد الله بن الزبير بن العوام القرشي(@)(@@) أخو عباد بن حمزة، يروي عن عباد بن عبد الله بن الزبير، روى عنه موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن عبد الواحد الثقفي(@)(@@) يروي عن أبي مجيب الشامي عن أبي هريرة، روى 
ms1083	 عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عبد الواحد بن نفيع بن علي الكلاعي(@)(@@) يروي عن عبد الله بن رافع بن خديج، روى عنه حرمي بن عمارة، وهو الذي يروي عنه موسى بن إسماعيل التبوذكي، ويقول: حدثنا عبد الواحد بن نافع أبو الرماح، عن ابن رافع بن خديج.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن هاشم(@)(@@) من أهل البصرة، يروي عن حنبل بن عبد الله.(@)(@@) (370) -[4: 75] عن الهرماس بن زياد، قال: " رأيت النبي صلى الله عليه وسلم يصلي في نعليه ". حدثناه عبد الله بن جابر بطرسوس، ثنا محمد بن يزيد المستملي، ثنا عبد السلام بن هاشم البصري، ثنا حنبل بن عبد الله(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن حفص الليثي أبو مصعب المدني(@)(@@) يروي عن PageV01P002 [ج 4: ص 76] عبد الله بن دينار، وابن الهاد، روى عنه أبو عامر العقدي وخالد بن مخلد.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد السلام البجلي(@)(@@) يروي المراسيل، روى عنه إسماعيل بن أبي خالد.(@)(@@) عبد السلام(@)(@@) مولى يحيى بن سعيد عداده في أهل الكوفة، يروي عن ابن المسيب، والشعبي، روى عنه شعبة، وهشيم.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن مصعب(@)(@@) يروي عن أبي حازم، روى عنه عبد الله بن موسى.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن صالح بن كثير الدارمي(@)(@@) يروي عن الأزرق بن قيس، روى عنه يزيد بن هارون.(@)(@@) عبد السلام(@)(@@) شيخ، يروي عن الزهري، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن سليم(@)(@@) يروي عن يزيد بن سمرة عداده في أهل الشام، روى عنه الأوزاعي.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن عجلان أبو الخليل العدوي(@)(@@) يروي عن أبي عثمان النهدي وعبيدة الهجيمي، روى عنه بدل بن المحبر ويعقوب بن إسحاق الحضرمي يخطئ ويخالف.(@)(@@) عبد السلام(@)(@@) يروي عن أبي داود الثقفي عن ابن عمر، روى عنه سعيد بن بشير إن لم يكن بن سليم فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO عبد السلام الأحمسي(@)(@@) يروي عن أبيه عن علي، روى عنه محمد بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن سليمان أبو همام العبدي(@)(@@) يروي عن البصريين وداود بن أبي هند، روى عنه حرمي 
ms1084	 بن عمارة والتبوذكي.(@)PageV01P002(@)(@@) [ج 4: ص 77](@)(@@)(@@)(@@) ||| AUTO عبد السلام بن شعيب بن الحبحاب المعولي الأزدي(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه عبد القدوس بن عبد الكبير والبصريون، مات سنة أربع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن صالح بن كثير أبو عمرو الدارمي(@)(@@) يروي عن ثابت البناني، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد السلام بن حرب أبو بكر الملائي(@)(@@) من أهل الكوفة، يروي عن يحيى بن سعيد الأنصاري والبصريين، روى عنه أبو غسان وأبو نعيم وأهل العراق، مات سنة ست أو سبع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الأعلى بن أبي حاضر(@)(@@) من أهل البصرة، يروي عن أبي رجاء العطاردي، روى عنه عمر بن عبد الله الرومي.(@)(@@)(@@)(@@) ||| AUTO عبد الأعلى بن عبد الله بن عامر بن كريز القرشي(@)(@@) عداده في أهل البصرة، يروي عن عبد الله بن الحارث، روى عنه خالد الحذاء.(@)(@@)(@@)(@@) ||| AUTO عبد الأعلى بن ميمون بن مهران الجزري(@)(@@) مولى الأزد، كنيته أبو عبد الرحمن، يروي عن عطاء وعكرمة وأبيه، روى عنه جعفر بن برقان، مات قبل عمرو بن ميمون، ومات عمرو بن ميمون سنة أربع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الأعلى الجعفي(@)(@@) يروي المقاطيع عن إبراهيم النخعي، روى عنه الكوفيون.(@)(@@) عبد الأعلى(@)(@@) من قراء أهل الشام، قوله، روى عنه هلال بن يساف.(@)PageV01P002(@)(@@) [ج 4: ص 78](@)(@@)(@@)(@@) ||| AUTO عبد الأعلى بن خالد(@)(@@) يروي عن الحارث بن يعقوب المراسيل، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO عبد الأعلى بن عبد الله بن أبي فروة أبو محمد الأموي(@)(@@) مولى عثمان بن عفان عداده في أهل المدينة، يروي عن الزهري، روى عنه عباد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الأعلى بن عبد الأعلى بن عبد الله بن شراحيل الشامي أبو محمد(@)(@@) من أهل البصرة، وقيل: أبو همام كان يكره أن يقال له: أبو همام، يروي عن حميد الطويل، روى عنه مسدد وأهل البصرة، مات يوم الأحد في شهر شعبان سنة أربع أو سبع وثمانين ومائة وكان قدريا متقنا في الحديث غير داعية إليه.(@)(@@)(@@)(@@) ||| AUTO عبد الأعلى التيمي(@)(@@) قوله، روى عنه 
ms1085	 مسعر بن كدام.(@)(@@)(@@)(@@) ||| AUTO عبد الكريم البصري(@)(@@) شيخ، يروي عن حميد بن هلال، روى عنه عيسى بن موسى الغنجار.(@)(@@)(@@)(@@) ||| AUTO عبد الكريم بن محمد اللخمي(@)(@@) من أهل دمشق، يروي عن عروة بن رويم اللخمي، روى عنه سليمان بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الكريم بن الحارث بن يزيد الحضرمي(@)(@@) من أهل مصر، يروي عن مشرح بن هاعان، روى عنه الليث بن سعد، ويحيى بن أيوب.(@)(@@)(@@)(@@) ||| AUTO عبد الكريم بن سليط الحنفي(@)(@@) من أهل مرو، يروي عن عبد الله بن بريدة، روى عنه المراوزة.(@)PageV01P002(@)(@@) [ج 4: ص 79](@)(@@)(@@)(@@) ||| AUTO عبد الكريم الصفار(@)(@@) يروي عن أبي نضرة وحرب بن ميمون، روى عنه حرمي بن عمارة.(@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن يحيى بن عباد بن عبد الله بن الزبير بن العوام الأسدي(@)(@@) يروي عن المدنيين، روى عنه جويرية بن أسماء.(@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن الحارث(@)(@@) يروي عن الحسن، روى عنه عيسى الأزرق أبو خالد الحنفي قاضي سرخس.(@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن عكرمة(@)(@@) يروي عن كريمة بنت عمارة جدته عن عائشة، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن أبي بكر(@)(@@) واسم أبيه رفيع من أهل المدينة، يروي عن الزهري، روى عنه يزيد بن الهاد والداروردي.(@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن عمرو بن شرحبيل(@)(@@) يروي عن سعيد بن عمرو عداده في أهل المدينة، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن عبد المجيد بن الصلت بن عبيد الله بن الحكم بن أبي العاص الثقفي أبو محمد(@)(@@) من أهل البصرة، يروي عن يحيى بن سعيد الأنصاري وحميد الطويل، مات سنة أربع وثمانين ومائة، وقد قيل: سنة أربع وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن عبد ربه الثوري(@)(@@) يروي عن الحسن، قوله، روى عنه البصريون.(@)PageV01P002(@)(@@) [ج 4: ص 80](@)(@@)(@@)(@@) ||| AUTO عبد الوهاب بن عطاء الخفاف، كنيته أبو نصر العجلي(@)(@@) من أهل البصرة سكن بغداد، يروي عن سليمان التيمي، روى عنه أحمد بن حنبل، وأهل العراق، مات سنة أربع ومائتين ببغداد لثلاث عشرة بقيت من المحرم.(@)(@@)(@@)(@@) ||| AUTO عبد الرحيم بن كردم بن أرطبان بن 
ms1086	 عم عبد الله بن عون، كنيته أبو مرحوم(@)(@@) من أهل البصرة، يروي عن زيد بن أسلم، روى عنه العقدي ومعلي بن أسد كان يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبد الرحيم بن جابر بن ربيعة الضبي(@)(@@) من أهل الكوفة، يروي عن مجمع بن عتاب، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عبد الرحيم بن عبد ربه(@)(@@) يروي عن الحارث بن أبي عباس عن أبي الطفيل، روى عنه الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO عبد الرحيم بن ميمون(@)(@@) من أهل مصر، كنيته أبو مرحوم، يروي عن سهل بن معاذ بن أنس والمصريين، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحيم بن سعيد الأبرص(@)(@@) أخو محمد بن سعيد بن قيس المصلوب، يروي عن الزهري قدم بغداد وحدثهم بها، روى عنه يحيى بن معين الحرف بعد الحرف ثبت.(@)(@@)(@@)(@@) ||| AUTO عبد الرحيم بن سليمان(@)(@@) من أهل الكوفة مولى محمد بن يحيى الثقفي، يروي عن الأعمش، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO عبد الصمد بن معقل بن منبه اليماني(@)(@@) ابن أخي وهب بن منبه، يروي عن عمه وهب بن منبه، روى عنه إسماعيل بن عبد الكريم الصنعاني، وابنه يونس بن عبد الصمد، مات سنة ثلاث وثلاثين ومائة وقد، قال: بعض ولده إنه، مات سنة خمس وتسعين ومائة والأول أشبه.(@)PageV01P002(@)(@@) [ج 4: ص 81](@)(@@)(@@)(@@) ||| AUTO عبد الصمد أبو معمر(@)(@@) يروي عن بكر بن عبد الله المزني، قوله، روى عنه عبد الله بن يزيد المقرئ.(@)(@@)(@@)(@@) ||| AUTO عبد الجبار بن وائل بن حجر الكندي(@)(@@) يروي عن أمه عن أبيه، وهو أخو علقمة بن وائل ومن زعم أنه سمع أباه فقد وهم، لأن وائل بن حجر مات وأمه حامل به ووضعته بعد موت وائل بستة أشهر عداده في أهل الكوفة، روى عنه أبو إسحاق السبيعي، وابنه سعيد بن عبد الجبار، مات سنة اثنتي عشرة ومائة وكنيته أبو محمد.(@)(@@)(@@)(@@) ||| AUTO عبد الجبار الخولاني(@)(@@) يروي عن كعب، روى عنه العوام بن حوشب.(@)(@@)(@@)(@@) ||| AUTO عبد الجبار بن نبيه بن وهب(@)(@@) من بني عبد الدار، يروي عن أبيه عداده في أهل المدينة، روى 
ms1087	 عنه فليح بن سليمان، وأهلها.(@)(@@)(@@)(@@) ||| AUTO عبد الجبار بن المغيرة(@)(@@) يروي عن أبي كثير عن علي، روى عنه القاسم بن مالك المزني.(@)(@@)(@@)(@@) ||| AUTO عبد الجبار بن أبي حازم(@)(@@) يروي عن أبيه، عن سهل بن سعد عن النبي صلى الله عليه وسلم " اللهم اغفر للصحابة واغفر لمن رآهم ". رواه هشيم، عن أبي يحيى المدني عنه. وهو أخو عبد العزيز بن أبي حازم، وأحسب أن أبا يحيى المدني هذا هو فليح بن سليمان(@)(@@)(@@)(@@) ||| AUTO عبد الجبار بن مسلم الدمشقي(@)(@@) أخو الوليد بن مسلم، يروي عن الزهري.(@)(@@) (371) -[4: 81] عن عبيد الله بن عبد الله، عن ابن عباس، قال: " إنما حرم من الميتة لحمها ". رواه محمد بن عبد الرحمن بن سهم، عن الوليد بن مسلم، عن أخيه عبد الجبار بن مسلم، عن الزهري(@)(@@)(@@)(@@) ||| AUTO عبد الجبار بن سعيد أبو معاوية القرشي مدني(@)(@@) يروي عن الحجازيين، روى عنه أهل بلده.(@)PageV01P002(@)(@@) [ج 4: ص 82](@)(@@)(@@)(@@) ||| AUTO عبد الجبار بن الورد(@)(@@) أخو وهيب بن الورد المكي، يروي عن ابن أبي مليكة، روى عنه أهل الحجاز يخطئ ويهم.(@)(@@)(@@)(@@) ||| AUTO عبد المجيد بن سهل بن عبد الرحمن بن عوف الزهري القرشي(@)(@@) من أهل المدينة، يروي عن سعيد بن المسيب، روى عنه مالك، وسليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO عبد المجيد بن محمد بن أبي عبس بن جبر الأوسي الأنصاري(@)(@@) من أهل المدينة، يروي عن أبيه عن جده، روى عنه محمد بن طلحة التيمي.(@)(@@)(@@)(@@) ||| AUTO عبد المجيد الفارض(@)(@@) يروي عن قبيصة بن ذؤيب الخزاعي، روى عنه قتادة، كنيته أبو محمد، مات سنة أربع وستين ومائة أمه أم ولد.(@)(@@)(@@)(@@) ||| AUTO عبد المجيد المعلم(@)(@@) يروي عن الحسن، روى عنه أبو داود، وعبد الصمد.(@)(@@)(@@)(@@) ||| AUTO عبد المجيد بن أبي زريق الهلالي(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه يزيد بن هارون.(@)(@@)(@@)(@@) ||| AUTO عبد الجليل بن حميد الفلسطيني(@)(@@) يروي عن رجل عن أبي هريرة، روى عنه زيد بن أسلم.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد المؤمن بن خالد الحنفي، كنيته أبو خالد(@)(@@) من أهل مرو، يروي عن عبد الله بن بريدة، 
ms1088	 روى عنه يحيى بن واضح وزيد بن الحباب.(@)(@@) عبد المؤمن(@)(@@) يروي عن سعيد بن جبير، روى عنه أحمد بن بشير.(@)PageV01P002(@)(@@) [ج 4: ص 83](@)(@@)(@@)(@@) ||| AUTO عبد المؤمن بن أبي شراعة العبدي(@)(@@) من أهل البصرة، يروي عن جماعة من التابعين، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عبد الحكيم بن عبد الله بن أبي فروة أبو عبد الله المدني(@)(@@) مولى عثمان بن عفان، يروي عن سعيد بن المسيب، روى عنه ابن المبارك، وهم إخوة أربعة عبد الحكيم، وعبد الأعلى وصالح وإسحاق بنو عبد الله بن أبي فروة، مات عبد الحكيم سنة ست وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الحكم بن صهيب(@)(@@) يروي عن جعفر بن عبد الله بن أبي الحكم المراسيل روى العقدي عن عبد الله بن جعفر عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الحكم بن عبد الله بن يعلى(@)(@@) يروي عن أبيه، عن عمر، روى عنه معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الخالق بن سلمة(@)(@@) يروي.(@)(@@) (372) -[4: 83] عن سعيد بن المسيب، عن ابن عمر، قال: " نهى رسول الله صلى الله عليه وسلم وفد عبد القيس عن الدباء والنقير والحنتم "، حدثناه الحسن بن سفيان، ثنا المثنى بن معاذ بن معاذ، ثنا أبي، عن شعبة، عن عبد الخالق(@)(@@) عبد الخالق(@)(@@) شيخ، يروي عن حماد بن أبي سليمان، عداده في أهل العراق، روى عنه شعبة بن الحجاج أحسبه الأول.(@)(@@)(@@)(@@) ||| AUTO عبد الخالق بن سلمة أبو روح الشيباني(@)(@@) من أهل البصرة، يروي عن سعيد بن المسيب، روى عنه ابن أبي عروبة.(@)(@@)(@@)(@@) ||| AUTO عبد الخالق بن أبي حازم(@)(@@) أخو عبد العزيز بن أبي حازم، يروي عن أبيه، وكان أكبر منه وأقدم سنا، روى عنه يحيى بن إبراهيم بن أبي قتيلة.(@)PageV01P002(@)(@@) [ج 4: ص 84](@)(@@)(@@)(@@) ||| AUTO عبد القاهر بن تليد العامري، كنيته أبو رفاعة(@)(@@) من أهل الكوفة، يروي عن الشعبي، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عبد الكبير بن دينار(@)(@@) من أهل مرو، يروي عن أبي إسحاق السبيعي، روى عنه سويد بن نصر ويحيى بن إسحاق الكاشغري، كنيته أبو عبد الرحيم هو الصائغ، مات بعد سنة ست وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO 
ms1089	 عبد الكبير بن الحكم بن عمرو الغفاري(@)(@@) يروي عن عديسة بنت وهبان، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO عبد الوارث بن سعيد التنوري أبو عبيدة التميمي(@)(@@) من بلعنبر، يروي عن حميد الطويل، روى عنه البصريون، مات سنة ثمانين ومائة في المحرم وله يوم، مات ثمان وسبعون سنة وأشهر كان قدريا متقنا في الحديث، كان شعبة يقول يعرف الإتقان في قفاه.(@)(@@)(@@)(@@) ||| AUTO عبد الرزاق بن أبي الثرى الأزدي(@)(@@) يروي عن ثابت البناني، روى عنه مسلم بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO عبد الأكرم(@)(@@) يروي.(@)(@@) (373) -[4: 84] عن إبراهيم التيمي، عن أبيه، عن أبي ذر، قال: " إنما كانت المتعة لأصحاب محمد صلى الله عليه وسلم "، يعني: متعة الحج، روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) ||| AUTO عبد الأكرم الكوفي(@)(@@) يروي عن أبيه، عن سليمان بن صرد، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد القوي(@)(@@) يروي عن مكحول، روى عنه ياسين الزيات.(@)(@@) (374) -[4: 84] حدثنا محمد بن الفضل البلخي، قال: ثنا إبراهيم بن يوسف، قال: ثنا وكيع، عن ياسين، عن عبد القوي، عن مكحول، أن النبي صلى الله عليه وسلم قال: " ما عبد الله بمثل الفقه "(@)PageV01P002(@)(@@) [ج 4: ص 85](@)(@@)(@@)(@@) ||| AUTO عباد بن عبيد الله بن أبي رافع(@)(@@) مولى النبي صلى الله عليه وسلم يروي عن جدته امرأة أبي رافع، يروى عنه المدنيون، ويروي عن أبي غطفان المري عن أبي رافع، قال: " ذبحت لرسول الله صلى الله عليه وسلم شاة فأمرني فقليت له، فأكل منها ثم قام فصلى، ولم يتوضأ ". روى عنه ابن عجلان.(@)(@@)(@@)(@@) ||| AUTO عبد رب بن درهم(@)(@@) يروي.(@)(@@) (375) -[4: 85] عن الشعبي، عن أبي جحيفة، عن علي: " خير هذه الأمة أبو بكر، وعمر ". روى عنه يونس بن أبي إسحاق. آخر الثالث من أتباع التابعين(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عاصم بن عمر بن الخطاب القرشي العدوى(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه ابنه عاصم بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن إسحاق بن حماد بن موسى بن طلحة بن عبيد الله التيمي القرشي(@)(@@) يروي عن إبراهيم بن طلحة، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عبيد 
ms1090	 الله بن عبد الله بن الأصم(@)(@@) أخو عبد الله بن عبد الله، يروي عن عمه يزيد بن الأصم، روى عنه مروان بن معاوية الفزاري، والأصم هو عبد عمرو بن عدس بن معاوية بن عبادة بن البكاء.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن إياد بن لقيط، كنيته أبو السليل(@)(@@) يروي عن أبيه، روى عنه الحسن بن الربيع، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي جعفر(@)(@@) مولى بني أمية من أهل مصر، يروي عن جماعة من التابعين، روى عنه أهل مصر، مات سنة ست وثلاثين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 86](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الحسن العنبري القاضي(@)(@@) من سادات أهل البصرة فقها وعلما، يروي عن جماعة من التابعين، مات في ولاية هارون.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله القرشي(@)(@@) يروي عن أبيه، عن أبي هريرة عداده في أهل المدينة، روى عنه أبو عامر العقدي.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن بشير بن جرير بن عبد الله البجلي(@)(@@) يروي المقاطيع، روى عنه يونس بن أبي إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن جنادة بن مالك الأزدي(@)(@@) يروي عن أبيه، روى عنه ابنه مصعب بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن حبيب بن أبي ثابت(@)(@@) مولى بني أسد أخو عبد الله بن حبيب، يروي عن أبي الزبير وأبيه، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن إسحاق الأنصاري(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه المدنيون.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن سليمان العبدي(@)(@@) يروي عن سعيد بن المسيب، روى عنه عبد الملك بن شداد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن جهضم كنيته أبو جهضم(@)(@@) يروي عن شريح عداده في أهل البصرة، روى عنه جرير بن أبي حازم.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن حميد بن عبد الرحمن الحميري(@)(@@) من أهل البصرة، يروي عن الشعبي، روى عنه هشام الدستوائي وأبان بن يزيد العطار.(@)PageV01P002(@)(@@) [ج 4: ص 87](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله الكلاعي(@)(@@) من أهل الشام أبو سلمة الحمصي، يروي عن مكحول، روى عنه الشاميون.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي عبد الله الأغر(@)(@@) واسم أبيه سلمان عداده في 
ms1091	 أهل المدينة كان أصله من أصبهان، يروي عن أبيه، روى عنه مالك، وسليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن رستم(@)(@@) إمام مسجد شعبة، يروي عن ابن سيرين، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي الجوزاء(@)(@@) يروي عن بكر بن عبد الله المزني عداده في أهل البصرة، روى عنه أبان بن صمعة.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن أبي حبيبة(@)(@@) يروي عن خثيم القاري، روى عنه عياض بن وهب.(@)(@@)(@@)(@@) ||| AUTO أبو منيع جد الحجاج بن يوسف بن أبي منيع اسمه عبيد الله بن أبي زياد(@)(@@) مولى هشام بن عبد الملك من أهل الشام، يروي عن الزهري، روى عنه حجاج بن أبي منيع.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن حمران العبدي الصفار(@)(@@) يروي عن الحسن عداده في أهل البصرة، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن سعيد(@)(@@) يروي عن يسار بن نمير عن عمر، روى عنه شريك بن عبد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن غلاب(@)(@@) يروي عن الحسن، روى عنه يونس بن عبيد، وعبد الله التوأم بن يحيى.(@)PageV01P002(@)(@@) [ج 4: ص 88](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن طلحة بن عبيد الله بن كريز الخزاعي، كنيته أبو مطرف(@)(@@) يروي عن الحسن والزهري، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن سعيد الثقفي(@)(@@) من أهل الكوفة، يروي المقاطيع، روى عنه ابنه أبو عون بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الرحمن بن معمر(@)(@@) من أهل المدينة، يروي عن الحجازيين، روى عنه ابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عامر(@)(@@) يروي المقاطيع عداده في أهل الحجاز، روى عنه ابن أبي نجيح وهو أخو عروة بن عامر الذي، روى عنه عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن سعيد بن مسلم أبو مسلم(@)(@@) قائد الأعمش، يروي عن الأعمش والكوفيين، روى عنه عمرو بن عثمان بن سعيد الجعفي الكوفي يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الأصم الهذلي(@)(@@) يروي عن شهر بن حوشب عن كعب، قال: من توضأ فأحسن الوضوء وخلل أصابعه ثم دخل مسجدا من المساجد كان زائرا لله في بيته 
ms1092	 وحق على المزور أن يكرم الزائر، روى عنه عيسى بن عبيد الكندي.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الله السجزي أبو الهيثم(@)(@@) يروي عن أبي إسحاق السبيعي، روى عنه ابنه حسين بن عبيد الله من حديث البخاريين الحسن بن عمر، وغيره.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الأخنس(@)(@@) يروي عن ابن أبي مليكة، روى عنه أبو معشر البراء بن يزيد والناس يخطئ كثيرا.(@)PageV01P002(@)(@@) [ج 4: ص 89](@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الرحمن بن عبد الله بن موهب القرشي(@)(@@) من أهل المدينة، يروي عن علي بن الحسين وعمه عبيد الله بن موهب، روى عنه سفيان الثوري، ووكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبد الرحمن بن السائب بن عمير القارئ(@)(@@) من أهل المدينة، يروي عن سعيد بن المسيب، وعبد الحميد بن عبد الرحمن بن أزهر، روى عنه ابن جريج ونافع بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عمران التميمي(@)(@@) يروي عن مجاهد، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن قيس النخعي(@)(@@) يروي عن إبراهيم النخعي، روى عنه موسى بن عمير الكوفي.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن مضارب البصري(@)(@@) يروي عن حضين بن المنذر عن معاوية، روى عنه الأسود بن شيبان.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن العيزار المازني بصري(@)(@@) يروي عن يزيد الرقاشي، وهو صاحب أبي هاشم الرماني، روى عنه حماد بن سلمة وبشر بن المفضل.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن حصين الوالبي(@)(@@) يروي عن هرمى بن عبد الله الواقفي عن خزيمة، روى عنه ابن الهاد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب رضي الله عنهم القرشي العدوى، كنيته أبو عثمان PageV01P002 [ج 4: ص 90](@)(@@) يروي عن القاسم وسالم ونافع والزهري وعطاء، وأهل الحجاز، روى عنه شعبة، ومالك والثوري والناس، مات سنة أربع أو خمس وأربعين ومائة، وكان من سادات أهل المدينة وأشراف قريش فضلا وعلما وعبادة وشرفا وحفظا وإتقانا، وأخوه عبد الله بن عمر ضعيف قد ذكرناه في كتاب الضعفاء، وأمهما فاطمة بنت عمر بن عاصم بن عمر بن الخطاب.(@)(@@)(@@)(@@) ||| AUTO عبيد الله 
ms1093	 بن مسلم القرشي(@)(@@) يروي عن أبيه، روى عنه هارون بن سليمان عداده في أهل الكوفة. وقد قيل: مسلم بن عبيد الله.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عمرو الأسدي(@)(@@) من أهل الرقة، كنيته أبو وهب، يروي عن إسماعيل بن أبي خالد والأعمش، وكان راويا لزيد بن أبي أنيسة، روى عنه حكيم بن سيف، وأهل الجزيرة. مات سنة ثمانين ومائة وهو ابن ست وسبعين سنة وهو عبيد الله بن عمرو بن أبي الوليد.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن المغيرة بن معيقيب(@)(@@) ومعيقيب جده كان على بيت المال لعمر بن الخطاب، يروي عن أبي الهيثم سليمان بن عمرو العتواري عداده في أهل مصر، روى عنه الليث بن سعد، ويحيى بن أيوب، وابن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الوليد الثقفي(@)(@@) وليس بالوصافي من أهل الكوفة، يروي عن شريح، روى عنه عطاء بن السائب.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن محرز(@)(@@) يروي عن الشعبي، وموسى بن أنس، روى عنه أبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن عبيد الرحمن الأشجعي(@)(@@) يروي عن إسماعيل بن أبي خالد وكان راويا للثوري، روى عنه أهل الكوفة.(@)(@@) (376) -[4: 90] حدثنا محمد بن إسحاق الثقفي، قال: ثنا الفضل بن إسحاق الدوري PageV01P002 [ج 4: ص 91]، قال: ثنا الأشجعي، عن إسماعيل بن أبي خالد، عن الشعبي، قال: " ما كلمة أبغض إلي من أرأيت أرأيت "، كنية الأشجعي أبو عبد الرحمن(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن النضر أبو النضر(@)(@@) يروي عن أبيه، عن أنس، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن محمد بن عمر بن علي الهاشمي(@)(@@) أخو عبد الله بن محمد، يروي عن أبيه، روى عنه الحجازيون، وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن هوذة القريعي(@)(@@) يروي عن عبيد الله الهجيمي عن جرموز الهجيمي عداده في أهل البصرة، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن مروان(@)(@@) يروي عن أبي عائشة عداده في الكوفيين، روي عنه بدر بن عثمان.(@)(@@)(@@)(@@) ||| AUTO عبيد الله هرير بن عبد الرحمن بن رافع بن خديج(@)(@@) يروي عن أبيه، عن جده رافع، روى عنه ابن أبي فديك.(@)(@@)(@@)(@@) ||| AUTO عبيد 
ms1094	 الله بن عمر بن موسى بن عبيد الله بن معمر القرشي(@)(@@) أخو أبي بكر، وعبد الله ابني عمر بن موسى، يروي عن حميد الطويل، روى عنه محمد بن حفص بن عمر بن موسى وهو ابن أخيه.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن الحسن بن الحصين بن أبي الحصين الخشخاش العنبري PageV01P002 [ج 4: ص 92](@)(@@) قاضي البصرة، يروي عن حميد الطويل، روى عنه ابن مهدي، وأهل بلده، مات سنة ثمان وستين ومائة وكان فقيها.(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن المنذر بن الزبير بن العوام(@)(@@) أخو محمد بن المنذر من أهل المدينة، يروي عن هشام بن عروة، روى عنه عتيق بن يعقوب بن صديق الزبيري.(@)(@@) (377) -[4: 92] روى عن هشام بن عروة، عن أبيه، عن عبد الله بن جعفر، عن علي، عن النبي صلى الله عليه وسلم قال: " خير نساء الجنة مريم بنت عمران، وخير نسائها خديجة بنت خويلد ". وكذلك رواه عبدة وابن نمير ووكيع وعلي بن مسهر، عن هشام بن عروة(@)(@@)(@@)(@@) ||| AUTO عبيد الله بن موسى العبسي(@)(@@) مولى لهم، كنيته أبو محمد من أهل الكوفة، يروي عن إسماعيل بن أبي خالد والأعمش، روى عنه أهل العراق والغرباء، مات سنة ثنتي عشرة أو ثلاث عشرة ومائتين في ذي القعدة وكان يتشيع.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد ربه بن سعيد بن قيس بن قهد بن عمرو النجاري الأنصاري(@)(@@) من أهل البصرة أخو يحيى بن سعيد وسعد بن سعيد، يروي عن عمرة بنت عبد الرحمن عن عائشة، روى عنه شعبة وأهل الحجاز، مات سنة تسع وثلاثين ومائة، وهو الذي يقال له: عبد ربه المدني.(@)(@@)(@@)(@@) ||| AUTO عبد ربه بن الصلت(@)(@@) يروي عن طاوس، روى عنه النضر بن شميل.(@)(@@) عبد ربه بن سعيد(@)(@@) مولى أبي موسى الأشعري، يروي عن سعيد بن أبي الحسن، روى عنه شعبة.(@)(@@)(@@)(@@) ||| AUTO عبد ربه بن سليمان بن عمير بن زيتون(@)(@@) من أهل الشام، يروي عن عبد الله بن محيريز وأم الدرداء، روى عنه ابن عياش والشاميون.(@)PageV01P002(@)(@@) [ج 4: ص 93](@)(@@)(@@)(@@) ||| AUTO عبد ربه بن بارق الحنفي الكوسج(@)(@@) من أهل اليمامة، كنيته أبو 
ms1095	 عبد الله، يروي عن جده أبي زميل سماك بن الوليد الحنفي، روى عنه بشر بن الحكم، قال: رأيته بالبصرة.(@)(@@)(@@)(@@) ||| AUTO أبو شهاب الحناط اسمه عبد ربه بن نافع(@)(@@) من أهل الكوفة، يروي عن الأعمش، وابن أبي خالد، روى عنه العراقيون، مات في ولاية هارون.(@)(@@)(@@)(@@) ||| AUTO عبد ربه بن عبيد أبو كعب البصري(@)(@@) بياع الحرير، يروي عن عبد العزيز بن أبي بكرة، روى عنه وكيع.(@)(@@)(@@)(@@) ||| AUTO عبد ربه بن أبي يزيد(@)(@@) كان يبيع الثياب، يروي عن أبي عياض، روى عنه قتادة.(@)(@@)(@@)(@@) ||| AUTO عبد ربه بن موسى بن الأحدب(@)(@@) من أهل اليمامة، يروي عن أمه، روى عنه عكرمة بن عمار.(@)(@@)(@@)(@@) ||| AUTO أبو نعامة السعدي اسمه عبد ربه(@)(@@) من أهل البصرة، يروي عن أبي نضرة، وقد قيل: إن اسم أبي نعامة عمرو، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عبد ربه أبو سعيد الشامي(@)(@@) يروى عن وراد كاتب المغيرة، روى عنه عبد الله بن عون.(@)(@@)(@@)(@@) ||| AUTO عبد ربه بن سرحان أبو بكر السعدي الغزال(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه عبد الرحمن بن مهدي.(@)PageV01P002(@)(@@) [ج 4: ص 94](@)(@@)(@@)(@@) ||| AUTO عبد ربه بن عبد الكريم أبو عبد الكريم القصاب الثقفي(@)(@@) يروي عن أبي رجاء العطاردي، وابن سيرين عداده في أهل البصرة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عبد ربه بن صالح الأشعري الشامي(@)(@@) يروي عن أصحاب واثلة بن الأسقع، روى عنه سليمان بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبيد بن مهران المكتب(@)(@@) من أهل الكوفة، يروي عن سعيد بن جبير، وإبراهيم النخعي والشعبي، ومجاهد، روى عنه الثوري وشريك وجرير، ويقال عبيد بن عمرو المكتب.(@)(@@)(@@)(@@) ||| AUTO عبيد بن أبي أمية الحنفي الطنافسي(@)(@@) من أهل الكوفة، كنيته أبو الفضل، يروي عن الشعبي، روى عنه ابناه يعلى ومحمد الطنافسيان.(@)(@@)(@@)(@@) ||| AUTO عبيد بن جعداء(@)(@@) يروي عن الشعبي، روى عنه يعلى بن عبيد.(@)(@@)(@@)(@@) ||| AUTO عبيد بن سلمان الأغر(@)(@@) يروي عن أبيه، عن عمار بن ياسر، روى عنه موسى بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عبيد بن حمران(@)(@@) أخو معبد بن حمران، يروي المراسيل، روى عنه 
ms1096	 سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO عبيد بن السائب بن عمر(@)(@@) عداده في أهل الحجاز، يروي عن سعيد بن المسيب، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عبيد بن سعيد الأموي(@)(@@) أخو يحيى بن سعيد الأموي، يروي عن الأعمش، وابن أبي خالد، روى عنه إسحاق بن إبراهيم الحنظلي.(@)PageV01P002(@)(@@) [ج 4: ص 95](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبيد بن مسلم الثقفي(@)(@@) يروي عن سالم بن عبد الله والحسن، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عبيد بن الطفيل أبو سيدان العبسي(@)(@@) من أهل الكوفة، يروي عن ربعي بن حراش، روى عنه أبو أحمد الزبيري والكوفيون.(@)(@@)(@@)(@@) ||| AUTO عبيد بن أبي عبيد(@)(@@) يروي عن جابر بن زيد، أنه قدم من سفر في رمضان فوجد امرأته قد اغتسلت من الحيض فجامعها، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO عبيد بن أبي مرزوق(@)(@@) من أهل الكوفة، يروي المراسيل، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عبد الرحمن(@)(@@) والد الهيثم بن عبيد، كنيته أبو عبيدة من أهل البصرة، يروي عن الحسن وابن سيرين، روى عنه سفيان الثوري.(@)(@@)(@@)(@@) ||| AUTO عبيد بن عبد الملك أبو عبد الملك الأسدي(@)(@@) يروي عن الشعبي، روى عنه وكيع، وأبو نعيم.(@)(@@)(@@)(@@) ||| AUTO عبيد بن مهران أبو الأشعث الوزان(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه حرمي بن حفص.(@)(@@) عبيد بن مسلم(@)(@@) صاحب السابري من أهل البصرة، يروي عن ثابت البناني، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عبيد بن يحيى(@)(@@) يروي عن معان بن رفاعة، روى عنه يحيى بن محمد بن هانئ المدني.(@)PageV01P002(@)(@@) [ج 4: ص 96](@)(@@)(@@)(@@) ||| AUTO عبيد(@)(@@) شيخ، يروي عن مالك بن يخامر السكسكي، روى عنه خالد بن معدان.(@)(@@)(@@)(@@) ||| AUTO عباد بن كسيب(@)(@@) يروي عن الطفيل بن عمرو، روى عنه العلاء بن الفضل.(@)(@@)(@@)(@@) ||| AUTO عباد بن أوس المدني(@)(@@) يروي عن سعيد بن المسيب روى شعبة، عن عاصم عنه.(@)(@@)(@@)(@@) ||| AUTO عباد بن زياد بن أبي سفيان(@)(@@) يروي عن عروة بن المغيرة بن شعبة، عن أبيه، روى عنه الزهري.(@)(@@)(@@)(@@) ||| AUTO عباد بن عباد بن علقمة المازني(@)(@@) من أهل البصرة، يروي عن أبي مجلز لاحق بن 
ms1097	 حميد، روى عنه المعتمر بن سليمان.(@)(@@) (378) -[4: 96] حدثنا ابن قتيبة بن سعيد، قال: ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، قال: ثنا عباد بن عباد بن علقمة المازني، قال: سئل أبو مجلز عن الصيام في السفر، فقال: كان أصحاب النبي صلى الله عليه وسلم " يسافرون في رمضان فيصوم بعضهم ويفطر بعضهم، ولا يعتب الصائم على المفطر ولا المفطر على الصائم "(@)(@@)(@@)(@@) ||| AUTO عباد بن أبي الغيث أبو الأشعث(@)(@@) يروي عن جابر بن زيد، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO عباد بن عاصم(@)(@@) يروي عن نافع بن جبير بن مطعم عداده في أهل الكوفة، روى عنه عمرو بن مرة.(@)(@@)(@@)(@@) ||| AUTO عباد العنبري التميمي بصري(@)(@@) يروي عن بجالة، روى عنه عوف الأعرابي.(@)(@@)(@@)(@@) ||| AUTO عباد بن سالم(@)(@@) يروي عن سالم بن عبد الله، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عباد بن مسلم الفزاري(@)(@@) يروي عن جبير بن أبي سليمان بن جبير بن مطعم عن ابن عمر، روى عنه وكيع.(@)PageV01P002(@)(@@) [ج 4: ص 97](@)(@@)(@@)(@@) ||| AUTO عباد بن سعيد(@)(@@) يروي عن أبي بردة بن أبي موسى، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO عباد بن عمرو العبدي(@)(@@) يروي عن الحسن، روى عنه جعفر بن سليمان الضبعي.(@)(@@)(@@)(@@) ||| AUTO عباد بن أبي زياد(@)(@@) يروي عن سلم بن زياد عن ميمونة، روى عنه يحيى بن سليم الطائفي.(@)(@@)(@@)(@@) ||| AUTO عباد بن ميسرة المنقري(@)(@@) بصري كان من العباد، يروي عن الحسن، وابن سيرين، روى عنه وكيع.(@)(@@)(@@)(@@) ||| AUTO عباد بن أبي عون القصاب(@)(@@) بصري يقال له: أبو جناب، يروي عن قتادة وزرارة بن أوفى، روى عنه أهل البصرة، وليس هذا بأبي جناب القصاب ذاك ضعيف.(@)(@@)(@@)(@@) ||| AUTO عباد بن عباد بن حبيب بن المهلب بن أبي صفرة الأزدي العتكي، كنيته أبو معاوية(@)(@@) من أهل البصرة، يروي عن أبي جمرة الضبعي، روى عنه قتيبة بن سعيد، وأهل العراق، مات قبل حماد بن زيد بستة أشهر، ومات حماد بن زيد سنة سبع وسبعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عباد بن العوام الكلابي(@)(@@) من أهل الواسط، كنيته أبو سهل، يروي عن حميد 
ms1098	 الطويل، روى عنه أهل العراق، مات سنة ست وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبادة بن نسي الكندي(@)(@@) من أهل الشام، يروي عن جماعة من التابعين أصحاب معاذ وأبي الدرداء، روى عنه أهل الشام، مات سنة ثمان عشرة ومائة وهو شاب، وهو من أهل الأردن وقد روى عن غضيف بن الحارث عن عائشة.(@)(@@)(@@)(@@) ||| AUTO عبيدة بن قريط الجعفري(@)(@@) يروي عن المدنيين وعمر بن عبد العزيز عداده في أهل الكوفة، روى عنه ابن عيينة.(@)PageV01P002(@)(@@) [ج 4: ص 98](@)(@@)(@@)(@@) ||| AUTO عبيدة بن أبي رائطة(@)(@@) من أهل الكوفة، قدم البصرة وحدثهم بها، يروي عن الكوفيين وعاصم بن بهدلة، روى عنه إبراهيم بن سعد.(@)(@@)(@@)(@@) ||| AUTO عبيدة بن حميد الحذاء التيمي، كنيته أبو عبد الرحمن(@)(@@) من أهل الكوفة سكن بغداد، وكان مؤدب محمد بن هارون الرشيد، يروي عن منصور بن المعتمر وإسماعيل بن أبي خالد، وكان يحدث ببغداد، روى عنه أحمد بن حنبل، وأهل العراق، مات سنة تسعين ومائة، ولم يكن بحذاء، كان يجالس الحذائين فنسب إليهم.(@)(@@)(@@)(@@) ||| AUTO عبيدة بن مسافع الديلي(@)(@@) قوله عداده في أهل المدينة، روى عنه بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عبيدة النحوي(@)(@@) عن أبي حيان التيمي.(@)(@@) (379) -[4: 98] حدثنا محمد بن المعافى، قال: ثنا عمرو بن عثمان بن كثير القرشي، قال: ثنا أبي، قال: ثنا يونس بن أبي إسحاق، عن عبيدة النحوي، عن أبي حيان التيمي، عن الشعبي، عن ابن عمر، قال: خطبنا عمر على منبر رسول الله صلى الله عليه وسلم: فحمد الله، وأثنى عليه ثم. قال: أما بعد فإن " الخمر نزل تحريمها يوم نزل، وهي خمسة من العنب والتمر والعسل والحنطة والشعير والخمر ما خامر العقل، ثلاثة وددت أن رسول الله صلى الله عليه وسلم لم يفارقنا حتى يعهد إلينا فيها عهدا ننتهي إليه الجد والكلالة، وأبواب من أبواب الربا "(@)(@@)(@@)(@@) ||| AUTO عبيدة بن زيد(@)(@@) يروي عن الحسن، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO عبيدة اليزني(@)(@@) يروي المراسيل، روى عنه الأحوص بن حكيم.(@)(@@)(@@)(@@) ||| AUTO عبدة بن سليمان الكلابي، كنيته أبو محمد(@)(@@) من أهل الكوفة، يروي عن إسماعيل بن 
ms1099	 أبي خالد وعبيد الله بن عمرو بن أبي عروبة، روى عنه أبو بكر بن أبي شيبة، PageV01P002 [ج 4: ص 99] وأهل العراق. مات في رجب سنة سبع وثمانين ومائة مستقيم الحديث جدا.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي سلمة بن عبد الرحمن بن عوف(@)(@@) يروي عن أبيه، روى عنه أهل المدينة، أمه أم ولد، قتله عبد الله بن علي بالشام سنة اثنتين وثلاثين ومائة، وقدم واسط فكتب عنه هشيم، وأبو عوانة، وكان عمر على قضاء المدينة.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيد الله بن عبد الله بن عمر بن الخطاب العدوى القرشي(@)(@@) يروي عن سالم بن عبد الله، روى عنه عبيد الله بن عمر ويزيد بن الهاد، أمه عائشة بنت عبد الرحمن بن أبي بكر الصديق، وهو أخو أبي بكر بن عبيد الله الذي، يروي عنه الزهري، وأم أبي بكر بن عبيد الله عائشة بنت القاسم بن محمد بن أبي بكر الصديق رضى الله تعالى عنهم.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب المدني(@)(@@) أخو واقد وعاصم، وزيد، وأبي بكر بني محمد بن زيد، يروي عن أبيه وسالم، روى عنه مالك والثوري، وأهل المدينة، أمه قرة العين من بني ضبة هو وأخوه أبو بكر بن محمد بن زيد من أم وأب بقى حتى كتب عنه العراقيون، وهو الذي، يروي عنه ابن وهب ومحمد بن شعيب بن شابور.(@)(@@)(@@)(@@) ||| AUTO عمر بن حفص بن عاصم بن عمر بن الخطاب(@)(@@) والد عبيد الله بن عمر من أهل المدينة، يروي عن أبيه عن زيد بن ثابت، روى عنه ابنه عبيد الله بن عمر العمري.(@)(@@)(@@)(@@) ||| AUTO عمر بن عبيد الله بن عاصم بن عمر بن الخطاب(@)(@@) أخو عاصم بن عبيد الله، يروي المقاطيع والمراسيل، روى عنه المبارك بن حسان، وهو الذي يروي عن عمر بن الخطاب، ولم يره أن رسول الله صلى الله عليه وسلم قال: " كيف أنتم إذا طغت نساؤكم وفسق شبانكم؟ "، قالوا: يا رسول الله، وإن ذلك لكائن؟ قال: " وأشد من ذلك، 
ms1100	 ترون المعروف منكرا، والمنكر معروفا ".(@)(@@) عمر بن محمد(@)(@@) من ولد مطعم بن عدى، يروي عن محمد بن جبير بن مطعم، روى عنه الزهري.(@)PageV01P002(@)(@@) [ج 4: ص 100](@)(@@)(@@)(@@) ||| AUTO عمر بن عبد الله بن عروة بن الزبير بن العوام القرشي(@)(@@) من أهل المدينة، يروي عن جده عروة بن الزبير، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عمر بن كثير بن أفلح(@)(@@) مولى أبي أيوب الأنصاري من أهل المدينة، يروي عن نافع أبي محمد مولى أبي قتادة وعبيد سنوطا، روى عنه يحيى بن سعيد الأنصاري، وابن عون.(@)(@@)(@@)(@@) ||| AUTO عمر بن سعيد بن أبي حسين النوفلي القرشي(@)(@@) من أهل مكة، يروي عن ابن أبي مليكة، روى عنه الثوري، وابن عيينة، وابن المبارك.(@)(@@) (380) -[4: 100] حدثنا محمد بن الفضل البلخي بسمرقند، قال: ثنا إبراهيم بن يوسف، قال: ثنا سفيان، عن عمر بن سعيد، عن عبد الله بن دينار، عن ابن عمر، قال: " السواك بعد الطعام أحب إلي من وضيفتين "(@)(@@)(@@)(@@) ||| AUTO عمر بن إسحاق(@)(@@) مولى زائدة، يروي عن أبيه، عن أبي هريرة، روى عنه أبو صخر حميد بن صخر.(@)(@@)(@@)(@@) ||| AUTO عمر بن أبي بكر بن عبد الرحمن بن الحارث بن هشام المخزومي القرشي(@)(@@) أخو عبد الملك وعبد الرحمن، يروي عن أبيه، روى عنه موسى بن يعقوب الزمعي، أمه قريبة بنت عبد الله بن معاوية بن الأسود بن المطلب بن أسد.(@)(@@)(@@)(@@) ||| AUTO عمر بن إسحاق بن يسار(@)(@@) مولى قيس بن مخرمة أخو محمد بن إسحاق، يروي عن المدنيين، يروي عنه الدراوردي، مات سنة أربع وخمسين ومائة، كنيته أبو حفص.(@)PageV01P002(@)(@@) [ج 4: ص 101](@)(@@)(@@)(@@) ||| AUTO عمر بن سيف(@)(@@) يروي عن ابن سيرين أنه سئل أي الرؤيا أحب إليك أن تراها؟. قال: أن يرى ربه، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO عمر بن ذر بن عبد الله بن زرارة الهمداني(@)(@@) من أهل الكوفة، كنيته أبو ذر، يروي عن عطاء ومجاهد، روى عنه وكيع، وأهل العراق، مات سنة ست وخمسين ومائة، وكان مرجئا يقص.(@)(@@)(@@)(@@) ||| AUTO عمر بن حمزة بن عبد الله بن عمر بن الخطاب 