ms1081	(@)(@@) % ونحن بنو اليونان قوم لنا حجا % % ومجد وعيدان صلاب المعاجم % % 317(@)(@@) % وحلم كأركان الجبال رزانة % وجهل تفادى منه جن الصرائم % 318(@)(@@) % إذا نحن أصبحنا فخاما شؤوننا % % فلسنا نبالي بالوجوه السواهم % 319(@)(@@) % ولسنا كأقوام تكون همومهم % % بياض المعاري وامتهاد المآكم % % 320(@)(@@) % لحا الله هاتيك الهموم فإنها % % هموم ربيبات الحجال النواعم % PageV01P4142 321(@)(@@) % وما تتراءى في المرايا وجوهنا % % بلى في صفاح المرهفات الصوارم % 322(@)(@@) % إذا ما انتضيناهاليوم كريهة % أرتنا وجوه المخدرات الضراغم % 323(@)(@@) % ولم تتخذها عند ذاك مرائيا % كفى شاغلا عن ذاك حز الحلاقم % 324(@)(@@) % وقد علمت أن لم تسلل نصالها % % لذلك بل سلت لضرب الجماجم % 325(@)(@@) % فتلك مرائينا التي هي حسبنا % % ووجه أبي سهل قريع الأعاجم % 326(@)(@@) % إذا ما بدا للناظرين يشبه % سنا رأيه في الحادث المتفاقم % 327(@)(@@) % فتى يلبس الناس المدائح كالحلى % % ويلبسها من بينهم كالتمائم % 328(@)(@@) % يعاذ بها وجه وسيم ومخبر % كريم لدى أزم الخطوب الأوازم % % 329(@)(@@) % وإن امرءا يضحى له المدح عوذة % % لمعلم دنيا طائل في المعالم % % 330(@)(@@) % وما الخير إلا حسن مرأى ومخبر % إذا نفذت يوما بصيرة حاكم % % PageV01P4143 331(@)(@@) % لئن راح مقسوما له الفضل إنه % لأهل له والله أعدل قاسم % 332(@)(@@) % فمن شاء فليبك الدماء نفاسة % وإن شاء فليضحك إلى فهر هائم % % 333(@)(@@) % وطئتم بني نوبخت أثبت وطأة % وأثقلها ثقلا على أنف راغم % 334(@)(@@) % وهنئتم مانلتم من كرامة % % إلى كرم فزتم به ومكارم % % 335(@)(@@) % وجدتكم مثل الدنانير أخلصت % وسائر هذا الخلق مثل الدراهم % 336(@)(@@) % ورثتم بيوت النار والنور كلها % % ذوي العلم قدما والشؤون الأعاظم % % 337(@)(@@) % بيوت ضياء لاتبوخ وحكمة % نجومية منهاجها غير طاسم % % 338(@)(@@) % ترون بها ما في غد رأي ناظر % بعين من البرهان لا وهم واهم % % 339(@)(@@) % علوم نجوم في قلوب كأنها % % نجوم أجنت في نجوم نواجم % % 340(@)(@@) % أريتم بها المنصور فوزة قدحه % وقد ظنها إحدى الدواهي الصيالم % % PageV01P4144 341(@)(@@) % وأحسنتم البشرى بفتح مغيب % تراءى له في شخص إحدى الهزائم % % 342(@)(@@) % وقد كان ردى بالرحال ركابه % % وودع دنياه وداع المصارم % % 343(@)(@@) % رأى أن أمر الطالبيين ظاهر % فعاد بأكوار 
ms1082	 القلاص العياهم % % 344(@)(@@) % فطأمنتم من جأشه ووهبتم % % له نفسا م الكاذبات الكواظم % % 345(@)(@@) % فما رام حتى أقبلت بشراؤه % % مع الفتح فوق الشاحجات الصلادم % % 346(@)(@@) % وما زلتم مصباح رأي ومفزعا % لمن بعده في المنكرات العوارم % % 347(@)(@@) % وأنتم لمن ترعون حرز لخائف % وغوث لملهوف وزاد لرازم % % 348(@)(@@) % إذا حز في الأطراف قوم فإنكم % تحزون من أموالكم في المعاظم % % 349(@)(@@) % غدوتم رؤوسا آل إسحاق هامها % % بحقهم والهام فوق اللهازم % % 350(@)(@@) % أما والهدايا الداميات نحورها % % ضحى والمطايا الداميات المناسم % % PageV01P4145 351(@)(@@) % لقد أيد السلطان منكم بناءه % % بأركان صدق ثابتات الدعائم % % 352(@)(@@) % أعمكم مدحا وأختص منكم % فتاكم أبا سهل ولست بظالم % % 353(@)(@@) % فتى لاأسميه فتى لحداثة % % ولكن لهاتيك السجايا الكرائم % 354(@)(@@) % له رونق العضب الصقيل وحده % % براعة أخلاق وصدق عزائم % % 355(@)(@@) % يضمهما غمد محلى بحلية % % أبى الله أن يحظى بها غير صارم % % 356(@)(@@) % أخو خمس خلات حسان روائع % % قد اتسقت فيه اتساق البراجم % % 357(@)(@@) % جمال وإفضال وظرف ونجدة % % ورأي يريه الغيب لارجم راجم % % 358(@)(@@) % ومن لك في الدنيا بأورع ماجد % رقيق الحواشي صادق البأس حازم % % 359(@)(@@) % فتى يرأم المولى ويشمخ للعدا % % بأنف حمي لا يذل لخارم % % 360(@)(@@) % يلين بعطف غير كز لعاطف % ويأبى بعطف غير لدن لهاضم % % PageV01P4146 361(@)(@@) % حلا لشفاه الذائقين وإنه % % لكالصاب في أحلاقهم والبلاعم % % 362(@)(@@) % يروح ويغدو مانحا غير تارك % شماس المحامي مانعا غير حارم % % 363(@)(@@) % عطارد الحلو الظريف مسالما % % وبهرام الشرير غير مسالم % % 364(@)(@@) % فتى حسنت أسماؤه وصفاته % % فأضحت وشوقا في بطون المعاصم % % 365(@)(@@) % ولو وسم الناس الجباه بمدحه % % إذا لاستلذ الناس لذع المياسم % % 366(@)(@@) % رأيت الورى من عالم غير عامل % إذا اختبروا أو عامل غير عالم % % 367(@)(@@) % وأما أبو سهل فإني رأيته % % بمجتمع الخيرات لا زعم زاعم % % 368(@)(@@) % طلبت لديه المال والعلم راغبا % فألفيته بعض البحور الخضارم % 369(@)(@@) % وعذت به من كل شيء أخافه % % فألفيته بعض الجبال العواصم % 370(@)(@@) % أجاب دعائي إذ دعوت معاشرا % فمن نائم عني ومن متناوم % % PageV01P4147 371(@)(@@) % بتلبية لا أحفل الدهر بعدها % % بذي صمم عني ولا متصامم % % 372(@)(@@) % وأعجب 
ms1083	 بمن يدعى سواه فينبري % % مجيبا عن المستبهم المتعاجم % % 373(@)(@@) % فتى لو رأى الناس الأمور بعينه % % رأوها بأذكى من عيون الأراقم % % 374(@)(@@) % رأى داء مجد المرء فضل ثرائه % % كما داء جسم المرء فضل المطاعم % % 375(@)(@@) % فأنحى على فضل الثراء بجوده % % ومازال للأدواء أحسم حاسم % % 376(@)(@@) % أقول لمن يسعى لشق غباره % % سيعييكم توثاب تلك الجراثم % % 377(@)(@@) % فخلوا مراعاة الأماني إنني % % أراكم بها في حال يقظان حالم % % 378(@)(@@) % وقتك أبا سهل يد الله إنني % % أراك يدا دفاعة للعظائم % % 379(@)(@@) % وعشت بمقذى من عيون شوانىء % % سعيدا بمدمى من أنوف رواغم % % 380(@)(@@) % ومشجى حلوق لاتسيغك بغضة % % ومدوى صدور كامنات السخائم % % PageV01P4148 381(@)(@@) % تجدد آثار الملوك ولم تزل % % لما أسسوه بانيا غير هادم % % 382(@)(@@) % نشرتهم عن حسن فعل فعلته % % فواتحه موصولة بالخوائم % % 383(@)(@@) % فأصبح حيا أحدث القوم معهدا % ومن كان في أولى العصور القدائم % % 384(@)(@@) % وما كافأ الأخلاف أسلاف قومهم % % بأفضل من نشر العظام الرمائم % % 385(@)(@@) % إليك ركبنا بطن جوفاء جونة % تخايل في درع من القار فاحم % 386(@)(@@) % نواهق أشباها لها ونظائرا % ملمعة بالودع سفع الملاطم % % 387(@)(@@) % إذا هي قيست بالنسور تشابهت % بأجنحة خفاقة وخراطم % % 388(@)(@@) % نسور وليست بالفراخ فتزدهي % % إذا شاغبت موجا ولا بالقشاعم % % 389(@)(@@) % تطير على أقفائها وظهورهاه أعاذل غضي بعض هذي الملاوم % % وكفي شآبيب الدموع السواجم % 390(@)(@@) % فما أنا بالغاوي فألحى ولا الذي % % يقاد إلى مكروهه بالخزائم % % PageV01P4149 391(@)(@@) % إليك فإني لاصدوف عن الهدى % % ولا ممكن من مخطمي كل خاطم % % 392(@)(@@) % على أن هذا الدهر قد ضام جانبي % % ولست حقيقا أن أقر لضائم % 393(@)(@@) % وعند ابن كسرى لابن قيصر مقعد % إذا سامه العصران إحدى الهضائم % 394(@)(@@) % دعيني أزر بالود والمدح معشرا % هم الساهمون المجد كل مساهم % 395(@)(@@) % إذا امتدحوا لم ينحلوا مجد غيرهم % % وهل تنحل الأطواق ورق الحمائم % % 396(@)(@@) % ويفتن فيهم مادح بعد مادح % وليس لصدق مستتب بعادم % 397(@)(@@) % أولئك قوم قائل المدح فيهم % حظي بحظى سالم الدين غانم % 398(@)(@@) % كرام لآباء كرام تنازعوا % % تراث فياريز لهم وبهارم % % 399(@)(@@) % تدلوا على هام المعالي إذا ارتقى 
ms1084	 % % إليها أناس غيرهم بالسلالم % 400(@)(@@) % ذوو الأوجه البيض الفداعم زينت % % وزيدت كمالا بالرؤوس الغيالم % % PageV01P4150 401(@)(@@) % رؤوس مرائيس قديما تعممت % لعمرك بالتيجان لا بالعمائم % % 402(@)(@@) % تساق إليهم كل يوم لطائم % من الحمد فيها مثل نشر اللطائم % % 403(@)(@@) % وقد جرب المنصور منهم نصيحة % وجدا سعيدا نعم ركن المزاحم % % 404(@)(@@) % به صدموا الأعداء دون مناهم % قديما فهدوا ركن كل مصادم % % 405(@)(@@) % ولما اجتباهم ذو الغناءين صاعد % غدا وهو مسرور بهم غير سادم % 406(@)(@@) % ومن يمنهم إذ قلدوا ما تلقدوا % % بوار الأعادي وانقضاء الملاحم % 407(@)(@@) % رمى الحائن المشؤوم يمن جدودهم % % بداهية تمحو سواد المقادم % % 408(@)(@@) % فقل لبني العباس إذ حركوهم % يدي لكم رهن بملك الأقالم % 409(@)(@@) % لتلق بني نوبخت يوما بأمة % % هواك وقد هانت صعاب المجاسم % 410(@)(@@) % وقد غفرت للدهر كل جريمة % تعد له من سيئات الجرائم % % PageV01P4151 411(@)(@@) % أسرك أني قد أقمت وأنني % % على صير أمر ليس لي بملاوم % % 412(@)(@@) % أروح وأغدو واجما بين معشر % شماتى بحالي كلهم غير واجم % % 413(@)(@@) % رأيت من الآراء ماليس حقه % % وجدك أن يثنى له عزم عازم % % 414(@)(@@) % فجئني برأي يمنع الفلك جريها % % ويملك غرب اليعملات الرواسم % 415(@)(@@) % وإلا فإني مستقل فرائم % % بهمتي العياء عليا المراوم % % 416(@)(@@) % ولست إذا ما الدهر أصبح جاثما % علي بملق تحته برك جاثم % % 417(@)(@@) % ومهما أخم عنه فلست عن التي % % تبلغني آمال نفسي بخائم % % 418(@)(@@) % يدي سائلي الأم الرؤوم التي غدت % تسومك حرمان الغنى بالملاوم % % 419(@)(@@) % أألبسط بالتسآل تستحسنين لي % % أم القبض في غل من الفقر آزم % % 420(@)(@@) % هما خطتا خسف ولابد منهما % % أو السير لاشيء سواه لرائم % % PageV01P4152 421(@)(@@) % سألقى بنعمانية الخير منعما % أعيش بها في ظله عيش ناعم % % 422(@)(@@) % يعاشرني في غربتي خير عشرة % ويقلبني من سربتي بمغانم % % 423(@)(@@) % فلا تنظري جري الأيامن وأمني % % بيمن الذي يممت جري الأشائم % 424(@)(@@) % ولاتشفقي من حد نحس على امرىء % يسير إلى سعد لغنم غنائم % 425(@)(@@) % أخ لي في حكم التفضل سيد % بحكم صميم الحق غير موائم % 426(@)(@@) % يرى أنني من خير حظ لصاحب % وأعتده من خير 
ms1085	 حظ لخادم % 427(@)(@@) % ويدمج أسباب المودة بيننا % % مودتنا الأبرار من آل هاشم % 428(@)(@@) % وإخلاصنا التوحيد لله وحده % % وتذبيبنا عن دينه في المقاوم % % 429(@)(@@) % بمعرفة لا يقرع الشك بابها % % ولا طعن ذي طعن عليها بهاجم % 430(@)(@@) % وإعمالنا التفكير في كل شبهة % بها عجمة تعيي دهاة التراجم % % PageV01P4153 431(@)(@@) % يبيت كلانا في رضى الله ماخضا % لحجته صدرا كثير الهماهم % 432(@)(@@) % جدعنا أنوف الإفك بالحق عنوة % فلم نترك منهن غير شراذم % % 433(@)(@@) % وإغرامنا بالظرف من نثر ناثر % تخال به درا ومن نظم ناظم % 434(@)(@@) % يفيدان آدابا يجنبن ذا النهى % % قراف المخازي وارتكاب المآثم % % 435(@)(@@) % إذا نحن قلنا ماترين أريننا % % إباحة معروف ومنع محارم % % 436(@)(@@) % يصوبن ذا الإقرار بالحق كله % % ويلحين ذا الإقرار عند المظالم % 437(@)(@@) % يسمحن ذا البخل الرتوب وتارة % يشجعن ذا الجبن الرجوف القوائم % 438(@)(@@) % وينطقن أهل الصمت في كل محفل % مهيب كمثل المأزق المتلاحم % % 439(@)(@@) % على ذاك أسسنا الخلالة بيننا % % فهل منقم فيما اعتددت لناقم % % 440(@)(@@) % أعن مثل ذاك الحر تستلفتينني % % إلى كل عبد الخيم وغد الشكائم % % PageV01P4154 441(@)(@@) % أخي ما أخي لامرتجي الخير خائب % عليه ولا ذو المدح فيه بآثم % 442(@)(@@) % وهل مأثم في مدح من كان مدحه % % يوازن عند الله تسبيح صائم % % 443(@)(@@) % فتى ترك الأشعار طرا مدائحا % % وكانت زمانا جلها في الشتائم % 444(@)(@@) % إذا هطلت بالعرف عشر بنانه % % فقد هطلت بالعرف عشر غمائم % 445(@)(@@) % يقودك مكرور التجاريب نحوه % وهل تجتوي شهدا تجاريب طاعم % 446(@)(@@) % وما ذائق روح الحياة بآجم % مذاقته يوما ولابعض آجم % % 447(@)(@@) % تلاقيه مبغيا عليه محسدا % ولست ترى في عرضه قرم قارم % 448(@)(@@) % وماذاك من بقيا العدا غير أنهم % رأوا رميه بالذام ذاما لذائم % 449(@)(@@) % رقيق طراز الظرف لكن جوده % % كثيف الحيا ذو عارض متراكم % % 450(@)(@@) % كتوم لما أولى أخاه محدث % أخاه بنعمى الله غير مكاتم % PageV01P4155 451(@)(@@) % إذا الناس سموا ماينيل من اللهى % % نوافل سماهن ضربة لازم % 452(@)(@@) % نهضت إليه بالخوافي مؤملا % % به أن تريني ناهضا بقوادم % 453(@)(@@) % ولما أنخت العزم ثم امتطيته % % إلى الماجد القمقام رأس القماقم 
ms1086	 % 454(@)(@@) % رأى حظي الحساد قبل حصوله % فقد سلفوني عضهم بالأباهم % % 455(@)(@@) % وغان عن الشورى بذكراه زاره % فآب ولم تقر له سن نادم % % 456(@)(@@) % كأني إذا يممته ومحمدا % سموت إلى أوس بن سعدى وحاتم % % 457(@)(@@) % أرائمتي رجي من الله رحمة % موكلة بالأمهات الروائم % 458(@)(@@) % وإن الذي تسترحم الأم لابنها % % بها وبه لاشك أرحم راحم % % 459(@)(@@) % دعي رعية ليست تدوم وعولي % % على خلف من رعية الله دائم % 460(@)(@@) % فإن الذي يمطيني البحر مركبا % سيحفظني من موجه المتلاطم % % PageV01P4156 461(@)(@@) % كلي رعيتي عند المغيب إلى الذي % % رعانا قديما في غيوب المشائم % 462(@)(@@) % هو الكاليء الراعي ونحن وغيرنا % % بعينيه مرعيون رعي السوائم % 463(@)(@@) % فمن ظن أن الناس يرعون دونه % نفوسهم فليعتبر بالبهائم % 464(@)(@@) % فإن هي كانت ملهمات رشادها % % على جهلها فليعترف للمخاصم % 465(@)(@@) % ألا فاستخيري الله لي عند رحلتي % % فذلك أجدى من ملام اللوائم % % 466(@)(@@) % ألا واستخيري الله لي إن جاره % بمنجى بعبد من ممر القواصم % 467(@)(@@) % وظني جميلا بالذي لم تزل له % % عوائد من إحسانه المتقادم % 468(@)(@@) % وقولي ألا إن اكتئابا لشاخص % سيعقبه الله ابتهاجا بقادم % 469(@)(@@) % وقالت أتضحي قلت للظل ذاكم % فكم من نسيم هب لي من سمائم % 470(@)(@@) % أيبكيك سفكي ماء وجهي برحلة % تنزهني عن سفكه في الألائم % PageV01P4157 471(@)(@@) % صيانة وجه لا أبا لك بذله % لما ذب عنه الذل يا أم سالم % % 472(@)(@@) % وما صان كن قط وجها أذاله % سؤال مصون المال عند المغارم % 473(@)(@@) % منيع الجدا لو يسأل النقر لم يكن % % لتأخذه في البخل لومة لائم % 474(@)(@@) % أبى الله وردي حوض ذاك وأن أرى % % تحوم رجائي حوله في الحوائم % % 475(@)(@@) % ولي مثل إسماعيل عنه مراغم % وهل كأبي سهل لحر مراغم % % 476(@)(@@) % وما اكتن مكتن ولاوفر عنده % % فلم يصل نيران الهموم اللوازم % % 477(@)(@@) % وللجاحم المشبوب في القلب والحشا % % أحر إذا استثبت من كل جاحم % % 478(@)(@@) % فلا تظلمي قلبي لوجهي فإنني % % أرى ظلم خيري شر خطة سائم % 479(@)(@@) % ولا الوجه أولى أن يعرض للصلى % % من الملك المحجوب تحت الحيازم % % 480(@)(@@) % ونحن بنو اليونان 
ms1087	 قوم لنا حجا % % ومجد وعيدان صلاب المعاجم % % PageV01P4158 481(@)(@@) % وحلم كأركان الجبال رزانة % وجهل تفادى منه جن الصرائم % 482(@)(@@) % إذا نحن أصبحنا فخاما شؤوننا % % فلسنا نبالي بالوجوه السواهم % 483(@)(@@) % ولسنا كأقوام تكون همومهم % % بياض المعاري وامتهاد المآكم % % 484(@)(@@) % لحا الله هاتيك الهموم فإنها % % هموم ربيبات الحجال النواعم % 485(@)(@@) % وما تتراءى في المرايا وجوهنا % % بلى في صفاح المرهفات الصوارم % 486(@)(@@) % إذا ما انتضيناهاليوم كريهة % أرتنا وجوه المخدرات الضراغم % 487(@)(@@) % ولم تتخذها عند ذاك مرائيا % كفى شاغلا عن ذاك حز الحلاقم % 488(@)(@@) % وقد علمت أن لم تسلل نصالها % % لذلك بل سلت لضرب الجماجم % 489(@)(@@) % فتلك مرائينا التي هي حسبنا % % ووجه أبي سهل قريع الأعاجم % 490(@)(@@) % إذا ما بدا للناظرين يشبه % سنا رأيه في الحادث المتفاقم % PageV01P4159 491(@)(@@) % فتى يلبس الناس المدائح كالحلى % % ويلبسها من بينهم كالتمائم % 492(@)(@@) % يعاذ بها وجه وسيم ومخبر % كريم لدى أزم الخطوب الأوازم % % 493(@)(@@) % وإن امرءا يضحى له المدح عوذة % % لمعلم دنيا طائل في المعالم % % 494(@)(@@) % وما الخير إلا حسن مرأى ومخبر % إذا نفذت يوما بصيرة حاكم % % 495(@)(@@) % لئن راح مقسوما له الفضل إنه % لأهل له والله أعدل قاسم % 496(@)(@@) % فمن شاء فليبك الدماء نفاسة % وإن شاء فليضحك إلى فهر هائم % % 497(@)(@@) % وطئتم بني نوبخت أثبت وطأة % وأثقلها ثقلا على أنف راغم % 498(@)(@@) % وهنئتم مانلتم من كرامة % % إلى كرم فزتم به ومكارم % % 499(@)(@@) % وجدتكم مثل الدنانير أخلصت % وسائر هذا الخلق مثل الدراهم % 500(@)(@@) % ورثتم بيوت النار والنور كلها % % ذوي العلم قدما والشؤون الأعاظم % % PageV01P4160 501(@)(@@) % بيوت ضياء لاتبوخ وحكمة % نجومية منهاجها غير طاسم % % 502(@)(@@) % ترون بها ما في غد رأي ناظر % بعين من البرهان لا وهم واهم % % 503(@)(@@) % علوم نجوم في قلوب كأنها % % نجوم أجنت في نجوم نواجم % % 504(@)(@@) % أريتم بها المنصور فوزة قدحه % وقد ظنها إحدى الدواهي الصيالم % % 505(@)(@@) % وأحسنتم البشرى بفتح مغيب % تراءى له في شخص إحدى الهزائم % % 506(@)(@@) % وقد كان ردى بالرحال ركابه % % وودع دنياه وداع المصارم % % 507(@)(@@) % رأى أن أمر الطالبيين ظاهر % فعاد بأكوار القلاص العياهم % % 508 
ms1088	(@)(@@) % فطأمنتم من جأشه ووهبتم % % له نفسا م الكاذبات الكواظم % % 509(@)(@@) % فما رام حتى أقبلت بشراؤه % % مع الفتح فوق الشاحجات الصلادم % % 510(@)(@@) % وما زلتم مصباح رأي ومفزعا % لمن بعده في المنكرات العوارم % % PageV01P4161 511(@)(@@) % وأنتم لمن ترعون حرز لخائف % وغوث لملهوف وزاد لرازم % % 512(@)(@@) % إذا حز في الأطراف قوم فإنكم % تحزون من أموالكم في المعاظم % % 513(@)(@@) % غدوتم رؤوسا آل إسحاق هامها % % بحقهم والهام فوق اللهازم % % 514(@)(@@) % أما والهدايا الداميات نحورها % % ضحى والمطايا الداميات المناسم % % 515(@)(@@) % لقد أيد السلطان منكم بناءه % % بأركان صدق ثابتات الدعائم % % 516(@)(@@) % أعمكم مدحا وأختص منكم % فتاكم أبا سهل ولست بظالم % % 517(@)(@@) % فتى لاأسميه فتى لحداثة % % ولكن لهاتيك السجايا الكرائم % 518(@)(@@) % له رونق العضب الصقيل وحده % % براعة أخلاق وصدق عزائم % % 519(@)(@@) % يضمهما غمد محلى بحلية % % أبى الله أن يحظى بها غير صارم % % 520(@)(@@) % أخو خمس خلات حسان روائع % % قد اتسقت فيه اتساق البراجم % % PageV01P4162 521(@)(@@) % جمال وإفضال وظرف ونجدة % % ورأي يريه الغيب لارجم راجم % % 522(@)(@@) % ومن لك في الدنيا بأورع ماجد % رقيق الحواشي صادق البأس حازم % % 523(@)(@@) % فتى يرأم المولى ويشمخ للعدا % % بأنف حمي لا يذل لخارم % % 524(@)(@@) % يلين بعطف غير كز لعاطف % ويأبى بعطف غير لدن لهاضم % % 525(@)(@@) % حلا لشفاه الذائقين وإنه % % لكالصاب في أحلاقهم والبلاعم % % 526(@)(@@) % يروح ويغدو مانحا غير تارك % شماس المحامي مانعا غير حارم % % 527(@)(@@) % عطارد الحلو الظريف مسالما % % وبهرام الشرير غير مسالم % % 528(@)(@@) % فتى حسنت أسماؤه وصفاته % % فأضحت وشوقا في بطون المعاصم % % 529(@)(@@) % ولو وسم الناس الجباه بمدحه % % إذا لاستلذ الناس لذع المياسم % % 530(@)(@@) % رأيت الورى من عالم غير عامل % إذا اختبروا أو عامل غير عالم % % PageV01P4163 531(@)(@@) % وأما أبو سهل فإني رأيته % % بمجتمع الخيرات لا زعم زاعم % % 532(@)(@@) % طلبت لديه المال والعلم راغبا % فألفيته بعض البحور الخضارم % 533(@)(@@) % وعذت به من كل شيء أخافه % % فألفيته بعض الجبال العواصم % 534(@)(@@) % أجاب دعائي إذ دعوت معاشرا % فمن نائم عني ومن متناوم % % 535(@)(@@) % بتلبية لا أحفل الدهر بعدها % % بذي صمم عني ولا متصامم % % 536(@)(@@) % وأعجب بمن يدعى سواه 
ms1089	 فينبري % % مجيبا عن المستبهم المتعاجم % % 537(@)(@@) % فتى لو رأى الناس الأمور بعينه % % رأوها بأذكى من عيون الأراقم % % 538(@)(@@) % رأى داء مجد المرء فضل ثرائه % % كما داء جسم المرء فضل المطاعم % % 539(@)(@@) % فأنحى على فضل الثراء بجوده % % ومازال للأدواء أحسم حاسم % % 540(@)(@@) % أقول لمن يسعى لشق غباره % % سيعييكم توثاب تلك الجراثم % % PageV01P4164 541(@)(@@) % فخلوا مراعاة الأماني إنني % % أراكم بها في حال يقظان حالم % % 542(@)(@@) % وقتك أبا سهل يد الله إنني % % أراك يدا دفاعة للعظائم % % 543(@)(@@) % وعشت بمقذى من عيون شوانىء % % سعيدا بمدمى من أنوف رواغم % % 544(@)(@@) % ومشجى حلوق لاتسيغك بغضة % % ومدوى صدور كامنات السخائم % % 545(@)(@@) % تجدد آثار الملوك ولم تزل % % لما أسسوه بانيا غير هادم % % 546(@)(@@) % نشرتهم عن حسن فعل فعلته % % فواتحه موصولة بالخوائم % % 547(@)(@@) % فأصبح حيا أحدث القوم معهدا % ومن كان في أولى العصور القدائم % % 548(@)(@@) % وما كافأ الأخلاف أسلاف قومهم % % بأفضل من نشر العظام الرمائم % % 549(@)(@@) % إليك ركبنا بطن جوفاء جونة % تخايل في درع من القار فاحم % 550(@)(@@) % نواهق أشباها لها ونظائرا % ملمعة بالودع سفع الملاطم % % PageV01P4165 551(@)(@@) % إذا هي قيست بالنسور تشابهت % بأجنحة خفاقة وخراطم % % 552(@)(@@) % نسور وليست بالفراخ فتزدهي % % إذا شاغبت موجا ولا بالقشاعم % % 553(@)(@@) % تطير على أقفائها وظهورها % % بمصطخب التيار جم الزمازم % % 554(@)(@@) % إذا أعجلت لم يسترث طيرانها % % وإن أمهلت زفت زفيف النعائم % % 555(@)(@@) % وقد أيقنت أن سوف تقطع زاخرا % إلى زاخر بالعارفات التوائم % % 556(@)(@@) % وأن سوف يلقى أركب البر ركبها % % لديه منيخي كل ناج عزاهم % % 557(@)(@@) % هو البحر لا ينفك في جنباته % % رغاء المطايا لا نئيم العلاجم % % 558(@)(@@) % رغاء مطايا الراغبين خلاله % % أناشيد مدح لم يقع في مشاتم % % 559(@)(@@) % وهل مشتم في عرض من راح واغتدى % % يرى زوره عدل الشريك المقاسم % % 560(@)(@@) % وما عذر عاف لا يؤمك زائرا % ولو لم يجد إلا ظهور الشياهم % % PageV01P4166 561(@)(@@) % بل العذر مقطوع ولو لم ينؤ به % % سوى رجله مكبولة بالأداهم % % 562(@)(@@) % كأني أراني قد لقيتك ضاحكا % إلي بوجه سافر غير قاتم % % 563(@)(@@) % فظلت بيوم من ضيائك شامس % رهين بيوم من سماحك 
ms1090	 غائم % % 564(@)(@@) % وحققت آمالي معا وكفيتني % % هموما كأطراف الزجاج اللهاذم % % 565(@)(@@) % ولو أعرضت بيني وبينك أبحر % زواخر تودي بالسفين العوائم % % 566(@)(@@) % لسخرت لي حيتانهن حواملا % % إلي لها كفيك غير عواتم % 567(@)(@@) % نداك ندى يسعى إلى كل قاعد % من الناس بل يسرى إلى كل نائم % % 568(@)(@@) % وما غاب عن مكنون صدرك غائب % % وإن غاب عن عينيك يا بن الأكارم % % 569(@)(@@) % منحتكها بيضاء في صدر حافظ % وإن مثلت سوداء في رق راقم % % 570(@)(@@) % قذوف النوى جوابة الأرض لاتني % % تقلقل في أنجادها والتهائم % % PageV01P4167 571(@)(@@) % غدت وهي من حظ المسامع قد ذكت % % برياك حتى استنشئت بالخياشم % % 572(@)(@@) % تسير بذكر منك مازال قاطعا % % بل الغول طلاعا ثنايا المخارم % % 573(@)(@@) % صنيعة قوال بفضلك صادع % % وفي كل واد لامتداحك هائم % % 574(@)(@@) % تظل لها الأفواه عند نشيدها % % عذاب الثنايا واضحات الملاغم % % 575(@)(@@) % تصيخ لها الآذان طورا وتارة % يكب عليها لاثما بعد لاثم % % 576(@)(@@) % فدونكها غيظا لقوم يرونها % % شجى ناشئا بين اللهى والغلاصم % % 577(@)(@@) % إذا اكتحلوا بي مقبلا فكأنما % % جباههم مزوية بالمحاجم % % 578(@)(@@) % وقد جربوا لحمي فذاقوا مرارة % نهتهم فكفوا غير خرق الأوارم % % 579(@)(@@) % وما ضرها أن لم يثر خطراته % لها شيخ يربوع ولاشيخ دارم % % PageV01P4168 البحر : - 1(@)(@@) % وفقت بمطراب العشيات والضحى % % فظلت أسح الدمع وهي ترنم % 2(@)(@@) % حليفة شجو هاج مابي ومابها % % تباريح شوق يشتكيه المتيم % 3(@)(@@) % فباح به فوها وأخفته عينها % % وباحت به عيني وكاتمه الفم % % PageV01P4169 البحر : - 1(@)(@@) % تفكرت في حيف الزمان عليكم % فلم أره عند التأمل ظالما % % 2(@)(@@) % أجرتم عليه من أخاف ومن يجر % عليه ويحفظه يهج منه عارما % % 3(@)(@@) % ومن لم يزل يبتز ليثا فريسة % يكن قمنا أن لا يرى منه سالما % % PageV01P4170 البحر : - 1(@)(@@) % إن ابن عمار عزير العالم % قد أخرجته من تراث آدم % % 2(@)(@@) % عصبة سوء فهو كالمراغم % % ليس بممنوح ولامقاسم % % 3(@)(@@) % ولا بمتروك ولا مسالم % % ولا بمستحيا ولامكارم % % 4(@)(@@) % وهو نسيم الروح للمناسم % % ريحانة للصاحب المنادم % 5(@)(@@) % ليس بمدفوع ولامخاصم % في ذاك تالله ولا محاكم % % PageV01P4171 البحر : - 1(@)(@@) % أيها السيد الذي فاق في الجو % % د 
ms1091	 وتم الحجا له والوسام % 2(@)(@@) % وأطاعت له الرواية والصن % عة وانقاد كيف شاء الكلام % % 3(@)(@@) % لاتخل أوجب الحقوق على المر % % ء حقوقا قضى بها الحكام % % 4(@)(@@) % إنما أوجب الحقوق على المر % % ء حقوق قضى بهن الذمام % % 5(@)(@@) % وذمامي كما علمت وقد قد % دمت وعدا في عقده استحكام % % 6(@)(@@) % وإذا ما الذمام أكده ال % % وعد فحق الحباء والإكرام % % 7(@)(@@) % كنت أنعمت لي بأشياء إن تم % مت ففيها لحاسدي إرغام % % 8(@)(@@) % وأراها تأخرت بالتناسي % % واستمرت من دونها الأيام % % 9(@)(@@) % وتقاضيت بالسكوت إلى أن % لامني في لزومه اللوام % % 10(@)(@@) % فتوق الإنعام إلا مع الأن % % عام أولا فإنه استذمام % % PageV01P4172 11(@)(@@) % وحقيق ترك السكوت إذا طا % % ل فلم ينتبه به النوام % % 12(@)(@@) % حان أن تضل العدات عن النج % % ح وأن تطلع الجنا الأكمام % % 13(@)(@@) % فاذكر الوعد فهو كالعهد والإخ % % لاف كالنكث وهو بسل حرام % 14(@)(@@) % ودع المطل راشدا فهو ميدا % % ن يروض النفوس فيه اللئام % % 15(@)(@@) % نعم الحر خلفها نعم من % % ه فرادى وأخريات تؤام % % 16(@)(@@) % ماتمام الإنعام قولا سوى الإن % % عام فعلا وللأمور تمام % % 17(@)(@@) % قد بذلت التذكير فابذل التن % % كير إن الزمان فيه عرام % % 18(@)(@@) % واغرم المال واغنم الحمد واعلم % % أن المجد غارم غنام % % 19(@)(@@) % ومتى لم تكن سجيتك الغر % % م إذا خيف من زمان غرام % % 20(@)(@@) % زاحت العلتان عنك فلا بخ % % ل يعوق الندى ولا إعدام % % PageV01P4173 21(@)(@@) % ولأنت الحقيق أن لا يرى من % % ك إذا ما وأيت وأيا ندام % % PageV01P4174 البحر : - 1(@)(@@) % كبرت فغيرك الغر الغلام صم وغير قناعك الجعد السخام % وأمسى ماء وجهك غاض عنه % % 2(@)(@@) % فماء شؤونك الفيض السجام % % وأصبحت الظباء مجانبات % 3(@)(@@) % جنابك مالها فيه بغام % وقد يألفنني ومعي سهامي % % 4(@)(@@) % فما هذا النفار ولاسهام % % أأوحشها وقد نصلت نبالي % % 5(@)(@@) % وأونسها وفي نبلي الحمام % % ليالي لاتزال لدي صرعى % % 6(@)(@@) % لرشقي في مقاتلها احتكام % % ألا جاد الحيا تلكم ظباء % 7(@)(@@) % تزينها المقاصر لا الخيام % % عتقن فهن من قرب ملاح % 8(@)(@@) % ورقن فهن من بعد فخام % % إلى الله الشكاة من اللواتي % % 9 
ms1092	(@)(@@) % مساكنها الرصافة لا الرجام % % بحيث تجبح الهدي قذما % % 10(@)(@@) % وهاشم الأكارم لا هشام % % مريضات الجفون لغير داء % PageV01P4175 11(@)(@@) % لمن لابسنه الداء العقام % % سقام عيونهن سقام قلبي % % 12(@)(@@) % وقد يهدي السقام لك السقام % % أعاذلتي وحبلي قد تداعى % % 13(@)(@@) % وللحبل اتصال وانجذام % كأن مناعمي حلم تقضى % % 14(@)(@@) % وأسراري مع الخلل احتلام % % كسيت البيض أخلاقا رماما % % 15(@)(@@) % فوصل البيض أخلاقا رمام % % فلا يتشتتن عليك رأي % 16(@)(@@) % فما للبيض والبيض التئام % % بليت سوى المشيب غدا جديدا % % 17(@)(@@) % علي الفد منه والتؤام % وكنت كروضة للعين أضحت % 18(@)(@@) % وما من نورها إلا النغام % % وعبست الحسان إلى مشيبي % % 19(@)(@@) % فما لثغورها برق يشام % % وما يرجى من البيض ابتسام % 20(@)(@@) % لمن أمسى لمفرقه ابتسام % % كأن محاسني لم تضح يوما % % PageV01P4176 21(@)(@@) % وفي لحظاتهن لها اقتسام % % كأني لمأر اللمحات نحوي % % 22(@)(@@) % وفي اللمحات لثم والتزام % % لئن ودعت جهلي غير قولي % % 23(@)(@@) % ألا سقيت معاهدنا القدام % لقد يهتزلي غصن رطيب % 24(@)(@@) % وقد يرتج لي دعص ركام % % ويسقيني شفاء النفس ثغر % 25(@)(@@) % ويسقيني شفاء الوجد جام % % ويسمعني رقاة الهم شدوا % % 26(@)(@@) % تغادر كل يوم وهو رام % سماع إن أردت إدام عيش % % 27(@)(@@) % فذاك من السماع له إدام % % عجيب كالحبيب له هنات % 28(@)(@@) % بها يشفى الجوى وبها يهام % % بأخضر جاده طل ووبل % 29(@)(@@) % وما جرمته بينهما الرهام % % غواد لاتفرط أو سوار % 30(@)(@@) % روائم لا يزال لها رزام % % فوردته وشقرته احمرار % PageV01P4177 31(@)(@@) % وحمرته وخضرته ادهمام % تقسم أمره شجر وروض % 32(@)(@@) % عليه من زواهره فدام % كساه الغيث كسوته فأضحى % % 33(@)(@@) % له منها ائتزار واعتمام % % يظل وللرياح به اصطخاب % % 34(@)(@@) % وللعجم الفصاح به اختصام % % وللقضب اللدان به اعتناق % 35(@)(@@) % وللأنوار فيهن التئام % % تراه إذا تجاوب طائراه % 36(@)(@@) % تجاوب عثعثا فيه زنام % حمام الأيك يسعده هزار % 37(@)(@@) % فدى المكاء ذينك والسمام % % وأخلاط من الغردات شتى % % 38(@)(@@) % حواسر أو عليهن الكمام % % ألا لا عيش لي إلا زهيدا % % 39(@)(@@) % ودون لثام من أهوى لثام % % وكم نادمت راح الروح فاه % 40(@)(@@) % ولكن خانني ذاك الندام % % كأني لم أبت أسقى رضابا 
ms1093	 % PageV01P4178 41(@)(@@) % يموت به ويحيا المستهام % % تعللنيه واضحة الثنايا % % 42(@)(@@) % كأن لقاءها حولا لمام % % تنفس كالشمول ضحى شمال % 43(@)(@@) % إذا ما فض عن فمها الختام % % وتسقيك الذي يشفي ويدوي % % 44(@)(@@) % ففي الأحشاء برد واضطرام % وقالوا لو أدار الراح كانت % % 45(@)(@@) % له عوضا وفارقه الهيام % فقلت مدام أفواه الغواني % % 46(@)(@@) % مدام لا يعادله مدام % عزاؤك عن شباب نال منه % % 47(@)(@@) % رمان فيه لين واعتزام % % فقبلك قام أقوام قعود % 48(@)(@@) % لريب الدهر أوقعد القيام % % وما ينفك يلقى الكره فيه % 49(@)(@@) % فئام قد تقدمه فئام % % إذا أدار على بني حام وسام % 50(@)(@@) % كؤوسا مرة حام وسام % % نهار شكله في اللون سام % PageV01P4179 51(@)(@@) % وليل شكله في اللون حام % % وهذا الدهر أطوار تراها % % 52(@)(@@) % وفيها الشهد يجنى والسمام % % فأعوام كأن العام يوم % 53(@)(@@) % وأيام كأن اليوم عام % % كدأب النحل أري أو حمات % 54(@)(@@) % ودأب النخل شوك أو جرام % % ولاتجزع فصرف الدهر كلم % 55(@)(@@) % وتعفية وإن دميت كلام % % سيسليك الشبيبة أريحي % 56(@)(@@) % بجود يديه أورقت السلام % % يحل من المكارم والمعالي % % 57(@)(@@) % بحيث الرأس منها والسنام % % له ذكر إليها مستراح % 58(@)(@@) % وناحية إليها مستنام % % مدبر دولة وقوام ملك % 59(@)(@@) % كهمتك المدبر والقوام % % يروقك أو يروعك لابظلم % % 60(@)(@@) % كما يتلون السيف الحسام % % يضاحك تارة ويكون أخرى % % PageV01P4180 61(@)(@@) % بحيث تهزه قصر وهام % % فآونة لصفحته انبلاج % 62(@)(@@) % وآونة لشفرته اصطلام % % أخو قلم صروف الدهر منه % % 63(@)(@@) % ففيه العيش والموت الزؤام % % كتابته مناقفة العوالي % % 64(@)(@@) % وليست ما يرقشه القلام % % ضئيل شأنه شأن نبيل % 65(@)(@@) % يطوع لأمره الجيش اللهام % به تبدو الصوارم حين تخفى % % 66(@)(@@) % وتخفى حين تبدو والخدام % % إذا سكنات صاحبه أملت % 67(@)(@@) % على حركاته سكن الأنام % % أخو ثقة إذا الأقلام أضحت % 68(@)(@@) % بني حمان عمهم الزكام % % أمين في معابيه أمون % 69(@)(@@) % سليم الأنف ليس به زكام % % تمج الفيء والمعروف مجا % % 70(@)(@@) % وللأقلام حطم وانتقام % % بكف فتى له نفع وضر % PageV01P4181 71(@)(@@) % وإنعام يؤمل وانتقام % يقلبه برأي لاتجزا % % 72(@)(@@) % ولايخبو لقدحته ضرام % % وزير للوزير يرى فيغني % % 73(@)(@@) % إذا طرقت مجلحة جلام % % له عزم 
ms1094	 إذا نفذ ارتياء % 74(@)(@@) % وإمضاء إذا وقع اعتزام % % فما لعزيمة منه انفلال % 75(@)(@@) % ولا لضريمة منه اقتحام % % ولا في عقدة منه انحلال % 76(@)(@@) % ولا في عروة منه انفصام % % متى ما انشام في غيب صواب % 77(@)(@@) % ن نعاه ابن الحسين فلا انشيام % % يبيت أبو الحسين يرى أمورا % 78(@)(@@) % كبرت فغيرك الغر الغلام % وغير قناعك الجعد السخام % 79(@)(@@) % وأمسى ماء وجهك غاض عنه % % فماء شؤونك الفيض السجام % % 80(@)(@@) % وأصبحت الظباء مجانبات % جنابك مالها فيه بغام % PageV01P4182 81(@)(@@) % وقد يألفنني ومعي سهامي % % فما هذا النفار ولاسهام % % 82(@)(@@) % أأوحشها وقد نصلت نبالي % % وأونسها وفي نبلي الحمام % % 83(@)(@@) % ليالي لاتزال لدي صرعى % % لرشقي في مقاتلها احتكام % % 84(@)(@@) % ألا جاد الحيا تلكم ظباء % تزينها المقاصر لا الخيام % % 85(@)(@@) % عتقن فهن من قرب ملاح % ورقن فهن من بعد فخام % % 86(@)(@@) % إلى الله الشكاة من اللواتي % % مساكنها الرصافة لا الرجام % % 87(@)(@@) % بحيث تجبح الهدي قذما % % وهاشم الأكارم لا هشام % % 88(@)(@@) % مريضات الجفون لغير داء % لمن لابسنه الداء العقام % % 89(@)(@@) % سقام عيونهن سقام قلبي % % وقد يهدي السقام لك السقام % % 90(@)(@@) % أعاذلتي وحبلي قد تداعى % % وللحبل اتصال وانجذام % PageV01P4183 91(@)(@@) % كأن مناعمي حلم تقضى % % وأسراري مع الخلل احتلام % % 92(@)(@@) % كسيت البيض أخلاقا رماما % % فوصل البيض أخلاق رمام % % 93(@)(@@) % فلا يتشتتن عليك رأي % فما للبيض والبيض التئام % % 94(@)(@@) % بليت سوى المشيب غدا جديدا % % علي الفد منه والتؤام % 95(@)(@@) % وكنت كروضة للعين أضحت % وما من نورها إلا النغام % % 96(@)(@@) % وعبست الحسان إلى مشيبي % % فما لثغورها برق يشام % % 97(@)(@@) % وما يرجى من البيض ابتسام % لمن أمسى لمفرقه ابتسام % % 98(@)(@@) % كأن محاسني لم تضح يوما % % وفي لحظاتهن لها اقتسام % % 99(@)(@@) % كأني لمأر اللمحات نحوي % % وفي اللمحات لثم والتزام % % 100(@)(@@) % لئن ودعت جهلي غير قولي % % ألا سقيت معاهدنا القدام % PageV01P4184 101(@)(@@) % لقد يهتزلي غصن رطيب % وقد يرتج لي دعص ركام % % 102(@)(@@) % ويسقيني شفاء النفس ثغر % ويسقيني شفاء الوجد جام % % 103(@)(@@) % ويسمعني رقاة الهم شدوا % % تغادر كل يوم وهو رام % 104(@)(@@) % سماع إن أردت إدام عيش % % فذاك من السماع 
ms1095	 له إدام % % 105(@)(@@) % عجيب كالحبيب له هنات % بها يشفى الجوى وبها يهام % % 106(@)(@@) % بأخضر جاده طل ووبل % وما جرمته بينهما الرهام % % 107(@)(@@) % غواد لاتفرط أو سوار % روائم لا يزال لها رزام % % 108(@)(@@) % فوردته وشقرته احمرار % وحمرته وخضرته ادهمام % 109(@)(@@) % تقسم أمره شجر وروض % عليه من زواهره فدام % 110(@)(@@) % كساه الغيث كسوته فأضحى % % له منها ائتزار واعتمام % % PageV01P4185 111(@)(@@) % يظل وللرياح به اصطخاب % % وللعجم الفصاح به اختصام % % 112(@)(@@) % وللقضب اللدان به اعتناق % وللأنوار فيهن التئام % % 113(@)(@@) % تراه إذا تجاوب طائراه % تجاوب عثعثا فيه زنام % 114(@)(@@) % حمام الأيك يسعده هزار % فدى المكاء ذينك والسمام % % 115(@)(@@) % وأخلاط من الغردات شتى % % حواسر أو عليهن الكمام % % 116(@)(@@) % ألا لا عيش لي إلا زهيدا % % ودون لثام من أهوى لثام % % 117(@)(@@) % وكم نادمت راح الروح فاه % ولكن خانني ذاك الندام % % 118(@)(@@) % كأني لم أبت أسقى رضابا % يموت به ويحيا المستهام % % 119(@)(@@) % تعللنيه واضحة الثنايا % % كأن لقاءها حولا لمام % % 120(@)(@@) % تنفس كالشمول ضحى شمال % إذا ما فض عن فمها الختام % % PageV01P4186 121(@)(@@) % وتسقيك الذي يشفي ويدوي % % ففي الأحشاء برد واضطرام % 122(@)(@@) % وقالوا لو أدار الراح كانت % % له عوضا وفارقه الهيام % 123(@)(@@) % فقلت مدام أفواه الغواني % % مدام لا يعادله مدام % 124(@)(@@) % عزاؤك عن شباب نال منه % % رمان فيه لين واعتزام % % 125(@)(@@) % فقبلك قام أقوام قعود % لريب الدهر أوقعد القيام % % 126(@)(@@) % وما ينفك يلقى الكره فيه % فئام قد تقدمه فئام % % 127(@)(@@) % إذا أدار على بني حام وسام % كؤوسا مرة حام وسام % % 128(@)(@@) % نهار شكله في اللون سام % وليل شكله في اللون حام % % 129(@)(@@) % وهذا الدهر أطوار تراها % % وفيها الشهد يجنى والسمام % % 130(@)(@@) % فأعوام كأن العام يوم % وأيام كأن اليوم عام % % PageV01P4187 131(@)(@@) % كدأب النحل أري أو حمات % ودأب النخل شوك أو جرام % % 132(@)(@@) % ولاتجزع فصرف الدهر كلم % وتعفية وإن دميت كلام % % 133(@)(@@) % سيسليك الشبيبة أريحي % بجود يديه أورقت السلام % % 134(@)(@@) % يحل من المكارم والمعالي % % بحيث الرأس منها والسنام % % 135(@)(@@) % له ذ