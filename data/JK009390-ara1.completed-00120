ms101	 به البلاء ) )(@)(@@) ( حب ) عن سعيد بن المسيب مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 889 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا حماه من الدنيا كما يحمي أحدكم سقيمه الماء ) )(@)(@@) ( ت ك هب ) عن قتادة بن النعمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 890 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا قذف حبه في قلوب الملائكة ، وإذا PageV01P147 أبغض الله عبدا قذف بغضه في قلوب الملائكة ، ثم يقذفه في قلوب الآدميين ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 891 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا نادى جبريل إن الله يحب فلانا فأحبه فيحبه جبريل ، فينادي جبريل في أهل السماء إن الله يحب فلاننا فأحبوه فيحبه أهل السماء ، ثم يوضع له القبول في الأرض ) )(@)(@@) ( ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 892 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا نادى جبريل إني قد أحببت فلانا فأحبه فينادي في السماء ، ثم تنزل له المحبة في الأرض ، فذالك قوله تعالى : { إن الذين آمنوا وعملوا الصالحات سيجعل لهم الرحمان ودا } وإذا أبغض الله عبدا نادى جبريل إني أبغضت فلانا فينادي في السماء ، ثم تنزل له البغضاء في الأرض ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 893 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله قوما ابتلاهم ) )(@)(@@) ( طس هب والضياء ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 894 ) قال النبي :(@)(@@) | 30 ( إذا أحببت رجلا فلا تماره ولا تشاره ولا تسأل عنه أحدا ، فعسى أن توافي له عدوا فيخبرك بما ليس فيه فيفرق ما بينك وبينه ) )(@)(@@) ( حل ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 895 ) قال النبي :(@)(@@) | 30 ( إذا أحببتم أن تعلموا ما للعبد عند ربه فانظروا ما يتبعه من الثناء ) )(@)(@@) ( ابن عساكر ) عن علي ومالك عن كعب رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 896 ) قال النبي :(@)(@@) | 30 ( إذا أحدث أحدكم في صلاته فليأخذ بأنفه ثم لينصرف ) )(@)(@@) ( ه ك حب هق ) عن عائشة رضي الله عنها .(@)(@@) PageV01P148(@)(@@)(@@)(@@) $ ( 897 ) قال النبي :(@)(@@) | 30 ( إذا أحسن أحدكم إسلامه فكل حسنة يعملها يكتب له عشرة أمثالها إلى سبعمائة ضعف ، وكل سيئة يعملها يكتب له مثلها حتى 
ms102	 يلقى الله ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 898 ) قال النبي :(@)(@@) | 30 ( إذا أحسن الرجل الصلاة فأتم ركوعها وسجودها قالت الصلاة : حفظك الله كما حفظتني فترفع ، وإذا أساء الصلاة فلم يتم ركوعها وسجودها قالت الصلاة : ضيعك الله كما ضيعتني ، فتلف كما يلف الثوب الخلق فيضرب بها وجهه ) )(@)(@@) ( الطيالسي ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 899 ) قال النبي :(@)(@@) | 30 ( إذا اختلف البيعان فالقول قول البائع ، والمبتاع بالخيار ) )(@)(@@) ( ت هق ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 900 ) قال النبي :(@)(@@) | 30 ( إذا اختلف البيعان وليس بينهما بينة فهو ما يقول رب السلعة أو يتتاركان ) )(@)(@@) ( د ن ك هق ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 901 ) قال النبي :(@)(@@) | 30 ( إذا اختلف البيعان وليس بينهما بينة والمبيع قائم بعينه فالقول ما قال البائع أو يتركان البيع ) )(@)(@@) ( ه ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 902 ) قال النبي :(@)(@@) | 30 ( إذا اختلف الزمان واختلفت الأهواء فعليك بدين الأعرابي ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 903 ) قال النبي :(@)(@@) | 30 ( إذا اختلف الناس فالعدل في مضر ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 904 ) قال النبي :(@)(@@) | 30 ( إذا اختلف الناس كان ابن سمية مع الحق ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 905 ) قال النبي :(@)(@@) | 30 ( إذا اختلفتم في الطريق فاجعلوه سبعة أذرع ) )(@)(@@) ( حم PageV01P149 م د ت ه ) عن أبي هريرة ( حم ه هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 906 ) قال النبي :(@)(@@) | 30 ( إذا أخذ أحدكم مضجعه ليرقد فليقرأ بام الكتاب وسورة فإن الله يوكل به ملكا يهب معه إذا هب ) )(@)(@@) ( ابن عساكر ) عن شداد بن أوس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 907 ) قال النبي :(@)(@@) | 30 ( إذا أخذ المؤذن في أذانه وضع الرب يده فوق رأسه فلا يزال كذالك حتى يفرغ من أذانه وإنه ليغفر له مد صوته فاذا فرغ قال الرب : صدق عبدي وشهدت بشهادة الحق فأبشر ) )(@)(@@) ( ك ) في التاريخ ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 908 ) قال 
ms103	 النبي :(@)(@@) | 30 ( إذا أخذت مضجعك فاقرأ سورة الحشر ، وإن مت مت شهيدا ) )(@)(@@) ( ابن السنى في عمل يوم وليلة ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 909 ) قال النبي :(@)(@@) | 30 ( إذا أخذت مضجعك من الليل فاقرأ قل يا أيها الكافرون ثم نم على خاتمتها فإنها براءة من الشرك ) )(@)(@@) ( حم د ت ك هب ) عن نوفل بن معاوية ( ن ) والبغوي وابن قانع والضياء عن جبلة بن حارثة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 910 ) قال النبي :(@)(@@) | 30 ( إذا أدخل أحدكم رجليه في خفيه وهما طاهرتان فليمسح عليهما ثلاثا للمسافر ويوما للمقيم ) )(@)(@@) ( ش ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 911 ) قال النبي :(@)(@@) | 30 ( إذا أدخل الله الموحدين النار أماتهم فيها إماتة ، فاذا أراد أن يخرجهم منها أمسهم ألم العذاب تلك الساعة ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 912 ) قال النبي :(@)(@@) | 30 ( إذا أدرك أحدكم سجدة من صلاة العصر قبل أن تقرب الشمس فليتم صلاته ، وإذا أدرك سجدة من صلاة الصبح قبل أن تطلع الشمس فليتم PageV01P150 صلاته ) )(@)(@@) ( خ ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 913 ) قال النبي :(@)(@@) | 30 ( إذا أدركتم الصلاة وأنتم في مراح الغنم فصلوا فيها فإنها سكينة وبركة ، وإذا أدركتكم الصلاة وأنتم في أعطان الإبل فاخرجوا منها فصلوا فإنها جن من جن خلقت ألا ترونها إذا نفرت كيف تشمخ بأنفها ) )(@)(@@) ( الشافعي هق ) عن عبد الله بن مغفل رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 914 ) قال النبي :(@)(@@) | 30 ( إذا ادعت المرأة طلاق زوجها فجاءت على ذالك بشاهد عدل استحلف زوجها فإن حلف بطلت شهادة الشاهد ، وإن نكل فنكوله بمنزلة شاهد آخر وجاز طلاقه ) )(@)(@@) ( ه ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 915 ) قال النبي :(@)(@@) | 30 ( إذا ادهن أحدكم فليبدأ بحاجبيه فإنه يذهب بالصداع ) )(@)(@@) ( ابن السني وأبو نعيم في الطب وابن عساكر ) عن قتادة مرسلا ( فر ) عنه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 916 ) قال النبي :(@)(@@) | 30 ( إذا أدى العبد حق الله وحق مواليه كان له أجران ) )(@)(@@) ( حم م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 917 ) قال 
ms104	 النبي :(@)(@@) | 30 ( إذا أديت زكاة مالك فقد قضيت ما عليك ) )(@)(@@) ( ت ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 918 ) قال النبي :(@)(@@) | 30 ( إذا أديت زكاة مالك فقد أذهبت عنك شره ) )(@)(@@) ( ابن خزيمة ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 919 ) قال النبي :(@)(@@) | 30 ( إذا أذن ابن أم مكتوم فكلوا واشربوا ، وإذا أذن بلال فلا تأكلوا ولا تشربوا ) )(@)(@@) ( حم ن و ابن خزيمة حب ) عن أنيسة بنت خبيب رضي الله عنها ( ز ) .(@)(@@) PageV01P151(@)(@@)(@@)(@@) $ ( 920 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن فلا يخرج أحد حتى يصلي ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 921 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن يوم الجمعة حرم العمل ) )(@)(@@) ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 922 ) قال النبي :(@)(@@) | 30 ( إذا أذنت المغرب فاحدرها مع الشمس حدرا ) )(@)(@@) ( طب ) عن أبي محذورة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 923 ) قال النبي :(@)(@@) | 30 ( إذا أذنت فاجعل إصبعيك في أذنيك فإنه أرفع لصوتك ) )(@)(@@) ( طب ) عن بلال ( الباوردي ) عن سعد القرظ رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 924 ) قال النبي :(@)(@@) | 30 ( إذا أذن في قرية أمنها الله من عذابه ذالك اليوم ) )(@)(@@) ( طص ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 925 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم السلام فليقل السلام عليكم فإن الله هو السلام ، فلا تبدؤوا قبل الله بشيء ) )(@)(@@) ( ابن السني في عمل يوم وليلة ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 926 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أمرا فليقل : اللهم إني أستخيرك بعلمك ، وأستقدرك بقدرتك ، وأسألك من فضلك العظيم ، فإنك تقدر ولا أقدر ، وتعلم وما أعلم وأنت علام الغيوب ، اللهم إن كان كذا وكذا من الأمر الذي يريد لي خيرا في ديني ومعيشتي وعاقبة أمري فيسره لي ، وإلا فاصرفه عني واصرفني عنه ، ثم قدر لي الخير أينما كان ، ولا حول ولا قوة إلا بالله ) )(@)(@@)(@@)(@@) $ ( 4 حب هب ) و الضياء عن أبي سعيد ( حب ) عن أبي هريرة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 927 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يبول فليرتد لبوله ) )(@)(@@) ( د هق ) عن أبي موسى 
ms105	 ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 928 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يبيع عقاره فليعرضه على جاره ) )(@)(@@) PageV01P152 ( ع عد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 929 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يذهب إلى الخلاء وأقيمت الصلاة فليذهب إلى الخلاء ) )(@)(@@) ( حم د ن ه حب ك ) عن عبد الله بن الأرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 930 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يزوج ابنته فليستأمرها ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 931 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم سفرا فليسلم على إخوانه فإنهم يزيدونه بدعائهم إلى دعائه خيرا ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 932 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم من امرأته حاجته فليأتها وإن كانت على تنور ) )(@)(@@) ( حم طب ) عن طل ق بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 933 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله إنفاذ قضائه وقدره سلب ذوي العقول عقولهم حتى ينفذ فيهم قضاؤه وقدره ، فإذا مضى أمره رد إليهم عقولهم ووقعت الندامة ) )(@)(@@) ( فر ) عن أنس وعلي رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 934 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله أن يبعث نبيا نظر إلى خير أهل الأرض قبيلة فيبعث خيرها رجلا ) )(@)(@@) ( ابن سعد ) عن قتادة رضي الله عنه بلاغا ( ز ) .(@)(@@)(@@)(@@) $ ( 935 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله أن يخلق خلقا للخلافة مسح ناصيته بيده ) )(@)(@@) ( عق عد خط فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 936 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله أن يزيغ عبدا ، أعمى عليه الحيل ) )(@)(@@) ( طس ) عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 937 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بالأمير خيرا جعل له وزير صدق ، إن نسي PageV01P153 ذكره ، وإن ذكر أعانه ، وإذا أراد به غير ذالك جعل له وزير سوء ، إن نسي لم يذكره وإن ذكر لم يعنه ) )(@)(@@) ( د هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 938 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بأهل بيت خيرا أدخل عليهم الرفق ) )(@)(@@) ( حم تخ هب ) عن عائشة ( البزار ) عن جابر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 939 ) قال النبي :(@)(@@) | 30 
ms106	 ( إذا أراد الله بأهل بيت خيرا فقههم في الدين ، ووقر صغيرهم كبيرهم ، ورزقهم الرفق في معيشتهم ، والقصد في نفقاتهم ، وبصرهم عيوبهم فيتوبوا منها ، وإذا أراد بهم غير ذالك تركهم هملا ) )(@)(@@) ( قط ) في الأفراد عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 940 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله برجل من أمتي خيرا ألقى حب أصحابي في قلبه ) )(@)(@@) ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 941 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا استعمله ، قيل : كيف يستعمله ؟ قال : يفتح له عملا صالحا بين يدي موته حتى يرضى عليه من حوله ) )(@)(@@) ( حم ك ) عن عمرو بن الحمق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 942 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا استعمله قيل : كيف يستعمله ؟ قال : يوفقه لعمل صالح قبل الموت ثم يقبضه عليه ) )(@)(@@) ( حم ت حب ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 943 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا جعل صنائعه ومعروفه في أهل الحفاظ ، وإذا أراد بعبد شرا جعل صنائعه ومعروفه في غير أهل الحفاظ ) )(@)(@@) ( فر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 944 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا جعل غناه في نفسه وتقاه في PageV01P154 قلبه ، وإذا أراد الله بعبد شرا جعل فقره بين عينيه ) )(@)(@@) ( الحكيم فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 945 قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا جعل له واعظا من نفسه يأمره وينهاه ) )(@)(@@) ( فر ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 946 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا صير حوائج الناس إليه ) )(@)(@@) ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 947 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا طهره قبل موته ، قالوا : وما طهور العبد ؟ قال : عمل صالح يلهمه إياه حتى يقبضه عليه ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 948 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا عاتبه في منامه ) )(@)(@@) ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 949 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا عسله ، قيل : وما عسله ؟ قال : يفتح له عملا صالحا 
ms107	 قبل موته ثم يقبضه عليه ) )(@)(@@) ( حم طب ) عن أبي عتبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 950 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا فتح له قفل قلبه وجعل فيه اليقين والصدق ، وجعل قلبه واعيا لما سلك فيه ، وجعل قلبه سليما ، ولسانه صادقا ، وخليقته مستقيمة وجعل أذنه سميعة ، وعينه بصيرة ) )(@)(@@) ( أبو الشيخ ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 951 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا فقهه في الدين وألهمه رشده ) )(@)(@@) ( البزار ) عن ابن مسعود رضي الله عنه .(@)(@@) PageV01P155(@)(@@)(@@)(@@) $ ( 952 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا فقهه في الدين ، وزهده في الدنيا ، وبصره عيوبه ) )(@)(@@) ( هب ) عن أنس عن محمد بن كعب القرظي مرسلا .(@)(@@)(@@)(@@) $ ( 953 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد شرا خضر له في اللبن والطين حتى يبني ) )(@)(@@) ( طب خط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 954 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبده الخير عجل له العقوبة في الدنيا ، وإذا أراد بعبده الشر أمسك عنه بذنبه حتى يوافي به يوم القيامة ) )(@)(@@) ( ت ك ) عن أنس ( طب ك هب ) عن عبد الله بن مغفل ( طب ) عن عمار بن ياسر ( عد ) عن أبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 955 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد هوانا أنفق ماله في البنيان والماء والطين ) )(@)(@@) ( البغوي هب ) عن محمد بن بشير الأنصاري وما له غيره ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 956 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبيد خيرا رزقهم الرفق في معاشهم ، وإذا أراد بهم شرا رزقهم الخرق في معايشهم ) )(@)(@@) ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 957 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقرية هلاكا أظهر فيهم الزنا ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 958 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم ( خيرا أكثر فقهاءهم وأقل جهالهم ، فاذا تكلم الفقيه وجد أعوانا ، وإذا تكلم الجاهل قهر ، وإذا أراد الله بقوم شرا أكثر جهالهم وأقل فقهاءهم ، فاذا تكلم الجاهل وجد أعوانا ، وإذا تكلم الفقيه قهر ) )(@)(@@) ( أبو نصر السجزي في الإبانة ) عن حيان 
ms108	 بن أبي جبلة ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 959 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم خيرا أهدى إليهم هدية : الضيف ينزل برزقه ويرتحل وقد غفر الله لأهل المنزل ) )(@)(@@) ( أبو الشيخ في الثواب وأبو نعيم في PageV01P156 المعرفة والضياء ) أبي قرصافة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 960 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم خيرا مد لهم في العمر وألهمهم الشكر ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 961 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم خيرا ولى عليهم حلماءهم ، وقضى بينهم علماؤهم ، وجعل المال في سمحائهم ، وإذا أراد بقوم شرا ولى عليهم سفهاءهم ، وقضى بينهم جهالهم ، وجعل المال في بخلائهم ) )(@)(@@) ( فر ) عن مهران .(@)(@@)(@@)(@@) $ ( 962 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم سوءا جعل أمرهم إلى مترفيهم ) )(@)(@@) ( فر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 963 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم عاهة نظر إلى أهل المساجد فصرف عنهم ) )(@)(@@) ( عد فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 964 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم عذابا أصاب العذاب من كان فيهم ثم بعثوا على أعمالهم ) )(@)(@@) ( ق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 965 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم قحطا نادى مناد من السماء : يا أمعاء اتسعي ، ويا عين لا تشبعي ، ويا بركة ارتفعي ) )(@)(@@) ( ابن النجار في تاريخه ) عن أنس رضي الله عنه وهو مما بيض له الديلمي .(@)(@@)(@@)(@@) $ ( 966 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم نماء رزقهم السماحة والعفاف ، وإذا أراد اقتطاعا فتح عليهم باب خيانة ) )(@)(@@) ( طب و ابن عساكر ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 967 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله خلق شيء لم يمنعه شيء ) )(@)(@@) ( م ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 968 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله قبض عبد بأرض جعل له فيها حاجة ) )(@)(@@) ( طب حم حل ) عن أبي عزة رضي الله عنه .(@)(@@) PageV01P157(@)(@@)(@@)(@@) $ ( 969 ) قال النبي :(@)(@@) | 30 ( إذا أردت أمرا فعليك بالتؤدة حتى يريك الله منه المخرج ) )(@)(@@) ( خد