ms1446	 4، ب 65، ح 4.(@)(@@) * وروى عن يونس، وروى عنه محمد ابن الحسين.(@)(@@) التهذيب: ج 2، ح 1464.(@)(@@) * وروى عن الأحول، وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 5، ح 1609.(@)(@@) * وروى عن العرزمي، وروى عنه محمد بن الحسين.(@)(@@) التهذيب: ج 2، ح 1132.(@)(@@) * وروى عن بعض رجاله، عن أبي عبد الله (عليه السلام).(@)(@@) الفقيه: ج 4، ح 389. والتهذيب: ج 10، ح 1172.(@)(@@) * وروى عمن ذكره، عن أبي عبد الله (عليه السلام)، وروى عنه صالح بن السندي.(@)(@@) الكافي: ج 6، ك 8، ب 28، ح 4.(@)(@@) * وروى عمن رواه، عن أبي عبد الله (عليه السلام)، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 3، ك 1، ب 43، ح 3.(@)(@@) والتهذيب: ج 1، ح 567 (الاستبصار:(@)(@@) ج 1، ح 559).(@)(@@) جعفر بن سماعة * روى عن أبي جميلة، وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 7، ك 2، ب 24، ح 6.(@)(@@) والتهذيب: ج 7، ح 188.(@)(@@) * وروى عن ابن بكير، وروى عنه ابن سماعة.(@)(@@) الكافي: ج 6، ك 2، ب 26، ح 6.(@)(@@) * وروى عن آدم بياع اللؤلؤ، وروى عنه الحسن.(@)(@@) الكافي: ج 7، ك 1، ب 39، ح 6.(@)(@@) وروى عنه الحسن بن سماعة.(@)(@@) التهذيب: ج 9، ح 741.(@)(@@) * وروى عن أبان، وروى عنه الحسن.(@)(@@) التهذيب: ج 6، ح 498.(@)(@@) وروى عنه الحسن بن سماعة.(@)(@@) الكافي: ج 5، ك 2، ب 29، ح 4، وب 136، ح 2.(@)(@@) وروى عنه الحسن بن محمد.(@)(@@) التهذيب: ج 7، ح 1564.(@)(@@) وروى عنه الحسن بن محمد بن سماعة.(@)(@@) الكافي: ج 4، ك 3، ب 27، ح 3، و ج 5، PageV05P394(@)(@@) ك 2، ب 135، ح 4 وك 3، ب 57، ح 5، وب 58، ح 5، و ج 6، ك 8، ب 54، ح 5، و ج 7، ك 1، ب 35، ح 12. والتهذيب:(@)(@@) ج 7، ح 635 (الاستبصار: ج 3، ح 309)، و 725، و ج 8، ح 188 (الاستبصار: ج 3، ح 1029)، و ج 9، ح 1314 (الاستبصار: ج 4، ح 718).(@)(@@) * وروى عن أبان بن عثمان، وروى عنه الحسن بن سماعة.(@)(@@) التهذيب: ج 8، ح 725.(@)(@@) وروى عنه الحسن بن محمد.(@)(@@) الكافي: ج 5، ك 2، ب 81، ح 9، و ج 7، ك 3، ب 48، ح 4. والتهذيب: ج 7، ح 526 (الاستبصار: ج 3، ح 363) و 528، و ج 10، ح 289.(@)(@@) * وروى عن إبراهيم بن عبد الحميد، وروى عنه الحسن بن محمد بن سماعة.(@)(@@) التهذيب: ج 2، ح 1027 و ج 7، ح 460).(@)(@@) * وروى عن جميل، وروى عنه 
