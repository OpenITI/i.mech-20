ms161	 للجنب ثلاثا فريضة» .(@)(@@) رواه بركة بن محمد الحلبي، عن يوسف بن أسباط، عن سفيان الثوري، عن خالد الحذاء، عن ابن سيرين، عن أبي هريرة.(@)(@@) وبركة هذا كان يسرق، وهو ضعيف.(@)(@@)(@@)(@@) $ 1122 - «المجالس ثلاثة غانم وسالم وشاجب» .(@)(@@) رواه العلاء بن زيد، عن أنس.(@)(@@) والعلاء له نسخة موضوعة عن أنس، وهو متروك الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1123 - «المنافقون تحيتهم لعنة وطعامهم نهبة. . .» الحديث.(@)(@@) ورواه عبد الملك بن قدامة القرشي، عن عبد الله بن دينار، عن ابن عمر.(@)(@@) وعبد الملك لا يحتج به.(@)(@@)(@@)(@@) $ 1124 - " المهلكات ثلاث: إعجاب المرء بنفسه، وشح مطاع، وهوى متبع ".(@)(@@) رواه محمد بن عون الخراساني، عن محمد بن زيد، عن سعيد بن جبير، عن ابن عباس.(@)(@@) ومحمد هذا يروي عن الثقات ما لا يشبه حديث الأثبات.(@)(@@) له طريق في باب الثاء.(@)(@@)(@@)(@@) $ 1125 - «المصلي يتناثر على رأسه الخير. . . .» الحديث.(@)(@@) رواه عباد بن بشر الرملي، عن حوشب، عن الحسن، عن أنس بن مالك.(@)(@@) عباد هذا غير ثقة.(@)(@@) وقال عباس: هو لا شيء، لأن من يروي مثل هذا لا يحتج بخبره.(@)(@@)(@@)(@@) $ 1126 - «المهدي منا يصلحه الله في ليلة» .(@)(@@) رواه ياسين بن شيبان العجلي، عن الهيثم بن محمد ابن الحنفية، عن أمه، عن علي.(@)(@@) وياسين هذا يعرف بهذا الحديث.(@)(@@) قال البخاري: فيه نظر(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1127 - «المحروم من حرم الوصية» .(@)(@@) رواه درست بن زياد، عن يزيد الرقاشي، عن أنس.(@)(@@) ودرست متروك.(@)(@@)(@@)(@@) $ 1128 - «المعدة حوض البدن. . . .» الحديث.(@)(@@) رواه يحيى بن عبد الله البابلتي، عن إبراهيم الرهاوي، عن زيد بن أبي أنيسة، عن الزهري، عن أبي سلمة، عن أبي هريرة.(@)(@@) ويحيى البابلتي أنكر عليه هذا الحديث، وقيل إنه من عمله.(@)(@@)(@@)(@@) | 1129 -(@)(@@) «المتكلم في الصلاة والضحاك والمفرقع أصابعه بمنزلة واحدة» .(@)(@@) PageV00P000(@)(@@) رواه رشدين بن سعد، عن زبان بن فائد، عن سهل بن معاذ الجهني.(@)(@@) أنكره ابن حبان على سهل.(@)(@@) وقال علي: إن رشدين وزبان ليسا بشيء.(@)(@@)(@@)(@@) $ 1130 - «المضمضة والاستنشاق ثلاثا فريضة للجنب» .(@)(@@) رواه همام بن سلم الزاهد، عن الثوري، عن خالد الحذاء، عن ابن سيرين، عن أبي هريرة.(@)(@@) وهمام كان ممن يسرق الحديث 
ms162	 ويحدث به عن الثقات، وهذا خبر باطل موضوع لا أصل له، وإنما هو مرسل عن خالد الحذاء، عن ابن سيرين أن النبي صلى الله عليه وسلم.(@)(@@) باب النون(@)(@@)(@@)(@@) $ 1131 - «النجوم أمان لأهل السماء، وأهل بيتي أمان لأمتي» .(@)(@@) رواه موسى بن عبيدة الربذي، عن إياس بن سلمة بن الأكوع، عن أبيه.(@)(@@) وموسى هذا منكر الحديث، ضعفه يحيى وقال: لا شيء في الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1132 - «النساء خلقن من ضعف. . .» الحديث.(@)(@@) رواه إسماعيل بن مسلم المكي، عن الحكم، عن مقسم، عن ابن عباس.(@)(@@) وإسماعيل متروك الحديث.(@)(@@)(@@)(@@) $ 1133 - «الناس سواء كأسنان المشط. . .» الحديث.(@)(@@) رواه بكار بن شعيب، عن أبي حازم، عن أبيه، عن سهل بن سعد.(@)(@@) وبكار هذا يروي عن الثقات ما ليس من حديثهم، لا يحتج به.(@)(@@)(@@)(@@) $ 1134 - «الناس على ثلاث منازل، فمن طلب ما عند الله. . . .» الحديث.(@)(@@) رواه إبراهيم بن عمرو بن بكر السكسكي، عن أبيه، عن عبد العزيز بن أبي رواد، عن نافع، عن ابن عمر.(@)(@@) وإبراهيم يروي الموضوعات عن أبيه، فلا أدري أهو الجاني على أبيه أو أبوه وكان أبوه يخصه بها، إلا أن هذا ليس من كلام رسول الله، ولا يحتمل إسناده مثله، وهذا مما تفرد به إبراهيم، وهو مما عملت يداه.(@)(@@)(@@)(@@) $ 1135 - «النظر إلى علي عبادة» .(@)(@@) رواه الحسن بن علي العدوي، عن أبي الربيع الزهراني، ومحمد بن عبد الأعلى(@)(@@) PageV00P000(@)(@@) الصنعاني، عن عبد الرزاق، عن معمر، عن الزهري، عن عروة، عن عائشة رضي الله تعالى عنها، عن أبيها الصديق رضي الله عنهما.(@)(@@) وهذا باطل، والحسن بن علي كذاب دجال.(@)(@@)(@@)(@@) $ 1136 - «النادم ينتظر الرحمة. . .» الحديث.(@)(@@) وفيه «وملاك الأعمال خواتيمها. . .» بطوله.(@)(@@) رواه إسحاق بن بشر الكاهلي، عن الثوري، عن أبيه، عن عكرمة، عن ابن عباس.(@)(@@) وإسحاق هذا يضع الحديث.(@)(@@)(@@)(@@) $ 1137 - «الوائدة والموءودة في النار» .(@)(@@) رواه محمد بن أبان بن صالح الجعفي، عن عاصم، عن زر، عن عبد الله.(@)(@@) ومحمد هذا ضعيف.(@)(@@)(@@)(@@) $ 1138 - «الوتر في أول الليل مسخطة للشيطان، والسحور مرضاة للرحمن» .(@)(@@) رواه أباء بن جعفر النجيرمي، عن محمد بن إسماعيل الصباغ، عن 
ms163	 محمد(@)(@@) PageV00P000(@)(@@) بن بشر، عن أبي حنيفة، عن عبد الله بن دينار، عن ابن عمر.(@)(@@) قال ابن حبان: ذهبت إليه بالبصرة، فرأيته قد وضع على أبي حنيفة أكثر من ثلاث مائة حديث لم يحدث بها أبو حنيفة قط، فقلت له: يا شيخ اتق الله ولا تكذب على رسول الله وذكر كلاما طويلا.(@)(@@)(@@)(@@) $ 1139 - «الوتر ثلاث ركعات كصلاة المغرب» .(@)(@@) رواه إسماعيل بن مسلم المكي، عن الحسن، عن سعد بن هشام، عن عائشة رضي الله تعالى عنها.(@)(@@) وإسماعيل هذا متروك الحديث.(@)(@@) آخر كتاب تذكرة الحفاظ جمع الشيخ الحافظ أبي الفضل محمد بن طاهر بن علي المقدسي رواية الحافظ أبي موسى تقي الدين محمد بن أبي بكر بن أبي عيسى المديني رواية السيد علاء الدين المحسي بن جعفر الرسى عن رواية الحافظ فريد الدين عبد الودود بن إمام الهدي حافظ. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . رواية محمد هذه. . . . . . . . . . . . . رواية محمد بن أبي بكر بن أحمد. . . . . . . . . . . . . وقد صادف الفراغ من تحريره في محرم سنة ستة مئة وخمس وسبعين من نسخة استنسخت عن نسخة مقروءة على من روى عن المصنف. PageV00P000 
