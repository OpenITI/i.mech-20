ms61	 البين أين مضى رعاء % ورد رعاء جيرتك الجمالا % % 12(@)(@@) % فلما فارقوا مرت حدوج % على بزل ترى فيها اعتلالا % % 13(@)(@@) % إذا ما ضمها الحادي بسوق % حثيث زادها الحادي اختيالا % % 14(@)(@@) % فليست ظبية غراء ظلت % بأعلى تلعة تزجي غزالا % % 15(@)(@@) % بأحسن مقلة منها وجيدا % ووجها ناعما كسي الجمالا % % 16(@)(@@) % جرى منها السواك على تقي % % كأن البرق إذ ضحكت تلالا % % 17(@)(@@) % كأن المسك عل بها ذكيا % وراحا خالط العذب الزلالا % % 18(@)(@@) % إذا ما القلب والخلخال ضاقا % % جرى منها وشاحاها فجالا % % 19(@)(@@) % تضم ثيابها كشحا هضيما % وأردافا إذا قامت ثقالا % % 20(@)(@@) % إذا قامت تنوء بمرجحن % كدعص الرمل ينهال انهيالا % % PageV01P226 21(@)(@@) % إلى حتى متى يا أم عمرو % % دلالك طال ذا صرما وطالا % % 22(@)(@@) % على أني وعيشك لست أدري % % أصرما كان ذلك أم دلالا % % 23(@)(@@) % فإن يكن الدلال فأنت مني % % يمين لا أريد بها شمالا % % 24(@)(@@) % ألم يك حبكم في غير فحش % زمانا كاد يورثني سلالا % % 25(@)(@@) % سأتركها وآخذ في ثناء % % لقومي لست قائله انتحالا % % 26(@)(@@) % ألم تر أن عودي تغلبي % نضار هزه كرم فطالا % % 27(@)(@@) % فسلني بالكرام فإن قومي % % كرام لا أريد بها بدالا % % 28(@)(@@) % وقومي تغلب والحي بكر % فمن هذا يوازننا فضالا % % 29(@)(@@) % تصان حلومنا وترى علينا % % ثياب الحز تبتذل ابتذالا % % 30(@)(@@) % فكم من قائل قد قال فينا % % فلم نترك لذي قيل مقالا % % PageV01P227 31(@)(@@) % فسل عنا فإن تنظر إلينا % % ترى عددا وأحلاما ثقالا % % 32(@)(@@) % هما ابنا وائل بحران فاضا % % جرى بالناس موجهما فسالا % % 33(@)(@@) % فمن يعدل بنا إلا قريش % ألسنا خير من وطىء النعالا % % 34(@)(@@) % ألسنا نحن أقراهم لضيف % وأوفاهم إذا عقدوا حبالا % % 35(@)(@@) % وأجبرهم لمختبط فقير % بخير حين قرب ثم نالا % % 36(@)(@@) % كرام الرفد لا نعطي قليلا % ولا ننبو لسائلنا اعتلالا % % 37(@)(@@) % سل الضيفان ليلة كل ريح % تلف البرك عازمة شمالا % % 38(@)(@@) % ألسنا بالقرى نمشي إليهم % سراعا قبل أن يضعوا الرحالا % % 39(@)(@@) % فما نجفو الضيافة إن أقاموا % % ولا الجيران إن كرهوا زوالا % % 40(@)(@@) % ونكرم جارنا ما دام فينا % % ونتبعه الكرامة حيث مالا % % PageV01P228 41 
ms62	(@)(@@) % لعمرك ما يبيت الجار فينا % % على وجل يحاذر أن يغالا % % 42(@)(@@) % فقل للناس إن هم فاضلونا % % يعدوا مثلهن لهم جلالا % % 43(@)(@@) % ألسنا من دمشق إلى عمان % ملأنا البر أحياء حلالا % % 44(@)(@@) % ودجلة والفرات وكل واد % إلى أن خالط النعم الجبالا % % 45(@)(@@) % وشارفنا المدائن في جنود % لنا منهن أكثرها رجالا % % 46(@)(@@) % ألا إن الحياة لناذريها % % وصولتها إذا ما العز صالا % % 47(@)(@@) % ونحن الموقدون بكل ثغر % ضرام الحرب تشتعل اشتعالا % % 48(@)(@@) % إذا ما الخيل ضيعها رجال % ربطناها فشاركت العيالا % % 49(@)(@@) % نقاسمها المعيشة إذ شتونا % % ونكسوها البراقع والجلالا % % 50(@)(@@) % نصون الخيل ما دمنا حضورا % ونحذوهن في السفر النعالا % % PageV01P229 51(@)(@@) % ونبعثن في الغارات حتى % % يقود الفحل صاحبه مذالا % % 52(@)(@@) % وكل طمرة جرداء تردي % % ترى الأضلاع بادية هزالا % % 53(@)(@@) % أصابت من غزاة القوم جهدأ % يعرق من جزارتها المحالا % % 54(@)(@@) % إذا ملت فوراسنا وكلت % عتاق الخيل زدناها كلالا % % 55(@)(@@) % جنائبنا العتاق لها صهيل % بأيدينا يعارضن البغالا % % 56(@)(@@) % إذا نادى منادينا ركبنا % % إلى الداعي فطرن بنا عجالا % % 57(@)(@@) % فهن إلى الصباح مجلحات % بنا يمعن إمعانا رسالا % % 58(@)(@@) % عوابس بالقنا متواترات % ترى الأبطال يعلون النهالا % % 59(@)(@@) % بها نلنا غرائب من سوانا % % وأحرزنا القرائب أن تنالا % % 60(@)(@@) % إذا شينا وناشبنا أناس % وجدنا من كرام الناس حالا % % PageV01P230 61(@)(@@) % وما تحت السماء لنا ابن أخت % بمردفة عليها القدح جالا % % 62(@)(@@) % ومن كل القبائل قد سبينا % % من البيض المخدرة الحجالا % % 63(@)(@@) % تناضلنا وحل الناس عنا % % فما قامت لنا قيس نضالا % % 64(@)(@@) % ولم تسلم بنو أسد فتنجو % % ومن هذا نجا منا فوالى % % PageV01P231 البحر : كامل تام 1(@)(@@) % طرق الكرى بالغانيات ، وربما % % طرق الكرى منهن بالأهوال % 2(@)(@@) % حلم سرى بالغانيات ، فزارني % % من أم بكر موهنا بخيال % 3(@)(@@) % أسرى لأشعث هاجد بمفازة % بخيال ناعمة السرى ، مكسال % 4(@)(@@) % فلهوت ليلة ناعم ، ذي لذة % كقرير عين ، أو كناعم بال % 5(@)(@@) % بغزيرة نفخ النعيم شبابها % % غرثى الوشاح ، شبيعة الخلخال % 6(@)(@@) % في صورة تمت وأكمل خلقها % % للناظرين ، كصورة التمثال % 7(@)(@@) % تمت لمن نعت النساء ، وأكملت % ناهيك من حسن لها وجمال 
ms63	 % 8(@)(@@) % وملاحة في منطق مترخم % منها ، وحسن تقتل ودلال % 9(@)(@@) % ترنو بمقلة جؤذر بخميلة % وبمشرق بهج وجيد غزال % 10(@)(@@) % وبوارد رجل كأن قرونه % من طوله ، موصولة بحبال % PageV01P232 11(@)(@@) % ما روضة خضراء ، أزهر نورها % % بالقهر بين شقايق ورمال % 12(@)(@@) % بهج الربيع لها ، فجاد نباتها % % ونمت بأسحم وابل هطال % 13(@)(@@) % حتى إذا التف النبات ، كأنه % لون الزخارف ، زينت بصقال % 14(@)(@@) % نفت الصبا عنها الجهام ، وأشرقت % للشمس ، غب جنة وطلال % 15(@)(@@) % يوما ، بأملح منك بهجة منطق % بين العشي وساعة الآصال % 16(@)(@@) % ينشدن ، بعد تلمس وسؤال % بعض النجوم ، وبعضهن توالي % % 17(@)(@@) % تشفي الضجيع ، إذا أراد عناقها % % بمقبل عذب المذاق ، زلال % 18(@)(@@) % صاف ، يرف كأنما ابتسمت به % عن غب غادية ، غداة شمال % 19(@)(@@) % شبم ، كأن الثلج شاب رضابه % بسلاف خالصة من الجريال % 20(@)(@@) % صهباء ، صافية ، تنزل تجرها % % ببلاد صرخد ، من رؤوس جبال % PageV01P233 21(@)(@@) % من قرقف الزرجون فت ختامها % % فالدن بين حنابج وقلال % 22(@)(@@) % من قهوة نفحت ، كأن سطيعها % % مسك ، تضوع في غداة شمال % 23(@)(@@) % أو راح ذي نطف يظل متوجا % للشرب ، أصهب قالص السربال % 24(@)(@@) % فكذاك نكهتها ، إذا نبهتها % % والجلد غير مدرن متفال % % 25(@)(@@) % فدع الغواني والنشيد بذكرها % % واصرف لذكر مكارم وفعال % % 26(@)(@@) % إنا لنقتاد الجياد على الوجا % % نحو العدى بمساعر أبطال % 27(@)(@@) % في كل ذي لجب ، كأن زهاءه % ليل تعرض ، أو رعان جبال % 28(@)(@@) % دهم يظل به الفضاء معضلا % كالطود أرعن مجفل الأثقال % 29(@)(@@) % ما بين أوله وآخر جمعه % يوم يسار وليلة البغال % 30(@)(@@) % مجر تظل البلق في حافاته % ينشدنن بعد تلمس وسؤال % PageV01P234 31(@)(@@) % ونسير بالثغر المخوف فجاجه % بسلاهب جرد المتون ، طوال % 32(@)(@@) % خوص كأن شكيمهن معلق % بقنا ردينة أو جذوع إوال % 33(@)(@@) % نقتاد كل طمرة رأد الضحى % % وعنان كل مجلجل ، صهال % 34(@)(@@) % من كل أدهم ، كالغراب سواده % طرف وأحمر كالنديم نسال % 35(@)(@@) % يسقى الربيع يصان غير مصرد % محض العشار ، وقارص الأشوال % 36(@)(@@) % ودنا المغار لها ، فهن شوازب % خلل المطي ، كأنهن مغال % 37(@)(@@) % يمشين إذ طال الوجيف على الوجا % % نحو العدو كمشيمة الرئبال % 38 
ms64	(@)(@@) % أو كالكلاب على الهراس ، يطأنه % أو مشيهن ، يطأن شوك سيال % 39(@)(@@) % يخرجن من قطع العجاج كأنها % % عقبان يوم تغيم وطلال % 40(@)(@@) % خيل إذا فزعت كأن رعيلها % % نحو العدى موضونة برعال % PageV01P235 41(@)(@@) % ومسوم عقد الهمام برأسه % تاج الملوك ، رددن في الأغلال % 42(@)(@@) % ومكر معترك تركن حماته % للطير بين سوافل وعوالي % % 43(@)(@@) % صرعى يظلل الطير يحجل بينها % % ينقرن أعينها مع الأوصال % 44(@)(@@) % كم من أناس قد حوين نهابهم % % وأفأن من نعم وحي حلال % 45(@)(@@) % شعث النواصي ، عادة من فعلها % % سفك الدماء ، وقسمة الأموال % 46(@)(@@) % فتركن قد قضين من حمس الوغى % % وطرا ، وجلن هناك كل مجال % PageV01P236 البحر : طويل 1(@)(@@) % أعاذلتي اليوم ويحكما مهلا % وكفا الأذى عني ، ولا تكثرا عذلا % % 2(@)(@@) % ذراني تجد كفي بمالي ، فإنني % % سأصبح لا أسطيع جودا ولا بخلا % % 3(@)(@@) % إذا وضعوا بعد الضريح جنادلا % علي ، وخليت المطية والرحلا % % 4(@)(@@) % وأبكيت من عتبان كل كريمة % على فاجع ، قامت مشققة عطلا % % 5(@)(@@) % مدمية حرا من الوجه ، حاسرا % كأن لم تمت قبلي غلاما ولا كهلا % % 6(@)(@@) % وقد كنت فيما قد بنى لي حافري % % أعاليه توا وأسفله دحلا % % 6(@)(@@) % فلا أنا مجتاز ، إذا ما دخلته % ولا أنا لاق ما ثويت به أهلا % % 7(@)(@@) % وقد قسموا مالي ، وأضحت حلائلي % % قد استبدلت غيري ببهجتها بعلا % % 8(@)(@@) % وأضحت لبعل غير أخطل ، إذا ثوى % % تلط بعينيها الأشاجع والكحلا % % 9(@)(@@) % أعاذل ، إن النفس في كف مالك % إذا ما دعا يوما ، أجابت له الرسلا % % PageV01P237 10(@)(@@) % ذريني فلا مالي يرد منيتي % % وما إن أرى حيا على نفسه قفلا % % 11(@)(@@) % وليس بخيل النفس بالمال خالدا % ولا من جواد ، فاعلمي ، ميت هزلا % % 12(@)(@@) % ألا رب من تخشى نوائب قومه % وريب المنايا سابقات به الفعلا % % 13(@)(@@) % ويا رب غاز ، وهو يرجى إيابه % وسوف يلاقي دون أوبته شغلا % % 14(@)(@@) % ذكرت انقلاب الدهر ، فاذكر وسيمه % فقد خلت حقا حبها قاتلي قتلا % % 15(@)(@@) % وقد علقتني السقم ، إذ برقت لنا % % على غرة منا ، وما شعرت فضلى % % 16(@)(@@) % رأيت لها وجها أغر ، فراعني % % وطرفا غضيضا مثله أورث الخبلا % % 17 
ms65	(@)(@@) % وخدا أسيلا ، غير زغب مقده % بمذهبة في الجيد ، قد فتلت فتلا % % 18(@)(@@) % فتلك التي لم تخط قلبي بسهمها % % وما وترت قوسا ، ولا رصفت نبلا % % 19(@)(@@) % غداة بدت غراء ، غير قصيرة % تذري على المتنين ذا عذر جثلا % % PageV01P238 20(@)(@@) % فجودي بما يشفي السقيم ، وخلصي % % أسيرا بلا جرم أطلت له الكبلا % % 21(@)(@@) % وإني لمن علياء تغلب وائل % % لأطولها بيتا ، وأثبتها أصلا % % 22(@)(@@) % أنا الجشمي الرحب في الحي منزلا % إذا احتل مضهود بمضنية هزلا % % 23(@)(@@) % وعماي نعم المرء ، عمر و ومالك % وثعلبة المولي بمنظورة فضلا % % 24(@)(@@) % وقد علمت أفناء تغلب أنني % % نضار ، ولم أنبت بقرقرة أثلا % % 25(@)(@@) % وأني يوما لا مضيع ذمارها % % ولا مفلتي هاج هجا تغلبا بطلا % % PageV01P239 البحر : طويل 1(@)(@@) % دنا البين من أروى ، فزالت حمولها % % لتشغل أروى عن هواها شغولها % % 2(@)(@@) % وما خفت منها البينن حتى تزعزت % هماليجها وازور عني دليلها % % 3(@)(@@) % وأقسم ما تنآك ، إلا تخيلت % على عاشق جنان أرض وغولها % % 4(@)(@@) % ترى النفس أروى جنة حيل دونها % % فيا لك نفسا ن لا يصاب غليلها % % 5(@)(@@) % وكم بخلت أروى بما لا يضيرها % % وكم قتلت ، لو كان يودى قتيلها % % 6(@)(@@) % وباعد أروى ، بعد يومي تعلة % خبيب مطايا مالك وذميلها % % 7(@)(@@) % تواصلوا وقالوا زعزعوهن ، بعدما % % جرى الماء منها ، وارفأن جفولها % % 8(@)(@@) % إذا هبطت مجهولة عسفت بها % % معرقة الألحي ، ظماء خصيلها % % 9(@)(@@) % فإن تك قد شطت نواها ، فربما % % سقتنا دجاها ديمة وقبولها % % 10(@)(@@) % لها مربع بالثني ، ثني مخاشن % ومنزلة لم يبق إلا طلولها % % PageV01P240 11(@)(@@) % طفت في الضحى أحداج أروى ، كأنها % % قرى من جواثى محزئل نخيلها % % 12(@)(@@) % لدن غدوة ، حتى إذا ما تيقظت % هواجر من شعبان حام أصيلها % % 13(@)(@@) % فما بلغتها الجرد حتى تحسرت % ولا العيس حتى انضم منها ثميلها % % 14(@)(@@) % لعمري ، لئن أبصرت قصدي ، لربما % % دعاني إلى البيض المراض دليلها % % 15(@)(@@) % ووحش أرانيها الصبى ، فاقتنصتها % % وكأس سلاف باكرتني شمولها % % 16(@)(@@) % فما لبثتني أن حنتني ، كما ترى : % قصيرات أيام الصبى وطويلها % % 17(@)(@@) % وما يزدهيني في الأمور أخفها % % وما أضلعتني يوم ناب ثقيلها % % 18(@)(@@) % ولكن جليل 
ms66	 الرأي في كل موطن % وأكرم أخلاق الرجال جليلها % % 19(@)(@@) % إذا الشعراء أبصرتني تثلعبت % مقاحيمها وازور عني فحولها % % 20(@)(@@) % ومعترض لو كنت أزمعت شتمه % إذا لكفته كلمة ، لو أقولها % % PageV01P241 21(@)(@@) % قريبة تهجوني وعوف بن مالك % وزيد بن عمر و : غرها وكهولها % % 22(@)(@@) % ألا إن زيد اللات ، لا يستجيرها % % كريم ، ولا يوفي فتيلا قبيلها % % 23(@)(@@) % مغازيل ، حلا لون بالغيب ، لا ترى % % غريبتهم ، إلا لئيما حليلها % % 24(@)(@@) % أمعشر كلب ، لا تكونوا كأنكم % بعمياء ، مسدود عليكم سبيلها % % 25(@)(@@) % فما الحق ألا تنصفوا من قتلتم % ويودي لعوف والعقاب قتيلها % % 26(@)(@@) % فلا تنشدونا من أخيكم ذمامة % ويسلم أصداء العوير كفيلها % % 27(@)(@@) % أحاديث سداها ابن حدراء فرقد % ورمازة ، مالت لمن يستميلها % % 28(@)(@@) % إذا نمت عن أعراض تغلب ، لم ينم % أذى مالك أضغانها وذحولها % % 29(@)(@@) % فلا يسقطنكم بعدها ، آل مالك % شرار أحاديث الغواة وقيلها % % 30(@)(@@) % جزى الله خيرا من صديق وإخوة % بما عملت تيم وأوتى سولها % % PageV01P242 البحر : وافر تام 1(@)(@@) % عليك جديد وجهك فابتذله % فقد خلاك ربك للسؤال % 2(@)(@@) % كأنك إذ علقت بعردمي % سميت إلى أمية بالحبال % 3(@)(@@) % لقد ترك النكاح أبا سليم % كظهر الطست ليس بذي قبال % PageV01P243 البحر : كامل تام 1(@)(@@) % عز الشراب ، فأقبلت مشروبة % هدر الدنان بها هدير الأفحل % 2(@)(@@) % وتغيظت أيامها في شارف % نقلت قرائنه ، ولما ينقل % 3(@)(@@) % وترى القلال بجانبيه ، كأنها % % قلص يسفن فروج قرم مرسل % 4(@)(@@) % وكأن أصوات الغواة تعوده % أصوات نوح ، أو جلاجل عوكل % 5(@)(@@) % حتى تصبب ماؤه عن جلفه % ضخم المقدم ، سحبلي الأسفل % 6(@)(@@) % نبيت عبدا من عتيب سبني % % سفها ، ويحسب أنه لم يفعل % 7(@)(@@) % عبدا تقاعس من عتب ربه % واللؤم علقه مكان المحمل % PageV01P244 البحر : كامل تام 1(@)(@@) % رحلت أمامة للفراق جمالها % % كيما تبين فما تريد زيالها % % 2(@)(@@) % ولئن أمامة فارقت ، أو بدلت % ودا بودك ، ما صرمت حبالها % % 3(@)(@@) % ولئن أمامة ودعتك ، ولم تخن % ما قد علمت لتدركن وصالها % % 4(@)(@@) % إربع على دمن تقادم عهدها % % بالجوف واستلب الزمان حلالها % % 5(@)(@@) % دمن لقاتلة الغرانق ما بها % % إلا الوحوش خلت له وخلا لها 
ms67	 % % 6(@)(@@) % بكرت تسائل عن متيم أهله % وهي التي فعلت به أفعالها % % 7(@)(@@) % كانت تريك إذا نظرت أمامها % % مجرى السموط ومرة خلخالها % % 8(@)(@@) % دع ما مضى منها فرب مدامة % صهباء ، عارية القدى ، سلسالها % % 9(@)(@@) % باكرتها عند الصباح على نجى % % ووضعت غير جلالها أثقالها % % 10(@)(@@) % صحبتها غر الوجوه غرانقا % من تغلب الغلباء ، لا أسفالها % % PageV01P245 11(@)(@@) % إخسأ إليك ، جرير ، إنا معشر % منا السماء : نجومها وهلالها % % 12(@)(@@) % ما رامنا ملك يقيم قناتنا % % إلا استبحنا خيله ورجالها % % PageV01P246 البحر : خفيف تام 1(@)(@@) % ودعا اللؤم أهله وبنيه % فأجابوه وقفا ونزولا % % 2(@)(@@) % فأجابت محارب وغني % ودعا دون ذاك شبرا سلولا % % PageV01P247 البحر : - 1(@)(@@) % رمتك ريا في مناط المقتل % وأنت لم ترم ولم تخبل % 2(@)(@@) % ريا ولم تدن ، ولم تهلل % منها ، فمعقولك كالمخبل % PageV01P248 البحر : طويل 1(@)(@@) % ألا طرقت أروى الرحال وصحبتي % % بأرض يناصي الحزن منها سهولها % % 2(@)(@@) % وقد غابت الشعرى العبور وقاربت % لتنزل ، والشعرى بطيء نزولها % % 3(@)(@@) % ألمت بشعث راكبين رؤوسهم % وأكوار عيس قد براها رحيلها % % 4(@)(@@) % تبين خليلي ناصح الطرف ، هل ترى % % بعينك ظعنا ، قد أقلت حمولها % % 5(@)(@@) % تحملن من صحراء فلج ، ولم يكد % بصير بها من ساعة يستحيلها % % 6(@)(@@) % تمايلن للأهواء ، حتى كأنما % % يجور بها في السير عمدا دليلها % % 7(@)(@@) % نواعم ، لم يلقين في العيش ترحة % ولا عثرة من جد سوء يزيلها % % 8(@)(@@) % ولو بات يسري الذر فوق جلودها % % لأثر في أبشارهن محيلها % % 9(@)(@@) % فلما استوى نصف النهار وأظهرت % وقد حان من عفر الظباء مقيلها % % 10(@)(@@) % حثثن المطايا ، فاصمعدت لشأنها % % ومد أزمات الجمال ذميلها % % PageV01P249 11(@)(@@) % فلما تلاحقنا ، نبذنا تحية % إليهن ، والتذ الحديث أصيلها % % 12(@)(@@) % فكان لدينا السر بيني وبينها % % ولمع غضيضات العيون رسولها % % 13(@)(@@) % فما خلتها إلا دوالح أوقرت % وكمت بحمل نخلها وفسيلها % % 14(@)(@@) % تسلسل فيها جدول من محلم % إذا زعزتها الريح كادت تميلها % % 15(@)(@@) % يكاد يحار المجتني وسط أيكها % % إذا ما تنادى بالعشي هديلها % % 16(@)(@@) % رأيت قروم ابني نزار ، كليهما % % إذا خطرت عند الإمام فحولها % % 17(@)(@@) % يرون لهمام عليهم فضيلة % إذا ما قروم الناس عدت فضولها % % 18 
ms68	(@)(@@) % وأكملها عقلا لدى كل موطن % إذا وزنت ، فيما يشك ، عقولها % % 19(@)(@@) % فتى الناس همام ، وموضع بيته % برابية ، يعلو الروابي طولها % % 20(@)(@@) % فلو كان همام من الجن ، أصبحت % سجودا له جن البلاد وغولها % % PageV01P250 21(@)(@@) % نمته الذرى من مالك ، وتعطفت % عليه الروابي : فرعها وأصولها % % 22(@)(@@) % أجادت به ساداتها ، فترغبت % لأخلاقه : أمجادها وحفيلها % % 23(@)(@@) % تذرى جبالا منهم مكفهرة % يكاد يعسد الأفق منها حلولها % % 24(@)(@@) % لأخذ نصيب ، أو لأمر يعولها % % إذا ضيعت عون النساء وحولها % % 25(@)(@@) % تعد لأيام الحفاظ كأنها % % قنا ، لم يقوم درأها مستحيلها % % 26(@)(@@) % فما تبلت تبلا ، فيدرك عندها % % ولا سقبتها في سواها تبولها % % 27(@)(@@) % سبوق لغايات الحفاظ ، إذا جرى % % ووهاب أعناق المئين حمولها % % 28(@)(@@) % ودفاع ضيم ، لا يسام دنية % وقطاع أقران الأمور ، وصولها % % 29(@)(@@) % وأخاذ أقصى الحق ، لا متهضم % أخوه ، ولا هش القناة ، رذيلها % % 30(@)(@@) % أغر أريب ليس ينقض عهده % % PageV01P251 31(@)(@@) % جواد ، إذا ما أمحل الناس ممرع % كريم لجوعات النساء قتولها % % 32(@)(@@) % إذا نائبات الدهر شقت عليهم % كفاهم أذاها ، فاستخف ثقيلها % % 33(@)(@@) % عروف لإضعاف المرازي ماله % إذا عج منحوت الصفاة ، بخيلها % % 34(@)(@@) % وكرار خلف المرهقين جواده % حفاظا ، إذا لم يحم أنثى حليلها % % 35(@)(@@) % ثنى مهره ، والخيل رهو كأنها % % قداح على كفي مفيض يجيلها % % 36(@)(@@) % يهين وراء الحي نفسا كريمة % لكبة موت ليس يودى قتلها % % 37(@)(@@) % ويعلم أن المرء ليس بخالد % وأن منايا الناس يسعى دليلها % % 38(@)(@@) % فإن عاش همام لنا ، فهو رحمة % من الله ، لم تنفس علينا فضولها % % 39(@)(@@) % وإن مات ، لم تستبدل الأرض مثله % لأخذ نصيب ن أو لأمر يعولها % % 40(@)(@@) % وما بت إلا واثقا إن مدحته % بدولة خير من نداه يديلها % % PageV01P252 البحر : وافر تام 1(@)(@@) % عفا من آل فاطمة الدخول % فحزان الصريمة ، فالهجول % 2(@)(@@) % منازل أقفرت من أم عمرو % % يظل سرابها فيها يجول % 3(@)(@@) % شآمية المحل ، وقد أراها % % تعوم لها بذي خيم حمول % 4(@)(@@) % ولو تأت الفراشة والحبيا % % إذا كادت تخبرك الطلول % 5(@)(@@) % عن العهد القديم وما عفاها % % بوارح يختلفن ولا سيول % 6(@)(@@) % ألا أبلغ بني شيبان عني % % فما 
ms69	 يبني وبينكم ذحول % 7(@)(@@) % وكنتم إخوتي ، فخذلتموني % % غداة تخاطرت تلك الفحول % 8(@)(@@) % تواكلني بنو العلات منكم % وغالت مالكا ويزيد غول % 9(@)(@@) % قريعا وائل هلكا جميعا % كأن الأرض ، بعدهم ، محول % 10(@)(@@) % فإن تمنع سدوس درهميها % % فإن الريح طيبة قبول % PageV01P253 11(@)(@@) % متى آت الأراقم لا يضرني % % نبيب الأسعدي ، وما يقول % 12(@)(@@) % رواب من بني جشم بن بكر % تصدع عن مناكبها السيول % 13(@)(@@) % وإن بني أمية ألبسوني % % ظلال كرامة ، ما إن تزول % 14(@)(@@) % تولاها أبو مروان بشر % لفضل ، ما يمن وما يحول % 15(@)(@@) % وشهباء المغافر قارعتنا % % ململمة يلوذ بها الفلول % 16(@)(@@) % مسومة ، كأن محافظيها % % تصدع بينهم صرف شمول % 17(@)(@@) % ركود ، لم تكد عنا رحاها % % ولا مرحا حمياها تزول % 18(@)(@@) % فدافعها بإذن الله عنا % % شباب الصدق منا والكهول % 19(@)(@@) % ووقع المشرفية في حديد % لهن وراء حلقته صليل % 20(@)(@@) % وضنك لو يقوم الفيل فيه % لأرعدت الفرائص والخصيل % PageV01P254 21(@)(@@) % جست به على المكروه نفسي % % وليس يقومه إلا قليل % PageV01P255 البحر : طويل 1(@)(@@) % أتاني وأهلي بالجزيرة من منى % % على نأيه ، أن ابن مغراء قد علا % % 2(@)(@@) % فإني لقاض بين جعدة عامر % وسعد قضاء يتبع الحق فيصلا % 3(@)(@@) % أبو جعدة الذئب الخبيث طعامه % وعوف بن كعب ، كان أكرم أولا % % 4(@)(@@) % تعاف الكلاب الضاريات لحومكم % ويأكلن من أولاد سعد ونهشلا % % PageV01P256 البحر : طويل 1(@)(@@) % ألا طرقتنا ليلة أم هيثم % بمنزلة تعتاد أرحلنا فضلا % % 2(@)(@@) % تروقك عيناها ، وأنت ترى لها % % على حيث يلقى الزوج منبطحا سهلا % % 3(@)(@@) % إذا السابري الحر أخلص لونها % % تبينت لا جيدا قصيرا ولا عطلا % % 4(@)(@@) % إذا ما مشت تهتز لا أحمرية % ولا نصف تظن من جسمها دخلا % % PageV01P257 البحر : طويل 1(@)(@@) % محا رسم دار بالصريمة مسبل % نضوح وريح تعتريه جفول % 2(@)(@@) % فغير آيات الحبيب مع البلى % % بوارح تطوي تربها وسيول % 3(@)(@@) % ديار لأروى والرباب ، ومن يكن % له عند أروى والرباب تبول % 4(@)(@@) % يبت وهو مشحوذ عليه ، ولا يرى % % إلى بيضتي وكر الأنوق سبيل % 5(@)(@@) % وما خفت بين الحي ، حتى رأيتهم % % لهم بأعالي الجأبتين حمول % 6(@)(@@) % فبانوا بأروى ، يوم ذلك 
ms70	 ، كأنها % % من الأدم غناء البغام خذول % 7(@)(@@) % مبنة غار ، أينما تنح شمسه % لحال ، فقرن الشمس فيه ظليل % 8(@)(@@) % لها من وراق ناعم ما يكنها % % مرف ترعاه الضحى وربول % 9(@)(@@) % وكم قتلت أروى ، بلا ترة لها % % وأروى لفراغ الرجال قتول % 10(@)(@@) % فلو كان مبكى ساعة لبكيتها % % ولكن شر الغانيات طويل % PageV01P258 11(@)(@@) % ظللت ، كأني شارب أزلية % ركود الحميا في العظام شمول % 12(@)(@@) % صريع فلسطينية ، راعه بها % % من الغور عن طول الفراق ، حليل % 13(@)(@@) % أبوا أن يقيلوا ، إذ توقد ومهم % وقد جعلت عفر الظباء تقيل % 14(@)(@@) % وأشرف حرباء الظهيرة يصطلي % % وهن على عيدانهن جذول % % 15(@)(@@) % أجدوا نجاء ، غيبتهم عشية % خمائل من ذات المشا وهجول % 16(@)(@@) % وكنت صحيح القلب حتى أصابني % % من اللامعات المبرقات خبول % 17(@)(@@) % من المائلات الغيد وهنا ، وإنها % % على صرمه أو وصله لغفول % 18(@)(@@) % وكن على أحيالهن يصدنني % % وهن بلايا للرجال وغول % 19(@)(@@) % وإن امرءا لا ينتهي عن غواية % إذا ما اشتهتها نفسه لجهول % PageV01P259 البحر : طويل 1(@)(@@) % ألا لا تلوميني على الخمر عاذلا % % ولا تهلكيني ، إن في الدهر قاتلا % % 2(@)(@@) % ذريني فإن الخمر من لذة الفتى % % ولو كنت موغولا علي وواغلا % % 3(@)(@@) % وإني لشراب الخمور معدل % إذا هرت الكأس الرخام التنابلا % % 4(@)(@@) % أخو الحرب ثبت القول في كل موطن % إذا جشأت نفس العبي المحافلا % % 5(@)(@@) % أماوي لولا حبك العام لم أقع % بمصر ولم أنظر ببيعي قابلا % % 6(@)(@@) % كما منعت أسماء صحبي ومزودي % % عشية قربت المطية راحلا % % 7(@)(@@) % مصاحب خوص قد نحلن كأنما % % يقين النفوس أن تمس الكلاكلا % % 8(@)(@@) % إذا كان عن حين من الليل نبهت % بأصواتها زغبا توافي الحواصلا % % 9(@)(@@) % توائم كسيت بعد عري ، وألبست % برانس كدرا لم تعن الغوازلا % % 10(@)(@@) % طوالع من نجد الرحوب كأنما % % رمى الآل بالأظعان نخلا حواملا % % PageV01P260 11(@)(@@) % ظعائن ليلى والفؤاد مكلف % بليلى وما تعطي أخا الود طائلا % % 12(@)(@@) % أبت أن ترد النفس في مستقرها % % وما وصلت حبل امرئ كان واصلا % % 13(@)(@@) % فسل لبانات الصبى بجلالة % جمالية تطوي عليها المجاهلا % % 14(@)(@@) % كأن قتود الرحل فوق مصدر % ترعى 
ms71	 قفاف الأنعمين فعاقلا % % 15(@)(@@) % يحدر عشرا لا يرى العيش غيرها % % مشيحا عليها في المغار وحاظلا % % 16(@)(@@) % فظلت عطاشا وهو حام يذودها % % يخاف رماة موقفين وحابلا % % 17(@)(@@) % إلى أن رأى أن الشريعة قد خلت % وأتبع منها الآخرات الأوائلا % % 18(@)(@@) % وأبصرن إذ أجلين عن كل تولب % أبا الشبل بين الغيض والفيض ماثلا % % 19(@)(@@) % فأدبر يحدوها كأن زماله % زمال شروب وجع منه الأباجلا % % PageV01P261 البحر : كامل تام 1(@)(@@) % صرمت أمامة حبلها ورعوم % وبدا المحجمجم منهما المكتوم % 2(@)(@@) % للبين منا واختيار سوائنا % % ولقد علمت لغير ذاك أروم % 3(@)(@@) % وإذا هممن بغدرة أزمعنها % % خلفا ، فليس وصالهن يدوم % 4(@)(@@) % ودعا الغواني إذا رأين تهشمي % % روق الشباب فما لهن حلوم % 5(@)(@@) % ورأين أني قد علتني كبرة % فالوجه فيه تضمر وسهوم % 6(@)(@@) % وطوين ثوب بشاشة أبلينه % فلهن منك هساهس وهموم % 7(@)(@@) % وإذا مشيت هدجت غير مبادر % رسف المقيد ما أكاد أريم % 8(@)(@@) % ولقد يكن إلي صورا مرة % أيام لون غدائري يحموم % 9(@)(@@) % ولقد أكون من الفتاة بمنزل % فأبيت لا حرج ولامحروم % 10(@)(@@) % ولقد أغص أخا الشقاق بريقه % % فيصد وهو عن الحفاظ سؤوم % PageV01P262 11(@)(@@) % ولقد تباكرني على لذاتها % % صهباء عارية القذى خرطوم % 12(@)(@@) % من عاتق حدبت عليه دنانه % وكأنها جربى بهن عصيم % 13(@)(@@) % مما تغالاه التجار غريبة % ولها بعانة والفرات كروم % 14(@)(@@) % وتظل تنصفنا بها قروية % إبريقها برقاعها ملثوم % 15(@)(@@) % وإذا تعاورت الأكف زجاجها % % وله بخينف منتأى وتخوم % 16(@)(@@) % وكأن شاربها أصاب لسانه % من داء خيبر أو تهامة موم % 17(@)(@@) % ولقد تشق بي الفلاة إذا طفت % أعلامها وتغولت علكوم % 18(@)(@@) % غول النجاء كأنها متوجس % بالقريتين مولع موشوم % 19(@)(@@) % باتت تكفئه إلى محانته % نكباء تلفح وجهه وغيوم % 20(@)(@@) % صرد الأديم كأنه ذو شجة % بردت عليه من المضيض كلوم % PageV01P263 21(@)(@@) % وكأنما يجري على مدارته % مما تحلب لؤلؤ منظوم % 22(@)(@@) % فحلمتها وبنو رفيدة دونها % % وبدت متان حوله وحزوم % 23(@)(@@) % هاجت له غضف الضراء مغيرة % كالقد ليس لهامهن لحوم % 24(@)(@@) % فانصاع كالمصباح يطفو مرة % ويلوح وهو مثابر مدهوم % 25(@)(@@) % حتى إذا ما انجاب عنه 
ms72	 روعه % وأفاق بعد فرراره المهزوم % 26(@)(@@) % هز السلاح لهن مصعب قفرة % متخمط بلغامه مرثوم % 27(@)(@@) % يهوي فيقعص ما أصاب بروقه % فجبينه جسد به تدميم % 28(@)(@@) % فتنهنهت عنه وولى يقتري % % رملا بجبة تارة ويصوم % 29(@)(@@) % يرعى صحارى حامر أصيافها % % وله نجينف منتأى وتخوم % 30(@)(@@) % وفلاة يعفور يحار بها القطا % % وكأنما الحادي بها مأموم % PageV01P264 31(@)(@@) % قد جبتها لما توقد حرها % % إني كذاك على الأمور هجوم % 32(@)(@@) % أسريتها بطوالة أقرابها % % يبغمن وهي عن البغام كظوم % 33(@)(@@) % ولقد تأوب أم جهم أركبا % طبخت هواجر لحمها وسموم % 34(@)(@@) % وقعوا وقد طالت سراهم وقعة % فهم إلى ركب المطي جثوم % 35(@)(@@) % فحملتها وبنو رفيدة دونها % % لا يبعدن خيالها المحلوم % 36(@)(@@) % وتجاوزت خشب الأريط ودونه % عرب ترد ذوي الهموم وروم % 37(@)(@@) % حبسوا المطي على قديم عهده % طام يعين ومظلم مسدوم % 38(@)(@@) % فكأن صوت حمامة في قعره % عند الأصيل إذا ارتجسن خصوم % 39(@)(@@) % ويقعن في خلق الإزاء كأنه % نؤي تقادم عهده مهدوم % 40(@)(@@) % وإذا الذنوب أحيل في متثلم % شربت غوائل ماءه وهزوم % PageV01P265 41(@)(@@) % أجميع قد فسكلت عبدا تابعا % فبقيت أنت المفحم المعكوم % 42(@)(@@) % فاهتم لنفسك يا جميع ولا تكن % لبني قريبة والبطون تهيم % 43(@)(@@) % واعدل لسانك عن أسيد إنهم % كلأ لمن ضغنوا عليه وخيم % 44(@)(@@) % وانزع إليك فإنني لا جاهل % بكم ولا أنا إن نطقت فحوم % 45(@)(@@) % وانظر جميع إذا قناتك هزهزت % هل في قناتك قادح ووصوم % % 46(@)(@@) % أبني قريبة إنه يخزيكم % نسب إذا عد القديم لئيم % 47(@)(@@) % من والد دنس وخال ناقص % وحديث سوء فيكم وقديم % 48(@)(@@) % أبني قريبة ويحكم لا تركبوا % % قتب الغواية إنه مشؤوم % 49(@)(@@) % وملحب خضل الثياب كأنما % % وطئت عليه بخفها العيثوم % 50(@)(@@) % قتلت أسامة ثم لم يغصب له % أحد ولم تكسف عليه نجوم % PageV01P266 البحر : طويل 1(@)(@@) % أتعرف من أسماء بالجد روسما % % محيلا ، ونؤيا دارسا ، قد تهدما % % 2(@)(@@) % وموضع أحطاب ، تحمل أهله % وموقد نارن كالحمامة أسحما % % 3(@)(@@) % على آجن أبقت له الريح دمنة % وحوضا ، كأدحي النعامةن أثلما % % 4(@)(@@) % ترى مشفر العيساء حين تسوفه % إذا وجدت 
ms73	 طعم المرارة أكزما % % 5(@)(@@) % كأن اليمامي الطبيب انبرى لها % % فذر لها في الحوض شريا وعلقما % % 6(@)(@@) % بأحناء مجهول تعاوى سباعه % تقوض ، حتى كان للطير أدرما % % 7(@)(@@) % إذا صدرت عنه حمام ، تركنه % لورد قطا ، يسقي فرادى وتوأما % % 8(@)(@@) % تراها إذا راحت رواء كأنها % % معلقة عند الحناجر حنتما % % 9(@)(@@) % تأوب زغبا بالفلاة ، تركنها % % بأغبر مجهول المخارم أقتما % % 10(@)(@@) % إذا نبهتهن الروافد بالقرى % % سقين مجاجات هوامد جثما % % PageV01P267 11(@)(@@) % ينبهن قيظي الفراخ ، كأنما % % ينبهن مغمورا من النوم أعجما % % 12(@)(@@) % ثنين عليه الريشن حتى تلاحقت % وصار شعاعا قيظها ، قد تحطما % % 13(@)(@@) % فصارت شلالا وابذعرت كأنها % % عصابة سبي ، شع أن يتقسما % % 14(@)(@@) % لعمري لئن أبصرت قصدي لقد أنى % % لمثلي يا دهماء أن يتحلما % % 15(@)(@@) % وبيداء محل ، لا يناخ مطيها % % إذا صخب الحادي بها وتهمهما % % 16(@)(@@) % ترى القوم فيها يركبون رؤوسهم % من النوم ، حتى يكبح الواسط الفما % % 17(@)(@@) % قطعت بهوجاء النجاء نجيبة % عذافرة تهدي المطي المخزما % % 18(@)(@@) % قريبة تهجوني ، وعوف بن مالك % وزيد بن عمرو . طال هذا تحلما % % 19(@)(@@) % ويا لله ما تهجونني من عداوة % ثكلتم ، وما ترمون بالقذع مفحما % % 20(@)(@@) % وإنا لحي الصدق ، لا غرة بنا % % ولا مثل من يقري البكيء المصرما % % PageV01P268 21(@)(@@) % % ونجمع للحرب الخميس العرمرما % % 22(@)(@@) % ومستنبح بعد الهدو ، دعوته % بصوتي ، فاستعشى بنضو تزغما % % 23(@)(@@) % وإني لحلال بي الحق ، أتقى % % إذا نزل الأضياف ، أن أتجهما % % 24(@)(@@) % إذا لم تذد ألبانها عن لحومها % % حلبنا لهم منها بأسيافنا دما % % 25(@)(@@) % ومنتحل مني العداوة ، ناله % عناجيج أفراس ، إذا شاء ألجما % % 26(@)(@@) % فإن أك قد عانيت قومي ، وهبتهم % % فهلهل وأولى عن نعيم بن أخثما % % 27(@)(@@) % فإن أعف عنكم ، يا نعيم ، فغيركم % ثنى عنكم مني المسر المجمجما % % 28(@)(@@) % فجاء ، وقد بلت عليه ثيابه % سحابة مسود من الليل أظلما % % 29(@)(@@) % % إذا نبه المبلود فيها ، تغمغما % % 30(@)(@@) % فلما أضاءته لنا النار ، واصطلى % % أضاءت هجفا موحشا ، قد تشهما % % PageV01P269 31(@)(@@) % فنبهت سعدا بعد نوم لطارق % أتانا ضئيلا صوته ، حين سلما % % 32(@)(@@) % فقلت لهم : هاتوا ذخيرة مالك % وإن كان قد لا قى لبوسا ومطعما 
ms74	 % % 33(@)(@@) % فقال : ألا لا تجشموها ، وإنما % % تنحنح دون المكرعات ، لتجشما % % PageV01P270 البحر : بسيط تام 1(@)(@@) % أتعرف الدار ، أم عرفان منزلة % لم يبق غير مناخ القدر والحمم % 2(@)(@@) % وغير نؤي رمته الريح أعصره % فهو ضئيل كحوض الآجن الهدم % 3(@)(@@) % كانت منازل أقوام ، فغيرها % % مر الليالي ونضح العارض الهزم % 4(@)(@@) % وقد تكون بها هيف ، منعمة % لا يلتفعن على سوء ولا سقم % 5(@)(@@) % لا يصطلين دخان النار ، شاتية % إلا بعود يلنجوج على فحم % 6(@)(@@) % يمشين مشي الهجان الأدم روحها % % عند الأصيل ، هدير المصعب القطم % 7(@)(@@) % لقد حلفت بما أسرى الحجيج له % والناذرين دماء البدن في الحرم % 8(@)(@@) % لولا الوليد ، وأسباب تناولني % % بهن ، يوم اجتماع الناس بالثلم % 9(@)(@@) % إذا لكنت كمن أودى ، وودأه % أهل القرابة بين اللحد والرجم % 10(@)(@@) % أهلي فداؤك ، يوم المحرمون بها % % مقاسم المال أو مغض على ألم % PageV01P271 11(@)(@@) % يوم المقامات ، والأموال محضرة % حول امرئ غير ضجاج ولا برم % 12(@)(@@) % إن ابن مروان أسقاني على ضمإ % % بسجل ، لا عاتم ريثا ولا خذم % 13(@)(@@) % ما يحرم السائل الدنيا ، إذا عرضت % وما تعود منه المال بالقسم % 14(@)(@@) % لا يستقل رجال ما تحمله % ولا قريبون من أخلاقه العظم % 15(@)(@@) % من آل عفان فياض العطاء إذا % % أمسى السحاب خفيف القطر ، كالصرم % % 16(@)(@@) % تسوقه ، تحمل الصراد مجدبة % حتى تساقط بين الضال والسلم % 17(@)(@@) % فهم هنالك خير الناس ، كلهم % % عند البلاء ، وأحماهم على الكرم % 18(@)(@@) % ألباسطون بدنياهم أكفهم % والضاربون غداة العارض الشبم % 19(@)(@@) % والمطعمون ، إذا ما أزمة أزمت % والمقدمون على الغارات بالجذم % 20(@)(@@) % عوابس الخيل إذا عضت شكائمها % % وأصحرت عن أديم الفتنة الحلم % PageV01P272 21(@)(@@) % هم الأولى كشفوا عنا ضبابتها % % وقوموها بأيديهم عن الضجم % 22(@)(@@) % فإذ أتتكم وأعطتكم بدرتها % % فاحتلبوها هنيئا ، يا بني الحكم % 23(@)(@@) % بني أمية ، قد أحدت فواضلكم % منكم جيادي ، ومنك قبلها نعمي % % 24(@)(@@) % فهي ، غذا ذكرت عندي وإن قدمت % يوما ، كخط كتاب الكف بالقلم % 25(@)(@@) % فإن حلفت ، لقد أصبحت شاكرها % % لا أحلف ، اليوم ، من هاتا على أثم % 26(@)(@@) % لولا بلاؤكم في غير واحدة % إذا لقمت مقام الخائف 
ms75	 الزرم % 27(@)(@@) % أسمعتكم يوم أدعو في مودأة % لولاكم شاع لحمي عندها ودمي % % 28(@)(@@) % لولا تناولكم أياي ، ما علقت % كفي بأرجائها القصوى ولا قدمي % % 29(@)(@@) % وقد علمتم وإن أصبحت نائيكم % نصحي ، قديما ، وفعلي غير متهم % 30(@)(@@) % لقد خشيت وشاة الناس عندكم % ولا صحيح على الأعداء والكلم % PageV01P273 البحر : طويل 1(@)(@@) % عفا الجو من سلمى فبادت رسومها % % فذات الصفا : صحراؤها فقصيمها % % 2(@)(@@) % فأصبح ما بين الكلاب وحابس % قفارا ، تغنيها مع الليل بومها % % 3(@)(@@) % خلت غير أحدان تلوح ، كأنها % % نجوم بدت وانجاب عنها غيومها % % 4(@)(@@) % بمستأسد يجري الندى في رياضه % سقته أهاضيب الصبا ومديمها % % 5(@)(@@) % إذا قلت : قد خفت تواليه ، أصبحت % به الريح من عين سريع جمومها % % 6(@)(@@) % فما زال يسقي بطن خبت وعرعر % وأرضهما ، حتى اطمأن جسيمها % % 7(@)(@@) % وعممها بالماء ، حتى تواضعت % رؤوس المتان : سهلها وحزومها % % 8(@)(@@) % بمرتجز داني الرباب ، كأنه % على ذات فلج مقسم ، لا يريمها % % 9(@)(@@) % إذا طعنت فيه الجنوب تحاملت % بأعجاز جرار تداعى خصومها % % 10(@)(@@) % سقى الله منه دار سلمى برية % على أن سلمى ليس يشفى سقيمها % % PageV01P274 11(@)(@@) % من العربيات البوادي ، ولم تكن % تلوحها حمى دمشق ومومها % % 12(@)(@@) % ولو حملتني السر سلمى حملته % وهل يحمل الأسرار إلا كتومها % % 13(@)(@@) % إليكم ، أبا مروان يمم أركب % أتوك بأنضاء خفاف لحومها % % 14(@)(@@) % تحسرن ، واستقبلن للقيظ وقدة % تغير ألوان الرجال سمومها % % 15(@)(@@) % إليك من الأغوارن حتى تراجمت % عراها على جون قليل شحومها % % 16(@)(@@) % رجاء تراكم ، إن من ينتويكم % يوافق حسنى ، ما يغب نعيمها % % 17(@)(@@) % فأنت الذي ترجو الصعاليك سيبه % إذا السنة الشهباء خوت نجومها % % 18(@)(@@) % ونفسي تمنيني العراق وأهله % وبشر هواها منهم وحميمها % % 19(@)(@@) % إذا بلغت بشر بن مروان ناقتي % % سرت خوفها نفسي ونامت همومها % % 20(@)(@@) % إمام يقود الخيل ، حتى كأنها % % صدور القنا : معوجها وقويمها % % PageV01P275 21(@)(@@) % إلى الحرب حتى تخضع الحرب ، بعدما % % تخمط مرحاها وتحمى قرومها % % 22(@)(@@) % أبوك أبا العاصي ، عليكم تعطفت % قريش لكم : عرنينها وصميمها % % 23(@)(@@) % أبى أن يكون التاج ، إلا عليكم % لصيد أبي العاصي ، الشديد شكيمها % % 24(@)(@@) % بكم أدرك الله البرية ، بعدما 
ms76	 % % سعى لصها فيها وهب غشومها % % 25(@)(@@) % وإنك لمأمول والمتقى به % إذا خيف من تلك الأمور عظيمها % % 26(@)(@@) % وإنك للأخرى ، إذا هي شبهت % لقطاع أقران الأمور صرومها % % 27(@)(@@) % فلا تطعمن لحمي الأعادي ، إنه % سريع إليكم مكرها ونميمها % % 29(@)(@@) % لقد عجموا مني قناة صليبة % إذا ضج خوار القناة سؤومها % % 30(@)(@@) % وما أنا ، إن مد المدى ، بمقصر % ولا عضة مني بناج سليمها % % 31(@)(@@) % وإني لقوام مقاوم ، لم يكن % جرير ، ولا مولى جرير يقومها % % PageV01P276 32(@)(@@) % أيشتمني ابن الكلب ، أن فاض دارم % عليه ورامى صخرة ما يرومها % % 33(@)(@@) % بنو دارم نبع صلاب ، وأنتم % بني الكلب أثل ما يوارى وصومها % % 34(@)(@@) % فلولا التحشي من رياح ، رميتها % % بكالمة الأعراض ، باق وسومها % % 35(@)(@@) % يغني ابن يربوع بشتمي أمه % % 36(@)(@@) % وما وجدوا أما له عربية % وما أسهرتنا من ختان كلومها % % 37(@)(@@) % وقد آل من نسل المراغة ، أنها % % على النخس والإتعاب باق رسيمها % % 38(@)(@@) % وعرت حماريها ، وقد كانت استها % % شديدا بسيساء الحمار أزومها % % 39(@)(@@) % وجدت كليبأ ألأم الناس كلهم % وأنت إذا عدت كليب لئيمها % % PageV01P277 البحر : طويل 1(@)(@@) % ولم تظلما أن تكفيا الحي ضيفهم % % وأن تسقيا سقيا السراة الأكارم % 2(@)(@@) % وأن تسعيا مسعاة سلمى بن جندل % وسعى حبيش بين غول وقادم % 3(@)(@@) % وأن تعقرا بكرين مما جمعتما % % وشر الندامى من صحا غير غارم % PageV01P278 البحر : طويل 1(@)(@@) % ظغائن ، من هلال ذؤابة % هجان ، وأما من سراة الأراقم % 2(@)(@@) % إذا بحثت أنسابهن لسائل % دعون عكبا أو بجير بن سالم % PageV01P279 البحر : طويل 1(@)(@@) % ألا حييا دارا لأم هشام % وكيف تنادى دمنة بسلام ؟ % 2(@)(@@) % أجازية بالوصل ، إذ حيل دونه % وما الذكر ، بعد اليأس ، غير سقام % 3(@)(@@) % محا عارصات الدار بعدك ملبس % أهاضيب رجاف العشي ركام % 4(@)(@@) % وكل سماكي كأن نشاصه % إذا راح أصلا حافلات نعام % 5(@)(@@) % تعرض بالمصر العراقي ، بعدما % % تقطعت الأهواء دون عصام % 6(@)(@@) % إذا ضحكت ، لم تنتهت وتبسمت % % بأبيض لم تكدم متون عظام % 7(@)(@@) % عشية رحنا والعيون كأنها % % جداول سيل ، بتن غير نيام % 8(@)(@@) % إلى الملك النفاح ، أهلي فداؤه % وكوري وأعلاقي العلى وسوامي % % 9 
ms77	(@)(@@) % فلا تخلفن الظن ، إنك والندى % % حليفا صفاء في محل مقام % 10(@)(@@) % نماك هشام للفعال ونوفل % وآل أبي العاصي لخير أنام % PageV01P280 11(@)(@@) % فأنت المرجى من أمية كلها % % وترفد حمدا من ندى وتمام % 12(@)(@@) % وإني وإن فضلت تغلب بالقرى % % إذا أصبحت غبراء ذات قتام % % 13(@)(@@) % وراع إلى النيران كل معصب % لمثن على بكر بشر أثام % 14(@)(@@) % إذا علم البكري أنك نازل % قراك سبابا دون كل طعام % 15(@)(@@) % لعمرك ما قفال بكر بن وائل % براجعة أعراضهم بسلام % PageV01P281 البحر : طويل 1(@)(@@) % سعى لي قومي سعي قوم أعزة % فأصبحت أسمو للعلى والمكارم % 2(@)(@@) % تمنوا لنبلي أن تطيش رياشها % % وما أنا عنهم في النضال بنائم % 3(@)(@@) % وما أنا إن جار دعاني إلى التي % % تحمل أصحاب الأمور العظائم % 4(@)(@@) % ليسمعني ، والليل بيني وبينه % عن الجار ، بالجافي ولا المتناوم % 5(@)(@@) % ألم تر أني قد وديت ابن مرفق % ولم تود قتلي عبد شمس وهاشم % 6(@)(@@) % جزى الله فيها الأعورين مذمة % وعبدة ثفر الثورة المتضاجم % 7(@)(@@) % فأعيوا ، وما المولى بمن قل رفده % إذا أجحفت بالناس إحدى العقائم % 8(@)(@@) % وما الجار بالراعيك ، ما دمت سالما % ويزحل عند المضلع المتفاقم % PageV01P282 البحر : طويل 1(@)(@@) % ألا يا اسلمي بالسعد يا أخت دارم % ولو شت صرف من نوى لم تلائم % 2(@)(@@) % هلالية حلت بخبت وأوطنت % مصيفا من البهمى وقيظ الصرائم % 3(@)(@@) % وقد كان يحلو لي زمانا حديثها % % وليس بنزر كاختلاس المصارم % 4(@)(@@) % فحالت قروم من بني البشر دونها % % وما الوصل إلا رجعها للمسالم % 5(@)(@@) % ولو حملتني السر دوسر لم تضع % مقالة ذي نصح وللسر كاتم % 6(@)(@@) % وأسند أمر الحي بعد التباسه % إلى كل جلد مبرم الأمر جازم % 7(@)(@@) % وإني ولو شتت نواها بودها % % لصلب التعزي مستمر الشكائم % 8(@)(@@) % وكنت إذا زينت أوجه معشر % أنارت وإن أشتم تصر كالعظالم % PageV01P283 البحر : طويل 1(@)(@@) % فوارس خروب تناهوا ، وإنما % % أخو المرء من يحمى له ويلايمه % 2(@)(@@) % فخرتم بأيام الكلاب وغيركم % أتيحت له أسلابه ومحارمه % % 3(@)(@@) % ففي أي يوم باسل ، لم يكن لنا % % بني عمنا ، مراته وعزايمه % 4(@)(@@) % وإنا لقوادون 
ms78	 للأمر قومنا % % يكون لنا ميمونه وأشايمه % 5(@)(@@) % وإنا لجزاؤون بالخير أهله % وبالشر حتى يسأم الشر سايمه % PageV01P284 البحر : بسيط تام 1(@)(@@) % إذا هبطن مناخا ينتطحن به % أحلهن سناما عافيا جشم % 2(@)(@@) % ترعاه إن خاف أقوام وإن أمنوا % % وفي القبائل عنه غيرنا لزم % PageV01P285 البحر : بسيط تام 1(@)(@@) % لا يرهب الضبع من أمست بعقوته % إلا الأذلان : زيد اللات والغنم % 2(@)(@@) % هاتا لهن ثغاء وهي جائلة % وهؤلاء قابلو خسف وإن رغموا % % PageV01P286 البحر : طويل 1(@)(@@) % ألا إن زيد اللات ، يوم لقيتهاألا إن زيد اللات ، يوم لقيتها % % علاقة سوء ، في إناء مثلم % 2(@)(@@) % قبيلة ما يغدرون بذمة % ولا يظلمون الناس مثقال درهم % 3(@)(@@) % ولا يردون الماء ، إلا عشية % على طول أظماء ووجه ملطم % 4(@)(@@) % هو العبد يجبى كل يوم ضريبة % متى تلزم العبد المذلة ، يلزم % PageV01P287 البحر : وافر تام 1(@)(@@) % ألا يا ليت كلبا بادلونا % % بمولاها ، فكان لنا الصميم % 2(@)(@@) % فبادلنا بزيد اللات عوضا % كلا البدلين مقترف بهيم % 3(@)(@@) % وطانجة التي لا عز فيها % % تجير به ولا حسب كريم % 4(@)(@@) % لعمرك إنني وابني جعيل % وأمهما لإستار لئيم % 5(@)(@@) % فما تدري ، إذا ما الناس ساروا % % أتظعن بعد ذلك أم تقيم % 6(@)(@@) % يظل بنو النعامة حابسيهم % إذا وردوا ، ووردهم ذميم % PageV01P288 البحر : طويل 1(@)(@@) % شعبت شؤون الرأس بعد انفراجه % بصهباء صرف من طلية رستم % % PageV01P289 البحر : طويل 1(@)(@@) % وإنا لحباسون عكافة بنا % % لننظر ما يقضي إليها الأراقم % 2(@)(@@) % إذا ما قسمنا سبي قوم وما لهم % دعانا لقوم آخرين مزاحم % PageV01P290 البحر : كامل تام 1(@)(@@) % زعموا ولم أك شاهدا لمقامة % أن الخطيب لدى الإمام الهيثم % 2(@)(@@) % صدرت وفود الناس عن كلماته % % بالشام إذا خرج الإمام الأعظم % PageV01P291 البحر : طويل 1(@)(@@) % أيوعدني بكر وينفض عرفه % فقلت لبكر : إنما أنت حالم % 2(@)(@@) % ستمنعني منك رماح ثرية % وغلصمة تزور عنها الغلاصم % 3(@)(@@) % فما لبني شيبان عندي ظلامة % ولا بدم تسعى علي الحناتم % 4(@)(@@) % غضاب كأني في بياض أكفهم % ألا ربما لم تستطعني اللهازم % 5(@)(@@) % ونبيت تيم اللات تنذر مهجتي % % وفيها هلال طالع ومزاحم % 6(@)(@@) % لنا حمة من 
ms79	 يختلس بعض سمها % % من الناس يعفر كفه وهو نادم % 7(@)(@@) % ويعترف البكري ما دامت العصا % % لذي العز والبكري ما اسطاع ظالم % 8(@)(@@) % تدارك مفروقا بنو عم أمه % وقد حجنته والهجان الأراقم % PageV01P292 البحر : طويل 1(@)(@@) % أفي كل عام لا يزال لعامر % على الفزر نهب من أروش مزنم % 2(@)(@@) % لعمرك ما أدري وإني لسائل % أمرة أم مستأخر الليل أعظم % 3(@)(@@) % وما كانت الجباء فينا مربة % ولا ثمد الغورين ذاك المقدم % PageV01P293 البحر : طويل 1(@)(@@) % كأن أبا مروان ينزع ضرسه % إذا القوم قالوا : متعونا بدرهم % 2(@)(@@) % إذا الرقة البيضاء لاحت بروجها % % فدى كل عطار بها أم مريم % PageV01P294 البحر : وافر تام 1(@)(@@) % ومترعة كأن الورد فيها % % كواكب ليلة ، فقدت غماما % % 2(@)(@@) % سقيت بها عمارة أو سقاني % % إذا ما الجبس عن ضيفيه ناما % % PageV01P295 البحر : وافر تام 1(@)(@@) % إذا لان الصفا عن طول نحت % فإن صفاة تغلب لا تلين % 2(@)(@@) % إذا قذفت ، نبا الجلمود عنها % % وأوطت صخرة فيها زبون % 3(@)(@@) % فقلبك رامها الجبار فينا % % فكان لنا ، وللجبار دين % PageV01P296 البحر : وافر تام 1(@)(@@) % ومسترق النخامة مستكين % لوقع الكأس يومي بالبنان % 2(@)(@@) % حلقت له بما أهدت قريش % وكل مشعشع في الجوف آن % % 3(@)(@@) % لتصطحبن ولو أعرضت عنها % % ولو أني بعقوته سقاني % % 4(@)(@@) % فطافت طوفتين فكاد يحيا % % ودبت في المفاصل واللسان % 5(@)(@@) % فلم أعرف أخي حتى اصطبحنا % % ثلاثا فانبرى حذم العنان % 6(@)(@@) % فلان الصوت فانبسطت يداه % وكان كأنه في الغل عان % 7(@)(@@) % وراح ثيابه الأولى سواها % % بلا بيع أميم ولا مهان % PageV01P297 البحر : طويل 1(@)(@@) % وبالجزع من خفان صاحبت عصبة % مصححة الأجساد ، مرضى عيونها % % 2(@)(@@) % فإن يك قد بان الصبى أم مالك % فقد تعتريني الهيف ميل قرونها % % 3(@)(@@) % وليل كساج الطيلسان ، لهوته % بمرنجة هيف ، خماص بطونها % % 4(@)(@@) % إذا احتثها الركبان ، كان ألذها % % إلى ذي الصبى ، ذو ضغنها وحزونها % % 5(@)(@@) % إذا معك الدين الغريم ، فإنها % % على كل أحيان تحل ديونها % % PageV01P298 البحر : كامل تام 1(@)(@@) % أجرير إنك والذي تسمو له % كأسيفة فخرت بحدج حصان % 2(@)(@@) % حملت لربتها ، فلما عوليت % نسلت تعارضها مع الأضغان 
ms80	 % % 3(@)(@@) % أتعد مأثرة لغيرك ذكرها % % وسناؤها في غابر الأزمان % 4(@)(@@) % في دارم تاج الملوك وصهرها % % أيام يربوع مع الرعيان % 5(@)(@@) % متلفف في بردة حبقية % بفناء بيت مذلة وهوان % 6(@)(@@) % يغذو بنيه بثلة مذمومة % ويكون أكبر همه ربقان % % 7(@)(@@) % سبقوا أباك بكل مجمع تلعة % بالمجد ، عند مواقف الركبان % 8(@)(@@) % فإذا رأيت مجاشعا قد أقبلت % رجحوا ، وشال أبوك في الميزان % 9(@)(@@) % فإذا كليب لا توازن دارما % عفواته وسهولة الأعطان % 10(@)(@@) % فاخسأ إليك كليب ، إن مجاشعا % وأبا الفوارس نهشلا أخوان % PageV01P299 البحر : متقارب تام 1(@)(@@) % ما زال ألسنة ناطقينا % % وأحداث ما يحدث المجرمونا % % 2(@)(@@) % ونقض العهود بإثر العهود % تؤز الكتائب حتى حمينا % % 3(@)(@@) % فكاين ترى من ذكور السيوف % تطير قمحدوة والجبينا % % PageV01P300 البحر : وافر تام 1(@)(@@) % لقد جارى أبو ليلى بقحم % ومنتكث على التقريب ، وان % 2(@)(@@) % إذا هبط الخبار ، كبا لفيه % وخر على الجحافل والجران % 3(@)(@@) % يبصبص ، والقنا زور إليه % وقد أعذرن في وضح العجان % 4(@)(@@) % يخوفني أبو ليلى ، ودوني % % بنو الغمرات والحرب العوان % 5(@)(@@) % ستقذف وائل حولي ، جميعا % وتطعن إن أشيت إلى الطعان % 6(@)(@@) % وما أنا ، إن أردت هجاء قيس % بمخذول ، ولا خاشي الجنان % 7(@)(@@) % أهم بشتمهم ، ويكف حلمي % % عوارم ، يعتلجن على لساني % % 8(@)(@@) % خنافس أدلجت لمبيت سوء % ورثن فراش زانية وزان % % 9(@)(@@) % وما أم ، ربوت على يديها % % بطاهرة الثياب ولا حصان % 10(@)(@@) % كأن عجانها لحيا جزور % تحسر عنهما وضر الجران % % PageV01P301 11(@)(@@) % ولو أني بسطت عليك شتمي % % وجدك ما مسحتك بالدهان % 12(@)(@@) % فلا تنزل بجعدي ، إذا ما % % تردى المكرعات من الدخان % 13(@)(@@) % فإنك غير واجده حشودأ % ولا مستنكرا دار الهوان % 14(@)(@@) % يبيت على فراسن معجلات % خبيثات المغ بة والعثان % PageV01P302 البحر : بسيط تام 1(@)(@@) % خبر بني الصلت عنا ، إن لقتيهم % أن الحديد ، إذا أمسيت غناني % % 2(@)(@@) % فدونكم مالكا لا يفلتنكم % فمالك في حياض الموت دلاني % % PageV01P303 البحر : طويل 1(@)(@@) % دعاني أمرؤ أحمى على الناس عرضه % % فقلت له : لبيك ، لما دعانيا % % 2(@)(@@) % هجته يرابيع العراق ، ولم تجد % له في قديم الدهر ، إلا تواليا % % 3(@)(@@) % فإن تسع يابن 