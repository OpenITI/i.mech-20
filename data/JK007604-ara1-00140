ms121	 1(@)(@@) % أنا أبصرت صاح الشم % س تمشي ليلة الجمعه % 2(@)(@@) % فماج الناس في الناس ، % وظنوا أنها الرجعه % 3(@)(@@) % إلى الله ، وقالوا الحش % % ر ، لما عاينوا ، بدعه % 4(@)(@@) % إذ الشمس ترى ليلا ، % وحين الناس في خشعه % 5(@)(@@) % وماجوا أن رأوا شمسا % بليل ، يالها فزعه % 6(@)(@@) % فقلت : الشمس لا تط % لع ليلا مطلع الهقعه % 7(@)(@@) % ولكن الفتى أحم % % د يجلو الليل ، بالطلعه % 8(@)(@@) % على جبهته الشعرى ، % وفي وجنته الهنعه % PageV01P576 البحر : مجزوء الكامل 1(@)(@@) % ما ارتد طرف محمد % إلا أتى ضر ا ونفعا % % 2(@)(@@) % قاد الندى بعنانه ، % وتسربل المعروف درعا % % 3(@)(@@) % لما اعتمدت على ندا % % ك أريتني وترا وشفعا % % 4(@)(@@) % فعصا نداه براحتي ، % أعلو بها الإفلاس قرعا % % 5(@)(@@) % وعلي سور مانع % من جوره إن خفت كسعا % % 6(@)(@@) % فلو ان دهرا رابني ، % لصفعته بالكف صفعا % % PageV01P577 البحر : طويل 1(@)(@@) % وأسمع منك النفس ما ليس تسمع % من القول لي : أبشر ؛ فترضى وتقنع % 2(@)(@@) % خذي بقبول ما منحت من المنى ، % فما لي إلا بالمنى عنك مدفع % 3(@)(@@) % إذا ما تغشتني من الموت سكرة ، % تجلى المنى من دونها ؛ فتقشع % 4(@)(@@) % فمن ذا الذي لي ؛ مثل ما تصنع المنى % % إذا ما أظلتني المنية يصنع % 5(@)(@@) % سأثني بهذا ما حييت على المنى ، % وإن أغفل العشاق ذاك ؛ وضيعوا % % PageV01P578 البحر : منسرح 1(@)(@@) % إن اسم حسن لوجهها صفة ، % ولا أرى ذا في غيرها اجتمعا % % 2(@)(@@) % فهي إذا سميت ، فقد وصفت ، % فيجمع اللفظ معنيين معا % % 3(@)(@@) % إن بشط الفرات لي سكنا ، % يبلغ غيظي بكل ما وسعا % % 4(@)(@@) % يلصق أنفي بكل مرغمة ، % ولا يراني عليه ممتنعا % % PageV01P579 البحر : طويل 1(@)(@@) % سصم عن العذال ، وهو سميع ، % فيذهب بطلا نصحهم ، ويضيع % 2(@)(@@) % طويلة خوط المتن ، عند قيامها ، % ولي بالطويلات المتون ولوع % 3(@)(@@) % أصم ، إذا نوديت باسمي ، وإنني ، % إذا قيل لي : يا عبدها ، لسميع % PageV01P580 البحر : رجز تام 1(@)(@@) % إذا مضى من رمضان النصف % تشوق القصف لنا والعزف % 2(@)(@@) % وأصلح الناي ، ورم الدف % واختلفت بين الزناة الصحف % 3(@)(@@) % لوعد يوم ليس فيه خلق ، % حتى إذا ما اجتمعوا واصطفوا % % 4(@)(@@) % تكشفوا 
ms122	 ، واعتنقوا ، والتفوا ، % فبعضهم أرض وبعض سقف ! % PageV01P581 البحر : وافر تام 1(@)(@@) % فديتك ليس لي عنك انصراف ، % ولا لي في الهوى منك انتصاف % 2(@)(@@) % وصالك عندي الشهد المصفى ، % وهجرك عندي السم الزعاف % 3(@)(@@) % وقائلة متى عنها تسلى ، % فقلت لها إذا شاب الغداف % 4(@)(@@) % أطوف بقصركم ، في كل يوم ، % كأن لقصركم خلق الطواف % 5(@)(@@) % ولولا حبكم للزمت بيتي ، % ففي بيتي لي الراح السلاف % 6(@)(@@) % أنا العبد المقر بطول رق ، % وليس عليك من عبد خلاف % PageV01P582 البحر : منسرح 1(@)(@@) % لست لدار عفت بوصاف ، % ولا على ربعها بوقاف % 2(@)(@@) % ولا أسلي الهموم في غسق اللي % % ل بحاد في البيد عساف % 3(@)(@@) % لكن بوجه الحبيب أشربها ، % بين ندامى ، وبين ألاف % 4(@)(@@) % من قهوة كالعقيق صافية ، % عادية العمر ، ذات أسلاف % 5(@)(@@) % كأن في لحظ عين مازجها ، % إذا اجتلاها ، بريق أسياف % 6(@)(@@) % كأنها ، والمزاج يقرعها ، % في قعر كأس ، نجيع أجواف % 7(@)(@@) % تفتر في الكأس ، حين تمزجها % % بماء مزن ، عن در أصداف % 8(@)(@@) % منتظمات ، وغير منتظم ، % تغور فيها ، وبعضها طاف % 9(@)(@@) % فذاك أشهى من الوقوف على % % ربع لأسماء آيه عاف % PageV01P583 البحر : وافر تام 1(@)(@@) % رأيت هواي سيرته الوجيف ، % وتحزبني ، إذا اعترضت ، ثقيف % 2(@)(@@) % فإن آتي ، وذلك بعد كد ، % فدار محمد ، ثم الوقوف % PageV01P584 البحر : مجزوء الخفيف 1(@)(@@) % اسقني ، واسق يوسفا ، % مزة الطعم ، قرقفا % % 2(@)(@@) % دع من العيش كل رن % ق ، وخذ منه ما صفا % % 3(@)(@@) % اسقنيها ملأ وفا ، % لا أريد المنصفا % % 4(@)(@@) % وضع الزق جانبا ، % ومع الزق مصحفا % % 5(@)(@@) % واحس من ذا ثلاثة ، % واتل من ذاك أحرفا % % 6(@)(@@) % خير هذا بشر ذا ، % فإذا الله قد عفا % % 7(@)(@@) % فلقد فاز من محا % % ذا بذ عنه ، واكتفى % % PageV01P585 البحر : مجزوء الرجز 1(@)(@@) % نبه نديمي يوسفا % % يسقيك خمرا قرقفا % % 2(@)(@@) % غضا تثنى ، أهيفا ، % أنحل جسمي دنفا % % 3(@)(@@) % كغرة البدر ، إذا ال % % شهر بدا منصفا % % 4(@)(@@) % حتى إذا دار الكرى % % في مقلتيه وغفا % % 5(@)(@@) % قبلته عشرا على % % عشر ، وعشرا سلفا ! % PageV01P586 البحر : سريع 1(@)(@@) % سقيا لبغداد ، وأيامها ؛ % إذ دهرنا نطويه بالقصف % 2(@)(@@) % مع فتية مثل نجوم الدجى 
ms123	 ، % لم يطبعوا يوما على خسف % 3(@)(@@) % تيجانهم حلم إذا ما سقوا % % قد فصصت بالجود والظرف % 4(@)(@@) % ومد من أبصارهم أشمس % تقصر عنها غاية الوصف % 5(@)(@@) % يسقيهم ذو وفرة ، أحور ، % يسيل صدغا ، فاتر الطرف % 6(@)(@@) % يكسر الراء ، وتكسيرها % % يدعو إلى السقم مع الحتف % 7(@)(@@) % إن رام إعجالا أبى ردفه ، % أو رام عطفا جر للعطف % 8(@)(@@) % يسقيهم حمراء ، ياقوتة ، % تسرج في الكأس وفي الكف % 9(@)(@@) % يسقيهم ممزوجة تارة ، % فباح من سكر بما يخفي % % 10(@)(@@) % ثم تغنى طربا عندهم ، % وهو من القوم على خوف : % PageV01P587 11(@)(@@) % شعزما أولع العينين بالوكف ، % إذا تنحت غرة الأنف % PageV01P588 البحر : بسيط تام 1(@)(@@) % ياقلب ويحك جد منك ذا الكلف ، % ومن كلفت به جاف كما تصف % 2(@)(@@) % وكان في الحق أن يهواك مجتهدا ، % كذاك خبر منا الغابر السلف % 3(@)(@@) % قل للمليح : أما تروي الحديث بما % % خالفت فيه وقد جاءت به الصحف % 4(@)(@@) % إن القلوب لأجناد مجندة ، % لله في الأرض بالأهواء تختلف % 5(@)(@@) % فما تعارف منها فهو مؤتلف ، % وما تناكر منها فهو مختلف % PageV01P589 البحر : سريع 1(@)(@@) % خبر طرفي بالذي أخفي ، % ويحك ! ما افشاك من طرف % 2(@)(@@) % لا يكتم الطرف هوى عاشق ، % لكنما يفشيه بالذرف % 3(@)(@@) % حتى لعيني بك فيما أرى ، % أعلم من نفسي بما أخفي % % 4(@)(@@) % وذاك أني ، والقضا واقع ، % بكفهما نفسي ، جنت حتفي % % PageV01P590 البحر : منسرح 1(@)(@@) % يا رب ساق ، كأنه شبه ال % بدر تجلى الظلام عن سدفه % 2(@)(@@) % قلت له للذي أردت به ، % وقد ينال اللطيف من لطفه : % 3(@)(@@) % إلي فاسمع تسمع إلى عجب ، % من مستجد الحديث مطرفه % 4(@)(@@) % فانقاد حتى رأيت أن فمي % % أدنى لأذنيه من عرى شنفه % 5(@)(@@) % فقبلت صفحة ، وسالفة % من روض غض الشباب مؤتنفه % 6(@)(@@) % وما درى الشرب أو دروا فلهوا % % عن قرح القلب قد لج في دنفه % PageV01P591 البحر : خفيف تام 1(@)(@@) % عاد لي بالسدير شارد قصف ، % وسرور مع الندامى وعزف % 2(@)(@@) % وعيون الظباء ترنو إلينا ، % منعمات بكل بر ولطف % 3(@)(@@) % فطردنا الصدود أقبح طرد ، % وعطفنا الوصال أحسن عطف % 4(@)(@@) % ورخيم الدلال كاد من الرق % ة 
ms124	 يدمي أديمه وقع طرف % 5(@)(@@) % حل منه الصليب في موضع الجي % % د ؛ فقد خصه على كل إلف % 6(@)(@@) % فأدرنا رحى السرور ثلاثا ، % ووصلنا الخصور كفا بكف % PageV01P592 البحر : خفيف تام 1(@)(@@) % من يكن يعشق النساء فإني من يكن يعشق النساء فإني % % مولع القلب بالغلام الظريف % 2(@)(@@) % حين أوفى على ثلاث وعشر ، % لم يطل عهد أذنه بالشنوف % 3(@)(@@) % فبه غنة الصبا ، تعتليها % % بحة الاحتلام للتشريف % 4(@)(@@) % حين رامى النساء منه بعين ، % وطوى أختها من التخويف % PageV01P593 البحر : بسيط تام 1(@)(@@) % معقرب الصدغ ، ملبوس عوارضه % % جلباب خز ، عليه النور مقطوف % 2(@)(@@) % تحيا النفوس به في سطح جوهرة ، % فما عليك إذا استدعاك تكليف % 3(@)(@@) % تضمن الروح جسم النور ؛ فامتزجا % % في عارض فيه أرواح وتأليف % 4(@)(@@) % فليس يخطر في الأوهام أن له % عدلا ، وليس له في الحسن موصوف % PageV01P594 البحر : سريع 1(@)(@@) % يا نظرة ساقت إلى ناظر % أسباب ما تدعو إلى حتفه % 2(@)(@@) % من حب ظبي حسن دله ، % يقصر الواصف عن وصفه % 3(@)(@@) % في البدر من صفحته لمحة ، % ولمحة في الظبي من طرفه % 4(@)(@@) % إذا مشى جاذبه ردفه ، % كأنما يمشي إلى خلفه % 5(@)(@@) % مواقع الأنفاس في ثغره ، % وفي ثناياه ، وفي كفه % 6(@)(@@) % ابن ثمان بعدها أربع ، % طفل وكهل السن في ظرفه % PageV01P595 البحر : مجزوء الرمل 1(@)(@@) % اسقني الراح على وج % ه رأيناه نظيفا % % 2(@)(@@) % من وصيف ، بأبي ذا % % ك وبالأم ، وصيفا % % 3(@)(@@) % من مها الديوان قد قل % د شذرا وشنوفا % % 4(@)(@@) % لابسا فوق القميص ال % % جون قبطيا خفيفا % % 5(@)(@@) % تضحك الأقلام منه ، % كلما خط الصحيفا % % 6(@)(@@) % أسرع الناس ملالا ، % إن تسل شيئا طفيفا % % 7(@)(@@) % غير أني قد أرى قل % % بي به بر ا رؤوفا % % 8(@)(@@) % مسعر في القلب حب % بين ، تليدا وطريفا % % 9(@)(@@) % ولقد قلت لعمرو ، % بعد كتماني خريفا : % 10(@)(@@) % ما ترى الظبي الذي أح % ببته حبا عنيفا % % PageV01P596 11(@)(@@) % ما ترى إخفاق قلبي ، % في هواه ، والوجيفا % % 12(@)(@@) % فلقد طال تمادي % % ه ، وقد خفت الحتوفا % % 13(@)(@@) % قال : ما يخفى عليه % ذاك ، إن كان ظريفا % % PageV01P597 البحر : كامل تام 1(@)(@@) % حلت 
ms125	 سعاد ، وأهلها سرفا % % قوما عدى ، ومحلة قذفا % % 2(@)(@@) % واحتل أهلك سيف كاظمة ، % فأشت ذاك الهجر ، واختلفا % % 5(@)(@@) % فأزجر فؤادك ، أو سنزجره % قسما لينتهين ، أو حلفا % % 7(@)(@@) % وتنوفة تمشي الرياح بها % % حسرى ، ويشرب ماؤها نطفا % % 8(@)(@@) % كلفتها أجدا تخال بها % % مرحا من الخيلاء ، أو صلفا % % 9(@)(@@) % وهب الجديل لها مدارعه ، % و القمة العلياء والشعفا % % 10(@)(@@) % قد قلت للعباس معتذرا ، % من ضعف شكريه ، ومعترفا : % 11(@)(@@) % أنت امرؤ جللتني نعما ، % أوهت قوى شكري فقد ضعفا % % 12(@)(@@) % فإليك قبل اليوم تقدمة ، % لاقتك بالتصريح منكشفا % % 13(@)(@@) % لا تسدين إلي عارفة ، % حتى أقوم بشكر ما سلفا % % PageV01P598 البحر : مخلع البسيط 1(@)(@@) % عاتبني الشعر ذا إكاف % وقال لي : الله منك كاف % 2(@)(@@) % هجاك من قلت لا يساوي % % عود خلال من الخلاف % 3(@)(@@) % فكنت إذ لم تجبه أحرى % % أن لا به تقذر القوافي % % 4(@)(@@) % كنت كرب الحمار أعيا ، % فظل يسطو على الإكاف % % 5(@)(@@) % يارب من راسب فتهجى % % شبيهة الفقع بالفيافي % % 6(@)(@@) % أو بك أبغي أقيس نفسي % % زنبور يا واسع السلاف % 7(@)(@@) % أو أشجع ، وهو من سليم ، % فيما رووا ، رقعة الخضاف % 8(@)(@@) % يكفيك ما فيهم فدعهم ، % انفذ وقعا من الأشافي % % PageV01P599 البحر : وافر تام 1(@)(@@) % تمثل لي جهنم ، حين يبدو % % خيال الكبش من تحت السقيفه % 2(@)(@@) % اذا رفعت صحيفته إليه ، % رأى كل العجائب في الصحيفه % PageV01P600 البحر : مجزوء الرمل 1(@)(@@) % خبز إسماعيل كالوش % ي . إذا ما انشق يرفا % % 2(@)(@@) % عجبا من أثر الصن % % عة فيه كيف يخفى ؟ ! % 3(@)(@@) % إن رفاءك هذا ، % أحذق الأمة كفا % % 4(@)(@@) % وإذا قابل بالنص % ف من الجردق نصفا % % 5(@)(@@) % يلصق النصف بنصف ، % فإذا قد صار ألفا % % 6(@)(@@) % ألطف الصنعة ، حتى % % لا ترى مغرز إشفى % % 7(@)(@@) % مثلما جاء من التنو % % ر ما غادر حرفا % % 8(@)(@@) % وله في الماء أيضا % عمل أبدع ظرفا % % 9(@)(@@) % مزجه العذب بماء ال % بئر كي يزداد ضعفا % % 10(@)(@@) % فهو لا يسقيك منه ، % مثلما يشرب صرفا % % PageV01P601 البحر : طويل 1(@)(@@) % إذا انتقد الدينار شبهت كفه % لدى صفرة الدينار في وضح الكف % 2(@)(@@) % بنرجسة أضحت ، وقد طلها الندى 
ms126	 ، % شفيق عليها مجتنيها من القطف % PageV01P602 البحر : خفيف تام 1(@)(@@) % لبني البرمكي قصر منيف ، % وجمال ، وليس فيهم حنيف % 2(@)(@@) % دارهم مسجد يؤذن فيها ، % لاتقاء ، وليس فيها كنيف % 3(@)(@@) % فإذا أذنوا لوقت صلاة ، % كرروا : لا إله إلا الرغيف % PageV01P603 البحر : خفيف تام 1(@)(@@) % من رأى مثل ما أغالي من البي % ع إذا ما اتجرت عند لقيف % 2(@)(@@) % نلت يحيى وأمه وأباه % وأخاه وأخته برغيف % 3(@)(@@) % عشت دهرا يدال مني لقوم ، % فأدال الإله لي من ثقيف % PageV01P604 البحر : سريع 1(@)(@@) % من كان ، لو لم أهجه ، غالبا من كان ، لو لم أهجه ، غالبا % قام به شعري مقام الشرف % 2(@)(@@) % يقول : قد أسرفت في شتمنا ، % وإنما صال بذاك السرف % 3(@)(@@) % غالب ! لا تسع لنيل العلى ، % بلغت مجدا بهجائي فقف % 4(@)(@@) % وكان مجهولا ، ولكنني % % نوهت بالمجهول حتى عرف % 5(@)(@@) % ولست أحتاج إلى حمده % في ذا ، ولكن في أخينا صلف ! % PageV01P605 البحر : منسرح 1(@)(@@) % لا تئل العصم في الهضاب ، ولا % % شغواء تغذو فرخين في لجف % 2(@)(@@) % يكنها الجو في النهار ، ويؤ % % ويها سواد الدجى : إلى شرف % 3(@)(@@) % تحءنو بجؤشوشها على ضرم ، % كقعدة المنحني من الخرف % 4(@)(@@) % ولا شبوب باتت تؤرقه ال % % نثرة منها بوابل قصف % 5(@)(@@) % دان على أرضه ، وأسند في % % بهو أمين الإياد ذي هدف % 6(@)(@@) % ديدنه ذاك طول ليلته ، % حتى إذا انجاب حاجب السدف % 7(@)(@@) % غدا كوقف الهلوك ينهفت ال % قطقط عن منبتيه والكتف % 8(@)(@@) % كأن شذرا وهت معاقده ، % بين صلاه ، فملعب الشنف % 9(@)(@@) % وأخدري ، صلب النواهق ، صل % صال ، أمين الفصوص والوظف % 10(@)(@@) % منفرد في الفلاة توسعه % ريا ، وما يختليه من علف % PageV01P606 11(@)(@@) % ما ترك الموت بعده شبحا ، % باد بتل القلال والشعف % 12(@)(@@) % لما رأيت المنون آخذة % كل شديد ، وكل ذي ضعف % 13(@)(@@) % بت أعزي الفؤاد عن خلف ، % وبات دمعي إن لا يفض يكف % 14(@)(@@) % أنسى الرزايا ميت فجعت به ، % أمسى رهين التراب في جدف % 15(@)(@@) % كان يسني برفقة علقا ، % في غيتر عي منه ، ولا عنف % 16(@)(@@) % يجوب عنك التي عشيت بها ، % من قبل حتى يشفيك في لطف 
ms127	 % 17(@)(@@) % لايهم الحاء في القراءة بال % حاء ، ولا لامها مع الألف % 18(@)(@@) % ولا يعمي معنى الكلام ، ولا % % يكون إنشاده عن الصحف % 19(@)(@@) % وكان ممن مضى لنا خلفا ، % فليس منه إذ بان من خلف % PageV01P607 البحر : منسرح 1(@)(@@) % ياليلة طاب لي بها الأرق ، % حتى بدا من صباحها الفلق % 2(@)(@@) % نسقى سلافا من بنت دسكرة ، % ماشابها في دنانها الرنق % 3(@)(@@) % اختارها في القطاف سائمها ، % حمرا وسودا ، كأنها الحدق % 4(@)(@@) % حتى إذا في الحياض صيرها ، % خالطها الزعفران والعلق % 5(@)(@@) % حصنها في الحياض ؛ فاحتجبت % ما راعها رهبة ، ولا فرق % 6(@)(@@) % خمسين عاما ، حتى إذا هرمت ، % واخضر من نبت نبتها الورق % 7(@)(@@) % أتوا بها في الحباب يخفرها % % مشي هوينى ، ما إن به نزق % 8(@)(@@) % فبادروا لافتضاض عذرتها ، % بناقد في شباته زلق % 9(@)(@@) % فسال منها مثل الرعاف دم ، % يشفى به من سقامه الصعق % 10(@)(@@) % نازعها سادة غطارفة ، % كأنهم من شقيقة شققوا % % PageV01P608 11(@)(@@) % ييقون من قهوة معتقة ، % لها دبيب في المخ يستبق % 12(@)(@@) % أعطوا بها ربها حكومته ، % بيضا كمثل السيوف تبترق % 13(@)(@@) % جاء بها كالخلوق في قدح ، % تزهر في جوفه ؛ فتأتلق % 14(@)(@@) % كأن إبريقنا إذا صفقت % في الكأس شيخ مزمزم شرق % 15(@)(@@) % كأنها والمزاج يقرعها % % شهاب نار في الجو يحترق % 16(@)(@@) % كأنما حف من قراقرها % % بطوقها جلد حية يقق % 17(@)(@@) % في مجلس ليس فيه فاحشة ، % إلا حديث ، ومنطق أنق % PageV01P609 البحر : منسرح 1(@)(@@) % اشرب وسق الحبيب ياساقي ، % وسقني فضل كأسه الباقي % % 2(@)(@@) % وسقه فضل ما أخلفه % في الكأس ، عمدا بغير إشفاق % 3(@)(@@) % أشرب من فضله ، ويشرب من % % فضلي كذا فعل كل مشتاق % 4(@)(@@) % جئت رسولا ؛ فصرت ساقينا ، % حييت من مرسل ، ومن ساق % PageV01P610 البحر : بسيط تام 1(@)(@@) % وقهوة كجني الورد ، وخالصة ، % قد أذهب العتق فيها الذام والرنقا % % 2(@)(@@) % كأن إبريقنا ظبي على شرف ، % قد مد منه لخوف القانص العنقا % % 3(@)(@@) % يسقيكها أحور العينين ، ذو صدع ، % مشمر ، بمزاج الراح قد حذقا % % 4(@)(@@) % ما البدر أحسن منه حين تنظره ، % سبحان ربي ، لقد سواه إذ خلقا % % 5(@)(@@) % لا شيء أحسن منه حين تبصره 
ms128	 % كأنه من جنان الخلد قد سرقا % % 6(@)(@@) % مازال يمزجها طورا ، ويشربها % % طورا إلى أن رأيت السكر قد سبقا % % 7(@)(@@) % ثم تغنى ، وقد دارت بهامته ، % فما يكاد يبين القول ، إذ نطقا % % 8(@)(@@) % ' إن الخليط أجد البين فافترقا ، % وعلق القلب من أسماء ما علقا % % PageV01P611 البحر : بسيط تام 1(@)(@@) % لا الصولجان ، ولا الميدان يعجبني ، % ولا أحن إلى صوت البواشيق % 2(@)(@@) % لكنما العيش في اللذات ، متكئا ، % وفي السماع ، وفي مج الأباريق % PageV01P612 البحر : سريع 1(@)(@@) % تزوج الخمر من الماء ، في % % طاسات تبر ، خمرها يفهق % 2(@)(@@) % منطقات بتصاوير ، لا % % تسمع للداعي ، ولا تنطق % 3(@)(@@) % على تماثيل بني بابك ، % محتفر ما بينهم خندق % 4(@)(@@) % كأنهم ، والخمر من فوقهم ، % كتائب في لجة تغرق % 5(@)(@@) % فالنعت ذا لا نعت دار خلت % بهيم في أطلالها أحمق % 6(@)(@@) % وشادن ، حين لي زورة % غرته ، والعمل الأرفق % 7(@)(@@) % أدرته شهرا على موعد ، % يكذبني فيه ، ولا يصدق % 8(@)(@@) % حتى إذا أفنيت علاته ، % بالصبر ، مني قال لي : أفرق % 9(@)(@@) % فقلت : لا تفرق يا سيدي ، % مثلي بأمثالك لا يخرق % PageV01P613 البحر : طويل 1(@)(@@) % أدرها علينا قبل أن نتفرقا ، % وهات اسقني منها سلافا مروقا % % 2(@)(@@) % فقد هم وجه الصبح أن يضتك الدجى % % وهم قميص الليل أن يتمزقا % % PageV01P614 البحر : طويل 1(@)(@@) % لقد سرني أن الهلال غدية ، % بدا وهو ممشوق الخيال دقيق % 2(@)(@@) % أضرت به الأيام حتى كأنه % عنان لواه باليدين رفيق % 3(@)(@@) % وقفت أعزيه ، وقد دق عظمه ، % وقد حان من شمس النهار شروق % 4(@)(@@) % ليهن ولاة اللهو أنك هالك ، % فأنت بما يجري عليك حقيق % 5(@)(@@) % وإني بشهر الصوم إذ بان شامت ، % وإنك يا شوال لي لصديق % 6(@)(@@) % فقد عاودت نفسي الصبابة والهوى % % وحان صبوح باكر وغبوق % PageV01P615 البحر : مجزوء الرمل 1(@)(@@) % قل لذي الوجه الرقيق % ولذي الحسن الدقيق % 2(@)(@@) % ولمن يرنو بعيني % رشإ أحوى وموق % 3(@)(@@) % ولمن يدعو : إليه ال % حسن مرارا الطريق % 4(@)(@@) % و لمن يعنق في المش % ية كالطرف العتيق : % 5(@)(@@) % لم تغضبت على عب % دك ذي الطوع الشفيق % 6(@)(@@) % أيها العاذل دع لو % مي في شرب الرحيق 
ms129	 % 7(@)(@@) % خندريس ، عطر النك % هة كالمسك السحيق % 8(@)(@@) % إنما طابت لذي فت % ك تردى بفسوق % 9(@)(@@) % جاهر الناس بما يأ % % تيه في ضنك وضيق % 10(@)(@@) % وبدا في الناس مشهو % % را كذي الرأس الحليق % PageV01P616 البحر : كامل تام 1(@)(@@) % وملحة في العذل ذات نصيحة % ترجو إنابة ذي مجون مارق % 2(@)(@@) % بكرت تبصرني الرشاد ، وشيمتي % % غير الرشاد ، ومذهبي وخلائقي % % 3(@)(@@) % لما ألحت في العتاب زجرتها % % فتأخرت عني بقلب خافق % 4(@)(@@) % كم رضت قلي عاعلمي وزجرته ، % فرأى اتباع الرشد غير موافق % 5(@)(@@) % ومدامة مثل الخلوق ، عتيقة ، % حجبت زمانا في كنائس دابق % 6(@)(@@) % تختال ألوانا ، إذا ما صفقت ، % في الكأس تخرس من لسان الناطق % 7(@)(@@) % ذهبية تختال في جنباتها % % كالدر ألفه نظام الراتق % 8(@)(@@) % باكرتها من كف أغيد شادن ، % حسن التنغم ، فوق سؤل العاشق % 9(@)(@@) % متعقرب الصدغين ، في لحظاته % فتن لها مقرونة لبوائق % 10(@)(@@) % متخرسن ، دين النصارى دينه ، % ذي قرطق لم يتصل ببنائق % PageV01P617 11(@)(@@) % لبق ، بديع الحسن ، لو كلمته ، % لنبذت دينك كله من حالق % 12(@)(@@) % والله ، لولا أنني متخوف % أن أبتلى بإمام جور فاسق % 13(@)(@@) % لتبعته في دينه ، ودخلته % % ببصيرة فيه دخول الوامق % 14(@)(@@) % إني لأعلم أن ربي لم يكن % ليخصه إلا بدين صادق ! % PageV01P618 البحر : طويل 1(@)(@@) % لقد صبحت بالخير عين تصبحت % بوجهك يا معشوق في كل شارق % 2(@)(@@) % مقرطقة لم يحنها سحب ذيلها ، % ولا نازعتها الريح فضل البنائق % 3(@)(@@) % تشارك في الصنع النساء ، وسلمت % لهن صنوف الحلي ، غير المناطق % 4(@)(@@) % ومطمومة لم تتصل بذؤابة ، % ولم تعتقد بالتاج فوق المفارق % 5(@)(@@) % كأن مخط الصدغ ، فوق خدودها ، % بقية أنقاس بإصبع لائق % 6(@)(@@) % ندته بماء المسك ، حتى جرى لها % % إلى مستقر بين أذن وعاتق % 7(@)(@@) % غلام ؛ وإلا فالغلام شبيهها ، % وريحان دنيا ، لذة للمعانق % 8(@)(@@) % تجمع فيها الشكل والزي كله ، % فليس يوفي وصفها قول ناطق % PageV01P619 البحر : بسيط تام 1(@)(@@) % لما رأيت محل الشمس في الأفق ، % وضوؤها شامل للدور والطرق % 2(@)(@@) % صيرتها للتي أحببتها مثلا ، % إذ لا ينالها شيء من الحدق % 3(@)(@@) % فلو رآها أنو شروان صورها ، % فيما يحوك 
ms130	 من الديباج والسرق % 4(@)(@@) % وقال لابنيه ضنا ، عند بيعكما ، % بها قليلا لتزداد من الورق % PageV01P620 البحر : بسيط تام 1(@)(@@) % نابذت من باصطباري عنك يأمرني ، % لأن مثلك روحي عنه قد ضاقا % % 2(@)(@@) % ما يرجع الطرف عنها حين أبصرها % % حتى يعود إليها الطرف مشتاقا % % PageV01P621 البحر : طويل 1(@)(@@) % ومجلس خمار ، إلى جنب حانة % بقطربل بين الجنان الحدائق % 2(@)(@@) % تجاه ميادين ، على جنباتها % % رياض غدت محفوفة بالشقائق % 3(@)(@@) % فقمنا بها في فتية خضعت لهم % رقاب صناديد الكماة البطارق % % 4(@)(@@) % بمشمولة كالشمس ، يغشاك نورها % % إذا ما تبدت من نواحي المشارق % 5(@)(@@) % لهاتاح مرجان ، وإكليل لؤلؤ ، % وترنيم نشوان ، وصفرة عاشق % 6(@)(@@) % وتسحب أذيالا لها بكؤوسها ، % تحار لها الأبصار من كل رامق % 7(@)(@@) % يدور بها ظبي غرير ، متوج % بتاج من الريحان ، ملك القراطق % 8(@)(@@) % فليس كمثل الغصن في ثقل ردفه ، % إذا ما مشى في مستقسم المناطق % 9(@)(@@) % له عقربا صدغ ، على ورد خده ، % كأنهما نونان من كف ماشق % 10(@)(@@) % فلما جرت فيه ، تغنى ، وقال لي % % بسكر : ألا هات اسقنا بالدوارق ! % PageV01P622 البحر : بسيط تام 1(@)(@@) % ومستطيل على الصهباء باكرها % % بفتية باصطباح الراح حذاق % 2(@)(@@) % فكل كف رآها ظنها قدحا ، % وكل شخص رآه ظنه الساقي % % PageV01P623 البحر : مجزوء الوافر 1(@)(@@) % سقاك الله والأفق ال % ذي يممته أفقا % % 2(@)(@@) % لئن أشعرتني حبا ، % لقد أشعرتني فرقا % % 3(@)(@@) % فما لي عندكم سمجا ، % وعند سواكم لبقا % % 4(@)(@@) % كأنك خير معشوق % يراني شر من عشقا % % 5(@)(@@) % سلبت الظبي مقلته % ولم تترك له العنقا % % 6(@)(@@) % وقالوا : من عشقت ؟ فقل % ت : خير وشر من عشقا % % 7(@)(@@) % فخيرهم معا خلقا ، % وشرهم معا خلقا % % 8(@)(@@) % تغمس في العبير قمي % % صها حتى شكا الغرقا % % 9(@)(@@) % وسالت من عقيصهتها ، % سلاسل كسرت حلقا % % 10(@)(@@) % على بشر كأن الد % ر يعلوه إذا عرقا % % PageV01P624 11(@)(@@) % فلو أبصرتها لخرر % ت عند دنوها صعقا % % PageV01P625 البحر : بسيط تام 1(@)(@@) % ركب تساقوا على الأكوار بينهم % كأس الكرى ؛ فانتشى المسقي والساقي % % 2(@)(@@) % كأن أرؤسهم والنوم واضعها % % على المناكب لم توصل بأعناق % 3(@)(@@) % خاضوا إليكم بحار الليل ، آونة ، % حتى أناخوا إليكم 
ms131	 فل أشواق % 4(@)(@@) % من كل جائلة النسعين ، ضامرة % مشتاقة حملت عبئا لمشتاق % 5(@)(@@) % والحسن منك يطوف العاشقون به ، % فأنت موسم رواد وعشاق % PageV01P626 البحر : هزج 1(@)(@@) % جنان حصلت قلبي % % فما إن فيه من باق % 2(@)(@@) % لها الثلثان من قليي ، % وثلثا ثلثه الباقي % % 3(@)(@@) % وثلثا ثلث ما يبقى ، % وثلث الثلث للساقي % % 4(@)(@@) % قتبقى أسهم ست ، % تجزا بين عشاق % PageV01P627 البحر : هزج 1(@)(@@) % ألا يا أحمد الكا % % تب يا حلوا لمن ذاقه % 2(@)(@@) % لقد أضحت إلى نفس % ك نفسي اليوم مشتاقه % 3(@)(@@) % ألما حزت حسن الد % % ل من حوراء رقراقه % 4(@)(@@) % تذيق الهجر من ليست % له بالهجر من طاقه % 5(@)(@@) % بنفسي كفك الرخ % صة في القرطاس مشاقه % PageV01P628 البحر : مجزوء الرجز 1(@)(@@) % يا عمرو من لم يختنق ، % بالبين لم يختنق % 2(@)(@@) % أي فتى في أفق ، % وروحه في أفق % 3(@)(@@) % ولم يرحه قلق ، % حتى غدا ذا قلق % 4(@)(@@) % يا عمرو ، لا لاقيت ما % % لاقيت من منطلقي % % 5(@)(@@) % ما سرت مذ جاوزت مي % % لا دار ذاك الخرق % 6(@)(@@) % إلا وداعي حبه % % يثني إليه عنقي % % PageV01P629 البحر : مجزوء الخفيف 1(@)(@@) % وجه حمدان ، فاحذروا % % ه ، كتاب الزنادقه % 2(@)(@@) % فيه أشياء يزعم الن % اس بالقلب عالقه % 3(@)(@@) % من رآه ، فنفسه % نحوه الدهر تائقه % 4(@)(@@) % كلما اعتر ضاحكا % قلت : إيماض بارقه % PageV01P630 البحر : منسرح 1(@)(@@) % علقت من شقوتي ومن نكدي % % مزنرا ، والصليب في عنقه % 2(@)(@@) % أقبل يمشي إلى كنيسته . % فكدت أقضي الحياة من فرقه % 3(@)(@@) % فقلت : من أنت بالمسيح وبال % إنجيل سطرته على ورقه % 4(@)(@@) % وبالصليب الذي تدين له ؟ % فقال : بدر السماء في أفقه % 5(@)(@@) % سألته عن محل بيعته ، % فقال : في ناره وفي حرقه % 6(@)(@@) % فالويل لي من طلاب محتبس ، % صرت كمينا له على طرقه % 7(@)(@@) % يامن رأى عاشقا أخا كلف ، % يزداد حرمانه على قلقه ! % PageV01P631 البحر : رمل تام 1(@)(@@) % لبق القد ، لذيذ المعتنق ، % يشبه البدر ، إذا البدر اتسق % 2(@)(@@) % مثقل الردف إذا ولى حكى % % موثقا في القيد يمشي في زلق % 3(@)(@@) % وإذا أقبل كادت أعين % نحوه تجرح فيه بالحدق % 4(@)(@@) % هو في عيني 
ms132	 جديد دائما ، % وسواه الدهر في عيني خلق % PageV01P632 البحر : منسرح 1(@)(@@) % كنت من الحب في ذرى نيق ، % أرود منه مراد موموق % 2(@)(@@) % مجال عيني في يانع زاهر ال % % روض ، وشربي من غير ترنيق % 3(@)(@@) % حتى نفاني عنه تخلق وا % % ش كذبة لفها بتذويق % 4(@)(@@) % جئت قفا ما نمته معتذرا ، % قد فترت منه بعد تخريق % 5(@)(@@) % يا أيها المبطلون معذرتي ، % أراكم الله وجه تصديق % 6(@)(@@) % نم بما كنت لا أبوح به ، % على لسان بالدمع منطيق % 7(@)(@@) % شوقا إلى حسن صورة ظفرت % من سلسبيل الجنان بالريق % 8(@)(@@) % وصيف كأس ، محدث ، ولها % % تيه مغن ، وظرف زنديق % 9(@)(@@) % تشوب ذلا بعزة ، فلها % % ذل محب ، وعز معشوق % 10(@)(@@) % وردفها كالكثيب ، نيط إلى % % خصر رقيق اللحاء ، ممشوق % PageV01P633 11(@)(@@) % أمشي إلى جنبها أزاحمها % % عمدا ، وما بالطريق من ضيق % 12(@)(@@) % كقول كسرى فيما تمثله % من قرص اللص ضجة السوق % 13(@)(@@) % فالحمد لله يا رفاقه ما % % كل محب أيضا بمرزوق % 14(@)(@@) % وسبسب قد علوت طامسه ، % بناقة فوقة من النوق % 15(@)(@@) % كأنما رجلها قفا يدها ، % فيا له سؤددا خلا لأبي ال % % 16(@)(@@) % كأنما أسلمت قوائمها ، % إذا مرتهن من مجانيق % 17(@)(@@) % إلى امرىء أم ماله أبدا ، % تسعى بجيب في الناس مشقوق % 18(@)(@@) % يداه كالأرض والسماء ، فما % % تنقص قطريه كف مخلوق % 19(@)(@@) % فإن يكن من سواه شيء فمن % ه ، وهو في ذاك غير مسبوق % 20(@)(@@) % فكم ترى من مجود أظهر العبا % % س منه طباع مستوق % PageV01P634 21(@)(@@) % وأنت ، إذ ليس للقضاء حصى ، % غير أكف الكماة ، والسوق % 22(@)(@@) % وكان بالمرهفات ضربهم ، % ضرب بني الحي بالمخاريق % 23(@)(@@) % أغلب ، أوفى على براثنه ، % يفتر عن كلح الشباروق % 24(@)(@@) % كأنما عينه ، إذا التهبت % بارزة الجفن ، عين مخنوق % % 25(@)(@@) % لما تراءوك قال قائلهم : % قد جاءكم قابض البطاريق % 26(@)(@@) % فانصدعوا وجهة ، كأنهم % جناة شر ينفون بالبوق % 27(@)(@@) % لما تداعى بمكة العاجز الرأ % % ي على ضلة وتفريق % 28(@)(@@) % سجية منك حزتها عن أب الفض % ل فما شبتها بترنيق % 29(@)(@@) % وكان سيف الربيع يأدب ذا ال % % سفهة منها ، وراكب الموق % 30(@)(@@) % فيا له 
ms133	 سؤددا الربيع يأدب ذا ال % % فضل لغمر النجاد ، بطريق % PageV01P635 31(@)(@@) % من سر آل النبي في رتب % قال لها الله بالتقى فوقي % % 32(@)(@@) % ثم جرى الفضل فانطوى قدما % دون مداه من غير ترهيق % 33(@)(@@) % فقيل راشا سهما تراد به الت % % غاية ، والنصل سابق الفوق % 34(@)(@@) % و إن عباس مثل والده ، % ليس إلى غاية بمسبوق % 35(@)(@@) % تأنق الله حين صاغكما ، % ففقتما الناس ، أي تأنيق % 36(@)(@@) % فصور الفضل من ندى وحجى ، % وأنت من حكمة وتوفيق % PageV01P636 البحر : مجزوء الرجز 1(@)(@@) % علقت من علقني ، % فكلنا متفق % 2(@)(@@) % إن غاب لم أظنن به ، % وهو بغيبي يثق % 3(@)(@@) % لو شئت أن يلثمني % % فاه ، وحولي حلق % 4(@)(@@) % لقام لا يمنعه % مما أشاء الحدق % PageV01P637 البحر : طويل 1(@)(@@) % ألست أمين الله ، سيفك نقمة ، % إذا ماق يوما في خلافك مائق % 2(@)(@@) % فكيف بإسماعيل يسلم مثله % عليك ، ولم يسلم عليك منافق % 3(@)(@@) % أعيذك بالرحمن من شر كاتب ، % له قلم زان ، وآخر سارق % 4(@)(@@) % أحيمر عاد إن للسيف وقعة % برأسك ، فانظر بعدها ماتوافق % 5(@)(@@) % تجهز جهاز البرمكيين ، وانتظر % بقية ليل صبحه بك لاحق % PageV01P638 البحر : طويل 1(@)(@@) % عجبت لهارون الإمام وما الذي % % يود ويرجو فيك يا خلقة السلق % 2(@)(@@) % قفا خلف وجه قد أطيل كأنه % قفا مالك يقضي الهموم على ثبق % 3(@)(@@) % أرى جعفرا يزداد بخلا ودقة ، % إذا زاده الرحمن في سعة الرزق % 4(@)(@@) % ولو جاء غير البخل من عند جعفر % لما حسبته الناس إلا من الحمق % PageV01P639 البحر : سريع 1(@)(@@) % وأنمر الجلدة صيرته % في الناس زاغا أو شقراقا % % 2(@)(@@) % إذا رآني صدني جانبا ، % كأنما جرع غساقا % % 3(@)(@@) % و الموت لا يخبر عن طعمه % إن أنت ساءلت كمن ذاقا % % 4(@)(@@) % مازلت أجري كلكلي فوقه % % حتى دعا من تحته قاقا % % 5(@)(@@) % نبئت زنبورا غدا آنفا % مني ، واستصحبت أباقا % % 6(@)(@@) % فقلت : كفوا بعض سخريكم % % فليس بالهين ما لاقى % % 7(@)(@@) % مر على الكرخ ، وقد أوسعت % يد الهجاء الوجه ألياقا % % 8(@)(@@) % ملتفتا يسحب من خلفه % أزمة تترى وأرباقا % % 9(@)(@@) % وكنت قد شمت لمحتومكم % % سحابة تبرق إبراقا % % 10(@)(@@) % حتى إذا 
ms134	 استجليتها لم أجد % لبرقها ذلك مصداقا % % PageV01P640 11(@)(@@) % يا شاعران اشتركا في قد % كنت إلى ذا اليوم مشتاقا % % 12(@)(@@) % لم تسعداني بهجائكما ، % أكل ذا بخلا و إشفاقا % % 13(@)(@@) % تتاركا أن رأياني إلى % % ما هيجا أغلب معناقا % % 14(@)(@@) % فاكتسبا من يدعي ذا وذا % % قلائدا تبقى وأطواقا % % PageV01P641 البحر : منسرح 1(@)(@@) % ياعربيا من صنعة السوق ، % وصنعة السوق ذات تشقيق % 2(@)(@@) % ما رأيكم يا نزار في رجل % يدخل فيكم من خلق مخلوق % 3(@)(@@) % ويحمل الوطب والعلاب ، ولا % % يصلح إلا لحمل إبريق % 4(@)(@@) % لقد ضربنا بالطبل أنك في ال % % قوم صحيح ، وصح في البوق % 5(@)(@@) % قد أخذ الله من رقاش ، على % % تركهم المجد ، بالمواثيق % 6(@)(@@) % فالناس يسعون للعلى قدما ، % وهم وراء مكسرو السوق % 7(@)(@@) % هذا كذاكم ، وفي الهياج إذا % % هيج ، فما شئت من بواشيق % PageV01P642 البحر : سريع 1(@)(@@) % لا بد أن أفحص عن شانه ، قد كان لي حمدان ذا زورة ، % يأخذه الشوق بإقلاق % 2(@)(@@) % في القر ، إن كان ، وفي يوم لا % % يبرز إلا كل مشتاق % 3(@)(@@) % فقلت ، إذ أوحشني فقده ، % وكنت ذا رعي لميثاقي : % 4(@)(@@) % لا بد أن أفحص عن شانه ، % جمت إلي الغي أشواقي % % 5(@)(@@) % فقال ذو الخبر به ، بعدما % % سكنت نفسا ذات إشفاق : % 6(@)(@@) % أما تراه وهو في قرطق ، % مشمرا فيه عن الساق % 7(@)(@@) % في وجهه من حمم جالب ، % كأنما عل بألياق % 8(@)(@@) % ترى سوادا قد علا حمرة ، % مثل تهاويل الشقراق % 9(@)(@@) % إن رابه من أمره رائب ، % فما له من دونها واق % 10(@)(@@) % حتى رآها ساميا فرعها ، % من بعد ما كانت بإرماق % PageV01P643 11(@)(@@) % أبعد سربال امرىء عالم ، % أصبحت في سربال مراق % 12(@)(@@) % بعد غدو لاكتساب العلى ، % تغدو على ربد وحراق % 13(@)(@@) % حاسر كفيك على هاون % لدق ثوم أو لسماق % 14(@)(@@) % إذا انتهى القوم إلى شبعهم % فأنت في حل من الباقي % % 15(@)(@@) % كل رغيف ناصع لونه % من سابري الخبز براق % PageV01P644 البحر : بسيط تام 1(@)(@@) % هل مخطىء حتفه عفر بشاهقة ، % رعى بأخيافها شثا وطباقا % % 2(@)(@@) % مسور من حباء الله أسورة ، % يركبن منها وظيف القين والساقا % % 3(@)(@@) % أو 
ms135	 لقوة أم انهيمين في لجف ، % شبيهتيها شفا خطم وآماقا % % 4(@)(@@) % مهبل دينها ، يوما ، إذا قلبت % إليه من مستكف الجو حملاقا % % 5(@)(@@) % أو ذو شياه ، اغن الصوت ، أرقه % وبل سرى ما خض الودقتين ، غيداقا % % 6(@)(@@) % حتى إذا جعل الإظلام يعرضه % شمائلا ، ورأى للصبح إيلاقا % % 7(@)(@@) % غدا كأن عليه من قواطره ، % بحيث يستودع الأسرار أخلاقا % % 8(@)(@@) % أو ذو نحائص أشباه إذا نسقت % مناسجا ، وثنت ملطا وأطباقا % % 9(@)(@@) % شتون حتى إذا ما صفن ذكرها % % من منهل موردا ، فاشتقن واشتاقا % % 10(@)(@@) % يؤم عينا بها زرقاء ، طامية % يرى عليها لجين الماء أطراقا % % PageV01P645 11(@)(@@) % زار الحمام أبا البيداء مخترما ، % ولم يغادر له في الناس مطراقا % % 12(@)(@@) % ويلمه صل أصلال ، إذا جفلوا % % يرون كل معي القول مغلاقا % % 13(@)(@@) % يا رب عوراء ذي قربى كتمت ، ولو % % فشت لألقت على الأعناق أطواقا % % 14(@)(@@) % ومن قوارع قد أخرست ناطقها ، % يحملن من مخطفات القوم أوساقا % % 15(@)(@@) % ومن قلائد قد قلدت باقيها % % 16(@)(@@) % فقلت ، لا حصرا بما وعت أذنا % % داع ، ولا ندسا للإفك خلاقا % % 17(@)(@@) % صل ، إذا ما رآه القوم عامدهم ، % أزاح ناطقهم صمتا وإطراقا % % 18(@)(@@) % فليس للعلم في الأقوام باقية ، % عاق العواقي أبا البيداء ، فانعاقا % % PageV01P646 البحر : بسيط تام 1(@)(@@) % إلفان كانا لهذا الوصل قد خلقا % % داما عليه ، ودام الحب ؛ فاتفقا % % 2(@)(@@) % كانا كغصنين في ساق ، فشانهما % % ريب الزمان ، وصرف الدهر فانفلقا % % 3(@)(@@) % واصفر عود لها من بعد خضرته ، % وأسقط البين عن أغصانه الورقا % % 4(@)(@@) % باتت عيونهما للبين ساهرة ، % وللفراق ، ولولا البين ما افترقا % % PageV01P647 البحر : وافر تام 1(@)(@@) % أخلائي أذمكم : إليكم ، % وكنت بمدحكم قمنا خليقا % % 2(@)(@@) % فلا وأبيكم ما الفضل دأبي ، % إذا ما لم أجد منكم صديقا % % 3(@)(@@) % إذا استبطأتكم عنفتموني % % وقلتم إن فيه لذاك ضيقا % % 4(@)(@@) % فأقسم لو تكونون الأسارى ، % وكنت أنا المخلى والطليقا % % 5(@)(@@) % إذن لجهدت فوق الجهد حتى % % أطيق خلاصكم أو لا أطيقا % % 6(@)(@@) % فلا والله أذخركم هجاء ، % وشتما ما بقيت ، ولا عقوقا % % PageV01P648 البحر : مجزوء الرمل 1(@)(@@) % عجبا لي كيف أبقى ، % ولقد أثخنت عشقا % % 2(@)(@@) % لم يقاس الناس داء 
ms136	 ، % كالهوى يبلي ويبقى % % 3(@)(@@) % أي شيء بعد أن ال % % دمع فيه ليس يرقا % % 4(@)(@@) % و لقد شق علي الح % % ب ما شا أن يشقا % % 5(@)(@@) % ليت شعري هكذا كا % % ن أخي عروة يلقى % % 6(@)(@@) % ونصيح قال : لا تع % جل بهلك النفس خرقا % % 7(@)(@@) % كدت من غيظ عليه ، % إذ لحاني ، أتفقا % % 8(@)(@@) % ويك إن الحب لم يم % لك سوى رقي رقا % % 9(@)(@@) % لي مولى أرتجي من % ه على رغمك عتقا % % 10(@)(@@) % قمر بين نجوم ، % ناصب في الصدر حقا % % PageV01P649 11(@)(@@) % أفعم الأرداف منه ، % وانطوى الكشح ودقا % % 12(@)(@@) % وإذا ما قام يمشي ، % مالت الأرداف شقا % % 13(@)(@@) % ثم لون يفضح الخم % ر صفا منه ورقا % % 14(@)(@@) % حب هذا لا سوى ذا ، % محق الأعمار محقا % % 15(@)(@@) % فاشددن بالحب كفا ، % وصلن بالحب ربقا % % 16(@)(@@) % إنما أسعد ربي % % بالهوى قوما ، وأشقى % % 17(@)(@@) % وبلاد في بلاد % أوحش البلدان طرقا % % 18(@)(@@) % قد شققت الليل عنها ، % ببنات الريح شقا % % 19(@)(@@) % طافيات ، راسبات ، % جبتها عنفا ، فعنقا % % 20(@)(@@) % نحو إبراهيم حتى % % نزلت في العدو وفقا % % PageV01P650 21(@)(@@) % فوقها الود المصفى ، % و المديح المتنقى % % 22(@)(@@) % مال إبراهيم بالما % % ل كذا غربا وشرقا % % 23(@)(@@) % فكفاني بخل من يخ % نق حلق الكيس خنقا % % 24(@)(@@) % واجدا من غير وجد ، % لاويا خطما وشدقا % % 25(@)(@@) % قسم الرحمن للأم % ة من كفيك رزقا % % 26(@)(@@) % فلك المال الملقى ، % ولك العرض الموقى % % 27(@)(@@) % جاد إبراهيم ، حتى % % جعلوه الناس حمقا % % 28(@)(@@) % وإذا ما حل في أر % ض من الأرضين شقا % % 29(@)(@@) % كان ذاك الأفق منها ، % أخصب الآفاق أفقا % % 30(@)(@@) % فلو أني قلت أو آ % % ليت يوما قلت حقا % % PageV01P651 31(@)(@@) % ما ترى النيلين إلا % من ندى كفيك شقا % % 32(@)(@@) % أيها الشائم وهنا ، % من أبي إسحاق برقا % % 33(@)(@@) % كل يوم أنت لاق % وجهه للجود طلقا % % 34(@)(@@) % اكتسى ريش جناحي % جعفر ثم ترقى % % 35(@)(@@) % وتنقى من قريش % جوهر العز المنقى % % 36(@)(@@) % وجرى جري جواد ، % قد أفات الخيل سبقا % % PageV01P652 البحر : طويل 1(@)(@@) % أبا منذر مابال أنساب مذحج % مرجمة دوني ، وأنت صديقي % % 2(@)(@@) % فإن تأتني يأتك ثنائي ومدحتي 
ms137	 ، % وإن تأب لا يسدد علي طريقي % % PageV01P653 البحر : طويل 1(@)(@@) % أيا رب وجه ، في التراب ، عتيق ، % ويا رب حسن ، في التراب ، رقيق % 2(@)(@@) % ويا رب حزم ، في التراب ، ونجدة ، % ويا رب رأي ، في التراب ، وثيق % 3(@)(@@) % أرى كل حي هالكا وابن هالك ، % وذا نسب في الهالكين عريق % 4(@)(@@) % فقل لقريب الدار : إنك ظاعن % إلى منزل نائي المحل سحيق % 5(@)(@@) % إذا امتحن الدنيا لبيب تكشفت % له عن عدو في ثياب صديق % PageV01P654 البحر : رجز تام 1(@)(@@) % أنعت كلبا ليس بالمسبوق ، % مطهما يجري على العروق % 2(@)(@@) % جاءت به الملاك من سلوق ، % كأنه في المقود الممشوق % 3(@)(@@) % إذا عدا عدوة لا معوق ، % يلعب بين السهل والخروق % 4(@)(@@) % يشفي من الطرد جوى المشوق ، % فالوحش لو مرت على العيوق % 5(@)(@@) % أنزلها دامية الحلوق ، % ذاك عليه أوجب الحقوق % 6(@)(@@) % لكل صياد به مرزوق % % PageV01P655 البحر : رمل تام 1(@)(@@) % وأخ إن جاءني في حاجة ، % كان بالإنجاز مني واثقا % % 2(@)(@@) % وإذا فاجأته في مثلها ، % كان بالرد بصيرا حاذقا % % PageV01P656 البحر : رجز تام 1(@)(@@) % لما تجلى الليل وابيض الأفق ، % وانجاب ستر الليل عن وجه الطرق % 2(@)(@@) % باكرني سهل المحيا والخلق ، % ندب إذا استندبته ، شهم لبق % 3(@)(@@) % يدعو : إلى الصيد ألا قلت : انطلق ، % بأكلب غضف صحيحات الحدق % 4(@)(@@) % من أصفر اللون ومبيض يقق ، % كأنما أذناه من بعض المزق % 5(@)(@@) % لو يلصق الخد بأذن لالتصق % % PageV01P657 البحر : بسيط تام 1(@)(@@) % لا تصحبن أخا نسك ، وإن نسكا ؛ % وإن فتكت ، فكن حربا لمن فتكا % % 2(@)(@@) % وناعم قام يسقيني ، فقلت له : % نفسي الفداء ، لمن هذا ؟ فقال : لكا % % 3(@)(@@) % قلت : بالشكر من عينيك آخذه ؛ % فصد من خجل مني ، وما ضحكا % % 4(@)(@@) % ما قلت ما قلته إلا لأخجله ، % ولو أعدت عليه مثله لبكى % % 5(@)(@@) % وبنت كرم سفكناها بدرهمنا ، % من بطن أسحم ، مسود ، وما سفكا % % 6(@)(@@) % كأن أكرعه أيد مقطعة ، % لا يرتجي قودا منها ، ولا دركا % % 7(@)(@@) % حتى إذا مزجت بالماء واختلطت ، % حاك المزاج لها من لؤلؤ فلكا % % PageV01P658 البحر : طويل 1(@)(@@) % وندمان صدق بل يزيد فكاهة % على الصدق ، لم يخلط مواتاته محكا 
ms138	 % % 2(@)(@@) % حمول لما حملته ، غير ضيق % ذراعا بما ضاق الكرام به مسكا % % 3(@)(@@) % دعاني ، وأعطاني من ابنة نفسه ، % مودته المثلى ، وفي ماله الشركا % % 4(@)(@@) % فقلت له : لا يشهد الصبح صحوة % فديتك ، مني يا نديم ولا منكا % % 5(@)(@@) % وبادر بقايا الليل يبلغك سكره % يحدث من لاقى الصباح به عنكا % % 6(@)(@@) % فأتحفنا الخمار حين طروقنا % % براقود خمر شك في جنبه شكا % % 7(@)(@@) % ذخيرة نوح في الزمان الذي اجتنى % % فأدخلها في الفلك إذ ركب الفلكا % % 8(@)(@@) % فلما عمدناها لنسفك ، بادرت % تباشير رياها ونكهتها السفكا % % 9(@)(@@) % كأن أكف القوم والآلة التي % % يديرون فيها أمرها ضمخت مسكا % % 10(@)(@@) % فما لاح ضوء الشمس حتى رأيتنا % % نقول لوقع السكر في هامناقدكا % % PageV01P659 11(@)(@@) % ترى عندنا ما يسخط الله كله % من العمل المردي الفتى ما خلا الشركا % % PageV01P660 البحر : بسيط تام 1(@)(@@) % إني حممت ، ولم أشعر بحماكا % % حتى تحدث عوادي بشكواكا % % 2(@)(@@) % فقلت : ما كانت الحمى لتعهدني ، % من غير ما علة إلا لحماكا % % 3(@)(@@) % وخصلة هي أيضا يستدل يها ، % عافاني الله منها حين عافاكا % % 4(@)(@@) % أما إذا اتفقت نفسي ونفسك في % % هذا وذاك ، وفي هذا وفي ذاكا % % 5(@)(@@) % فكن لنا رحمة ، نفسي فداك ، ولا % % تكن خلافا لما ذو العرش سماكا % % 6(@)(@@) % فقد علمت يقينا ، أو ستعلمه ، % صنيع حبك في قلبي وذكراكا % % PageV01P661 البحر : وافر تام 1(@)(@@) % فديتك قد جبلت على هواكا ، % فنفسي لا تنازعني سواكا % % 2(@)(@@) % فليت الناس أعموا عنك ، غيري ، % فآمن أن يروك كما أراكا % % 3(@)(@@) % وليتك كلما كلمت غيري ، % رميت بخرسه ، ومنعت فاكا % % 4(@)(@@) % أحبك لا ببعضي بل بكلي % % و إن لم يبقي حبك بي حراكا % % 5(@)(@@) % ويسمج من سواك الشيء عندي ، % فتفعله ؛ فيحسن منك ذاكا ! % PageV01P662 البحر : وافر تام 1(@)(@@) % فديتك لم أنلك بغير طرفي ، % فكلي حاسد طرفي عليك % 2(@)(@@) % لئن آثرت بعضي دون بعضي ، % وذالك يا منائي في يديك % 3(@)(@@) % لقد أودعت من لم تسعفيه % بحاجته ، تباريحا إليك % PageV01P663 البحر : كامل تام 1(@)(@@) % عديت عنك بمنطقي ، فعداكا % % وشكوت غيرك إذ رأيت هواكا % % 2(@)(@@) % عرضت بالشكوى بغيرك شبهة ، % وكنيت عنك 
ms139	 ، وما أريد سواكا % % PageV01P664 البحر : بسيط تام 1(@)(@@) % العبد عبدك حقا ، وابن عبديك ، % فكيف يعصيك عبد طوع كفيك % 2(@)(@@) % إن قال لبيك ، لم تقنع بواحدة ، % حتى يضيف إلى لبيك سعديك % 3(@)(@@) % يا شاغلي بهواه مذ بليت به ، % أسخنت عيني ، أقر الله عينيك % PageV01P665 البحر : كامل تام 1(@)(@@) % كم من حديث معجب عندي لكا % % لو قد نبذت به إليك لسركا % % 2(@)(@@) % مما يزيد على الإعادة جدة ، % غص إذا خلق الحديث أملكا % % 3(@)(@@) % وكأنني بك قد شغفت بحسنه ، % فخططته حرصا عليه بكفكا % % 4(@)(@@) % تتبع الظرفاء إعجابا به ، % حتى تحدث من تحب فيضحكا % % PageV01P666 البحر : مجزوء الرمل 1(@)(@@) % قد حكى البدر بهاكا % % فرآه من رآكا % % 2(@)(@@) % وزها بالحسن لما % % صار في الحسن حكاكا % % 3(@)(@@) % أيها الغضبان : رفقا % جعلت نفسي فداكا % % 4(@)(@@) % يا شبيه البدر حسنا ، % قل صبري عن هواكا % % PageV01P667 البحر : كامل تام 1(@)(@@) % أصبحت معتدا علي بنعمة ، أصبحت غير مدافع مولاكا ، % والحظ لي في أن أكون كذاكا % % 2(@)(@@) % لله دري أي رهن منية % بالأمس كنت ، وهالك لولاكا % % 3(@)(@@) % أصبحت معتدا علي بنعمة ، % ما كان ينعمها علي سواكا % % PageV01P668 البحر : سريع 1(@)(@@) % قل للرقاشي ، إذا جئته ، % لو مت يا أحمق لم أهجكا % % 2(@)(@@) % لأنني أكرم عرضي ، ولا % % أقرنه يوما إلى عرضكا % % 3(@)(@@) % إن تهجني تهجو فتى ماجدا ، % لا يرفع الطرف إلى مثلكا % % 4(@)(@@) % دونك عرضي فاهجه راشدا ، % لا تدنس الأعراض من هجوكا % % 5(@)(@@) % والله لو كنت جريرا لما % % كنت بأهجى لك من أصلكا % % PageV01P669 البحر : مجزوء الوافر 1(@)(@@) % رأيت الفضل مكتئبا % يناغي الخبز والسمكا % % 2(@)(@@) % فقطب حين أبصرني ، % ونكس رأسه ، وبكى % % 3(@)(@@) % فلما أن حلفت له % بأني صائم ضحكا % % PageV01P670 البحر : وافر تام 1(@)(@@) % أأشرس ، إن يكن ما قيل حقا ، % وأحر به فقد ظفرت يداكا % % 2(@)(@@) % أبحت من ابن اختك غير حل ، % وقلت عهدت أشياخي كذاكا % % 3(@)(@@) % فما نلت ابن اختك قط ، حتى % % بدأت بأمه من قبل ذاكا % % PageV01P671 البحر : منسرح 1(@)(@@) % يا ابن حديج أطرق على مضد ، % لا تبر من سلعة ولا حسك % 2(@)(@@) % فلست من آكل المرار ، ولا ال 
ms140	 % % فارس رب الرباب والملك % 3(@)(@@) % فارض بحظ السكون من تافه ال % % مجد ، فليس السكون كالحرك % PageV01P672 البحر : مجتث 1(@)(@@) % يزيد ! ماذا دهاكا % % جننت ؟ أم ما اعتراكا ؟ % 2(@)(@@) % ملك زها بك بعدي % % أم صاحب أغواكا ؟ % 3(@)(@@) % أم غفلة حدثت في % % ك ، أم هوى أضناكا ؟ % 4(@)(@@) % أم مرة وافقت وق % تها ؟ فهذا لذاكا % % 5(@)(@@) % إما بلاك لقد أج % هد الإله بلاكا % % 6(@)(@@) % أقبل علي ، فقل لي % % لا أبصرت عيناكا % % 7(@)(@@) % أآذن أنت في قط % ع كل من صافاكا ؟ % 8(@)(@@) % بل ما أظن المعنى % % إلا امرأ آخاكا % % 9(@)(@@) % وإن يقدر إله ال % % عباد أن لا أراكا % % 10(@)(@@) % وطول رب على الهج % ر والجفا قواكا % % PageV01P673 11(@)(@@) % لو أن كفي عنان % رطوبة كفاكا % % 12(@)(@@) % و وجنتي تمتام % تحكيهما وجنتاكا % % 13(@)(@@) % و مقلتي رحمة في % % زناهما مقلتاكا % % 14(@)(@@) % وكنت في الحسن فردا % لما احتملت جفاكا % % 15(@)(@@) % لا تهوين يزيدا ، % بعد الذي قد أراكا % % 16(@)(@@) % وقد نهيت فؤادي ، % في خلوة فتباكا % % 17(@)(@@) % فقلت : لا غرني من % % ك يا فؤادي بكاكا % % 18(@)(@@) % فكن له قطاعا ؛ % وكن له تراكا % % 19(@)(@@) % وإن هممت بشيء ، % من وده ، فنهاكا % % 20(@)(@@) % فالسوط ما استمسكته % يمينك استمساكا % % PageV01P674 21(@)(@@) % والله . والله ربي % % أقولهن دراكا % % 22(@)(@@) % لأقمطنك في عص % بة بفضل رداكا % % 23(@)(@@) % حتى إذا ماجدلنا % % ك جانبا جئناكا % % 24(@)(@@) % من آخذ لك نعلا ، % وآخذ مسواكا % % 25(@)(@@) % وذا عنان ، وهذا % % سوطا ، وذاك مداكا % % 26(@)(@@) % حتى إذا ما سلخنا % % سلخ النشوط قفاكا % % 27(@)(@@) % قد أتى ، بعد ، قوم % يقطعون الشباكا % % 28(@)(@@) % حتى تقول لإنكا % % ر ما به أغشاكا % % 29(@)(@@) % يا أرحم الناس لي ، كا % % ن مرة ، ما دهاكا ؟ % 30(@)(@@) % وقد أمرت من الج % % ن حوقلا وضناكا % % PageV01P675 31(@)(@@) % أن يصفناك على أر % بع ، وأن يبركاكا % % 32(@)(@@) % حتى إذا لم تطق من % وقع الصفير حراكا % % 33(@)(@@) % استعتباك ، فإن عد % ت بعدها صلباكا % % PageV01P676 البحر : مجزوء الكامل 1(@)(@@) % إني أتيت بني المهل % هل آنفا بهجائكا % % 2(@)(@@) % فاستوحشوا من ذاكم % أنفين من عرفانكا % % 3(@)(@@) % فشهدت أن مهلهلا % كبنيه في إنكاركا % % 4(@)(@@) % فهلم بينة تقي 