ms461	 ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنهما أن رسول الله ذبح كبشا بالمصلى فقال فذكره .(@)(@@)(@@)(@@) $ ( 4364 ) قال النبي :(@)(@@) | 30 ( اللهم هاذا عني وعن أمتي ) )(@)(@@) ( ك ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4365 ) قال النبي :(@)(@@) | 30 ( اللهم فاطر السماوات والأرض ، عالم الغيب والشهادة ، أنت رب كل شيء ، والملائكة يشهدون أنك لا إلاه إلا أنت ، فإنا نعوذ بك من شر أنفسنا ومن شر الشيطان الرجيم وشركه ، وأن نقترف على أنفسنا سوءا أو نجره إلى مسلم ) )(@)(@@) ( د طب ) عن أبي مالك الأشعري رضي الله عنه قال : أمرنا رسول الله أن نقول إذا أصبحنا وإذا أمسينا وإذا اضطجعنا على فراشنا فذكره .(@)(@@)(@@)(@@) $ ( 4366 ) قال النبي :(@)(@@) | 30 ( اللهم اسقنا غيثا مغيثا هنيئا مريئا عاجلا غير رائث ، نافعا غير ضار ، سقيا رحمة ، ولا سقيا عذاب ولا هدم ولا غرق ، اللهم اسقنا الغيث وانصرنا على الأعداء ) )(@)(@@) ابن شاهين عن يزيد بن رومان .(@)(@@)(@@)(@@) $ ( 4367 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل في بصري نورا ، واجعل في سمعي نورا ، واجعل في لساني نورا ، واجعل في قلبي نورا ، واجعل من فوقي نورا ، واجعل من أسفل مني نورا ، واجعل لي يوم ألقاك نورا وأعظم لي نورا ) )(@)(@@) ( ك ) عن PageV02P127 ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4368 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لأبي سلمة ، وارفع درجته في المقربين ، واخلفه في عقبه في الغابرين ، واغفر لنا وله يا رب العالمين ، وافسح له في قبره ، ونور له فيه ) )(@)(@@) ( حم م د ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4369 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر له وارحمه ، وعافه واعف عنه ، وأكرم نزله ووسع مدخله ، واغسله بالماء والثلح والبرد ، ونقه من الخطايا كما نقيت الثوب الأبيض من الدنس وأبدله دارا خيرا من داره ، وأهلا خيرا من أهله ، وزوجا خيرا من زوجه ، وأدخله الجنة ، وأعذه من عذاب القبر وفي لفظ وقه فتنة القبر ) )(@)(@@) ( ش م ن ه ) عن عوف بن مالك الأشجعي رضي الله عنه قال : صلى رسول الله على جنازة فحفظت من دعائه .(@)(@@)(@@)(@@) $ ( 4370 ) قال النبي :(@)(@@) | 30 ( اللهم أصلح ديني الذي هو 
ms462	 عصمة أمري ، وأصلح لي دنياي التي فيها معاشي ، وأصلح لي آخرتي التي فيها معادي ، واجعل الحياة زيادة لي في كل خير ، واجعل الموت راحة لي من كل شر ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4371 ) قال النبي :(@)(@@) | 30 ( اللهم استر عورتي ، وآمن روعتي ، واقض عني ديني ) )(@)(@@) ابن قانع ( طب ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4372 ) قال النبي :(@)(@@) | 30 ( اللهم أنت ربها وأنت خلقتها وأنت هديتها للاسلام ، وأنت قبضت روحها ، وأنت أعلم بسرها وعلانيتها ، جئنا شفعاء فاغفر لها ) )(@)(@@) ( د هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4373 ) قال النبي :(@)(@@) | 30 ( اللهم إن فلان بن فلان في ذمتك وظل جوارك ، فقه من فتنة القبر وعذاب النار وأنت أهل الوفاء والحمد ، اللهم فاغفر له وارحمه إنك أنت الغفور الرحيم ) )(@)(@@) ( حم ) د ه ) عن واثلة رضي الله عنه .(@)(@@) PageV02P128(@)(@@)(@@)(@@) $ ( 4374 ) قال النبي :(@)(@@) | 30 ( اللهم اجعل صلواتك ورحمتك على آل سعد بن عبادة ) )(@)(@@) ( د ) عن قيس بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4375 ) قال النبي :(@)(@@) | 30 ( اللهم إن سعدا قد جاهد في سبيلك وصدق رسولك ، وقضى الذي عليه فتقبل روحه بخير ما تقبلت به روحا ) )(@)(@@) ( ابن سعد ) عن إسماعيل بن أبي خالد عن رجل من الأنصار .(@)(@@)(@@)(@@) $ ( 4376 ) قال النبي :(@)(@@) | 30 ( اللهم أعط ابن عباس الحكمة وعلمه التأويل ) )(@)(@@) ( حم طب حل ) عن ابن عباس ( ابن سعد ) ( حم طب ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4377 ) قال النبي :(@)(@@) | 30 ( اللهم بارك فيه وانشر منه قاله لابن عباس ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4378 ) قال النبي :(@)(@@) | 30 ( اللهم علمه الحكمة وتأويل الكتاب ) )(@)(@@) ( ه ) و ابن سعد ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4379 ) قال النبي :(@)(@@) | 30 ( اللهم اشهد ، اللهم قد بلغت ، هاذا أخي وابن عمي وصهري وأبو ولدي ، اللهم كب من عاداه في النار ) )(@)(@@) الشيرازي في الألقاب وابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4380 ) قال النبي :(@)(@@) | 30 ( اللهم حاسبني حسابا يسيرا ، قيل : ما الحساب اليسير ؟ قال : ينظر في كتابه ويتجاوز عنه ، إنه من 
ms463	 نوقق الحساب يومئذ هلك ، وكل ما يصيب المؤمن يكفر الله عنه من سيئاته حتى الشوكة تشوكه ) )(@)(@@) ( ك هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4381 ) قال النبي :(@)(@@) | 30 ( اللهم جنبني منكرات الأعمال والأخلاق والأهواء PageV02P129 والأدواء ) )(@)(@@) الحكيم ( طب ك ) عن زياد بن علاقة عن عمه رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4382 ) قال النبي :(@)(@@) | 30 ( اللهم اغفر لي ما أخطأت وما عمدت ، وما أسررت وما أعلنت وما جهلت ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4383 ) قال النبي :(@)(@@) | 30 ( اللهم احمل عليها في سبيلك فإنك تحمل القوي والصعيف والرطب واليابس في البحر والبر ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4384 ) قال النبي :(@)(@@) | 30 ( اللهم إني أسألك الرضى بالقضاء وبرد العيش بعد الموت ، ولذة النظر إلى وجهك والشوق إلى لقائك من غير ضراء مضرة ولا فتنة مضلة ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4385 ) قال النبي :(@)(@@) | 30 ( اللهم من لعنت في الجاهلية ثم دخل في الإسلام فاجعل ذالك قربة له إليك ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4386 ) قال النبي :(@)(@@) | 30 ( اللهم أمتعني بسمعي وببصري وبعقلي واجعله الوارث مني ، وانصرني على من ظلمني وأرني منه ثأري ) )(@)(@@) ( قط ) في الأفراد عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4387 ) قال النبي :(@)(@@) | 30 ( اللهم أعوذ بك من قلب لا يخشع ، وعلم لا ينفع ، ودعاء لا يستجاب ، ونفس لا تشبع ، ومن الجوع فبئس الضجيع ، ومن أن أرد إلى أرذل العمر ، ومن فتنة الدجال وعذاب القبر ) )(@)(@@) ( ع ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4388 ) قال النبي :(@)(@@) | 30 ( اللهم إني أعوذ بك من الشك بعد اليقين ، وأعوذ بك من شر الشيطان الرجيم ، وأعوذ بك من عذاب يوم الدين ) )(@)(@@) ابن صصرى في أماليه عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4389 ) قال النبي :(@)(@@) | 30 ( اللهم لا أحل لهم أن يكذبوا علي ) )(@)(@@) ( طب ) عن PageV02P130 المنقع التميمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4390 ) قال النبي :(@)(@@) | 30 ( اللهم بارك في الجذامى ) )(@)(@@) ( طب ) عن الهرماس بن زياد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4391 ) قال النبي :(@)(@@) | 30 ( اللهم صاحت جبالنا 
ms464	 ، واغبرت أرضنا ، وهامت دوابنا ، معطي الخيرات من أماكنها ، منزل الرحمة من معادنها ، مجري البركات على أهلها بالغيث المغيث ، أنت المستغفر الغفار فنستغفرك للجامات من ذنوبنا ، ونتوب إليك من عوام خطايانا ، اللهم فأرسل السماء علينا مدرارا ، وصل بالغيث ، واكف من تحت عرشك حيث يسقينا ويعود علينا غيثا مغيثا ، عاما طبقا ، مجللا غدقا ، خصيبا رائعا ممرع النبات ) )(@)(@@) ابن صصرى في أماليه عن جعفر بن عمرو بن حريث عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 4392 ) قال النبي :(@)(@@) | 30 ( اللهم جللنا سحابا كثيفا قصيفا دلوقا حلوقا ضحوكا زبرجا تمطرنا منه رذاذا قطقطا سجالا بعاقا يا ذا الجلال والإكرام ) )(@)(@@) ابن صصرى والديلمي عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4393 ) قال النبي :(@)(@@) | 30 ( اللهم إنك جعلت صلواتك ورحمتك ومغفرتك ورضوانك على إبراهيم وآل إبراهيم اللهم إنهم مني وأنا منهم ، فاجعل صلواتك ورحمتك ومغفرتك ورضوانك علي وعليهم ) )(@)(@@) يعني علي وفاطمة وحسن وحسين ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4394 ) قال النبي :(@)(@@) | 30 ( اللهم أكثر رجالهم ، وأقل إماءهم ، ولا تحوجهم ، ولا تر أحدا بهم خصاصة ) )(@)(@@) ( طب ) عن ياسر بن سويد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4395 ) قال النبي :(@)(@@) | 30 ( اللهم أنت الأول لا شيء قبلك ، وأنت الآخر لا PageV02P131 شيء بعدك ، أعوذ بك من كل دابة ناصيتها بيدك ، وأعوذ بك من الإثم والكسل ، ومن عذاب النار ومن عذاب القبر ، ومن فتنة الغنى وفتنة الفقر ، وأعوذ بك من المأثم والمغرم ، اللهم نق قلبي من الخطايا كما نقيت الثوب الأبيض من الدنس ، اللهم باعد بيني وبين خطيئتي كما باعدت بين المشرق والمغرب ، هاذا ما سأل محمد ربه ، اللهم إني أسألك خير المسألة وخير الدعاء وخير النجاح وخير العمل وخير الثواب وخير الحياة وخير الممات وثبتني وثقل موازيني وأحق إيماني وارفع درجتي وتقبل صلاتي واحقر خطيئتي ، وأسألك الدرجات العلى من الجنة آمين ، اللهم إني أسألك فواتح الخير وخواتمه وجوامعه ، وأوله وآخره ، وظاهره وباطنه ، والدرجات العلى من الجنة آمين ، اللهم ونجني من النار ، ومغفرة بالليل والنهار ، والمنزل الصالح من الجنة آمين ، اللهم إني أسألك خلاصا من النار سالما 
ms465	 ، وأدخلني الجنة آمنا ، اللهم إني أسألك أن تبارك لي في نفسي وفي سمعي وفي بصري وفي روحي وفي خلقي وفي خليقتي وفي أهلي وفي محياي ومماتي ، اللهم وتقبل حسناتي ، وأسألك الدرجات العلى من الجنة آمين ) )(@)(@@) ( طب ك ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4396 ) قال النبي :(@)(@@) | 30 ( اللهم إليك لا إلى النار أنا وأهل بيتي ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4397 ) قال النبي :(@)(@@) | 30 ( اللهم انفعني بما علمتني ، وعلمني ما ينفعني ، وارزقني علما ينفعني ) )(@)(@@) ( ه ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4398 ) قال النبي :(@)(@@) | 30 ( اللهم لا تجعل لفاجر عندي نعمة أكافئه بها في الدنيا والآخرة ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4399 ) قال النبي :(@)(@@) | 30 ( ألهوا والعبوا فإني أكره أن يرى في دينكم غلظة ) )(@)(@@) ( هب ) و الديلمي عن المطلب بن عبد الله رضي الله عنه .(@)PageV02P132(@)(@@)(@@)(@@) ||| ( الهمزة مع الميم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 4400 ) قال النبي :(@)(@@) | 30 ( أما إن ابنك هاذا لا يجني عليك ولا تجني عليه ) )(@)(@@) ( حم د ن ك ) عن أبي رمثة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4401 ) قال النبي :(@)(@@) | 30 ( أما إن العريف يدفع في النار دفعا ) )(@)(@@) ( طب ) عن يزيد بن سيف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4402 ) قال النبي :(@)(@@) | 30 ( أما إن خير الماء الشبم ، وأفضل المال الغنم ، وخير المرعى الأراك والسلم ، إذا أخلف كان لحينا ، وإذا أسقط كان رزينا ، وإذا أكل كان لبينا ) )(@)(@@) ( ابن عساكر ) عن ابن مسعود وابن عباس رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 4403 ) قال النبي :(@)(@@) | 30 ( أما إن ربك يحب المدح ) )(@)(@@) ( حم خد ن ك ) عن الأسود بن سريع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4404 ) قال النبي :(@)(@@) | 30 ( أما إن كل بناء فهو وبال على صاحبه يوم القيامة ، إلا ما كان في مسجد أو أو أو ) )(@)(@@) ( حم ( 1 ) ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4405 ) قال النبي :(@)(@@) | 30 ( أما إن كل بناء وبال على صاحبه إلا ما لا وإلا ما لا ) )(@)(@@) ( د ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4406 ) قال النبي :(@)(@@) | 30 ( أما إنك لو قلت حين 
ms466	 أمسيت أعوذ بكلمات الله التامات من شر ما خلق لم تضرك ) )(@)(@@) ( م د ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4407 ) قال النبي :(@)(@@) | 30 ( أما إنك لو لم تعطيه شيئا كتب عليك كذبة ) PageV02P133 )(@)(@@) ( حم د ) عن عبد الله بن عامر بن ربيعة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4408 ) قال النبي :(@)(@@) | 30 ( أما إنكم لو أكثرتم ذكر هاذم اللذات لشغلكم عما أرى . الموت ، فأكثروا ذكر هاذم اللذات الموت ، فإنه لم يأت على القبر يوم إلا تكلم فيه فيقول : أنا بيت الغربة ، وأنا بيت الوحدة ، وأنا بيت التراب ، وأنا بيت الدود ، فإذا دفن العبد المؤمن قال له القبر : مرحبا وأهلا ، أما إن كنت لأحب من يمشي على ظهري إلي فإذ وليتك اليوم وصرت إلي فسترى صنيعي بك ، فيتسع له مد بصره ، ويفتح له باب إلى الجنة ، وإذا دفن العبد الفاجر أو الكافر قال له القبر لا مرحبا ولا أهلا ، أما إن كنت لأبغض من يمشي على ظهري إلي ، فإذ وليتك اليوم فسترى صنيعي بك ، فيلتئم عليه حتى يلتقي عليه وتختلف أضلاعه ، ويقيض له سبعون تنينا ، لو أن واحدا منها نفخ في الأرض ما أنبتت شيئا ما بقيت الدنيا ، فينهشنه ويخدشنه حتى يفضى به إلى الحساب ، إنما القبر روضة من رياض الجنة ، أو حفرة من حفر النار ) )(@)(@@) ( ت ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4409 ) قال النبي :(@)(@@) | 30 ( أما إن ملكا بينكما يذب عنك كلما شتمك هاذا ، قال له : بل أنت وأنت أحق به ، وإذا قلت له : عليك السلام ، قال : لا بل لك أنت أحق بها ) )(@)(@@) ( حم ) عن النعمان بن مقرن رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4410 ) قال النبي :(@)(@@) | 30 ( أما إنها ستكون لكم الأنماط ) )(@)(@@) ( ق د ت ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4411 ) قال النبي :(@)(@@) | 30 ( أما إنه لئن حلف على ماله ليأكله ظلما ، ليلقين الله وهو عنه معرض ) )(@)(@@) ( م د ت ) عن وائل بن حجر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4412 ) قال النبي :(@)(@@) | 30 ( إما إنه لا يدرك قوم بعدكم صاعكم ولا مدكم ) )(@)(@@) ( ك 
ms467	 ) PageV02P134 عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4413 ) قال النبي :(@)(@@) | 30 ( أما إنه لم تهلك الأمم قبلكم حتى وقعوا في مثل هاذا ، يضربون القرآن بعضه ببعض ما كان من حلال فأحلوه ، وما كان من حرام فحرموه ، وما كان من متشابه فآمنوا به ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4414 ) قال النبي :(@)(@@) | 30 ( أما إنه لو قال بسم الله لكفاكم فإذا أكل أحدكم طعاما فليقل بسم الله ، فإن نسي أن يقول بسم الله في أوله ، فليقل بسم الله أوله وآخره ) )(@)(@@) ( حم ه حب هق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4415 ) قال النبي :(@)(@@) | 30 ( أما إنه لو قال حين أمسى : أعوذ بكلمات الله التامات من شر ما خلق ما ضره لدغ عقرب حتى يصبح ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4416 ) قال النبي :(@)(@@) | 30 ( أما إني ساحدثكم ما حبسني عنكم الغداة ، إني قمت فتوضأت وصليت ما قدر لي ، ونعست في صلاتي حتى استثقلت ، فإذا أنا بربي تبارك وتعالى في أحسن صورة قال : يا محمد ، قلت : لبيك ربي ، قال : فيم يختصم الملا الأعلى ؟ قلت : لا أدري ، قالها ثلاثا ، فرأيته وضع كفه بين كتفي ، فوجدت برد أنامله بين ثديي ، فتجلى لي كل شيء وعرفت ، فقال : يا محمد ، قلت : لبيك ، قال : فيم يختصم الملا الأعلى ؟ قلت : فلي الكفارات ، قال ما هن ؟ قلت : مشي الأقدام إلى الحسنات ، والجلوس في المساجد بعد الصلوات ، وإسباغ الوضوء حين المكروهات ، قال : وفيم ؟ قلت : في إطعام الطعام ، ولين الكلام ، والصلاة والناس نيام ، قال : سل ، قلت : اللهم إني أسألك فعل الخيرات ، وترك المنكرات ، وحب المساكين ، وأن تغفر لي وترحمني ، وإذا أردت فتنة في قوم فتوفني غير مفتون ، أسألك حبك ، وحب من يحبك ، وحب عمل PageV02P135 يقربني إلى حبك ، إنها حق فادرسوها ، ثم تعلموها ) )(@)(@@) ( ت ك ) عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4417 ) قال النبي :(@)(@@) | 30 ( أما بلغكم أني لعنت من وسم ( 1 ) البهيمة في وجهها أو ضربها في وجهها ) )(@)(@@) ( د ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4418 ) قال النبي :(@)(@@) | 30 
ms468	 ( أما ترضى إحداكن أنها إذا كانت حاملا من زوجها وهو عنها راض أن لها مثل أجر الصائم القائم في سبيل الله ، وإذا أصابها الطلق لم يعلم أهل السماء والأرض ما أخفي لها من قرة أعين ، فإذا وضعت لم يخرج من لبنها جرعة ، ولم يمص من ثديها مصة إلا كان لها بكل جرعة وبكل مصة حسنة ، فإن أسهرها ليلة كان لها مثل أجر سبعين رقبة تعتقهم في سبيل الله ، سلامة تدرين من أعني بهاذا ؟ الممتنعات الصالحات المطيعات لأزواجهن ، اللواتي لا يكفرن العشير ) )(@)(@@) ( الحسن بن سفيان ) ( طس وابن عساكر ) عن سلامة حاضنة السيد إبراهيم رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4419 ) قال النبي :(@)(@@) | 30 ( أما ترضى أن تكون لهم الدنيا ولنا الآخرة ) )(@)(@@) ( ق ه ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4420 ) قال النبي :(@)(@@) | 30 ( أما رأيت العارض الذي عرض لي قبيل ؟ هو ملك من الملائكة لم يهبط إلى الأرض قط قبل هاذه الليلة ، استأذن ربه عز وجل أن يسلم علي ويبشرني أن الحسن والحسين سيدا شباب أهل الجنة ، وأن فاطمة سيدة نساء أهل الجنة ) )(@)(@@) ( حم ت ن حب ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4421 ) قال النبي :(@)(@@) | 30 ( أما شعرت أن الله عز وجل قد زوجني في الجنة مريم بنت عمران ، وكلثم أخت موسى ، وامرأة فرعون ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4422 ) قال النبي :(@)(@@) | 30 ( أما علمت أن الإسلام يهدم ما كان قبله ، وأن الهجرة PageV02P136 تهدم ما كان قبلها ، وأن الحج يهدم ما كان قبله ) )(@)(@@) ( م ) عن عمرو بن العاصي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4423 ) قال النبي :(@)(@@) | 30 ( أما علمت أن الملائكة لا تدخل بيتا فيه صورة ، وأن من صنع الصور يعذب يوم القيامة ، فيقال : أحيوا ما خلقتم ) )(@)(@@) ( خ ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4424 ) قال النبي :(@)(@@) | 30 ( أما علمت أنك وما لك من كسب أبيك ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4425 ) قال النبي :(@)(@@) | 30 ( أما علمت أن ملكا ينادي في السماء يقول : اللهم اجعل لمال منفق خلفا ، واجعل لمال 
ms469	 ممسك تلفا ) )(@)(@@) ( طب ) عن عبد الرحمن بن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4426 ) قال النبي :(@)(@@) | 30 ( أما كان يجد هاذا ما يسكن به رأسه ، أما كان يجد هاذا ما يغسل به ثيابه ) )(@)(@@) ( حم د حب ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4427 ) قال النبي :(@)(@@) | 30 ( أما مررت بوادي قومك ممحلا ، ثم تمر به خضرا ، ثم تمر به ممحلا ثم تمر به خضرا ، كذالك يحيي الله الموتى ) )(@)(@@) ( حم طب ) عن أبي رزين رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4428 ) قال النبي :(@)(@@) | 30 ( أما والله إني لأتقاكم لله ، وأخشاكم له ) )(@)(@@) ( م ) عن عمرو بن أبي سلمة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4429 ) قال النبي :(@)(@@) | 30 ( أما والله إني لأخشاكم لله ، وأتقاكم له ، لاكني أصوم وأفطر ، وأصلي وأرقد ، وأتزوج ال| نس اء ، فمن رغب عن سنتي فليس مني ) PageV02P137 )(@)(@@) ( خ ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4430 ) قال النبي :(@)(@@) | 30 ( أما والله إني لأمين في السماء ، وأمين في الأرض ) )(@)(@@) ( طب ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4431 ) قال النبي :(@)(@@) | 30 ( أما والله لو كان أسامة جارية حليتها وزينتها حتى أنفقها ) )(@)(@@) ( ابن سعد ) عن أبي السفر مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 4432 ) قال النبي :(@)(@@) | 30 ( أما والله لولا أن الرسل لا تقتل لضربت أعناقكما ) )(@)(@@) ( د ك ) عن نعيم بن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4433 ) قال النبي :(@)(@@) | 30 ( أما يخشى أحدكم إذا رفع رأسه في الصلاة أن لا يرجع إليه بصره ) )(@)(@@) ( حم م ه ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4434 ) قال النبي :(@)(@@) | 30 ( أما يخشى أحدكم إذا رفع رأسه قبل الإمام أن يجعل الله رأسه رأس حمار ، أو يجعل الله صورته صورة حمار ) )(@)(@@) ( ق 4 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4435 ) قال النبي :(@)(@@) | 30 ( أما إبراهيم فانظروا إلى صاحبكم وأما موسى فجعد آدم ، كأني أنظر إليه انحدر في الوادي يلبي على جمل أحمر مخطوم بخلبة ) )(@)(@@) ( حم ق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4436 ) قال النبي :(@)(@@) | 30 ( أما الرجل فلينثر رأسه فليغسله حتى يبلغ أصول الشعر ، وأما 
ms470	 المرأة فلا عليها أن لا تنقصه ، لتغرف على رأسها ثلاث غرفات تكفيها ) )(@)(@@) ( د ) عن ثوبان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4437 ) قال النبي :(@)(@@) | 30 ( أما أنا فآخذ بكفي ثلاثا فأصب على رأسي ثم أفيض PageV02P138 على سائر جسدي ) )(@)(@@) ( حم ق د ن ه ) عن جبير بن مطعم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4438 ) قال النبي :(@)(@@) | 30 ( أما أنا فأسجددعلى سبعة أعظم ولا أكف شعرا ولا ثوبا ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4439 ) قال النبي :(@)(@@) | 30 ( أما أنا فأفيض على رأسي ثلاثا ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4440 ) قال النبي :(@)(@@) | 30 ( أما أنا فلا آكل متكئا ) )(@)(@@) ( ت ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4441 ) قال النبي :(@)(@@) | 30 ( أما أنت يا أبا بكر والمؤمنون فتجزون بذالك في الدنيا حتى تلقوا الله وليس لكم ذنوب ، وأما الآخرون فيجمع ذالك لهم حتى يجزوا به يوم القيامة ) )(@)(@@) ( ت ) عن أبي بكر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4442 ) قال النبي :(@)(@@) | 30 ( أما أنت يا ا| بن عباس فلا تشهد إلا على أمر يضيء لك كضياء هاذه الشمس ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4443 ) قال النبي :(@)(@@) | 30 ( أما أنت يا جعفر فأشبهت خلقي وخلقي ، وأما أنت يا زيد فمني وأنا منك ، وأخونا ومولانا والجارية عند خالتها فإن الخالة والدة ) )(@)(@@) ( م ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4444 ) قال النبي :(@)(@@) | 30 ( أما أنت يا جعفر فأشبه خلقك خلقي ، وأشبه خلقي خلقك ، وأنت مني وشجرتي ، وأما أنت يا علي فختني وأبو ولدي وأنا منك وأنت مني ، وأما أنت يا زيد فمولاي ومني وإلي ، وأحب القوم إلي ) )(@)(@@) ( حم طب ك ) عن أسامة بن زيد رضي الله عنه ( ز ) .(@)(@@) PageV02P139(@)(@@)(@@)(@@) $ ( 4445 ) قال النبي :(@)(@@) | 30 ( أما أول أشراط الساعة فنار تخرج من المشرق فتحشر الناس إلى المغرب ، وأما أول ما يأكل أهل الجنة فزيادة كبد الحوت ، وأما شبه الولد أباه وأمه ، فإذا سبق ماء الرجل ماء المرأة نزع إليه الولد ، وإذا سبق ماء المرأة ماء الرجل نزع إليها 
ms471	 ) )(@)(@@) ( حم خ ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4446 ) قال النبي :(@)(@@) | 30 ( أما أهل النار الذين هم أهلها فإنهم لا يموتون فيها ولا يحيون ، ولكن ناس أصابتهم النار بذنوبهم فأماتتهم إماتة حتى إذا كانوا فحما أذن بالشفاعة فجيء بهم ضبائر فبتوا على أنهار الجنة ثم قيل : يا أهل الجنة أفيضوااعليهم ، فينبتون نبات الحبة تكون في حميل السيل ) )(@)(@@) ( حم م ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4447 ) قال النبي :(@)(@@) | 30 ( أما بعد : ألا أيها الناس ، فإنما أنا بشر يوشك أن يأتيني رسول ربي فاجيب ، وأنا تارك فيكم ثقلين أولهما كتاب الله فيه الهدى والنور ، من استمسك به وأخذ به كان على الهدى ، ومن أخطأه ضل ، فخذوا بكتاب الله تعالى واستمسكوا به ، وأهل بيتي أذكركم الله في أهل بيتي ، أذكركم الله في أهل بيتي ) )(@)(@@) ( حم ) وعبد بن حميد ( م ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4448 ) قال النبي :(@)(@@) | 30 ( أما بعد : أيها الناس ، فإن الناس يكثرون ويقل الأنصار ، حتى يكونوا في الناس بمنزلة الملح في الطعام ، فمن ولي أمرا يضر فيه أحدا أو ينفع فيه أحدا فليقبل من محسنهم ويتجاوز عن مسيئهم ) )(@)(@@) ( خ ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4449 ) قال النبي :(@)(@@) | 30 ( أما بعد : فإن أصدق الحديث كتاب الله ، وإن أفضل الهدى هدي محمد ، وشر الأمور محدثاتها وكل محدثة بدعة ، وكل بدعة PageV02P140 ضلالة ، وكل ضلالة في النار ، أتتكم الساعة بغتة ، بعثت أنا والساعة هاكذا ، صبحتكم الساعة ومستكم ، أنا أولى بكل مؤمن من نفسه ، من ترك مالا فلأهله ، ومن ترك دينا أو ضياعا فالي وعلي ، وأنا ولي المؤمنين ) )(@)(@@) ( حم م ن ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4450 ) قال النبي :(@)(@@) | 30 ( أما بعد : فإن أصدق الحديث كتاب الله تعالى ، وأوثق العرى كلمة التقوى ، وخير الملل ملة إبراهيم ، وخير السنن سنة محمد ، وأشرف الحديث ذكر الله ، وأحسن القصص هاذا القرآن ، وخير الأمور عوازمها ، وشر الأمور محدثاتها ، وأحسن الهدي هدي الأنبياء ، وأشرف الموت قتل الشهداء ، وأعمى العمى الضلالة بعد الهدى ، وخير 
ms472	 العلم ما نفع ، وخير الهدى ما اتبع ، وشر العمى عمى القلب ، واليد العليا خير من اليد السفلى ، وما قل وكفى خير مما كثر وألهى ، وشر المعذرة حين يحضر الموت ، وشر الندامة يوم القيامة ، ومن الناس من لا يأتي الصلاة إلا دبرا ، ومنهم من لا يذكر الله إلا هجرا ، وأعظم الخطايا اللسان الكذوب ، وخير الغنى غنى النفس ، وخير الزاد التقوى ، ورأس الحكمة مخافة الله ، وخير ما وقر في القلوب اليقين ، والإرتياب من الكفر ، والنياحة من عمل الجاهلية ، والغلول من حثا جهنم ، والكنز كي من النار ، والشعر من مزامير إبليس ، والخمر جماع الإثم ، والنساء حبالة الشيطان ، والشباب شعبة من الجنون ، وشر المكاسب كسب الربا ، وشر المآكل مال اليتيم ، والسعيد من وعظ بغيره ، والشقي من شقي في بطن أمه ، وإنما يصير أحدكم إلى موضع أربع أذرع ، والأمر بآخره ، وملاك العمل خواتمه ، وشر الروايا روايا الكذب ، وكل ما هو آت قريب ، وسباب المؤمن فسوق ، وقتال المؤمن كفر ، وأكل لحمه من معصية الله ، وحرمة ماله كحرمة دمه ، ومن يتأل على الله يكذبه ، ومن يغفر يغفر الله له ، ومن يعف يعف الله عنه ، ومن يكظم الغيظ يأجره الله ، ومن يصبر على الرزية يعوضه الله ، ومن يتبع السمعة يسمع الله به ، ومن يصبر يضعف الله له ، ومن PageV02P141 يعص الله يعذبه الله ، اللهم اغفر لي ولامتي ، اللهم اغفر لي ولأمتي ، اللهم اغفر لي ولأمتي ، أستغفر الله لي ولكم ) )(@)(@@) ( البيهقي في الدلائل وابن عساكر ) عن عقبة بن عامر الجهني أبو نصر السجزي في الإبانة عن أبي الدرداء ( ش ) عن ابن مسعود رضي الله عنهم موقوفا .(@)(@@)(@@)(@@) $ ( 4451 ) قال النبي :(@)(@@) | 30 ( أما بعد : فإن الدنيا خضرة حلوة ، وإن الله مستخلفكم فيها فناظر كيف تعملون ، فاتقوا الدنيا واتقوا النساء ، فإن أول فتنة بني إسرائيل كانت في النساء ، ألا إن بني آدم خلقوا على طبقات شتى ، منهم من يولد مؤمنا ويموت ويحيا مؤمنا ويموت مؤمنا ، ومنهم من يولد كافرا ويحيا كافرا ويموت كافرا ، ومنهم من يولد مؤمنا ويحيا مؤمنا ويموت كافرا ، ومنهم من 
ms473	 يولد كافرا ويحيا كافرا ويموت مؤمنا ، ألا إن الغضب جمرة توقد في جوف ابن آدم ، ألا ترون إلى حمرة عينيه ، وانتفاخ أوداجه ، فإذا وجد أحدكم شيئا من ذالك فالأرض الأرض ، ألا إن خير الرجال من كان بطيء الغضب سريع الرضا ، وشر الرجال من كان سريع الغضب بطيء الرضا ، فإذا كان الرجل بطيء الغضب بطيء الفيء ، وسريع الغضب سريع الفيء فإنها بها ، ألا إن خير التجار من كان حسن القضاء حسن الطلب ، وشر التجار من كان سيىء القضاء سيىء الطلب ، فإذا كان الرجل حسن القضاء سيىء الطلب ، أو كان سيىء القضاء حسن الطلب فإنها بها ، ألا إن لكل غادر لواء يوم القيامة بقدر غدرته ، ألا وأكبر الغدر غدر أمير عامة ، لا يمنعن رجلا مهابة الناس أن يتكلم بالحق إذا علمه ، ألا وإن أفضل الجهاد كلمة حق عند سلطان جائر ، ألا إن مثل ما بقي من الدنيا فيما مضى منها مثل ما بقي من يومكم هاذا فيما مضى منه ) )(@)(@@) ( حم ت ك هب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4452 ) قال النبي :(@)(@@) | 30 ( أما بعد : فإن الله أنزل في كتابه يا أيها الناس اتقوا PageV02P142 ربكم الذي خلقكم من نفس واحدة إلى آخر الآية . . . يا أيها الذين آمنوا اتقوا الله ولتنظر نفس ما قدمت لغد إلى قوله : هم الفائزون ، تصدقوا قبل أن لا تصدقوا ، تصدق رجل من ديناره ، تصدق رجل من درهمه ، تصدق رجل من بره ، تصدق رجل من تمره ، من شعيره ، لا تحقرن شيئا من الصدقة ولو بشق تمرة ) )(@)(@@) ( م ) عن جرير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4453 ) قال النبي :(@)(@@) | 30 ( أما بعد : فإنه لم ييخف علي شأنكم الليلة ، ولاكني خشيت أن يفرض عليكم صلاة الليل فتعجزوا عنها ) )(@)(@@) ( م ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4454 ) قال النبي :(@)(@@) | 30 ( أما بعد : فإني أمرت بسد هاذه الأبواب غير باب علي ، فقال فيه قائلكم ، وإني والله ما سددت شيئا ولا فتحته ، ولاكن أمرت بشيء فاتبعته ) )(@)(@@) ( حم ) و الضياء عن زيد بن أرقم رضي الله عنه 
ms474	 ( ز ) .(@)(@@)(@@)(@@) $ ( 4455 ) قال النبي :(@)(@@) | 30 ( أما بعد : فما بال أقوام يشترطون شروطا ليست في كتاب الله ، ما كان من شرط ليس في كتاب الله فهو باطل ، وإن كان مائة شرط ، قضاء الله أحق ، وشرط الله أوثق ، وإنما الولاء لمن أعتق ) )(@)(@@) ( ق 4 ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4456 ) قال النبي :(@)(@@) | 30 ( أما بعد : فما بال العامل نستعمله فيأتينا فيقول : هاذا من عملكم ، وهاذا أهدي إلي ، أفلا قعد في بيت أبيه وأمه فينظر هل يهدى له أم لا ؟ فوالذي نفس محمد بيده لا يغل أحدكم منها شيئا ألا جاء به يوم القيامة يحمله على عنقه ، إن كان بعيرا جاء به له رغاء ، وإن كانت بقرة جاء بها لها خوار ، وإن كانت شاة جاء بها تيعر ، فقد بلغت ) )(@)(@@) ( حم ق د ) عن أبي حميد الساعدي رضي الله عنه .(@)(@@) PageV02P143(@)(@@)(@@)(@@) $ ( 4457 ) قال النبي :(@)(@@) | 30 ( أما بعد : فوالله إني لاعطي الرجل وأدع الرجل ، والذي أدع أحب إلي من الذي أعطي ، ولاكني أعطي أقواما لما أرى في قلوبهم من الجزع والهلع ، وأكل أقواما إلى ما جعل الله في قلوبهم من الغنى والخير ، منهم ع| مرو بن تغلب ) )(@)(@@) ( خ ) عن عمرو بن تغلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4458 ) قال النبي :(@)(@@) | 30 ( أما بعد : يا معشر قريش فإنكم أهل هاذا الأمر ما لم تعصوا الله ، فإذا عصيتموه بعث عليكم من يلحاكم كما يلحى هاذا القضيب ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4459 ) قال النبي :(@)(@@) | 30 ( أما حسن فله هيبتي وسؤددي ، وأما حسين فإن له جرأتي وجودي ) )(@)(@@) ( طب ) عن فاطمة الزهراء رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4460 ) قال النبي :(@)(@@) | 30 ( أما خروجك من بيتك تؤم البيت الحرام فإن لك بكل وطأة تطؤها راحلتك يكتب الله لك بها حسنة ويمحو عنك بها سيئة ، وأما وقوفك بعرفة فإن الله عز وجل ينزل إلى السماء الدنيا فيباهي بهم الملائكة فيقول : هاؤلاء عبادي جاؤوني شعثا غبرا من كل فج عميق يرجون رحمتي ويخافون عذابي ولم يروني ، فكيف لو رأوني ، فلو كان عليك مثل 
ms475	 رمل عالج ، أو مثل أيام الدنيا ، أو مثل قطر السماء ذنوبا غسلها الله عنك ، وأما رميك الجمار فإنه مدخور لك ، وأما حلقك رأسك فإن بكل شعرة تسقط حسنة ، فإذا طفت بالبيت خرجت من ذنوبك كيوم ولدتك أمك ) )(@)(@@) ( هب طب ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4461 ) قال النبي :(@)(@@) | 30 ( أما صلاة الرجل في بيته تطوعا فنور ، فنور بيتك ما استطعت ، وأما الحائض فلك ما فوق الإزار من الضم والتقبيل ، ولا تطلع على ما تحته ، وأما الغسل من الجنابة فتفرغ بيمينك على شمالك ، ثم تدخل يدك في الإناء فتغسل فرجك وما أصابك ، ثم تتوضا وضوءك للصلاة ، ثم تفرغ على رأسك ثلاثا PageV02P144 تدلك رأسك كل مر ة ، ثم أفض على جسدك ، ثم تنح عن مغتسلك فاغسل رجليك ) )(@)(@@) ( عب طس ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4462 ) قال النبي :(@)(@@) | 30 ( أما صلاة الرجل في بيته فنور ، فنوروا بها بيوتكم ) )(@)(@@) ( حم ه ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4463 ) قال النبي :(@)(@@) | 30 ( أما فتنة الدجال فإنه لم يكن نبي إلا قد حذر أمته ، وساحذركموه بحديث لم يحذره نبي أمته : إنه أعور ، وإن الله ليس بأعور ، مكتوب بين عينيه كافر يقرأه كل مؤمن ، وأما فتنة القبر فبي تفتنون ، وعني تسألون ، فإذا كان الرجل الصالح أجلس في قبره غير فزع ثم يقال له : ما هاذا الرجل الذي كان فيكم ؟ فيقول : محمد رسول الله جاءنا بالبينات من عند الله فصدقناه ، فيفرج له فرجة قبل النار فينظر إليها يحظم بعضها بعضا ، فيقال له : أنظر إلى ما وقاك الله ، ثم يفرج له فرجة إلى الجنة فينظر إلى زهرتها وما فيها ، فيقال له : هاذا مقعدك منها ، ويقال له : على اليقين كنت ، وعليه مت ، وعليه تبعث إن شاء الله ، وإذا كان الرجل السوء أجلس في قبره فزعا ، فيقال له : ما كنت تقول ؟ فيقول : لا أدري ، فيقال : ما هاذا الرجل الذي كان فيكم ؟ فيقول : سمعت الناس يقولون قولا فقلت كما قالوا ، فيفرج له فرجة من قبل الجنة فينظر إلى زهرتها وما فيها 
ms476	 ، فيقال له : انظر إلى ما صرف الله عنك ، ثم يفرج له فرجة قبل النار ، فينظر إليها يحطم بعضها بعضا ، ويقال : هاذا مقعدك منها على الشك كنت ، وعليه مت ، وعليه تبعث إن شاء الله ثم يعذب ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4464 ) قال النبي :(@)(@@) | 30 ( أما في ثلاثة مواطن فلا يذكر أحد أحدا : عند الميزان حتى يعلم أيخف ميزانه أم يثقل ، وعند الكتاب حين يقال : هااؤم اقرؤوا كتابيه حتى يعلم أين يقع كتابه أفي يمينه أم في شماله أو من وراء ظهره ، وعند PageV02P145 الصراط إذا وضع بين ظهرني جهنم حافتاه كلاليب كثيرة وحسك كثير يحبس الله بها من يشاء من خلقه حتى يعلم أينجو أم لا ) )(@)(@@) ( د ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4465 ) قال النبي :(@)(@@) | 30 ( أما قطع السبيل فإنه لا يأتي عليك إلا قليل حتى يخرج العير إلى مكة بغير خفير ، وأما العيلة فإن الساعة لا تقوم حتى يطوف أحدكم بصدقته ولا يجد من يقبلها منه ، ثم ليقفن أحدكم بين يدي الله ليس ببينه وبينه حجاب ولا ترجمان ، ثم ليقولن له : ألم أوتك مالا ؟ فليقولن : بلى ، ثم ليقولن : ألم أرسل إليك رسولا ؟ فليقولن : بلى ، فينظر عن يمينه فلا يرى إلا النار ، ثم ينظر عن شماله فلا يرى إلا النار ، فليتقين أحدكم النار ولو بشق تمرة ، فإن لم يجد فبكلمة طيبة ) )(@)(@@) ( خ ) عن عدي بن حاتم رضي الله عنه ( ز ) . قال : كنت عند رسول الله فجاءه رجلان : أحدهما يشكو العيلة ، والآخر يشكو قطع السبيل قال : فذكره .(@)(@@)(@@)(@@) $ ( 4466 ) قال النبي :(@)(@@) | 30 ( أما لدنياك فإذا صليت الصبح فقل بعد صلاة الصبح : سبحان الله العظيم وبحمده ، ولا حول ولا قوة إلا بالله ثلاث مرات ، يوقيك الله من بلايا أربع : من الجنون والجذام والعمى والفالج ، وأما لآخرتك فقل : اللهم اهدني من عندك ، وأفض علي من فضلك ، وانشر علي من رحمتك وأنزل علي من بركاتك ، والذي نفسي بيده ، من وافى بهن يوم القيامة لم يدعهن ، ليفتحن له أربعة أبواب من الجنة يدخل من 
ms477	 أيها شاء ) )(@)(@@) ( ابن السني ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4467 ) قال النبي :(@)(@@) | 30 ( أما ما أثنيت فيه على الله فهاته ، وأما ما مدحتني فيه فدعه ) )(@)(@@) الباوردي وابن قانع ( طب ك ض ) عن الأسود بن سريع رضي الله عنه قال : قلت : يا نبي الله إني قلت شعرا أثنيت فيه على الله ومدحتك ، قال فذكره .(@)(@@)(@@)(@@) $ ( 4468 ) قال النبي :(@)(@@) | 30 ( أما ما ذكرت من آنية أهل الكتاب ، فإن وجدتم PageV02P146 غيرها فلا تأكلوا فيها ، وإن لم تجدوا غيرها فاغسلوها وكلوا فيها ، وما صدت بقوسك وذكرت اسم الله عليه فكله ، وما صدت بكلبك المعلم وذكرت اسم الله عليه فكل ، وما صدت بكلبك غير المعلم فأدركت ذكاته فكل ) )(@)(@@) ( حم ق ه ) عن أبي ثعلبة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4469 ) قال النبي :(@)(@@) | 30 ( أمامكم حوض كما بين جرباء وأذرح ( 2 ) ) )(@)(@@) ( خد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4470 ) قال النبي :(@)(@@) | 30 ( أمان لامتي من الغرق إذا ركبوا البحر أن يقول : { بسم الله مجريها ومرساها } الآية ، { وما قدروا الله حق قدره } الآية ( ع و ا| بن السني ) عن الحسين رضي الله عنه .(@)(@@)(@@)(@@) $ 4471 قال النبي :(@)(@@) | 30 ( أمان لأهل الأرض من الغرق القريش ، وأمان لأهل الأرض من اختلاف الموالاة لقريش ، قريي أهل الله ، فإذا خالفتها قبيلة من العرب صاروا حزب إبليس ) )(@)(@@) ( طب ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4472 ) قال النبي :(@)(@@) | 30 ( أمثل ما تداويتم به الحجامة والقسط البحري ) )(@)(@@) ( مالك حم ق ت ن ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4473 ) قال النبي :(@)(@@) | 30 ( أمرؤ القيس صاحب لواء الشعراء إلى النار ) )(@)(@@) ( حم عن أبي هريرة رضي الله عنه .(@)(@@) PageV02P147(@)(@@)(@@)(@@) $ ( 4474 ) قال النبي :(@)(@@) | 30 ( أمرؤ القيس قائد الشعراء إلى النار ، لأنه أول من أحكم قوافيها ) )(@)(@@) ( أبو عروبة الحراني في الأوائل كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4475 ) قال النبي :(@)(@@) | 30 ( أمر ابن آدم أن يسجد على سبعة أعظم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4476 ) قال النبي :(@)(@@) | 30 ( أمرا بين أمرين ، وخير الأمور أوسطها ) )(@)(@@) ( ق هب 
ms478	 ) عن عمرو ابن الحارث بلاغا .(@)(@@)(@@)(@@) $ ( 4477 ) قال النبي :(@)(@@) | 30 ( امرأة المفقود امرأته حتى يأتيها البيان ) )(@)(@@) ( قط هق ) و الديلمي عن المغيرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4478 ) قال النبي :(@)(@@) | 30 ( امرأة ولود أحب إلى الله تعالى من امرأة حسناء لا تلد ، إني مكاثر بكم الأمم يوم القيامة ) )(@)(@@) ( ابن قانع ) عن حرملة بن النعمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4479 ) قال النبي :(@)(@@) | 30 ( أمر الله عز وجل بعبد إلى النار فلما وقف على شفيرها التفت فقال : أما والله يا رب إن كان ظني بك لحسن ، فقال الله : ردوه فأنا عند ظن عبدي بي فغفر له ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4480 ) قال النبي :(@)(@@) | 30 ( أمر النساء بأيدي آبائهن ، ورضاؤهن السكوت ) )(@)(@@) ( طب خط ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4481 ) قال النبي :(@)(@@) | 30 ( أمرت الرسل أن لا تأكل إلا طيبا ، ولا تعمل إلا صالحا ) )(@)(@@) ( ك ) عن أم عبد الله بنت أخت شداد بن أوس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4482 ) قال النبي :(@)(@@) | 30 ( أمرت أن أبشر خديجة ببيت في الجنة من قصب لا صخب فيه ولا نصب ) )(@)(@@) ( حم حب ك ) عن عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4483 ) قال النبي :(@)(@@) | 30 ( أمرت أن أسجد على سبعة أعظم : على الجبهة PageV02P148 واليدين والركبتين وأطراف القدمين ، ولا نكفت الثياب ولا الشعر ) )(@)(@@) ( عب ط ق د ن ه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4484 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله وأني رسول اللله ، فإذا قالوهااعصموا مني دماءهم وأموالهم إلا بحقها ، وحسابهم على الله ) )(@)(@@) ( ق 4 ) عن أبي هريرة رضي الله عنه وهو متواتر .(@)(@@)(@@)(@@) $ ( 4485 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله وأني رسول الله ، ويقيموا الصلاة ، ويؤتوا الزكاة ، فإذا فعلوا ذالك عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم على الله عز وجل ) )(@)(@@) ( ق ) عن ابن عمر رضي الله عنهما ( ن ) عن أبي بكرة ( ه ك حل هق ) عن أبي 
ms479	 هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4486 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله ويؤمنوا بي وبما جئت به ، فإذا فعلوا ذالك عصموا مني دماءهم وأموالهم إلا بحقها ، وحسابهم على الله عز وجل ) )(@)(@@) ( م حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4487 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يقولوا لا إلاه إلا الله ، فمن قال لا إلاه إلا الله عصم مني ماله ونفسه إلا بحقه ، وحسابه على الله ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4488 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقرأ القرآن على سبعة أحرف ، كل شاف كاف ) )(@)(@@) ( ابن جرير ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4489 ) قال النبي :(@)(@@) | 30 ( أمرت أن أولي الرؤيا أبا بكر ) )(@)(@@) ( فر ) عن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4490 ) قال النبي :(@)(@@) | 30 ( أمرت بالسواك حتى خشيت أن أدرد وحتى خشيت PageV02P149 على لثتي وأسناني ) )(@)(@@) ( البزار ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4491 ) قال النبي :(@)(@@) | 30 ( أمرت بالسواك حتى خشيت أن يكتب علي ) )(@)(@@) ( حم ) عن واثلة رضي الله عنه وحسن .(@)(@@)(@@)(@@) $ ( 4492 ) قال النبي :(@)(@@) | 30 ( أمرت بالسواك حتى خفت على أسناني ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4493 ) قال النبي :(@)(@@) | 30 ( أمرت بالمساجد جما ( 1 ) ) )(@)(@@) ( هق ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4494 ) قال النبي :(@)(@@) | 30 ( أمرت بالنعلين والخاتم ) )(@)(@@) ( الشيرازي في الألقاب خد خط والضياء ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4495 ) قال النبي :(@)(@@) | 30 ( أمرت بالوتر والضحى ولم يعزم علي ) )(@)(@@) ( عب قط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4496 ) قال النبي :(@)(@@) | 30 ( أمرت بالوتر وركعتي الضحى ولم يكتب عليكم ) )(@)(@@) ( حم ) و محمد بن نصر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4497 ) قال النبي :(@)(@@) | 30 ( أمرت بحب أربعة من أصحابي وأخبرني الله أنه يحبهم : علي ، وأبو ذر الغفاري ، وسلمان الفارسي ، والمقداد بن الأسود ) )(@)(@@) ( الروياني ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4498 ) قال النبي :(@)(@@) | 30 ( أمرت بركعتي الضحى ولم تؤمروا بها ، وأمرت بالأضحى ولم يكتب ) )(@)(@@) ( حم ) عن ابن عباس 
ms480	 رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4499 ) قال النبي :(@)(@@) | 30 ( أمرت بقرية تأكل القرى يقولون يثرب ، وهي المدينة PageV02P150 تنفي الناس كما ينفي المير خبث الحديد ) )(@)(@@) ( حم حب ق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4500 ) قال النبي :(@)(@@) | 30 ( أمرت بهدم الطبل والمزمار ) )(@)(@@) ( ق ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4501 ) قال النبي :(@)(@@) | 30 ( أمرت بيوم الأضحى عيدا جعله الله لهاذه الأمة ) )(@)(@@) ( حم د ن ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4502 ) قال النبي :(@)(@@) | 30 ( أمر جبريل أن ينزل بياقوتة من الجنة ، فهبط بها فمسح بها رأس آدم فتناثر الشعر منه فحيث بلغ نورها صار حرما ) )(@)(@@) ( خط ) عن جعفر بن محمد معضلا ( ز ) .(@)(@@)(@@)(@@) $ ( 4503 ) قال النبي :(@)(@@) | 30 ( أمر الدم بما شئت واذكر اسم الله عز وجل ) )(@)(@@) ( ط حم د ه ك هق ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4504 ) قال النبي :(@)(@@) | 30 ( أمركن مما يهمني بعدي ، ولن يصبر عليكن إلا الصابرون ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 4505 ) قال النبي :(@)(@@) | 30 ( أمرت باسباغ الوضوء ) )(@)(@@) ( الدارمي ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4506 ) قال النبي :(@)(@@) | 30 ( أمرنا بالتسبيح في أدبار الصلوات ثلاثا وثلاثين تسبيحة ، وثلاثا وثلاثين تحميدة ، وأربعا وثلاثين تكبيرة ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4507 ) قال النبي :(@)(@@) | 30 ( أمرني جبريل أن أكبر ) )(@)(@@) ( الحكيم حل ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4508 ) قال النبي :(@)(@@) | 30 ( أمرني جبريل أن لا أنام إلا على قراءة حم السجدة ، PageV02P151 وتبارك الذي بيده الملك ) )(@)(@@) ( فر ) عن علي بن أبي طالب وأنس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 4509 ) قال النبي :(@)(@@) | 30 ( أمرني جبريل بالسواك حتى ظننت أني سأدرد ) )(@)(@@) ( طب طس ) عن سهل بن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4510 ) قال النبي :(@)(@@) | 30 ( أمرني جبريل برفع الصوت في الإهلال فإنه من شعار الحج ) )(@)(@@) ( حم هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4511 ) قال النبي :(@)(@@) | 30 ( إمسح رأس اليتيم هاكذا إلى مقدم رأسه ، ومن له أب هاكذا إلى مؤخر رأسه ) )(@)(@@) ( خط و ابن عساكر ) عن 