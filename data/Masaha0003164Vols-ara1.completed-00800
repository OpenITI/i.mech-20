(@)(@)(@@)(@@)(@@) $ الرضي:(@)(@)(@@) -الحسن بن محمد بن محمد بن محمد بن محمد.(@)(@)(@@)(@@)(@@) $ رضي الدين:(@)(@)(@@) -الحسن بن عبد الله بن محمد بن علي.(@)(@)(@@)(@@)(@@) $ رضي الدين: -علي بن أحمد بن يحيى...(@)(@)PageV05P079(@)(@)(@@)(@@)(@@) $ رضي الدين: -علي بن عبد الكريم بن أحمد بن طاوس.(@)(@)(@@)(@@)(@@) $ رضي الدين: -علي بن محمد بن عبد الحميد النيلي.(@)(@)(@@)(@@)(@@) $ رضي الدين: -علي بن يوسف بن علي الحلي.(@)(@)(@@)(@@)(@@) $ رضي الدين: -محمد بن الحسن بن علي بن محمد الزرقني (سركاني) .(@)(@)(@@)(@@)(@@) $ رضي الدين ابن قتادة.(@)(@)(@@) سيد من مشايخ النسابة جمال الدين أحمد بن علي بن الحسن بن علي بن المهنا المعروف بابن عنبة الأصغر، صاحب «عمدة الطالب» (ذ 15: 336-339) كما أورد ذكره في الكتاب. 
ms797	 ويأتي في ترجمة يوسف بن ناصر بن محمد أنه يروي عن حسين بن قتادة بن روح الحسني المدني.(@)(@)(@@)(@@)(@@) $ الرضي بن محمد بن محمد.(@)(@)(@@) كمال الدين الآوي الحسيني، كان من مشائخ تاج الدين محمد بن القاسم بن معية (م 776) ذكره في إجازته لشمس الدين محمد بن أحمد بن أبي المعالي الموسوي. والظاهر أن اسمه الحسن بن محمد بن محمد الآوي كما وقع في إجازته للشهيد المندرجة في «الإجازة الكبيرة لصاحب المعالم» المسطورة في «البحار» ، وأن الرضي وصف له. ويظهر من «الروضات» أن في نسخته «المرتضي» بدل «الرضي» . وبالجملة فاسمه الحسن كما مر في ص 49-50.(@)(@)(@@)(@@)(@@) $ ركن الدين:(@)(@)(@@) -أحمد بن محمد بن أحمد بن محمد البيابانكي.(@)(@)(@@)(@@)(@@) $ ركن الدين: -الأوحدي المراغي الأصفهاني.(@)(@)(@@)(@@)(@@) $ ركن الدين: -الحسن بن محمد بن شرفشاه.(@)(@)(@@)(@@)(@@) $ ركن الدين: -الحسين بن عالم بن محمد.(@)(@)(@@)(@@)(@@) $ ركن الدين: -محمد بن علي بن محمد الجرجاني.(@)(@)(@@)(@@)(@@) $ ركن الدين: -محمد بن نظام الدين اليزدي.(@)(@)PageV05P080(@)(@)(@@)(@@)(@@) $ الرميلي (1) :(@)(@)(@@) -علي بن أحمد...(@)(@)(@@)(@@)(@@) $ روبال (ابن... ) :(@)(@)(@@) -محمد بن شمس الدين...(@)(@)(@@)(@@)(@@) $ روزبه (ابن... ) :(@)(@)(@@) -عبد الله بن فضل الله بن عبد الله...(@)(@)(@@)(@@)(@@) $ الروياني (2) :(@)(@)(@@) -أبو المحاسن الجرجاني.(@)(@)(@@)(@@)(@@) $ الرياحي:(@)(@)(@@) حمد الله المستوفي.(@)(@)(@@)(@@)(@@) $ الريني:(@)(@)(@@) محمد بن الحسين بن علي بن القاسم.(@)(@)PageV05P081(@)(@)(@@)(@@)(@@) || «ز»(@)(@)(@@)(@@)(@@) $ الزاهد:(@)(@)(@@) -ابراهيم بن الحسين بن علي.(@)(@)(@@)(@@)(@@) $ الزاهد: -أحمد بن ابراهيم بن الحسين الكرواني.(@)(@)(@@)(@@)(@@) $ الزاهد: -بدر الدين الناوندي.(@)(@)(@@)(@@)(@@) $ الزاهد: -الحسن بن علي بن الحسن الطبري.(@)(@)(@@)(@@)(@@) $ الزاهد: -الحسن الكرماني الكيمياوي.(@)(@)(@@)(@@)(@@) $ الزاهد: -الحسين بن ابراهيم بن يحيى.(@)(@)(@@)(@@)(@@) $ الزاهد: -حيدر بن علي بن محمد بن ابراهيم.(@)(@)(@@)(@@)(@@) $ الزاهد: -عبد علي بن نجدة.(@)(@)(@@)(@@)(@@) $ الزاهد: -علي بن بشارة.(@)(@)(@@)(@@)(@@) $ الزاهد: -علي بن الحسين بن حماد الليثي.(@)(@)(@@)(@@)(@@) $ الزاهد: -علي بن محمد الرشيدي الآوي.(@)(@)(@@)(@@)(@@) $ الزاهد: -علي بن يحيى بن حماد.(@)(@)(@@)(@@)(@@) $ الزاهد: -محمد بن اسحاق الدمشتكي.(@)(@)(@@)(@@)(@@) $ الزرقني(@)(@)(@@) (-الزرقاني-السرقني-السركاني)(@)(@)(@@) -محمد بن الحسن بن علي بن محمد...(@)(@)PageV05P082(@)(@)(@@)(@@)(@@) $ زمان (ابن... ) :(@)(@)(@@) -عبد الله بن علي بن سعيد.(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) :(@)(@)(@@) -أحمد بن محمد بن ابراهيم بن محمد بن علي بن الحسن...(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) : -الحسن بن علي بن الحسن.(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) : -الحسن بن محمد بن ابراهيم بن محمد بن علي بن الحسن 
