ms501	 عبد الله المزني(@)(@@)(@@)(@@) $ 1888 - بكر بن قيس أبو الصديق الناجي البصري يروي عن أبي سعيد الخدري روى عنه ثابت البناني مات سنة ثمان ومائة وقد قيل بكر بن عمرو(@)(@@)(@@)(@@) $ 1889 - بكر بن أبي الفرات مولى أشجع يروي عن أبي هريرة روى PageV04P074 عنه يحيى بن سعيد الأنصاري(@)(@@)(@@)(@@) $ 1890 - بكر بن زرعة الخولاني الشامي يروي عن أبي عنبة الخولاني روى عنه الجراح بن مليح البهراني الصوفي قال ثنا الهيثم بن خارجة قال ثنا الجراح بن مليح البهراني قال سمعت بكر بن زرعة الخولاني قال سمعت أبا عنبة الخولاني وهو من أصحاب النبي صلى الله عليه وسلم ممن صلى القبلتين كلتيهما وأكل الدم في الجاهلية يقول سمعت رسول الله صلى الله عليه وسلم يقول لا يزال الله يغرس في هذا الدين غرسا يستعملهم بطاعته(@)(@@)(@@)(@@) $ 1891 - بكر بن قرواش يروي عن أبي الطفيل روى عنه قتادة(@)(@@)(@@)(@@) $ 1892 - بكر بن عبد الرحمن المزني يروي عن عبد الله بن عمرو بن هلال PageV04P075 المزني وله صحبة روى عنه جعفر بن ربيعة وكثير بن عبد الله(@)(@@)(@@)(@@) $ 1893 - بكر بن سوادة الجذامي يروي عن عبد الله بن عمرو عداده في أهل مصر روى عنه أهلها مات في زمن هشام بن عبد الملك(@)(@@)(@@)(@@) $ 1894 - بكير بن عطاء الليثي كوفي يروي عن عبد الرحمن بن يعمر الدئلي وله صحبة روى عنه الثوري(@)(@@)(@@)(@@) $ 1895 - بكير بن الأخنس يروي عن أنس بن مالك روى عنه مسعر بن كدام إن كان سمع منه(@)(@@)(@@)(@@) $ 1896 - بكير بن فيروز يروي عن أبي هريرة روى عنه يزيد بن سنان PageV04P076(@)(@@)(@@)(@@) $ 1897 - بكير بن وهب الجزري يروي عن أنس بن مالك روى عنه سهل أبو أسد الحنفي(@)(@@)(@@)(@@) $ 1898 - بكار بن سلام الغنوي ويقال العتري يروي عن على روى عنه محمد بن قيس(@)(@@)(@@)(@@) $ 1899 - بكار بن عثمان يروي عن جابر بن عبد الله روى عنه موسى بن شيبة(@)(@@)(@@)(@@) $ 1900 - البراء بن قيس أبو كبشة السكوني عداده في أهل الكوفة يروي عن حذيفة وسعد روى عنه الناس(@)(@@)(@@)(@@) $ 1901 - البراء بن ناجية 
ms502	 الكاهلى يروي عن بن مسعود روى عنه بن عيينة(@)(@@)(@@)(@@) $ 1902 - البراء بن زيد بن ابنة أنس بن مالك روى عنه عبد الكريم PageV04P077(@)(@@)(@@)(@@) $ 1903 - البراء السليطي يروي عن نقادة الأسدي عداده في البصريين روى عنه سيار بن سلامة(@)(@@)(@@)(@@) $ 1904 - البخترى بن المختار يروي عن على روى عنه وكيع بن الجراح(@)(@@)(@@)(@@) $ 1905 - البخترى بن أبي البخترى يروي المراسيل روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 1906 - البخترى بن عزرة يروي عن عمر بن الخطاب روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 1907 - البخترى الأنصاري يروي عن براء بن عازب روى عنه الثوري(@)(@@)(@@)(@@) $ 1908 - بسر بن سعيد مولى الحضرميين من أهل المدينة يروي عن أبي هريرة وزيد بن خالد وقد جالس سعد بن أبي وقاص روى عنه يزيد بن PageV04P078 خصيفة وأهل المدينة مات سنة مائة وهو بن ثمان وسبعين سنة وكان ينزل في دار الحضرميين في جديلة فنسب إليهم وكان متعبدا متخليا مات ولم يخلف كفنا يكفن به حتى كفنه الناس(@)(@@)(@@)(@@) $ 1909 - بسر بن محجن الديلي يروي عن أبيه عداده في أهل الحجاز روى عنه زيد بن أسلم ومن قال بشر فقد وهم(@)(@@)(@@)(@@) $ 1910 - بيان بن بشر الأحمسي كنيته أبو بشر المعلم من أهل الكوفة يروي عن أنس بن مالك روى عنه الثوري وشعبة والناس(@)(@@)(@@)(@@) $ 1911 - بيان بن جندب أبو سعيد الرقاشي البصري يروي عن أنس بن مالك روى عنه شعبة والمعتمر بن سليمان يخطىء(@)(@@)(@@)(@@) $ 1912 - بلاد بن عصمة يروي عن بن مسعود شر الأمور محدثاتها PageV04P079 روى عنه أسلم المنقري(@)(@@)(@@)(@@) $ 1913 - باباه يروي عن عمر بن الخطاب روى عنه ابنه عبد الله بن باباه(@)(@@)(@@)(@@) $ 1914 - البهي شيخ يروي عن عمر روى عنه ابنه يحيى بن البهي(@)(@@)(@@)(@@) $ 1915 - بيهس بن صبيرة يروي عن أبي هريرة روى عنه العرس بن عميرة PageV04P080(@)(@@)(@@)(@@) $ 1916 - برد مولى آل الزبير بن العوام يروي عن بن الزبير روى عنه جويرية بن أسماء(@)(@@)(@@)(@@) $ 1917 - باب بن عمير الحنفي من أهل اليمامة يروي عن أنس بن مالك روى عنه يحيى بن أبي كثير والأوزاعي وليس 
ms503	 هو بجد عمرو بن عبيد(@)(@@)(@@)(@@) $ 1918 - بسطام شيخ يروي عن بن عمر روى عنه بن عون(@)(@@)(@@)(@@) $ 1919 - بريدة بن سفيان الأسلمى يروى قصة زيد بن الدثنة وخبيب بن عدى روى عنه عبد الرحمن بن عبد الله الزهري وقد قيل إن له صحبه(@)(@@)(@@)(@@) $ 1920 - بحير بن ريسان يروي عن عبادة بن الصامت روى عنه أبو سفيان رجل من أهل الشام(@)(@@)(@@)(@@) $ 1921 - بحير بن ذاخر يروي عن عبد الله بن عمرو روى عنه بن لهيعة(@)(@@)(@@)(@@) $ 1922 - بحير بن أوس يروي المراسيل روى عنه محمد بن سيرين PageV04P081(@)(@@)(@@)(@@) $ 1923 - بدر بن خالد كوفي يروي عن عثمان بن عفان روى عنه أبو الجويرية(@)(@@)(@@)(@@) $ 1924 - بجير بن أبي بجير حجازي يروي عن عبد الله بن عمرو روى عنه إسماعيل بن أمية(@)(@@)(@@)(@@) $ 1925 - بجير بن سالم أبو عبيد يروي عن بن عمر روى عنه يعلى بن عطاء(@)(@@)(@@)(@@) $ 1926 - بجير بن أحمر يروي عن بن عباس روى عنه الجريري وعمران بن حدير(@)(@@)(@@)(@@) $ 1927 - بريد بن أبي مريم السلولي واسم أبي مريم مالك بن ربيعة يروي عن أنس روى عنه أبو إسحاق وشعبة(@)(@@)(@@)(@@) $ 1928 - بريد بن أصرم يروي عن على روى عنه جعفر بن سليمان PageV04P082 الضبعي عن شيخ له عنه(@)(@@)(@@)(@@) $ 1929 - بكتل الخولاني بصرى يروي عن بن عمر روى عنه عمرو بن الحارث(@)(@@)(@@)(@@) $ 1930 - بأبي مولى عباس بن عبد المطلب يروي عن العباس روى عنه القاسم بن العباس(@)(@@)(@@)(@@) $ 1931 - بأبي أبو عبد الله مولى عائشة يروي عن سعد بن أبي وقاص وعائشة روى عنه ابنه عبد الله بن بأبي(@)(@@)(@@)(@@) $ 1932 - بديح مولى عبد الله بن جعفر يروي عن عبد الله بن جعفر روى عنه عيسى بن عمر بن موسى(@)(@@)(@@)(@@) $ 1933 - بجالة بن عبد ويقال بن عبدة كان كاتبا لجزى بن معاوية يروي عن عمران بن حصين روى عنه عمرو بن دينار PageV04P083(@)(@@)(@@)(@@) $ 1934 - بركة بن الوليد أبو الوليد المجاشعي يروي عن بن عباس روى عنه خالد الحذاء(@)(@@)(@@)(@@) $ 1935 - برير بن ضمرة الباهلى يروي عن بن عباس روى عنه حاتم بن 
ms504	 أبي صغيرة ومن زعم أنه بريد فقد وهم(@)(@@)(@@)(@@) $ 1936 - بركان أبو صالح مولى عثمان بن عفان يروي عن أبي هريرة روى عنه أبو عقيل(@)(@@)(@@)(@@) $ 1937 - بعجة بن عبد الله بن بدر الجهني يروي عن أبي هريرة روى عنه يحيى بن أبي كثير وأبو حازم وكان يقيم مدة بالبادية ومدة بالمدينة ومات بالمدينة قبل القاسم بن محمد سنة مائة(@)(@@)(@@)(@@) $$ 1938 - بكرة بنت عقبة تروى عن عائشة روى عنها معلى بن زياد القطعي PageV04P084(@)(@@)(@@)(@@) || (باب التاء)(@)(@@) قال أبو حاتم وممن روى عن الصحابة من التابعين ممن ابتدأ اسمه على التاء(@)(@@)(@@)(@@) $ 1939 - تمام بن العباس بن عبد المطلب الهاشمي يروي عن أبيه روى عنه ابنه جعفر بن تمام(@)(@@)(@@)(@@) $ 1940 - تميم بن طرقة الطائي الكوفي المسلي يروي عن عدى بن حاتم وجابر بن سمرة روى عنه سماك بن حرب والمسيب بن رافع مات سنة ثلاث أو أربع وتسعين(@)(@@)(@@)(@@) $ 1941 - تميم بن حذلم الضبي كنيته أبو سلمة من أهل الكوفة يروي عن أبي بكر وعمر روى عنه العلاء بن بدر وقد قيل كنيته أبو حذلم(@)(@@)(@@)(@@) $ 1942 - تميم بن نذير العدوى أبو قتادة البصري يروي عن عمر بن الخطاب روى عنه حميد بن هلال(@)(@@)(@@)(@@) $ 1943 - تميم بن مسيح الذهلي الغطفاني يروي عن على روى عنه الناس PageV04P085(@)(@@)(@@)(@@) $ 1944 - تميم بن غيلان بن سلمة الثقفي يروي عن عبد الرحمن بن عوف وأبي الدرداء روى عنه بن جريج ويعلى بن عطاء(@)(@@)(@@)(@@) $ 1945 - تميم بن سلمة الكوفي السلمي وقيل الخزاعي يروي عن عبد الله بن الزبير روى عنه الأعمش مات سنة مائة في خلافة عمر بن عبد العزيز وهو الذي يروي عن عبد الرحمن بن هلال عن جرير(@)(@@)(@@)(@@) $ 1946 - تميم بن سلمة الخزاعي كوفي يروي عن جابر بن سمرة روى عنه المسيب بن رافع وهو الذي يروي عن عروة بن الزبير وليس هذا بالأول(@)(@@)(@@)(@@) $ 1947 - تميم بن حويص الأزدي يروي عن بن عباس عداده في أهل البصرة روى عنه شعبة بن الحجاج(@)(@@)(@@)(@@) $ 1948 - تميم بن عبد الله البصري يروي عن أبي 
ms505	 ذر روى عنه ابنه شريك بن تميم PageV04P086(@)(@@)(@@)(@@) $ 1949 - تميم بن فرع المهري من أهل مصر يروي عن عمرو بن العاص روى عنه حرملة بن عمران(@)(@@)(@@)(@@) $ 1950 - تميم بن محمود يروي عن عبد الرحمن بن شبل روى عنه جعفر بن عبد الله بن الحكم والد عبد الحميد بن جعفر(@)(@@)(@@)(@@) $ 1951 - تميم بن عبد الرحمن يروي عن عدى بن حاتم روى عنه أرطأة بن الحسين الهنائي وقد قيل إنه تميم بن عبد المؤمن(@)(@@)(@@)(@@) $ 1952 - تميم بن مسيح الغطفاني يروي عن علي بن أبي طالب روى عنه ذهل بن أوس(@)(@@)(@@)(@@) $ 1953 - تميم بن يزيد مولى بنى زمعة يروي عن أنس بن مالك روى عنه عثمان بن حكيم(@)(@@)(@@)(@@) $ 1954 - تميم بن أوس الأشعري يروي عن عبد الله بن بسر روى عنه أهل الشام مات في ولاية هشام بن عبد الملك PageV04P087(@)(@@)(@@)(@@) $ 1955 - تميم بن ذهل الضبي من بنى مبذول أدرك الجمل روى عنه خالد بن مجاهد بن حيان(@)(@@)(@@)(@@) $ 1956 - تبيع الحجري يروي عن عبد الرحمن بن عدس البلوى وقد قيل عديس وله صحبة روى عنه عبد الرحمن بن شماسة(@)(@@)(@@)(@@) $ 1957 - توبة بن كيسان الباهلي العنبري بصرى يروي عن أنس بن مالك روى عنه شعبة ومطيع بن راشد(@)(@@)(@@)(@@) $ 1958 - تعلى أبو عبيد يروي عن عبد الرحمن بن خالد بن الوليد روى عنه ابنه عبيد بن تعلى من حديث بكير بن الأشج عنه(@)(@@)(@@)(@@) $$ 1959 - تملك الخارفية امرأة تروي عن أم سلمة روى عنها أبو إسحاق السبيعي حدثنا أبو خليفة قال ثنا محمد بن كثير قال ثنا سفيان الثوري عن أبي إسحاق عن تملك الخارفية عن أم سلمة أنها قالت ضع سكينا وسم الله وكل تعني الجنين PageV04P088(@)(@@)(@@)(@@) || (باب الثاء)(@)(@@) قال أبو حاتم وممن روى عن الصحابة وشافههم من التابعين ممن ابتدأ اسمه على الثاء(@)(@@)(@@)(@@) $ 1960 - ثابت بن أسلم البناني البصري أبو محمد يروي عن بن عمر وابن الزبير وصحب أنسا أربعين سنة وكان من أعبد أهل البصرة وبنانة الذي نسب إليه وهو بنانة بن سعد بن لؤي بن 
ms506	 غالب روى عنه الناس مات سنة سبع وعشرين ومائة وهو بن ست وثمانين سنة وقد قيل إنه مات سنة ثلاث وعشرين ومائة ويقال سنة ست وعشرين ومائة(@)(@@)(@@)(@@) $ 1961 - ثابت بن قيس الكوفي يروي عن بن مسعود روى عنه إبراهيم PageV04P089 النخعي وأبو زرعة بن عمرو بن جرير(@)(@@)(@@)(@@) $ 1962 - ثابت بن قيس الزرقي الأنصاري يروي عن أبي هريرة روى عنه الزهري(@)(@@)(@@)(@@) $ 1963 - ثابت بن قيس المدني كنيته أبو الغصن مولى لبني غفار يروي عن أنس بن مالك روى عنه عبد الرحمن بن مهدى(@)(@@)(@@)(@@) $ 1964 - ثابت بن عبد الله بن الزبير يروي عن سعد بن أبي وقاص روى عنه عباد بن إسحاق عن أبيه أمه حنتمة بنت عبد الرحمن بن الحارث بن هشام المخزومي PageV04P090(@)(@@)(@@)(@@) $ 1965 - ثابت بن أبي قتادة السلمي الأنصاري واسم أبي قتادة الحارث بن ربعي يروي عن أبيه روى عنه ابنه مصعب بن ثابت مات في ولاية الوليد بن عبد الملك وكنيته أبو مصعب(@)(@@)(@@)(@@) $ 1966 - ثابت بن السمط بن الأسود بن جبلة بن عدى بن ربيعة أخو شرحبيل بن السمط عداده في أهل الشام يروي عن جماعة من الصحابة روى عنه أهل الشام(@)(@@)(@@)(@@) $ 1967 - ثابت بن عبيد الأنصاري كوفي يروي عن بن عمر وزيد بن PageV04P091 ثابت روى عنه بن سيرين والأعمش وهو مولى زيد بن ثابت(@)(@@)(@@)(@@) $ 1968 - ثابت بن قطبة المزني كوفي يروي عن بن مسعود روى عنه الشعبي وأبو إسحاق(@)(@@)(@@)(@@) $ 1969 - ثابت بن معبد يروي عن عمر بن الخطاب روى عنه عبد الملك بن عمير(@)(@@)(@@)(@@) $ 1970 - ثابت مولى سفيان بن أبي مريم يروي عن معاوية عداده في الشاميين روى عنه أبو بكر بن أبي مريم(@)(@@)(@@)(@@) $ 1971 - ثابت بن سعد الطائفي وقد قيل الطائي يروي عن جابر بن عبد الله ومعاوية روى عنه محمد بن عبد الله بن مهاجر ومحمد بن عمر PageV04P092 المحرمي أخو خالد بن عمر وأهل الشام(@)(@@)(@@)(@@) $ 1972 - ثابت بن مشحل يروي عن أبي هريرة وهو مولاه روي عنه فليح بن سليمان(@)(@@)(@@)(@@) $ 1973 - ثابت بن الأحنف الأعرج مولى عبد 
ms507	 الرحمن بن زيد بن الخطاب القرشي مدني يروي عن أبي هريرة وابن عمر روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 1974 - ثابت بن يزيد الخولاني يروي عن أبي هريرة روى عنه عمرو بن الحارث وخالد بن أبي يزيد(@)(@@)(@@)(@@) $ 1975 - ثابت بن الحجاج يروي عن زيد بن ثابت روى عنه جعفر بن برقان PageV04P093(@)(@@)(@@)(@@) $ 1976 - ثابت بن السمط يروي عن عبادة بن الصامت روى عنه بن محيريز(@)(@@)(@@)(@@) $ 1977 - ثابت بن طريف المرادي يروي عن أبي ذر الغفاري روى عنه أزهر بن عبد الله المرادي(@)(@@)(@@)(@@) $ 1978 - ثابت بن زيد بن أرقم الأنصاري يروي عن أم سلمة روى عنه يزيد بن أبي زياد(@)(@@)(@@)(@@) $ 1979 - ثابت بن مرداس شيخ سمع زيد بن أرقم عند عبيد الله بن زياد روى عنه عبد العزيز بن محمد الدراوردي(@)(@@)(@@)(@@) $ 1980 - ثابت بن أنس بن ظهير الأنصاري المدني يروي المراسيل روى عنه ابنه الحسين بن ثابت(@)(@@)(@@)(@@) $ 1981 - ثابت بن سرج أبو سلمة الدوسي يروي عن واثلة بن الأسقع وبلال روى عنه الوليد بن مسلم PageV04P094(@)(@@)(@@)(@@) $ 1982 - ثابت بن عبيد بن عازب بن أخي البراء بن عازب يروي عن أبيه عن النبي صلى الله عليه وسلم في المستحاضة ولأبيه صحبة روى عنه ابنه عدى(@)(@@)(@@)(@@) $ 1983 - ثابت بن عبيد يروي عن أنس بن مالك روى عنه يزيد بن مردانبه(@)(@@)(@@)(@@) $ 1984 - ثابت مولى أم سلمة يروي عن عمر روى عنه أهل المدينة مات PageV04P095 في خلافة عمر بن الخطاب(@)(@@)(@@)(@@) $ 1985 - ثابت يروى عن بن عباس أنه قرأ السراط روى عنه عمرو بن دينار ولا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 1986 - ثابت بن هريم يروى عن بن أبي طالب روى عنه المغيرة بن مقسم ثنا عمرو بن محمد الهمداني قال ثنا فضل بن سهل الأعرج قال ثنا يحيى بن أبي بكير قال ثنا هشيم قال ثنا مغيرة عن ثابت بن هريم عن علي أنه أمر رجلا أن يصلي بضعفة الناس يوم العيد أربعا وخرج هو إلى الجبانة فصلى بهم ركعتين(@)(@@)(@@)(@@) $ 1987 - ثابت بن الأعرج من أهل 
ms508	 المدينة روى عنه مالك وقد قيل إنه ثابت بن عياض الأحنف الذي روى عنه بن جريج(@)(@@)(@@)(@@) $ 1988 - ثمامة بن عبد الله بن أنس بن مالك الأنصاري قاضي البصرة يروي عن أنس بن مالك روى عنه حماد بن سلمة وعبد الله بن المثنى PageV04P096(@)(@@)(@@)(@@) $ 1989 - ثمامة بن حزن القشيري يروي عن عائشة وقدم على عمر بن الخطاب روى عنه الجريري والأسود بن شيبان وأهل البصرة(@)(@@)(@@)(@@) $ 1990 - ثمامة بن عقبة المحلمى يروي عن زيد بن أرقم عداده في أهل الكوفة روى عنه الأعمش وهارون بن سعد(@)(@@)(@@)(@@) $ 1991 - ثمامة بن شفى أبو على الهمداني الأصبحي يروي عن عقبة بن عامر وفضالة بن عبيد عداده في أهل مصر روى عنه بن إسحاق وعبد الرحمن بن حرملة PageV04P097(@)(@@)(@@)(@@) $ 1992 - ثمامة بن شراحيل يروي عن بن عباس وابن عمر روى عنه يحيى بن قيس الماربي وعبد الله بن خريع بن جمال(@)(@@)(@@)(@@) $ 1993 - ثعلبة بن أبي مالك القرظي المدني كنيته أبو جعفر وقد قيل أبو يحيى وكان إمام بنى قريظة وكان من كندة إلا أنه تزوج امرأة من بنى قريظة وقيل قرظي يروي عن بن عمر روى عنه الزهري وابن الهاد(@)(@@)(@@)(@@) $ 1994 - ثعلبة بن عباد العبدي ويقال الليثي من أهل البصرة يروي عن سمرة بن جندب روى عنه الأسود بن قيس(@)(@@)(@@)(@@) $ 1995 - ثعلبة بن يزيد الكوفي يروي عن على روى عنه حبيب بن أبي ثابت PageV04P098(@)(@@)(@@)(@@) $ 1996 - ثعلبة بن ضبيعة يروي عن حذيفة بن اليمان روى عنه أبو بردة(@)(@@)(@@)(@@) $ 1997 - ثعلبة بن سهل شيخ يروي عن عبد الله بن الحارث بن جزء الزبيدي روى عنه الليث بن سعد(@)(@@)(@@)(@@) $ 1998 - ثعلبة بن مالك أبو بحر البصري مولى أنس بن مالك سكن الكوفة يروي عن أنس بن مالك روى عنه الحسن بن عبيد الله وقد قيل ثعلبة بن عاصم ويقال إنه ثعلبة بن الحكم وهو الذي يروي عن أنس عن النبي صلى الله عليه وسلم أنه قال ما قضى الله لمسلم قضاء إلا كان خيرا له(@)(@@)(@@)(@@) $ 1999 - ثعلبة أبو الكنود الحمراوي يروي 
ms509	 عن عائشة روى عنه سليمان بن أبي زينب(@)(@@)(@@)(@@) $ 2000 - ثعلبة بن مسلم الجهني يروي عن أبي هريرة روى عنه عقيل بن مدرك PageV04P099(@)(@@)(@@)(@@) $ 2001 - ثعلبة بن عاصم يروي عن أنس بن مالك روى عنه عاصم الأحول(@)(@@)(@@)(@@) $ 2002 - ثور بن قدامة يروي عن عمر روى عنه إبراهيم العقيلي قال جاءنا كتاب عمر بن الخطاب(@)(@@)(@@)(@@) $ 2003 - ثور الكندي يروي عن عمر بن الخطاب روى عنه عمرو بن قيس(@)(@@)(@@)(@@) $ 2004 - ثور شيخ يروي عن أبي هريرة أفطر الحاجم والمحجوم روى عنه ابنه شقيق بن ثور(@)(@@)(@@)(@@) $ 2005 - ثوبان بن شهر الأشعري يروي المراسيل عداده في أهل الشام روى عنه أهلها(@)(@@)(@@)(@@) $ 2006 - ثروان بن ملحان التيمي كوفي يروي عن عمار بن ياسر روى عنه سماك بن حرب ومنهم من زعم أنه ملحان بن ثروان(@)(@@)(@@)(@@) $ 2007 - ثميل الأشعري يروي عن أبي الدرداء عداده في أهل الشام روى عنه عمر بن يزيد النصرى PageV04P100(@)(@@)(@@)(@@) $ 2008 - ثويب أبو رشيد الشامي يروي عن أبي هريرة وزيد بن ثابت روى عنه أبو سلمة بن عبد الرحمن(@)(@@)(@@)(@@) || (باب الجيم)(@)(@@) قال أبو حاتم وممن روى عن الصحابة من التابعين وشافههم ممن ابتدأ اسمه على الجيم(@)(@@)(@@)(@@) $ 2009 - جابر بن زيد أبو الشعثاء الأزدي اليحمدي أصله من الجوف ناحية بعمان وكان ينزل البصرة في الأزد في موضع يقال درب الجوف وكانت الإباضية تنتحله وكان هو يتبرأ من ذلك يروى عن بن عباس وابن عمر روى عنه عمرو بن دينار وكان من PageV04P101 أعلم الناس بكتاب الله وكان بن عباس يقول لو أن أهل البصرة نزلوا عند قول جابر بن زيد لأوسعهم علما عما في كتاب الله وكان فقيها مات سنة ثلاث وتسعين ودفن هو وأنس بن مالك في جمعة واحدة وكان أبو الشعثاء أعور(@)(@@)(@@)(@@) $ 2010 - جابر بن جلاس الكلبي يروي عن عمر روى عنه ابنه محمد بن جابر(@)(@@)(@@)(@@) $ 2011 - جابر بن يزيد بن الأسود السوائي يروي عن أبيه روى عنه يعلى بن عطاء(@)(@@)(@@)(@@) $ 2012 - جابر بن قبيصة من بني أسد بن خزيمة يروي عن عمر بن الخطاب 
ms510	 روى عنه محمد بن عبيد الله العرزمي PageV04P102(@)(@@)(@@)(@@) $ 2013 - جابر بن عمرو الراسمي أبو الوازع بصرى يروي عن أبي برزة وعبد الله بن مغفل روى عنه شداد بن سعيد وأبان بن صمعة(@)(@@)(@@)(@@) $ 2014 - جابر بن العلاف يروي عن بن الزبير روى عنه إبراهيم بن المهاجر(@)(@@)(@@)(@@) $ 2015 - جابر الحذاء يروي عن بن عمر روى عنه بن سيرين(@)(@@)(@@)(@@) $ 2016 - جابر النخعي كوفي يروي عن أبي الدرداء روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 2017 - جابر يروي عن علي روى عنه ابنه مزيدة بن جابر(@)(@@)(@@)(@@) $ 2018 - جابر بن آزاد المقراي ومقرا قرية بدمشق يروي عن عمرو البكالي روى صفوان عن أمه عنه(@)(@@)(@@)(@@) $ 2019 - جنادة بن أبي أمية الدوسي واسم أبي أمية كثير يروي عن PageV04P103 عبادة بن الصامت سكن الشام روى عنه أهلها مات سنة سبع وستين وقد قيل إن له صحبة وليس ذلك بصحيح(@)(@@)(@@)(@@) $ 2020 - جعفر بن عمرو بن أمية بن إياس الضمري المدني يروي عن أبيه روى عنه أبو سلمة بن عبد الرحمن والزهري مات سنة خمس وتسعين في ولاية الحجاج وكان جعفر بن عمرو أخا عبد الملك بن مروان من الرضاعة وأمه سخيلة بنت عبيدة بن الحارث بن المطلب PageV04P104(@)(@@)(@@)(@@) $ 2021 - جعفر بن الزبير بن العوام القرشي المدني يروي عن أبيه روى عنه بن أبي ذئب وأم عروة ابنته(@)(@@)(@@)(@@) $ 2022 - جعفر بن المطلب بن أبي وداعة السهمي كنيته أبو كثير يروي عن عمرو بن العاص وأبيه روى عنه عبد العزيز بن رفيع وقد روى بن جريج عن ابنه سعيد بن جعفر عنه وقد روى بن جريج أيضا عن سعيد بن كثير بن المطلب بن أخيه عنه(@)(@@)(@@)(@@) $ 2023 - جعفر بن عياض يروي عن أبي هريرة روى عنه إسحاق بن عبد الله بن أبي طلحة(@)(@@)(@@)(@@) $ 2024 - جعفر بن حذيفة يروي عن علي روى عنه الحسن بن سعد(@)(@@)(@@)(@@) $ 2025 - جعفر بن أبي ثور كنيته أبو ثور واسم أبيه عكرمة يروي PageV04P105 عن جده جابر بن سمرة روى عنه أشعث بن سليم ومحمد بن قيس وعثمان بن عبد الله بن 
ms511	 موهب(@)(@@)(@@)(@@) $ 2026 - جعفر بن عمرو بن حريث المخزومي القرشي الكوفي يروي عن أبيه روى عنه مساور الوراق والمسعودي(@)(@@)(@@)(@@) $ 2027 - جعفر بن خارجة يروي عن أنس بن مالك روى عنه المغيرة بن عبد الرحمن(@)(@@)(@@)(@@) $ 2028 - جعفر بن الفرافصة يروي عن بن عمر روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 2029 - جعفر بن عبد الله بن الحكم بن رافع بن سنان الأنصاري يروي عن أنس بن مالك وعلباء بن أحمر روى عنه سعيد بن أبي هلال وهو والد عبد الحميد بن جعفر الأنصاري ثنا أبو يزيد القرشي خالد بن النضر PageV04P106 بالبصرة قال ثنا محمد بن بشار قال ثنا محمد أبو بكر الحنفي قال ثنا عبد الحميد بن جعفر قال ثنا أبي أنه سمع أنس بن مالك يقول قد أنزل الله الآية التي تحرم الخمر وما بالمدينة شراب يشرب إلا من تمر(@)(@@)(@@)(@@) $ 2030 - جعفر بن جرفاس التيمي يروي عن على روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 2031 - جعفر بن معبد أبو الوليد يروي عن أنس بن مالك روى عنه سلام بن مسكين(@)(@@)(@@)(@@) $ 2032 - جعفر بن محمود بن محمد بن سلمة الأنصاري الحارثي يروي عن جابر بن عبد الله روى عنه إبراهيم بن جعفر وابن أخيه سليمان بن محمد بن محمود(@)(@@)(@@)(@@) $ 2033 - جامع بن شداد أبو صخرة المحاربي كوفي يروي عن طارق المحاربي وله صحبة روى عنه أهل الكوفة مات في شهر رمضان PageV04P107 سنة ثمان عشرة ومائة وقد قيل إنه مات سنة سبع وعشرين ومائة(@)(@@)(@@)(@@) $ 2034 - جرير بن أبي عطاء القرشي مولى بنى زهرة حجازي يروي عن بن عمر روى عنه الزهري عداده في أهل الحجاز(@)(@@)(@@)(@@) $ 2035 - جرير الضبي يروي عن على روى عنه ابنه غزوان بن جرير(@)(@@)(@@)(@@) $ 2036 - جرير بن عتبة يروي عن عبادة بن الصامت روى معاوية بن صالح عن أبي الحكم عنه وقد قيل إنه عتبة بن جرير(@)(@@)(@@)(@@) $ 2037 - جميل النجراني يروي عن حذيفة بن اليمان روى عنه عبد الله بن الحارث(@)(@@)(@@)(@@) $ 2038 - جميل بن سنان يروي عن على روى عنه عبد القاهر(@)(@@)(@@)(@@) $ 2039 
ms512	 - جميل بن بشير يروي عن أبي هريرة روى عنه عمرو بن أبي وهب الخزاعي(@)(@@)(@@)(@@) $ 2040 - جميل يروي عن عمر بن الخطاب روى عنه ابنه جروة PageV04P108(@)(@@)(@@)(@@) $ 2041 - جبلة بن سحيم الكوفي الشيباني كنيته أبو سريرة يروي عن بن عمر روى عنه مسعر وشعبة مات في ولاية هشام بن عبد الملك حين ولى يوسف بن عمر على العراق وهو الذي يقال له جبلة بن صهيب وجبلة بن وهب والصحيح سحيم(@)(@@)(@@)(@@) $ 2042 - جبلة بن حممة يروي عن على روى عنه عبد الله بن بشر الخثعمي(@)(@@)(@@)(@@) $ 2043 - جبلة بن نافع يروي عن عبد الله بن الحارث بن جزء الزبيدي روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 2044 - جبلة بن أبي سليمان أبو عاصم الشقري يروي عن أنس بن مالك روى عنه أبو عاصم النبيل(@)(@@)(@@)(@@) $ 2045 - جبلة بن مطر يروي عن فضالة بن عبيد روى عنه الحسن بن PageV04P109 يحيى الخشني(@)(@@)(@@)(@@) $ 2046 - جندب بن كعب الأزدي قاتل الساحر زمن الوليد بن عقبة يروي المراسيل روى عنه أبو عثمان النهدي(@)(@@)(@@)(@@) $ 2047 - جندب بن سلامة ويقال سلام المدني يروي عن بن عمر روى عنه مسلم بن جندب ثنا عبد الله بن جابر بطرسوس قال ثنا محمد بن يزيد المستملى قال ثنا بن أبي فديك عن بن أبي ذئب عن مسلم بن جندب عن أبيه عن بن عمر قال قال رسول الله صلى الله عليه وسلم ثلاثة لا ترد الطيب والوسادة واللبن(@)(@@)(@@)(@@) $ 2048 - جندب الأزدي يروي عن سلمان روى عنه عبد الله بن شريك(@)(@@)(@@)(@@) $ 2049 - جندب بن الحجاج يروي عن عمران بن حصين روى عنه يوسف بن سعد PageV04P110(@)(@@)(@@)(@@) $ 2050 - جندب بن سليمان البارقي يروي عن بن عباس روى عنه شبيب بن غرقدة(@)(@@)(@@)(@@) $ 2051 - جبير بن نفير بن مالك بن عامر الحضرمي أدرك الجاهلية ولا صحبة له يروي عن أبي ذر وأبي الدرداء روى عنه أهل الشام كنيته أبو عبد الرحمن مات سنة ثمانين بالشام ثنا العباس بن الخليل بن جابر الطائي أبو الخليل بحمص من كتابه قال ثنا نصر بن 
ms513	 خزيمة بن علقمة بن محفوظ بن علقمة الحضرمي قال ثنا أبي عن نضر بن علقمة عن أخيه محفوظ بن علقمة عن بن عابد قال ثنا جبير بن نفير عن عوف بن مالك قال قال رسول الله صلى الله عليه وسلم إن الأنبياء ليتكاثرون بأمتهم وبكثرتهم فإني أرجو أني أكثرهم ولقد أعطي موسى بن عمران خصلات لم يعطهن نبي إنه مكث يناجي ربه أربعين يوما ولا ينبغي لمتناجيين أن يتناجيا أطول من نجواهما(@)(@@)(@@)(@@) $ 2052 - جبير بن حية الثقفي يروي عن المغيرة بن شعبة والنعمان بن مقرن روى عنه ابنه زياد بن جبير PageV04P111(@)(@@)(@@)(@@) $ 2053 - جبير بن شيبة بن عثمان بن عبد الدار خازن الكعبة يروي عن أبيه وله صحبة روى عنه ابنه شيبة بن جبير(@)(@@)(@@)(@@) $ 2054 - جبير بن أبي سليمان بن جبير بن مطعم يروي عن بن عمر روى عنه عبادة بن مسلم(@)(@@)(@@)(@@) $ 2055 - جبير بن الحويرث يروي عن أبي بكر الصديق روى عنه سعيد بن عبد الرحمن بن يربوع(@)(@@)(@@)(@@) $ 2056 - جبير بن أبي صالح يروي عن أبي هريرة روى عنه يزيد بن أبي زياد(@)(@@)(@@)(@@) $ 2057 - جراح بن عبد الله الحكمي أصله من اليمن سكن الشام ولاه بن المهلب على خراسان يروى المراسيل روى عنه بن سيرين(@)(@@)(@@)(@@) $ 2058 - جراح بن الجراح يروي عن بن عباس روى عنه يزيد بن أبي حبيب PageV04P112(@)(@@)(@@)(@@) $ 2059 - جهم بن فضالة يروي عن أبي أمامة روى قزعة بن سويد عن أبيه عنه(@)(@@)(@@)(@@) $ 2060 - جهضم بن الضحاك أبو رؤبة الباهلي يروي عن العداء بن خالد بن هوذة رجل من أصحاب النبي صلى الله عليه وسلم باليمامة روى عنه عبد الصمد بن عبد الوارث وسليم بن الحارث ثنا قيس بن حفص الدارمي ثنا سليم بن الحارث ثنا جهضم بن الضحاك الجهضمي قال قلت لعداء بن خالد بن هوذة رأيت النبي صلى الله عليه وسلم قال نعم وكان حسن السبلة قال وكانت العرب تسمى اللحية السبلة(@)(@@)(@@)(@@) $ 2061 - جهم بن عمرو يروي عن بن مسعود روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 2062 
ms514	 - جهم بن أبي الجهم يروي عن عبد الله بن جعفر والمسور بن مخرمة وهو مولى الحارث بن حاطب القرشي روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 2063 - جهم بن المستمر يروي عن بن عباس روى عنه إبراهيم بن عبد الرحمن المخزومي PageV04P113(@)(@@)(@@)(@@) $ 2064 - جهم بن عبد الرحمن بن موهب يروي عن عبد الله بن جعفر بن أبي طالب روى عنه الوليد بن جميع(@)(@@)(@@)(@@) $ 2065 - جهم بن الأسود يروي عن أبي سعيد الخدري روى عنه عبيد الله بن المغيرة(@)(@@)(@@)(@@) $ 2066 - جارود بن أبي سبرة الهذلي البصري وقد قيل البهدلي يروي عن أنس بن مالك روى عنه ربعي بن عبد الله وعمرو بن أبي الحجاج مات سنة عشرين ومائة بالبصرة ثنا القطان قال ثنا نوح بن حبيب قال ثنا وكيع بن الجراح قال ثنا ربعي بن عبد الله عن الجارود بن أبي سبرة عن أنس بن مالك قال كان النبي صلى الله عليه وسلم إذا صلى في السفر استقبل براحلته نحو القبلة فكبر ثم صلى على أي جهة أخذت(@)(@@)(@@)(@@) $ 2067 - جارود بن عمير يروي عن عمر بن الخطاب روى عنه إسرائيل بن يونس PageV04P114(@)(@@)(@@)(@@) $ 2068 - جارية بن سليمان المسلي يروي عن بن الزبير روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 2069 - جنيد شيخ يروي عن بن عمر روى عنه مالك بن مغول(@)(@@)(@@)(@@) $ 2070 - جميع بن عمير الحنفي الكوفي أحد بني تيم الله بن ثعلبة يروى عن بن عمر وعائشة روى عنه صدقة بن يسار والعلاء بن صالح(@)(@@)(@@)(@@) $ 2071 - جعدة بن هبيرة المخزومي والد يحيى بن جعدة يروي عن على روى عنه سعيد بن علاقة ويزيد الأودي أبو إدريس مات في زمن معاوية ولا أعلم لصحبته شيئا صحيحا فأعتمد عليه فلذلك أدخلناه في التابعين PageV04P115(@)(@@)(@@)(@@) $ 2072 - جعد بن دينار أبو عثمان اليشكري البصري الصيرفي يروي عن أنس روى عنه شعبة وحماد بن زيد يخطىء(@)(@@)(@@)(@@) $ 2073 - جعد بن عبد الرحمن بن أوس المدني يروي عن السائب بن يزيد روى عنه يحيى القطان والبصريون(@)(@@)(@@)(@@) $ 2074 - جويريه بن قدامة التميمي يروي عن 
ms515	 عمر بن الخطاب روى شعبة عن أبي جمرة عنه ثنا المنذر قال ثنا الحسن بن محمد بن الصباح قال ثنا شبابة قال ثنا شعبة ثنا أبو جمرة عن جويرية بن قدامة قال خطب عمر بن الخطاب فقال رأيت كأن ديكا نقرني قال فما لبث إلا قليلا حتى أصيب PageV04P116(@)(@@)(@@)(@@) $ 2075 - جبر بن نوف البكالي أبو الوداك يروي عن أبي سعيد الخدري روى عنه أبو إسحاق وأبو التياح وقد قيل أبو الوداك البكيلي(@)(@@)(@@)(@@) $ 2076 - جبر بن عبيدة يروي عن أبي هريرة روى عنه سيار أبو الحكم(@)(@@)(@@)(@@) $ 2077 - جرى بن كليب النهدي يروي عن على وبشير بن الخصاصية روى عنه قتادة(@)(@@)(@@)(@@) $ 2078 - جرى بن سمرة يروي عن على روى عنه أبو إسحاق الهمداني PageV04P117(@)(@@)(@@)(@@) $ 2079 - جرى بن الحارث القرشي مولى عثمان بن عفان يروي عن عثمان روى عنه هانئ مولى عثمان(@)(@@)(@@)(@@) $ 2080 - جناح الشامي مولى الوليد وهو والد مروان بن جناح يروي عن واثلة بن الأسقع روى عنه عثمان بن حصين الشامي وزيد بن واقد(@)(@@)(@@)(@@) $ 2081 - جندل يروي عن عمر بن الخطاب روى عنه عيسى بن يونس(@)(@@)(@@)(@@) $ 2082 - جهضم بن الضحاك أبو رؤبة الباهلي يروي عن رجل من أصحاب النبي صلى الله عليه وسلم باليمامة روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 2083 - جمهان مولى الأسلميين كنيته أبو العلاء يروي عن عثمان وسعد روى عنه عروة بن الزبير كان علي بن المدني يقول أمي من ولد عباس بن جمهان PageV04P118(@)(@@)(@@)(@@) $ 2084 - جهيم الفهري يروي عن عثمان وسعد وعمار روى عنه حصين بن عبد الرحمن وأبو عون الثقفي(@)(@@)(@@)(@@) $ 2085 - أبو الجلد الجوني اسمه جيلان بن أبي فروة الأسدي بصرى ويقال إن بن فروة كان يقرأ الكتب روى عنه أبو عمران الجوني(@)(@@)(@@)(@@) $ 2086 - جون بن قتادة بصرى يروي عن سلمة بن المحبق روى عنه الحسن(@)(@@)(@@)(@@) $ 2087 - جبار الطائي يروي عن بن عباس روى عنه أبو إسحاق الهمداني(@)(@@)(@@)(@@) $ 2088 - جلاس بن محمد الكلبي يروي عن بن عمر روى عنه أبو جناب ومنهم من زعم أنه جلاس بن عمرو 
ms516	(@)(@@)(@@)(@@) $ 2089 - جروة بن جميل الطائي كوفي يروي عن جماعة من الصحابة روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 2090 - جحادة الأيامي والد محمد بن جحادة كوفى يروى عن عائشة PageV04P119 مات في طريق مكة روى عنه ابنه محمد بن جحادة(@)(@@)(@@)(@@) $ 2091 - جوثة بن عبيد المدني الديلي يروي عن أنس بن مالك روى عنه عياش بن عباس روى عنه غنجار فقال جوثة وهو وهم مات جوثة سنة سبع وعشرين ومائة وكان كنيته أبا عبيد ولا أعلم له سماعا من أحد من الصحابة إلا من أنس بن مالك فقط(@)(@@)(@@)(@@) $ 2092 - جرثومة بن عبد الله النساج أبو محمد مولى بلال بن أبي بردة بصرى يروي عن أنس بن مالك روى عنه التبوذكي(@)(@@)(@@)(@@) $ 2093 - جرز بن جابر الخثعمي ويقال جزء من جابر يروي المراسيل روى الزهري عن أبي بكر بن عبد الرحمن عنه(@)(@@)(@@)(@@) $ 2094 - جشيب الشامي عريف العرفاء يروي عن أبي الدرداء روى عنه معاوية بن صالح PageV04P120(@)(@@)(@@)(@@) $ 2095 - جابان يروي عن عبد الله بن عمرو روى عنه نبيط بن شريط وسالم بن أبي الجعد(@)(@@)(@@)(@@) $$ 2096 - الجهدمة امرأة بشير بن الخصاصية روت عن بشير بن الخصاصية روى عنها إياد بن لقيط وقد قيل إنها بنت يزيد(@)(@@)(@@)(@@) $$ 2097 - جسرة بنت دجاجة تروى عن عائشة روى عنها أفلت بن خليفة وقدامة العامري(@)(@@)(@@)(@@) || (باب الحاء)(@)(@@) قال أبو حاتم وممن روى من التابعين عن الصحابة ممن ابتدأ اسمه على الحاء(@)(@@)(@@)(@@) $ 2098 - الحسن بن الحسن بن علي بن أبي طالب الهاشمي والد عبد الله بن الحسن بن الحسن يروي عن أبيه روى عنه ابنه إبراهيم بن الحسن PageV04P121 مات يعني عبد الله في سجن أبي جعفر سنة خمس وأربعين ومائة بالهاشمية(@)(@@)(@@)(@@) $ 2099 - الحسن بن محمد بن علي بن أبي طالب أخو عبد الله بن محمد يروي عن جابر بن عبد الله روى عنه الزهري وعمرو بن دينار مات في زمن عبد الملك وكان من علماء الناس بالاختلاف وكان يقول من خلع أبا بكر وعمر فقد خلع السنة(@)(@@)(@@)(@@) $ 2100 - الحسن بن عبد الرحمن بن عوف الزهري 
ms517	 يروي عن أبيه روى عنه كثير بن عبد الله اليشكري(@)(@@)(@@)(@@) $ 2101 - الحسن بن سهيل بن عبد الرحمن بن عوف يروي عن بن عمر روى عنه يزيد بن أبي زياد(@)(@@)(@@)(@@) $ 2102 - الحسن بن أبي الحسن أبو سعيد البصري واسم أبيه يسار مولى زيد بن ثابت الأنصاري وكان من سبي ميسان واسم أمه خيرة مولاة PageV04P122 أم سلمة ولد الحسن لسنتين بقيتا من خلافة عمر وكان يوم الدار بن أربع عشرة سنة واحتلم سنة سبع وثلاثين وخرج من المدينة ليالي صفين ولم يلق عليا وقد أدرك بعض صفين ورأى عشرين ومائة من أصحاب رسول الله صلى الله عليه وسلم وما شافه بدريا قط إلا عثمان وعثمان لم يشهد بدرا مات في شهر رجب سنة عشر ومائة وهو بن تسع وثمانين سنة وكان يدلس وصلى عليه النضر بن عمرو المقرى من حمير من أهل الشام وكان الحسن من أفصح أهل البصرة لسانا وأجملهم وجها وأعبدهم عبادة وأحسنهم عشرة وأنقاهم بدنا رحمة الله عليه(@)(@@)(@@)(@@) $ 2103 - الحسن بن علي بن أبي رافع مولى رسول الله صلى الله عليه وسلم يروي عن أبي رافع مولى رسول الله صلى الله عليه وسلم روى عنه الضحاك بن عثمان وبكير بن الأشج(@)(@@)(@@)(@@) $ 2104 - الحسن بن عثمان بن عبد الرحمن بن عوف الزهري يروي عن المسور بن مخرمة وابن الزبير روى عنه ولده(@)(@@)(@@)(@@) $ 2105 - الحسن بن هادية من أهل عمان يروي عن بن عمر روى عنه PageV04P123 الزبير بن الخريت في فضل الحج(@)(@@)(@@)(@@) $ 2106 - الحسن بن يزيد السعدي أحد بني بهدلة يروي عن أبي سعيد الخدري روى عنه أبو الصديق الناجي(@)(@@)(@@)(@@) $ 2107 - الحسن بن مهران الكرماني يروي عن فرقد وله صحبة روى عنه محمد بن سلام البيكندي(@)(@@)(@@)(@@) $ 2108 - الحسن بن مالك بن الحويرث يروي عن أبيه روى عنه ابنه مالك بن الحسن بن مالك بن الحويرث(@)(@@)(@@)(@@) $ 2109 - الحسن بن محمد العبدي يروى المراسيل روى عنه بن المبارك الهنائي(@)(@@)(@@)(@@) $ 2110 - الحسن بن سعد بن معبد الكوفي مولى علي بن أبي طالب PageV04P124 يروي عن 
ms518	 عبد الله بن جعفر روى عنه محمد بن أبي يعقوب وأهل الكوفة(@)(@@)(@@)(@@) $ 2111 - الحسن بن أسامة بن زيد مولى رسول الله صلى الله عليه وسلم يروي عن أبيه روى عنه مسلم بن أبي سهل النبال(@)(@@)(@@)(@@) $ 2112 - الحسن بن يزيد العجلي يروي عن بن مسعود روى عنه بن أبي نجيح(@)(@@)(@@)(@@) $ 2113 - الحسن بن الحسين يروي عن عمر بن الخطاب أنه قال أفضل الغزو الرباط روى عنه يزيد بن عبد الله بن أسامة بن الهاد(@)(@@)(@@)(@@) $ 2114 - الحسن بن جابر يروي عن المقدام بن معدى كرب كنيته أبو عبد الرحمن الكندي ويقال اللخمي روى عنه معاوية بن صالح مات سنة ثمان وعشرين ومائة(@)(@@)(@@)(@@) $ 2115 - الحسن بن عبد الله العرني مولى بجيلة يروي عن بن عباس روى عنه سلمة بن كهيل يخطىء PageV04P125(@)(@@)(@@)(@@) $ 2116 - الحسن بن غالب التميمي يروي عن سلمان روى عنه الحكم أبو مضر(@)(@@)(@@)(@@) $ 2117 - الحسن بن أيوب بن عبد الله الحضرمي شامي يروي عن عبد الله بن بسر روى عنه يحيى بن صالح الوحاظي وأهل الشام ثنا عمرو بن محمد بن بحير قال ثنا يحيى بن صالح الوحاظي قال ثنا الحسن بن أيوب الحضرمي قال ثنا عبد الله بن بسر أنه كان في قرن رأسه شامة فقال له النبي صلى الله عليه وسلم لتدركن قرنا(@)(@@)(@@)(@@) $ 2118 - الحسن الكوفي شيخ يروي عن بن عباس روى عنه ليث بن أبي سليم لا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 2119 - الحارث بن أوس النجاري الأنصاري المازني كان من علماء الأنصار وقرائهم يروي عن عثمان بن عفان روى عنه عاصم بن عمر بن قتادة(@)(@@)(@@)(@@) $ 2120 - الحارث بن الأزمع العبدي الوادعي الهمداني الكوفي يروي عن عمر وابن مسعود وعمرو بن العاص روى عنه الشعبي مات في إمارة النعمان PageV04P126 بن بشير بالكوفة سنة ستين في آخر ولاية معاوية(@)(@@)(@@)(@@) $ 2121 - الحارث بن مضرب يروي عن عمار بن ياسر روى عنه أبو إسحاق الهمداني(@)(@@)(@@)(@@) $ 2122 - أبو كثير الزبيدي اسمه الحارث بن جمهان الكوفي يروي عن على وابن مسعود روى 
ms519	 عنه مسعر وأهل الكوفة(@)(@@)(@@)(@@) $ 2123 - الحارث بن سويد بن قلاص أبو عائشة التيمي الكوفي الأعور يروي عن على وابن مسعود روى عنه أبو حيان التيمي وإبراهيم التيمى PageV04P127 مات في ولاية بن الزبير وصلى عليه عبد الله بن يزيد الأنصاري(@)(@@)(@@)(@@) $ 2124 - الحارث بن أبي الحارث الأزدي كوفي يروي عن على روى عنه سماك بن حرب يقال إنه من أهل نصيبين(@)(@@)(@@)(@@) $ 2125 - الحارث بن حرمل يروي عن عبد الله بن عمرو روى عنه جندب ذكره في باب جندب(@)(@@)(@@)(@@) $ 2126 - الحارث بن عمرو الباهلي من أهل البصرة روى عنه ابنه عبد الله ذكره في باب عبد الله(@)(@@)(@@)(@@) $ 2127 - الحارث بن جندب يروي عن على روى عنه رجاء بن حيوة(@)(@@)(@@)(@@) $ 2128 - الحارث بن حبيش الأسدي يروي عن سعد بن أبي وقاص وعلى روى عنه أبو وائل PageV04P128(@)(@@)(@@)(@@) $ 2129 - الحارث بن ثوب الأسدي كوفي يروي عن على روى عنه العباس بن ذريح(@)(@@)(@@)(@@) $ 2130 - الحارث بن حاطب يروي عن بن الزبير روى عنه يوسف بن سعد(@)(@@)(@@)(@@) $ 2131 - الحارث بن خفاف بن إيماء بن رحضة الغفاري يروي عن أبيه روى عنه خالد بن عبد الله بن حرملة(@)(@@)(@@)(@@) $ 2132 - الحارث بن عبد الله بن أبي ربيعة عمرو بن المغيرة الحجازي يروي عن عمر وعائشة روى عنه سعيد بن جبير ومجاهد والشعبي والزهري أمه أم ولد(@)(@@)(@@)(@@) $ 2133 - الحارث بن سعد بن أبي ذباب القرشي الحجازي بعثه عمر مصدقا وهو بن عم أبي هريرة يروي عن أبي هريرة روى عنه يزيد بن هرمز PageV04P129(@)(@@)(@@)(@@) $ 2134 - الحارث بن عبد الله كوفي يروي عن بن مسعود روى عنه عمرو بن مرة(@)(@@)(@@)(@@) $ 2135 - الحارث بن عمر الزبيدي من أهل الكوفة يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه بن سيرين وأهل العراق مات في إمارة يزيد بن معاوية(@)(@@)(@@)(@@) $ 2136 - الحارث بن رافع بن مكيث الجهني الربعي المدني يروي عن جابر بن عبد الله روى عنه ابنه خارجة بن الحارث(@)(@@)(@@)(@@) $ 2137 - الحارث بن خالد بن العاص سمع عائشة تقول قال لي 
ms520	 رسول الله صلى الله عليه وسلم إن قومك قصروا من البيت وتركوا منه أذرعا في الحجر ولولا حداثة قومك بالكفر لهدمته ولرددته على ما كان وجعلت له بابين روى عنه زرارة بن مصعب الشني PageV04P130(@)(@@)(@@)(@@) $ 2138 - الحارث بن شبيل كوفي يروي عن زيد بن أرقم روى عنه إسماعيل بن أبي خالد ثنا ابن قتيبة قال ثنا بن أبي السري قال ثنا معتمر بن سليمان قال ثنا إسماعيل بن أبي خالد عن الحارث بن شبيل عن زيد بن أرقم قال كنا نسلم بعضنا على بعض ونتكلم حتى نزلت وقوموا لله قانتين فأمرنا أن لا نتكلم في الصلاة(@)(@@)(@@)(@@) $ 2139 - الحارث الخولاني يروي عن عبد الله بن عمرو عداده في أهل مصر روى سعيد بن أبي أيوب عن عبد الله بن الوليد عنه(@)(@@)(@@)(@@) $ 2140 - الحارث بن مخمر أبو حبيب القاضي الشامي ولاه عبد الملك القضاء بعمان يروي عن أبي سعيد الخدري روى عنه القاسم بن مخيمرة وحريز بن عثمان ويقال كنيته أبو حسين PageV04P131(@)(@@)(@@)(@@) $ 2141 - الحارث بن أبي العباس يروي عن أبي الطفيل روى عنه عبد الرحيم بن عبد ربه ويقال بن أبي عياش(@)(@@)(@@)(@@) $ 2142 - الحارث بن عبد الله بن عياش يروي عن بن عباس روى عنه إبراهيم بن عبد الرحمن بن عبد الله بن أبي ربيعة(@)(@@)(@@)(@@) $ 2143 - الحارث بن عميرة الحارثي الأزدي يروي عن معاذ بن جبل روى عنه طلحة بن مصرف عداده في أهل الكوفة مات في ولاية يزيد بن معاوية(@)(@@)(@@)(@@) $ 2144 - الحارث بن أبي جميلة يروي عن أبي الدرداء روى عنه عبد الله بن أبي الحسين وقال أيضا فيه أنه يروي عن أم الدرداء(@)(@@)(@@)(@@) $ 2145 - الحارث بن عمرو الهذلي المدني يروي عن عمرو بن PageV04P132 مسعود روى عنه مسلم بن جندب مات سنة سبعين وقد قيل ولد في عهد رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 2146 - الحارث بن قيس الجعفي كوفي يروي عن بن مسعود روى عنه خيثمة بن عبد الرحمن والنخعي مات في ولاية معاوية وصلى أبو موسى الأشعري على قبره بعد 