ms1061	 الله بن وهب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حسان(@)(@@) يروي المراسيل، روى عنه نافع بن يزيد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عياش السمعي(@)(@@) من أهل المدينة، يروي عن المدنيين ودلهم بن الأسود، روى عنه عبد الرحمن بن المغيرة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ثوب أبو منقذ الكلاعي(@)(@@) من أهل الشام قوله، روى عنه صفوان بن عمرو السكسكي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عطاء بن كعب(@)(@@) مصري أصله من المدينة، يروي عن نافع، روى عنه عمرو بن الحارث، وسعيد بن أبي أيوب يعتبر حديثه إذا روى عن غير عبد الكريم بن أمية، مات سنة ثلاث وأربعين ومائة، كنيته أبو محمد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حيويل بن ناشرة المعافري(@)(@@) من أهل مصر، والد قرة بن عبد الرحمن، يروي عن أبي قتيلة، روى عنه سعد بن مسعود.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عراك بن مالك الغفاري(@)(@@) أخو خثيم بن عراك، يروي عن أبيه، روى عنه عبد الرحمن بن يزيد بن تميم ومروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خالد بن جبل العدواني(@)(@@) يروي عن أبيه، روى عنه عبد الله بن عبد الرحمن الطائفي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حسان الكناني(@)(@@) من أهل الشام، يروي عن مسلم بن PageV01P002 [ج 4: ص 45] الحارث ومحمد بن المنكدر، روى عنه صدقة بن خالد والوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يناق(@)(@@) يروي عن زينب امرأة عبد الله بن مسعود، روى عنه حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الحارث بن أبي عبيد المدني(@)(@@) مولى أبي رهم الغفاري، يروي عن سالم بن عبد الله، روى عنه خالد بن مخلد، وهو الذي يروي عن أبو ضمرة ويقول عبيد بن أبي عبيدة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن باباه(@)(@@) يروي عن طاوس، روى عنه إبراهيم بن نافع.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حوشب(@)(@@) يروي عن ثوبان بن شهر عن كريب بن أبرهة، روى عنه حريز بن عثمان عن سعيد بن يزيد الشامي عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن قيس الأرحبي(@)(@@) يروي عن رجل عن علي، روى عنه هاشم بن 
ms1062	 البريد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حميد بن عبد الرحمن الرؤاسي(@)(@@) والد حميد بن عبد الرحمن من أهل الكوفة، يروي عن جماعة من أهل بلده، روى عنه مالك بن إسماعيل، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي زياد(@)(@@) يروي عن عبد الله بن الحارث عن عمرو بن العاص عداده في أهل الكوفة، روى عنه الأعمش.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مالك بن يخامر السكسكي(@)(@@) من أهل الشام، يروي عن أبيه، روى عنه صفوان بن عمرو.(@)PageV01P002(@)(@@) [ج 4: ص 46](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي أمية المكي(@)(@@) يروي عن رجل من تجيب عن عمرو بن العاص، روى عنه الحارث بن يعقوب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خارجة بن زيد بن ثابت الأنصاري(@)(@@) أخو عبد الله، وسليمان ابني خارجة بن زيد بن ثابت، يروي عن أبيه، روى عنه إبراهيم بن إسماعيل بن مجمع.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن قتادة(@)(@@) البصري، يروي عن أبيه، عن هشام بن حكيم، روى عنه راشد بن سعد، وهو الذي يقول: بقية عن الزبيدي، عن راشد بن سعد، عن عبد الرحمن بن أبي قتادة البصري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد العزيز بن عبد الله بن عثمان بن حنيف(@)(@@) أخو عبيد الله بن عبد العزيز، كنيته أبو محمد من أهل المدينة، يروي عن الحجازيين، روى عنه أهل بلده، مات سنة اثنتين وستين ومائة، وهو ابن بضع وسبعين سنة وكان قد ذهب بصره.(@)(@@) (360) -[4: 46] حدثنا عمران بن موسى، قال: ثنا عثمان بن أبي شيبة، قال: ثنا خالد بن مخلد، قال: ثنا عبد الرحمن بن عبد العزيز الأنصاري، قال: حدثني الزهري، قال: حدثني قبيصة بن ذؤيب، قال: سمعت أبا هريرة، يقول: سمعت رسول الله صلى الله عليه وسلم يقول: " لا تنكح العمة على بنت الأخ ولا تنكح الخالة على بنت الأخت "(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن المجبر(@)(@@) يروي عن سالم بن عبد الله، روى عنه أهل المدينة.(@)(@@) (361) -[4: 46] حدثنا أبو خليفة، قال: ثنا علي بن المديني، قال: ثنا عبد الله بن سفيان بن عقبة، قال: أخبرني عبد الرحمن بن المجبر، 
ms1063	 قال: قال سالم بن عبد الله: " إذا جلس أحدكم في الصلاة فليمكن إليته اليسرى من الأرض "(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن النعمان المدني(@)(@@) من أهل المدينة، يروي عن يحيى بن سعيد الأنصاري، روى عنه الأوزاعي.(@)PageV01P002(@)(@@) [ج 4: ص 47](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عجلان البرجمي أبو موسى الطحان(@)(@@) من أهل الكوفة، يروي عن إبراهيم النخعي، روى عنه أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن حبيب بن أدرك(@)(@@) مولى بني مخزوم، يروي عن عطاء، روى عنه حاتم بن إسماعيل، وسليمان بن بلال.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عقبة بن عبد الرحمن بن جابر بن عبد الله الأنصاري(@)(@@) من أهل المدينة، يروي عن أبيه عن جابر، روى عنه يعقوب بن محمد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خالد العطار أبو الهيثم(@)(@@) يروي عن الكوفيين وهارون بن عنترة، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي زيد(@)(@@) يروي عن نافع بن جبير بن مطعم، روى عنه محمد بن إسحاق.(@)(@@) عبد الرحمن بن أبي زيد(@)(@@) يروي عن عمران بن سوادة، روى عنه عيسى بن يزيد الليثي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مرزوق الدمشقي(@)(@@) يروي عن نافع، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أصبغ الحضرمي(@)(@@) يروي عن أبي الضحاك، روى عنه حسين بن علي الجعفي.(@)PageV01P002(@)(@@) [ج 4: ص 48](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خازم أبو خازم(@)(@@) يروي عن مجاهد، روى عنه فضيل بن غزوان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن محيريز الجمحي(@)(@@) يروي عن أبيه، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ربيعة بن جابر الدمشقي(@)(@@) يروي عن أبي الأشعث الصنعاني، روى عنه الوليد بن مسلم، مات سنة ثلاث أو أربع وخمسين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عمرو بن أبي عمرة الأنصاري(@)(@@) من أهل المدينة، يروي عن عمه عبد الرحمن بن أبي عمرة عن عثمان، روى عنه عبد ربه بن خالد أخو العطاف بن خالد، وهو الذي روى عن سعيد المقبري، عن أبي هريرة من حديث عمرو بن الحارث، عن عبد الرحمن بن أبي عمرة، عن 
ms1064	 المقبري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عطاء بن أبي لبيبة(@)(@@) يروي عن عبد الملك بن جابر بن عتيك، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خبيب بن أساف(@)(@@) يروي عن أبيه عداده في أهل المدينة، روى عنه ابنه خبيب بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن أبو عمر الحداني(@)(@@) من أهل البصرة، يروي عن زياد النميري عن أنس، روى عنه نوح بن قيس الطاحي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي شميلة الأنصاري(@)(@@) يروي عن سلمة بن عبد الله بن محصن، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الأزرق العدني(@)(@@) من أهل اليمن يروي المراسيل، روى عنه الحكم بن أبان.(@)PageV01P002(@)(@@) [ج 4: ص 49](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن قيس(@)(@@) يروي عن موسى بن ماهك عن أبي هريرة، روى عنه أبو عامر الخزاز.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عمار بن أبي زينب(@)(@@) يروي عن القاسم بن محمد، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عطاء(@)(@@) يروي عن محمد بن جابر بن عبد الله، روى عنه حاتم بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يحيى بن خلاد الزرقي(@)(@@) من أهل المدينة، يروي عن المدنيين، وهو الذي يروي عن عبد الله بن أنيس إن كان سمع منه، روى عنه حسين بن عبد الله بن ضميرة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ضباب الأشعري(@)(@@) يروي عن عبد الرحمن بن غنم، روى عنه عبد الرحمن بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن النعمان بن معبد بن هوذة أبو النعمان الأنصاري(@)(@@) يروي عن أبيه، وسليمان بن قتة، روى عنه علي بن ثابت، وأبو نعيم.(@)(@@) (362) -[4: 49] حدثنا إبراهيم بن حزيم، قال: ثنا عبد بن حميد، قال: ثنا أبو نعيم، قال: ثنا عبد الرحمن بن النعمان الأنصاري، قال: سمعت سليمان بن قتة، قال: حدثني أبو سعيد، أن رسول الله صلى الله عليه وسلم بعث سرية عليهم أبو سعيد فمر بقرية من قرى عرينة وإذا ملك القرية لديغ، قال: فسألناهم طعاما فلم يطعمونا ولم ينزلونا، فمر بنا رجل من أهل القرية، فقال: يا معشر العرب 
ms1065	 هل أحد منكم يحسن أن يرقي إن الملك يموت، قال أبو سعيد: نعم، قال: فأتيته فقرأت عليه بفاتحة الكتاب فأفاق وبرئ فبعث إلينا ينزل وبعث إلينا بشاء فأكلنا الطعام أنا وأصحابي، وأبوا أن يأكلوا من الغنم حتى أتينا النبي صلى الله عليه وسلم فأخبرناه الخبر، فقال النبي صلى الله عليه وسلم: " وما يدريك أنها رقية؟ "، قلت: يا رسول الله PageV01P002 [ج 4: ص 50] شيء ألقي في روعي، قال: " فكلوا وأطعمونا من الغنم "(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن يزيد بن جابر الأزدي، كنيته أبو عتبة(@)(@@) يروي عن جماعة من التابعين، روى عنه الوليد بن مسلم، وأهل الشام، مات سنة ثلاث وخمسين ومائة وهو ابن بضع وثمانين سنة، وهو أخو يزيد بن يزيد بن جابر.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن قيس(@)(@@) يروي عن يوسف بن ماهك، عن أبي هريرة، أن رسول الله صلى الله عليه وسلم قال: " إذا صلى أحدكم فلا يجعل نعليه عن يمينه ولا عن يساره فتكون عن يمين غيره إلا أن لا يكون عن يساره أحد ".(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن النعمان(@)(@@) يروي عن محمد بن كليب الأنصاري، عن جابر بن عبد الله، روى عنه الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله بن المسيب(@)(@@) يروي عن أبي بكر بن سليمان بن أبي حثمة، روى عنه موسى بن يعقوب الزمعي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن نمر اليحصبي(@)(@@) من ثقات أهل الشام ومتقنيهم، يروي عن الزهري، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن جريس كوفي(@)(@@) يروي عن حماد بن أبي سليمان عن أبي وائل عن عبد الله في التشهد، روى عنه طلق بن غنام.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن خالد بن مسافر الفهمي(@)(@@) من أهل مصر، يروي عن الزهري، روى عنه الليث بن سعد، مات سنة سبع وعشرين ومائة.(@)PageV01P002(@)(@@) [ج 4: ص 51](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الملك بن كعب بن عجرة الأنصاري(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه سعد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن واقد(@)(@@) من أهل البصرة، يروي عن معن 
ms1066	 ابن يزيد المقاطيع، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن وهب بن منبه(@)(@@) يروي عن أبيه عداده في أهل اليمن، روى عنه هشام بن يوسف.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن الزبير(@)(@@) يروي عن خلاد بن عبد الرحمن، روى عنه محمد بن الحسن الصنعاني.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله الزهري(@)(@@) يروي عن بريدة بن سفيان المراسيل، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عثمان بن سعد بن أبي وقاص الزهري القرشي(@)(@@) يروي عن الزهري روى سعيد بن أبي أيوب عن عمران بن مالك عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعد(@)(@@) مولى الأسود بن سفيان، يروي عن أبيه، عن عمر، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن سعيد بن أبي بردة(@)(@@) يروي عن أبي بردة، عن أبي موسى، " أنه كان يصلي قبل المغرب ركعتين ". رواه عنه ابن أبي زائدة وهو أخو موسى بن سعيد بن أبي بردة الذي، روى عنه ابن أبي إدريس.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن علي بن نافع بن جبير بن مطعم القرشي(@)(@@) يروي عن الزهري، روى عنه يحيى بن سليم الطائفي.(@)PageV01P002(@)(@@) [ج 4: ص 52](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عراك أبو إدريس الأصغر(@)(@@) من أهل الشام يروي المقاطيع، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عباد القيسي أبو عباد الوراق(@)(@@) من أهل البصرة، يروي عن الحسن، روى عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي الصهباء بصري(@)(@@) يروي عن أبي غالب نافع الباهلي عن أنس، روى عنه أحمد بن عبد الملك بن واقد الحراني.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي عاصم الدالاني(@)(@@) من أهل الكوفة، قوله، روى عنه موسى بن أبي عائشة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن كيسان بن جرير(@)(@@) يروي عن أبيه، روى عنه عمرو بن كثير بن أفلح.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن محمد بن عمار بن سعد القرظ(@)(@@) يروي عن آبائه عداده في أهل المدينة، روى عنه عبد الرحمن بن سعد المديني مولى بني مخزوم في الأذان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن فضالة، كنيته أبو ذر 
ms1067	(@)(@@) من أهل الشام، يروي عن عمرو بن اللجلاج السكسكي والزبير بن عبد الله العنبسي، روى عنه صفوان بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن محمد بن عبد الله بن عبد القاري(@)(@@) يروي عن أبيه، روى عنه ابنه يعقوب بن عبد الرحمن الإسكندراني.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن إبراهيم بن محمد بن حاطب(@)(@@) يروي عن أبيه، عن جده محمد بن حاطب، روى عنه زحمويه.(@)PageV01P002(@)(@@) [ج 4: ص 53](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الحكم الواسطي(@)(@@) يروي عن الحكم بن عتيبة، روى عنه الفضل بن عنبسة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن شريح أبو شريح المعافري(@)(@@) من أهل مصر، يروي عن جماعة من التابعين، روى عنه أهل مصر، مات سنة سبع وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن إسحاق بن الحارث بن عبد الله القرشي المدني(@)(@@) سكن البصرة، يروي عن الزهري، والعلاء بن عبد الرحمن متقن جدا، روى عنه خالد بن عبد الله الواسطي ويزيد بن زريع، وليس هذا بعبد الرحمن بن إسحاق الكوفي ذاك ضعيف واه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبيد بن نفيع العنسي الدمشقي(@)(@@) من حرستا، يروي عن مصعب بن سعد بن أبي وقاص، روى عنه ابنه إسماعيل بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله أبو العلاء(@)(@@) يروي عن شريك بن أبي نمر، ومحمد بن زيد، روى عنه عثمان بن عمر بن فارس.(@)(@@)(@@)(@@) ||| AUTO أبو الحويرث اسمه عبد الرحمن بن معاوية بن الحويرث الزرقي الأنصاري(@)(@@) من أهل المدينة، يروي عن نافع بن جبير، روى عنه الثوري، وهو الذي يروي عن شعبة، ويقول أبو الجويرية، مات سنة اثنتين وثلاثين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن فروخ(@)(@@) مولى عمر بن الخطاب، يروي عن أبيه، روى عنه عمرو بن دينار.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن نضلة الدؤلي(@)(@@) يروي المقاطيع عداده في أهل المدينة، روى عنه بكير بن الأشج.(@)PageV01P002(@)(@@) [ج 4: ص 54](@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عدى البهراني(@)(@@) من أهل حمص، يروي عن يزيد بن ميسرة، روى عنه صفوان بن عمرو بن عياش.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن فروخ(@)(@@) وقد قيل: عبد الله 
ms1068	 بن فروخ، يروي عن عبد الله بن أبي قتادة، روى عنه عبد الله بن يرفأ.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عمرو المكي(@)(@@) يروي عن عطاء بن يحنس، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن محمد بن عمر بن أبي سلمة(@)(@@) يروي عن أبيه، عن جده، روى عنه يعقوب بن محمد الزهري.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي واصل(@)(@@) يروي عن عروة بن الزبير، روى عنه عمرو بن ميمون.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مدرك(@)(@@) يروي عن ابنت خباب بن الأرت، روى عنه أبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن قيس(@)(@@) يروي عن حبيب بن أبي ثابت، روى عنه الحسن بن الحكم الكوفي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي قيس(@)(@@) يروي عن رفاعة بن رافع، روى عنه عتبة بن أبي حكيم.(@)(@@)(@@)(@@) ||| AUTO أبو حمزة جار شعبة اسمه عبد الرحمن بن أبي عبد الله(@)(@@) ويقال: عبد الرحمن بن كيسان، وقد قيل: خداش، يروي عن صفوان بن محرز، ومسلم بن يسار، روى عنه شعبة بن الحجاج.(@)PageV01P002(@)(@@) [ج 4: ص 55](@)(@@)(@@)(@@) ||| AUTO أبو مروان(@)(@@) والد عطاء بن أبي مروان اسمه عبد الرحمن بن معتب، يروي عن كعب، روى عنه ابنه عطاء بن أبي مروان.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبيد الله(@)(@@) يروي عن عبد الله بن عياش عن ابن عمر، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن عبد الله السراج(@)(@@) من أهل البصرة، يروي عن نافع، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO أبو الجويرية العبدي اسمه عبد الرحمن بن مسعود(@)(@@) من أهل الكوفة، يروي عن ابن الحنفية، روى عنه الصلت بن بهرام.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن العلاء بن اللجلاج(@)(@@) من أهل الشام، يروي عن أبيه، روى عنه مبشر العامري الشامي.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن المغيرة بن أبي ذئب(@)(@@) من أهل المدينة، يروي عن أبيه، روى عنه ابنه محمد بن عبد الرحمن بن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن فضالة بن أبي أمية القرشي(@)(@@) مولى عمر بن الخطاب أخو المبارك بن فضالة، كنيته أبو أمية، يروي عن بكر بن عبد الله 
ms1069	 المزني، روى عنه ابن المبارك، وابن مهدي ووكيع، وهم إخوة ثلاثة: المبارك وعبد الرحمن، وعبيد الرحمن.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن زيد بن أبي الموال(@)(@@) مولى لعلي بن أبي طالب، من أهل المدينة، كنيته أبو محمد، يروي عن محمد بن المنكدر، روى عنه الثوري، وقتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن محمد بن عبيد الله بن أبي سليمان الفزاري العرزمي(@)(@@) يروي PageV01P002 [ج 4: ص 56] عن الكوفيين، روى عنه أهل الكوفة، مات سنة ثمانين ومائة، يعتبر حديثه من غير روايته عن أبيه.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي الرجال(@)(@@) من أهل المدينة، واسم أبي الرجال محمد بن عبد الرحمن، يروي عن هشام بن عروة وكان راويا لأبيه، روى عنه قتيبة بن سعيد والناس ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن أبي المليح الهذلي(@)(@@) واسم أبي المليح عامر بن أسامة، يروي عن أبيه، روى عنه سلمة بن تمام.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن ثابت بن ثوبان الدمشقي(@)(@@) يروي عن وجماعة من التابعين، روى عنه الوليد بن مسلم وغسان بن الربيع.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن محمد المحاربي(@)(@@) من أهل الكوفة، كنيته أبو محمد، يروي الحسن بن أبي الحسن عن يحيى بن سعيد الأنصاري، روى عنه أهل العراق والغرباء، مات سنة خمس وتسعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الرحمن بن مغراء بن عياض بن الحارث الدوسي(@)(@@) من أهل الري، كنيته أبو زهير، يروي عن الأعمش ويحيى بن سعيد، روى عنه الرازيون.(@)(@@)(@@)(@@) ||| AUTO عبيد الرحمن بن فضالة(@)(@@) أخو المبارك بن فضالة، يروي عن بكر بن عبد الله المزني عن أنس بن مالك، روى عنه مسلم بن إبراهيم، ليس في المحدثين عبيد الرحمن غير هذا والأشجعي صاحب الثوري ابنه عبيد الله بن عبيد الرحمن.(@)PageV01P002(@)(@@) [ج 4: ص 57](@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي بكر بن عبد الرحمن بن الحارث بن هشام المخزومي(@)(@@) من أهل المدينة، يروي عن أبيه عن أبي هريرة، وأم سلمة، روى عنه الزهري، وابن جريج، وعبد الله بن عبيد بن عمير أمه سارة بنت هشام بن الوليد بن المغيرة، وكان سخيا سريا، 
ms1070	 مات في أول ولاية هشام بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد العزيز بن جريج المكي(@)(@@) مولى أمية بن خالد بن أسيد القرشي، له كنيتان أبو الوليد وأبو خالد، يروي عن عطاء، وعمرو بن دينار، والزهري، روى عنه الثوري والناس، مات سنة تسع وأربعين ومائة، وقد جاوز السبعين، وكان من فقهاء أهل الحجاز وقرائهم ومتقنيهم وكان يدلس، وقد قيل: مات سنة خمسين ومائة، ولابن جريج ابن يسمى عبد العزيز، وله ابن يقال له: الوليد بن عبد العزيز بن جريج، كان ينزل بئر ميمون بمكة في أصل ثبير على ثلاثة أميال من مكة.(@)(@@) (363) -[4: 57] يروي ابن جريج، عن عطاء، عن أبي الدرداء، عن النبي صلى الله عليه وسلم أنه قال: " ما طلعت الشمس ولا غربت على أحد بعد النبيين والمرسلين خير من أبي بكر وعمر " روى عنه أحمد بن محمد بن عبد الله بن القاسم بن أبي بزة المكي أبو الحسن، وكان أحمد هذا مؤذن المسجد الحرام(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن إياس الشيباني الأعور(@)(@@) من أهل الكوفة، يروي عن إبراهيم النخعي، روى عنه العوام بن حوشب.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أعين(@)(@@) أخو حمران بن أعين من أهل الكوفة، يروي عن العراقيين، روى عنه ابن عيينة وإسماعيل بن سميع وكان يتشيع.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن سعيد بن جبير(@)(@@) مولى والبة الأسدي أخو عبد الله بن سعيد، يروي عن أبيه، روى عنه يزيد بن أبي زياد.(@)PageV01P002(@)(@@) [ج 4: ص 58](@)(@@)(@@)(@@) ||| AUTO عبد الملك بن الأشج(@)(@@) يروي عن جابر بن زيد عداده في البصريين، روى عنه عمرو بن فروخ.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي بكر بن حفص بن عمر بن سعد بن أبي وقاص(@)(@@) يروي عن محمد بن عبد الرحمن مولى آل طلحة، وأهل المدينة أبي حازم وغيره. روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن زيد بن سعيد بن زيد بن عمرو بن نفيل القرشي(@)(@@) يروي عن المدنيين، روى عنه ابن أبي فديك.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن يحيى بن عباد بن عبد الله بن 
ms1071	 الزبير القرشي(@)(@@) يروي عن عروة بن الزبير، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن حميد بن أبي غنية الكوفي(@)(@@) أصله من أصبهان، والد يحيى بن عبد الملك، يروي عن الحكم بن عتيبة والكوفيين، روى عنه ابنه، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن هارون العبدي(@)(@@) يروي عن أم الشموس عن عائشة عداده في أهل البصرة، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن سعيد بن حيان بن أبجر(@)(@@) من أهل الكوفة، يروي عن الشعبي وعكرمة، روى عنه ابن عيينة، وأبو معاوية الضرير.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن إبراهيم الشعباني(@)(@@) يروي عن ابن سيرين، روى عنه زيد بن حباب العكلي.(@)PageV01P002(@)(@@) [ج 4: ص 59](@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي سليمان العرزمي(@)(@@) مولى فزارة عم محمد بن عبيد الله العرزمي، واسم أبي سليمان ميسرة، وكنية عبد الملك أبو عبد الله، يروي عن سعيد بن جبير وعطاء، روى عنه الثوري وشعبة وأهل العراق ربما أخطأ.(@)(@@) (364) -[4: 59] حدثني محمد بن المنذر، قال: سمعت أبا زرعة، يقول: سمعت أحمد بن حنبل، ويحيى بن معين، يقولان: عبد الملك بن أبي سليمان ثقة. قال أبو حاتم: كان عبد الملك من خيار أهل الكوفة وحفاظهم والغالب على من يحفظ ويحدث من حفظه أن يهم وليس من الإنصاف ترك حديث شيخ ثبت صحت عدالته بأوهام يهم في روايته، ولو سلكنا هذا المسلك للزمنا ترك حديث الزهري، وابن جريج والثوري وشعبة لأنهم أهل حفظ وإتقان وكانوا يحدثون من حفظهم ولم يكونوا معصومين حتى لا يهموا في الروايات، بل الاحتياط والأولى في مثل هذا قبول ما يروي الثبت من الروايات وترك ما صح أنه وهم فيها ما لم يفحش ذلك منه حتى يغلب على صوابه، فان كان كذلك استحق الترك حينئذ، ومات عبد الملك سنة خمس وأربعين ومائة.(@)(@@) (365) -[4: 59] حدثني محمد بن إسحاق الثقفي، قال: سمعت محمد بن عبد العزيز بن أبي رزمة، قال: سمعت علي بن الحسن بن شقيق، يقول: سمعت عبد الله بن المبارك، يقول: سئل الثوري عن عبد الملك بن 
ms1072	 أبي سليمان، فقال: ميزان(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي جمعة أبو معبد البصري(@)(@@) يروي عن جابر بن زيد والحسن، روى عنه مسلم بن إبراهيم، وأهل البصرة.(@)(@@) (366) -[4: 59] حدثنا عمر بن محمد الهمداني بن أشكيب، قال: ثنا عبد الصمد بن عبد الوارث، قال: ثنا عبد الملك بن أبي جمعة، قال: سألت الحسن عن أجرة القبان والميزان، فكرهه(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد ربه بن سليمان بن زيتون(@)(@@) يروي أجرة القبان عن رجل عن ابن عباس عداده في أهل الشام، روى عنه أهلها، كنيته أبو حاضر.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن المغيرة الثقفي الطائفي(@)(@@) يروي عن العراقيين والحجازيين وهو الذي يروي عن ابن البيلماني، روى عنه الحجاج بن أرطأة والوليد بن جميع.(@)PageV01P002(@)(@@) [ج 4: ص 60](@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي زهير بن عبد الرحمن الثقفي(@)(@@) يروي عن الحجازيين، روى عنه سعيد بن السائب.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن الأحوص اليشكري(@)(@@) يروي عن سليمان بن كندير، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن الحسن الجاري الأحول(@)(@@) مولى مروان بن الحكم الأموي يروي المقاطيع والمراسيل، روى عنه أبو عامر العقدي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عمرو بن قيس الخطمي الأنصاري(@)(@@) يروي عن هرمى بن عبد الله، روى عنه عبيد الله بن عبد الله الخطمي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي بشير المدائني(@)(@@) يروي عن عكرمة وعطية، روى عنه سفيان الثوري، وجرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO عبد الملك أبو جعفر(@)(@@) من أهل البصرة، يروي عن أبي نضرة، روى عنه حماد بن سلمة.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن محمد بن أبي بكر بن محمد بن عمرو بن حزم(@)(@@) من بني النجار من أهل المدينة، كنيته أبو الطاهر، يروي عن عبد الله بن أبي بكر بن محمد بن عمرو بن حزم، وغيره من أهل المدينة، قدم بغداد ولاه هارون قضائها، روى عنه شريح بن النعمان، مات سنة سبع وسبعين ومائة أو ثمان وسبعين ومائة ببغداد.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي القاسم(@)(@@) يروي عن نافع، روى عنه جعفر بن برقان.(@)(@@) (367) -[4: 60] حدثنا إبراهيم بن حزيم، قال: 
ms1073	 ثنا عبد بن حميد، قال: ثنا كثير بن هشام، قال: ثنا جعفر بن برقان، قال: ثنا عبد الملك بن أبي القاسم، عن نافع، قال: جاء رجل إلى ابن عمر، فقال سمعت أبا سعيد PageV01P002 [ج 4: ص 61] الخدري، يقول: الذهب بالذهب، وزنا بوزن، مثلا بمثل، يدا بيد، ليس بينهما رمأ. والرمأ: الربا، ولا يباع غائب منه بناجز. فقام عبد الله بن عمر والذي حدثه ومشيت معهم حتى أتينا أبا سعيد الخدري، فقال: ما حديث حدثنيه هذا فأشار إلى أذنيه وعينيه، فقال: سمع أذناي هاتان وأبصرت عيناي هاتان أنه صلى الله عليه وسلم " نهى عن الفضة إلا وزنا بوزن، وعن الذهب إلا وزنا بوزن، مثلا بمثل "(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن وهب الأزرق(@)(@@) مولى زيد بن ثابت الأنصاري، يروي المراسيل، روى عنه عبد الرحمن بن أبي الموالي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن خشك(@)(@@) من أهل اليمن، يروي عن حجر المدرى روى عبد الرزاق عن أبيه، عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن الحارث بن الرحيل(@)(@@) يروي المقاطيع، روى عنه عمرو بن الحارث.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الملك بن راشد الثعلبي(@)(@@) يروي عن المقدام عن عائشة، روى عنه محمد بن حرب الأبرش، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن حسان العنبري(@)(@@) أخو نصر بن حسان من أهل البصرة، يروي عن العراقيين، روى عنه جويرية بن أسماء.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي حرة(@)(@@) يروي عن أبيه عن عمر، روى عنه ابن معقل الكوفي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد الله بن فيروز الرومي(@)(@@) أخو عمر بن عبد الله من أهل البصرة، يروي عن أبيه، عن ابن عمر، روى عنه موسى بن إسماعيل التبوذكي.(@)(@@) عبد الملك بن راشد(@)(@@) يروي عن أبيه، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي جميلة(@)(@@) يروي عن عبد الله بن موهب بن زمعة بن PageV01P002 [ج 4: ص 62] الأسود، روى عنه المعتمر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن حكيم العبدي(@)(@@) يروي عن أبي مريم، روى عنه شبابة بن سوار.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد الله بن جابر(@)(@@) يروي 
ms1074	 عن أبي جعفر محمد بن علي، روى عنه إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن سليمان بن يسار(@)(@@) مولى ميمونة بنت الحارث، يروي عن نافع، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن حيان(@)(@@) أحسبه بن أبجر، يروي عن إبراهيم النخعي، روى عنه عبد الله بن عمر.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن مهران(@)(@@) يروي عن أبي صالح عن أبي هريرة، روى عنه سهل بن عبد الله يعتبر حديثه من غير رواية سهل بن عبد الله عنه.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي صالح(@)(@@) يروي عن المدنيين، روى عنه إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن زكريا الأنصاري(@)(@@) يروي عن زيد بن الحسن بن علي، روى عنه عنبسة.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي عاصم بن عروة الثقفي(@)(@@) أخو داود بن أبي، عاصم من أهل الحجاز، يروي عن سعيد بن المسيب، روى عنه سعيد بن السائب.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن سلع الهمداني(@)(@@) من أهل الكوفة، يروي عن عبد خير، روى عنه مروان بن معاوية، وابنه مسهر بن عبد الملك كان ممن يخطئ.(@)PageV01P002(@)(@@) [ج 4: ص 63](@)(@@)(@@)(@@) ||| AUTO عبد الملك بن سليم(@)(@@) يروي عن عطاء، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن رزين(@)(@@) يروي المراسيل، روى عنه حجاج بن محمد الأعور.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي نضرة العبدي(@)(@@) من أهل البصرة واسم أبي نضرة المنذر بن مالك بن قطعة، يروي عن أبيه، روى عنه البصريون، وأهل مرو عبدان بن عثمان، وغيره ربما أخطأ وهو أخو البراء بن أبي نضرة.(@)(@@) (368) -[4: 63] حدثنا علي بن أحمد بن بسطام بالبصرة، قال: ثنا عمي إبراهيم بن بسطام، قال: ثنا سلم بن قتيبة، قال: ثنا عبد الملك بن أبي نضرة، عن أبيه، قال: " كنا بالمدينة فسب رجل عثمان فنهيناه فلم ينته فارعدت ثم جاءت صاعقة فأحرقته "(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبيد بن سعيد بن يربوع بن عنكثة بن عامر المخزومي(@)(@@) يروي عن جماعة من التابعين، روى عنه أهل المدينة، كنيته أبو المسور، أمه أم السفاح بنت سمرة بن 
ms1075	 خالد بن عبيد من خزاعة.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد الله بن أبي أسيد(@)(@@) يروي عن أبي ليلى الحارثي، روى عنه عباد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد العزيز بن أبي فروة المدني(@)(@@) يروي عن سعيد المقبري، روى عنه أبو سعيد مولى بني هاشم.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد الرحمن بن خالد بن أسيد القرشي(@)(@@) من أهل مكة، يروي عن أمه عن عائشة، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عطاء البكائي(@)(@@) ختن الشعبي من أهل الكوفة، يروي عن يزيد بن الأصم، روى عنه ابن عيينة ووكيع.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن يعلى الليثي(@)(@@) قاضي البصرة، قوله، روى عنه أيوب، وزياد بن مخراق.(@)PageV01P002(@)(@@) [ج 4: ص 64](@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عبد الرحمن بن يوسف(@)(@@) يروي عن سالم، روى عنه بكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عيسى بن عبد الرحمن بن العلاء بن جارية الثقفي(@)(@@) يروي عن عكرمة، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن عطاء المكي(@)(@@) مولى بني هاشم، يروي عن أبي جعفر محمد بن علي، روى عنه بكير بن الحكم.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن أبي كثير(@)(@@) يروي عن سعيد بن المسيب عداده في البصريين، روى عنه أزهر السمان.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن نوفل بن مساحق القرشي، كنيته أبو نوفل(@)(@@) يروي عن الحجازيين، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن مسلم بن سلام الحنفي(@)(@@) من أهل الكوفة، يروي عن عيسى بن حطان، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن فارغ(@)(@@) يروي عن بلال بن عبد الله، روى عنه عراك بن مالك من حديث المصريين.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن قيس بن عباية(@)(@@) يروي عن أبيه، عن ابن عباس، روى عنه يحيى بن سعيد القطان.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن مروان بن الحارث بن أبي ذباب(@)(@@) يروي عن سالم سبلان، روى عنه عبد الحميد بن عبد الرحمن المدني.(@)PageV01P002(@)(@@) [ج 4: ص 65](@)(@@)(@@)(@@) ||| AUTO عبد الملك بن وهب المذحجي(@)(@@) من أهل الكوفة، يروي عن الحر بن الصياح النخعي، روى عنه بشر بن 
ms1076	 محمد بن أبان الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن ميسرة المكي(@)(@@) يروي عن الحجازيين، روى عنه أبو داود الطيالسي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن يعلى الضرير(@)(@@) يروي عن أبيه، عن عمران بن حصين، روى عنه نوح بن قيس الطاحي، وأهل البصرة وكان راويا ليزيد الرقاشي.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن مجاشع بن مسعود السلمي(@)(@@) من أهل البصرة، يروي عن الحجازيين، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عبد الملك بن مهران الجبان(@)(@@) من أهل دمشق، يروي عن معروف الخياط عن واثلة، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد العزيز بن عبد الله بن عمر بن الخطاب القرشي(@)(@@) رضوان الله عليهم والد عبد الله بن عبد العزيز الزاهد من أهل المدينة، يروي عن محمد بن أبي بكر بن عمرو بن حزم، وأهل المدينة، روى عنه ابن المبارك، وابن أبي ذئب والماجشون، كنيته أبو محمد.(@)(@@) عبد العزيز بن عبد الله(@)(@@) يروي عن أبي سلمة بن سفيان، روى عنه ابن جريج.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن الربيع أبو العوام الباهلي(@)(@@) يروي عن عطاء، وأبي الزبير، روى عنه النضر بن شميل.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن أبي سعد المزني(@)(@@) يروي عن عائذ بن عمرو ولم يسمع منه، PageV01P002 [ج 4: ص 66] روى عنه مرزوق بن عبد الرحمن، وهو الذي يروي عنه حماد بن سلمة، ويقول عبد العزيز بن أبي سعيد المزني عن عبيد الله بن أبي بكرة.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن عبد الله بن عامر بن ربيعة العنزي(@)(@@) من أهل الحجاز، يروي عن الحجازيين، روى عنه سماك بن حرب.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن الربيع بن سبرة بن معبد الجهني(@)(@@) يروي عن أبيه، روى عنه ابنه سبرة بن عبد العزيز يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن إسماعيل بن عبيد الله بن أبي المهاجر(@)(@@) مولى بني مخزوم من أهل الشام، يروي عن سليمان بن حبيب المحاربي والشاميين، روى عنه الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن أبي سلمة الماجشون(@)(@@) من أهل المدينة، كنيته أبو عبد الله، يروي عن الزهري، روى عنه الليث بن سعد، والحجازيون، وأهل 
ms1077	 العراق، مات بالعراق سنة ست وستين ومائة، وكان فقيها ورعا متابعا لمذهب أهل الحرمين من أسلافه مفرعا على أصولهم ذابا عنهم وكان مولى لال المنكدر.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن معمر اليشكري(@)(@@) يروي عن حصين الرقاشي من أهل البصرة، روى عنه أبو هارون الغنوي.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن جماز(@)(@@) يروي المراسيل، روى عنه حرملة بن عمران التجيبي.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن حوران(@)(@@) يروي عن وهب بن منبه عداده في أهل اليمن، روى عنه رباح بن زيد الصنعاني.(@)PageV01P002(@)(@@) [ج 4: ص 67](@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن أبي الصعبة(@)(@@) يروي عن الحسن، روى عنه يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن علي الدؤلي(@)(@@) يروي المقاطيع، روى عنه حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن عياش(@)(@@) يروي عن محمد بن كعب القرظي، روى عنه ابن أبي ذئب.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز الوراق(@)(@@) يروي عن أبي العالية، روى عنه أبو خلدة خالد بن دينار.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن أبي شعيب(@)(@@) يروي عن البهي روى حكام بن سلم الرازي عن عنبسة عنه.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن علي بن هبار(@)(@@) يروي عن أم كلاب، روى عنه عيسى بن النعمان المدني.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن قرير البصري(@)(@@) يروي عن الأحنف بن قيس، ومحمد بن سيرين، روى عنه الثوري، والعطاف بن خالد.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن صالح(@)(@@) يروي عن عبد الرحمن بن نعيم عن أبي هريرة، روى عنه سعيد بن أبي هلال.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن المطلب بن عبد الله بن حنطب بن الحارث بن عبيد بن عمر بن مخزوم، كنيته أبو طالب(@)(@@) أمه أم الفضل من بني مخزوم، مات في PageV01P002 [ج 4: ص 68] ولاية أبي جعفر وكان قاضيا على المدينة، يروي عن يحيى بن سعيد الأنصاري، روى عنه أبو غسان محمد بن يحيى الكناني ويعقوب بن إبراهيم بن سعد.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن سليمان بن أبي السائب(@)(@@) ويعرف بعبيد بن أبي السائب، يروي عن جماعة من التابعين وسمع أبا قلابة وكان من خواص عمر بن عبد العزيز، روى عنه أهل الشام، 
ms1078	 وعبد العزيز هذا أخو الوليد بن سليمان بن أبي السائب، وهما أهل فضل وعلم ودين.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن عبد الملك بن مليل السليحي(@)(@@) وسليح من قضاعة، يروي عن أبيه، روى عنه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن سياه الأسدي المكي(@)(@@) يروي عن حبيب بن أبي ثابت، روى عنه يزيد بن هارون ويعلى بن عبيد.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن جريج(@)(@@) والد عبد الملك، يروي عن عائشة ولم يسمع منها وهو من أتباع التابعين، روى عنه ابنه عبد الملك بن جريج.(@)(@@)(@@)(@@) ||| AUTO أبو مودود المدني اسمه عبد العزيز بن أبي سليمان(@)(@@) يروي عن الحجازيين محمد بن كعب القرظي وغيره، وقد قيل: إنه رأى أنسا، وليس ذلك بمحظوظ، روى عنه وكيع بن الجراح وكان ممن يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن زياد العمى الوزان(@)(@@) من أهل البصرة، يروي عن قتادة المقاطيع، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن عمر بن عبد العزيز بن مروان بن الحكم الأموي القرشي(@)(@@) يروي عن نافع والزهري، روى عنه يحيى بن سعيد الأنصاري ووكيع PageV01P002 [ج 4: ص 69] يخطئ يعتبر بحديثه إذا كان دونه ثقة، ومات عبد العزيز بن عمر بن عبد العزيز بعد سنة سبع وأربعين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن عقبة بن سلمة الأسلمي(@)(@@) يروي عن عبد الله بن نافع عداده في أهل المدينة، روى عنه يزيد بن عمرو الأسلمي.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن المختار الأنصاري الدباغ(@)(@@) من أهل البصرة، يروي عن ثابت، روى عنه معلى بن أسد والعراقيون كان يخطئ.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن مولة(@)(@@) يروي عن أبيه مولة بن حنيف روت عنه ابنته طهماء.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن يعقوب بن أبي سلمة الماجشون(@)(@@) من أهل المدينة أخو يوسف بن يعقوب، يروي عن محمد بن المنكدر، روى عنه يحيى بن معين ويعقوب بن إبراهيم الدورقي، وكل شيء عنده كان ثلاثة أحاديث، وعبد العزيز بن عبد الله بن أبي سلمة بن عمه أكثر حديثا منه.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن عبد الصمد العمى أبو عبد الصمد(@)(@@) يروي 
ms1079	 عن مالك بن دينار، مات سنة تسع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن نهار أبو الجويرية الضرير(@)(@@) يروي عن أم سعيد عن عائشة، روى عنه العراقيون.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن مسلم القسملي، كنيته أبو زيد(@)(@@) أخو المغيرة بن PageV01P002 [ج 4: ص 70] مسلم السراج أصلهما من مرو، وانتقل عبد العزيز إلى البصرة وكان ينزل القساملة فنسب إليهم، يروي عن ثابت والبصريين، روى عنه أهل العراق، مات سنة سبع وستين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن محمد بن أبي عبيد الدراوردي(@)(@@) من أهل المدينة، يروي عن يحيى بن سعيد الأنصاري وعمرو بن أبي عمرو، روى عنه أحمد ويحيى وإسحاق، مات في شهر صفر سنة ست وثمانين ومائة وكان يخطئ، وكان أبوه من درابجرد مدينة بفارس، وكان مولى لجهينة، فاستثقلوا أن يقولوا درابجردي فقالوا: الدراوردي. وقد قيل: إنه من أندرابة، وقد قيل: إنه مات سنة اثنتين وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد العزيز بن أبي حازم المدني(@)(@@) واسم أبي حازم سلمة بن دينار العابد مولى أسلم، يروي عن أبيه، روى عنه الحجازيون والغرباء، مات سنة أربع وثمانين ومائة وهو ساجد وله ثنتان وثمانون سنة، وقد قيل: إنه مات سنة ثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن عبد الرحمن بن زيد بن الخطاب القرشي العدوى(@)(@@) من أهل المدينة، يروي عن مسلم بن يسار ومقسم، روى عنه زيد بن أبي أنيسة، والحكم بن عتيبة وكان عامل عمر بن عبد العزيز على الكوفة.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن عبد الرحمن بن أبي عمرو المخزومي(@)(@@) من أهل المدينة، يروي عن أبي بكر بن عبد الرحمن بن الحارث بن هشام، روى عنه حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن رافع(@)(@@) يروي عن سعيد بن كعب عداده في أهل الحجاز، روى عنه الثوري، وابن جريج.(@)PageV01P002(@)(@@) [ج 4: ص 71](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عبد الحميد بن جبير بن شيبة بن عثمان بن أبي طلحة بن عبد العزى حجازي(@)(@@) يروي عن سعيد بن المسيب، روى عنه ابن عيينة وهو الذي، روى عنه قرة بن خالد، روى عن صفية بنت 
ms1080	 شيبة، عن عائشة، أمه زينب بنت أبي عمرو بن فروة.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن عبد الرحمن بن فروة العجلي(@)(@@) يروي عن زيد بن أسلم، وأبي عمران الجوني، روى عنه أبو همام الصلت بن محمد الخاركي والخارك البسر كان يبيع البسر.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن يزيد الحزامي(@)(@@) من أهل الشام، كنيته أبو يزيد وقد قيل أبو عمرو، يروي عن رجاء بن حيوة، روى عنه رجاء بن أبي سلمة، وأهل الشام، مات سنة تسع وأربعين ومائة.(@)(@@) عبد الحميد(@)(@@) مولى إسماعيل بن عبيد الله من أهل الشام، يروي عن أبي عبد الله الصنابحي، روى عنه رجاء بن أبي سلمة.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن كرديد(@)(@@) يروي عن ثابت البناني، روى عنه شعبة.(@)(@@) (369) -[4: 71] حدثنا الحسن بن إسحاق الأصبهاني بالكرخ، قال: ثنا سلم بن جنادة، قال: ثنا وكيع بن الجراح في الدار، قال: ثنا شعبة، عن عبد الحميد بن كرديد، عن ثابت، عن أنس، قال: قال رسول الله صلى الله عليه وسلم: " قتل الصبر جهد البلاء "(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن أبي رباح الموصلي(@)(@@) يروي المراسيل، روى عنه أبو عوانة.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن دينار الزيادي(@)(@@) من أهل البصرة، يروي عن عبد الله بن الحارث أبي الوليد نسيب بن سيرين، وأبي رجاء العطاردي، روى عنه شعبة، وحماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن ذكوان(@)(@@) يروي عن سالم بن عبد الله، روى عنه يحيى بن أبي كثير.(@)PageV01P002(@)(@@) [ج 4: ص 72](@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن عقبة بن قيس بن طلق بن علي الحنفي(@)(@@) من أهل اليمامة، يروي عن قيس بن طلق، روى عنه ملازم بن عمرو.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن جرير الضبي(@)(@@) من أهل الكوفة، يروي عن أبيه، روى عنه ابنه جرير بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن عمران أبو الجويرية الجعفي(@)(@@) من أهل الكوفة سكن المدينة، يروي عن حماد بن أبي سليمان، روى عنه حماد بن خالد الخياط.(@)(@@)(@@)(@@) ||| AUTO عبد الحميد بن بهرام الفزاري(@)(@@) مولى فزارة من أهل المدائن، يروي عن شهر بن حوشب، روى عنه ابن المبارك، 