ms701	 .(@)(@@)(@@)(@@) $ ( 6530 ) قال النبي :(@)(@@) | 30 ( إني حين ضربت الضربة الاولى رفعت لي مدائن كسرى وما حولها ومدائن كثيرة حتى رأيتها بعيني ، ثم ضربت الضربة الثانية فرفعت لي مدائن قيصر وما حولها حتى رأيتها بعيني ، ثم ضربت الثالثة فرفعت لي مدائن الحبشة وما حولها من القرى حتى رأيتها بعيني ، دعوا الحبشة ما ودعوكم ، واتركوا الترك ما تركوكم ) )(@)(@@) ( ن ) عن رجل ( ز ) .(@)(@@)(@@)(@@) $ ( 6531 ) قال النبي :(@)(@@) | 30 ( إني خرجت لأخبركم بليلة القدر ، وإنه تلاحى فلان وفلان فرفعت ، وعسى أن يكون خيرا لكم ، فالتمسوها في السبع والتسع والخمس ) )(@)(@@) ( حم خ ) عن عبادة بن الصامت رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6532 ) قال النبي :(@)(@@) | 30 ( إني دخلت الكعبة ، ولو استقبلت من أمري ما استدبرت ما دخلتها ، إني أخاف أن أكون قد شققتتعلى أمتي من بعدي ) )(@)(@@) ( حم د ت ه ك ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6533 ) قال النبي :(@)(@@) | 30 ( إني ذاكر لك أمرا ، ولا عليك أن لا تعجلي حتى تستأمري أبويك ، إن الله تعالى قال : { يا أيها النبي قل لأزواجك } . . . إلى قوله { عظيما } ) )(@)(@@) ( ق ن ه ) عن عائشة رضي الله عنها قالت : لما أمر PageV02P444 رسول الله بتخيير أزواجه بدأ بي قال : فذكره ( ز ) .(@)(@@)(@@)(@@) $ ( 6534 ) قال النبي :(@)(@@) | 30 ( إني ذكرت وأنا في العصر شيئا من تبر كان عندنا فكرهت أن يبيت فأمرت بقسمه ) )(@)(@@) ( ن ) عن عقبة بن الحارث رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6535 ) قال النبي :(@)(@@) | 30 ( إني راكب غدا إلى يهود فمن انطلق منكم معي فلا تبدؤوهم بالسلام ، فإن سلموا عليكم فقولوا : وعليكم ) )(@)(@@) ( حم ه ) عن أبي عبد الرحمان الجهني ( حم ن ) والضياء عن أبي بصرة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6536 ) قال النبي :(@)(@@) | 30 ( إني رأيت البارحة عجبا رأيت رجلا من أمتي قد احتوشته ملائكة العذاب فجاءه وضوؤه فاستنقذه من ذالك ، ورأيت رجلا من أمتي قد بسط عليه عذاب القبر فجاءته صلاته فاستنقذته من ذالك ، ورأيت رجلا من أمتي قد احتوشته الشياطين فجاءه ذكر الله فخلصه منهم ، ورأيت رجلا من أمتي يلهث عطشا فجاءه صيام رمضان فسقاه ورأيت 
ms702	 رجلا من أمتي من بين يديه ظلمة ومن خلفه ظلمة وعن يمينه ظلمة وعن شماله ظلمة ، ومن فوقه ظلمة ومن تحته ظلمة فجاءته حجته وعمرته فاستخرجاه من الظلمة ، ورأيت رجلا من أمتي جاءه ملك الموت ليقبض روحه فجاءه بره لوالديه فرده عنه ، ورأيت رجلا من أمتي يكلم المؤمنين ولا يكلمونه فجاءته صلة الرحم فقالت : إن هاذا كان واصلا لرحمه فكلمهم وكلموه وصار معهم ، ورأيت رجلا من أمتي يأتي النبيين وهم حلق حلق كلما مر على حلقة طرد فجاءه اغتساله من الجنابة فأخذ بيده فأجلسه إلى جنبي ، ورأيت رجلا من أمتي يتقي وهج النار بيديه عن وجهه فجاءته صدقته فصارت ظلا على رأسه ، وسترا عن وجهه ، ورأيت رجلا من أمتي جاءته زبانية العذاب فجاءه أمره بالمعروف ونهيه عن المنكر فاستنقذاه من ذالك ، ورأيت رجلا من أمتي هوى في النار فجاءته دموعه اللاتي بكى بها في الدنيا من خشية الله فأخرجته من النار ، ورأيت رجلا من أمتي قد هوت PageV02P445 صحيفته إلى شماله فجاءه خوفه من الله تعالى فأخذ صحيفته فجعلها في يمينه ، ورأيت رجلا من أمتي قد خف ميزانه فجاءه أفراطه فثقلوا ميزانه ، ورأيت رجلا من أمتي على شفير جهنم فجاءه وجله من الله تعالى فاستنقذه من ذالك ، ورأيت رجلا من أمتي يرعد كما ترعد السعفة فجاءه حسن ظنه بالله تعالى فسكن رعدته ، ورأيت رجلا من أمتي يزحف على الصراط مرة ويحبو مرة فجاءته صلاته علي فأخذت بيده فأقامت على الصراط حتى جاز ، ورأيت رجلا من أمتي انتهى إلى أبواب الجنة فغلقت الأبواب دونه ، فجاءته شهادة أن لا إلاه إلا الله فأخذت بيده فأدخلته الجنة ) )(@)(@@) ( الحكيم طب ) عن عبد الرحمن بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6537 ) قال النبي :(@)(@@) | 30 ( إني رأيت الملائكة تغسل حنظلة بن أبي عامر بين السماء والأرض بماء المزن في صحاف الفضة ) )(@)(@@) ( ابن سعد ) عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6538 ) قال النبي :(@)(@@) | 30 ( أني رأيت في المنام كأن جبريل عند رأسي ، وميكائيل عند رجلي يقول أحدهما لصاحبه 
ms703	 : اضرب له مثلا ، اسمع سمعت أذنك ، واعقل عقل قلبك ، إنما مثلك ومثل أمتك كمثل ملك اتخذ دارا ثم بنى فيها بيتا ، ثم جعل فيها مائدة ، ثم بعث رسولا يدعو الناس إلى طعامه ، فمنهم من أجاب الرسول ، ومنهم من تركه ، فالله هو الملك ، والدار الإسلام ، والبيت الجنة ، وأنت يا محمد رسول من أجابك دخل الإسلام ، ومن دخل الإسلام دخل الجنة ، ومن دخل الجنة أكل ما فيها ) )(@)(@@) ( خ ت ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6539 ) قال النبي :(@)(@@) | 30 ( إني سألت ربي أولاد المشركين فأعطانيهم خدما لأهل الجنة لأنهم لم يدركوا ما أدرك آباؤهم من الشرك ، ولأنهم في الميثاق الأول ) )(@)(@@) ( الحكيم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6540 ) قال النبي :(@)(@@) | 30 ( إني سألت ربي وشفعت لامتي فأعطاني ثلث أمتي PageV02P446 فخررت ساجدا لربي شكرا ، ثم رفعت رأسي فسألت ربي لامتي فأعطاني ثلث أمتي فخررت ساجدا لربي شكرا ، ثم رفعت رأسي فسألت ربي لامتي فأعطاني الثلث الآخر فخررت ساجدا لربي ) )(@)(@@) ( د ق ) عن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6541 ) قال النبي :(@)(@@) | 30 ( إني صليت صلاة رغبة ورهبة وسألت الله عز وجل لأمتي ثلاثا فأعطاني اثنتين ورد علي واحدة ، سألته أن لا يسلط عليهم عدوا من غيرهم فأعطانيها ، وسألته أن لا يهلكهم غرقا فأعطانيها ، وسألته أن لا يجعل بأسهم بينهم فردها علي ) )(@)(@@) ( حم ش ه ) عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6542 ) قال النبي :(@)(@@) | 30 ( إني عدل لا أشهد إلا على عدل ) )(@)(@@) ( ابن قانع ) عن النعمان بن بشير عن أبيه رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6543 ) قال النبي :(@)(@@) | 30 ( إني على الحوض حتى أنظر من يرد علي منكم ، وسيؤخذ أناس دوني فأقول : يا رب مني ومن أمتي ، فيقال : هل شعرت ما عملوا بعدك ؟ والله ما برحوا بعدك يرجعون على أعقابهم ) )(@)(@@) ( ق ) عن أسماء بنت أبي بكر رضي الله عنهما ( حم م ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6544 ) قال النبي :(@)(@@) | 30 ( إني عند الله في أم الكتاب لخاتم النبيين ، وإن آدم لمنجدل في طينته ، وسأخبركم بتأويل ذالك ، أنا دعوة 
ms704	 أبي إبراهيم ، وبشارة عيسى بي ، ورؤيا أمي التي رأت حين وضعت أنه خرج منها نور أضاءت له قصور الشام ، وكذالك أمهات النبيين يرين ) )(@)(@@) ( حم طب ك حل هب ) عن عرباض بن سارية رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6545 ) قال النبي :(@)(@@) | 30 ( إني فرطكم على الحوض ، من مر بي شرب ، ومن PageV02P447 شرب لم يظمأ أبدا ، وليردن علي أقوام أعرفهم ويعرفوني ثم يحال بيني وبينهم ، فأقول : إنهم مني فيقال : إنك لا تدري ما أحدثوا بعدك ، فأقول : سحقا سحقا لمن غير بعدي ) )(@)(@@) ( حم ق ) عن سهل بن سعد وأبي سعيد رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 6546 ) قال النبي :(@)(@@) | 30 ( إني فرطكم على الحوض ، وإن عرضه كما بين أيلة إلى الجحفة ، إني لست أخشى عليكم أن تشركوا بعدي ولاكني أخشى عليكم الدنيا أن تنافسوا فيها وتقتتلوا فتهلكوا كما هلك من كان قبلكم ) )(@)(@@) ( م ) عن عقبة بن عامر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6547 ) قال النبي :(@)(@@) | 30 ( إني فيما لم يوح إلي كأحدكم ) )(@)(@@) ( طب ) و ابن شاهين في السنة ( ز ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6548 ) قال النبي :(@)(@@) | 30 ( إني اتخذت خاتما من ورق ونقشت فيه : محمد رسول الله ، فلا ينقشن أحد على نقق خاتمي ) )(@)(@@) ( حم ق حب ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6549 ) قال النبي :(@)(@@) | 30 ( إني قد بدنت فإن ركعت فاركعوا ، وإذا رفعت فارفعوا ، وإذا سجدت فاسجدوا ، ولا ألفين رجلا سبقني إلى الركوع ولا إلى السجود ) )(@)(@@) ( ه ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6550 ) قال النبي :(@)(@@) | 30 ( إني كرهت أن أذكر الله إلا على طهر ) )(@)(@@) ( د ن حب ك ) عن المهاجر بن قنفذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6551 ) قال النبي :(@)(@@) | 30 ( إني كنت أعلمتها ، يعني الساعة التي في الجمعة ثم أنسيتها كما أنسيت ليلة القدر ) )(@)(@@) ( ه و ابن خزيمة ك هب ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@) PageV02P448(@)(@@)(@@)(@@) $ ( 6552 ) قال النبي :(@)(@@) | 30 ( إني كنت أمرتكم أن تحرقوا فلانا وفلانا بالنار ، وإن النار لا يعذب بها إلا الله ، فإن أخذتموهما فاقتلوهما ) )(@)(@@) ( حم خ ت 
ms705	 ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6553 ) قال النبي :(@)(@@) | 30 ( إني كنت نهيتكم أن تأكلوا لحوم الأضاحي إلا ثلاثا ، فكلوا وأطعموا وادخروا ما بدا لكم ، وذكرت لكم أن لا تنتبذوا في الظروف : الدباء والمزفت والنقير والحنتم ، انتبذوا فيما رأيتم واجتنبوا كل مسكر ، ونهيتكم عن زيارة القبور ، فمن أراد أن يزور فليزر ، ولا تقولوا هجرا ) )(@)(@@) ( ن ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6554 ) قال النبي :(@)(@@) | 30 ( إني كنت نهيتكم عن زيارة القبور فزوروها لتذكركم زيارتها خيرا ، وكنت نهيتكم عن لحوم الأضاحي بعد ثلاث فكلوا وأمسكوا ما شئتم ، وكنت نهيتكم عن الأشربة في الأوعية فاشربوا في أي وعاء شئتم ، ولا تشربوا مسكرا ) )(@)(@@) ( حم م ت ن ) عن بريدة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6555 ) قال النبي :(@)(@@) | 30 ( إني كنت نهيتكم عن لحوم الأضاحي فوق ثلاث كيما تسعكم ، فقد جاء الله عز وجل بالخير فكلوا وتصدقوا وادخروا ، وإن هاذه الأيام أيام أكل وشرب وذكر الله ) )(@)(@@) ( حم م ن ه ) عن نبيشة الهذلي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6556 ) قال النبي :(@)(@@) | 30 ( إني لأبغض المرأة تخرج من بيتها تجر ذيلها تشكو زوجها ) )(@)(@@) ( طب ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6557 ) قال النبي :(@)(@@) | 30 ( إني لأتوب إلى الله تعالى في اليوم سبعين مرة ) )(@)(@@) ( ن حب ) عن أنس رضي الله عنه ( ز ) .(@)(@@) PageV02P449(@)(@@)(@@)(@@) $ ( 6558 ) قال النبي :(@)(@@) | 30 ( إني لأدخل في الصلاة وأنا أريد إطالتها ، فأسمع بكاء الصبي فأتجوز في صلاتي مما أعلم من شدة وجد أمه من بكائه ) )(@)(@@) ( ش حم ق ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6559 ) قال النبي :(@)(@@) | 30 ( إني لأراكم من ورائي كما أراكم ) )(@)(@@) ( خ ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6560 ) قال النبي :(@)(@@) | 30 ( إني لأرجو أن أفارقكم ولا يطلبني أحد منكم بمظلمة ظلمته ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6561 ) قال النبي :(@)(@@) | 30 ( إني لأرجو أن لا تعجز أمتي عند ربها أن يؤخرهم نصف يوم ) )(@)(@@) ( حم د ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6562 ) قال النبي :(@)(@@) | 30 ( إني لأرجو أن لا 
ms706	 يدخل النار أحد إن شاء الله ممن شهد بدرا والحديبية ) )(@)(@@) ( حم ه طب ) عن حفصة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6563 ) قال النبي :(@)(@@) | 30 ( إني لأستغفر الله في اليوم سبعين مرة ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6564 ) قال النبي :(@)(@@) | 30 ( إني لأسمع بكاء الصبي فأتجوز في الصلاة ) )(@)(@@) ( ه ) عن عثمان بن أبي العاصي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6565 ) قال النبي :(@)(@@) | 30 ( إني لأشفع يوم القيامة لأكثر مما على وجه الأرض من شجر وحجر ومدر ) )(@)(@@) ( حم ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6566 ) قال النبي :(@)(@@) | 30 ( إني لأعلم آخر أهل الجنة دخولا الجنة ، وآخر أهل PageV02P450 النار خروجا من النار ، رجل يؤتى به يوم القيامة فيقال : اعرضوا عليه صغار ذنوبه وارفعوا عنه كبارها فتعرض عليه صغار ذنوبه فيقال : عملت يوم كذا وكذا ، كذا وكذا ، وعملت يوم كذا وكذا ، كذا وكذا ، فيقول : نعم ، لا يستطيع أن ينكر وهو مشفق من كبار ذنوبه أن تعرض عليه ، فيقال له : فإن لك مكان كل سيئة حسنة ، فيقول : يا رب عملت أشياء لا أراها هاهنا ) )(@)(@@) ( حم م ت ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6567 ) قال النبي :(@)(@@) | 30 ( إني لأعرف أصوات رفقة الأشعريين بالقرآن حين يدخلون بالليل ، وأعرف منازلهم من أصواتهم بالقرآن بالليل ، وإن كنت لم أر منازلهم حين نزلوا بالنهار ) )(@)(@@) ( ق ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6568 ) قال النبي :(@)(@@) | 30 ( إني لأعرف حجرا بمكة كان يسلم علي قبل أن أبعث ) )(@)(@@) ( حم م ت ) عن جابر بن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6569 ) قال النبي :(@)(@@) | 30 ( إني لاعطي رجالا وأدع من هو أحب إلي منهم ، لا أعطيه شيئا مخافة أن يكبوا في النار على وجوههم ) )(@)(@@) ( حم ن ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6570 ) قال النبي :(@)(@@) | 30 ( إني لأعلم آخر أهل النار خروجا منها ، وآخر أهل الجنة دخولا الجنة رجل يخرج من النار حبوا فيقول الله تبارك وتعالى له : اذهب فادخل الجنة قال : فيأتيها فيخيل إليه أنها ملأى فيرجع فيقول : يا رب وجدتها ملأى 
ms707	 ، فيقول الله تبارك وتعالى له : اذهب فادخل الجنة فإن لك مثل الدنيا وعشرة أمثالها ، قال فيقول : أتسخر بي وأنت الملك ) )(@)(@@) ( حم ق ت ه ) عن ابن مسعود PageV02P451 رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6571 ) قال النبي :(@)(@@) | 30 ( إني لأعلم إذا كنت عني راضية وإذا كنت غضبى ، قالت : فقلت : من أين تعرف ذالك ؟ فقال : أما إذا كنت عني راضية فإنك تقولين لا ورب محمد ، وإذا كنت علي غضبى ، قلت : لا ورب إبراهيم قالت : قلت : أجل والله يا رسول الله ما أهجر إلا اسمك ) )(@)(@@) ( حم ق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6572 ) قال النبي :(@)(@@) | 30 ( إني لأعلم كلمة لو قالها لذهب عنه ما يجد ، لو قال : أعوذ بالله من الشيطان الرجيم ذهب عنه ما يجد ) )(@)(@@) ( حم ق ت ) عن سل يمان بن صرد ( حم د ت ) عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6573 ) قال النبي :(@)(@@) | 30 ( إني لأعلم كلمة لا يقولها عبد عند موته إلا كانت نورا لصحيفته ، وإن جسده وروحه ليجدان له روحا عند الموت ) )(@)(@@) ( ن ه حب ) عن طل حة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6574 ) قال النبي :(@)(@@) | 30 ( إني لأقوم للصلاة وأنا أريد أن أطول فيها ، فأسمع بكاء الصبي فأتجوز في صلاتي كراهية أن أشق على أمه ) )(@)(@@) ( حم خ ش د ن ه ) عن أبي قتادة الأنصاري عن أبيه رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6575 ) قال النبي :(@)(@@) | 30 ( إني لأمزح ولا أقول إلا حقا ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما ( خط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6576 ) قال النبي :(@)(@@) | 30 ( إني لانذركموه ، يعني الدجال وما من نبي إلا قد أنذره قومه ، ولقد أنذره نوح قومه ، ولاكن سأقول لكم فيه قولا لم يقله نبي لقومه : تعلمون إنه أعور ، وإن الله عز وجل ليس بأعور ) )(@)(@@) ( ق د ت ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@) PageV02P452(@)(@@)(@@)(@@) $ ( 6577 ) قال النبي :(@)(@@) | 30 ( إني لأنظر إلى شياطين الجن والإنس قد فروا من عمر ) )(@)(@@) ( ت ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6578 ) قال النبي :(@)(@@) | 30 ( إني لأنقلب إلى 
ms708	 أهلي فأجد التمرة ساقطة على فراشي فأرفعها لآكلها ثم أخشى أن تكون صدقة فالقيها ) )(@)(@@) ( حم ق هب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6579 ) قال النبي :(@)(@@) | 30 ( إني لبعقر حوضي يوم القيامة أذود الناس لأهل اليمن وأضرب بعصاي حتى يرفض عليهم فسئل عن عرضه ؟ فقال : من مقامي إلى عمان ، وسئل عن شرابه ؟ فقال : شرابه أشد بياضا من اللبن وأحلى من العسل يغت فيه ميزابان يمدانه من الجنة ، أحدهما من ذهب ، والآخر من ورق ) )(@)(@@) ( حم م أبو عوانة ) عن ( حب ) عن ثوبان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6580 ) قال النبي :(@)(@@) | 30 ( لا تواصلوا ، قالوا : إنك تواصل ، قال : إني لست مثلكم ، إني أبيت يطعمني ربي ويسقيني ) )(@)(@@) ( حم ق ) عن أنس ( خ ) عن ابن عمر وعن أبي سلمة وعن أبي هريرة وعن عائشة رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 6581 ) قال النبي :(@)(@@) | 30 ( إني لكم فرط على الحوض فاياي لا يأتين أحدكم فيذب عني كما يذب البعير الضال فأقول : فيم هاذا ؟ فيقال : إنك لا تدري ما أحدثوا بعدك ، فأقول : سحقا ) )(@)(@@) ( م ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6582 ) قال النبي :(@)(@@) | 30 ( إني لم أبعث بقطيعة رحم ) )(@)(@@) ( طب ) عن حصين بن وحوح الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6583 ) قال النبي :(@)(@@) | 30 ( إني لم أبعث لعانا ) )(@)(@@) ( طب ) عن كريز بن سامة رضي PageV02P453 الله عنه .(@)(@@)(@@)(@@) $ ( 6584 ) قال النبي :(@)(@@) | 30 ( إني لم أبعث لعانا وإنما بعثت رحمة ) )(@)(@@) ( خد م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6585 ) قال النبي :(@)(@@) | 30 ( إني لم أؤمر أن أنقب على قلوب الناس ولا أشق بطونهم ) )(@)(@@) ( حم خ ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6586 ) قال النبي :(@)(@@) | 30 ( إني نسيت أن آمرك أن تخمر القرنين ، فإنه ليس ينبغي أن يكون في البيت شيء يشغل المصلي ) )(@)(@@) ( د ) عن عثمان الحجبي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6587 ) قال النبي :(@)(@@) | 30 ( إني نهيت عن زبد المشركين ) )(@)(@@) ( د ت ) عن عياض بن حمار المجاشعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6588 ) قال النبي :(@)(@@) | 30 ( إني نهيت عن قتل المصلين ) )(@)(@@) ( د ) عن أبي هريرة 
ms709	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6589 ) قال النبي :(@)(@@) | 30 ( إني والله إن شاء الله لا أحلف على يمين فأرى غيرها خيرا منها إلا كفرت عن يمين وأتيت الذي هو خير ) )(@)(@@) ( ق د ه ) عن أبي موسى ا رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6590 ) قال النبي :(@)(@@) | 30 ( إني والله ما قمت مقامي وهاذا لأمر ينفعكم لرغبة ولا لرهبة ولاكن تميما الداري أتاني فأخبرني خبرا منعني القيلولة من الفرح وقرة العين ، فأحببت أن أنشر عليكم فرح نبيكم ، ألا إن ابن عم لتميم الداري أخبرني أن الريح ألجأتهم إلى جزيرة لا يعرفونها فقعدوا في قوارب السفينة حتى خرجوا إلى الجزيرة فإذا هم بشيء أهدب أسود كثير الشعر قالوا له : ما أنت ؟ قال : أنا الجساسة ، PageV02P454 قالوا : أخبرينا ، قالت : ما أنا بمخبرتكم شيئا ولا سائلتكم ، ولاكن هاذا الدير قدرمقتموه فأتوه فإن فيه رجلا بالأشواق إلى أن تخبروه ويخبركم فأتوه فدخلوا عليه فإذا هم بشيخ موثق شديد الوثاق يظهر الحزن شديد التشكي فقال لهم : من أين ؟ قالوا : من الشام ، قال : ما فعلت العرب ؟ قالوا : نحن قوم من العرب عم تسأل ؟ قال : ما فعل هاذا الرجل الذي خرج فيكم ؟ قالوا : خيرا ، ناوى قوما فأظهره الله عليهم ، فأمرهم اليوم جميع أن يعبدوا الله ، إلاههم واحد ودينهم واحد ، قال : ما فعلت عين زغر ؟ قالوا : خيرا يسقون منها زروعهم ويستقون منها لسقيهم ، قال : ما فعل نخل بين عمان وبيسان ؟ قالوا : يطعم ثمره كل عام ، قال : فما فعلت بحيرة الطبرية ؟ قالوا : تدفق جنباتها من كثرة الماء ، قال : فزفر ثلاث زفرات ثم قال : لو انفلت من وثاقي هاذا لم أدع أرضا إلا وطئتها برجلي هاتين إلا طيبة ليس لي عليها سبيل قال النبي إلى هاذا ، ينتهي فرحي ، هذه طيبة والذي نفسي بيده ما فيها طريق ضيق ولا واسع ولا سهل ولا جبل إلا وعليه ملك شاهر سيفه إلى يوم القيامة ) )(@)(@@) ( حم ه ) عن فاطمة بنت قيس رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 6591 ) قال النبي :(@)(@@) | 30 ( إني وإن داعبتكم فلا أقول إلا حقا ) )(@)(@@) ( حم ت ) عن أبي 
ms710	 هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6592 ) قال النبي :(@)(@@) | 30 ( إني وهبت لخالتي غلاما وأنا أرجو أن يبارك الله لها فيه ، فقلت لها لا تسلميه حجاما ولا صائغا ولا قصابا ) )(@)(@@) ( حم د ق ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6593 ) قال النبي :(@)(@@) | 30 ( إني لا أخيس بالعهد ولا أحبس البرد ) )(@)(@@) ( حم PageV02P455 د ن حب طب ك ق ) عن أبي رافع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6594 ) قال النبي :(@)(@@) | 30 ( إني لا أدري ما قدر بقائي فيكم فاقتدوا باللذين من بعدي وأشار إلى أبي بكر وعمر ، وتمسكوا بعهد عمار وما حدثكم ابن مسعود فصدقوه ) )(@)(@@) ( حم ع ت ه حب ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6595 ) قال النبي :(@)(@@) | 30 ( إني لا أرى طلحة إلا قد حدث فيه الموت فآذنوني به وعجلوا فإنه لا ينبغي لجيفة مسلم أن تحبس بين ظهراني أهله ) )(@)(@@) ( د ) عن حصين بن وحوح رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6596 ) قال النبي :(@)(@@) | 30 ( إني لا أشهد على جور ) )(@)(@@) ( ق ن ك ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6597 ) قال النبي :(@)(@@) | 30 ( إني لا أصافح النساء ) )(@)(@@) ( ت ن ه ) عن أميمة بنت رقيقة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6598 ) قال النبي :(@)(@@) | 30 ( إني لا أقبل هدية مشرك ) )(@)(@@) ( طب ) عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6599 ) قال النبي :(@)(@@) | 30 ( أنهى عن الكي وأكره شرب الحميم ) )(@)(@@) ( ابن قانع ) عن سعد الظفري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6600 ) قال النبي :(@)(@@) | 30 ( أنهى عن كل مسكر أسكر عن الصلاة ) )(@)(@@) ( م ) عن أبي بردة عن أبيه أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6601 ) قال النبي :(@)(@@) | 30 ( أنهاكم عن الزور ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6602 ) قال النبي :(@)(@@) | 30 ( أنهاكم عن صيام يومين : الفطر والأضحى ) )(@)(@@) ( ع ) PageV02P456 عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6603 ) قال النبي :(@)(@@) | 30 ( أنهاكم عن قليل ما أسكر كثيره ) )(@)(@@) ( ن ) عن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6604 ) قال النبي :(@)(@@) | 30 ( أنهر الدم بما شئت واذكر اسم الله عليه ) )(@)(@@) ( ن ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6605 ) قال النبي :(@)(@@) | 30 ( انهسوا 
ms711	 اللحم نهسا فإنه أشهى وأهنا وأمرأ ) )(@)(@@) ( حم ت ك ) عن صفوان بن أمية رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 6606 ) قال النبي & : ' أنهكوا الشوارب واعفوا اللحى ' ( خ ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6607 ) قال النبي :(@)(@@) | 30 ( إناء كاناء وطعام كطعام ) )(@)(@@) ( ن ) عن عائشة رضي الله عنها قالت : أهدت صفية إلى النبي إناء فيه طعام فما ملكت نفسي أن كسرته فسألت النبي عن كفارته فقال : فذكره .(@)(@@)(@@)(@@) $ ( 6608 ) قال النبي :(@)(@@) | 30 ( انتبذوا في الأسقية ولا تنتبذوا في الجر ولا الدباء ولا المزفت ولا النقير فإني نهيت عن الخمر والميسر والكوبة ، وهي الطبل ، وكل مسكر حرام ، فإذا اشتد صبوا عليه الماء ، فإذا اشتد فأهريقوه ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6609 ) قال النبي :(@)(@@) | 30 ( انتدب لها ، يعني : ناقة صالح رجل ذو عز في قومه كأبي زمعة ) )(@)(@@) ( خ ) عن عبد الله بن زمعة رضي الله عنه .(@)(@@) PageV02P457(@)(@@)(@@)(@@) $ ( 6610 ) قال النبي :(@)(@@) | 30 ( انتسب رجلان من بني إسرائيل على عهد موسى ، أحدهما مسلم والآخر مشرك ، فانتسب المشرك فقال : أنا فلان ابن فلان حتى عد تسعة آباء ثم قال لصاحبه انتسب لا أم لك ، قال : أنا فلان ابن فلان وأنا بريء مما وراء ذالك ، فنادى موسى عليه السلام في الناس فجمعهم ثم قال : قد قضى بينكما ، أما الذي انتسب إلى تسعة آباء فأنت فوقهم العاشر في النار ، وأما الذي انتسب إلى أبويه ، امرؤ من أهل الإسلام ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6611 ) قال النبي :(@)(@@) | 30 ( انبسطوا بها ولا تدبوا دبيب اليهود بجنائزها ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6612 ) قال النبي :(@)(@@) | 30 ( انتهيت إلى سدرة المنتهى فإذا نبقها مثل الجرار ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6613 ) قال النبي :(@)(@@) | 30 ( انحر سمينها ، واحمل على نخبتها ، واحلب يوم الماء تدخل الجنة بسلام ) )(@)(@@) البغوي ( طب ) عن الشريد بن سويد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6614 ) قال النبي :(@)(@@) | 30 ( انحرها ثم اغمس نعلها في دمها ، ثم خل بين الناس وبينها فيأكلوها ) )(@)(@@) ( ت ) حسن صحيح ( حب ) عن ناجية بن 
ms712	 كعب الخزاعي رضي الله عنه قال : قلت : يا رسول الله كيف أصنع بما عطب من البدن ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 6615 ) قال النبي :(@)(@@) | 30 ( أنذرتكم النار ، أنذرتكم النار ، أنذرتكم النار ) ، فما زال يقولها حتى لو كان في مقامي هاذا لسمعه أهل السوق وحتى سقطت خمصية كانت عليه عند رجليه . ( حم هق ) عن ال$ نعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6616 ) قال النبي :(@)(@@) | 30 ( انزع عنك الجبة ، واغسل عنك الصفرة ، وما كنت PageV02P458 صانعا في حجتك فاصنعه في عمرتك ) )(@)(@@) ( ن ) عن صفوان بن يعلى ا عن أبيه أن رجلا أتى النبي وهو بالجعرانة قد أهل بالعمرة وهو مصفر لحيته ورأسه وعليه جبة فقال : يا رسول الله إني أحرمت بمعمرة وأنا كما ترى قال : فذكره .(@)(@@)(@@)(@@) $ ( 6617 ) قال النبي :(@)(@@) | 30 ( انزعيه فإنه يذكرني الدنيا ) )(@)(@@) ( ت ) حسن ( ن ) عن عائشة رضي الله عنها قالت : كان لنا قرام ستر فيه تماثيل على بابي فقال النبي قال : فذكره .(@)(@@)(@@)(@@) $ ( 6618 ) قال النبي :(@)(@@) | 30 ( انزعوا هاذا واجعلوا الأول مكانه ، إني كنت أنظر إليه وأنا أصلي ) )(@)(@@) ابن المبارك عن أبي النصر رضي الله عنه قال : انقطع شراك نعل رسول الله فوصلته بشيء جديد ، فجعل ينظر إليه وهو يصلي ، فلما قضى صلاته قال : فذكره .(@)(@@)(@@)(@@) $ ( 6619 ) قال النبي :(@)(@@) | 30 ( انزل ليلة ثلاث وعشرين فصلها ، وإن أحببت أن تستتم إلى آخر الشهر فافعل ، وإن أحببت أن ترجع إلى أهلك بليل فاصنع ) )(@)(@@) ( طب ) عن عبد الله بن أنيس السلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6620 ) قال النبي :(@)(@@) | 30 ( انزل من على القبر لا تؤذي صاحب القبر ولا يؤذيك ) )(@)(@@) الحكيم ( طب ك ) عن عمارة بن حزم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6621 ) قال النبي :(@)(@@) | 30 ( أنزل الله علي هاذه الآية مسجلة في سورة الرحمان للكافر والمسلم : هل جزاء الإحسان إلا الإحسان ) )(@)(@@) أبو الشيخ وابن مردويه ( هب ) وضعفه عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6622 ) قال النبي :(@)(@@) | 30 ( انزل بيت المقدس ولعل الله يرزقك ذرية يعمرون ذالك المسجد ، يغدون إليه ويروحون ) )(@)(@@) عن ابن سعد عن ذي الأصابع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6623 ) قال 
ms713	 النبي :(@)(@@) | 30 ( أنزل الله تعالى في بعض كتابه وأوحى إلى بعض PageV02P459 أنبيائه : قل للذين يتفقهون لغير الله ويتعلمون لغير العمل ويطلبون الدنيا بعمل الآخرة ، ويلبسون للناس مسوك الكباش ، وقلوبهم قلوب الذئاب ، ألسنتهم أحلى من العسل ، وقلوبهم أمر من الصبر ، إياي يخدعون ؟ أو بي يستهزؤون ؟ فبي حلفت لأتيحن فتنة تذر الحليم فيهم حيران ) )(@)(@@) أبو سعيد النقاش في معجمه وابن النجار عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6624 ) قال النبي :(@)(@@) | 30 ( انزل يا عامر فأسمعنا من هيهاتك ) )(@)(@@) ( طب ) عن سل مة بن الأكوع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6625 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على سبعة أحرف ، والمراء في القرآن كفر ، فما عرفتم منه فاعملوا به ، وما جهلتم منه فردوه إلى عالمه ) )(@)(@@) ابن جرير ( حب ) وأبو نصر السجزي في الإبانة عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6626 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على سبعة أحرف كلها شاف كاف ) )(@)(@@) ابن جرير عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6627 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على سبعة أحرف أيها قرأت أصبت ) )(@)(@@) ( حم ) و ابن جرير ( طب ) وأبو نصر السجزي في الإبانة عن أم أيوب رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6628 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على سبعة أحرف : آمر وزاجر ، وترغيب وترهيب ، وجدل وقصص ، ومثل ) )(@)(@@) ابن جرير عن أبي قلابة مرسلا .(@)(@@)(@@)(@@) $ ( 6629 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن على أربعة أحرف : حلال وحرام ، لا يعذر أحد بالجهالة به ، وتفسير تفسره العرب وتفسير تفسره العلماء ، أو متشابه لا يعلمه إلا الله ، ومن ادعى علمه سوى الله ، فهو كاذب ) )(@)(@@) ابن جرير وابن نصر السجزي عن ابن عباس رضي الله عنهما ، وقال ابن جرير : في إسناده نظر . ورواه ابن جرير وابن المنذر وابن الأنباري في الوقف عن ابن عباس رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 6630 ) قال النبي :(@)(@@) | 30 ( أنزل القرآن في ثلاثة أمكنة : بمكة والمدينة والشام ) )(@)(@@) ( كر ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6631 ) قال النبي :(@)(@@) | 30 ( أنزلت علي النبوة في ثلاثة أمكنة : بمكة والمدينة وبالشام ) )(@)(@@) يعقوب بن سفيان ( كر ) عن أبي أمامة رضي 
ms714	 الله عنه .(@)(@@)(@@)(@@) $ ( 6632 ) قال النبي :(@)(@@) | 30 ( انصرفي أيتها المرأة وأعلمي من وراءك من النساء أن حسن تبعل إحداكن لزوجها وطلبها مرضاته ، واتباعها موافقته يعدل ذالك كله ) )(@)(@@) ابن عساكر عن أسماء بنت يزيد الأنصاري رضي الله عنها أنها قالت : يا رسول الله أنا وافدة النساء إليك ، إن الرجال فضلوا علينا بالجمع والجماعات ، وعيادة المريض ، وشهود الجنائز والحج والعمرة والجهاد والرباط قال : فذكره .(@)(@@)(@@)(@@) $ ( 6633 ) قال الن بي :(@)(@@) | 30 ( أنطاك الله ذالك وأعطاك ما احتسبت أجمع ) )(@)(@@) ( ش ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6634 ) قال النبي :(@)(@@) | 30 ( انطلق فاقرأهااعلى الناس ، فإن الله يثبت لسانك ، ويهدي قلبك ، إن الناس سيتقاضون إليك فإذا أتاك الخصمان فلا تقض لواحد حتى تستمع كلام الآخر فإنه أجدر أن تعلم لمن الحق ) )(@)(@@) ( حب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6635 ) قال النبي :(@)(@@) | 30 ( انطلقي فاختضبي ثم تعالي حتى أبايعك ) )(@)(@@) ابن سعد ( طب ) عن السوداء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6636 ) قال النبي :(@)(@@) | 30 ( انظر ما يؤذي الناس فاعزله عن طريقهم ) )(@)(@@) ( ع ) عن أبي برزة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6637 ) قال النبي :(@)(@@) | 30 ( انظر إليها فإن في أعين الأنصار شيئا ) )(@)(@@) ( ن حب ) عن PageV02P461 أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6638 ) قال النبي :(@)(@@) | 30 ( انظر هل ترى في السماء نجما ؟ قال : أرى الثريا ، قال : أما إنه يلي هاذه الأمة بعددها من صلبك ، اثنين في فتنة ) )(@)(@@) ( حم طب ك ض ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6639 ) قال النبي :(@)(@@) | 30 ( انظر يا أبا مسعود لالفينك تجيء يوم القيامة على ظهرك بعير له رغاء من إبل الصدقة قد غللته ) )(@)(@@) ( طب ) عن أبي مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6640 ) قال النبي :(@)(@@) | 30 ( انظروا إلى هاذا الرجل دخل المسجد بهيئة بذة فرجوت أن تفطنوا له فتصدقوا عليه أو تكسوه فلم تفعلوا ، فقلت : تصدقوا ، فأعطوه ثوبين ، ثم قلت : تصدقوا فألقى أحد ثوبيه خذ ثوبك ) )(@)(@@) ( الشافعي ( حم ع هق ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6641 ) قال النبي :(@)(@@) | 30 ( انظروا فإن كان أنبت الشعر فاقتلوه ، وإلا فلا تقتلوه ) )(@)(@@) ( حب ) عن عطية القرظي رضي 
ms715	 الله عنه .(@)(@@)(@@)(@@) $ ( 6642 ) قال النبي :(@)(@@) | 30 ( انظروا حب الأنصار التمر ) )(@)(@@) ( حم م ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6643 ) قال النبي :(@)(@@) | 30 ( انظروا إلى هاذا الذي قد نور الله قلبه ، لقد رأيته بين أبوين يعذونه بأطيب الطعام والشراب ، ولقد رأيت عليه حلة شراها بمائتي درهم ، فدعاه حب الله وحب رسوله إلى ما ترون ) )(@)(@@) ( حل ) عن عمر ( هق ) وابن عساكر عن ابن عمر رضي الله عنهما قال : نظر النبي إلى مصعب بن عمير رضي الله عنه مقبلا عليه إهاب كبب قد تنطق به قال : فذكره .(@)(@@) PageV02P462(@)(@@)(@@)(@@) $ ( 6644 ) قال النبي :(@)(@@) | 30 ( انظروا إلى هاذا المحرم ما يصنع ) )(@)(@@) ( حم ه ك ) عن أسماء بنت أبي بكر رضي الله عنهما أن أبا بكر ضرب غلامه فقال رسول الله : فذكره .(@)(@@)(@@)(@@) $ ( 6645 ) قال النبي :(@)(@@) | 30 ( انظروا من تجالسون وعن من تأخذون دينكم ، فإن الشياطين يتصورون في آخر الزمان في صورة الرجال ، فيقولون حدثنا وأخبرنا ، فإذا جلستم إلى رجل فسلوه عن اسمه واسم أبيه وعشيرته فيفقدونه إذا غاب ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6646 ) قال النبي :(@)(@@) | 30 ( انظروا دور من تعمرون ، وأرض من تسكنون ، وفي طريق من تمشون ) )(@)(@@) الديلمي عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6647 ) قال النبي :(@)(@@) | 30 ( انفر الشيطان ، انفر الشيطان ، انفر الشيطان ، يا عمر القرآن كله صواب ما لم يجعل المغفرة عذابا والعذاب مغفرة ) )(@)(@@) البغوي عن إسحاق بن حارثة الأنصاري عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6648 ) قال النبي :(@)(@@) | 30 ( أنفقوا وارضخوا ولا تحصوا فيحصى عليكم ، ولا توعوا فيوعى عليكم ) )(@)(@@) العسكري في الأمثال عن أسماء بنت أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6649 ) قال النبي :(@)(@@) | 30 ( أنفقها على عيالك ، فإنما الصدقة عن ظهر غنى وابدأ بمن تعول ) )(@)(@@) عبد بن حميد عن جابر رضي الله عنهما أن رجلا أعتق غلاما عن دبر فاحتاج مولاه فأمره النبي أن يبيعه فباعه بثمانمائة درهم قال : فذكره .(@)(@@)(@@)(@@) $ ( 6650 ) قال النبي :(@)(@@) | 30 ( أنفقي عليهم فلك أجر ما أنفقت عليهم ) )(@)(@@) ( خ م ) عن أم سلمة قالت : قلت : يا رسول الله 
ms716	 ألي أجر أن أنفق على بني أبي سلمة إنما هم PageV02P463 بني ؟ قال : فذكره . ( حم ) وعن رابطة امرأة عبد الله بن مسعود رضي الله عنهما مثله .(@)(@@)(@@)(@@) $ ( 6651 ) قال النبي :(@)(@@) | 30 ( انقوها غسلا واصبخوا فيها ) )(@)(@@) ( ت ) عن أبي ثعلبة الخشني رضي الله عنه أن رسول الله سئل عن قدور المجوس قال : فذكره .(@)(@@)(@@)(@@) $ ( 6652 ) قال النبي :(@)(@@) | 30 ( أنقوا أفواهكم بالخلال فإنها مسكن الملكين الحافظين الكاتبين ، وإن مدادهما الريق ، وقلمهما اللسان ، وليس شيء أشد عليهما من فضل الطعام في الفم ) )(@)(@@) الديلمي عن هريرة بن حسان بن حكيم من ولد سعد بن معاذ عن أبيه عن جده سعد بن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6653 ) قال النبي :(@)(@@) | 30 ( انكحوا الأيامى منكم ، قالوا : ما العلائق ؟ قال : ما تراضى عليه أهلوهم ) )(@)(@@) ( عد هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6654 ) قال النبي :(@)(@@) | 30 ( أنكحوا أسامة بن زيد فإنه عربي صليب ) )(@)(@@) ابن عساكر عن إسماعيل بن محمد بن سعد مرسلا .(@)(@@)(@@)(@@) $ ( 6655 ) قال النبي :(@)(@@) | 30 ( أنكحوا عبد الرحمان بن عوف ، فإنه من خيار المسلمين ، ومن خيارهم من كان مثله ) )(@)(@@) ( عد ) و ابن عساكر عن عبد الرحمان بن حميد عن أبيه عن أمه أم كلثوم بنت عقبة بن أبي معيط عن بسرة بنت صفوان رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6656 ) قال النبي :(@)(@@) | 30 ( إنه قومك عن نبيذ الجر فإنه حرام من الله ورسوله ) )(@)(@@) ( طب ) عن يزيد بن الفضل عن عمرو بن شفى بن سفيان المحاربي عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6657 ) قال النبي :(@)(@@) | 30 ( أنهى عن الكي وأكره الحميم ) )(@)(@@) ابن قانع عن PageV02P464 سعد بن النعمان الظفري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6658 ) قال النبي :(@)(@@) | 30 ( أنهاكم عن ثلاث ، عن قيل وقال ، وكثرة السؤال ) )(@)(@@) ( ع طب ض ) عن عبد الله بن بسرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6659 ) قال النبي :(@)(@@) | 30 ( أنهاك أن لا تكون لعانا ) )(@)(@@) ابن سعد عن جرموز الجهيمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6660 ) قال النبي :(@)(@@) | 30 ( أنهر الدم بما شئت ما لم يكن سنا أو ظفرا ، فإن السن عظم ، وإن الظفر مدى الحبشة ) )(@)(@@) ( طب ) عن رافع بن 
ms717	 خديج رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6661 ) قال النبي :(@)(@@) | 30 ( أنين المريض تسبيح وصياحه تهليل ، ونفسه صدقة ، ونومه على الفراش عبادة ، وتقلبه من جنب إلى جنب كأنما يقاتل العدو في سبيل الله ، يقول الله سبحانه وتعالى لملائكته : اكتبوا لعبدي أحسن ما كان يعمل في صحته ، فإذا قام ثم تمشى كان كمن لا ذنب له ) )(@)(@@) الخطيب والديلمي عن أبي هريرة رضي الله عنه وقالا : رجاله معروفون بالثقة إلا حسين بن أحمد البلخي فإنه مجهول .(@)(@@)(@@)(@@) $ ( 6662 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أبى ذالك لكم ورسوله أن يجعل لكم أوساخ أيدي الناس ) )(@)(@@) ( طب ) عن عبد المطلب بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6663 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أجاركم من ثلاث خلال : أن لا يدعو عليكم نبيكم فتهلكوا جميعا ، وأن لا يظهر أهل الباطل على أهل الحق ، وأن لا تجتمعوا على ضلالة فهاؤلاء أجاركم الله منهن ، وربكم أنذركم ثلاثا : الدخان يأخذ المؤمن كالزكمة ، ويأخذ الكافر فينتفخ ويخرج كل مسمع منه ، والثانية الدابة ، والثالثة الدجال ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه وروى صدره ( د ) .(@)(@@)(@@)(@@) $ ( 6664 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل أحل لاناث أمتي : الحرير والذهب وحرمه على ذكورها ) )(@)(@@) ( ن ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV02P465(@)(@@)(@@)(@@) $ ( 6665 ) قال النبي :(@)(@@) | 30 ( إن الله اختار أصحابي على جميع العالمين سوى النبيين والمرسلين ، واختار لي من أصحابي أربعة فجعلهم خير أصحابي ، وفي مثل أصحابي خير ، أبو بكر وعمر وعثمان وعلي ، واختار أمتي على سائر الأمم فبعثني في خير قرن ، ثم الثاني ، ثم الثالث تترى ، ثم الرابع فرادى ) )(@)(@@) أبو نعيم في فضائل الصحابة والخطيب وابن عساكر عن جابر رضي الله عنه قال الخطيب : غريب .(@)(@@)(@@)(@@) $ ( 6666 ) قال النبي :(@)(@@) | 30 ( إن الله اختار العرب فاختار كنانة من العرب ، واختار قريشا من كنانة ، واختار بني هاشم من قريي ، واختارني من بني هاشم ) )(@)(@@) ابن سعد عن عبد الله بن عبيد بن عمير مرسلا .(@)(@@)(@@)(@@) $ ( 6667 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى اختار العرب فاختار منهم كنانة أو النضر بن كنانة 
ms718	 ، ثم اختار منهم قريشا ، ثم اختار منهم بني هاشم ، ثم اختارني من بني هاشم ، فأنا من خيار إلى خيار ، فمن أحب العرب فبحبي أحبهم ، ومن أبغض العرب فببغضي أبغضهم ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6668 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى اختار لي أصحابا فجعلهم أصحابي وأصهاري وأنصاري ، وسيجيء من بعدهم ينتقصونهم ويسبونهم فإن أدركتموهم فلا تناكحوهم ولا تؤاكلوهم ، ولا تشاربوهم ، ولا تصلوا معهم ، ولا تصلوا عليهم ) )(@)(@@) ( قط ) في كتاب المقلين عن آبائهم المكثرين ، والمكثرين عن آبائهم المقلين عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6669 ) قال النبي :(@)(@@) | 30 ( إن الله اختارني واختار لي أصحابا ، فجعل منهم وزراء وأنصارا ، وإنه سيخرج في آخر الزمان قوم ينتقصونهم ، فلا تؤاكلوهم ولا تشاربوهم ولا تجالسوهم ولا تصلوا عليهم ولا تصلوا معهم ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6670 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى أخرج ذرية آدم من صلبه حتى ملأوا PageV02P466 الأرض وكانوا هاكذا ) )(@)(@@) ( طب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6671 ) قال النبي :(@)(@@) | 30 ( إن الله أدرك بي في الأجل المرجو ، واختارني اختيارا ، فنحن الآخرون ونحن السابقون يوم القيامة ، وإني قائل قولا غير فخر ، إبراهيم خليل الله ، وموسى صفي الله ، وأنا حبيب الله ومعي لواء الحمد يوم القيامة ، وإن الله وعدني في أمتي وأجارهم من ثلاث : لا يفنيهم بسنة ، ولا يستأصلهم عدو ، ولا يجمعهم على ضلالة ) )(@)(@@) الدارمي وابن عساكر عن عمرو بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6672 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل إذا كان يوم القيامة ، جمع السماوات السبع والأرضين السبع في قبضة ثم يقول : أنا الله ، أنا الرحمان ، أنا الملك ، أنا القدوس ، أنا السلام ، أنا المؤمن ، أنا المهيمن ، أنا العزيز ، أنا الجبار ، أنا المتكبر ، أنا الذي بدأت الدنيا ولم تك شيئا ، أنا الذي أعيدها ، أين الملوك ، أين الجبابرة ؟ ) )(@)(@@) أبو الشيخ في العظمة وابن مردويه ( هق ) في الأسماء والخطيب وابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6673 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل إذا أراد بعبده خيرا 
ms719	 عجل عقوبة ذنبه في الدنيا ، وإذا أراد بعبد شرا أمسك عليه بذنبه حتى يوافيه يوم القيامة كأنه عير ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6674 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى إذا قضى بين أهل الجنة وأهل النار ثم عيرهم عجوا فقالوا : اللهم ربنا لم يأتنا رسولك ولم نعلم شيئا ، فأرسل إليهم ملكا والله أعلم بما كانوا عاملين فقال : إني رسول ربكم إليكم ، فانطلقوا فاتبعوا حيث أتوا النار ، قال لهم : إن الله يأمركم أن تقتحموا فيها ، فاقتحمت طائفة منهم ثم أخرجوا من حيث لا يشعر بهم أصحابهم فجعلوا في السابقين المقربين ثم جاءهم الرسول فقال : إن الله يأمركم أن تقتحموا النار فاقتحمت طائفة أخرى ثم أخرجوا من حيث لا يشعر أصحابهم فجعلوا في أصحاب اليمين ، ثم جاءهم الرسول فقال : إن PageV02P467 الله يأمركم أن تقتحموا في النار ، فقالوا : ربنا لا طاقة لنا بعذابك ، فأمر بهم فجمعت نواصيهم وأقدامهم ثم ألقوا في النار ) )(@)(@@) الحكيم عن عبد الله بن شداد : أن رجلا سأل النبي عن ذراري المشركين الذين هلكوا صغارا قال : فذكره .(@)(@@)(@@)(@@) $ ( 6675 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب عبده ابتلاه ليسمع صوته ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6676 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب قوما ابتلاهم ) )(@)(@@) ( هب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 6677 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب عبدا جعله قيم مسجد ، وإذا أبغض عبدا جعله قيم حمار ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما وسنده حسن .(@)(@@)(@@)(@@) $ ( 6678 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل إذا أراد بعبده خيرا ابتلاه ، فإذا ابتلاه اقتناه ، قالوا : يا رسول الله ، وما اقتناه ؟ قال : لم يترك له مالا ولا ولدا ) )(@)(@@) ( طب ) و ابن عساكر عن أبي عبسة الخولاني .(@)(@@)(@@)(@@) $ ( 6679 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أحب قوما أدخل عليهم الرفق ) )(@)(@@) ( ع ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6680 ) قال النبي :(@)(@@) | 30 ( إن الله إذا أراد بعبده خيرا يفقهه في الدين ، وإن هاذا المال حلو خضر ، من أخذه بحقه يبارك له 
ms720	 فيه ، وإياكم والتمادح فإنه الذبح ) )(@)(@@) ابن سعد ( حم ) عن معاوية بن أبي سفيان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6681 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل إذا غضب على أمة ثم لم ينزل بها العذاب ، غلت أسعارها ، وقصرت أعمارها ، ولم تربح تجارتها ، وحبس عنها أمطارها ، ولم تغزر أنهارها ، وسلط عليها شرارها ) )(@)(@@) الديلمي وابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6682 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل اشتد غضبه على اليهود أن قالوا : PageV02P468 عزير ابن الله ، واشتد غضبه على النصارى أن قالوا : المسيح ابن الله ، وإن الله تعالى اشتد غضبه على من أراق دمي وآذاني في عترتي ) )(@)(@@) ابن النجار عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6683 ) قال النبي :(@)(@@) | 30 ( إن الله اصطفى العرب من جميع الناس ، واصطفى قريشا من العرب ، واصطفى بني هاشم من قريش ، واصطفاني واختارني في نفر من أهل بيت : علي وحمزة وجعفر والحسن والحسين ) )(@)(@@) ابن عساكر عن حبيشي بن جنادة .(@)(@@)(@@)(@@) $ ( 6684 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل اصطفى من الكلام : سبحان الله ، والحمد لله ، ولا إلاه إلا الله ، والله أكبر ، من قال سبحان الله كتبت له عشرون حسنة وحط عنه عشرون سيئة ، ومن قال الحمد لله ، فهي ثناء الله كتبت له ثلاثون حسنة وحط عنه ثلاثون سيئة ، ومن قرأ عشر آيات من كتاب الله في ليلة لم يكتب من الغافلين ، ومن قرأ مائة آية في ليلة كتب من القانتين ، ومن أكثر ذكر الله فقد برىء من النفاق ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6685 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى اطلع على المدينة وهي بطحاء قبل أن تعمر ليس فيها مدر ولا وبر فقال : يا أهل يثرب ، إني مشترط عليكم ثلاثا وسائق إليكم من كل الثمرات لا تعضي ، ولا تغلي ، ولا تكبري ، فإن فعلت شيئا من ذالك تركتك كالجزور لا يمنع من أكله ) )(@)(@@) ( طب ) عن ذي مخمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6686 ) قال النبي :(@)(@@) | 30 ( إن الله أعد للمجاهدين في سبييله مائة درجة ، بين كل درجتين كما بين 