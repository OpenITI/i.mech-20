ms1321	 % % ومازال قدما بالعضيهة راضيا % % 2(@)(@@) % ولو نكت أيضا لم يبالني % % كما أنه لم يلتبس بهجائيا % 3(@)(@@) % وماضره ألا يبالي بعدها % % ركوبي إياها بحيث يرانيا % % 4(@)(@@) % لساني وأيري لوتبين أمره % % سواء إذا ما قنعاه المخازيا % % 5(@)(@@) % هما الطرفان العارمان كلاهما % % سواء على من كان غيران حاميا % % 6(@)(@@) % ألم تر أن الله حد عليهما % % بحد وكان الله بالعدل قاضيا % % 7(@)(@@) % أيا بن حريث نكت أمك في استها % % تصبر مهجورا وأجزع هاجيا % % 8(@)(@@) % فدونك فاصبر للهجاء فإنني % % زعيم به ما أصبح النيل جاريا % % 9(@)(@@) % إذا لم يبال المرء عبط أديمه % فعابطه أحرى بأن لا يباليا % % 10(@)(@@) % هجائيك يشفيني وإن لم تباله % % وحسبك داء أن أنال شفائيا % % PageV01P5002 11(@)(@@) % حلفت لئن أصبحت تضحك هازئا % بشعري لقد أمسى ضميرك باكيا % % 12(@)(@@) % وإنك في تنبيح شعري وقد بدت % نواقده من صفحتك دواميا % % 13(@)(@@) % لكا لكلب في تعضيضه قرن قرنه % % وقد أنفدته طعنة هي ماهيا % % 14(@)(@@) % وأصبح يخفي ما به متجلدا % وإن كان لا يخفي بذلك خافيا % % 15(@)(@@) % تكلف حلما ليس منه سجية % وأغضى على أقذائه متغاضيا % % 16(@)(@@) % ليبلغني عنه رباطة جأشه % % فيكسر في ذرعي ويكسف باليا % % 17(@)(@@) % وما احتال إلا بعدما عيل صبره % % وأولى بداه أن يخادع داهيا % % 18(@)(@@) % كأني أراه حين قدر أمره % فأمر نفسيه هنا لك خاليا % % 19(@)(@@) % فقالت له إحداهما إن ذلة % من المرء أن يحمي وألا يحاميا % % 20(@)(@@) % ولست من القوم الذين إذا حموا % % فلا تتعرض للذي لست كافيا % % PageV01P5003 21(@)(@@) % وقالت له الأخرى ومانصحت له % % بلى واركب الغوصاء واغش المغاشيا % % 22(@)(@@) % فزاولها عن كيدها ونكيرها % % فلم ير إلا الترهات اللواهيا % % 23(@)(@@) % فأصغى إلى أمر التي نصحت له % % وإما أتى رشدا فما ذاك غاويا % % 24(@)(@@) % عسى ابن حريث تستريح ظنونه % % إلى أنني عانيت فيه القوافيا % % 25(@)(@@) % فيشفي جواه أو ينفس كربه % % تظنيه أن قد شقني وعنانيا % % 26(@)(@@) % فلا يتخيل في ذاك بجهله % % فلست لما أهدي إليه معانيا % % 27(@)(@@) % وأنى أعاني فيه شعرا أقوله % % وهاجيه لا يبغي إله المراقيا % % 28(@)(@@) % وذاك لأن الشتم في كل 
ms1322	 ساقط % % يجيء مجيء السيل يطلب واديا % % 29(@)(@@) % سيول دعاها مستقر وقادها % % مسيل فجاءت مفعمات طواميا % % 30(@)(@@) % بلى إنما المرقى الكؤود على امرىء % % تطلع أشراف الجبال العواليا % % PageV01P5004 31(@)(@@) % كأهل الندى والبأس والعلم والحجى % % سقى الله هاتيك الذرى والروابيا % % PageV01P5005 البحر : - 1(@)(@@) % عجبا يا قوم للصن % ع وأسباب العطايا % % 2(@)(@@) % كل يوم يخرج الده % ر لنا منه خبايا % % 3(@)(@@) % صرت ياحامد تستك % فى وتسترعي الرعايا % % 4(@)(@@) % ويح هاتيك الرعايا % % فلقد أمست سبايا % % 5(@)(@@) % لست تألوها خبالا % % في خراج وبقايا % % 6(@)(@@) % دائبا تصليها طو % % را وتغزيها السرايا % % 7(@)(@@) % لارعاك الله عبدا % غير راع للوصايا % % 8(@)(@@) % فلقد أصبحت للدو % لة من أخزى الخزايا % % 9(@)(@@) % بك صارت نعم الل % ه على الخلق رزايا % % 10(@)(@@) % صارت الضيعة للتأن % % ني هموما وبلايا % % PageV01P5006 11(@)(@@) % ولك الغلمان والخي % % ل وأنواع المطايا % % 12(@)(@@) % حين لاتشكر نعما % % ء ولا تخشى المنايا % % 13(@)(@@) % لاتغرن فلن يغ % % فل علام الخفايا % % 14(@)(@@) % بئس ما كافأت ما أه % داه من حر الهدايا % % PageV01P5007 البحر : - 1(@)(@@) % هنيئا يا أبا حسن هنيئا % بلغت من الفضائل كل غايه % 2(@)(@@) % شركت القرد في سخف وقبح % % وماقصرت عنه في الحكاية % % 3(@)(@@) % وكنت إذا جريت إلى المخازي % % إلى أبويك جاوزت النهاية % % 4(@)(@@) % شهدت بأن من تنمى إليه % % خلاف أبيك لكن كان دايه % % 5(@)(@@) % صححت من الخمول ألا فصبرا % سترفع راية لك بعد رايه % % PageV01P5008 البحر : - 1(@)(@@) % لو يعلم ابن أبي سميه % % كم من شجاع يتقيه % 2(@)(@@) % لزها وتاه بقبحه % % تيها يحاقر كل تيه % 3(@)(@@) % كم حاجة باكرتها % % بالسعد والوجه الوجيه % 4(@)(@@) % فرجعت حين رأيته % % باليأس مما أرتجيه % 5(@)(@@) % الله يعلم أنني % % من كل شيء أجتويه % 6(@)(@@) % كل الأنام تخافه % % خوف الأصاغر من بنيه % % 7(@)(@@) % تغضى الجفون إذا بدا % % من هول منظره الكريه % 8(@)(@@) % قد قلت إذ قذيت به % % عيني وأعين مبصريه % 9(@)(@@) % ياليت لي بصحيحتي % % عوراءة مما يليه % PageV01P5009 البحر : - 1(@)(@@) % أصبح هذا الحجر قد وافقت % أسماؤه الشنع معانيه % 2(@)(@@) % لم يخل من أير ومن عيبة % مذ شق فوه لمناغيه % 3(@)(@@) % فحية تدخل في دبره 
ms1323	 % وحية تخرج من فيه % 4(@)(@@) % كذلك الحيات فيما يرى % % تأتي من الحجر وتأتيه % % 5(@)(@@) % وليس مايأتي به منكرا % % ولا يقول الإفك هاجيه % % PageV01P5010 البحر : - 1(@)(@@) % شهد الله وهو عدل رضي % أن عبد القوي عبد قوي % 2(@)(@@) % آخذ الناس كلهم لكتاب % أخذ يحيى لكن يحيى نبي % 3(@)(@@) % وهو يحيي لولا النجاسة والجه % ل وإن لم يجىء به زكري % PageV01P5011 البحر : - 1(@)(@@) % يا خالدا ابن أبيه % ليس الذي يدعيه % 2(@)(@@) % قد قلت إذا حذروني % % ك ناك أم أبيه % 3(@)(@@) % إن كان شيخا سفيها % يبذ كل سفيه % 4(@)(@@) % فقد أصاب شبيها % به وفوق الشبيه % % PageV01P5012 البحر : - 1(@)(@@) % صدق القائلون إنك ياخاتدعي سخلة له ولأملم تزل تحته فراشا وطيا ثقل أوركها على عاتقيه ولك النسل جئت شيئا فريا % لد أصبحت تظلم الشوكيا % % PageV01P5013 البحر : - 1(@)(@@) % تدعي سخلة له ولأم % % لم تزل تحته فراشا وطيا % % PageV01P5014 البحر : - 1(@)(@@) % ثقل أوركها على عاتقي % % ه ولك النسل جئت شيئا فريا % 2(@)(@@) % فاتق الله بل إخالك شيخا % يتقي الله أن يكون تقيا % PageV01P5015 البحر : - 1(@)(@@) % يا أخي من أبي وماكان يزني % % حاش لله بل صحيح التقيه % 2(@)(@@) % غير أن التي رمت بك بنتا % شرعت فرجها لحوض المنيه % % 3(@)(@@) % ليس منه ولا من الموت بد % لرشيد ولا لنفس غويه % 4(@)(@@) % إذ سحا نفسه بماء مسوس % % ولظى النار بين جاعرتيه % 4(@)(@@) % قد سمعنا بحاتم وبكعب % % فهما يعدوان بين يديه % 4(@)(@@) % ما عجيببا ألا يغار عليها % % بل عجيب ألا تغار عليه % % 4(@)(@@) % ليس ينفك عبده راي عين % فوق أم العال من زوجتيه % % 4(@)(@@) % يتغاضى عن زوجتيه اغتفارا % وهما ضرتاه في عبديه % 4(@)(@@) % من رأى مثل خالد فضل حلم % وسماح أم من يقاس إليه % % 4(@)(@@) % اعف عني خطيئتي بالذي يعخفيف من رأى مثل خالد فضل حلم وسماح أم من يقاس إليه يتغاضى عن زوجتيه اغتفارا وهما ضرتاه في عبديه ليس ينفك عبده راي عين فوق أم العال من زوجتيه ما عجيببا ألا يغار عليهابل عجيب ألا تغار عليه قد سمعنا % % طيك ماتشتهي من القحطبيه % PageV01P5016 البحر : - 1(@)(@@) % خالد أمها 
ms1324	 وأنت أبوها % % فاتق الله أيها الشوكي % 2(@)(@@) % هي بنت ولدتماها جميعا % فله حملها ومنك المني % % 3(@)(@@) % ماحنقنا عليك وهو عدو % موفق سهمه وأنت الولي % 4(@)(@@) % ينتحل الدهر فيا ليته % % لم يك ذا فيه وكان الغبي % 4(@)(@@) % ما خلت ان الله سبحانه % % يجمع ما فيه وبغض النبي % 4(@)(@@) % لا يحقر الفيشات ممن أتت % من رجل ذي كرم أو صبي % % 4(@)(@@) % لنا صديق يدعي منة % من فضل ما أودع فيه المني % % 4(@)(@@) % فاستريحا من التنازع فيهاسريع لنا صديق يدعي منة من فضل ما أودع فيه المني لا يحقر الفيشات ممن أتتمن رجل ذي كرم أو صبي مثل طريق شرعت للورى يجتاز ذو الفضل بها والدني ما خلت ان الله سبحانهيجمع ما فيه وبغض النبي ينتحل الدهر % % قد جلا الشبهة البيان الخفي % PageV01P5017 البحر : - 1(@)(@@) % يا قابل المدح فيه منا % % وباخل منه بالعطايا % % 2(@)(@@) % جرت علينا وكنت ممن % % يجور في الحكم والقضايا % % 3(@)(@@) % نحن على هدم ما بنينا % % أقدر منا على البنايا % % 4(@)(@@) % لاسيما والمديح زور % والحق في تلكم الخبايا % % 5(@)(@@) % ليأتينك الهجاء فيه % % صواعق تقدم المنايا % % 6(@)(@@) % مثالب لا يخاف فيها % % إثم ولا تتقى خطايا % % 7(@)(@@) % يسرى بها في البلاد شعر % تحمل أعباؤه المطايا % % PageV01P5018 البحر : - 1(@)(@@) % بأبي وجه مضيء % ولباس برمكي % 2(@)(@@) % وفتى حسن القا % % مة والقد سري % 3(@)(@@) % فيه تأنيث وتخني % % ث وحلم أحنفي % 4(@)(@@) % ومحال يعشق التخ % % نيث إلا حلقي % 5(@)(@@) % قيل لي إن أباه % % شيروي نبطي % % 6(@)(@@) % فلئن كان كما قي % % ل فجسم نبوي % % 7(@)(@@) % لأبيه فيه لا شك % ك شريك هاشمي % % PageV01P5019 البحر : - 1(@)(@@) % أم حفص صلعة الشي % خ أبي حفص فديتك % 2(@)(@@) % أنا والله عميد % بك صب مذ رأيتك % % 3(@)(@@) % نعمي كفي فإني % % بعت عرضي واشتريتك % % PageV01P5020 البحر : - 1(@)(@@) % ألا أيهذا السائلي عن معاشر % % يزيدهم لؤم الفعال تعاليا % % 2(@)(@@) % لعمرك مافيهم صرفت عنايتي % % إلى القول بل في الدهر حكت القوافيا % % 3(@)(@@) % تنبه للأرذال يرفع أمرهم % % فأصبح عن أهل المروءة ساهيا % % 4(@)(@@) % كحيران لا يدري الهدى كيف وجهه % % ضلالا ومايلقى إلى 
ms1325	 الرشد هاديا % % 5(@)(@@) % ترى كل ذي لب بأسفل تلعة % وكل جهول الرأي يعلو الروابيا % % 6(@)(@@) % كذي جيف الغرقى إذا هي أنتنت % % وأجوت بطون الماء تعلو طوافيا % % PageV01P5021 البحر : - 1(@)(@@) % ياثلج ماء مالح آسن % فاض من الحمام في الجيه % % 2(@)(@@) % فليس بالمشروب من خبثه % ولامعد لرصاصيه % % 3(@)(@@) % طيز رحيب وفم مثله % % مسترق من وجه جريه % % 3(@)(@@) % من نغمة تضرط في حلقها % % ونكهة تفسو كرنبيه % % 3(@)(@@) % إذا أجابت شنطف طبلهامن نغمة تضرط في حلقهاونكهة تفسو كرنبيه بذيء طيز رحيب وفم مثلهمسترق من وجه جريه بذيء % % ناح عليه نوح معنيه % % PageV01P5022 البحر : - 1(@)(@@) % نوك وغي وعي % وأنت مع ذا دعي % 2(@)(@@) % عما قليل سينبو % % بك الفراش الوطي % 3(@)(@@) % لو كنت تعقل ما في % % ك أيهذا المسي % 4(@)(@@) % لم يصف عيشك لكن % عيش الغبي هني % % PageV01P5023 البحر : - 1(@)(@@) % تباين الأصل منه % % ودعوة يدعيها % % 2(@)(@@) % تباين اسم أبيه % وكنية يكتنيها % % PageV01P5024 البحر : - 1(@)(@@) % إنما ألبس العمامة في الصي % % ف لأني أروق أختك فيها % % 2(@)(@@) % لي رأس يقرها لا كرأس % مازالقرنه ينفيها % % PageV01P5025 البحر : - 1(@)(@@) % مافيه معنى لمشتهيه % عجبت من جهل عاشقيه % % 2(@)(@@) % لأي معنى تخيروه % % وكل عيب له وفيه % PageV01P5026 البحر : - 1(@)(@@) % كم قرون في رؤوس % ذات طول قفديه % 2(@)(@@) % عليت فيها قباب % قبل عبد الصمديه % % PageV01P5027 البحر : - 1(@)(@@) % قلت إذ قيل جوهري طريف % % لم يكن قط ذلكم جوهريا % % 2(@)(@@) % إنما قيل جوهري لعبد % نكحوه فلقب الجوحريا % % PageV01P5028 البحر : - 1(@)(@@) % علج إذا قلم أظفاره % قلم أيضا من صياصيه % 2(@)(@@) % له صياص من شقاق به % % في قدميه مايداويه % PageV01P5029 البحر : - 1(@)(@@) % أبن لي تعمم طابقيا % % وفيم لبست ربقا برمكيا % % 2(@)(@@) % أتذكر إذ أبوك ببرطباثا % % يصيد بنهرها سمكا طريا % % PageV01P5030 البحر : - 1(@)(@@) % لاينكر الناس هزلا % في عرض شعر نقي % 2(@)(@@) % قد يضرط الشعر حينا % في لحية البيهقي % % PageV01P5031 البحر : - 1(@)(@@) % رأيتك تدعي رمضان دعوى % % وأنت نظير يوم الشك فيه % PageV01P5032 البحر : - 1(@)(@@) % بأبي حسن وجهك اليوسفي % يا كفي الهوى وفوق الكفي % 2(@)(@@) % فيه ورود ونرجس وعجيب % اجتماع الربعي والخرفي % 3(@)(@@) % ما لقلبي يضحي ويمسي خفيا % % منك ياسيدي بغير حفي 
ms1326	 % % 4(@)(@@) % قطر سهميك من دماء المحبي % % ن على وجنتيك غير خفي % PageV01P5033 البحر : - 1(@)(@@) % شبهي بوجنتك الملي % % حة موجب حقي عليكا % % 2(@)(@@) % فبحرمتي لما استبح % % ت لجاعلي سببا إليكا % % PageV01P5034 البحر : - 1(@)(@@) % تعللت ريقا يطرد النوم برده % ويشفي القلوب الحائمات الصواديا % % 2(@)(@@) % وهل ثغب حصباؤه مثل ثغرها % % يصادف إلا طيب الطعم صافيا % % PageV01P5035 البحر : - 1(@)(@@) % معذر فوق مورديه % قد ضرب الحسن على خديه % 2(@)(@@) % حديه ثم انجاب في حديه % فصار حسن الناس في يديه % 3(@)(@@) % يزهى به الإسلام في عيديه % % لبيه مقرون إلى سعديه % PageV01P5036 البحر : - 1(@)(@@) % طير النوم عن جفوني خيال % من حبيب فبت أرعى الثريا % % 2(@)(@@) % موجبا رعيها لكثرة تشبي % % هي لها بالذي أحب عليا % % 3(@)(@@) % حجبوه لكي أرى ساليا عن % % ه على نأيه فأعقبت غيا % % 4(@)(@@) % لم يروا أن كل ماشط عني % % زاده بعده اقترابا إليا % % PageV01P5037 البحر : - 1(@)(@@) % لابنة الوائلي وسواس حلي % % آخر الليل فوق صدر خلي % 2(@)(@@) % ولمن تيمته وسواس هم % % سائر الليل تحت صدر شجي % PageV01P5038 البحر : - 1(@)(@@) % رمدت مقلتي إشتياقا إليكا % % واكتسى الذل وجه حرصي عليكا % % 2(@)(@@) % وانقضت كل حسرة لك إلا % % حسرتي للمغيب عن ناظريكا % % 3(@)(@@) % أيها السيد المحجب عني % % أنت لي واقف على حالتيكا % % 4(@)(@@) % حين أبهجت بي الصديق وأشجي % % ت عدوي قذفتني من يديكا % % PageV01P5039 البحر : - 1(@)(@@) % نبكي الشباب لحاجات النساء ولي % % فيه مآرب أخرى سوف أبكيها % % 2(@)(@@) % أبكي الشباب الروق كان يعجبني % % منه إذا عاينت عيني مرائيها % % 3(@)(@@) % ماكان أعظم عندي قدر نعمته % % لنفسه لا لخود كان يصبيها % % 4(@)(@@) % كانت لعيني منه قرة عجب % دون العيون اللواتي كان يرقيها % % 5(@)(@@) % ماكان أكثر أعجاب النساء به % % والنفس أوجب إعجابا بمافيها % % 6(@)(@@) % كم كان يونق من عين تقر % وكان يونق من أخرى يبكيها % % 7(@)(@@) % كم كان يجلو قذى عين برونقه % حتى إذا جال فيها عاد يقذيها % % 8(@)(@@) % تغدو النساء فترميه بأعينها % % فبالسهام التي فوقن يرميها % % 9(@)(@@) % يثني عليهن نبلا ظن مرسلها % % أن ليس شيء من الأشياء يثنيها % % 10(@)(@@) % أبكي الشباب للذات القنيص إذا % % ثقلت عنها وغاداها مغاديها % % PageV01P5040 11 
ms1327	(@)(@@) % هناك لا ميعة الشبان تبعثني لها % % ولا النفس عن طوع تخليها % % 12(@)(@@) % فإن غدوت فعن نفس مكلفة % مثل الحسير يزجيها مزجيها % % 13(@)(@@) % أبكي الشباب للذات الشمول إذا % % غنى القيان وحث الكأس ساقيها % % 14(@)(@@) % هناك لا أنا مرتاح فشاربها % % ولا أخو سلوة عنها فساليها % % 15(@)(@@) % كم زفرة لي ملء الصدر حينئذ % % عن حسرة في ضمير القلب أطويها % % 16(@)(@@) % أبكي الشباب لنفس كان يسعفها % % بكل ما حاولته من ملاهيها % % 17(@)(@@) % أبكي الشباب لآمال فجعت بها % % كانت لنفسي أنسا في معانيها % % 18(@)(@@) % أبكي الشباب لنفس لاترى خلفا % منه ولا عوضا مذ كان يرضيها % % 19(@)(@@) % أبكي الشباب لعين كل ناظرها % % بعد الثقوب وحار القصد هاديها % % 20(@)(@@) % عين عهدت لها نبلا مفوقة % تصمي وتنمي فأشوى الآن راميها % % PageV01P5041 21(@)(@@) % أبكي الشباب لأذن كان مسمعها % % وقد يجاب على بعد مناديها % % 22(@)(@@) % أذن وإن هي كلت ماعهدت بها % % وقرا سوى وقرها عن لوم لاحيها % % 23(@)(@@) % أبكي الشباب لكف من ساعدها % % وقد ترد وتلوي كف لاويها % % 24(@)(@@) % كف عهدت ثمار اللهو دانية % منها فقد قلصت عنها مجانيها % % 25(@)(@@) % كان الشباب وقلبي منه منغمس % في فرجة لست أدري ما دواعيها % % 26(@)(@@) % روح على النفس منه كان يبردها % % برد النسيم ولا ينفك يحييها % % 27(@)(@@) % كأن نفسي كانت منه سارحة % في روضة بات ساقي المزن ساقيها % % 28(@)(@@) % كأن نفسي كانت منه يفعمها % % نسيم راح وريحان يحييها % % 29(@)(@@) % كأن نفسي كانت منه لاقية % في كل حال يدي حب يعاطيها % % 30(@)(@@) % من مات ماتت كما قد قيل حاجته % % إلا الشباب وحاجات يبقيها % % PageV01P5042 31(@)(@@) % يمضي الشباب ويبقي من لبانته % % شجوا على النفس يشجوها ويشجيها % % 32(@)(@@) % ليت اللبانة كانت تنقضي معه % % أو كان يبقى الدهر باقيها % % 33(@)(@@) % كلا ولكنه يمضي وقد بقيت % في النفس منه بقيات تعنيها % % 34(@)(@@) % وإن أبرح مااستودعته خلدا % لبانة لك لا تسطيع تقضيها % % 35(@)(@@) % وكانت النفس ينهاها إذا غويت % ناه سواها فمنها الآن ناهيها % % PageV01P5043 البحر : - 1(@)(@@) % كفى بسراج الشيب في الرأس هاديا % % إلى من أضله المنايا لياليا % % 2(@)(@@) % أمن بعد إبداء المشيب 
ms1328	 مقاتلي % % لرامي المنايا تحسبيني ناجيا % % 3(@)(@@) % غدا الدهر يرميني فتدنو سهامه % % لشخصي وأخلق أن يصيب سواديا % % 4(@)(@@) % وكان كرامي الليل يرمي ولا يرى % % فلما أضاء الشيب شخصي رآنيا % % PageV01P5044 البحر : - 1(@)(@@) % يارب جري شواء مررت به % كأنه فدر الفالوذ مشوي % 2(@)(@@) % لافلس فيه ولاشوك ينغصه % % كما تكون لشبوط وبني % 3(@)(@@) % يفوز في الوجه فورا من حرارته % طوبى لحلق بذاك الحر مكوي % 4(@)(@@) % نعم الطعام لأعمى جائع ضرم % معلم عالم بالشعر نحوي % % 5(@)(@@) % من شيعة الكهل خال المؤمنين على % % رغم ابن شيبة أو رغم الدمشقي % 6(@)(@@) % محمد بن علي إنه رجل % % من دينه أكل زمار وجري % % 7(@)(@@) % حتى تخال سبال الشيخ قد دهنت % من ذا وذاك بيان أو بخيري % 8(@)(@@) % فضلا من الله أعطاه وحرمه % شقي من الضلال شيعي % PageV01P5045 البحر : - 1(@)(@@) % لي طيلسان أنا في يديه % % مثل الأسير خانع لديه % % 2(@)(@@) % زعزعت الأيام جانبيه % % قد هدمت أيامه ركنيه % % 3(@)(@@) % تسرع كل آفة إليه % % كأن كل صيحة عليه % % PageV01P5046 البحر : - 1(@)(@@) % قد ساءني أن بزتربي قناعه % % وأضحى قناعي حالك اللون داجيا % % 2(@)(@@) % وقد كنت أهوى أن أفضل دونه % % بكل لباس يستميل الغوانيا % % 3(@)(@@) % فلما علاه الشيب أيقنت أنه % % عناني ولكن باسم غيري دعانيا % % PageV01P5047 البحر : - 1(@)(@@) % كأن نسيمها أرج الخزامى % % ولاه بعد وسمي ولي % 2(@)(@@) % هدية شمأل هبت بليل % لأفنان الجنان لها نجي % 3(@)(@@) % إذا أنفاسها نسمت سحيرا % تنفس كالشجي لها الخلي % PageV01P5048 البحر : - 1(@)(@@) % إذا ما الدهر أمضى من مداه % مدى يوم مضى منه إليه % % 2(@)(@@) % ويأتي الفتى يوم فيوم % وما ياتي له يأتي عليه % % PageV01P5049 البحر : - 1(@)(@@) % ولحية سوء ولكنها % % على عرض صاحبها واقيه % 2(@)(@@) % يقول المريدون أن يشتموه % % أمك من لحية زانيه % PageV01P5050 البحر : - 1(@)(@@) % ولحية سوء ولكنها % % لصاحبها أبدا افديه % % 2(@)(@@) % أنى ينهنه ناقم عن ظالم % وله الأيادي الشيئات لديه % % 2(@)(@@) % فلقد ظلمت بمقت ثالث صاحب % % ما زال مجتهدا يسيء إليه % 2(@)(@@) % كامل إن كنت تمقت من أساء لأنه % % ممن أساء وإن سلمت عليه % 2(@)(@@) % ولقد ملأت يديهم بك غبطة % ولقد ملأت بهم كذاك 
ms1329	 يديكا % % 2(@)(@@) % وكأنني بهم لديك وإنما % % شمس النهار بهم هناك لديكا % % 2(@)(@@) % لا تنسينهم فإن لديهم % شوقا وشوقا للحديث إليكا % % 2(@)(@@) % شرب على ذكر الأحبة إنهم % % عما قليل قادمون عليكا % % 2(@)(@@) % يقول المريدون أن شتموه % ألا في حر أمك من لحيه % % PageV01P5051 البحر : - 1(@)(@@) % إذا أنت نفست للباسليق % % دموعا من أجفانه واهيه % 2(@)(@@) % رأيت اعتلالك يبكي دما % وتضحك في جسمك العافيه % % PageV01P5052 البحر : - 1(@)(@@) % ياسائلي عن مجمع اللذات % سألت عنه أنعت النعات % 2(@)(@@) % فهاك ما استنبأته من قصه % مسلما من شوبه ونقصه % % 3(@)(@@) % خذ يامريد الأكل اللذيذ % جردقتي خبز من السميد % 4(@)(@@) % لم تر عينا ناظر شبهيهما % % فاقتسر الحرفين من وجهيهما % % 5(@)(@@) % حتى إذا ماصارتا صفا صفا % % فانتف على إحداهما تنائفا % % 6(@)(@@) % من لحم فروج ولحم فرخ % % يدور جواذبهما بالنفخ % 7(@)(@@) % واجعل عليها أسطرا من لوز % معارضات أسطرا من جوز % 8(@)(@@) % إعجامها الجبن والزيتون % وشكلها النعنع والطرحون % % 9(@)(@@) % واعمد إلى البيض الصليق الأحمر % فرصع الجبن بها ودنر % % 10(@)(@@) % حتى ترى مابينها مثل اللبن % مقسومة كأنها وشي اليمن % % PageV01P5053 11(@)(@@) % وترب الأسطر بالملح ولا % % تكثر ولكن قدرا معدلا % % 12(@)(@@) % وردد العينين فيها لحظا % % فإن للعينين منها حظا % % 13(@)(@@) % ومتع العين بها مليا % % وأطبق الخبز وكل هنيا % % 14(@)(@@) % طورا ترى كفلكة الدولاب % % وتارة كعسجد الذؤاب % 15(@)(@@) % وتارة مثل الرحى بلا شعب % قد شذبت عنها ثناياك السذب % % 16(@)(@@) % واها ثناياك وكدما كدما % % تسرع فيما قد بنيت الهدما % % 17(@)(@@) % لهفي عليها وأنا الزعيم % لمعدة شيطانها رجيم % % PageV01P5054 
