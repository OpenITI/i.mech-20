ms61	(@)(@@) % خلقت أدر من السحائب كفه % % بل أنشأت منها أعم وأخصبا % % 60(@)(@@) % هو خير من ضمت معاقد حبوة % وأخوه فخرا خير من عقد الحبا % % PageV01P199 61(@)(@@) % طلعا طلوع النيرين فما رأى % % أفق المكارم مذ أنارا غيهبا % % 62(@)(@@) % فعلاهما في المجد أبعد مرتقى % % ونداهما للوفد أقرب مطلبا % % 63(@)(@@) % أبقية الكرم الذين سواهم % % لم يتخذ تهج المكارم مذهبا % % 64(@)(@@) % لا زلتم في نعمة ومسرة % مادام ظهر الأرض يحمل كبكبا % % PageV01P200 البحر : خفيف تام 1(@)(@@) % يا نسيم الصبا وريح الجنوب % روحا مهجتي بنشر الحبيب % 2(@)(@@) % إن روح المحبوب روح لقلبي % % ما لقلبي آس سوى المحبوب % 3(@)(@@) % وعلى البعد منه إن تحملاه % % فعلي انفحا به من قريب % 4(@)(@@) % لو سوى نشر يوسف شم يع % % قوب إذا لم يزل جوى يعقوب % 5(@)(@@) % وعجيب بميتة ذاب قلبي % % ويرى طبه بنشر المذيب % 6(@)(@@) % ليت يا عذبة اللمى من فؤادي % % فيه أطفأت بعض هذا اللهيب % 7(@)(@@) % أو على السفح للوداع حبست ال % % ركب مقدار لفتة من مريب % 8(@)(@@) % منك لو نال ساعدي ضمة التو % % ديع أدركت غاية المطلوب % 9(@)(@@) % وعلى المتن كان منك هلالا % حين شرقت جانحا للغروب % 10(@)(@@) % ما لطيف الخيال ضاعف شوقي % % حين وافى بوعده المكذوب % PageV01P201 11(@)(@@) % فيه جاءت من بعد توهيمة الرك % % ب حذارا من عاذل ورقيب % 12(@)(@@) % قلت أنى وفت فعاد نصيبي % % وصلها والمطال كان نصيبي % % 13(@)(@@) % بينما في العناق قد لفنا الشو % % ق ضجيعين في رداء قشيب % 14(@)(@@) % وإذا الوصل في انتباهي أراه % % سرق الإفك من سراب كذوب % 15(@)(@@) % أين مني مي وقد عوذتها % % غلمة الحي بالقنا المذروب % 16(@)(@@) % شمس خدر حجابها حين تبدو % % جنح ليل من فرعها الغربيب % 17(@)(@@) % وهي عن بانة تميس دلالا % وهي ترنو عن طرف ظبي ربيب % 18(@)(@@) % وسوى البدر في الأنارة لولا % % كلفة البدر مالها من ضريب % 19(@)(@@) % حسدتني حتى عيوني عليها % % لو تذكرتها لأضحت تشي بي % % 20(@)(@@) % أو سرت موهنا إلي لظنت % % كل نجم في الأفق عين رقيب % % PageV01P202 21(@)(@@) % بوركت ليلة تخيلت من أر % % دانها عطرت بنشر الطيب % 22(@)(@@) % قلت 
ms62	 ذا الطيب من كثيب حماها % % حملته لنا الصبا في الهبوب % 23(@)(@@) % قال لي الصحب من بشير أتانا % % من حمى الكرخ لا الحمى والكثيب % % 24(@)(@@) % مخبرا عن محمد كوكب المجد % % سرى الداء للحسود المريب % 25(@)(@@) % أيهذا البشير لي حبذا أنت % % بشيرا ببرء داء الحبيب % 26(@)(@@) % لو سواه روح لجسمي لأتحف % % تك فيه وقل من موهوب % % 27(@)(@@) % لي أهديت فرحة ما سرت قبل % ولا بعد مثلها في القلوب % 28(@)(@@) % غرس الدهر قبلها الذنب عندي % % فغدا مثمرا بعفو قريب % % 29(@)(@@) % وغريب من الزمان وما زال % % لديه اختراع كل غريب % 30(@)(@@) % أن أراني وما أراني سواه % % حسنات يجنى بغرس الذنوب % PageV01P203 31(@)(@@) % عجبا كيف أولد النحس سعدا % شق في نوره ظلام الخطوب % 32(@)(@@) % فمحيا الدنيا غدا وهو طليق % ما بصافى بياضه من شحوب % 33(@)(@@) % ضاحك من غضارة البشر أنسا % وهو بالأمس موحش التقطيب % % 34(@)(@@) % أيها الواخد المفلس في عز % % م على الهول ليس بالمغلوب % 35(@)(@@) % صل على الأمن ناجيا لمحل % في ذرى الكرخ بالندى مهضوب % % 36(@)(@@) % مستجار بالعز يحرس أو با % % لحافظين الترغيب والترهيب % % 37(@)(@@) % وبه حي صفوة الشرف المحض % ربيع العفاة عند الجدوب % 38(@)(@@) % طيب الأصل فرعه في صريح ال % % مجد ينمى إلى نجيب نجيب % 39(@)(@@) % وافر البشر والسماح إذ المحل % بدا عامه بوجه قطوب % 40(@)(@@) % جاد حتى مس الوفود من الأخ % % ذ لغوب وما به من لغوب % PageV01P204 41(@)(@@) % في زمان لو الخصيب به ين % % شره الله لم يكن بالخصيب % 42(@)(@@) % قل له يا محمد صالح أنت % % لإحراز كل فضل غريب % 43(@)(@@) % ليس تنفك أنت واليمن في ظل % رواق من العلى مضروب % 44(@)(@@) % ولك السعد حيث كنت قرين % لم يمل عنك نجمه لغروب % 45(@)(@@) % كمل الأنس حين صرت تهنى % % بشفى أنسك الأعز الحبيب % 46(@)(@@) % وأخوك الذي قداح المعالي % % للمعلى منها حوى والرقيب % 47(@)(@@) % ماجد هذبت خلائقه في ال % % مجد والفخر غاية التهذيب % 48(@)(@@) % ذو بنان ند ووجه جميل % % ولسان طلق وصدر رحيب % 49(@)(@@) % فابقيا للعلاء ما بدت الشم % % س ومالت في أفقها للغروب % 50 
ms63	(@)(@@) % في سرور صاف وطرف قرير % ونعيم باق وعيش رطيب % PageV01P205 البحر : رمل تام 1(@)(@@) % عجل الصب وقد هب طروبا % % فتعدى لتهانيك النسيبا % % 2(@)(@@) % منك بدر المجد قد ألهاه عن % % رشأ زر على البدر الجيوبا % % 3(@)(@@) % بدر حسن في دجى من فرعه % % ما أحيلاه طلوعا وغروبا % % 4(@)(@@) % كم تصبى من أخي حلم وكم % % من أخي لب به جد لعوبا % % 5(@)(@@) % لست أدري إذ يعاطي كفه % % خمرة من لونها يبدو خضيبا % % 6(@)(@@) % أجلا لامعة في كأسه % % أم سنا وجنته أبدى لهيبا % % 7(@)(@@) % شادن وفرته ريحانة % نشرها ينفح للندمان طيبا % % 8(@)(@@) % ما أدار الراح إلا مثلت % % حول كسرى منه في الكأس ربيبا % % 9(@)(@@) % لا تقل قطب من سورتها % % من تعاطى رشفها كوبا فكوبا % % 10(@)(@@) % بل رآه حول كسرى فاكتسى % % وجهه من سورة الغيظ قطوبا % % PageV01P206 11(@)(@@) % لك أخلاق عدتني عن طلا % رشفها من فمه يحيي القلوبا % % 12(@)(@@) % ولطبع فيك من رقته % % لي أنفاس الصبا رقت هبوبا % % 13(@)(@@) % عفت منه وجنة رقت إلى % % أن شكت من عقرب الصدغ دبيبا % % 14(@)(@@) % يا نسيم الريح إني لم أكن % % لسواك اليوم عني مستنيبا % % 15(@)(@@) % سر إلى البصرة واحمل عن فمي % % كلما أعبق من رياك طيبا % % 16(@)(@@) % إن فيه منتدى رب حجى % أحرز السؤدد مذ كان ربيبا % % 17(@)(@@) % طف بعبد الله فيه إنه % % كعبة حطت من الدهر الذنوبا % % 18(@)(@@) % واعتمد طلعته الغرا وقل : % بوركت من طلعة تجلو الكروبا % % 19(@)(@@) % أيها الثاقب نورا كلما % % قصدوا إطفاءه زاد ثقوبا % % 20(@)(@@) % أخصبت ربعك أنواء الهنا % % فبنوء الجود لم يبرح خصيبا % % PageV01P207 21(@)(@@) % خير ما استثمرته غصن علا % لك أنماه النهى غضا رطيبا % % 22(@)(@@) % قد نشا في حجر علياك التي % % رضع السؤدد منها لا الحليبا % % 23(@)(@@) % ذاك عبد الواحد الماليء في % % عزه قلب أعاديه وجيبا % % 24(@)(@@) % شبلك المخدر في عريسة % ترهب الليث ولو مر غضوبا % % 25(@)(@@) % إصطفى المجد له منجبة % واصطفى منه لها كفوا نجيبا % % 26(@)(@@) % وعلى نسلهما من قبل أن % % يلداه قيل بارك كي يطيبا % % 27(@)(@@) % فلك البشرى بعرس سعده % % في محيا الدهر ما 
ms64	 أبقى شحوبا % % 28(@)(@@) % مسحت قلب العلى فرحته % % بيد ما تركت فيه ندوبا % % 29(@)(@@) % قم فهني المجد يا سعد بمن % % مثله لم يصطف المجد حبيبا % % 30(@)(@@) % وعن الحساد لا تسأل وقل % % مهج لاقت من الوجد مذيبا % % PageV01P208 31(@)(@@) % قد أبات القوم في غيظهم % % يتجافون على الجمر جنوبا % % 32(@)(@@) % خطبوا مجدك يا من كم به % % عنهم قد دفع الناس الخطوبا % % 33(@)(@@) % وجروا خلفك للعليا وكم % % فت مطلوبا وأدركت طلوبا % % 34(@)(@@) % فاتهم منك ابن مجد لم يزل % % في العلى أطولهم باعا رحيبا % % 35(@)(@@) % أين من في الأرض ممن عقدت % % بنواصي الشهب علياه الطنوبا % % 36(@)(@@) % حسدت شهب الدراري وجهه % % إذ له ما وجدت فيها ضريبا % % 37(@)(@@) % وغدا الأفق الذي زين بها % % يتمنى فيه عنها أن ينوبا % % 38(@)(@@) % يا بني العصر دعوا ضربكم % % بقداح قط لم تحرز نصيبا % % 39(@)(@@) % فبأعشار العلى فاز فتى % كان كفاه المعلى والرقيبا % % 40(@)(@@) % أروع وقر ناديه النهى % % فبصدر الدهر لم يبرح مهيبا % % PageV01P209 41(@)(@@) % ما النسيم الغض يسري سحرا % منعشا في برد رياه القلوبا % % 42(@)(@@) % لك أذكى من سجاياه شذا % فانتشق زهر المعالي مستطيبا % % 43(@)(@@) % فلبسام العشيات فدى % أوجه تدجو على الوفد قطوبا % % 44(@)(@@) % ولرطب الكف في الجدب وقى % كف قوم جف في الخصب جدوبا % % 45(@)(@@) % شنجته علة البخل فلا % % طب أو يغدو له السيف طبيبا % % 46(@)(@@) % أغربت أوصاف ذي مجد حوى % % من مزايا المجد ما كان غريبا % % 47(@)(@@) % أين ما يسري سرى شوق الورى % % فهو يقتاد الحشا منها جنيبا % % 48(@)(@@) % وهو بحر ولهذا فمه % % يقذف اللؤلؤ في النادي رطيبا % % 49(@)(@@) % وهو الغيث وأجدر أن ترى % % علم الغيث نداه أن يصوبا % % 50(@)(@@) % أين منه معدل الضيف إذا % % لقراه التمس المسنى المطيبا % % PageV01P210 51(@)(@@) % وإذا ضرع الغوادي جف في % % شتوة واغبرت الأرض جدوبا % % 52(@)(@@) % بسط الكف بها ثم دعى % % دونكم حافلة الضرع حلوبا % % 53(@)(@@) % وغدا يطرب إذ يسمعها % % للقرى هدارة الغلي غضوبا % % 54(@)(@@) % رث برد الحمد لولا ملك % كل آن يلبس الفخر قشيبا % % 55(@)(@@) % أطرب المدح إليه أنه % % فاتخ سمعا إلى المدح طروبا % % 56 
ms65	(@)(@@) % عربي الذوق يستحلي التي % % من عذارى الشعر جاءته عروبا % % 57(@)(@@) % خطب الأبكار مشغوفا بها % % فأقام الجود في الدنيا خطيبا % % 58(@)(@@) % فهو عذري الهوى في عذرها % % وهي من شوق له تطوي السهوبا % % 59(@)(@@) % أبدا تدعو له قائلة % لا رأت شمس معاليك الغروبا % % PageV01P211 البحر : رجز تام 1(@)(@@) % بشراك باليمن عليك وفدا % % من هذه الأفراح ما تجددا % % 2(@)(@@) % مسرة قد خصك الله بها % % تملأ قلب الكاشحين كمدا % % 3(@)(@@) % وفرحة أقبل يدعو بشرها % % يا معشر الحساد موتوا حسدا % % 4(@)(@@) % صفت لآل المصطفى برغمكم % % نطاف هذا البشر تحلو موردا % % 5(@)(@@) % بها احتلوا وجه السرور أبيضا % فاستقبلوا وجه النحوس أسودا % % 6(@)(@@) % يا سعد ما أبهجها مسرة % أم السرور مثلها لن تلدا % % 7(@)(@@) % سر بها الدهر بني العليا فلم % % يدع لهم قلبا عليه موجدا % % 8(@)(@@) % إذ بختان فرقدي سمائها % % لعترة المجد السرور خلدا % % 9(@)(@@) % عبد الكريم وسليمانهم ال % % ذين طابا في العلاء مولدا % % 10(@)(@@) % وغير بدع أن يطيب مولدا % من جده أزكى الأنام محتدا % % PageV01P212 11(@)(@@) % ذلك أعلا الماجدين همة % مولى ببرد الشرف المحض ارتدى % % 12(@)(@@) % ما خلة صالحة إلا بها % % رأى الأنام صالحا محمدا % % 13(@)(@@) % فيه لجبار السما عناية % أضحى بها بين الورى مؤيدا % % 14(@)(@@) % تسمى خطوط راحه أسرة % لأنها نقوش أسرار الندى % % 15(@)(@@) % من دوحة مثمرة قدما على % % أولى الزمان كرما وسؤددا % % 16(@)(@@) % دوحة مجد بسقت فروعها % % بحيث لا تلقى النجوم مصعدا % % 17(@)(@@) % نمت غصون كرم ما برحت % % بظلها تقيل طلاب الجدا % % 18(@)(@@) % حسبك منها شاهدا بمجدها % % أن نمت الهادي فرعا أمجدا % % 19(@)(@@) % ذاك الذي أبت سماء جوده % أن تمطر الوفاد إلا عسجدا % % 20(@)(@@) % ذاك الذي أبت صفايا خلقه % % إلا بأن تعذب حتى للعدى % % PageV01P213 21(@)(@@) % ذاك الذي أبت مزايا فخره % إلا بأن تفوق حتى الفرقدا % % 22(@)(@@) % مهذب يبصر في أعطافه % % شمائل المهدي مصباح الهدى % % 23(@)(@@) % شمائلا بين الورى أطيب من % % أنفاس روض بله طل الندى % % 24(@)(@@) % أورثه كماله وهديه % % وفخره ومجده الموطدا % % 25(@)(@@) % وعنه قد ناب بمكرماته % % يعمر فيها بيته المشيدا % % 26(@)(@@) % كالشمس أن تغرب بدا 
ms66	 البدر ابنها % % بنورها بأفقها متقدا % % 27(@)(@@) % فهو لعمري والحسين بعده % % أسمح أبناء ذوي الجود يدا % % 28(@)(@@) % هما هلالا الجود مصباحا النهى % % كلا عليه يجد الساري هدى % % 29(@)(@@) % فريدتا مجد على جيد العلى % % زانا بهاءا عقدها المنضدا % % 30(@)(@@) % يا آل بيت المصطفى من قد غدوا % % مأوى الضيوف متهما ومنجدا % % PageV01P214 31(@)(@@) % ومن على معروفهم تعاقبت % % بنو الرجاء مصدرا وموردا % % 32(@)(@@) % لتهنكم فرحة هادي عزكم % % بما له من ذا الهنا قد جددا % % 33(@)(@@) % وليهن ما غنى الحمام هو في % % ختان بدريه ويبهج أبدا % % 34(@)(@@) % فطائر الأفراح يا سعد به % % أرخ أجد زاهيا مغردا % % PageV01P215 البحر : كامل تام 1(@)(@@) % بشرى العلاء فذي مطالع سعده % % ولدت هلالا زاهرا في مجده % % 2(@)(@@) % وحديقة المعروف هاهي أنبتت % % غصنا سيثمر للعفاة برفده % % 3(@)(@@) % ونشت بأفق المكرمات سحابة % من ذلك البحر المحيط لوفده % % 4(@)(@@) % الآن رد على الزمان شبابه % % غضا فأصبح زاهيا في رده % % 5(@)(@@) % وجلت له الدنيا غضارة بشرها % % عن منظر شغل الحسود بوجده % % 6(@)(@@) % وحلا اصطباح الراح من يد أغيد % في خده تزهو شقائق ورده % % 7(@)(@@) % تجلى بكف رقيق حاشية الصبا % % متمايل الأعطاف ناعم قده % % 8(@)(@@) % يكسو الزجاجة خده فيديرها % % حمراء تحسب أنها من خده % % 9(@)(@@) % رقص الحباب على غناء نديمها % % طربا وود يكون موضع عقده % % 10(@)(@@) % شهد الضمير بأنها من ريقه % % مزجت بأطيب لذة من شهده % % PageV01P216 11(@)(@@) % فاشرب فدا الساقي عذولك واسقني % % كأسا وفى فيها الزمان بوعده % % 12(@)(@@) % وانهض كما اقترح السرور مهنيا % بفتى به الوهاب جاد لعبده % % 13(@)(@@) % ميلاده الميمون بورك مولدا % قد أصبح الإقبال خادم سعده % % 14(@)(@@) % تتوسم العلياء وهو بحجرها % % فيه مخائل من أبيه وجده % % 15(@)(@@) % جد له انتهت العلى من هاشم % وعلاء هاشم لا انتهاء لحده % % 16(@)(@@) % وكشاه في عصر الشبيبة والصبا % % برد النهى والحمد شيبة حمده % % 17(@)(@@) % فالبدر ود بأن يكون له أخا % والشهب تهوى أنها من ولده % % 18(@)(@@) % نضت الحمية منه سيف حفيظة % ماء الحيا الرقراق ماء فرنده % % 19(@)(@@) % لما رأيت الشام يبعد قصده % % عن ركب فيحاء العراق ووخده % % 20(@)(@@) % أودعت 
ms67	 تهنئتي إليه رسالة % تهدى على شحط المزار وبعده % % PageV01P217 21(@)(@@) % ودعوت حاملها لأشرف منزل % بالشام خذ عني السلام وأده % % 22(@)(@@) % حي السعيد محمدا فيه وقل : % بشرى بأشرف طالع في سعده % % 23(@)(@@) % بأغر ينميه إلى عمرو العلى % % حسب محمده علي معده % % 24(@)(@@) % حملته أم الفخر سيد قومه % % وأتت به والفضل ناسج برده % % 25(@)(@@) % ولد سيرفع عن علاك بولده % % ويشد أزرك في بلوغ أشده % % 26(@)(@@) % لو لم يكن فلك المجرة مهده % لم تطلع الشعرى العبور بمهده % % 27(@)(@@) % قرت به عين الفخار لأنها % % لم تكتحل أبدا برؤية نده % % 28(@)(@@) % فليهنين حمى السيادة إنه % % قد أطلعت شبلا عرينة اسده % % 29(@)(@@) % وانشق مسك ثرى النبوة فيه عن % % ريحانة الهادي ووردة مجده % % 30(@)(@@) % فاليوم كف لوي عاد بنانها % % فيها وسل حسامها من غمده % % PageV01P218 31(@)(@@) % وتباشرت طير السماء كأنما % % نشر ابن هاشم للقرى من لحده % % 32(@)(@@) % وكأنما الدنيا لتهنية العلى % % ناد تأنقت السعود بعقده % % 33(@)(@@) % وكأن كل الناس منطق واحد % يشدو ليهن الفخر مولد فرده % % 34(@)(@@) % وبديعة في الحسن قد أهديتها % % جهد المقل لمكثر من حمده % % 35(@)(@@) % خطبت له بلسان أشرف من بنى % % في الكرخ بيتا سقفه من مجده % % 36(@)(@@) % بيت يظلل بالنعيم إذا أوى % % ضيف إليه رآه جنة خلده % % 37(@)(@@) % وإليكما غراء بأرج عطفها % % بنسيم غالية الثناء ونده % % 38(@)(@@) % نطقت بناديك العلي وأرخت % % ولد النهى للفضل أسعد ولده % % PageV01P219 البحر : رجز تام 1(@)(@@) % سقتك يا ربع العلى عهادها % % وطفاء بشر أطلقت مزادها % % 2(@)(@@) % تلمع للزهو بها بوارق % تقدح في قلب العدى زنادها % % 3(@)(@@) % لاطفها فيك نسيم أرج % إلى حماك ساقها وقادها % % 4(@)(@@) % فألبستك زهرها وأنبتت % % ما بين أجفان العدى قتادها % % 5(@)(@@) % وأبرزت منك لأحداق الورى % % حديقة نوء السرور جادها % % 6(@)(@@) % يا رائد الأفراح في دار العلى % % قد صدقتك نفسك ارتيادها % % 7(@)(@@) % باكر مناك وارتشف رياضها % % كما اشتهيت واقتطف أورادها % % 8(@)(@@) % وحي في الدست زعيم هاشم % وخير من سادت به وسادها % % 9(@)(@@) % القائم المهدي أقضى من ثنت % % رياسة الدين له وسادها % % 10(@)(@@) % وقل ولا تحفل بغيظ أنفس % قد تركت 
ms68	 لغيها رشادها % % PageV01P220 11(@)(@@) % ما علماء الأرض إلا رجل % قد جمع الله به آحادها % % 12(@)(@@) % لجة علم عذبت مواردا % كل ذوي الفضل غدت ورادها % % 13(@)(@@) % وروضة لو كشف الله الغطا % % رأيت أملاك السما روادها % % 14(@)(@@) % أعلمهم بالله بل أدلهم % % على التي من خلقه أرادها % % 15(@)(@@) % حامى عن الدين فسد ثغرة % ما ضمنوا عنه له انسدادها % % 16(@)(@@) % فاستلها صوارما فواعلا % فعل السيوف ثكلت أغمادها % % 17(@)(@@) % الموقد النار عشيا للقرى % % وبشره يتقد اتقادها % % 18(@)(@@) % والمرخص الزاد وكان جده % % لراكبي ظهر الفلاة زادها % % 19(@)(@@) % قد فاخرت جفانه شهب السما % % بضوئها وكاثرت عدادها % % 20(@)(@@) % بشراك وضاح الدجى بفرحة % قد بلغت فيها العلى مرادها % % PageV01P221 21(@)(@@) % حلت نطاق الليل عن صبيحة % قد نسجت أيدي الهنا إبرادها % % 22(@)(@@) % لو عرب الإسلام باهت فرسه % % بحسنها لاستحقرت أعيادها % % 23(@)(@@) % أنت الذي قد عقد الله به % % عرى الهدى وأحكم انعقادها % % 24(@)(@@) % منك اعدت هاشم لمجدها % % من نشر الله به أمجادها % % 25(@)(@@) % فقللت فيك مريدي فخرها % % وفي بنيك كثرت حسادها % % 26(@)(@@) % أبناء مجد نشأوا سحائبا % سقى الإله خلقه عهادها % % 27(@)(@@) % أنملها العشر جميعا حلم % أرضعت الدنيا بها أولادها % % 28(@)(@@) % بيض المساعي ومساعي غيرهم % % بيض وصفر أحسنوا انتقادها % % 29(@)(@@) % لم تبتدء بين الورى اكرومة % إلا وكل منهم أعادها % % 30(@)(@@) % عقدت أطناب العلى وابتدروا % % يرفع كل منهم عمادها % % PageV01P222 31(@)(@@) % وغيرهم يهدم علياه التي % % سعى أبوه قبله فشادها % % 32(@)(@@) % قوم إذا شب ابن مجد منهم % % ألقت لكفيه العلى قيادها % % 33(@)(@@) % أو زوجوه فبأخت شرف % يحكي طريف مجدها تلادها % % 34(@)(@@) % لو لم تجد منه المعالي كفوها % % لم ترض إلا في الخبا انفرادها % % 35(@)(@@) % يا من يروم بأبيه هضبهم % % ونفسه قد سكنت وهادها % % 36(@)(@@) % خلفك والفخر بنار ذهبت % % بضوئها وخلفت رمادها % % 37(@)(@@) % بني العلى دونكموها غادة % عذراء قد أصفتكم ودادها % % 38(@)(@@) % جلت بكم قدرا فما أنشدتها % % إلا ازدهت جبريل فاستعادها % % PageV01P223 البحر : مجزوء الكامل 1(@)(@@) % إيماض برق أم ثغور % في ضمنها نطف الخمور % 2(@)(@@) % حلب الغمام رضابها % % وحديثها حلب العصير % 3(@)(@@) % لما نشرن لنا حديث % الوصل كالروض النضير 
ms69	 % 4(@)(@@) % ساقطن عن برد تنظم % % رائق الدر النثير % 5(@)(@@) % سقيا لليلة لهونا % % في ذلك الرشإ الغرير % 6(@)(@@) % والكاس دائرة علي % تعينها عين المدير % 7(@)(@@) % فمفاصلي وجفونه ال % % وسنا سواء في الفتور % 8(@)(@@) % نشوات سكر أمكنتني % % من محالات الأمور % 9(@)(@@) % لو يعتفيني عندها % % رب الشويهة والبعير % 10(@)(@@) % لوهبت من طربي له % % رب الخورنق والسدير % PageV01P224 11(@)(@@) % الآن دع يا سعد قا % % صرة الغواني للقصور % 12(@)(@@) % وانهض لبشرى طبق % % الدنيا بها صوت البشير % 13(@)(@@) % بشفاء من عبرت معا % % ليه على الشعرى العبور % 14(@)(@@) % كم عين داع إذ شكى % % شخصت إلى الملك القدير % 15(@)(@@) % واستوهبته شفاء بدر % % المجد وهاب البدور % 16(@)(@@) % فأجاب دعوتها وقال : % رجعت في جفن قرير % 17(@)(@@) % فبه لك البشرى وفي % % أعداه داعية الثبور % 18(@)(@@) % أقسمت ما لكفاية الأ % % حرار فادحة الأمور % 19(@)(@@) % إلا محمد صالح % ولنعم جار المستجير % 20(@)(@@) % مولى غدت بشفائه الأ % % يام باسمة الثغور % PageV01P225 21(@)(@@) % عبق بعطفيه عبير ال % % مجد لا عبق العبير % 22(@)(@@) % نظر الزمان بأعين % % أبدا إلى علياه صور % 23(@)(@@) % عدد النجوم جفانه % % والراسيات من القدور % 24(@)(@@) % تقف المكارم عنده % % وتسير حيث يقول سيري % % 25(@)(@@) % فإذا نظرت إلى الزمان % % بعين منتقد بصير % 26(@)(@@) % لم تلقه إلا صحيفة % % مأثرات بني الدهور % 27(@)(@@) % وسوى مآثره الجميلة % % ليس فيها من سطور % 28(@)(@@) % تغنيه أول نظرة % في الرأي عن نظر المشير % 29(@)(@@) % ويرى بعين وروده % % في الأمر عاقبة الصدور % 30(@)(@@) % تغذو حلوبة جوده % % العافين بالدر الغزير % PageV01P226 31(@)(@@) % يتشطرون ضروعها % % لا بالثلوث ولا الشطور % 32(@)(@@) % زرعوا رجاءهم بجا % % نب جوده العذب النمير % 33(@)(@@) % فنما ورف عليه مثل % النبت رف على الغدير % 34(@)(@@) % لولا نظارة ولده % % لحلفت عز عن النظير % 35(@)(@@) % إذ من بهاه بهاؤهم % % وكذا الشعاع من المنير % 36(@)(@@) % أو ما ترى للبدر ما % % للشمس من شرف ونور % 37(@)(@@) % خير الكرام وفيهم % % ما شئت من كرم وخير % % 38(@)(@@) % تروي قديم المجد % % تسنده صغيرا عن كبير % 39(@)(@@) % يا معشرا لولاهم % % أضحى السماح بلا عشير % 40(@)(@@) % قرت عيونكم بصحة % % صفوة الشرف الخطير % PageV01P227 41(@)(@@) % وهناكم 
ms70	 المنشور من % % هذا السرور إلى النشور % PageV01P228 البحر : خفيف تام 1(@)(@@) % طرب الدهر فاستهل منيرا % % يملأ الكون بهجة وسرورا % % 2(@)(@@) % وسرت نفحة من البشر فيه % % ضمخت خيمة السماء عبيرا % % 3(@)(@@) % عدن أوقاته رقاق الحواشي % % لك تهدي بشاشة وحبورا % % 4(@)(@@) % كل وقت يمر منه تراه % % بارد الظل طيبا مستنيرا % % 5(@)(@@) % فكأن الهجير كان أصيلا % وكأن العشي كان بكورا % % 6(@)(@@) % بوركت من صبيحة في ضحاها % % وفد اليمن بالسعود بشيرا % % 7(@)(@@) % وإلى طلعة جلت كل هم % ببنان الإقبال أضحى مشيرا % % 8(@)(@@) % فتأمل عقود هذي التهاني % % كيف زانت بها الليالي النحورا % % 9(@)(@@) % وتصفح أيامها الغر وانظر % % كيف قد وشحت بهن الخصورا % % 10(@)(@@) % فرح من شعاعه اقتبس النور % محيا الدنيا فشع منيرا % % PageV01P229 11(@)(@@) % فاقتبل عمرها جديدا وأيامك % % عيدا والعيش غضا نظيرا % % 12(@)(@@) % طاب نشر الأفراح في بشر قوم % لهم الفضل أولا وأخيرا % % 13(@)(@@) % عترة المجد أسرة الشرف المحض % % زكوا محتدا وطابوا حجورا % % 14(@)(@@) % شرع في العلى وغير عجيب % فلها رشح الكبير الصغيرا % % 15(@)(@@) % معهم يولد النهى فترى اليا % % فع كهلا والكهل شيخا كبيرا % % 16(@)(@@) % خاطروا في العلى فناهيك فيهم % % شرفا باذخا ومجدا خطيرا % % 17(@)(@@) % منهم يستضاء شرقا وغربا % بوجوه تكسوا الكواكب نورا % % 18(@)(@@) % فمع الشمس يشرقون شموسا % ومع البدر يشرقون بدورا % % 19(@)(@@) % أيها العصر لا أرى لك مثلا % زانك المصطفى فباهي العصورا % % 20(@)(@@) % قبله هل مسحت غرة صبح % عن لثام الأسفار أبدت سفورا % % PageV01P230 21(@)(@@) % شخصت نحوه العيون ولكن % % عاد بعض يقذى وبعض قريرا % % 22(@)(@@) % فبعين شعاعه كان نارا % وبعين شعاعه كان نورا % % 23(@)(@@) % بلغته الرضا عزيمة نفس % كبرت أن ترى الخطير خطيرا % % 24(@)(@@) % كم طوى البيد باسطا كف جود % نشرت ميت الندى المقبورا % % 25(@)(@@) % واستقل البحور جودا فأجرى % % من أسارير راحتيه بحورا % % 26(@)(@@) % مانحا بلدة بمسراه إلا % وأبت نحو غيرها أن يسيرا % % 27(@)(@@) % إذا ذكره أطاف بأخرى % % كاد شوقا فؤادها أن يطيرا % % 28(@)(@@) % فأتى مشهدا لمن طاف فيه % % قد أعد الإله أجرا كبيرا % % 29(@)(@@) % فيه لطف الله الذي من يزره % % زار في عرشه اللطيف الخبيرا % % 30 
ms71	(@)(@@) % حاز أجرا لو الورى اقتسمته % % لغدا فيه كلهم مأجورا % % PageV01P231 31(@)(@@) % وبتلك الديار أبقى مزايا % تستقل المنظوم والمنثورا % % 32(@)(@@) % وانثنى راجعا بأحشاء قوم % معه سافرت وعفن الصدورا % % 33(@)(@@) % يا نديمي على الهنا زانك الله % % ولقاك نظرة وسرورا % % 34(@)(@@) % قل لعبد الكريم بشراك يا من % % شاد بيت المكارم المعمورا % % 35(@)(@@) % قد أقر الإله عينيك فيمن % % كان في غرة لعينيك نورا % % 36(@)(@@) % زار بغداد من بها ركز اليوم % لواء المفاخر المنشورا % % 37(@)(@@) % راقها منه طلعة بدر مجد % لا رأت للغروب فيه نذيرا % % 38(@)(@@) % ما تجلى بباهر الضوء إلا % عاد طرف الحسود عنه حسيرا % % 39(@)(@@) % حسدتها السما عليه وقالت % % لمجليك ما حويت نظيرا % % 40(@)(@@) % لو قبلت التعويض عنه لقاي % % تك حتى هلالي المستنيرا % % PageV01P232 41(@)(@@) % فهو يغني عمن سواه ولكن % % ليس يغني سواه عنه نقيرا % % 42(@)(@@) % من رآه يقري الضيوف ويسعى % % للمعالي ويطلق المأسورا % % 43(@)(@@) % قال : هذا محمد ذلك الصا % % لح قد عاد شخصه منشورا % % 44(@)(@@) % ونعم لا تقل طوى الموت من لم % % تفتقد منه سعيه المشكورا % % 45(@)(@@) % وكذا الشمس إن تغب فابنها البد % % ر يجلي بنورها الديجورا % % 46(@)(@@) % يا بن من قد أتى على الجود حين % فيه لولاه لم يكن مذكورا % % 47(@)(@@) % بك قرت عينا أخيك كما طر % % فك قد عاد في أخيك قريرا % % 48(@)(@@) % فلمن منكما أهني تساوى % % فيكما البشر زائرا ومزورا % % 49(@)(@@) % إنما أنت للمعالي يمين % وهو قد كان سيفها المشهورا % % 50(@)(@@) % فإذا ما هززته يوم فخر % جاءك الدهر مذعنا مستجيرا % % PageV01P233 51(@)(@@) % فرويدا مراهنيه رويدا % لن تشقوا غباره المستطيرا % % 52(@)(@@) % خلفكم عن مدى يشق عليكم % % ما ركبتم إليه إلا الغرورا % % 53(@)(@@) % ما لعليا محمد حسن الأخلاق % % تلقى الشعرى العبور عبورا % % 54(@)(@@) % ماجد النفس في اقتبال صباه % % يلبس الفخر كل آن حبيرا % % 55(@)(@@) % مستطيل كم ابتدا مكرمات % عاد باع الكرام عنها قصيرا % % 56(@)(@@) % رف نبت المنى بجانب جدوا % % ه فكانا خميلة وغديرا % % 57(@)(@@) % كان تأريخ بيته أول الدهر % % على جبهة العلى مسطورا % % 58(@)(@@) % عن أبيه عن جده المصطفى ير % % وي حديث المكارم المأثورا 
ms72	 % % 59(@)(@@) % قد بنى في السماء قبة مجد % تخذ النيرات فيها سميرا % % 60(@)(@@) % من كرام قد استرقوا لباس ال % % حمد والناس تسترق الحريرا % % PageV01P234 61(@)(@@) % لعلاها محمد قد أعدته % % جوادا على الثناء مغيرا % % 62(@)(@@) % كم جرى والصبا بحلبة جود % فغذا عنه شأوها محسورا % % 63(@)(@@) % وجلا أفقها محمد الها % % دي لمن نص في الظلام المسيرا % % 64(@)(@@) % كوكب عز أن يرى فلك المجد % % منيرا بمثله مستديرا % % 65(@)(@@) % ولها من محمد بأمين % حفظت كنز فخرها المذخورا % % 66(@)(@@) % قد رقى حيث ليس ترقى الثريا % % وسقى الوافدين نوءا غزيرا % % 67(@)(@@) % وبعبد الحسين قد فاخروا الشم % % س فودت في الأفق أن لن تنيرا % % 68(@)(@@) % هم بنو السؤدد القديم كما هم % % إخوة المجد واحدا وعشيرا % % 69(@)(@@) % فادع غريد أنسهم ثم أرخ % % رجعة المصطفى بها اسجع دهورا % % PageV01P235 البحر : خفيف تام 1(@)(@@) % حي تحت الدجى محيا أنارا % % فأحال الليل البهيم نهارا % % 2(@)(@@) % واعتنق كاللجين ناظر قد % لا يجيل الوشاح إلا نضارا % % 3(@)(@@) % وارتشف كالسلاف ريقة ساق % خلت منها أدار لي ما أدارا % % 4(@)(@@) % سحرا زارنا وأرخى جعودا % ذات نشر تعطر الأسحارا % % 5(@)(@@) % وجلاها وردية اللون فيها % % خلت أن قد أذاب لي جلنارا % % 6(@)(@@) % ما أنارت من جانب الكأس إلا % قال قلبي الكليم آنست نارا % % 7(@)(@@) % يا نديمي على الطلى عاطنيها % % أخت خديك رقة واحمرارا % % 8(@)(@@) % هاتها تطلق النفوس من الأسر % % كما تترك العقول أسارى % % 9(@)(@@) % وبها يا بن نشوة الكأس صرفا % داو شوقي فقد مرضت انتظارا % % 10(@)(@@) % وعلى الرشف قرط السمع مني % % نغمات تحرك الأوتارا % % PageV01P236 11(@)(@@) % غنني باسم ناعم حضنته % % في ظلال النعيم بيض العذارى % % 12(@)(@@) % وغرير حلا بعيني ومنها % % قد حمى الجفن أن يذوق غرارا % % 13(@)(@@) % زار سرا وكان صد جهارا % فأراني نجوم ليلي نهارا % % 14(@)(@@) % كم تعاطيت من مقبله العذب % على ورد وجنتيه عقارا % % 15(@)(@@) % في رياض جلت عرائس زهر % كان طل الأنداء فيها نثارا % % 16(@)(@@) % واكتستها ديباجة ألحم القطر % وسدى في نسجها وأنارا % % 17(@)(@@) % كلما زر نورها الغض جيبا % عنه حلت يد الصبا الأزرارا % % 18(@)(@@) % خلعة من بهاء 
ms73	 عرس غني % كان حسنا بهاؤها مستعارا % % 19(@)(@@) % ماجد قرت العلى فيه عينا % واستهلت بسعده استبشارا % % 20(@)(@@) % وغني بفخرها أطلعته % % كوكبا في سمائها سيارا % % PageV01P237 21(@)(@@) % عرسه غادر الحواسد بالأم % % س سكارى وما هم بسكارى % % 22(@)(@@) % وعلى قطب دارة المجد زهوا % فلك اليمن بالسعود استنارا % % 23(@)(@@) % ذلك المصطفى الذي للمعالي % % إن جرى قيل سابق لا يجارى % % 24(@)(@@) % رق طبعا وراق خلقا وخلقا % وزكى شيمة وطاب نجارا % % 25(@)(@@) % قد حمى حوزة العلى في زمان % غيره فيه ليس يحمي ذمارا % % 26(@)(@@) % واستطالت به على الدهر كبرا % همم تبذل الخطير احتقارا % % 27(@)(@@) % بيته كعبة الندى وحماه % % لبني الدهر لم يزل مستجارا % % 28(@)(@@) % من أناس بذكرهم أنجد المد % % ح على أول الزمان وغارا % % 29(@)(@@) % هم أطالوا عمر السماح وأعما % % ر المواعيد قدروها قصارا % % 30(@)(@@) % كلهم ينتمي لدوحة مجد % شرفا أثمرت علا وفخارا % % PageV01P238 31(@)(@@) % تلك أقمار سؤدد بل شموس % ولدت في سما العلى أقمارا % % 32(@)(@@) % فإذا بأهلوا السما بأبي ال % % هادي وقد أشرقت تروم افتخارا % % 33(@)(@@) % رأت الأرض تستنير بوجه % حسن مثله بها ما استنارا % % 34(@)(@@) % ودعت يا رفيعة القدر من أن % % جمي الزهر خفظي الأقدارا % % 35(@)(@@) % لست إلا فدى لوجه كريم % ليس يرضى بدارة الشمس دارا % % 36(@)(@@) % ذو يمين مبسوطة بالعطايا % % لا تغب الوفاد منها اليسارا % % 37(@)(@@) % فلكم حررت أرقاء دهر % واسترقت من الورى أحرارا % % 38(@)(@@) % مستشار وهل لعقد وحل % يجد القوم مثله مستشارا % % 39(@)(@@) % هو أنكى رأيا لطارقة الخطب % % وأذكى لطارق الضيف نارا % % 40(@)(@@) % لست أدري إذا احتبى ناطقا بال % % كلم الفصل ناهيا أمارا % % PageV01P239 41(@)(@@) % أبصدر النادي توقر رضوى % % أم هو احتله فأرسى وقارا % % 42(@)(@@) % حص قوم حر القريض فأضحى % % واقعا لا يرى لأفق مطارا % % 43(@)(@@) % وهو قد راشه فرف بجنحيه % % اشتياقا ونحو علياه طارا % % 44(@)(@@) % يا بني المصطفى كفى نظرا للمج % % د منكم بأن تهينوا النضارا % % 45(@)(@@) % والمعالي ليهنها أن تقضوا % % طربا في وصالها الأوطارا % % 46(@)(@@) % وليزود ربع المكارم زهوا % إنكم تعمرون منه الديارا % % 47(@)(@@) % قد كفيتم من غارة البخل لما % % أن نهضتم مشمرين 
ms74	 غيارى % % 48(@)(@@) % وهي لولاكم لطلت دم الجود % % وقالت قد ضعت فاذهب جبارا % % 49(@)(@@) % أينعت روضة الهنا فاجتنينا % % لكم التهنيات منها ثمارا % % 50(@)(@@) % وغفرنا ذنب الزمان وقلنا % % قد أقلناك يا زمان العثارا % % PageV01P240 51(@)(@@) % وأزرنا عقيلة الفكر ترخي % % طربا للنشيد منها الأزارا % % 52(@)(@@) % يممتكم عطرى البرود بذكرا % % كم فناهيكم بها معطارا % % 53(@)(@@) % إن جلت من عرائس اللفظ عونا % فالمعالي تزفها أبكارا % % 54(@)(@@) % هي غيظ الحسود لم تجل إلا % زاد أهل الكمال فيها ابتهارا % % 55(@)(@@) % وغدت تكثر القيام لأعجاب % % بها والحسود يبدي ازورارا % % 56(@)(@@) % كلما أنشدت دعى المجد قام % القوم إلا وللحسود أشارا % % 57(@)(@@) % فأقيموا على السرور بعصر % هو فيكم يفاخر الأعصارا % % PageV01P241 البحر : مجزوء الكامل 1(@)(@@) % أرأيت كيف بدا يشير % بلحاظه الرشأ الغرير % 2(@)(@@) % خط ابن مقلته الهوى % % وارتاح يقرأه الضمير % % 3(@)(@@) % في طرس خد من خيال % % الهدب لاح به سطور % 4(@)(@@) % فصحيفة البشرى محياه % % ورونقه البشير % % 5(@)(@@) % حيا بيوم كاد يقطر % % من غضارته السرور % 6(@)(@@) % وأدار لامعة تشف % كخده - بأبي - المدير % 7(@)(@@) % أهلا وقد حدر اللثا % % م كأنه القمر المنير % % 8(@)(@@) % رشأ إذا كسر الجفون % فقلب عاشقه الكسير % 9(@)(@@) % والجفن أصرع ما يكون % % غداة يصرعه الفتور % % 10(@)(@@) % خصر اللمى تحيى وتق % % تل في تكسرها الخصور % PageV01P242 11(@)(@@) % يا جاهلا نبأ اللحاظ % % وذاك يعقله البصير % % 12(@)(@@) % أفلا سقطت على الخبير % % بوحيها فأنا الخبير % 13(@)(@@) % إن الوجوه لكا الزجاجة % % تستبين بها الأمور % % 14(@)(@@) % وتشف عما خلفها % % فله بها أبدا ظهور % 15(@)(@@) % وإذا القلوب تراسلت % % فمن اللحاظ لها سفير % % PageV01P243 البحر : مجزوء الكامل 1(@)(@@) % بشراك زرتك يقظة % % فالطيف طارقه غرور % 2(@)(@@) % فدعوت لي فيه الهنا % % ولغيري الجد العثور % % 3(@)(@@) % أحبب إليك بهالة % فيها تنادمت البدور % 4(@)(@@) % هي جنة لكن سقاة % رحيقها المختوم حور % % 5(@)(@@) % بين الخدور ولا أصرح % باسم من حوت الخدور % 6(@)(@@) % بيضاء مطعمة الهوى % % شهدت بعفتها الستور % % 7(@)(@@) % كلفي بصائدة القلوب % % ومن حبائلها الشعور % 8(@)(@@) % ما بين قرطيها إلى الخل % % خال روض صبا نظير % % 9(@)(@@) % والوجنتان شقيقة % ماء الشباب لها غدير % 10(@)(@@) % كيف الوصول لخدرها 
ms75	 % % ووراء كلتها الغيور % % PageV01P244 11(@)(@@) % لام العذول بها وقال : % من الصبابة لا غدير % 12(@)(@@) % لا تخدعنك غريرة % هي أمها الدنيا الغرور % % 13(@)(@@) % والعشق لا يملك فؤاد % % ك فهو سلطان يجور % 14(@)(@@) % كم مغرم حكمت بمهجته % % الترائب والنحور % % 15(@)(@@) % ثم انثنت ولها حشا % % شة صدره وله الزفير % 16(@)(@@) % قسما بأيدي الراميات % إلى منى عنقا تسير % % PageV01P245 البحر : مجزوء الكامل 1(@)(@@) % قل الكرام وإنما % % بكم قليلهم كثير % 2(@)(@@) % ولكل عصر أول % % منهم لأولكم أخير % % 3(@)(@@) % نفر إلى غير المساعي % % العز ليس لكم نفير % % 4(@)(@@) % للمجد كلكم بدور % % فلك السعود بها يدور % 5(@)(@@) % وعلى ارتشاف طلى الهنا % % أبدا نديمكم السرور % % 6(@)(@@) % أصبا القريض قفي فقد % % بلغ المقام بك المسير % 7(@)(@@) % حطي اللثام فهاهنا % % روض المباكر والغدير % % 8(@)(@@) % ومن القوافي فتحي % % زهرا به تبهى العصور % 9(@)(@@) % يبقى كما اشتهت العلى % % غظا تهاداه الدهور % % 10(@)(@@) % سبحان من بالمصطفى % % أسرى فطاب له المسير % % PageV01P246 11(@)(@@) % حملته همته وتلك % % هي البراق به تطير % PageV01P247 البحر : كامل تام 1(@)(@@) % للحج سار ومن رأى % % ركنا إلى ركن يسير % % 2(@)(@@) % فالأرض تشهد كلها % % لك إنك النوء الغزير % % 3(@)(@@) % حيت أغر كأن طلع % % ة وجهه قمر منير % PageV01P248 البحر : مجزوء الكامل 1(@)(@@) % لا النسر طار لها ولا % % عبرت بها الشعرى العبور % % 2(@)(@@) % قري شقاشق غيرها % % فبذا الندي لها الهدير % PageV01P249 البحر : خفيف تام 1(@)(@@) % عش مهنا فكل يوم يمر % لك عيد وللحواسد نحر % % 2(@)(@@) % في سرور جميعه لك لكن % % هو شطر لنا وللدين شطر % % 3(@)(@@) % إنما العيد أن نراك مطاعا % لك نهي على الزمان وأمر % % 4(@)(@@) % ونرى الوجه منك يلمع بشرا % منك للدهر ملأ عينيه بدر % % 5(@)(@@) % يرجع الطرف أن أراك عدوا % وكأن مر بين جفنيه جمر % % 6(@)(@@) % فلشمل السرور عندك نظم % وعلى حاسديك للسوء نثر % % 7(@)(@@) % أنت يا كعبة الهدى مشعر الحق % % على رغم أنف من لا يقر % 8(@)(@@) % لك فسكر يطالع الغيب حتى % ليس من دونه عن الغيت ستر % % 9(@)(@@) % وإليك الرياسة انتهت اليوم % وفيها للدين عز ونصر % % 10(@)(@@) % قمت فيها على التقى فتمنى % % كل 
ms76	 عصر بأنه لك عصر % % PageV01P250 11(@)(@@) % من ترى في ولائنا منك أولى ؟ % ولك الود للرياسة أجر % % 12(@)(@@) % أنت بحر لكن جدواك مد % كل آن والبحر مد وجزر % % 13(@)(@@) % أنت غيث لكن جودك من أولا % % ه سكب وأول الغيث قطر % % 14(@)(@@) % ذو بنان بموضع الجود تسمى % % وهي من مرضع الغمام أدر % 15(@)(@@) % أتملات ما أتعبتها العطايا % % ومتى أتعب الغمائم قطر % % 16(@)(@@) % فاخرت أرضها السماء فقلنا % % لك لولا بيت على الأرض فخر % % 17(@)(@@) % فيه شمس الهدى وأربعة منه % % بدور وفيك شمس وبدر % % 18(@)(@@) % هم به للسماح خمسة أنهار % % وذا فيك للمجرة نهر % % 19(@)(@@) % حرم باب عزه مستجار % وهو دون اللاجي على الدهر حجر % % 20(@)(@@) % لم يقع في حماه حجر على صيد % ولا طار نحو علياه نسر % % PageV01P251 21(@)(@@) % ومعار بغلطة الحظ عزا % قد ثنى العطف منه زهو وكبر % % 22(@)(@@) % ظن أن الفخار قصر منيف % % وثياب عليه حمر وصفر % % 23(@)(@@) % فتعاطى علاك وهو ابن خفض % يزن الطود ضلة وهو ذر % % 24(@)(@@) % ثم أعيى وحطه النقص عجزا % أن يساوي بقدره لك قدر % % 25(@)(@@) % قلت أقصر وحشو ثوبك خزي % عن علا ملؤ برده منه فخر % % 26(@)(@@) % جل قدرا فقبله ما رأينا % % بشرا ولده ملائك غر % 27(@)(@@) % هو بدر النهى وهم في علاه % % أنجم في مطالع الفضل زهر % % 28(@)(@@) % كل كاس من الجميل ففخرا % نسج بردي علاه حمد وشكر % % 29(@)(@@) % ماجد النفس في الخليقة حلو % إن تذقه وفي الحفيظة مر % 30(@)(@@) % حفظوا حوزة العلى في زمان % % بين أنيابه دم المجد هدر % % PageV01P252 31(@)(@@) % فهم أخوة المكارم فيهم % % لا رأت عينها سوى ما يسر % % PageV01P253 البحر : كامل تام 1(@)(@@) % أسقتك يا ربع الحبيب قطارها % % ديم إليك حدى النسيم عشارها % % 2(@)(@@) % من كل هاضبة تألف برقها % % فأتتك تتبع عينها أبكارها % % 3(@)(@@) % نفاحة وسمت رباك فروضت % % من بعد ما محت الصبا آثارها % % 4(@)(@@) % وبأيمين العلمين أمثال المها % % لا يستطيع أخو الغرام مزارها % % 5(@)(@@) % علمن أغصان النقا فتمايلت % % طربا وعلمت الشجى أطيارها % % 6(@)(@@) % إن تمنع الأعراب روضة ريمها % % عني وتأبى أن أشم عرارها % % 7 
ms77	(@)(@@) % فلأعدلن بصبوتي عنها إلى % % فئة على الروحين أعهد دارها % % 8(@)(@@) % حي من الأتراك بين خدورهم % % هيفاء تمنح وصلها من زارها % % 9(@)(@@) % وافت تبرقع وجهها قمر الدجى % % وتزر في شهب السما زنارها % % 10(@)(@@) % فصم السوار لفعمة من زندها % % فكأنما كان الهلال سوارها % % PageV01P254 11(@)(@@) % فدنوت منها لا أهم بريبة % فيها ولم تطرح لدي أزارها % % 12(@)(@@) % لكن ليقضي ناظري من حسنها % % الأوطار لا أقضى لها أوطارها % % PageV01P255 البحر : كامل تام 1(@)(@@) % ماتوا بغيظهم وليت نفوسهم % % فيها المنية أنشبت أظفارها % % 2(@)(@@) % ما مد في أعمارهم لكرامة % لكنما كره الأله جوارها % % PageV01P256 البحر : رجز تام 1(@)(@@) % صبح الهنا اليوم تجلى أبيضا % % وبالمنى ربع التهاني روضا % % 2(@)(@@) % فقم إلى كأس التهاني واصطبح % % فيها بناد بسنا البشر أضا % % 3(@)(@@) % فان هذي فرحة من قبلها % % لمثلها الزمان ما تعرضا % % 4(@)(@@) % من لم يكن يأخذ منها حظه % % فليت شعري ما الذي تعوضا % % 5(@)(@@) % وكيف لا يدخل في كل حشا % منها سرور سر أحشاء الرضا % % 6(@)(@@) % أسخى الورى الناهض من ثقل الندى % % بما به كل الورى لن تنهضا % % 7(@)(@@) % ذاك الذي من كرم النفس يرى % % ندب صلاة وفده مفترضا % % 8(@)(@@) % ذاك الذي كلتا يديه رهمة % ربعية بها المنى قد روضا % % 9(@)(@@) % ذاك الذي للمسنتين جوده % % رقى إذا صل الجدوب نضنضا % % 10(@)(@@) % ذاك الذي سمت به همته % % لغاية عنها السماك انخفضا % % PageV01P257 11(@)(@@) % ذاك الذي لو لم يشيد للعلى % % بناءها السامي إذا لانتقضا % % 12(@)(@@) % ذاك الذي للمجد كان جوهرا % وكان كل الماجدين عرضا % % 13(@)(@@) % يزين كل الناس بعض فخره % % لو أنه عليهم تبعضا % % 14(@)(@@) % له سجايا من أبيه حسنت % % وبسط كف في الندى ما انقبضا % % 15(@)(@@) % وغرة من لمعها تحت الدجى % % أعارت البرق السنا فأومضا % % 16(@)(@@) % يصرح البشر بها للمجتدي % % بالنجح قبل أن يرى معرضا % % 17(@)(@@) % أحبب بدهر جلب البشر به % % وكان قبل جلبه مبغضا % % 18(@)(@@) % إذ في ختان قرتي عين العلى % % سر الأنام أسودا وأبيضا % % 19(@)(@@) % طاب الهنا فيه لهم فيا له % % قطعا به وصل الهنا تقيضا % % 20(@)(@@) % فليهن في عبد الحسين ما 
ms78	 شدت % % في الأيك ورقاء وما برق أضا % % PageV01P258 21(@)(@@) % وليزه في عبد العزيز فلقد % % زها به جميع ما ضم الفضا % % 22(@)(@@) % واليوم في ختان كل أرخوا % % بالزهو قد حوى محمد الرضا % % PageV01P259 البحر : خفيف تام 1(@)(@@) % عثر الدهر فاستقال سريعا % % رب عبد عصى فآب مطيعا % % 2(@)(@@) % زل لكنه تراجع لما % % ملأت هيبة حشاه صدوعا % % 3(@)(@@) % قرن الذنب بالإنابة واستش % % عر من عظم ما جناه الخشوعا % % 4(@)(@@) % وتمنى وإن هو استدرك الهف % % وة لو قبلها تردى صريعا % % 5(@)(@@) % ورأى أنه أساء لرجل % شرفا بالرؤوس تفدى جميعا % % 6(@)(@@) % وإلى منكب عليه استقلت % % قبة الدين ، لا به الدين ريعا % % 7(@)(@@) % راحتا جبرئيل منه تلقت % % منكب المصطفى تقيه الصدوعا % % 8(@)(@@) % وترقى يبشر الملأ الأعلى % % بمولى عليه خافوا الوقوعا % % 9(@)(@@) % يا عيونا سهرت بالأمس قري % % أقبل اليوم من ملاك هجوعا % % 10(@)(@@) % وقلوبا رففت شوقا إليه % % لك وافى فلا تشقي الضلوعا % % PageV01P260 11(@)(@@) % قد أتى رافها بصحة جسم % تركت قلب حاسديه وجيعا % % 12(@)(@@) % وأتى الدهر تائبا وهو يدعو % % من عذيري فقد أسأت الصنيعا % % 13(@)(@@) % رافع الطرف نحو من لعلاه % % كسرت طرفها الملوك خضوعا % % 14(@)(@@) % وعلى كفه رأى الصيد تهوي % % طلب اللثم سجدا وركوعا % % 15(@)(@@) % فدنى لاثما ثرى أخمصيه % % لم يقدم سوى البكاء شفيعا % % 16(@)(@@) % ولسان المسيء أعطف شيء % % لكريم بأن يكون دموعا % % 17(@)(@@) % قد لعمري استقال أحلم مولى % % كرما يغفر الذنوب جميعا % % 18(@)(@@) % حي مستحفظ العلوم بعصر % فيه لولاه أوشكت أن تضيعا % % 19(@)(@@) % ذو بنان حوالب المزن ودت % % أن تراها الورى لهن ضروعا % % 20(@)(@@) % فيه عمر الفيحاء قد عاد غضا % % وزهت بالسرور فيه ربوعا % % PageV01P261 21(@)(@@) % ولأن قيل جاء فاستقبلته % % قمرا طالعا وغيثا مريعا % % 22(@)(@@) % فهو من رد كل ليل نهارا % بحماه وكل قيض ربيعا % % 23(@)(@@) % ولده الطيبون أصلا وفرعا % علم المسك خلقهم أن يضوعا % % 24(@)(@@) % إخوة البيض ألسنا وبنو الشهب % % وجوها آباؤهن طلوعا % % 25(@)(@@) % سبقوا النيرات منها وجودا % ومشوا فوقها فرادى جميعا % % 26(@)(@@) % كل عف عن الهوى بتقاه % % فطم النفس يوم كان رضيعا % % 27(@)(@@) % ولعوا بالنهى على حين شبوا 
ms79	 % % وسواهم باللهو شاب ولوعا % % 28(@)(@@) % من سهام الزمان كم من صنيع % نسجوه على العفاف دروعا % % 29(@)(@@) % علماء منها نضوا سيف فكر % تركوا معطس الضلال جديعا % % 30(@)(@@) % لا يزالوا معا على حوزة الد % % ين لأهل الإيمان سورا منيعا % % PageV01P262 البحر : متقارب تام 1(@)(@@) % أبشر فيك العلى والشرف % % وأهدي إلى المجد أسنى التحف % % 2(@)(@@) % وأنظم فيك لجيد الفخار % لئال تفوق لئال الصدف % % 3(@)(@@) % وأجلو عليك بنادي السرور % % عروس الثنا بالتهاني تزف % % 4(@)(@@) % أبا المصطفى أنت فخر الكرام % % وأكرم من بالفخار التحف % % 5(@)(@@) % وأزكى البرية فرعا نماه % من دوحة المجد عيص الف % % 6(@)(@@) % لك الله أكمل هذا السرور % بعز عليك لواه يرف % % 7(@)(@@) % ولا زلت في آلك الأكرمين % % ترى ما يقر عيون الشرف % % 8(@)(@@) % تروح على فرح فيهم % % وتغدو على فرح يؤتنف % % 9(@)(@@) % جلا اليوم بشرك وجه الزمان % % فماء الغضارة فيه يشف % % 10(@)(@@) % نظمت بأيامك الصالحات % % شمل المكارم حتى ائتلف % % PageV01P263 11(@)(@@) % وقمت بأثقال هذا الزمان % % وعنها أجلهم قد ضعف % % 12(@)(@@) % أقول لمن بات ينضي الركاب % % رويدك في السير لا تعتسف % % 13(@)(@@) % أمل عن بني الدهر أعناقها % % فقد لئموا يوم كانوا نطف % % 14(@)(@@) % وبادر إلى ماجد بيته % % به للأكارم نعم الخلف % % 15(@)(@@) % ترى علة المكث للضيف فيه % % طيب القرى فهو لا ينصرف % % 16(@)(@@) % إذا للإقامة فيه أتم % أجد به نية فاعتكف % % 17(@)(@@) % وحي به من أبي المصطفى % % ربيع العفاة إذا الضرع جف % % 18(@)(@@) % أجل نظرا في مزايا علاه % % وفي قومه خلفا عن سلف % % 19(@)(@@) % تجد فيه كل صفات الكمال % % وفيهن عبد الكريم اتصف % % 20(@)(@@) % فتى وكفت كرما كفه % % فعلمت الغيث حتى وكف % % PageV01P264 21(@)(@@) % ترى للمكارم والأكرمين % % في مصطفى المجد نشرا ولف % % 22(@)(@@) % إذا بسط الكف يوم العطاء % طوى كلمن نشرته الصحف % % 23(@)(@@) % وزاد على كل حي به % % علا عنه يقصر من قد وصف % % 24(@)(@@) % له حلف الدهر أن لا يجيء % % بمثل وقد بر فيما حلف % % 25(@)(@@) % وكيف يساجله الأكرمون % % وكلهم من نداه اغترف % % 26(@)(@@) % ولو شاء جارى بصغرى بنان % % أخيه من الأكرمين الأكف % % 27(@)(@@) % وأبدا 
ms80	 من الحسن المكرمات % % مزايا جمعن حسان الضرف % % 28(@)(@@) % هو الحسن الندب من في الكمال % % أقر الحسود له واعترف % % 29(@)(@@) % تبارى الصبا كرما راحتاه % وأخلاقه الغر منها أشف % % 30(@)(@@) % بني المصطفى من يباهيكم % % وأنتم نجوم سماء الشرف % % PageV01P265 31(@)(@@) % حللتم من المجد أوساطه % % وغيركم منه حل الطرف % % 32(@)(@@) % سبقتم إلى صهوات العلا % % فأعلى الورى خلفكم مرتدف % % 33(@)(@@) % ثقال الحلوم فلو توزنون % % برضوى إذا لرجحتم وخف % % 34(@)(@@) % يقر بعين الورى أن ترى % % بيوتكم للعلى مختلف % % 35(@)(@@) % وإن عليهن طير السعود % % بأجنحة اليمن زهوا ترف % % 36(@)(@@) % أهنيكم بفتى ماجد % حسان العلى فيه تبدي الشغف % % 37(@)(@@) % غدا عرسه روضة للهنا % % وزهر السرور بها يقتطف % % 38(@)(@@) % به قد غفرنا ذنوب الزمان % وقلنا عفى الله عما سلف % % 39(@)(@@) % وبتنا على طرب نستطيب % % أرق النشيد بنادي الظرف % % 40(@)(@@) % نفض ختام رحيق السرور % % ونرشف أعذب ما يرتشف % % PageV01P266 41(@)(@@) % نعمكم ونخص الجواد % فيا بورك الفرح المنتصف % % 42(@)(@@) % ليهن بعرس هلال له % % ظلام الخطوب به ينكشف % % 43(@)(@@) % إذا ما ادعى البدر أن قد حكاه % % فقل خل يا بدر هذا الصلف % % 44(@)(@@) % سباك محياه وهو الأغر % فغط بوجهك هذا الكلف % % 45(@)(@@) % وتحكيه عندي لو ان الجواد % % أبوك فذلك شمس الشرف % % 46(@)(@@) % جواد جرى سابقا للندى % % وعن شأوه الدهر عجزا وقف % % 47(@)(@@) % فيا أسرة المجد لا زلتم % % ببشر من الدهر لا ينصرف % % PageV01P267 البحر : كامل تام 1(@)(@@) % طلعت كبدر دجى تزف سلافها % % يا حي طلعتها وحي زفافها % % 2(@)(@@) % بيضاء ناعمة الشبيبة أقبلت % % تثني بنشوة دلها أعطافها % % 3(@)(@@) % تطأ الحرير ولو تطيق ذوو الهوى % % فرشت لها فوق الحرير شغافها % % 4(@)(@@) % يهنيك أن العامرية عن هوى % ألفت حماك ونافرت ألافها % % 5(@)(@@) % طرقتك زائرة بأسعد ليلة % قد كاد يرفع نورها أسدافها % % 6(@)(@@) % وجلت بأنمل فضة ذهبية % % خضبت بلون مدامها أطرافها % % 7(@)(@@) % فاشرب على الورد الندي بخدها % % صهباء مقلتنا تدير سلافها % % 8(@)(@@) % وتمل عيشك ناعما بغريرة % كالريم أرهف خصرها إرهافها % % 9(@)(@@) % وبمسقط العلمين شائقة الهوى % % ضربوا على مثل المهاة سجافها % % 10(@)(@@) % ثعلية لكن لها من حاجب % % قوس غدا 