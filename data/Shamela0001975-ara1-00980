ms967	(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذا والذي نفسي بيده من النعيم الذي تسألون عنه: ظل بارد، ورطب طيب، وماء بارد)) (ت) عن أبي هريرة.(@)(@@) (13018) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذا يوم عاشوراء، ولم يكتب الله عليكم صيامه، وأنا صائم: فمن شاء فليصم، ومن شاء فليفطر)) (ق) عن معاوية.(@)(@@) (13019) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذان ابناي وابنا بنتي اللهم إني أحبهما فأحبهما وأحب من يحبهما)) (ت حب) عن أسامة بن زيد.(@)(@@) (13020) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذان السمع والبصر، يعني أبا بكر وعمر)) (ت ك) عن عبد الله بن حنطب.(@)(@@) PageV03P273(@)(@@) (13021) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذان سيدا كهول أهل الجنة من الأولين والآخرين إلا النبيين والمرسلين لا تخبرهما يا علي، يعني أبابكر وعمر)) (ت) عن أنس وعلي.(@)(@@) (13022) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه إدام ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه)) (د) عن يوسف بن عبد الله بن سلام مرسلا.(@)(@@) (13023) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه الحشوش محتضرة: فإذا دخل أحدكم فليقل: بسم الله)) (ابن السني) عن أنس.(@)(@@) (13024) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه النار جزء من مائة جزء من جهنم)) (حم) عن أبي هريرة.(@)(@@) (13025) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه بتلك السبقة)) (حم د) عن عائشة.(@)(@@) (13026) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه ثم ظهور الحصر، قاله لأزواجه في حجة الوداع)) (حم د) عن أبي واقد.(@)(@@) (13027) ((ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه رحمة يجعلها الله في قلوب من يشاء من عباده، وإنما يرحم الله من عباده الرحماء)) (حم ق دن ه) عن أسامة بن زيد.(@)(@@) (13028) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه صلاة البيوت، يعني السبحة بعد المغرب)) (د) عن كعب بن عجرة.(@)(@@) (13029) (( (ز) ه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذه طابة، وه صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1648 - (@)(@@) ; ذا أحد، وهو ج