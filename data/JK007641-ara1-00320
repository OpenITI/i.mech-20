ms301	 له خائفا ومرتجيا % % تمض البلايا وتقبل النعم % % 18(@)(@@) % ولا تجد غيره تجده به % % فغيره الجهل منك واللمم % % 19(@)(@@) % من ذل للغير فهو عابده % % وذلك الغير عنده صنم % % PageV01P1366 البحر : - 1(@)(@@) % إن كنت نائم % % فالله قائم % % 2(@)(@@) % أو كنت فاني % % فالحق دائم % % 3(@)(@@) % حبيب قلبي % % رفقا بهائم % % 4(@)(@@) % من فيك حاروا % % فهم بهائم % % 5(@)(@@) % وكيف تخفى % % على الملائم % % 6(@)(@@) % وفيك هامت % % أولوا العزائم % % 7(@)(@@) % ومنك زادت % % لهم غنائم % % 8(@)(@@) % وفي الهوى أن % % فقت كرائم % % 9(@)(@@) % وأنت روض % % وهم نسائم % % 10(@)(@@) % وأنت غصن % % وهم حمائم % % PageV01P1367 11(@)(@@) % وأنت شمس % % وهم غمائم % % 12(@)(@@) % بلا رؤوس % % لهم عمائم % % 13(@)(@@) % وكل صب % لقاك رائم % % 14(@)(@@) % وكل طرف % % عليك حائم % % 15(@)(@@) % وكل حب % له علائم % % 16(@)(@@) % ومنه لا تنفع التمائم % % 17(@)(@@) % والقلب ممن % % سواه صائم % % 18(@)(@@) % فليس يصغى % % إلى اللوائم % % 19(@)(@@) % وفي بحار ال % % غرام عائم % % 20(@)(@@) % وبرق ذات ال % % مليح شائم % % PageV01P1368 21(@)(@@) % يمشي ولكن % % بلا قوائم % % 22(@)(@@) % وجوده قد % % محا الجرائم % % 23(@)(@@) % ولطفه للص % % با يلائم % % 24(@)(@@) % وتارة يش % % به السمائم % % 25(@)(@@) % والغير في أر % % ضه نعائم % % 26(@)(@@) % وهو الربا وال % % ورى سوائم % % PageV01P1369 البحر : - 1(@)(@@) % إنني قد شفني السقم % % 2(@)(@@) % ووجودي فيكمو عدم % % 3(@)(@@) % فالبقايا سادتي لكمو % % 4(@)(@@) % أنتم المقصود لا العلم % % وأهيل الحي قد علموا % % 5(@)(@@) % ليت دمعي حين أرسله % % 6(@)(@@) % ذكر كم بالقرب أوصله % % 7(@)(@@) % وفؤادي شفه الوله % % 8(@)(@@) % كيف أخفى والغرام له % % شاهدان الدمع والسقم % % 9(@)(@@) % لم أزل بالله في همم % % 10(@)(@@) % في وجود كنت أو عدم % % PageV01P1370 11(@)(@@) % فإلى كم مقتضى ألمي % % 12(@)(@@) % يا أصيحابي بذي سلم % % من أصحيابي وما السلم % % 13(@)(@@) % فنيت روحي بلا مهل % % 14(@)(@@) % مثل برق لاح في طلل % % 15(@)(@@) % يا أخلائي بلا عذل % % 16(@)(@@) % أنا عني اليوم في شغل % % فاذكروني أن نسيتكمو % % 17(@)(@@) % قد تساوى بالصفا كدري % % 18(@)(@@) % وحبيبي غير مستتر % % 19(@)(@@) % فاشهدوا يا سادتي أثري % % 20(@)(@@) % وأشيعوا في الحمى خبري % % وأذيعوا السر واكتتموا % % PageV01P1371 21(@)(@@) % صرت في الأعتاب مرتميا % % 22(@)(@@) % وإلى الأحباب منتميا % % 23(@)(@@) % وإذا ما كنت مهتديا % % 24(@)(@@) % لا 
ms302	 يراني الحب منثنيا % % بعدما لاحت لي الخيم % % 25(@)(@@) % عالم الدنيا دجى ظلم % % 26(@)(@@) % نوره حق لمفتهم % % 27(@)(@@) % كم وجود لي وكم عدم % % 28(@)(@@) % كنت قبل اليوم في حلم % % وتقضى ذلك الحلم % % 29(@)(@@) % ما لأشواقي لكم سبب % % 30(@)(@@) % فالورى نائي ومقترب % % PageV01P1372 31(@)(@@) % ساكن حالي ومضطرب % % 32(@)(@@) % فزماني كله طرب % % دونه الأوتار والنغم % % 33(@)(@@) % شق روحي غيم جثته % % 34(@)(@@) % وبدا في نور نشأته % % 35(@)(@@) % واختفى كوني بظلمته % % 36(@)(@@) % وحبيبي من لبهجته % % أنا والأشواق نحتكم % % 37(@)(@@) % يا هنا قلبي ويا طربي % % 38(@)(@@) % وانعدامي ليس بالعجب % % 39(@)(@@) % لاح نوري واختفت حجبي % % 40(@)(@@) % كلما وليت يقبل بي % % وإذا قطبت يبتسم % % PageV01P1373 البحر : - 1(@)(@@) % فؤاد له في رتبة الحب ما نوى % % 2(@)(@@) % وبالقرب نيم بدلت ساعة النوى % % 3(@)(@@) % وصحب عليهم حاكم العقل قد حوى % % 4(@)(@@) % يقولون لي ضيعت عمرك في الهوى % % وما فاتني شيء إذا كنت ألقاكم % % 5(@)(@@) % أحباي إني المستهام المجرد % % 6(@)(@@) % وأنتم كرام ما على يدكم يد % % 7(@)(@@) % ووالله ما لي في يميني تردد % % 8(@)(@@) % لئن كان قوم بالزوايا تقيدوا % % فإني أرى كل الوجود زواياكم % % PageV01P1374 البحر : - 1(@)(@@) % شموس الجمال تزيل الظلم % % وتهدي إلى الحق أهل الهمم % % 2(@)(@@) % شخوص إليها عيون الأمم % % وجود له صور من عدم % % 3(@)(@@) % دور % % 4(@)(@@) % بدا وجه سلمى وزال النقاب % % وقد جئت منها إليها كتاب % % 5(@)(@@) % وقد لاح ذاك الجمال المهاب % % لعيني وراحت ستور الوهم % % 6(@)(@@) % دور % % 7(@)(@@) % ألا يا حداة المطايا قفوا % % لقلبي بذاك الحمى موقف % % 8(@)(@@) % وعشقي هو الخمر والقرقف % % لأهل القلوب بحور الكرم % % 9(@)(@@) % دور % % 10(@)(@@) % هي الكل والكل عنها بدا % % وقد حجبت عن عيون العدى % % PageV01P1375 11(@)(@@) % وأهل الضلال وأهل الهدى % % مظاهر أسرارها والحكم % % 12(@)(@@) % دور % % 13(@)(@@) % وأزكى الصلاة وأبهى السلام % % على المصطفى خير كل الأنام % % 14(@)(@@) % به زاد عبد الغني في النظام % % لطائف معنى تزيل الألم % % PageV01P1376 البحر : - 1(@)(@@) % يا طالبا للحجر المكرم % % وراغبا في اسم الإله الأعظم % % 2(@)(@@) % وسائلا عن صنعة الأكسير كن % % محققا لما أقول وافهم % % 3(@)(@@) % فإنها ثلاثة مشهورة % % عند الورى مثل الطراز المعلم % % 4 
ms303	(@)(@@) % حارت عقول الناس في إدراكها % % كم عربي تائه وأعجمي % % 5(@)(@@) % وما اهتدوا منها إلى شيء ولا % % فاز بها سوى الشجاع الضيغم % % 6(@)(@@) % مشوا إليها في سوى طريقها % % وحاولوها بالخيال المظلم % % 7(@)(@@) % يعرفها من نفسه كل امرئ % % بحسن تقواه بلا تفهم % % 8(@)(@@) % فالحجرا لمكرم الذي متى % % تجده تظفر بالمنى وتغنم % % 9(@)(@@) % أمر بسيط ماله تركب % % جوهره صافي يرى كالعندم % % 10(@)(@@) % يثبت بالتدريج في ترابه % % شيئا فشيئا كنبات الكركم % % PageV01P1377 11(@)(@@) % تلقى على الأجزاء جزءا منه إن % % أردت يقلبها إليه فاعلم % % 12(@)(@@) % ويستحيل الكل شمسا خالصا % % أو قمرا به كماء أو دم % % 13(@)(@@) % فالشمس إن أوصلته لأصله % % بالغسل والتخليص والتنعم % % 14(@)(@@) % وإن تركت لبه في قشره % % فالقمر الأبيض بسام الفم % % 15(@)(@@) % وركب الإكسير إن أردت من % % نون وميم مطلق وملجم % % 16(@)(@@) % وأمزجهما معا بأيد منهما % % ممدودة كدرجات السلم % % 17(@)(@@) % والاسم في الرسم من الغيب بدا % % مسلطا عليك مثل الطلسم % % 18(@)(@@) % بالهاء والواو به هوية % % في ملكوت واضح ومبهم % % 19(@)(@@) % واعرف حروفه التي أنت بها % % مثلث الشكل إليها تنتمي % % 20(@)(@@) % حققه واحفظ لفظه وادع به % % وأنت في كعبته والحرم % % PageV01P1378 21(@)(@@) % تجده في الحال مجيبا بالذي % % تريد من نصيبك المنقسم % % 22(@)(@@) % واستعمل الصدق له وسيلة % % ولا تكن عنه بما رمت عمي % % PageV01P1379 البحر : - 1(@)(@@) % لا تأخذ الخلاق يا قوم % % في خلقه سنة ولا نوم % % 2(@)(@@) % فالروح تأخذها به سنة % % والجسم نوم فيه مرغوم % % 3(@)(@@) % والله عن روح وعن جسد % % فد جل لا يحكيه مفهوم % % 4(@)(@@) % ما في سموات له وه % % ي الأرواح قيدوم فقيدوم % % 5(@)(@@) % وكذاك ما في الأرض وهي له % % أعني الجسوم وذاك مرسوم % % 6(@)(@@) % وهو المميت لأنه أبدا % % حي على الأكوان قيوم % % 7(@)(@@) % فإذا أمات أباننا وإذا % % أحيا خفينا وهو معلوم % % 8(@)(@@) % في آية الكرسي لنا عبر % % منه كتاب جاء مرقوم % % 9(@)(@@) % حق بحق فيه حققنا % % وما سواه فهو موهوم % % 10(@)(@@) % به شرابي كوثر عذب % % وشراب أهل الجهل زقوم % % PageV01P1380 البحر : - 1(@)(@@) % لم يفه ياذا الوجود فم % % بك لولا إنني العدم % % 2(@)(@@) % فالتفت وانظر لأصلك 
ms304	 لا % % تفتخر يلحق بك الندم % % 3(@)(@@) % إن ربي عند قدرته % % تستوي الأنوار والظلم % % 4(@)(@@) % وعطاياه بلا علل % % وكذا الحرمان والنعم % % 5(@)(@@) % ما استحق المرؤ مرتبة % % هو فيها أيها الفهم % % 6(@)(@@) % ما اقتضت نفس عطيتها % % بل عطاياه لنا كرم % % 7(@)(@@) % ما اقتضى القبح القبيح ولا % % يقتضي الحرمان منحرم % % 8(@)(@@) % بل بمحض الاختيار على % % كل ذي رأس له قدم % % 9(@)(@@) % وجميعا أسر قبضته % % منعم طورا ومنتقم % % PageV01P1381 البحر : - 1(@)(@@) % تقول الأجانب عن علمنا % % وعنا مقالة واهي الفهوم % % 2(@)(@@) % لماذا ترون السماع الذي % % بآلاته طارد للهموم % % 3(@)(@@) % فقلنا لهم ما رأى المصطفى % % رأيناه فلينزجر من يلوم % % 4(@)(@@) % وقالوا تسبح قلنا نعم % % نسبح عوام بحر العلوم % % 5(@)(@@) % وأما الذي هو غربها % % فيغرق في بحرها لا يعوم % % PageV01P1382 البحر : - 1(@)(@@) % ظهر الوجود من العدم % % وبدا الحدوث من القدم % % 2(@)(@@) % وتفصلت أسماء من % % بالوجه أجمل والقدم % % 3(@)(@@) % وانهد ما بنت العقو % % ل من المعاني وانهدم % % 4(@)(@@) % وتبدل الشخص الذي % % قد كان من لحم ودم % % 5(@)(@@) % وقد استحال جميعه % % نورا فأوقع في الندم % % 6(@)(@@) % وتداخل المخدوم في % % وصف المحاسن والخدم % % 7(@)(@@) % وتقاصر القصر المشيد وبار بئر وارتدم % % PageV01P1383 البحر : - 1(@)(@@) % أني أنا المعنى القديم % % إني أنا النبأ العظيم % % 2(@)(@@) % وأنا هو السر الخفي % % وأنا الصراط المستقيم % % 3(@)(@@) % والحق بي هو عالم % % وبنفسه فهو العليم % % 4(@)(@@) % والذات لا معنى لها % % تلك الوجود هي القديم % % 5(@)(@@) % فإذا عرفت فإنما % % معنى لمعنى مستديم % % 6(@)(@@) % هو نزلة أخرى له % % قمنا بها وهو المقيم % % 7(@)(@@) % ولقد رآه بها الذي % % هو فضله فينا العميم % % 8(@)(@@) % يا جوهرا لا جوهر % % لكنه وصف كريم % % 9(@)(@@) % قامت به أعراضه % % وبطيبه جاء النسيم % % 10(@)(@@) % حرنا فقلنا هكذا % % والذات غيب يا فهيم % % PageV01P1384 11(@)(@@) % غيب الغيوب تنزهت % % عما القلوب به تهيم % % 12(@)(@@) % أنا إليك نشير لا الموجود نحن بل العديم % % 13(@)(@@) % والحق ليس عبارة % % مناله وهو النديم % % 14(@)(@@) % يدني ويقصي من يشا % % وهو العذاب هو النعيم % % 15(@)(@@) % معناه نحن وإنما % % معناه يدركه الشميم % % 16(@)(@@) % وهو الكوائن كلها % % والكهف أيضا والرقيم % % 17(@)(@@) % الله 
ms305	 أكبر لا سوا % % ه فإنه العقد النظيم % % 18(@)(@@) % والسلك وهو وراء كل الكل غفار حليم % % 19(@)(@@) % وأنا السقيم وقدرتي % % عجز ولا يشفى السقيم % % 20(@)(@@) % والكون مثلي هكذا % % لكن رضيع أو فطيم % % PageV01P1385 البحر : - 1(@)(@@) % قد هدينا بالخاطر المستقيم % % لحديث عن الحبيب قديم % % 2(@)(@@) % ووجدنا معارفا وعلوما % % كان فيها المزاج من تسنيم % % 3(@)(@@) % فشممنا بها روائح غيب % % وسركنا بطيب ذاك الشميم % % 4(@)(@@) % كرياض زهورها فائحات % % لذوي الشم مع هبوب النسيم % % 5(@)(@@) % ذات حق أرواحنا أخبرتنا % % عن معاني أسمائه في الرقيم % % 6(@)(@@) % محسنات بأمره يقذف الخل % % ق كقذف المداد صورة ميم % % 7(@)(@@) % وهو أمر محقق وهو خلق % % باطل متقن بصنع الحكيم % % 8(@)(@@) % ووجود صرف إذا ما تجلى % % صبغ الكل بالوجود العظيم % % 9(@)(@@) % ومراداته هي الكل جاءت % % في تراتيبها كعقد نظيم % % 10(@)(@@) % صبغة لم تكن وبالوهم كانت % % ما وجود يكون وصف العديم % % PageV01P1386 11(@)(@@) % حاش لله والبصائر زاغت % % قبل زيع الأبصار في التقديم % % 12(@)(@@) % والذي يشهد الحقيقة غيبا % % بشهود عنها لها مستقيم % % 13(@)(@@) % لا بشوب من الحلول ولا مع % % نى انحلال فيها ولا تجسيم % % 14(@)(@@) % ويرى الكل فانيا مضمحلا % % فهو عبد فاني لحق مقيم % % 15(@)(@@) % أيها النفس ها هو النور باد % % فاكشفى عنه منك ثم استقيمي % % 16(@)(@@) % ودعي عنك ما سواه فمنه % % ما سواه السراب للتوهيم % % 17(@)(@@) % ثم ناجيه فوق طور التداني % % بتدليه إرث موسى الكليم % % 18(@)(@@) % واعلميه بعلمه لا بعلم % % تدعيه يكون بالتعليم % % 19(@)(@@) % في مقام محمدي شريف % % شارع للتحليل والتحريم % % 20(@)(@@) % فعليه السلام ما راق معنى % % لمعنى فجاد بالتسليم % % PageV01P1387 البحر : - 1(@)(@@) % عجبت من شيئين قد أجمعت % % عليهما كل عقول الأنام % % 2(@)(@@) % فالأول المعدوم من كل شيء % % أزال عنه الله وصف انعدام % % 3(@)(@@) % فصار موجودا وأضحى له % % وصف وجود ظاهر للعوام % % 4(@)(@@) % فاعجب لموصوف هو المنتفى % % ووصفه الثابت دون انبهام % % 5(@)(@@) % بمن ترى الوصف غدا قائما % % تحققوا يا قوم هذا الكلام % % 6(@)(@@) % والآخر الحق الوجود الذي % % قدر كل الخلق بالانتظام % % 7(@)(@@) % كيف بمعدوماته قد غدا % % متصفا والعقل فيها إمام % % 8(@)(@@) % حتى بدا التنزيه عنها 
ms306	 به % % واحتاج هذا الأمر للاختصام % % 9(@)(@@) % وإنما القهار وهو الذي % % أفعاله تجري بحكم المرام % % 10(@)(@@) % فيطلع العقل على ما يشا % % من لمعاني عن ضيا أو ظلام % % PageV01P1388 11(@)(@@) % تصرفا منه كيفماذو العلم قصر مشيد ليس ينهدم بئر معطلة ذو الجهل مرتدموالقرب من خالق الأكوان معرفة بها قلوب ذويها فيه تأتدمما الزهد إلا مقام السالكين إلى قرب الإله لهم يعلو به قدموكيف يمكن زهد لامرئ نظرت عيناه أن % أراد لا عتب كما لا ملامسقط أبيات ص % % PageV01P1389 البحر : - 1(@)(@@) % أنا التعين والرب المهيمن ما % % به التعين طوبى للذي فهما % % 2(@)(@@) % هو الوجود القديم المحض جل ولم % % أزل مقدره والحادث العدما % % 3(@)(@@) % فرفت بيني بتحقيق الوجود له % % وبينه بعد درك الجمع بينهما % % 4(@)(@@) % والجاهل الغر لا يدري مقالتنا % % فيه وإن كان محسوبا من العلما % % 5(@)(@@) % ومن عجائب أمري أنني عدم % % ولي وجود به قد صرت متهما % % 6(@)(@@) % وهو الذي قبضتني هكذا يده % % لها وقد بسطتني صنعة الحكما % % 7(@)(@@) % فحرت فيه وفي أمري فأرشدني % % إليه يثبت لي في علمه قدما % % 8(@)(@@) % فها أنا اليوم مشغوف برؤيته % % محققا ظاهرا في الكون منبهما % % 9(@)(@@) % هل من فتى يا بمني قومي افهمه % % فيكشف الله عنه هذه الغمما % % 10(@)(@@) % ويصبح القطب في سامي دوائره % % وفي الحقائق يمسي المفرد العلما % % PageV01P1390 11(@)(@@) % ما قلت ذلك من نفسي ولا جهلت % % حقيقتي فادعت ما قلته شمما % % 12(@)(@@) % وإنما الغيب لي لاحت إشارته % % لتسمع اللوح ما قالته والقلما % % 13(@)(@@) % لوح الوجود المسمى روح نفحته % % وعقله قلم كل الورى رقما % % 14(@)(@@) % مراتب هن للحق الوجوج بدت % % فيهن كان قديما واسمهن عما % % PageV01P1391 البحر : - 1(@)(@@) % معرفتي مخلوقة وهي لا % % تليق بالخالق ربي القديم % % 2(@)(@@) % لأجل ذا في كل وقت بدت % % في صورة يطرب منها النديم % % 3(@)(@@) % إذا تأملنا تناويعها % % في كل معوج وفي مسقيم % % 4(@)(@@) % وإنها قاصرة كلها % % عن حضرة الغيب النزيه العظيم % % 5(@)(@@) % قلنا صواب كلها قول من % % يعتبر المخلوق ذاك العديم % % 6(@)(@@) % وإنها استعداده قد بدا % % منه لها يرجى قبول الكريم % % 7(@)(@@) % وباعتبار الحق قلنا 
ms307	 خطا % % جميعها والوصف فيها ذميم % % 8(@)(@@) % وإنما الحق تعالى الذي % % بنفسه دون سواه عليم % % 9(@)(@@) % فعملنا بالحق منا له % % إسلامنا والقلب منا سليم % % 10(@)(@@) % ونحن بالعلم الذي نفسه % % تعلمه نعلمه يا فهيم % % PageV01P1392 البحر : - 1(@)(@@) % عدم يحيط به الوجود وإنما % % عرف الوجود إذا الوجود تكلما % % 2(@)(@@) % وهو الوجود وكلنا عدم بنا % % هو قد أحاط وقد أشار فأفهما % % 3(@)(@@) % صور بقرطاس تقص فإنها % % معدومة ولها الوجود توهما % % 4(@)(@@) % أعني بذلك أنها مقصوصة % % في داخل القرطاس قصا محكما % % 5(@)(@@) % قرطاسها الموجود لا هي وحده % % وهو المحيط بها وعنها أبهما % % 6(@)(@@) % وله الظهور بوصف إحاطة % % فانظر وليس لنا الظهور لتعلما % % 7(@)(@@) % وجميع هذا كله في لمحة % % يبدو ويخفى منه وتكرما % % 8(@)(@@) % والأمر أمر الله يعنى شأنه % % هو كل يوم فيه لن يتصرما % % 9(@)(@@) % والخلق خلق الله أيضا كلهم % % عدم إذا حققت أرض أوسما % % 10(@)(@@) % وإذا مشيت مع العقول ووهمها % % كنت المؤخر والمحق مقدما % % PageV01P1393 11(@)(@@) % إذا ما سوى مولاك جاءك باطل % % في النص فاني هالك كم ذا العمى % % 12(@)(@@) % فالمبطلون هم الذين تعلقوا % % بسوى الإله الحق من جهل نما % % 13(@)(@@) % والعارفون هم الذين قد اهتدوا % % فاتبع طريقهمو وخذها سلما % % 14(@)(@@) % واسلك بها في الشرع شرع محمد % % تجد الذي وجدوا تصبح مسلما % % 15(@)(@@) % صلى عليه الله ما ذهب الدجى % % وأتى الصباح وما الهزار ترنما % % PageV01P1394 البحر : - 1(@)(@@) % تجلت لنا ذات وفعل بدا واسم % % فكانت وما كنا وليس لنا وسم % % 2(@)(@@) % هنالك قامت بالوجود قيامة % % بها حشرت أرواحنا واختفى الجسم % % 3(@)(@@) % مدام بها الأفراح دامت لأهلها % % ومن لم يذقها كل أوقاته غم % 4(@)(@@) % وقام بها الساقي وحيى فساقنا % % إلى مورد منها لذيذ به الطعم % % 5(@)(@@) % إذا ما تراءت في الكؤؤس بدالها % % شعاع له في كل ناحية نجم % % 6(@)(@@) % هي السر للأشياء والجهر دائما % % على عدد الأنفاس والبدء والختم % % 7(@)(@@) % بها يهتدي الأعمى إليها ويسمع ال % % أصم وتأتي ناطقين بها البكم % % 8(@)(@@) % ويأمن ذو خوف ويفرح ذو أسى % % ويعتز ذو ذل ويبرابها السقم % % 9(@)(@@) % ولو أنهم صبوا على البحر 
ms308	 قطرة % % لعاد بها عذبا ولو أنه سم % 10(@)(@@) % ولو ذكروا حول الحطيم صفاتها % % لزال عن البيت العتيق بها الحطم % % PageV01P1395 11(@)(@@) % ولو لم تكن أسماؤها قد تبينت % % لما بان في الأكوان كيف ولا كم % 12(@)(@@) % ولولا سنا كاساتها من ورا الورى % % لما كان ذوق في الندامى ولا فهم % % 13(@)(@@) % ولو أن ميتا لقنوه بلفظها % % لقام سريعا نحوها شوقه ينمو % % 14(@)(@@) % ولولا بدت لم يشعر الأشعري بها % % ولولا تخفت ما تجهمها جهم % % 15(@)(@@) % ولولا معاني حسنها ظهرت على % % ملاح الورى ما كان عشق ولاوهم % % 16(@)(@@) % ولو بيتيم الوالدين قد اعتنت % % لعز وعنه زال من ذله اليتم % % 17(@)(@@) % جمال تجلى في جلال وعكسه % % فقوم له مدح وقوم لهم ذم % 18(@)(@@) % وكل قلوب الناس لو لم تهم بها % % لما طاب نثر في الكلام ولا نظم % % 19(@)(@@) % ولكنهم هاموا ورقت طباعهم % % ولم يعلموا في أي واد بها هموا % % 20(@)(@@) % لثام من الأشياء يحجب وجهها % % حلا لعيون العاشقين به اللثم % % PageV01P1396 21(@)(@@) % ألا حي يا صاحي على سكرة بها % % ودع عنك من هم دونها عندهم وهم % % 22(@)(@@) % وشقق بها الأثواب عنك وكن بها % % مجرد عزم لا يقاس به عزم % % 23(@)(@@) % وبت في ثرى حاناتها متلفقا % % بأثواب ذل في هواها بها تسمو % % 24(@)(@@) % وكن عاجزا عنها تكن قادرا بها % % فعدلك عنها منك نحو السوى ظلم % % 25(@)(@@) % هي البيت بيت الله حجت قلوبنا % % إليها فلا ذنب علينا ولا جرم % % 26(@)(@@) % إذا نحن أحرمنا نلبي بذكرها % % وفي علميها عندنا يكثر العلم % % 27(@)(@@) % وإن زمزم الحادي بها فهي زمزم % % وعن مصنا من ثديها ما لنا فطم % % 28(@)(@@) % نعمنا بها في لذة العيش والصبا % % وما ذاك إلا أنها أنعمت نعم % % 29(@)(@@) % هي الدهر في تقليب أيامه على % % بنيه له حرب بهم وله سلم % % 30(@)(@@) % إذا ما شربناها خفينا بنورها % % وعند طلوع الشمس ما للدجى رسم % % PageV01P1397 31(@)(@@) % بها للحواس الخمس منا تمتع % % فسمع ولمس ذوقنا بصر شم % 32(@)(@@) % وللعقل أيضا لذة في جمالها % % وسر بدا منها له وجب الكتم % % 33(@)(@@) % وقد سكرت حاناتها 
ms309	 وكؤوسها % % بها في تجليها وقد سكر الكرم % % 34(@)(@@) % ولو أن إنسانا صحا لرأى هنا % % من السكر قد هامت بها العرب والعجم % % 35(@)(@@) % ومن سكرهم منها يقولون غيرها % % وهذا أب قالوا كما هذه أم % 36(@)(@@) % وقالوا عيون في وجوه وأرجل % % وأيد وقالوا أرؤس ودم لحم % % 37(@)(@@) % معان تبدت في صفاء وجودها % % فقوم لهم أجر وقوم لهم إثم % % 38(@)(@@) % وتلك نعوت قائمات بها لها % % على الفرض والتقدير لا أنه حتم % % 39(@)(@@) % إشاراتها اللاتي بوصف مشيئة % % تسمى بأشيا وهي هالكة عقم % % 40(@)(@@) % وما ثم توليد وليس مناسبا % % لها ذاك بل وصف إليها له ضم % PageV01P1398 41(@)(@@) % تحقق بما قلناه فيها مجانبا % % سواه فما قلناه فيها هو الغنم % % 42(@)(@@) % وإياك والتوليد في جعلها السوى % % فذلك قذف منك في حقها شتم % % 43(@)(@@) % وإن جهل الأقوام ذلك واختفى % % عليهم فللتوحيد توليدهم هدم % % 44(@)(@@) % نصحتك فامسح عن بصيرتك العمى % % بقولي وإلا فالنصوص لك الخصم % % 45(@)(@@) % وهذا هو الحق الذي هو ظاهر % % وبالغيب فيها ما عداه هو الرجم % % 46(@)(@@) % خذ الكاس مني يا ابن ودي فإنه % % روى بهذا فليكن عندك الحزم % % 47(@)(@@) % ومل طربا في النشأتين بشربه % % فإن شرابي للضلال به هضم % % 48(@)(@@) % شراب طهور في كؤوس نظيفة % % كريم به الساقي ومنه العطا الجم % 49(@)(@@) % على رنة الأسماء دام مدامنا % % وإن نمق الزور الوشاة وإن نموا % % 50(@)(@@) % وفي مقعد الصدق العزيز مناله % % تجلت لنا ذات وفعل بدا واسم % % PageV01P1399 البحر : - 1(@)(@@) % العفو أليق لا جرم % % خلف الوعيد من الكرم % % 2(@)(@@) % إن الكمال هو الذي % % حبل الوجود به انبرم % % 3(@)(@@) % وعليه نكسب لا علي % % نا كاسب هو ما انخرم % % 4(@)(@@) % لولا النصوص أتت بأخ % % بار الوعيد المحترم % % 5(@)(@@) % قلنا لكم ما الكل إلا الن % % نور يلمع في الحرم % % 6(@)(@@) % والنار نور أصلها % % والكل حق ما انصرم % % 7(@)(@@) % والواو حين تحركت % % قلبت لأمر لم يرم % % 8(@)(@@) % ألفا هي الذات انجلت % % ذات العماد وقل ارم % % 9(@)(@@) % والمنتهى نهم إلي % % ه فلا شباب ولا هرم % % 10(@)(@@) % والغير ينفخ في الرما % % د ونحن ننفخ في 
ms310	 ضرم % % PageV01P1400 11(@)(@@) % وكلامنا ممن وقو % % ل الغير أجمعه ورم % % PageV01P1401 البحر : - 1(@)(@@) % أشكو من الله إلى خلقه % % إني إذا من أهل دار الجحيم % % 2(@)(@@) % وإنما شكري له دائما % % على توالي الفضل منه العظيم % % 3(@)(@@) % ألم يكن أوجد ما لم يكن % % مني إيجاد جواد كريم % % 4(@)(@@) % وهو الذي يحفظني بالذي % % يمدني منه برزق مقيم % % 5(@)(@@) % وكيفما كنت أرى فضله % % غامرني وهو الغفور الرحيم % % PageV01P1402 البحر : - 1(@)(@@) % لي حب لواسم حير كل من لواسم % % في صنعة السحر والتنجيم والطلسم % % 2(@)(@@) % خذ خمسة أحرف بلا نقطة وصور اسم % % بميم أول وميم آخر تفك الاسم % % 3(@)(@@) % فأجاب % % 4(@)(@@) % حبي هو الله كم حير باسمه اسم % % حروفه الخمس منها للأصابع قسم % % 5(@)(@@) % يد تعالت من اللامين لاح الجسم % % محمد المصطفى عنها هو الطلسم % % PageV01P1403 البحر : - 1(@)(@@) % إلى الله نرفع أمرا ألم % لنا منه في كل وقت ألم % % 2(@)(@@) % ونشكو إليه أمورا دهت % % وقد خصنا الحزن منها وعم % 3(@)(@@) % ونلجأ في شأننا كله % % إليه ليكفينا ما أهم % 4(@)(@@) % ونطلب منه جميع الذي % % نريد فيتحفنا بالنعم % % 5(@)(@@) % وندعوه في كل أحوالنا % % بقلب منيب إليه وفم % % 6(@)(@@) % عساه يفرج كربالنا % % يضيق به الصدر منا وغم % 7(@)(@@) % عساه يعالجنا بالمنى % % ويكشف خطبا دجا وادلهم % 8(@)(@@) % عساه بوفقنا كلنا % % إلى أمره الندب والملتزم % % 9(@)(@@) % فإنا جيمعا عبيد له % % وفي بابه قد وقفنا خدم % % 10(@)(@@) % وكم نعمة قد حبانا بها % % وأعظمها خلقنا من عدم % % PageV01P1404 11(@)(@@) % وكم رحمة منه وافت لنا % % وكم نقمة قد تولت وكم % % 12(@)(@@) % يكف أولى البغي عن قهرنا % % ويدفع ظلم الذي قد ظلم % % 13(@)(@@) % وأكرمنا دون كل الورى % % وعلمنا علمه بالقلم % % 14(@)(@@) % وقد خلق الكل من أجلنا % % ومن أجله الخلق منا استتم % % 15(@)(@@) % ومع ذاك نكثر عصيانه % % فيا ويح عبد له ما احترم % % 16(@)(@@) % ونذنب سرا وجهرا ولا % % نبالي بما فيه زل القدم % % 17(@)(@@) % نباديه بالسوء وهو الذي % % لنا منعم محسن من قدم % % 18(@)(@@) % فيا مالك الملك يا ذا الجلا % % ل يا صاحب الجود ياذا الكرم % % 19(@)(@@) % ويا خالق الخلق يا 
ms311	 من له % % أياد علينا تفيض الحكم % % 20(@)(@@) % بحرمة طه نبي الهدى % % ومن جاء بالنور يمحو الظلم % % PageV01P1405 21(@)(@@) % وإخوانه الأنبيا كلهم % % وبالتابعين لهم في الأمم % % 22(@)(@@) % تفضل علينا بعفو ولا % % تدعنا نهلك في المزدحم % % 23(@)(@@) % وسهل لنا توبة نحتمى % % بها في غد من لهيب الضرم % % 24(@)(@@) % ولا تحرق الجسم يا سيدي % % بنيرانه فهو لحم ودم % % 25(@)(@@) % وكن راحما ذل أرواحنا % % إذا ما أتيناك يوم الندم % % 26(@)(@@) % وهبنا جميعا لرحماك يا % % رحيم وأجزل لنا في القسم % % 27(@)(@@) % وعنا تجاوز وكنت منعما % % وداو من القلب هذا السقم % % 28(@)(@@) % وسامح ولا تخزنا في غد % % فإنك أولى حكيم حكم % % 29(@)(@@) % شرعت لنا الدين نمشي به % % إليك على ذا الطريق الأمم % % 30(@)(@@) % وآياتك الواضحات اهتدى % % لها في الورى كل ذوق وشم % PageV01P1406 31(@)(@@) % تسمت بأشياء وهي التي % % عليها لسان الجهول أنبكم % % 32(@)(@@) % فيا فوز عبد ترآءت له % % إلى ان رآها لها فالتزم % % 33(@)(@@) % وأمسي وأصبح يسمو بها % % وبالعز فهمها والحشم % % 34(@)(@@) % فيا ظاهرا والسوى باطن % % ويا باطنا والسوى مرتسم % % 35(@)(@@) % تجليت في كل شيء كما % % أردت فداء الضلال انحسم % % 36(@)(@@) % وبصرتنا بالتجلي وفي % % بصائرنا نورك المحض تم % 37(@)(@@) % وحولت عنا حجاب العمى % % وأوضحت ما كان فينا ابنهم % % 38(@)(@@) % وأنت المنزه عن كل ما % % يرام من الكون أو لم يرم % % 39(@)(@@) % وأنت المسبح في ملكه % % بقبح الصياح وحسن النعم % % 40(@)(@@) % وأنت الموحد منا ومن % % جميع البرايا بحال أتم % PageV01P1407 41(@)(@@) % وشرك أولي الجهل دعوى فقط % % كما يقتضي ذاك حلم الحكم % % 42(@)(@@) % بل الشرك والكفر قد وحداعلأنهما نوع خلق هجمص فما في الوجود سوى واحد سقط شطرين ص % % وأفعاله لا سوى ذاك ثم % 43(@)(@@) % فلا تعرضوا عنه أنتم به % % كما الفعل من فاعل ما انقسم % % 44(@)(@@) % وقوموا إلى باب إحسانه % % لتحييوا بإقبال محيي الرمم % % 45(@)(@@) % ولا تكسلوا أو تخافوا على % % نفوسكمو منه فاللطف جم % 46(@)(@@) % ولا تنفروا عنه فهو الذي % % دعاكم إليه بأهل العصم % % 47(@)(@@) % فعين الجلال إليكم رنت % % ووجه الجمال زها وابتسم % % 48(@)(@@) % وأنتم عباد كريم وما % % ببخل الهكمو 
ms312	 متهم % % 49(@)(@@) % فإن الذي هو رب لنا % % قريب إلينا سناه وهم % % 50(@)(@@) % وجدنا به ومددنا به % % وضم به شملنا وانتظم % % PageV01P1408 51(@)(@@) % فلا تقنطوا منه والجؤوا لي % % حماه ولوذوا بهذا الحرم % % 52(@)(@@) % وإن عطاياه مبذولة % % وقد فاز قاصدها واغتنم % % 53(@)(@@) % فسبحان من أعجز الكل عن % % معاني الوصول إذا الكل هم % 54(@)(@@) % وجل الذي أوقف العقل في % % قصور وحير كل النسم % % 55(@)(@@) % فلا الفكر يعرفه لا ولا % % له يدرك الفهم حيث اقتحم % % 56(@)(@@) % فسلم إليه وكن طالبا % % له باجتهاد وخل الوهم % % 57(@)(@@) % وإن شئت قم بعد هذا له % % بنفسك سعيا وإن شئت نم % % 58(@)(@@) % وكن سائرا بشراع التقى % % إليه به إن جدواه يم % 59(@)(@@) % فيا ربنا كن معينا لنا % % وساعد على ما دهى واصطلم % % 60(@)(@@) % ولا تترك القلب في حيرة % % وجهل به البعد عنك انتقم % % PageV01P1409 61(@)(@@) % وصل وسلم على المصطفى % % شفيع البرية زاكي الشيم % % 62(@)(@@) % ومن قد أتى رحمة للورى % % وعنا به قد أزيلت نقم % % 63(@)(@@) % ورضوان ربي عن آله % % ذوي المجد والقدر فينا الأشم % % 64(@)(@@) % وأصحابه الغر أهل التقى % % كواكب فضل إليها يؤم % % 65(@)(@@) % وعن تابعيهم بخير وعن % % مشايخنا القوم أهل الهمم % % 66(@)(@@) % وعن كل إخواننا دائما % % بغير انتهاء وغير عدم % % 67(@)(@@) % مدى الدهر ما هب ريح وما % % توالي على الروض صوب الديم % % 68(@)(@@) % وما قال يدعوه عبد الغني % % إلى الله نرفع أمرا ألم % PageV01P1410 البحر : - 1(@)(@@) % إن كاس التوحيد من يحتسيه % % قاء منه معارفا وعلوما % % 2(@)(@@) % كن بصيرا ولا تلم أهل سكر % % بشراب التقى تصير الملوما % % 3(@)(@@) % شرب الغرب كأس شمس فقام ال % % ليل سكران ثم قاء النجوما % % PageV01P1411 البحر : - 1(@)(@@) % رب موصول هو الناي الذي % % طاب للسامع فيه النغم % % 2(@)(@@) % كاد من ينفخه ينفخ في % % روحنا روحا ولا أحتشم % % 3(@)(@@) % حيث معلوم لنا نافخة % % من ورا كل الورى منبهم % % 4(@)(@@) % يوصل القوت إلى الروح به % % من طريق الأذن فالأذن فم % % PageV01P1412 البحر : - 1(@)(@@) % طاب وقتي بلطيف مسمع % % روح من يصغى إليه نغما % % 2(@)(@@) % والمغنى والغنا آلته % % توهب الأسرار من حلقهما % % 3(@)(@@) % فترى 
ms313	 الروح به تنعش إذ % % قوتها صارت له الأذن فما % % PageV01P1413 البحر : - 1(@)(@@) % يا سماعا كان من آلته % % من به جاء وراق النغم % % 2(@)(@@) % وبه الأرواح تقتات وما % % ثم غير الأذن للروح فم % % PageV01P1414 البحر : - 1(@)(@@) % نزيد في الشكر له دائما % % وكلما زدناه النعم % % 2(@)(@@) % مثل تجارة الكريم الذي % % له شياه ولديه نعم % % 3(@)(@@) % فكلما قلنا له زد لنا % % قال أيا من عاملوني نعم % % PageV01P1415 البحر : - 1(@)(@@) % محمد الاسم حمد الرسم معلوم % % وليس يحكيه منطوق ومفهوم % % 2(@)(@@) % لأنه السر فالأسرار تعرفه % % فكن به السر إن الجهر موهوم % % 3(@)(@@) % ميم الدوائر بالتحقيق معتبر % % في كل شيء فمقروء ومرقوم % % 4(@)(@@) % والمد معناه في العرف الزيادة من % % شيء يقال وما قد قيل محتوم % % 5(@)(@@) % حم في قلبه فهي الزيادة مع % % حم حم سر السبع مكتوم % % 6(@)(@@) % حاء وميم إليها الدال منتسب % % لأنه سرها يخفيه حلقوم % % 7(@)(@@) % حرف شريف له التحريف في بشر % % قد اعتراهم على تحريفه شوم % % PageV01P1416 البحر : - 1(@)(@@) % طيب محيي الدين مسك في الورى % % فاح لكن كل أنف لا يشم % 2(@)(@@) % وعلوم خرجت من فمه % % كل فهم بهداها لا يلم % 3(@)(@@) % قوسه أين الذي يرمى بها % % غرض التحقيق يا قوم هلموا % % PageV01P1417 البحر : - 1(@)(@@) % حولوا عني من الكون لثاما % % وامنحوني من سنا الوجه التثاما % % 2(@)(@@) % يا أحبائي وبثوا نوركم % % في جميعي واكشفوا عني الظلاما % % 3(@)(@@) % لمتى نفسي بكم نفسي كما % % لم أزل لحما لديكم وعظاما % % 4(@)(@@) % فاجعلوني كيف ما كنت بكم % % أول الأمر انمحاقا وانعداما % % 5(@)(@@) % حيث أنتم لا أنا لو كنت أو % % لم أكن كوني بكم صار حراما % % 6(@)(@@) % يا جميل الوجه إحسانك لي % % إن أرى وجهك بي بدرا تماما % % 7(@)(@@) % أنت حق وأنا الباطل لي % % جولة والحق بالدولة قاما % % 8(@)(@@) % عن يمين الحي قوم نزلوا % % يستظلون من القلب خياما % % 9(@)(@@) % أبهموا الأمر على من أبهموا % % ليتني أقدر أنقى الانبهاما % % 10(@)(@@) % كل من يعرفهم ينكر من % % نفسه معهم وجود وارتساما % % PageV01P1418 11(@)(@@) % والذي يجهلهم ساء بهم % % ظنه فهو على دعواه داما % % 12(@)(@@) % خطفوا لبيق ولم أشعر فما 
ms314	 % % حيلتي إلا الجوى والاصطلاما % % 13(@)(@@) % ثم منوا بتجليهم على % % جملتي حالا وقالا ومقاما % % 14(@)(@@) % فأنا اليوم بهم انظرهم % % لا بنفسي وعليه أترامى % % 15(@)(@@) % هذه محبوبة القلب بدت % % تلبس الدهر لنا عاما فعاما % % 16(@)(@@) % جعلتني في ذرى هود جها % % فامتلى القلب لها مني احتراما % % 17(@)(@@) % وتدانت فتدلت وعلت % % وغلت قدرا وجلت أن تسامى % % 18(@)(@@) % فهي لا شيء سواها أبدا % % وإن ازدادت خفاء واكتتاما % % 19(@)(@@) % وسواها هي في برقعها % % حيث سمته خواصا وعواما % % 20(@)(@@) % برقع الظلمة والنور لمن % % كان مأموما ومن كان إماما % % PageV01P1419 21(@)(@@) % وهو أمر كيفما شاءت به % % تتبدى يقظة لي ومناما % % 22(@)(@@) % أيها الركب الذي ودعنا % % سائرا يقطع بيدا واكاما % % 23(@)(@@) % قف بسلع وروابي رامة % % إن قلبي ذلك الجانب راما % % 24(@)(@@) % وعيوني نحوه شاخصة % % تلمح البرق اعتناء واهتماما % % 25(@)(@@) % خذ إلى الحي سلامي فعسى % % يبعث الحي إلى الميت سلاما % % 26(@)(@@) % وتقر العين بالعين وما % % بيننا يرتفع البني دواما % % 27(@)(@@) % عظم الأمر على الأمر ولم % % يكن الأمر لنا إلا كلاما % % 28(@)(@@) % والذي ينزل أو يصعد ما % % هو إلا النقع ثبت والقتاما % % 29(@)(@@) % ثبت لسرا الذي كان لها % % وهي كالشمس سحاب وغماما % % 30(@)(@@) % فترآءتها عيون هي من % % ذاتها وانقسمت منها انقساما % % PageV01P1420 31(@)(@@) % صدق القول فما أقربها % % وهي بالعبد لنا ترمى السهاما % % 32(@)(@@) % عطفت سلمى عى السالم من % % غيرها الوهمي إن كان استقاما % % 33(@)(@@) % لا تقل يا سعد هذا جبل % % إن طغى الماء به نلت اعتصاما % % 34(@)(@@) % واصنع الفلك بتقواك ولا % % تأمن الطوفان موجا والتطاما % % 35(@)(@@) % كان لي في وجه سلمى أثر % % من سواد فأزالته ابتساما % % 36(@)(@@) % وتلاقينا على النور وقد % % كشفت عني الجلابيب العظاما % % 37(@)(@@) % صارت النفس هي القلب هنا % % حيث ما زجت بها القوم الكراما % % 38(@)(@@) % واتحدنا واتخذنا سررا % % نتكي سرا عليها لن نضاما % % 39(@)(@@) % ودخلنا كلنا جنتنا % % لا نرى ذلا ولا نقلى انهضاما % % 40(@)(@@) % فانقلوا عني وعنهم خبرا % % طيبا يهدي به الله الأناما % % PageV01P1421 41(@)(@@) % واذكروني عند من صلى لها % % يعرف الحال ومن بالصدق صاما % % 42(@)(@@) % نحن إخوان الصفا نحن الأولى 
ms315	 % % نحفظ العهد كما نرعى الذماما % % 43(@)(@@) % عين ذاك الواحد الغيب الذي % % نحن كاس الراح فيه والندامى % % 44(@)(@@) % نجتلي منه جمالا ظاهرا % % قد فنينا فيه وجدا وغراما % % 45(@)(@@) % لا تلمنا أيها الغائب عن % % عينه بالجفن دع هذا الملاما % % 46(@)(@@) % وارفع الجفن عن العين تجد % % يقظة بات الورى عنها نياما % % 47(@)(@@) % حاجب يعلو على العين هنا % % أسود يعطي اتفاقا واختصاما % % 48(@)(@@) % وهو حسن الوجه لا ينكره % % غير أعمى عنه أو من يتعامى % % 49(@)(@@) % فانظروا وانتظروا الأمر الذي % % هو أنتم وهو عنكم يتسامى % % 50(@)(@@) % حاصل الأمر جمال كله % % ظاهر في الكون عفوا وانتقاما % % PageV01P1422 البحر : - 1(@)(@@) % لقد أوقعت دعوى المحبة في البلا % % على حكم ما يرضى الهوى ويروم % % 2(@)(@@) % يجاذب روحي أمره فهي روحه % % وتجذبها نفسي لها فتقوم % % 3(@)(@@) % فيا نفسي الأمارة اتئدى هنا % % إلى كم نزاع في الحياة يدوم % % 4(@)(@@) % وآخره موت المحب فإن يمت % % فذلك المحبوب لديه علوم % % 5(@)(@@) % تلوح نجوم الأفق في مائنا فإن % % فني الماء ينخفي والنجوم نجوم % % 6(@)(@@) % وليس هما شيئين يا نفس فافهمي % % كلامي فكم حارت بذاك فهوم % % 7(@)(@@) % وضلت بدعواها التي هي ماؤها % % كما نحن قلنا والغبي ملوم % % PageV01P1423 البحر : - 1(@)(@@) % ربنا الله شارع الأحكام % % محكم الخلق غاية الأحكام % % 2(@)(@@) % واحد ماله شريك ولا في % % ملكه غيره عزيز المرام % % 3(@)(@@) % منعم بالوجود منه علينا % % وبإمدادنا مدى الأيام % % 4(@)(@@) % كل طاعاتنا من الله أنعا % % م ومنا شكر على الأنعام % % 5(@)(@@) % جل ربي تبارك الله مولى % % قد علا ذو الجلال والإكرام % % 6(@)(@@) % لم يزل مرشدا لنا ومبينا % % لخفايا الأمور بين الأنام % % 7(@)(@@) % وله الفضل حيث أهدي إلينا % % أحمد المصطفى الرسول التهامي % % 8(@)(@@) % النبي الذي محا الكفر عنا % % وحبابنا بملة الإسلام % % 9(@)(@@) % صلوات الإله منه عليه % % وعليه منه أجل السلام % % 10(@)(@@) % أمد الدهر ما جلا بمديح % % فيه عبد الغني رقيق النظام % % PageV01P1424 البحر : - 1(@)(@@) % إن شربي شرب الجمال الهيم % % من كؤوس الجمال ذات القديم % % 2(@)(@@) % عدم ظاهر بنور وجود % % في ظلام على الصراط القويم % % 3(@)(@@) % فارفقوا في سلامتي يا رفاقي % % والطفوا بالملا 
ms316	 متى العديم % % 4(@)(@@) % علم الله بي ولم أك شيئا % % فأنا الآن طبق علم العليم % % 5(@)(@@) % يتجلى يل تارة فيريني % % وجهه الحق في أجل نعيم % % 6(@)(@@) % وله الاستتار بي تارة عن % % نظري في كثائف التجسيم % % 7(@)(@@) % فأرى نفسي التي هي منه % % حدثت قد حكت هوب النسيم % % 8(@)(@@) % بين جمع وبين فرق شهود % % واعتقاد حال كعقد نظيم % % 9(@)(@@) % هذه حالتي وهذا مقامي % % كل حين بحسن أمر مقيم % % 10(@)(@@) % فانكروني أو فاتركوني وشاني % % لا تخوضوا بي في عطاء الكريم % % PageV01P1425 11(@)(@@) % أو بداعي الإلهام فاعتقدوني % % لتنالوا ما نال كل حكيم % % PageV01P1426 البحر : - 1(@)(@@) % هو الوارد القدسي كالسيل يحطم % % فلا يستطيع القلب ذلك يكتم % % 2(@)(@@) % جرى في مجاري الروح من حضرة العلى % % فصادفنا نهواه والقلب مغرم % % 3(@)(@@) % فنلقيه نظما تارة بكلامنا % % ونلقيه نثرا عند من هو يفهم % % 4(@)(@@) % نفرج عنا ما نقاسي بوقعه % % فصولته غلابة والتحكم % % 5(@)(@@) % له محونا طورا وطورا ثبوتنا % % ونحن به في جنة تنعيم % % 6(@)(@@) % ألا عم صباحا قول من قال قبلنا % % له ومساء نحن قلنا نتمم % % 7(@)(@@) % وليس الذي قد قال من كل قائل % % ومنا سوى الغيب الذي يتكلم % % 8(@)(@@) % هو الظاهر المعروف في كل ظاهر % % هو الباطن المجهول من ليس يعلم % % 9(@)(@@) % عرفناه لا أنا عرفناه مثل ما % % عرفنا سواه والسوى فيه يعدم % % 10(@)(@@) % وهيهات هيهات الوجود القديم لا % % يشير به عرفاننا ويترجم % % PageV01P1427 البحر : - 1(@)(@@) % ارفع يديك إلى السماء تضرعا % % لله في كل الأمور لتغنما % % 2(@)(@@) % أو ما ترى البلسان مديديه قد % % رفع الكفوف البيض منه إلى السما % % PageV01P1428 البحر : - 1(@)(@@) % روق الكاساتص يا ساقي المدامص في هذا المقام % % 2(@)(@@) % واسق للساداتص في جنح الظلامص خمر الاصطلام % % 3(@)(@@) % واخرق العاداتص ما بين الكرامص أهل الاحترام % % 4(@)(@@) % هات كاسي هاتص لا تخش الملامص أنت لي إمام % % 5(@)(@@) % دور % % 6(@)(@@) % هذه الأحوالص بغية القلوبص لمحة الغيوب % % 7(@)(@@) % من إليها مالص هبت الجنوبص شقت الجيوب % % 8(@)(@@) % فزت بالآمالص والفتى يذوبص كلما يتوب % % 9(@)(@@) % واغتنم ما فاتص قبل الانخرامص نلت ما يرام % % 10(@)(@@) % دور % % PageV01P1429 11(@)(@@) % يا 
ms317	 أخا الأشواقص هذه النفوسص كلها حبوس % % 12(@)(@@) % فالزم الإطلاقص وارفع الرؤوسص تشهد العروس % % 13(@)(@@) % كأس خمري راقص أشرقت شموسص من سناالكؤوس % % 14(@)(@@) % إنها حالاتص تمنع المنامص تكثر الهيام % % 15(@)(@@) % دور % % 16(@)(@@) % صل يا رحمنص للنبي الحبيبص مؤنس الغريب % % 17(@)(@@) % بهجة الأكوانص ذكره يطيبص للفتى اللبيب % % 18(@)(@@) % من يهنه هانص والغني يجيبص عبده النجيب % % 19(@)(@@) % سائر الأوقاتص ما شدا حمامص هام والسلام % % PageV01P1430 البحر : - 1(@)(@@) % نحن أهل العلوم بالإلهام % % لا بفكر العقول والارتسام % % 2(@)(@@) % حيث إلهامنا تقيد فينا % % بمعاني شرائع الإسلام % % 3(@)(@@) % وإذا لم يقم عليه دليل % % عندنا من حديث خير الأنام % % 4(@)(@@) % أو كتاب الله القديم حكمنا % % إنه من وساوس الأوهام % % 5(@)(@@) % وتركنا قبوله وعدلنا % % نحو إيماننا بصدق المقام % % 6(@)(@@) % واتكلنا على الإله تعالى % % نطلب الفيض منه بالإنعام % % 7(@)(@@) % ولدينا الإلهام حيث تأتي % % بشهود النصوص للإفهام % % 8(@)(@@) % فهو أمر محقق ليس فيه % % شبهة علم ربنا العلام % % 9(@)(@@) % نتلقاه بالقبول وإلا % % فهو وسواس غفلة وتعامى % % 10(@)(@@) % ولنا بالكتاب بالله فهم % % خص في الخواص دون العوام % % PageV01P1431 11(@)(@@) % وحديث النبي تفهم منه % % كل معنى يحير العقل سامي % % 12(@)(@@) % إن هذا من منة الله لا من % % قوة الحذق في بليغ الكلام % % 13(@)(@@) % حيث لا شيء نحن والحق حق % % لا سواه والشيء في الإعدام % % 14(@)(@@) % ويمد الجميع منه بجود % % ووجود هو الضيا في الظلام % % PageV01P1432 البحر : - 1(@)(@@) % ظهر الوجود من العدم % % وبدا الحدوث من القدم % % 2(@)(@@) % وأتت تباشير الذي % % خلق الورى لحما ودما % % 3(@)(@@) % والكل فان ماله % % رأس قوم ولا قدم % % 4(@)(@@) % هو ثابت ما شم را % % ئحة الوجود ولا ندم % % 5(@)(@@) % ظن الوجود لنفسه % % فبنى عليه فانهدم % % PageV01P1433 البحر : - 1(@)(@@) % قد جاء ربنا لنا % % في ظلل من الغمام % % 2(@)(@@) % وإن نشأ جئنا له % % إن زال عنا الانبهام % % 3(@)(@@) % والظلل التي أتى % % بها ذواتنا الجسام % % 4(@)(@@) % تظلنا من نوره % % كيلا يكون الانعدام % % 5(@)(@@) % وهي نجار عدم % % نشا من الاسما العظام % % 6(@)(@@) % عناصر أربعة % % مثل الذي في ذا المقام % % 7(@)(@@) % مقام دنيانا التي % % بربها لها القيام % % 8(@)(@@) % واصلها بأنه 
ms318	 % % حي عليم لا يرام % % 9(@)(@@) % وهو مريد قادر % % أركان إيجاد العوام % % 10(@)(@@) % أما الخواص فهو لا % % وجود فيهم يستدام % % PageV01P1434 11(@)(@@) % كالمثل المضروب في % % عالمنا هذا المرام % % 12(@)(@@) % يقول عنه ربنا % % في منزل من الكلام % % 13(@)(@@) % معناه ضرب مثل % % فاستمعوه يا كرام % % 14(@)(@@) % والمثل الأعلى له % % في الأرض والسما يقام % % 15(@)(@@) % فحققوا يا أخوتي % % ما قلته من النظام % % 16(@)(@@) % واستكشفوا بربكم % % عنه وذوقوا ذا الطعام % % 17(@)(@@) % فإنه لب وقد % % أزيل قشره الجهام % % 18(@)(@@) % فتوح وقت رائق % % يجلو لكم كأس المدام % % 19(@)(@@) % فتعرفون ربكم % % من ذاتكم دون الأنام % % 20(@)(@@) % وتفرقون بينه % % وبينكم طول الدوام % % PageV01P1435 21(@)(@@) % وتعلمون أنه % % حق به الجميع هام % % 22(@)(@@) % وباطل أنتم كما % % قال تعالى والسلام % % PageV01P1436 البحر : - 1(@)(@@) % إن الوجود الواحد ال % % موصوف فينا بالقدم % % 2(@)(@@) % هو ظاهر بصفاته % % لي من شبابيك العدم % % 3(@)(@@) % عدم العوالم كلها % % في الأصل مبني ما انهدم % % 4(@)(@@) % لا تنظرن لها وقل % % ما في الوجود لها قدم % % 5(@)(@@) % وانظر إلى صرف الوجو % % د فقط بلا لحم ودم % % 6(@)(@@) % فهو المنزه عن سوا % % ه ولا يحيق بك الندم % % 7(@)(@@) % واعلم بأنك قد أمر % % ت بما أمرت وما انصدم % % 8(@)(@@) % بقل انظروا يا قوم ما % % ذا في السموات احتدم % % 9(@)(@@) % ومن الموالي كن ولا % % تكن المهان من الخدم % % 10(@)(@@) % ولنفسك اعرف واعترف % % بالحق واترك من كدم % % PageV01P1437 البحر : - 1(@)(@@) % دم طالبا تاركا دعوى الوصول فما % % فازا مرؤ بل من دعوى الوصول فما % % 2(@)(@@) % رأيت قوما لهم دعوى الوصل إلى % % مولى الموالي الذي قد عمهم كرما % % 3(@)(@@) % وعنه قد رجعوا قصدا لأنفسهم % % يدبرون بها اللذات والألما % % 4(@)(@@) % وليس فيهم سوى دعوى الوصول وقد % % عاشوا بها في غرور زائد وعمى % % 5(@)(@@) % والله ما وصلوا لله إن رجعوا % % وكيف يرجع من في الحضرة انعدما % % 6(@)(@@) % وبعدما انعدم انزاحت حقيقته % % إلى حقيقة غيب عنه فانكتما % % 7(@)(@@) % وكان ما كان مما لا أفوه به % % نور لقد أعدم الأنوار والظلما % % 8(@)(@@) % فهو الوجود الحقيقي والسوى عدم % % صرف أحاط به الرب الذي علما % % 9(@)(@@) % وبالذي 
ms319	 هو في العلم القديم لقد % % تكلم الحق حتى أظهر الكلما % % 10(@)(@@) % والأمر كن فيكون الخلق أجمعهم % % في كل طرفة عين بارقا دهما % % PageV01P1438 11(@)(@@) % دع الدعاوي وقم في الباب منكسرا % % لعل يقبلك البواب إن رحما % % 12(@)(@@) % ولا تزاحم على نيل المنى أحدا % % واعلم بأن قضاء الله قد لزما % % 13(@)(@@) % والكل منه وما منه سواه فدع % % عنك الجهالة واترك ذلك الوهما % % PageV01P1439 البحر : - 1(@)(@@) % أرسل الله إلينا % % بالكرامات العظام % % 2(@)(@@) % أحمد المختار طه % % سيد الرسل الكرام % % 3(@)(@@) % فتهنوا يا رفاقي % % نلتموكل المرام % % 4(@)(@@) % بالذي قد جاءكم يد % % عو إلى دار السلام % % 5(@)(@@) % قالت أقمار الدياجي % % قل لأرباب الغرام % % 6(@)(@@) % كل من يعشق محمد % % ينبغي أن لا ينام % % 7(@)(@@) % دور % % 8(@)(@@) % يا حبيب الله يا من % % نوره يملا الوجود % % 9(@)(@@) % والذي من كفه قد % % فاض فينا بحر جود % % 10(@)(@@) % أنت سر الله حقا % % جئت من خير الجدود % % PageV01P1440 11(@)(@@) % لنجاة الخلق مما % % ضرهم تهدي الأنام % % 12(@)(@@) % قالت أقمار الدياجي % % قل لأرباب الغرام % % 13(@)(@@) % كل من يعشق محمد % % ينبغي أن لا ينام % % 14(@)(@@) % دور % % 15(@)(@@) % سارت الركبان ليلا % % قصدهم أرض الحجاز % % 16(@)(@@) % والمطايا تترامى % % باضطراب واهتزاز % % 17(@)(@@) % كلما الحادي دعاهم % % للسرى من جد فاز % % 18(@)(@@) % والهوى في القلب يرمي % % كل وقت بالسهام % % 19(@)(@@) % قالت أقمار الدياجي % % قل لأرباب الغرام % % 20(@)(@@) % كل من يعشق محمد % % ينبغي أن لا ينام % % PageV01P1441 21(@)(@@) % دور % % 22(@)(@@) % هذه آرام رامه % % ناظرات بالعيون % % 23(@)(@@) % يا لقومي كل من ها % % م بها يلقى المنون % % 24(@)(@@) % سيما النور يبدو % % هتك السر المصون % % 25(@)(@@) % قد عدمنا العقل لما % % ظهرت تلك الخيام % % 26(@)(@@) % قالت أقمار الدياجي % % قل لأرباب الغرام % % 27(@)(@@) % كل من يعشق محمد % % ينبغي أن لا ينام % % 28(@)(@@) % دور % % 29(@)(@@) % وصلاة الله ربي % % مع سلام لا يزال % % 30(@)(@@) % لنبي الله من حا % % ز جمالا وجلال % % PageV01P1442 31(@)(@@) % والذي عبد الغني ير % % جو به نيل الكمال % % 32(@)(@@) % وبآل وبصحب % % يرتجى حسن الختام % % 33(@)(@@) % قالت أقمار الدياجي % % قل لأرباب الغرام % % 34(@)(@@) % كل من يعشق محمد % % ينبغي أن لا ينام 
ms320	 % % PageV01P1443 البحر : - 1(@)(@@) % إن سلمى لها جميع التمني % % 2(@)(@@) % من جميع الورى وكل التعني % % 3(@)(@@) % ويح أهل الملام منها ومني % % 4(@)(@@) % حجبوها يوم الرياح لأني % % قلت للريح بلغيها السلاما % % 5(@)(@@) % طلق النوم مقلة الصب بتا % % 6(@)(@@) % حيث صار المنام لا يتأتى % % 7(@)(@@) % جعلوا جمعنا على القرب شتى % % 8(@)(@@) % ثم لم يقنعوا بذلك حتى % % منعوها يوم الرياح الكلاما % % 9(@)(@@) % في هواها عدمت كمي وكيفي % % 10(@)(@@) % ومحت صولة الهوى تأليفي % % PageV01P1444 11(@)(@@) % وتقاوت على الذليل الضعيف % % 12(@)(@@) % فتأوهت ثم قلت لطيفي % % آه لو زرت طيفها إلماما % % 13(@)(@@) % يا خيالا منها أتى وتولى % % 14(@)(@@) % لم أزل منه بالجوى أتقلى % % 15(@)(@@) % ليته كان لي معينا وهلا % % 16(@)(@@) % خصها بالسلام عني والا % % منعوها لشقوتي أن تناما % % PageV01P1445 البحر : - 1(@)(@@) % في امتزاج الوجود بالعدم % % واختلاط الحدوث بالقدم % % 2(@)(@@) % حكمة جل من يشاهدها % % كامتزاج الضياء بالظلم % % 3(@)(@@) % وقياس الوجود حيث بدا % % ليس يبقى سواه فافتهم % % 4(@)(@@) % وكذاك الحدوث يذهب أن % % قدم بأن ظاهر الهمم % % 5(@)(@@) % وكذاك الضياء يمحق ما % % كان من ظلمة لمنبهم % % 6(@)(@@) % لكن الظاهر الوجود سرى % % سر أسمائه بمنعدم % % 7(@)(@@) % فهو معنى امتزاجه وكذا % % قدم مع حدوث منكتم % % 8(@)(@@) % وضياء مع الظلام على % % حكم أسمائه فلم يقم % % 9(@)(@@) % إنه لا امتزاج بينهما % % خالق الخلق بارئ النسم % % 10(@)(@@) % أول وهو آخر لحجي % % ظاهر وهو باطن لعمى % % PageV01P1446 11(@)(@@) % أيها السائر المجد إذا % % جئت سلعا فسل عن الحرم % % 12(@)(@@) % خذ يمينا بنا إلى وطن % % فيه كنا وقف على العلم % % 13(@)(@@) % وتأمل ربوع كاظمة % % بين تلك الطلول والخيم % % 14(@)(@@) % إن لي سادة هناك أرى % % نورهم مشرفا بذي سلم % % 15(@)(@@) % كلما قلت ليت لي خبرا % % عندهم قيل أنت في العدم % % 16(@)(@@) % وإذا قلت لورويت بهم % % قيل لي من بهم يهيم ظمى % % 17(@)(@@) % غير أنى بهم ظهرت لهم % % ظلمة خولطت بنورهم % % 18(@)(@@) % تنتفى تارة وتثبت ما % % بقيت كالخيال في الحلم % % PageV01P1447 البحر : - 1(@)(@@) % قوموا بنا نعشق الساقي لنا يا قوم % % خمر التجلي الذي منه غلافي السوم % % 2(@)(@@) % ما حبكم للسوى الأخيال النوم % % والحب في الله 