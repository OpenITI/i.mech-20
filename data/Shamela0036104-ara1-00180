ms161	 - (@)(@@) قرأ أبو عمرو ويعقوب {هل هن كاشفات} [38] منونة {ضره} بالنصب وكذلك {ممسكات} [38] منونة {رحمته} بالنصب.(@)(@@) وقرأ الباقون: {كاشفات ضره} و {ممسكات رحمته} بغير تنوين. و {ضره} و {رحمته} بالخفض على الإضافة.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ حمزة والكسائي وخلف {فيمسك التي قضى عليها} [42] بضم القاف وكسر الضاد وفتح الياء {الموت} بالرفع.(@)(@@) وقرأ الباقون وقتيبة {قضى} بفتح القاف والضاد {الموت} بالنصب.(@)(@@) PageV01P384(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ عاصم في رواية أبي بكر، وحمزة والكسائي وخلف {وينجي الله الذين اتقوا بمفازتهم} [61] بالألف على الجمع. وقرأ الباقون {بمفازتهم} بغير ألف، على واحدة.(@)(@@)(@@)(@@) | 8 - (@)(@@) روح عن يعقوب مختلف عنه {وينجي الله} خفيفة الجيم، وكذلك رواه عبد الله بن بحر الساجي عن يعقوب وقال أبو حاتم: هو حسن.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ أبو جعفر {أن تقول نفس يا حسرتا} [56] بياء مفتوحة بعد الألف مثل {يا بشرى} وقرأ الباقون {يا حسرتا} بغير ياء مثل {يا بشرى} و {يا أسفى} ونحوه.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ أبو جعفر ونافع {قل أفغير الله تأمروني} [64] خفيفة النون مفتوحة الياء وقرأ ابن كثير {تأمروني أعبد} مشددة النون مفتوحة الياء وقرأ ابن عامر {تأمروني} بنونين والياء ساكنة، وكذلك رأيته في مصاحف أهل الشام مكتوبة بنونين والياء ساكنة، منقوطا بنقطتين. وقرأ الباقون {تأمروني أعبد} مشددة النون مرسلة الياء.(@)(@@)(@@)(@@) | 11 - (@)(@@) زيد عن يعقوب {ليحبطن} [65] بالنون وضمه {عملك} بالنصب.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {حتى إذا جاءوها فتحت} [71] خفيفة التاء وكذلك الذي بعده {وفتحت أبوابها} [73] خفيفة أيضا وقرأ الباقون {فتحت} {وفتحت} مشددة الدال في الحرفين.(@)(@@) PageV01P385(@)(@@) - روى محمد بن حبيب الشموني عن الأعشى {قل يا عباد الذين آمنوا اتقوا ربكم} [10] بفتح الياء. كذلك قرأنا واخذ علينا في هذه الرواية. وكذلك في رواية عبد الحميد بن صالح البرجمي عن أبي بكر. ويقف بغير ياء في رواية الشموني، وفي رواية البرجمي بالياء.(@)(@@) وقرأنا في رواية محمد بن غالب عن الأعشى بغير فتح مثل سائر القراء.(@)(@@) - وقوله: {فبشر عباد (17) الذين} [17 و18] بفتح الياء أيضا في رواية البرجمي عن أبي بكر والشموني عن الأعشى.(@)(@@) وفي رواية محمد بن غالب 
ms162	 عن الأعشى بغير فتح مثل حماد ويحيى عن أبي بكر. والله أعلم به.(@)(@@) واختلف عن أبي عمرو أيضا: قرأنا في رواية شجاع {فبشر عباد (17) الذين} بفتح الياء، وكذلك في رواية أبي حمدون وأبي شعيب السوسي عن اليزيدي بفتح الياء. وفي رواية أوقية وأبي عمر وصاحب السجادة في اليزيدي: بغير فتح، كذلك أخذوا علينا. وروى الفتح فيه عنه أيضا العباس بن الفضل الأنصاري وأبو عبد الرحمن بن اليزيدي، وابن سعدان عن اليزيدي نصا، وهذا يدل على أنه كان يذهب في العدد مذهب المدني الأول فلا يعدها رأس آية، وهذا كان مذهب المشايخ والأئمة قديما كانوا يعدون عدد المدني الأول في الأكثر والأغلب، والله أعلم به.(@)(@@) - وروى عبيد بن عقيل عن أبي عمرو أنه قال: إن كان رأس آية وقفت وإن لم يكن رأس آية فتحت فقلت {عبادي الذين}. ومن لم يفتح ذهب إلى أنه رأس آية في عدد الكوفة(@)(@@) PageV01P386(@)(@@) والبصرة والمدني الأخير. والله أعلم. وقياس من فتح الياء أن يقف بالياء، ولكن ذكر أبو حمدون وابن اليزيدي أنه يقف بغير ياء لأنه مكتوب بغير ياء، وكذلك مذهبه يستحب الوقف على ما في الكتاب، والله أعلم. ولم يختلف عن الباقين أنه غير مفتوح.(@)(@@) وقرأ حمزة وحده {إن أرادني الله بضر} غير مفتوح وقرأ الباقون {إن أرادني الله} بفتح الياء.(@)(@@) وفتح أبو جعفر ونافع {إني أمرت} [11] و {إني أخاف} [13].(@)(@@) وفتح ابن كثير وأبو عمرو {إني أخاف}.(@)(@@) وفتح أبو جعفر ونافع وابن كثير وابن عامر وعاصم {قل يا عبادي الذين أسرفوا} [53] بفتح الياء. وقرأ أبو عمرو وحمزة والكسائي ويعقوب وخلف {يا عبادي الذين} بغير فتح وكلهم يقفون عليها بإثبات الياء من فتح منهم ومن لم يفتح، على ما في السواد. والله أعلم.(@)(@@) PageV01P387(@)(@@)(@@)(@@) | سورة المؤمن(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ عاصم في رواية حماد ويحيى عن أبي بكر، وحمزة والكسائي وخلف {حم} [1] بكسر الحاء في جميعها. وقرأ الباقون بفتح الحاء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {وكذلك حقت كلمت ربك} [6] بالألف على الجمع. 
ms163	 وفي سورة "يونس" مثله، وهو مذكور هناك.(@)(@@) وقرأ الباقون {كلمت ربك} على واحدة.(@)(@@) PageV01P388(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ يعقوب برواية روح وزيد {لينذر يوم التلاق} [15] بالتاء كقراءة الحسن وغيره. وقرأ الباقون {لينذر} بالياء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ نافع وحده {والذين يدعون من دونه} [20] وقرأ الباقون {يدعون} بالياء.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن عامر وحده {كانوا هم أشد منهم قوة} [21] بالكاف وكذلك في مصاحف الشام وقرأ الباقون {منهم} بالهاء.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع {إني أخاف أن يبدل دينكم أو أن} [26] بغير ألف قبل الواو {يظهر} بضم الياء وكسر الهاء {الفساد} بالنصب. وقرأ ابن كثير وابن عامر {أو أن} بغير ألف أيضا {يظهر} بفتح الياء والهاء {الفساد} بالرفع.(@)(@@) وقرأ حفص عن عاصم، ويعقوب {أو أن} بالألف قبل الواو و {يظهر} بضم الياء وكسر الهاء {الفساد} بالنصب.(@)(@@) وقرأ عاصم في رواية أبي بكر، وحمزة والكسائي وخلف {أو أن} بالألف {يظهر} بفتح الياء والهاء {الفساد} بالرفع.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ أبو جعفر وأبو عمرو، ونافع برواية إسماعيل، وحمزة والكسائي وخلف {وقال موسى إني عذت} [27] وكذلك في سورة "الدخان" [آية 20] {وإني عذت بربي} بادغام الذال في التاء. وكذلك قوله {فنبذتها} حيث كان(@)(@@) PageV01P389(@)(@@) وقرأ ابن كثير وابن عامر ونافع وعاصم ويعقوب {عذت} و {فنبذتها} باظهار الذال حيث كان.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو عمرو وابن عامر، وقتيبة عن الكسائي، {على كل قلب} [35] منونا غير مضاف.(@)(@@) - وقرأ الباقون {على كل قلب متكبر} بغير تنوين على الإضافة.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ حفص عن عاصم {فأطلع إلى إله موسى} [37] بالنصب.(@)(@@) وقرأ الباقون {فأطلع}.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ أبو جعفر ونافع، وحفص عن عاصم، وحمزة والكسائي وخلف ويعقوب {ويوم تقوم الساعة أدخلوا آل فرعون} [46] بقطع الألف وكسر الخاء. وقرأ ابن كثير وابن عامر، وأبو بكر عن عاصم، {الساعة أدخلوا} بوصل الألف وضم الخاء. والابتداء بضم الألف.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ أبو جعفر وأبو عمرو وابن كثير وابن عامر ويعقوب {يوم لا ينفع الظالمين} [52] وقرأ الباقون {ينفع} بالياء.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {قليلا ما تتذكرون} [58] بالتاء. وقرأ الباقون {قليلا ما تتذكرون} بالياء.(@)(@@)(@@)(@@) | 13 - (@)(@@) قرأ أبو 
ms164	 جعفر وابن كثير ويعقوب، وعبد الحميد بن(@)(@@) PageV01P390(@)(@@) صالح البرجمي عن أبي بكر، ومحمد بن غالب عن الأعشى عن أبي بكر وحماد ويحيى عن أبي بكر {إن الذين يستكبرون عن عبادتي سيدخلون} [60] بضم الياء وفتح الخاء. كذلك قرأنا في جميع الروايات عن أبي بكر - إلا في رواية محمد بن حبيب الشموني عن الأعشى عنه فإنا قرأنا {سيدخلون} بفتح الياء. وكذلك قرأ الباقون، وزيد عن يعقوب، والضرير عن روح وغيره أيضا عن يعقوب {سيدخلون} بفتح الياء وضم الخاء.(@)(@@) اثبات الياءات وحذفها وفتحها(@)(@@) قرأ ابن كثير ويعقوب {يوم التلاق} [15] و {التنادي} [32] باثبات الياء في الوصل والوقف. وقرأ أبو جعفر، وورش عن نافع، {التلاقي} و {التنادي} بالياء في الوصل دون الوقف. واختلف عن إسماعيل عن نافع فيما قرأت، والمشهور حذف الياء عنه والله أعلم. وقرأ الباقون بحذف الياء في الوصل والوقف.(@)(@@) قرأ أبو جعفر وأبو عمرو وابن كثير، وإسماعيل عن نافع، وورش من طريق الأصبهاني وقالون برواية أبي نشيط، ويعقوب {يا قوم اتبعون أهدكم} [38] بإثبات الياء وقرأ الباقون بحذف الياء.(@)(@@) قرأ ابن كثير في رواية القواس والبزي {هادي} [33] و {واقي} [21] بإثبات الياء في الوقف وحذفها في(@)(@@) PageV01P391(@)(@@) الوصل وكذلك يعقوب وهو مذهبه في جميع ما أشبهه والباقون يقفون بغير ياء. ولا خلاف في تنوينه في الوصل.(@)(@@) فتح أبو جعفر ونافع وأبو عمرو {إني أخاف} [26 و30 و32] و {لعلي أبلغ} [36] و {ما لي أدعوكم} [41] و {أمري إلى الله} [44].(@)(@@) وفتح ابن كثير {إني أخاف} و {لعلي أبلغ} و {ما لي أدعوكم} و {ذروني أقتل} [26] و {ادعوني أستجب} [60].(@)(@@) وفتح ابن عامر {لعلي أبلغ} فقط. ولم يفتح الباقون منها شيئا. والله أعلم.(@)(@@) PageV01P392(@)(@@)(@@)(@@) | سورة السجدة [فصلت](@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر {في أربعة أيام سواء} [10] بالرفع.(@)(@@) وقرأ يعقوب {سواء} بالخفض مثل قراءة الحسن وابن يعمر وعيسى.(@)(@@) وقرأ الباقون {سواء} بالنصب.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر وابن عامر وعاصم وحمزة والكسائي وخلف {في أيام نحسات} [16] بكسر الحاء وقرأ ابن كثير ونافع وأبو عمرو ويعقوب {نحسات} ساكنة الحاء.(@)(@@)(@@)(@@) | 3 
ms165	 - (@)(@@) قرأ نافع ويعقوب {ويوم يحشر} [19] بالنون {أعداء الله} [19] بالنصب وقرأ الباقون {ويوم يحشر} بضم الياء وفتح الشين {أعداء الله} بالرفع.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ عاصم في رواية أبي بكر، وحمزة والكسائي وخلف {أأعجمي وعربي} [44] بهمزتين على أصلهم كما(@)(@@) PageV01P393(@)(@@) ذكرناه في {أأنذرتهم} وأشباه ذلك. الباقون {أأعجمي} بهمزة واحدة ممدودة كما ذكرنا في التقديم.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن كثير وابن عامر، وأبو بكر عن عاصم، ورويس عن يعقوب، {أرنا اللذين} [آية 29] ساكنة الراء وقرأ الباقون بكسر الراء. أبو عمرو وحده يختلسها ولا يشبعها وقد مر ذكره وشرحه في سورة البقرة.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر، وحفص عن عاصم، {من ثمرات من أكمامها} [47] بالألف على الجمع. وقرأ الباقون {من ثمرة} بغير ألف، على واحدة.(@)(@@) فتح الياءات(@)(@@) فتح أبو جعفر ونافع وأبو عمرو {إلى ربي إن لي} [50] وفتح ابن كثير {أين شركائي قالوا} [47] ولم يفتح الباقون منها شيئا.(@)(@@) PageV01P394(@)(@@)(@@)(@@) | سورة الشورى [عسق](@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ ابن كثير وحده {كذلك يوحي إليك} [3] بفتح الحاء وقرأ الباقون {يوحي} بكسر الحاء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرا حمزة والكسائي وحفص عن عاصم، وخلف {ويعلم ما تفعلون} [25] بالتاء. وقرأ الباقون {يفعلون} بالياء.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {وما أصابكم من مصيبة فبما كسبت أيديكم} [30] بغير فاء. وكذلك في مصاحفهم.(@)(@@) وقرأ الباقون {فبما كسبت} بالفاء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {ويعلم الذين يجادلون} [35] بالرفع. وقرأ الباقون {ويعلم} بالنصب.(@)(@@) PageV01P395(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ حمزة والكسائي وخلف {والذين يجتنبون كبائر الإثم} [37] بغير ألف وكسر الباء على واحدة وفي سورة "النجم" [آية 32] مثله. وقرأ الباقون {كبائر الإثم} بالألف والمد والهمز، على الجمع في السورتين.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ نافع وحده {أو يرسل رسولا} [51] بالرفع {فيوحي} بالإسكان. وقرأ الباقون {أو يرسل رسولا فيوحي} [51] بالنصب فيهما.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو ويعقوب {ومن آياته الجوار في البحر} باثبات الياء: ابن كثير ويعقوب في الوصل والوقف. والآخرون في الوصل دون الوقف.(@)(@@) وقرأ ابن عامر وعاصم وحمزة والكسائي وخلف {الجوار} بحذف الياء في الوصل والوقف. 
ms166	(@)(@@) PageV01P396(@)(@@)(@@)(@@) | سورة الزخرف(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر ونافع وحمزة والكسائي وخلف {أفنضرب عنكم الذكر صفحا أن كنتم قوما مسرفين} [5] بكسر الألف. وقرأ ابن كثير وابن عامر وأبو عمرو وعاصم ويعقوب {أن كنتم} بفتح الألف.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر وحده {فأنشرنا به بلدة ميتا} [11] مشددة الياء كل القرآن وقد ذكرته.(@)(@@)(@@)(@@) | 3 - (@)(@@) وقرأ أيضا {وجعلوا له من عباده جزءا} [15] مشددة الزاي غير مهموز كل القرآن وقد ذكرته في سورة "البقرة".(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ حمزة والكسائ وحفص عن عاصم، وخلف {أومن ينشأ} [18] بضم الياء وفتح النون وتشديد الشين. وقرأ الباقون {أومن ينشأ} بفتح الياء وسكون النون وتخفيف الشين.(@)(@@) PageV01P397(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر ويعقوب {وجعلوا الملائكة الذين هم عباد الرحمن} [19] بالنون.(@)(@@) وقرأ أبو عمرو وعاصم وحمزة والكسائي وخلف {عباد الرحمن} بالباء والألف، جمع عبد.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر، ونافع برواية قالون، {أشهدوا خلقهم} [19] بهمزة واحدة ممدودة. وفي رواية ورش وإسماعيل غير ممدودة والشين ساكنة. وقرأ الباقون {أشهدوا} بفتح الألف والشين.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ ابن عامر، وحفص عن عاصم، {قال أولو جئتكم} [24] بالألف على الخبر وقرأ الباقون {قل} على الأمر.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو جعفر {أولو جئتكم} [24] بالنون والألف. وقرأ الباقون {جئتكم} بالتاء.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ أبو جعفر وابن كثير وأبو عمرو {لبيوتهم سقفا من فضة} [33] بفتح السين وسكون القاف. وقرأ الباقون {سقفا} بضم السين والقاف.(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ عاصم وحمزة {وإن كل ذلك لما} [35] مشددة الميم، وقرأ البقون {لما} خفيفة الميم.(@)(@@) PageV01P398(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ عاصم في رواية حماد، ويعقوب {ومن يعش عن ذكر الرحمن نقيض له} [36] بالياء، وكذلك ذكره أو حاتم والأعشى والأعمش لعاصم بالياء أيضا. وقرأ الباقون {نقيض} بالنون.(@)(@@)(@@)(@@) | 12 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر، وأبو بكر عن عاصم، {حتى إذا جاءنا} [38] بالألف بعد الهمزة، على اثنين. وقرأ أبو عمرو وحمزة والكسائي، وحفص عن عاصم ويعقوب {إذا جاءنا} على واحدة.(@)(@@)(@@)(@@) | 13 - (@)(@@) قرأ حفص عن عاصم، ويعقوب {أسورة من ذهب} [53] بغير ألف وسكون السين. وقرأ الباقون {أسورة} بالألف.(@)(@@)(@@)(@@) | 14 
ms167	 - (@)(@@) قرأ حمزة والكسائي {فجعلناهم سلفا} [56] بضم السين واللام. وقرأ الباقون {سلفا} بفتح السين واللام.(@)(@@)(@@)(@@) | 15 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر والكسائي وخلف، والأعشى والبرجمي عن أبي بكر {إذا قومك منه يصدون} بضم الصاد.(@)(@@) قرأ ابن كثير وأبو عمرو، وعاصم برواية حماد وحفص، ويحيى عن أبي بكر، وحمزة ويعقوب {يصدون} بكسر الصاد.(@)(@@)(@@)(@@) | 16 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر، وحفص عن عاصم، {وفيها ما تشتهيه الأنفس} [71] بزيادة الهاء في آخره. وقرأ الباقون {ما تشتهيه الأنفس} بغير هاء.(@)(@@)(@@)(@@) | 17 - (@)(@@) وقرأ ابن كثير وحمزة والكسائي وخلف {وإليه ترجعون} [85] بالياء. وقرأ الباقون بالتاء. وقرأت في رواية(@)(@@) PageV01P399(@)(@@) شعيب عن يحيى عن أبي بكر بالياء أيضا، وروي عن روح بالياء أيضا.(@)(@@)(@@)(@@) | 18 - (@)(@@) قرأ عاصم وحمزة {وقيله يا رب} [88] بالخفض وكذلك رواه أبو علي الضرير البصري عن أصحابه عن يعقوب {وقيله} بالجر. وقرأ الباقون {وقيله} بالنصب.(@)(@@)(@@)(@@) | 19 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {وقل سلام فسوف يعلمون} بالتاء [89] وقرأ الباقون {فسوف يعلمون} بالياء.(@)(@@) اثبات الياءات وفتحها(@)(@@) قرأ أبو جعفر وأبو عمرو وإسماعيل عن نافع ويعقوب {واتبعون} [61] باثبات الياء وقرأ الباقون {واتبعون} بحذف الياء. قرأ أبو جعفر ونافع وابن عامر وأبو عمرو ويعقوب {يا عباد لا خوف عليكم} بالياء في الوصل والوقف إلا أبا عمرو فإنه يقف بغير ياء. واختلف عن يعقوب في إثباته. وقرأ عاصم في رواية أبي بكر {يا عباد لا خوف} بفتح الياء، ولا يفتحها غيره.(@)(@@) وقرأ ابن كثير، وحفص عن عاصم وحمزة والكسائي وخلف، ومحمد بن غالب عن الأعشى عن أبي بكر {يا عباد} بغير ياء في الوصل والوقف.(@)(@@) وفتح أبو جعفر ونافع وابن كثير وأبو عمرو {من تحتي أفلا تبصرون} [51] ولم يفتحها الآخرون. والله أعلم.(@)(@@) PageV01P400(@)(@@)(@@)(@@) | سورة الدخان(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {رب السماوات} [7] بالخفض وقرأ الباقون {رب} بالرفع.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر {يوم نبطش} [16] بضم الطاء. وقرأ الباقون {نبطش} بكسر الطاء.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ ابن كثير، وحفص عن عاصم، ورويس عن يعقوب {كالمهل يغلي في البطون} [45] بالياءز 
ms168	 وقرأ الباقون {يغلي} بالتاء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر وأبو عمرو وعاصم وحمزة والكسائي وخلف {خذوه فاعتلوه} [47] بكسر التاء. وقرأ ابن كثير ونافع وابن عامر ويعقوب {فاعتلوه} بضم التاء.(@)(@@) PageV01P401(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ الكسائي وحده {ذق إنك أنت العزيز الكريم} [49] بفتح الألف وقرأ الباقون {ذق إنك} بكسر الألف.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {إن المتقين في مقام أمين} [51] بضم الميم. وقرأ الباقون {مقام} بفتح الميم.(@)(@@) الاثبات والفتح(@)(@@) قرأ ورش عن نافع، ويعقوب {أن ترجمون} [20] {فاعتزلون} [21] باثبات الياء. وقرأ الباقون بحذف الياء فيهما.(@)(@@) وفتح ورش {وإن لم تؤمنوا لي} [21] وفتح أبو جعفر ونافع وابن كثير وأبو عمرو {إني آتيكم} [19]. ولم يفتح الباقون.(@)(@@) PageV01P402(@)(@@)(@@)(@@) | سورة الجاثية [الشريعة](@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ حمزة والكسائي ويعقوب {وما يبث من دابة آيات} [4] {وتصريف الرياح آيات} [5] بالخفض. وقرأ الباقون {آيات} بالرفع في الحرفين.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو وعاصم {فبأي حديث بعد الله وآياته يؤمنون} [6] بالياء.(@)(@@) وقرأ ابن عامر، وعاصم في رواية حماد ويحيى عن أبي بكر، وحمزة والكسائي ويعقوب وخلف {وآياته يؤمنون} بالتاء.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر {ليجزي قوما بما} [14] بضم الياء وفتح الزاي. وقرأ ابن عامر وحمزة والكسائي وخلف(@)(@@) PageV01P403(@)(@@) {ليجزي} بالنون وكسر الزاي وفتح الياء. قرأ نافع وابن كثير وأبو عمرو وعاصم ويعقوب {ليجزي} بالياء وكسر الزاي وفتح الياء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ حمزة والكسائي، وحفص عن عاصم، وخلف، وروح، وزيد عن يعقوب، {سواء محياهم} [21] بالنصب. وقرا الباقون {سواء} بالرفع.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ حمزة والكسائي وخلف {وجعل على بصره غشاوة} [23] بفتح الغين وسكون الشين. وقرأ الباقون {غشاوة} بكسر الغين وفتح الشين.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ يعقوب {جاثية كل أمة} [28] بالنصب كما روى عن الأعرج. وقرأ الباقون {كل} بالرفع.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ حمزة وحده {والساعة لا ريب} [32] بالنصب. وكذلك رواه أبو علي الضرير عن روح وغيره عن يعقوب.(@)(@@) وقرا الباقون {والساعة} بالرفع.(@)(@@) PageV01P404(@)(@@)(@@)(@@) | سورة الأحقاف(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر ويعقوب {لينذر الذين ظلموا} [12] بالتاء.(@)(@@) وقرأ أبو جعفر وعاصم وحمزة 
ms169	 والكسائي وخلف {لينذر الذين ظلموا} بالياء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {ووصينا الإنسان بوالديه إحسانا} [15] بالألف وسكون الحاء وفتح السين. وقرأ الباقون {بوالديه إحسانا} بضم الحاء وسكون السين.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ يعقوب {وحمله وفصاله} [15] بفتح الفاء وسكون الصاد، كقراءة الحسن وأبي رجاء وعاصم الجحدري وغيرهم.(@)(@@) PageV01P405(@)(@@) وقرأ الباقون {وفصاله} بكسر الفاء وفتح الصاد والألف.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ حمزة والكسائي، وحفص عن عاصم، وخلف {أولئك الذين نتقبل عنهم} [16] بالنون {أحسن ما عملوا} [16] بالنصب {ونتجاوز} بالنون أيضا.(@)(@@) وقرأ الباقون {نتقبل} بضم الياء {أحسن} بالرفع {ونتجاوز} بضم الياء أيضا.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن كثير وأبو عمرو وعاصم ويعقوب {وليوفيهم أعمالهم} [19] بالياء وقرأ الباقون {وليوفيهم} بالنون.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر وابن كثير ويعقوب {أذهبتم طيباتكم} [20] مستفهما بهمزة واحدة ممدودة على الوصف الذي بيناه في أول الكتاب في {أأنذرتهم} وأشباهه. وقرأ ابن عامر {أذهبتم} بهمزتين. وقرأ نافع وأبو عمرو وعاصم وحمزة والكسائي وخلف {أذهبتم} بفتح الألف غير مستفهم.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ عاصم وحمزة ويعقوب وخلف {فأصبحوا لا يرى} بضم الياء {إلا مساكنهم} [25] بالرفع. وقرأ الباقون {لا يرى} بالياء مفتوحة {إلا مساكنهم} بالنصب. وفيما قرأنا من رواية شعيب بن أيوب عن يحيى عن أبي بكر {لا ترى} بضم التاء {إلا مساكنهم} بالرفع، كما روي عن الحسن وأبي عبد(@)(@@) PageV01P406(@)(@@) الرحمن السلمي، وكذلك رواه يونس عن أبي عمرو، وحماد بن زيد عن ابن كثير.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ يعقوب وحده {ولم يعي بخلقهن بقادر} [33] بالياء وسكون القاف، مثل ما روي عن ابن أبي اسحاق والجحدري وعيسى وسلام ومالك بن دينار والأعرج وقرأ الباقون {بقادر} بالباء والألف.(@)(@@) فتح الياءات(@)(@@) فتح أبو جعفر ونافع من الياءات {إني أخاف} [21] {ولكني أراكم} [23] و {أتعدانني أن أخرج} [17] وفتح أبو عمرو {إني أخاف} {ولكني أراكم}.(@)(@@) - وفتح ورش عن نافع {أوزعني أن أشكر} [15] من طريق البخاري. وفي طريق الأصبهاني غير مفتوحة. وقد ذكرته في النمل.(@)(@@) وفتح ابن كثير {إني أخاف} و {أتعدانني أن}. وفتح في رواية البزي {ولكني أراكم} و {أوزعني أن} ولم يفتحهما القواس. واختلف عن ابن فليح {أوزعني} وقد 
ms170	 ذكرته في سورة "النمل".(@)(@@) PageV01P407(@)(@@)(@@)(@@) | سورة محمد - صلى الله عليه وسلم -(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو عمرو، وحفص عن عاصم، ويعقوب {والذين قتلوا في سبيل الله} [4] بضم القاف وكسر التاء. وقرأ الباقون {قاتلوا} بالألف وفتح التاء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن كثير وحده {من ماء غير آسن} [15] مقصورة الألف على وزن "فعل" وقرأ الباقون {آسن} ممدودة الألف على وزن "فاعل".(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو عمرو ويعقوب {سول لهم وأملى لهم} [25] بضم الألف وفتح الياء.(@)(@@) رويس عن يعقوب {وأملى لهم} بضم الألف ساكنة الياء. وقرأ الباقون {وأملى} بفتح الألف واللام.(@)(@@) PageV01P408(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ يعقوب {وتقطعوا أرحامكم} [22] بفتح التاء والطاء وسكون القاف.(@)(@@) وقرأ الباقون {وتقطعوا} بضم التاء وفتح القاف، وكسر الطاء مشددة.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ حمزة والكسائي، وحفص عن عاصم، وخلف {والله يعلم إسرارهم} [26] بكسر الألف.(@)(@@) - وقرأ الباقون {إسرارهم} بفتح الألف.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو بكر عن عاصم {ولنبلونكم حتى نعلم المجاهدين منكم والصابرين ونبلو أخباركم} [31] كله بالياء.(@)(@@)(@@)(@@) | 7 - (@)(@@) وقرأ يعقوب {ونبلو أخباركم} [31] ساكنة الواو.(@)(@@) وقرأ الباقون {ونبلو} بفتح الواو.(@)(@@)(@@)(@@) | 8 - (@)(@@) وقرأ عاصم في رواية أبي بكر، وحمزة وخلف {وتدعوا إلى السلم} [35] بكسر السين وقرأ الباقون {السلم} بفتح السين. والله أعلم بذلك.(@)(@@) PageV01P409(@)(@@)(@@)(@@) | سورة الفتح(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ ابن كثير وأبو عمرو {لتؤمنوا بالله ورسوله وتعزروه وتوقروه وتسبحوه} [9] كله بالياء. وقرأ الباقون كله بالتاء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر {فسيؤتيه أجرا عظيما} [10] بالنون. وقرأ الباقون {فسيؤتيه} بالياء.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ حمزة والكسائي وخلف {إن أراد بكم ضرا} [11] بضم الضاد وقرأ الباقون {ضرا} بفتح الضاد.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ حمزة والكسائي وخلف {يريدون أن يبدلوا كلام الله} [15] بكسر اللام من غير ألف. وقرأ الباقون {كلام الله} بالألف.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {يدخله جنات تجري من تحتها الأنهار ومن يتول يعذبه} [17] بالنون فيهما وقرأ الباقون {يدخله} و {يعذبه} بالياء في حرفين.(@)(@@) PageV01P410(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو عمرو {وكان الله بما تعملون بصيرا} [24] بالياء. وقرأ الباقون {تعملون} بالتاء.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ ابن كثير وابن عامر {أخرج شطأه} 
ms171	 [29] بفتح الطاء. وقرأ الباقون، وابن فليح عن ابن كثير {شطأه} ساكنة الطاء.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ ابن عامر {فآزره} [29] مقصورة الألف. وقرأ الباقون {فآزره} ممدودة الألف والله أعلم.(@)(@@) PageV01P411(@)(@@)(@@)(@@) | سورة الحجرات(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ يعقوب {يا أيها الذين آمنوا لا تقدموا بين} [1] بفتح التاء والدال، كقراءة ابن عباس والضحاك وغيرهما.(@)(@@) وقرأ الباقون {لا تقدموا} بضم التاء وكسر الدال.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر {من وراء الحجرات} [4] بفتح الجيم.(@)(@@) وقرأ الباقون {الحجرات} بضم الجيم.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ يعقوب وحده {فأصلحوا بين أخويكم} [10] بالتاء، مثل قراءة الحسن وسعيد بن جبير وغيرهما.(@)(@@) وقرأ الباقون {بين أخويكم} بالياء. وذكر بعضهم عن ابن عامر {بين أخويكم} بالتاء. وهو غلط عظيم، وله في قراءته عجائب وتخاليط لا توصف. لأنه لم يكن قرأ(@)(@@) PageV01P412(@)(@@) بها، وأخذها سماعا من طريق سقيم ورواية ضعيفة، وكان أهل الشام ينكرون ذلك عليه ويقولون فيه أشياء، لا أحب ذكرها، والله يعفو عنا وعنه.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ يعقوب {ولا تلمزوا} [11] بضم الميم. وقرأ الباقون {ولا تلمزوا} بكسر الميم.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ أبو عمرو ويعقوب {لا يلتكم من أعمالكم} [14] بالألف. إلا أن يعقوب يهمزه على أصله ومذهبه، وأبو عمرو مختلف عنه. والمشهور عنه ترك الهمز. وقرأ الباقون {يلتكم} بغير ألف.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ ابن كثير وحده {والله بصير بما تعملون} [18] بالياء. وقرأ الباقون {تعملون} بالتاء. والله أعلم.(@)(@@) PageV01P413(@)(@@)(@@)(@@) | سورة ق(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ نافع، وأبو بكر عن عاصم {يوم نقول لجهنم} [30] بالياء. وقرأ الباقون {نقول} بالنون.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وحمزة وخلف {وأدبار السجود} [40] بكسر الألف. وقرأ ابن عامر وعاصم وابو عمرو والكسائي ويعقوب {وأدبار السجود} بفتح الألف.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ ابن كثير {هذا ما توعدون} [32] بالياء. وقرأ الباقون {توعدون} بالتاء.(@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو ويعقوب {يوم يناد المناد} [41] باثبات الياء: ابن كثير ويعقوب في الوصل والوقف. والآخرون في الوصل دون الوقف. وقرأ ابن عامر وعاصم وحمزة والكسائي وخلف {المناد} بحذف الياء في الوصل والوقف.(@)(@@) قرأ ورش عن نافع، ويعقوب {من يخاف 
ms172	 وعيد} [45] باثبات الياء حيث كان. وقرأ الباقون {وعيد}. بحذف الياء. والله أعلم بذلك.(@)(@@) PageV01P414(@)(@@)(@@)(@@) | سورة الذاريات(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ عاصم في رواية أبي بكر وحمزة والكسائي وخلف {إنه لحق مثل} [23]. وقرأ الباقون {مثل} بالنصب.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ الكسائي {فأخذتهم الصاعقة} [44] ساكنة العين من غير ألف. قرأ الباقون {الصاعقة} بالألف.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو عمرو وحمزة والكسائي وخلف {وقوم نوح من قبل} [46] بالخفض. وقرأ الباقون {وقوم نوح} بالنصب.(@)(@@)(@@)(@@) | سورة الطور(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو عمرو {وأتبعناهم} [21] بالنون والألف وقطع الألف الأولى وسكون التاء {وذرياتهم} [21] بالألف وكسر التاء. {ألحقنا بهم ذريتهم} [21] بالألف أيضا وكسر التاء.(@)(@@) PageV01P415(@)(@@) وقرأ أبو جعفر ونافع {واتبعتهم} بالتاء ووصل الألف وتشديد التاء. بعده {ذريتهم} بالرفع من غير ألف. {ألحقنا بهم ذريتهم} بالألف وكسر التاء. وقرأ ابن عامر ويعقوب {واتبعتهم} بالتاء ووصل الألف {ذريتهم} بالألف والرفع. {ألحقنا بهم ذريتهم} بالألف أيضا وكسر التاء.(@)(@@) وقرأ ابن كثير وعاصم وحمزة والكسائي وخلف {واتبعتهم} بالتاء ووصل الألف {ذريتهم} بالرفع من غير ألف {ألحقنا بهم ذريتهم} بالنصب من غير ألف.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن كثير وحده {وما ألتناهم من عملهم} [21] بكسر اللام وقرأ الباقون {وما ألتناهم} بفتح اللام.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر ونافع والكسائي {إنه هو البر الرحيم} [28] بفتح الألف.(@)(@@) وقرأ الباقون {ندعوه إنه} بكسر الألف.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ ابن كثير {أم هم المصيطرون} [37] بالسين. وفي الغاشية [آية 22] {لست عليهم بمصيطر} بالصاد، وهذه رواية الهاشمي. وأما رواية الموصلي والبخاري فبالصاد في الحرفين، والصحيح والصواب رواية الهاشمي لأنه كذلك في مصاحف أهل مكة. وهذا يدل على أن أبا بكر الهاشمي كان أعملهم بهذه القراءة وأضبطهم لها وأتقنهم وأثبتهم فيها. وقرأ ابن عامر {المصيطرون} و {بمصيطر} بالسين في الحرفين.(@)(@@) PageV01P416(@)(@@) وقرأ حمزة بإشمام الزاي فيهما. إلا برواية العجلي فإنه بالصاد فيهما. وقرأ الباقون بالصاد فيهما. واختلف عن محمد بن حبيب عن الأعشى. فكان النقار يأخذ بالصاد مثل رواية البرجمي عن أبي بكر ومحمد بن غالب عن الأعشى. وكان حماد يأخذ بالسين.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن عامر ويعقو 
ms173	 وعاصم {يومهم الذي فيه يصعقون} [45] بضم الياء.(@)(@@) وقرأ الباقون {يصعقون} بفتح الياء.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ زيد عن يعقوب {وإدبار النجوم} [49] بفتح الألف. والباقون بكسرها.(@)(@@) PageV01P417(@)(@@)(@@)(@@) | سورة النجم(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ حمزة والكسائي وخلف بكسر أواخر آيات هذه السورة كلها، وجميع أشباهها. وقرأ أبو جعفر ونافع وأبو عمرو بين الفتح والكسر وإلى الفتح أقرب وكذلك كل سورة رؤوس آياتها على الياء مثل "سورة طه والنجم والليل والضحى" وكذلك "والشمس وضحاها" وأشباهها. وكل ما كان على وزن فعلى أو فعلى أو فعلى في جميع القرآن فإن أبا عمرو يقرؤها بين الفتح والكسر في رواية شجاع وأكثر الروايات عن اليزيدي.(@)(@@) والذي قرأته وأخذته عن المشايخ والأئمة لفظا فالفتح: فتح مستحسن لا إفراط فيه ولا تفخيم. وكذلك قال البخاري وغيره: "لا أدري بين الفتح والكسر ما هو. إنما أمرونا ألا نفتح فتحا شديدا.(@)(@@) PageV01P418(@)(@@) والباقون يفتحونها: وابن كثير وعاصم أشد فتحا وتفخيما في ذلك كله. وجميع أشباهه إلا ما رواه يحيى عن أبي بكر من كسر {رأى}. وحماد عن عاصم لا يكسر {رأى} ههنا لأنه يفتح السورة كلها.(@)(@@) وكذلك ابن عامر يفتح ههنا ولا يكسر. هكذا قرأنا وأخذ علينا لابن عامر، وحماد عن عاصم.(@)(@@) ويعقوب أيضا مذهبه الفتح في جميع ذلك. وقد ذكرنا باب التفخيم والإمالة في أول الكتاب. وأعدنا هذا المقدار ههنا زائدة في الشرح والبيان إذ هو موضعه. وبالله التوفيق.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر وهشام {ما كذب الفؤاد} [11] مشددة الذال. وقرأ الباقون {ما كذب} خفيفة الذال.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ حمزة والكسائي ويعقوب وخلف {أفتمارونه على ما يرى} [12] بفتح التاء وسكون الميم من غير ألف. وقرأ الباقون {أفتمارونه} بالألف وضم التاء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ ابن كثير، ومحمد بن حبيب الشموني عن الأعشى، {ومناة الثالثة} [20] ممدودة مهموزة. وقرأ الباقون، ومحمد بن غالب عن الأعشى. والبرجمي ويحيى: عن أبي بكر {ومناة} بغير مد ولا همز.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن كثير في رواية القواس والبزي {تلك إذا قسمة ضيزى} [22] مهموزة. وقرأ الباقون، وابن فليح عن ابن كثير {ضيزى} بغير 
ms174	 همز.(@)(@@) PageV01P419(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ أبو جعفر ونافع وأبو عمرو ويعقوب {عادا الأولى} [50] مدغمة غير منونة ولا مهموزة إلا في رواية قالون عن نافع وحده، فإنه روى عنه مدغمة مهموزة ساكنة وروى أبو نشيط عن قالون: غير مهموزة.(@)(@@) وقرأ الباقون {عادا الأولى} منونة مهموزة غير مدغمة.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ عاصم وحمزة ويعقوب {وثمود فما أبقى} [51] بغير تنوين. وقرأ الباقون {وثمود} منونة.(@)(@@) واختلف عن أبي بكر عن عاصم فيه: فرواه محمد بن غالب عن الأعشى {وثمود} منونة مثل رواية عبد الحميد بن صالح البرجيم عن أبي بكر. ورواية محمد بن حبيب عن الأعشى {وثمود} بغير تنوين مثل رواية يحيى عن أبي بكر.(@)(@@) PageV01P420(@)(@@)(@@)(@@) | سورة القمر(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر وحده {وكل أمر مستقر} [3] بالخفض. وقرأ الباقون {مستقر} بالرفع.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن كثير وحده {إلى شيء نكر} [6] ساكنة الكاف وقرأ الباقون {نكر} بضم الكاف.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وابن عامر وعاصم {خشعا أبصارهم} [7] بضم الخاء وفتح الشين مشددة. وقرأ أبو عمرو وحمزة والكسائي ويعقوب وخلف {خاشعا} بالألف وكسر الشين.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر وابن عامر ويعقوب {ففتحنا أبواب السماء} [11] مشددة التاء وقرأ الباقون {ففتحنا} خفيفة.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ ابن عامر وحمزة {سيعلمون غدا} [26] بالتاء. وقرأ الباقون {سيعلمون} بالياء.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ يعقوب {سيهزم} [45] بالنون وكسر الزاي {الجمع} بالنصب. وقرأ الباقون، ورويس عن يعقوب،(@)(@@) PageV01P421(@)(@@) والضرير عن روح، وزيد وغيره عن يعقوب {سيهزم} بضم الياء وفتح الزاي {الجمع} بالرفع.(@)(@@) اثبات الياءات(@)(@@) قرأ أبو جعفر ونافع، وابن كثير في رواية القواس والبزي، وأبو عمرو ويعقوب {يوم يدع الداع} [6] و {مهطعين إلى الداع} [8] باثبات الياء فيهما في الوصل.(@)(@@) ابن كثير ويعقوب في الوصل والوقف.(@)(@@) قالون عن نافع {يوم يدع الداع} بغير ياء، و {مهطعين إلى الداع} بالياء وهكذا روى بعضهم عن قنبل لابن كثير، وليس ذلك عند أكثرهم بصحيح والله أعلم به.(@)(@@) وقرأ ابن عامر، وابن كثير في رواية ابن فليح، وعاصم وحمزة والكسائي وخلف بغير ياء فيهما في الوصل والوقف.(@)(@@) قرأ ورش عن نافع 
ms175	 {نذيري} و {نذري} [16 و18 و21 و30 و37 و39] و {نكيري} و {وعيدي} حيث كان باثبات الياء في الوصل كل القرآن.(@)(@@) وقرأ يعقوب ذلك كله وكل ما أشبهه في جميع القرآن باثبات الياء في الوصل والوقف. وقرأ الباقون بحذف الياء فيهما وصلا ووقفا. والله أعلم.(@)(@@) PageV01P422(@)(@@)(@@)(@@) | سورة الرحمن جل ذكره(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ ابن عامر {والحب ذو العصف والريحان} [12] بالنصب فيها. وقرأ الباقون {والحب ذو العصف} بالرفع.(@)(@@)(@@)(@@) | 2 - (@)(@@) وقرأ حمزة والكسائي وخلف {والريحان} بالخفض. وقرأ الباقون {والريحان} بالرفع إلا ابن عامر فإنه قرأ بالنصب كما ذكرته.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر ونافع وأبو عمرو ويعقوب {يخرج منهما اللؤلؤ} [22] بضم الياء وفتح الراء. وقرأ الباقون {يخرج منهما} بفتح الياء وضم الراء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر، وأبو بكر عن عاصم، وشجاع عن أبي عمرو {اللؤلؤ} بترك همزته الأولى في جميع القرآن. وقد ذكرته. وقرأ الباقون بالهمز فيه كل القرآن.(@)(@@) PageV01P423(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ حمزة {وله الجوار المنشآت} [24] بكسر الشين. وقرأ الباقون {المنشآت} بفتح الشين. وروي عن يحيى عن أبي بكر بكسر الشين وفتحه. وأنا قرأته بكسر الشين على أبي الحسن الخياط في رواية شعيب الصريفيني عن يحيى.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ حمزة والكسائي وخلف {سنفرغ لكم أيه الثقلان} [31] بالياء وقرأ الباقون {سنفرغ} بالنون.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ ابن كثير {يرسل عليكما شواظ} [35] بكسر الشين. وقرأ الباقون {شواظ} بضم الشين.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ ابن كثير وأبو عمرو {من نار ونحاس} [35] بالخفض. وقرأ الباقون {ونحاس} بالرفع.(@)(@@)(@@)(@@) | 9 - (@)(@@) وروى محمد بن حبيب الشموني عن الأعشى. ورويس عن يعقوب: {من إستبرق} [54] بكسر النون ووصل الألف، مثل رواية ورش عن نافع. وقرأ الباقون بقطع الألف.(@)(@@)(@@)(@@) | 10 - (@)(@@) وكلهم قرؤوا {لم يطمثهن إنس} [56 و74] بكسر الميم في الحرفين إلا الكسائي فإنه كان يكسر الميم في أحدهما، ويضمه في الآخر وقال أبو حمدون عن الكسائي: الأول {لم يطمثهن} بضم الميم والثاني بكسر الميم.(@)(@@) وعن أبي الحارث عن الكسائي إنه بكسر الأول وضم الثاني(@)(@@) PageV01P424(@)(@@) وروى عنه ضم الأول وكسر الثاني مثل رواية أبي حمدون وأما رواية 
ms176	 قتيبة، وأبي عمر الدورى ونصير عنه فإنهم قالوا: لا يبالي كيف قرأ: إذا ضم الأول كسر الثاني. وإذا كسر الأول ضم الثاني، بعد ألا يجمع بينهما.(@)(@@)(@@)(@@) | 11 - (@)(@@) قرأ ابن عامر وحده {تبارك اسم ربك ذي الجلال} [78] بالواو وكذلك في مصاحف الشام: {ذي الجلال}. وقرأ الباقون {ذي الجلال} بالياء والله أعلم.(@)(@@) PageV01P425(@)(@@)(@@)(@@) | سورة الواقعة(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر وحمزة والكسائي {وحور عين} [22] بالخفض. وقرأ الباقون {وحور عين} بالرفع.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {لا يصدعون عنها ولا ينزفون} [19] بكسر الزاي. وقرأ الباقون {ينزفون} بفتح الزاي.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ نافع في رواية إسماعيل، وعاصم في رواية حماد(@)(@@) PageV01P426(@)(@@) ويحيى عن أبي بكر، وحمزة وخلف {عربا أترابا} [37] ساكنة الراء. وقرأ الباقون {عربا} بضم الراء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر ونافع والكسائي ويعقوب {وكانوا يقولون أئذا متنا وكنا ترابا وعظاما} [47] مستفهما: أبو جعفر، وقالون عن نافع، وزيد عن يعقوب بهمزة مطولة. ونافع ويعقوب بهمزة واحدة غير مطولة، والكسائي بهمزتين. {أإنا لمبعوثون} [47] و {إنا لمغرمون} [66] بكسر الألف غير مستفهم.(@)(@@) ابن كثير يستفهم فيهما جميعا بهمزة واحدة غير ممودة.(@)(@@) أبو عمرو يستفهم فيهما بهمزة واحدة ممدودة.(@)(@@) وابن عامر وعاصم وحمزة وخلف يستفهمون فيهما بهمزتين همزتين. وقد بينا هذا في غيرموضع وذكرنا أن بن عامر لا يجمع بين استفهامين إلا هاهنا.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ أبو جعفر ونافع وعاصم وحمزة {فشاربون شرب الهيم} [55] بضم الشين. وقرأ الباقون {شرب} بفتح الشين.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ ابن كثير {نحن قدرنا بينكم الموت} [60] خفيفة الدال. وقرأ الباقون {نحن قدرنا} مشددة الدال.(@)(@@) PageV01P427(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ أبو بكر عن عاصم {إنا لمغرمون} [66] بهمزتين. وقرأ الباقون {إنا} بكسر الألف.(@)(@@)(@@)(@@) | 8 - (@)(@@) وقرأ حمزة والكسائي وخلف {فلا أقسم بمواقع النجوم} [75] بغير ألف وقرأ الباقون {بمواقع} بالألف.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ يعقوب {فروح وريحان} [89] بضم الراء كما روي عن ابن عباس والحسن وقتادة وغيرهم.(@)(@@) وقرأ الباقون {فروح وريحان} بفتح الراء.(@)(@@) PageV01P428(@)(@@)(@@)(@@) | سورة الحديد(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو عمرو وحده {وقد أخذ} [8] بضم الألف وكسر الخاء {ميثاقكم} بالرفع وقرأ الباقون {أخذ} 
ms177	 بفتح الألف والخاء {ميثاقكم} بالنصب.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن عامر وحده {وكلا وعد الله الحسنى} [10] بالرفع. وقرأ الباقون {وكلا} بالنصب.(@)(@@) - {فيضاعفه} [11] ذكرته في سورة البقرة.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ حمزة وحده {للذين آمنوا انظرونا} [13] بقطع الألف وكسر الظاء. وقرأ الباقون {للذين آمنوا انظرونا} بوصل الألف وضم الظاء.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر وابن عامر ويعقوب {فاليوم لا يؤخذ منكم} [15] بالتاء.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ نافع، وحفص عن عاصم، {وما نزل من(@)(@@) PageV01P429(@)(@@) الحق} [16] خفيفة الزاي. وقرأ الباقون {وما نزل} مشددة الزاي.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ رويس عن يعقوب {ولا يكونوا كالذين} [16] بالتاء مثل قراءة يحيى بن يعمر وقرأ الباقون {ولا يكونوا} بالياء.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ ابن كثير، وأبو بكر عن عاصم، {إن المصدقين والمصدقات} [18] خفيفة الصاد في الحرفين. وقرأ الباقون {إن المصدقين والمصدقات} مشددة الصاد فيهما.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ أبو عمرو وحده {ولا تفرحوا بما آتاكم} [23] مقصورة الألف. وقرأ الباقون {بما آتاكم} ممدودة الألف.(@)(@@)(@@)(@@) | 9 - (@)(@@) قرأ حمزة والكسائي وخلف {ويأمرون الناس بالبخل} [24] بفتح الباء والخاء.(@)(@@) وقرأ الباقون {بالبخل} بضم الباء وسكون الخاء. وقد ذكرته في سورة "النساء".(@)(@@)(@@)(@@) | 10 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {فإن الله هو الغني الحميد} [24] بغير {هو}. وكذلك هو في مصاحفهم. وقرأ الباقون {فإن الله هو الغني الحميد} بزيادة {هو}. والله أعلم.(@)(@@) PageV01P430(@)(@@)(@@)(@@) | سورة المجادلة(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر وابن عامر وحمزة والكسائي وخلف {الذين يظاهرون منكم} [2] بالألف وتشديد الظاء.(@)(@@) وقرأ نافع وابن كثير وابو عمرو ويعقوب الذين يظاهرون} بتشديد الظاء والهاء من غير ألف.(@)(@@) وقرأ عاصم {الذين يظاهرون} بضم الياء وتخفيف الظاء وكسر الهاء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر {ما يكون من نجوى} [7] بالتاء. وقرأ الباقون {ما يكون} بالياء.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ يعقوب {ولا أكثر} [7] بالرفع. وقرأ الباقون {ولا أكثر} بالنصب.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ حمزة، ويعقوب برواية رويس {ويتناجون بالإثم} [8] بالنون والتاء وضم الجيم من غير ألف. وقرأ الباقون {ويتناجون} بالتاء والنون والألف وفتح الجيم.(@)(@@)(@@)(@@) | 5 - (@)(@@) قرأ يعقوب برواية رويس {فلا تتناجوا} [9] بالنون(@)(@@) PageV01P431(@)(@@) والتاء وضم الجيم من غير ألف وقرأ الباقون {فلا تتناجوا} بالتاء والنون والألف. 
ms178	 وفتح الجيم في الحرفين.(@)(@@)(@@)(@@) | 6 - (@)(@@) قرأ عاصم {تفسحوا في المجالس} [11] بالألف على الجمع، وقرأ الباقون {في المجالس} بغير ألف على واحدة.(@)(@@)(@@)(@@) | 7 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {وإذا قيل انشزوا فانشزوا} [11] بضم الشين وقرأ الباقون وحماد بكسر الشين. واختلف عن يحيى عن أبي بكر فرواه ابن سعدان وشعيب بن أيوب عن يحيى عن أبي بكر بكسر الشين، وكذلك قرأه في هذه الرواية. وقال خلف وأبو هشام وغيرهما عن يحيى عن أبي بكر إنه لم يحفظ عن عاصم كيف قرأ.(@)(@@)(@@)(@@) | 8 - (@)(@@) قرأ محمد بن حبيب الشموني وحده عن الأعشى عن أبي بكر {أو عشيرتهم} [22] بالألف وكسر التاء على الجمع، وقرأ الباقون، ومحمد بن غالب عن الأعشى، والبرجمي وغيره عن أبي بكر {أو عشيرتهم} بغير ألف، وفتح التاء.(@)(@@) [فتح الياءات](@)(@@) قرأ أبو جعفر ونافع وابن عامر {أنا ورسلي} [21] بفتح الياء. وقرأ الباقون {أنا ورسلي} ساكنة الياء. والله أعلم.(@)(@@) PageV01P432(@)(@@)(@@)(@@) | سورة الحشر(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو عمرو وحده {يخربون بيوتهم} [2] بفتح الخاء وتشديد الراء. وقرأ الباقون {يخربون} ساكنة الخاء خفيفة الراء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر {كي لا يكون} [7] بالتاء {دولة} بالرفع. وقرأ الباقون {يكون} بالياء {دولة} بالنصب.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ ابن كثير وأبو عمرو {أو من وراء جدر} [14] بالألف وكسر الجيم على واحدة. وقرأ الباقون {من وراء جدر} بغير ألف، وضم الجيم والدال على الجمع.(@)(@@) [فتح الياءات](@)(@@) فتح أبو جعفر ونافع وابن كثير وأبو عمرو {إني أخاف الله} [16] ولم يفتح الآخرون شيئا. والله أعلم.(@)(@@) PageV01P433(@)(@@)(@@)(@@) | سورة المودة(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو {يوم القيامة يفصل بينكم} [3] بضم الياء وسكون الفاء وفتح الصاد خفيفة. وقرأ حمزة والكسائي وخلف {يفصل بينكم} بضم الياء وفتح الفاء وكسر الصاد مشددة. وقرأ عاصم ويعقوب {يفصل بينكم} بفتح الياء وسكون الفاء وكسر الصاد خفيفة. وقرأ ابن عامر {يفصل} بضم الياء وفتح الفاء والصاد مشددة.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو عمرو ويعقوب {ولا تمسكوا} [10] بفتح الميم وتشديد السين وقرأ الباقون {ولا تمسكوا} ساكنة 
ms179	 الميم خفيفة السين.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ عاصم وحده {أسوة} بضم الألف وقرأ الباقون {أسوة} [4] بكسر الألف. وقد مر ذكره. والله أعلم.(@)(@@) PageV01P434(@)(@@)(@@)(@@) | سورة الصف(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو جعفر ونافع وأبو عمرو وابن عامر، وأبو بكر عن عاصم، ويعقوب {والله متم نوره} [8] [{متم}] منونة {نوره} بالنصب. وقرأ ابن كثير وحمزة والكسائي، وحفص عن عاصم، وخلف {والله متم} غير منون {نوره} بالخفض على الإضافة.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ ابن عامر وحده {هل أدلكم على تجارة تنجيكم} [10] بفتح النون وتشديد الجيم وقرأ الباقون {تنجيكم} ساكنة النون خفيفة الجيم.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو {يا أيها الذين آمنوا كونوا أنصار} [14] منونة {الله} بغير ألف. وقرأ الباقون {كونوا أنصار} بغير تنوين والألف في {الله} على الإضافة.(@)(@@) [فتح الياءات](@)(@@) قرأ أبو جعفر ونافع وابن كثير وأبو عمرو، وأبو بكر عن عاصم، {يأتي من بعدي اسمه أحمد} [6] بفتح الياء، وقرأ الباقون {من بعدي اسمه أحمد} غير مفتوح.(@)(@@) وروى الضرير بفتح الياء وكلهم يقفون {من بعدي} باثبات الياء. {سحر مبين} [6] ذكرته في سورة المائدة ويونس.(@)(@@) PageV01P435(@)(@@) وفتح أبو جعفر ونافع {من أنصاري إلى الله} [14] ولم يفتحه الآخرون. والله أعلم. بجميع ذلك.(@)(@@)(@@)(@@) | سورة الجمعة(@)(@@) بسم الله الرحمن الرحيم(@)(@@) ليس بينهم اختلاف، ولا شيء في هذه السورة إلا وقد مر ذكره والله أعلم.(@)(@@)(@@)(@@) | سورة المنافقين(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ أبو عمرو والكسائي {كأنهم خشب مسندة} [4] ساكنة الشين. وقرأ الباقون {خشب} بضم الشين. وذكر بعضهم لابن كثير {خشب} خفيفة أيضا، وليس يصج ذلك. والله أعلم.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ نافع، وروح وزيد عن يعقوب، {لووا رءوسهم} [5] خفيفة الواو. وقرأ الباقون {لووا} مشددة الواو.(@)(@@) PageV01P436(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو عمرو وحده {فأصدق وأكن} [10] بالواو وفتح النون.(@)(@@) وقرأ الباقون {فأصدق وأكن} بغير واو وجزم النون.(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ عاصم في رواية حماد ويحيى عن أبي بكر {والله خبير بما تعملون} [11] بالياء. وقرأ الباقون بالتاء. والله أعلم.(@)(@@)(@@)(@@) | سورة التغابن(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ يعقوب برواية رويس {يوم يجمعكم} [9] بالنون. وقرأ الباقون {يوم 
ms180	 يجمعكم} بالياء.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {يكفر عنه سيئاته ويدخله جنات} [9] بالنون فيهما. وقرأ الباقون {يكفر عنه سيئاته ويدخله} بالياء فيهما.(@)(@@) PageV01P437(@)(@@)(@@)(@@) | سورة الطلاق(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ حفص عن عاصم {إن الله بالغ أمره} [3] غير منون، بالخفض على الإضافة. وقرأ الباقون {إن الله بالغ} بالتنوين {أمره} بالنصب.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ يعقوب في رواية روح، مختلفا عنه، {من حيث سكنتم من وجدكم} [6] بكسر الواو كما روي عن عيسى بن عمر وزيد بن علي وغيرهما. والقراء على {وجدكم} بضم الواو، وهو الأكثر والأشهر في القراءة واللغة. وفتح الواو أيضا كثير، وكسرها أقلها. والله أعلم.(@)(@@) - {واللائي} [4] ذكرته في سورة "الأحزاب".(@)(@@) - {وكأين} [8] ذكرته في سورة "آل عمران".(@)(@@) - {نكرا} [8] ذكرته في سورة "الكهف".(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ أبو جعفر ونافع وابن عامر {ومن يؤمن بالله ويعمل صالحا يدخله} [11] بالنون. وقرأ الباقون {يدخله} بالياء.(@)(@@) PageV01P438(@)(@@)(@@)(@@) | 4 - (@)(@@) قرأ أبو جعفر ونافع وأبو عمرو ويعقوب {بفاحشة مبينة} [1] بكسر الياء [و] في آخرها {آيات الله مبينات} [11] بفتح الياء فيها.(@)(@@) وقرأ ابن كثير وأبو بكر عن عاصم {بفاحشة مبينة} و {آيات الله مبينات} بفتح الياء فيهما.(@)(@@) وقرأ ابن عامر وحمزة والكسائي، وحفص عن عاصم، وخلف: {بفاحشة مبينة} و {آيات الله مبينات} بكسر الياء فيهما.(@)(@@) وكذلك يقرؤون في جميع القرآن. وقد ذكرته في سورة النساء والله أعلم.(@)(@@) PageV01P439(@)(@@)(@@)(@@) | سورة التحريم(@)(@@) بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) | 1 - (@)(@@) قرأ الكسائي وحده {عرف بعضه} [3] خفيفة الراء. وقرأ الباقون {عرف بعضه} مشددة الراء.(@)(@@) واختار أبو بكر بن عياش {عرف بعضه} خفيفة الراء أيضا. وهو من الحروف العشرة التي ذكرت أنه قال: "أنا أدخلتها من قراءة علي - رضي الله عنه - في قراءة عاصم حتى استخلصت قراءته". يعني قراءة علي بن أبي طالب عليه السلام.(@)(@@)(@@)(@@) | 2 - (@)(@@) قرأ عاصم وحمزة والكسائي وخلف {وإن تظاهرا عليه} [4] خفيفة الظاء وقرأ الباقون {تظاهرا} مشددة الظاء.(@)(@@)(@@)(@@) | 3 - (@)(@@) قرأ عاصم في رواية حماد ويحيى عن أبي بكر {يا أيها الذين آمنوا توبوا إلى الله توبة نصوحا} [8] بضم النون. وقرأ الباقون {توبة نصوحا} بفتح النون. 