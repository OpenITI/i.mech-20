ms41	 كسب % 20(@)(@@) % فتى لم يدع للمعروف إلا % ونائله لداعيه الملبي % % PageV01P136 21(@)(@@) % فداؤك كل ممنوع جداه % ضنين بل فداؤك كل ندب % 22(@)(@@) % فكم قربت حظي بعد نأي % وباعدت النوائب بعد قرب % 23(@)(@@) % إذا ما كنت من عشاق حمدي % % أدل وزار مجدك غير غب % 24(@)(@@) % ومثلك حل بذل الجود منه % محل هوى الحبيب من المحب % PageV01P137 البحر : وافر تام 1(@)(@@) % وإني للزمان لذو نضال % فبي من حد أسهمه كلوم % 2(@)(@@) % وسلاني عن الأحباب دهر % يضيم الحر حادثه الغشوم % 3(@)(@@) % فقد أصبحت لا تجري دموعي الط % لول ولا تهيجني الرسوم % PageV01P138 البحر : كامل تام 1(@)(@@) % يا حسنها صفراء ذات تلهب % كالنار إلا أنها لا تلفح % 2(@)(@@) % عاطيتنيها والمزاج يروضها % % وكأنها في الكأس طرف يجمح % 3(@)(@@) % وتضوعت مسكية فكأنها % % من نشر عرضك أو ثنائك تنفح % PageV01P139 البحر : طويل 1(@)(@@) % إذا عز نفسي عن هواك قصورها % % فمثل النوى يقضي علي يسيرها % % 2(@)(@@) % وهل غادر الهجران إلا حشاشة % لنفس بأدنى لوعة يستطيرها % % 3(@)(@@) % هوى ونوى يستقبح الصبر فيهما % % وحسبك من حال يذم صبورها % % 4(@)(@@) % وقد كنت أرجو أن تماسك مهجتي % % وأنك من جور الفراق مجيرها % % 5(@)(@@) % فما كان إلا غرة ما رجوته % إلا شر ما أردى النفوس غرورها % % 6(@)(@@) % وإني لرهن الشوق والشمل جامع % فكيف إذا حث الحداة مسيرها % % 7(@)(@@) % وما زلت من أسر القطيعة باكيا % فمن لي غداة البين أني أسيرها % % 8(@)(@@) % وكنت أرى أن الصدود منية % يكون مع الليل التمام حضورها % % 9(@)(@@) % فلما قضى التفريق بالبعد بيننا % % وجدت الليالي كان حلوا مريرها % % 10(@)(@@) % أعد سروري أن أراك بغبطة % وأنفس ما يهدى لنفس سرورها % % PageV01P140 11(@)(@@) % كفى حزنا أني أبيت معذبا % بنار هموم ليس يخبو سعيرها % % 12(@)(@@) % وأن عدوي لا يراع وأنني % % أبيت سخين العين وهو قريرها % % 13(@)(@@) % تعاف النفوس المر من ورد عيشها % % وتكره حتى يستمر مريرها % % 14(@)(@@) % ولا والقوافي السائرات إذا غلت % بحكم الندى عند الكرام مهورها % % 15(@)(@@) % لئن أنا لم يمنع حماي انتصارها % % ويثني أذى العادين عني نكيرها % % 16(@)(@@) % فلا ظل يوما مصحبا لي أبيها % % ولا 
ms42	 بات ليلا آنسا بي نفورها % % 17(@)(@@) % قطعت صدور العمر لم أدر لذة % وغفلة عيش كيف كان مرورها % % 18(@)(@@) % ولما رماني الدهر غدت بدولة % جلا الحادثات الفادحات منيرها % % 19(@)(@@) % وكيف يخاف الدهر رب محامد % غدا كرم المنصور وهو نصيرها % % 20(@)(@@) % إلى عضد الملك امتطيت غرائبا % محرمة إلا علي ظهورها % % PageV01P141 21(@)(@@) % إلى ملك تعنو الملوك لبأسه % ويقصر يوم الفخر عنه فخورها % % 22(@)(@@) % أعمهم غيثا إذا بخل الحيا % % وأطعنهم والخيل تدمى نحورها % % 23(@)(@@) % إلى حيث تلقى الجود هينا مرامه % لباغيه والحاجات سهلا عسيرها % % 24(@)(@@) % لدى ملك ما انفك من مكرماته % موارد يصفو عذبها ونميرها % % 25(@)(@@) % يزيد على غول الطروق صفاؤها % % وينمي على طول الورود عزيرها % % 26(@)(@@) % أغر لو أن الشمس يحظى جبينها % % ببهجته ما كان يكسف نورها % % 27(@)(@@) % غني العلى من كل فضل وسؤدد % ولكنه من كل مثل فقيرها % % 28(@)(@@) % يعد المنايا مستساغا كريهها % % وبيض العطايا مستقلا كثيرها % % 29(@)(@@) % سقى الله أيام المؤيد ما سقت % حوافل مزن لا يغب مطيرها % % 30(@)(@@) % فما نقلت جرداء سابحة له % شبيها ولا وجناء يقلق كورها % % PageV01P142 31(@)(@@) % سقى هذه الدنيا من العدل ريها % % فأصبح لا يخشى الذواء نضيرها % % 32(@)(@@) % وهب له فيها نسيم غضارة % من العيش حتى عاد بردا هجيرها % % 33(@)(@@) % عفو فما عانيت زلة مجرم % لجى عفوه إلا صغيرا كبيرها % % 34(@)(@@) % له الرأي والبأس اللذان تكفلا % % لأعدائه أوحى حمام يبيرها % % 35(@)(@@) % سيوف من التدبير والفتك لم يزل % ومغمدها في كفه وشهيرها % % 36(@)(@@) % رأى أرض صور نهبة لمغالب % ينازلها يوما ويوما يغيرها % % 37(@)(@@) % تداركها والنصر في صدر سيفه % أخو عزمات لا يخاف فتورها % % 38(@)(@@) % همام إذا ما حل يوما ببلدة % فخندقها حد الحسام وسورها % % 39(@)(@@) % وسمر من الخطي لا ترد الوغى % % فتحطم إلا في الصدور صدورها % % 40(@)(@@) % ارى أمراء الملك للفخر غاية % وأنت إذا عد الفخار أميرها % % PageV01P143 41(@)(@@) % وما زلت تسمو للعلاء بهمة % تقل لك الدنيا بها كيف صورها % % 42(@)(@@) % وأقسم لو حاولت قدرك في العلى % % لما آثرت عنك السماء بدورها % % 43(@)(@@) % وإن بلادا أنت حائط ثغرها % % بسيفك 
ms43	 قد عزت وعز نظيرها % % 44(@)(@@) % فسعدا لأملاك عليك اعتمادها % % وفخرا لأيام إليك مصيرها % % 45(@)(@@) % لقد عطر الدنيا ثناءك فانثنى % % به ذا كساد مسكها وعبيرها % % 46(@)(@@) % فتاهت بذكراه البلاد وأهلها % % وهبت برياه الصبا ودبورها % % 47(@)(@@) % ملأت به الآفاق طيبا متى دعا % % إلى نشره الآمال خف وقورها % % 48(@)(@@) % فجئتك ذا نفس يقيدها الجوى % % وقد كاد حسن الظن فيك يطيرها % % 49(@)(@@) % رميم أزجيها إليك لعله % يكون بنعمى راحتيك نشورها % % 50(@)(@@) % ولست بشاك مدة الخطب بعدها % % وأول إفضائي إليك أخيرها % % PageV01P144 البحر : وافر تام 1(@)(@@) % أبا حسن لئن كانت أجابت % هباتك مطلبي قبل الدعاء % 2(@)(@@) % لما ضاع اصطناعك في كريم % ملي حين تقرض بالجزاء % 3(@)(@@) % سأثني بالذي أوليت جهدي % % ويثني السامعون على ثنائي % % 4(@)(@@) % وكيف جحود معروف توالى % % فكان من الخطوب دواء دائي % % 5(@)(@@) % أأجحد منة بدأت وعادت % إذن فعدلت عن سنن الوفاء % 6(@)(@@) % سبقت إلى جميل الصنع ظني % % وقرطس جود كفك في رجائي % % 7(@)(@@) % وكان نداك حين يسير نحوي % % جنيبا للمودة والصفاء % 8(@)(@@) % فما أدري أأشكر منك قصدي % % بجودك واصطناعك أم إخائي % % 9(@)(@@) % أبت أخلاقك الغر اللواتي % % أحب إلى النفوس من البقاء % 10(@)(@@) % وكونك والسماح إليك أشهى % % من الماء الزلال إلى الظماء % PageV01P145 11(@)(@@) % سوى كرم ومعروف وحلم % وضرب في التكرم والسخاء % 12(@)(@@) % وقد أسست بالميعاد شكري % % وما بعد الأساس سوى البناء % 13(@)(@@) % فإن تسمح يداك فلا عجيب % ومن ذا منكر قطر السماء % PageV01P146 البحر : مجزوء الكامل 1(@)(@@) % كم ذا التجنب والتجني % % كم ذا التحامل والتعدي % % 2(@)(@@) % أتظنني لا أستطي % % ع أحيل عنك الدهر ودي % % 3(@)(@@) % من ظن أن لا بد من % ه فإن منه ألف بد % PageV01P147 البحر : رجز تام 1(@)(@@) % يحتاج في الشعر إلى طلاوه % والشعر ما لم يك ذا حلاوه % 2(@)(@@) % فإنما سماعه شقاوه % % PageV01P148 البحر : سريع 1(@)(@@) % ليت الذي قلبي به مغرم % يعلم من وجدي كما أعلم % 2(@)(@@) % لعله إن لم يصل رغبة % يرق للمكروب أو يرحم % 3(@)(@@) % أذلني حبكم في الهوى % % فما حمتني ذلتي منكم % 4(@)(@@) % ومذهب ما زال مستقبحا % في الحرب أن 
ms44	 يقتل مستسلم % PageV01P149 البحر : كامل تام 1(@)(@@) % أبلغ أبا الفضل الذي شهدت % بالفضل منه البدو والحضر % 2(@)(@@) % العذر عندك لا يسوغ ولي % % في أن أطيل عتابك العذر % 3(@)(@@) % أيجوز في حكم المروءة أن % أظما ودون سماحك البحر % 4(@)(@@) % والسبت من شرط المدام ولا % % سيما وثوب زمانه القر % 5(@)(@@) % ولدي بدر لو تأمله % يوما لتاه بحسنه البدر % 6(@)(@@) % لا البذل شيمته ولا لفتى % % عرف الهوى عن مثله صبر % 7(@)(@@) % في خلقه سرس وليس يرى % % إلا التمنع منه والهجر % 8(@)(@@) % فابعث لنا خمرا يراض بها % % فعسى يذلل صعبه الخمر % 9(@)(@@) % والسكر قد ضمن الوصال لنا % % ولكم وفى بضمانه السكر % 10(@)(@@) % سارع إلى كرم يحاز به ال % % شكر الجميل ويعدم الأجر % PageV01P150 البحر : خفيف تام 1(@)(@@) % صرت بين الصادين يابن المجلي % % بين صفع يوهي قفاك وصرف % 2(@)(@@) % بعد باءين من بغاء وبرد % حلف ضادين فيك ضر وضعف % 3(@)(@@) % ثم شينين شؤم جد وشعر % لمغيض فيه ينابيع كنف % 4(@)(@@) % قرن عينين عدم عقل ومال % وعمى عاجل بوقع الأكف % 5(@)(@@) % وستأتي الفاءان فقدك بل فق % بل فقرك إثر الحاءين حرف وحتف % 6(@)(@@) % وإذا ما السينات حزنك يا حز % ن ذوي الصرف قمت من غير حلف % 7(@)(@@) % سفه في سفالة في سقوط % دائم في سواد وجه وسخف % PageV01P151 البحر : بسيط تام 1(@)(@@) % وافى كتابك أسنى ما يعود به % وفد المسرة مني إذ يوافيني % % 2(@)(@@) % فظلت أطويه من شوق وأنشره % والشوق ينشرني فيه ويطويني % % PageV01P152 البحر : طويل 1(@)(@@) % أيا بين ما سلطت إلا على ظلمي % % ويا حب ما ابقيت مني سوى الوهم % 2(@)(@@) % فراق أتى في إثر هجر وما أذى % بأوجع من كلم أصاب على كلم % 3(@)(@@) % لقد كان لي في الوجد ما يقنع الضنى % % وفي الهجر ما يغنى به البين عن غشمي % % 4(@)(@@) % ولكن دهرا أثخنتني جراحه % إذا حز في جلدي ألح على عظمي % % 5(@)(@@) % وإن كنت ممن لا يذم سوى النوى % % فإن القلى والصد أجدر بالذم % 6(@)(@@) % وما من رمى من غير عمد فأقصدت % نوافذه كمن تعمد أن يرمي 
ms45	 % % 7(@)(@@) % فيا قلب كم تشقى بدان ونازح % فشاك إلى خصم وباك على رسم % 8(@)(@@) % وحتام أستشفي من الناس من به % سقامي وأستروي من الدمع ما يظمي % % 9(@)(@@) % غريمي بدين الحب هل أنت مقتضى % وهل لفؤاد أتلف الحب من غرم % 10(@)(@@) % أحن إلى سقمي لعلك عائدي % % ومن كلف أني أحن إلى السقم % PageV01P153 11(@)(@@) % وبي منك ما يردي الجليد وإنما % % لحبك أهوى أن يزيد وأن ينمي % % 12(@)(@@) % ويا لائمي أن بات يزري بي الهوى % % علي سفاهي لا عليك ولي حلمي % % 13(@)(@@) % أقلبك أم قلبي يصدع بالنوى % % وجسمك يضنى بالقطيعة أم جسمي % % 14(@)(@@) % ولا غرو أن أصبحت غفلا من الهوى % % فأنكرت ما بي للصبابة من وسم % 15(@)(@@) % ندوب بخدي للدموع كأنها % % فلول بقلبي من مقارعة الهم % 16(@)(@@) % وعائبتي أن الخطوب برينني % % ورب نحيف الجسم ذو سؤدد ضخم % 17(@)(@@) % رأت أثرا للنائبات كما بدا % % من العضب ما أبقى به الضرب من ثلم % % 18(@)(@@) % فلا تنكري ما أحدث الدهر إنما % % نوائبه أقران كل فتى قرم % 19(@)(@@) % ولا بد من وصل تسهل وعره % وغى تنتمي فيهاالسيوف إلى عزمي % % 20(@)(@@) % فرب مرام قد تعاطيت ورده % فما ساغ لي حتى أمر له طعمي % % PageV01P154 21(@)(@@) % وخيل تمطت بي وليل كأنه % ترادف وفد الهم أو زاخر اليم % 22(@)(@@) % شققت دجاه والنجوم كأنها % % قلائد نظمي أو مساعي أبي النجم % 23(@)(@@) % إليك يمين الملك واصلت شدها % % مقلقلة الأعلاق جائلة الحزم % 24(@)(@@) % غوارب أحيانا طوالع كلما % % هبطن فضا سهل علون مطا حزم % 25(@)(@@) % تميل بها الآمال عن كل مطمع % دنيء وتسمو للطلاب الذي يسمي % % 26(@)(@@) % تزور امرأ لا يجتنى ثمر الغنى % % بمثل نداه الغمر والنائل الجم % 27(@)(@@) % متى جئته والمعتفون ببابه % شهدت بنعمى كفه مصرع العدم % 28(@)(@@) % إلى مستبد بالفضائل قاسم % لهمته من نفسه أوفر القسم % 29(@)(@@) % تعد علاه من مناقب دهره % كعدك فضل الليل بالقمر التم % 30(@)(@@) % وكرمه عن أن يسب بمثله الز % مان كمال زين الجد بالفهم % PageV01P155 31(@)(@@) % وجود على العافي وذب عن العلى % % وصد عن الواشي وصفح عن الجرم % 32 
ms46	(@)(@@) % ورتبة من لم يجعل الحظ وحده % طريقا إلى العالي من الرتب الشم % 33(@)(@@) % تناولها استحقاقه قبل حظه % وحامى عليها والمقادر لم تحم % 34(@)(@@) % وغير بديع من بديع مشيد % لما شاده والفرع ينمى إلى الجذم % 35(@)(@@) % سقى الله عصرا حافظ ابن محمد % بما في ثغور الغانيات من الظلم % 36(@)(@@) % أغر إذا ما الخطب أعشى ظلامه % تبلج طلق الرأي في الحادث الجهم % 37(@)(@@) % ترق حواشي الدهر في ظل مجده % وتظرف منه شيمة الزمن الفدم % 38(@)(@@) % ويكبر قدرا أن يرى متكبرا % ويعظم مجدا أن يتيه مع العظم % 39(@)(@@) % ويكرم عدلا أن يميل به الهوى % % ويشرف نفسا أن يلذ مع الإثم % 40(@)(@@) % ويورد عن فضل عن نهى % ويصمت عن حلم وينطق عن علم % PageV01P156 41(@)(@@) % بديهة رأي في روية سؤدد % وإقدام عزم في تأيد ذي حزم % 42(@)(@@) % خلائق إن تحو الثناء بأسره % فما الفخر إلا نهبة الشرف الفخم % % 43(@)(@@) % أبر على الأقوام من شيبة الحيا % % وأشهر في الأيام من شيبة الدهم % 44(@)(@@) % أضاءت بك الأوقات والشمس لم تنر % وروضت الساحات والغيث لم يهم % 45(@)(@@) % وشدت أواخي الملك منك بأوحد % بعيد عرى العقد الوكيد من الفصم % 46(@)(@@) % فتى لا تصافي طرفه لذة الكرى % % ولا تطبي أجفانه خدع الحلم % 47(@)(@@) % يسهده تشييده المجد والعلى % % وتفريج غماء الحوادث والغم % 48(@)(@@) % وغير النجوم الزهر يألفها الكرى % % ويعدمها الإشراق في الظلم العتم % 49(@)(@@) % لقد شرف الأقلام مس أنامل % بكفك لا تخلو من الجود واللثم % 50(@)(@@) % فكل نحول في الظبى حسد لها % % وكل ذبول غيرة بالقنا الصم % PageV01P157 51(@)(@@) % وكنت إذا طالبت أمرا ممنعا % أفدت بها ما يعجز الحرب في السلم % 52(@)(@@) % كفيت الحسام الغضب فل غراره % وآمنت صدر السمهري من الحطم % 53(@)(@@) % وجاراك من لا فضل ينجد سعيه % وأي مرىء يبغي النضال بلا سهم % 54(@)(@@) % لك الذروة العلياء من كل مفخر % سني وما للحاسدين سوى الرغم % 55(@)(@@) % وكيف يرجي نيل مجدك طالب % وبينهما ما بين عرضك والوصم % 56(@)(@@) % لئن أوحدتني النائبات فإنني % % لمن سيبك الفياض في عسكر دهم % 57(@)(@@) % وإن لم 
ms47	 أفد غنما فقربك كافل % بأضعافه حسبي لقاؤك من غنم % 58(@)(@@) % هجرت إليك والعالمين محبة % ومثلك من يبتاع بالعرب والعجم % 59(@)(@@) % وما قل من ترتاح مدحي صفاته % ولكن رأيت الدر أليق بالنظم % 60(@)(@@) % أرى نيل أقوام وآبى امتنانهم % وليس تفي لي لذة الشهد بالسم % PageV01P158 61(@)(@@) % فهل لك أن تنتاشني بصنيعة % يلين بها عود الزمان على عجمي % % 62(@)(@@) % تحل محل الماء عندي من الثرى % % وأشكرها شكرا الرياض يدا الوسمي % % 63(@)(@@) % أقر ذوو الآداب طرا لمنطقي % % وغيرهم فيما حكى كاذب الزعم % 64(@)(@@) % فلست بمحتاج على ما ادعيته % إلى شاهد بعد اعتراف من الخصم % 65(@)(@@) % تطيع القوافي الآبيات قرائحي % % وينزل فيهن الكلام على حكمي % % 66(@)(@@) % وسيارة بكر قصرت عنانها % % فطالت به والخيل تمرح في اللجم % 67(@)(@@) % نمى ذكرها قبل اللقاء وإنما % % يسرك بوحي بالمحامد لاكتمي % % 68(@)(@@) % كمختومة الداري نم بفضلها % % إليك شذاها قبل فضك للختم % 69(@)(@@) % حديثة عصر كلما امتد دهرها % % سما فخرها حتى تطول على القدم % 70(@)(@@) % وما فضل بنت الكرم يوما ببين % إذا لم يطل عهد بنة الكرم بالكرم % PageV01P159 البحر : طويل 1(@)(@@) % أتاني أن المجد عني سائل % وأن العلى لم يعدني فيك عتبها % % 2(@)(@@) % فيا فخر شخص حل سرك ذكره % ويا سعد نفس سر مثلك قربها % % 3(@)(@@) % ولا عذر إلا أن لبا شدهنه % نوائب مغفور بجودك ذنبها % % 4(@)(@@) % وما كان لي لولاك بالري منزل % وإن شعفت غيري وتيم حبها % % 5(@)(@@) % وما هي إلا كالبلاد وإنما % % بوطئك فليفخر على المسك تربها % % PageV01P160 البحر : طويل 1(@)(@@) % لعمري لئن شرفتني بصنيعة % وحليت مني بالندى راحة عطلا % % 2(@)(@@) % فلم يأت عندي غير ما أنت أهله % ولا عجب للغيث أن روض المحلا % % PageV01P161 البحر : طويل 1(@)(@@) % ألا ليت شعري هل أبيتن ليلة % يروحني بالغوطتين نسيم % 2(@)(@@) % وهل يجمعن الكأس شملي بفتية % على العيش منهم نضرة ونعيم % PageV01P162 البحر : سريع 1(@)(@@) % قولا لفخراور قول امرئ % في عرضه عاث وفي الريش راث % 2(@)(@@) % يا جبل اللؤم الثقيل الذي % % ليس له في الصالحات انبعاث % 3(@)(@@) % ما كنت أهلا لرجائي ولا % % مثلك في الكربة 
ms48	 من يستغاث % 4(@)(@@) % لكنني كنت كذي جوعة % حلت له الميتة بعد الثلاث % PageV01P163 البحر : وافر تام 1(@)(@@) % تجاف عن العفاة ولا ترعهم % فإني ناصح لك يا زمان % 2(@)(@@) % أخاف ندى يمين الملك يقضي % % عليك إذا همت تلك البنان % 3(@)(@@) % وقد عاينت سطوتها غداة است % % طلت وليس كالخبر العيان % PageV01P164 البحر : بسيط تام 1(@)(@@) % هي الديار فعج في رسمها العاري % % إن كان يغنيك تعريج على دار % 2(@)(@@) % إن يخل طرفك من سكانها فبها % % ما يملأ القلب من شوق وتذكار % 3(@)(@@) % يا عمرو ما وقفة في رسم منزلة % أثار شوقك فيها محو آثار % 4(@)(@@) % أنكرت فيها الهوى ثم اعترفت به % وما اعترافك إلا دمعك الجاري % % 5(@)(@@) % تشجو الديار وما يشجو أخا كمد % من الهوى مثل دار ذات إقفار % 6(@)(@@) % يا حبذا منزل بالسفح من إضم % ودمنة بلوى خبت وتعشار % 7(@)(@@) % ويا حبذا أصل يمسي يجر بها % % ذيل النسيم على ميثاء معطار % 8(@)(@@) % لو كنت ناسي عهد من تقادمه % نسيت فيها لباناتي وأوطاري % % 9(@)(@@) % أيام يفتك فيها غير مرتقب % ظبي الكناس بليث الغابة الضاري % % 10(@)(@@) % يصبو إلي ويصبي كل منفرد % بالدل والحسن من باد ومن قار % PageV01P165 11(@)(@@) % لا أرسل اللحظ إلا كان موقعه % على شموس منيرات وأقمار % 12(@)(@@) % ما أطيب العيش لو أني وفدت به % على شباب ودهر غير غدار % 13(@)(@@) % الآن قد هجرت نفسي غوايتها % % وحان بعد حلول الشيب إقصاري % % 14(@)(@@) % والعيش ما صحب الفتيان دهرهم % مقسم بين إحلاء وإمرار % 15(@)(@@) % يا من بمجتمع الشطين إن عصفت % بكم رياحي فقد قدمت إعذاري % % 16(@)(@@) % لا تنكرن رحيلي عن دياركم % ليس الكريم على ضيم بصبار % 17(@)(@@) % يأبى لي الضيم فرسان الخلاج وما % % حبرت من غرر تهدى وأشعار % 18(@)(@@) % وقد غدوت بعز الدين معتصما % إن الكرام على الأيام أنصاري % % 19(@)(@@) % ملك إذا ذكرت يوما مواهبه % أثرى الرجاء بها من بعد إقتار % 20(@)(@@) % يعطيك جودا على الإقلال تحسبه % وافاك عن نشب جم وإكثار % PageV01P166 21(@)(@@) % ريان من كرم ملآن من همم % كأنه السيف بين الماء والنار % 22(@)(@@) % ليس الجواد 
ms49	 جوادا ما جرى مثل % حتى يكون كحسان بن مسمار % 23(@)(@@) % الواهب الخيل إما جئت زائره % أقل سرجك منها كل طيار % 24(@)(@@) % الطاعن الطعنة الفوهاء جائشة % ترد طاعنها عنها بتيار % 25(@)(@@) % يكاد ينفذ فيها حين ينفذها % % لولا عباب دم من فورها جار % 26(@)(@@) % تلقى السنان بها والسرد تحسبه % ما ضل من فتل فيها ومسبار % 27(@)(@@) % في كفه سيف مسمار الذي شقيت % هام الملوك به أيام سنجار % 28(@)(@@) % لا يأمل الرزق إلا من مضاربه % فرس الهمام بأنياب وأظفار % 29(@)(@@) % نعم المناخ لشعث فوت مهلكة % ارماق مسغبة أنضاء أسفار % 30(@)(@@) % لا يشتكون لديه المحل في سنة % يشكو بها السغب المقري والقاري % % PageV01P167 31(@)(@@) % سحاب جود على الراجين منهمل % وبحر جود على العافين زخار % 32(@)(@@) % إذا ترحل عن دار أقام له % من الصنائع فيها خير آثار % 33(@)(@@) % كالغيث أقلع محمودا وخلف ما % % يرضيك من زهر غض ونوار % 34(@)(@@) % تبقى الذخائر من فضلات نائله % كأنها غدر من بعد أمطار % 35(@)(@@) % مظفر العزم ما تألوا موفقة % آراؤه بين إيراد وإصدار % 36(@)(@@) % سام إلى الشرف الممنوع جانبه % نام إلى الحسب العاري من العار % 37(@)(@@) % مخول في جناب بيت مملكة % عزوا به وأذلوا كل جبار % 38(@)(@@) % أيام كلب لها ما بين جوسية % وبين غزة من ريف وأمصار % 39(@)(@@) % يقودها من سنان عزم متقد % أمامها كسنان الصعدة الواري % % 40(@)(@@) % ترمي بأعينها في كل داجية % منه إلى كوكب بالسعد سيار % PageV01P168 41(@)(@@) % يبيت كل ثقيل الرمح حامله % في سرج كل خفيف اللبد مغوار % 42(@)(@@) % مجد تأثل في نجد أوائله % وشيد بالشام منه الطارف الطاري % % 43(@)(@@) % يا بن الكرام الألى مازال مجدهم % % مغرى بقلة أشباه وأنظار % 44(@)(@@) % المانعين غداة الخوف جارهم % والحافظين بغيب حرمة الجار % 45(@)(@@) % بيض العوارف أغمار إذا وهبوا % % جودا وليسوا إذا عدوا بأغمار % 46(@)(@@) % لا يصحب الدهر منهم طول ما ذكروا % % إلا الثناء وإلا طيب أخبار % 47(@)(@@) % إن العشائر من أحياء ذي يمن % لما بغوك جروا في غير مضمار % 48(@)(@@) % أصحرت إذ مد بالمدان سيلهم % والليث لا يتقى من غير 
ms50	 إصحار % 49(@)(@@) % سالوا فأغرقهم قطر نضحت به % ما كل سيل على خيل بجرار % 50(@)(@@) % مالوا فقوم منهم كل منأطر % طعن يعدل منهم كل جوار % PageV01P169 51(@)(@@) % حتى إذا نهت الأولى فما انتفعوا % % بالنهي ، والبغي فيهم شر أمار % 52(@)(@@) % أبحتها وحميت الشام معتقدا % أن ليس ينفع إلا كل ضرار % 53(@)(@@) % قد نابك الدهر أزمانا بغيرهم % فظل يغمز عودا غير خوار % 54(@)(@@) % وكم أبت على ثأر ذوي ضغن % ولم تبت قط من قوم على ثار % 55(@)(@@) % إن زرت دارك عن شوق فمجدك بي % % أولى وما كل مشتاق بزوار % 56(@)(@@) % ليس المطيقون حج البيت ما تركوا % % فريضة الحج عن زهد بأبرار % 57(@)(@@) % وقد أتيتك استعدي على زمن % لا يشرب الحر فيه غير أكدار % 58(@)(@@) % موكل الجور بالأحرار يقصدهم % كأنه عندهم طلاب أوتار % 59(@)(@@) % والحمد أنفس مذخور تفوز به % فخذ بحظك من عوني وأبكاري % % 60(@)(@@) % من القوافي التي ما زلت أودعها % % علالة الركب من غاد ومن سار % PageV01P170 61(@)(@@) % إن السماحة أولاها وآخرها % % في كف كل يمان يا بن مسمار % 62(@)(@@) % لا تسقني بسوى جدوى يديك فما % % يروي من السحب إلا كل مدرار % 63(@)(@@) % ولست أول راج قاده أمل % قد راح منك على شقراء محضار % PageV01P171 البحر : وافر تام 1(@)(@@) % متى أنا طاعن قلب الفجاج % ورامي الخرق بالقلص النواحي % % 2(@)(@@) % وقائد كل سلهبة عبوس % إلى يوم يطول به ابتهاجي % % 3(@)(@@) % سيعتم الهواجر كل مجر % إلى أمدي ويلتحف الدياجي % % 4(@)(@@) % فراشي متن كل أقب نهد % وثوبي ما يثير من العجاج % 5(@)(@@) % إذا الجوزاء أمست من مرامي % % فأين سراي منها و دلاجي % % 6(@)(@@) % سوى الصهباء عاصفة بهمي % % وغير البيض من أربي وحاجي % % 7(@)(@@) % عزفت فما لساري البرق شيمي % % ولا للرسم قد أقوى معاجي % % 8(@)(@@) % وما عن سلوة إغباب دمعي % % وإقصار العواذل عن لجاجي % % 9(@)(@@) % ولكن جل عن فند ولوم % غرامي بالمحامد والتهاجي % % 10(@)(@@) % حماني العزم حظي من ذوات الث % غور الغر والمقل السواجي % % PageV01P172 11(@)(@@) % وما عند الحسان جوى مشوق % صدعن فؤاده صدع الزجاج % 12(@)(@@) % عرضن لنا فمن لحظ مريض 
ms51	 % ومن برد غريض في مجاج % 13(@)(@@) % ومسن فكم قضيب في كثيب % يشوقك باهتزاز في ارتجاج % 14(@)(@@) % كأن نعاج رمل لاحظتنا % % وإن كرمن عن حمش النعاج % 15(@)(@@) % إلام أروض جامحة الأماني % % وداء الدهر مغلوب العلاج % 16(@)(@@) % إذا العذب النمير حماه ضيم % فجاوزه إلى الملح الأجاج % 17(@)(@@) % أحل بحيث لا غوث لعاف % وأطرح المغاوث والملاجي % % 18(@)(@@) % كمن ترك الأسنة صاديات % غداة وغى وطاعن بالزجاج % 19(@)(@@) % وما عن سلوة إغباب دمعي % % وأترك جانب الأسد المهاج % 20(@)(@@) % فأقسم لا نقعت صدى بماء % إلى غير الكرام به احتياجي % % PageV01P173 21(@)(@@) % عسى الطعن الخلاج يذب عني % % إذا جاورت فرسان الخلاج % 22(@)(@@) % أولئك إن دعوا لدفاع خطب % أضاءوا نجدة واليوم داج % 23(@)(@@) % هم الأملاك حلوا من عدي % محل الطرف حصن بالحجاج % 24(@)(@@) % بدور دجنة وبحور سيب % وأسد كريهة وحصون لاجي % % 25(@)(@@) % كرام والظبى كالنار شبت % عشية عاصف ذات اهتياج % 26(@)(@@) % مواسمهم مضارب كل ماض % خلوط للجماجم بالجآجي % % 27(@)(@@) % إذا عمدوا لداء أنضجوه % وليس الكي إلا بالنضاج % 28(@)(@@) % جحاجح لا يعاب من استباحت % صدور رماحهم يوم الهياج % 29(@)(@@) % لهم خفض النواظر حيث حلوا % % من الدنيا ومنقطع الضجاج % 30(@)(@@) % ترى الهامات ناكسة لديهم % كأن بهن موضحة الشجاج % PageV01P174 31(@)(@@) % بحسان بن مسمار أقيمت % قناة الدين من بعد عوجاج % PageV01P175 البحر : طويل 1(@)(@@) % تغيرتم عن عهدكم آل كامل % فلليوم منكم غير ما أسلف الأمس % 2(@)(@@) % نبا السيف منكم في يدي وهو قاطع % كما أظلمت في ناظري منكم الشمس % 3(@)(@@) % وأوحشتم مني مكان اصطفائكم % كأن لم تكن تلك المودة والأنس % 4(@)(@@) % غرستم ثناء لم تجده سحابكم % بري وهل ينمي مع العطش الغرس % 5(@)(@@) % مواعد مرضى كلما قلت قد برى % % لكم موعد بالبذل عاوده النكس % 6(@)(@@) % وإني لذو شح بكم عن تقلب % إلى خلق فيه لأعراضكم وكس % 7(@)(@@) % وأنتم بنو الجود الذي ابتسمت به % من الزمن المربد أيامه العبس % 8(@)(@@) % سماحا فإن تدعو كفاحا فأنتم ال % % فوارس لا ميل هناك ولا نكس % 9(@)(@@) % فما بال سوقي ليس تنفق عندكم % وحظ ثنائي منكم الثمن البخس % 10 
ms52	(@)(@@) % ايرتجع المعروف من كان واهبا % ويسلب ثوب المن من لم يزل يكسو % % PageV01P176 11(@)(@@) % أساهل إغضاء وفيكم تصعب % وأرطب إجمالا وفي عودكم يبس % 12(@)(@@) % وليس بعدل أن ألين وتخشنوا % % وليس بحق أن أرق وأن تقسوا % % 13(@)(@@) % عليكم سلام لم اقل ما يريبكم % ولكنه عتب تجيش به النفس % 14(@)(@@) % حبست القوافي قبل إغضاب ربها % % وما للقوافي بعد إغضابها حبس % 15(@)(@@) % إذا العرب العرباء لم ترع ذمة % فغير ملوم بعدها الروم والفرس % PageV01P177 البحر : خفيف تام 1(@)(@@) % قد توالت علي منك أيادي % % عائدات بالمكرمات بوادي % % 2(@)(@@) % ما أبالي إذا تعهدن مغنا % % ي بأن لا يصوب صوب العهاد % 3(@)(@@) % والجميل المعاد أحلى وإن أز % رى بشكري من الشباب المعاد % 4(@)(@@) % ما ثنائي وإن تطاول إلا % % دون آلائك الحسان المراد % 5(@)(@@) % كيف أشكو حظا عليلا وحالا % كان فيها نداك من عوادي % % 6(@)(@@) % سوف أثني على الجياد فقد أه % دت إلينا الجياد خير جواد % 7(@)(@@) % حملت صوب مزنة من بلاد % منك أحيت به ربيع بلادي % % 8(@)(@@) % كنت أرتاد جود كل كريم % فكفى جود راحتيك رتيادي % % 9(@)(@@) % زرتنا منعما وما برح الزا % % ئر يرجو الإنعام في كل واد % 10(@)(@@) % وكذاك الحيا يروح من الغو % ر وتغدو له بنجد غواد % PageV01P178 11(@)(@@) % لا أرى لي حقا عليك سوى ب % رك عندي ومنطقي وودادي % % 12(@)(@@) % وإذا ما الخطوب كانت شدادا % دفعتنا إلى الكرام الشداد % PageV01P179 البحر : طويل 1(@)(@@) % خذا من صبا نجد أمانا لقلبه % فقد كاد رياها يطير بلبه % 2(@)(@@) % وإياكما ذاك النسيم فإنه % إذا هب كان الوجد أيسر خطبه % 3(@)(@@) % خليلي لو أحببتما لعلمتما % % محل الهوى من مغرم القلب صبه % 4(@)(@@) % تذكر والذكرى تشوق وذو الهوى % % يتوق ومن يعلق به الحب يصبه % 5(@)(@@) % غرام على ياس الهوى ورجائه % وشوق على بعد المزار وقربه % 6(@)(@@) % وفي الركب مطوي الضلوع على جوى % متى يدعه داعي الغرام يلبه % 7(@)(@@) % إذا خطرت من جانب الرمل نفحة % تضمن منها داءه دون صحبه % 8(@)(@@) % ومحتجب بين الأسنة معرض % وفي القلب من إعراضه مثل حجبه % 9(@)(@@) % أغار إذا 
ms53	 آنست في الحي أنة % حذارا وخوفا أن تكون لحبه % 10(@)(@@) % ويوم الرضى والصب يحمل سخطه % بقلب ضعيف عن تحمل عتبه % PageV01P180 11(@)(@@) % جلالي براق الثنايا شتيتها % % وحلاني عن بارد الورد عذبه % 12(@)(@@) % كأني لم أقصر به الليل زائرا % تحول يدي بين المهاد وجنبه % 13(@)(@@) % ولا ذقت أمنا من سرار حجوله % ولا أرتعت خوفا من نميمة حقبه % 14(@)(@@) % فيا لسقامي من هوى متجنب % بكى عاذلاه رحمة لمحبه % 15(@)(@@) % ومن ساعة للبين غير حميدة % سمحت بطل الدمع فيها وسكبه % 16(@)(@@) % ألا ليت أني لم تحل بين حاجر % وبيني ذرى أعلام رضوى وهضبه % 17(@)(@@) % وليت الرياح الرائحات خوالص % إلي ولو لاقين قلبي بكربه % 18(@)(@@) % أهيم إلى ماء ببرقة عاقل % ظمئت على طول الورود بشربه % 19(@)(@@) % واستاف حر الرمل شوقا إلى اللوى % % وقد أودعتني السقم قضبان كثبه % 20(@)(@@) % ولست على وجدي بأول عاشق % اصابت سهام الحب حبة قلبه % PageV01P181 21(@)(@@) % صبرت على وعك الزمان وقد أرى % % خبيرا بداء الحادثات وطبه % 22(@)(@@) % وأعرضت عن غر القوافي ومنطقي % % مليء لمرتاد الكلام بخصبه % 23(@)(@@) % وما عزني لو شئت ملك مهذب % يرى أن صون الحمد عنه كسبه % 24(@)(@@) % لقد طالما هومت في سنة الكرى % % ولا بد لي من يقظة المتنبه % 25(@)(@@) % سألقى بعضب الدولة الدهر واثقا % بأمضى شبا من باتر الحد عضبه % 26(@)(@@) % وأسمو عن الآمال هما وهمة % سمو جمال الملك عن كل مشبه % 27(@)(@@) % هو الملك يدعو المرملين سماحه % إلى واسع باع المكارم رحبه % 28(@)(@@) % يعنف من لم يأته يوم جوده % % ويعذر من لم يلقه يوم حربه % 29(@)(@@) % كأني إذا حييته بصفاته % % أمت إلى بدر السماء بشهبه % 30(@)(@@) % هو السيف يغشي ناظرا عند سله % بهاء ويرضي فاتكا يوم ضربه % PageV01P182 31(@)(@@) % يروق جمالا أو يروع مهابة % كصفح الحسام المشرفي وغربه % 32(@)(@@) % همام إذا أجرى لغاية سؤدد % أضلك عن شد الجواد وخبه % 33(@)(@@) % تخطى إليها وادعا وكأنه % تمطى على جرد الرهان وقبه % 34(@)(@@) % وما أبق إلا حيا متهلل % إذا جاد لم تقلع مواطر سحبه % 35(@)(@@) % أغر غياث للأنام وعصمة % يعاش بنعماه 
ms54	 ويحمى بذبه % 36(@)(@@) % يقولون ترب للغمام وإنما % % رجاء الغمام أن يعد كتربه % 37(@)(@@) % فتى لم يبت والمجد من غير همه % ولم يحترف والحمد من غير كسبه % % 38(@)(@@) % ولم ير يوما راجيا غير سيفه % ولم ير يوما خائفا غير ربه % 39(@)(@@) % تنزه عن نيل الغنى بضراعة % وليس طعام الليث إلا بغصبه % 40(@)(@@) % ألا رب باغ كان حاسم فقره % وباغ عليه كان قاصم صلبه % PageV01P183 41(@)(@@) % ويوم فخار قد حوى خصل مجده % وأعداؤه فيما ادعاه كحزبه % 42(@)(@@) % هو السيف لا تلقاه إلا مؤهلا % لإيجاب عز قاهر أو لسلبه % 43(@)(@@) % من القوم راضو الدهر والدهر والدهر جامح % فراضوه حتى سكنوا حدشغبه % 44(@)(@@) % بحار إذا أنحت لوزب محله % جبال إذا هبت زعازع نكبه % 45(@)(@@) % إذا وهبوا جاد الغمام بصوبه % وإن غضبوا جاء العرين بغلبه % 46(@)(@@) % إذا ما وردت العز يوما بنصرهم % أملك من رشف النمير وعبه % 47(@)(@@) % أجابك خطي الوشيج بلدنه % ولباك هندي الحديد بقضبه % 48(@)(@@) % أعيد لهم مجد على الدهر بعدما % % مضى بقبيل المجد منهم وشعبه % 49(@)(@@) % بأروع لا تعيا لديه بمطلب % سوى شكله في العالمين وضربه % 50(@)(@@) % تروض قبل الروض أخلاقه الثرى % % وتبعث قبل السكر سكرا لشربه % PageV01P184 51(@)(@@) % وتفخر دار حلها بمقامه % وتشرف ارض مر فيها بركبه % 52(@)(@@) % ولما دعته عن دمشق عزيمة % أبى أن يخل البدر فيها بقطبه % 53(@)(@@) % ترحل عنها فهي كاسفة له % وعاد إليها فهي مشرقة به % 54(@)(@@) % وإن محلا أوطئته جياده % لحق على الأفواه تقبيل تربه % 55(@)(@@) % رأيتك بين الحزم والجود قائما % مقام فتى المجد الصميم وندبه % 56(@)(@@) % فمن غب لا تساء بورده % % ومن ورد جود لا تسر بغبه % 57(@)(@@) % ولما استطال الخطب قصرت باعه % فعاد وجد الدهر فيه كلعبه % 58(@)(@@) % وما كان إلا العر دب دبيبه % فأمنت أن تعدى الصحاح بجربه % 59(@)(@@) % وصدعا من الملك استغاث بك الورى % % إليه فما أرجأت في لم شعبه % 60(@)(@@) % فغاض أتي كنت خائض غمره % وأصحب خطب كنت رائض صعبه % PageV01P185 61(@)(@@) % حبيت حياء في سماح كأنه % ربيع يزين النور ناضر عشبه % 62(@)(@@) % وأكثرت 
ms55	 حساد العفاة بنائل % متى ما يغر يوما على الحمد يسبه % 63(@)(@@) % مناقب ينسيك القديم حديثها % % ويخجل صدر الدهر فيها بعقبه % 64(@)(@@) % لئن خص منك الفخر سادات فرسه % لقد عم منك الجود سائر عربه % 65(@)(@@) % إذا ما هززت الدهر باسمك مادحا % تثنى تثني ناضر العود رطبه % 66(@)(@@) % وإن زمانا أنت من حسناته % حقيق بأن يختال من فرط عجبه % 67(@)(@@) % مضى زمن قد كان بالبعد مذنبا % وحسبي بهذا القرب عذرا لذنبه % 68(@)(@@) % وما كنت بعد البين إلا كمصرم % تذكر عهد الروض أيام جدبه % 69(@)(@@) % وعندي على العلات در قرائح % حوى زبد الأشعار ماخض وطبه % 70(@)(@@) % وميدان فكر لا يحاز له مدى % ولا يبلغ الإسهاب غاية سهبه % PageV01P186 71(@)(@@) % يصرف فيه القول فارس منطق % بصير بارخاء العنان وجذبه % 72(@)(@@) % وغراء ميزت الطويلأ بخفضها % % فطال على رفع الكلام ونصبه % 73(@)(@@) % من الزهر لا يلفين إلا كواكبا % طوالع في شرق الزمان وغربه % 74(@)(@@) % حوالي من حر الثناء ودره % كواسي من وشي القريض وعصبه % 75(@)(@@) % خطبت فلم يحجبك عنها وليها % % إذا رد عنها خاطب غير خطبه % 76(@)(@@) % ذخرت لك المدح الشريف وإنما % % على قدر فضل الزند قيمة قلبه % 77(@)(@@) % فجده بصون عن سواك وحسبه % من الصون أن تغري السماح بنهبه % PageV01P187 البحر : طويل 1(@)(@@) % لقد أصبحت نعماك عندي مشيدة % بذكرك في سوق من الحمد قائم % 2(@)(@@) % وقد يعجب الروض الأنيق وإنما % % يدل على فضل الحيا المتراكم % 3(@)(@@) % غمرت نوالا واصطفاء وإنما % % يحلى ويقنى كل أبيض صارم % % 4(@)(@@) % ولست على علياك أول وافد % ولا أنا من جدواك أول غانم % 5(@)(@@) % وما شئت إلا أن أشرف منطقي % % بمدحك أو أقضي ذمام المكارم % PageV01P188 البحر : وافر تام 1(@)(@@) % متى ارتجعت مواهبها الكرام % وهل يسترجع الغيث الغمام % 2(@)(@@) % أيصعد عائدا في السحب قطر % تنزل في الوهاد به الرهام % 3(@)(@@) % أرى العلياء من تقصيري أمري % % بها خجل وبالمجد احتشام % 4(@)(@@) % جمال الملك غيري منك يدهى % % وغيرك من تغيره اللئام % 5(@)(@@) % أعيذك من رضى يتلوه سخط % ومن نعمى يكدرها انتقام % 6(@)(@@) % أيرجع جفوة ذاك التصافي 
ms56	 % % ويخفر ذمة ذاك الذمام % 7(@)(@@) % أتبريني يد راشت جناحي % % ويحسمني ندى هو لي حسام % 8(@)(@@) % ويغري بي الحمام أخو سماح % به عن مهجتي دفع الحمام % 9(@)(@@) % أعرني طرف عدلك تلق عرا % نقيا لا يلم به الملام % 10(@)(@@) % وحقق بالتأمل كشف حالي % % فغيري عاشق وبي السقام % PageV01P189 11(@)(@@) % إذا ما افتر برقك في سمائي % % تجلى الظلم عني والظلام % 12(@)(@@) % أتغرقني وليس الماء مني % % وتحرقني ومن غيري الضرام % 13(@)(@@) % وأوخذ في حماك بذنب غيري % % فاين العدل عني والكرام % 14(@)(@@) % وأين خلائق ستحول عنها % % إذا حالت عن السكر المدام % 15(@)(@@) % فلا تعدل إلى الواشين سمعا % فإن كلام أكثرهم كلام % 16(@)(@@) % وإن الود عندهم نفاق % إذا طاوعتهم والحمد ذام % 17(@)(@@) % وللأقوال إن سمعت سهام % تقصر عن مواقعها السهام % 18(@)(@@) % فما نصحا لمجدك بل مرادا % لما قد ساءني قعدوا وقاموا % % 19(@)(@@) % ولو إذ أقدموا لاقوك دونشي % % كعهدك أحجموا عني وخاموا % % 20(@)(@@) % فليتك تسمع القولين حتى % % يبين في من الحق الخصام % PageV01P190 21(@)(@@) % أبعد تمسكي بنداك دهرا % وحبل نداك ليس له انصرام % 22(@)(@@) % وكوني من دفاعك في حصون % منيعات الذوائب لا ترام % 23(@)(@@) % وأخذي منك ميثاقا كريما % وعهدا ما لعروته انفصام % 24(@)(@@) % ينال مراده مني حسود % ويمكن عاديا في هتضام % 25(@)(@@) % أترضى للمحامد أن تراها % % بأرضك تستباح وتستضام % 26(@)(@@) % وتصبر عن غرائبها وصبر ال % % فتى في دينها أبدا حرام % 27(@)(@@) % وهل يسلو عن الأحباب يوما % محب ليس يسلوه الغرام % 28(@)(@@) % فلا تدع العراق وأرض مصر % تفوز بها ويحرمها الشآم % 29(@)(@@) % فمن حق القوافي منك دفع % يجيش بمثله الجيش اللهام % 30(@)(@@) % لقد مل الرقاد جفون عيني % % وما مل الدموع لها انسجام % PageV01P191 31(@)(@@) % فما يسري إلى قلبي سرور % ولكن للهموم بي اهتمام % 32(@)(@@) % سيرضى الحاسدون إذا تمطت % بي الوجناء واضطرب الزمام % 33(@)(@@) % إذا جاوزت غرب أو غرابا % وحال القاع دوني والإكام % 34(@)(@@) % فمن يجلو عليك بنات فكري % % وأنت بهن صب مستهام % 35(@)(@@) % يقيدني بنجد الشام وجد % ويدعوني إلى الغور اعتزام % 36(@)(@@) % فعن أمر النوائب لي رحيل % وفي حكم الصبابة لي 
ms57	 مقام % 37(@)(@@) % ومن يرضى من الدنيا بعيش % عليه لجائر فيه احتكام % 38(@)(@@) % تأمل ما أبث تجد حقيقا % بشمل في ذراك له التئام % 39(@)(@@) % أيعظم أن تذود الخطب عني % % وعندك تصغر النوب العظام % 40(@)(@@) % إذا لم أعتصم بك من عدو % فهل في العالمين لي اعتصام % PageV01P192 41(@)(@@) % لعل دجى الحوادث أن تجلى % % ببدر لا يفارقه التمام % 42(@)(@@) % أتيه على الزمان به ابتهاجا % وتحسدني الكواكب لا الأنام % 43(@)(@@) % وحسبي الله فيما أرتجيه % وعضب الدولة الملك الهمام % 44(@)(@@) % لقد شغل المحامد عن سواه % أغر بمدحه شرف الكلام % 45(@)(@@) % جمعت صفاته جمع اللآلي % % فلي منها الفرائد والتؤام % 46(@)(@@) % تدل عليه في الجلى علاه % وهل للبدر في الظلم اكتتام % 47(@)(@@) % أناف على القيام فطال عنهم % كأن قعوده فيهم قيام % 48(@)(@@) % تصوب جوده في كل واد % كما يتصوب السيل الركام % 49(@)(@@) % دقيق محاسن الأخلاق يبدو % % أمام نداه بشر وابتسام % 50(@)(@@) % ومقترح علي الحمد أرضى % % سلامته اقتراحي والسلام % PageV01P193 البحر : متقارب تام 1(@)(@@) % فدتك الصواهل قبا وجردا % % وشم القبائل شيبا ومردا % % 2(@)(@@) % وذلت لأسيافك البيض قضبا % ودانت لأرماحك السمر ملدا % % 3(@)(@@) % وقل لمن قام في ذا الزمان % مقامك أن بات بالخلق يفدا % % 4(@)(@@) % ألست أبر البرايا يدا % وأندى من المزن كفا وأجدا % % 5(@)(@@) % وامضى حساما وأوفى ذماما % وأهمى غماما إذا الغيث أكدا % % 6(@)(@@) % وأكلا إذا ضيع الأمر طرفا % وأورى إذا أظلم اليوم زندا % % 7(@)(@@) % إذا التبس الرأي كنت الأسد % وإن غالب الخطب كنت الأشدا % % 8(@)(@@) % وإن قصر الناس عن غاية % سبقت إليها من الناس فردا % % 9(@)(@@) % ومن ذا يجاريك فضلا ونبلا % ومن ذا يساويك حلا وعقدا % % 10(@)(@@) % سجية من لم يزل بالثنا % % ء والحمد منفردا مستبدا % % PageV01P194 11(@)(@@) % تجل معاليه أن تستطاع % وتأبى مناقبه أن تعدا % % 12(@)(@@) % حقيق إذا ما انتضى سيفه % بأن يجعل الهام للسيف غمدا % % 13(@)(@@) % زعيم الجيوش لقد أعجزت % أياديك واصفها أن تحدا % % 14(@)(@@) % وأمعن ذكرك في الخافقي % ن شرقا وغربا وغورا ونجدا % % 15(@)(@@) % فسار مسير هلال السما % % ء يزداد نورا إذا ازداد بعدا % % 16(@)(@@) % فلو طبع 
ms58	 الفخر سيفا لكن % ت دون الورى حده والفرندا % % 17(@)(@@) % وكم لك من نائل % رقاب المآثر شكرا وحمدا % % 18(@)(@@) % ندى يعتق العبد من رقه % ولكنه يترك الحر عبدا % % 19(@)(@@) % وإني لمهد إليك القري % % ض يطوى على النصح والنصح يهدا % % 20(@)(@@) % إلى كم وقد زخر المشركون % بسيل يهال له السيل مدا % % PageV01P195 21(@)(@@) % وقد جاش من أرض إفرنجة % جيوش كمثل جبال تردا % % 22(@)(@@) % تراخون من يجتري شدة % وتنسون من يجعل الحرب نقدا % % 23(@)(@@) % أنوما على مثل هد الصفاة % وهزلا وقد أصبح الأمر جدا % % 24(@)(@@) % وكيف تنامون عن أعين % وترتم فأسهرتموهن حقدا % % 25(@)(@@) % وشر الضغائن ما أقبلت % لديه الضغائن بالكفر تحدا % % 26(@)(@@) % بنو الشرك لا ينكرون الفساد % ولا يعرفون مع الجور قصدا % % 27(@)(@@) % ولا يردعون عن القتل نفسا % ولا يتركون من الفتك جهدا % % 28(@)(@@) % فكم من فتاة بهم أصبحت % تدق منع الخوف نحرا وخدا % % 29(@)(@@) % وأم عواتق ما إن عرف % ن حرا ولا ذقن في الليل بردا % % 30(@)(@@) % تكاد عليهن من خيفة % تذوب وتتلف حزنا ووجدا % % PageV01P196 31(@)(@@) % فحاموا على دينكم والحريم % محاماة من لا يرى الموت فقدا % % 32(@)(@@) % وسدوا الثغور بطعن النحور % فمن حق ثغر بكم أن يسدا % % 33(@)(@@) % فلن تعدموا في انتشار الأمور % أخا تدرإ حازم الرأي جلدا % % 34(@)(@@) % يظاهر تدبيره بأسه % مظاهرة السيف كفا وزندا % % 35(@)(@@) % كمثل زعيم الجيوش الملي % بعزم يبيت له الحزم ردا % % 36(@)(@@) % وعادات بأسكم في اللقا % % ء ليست تحول عن النصر عهدا % % 37(@)(@@) % فدونكم ظفرا عاجلا % لكم جاعلا سائر الأرض مهدا % % 38(@)(@@) % فقد أينعت أرؤس المشركين % فلا تغفلوها قطافا وحصدا % % 39(@)(@@) % فلا بد من حدهم أن يفل % ولا بد من ركنهم أن يهدا % % 40(@)(@@) % فإن لب رسلان في مثلها % % مضى وهو أمضى من السيف حدا % % PageV01P197 41(@)(@@) % فأصبح أبقى من الفرقدي % ن ذكرا وأسنى من الشمس مجدا % % 42(@)(@@) % لعلكم أن تعيدوا من ال % % مآثر والمجد ما كان أبدا % % 43(@)(@@) % وهذا ابنه قائما فيكم % مقام المفاخر جدا وجدا % % 44(@)(@@) % بخيل تخال غداة المكر % طيرا تحملن عاب وأسدا % % 45(@)(@@) % وطعن أمر 
ms59	 من الموت طعما % وضرب أحر من النار وقدا % % 46(@)(@@) % إذا ما السيوف غداة الحتو % % ف نوعت الضرب قطعا وقدا % % 47(@)(@@) % ترى لمعا وقعا لا يزل % ن يخطفن برقا ويقصفن رعدا % % 48(@)(@@) % فذو البأس من جاب من تركة % له عمة ومن الدرع بردا % % 49(@)(@@) % ولم يضع السرد عن منكبي % % ه حتى يصير مع الجلد جلدا % % 50(@)(@@) % فلما ينزع اليوم عنه الحدي % % د من رام أن يلبس العز رغدا % % PageV01P198 51(@)(@@) % وأيسر ما كابدته النفوس % من الأمر ما لم تجد منه بدا % % 52(@)(@@) % بقيتم ولا زلتم في اللقاء % بدورا توافق في الأفق سعدا % % 53(@)(@@) % ولا برح العز للمسلم % ن من بحركم أبدا مستمدا % % 54(@)(@@) % فلسنا نرى بعد طول البقا % % ء أكرم منكم على الله وفدا % % 55(@)(@@) % وقد قيل في الترك إن الذي % % يتاركهم أسعد الناس جدا % % PageV01P199 البحر : طويل 1(@)(@@) % جرى لك بالتوفيق أمن طائر % ومليت مأثور العلى والمآثر % 2(@)(@@) % وأيدك الله العلي ثناؤه % بعاجل نصر خالد العز قاهر % 3(@)(@@) % ولازلت ورادا إلى كل مفخر % موارد محمود سعيد المصادر % % 4(@)(@@) % لقد دل تشريف الخليفة أنه % بخير بني أيامه خير خابر % 5(@)(@@) % وأن له في حوطة الدين همة % بها يستحق النصر من كل ناصر % 6(@)(@@) % تسربلت عضب الدولة الملك فخره % وما الفخر إلا للسيوف البواتر % 7(@)(@@) % وما جهلت نعماه عندك قدرها % % وقد كشفت عما طوى في الضمائر % 8(@)(@@) % وما نبهت إلى على ذي نباهة % كما سقي الروض الخصيب بماطر % 9(@)(@@) % وما كان إلا العنبر الورد فعله % أضيف إلى نشر من المسك عاطر % 10(@)(@@) % وما شاء إلا أن تحقق عنده % محلك من طاو هواه وناشر % PageV01P200 11(@)(@@) % وأنك معقود بأكبر همة % وأنك معدود له في الذخائر % 12(@)(@@) % وليس يبين الدهر إخلاص باطن % إذا أنت لم تدلل عليه بظاهر % 13(@)(@@) % رآك بعين اللب أبعد في العلى % % وأسعد من زهر النجوم البواهر % 14(@)(@@) % وأبهى محلا في القلوب وموقعا % وأشهى إلى لحظ العيون النواظر % 15(@)(@@) % وأطعم في اللأواء والدهر ساغب % وأطعن في صدر الكمي المغامر % 16(@)(@@) % فناهز فخرا ب صطفائك 
ms60	 عاجلا % على كل باق في الزمان وغابر % 17(@)(@@) % وما ذاك من فعل الخليفة منكر % ولا عجب فيض البحور الزواخر % 18(@)(@@) % وما عد إلا من مناقبه التي % % مثلن به في الفعل طيب العناصر % 19(@)(@@) % وما كان تأثيل شريف وسؤدد % لينكر من أهل النهى والبصائر % 20(@)(@@) % وأنت الذي من بأسه في جحافل % ومن مجده في أسرة وعشائر % PageV01P201 21(@)(@@) % بعزمات مجد ثاقبات همومها % % وآراء ملك محصدات المرائر % 22(@)(@@) % يراها ذوو الأضغان بث حبائل % وما هي إلا أسهم في المناحر % 23(@)(@@) % وآيات مجد باهرات كأنها % % بدائع تأتي بالمعاني النوادر % 24(@)(@@) % وأخلاق معشوق السجايا كأنما % % سقاك بها كأس النديم المعاقر % 25(@)(@@) % يبيت بعيدا أن توجه وصمة % على عرضه والدهر باقي المعاير % 26(@)(@@) % إذا دفع الطلاب إلحاح لزبة % فأنت الذي لا يتقي بالمعاذر % 27(@)(@@) % وما للبدور أن تكف ضياءها % % ولا البحل في طبع الغمام البواكر % 28(@)(@@) % لعمري لقد أتعبت بالحمد منطقي % % وأكثرت من شغل القوافي السوائر % 29(@)(@@) % وما نوهت منك القوافي بخامل % ولكن رأيت الشعر قيد المفاخر % 30(@)(@@) % إذا أنت لم تجعل له منك جانبا % فمن يقتني الحمد اقتناء الجواهر % PageV01P202 31(@)(@@) % وما زلت مشغوفا لدي متيما % بكل رداح من بنات الخواطر % 32(@)(@@) % لهن إذا وافين مجدك قربة ال % % حسان ودل الآنسات الغرائر % 33(@)(@@) % يردن ربيعا من جنابك ممرعا % ويرتعن في إثر الغيوم المواطر % 34(@)(@@) % وإني لقوال لكل قصيدة % إذا قيل شعر أفحمت كل شاعر % 35(@)(@@) % فمن كلم يكلمن أكباد حسدي % % ومن فقر ترميهم بالفواقر % 36(@)(@@) % ألا ليت شعري هل أفوز بدولة % تصرف كفي في عنان المقادر % 37(@)(@@) % وهل تنهض الأيام بي في مقاوم % تطول بناه للزمان وآمر % 38(@)(@@) % فإن من العجز المبين - وأنت لي % % نزولي على حكم الليالي الجوائر % PageV01P203 البحر : متقارب تام 1(@)(@@) % نشدتك لا تعدم الراح راحا % % ولا تمنعن الصبوح الصباحا % % 2(@)(@@) % فقد أصبح الغيث يكسو الجمال % وجوها من الأرض كانت قباحا % % 3(@)(@@) % يعيد إلى العود إيراقه % ويهتزه بالنسيم ارتياحا % % 4(@)(@@) % بكى رحمة لجدوب البلاد % وحن اشتياقا إليها فساحا % % 5(@)(@@) % وسح كما غلب المستها % % م 