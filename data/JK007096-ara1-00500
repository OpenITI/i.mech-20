ms481	 ) وأقم الصلاة طرفي . . . . .(@)(@@) > > ^ ( وأقم الصلوة ) ^ ، يعنى وأتم الصلاة ، يعنى ركوعها وسجودها ، ^ ( طرفي النهار ) ^ ، | يعنى صلاة الغداة ، وصلاة الأولى ، والعصر ، ثم قال : ^ ( وزلفا من اليل ) ^ ، يعنى صلاة | المغرب والعشاء ، ^ ( إن الحسنات ) ^ ، يعنى الصلوات الخمس ^ ( يذهبن السيئات ) ^ ، يعنى | يكفرن الذنوب ما اجتنبت الكبائر ، نزلت في أبي مقبل ، واسمه عامر بن قيس الأنصاري ، | من بني النجار ، أتته امرأة تشتري منه تمرا فراودها ، ثم أتى النبي صلى الله عليه وسلم فقال : إني خلوت | بامرأة ، فما شيء يفعل بالمرأة إلا وفعلته بها ، إلا إني لم أجامعها ، فنزلت : ^ ( وأقم | الصلوة طرفي النهار . . . ) ^ إلى آخر الآية .(@)(@@) ثم عمد الرجل ، فصلى المكتوبة وراء النبي صلى الله عليه وسلم ، فلما انصرف النبي صلى الله عليه وسلم ، قال له : | ' أليس قد توضأت وصليت معنا ؟ ' ، قال : بلى ، قال : ' فإنها كفارة لما صنعت ' ، ثم قال : | @QB@ ذلك @QE@ الذي ذكره من الصلاة طرفي النهار وزلفى من الليل من الصلاة ، ^ ( ذكرى | للذاكرين ) ^ [ آية : 114 ] ، كقوله لموسى : @QB@ وأقم الصلاة لذكري @QE@ [ طه : 14 ] . | PageV02P134(@)(@@) < <(@)(@@) | هود : ( 115 ) واصبر فإن الله . . . . .(@)(@@) > > @QB@ واصبر @QE@ يا محمد على الصلاة ، ^ ( فإن الله لا يضيع أجر المحسنين ) ^ [ آية : | 115 ] ، يعنى جزاء المخلصين .(@)(@@) < <(@)(@@) | هود : ( 116 ) فلولا كان من . . . . .(@)(@@) > > @QB@ فلولا كان @QE@ ، يعنى لم يكن ^ ( من القرون من قبلكم أولوا بقية ينهون عن | الفساد ) ^ ، يعنى الشرك ، @QB@ في الأرض @QE@ ، يقول : لم يكن من القرون من ينهى عن | المعاصي في الأرض بعد الشرك ، ثم استثنى ، فقال : ^ ( إلا قليلا ممن أنجينا منهم ) ^ | يعنى مع الرسل من العذاب مع الأنبياء ، فهم الذين كانوا ينهون عن الفساد في الأرض ، | ^ ( واتبع الذين ظلموا ) ^ ، يقول : وآثر الذين ظلموا دنياهم ، ^ ( ما أترفوا فيه ) ^ ، | يعنى ما أعطوا فيه من دنياهم على أخرتهم ، ^ ( وكانوا مجرمين ) ^ [ آية : 116 ] ، يعنى | الأمم الذين كذبوا في الدنيا .(@)(@@) < <(@)(@@) | هود : ( 117 ) وما كان ربك . . . . .(@)(@@) > > ^ ( وما كان ربك ليهلك ) ^ ، يعنى ليعذب في الدنيا ، @QB@ القرى بظلم @QE@ ، يعنى | على غير ذنب ، يعني القرى التي ذكر الله تعالى في هذه السورة الذين عذبهم الله ، وهم : | قوم نوح ، وعاد وثمود ، وقوم إبراهيم ، وقوم لوط ، وقوم شعيب ، ثم قال : ^ ( وأهلها 
ms482	 | مصلحون ) ^ [ آية : 117 ] ، يعنى مؤمنون ، يقول : لو كانوا مؤمنين ما عذبوا .(@)(@@) < <(@)(@@) | هود : ( 118 ) ولو شاء ربك . . . . .(@)(@@) > > ^ ( ولو شاء ربك لجعل الناس أمة واحدة ) ^ ، يعنى على ملة الإسلام وحدها ، ثم قال :(@)(@@) ^ ( ولا يزالون مختلفين ) ^ [ آية : 118 ] ، يقول : لا يزال أهل الأديان مختلفين في الدين ، غير | دين الإسلام .(@)(@@) < <(@)(@@) | هود : ( 119 ) إلا من رحم . . . . .(@)(@@) > > ثم استثنى بعضهم : ^ ( إلا من رحم ربك ) ^ ، أهل التوحيد لا يختلفون في الدين ، | ^ ( ولذلك خلقهم ) ^ ، يعنى للرحمة خلقهم ، يعنى الإسلام ، @QB@ وتمت @QE@ ، يقول : وحقت | @QB@ كلمة ربك @QE@ العذاب على المختلفين ، والكلمة التي تمت قوله : ^ ( لأملأن جهنم من | الجنة والناس أجمعين ) ^ [ آية : 119 ] ، يعنى الفريقين جميعا . | تفسير سورة هود من الآية [ 120 ] .(@)(@@) < <(@)(@@) | هود : ( 120 ) وكلا نقص عليك . . . . .(@)(@@) > > ^ ( وكلا نقص عليك من أنباء الرسل ) ^ وأممهم ، وما يذكر في هذه السورة ، ^ ( ما نثبت | به فؤادك ) ^ ، يعنى قلبك أنه أحق ، فذلك قوله : ^ ( وجاءك في هذه ) ^ السورة @QB@ الحق @QE@ | مما ذكر من أمر الرسل وأمر قومهم ، @QB@ وموعظة @QE@ ، يعنى ما عذب الله به الأمم الخالية ، | PageV02P135 | وما ذكر في هذه السورة فهو موعظة ، يعنى مأدبة لهذه الأمة ، @QB@ وذكرى @QE@ ، يعنى | وتذكرة @QB@ للمؤمنين @QE@ [ آية : 120 ] ، يعنى للمصدقين بتوحيد الله . | تفسير سورة هود من الآية : [ 121 - 122 ] .(@)(@@) < <(@)(@@) | هود : ( 121 ) وقل للذين لا . . . . .(@)(@@) > > ^ ( وقل للذين لا يؤمنون ) ^ ، يعنى لا يصدقون بما في القرآن : @QB@ اعملوا على مكانتكم @QE@ ، | هذا وعيد ، يقول : اعملوا على جديلتكم التي أنتم عليها ، ^ ( إنا عاملون ) ^ [ آية : 121 ] | على جديلتنا التي نحن عليها .(@)(@@) < <(@)(@@) | هود : ( 122 ) وانتظروا إنا منتظرون(@)(@@) > > ^ ( وانتظروا ) ^ العذاب @QB@ إنا منتظرون @QE@ [ آية : 122 ] بكم العذاب ، يعني القتل ببدر ، | وضرب الملائكة وجوههم وأدبارهم ، وتعجيل أرواحهم إلى النار . | تفسير سورة هود من الآية : [ 123 ](@)(@@) < <(@)(@@) | هود : ( 123 ) ولله غيب السماوات . . . . .(@)(@@) > > ^ ( ولله غيب السموات والأرض ) ^ ، يقول : ولله غيب نزول العذاب ، وغيب ما في | الأرض ، ^ ( وإليه يرجع الأمر كله ) ^ ، يعنى أمر العباد يرجع إلى الله يوم القيامة ، وذلك | قوله : @QB@ وإلى الله ترجع الأمور @QE@ [ البقرة : 210 ] ، يعنى أمور العباد ، ^ ( فاعبده ) ^ | يعنى وحده ، ^ ( وتوكل عليه ) ^ ، يقول : وثق بالله ، ^ ( وما ربك بغافل عما تعملون ) ^ | [ آية : 123 ] ، هذا وعيد . | PageV02P136 | <(@)(@@) > 1 
ms483	 ( سورة يوسف ) <(@)(@@) > | 1 ( مكية كلها ، وهي مائة وإحدى عشرة آية كوفي ) 1 ( وحسبنا الله ونعم الوكيل ) <(@)(@@) > 1 ( بسم الله الرحمن الرحيم ) <(@)(@@) > | تفسير سورة يوسف من الآية : [ 1 - 2 ] .(@)(@@) < <(@)(@@) | يوسف : ( 1 ) الر تلك آيات . . . . .(@)(@@) > > ^ ( الر تلك ءايت الكتاب المبين ) ^ [ آية : 1 ] ، يعنى بين ما فيه . < <(@)(@@) | يوسف : ( 2 ) إنا أنزلناه قرآنا . . . . .(@)(@@) > > ^ ( إنا أنزلناه قرءانا عربيا | لعلكم ) ^ ، يعنى لكي ، @QB@ تعقلون @QE@ [ آية : 2 ] ما فيه لو كان القرآن غير عربي ما | فهموه ولا عقلوه . | تفسير سورة يوسف من الآية : [ 3 - 21 ] . | PageV02P137(@)(@@) < <(@)(@@) | يوسف : ( 3 ) نحن نقص عليك . . . . .(@)(@@) > > @QB@ نحن نقص عليك أحسن القصص @QE@ ، يعنى القرآن ، @QB@ بما أوحينا إليك @QE@ ، بالذي | أوحينا إليك ، نظيرها في يس : @QB@ بما غفر لي ربي @QE@ [ يس : 27 ] ، ^ ( هذا القرءان وإن كنت من قبله ) ^ ، يعنى من قبل نزول القرآن عليك ، @QB@ لمن الغافلين @QE@ [ آية : 3 ] | عنه .(@)(@@) < <(@)(@@) | يوسف : ( 4 ) إذ قال يوسف . . . . .(@)(@@) > > @QB@ إذ قال يوسف لأبيه @QE@ يعقوب : @QB@ يا أبت إني رأيت @QE@ في المنام @QB@ أحد عشر كوكبا والشمس والقمر @QE@ هبطوا إلى الأرض من السماء ، ف @QB@ رأيتهم لي ساجدين @QE@ [ آية : 4 ] ، | فالكواكب الأحد عشر إخوته ، والشمس أم يوسف ، وهي راحيل بنت لاتان ، ولاتان هو | خال يعقوب ، والقمر أبوه يعقوب بن إسحاق بن إبراهيم ، وقد علم تعبير ما رأى | يوسف .(@)(@@) < <(@)(@@) | يوسف : ( 5 ) قال يا بني . . . . .(@)(@@) > > ^ ( قال يا بني لا تقصص رءياك على إخوتك ) ^ فيحسدوك إضمار ، @QB@ فيكيدوا لك كيدا @QE@ ، فيعملوا بك شرا ، @QB@ إن الشيطان للإنسان عدو مبين @QE@ [ آية : 5 ] ، يعنى بين .(@)(@@) < <(@)(@@) | يوسف : ( 6 ) وكذلك يجتبيك ربك . . . . .(@)(@@) > > وقال يعقوب ليوسف : @QB@ وكذلك يجتبيك ربك @QE@ ، يقول : وهكذا يستخلصك ربك | بالسجود ، @QB@ ويعلمك من تأويل الأحاديث @QE@ ، يعنى ويعلمك تعبير الرؤيا ، ^ ( ويتم نعمته | عليك وعلىءال يعقوب ) ^ ، يعنى بآل يعقوب هو وامرأته وإخوته الأحد عشر ، بالسجود | لك ، @QB@ كما أتمها @QE@ ، يعنى النعمة ، ^ ( وعلى أبويك من قبل ) ^ ، يعنى بأبويه @QB@ إبراهيم @QE@ حين | رأى في المنام أنه يذبح ابنه إسحاق ، وألقى إبراهيم في النار ، فنجاه الله تعالى منها ، وأراد | ذبح ابنه ، فخلصه الله بالسجود ، @QB@ وإسحاق @QE@ في رؤيا إبراهيم في ذبح إسحاق ، @QB@ إن ربك عليم @QE@ بتمامها ، @QB@ حكيم @QE@ [ آية : 6 ] ، يعنى القاضي لها 
ms484	 . | PageV02P138(@)(@@) < <(@)(@@) | يوسف : ( 7 ) لقد كان في . . . . .(@)(@@) > > ^ ( لقد كان في يوسف وإخوته ءايات ) ^ ، يعنى علامات ، @QB@ للسائلين @QE@ [ آية : 7 ] ، | وذلك أن اليهود لما سمعوا ذكر يوسف عليه السلام ، من النبي صلى الله عليه وسلم ، منهم كعب بن | الأشرف ، وحيي ، وجدي ابنا أخطب ، والنعمان بن أوفى ، وعمرو ، وبحيرا ، وغزال بن | السموأل ، ومالك بن الضيف ، فلم يرمن بالنبي صلى الله عليه وسلم منهم غير جبر غلام بن الحضرمي ، | ويسار أبو فكيهه ، وعداس ، فكان ما سمعوا من النبي صلى الله عليه وسلم من ذكر يوسف وأمره ^ ( ءايت | للسائلين ) ^ ، وذلك أن اليهود سألوا النبي صلى الله عليه وسلم عن أمر يوسف ، فكان ما سمعوا علامة لهم | وهم السائلون عن أمر يوسف ، عليه السلام ، وكان يوسف قد فضل في زمانه بحسنه | على الناس كفضل القمر ليلة البدر على سائر الكواكب .(@)(@@) < <(@)(@@) | يوسف : ( 8 ) إذ قالوا ليوسف . . . . .(@)(@@) > > @QB@ إذ قالوا @QE@ إخوة يوسف ، وهو : روبيل أكبرهم سنا ، ويهوذا أكبرهم في العقل ، | وهو الذي قال الله : @QB@ قال كبيرهم @QE@ [ آية : 80 ] في العقل ، ولم يكن كبيرهم في | السن ، وشمعون ، ولاوى ، ونفتولن ، وربولن ، وآشر ، واستاخر ، وجاب ودان ، ويوسف | وبنيامين ، بعضهم لبعض : @QB@ ليوسف وأخوه @QE@ ، وهو بنيامين @QB@ أحب إلى أبينا منا ونحن عصبة @QE@ ، يعنى عشرة ، @QB@ إن أبانا لفي ضلال مبين @QE@ [ آية : 8 ] ، يعنى خسران مبين يعنى | في شقاء بين ، نظيرها في سورة القمر : @QB@ إن المجرمين في ضلال @QE@ [ القمر : 47 ] ، | يعنى في شقاء ، من حب يعقوب لابنه يوسف وذكره .(@)(@@) < <(@)(@@) | يوسف : ( 9 ) اقتلوا يوسف أو . . . . .(@)(@@) > > ثم قال بعضهم لبعض : @QB@ اقتلوا يوسف أو اطرحوه أرضا @QE@ بعيدة ، @QB@ يخل لكم وجه أبيكم @QE@ ، فيقبل عليكم بوجهه ، @QB@ وتكونوا @QE@ ، يعنى وتصيروا @QB@ من بعده قوما صالحين @QE@ [ آية : 9 ] ، يعنى يصلح أمركم وحالكم عند أبيكم .(@)(@@) < <(@)(@@) | يوسف : ( 10 ) قال قائل منهم . . . . .(@)(@@) > > @QB@ قال قائل منهم @QE@ ، وهو يهوذا بن يعقوب : @QB@ لا تقتلوا يوسف @QE@ فإن قتله عظيم ، | ^ ( و ) ^ لكن ^ ( وألقوه في غيابت الجب ) ^ على طريق الناس ، فيأخذونه فيكفونكم أمره ، | يعنى الزائغة من البئر ما يتوراى عن العين ولا يراه أحد ، فهو غيابت الجب ، ^ ( يلتقطه | PageV02P139 | بعض السيارة ) ^ . فيذهبوا به فيكفونكم أمره ، ^ ( إن 
ms485	 كنتم ) ^ لا بد ^ ( فاعلين ) ^ [ آية : | 10 ] من الشر الذي تريدون به .(@)(@@) < <(@)(@@) | يوسف : ( 11 ) قالوا يا أبانا . . . . .(@)(@@) > > فأتوا يعقوب ، ف ^ ( قالوا ياأبانا ما لك لا تأمنا على يوسف وإنا له لناصحون ) ^ [ آية : | 11 ] .(@)(@@) < <(@)(@@) | يوسف : ( 12 ) أرسله معنا غدا . . . . .(@)(@@) > > ^ ( أرسله معنا غدا يرتع ويلعب ) ^ ، يعنى ينشط ويفرح ، والعرب تقول : رتعت لك ، | يعنى فرحت لك ، ^ ( وإنا له لحافظون ) ^ [ آية : 12 ] من الضيعة ، قال يعقوب لهم : إني | أخاف عليه ، فقالوا لأبيهم : ^ ( ما لك لا تأمنا على يوسف وإنا له لناصحون ) ^ في الحفظ | له .(@)(@@) < <(@)(@@) | يوسف : ( 13 ) قال إني ليحزنني . . . . .(@)(@@) > > ^ ( قال ) @QB@ أبوهم @QE@ ( إني ليحزنني أن تذهبوا به وأخاف أن يأكله الذئب وأنتم عنه | غافلون ) ^ [ آية : 13 ] ، لا تشعرون به ، وكانت أرضا مذئبة ، فمن ثم قال يعقوب : إني | أخاف أن يأكله الذئب .(@)(@@) < <(@)(@@) | يوسف : ( 14 ) قالوا لئن أكله . . . . .(@)(@@) > > ^ ( قالوا ) ^ ، أي العشرة : ^ ( لئن أكله الذئب ونحن عصبة ) ^ ، يعنى ونحن جماعة ، | ^ ( إنا إذا لخسرون ) ^ [ آية : 14 ] ، يعنى لعجزة .(@)(@@) < <(@)(@@) | يوسف : ( 15 ) فلما ذهبوا به . . . . .(@)(@@) > > ^ ( فلما ذهبوا به ) @QB@ بيوسف @QE@ ( وأجمعوا ) @QB@ أمرهم @QE@ ( أن يجعلوه في غيابت الجب ) ^ | على رأس ثلاثة فراسخ ، فألقوه في الجب ، والماء يومئذ كدر غليظ ، فعذب الماء وصفا | حين ألقى فيه ، وقام على صخرة في قاصية البئر ، فوكل الله به ملكا يحرسه في الجب | ويطعمه ، ^ ( وأوحينا إليه لتنبئنهم بأمرهم هذا وهم لا يشعرون ) ^ [ آية : 15 ] ، وذلك أن | الله أوحى إلى يوسف ، عليه السلام ، بعدما انصرف إخوته : إنك ستخبر إخوتك بأمرهم | هذا الذي ركبوا منك ، ثم قال : ^ ( وهم لا يشعرون ) ^ أنك يوسف حين تخبرهم ، فأنبأهم | يوسف بعد ذلك حين قال لهم وضرب الإناء ، فقال : إن الإناء ليخبرني بما فعلتم بيوسف | من الشر ونزع الثياب .(@)(@@) قال أبو محمد عبد الله بن ثابت : وسمعت أبي يحدثني عن الهذيل ، عن مقاتل في قوله : | ^ ( وأوحينا إليه لتنبئنهم بأمرهم هذا وهم لا يشعرون ) ^ ، قال : لا يشعرون أنك يوسف .(@)(@@) قال : وذلك أن يوسف لما استخرج الصاع من وعاء أخيه بنيامين ، قطع بالقوم | وتحيروا ، فأحضرهم وأخذ بنيامين مكان سرقته ، ثم تقدم إلى أمينه ، فقال له : أحضر | PageV02P140 | الصاع إذا 
ms486	 حضروا وانقره ثلاث نقرات ، واستمع طنين كل نقرة حتى تسكن ، ثم قل في | النقرة الأولى كذا ، وفي الثانية كذا ، وفي الثالثة كذا ، وأوهمهم أنك إنما تخبرني عن شيء | تفهمه من طنين الصاع ، قال : فأمر بهم فجمعوا ، ثم قال يوسف للذي استخرج الصاع ، | وهو أمينه : أحضر الصاع الذي سرقوه ، وتقدم إليه ألا يكتمنا من أخبارهم شئيا ، فإنه | غضبان عليهم ويوشك أن يصدق عنهم ، قال : فأحضره والقوم ، وقال له الأمين : أيها | الصاع ، إن الملك يأمرك أن تبين له أمر هؤلاء القوم ولا تكتمه شيئا من أمرهم ، ثم نقره | نقرة شديد ، وأصغى إليه يسمعه ، كأنه يستمع منه شيئا ، فقال : أيها الملك ، إن الصاع | يقول لك : إنهم أخبروك أنهم لأم واحدة ، وأنهم لأمهات شتى ، وذلك وقع بينهم ما يقع | بين الأولاد العتاة .(@)(@@) قال : قل له لا يكتمنا من أخبارهم شيئا ، ثم نقره الثانية وأصغى إليه يسمعه ، فلما | سكن ، قال : أيها الملك ، إنهم أخبروك أن لهم أخا مفقودا ، ولن تنصرم الأيام والليالي حتى | يأتي ذلك الغلام فيتبين الناس أخبارهم .(@)(@@) قال : مرة ألا يكتمنا من أخبارهم شيئا ، قال : فطن الثالثة ، فلما سكن قال : أيها الملك | إنه ما دخل على أبيهم غم ولا هم ولا حزن إلا بسببهم وجرائرهم ، قال : أوعز إليه ألا | يكتمنا من أخبارهم شيئا(@)(@@) قال : فنظر بعضهم إلى بعض ، وخافوا أن يظهر عليهم ما كتموه من أمر يوسف عليه | السلام ، فقاموا إليه بجمعهم يقبلون رأسه وعينيه ، ويقولون : بالذي أشبهك بالنبيين | وفضلك على العالمين ، ألا أقلت العثرة ، وسترت العورة ، وحفظتنا في أبينا يعقوب ، فرق | لهم ، وقال : لولا حفاظي لكم في أبيكم لنكلت بكم ولألحقتكم بالسراق واللصوص ، | أغربوا عني ، فلا حاجة لي فيكم .(@)(@@) قال : فلما قدموا على أبيهم أخبروه بأخبارهم ، قال : فردهم بالبضاعة المزجاة ، وكتب | معهم كتابا إليه ، فيه : بسم الله الرحمن الرحيم ، من يعقوب إسرائيل الله ابن إسحاق ذبيح | الله ابن إبراهيم خليل الله ، إلى عزيز مصر ، سلام على من اتبع الهدى ، أما بعد ، فإني ما | سرقت ، ولا ولدت سارقا ، ولكن أهل بيت البلاء موكل 
ms487	 بنا ، أما جدي ، فألقى في النار ، | فجعلها الله عليه بردا وسلاما ، وأما أبي ، فأضجع للذبح ، ففداه الله بذبح عظيم ، وأما أنا ، | فبليت بفقد حبيبي وقرة عيني يوسف . | PageV02P141(@)(@@) قال : فلما وصلوا إليه أوصلوا كتابه ، فلما قرأ كتابه انتحب ، فقيل له : كأنك صاحب | الكتاب ، قال : أجل فذلك قوله : @QB@ لتنبئنهم بأمرهم هذا وهم لا يشعرون @QE@ ، ثم تعرف | إليهم فعرفوه .(@)(@@) < <(@)(@@) | يوسف : ( 16 ) وجاؤوا أباهم عشاء . . . . .(@)(@@) > > ^ ( وجاءو أباهم ) ^ يعقوب @QB@ عشاء يبكون @QE@ [ آية : 16 ] صلاة العتمة .(@)(@@) < <(@)(@@) | يوسف : ( 17 ) قالوا يا أبانا . . . . .(@)(@@) > > ^ ( قالوا ياأبانا إنا ذهبنا نستبق ) ^ ، يعنى نتصيد ، @QB@ وتركنا يوسف عند متاعنا @QE@ | ليحفظه ، @QB@ فأكله الذئب وما أنت بمؤمن لنا @QE@ ، يعنى بمصدق لنا ، @QB@ ولو كنا صادقين @QE@ [ آية : 17 ] بما نقول .(@)(@@) < <(@)(@@) | يوسف : ( 18 ) وجاؤوا على قميصه . . . . .(@)(@@) > > ^ ( وجاءو على قميصه ) ^ ، يعنى على قميص يوسف @QB@ بدم كذب @QE@ ، وذلك أنهم | حين ألقوه في البئر انتزعوا ثيابه ، وهو قميصه ، ثم عمدوا إلى سخلة فذبحوها على | القميص ليروا أباهم يعقوب ، فلما رأى أباهم القميص صحيحا اتهمهم ، وكان لبيبا | عاقلا ، فقال : ما أحلم هذا السبع حين خلع القميص كراهية أن يتمزق ، ثم بكي ، | ف @QB@ قال بل سولت @QE@ ، يقول : بل زينت @QB@ لكم أنفسكم أمرا @QE@ ، وكان الذي أردتم هو | منكم ، @QB@ فصبر جميل @QE@ ، يعنى صبري صبرا حسنا لا جزع فيه ، @QB@ والله المستعان على ما تصفون @QE@ [ آية : 18 ] ، يقول : بالله أستعين على ما تقولون حين تزعمون أن الذئب أكله ، | فبكي عليه يعقوب ، عليه السلام ، حتى امتنع عن النوم ومن أهل بيته ، فكان يبكي ويئود ، | فمن هناك تئود اليهود إذا قرأوا التوراة .(@)(@@) < <(@)(@@) | يوسف : ( 19 ) وجاءت سيارة فأرسلوا . . . . .(@)(@@) > > @QB@ وجاءت سيارة @QE@ ، وهي العير ، وقالوا : رفقة من العرب ، فنزلوا على البئر يريدون | مصر ، @QB@ فأرسلوا واردهم @QE@ ، فبعثوا رجلين : مالك بن دعر ، وعود بن عامر ، إلى الماء | @QB@ فأدلى @QE@ أحدهم @QB@ دلوه @QE@ ، واسمه مالك بن دعر بن مدين بن إبراهيم خليل الرحمن ، | فتعلق يوسف بالدلو ، فصاح مالك @QB@ قال @QE@ ، فقال : يا عود ، للذي يسقي ، وهو عود بن | عامر بن الدرة بن حزام ، @QB@ يا بشرى @QE@ ، يقول : ما مالك أبشر ، @QB@ هذا غلام @QE@ والجب | بواد في أرض الأردن يسمى ادنان 
ms488	 .(@)(@@) فبكي يوسف ، عليه السلام ، وبكي الجب لبكائه ، وبكي مد صوته من الشجر والمدر | PageV02P142 | والحجارة ، وكان اخوته لما دلوه في البئر ، تعلق يوسف في شفة البئر ، فعمدوا إليه | فخلصوا قميصه وأوثقوا يده ، فقال : يا إخوتاه ، ردوا على القميص أتوارى به في البئر ، | فقالوا له : ادع الأحد عشر كوكبا والشمس والقمر يؤنسونك ، فلما انتصف في الجب | ألقوه ، حتى وقع في البئر ، فأدلوه في قعرها ، فأراد أن يموت ، فدفع الله عنه ، ودعا يوسف | ربه حين أخرجه مالك أن يهب لمالك ولدا ، فولد له أربعة وعشرون ولدا .(@)(@@) قوله : ^ ( وأسروه بضعة ) ^ ، يعنى أخفوه من أصحابهم الذين مروا على الماء في | الرفقة ، وقالوا : هو بضاعة لأهل الماء نبيعه لهم بمصر ؛ لأنهم لو قالا : إنا وجدناه أو | اشتريناه ، سألوهما الشركة فيه ، @QB@ والله عليم بما يعملون @QE@ [ آية : 19 ] ، يعنى بما | يقولون من الكذب .(@)(@@) < <(@)(@@) | يوسف : ( 20 ) وشروه بثمن بخس . . . . .(@)(@@) > > يقول الله تعالى : @QB@ وشروه @QE@ ، يعنى وباعوه @QB@ بثمن بخس @QE@ بثمن حرام لا يحل | لهم بيعه ؛ لأنه حر ، وثمن الحر حرام وبيعه حرام ، @QB@ دراهم معدودة @QE@ ، وهي عشرون | درهما ، وكانت العرب تبايع بالأقل ، فإذا كانت أربعين فهي أوقية ، وما كان دون | الأربعين ، فهي دراهم معدودة ، @QB@ وكانوا فيه @QE@ ، يعنى الذين باعوه كانوا في يوسف | @QB@ من الزاهدين @QE@ [ آية : 20 ] حين باعوه ، ولم يعلموا منزلة يوسف عند الله ، ومن أبوه ، | ولو علموا ذلك ما باعوه .(@)(@@) فانطلق القوم حتى أتوا به مصر ، فبينا هو قريب منها ، إذ مر براكب منها يقال له : | مالك بن دعر اللخمي ، قال له يوسف : أين تريد أيها الراكب ؟ قال : أريد أرض كنعان ، | قال : إذا أتيت كنعان ، فأت الشيخ يعقوب فأقرئه السلام ، وصفني له ، وقل له : إني لقيت | غلاما بأرض مصر ، ووصفه له ، وهو يقرئك السلام ، فبكي يعقوب ، عليه السلام ، ثم | قال : هل لك إلى الله حاجة ؟ قال : نعم ، عندي امرأة ، وهي من أحب الخلائق إلي ، لم تلد | مني ولدا قط ، فوقع يعقوب ساجدا ، فدعا الله ، فولد له أربعة وعشرون ذكرا ، وكان | يوسف ، عليه السلام ، بأرض مصر ، فأنزل الله عليهم البركة ، ثم باعه 
ms489	 المشتري من قطفير | بن ميشا ، فقال يوسف : من يشتري ويبشر ، فاشتراه قطفير بن ميشا بعشرين دينارا | PageV02P143 | وزيادة حلة ونعلين ، وأخذ البائع قيمة الدنانير دراهم .(@)(@@) < <(@)(@@) | يوسف : ( 21 ) وقال الذي اشتراه . . . . .(@)(@@) > > @QB@ وقال الذي اشتراه من مصر @QE@ ، وهو قطفير بن ميشا @QB@ لامرأته @QE@ زليخا بنت | يمليخا : @QB@ أكرمي مثواه @QE@ ، يعني أحسني منزلته وولايته ، @QB@ عسى أن ينفعنا @QE@ أو | نصيب منه خيرا ، @QB@ أو نتخذه ولدا وكذلك مكنا ليوسف في الأرض @QE@ الملك | والسلطان في أرض مصر ، @QB@ ولنعلمه من تأويل الأحاديث @QE@ ، يعنى من تعبير الرؤيا ، | @QB@ والله غالب على أمره @QE@ ، يعنى والله متم ليوسف أمره الذي هو كائن مما لا يعلمه | الناس ، فذلك قوله : @QB@ ولكن أكثر الناس لا يعلمون @QE@ [ آية : 21 ] . ذلك | تفسير سورة يوسف من الآية : [ 22 - 35 ] . | PageV02P144(@)(@@) < <(@)(@@) | يوسف : ( 22 ) ولما بلغ أشده . . . . .(@)(@@) > > @QB@ ولما بلغ أشده @QE@ ، يعنى ثماني عشرة سنة ، ^ ( ءاتينه حكما ) ^ ، يقول : أعطيناه فهما ، | @QB@ وعلما وكذلك نجزي المحسنين @QE@ [ آية : 22 ] ، يعنى وهكذا نجزي المخلصين بالفهم | والعلم .(@)(@@) < <(@)(@@) | يوسف : ( 23 ) وراودته التي هو . . . . .(@)(@@) > > @QB@ وراودته التي هو في بيتها عن نفسه وغلقت الأبواب @QE@ على نفسها وعلى | يوسف في أمر الجماع ، @QB@ وقالت هيت لك @QE@ ، يعني هلم لك نفسي ، تريد المرأة | الجماع ، فغلبته بالكلام ، @QB@ قال معاذ الله @QE@ ، يعني أعوذ بالله ، @QB@ إنه ربي أحسن مثواي @QE@ ، يقول : إنه سيدي ، يعني زوجها ، أكرم مثواي ، يعني منزلتي ، @QB@ إنه لا يفلح @QE@ ، يعنى لا يفوز @QB@ الظالمون @QE@ [ آية : 23 ] إن ظلمته في أهله ، وألقى عليها | شهوة أربعين إنسانا .(@)(@@) < <(@)(@@) | يوسف : ( 24 ) ولقد همت به . . . . .(@)(@@) > > @QB@ ولقد همت به @QE@ ، يقول : همت المرأة بيوسف حتى استلقت للجماع ، @QB@ وهم بها @QE@ يوسف حين حل سراويله وجلس بين رجليها ، ^ ( لولا أن رءا برهان ربه ) ^ ، يعنى | آية ربه لواقعها ، والبرهان مثل له يعقوب عاض على إصبعه ، فلما رأى ذلك ، ولي دبرا | واتبعته المرأة ، @QB@ كذلك @QE@ ، يعنى هكذا ، @QB@ لنصرف عنه السوء @QE@ ، يعنى الإثم ، | @QB@ والفحشاء @QE@ ، يعنى المعاصي ، @QB@ إنه من عبادنا المخلصين @QE@ [ آية : 24 ] بالنبوة | والرسالة ، نظيرها : @QB@ إنا أخلصناهم بخالصة ذكرى الدار @QE@ [ ص : 46 ] ، يعنى بالنبوة .(@)(@@) < <(@)(@@) | يوسف : ( 25 ) واستبقا الباب وقدت . . . . .(@)(@@) > > @QB@ واستبقا الباب @QE@ ، يوسف أمامها هارب منها ، وهي ورائه تتبعه لتحبسه على 
ms490	 | نفسها ، فأدركته قبل أن ينتهي إلى الباب ، @QB@ وقدت قميصه من دبر @QE@ ، يقول : فمزقت | قميصه من ورائه حتى سقط القميص عن يوسف ، @QB@ وألفيا @QE@ ، يقول : وجدا ، كقوله : | @QB@ ألفينا عليه آباءنا @QE@ [ البقرة : 170 ] ، يعنى وجدا @QB@ سيدها @QE@ ، يعنى زوجها ، ^ ( لدا | الباب ) ^ ، يعنى عند الباب ومعه ابن عمها يملخا بن أزليخا ، @QB@ قالت ما جزاء من أراد بأهلك سوءا @QE@ ، يعنى الزنا ، @QB@ إلا أن يسجن @QE@ حبسا في نصب ، @QB@ أو عذاب أليم @QE@ | [ آية : 25 ] ، يعنى ضربا وجيعا .(@)(@@) < <(@)(@@) | يوسف : ( 26 ) قال هي راودتني . . . . .(@)(@@) > > ^ ( قال ) ^ يوسف للزوج @QB@ هي راودتني عن نفسي وشهد شاهد من أهلها @QE@ | PageV02P145 | وهو يمليخا ابن عم المرأة ، فتكلم بعقل ولب ، قال : @QB@ إن كان قميصه قد من قبل فصدقت وهو من الكاذبين @QE@ [ آية : 26 ] ، أي إن كان يوسف هو الذي راودها ، فقدت ، | يعني فمزقت قميصه من قبل ، يعنى من قدامه ، فصدقت على يوسف ، ويوسف من | الكاذبين في قوله .(@)(@@) < <(@)(@@) | يوسف : ( 27 ) وإن كان قميصه . . . . .(@)(@@) > > @QB@ وإن كان قميصه قد من دبر فكذبت وهو من الصادقين @QE@ [ آية : 27 ] ، أي وإن كان | يوسف هو الهارب منها ، فأدركته فقدت قميصه من دبر ، فكذبت على يوسف ، ويوسف | من الصادقين في قوله ، وقد سمعا جلبتهما وتمزيق القميص من وراء الباب .(@)(@@) < <(@)(@@) | يوسف : ( 28 ) فلما رأى قميصه . . . . .(@)(@@) > > ^ ( فلما رءا ) ^ الزوج @QB@ قميصه قد من دبر @QE@ ، يقول : مزق من ورائه ، @QB@ قال @QE@ لها : | @QB@ إنه من كيدكن @QE@ ، يقول : تمزيق القميص من فعلكن ، يعنى امرأته ، ثم قال : @QB@ إن كيدكن @QE@ ، يعنى فعلكن @QB@ عظيم @QE@ [ آية : 28 ] ؛ لأن المرأة لا تزال بالرجل حتى يقع في | الخطيئة العظيمة .(@)(@@) < <(@)(@@) | يوسف : ( 29 ) يوسف أعرض عن . . . . .(@)(@@) > > ثم قال الشاهد ليوسف : @QB@ يوسف أعرض عن هذا @QE@ الأمر الذي فعلت بك ، ولا | تذكره لأحد ، ثم أقبل الشاهد على المرأة ، فقال : @QB@ واستغفري لذنبك @QE@ ، يعنى واعتذري | إلى زوجك واستعفيه ألا يعاقبك ، @QB@ إنك كنت من الخاطئين @QE@ [ آية : 29 ] .(@)(@@) < <(@)(@@) | يوسف : ( 30 ) وقال نسوة في . . . . .(@)(@@) > > @QB@ وقال نسوة في المدينة @QE@ ، وهن خمس نسوة : امرأة الخباز ، وامرأة الساقي ، | وامرأة صاحب السجن ، وامرأة صاحب الدواب ، وامرأة صاحب الإذن ، قلن : ^ ( امرأت | العزيز تراود فتاها ) ^ العبراني ، يعني عبدها الكنعاني ، @QB@ عن نفسه قد 
ms491	 شغفها حبا @QE@ ، | يعني غلبها حبا شديدا هلكت عليه ، @QB@ إنا لنراها في ضلال مبين @QE@ [ آية : 30 ] ، يعنى في | خسران بين ، يعنى شقاء من حب يوسف ، عليه السلام ، حتى فشا عليها .(@)(@@) < <(@)(@@) | يوسف : ( 31 ) فلما سمعت بمكرهن . . . . .(@)(@@) > > @QB@ فلما سمعت @QE@ زليخا @QB@ بمكرهن @QE@ ، يعنى بقولهن لها ، @QB@ أرسلت إليهن @QE@ فجئنها ، | ^ ( وأعتدت لهن متكئا ) ^ ، وهو الأترج ، وكل شيء يحز بالسكين فهو متكأ ، ^ ( وءاتت ) ^ | يعني وأعطت @QB@ كل واحدة منهن سكينا @QE@ ، وأمرت يوسف ، عليه السلام ، فتزين وترجل ، | PageV02P146 | وكان أعطى يوسف في زمانه ثلث الحسن ، وآتاه الحسن من قبل جده إسحاق من قبل | أمه سارة ، وورثت سارة حسنها من قبل حواء امرأة آدم ، عليه السلام ، وحسن حواء من | آدم ؛ لأنها خلقت منه .(@)(@@) وقال مقاتل : كل ذكر أحسن من الأنثى من الأشياء كلها ، وفضل يوسف في زمانه | بحسنه على الناس ، كفضل القمر ليلة البدر على الكواكب .(@)(@@) @QB@ وقالت @QE@ ، أي ثم قال : يا يوسف : @QB@ اخرج عليهن @QE@ من البيت ، @QB@ فلما رأينه أكبرنه @QE@ ، يعنى أعظمته ، @QB@ وقطعن أيديهن @QE@ ، يعنى وحززن أصابعهن بالسكين حين نظرن | إليه ، @QB@ وقلن حاش لله @QE@ ، يعنى معاذ الله ، @QB@ ما هذا بشرا @QE@ إنسانا ، @QB@ إن هذا إلا ملك كريم @QE@ [ آية : 31 ] ، يعنى حسن ، فأعجبها ما صنعن وما قلن .(@)(@@) < <(@)(@@) | يوسف : ( 32 ) قالت فذلكن الذي . . . . .(@)(@@) > > @QB@ قالت @QE@ زليخا : ^ ( فذلكن الذي لمتني فيه ) ^ الذي افتتنتن به ، @QB@ ولقد راودته عن نفسه فاستعصم @QE@ ، يعنى فامتنع عن الجماع ، ^ ( ولئن لم يفعل ما ءامره ليسجنن وليكونا من | الصاغرين ) ^ [ آية : 32 ] ، يعنى المذلين .(@)(@@) < <(@)(@@) | يوسف : ( 33 ) قال رب السجن . . . . .(@)(@@) > > قالت النسوة : يا يوسف ، ما يمنعك أن تقضي لها حاجتها ؟ فدعي يوسف ربه ، @QB@ قال رب السجن أحب إلي مما يدعونني إليه @QE@ من الزنا ، حين قلن ليوسف : ما يحملك على ألا | تقضي لها حاجتها ، @QB@ وإلا تصرف عني كيدهن أصب إليهن @QE@ ، يقول : أفضي إليهن ، | @QB@ وأكن من الجاهلين @QE@ [ آية : 33 ] ، يعنى من المذنبين .(@)(@@) < <(@)(@@) | يوسف : ( 34 ) فاستجاب له ربه . . . . .(@)(@@) > > @QB@ فاستجاب له ربه فصرف عنه كيدهن @QE@ ، يعنى مكرهن وشرهن ، @QB@ إنه هو السميع @QE@ لدعاء يوسف ، @QB@ العليم @QE@ [ آية : 34 ] به .(@)(@@) < <(@)(@@) | يوسف : ( 35 ) ثم بدا لهم . . . . .(@)(@@) > > @QB@ ثم بدا لهم @QE@ ، يعنى ثم بدا للزوج @QB@ من 
ms492	 بعد ما رأوا الآيات @QE@ ، يعنى من بعد ما رأوا | العلامات في تمزيق القميص من دبر أنه برئ ، @QB@ ليسجننه حتى حين @QE@ [ آية : 35 ] ، | وذلك أنها قالت لزوجها حين لم يطاوعها يوسف : أحبس يوسف في السجن لا يلج | علي ، فصدقها فحبسته ، فقال له صاحب السجن : من أنت ؟ قال : ولم تسألني من أنا ؟ | قال : لأني أحبك ، قال : أعوذ بالله من حبك ، أحبني والدي ، فلقيت من اخوتي ما لقيت ، | وأحبتني امرأة العزيز ، فلقيت من حبها ما لقيت ، فلا حاجة لي في حب أحد إلا في إلهي | الذي في السماء ، قال : أخبرني من أنت ؟ قال : أنا يوسف نبي الله ، ابن يعقوب صفي الله ، ابن إسحاق ذبيح الله ، ابن إبراهيم خليل الله ، وكان يوسف في السجن يؤنس | الحزين ، ويطمئن الخائف ، ويقوم على المريض ، ويعبر لهم الرؤيا . | PageV02P147 | تفسير سورة يوسف الآية : [ 36 - 57 ] . | PageV02P148(@)(@@) < <(@)(@@) | يوسف : ( 36 ) ودخل معه السجن . . . . .(@)(@@) > > ورقي إلى الملك أن غلامه الخباز يريد أن يجعل في طعامه سما ، ورقي إليه في غلامه | الساقي مثل ذلك ، فذلك قوله : @QB@ ودخل معه السجن فتيان @QE@ ، الخباز والساقي ، اسم | أحدهما شرهم أقم ، وهو الساقي ، واسم الخباز شرهم أشم ، @QB@ قال أحدهما إني أراني @QE@ | في المنام كأني @QB@ أعصر خمرا @QE@ ، يعني عنبا ، قال : كأني دخلت البستان ، فإذا فيه أصل | كرم ، وعليه ثلاث عناقيد ، فكأني أعصرهن وأسقي الملك ، @QB@ وقال الآخر إني أراني @QE@ ، | رأيت في المنام كأني @QB@ أحمل فوق رأسي خبزا @QE@ ، ثلاث سلال ، وأعلاهن جفنة من خبز ، | فوق رأسي ، مثل قوله : @QB@ فاضربوا فوق الأعناق @QE@ [ الأنفال : 12 ] ، ومثل قوله : | @QB@ اجتثت من فوق الأرض @QE@ [ إبراهيم : 26 ] ، يعني أعلا الأرض ، @QB@ تأكل الطير منه نبئنا بتأويله @QE@ ، يقول : أخبرنا بتفسير ما رأينا في المنام ، @QB@ إنا نراك من المحسنين @QE@ | [ آية : 36 ] ، وكان إحسانه في السجن أنه كان يعود مرضاهم ويداويهم ، ويعزي | مكروبهم ، ورآه متعبدا لربه ، فهذا إحسانه .(@)(@@) < <(@)(@@) | يوسف : ( 37 ) قال لا يأتيكما . . . . .(@)(@@) > > @QB@ قال @QE@ يوسف : ألا أخبركما بأعجب من الرؤيا التي رأيتما ، قال : @QB@ لا يأتيكما طعام ترزقانه إلا نبأتكما بتأويله @QE@ ، إلا أخبرتكما بألوانه @QB@ قبل أن يأتيكما @QE@ الطعام ، | فقالوا ليوسف : إنما يعلم هذا 
ms493	 الكهنة والسحرة ، وأنت لست في هيئة ذلك ، فقال يوسف | لهما : @QB@ ذلكما مما علمني ربي إني تركت ملة قوم @QE@ أولئك الكهنة والسحرة ، يعنى أهل | مصر ، @QB@ لا يؤمنون بالله @QE@ ، يعنى لا يصدقون بتوحيد الله ، ولا بالبعث الذي فيه جزاء | الأعمال ، @QB@ وهم بالآخرة هم كافرون @QE@ [ آية : 37 ] .(@)(@@) < <(@)(@@) | يوسف : ( 38 ) واتبعت ملة آبائي . . . . .(@)(@@) > > ^ ( واتبعت ملة ءاباءي إبراهيم وإسحق ويعقوب ما كان لنا أن نشرك بالله من شيء | ذلك من فضل الله علينا وعلى الناس ولكن أكثر الناس لا يشكرون ) ^ [ آية : 38 ] .(@)(@@) < <(@)(@@) | يوسف : ( 39 ) يا صاحبي السجن . . . . .(@)(@@) > > ثم دعاهما إلى الإسلام وهما كافران ، فقال : ^ ( يصحبي السجن ) ^ ، يعني الخباز | والساقي ، ^ ( ءارباب متفرقون خير ) ^ ، أآلهة شتى تعبدون خير ، يعنى أفضل ، @QB@ أم الله @QE@ | PageV02P149 | @QB@ الواحد القهار @QE@ [ آية : 39 ] لخلقه ؛ لأن الآلهة مقهورة ، كقوله في النمل : @QB@ آلله خير أما يشركون @QE@ [ النمل : 59 ] من الآلهة .(@)(@@) < <(@)(@@) | يوسف : ( 40 ) ما تعبدون من . . . . .(@)(@@) > > ثم قال يوسف عليه السلام : @QB@ ما تعبدون من دونه @QE@ من الآلهة ^ ( إلا أسماء | سميتموها أنتم وءاباؤكم ) ^ أنها آلهة ، @QB@ ما أنزل الله بها من سلطان إن الحكم @QE@ ، | يعنى القضاء ، @QB@ إلا لله @QE@ في التوحيد ، @QB@ أمر ألا تعبدوا إلا إياه @QE@ ، يقول : أمر الله أن | يوحد ، ويعبد وحده ، له التوحيد ، @QB@ ذلك الدين القيم @QE@ ، يعنى المستقيم ، وغيره من | الأديان ليس بمستقيم ، @QB@ ولكن أكثر الناس @QE@ ، يعنى أهل مصر ، @QB@ لا يعلمون @QE@ | [ آية : 40 ] بتوحيد ربهم .(@)(@@) < <(@)(@@) | يوسف : ( 41 ) يا صاحبي السجن . . . . .(@)(@@) > > @QB@ يا صاحبي السجن أما أحدكما فيسقي ربه خمرا @QE@ ، وهو الساقي ، قال له يوسف : | تكون في السجن ثلاثة أيام ، ثم تخرج فتكون على عملك ، فتسقي سيدك خمرا ، @QB@ وأما الآخر @QE@ ، وهو الخباز ، @QB@ فيصلب فتأكل الطير من رأسه @QE@ ، واسمه شرهم أشم ، قال | له يوسف : تكون في السجن ثلاثة أيام ، ثم تخرج فتصلب ، فتأكل الطير من رأسك ، | فكره الخباز تعبير رؤياه ، فقال : ما رأيت شيئا ، إنما كنت ألعب ، فقال له يوسف : @QB@ قضي الأمر الذي فيه تستفتيان @QE@ [ آية : 41 ] ، رأيتما أو لم تريا ، فقد وقع بكما ما عبرت | لكما .(@)(@@) < <(@)(@@) | يوسف : ( 42 ) وقال للذي ظن . . . . .(@)(@@) > > @QB@ وقال @QE@ يوسف @QB@ للذي ظن أنه ناج منهما @QE@ من القتل 
ms494	 إضمار ، وهو الساقي : | @QB@ اذكرني عند ربك @QE@ ، يعنى سيدك ، فإنه يسرني أن يخرجني من السجن ، يقول | الله : @QB@ فأنساه الشيطان ذكر ربه @QE@ ، يعنى يوسف دعاء ربه ، فلم يدع يوسف | ربه الذي في السماء ليخرجه من السجن ، واستغاث بعبد مثله ، يعنى الملك ، فأقره الله في | السجن عقوبة حين رجا أن يخرجه غير الله عز وجل ، فذلك قوله : @QB@ فلبث في السجن بضع سنين @QE@ [ آية : 42 ] ، يعنى خمس سنين حتى رأى الملك الرؤيا ، وكان في السجن | قبل ذلك سبع سنين ، وعوقب ببضع سنين ، يعنى خمس سنين ، فكان في السجن اثنتا | عشر سنة ، فذلك قوله : @QB@ ثم بدا لهم من بعد ما رأوا الآيات ليسجننه حتى حين @QE@ | [ يوسف : 35 ] . | PageV02P150(@)(@@) وقال النبي صلى الله عليه وسلم : ' لو أن يوسف ذكر ربه ، ولم يستغث بالملك ، لم يلبث في السجن | بضع سنين ، ولخرج من يومه ذاك ' ، قال : وأتي جبريل يوسف حين استغاث بالملك وترك | دعاء ربه ، فقال له : إن الله يقول لك : يا ابن يعقوب ، من حببك إلى أبيك وأنت | أصغرهم ؟ قال : أنت يا إلهي ، قال : إن الله يقول : من عصمك من الخطيئة وقد هممت | بها ؟ قال : أنت يا إلهي ، قال : فكيف تركتني واستغثت بعبد مثلك ؟ فلما سمع يوسف | ذكر الخطيئة ، قال : يا إلهي ، إن كان خلق وجهي عندك من أجل خطيئتي ، فأسألك بوجه | أبي وجدي أن تغفر لي خطيئتي .(@)(@@) < <(@)(@@) | يوسف : ( 43 ) وقال الملك إني . . . . .(@)(@@) > > @QB@ وقال الملك @QE@ ، وهو الريان بن الوليد ، للملأ من قومه : @QB@ إني أرى سبع بقرات سمان يأكلهن سبع @QE@ ، أي بقرات ، @QB@ عجاف و @QE@ رأيت @QB@ وسبع سنبلات خضر وأخر يابسات @QE@ ، ثم قال : ^ ( يأيها الملأ أفتوني في رءياي ) ^ ، وهم علماء أهل الأرض ، | وكان أهل مصر من أمهر الكهنة والعرافين ، ^ ( إن كنتم للرءيا تعبرون ) ^ [ آية : 43 ] ، | ولم يعلموا تأويل رؤياه .(@)(@@) < <(@)(@@) | يوسف : ( 44 ) قالوا أضغاث أحلام . . . . .(@)(@@) > > ف @QB@ قالوا أضغاث أحلام @QE@ ، يعنى أحلام مختلطة كاذبة ، ثم عملوا أن لها تعبيرا ، | وأنها ليست من الأحلام المختلطة ، فمن ثم قالوا : @QB@ وما نحن بتأويل الأحلام بعالمين @QE@ | [ آية : 44 ] ، وجاءه جبريل ، عليه السلام ، فأخبره أنه يخرج من 
ms495	 السجن غدا ، وأن الملك قد | رأى رؤيا ، فلما نظر يوسف إلى جبريل عليه البياض مكلل باللؤلؤ . قال مقاتل : قال له : | أيها الملك الحسن وجهه ، الطيب ريحه ، الطاهر ثيابه ، الكريم على ربه ، أي رسل ربي | أنت ؟ قال : أنا جبريل ، قال : ما أتى بك ؟ قال : أبشرك بخروجك ، قال : ألك علم بيعقوب | أبي ما فعل ؟ قال : نعم ، ذهب بصره من الحزن عليك .(@)(@@) قال : أيها الملك الحسن وجهه ، الطيب ريحه ، الطاهر ثيابه ، الكريم على ربه ، ما بلغ | من حزنه ؟ قال : بلغ حزنه حزن سبعين مثكلة بولدها ، قال : أيها الملك الحسن وجهه ، | الطيب ريحه ، الطاهر ثيابه ، الكريم على ربه ، فما له من الأجر ؟ قال : أجر مائة شهيد ، | وألف مثكلة موجعة ، قال : أيها الملك الحسن وجهه ، الطيب ريحه ، الطاهر ثيابه ، الكريم | على ربه ، هل رأيت يعقوب ؟ قال : نعم ، قال : أيها الملك من ضم إليه بعدي ؟ قال : أخاك | PageV02P151 | بنيامين ، قال يوسف : يا ليت السباع تقسمت لحمي ولم يلق يعقوب في سبيلي ما لقي .(@)(@@) فلما سمع الساقي رؤيا الملك ، ذكر تصديق عبارة يوسف ، عليه السلام ، في نفسه ، | وفي الخباز ، فذلك قوله : < <(@)(@@) | يوسف : ( 45 ) وقال الذي نجا . . . . .(@)(@@) > > @QB@ وقال الذي نجا منهما @QE@ من القتل @QB@ وادكر بعد أمة @QE@ ، يعني | وذكر بعد حين : @QB@ أنا أنبئكم بتأويله @QE@ ، يعنى بتعبيره ، @QB@ فأرسلون @QE@ [ آية : 45 ] إلى | يوسف .(@)(@@) < <(@)(@@) | يوسف : ( 46 ) يوسف أيها الصديق . . . . .(@)(@@) > > فلما أتى يوسف ، قال له الساقي : @QB@ يوسف أيها الصديق @QE@ ، يعنى أيها الصادق فيما | عبرت لي ولصاحبي ، @QB@ أفتنا في سبع بقرات سمان يأكلهن سبع عجاف وسبع سنبلات خضر وأخر يابسات @QE@ ، قال : أما البقرات السبع السمان ، والسنبلات الخضر ، فهن سبع | سنين مخصبات ، وأما البقرات العجاف السبع ، والسنبلات السبع الأخر اليابسات ، فهن | المجدبات ، ثم قال الساقي : @QB@ لعلي أرجع إلى الناس @QE@ ، يعني أهل مصر ، @QB@ لعلهم @QE@ ، يعنى | لكي @QB@ يعلمون @QE@ [ آية : 46 ] تعبيرها ، يعنى تعبير هذه الرؤيا .(@)(@@) < <(@)(@@) | يوسف : ( 47 ) قال تزرعون سبع . . . . .(@)(@@) > > ثم عملهم كيف يصنعون ، @QB@ قال تزرعون سبع سنين دأبا @QE@ ، يعنى دائبين في الزرع ، ثم | علمهم يوسف ما يصنعون ، فقال : @QB@ فما حصدتم @QE@ من حب ، @QB@ فذروه في سنبله @QE@ ، | فإنه أبقي 
ms496	 له لئلا يأكله السوس ، @QB@ إلا قليلا مما تأكلون @QE@ [ آية : 47 ] ، فتشقونه .(@)(@@) < <(@)(@@) | يوسف : ( 48 ) ثم يأتي من . . . . .(@)(@@) > > @QB@ ثم يأتي من بعد ذلك @QE@ ، يعنى من بعد السنين المخصبات ، @QB@ سبع شداد @QE@ ، يعنى | مجدبات ، @QB@ يأكلن ما قدمتم لهن @QE@ ، يعني ما ذخرتم لهن في هذه السنين الماضية ، | @QB@ إلا قليلا مما تحصنون @QE@ [ آية : 48 ] ، يعنى مما تدخرون فتحرزونه .(@)(@@) < <(@)(@@) | يوسف : ( 49 ) ثم يأتي من . . . . .(@)(@@) > > @QB@ ثم يأتي من بعد ذلك @QE@ ، يعنى من بعد السنين المجدبات ، @QB@ عام فيه يغاث الناس @QE@ ، | يعنى أهل مصر بالمطر ، @QB@ وفيه يعصرون @QE@ [ آية : 49 ] العنب ، والزيت من الخصب ، هذا | من قول يوسف ، وليس من رؤيا الملك ، فرجع الرسول فأخبره فعجب .(@)(@@) < <(@)(@@) | يوسف : ( 50 ) وقال الملك ائتوني . . . . .(@)(@@) > > @QB@ وقال الملك @QE@ واسمه الريان بن الوليد : @QB@ ائتوني به @QE@ ، يعني بيوسف ، @QB@ فلما جاءه الرسول @QE@ ، يعنى رسول الملك ، وهو الساقي ، @QB@ قال @QE@ له : @QB@ ارجع إلى ربك @QE@ ، يعنى | PageV02P152 | سديك ، ^ ( فسئله ما بال النسوة ) ^ الخمس ^ ( التي قطعن أيديهن ) ^ ، يعنى حززن | أصابعهن بالسكين ، @QB@ إن ربي بكيدهن @QE@ ، يعنى بقولهن @QB@ عليم @QE@ [ آية : 50 ] حين قلن : | ما يمنعك أن تقضي لها حاجتها ؟ وأراد يوسف ، عليه السلام ، أن يستبين عذره عند الملك | قبل أن يخرج من السجن ، ولو خرج يوسف حين أرسل إليه الملك قبل أن يبرئ نفسه ، لم | يزل متهما في نفس الملك ، فمن ثم قال : @QB@ قال ارجع إلى ربك فاسأله ما بال النسوة اللاتي قطعن أيديهن إن ربي بكيدهن عليم @QE@ ، فيشهدن أن امرأة العزيز قالت : ^ ( ولقد | راودته عن نفسيه فاستعصم ) ^ [ يوسف : 32 ] .(@)(@@) < <(@)(@@) | يوسف : ( 51 ) قال ما خطبكن . . . . .(@)(@@) > > فلما سألهن الملك ، @QB@ قال @QE@ لهن : @QB@ ما خطبكن @QE@ ، يعنى ما أمركن ، كقوله : @QB@ فما خطبكم أيها المرسلون @QE@ [ الحجر : 57 ] ، يعنى ما أمركم ، @QB@ إذ راودتن يوسف عن نفسه @QE@ ، وذلك أنهن قلن حين خرج عليهن يوسف من البيت : ما عليك أن تقضي لها | حاجتها ؟ فأبي عليهن ، فرددن على الملك ، ^ ( قلن حش لله ) ^ ، يعني معاذ الله ، @QB@ ما علمنا عليه من سوء @QE@ ، يعنى الزنا ، فلما سمعت زليخا قول النسوة ، ^ ( قالت امرأت | العزيز ) ^ عند ذلك ، ^ ( الئن حصحص ) ^ ، يعنى الآن تبين @QB@ الحق أنا راودته عن نفسه وإنه @QE@ يوسف @QB@ لمن 
ms497	 الصادقين @QE@ [ آية : 51 ] في قوله .(@)(@@) < <(@)(@@) | يوسف : ( 52 ) ذلك ليعلم أني . . . . .(@)(@@) > > فأتاه الروسل في السجن ، فأخبره بقول النسوة عند الملك ، قال يوسف : @QB@ ذلك ليعلم @QE@ ، يقول : هذا ليعلم سيده @QB@ أني لم أخنه بالغيب @QE@ في أهله ، ولم أخالفه فيهن ، | @QB@ وأن الله لا يهدي كيد الخائنين @QE@ [ آية : 52 ] ، يعنى لا يصلح عمل الزناة ، يقول : يخذلهم ، | فلا يعصمهم من الزنا ، فأتاه الملك ، وهو جبريل ، بالبرهان الذي رأى ، فقال ليوسف : أين | ما هممت به أولا حين حللت سراويلك وجلست بين رجليها ؟ | فلما ذكر الملك ذلك ، قال عند ذلك : < <(@)(@@) | يوسف : ( 53 ) وما أبرئ نفسي . . . . .(@)(@@) > > @QB@ وما أبرئ نفسي @QE@ ، يعنى قلبي من الهم ، | لقد هممت بها ، @QB@ أن النفس @QE@ ، يعني القلب @QB@ لأمارة بالسوء @QE@ للجسد ، يعنى بالإثم ، | ثم استثنى ، فقال : @QB@ إلا ما رحم ربي @QE@ ، يعني إلا ما عصم ربي ، فلا تأمر بالسوء ، @QB@ إن ربي غفور @QE@ لما هم به من المعصية ، @QB@ رحيم @QE@ [ آية : 53 ] به حين عصمه .(@)(@@) < <(@)(@@) | يوسف : ( 54 ) وقال الملك ائتوني . . . . .(@)(@@) > > @QB@ وقال الملك ائتوني به أستخلصه لنفسي @QE@ ، يعنى اتخذه ، @QB@ فلما @QE@ أتاه يوسف | PageV02P153 | و @QB@ كلمه @QE@ ، أي كلم الملك ، @QB@ قال @QE@ ليوسف : @QB@ إنك اليوم لدينا مكين @QE@ ، يقول : | عندنا وجيه ، @QB@ امين @QE@ [ آية : 54 ] على ما وكلت به ، كقوله : @QB@ عند ذي العرش مكين @QE@ [ التكوير : 20 ] .(@)(@@) < <(@)(@@) | يوسف : ( 55 ) قال اجعلني على . . . . .(@)(@@) > > ثم ^ ( قال ) ^ يوسف للملك : @QB@ اجعلني على خزائن الأرض @QE@ بمصر ، @QB@ إني حفيظ @QE@ | لما وكلتني به @QB@ عليم @QE@ [ آية : 55 ] ، يعنى عالم بلغة الناس كلها . قال مقاتل : قال النبي صلى الله عليه وسلم : ' لو قال : إني حفظ عليم إن شاء الله ، لملك من يومه ذلك ' ، وقال ابن عباس : لبث | بعد ذلك سنة ونصفا ، ثم ملك أرض مصر . وقال مقاتل : قال النبي صلى الله عليه وسلم : ' عجبت من | صبر يوسف وكرمه ، والله يغفر له ، لو كنت أنا لبادرت الباب حين بعث إليه الملك | يدعوه ' .(@)(@@) < <(@)(@@) | يوسف : ( 56 ) وكذلك مكنا ليوسف . . . . .(@)(@@) > > @QB@ وكذلك مكنا ليوسف @QE@ ، يعنى وهكذا مكنا ليوسف الملك @QB@ في الأرض @QE@ ، في | أرض مصر ، ل @QB@ يتبوأ @QE@ ، يقول : ينزل @QB@ منها حيث يشاء نصيب برحمتنا @QE@ ، يعنى سعتنا ، | @QB@ من نشاء ولا نضيع أجر المحسنين @QE@ [ آية 
ms498	 : 56 ] ، يعنى نوفيه جزاءه ، فجزاه الله | بالصبر على البلاء ، والصبر على المعصية بأن ملكه على مصر .(@)(@@) < <(@)(@@) | يوسف : ( 57 ) ولأجر الآخرة خير . . . . .(@)(@@) > > ثم قال : @QB@ ولأجر الآخرة خير @QE@ ، يعنى أكبر ، يعنى جزاء الآخرة أفضل مما أعطى في | الدنيا من الملك ، ^ ( للذين ءامنوا ) ^ ، يعنى صدقوا بالتوحيد ، ^ ( وكانوا يتفقون ) ^ [ آية : 57 ] . | الشرك مثل الذي اتقى يوسف ، عليه السلام . | تفسير سورة يوسف من الآية : [ 58 - 81 ] | PageV02P154(@)(@@) < <(@)(@@) | يوسف : ( 58 ) وجاء إخوة يوسف . . . . .(@)(@@) > > @QB@ وجاء إخوة يوسف @QE@ من أرض كنعان ، @QB@ فدخلوا عليه @QE@ ، أي على يوسف بمصر ، | @QB@ فعرفهم @QE@ يوسف ، @QB@ وهم له منكرون @QE@ [ آية : 58 ] ، يقول : وهم لا يعرفون | يوسف ، فقال : من أنتم ؟ قالوا : نحن بنو يعقوب ، نحن من أهل كنعان ، قال : كم أنتم ؟ | قالوا : نحن أحد عشر ، قال : ما لي لا أرى الأحد عشر ؟ قالوا : واحد منا عند أبينا ، قال : | ولم ذلك ؟ قالوا : إن أخاه لأمه أكله الذئب ، فلذلك تركناه عند أبينا ، فهو يستريح إليه . | PageV02P155 | < <(@)(@@) | يوسف : ( 59 ) ولما جهزهم بجهازهم . . . . .(@)(@@) > > @QB@ ولما جهزهم @QE@ يوسف @QB@ بجهازهم @QE@ ، يعنى في أمر الطعام ، @QB@ قال ائتوني بأخ لكم من أبيكم @QE@ ، يعنى بنيامين ، وكان أخاهم من أبيهم ، وكان أخا يوسف لأبيه وأمه ، @QB@ ألا ترون أني أوفي @QE@ ، يعنى أوفي لكم @QB@ الكيل وأنا خير المنزلين @QE@ [ آية : 59 ] ، وأنا أفضل | من يضيف بمصر .(@)(@@) < <(@)(@@) | يوسف : ( 60 ) فإن لم تأتوني . . . . .(@)(@@) > > @QB@ فإن لم تأتوني به فلا كيل لكم @QE@ ، يعنى فلا بيع لكم @QB@ عندي @QE@ من الطعام ، @QB@ ولا تقربون @QE@ [ آية : 60 ] بلادي .(@)(@@) < <(@)(@@) | يوسف : ( 61 ) قالوا سنراود عنه . . . . .(@)(@@) > > @QB@ قالوا سنراود عنه أباه @QE@ يعقوب ، @QB@ وإنا لفاعلون @QE@ [ آية : 61 ] ذلك بأبيه .(@)(@@) < <(@)(@@) | يوسف : ( 62 ) وقال لفتيانه اجعلوا . . . . .(@)(@@) > > @QB@ وقال @QE@ يوسف @QB@ لفتيانه @QE@ ، يعنى لخدامه وهم يكيلون لهم الطعام : @QB@ اجعلوا بضاعتهم @QE@ يعنى دراهمهم @QB@ في رحالهم @QE@ ، يعنى في أوعيتهم ، @QB@ لعلهم @QE@ ، يعنى لكي | @QB@ يعرفونها إذا انقلبوا إلى أهلهم لعلهم @QE@ ، يعنى لكي @QB@ يرجعون @QE@ [ آية : 62 ] إلينا | فلا يحبسهم عنا حبس الدراهم إذا ردت إليهم ؛ لأنهم كانوا أهل ماشية .(@)(@@) < <(@)(@@) | يوسف : ( 63 ) فلما رجعوا إلى . . . . .(@)(@@) > > @QB@ فلما رجعوا إلى أبيهم قالوا يا أبانا منع منا الكيل @QE@ ، يعنى منع كيل الطعام ، فيه | إضمار فيما يستأنف ، @QB@ فأرسل معنا أخانا 
ms499	 @QE@ بنيامين @QB@ نكتل @QE@ الطعام بثمن ، | @QB@ وإنا له لحافظون @QE@ [ آية : 63 ] من الضيعة .(@)(@@) < <(@)(@@) | يوسف : ( 64 ) قال هل آمنكم . . . . .(@)(@@) > > ^ ( قال ) ^ أبوهم : ^ ( هل ءامنكم عليه إلا كما أمنتكم على أخيه من قبل ) ^ في قراءة | ابن مسعود : هل تحفظونه إلا كما حفظتم أخاه يوسف من قبل بنيامين ، @QB@ فالله خير حافظا @QE@ ، يعنى فالله خير حافظا منكم ، @QB@ وهو أرحم الراحمين @QE@ [ آية : 64 ] ، يعنى أفضل | الراحمين .(@)(@@) < <(@)(@@) | يوسف : ( 65 ) ولما فتحوا متاعهم . . . . .(@)(@@) > > @QB@ ولما فتحوا متاعهم @QE@ ، يعنى حلوا أوعيتهم ، @QB@ وجدوا بضاعتهم @QE@ ، يعنى | دراهمهم ، فيها إضمار ، @QB@ ردت إليهم قالوا يا أبانا ما نبغي @QE@ بعد @QB@ هذه @QE@ إضمار ، | فإنهم قد ردوا علينا الدراهم ، هذه @QB@ بضاعتنا @QE@ ، يعنى دراهمنا @QB@ ردت إلينا ونمير أهلنا @QE@ الطعام ، @QB@ ونحفظ أخانا @QE@ بنيامين من الضيعة ، @QB@ ونزداد @QE@ من أجله @QB@ كيل بعير @QE@ ، وكان أهل مصر يبيعون الطعام على عدة الرجال ، ولا يبيعون على عدة | الدواب ، وكان الطعام عزيزا ، فذلك قوله : @QB@ كيل بعير @QE@ من أجله ، @QB@ ذلك كيل يسير @QE@ [ آية : 65 ] سريع لا حبس فيه .(@)(@@) < <(@)(@@) | يوسف : ( 66 ) قال لن أرسله . . . . .(@)(@@) > > ^ ( قال ) ^ أبوهم : @QB@ لن أرسله معكم حتى تؤتون موثقا من الله @QE@ ، يعنى تعطوني | PageV02P156 | عهدا من الله ، ^ ( لتأتيني به ) ^ ، يعني بنيامين ولا تضيعوه كما ضيعتم أخاه يوسف ، | @QB@ إلا أن يحاط بكم @QE@ ، يعنى يحيط بكم الهلاك فتهلكوا جميعا ، ^ ( فلما ءاتوه موثقهم ) ^ ، | يعنى عهدهم ، ^ ( قال ) ^ يعقوب : @QB@ الله على ما نقول وكيل @QE@ [ آية : 66 ] ، يعنى شهيدا بيني | وبينكم ، نظيرها في القصص : @QB@ والله على ما نقول وكيل @QE@ [ القصص : 28 ] .(@)(@@) < <(@)(@@) | يوسف : ( 67 ) وقال يا بني . . . . .(@)(@@) > > فلما سرح بنيامين معهم ، خشي عليهم العين ، وكان بنوه لهم جمال وحسن ، @QB@ وقال يا بني لا تدخلوا @QE@ مصر @QB@ من باب واحد @QE@ ، يعنى من طريق واحدة ، @QB@ وادخلوا من أبواب متفرقة @QE@ ، من طرق شتى ، ثم قال : @QB@ وما أغني عنكم @QE@ إذا جاء قضاء الله ، ^ ( من الله | من شيء إن الحكم إلا لله ) ^ ، يعنى ما القضاء إلا لله ، @QB@ عليه توكلت @QE@ ، يقول : به أثق ، | @QB@ وعليه فليتوكل المتوكلون @QE@ [ آية : 67 ] ، يعنى به فليثق الواثقون .(@)(@@) < <(@)(@@) | يوسف : ( 68 ) ولما دخلوا من . . . . .(@)(@@) > > @QB@ ولما دخلوا @QE@ مصر @QB@ من حيث أمرهم أبوهم @QE@ من طرق شتى ، أخذ كل واحد | منهم 
ms500	 في طريق على حدة ، يقول الله تعالى @QB@ ما كان @QE@ يعقوب ^ ( يغني عنهم من | الله من شيء إلا حاجة في نفس يعقوب قضها ) ^ ، كقوله : @QB@ ولا يجدون في صدورهم حاجة @QE@ [ الحشر : 9 ] ، وهذا من كلام العرب ، يعنى إلا أمر شجر في نفس يعقوب ، | @QB@ وإنه @QE@ ، يعنى أباهم @QB@ لذو علم لما علمناه @QE@ ؛ لأن الله تعالى علمه أنه لا يصيب بنيه | إلا ما قضي الله عليهم ، @QB@ ولكن أكثر الناس لا يعلمون @QE@ [ آية : 68 ] .(@)(@@) < <(@)(@@) | يوسف : ( 69 ) ولما دخلوا على . . . . .(@)(@@) > > ^ ( ولما دخلوا على يوسف ءاوى إليه أخاه ) ^ ، يعنى ضم إليه أخاه ، @QB@ قال إني أنا أخوك فلا تبتئس بما كانوا يعملون @QE@ [ آية : 69 ] ، يقول : فلا تحزن بما سرقوك | وجاءوا بالدراهم التي كانت في أوعيتهم فردوها إلى يوسف ، عليه السلام .(@)(@@) < <(@)(@@) | يوسف : ( 70 ) فلما جهزهم بجهازهم . . . . .(@)(@@) > > @QB@ فلما جهزهم بجهازهم @QE@ ، يقول : فلما قضي في أمر الطعام حاجتهم ، @QB@ جعل السقاية @QE@ ، وهي الإناء الذي يشرب به الملك ، @QB@ في رحل أخيه @QE@ بنيامين ، @QB@ ثم أذن مؤذن @QE@ ، يعنى نادى مناد ، اسمه بعرايم بن بربري ، من فتيان يوسف : @QB@ أيتها العير @QE@ ، | يعني الرفقة ، ^ ( إنكم لسرقون ) ^ [ آية : 70 ] فانقطعت ظهورهم وساء ظنهم .(@)(@@) < <(@)(@@) | يوسف : ( 71 ) قالوا وأقبلوا عليهم . . . . .(@)(@@) > > ف @QB@ قالوا وأقبلوا عليهم @QE@ ، فيها تقديم وأقبلوا على المنادي ، ثم قالوا : @QB@ ماذا تفقدون @QE@ [ آية : 71 ] . | PageV02P157(@)(@@) < <(@)(@@) | يوسف : ( 72 ) قالوا نفقد صواع . . . . .(@)(@@) > > @QB@ قالوا @QE@ المنادي ومن معه لإخوة يوسف : @QB@ نفقد صواع الملك @QE@ ، يعنى إناء | الملك ، وكان يكال به كفعل أهل العساكر ، @QB@ ولمن جاء به حمل بعير @QE@ ، يعنى وقر | بعير ، @QB@ وأنا به زعيم @QE@ [ آية : 72 ] ، يعنى به كفيل .(@)(@@) < <(@)(@@) | يوسف : ( 73 ) قالوا تالله لقد . . . . .(@)(@@) > > فرد الاخوة القول على المنادي ، @QB@ قالوا تالله لقد علمتم ما جئنا لنفسد في الأرض @QE@ ، يعنى أرض مصر بالمعاصي ، @QB@ وما كنا سارقين @QE@ [ آية : 73 ] ، وقد رددنا | عليكم الدراهم التي كانت في أوعيتنا ، ولو كنا سارقين ما رددناها عليكم .(@)(@@) < <(@)(@@) | يوسف : ( 74 ) قالوا فما جزاؤه . . . . .(@)(@@) > > @QB@ قالوا @QE@ ، أي المنادي ومن معه : @QB@ فما جزاؤه @QE@ ، أي السارق ، @QB@ إن كنتم كاذبين @QE@ [ آية : 74 ] .(@)(@@) < <(@)(@@) | يوسف : ( 75 ) قالوا جزاؤه من . . . . .(@)(@@) > > @QB@ قالوا جزاؤه من وجد في رحله @QE@ ، يعنى في وعائه ، يعنى المتاع ، @QB@ فهو 