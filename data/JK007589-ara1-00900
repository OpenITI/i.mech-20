ms881	 الأمثال % % 14(@)(@@) % ملك تنافست العلا في عمره % وتنافست في يومه الآجال % 15(@)(@@) % من لم يعاين سير نعش محمد % لم يدر كيف تسير الأجبال % 16(@)(@@) % ياحفرة غلبت عليه جنة % كانت به وبنفسها تختال % 17(@)(@@) % الآن أيقن من يشك ويمتري % % أن البقاع من البقاع تدال % 18(@)(@@) % إما أصيب فللنجوم مغاور % تغتالهن وللجبال زوال % 19(@)(@@) % ولقد يعزينا عليه أنه % وافى كمال العمر منه كمال % 20(@)(@@) % أسد مضى وتخلفت أشباله % % وعلي أن تستأسد الأشبال % PageV01P3493 21(@)(@@) % ولما حظيت بعرفه ولقد جرت % بوفاته محن علي ثقال % % 22(@)(@@) % وخلوت مما ناله من ماله % % غيري وقد شقيت به الأموال % 23(@)(@@) % ولما عرضت له فخاب تعرضي % % لكن عففت وألحف السؤال % 24(@)(@@) % وذخرته للدهر أعلم أنه % % كالحصن فيه لمن يؤول مآل % 25(@)(@@) % وتمتعت نفسي بروح رجائه % % زمنا طويلا والتمتع مال % 26(@)(@@) % فرأيته كالشمس إن هي لم تنل % % فضياؤها والرفق فيه ينال % 27(@)(@@) % والحق يأمر أن يقال وحقه % % أن لا يخالف أمره القوال % 28(@)(@@) % لهفي لفقدك يامحمد إنه % % فقدت به النفحات والأنفال % % 29(@)(@@) % بالله أقسم أن عمرك ماانقضى % % حتى انقضى الإحسانوالإجمال % 30(@)(@@) % صلى الغدو عليك والآصال % وتغمدتك بظلها الأظلال % PageV01P3494 31(@)(@@) % وبكتك أوعية الدموع وتارة % غيث كعرفك مسبل هطال % % 32(@)(@@) % وعفا الثرى عن حر وجه لم يزل % حر اللقاء إذا عرا السؤال % 33(@)(@@) % وتماسكت أوصال كف لم تزل % بنوالها تتماسك الأوصال % % 34(@)(@@) % يازينة الدنيا وزينة أهلها % % وثمال من أعيا عليه ثمال % % 35(@)(@@) % حالت بدارك بعدك الأحوال % وتغولت بقطينها الأغوال % 36(@)(@@) % وبكاك من بستان قصرك زاهر % لثناك من نفحاته أشكال % 37(@)(@@) % وبكت حمائمه وعاد غناؤها % % نوحا يهاج بمثله البلبال % % 38(@)(@@) % أعزز علي بمنزلاتك أن غدت % تبكي السروج لهن والأجلال % 39(@)(@@) % أعزز علي بصافناتك أن غدت % تبكي السروج لهن والأجلال % % 40(@)(@@) % أعزز علي بعارفاتك أن غدت % يبكي الرجاء لهن والتأمال % PageV01P3495 41(@)(@@) % أعزز علي بأصدقائك أن غدوا % % ولشخصك الغالي بهم إخلال % 42(@)(@@) % أصقال كل مروءة مجفوة % ماللمروءة مذ أفلت صقال % 43(@)(@@) % أصبحت بعد منافح ومجامر % لثرى يهال عليك أو ينهال % 44(@)(@@) % أما وحليتك المذالة للبلى 
ms882	 % % فاذهب فكل مصونة ستذال % % PageV01P3496 البحر : - 1(@)(@@) % طرفت عيون الغانيات وربما % % أمالت إلي الطرف كل مميل % 2(@)(@@) % وماشبت إلا شيبة غير أنه % % قليل قذاة العين غير قليل % 3(@)(@@) % وإذا شبابك بت منك حباله % بتت له منك النساء حبالها % % 3(@)(@@) % كم خلة لي صارمتني بعده % % لو كان أوجدني بها أبدالها % % 3(@)(@@) % فالآن حق لي البكاء على الذي % % كان المضمن عطفها ووصالها % % 3(@)(@@) % قد كنت أبكي من صريمة خلة % كان الشباب معوضي أمثالها % % 3(@)(@@) % لاشيء إلا وفيه أحسنهالكاملقد كنت أبكي من صريمة خلة كان الشباب معوضي أمثالها فالآن حق لي البكاء على الذيكان المضمن عطفها ووصالها وعلى الذي لو كان أخلف خلةمن خلة أو ردها فامالها كم خلة لي صارمتني بعدهلو كان أوجدني بها أبدال % فالعين منه إليه تنتقل % 4(@)(@@) % فوائد العين منه طارفة % كأنما أخرياتها الأول % PageV01P3497 البحر : - 1(@)(@@) % لايهنىء الناس مايرعون من كلأ % ومايريحون من أهل ومن مال % 2(@)(@@) % بعد ابن زرعة الثاوي ببلقعة % أمسى ببلدة لاعم ولاخال % 3(@)(@@) % ياويح للأرض أضحى ظهرها عطلا % من ابن زرعة لكن بطنها حالي % % 4(@)(@@) % لئن جلا وأقمنا إنه لفتى % أمسى وكل مقيم بعده جالي % % 5(@)(@@) % أما لئن هيج بلبال القلوب به % % لكم كفاها قديما هيج بلبال % 6(@)(@@) % من لم تلد مثله أرض ولاثكلت % والأرض جد ولود جد مثكال % % 7(@)(@@) % نأى ولم ينأ نأيا ينطوي أبدا % لزائريه بنص أو بإرقال % 8(@)(@@) % وماأخ بقريب حين تحجبه % % نبائث الأرض في منهالة الجال % 9(@)(@@) % إذا الثرى قيد نصف الرمح غيبه % % فقد هوى في مهاو ذات أهوال % 10(@)(@@) % حسب الخليلين نأي الأرض بينهما % % هذا عليها وهذا نحتها بالي % % PageV01P3498 البحر : - 1(@)(@@) % ياحسن الوجه والشمائل وال % % أخلاق والرأي والأفاعيل % 2(@)(@@) % مابال غيري يحظى لديك ولا % % أحظى بشيء سوى التعاليل % 3(@)(@@) % ولو تخليت من علائق تأ % % ميلك قفيت بالأباطيل % 4(@)(@@) % لكنني فيك غير ماعطل % من حسن ظن وبعد تأميل % % 5(@)(@@) % وماأحابيك في المديح ولا % % شيدت معاليك بالأقاويل % 6(@)(@@) % صلني برزقي وفائتي صلة % ألذ من نشطة السراويل % 7(@)(@@) % بلا دفاع ولا مماطلة % معجلا ذاك 
ms883	 كل تعجيل % 8(@)(@@) % ولاتكن مثل معشر جعلوا % % أعراضهم فدية المناذيل % % 9(@)(@@) % بحق ذاك الذي يقوم مقا % % م التاج للملك والأكاليل % % 10(@)(@@) % لابل مقام السلاح ذلقه الص % صيقل للفتية البهاليل % % PageV01P3499 11(@)(@@) % لا بل مقام الدفاع والطفر ال % % حاضر في ساعة البلابيل % % 12(@)(@@) % يمنا ورأيا مجنبا أبدا % كل ضلال وكل تضليل % 13(@)(@@) % سيدنا بدرنا مؤملنا % % واحدنا في الفعال والقيل % 14(@)(@@) % أبي الحسين الذي به رجعت % محاسن الملك بعد تبديل % 15(@)(@@) % ملأه الله ماحباه به % % لابزوال ولابتحويل % 16(@)(@@) % ممتعا بالصفاء منك وبال % % إخلاص يجزيك غير تأجيل % % 17(@)(@@) % موفقا فيك للصنائع يسدي % % ن مافاض ساحل النيل % % 18(@)(@@) % ألبسك الله يا أبا عمر % % ثوب بهاء وتاج تبجيل % 19(@)(@@) % يامن إذا مااجتباه منتقد % دل على حكمة وتحصيل % % 20(@)(@@) % خذ صلة من أخيك كافية % يلقاك مابعدها بتفصيل % PageV01P3500 21(@)(@@) % راجحة الوزن وهي شائلة % عن قدرك الراجح المثاقيل % % 22(@)(@@) % من قول حر مخول لك بال % % إحسان توليه كل تخويل % % 23(@)(@@) % قال ببعض الذي منحت ولم % % يمدحك بالزور والتهاويل % % 24(@)(@@) % ولاتزل من لبوس عافية متقارببنات ثوابة ما في الأنام أخلق منكم ولا أثقلجمعتم لشقوتكم أبنةإلي ثقل ماله محلثقلتم فلو كنتم تنكحون باتت نساؤكم تطحل ولكن خلقكم بلطف اللطيفلأن تحملوا لا لأن تحملوا وكان البغاء دواء الثقيل كيم % % وستر نعماء في سرابيل % % 24(@)(@@) % أطاقت براذينكم حملكم % % لأن البهائم لا تعقل % 24(@)(@@) % الم تروا الأرض إذ ثقلت % كتثقيلكم خلقت تجمل % 24(@)(@@) % وكان البغاء دواء الثقي % % ل كيما يكون هو الأسفل % 24(@)(@@) % ولكن خلقكم بلطف اللطيف % لأن تحملوا لا لأن تحملوا % % 24(@)(@@) % ثقلتم فلو كنتم تنكحو % % ن باتت نساؤكم تطحل % 24(@)(@@) % بنات ثوابة ما في الأنا % % م أخلق منكم ولا أثقل % PageV01P3501 24(@)(@@) % ولل في خلقه حكمة % بها خول الناس ما خولوا % % 24(@)(@@) % جمعتم لشقوتكم أبنة % إلي ثقل ماله محل % PageV01P3502 البحر : - 1(@)(@@) % مااستشرفت منك العيون ضئيلا % % لكن عظيما في الصدور جليلا % % 2(@)(@@) % أقبلت في خلع الولاية طالعا % والناس حولك يوفضون قبيلا % % 3(@)(@@) % فكأنك البدر المنير مكللا % من طالعات سعوده إكليلا % % 4(@)(@@) % كم من غليل 
ms884	 يوم ذلك هجته % لازلت في صدر الحسود غليلا % % 5(@)(@@) % من كان حمله لبوس ولا ية % وأعازه التعظيم والتبجيلا % % 6(@)(@@) % فبذات نفسك مايكون جمالها % % وبمائه كان الحسام صقيلا % % 7(@)(@@) % تبا لمن تعمي بصيرة رأيه % حتى يراك بما سواك نبيلا % % 8(@)(@@) % إني لأكبر أن أراك مهنأ % إلا بما يتجاوز التأميلا % % 9(@)(@@) % لأحق منك بأن يهنأ معشر % رزقوك حظا في الحظوظ جزيلا % % 10(@)(@@) % أنصفتهم وأقمت عدلك فيهم % ميزان قسط لا يميل مميلا % % PageV01P3503 11(@)(@@) % فهدت عيونهم وأفرخ روعهم % % وأقام منهم من أراد رحيلا % % 12(@)(@@) % من بعد ماسأل الحميم حميمه % مابال دفك بالفراش مذيلا % % 13(@)(@@) % لايعدموك فقد نصحت إمامهم % % ووضعت إصرهم وكان ثقيلا % % 14(@)(@@) % أرفقتهم في خرجهم ووفرتهم % % وكذا المدر يقدم التحفيلا % % 15(@)(@@) % فتنافسوا بك في العمارة بعدما % % طال العداء فعطلت تعطيلا % % 16(@)(@@) % فقضاك ريع العدل ماأعطيتهم % % أوفى قضاء واصطنعت جميلا % % 17(@)(@@) % والعدل مغزرة لكل حلوبة % والجور يعقب رسلها تشويلا % % 18(@)(@@) % لم لاتكون لدى إمامك مرتضى % لاينبغي بك في الكفاة بديلا % % 19(@)(@@) % وإذا وليت فليس يعدم قائلا % ماكان رأي إمامنا ليفيلا % % 20(@)(@@) % تجبي له مال البلاد وحمدها % % إذ لاتضيع من الحقوق فتيلا % % PageV01P3504 21(@)(@@) % قال الإمام وقد جمعتهما له % % حظان مثلهما بمثلك نيلا % % 22(@)(@@) % أنت الذي يمري اللقاح برفقه % ملء الوطاب ولا يجيع فصيلا % % 23(@)(@@) % أسمعته شكر الرعية بعدما % % جار الولاة فأسمعوه عويلا % % 24(@)(@@) % كسبت له التجوير قبلك عصبة % فكسبت بعدهم له التعديلا % % 25(@)(@@) % ولقد قطعت إليه كل حبالة % % لايستطيع لها الدهاة حويلا % % 26(@)(@@) % ولقد ركبت إليه كل مخوفة % لو زل راكبها لطاح قتيلا % % 27(@)(@@) % ووهبت نفسك للمتالف دونهم مااستشرفت منك العيون ضئيلا % % لكن عظيما في الصدور جليلا % % 28(@)(@@) % أقبلت في خلع الولاية طالعا % والناس حولك يوفضون قبيلا % % 29(@)(@@) % فكأنك البدر المنير مكللا % من طالعات سعوده إكليلا % % 30(@)(@@) % كم من غليل يوم ذلك هجته % لازلت في صدر الحسود غليلا % % PageV01P3505 31(@)(@@) % من كان حمله لبوس ولا ية % وأعازه التعظيم والتبجيلا % % 32(@)(@@) % فبذات نفسك مايكون جمالها % % وبمائه كان الحسام صقيلا % % 33(@)(@@) % تبا لمن تعمي بصيرة رأيه % حتى يراك 
ms885	 بما سواك نبيلا % % 34(@)(@@) % إني لأكبر أن أراك مهنأ % إلا بما يتجاوز التأميلا % % 35(@)(@@) % لأحق منك بأن يهنأ معشر % رزقوك حظا في الحظوظ جزيلا % % 36(@)(@@) % أنصفتهم وأقمت عدلك فيهم % ميزان قسط لا يميل مميلا % % 37(@)(@@) % فهدت عيونهم وأفرخ روعهم % % وأقام منهم من أراد رحيلا % % 38(@)(@@) % من بعد ماسأل الحميم حميمه % مابال دفك بالفراش مذيلا % % 39(@)(@@) % لايعدموك فقد نصحت إمامهم % % ووضعت إصرهم وكان ثقيلا % % 40(@)(@@) % أرفقتهم في خرجهم ووفرتهم % % وكذا المدر يقدم التحفيلا % % PageV01P3506 41(@)(@@) % فتنافسوا بك في العمارة بعدما % % طال العداء فعطلت تعطيلا % % 42(@)(@@) % فقضاك ريع العدل ماأعطيتهم % % أوفى قضاء واصطنعت جميلا % % 43(@)(@@) % والعدل مغزرة لكل حلوبة % والجور يعقب رسلها تشويلا % % 44(@)(@@) % لم لاتكون لدى إمامك مرتضى % لاينبغي بك في الكفاة بديلا % % 45(@)(@@) % وإذا وليت فليس يعدم قائلا % ماكان رأي إمامنا ليفيلا % % 46(@)(@@) % تجبي له مال البلاد وحمدها % % إذ لاتضيع من الحقوق فتيلا % % 47(@)(@@) % قال الإمام وقد جمعتهما له % % حظان مثلهما بمثلك نيلا % % 48(@)(@@) % أنت الذي يمري اللقاح برفقه % ملء الوطاب ولا يجيع فصيلا % % 49(@)(@@) % أسمعته شكر الرعية بعدما % % جار الولاة فأسمعوه عويلا % % 50(@)(@@) % كسبت له التجوير قبلك عصبة % فكسبت بعدهم له التعديلا % % PageV01P3507 51(@)(@@) % ولقد قطعت إليه كل حبالة % % لايستطيع لها الدهاة حويلا % % 52(@)(@@) % ولقد ركبت إليه كل مخوفة % لو زل راكبها لطاح قتيلا % % 53(@)(@@) % ووهبت نفسك للمتالف دونهه % % ورأيت ذلك في الإمام قليلا % % 54(@)(@@) % شهد الخليفة والرعية أنه % % ماكان جولكم عند ذلك مهيلا % % 55(@)(@@) % شهد الخليفة والرعية أنه % % ماكان رأيك عند ذاك سحيلا % % 56(@)(@@) % أنت الذي قطع الحبائل بعدما % % أزمت أزام وعضلت تعضيلا % % 57(@)(@@) % فنجوت من أيدي الأخابث سالما % ورهنتهم لهفا عليك طويلا % % 58(@)(@@) % ولئن نجوت لقد ركبت عزيمة % حذاء تسبق داعرا وجديلا % % 59(@)(@@) % وأجلت رأيا أحوذيا مثله % فيما ينوب من الخطوب أجيلا % % 60(@)(@@) % ولقل ماينجو امرؤ من مثلها % % بالرأي إلا أن يكون أصيلا % % PageV01P3508 61(@)(@@) % دبرت تدبير المدبر إنه % % ماكان عند مضلة ضليلا % % 62(@)(@@) % بل كنت للملك السعيد وديعة % أمر الإله بحفظها جبريلا % % 63(@)(@@) % بل ذا وذاك وإن وهبت لأمة 
ms886	 % تعفو فضولكوأصيلا % % 64(@)(@@) % ولقد بلاك الطالبون فثبطوا % % أن يدركوك وخذلوا تخذيلا % % 65(@)(@@) % ورأوا مكانك ريثما أخليته % كمكان بعض الراسيات أزيلا % % 66(@)(@@) % فسروا على حرد إليك وأعملوا % % طلبا يحث به الرعيل رعيلا % % 67(@)(@@) % فسترت دونهم بستر كثافة % حتى خفيت وما خفيت ضئيلا % % 68(@)(@@) % فثنوا أعنة راجعين بخيبة % كرجوعهم أيام ساقوا الفيلا % % 69(@)(@@) % ولعلهم لو أدركوك لأرسلت % طير العذاب عليهم السجيلا % % 70(@)(@@) % ولما خفيت بأن وجهك لم يكن % % في كل ليل دامس قنديلا % % PageV01P3509 71(@)(@@) % لكن بأن خالوا بدرا باهرا % وإذا أخال شبيه شيء خيلا % % 72(@)(@@) % ماقدر ليل أن تكون لبسته % فاختين نورك تحته واغتيلا % % 73(@)(@@) % أنى تجلك الدجى بأبدرها % % لن تستطيع لك الدجى تجليلا % % 74(@)(@@) % ولما خفيت بأن نشرك لم ينل % أقصى مدى نشر ونيف ميلا % % 75(@)(@@) % لكن بأن حسبوه ريا روضة % هبت لها ريح الشمال بليلا % % 76(@)(@@) % والله ثبطهم بذاك فكذبوا % % فيك اليقين وصدقوا التخبيلا % % 77(@)(@@) % كم ليلة نسي الصباح مساؤها % % قد بت فيها بالسهاد كحيلا % % 78(@)(@@) % مانمت نوم غريرة في خدرها % % لكن سريت سرى الرجال رجيلا % % 79(@)(@@) % ولعمر جمع الزنج يوم لقيتهم % % ماصادفوك يراعة إجفيلا % % 80(@)(@@) % شهدت بذلك في جبينك ضربة % كانت على صدق اللقاء دليلا % % PageV01P3510 81(@)(@@) % تركت بوجهك للحفيظة ميسما % مارجعت ورق الحمام هديلا % % 82(@)(@@) % من بعد ما غادرتهم وكأنما % % قعرت بهم عصف الرياح نخيلا % % 83(@)(@@) % مازلت تنكؤهم بحد شائك % لم تألهم قرحا ولاتقتيلا % % 84(@)(@@) % تقريهم طعنا أبج وتارة % ضربا يزيل بينهم تزييلا % % 85(@)(@@) % حتى إذا ألب الجميع وأللوا % % تلقاء نحرك حدهم تأليلا % % 86(@)(@@) % أسروك إذ كثروك لالعزيمة % فشلت عليك ولالصبر عيلا % % 87(@)(@@) % لكن رموك بدهمهم وكأنهم % % جيش أجاب دعاء إسرافيلا % % 88(@)(@@) % فانقدت طوع الحزم لامستقتلا % خرقا ولاسلس القياد ذليلا % % 89(@)(@@) % ورأيت أن تبقى لهم فتكيدهمم مااستشرفت منك العيون ضئيلا % % لكن عظيما في الصدور جليلا % % 90(@)(@@) % أقبلت في خلع الولاية طالعا % والناس حولك يوفضون قبيلا % % PageV01P3511 91(@)(@@) % فكأنك البدر المنير مكللا % من طالعات سعوده إكليلا % % 92(@)(@@) % كم من غليل يوم ذلك هجته % لازلت في صدر الحسود غليلا % % 93(@)(@@) % من كان 
ms887	 حمله لبوس ولا ية % وأعازه التعظيم والتبجيلا % % 94(@)(@@) % فبذات نفسك مايكون جمالها % % وبمائه كان الحسام صقيلا % % 95(@)(@@) % تبا لمن تعمي بصيرة رأيه % حتى يراك بما سواك نبيلا % % 96(@)(@@) % إني لأكبر أن أراك مهنأ % إلا بما يتجاوز التأميلا % % 97(@)(@@) % لأحق منك بأن يهنأ معشر % رزقوك حظا في الحظوظ جزيلا % % 98(@)(@@) % أنصفتهم وأقمت عدلك فيهم % ميزان قسط لا يميل مميلا % % 99(@)(@@) % فهدت عيونهم وأفرخ روعهم % % وأقام منهم من أراد رحيلا % % 100(@)(@@) % من بعد ماسأل الحميم حميمه % مابال دفك بالفراش مذيلا % % PageV01P3512 101(@)(@@) % لايعدموك فقد نصحت إمامهم % % ووضعت إصرهم وكان ثقيلا % % 102(@)(@@) % أرفقتهم في خرجهم ووفرتهم % % وكذا المدر يقدم التحفيلا % % 103(@)(@@) % فتنافسوا بك في العمارة بعدما % % طال العداء فعطلت تعطيلا % % 104(@)(@@) % فقضاك ريع العدل ماأعطيتهم % % أوفى قضاء واصطنعت جميلا % % 105(@)(@@) % والعدل مغزرة لكل حلوبة % والجور يعقب رسلها تشويلا % % 106(@)(@@) % لم لاتكون لدى إمامك مرتضى % لاينبغي بك في الكفاة بديلا % % 107(@)(@@) % وإذا وليت فليس يعدم قائلا % ماكان رأي إمامنا ليفيلا % % 108(@)(@@) % تجبي له مال البلاد وحمدها % % إذ لاتضيع من الحقوق فتيلا % % 109(@)(@@) % قال الإمام وقد جمعتهما له % % حظان مثلهما بمثلك نيلا % % 110(@)(@@) % أنت الذي يمري اللقاح برفقه % ملء الوطاب ولا يجيع فصيلا % % PageV01P3513 111(@)(@@) % أسمعته شكر الرعية بعدما % % جار الولاة فأسمعوه عويلا % % 112(@)(@@) % كسبت له التجوير قبلك عصبة % فكسبت بعدهم له التعديلا % % 113(@)(@@) % ولقد قطعت إليه كل حبالة % % لايستطيع لها الدهاة حويلا % % 114(@)(@@) % ولقد ركبت إليه كل مخوفة % لو زل راكبها لطاح قتيلا % % 115(@)(@@) % ووهبت نفسك للمتالف دونه % ورأيت ذلك في الإمام قليلا % % 116(@)(@@) % شهد الخليفة والرعية أنه % % ماكان جولكم عند ذلك مهيلا % % 117(@)(@@) % شهد الخليفة والرعية أنه % % ماكان رأيك عند ذاك سحيلا % % 118(@)(@@) % أنت الذي قطع الحبائل بعدما % % أزمت أزام وعضلت تعضيلا % % 119(@)(@@) % فنجوت من أيدي الأخابث سالما % ورهنتهم لهفا عليك طويلا % % 120(@)(@@) % ولئن نجوت لقد ركبت عزيمة % حذاء تسبق داعرا وجديلا % % PageV01P3514 121(@)(@@) % وأجلت رأيا أحوذيا مثله % فيما ينوب من الخطوب أجيلا % % 122(@)(@@) % ولقل ماينجو امرؤ من مثلها % % بالرأي إلا أن يكون أصيلا % % 123(@)(@@) % دبرت 
