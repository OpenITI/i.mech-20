ms1681	 يزيد الثقفي(@)(@@) يروي عن سهل مولى المغيرة والكوفيين، روى عنه أبو كريب.(@)(@@)(@@)(@@) ||| AUTO مؤمل بن عبد الرحمن الثقفي(@)(@@) يروي عن الزهري، روى عنه يونس بن عبد الرحيم الرملي، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO مؤمل بن خارجة بن مصعب(@)(@@) من أهل سرخس، يروي عن شعبة، روى عنه المغيث بن يزيد، مستقيم الحديث ممن يغرب.(@)(@@)(@@)(@@) ||| AUTO مؤمل بن الفضل بن مجاهد بن عمير المخزومي(@)(@@) مولى خالد بن الوليد، هو حراني، كنيته أبو سعيد، يروي عن عبيد الله بن عمر وموسى بن أعين، روى عنه محمد بن يحيى الذهلي وأهل بلده، مات سنة تسع وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO مؤمل بن هشام اليشكري، أبو هشام(@)(@@) من أهل البصرة، يروي عن إسماعيل ابن علية والبصريين، روى عنه ابن خزيمة وغيره، مات سنة خمسين ومائتين أو قبلها أو بعدها بقليل.(@)PageV01P002(@)(@@) [ج 5: ص 529](@)(@@)(@@)(@@) ||| AUTO مؤمل بن إهاب بن قفل بن سدك المكي، أبو عبد الرحمن(@)(@@) يروي عن يزيد بن هارون، حدثنا عنه ابن جوصاء وغيره من شيوخنا، مات سنة ستين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO مزاحم بن العوام بن مزاحم القيسي(@)(@@) يروي عن الأوزاعي، روى عنه عمرو بن عاصم وإبراهيم بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO مجاهد بن راشد النهدي(@)(@@) أخو مخول بن راشد، وهو الذي يقال له: مجاهد بن أبي المجالد، من أهل الكوفة، يروي عن أبيه، روى عنه إسرائيل والكوفيون.(@)(@@)(@@)(@@) ||| AUTO مجاهد بن موسى، أبو علي المخرمي(@)(@@) من أهل بغداد، يروي عن يزيد بن هارون والعراقيين، حدثنا عنه محمد بن الحسين بن مكرم البزاز بالبصرة وغيره من شيوخنا، مات يوم الجمعة لتسع بقين من رمضان سنة أربع وأربعين ومائتين، وكان عسر الحفظ، وهو الذي يقال له: مجاهد بن موسى الختلي، كان أصله من ختل خراسان.(@)(@@)(@@)(@@) ||| AUTO مطر بن عبد الرحمن الأعنق، أبو عبد الرحمن(@)(@@) من أهل البصرة، يروي المقاطيع، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO مطر بن الفضل(@)(@@) شيخ، يروي عن وكيع، روى عنه أحمد بن حمويه الأندراني، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO مطر بن العلاء الفزاري(@)(@@) من أهل الشام، يروي المقاطيع، روى 
ms1682	 عنه سليمان بن عبد الرحمن الدمشقي.(@)PageV01P002(@)(@@) [ج 5: ص 530](@)(@@)(@@)(@@) ||| AUTO مطر بن محمد بن الضحاك السكري(@)(@@) من أهل واسط، يروي عن يزيد بن هارون، حدثنا عنه ابن خزيمة، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO مرزوق بن نافع(@)(@@) يروي عن صالح بن جبير، عداده في أهل الشام، روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO مرزوق بن ميمون الناجي، كنيته أبو بكر(@)(@@) من أهل البصرة، يروي عن حميد بن أبي حميد الخياط، عن الحسن ويروي عن ابن عجلان، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO مبارك بن سعيد اليمامي(@)(@@) من أهل اليمن، يروي عن يحيى بن أبي كثير، روى عنه أهل اليمامة المقاطيع.(@)(@@)(@@)(@@) ||| AUTO مبارك بن سعيد بن مسروق الثوري، أبو عبد الرحمن الأعمى(@)(@@) من أهل الكوفة أخو سفيان، يروي عن أبيه وأخيه، روى عنه الحسن بن عرفة والعراقيون، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO مبارك العيشي(@)(@@) والد عبد الرحمن بن المبارك، من أهل البصرة، يروي عن الحكم بن فروخ، روى عنه علي بن المديني.(@)(@@)(@@)(@@) ||| AUTO مسعود بن سعد، أبو سعيد الجعفي(@)(@@) يروي عن ابن إسحاق وعطاء بن السائب والكوفيين، روى عنه أبو غسان النهدي وأهل الكوفة، وقد قيل: إنه سمع أبا إسحاق السبيعي فإن صح ذلك فهو من أتباع التابعين.(@)(@@)(@@)(@@) ||| AUTO مسعود بن واصل، أبو مسلم(@)(@@) صاحب السامري، من أهل البصرة، PageV01P002 [ج 5: ص 531] يروي عن النهاس بن فهم عن قتادة، روى عنه عمر بن شيبة، ربما أغرب.(@)(@@)(@@)(@@) ||| AUTO مسعود بن جويرية(@)(@@) من أهل البصرة، يروي عن يزيد بن هارون وعبد الله بن خداش بن حوشب، مستقيم الحديث، حدثنا عنه أبو يعلى وغيره من شيوخنا.(@)(@@)(@@)(@@) ||| AUTO مسعود بن يوسف، أبو عبد الله الكوسج(@)(@@) من أهل جوزجان، يروي عن الفضيل بن عياض، روى عنه أحمد بن سيار.(@)(@@)(@@)(@@) ||| AUTO مسعود بن مسروق(@)(@@) من أهل المبارك، يروي عن إسماعيل بن جعفر، روى عنه أهل بلده، لم أر في حديثه إلا ما يشبه حديث الثقات، وقد روى عن مسعود هذا أبو خالد يزيد بن محمد بن حماد العقيلي الذي كان يقيم بمكة وكان أصله من أصبهان.(@)(@@)(@@)(@@) ||| AUTO 
ms1683	 محرز بن يزيد(@)(@@) يروي عن سليمان بن موسى، روى عنه القاسم بن مالك المزني.(@)(@@)(@@)(@@) ||| AUTO محرز بن الوضاح(@)(@@) من أهل مرو، يروي عن عبيد الله بن عمرو، روى عنه يحيى بن أكثم وأهل مرو.(@)(@@)(@@)(@@) ||| AUTO محرز بن هشام المرادي(@)(@@) كوفي، يروي عن عبد الملك بن مروان بن عنترة، عن أبيه، عن جده، عن أبي بكر، عن النبي صلى الله عليه وسلم في الدعاء في حفظ القرآن، روى عنه عثمان بن سعيد الدارمي.(@)(@@)(@@)(@@) ||| AUTO محرز بن عون بن أبي عون، أبو الفضل(@)(@@) من أهل بغداد، يروي عن مالك وخلف بن خليفة والعراقيين، روى عنه أهل العراق، حدثنا عنه أحمد بن علي بن المثنى، مات سنة إحدى وثلاثين ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 532](@)(@@)(@@)(@@) ||| AUTO محرز بن سلمة العبدي البغدادي(@)(@@) أصله من مكة، يروي عن مالك بن أنس والدراوردي، حدثنا عنه أبو يعلى وغيره من شيوخنا.(@)(@@)(@@)(@@) ||| AUTO معمر بن سليمان الرقي، أبو عبد الله النخعي(@)(@@) مولى لهم، يروي عن خصيف والحجاج بن أرطاة، روى عنه أحمد بن حنبل وعلي بن حجر، مات في شعبان سنة إحدى وتسعين ومائة، وكان أبيض الرأس واللحية.(@)(@@)(@@)(@@) ||| AUTO معمر بن يعمر الليثي(@)(@@) يروي عن معاوية بن سلام، روى عنه محمد بن يحيى الذهلي، كنيته أبو عامر، من أهل دمشق، يغرب، ومعاوية بن سلام سمع نافعا.(@)(@@)(@@)(@@) ||| AUTO معمر بن محمد بن معمر، أبو شهاب البلخي(@)(@@) ابن أخي شهاب بن معمر، يروي عن مكي بن إبراهيم، وهو آخر من يروي عن مكي، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO معمر بن المبارك، أبو عامر الراسبي(@)(@@) يروي عن عتبة الغلام، روى عنه محمد بن نعيم بن معاوية الموصلي الحكايات في فضائل عتبة.(@)(@@)(@@)(@@) ||| AUTO مبشر بن عبد الله بن رزين السلمي(@)(@@) من أهل نيسابور، كنيته أبو بكر، يروي عن سفيان بن حسين، روى عنه حسين بن منصور النيسابوري وأهل بلده، مات سنة ثمان أو تسع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO مبشر بن إسماعيل الحلبي، أبو إسماعيل الكلبي(@)(@@) يروي عن الأوزاعي، روى عنه علي بن حجر والناس.(@)PageV01P002(@)(@@) [ج 5: ص 
ms1684	 533](@)(@@)(@@)(@@) ||| AUTO مبشر بن الحسن بن مبشر بن مكيس، أبو بشر(@)(@@) يروي عن أبي عاصم والبصريين، مستقيم الحديث. حدثنا علي بن الحسين بن سليمان المعدل بالفسطاط، ثنا مبشر بن الحسين.(@)(@@)(@@)(@@) ||| AUTO المطلب بن كثير(@)(@@) يروي عن الزبير بن موسى، روى عنه يعقوب بن محمد الزهري.(@)(@@)(@@)(@@) ||| AUTO المثنى بن بكر، أبو جابر العبدي(@)(@@) يروي عن أشعث بن سليم وداود بن أبي هند، روى عنه علي بن أبي هاشم.(@)(@@)(@@)(@@) ||| AUTO المثنى بن موسى بن مسلمة الهذلي(@)(@@) يروي عن أبيه، روى عنه محمد بن عباد الهنائي.(@)(@@)(@@)(@@) ||| AUTO المثنى بن يحيى بن عيسى التميمي(@)(@@) جد أبي يعلى الموصلي، يروي عن أبي شهاب عن الأعمش، روى عنه محمد بن غالب تمتام.(@)(@@)(@@)(@@) ||| AUTO المثنى بن حرب بن الضحاك الأسدي، أبو محمد(@)(@@) من أهل الثغر، يروي عن وكيع وزياد البكائي، حدثنا عنه إبراهيم بن أبي أمية الطرسوسي، وأهل الثغر.(@)(@@)(@@)(@@) ||| AUTO المثنى بن معاذ بن معاذ العنبري(@)(@@) يروي عن أبيه، روى عنه أصحابنا.(@)(@@)(@@)(@@) ||| AUTO مسكين بن بكير، أبو عبد الرحمن الحذاء(@)(@@) من أهل حران، يروي عن شعبة وجعفر بن برقان، روى عنه النفيلي والحرانيون، مات سنة ثمان وتسعين ومائة ونصر بن شبيب محاصر لأهل حران يومئذ.(@)PageV01P002(@)(@@) [ج 5: ص 534](@)(@@)(@@)(@@) ||| AUTO مسكين بن عبد الرحمن التجيبي(@)(@@) من أهل مصر، يروي عن يحيى بن أيوب.(@)(@@) (713) -[5: 534] حدثنا ابن خزيمة، ثنا يحيى بن زكريا بن يحيى بن أبان، ثنا مسكين بن عبد الرحمن، ثنا يحيى بن أيوب، عن حميد الطويل، عن أنس بن مالك، قال: كان رسول الله صلى الله عليه وسلم إذا كان صائما لم يصل حتى يأتيه برطب وماء، فيأكل ويشرب إذا كان الرطب، وإذا كان الشتاء لم يصل حتى يأتيه بتمر وماء(@)(@@)(@@)(@@) ||| AUTO مختار بن عون بن أبي عون(@)(@@) يروي عن أبي جعفر بن سليمان الضبعي، روى عنه أخوه محرز بن عون بن أبي عون.(@)(@@)(@@)(@@) ||| AUTO معبد بن راشد، أبو عبد الرحمن الكوفي(@)(@@) سكن بغداد، يروي عن معاوية بن عمار ووكيع، روى عنه الحسن بن الصباح البزار.(@)(@@)(@@)(@@) ||| AUTO مليح بن الجراح 
ms1685	 بن مليح بن فرس الرواسي(@)(@@) من قيس عيلان، يروي عن الثوري، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO مليح بن وكيع بن الجراح(@)(@@) يروي عن أبيه والكوفيين، وهو أخو سفيان بن وكيع، روى عنه الحضرمي وأحمد بن يحيى الصوفي، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO محرر بن قعنب الباهلي(@)(@@) من أهل البصرة، يروي عن شعبة، روى عنه بدل بن المحبر والبصريون، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO مشمعل بن ملحان الطائي(@)(@@) يروي عن مطرح بن يزيد وأهل البصرة، روى عنه إسحاق بن أبي إسرائيل، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO مغلس بن زياد، أبو الوليد العامري(@)(@@) من أهل الكوفة، يروي عن عامر بن عبيدة، روى عنه محمد بن سلام البيكندي وإسحاق بن إبراهيم الحنظلي.(@)PageV01P002(@)(@@) [ج 5: ص 535](@)(@@)(@@)(@@) ||| AUTO الماضي بن محمد، أبو مسعود المصري الغافقي(@)(@@) يروي عن ليث بن أبي سليم وهشام بن حسان، روى عنه ابن وهب، يعتبر حديثه إذا روى عن غير ليث.(@)(@@)(@@)(@@) ||| AUTO ملازم بن عمرو بن عبد الله بن بدر الحنفي(@)(@@) من أهل اليمامة، سكن البصرة، يروي عن جده عبد الله بن بدر، روى عنه مسدد بن مسرهد وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO محشر بن معاوية الباهلي(@)(@@) من أهل البصرة، يروي عن مطر الوراق، روى عنه أهل بلده، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO معمر بن الحسن الهذلي(@)(@@) يروي عن الثوري، روى عنه مالك بن سليمان الهروي، ربما أخطأ، وهو جد أبي معمر القطيعي.(@)(@@)(@@)(@@) ||| AUTO معمر بن بكار السعدي(@)(@@) يروي عن إبراهيم بن سعد، روى عنه نجيح بن إبراهيم الجماني.(@)(@@)(@@)(@@) ||| AUTO معمر بن سهل بن معمر الأهوازي(@)(@@) شيخ، متقن، يغرب، يروي عن عبيد الله بن موسى ويزيد بن هارون وأهل العراق.(@)(@@) (714) -[5: 535] حدثنا عنه عبدان وأهل الأهواز، سمعت محمد بن يعقوب بالأهواز، يقول: سمعت معمر بن سهل، يقول: سمعت جعفر بن عون، يقول: سمع مسعر بن كدام، يقول: يسر الفتى ما كان قدم من تقي إذا عرف الداء الذي هو قاتله.(@)(@@)(@@)(@@) ||| AUTO معمر بن إبراهيم بن الربيع(@)(@@) يروي عن أبي عاصم والبصريين، حدثنا عنه محمد بن يعقوب الأهوازي.(@)(@@)(@@)(@@) ||| AUTO معمر بن المثنى التيمي 
ms1686	(@)(@@) من أهل البصرة، كنيته أبو عبيدة، روى عن PageV01P002 [ج 5: ص 536] البصريين، مات سنة عشرة ومائتين، وقد قارب المائة، كان الغالب عليه معرفة الأدب والشعر.(@)(@@)(@@)(@@) ||| AUTO مستلم بن سعيد الثقفي(@)(@@) مولاهم، من أهل واسط، يروي عن منصور بن زاذان، روى عنه يزيد بن هارون وأهل العراق، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO مقدام أبو فروة(@)(@@) يروي عن جار له عن شريح، روى عنه جرير بن حازم.(@)(@@)(@@)(@@) ||| AUTO مخارق بن عبد الرحمن السلمي(@)(@@) كان ينزل الدثينة، يروي عن عمه، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO منقذ(@)(@@) شيخ، يروي عن المعتمر بن سليمان، روى عنه المعتمر بن سليمان.(@)(@@) (715) -[5: 536] حدثنا أبو يعلى بالموصل، ثنا يحيى بن معين، ثنا المعتمر بن سليمان، قال: قال لي منقذ: أنت حدثتني عن أيوب عن الحسن: ويح كلمة رحمة.(@)(@@)(@@)(@@) ||| AUTO مطهر بن مدرك، أبو كامل(@)(@@) يروي عن شعبة، روى عنه مجاهد بن موسى المخرمي.(@)(@@)(@@)(@@) ||| AUTO مصبح بن الهلقام، أبو علي العجلي(@)(@@) كوفي، يروي عن قيس بن الربيع، روى عنه علي بن المثنى الطهوي.(@)(@@)(@@)(@@) ||| AUTO مضرس بن عبد الله بن وهب بن أبي الصهباء الوابشي(@)(@@) من أهل الكوفة، يروي المقاطيع، روى عنه الفضل بن دكين.(@)(@@)(@@)(@@) ||| AUTO منظور بن زهير بن الفرات بن وكيع(@)(@@) شيخ، يروي عن شريك بن عبد الله النخعي، روى عنه علي بن حجر السعدي، وزعم أنه كان ثقة.(@)(@@)(@@)(@@) ||| AUTO مسهر بن عبد الملك بن سلع(@)(@@) من أهل الكوفة، يروي عن أبيه PageV01P002 [ج 5: ص 537] عبد الملك، روى عنه سفيان بن وكيع وأهل الكوفة، يخطئ ويهم.(@)(@@)(@@)(@@) ||| AUTO متوكل بن حمران البلخي(@)(@@) من العباد، يروي عن كثير بن زياد وأبي سهل، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO متوكل بن محمد بن أبي سورة(@)(@@) من أهل المصيصة، يروي عن الأوزاعي، روى عنه يمان بن سعيد اليحصبي وأهل الثغر، وليس هذا بمتوكل بن أبي سورة صاحب الحارث بن عطية.(@)(@@)(@@)(@@) ||| AUTO منبه بن عثمان اللخمي(@)(@@) من أهل الشام، يروي عن الأوزاعي عن ثور بن يزيد، روى عنه محمد بن صالح بن البختري وإبراهيم بن عتيق وغيرهما من أهل الشام. 
ms1687	(@)(@@)(@@)(@@) ||| AUTO مسمع بن عاصم أبو سنان(@)(@@) من عباد أهل البصرة ومتقنيهم، ما له في حديث مسند رجع إليه لكن الحكايات في فضائله وتعبده كثيرة، رواها عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO مسمع الدمشقي(@)(@@) يروي عن الليث بن سعد، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO مورق بن سخيت، أبو العباس(@)(@@) من أهل البصرة، يروي عن أبي هلال الراسبي، روى عنه إبراهيم بن فهد الساجي.(@)(@@)(@@)(@@) ||| AUTO معارك بن عبد الله القيسي(@)(@@) يروي عن عبد الله بن سعيد بن أبي هند، روى عنه البصريون، وهو الذي يقال له: المعارك بن عباد، يخطئ ويهم.(@)(@@)(@@)(@@) ||| AUTO المعافى بن عمران الظهري(@)(@@) من أهل حمص، يروي عن إسماعيل بن عياش PageV01P002 [ج 5: ص 538] وأهل بلده، روى عنه عمرو بن عثمان وأبو التقي هشام بن عبد الملك.(@)(@@)(@@)(@@) ||| AUTO المعافي بن سليمان الجزري(@)(@@) من أهل رأس العين، يروي عن فليح والقاسم بن معن المسعودي، حدثنا عنه محمد بن سعيد بن هلال برأس العين.(@)(@@)(@@)(@@) ||| AUTO أبو بلال الأشعري(@)(@@) من أهل الكوفة، يروي عن قيس بن الربيع والكوفيين، روى عنه أهل العراق، اسمه مرداس.(@)(@@)(@@)(@@) ||| AUTO مرداس بن محمد بن الحارث بن عبد الله بن أبي بردة(@)(@@) يروي عن أبي موسى الأشعري، يغرب ويتفرد.(@)(@@)(@@)(@@) ||| AUTO مساور بن أبان(@)(@@) يروي عن مورق وليس بالعجلي، روى عنه إبراهيم بن مختار الرازي.(@)(@@)(@@)(@@) ||| AUTO مرثد بن عامر الهنائي(@)(@@) يروي عن كلثوم بن جبر عن المغيرة بن أبي حفصة، روى عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO مصر بن غسان بن مضر الأزدي، أبو عيينة(@)(@@) من أهل البصرة، يروي عن أبي هلال الراسبي، روى عنه أبو زرعة الرازي.(@)(@@)(@@)(@@) ||| AUTO منيب بن أيوب(@)(@@) شيخ، يروي عن الأوزاعي، روى عنه الوليد بن مزيد البيروتي.(@)(@@)(@@)(@@) ||| AUTO المنهال بن يحيى بن سلام القشيري، أبو سلمة العقيلي(@)(@@) من أهل البصرة، يروي عن حماد بن سلمة، روى عنه البصريون، مات سنة عشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO منهال بن يزيد بن المنهال(@)(@@) ابن أخي الحجاج بن المنهال، من أهل البصرة، يروي عن معاذ وأهل البصرة، روى عنه عبيد بن محمد 
ms1688	 الكشوري.(@)PageV01P002(@)(@@) [ج 5: ص 539](@)(@@)(@@)(@@) ||| AUTO المنهال بن حماد(@)(@@) يروي عن خارجة بن مصعب عن زيد بن أسلم، روى عنه حميد بن زنجويه.(@)(@@)(@@)(@@) ||| AUTO مسدد بن مسرهد بن مسربل الأسدي، كنيته أبو الحسن(@)(@@) من أهل البصرة، يروي عن هشيم وخالد وحماد بن زيد، حدثنا عنه أبو خليفة وشيوخنا، مات سنة ثمان وعشرين ومائتين في شهر رمضان.(@)(@@)(@@)(@@) ||| AUTO المرزبان بن مسروق(@)(@@) من أهل الكوفة، يروي عن الثوري والكوفيين، روى عنه ابنه مسروق بن المرزبان.(@)(@@)(@@)(@@) ||| AUTO مظفر بن مدرك، أبو كامل(@)(@@) يروي عن حماد بن زيد، روى عنه أحمد بن حنبل رحمه الله.(@)(@@) (716) -[5: 539] حدثنا محمد بن أحمد المسندي، ثنا محمد بن نصر الفراء، ثنا أحمد بن حنبل، ثنا مظفر بن مدرك أبو كامل، ثنا إسرائيل، عن أبي إسحاق، عن عبيد بن ربيعة، قال: قال عبد الله بن مسعود: إسرائيل هو يعقوب، وإلياس هو إدريس(@)(@@)(@@)(@@) ||| AUTO مهدي بن الوليد بن عامر المزني(@)(@@) يروي عن أبيه، روى عنه بقية بن الوليد.(@)(@@)(@@)(@@) ||| AUTO مهدي بن حفص(@)(@@) شيخ، كان ببغداد، يروي عن أبي الأحوص، روى عنه العراقيون.(@)PageV01P002(@)(@@) [ج 5: ص 540](@)(@@)(@@)(@@) ||| AUTO مهدي بن جعفر الرملي(@)(@@) يروي عن ابن عيينة، روى عنه أبو حاتم الرازي وأهل الشام، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO مهدي بن عيسى، أبو الحسن الواسطي(@)(@@) يروي عن خالد بن عبد الله الطحان، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محسن بن غندر(@)(@@) بصري، يروي عن أبيه وابن أبي عدي، روى عنه عبد الملك بن محمد الرقاشي.(@)(@@)(@@)(@@) ||| AUTO منين بن طالب(@)(@@) من أهل البصرة، يروي عن معاوية بن عبد الكريم الضال عن الحسن، روى عنه البصريون.(@)(@@)(@@)(@@) ||| AUTO معلل بن نفيل الحراني أبو أحمد النهدي(@)(@@) يروي عن موسى بن أعين وعبيد الله بن عمرو، حدثنا عنه الحسن بن محمد بن أبي معشر، مات سنة تسع وثلاثين ومائتين، وهو المعلل بن نفيل بن علي بن نفيل.(@)(@@)(@@)(@@) ||| AUTO مزاحم بن زفر(@)(@@) كوفي، يروي عن سفيان الثوري الحكايات يروي عنه أخوه عثمان بن زفر.(@)(@@)(@@)(@@) ||| AUTO معقل بن مالك الباهلي، أبو بشر(@)(@@) من أهل البصرة، يروي 
ms1689	 عن محمد بن راشد عن مكحول، روى عنه يعقوب بن سفيان، وقد قيل: كنيته أبو شريك.(@)(@@)(@@)(@@) ||| AUTO مورع أبو شبيب الشقري(@)(@@) يروي عن الثوري، روى عنه قبيصة بن عقبة.(@)PageV01P002(@)(@@) [ج 5: ص 541](@)(@@)(@@)(@@) ||| AUTO محمود بن خالد الدمشقي، أبو علي(@)(@@) يروي عن ابن عيينة والوليد بن مسلم وأهل الشام، حدثنا عنه شيوخنا عمرو بن سعيد بن سنان وغيره، مات سنة خمس وأربعين ومائتين أو قبلها أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO محمود بن خداش الطالقاني، أبو محمد(@)(@@) سكن بغداد، يروي عن يزيد بن هارون ووكيع، حدثنا عنه أبو يعلى وأهل العراق، مات سنة خمس ومائتين.(@)(@@)(@@)(@@) ||| AUTO محمود بن غيلان، أبو محمد المروزي العدوي(@)(@@) يروي عن وكيع ويزيد بن هارون، مات في رمضان سنة تسع وثلاثين ومائتين، حدثنا محمد بن إسحاق الثقفي وغيره.(@)(@@)(@@)(@@) ||| AUTO محمود بن آدم المروزي(@)(@@) يروي عن ابن عيينة وأهل بلده، حدثنا عنه المراوزة، كنيته أبو عبد الرحمن، مات في سنة ثمان وخمسين ومائتين غرة رمضان.(@)(@@)(@@)(@@) ||| AUTO محمود بن خلف بن أيوب البلخي(@)(@@) يروي عن المكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO مشرف بن أبان الخطاب، أبو ثابت(@)(@@) من أهل بغداد، يروي عن أبي عاصم وأبي نعيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO مشرف بن عبد الله(@)(@@) شيخ، من أهل مرو، يروي عن أبي حنيفة الحرف بعد الحرف، روى عنه علي بن خشرم.(@)(@@)(@@)(@@) ||| AUTO مخول بن إبراهيم بن مخول بن راشد النهدي(@)(@@) من أهل الكوفة، يروي عن PageV01P002 [ج 5: ص 542] منصور بن أبي الأسود وإسرائيل، روى عنه أبو الدرداء عبد العزيز بن منيب وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO مشرف بن علي(@)(@@) شيخ، يروي عن إسحاق الأزرق والكوفيين، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO المسيب بن واضح بن سرحان الحمصي(@)(@@) من أهل تلمس من حمص، كنيته أبو محمد، يروي عن ابن المبارك وحفص بن ميسرة، حدثنا عنه الحسن بن سفيان وغيره من شيوخنا، مات سنة ست وأربعين ومائتين، وكان يخطئ.(@)(@@)(@@)(@@) ||| AUTO المسيب بن عبد الملك الحشاش(@)(@@) يروي عن مروان بن معاوية وابن عيينة، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO 
ms1690	 محفوظ بن الفضل بن أبي توبة(@)(@@) من أهل بغداد، يروي عن يزيد بن هارون وأهل العراق، حدثنا عنه الحسن بن سفيان وغيره، مات سنة سبع وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO محفوظ بن بحر بن صالح الأنطاكي(@)(@@) يروي عن وكيع والعراقيين، حدثنا عنه علي بن حمزة بن صالح بأنطاكية، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO مهنأ بن يحيى، أبو عبد الله(@)(@@) سكن بغداد، يروي عن يزيد بن هارون وبقية بن الوليد، حدثنا عنه الطبري وغيره من شيوخنا، وكان من خيار الناس من جلساء أحمد بن حنبل وبشر الحافي، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO مهنأ أبو شبل(@)(@@) شيخ، من أهل البصرة، يروي عن حماد بن سلمة، روى عنه نصر بن علي الجهضمي.(@)(@@)(@@)(@@) ||| AUTO مسجع بن مصعب، أبو الحكم البصري(@)(@@) يروي عن عبد الواحد بن زياد، مستقيم الحديث، حدثنا أبو يعلى بالموصل، ثنا مسجع بن مصعب.(@)PageV01P002(@)(@@) [ج 5: ص 543](@)(@@)(@@)(@@) ||| AUTO مهران بن أبي عمر الرازي(@)(@@) يروي عن سفيان الثوري كان مجوسيا يكري الجمال من الري إلى المدائن، أسلم على يدي سفيان، وصنف الجامع الصغير له، روى عنه محمد بن حميد وأهل الري.(@)(@@)(@@)(@@) ||| AUTO محبوب بن محرز القواريري(@)(@@) كوفي.(@)(@@) (717) -[5: 543] يروي عن أسامة بن زيد، عن محمد بن المنكدر، عن جابر، قال: قال رسول الله صلى الله عليه وسلم: سلوا الله علما نافعا، وتعوذوا بالله من علم لا ينفع. حدثنا عنه أبو يعلى، ثنا عبد الله بن عمر بن أبان، ثنا محبوب بن محرز(@)(@@)(@@)(@@) ||| AUTO محبوب بن محمد، أبو بشر العبدي(@)(@@) من أهل البصرة، يروي عن هشام بن زياد أبي المقدام، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO محبوب بن موسى الأنطاكي، أبو صالح الفراء(@)(@@) يروي عن أبي إسحاق الفزاري، روى عنه عثمان بن سعيد الدارمي وأهل العراق، متقن فاضل.(@)(@@)(@@)(@@) ||| AUTO منجاب بن الحارث التميمي(@)(@@) من أهل الكوفة، يروي عن علي بن مسهر والكوفيين، روى عنه محمد بن يحيى الذهلي، مات سنة إحدى وثلاثين ومائتين.(@)(@@)(@@)(@@) ||| AUTO منقع بن الضياع(@)(@@) (718) -[5: 543] يروي عن أبي إسماعيل المؤدب، عن إسماعيل بن أبي خالد، عن الشعبي، عن عكرمة، عن 
ms1691	 ابن عباس، عن سودة زوج النبي صلى الله عليه وسلم قالت: " كان لنا شاة فماتت، فدبغنا مسكها، فما زلنا ننبذ فيه حتى صار شنا " روى عنه الحضرمي(@)(@@)(@@)(@@) ||| AUTO مسروق بن المرزبان بن مسروق الكندي(@)(@@) من أهل الكوفة، يروي عن ابن أبي زائدة وأبي الأحوص، حدثنا عنه محمد بن صالح بن ذريح العكبري وغيره من شيوخنا، مات سنة أربعين ومائتين أو قبلها أو بعدها بقليل.(@)PageV01P002(@)(@@) [ج 5: ص 544](@)(@@)(@@)(@@) ||| AUTO معروف الكرخي، أبو محفوظ(@)(@@) من عباد أهل العراق وقرائهم، ممن له الحكايات الكثيرة في كرامته واستجاب دعائه من رفقاء بشر بن الحارث، ليس له حديث يرجع إليه، روى عنه أهل العراق.(@)(@@)(@@)(@@) ||| AUTO معروف بن الحسن الكتاني(@)(@@) يروي عن أبي نعيم وأهل العراق، حدثنا عنه محمد بن المنذر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO مصرف بن جرير القاري، أبو سعيد(@)(@@) يروي عن عبد الواحد بن زيد والحكايات، روى عنه القواريري، ما له كثير حديث مسند يرجع إليه.(@)(@@)(@@)(@@) ||| AUTO مصرف بن عمرو اليامي(@)(@@) من أهل الكوفة، يروي عن ابن إدريس وحفص بن غياث، حدثنا عنه الحسن بن سفيان وغيره، قد قيل: إنه مصرف بن عمرو بن السري بن مصرف بن عمرو بن كعب اليامي الهمداني، قال: ابنه أحمد بن مصرف، كنيته أبو بكر.(@)(@@)(@@)(@@) ||| AUTO مكرم بن محرز بن المهدي بن عبد الرحمن بن عمرو بن خويلد بن خليفة بن منقذ بن ربيعة بن حزام بن حبيش بن كعب الخزاعي الكعبي، كنيته أبو القاسم(@)(@@) يروي عن أبيه، عن حزام بن هشام بن حبيش، عن أبيه، عن جده حبيش بن خالد صاحب رسول الله صلى الله عليه وسلم وقد أدرك هشام بن حبيش جماعة من أصحاب رسول الله صلى الله عليه وسلم حدثنا عنه عمرو بن سعيد بن سنان الطائي وغيره، مات سنة تسع وأربعين ومائتين وله يوم، مات قريب من مائة سنة.(@)(@@)(@@)(@@) ||| AUTO مقدم بن محمد بن يحيى بن عطاء بن مقدم المقدمي(@)(@@) يروي عن يزيد بن هارون وعمه القاسم بن يحيى بن عطاء بن مقدم المقدمي، حدثنا عنه 
ms1692	 عبد الله بن أبي سفيان وغيره، يغرب ويخالف.(@)(@@)(@@)(@@) ||| AUTO مخارق بن سفيان بن ميسرة الأسدي(@)(@@) يروي عن أهل الجزيرة، حدثنا عنه أبو عروبة، مات سنة أربع وأربعين ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 545](@)(@@)(@@)(@@) ||| AUTO معبد بن أحمد بن فرقد البلخي(@)(@@) يروي عن مكي بن إبراهيم، روى عنه أهل بلده، وكان معدلا عندهم.(@)(@@)(@@)(@@) ||| AUTO المهلب بن الأخطل بن المهلب بن الرواد بن عبدة بن أيوب بن جابر الأزدي العتكي، أبو محمد(@)(@@) من أهل تست، أول من أظهر السنة بتست ودعا إليها الناس على عبادة دائمة وورع شديد، سمع أبا نعيم وعبد الرزاق بن همام وغيرهما، مات بتست في سنة تسع وخمسين ومائتين سنة، وقع الثلج الكثير بها، وله بها عقب، والرواد بن عبدة كان يعرف بالأغر.(@)(@@)(@@)(@@) || AUTO باب النون(@)(@@) قال أبو حاتم رضي الله عنه:(@)(@@) وممن يروي عن أتباع التابعين من القرن الرابع ممن ابتدأ اسمه على النون(@)(@@)(@@)(@@) ||| AUTO النعمان بن أبي شيبة الجندي(@)(@@) من أهل اليمن، وهو الذي يقال له: النعمان بن عبيد، كان اسم أبي شيبة عبيد، يروي عن سفيان الثوري، روى عنه المعتمر بن سليمان وعبد الرزاق بن همام.(@)(@@) (719) -[5: 545] حدثنا ابن قتيبة، ثنا ابن أبي السري، ثنا معتمر بن سليمان، ثنا النعمان بن أبي شيبة، عن ابن طاوس أنه كان يجهر ببسم الله الرحمن الرحيم قبل الفاتحة وقبل السورة.(@)(@@)(@@)(@@) ||| AUTO النعمان بن الزبير ختن هشام بن يوسف الصنعاني(@)(@@) من أهل اليمن، يروي عن أبيه، روى عنه هشام بن يوسف ومحمد بن الحسن بن أنس الصنعانيان.(@)(@@)(@@)(@@) ||| AUTO النعمان بن عبد السلام التيمي، أبو المنذر الأصبهاني(@)(@@) يروي عن ابن جريج والثوري، روى عنه عبد الرحمن بن مهدي وأهل أصبهان.(@)PageV01P002(@)(@@) [ج 5: ص 546](@)(@@)(@@)(@@) ||| AUTO النعمان بن جابر الأودي(@)(@@) شيخ، يروي عن أبي نعيم وعبد الرحمن بن شريك، حدثنا عنه علي بن إبراهيم بن الهيثم البلدي.(@)(@@)(@@)(@@) ||| AUTO نافع بن يزيد، أبو يزيد المصري(@)(@@) مولى شرحبيل ابن حسنة القرشي، وقد قيل: إنه مولى أم الطبا، وهى مولاة لقريش، يروي عن عقيل بن خالد، روى عنه ابن وهب 
ms1693	 وأهل مصر، مات سنة ثمان وستين ومائة، ولست أحفظ له سماعا عن تابعي، فلذلك أدخلناه في هذه الطبقة، فأما رؤيته للتابعين فليس بمنكر، ولكن اعتمادنا في هذا الكتاب في تقسيم هذه الطبقات الأربع على ما صح عندنا من لقي بعضهم بعضا مع السماع، فأما عند وجود الإمكان وعدم العلم به فهو لا نقول به.(@)(@@)(@@)(@@) ||| AUTO نافع بن سليمان(@)(@@) من أهل مصر، يروي عن محمد بن أبي صالح عن أبيه عن عائشة، روى عنه حيوة بن شريح.(@)(@@)(@@)(@@) ||| AUTO نافع بن محرز(@)(@@) يروي عن عمر بن محمد بن المنكدر، روى عنه ابن عيينة.(@)(@@)(@@)(@@) ||| AUTO نافع بن خالد الطاحي(@)(@@) من أهل البصرة، يروي عن أبي عاصم وعبد الأعلى بن عبد الأعلى، حدثنا أبو يعلى الموصلي، ثنا نافع بن خالد الطاحي.(@)(@@)(@@)(@@) ||| AUTO نوح بن قيس بن رياح الحراني، كنيته أبو روح(@)(@@) من أهل البصرة، يروي عن أخيه خالد بن قيس عن قتادة، روى عنه مسلم بن إبراهيم وأهل البصرة، مات سنة ثلاث أو أربع وثمانين ومائة.(@)(@@)(@@)(@@) ||| AUTO نوح الراسبي، أبو شعبة(@)(@@) يروي عن يونس بن عمرو عن الحسن، روى عنه زيد بن حباب وأهل البصرة.(@)PageV01P002(@)(@@) [ج 5: ص 547](@)(@@)(@@)(@@) ||| AUTO نوح بن جابر(@)(@@) يروي عن خاله، روى عنه المبارك بن سعيد.(@)(@@)(@@)(@@) ||| AUTO نوح بن يزيد بن سيار المعلم، ويقال: المؤدب(@)(@@) من أهل بغداد، يروي عن إبراهيم بن سعيد، روى عنه أبو قدامة ومحمد بن يحيى وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO نوح بن ميمون(@)(@@) من أهل مرو، كان يسكن في قصيعة الربيع ببغداد، يروي عن سفيان الثوري، وهو الذي يقال له: المضروب في وجهه، روى عنه محمد بن عبيد الأسدي الهمداني ويحيى بن سهيل السلمي البخاري، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO نوح بن أنس الرازي(@)(@@) يروي عن جرير بن عبد الحميد ومهران بن أبي عمر، روى عنه الرازيون، مستقيم الحديث، وقد روى عنه سعيد بن جناح الزاهد البخاري.(@)(@@)(@@)(@@) ||| AUTO نوح بن الهيثم(@)(@@) من أهل عسقلان، يروي عن إبراهيم بن سعيد، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO نوح بن حبيب، أبو محمد 
ms1694	 البدشي(@)(@@) من أهل قومس، يروي عن يزيد بن هارون وعبد الرزاق، حدثنا عنه ابن الفضيل والقطان وغيرهما من شيوخنا، مات في رجب سنة اثنتين وأربعين ومائتين قبل الرجفة بأربعة عشر يوما.(@)(@@)(@@)(@@) ||| AUTO النضر بن شميل بن خرشة بن يزيد بن كلثوم بن عنزة بن زهير بن عمرو بن حجر بن خزاعي بن مازن بن عمرو بن تميم بن مازن المازني، أبو الحسن(@)(@@) أصله من البصرة، مولده بمرو الروذ، خرج به أبوه زمن الفتنة هاربا من مرو الروذ إلى البصرة سنة ثمان وعشرين ومائة وهو ابن ست سنين، فكتب بالبصرة عن ابن عون PageV01P002 [ج 5: ص 548] وعوف الأعرابي والبصريين، ثم رجع إلى مرو الروذ وسكنها، روى عنه إسحاق بن إبراهيم الحنظلي وأهل خراسان، مات بمرو وبها قبره سنة أربع ومائتين، وكان من فصحاء الناس وعلمائهم بالأدب وآداب الناس.(@)(@@) (720) -[5: 548] سمعت الحسن بن محمد بن مصعب، يقول: سمعت محمد بن عبد الله بن قهزاد، يقول: مات النضر بن شميل سنة ثلاث ومائتين في آخر يوم من ذي الحجة، ودفن أول يوم من المحرم.(@)(@@)(@@)(@@) ||| AUTO النضر بن كنانة بن جبلة الهروي(@)(@@) يروي عن أبيه، روى عنه محمد بن هلال الهروي.(@)(@@)(@@)(@@) ||| AUTO النضر بن علقمة، أبو المغيرة(@)(@@) يروي عن داود بن علي، روى عنه إسحاق بن أبي إسرائيل.(@)(@@)(@@)(@@) ||| AUTO النضر بن زرارة الذهلي، أبو الحسن الكوفي(@)(@@) ابن أخي سماك بن الوليد، سكن بلخ، يروي عن أبي جناب وعمرو بن ذر والكوفيين، روى عنه قتيبة بن سعيد أشياء مستقيمة، وقد سمع عن عيسى بن طهمان عن أنس ولكن عيسى تبرأنا من عمدته، فلو كان عيسى ممن يحتج بخبره لأدخلنا النضر بن زرارة في الطبقة الثالثة، فلما لم يصح بينه وبين رسول الله صلى الله عليه وسلم إلا ثلاثة أنفس أدخلناه في هذه الطبقة على ما أصلنا عليه الكتاب وإن تقدم موته.(@)(@@)(@@)(@@) ||| AUTO النضر بن عبد الجبار، أبو الأسود المرادي(@)(@@) من أهل مصر، يروي عن يحيى بن أيوب وابن لهيعة، روى عنه أحمد بن صالح وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO 
ms1695	 النضر بن عبد الله الأصم(@)(@@) شيخ، يروي عن إسماعيل بن زكريا، روى عنه محمد بن علي بن الحسن بن شقيق.(@)PageV01P002(@)(@@) [ج 5: ص 549](@)(@@)(@@)(@@) ||| AUTO النضر بن شبل(@)(@@) شيخ، كان بمكة، يروي عن مالك، روى عنه أحمد بن زهير.(@)(@@) (721) -[5: 549] حدثنا ابن السكين بواسط، ثنا ابن أبي خيثمة، ثنا النضر بن شبل شيخ، رأيته بمكة وأثنى عليه سليمان بن حرب خيرا، حدثنا مالك، عن عامر بن عبد الله بن الزبير، عن عمرو بن سليم، عن أبي قتادة، أن رسول الله صلى الله عليه وسلم: كان حاملا أمامة. الحديث(@)(@@)(@@)(@@) ||| AUTO النضر بن طاهر القيسي(@)(@@) من أهل البصرة، يروي عن أبي عوانة والبصريين، حدثنا عنه عمر بن محمد الهمداني وشيوخنا، ربما أخطأ ووهم.(@)(@@)(@@)(@@) ||| AUTO النضر بن يزيد النهرتيري(@)(@@) سكن الأهواز، يروي عن عيسى بن يونس وأهل العراق، حدثنا عنه عبد الله بن أحمد بن موسى القاضي بعسكر مكرم.(@)(@@)(@@)(@@) ||| AUTO النضر بن عبد الله الحلواني(@)(@@) يروي عن محمد بن عبد الله الأنصاري، حدثنا عنه محمد بن يحيى بن مولى بفم الصلح.(@)(@@)(@@)(@@) ||| AUTO نصر بن حاجب(@)(@@) يروي عن إسماعيل بن أمية، روى عنه يزيد بن هارون.(@)(@@)(@@)(@@) ||| AUTO نصر بن مشارس، أبو مصلح البلخي(@)(@@) يروي عن الضحاك بن مزاحم التفسير، روى عنه خالد بن سليمان أبو معاذ البلخي.(@)(@@)(@@)(@@) ||| AUTO نصر بن علي الجهضمي الأزدي(@)(@@) من أهل البصرة، كنيته أبو عمرو، جد نصر بن علي الجهضمي، يروي عن النضر بن شيبان الحداني، روى عنه أبو نعيم وأهل البصرة، مات في إمرة أبي جعفر.(@)(@@)(@@)(@@) ||| AUTO نصر بن مزاحم(@)(@@) يروي عن سفيان الثوري، روى عنه إبراهيم بن يوسف البلخي وأهل خراسان.(@)(@@) (722) -[5: 549] حدثنا محمد بن الفضل البلخي بسمرقند، حدثنا إبراهيم بن يوسف، PageV01P002 [ج 5: ص 550] ثنا نصر بن مزاحم، عن سفيان الثوري، عن عطاء بن السائب، عن عبد الرحمن بن أبي ليلى، قال: أدركنا في المسجد، يعني: مسجد الكوفة، عشرين ومائة من أصحاب النبي صلى الله عليه وسلم ما سئل أحد منهم عن حديث إلا ورد أن أخاه كفاه الحديث، وما يستفتي أحد 
ms1696	 منهم إلا ورد أن أخاه كفاه الفتيا(@)(@@) (723) -[5: 550] حدثني مهران بن مروان بالري، ثنا حجاج بن حمزة العجلي، ثنا محمد بن علي العربي، عن نصر بن مزاحم، قال: خرج رجل في طلب العلم فاستقبله حجر، فإذا فيه مكتوب: اقلبني تعتبر، فإذا فيه مكتوب: أنت بما تعلم لا تعمل كيف علم ما لا تعلم.(@)(@@)(@@)(@@) ||| AUTO نصر بن عبد الملك العتكي(@)(@@) من أهل سمرقند، يروي عن أبي حنيفة، روى عنه ابنه أحمد بن نصر العتكي.(@)(@@)(@@)(@@) ||| AUTO نصر بن الحكم الواسطي(@)(@@) يروي عن خلف بن خليفة سمع منصور بن زاذان يقول: الأشر والبطر يزيد في السيئات والهم والحزن يزيد في الحسنات، روى عنه عباس بن محمد الدوري.(@)(@@)(@@)(@@) ||| AUTO نصر بن قديد بن نصر بن سيار، أبو صفوان(@)(@@) من أهل البصرة، يروي عن البصريين وحفص بن غياث، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO نصر بن الحجاج دمشقي(@)(@@) يروي عن الأوزاعي، روى عنه ابنه عمرو بن نصر، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO نصر بن زيد(@)(@@) مستملي هشيم، روى عنه زياد بن أيوب.(@)(@@) (724) -[5: 550] حدثنا عبد الله بن عروة، ثنا زياد بن أيوب الطوسي، ثنا نصر بن زيد مستملي هشيم، ثنا حماد بن سلمة، عن أبي الزبير، عن جابر، أن النبي صلى الله عليه وسلم: دخل مكة وعليه عمامة سوداء(@)(@@) (725) -[5: 550] سمعت عبد الله بن عروة، يقول: سمعت زياد بن أيوب، يقول: قلت لأحمد بن حنبل: كتبت عن نصر بن زيد، قال: لا، ولكن كتبت عن رجل عنه(@)(@@)(@@)(@@) ||| AUTO نصر بن مهاجر(@)(@@) يروي عن ابن عيينة وبشر بن السري، روى عنه محمد بن عوف الطائي، مات بعد الثلاثين ومائتين.(@)PageV01P002(@)(@@) [ج 5: ص 551](@)(@@)(@@)(@@) ||| AUTO نصر بن يحيى بن أبي كثير(@)(@@) يروي عن أبيه.(@)(@@) (726) -[5: 551] قال: محمد بن منصور الطوسي، ثنا يحيى بن سعيد اليمامي، قال: سمعت نصر بن يحيى بن أبي كثير، يقول: من خالط الناس دراهم ومن داراهم راياهم، وكان نصر من خيار المسلمين، وكان يبيع الدهن باليمامة ويتصدق بصبابته.(@)(@@)(@@)(@@) ||| AUTO نصر بن أبي الدمون الحضرمي(@)(@@) من أهل الكوفة، يروي عن وكيع، روى 
ms1697	 عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO نصر بن علي الواسطي(@)(@@) شيخ، يروي عن همام بن يحيى، روى عنه الفضل بن سهل الأعرج.(@)(@@)(@@)(@@) ||| AUTO نصر بن فضالة، أبو الليث(@)(@@) من أهل نيسابور، يروي عن ابن عيينة، روى عنه أحمد بن سيار، وقال: كتبت عنه ببلخ.(@)(@@)(@@)(@@) ||| AUTO نصر بن عاصم الأنطاكي(@)(@@) شيخ، يروي عن الوليد بن مسلم، روى عنه عثمان بن خرزاذ.(@)(@@)(@@)(@@) ||| AUTO نصر بن عبد الرحمن الوشاء، أبو سليمان(@)(@@) من أهل الكوفة، يروي عن وكيع والكوفيين، حدثنا عنه الحسن بن إدريس الأنصاري وغيره.(@)(@@)(@@)(@@) ||| AUTO نصر بن محمد بن سليمان السلمي، أبو ضمرة الحمصي(@)(@@) يروي عن إسماعيل بن عياش، حدثنا عنه الفضل بن محمد العطار بأنطاكية.(@)(@@)(@@)(@@) ||| AUTO نصر بن زياد القاضي(@)(@@) وكان على قضاء نيسابور، يروي عن إبراهيم بن سعد والدراوردي، حدثنا عنه ابن ابنته الملقاباذي أحمد بن إبراهيم.(@)PageV01P002(@)(@@) [ج 5: ص 552](@)(@@)(@@)(@@) ||| AUTO نصر بن زيد(@)(@@) يروي عن يعقوب القمي، روى عنه محمد بن عيسى بن الطباع.(@)(@@)(@@)(@@) ||| AUTO نصر بن علي بن نصر بن علي الجهضمي، كنيته أبو عمرو(@)(@@) روى عن ابن عيينة والمعتمر بن سليمان، حدثنا عنه شيوخنا البختري وغيره، مات في ربيع الآخر سنة خمسين ومائتين.(@)(@@)(@@)(@@) ||| AUTO نصر بن خلف، أبو عبد الرحمن(@)(@@) يروي عن يزيد بن هارون، حدثنا عنه الحسن بن سفيان، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO نصر بن العلاء الكتاني، كنيته أبو الليث(@)(@@) من أهل مرو، يروي عن جعفر بن عون والنضر بن شميل، حدثنا عنه محمد بن معاذ وغيره، يخطئ وينفرد على عدالته.(@)(@@)(@@)(@@) ||| AUTO نعيم بن يحيى التميمي(@)(@@) كوفي، يروي عن الأعمش، روى عنه ابنه عبيد بن نعيم.(@)(@@)(@@)(@@) ||| AUTO نعيم بن المورع بن توبة العنبري، أبو سعيد(@)(@@) يروي عن عطاء السلمي الحكايات، روى عنه إسحاق بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO نعيم بن حكيم المدائني(@)(@@) يروي عن عبد الملك بن أبي بشير، روى عنه أبو عوانة.(@)(@@)(@@)(@@) ||| AUTO نعيم بن عبد الحميد الواسطي(@)(@@) يروي عن السري بن إسماعيل، روى عنه محمد بن موسى الحرسي، ربما أغرب، قدم عليهم البصرة حاجا فكتب عنه أهلها.(@)PageV01P002(@)(@@) [ج 5: ص 553](@)(@@)(@@)(@@) ||| AUTO نعيم 
ms1698	 بن أبي بسطام(@)(@@) يروي عن أبيه، روى عنه مروان بن معاوية.(@)(@@)(@@)(@@) ||| AUTO نعيم بن حماد المروزي، أبو عبد الله الفارض(@)(@@) سكن مصر، يروي عن ابن المبارك والفضل بن موسى، روى عنه أبو حاتم الرازي، ربما أخطأ ووهم، مات سنة ثمان وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO نعيم بن يعقوب، أبو المتئد(@)(@@) يروي عن سفيان بن عيينة، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO نعيم بن الهيصم البوشنجي(@)(@@) سكن بغداد، يروي عن عبيد الله بن عمرو وأهل العراق، حدثنا عنه أحمد بن علي بن المثنى، مستقيم الحديث، كنيته أبو محمد، مات سنة ثمان وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO نعيم بن ناعم الأزدي، أبو حاتم(@)(@@) من أهل سمرقند، يروي عن ابن أبي شيبة وأهل العراق وعلي بن حجر وأهل خراسان، روى عنه أهل بلده، مستقيم الحديث، من أهل الورع والفضل والوقوف عن الشبهات، مات ليلة الجمعة غرة المحرم بسمرقند سنة ثمان وسبعين ومائتين، وصلى عليه يعلى بن حمزة وكان على الشرط بها.(@)(@@)(@@)(@@) ||| AUTO نصير بن زياد الطائي(@)(@@) يروي عن الصلت الديان، روى عنه معاوية بن هشام.(@)(@@)(@@)(@@) ||| AUTO نصير بن أبي درهم(@)(@@) يروي عن الضحاك، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO نصير بن يزيد الحنفي، أبو حمزة(@)(@@) من أهل سمرقند، يروي عن ابن عيينة، روى عنه السمرقنديون.(@)PageV01P002(@)(@@) [ج 5: ص 554](@)(@@)(@@)(@@) ||| AUTO نبيط بن عمرو بن عبد الرحمن بن إبراهيم المزني(@)(@@) يروي عن محمد بن عمرو بن طلحة، روى عنه عاصم بن عبد العزيز الأشجعي.(@)(@@)(@@)(@@) ||| AUTO نجيح بن إبراهيم الزماني(@)(@@) كوفي، كان يتفقه، يروي عن أبي نعيم والكوفيين، حدثنا عنه الدغولي، يغرب.(@)(@@)(@@)(@@) ||| AUTO نجيح بن مهران(@)(@@) قال: حدثني جار لي عن أبي وائل، يروي عنه مهدي بن ميمون.(@)(@@)(@@)(@@) ||| AUTO نذير بن حجاج بن واسط الجعفي(@)(@@) كوفي، يروي عن زياد بن خيثمة عن سماك بن حرب، روى عنه يحيى بن المنذر الكوفي.(@)(@@)(@@)(@@) ||| AUTO نجم بن حطيم(@)(@@) يروي عن سدير الضبي، روى عنه حميد بن المثنى أبو المعرا.(@)(@@)(@@)(@@) ||| AUTO نجم القطان(@)(@@) شيخ.(@)(@@) (727) -[5: 554] يروي عن عطاء الخراساني: أن رسول الله صلى الله عليه وسلم كان إذا 
ms1699	 خطب إليه من بناته جاء إلى خدرها، فقال: إن فلانا خطب فلانة، فإن سكتت فهو إذنها، وإن طعنت بإصبعها في الجدار لم يزوجها. حدثنا محمد بن إسحاق الثقفي، ثنا قتيبة بن سعيد، ثنا نجم القطان، عن عطاء الخراساني(@)(@@)(@@)(@@) ||| AUTO نعام بن سهل بن أوس بن نعام الحراني(@)(@@) من أهل البصرة، يروي عن الحسن بن علي الهاشمي عن الأعرج، روى عنه علي بن نصر بن علي الجهضمي.(@)(@@)(@@)(@@) ||| AUTO نزال العصري العبدي(@)(@@) يروي المقاطيع، روى عنه شهاب بن عباد.(@)(@@)(@@)(@@) ||| AUTO نوفل بن الفرات(@)(@@) يروي عن عمر بن عبد العزيز، روى عنه مبشر بن إسماعيل الحلبي.(@)PageV01P002(@)(@@) [ج 5: ص 555](@)(@@)(@@)(@@) ||| AUTO النمر بن قادم(@)(@@) من أهل البصرة، يروي عن حماد بن زيد، ثنا عنه بكر بن أحمد بن سعيد العائذي الطاحي بالبصرة.(@)(@@)(@@)(@@) ||| AUTO نهشل بن حريث العدوي(@)(@@) بصري، يروي عن عثمان الشحام، روى عنه أهل البصرة.(@)(@@) (728) -[5: 555] ثنا أبو خليفة، ثنا أبي، ثنا نهشل بن حريث العدوي، عن عثمان الشحام، قال: قالت معاذة العدوية: كتبت إلى سعيد بن المسيب فكتب إلينا أن ليس على النساء عيادة المرضى.(@)(@@)(@@)(@@) ||| AUTO نهشل بن كثير النهشلي(@)(@@) شيخ، يروي عن أبي ضمرة، حدثنا عنه ابن خزيمة، لم أر في حديثه شيئا ينكر إلا حديثا واحدا.(@)(@@) (729) -[5: 555] يروي عن سفيان بن عيينة، عن الزهري، عن عروة، عن عائشة، أن النبي صلى الله عليه وسلم قال: إن من الشعر لحكمة، حدثنا محمد بن المسيب، ثنا نهشل بن كثير، ثنا سفيان بن عيينة، وقد وافقه عليه الهيثم بن جميل، عن ابن عيينة، وقال فيه عن عائشة(@)(@@)(@@)(@@) || AUTO باب الواو(@)(@@) قال أبو حاتم:(@)(@@) وممن يروي عن أتباع التابعين ممن تبعهم ممن ابتدأ اسمه على الواو(@)(@@)(@@)(@@) ||| AUTO الوليد بن مسلم، أبو العباس الدمشقي(@)(@@) مولى لبني أمية، يروي عن الأوزاعي والثوري ومالك، روى عنه أحمد ويحيى وإسحاق وعلي وأهل بلده، كان مولده سنة تسع عشرة ومائة، ومات سنة أربع أو خمس وتسعين ومائة بذي المروة منصرفة من الحج، وكان ممن صنف وجمع، إلا أنه ربما قلب الأسامي وغير 
ms1700	 الكنى.(@)(@@)(@@)(@@) ||| AUTO الوليد بن كثير بن سنان المزني(@)(@@) من أهل الكوفة، كنيته أبو سعيد، PageV01P002 [ج 5: ص 556] يروي عن الضحاك بن عثمان، روى عنه زكريا بن عدي وأبو سعيد الأشج.(@)(@@) (730) -[5: 556] حدثنا الحسن بن أحمد بن بسطام بالأبلة، ثنا أبو سعيد الأشج، ثنا الوليد بن كثير بن سنان المزني، ثنا الضحاك بن عثمان، عن بكير بن الأشج، عن عامر بن سعد، عن أبيه، عن رسول الله صلى الله عليه وسلم قال: أنهاكم عن قليل ما أسكر كثيره(@)(@@)(@@)(@@) ||| AUTO الوليد بن بكير التميمي الكوفي، كنيته أبو الخباب(@)(@@) يروي عن عبد الله بن محمد العدوي والكوفيين، روى عنه الحسين المروزي والناس.(@)(@@)(@@)(@@) ||| AUTO الوليد بن سليمان بن أبي السائب الدمشقي(@)(@@) من أهل الشام، يروي عن أبيه، روى عنه ابنه عبد العزيز بن الوليد.(@)(@@)(@@)(@@) ||| AUTO الوليد بن عامر اليزني(@)(@@) يروي عن الشاميين، وقد سمع يزيد بن خمير، روى عنه ابنه مهدي بن الوليد.(@)(@@)(@@)(@@) ||| AUTO الوليد بن رباح الذماري(@)(@@) يروي عن نمران بن عتبة الذماري عن أم الدرداء، روى عنه يحيى بن حسان، يغرب.(@)(@@)(@@)(@@) ||| AUTO الوليد بن كامل، أبو عبيدة(@)(@@) يروي عن الوضين بن عطاء، روى عنه يحيى بن صالح الوحاظي.(@)(@@) (731) -[5: 556] حدثني محمد بن المنذر بن سعيد أبو زرعة البصري، ثنا يحيى بن صالح الوحاظي، ثنا الوليد بن كامل، حدثني الوضين بن عطاء، عن سالم بن عبد الله بن عمر، عن أبيه، أن قوما جاءوا يشترون منه شيئا، فقالوا: نشتري منك بالدق الزلزلة، فقال: " لست من دقكم ولا من زلزلتكم في شيء، ولكني أضع القفيز ثم أقرع فيه فما حمل فلكم وما سقط فلي "(@)(@@)(@@)(@@) ||| AUTO الوليد بن القاسم بن الوليد الهمداني(@)(@@) كوفي، يروي عن مجالد، روى عنه عبد بن حميد وأهل العراق.(@)PageV01P002(@)(@@) [ج 5: ص 557](@)(@@)(@@)(@@) ||| AUTO الوليد بن داود الأنصاري(@)(@@) من ولد عبادة بن الصامت، من أهل المدينة، يروي عن ابن عمه عباد بن الوليد، روى عنه إسماعيل بن أبي أويس.(@)(@@)(@@)(@@) ||| AUTO الوليد بن عبد الواحد التيمي(@)(@@) يروي عن معقل بن عبيد الله ومسعر بن كدام عن أبي 