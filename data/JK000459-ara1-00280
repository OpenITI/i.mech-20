ms261	(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال PageV02P733 ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ كشطت @QE@ يعني اجتبذت < <(@)(@@) | التكوير : ( 15 - 16 ) فلا أقسم بالخنس(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا المبارك بن فضالة عن الحسن @QB@ فلا أقسم بالخنس الجوار الكنس @QE@ قال هي الكواكب(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا حماد بن سلمة عن سماك بن حرب عن خالد بن عرعرة قال سمعت علي بن أبي طالب عليه السلام يقول @QB@ بالخنس الجوار الكنس @QE@ من النجوم تجري بالليل وتخنس بالنهار PageV02P734(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال نا إسرائيل عن ابن اسحاق الهمذاني عن عمرو بن شرحبيل قال هي بقر الوحش < <(@)(@@) | التكوير : ( 7 ) وإذا النفوس زوجت(@)(@@) > >(@)(@@) أنا عبد الرحمن قال نا إبراهيم قال نا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ إذا عسعس @QE@ يعني إذا أدبر < <(@)(@@) | التكوير : ( 23 ) ولقد رآه بالأفق . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال نا ورقاء عن عطاء بن السائب عن الشعبي @QB@ ولقد رآه بالأفق المبين @QE@ قال رأى رسول الله صلى الله عليه وسلم جبريل عليه ثياب خضر قد سد الأفق < <(@)(@@) | التكوير : ( 24 ) وما هو على . . . . .(@)(@@) > >(@)(@@) أنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وما هو على الغيب بضنين @QE@ يعني ببخيل يقول لا يضن عليكم بما يعلم < <(@)(@@) | التكوير : ( 28 ) لمن شاء منكم . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ لمن شاء منكم أن يستقيم @QE@ يعني أن يتبع الحق PageV02P735 <(@)(@@) > S82 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة اذا السماء انفطرت <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الإنفطار : ( 3 ) وإذا البحار فجرت(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شريك عن سعيد بن مسروق عن منذر الثوري عن الربيع بن خيثم في قوله @QB@ وإذا البحار فجرت @QE@ قال فاضت < <(@)(@@) | الإنفطار : ( 8 
ms262	 ) في أي صورة . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ في أي صورة ما شاء ركبك @QE@ يقول أي شبه شاء صورك شبه الأب أو الأم أو الخال أو العم < <(@)(@@) | الإنفطار : ( 9 ) كلا بل تكذبون . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ بل تكذبون بالدين @QE@ بالحساب PageV02P736 <(@)(@@) > S83 <(@)(@@) > <(@)(@@) > [ تفسير ] سورة المطففين <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | المطففين : ( 5 - 6 ) ليوم عظيم(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا حماد بن سلمة عن عاصم بن بهذلة عن خيثمة عن عبد الله بن عمرو بن العاص قال يشتد كرب ذلك اليوم حتى بلجم الكافر العرق فقيل له فأين المؤمنون قال على كراسي من ذهب ويظلل عليهم الغمام < <(@)(@@) | المطففين : ( 20 ) كتاب مرقوم(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا هشيم قال ثنا العوام بن حوشب عن القاسم بن عوف الشيباني عن كعب الأحبار قال المرقوم المكتوب < <(@)(@@) | المطففين : ( 14 ) كلا بل ران . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ بل ران على قلوبهم @QE@ PageV02P737 قال نبتت الخطايا على القلب حتى غمرته وهو الران الذي قال الله عز وجل @QB@ بل ران على قلوبهم @QE@(@)(@@) | المطففين : ( 15 ) كلا إنهم عن . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا أبو معمر عبد الله بن عمرو بن أبي الحجاج قال نا عبد الوارث بن سعيد أبو عبيدة قال نا عمرو بن عبيد عن الحسن قال لا يبقى أحد من خلقه يؤمن إلا رآه ثم يحجب عنه الكافرون ويراه المؤمنون فذلك قوله عز وجل @QB@ كلا إنهم عن ربهم يومئذ لمحجوبون @QE@ PageV02P738 < <(@)(@@) | المطففين : ( 18 ) كلا إن كتاب . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ إن كتاب الأبرار لفي عليين @QE@ قال العليون 
ms263	 السماء السابعة < <(@)(@@) | المطففين : ( 25 ) يسقون من رحيق . . . . .(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ يسقون من رحيق مختوم @QE@ قال الرحيق الخمر < <(@)(@@) | المطففين : ( 26 ) ختامه مسك وفي . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ ختامه مسك @QE@ يقول طيبه مسك(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا شيبان عن أشعث بن أبي الشعثاء عن زيد العيسى قال سألت علقمة بن قيس @QB@ ختامه مسك @QE@ قال خلطه مسك(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا شيبان عن جابر عن عبد الرحمن بن سابط عن أبي الدرداء في قوله @QB@ ختامه مسك @QE@ قال هو شراب أبيض مثل الفضة يختمون به آخر شرابهم لو أن رجلا من أهل الدنيا أدخل يده فيها ثم أخرجها لم يبق ذو روح إلا وجد ريح طيبها PageV02P739 < <(@)(@@) | المطففين : ( 27 ) ومزاجه من تسنيم(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد قال @QB@ تسنيم @QE@ يعني بتسنيم يعلو شراب أهل الجنة < <(@)(@@) | المطففين : ( 35 ) على الأرائك ينظرون(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ على الأرائك ينظرون @QE@ قال أرائك من لؤلؤ وياقوت(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبة عن عطاء قال التسنيم اسم العين التي تمزج بها الخمر < <(@)(@@) | المطففين : ( 36 ) هل ثوب الكفار . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ هل ثوب الكفار ما كانوا يفعلون @QE@ يقول هل جوزي الكفار بما كانوا يفعلون PageV02P740 <(@)(@@) > S84 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة اذا السماء انشقت <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الإنشقاق : ( 3 ) وإذا الأرض مدت(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد في قوله 
ms264	 @QB@ وأذنت لربها وحقت @QE@ قال سمعت لربها وأطاعت وأما قوله @QB@ وحقت @QE@ فيقول حق لها أن تفعل < <(@)(@@) | الإنشقاق : ( 4 ) وألقت ما فيها . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد وألقت ما فيها وتخلت قال أخرجت ما فيها من الموتى وتخلت منهم < <(@)(@@) | الإنشقاق : ( 8 ) فسوف يحاسب حسابا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا حماد بن زيد عن أيوب السختياني عن عبد الله بن أبي مليكة عن عائشة قالت سمعت رسول الله صلى الله عليه وسلم يقول من حوسب عذب قالت فقلت أليس يقول الله عز وجل @QB@ فسوف يحاسب حسابا يسيرا @QE@ فقال يا عائشة ذاكم العرض ولكن من نوقش الحساب عذب PageV02P741 < <(@)(@@) | الإنشقاق : ( 10 ) وأما من أوتي . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وأما من أوتي كتابه وراء ظهره @QE@ قال يجعل شماله وراء ظهره فيأخذ كتابه < <(@)(@@) | الإنشقاق : ( 14 ) إنه ظن أن . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ إنه ظن أن لن يحور @QE@ أن لن يرجع إلينا < <(@)(@@) | الإنشقاق : ( 16 ) فلا أقسم بالشفق(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ فلا أقسم بالشفق @QE@ قال الشفق النهار كله < <(@)(@@) | الإنشقاق : ( 17 ) والليل وما وسق(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا المبارك بن فضالة عن الحسن قال @QB@ والليل وما وسق @QE@ يقول وما جمع(@)(@@) أنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان قال قال منصور عن مجاهد @QB@ والليل وما وسق @QE@ قال يقول والليل وما لف عليه PageV02P742(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والليل وما وسق @QE@ يقول وما جمع يعني ما أوى إليه من دوابه < <(@)(@@) | الإنشقاق : ( 18 ) والقمر إذا اتسق 
ms265	(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والقمر إذا اتسق @QE@ يعني إذا استوى(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا شيبان عن منصور عن مجاهد مثله < <(@)(@@) | الإنشقاق : ( 19 ) لتركبن طبقا عن . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان عن جابر عن عكرمة عن ابن عباس @QB@ لتركبن طبقا عن طبق @QE@ قال يقول لتركبن من الأمور يا محمد حالا بعد حال(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا شريك عن السدي عن مرة عن ابن مسعود قال هي السماء تكون ألوانا @QB@ كالمهل @QE@ وتكون @QB@ وردة كالدهان @QE@ PageV02P743 وتكون @QB@ واهية @QE@ @QB@ تشقق @QE@ وتكون حالا بعد حال(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا شريك عن موسى بن أبي عائشة عن مرة عن ابن مسعود مثله(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا إسرائيل وشيبان عن جابر عن أبي الضحى عن مسروق أنه قرأها @QB@ لتركبن @QE@ قال يقول يا محمد لتركبن سماء بعد سماء < <(@)(@@) | الإنشقاق : ( 23 ) والله أعلم بما . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والله أعلم بما يوعون @QE@ يقول بما يكتمون PageV02P744 <(@)(@@) > S85 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة والسماء ذات البروج <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | البروج : ( 1 ) والسماء ذات البروج(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا محمد بن طلحة عن زيد الايامي عن مجاهد في قوله @QB@ والسماء @QE@ قال السماء موج مكفوف < <(@)(@@) | البروج : ( 2 - 3 ) واليوم الموعود(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شريك عن أبي اسحاق عن الحارث عن علي بن أبي طالب قال @QB@ واليوم الموعود @QE@ يوم القيامة والشاهد يوم الجمعة والمشهود يوم النحر يوم الحج الأكبر(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن المغيرة عن شباك قال حدثني من سمع 
ms266	 ابن عمر وابن الزبير يقولان الشاهد يوم الجمعة والمشهود يوم الذبح(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال PageV02P745 ثنا ورقاء عن المغيرة عن إبراهيم قال كان أصحابنا يقولون الشاهد يوم الجمعة و المشهود يوم الذبح(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا ورقاء عن المغيرة عن شباك قال حدثني من سمع الحسين بن علي بن أبي طالب عليهما السلام يقول الشاهد محمد صلى الله عليه وسلم و المشهود يوم القيامة ثم قرأ و ? < جئنا بك على هؤلآء شهيدا > ? ثم قرأ @QB@ وذلك يوم مشهود @QE@(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد قال الشاهد عيسى عليه السلام ويقال أيضا الشاهد الإنسان و المشهود يوم القيامة < <(@)(@@) | البروج : ( 4 ) قتل أصحاب الأخدود(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال PageV02P746 ثنا المبارك بن فضالة عن الحسن قال كان @QB@ أصحاب الأخدود @QE@ خدوا الخدود وملؤها نارا فألقوا فيها من آمن بالله وتركوا من كفر فألقوا بضعة وثمانين مؤمنا حتى أتوا على عجوز كبيرة وابنها خلفها صبي صغير فلما رأت النار كيف تأخذهم جزعت قالت يا بني أما ترى قال لها ابنها يا أمتاه امضي ولا تنافقي فمضت واقتحم ابنها على اثرها قال الحسن كانت لذعة النار ثم لا نار عليهم آخر ما عليهم ثم قال يا سبحان الله ما أصبر الله إنهم يعذبون أولياءه بالنار وهم يدعوهم إلى التوبة ثم قرأ @QB@ إن الذين فتنوا المؤمنين والمؤمنات @QE@ يقول أحرقوا المؤمنين والمؤمنات @QB@ ثم لم يتوبوا @QE@ أي فلو تابوا لتاب الله عز وجل عليهم(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد قال @QB@ الأخدود @QE@ شق في الأرض بنجران كانوا يعذبون الناس فيها PageV02P747 < <(@)(@@) | البروج : ( 10 ) إن الذين فتنوا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ إن الذين فتنوا المؤمنين 
ms267	 @QE@ يعني عذبوا PageV02P748 <(@)(@@) > S86 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة والسماء والطارق <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الطارق : ( 3 ) النجم الثاقب(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ النجم الثاقب @QE@ الذي يتوهج < <(@)(@@) | الطارق : ( 7 ) يخرج من بين . . . . .(@)(@@) > >(@)(@@) انبا عبد الرحمن قال حدثنا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والترائب @QE@ أسفل من التراقي < <(@)(@@) | الطارق : ( 8 ) إنه على رجعه . . . . .(@)(@@) > >(@)(@@) أنا عبد الرحمن قال نا إبراهيم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ إنه على رجعه لقادر @QE@ قال يقول أنه لعلى رجع النطفة في الإحليل لقادر < <(@)(@@) | الطارق : ( 10 ) فما له من . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ضمرة عن ربيعة عن سفيان الثوري في قوله @QB@ فما له من قوة ولا ناصر @QE@ قال القوة العشيرة والناصر الحليف PageV02P749 < <(@)(@@) | الطارق : ( 11 ) والسماء ذات الرجع(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والسماء ذات الرجع @QE@ يعني ذات السحاب يقول تمطر ثم ترجع بالمطر < <(@)(@@) | الطارق : ( 12 ) والأرض ذات الصدع(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والأرض ذات الصدع @QE@ قال الصدع مثل المأزم غير الأودية وغير الجرف < <(@)(@@) | الطارق : ( 14 ) وما هو بالهزل(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وما هو بالهزل @QE@ يقول ما هو باللعب PageV02P750 <(@)(@@) > S87 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة سبح <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الأعلى : ( 1 ) سبح اسم ربك . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا محمد بن الفضل عن زيد العمي عن مرة الهمذاني عن أبي هريرة قال قلنا يا رسول الله كيف نقول في سجودنا فأنزل الله عز وجل @QB@ سبح اسم ربك الأعلى @QE@ فأمرنا رسول الله صلى الله عليه وسلم أن نقول في سجودنا سبحان ربي الأعلى وترا < <(@)(@@) | الأعلى : ( 3 ) والذي 
ms268	 قدر فهدى(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد قال أما قوله @QB@ قدر @QE@ فيقول قدر للإنسان الشقاء والسعادة وأما قوله @QB@ هدى @QE@ فيقول هدى الأنعام لمراتعها < <(@)(@@) | الأعلى : ( 5 ) فجعله غثاء أحوى(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد قال الغثاء @QB@ غثاء @QE@ السيل و الأحوى اليابس PageV02P751 < <(@)(@@) | الأعلى : ( 6 ) سنقرئك فلا تنسى(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد قال كان رسول الله صلى الله عليه وسلم يتذكر القرآن في نفسه مخافة أن ينسى فقال الله عز وجل @QB@ سنقرئك فلا تنسى @QE@(@)(@@) | الأعلى : ( 18 - 19 ) إن هذا لفي . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ورقاء عن عطاء بن السائب عن عكرمة عن ابن عباس @QB@ إن هذا لفي الصحف الأولى @QE@ يقول إن هذه السورة سبح اسم ربك الأعلى وقوله وإبراهيم الذي وفى إلى آخره من صحف إبراهيم وموسى PageV02P752 <(@)(@@) > S88 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة الغاشية <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الغاشية : ( 5 ) تسقى من عين . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ تسقى من عين آنية @QE@ يقول قد بلغ أناها وحان شربها(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا المبارك بن فضالة عن الحسن قال كانت العرب تقول للشيء إذا انتهى حره حتى لا يكون شيء أحر منه قد أتى حره فقال الله عز وجل @QB@ من عين آنية @QE@ يقول أوقد الله عليهم جهنم منذ خلقت فأنى حرها < <(@)(@@) | الغاشية : ( 6 ) ليس لهم طعام . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد قال الضريع الشبرق اليابس < <(@)(@@) | الغاشية : ( 11 ) لا تسمع فيها . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال PageV02P753 ثنا ورقاء عن ابن أبي نجيح عن 
ms269	 مجاهد @QB@ لا تسمع فيها لاغية @QE@ يقول لا تسمع فيها شتما < <(@)(@@) | الغاشية : ( 22 ) لست عليهم بمصيطر(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ لست عليهم بمصيطر @QE@ يقول لست عليهم بجبار < <(@)(@@) | الغاشية : ( 17 ) أفلا ينظرون إلى . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا إسرائيل عن أبي إسحاق قال كان شريح يقول لأصحابه اخرجوا بنا ننظر @QB@ إلى الإبل كيف خلقت @QE@(@)(@@) | الغاشية : ( 23 ) إلا من تولى . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ إلا من تولى وكفر @QE@ يقول فحسابه على الله PageV02P754 <(@)(@@) > S89 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة الفجر بسم الله الرحمن الرحيم < <(@)(@@) | الفجر : ( 1 ) والفجر(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال نا قيس بن الربيع عن الأغر عن خليفة بن حصين عن أبي نصر عن ابن عباس في قوله @QB@ والفجر @QE@ قال هو الفجر الذي ترون من المشرق يقول فجر النهار(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد مثله < <(@)(@@) | الفجر : ( 3 ) والشفع والوتر(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا قيس بن الربيع عن الأغر عن خليفة عن أبي نصر عن ابن عباس @QB@ والشفع والوتر @QE@ @QB@ والوتر @QE@ يوم عرفة(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد قال كل شيء خلقه PageV02P755 الله فهو شفع السماء شفع والأرض شفع والبر والبحر والشمس والقمر والإنسان هذا كله شفع @QB@ والوتر @QE@ هو الله الواحد القهار < <(@)(@@) | الفجر : ( 5 ) هل في ذلك . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا قيس بن الربيع عن الأغر عن خليفة بن حصين عن أبي نصر عن ابن عباس @QB@ هل في ذلك قسم لذي حجر @QE@ لذي عقل لذي رأي لذي قدرة لذي نهى < <(@)(@@) | الفجر : ( 7 ) إرم ذات العماد(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم 
ms270	 قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ إرم @QE@ يعني القديمة(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ ذات العماد @QE@ قال كانوا أهل عمود لا يقيمون PageV02P756 < <(@)(@@) | الفجر : ( 13 ) فصب عليهم ربك . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ فصب عليهم ربك سوط عذاب @QE@ قال يعني الذي عذبوا به < <(@)(@@) | الفجر : ( 20 ) وتحبون المال حبا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ حبا جما @QE@ قال الجم الكثير < <(@)(@@) | الفجر : ( 27 ) يا أيتها النفس . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ يا أيتها النفس المطمئنة @QE@ يعني المخبتة المطمئنة إلى ربها PageV02P757 <(@)(@@) > S90<(@)(@@) > <(@)(@@) >[ تفسير ] سورة لا أقسم بهذا البلد <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | البلد : ( 2 ) وأنت حل بهذا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا شيبان عن منصور وورقاء عن ابن أبي نجيح عن مجاهد في قوله عز وجل @QB@ وأنت حل بهذا البلد @QE@ يعني مكة يقول لا تؤاخذ بما عملت فيه ليس عليه فيه ما على الناس من الإثم < <(@)(@@) | البلد : ( 3 ) ووالد وما ولد(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ ووالد وما ولد @QE@ قالوا الوالد آدم و ما ولد يعني ولده(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا شريك عن خصيف عن عكرمة عن ابن عباس قال أما PageV02P758 الوالد فهو الذي يولد وأما @QB@ وما ولد @QE@ فالعاقر الذي لا يولد له من الرجال والنساء < <(@)(@@) | البلد : ( 4 ) لقد خلقنا الإنسان . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ لقد خلقنا الإنسان في كبد @QE@ يعني 
ms271	 في شدة(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان عن منصور عن إبراهيم قال يعني منتصبا < <(@)(@@) | البلد : ( 6 ) يقول أهلكت مالا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ مالا لبدا @QE@ قال مالا كثيرا < <(@)(@@) | البلد : ( 10 ) وهديناه النجدين(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال نا شريك عن خصيف عن عكرمة عن ابن عباس @QB@ وهديناه النجدين @QE@ قال هديناه السبيلين سبيل الخير وسبيل الشر يقول عرفناه سبيل الخير وسبيل الشر(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم PageV02P759 قال ثنا شريك عن عاصم بن أبي النجود عن زر عن ابن مسعود قال يقول @QB@ هديناه @QE@ سبيل الخير وسبيل الشر(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا قيس عن زياد بن علاقة عن أبي عمارة عن علي بن أبي طالب عليه السلام مثله(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد مثله(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا هشيم عن جويبر عن الضحاك مثله < <(@)(@@) | البلد : ( 14 ) أو إطعام في . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ أو إطعام في يوم ذي مسغبة @QE@ قال ذي مجاعة(@)(@@) انبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا المبارك بن فضالة عن الحسن @QB@ في يوم ذي مسغبة @QE@ قال يقول في يوم الطعام فيه عزيز < <(@)(@@) | البلد : ( 16 ) أو مسكينا ذا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم ثنا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله عز وجل @QB@ مسكينا ذا متربة @QE@ قال يقول هو المسكين الساقط في التراب PageV02P760(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن حصين عن مجاهد قال هو الترب الذي لا يقيه من 
ms272	 التراب شيء < <(@)(@@) | البلد : ( 20 ) عليهم نار مؤصدة(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شريك عن عاصم بن أبي النجود عن أبي صالح عن أبي هريرة @QB@ عليهم نار مؤصدة @QE@ قال يعني نارا مطبقة عليهم(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد مثله PageV02P761 <(@)(@@) > S91 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة والشمس وضحاها <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الشمس : ( 1 ) والشمس وضحاها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والشمس وضحاها @QE@ قال يعني ضوؤها < <(@)(@@) | الشمس : ( 2 ) والقمر إذا تلاها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والقمر إذا تلاها @QE@ يعني إذا تبعها < <(@)(@@) | الشمس : ( 3 ) والنهار إذا جلاها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال حدثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والنهار إذا جلاها @QE@ يعني إذا أضاء < <(@)(@@) | الشمس : ( 5 ) والسماء وما بناها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والسماء وما بناها @QE@ PageV02P762 يقول الله عز وجل بنى السماء < <(@)(@@) | الشمس : ( 6 ) والأرض وما طحاها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ والأرض وما طحاها @QE@ يعني وما دحاها < <(@)(@@) | الشمس : ( 8 ) فألهمها فجورها وتقواها(@)(@@) > >(@)(@@) أنا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا حماد بن سلمة قال نا حنظلة بن أبي حمزة عن سعيد بن جبير @QB@ فألهمها فجورها وتقواها @QE@ قال ألزمها الفجور والتقوى(@)(@@) أنا عبد الرحمن قال نا إبراهيم قال نا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد قال عرفها الشقاء والسعادة < <(@)(@@) | الشمس : ( 11 ) كذبت ثمود بطغواها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ بطغواها @QE@ قال يعني بمعصيتها < <(@)(@@) | الشمس : ( 10 ) وقد خاب 
ms273	 من . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وقد خاب من دساها @QE@ PageV02P763 يعني خاب من أغواه الله عز وجل < <(@)(@@) | الشمس : ( 15 ) ولا يخاف عقباها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ ولا يخاف عقباها @QE@ قال إن الله لا يخاف عقباها أي لا يخاف عقاب أحد PageV02P764 <(@)(@@) > S92 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة والليل اذا يغشى <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الليل : ( 6 ) وصدق بالحسنى(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا سليمان بن حبان عن داود بن أبي هند عن عكرمة عن ابن عباس @QB@ وصدق بالحسنى @QE@ قال يقول صدق بالخلف < <(@)(@@) | الليل : ( 11 ) وما يغني عنه . . . . .(@)(@@) > >(@)(@@) انبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وما يغني عنه ماله إذا تردى @QE@ يعني إذا مات < <(@)(@@) | الليل : ( 14 ) فأنذرتكم نارا تلظى(@)(@@) > >(@)(@@) انبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ نارا تلظى @QE@ يقول توهج < <(@)(@@) | الليل : ( 16 ) الذي كذب وتولى(@)(@@) > >(@)(@@) انبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا أبو فضالة عن لقمان بن عامر عن أبي أمامة في قوله @QB@ الذي كذب وتولى @QE@ يقول كذب بما جاء به محمد صلى الله عليه وسلم وتولى عنه PageV02P765 <(@)(@@) > S93 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة الضحى <(@)(@@) > بسم الله الرحمن الرحيم أنبا عبد الرحمن قال < <(@)(@@) | الضحى : ( 2 ) والليل إذا سجى(@)(@@) > >(@)(@@) ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والليل إذا سجى @QE@ يقول إذا استوى < <(@)(@@) | الضحى : ( 11 ) وأما بنعمة ربك . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا حبان عن سعيد بن طريف عن مقسم أبي عبد الرحمن قال أتيت حسن بن علي فصافحني ثم قال هذا تقبيل المؤمن المؤمن فقلت أرأيت قوله @QB@ وأما بنعمة ربك فحدث @QE@ قال هو العمل الصالح يعمله الرجل 
ms274	 فيحدث به إخوانه من أهل ثقاته ليستن به ويعمل مثله PageV02P766 <(@)(@@) > S94 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة ألم نشرح <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الشرح : ( 2 ) ووضعنا عنك وزرك(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ ووضعنا عنك وزرك @QE@ قال ذنبك في الجاهلية < <(@)(@@) | الشرح : ( 3 ) الذي أنقض ظهرك(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ الذي أنقض ظهرك @QE@ أثقل ظهرك < <(@)(@@) | الشرح : ( 5 ) فإن مع العسر . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ فإن مع العسر يسرا @QE@ يقول اتبع العسر يسرا اتبع العسر يسرا PageV02P767 < <(@)(@@) | الشرح : ( 7 ) فإذا فرغت فانصب(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ فإذا فرغت فانصب @QE@ قال يقول إذا قمت إلى الصلاة فانصب في حاجتك إلى ربك < <(@)(@@) | الشرح : ( 8 ) وإلى ربك فارغب(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن منصور عن مجاهد قال يقول إذا فرغت من أمر الدنيا فقمت إلى الصلاة فاجعل رغبتك ونيتك إلى الله عز وجل PageV02P768 <(@)(@@) > S95 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة والتين والزيتون <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | التين : ( 1 ) والتين والزيتون(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والتين والزيتون @QE@ قال هما التين والزيتون الذي يأكل الناس < <(@)(@@) | التين : ( 2 ) وطور سينين(@)(@@) > >(@)(@@) أنا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وطور سينين @QE@ قال الطور الجبل والسينين المبارك PageV02P769 < <(@)(@@) | التين : ( 4 - 6 ) لقد خلقنا الإنسان . . . . .(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا قيس بن الربيع وشيبان عن عاصم بن أبي النجود عن أبي رزين عن ابن عباس @QB@ في أحسن تقويم @QE@ قال يعني في أعدل خلق @QB@ ثم رددناه أسفل 
ms275	 سافلين @QE@ يعني إلى أرذل العمر @QB@ إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون @QE@ يقول غير منقوص يقول فإذا بلغ المؤمن أرذل العمر وكان يعمل في شبابه عملا صالحا كتب الله له الأجر مثل ما كان يعمل في صحته وشبابه ولم يضره ما كان يعمل في كبره ولم يكتب عليه الخطايا التي يعمل بعد ما يبلغ أرذل العمر(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا قيس بن الربيع عن سالم الأفطس عن سعيد بن جبير عن ابن عباس مثله وزاد فيه ولا يؤاخذ بما عمل في كبره بعد ما يرد إلى أرذل العمر من الخطايا(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ في أحسن تقويم @QE@ PageV02P770 يعني في أحسن خلق @QB@ ثم رددناه أسفل سافلين @QE@ يعني إلا من آمن PageV02P771 <(@)(@@) > S96 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة اقرأ باسم ربك <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | العلق : ( 9 - 10 ) أرأيت الذي ينهى(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ أرأيت الذي ينهى عبدا إذا صلى @QE@ 6 قال يعني أبا جهل ابن هشام كان ينهى النبي صلى الله عليه وسلم عن الصلاة < <(@)(@@) | العلق : ( 17 ) فليدع ناديه(@)(@@) > >(@)(@@) انبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ فليدع ناديه @QE@ يعني عشيرته يعني أبا جهل < <(@)(@@) | العلق : ( 18 ) سندع الزبانية(@)(@@) > >(@)(@@) انبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ سندع الزبانية @QE@ قال الزبانية الملائكة PageV02P772 <(@)(@@) > S97 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة القدر <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | القدر : ( 3 ) ليلة القدر خير . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا الزنجي بن خالد قال ثنا ابن أبي نجيح عن مجاهد قال بلغني أنه كان في بني إسرائيل رجل لبس السلاح في سبيل الله ألف شهر فلم يضعه عنه فذكر ذلك 
ms276	 رسول الله صلى الله عليه وسلم لأصحابه فعجبوا من قوله فأنزل الله عز وجل @QB@ ليلة القدر خير من ألف شهر @QE@ يقول الله ليلة القدر خير لكم من تلك الألف شهر التي لبس ذلك الرجل فيها السلاح في سبيل الله فلم يضعه عنه PageV02P773 <(@)(@@) > S98 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة لم يكن <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | البينة : ( 1 ) لم يكن الذين . . . . .(@)(@@) > >(@)(@@) انبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال [ ثنا ] ورقاء عن ابن أبي نجيح عن مجاهد @QB@ منفكين @QE@ يعني منتهين يقول لم يكونوا ليؤمنوا حتى يتبين لهم الحق PageV02P774 <(@)(@@) > S99 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة اذا زلزلت <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الزلزلة : ( 2 ) وأخرجت الأرض أثقالها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وأخرجت الأرض أثقالها @QE@ قال يقول أخرجت من في القبور < <(@)(@@) | الزلزلة : ( 4 ) يومئذ تحدث أخبارها(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ يومئذ تحدث أخبارها @QE@ تحدث بأخبار الناس بما عملوا عليها من خير أو شر < <(@)(@@) | الزلزلة : ( 5 ) بأن ربك أوحى . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ بأن ربك أوحى لها @QE@ يقول أمرها فألقت ما فيها وتخلت منهم PageV02P775 <(@)(@@) > S100 <(@)(@@) > <(@)(@@) > [ تفسير ] سورة العاديات <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | العاديات : ( 1 ) والعاديات ضبحا(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ والعاديات ضبحا @QE@ يعني الخيل تضبح < <(@)(@@) | العاديات : ( 2 ) فالموريات قدحا(@)(@@) > >(@)(@@) انبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ فالموريات قدحا @QE@ يعني مكر الرجال < <(@)(@@) | العاديات : ( 3 ) فالمغيرات صبحا(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ فالمغيرات صبحا @QE@ قال يعني الخيل قال وذاك في القتال(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم 
ms277	 قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد عن ابن مسعود في قوله فالمغيرات صبحا قال يعني الخيل قال وذاك في الحج < <(@)(@@) | العاديات : ( 3 ) فالمغيرات صبحا(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال PageV02P776 ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ فوسطن به جمعا @QE@ قال هؤلاء وهؤلاء < <(@)(@@) | العاديات : ( 6 ) إن الإنسان لربه . . . . .(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا حماد بن زيد عن عمرو بن ملك النكري عن أبي الجوزاء عن ابن عباس قال الكنود الكفور(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال حدثنا آدم قال حدثنا شيبان عن منصور عن مجاهد قال الكنود الكفور(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد قال الكنود الكفور PageV02P777 <(@)(@@) > S101 <(@)(@@) > [ تفسير ] سورة القارعة <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | القارعة : ( 9 ) فأمه هاوية(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا المبارك بن فضالة عن الحسن قال قال رسول الله صلى الله عليه وسلم إذا مات العبد تلقى روحه أرواح المؤمنين فيقولون له ما فعل فلان فإذا قال مات قبلي قالوا ذهب به إلى أمه الهاوية وبئست الأم وبئست المربية PageV02P778 <(@)(@@) > S102 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة ألهاكم <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | التكاثر : ( 8 ) ثم لتسألن يومئذ . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا حبان بن علي قال ثنا ابن طريف عن الأصبع بن نباتة عن علي بن أبي طالب عليه السلام @QB@ ثم لتسألن يومئذ عن النعيم @QE@ قال النعيم هو العافية PageV02P779 <(@)(@@) > S103 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة العصر <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | العصر : ( 2 ) إن الإنسان لفي . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا أبو داود الواسطي عن أبي علي عن كعب @QB@ إن الإنسان لفي خسر @QE@ قال يعني آدم وبنيه(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ لفي خسر @QE@ يعني لفي ضلال 
ms278	 ثم استثنى فقال إلا من آمن < <(@)(@@) | العصر : ( 3 ) إلا الذين آمنوا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا أبو داود الواسطي عن أبي علي عن كعب @QB@ وتواصوا بالحق @QE@ قال الحق هو الله عز وجل والإيمان به @QB@ وتواصوا بالصبر @QE@ قال الصبر على فرائض الله وحكمه PageV02P780 <(@)(@@) >S104 <(@)(@@) > <(@)(@@) >[تفسير ] سورة ويل لكل همزة <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الهمزة : ( 1 ) ويل لكل همزة . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ناإبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن المبارك عن ابن جريج قال الهمزة بالعين والشدق واليد واللمزة باللسان < <(@)(@@) | الهمزة : ( 7 ) التي تطلع على . . . . .(@)(@@) > >(@)(@@) انبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا سليمان بن حبان قال ثنا موسى بن عبيدة الربذي قال سمعت محمد بن كعب القرظي في قوله عز وجل @QB@ التي تطلع على الأفئدة @QE@ يقول @QB@ الحطمة @QE@ يقول تأكله النار إلى فؤاده فإذا بلغت فؤاده أنشأ خلقه PageV02P781 <(@)(@@) > S105 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة الفيل <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الفيل : ( 3 ) وأرسل عليهم طيرا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان عن جابر عن عكرمة @QB@ طيرا أبابيل @QE@ يعني زمرا زمرا(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان عن جابر عن عبد الرحمن بن سابط قال يعني الكثير(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ طيرا أبابيل @QE@ يعني من شتى مجتمعة متتابعة < <(@)(@@) | الفيل : ( 4 ) ترميهم بحجارة من . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال ثنا حماد بن سلمة عن أيوب السختياني وحميد الطويل عن عكرمة @QB@ ترميهم بحجارة من سجيل @QE@ قال هي PageV02P782 بالفارسية سنك وكل يعني حجرا وطينا(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن عطاء بن السائب عن عكرمة قال هي بالفارسية والنبطية < <(@)(@@) | الفيل : ( 3 ) وأرسل عليهم طيرا . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شريك عن جابر عن عبد 
ms279	 الرحمن بن سابط عن عبيد بن عمير الليثي قال الأبابيل المتتابعة خرجت الطير من البحر كأنها أمثال رجال الهند سود معها حجارة أعظمها أمثال الإبل البزل وأصغرها أمثال رؤوس الرجال لا تريد شيئا إلا أصابته ولا تصيب أحدا إلا قتلته(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال نا آدم قال نا شريك عن جابر عن مجاهد قال هي العنقاء المغربة(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان عن جابر عن [ مجاهد قال هي مثل طير تصيب منهم لم تر قبلهم ] ولا بعدهم ترميهم بحجارة PageV02P783 صغار مثل البلسان من الصغر لا تصيب منهم شيئا إلا أفصلته حتى ينفذ(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان عن جابر عن عكرمة قال هي العنقاء المغربة ترميهم بحجارة مثل التين تخرج من مخالبها وأفواهها لا تصيب منهم شيئا إلا حرقته حتى كان يموت منهم في اليوم مائة ألف(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال نا آدم قال ثنا شريك عن حصين عن عكرمة قال هي طير بيض كأن وجوهها وجوه السباع < <(@)(@@) | الفيل : ( 5 ) فجعلهم كعصف مأكول(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد في قوله @QB@ كعصف مأكول @QE@ العصف ورق الحنطة(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن عطاء بن السائب عن سعيد بن جبير قال العصف هو الهبور PageV02P784 <(@)(@@) > S106 <(@)(@@) > <(@)(@@) >[ تفسير ] سورة لايلاف <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | قريش : ( 1 ) لإيلاف قريش(@)(@@) > >(@)(@@) أخبرنا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ لإيلاف قريش @QE@ قال كانوا ألفوا ذلك فلا تشق عليهم رحلة شتاء ولا صيف < <(@)(@@) | قريش : ( 4 ) الذي أطعمهم من . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ وآمنهم من خوف @QE@ قال آمنهم من كل عدو في حرمهم PageV02P785 <(@)(@@) > S107 <(@)(@@) > <(@)(@@) > [ تفسير 
ms280	 ] سورة أرأيت <(@)(@@) > بسم الله الرحمن الرحيم < <(@)(@@) | الماعون : ( 2 ) فذلك الذي يدع . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا ورقاء عن ابن أبي نجيح عن مجاهد @QB@ الذي يدع اليتيم @QE@ يقول يدفع اليتيم عن حقه ويظلمه < <(@)(@@) | الماعون : ( 5 ) الذين هم عن . . . . .(@)(@@) > >(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال نا شيبان عن عاصم بن أبي النجود عن مصعب بن سعد بن أبي وقاص في قوله @QB@ الذين هم عن صلاتهم ساهون @QE@ قال سألت أبي فقلت أهو حديث أحدنا يحدث نفسه في صلاته فقال لا كلنا يحدث نفسه في صلاته ولكنه السهو عنها ترك وقتها(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا هشيم عن المغيرة عن إبراهيم قال في قراءة ابن مسعود PageV02P786 عن صلاتهم لاهون(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا عقبة قال سمعت الحسن يقول السهو عنها تأخيرها عن وقتها(@)(@@) أنبا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا المبارك بن فضالة عن الحسن قال هو الذي إن صلى صلى رياء وإن فاتته لم يندم(@)(@@) أنا عبد الرحمن قال نا إبراهيم قال ثنا آدم قال ثنا شيبان عن جابر قال حدثني من سمع أبا برزة الاسلمي يقول لما نزلت @QB@ الذين هم عن صلاتهم ساهون @QE@ قال رسول الله صلى الله عليه وسلم الله أكبر هذه خير لكم من أن يعطى كل واحد منكم مثل جميع الدنيا هو الذي إن صلى لم يرج خير صلاته وإن تركها لم يخف ربه(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا عقبة قال سألت أبا العالية عن هذه الآية فقال هو الذي إذا صلى صنع هكذا وهكذا يلتفت عن يمينه وعن شماله PageV02P787(@)(@@) أنبا عبد الرحمن قال ثنا إبراهيم قال ثنا آدم قال ثنا شيبان عن جابر قال سألت أبا جعفر قال نا إبراهيم قال نا آدم قال ثنا شيبان عن جابر قال سألت عنها عكرمة ومجاهدا فقالا السهو 