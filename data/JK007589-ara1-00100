ms81	 % % 22(@)(@@) % منع العين أن تقر وقرت % % عين واش بنا وعين رقيب % % 23(@)(@@) % شان ديباجة الشباب وأزرى % % بقوام له ولين عسيب % 24(@)(@@) % نفر الحلم ثم ثنى فأمسى % % خبب العرس أيما تخبيب % % 25(@)(@@) % شعر ميت لذي وطر حي % ي كنار الحريق ذات اللهيب % % 26(@)(@@) % في قناع من المشيب لبيس % ورداء من الشباب قشيب % % 27(@)(@@) % وأخو الشيب واللبانة في البي % % ض بحال كقتلة التغبيب % % 28(@)(@@) % معه صبوة الفتى وعليه % % صرفة الشيخ فهو في تعذيب % % 29(@)(@@) % يطبى للصبا فيدعى مجيبا % وهو يدعو وما له من مجيب % % 30(@)(@@) % ليس تنقاد غادة لهواه % وهو ينقاد كانقياد الجنيب % % PageV01P330 31(@)(@@) % ظلمتني الخطوب حتى كأني % % ليس بيني وبينها من حسيب % % 32(@)(@@) % سلبتني سواد رأسي ولكن % % عوضتني رياش كل سليب % % 33(@)(@@) % عوضتني أخا المعالي عليا % عوض فيه سلوة للحريب % % 34(@)(@@) % خرمي من الملوك أديب % لم يزل ملجأ لكل أديب % % 35(@)(@@) % يستغيث اللهيف منه بمدعو % و لدى كل كربة مستجيب % % 36(@)(@@) % أريحي له إذا حمد الكز % ز بنان تذوب للمستذيب % % 37(@)(@@) % يتلقى المدفعين عن الأب % % بواب بالبشر منه والترحيب % % 38(@)(@@) % لو أبى الراغبون يوما نداه % لدعاهم إليه بالترهيب % % 39(@)(@@) % رب أكرومة له لم تخلها % % قبله في الطباع والتركيب % % 40(@)(@@) % غربته الخلائق الزهر في النا % % س وما أوحشته بالتغريب % % PageV01P331 41(@)(@@) % يهب النائل الجزيل معيرا % طرفه الأرض ناكتا بالقضيب % % 42(@)(@@) % يتقي نظرة المدل بجدوا % % ه ويعتدها من التثريب % % 43(@)(@@) % بعد بشر مبشر سائليه % % بأمان لهم من التخييب % % 44(@)(@@) % حببت كفه السؤال إلى النا % % س جميعا وكان غير حبيب % % 45(@)(@@) % ما سعى والسعاة للمجد إلا % % سبق المحضرين بالتقريب % % 46(@)(@@) % لو جرى والرياح شأوا لأضحى % % جريها عند جريه كالدبيب % % 47(@)(@@) % من رآه رأى شواهد تغني % % عن سماع الثناء والتجريب % % 48(@)(@@) % فيه من وجهه دليل عليه % % مخبر عن ضريبة ذات طيب % % 49(@)(@@) % حكم الله بالعلا لعلي % وبحق النجيب وابن النجيب % % 50(@)(@@) % فليمت حاسدوه هما وغما % ما لحكم الإله من تعقيب % % PageV01P332 51(@)(@@) % جذل سلطانه المحكك في الخط % ب وعذق الجناة ذو الترحيب % % 52(@)(@@) % والنصيح الصريح نصحا إذا 
ms82	 ما % % جمعوا بين رائب وحليب % % 53(@)(@@) % والذي رأيه لأسلحة الإب % % طال مثل الصقال والتذريب % % 54(@)(@@) % عنه تمضي ولو تعدته أضحت % % من كليل مفلل وخشيب % % 55(@)(@@) % مدره الدين والخلافة ذو النص % % ح عن الحوزتين والتذبيب % % 56(@)(@@) % فل بالحجة الخصوم وبالكي % % د زحوف العدا ذوي التأليب % % 57(@)(@@) % رب مغنى لحزب إبليس أخلا % % ه فأمسى وما به من عريب % 58(@)(@@) % دمرت أهله مكائد كانت % % لأسود الطغاة كالتقشيب % % 59(@)(@@) % رتبته الملوك مرتبة المد % ره لا مخطئين في الترتيب % % 60(@)(@@) % قيم قوم الأمور فعادت % قيمات به من التحنيب % % PageV01P333 61(@)(@@) % واستناب الخطوب حتى أنابت % % وبما لا تنيب للمستنيب % % 62(@)(@@) % عنده للثأي طباب من التد % % بير يعي به ذوو التطبيب % % 63(@)(@@) % لوذعي له فؤاد ذكي % % ماله في ذكائه من ضريب % % 64(@)(@@) % يقظ في الهنات ذو حركات % % لسكون القلوب ذات الوجيب % % 65(@)(@@) % ألمعي يرى بأول ظن % آخر الأمر من وراء المغيب % % 66(@)(@@) % لا يروي ولا يقلب كفا % وأكف الرجال في تقليب % % 67(@)(@@) % يدرك الطلب بالبديهة دون ال % % عقب قبل التصعيد والتصويب % % 68(@)(@@) % حازم الرأي ليس عن طول تجري % % ب لبيب وليس عن تلبيب % % 69(@)(@@) % وأريب فإن مريغو نداه % % خادعوه رأيت غير أريب % % 70(@)(@@) % يتغابى لهم وليس لموق % بل للب يفوق لب اللبيب % % PageV01P334 71(@)(@@) % ثابت الحال في الزلازل منها % % ل لسؤاله انهيال الكثيب % % 72(@)(@@) % لين عطفه فإن ريم منه % % مكسر العود كان جد صليب % % 73(@)(@@) % مفزع للرعاة مرعى خصيب % لرعاياهم وفوق الخصيب % 74(@)(@@) % في حجاه وفي نداه أمانا % % ن من الخوف والزمان الجديب % % 75(@)(@@) % فحجاه لكل يوم عصيب % ونداه لكل عام شصيب % % 76(@)(@@) % أحسنت وصفه مساعيه حتى % % أفحمت كل شاعر وخطيب % % 77(@)(@@) % بل حذوا حذوها فراحوا يريحو % % ن من القول كل معنى غريب % % 78(@)(@@) % قد بلونا خلاله فحمدنا % % غيبها حمد ذائق مستطيب % % 79(@)(@@) % فانتجعنا به الحيا غير ذي الإق % لاع والبحر غير ذي التنضيب % % 80(@)(@@) % ما زجرنا وقد صرفنا إليه % % أوجه العيس بارحا ذا نعيب % % PageV01P335 81(@)(@@) % يممته بنا المطايا فأفضت % من فضاء إلى فضاء رحيب % % 82(@)(@@) % خلق منه واسع 
ms83	 وفناء % لم يرعها به هدير كليب % % 83(@)(@@) % طاب لليعملات إذ يممته % وصلهن البكور بالتأويب % % 84(@)(@@) % لم يكن خفضها أحب إليها % % من رسيم إليه بعد خبيب % % 85(@)(@@) % ثقة إنهن يلقين مرعى % فيه ني لكل نضو شزيب % % 86(@)(@@) % أيهذا المهيب بي وبشعري % % لست ممن يجيب كل مهيب % % 87(@)(@@) % رفع الله رغبتي عن عطايا % % ك وما للعقاب والعندليب % % 88(@)(@@) % ثوبت بي إلى علي معالي % % ه فلبيت أول التثويب % % 89(@)(@@) % ماجد حارب الحوادث دوني % % بندى حاتم وبأس شبيب % 90(@)(@@) % لي في جاهه مآرب كانت % % لابن عمران في عصاه الشعيب % PageV01P336 91(@)(@@) % وإذا حز لي من المال عضوا % أرب العضو أيما تأريب % % 92(@)(@@) % أصبح الباذل المسبب لا زا % % ل مليا بالبذل والتسبيب % % 93(@)(@@) % ساجلت جاهه سحائب عرف % من يمينيه دائمات الصبيب % % 94(@)(@@) % قلت إذ جاد باللهى قبل سعي % % صادق منه غير ذي تكذيب % % 95(@)(@@) % يا رشاء تخضل منه يد الما % % تح قبل انغماسه في القليب % % 96(@)(@@) % بض لي من نداك قبل استقائي % % بك ريي وفضلة للشريب % % 97(@)(@@) % ذاك شيء من الرشاء غريب % يا ابن يحيى ومنك غير غريب % % 98(@)(@@) % ما أراني إذا خبطت بدلوي % % جمة الماء بالقليل النصيب % % 99(@)(@@) % لا لعمري وكيف ذاك وقبل ال % % متح رويتني بسجل رغيب % % 100(@)(@@) % بل أراني هناك لا شك أغدو % % ويدي منك ذات بطن عشيب % % PageV01P337 101(@)(@@) % بأبي أنت من جليل مهيب % مطلب العرف منه غير مهيب % % 102(@)(@@) % طنب المجد بالمكارم والبي % % ت بنصب العماد والتطنيب % % 103(@)(@@) % من يلقب فإن أسماءك الأس % % ماء يشغلن موضع التلقيب % % 104(@)(@@) % من جواد وماجد وكريم % وزعيم وسيد ونقيب % % 105(@)(@@) % تب من يرتجي لحاقك في المج % % د وما مرتجيك في تتبيب % % 106(@)(@@) % أعجز الطالبيك شأو بعيد % لك أدركته بعرف قريب % % 107(@)(@@) % هاكها مدحة يغني بها الرك % بان ما أرزمت روائم نيب % 108(@)(@@) % نظم الفكر درها غير مثقو % % ب إذا الدر شين بالتشعيب % % 109(@)(@@) % لم يعبها سوى قواف تشاغل % % ن عن المدح فيك بالتشبيب % % 110(@)(@@) % ولراجيك قبلها كلمات % هذبت فيك أيما تهذيب % % PageV01P338 111(@)(@@) % يطرب السامعين أيسر ما 
ms84	 في % % ها وإن أنشدت بلا تطريب % % 112(@)(@@) % سودت فيك كل بيضاء تسوي % % دا تراه العقول كالتذهيب % % 113(@)(@@) % لو يناغي بيانها العجم يوما % عرب العجم أيما تعريب % % 114(@)(@@) % وهي مما أفاد تأديبك الفا % % ضل واها لذاك من تأديب % % 115(@)(@@) % كم ثواب أثبتنيه عليها % % كنت أولى به من المستثيب % % 116(@)(@@) % منعما نعميين نعمى مفيد % % أدبا نافعا ونعمى مثيب % % 117(@)(@@) % منك جاءت إليك يحدو بها الود % دعلى رغبة بلا ترغيب % % PageV01P339 البحر : - 1(@)(@@) % لم أطلها كما أطال رشاء % ماتح ساء ظنه بقليب % % 2(@)(@@) % حاش لله ليس مثلي تظنى % % ظن سوء بمستقاك القريب % % 3(@)(@@) % غير أني امرؤ وحدت مقالا % مستتبا في كل قرم نجيب % % 4(@)(@@) % فأطلت المديح ما طال فيهم % % مع أني قصرت غير معيب % % PageV01P340 البحر : - 1(@)(@@) % تأمل العيب عيب % وليس في الحق ريب % 2(@)(@@) % وكل خير وشر % خلف العواقب غيب % 3(@)(@@) % إن يمسك الناس عني % % سيبا فلله سيب % 4(@)(@@) % يا رب غمة خطب % فيها من الصنع جيب % 5(@)(@@) % لا تحقرن سييبا % كم جر نفعا سييب % % PageV01P341 البحر : - 1(@)(@@) % يا ابن المسيب عشت في نعم % وسلمت من هلك ومن عطب % 2(@)(@@) % يا شاعر العجم الكرام كما % % أن ابن حجر شاعر العرب % 3(@)(@@) % يا قائد الظرفاء لا كذبا % يا قدوة الأدباء في الأدب % % 4(@)(@@) % أدرك ثقاتك إنهم وقعوا % % في نرجس معه ابنة العنب % 5(@)(@@) % فهم بحال لو بصرت بها % % سبحت من عجب ومن عجب % 6(@)(@@) % ريحانهم ذهب على درر % % وشرابهم در على ذهب % % 7(@)(@@) % كأس إذا ما الماء واقعها % % صاغ الحلى منها بلا تعب % % 8(@)(@@) % في روضة شتوية رضعت % % درر الحيا حلبا على حلب % 9(@)(@@) % من زهرة قد حفها شجر % % للطير فيها أيما لجب % % 10(@)(@@) % تتنفس الأنوار فيه لها % % فيهيج منها أيما طرب % % PageV01P342 11(@)(@@) % فتظل فيه بخير مصطحب % % وكأنها في شر مصطخب % % 12(@)(@@) % والعود يصخب كي تجاوبه % % موموقة معشوقة الصخب % % 13(@)(@@) % واليوم مدجون فحرته % % فيه بمطلع ومحتجب % % 14(@)(@@) % شمس تساترنا وقد بعثت % % ضوءا يلاحظنا بلا لهب % % 15(@)(@@) % يا نرجس الدنيا أقم أبدا % للاقتراح ودائم النخب % 16(@)(@@) % ذهب 
ms85	 العيون إذا مثلت لنا % % در الجفون زبرجد القضب % 17(@)(@@) % لا زلت شفع الراح إنكما % % سكن القلوب ومنتهى الطلب % 18(@)(@@) % وأرى السماع مثلثا لكما % % كابن لأم حرة وأب % PageV01P343 البحر : - 1(@)(@@) % إذا لم يكن درهمي درهمي % % ن عندك لم يزك عند الغريب % % 2(@)(@@) % فزدني فوق الذي أستحق % ق ما تستحق بحق الأديب % 3(@)(@@) % وحق الأريب وحق اللبيب % % وحق الحسيب وحق النجيب % 4(@)(@@) % وإلا فلا فرق فيما لدي % ك بين البغيض وبين الحبيب % PageV01P344 البحر : - 1(@)(@@) % دعتني إلى فضل معروفكم % وجوه مناظرها معجبه % 2(@)(@@) % فأخلفتم ما توسمته % % وقل حميد على تجربه % 3(@)(@@) % وكم لمعة خلتها روضة % فألفيتها دمنة معشبه % 4(@)(@@) % ظلمتكم لا تطيب الفرو % % ع إلا وأعراقها طيبه % % 5(@)(@@) % وكنت حسبت فلما حسب % % ت عفى الحساب على المحسبه % % 6(@)(@@) % فهل تعذرون كعذركم % بأن أصولكم المذنبه % 7(@)(@@) % خرجت موازنكم بالسوا % % ء عذرا بعذر فلا معتبه % PageV01P345 البحر : - 1(@)(@@) % نفسي الفداء لمن حبتني كفه % تفاحتين حكاهما في الطيب % 2(@)(@@) % فحلفت أني ما كحلت نواظري % % بمشاكل لهما ولا بضريب % 3(@)(@@) % فتوردت وتعصفرت وجناته % إذ قلت ذاك فأسرعت تكذيبي % % PageV01P346 البحر : - 1(@)(@@) % أعلم الناس بالنجوم بنو نو % % بخت علما لم يأتهم بالحساب % 2(@)(@@) % بل بأن شاهدوا السماء سموا % برقي في المكرمات الصعاب % 3(@)(@@) % ساوروها بكل علياء حتى % % بلغوها مفتوحة الأبواب % 4(@)(@@) % قد سمعنا مديحك الحسن الغض % ض ولكن لم نضطلع بالجواب % 4(@)(@@) % نظم شعر به ينظم شمل ال % مجد كالعقد فوق صدر الكعاب % 4(@)(@@) % هكذا يجتني الودود من الإخ % % وان أهل الأذهان والآداب % % 4(@)(@@) % مبلغ لم يكن ليبلغه الطا % % لب إلا بتلكم الأسباب % PageV01P347 البحر : - 1(@)(@@) % إذا ما مدحت المرء يوما ولم يثب % مديحي وحق الشعر في الحكم واجب % 2(@)(@@) % كفاني هجائيه قيامي بمدحه % % خطيبا وقول الناس لي أنت كاذب % PageV01P348 البحر : - 1(@)(@@) % وما الحسب الموروث لا در دره % % بمحتسب إلا بآخر مكتسب % 2(@)(@@) % إذا العود لم يثمر وإن كان شعبة % من المثمرات اعتده الناس في الحطب % 3(@)(@@) % وأنت لعمري شعبة من ذوي العلا % % فلا ترض أن تعتد من أوضع الشعب % 4 
ms86	(@)(@@) % وللمجد قوم ساوروه بأنفس % كرام ولم يرضوا بأم ولا بأب % 5(@)(@@) % رأيتك قد عولت بي في مدائحي % % على نائل الآباء في سالف الحقب % 6(@)(@@) % وذلك شيء كان غيري ناله % ولو كنت أيضا نلته كان قد ذهب % 7(@)(@@) % أتجعل نيلا ناله ابن محلم % ثواب مديحي فيك هذا هو العجب % 8(@)(@@) % فما رفد عبد الله والقرم طاهر % سواي بقاض عنك حقي الذي وجب % 9(@)(@@) % فلا تتكل إلا على مافعلته % ولا تحسبن المجد يورث بالنسب % 10(@)(@@) % فليس يسود المرء إلا بنفسه % % وإن عد آباء كراما ذوي حسب % PageV01P349 البحر : - 1(@)(@@) % إذا غمر المال البخيل وجدته % يزيد به يبسا وإن ظن يرطب % 2(@)(@@) % إذا كان مجرى كوكب سمت هامة % علاها وإلا اعتاص ذلك مطلبا % % 2(@)(@@) % أرى الحظ يأتي صاحب الحظ وداعا % ويعيي سواه ساعيا فيه متعبا % % 2(@)(@@) % وليس عجيبا ذاك منه فإنه % إذا غمر الماء الحجارة تصلب % PageV01P350 البحر : - 1(@)(@@) % لا تحسبن عرامي إن منيت به % % إحدى المواعظ أو بعض التجاريب % 2(@)(@@) % بل البوار الذي ما بعد موقعه % نفع بوعظ ولا نفع بتجريب % 3(@)(@@) % ما بعد وعظي ما توعى العظات له % % ولا مواقع صولاتي بتدريب % PageV01P351 البحر : - 1(@)(@@) % بيوم بدر أعز الدين ناصره % وبابن بدر أعز الظرف والأدبا % % 2(@)(@@) % يممت بدر بني بدر فما انتسبت % % ألفاظه لي لكن وجهه انتسبا % % 3(@)(@@) % لا قيته وأنا المملوء من غضب % % على الزمان فتسرى عني الغضبا % % 4(@)(@@) % فلو حلفت لما كذبت حينئذ % أني هناك لقيت العجم والعربا % % 5(@)(@@) % أجدى فأحسن في الجدوى وأتبعني % % حمدا وأردفني شكرا ولا عجبا % % 6(@)(@@) % الله يكلؤه والله يؤنسه % فإنه بمعاليه قد اغتربا % % PageV01P352 البحر : - 1(@)(@@) % أبا جعفر لا زلت معطى وواهبا % % ومكسب أموال رغاب وكاسبا % % 2(@)(@@) % طلبت كساء منك إذ أنت عامل % على قرية النعمان تعطى الرغائبا % % 3(@)(@@) % فأوسعتني منعا إخالك نادما % عليه وفي تمحيصه الآن راغبا % % 4(@)(@@) % فإن حق ظني فاستقلني بمترص % يقيني إذا ما القر أبدى المخالبا % % 5(@)(@@) % وإن كان ظني كاذبا فهي هفوة % وما خلت ظني فيئة الحر كاذبا % % 6(@)(@@) % وما كان من آباؤك 
ms87	 الخير أصله % ولبك مجناه ليمنع واجبا % % 7(@)(@@) % فعجل كسائي طيبا نحو شاكر % سيجنيك من حر الثناء الأطايبا % % 8(@)(@@) % وسلم من التخسيس والمطل بغيتي % % تكن تائبا لم يضح راجيه تائبا % % 9(@)(@@) % أجب راغبا لبى رجاءك إذ دعا % % إليك وعاصى فيك تلك التجاربا % % 10(@)(@@) % ولا ترجعن الشعر أخيب خائب % فما حق من رجاك رجعاه خائبا % % PageV01P353 11(@)(@@) % ويا سوأتا إن أنت سودت وجهه % فأصبح معتوبا عليه وعاتبا % % 12(@)(@@) % يذمك مظلوما وتلحاه ظالما % هناك فيستعدي عليه الأقاربا % % 13(@)(@@) % فإن احتمال الحر غرما يطيقه % % لأهون من تحويل سلم محاربا % % 14(@)(@@) % عجائب هذا الدهر عندي كثيرة % فيابن علي لا تزدني عجائبا % % 15(@)(@@) % وإن اعتذارا منك تلقاء حاجتي % % لأعجب من أن يصبح البحر ناضبا % % 16(@)(@@) % ودعني من ذكر الكساء فإنه % % حقير ودع عنك المعاذير جانبا % % 17(@)(@@) % نصيبي لا يذهب عليك مكانه % فتلقى غدا نصبا من اللوم ناصبا % % 18(@)(@@) % رزئنا جسيما من لقائك شاهدا % فعوض جسيما من حبائك غائبا % 19(@)(@@) % رأيت مواعيد الرجال مواهبا % وما حسن أن تسترد المواهبا % % 20(@)(@@) % رجاء وأى عنك الرجاء فلا يكن % % رخاء من الأرواح تقرو السباسبا % % PageV01P354 21(@)(@@) % علينا بنعماكم من الله أنعم % فلا تجعلوها بالجفاء مصائبا % % 22(@)(@@) % ولاتك ألهوبا من البرق خلبا % فما زلت شؤبوبا من الودق صائبا % % PageV01P355 البحر : - 1(@)(@@) % أبلغ أبا سهل فتى العجم الذي % % أضحت تمنى كونه منها العرب % 2(@)(@@) % يا من غدا وعزيمه ولسانه % سيفان شتى في الخطوب وفي الخطب % 3(@)(@@) % الحمد لله الذي من فضله % أنا رزقنا فيك حسن المنقلب % 4(@)(@@) % والحمد لله الذي صرف الردى % % والحمد لله الذي كشف الكرب % 5(@)(@@) % كنا نكلفك المواهب مرة % حتى إذا استنقذت من كف العطب % 6(@)(@@) % عظمت بك النعمى فقد ألهيتنا % % عن كل شيء كان فيه لنا أرب % 7(@)(@@) % فدع المواهب أنت موهبة لنا % % من ذي المعارج والمواهب لا تهب % 8(@)(@@) % إنا لنستحيي وقد وافيتنا % % من بعد يأس أن نكدك بالطلب % 9(@)(@@) % من ذا يراك وقد سلمت فلا يرى % % فيك الغنى لا في اللجين ولا الذهب % 10(@)(@@) % لا نبتغي شيئا سواك وإنما 
ms88	 % % طلب امرىء ما بعد حاجته كلب % PageV01P356 البحر : - 1(@)(@@) % إن أبا حفص وعثنونه % كلاهما أصبح لي ناصبا % % 2(@)(@@) % قد أغريا بي يهجواني معا % وحدي وكان الأكثر الغالبا % % 3(@)(@@) % أقسمت ما استنجد عثنونه % حتى غدا لي خائفا هائبا % % 4(@)(@@) % إن كان كفؤا لي في زعمه % % فليعتزل لحيته جانبا % % PageV01P357 البحر : - 1(@)(@@) % رأيت الذي يسعى ليدرك حظه % كسار بليل كي يسامت كوكبا % % 2(@)(@@) % يسير فلا يستطيع ذاك بسيره % % وكيف وأنى رام شأوا مغربا % % 3(@)(@@) % ولم لم يسر وافاه لا شك طلبه % % بغير عناء بادئا ثم عقبا % % 4(@)(@@) % أرى الحظ يأتي صاحب الحظ وادعا % ويعيي سواه ساعيا فيه متعبا % % 5(@)(@@) % إذا كان مجرى كوكب سمت هامة % علاها وإلا اعتاص ذلك مطلبا % % PageV01P358 البحر : - 1(@)(@@) % عجبت لقوم يقبلون مدائحي % % ويأبون تثويبي وفي ذاك معجب % 2(@)(@@) % أشعري سفساف فلم يجتبونه % وإن لا تكن هاتي فلم لا أثوب % 3(@)(@@) % حلفت بمن لو شاء سد مفاقري % % بما لي فيه عن ذوي اللؤم مرغب % 4(@)(@@) % فما آفتي شعر إليهم مبغض % ولكنه منع إليهم محبب % 5(@)(@@) % وأعجب منهم معشر ليس فيهم % بشعري ولا شيء من الشعر معجب % 6(@)(@@) % براذين ألهاها قديما شعيرها % % عن الشعر تستوفي القضيم وتركب % 7(@)(@@) % من اللائي لا تنفك تجري سواكنا % بفرسانها تلقاء نار تلهب % 8(@)(@@) % تقوم بفرسان تحرك تحتها % % أفانين فالركبان لا الظهر تتعب % 9(@)(@@) % فوارس غارات مطاعين بالقنا % % قنا لا يرى فيهن رمح مكعب % 10(@)(@@) % وليست بأيديهم تهز رماحهم % % ولكن بأحقيهم تهز فتوعب % PageV01P359 11(@)(@@) % ولا رمح منها بالنجيع مخضب % هناك ولكن بالرجيع مخضب % 12(@)(@@) % ولست ترى قرنا لهم يطعنونه % بل المركب المعلو قرن ومركب % % 13(@)(@@) % ترى كل عبد منهم فوق ربه % % ونيزكه الشبري فيه مغيب % 14(@)(@@) % وأعجب منهم جاهلون تعاقلوا % % وكلهم عما يتمم أنكب % 15(@)(@@) % أغثاء ما فيهم أديب علمته % % ولا قابل التأديب حين يؤدب % 16(@)(@@) % خلا أن آدابا أعيروا حليها % % فأضحت بهم يبكى عليها وتندب % 17(@)(@@) % وكم من معار زينة وكأنه % % إذا ما تحلى حليها يتسلب % 18(@)(@@) % بحقهم أن باعدوني وقربوا % % سواي وتقريب المباعد أوجب % 19 
ms89	(@)(@@) % رأى القوم لي فضلا يعاديه نقصهم % فمالوا إلى ذي النقص والشكل أقرب % 20(@)(@@) % خفافيش أعشاها نهار بضوئه % % ولاءمها قطع من الليل غيهب % PageV01P360 21(@)(@@) % بهائم لا تصغي إلى شدو معبد % وأما على جافي الحداء فتطرب % PageV01P361 البحر : - 1(@)(@@) % إذا خاب داع أو تناهى دعاؤه % % فإني داع والإله مجيب % 2(@)(@@) % دعاء امرىء أحييت بالعرف نفسه % وذاك دعاء لا يكاد يخيب % 3(@)(@@) % أدام لك الله المكارم والعلا % % فإنهما شيء إليك حبيب % 4(@)(@@) % وأبقاك للمداح يهدون مدحهم % % إليك على علاتهم وتثيب % 5(@)(@@) % تكشف ذاك الشكو عنك وصرحت % محاسن وجه بردهن قشيب % 6(@)(@@) % كما انكشفت عن بدر ليل غمامة % أظلت وولت والمراد خصيب % 7(@)(@@) % أغاثت ولم تصعق وإن هي أرعدت % % فمات بها جدب وعاش جديب % 8(@)(@@) % شكاة أجدت منك ذكرى وأنشأت % % سحائب معروف لهن صبيب % 9(@)(@@) % وأعقبها برء جديد كأنه % % شباب رديد شق عنه مشيب % 10(@)(@@) % وبالسبك راقت نقرة وسبيكة % وبالصقل راع المنتضين قضيب % PageV01P362 11(@)(@@) % ففي كل دار فرحة بعد ترحة % وفي كل ناد شاعر وخطيب % 12(@)(@@) % يقولون بالفضل الذي أنت أهله % وكلهم فيما يقول مصيب % 13(@)(@@) % ولو صين حي عن شكاة لكنته % ولكن لكل في الشكاة نصيب % 14(@)(@@) % وفي الصبر للشكو الممحص محمل % وفي الله والعرف الجسيم طبيب % 15(@)(@@) % وأنت القريب الغوث من كل بائس % دعاك فغوث الله منك قريب % 16(@)(@@) % أبى الله إخلاء المكان يسده % فتى ما له في العالمين ضريب % 17(@)(@@) % أعاذك أنس المجد من كل وحشة % فإنك في هذا الأنام غريب % 18(@)(@@) % وتاب إليك الدهر من كل سيء % وجاءك يسترضيك وهو منيب % 19(@)(@@) % ولا زال للأعداء في كل حالة % وللمال يوم من يديك عصيب % PageV01P363 البحر : - 1(@)(@@) % لا تهولنك شمس كسفت % دون أن تطلع من مغربها % % 2(@)(@@) % هان ذاك الرزء فيها مثلما % % هان ما غرك من مطلبها % % 3(@)(@@) % هي نار وافقت مطفئها % % لست بالآيس من ملهبها % % 4(@)(@@) % فابك من تشفق من معطبه % فلقد أومنت من معطبها % % 5(@)(@@) % ضل باك إن أبيخت جمرة % سوف تذكيها يدا مثقبها % % 6(@)(@@) % ليس للشمس إذا ما كسفت % غير 
ms90	 شمس تخلف الشمس بها % % 7(@)(@@) % طلة الصوت إذا ما غردت % % ركبت بدعة في موكبها % % 8(@)(@@) % من بنات الروم لا يكذبنا % % لونها المشرق عن منصبها % % 9(@)(@@) % قامة الغصن إذا ما اعتدلت % % قامة الغصن إلى منكبها % % 10(@)(@@) % شهد الشاهد من أحسنها % % فحكى الغائب من أطيبها % % PageV01P364 11(@)(@@) % نشفع الحسن بإحسان لها % % تجلب الأفراح من مجلبها % % 12(@)(@@) % فهي حسب العين من نزهتها % % وهي حسب الأذن من مطربها % % 13(@)(@@) % تشرع الألحاظ في وجنتها % % فتلاقي الري في مشربها % % 14(@)(@@) % وجنة للغنج فيها عقرب % وبلاء الصب من عقربها % % 15(@)(@@) % وإذا قامت إلى ملعبها % % كمهاة الرمل في ربربها % % 16(@)(@@) % سألت أردافها أعطافها % % هل رأت أوطأ من مركبها % % PageV01P365 البحر : - 1(@)(@@) % كساء بني نوبخت مهلا فإنني % % أراك تناغي طيلسان بني حرب % 2(@)(@@) % أعيذك أن تأبى مسيرة ليلة % وتصبر للتسيير في الشرق والغرب % 3(@)(@@) % كسائي كسائي إنه الدرب بيننا % % فلا تدع الثغر المخوف بلا درب % 4(@)(@@) % ولا تحسبني لا أغرد بالتي % % تليني بها في الحفل طورا وفي الشرب % 5(@)(@@) % فاعف بحقي في الشتاء فلن أرى % % قبول كساء منك في الصيف ذي الكرب % 6(@)(@@) % وصبرا فإن الحر باللوم تبتغى % % إثابته والعبد بالشتم والضرب % % PageV01P366 البحر : - 1(@)(@@) % سأقصر عن خالد منطقي % % وعن أمه حافظا منصبي % % 2(@)(@@) % لأن إحاطتها بالأيور % % توهمنيه من أبي % % PageV01P367 البحر : - 1(@)(@@) % وتسليني الأيام لا أن لوعتي وتسليني الأيام لا أن لوعتي % % ولا حزني كالشيء ينسى فيعزب % 2(@)(@@) % ولكن كفاني مسليا ومعزيا % بأن المدى بيني وبينك يقرب % PageV01P368 البحر : - 1(@)(@@) % ليس عن شركم ولا عن أذاكم % مستماز ولا ذرى للجنوب % 2(@)(@@) % قل من خيركم نصيبي ولكن % أنا من شركم كثير النصيب % 3(@)(@@) % إن تباعدت نالني من بعيد % أو تقربت نالني من قريب % PageV01P369 البحر : - 1(@)(@@) % هي سوداء غير أن عليها % % ظلمة تدلهم منها القلوب % 2(@)(@@) % فتراها كأنها حين نبدو % % عظلم فوق صدرها مصبوب % PageV01P370 البحر : - 1(@)(@@) % أكلت رغيفا عند عيسى فملني % % وكان كهمي من محب مقرب % 2(@)(@@) % رآني قليل الخوف من لحظاته % % وذلك من شأني له غير معجب % % 3(@)(@@) % يريد أكيلا رزؤه من طعامه % % كرزء 
ms91	 كتاب من تراب مقرب % 4(@)(@@) % إذا لحظته عينه عند مضغه % % طوى الأنس طي الخائف المترقب % 5(@)(@@) % يحب الخميص البطن من أكلائه % % ويضحي ويمسي بطنه بطن مقرب % % 6(@)(@@) % وما أنس ذي أنس لعيسى بمؤنس % ولا وقع أضراس الأكيل بمطرب % % 7(@)(@@) % تزود إذا آكلته فهي أكلة % وما أختها إلا كنعقاء مغرب % PageV01P371 البحر : - 1(@)(@@) % أنى هجوت بني ثوابه % يا صاحب العين المصابه % 2(@)(@@) % أهل السماحة والرجا % % حة والأصالة واللبابه % 3(@)(@@) % القائلين الفاعلي % % ن أولي الرياسة والنقابه % 4(@)(@@) % والفارعين المجد وال % % بانين فوقهم قبابه % 5(@)(@@) % الآخذين بأنفه % لا كالأولى علقوا ذنابه % 6(@)(@@) % نجب تلوح إذا بدوا % % بوجوهم غرر النجابه % 7(@)(@@) % لم يبق طود للعلا % % لا يرتقي أحد هضابه % 8(@)(@@) % إلا كأن الله ذل % لل عامدا لهم صعابه % 9(@)(@@) % وإذا استعار الحمد يو % % ما معشر ملكوا رقابه % 10(@)(@@) % يا رب رأي فيهم % لا تبلغ الآراء قابه % PageV01P372 11(@)(@@) % وندى إذا فقد الندى % % يتتبع العافي مصابه % 12(@)(@@) % قوم إذا صدع تفا % % قم مرة كانوا رئابه % 13(@)(@@) % وإذا شتاء أخلفت % أنواؤه خلفوا سحابه % 14(@)(@@) % جعلت بيوتهم مع ال % % بيت العتيق لنا مثابه % 15(@)(@@) % ننتاب فيها نائلا % جزلا متى شئنا انتيابه % 16(@)(@@) % ويلوذ لائذنا بها % % إن حبلنا اضطراب اضطرابه % 17(@)(@@) % لم يدعهم مستنجد % إلا ودعوته المجابه % 18(@)(@@) % كم عائذ من دهره % بهم إذا ما الدهر رابه % 19(@)(@@) % خذ في النوائب منهم % حبلا ولا تخف انقضابه % 20(@)(@@) % أمثالهم فاعمم بمد % % حك عمهم حسن الصحابه % PageV01P373 21(@)(@@) % وأخصص أبا العباس بح % % ر الجود حقا لا سرابه % 22(@)(@@) % ملك يظل إذا غدا % % تتعاور الأيدي ركابه % 23(@)(@@) % سائل بسؤدده المعا % % شر بل نداه وانسكابه % 24(@)(@@) % يخبرك عنه باليقي % % ن ويجعل الجدوى جوابه % 25(@)(@@) % غيث إذا استمطرته % ألفيت من ذهب ذهابه % 26(@)(@@) % قعد العفاة وسيبه % يختب نحوهم اختبابه % 27(@)(@@) % أغنتهم نفحاته % حتى لقد هجروا جنابه % 28(@)(@@) % لكن وفود الشكر لا % % تنفك قد شحنت رحابه % 29(@)(@@) % ولما ابتغى من شاكر % شكر النوال ولا استثابه % 30(@)(@@) % أعطى الذي لو سيم حا % % تم أخذه يوما لهابه % PageV01P374 31(@)(@@) % فأباحه 
ms92	 حمد الورى % % مال أباحهم انتهابه % 32(@)(@@) % كم راية للمجد فا % % ز بها وأخطأها عرابه % 33(@)(@@) % ويجيل في الخطب الذي % % تضحي شواكله تشابه % 34(@)(@@) % رأيا إذا الخطأ المخي % % ل أطالت الفرق اعتقابه % 35(@)(@@) % لم يحتجب عنه الصوا % % ب وأين عنه ترى احتجابه % 36(@)(@@) % لا رأي في مجهولة % يجتاب ظلمتها اجتيابه % 37(@)(@@) % تجلو به سدف العما % % ية عنك أو ترضى انجيابه % 38(@)(@@) % أجلى البصيرة لا تقح % حمه تخاف ولا ارتيابه % 39(@)(@@) % ماضي القضاء إذا ارتأى % % لم يستطع شك جذابه % 40(@)(@@) % ما عاب ذو طعم ريا % % ضته الأمور ولا اقتضابه % % PageV01P375 41(@)(@@) % وبكيده يروي القنا % % علقا ويختضب اختضابه % 42(@)(@@) % وتصيد لحمتها عقا % % ب الموت يوم ترى عقابه % 43(@)(@@) % فضل الرجال ذوي الكما % % ل كما اعتلى جبل ظرابه % 44(@)(@@) % أقسمت بالملك الذي % % لم يستطع ملك غلابه % 45(@)(@@) % لقد استدر له المدي % % ح وما تكلفت احتلابه % 46(@)(@@) % ولقد حلفت بما حلف % % ت به وما أبغي خلابه % 47(@)(@@) % يا بعده مما افتري % % ت من الفواحش واغترابه % 48(@)(@@) % خنثت أرجل من مشى % % ونسيت خنثك يا ترابه % 49(@)(@@) % لو أن عرسك بايتت % % ه لما دعته إذا لبابه % 50(@)(@@) % مع أنه لم يجتنب % رجل حمى الدين اجتنابه % PageV01P376 51(@)(@@) % وهل اتقى كتقائه % % أحد أو ارتقب ارتقابه % 52(@)(@@) % ما ضره أهجوته % يا وغد أم طنت ذبابه % 53(@)(@@) % أنشأت تهجوه فأك % ثرت الكلام بلا إطابه % 54(@)(@@) % وأحلت في بيت وما % % زلت البعيد من الإصابه % 55(@)(@@) % أنى يكون ممددا % رجل وقد رفعوا كعابه % 56(@)(@@) % لكنه بيت عرا % % ك لذكر معناه صبابه % 57(@)(@@) % فعميت عن سنن الطري % % ق وظلت تركب كل لابه % 58(@)(@@) % كم صرعة بين العبي % % د وخلوة لك مسترابه % % 59(@)(@@) % أصبحت تنحلها الكرا % % م بوجنة فيها صلابه % 60(@)(@@) % وكذاك مثلك ينحل السا % % دات عرته وعابه % PageV01P377 61(@)(@@) % قد قلت إذ خبرت عن % % ك بما أشبت من الأشابه % 62(@)(@@) % هلا نهاه عن الكرا % % م وقيله فيهم كذابه % 63(@)(@@) % عور وإعورار به % % لا تضبط الأيدي حسابه % 64(@)(@@) % منه بلاء باسته % ليست عليه بالمثابه % 65(@)(@@) % كلب عوى 
ms93	 مستقتلا % والحين يستعوي كلابه % 66(@)(@@) % فهدى إليه عواؤه % % لما عوى رئبال غابه % 67(@)(@@) % ألقى كلاكله علي % % ه وعل من دمه حرابه % 68(@)(@@) % فاظنن بكلب شام في % % ه الليث مخلبه ونابه % 69(@)(@@) % أنى يسب بني ثوا % % بة أو عبيد بني ثوابه % 70(@)(@@) % من كل شيء يستتا % % ب وما استه بالمستتابه % PageV01P378 71(@)(@@) % كم إخوة وارت له % % سوءاتهم تلك الغرابه % 72(@)(@@) % لإخاله يوم القيا % % مة باسته يؤتى كتابه % 73(@)(@@) % إذ لا يرى ذنب له % % إلا بها ولي اكتسابه % 74(@)(@@) % بل كل عضو منه يو % % جد مذنبا حاشا عنابه % 75(@)(@@) % ولو استطاع لصاغه % % دبرا ولالتمس انقلابه % 76(@)(@@) % ليكون بابا للفيا % % شل عجل الله اجتبابه % 77(@)(@@) % يا من لحاه على الفوا % % حش يرتجى يوما متابه % 78(@)(@@) % خل الشقي وحية % تنساب فيه وانسيابه % 79(@)(@@) % أنى يلاقي القارظ ال % % عنزي من يرجو إيابه % 80(@)(@@) % ماذا نقمت على امرىء % يؤوي إلى حجر حبابه % PageV01P379 81(@)(@@) % وله نعاج لا يزا % % ل مخليا فيها ذئابه % 82(@)(@@) % لا بل نساء يزدبب % ن أيور ناكته ازدبابه % 83(@)(@@) % هن المآب لكل من % % أمسى ولم يعرف مآبه % 84(@)(@@) % ناهيك من ثقة سها % % م القوم مودعة جعابه % 85(@)(@@) % لم يعتصب ذو حرمة % بعصائب العار اعتصابه % 86(@)(@@) % كلا ولا احتقب المآ % % ثم في إباحتها احتقابه % 87(@)(@@) % ومعنف لي أن هجو % تك يا أقل من الصؤابه % 88(@)(@@) % قال اطو عرضك لا تدن % نسه وأودعه عيابه % 89(@)(@@) % ما كفء عرضك عرض مع % % رور فلا تحكك نقابه % 90(@)(@@) % فأجبته إذ قال ذا % % ك بخطبة فصلت خطابه % % PageV01P380 91(@)(@@) % لو سب غير بني ثوا % % بة ما جشمت لهم سبابه % 92(@)(@@) % ولما رضيت لمنطقي % % فرع اللئيم ولا نصابه % 93(@)(@@) % لكنني أحميهم % ما حالفت بحري صبابه % 94(@)(@@) % وأرى يسيرا فيهم % تدنيس عرضي أو ذهابه % 95(@)(@@) % إن المكاره في حما % % يتهم عذاب مستطابه % 96(@)(@@) % واليتهم ما حالفت % أوعال شابة هضب شابه % 97(@)(@@) % وإذا امرؤ عاداهم % % أصفرت من ودي وطابه % 98(@)(@@) % ومتى امترى خلف الوصا % % ل ملأت من هجر علابه % 99(@)(@@) % إذ لا أبالي فيهم % حسك 
ms94	 العدو ولا ضبابه % 100(@)(@@) % من كان مكتئبا لذا % % ك فقد توخيت اكتئابه % PageV01P381 101(@)(@@) % لا زال يقدح وريه % في صدره أبدا قحابه % 102(@)(@@) % قلبي حمى لهم فلم % يحتل غيرهم شعابه % 103(@)(@@) % لم لا وذكراهم له % % روح إذا ما الهم نابه % 104(@)(@@) % ومتى تباعد مطلب % فبيمنهم نرجو اقترابه % 105(@)(@@) % وتحريا لرضاهم اس % تنفرت من شعري غضابه % 106(@)(@@) % وسللت دونهم علي % % ك ودون حورتهم عضابه % 107(@)(@@) % سامت قوافيك السما % % ء ورمت أمرا ذا مهابه % 108(@)(@@) % فاربع عليك فمن رمى % % صعدا بجندله أصابه % % 109(@)(@@) % أقذر وأخبث بالمنى % % إذا عبيط السلح شابه % 109(@)(@@) % هتما لفيك فما تخي % ير ما يشوب به لعابه % PageV01P382 109(@)(@@) % لا سيما بفم به إذا % % أهدى حشاك لها خضابه % 109(@)(@@) % ما كان قدرك أن تفو % % ه بمدحهم بله المعابه % 109(@)(@@) % تمري الأيور به إذا % % أهدى حشاك لها خضابه % % 110(@)(@@) % وإخال ذلك لم يزد % % في خبثه لكن أطابه % % 111(@)(@@) % هلا مسخت وقد ذكر % % تهم بجد أو دعابه % 112(@)(@@) % لكن مسخ المسخ مم % تنع ولا سيما الزبابه % 113(@)(@@) % أتظن أنك لو مسخ % % ت بلغت قبحك أو قرابه % 114(@)(@@) % ما يمسخ المسخ الذي % % لم يكس ما يخشى استلابه % 115(@)(@@) % كلا وما بين الفرا % % ق وبين وجهك من قرابه % 116(@)(@@) % ذكراهم بسل على % % من كان مثلك في الجنابه % PageV01P383 117(@)(@@) % لا بل على من مس ثو % % بك ثم لم يغسل ثيابه % 118(@)(@@) % لا بل على من خاض ظل % لك ثم لم يسلخ إهابه % 119(@)(@@) % لم تهجهم إلا لكي % % تهجى فتذكر في عصابه % 120(@)(@@) % طلب النباهة إذ رأي % % تك من خمولك في غيابه % 121(@)(@@) % جاه ترممه ودب % ر تبتغي أبدا خرابه % 122(@)(@@) % فإذا ظفرت بحادر % ذي كدنة ترضى وثابه % % 123(@)(@@) % لم تلف عبد الله بل % % ألفيت زيدا وانتصابه % 124(@)(@@) % ولما انتصبت معاملا % ضرب المواثب بل ضرابه % 125(@)(@@) % بعجارم يشفي الفقا % % ح إذا سغبن من السغابه % 125(@)(@@) % وعلاك عبد الله ين % % ظمبين عجبك والذؤابه % PageV01P384 125(@)(@@) % ولربما كان انتصا % % ب المرء للفعل انكبابه % 125(@)(@@) % ذي ضل تفدية هنا % % لك تستديم 
ms95	 بها هبابه % 126(@)(@@) % يا ضل تفدية هنا % % لك تستديم بها هبابه % 127(@)(@@) % تبت يداك مفديا % ما تب من أحد تبابه % 128(@)(@@) % شيخ إذا حدث أها % % ن مشيبه فدى شبابه % % 129(@)(@@) % لهفي عليك مخنثا % وعلى لسانك ذي الذرابه % 130(@)(@@) % ماذا يخوض . . . في % % ك من الكتابة والخطابه % 131(@)(@@) % هلا شكرت بني ثوا % % يه ما حدا حاد ركابه % 132(@)(@@) % أن صادفوا من قد علم % ت وعبده يحشو جرابه % 133(@)(@@) % إذ لم يروا تقريعه % % يوما بذاك ولا اغتيابه % PageV01P385 134(@)(@@) % كرما فكان جزاؤهم % % منه أن انتدب انتدابه % 135(@)(@@) % يهجوهم بغيا ويل % % صق دائما بهم شغابه % 136(@)(@@) % وكذلك البغاء با % % غ إن تفهمت انتسابه % 137(@)(@@) % رجل يطالب غير ما % % جعل الإله له طلابه % 138(@)(@@) % سائل بذلك بخسه % حق الغواني واغتصابه % 139(@)(@@) % زحم الأيور على الفرو % % ج معا فسد بها نقابه % 140(@)(@@) % فاه الخبيث ومنخري % ه وفقحة منه رحابه % 141(@)(@@) % وحشا مسامعه بها % % فحمى معاتبه عتابه % 142(@)(@@) % ثم اغتدى متبرئا % من ذاك ينحله صحابه % 143(@)(@@) % أسدى إليك القوم مع % % روفا فلم تحسن ثوابه % PageV01P386 144(@)(@@) % ستروا عليك وقد رأوا % % نفس الفضيحة لا الإرابه % 145(@)(@@) % فجحدتهم جحدا جعل % % ت قبيح قرفكهم قطابه % 146(@)(@@) % وغدوت بهات الجبي % % ن وأنت لم تمسح ترابه % 147(@)(@@) % ترميهم بالإفك مط % طرحا سداهم واحتسابه % 148(@)(@@) % أصبح تبين من رمي % ت وتنحسر عنك الضبابه % 149(@)(@@) % ستذم ما اكتسبت يدا % % ك إذا لقيت غدا عقابه % 150(@)(@@) % وتقر أنك جاهل % لم تأت من أمر صوابه % 151(@)(@@) % من بات يحتطب الأفا % % عي ليله ذم احتطابه % 152(@)(@@) % ولرب مثلك قد أطل % ت على خطيئته انتحابه % 153(@)(@@) % وجعلت في نظم الهجا % % ء فياش ناكته سخابه % PageV01P387 154(@)(@@) % حتى غدا بعد المرا % % ح عليه سربال الكآبه % 155(@)(@@) % مترقبا من فوقه % يخشى عذابي وانصبابه % 156(@)(@@) % وأنا الذي قدح الهجا % % ء بزنده قدما شهابه % 157(@)(@@) % وأنا الذي من أرضه % يمتار حنظله وصابه % 158(@)(@@) % وإذا تمرد مارد الش % شعراء ولاني عذابه % 159(@)(@@) % أما إذا استفتحته % % فلأفتحن عليك بابه % 160(@)(@@) % ولأصلينك جاحم الش % % شعر الذي هجت التهابه 
ms96	 % 161(@)(@@) % قذع إذا سفع الحدي % % د سعير أيسره أذابه % 162(@)(@@) % خذها جواب مفوه % ما زال يفحم من أجابه % 163(@)(@@) % جم الصياب إذا امرؤ % كثرت خواطئه صيابه % PageV01P388 164(@)(@@) % يفري الفري بمقول % لو هزه للصخر جابه % 165(@)(@@) % يمتاح من بحر يهو % % ل العين حين ترى حدابه % 166(@)(@@) % ويصم من سمع التطا % % م الموج فيه واصطخابه % 167(@)(@@) % لا ماد رأيا بعدها % % لك إن صدمت بها عبابه % PageV01P389 البحر : - 1(@)(@@) % وغزال ترى على وجنتيه % قطر سهميه من دماء القلوب % 2(@)(@@) % لهف نفسي لتلك من وجنات % وردها ورد شارق مهضوب % 3(@)(@@) % أنهلت صبغ نفسها ثم علت % من دماء القتلى بغير ذنوب % 4(@)(@@) % بل أتى ما أتى إليهم من الأم % % ر بوتر لديهم مطلوب % 5(@)(@@) % جرحته العيون فاقتص منها % % بجوى في القلوب دامي الندوب % 6(@)(@@) % لم يعادله في كمال المعاني % % توأم الحسن من بني يعقوب % PageV01P390 البحر : - 1(@)(@@) % أيا فضل إنك فضل أصا % % ب شيخك من حيث لم يكتسب % 2(@)(@@) % ومن يتق الله يصنع له % % ويرزقه من حيث لم يحتسب % 3(@)(@@) % جزى الله شبان جيراننا % % جزاء الشفيق الحفي الحدب % 4(@)(@@) % يرقون للشيخ منا العقيم % فيأتون من بره ما يجب % PageV01P391 البحر : - 1(@)(@@) % لعمرك ما السيف سيف الكمي % بأخوف من قلم الكاتب % 2(@)(@@) % له شاهد إن تأملته % ظهرت على سره الغائب % 3(@)(@@) % أداة المنية في جانبيه % % فمن مثله رهبة الراهب % 4(@)(@@) % سنان المنية في جانب % وسيف المنية في جانب % 5(@)(@@) % ألم تر في صدره كالسنان % % وفي الردف كالمرهف القاضب % PageV01P392 البحر : - 1(@)(@@) % طربت ولم تطرب على حين مطرب % وكيف التصابي بابن ستين أشيب % 2(@)(@@) % ومما حداك الشوق نوح حمامة % % أرنت على خوط من البان أهدب % 3(@)(@@) % مطوقة تبكي ولم أر قبلها % % بدا ما بدا من شجوها لم تسلب % PageV01P393 البحر : - 1(@)(@@) % تظلم عمرو من هجائي وقد علت % بما قلت فيه حاله ومراتبه % 2(@)(@@) % وأغفل ظلميه بقصديه راغبا % فواعجبا والدهر جم عجائبه % 3(@)(@@) % ويا من جنى قصدي أبا الخطم إنه % % تمنع واعتاصت علي مطالبه % 4(@)(@@) % أعيذك من طعن الأعادي وقولهم % % جواد تقضت من 
ms97	 نداه مآربه % PageV01P394 البحر : - 1(@)(@@) % اكتهلت همتي فأصبحت لا أب % هج بالشيء كنت أبهج به % 2(@)(@@) % وحسب من عاش من خلوقته % خلوقة تعتريه في أربه % PageV01P395 البحر : - 1(@)(@@) % أبا حسن وأنت فتى أديب % له في كل مكرمة نصيب % 2(@)(@@) % أترضى أن تكون من المعالي % % بمدعى مستغاث لا يجيب % 3(@)(@@) % أسأت فهل تنيب إلي أم لا % % فها أنا ذو الإساءة والمنيب % 4(@)(@@) % ظننت بك الجميل فهل تلمني % % فإنك قد تصيب ولا أصيب % 5(@)(@@) % لقد ولدتك آباء كرام % من الآباء ليس لهم ضريب % 6(@)(@@) % فلا تخلفهم في أمر مثلي % % خلافة من أطيب وما يطيب % 7(@)(@@) % أحال المنجبون عليك أمري % % فلم يقبل حوالتهم نجيب % 8(@)(@@) % وقلت ورثت مجدهم فحسبي % % بإرثهم وذلك ما أعيب % 9(@)(@@) % ألا أن الحسيب لغير حي % غدا وعماده ميت حسيب % 10(@)(@@) % أترضى أن يقول لك المرجي % % لأنت المرء راجيه يخيب % PageV01P396 11(@)(@@) % رضيت إذا بما لا يرتضيه % من القوم الكريم ولا اللبيب % 12(@)(@@) % أتأمن أن تواقعك القوافي % % ويوم وقاعها يوم عصيب % 13(@)(@@) % أبن لي ما الذي تأوي إليه % % إذا ما القذع صدره النسيب % 14(@)(@@) % أمعتصم بأنك ذو صحاب % من الشعراء نصرهم قريب % 15(@)(@@) % وما تجدي عليك ليوث غاب % بنصرتها إذا دماك ذيب % 16(@)(@@) % توقي الداء خير من تصد % لأيسره وإن قرب الطبيب % 17(@)(@@) % أذلك أم تدل بعز قوم % % قد انقرضوا فما منهم عريب % 18(@)(@@) % ألا ناد البرامكة انصروني % % على الشعراء وانظر هل مجيب % 19(@)(@@) % وكيف يجيبك الشخص الموارى % % وكيف يعزك الخد التريب % 20(@)(@@) % ولو نشروا لما نصروا وقالوا % % أربت فكان حقك ما يريب % % PageV01P397 21(@)(@@) % أتدعونا إلى حرب القوافي % % لتحربنا السلامة يا حريب % 22(@)(@@) % ألم تر بذلنا المعروف قدما % مخافة أن يقوم بنا خطيب % 23(@)(@@) % أذلنا دون ذلك كل علق % وملتمس السلامة لا يخيب % 24(@)(@@) % عليك ببذل عرفك فاستجره % % كذلك يفعل الرجل الأريب % PageV01P398 البحر : - 1(@)(@@) % رأيت الأخلاء في دهرنا % % وأجدر بنائبة أن تنوبا % % 2(@)(@@) % إذا حشدوا لأخ مرة % أظلوه للمن عودا ركوبا % % 3(@)(@@) % سأستنصر الله حسبي به % نصيرا وإلا فحسبي حسيبا % % PageV01P399 البحر : - 1(@)(@@) % إذا 
ms98	 خلة خانتك بالغيب عهدها % % فلا تجعلن الحزن ضربة لازب % 2(@)(@@) % وهب أنها الدنيا التي المرء موقن % بفرقتها والمرء في شأن لاعب % PageV01P400 البحر : - 1(@)(@@) % طلعت شنطف صباحا فقلنا % % كيف أمسيت يا فساء الكرنب % 2(@)(@@) % أجابت بشر حال . فقلنا % % لم فقالت من شهوة الزرنبنب % 3(@)(@@) % فأشرنا به عليها فقالت % % أي أير يهش للطنبلنب % 4(@)(@@) % ليس ذنبي إلى الأيور سوى وج % رهي . فقلنا بخ . بخ أي ذنب % % PageV01P401 البحر : - 1(@)(@@) % يا لهف نفسي للأحبه % ورجائهم غوث الأطبه % 2(@)(@@) % لم يشفهم كد الطبي % % ب ولا عنايته المكبه % 3(@)(@@) % لم تقض حاجتهم ولا % % نفعتهم نفس محبه % 4(@)(@@) % ما زارهم فرح ولا % % كانت كروبهم مغبه % 5(@)(@@) % ترحا لدار إنما % % سكانها رفق مخبه % 6(@)(@@) % تقتادهم نحو الردى % % طرق إليه مستتبه % 7(@)(@@) % دار عزيب خيرها % % وترى الشرور بها مربه % 8(@)(@@) % أدوت وغاب دواؤها % % عن كل نفس مستطبه % 9(@)(@@) % وصفت محبة أهلها % % منها لمدغلة مضبه % 10(@)(@@) % ناموا على صيحاتها % % بهم الشداد المستهبه % PageV01P402 11(@)(@@) % كم غر قوما حلوها % % من مرها إلا الألبه % 12(@)(@@) % فتهافتوا في شهدها % % فتهالكوا مثل الأذبه % 13(@)(@@) % ما آنس الإنسان بالد % دنيا الدبوب له المدبه % 14(@)(@@) % تغدو عليه عدوة % ويعدها أما وحبه % 15(@)(@@) % يا لهف نفسي للأحب % بة لو شفى اللهف الأحبه % PageV01P403 البحر : - 1(@)(@@) % ولحية سائلة منصبه % شهباء تحكي ذنب المذبه % 2(@)(@@) % ألا فتى يرضي بذاك ربه % يضم كفيه على إرزبه % 3(@)(@@) % ثمة يعلو رأسه بضربه % % يشفي بها قلوبنا وقلبه % PageV01P404 البحر : - 1(@)(@@) % دريرة تجلب الطربا % % ونزهة تجلب الكربا % % 2(@)(@@) % تغني هذه فيظل % ل عنك الحزن قد عزبا % % 3(@)(@@) % وتعوي هذه فتطي % % ل منك الحزن والوصبا % % 4(@)(@@) % أقول لجامع لهما % % لقد أحضرتنا عجبا % % 5(@)(@@) % أتجمع بين مختلفي % ن ذا صعدا وذا صببا % % 6(@)(@@) % فقال ولم يزل لحنا % بحجته وقد كذبا % % 7(@)(@@) % دعونا هذه لنقل % ل من تموزنا اللهبا % % 8(@)(@@) % فلما أسرفت في البر % د لم نأمن به العطبا % % 9(@)(@@) % فجئنا بالتي هي ضد % دها لتلين ما صعبا % % 10(@)(@@) % وظني أنه رجل % يحاول عندها الريبا % % PageV01P405 11(@)(@@) % ولو كان الفتى عفا 
ms99	 % إذا ما استعمل الكذبا % % PageV01P406 البحر : - 1(@)(@@) % قد كنت تبذل لي كتابك مرة % فالآن فاكتب لي إليك كتابا % % 2(@)(@@) % فأنا الزعيم عليك يا ابن محمد % أن الثواب يكون منك جوابا % % 3(@)(@@) % لا تشغلني بالعتاب فإن لي % % شغلا بمدحك ينفذ الأحقابا % % 4(@)(@@) % قد أورق العود الذي أملته % وحلا جناه لمجتنيه وطابا % % PageV01P407 البحر : - 1(@)(@@) % نجاك يا ابن الحاجب الحاجب % وأين ينجو مني الهارب % 2(@)(@@) % أبعد إحرازك أيماننا % % هاربتنا واعتذر الحاجب % 3(@)(@@) % يا واقبا بالأمس في بيته % ما وقب المخراق يا واقب % 4(@)(@@) % يا عجبا إذ ذاك من حالة % دافعنا فيها هو الجاذب % 5(@)(@@) % حقا لقد أوليتنا جفوة % يمحل منها البلد العاشب % 6(@)(@@) % انظر بعين العدل تبصر بها % % أنك عن منهاجه ناكب % 7(@)(@@) % سالمت أضدادا فحاربتنا % % وذاك منك العجب العاجب % 8(@)(@@) % أحربنا حين أسغت الشجا % % وحزبنا إذ ضافك الحازب % 9(@)(@@) % هيبت لقوم شرة فاحتبوا % % ولم يهب شرتنا هائب % 10(@)(@@) % وانصاعت الدعوة تلقاءهم % % وصاب فيهم مزنها الصائب % PageV01P408 11(@)(@@) % لا بدع إن الحرب مرقوبة % والسلم لا يرقبه راقب % 12(@)(@@) % هذا على أنك ذو شيمة % يدرها الماسح لا العاصب % 13(@)(@@) % لا زلت من لا سيفه ناكل % قدما ومن لا بحره ناضب % 14(@)(@@) % يا حسرتا للسارقي يومنا % % ولم يصبهم مخلب خالب % 15(@)(@@) % ما غرهم منا ونحن الأولى % % لم ير في سلطانهم خارب % 16(@)(@@) % إن لم يقيدونا بها مثلها % % فالشعر حر إن نجوا سائب % 17(@)(@@) % بل ليت شعري عنك في أمسنا % % والظن عن غيب الفتى ثاقب % 18(@)(@@) % هل قلت أخطأتم رماياكم % لا يلتقي الشارق والغارب % 19(@)(@@) % لهفي وقد جاءتك جفالة % كل مغذ ساغب لاغب % 20(@)(@@) % ألا يلاقوك فتلقى بهم % % أكل يتامى ما لهم كاسب % PageV01P409 21(@)(@@) % من كل شحذان الحشا فهم % يأكل ما لا يحسب الحاسب % 22(@)(@@) % فكاه كالعصرين من دهره % % كلاهما في شأنه دائب % 23(@)(@@) % ذي معدة ثعلبها لاحس % % وتارة أرنبها ضاغب % % 24(@)(@@) % تعلوه حمى شره نافض % لكن حمى هضمه صالب % 25(@)(@@) % كأنما الفروج في كفه % فريسة ضرغامها دارب % 26(@)(@@) % وإن غدا الشبوط قرنا لهم % % فخد شبوطهم التارب % % 27 
ms100	(@)(@@) % أقسمت لو أنك لاقيتهم % % نابك من أضراسهم نائب % 28(@)(@@) % أبشر بكر عاجل إنني % % بالثأر في أمثالها طالب % 29(@)(@@) % لا تحسبني عنك في غفلة % عودي وشيك أيها الصاحب % 30(@)(@@) % قلت لصحبي حين راوغتهم % % لا تحزنوا قد يشهد الغائب % PageV01P410 31(@)(@@) % سيصنع الله لنا في غد % إن كان أكدى يومنا الخائب % 32(@)(@@) % كروا على الشيخ بتطفيلة % عن عزمة كوكبها ثاقب % 33(@)(@@) % وإن زواه عنكم جانب % فلا يفتكم ذلك الجانب % 34(@)(@@) % جوسوا عليه الأرض واستخبروا % % حتى يروح الخبر العازب % 35(@)(@@) % لا تنجون منكم فراريجه % لا وهب المنجي لها الواهب % 36(@)(@@) % لا تفلتن منكم شبابيطه % لا أفلت الطامي ولا الراسب % 37(@)(@@) % جدوا فقد جد بكم لاعبا % وقد يجد الرجل اللاعب % 38(@)(@@) % وليكن الكر على غرة % والصيد في مأمنه سارب % 39(@)(@@) % مقالة قمت بها خاطبا % وقد يصيب الغرة الخاطب % 40(@)(@@) % فاعتزم القوم على غارة % ساند فيها الراجل الراكب % PageV01P411 41(@)(@@) % يهدي أبو عثمان كرودوسها % % هداك ذاك الطاعن الضارب % 42(@)(@@) % يرقل والراية في كفه % % قد حفها الرامح والناشب % 43(@)(@@) % والقوم لاقوك فاعدد لهم % % ما يرتضي الآكل والشارب % 44(@)(@@) % يسر فراريجك مقرونة % بها شبابيطك ياكاتب % 45(@)(@@) % تلك التي مخبرها ناعم % تلك التي منظرها شاحب % 46(@)(@@) % واذكر بقلب غير مستوهل % يعروه من ذكر القرى ناخب % 47(@)(@@) % أنك من جيران قطربل % وعندك اللقحة والحالب % 48(@)(@@) % فاسق حليب الكرم شرابه % إذ ليس من شأنهم الرائب % 49(@)(@@) % أحضرهم البكر التي ما اصطلت % % نارا فكل خاطب راغب % 50(@)(@@) % ليس التي يخطبها المتقي % % بل التي يخطبها الشاذب % PageV01P412 51(@)(@@) % تلك التي ما بايتت راهبا % إلا جفا قنديله الراهب % 52(@)(@@) % تلك التي ليس لها مشبه % في الكأس إلا الذهب الذائب % 53(@)(@@) % أو أمها الكبرى التي لم يزل % % لليل من طلعتها جائب % 54(@)(@@) % حققها بالشمس أن ربيت % في حجرها والشبه الغالب % 55(@)(@@) % فهي ابنة الكرم وما إن يرى % % إلا التي الشمس لها ناسب % 56(@)(@@) % أعجب بتلك البكر محجوبة % مكروبة يجلى بها الكارب % 57(@)(@@) % مغلوبة في الدن مسلوبة % لها انتصار غالب سالب % 58(@)(@@) % بينا ترى في الزق مسحوبة % إذ 