ms2641	 الجنة ) )(@)(@@) ابن النجار عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 24683 قال النبي :(@)(@@) | 30 ( وضع الله عز وجل عن أمتي : الخطأ ، والنسيان ، وما استكرهوا عليه ) )(@)(@@) ( عد هق ) عن عقبة بن عامر رضي الله عنه .(@)(@@) PageV08P101(@)(@@)(@@)(@@) ||| ( الواو مع العين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24684 قال النبي :(@)(@@) | 30 ( وعدني ربي أن يدخل الجنة من أمتي سبعين ألفا بلا حساب عليهم ولا عذاب ، مع كل ألف سبعون ألفا ، وثلاث حثيات من حثيات ربي ) )(@)(@@) ( حم ت ه حب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24685 قال النبي :(@)(@@) | 30 ( وعدني ربي في أهل بيتي من أقر منهم بالتوحيد ولي بالبلاغ أن لا يعذبهم ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكم ال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24686 قال النبي :(@)(@@) | 30 ( وعدني ربي أن يدخل من أمتي الجنة سبعين ألفا بغير حساب ، هم الذين لا يسترقون ، ولا يتطيرون ، ولا يكتوون ، وعلى ربهم يتوكلون ، قلت : أي رب زدني ، قال : لك بكل واحد من السبعين سبعين ألفا ، قلت : أي رب ، إنهم لا يكلمون ، قال : إذا نكملهم لك من الأعراب ) )(@)(@@) ابن سعد عن عمرو بن عمير رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الواو مع الفاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24687 قال النبي :(@)(@@) | 30 ( وفد الله ثلاثة : الغازي ، والحاج ، والمعتمر ) )(@)(@@) ( ن قط ) في الأفراد ، ( ن حب ك حل هق ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV08P102(@)(@@)(@@)(@@) $ 24688 قال النبي :(@)(@@) | 30 ( وفروا اللحى ، وخذوا من الشوارب ، وانتفوا الإبط ، وقصوا الأظافير ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24689 قال النبي :(@)(@@) | 30 ( وفروا عثانينكم ، وقصوا سبالكم ) )(@)(@@) ( هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24690 قال النبي :(@)(@@) | 30 ( وفد الله ثلاثة : الحاج ، والمعتمر ، والغازي ، دعاهم الله فأجابوه ، وسألوه فأعطاهم ) )(@)(@@) ابن زنجويه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الواو مع القاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24691 قال النبي :(@)(@@) | 30 ( وقت العشاء إذا ملأ الليل بطن كل واد ) )(@)(@@) ( طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24692 قال النبي :(@)(@@) | 30 ( وقت صلاة الظهر إذا زالت الشمس ، وكان ظل الرجل كطوله ما 
ms2642	 لم يحضر العصر ، ووقت صلاة العصر ما لم تصفر الشمس ، ووقت صلاة المغرب ما لم يغب الشفق ، ووقت صلاة العشاء إلى نصف الليل الأوسط ، ووقت صلاة الصبح من طلوع الفجر ما لم تطلع الشمس فإذا طلعت الشمس فأمسك عن الصلاة فإنها تطلع بين قرني الشيطان ) )(@)(@@) ( حم م د ن ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24693 قال النبي :(@)(@@) | 30 ( وقروا من تعلمون منه العلم ، ووقروا من تعلمونه PageV08P103 العلم ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24694 قال النبي :(@)(@@) | 30 ( وقيت شركم ووقيتم شرها ) )(@)(@@) ( ق ن ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24695 قال النبي :(@)(@@) | 30 ( وقع في نفس موسى هل ينام الله ؟ فأرسل إليه ملكا فأرقه ثلاثا ، ثم أعطاه قارورتين في كل يد قارورة ، وأمره أن يحتفظ بهما ، فجعل ينام ويكاد يلتقيان ، ثم يستيقظ فيحبس إحداهما عن الأخرى حتى نام نومة فاصطفقت يداه ، فانكسرت القارورتان ، ضرب له مثلا أن الله لو كان ينام لم تستمسك السماوات والأرض ) )(@)(@@) عن عكرمة عن أبي هريرة رضي الله عنه وضعف ، ورواه عبد الرزاق في تفسيره عن عكرمة رضي الله عنه موقوفا عليه .(@)(@@)(@@)(@@) $ 24696 قال النبي :(@)(@@) | 30 ( وقفت على باب الجنة فرأيت أكثر من يدخلها الفقراء ، ورأيت أصحاب الجد محبوسين ، ووقفت على باب النار فإذا أكثر من يدخلها النساء ) )(@)(@@) ابن قانع عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24697 قال النبي :(@)(@@) | 30 ( وقيت شركم كما وقيتم شرها ) )(@)(@@) ( خ م ن ) عن ابن مسعود رضي الله عنه قال : بينا نحن مع رسول الله وثبت علينا حية فقال : اقتلوها ، فابتدرناها فذهبت قال فذكره .(@)(@@)(@@)(@@) ||| ( الواو مع الكاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24698 قال النبي :(@)(@@) | 30 ( وكاء السه العينان ، فمن نام فليتوضأ ) )(@)(@@) ( د ) عن علي رضي الله عنه ( ز ) .(@)(@@) PageV08P104(@)(@@)(@@)(@@) $ 24699 قال النبي :(@)(@@) | 30 ( وكل بالركن اليماني سبعون ملكا ، فمن قال : اللهم إني أسألك العفو والعافية في الدنيا والآخرة ، ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار . قال : آمين ، ومن 
ms2643	 فاوض الركن الأسود فإنما يفاوض يد الرحمان ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24700 قال النبي :(@)(@@) | 30 ( وكل بالشمس تسعة أملاك يرمونها بالثلج كل يوم ، ولولا ذالك ما أتت على شيء إلا أحرقته ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24701 قال النبي :(@)(@@) | 30 ( وكيف لا أسر وقد أتاني جبريل فبشرني أن حسنا وحسينا سيدا شباب أهل الجنة ، وأبوهما أفضل منهما ) )(@)(@@) ( طب ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24702 قال النبي :(@)(@@) | 30 ( وكيف لا أحبهما وهم ريحانتاي من الدنيا أشمهما يعني الحسن والحسين ) )(@)(@@) ( طب ض ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ 24703 قال النبي :(@)(@@) | 30 ( وكل بالمؤمن ستون وثلائمائة ملك يذبون عنه ما لم يقدر عليه ، من ذالك البصر تسعة أملاك يذبون عنه كما تذبون عن قصعة العسل من الذباب في اليوم الصائف ، وما لو بدا لكم لرأيتموه على كل جبل وسهل ، كلبهم باسط يده ، فاغر فاه ، وما لو وكل فيه إلى نفسه طرفة عين خطفته الشياطين ) )(@)(@@) ابن أبي الدنيا في مكائد الشيطان وابن قانع ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ 24704 قال النبي :(@)(@@) | 30 ( وكل بالنفوس شيطان يقال له ( اللهو ) فهو يخيل إليها ويتراءى أن ينتهي إذا عرج بها ، فإذا انتهت إلى السماء فمارت فهو الرؤيا التي تصدق ) )(@)(@@) الحكيم عن أبي سلمة بن عبد الرحمان مرسلا .(@)(@@) PageV08P105(@)(@@)(@@)(@@) ||| ( الواو مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24705 قال النبي :(@)(@@) | 30 ( ولد آدم كلهم تحت لوائي يوم القيامة ، وأنا أول من يفتح له باب الجنة ) )(@)(@@) ابن عساكر عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24706 قال النبي :(@)(@@) | 30 ( ولد الرجل من كسبه من أطيب كسبه ، فكلوا من أموالهم ) )(@)(@@) ( د ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24707 قال النبي :(@)(@@) | 30 ( ولد الزنا شر الثلاثة ) )(@)(@@) ( حم د ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24708 قال النبي :(@)(@@) | 30 ( ولد الزنا شر الثلاثة إذا عمل بعمل أبويه ) )(@)(@@) ( طب هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24709 قال النبي :(@)(@@) | 30 ( ولد الملاعنة 
ms2644	 عصبته عصبة أمه ) )(@)(@@) ( ك ) عن رجل .(@)(@@)(@@)(@@) $ 24710 قال النبي :(@)(@@) | 30 ( ولد لي الليلة غلام فسميته باسم أبي أبراهيم ) )(@)(@@) ( حم ق د ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24711 قال النبي :(@)(@@) | 30 ( ولد نوح ثلاثة : سام ، وحام ، ويافث ) )(@)(@@) ( حم ك ) عن سمرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24712 قال النبي :(@)(@@) | 30 ( ولد نوح ثلاثة : فسام أبو العرب ، وحام أبو الحبشة ، ويافث أبو الروم ) )(@)(@@) ( حم ت ك طب ) عن سمرة وعمران رضي الله عنه .(@)(@@)(@@)(@@) $ 24713 قال النبي :(@)(@@) | 30 ( ولم يفعل ذالك أحدكم ؟ فإنه ليست نفس مخلوقة إلا الله خالقها ) )(@)(@@) ( م د ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@) PageV08P106(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24714 قال النبي :(@)(@@) | 30 ( ولد الزنا لا يرث ولا يورث ) )(@)(@@) ( ك ) في تاريخه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24715 قال النبي :(@)(@@) | 30 ( ولد الزنا لا خير فيه ، نعلان أجاهد فيهما غازيا أحب إلي من أن أعتق ولد الزنا ) )(@)(@@) ( طب ) عن ميمونة بنت سعد رضي الله عنها .(@)(@@)(@@)(@@) $ 24716 قال النبي :(@)(@@) | 30 ( ولد نوح ثلاثة : سام ، وحام ، ويافث ، فولد سام : العرب ، وفارس ، والروم والخير فيهم ، وولد يافث : يأجوج ومأجوج ، والترك ، والصقالبة ولا خير فيهم ، وولد حام : بربر ، والقبط ، والسودان ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24717 قال النبي :(@)(@@) | 30 ( ولد الحكم ملعونون ) )(@)(@@) ابن عساكر عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ 24718 قال النبي :(@)(@@) | 30 ( ولم يفعل ذالك أحدكم ؟ ، فإنه ليست نفس مخلوقة إلا الله خالقها ) )(@)(@@) ( م د ) عن أبي سعيد رضي الله عنه قال : ذكر العزل عند رسول الله قال فذكره .(@)(@@)(@@)(@@) $ 24719 قال النبي :(@)(@@) | 30 ( ولم لا يبطىء عني وأنتم حولي ؟ ، لا تستنون ، ولا تقلمون أظفاركم ، ولا تقصون شواربكم ، ولا تنقون رواجبكم ) )(@)(@@) ( حم هب ) عن ابن عباس رضي الله عنهما أنه قيل : يا رسول الله لقد أبطأ عنك جبريل ، قال فذكره .(@)(@@) PageV08P107(@)(@@)(@@)(@@) ||| ( الواو مع الميم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24720 قال النبي :(@)(@@) | 30 ( وما أنا والدنيا ، وما أنا والرحم ) )(@)(@@) ( د ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 24721 قال النبي :(@)(@@) | 30 ( وما تعدون الشهادة 
ms2645	 إلا من قتل في سبيل الله ؟ : إن شهداءكم إذن لقليل : القتل في سبيل الله شهادة ، والبطن شهادة ، والحرق شهادة ، والغرق شهادة ، والمغموم يعني الهدم شهادة ، والمجنوب شهادة ، والمرأة تموت بجمع ) )(@)(@@) ( ن ) عن عبد الله بن جبير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24722 قال النبي :(@)(@@) | 30 ( وما لي لا أغضب وأنا آمر بالأمر ولا أتبع ) )(@)(@@) ( حم ن ه ) عن البراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24723 قال النبي :(@)(@@) | 30 ( وما يدريك أنها رقية قد أصبتم ، اقسموا واضربوا لي معكم سهما ) )(@)(@@) ( حم ق 4 ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24724 قال النبي :(@)(@@) | 30 ( وما يدريك لعل الله قد اطلع على أهل بدر فقال : اعملوا ما شئتم فقد غفرت لكم ) )(@)(@@) ( حم ق د ت ) عن علي ، ( د ) عن أبي هريرة ، ( حم ) عن ابن عباس ، وعن جابر رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24725 قال النبي :(@)(@@) | 30 ( وما يدريك إنه شهيد ، فلعله كان يتكلم فيما لا يعنيه ، أو يخل بما ينقصه ) )(@)(@@) ( هب ض ) و الخطيب في كتاب البخلاء عن أبي هريرة أن PageV08P108 رجلا قتل شهيدا فبكته باكية فقالت : واشهيداه فقال فذكره .(@)(@@)(@@)(@@) $ 24726 قال النبي :(@)(@@) | 30 ( وما تحزنون ؟ إن للناس هجرة واحدة ولكم هجرتان : هاجرتم حين خرجتم إلى صاحب الحبشة ، ثم خرجتم من عند صاحب الحبشة مهاجرين إلي ) )(@)(@@) ابن منده وابن عساكر عن خالد بن سعيد بن العاص رضي الله عنه .(@)(@@)(@@)(@@) $ 24727 قال النبي :(@)(@@) | 30 ( وما لي لا أضحك وهاذا جبريل يخبرني أن الله عز وجل باهى بي وبعمي العباس وبأخي علي بن أبي طالب سكان الهواء وحملة العرش وأرواح النبيين وملائكة ست سماوات ، وباهى بامتي أهل السماء الدنيا ) )(@)(@@) ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 24728 قال النبي :(@)(@@) | 30 ( وما يدريك أن الله أكرمه ، أما هو فقد جاءه اليقين ، والله إني لأرجو له الخير ، والله ما أدري وأنا رسول الله ما يفعل بي ) )(@)(@@) ( حم خ ) عن أم العلاء رضي الله عنها .(@)(@@)(@@)(@@) $ 24729 قال النبي :(@)(@@) | 30 ( وما يدريك أني رسول الله ولا أدري 
ms2646	 ما يفعل بي ؟ ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24730 قال النبي :(@)(@@) | 30 ( وما كان لكم أن تنزروا رسول الله على الصلاة ) )(@)(@@) ( م ) عن ابن شهاب قال : ذكر لي .(@)(@@)(@@)(@@) $ 24731 قال النبي :(@)(@@) | 30 ( وما لي لا أوهم ورفغ أحدكم بين ظفره وأنامله ) )(@)(@@) ( طب ) عن ابن مسعود ، ( هب ) عن قيس بن أبي حازم مرسلا .(@)(@@)(@@)(@@) $ 24732 قال النبي :(@)(@@) | 30 ( وما عليكم لو تركتموني فأعرست بين أظهركم فصنعت لكم طعاما فحضرتموه ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV08P109(@)(@@)(@@)(@@) $ 24733 قال النبي :(@)(@@) | 30 ( وما يعجبك منها ، لقد رحمها الله برحمتها صبيها ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24734 قال النبي :(@)(@@) | 30 ( وما يمنعني ؟ ، لا تكونوا أعوانا للشيطان على أخيكم ، إنه لا ينبغي للامام إذا انتهى إليه حد إلا أن يقيمه ، إن الله عفو يحب العفو وليعفوا وليصفحوا ألا تحبون أن يغفر الله لكم والله غفور رحيم ) )(@)(@@) عبد الرزاق ( حم ) وابن أبي الدنيا في ذم الغضب ، ( طب ) والخرائطي في مكارم الأخلاق ، ( ك هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24735 قال النبي :(@)(@@) | 30 ( وما تعجبون من ذا ؟ لمنديل من مناديل سعد بن معاذ في الجنة خير من هاذا ، يا غلام اذهب به إلى أبي جهم بن حذيفة وقل له : يبعث إلي بالخميصة ) )(@)(@@) ( طب ) عن عطارد بن حاجب رضي الله عنه .(@)(@@)(@@)(@@) $ 24736 قال النبي :(@)(@@) | 30 ( وما يمنعك أن تحب أن تعيي حميدا وتموت فقيرا ؟ ، وإنما بعثت على تمام محاسن الأخلاق ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ 24737 قال النبي :(@)(@@) | 30 ( وما سبيل الله إلا من قتل ؟ ، من سعى على والديه فهو في سبيل الله ، ومن سعى على عياله ففي سبيل الله ، ومن سعى على نفسه ليعفها ففي سبيل الله ، ومن سعى على التكاثر فهو في سبيل الشيطان ) )(@)(@@) ( طس هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24738 قال النبي :(@)(@@) | 30 ( وما يمنعني وجبريل خرج من عندي الساعة فبشرني أن لكل عبد صلى علي صلاة يكتب له بها عشر حسنات ويمحى عنه عشر سيئات ، ويرفع له عشر 
ms2647	 درجات ، وتعرض علي كما قالها ، ونرد عليه بمثل ما دعا ) )(@)(@@) عبد الرزاق عن أبي طلحة رضي الله عنه قال : دخلت على النبي يوما فوجدته مسرورا فقلت له ، قال فذكره .(@)(@@) PageV08P110(@)(@@)(@@)(@@) $ 24739 قال النبي :(@)(@@) | 30 ( ومن يطيق مكافأة أهل النعم ؟ ، ومن حسد الناس لم يشف غيظه ) )(@)(@@) ابن شاهين عن الجليس بن زيد الصبي رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الواو مع الهاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24740 قال النبي :(@)(@@) | 30 ( وهبت خالتي فاختة بنت عمرو غلاما وأمرتها أن لا تجعله جازرا ولا صائغا ولا حجاما ) )(@)(@@) ( طب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24741 قال النبي :(@)(@@) | 30 ( وهل ترك لنا عقيل من رباع ) )(@)(@@) ( حم ق د ن ه ) عن أسامة بن زيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24742 قال النبي :(@)(@@) | 30 ( وهل تلد الإبل إلا النوق ) )(@)(@@) ( حم د ت ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24743 قال النبي :(@)(@@) | 30 ( وهل الأجر إلا في ذالك ) )(@)(@@) ( هب ) عن عصمة بن مالك رضي الله عنه أن نفرا قالوا : يا رسول الله نرى الفواكه في السوق فنشتهيها وليس معنا شيء نشتري به فهل لنا في ذالك أجر ؟ قال فذكره .(@)(@@)(@@)(@@) $ 24744 ق ال النبي :(@)(@@) | 30 ( وهل هو إلا بضعة منك ) )(@)(@@) ( حب ) عن طلق رضي الله عنه أن رجلا قال : يا رسول الله إن أحدنا يكون في الصلاة فيحتك فتصيب يده ذكره قال فذكره .(@)(@@) PageV08P111(@)(@@)(@@)(@@) ||| ( الواو مع الياء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24745 قال النبي :(@)(@@) | 30 ( ويح الفراخ فراخ آل محمد من خليفة مستخلف مترف ) )(@)(@@) ابن عساكر عن سلمة بن الأكوع رضي الله عنه .(@)(@@)(@@)(@@) $ 24746 قال النبي :(@)(@@) | 30 ( ويح عمار تقتله الفئة ال| باغية يدعوهم إلى الجنة ويدعونه إلى النار ) )(@)(@@) ( حم خ ) عن الباغية ، يدعوهم إلى الجنة ويدعونه إلى النار .(@)(@@)(@@)(@@) $ 24747 قال النبي :(@)(@@) | 30 ( ويحك إذا مات عمر فإن استطعت أن تموت فمت ) )(@)(@@) ( طب ) عن عصمة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ 24748 قال النبي :(@)(@@) | 30 ( ويحك إن شأن الهجرة لشديد : فهل لك من إبل تؤدي صدقتها ؟ فاعمل من وراء البحار فإن 
ms2648	 الله لن يترك من عملك شيئا ) )(@)(@@) ( حم ق د ن ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24749 قال النبي :(@)(@@) | 30 ( ويحك إنه لا يستشفع بالله على أحد من خلقه إن شأن الله أعظم من ذالك ، ويحك أتدري ما الله ؟ ، إن الله فوق عرشه ، وعرشه على سماواته وأرضه مثل القبة ، وإنه ليئط به أطيط الرحل بالراكب ) )(@)(@@) ( د ) عن جبير بن مطعم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24750 قال النبي :(@)(@@) | 30 ( ويحك أو ليس الدهر كله غدا ) )(@)(@@) ابن قانع عن ابن سراقة رضي الله عنه .(@)(@@)(@@)(@@) $ 24751 قال النبي :(@)(@@) | 30 ( ويحكم لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض ) )(@)(@@) ( ق ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@) PageV08P112(@)(@@)(@@)(@@) $ 24752 قال النبي :(@)(@@) | 30 ( ويل لأمتي من علماء السوء ) )(@)(@@) ( ك ) في تاريخه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24753 قال النبي :(@)(@@) | 30 ( ويل للأعقاب من النار ) )(@)(@@) ( ق د ن ه ) عن ابن عمرو ، ( حم ق ت ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24754 قال النبي :(@)(@@) | 30 ( ويل للأعقاب وبطون الأقدام من النار ) )(@)(@@) ( حم ك ) عن عبد الله بن الحارث رضي الله عنه .(@)(@@)(@@)(@@) $ 24755 قال النبي :(@)(@@) | 30 ( ويل للأغنياء من الفقراء ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24756 قال النبي :(@)(@@) | 30 ( ويل للعالم من الجاهل ، وويل للجاهل من العالم ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24757 قال النبي :(@)(@@) | 30 ( ويل للعراقيب من النار ) )(@)(@@) ( م ) عن أبي هريرة ، ( حم ق ) عن عائشة ، ( ه ) عن جابر رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ 24758 قال النبي :(@)(@@) | 30 ( ويل للعرب من شر قد اقترب ، أفلح من كف يده ) )(@)(@@) ( د ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24759 قال النبي :(@)(@@) | 30 ( ويل للذي يحدث فيكذب ليضحك به القوم ، ويل له ، ويل له ) )(@)(@@) ( حم د ت ك ) عن معاوية بن حيدة رضي الله عنه .(@)(@@)(@@)(@@) $ 24760 قال النبي :(@)(@@) | 30 ( ويل للمالك من المملوك ، وويل للمملوك من المالك ) )(@)(@@) البزار عن حذيفة رضي الله عنه .(@)(@@) PageV08P113(@)(@@)(@@)(@@) $ 24761 قال النبي :(@)(@@) | 30 ( ويل للمتألين من أمتي الذين يقولون : فلان في الجنة 
ms2649	 ، وفلان في النار ) )(@)(@@) ( تخ ) عن جعفر العبدي مرسلا .(@)(@@)(@@)(@@) $ 24762 قال النبي :(@)(@@) | 30 ( ويل للمكثرين إلا من قال : بالمال هاكذا وهاكذا ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24763 قال النبي :(@)(@@) | 30 ( ويل للنساء من الأحمرين : الذهب والمعصفر ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24764 قال النبي :(@)(@@) | 30 ( ويل للوالي من الرعية إلا واليا يحوطهم من ورائهم بالنصيحة ) )(@)(@@) الروياني عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ 24765 قال النبي :(@)(@@) | 30 ( ويل لمن استطال على مسلم فانتقص حقه ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24766 قال النبي :(@)(@@) | 30 ( ويل لمن لا يعلم ولو شاء الله لعلمه واحد من الويل ، وويل لمن يعلم ولا يعمل سبع من الويل ) )(@)(@@) ( ص ) عن جبلة مرسلا .(@)(@@)(@@)(@@) $ 24767 قال النبي :(@)(@@) | 30 ( ويل لمن لا يعلم ، وويل لمن علم ثم لا يعمل ) )(@)(@@) ( حل ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24768 قال النبي :(@)(@@) | 30 ( ويل واد في جهنم يهوي فيه الكافر أربعين خريفا قبل أن يبلغ قعره ) )(@)(@@) ( حم ت حب ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24769 قال النبي :(@)(@@) | 30 ( ويلك أو لست أحق أهل الأرض أن يتقي الله ؟ ) )(@)(@@) ( ق ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24770 قال النبي :(@)(@@) | 30 ( ويلك قطعت عنق صاحبك ، من كان منكم مادحا أخاه لا محالة فليقل : أحسب فلانا والله حسيبه ولا أزكي على الله أحدا أحسبه كذا PageV08P114 وكذا إن كان يعلم ذالك منه ) )(@)(@@) ( حم ق د ه ) عن أبي بكرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24771 قال النبي :(@)(@@) | 30 ( ويلك ومن يعدل إذا لم أعدل ، قد خبت وخسرت إن لم أكن أعدل ) )(@)(@@) ( ق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24772 قال النبي :(@)(@@) | 30 ( ويح أمها قرية يدعها أهلها أينع ما يكون تأكلها عافية الطير والسباع ولا يدخلها الدجال إن شاء الله ، كلما أراد دخولها تلقاه بكل نقب من نقابها ملك مصلت يمنعه عنها ) )(@)(@@) ( حم طب ك ) عن محجن بن الأدرع رضي الله عنه .(@)(@@)(@@)(@@) $ 24773 قال النبي :(@)(@@