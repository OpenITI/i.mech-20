ms261	 : - 1(@)(@@) % يا من يريد يحي الله بالتحقيق % % عقلك مصور وقانع أنت بالتخليق % % 2(@)(@@) % والله في الغيب مطلق ماله تضييق % % وكل ممنوع نحوه العقل ذو تشويق % % 10(@)(@@) % له من الحق جند % % يوليه نصرا وجحفل % % PageV01P1198 البحر : - 1(@)(@@) % حقيقتي حضرة التجلي % % ومظهر الغيب بالتخلي % % PageV01P1199 البحر : - 1(@)(@@) % كل قول على العقول يشق % % ليس جمعا وإنما هو فرق % % 2(@)(@@) % والقاب والقوس في التداني % % وزينة الله في التجلي % % 2(@)(@@) % والذي من ورا العقول فجمع % % هو بالقلب ليس يبديه نطق % % 3(@)(@@) % ظهرت عنه به لديه % % وقلت يا صاحبي وخلي % % 3(@)(@@) % وحدة أطلقت عليه تعالى % % في ثلاث من الكلام تدق % % 4(@)(@@) % وفيه أطلقت بعد حبسي % % وفك قيدي به وغلي % % 4(@)(@@) % هو حق وباطل ما سواه % % من جميع الأكوان غرب وشرق % % 5(@)(@@) % إرادة للخصوص أعطت % % وقدرة أعطت التدلي % % 5(@)(@@) % ووجود غيره عدم لا % % يقتضي غير ذا ولا يستحق % % 6(@)(@@) % وعن بواقي الصفات مدت % % حقيقتي كامتداد ظلي % % PageV01P1200 6(@)(@@) % وهو نور بدت به ظلمات % % هن سحق جميعهن ومحق % % 7(@)(@@) % إذا بدا نوره فماذا % % وإن خفي نوره فمن لي % % 7(@)(@@) % هكذا عنه في الكتاب يكنى % % وبهذا لعارف الله سبق % % 8(@)(@@) % إن يشأ عنه قال وحدة حق % % أو يشأ وحدة الوجود تحق % % 8(@)(@@) % إن لم يكن وابل فمنه % % قنعت يوم اللقا بطل % % 9(@)(@@) % أو يشأ قال وحدة النور عنه % % كلمات ما هن للدين خرق % % 9(@)(@@) % يا ويح صب عليه مضنى % % يذوب في مشهد التملي % % 10(@)(@@) % سرى جلدب إليه بال % % وجلد فيه مضمحل % % 10(@)(@@) % وحدة الحق حققت كل شيء % % فجميع الأشياء بالحق حق % % 11(@)(@@) % رآه في كل ما رآه % % فلم يقل بعده لعلي % % PageV01P1201 11(@)(@@) % وكذا وحدة الوجود بها قد % % وجد الكل فهي للكل حق % % 12(@)(@@) % له رامغ بمن تجلى % % به وما عنده تسلى % % 12(@)(@@) % وسعت قال رحمتي كل شيء % % فتأمل ماذا يقول المحق % % 13(@)(@@) % بشعب وادي النقا غزال % % نفوره كان أصل ذلي % % 13(@)(@@) % وحدة النور للجميع أنارت % % فجميع الأشياء بالنور صدق % % 14(@)(@@) % وغصن انب سبى فؤادي % % بلين عطف وحسن دل % % 14(@)(@@) % هذه هذه الثلاثة 
ms262	 أمر % % واحد وهو بالتقادير برق % % 15(@)(@@) % يا قمرا طالعا علينا % % بوجهه المشرق المطل % % 15(@)(@@) % قدرا قل مقدرا أمره كا % % ن كما قال والعوالم رق % % 16(@)(@@) % وظلمة الكون قد تولت % % والسر في ذلك التولي % % PageV01P1202 البحر : - 1(@)(@@) % وجود حقيقي هو الغيب مطلق % % به الكل موجود يلوح فيشرق % % 2(@)(@@) % وهم عدم الانتساب يريكهم % % وجودا فحقق ما ترى يا محقق % % 3(@)(@@) % ودع عنك هذا الالتباس فإنه % % على كل عقل حاكم ليس يرفق % % 4(@)(@@) % فيظهر معدومات كل مقدر % % من الغيب موجودات حس فتحرق % % 5(@)(@@) % وما ذلكم إلا مجرد نسبة % % إليه تعالى كل ما الله يخلق % % 6(@)(@@) % فميز وجود الحق من عدم السوى % % تكن رجلا عند الورى بك يوثق % % 7(@)(@@) % وسدد وقارب واتكل واصطبر وكن % % بغير وجود عند نفسك تصدق % % 17(@)(@@) % نحن تقاديره قديما % % من كل بعض وكل كل % % 18(@)(@@) % وقد تجلى بنا فصرنا % % كبائن عنه مستقل % % 19(@)(@@) % وهو الذي لم يزل على ما % % عليه من قبل ذا التجلي % % PageV01P1203 20(@)(@@) % ونحن أيضا كما ذكرنا % % هنا على حالنا المولى % % 21(@)(@@) % ولكن الزيغ في قلزوب % % وفي عيون من المضل % % 22(@)(@@) % يريك غير الذي تراه % % وأنت كالساعد الأمثل % % 23(@)(@@) % فنزه الرب عن زمان % % وعن مكان وعن محل % % PageV01P1204 البحر : - 1(@)(@@) % ظهرت لي يا غيب يا مطلق % % بالروح روح الأمر بي تشرق % % 2(@)(@@) % والروح روح واحد كلنا % % أرواحنا منه لنا تسبق % % 3(@)(@@) % لسانه العقل إذا رام أن % % ينطق به في نفسه ينطق % % 4(@)(@@) % كلامنا نحن وكل الورى % % في نفسه ربي له يخلق % % 5(@)(@@) % طبيعة بالروح تبدو كما % % تخفى فلا غرب ولا مشرق % % 6(@)(@@) % بحر هو الروح وأمواجه % % جميع ما يسكن أو يخفق % % 7(@)(@@) % مثل معانيك التي أنت في % % نفسك تعنيها إذا تحدق % % 8(@)(@@) % والكل خلق الله لاحت لهم % % في كل شيء آية تبرق % % 9(@)(@@) % يا مالكي روحك روحي كما % % قلت نفخت الروح إذ حققوا % % 24(@)(@@) % وعن معاني العقول طرا % % من كل معنى به مخل % % PageV01P1205 25(@)(@@) % وكل ما أدركت حواس % % فعنه في المنزه الأجل % % 26(@)(@@) % وكن به طاهرا نظيفا % % إن قمت يا 
ms263	 أيها المصلي % % 27(@)(@@) % واركع له عن سواه واسجد % % إليه في حضرة التعلي % % 28(@)(@@) % ودم على الصدق في الترجي % % واشفق على قدرك الأقل % % 29(@)(@@) % ولا تحل عنه وانتظره % % غير سؤوم ولا ممل % % 30(@)(@@) % فإن وجود الكريم باق % % بكل غيث له مهمل % % 31(@)(@@) % وبابه ماله انغلاق % % عمن إليه أتى بذل % % PageV01P1206 البحر : - 1(@)(@@) % نفسي على نفسي الوجود بها نزل % % فرضا وتقديرا ترتب في الأزل % % 2(@)(@@) % فتلبست نفس الوجود بغيرها % % وتقيد الإطلاق منها وانعزل % % 3(@)(@@) % وهو الذي هو لم يزل في غيبه % % وأنا الذي هو في انعدام لم أزل % % 4(@)(@@) % وكذاك حكم الكائنات جميعها % % فدع العنايا من تريض واعتزل % % 5(@)(@@) % واعلم بأنك أنت تقدير الذي % % هو ناسج لك بالمشيئة ما غزل % % 6(@)(@@) % والحضرتان له هل فحضرة ذاته % % محض والوجود وصفة نظم الغزل % % 7(@)(@@) % وهي الصفات جميعنا آثارها % % من جد فهو بها بجد ومن هزل % % 8(@)(@@) % وإذا تعرض خاطر لك فاسد % % فارجع إلى التقدير إن العقل زل % % 9(@)(@@) % وإذا الوجود الحق أعرض عنك قل % % نفسي على نفسي الوجود بها نزل % % 10(@)(@@) % بيني وما بينك هذا فإن % % خفيت فيه فأنا الأسبق % % PageV01P1207 11(@)(@@) % والغيب أنت الغيب حق ولا % % نقدر أن ندنو ولا نحلق % % 12(@)(@@) % وإنما نعرفه بالذي % % صوره الروح لنا المطلق % % 13(@)(@@) % معرفة من روحنا مثلنا % % مخلوقة دون الذي يخلق % % 14(@)(@@) % والروح هذا ملك واحد % % بملء ملك الله يستوثق % % 15(@)(@@) % أحب مولاه ولا يستطع % % إدراكه وهو له يعشق % % 16(@)(@@) % حيران فيه فتراه لنا % % مصورا فهو بنا يرمق % % 17(@)(@@) % هذا طريق واسع والسوى % % ذاك طريق أعوج ضيق % % PageV01P1208 البحر : - 1(@)(@@) % ساقي يا ساقياسقيني من خمره الباقيواكشف لي عن قيد اطلاقي % % PageV01P1209 البحر : - 1(@)(@@) % بنورك أيها الوجه الجميل % % ظهرنا كلنا جيل فجيل % % 2(@)(@@) % يا ساقي آه يا ساقي % % 2(@)(@@) % وبان الحق واتضح السبيل % % وإنك حسبنا نعم الوكيل % % 3(@)(@@) % دور % % 3(@)(@@) % دور % % 4(@)(@@) % هي الأكوان أجمعها براقع % % على الأوهام منها الأمر واقع % % 4(@)(@@) % محبوبي ظاهريتجلى بالوجه الباهرللعشاق في حكمه قاهر % % 5(@)(@@) % ولكن دون هذا السم ناقع % % وأنت العذب فيه السلسبيل % % 5(@)(@@) % يا 
ms264	 ساقي آه يا ساقي % % 6(@)(@@) % دور % % PageV01P1210 6(@)(@@) % دور % % 7(@)(@@) % أستاره راحتعن عيني والزهره فاحتوالسكره بالأسرار باحت % % 7(@)(@@) % سقى الله العقيق وشعب رامه % % وخصص بالصلاة وبالسلامة % % 8(@)(@@) % يا ساقي آه يا ساقي % % 8(@)(@@) % نبي الحق أرسل من تهامه % % به عبد الغني هو النزيل % % 9(@)(@@) % دور % % PageV01P1211 البحر : - 1(@)(@@) % إن قلت أن الوجود نفس % % الموجود يا أشعري فقل لي % % 2(@)(@@) % كذاك إن الموجود نفس % % الموجود عكس بلا مخل % 3(@)(@@) % وقلت نإ الوجود جنس % % والجنس تميزه بفصل % % 4(@)(@@) % والفصل نفس الوجود أيضا % % فالكل جنس مثلا بمثل % % 5(@)(@@) % فأين فصل الوجود ياذا % % بمقتضى عملك إلا جل % 6(@)(@@) % فإن تقل فصله اعتبار % % في العقل مثل اعتبار ظل % 7(@)(@@) % قلنا لك الاعتبار أمر % % له ثبوت في كل عقل % % 8(@)(@@) % وعنه شيء يقال وهو % % الموجود فارجع لحكم كل % % 9(@)(@@) % وإن تقل إن كل شيء % % وجوده حكم مستقل % % 10(@)(@@) % اكشف لي عنكفي ذاتي وافتح لي دنكواجعلني يا حبي أنك % % PageV01P1212 10(@)(@@) % مميز عن سواه ذاتا % % فليس فيه اشتراك جعل % % 11(@)(@@) % يا ساقي آه يا ساقي % % 11(@)(@@) % تقول لا جنس فالوجود % % المراد جزئي ولس كلي % % 12(@)(@@) % خلاف ما حرروا وقالوا % % في حكم قانون علم شكل % % 12(@)(@@) % افتح باب الحانواسمعني من طيب الألحانوأرشفني من كاسي الملئان % % 13(@)(@@) % يا ساقي آه يا ساقي % % 13(@)(@@) % أو قلت إن الوجود غير % % الموجود والغير غير أصل % % 14(@)(@@) % دور % % 14(@)(@@) % طرا على الشيء وهو لا شي % % ء صار نعتاله له يجلى % % 15(@)(@@) % بمن ترى النعت قائم % % والمنعوت لاشيء فاستمع لي % % PageV01P1213 15(@)(@@) % في دور الكاساتقد غابت إخواني الساداتوالخمار محمود العادات % % 16(@)(@@) % وهل تقوم النعوت يوما % % بغير أشيا ولا محل % 16(@)(@@) % يا ساقي آه يا ساقي % % 17(@)(@@) % دور % % 17(@)(@@) % هذا سؤال على عقول % % أتى بعلم ونفى جهل % % 18(@)(@@) % من يشرب يسكرمن خمري لما يتفكروالمغرور في علمه أنكر % % 18(@)(@@) % فإن تكن عالما فحقق % % جوانبا يا أجل خل % 19(@)(@@) % يا ساقي آه يا ساقي % % 20(@)(@@) % دور % % 21(@)(@@) % العالم فانيوالموجود ماله من ثانيلا يدري غير الرباني % % PageV01P1214 22(@)(@@) % يا ساقي آه يا ساقي 
ms265	 % % 23(@)(@@) % دور % % 24(@)(@@) % يا دائم يا هوإن الكل في أمرك تاهواوالمضنى حبك أفناه % % 25(@)(@@) % يا ساقي آه يا ساقي % % 26(@)(@@) % دور % % 27(@)(@@) % لا يعرف أمريإلا من يشرب من خمريأحشاؤه تصلى في جمري % % PageV01P1215 البحر : - 1(@)(@@) % نور تلفف بالظلام مكمل % % نودي هنا يا أيها المزمل % % 2(@)(@@) % قم فيه وهو النيل أي بأموره % % طبق الإرادة ما علا والأسفل % % 3(@)(@@) % ذرني ومن فيه خلقت من الورى % % فيه وحيدا مستقلا يفعل % % 4(@)(@@) % واغلظ عليهم قال أي بنفوسهم % % وهو الرؤوف بنا الرحيم المفضل % % 5(@)(@@) % وهو العزيز عليه ما عنت السوى % % وهو الحريص على الجميع ليكملوا % % 6(@)(@@) % بحروهم أمواجه وهو الذي % % بالحق قام كصورة تتخيل % % 7(@)(@@) % وافهم إشارة قوله وقد جاءكم % % من عين أنفسكم إليكم مرسل % % 8(@)(@@) % تجد الذي بالروح عنه وبالحجى % % كنى الإله وما درى من يجهل % % 9(@)(@@) % وهو الحقيقة والشريعة والهدى % % لمن اهتدى وهو الحبيب المقتل % % 10(@)(@@) % والسنة الغراء فيه طريقنا % % ويد الجماعة والكتاب المنزل % % PageV01P1216 11(@)(@@) % طورا يغيب ونحن نظهر عنه في % % هذا الزمان لنا المقام الأفضل % % 12(@)(@@) % ونغيب نحن به ويظهر تارة % % هو قائم عنا بنا يتمثل % % 13(@)(@@) % ووارء هذا في الغيوب حقيقة % % تطوى الحقائق كلها لا تعقل % % 14(@)(@@) % قد أجملت نور النبي وفصلت % % وتظل تجمل للورى وتفصل % % 15(@)(@@) % وهي الوجود وما سواها هالك % % ويقال موجود يلوح ويأفل % % 16(@)(@@) % نور على نور وللثاني أتى % % أوفى الصلاة بها يجود الأول % % 17(@)(@@) % طول المدى ما هب ريح الروح في % % روض الجسوم وما تغنى البلبل % % 28(@)(@@) % يا ساقي آه يا ساقي % % 29(@)(@@) % دور % % 30(@)(@@) % كفوا يا عذالصبري في حبيه قد زاليغزوني بالجفن الغزال % % PageV01P1217 31(@)(@@) % يا ساقي آه يا ساقي % % 32(@)(@@) % دور % % 33(@)(@@) % معروف الأوصافيعمل لي أنواع الألطافقلبي في كعبة ذاته طاف % % 34(@)(@@) % يا ساقي آه يا ساقي % % 35(@)(@@) % دور % % 36(@)(@@) % ذا قول قدسيمن عبد الغني النابلسيللسالك في هذا الجنس % % 37(@)(@@) % يا ساقي آه يا ساقي % % 38(@)(@@) % دور % % 39(@)(@@) % يا ربي صليعلى الهادي نور المتجليمع آل والصحب الكل % % 40(@)(@@) % يا ساقي آه يا ساقي % % PageV01P1218 41(@)(@@) % دور % % 42(@)(@@) % ما 
ms266	 غنى الحاديللركب المكي الغاديأو لاحت أنوار الوادي % % 43(@)(@@) % يا ساقي آه يا ساقي % % PageV01P1219 البحر : - 1(@)(@@) % في الكون للحق أمثال بها نطقا % % مضروبة منه للعبد الذي صدقا % % PageV01P1220 البحر : - 1(@)(@@) % كل ما يخلقه العقل أمل % % والذي يخلقه الله عمل % % 2(@)(@@) % فقال تلك هي الأمثال نضربها % % للناس يعقلها من الكمال رقى % % 2(@)(@@) % فاعرفوا لفرقا الذي بينهما % % تجدوه البدر في الشم أكتمل % % 3(@)(@@) % وأغفل الله عنها من يشاهدهم % % أهل السعادة في الدنيا وأهل شقا % % 3(@)(@@) % وانتساب الخلق للعقل كما % % قال عيسى وعلى الأذن حمل % % 4(@)(@@) % فمؤمن هو ناج دون معرفة % % إيمانه النور كالبرق الذي برقا % % 4(@)(@@) % هذه الحضرة لا يدخلها % % غير من فصلها ثم انجمل % % 5(@)(@@) % وجاهل ليس يدري ما يقال له % % تكذيبه رزقه ذاك الذي رزقا % % 5(@)(@@) % نظرات بعيون كثرت % % دمعها الطوفان في الكون همل % % 6(@)(@@) % كن مسلما مؤمنا بالحق تعرفه % % أو لست تعرفه واتبع لأهل تقى % % PageV01P1221 6(@)(@@) % وابتداء الأمر أن تشهده % % واحدا في الكل طير أو جمل % % 7(@)(@@) % ثم لا طير ولا شيء هنا % % شمس أبراج كحوت وحمل % % 7(@)(@@) % وإن ترد تعرف الله الذي ظهرت % % آياته فاتبع الأصحاب والرفقا % % 8(@)(@@) % هو هذا فاقلب العين وما % % هو هذا وعلى هذا اشتمل % % 8(@)(@@) % وهمأولو العلم علم الله سادتنا % % وكن بهم مؤمنا تلحق بمن سبقا % % 9(@)(@@) % وانظر إلى الوقت وقت الفجر ليس له % % علامة غير نور يملأ الأفقا % % 9(@)(@@) % جمل كل التفاصيل له % % فتحقق والتفاصيل جمل % % 10(@)(@@) % ونوره غيره والوقت يحضر إن % % أبدى له الله ذاك النور والشفقا % % 10(@)(@@) % يا نديمي لك متى قدر ما % % أنت فيه كلما العقل احتمل % % 11(@)(@@) % والوقت طلق بلا قيد يقيده % % في نفسه فاعتبره واشهد الفلقا % % PageV01P1222 11(@)(@@) % فافتح الباب وخذ ميمنة % % في طريقي فيه من يمشي رمل % % 12(@)(@@) % واشهد علامته تشهده حيث بدا % % والله غيب ومشهود بمن خلقا % % 12(@)(@@) % والمعاني كلها قاصرة % % عنه والجرح عليه ما اندمل % % 13(@)(@@) % والوقت في كل أرض حاضر فخذوا % % منه اعتبار الوجود الحق منطلقا % % 13(@)(@@) % غير أن العشق يلقى تارة % % بك لليأس وطورا للأمل % % 14 
ms267	(@)(@@) % ونزهوه وقولوا عنه خالقنا % % ما إن له غيبة فاليوم يوم لقا % % 14(@)(@@) % وله دح فمن جاوزه % % عكس الأمر وقد مال ومل % 15(@)(@@) % والله عنه جميع الكون منتشر % % كالضوء يبدو عن الضوء الذي انفتقا % % PageV01P1223 البحر : - 1(@)(@@) % سنة نبي مختار % % فيها قيام الليل % % 2(@)(@@) % طالت بها الأعمار % % تعطي القوى والحيل % % 3(@)(@@) % حوزوا بها أنوار % % وأحوو المنى والنيل % % 4(@)(@@) % صلوها يا أبرار % % عنكم يزول الويل % % 5(@)(@@) % دور % % 6(@)(@@) % قد صدق الصديق % % فيها أبو بكر % % 7(@)(@@) % واختص بالتحقيق % % حقا بلا نكر % % 8(@)(@@) % عنه الرضى توفيق % % من أفضل الذكر % % 9(@)(@@) % فارضوا بلقب شيق % % فيه إليه ميل % % 10(@)(@@) % دور % % PageV01P1224 11(@)(@@) % أحيي لها الفاروق % % نجل الفتى الخطاب % % 12(@)(@@) % من قدره العيوق % % في زمرة الاصحاب % % 13(@)(@@) % عنه الرضى منطوق % % للسادة الأحباب % % 14(@)(@@) % فارضوا فعنه النوق % % ترضى وتمشى سيل % % 16(@)(@@) % تبارك الله لا شيء يشابهه % % فالحسن والعقل في تنزيهه اتفقا % % 17(@)(@@) % والله قد ضرب الأكوان أمثلة % % بالفعل لا نحن فاترك عنك ذا السلقا % % 18(@)(@@) % ونحن نعقلها لا نحن نضربها % % فنودع الطرس ما ندريه والورقا % % 19(@)(@@) % وإن ترد أوضح الأمثال أجمعها % % فانظر إلى صفحة المرءآة مستبقا % % 20(@)(@@) % من الزجاج أو الفولاذ ليس بها % % شيء وفيه يلوح الشيء متسقا % % 21(@)(@@) % ولا ترى جرم مرآة بك استترت % % وبالجميع فلا تتعب به الحدقا % % PageV01P1225 22(@)(@@) % كما تلوح لك الأكوان تظهر في % % مرآة عين الوجود المنتمي لبقا % % 23(@)(@@) % وليس فيه سواه دائما أبدا % % والكل فان به فيه قد انسحقا % % 24(@)(@@) % وهو القريب ولكن لست تدركه % % لأنه بك مستور وأنت وقا % % 25(@)(@@) % بحر الوجود الحقيقي لا تزال به % % ترى الظهور هنا الأكوان والفرقا % % 26(@)(@@) % والكل فان وهذا واحد أحد % % لا غيره معه للغير قد محقا % % 27(@)(@@) % فاسلك على أثري وانظر إلى نظري % % وثق بما قلته يا فوز من وثقا % % 28(@)(@@) % واشتم رائحتي من مسك نافجتي % % فإنني لك عطر في الورى عبقا % % PageV01P1226 البحر : - 1(@)(@@) % رعى الله بستانا بفيجة جلق % % على عذب ماء بارد متدفق % % 2(@)(@@) % به العين جادت كل حين بفيضها % % فأرخص فينا سعر كاس مروق % % 3 
ms268	(@)(@@) % رياض أريضات تظل غصونها % % تميل دلالا بالصبا المترقرق % % 4(@)(@@) % وللظل منها الميل يرسم شكلها % % على الأرض مثل الكاتب المتأنق % % 5(@)(@@) % أتينا إليها من جبال مهولة % % يكاد بها الماشي يخر بمزلق % % 6(@)(@@) % وكيف إذا كان الذي جاء راكبا % % ففي خطر لا شك فيه محقق % % 7(@)(@@) % وتختر وإن نحن سرنا به على % % بغال متى سارت بقلبك يخفق % % 8(@)(@@) % وكان إله الخلق يحظفنا بها % % فلم نر من خوف هنالك ملحق % % 9(@)(@@) % وسرنا على حكم الشهود بأمر من % % حبانا كرام وعز ورونق % % 15(@)(@@) % دور % % PageV01P1227 16(@)(@@) % ثم اعتنى عثمان % % في هذه السنة % % 17(@)(@@) % من عنده نوران % % من أعظم المنة % % 18(@)(@@) % خصوة بالرضوان % % عنه تروا الجنة % % 19(@)(@@) % والله بالإحسان % % يوفى لكم في الكيل % % 20(@)(@@) % دور % % 21(@)(@@) % وارضوا عن الكرار % % والصهر وابن العم % 22(@)(@@) % من خص بالأسرار % % حاوي العطاء الجم % 23(@)(@@) % مع جملة الأطهار % % آل وصحب ثم % % PageV01P1228 البحر : - 1(@)(@@) % لا تظلم الله بما لا يليق % % به ولا تدخل له في مضيق % % 2(@)(@@) % فإن أهل الجهل قد بالغوا % % في حقه بالنقص وهو الشفيق % % 24(@)(@@) % والأوليا الأخيار % % فيهم يطول الذيل % % PageV01P1229 البحر : - 1(@)(@@) % إنا فهمنا عنه أمثالالنا % % هو ضارب فينا بخلق أكمل % % 2(@)(@@) % لم نضرب الأمثال نحن له ولم % % نعدل عن النهج القويم الأعدل % % 3(@)(@@) % يرحمهم دوما وهم في عمى % % عنه حمير بالغت في النهيق % % 3(@)(@@) % ولهم ضربنا قوله الأمثال في % % حق الذين تقدموا فتأمل % % 4(@)(@@) % ظنونهم فيها احتقار لهم % % من غير علم عندهم في الطريق % % 4(@)(@@) % لا تضربوا الأمثال لله الذي % % قد قال ذلك في الكتاب المنزل % % 5(@)(@@) % فالله يعلم والبرية كلهم % % لا يعلمون بمجمل ومفصل % % 5(@)(@@) % كل امرئ منهم يظن الردى % % هو الهدى والظن بئس الرفيق % % 6(@)(@@) % ومتى رأينا عالما في صورة % % كونية قلنا هو الحق الجلي % % 6(@)(@@) % سكران من خمر جهالاته % % يا ليته لو كان يوما يفيق % % PageV01P1230 7(@)(@@) % رام الظهور بصورة في عمله % % وبها توجه للحضيض الأسفل % % 7(@)(@@) % يا ويح قوم شبهوا ربهم % % وقيدوه وهو وهو الطليق % % 8(@)(@@) % يؤذونه سبحانه بالذي % % قد نسبوه وهو ما لا يليق 
ms269	 % % 8(@)(@@) % والكل وذ علم ولو بحقيقة % % فيما مضى والآن والمستقبل % % 9(@)(@@) % والحق عنها قد تنزه قبلها % % وهو المنزه بعدها عنها العلى % % 9(@)(@@) % وكم شريك أثبتوه له % % به فخروا من مكان سحيق % % 10(@)(@@) % والحكم فيها قد أتى منه على % % ما كان منها في القديم الأول % % 10(@)(@@) % كذا له صاحبة أثبتوا % % وولدا قل ذاك عبد رقيق % % 11(@)(@@) % وعبدوا الأصنام جهلا وقد % % خروا إليها سجدا بالحقيق % % 11(@)(@@) % وهو الذي ما زال عن إطلاقه % % وهي التي عن نفيها لم ننزل % % PageV01P1231 12(@)(@@) % وعلقوا بالبيت أصنامهم % % ودنسوا البيت الحرام العتيق % % 12(@)(@@) % لكنها ثبتت به منه له % % كشفا بعلم ليس بالمتحول % % 13(@)(@@) % وتخصصا بإرادة وتقدرا % % بالقدرة القصوى عن المتأمل % % 13(@)(@@) % والنار أيضا عبدوها كما % % هم يعبدون الشمس ذات الشريق % % 14(@)(@@) % فاشهده منها مطلقا في نفسه % % ومقيدا بخصوصها المتأثل % % 14(@)(@@) % ويعبدون العجل من جهلهم % % وكفرهم بالله وهو المحيق % % 15(@)(@@) % أو شئت فاشهدها به معدومة % % لما تزل وهو الشهيد لها الولي % % 15(@)(@@) % وهكذا يؤذونه دائما % % وهو صبور ماءهم لا يريق % % 16(@)(@@) % كما حكى القرآن هذا لنا % % وكان ما قد كان من كل ضيق % % 16(@)(@@) % إن لشهادة ا والولاية كانتا % % للحق حتى صارتا بالحق لي % % PageV01P1232 17(@)(@@) % حتى أتى الله بنور الهدى % % وزال عن إشراقه ما يعيق % % 18(@)(@@) % وأسفر الفجر وفاحت به % % حدائق الورد وروض الشقيق % % PageV01P1233 البحر : - 1(@)(@@) % رب فوارة خلال مروج % % ماؤها ناثر عقود لآلي % % 2(@)(@@) % كلما قم ذلك الماء فيها % % خر للأرض ساجد للحال % % 3(@)(@@) % وهو في حالة السجود تراه % % في هدير بذكره متوالي % % 4(@)(@@) % ليس إلا هو الشخوص إذا ما % % زال شخص أتاه شخص تالي % % 5(@)(@@) % جل يا ماء خالق لك أجري % % دائما فهو ربنا ذو الجلال % % 6(@)(@@) % قم به هكذا بنفسك واقعد % % في السواقي وصوت ذكرك عالي % % 7(@)(@@) % عبرة للذي يرى بك منا % % نفسه في تكون وزوال % % 8(@)(@@) % مدة العمر فهو لله عبد % % من أولي الأمر أمر مولى الموالي % % 19(@)(@@) % وقد تجلى لقلوب الورى % % رب لهم قد كان نعم الصديق % % 20(@)(@@) % وإنه غيب عن العقل بل % % عن 
ms270	 الحواس الخمس قول حقيق % % PageV01P1234 21(@)(@@) % وما له ماهية تقتضي % % ظهوره فيها لمن يستفيق % % 22(@)(@@) % وإنما الخلق ظهوراته % % بهم تجلى مثل برق بريق % % 23(@)(@@) % لم يتغير جل وهو الذي % % يغير الغير ويهدي الفريق % % 24(@)(@@) % خذ علمه عني فإني به % % بحر مداه للأعادي عميق % % 25(@)(@@) % واحذر من الجبار يلقيك في % % بحري فكم من جاهل بي غريق % % 26(@)(@@) % واشرب معي كاس الوجود الذي % % عن غيره يغنيك فهو الرحيق % % PageV01P1235 البحر : - 1(@)(@@) % خليلي ما بال القوافل هكذا % % عن الحق مصروفون وهو ضلال % % 2(@)(@@) % يرون الوجود الحق للخلق ظاهرا % % يحقق هذا عندهم ويقال % % 3(@)(@@) % كان الوجود الخلق صار محققا % % وأما الوجود الحق فهو خيال % % 4(@)(@@) % خيال لديهم ظاهر في نفوسهم % % لهم غائب عنهم وذاك مخال % % 27(@)(@@) % وقل لمن لا يعرفون الذي % % هم فيه من خبث لديهم معيق % % 28(@)(@@) % يا عصبة الطغيان والافترا % % إلى متى كفوا الحريق الحريق % % 29(@)(@@) % ما أنتموا مثلي لكلي تعرفوا % % ما حجر الكدان مثل العقيق % % PageV01P1236 البحر : - 1(@)(@@) % حيا الحيا الوسمي سكان النقى % % 2(@)(@@) % ليت بهم تعود أيام اللقا % % 3(@)(@@) % أيام كنا بالفنا وبالبقا % % 4(@)(@@) % نهوى الوجود في الوجوه مطلقا % % وكل أمر لم يزل محققا % % 5(@)(@@) % دور % % 5(@)(@@) % فهم يعبدون الله فيما تخيلوا % % وقد بان في كل العقول عقال % % 6(@)(@@) % يا سعد سلم لي على وادي سلم % % 6(@)(@@) % وإن الوجود الحق صار مقيدا % % لديهم بأشيا تنمحي وتزال % % 7(@)(@@) % حيث ترى نارا على رأس علم % % 7(@)(@@) % فمن أجل هذا أنكروه وقد بدا % % وغاب وهامت في هواه رجال % % PageV01P1237 8(@)(@@) % به شغلوا عنه وأثار صنعه % % تقادير حالت دونه وظلال % % 9(@)(@@) % فلاهم مع الأقوام فيما تحققوا % % ولا هم على تحقيقهم فيخال % % 10(@)(@@) % وجهل على جهل فجهل مركب % % وليس لهم في دفع ذاك مجال % % PageV01P1238 البحر : - 1(@)(@@) % ربنا الله ذلك المتعالي % % عن جميع الأشباه والأمثال % % 2(@)(@@) % عز في ملكه وجل فصارت % % عنه معقولة عقول الرجال % % 3(@)(@@) % لا بذكر يدرونه أو بفكر % % أوبوهم ولا خطور ببال % % 4(@)(@@) % فهو غيب كل الورى سبحته % % بتصاويرها وبالأشكال % % 5(@)(@@) % وهو مع ذلكالتنزه بادي % % يتجلى بسافل 
ms271	 وبعالي % % 6(@)(@@) % وقريب للشيء من كل شيء % % وبعيد بعزة وجلال % % 7(@)(@@) % حركات الجميع مع سكنات % % كلها منه عنه في كل حال % % 8(@)(@@) % دعوى وجودكم بها الغير ظلم % % 8(@)(@@) % مالشيء سواه تأثير فعل % % أبدا غير نسبة الأفعال % % 9(@)(@@) % عرفته به أولوا العلم منا % % بعد محو النفوس باضمحلال % % PageV01P1239 9(@)(@@) % لا عاش يوما بالهنا ولا ارتقى % % وكل أمر لم يزل محققا % % 10(@)(@@) % حيث لم يتركوا لهم فيه دعوى % % أثر من تحرك أو مقال % % 10(@)(@@) % دور % % 11(@)(@@) % الله نور الأرض والسماء قل % % 11(@)(@@) % وله اسلموا به فرأوه % % فاعلا عين فعلهم بالتوالي % % 12(@)(@@) % ولهم محض نسبة الفعل أبقى % % للعبودية التي للكمال % % 12(@)(@@) % والكل ظلمة عليهم قد ثقل % % 13(@)(@@) % إن قلت باطل لك الحق يقل % % 13(@)(@@) % كلفتهم أحكامه أن يروها % % فهي منهم له على الإجمال % % 14(@)(@@) % سعدت والذي ادعاه في شقا % % وكل أمر لم يزل محققا % % PageV01P1240 15(@)(@@) % دور % % 16(@)(@@) % عبد الغني أغناه مولاه الغني % % 17(@)(@@) % بفضله وزاده زاد هني % % 18(@)(@@) % وبالصلاة والسلام يعتني % % 19(@)(@@) % على النبي المصطفى الذي رقى % % وكل أمر لم يزل محققا % % PageV01P1241 البحر : - 1(@)(@@) % كل أمر ترجوه من مخلوق % % يعتريه نوع من التعويق % % 2(@)(@@) % وأنا قائل وأستغفر الله مقال المجاز لا التحقيق % % 3(@)(@@) % لست أرضى من فعل إبليس شيئا % % غير ترك السجود للمخلوق % % 4(@)(@@) % لم يكن بالسجود يأمر ربي % % إنهم يسجدون للمخلوق % % 14(@)(@@) % ظاهر عندهم بهم وهو عنهم % % باطن غائب بغير زوال % % 15(@)(@@) % فهو من حيث ذاته في خفاء % % وهو من حيث وصفه في تلالي % % 16(@)(@@) % واتصال لهم به حيث عنه % % وجدوا ثم هم به في انفصال % % PageV01P1242 البحر : - 1(@)(@@) % إن ترم أن تعرف الأحوال % % والذي فيه أنا في الحال % % 2(@)(@@) % والذي أشهده مني % % دائما في الحل والترحال % % 3(@)(@@) % والذي نفسي تحدثني % % فيه بالإكثار والإقلال % % 4(@)(@@) % أنا ذاتي والصفات كذا % % سائر الأقوال والأفعال % % 5(@)(@@) % وهو الله قد تجلى بفعل % % صادر عنه ظاهر بالحقوق % % 6(@)(@@) % فاعل ما يشاء بالشخص منه % % وهو فان مثل الخيال الطروق % % 7(@)(@@) % حاش لله أمر ربي بكفر % % وسجود لغير رب الشروق % % PageV01P1243 البحر 
ms272	 : - 1(@)(@@) % كن أنت سابق عليهم لا تكن مسبوق % % وكلهم خلق هذا الصادق المصدوق % % 2(@)(@@) % وقل إذا رمت إن ترفع إلى العيوق % % أما الجميع هو الخالق أو المخلوق % % 5(@)(@@) % من عبادات وعصيان % % ومباحات لها أحلال % % 6(@)(@@) % واعتقادات مؤكدة % % والذي يخطر لي في البال % % PageV01P1244 البحر : - 1(@)(@@) % يا أيها البارق الذي برقا % % إني أنا أنت حيث كان لقا % % 2(@)(@@) % فإن قلب المحب قال له % % هذا هو الخالق الذي خلقا % % 3(@)(@@) % لا غيره من جميع ما وجدت % % كما البرايا السوالك الطرقا % % 4(@)(@@) % فاجمع من الحسن ما تراه وما % % يدركه العقل كيفما اتفقا % % 5(@)(@@) % وقل هو الله لا سواه ولا % % تقل سواه لطارق طرقا % % 6(@)(@@) % والكل فان وماله أبدا % % عين مع الحق باطل زهقا % % 7(@)(@@) % فإن هذا عقد الفتى وبه % % يلقى غدا ربه إذا صدقا % % 7(@)(@@) % من علوم الدين والدنيا % % في بكور العمر والآصال % % 8(@)(@@) % واشتغال الفكر ملتهيا % % والخطا والسهو والاغفال % % 9(@)(@@) % كل هذا دائما أبدا % % هو في الماضي وفي استقبال % % PageV01P1245 10(@)(@@) % خلق ربي لي فينسب في % % رؤيتي للخالق الفعال % % 11(@)(@@) % تارة عندي فأشهده % % فعل ربي ما به إشكال % % 12(@)(@@) % فأراه كله مننا % % من إلهي وهو لي إقبال % % 13(@)(@@) % وهو إحسان إلي به % % وهو للإكرام والإجلال % % PageV01P1246 البحر : - 1(@)(@@) % كلانا له هذا الوجود المحقق % % هو الأحد الفرد الذي هو مطلق % % 2(@)(@@) % فطورا هو الباري بدا حيث لا سوى % % وطورا لنا يبدو سواه ويخلق % % 3(@)(@@) % فرب ولا عبد إذا العبد لم يكن % % وعبد ولا رب به الغيب ملحق % % 4(@)(@@) % وليس هما باثنين ندريهما معا % % كما عند ذي جهل بذلك ينطق % % 5(@)(@@) % فإن الذي تلقى هو الرب وحده % % له الذات والأسناء وهو المحقق % % 6(@)(@@) % وأنت السعيد المسلم المؤمن الذي % % لك الدين يا هذا وأنت الموفق % % 7(@)(@@) % وأما هو العبد الذي عنه غائب % % به ربه ينقى له أو يصدق % % 8(@)(@@) % وذلك حال الغافلين أولى الشقا % % وليس لهم عهد يدوم وموثق % % 9(@)(@@) % تبارك مولى واحد وعبيده % % كثيرون والمولى الكثير المفرق % % 10(@)(@@) % كما قال لن تحصوه في كلماته % % فتاب عليكم فاقرأوا 
ms273	 ما يحقق % % PageV01P1247 14(@)(@@) % فالذي من قسم طاعات % % محض إنهام بلا إهمال % % 15(@)(@@) % والمباح في القلب يقلبه % % طاعة بالقصد للإكمال % % 16(@)(@@) % والذي من قسم معصية % % بدلته توبة استعجال % % 17(@)(@@) % وهو بالطاعات منقلب % % حسنا من أحسن الأعمال % % 18(@)(@@) % ثم إني كل ذاك أرى % % أنه فعلى على استقلال % % 19(@)(@@) % وهو منسوب إلى كما % % جاء في التكليف باسترسال % % 20(@)(@@) % طبق ما التشريع جاء به % % عن رسول الله ذي الأفضال % % 21(@)(@@) % وهو مني كله شكر % % وثناء ما به إخلال % % 22(@)(@@) % للإله الحق خالقنا % % منحجح المصود والآمال % % 23(@)(@@) % وإذا فعل تكون له % % نسبتان الأمر فيه مجال % % PageV01P1248 البحر : - 1(@)(@@) % الباطن السابق الظاهر هو المسبوق % % والكل واحد فكن أعلى من العيوق % % 2(@)(@@) % واخرجعن الكل أنت الكل يا معتوق % % أما الجميع هو الخالق أو المخلوق % % 24(@)(@@) % سائغ لا شرع يمنعه % % لا ولا للعقل فيه عقال % % 25(@)(@@) % نسبة لله جل كذا % % نسبة للعبد كيف يقال % % PageV01P1249 البحر : - 1(@)(@@) % انفي الحوادث ولا تنفي الوجود الحق % % وجود ما قد ظهر منها لها أورق % % 2(@)(@@) % فإنها عدم من بعضها تشتق % % فيه الوجود كتبها أحرفا في رق % % 26(@)(@@) % وحقيقيان أمرهما % % لا مجاز ذا ولبس محال % % 27(@)(@@) % فأنا ما بين رؤية ذا % % فرط أنعام من المفضال % % PageV01P1250 البحر : - 1(@)(@@) % كان فرعون قاصدا تحقيقه % % بالدعاوى فزندقته الحقيقة % % 2(@)(@@) % ثم لما طغى فقال لقوم % % إنني ربكم يضل فريقه % % 3(@)(@@) % ولكم ما علمت غيري إلها % % ونسي سالف العهود الوثيقة % % 4(@)(@@) % فأطاعوه في المقال بجهل % % ورأى كل جمعهم تصديقه % % 5(@)(@@) % أرسل الله بالشريعة موسى % % وأخاه هارون معه شقيقه % % 6(@)(@@) % ينكران الضلال منه بجمع % % لم يضف مع حضوره تفريقه % % 7(@)(@@) % قال قولا له على القرب مكرا % % منه حتى في البحر ذاق غريقه % % 8(@)(@@) % قال آمنت طامعا في حياة % % مثل موسى فلم يجد تعويقه % % 28(@)(@@) % وأراه تارة مني % % شكر ربي الخالق المتعال % % 29(@)(@@) % هذه في الله حالتنا % % فاسمعوا يا أيها العذال % % PageV01P1251 30(@)(@@) % قد ذكرناها لرؤيتنا % % إنها تخفي على الجهال % % 31(@)(@@) % فيظنون الطريق إلى % % علم غيب الله محض مقال % % 32(@)(@@) % أو بفكر ذاك يحصل 
ms274	 أو % % بتعاني ذكره المتوال % % 33(@)(@@) % إنما بالله جل إذا % % لازم التقوى بلا إهمال % % 34(@)(@@) % واقتف آثار من سلفوا % % مع دوام الصدق والإقبال % % PageV01P1252 البحر : - 1(@)(@@) % لله في كل ما يبديه تعليل % % والخلق تكثيره في الأمر تقليل % % 2(@)(@@) % صح الجواب لقوم يسألون وما % % صح الجواب لأن الفعل توكيل % % 3(@)(@@) % في كل شيء له سر الوكالة إذا % % لم يخرج الشيء عنه فهو تأصيل % % 4(@)(@@) % وإن ردتمأ جوابا واحدا فقفوا % % هنا فماهذه قيل التماثيل % % 5(@)(@@) % معنى يراد ومعنى لا يراد سرت % % حقائق الكل فيما فيه تكميل % % 9(@)(@@) % ولقد كان عارفا بالتجلي % % فيه لكن دهاه قطع الرقيقه % % 10(@)(@@) % حيث أضحى ينفي السوى منه للعي % % ن على غرة بنفس رشيقه % % 11(@)(@@) % ثم لما تدارك الأمر كشفا % % وجد الحق باعثا توفيقه % % 12(@)(@@) % وهو من قبل ذائق ليس يخفى % % عنه في جانب الإله دقيقه % % 13(@)(@@) % غير حكم السوى به فرأى المو % % ت الطبيعي يقتضي ترقيقه % % PageV01P1253 البحر : - 1(@)(@@) % كعبة الحسن أسفرت بالجمال % % وتبدت لصاحب الأحوال % % 2(@)(@@) % ولها مقلة من الحجر % % الأسود ترنو ببهجة ودلال % % 3(@)(@@) % ريقها زمزم يمج بعذب % % سائع للمتيمين زلال % % 4(@)(@@) % وحطيم محبها بغرام % % صب ميزابه بفرط جلال % % 5(@)(@@) % نظرتها عيونها بعيون % % العاشق الواله البعيد المجال % % 6(@)(@@) % وإذا كنت عابدا فهي سلمى % % لبست ثوب هيبة وكمال % % 7(@)(@@) % وأشارت إلى الطواف بوجه % % يفضح البدر بالسنا والتلالي % % 8(@)(@@) % ويرى الزاهد المجرد بيتا % % ملأته مهابة الأفضال % % 14(@)(@@) % فأحست بقطعها النفس منه % % عن إله تعودت تعليقه % % 15(@)(@@) % آية الإنشقاق قد نبهته % % فأصاب الهدى بنفس مفيقه % % PageV01P1254 16(@)(@@) % ورأى وسع رحمة الله حتى % % جاءها مسلما فلم ير ضيقه % % 17(@)(@@) % ولقد صار آية لأناس % % بعده في شريعة وحقيقه % % 18(@)(@@) % جاء موسى إليه بالشرع يدعو % % منكر للحقيقة الزنديقة % % 19(@)(@@) % وأراد الإله اطلاع موسى % % أن في الباطن العلوم الأنيقه % % 20(@)(@@) % وابتلاه فلم يطق صحبة الخض % % ر وقد كان في المسير رفيقه % % 21(@)(@@) % فغدا منكرا عليه إلى أن % % نال تغريبه وذا تشريقه % % PageV01P1255 البحر : - 1(@)(@@) % اطلب العلم كالذباب إذا ما % % طردوه يعود في كل حال % % 2(@)(@@) % واشتغل بالمطالعات 
ms275	 لما في % % كتب العلم أنت طول الليالي % % 3(@)(@@) % وإذا أشكلت عليك أمور % % سل خبير أو لا تقف في السؤال % % 4(@)(@@) % وإذا لم تجد خبيرا فدعها % % لوجود الخبير ذي الأفضال % % 5(@)(@@) % إن هذا هو السعادة أما % % غير هذا فمحض قيل وقال % % 22(@)(@@) % ومشى الناس في شريعة موسى % % ليس يدرون غيرها في الخليقه % % 23(@)(@@) % وعليها قد جاءت الرسل حتى % % كان عيسى وأمه الصديقه % % 24(@)(@@) % فأراهم حقائقا جهلوها % % وعليه الحمار أبدى نهيقه % % 25(@)(@@) % ثم هموا بقتله فوقاه الله % % بالرفع مشهدا لن يطيقه % % 26(@)(@@) % ثم إن الإله أرسل بالجم % % ع وبالرفق نفس حر شفيقه % % PageV01P1256 البحر : - 1(@)(@@) % آلة الشكر هذه الأموال % % تترقى بها النسا والرجال % % 2(@)(@@) % فاجمعوها لتنفقوها على من % % تنفقوها عليه وهي حلال % % 3(@)(@@) % واقصدوا وجه ربكم لتنالوا % % كل خير وليس منكم سؤال % % 4(@)(@@) % درهم تنفقونه فيه ينمو % % وبه يدفع الردى والضلال % % 5(@)(@@) % وبه الله عنك راض إذا كا % % ن حلالا تنال مالا ينال % % 27(@)(@@) % فدعا الناس ظاهرا ودعاهم % % باطنا فهو مسجد وحديقه % % 28(@)(@@) % سيد المرسلين قد ود موسى % % لو رأى منه طيب تلك السليقه % % 29(@)(@@) % وسيدعو لشرعه الناس عيسى % % ثم في قبره يكون لصيقه % % 30(@)(@@) % هكذا الأمر جاء صلى عليهم % % ربنا ما نفى الجديد عتيقه % % PageV01P1257 البحر : - 1(@)(@@) % إن روحي بك روح مطلقه % % علقت من حين كانت علقه % % 2(@)(@@) % نطفة من أكل أدم وغذا % % ركبت من أربع متفقه % % 3(@)(@@) % من تراب ثم ماء وهوا % % ثم نار رتب مفترقه % % 4(@)(@@) % ظهرت عن كل جسم وهو عز % % ألف الغيب الهيولى اللبقه % % 5(@)(@@) % والهيولى عن صفات ظهرت % % وهي عن ذات بكل محدقه % % 6(@)(@@) % فهي روح آخر الأمر كما % % أول الكل غدت مستبقه % % 6(@)(@@) % واحذر حذر أن تقتفي كرما في % % غير شكر الإله فهو بال % % 7(@)(@@) % أو بمال محرم فهو إثم % % وخصوصا فيما عساه يقال % % 8(@)(@@) % إنما الشكر فرض عين علينا % % وهو منا الأقوال والأفعال % % 9(@)(@@) % كل ما كان طاعة فهو شكر % % والمعاصي كفران مالا يزال % % PageV01P1258 10(@)(@@) % من تناويع نعمة الله ما لم % % تحص فالله محسن مفضال % % PageV01P1259 البحر 
ms276	 : - 1(@)(@@) % ألا فتحقق إن كل استقامة % % بغير اعوجاج ما عليها معول % % 2(@)(@@) % فإن اعوجاج القوس لاشك إنه % % استقامته عن تلك لا يتحول % % 3(@)(@@) % وما مقصدي بالاعوجاج سوى الذي % % يراه بساهي عينه المتقول % % 4(@)(@@) % أعد نظرا في الصالحين ولا تكن % % بمنكر ما يأتون فهو المؤول % % 5(@)(@@) % فإن عليهم عين حفظ قديمة % % من الله عما قد نهى يا مسول % % 7(@)(@@) % حملت للكل والكل لها % % حامل كالعين ذات الحدقه % % 8(@)(@@) % ولها الكل لباس فمتى % % عرفت نالت يقينا وثقه % % 9(@)(@@) % وتدلت وتدانت شرفا % % من جنان عاليات عبقه % % 10(@)(@@) % ومقامات وأنواع على % % ما على شيء هنا منطبقه % % 11(@)(@@) % ومتى ما جهلت حلت لظى % % وغدت في جهلها محترقه % % PageV01P1260 البحر : - 1(@)(@@) % عم صباحا أيها الطلل % % رسم أمر كله جلل % % 2(@)(@@) % أمر مولى عنه قد ظهرت % % كل روح ما بها خلل % % 3(@)(@@) % وهو شأن الحق يسفر عن % % نشأة بالنقص تكتمل % % 4(@)(@@) % كل يوم قال خالقنا % % هو في شأن ولا ملل % % 5(@)(@@) % يا عظيم الخطب أنت لها % % لا يملك القصد والأمل % % 12(@)(@@) % وهي في أنواع ذل وأذى % % وهي في دنيا وأخرى قلقه % % 13(@)(@@) % فافهم الأول والآخر لا % % تجهل الرزاق والمرتزقه % % 14(@)(@@) % واعرف الرزق وحققه به % % إنه الحق وكن معتنقه % % 15(@)(@@) % ذا وجود نازل في رتب % % بأمانات لها أو سرقه % % PageV01P1261 البحر : - 1(@)(@@) % إنما رزقك الذي حزته في % % يدك اقنع به بنفس مفيقه % % 2(@)(@@) % وتأمل في رزق غيرك تلقا % % ه خيالا لديك ليس حقيقه % % 3(@)(@@) % لا تكن فيه مطالعا مثل كلب % % ممسك عظمة بفيه رقيقه % % 4(@)(@@) % فرأى ظلها بماء فألقا % % ها لأخذ التي رأى في الطريقه % % 6(@)(@@) % جامع للكل منفرد % % ما سيأتي فيك والأول % % 7(@)(@@) % وعليكم جاء أنفسكم % % فاستمعها أيها البطل % % 8(@)(@@) % وتأمل من سواك ومن % % هو أنت الكل قد بطلوا % % 9(@)(@@) % ثم إن الغيب عنك بقى % % ماله عما به حول % % PageV01P1262 البحر : - 1(@)(@@) % انظر إلى الكون وهو في عدم % % واطلب له الخالق الذي خلقه % % PageV01P1263 البحر : - 1(@)(@@) % ليس إلا مظاهر ومجالي % % فاتركونا نجل بهذا المجال % % 2(@)(@@) % تجد هناك الوجود منفردا % % به تعالى 
ms277	 مقال أهل ثقه % % 2(@)(@@) % ما مع الله في الوجود سواه % % إنما نحن فرضه للمحال % % 3(@)(@@) % وتعرف الكل لا وجود لهم % % إلا به والعقول متفقه % % 3(@)(@@) % من قديم أحبنا فأحببناه % % والحب مثبت في الخيال % % 4(@)(@@) % فإن معنى به الظهور له % % بهم شئون تلوح مفترقه % % 4(@)(@@) % صورا تختفي وتظهر طورا % % في محل بين الحبيبن خالي % % 5(@)(@@) % فافهموا يا عقول معنى كلامي % % وترقوا به لأوج المعاني % % 5(@)(@@) % وكل يوم أي لمحة هو في % % شأن عليه الشئون منطبقه % % 6(@)(@@) % إنما الحق للجميع محب % % فتراه مصور الأمثال % % PageV01P1264 6(@)(@@) % واحذر تراهم وذا الوجود لهم % % وهم به والفهوم مستبقه % % 7(@)(@@) % وبعد هذا تروم خالقهم % % تطلبه أن تجده يا نبقه % % 7(@)(@@) % لكن الحب منه لا منك من % % هو عنه في غفلة واشتغال % % 8(@)(@@) % تكن جهولا به تخيله % % كما تخيلتهم لتسترقه % % 8(@)(@@) % أسرته لضعفه شهوات % % من حرام لذيذة وحلال % % 9(@)(@@) % هيهات هيهات أن تفوز به % % وأنت واه ولم تزل علقه % % 9(@)(@@) % فلو انزاح فيه عن كل شيء % % لرآه عليه في إقبال % % 10(@)(@@) % تستأهل القرع بالعصي علي % % تركك تعظيمه وبالفلقه % % 10(@)(@@) % ثق بمولاك واشتغل في رضاه % % وتحقق واترك جميع الموالي % % 11(@)(@@) % إنما الكل فتنة لك فاعلم % % أنه ذو الإكرام والإجلال % % PageV01P1265 البحر : - 1(@)(@@) % غير الوجود محال % % عليه أنت محال % % 2(@)(@@) % فافطن له وتأمل % % فالعقل فيه عقال % % 3(@)(@@) % هو الهدى للبرايايا واحدا وكثيرا بماعليه يحال % وما سواه ضلالسقط بيت ص % % 4(@)(@@) % من كل تقدير شيء % % في العلم منه مثال % % 5(@)(@@) % قدرتنا من قديم % % فنحن شيء محال % % 6(@)(@@) % فرضتنا فظهرنا % % بك العراض الطوال % % 7(@)(@@) % وأنت أنت وجود % % ونحن نحن خيال % % 8(@)(@@) % أستغفر الله إن % % الخيال شيء يخال % % 9(@)(@@) % بل نحن لا شيء لكنلأجل تقريب قوم في العقل منهم خبال % هذا كلام يقالسقط بيت ص % % 10(@)(@@) % قد اعتنوا بالمعاني % % وهم سراب وآل % % PageV01P1266 11(@)(@@) % فحاولوا الحق فيها % % وليس فيها ينال % % PageV01P1267 البحر : - 1(@)(@@) % يا للبرية إن قلبي ما ارتوى % % 2(@)(@@) % من معي لازال يظهر بالقوى % % 3(@)(@@) % وأنا الذي أشكو المحبة والجوى % % 4(@)(@@) % وأمر ما لاقيت من 
ms278	 ألم النوى % % قرب الحبيب وما إليه وصول % % 5(@)(@@) % يدنو فأحسب أنه أنى وما % % 6(@)(@@) % هو غير قرب والجهول له العمى % % 7(@)(@@) % فاعجب لنور فيه كوني أظلما % % 8(@)(@@) % كالعيس في البيداء يقتلها الظما % % والماء فوق ظهورها محمول % % PageV01P1268 البحر : - 1(@)(@@) % دع من يجادل أو يماطل % % واعلم بأن الكل باطل % % 2(@)(@@) % والحق حق واحد % % وبه غبار الكون ساطل % % 3(@)(@@) % يا من يعدده ولا % % يدريه خاطي أنت خاطل % % 4(@)(@@) % يا غافلون تنكبوا % % عنا فغيث الفتح هاطل % % 5(@)(@@) % هذا الذي لا تعرفو % % ن لو جريتم في القساطل % % 6(@)(@@) % وقفوا بأرض عقولكم % % إن الذي تدرون عاطل % % 7(@)(@@) % ما حظكم غير السوى % % منه وما فزتم بناطل % % 8(@)(@@) % الله أكبر هذه % % ذكرى لأفئدة العواطل % % PageV01P1269 البحر : - 1(@)(@@) % ظهر الوجود الحق في مرءآتنا % % إذ نحن في العدم المقدر لم نزل % % 2(@)(@@) % فوجودنا هو صورة لوجوده % % لا أنه ذاك الوجود علا وجل % % 3(@)(@@) % وكذا ظهرنا نحن في مرءآته % % مع أننا عدم ومنه على وجل % % 4(@)(@@) % وهو المقدر بالصفات ذواتنا % % وصفاتنا من غير بدء في الأزل % % 5(@)(@@) % فظهروه فينا بقول قل انظروا % % ماذا الذي هو في السما والأرض هل % % 6(@)(@@) % وكذاك وهو الله قال بأنه % % هو في السما والأرض من يجحده زل % % 7(@)(@@) % مع أننا نحن العوالم كلها % % موجودة فافهم وفصل ما انجمل % % 8(@)(@@) % واحذر تظن تغير وتبدلا % % في ربنا عما عليه فما انتقل % % 9(@)(@@) % وكذلك احذر أن تظن بأننا % % عما عليه لنا التغير والبدل % % 10(@)(@@) % فإذا رآنا فهو راء نفسه % % لا أننا هو أو بنا حاشاه حل % % PageV01P1270 11(@)(@@) % وإذا رأيناه فأنفسنا نرى % % لا غير فاكشف عن سنا هذا المحل % % 12(@)(@@) % هذا هو العرفان وهو أجل ما % % يأتي به بشر وحققه الأمل % % 13(@)(@@) % أرث النبي محمد وهو الذي % % جاءت به ساداتنا القوم الأول % % PageV01P1271 البحر : - 1(@)(@@) % إنما وحدة الوجود لدينا % % وحدة الحق فافهموا ما تقول % % 2(@)(@@) % وحدة الله وحدة لا سواها % % شهدتها منا الكبار الفحول % % 3(@)(@@) % وسواء قلنا الوجود أو الحق % ق فلا فرق عندنا يا جهول % % 4(@)(@@) % لا تظن الوجود حيث ذكرنا 
ms279	 % % ه هو الخلق عندنا المبذول % % 5(@)(@@) % هو حق بعد الفنا عن سواه % % يتجلى فتضمحل العقول % % 6(@)(@@) % ولهدا كان الفنا هو شرطا % % عندنا للمزيد فيه حلول % % 7(@)(@@) % وهو طهر الأرواح من نجس قد % % حل فيها من الكثيف يجول % % 8(@)(@@) % لطخ الروح حين خالطها إذ % % جهلته وغاب عنها القبول % % 9(@)(@@) % واعتراها أيضا هنا حدث من % % كل معنى به الحجى مشغول % % 10(@)(@@) % فالنجاسات ما نعات المصلى % % وكذاك الأحداث حين تحول % % PageV01P1272 11(@)(@@) % بين ربي وبينه فارفعوها % % بعلوم السما يكون الوصول % % PageV01P1273 البحر : - 1(@)(@@) % أقبل ودع عنك الكسل % % وكن الذباب على العسل % % 2(@)(@@) % وإذا طردت فعد إلى % % ما كنت تطلبه وسل % % 3(@)(@@) % واعلم بأنك قاتل % % فالنصل في طول الأسل % % 4(@)(@@) % والحب يخرج مثله % % والبزر أشجارا نسل % % 5(@)(@@) % ومتى تركت تركت لا % % طهر الإناء ولا انغسل % % PageV01P1274 البحر : - 1(@)(@@) % إياك إياك ربك تفهمو بالعقل % % فإن ذا فيك نابت مثل نبت البقل % % 2(@)(@@) % وأنت والعقل فاني والذي في الحقل % % وأعده في الغيب واتبع ما أتى في النقل % % PageV01P1275 البحر : - 1(@)(@@) % رفعت ولم أرفع إلى غير منزلي % % من الغيب أمر الحسن المتفضل % % 2(@)(@@) % وقد زج بي في النور نور وجوده % % فأصبحت معدوما بغير تحول % % 3(@)(@@) % وجود قديم نحن فيه هياكل % % بغير وجود هيئة المتخيل % % 4(@)(@@) % تعالوا بنا يا تائهون لعلنا % % نكون كما كنا بترك التعلل % % 5(@)(@@) % ونسلم عن كشف إليه أمورنا % % فليس لكم أمر يكون وليس لي % % 6(@)(@@) % ونشهد أمر الله فينا كأنه % % بنا لمع برق في دجى الكون ينجلي % % 7(@)(@@) % وما البرق إلا نحن إذ نحن أمره % % هو القدر المقدور في الذكر قد تلى % % 8(@)(@@) % ولا تبعدوا عني بأحوال غفلة % % دهنكم فأصبحتم بعاد التأمل % % 9(@)(@@) % وجار عليكم حب دنيا دنية % % وليس عليها عندنا من معول % % 10(@)(@@) % قفوا في حمى الإيمان لا تتحولوا % % إلى غيره بالعقل قصد التوصل % % PageV01P1276 11(@)(@@) % ودوموا على الطاعات خالصة عسى % % بكم يرد الساقي إلى عذب منهل % % 12(@)(@@) % هنالك نور الكشف إن شاء ربنا % % وإلا فأنتم في مقام مؤمل % % 13(@)(@@) % مقام أولي الإيمان بالغيب فاسبقوا % % إليه ولا تصغوا 
ms280	 إلى قول عذل % % PageV01P1277 البحر : - 1(@)(@@) % إن أحبابنا وهم سادة الحي % % 2(@)(@@) % هجر وابعد وصلهم مغر ماعي % % 3(@)(@@) % وعلى البعد مذلوي ركبهم لي % % 4(@)(@@) % لمعت نارهم وقد عسعس % % الليل ومل الحادي وتاه الدليل % % 5(@)(@@) % هي بي يا محبهم نحوهم هي % % 6(@)(@@) % لا تموه بزينب لا ولامي % % 7(@)(@@) % نارهم في الحشى بدت وكوت كي % % 8(@)(@@) % فتأملها وفكري من البين % % عليل ولحظ عيني كليل % % 9(@)(@@) % جن عقلي بهم إذا الليل جنا % % 10(@)(@@) % والحشى كلما تذكر حنا % % PageV01P1278 11(@)(@@) % ليت شعري كيف السلو وأنى % % 12(@)(@@) % وفؤادي هو الفؤاد المعنى % % وغرامي ذاك الغرام الدخيل % % 13(@)(@@) % لذلي في هوى المليحة سلبي % % 14(@)(@@) % وكشف الحجاب عن عين قلبي % % 15(@)(@@) % لا تلمني قضيت يا صاح نحبي % % 16(@)(@@) % ثم قابلتها وقلت لصحبي % % هذه النار نار ليلى فميلوا % % 17(@)(@@) % أنا من أجلها أحب المليحا % % 18(@)(@@) % وفؤادي يهوى القوام الرجيحا % % 19(@)(@@) % ضج وميق وحاولوا الترجيحا % % 20(@)(@@) % فرموا نحوها لحاظا صحيحا % % ت فعادت خواسئا وهي حول % % PageV01P1279 21(@)(@@) % ليتهم أقصروا بها ما استطالوا % % 22(@)(@@) % وبايمانهم على القرب ألوا % % 23(@)(@@) % قصدوها فخابت الآمال % % 24(@)(@@) % ثم مالوا إلى الملام وقالوا % % خلب ما رأيت أم تخييل % % 25(@)(@@) % هل أتدري وعلم حالي لديها % % 26(@)(@@) % ويح أهل الملام لاموا عليها % % 27(@)(@@) % ثم لي موهوا بها تمويها % % 28(@)(@@) % فتجنبتهم وملت إليها % % والهوى مركبي وشوقي الزميل % % 29(@)(@@) % صار ختمي في حب علوة بدءا % % 30(@)(@@) % وتقربت مسمعا بل ومرأى % % PageV01P1280 31(@)(@@) % ثم إني دنوت والغير ينأى % % 32(@)(@@) % ومعي صاحب أتى يقتفي الآ % % ثاروا الحب شرطه التطفيل % % 33(@)(@@) % قد شربنا في حبها خمرة الدن % % 34(@)(@@) % وعلينا الساقي المليح بها من % % 35(@)(@@) % ثم جئنا والقلب من شوقه جن % % 36(@)(@@) % وهي تعلو ونحن ندنو إلى أن % % حجزت بينها طلول حلول % % 37(@)(@@) % منية القلب بالجمال تعالت % % 38(@)(@@) % وإليها ملنا نهيم فمالت % % 39(@)(@@) % وقصدنا طلولها حين طالت % % 40(@)(@@) % فدنونا من الطلول فحالت % % زفرات من دونها وغليل % % PageV01P1281 41(@)(@@) % قد تناءت ديارها وطريح % % 42(@)(@@) % أنا والجفن بالدموع قريح % % 43(@)(@@) % ثم مذ جئت والغرام صحيح % % 44(@)(@@) % قلت من بالديار قالوا جريح 