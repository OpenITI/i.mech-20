ms110	 كلبك المكلب وإن قتل ، وإن أرسلت كلبك الذي ليس بمكلب وأدركت ذكاته فكل ، وكل ما رد عليك سهمك وإن قتل وسم الله ) )(@)(@@) ( حم ق 3 ) عن أبي ثعلبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 979 ) قال النبي :(@)(@@) | 30 ( إذا أرسلت كلبك فاذكر اسم الله ، فإن أمسك عليك فأدركته حيا فاذبحه ، فإن أدركته قد قتله ولم يأكل منه فكله ، وإن وجدت مع كلبك كلبا غيره قد قتل فلا تأكل ، فإنك لا تدري أيها قتله ، وإن رميت بسهمك فاذكر اسم الله ، فإن غاب عنك يوما فلم تجد فيه إلا أثر سهمك فكل إن شئت ، وإن وجدته غريقا في الماء فلا تأكل فإنك لا تدري الماء قتله أو سهمك ) )(@)(@@) ( م ن ) عن عدي بن حاتم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 980 ) قال النبي :(@)(@@) | 30 ( إذا أسأت فأحسن ) )(@)(@@) ( ك هب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 981 ) قال النبي :(@)(@@) | 30 ( إذا استأجر أحدكم أجيرا فليعلمه أجره ) )(@)(@@) ( قط ) في الأفراد عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 982 ) قال النبي :(@)(@@) | 30 ( إذا استأذن أحدكم ثلاثا فلم يؤذن له فليرجع ) )(@)(@@) ( مالك حم ق د ) عن أبي موسى وأبي سعيد معا ( طب والضياء ) عن جندب البجلي رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 983 ) قال النبي :(@)(@@) | 30 ( إذا استأذنت أحدكم امرأته إلى المسجد فلا يمنعها ) )(@)(@@) ( حم ق ن ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 984 ) قال النبي :(@)(@@) | 30 ( إذا استؤذن على الرجل وهو يصلي فاذنه التسبيح وإذا استؤذن على المرأة وهي تصلي فاذنها التصفيق ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 985 ) قال النبي :(@)(@@) | 30 ( إذا استجمر أحدكم فليوتر ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 986 ) قال النبي :(@)(@@) | 30 ( إذا استشار أحدكم أخاه فليشر عليه ) )(@)(@@) ( ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 987 ) قال النبي :(@)(@@) | 30 ( إذا استشاط السلطان تسلط الشيطان ) )(@)(@@) ( حم طب ) عن عطية السعدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 988 ) قال النبي :(@)(@@) | 30 ( إذا استطاب أحدكم فلا يستطب بيمينه ليستنج بشماله ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 989 ) قال النبي :(@)(@@) | 30 ( إذا استعطرت المرأة 
ms111	 فمرت على القوم ليجدوا ريحها فهي زانية ) )(@)(@@)(@@)(@@) $ ( 3 ) عن أبي موسى رضي الله عنه .(@)(@@)(@@)(@@) $ ( 990 ) قال النبي :(@)(@@) | 30 ( إذا استفتح أحدكم فليرفع يديه وليستقبل بباطنهما القبلة فإن الله أمامه ) )(@)(@@) ( طس ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 991 ) قال النبي :(@)(@@) | 30 ( إذا استقبلت القبلة فكبر ثم اقرأ بام القرآن ، ثم اقرأ PageV01P160 بما شئت ، فاذا ركعت فاجعل راحتيك على ركبتيك وامدد ظهرك ومكن لركوعك ، فاذا رفعت رأسك فأقم صلبك حتى ترجع العظام إلى مفاصلها ، فاذا سجدت فمكن سجودك ، فاذا جلست فاجلس على فخذك اليسرى ، ثم اصنع كذالك في كل ركعة وسجدة ) )(@)(@@) ( حم حب ) عن رفاعة بن رافع الزرقي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 992 ) قال النبي :(@)(@@) | 30 ( إذا استقبلتك المرأتان فلا تمر بينهما خذ يمنة أو يسرة ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 993 ) قال النبي :(@)(@@) | 30 ( إذا استقر أهل الجنة في الجنة اشتاق الإخوان بعضهم إلى بعض فيسير سرير ذا إلى سرير ذا ، وسرير ذا إلى سرير ذا حتى يلتقيا ، فيتكىء ذا ويتكىء ذا فيتحدثان ما كان بينهما في دار الدنيا ، فيقول : يا أخي تذكر يوم كذا في دار الدنيا في مجلس كذا فدعونا الله عز وجل فغفر لنا ) )(@)(@@) ( أبو الشيخ في العظمة حل ) والبيهقي في البعث عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 994 ) قال النبي :(@)(@@) | 30 ( إذا استقرت النطفة في الرحم أربعين يوما وأربعين ليلة بعث إليها ملك فيقول : يا رب أذكر أم أنثى ؟ فيعلم ، فيقرأ : يا رب أشقي أم سعيد ؟ فيعلم ) )(@)(@@) ( حم ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 995 ) قال النبي :(@)(@@) | 30 ( إذا استكتم فاستاكوا عرضا ) )(@)(@@) ( ص ) عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 996 ) قال النبي :(@)(@@) | 30 ( إذا استلج أحدكم في اليمين فإنه آثم له عند الله من الكفارة التي أمر بها ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 997 ) قال النبي :(@)(@@) | 30 ( إذا استلقى أحدكم على قفاه فلا يضع إحدى رجليه على الأخرى ) )(@)(@@) ( ت ) عن البراء ( حم ) عن جابر ( البزار ) عن ابن عباس رضي الله عنهم .(@)(@@) PageV01P161(@)(@@)(@@)(@@) $ ( 998 ) قال النبي :(@)(@@) | 30 ( إذا 
ms112	 استنشقت فاستنثر ، وإذا استجمرت فأوتر ) )(@)(@@) ( طب ) عن سل مة بن قيس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 999 ) قال النبي :(@)(@@) | 30 ( إذا استوحشت الإنسية وتمنعت فإنه يحلها ما يحل الوحشية ) )(@)(@@) ( هق ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1000 ) قال النبي :(@)(@@) | 30 ( إذا استهل الصبي صلي عليه وورث ) )(@)(@@) ( ت ن ه حب ك هق ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1001 ) قال النبي :(@)(@@) | 30 ( إذا استهل المولود ورث ) )(@)(@@) ( د هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1002 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم فليقل : الحمد لله الذي رد علي روحي وعافاني في جسدي وأذن لي بذكره ) )(@)(@@) ( ابن السنى ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1003 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم من منامه فتوضأ فليستنثر ثلاث مرات فإن الشيطان يبيت على خياشيمه ) )(@)(@@) ( ق ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1004 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم من منامه لا يدخل يده في الإناء حتى يغسلها فإنه لا يدري أين باتت يده منه ويسمي قبل أن يدخلها ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1005 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم من نومه فرأى بللا ولم ير أنه احتلم اغتسل ، وإذا رأى أنه قد احتلم ولم ير بللا فلا غسل عليه ) )(@)(@@) ( عد ه ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1006 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم من نومه فلا يدخل يده الإناء حتى يغسلها ) )(@)(@@) ( ه ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@) PageV01P162(@)(@@)(@@)(@@) $ ( 1007 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم من نومه فلا يدخل يده في الإناء حتى يغسلها ثلاثا فإن أحدكم لا يدري أين باتت يده ) )(@)(@@) ( مالك والشافعي حم ق 4 ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1008 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ الرجل من الليل وأيقظ أهله وصليا ركعتين كتبا من الذاكرين الله كثيرا والذاكرات ) )(@)(@@) ( د ن ه حب ك ) عن أبي هريرة وأبي سعيد رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 1009 ) قال النبي :(@)(@@) | 30 ( إذا استيقط الرجل من منامه فقال : سبحان الذي 
ms113	 يحييى ويميت وهو على كل شيء قدير ، قال الله تعالى : صدق عبدي وشكر ) )(@)(@@) ( الخرائطي ) في مكارم الأخلاق عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1010 ) قال النبي :(@)(@@) | 30 ( إذا استيقظت فصل ) )(@)(@@) ( حم د حب ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1011 ) قال النبي :(@)(@@) | 30 ( إذا أسلفت في شيء فلا تصرفه إلى غيره ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1012 ) قال النبي :(@)(@@) | 30 ( إذا أسلم الرجل فهو أحق بأرضه وماله ) )(@)(@@) ( حم ) عن صخر بن عيلة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1013 ) قال النبي :(@)(@@) | 30 ( إذا أسلم العبد فحسن إسلامه كتب الله له كل حسنة كان أسلفها ، ومحيت عنه كل سيئة كان أزلفها ، ثم كان بعد ذالك القصاص الحسنة بعشر أمثالها إلى سبعمائة ضعف ، والسيئة بمثلها إلا أن يتجاوز الله عنها ) )(@)(@@) ( مالك ن هب ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1014 ) قال النبي :(@)(@@) | 30 ( إذا أسلم العبد فحسن إسلامه يكفر الله عنه كل سيئة PageV01P163 كان زلفها ، وكان بعد ذلك القصاص الحسنة بعشر أمثالها إلى سبعمائة ضعف ، والسيئة بمثلها إلا أن يتجاوز الله عنها ) )(@)(@@) ( خ ن ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1015 ) قال النبي :(@)(@@) | 30 ( إذا أشار الرجل على أخيه بالسلاح فهما على جرف جهنم ، فاذا قتله وقعا فيه جميعا ) )(@)(@@) ( الطيالسي ن ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1016 ) قال النبي :(@)(@@) | 30 ( إذا اشتد الحر فأبردوا بالصلاة فإن شدة الحر من فيح جهنم ) )(@)(@@) ( حم ق 3 ) عن أبي هريرة ( حم ق د ت ) عن أبي ذر ( ق ) عن ابن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 1017 ) قال النبي :(@)(@@) | 30 ( إذا اشتد الحر فأبردوا بالظهر فإن شدة الحر من فيح جهنم ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1018 ) قال النبي :(@)(@@) | 30 ( إذا اشتد الحر فاستعينوا بالحجامة ، لا يتبيغ الدم بأحدكم فيقتله ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1019 ) قال النبي :(@)(@@) | 30 ( إذا اشتد كلب الجوع فعليك برغيف وجر من ماء القراح وقل على الدنيا وأهلها مني الدمار ) )(@)(@@) ( عد هب ) عن 
ms114	 أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1020 ) قال النبي :(@)(@@) | 30 ( إذا اشترى أحدكم الجارية فليقل : اللهم إني أسألك خيرها وخير ما جبلتها عليه ، وأعوذ بك من شرها وشر ما جبلتها عليه وليدع بالبركة ، وإذا اشترى أحدكم بعيرا فليأخذ بذروة سنامه وليدع بالبركة وليقل مثل ذالك ) )(@)(@@) ( ه ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1021 ) قال النبي :(@)(@@) | 30 ( إذا اشترى أحدكم الجارية فليكن أول ما يطعمها الحلو فإنه أطيب لنفسها ) )(@)(@@) ( ه ) عن معاذ رضي الله عنه .(@)(@@) PageV01P164(@)(@@)(@@)(@@) $ ( 1022 ) قال النبي :(@)(@@) | 30 ( إذا اشترى أحدكم بعيرا فليأخذ بذروة سنامه ، وليتعوذ بالله من الشيطان ) )(@)(@@) ( د ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1023 ) قال النبي :(@)(@@) | 30 ( إذا اشترى أحدكم لحما فليكثر مرقته ، فإن لم يصب أحدكم لحما أصاب مرقا وهو أحد اللحمين ) )(@)(@@) ( ت ك هب ) عن عبد الله المزني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1024 ) قال النبي :(@)(@@) | 30 ( إذا اشتريت مبيعا فلا تبعه حتى تقبضه ) )(@)(@@) ( حم ن حب ) عن حكيم بم حزام رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1025 ) قال النبي :(@)(@@) | 30 ( إذا اشتريت نعلا فاستجدها ، وإذا اشتريت ثوبا فاستجده ) )(@)(@@) ( طس ) عن أبي هريرة وعن ابن عمر رضي الله عنهم بزيادة : ( وإذا اشتريت دابة فاستفرهها ، وإن كانت عندك كريمة قوم فأكرمها ) .(@)(@@)(@@)(@@) $ ( 1026 ) قال النبي :(@)(@@) | 30 ( إذا اشتكى العبد المسلم قال الله تعالى للذين يكتبون : اكتبوا له أفضل ما كان يعمل إذا كان طلقا حتى أطلقه ) )(@)(@@) ( حل ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1027 ) قال النبي :(@)(@@) | 30 ( إذا اشتكى المؤمن أخلصه من الذنوب كما يخلص الكير خبث الحديد ) )(@)(@@) ( خد حب طس ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1028 ) قال النبي :(@)(@@) | 30 ( إذا اشتكى عينيه وهو محرم ضمدهما بالصبر ) )(@)(@@) ( م ) عن عثمان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1029 ) قال النبي :(@)(@@) | 30 ( إذا اشتكيت فضع يدك حيث تشتكي ثم قل : بسم الله أعوذ بعزة الله وقدرته من شر ما أجد من وجعي هاذا ثم ارفع يدك ثم أعد ذالك وترا ) )(@)(@@) ( ت ك ) عن أنس رضي الله عنه .(@)(@@) PageV01P165(@)(@@