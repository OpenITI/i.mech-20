ms261	 بازوی فتح ناصر دین %~% که هرچه تیغش بگرفت خامه‌اش بخشید(@)(@@) 24 هنوز مهر رخش بود در حجاب عدم %~% که ‌همچو صبح ز شوقش ‌وجود جامه درید(@)(@@) 25 شها تویی‌ که‌ گه حشر مست برخیزد %~% ز جام تیغ تو هر کاو شراب مرگ چشید(@)(@@) 26 تویی ‌که‌ کان هنر راست خامه تو گهر %~% تویی‌که قفل ظفر راست خنجر تو کلید(@)(@@) 27 سر سنان تو ضرغام مرگ را ناخن %~% زه‌ کمان تو بازوی فتح را تعوید(@)(@@) 28 کلف‌ گرفت چو رخسار ماه پنجه مهر %~% ز رشک روی ‌تو از بسکه پشت دست‌‌ گزید(@)(@@) 29 وجود حاصل چندین هزار ساله فروخت %~% بهای آن مه یک روزه طاعت تو خرید(@)(@@) 30 مگرکه‌گیتی غارست و تو رسول‌ که چرخ %~% به ‌گرد گیتی چون عنکبوت تار تنید(@)(@@) 31 مگر شراره تیغ تو دید روز مصاف %~% که آتش از فزع او به صلب خاره خزید(@)(@@) 32 مشام غالیه و مغز مشک یافت ز کام %~% نسیم خلق تو تا بر دماغ دهر وزید(@)(@@) 33 ز ننگ آنکه ‌کمانت نمود پشت به خصم %~% خم کمند تو بر خود چو مار می‌پیچید(@)(@@) 34 چو دید منتقم قهرت آن‌ کژی ز کمان %~% فکند زه به‌ گلوی و دو گوش او مالید(@)(@@) 35 چه وقت طایر تیر تو پر گشاد ز هم %~% که نسر چرخ چو بسمل میان خون نطپید(@)(@@) 36 به مهد عهد تو آن لحظه خفت کودک امن %~% که شیر فتح ز پستان ناوک تو مکید(@)(@@) 37 هماره تاکه در آفاق هست پست و بلد %~% همیشه تا که در ایام هست زشت و پلید(@)(@@) 38 چو دهر درکنف دولتت بیارامد %~% هر آن‌ کسی‌ که چو دولت ز دشن تو رمید PageV1P167(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بهار آمدکه ازگلبن همی بانگ هزار آید %~% به هر ساعت خروش مرغ زار از مرغزار آید(@)(@@) 2 تو گویی ارغنون بستند بر هر شاخ و هر برگی %~% ز بس بانگ تذرو و صلصل و دراج و سار 
ms262	 آید(@)(@@) 3 بجو‌شد مغز جان ‌چون ‌بوی ‌گل ‌از گلستان خیزد %~% بپرد مرغ دل چون بانگ مرغ از شاخسار آید(@)(@@) 4 خروش عندلیب و صوت سار و ناله ی قمری %~% گهی ازگل گهی از سروبن گه از چنار آید(@)(@@) 5 تو گویی ساحت بستان بهشت عدن را ماند %~% ز بس غلمان و حور آنجا قطار اندر قطار آید(@)(@@) 6 یکی‌گیرد به‌کف لاله‌که ترکیب قدح دارد %~% یکی برگل ‌کند تحسین ‌کزو بوی نگار آ‌ید(@)(@@) 7 کی با دلبر ساده به طرف بوستان ‌گردد %~% یکی با ساغر باده به طرف جویبار آید(@)(@@) 8 یکی بیند چمن را بی‌تأمل مرحبا گوید %~% یکی بوید سمن را مات صنع‌کردگار آید(@)(@@) 9 یکی بر لاله پاکوبد که هی‌هی رنگ می‌دارد %~% یکی از گل به وجد آید که بخ‌بخ بوی یار آید(@)(@@) 10 یکی بر سبزه می‌غلطد یکی بر لاله می‌رقصد %~% یکی ‌گاهی رود از هش یکی‌ گه هوشیار آید(@)(@@) 11 ز هر سوتی نواش ارغنون و چگ و نی آید %~% ز هرکویی صدای بربط و طنبور و تار آید(@)(@@) 12 کی آنجا نوازد نی یکی آنجاگسارد می %~% صدای های و هوی و هی ز هر سو صدهزار آید(@)(@@) 13 به هر جا جشنی و جوشی به هر گامی قدح نوشی %~% نماند غالبا هوشی چو فصل نوبهار آید(@)(@@) 14 مگر در سنبلستان ماه من ژولیده‌گیسو را %~% که از سنبل به مغزم بوی جان بی‌اختیار آید(@)(@@) 15 الا یا ساقیا می ده به جان من پیاپی ده %~% دمادم هی خور و هی ده که می‌ترسم خمار آید(@)(@@) 16 سیه شد از ریا روزم بده آب ریا سوزم %~% به جانت گر دوصد خرمن ریا یک جو به کار آید(@)(@@) 17 نمی‌دانی‌کنار سبزه چون لذت دهد باده %~% خصوص آن دم‌ که از گلزار باد مشکبار آید(@)(@@) 18 به حق باده‌ خوارانی‌ که می نوشد با خوبان %~% که بی‌خوبان به‌کامم آب‌کوثر ناگوار آید(@)(@@) 19 شراب تلخ می‌خواهم به شیرینی‌که از شورش 
ms263	 %~% خرد دیوانه‌ گردد کوه و صحرا بی‌قرار آید(@)(@@) 20 دلم بر دشت شوخی شاهدی شنگی که همچو او %~% نه ماهی از ختن خیزد نه ترکی از حصار آید(@)(@@) 21 چو باد آن زلف تاریکش به رخسارش بشوراند %~% پی تاراج چین‌گویی سپاه زنگبار آید(@)(@@) 22 دمی‌ کز هم‌گشایم حلقهای زلف مشکینش %~% به مغزم‌ کاروان در کاروان مشک تتار آید(@)(@@) 23 به جان اوکه هرگه‌کاکل وگیسوی او بینم %~% جهان ‌گویی به چشم من پر از افعی و مار آید(@)(@@) 24 چو بو‌سم لعل شیرینش لبم هندوستان‌ گردد %~% چو بینم روی رنگینش دو چشمم قندهار آید(@)(@@) 25 نظر از بوستان بندم اگر او چهره بگشاید %~% کنار از دوستان‌گیرم‌گرم او درکنار آید(@)(@@) 26 کنار خویش را پر عقرب جراره می‌بینم %~% دمی ‌کاندر کنارم با دو زلف تا بدار آید(@)(@@) 27 نگاهم چون همی‌غلطد ز روی او به‌موی او %~% به چشمم عالم هستی پر از دود و شرار آید(@)(@@) 28 و خط و زلف و مژه و ابرو وگیسویش %~% جهان‌تاریک‌در چشمم‌چو یک‌مشت‌غبار آید(@)(@@) 29 چه‌رمزست ‌این نمید‌‌انم‌ که چون ‌زلف و رخش بینم %~% به چشمم هر دوگیتی ‌گاه روشن‌گاه تار آید(@)(@@) 30 رخش اهواز را ماند کزو کژدم همی خیزد %~% دمی‌کان زلف پر چینش به روی آبدار آید(@)(@@) 31 کشد موی میانش روز و شب‌کوه‌گران‌گویی %~% مرا ماند که با این لاغری بس بردبار آید(@)(@@) 32 لب قاآنی از وصف لبش بنگاله را ماند %~% کزو هردم نبات و قند و شکر باربار آید(@)(@@) 33 الا یا سرو سیمینا ببین آن باده و مینا %~% که گویی از که سینا تجلی آشکار آید(@)(@@) 34 مرا گویی که تحسین‌ کن چو سرتاپای من بینی %~% تو سر تا پای تحسینی تو را تحسین چه کار آید(@)(@@) 35 بجو‌شد مغز من‌ هرگه ‌که ‌گویی فخر خوبانم %~% تو خلاق نکویانی ترا زین فخر عار آید(@)(@@) 36 ‌گلت‌خوانم‌ مهت دانم نه هیچت وصف نتوانم %~% که حیرانم نمی‌دانم چه وصفت سازگار آید(@)(@@) 37 تو 
ms264	 چون ‌در خانه ‌آیی خانه رشک بوستان ‌گردد %~% اگر فصل خزان در بوستان آیی بهار آید(@)(@@) 38 غریبی‌کز تو برگردد به شهر خویش می‌نالد %~% که پندارد به غربت از بر خویش‌ و تبار آید(@)(@@) 39 چرا باید کشیدن منت نقاش و صورتگر %~% تو در هر خانه‌کآیی خانه پر نقش‌ا و نگار آید(@)(@@) 40 نگارا صبح نوروزست‌ و روز بوسه‌ات امروز %~% که در اسلام این سنت به هر عیدی شعار آید(@)(@@) 41 به یادت‌هست ‌در مستی ‌دو مه ‌زین‌ پیش‌ می‌گفتم %~% که چون نوروز آید نوبت بوس وکنار آید(@)(@@) 42 تو شکر خنده‌ می‌کردی‌ و نیک‌ آهسته می‌گفتی %~% بود نوروز من روزی که صاحب‌اختیار آید(@)(@@) 43 حسین‌خان‌ میر ملک‌جم‌ که ‌چون در بزم بنشیند %~% نصیب اهل‌گیتی از یمین او یسار آید(@)(@@) 44 به‌گاه‌کینه‌گر تنها نشیند از بر توسن %~% بد اندیشش چنان داند که یک دنیا سوار آید(@)(@@) 45 به‌گاه خشم مژگانهای او در چشم بدخواهان %~% چو تیر تهمتن در دیده اسفندیار آید(@)(@@) 46 چو از دست زرافشانش نگارد خامه‌ام وصفی %~% ورق اندر در و دیوان شعرم زرنگار آید(@)(@@) 47 حکیمی ‌گفته هر کس خون خورد لاغر شود اکنون %~% یقینم ‌شد که ‌شمشیرش ‌ز خون‌خو‌ردن ‌نزار آید(@)(@@) 48 به روز رزم او در گوش اهل مشرق و مغرب %~% به هر جانب که رو آرند بانگ زینهار آید(@)(@@) 49 ز شوق آنکه بر مردم‌ کف رادش ببخشاید %~% زر از کان سیم از معدن در از قعر بحار آید(@)(@@) 50 به‌روز واقعه‌زالماس ‌تیغش‌بسکه خون جوشد %~% توگویی پهنه‌گیتی همه یاقوت زار آید(@)(@@) 51 محاسب گفت ‌روزی ‌بشمرم‌ جودش‌ ولی ترسم %~% ز خجلت برنیارد سر اگر روز شمار آید(@)(@@) 52 گه ‌کین با کف زربخش چون بر رخش بنشیند %~% بدان ماند که ابری بر فراز کوهسار آید(@)(@@) 53 حصاری نیست ملک آفرینش را مگر حزمش %~% چه غم جیش فا راکاندران محکم حصار آید(@)(@@) 54 فلک قد را ملک صد را بهار آید به هر سالی %~% به 
