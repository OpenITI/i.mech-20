ms1725	 بن عيسى، وروى عنه أبو عبد الله.(@)(@@) التهذيب: ج 10، ح 793 (الاستبصار:(@)(@@) ج 4، ح 1047).(@)(@@) * وروى عن حماد اللحام، وروى عنه أحمد بن محمد.(@)(@@) الروضة: ح 358.(@)(@@) * وروى عن داود بن أبي يزيد، وروى عنه أحمد بن محمد.(@)(@@) الروضة: ح 428.(@)(@@) * وروى عن داود بن سليمان الحمار، وروى عنه أحمد بن محمد.(@)(@@) الروضة: ح 520.(@)(@@) * وروى عن داود الرقي، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 6، ك 6، ب 59، ح 2.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 9، ح 204 (الاستبصار:(@)(@@) ج 4، ح 291، وفيه داود بن كثير الرقي).(@)(@@) * وروى عن درست، وروى عنه علي ابن محمد بن يحيى الخزاز الكوفي.(@)(@@) التهذيب: ج 8، ح 895 (الاستبصار، ج 4، ح 64).(@)(@@) * وروى عن درست الواسطي، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 97، ح 8.(@)(@@) * وروى عن ربعي بن عبد الله وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 41، ح 3.(@)(@@) * وروى عن رفاعة، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 3، ك 1، ب 18، ح 8، والكافي:(@)(@@) ج 4، ك 3، ب 38، ح 16. التهذيب: ج 1، ح 1067.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 4، ح 668 (الاستبصار:(@)(@@) ج 2، 318، وفيه أحمد بن محمد فقط)، والتهذيب: ج 5، ح 31 (الاستبصار:(@)(@@) ج 2، ح 463). PageV06P315(@)(@@) * وروى عن رفاعة بن موسى، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 4، ك 2، ب 55، ح 10.(@)(@@) * وروى عن زرارة، وروى عنه معلى ابن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 84، ح 8.(@)(@@) * وروى عن زكريا المؤمن، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 5، ك 3، ب 190، ح 46.(@)(@@) * وروى عن سوادة، وروى عنه أحمد ابن محمد.(@)(@@) الكافي: ج 4، ك 3، ب 184، ح 3.(@)(@@) والتهذيب: ج 5، ح 702 (الاستبصار:(@)(@@) ج 2، ح 947).(@)(@@) * وروى عن سيف بن عميرة، وروى عنه أبو عبد الله الرازي.(@)(@@) التهذيب: ج 6، ح 1044 (الاستبصار:(@)(@@) ج 3، ح 217).(@)(@@) وروى عنه محمد بن علي.(@)(@@) الكافي: ج 4، ك 1، ب 38، ح 4.(@)(@@) * وروى عن صالح بن أبي الأسود، وروى عنه محمد بن الحسين.(@)(@@) الكافي: ج 4، ك 3، ب 165، ح 6.(@)(@@) * وروى عن صفوان، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الروضة: ح 374.(@)(@@) وروى عنه صالح 
ms1726	 بن أبي حماد.(@)(@@) الكافي: ج 2، ك 1، ب 68، ح 30.(@)(@@) * وروى عن صفوان بن يحيى، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 4، ح 772 (الاستبصار:(@)(@@) ج 2، ح 285).(@)(@@) وروى عنه علي بن مهزيار.(@)(@@) التهذيب: ج 3، ح 584.(@)(@@) * وروى عن ظريف، وروى عنه أحمد بن محمد.(@)(@@) التهذيب: ج 10، ح 1138.(@)(@@) * وروى عن عاصم بن حميد، وروى عنه معلى بن محمد.(@)(@@) الكافي: ج 2، ك 1، ب 121، ح 14.(@)(@@) * وروى عن العباس بن عامر، وروى عنه أبو علي الأشعري.(@)(@@) الكافي: ج 6، ك 1، ب 31، ح 4.(@)(@@) والتهذيب: ج 8، ح 352 (الاستبصار:(@)(@@) ج 3، ح 1138).(@)(@@) وروى عنه محمد بن أحمد بن يحيى.(@)(@@) التهذيب: ج 5، ح 758 (الاستبصار:(@)(@@) ج 2، ح 967)، والتهذيب: ج 7، ح 229 (الاستبصار: ج 3، ح 269).(@)(@@) وروى عنه محمد بن علي بن محبوب. PageV06P316(@)(@@) التهذيب: ج 2، ح 1384.(@)(@@) * وروى عن العباس بن معروف، وروى عنه سعد بن عبد الله.(@)(@@) التهذيب: ج 5، ح 1069 (الاستبصار:(@)(@@) ج 2، ح 617). * وروى عن عبد الحميد الطائي، وروى عنه محمد بن علي ين محبوب.(@)(@@) التهذيب: ج 7، ح 1458 (الاستبصار:(@)(@@) ج 3، ح 804).(@)(@@) * وروى عن عبد السلام بن سالم، وروى عنه محمد بن عبد الله بن غالب.(@)(@@) التهذيب: ج 4، ح 465.(@)(@@) * وروى عن عبد الصمد بن بشير، وروى عنه أحمد بن محمد بن عيسى.(@)(@@) الكافي: ج 6، ك 6، ب 64، ح 1.(@)(@@) والتهذيب: ج 9، ح 436.(@)(@@) * وروى عن عبد الكريم، وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 7، ك 4، ب 20، ح 14.(@)(@@) * وروى عن عبد الله بن إبراهيم، وروى عنه بكر بن صالح.(@)(@@) الكافي: ج 2، ك 1، ب 49، ح 12، وب 52، ح 7، وب 83، ح 4.(@)(@@) * وروى عن عبد الله بن بكير، وروى عنه أحمد بن الحسن بن علي.(@)(@@) التهذيب: ج 7، ح 1330، 1868 (الاستبصار: ج 3، ح 826).(@)(@@) وروى عنه أحمد بن محمد.(@)(@@) الكافي: ج 5، ك 3، ب 73، ح 1، والكافي:(@)(@@) ج 7، ك 1، ب 5، ح 4، والتهذيب: ج 7، ح 1489.(@)(@@) وروى عنه أحمد بن محمد بن عيسى.(@)(@@) التهذيب: ج 7، ح 1271.(@)(@@) وروى عنه الحسين بن سعيد.(@)(@@) التهذيب: ج 9، ح 791 (الاستبصار:(@)(@@) ج 4، ح 476).(@)(@@) وروى عنه محمد بن الحسن بن علي.(@)(@@) التهذب: ج 7، ح 1330، 1868، (الاستبصار: ج 3، ح 826).(@)(@@) وروى عنه محمد بن زرارة. 
