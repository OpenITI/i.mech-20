ms1161	 عنه، روى عنه نضر بن عبد الله 4.(@)(@@)(@@)(@@) $ 2674 - عمرو بن مساور - أو ابن مسور - عن الشعبي عن 5 قرظة قال عمر رضى الله عنه: من مات محرى 5، قال عمرو بن على حدثنا ابن PageV06P371(@)(@@) سواء 1 حدثنا روح بن القاسم.(@)(@@)(@@)(@@) $ 2675 - عمرو بن مصعب بن الزبير القرشي الأسدي سمع عروة بن الزبير 2 - (@)(@@) قاله موسى بن اسمعيل عن سعيد بن زيد وأبي هلال، أرى 3 أخا جعفر، وروى سعد بن زياد 4 وعبد الله التوأم 5 وروح 6 عن عمر بن مصعب.(@)(@@)(@@)(@@) $ 2676 - عمرو بن مرزوق الواشحي البصري، سمع يحيى بن عبد الحميد بن رافع 7، سمع منه موسى بن اسمعيل ومسلم بن ابراهيم. PageV06P372(@)(@@)(@@)(@@) $ 2677 - عمرو بن مرزوق أبو عثمان مولى باهلة بن مضر البصري، سمع عمران القطان وشعبة 1، مات سنة أربع وعشرين ومائتين.(@)(@@)(@@)(@@) $ 2678 - عمرو بن مهاجر أخو محمد بن مهاجر مولى أسماء بنت يزيد الأنصاري الدمشقي وكان على شرطة عمر بن عبد العزيز 2، قال يحيى بن بكير: مات سنة تسع وثلاثين ومائة وسنه أربع وتسعون 3.(@)(@@)(@@)(@@) $ 2679 - عمرو بن مجمع أبو المنذر السكوني الكوفي الكندي، سمع هشام بن عروة 4، سمع منه عبد الله بن سعيد الأشج وزكريا بن عدي وأحمد ومحمد بن عتبة السدوسي، قال احمد بن سليمان حدثنا عمرو: PageV06P373(@)(@@) حدثنا يونس بن خباب عن سالم بن أبي الجعد عن أبي كبشة رضي الله عنه عن النبي صلى الله عليه وسلم: 1 ثلاث لك بعد موته 1 صدقة وعلم وذرية ... 2(@)(@@)(@@)(@@) $ 2680 - عمرو بن محمد أبو سعيد القرشي العنقزي 3 مولاهم كوفي، قال إسحاق بن نصر: مات سنة تسع وتسعين ومائة، سمع الثوري وإسرائيل، روى عنه ابنه القاسم، والعنقز 4 شئ ينسب إليه PageV06P374(@)(@@) والعنقز يقال له: المرزنجوش، علي نا القاسم بن عمرو: ثنا أبي نا خلاد 1 الصفار عن عمرو بن قيس عن عمرو بن مرة عن مصعب بن سعد عن أبيه: قالوا: يا رسول الله! لو قصصت علينا - فذكره.(@)(@@)(@@)(@@) $ 2681 - عمرو بن محمد بن أبي رزين أبو عثمان مولى خزاعة، 
ms1162	 سمع شعبة وقطنا القطعي 2، نسبه عبدة بن عبد الله وعلي بن مسلم، سمع منه علي.(@)(@@)(@@)(@@) $ 2682 - عمرو بن محمد أبو عثمان الناقد بغدادي، سمع هشيما 3.(@)(@@)(@@)(@@) $ 2683 - عمرو بن مروان أبو العنبس النخعي الكوفي 4، سمع PageV06P375(@)(@@) شقيق بن سلمة وعن أبيه، روى عنه حفص ووكيع.(@)(@@)(@@)(@@) $ 2684 - عمرو بن منصور القيسي البصري 1، سمع شعبة وإسمعيل بن مسلم والدستوائي وأبا هلال، أراه أبا عثمان.(@)(@@)(@@)(@@) $ 2685 - عمرو بن منصور المشرقي الكوفي الهمداني، سمع الشعبي، روى عنه وكيع وعيسى بن يونس 2.(@)(@@)(@@)(@@) $ 2686 - عمرو بن أبي مغيث 3: قال عمر رضى الله عنه في الحد - قاله أبو ثابت حدثنا حاتم عن محمد بن أبي يحيى.(@)(@@)(@@)(@@) $ 2687 - عمرو بن مرثد أبو أسماء الرحبي، سمع ثوبان وشداد ابن أوس 4، سمع منه أبو قلابة، سماه بعض ولده.(@)(@@)(@@)(@@) ||| باب ن(@)(@@)(@@)(@@) $ 2688 - عمرو بن نافع 5.(@)(@@)(@@)(@@) $ 2689 - عمرو بن أبي نعيمة المعافري عن أبي عثمان، روى عنه PageV06P376(@)(@@) بكر بن عمرو المصري 1.(@)(@@)(@@)(@@) $ 2690 - عمرو بن نصر قوله - قاله حسن بن عمر عن جرير عن الحكم بن مسلمة السعدي 2.(@)(@@)(@@)(@@) ||| باب و(@)(@@)(@@)(@@) $ 2691 - عمرو بن وهب الثقفي، (@)(@@) قال مسدد حدثنا اسمعيل: سمع أيوب عن محمد بن سيرين عن عمرو بن وهب الثقفي: كنا عند المغيرة رضى الله عنه فقال: مسح النبي صلى الله عليه وسلم على الخفين، وروى بعضهم عن حماد بن زيد: عن أيوب عن محمد عن أبي عبد الله عن المغيرة رضي الله عنه عن النبي صلى الله عليه وسلم، وقال أبو نعيم حدثنا جرير بن حازم: عن ابن سيرين حدثنا عمرو بن وهب عن المغيرة رضي الله عنه عن النبي صلى الله عليه وسلم، وقال عبد الله بن عثمان أخبرنا ابن المبارك سمع عوفا وهشاما: عن محمد سمع عمرو بن وهب الثقفي سمع المغيرة رضي الله عنه ومات النبي 3 صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 2692 - عمرو بن وهب الطائفي، سمع غضيف بن ابى سفيان PageV06P377(@)(@@) ومحمد بن 1 عبد الله بن أبي أسيد 1، سمع منه أبو عاصم 2.(@)(@@)(@@)(@@) $ 2693 - عمرو بن وهب بن عثمان القرشي، سمع 
ms1163	 أباه وعن عبد الرحمن بن حصين، سمع منه يحيى بن حسان 3.(@)(@@)(@@)(@@) $ 2694 - عمرو بن الوليد بن عبدة 4 عن عبد الله بن عمرو، روى عنه يزيد بن أبي حبيب.(@)(@@)(@@)(@@) $ 2695 - عمرو بن أبي الوليد 5: ان عمر بن الخطاب رضى الله عنه - قاله سعيد بن أبي أيوب عن يزيد بن أبي حبيب.(@)(@@)(@@)(@@) $ 2696 - عمرو بن الوليد 6 سمع سالم بن عبد الله حدثني القاسم ابن محمد عن عبد الله بن الزبير عن عائشة رضى الله عنهم: أن النبي صلى الله عليه وسلم أخذ بيدها فقال: لولا حداثة قومك بالكفر لهدمت الكعبة فأدخلت الحجر فيها فإنه منها ولكن قومك أسلموا من بنائه 7 ولجعلت لها بابين وألصقتها بالأرض فإن قومك إنما رفعوا بابها PageV06P378(@)(@@) لا يدخلها 1 إلا من شاءوا 2 / ولأنفقت كنزها - قاله أحمد بن عاصم عن عبد الرحمن بن إبراهيم عن عمر بن عبد الواحد: عن الأوزاعي عن عمرو، وقال الوليد: عن الاوزاعي حدثنى عمرو الوليد حدثنا سالم بن عبد الله بن عمر حدثنا القاسم بن محمد بن أبي بكر: ان عبد الله ابن الزبير رضى الله عنهما اخبره عن عائشة رضي الله عنها عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 2697 - عمرو بن الوليد الأغضف عن ثور 3، روى عنه عبيد الله 4 القواريري ومعاذ بن معاذ، قال ابن معين: كان على قضاء فارس ما أرى به بأسا.(@)(@@)(@@)(@@) $ 2698 - عمرو بن واقد الهاشمي - أو الاموى الدمشقي 5، PageV06P379(@)(@@) منكر الحديث.(@)(@@)(@@)(@@) $ 2699 - عمرو بن واقد مولى قريش 1، منكر الحديث، الدمشقي، قال إسحاق عن محمد بن مبارك: مولى لآل أبي سفيان، قال أبو مسهر: ليس بشئ.(@)(@@)(@@)(@@) ||| [باب ه] 2(@)(@@)(@@)(@@) $ 2700 - عمرو بن هرم بن حيان الازدي، قال 3 على عن محمد ابن يزيد 3 عن أبي العلاء: عن قتادة: صليت عن عمرو بن هرم بعد ما دفن 4 حدثني به وقال: كان علي حدث به عن عبد الرزاق انا معمر: عن(@)(@@) قنادة حفظا ثم خرج بعد فقال: ليس هو كما حدثتكما إنما حدثنا محمد بن يزيد 
ms1164	 4، قال أبو نعيم: مات قتادة سنة سبع عشرة ومائة، عن جابر بن زيد، نسبه أبو عوانة عن أبي بشر 5، وقال سالم المرادى حدثنا عمرو بن PageV06P380(@)(@@) هرم الأزدي: عن ربعي وأبي عبد الله، حديثه عن البصريين.(@)(@@)(@@)(@@) $ 2701 - عمرو بن هانئ 1.(@)(@@)(@@)(@@) $ 2702 - عمرو بن هاشم أبو مالك الجنبي عن ابن إسحاق 2، فيه نظر.(@)(@@)(@@)(@@) $ 2703 - عمرو بن الهيثم 3 أبو قطن الزبيدي، سمع شعبة، روى عنه مخلد بن مالك وقتيبة، وقال محمد بن بشار: الهيثم بن قطن، وسمع المسعودي وأبا خلدة، حديثه في البصريين.(@)(@@)(@@)(@@) ||| ي(@)(@@)(@@)(@@) $ 2704 - عمرو بن يزيد بن هارون الأموي عن صهيب عن سفينة 4، قال عبد الله بن محمد عن بشر بن السري عن علي بن مبارك عن يحيى بن أبي كثير: عن عمرو، وقال عثمان بن عمر: عمرو بن هارون،(@)(@@) اراه ابن يزيد، قال ابن بشار: حدثنا هارون، علي حدثنا يحيى: حدثنى PageV06P381(@)(@@) يزيد بن هارون رجل من بني أمية عن صهيب.(@)(@@)(@@)(@@) $ 2705 - عمرو بن يحيى بن عمارة بن أبي حسن المازني الأنصاري المديني، سمع أباه ومحمد بن يحيى بن حيان 1، سمع منه يحيى بن سعيد الأنصاري ومالك بن أنس والثوري وابن عيينة ويحيى بن أبي كثير 2.(@)(@@)(@@)(@@) $ 2706 - عمرو بن يحيى بن قمطة - قال ابن عيينة: وكان من خيار أهل مكة -: شهدت إبراهيم بن هشام بعرفة يخطب فأطال فقام سالم فقال: الصلاة أيها الأمير! فلم يلتفت فقال: الصلاة! فقال: واعجبا لسالم ابن أم سالم! فقام عبد الله بن واقد فقال: أيها الأمير! أرفع فاك عن سالم فإن سالما ليس ممن يتهم على الإسلام.(@)(@@)(@@)(@@) $ 2707 - عمرو بن يحيى بن سعيد بن العاص الأموي، سمع جده سعيدا، أراه أبا أمية المكى، سمع منه موسى بن اسمعيل وأحمد ابن محمد المكي وابن عيينة.(@)(@@)(@@)(@@) $ 2708 - عمرو بن يحيى بن عمرو بن سلمة بن الحارث الهمداني الكوفي، سمع أباه، سمع منه سعيد بن سليمان 3، ويقال: الكندى. PageV06P382(@)(@@)(@@)(@@) $ 2709 - 1 عمرو بن يزيد أبو بردة </span>1 عن حماد وعلقمة بن مرثد، سماه سهل بن حماد، في الكوفيين.(@)(@@)(@@)(@@) $ 2710 
ms1165	 - عمرو بن أبي يوسف 2 أخو بنى نوفل، سمع معاوية، روى ابن جريج حدثنا ابن صيفي: سمع عمرا.(@)(@@)(@@)(@@) $ 2711 - عمرو بن يوسف مولى عثمان 3، سمع سعيد بن المسيب وأبا بكر بن عبد الرحمن وأبا بكر بن سليمان قولهم، قال أبو أسامة سمع عمر بن حمزة: سمع عمرا، حديثه في أهل المدينة.(@)(@@)(@@)(@@) ||| ومن أفناء الناس(@)(@@)(@@)(@@) $ 2712 - عمرو الفقيمي عن سعيد بن جبير قوله، روى عنه PageV06P383(@)(@@) ابناه فضيل والحسن الكوفي 1.(@)(@@)(@@)(@@) $ 2713 - عمرو </span>العنبري، روى عنه أبو بشر 2.(@)(@@)(@@)(@@) $ 2714 - عمرو الهذلي 3 عن عمر بن عبد العزيز، روى عنه ابنه عبد الله.(@)(@@)(@@)(@@) $ 2715 - عمرو القصير 4 عن إبراهيم النخعي، روى عنه محمد ابن إسحاق، مرسل.(@)(@@)(@@)(@@) $ 2716 - عمرو، روى عنه سهيل قوله 5.(@)(@@)(@@)(@@) $ 2717 - عمرو سمع عليا رضى الله عنه وعاتبه 6 في تخلفه عنه فلقي الحسن بن علي فقال: لا تحزن عليه فوالله لسمعته يقول يوم صفين أو يوم كذا وكذا: يا ليت أمي لم تلدني وليت إني مت قبل اليوم - قاله موسى بن اسمعيل عن صدقة أبي سهل 7 سمع زاذان قال: لقيت عمرا. PageV06P384(@)(@@)(@@)(@@) $ 2718 - عمرو الشامي 1، محمد بن يوسف حدثنا عبد الرحمن بن مهدي: حدثنا عكرمة بن عمار عن عمرو: حدثنى ابن عمي سمع محمد بن مسلمة رضي الله عنه قال لي النبي صلى الله عليه وسلم: أجلس في بيتك، وقال النضر: حدثنا عكرمة حدثنا عمرو الشامي عن ابن عم له.(@)(@@)(@@)(@@) || باب عيسى(@)(@@)(@@)(@@) $ 2719 - عيسى بن طلحة بن عبيد الله أبو محمد التيمي القرشي عن أبيه 2 وسمع ابن عمر وعبد الله بن عمرو، سمع منه الزهري وطلحة ابن يحيى، حديثه عن أهل المدينة.(@)(@@)(@@)(@@) $ 2720 - عيسى بن معقل بن أبي معقل وهو ابن أم معقل من أسد خزيمة حجازي عن جدته أم معقل، سمع منه موسى بن عقبة ومحمد ابن إسحاق.(@)(@@)(@@)(@@) $ 2721 - عيسى بن جارية الأنصاري، سمع سالم بن عبد الله 3 وعن جابر، روى عنه يعقوب القمي وعنبسة قاضي الري.(@)(@@)(@@)(@@) $ 2722 - / عيسى بن هلال (@)(@@) الصدفى المصرى، </span>روى عنه كعب PageV06P385(@)(@@) ابن علقمة، 
ms1166	 وقال عياش بن عباس: عن عيسى بن علي بن هلال الصدفي، سمع عبد الله 1.(@)(@@)(@@)(@@) $ 2723 - عيسى بن هلال عن كثير، روى عنه ابن حدير 2، وعن عبد الملك بن مروان.(@)(@@)(@@)(@@) $ 2724 - عيسى القرشي 3 والد الوليد 4 من آل عمار 4، قدم على عثمان رضى الله عنه، سمع منه ابنه 5 الوليد.(@)(@@)(@@)(@@) $ 2725 - عيسى بن فائد 6، قال ابن فضيل عن يزيد بن أبي زياد(@)(@@)(@@)(@@) $ : هو أمير الرقة، (@)(@@) مرسل.(@)(@@)(@@)(@@) $ 2726 - عيسى بن حطان الرقاشي عن مصعب بن سعد وعبد الله بن عمرو رضى الله عنهما 7، روى عنه محمد بن جحادة، نسبه حماد ابن سلمة عن على بن زيد. PageV06P386(@)(@@)(@@)(@@) $ 2727 - عيسى بن حطان العائذي 1 عن علي رضي الله عنه وريان ابن صبرة 2 ومسلم بن سلام، روى عنه عبد الملك بن مسلم.(@)(@@)(@@)(@@) $ 2728 - عيسى بن شعيب بن ثوبان مولى لبني الديل المديني، سمع السائب بن يزيد وفليحا، سمع منه الحزامي، إبراهيم بن المنذر 3 نا عيسى(@)(@@) ابن شعيب: رأيت السائب بن يزيد الهذلي يجلس على طنفسة كانت لأهله ورأيته يتكئ على عصا من ساس - يعني الألواح(@)(@@)(@@)(@@) $ 2729 - عيسى بن الفضل بن معقل بن سنان الأشجعي سمع عبد الله بن نيار الأسلمي عن خاله عمرو بن شاس - قاله إبراهيم بن المختار عن ابن إسحاق عن أبان بن صالح سمع عيسى.(@)(@@)(@@)(@@) $ 2730 - عيسى بن سيلان عن كعب، روى سعيد بن أبي أيوب عن عبد الله بن الوليد 4. PageV06P387(@)(@@)(@@)(@@) $ 2731 - عيسى بن خثيم الحنفي 1، سمع ابن عمر 2، روى عكرمة ابن عمار عن شعيب، وروى حاجب بن قدامة سمع عيسى بن خثيم الحنفي، وسمع وبرا 3 وعن قيس بن طلق، روى عنه يحيى بن ابى كثير، حديثه عن أهل اليمامة.(@)(@@)(@@)(@@) $ 2732 - عيسى البزاز مولى حذيفة بن اليمان رضى الله عنهما العبسي، سمع حذيفة، سمع منه يحيى الجابر 4.(@)(@@)(@@)(@@) $ 2733 - عيسى بن عتبة 5 عن خاله عبد الله بن بابيه، قال(@)(@@) أبو عاصم أخبرنا عمر بن سعيد: سمع عيسى سمع خاله: خرجت مع ابن عمر رضى الله عنهما في جنازة 
ms1167	 فسئل عن علي وعثمان رضى الله عنهما فدفعه ابن عمر وقال: سألتني عن رجلين كلاهما أراه أخير مني تريد أن أجرح أحدهما بعيب الآخر، ويقال عن عمر بن سعيد: عن عيسى بن عبيد سمع عبد الله بن بابية سمع ابن عمر رضى الله عنهما. PageV06P388(@)(@@)(@@)(@@) $ 2734 - عيسى بن سهل بن رافع بن خديج الأنصاري الحارثي: كنت في حجر جدي رافع، روى عنه سعيد بن يزيد أبو شجاع 1.(@)(@@)(@@)(@@) $ 2735 - عيسى بن عبد الله الأنصاري (@)(@@) </span>عن أبيه عن النبي صلى الله عليه وسلم، روى عنه عبيد الله العمري 2، يقال: ابن عبد الله بن أنيس 3.(@)(@@)(@@)(@@) $ 2736 - عيسى بن عبد الله الأنصاري 4 عن أبي طوالة عبد الله: أدركت فقهاءنا يقولون: ما اذهبه الحك من الدم فليس فيه شئ - قاله زكريا عن الحكم بن المبارك سمع الوليد بن مسلم عن عيسى ابن موسى.(@)(@@)(@@)(@@) $ 2737 - عيسى الزرقي الأنصاري عن خولة، روى عنه ابنه محمد، اراه ابن النعمان 5.(@)(@@)(@@)(@@) $ 2738 - عيسى بن عبد الله بن مالك 6، احسبه اخا محمد الدار، PageV06P389(@)(@@) روى عنه محمد بن إسحاق 1، سمع محمد بن عمرو بن عطاء عن عطية بن سفيان، وقال أبو بدر حدثني أبو خيثمة حدثنا الحسن بن الحر: حدثني عيسى بن عبد الله بن مالك عن محمد بن عمرو بن عطاء: عن عباس - أو عياش - بن سهل: أنه كان في مجلس فيه أبوه وأبو حميد وأبو هريرة رضي الله عنه في الصلاة -، وقال محمد 2 اخبرنا ابن المبارك أخبرنا فليح: سمعت عباس بن سهل فلم أحفظ فحدثني أراه قال عيسى بن عبد الله: أنه سمعه من عباس بن سهل: أنه حضر أبا حميد وأبا سعيد ورجل منهم في الصلاة.(@)(@@)(@@)(@@) $ 2739 - عيسى بن عبد الرحمن (@)(@@) بن أبي ليلى الأنصاري من بني عمرو بن عوف كوفي </span>عن أبيه 3، روى عنه اخوه محمد بن عبد الرحمن ابن أبي ليلى الكوفي.(@)(@@)(@@)(@@) $ 2740 - عيسى بن عبد الله الهاشمي 4، يوسف بن راشد حدثنا(@)(@@) عيسى بن عبد الله بن محمد بن عمر بن علي بن أبي طالب أبو 
ms1168	 بكر رضي الله عنهم: لقيته بالرى قال: أخبرني أبي عن أبيه عن جده عن على PageV06P390(@)(@@) رضى الله عنه: كان أحب الشاة إلى النبي صلى الله عليه وسلم الذراع.(@)(@@)(@@)(@@) $ 2741 - عيسى بن عبد الرحمن 1 عن الزهري، روى عنه 2 عمرو ابن ابى قيس 2، منكر الحديث، وروى ابن لهيعة عن عيسى بن عبد الرحمن الزرقي عن الزهري مقلوبا.(@)(@@)(@@)(@@) $ 2742 - عيسى بن عبد الرحمن السلمي 3، سمع أبا عمرو الشيباني والشعبي وأبا إسحاق 4، سمع منه أبو نعيم ومالك بن اسمعيل الكوفي، قال محمد بن يحيى حدثنا سالم بن قتيبة قال: ح عيسى بن عبد الرحمن البجلي حي من بني سليم.(@)(@@)(@@)(@@) $ 2743 - عيسى بن معاوية بن معبد بن كعب الانصاري، روى عنه معمر 5. PageV06P391(@)(@@)(@@)(@@) $ 2744 - عيسى بن يزداد عن أبيه، مرسل، روى عنه زمعة 1، لا يصح.(@)(@@)(@@)(@@) $ 2745 - عيسى بن موسى (@)(@@) بن محمد بن إياس بن البكير </span>2 عن صفوان بن سليم، روى عنه يحيى بن ايوب والليث، وروى يحيى بن بكير ح عبد الله بن سويد عن عياش بن عباس: عن عيسى بن موسى ابن محمد بن أبان 3 بن / البكير عن أسامة رضى الله عنه قال: سافرت PageV06P392(@)(@@) مع النبي صلى الله عليه وسلم ثمان عشرة غزوة، وقال الليث: حدثني عيسى عن صفوان بن سليم عن رجل من أشجع عن أبي هريرة رضي الله عنه عن النبي صلى الله عليه وسلم: إذا صلى فليتقدم إلى سترته، وقال ابن عنبسة: عن صفوان عن نافع بن جبير عن سهل بن أبي حثمة رضي الله عنه عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 2746 - عيسى بن موسى (@)(@@) </span>عن جندل، روى عنه ليث بن أبي سليم منقطعا.(@)(@@)(@@)(@@) $ 2747 - عيسى بن موسى أبو عاصم، عن السائب بن عمر 1 حدثني عيسى: عن محمد بن عباد بن جعفر قال ابن عباس رضى الله عنهما: أكرم الناس علي جليسي.(@)(@@)(@@)(@@) $ 2748 - عيسى بن موسى عن عطية، روى عنه عبيد الله 2.(@)(@@)(@@)(@@) $ 2749 - عيسى بن موسى أبو موسى سمع أبا حازم - قاله PageV06P393(@)(@@) 1 محمد بن أبي 
ms1169	 السري سمع الوليد 1 سمع عيسى.(@)(@@)(@@)(@@) $ 2750 - عيسى بن موسى أبو محمد القرشي عن اسمعيل بن عبد الله 2، روى عنه الوليد بن مسلم، وسمع يونس بن ميسرة.(@)(@@)(@@)(@@) $ 2751 - عيسى بن موسى أبو أحمد 3 مولى بخاري التيمي 3، سمع الثوري وأبا حمزة السكري، مات سنة ست 4 وثمانين ومائة، سمع منه يعقوب بن إسحاق الحضرمي قال: عيسى بن موسى الأزرق عن عبد الله بن كيسان.(@)(@@)(@@)(@@) $ 2752 - عيسى الأنصاري 5: سألت ابا سلمة، روى عنه زيد ابن أبي أنيسة.(@)(@@)(@@)(@@) $ 2753 - عيسى بن علي عن رافع بن بشر، قال أبو عاصم عن عبد الحميد بن جعفر: حدثني عيسى بن علي الانصاري، وقال اسحاق PageV06P394(@)(@@) حدثنا عثمان بن عمر عن عبد الحميد: عن محمد بن علي.(@)(@@)(@@)(@@) $ 2754 - عيسى بن معمر </span>عن عبد الله بن عمرو بن الفغواء، روى عنه محمد بن إسحاق.(@)(@@)(@@)(@@) $ 2755 - عيسى عن زيد بن أرطاة، روى عنه ليث 1.(@)(@@)(@@)(@@) $ 2756 - عيسى بن عاصم الأسدي، سمع زرا وعن عدي بن عدي 2، سمع منه سلمة بن كهيل، لقيه جرير بن حازم بأرمينية، وقال يحيى بن حسان حدثنا يحيى بن حمزة حدثنا ثور: أن عيسى بن عاصم حدثه: أن ابن عباس وابن عمر وعبد الله بن عياش رضى الله عنهم، مرسل، وقال ابن وهب عن معاوية بن صالح: عن عيسى بن عاصم عن زر عن أنس بن مالك رضي الله عنه عن النبي صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 2757 - عيسى بن سعيد أبو عمار عن علي بن يزيد الدمشقي، سمع منه سعيد بن أبي أيوب، ولم يصح حديثه.(@)(@@)(@@)(@@) $ 2758 - عيسى بن عثمان: رأى فاطمة بنت علي رضي الله عنهما - قاله عبد الله بن جعفر حدثنا عبيد الله عن عبد الكريم 3. PageV06P395(@)(@@)(@@)(@@) $ 2759 - عيسى بن المغيرة حجازي، سمع ابن أبي ذئب 1، سمع منه إبراهيم بن منذر، هو 1 ابن الضحاك بن عبد الله بن خالد بن حزام(@)(@@) ابن خويلد القرشي.(@)(@@)(@@)(@@) $ 2760 - عيسى بن المغيرة أبو شهاب الحرامي التميمي 3 عن الشعبي، روى عنه الثوري، يعد في الكوفيين.(@)(@@)(@@)(@@) $ 2761 - 4 عيسى 
ms1170	 بن عون بن حفص الفرافصة الحنفي 5 عن يحيى ابن سعيد وأبي بكر بن حزم مراسيل 5.(@)(@@)(@@)(@@) $ 2762 - عيسى بن سنان أبو سنان الشامي القسملي 6 عن الضحاك بن عبد الرحمن وعثمان بن أبي سودة ويعلى بن شداد، سمع عنه 7 PageV06P396(@)(@@) حماد بن سلمة وعيسى بن يونس، نسبه يونس بن يعقوب وقال: التيمي الحنفي.(@)(@@)(@@)(@@) $ 2763 - عيسى بن قيس السلمى، روى ابن المبارك عن هشيم 1(@)(@@) وأبو نعيم 2، في الكوفيين.(@)(@@)(@@)(@@) $ 2764 - عيسى بن دينار أبو علي مولى عمرو بن الحارث ابن المصطلق الخزاعي الأزدي الكوفي المؤذن، سمع أباه 3، سمع منه ابن المبارك.(@)(@@)(@@)(@@) $ 2765 - عيسى بن عمر الهمداني 4، سمع منه ابن المبارك ووكيع وأبو نعيم، هو المازني الاعمى، يقال عن جرير: عن ابن عمرو القارئ - هو عيسى بن عمر، سمع منه عمر بن يونس.(@)(@@)(@@)(@@) $ 2766 - عيسى بن عمر بن موسى بن عبيد الله بن معمر التيمى PageV06P397(@)(@@) القرشي: قلت لبديح 1، سمع منه حوثرة.(@)(@@)(@@)(@@) $ 2767 - عيسى بن أبي زيد المديني سمع ابن عمر رضى الله عنهما قوله - قاله أبو جمرة عن عطاء بن السائب.(@)(@@)(@@)(@@) $ 2768 - عيسى بن نميلة 2 عن أبيه، منقطع، روى عنه الدراوردي.(@)(@@)(@@)(@@) $ 2769 - عيسى بن يزيد 3، روى محمد عن عيسى بن سوادة 3(@)(@@) سمع عمرو بن دينار، مرسل.(@)(@@)(@@)(@@) $ 2770 - عيسى بن المطلب أبو هارون 4 الزهري، روى عنه ابن أبي فديك 4 في اهل المدينة. PageV06P398(@)(@@)(@@)(@@) $ 2771 - عيسى بن المنهال العبدي البصري، سمع 1 غالب ابن القطان 1، سمع منه موسى بن اسمعيل 2.(@)(@@)(@@)(@@) $ 2772 - عيسى بن كنانة عن محمد بن عمار المؤذن عن ابى هريرة رضى الله عنه فعله، روى عنه يحيى بن عمير 3.(@)(@@)(@@)(@@) $ 2773 - عيسى بن مسعود بن الحكم الزرقي الأنصاري المديني 4، قال محمد بن يحيى حدثنا سعيد بن أبي مريم أخبرنا الليث حدثني يزيد ابن أبي حبيب: عن عيسى بن مسعود بن الحكم: عن عمرو بن سليم عن أبي قتادة قال: لا بأس بسؤر الهر، وقال إبراهيم عن موسى بن عقبة: عن(@)(@@) عيسى بن مسعود الأنصاري: عن أبيه سمع عليا رضى الله 
ms1171	 عنه في الجنازة، وقال ابن المبارك عن موسى: عن اسمعيل بن مسعود، وقال ابن جريج عن موسى: عن قيس بن مسعود، وقال أبو مصعب عن موسى: عن يوسف بن مسعود. PageV06P399(@)(@@)(@@)(@@) $ 2774 - عيسى بن النعمان بن رفاعة بن رافع الزرقي الأنصاري 1، سمع منه زيد بن حباب ومحمد بن خوط 2، حديثه في أهل المدينة.(@)(@@)(@@)(@@) $ 2775 - عيسى بن عبيد أبو همام 3، سمع الحسن، سمع منه أبو نعيم قوله.(@)(@@)(@@)(@@) $ 2776 - عيسى بن عبيد الكندي المروي، سمع الربيع بن أنس وعكرمة وعبد الله بن بريدة، سمع منه موسى بن عيسى وعبدان ويحيى بن واضح 4، يقال: أبو المنيب.(@)(@@)(@@)(@@) $ 2777 - عيسى أبو الليث، سمع انسا رضى الله عنه قوله ورأى الحسن، سمع منه محمد بن عثمان مولى قريش 5 - (@)(@@) قاله محمد بن عقبة.(@)(@@)(@@)(@@) $ 2778 - عيسى بن قرطاس الأسدي عن أبي الجنوب 6 - (@)(@@) قاله PageV06P400(@)(@@) أبو نعيم، حدثنا عيسى: سمع عكرمة عن ابن عباس رضى الله عنهما عن النبي صلى الله عليه وسلم قال: إذا صليتم فارفعوا سبلكم 1.(@)(@@)(@@)(@@) $ 2779 - عيسى بن طهمان الكوفى، سمع انسا رضى الله عنه 2، سمع منه أبو نعيم وخلاد.(@)(@@)(@@)(@@) $ 2780 - عيسى بن ميمون وهو ابن داية صاحب ابن أبي نجيح 3 وقيس بن سعد، روى عنه الثوري وأبو عاصم، حجازي، قال ابن عيينة: كان قارئا للقرآن قرأ على ابن كثير، قال ابن معين: هو جرشي.(@)(@@)(@@)(@@) $ 2781 - عيسى بن ميمون المديني عن محمد بن كعب 4، منكر PageV06P401(@)(@@) الحديث، مولى القاسم بن محمد القرشي.(@)(@@)(@@)(@@) $ 2782 - عيسى بن يزيد (@)(@@) الليثي المديني </span>1 عن عبد الرحمن بن أبي زيد، سمع منه يعقوب بن ابراهيم بن سعد، يقال: هو ابن داب، قال الأويسي حدثنا سليمان عن عيسى بن يزيد: عن عمر بن أبي حفص عن ابن عباس رضى الله عنهما: انصرفت مع النبي صلى الله عليه وسلم ليلة - بحديث طويل، منكر.(@)(@@)(@@)(@@) $ 2783 - عيسى بن يزيد أبو معاذ الأزرق المروي عن مطرف وليث 2 وسفيان، سمع منه ابن المبارك وحكام وعيسى بن موسى.(@)(@@)(@@)(@@) $ 2784 - عيسى بن سليمان بن دينار أبو طيبة الدارمي 
ms1172	 الجرجاني، سمع جعفر بن محمد 3، مات سنة ثلاث وخمسين ومائة ومات ابنه PageV06P402(@)(@@) أحمد سنة ثلاث ومائتين.(@)(@@)(@@)(@@) $ 2785 - عيسى بن يزيد، سمع طاوسا، روى عنه محمد بن الوليد الزبيدي، في الشاميين 1.(@)(@@)(@@)(@@) $ 2786 - عيسى بن عقال البجلي عن أبيه، روى [عنه] 2 القاسم بن مالك، في الكوفيين.(@)(@@)(@@)(@@) $ 2787 - عيسى بن عثمان: سمعت [فاطمة] 2 بنت علي، روى عنه أرى زيد بن أبي أنيسة 3، منقطع.(@)(@@)(@@)(@@) $ 2788 - عيسى بن رستم أبو العلاء الأسدي الكوفي، سمع عمر بن عبد العزيز قوله، روى عنه عبيد العطار 4، ولا يصح عبيد.(@)(@@)(@@)(@@) $ 2789 - عيسى بن أبي رزين الثمالي 5، سمع صالحا وعن يزيد بن رفاعة، سمع منه ابن المبارك وبقية ومحمد بن سليمان.(@)(@@)(@@)(@@) $ 2790 - عيسى بن ماهان أبو جعفر الرازي التميمي 6، سمع PageV06P403(@)(@@) عطاء والربيع بن أنس ومنصورا وعمرو بن دينار، سمع منه وكيع وأبو نعيم، ويقال: أصله مروي، هو عيسى بن أبي عيسى، (@)(@@) إبراهيم بن حمزة حدثنا حاتم حدثنا عيسى بن ماهان: عن ربيع بن أنس الخراساني عن ابى هريرة رضى الله عنه في المعراج.(@)(@@)(@@)(@@) $ 2791 - عيسى بن أبي عيسى 1، قال زكريا حدثنا الحكم بن المبارك قال ح عيسى بن أبي عيسى: عن محمد بن ثابت البناني عن أبيه عن أنس بن مالك رضي الله عنه عن النبي صلى الله عليه وسلم قال: إن العبد إذا أذنب ثم استغفر غفر له.(@)(@@)(@@)(@@) $ 2792 - عيسى بن أبي عيسى أبو حكيم البصري عن عوف، روى عنه مروان بن معاوية 1.(@)(@@)(@@)(@@) $ 2793 - عيسى بن ميسرة الغفاري 2: عن ابى الزناد عن انس رضي الله عنه عن النبي صلى الله عليه وسلم: الصيام جنة ولا يزال الله في PageV06P404(@)(@@) حاجة العبد مادام في حاجة أخيه، وروى حسين بن علي عن زائدة: عن عبد الله بن ذكوان وأبي الزناد عن الرقاشي عن أنس رضي الله عنه عن النبي صلى الله عليه وسلم في العون، وروى محمد بن الحسن الواسطي عن عبد الله بن عامر: عن أبي الزناد عن الأعرج عن أبي هريرة رضي الله عنه عن النبي صلى الله 
ms1173	 عليه وسلم في العون، ولا يصح.(@)(@@)(@@)(@@) $ 2794 - عيسى بن أبي عيسى وهو عيسى بن ميسرة المديني الحناط وهو الخياط 1، عن نافع والشعبي، ضعفه علي عن يحيى القطان، يقال: هو أخو موسى بن أبي عيسى وهو الحناط 2.(@)(@@)(@@)(@@) $ 2795 - عيسى بن ميسرة بن حيان 3، يعد في أهل المدينة، عن أبي الزناد، سمع منه خالد بن مخلد 4.(@)(@@)(@@)(@@) $ 2796 - عيسى بن عون بن حفص بن فرافصة الحنفي 5 ح PageV06P405(@)(@@) عبد الملك بن زرارة 1 عن النبي صلى الله عليه وسلم في النعمة، سمع منه عمر بن يونس.(@)(@@)(@@)(@@) $ 2797 - عيسى بن حصين البرحي، سمع عمرو بن الحارث، سمع منه الزبيدي 2.(@)(@@)(@@)(@@) $ 2798 - عيسى بن يونس بن أبي إسحاق أبو عمرو السبيعي الهمداني أصله كوفي سكن ناحية الشام، سمع الأعمش وابن أبي خالد، قال إبراهيم بن موسى: سمعت الوليد / يقول: ما أبالي من خالفني في الأوزاعي ما خلا عيسى بن يونس فإني رأيت أخذه [أخذا محكما] 3، قال إبراهيم: وسمعت عيسى يقول: نصصت الأوزاعي عما قال عمر بن عبد العزيز وكتب عمر بن عبد العزيز فلم أجد عنده ما يقول عليه، يقال: مات أول سنة إحدى وتسعين ومائة، قال الفضل بن يعقوب ح عبد الله بن جعفر: مات سنة سبع وثمانين ومائة.(@)(@@)(@@)(@@) $ 2799 - عيسى بن خالد الخراساني، سمع سعيد بن سنان 4، PageV06P406(@)(@@) قال عمرو بن علي: كان ثقة.(@)(@@)(@@)(@@) $ 2800 - عيسى بن صدقة 1، سمع عبد الحميد عن أنس، قال أبو الوليد هشام: هو ضعيف، وقال عبيد الله بن موسى: عن صدقة بن(@)(@@) عيسى سمع انسا رضى الله عنه، وقال أبو داود: ح صدقة أبو محرز سمع أنسا رضي الله عنه.(@)(@@)(@@)(@@) $ 2801 - عيسى بن ابراهيم البصري البركى 2 ابن سيار مولى بني هاشم، سمع عبد العزيز بن مسلم، في كتابي كنيته أبو إبراهيم 3.(@)(@@)(@@)(@@) $ 2802 - عيسى بن إبراهيم الهاشمي عن جعفر بن برقان 4، روى عنه كثير بن هشام، منكر الحديث.(@)(@@)(@@)(@@) $ 2803 - عيسى بن شعيب، عمرو بن علي 5 حدثنا عيسى بصري صدوق حدثنا عباد بن منصور عن أبي رجاء عن سمرة بن 
ms1174	 جندب رضى الله PageV06P407(@)(@@) عنه قال النبي صلى الله عليه وسلم: أطفال المشركين خدم أهل الجنة.(@)(@@)(@@)(@@) || باب عمران(@)(@@)(@@)(@@) $ 2804 - عمران بن حصين أبو نجيد الخزاعي الأزدي ابن أبي الأسود، عن حماد بن زيد عن هشام عن محمد بن سيرين: لم يكن يقدم على عمران بن حصين من أصحاب النبي صلى الله عليه وسلم فيمن نزل البصرة(@)(@@) أحد، قال عمرو بن علي حدثنا أيوب بن سليمان أبو سليمان صاحب القوهي 1 حدثنا عمر بن محمد بن معدان عن عمران القصير عن عبد الله بن أبي القلوص سمع مطرف بن عبد الله: عن عمران بن حصين رضى الله عنهما قال: سمعت النبي صلى الله عليه وسلم يقول: من علم أن الله ربه وأني نبيه صادقا من قلبه وأومى بيده إلى جلدة صدره حرم الله لحمه على النار، قال ابن أبي القلوص فحدثت بهذا أحد ولد عبد الملك بن مروان فقال لكاتبه: اكتبه.(@)(@@)(@@)(@@) $ 2805 - عمران بن أوس 2 بن ضمعج، قال مروان بن معاوية PageV06P408(@)(@@) عن عمران: عن أبيه سمع أباه عن عائشة رضى الله عنها: أن النبي صلى الله عليه وسلم أكل ولم يتوضأ، وروى عنه أبو معاوية 1، وقال عبد الرحمن حدثنا زائدة عن عبد العزيز بن رفيع حدثني ابن أبي مليكة وعكرمة: عن عائشة رضي الله عنها عن النبي صلى الله عليه وسلم: أنه أكل لحما ولم يتوضأ، وهذا لا يصح لأن 2 أيوب وسماكا وعاصما رووه 2 عن عكرمة عن ابن عباس رضي الله عنهما عن النبي صلى الله عليه وسلم، وقال الليثي حدثني عقيل عن يونس عن ابن شهاب قال أخبرني سعيد بن خالد سمع عروة: سمع عائشة رضي الله عنها عن النبي صلى الله عليه وسلم: توضأوا مما(@)(@@) مست النار، وهذا أصح.(@)(@@)(@@)(@@) $ 2806 - عمران بن أبان أبو موسى الواسطي أخو محمد عن الحسن بن عبد الله بن مالك 3. PageV06P409(@)(@@)(@@)(@@) $ 2807 - عمران بن بشر الحضرمي، رأى 1 عبد الله بن بشر، روى عنه أبو حيوة الشامي.(@)(@@)(@@)(@@) $ 2808 - عمران بن بشر أبو بشر 
ms1175	 الثقفي 2 عن ابن المسيب قوله.(@)(@@)(@@)(@@) $ 2809 - عمران بن بشير بن محرز 3 عن أبيه، روى عنه ابن أبي ذئب المدني.(@)(@@)(@@)(@@) $ 2810 - عمران 4 أبو بشر الحلبي البصري عن الحسن، سمع منه وكيع، مرسل.(@)(@@)(@@)(@@) $ 2811 - عمران بن ملحان أبو رجاء العطاردي، قال علي ويقال: PageV06P410(@)(@@) عمران بن تيم البصري 1، وقال الصلت بن محمد حدثنا بكار بن سفيان عن أبي رجاء العطاردي: وقد أدركته كنت أفر من النبي صلى الله عليه وسلم حتى عفا الناس حين فتح مكة فأسلمت بعد ذلك، وقال موسى ابن اسمعيل عن بكار بن سفيان: رأيت الحسن علي شفير قبر أبي رجاء والفرزدق، وقال موسى حدثنا أبو الحارث الكرماني سمعت أبا رجاء العطاردي: كنت إمام الحي في رمضان وقد اتى على عشرون ومائة وأدركت النبي صلى الله عليه وسلم وأنا شاب أمرد وإنما سمي بني عبد شمس لأنهم كانوا يعبدون الشمس، قال أحمد: اسمه عمران بن عبد الله 2.(@)(@@)(@@)(@@) $ 2812 - عمران بن سوادة، قال سعيد بن محمد حدثنا يعقوب ابن إبراهيم سمع عيسى بن يزيد الليثي عن عبد الرحمن بن أبي زيد: عن عمران بن سوادة قال: صليت مع عمر رضي الله عنه الغداة فقرأ " سبحان "، حديثه في أهل الحجاز 3.(@)(@@)(@@)(@@) $ 2813 - عمران بن الحارث 4 السلمي أبو الحكم عن ابن عباس PageV06P411(@)(@@) رضى الله عنهما، روى عنه حصين وسلمة بن كهيل، الكوفي.(@)(@@)(@@)(@@) $ 2814 - عمران بن سليم عن عبد الرحمن بن عيسى عن الزهري - قاله المقرئ عن سعيد بن أبي أيوب 1.(@)(@@)(@@)(@@) $ 2815 - عمران بن سليم الحضرمي، سمع ابن عمر رضى الله عنهما، روى عنه عياش بن عباس وعمرو بن الحارث، يعد في المصريين 2.(@)(@@)(@@)(@@) $ 2816 - عمران بن سليم / الكلاعي قاضي حمص، روى عنه معاوية بن صالح وحريز بن عثمان، قال إسحاق ح بقية عن ابن أبي مريم: قال لي مكحول: 3 ما نزل الشام قاض مثله 3، وروى أيضا حريز عن عمر بن سعيد: عن عمران بن سليم.(@)(@@)(@@)(@@) $ 2817 - عمران بن أبي عطاء أبو حمزة القصاب 4 الواسطي، سمع ابن عباس وابن الحنفية 
ms1176	 رضى الله عنهم، سمع منه الثوري وشعبة وأبو عوانة وهشيم 5، مولى بنى اسد. PageV06P412(@)(@@)(@@)(@@) $ 2818 - عمران بن يزيد 1، روى عنه ثابت بن عبيد، منقطع.(@)(@@)(@@)(@@) $ 2819 - عمران بن سعيد، سمع ابن عباس وابن الزبير رضى الله عنهم، روى عنه الأجلح 2.(@)(@@)(@@)(@@) $ 2820 - عمران بن نمران أبو سليمان 3، روى عنه يزيد بن خمير، وأدرك غزو فتح حمص.(@)(@@)(@@)(@@) $ 2821 - عمران بن سريع: كنا مع حذيفة رضى الله عنه في مسجد الكوفة فأنشأ يحدث عن الأحزاب، روى عنه علقمة بن مرثد، في حديثه نظر.(@)(@@)(@@)(@@) $ 2822 - عمران بن حطان السدوسي، سمع عائشة وابن عمر وابن عباس رضي الله عنهم، روى عنه محمد بن سيرين ويحيى بن أبي كثير وصالح بن سرج 4، قال عمرو بن خالد حدثنا زهير عن أبيه عن محارب: زاملت عمران بن حطان فما سأل واحد منا صاحبه عن الهواء. PageV06P413(@)(@@)(@@)(@@) $ 2823 - عمران بن عبد المعافري، سمع عبد الله بن عمرو 1، سمع منه عبد الرحمن الإفريقي.(@)(@@)(@@)(@@) $ 2824 - عمران بن عوف الغافقي، سمع ابن عمر رضى الله عنهما، روى عنه سليمان بن زياد ومصعب الحميري وموسى بن أبي حملة.(@)(@@)(@@)(@@) $ 2825 - عمران بن الجعد عن الأسود، روى عنه حكيم بن جبير، الكوفي، يقال عن علي: أنه 2 أخو إبراهيم 2، ويقال عن ابن معين: أن سوادة أخوهم أصلهم من الكوفة ثم صاروا إلى الري.(@)(@@)(@@)(@@) $ 2826 - عمران بن أبي الجعد 3، روى عنه اسمعيل بن أبي خالد، وقال بعضهم: عمران بن ابى الجعد: سألت ابن عمر رضى الله عنهما عن الخمر فقال: لا تبعها، وعن يعلى عن اسمعيل عن عمران: كنت مع ابن عمر رضى الله عنهما في الحج، وعن أبيه ويعلى عن عمران بن أبي الجعد منقطع - قاله محمود حدثنا عبيد الله عن إسرائيل عن حكيم بن جبير عن الاسود قوله، ابن نمير حدثنا وكيع عن اسمعيل عن عمران ابن أبي الجعد: عن عبد الله رضي الله عنه: ان الناس احسنوا القول، PageV06P414(@)(@@) وقال وكيع عن إسرائيل عن حكيم عن عمران بن أبي الجعد: عن الأسود في الأذان، وقال محمد بن 
ms1177	 سلمة بن كهيل عن أبيه سمع أبا يحيى حدثني عمران بن أبي الجعد: عن عبد الرحمن بن يزيد عن الأشتر سمع(@)(@@) خالد بن الوليد رضي الله عنه عن النبي صلى الله عليه وسلم في عمار رضى الله عنه.(@)(@@)(@@)(@@) $ 2827 - عمران النخلي 1، سمع ابن عمر رضي الله عنهما قوله 2، روى عنه شريك وابنه حماد، في الكوفيين.(@)(@@)(@@)(@@) $ 2828 - عمران بن وهب، سمع أبا رجاء العطاردي، روى عنه محمد بن عبيد 3، وقال إسحاق بن سليمان: هو الطائي، وعن سعيد ابن عبد الله بن جرو 4. PageV06P415(@)(@@)(@@)(@@) $ 2829 - عمران بن قيس، سمع ابن عمر رضي الله عنهما قوله، روى عنه حريث بن أبي مطر، ولم يصح، حديثه في الكوفيين.(@)(@@)(@@)(@@) $ 2830 - عمران بن عكرمة الخزاعى، عبدة ح عبد الصمد حدثنا حرب بن شداد عن حصين - هو ابن عبد الرحمن - عن عمران ابن عكرمة الخزاعي: عن شيخ منهم يقال له: ذؤيب بن عباد الراعي:(@)(@@) 1 أنه استسقى 1.(@)(@@)(@@)(@@) $ 2831 - عمران بن حميري: قال لي عمار بن ياسر رضى الله عنهما قال لي النبي صلى الله عليه وسلم: إن الله أعطى ملكا أسماع الخلائق قائم على قبري - قاله أبو أحمد الزبيري حدثنا نعيم بن جهضم 2 عن عمران، لا يتابع عليه.(@)(@@)(@@)(@@) $ 2832 - عمران بن عثمان بن الأرقم بن أبي الأرقم 3 عن أبيه، سمع منه ابنه يحيى المديني القرشي، مخزومي.(@)(@@)(@@)(@@) $ 2833 - عمران بن طلحة بن عبيد الله القرشى التيمى الحجازى، PageV06P416(@)(@@) سمع عليا رضى الله عنه وعن أمه 1، روى عنه إبراهيم بن محمد بن طلحة، هو أخو عيسى وموسى ومحمد ويحيى.(@)(@@)(@@)(@@) $ 2834 - عمران بن عمرو، قال نعيم ح ضمام بن اسمعيل: سمع عمران بن عمرو: عن أبيه سمع جابر بن عبد الله رضي الله عنهما في مس الذكر، وقال أصبغ أخبرني ضمام: عن أبي قبيل 2 عن عمرو بن دينار سمع جابر بن عبد الله رضي الله عنهما - مثله.(@)(@@)(@@)(@@) $ 2835 - عمران بن عصام الضبعي البصري، روى عنه قتادة والمثنى الضبعي 3، ويقال أبو جمرة نصر بن عمران: عن أبيه قال، عمران(@)(@@) ابن 
ms1178	 ميسرة عن عبد الوارث عن أبي التياح: عن عمران بن عصام قاض 4 كان عندهم، قال حجاج حدثنا حماد عن أبي جمرة عن أبيه: عاش النبي صلى الله عليه وسلم ثلاثا وستين سنة، قال عارم ح معتمر حدث PageV06P417(@)(@@) أبي عن عبد الرحمن صاحب السقاية قال: دعا الحجاج انسا رضى الله عنه فلم يكلفه ما يكلف الناس غير أنه شتمه فسمعت أنسا يقول: " إنا لله وإنا إليه راجعون " ثم دعاني فقلت: لم أنكث بيعتي فما أعلم أحدا من الناس نجا منه كما نجا عبد الرحمن ودعا / وجئ بعمران بن عصام وكان مذكرا قال إنما سمعته يقول: اللهم اغفر لنا حتى يبكي فقتله قال ابى: وجئ بابي السوار فقال: ما تقول؟ قال: كافر منافق قال: والله ماعنى غيره.(@)(@@)(@@)(@@) $ 2836 - عمران الخياط مولى الجعفي عن إبراهيم وزيد بن وهب، روى عنه ابن عون 1.(@)(@@)(@@)(@@) $ 2837 - عمران بن حيان الأنصاري: عن أبيه عن النبي صلى الله(@)(@@) عليه وسلم ولم يذكر سماعا، روى عنه حميد بن علي 2.(@)(@@)(@@)(@@) $ 2838 - عمران بن مسلم الجعفي الأعمى كوفي، سمع سويد ابن غفلة وزاذان 3، روى عنه الثوري وشريك وشعبة ومالك ابن مغول. PageV06P418(@)(@@)(@@)(@@) $ 2839 - عمران بن مسلم (@)(@@) بن رياح الثقفي الكوفي، </span>سمع عبد الله ابن معقل 1 وعلي بن عمارة، روى عنه الثوري.(@)(@@)(@@)(@@) $ 2840 - عمران بن مسلم أبو بكر القصير البصري، سمع أبا رجاء وعطاء 2، كناه يحيى بن سعيد وحماد بن مسعدة، قال أحمد: هو المنقري، سمع منه شعبة.(@)(@@)(@@)(@@) $ 2841 - عمران بن مسلم - أو ابن أبي مسلم - الفزاري، سمع مجاهدا والشعبي، روى عنه محمد بن ربيعة 3، وقال أبو نعيم: حدثنا عمران بن أبي مسلم كان يكون في جهينة: سمع عطية سمع أبا سعيد: " إنما يريد الله ليذهب عنكم الرجس ".(@)(@@)(@@)(@@) $ 2842 - عمران بن مسلم عن عبد الله بن دينار 1، منكر الحديث، روى عنه يحيى بن سليم.(@)(@@)(@@)(@@) $ 2843 - عمران بن أبي يحيى التيمي، سمع عبد الله بن كعب بن PageV06P419(@)(@@) مالك 1، روى عنه محمد بن إبراهيم بن الحارث 2 وسعيد المقبري، المديني.(@)(@@)(@@)(@@) $ 2844 - عمران بن 
ms1179	 أبي يحيى عن عمه مروان، روى عنه محمد ابن عبيد وعيسى بن يونس 3.(@)(@@)(@@)(@@) $ 2845 - عمران بن يحيى (@)(@@) الغافقي </span>4، سمع سعيد بن المسيب، سمع منه سعيد بن أبي أيوب.(@)(@@)(@@)(@@) $ 2846 - عمران بن يحيى 4، سمع موسى بن أبي عائشة، مرسل، روى عنه حجاج بن محمد.(@)(@@)(@@)(@@) $ 2847 - عمران بن عمير مولى عبد الله بن مسعود الهذلي أخو القاسم بن عبد الله لامه - قاله ابن عيينة عن مسعر، ويروي عن أبيه 5، حديثه في الكوفيين.(@)(@@)(@@)(@@) $ 2848 - عمران بن عبد الرحمن بن شرحبيل بن حسنة القرشي عن أبي خراش الحميري، روى عنه عياش بن عباس المصري 6. PageV06P420(@)(@@)(@@)(@@) $ 2849 عمران بن عبد الرحمن أبو الهذيل (@)(@@) 1، سمع وهبا وزياد ابن فيروز والقاسم بن تنخسرة، روى عنه هشام بن يوسف وغوث ابن جابر.(@)(@@)(@@)(@@) $ 2850 - عمران بن نافع عن حفص بن عبيد الله عن انس بن مالك رضي الله عنه عن النبي صلى الله عليه وسلم: من احتسب ثلاثة من صلبه دخل الجنة، قال ابن سليمان عن ابن وهب أخبرني عمرو بن الحارث عن بكير 2: أن عمران حدثه.(@)(@@)(@@)(@@) $ 2851 - عمران بن أبي جميل عن أبي النضر، روى عنه عمرو ابن الحارث مرسل، وسمع أبا فراس، رأى على عبد الله بن عمرو رضى الله عنهما جبة خشن 3.(@)(@@)(@@)(@@) $ 2852 - عمران بن عون 4 عن ابن شهاب، روى عنه الليث، مرسل أحسبه. PageV06P421(@)(@@)(@@)(@@) $ 2853 - عمران بن عمران الجعفي 1، روى عنه محمد بن طلحة ابن مصرف.(@)(@@)(@@)(@@) $ 2854 - عمران بن عمار 2، قال إسحاق حدثنا أبو هشام حدثنا سعيد بن زيد حدثنا محمد بن جحادة: سمعت عمران بن عمار بالكوفة عن النبي صلى الله عليه وسلم مرسل.(@)(@@)(@@)(@@) $ 2855 - عمران بن موسى (@)(@@) بن أبي الصعبة 3 هو ابن طلحة بن عبيد الله القرشي </span>عن أبيه، روى عنه مسعر، قال ابن عيينة.(@)(@@) رأيته، حديثه في الكوفيين.(@)(@@)(@@)(@@) $ 2856 - عمران بن موسى 4، سمع عمر بن عبد العزيز، روى عنه ابن جريج، وعن سعيد المقبري، قال علي: هو أخو أيوب بن موسى. PageV06P422(@)(@@)(@@)(@@) $ 2857 - عمران بن عبد الله بن طلحة الخزاعي، سمع سعيد 
ms1180	 بن المسيب 1، روى عنه سلام بن مسكين، حديثه عن البصريين.(@)(@@)(@@)(@@) $ 2858 - عمران بن أبي أنس من أهل اليمن أخو بني عامر بن لؤي 2، قال عبد العزيز الأويسي: هو مولاهم، سمع أبا خراش السلمي، ويقال: من أهل مصر.(@)(@@)(@@)(@@) $ 2859 - عمران بن أنس 3 أبو أنس المكي 4، قال ابن سلام أخبرني يحيى بن واضح سمع عمران: عن عبد الله بن أبي مليكة عن عائشة رضي الله عنها عن النبي صلى الله عليه وسلم: أزنى الزنا استطالة في عرض المسلم.(@)(@@)(@@)(@@) $ 2860 - عمران المنقري التيمي 5 عن عطاء، روى عنه الثوري - PageV06P423(@)(@@) قال 1 أبو نعيم، وقال وكيع: أسلم المنقري، وهو أراه وهم، قال أحمد: عمران المنقري هو القصير بصري.(@)(@@)(@@)(@@) $ 2861 - عمران الكوفي 2، روى عنه ابن عيينة، مرسل.(@)(@@)(@@)(@@) $ 2862 - عمران بن ظبيان عن حكيم بن سعد 3، روى عنه(@)(@@) الثوري وابن / عيينة، في الكوفيين، فيه نظر.(@)(@@)(@@)(@@) $ 2863 - عمران البارقي عن الحسن، روى عنه الأعمش، مرسل، وقد روى الثوري عن عمران البارقي عن عطية.(@)(@@)(@@)(@@) $ 2864 - عمران بن أبي كثير، سمع سعيد بن المسيب وقبيصة ابن ذؤيب، سمع منه محمد بن إسحاق، مرسل.(@)(@@)(@@)(@@) $ 2865 - عمران بن زيد أبو يحيى الملائي الطويل 4، سمع زيدا العمي وأبا يحيى القتات، سمع منه أبو نعيم، إن لم يكن التغلبي فلا أدري.(@)(@@)(@@)(@@) $ 2866 - عمران بن زيد 5 المديني سمع والده عن عائشة PageV06P424(@)(@@) رضى الله عنها - قاله موسى بن اسمعيل عن سليمان 1 بن عبيد.(@)(@@)(@@)(@@) $ 2867 - عمران بن حدير السدوسي البصري أبو عبيدة، سمع عكرمة وأبا مجلز 2، سمع منه وكيع وشعبة، قال أبو قطن: مات سنة تسع وأربعين 3.(@)(@@)(@@)(@@) $ 2868 - عمران بن داود 4 أبو العوام القطان البصري، سمع منه أبو عاصم وأبو داود، وسمع الحسن وابن سيرين وقتادة 5، هو العمي(@)(@@) أراه، روى حماد بن مسعدة عن عمران العمي عن الحسن في الشفاعة.(@)(@@)(@@)(@@) $ 2869 - عمران بن عبيد المكي عن أمه ليلى مولاة 6 أسماء وعبد الله بن كيسان عن أسماء قولها، روى عنه أبو عاصم 7. PageV06P425(@)(@@)(@@)(@@) $ 2870 - عمران بن سليمان المرادي، سمع الشعبي 1، روى عنه عيسى 