ms161	 % تنزو ذئابهم على اعوادها % % 33(@)(@@) % هي صفوة الله التي اوحى لها % % وقضى اوامره إلى امجادها % % 34(@)(@@) % أخذت بأطراف الفخار ، فعاذر % ان يصبح الثقلان من حسادها % % 35(@)(@@) % الزهد والأحلام في فتاكها % % والفتك لولا الله في زهادها % % 36(@)(@@) % عصب يقمط بالنجاد وليدها % % ومهود صبيتها ظهور جيادها % % 37(@)(@@) % تروي مناقب فضلها أعداؤها % % أبدا ، وتسنده إلى أضدادها % % 38(@)(@@) % يا غيرة الله اغضبي لنبيه % وتزحزحي بالبيض عن اغمادها % % 39(@)(@@) % من عصبة ضاعت دماء محمد % وبنيه بين يزيدها وزيادها % % 40(@)(@@) % صفدات مال الله ملء أكفها % % وأكف آل الله في أصفادها % % PageV01P553 41(@)(@@) % صربوا بسيف محمد أبناءه % ضرب الغرائب عدن بعد ذيادها % % 42(@)(@@) % قد قلت للركب الطلاح كانهم % % ربد النسور على ذرى اطوادها % % 43(@)(@@) % يحدو بعوج كالحني اطاعه % % معتاصها ، فطغى على منقادها % % 44(@)(@@) % حتى تخيل من هباب رقابها % % أعناقها في السير من أعدادها % % 45(@)(@@) % قف بي ولو لوث الزرار فانما % % هي مهجة علق الجوى بفؤادها % % 46(@)(@@) % بالطف حيث غدا مراق دمائها % % ومناخ اينقها ليوم جلادها % % 47(@)(@@) % القفر من أرواقها ، والطير من % طراقها ، والوحش من عوادها % % 48(@)(@@) % تجري لها حبب الدموع ، وإنما % % حب القلوب يكن من أمدادها % % 49(@)(@@) % يا يوم عاشوراء كم لك لوعة % % تترقص الاحشاء من ايقادها % % 50(@)(@@) % ما عدت الا عاد قلبي غلة % % حرى ، ولو بالغت في إبرادها % % PageV01P554 51(@)(@@) % مثل السليم مضيضة آناؤه % خزر العيون تعوده بعدادها % % 52(@)(@@) % يا جد لا زالت كتائب حسرة % % إن لم يراوحها البكاء يغادها % % 53(@)(@@) % هذا الثناء ، وما بلغت ، وإنما % % هي حلبة خلعوا عذار جوادها % % 54(@)(@@) % أأقول : جادكم الربيع ، وأنتم % في كل منزلة ربيع بلادها % % 55(@)(@@) % أم استزيد لكم علا بمدائحي % % اين الجبال من الربى ووهادها % % 56(@)(@@) % كيف الثناء على النجوم ، إذا سمت % فوق العيون إلى مدى ابعادها % % 57(@)(@@) % أغنى طلوع الشمس عن أوصافها % % بجلالها وضيائها وبعادها % % PageV01P555 البحر : طويل 1(@)(@@) % وراءك عن شاك قليل العوائد % % تقلبه بالرمل ايدي الاباعد % % 2(@)(@@) % يراعي نجوم الليل والهم كلما % % مضى صادر عني باخر وارد % % 3(@)(@@) % توزع بين النجم والدمع طرفه % بمطروفة انسانها غير راقد % % 4(@)(@@) % وما 
ms162	 يطبيها الغمض الا لانه % % طريق إلى طيف الخيال المعاود % % 5(@)(@@) % ذكرتكم ذكر الصبا بعد عهده % % قضى وطرا مني وليس بعائد % 6(@)(@@) % إذا جانبوني جانبا من وصالهم % علقت باطراف المنى والمواعد % % 7(@)(@@) % فيا نظرة لا تنظر العين اختها % % إلى الدار من رمل اللوى المتقاود % 8(@)(@@) % هي الدار لا شوقي القديم بناقص % إليها ، ولا دمعي عليها بجامد % 9(@)(@@) % ولي كبد مقروحة لو اضاعها % % من السقم غيري ما بغاها بناشد % % 10(@)(@@) % اما فارق الاحباب قبلي مفارق % % ولا شيع الاظعان مثلي بواجد % % PageV01P556 11(@)(@@) % تأوبني داء من الهم لم يزل % بقلبي حتى عادني منه عائدي % % 12(@)(@@) % تذكرت يوم السبط من آل هاشم % وما يومنا من آل حرب بواحد % 13(@)(@@) % وظام يريغ الماء قد حيل دونه % سقوه ذبابات الرقاق البوارد % 14(@)(@@) % أتاحوا له مر الموارد بالقنا % % على ما أباحوا من عذاب الموارد % 15(@)(@@) % بنى لهم الماضون آساس هذه % فعلوا على آساس تلك القواعد % 16(@)(@@) % رمونا كما يرمى الظماء عن الروا % % يذودوننا عن ارث جد ووالد % % 17(@)(@@) % ويا رب ساع في الليالي لقاعد % على ما رأى ، بل كل ساع لقاعد % 18(@)(@@) % أضاعوا نفوسا بالرماح ضياعها % % يعز على الباغين منا النواشد % % 19(@)(@@) % أألله ! ما تنفك في صفحاتها % % خموش لكلب من امية عاقد % % 20(@)(@@) % لئن رقد النصار عما أصابنا % % فما الله عما نيل منا براقد % PageV01P557 21(@)(@@) % لقد علقوها بالنبي خصومة % % إلى الله تغني عن يمين وشاهد % 22(@)(@@) % ويا رب أدنى من أمية لحمة % رمونا على الشنآن رمي الجلامد % 23(@)(@@) % طبعنا لهم سيفا فكنا لحده % % ضرائب عن ايمانهم والسواعد % % 24(@)(@@) % الا ليس فعل الاولين وان علا % % على قبح فعل الاخرين بزائد % % 25(@)(@@) % يريدون أن نرضى وقد منعوا الرضى % % لسير بني اعمامنا غير قاصد % % 26(@)(@@) % كذبتك ، إن نازعتني الحق ظالما % إذا قلت يوما إنني غير واجد % PageV01P558 البحر : وافر تام 1(@)(@@) % تفوز بنا المنون وتستبد % % وياخذنا الزمان ولا يرد % % 2(@)(@@) % وانظر ماضيا في عقب ماض % % لقد أيقنت أن الأمر جد % 3(@)(@@) % رويدا بالفرار من المنايا % % فليس يفوتها الساري المجد % % 4(@)(@@) % فاين ملوكنا 
ms163	 الماضون قدما % اعدوا للنوائب واستعدوا % % 5(@)(@@) % واين معاقدوا الدنيا قديما % نبت بهم ، فلا إل وعقد % 6(@)(@@) % وكل فتى تحف بجانبيه % خواطر بالقنا قب وجرد % 7(@)(@@) % فما دفع المنايا عنه وفر % % ولا هزم النوائب عنه جند % 8(@)(@@) % ولا اسل لها قرع ووخز % % ولا قضب لها قط وقد % % 9(@)(@@) % اعارهم الزمان نعيم عيش % % فيا سرعان ما نزعوا وردوا % % 10(@)(@@) % هم فرط لنا في كل يوم % نمدهم ، وإن لم يستمدوا % % PageV01P559 11(@)(@@) % فلا الغادي يروح فنرتجيه % % ولا المتروح العجلان يغدو % % 12(@)(@@) % وللإنسان من هذي الليالي % % وهوب لا يدوم ومسترد % 13(@)(@@) % تجد لنا ملابسها ، فيبقى % % جديداها ، ويبلى المستجد % 14(@)(@@) % أإبراهيم ! أما دمع عيني % % عليك فما يعد ولا يحد % % 15(@)(@@) % يغصص بالاوائل منه طرف % % ويدمى بالأواخر منه خد % 16(@)(@@) % بكيتك للوداد ، ورب باك % عليك من الأقارب لا يود % 17(@)(@@) % وإن بكاء من تبكيه قربى % % لدون بكاء من يبكيه ودج % % 18(@)(@@) % إذا غضنا الدموع أبت علينا % % مناقب منك ليس لهن ند % 19(@)(@@) % فمنهن اشتطاطك في المساعي % % وفضل العزم ، والباع الأشد % 20(@)(@@) % فاين مسابق الاجال طعنا % يعود ورمحه ريان ورد % % PageV01P560 21(@)(@@) % واين الآسر الفكاك يسري % % إليه من العدى ذم وحمد % 22(@)(@@) % فاعناق احاط بهن من % وأعناق أحاط بهن قد % 23(@)(@@) % أيا سهما رمى غرضا ، فأخطا % % وذي الاقدار اسهمها اسد % % 24(@)(@@) % ولو غير الردى جاثاك اقعى % % به من بأسك الخصم الألد % 25(@)(@@) % قتيل فله ناب كهام % وكان العضب ضوأه الفرند % 26(@)(@@) % وذل بذل قاتله ، فأضحى % % لقاتله به عز ومجد % 27(@)(@@) % فيا اسدا يصول عليه ذئب % ويا مولى يطول عليه عبد % % 28(@)(@@) % وكيف رجوت ان يبقى سليما % وما شرب القرون له معد % % 29(@)(@@) % وهل بقيت قبائله ، فيبقى % % ربيعة أو نزار أو معد % 30(@)(@@) % من القوم الألى طلبوا ونالوا % % وجد بهم إلى العلياء جد % PageV01P561 31(@)(@@) % إذا ندبوا إلى البأساء عاجوا % % وان ادنو إلى العوراء صدوا % % 32(@)(@@) % تصدع مجد أولهم ، فشدوا % % جوانبه بأنفسهم وسدوا % % 33(@)(@@) % إذا عد الأماجد جاء منهم % عديد كالرمال ، فلم يعدوا % % 34(@)(@@) % سقاه أحم نجدي التوالي % % يعم بودقه غور 
ms164	 ونجد % 35(@)(@@) % إذا مخضت حوافله جنوب % مرى لقحاته برق ورعد % 36(@)(@@) % تدافع منه ملأن الحوايا % % سياق النيب أصدرهن ورد % 37(@)(@@) % ولا عرى ثراه من الغوادي % % ومن نوارها سبط وجعد % % 38(@)(@@) % اذا ماالراكب مر عليه قالوا % % أيا حالي الصعيد سقاك عهد % 39(@)(@@) % لقد كرمت يمينك قبل حيا % % وقد كرم الغمام عليك بعد % PageV01P562 البحر : طويل 1(@)(@@) % اعامر لا لليوم انت ولا الغد % % تقلدت ذل الدهر بعد المقلد % % 2(@)(@@) % واصبحت كالمخطوم من بعد عزة % % متى قيد مشاء على الضيم ينقد % 3(@)(@@) % فان سار للاعداء غيرك فاربعي % % وإن قام للعلياء غيرك فاقعد % 4(@)(@@) % وقل للحمى لا حامي اليوم بعده % % ولا قائم من دون مجد وسؤدد % 5(@)(@@) % وللبيض لا كف لماض مهند % وللسمر لا باع لعال مسدد % 6(@)(@@) % وقل للعدى امنا على كل جانب % % من الأرض أو نوما على كل مرقد % % 7(@)(@@) % فقد زال من كانت طلائع خوفه % % تعارضكم في كل مرعى ومورد % 8(@)(@@) % فاين الجياد الملجمات على الوحى % % سراعا إلى نقع الصريخ المندد % % 9(@)(@@) % واين الظبى ما زال منها بكفه % % رداء عظيم أو عمامة سيد % % 10(@)(@@) % واين المطايا تذرع البيد والدجى % % إلى اقرب من نيل عز وابعد % % PageV01P563 11(@)(@@) % واين الجفان الغر من قمع الذرى % % هجان الاعالي بالسديف المسرهد % % 12(@)(@@) % واين القدور الراسيات كانها % % سماوات ربلان النعام المطرد % % 13(@)(@@) % واين الوفود الماتحون ببابه % % بسجلين من بحري وعيد وموعد % 14(@)(@@) % مرمون من قبل اللقاء مهابة % اذا رمقوا باب الطراف الممدد % % 15(@)(@@) % يشيرون بالتسليم من خلل القنا % % إلى واضح من عامر غير قعدد % % 16(@)(@@) % يحيون مرهوبا كأن رواقه % وليجة مفتول الذراعين ملبد % % 17(@)(@@) % اذا هم امضى الراي غير ملوم % % وإن قال أجرى القول غير مفند % 18(@)(@@) % حسام نكا فيه كهام بغرة % واولى له لو هزه غير مغمد % % 19(@)(@@) % لئن فلل الذلان منه فربما % % تحيف من ماضي الظبى شق مبرد % % 20(@)(@@) % فلا نعم الباغون يوما بعيشة % ولا حضروا إلا بألأم مشهد % PageV01P564 21(@)(@@) % ولاصادفوا في الدهر منجى لخائف % % ولاوجدوا في الأرض ماوى لمطرد % % 22(@)(@@) % ولا شربوا إلا دما بعده 
ms165	 ، ولا % % تحابوا بغير الزاعبي المقصد % % 23(@)(@@) % ولا نظروا الا بعمياء بعده % % ولا ارتضعوا إلا بخلف مجدد % 24(@)(@@) % ابعد الطوال الشم من آل عامر % % إلى البيض والادراع والخيل والند % % 25(@)(@@) % وأهل القباب الحمر يرخى سدولها % % على سؤدد عود ومجد موطد % 26(@)(@@) % إذا فزعوا للأمر ألجوا ظهورهم % إلى كل طود من نزار عطود % % 27(@)(@@) % لهم جامل داجي المراح كأنما % % تراغين عن قطع من الليل أسود % 28(@)(@@) % تروح لهم حمر العوادي كانها % % قواني عروق العندم المتورد % 29(@)(@@) % كان الرياض الغر حول بيوتهم % % ذئاب الغضا يمرحن في كل مرود % % 30(@)(@@) % إذا ما انتشوا هزوا رؤوسا كريمة % لها طرب بالجود قبل التغرد % % PageV01P565 31(@)(@@) % تراموا بها حمراء تحسب شربها % % ذوي قرة حفوا جوانب موقد % % 32(@)(@@) % لهم سامر تحت الظلام وراكد % % على النار يذكيها بضال وغرقد % % 33(@)(@@) % يقول الفتى منهم لراعي عشاره : % الا لا تقيدها بغير المهند % % 34(@)(@@) % مضى النجباء الاطولون كانهم % % صدور القنا في الشرعبي المعضد % % 35(@)(@@) % رمت فيهم بعد التئام وألفة % يد الاربى صدع البلاط الممرد % % 36(@)(@@) % تشظوا تشظي العود تجري فروعه % % على ثغرها خرقاء مجنونة اليد % 37(@)(@@) % تكبهم الايام عم جمحاتها % % كما كب اعجاز الهدي المقلد % % 38(@)(@@) % خلت بهم الاجداث عنا واطبقت % % على المجد منهم كل بيداء قردد % 39(@)(@@) % فمن يعدل الميلاء أو يرأب الثأي % % وياخذ من ريب الزمان على يد % % 40(@)(@@) % تفانوا على كسب العلى ، وتجرعوا % % بايديهم كاس الردى جرع الصدي % % PageV01P566 41(@)(@@) % كما رض في مر السيول عشية % ذرى جلمد صعب الذرى قرع جلمد % 42(@)(@@) % الا في سبيل المجد ثاوون لم نكن % % قبورهم غير الدلاص المسرد % 43(@)(@@) % وكانوا أحاديث الرفاق ، فأصبحوا % % أغاني للغوري والمتنجد % 44(@)(@@) % لعا لكم من عاثرين تتابعوا % % على زلل الأقدام عثر المقيد % 45(@)(@@) % أفي كل يوم قطرة من دمائكم % تمسحها من ظفر شنعاء موئد % % 46(@)(@@) % ملوك وإخوان كأني بعدهم % على قرب من خمس يوم عمرد % % 47(@)(@@) % عراعر ينزو القلب عند ادكارهم % نزاء الدبى بالامعز المتوقد % % 48(@)(@@) % سقاكم ولولا عادة عربية % % لقل لكم قطر الحبي المنضد % 49(@)(@@) % من المزن رجراح العباب 
ms166	 ، كأنه % من البطء ترجاف الكسير المقود % 50(@)(@@) % تخال على هام الربى من ربابه % عناصي هامات الحجيج الملبد % % PageV01P567 51(@)(@@) % ترادف يزجي كلكلا بعد كلكل % % تطلع ركب من أبانين منجد % 52(@)(@@) % خفى برقه ثم استطار كأنه % يشقق هداب الملاء المعمد % % 53(@)(@@) % لجأنا من الدنيا إلى مستقرة % % تنولنا عذب الجنا وكان قد % % 54(@)(@@) % علقنا جماد النيل ناقصة الجدا % % تروح علينا بالغرور وتغتدي % % 55(@)(@@) % أمن بعدهم أرجو الخلود وهذه % سبيلي ومن تلك الشرائع موردي % % 56(@)(@@) % فان انج من ذا اليوم قاطع ربقة % % فقصري من ريب المنون على غد % 57(@)(@@) % سواء مخلى للمنايا اكيلة % % ومن راح منا في التميم المعقد % 58(@)(@@) % فقل لليالي بعدهم : هاك مقودي % % تقضى ايابي فاصدري بي أو وردي % % 59(@)(@@) % ودونك من ظهري وقد غال أسرتي % % طريق الردى ظهر الذلول المعبد % % 60(@)(@@) % بأي يد ارمى الزمان وساعد % % وكانوا يدي أعطيتها الخطب عن يدي % % PageV01P568 61(@)(@@) % وما كان صبري عنهم من جلادة % % أبى الوجد لي بل عادة من تجلدي % % PageV01P569 البحر : وافر تام 1(@)(@@) % الا من يمطر السنة الجمادا % % ومن للجمع يطلعه النجادا % % 2(@)(@@) % ومن للخيل يقبلهن شعثا % ويركبهن شقرا ، أو ورادا % % 3(@)(@@) % غداة الروع ينعلها الهوادي % % من الاعداء واللمم الجعادا % % 4(@)(@@) % مجلجة كأن بها اواما % إلى وقع الصوارم أو جوادا % % 5(@)(@@) % يسامحها القياد إلى المعالي % % و عند الضيم يمطلها القيادا % % 6(@)(@@) % ومن للحرب ينضح ذفرييها % % ويعركها جلادا أو طرادا % % 7(@)(@@) % يبدل من دم الاعداء فيها % % لصارمه الحمائل والعمادا % % 8(@)(@@) % هوى قمر اللانام وكان اوفى % % على قمر التمام على وزادا % % 9(@)(@@) % فقل للقلب : لبك والتعزي % % و ثقل للعين جفنك والرقادا % % 10(@)(@@) % مصائب لا أنادي الصبر فيها % % و لا أدعى اليه ولا انادي % % PageV01P570 11(@)(@@) % اللعينين قد قذيا بكاء % % أم الجنبين قد قلقا وسادا % % 12(@)(@@) % كأن الوسم شعشع فيه قين % بجذوته علطت به الفوادا % % 13(@)(@@) % من القوم الأولى ملأوا الليالي % % إلى أصبارها كرما وآدا % % 14(@)(@@) % ورسوا في فواغر كل خطب % صدور البيض والزرق الحدادا % % 15(@)(@@) % اذا صاب الحيا ببلاد ضيم % % جلوا عنهن ، وانتجعوا بلادا % % 16(@)(@@) % هم الجبل 
ms167	 المطل على الأعادي % % إذا رجم الزمان به ، ورادا % % 17(@)(@@) % لهم حسب اذا نقبت عنه % % تضرم جمرة وورى زنادا % % 18(@)(@@) % لهم أنف يذب الضيم عنهم % % ورأي يفرج الكرب الشدادا % % 19(@)(@@) % و ايمان اذا مطرت عطاء % % حسبت الناس كلهم جوادا % % 20(@)(@@) % ترى رأي الفتى فيهم مطاعا % و قول المرء منهم مستعادا % % PageV01P571 21(@)(@@) % و قد بلغوا من العلياء اقصى % % ذوائبها وما بلغوا المرادا % % 22(@)(@@) % اشت جميعهم صرف الليالي % % 23(@)(@@) % مصابك لم يدع قلبا ضنينا % بلغته ولا عينا جمادا % % 24(@)(@@) % كأن الناس بعدك في ظلام % أو الأيام ألبست الحدادا % % 25(@)(@@) % وكنت أفدت خلته ، ولكن % افادني الزمان وما افادا % % 26(@)(@@) % فإن لم أبكه قربى تلاقت % مغارسها بكيت له ودادا % % 27(@)(@@) % يعز علي ان اطويه صفحا % وأذهب عنه نأيا أو بعادا % % 28(@)(@@) % تعز أبا علي ان خطبا % على العلاة يبلغ ما ارادا % % 29(@)(@@) % هو القدر الذي خبطت يداه % % 30(@)(@@) % وضعضع كل من حمل العوالي % % و ارجل كل من ركب الجيادا % % PageV01P572 31(@)(@@) % يعرى ظهر اكثرنا عديدا % و يهجم بيت اطولنا عمادا % % 32(@)(@@) % كذاك الدهر إن أبقى قليلا % أحال على بقيته ، وعادا % % 33(@)(@@) % وبينا المرء يجنيه ثمارا % إلى ان عاد يخرطه قتادا % % 34(@)(@@) % و اقرب ما ترى فيه انتقاصا % إذا ما قيل قد كمل ازديادا % % 35(@)(@@) % و نعلم ان سيوجرنا مرارا % باية ان يلمظنا شهادا % % 36(@)(@@) % وما تجدي الدموع على فقيد % و لو غسلت من العين السوادا % % 37(@)(@@) % و كنت مقلدا منها حساما % على الأعداء داهية نآدى % % 38(@)(@@) % فنافسك الردى في مضربيه % فبز النصل ، واختلع النجادا % % 39(@)(@@) % فناد اليوم غير أبي شجاع % % و صم أبا شجاع ان ينادى % % 40(@)(@@) % حدى غير الغمام اليه كوما % % تعز على المقاد أن تقادا % % PageV01P573 41(@)(@@) % نزائع من رياح الغور شبت % % على القلل البوارق والرعادا % % 42(@)(@@) % مخضن بهن مخض الوطب حتى % % اذا جلجلن اطلقن المزادا % % 43(@)(@@) % تلامحت البروق بجانبيها % % كأن لها انحلالا وانعقادا % % 44(@)(@@) % كأن بهن راعي مرزمات % ابس فحرك الخور الجلادا % % 45(@)(@@) % فيا للناس اوقره ترابا % و استسقي لاعظمه العهادا % % 46(@)(@@) % وما السقيا 
ms168	 لتبلغه ، ولكن % وجدت لها على قلبي برادا % % PageV01P574 البحر : طويل 1(@)(@@) % سلا ظاهر الأنفاس عن باطن الوجد % فان الذي اخفي نظير الذي ابدي % % 2(@)(@@) % زفيرا ، تهاداه الجوانح كلما % % تمطي بقلبي ضاق عن مره جلدي % % 3(@)(@@) % وكيف يرد الدمع ، يا عين ، بعدما % % تعسف اجفاني وجار على خدي % % 4(@)(@@) % وإني إن أنضح جواي بعبرة % يكن كخبي النار يقدح بالزند % 5(@)(@@) % فهذي جفوني من دموعي في حيا % و هذا جناني من غليلي في وقد % % 6(@)(@@) % حلفت بما وارى الستار ، وما هوت % إليه رقاب العيس ترقل أو تخدي % % 7(@)(@@) % لقد ذهب العيش الرقيق بذاهب % هو الغارب المجزول من ذروة المجد % 8(@)(@@) % وإني ، إذا قالوا مضى لسبيله % وهيل عليه الترب من جانب اللحد % 9(@)(@@) % كساقطة إحدى يديه إزاءه % وقد جبها صرف الزمان من الزند % 10(@)(@@) % وقد رمت الأيام من حيث لا أرى % % صميمي بالداء العنيف على عمد % PageV01P575 11(@)(@@) % فلا تعجبا أني نحلت من الجوى % % فايسر ما لاقيت ما حز في الجلد % % 12(@)(@@) % ولو أن رزءا غاض ماء لكانه % وجفت له خضر الغصون من الرند % 13(@)(@@) % سقى قبره مستمطر ذو غفارة % % يجر عليه عرف ملآن مربد % % 14(@)(@@) % إذا قلت : قد خفت متاليه أرزمت % وأجلب بالبرق المشقق والرعد % 15(@)(@@) % حسام جلا عنه الزمان ، فصممت % مضاربه حينا ، وعاد إلى الغمد % 16(@)(@@) % سنان تحدته الدروع بزغفها % % فبدد اعيان المضاعف والسرد % % 17(@)(@@) % جواد جرى حتى استبد بغاية % % تقطع أنفاس الجياد من الجهد % 18(@)(@@) % سحاب علا حتى تصوب مزنه % وأقلع لما عم بالعيشة الرغد % 19(@)(@@) % ربيع تجلى ، وانجلى ، ووراءه % ثناء كما يثني على زمن الورد % % 20(@)(@@) % نعض على الموت الأنامل حسرة % و ان كان لا يغني غناء ولا يجدي % % PageV01P576 21(@)(@@) % وهل ينفع المكلوم عض بنانه % % ولو مات من غيظ على الاسد الورد % % 22(@)(@@) % عوار من الدنيا يهون فقدها % % تيقننا ان العواري للرد % % 23(@)(@@) % ينال الردى من يعرض الهضب دونه % % ولو كان في غور من الأرض أو نجد % 24(@)(@@) % ويسلم من تسقى الاسنة حوله % % بيدي الكماة المعلمين على الجرد % % 25(@)(@@) % فما ذاك ان 
ms169	 لم يلق حتفا بخالد % % ولا ذا من الحتف المطل على بعد % 26(@)(@@) % لئن ثلمت مني الليالي عشائري % % فما ثلموا الا من الحسب العد % % 27(@)(@@) % شجوني ولم يبقوا لعيني بلة % % من الدمع الا استفرغوها من الوجد % % 28(@)(@@) % عزاءك ، فالأيام أسد مذلة % تعط الفتى عط المقاريض للبرد % 29(@)(@@) % إذا أوردته نهلة من نعيمها % % اعادته حران الضلوع من الورد % % 30(@)(@@) % أغل إلى القلب المنيع من القنا % % واجري إلى الآجال من قضب الهند % % PageV01P577 31(@)(@@) % أراد بك الحساد أمرا ، فرده % عليهم سفاه الراي والراي قد يردي % % 32(@)(@@) % فلا يغمدن السطو والحلم ضائر % وقد نزع الاعداء آصرة الود % % 33(@)(@@) % هم قعقعوا بغيا عليك واجلبوا % % فآبوا وما قاموا بحل ولا عقد % % 34(@)(@@) % وقد ركبوه مرة بعد مرة % فيا لذلول البغي من مركب مردي % % 35(@)(@@) % فحتى متى تغضى مرارا على القذى % % وتلحظك الاضغان من مقل رمد % % 36(@)(@@) % فإن لا تصل تصبح عداك كثيرة % عليك ، وداء الطعن إن هبته يعدي % % 37(@)(@@) % وهل كان ذاك البعد إلا تنزها % على المضمر البغضاء والحاسد الوغد % 38(@)(@@) % وجئت مجيء البدر أخلق ضوءه % فعاد جديد النور بالطالع السعد % 39(@)(@@) % وكم من عدو قد سرى فيك كيده % % سرى السم من رقطاء ذات قرا جعد % 40(@)(@@) % فأغفلته ثم انتضيت عزيمة % نزعت بها من قلبه حمة الحقد % PageV01P578 41(@)(@@) % وذي خطل أوجرته منك غصة % فأطرق منها لا يعيد ولا يبدي % % PageV01P579 البحر : طويل 1(@)(@@) % أتاني ، ورحلي بالعذيب ، عشية % وايدي المطايا قد قطعن بنا نجدا % % 2(@)(@@) % نعي أطار القلب عن مستقره % وكنت على قصد فاغلطني القصدا % % 3(@)(@@) % فليت نعى الركب العراقي غيره % فما كل مفقود وجعت له فقدا % % 4(@)(@@) % ويا ناعييه اليوم غضا على قذى % فقد زدتما قلبي على وجده وجدا % % 5(@)(@@) % فبئس ، على بعد اللقاء ، تحية % احيي بها تذكى على كبدي وقدا % % 6(@)(@@) % برغمي ان اوردت قبلي بمورد % % تبرضت منه لا زلالا ولا بردا % % 7(@)(@@) % جزتك الجوازي عن عماد اقمتها % % وعن عقد للدين أحكمتها شدا % % 8(@)(@@) % وذي جدل ألجمت فاه بغصة % تلجلج فيه لا مساغا ولا ردا % % 9(@)(@@) % قعست 
ms170	 له حتى التقيت سهامه % وأثبت في تاموره الحجج اللدا % % 10(@)(@@) % ومزلقة للقول ما شئت دحضها % % وقد زل عنها من اعاد ومن ابدى % % PageV01P580 11(@)(@@) % وإني لأستسقي لك الله عفوه % ويالك غيثا ما اعم وما اندى % % 12(@)(@@) % واخلق بمن كان النبي ورهطه % % محامين عنه ان يفوز ولا يردى % % 13(@)(@@) % بكيتك حتى استنفد الدمع ناظري % % ولو مدني دمعي عليك لما اجدى % % PageV01P581 البحر : كامل تام 1(@)(@@) % أعلمت من حملوا على الأعواد % أرأيت كيف خبا ضياء النادي % % 2(@)(@@) % جبل هوى لو خر في البحر اغتدى % % من وقعه متتابع الإزباد % 3(@)(@@) % ما كنت اعلم قبل حظك في الثرى % % ان الثرى بعلو على الاطواد % % 4(@)(@@) % بعدا ليومك في الزمان فانه % % أقذى العيون وفت في الأعضاد % 5(@)(@@) % لا ينفد الدمع الذي يبكى به % إن القلوب له من الأمداد % 6(@)(@@) % كيف انمحى ذاك الجناب وعطلت % % تلك الفجاج وضل ذاك الهادي % % 7(@)(@@) % طاحت بتلك المكرمات طوائح % وعدت على ذاك الجواد عوادي % % 8(@)(@@) % قالوا : أطاع وقيد في شطن الردى % % ايدي المنون ملكت اي قياد % % 9(@)(@@) % من مصعب لو لم يقده الاهه % % بقضائه ما كان بالمنقاد % 10(@)(@@) % هذا أبو إسحق يغلق رهنه % هل ذا يد أو مانع أو فاد % % PageV01P582 11(@)(@@) % لو كنت تفدى لافتدتك فوارس % مطروا بعارض كل يوم طراد % 12(@)(@@) % واذا تألق بارق لوقيعة % % والخيل تفحص بالرجال بداد % % 13(@)(@@) % سلوا الدروع من العباب ، وأقبلوا % % من جانبيك مقاود العواد % 14(@)(@@) % لكن رماك مجبن الشجعان عن % % إقدامهم ، ومضعضع الأنجاد % 15(@)(@@) % كالليث يوهن بالتراب ، ويمتلي % % نوما على الأضغان والأحقاد % 16(@)(@@) % والدهر تدخل نافذات سهامه % مأوى الصلال ومربض الاساد % % 17(@)(@@) % ألقى الجران على عنطنط حمير % فمضى ، ومد يدا لأحمر عاد % 18(@)(@@) % اعزز علي بان يفارق ناظري % % لمعان ذاك الكوكب الوقاد % 19(@)(@@) % اعزز علي بان نزلت بمنزل % % متشابه الأمجاد والأوغاد % 20(@)(@@) % في عصبة جنبوا إلى آجالهم % والدهر يعجلهم عن الإرواد % PageV01P583 21(@)(@@) % ضربوا بمدرجة الفناء قبابهم % من غير أطناب ، ولا أوتاد % 22(@)(@@) % ركب اناخوا لا يرجى منهم % % قصد لاتهام ولا انجاد % % 23(@)(@@) % كرهوا النزول فانزلتهم وقعة % % للدهر 
ms171	 باركة بكل مقاد % % 24(@)(@@) % فتهافتوا عن رحل كل مذلل % وتطاوحوا عن سرج كل جواد % 25(@)(@@) % بادون في صور الجميع ، وإنهم % متفردون تفرد الآحاد % 26(@)(@@) % مما يطيل الهم أن أمامنا % % طول الطريق وقلة الازواد % % 27(@)(@@) % عمري ! لقد أغمدت منك مهندا % في الترب كان ممزق الاغماد % % 28(@)(@@) % قد كنت اهوى ان اشاطرك الردى % % ولكن اراد الله غير مراد % % 29(@)(@@) % ولقد كبا طرف الرقاد بناظري % % اسفا عليك فلا لعا لرقاد % % 30(@)(@@) % ثكلتك ارض لم تلد لك ثانيا % أنى ، ومثلك معوذ الميلاد % PageV01P584 31(@)(@@) % من للبلاغة والفصاحة إن همى % % ذاك الغمام وعب ذاك الوادي % % 32(@)(@@) % من للملوك يجز في اعدائها % % بظبى من القول البليغ حداد % 33(@)(@@) % من للممالك لا يزال يلمها % % بسداد امر ضائع وسداد % % 34(@)(@@) % من للجحافل يستزل رماحها % % ويرد رعلتها بغير جلاد % % 35(@)(@@) % من للموارق يسترد قلوبها % % بزلازل الإبراق والإرعاد % 36(@)(@@) % وصحايف فيها الأراقم كمن % مرهوبة الاصدار والايراد % % 37(@)(@@) % تدمى طوائعها اذا استعرضتها % % من شدة التحذير والإيعاد % 38(@)(@@) % حمر على نظر العدو كأنما % % بدم يخط بهن لا بمداد % % 39(@)(@@) % يقدمن إقدام الجيوش ، وباطل % أن ينهزمن هزائم الأجناد % 40(@)(@@) % فقر بها تمسى الملوك فقيرة % % أبدا إلى مبدى لها ومعاد % PageV01P585 41(@)(@@) % وتكون صوتا للحرون اذا ونى % % وعنان عنق الجامح المتمادي % % 42(@)(@@) % ترقي ، وتلذع في القلوب ، وإن يشا % % حط النجوم بها من الأبعاد % 43(@)(@@) % ان الدموع عليك غير بخيلة % % والقلب بالسلوان غير جواد % 44(@)(@@) % سودت ما بين الفضاء وناظري % % وغسلت من عيني كل سواد % % 45(@)(@@) % ري الخدود من المدامع شاهد % % أن القلوب من الغليل صواد % 46(@)(@@) % ما كنت اخشى ان نضن بلفظة % % لتقوم بعدك لي مقام الزاد % % 47(@)(@@) % ماذا الذي منع الفنيق هديره % % من بعد صولته على الاذواد % % 48(@)(@@) % ماذا الذي حبس الجواد عن المدى % % من بعد سبقته إلى الآماد % % 49(@)(@@) % ماذا الذي فجع الهمام بوثبة % % وعدا على دمه ، وكان العادي % % 50(@)(@@) % قل للنوائب عددي ايامه % % يغنى عن التعديد بالتعداد % PageV01P586 51(@)(@@) % حمال ألوية العلاء بنجدة % كالسيف يغني عن مناط نجاد % % 52(@)(@@) % قلصت اظلة كل فضل بعده 
ms172	 % % وأمر مشربها على الوراد % 53(@)(@@) % لقضى لسانك مذ ذوت ثمراته % % أن لا دوام لنضرة الأعواد % 54(@)(@@) % وقضى جنابك مذ قضت وقداته % % أن لا بقاء لقدح كل زناد % 55(@)(@@) % بقيت اعيجاز يضل تبيعها % % ومضت هواد للرجال هواد % 56(@)(@@) % يا ليت أني ما اقتنيتك صاحبا % كم قنينة جلبت اسى لفؤادي % % 57(@)(@@) % إن لم تسف إلى التناسل نفسه % كفي الأسى بتفاقد الأوداد % 58(@)(@@) % برد القلوب لمن تحب بقاءه % % مما يجر حرارة الاكباد % % 59(@)(@@) % ليس الفجائع بالذخائر مثلها % % باماجد الاعيان والافراد % % 60(@)(@@) % ويقول من لم يدركنهك انهم % % نقصوا به عددا من الاعداد % % PageV01P587 61(@)(@@) % هيهات ! أدرج بين برديك الردى % % رجل الرجال وأوحد الآحاد % 62(@)(@@) % لا تطلبي يا نفس خلا بعد % % فلمثله اعيي على المرتاد % % 63(@)(@@) % فقدت ملائمة الشكول بفقده % % وبقيت بين تباين الأضداد % 64(@)(@@) % ما مطعم الدنيا بحلو بعده % % أبدا ، ولا ماء الحيا ببراد % 65(@)(@@) % الفضل ناسب بيننا ان لم يكن % % شرفي مناسبه ولا ميلادي % % 66(@)(@@) % إن لم تكن من أسرتي وعشيرتي % % فلا انت اعلقهم يدا بوداد % % 67(@)(@@) % لو لم يكن عالي الاصول فقد وفى % % شرف الجدود بسؤدد الاجداد % % 68(@)(@@) % لا در دري ان مطلتك ذمة % % في باطن متغيب ، أو باد % 69(@)(@@) % إن الوفاء ، كما اقترحت ، فلو يكن % حيا اذا ما كنت بالمزداد % % 70(@)(@@) % ليس التنافث بيننا بمعاود % % أبدا ، وليس زماننا بمعاد % PageV01P588 71(@)(@@) % ضاقت علي الأرض بعدك كلها % % وتركت اضيقها علي بلادي % % 72(@)(@@) % لك في الحشى قبر وان لم تأوه % % ومن الدموع روائح وغوادي % % 73(@)(@@) % سلوا من الابراد جسمك وانثنى % % جسمي يسل عليك في الأبراد % 74(@)(@@) % كم من طويل العمر بعد وفاته % % بالذكر يصحب حاضرا ، أو بادي % % 75(@)(@@) % ما مات من جعل الزمان لسانه % يتلو مناقب عودا وبوادي % % 76(@)(@@) % فاذهب كما ذهب الربيع واثره % % باق بكل خمايل ونجاد % % 77(@)(@@) % لا تبعدن وأين قربك بعدها % % إن المنايا غاية الأبعاد % 78(@)(@@) % صفح الثرى عن حر وجهك انه % % مغرى بطي محاسن الامجاد % % 79(@)(@@) % وتماسكت تلك البنان فطالما % % عبث البلى بانامل الاجواد % % 80(@)(@@) % وسقاك فضلك إنه أروى حيا % من 
ms173	 رائح متعرس ، أو غاد % PageV01P589 81(@)(@@) % حدث على أن لا نبات بأرضه % وقفت عليه مطالب الرواد % % PageV01P590 البحر : مديد تام 1(@)(@@) % ترك الدنيا لطالبها % % ورضى بالدون مقتصدا % % 2(@)(@@) % نافرا منها فليس يرى % % بالاماني آنسا ابدا % % 3(@)(@@) % بعد ان نال العلا وما % % زال ينمي جده صعدا % % 4(@)(@@) % نفض الأطماع عن يده % % واستخار الواحد الأحدا % % 5(@)(@@) % ورأى أن لا نجاة له % فمضى يبغي النجاة غدا % % PageV01P591 البحر : مجزوء الكامل 1(@)(@@) % يا غائبا نقض الودادا % % اشمت بالقرب البعادا % % 2(@)(@@) % وتركتني ، والشوق يأ % % بى ان يروح لي فوادا % % 3(@)(@@) % تأبى سوابق عبرتي % % ان تخدع المقل الرقادا % % 4(@)(@@) % لو أن طرفي سار نح % وك لاتخذت النوم زادا % % 5(@)(@@) % فارجع إلى رسم الصفا % % ء ، فإنه إن عدت عادا % % 6(@)(@@) % ودع العدى فوحرمة % % العلياء لا بلغوا المرادا % % 7(@)(@@) % بسطوا لنا أيدي النوا % % ل ، وما نرى منهم جوادا % % 8(@)(@@) % قلبي أسير في حبا % % لك لا أؤمل أن يقادا % % 9(@)(@@) % اعجلت قلبي ان يمس الهجر % % فاستلب الودادا % % 10(@)(@@) % يا بائعي بالنزر مخ % تارا ليبلغ ما أرادا % % PageV01P592 11(@)(@@) % ان جدت بي فليند من % % من كان بي يوما جوادا % % 12(@)(@@) % من ضاع مثلي من يدي % ه ، فليت شعري ما استفادا % % 13(@)(@@) % لا يلبس الود الطريف % % ف مجامل خلع التلادا % % PageV01P593 البحر : مديد تام 1(@)(@@) % مثال ودي لا يغيره % % لك هجران ولا بعد % % 2(@)(@@) % وجفوني لا يزال بها % % طيف حلم منك يطرد % 3(@)(@@) % وضميري أنت تعلمه % لك لا يلوي به أحد % % 4(@)(@@) % يا مقيد الشوق من كبدي ! % آه لا صبر ، ولا جلد % 5(@)(@@) % جرحتني منك جارحة % كل اعضائي لها عدد % % PageV01P594 البحر : مديد تام 1(@)(@@) % اترى الاحباب مذ ظعنوا % % وجدوا للبين ما أجد % 2(@)(@@) % لا يبت ذاك الحبيب كما % % بات هذا القلب والكبد % 3(@)(@@) % كان زورا بعد بينهم % % وغرورا ذلك الجلد % 4(@)(@@) % ومتى تدن الديار بهم % يجدوا قلبي كما عهدوا % % PageV01P595 البحر : طويل 1(@)(@@) % خذي نفسي ياريح من جانب الحمى % % فلاقي بها ليلا نسيم ربى نجد % 2(@)(@@) % فان بذاك الحي الفا عهدته % % وبالرغم مني أن يطول به عهدي 
ms174	 % % 3(@)(@@) % ولولا تداوي القلب من ألم الجوى % % بذكر تلاقينا قضيت من الوجد % 4(@)(@@) % ويا صاحبي اليوم عوجا لتسئلا % % ركيبا من الغورين أنضاؤهم تخدي % % 5(@)(@@) % عن الحي بالجرعاء جرعاء مالك % % هل ارتبعوا واخضر واديهم بعدي % % 6(@)(@@) % كأن بعيني بعدهم غائر القذى % % إذا أنا لم أنظر إلى العلم الفرد % 7(@)(@@) % شممت بنجد شيحة حاجرية % % فأمطرتها دمعي ، وأفرشتها خدي % % 8(@)(@@) % ذكرت بهاريا الحبيب على النوى % % وهيهات ذا يا بعد بينهما عندي % % 9(@)(@@) % واني لمجلوب لي الشوق كلما % % تنفس شاك ، أو تألم ذو وجد % 10(@)(@@) % تعرض رسل الشوق والركب هاجد % % فتوقظني من بين نوامهم وحدي % % PageV01P596 11(@)(@@) % فقلت لاصحابي الا تتزافروا % % رويدكم ! إن الهوى داؤه يعدي % % 12(@)(@@) % وما شرب العشاق الا بقيتي % % ولا وردوا في الحب الا على وردي % % PageV01P597 البحر : طويل 1(@)(@@) % أقول وقد جاز الرفاق بذي النقا % % ودون المطايا مربخ وزرود % 2(@)(@@) % اتطلب يا قلبي العراق من الحمى % % ليهنك من مرمى عليك بعيد % % 3(@)(@@) % وإن حديث النفس بالشيء دونه % رمال النقا من عالج لشديد % % 4(@)(@@) % ترى اليوم في بغداد اندية الهوى % % لها مبدي من بعدنا ومعيد % % 5(@)(@@) % فمن واصف شوقا ومن مشتك حشا % رمته المرامي أعين وخدود % 6(@)(@@) % تلفت حتى لم يبن من بلادكم % % دخان ولا من نارهن وقود % 7(@)(@@) % وان التفات القلب من بعد طرفه % % طوال الليالي نحوكم ليزيد % % 8(@)(@@) % ولما تدانى البين قال لي الهوى : % رويدا وقال القلب اين تريد % % 9(@)(@@) % اتطمع ان تسلوا على البعد والنوى % % وانت على قرب المزار عميد % % 10(@)(@@) % ولو قال لي الغادون ما انت مشته % % غداة جزعنا الرمل قلت اعود % % PageV01P598 11(@)(@@) % أأصبر ، والوعساء بيني وبينكم % % واعلام خبت انني لجليد % % PageV01P599 البحر : منسرح 1(@)(@@) % يا طيب نجد ، وحسن ساكنه % لو انهم انجزوا الذي وعدوا % % 2(@)(@@) % قالوا ، وقد قربت ركائبنا % % والقلب يظما بهم ولا يرد % % 3(@)(@@) % أتارك أرضنا ، فقلت لهم : % انجد قلبي واعرق الجسد % % PageV01P600 البحر : رجز تام 1(@)(@@) % صدت وما كان لها الصدود % % وازور عني طرفها والجيد % 2(@)(@@) % يقول لما اخلق الجديد % % اذا البجال ذلك الوليد % % 3(@)(@@) % يا ابن ذاك 
ms175	 الخضل الاملود % % ريان من ماء الصبا يميد % % 4(@)(@@) % تصحبه اللحظ العذارى الغيد % غدا الغزال اليوم ، وهو سيد % 5(@)(@@) % قلت : نعم ! ذاك الذي أريد % مضى حبيب قلما يعود % % 6(@)(@@) % لشد ما اوجعني الفقيد % % أيامنا بعد البياض سود % PageV01P601 البحر : كامل تام 1(@)(@@) % أأميم ! إن أخاك غض جماحه % بيض طردن عن الذوائب سودا % % 2(@)(@@) % عقب الجديد إذا مررن على الفتى % % مر الفوادح لم يدعن جديدا % % 3(@)(@@) % قد كان قبلك للحسان طريدة % فاليوم راح عن الحسان طريدا % % 4(@)(@@) % حولن عنه نواظرا مزورة % نظر القلى ولوين عنه خدودا % % 5(@)(@@) % نشد التصابي ، بعد ما ضاع الصبا % % غرضا ، لعمرك يا أميم ، بعيدا % % PageV01P602 البحر : متقارب تام 1(@)(@@) % تحنل جيراننا عن منى % % وقالوا : النقا بيننا موعد % 2(@)(@@) % وهل ناقع قول ذي غلة % وقد بعد الركب لا يبعدوا % % 3(@)(@@) % تنادوا بان التناءي غدا % % لك السوء من طالع ، يا غد % 4(@)(@@) % فلله ما جمع المازمان % % وجمع لقلبي والمسجد % % 5(@)(@@) % يضاع فينشد قعب الغبوق % % وقلبي يضاع ولا ينشد % % 6(@)(@@) % وغيداء من ماطلات الديون % % لها بالحمى زمن أغيد % 7(@)(@@) % تريع كما التفتت ظبية % بذي البان عن لها المورد % 8(@)(@@) % نظرت وهيهات من ناظريك % % ظباء تهامة يا منجد % % 9(@)(@@) % ويا ربما ، والهوى ضلة % ترى العين ما لا تنال اليد % PageV01P603 البحر : طويل 1(@)(@@) % سقى الله يوما ساعدتنا كؤوسه % % على خحين ماجاد الزمان بمسعد % % 2(@)(@@) % جلونا عليه الخمر حتى تكشفت % فواقعها عن لونها المتورد % 3(@)(@@) % نفض لنا عنها حبابا كأنه % قذى يتمشى بين أجفان أرمد % 4(@)(@@) % وندمان صدق تسلب الراح عقله % % وتسلبها خداه حسن التورد % % 5(@)(@@) % فلا زالت الأيام تجري صروفها % % علينا بمغبوط من العيش سرمد % PageV01P604 البحر : متقارب تام 1(@)(@@) % حططت المكارم عن عاتقي % % و جردني الذل عن محتدي % % 2(@)(@@) % و الا فلا امني النازلون % % ولا جاءني الطارق المجتدي % % 3(@)(@@) % و لا قلت اني عند الفخ % % ر ، إلا لغير أبي أحمد % 4(@)(@@) % متى حلت عن ودك المصطفى % % و اخلف ما رمته مولدي % % 5(@)(@@) % سألقاك بالعهد عند المشيب % و ها أنا في حلية الامرد % % 6(@)(@@) % وإني ، إذا 
ms176	 لم أجد ناصرا % وجدتك انصر لي من يدي % % 7(@)(@@) % خذ الوقت واعلم بان اللبي % % ب يأخذ من يومه للغد % % 8(@)(@@) % فما ينفع المرء بعد المنون % % قول النوادب لا تبعد % % 9(@)(@@) % على انني تحفة للصديق % % يروح بنجواي ، أو يغتدي % % 10(@)(@@) % و اني ليأنس بي الزائر % % أنيس النواظر بالأثمد % PageV01P605 11(@)(@@) % تغمض لي أعين الحاسدين % كالشمس في ناظر الأرمد % 12(@)(@@) % فلا دخل البعد ما بيننا % % ولا فك منا يدا عن يد % 13(@)(@@) % و طول ايامنا بالمقام % % في ظل عيش رقيق ندي % % PageV01P606 البحر : كامل تام 1(@)(@@) % هب للديار بقية الجلد % ودع الدموع وباعث الكمد % % 2(@)(@@) % واذهب بنفسك أن يقال سلا % % وصفا لداعي العذل والفند % 3(@)(@@) % اتصد عن طلل رغيت به % % ما شئت من هيف ومن غيد % % 4(@)(@@) % طوت الليالي من معارفه % ما كان من علم ومن نضد % % 5(@)(@@) % أمسى الهوى فيه بلا أثر % وجرى البلى فيه بلا امد % % 6(@)(@@) % ولقد عهدت رباه جامعة % % بين الظباء الغيد والاسد % % 7(@)(@@) % أيام من فتك الغرام به % يمشي بلا عقل ولا قود % % 8(@)(@@) % ان الاولى بعثوا ببينهم % % ما زودوا في القرب للبعد % % 9(@)(@@) % ما ضرهم ، والبين يحفزهم % لو عللونا بانتظار غد % % 10(@)(@@) % وجدوا وما جادوا ، ومحتقب % للوم من اثري ولم يجد % % PageV01P607 11(@)(@@) % ليت الذي علق الرجاء به % اذ لم يجد للصب لم يجد % % 12(@)(@@) % ولقد رأيتهم ، وحيهم % متقعقع الأطناب والعمد % 13(@)(@@) % فكانما اقنى براثنه % % ينشبن بين القلب والكبد % % 14(@)(@@) % وغريرة خلف السجوف لها % % نسب إلى أومانة العقد % 15(@)(@@) % خرجت خروج الريم عاطلة % ولجيدها حلي من الجيد % 16(@)(@@) % تجري الاراك على مفلجة % % يجرين من شهد على برد % 17(@)(@@) % عني اليك فلست من اربي % % ما انت من غيبي ومن رشدي % % 18(@)(@@) % قضت الليالي منك مأربتي % % ونفضت من علق الغرام يدي % % 19(@)(@@) % وحدا النهى والشيب راحلتي % % على استقاماتي على الجدد % % 20(@)(@@) % فاليوم اتبع الزمام وهل % % يغني اباي اليوم أو صيدي % % PageV01P608 21(@)(@@) % لا تقر يا ضيف الهموم قرى % % الا قرى العيرانة الأجد % % 22(@)(@@) % وانهض ، فإن لم تحظ في بلد % بالرزق فاقطعه اللا 
ms177	 بلد % % 23(@)(@@) % وابغ العلى أبدا ، فكم طلب % قد بات من نيل على صدد % % 24(@)(@@) % اما يقال سعى فاحرزها % % أو أن يقال ، مضى ، ولم يعد % 25(@)(@@) % قولا لهذا الدهر معتبة % % اسرفت بي يا دهر فاقتصد % % 26(@)(@@) % كم لوعة تهدي إلى كبدي % % وغرائب ما درن في خلدي % % 27(@)(@@) % ايصاح بي عن كل صافية % % طردا إلى الأقذاء والثمد % 28(@)(@@) % وأسام في أكلاء موبئة % محتشها دون السوام ردي % % 29(@)(@@) % هل نافعي ، والجد في صبب % مري مع الآمال في صعد % 30(@)(@@) % أمسى علي مع الزمان أخ % قد كنت آمل يومه لغد % PageV01P609 31(@)(@@) % من كان احنى عند نائبة % % من والدي وابر من ولدي % % 32(@)(@@) % لم يثمر الظن الجميل به % فقدي من الظن الجميل قدي % % 33(@)(@@) % لو كان ما بيني وبينكم % بيني وبين الذئب والاسد % % 34(@)(@@) % لأويت من هذا إلى حرم % ولجأت من هذا على عضد % 35(@)(@@) % ولاصبحا في الروع من عددي % % كرما وفي اللأواء من عددي % % 36(@)(@@) % ولمانعا عني ، إذا جعلت % نوب الزمان تهيض من جلدي % % 37(@)(@@) % أو كان ما قدمت من مقة % سببا إلى البغضاء لم يزد % % 38(@)(@@) % بل لو قذفت بمدحتي لكم % % في البحر ذي الامواج والزبد % % 39(@)(@@) % لرمي الي اشف جوهرة % % وسقى باعذب مائه بلدي % % 40(@)(@@) % كم من مطالب قد عقدت بها % % طمعي ، فحل مرائر العقد % PageV01P610 41(@)(@@) % وأعادني منها على أسف % واباتني فيها على ضمد % % 42(@)(@@) % الفعل مهزأة لكل فم % % والعرض منديل لكل يد % 43(@)(@@) % فليثبتن الان ان ثبتت % % قدم على جمر لمعتمد % % 44(@)(@@) % وليصبرن لوقع صاعقتي % % ويوطنن حشا على الزؤد % % 45(@)(@@) % فلتدخلن عليه قبته % % ولاجة تخفى على الرصد % 46(@)(@@) % وهواجم يدفعن كل يد % ونوافذ يهزأن بالزرد % 47(@)(@@) % كالبيض لا يصقلن عن طبع % % والسمر لا يغمزن عن اود % % 48(@)(@@) % حتى يذوق لحد انصلها % % طعنا ، ولا طعن القنا القصد % 49(@)(@@) % ومتى يوقع فل مقنبها % % لم اخلها ابدا من المدد % % 50(@)(@@) % أخطأت في طلبي ، وأخطأ في % % يأسي ، ورد يدي بغير يد % PageV01P611 51(@)(@@) % فلأجعلن عقوبتي أبدا % أن لا أمد يدا إلى أحد % 52(@)(@@) % فتكون أول زلة 
ms178	 سبقت % مني ، وآخرها إلى الأبد % PageV01P612 البحر : طويل 1(@)(@@) % تزود من الماء النقاخ ، فلن ترى % % بوادي الغضا ماء نقاخا ولا بردا % % 2(@)(@@) % ونل من نسيم الرند والبان نفحة % فهيهات واد ينبت البان والرندا % % 3(@)(@@) % وعج بالحمى عينا فلست برامق % % طوال الليالي ذلك العلم الفردا % % 4(@)(@@) % وكر إلى نجد بطرفك انه % % متى يعد لا ينظر عقيقا ولا نجدا % % 5(@)(@@) % تلفت دون الركب والعين غمرة % وقد مدها سيل الدموع بما مدا % % 6(@)(@@) % لعلي أرى دارا بأسنمة النقا % % فأطربنا للدار أقربنا عهدا % % 7(@)(@@) % تلاعب بي بين المعالم لوعة % % فتذهب بي يأسا وترجع بي وجدا % % 8(@)(@@) % منازل ناشدت السحاب فما قضى % % فريضتها عني السحاب ولا ادى % % 9(@)(@@) % وهل بالغ ما يبلغ الدمع عندها % % حقائب غيث تحمل البرق والرعدا % % 10(@)(@@) % أمنك الخيال الطارقي بعد هجعة % يعاطي جوى الظمآن مبتسما بردا % % PageV01P613 11(@)(@@) % دنا من اعالي الرقمتين وما دنا % % وصد وقد ولى الظلام ، وما صدا % % 12(@)(@@) % ومن عجب ريي وما نقع الصدى % % وعدى له منا علي وما اعتدا % % 13(@)(@@) % أساء ليالي الفرب نأيا وهجرة % واسدى على بعد من الدار ما اسدى % % 14(@)(@@) % أفي كل يوم للمطامع جاذب % يجشمني ما يعجز الأسد الوردا % % 15(@)(@@) % كاني اذا جادلت دون مطالبي % % أجادل للأيام ألسنة لدا % % 16(@)(@@) % احل عقود النائبات وانثنى % % وخلفي يد للدهر تحكمها عقدا % % 17(@)(@@) % إذا ما نفذت السد من كل حادث % رأيت أمامي دون ما أبتغي سدا % % 18(@)(@@) % أأترك أملاكا رزانا حلومهم % حلولا على الزوراء أيمانهم تندى % % 19(@)(@@) % كانك تلقى منهم آجمية % % مؤللة الأنياب أو قللا صلدا % % 20(@)(@@) % ولا يأنف الجبار أن يعتفيهم % ولا الحر يأبى أن يكون لهم عبدا % % PageV01P614 21(@)(@@) % إذا ما عدمنا الجود منهم لعلة % فلن نعدم العلياء منهم ولا المجدا % % 22(@)(@@) % وان كريم القوم من خدم العلا % % وان لئيم القوم من خدم الرفدا % % 23(@)(@@) % إذا ما طرقت المرء منهم وجدته % على النار لا كابي الزناد ولا وغدا % % 24(@)(@@) % لهم كل موقوذ من التاج راسه % % غنى بالعلا ان ينسب الاب والجدا % % 25(@)(@@) % نحاسن اقمار الدجى بوجوههم % % فنبهرها 
ms179	 نورا ونغلبها سعدا % % 26(@)(@@) % تخالهم غيدا اذا بذلوا الندى % % وتحسبهم جنا ، إذا ركبوا الجردا % % 27(@)(@@) % إذا طربوا للجود أمطرتهم حيا % وان غضبوا للمجد هيجتهم اسدا % % 28(@)(@@) % وأنقل بيتي في البلاد مجاورا % بيوت المخازي قد ضللت اذا جدا % % 29(@)(@@) % خياما قصيرات العماد تخالها % % كلابا على الأذناب مقعية ربدا % % 30(@)(@@) % إذا عز ماء بينهم وردوا القذى % % وإن قل زاد عندهم مضغوا القدا % % PageV01P615 31(@)(@@) % ترى الوفد عن أعطانهم وقبابهم % من اللوم انأى من نهامهم طردا % % 32(@)(@@) % أأترك أمطاء السوابق ضلة % وأستحمل الحاجات أحمرة قفدا % % 33(@)(@@) % لرأي لعمري غير دان من النهى % % ولا واسط في الحزم قبلا ولا بعدا % % 34(@)(@@) % فلا طرب أن زدت قربا إليهم % ولا اسف ان زاد ما بيننا بعدا % % 35(@)(@@) % كعمت لساني أن يقول ، وإن يقل % فقل في الجراز العضب ان فارق الغمدا % % 36(@)(@@) % وإن برودا للمخازي معدة % فمن شاء في ذا الحي اسحبته بردا % % 37(@)(@@) % قلائد في الاعناق بالعار لا تهي % % على مر أيام الزمان ، ولا تصدا % % 38(@)(@@) % اذا صلصلت بين القنا قضت القنا % % وان زفرت بالسرد قطعت السردا % % 39(@)(@@) % لها بين اعراض الرجال قعاقع % % مدارجها أسعى من الغر أو أعدى % % 40(@)(@@) % أآل بويه ما نرى الناس غيركم % ولا نشتكي للخلق اولاكم فقدا % % PageV01P616 41(@)(@@) % نرى منعكم جودا ومطلكم جدا % % وإذلالكم عزا وإمراركم شهدا % % 42(@)(@@) % وعيش الليالي عند غيركم ردى % % وبرد الأماني عند غيركم وقدا % % 43(@)(@@) % اذا لم تكونوا نازلي الأرض لم نجد % % بها الوادي الممطور والكلأ الجعدا % % 44(@)(@@) % وينبط محفاري بارضكم الغنى % % إذا ما نبا عن جانب اللؤم أو أكدى % % 45(@)(@@) % وكنت أرى أني متى شئت دونكم % وجدت مجازا للمطالب أو معدى % % 46(@)(@@) % فلم ار لي من مطلع عن بلادكم % % ولا من مراح للاماني ولا مغدا % % 47(@)(@@) % خذوا بزمامي قد رجعت إليكم % رجوع نزيل لا يرى منكم بدا % % 48(@)(@@) % أريد ذهابا عنكم ، فيردني % % إليكم تجاريب الرجال ، ولا حمدا % % PageV01P617 البحر : بسيط تام 1(@)(@@) % أرى وجوها وأيمانا مقفلة % فمغلق البشر منها مغلق الجود % 2(@)(@@) % معبسين لئلا يحدثوا طمعا % للسائلين ولا يوفوا 
ms180	 بموعود % % 3(@)(@@) % نوالهم بين صعب النيل ممتنع % % بالمطل أو مستخس القدر مردود % PageV01P618 البحر : طويل 1(@)(@@) % هوى لكما ان الشباب يعاد % % وإن بياض العارضين سواد % 2(@)(@@) % وإن الليالي عدن ، والحي جيرة % كما كن أم لا مالهن معاد % % 3(@)(@@) % حننت اليكم حنة النيب اصبحت % % ثلوب على الماء الروى وتذاد % % 4(@)(@@) % توان بأعناق الغليل ، وقد حوى % % مشارعه عذب الجمام يراد % % 5(@)(@@) % دع الوجد يبلغ ما ارادا فما الهوى % % بدان ، ولا عهد الديار معاد % 6(@)(@@) % وإن بذاك الجزع وحشا غريرة % تصيد ، وأعيا الناس كيف تصاد % 7(@)(@@) % ضلالا ، أبين الزاهدين أزاد % فظل ، ولم يملك لهن قياد % 8(@)(@@) % غداة وقفنا ، والدموع مرشة % كأن عيون الواقفين مزاد % % 9(@)(@@) % أبا طول هم أن تكون مضاجع % و غزر دموع ان يكن رقاد % % 10(@)(@@) % فتموا على عنف السياق وزادوا % % و بين جفوني والمنام طراد % % PageV01P619 11(@)(@@) % لهم كل يوم والنوى مطمثنة % % سليم له يوم الفراق عداد % % 12(@)(@@) % فيا بين لم تنفع اليك وسيلة % % و يا وجد لم يسلم عليك فؤاد % % 13(@)(@@) % حلفت بايديهن في كل مهمه % % عليهن من باقي الظلام سواد % 14(@)(@@) % كأيدي العذارى الفاقدات تدارعت % للدم الطلا اطمارهن حداد % % 15(@)(@@) % خوانف ، مهبوط بهن عشية % قرار ، ومطلوع بهن نجاد % 16(@)(@@) % تقص بآثار الدماء ، كأنها % % مساحب جرحى يوم طال طراد % 17(@)(@@) % يطيرن بالوقع الشرار كانما % % مناسمها تحت الظلام زناد % 18(@)(@@) % كأن الدجى والفجر يركب عقبه % % نزائع دهم خلفهن وراد % % 19(@)(@@) % أزير سرى ما فيه للغمض مطمع % كان قتود اليعملات قتاد % % 20(@)(@@) % روام إلى جمع كأن رؤوسها % % قباب بنتها بالمراقب عاد % % PageV01P620 21(@)(@@) % يجعجعن أجلادا وهاما رواجفا % وهن على ما نابهن جلاد % 22(@)(@@) % لحي على الجرعاء الام رحلة % % إذا ظعنوا ساقوا العيوب وقادوا % % 23(@)(@@) % اذا رحلوا عن خطة اللوم خالفوا % % إليها بأعناق المطي وعادوا % % 24(@)(@@) % لهم مجلس ما فيه للمجد مقعد % % و مربط عار ما عليه جياد % % 25(@)(@@) % بيوتهم سود الذرى ، ولنارهم % مواقد بيض ما بهن رماد % % 26(@)(@@) % لهم حسب اعمى اضل دليله % % قلم يدر في الاحساب اين يقاد % % 27(@)(@@) % تحير في الأحياء ذلا 