ms81	 تبقى من العمر % % 53(@)(@@) % وجدنا المنى والأمن بعد شدائد % بأكبر لم تعلق به شيمة الكبر % % 54(@)(@@) % وفوز أناس ، والمواهب قسمة ، % بلثم سحاب من أناملك العشر % % 55(@)(@@) % ورفع عقيرات المدائح والعلى % % تصيخ إلى شعر تكلم بالسحر % % 56(@)(@@) % بمختلف الألفاظ والقصد واحد % كمختلف الأنفاس من أرج الزهر % % 57(@)(@@) % فمن تارك وكرا إليك مهاجر % ومن مستقر من جانبك في وكر % 58(@)(@@) % وإن كنت عن مجرى السوابق غائبا % فحاضر سبقي فيه مع قرح الخطر % % 59(@)(@@) % ويهدي إليك البحر در مغاصه % وإن لم تقف منه على طرف العبر % % 60(@)(@@) % حميت حمى العلياء في الملك ما سرى % % إلى الحجر الساري وخيم بالحجر % % PageV01P286 البحر : كامل أحذ 1(@)(@@) % من كان عنه يدافع القدر % لم يرده جن ولا بشر % 2(@)(@@) % وثنى الردى عنه الردى جزعا % وسعت على غيراته غير % % 3(@)(@@) % ورمى عداه بكل داهية % دهياء لا تبقي ولا تذر % 4(@)(@@) % لا عيب فيما كان من جلل % يجري بكل مقدر قدر % % 5(@)(@@) % إن الملوك ، وإن هم عظموا ، % تغرى العداة بهم ، وإن حقروا % % 6(@)(@@) % والغدر قد ملىء الزمان به % % قدما ، وكم نطقت به السير % % 7(@)(@@) % وأولو المكايد إن رأوا فرصا % ركبوا لها العزمات وابتدروا % % 8(@)(@@) % والمصطفى سمته كافرة % لتضيره ، أو مسه الضرر % % 9(@)(@@) % وعلا معاوية بذي شطب % عند الصباح لشجه غدر % % 10(@)(@@) % وعصابة للحين قاد بها % % ظلم النفوس وساقها الأشر % % PageV01P287 11(@)(@@) % حتى إذا ظنوا بأنهم % % ربحوا وأنجح سعيهم ، خسروا % % 12(@)(@@) % وردوا الحتوف وبئس ما وردوا % % لكنهم وردوا وما صدروا % % 13(@)(@@) % مثل الفراش تقحمت سعرا % فانظر إلى ما تصنع السعر % % 14(@)(@@) % خذلوا وما نصروا على ملك ، % ما زال بالرحمن ينتصر % 15(@)(@@) % ردوا المكايد في نحورهم % % عن عادل بسيوفه نحروا % % 16(@)(@@) % كان ابتداء فسادهم لهم % وعليهم بصلاحه الخبر % 17(@)(@@) % رفعوا عيونهم إلى قمر % فرماهم برجومه القمر % % 18(@)(@@) % صب الحديد عليهم ذربا % فكأنهم من حوله جزر % 19(@)(@@) % عجبا لهم بطنوا بعيشهم % وبقتلهم إذ صلبوا ظهروا % % 20(@)(@@) % يبست جذوعهم وهم ثمر % للضبع أينع ذلك الثمر % % PageV01P288 21(@)(@@) % من كل راب سلهب رسخت % منه القوائم ما له 
ms82	 حضر % % 22(@)(@@) % وكأنما الحرباء منه علا % % عودا ، ونار الشمس تستعر % % 23(@)(@@) % أوما رأوا يحيى ، سعادته % وقف عليها النصر والظفر % % 24(@)(@@) % إن الزمان خديم دولته % % يفني أعاديها وإن كثروا % % 25(@)(@@) % ملك على الإسلام ذمته % ستر مديد ، ظله خصر % % 26(@)(@@) % سمح تبرج جود راحته % لعفاته ، ولعرضه خفر % % 27(@)(@@) % ذو هيبة كالشمس منقبض % عنها ، إذا انبسطت ، له النظر % % 28(@)(@@) % والعدل فيها والتقى جمعا % % فكأن ذا سمع وذا بصر % % 29(@)(@@) % خفض الجناح وخفضه شرف % وعلى السماك علا له قدر % 30(@)(@@) % متيقظ العزمات تحسبها % % ينتابها من خوفه السهر % PageV01P289 31(@)(@@) % كالسيف هز غراره بيد % للضرب ، وهو مصمم ذكر % % 32(@)(@@) % وكأن طيب ثنائه أرج % عن روضه يتنفس السحر % 33(@)(@@) % تنمي على الأعداء عزمته % والزند أول ناره شرر % 34(@)(@@) % وكأن ركن أناته سبل % بموارد المعروف ينفجر % 35(@)(@@) % يا فاتكا بعداته أبدا % % إن الذئاب تبيدها الهصر % % 36(@)(@@) % شكرا فإن السعد متصل % وصلت به أيامك الغرر % % 37(@)(@@) % واسلم فإنك في الندى مطر % يمحو المحول ، وللهدى وزر % PageV01P290 البحر : بسيط تام 1(@)(@@) % ما أغمد العضب حتى جرد الذكر % ولا اختفى قمر حتى بدا قمر % 2(@)(@@) % قد مات يحيى فمات الناس كلهم % حتى إذا علي جاءهم نشروا % % 3(@)(@@) % إن يبعثوا بسرور من تملكه % % فمن منية يحيى بالأسى قبروا % % 4(@)(@@) % أوفى علي فسن الملك ضاحكة % وعينه من أبيه دمعها همر % % 5(@)(@@) % يا يوم ولى عن الدنيا به طمست % بظلمة الرزء من أنوارك الغرر % % 6(@)(@@) % ومادت الأرض من فقدانها جبلا % ينابع الجود من سفحيه تنفجر % % 7(@)(@@) % لم تغن عنه غياض من قنا وظبا % حمر الحماليق فيها أسدها الهصر % 8(@)(@@) % يرون زرق ذئاب ما ثعالبها % % إلا عوامل في أيمانها سمر % % 9(@)(@@) % ويتركون إذا جيشا الوغى انتظما % % سلخا كساه حديدا حية ذكر % % 10(@)(@@) % وديعة السيل في البطحاء غادرها % % تقري الرماح بها الآصال والبكر % % PageV01P291 11(@)(@@) % لم يغنيا عنه : لا عز يدل به % من كان بالكبر في عرنينه أشر % 12(@)(@@) % ولا مهابة محجوب تبرجها % % كأنه عند أبصار الورى خفر % % 13(@)(@@) % شقت جيوب المعالي بالأسى وبكت % في الخافقين عليه الأنجم 
ms83	 الزهر % 14(@)(@@) % إذ السماء بصوت الرعد صرختها % % يكاد منها فؤاد الأرض ينفطر % % 15(@)(@@) % والجو متقد الأحشاء مكتئب % كأنما البرق فيها للأسى سعر % % 16(@)(@@) % وقل لابن تميم حزن مأتمها % % فكل حزن عظيم فيه محتقر % 17(@)(@@) % قام الدليل ويحيى لا حياة له % إن المنية لا تبقي ولا تذر % % 18(@)(@@) % أمسى دفينا ولم تدفن مفاخره % كالمسك يطوى ، ونشر منه ينتشر % 19(@)(@@) % قد كنت أحسب أن أعطى مناي به % % وأن يطول على عمري له عمر % % 20(@)(@@) % وها أنا اليوم أرثيه وكنت له % أنقح المدح ، والدنيا لها غير % PageV01P292 21(@)(@@) % يا ويح طارق ليل يستقل به % % سامي التليل براه الأين والضمر % % 22(@)(@@) % في سرجه من طيور الخيل مبتدر % وما جناحاه إلا العنق والخصر % % 23(@)(@@) % يطوي الضمير على سر يكن به % % بشرى ونعي ، حيارى منهما البشر % % 24(@)(@@) % لولا حديث علي قلت من أسف % بفيك - يا من نعى يحيى لنا - العفر % % 25(@)(@@) % إن هد طود فذا طود يعادله % % ظل تؤمن في أفيائه الجدر % % 26(@)(@@) % أو غيض بحر فذا بحر بموضعه % لوارديه نمير ماؤه خصر % 27(@)(@@) % يا واحدا جمعت فيه الكرام ومن % بسيفه ملة التوحيد تنتصر % % 28(@)(@@) % أوجفت طرفك والإيجاف عادته % والصبح محتجب والليل معتكر % % 29(@)(@@) % لما سريت بجيش كنت جملته % وما رفيقاك إلا النصر والظفر % % 30(@)(@@) % طوى له الله سهبا بت قاطعه % كأنما بعده بالقرب يختصر % PageV01P293 31(@)(@@) % وقصر السعد ليلا فالتقى عجلا % منه العشاء على كفيك والسحر % % 32(@)(@@) % وفي ضلوعك قلب حشوه همم % وبين عينيك عزم نومه سهر % % 33(@)(@@) % حتى كسوت حياة جسم مملكة % برد روح إليه منك ينتظر % 34(@)(@@) % هنئت بالملك إذ عزيت في ملك % لموته كان منك العيش يذخر % % 35(@)(@@) % جلست في الدست بالتوفيق وابتهجت % % بك المنابر والتيجان والسرر % 36(@)(@@) % أضحت علاك على التمكين ثابتة % فطيب ذكرك في الدنيا له سفر % % 37(@)(@@) % تناول القوس باريها ، فأسهمه % نوافد في العدى ، أغراضها الثغر % % 38(@)(@@) % وقام بالأمر سهم منك معتزم % يجري من الله في إسعاده القدر % % 39(@)(@@) % وأصبحت همم الآمال سانية % عن العطايا التي عنوانها البدر % % 40(@)(@@) % وأنت سمح 
ms84	 بطبع غير منتقل % % سيان في المحل منك الجود والمطر % % PageV01P294 41(@)(@@) % واسلم لعز بني الإسلام ما سجعت % سوامر الطير وانآدت بها السمر % PageV01P295 البحر : طويل 1(@)(@@) % كفى سيفك الإسلام عادية الكفر % % وصلت على العادين بالعز والنصر % % 2(@)(@@) % وأصبح قول المبطلين مكذبا % ومد لك الرحمن في أمد العمر % 3(@)(@@) % وأين الذي حد المنجم كونه % إذا مر للصوام عشر من الشهر % % 4(@)(@@) % وما قرع الأسماع بالخبر الذي % % أبى الله إلا أن يكذب بالخبر % % 5(@)(@@) % غدا الزيج ريحا في تناقض علمه % % وتعديله عرفا أحال على نكر % % 6(@)(@@) % فهلا رأى قطعا عليه بسجنه % ومشيا بدهم كان بالكبو والعثر % % 7(@)(@@) % وان عليا ينتضي القضب التي % % يرد بها مد العداة إلى قصر % % 8(@)(@@) % لقد ضل عباد النجوم وما اهتدوا % % ببعث رسول للأنام ولا ذكر % % 9(@)(@@) % وكم مر في الدنيا لهم من ممخرق % من الناس مطوي الضلوع على غمر % % 10(@)(@@) % إذا جال في علم الغيوب حسبته % مسيلمة الكذاب قام من القبر % % PageV01P296 11(@)(@@) % أباطيل تجري بالحقائق بينهم % % من الكذب منهم لا عن السبعة الزهر % % 12(@)(@@) % وميل إليها بالظنون وإنما % % ينكب عنها كل يقظان ذو حجر % % 13(@)(@@) % وما الشهب إلا كالمصابيح تلتظي % % مع الليل للساري وتخمد في الفجر % % 14(@)(@@) % فيا أيها المغتر بالنجم قل لنا % % أتعلم سرا فيه من ربه يسري % % 15(@)(@@) % وبينكما بون بعيد فما الذي % % تقوله الغفر اختلافا عن الغفر % % 16(@)(@@) % فيا أحلم الأملاك عن ذي حبالة % وإن جاء في الأمر الذي جد بالإمر % % 17(@)(@@) % تدارك جهولا ضل أو زل أو به % % جنون فما يرتاب للسيف في النحر % % 18(@)(@@) % فصبر جميل الصفح عنه عقابه % فقد جل منك القدر عن ضعة القدر % % 19(@)(@@) % سعودك في نيل المنى لا توقفت % % من الله تجري ، لا من الشمس والبدر % % 20(@)(@@) % ملكت فمهدت الأمور مجردا % % لتمهيدها رأي المجرب لا الغمر % % PageV01P297 21(@)(@@) % ونظمت حبات القلوب محبة . % عليك ، وقد كانت مباينة النثر % % 22(@)(@@) % لأمر أدمت الحصر في حرب جربة % وما حربها إلا مداومة الحصر % % 23(@)(@@) % وتركك بالزرق اللهاذم أهلها % % وبالبيض صرعى في الجزيرة كالجزر % % 24(@)(@@) % وما 
ms85	 ضويقوا من قبل هذا وإنما % % بقدر التهاب النار تغلية القدر % % 25(@)(@@) % بسير جيوش في البحور إليهم % تحيط بهم زحفا مع المد والجزر % % 26(@)(@@) % إذا انتقلت بالصيد قلت تعجبا % متى انتقل الآجام بالأسد الهصر % % 27(@)(@@) % مجردة بيض الحتوف خوافقا % بها العذبات الحمر في اللجج الخضر % % 28(@)(@@) % وكل مدير يتقي بمجاذف % % مشاكلة التشبيه في الأنمل العشر % % 29(@)(@@) % ترى الشحم فوق القار منه مميعا % فيا من رأى ليلا تسرول بالفجر % % 30(@)(@@) % سواد غراب في بياض حمامة % تطير به سبحا على الماء أو تجري % % PageV01P298 31(@)(@@) % قطعت بهم في العيش من كل جانب % فقد أقصروا فيها عن النظم بالنثر % % 32(@)(@@) % وكم طائر منهم قصصت جناحه % فأصبح مسجونا عن النهض في الوكر % % 33(@)(@@) % لما رأوا أن المخنق منهم % سددت به مجرى التنفس في الصدر % % 34(@)(@@) % أنابوا وتابوا عن ذنوب تقدمت % % بزعمهم من قطعهم سبل البحر % % 35(@)(@@) % فإن نشروا ما بينهم لك طاعة % وقد طويت منهم صدور على غمر % % 36(@)(@@) % فعندك نار تركب الماء نحوهم % % لها زند يقدحن من زند بتر % 37(@)(@@) % ونبل كنبل الأعين النجل أرسلت % % تطير بريش مستعار من النسر % % 38(@)(@@) % تنصل للأعداء في الحرب بالردى % % إذا نصلت هاتيك في السلم بالسحر % % 39(@)(@@) % ولن يخدعوا في الحرب ، وهو مبيدهم ، % فتى كان مولودا من الحرب في حجر % % 40(@)(@@) % وأنت من الأعداء أدهى خديعة % إذا ما صدمت الجيش في الجيش بالمكر % % PageV01P299 41(@)(@@) % وكنت عن التحريض بالحزم غانيا % وهل يعدم الإحراق متقد الجمر % % 42(@)(@@) % خلقت لنا من جوهر الفضل سيدا % ويمناك من يمن ويسراك من يسر % % 43(@)(@@) % وعول في العسر الفقير على ندى % % يديك ، وهل يغنى الكسير عن الجبر % % 44(@)(@@) % زمانك لا ينفك يفترس العدى % % كذي لبدة مستعظم الناب والظفر % % 45(@)(@@) % وطعماك من شهد ، وطاب لأهله ، % وخلقاك من سهل عليهم ومن وعر % % 46(@)(@@) % حياة ابن يحيى للأعادي منية % وأعمارهم مبتورة منه بالعمر % % 47(@)(@@) % لقد فخرت منه العلى بسميذع % لإحسانه وجه تبرقع بالبشر % % 48(@)(@@) % بأكبر يستخذي له كل أكبر % فيطرق إطراق البغاثة للصقر % 49(@)(@@) % إذا مدح الأملاك قام بمدحه 
ms86	 % % له قدم الدنيا على قدم الفخر % % 50(@)(@@) % إليك امتطينا كل راغ بموجه % % كا جرجر القرم الحقود على المكري % % PageV01P300 51(@)(@@) % إذا ما طما وامتد بالريح مده % ذكرنا به فياض نائلك الغمر % 52(@)(@@) % ولولاك لم نركب غوارب زاخر % مسنمة في اللحم منه إلى العمر % % 53(@)(@@) % وإن فاتني إعذار شبليك بالغنى % % فإن بترك العزم متضح العذر % 54(@)(@@) % ضعفت عن النهض القوي زمانة % ونقل بعد الباع خطوي إلى شبر % % 55(@)(@@) % وإني لأهدي في سلوك غرائبي % % ومعجز نظمي كل جوهرة بكر % % 56(@)(@@) % إذا ما بنى بيتا من الشعر مقولي % % ثنى نابيا عن هدمه معول الدهر % % 57(@)(@@) % وما الشعر ما يخلو من الكسر وزنه % ولكنه سحر وبابله فكري % % 58(@)(@@) % وإني بما فوق المنى منك موقن % وكم شرق لليث من وابل القطر % % PageV01P301 البحر : خفيف تام 1(@)(@@) % عجبي من سكينتي ووقاري % % بعد صيد المها وخلع العذار % % 2(@)(@@) % واجتلائي من الشموس عروسا % نقطت خدها بزهر الدراري % % 3(@)(@@) % بنت ما شئت من زمان قديم % ينطوي عمرها على الأعصار % % 4(@)(@@) % في صموت أقر بالنشر منها % % وهو تحت الصعيد نائي القرار % % 5(@)(@@) % فإذا فض خاتم عنه أهدت % % أرج المسك وهي في ثوب نار % % 6(@)(@@) % قهوة مزقت بكف سناها % % برقع الليل عن محيا النهار % % 7(@)(@@) % عدلت بعد سيرة الجور لما % % نرجس المزج لونها الجلناري % % 8(@)(@@) % وحلى نشرها النسيم ولكن % % بعدما نام في حجور البهار % % 9(@)(@@) % وهي ياقوتة تبرقع خدا % من جمان منظم بعجار % % 10(@)(@@) % كلما صافحت يدا من لجين % منحتها أناملا من نضار % % PageV01P302 11(@)(@@) % جوهر يبعث المسرة منه % % عرض في لطائف الجسم سار % % 12(@)(@@) % وكأن العيون تلحظ منه % % صورة روحها من الجسم عار % % 13(@)(@@) % أنكحوا عند مزجها الماء نارا % % فارتمت عند لمسه بالشرار % % 14(@)(@@) % وانبزت منهما ولائد در % طائر الوثب عهما بالنفار % % 15(@)(@@) % في قميص الشراب منها شعاع % يبرد الهم وهو عين الأوار % % 16(@)(@@) % في رياض تنوع النور فيها % % كاليواقيت في حقاق التجار % % 17(@)(@@) % فكأن البنفسج الغض منه % % زرقة العض في نهود الجواري % % 18(@)(@@) % وكأن الشقيق حمر خدود % نقط المسك فوقها بانتثار % % 19 
ms87	(@)(@@) % مطرب عندها غناء الغواني % % في سنا الصبح أو غناء القماري % % 20(@)(@@) % كان ذا كله زمان شباب % كنت فيه على الدمى بالخيار % % PageV01P303 21(@)(@@) % هل ترد الأيام حسني ومن لي % % بكمال الهلال بعد السرار % % 22(@)(@@) % نحن قوم ما بيننا نتناجى % % بالأحاديث في الملوك الكبار % % 23(@)(@@) % ملك في حماية الملك منه % % دخل الناس في حديث البحار % % 24(@)(@@) % ووجدنا فخر ابن يحيى عريضا % ظن ما شئت غير ضيق الفخار % % 25(@)(@@) % ملك في حماية الملك منه % % قسور شائك البراثن ضار % % 26(@)(@@) % عادل يتقي الإله ويعفو % % عن ذوي السيئات عفو اقتدار % % 27(@)(@@) % أسكن الله رأفة منه قلبا % ورسا طود حلمه فى الوقار % % 28(@)(@@) % لا تزال الأبرار تأمن منه % % سطوة تتقى على الفجار % % 29(@)(@@) % أريحي حلو الشمائل تجري % % بين أخلاقه شمول العقار % % 30(@)(@@) % لا يجاري لسبقه ، فلهذا % % لم يجد فى مدى العلى من يجاري % % PageV01P304 31(@)(@@) % كل فضل مقسم في البرايا % % منه ، والشمس عنصر الأنوار % % 32(@)(@@) % فالق هامة الشجاع بعضب % مطفىء روحه بإيقاد نار % % 33(@)(@@) % وإذا الحرب أقبلت بالمنايا % % كر ، والذمر لائذ بالفرار % % 34(@)(@@) % لم تنم عنده الظبا في جفون % فالهدى بانتباهها ذو انتصار % % 35(@)(@@) % وهو في حمير الملوك عريق % في صميم العلى ومحض النجار % % 36(@)(@@) % سادة يطلع الدراري منهم % % فلك في العلى قديم المدار % % 37(@)(@@) % هم أقاموا زيغ العدى بذكور % تكتسي بالدماء وهي عوار % % 38(@)(@@) % حيث يلقونهم بوضع خدود % % لهم في الثرى ورفع عمار % % 39(@)(@@) % عد عن غيرهم وعول عليهم % % فهم في الوغى حماة الذمار % % 40(@)(@@) % وإذا ما قدحت نارك فاختر % % زند مزح لقدحها أو عفار % % PageV01P305 41(@)(@@) % معلم في الوغى إذا خاف غفل % شهرة منه للإلال الحرار % % 42(@)(@@) % واليعابيب حوله تتعادى % % كالسراجين بالأسود الضواري % % 43(@)(@@) % كل بحر يسطو بجدول غمر % جامد فيه وهو بالسيل جاري % % 44(@)(@@) % والأساطيل في الزواخر يرمي % % بلد الروم غزوها بالدمار % % 45(@)(@@) % يابسات العيدان تثمر بالغي % % د إذا أورقت ببيض الشفار % % 46(@)(@@) % راعفات القنا تلون فيها % % عذبات كمثل مصحف قاري % % 47(@)(@@) % محرب يقهر العداة ويلقي % % كلكل الحرب منهم في الديار % % 48(@)(@@) % والمنايا كالمشفقات تنادي 
ms88	 % % ببنيها حذار منه حذار % 49(@)(@@) % في خميس تغمض الشمس عينا % فوقه من مهيل نقع مثار % % 50(@)(@@) % تحسب الطير وهي وقف عليه % % رقمت منه في ملاء الغبار % % PageV01P306 51(@)(@@) % عمنا في جواره خفض عيش % فذكرنا بذاك حسن الجوار % % 52(@)(@@) % ننتقي لفظ وصفه ونروي % % مددا في خواطر الأفكار % % 53(@)(@@) % ونداه كما تراه ارتجال % جابر في الفقير كسر الفقار % % 54(@)(@@) % يا ابن يحيى الذي ينيل الغنى بي % % ن حياء من رفده واعتذار % % 55(@)(@@) % لك يدعو بمكة كل بر % حول بيت الإله ذي الأستار % % 56(@)(@@) % ومطل على مني بعد حج % لبلوغ المنى ورمي الجمار % % 57(@)(@@) % والذي زار أرض طيبة يغشى % % خده قبر أحمد المختار % % 58(@)(@@) % فهنيئا للعيد عزة ملك % بات يرمي العدى بذل الصغار % % 59(@)(@@) % وابق في الملك لابتناء المعالي % % ولصون الهدى وبذل النضار % PageV01P307 البحر : كامل تام 1(@)(@@) % هل كان أودع سر قلب محجرا % صب يكابد دمعه المتحدرا % % 2(@)(@@) % باتت له عين تفيض بلجة % قذف السهاد على سواحلها الكرى % % 3(@)(@@) % ما بال سالي القلب عنف من له % % قلب بتفتير اللحاظ نقطرا % % 4(@)(@@) % ورمى نصيحته إلى قنص الهوى % % فإذا رعى حول الحبائل نفرا % % 5(@)(@@) % إن الغرام غرامه ذو سورة % ومن العيون على القلوب تسورا % % 6(@)(@@) % وإذا تعلق بالعلاقة مهتد % ورنا إلى حور الظباء تحيرا % % 7(@)(@@) % ومن الفواتك بالورى لك غادة % كحلت بمثل السحر طرفا أحورا % % 8(@)(@@) % ملآن منها حقفها ، ووشاحها % % صفر تخال الخصر فيه خنصرا % % 9(@)(@@) % عادت سقيما من سقام جفونها % % خطرت عليه كرؤية فتخطرا % % 10(@)(@@) % شرق الظلام تألقا بضيائها % % فكأنما شرب الصباح المسفرا % % PageV01P308 11(@)(@@) % سحبت ذوائبها فيا لأساود % نفثت على القدمين مسكا أذفرا % % 12(@)(@@) % ومشت ترنح كالنزيف ومشيها % % فضح القطاة بحسنه والجؤذرا % % 13(@)(@@) % فعجبت من غصن تدافعه الصبا % % بالنهد أثمر والثنايا نورا % % 14(@)(@@) % معشوقة حيت بودرة وجنة % وسقت بكاس فم سلافا مسكرا % % 15(@)(@@) % لا تعجبن مما أقول فمقولي % % عن حكم عيني بالبخيلة أخبرا % % 16(@)(@@) % إني امرؤ كل الفكاهة حازها % % والصيد كل الصيد في جوف الفرا % % 17(@)(@@) % يا رب ذي مد وجزر ماؤه % % للفلك هلك قطعه 
ms89	 فتيسرا % % 18(@)(@@) % نفخ الدجى لما رآه ميتا % فيه مكان الروح ريحا صرصرا % % 19(@)(@@) % يفضي إلى حي العباب تخاله % % لولا ربى الآذي قيعا مقفرا % % 20(@)(@@) % يخشى لوحشته السليك سلوكه % ويلوك فيه الرعب قلب الشنفرى % % PageV01P309 21(@)(@@) % خضنا حشاه في حشى زنجية % % كمسفة شقت سكاكا أغبرا % % 22(@)(@@) % تنجو أمام القدح وخد نجيبة % فكأنه فحل عليها جرجرا % % 23(@)(@@) % بحر حكى جود ابن يحيى فيضه % وطما بسيف القصر منه فقصرا % % 24(@)(@@) % أقرى الملوك يدا وأرفع ذمة % وأجل منقبة وأكرم عنصرا % % 25(@)(@@) % لا تحسب الهمات شيئا واحدا % % شتان ما بين الثريا والثرى % % 26(@)(@@) % بدر المهابة يجتبي في دسته % ملك إذا ملك رآه كبرا % % 27(@)(@@) % نجل الأعاظم من ذؤابة حمير % صقل الزمان به مفاخر حميرا % % 28(@)(@@) % يزدان في العياء منه سريره % بمملك في المهد كان مؤمرا % % 29(@)(@@) % لبس التذلل والخشوع لعزه % كل امرىء لبس الخنى وتحيرا % % 30(@)(@@) % وكأنما في كل مقول ناطق % من ذكره خوف يسل مذكرا % % PageV01P310 31(@)(@@) % وكأنه في الدهر خير فانتقى % % أيامه من حسنها وتخيرا % % 32(@)(@@) % طلق المحيا لا بسور له إذا % % بسر الحمام بمأزق وتمعرا % % 33(@)(@@) % أخدوده في الرأس ضربة أبيض % وقلبيه في القلب طعنة أسمرا % % 34(@)(@@) % وإذا تعرى للشجاع حسامه % بكريهة قتل الشجاعة بالعرا % % 35(@)(@@) % كم من صريع عاطل من رأسه % % بالضرب طوقه حساما مبترا % % 36(@)(@@) % متيقظ ملأ الزمان لأهله % % أمنا أنام به وخوفا أسهرا % % 37(@)(@@) % عصفت لتدركه الصبا فكأنما % % جمدت وقرت خلفه لما جرى % % 38(@)(@@) % أحبب بذاك السبق إذ هو في مدى % % شرف يثير به العلى لا العثيرا % % 39(@)(@@) % يسدي المكارم من أنامل مفضل % أغنى الزمان بنيلها من أفقرا % % 40(@)(@@) % أحيا به المعروف بين عباده % % رب بسيرته أمات المنكرا % % PageV01P311 41(@)(@@) % وكتيبة كتبت صدور رماحها % % للموت في صحف الحيازم أسطرا % % 42(@)(@@) % ملئت بها الحرب العوان ضراغما % وصلادما وقشاعما وسنورا % % 43(@)(@@) % جاءت لفيفا في رواق عجاجة % سوداء درهمها اللميع ودنرا % % 44(@)(@@) % وبدا علي في سماء قتامها % % قمرا وصال على الفوارس قسورا % % 45(@)(@@) % بخطيب موت في الوقائع جاعل % لغراره رأس المدجج منبرا % % 46(@)(@@) % بحر إذا 
ms90	 ما القرن رام عبوره % % لم يلق فيه إلى السلامة معبرا % % 47(@)(@@) % عطبت به مهج الجبابرة الألى % % بصروا بكسرى في الزمان وقيصرا % % 48(@)(@@) % رسبت بلجته النفوس ولو طفت % لحسبته قبل القيامة محشرا % % 49(@)(@@) % ورد النجيع وسوسن جنباته % % ثم استقل بهن وردا أحمرا % % 50(@)(@@) % وكأنما نار تشب بمتنه % % أبدا تحرق فيه روضا أخضرا % % PageV01P312 51(@)(@@) % فتق الرياح بفخره فكأنما % % خضنا إليه بالمعاطس عنبرا % % 52(@)(@@) % رفع القريض به عقائر مدحه % فاهتز في يده الندى وتفجرا % % 53(@)(@@) % وأتى العطاء مفضضا ومذهبا % وأتى الثناء مسهما ومحيرا % % 54(@)(@@) % فكأنما زخرت غوارب دجلة % وكأنما نشرت وشائع عبقرا % % 55(@)(@@) % يا من إذا بصر رآه فقد رأى % % في بردتيه الأكرمين من الورى % % 56(@)(@@) % وبدا له أنا بألسنة العلى % % في جوهر الأملاك ننظم جوهرا % % 57(@)(@@) % من نور بشرك أشرق النور الذي % % بتكاثر الأعياد عندك بشرا % % 58(@)(@@) % واسلم لملكك في تقاعس عزة % وأبد بسيفك من عدا واستكبرا % % PageV01P313 البحر : وافر تام 1(@)(@@) % نعيمك أن تزف لك العقار % عروسا في خلائقها نفار % 2(@)(@@) % فإن مزجت وجدت لها انقيادا % % كما تنقاد بالهخدع النوار % % 3(@)(@@) % رأيت الراح للأفراح قطبا % عليه من الصبوح لها مدار % % 4(@)(@@) % إذا ضحكت لمبصرها رياض % بواك فوقها سحب غزار % % 5(@)(@@) % كأن فروعها أيد أشارت % بأطراف خواتمها قصار % % 6(@)(@@) % ولم أر قبل رؤيتها سيوفا % لجوهرهن بالهز انتثار % % 7(@)(@@) % ولا زندا له في الجو قدح % مكان شرارها همت القطار % % 8(@)(@@) % وقائدة إليك من القناني % % كميتا جلها في الدن قار % 9(@)(@@) % تروح لسكرها بك في عثار % % 10(@)(@@) % إذا مزجت لتعدل في الندامى % % تطاير عن جوانبها الشرار % % PageV01P314 11(@)(@@) % وقلت وقد نظرت إلى عجاب % أثغر الماء تضحك عنه نار % % 12(@)(@@) % تلق مهاه عيشك من مهاة % وزينتها القلادة والسوار % % 13(@)(@@) % تمرض مقلة ليصح وجد % توارى في الضلوع له أوار % % 14(@)(@@) % ويفتن شخصك المرمي منها % % فتور بالملاحة واحورار % % 15(@)(@@) % وخذ ماء من الياقوت يطفو % % له درر مجوفة صغار % % 16(@)(@@) % يريك حديقة من ياسمين % تفتح وسطها له جلنار % 17(@)(@@) % إذا فتح المزاج اللون منها % % مضى ورد لها وأتى بهار % % 18 
ms91	(@)(@@) % فقد طرد الكرى عنا خطيب % رفيع الصوت منبره الجدار % % 19(@)(@@) % ورق ذماء نفس الليل لما % % تنفس في جوانبه النهار % % 20(@)(@@) % أدر ذهب العقار لنفي هم % ولا تحزن إذا ذهب العقار % % PageV01P315 21(@)(@@) % فللمعروف في يمنى علي % غنى لا يتقى معه افتقار % % 22(@)(@@) % هو الملك الذي اضطربت إليه % % بقصده الخضارم والقفار % % 23(@)(@@) % ترفع من معاليه محلا % له في سمكه الدري جار % % 24(@)(@@) % وأعرق في نجار حميري % فطاب الفرع منه والنجار % % 25(@)(@@) % وما زالوا بأنواع العطايا % % له يمنى تجاودها يسار % % 26(@)(@@) % تعم الوفد من يده أياد % كأن البحر من يده اختصار % % 27(@)(@@) % ويسمح زنده بجذى تلظى % % إذا زند خبا ووهى العفار % % 28(@)(@@) % وإن وهبت الألوف وهن كثر % تقدم قبلهن الإعتذار % % 29(@)(@@) % عظيم الجد يضرب من ظباه % % ويطعن من أسنته البوار % % 30(@)(@@) % يسير وخلفه أبطال حرب % على حوض المنون لهم تبار % % PageV01P316 31(@)(@@) % إذا أضحى شعار الأسد شعرا % فمن زرد الدروع لهم أشعار % % 32(@)(@@) % وقد وسعتهم الحلقات منها % % وأحمتهن للهيجاء نار % % 33(@)(@@) % يخوض حشى الكريهة منه جيش % نجوم سمائه الأسل الحرار % % 34(@)(@@) % بحيث تغور من قمم الأعادي % % جداول بالأكف لها انفجار % % 35(@)(@@) % إذا لبست سماء منه أرضا % دجاها فوقه نقع مثار % % 36(@)(@@) % تريك قشاعما في الجو منها % % حوائم كلما ارتكم الغبار % % 37(@)(@@) % حسامك نور ذهنك فيه صقل % وعزمك في المضاء له غرار % % 38(@)(@@) % لقد أضحى على دين النصارى % % لدين المسلمين بك انتصار % % 39(@)(@@) % حميت ذماره برا وبحرا % بمرهفة بها يحمى الذمار % % 40(@)(@@) % أراك الله في الأعلاج رأيا % لهم منه المذلة والصغار % % PageV01P317 41(@)(@@) % رأوا حربية ترمي بنفط % لإخماد النفوس له استعار % % 42(@)(@@) % كأن المهل في الأنبوب منه % % إلى شي الوجوه له ابتدار % % 43(@)(@@) % إذا ما شك نحر العلج منه % % تعالى بالحمام له خوار % % 44(@)(@@) % كأن منافس البركان فيها % % لأهوال الجحيم بها اعتبار % % 45(@)(@@) % نحاس ينبري منه شواظ % لأرواح العلوج به بوار % % 46(@)(@@) % وما للماء بالإطفاء حكم % عليه لدى الوقود ولا اقتدار % % 47(@)(@@) % فرد الله بأسهم عليهم % فربحهم بصفقتهم خسار % % 48(@)(@@) % وخافوا من مناياهم وفروا % % فدافع عن 
ms92	 نفوسهم الفرار % % 49(@)(@@) % وقد جعلوا لهم شرع الشواني % % مع الأرواح أجنحة وطاروا % % 50(@)(@@) % وهل يلقى مصادمة حصادهم % % جبالا سحقها لهم دمار % % PageV01P318 51(@)(@@) % ليهنك أن ممتنع الأماني % % لكفك في تناولها اختيار % % 52(@)(@@) % لك الفلك التي تجري بسعد % يدور به لك الفلك المدار % % 53(@)(@@) % تهب له الرياح مسخرات % وتسكن في تحركها البحار % % 54(@)(@@) % ومتا حملته من أنواع طيب % فمدح عرفه لك وافتخار % % 55(@)(@@) % أمولانا الذي ما زال سمحا % إليه بكل مكرمة يشار % % 56(@)(@@) % أرى رسمي غدا بيدي كرسم % % عفا وعفت له بالمحل دار % % 57(@)(@@) % وكانت لي شموس ثم أضحت % % بدورا والبدور لها سرار % % 58(@)(@@) % وبين سناهما بون بعيد % وذا ما لا يراد به اختيار % % 59(@)(@@) % وجدت جناح عصفور جناحي % % فأصبح للعقاب به احتقار % % 60(@)(@@) % فلي نهض يجاذبني ضعيف % أتنهض بي قوادمه القصار % % PageV01P319 61(@)(@@) % فرد علي موفورا جناحي % % وإلا لا جناح ولا مطار % PageV01P320 البحر : طويل 1(@)(@@) % خيالك للأجفان مثله الفكر % فعيني ملأى بالهوى ويدي صفر % 2(@)(@@) % سرى والدجى الغربيب يخفي مكانه % % فنم عليه من تضوعها نشر % 3(@)(@@) % وقد صوب النسر المحلق تاليا % أخاه ومات الليل إذ ولد الفجر % % 4(@)(@@) % ألم بصب ليس يدري أمرجل % يفور بنيران الأسى منه أو صدر % % 5(@)(@@) % غريب جنى أري الحياة وشريها % % ويجني الفتى بالعيش ما يغرس الدهر % % 6(@)(@@) % أنازحة الدار التي لا أزورها % % إذا لم يشق البحر أو يقطع القفر % % 7(@)(@@) % إذا بعدت دار الأحبة بالنوى % % فذاك لهم هجر وإن يكن هجر % % 8(@)(@@) % رحلت ولم يرحل عشية بيننا % % معي برحيل الجسم قلب ولا صبر % % 9(@)(@@) % وداء خمار الشرب سوف يذيبني % % فقد نزحت في فيك غزر به الخمر % % 10(@)(@@) % وما زال ماء العين في الخد معطشي % % إلى ماء وجه في لقائي له بشر % % PageV01P321 11(@)(@@) % عسى البعد ينفي موجب القرب حكمه % % فعند انقباض العسر ينبسط اليسر % % 12(@)(@@) % عسى بيننا يبقي المودة بيننا % % ولا ينتهي منا إلى أجل عمر % % 13(@)(@@) % فقل لأناس عرسوا بسفاقس % لطائر قلبي في معرسكم وكر % % 14(@)(@@) % وفرخ صغير لا نهوض لمثله % % يراطن أشكالا ملاقطها صفر % % 15(@)(@@) % إذا 
ms93	 ما رأى في الجو ظل محلق % ترنم واهتزت قوادمه العشر % % 16(@)(@@) % يظن أباه واقعا فإذا أبى % % وقوعا عليه شب في قلبه الحجر % % 17(@)(@@) % يلذ بعيني أن تري عينه وأن % % يلف بنحري في التلاقي له نحر % 18(@)(@@) % أحن إلى أوطانكم وكأنما % % ألاقي بها عصر الصبا ، سقي العصر % % 19(@)(@@) % ولم أر أرضا مثل أرضكم التي % % يقبل ذيل القصر في شطها البحر % % 20(@)(@@) % يمد كجيش زاحف فإذا رأى % % عطاء علي كان من مده جزر % % PageV01P322 21(@)(@@) % أما يخجل البحر الأجاج حلوله % % ببحر فرات ما للجته عبر % % 22(@)(@@) % جواد إذا أسدى الغنى من يمينه % % تحول عن أيمان قصاده الفقر % % 23(@)(@@) % حمى ثغره بالسيف والرمح مقدما % ويحمي عرين القسور الناب والظفر % % 24(@)(@@) % إذا ما كسونا المدح أوصافه ازدهى % % فطيب أفواه القوافي له ذكر % % 25(@)(@@) % يصول بعضب في الكفاح كأنه % % لسان شواظ منه يضطرم الذعر % % 26(@)(@@) % وتحسب منه الريح تغدو بضيغم % % على جسمه نهي وفي يده نهر % 27(@)(@@) % ومعتذر عما تنيل يمينه % % وكل المنى في البعض منه فما العذر % % 28(@)(@@) % بصير بمردي الطعن يغري سنانه % % بجارحة في طيها الورد والغمر % % 29(@)(@@) % يجول فيلقي طعنة فوق طعنة % فأولاهما كلم وأخراهما سبر % % 30(@)(@@) % إذا رفع المغرور للحين رأسه % % يعجله من مد عامله قصر % % PageV01P323 31(@)(@@) % وهيجاء لا يفشي بها الموت سره % إذا لم يكن بالضرب من بيضها جهر % 32(@)(@@) % تهادى بها جرد كأن قتامها % % ظلام وأطراف القنا أنجم زهر % % 33(@)(@@) % إذا قدت البيض الدروع حسبتها % % جداول في الأيمان شقت بها غدر % % 34(@)(@@) % فكم صافحت منها الحروب صفائح % وفت بحصاد الهام أوراقها الخضر % % 35(@)(@@) % ليهن الرعايا منك عدل سياسة % ودفع خطوب لليالي بها غدر % % 36(@)(@@) % ويسر حسمت العسر عنهم بصنعه % % كما حسم الإسلام ما صنع الكفر % % 37(@)(@@) % فلا زلت تجني بالظبا قمم العدى % % وتثمر في الأيدي بها الأسل السمر % % PageV01P324 البحر : طويل 1(@)(@@) % ثلاثة أفلاك عن العين مضمره % % تدور إذا حركتها في حشا كره % 2(@)(@@) % فلا فلك إلا يخص بدورة % موافقة منها الخلاف مقرره % % 3(@)(@@) % وللفلك الناري منهن كفة % ترى النار فيها 
ms94	 للبخور مسعره % % 4(@)(@@) % تمر على فرش الحرير وغيرها % % وراء حجاب وهي غير مؤثره % % 5(@)(@@) % وتبدي دخانا صاعدا من منافس % مصندلة أنفاسه ومعنبره % % 6(@)(@@) % ولم أر نارا تطعم الند قبلها % % لها فلك في الأرض في جوف مجمره % % 7(@)(@@) % تلطف أجساما كثافا بلدغها % % فتصعد أرواحا لطافا معطرة % 8(@)(@@) % وتغشى عليا نفحة كثنائه % % مرددة في مدحه ومكرره % % 9(@)(@@) % همام إذا سل المهند في الوغى % % وأغمده في الهام بالضرب حمره % % 10(@)(@@) % رزين حصاة الحلم شهم مهذب % ترى منه بدرا في السرير وقسوره % % PageV01P325 11(@)(@@) % بنى سعده قصرا على البحر ساميا % فتحسبه من جوهر الحسن صوره % % 12(@)(@@) % ينير على البعد ائتلاقا كأنما % % على الشط لقى لجه منه جوهره % % 13(@)(@@) % أبر على إيوان كسرى فلو رأى % % مراتبه في الملك منه لأكبره % % PageV01P326 البحر : خفيف تام 1(@)(@@) % للأقاحي بفيك نور ونور % ما كذا تسنح المهاة النفور % 2(@)(@@) % من لها أن تعيرها منك مشيا % قدم رخصة وخطو قصير % % 3(@)(@@) % أنت تسبين ذا العفاف بدل % يستخف الحليم وهو وقور % % 4(@)(@@) % وهي لا تستبي بلفظ رخيم % % ينزل العصم وهي في الطود فور % % 5(@)(@@) % وحديث كأنه قطع الرو % ض إذا اخضل من نداه البكور % % 6(@)(@@) % فثناني من روض حسنك عنها % % نرجس ذابل وورد نضير % % 7(@)(@@) % وشقيق يشق عن أقحوان % لنقاب النقا عليه خفير % % 8(@)(@@) % وأريج على النوى منك يسري % % ويجيب النسيم منه عبير % % 9(@)(@@) % وثنايا يضاحك الشمس منها % % في محياك كوكب يستنير % % 10(@)(@@) % ريقها في بقية الليل مسك % شيب بالراح منه شهد مشور % % PageV01P327 11(@)(@@) % لسكون الغرام منه حراك % ولميت السقام فيه نشور % % 12(@)(@@) % ألبس الله صورة منك حسنا % وعيون الحسان نحوك صور % % 13(@)(@@) % لك عين إن ينبع السحر منها % % فهو بالخبل في العقول يغور % % 14(@)(@@) % وجفون تشير بالحب ، منها % % عن فؤاد إلى فؤاد سفير % 15(@)(@@) % وقعت لحظة على القلب منها % % أفلا يترك الحشا ويطير % % 16(@)(@@) % يطبع الوشي فوق حسنك لمسا % منه أمثال ما له تصوير % % 17(@)(@@) % فإذا ما نمى الحديث إليها % % قيل هل ينقش الحرير حرير % % 18(@)(@@) % أنت لا ترحمين منك ، فيفدى ، % معصما 
ms95	 في السوار منه أسير % % 19(@)(@@) % فمتى يرحم الصبا منك صبا % % فاض مستوليا عليه القتير % % 20(@)(@@) % ودعيني فقد تعرض بين % بوشيك النوى إلي يشير % PageV01P328 21(@)(@@) % وغلى بالفراق مرجل حزني % % فهو بالدمع من جفوني يفور % 22(@)(@@) % قالت : اللهم لا أراه حلالا % بيننا ، والعناق حظ كبير % % 23(@)(@@) % قلت : هذا علمته غير أني % % أسال اليوم منك ما لا يضير % % 24(@)(@@) % فاجعلي اللحظ زاد جسم سيبقى % % روحه في يديك ثم يسير % % 25(@)(@@) % فلي الشوق خاذل عن سلوي % % ولدين الهدى علي نصير % % 26(@)(@@) % ملك تتقي الملوك سناه % % أوما يفرس الذئاب الهصور % % 27(@)(@@) % وهو ضار آجامه ذبل الخط % على مقتضى العلى وقصور % % 28(@)(@@) % حازم للطعان أشرع سمرا % % حطمت في الصدور منها صدور % % 29(@)(@@) % وحمى سيفه الثغور فما تق % رب رشف العداة منها ثغور % % 30(@)(@@) % ذو عطاء لو أنه كان غيثا % أورقت في المحول منه الصخور % % PageV01P329 31(@)(@@) % تحسب البحر بعض جدواه لولا % % أنه في الورود عذب نمير % % 32(@)(@@) % من تراه يحد فضل علي % وهو مستصعب المرام عسير % 33(@)(@@) % فبمعروفه ، الخضم غني ، % وإلى بأسه الحديد فقير % 34(@)(@@) % كم له من خميس حرب رحاها % % بسيول من الغمود تدور % % 35(@)(@@) % أرضه من سنابك قادحات % % شرر النقع ، والسماء نسور % % 36(@)(@@) % واجدات القرى بقتلى الأعادي ، % من حشاها لدى النشور نشور % % 37(@)(@@) % جحفل صبحه من النقع ليل % يضحك الموت فيه وهو بسور % % 38(@)(@@) % تضع البيض منه سود المنايا % % بنكاح الحروب وهي ذكور % % 39(@)(@@) % وكأن القتام فيها غمام % بنجيع من البروق مطير % % 40(@)(@@) % وكأن الجواد والسيف واللأ % % مة بحر وجدول وغدير % % PageV01P330 41(@)(@@) % وإذا ما استطال جبار حرب % يجزع الموت منه وهو صبور % % 42(@)(@@) % والتظى في اليمين منه يمان % كاد للأثر منه نمل يثور % % 43(@)(@@) % ودعا وهو كالعقاب كماة % لهم كالبغاث عنه قصور % % 44(@)(@@) % جدلته يدا علي بعضب % لربوع الحياة منه دثور % % 45(@)(@@) % فغدا عاطلا من الرأس لما % % كان طوقا له الحسام البتور % % 46(@)(@@) % لحظ الروم منه ناظر جفن % للردى فيه ظلمة وهو نور % % 47(@)(@@) % رمدت للمنون فيه عيون % فكأن الفرند فيه ذرور % % 48(@)(@@) % يا ابن 
ms96	 يحيى الذي بكل مكان % بالمعالي له لسان شكور % % 49(@)(@@) % لك من هيبة العلى في الأعادي % % خيل رعب على القلوب تغير % % 50(@)(@@) % وسيوف مقيلها في الهوادي % % كلما شب للقراع هجير % % PageV01P331 51(@)(@@) % ودروع قد ضوعف النسج منها % % وتناهى في سردها التقدير % % 52(@)(@@) % كصغار الهاءات شقت فأبدت % شكلها من صفوف جيش سطور % % 53(@)(@@) % أنت شجعت نفس كل جبان % فاقتراب الأسود منه غرور % % 54(@)(@@) % فهو كالماء أحرق الجسم لما % % أحدث اللذع في قواه السعير % % 55(@)(@@) % خير عام أتاك في خير وقت % لوجوه الربيع فيه سفور % % 56(@)(@@) % زار مثواك وهو صب مشوق % بمعاليك ، والمشوق يزور % % 57(@)(@@) % فبدا منك في الجلال إليه % % ملك كابر وملك كبير % % 58(@)(@@) % ورأى في فناء قصرك حفلا % ما له في فناء قصر نظير % % 59(@)(@@) % تشتري فيه بالمكارم حمدا % % لك منه تجارة لا تبور % % 60(@)(@@) % فكأن المداح فيه قروم % ملأ الخافقين منه الهدير % % PageV01P332 61(@)(@@) % بقواف هدوا إليهن سبلا % ضل عنهن جرول وجرير % 62(@)(@@) % إن أيامك الحسان لغر % فكأن الوجوه منها بدور % % 63(@)(@@) % واصل العز في مغانيك عز % دائم الملك ، والسرور سرور % % PageV01P333 البحر : بسيط تام 1(@)(@@) % هذا ابتداء له عند العلى خبر % يحكى فيصغي إليه الشهب والبشر % 2(@)(@@) % كأنه وهو من متن الصبا مثل % من كل قطر من الدنيا له خبر % 3(@)(@@) % ما استحسن الدهر حتى زانه حسن % % وأشرقت في الورى أيامه الغرر % % 4(@)(@@) % شهم له حين يرمي في مناضلة % سهم مواقعه الأحداق والثغر % % 5(@)(@@) % لو خص عصر شباب من سعادته % % بلحظة لم ينله الشيب والكبر % % 6(@)(@@) % ملك جديد المعالي في حمى ملك % % ماض كما طبع الصمصامة الذكر % % 7(@)(@@) % لقد نهضت بعبء الملك مضطلعا % به ظهيراك فيه السعد والقدر % 8(@)(@@) % فإن نصرت على طاغ ظفرت به % % فما حليفاك إلا النصر والظفر % % 9(@)(@@) % وإن خفضت عداة الله أو خذلوا % % فأنت بالله تستعلي وتنتصر % 10(@)(@@) % أصبحت أكبر تعطي كل مرتبة % % حقا وسنك مقرون بها الصغر % % PageV01P334 11(@)(@@) % يخشى حسامك مغمودا فكيف إذا % % ما سل للضرب وانهدت به القصر % % 12(@)(@@) % وليس يعجب من بأس مخايله % % من مقلتيك 
ms97	 عليها يشهد النظر % % 13(@)(@@) % والشبل فيه طباع الليث كامنة % وإنما ينتضيها الناب والظفر % % 14(@)(@@) % إن البلاد إذا ما الخوف أمرضها % % ففي أمانك من أمراضها نشر % % 15(@)(@@) % وما سفاقس إلا بلدة بعثت % إليك عنها لسان الصدق تعتذر % % 16(@)(@@) % وأهلها أهل طوع لا ذنوب لهم % % إني لأقسم ما خانوا وما غدروا % % 17(@)(@@) % وإنما دافعوا عن حتف أنفسهم % % إذ خذمتهم به الهندية البتر % % 18(@)(@@) % ضرورة كان منهم ما به قرفوا % % وبالضرورة عنهم نكب الضرر % 19(@)(@@) % وقد جرى في الذي جاءوا به قدر % ولا مرد لما يجري به القدر % % 20(@)(@@) % وما على الناس في إحسان مملكة % إذا تشاجر فيه المد والحسر % % PageV01P335 21(@)(@@) % كل لعلياك قد كانت حميته % مؤكدا كل ما يأتي وما يذر % % 22(@)(@@) % وهم عبيدك فاصفح عن جميعهم % فالذنب عند كريم الصفح مغتفر % 23(@)(@@) % بكوا أباك بأجفان مؤرقة % % أمواههن من النيران تنفجر % % 24(@)(@@) % ورحمة الله تترى منهم أبدا % عليه ما كرت الآصال والبكر % % 25(@)(@@) % حتى إذا قيل قد حاز العلى حسن % مدوا إلى أحمد الألحاظ وانتظروا % % 26(@)(@@) % وقبلوا من مذاكي خيله فرحا % حوافرا قد علا أرساغها العفر % 27(@)(@@) % مالوا عليها ازدحاما وهي ترمحهم % فكم بها من كسير ليس ينجبر % 28(@)(@@) % شوقا إليهم ومحضا ممن وفائهم % لم يجر في الصفو من أخلاقه كدر % % 29(@)(@@) % أبوك مدت عليهم كف رأفته % % منها جناحا مديدا ظله خصر % % 30(@)(@@) % حدت لهم في قوام الأمر طاعته % حدا فما وردوا عنه ولا صدروا % % PageV01P336 31(@)(@@) % وألف الله في الأوطان شملهم % فنظموا في المغاني بعدما نثروا % % 32(@)(@@) % وأنت عدل فسر فيهم بسيرته % % فالعدل في الملك عنه تحمد السير % % 33(@)(@@) % أنتم ملوك بني الدنيا الذين بهم % ترض ى المنابر والتيجان والسرر % % 34(@)(@@) % أعاظم من قديم الدهر ملكهم % ترى المفاخر تستخذي إذا افتخروا % % 35(@)(@@) % من كل مقتحم في الحرب معتزم % % 36(@)(@@) % ذمر له في ضمير الغمد ذو شطب % كأنه بارق يسطو به قمر % 37(@)(@@) % ' شمس العداوة حتى يستقاد لهم % % وأعظم الناس أحلاما إذا قد رأوا ' % 38(@)(@@) % إليك طيب روض المدح نفحته % لما تفتح فيه 
ms98	 بالندى زهر % 39(@)(@@) % يجوب منه ذكي المسك كل فلا % طيبا ويعبر منه العنبر الذفر % % 40(@)(@@) % كأن زهر الدراري فيه قد نظمت % كما تنظم في أسلاكها الدرر % PageV01P337 41(@)(@@) % يا من تضاعف فيض الجود من يده % كأنما البحر من جدواه مختصر % % 42(@)(@@) % إني نأيت وحظي حط منزلة % كأنما طول باعي عاقه قصر % 43(@)(@@) % وقد نسيت وذكري لا خفاء به % % والمسك يطوى ونشر منه ينتشر % 44(@)(@@) % وقد بعثت رثاء في أبيك ، ولي % % حزن عليه فؤادي منه ينفطر % % 45(@)(@@) % وما بدا لي من جود أمرت به % % عين ، تفوز به عيني ، ولا أثر % % 46(@)(@@) % وكفك المزن تسقي من دنا ونأى % % وليس من غير مزن يرتجى المطر % % 47(@)(@@) % بقيت للدين والدنيا وأهلهما % % ومد في رتب العليا لك العمر % % PageV01P338 البحر : طويل 1(@)(@@) % أبى الله إلا أن يكون لك النصر % وأن يهدم الإيمان ما شاده الكفر % 2(@)(@@) % وأن يرجع الأعلاج بعد علاجها % % خزايا على آثارها الذل والقهر % 3(@)(@@) % ليهنك فتح أولغ السيف فيهم % ولاح بوجه الدين من ذكره بشر % 4(@)(@@) % بسعد كساك الله منه مهابة % وإشراق نور منه تقتبس الزهر % % 5(@)(@@) % ودون مرام الروم فيما سموا له % % قلائد أعناق هي القضب البتر % % 6(@)(@@) % وخطية تختط منهم حيازما % وأحداقها زرق وأجسادها حمر % 7(@)(@@) % إذا أشرعت للطعن سرت كأنما % % كأن حبيا ساكبا فيض ودقه % % 8(@)(@@) % أشبهها بالقطر يبدي تألقا % بأطراف أغصان يحاصرها غدر % 9(@)(@@) % وسحب بأجواف الكنائن أودعت % % شآبيبها نبل من الزنج لا قطر % % 10(@)(@@) % وخيل ترى خيل العلوج ، مضافة % إليها ، حميرا لا التي نتج القفر % PageV01P339 11(@)(@@) % كأن على العقبان منها ضراغما % فأنيابها عصل وأبصارها جمر % 12(@)(@@) % وحمر دماء كالخمور التي سقوا % % تحمر منها في الظبا ورق خضر % 13(@)(@@) % بنو الأصفر اصفرت حذارا وجوههم % % فأيديهم من كل ما طلبوا صفر % 14(@)(@@) % تنادوا كأسراب القطا في بلادهم % % وكان لهم في كل قاصية نفر % 15(@)(@@) % ولما تناهى جمعهم ركبوا به % % 16(@)(@@) % تولت جنود الله بالريح حربهم % وليس لمخلوق على حربها صبر % % 17(@)(@@) % فكم من فريق منهم إذ تفرقوا % % له غرق في زخرة 
ms99	 الموج أو أسر % % 18(@)(@@) % وظلت سباغ الماء وهي تنوشهم % فلا شلو منهم في ضريح ولا قبر % 19(@)(@@) % فإن سلم الشطر الذي لا سلامة % له من ظبا الهيجا فقد عطب الشطر % % 20(@)(@@) % أتوا بأساطيل تمر كأنها % % PageV01P340 21(@)(@@) % وخيل حشوا منها السفين ولم يكن % لها في مجال الحرب كر ولا فر % 22(@)(@@) % وقد ركبت فرسانها صهواتها % % 23(@)(@@) % سلاهب أهدوها إليك ولم يكن % جزاء لذاك من علاك ولا شكر % % 24(@)(@@) % فسل عنهم الديماس تسمع حديثهم % % فهم بالمواضي في جزيرته جزر % % 25(@)(@@) % وما غنموا إلا منى كذبت لهم % % وكان لهم بالقصر عن نيلها قصر % % 26(@)(@@) % شروه فباعوا بالردى فيه أنفسا % أربح لهم في ذلك البيع أم خسر % % 27(@)(@@) % وقد طمعوا في الزعم أن يثبتوا له % % جناحين يضحي منهما وهو النسر % % 28(@)(@@) % وراموا به صيد البلاد وغنمها % % فأضحى وقد قصت خوافقه العشر % 29(@)(@@) % أذيقوا به حصرا أذل عرامهم % % كما ضاق عند الموت عن نفس صدر % % 30(@)(@@) % وجر إليهم في جبال من القنا % % مناياهم بالقتل جحفلك المجر % PageV01P341 31(@)(@@) % وقائدك الشهم الذي كان بينهم % صبيحة لاقاهم على يده النصر % 32(@)(@@) % رأوا بأبي إسحق سحقا لجمعهم % % فإبرامهم نقض ونظمهم نثر % % 33(@)(@@) % ولو لبثوا في ضيق حصرهم ولم % يطر منهم شوقا إلى أجل عمر % % 34(@)(@@) % لقام عليهم منجنيق يظلهم % بصم مراد ما لما كسرت جبر % % 35(@)(@@) % إذا وزن الموت الزؤام عليهم % بكفة وزان مثاقيله الصخر % 36(@)(@@) % فكم جهدوا أن يفتدوا من حمامهم % % بأوزانهم تبرا فما قبل التبر % % 37(@)(@@) % هناك شفى الإسلام منهم غليله % بطعن له بتر وضرب له هبر % 38(@)(@@) % وكانوا رأوا مهديتيك وفيهما % % لعز الهدى أمر فهالهم الأمر % 39(@)(@@) % كأن بروج الجو منك رمتهم % بشهب لها نار وليس لها جمر % 40(@)(@@) % فما للعلوج امتد في الغي جهلهم % % أما كان فيهم من لبيب له حجر % PageV01P342 41(@)(@@) % فكم قسموا في الظن أميال أرضنا % % ولم يطأوا منها مكانا هو الشبر % 42(@)(@@) % ولا وردوا من مائها حسو طائر % يبل به منه ، إذا يبس ، السحر % 43(@)(@@) % أما فتحت منهم بلادا بلادنا % % بزعمهم كفرا 
ms100	 على إثره كفر % % 44(@)(@@) % وكانت مفاتيح البلاد سيوفنا % % وأقفالها إذا فتحهن له عسر % % 45(@)(@@) % وآذى زجار فتح ريو وقطرها % % يهد قواه من صقلية قطر % 46(@)(@@) % ألم يسب جيش الغزو منهم نواعما % فمن تيب تقتاد في إثرها بكر % 47(@)(@@) % وقوصرة فيها رؤوس جدودهم % % إلى اليوم ملآن بأفلاقها العفر % 48(@)(@@) % فلو تسأل الريح المعاطس منهم % لأخبرها عن كل شلو بها دفر % 49(@)(@@) % وما قتلوا من شدة البأس أهلها % % ولكنهم قل أحاط بهم كثر % % 50(@)(@@) % أتعجم نبع العرب عجم ولا يرى % % لما اشتد منها في نواجذها كسر % % PageV01P343 51(@)(@@) % توالت عليها منهم كل صيحة % كما روع الأعيار من أسد زأر % % 52(@)(@@) % فجاءت رياح والرياح جيادها % % فشد من الدين القويم بها أزر % % 53(@)(@@) % فأول إنصاف تولوه كفهم % أذى كل فظ في سجيته غدر % 54(@)(@@) % وبادرت الإقدام منهم بمقدم % % فكم خبر عنها يصدقه الخبر % % 55(@)(@@) % ودهم بني دهمان فاض على الوغى % % بكل فتى أحلى بسالته مر % 56(@)(@@) % وشاهت من الضلال بالعز أوجه % عليها بسور إذ تصدى لها بتر % % 57(@)(@@) % وكرت بنو زيد على كل شيظم % % وسر المواضي في أكفهم جهر % 58(@)(@@) % وجاء ابن زياد بصخر فكافحت % % عن الثغر أنياب فلم يلثم الثغر % % 59(@)(@@) % هزبر على بحر من الحرب مفعم % على جسمه نهي وفي يده نهر % % 60(@)(@@) % وقد حال بين الروم والبحر فالتجوا % % إلى القصر حتى جاءهم بالردى القصر % PageV01P344 61(@)(@@) % أعارب جدوا في جهاد أعاجم % خنازير شبت حربها أسد هصر % 62(@)(@@) % إذا قيل يا أهل الحفائظ أقبلت % ملبية فيها غطارفة غر % 63(@)(@@) % عليهم من الماذي كل مفاضة % مكحلة بالنقع أعينها الخزر % % 64(@)(@@) % كتائب من كل القبائل أقبلت % لفرض جهاد ما لتاركه عذر % % 65(@)(@@) % أعز بهم ذو العرش دين محمد % وضم عليه من كفالته حجر % % 66(@)(@@) % وفي كل سيف سايرت منهم العدى % % قبائل منهم أشبع السهل والوعر % 67(@)(@@) % إذا ماج بحر في شوانيهم بهم % % أتى مدد منا فماج به البر % 68(@)(@@) % حمى ابن علي حوزة الدين فاحتمى % % كمفترس الكفين يدمي له ظفر % % 69(@)(@@) % مليك له في الملك سيرة 