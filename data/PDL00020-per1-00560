ms556	 او پرپری صرصر صفت در صفدری %~% تیرش چو تیغ حیدری از خلد ابرار آمده(@)(@@) 30 اشرار مشتی بازپس رانده به کین او نفس %~% پیکانش چون پر مگس در چشم اشرار آمده(@)(@@) 31 ناکرده مکر مکیان جان محمد را زیان %~% چون عنکبوتی در میان پروانه غار آمده(@)(@@) 32 ای خانه دار ملک و دین تیغت حصار ملک و دین %~% بهر عیار ملک و دین رای تو معیار آمده(@)(@@) 33 پیشت صف بهرامیان بسته غلامی را میان %~% در خانه اسلامیان عدل تو معمار آمده(@)(@@) 34 ای چنبر کوست فلک کرده زمین بوست فلک %~% وز خصم منحوست فلک چون بخت بیزار آمده(@)(@@) 35 نیکان ملت را به دین یاد تو تسبیح مهین %~% پیکان نصرت را به کین عزم تو هنجار آمده(@)(@@) 36 بادت ز غایات هنر بر عرش رایات خطر %~% در شانت آیات ظفر از فضل دادار آمده(@)(@@) 37 تابع فلک فرمانت را دربان ملک ایوانت را %~% سرهای بدخواهانت را هم رمح تو دار آمده(@)(@@) 38 لاف از درت اسلام را فال از برت اجرام را %~% تا ابلق ایام را از چرخ مضمار آمده(@)(@@) 39 از مدح تو اشعار من رونق فزا در کار من %~% دولت همیشه یار من با بخت بیدار آمده(@)(@@) 40 من جان سپار مدح تو صورت نگار مدح تو %~% با آب کار مدح تو الفاظم ابکار آمده(@)(@@) 41 امروز احرار زمن خوانندم استاد سخن %~% صد عنصری در پیش من شاگرد اشعار آمده PageV1P0613(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 صبح خیزان بین به صدر کعبه مهمان آمده %~% جان عالم دیده و در عالم جان آمده(@)(@@) 2 آستان خاص سلطان سلاطین داده بوس %~% پس به بار عام پیش صفه مهمان آمده(@)(@@) 3 کعبه برکرده عرب‌وار آتشی کز نور آن %~% شب روان در راه منزل منزل آسان آمده(@)(@@) 4 کعبه استقبالشان فرموده هم در بادیه %~% پس همه ره با همه لبیک گویان آمده(@)(@@) 5 شب روان چون کرم شب تابند صحرائی همه %~% خفتگان چون کرم 
ms557	 قز زنده به زندان آمده(@)(@@) 6 کعبه برخوانی نشانده فاقه زدگان را به ناز %~% کز نیاز آنجا سلیمان مور آن خوان آمده(@)(@@) 7 بر سر آن خوان عزت نسر طائر دان مگس %~% بلکه پر جبرئیل آنجا مگس ران آمده(@)(@@) 8 از برای خوان کعبه ماه در ماهی دو بار %~% گاه سیمین نان و گه زرین نمکدان آمده(@)(@@) 9 رسته دندان از در سلطان به دست خاصگان %~% از بن دندان طفیل هفت مردان آمده(@)(@@) 10 پیش دندان از در سلطان به دست خاصگان %~% دوستکانی سر به مهر خاص سلطان آمده(@)(@@) 11 مصطفی استاده خوان سالار و رضوان طشت‌دار %~% هدیه دندان مزد خاص و عام یکسان آمده(@)(@@) 12 هم خلال از طوبی و هم آب‌دست از سلسبیل %~% بلکه دست آب همه تسکین رضوان آمده(@)(@@) 13 آسمان آورده زرین آب‌دستان ز افتاب %~% پشت خم پیش سران چون آب‌دستان آمده(@)(@@) 14 خضر جلابی به دست از آب‌دست مصطفی %~% کوست ظلمات عرب را آب حیوان آمده(@)(@@) 15 فاقه پروردان چو پاکان حواری روزه‌دار %~% کعبه همچون خوان عیسی عید ایشان آمده(@)(@@) 16 یوسفان در پیش خوان کعبه صاع استان چنانک %~% پیش یوسف قحط پروردان کنعان آمده(@)(@@) 17 خوان کعبه جان موسی را همی ماند که هست %~% تسع آیاتش به جای سبع الوان آمده(@)(@@) 18 بر سر آن خون دل پاکان چو مرغان بهشت %~% نیمه‌ای گویا و دیگر نیمه بریان آمده(@)(@@) 19 کعبه در تربیع همچون تخت نرد مهره باز %~% کعبتین تنها و نراد انسی و جان آمده(@)(@@) 20 نقش یک تنها به روی کعبتین پیدا شده %~% پس شش و پنج و چهار و سه دو پنهان آمده(@)(@@) 21 هر حسابی کرده بر حق ختم چون نرد زیاد %~% هر که شش پنجی زده یک بر سر آن آمده(@)(@@) 22 عالمان چون خضر پوشیده برهنه پا و سر %~% نعل پی‌شان همسر تاج خضر خان آمده(@)(@@) 23 صوفیان رکوه پر آب زندگانی چون خضر %~% همچو موسی در عصاشان جان 
ms558	 ثعبان آمده(@)(@@) 24 هو و هو گریان مریدان هوی هوی اندر دهان %~% چون صدف تن غرق اشک و سینه عطشان آمده(@)(@@) 25 ز آه ایشان گه الف چون سوزن عیسی شده %~% گاه همچون حلقه زنجیر مطران آمده(@)(@@) 26 آتشین حلقه ز باد افسرده و جسته ز حلق %~% رفته ساق عرش را خلخال پیچان آمده(@)(@@) 27 ز آهشان یک نیمه مسمار در دوزخ شده %~% باز دیگر نیمه طوق حلق شیطان آمده(@)(@@) 28 ای مربع‌خانه نور از خروش صادقان %~% چون مسدس خان زنبوران پر افغان آمده(@)(@@) 29 کعبه همچون شاه زنبوران میان‌جا معتکف %~% عالمی گردش چو زنبوران غریوان آمده(@)(@@) 30 چون مشبک خان زنبوران ز آه عاشقان %~% بس دریچه کاندرین بام نه ایوان آمده(@)(@@) 31 آفتاب اشتر سواری بر فلک بیمار تن %~% در طواف کعبه محرم‌وار عریان آمده(@)(@@) 32 خون قربان رفته در زیر زمین تا پشت گاو %~% گاو بالای زمین از بهر قربان آمده(@)(@@) 33 بر زمین الحمد الله خون حیوان بسته نقش %~% بر هوا تسبیح گویان جان حیوان آمده(@)(@@) 34 کعبه در ناف زمین بهتر سلاله از شرف %~% کاندر ارحام وجود از صلب فرمان آمده(@)(@@) 35 کعبه خاتون دو کون او را در این خرگاه سبز %~% هفت بانو بین پرستار شبستان آمده(@)(@@) 36 صبح و شام او را دو خادم جوهر و عنبر به نام %~% این ز روم آن از حبش سالار کیهان آمده(@)(@@) 37 خادمانش بر دو طفلانند اتابک و آن دو را %~% گاهواره بابل و مولد خراسان آمده(@)(@@) 38 خال مشک از روی گندم‌گون خاتون عرب %~% عشاقان را آرزوبخش و دلستان آمده(@)(@@) 39 کعبه صرافی دکانش نیم بام آسمان %~% بر یکی دستش محک زر ایمان آمده(@)(@@) 40 بر محک کعبه کو جنس بلال آمد به رنگ %~% هر که را زر بولهب روی است شادان آمده(@)(@@) 41 بر سیاهی سنگ اگر زرت سپید آید نه سرخ %~% ز آن سپیدی دان سیاهی روی دیوان آمده(@)(@@) 42 سنگ زر شب‌رنگ لیکن 
ms559	 صبح‌وار از راستی %~% شاهد هر بچه کز خورشید در کان آمده(@)(@@) 43 در سیاهی سنگ کعبه روشنائی بین چنانک %~% نور معنی در سیاهی حرف قرآن آمده(@)(@@) 44 زمزم آنگه چون دهانی آب حیوان در گلو %~% وان دهان را میم لب چون سین دندان آمده(@)(@@) 45 پیش عیسی‌دم چه زمزم صلیب دلو چرخ %~% سرنگون بی‌آب چون چاه زنخدان آمده(@)(@@) 46 مصطفی کحال عقل و کعبه دکان شفاست %~% عیسی آنجا کیست هاون‌کوب دکان آمده(@)(@@) 47 عیسی اینک پیش کعبه بسته چون احرامیان %~% چادری کان دست ریس دخت عمران آمده(@)(@@) 48 کعبه را از خاصیت پنداشته عود الصلیب %~% کز دم ابن الله او را ام‌صبیان آمده(@)(@@) 49 از اانتش «همزه» مسمار و «الف» داری شده %~% بر چینین داری ز عصمت کاف‌ها خوان آمده(@)(@@) 50 گر حرم خون گرید از غوغای مکه حق اوست %~% کز فلاخشان فراز کعبه غضبان آمده(@)(@@) 51 بر خلاف عادت اصحاب فیل است ای عجب %~% بر سر مرغان کعبه سنگ‌باران آمده(@)(@@) 52 مکیان چو ماکیانان بر سر خود کرده خاک %~% چکز خروس فتنه‌شان آواز خذلان آمده(@)(@@) 53 بوقبیس آرامگاه انبیا بوده مقیم %~% باز عصیان‌گاه اهل بغی و عصیان آمده(@)(@@) 54 کرده عیسی نامی از بالای کعبه خیبری %~% واندر او مشتی یهودی رنگ فتان آمده(@)(@@) 55 زود بینام از جلال کعبه مریم صفت %~% خیبر وارون عیسی گرد ویران آمده(@)(@@) 56 من به چشم خویش دیدم کعبه را کز زخم سنگ %~% اشک‌بار از دست مشتی نابسامان آمده(@)(@@) 57 کرده روح القدس پیش کعبه پرها را حجاب %~% تا بر او آسیب سنگ از اهل طغیان آمده(@)(@@) 58 بوقبیس از شرم کعبه رفته در زلزال خوف %~% کعبه را از روی ضجرت رای ثهلان آمده(@)(@@) 59 کعبه در شامی سلب چون قطره در تنگی صدف %~% یا صدف در بحر ظلمانی گروگان آمده(@)(@@) 60 کعبه قطب است و بنی‌آدم بنات النعش‌وار %~% گرد قطب آسیمه سر شیدا و حیران آمده(@)(@@) 61 کعبه هم قطب است و گردون 
ms560	 راست چون دستاس زال %~% صورت دستاس را بر قطب دوران آمده(@)(@@) 62 کعبه روغن خانه‌ای دان و روز و شب گاو خراس %~% گاو پیسه گرد روغن خانه گردان آمده(@)(@@) 63 کعبه شمع و روشنان پروانه و گیتی لگن %~% بر لگن پروانه را بین مست جولان آمده(@)(@@) 64 کعبه گنج است و سیاهان عرب ماران گنج %~% گرد گنج آنک صف ماران فراوان آمده(@)(@@) 65 کعبه شان شهد و کان‌زر درست است ای عجب %~% خیل زنبوران و مارانش نگهبان آمده PageV1P0614(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 الوداع ای کعبه کاینک وقت هجران آمده %~% دل تنوری گشته و زو دیده طوفان آمده(@)(@@) 2 الوداع ای کعبه کاینک مست راوق گشته خاک %~% زانکه چشم از اشک میگون راوق افشان آمده(@)(@@) 3 الوداع ای کعبه کاینک هفته‌ای در خدمتت %~% عیش خوابی بوده و تعبیرش احزان آمده(@)(@@) 4 الوداع ای کعبه کاینک کالبد با حال بد %~% رفته از پیش تو و جان وقت هجران آمده(@)(@@) 5 الوداع ای کعبه کاینک درد هجرت جانگزاست %~% شمه‌ای خاک مدینه حرز و درمان آمده(@)(@@) 6 الوداع ای کعبه کاینک روز وصلت صبح‌وار %~% دیر سر برکرده و بس زود پایان آمده(@)(@@) 7 مکه می‌خواهی و کعبه‌ها مدینه پیش توست %~% مکه تمکین و در وی کعبه جان آمده(@)(@@) 8 مصطفی کعبه است و مهر کتف او سنگ سیاه %~% هرکس از بهر کف او زمزم افشان آمده(@)(@@) 9 گرد چار ارکان او بین هفت طوق و شش جهت %~% چار ارکانش ز یاران چار اقران آمده(@)(@@) 10 حبذا خاک مدینه حبذا عین النبی %~% هر دو اصل چار جوی و هشت بستان آمده(@)(@@) 11 در مدینه مصطفی دین مشخص دان و بس %~% زانکه از دین در مدینه اصل و بنیان آمده(@)(@@) 12 گر بخوانی ورنویسی هم به اسم و هم به ذات %~% در مدینه نقش دین بینی به برهان آمده(@)(@@) 13 پیش بزم مصطفی بین دعوت کروبیان %~% عود سوزان آفتاب و عود کیوان آمده(@)(@@) 14 پیش صدر مصطفی 