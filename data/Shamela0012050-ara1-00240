ms221	 و"أضجوا" جلبوا والأعم في ضجوا جزعوا من شيء خافوه ضجيجا.(@)(@@) ع - و"الضجاج" بفتح الضاد الاسم والضجاج بالكسر مصدر ضاجه مضاجة وضجاجا.(@)(@@) ضبب: ق - و"ضب" ضبا لغة سكت و"أضب" المعروف و"ضب" الماء والدم يضب ضب سال ولثة الرجل لشيء حرص عليه والشفة ورمت والناقة حلبتها بجميع كفك ضبا أيضا.(@)(@@) ع -1 تضبها.(@)(@@) PageV02P278(@)(@@) ق -1 و"ضب" البعير ضببا و"ضبا"2 وجعه فرسنه و"أضب" الرجل اندمل على "ضب وهو احلقد"3 وأيضا اقام على الشيء ولزمه والقوم تكلموا والسماء واليوم كثر ضبابهما مضبان وعلى الشيء أشرفت.(@)(@@) ع -4 و"ضبب" البلد ضببا.(@)(@@) ع -1 "وأضب" كثر ضبابه عن أبي زيد و"ضب" على الشيد و"أضب أخذه وعلى الشيء استولى كذلك "ضب" البعير يضب ضببا وهو ورم يصيب فرسنه وقال الإصمعي "أضب" على مافي نفسه إذا سكت وقال أبو زيد "أضب" إذا تكلم فيكون من الأضداد و"ضب" البعير و"تضب" إذا كثر لحمه وسمن و"أضب" السقاء فسد لبنه.(@)(@@) ضمم و"ضم"5 الشيء ضما جمعه.(@)(@@) ضلل ق - و"ضل" يضل ضلالا و"ضلالة"6 جار عن. PageV02P279(@)(@@) دين أو طريق.(@)(@@) ع - هذه لغة نجد أهل العالية يقولون ضللت أضل.(@)(@@) ق -1 والشيء غاب وبطل.(@)(@@) ع - وأيضا مات "قال الله تعالى "ضللنا في الأرض" وأيضا ضاع.(@)(@@) ق - وضللت الموضع وضللته لغة ضلالا لم أهتد إليه.(@)(@@) ع -1 ومنه قوله تعالى: {لا يضل ربي ولا ينسى} أي لا يغيب عنه شيء و"ضللت" أضل لغة تميم.(@)(@@) ق - والشيء نسيته و"أضللت" الدابة وكل شيء يزول عن موضعه مثله والميت دفنته والشيء ضيعته.(@)(@@) ع - والرجل وجدته ضالا.(@)(@@) ضدد: ق - و"ضددت" الإناء ضدا ملأته "أضددت" أتيت بالضد وهو خلاف الشيء.(@)(@@) ع - و"أضد" الرجل غضب. PageV02P280(@)(@@) ضنن: ق -1 و"ضن" يضن ويضن ضنانة وضنا.(@)(@@) ع - وضنا.(@)(@@) ق -1 بخل.(@)(@@) ضمم: و"ضم" الشيء إلى غيره ضما جمعه.(@)(@@) و"ضف" الناقة ضفا حلبها بجميع الكف والماء والطعام أكثرت عليه القوم ومنه الضفف الجماعة والعيش اشتد.(@)(@@) ع - وأيضا ضاق وهو الحاجة وازدحام الناس على الماء.(@)(@@) ضزز: ق - و"ضز" يضز ضززا لصق حنكه الأعلى بالأسفل.(@)(@@) ع - وأيضا كذلك2 
ms222	 والفرس على فأس اللجام أزم عليه.(@)(@@) ع - وضز3 الدابة يضزها ضزا علفها القت والنوى.(@)(@@) ضخخ: ق - و"ضخ" البول ضخا إمتد.(@)(@@) ضكك: و"أضكه" ضكا غمزه شديدا وبالحجة قهره. PageV02P281(@)(@@) والأمر كربه.(@)(@@) ضرر: ق - و"ضره" ضزا وضررا و"أضره"1 ضد نفعه.(@)(@@) ع - وقد "ضررت" إذا أصابه الضر من مرض أو سوء حال و"ضررت" ضررا إذا ذهب بصره.(@)(@@) ق - و"أضر" الرجل والمرأة تزوجا على ضرة.(@)(@@) والرجل الح2 وأيضا الرجل أسرع والشيء دنا من الشيء.(@)(@@) ع - وأيضا لزم وأيضا راحت عليه ضرة من المال.(@)(@@) ق -3 والفرس عض على فأس اللجام.(@)(@@) ع -1 وبالزاي أيضا كذلك. PageV02P282(@)(@@)(@@)(@@) | باب المهموز(@)(@@) ضنأ: "ضنأت" المرأة ضنأ وضناء و"أضنأت" كثرولدها.(@)(@@) ع - وكذلك "ضنت" وأضنت بلا همز.(@)(@@) ق - والماشية كثر نتاجها كذلك والقوم كثر أولادهم كذلك.(@)(@@) ع - و"ضنأت" في الأرض ضنأ وضنوأ إختبأت.(@)(@@) ضؤء: ق - و"ضاء" القمر وغيره ضوءا وضياء و"أضاء".(@)(@@) PageV02P282(@)(@@) ضد أظلم.(@)(@@) ع - و"أضوأ" والنار كذلك و"أضأته" يتعدى ولا يتعدى و"أضاء" الرجل ببوله حذف به.(@)(@@) ضأن: ق - و"ضأنت" الضأن عزلتها عن المعز و"أضأن" الرجل كثر ضأنه.(@)(@@) ضبأ: و"ضبأ" بالأرض "ضبأ"1 وضبو الصق بها والى الشيء لجأت.(@)(@@) ع - ومنه إستحييت وبه الارض ألصقته بها وأيضا إستخفيت وأيضا نهضت ووثبت وأيضا سكت.(@)(@@) ق - وأضبأت على الشيء سكت.(@)(@@) ضؤل: و"ضؤل" الشيء ضآلة وضؤولة صغر و"أضأل" الوادي كثره ضأله ضؤل وهو السدر والبرى و"أضيل" لغة.(@)(@@) ع - و"أضال" أيضا وضؤل أيضا نحف جسمه وأيضا ضعف و"ضأله" ضألا حقره و"ضؤل" الرأى فال.(@)(@@) ضأد: ق - و"ضأدت" الشيء ضأدا ملأته.(@)(@@) ع - والرجل خصمته.(@)(@@) ق - وضئد الإنسان ضؤودة زكم.(@)(@@) ع - و"ضرأ" الرجل ضروأ إستخفى. PageV02P283(@)(@@)(@@)(@@) | باب المعتل(@)(@@) ضغو: ضغا الكلب وغيره ضغاء و"أضغى" صوت وانشد حتى ضغانابحهم فوقوقا والكلب لا ينبح إلا فرقا وضغا الكلب والذئب ضغوا صاح1.(@)(@@) ضيف: و"ضاف" السهم عن الهدف ضيفا عدل والشجاع عن الشجاع مثله والرجل والرجل صار ضيفه.(@)(@@) ع - والشمس مالت للغروب و"تضيفت" كذلك و"ضافه" الهم نزله به.(@)(@@) ق - و"أضفت" الرجل أنزلته على نفسي2 وأيضا نسبته إلى غير قومه وإلشيء إلى الشيء أسندته والرجل رفع صوته 
ms223	 صارخا ومن الأمر أشفق.(@)(@@) ع - و"ضاف" أيضا أشفق لغة.(@)(@@) ضوع, ضيع: ق - و"ضاعه" الشيء ضوعا حركه وأيضا أفزعه والشيء إنتشرت رائحته وطالبت والطائر فرخه بصوته حركه و"ضاع" الشيء ضياعا تلف و"أضاف" الرجل كثرت ضيعته.(@)(@@) ضوى: و"ضويت" إليك ضيا وضويا أويت إليك و"ضوى". PageV02P284(@)(@@) ضوى رق جسمه و"أضوى" الإنسان ولد ولدا ضاويا وقال عمر رضي الله عنه يا نبي السائب انكم قد أضويتم فانكحوا في النزائع أي الغرائب.(@)(@@) ع - وحقه نقصه والأمر لم يحكمه والأمر أضعفته و"ضوى" البعير أصابته الضواة وهي ورم في حلقه.(@)(@@) ضحو, ضحى: ق - و"ضحا" و"ضحى"1 ضحوا وضحيا وضحيا برز للشمس والطريق ضحوا ظهر و"أضحى" يفعل كذا فعله صليناها في ذلك الوقت و"ضحى" ضحاء أصابه حر الشمس.(@)(@@) ع - والليلة لم يكن فيها غيم والمرأة لم يكن على عانتها شعر "وضحا ظل الرجل مات"2 والفرس إببض فهو أضحى والرجل عرق ضحى.(@)(@@) ضبو: ق - و"ضبت" النار الشيء غيرته ضبوا.(@)(@@) ع -2 وضبيا أيضا.(@)(@@) ق -2 و"أضبيت" على الشيء سكت وكتمت وأيضا أشرفت عليه لأظفر به. PageV02P285(@)(@@) ضوز, ضيز: و"ضازه" حقه ضوزا وضيزا منعه وكذلك "ضأزه" ضأزا بالهمز وقسمة ضيزى أي جائرة والشيء ضوزا مضغه.(@)(@@) ضار: و"ضاره" ضورا وضيرا ضد نفعه وأيضا زاده.(@)(@@) ضوك, ضيك: ع -1 وضاك الفرس الحجر ضوكانزا عليها.(@)(@@) ق - و"ضاك" ضيكا تحرك في مشيته.(@)(@@) ضوج, ضيج: ع - و"ضاج" السهم عن الهدف ضوجا مال عنه والوادي إتسع والعظام ضيجا وضيجانا تحركت من الهزال وضاج ضيجا مثل جاض جيضا2.(@)(@@) ضيس: وضاس النبت ضيسا هاج.(@)(@@) ضول: و"أضالت" الارض و"أضيلت" كثر فيها الضال.(@)(@@) ضرو: ق - و"ضرا" العرق بالدم ضروا سال و"ضرى" ضراوة وضرى تعود ولزم2 و"ضرى" السبع و"ضرو" ضراوة لزم الصيد وأولع به.(@)(@@) ضفو: و"ضفا" الشيء ضفوا كثر.(@)(@@) ع - وأيضا طال.(@)(@@) ضيم: ق - و"ضامه" ضيما أذله وحقره وأيضا حقه نقصه. PageV02P286(@)(@@) ضيط: و"ضاط" في مشيته ضيطا و"وضيطانا"1 تمايل.(@)(@@) ضنئ, ضنئا: و"ضنت" المرأة ضناء كثر ولدها و"ضنى ضنى اشتد مرضه وضناء كذلك.(@)(@@) ع - و"أضنى" إضناء و"ضنى" أيضا و"ضنت"2 المرأة ضناء ممدود كثر ولدها و"أضنت" عن 
ms224	 أبي زيد.(@)(@@) ضيق: و"ضاق" الشيء ضيقا وضيقا وهو شك يكون في القلب وأيضا بخل و"أضاق" الرجل مثل أعسر. PageV02P287(@)(@@)(@@)(@@) | باب الثنائي المكرر(@)(@@) ضعضع ": الضعضة الخضوع والتذلل وفي الحديث ما تضعضع إمرؤ لآخر يريد عرض الدنيا إلا ذهب ثلثا دينه وأيضا ضعف وخف جسمه من مرض أو حزن وماله قل.(@)(@@) ضكضك: و"الضكضكة" الضغط يقال "ضكه" وضكضكه ضغطه وهي أيضا سرعة المشي ورجل "ضكضاك" قصير غليظ الجسم.(@)(@@) ضغضغ: و"الضغضغة" بالغين المعجمة أن يتكلم الرجل فلا يبين الكلام وهي أيضا لوك الدرداء والصبئ و"ضغضغ" اللحم.(@)(@@) PageV02P287(@)(@@) لم يحكم مضغه.(@)(@@) ضحضح: و"الضحضحة" والتضحضح جرى السراب.(@)(@@) ضوضى: و"ضوضى" الرجال ضوضاة وضوضاء سمعت أصواتهم.(@)(@@) ضخضخ: و"الضخضخة" بالخاء المعجمة قلة الماء في الغدران.(@)(@@) ضمضم: و"الضمضمة" الكسر.(@)(@@) ضأضا: و"الضأضاة" الوطء في الماء.(@)(@@) PageV02P288(@)(@@)(@@)(@@) | باب الرباعي الصحيح(@)(@@) ضرفط: قال يونس رجل "مضرفط" بالحيال أي موثق.(@)(@@) ضرزم: والضرزمة" شدة الأكل.(@)(@@) اضرورى: و"اضرورى" انتفخ واتخم.(@)(@@) ضاهأ: و"المضاهاة" المشاكلة يهمز ولا يهمز.(@)(@@) PageV02P288(@)(@@)(@@)(@@) | باب الخماسي والسداسي(@)(@@) 1.(@)(@@) إضعنفر: إضعنفرت2 الحمر تفرقت.(@)(@@) اضباك, اضماك: و"اضباكت" الأرض و"اضماكت" خرج نبتها وأيضا إخضرت واللبن خثر. PageV02P288(@)(@@) اضمأد: و"إضمأد"1 كذلك و"اضماك" أيضا إنتفخ من الغضب.(@)(@@) اضبأك: و"اضبأك" بالباء كذلك.(@)(@@) اضطبأ: و"اضطبأت" منه استحييت.(@)(@@) اضرغط: و"اضرغط" استرخى وأيضا عظم جسمه.(@)(@@) اضفأد: و"اضفأد" الرجل امتلأ لحما وشحما وأيضا انتفخ من الغضب.(@)(@@) اضطهب: و"اضطهب" شوى اللحم.(@)(@@) اضمحل: و"اضمحل" الشيء هذب و"امضحل" مثله. PageV02P289(@)(@@)(@@)(@@) | الطاء على فعل وأفعل باتفاق معنى وغيرة من الثلاثي الصحيح(@)(@@)(@@)(@@) | مدخل(@)(@@) ...(@)(@@) الطاء على فعل وأفعل بمعنى واحد وغيره من الثلاثي الصحيح.(@)(@@) طلق: و"طلقت" يدى بالخير طلوقة وطلوقا و"أطلقتها" و"ضلقت" المرأة و"طلقت" طلاقا بانت من زوجها والناقة سرحت حيث شاءت و"طلقت" اليد طلوقة وطلوقا جادت و"طلقت المرأة طلقا اخذها وجع الولادة و"طلق" الوجه طلاقة سهل و"طلق"2 اليوم والليلة لم يكن فيهما حر ولا قر3 ولا مكروه واللسان طلوقا وطلوقة كان حديدا وأطلقتت كل محبوس خليت سبيله والدواء أسهل والقوم. PageV02P289(@)(@@) كانت إبلهم طوالق.(@)(@@) ع - والقوم انكشف عنهم الغيم.(@)(@@) ضفل: ق - و"ضفلت" الشمس طفولا وطفلا و"أطفلت" دنت للطلوع وللمغيب أيضا كذلك و"طفلت" الجارية وغيرها طفولة وطفالة 
ms225	 رخصت و"أطفلت" كل أنثى كان معها طفل.(@)(@@) طلع: و"طلعت" على القوم طلوعا و"أطلعت" أشرفت والشمس والقمر والنجوم كذلك والنخل ظهر طلعه كذلك و"طلعت" عن القوم طلوعا غبت عنهم "ضد"1 و"طلعت" الجبل وغيره و"طلعت" طلوعا إرتقيت إليه و"أطلعت" النخلة طالت ومن فوق الجبل أشرفت والرجل قاء والطلعاء القئ.(@)(@@) ع - والزرع بدا والرامي جاز سهمه من فوق الغرض.(@)(@@) طرق: ق - و"طرقت" الحديد ضربته بالمطرقة والصوف بالعصا مثله طرقا والاهل أتاهم ليلا والنجم طلع ليلا طروقا فيهما. PageV02P290(@)(@@) والإبل في الماء طرقا بالت فيه وخوضته والكاهن بالحصى ضرب بها والفحل طرقا ضرب النوق و"طرقت" الرجل طرقا إعوج ساقها والبعير مثله لانت يداه.(@)(@@) ع - والريش كان بعضه فوق بعض.(@)(@@) ق - و"طرق" الانسان في عقله طرقا ضعف و"أطرق" سكت وأيضا استرخت حفون عينه والنعل والترس اطبقتهما.(@)(@@) ع - وقال أبو زيد "طرقت" النل وأطرقتها بمعنى.(@)(@@) ق - و"أطرقت" الفحل وهبت ضرابه سنة و"أطرق" جناح الطائر ألبس الريش الأعلى الاسفل والإبل تتابعت والرجل بقى راجلا.(@)(@@) طرف: و"طرف" البصر طرفا تحرك و"طرفته" أصبته بضربة أو رمية والحزن أضابه والشيء صرفك.(@)(@@) ع - وانشد1.(@)(@@) "انك والله لو ملة.(@)(@@) يطرفك الأدنى عن الأبعد". PageV02P291(@)(@@) أي يصرفك.(@)(@@) ق -1 و"طرف" الشيء طرافة أعجبك و"طرفت" المرأة لم تثبت على مودة و"أطرفتك" أتحفتك بطرائف والثوب جعلت في طرفه عاما ومنه المطرف والبلد كثرت طريقته وهو النصى.(@)(@@) ع - و"طرفت" الناقة طرفا رعت أطراف المرعى والرجل لم يثبت على امرأة ولا صديق1 والرجل أيضا فهو طرف نقيض القعدد و"طرف" ضد تلد.(@)(@@) ق - و"طردت" الشيء طردا وطردا سقته والمولود أخاه ولد بعده والرجل توليت إبعاده بنفسك والريح السحاب والحصى والأرض طريدا والسراب كذلك و"أطردت" الرجل جعلته طريدا.(@)(@@) ع - و"طرد"2 الماء طردا خاضته الدواب وقال ابن السكيت "طردته" نفيته و"أطردته" صيرته طريدا.(@)(@@) ق - و"طلب" الشيء طلبا و"أطلب" الماء والكلأ بعدا والرجل أحوجته إلى الطلب وأيضا اسعفت طلبته وهو من. PageV02P292(@)(@@) الأضداد.(@)(@@) طحر: و"طحرت" الشيء طحرا رميته والعين قذاها كذلك والرجل طحرا وطحارا.(@)(@@) ق -1 وطحيرا مثل الزحير و"أطحر" الحجام الختان أيضا إستأصله. 
ms226	(@)(@@) و"ضحر" الحجام الختان استأصله.(@)(@@) طعم: و"طعمت" المأكول طعاما أكلته وطعما ذقته و"أطعم" المأكول اوجدك مذاقه والشجرة حمل الثمرة و"أطعم" الرجل كان مرزوقا في الصيد و"أطعمت" القارى فتحت عليه عند تلعثمه.(@)(@@) طنب: ع - و"طنب" الفرس طنبا و"طنب"1 طال متنه و"طنب" الرمح إعوج و"طنب"1 بالمكان أقام.(@)(@@) ق -2 و"أطنب" الرجل في الكلام بالغ فيه بمدح أو ذم.(@)(@@) ع -2 والإبل اتبع بعضها بعضا في السير والريح إشتدت في غباره.(@)(@@) طمح: ق - و"طمح" الشيء والبصر طموحا وطماحا ارتفعا. PageV02P293(@)(@@) و"طمحت" به رفعته والمرأة فرت عن زوجها إلى أهلها.(@)(@@) ع - وأيضا أبعد في الطلب.(@)(@@) طمس: ق - و"طمس" الشيء طموسا درس والقمر والنجم والبصر ذهب ضوءها والقلب فسد والشيء بعد1 و"طمست" الشيء طمسا أهلكته.(@)(@@) ع - وأيضا محوته وبعينه نظر نظرا بعيدا.(@)(@@) وطسم: ق - وطسم الشيء طسوما درس و"طسمته" أنا و"طرح" الشيء طرحا وبه2 ألقاه وببصره نظر به بعيدا والبلدة طروحا بعدت فهي طروح.(@)(@@) طحن: و"طحن" الطعام وغيره طحنا والحرب القوم أهلكتهم.(@)(@@) ع - و"طحنت" الرحى والافعى ترحت واستدارت.(@)(@@) طفح: ق - و"طفح" النهر والسكران طفحا امتلأ والريح الشيء في الهواء رفعته والقدر بزبدها رمت به والشيء ذهب واتسع.(@)(@@) ع - وقبح الله أما طفحت به أي ولدته والشجر طلع ثمره والشيء على وجه الماء طف و"طفح" الشيء طفحا يبس2. PageV02P294(@)(@@) ق - و"طحم" الشيء طحما دفعه ومنه طحمة السيل.(@)(@@) ع - و"طحم" بأنفه تكبر وبالخاء أيضا كذلك و"طمخ" أيضا مقلوب1 و"طخم" طخما إسود.(@)(@@) ق - و"طلخ" الشيء طلخا لطخه.(@)(@@) ع - و"أطلخ" دمع عينيه تفرق.(@)(@@) ق - و"طرس" الكتاب طرسا كتبه والاسم الطرس.(@)(@@) و"طسل" السبراب طسلا إضطرب.(@)(@@) و"طمثت" المرأة و"طمثت" لغتان طمثا حاضت و"طمثها" الرجل إفتضها وأيضا جامعها.(@)(@@) ع - والبعير عقلته.(@)(@@) ق - و"طفر" طفورا و"طمر" طمورا وثب واكثر ذلك أن يكون وثوبه من فوق إلى اسفل.(@)(@@) ع - و"طمر" أيضا سفل وأيضا علا ضد.(@)(@@) ق - و"طمر" نفسه طمرا أخفاها والميت دفنه والشيء. PageV02P295(@)(@@) ستره والخراج إنتفخ.(@)(@@) ع - والشيء ملأته ومنه المطمورة.(@)(@@) طبل: ق - و"طبل" طبولا صار ذا وجه وأيضا ذا وجهين.(@)(@@) ع - وأيضا ضرب الطبل.(@)(@@) طمل: ق 
ms227	 - و"طمل" طمولا لم يبال ما صنع والإبل سارت سيرا عنيفا وسائقها طملا عنف بها.(@)(@@) ع - و"الخبزة" وسعتها و"طمل" الماء طملا صار فيه طين رقيق و"طملت" الحصير طملا مثل رملته وأيضا لطخه بالدم وبالدهن أيضا و"أطمل" ما في الحوض أزال ما فيه.(@)(@@) طنز: ق - و"طنز" بفلان طنزا و"طنزا"1 سخر منه.(@)(@@) طبخ: و"طبخ" الطعام طبخا.(@)(@@) طمخ, طخم: ع -2 و"طمخ"3 بأنفه مثل شمخ و"طخم" أيضا كذلك و"طخم" طخما اسود.(@)(@@) طفش: ع - و"طفش" المرأة طفشا نكحها.(@)(@@) طفس: ق - و"طفس" طفوسا مات. PageV02P296(@)(@@) ع -1 و"طفس"2 طفاسة وطفسا كذلك.(@)(@@) ق - و"طفس" و"طفس" قذر.(@)(@@) طلح: ق -3 و"طلح" طلاحا ضد صلح والإبل أكلت الطلح والدابة" هزلتها بالاتعاب و"طلح" طلاحة وطلحا كل وأعيا والابل مرضت عن أكل الطلح.(@)(@@) ع - و"طلح" الرجل تنعم ومنه أشتق طلحة وأيضا اعيا.(@)(@@) طلف: و"طلف" الدم طلفا ذهب هدرا واطلف أعطى والطلف العطاء.(@)(@@) طحل: ق - و"طحله" طحلا أصاب طحاله و"طحل" بعلة فيه و"طحل" أيضا طحلا وطحولا و"طحل" الماء طحلا تغير والذئب طحلة أشربت غيرته سوادا كلون الرماد.(@)(@@) طبن: و"طبن" للأمر طبنا.(@)(@@) ع -3 وطأبانة وطبانية وطبونة.(@)(@@) ق -3 و"طبن" طبنا فطن و"طبن" النار دفنها. PageV02P297(@)(@@) لكيلا تطفأ طبنا والطابون الموضع الذي تدفن فيه النار و"طبن" طبانة أدق النظر في الأمور ويقال الطبانة في الشر والتبانة في الخير.(@)(@@) طهف: ع - و"طبن" بالشيء و"طبن" طبنا وطبنا لزق به و"يقال "أطهف" الصليان إذا نبت نباتا حسنا والطهف من الجنبة.(@)(@@) طنف: ق - و"طنفه" طنفا إتهمه.(@)(@@) ع - وحائطه جعل له إفريزا.(@)(@@) ق -1 و"طنف" طنفا صار متهما.(@)(@@) ع -1 وأيضا دنا وأيضا قل أكله.(@)(@@) طبع: ق - و"طبع" الكتاب والسكين والسيف طبعا ختم والله تعالى الخلق خلقهم وعلى قلوبهم أقلها فلا تعي خيرا.(@)(@@) ع - والسيف والدرهم والجرة عملتها و"طبعت" الدلو طبعا و"طبعتها" ملأتها.(@)(@@) ق - و"طبع" طبعا علاه الدنس في جسم أو خلق.(@)(@@) ع - والسيف علاه الصدأ والرجل كسل.(@)(@@) طعن: ق - و"طعن" بالرمح طعنا. PageV02P298(@)(@@) ع - وفي السن كذلك.(@)(@@) ق - وفي الأرض والليل سار فيهما وفي الأمر والرجل طعنانا وقع فيه و"طعن" 
ms228	 الانسان أصابه الطاعون.(@)(@@) طهر: و"طهر" الرجل.(@)(@@) ع - و"طهر".(@)(@@) ق - طهرا وطهارة فهو طاهر مثل ما كث أي نقى من الذنوب و"طهرت" المرأة و"طهرت" طهرا مضى حيضها وطهارة لم تقارف الذنوب.(@)(@@) ع - وقوله تعالى: {ماء طهورا} أي يتطهر به كما يقال للماء وطوء لانه يتوضأ به وكل طهور طاهر وليس كل طاهر طهورا والفقهاء يحتجون بهذا في أن ماء البحر طاهر مطهر وكذلك قوله "ماء طهورا" وليس في هذا كله حجة انه يطهر ولكن في حجة أنه طاهر في نفسه وانما الحجة في انه مطهر قوله تعالى: {ليطهركم به} .(@)(@@) طلس: ق - و"طلس" الذئب طلسة.(@)(@@) ع - و"طلس" طلسا.(@)(@@) PageV02P299(@)(@@) ق - تساقط شعره وخبث وأيضا صار لونه غبرة في سواد و"طلس" الثوب طلسا أخلق.(@)(@@) ع - و"طلست" الكتاب طلسا محوته.(@)(@@) طزع: ق - و"طزع" طزعا ذهبت غيرته.(@)(@@) طرب: و"طرب" طربا خف لفرح أو ح. والإبل للحداء كذلك.(@)(@@) طفق: و"طفق" يفعل كذا طفوقا أدام1 فعله ليلا ونهارا.(@)(@@) ع - و"طفق" أيضا لغة والحب ثبت ولزم.(@)(@@) طرش: ق - و"طرش" طرشا ثقل سمعه.(@)(@@) طهل: ع - و"طهل" الماء طهلا أجن و"طهل" أيضا طهلا.(@)(@@) طنح: و"طنحت" الإبل و"طنخت"2 بالخاء أيضا بشمت وقال الأصمعي "طنحت" سمنت و"طنخت" بشمت.(@)(@@) طرم: و"طرم" الرجل طرما وطرامة علت أسنانه خضرة. PageV02P300(@)(@@) و"طرمت" النحل طرما ملأت نخاريب1 الشهد عسلا ومن أسماء العسل الطرم والطرم والطريم.(@)(@@) ق -2 و"أطرمت" الأسنان علتها الطرامة وهي خضرة فيها.(@)(@@) ع - والحب تغير ماؤه2.(@)(@@) طبق: ق - و"أطبقت" الشيء جعلت عليه طبقة والرحى السفلى بالعليا سويتها عليها.(@)(@@) ع -3 أطبقتها عليها وسويتها.(@)(@@) ق -2 والقوم على الأمر أجمعوا عليه وألليل أظلم.(@)(@@) ع - والحمى دامت و"طبقت" يد البعير والإنسان طبقا لصقت بجنبه.(@)(@@) طعج: و"طعج" المرأة طعجا نكحها و"طفشها" طفشا كذلك.(@)(@@) طحث: و"طحثه" بكفه طحثا ضربه.(@)(@@) طسع: و"طسع" الرجل طسعا قلت غيرته.(@)(@@) طحز: و"طحز" "كذب"2 والمرأة طحزا نكحها. PageV02P301(@)(@@) طحس: و"طحسها" طحسا.(@)(@@) طسع: و"طسعها" طسعا جامعها و"طعسها" طعسا كذلك.(@)(@@) طرط: و"طرط" الرجل طرطا حمق وأيضا خف شعر حاجبيه فهو أطرط وقيل أضرط بالضاد.(@)(@@) طثر: و"طثر" اللبن طثرا وطثورا خثر 
ms229	 والماء غلظ والعيش طثرة إتسع.(@)(@@) طخش: و"طخشت" عينه طخشا وطخشا أظلمت.(@)(@@) طله: و"طله" طلها ذهب في البلاد و"أطلهت" الأرض في أول نباتها.(@)(@@) طبج: و"طبج" طبجا حمق و"طبج" طبجا ضرب على شيء أجوف.(@)(@@) طمع: و"طمع" طمعا وطماعة وطماعية وتقول في التعجب "طمع" الرجل فلان أي ما أطعمه لأن صورة التعجب ثلاث ما أحسن زيدا وأسمع به وكبرت كلمة وقد شذ عنها نعم وبئس.(@)(@@) طلم: و"طلمت" الخبز طلما نفضت عنها التراب.(@)(@@) طغر: و"طغرت المرأة حلق الصبي رفعته"1. PageV02P302(@)(@@)(@@)(@@) | باب الثنائي المضاعف(@)(@@) طشش: "طشت" السماء طشا و"أطشت" أمطرت دون الوابل.(@)(@@) ع - و"تطشى" تطشيا تمايل1 من المرض وكذلك "تطشأ" تطشأ بالهمز.(@)(@@) طلل: ق - و"طل" الدم.(@)(@@) ع -2 يطل طلا.(@)(@@) ق -2 و"طل" و"طله" الحاكم و"أطله" و"أطل" أهدره فهدر وبطل.(@)(@@) ع - و"طل" دمه يطل لغة.(@)(@@) ق - و"طلت" السماء الأرض طلة وطلا أمطرتها لين المطر و"طلت" الأرض أيضا.(@)(@@) ع - أمطرها الطل و"طللته" طلا مطلته.(@)(@@) ق - و"أطللت" أشرفت وعلى الشيء كذلك.(@)(@@) ع - والشي دنا.(@)(@@) طفف: ق - و"طف" الشئ طفا و"أطف" إرتفع ومنه طفاف المكيال ما علاه وأيضا سنح يقال خذما طف لك. PageV02P303(@)(@@) وأطف.(@)(@@) ع - و"طف" له بحجر و"أطف" أهوى له به و"طففت" الشيء برجلى طفا دفعتهو"طف" الرجل الحائط علاه وقوائما البعير شدهاو"أطففت" الشيء أدنيته.(@)(@@) ق - و"طن" الشيء طنينا وصت.(@)(@@) ع -1 وأيضا مات طنا وطننا.(@)(@@) ق -1 والذباب في مرحه2.(@)(@@) ع -1 طنينا.(@)(@@) ق -1 و"أطننت" ذراعه بالسيف أسرعت قطعها فضلت أي طارت.(@)(@@) و"طر" الشارب طرورا نبت والأرض أنبتت واليد طارت عند القطع و"طررتها" أناء والحمار وبره ألقاه والإبل طردتها والقوم بالسيف كذلك والرمح وغيره أحددته.(@)(@@) ع - وجلوته.(@)(@@) ق - والإنسان1 طره.(@)(@@) ع -1 طرة.(@)(@@) ق -1 حسنت هيأته. PageV02P304(@)(@@) ع - والرجل لطمته والشيء أختلسته وأيضا أغريته والشيء شققته والحوض طينته.(@)(@@) ق - و"أطر" الرجل اشتد غضبه وأيضا مشى في أطرار الوادي أي جوانبه.(@)(@@) ع - وأيضا أدل وأيضا ساق وضربه فاطر رأسه أي قطعه و"طر" الرأس أي انقطع ورمى أي أنفذ و"طررت" القوم مررت بهم جميعا وأيضا أعزى ومثل من أمثالهم 
ms230	 أطى فانك ناعلة يروى بالطاء والظاء فمن رواه بالطاء قال خذى أطرار الوادي أي نواحيه ومن رواه بالظاء أراد خذى ظرر الطريق والظرر والاظرة الأعلام التي يهتدي بها.(@)(@@) طمم: ق - وطم البحر والشيء يطم طموما علا والإناء ملأته والرجل في سيره مضى وفي الأرض طميما ذهب والشعر طما جزرته.(@)(@@) ع - وأيضا وفرته ضد والفرس يطم طميما جرى جريا سهلا والشعر عقصته.(@)(@@) ق -1 والشيء بالتراب ضممته.(@)(@@) ع -1 و"أطم" الشعر حان له أن يطم أي يجز. PageV02P305(@)(@@) طببت: ق - و"طببتك" طبا عالجتك.(@)(@@) ع - والسقاء جعلت عليه الطبابة وهي الجلدة التي يغطى بها الخرز.(@)(@@) ق - و"طببت" بالأمر صرت1 به طبا أي حاذقا و"طب" الإنسان طبا سحر.(@)(@@) طحح: و"طح" الشيء طحا سحجه بعقبه.(@)(@@) و"طس" الشيء تناوله بأطراف أصابعه.(@)(@@) طسس: ع - و"طسس" في البلاد ذهب.(@)(@@) طخخ: ق - و"طخ" طخا شرس في معاملته.(@)(@@) ع - والشيء ألقاه من يده فابعد والمرأة نكحها.(@)(@@) طثث: و"طث" الشيء طثا أزاله عن موضعه. PageV02P306(@)(@@)(@@)(@@) | باب المهموز(@)(@@) طاء: "طاء" الرجل طوءا تباعد.(@)(@@) طرأ: ق - و"طرأ" على القوم طرو أقدم.(@)(@@) ع - و"طرا" طروا وطروا بلا همز كذلك.(@)(@@) ق - و"طرئ" الشيء طراءة صار طريا.(@)(@@) PageV02P306(@)(@@) ع - و"أطرأت" الرجل مدحته و"أطريته" أيضا بلا همز و"أطريت" العسل أعقدته و"طرى" اللحم و"طرو" بلا همز طراوة وطراء وطراة وطراءة.(@)(@@) طنأ: ق - و"طنأ" بالفاجرة طنوأ فجر بها و"طنى" البعير طنى لصقت رئته بجنبه.(@)(@@) ع - و"طنئ" طنأ كذلك وأطنأ1 الرجل أتى بريبة وحية لا تطنى أي لا يعيش صاحبها يهمز ولا يهمز.(@)(@@) طسأ: "وطسئ" اللبن "طسأ"2 شربه حتى يخثره والرجل عرض له ثقل من أكل الدسم.(@)(@@) طفأ: ق - و"طفئت" النار طفوا ماتت.(@)(@@) ع - و"أطفأتا" السهم إذا واريته في الصيد.(@)(@@) ق - و"طفا" الشيء على الماء طفوا وطفو أعلاه والثور الوحشي على الرملة كذلك والماء على الأرض ومنه الطوفان وفي العدو أسرع.(@)(@@) طثأ: ع - و"طثأ" طثأ ألقى ما في جوفه. PageV02P307(@)(@@)(@@)(@@) | باب المعتل(@)(@@) طول: "طال" عليه الليل طولا و"أطال".(@)(@@) "طلت" الرجل طولا وطولا غلته فيهما والطول الفضل و"أطالت" المرأة ولدت ولدا طويلا و"أطولت" الشيء 
ms231	 لغة في "أطلته" جعلته طويلا.(@)(@@) ع - و"طال" الشيء إمتد و"طلت" أصله طولت بالضم ولا يجوز أن تقول منه طلته لأن فعلت لا يتعدى فإن أردت أن تعديه قلت طولته وأطلته فإما طاولني فطلته فمعاه كنت أطول منه من الطول والطول جميعا.(@)(@@) ق - و"طاف" بالشيء طوفا وطوافا وطوفانا1 و"أطاف" استدار حوله وبالمرأة ألم بها كذلك.(@)(@@) وطاف بالبلاد طوفانا و"طاف" الصبي طوفا أحدث بعد الرضاع.(@)(@@) ع - و"إطاف" إطيافا لغة وفي البلاد طوفانا سار.(@)(@@) ق -1 والخيال طيفا طرق.(@)(@@) ع - و"أطاف" لغة و"أطاف". PageV02P308(@)(@@) ق - وطاف الشيطان بالإنسان عرض له و"أطفت" بالرجل ألممت به.(@)(@@) طوع: ع -1 و"طاع" لك طوعا وطيعا و"أطاع" إنقاد والنبات أمكن من رعيه كذلك والشجر أمكن ثمره كذلك ويقال في "أطاع" اتبع الأمر ولم يخالفه وأمره فأطاع لا غير.(@)(@@) ع - و"طاع" المربع و"أطاع" اتسع.(@)(@@) طور: ق - و"طار" فلان بفلان طور احام والموضع قربه ولا أطور به أي لا أقربه و"طار" الطائر طيرانا والسمن في الدوأب علا والرجل طير كالزلة والهفوة والشيء عن الشيء سقط والدابة أسرعت والشيء طال والشيء في الهواء ارتفع "وطرت" بالشيء فرحا استخفك السرور به و"أطير" الرجل والفرس حدت انفسهما وكان بعض الصالحين مطارا وفي الحديث "إتقوا طيرات الشباب" أي آفاته و"أطير" أيضا فزع.(@)(@@) طيب: و"طاب" الشيء طيبا حسن وحلا وأيضا حل وعن الشيء نفسا تركته و"أطاب" الإنسان ولد ولدا طيبا أو كسب ما لا مثله وتكلم بكلام طيب. PageV02P309(@)(@@) ع - و"أطاب" و"استطاب" إذا استنجى.(@)(@@) طلو: ق - و"طلوت" الظبي و"طليته" ربطته و"طليت" الشيء طليا دهنته مما يستره.(@)(@@) ع - والشيء حبسته والبقل ظهر على وجه الأرض.(@)(@@) ق - و"أطلت" الوحشية كان معها طلا وهو ولدها والرجل طالت طلاته وطليته وهي عنقه و"طليت" الأسنان طلى علاها القلح والفم جف ريقه.(@)(@@) طخى: ق - و"طخى" طخيا حمق فهو طخية و"أطخت" السماء علاها الطخاء وهو السحاب والظلمة.(@)(@@) ع -1 و"طخا" الليل أظلم.(@)(@@) ع -2 فهو طاخ و"طخى" أيضا.(@)(@@) طيخ: ق - و"طاخ" طيخا تلطخ بقبيح من قول أو فعل و"طاخه" غيره.(@)(@@) ع -1 والشيء أفسده 
ms232	 وأيضا جهل وطاش وأيضا تكبرا.(@)(@@) ع -2 وأيضا إنهمك في الباطل. PageV02P310(@)(@@) طهو: ق - و"طها" اللحم يطهوه ويطهاه طهوا وطهيا أنضجه بشى أو طبخ وفي الأرض طهيا وطهيا ذهب.(@)(@@) ع - والإبل نفشت بالليل والرجل طهيا أذنب.(@)(@@) ق -1 و"طهى" اللحم أيضا طهى و"طها" الليل أظلم.(@)(@@) طوط: ق -2 و"أطهت" السماء الطهاء وهو كالطخاء و"طاط" افحل طوطا هاج.(@)(@@) ع - وأيضا يطيط ويطاط طيوطا هدر والرجل طال وأيضا إشتد خصومته.(@)(@@) طوح: ق -2 وطاح طوحا وطيحا هلك وأيضا سقط منبسطا وأيضا اضطرب عقله.(@)(@@) ع - وأيضا تاه.(@)(@@) طبو: ق - وطبوت الشيء وطبيته طبوا وطبيا إستملته والرجل عن رأيه صرفته.(@)(@@) ع - وأيضا دعوته وأطبيت الرجل وأطبيته صادقته3 ثم قتلته. PageV02P311(@)(@@) طمو: ق - و"طما" الشيء طموا وطميا إرتفع وفي الأرض طميا ذهب مسرعا.(@)(@@) طحو: و"طحا" الله تعالى الأرض طحوا وطحيا بسطها وقلبك وهمك بك ذهبا.(@)(@@) ع - والشيء بعد والقمر أشرف.(@)(@@) ق - والشيء دفعته والقوم تدافعوا والقبيلة كثرت.(@)(@@) ع - وضربه ضربة طحا منها أي امتد و"طحى" طحيا إضطجع.(@)(@@) طغو: ق - و"طغا" و"طغى" طغوا طغيانا.(@)(@@) ع - وطغوانا "وطغى"1.(@)(@@) ق -2 أسرف في الظلم والمعاصي و"طغت" البقرة الوحشية طغيا صاحت والثور مثله والطغاء الصوت.(@)(@@) ع - والبحر هاجت أمواجه والدم ينبع3 والسيل جاء بماء كثير.(@)(@@) طيش: ق - و"طاش" طيشا خف والسهم جاوز الهدف و"طان" الكتاب طينا ختمه بالطين والحائط طين: حمله عليه. PageV02P312(@)(@@) وعلى الشيء كذلك.(@)(@@) ع - والأرض كثر طينها.(@)(@@) ق -1 و"طانه" الله تعالى طينة حسنه على الخير.(@)(@@) طيم: و"طامه" طيمة جبله.(@)(@@) طوى: ق - و"طوى" الكتاب والثوب طيا والخبر كتمه والبلاد قطعها والله تعالى البعد قربه وفلان طشحا مضى لوجهه ونصيحته عنك قبضها والرجل نهاره جائعا أقام فيه والبشر بالحجارة بناها و"طوى" طوى جاع.(@)(@@) ع - وأيضا ضمر بطنه و"طوى" طيا تعمد ذلك.(@)(@@) طوق: ق - و"أطاق" الشيء بلغته طاقته أي قوته.(@)(@@) ع - و"طاق" يطوق طوقا وهي الطاقة.(@)(@@) طرى: ق - و"أطريت"2 الشيء مدحته.(@)(@@) ع - و"أطرأته" بالهمز كذلك و"أطريت" العسل أعقدته.(@)(@@) طنى: و"أطنيت" بعت الأشجار و"أطنيتها" مشددا إشتريها و"أطنى" فلان نخل فلان إشترى ثمرها 
ms233	 وأيضا باع عليه ثمر.(@)(@@) نخله.(@)(@@) طسى: و"طسا" طسيا شرب اللبن حتى يخثره وأيضا عرض ثقل من أكل الدسم.(@)(@@) طوس: و"طاس" الشيء طوسا وطئه. PageV02P313(@)(@@)(@@)(@@) | باب الثنائي المكرر(@)(@@) طثط: "طثطت" الشيء طرحته من يدي قذفا مثل الكرة وشبهها.(@)(@@) طحطح: و"طحطح" الشيء أهلكه وأتلفه.(@)(@@) طرطر: و"طرطر" الرجل طرطرة شبه الطرمذة وهي أيضا كثرة الكلام.(@)(@@) طخطخ: و"طخطخ" بخاء معجمة وهي حكاية قول الضاحك.(@)(@@) طخ طخ1 والليل بصره منعه من النظر و"الطخطخة" الظلمة.(@)(@@) طقطق: "طقطقة" حكاية تساقط الحجارة بعضها على بعض.(@)(@@) طنطن: و"الطنطنة" حكاية صوت الطنبور وما أشبهه وكثر حتى قالوا "طنطن" البعوض والذباب إذا سمعت لها طنينا.(@)(@@) طبطب: و"الطبطبة" حكاية تلاطم السيل.(@)(@@) طأطأ: و"طأطأ" رأسه حطه.(@)(@@) طمطم: و"الطمطمة" سرعة المشي والعمل وهي الضحك أيضا.(@)(@@) طعطع: والطعطعة حكاية صوت اللسان في الغاز الأعلى. PageV02P314(@)(@@)(@@)(@@) | باب الرباعي الصحيح(@)(@@) طرفش: "الطرفشة" خفض البصر.(@)(@@) طرمس: و"الطرمسة" الانقباض والنكوص.(@)(@@) طربخ: و"الطربخة" الخفة والنزق وكذلك الطرخبة.(@)(@@) طعسف: ومر "يطعسف" في الأرض إذا مر يخبطها والطعسبة عدو في تعسف1 وكذلك الطعزبة.(@)(@@) طعزب: والطعزبة الهزء أيضا2.(@)(@@) طلحن: و"طلحنت" الرجل لطخته بأمر يكرهه وبالخاء المعجمة أيضا.(@)(@@) طرثم: و"طرثم" أطرق من تكبرا وغضب وكذلك "ثرطم".(@)(@@) طرسع: و"طرسع" عدا عدوا شديدا.(@)(@@) طرمس: و"طرمس" الرجل كره الشيء والكتاب محوته و"طلمس" كذلك.(@)(@@) طرمش: "طرمش" الليل بشين معجمة و"طرشم" أظلم. PageV02P315(@)(@@) طلسم: و"طلسم" كره وجهه وكذلك "بلسم" وأيضا اطلق.(@)(@@) طرطب: و"الطرطبة" اضطراب الماء في الجوف والقربة وأيضا دعاء الغنم بالشفتين وأيضا زجرها ضد والرجل غضب وأيضا الفرار.(@)(@@) طرشح: و"الطرشحة" الاسترخاء.(@)(@@) طربل: و"طربل" سحب ذيله وتمطى في مشيته.(@)(@@) طرغش: و"طرغش" الليل و"غطرش" أظلم.(@)(@@) طنفش: و"طنفش" عينه صغرها وأيضا حمج نظره.(@)(@@) طنثر: و"طنثر" أكل الدسم.(@)(@@) طمحر, طحمر: و"طمحر" وثب و"طحمر" السقاء ملأه و"طحرمه" أيضا طمحر كذلك والقوس أوترها كذلك.(@)(@@) طرشم: و"طرشم"1 أطلق.(@)(@@) طمرس: "وطمرس" انقبض.(@)(@@) طحرب: و"طحرب" الرجل فسا.(@)(@@) طخخ: و"طخوخ" بالضأن دعابها.(@)(@@) طنفس: و"طنفس" الرجل مات.(@)(@@) طلبق: وقالوا "طلبق" و"دمعز" إذا أكثر من قوله "أطال.(@)(@@) الله بقاءك وأدام عزك". PageV02P316(@)(@@)(@@)(@@) | باب الخماسي والسداسي(@)(@@) إطلخم: "إطلخم" الرجل و"اطرخم" و"اطرهم" و"اطرغم" تكبر والمطرهم الشاب 
ms234	 المعتدل و"المطلخم" الأسود.(@)(@@) اطرغش: و"اطرغش" تماثل من مرض.(@)(@@) أطمأن: و"أطمأن" الرجل سكن و" اطبأن كذلك.(@)(@@) اطلنفى: و"اطلنفى" و"اطلنفأ" لصق بالأرض.(@)(@@) اطرم: وقد "اطرمت" أسنانه علتها الطرامة.(@)(@@) اطمحر و"اطمحر" و"اطمخر" بالخاء والحاء1. PageV02P317(@)(@@)(@@)(@@) | الظاء على فعل وأفعل باتفاق معنى وغيرة من الثلاثي الصحيح(@)(@@)(@@)(@@) | مدخل(@)(@@) ...(@)(@@) الظاء على فعل وأفعل بمعنى واحد وغيره من الثلاثي الصحيح.(@)(@@) ظلف: "ظلفت" أثرى ظلفا و"أظلفته" مشيت في صلابة الأرض لئلا يقص والأرنب وغيرها كذلك وظلف نفسه وغيره عما لا يحسن ظلفا منع وكل ذي ظلف أصاب ظلفه "وظلفت" الأرض ظلفا غلظت فلم يسبن فيها أثر.(@)(@@) ع - و"نفسي" عن كذا كفت والمرأة عزت.(@)(@@) PageV02P317(@)(@@) نفسها والدم ذهب هدرا.(@)(@@) ظلم: ق - و"ظلم" الليل ظلاما لغة و"أظلم" المعروف اشتد ظلامه.(@)(@@) ع - وقال الفراء "ظلم" الليل وأظلم بمعنى.(@)(@@) ق - و"ظلم" العبد بالشرك ربه ظلما تعالى عن ذلك علوا كبيرا والاسم الظلم والرجل نقصته واللبن شربته قبل إدراكه.(@)(@@) ع - والشيء وضعته غير موضعه والقوم سقيتهم اللبن قبل إدراكه.(@)(@@) ق - والمطر أرض بني فلان أصابها في غير إبانه والأرض حفرت فيها في غير موضع حفر والبعير نحرته من غير داء والوادي بلغ الماء منه موضعا لم يكن يبلغه.(@)(@@) ق - والطريق عدلت عنه يمينا أو شمالا و"أظلمنا" صرنا في الظلام و"تظلم" الرجل فهو متظلم إذا كان ظالما ومظلوما ضد.(@)(@@) ظهر: و"ظهرت" على العدو غلبته وعلى الأمر والحائط.(@)(@@) PageV02P318(@)(@@) والسقف ظهورا علوته والشيء كذلك بان والإبل كل يوم وردت نصف النهار فهي ظاهرة و"ظهر" الشيء عني فاتني وذهب عني.(@)(@@) ع - وأيضا تبين وفلان بحاجتي استخف بها وجعلها منه بظهر و"ظهر" الإنسان ظهرا إشتكى ظهره.(@)(@@) ق - و"ظهرت" الدابة "ظهارة"1 قويت و"أظهرنا" صرنا في الظهيرة وهي الحر وأتينا فيها وصلاة الظهر منه.(@)(@@) ع - والقوم كان لهم ظهر وبفلان أعلنت به و"أظهرت" الشيء جعلته خلف ظهري وكذا "ظهرت" به و"أظهرت به"2.(@)(@@) ق - و"ظرف" الغلام والجارية ظرفا وظرافة برعا وأدبا صفة لهما لا للشيوخ وأ "ظرف" الوالد ولد ولدا ظريفا.(@)(@@) ع - الرجل كثرت اوعيته و"ظارفني" فظرفته أي كنت أظرف منه.(@)(@@) ق - و"ظلعت" 
ms235	 الأرض باهلها ظلعا ضاقت والدابة إتقى الأرض بإحدى يديه والرجل إتهمه. PageV02P319(@)(@@) ع - الكلبة إشتهت الفحل "وارق على ظلعك" أي أربع على نفسك ولا تحمل علينا اكثر مما نطيق و"ظلع" أيضا إتسع وأيضا قدر وأيضا إستغنى و"تظالعت" الكلاب و"تعاظلت" تسافدت و"ظلعت" الدابة ظلعا عن الأصمعي وقال أبو زيد "ظلع" ظلعا غمز وأنشد1.(@)(@@) "وكنت كذات الظلع لما تحاملت".(@)(@@) "وظلع" الرجل مال وأيضا أذنب وحكيت بالضاد أيضا.(@)(@@) ظعن: و"ظعن" عن المكان ظعنا وظعنا رحل وزال.(@)(@@) ظفر: و"ظفره" ظفرا أصاب ظفره و"ظفر" ظفرا طالت أظفاره والعين ظفرة علتها جليدة بيضاء وبالشيء ظفرا غلب عليه و"ظفر" الإنسان أصابت عينه الظفرة.(@)(@@) ع -2 وما ظفرتك عيني مذزمان أي ما رأيتك ويقال "ظفرت" به وعليه بمعنى. PageV02P320(@)(@@)(@@)(@@) | باب الثنائي المضاعف(@)(@@) ظلل: "طل" اليوم ظلالة و"أظل" صار ذا ظل" يفعل كذا فعله نهارا و"ظللت" أفعله ظلولا.(@)(@@) ع -1 و"ظلت" و"ظلت".(@)(@@) ق -1 والشيء طال ودام و"أظل" الأمر أشرف والشجرة والحائط سترا بظلهما والقوم صاروا في الظل و"أظلك" فلان حماك وسترك والأمر قرب.(@)(@@) و"ظنننت" الشيء ظنا تيقنته وأيضا شككت فيه من الأضداد و"ظننت" فهو ظنين و"أظنت" فيه2 الناس عرضته لتهمتهم.(@)(@@) و"ظف" البعير ظفا جمع قوائمه بالرباط والرجل طرده.(@)(@@) و"أظرت" الأرض كثر ظراانها وهي حجارتها واجدها ظرر.(@)(@@) ع - و"أظرت". PageV02P321(@)(@@)(@@)(@@) | باب المهموز(@)(@@) ق - و"ظأرت" الناقة ظأرا عطفتها على بوها "فأظأرت".(@)(@@) ع -1 و"ظأرت".(@)(@@) ق -1 و"ظأرت" الشيء3 على الشيء "فأظأر". PageV02P321(@)(@@) و"ظأر" وفي أمثالهم "الطعن يظأر" أي يعطف على الصلح.(@)(@@) ع - و"أظأرت" ظئرا.(@)(@@) ظأم: ق - و"ظأم" الرجل و"ظأبه" ظأما وظأبا تزوج أخت إمرأته و"ظأب" التيس وغيره ظأبا صوت.(@)(@@) ظمأ: و"ظمئى" ظمأ" وظمأ وظماءة عطش و"ظميت" الشفة والرمح ظمى إسودا.(@)(@@) ع -1 بغير همز.(@)(@@) ع -2 والعين دق جفنها والساق قل لحمها والى القاءك اشتقت.(@)(@@) ظأف: و"ظأفه" ظأفا طرده. PageV02P322(@)(@@)(@@)(@@) | باب المعتل(@)(@@) ظاف: و"ظاف" البعير ظوفا قرن بين وظيفيه بالقيد.(@)(@@) ظبى: ع - و"أظبت" الأرض كثر ظباؤها.(@)(@@) PageV02P322(@)(@@)(@@)(@@) | باب الثنائي المكرر(@)(@@) ظبظب: يقال بالرجل "ظبظبة" أي وجع و"ظبظاب" قال الراجز.(@)(@@) "بنيتي ما إن بها ظبظاب".(@)(@@) وقيل الظبظاب 
ms236	 بئر يخرج في العين.(@)(@@) ظأظأ: و"ظأظأ" فلان ظأظأة وهو حكاية كلام الأعلم.(@)(@@) PageV02P322(@)(@@)(@@)(@@) | باب الخماسي والسداسي(@)(@@) إظرورى: "إظرورى" الرجل كاس وحذق فهو مظرور وهو أيضا لمنتفخ البطن وهو أيضا الذي غلب الدسم على قلبه عن أبي زيد ورواه ابن الأعرابي بطاء غير معجمة.(@)(@@) اظطلف: و"اظطلف" الرجل مشى في الحزونة لئلا يتبين أثره.(@)(@@) PageV02P323(@)(@@)(@@)(@@) | العين على فعل وأفعل باتفاق معنى وغيرة من الثلاثي الصحيح(@)(@@)(@@)(@@) | مدخل(@)(@@) ...(@)(@@) العين على فعل وأفعل بمعنى واحد وغيره من الثلاثي الصحيح.(@)(@@) عرض: "عرض" له الخير عرضا و"أعرض" أمكن و"عرض" الشيء عرضا صار عريضا و"عرضت" عليك الكتاب قرأته والشيء أريتكه لأبتياع وغيره والجند نظرت حالهم والقوم على السيف قتلتهم وعلى السوط ضربتهم والماء على الدابة ولعود على الإناء أعرضه والفرس في جريه مر عارضا وفلان من سلعته عارض بها ولفلان عارض نزل به وذات الروح من الحيوان ماتت بلا علة والشيء للشيء جعلته له غرضة والشيء بدأ عرضا في جميعها وفلان لفلان عرضا وعرضا صار له عرضة وفي الأمر كذلك و"عرضت" له الغول عرضا.(@)(@@) PageV02P323(@)(@@) ع -1 و"عرضت" عرضا.(@)(@@) ق -1 تغولته.(@)(@@) ع -1 وما "عرضت" ل وما "عرضت" له عرضا وعرضا لغتان فصيحتان.(@)(@@) ع - و"عرض" فلانا عرضا أتى العروض وهي مكة وما والاها و"عرض" مر والسيف على فخده.(@)(@@) ق - و"عرض" للإنسان جن و"أعرضت" عنك صددت والظبي وغيره أمكنك من عرضه والرجل تمكن من عرض المكارم أي سعتها.(@)(@@) ع - والمكان بدا وتبين و"عرضت" الناقة أصابها كسر أو آفة وله من حقه ثوبا أعطيته مكان حقه و"أعرضت" الشيء جعلته عريضا والشيء أظهرته والعرضان2 خصيتها وفلانة بولدها ولدتهم عراضا و"عرضت" الشيء فأعرض أي أظهرته فظهر وهو من النوادر و"عرض" بعيره عرضا وسمه بسمة تسمى. PageV02P324(@)(@@) العراض على فخذه و"عرض" الكاتب إذا ثبج خطه ولم يبينه1 و"تعرض" الجمل إذا أخذ في سيره يمينا وشمالا لصعوبة الطريق و"أعرض" فلان أي ذهب عرضا وطولا ولك الخير أمكنك و"عرضت" له الشيء أي أظهرته والجارية على البيع وعليه الشيء أي2 أبرزته والبعير على الحوض وهو من المقلوب والجراد سد 
ms237	 الأفق و"عرضت"3 له و"أعرضت" أهديت له و"عارضت" فلانا في البيع "فعرضته" أي غلبته و"عرضت" القربة ملأتها.(@)(@@) عرش: ق - و"عرش" الكرم والبنيان عرشا و"أعرشه" رفعه.(@)(@@) ع - و"عرش" بالمكان عروشا أقام به وبغريمه عرشا لزمه عن ابن الأعرابي والحمار بعانته حمل عليها فاتحا فاه و"عرش" بغريمه أيضا عرشا لزمه.(@)(@@) علم: ق - و"علمت" الشفة علما و"أعلما و"أعلمتها" شققتها و"علمتك" أعلمك علما صرت أعلم منك و"علمت" الشيء وبالشيء علما عرفته وأيضا4 اختبرته وفلانا كريما وجدته. PageV02P325(@)(@@) والشيء من غيره ميزته1.(@)(@@) ع - و"الشفة أعلمها علما شققتها وهي انشقت وقالوا العلم في الأنسان والمعرفة في البهائم والناس وإنما خص الإنسان بالعلم في الأنسان والمعرفة في البهائم والناس وإنما خص الإنسان بالعلم للفرق بينه وبين المعرفة لأن العلم إنما يكون بالاكتساب والمعرفة بالجبلة فالإنسان يعلم ويعرف والبهيمة تعرف ولا تعلم لأن الإنسان يكتسب والبهيمة لا تكتسب وإنما صار الإنسان مثابا معاقبا على اكتسابه واختياره وعلمه ولم يكن للبهيمة ثواب ولا عقاب لأن المعرفة جبلة فيها وليست باكتساب.(@)(@@) ق -2 و"أعلمت" الثوب وغيره جعلت له علما والفارس في الحرب كذلك والأرض كثرت أعلامها جمع علم وهو الجبل.(@)(@@) عذر: و"عذرت" الغلام والجارية عذرا و"أعذرتهما" ختنتهما وأيضا صنعت طعاما للختان واسمه الإعذار والعذيرة كذلك "والرجل من نفسه أتى بما يعذر عليه وأيضا اوجبت له العذر كذلك" وأيضا كثرت ذنوبه وعيوبه وفي الحديث "لا يهلك الناس حتى يعذروا من أنفسهم ويعذروا".(@)(@@) ع - والفرس شددت عليه العذار كذلك وأيضا. PageV02P326(@)(@@) حملت كذلك و"عذرت" في الأمر تعذيرا قصرت و"أعذرت" فيه بالغت وجددت و"اعتذرت" الجارية افتضضتها و"عذره" الله من العذرة "فعذر" و"عذر" عذرا وعذرة هاج به وجع الحلق و"أعذر" به ترك وهو أثر الجرح و"أعذرت" الدار كثرت فيها العذرة وضرب "فأعذر" أي أشرف به على الهلاك.(@)(@@) ق - و"عذرت" الفرس عذرا كويته في موضع العذار وأيضا حملت عليه عذاره.(@)(@@) ع - و"أعذرته" لغة.(@)(@@) ق - و"عذرت" الصبي والرجل عالجتهما من العذرة وهي وجع الحلق و"أعذرت" إليك بالغت في الموعظة والوصية وعند السلطان بلغت العذر.(@)(@@) ق - والفرس جعلت له عذارا 
ms238	 وفي الشيء جددت1.(@)(@@) ع - والرجل أحدث وأيضا صار ذا عذر وكان ابن عباس يقرأ "وجاء المعذرون" وكان يقول لعن الله المعذرين كأن ألامر عنده أن المعذر بالتشديد هو المظهر للعذر اعتلالا من غير حقيقة والمعذر الذي له عذر ومن قرأ المعذرون. PageV02P327(@)(@@) فقد يكون المعذر محقا وغير محق فأما المحق فهو في المعنى المعذر لأن له عذرا ولكن التاء قلبت ذا لا وأدغمت وجعلت حركتها على العين كما قرى "يخصمون" والذي ليس بمحق فهو على جهة المفعل لأنه الممرض والمقصر يعتذر بغير عذر و"عذرته" نصرته "والعذير النصير"1 ومنه "من عذيري" أي من نصيري.(@)(@@) عصف: ق - و"عصفت" الريح عصوفا و"أعصفت"2 إشتدت هبوبها كذلك والدابة أسرعت براكبها كذلك والحرب القوم ذهبت بهم كذلك وبالشيء أهلكته كذلك.(@)(@@) ع - و"عصفت" الزرع جززته قبل أن يدرك عصفا والرجل كسب و"أعصف" الزرع أنبت البقل والفرس مرمرا سريعا والرجل هلك وأيضا جار عن الطريق.(@)(@@) عتم: ق - و"عتم" الليل عتما و"أعتم" أظلم.(@)(@@) ع - وعن الشيء أبطأ كذلك و"القرى كذلك".(@)(@@) ق -2 و"عتمت" عن الشيء عتما وعتوما كففت عنه بعد المضي فيه والضيف والقرى والخبر تأخر وأبطأ. PageV02P328(@)(@@) ع - وأيضا نتف.(@)(@@) ق - و"أعتمنا" صرنا في عتمة الليل.(@)(@@) و"علف"1 الدابة علفا لغة و"أعلفتها.(@)(@@) ع -1 و"أعلف" الطلح خرج علفه وهو ثمره.(@)(@@) عجف: ق - و"عجفت" الدابة و"أعجفتها" و"عجف" نفسه وغيره عن الطعام عجفا وعجوفا منعهما منه وعلى المريض مرضته وعن الرجل حملت جنايته و"عجف" الشيء و"عجف" عجفا هزل.(@)(@@) ع - وكذلك "عجف" و"عجفت" نفسي عن الشيء صبرت عنه.(@)(@@) عكل: ق - و"عكل" الأمر عكلا و"أعكل" أشكل والخيل والإبل عكلا جمعها في سوقه كذلك والبعير عقله كذلك.(@)(@@) ع - والرجل ضربه بالسوط وأيضا بالسيف كذلك وأيضا حزر الشيء كذلك و"عكلت" المسرجة عكلا صار فيها الدردي و"عكل" الرجل في الأمر جد والمتاع نضد. PageV02P329(@)(@@) بعضه على بعض والشيء حبسته وأيضا صرعه والرجل مات والرجل ساقه وأيضا ظن.(@)(@@) و"عوز" الشيء عوزا لم يوجد و"عوز" الرجل.(@)(@@) عوز: ق -1 و"أعوز" افتقر والشيء تعذر كذلك وأعوز لي.(@)(@@) ع -1 تعذر على والدهر 
ms239	 أحوجه.(@)(@@) عظر: ق - و"أعظره" الشراب ثقل عليه وكظه.(@)(@@) ع - و"عظر" الشيء عظرا كرهه.(@)(@@) عصد: و"عصد" العصيدة عصدا و"أعصدها" لواها و"عصد" عنقه عصدا لواه والمرأة جامعها والرجل عصودا مات.(@)(@@) ع - والشيء مال والبلايا دهتهم.(@)(@@) عزد: ق - و"عزد" المرأة عزدا نكحها.(@)(@@) عسد: و"عسدها" عسدا كذلك.(@)(@@) ع -2 والخبل فتله.(@)(@@) عفص: ق - و"عفص" القارورة عفصا و"أعفصها" شد رأسها بألعفاص ويقال "أعفصها" جعل لها عفاصا. PageV02P330(@)(@@) ع -1 والمداد جعلت فيه العفص.(@)(@@) ع -2 و"عفص" الطعام عفصا تقبض.(@)(@@) ق - و"عسرتك" عسرا و"أعسرتك" طلبت الدين3 منك على عسرة و"عسر" الشيء عسرا صار أعسر وعسارة وعسرا وعسرا قل سماحه وضاق خلقه واليوم إشتد والناقة لم تحمل عامها.(@)(@@) ع - والعقاب إبيضت قوادمها والرجل عمل بيساره فأن عمل بيديه جميعا فهو أعسر يسر والعقاب كثر ريشها من الجانب الأيسر.(@)(@@) ق - و"عسرت" الناقة بذنبها عسرا رفعته والرجل بيده رفعها.(@)(@@) ع - والغريم طلبت منه الدين على عسرة والمرأة عسر ولادها و"عسرك" فلان جاء على يسارك و"أعسرت" الناقة شالت بذنبها أيضا.(@)(@@) ق - و"أعسرت" المرأة والناقة نشب ولدها عند الولادة وفي الدعاء "آنثت وأعسرت" والرجل أفتقر. PageV02P331(@)(@@) عمر: و"عمر" الله تعالى بك منزلك عمارة و"أعمرك" و"عمرت"1 ظهرت.(@)(@@) ق - و"عمر" المكان و"عمرته" عمارة و"عمر" الرجل.(@)(@@) ع -2 عمرا وعمرا على غير قياس.(@)(@@) ق - طال عمره2 و"أعمرتك" الشيء جعلته لك عمرك وأسمها العمرى والأرض وجدتها عامرة والإنسان جعلته يعتمر.(@)(@@) عثر: و"عثرت" على الأمر عثرا ولغة "أعثرت" ولغة القرآن "أعثرت" غيري وعثر" عثورا سقط وفي شر وقع والدابة عثارا كذلك وعلى الشيء والقوم عثرا إطلعت.(@)(@@) ع - والرجل كذب.(@)(@@) عند: ق - و"عند" الجرح والعرق عنودا و"أعند" سال "دمه" و"عند" السلطان عنودا تجبر.(@)(@@) ع -2 و"عند" كذلك.(@)(@@) ق -2 و"عندت" الناقة عنودا رعت وحدها فهي عنود. PageV02P332(@)(@@) ع - والبعير جار عن الطريق و"عند" الطعن عندا مال يمنة ويسرة.(@)(@@) ق - و"عند" وعند و"عند جميعا"1 عن الحق عندا وعندا خالفه وهو يعرفه.(@)(@@) ع - و"عند" عن الطريق مال.(@)(@@) ق - و"أعند" في قيئه تابعه.(@)(@@) و"عضبت" القرن وغيره عضبا و"أعضبته كسرته" "فعضبت" عضبا و"عضب" الشيء 
ms240	 عضبا قطعه والقرن كسره بجملته.(@)(@@) ع - والرجل بلسانه تناوله وشتمه ورجل عضاب إذا كان شتاما"1.(@)(@@) ق -1 واللسان عضوبا وعضوبة بلغ وفصح و"عضب" القرن عضبا انكر وأذن الناقة انقطعت.(@)(@@) ع - وأيضا صبر والرجل لم يكن له ناصر والأذن إنشقت و"عضبت" الرجل بلساني شتمته وأيضا استضعفته و"عضب" اللسان عضوبة صار عضبا أي حديدا. PageV02P333(@)(@@) عضه: ق - و"عضه" عضها وعضهة وعضيهة كذب وأيضا سحر.(@)(@@) ع - وأيضا نم.(@)(@@) ق -1 و"أعضه" أيضا.(@)(@@) ع -1 و"عضهت" الرجل عضها و"عضيهة"2 بهته.(@)(@@) ق -1 والبعير عضها أكل العضاه والحية قتلت من ساعتها "بنهشها"1 و"عضه" البعير عضها إشتكى عن أكل العضاه.(@)(@@) ع -1 وأيضا رعى العضاه و"أعضه" الرجل أتى بالبهتان والأرض كثرت فيها العضاه.(@)(@@) ق -1 والقوم أكلت إبلهم العضاه.(@)(@@) عقم: و"عقم" الله رحمها عقما و"أعقمه" و"عقمت" المرأة وعقمت وعقمت.(@)(@@) ع -1 عقما وعقما و"أعقمت" و"أعقمت".(@)(@@) ق -1 و"أعقمت" لم تلد.(@)(@@) ع - وإذا ساء خلقها قيل "عقمت" فهي عقام وعقيم. PageV02P334(@)(@@) ق - و"عقمت" المفاصل عقما يبست واشتدت ومنه يوم عقيم.(@)(@@) و"عشبت" الأرض عشبا.(@)(@@) ع -1 و"عشبت".(@)(@@) و"أعشبت" أنبتت العشب و"عشب" الرجل عشابة وعشوبة هرم فاستخف به فهو عشبة.(@)(@@) ع -1 و"عشب" عشبا كذلك والرجل كان قصيرا دميما.(@)(@@) ق - و"اعشب" القوم والرائد أصابوا عشبا.(@)(@@) ع - والرجل أعطى شاة عشبة أي كبيرة.(@)(@@) ق - و"عبست" الأبل عبسا و"أعبست" تعلق بها مثل وذح الغنم و"عبس" عبوسا جمع وجهه واليوم إشتد و"عبس" عليه الوسخ عبسا يبس.(@)(@@) و"عدمت" الشيء عدما و"أعدمته" وأعدمته "فقدته" وأعدم الرجل افتقر وأعدمته2 أيضا1. PageV02P335(@)(@@) ع - "عدم" يعدم عدامة حمق فهو عديم.(@)(@@) عقب: ق - و"عقبت" من فلان بخير أتيت به من عنده وفلان بعد فلان والشيء بعد الشيء جاء بعده والرجل مكان أبيه حل محله والزوج للمرأة بعد الزوج وفلان فلانا في أهله بغاهم بشر والرجل ضربت عقبه والشيء شددته بالعقب والإبل تحولت من مرعى إلى غيره عقبا في جميعها و"أعقب" الله تعالى بخير أتى به بعد شدة والرجل ركبت عقبة وركب أخرى وأيضا صرت مكانه وخيرا أو شرا بما صنع صنعته 