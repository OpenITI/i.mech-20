ms61	 الليث لا يخلف المخاليبا % % 30(@)(@@) % بقدر عز الفتى رزيته % % من وتر الدهر بات مرعوبا % % PageV01P198 31(@)(@@) % واللؤلؤ الرطب في قلائده % ما كان لولا الجلال مثقوبا % % 32(@)(@@) % إن كنت مستسقيا لمنجعة % % مجلجلا بالقطار اسكوبا % % 33(@)(@@) % فاستسق مستغنيا به أبدا % من قطر جدوى أبيه شؤبوبا % % 34(@)(@@) % و انتفاع النبات صوحه % % هيف الردى أن يكون مهضوبا % % 35(@)(@@) % فاسلم مليك الملوك ما بقي ال % % هر مبقى لنا وموهوبا % % 36(@)(@@) % لا خاف أبناؤك الذين بقوا % % حدا من النائبات مذروبا % % 37(@)(@@) % ولا ترى السوء فيهم أبدا % حتى يكونوا الدوالف الشيبا % % 38(@)(@@) % لا روعت سرحك المنون ولا % % أصبح سرب حميت منهوبا % % 39(@)(@@) % لا يجد الدهر مسلكا أبدا % ولا طريقا إليك ملحوبا % % 40(@)(@@) % ولا راينا الخطوب داخلة % % رواق مجد عليك مضروبا % % PageV01P199 البحر : متقارب تام 1(@)(@@) % كذا يهجم القدر الغالب % % و لا يمنع الباب والحاجب % % 2(@)(@@) % تغلغل يصدع شمل العلى % % كما ذعذع الابل الخارب % % 3(@)(@@) % وقد كان سد ثنايا العدو % فمن اين اوضع ذا الراكب % % 4(@)(@@) % و هابت جوانبه النائبات % % زمانا ، وقد يقدم الهائب % 5(@)(@@) % طواك إلى غيرك المعتفي % % و جاوز ابوابك الراغب % % 6(@)(@@) % وهل نحن إلا مرامي السهام % يحفزها نابل دائب % % 7(@)(@@) % نسر إذا جازنا طائش % ونجزع إن مسنا صائب % 8(@)(@@) % ففي يومنا قدر لابد % وعند غد قدر واثب % % 9(@)(@@) % طرائد تطلبها النائبات % ولا بد أن يدرك الطالب % 10(@)(@@) % ارى المرء يفعل فعل الحد % % د ، وهو غدا حمأ لازب % PageV01P200 11(@)(@@) % عواري من سلب الهالكين % يمد يدا نحوها السالب % 12(@)(@@) % لنا بالردى موعد صادق % ونيل المنى واعد كاذب % 13(@)(@@) % نصبح بالكاس مجدوحة % % ولا علم لي اينا الشارب % % 14(@)(@@) % حبائل لدهر مبثوثة % % يرد إلى جذبها الهارب % 15(@)(@@) % وكيف يجاوز غاياتنا % % وقد بلغ المورد القارب % % 16(@)(@@) % لقد كان رأيك حل العقال % إذا طلع المعضل الكارب % 17(@)(@@) % وقط كان عندك فرج المضيق % % إذا عض بالقتب الغارب % 18(@)(@@) % يفيء اليك من القاصيات % % مراح المناقب والعازب % % 19(@)(@@) % فيوم النهى مشرق شامس % ويوم الندى ماطر ساكب % 20(@)(@@) % فاين الفيالق مجرورة % % وقد عضل اللقم اللاحب % % PageV01P201 21(@)(@@) % واين 
ms62	 القنا كبنان الهلوك % % بماء الطلى أبدا خاضب % 22(@)(@@) % كأن السوابق من تحتها % % دبى طائر ، أو قطا سارب % 23(@)(@@) % لها قسطل كنسيج السدوس % % بهام الربى أبدا عاصب % 24(@)(@@) % وملبونة في بيوت الغزي % % يقدم إغباقها الحالب % 25(@)(@@) % نزائع لاشوطها في المغار % % قريب ولا غزوها حائب % % 26(@)(@@) % فسرج وغى ما له واضع % % وجيش علي ما له غالب % % 27(@)(@@) % وكنت العميد لها والعماد % فضاع الحمى ووهى الجانب % % 28(@)(@@) % فماذا يشيد هتاف النعي % فيك ، وما يندب النادب % 29(@)(@@) % امدت عليك القلوب العيون % % فليس يرى مدمع ناضب % % 30(@)(@@) % ارى الناس بعدك في حيرة % % فذو لبهم حاضر غائب % % PageV01P202 31(@)(@@) % كما اختبط الركب جنح الظلام % وقد غور القمر الغارب % 32(@)(@@) % ولما سبقت عيوب الرجال % % تعلل من بعدك العائب % 33(@)(@@) % ولم أر يوما كيوم به % خبا مثقب ، وهوى ثاقب % 34(@)(@@) % تلوم الضواحك فيك البكاة % ويعجب للباسم القاطب % % 35(@)(@@) % سقاك وان كنت في شاغل % % عن الري ، داني الندى صائب % 36(@)(@@) % مرب اذا مخضته الجنوب % % أبست به شمأل لاغب % 37(@)(@@) % يجر ثقائل أردافه % كما بادر القرة الحاطب % 38(@)(@@) % كسوق البطيء بسوط السريع % % ينوء ويعجله الضارب % % 39(@)(@@) % يصيبك بالقطر شفانه % كما قرع الجمرة الحاصب % 40(@)(@@) % ولولا قوام الورى أصبحت % يرن على صدعها الشاعب % PageV01P203 41(@)(@@) % وباتت وقد ضل عنها الرعاء % % محفلة ما لها حالب % 42(@)(@@) % وساق العدو أضاميمها % % وما آب من طردها آيب % % 43(@)(@@) % وما بقي الجبل المشمخر % فما ضرنا الجبل الواجب % 44(@)(@@) % وما ينقص الثلم في المضربين % إذا اهتز في القائم القاضب % 45(@)(@@) % بمثل بقائك غيث الأنا % % م يرضى عن الزمن العاتب % 46(@)(@@) % لهان علينا ذهاب الرديف % % ما بقي الظهر والراكب % PageV01P204 البحر : طويل 1(@)(@@) % من اي الثنايا طالعتنا النوائب % % واي حمى منا رعته المصائب % % 2(@)(@@) % خطون إلينا الخيل والبيض والقنا % % فما منعت عنا القنا والقواضب % 3(@)(@@) % وضل بنا قصد الطريق كانما % % تؤم المنايا لا النجاء الركائب % % 4(@)(@@) % نروغ كما راغ الطرائد دونها % % وتجلبنا عودا اليها الجوالب % % 5(@)(@@) % طوال رماح لا تقي ، وعقائل % من الجرد لا ينجو عليهن هارب % % 6(@)(@@) % فاين النفوس الآبيات 
ms63	 مليحة % % من الضيم والأيدي الطوال الغوالب % 7(@)(@@) % واين الطعان الشزر يثنى بمثله % % رقاب الأعادي دوننا والكتائب % 8(@)(@@) % اذا لم يعنك الله يوما بنصرة % % فاكبر اعوان عليك الاقارب % % 9(@)(@@) % وإن هو لم يعصمك منه بجنة % فقد اكتبت للضاربين المضارب % % 10(@)(@@) % تناهى بنا الآجال عن كل مدة % وما تنتهي بالطالبين المطالب % % PageV01P205 11(@)(@@) % نغر بإيعاد الردى ، وهو صادق % ونطمع في وعد المنى ، وهو كاذب % 12(@)(@@) % أفي كل يوم لي صديق مصادق % يجيب المنايا ، أو قريب مقارب % 13(@)(@@) % لعمري ، لقد أبقى علي بيومه % لواعج تمليها علي العواقب % % 14(@)(@@) % رماه الردى عن قوسه فاصابه % % ولم يغننا ان درعتنا التجارب % % 15(@)(@@) % هو الوالج العادي الذي لا يروعه % % من الباب بواب عليه وحاجب % % 16(@)(@@) % ولا ناصر ، سيان من هو حاضر % إذا ما دعا منا ، ومن هو غائب % 17(@)(@@) % نسير وللآجال فوق رؤوسنا % % ومنه وراء الترب أبيض قاضب % 18(@)(@@) % وما يعلم الانسان في اي جانب % % من الأرض يأوي منه في الترب جانب % % 19(@)(@@) % مصاب رمى من هاشم في صميمها % % فأمست ذراها خشعا والغوارب % 20(@)(@@) % وأطلق من وجد حباها ، ولم تكن % لهاشم لولاه العقول العوازب % % PageV01P206 21(@)(@@) % وزالت له الاقدام عن مستقرها % % كما مال للبرك المطي اللواغب % 22(@)(@@) % أطال به الشبان لطم خدودهم % وصك له غر الوجوه الاشايب % % 23(@)(@@) % يعضون منه بالأكف ، وإنما % % تعض بأطراف البنان العجائب % 24(@)(@@) % مضى املس الاثواب لم يخز مادح % % بإطنابه فيه ، ولم يزر عائب % 25(@)(@@) % وخلى فجاجا لا تسد بمثله % وتلك صدوع أعوزتها الشواعب % 26(@)(@@) % لقد هز أحشاء البعيد مصابه % فكيف المداني والقريب المصاقب % % 27(@)(@@) % ولم أنسه غاد ، وقد أحدقت به % أدان تروي نعشه وأقارب % 28(@)(@@) % يحسون من أعواده ثقل وطئه % وما أثقل الأعناق إلا المناقب % 29(@)(@@) % كأنا عرضنا زاعبيا مثقفا % % على نعشه قد جربته المقانب % % 30(@)(@@) % تعاقد حاثو تربه أي نجدة % وهل ذاك مغن ، والمنايا الجواذب % PageV01P207 31(@)(@@) % وقارعني دهري عليه ، فحازه % % ألا إن أقران الليالي غوالب % 32(@)(@@) % وكنت به ألقى الحروب ، وأتقي % % فجاء من الاقدار ما لا احارب % % 33(@)(@@) % تعاقد حاثوا تربة اي نجدة 
ms64	 % % تلاقت عليها بالتراب الرواجب % % 34(@)(@@) % كأنهم أدلوا إلى القبر ضيغما % ينوء وتثنيه الاكف الحواصب % % 35(@)(@@) % واي حسام اغمدوا في ضريحه % % كهمك لا يعصى به اليوم ضارب % % 36(@)(@@) % فآثاره محمرة في عدوه % ومنه الترب ابيض قاضب % % 37(@)(@@) % وما كان الا برهة ثم اسفرت % % نزوعا عن الوجد الوجوه الشواحب % % 38(@)(@@) % وجفت عيون الباكيات وأنسيت % من الغد ما كانت تقول النوادب % % 39(@)(@@) % تسلوا ، ولولا اليأس ما كنت ساليا % وقد يصبر العطشان والورد ناضب % 40(@)(@@) % ألسنا بني الأعمام دنيا ، تمازجت % باخلاقهم اخلاقنا والضرائب % % PageV01P208 41(@)(@@) % جميعا نمانا في ربى المجد هاشم % وأنجب عرقينا لؤي وغالب % 42(@)(@@) % إذا عمموا بالمجد لاثت بهامنا % % عمائمهم اعراقنا والمناسب % % 43(@)(@@) % نرى الشم من انافنا في وجوههم % % وأعناقنا طالت بهن المناصب % 44(@)(@@) % وكم داخل ما بيننا بنميمة % % تقطر لما زاحمته المصاعب % % 45(@)(@@) % سوى هبوات شابت الود بيننا % % واي وداد لم تشبه الشوائب % % 46(@)(@@) % لنا الدوحة العليا التي نزعت لها % % إلى المجد أغصان الجدود الأطايب % 47(@)(@@) % اذا كان في جو السماء عروقها % % فاين اعاليها واين الذوائب % % 48(@)(@@) % علونا إلى اثباجها ولغيرنا % % عن المنكب العالي ، إذا رام ناكب % 49(@)(@@) % فما حمل الآباء منا ، وساقطت % إلى الأرض منا المنجبات النجائب % % 50(@)(@@) % سيوف على الاعداء تمضي نفوسها % % ولم تتبد لهن ايد ضوارب % % PageV01P209 51(@)(@@) % فان تر فينا صولة عجرفية % % فقد عرفت فينا الجدود الاعارب % % 52(@)(@@) % فصبرا جميلا انما هي نومة % % وتلحقنا بالاولين النوائب % % 53(@)(@@) % وليس لمن لم يمنع الله مانع % ولا لقضاء الله في الأرض غالب % % 54(@)(@@) % ولو رد ميتا وجد ذي الوجد بعده % % لردك وجدي والدموع السوارب % % 55(@)(@@) % سيعطي رجال ما منعت ويشتفي % % من الاقرباء الابعدون الاجانب % % 56(@)(@@) % لنا فيك عند الدهر ثار هزيعه % % واني لثارات المقادير طالب % % 57(@)(@@) % أدرت عليك الساريات ورقرقت % على ذلك القبر الرياح الغرائب % 58(@)(@@) % ولا زال عن ذاك الضريح منور % % من الروض تفليه الصبا والجنائب % 59(@)(@@) % ولا ، بل سقيناك الدموع ، وإننا % % لنأنف ان قلنا سقتك السحائب % % PageV01P210 البحر : طويل 1(@)(@@) % لنا كل يوم رنة خلف ذاهب % % ومستهلك بين النوى والنوادب % % 2 
ms65	(@)(@@) % وقلعة اخوان كانا وراهم % % نرامق أعجاز النجوم الغوارب % 3(@)(@@) % نوادع احداث الليالي على شقى % من الحرب لو سالمن من لم يحارب % % 4(@)(@@) % ونأمل من وعد المنى غير صادق % ونأمن من وعد الردى غير كاذب % % 5(@)(@@) % وما الناس إلا دارع مثل حاسر % يصاب ، وإلا داجن مثل سارب % 6(@)(@@) % إلى كم نمنى بالغرور وننثني % % بأعناقنا للمطمعات الكواذب % 7(@)(@@) % وهل ينفع المغرور قرب للنوى % % تلوم مغرور بأرجاء جاذب % 8(@)(@@) % لززنا من الدهر الخؤون بمصدم % يحطم اشلاء القرين المجاذب % % 9(@)(@@) % هو القدر المجلوب من حيث لا يرى % % وأعيا علينا رد تلك الجوالب % 10(@)(@@) % نراع إذا ما شيك أخمص بعضنا % % وأقدامنا ما بين شوك العقارب % PageV01P211 11(@)(@@) % ونمسي بامال الدنيا سمام لطاعم % % وخوف لمطلوب ، وهم لطالب % 12(@)(@@) % تصدى لنا قرب الموامق ذي الهوى % % ويختلنا كيد العدو المجانب % % 13(@)(@@) % وإنا لنهواها على الغدر والقلى % % ونمدحها مع علمنا بالمعائب % % 14(@)(@@) % وحسبي من ضراء دهري انني % % أقيم الأعادي لي مقام الحبائب % 15(@)(@@) % ألم يأن يا للناس هبة نائم % % رأى سيرة الايام اوجد لاعب % % 16(@)(@@) % حدت بعصاها لآل ساسان والتوت % % يداها بآل المنذرين الأشاهب % 17(@)(@@) % وحلت على اطلال عاد وحمير % % سنابكها حل الجياد اللواغب % % 18(@)(@@) % نزلن قباب المنذر بن محرق % % واندية الشم الطوال بمارب % % 19(@)(@@) % نبا ببني العنقاء ناب وقعقعت % % عماد بني الريان احدى الشواعب % % 20(@)(@@) % فقادتهم قود الايانق في البرى % % وزمتهم زم القروم المصاعب % PageV01P212 21(@)(@@) % أهبت عليهم قاصفا من رياحها % % فطاروا كما ولى جفاء المذانب % % 22(@)(@@) % مسير مع الأقدار ما فيه ونية % ولا وقعة بعد اللغوب لراكب % 23(@)(@@) % ومن كانت الأيام ظهرا لرحله % فيا قرب ما بين المدى والركائب % % 24(@)(@@) % ومن اصبح المقدار حادي مطيه % % أجد بلا رزء ، ولا سوط ضارب % 25(@)(@@) % على مثلها يدمي الحليم بنانه % % عضاضا على أيدي المنايا السوالب % 26(@)(@@) % على أي خلق آمن الدهر بعدما % % تباعد ما بيني وبين الأقارب % 27(@)(@@) % سنان على ، عزي ، قناتي ، ومضرب % من المجد مستثنى به من مضاربي % % 28(@)(@@) % ولما طوى طي البرود واقبلوا % % يهادونه بين الطلى والمناكب % 29(@)(@@) % صبرت عليه 
ms66	 اطلب النصر برهة % % من الدهر ثم انقدت طوع الجواذب % 30(@)(@@) % تقطعت الأسباب بيني وبينه % فلم تبق الا علقة للمناسب % % PageV01P213 31(@)(@@) % لئن لم نطل لدم الترائب لوعة % فان لنا لدما وراء الترائب % % 32(@)(@@) % يتم تمام الرمح زادت كعوبه % % وتهتز للحمد اهتزتاز القواضب % % 33(@)(@@) % بمطرورة الأنياب عوج المخالب % ولا الريق في كر الرزايا بناضب % 34(@)(@@) % يداهي ضباب القاع وهو كانه % % من اللين غمر غير جم المذاهب % % 35(@)(@@) % إذا طبع الآراء ماطل غربها % % فلم يمضها الا باذن العواقب % % 36(@)(@@) % من القوم حلوا في المكارم والعلى % % بملتف أعياص الفروع الأطايب % 37(@)(@@) % اقاموا بمستن البطاح ومجدهم % % مكان النواصي من لؤي بن غالب % % 38(@)(@@) % بهاليل ازوال تعاج اليهم % % صدور القوافي أو صدور النجائب % % 39(@)(@@) % عظام المقاري يمطرون نوالهم % بايدي مساميح سباط الرواجب % % 40(@)(@@) % إذا طلبوا الأعداء كانوا نغيضة % ليوم الوغى من قبل جر الكتائب % PageV01P214 41(@)(@@) % وباتوا مبيت الأسد تلتمس القرى % % بمطورة الانياب عوج المخالب % % 42(@)(@@) % و اضحوا على الاعواد تسمو لحاظهم % % كلمح القطاميات فوق لمراقب % % 43(@)(@@) % فماشئت من داع إلى الله مسمع % % ومن ناصر للحق ماضي الضرائب % 44(@)(@@) % هم استخدموا الاملاك عزا وارهفوا % % بصائرهم بعد الردى والمعاطب % 45(@)(@@) % وهم أنزلوهم بعدما امتد غيهم % جماما على حكم من الدين واجب % 46(@)(@@) % تساموا إلى العز الممنع ، وارتقوا % % من المجد أنشاز الذرى والغوارب % 47(@)(@@) % على ارث مجد الاولين تعلقوا % % ذوائب اعناق العلى والمناصب % % 48(@)(@@) % بحيث ابتنت أم النجوم منارها % % وأوفت ربايا الطالعات الثواقب % 49(@)(@@) % لهم ورق من عهد عاد وتبع % % حديد الظبى إلا انثلام المضارب % 50(@)(@@) % فضالات ما ابقى الكلاب وطخفة % % وما أسأر الابطال يوم الذنائب % % PageV01P215 51(@)(@@) % بهن فلول من وريدي عتيبة % % ونضخ نجيع من ذؤاب بن قارب % % 52(@)(@@) % تقلقل في الأغماد هزلا ، وخطبها % % جسيم إذا جربن بعض التجارب % 53(@)(@@) % غدوا إلى هدم الكواهل والطلى % % وعود إلى حذف الذرى والعراقب % 54(@)(@@) % لتبك قبور افرغ الموت تحتها % % سجال العطايا بعدهم والرغائب % 55(@)(@@) % وطاب ثراها ، والثرى غير طيب % وذاب نداها ، والندى غير ذائب % 56(@)(@@) % كأن اليماني ذا العياب بأرضها % % يقلب من 
ms67	 دارين ما في الحقائب % % 57(@)(@@) % اذا اجتاز ركب كان اجود عندها % % بعقر المطايا من سحيم وغالب % % 58(@)(@@) % افي كل يوم يعرق الدهر اعظمي % % وينهس لحمي جانبا بعد جانب % 59(@)(@@) % فيوما رزايا في صديق مصادق % و يوما رزايا في قريب مقارب % % 60(@)(@@) % فكم فل مني ساعدا بعد ساعد % وكم جب مني غاربا بعد غارب % PageV01P216 61(@)(@@) % و فادحة يستهزم الصبر باسمها % % وتظمى إلى ماء الدموع السواكب % 62(@)(@@) % صبرنا لها صبر المناكب حسبة % إذا اضطرت الناس اضطراب الذوائب % % 63(@)(@@) % تعاصي أنابيب الحلوم جلادة % و تعهفوا يراعات العقول العوازب % % 64(@)(@@) % كظوما على مثل الجوائف اتعبت % % نطاسيها من قارف بعد جالب % % 65(@)(@@) % تحل الرزايا بالرجال وتنجلي % % ورب مصاب ينجلي عن مصائب % % 66(@)(@@) % من اليوم يستدعي منازلك البكا % % إذا ما طوى الأبواب مر المواكب % 67(@)(@@) % وتضحك عنك الأرض أنسا وغبطة % % وتبكيك أخدان العلى والمناقب % 68(@)(@@) % سقاك الحيا إن كان يرضي لك الحيا % % بغر الاعالي مظلمات الجوانب % % 69(@)(@@) % تمد بارداف ثقال وترتمي % % على عجرفيات الصبا والجنايب % % 70(@)(@@) % كأن لواء يزد حمن وراءه % إذا اختلج البرق ازدحام المقانب % PageV01P217 71(@)(@@) % بودق كاخلاق العشار استفاضها % % تداعي رغاء من مبس وحالب % % 72(@)(@@) % يقر بعيني ان تطيل مواقفا % عليك مجر المدجنات الهواضب % % 73(@)(@@) % و إن ترقم الأنواء تربك بعدها % % بكل جديد النور رقم الكواكب % 74(@)(@@) % ذكرتكم ، والعين غير محيلة % فانبطت غدران الدموع السواكب % % 75(@)(@@) % وما جالت الألحاظ إلا بقاطر % ولا امتدت الأنفاس إلا بحاصب % 76(@)(@@) % وهل نافعي ذكر الأخلاء بعده % جرى بيننا مور النقا والسباسب % PageV01P218 البحر : منسرح 1(@)(@@) % اي دموع عليك لم تصب % % واي قلب عليك لم يجب % % 2(@)(@@) % خبت إليك الخطوب معجلة % ضروب شد الجياد والخبب % % 3(@)(@@) % واعجبي للزمان كيف نبا % % واعجب ان اقول واعجبي % % 4(@)(@@) % مالي وما وبللخطوب تسلبني % % في كل يوم غرائب السلب % 5(@)(@@) % اما فتى ناضر الصبا كاخي % % عندي أو زائد المدى كابي % % 6(@)(@@) % وإنني للشقاء أحسبني % % ألعب بالدهر ، وهو يلعب بي % % 7(@)(@@) % ما نمت عنه الا وايقظني % % من الرزايا بفيلق لجب % % 8(@)(@@) % ولم أزعه ، إلا وأعقبني % % سطوا 
ms68	 كوقع الظبي على اليلب % % 9(@)(@@) % في كل دار تعدوا المنون ومن % كل الثنايا مطالع النوب % 10(@)(@@) % بفوز بالراحة الفقيد وللف % % فاقد طول العناء والتعب % PageV01P219 11(@)(@@) % يطيب نفسا عنا وواحدنا % % إن طيب القلب عنه لم يطب % 12(@)(@@) % احمدكم لي عليك من كمد % % باق ومن جود ادمع سرب % % 13(@)(@@) % ولوعة تحطم الضلوع اذا % % ذكرت قرباللقاء عن كثب % % 14(@)(@@) % إن قطع الموت بيننا ، فلقد % عشنا وما حبلنا بمنقضب % 15(@)(@@) % كم مجلس صبحته السننا % % تفض فيه لطائم الادب % % 16(@)(@@) % من أثر يونق الفتى حسن % أو خبر يبسط المنى عجب % % 17(@)(@@) % أو غرض اصبحت خواطرنا % % تساقط الدر منه في الكتب % 18(@)(@@) % كالبارد العذب روقته صبا ال % % الظلم زين بالشنب % % 19(@)(@@) % غاض غدير الكلام ما بقي ال % % دهر وقرت شقاشق الخطب % 20(@)(@@) % يا علم المجد لم هويت وقد % % كنت أمين العماد والطنب % PageV01P220 21(@)(@@) % يا مقول الدهر لم صمت وقد % كنت زمانا أمضى من القضب % 22(@)(@@) % يا ناظر الفضل لم غضضت وما % % كنت قديما تغضي على الريب % % 23(@)(@@) % كنت قريني ولست من لدتي % % كنت نسيبي ولست من نسبي % % 24(@)(@@) % مما يقوي العزاء عنك ، وإن % % شرد قلبي العزاء بالكرب % 25(@)(@@) % أنك أحرزتها ، وإن رغم ال % % دهر ، ثمانين طلقة الحقب % 26(@)(@@) % فان دموعي جرين نهنها % % علمي بان قد ظفرت بالارب % % 27(@)(@@) % فليت عشرين بت أحسبها % % باعدن بين الورود والقرب % 28(@)(@@) % اني اظمى إلى المشيب ومن % % ينج قليلا من الردى يشب % % 29(@)(@@) % وإن يزر طالع البياض أقل % يا ليت ليل الشباب لم يغب % % 30(@)(@@) % مر على ذلك التراب من الم % % زن خفوق الاعلام والعذب % % PageV01P221 31(@)(@@) % كالعير ذات الأوساق صاح بها % % معتسف بالايانق النجب % % 32(@)(@@) % اذا خبا برقه استعان على % % ايقاده بالمجلجل اللجب % % 33(@)(@@) % لترتوي ثم أعظم نزلت % داجي الدماميم موحش الحدب % 34(@)(@@) % بحيث تزوى عن النسيم % % تدرج عنا مطالع الشهب % 35(@)(@@) % فثم بشر اصفى من الغدق ال % % عذب وجود أندى من السحب % 36(@)(@@) % واجبل كان يستذم به % % من الليالي فساخ في الترب % % 37(@)(@@) % لا تحسبن الخلود بعدك لي % % إن المنايا 
ms69	 أعدى من الجرب % 38(@)(@@) % إن انج منها وقد شربت بها % % فان خيل المنون في طلبي % % PageV01P222 البحر : رجز تام 1(@)(@@) % لا لوم للدهر ولا عنابا % % تغاب ان الجلد من تغابا % % 2(@)(@@) % صبرا على الضراء واحتسابا % % اصبرنا اعظمنا ثوابا % % 3(@)(@@) % ما الدمع مما يزع المصابا % % ولا يرد القدر الغلابا % % 4(@)(@@) % أمضى الزمان حكمه غلابا % % اصابنا وطال ما اصابا % % 5(@)(@@) % يولغ ظفرا للردى ونابا % % لا يبكين حاضرنا من غابا % % 6(@)(@@) % ما غاب منا غائب فأبا % % ورب حي دعموا القبابا % % 7(@)(@@) % واستفسحوا الأعطان والرحابا % % وطبقوا السهول والعقابا % % 8(@)(@@) % لا يرهبون للعدى ذبابا % % أمسوا لقاحا ، وغدوا نهابا % % 9(@)(@@) % جر على دارهم ذنابا % % واتبع القوادم الذنابا % % 10(@)(@@) % بمعجل ينتزع الأطنابا % % يوطي الحمى ويهتك الحجابا % % PageV01P223 11(@)(@@) % كالباترات تبذر الرقابا % % نسعى ، ويطوينا الردى وثابا % % 12(@)(@@) % كنم قطع الاقران والاسبابا % % وفرق الجيران والاحبابا % % 13(@)(@@) % واستدرج العبيد والأربابا % % سيل ردى قد ملأ الشعابا % % 14(@)(@@) % وجن موجا وطغى عبابا % % قارعنا وانتزع اللبابا % % 15(@)(@@) % اعجب واخلق ان ترى عجابا % % يبلد الافهام والالبابا % % 16(@)(@@) % إن الردى وإن رمى فصابا % % وجاذبتنا يده جذابا % % 17(@)(@@) % يعجم من عيداننا صلابا % % صعبا يلاقي انفسا صعابا % % 18(@)(@@) % لا تنكر الموت لها شرابا % % ولا تعاف الصبر المذابا % % 19(@)(@@) % سوالب ومرة اسلابا % % إذا أنا انقدت ولما آبى % % 20(@)(@@) % منجفلا مع الردى منجابا % % فلم سننت الصارم القرضابا % % PageV01P224 21(@)(@@) % ولم ربطت الشرب العرابا % % يمرين بالشكائم اللعابا % % 22(@)(@@) % خمايصا تحاضر الذيابا % % يحملن اسدا في الوغى غضابا % % 23(@)(@@) % قد سلبوا السوابغ العيابا % % ركبا وطورا للقنا ركابا % % 24(@)(@@) % يحمي الحمى ويمنع الجنابا % % حتى إذا داعي الردى أهابا % % 25(@)(@@) % اسقط من ايماننا الكعابا % % وبزنا أرواحنا إغصابا % % 26(@)(@@) % لا طعن تسطيع ولا ضرابا % % مقتحم على الأسود الغابا % % 27(@)(@@) % ورب إخوان مضوا شبابا % % تلاحقوا إلى الردى صحابا % % 28(@)(@@) % لا نترجى منهم ايابا % % ولا نعد لهم الا حقابا % % 29(@)(@@) % لا يحفل الحجاب والابوابا % % اذا دعوا لم يرجعوا جوابا % % 30(@)(@@) % ولبسوا الجندل والظرابا % % لقدر ما عمروا الخرابا % % PageV01P225 31(@)(@@) % يا غصنا طال وفرعا طابا % % لما ذوى اودغته الترابا % % 32(@)(@@) % أراب من 
ms70	 يومك ما أرابا % % لا زلت أستسقي لك السحابا % % 33(@)(@@) % كل اغر يدق الذهابا % % مجررا على الربى أهدابا % % 34(@)(@@) % يبقي بأجواز الثرى أندابا % % وينثني مجولا جوابا % % 35(@)(@@) % وإن لبست للبلى جلبابا % % ارى البكاء سفها وعابا % % 36(@)(@@) % لا تجعلنه ديدنا ودابا % % وافق منا اجل كتابا % % PageV01P226 البحر : طويل 1(@)(@@) % لأظما معلينا وأروى المصائبا % % وأسخط آمالا وأرضى نوائبا % % 2(@)(@@) % مصاب نجوم المجد فيه نواجم % تركن نجوم الصبر عنه غواربا % % 3(@)(@@) % اصابت سهام الحادثات قلوبها % % فكم اعقبت روعا يروع العواقبا % % 4(@)(@@) % لقد وعدتنا ، إذ رغبنا رغايبا % فلما أصبن الظن أعطت مصايبا % % 5(@)(@@) % وأرضعن أفواه المطامع فجعة % فطمن بها عند النجاح المطالبا % % 6(@)(@@) % بمفقودة ينهل ماء مصابها % % دموعا على خد الزمان سواكبا % % 7(@)(@@) % إذا قعدت أحزانها في قلوبنا % % أقمنا على الصبر الشفاه نوادبا % % 8(@)(@@) % صبرنا فغصصنا الزمان بريقه % على ان للايام فينا مضاربا % % 9(@)(@@) % ولم نطرح الاسلاب يوما لنكبة % % وإن جذب المقدار منا المجاذبا % % 10(@)(@@) % ألا إن هذا الثاكل الحسب الذي % % به ثكل المجد التليد المناقبا % % PageV01P227 11(@)(@@) % رمى في يمين الدهر درة سؤدد % فأحج بها يحنو عليها الرواجبا % % 12(@)(@@) % وقد شن فيها حادث الموت غارة % % ثنتنا ولم تطلع إلينا كتائبا % % 13(@)(@@) % فلا تحسبن رزء الصغائر هينا % فإن وجى الأخفاف ينضي الغواربا % % 14(@)(@@) % سقى الله حصباء الثرى كل ليلة % % سحائب ينزعن الرياح الحواصبا % % 15(@)(@@) % جنادل من قبر كأن صدورها % % حباه الحيادون القبور محاربا % % 16(@)(@@) % اقامت به حتى لودت عيوننا % % ولم تبق دمعا ان يكون سحائبا % % 17(@)(@@) % تراب يرى ان النجوم ترابه % % ويحسب أحجار الصفيح الكواكبا % % 18(@)(@@) % وسيف نضي من جفنه ، غير أنه % رضي لحده من غمده الدهر صاحبا % % 19(@)(@@) % يغطي الثرى عنا وجوها مضيئة % % كما كفر الغيم النجوم الثواقبا % % 20(@)(@@) % ورزء رمى صدر الأماني بيأسها % % وكن إلى ورد المعالي قواربا % % PageV01P228 21(@)(@@) % ألا رب ليل قلقلته عزائمي % % إلى أن نضا عن منكبيه الغياهبا % % 22(@)(@@) % جذبت بضبع العزم من بين اضلعي % % وزاحمت بالهم الدجى والسباسبا % % 23(@)(@@) % وجردا ضربن الدهر في أم رأسه % وجزن بنا أعجازه والمناكبا % % 24(@)(@@) % ومرت حواميها 
ms71	 على لمة الدجى % % تجاذب بالادلاج منها الذوائبا % % 25(@)(@@) % واني لمن قوم اذا ركبوا الندى % % إلى الحمد باتوا يعسفون الركائبا % % 26(@)(@@) % إذا فاض رقراق المحامد صيروا % % له جودهم دون اللئام نصائبا % % 27(@)(@@) % وإن ضاق صدر الخطب وسع بأسهم % % لسمر القنا بين الضلوع مذاهبا % % 28(@)(@@) % بطعن كدفاع الغمام تحته % % ذوابل يمطرن الدماء صوائبا % % 29(@)(@@) % له شرر يرمي الرماح بلفحه % يكاد يرى ماء الأسنة ذائبا % % 30(@)(@@) % إذا أنكروا في النقع ألوان خيلهم % أضاء لهم حتى يشيموا السبائبا % % PageV01P229 31(@)(@@) % أبا قاسم جاءت إليك قلائد % تقلد اعناق الكرام مناقبا % % 32(@)(@@) % قلائد من نظمي يود لحسنها % % قلوب الأعادي أن تكون ترائبا % % 33(@)(@@) % اذا هدها راوي القريض حسبته % % يقوم بها في ندوة الحي خاطبا % % 34(@)(@@) % فلو كن غدرانا لكن مشاربا % % ولو كن احداثا لكن تجاربا % % PageV01P230 البحر : مجتث 1(@)(@@) % يا دين قلبك من با % % رق ينير ويحبو % % 2(@)(@@) % على شريقي نجد % مرعى لعينك جدب % % 3(@)(@@) % كما تليح ذراع % % فيها من النضر قلب % % 4(@)(@@) % كأنه نار عليا % % اء للضيوف تشب % % 5(@)(@@) % أو ساطعات أراها % % والليلداج ازب % % 6(@)(@@) % مراوح بيديه على % % على الزناد مكب % 7(@)(@@) % أو أم مثوى يلنجوج % % هاعلى النار رطب % % 8(@)(@@) % الغور منه معان % وعاقل والهضب % 9(@)(@@) % له حفيف رعاد % يراع منه السرب % 10(@)(@@) % وبارقات كما % % ت العجاج القضب % PageV01P231 11(@)(@@) % اما ترى البرق يبدو % % إلا لعينك غرب % 12(@)(@@) % وللزفير هباب % بين الضلوع وهب % % 13(@)(@@) % يضيء بالطف قبرا % فيه الاعز الاحب % % 14(@)(@@) % يهمي السنان ، ويس % لا بل من القلب خلب % 15(@)(@@) % ما كنت احسب يوما % % والدهر ضرب وضرب % 16(@)(@@) % أني أبيت وبيني % % وبين لقياك سهب % 17(@)(@@) % وان تطارد مابينن % % ننا زعازع نكب % 18(@)(@@) % بحيث يرتع أدم % من الجوازي ، وحقب % 19(@)(@@) % وكيف يكرع مستورد % % رد القطا ويعب % 20(@)(@@) % يا دار قومي أين الأ % بربعك لبوا % % PageV01P232 21(@)(@@) % مصاعب حطمتهم % % ايدي المنون فخبوا % % 22(@)(@@) % يسوقهم للمقادي % % ر سائق متلئب % 23(@)(@@) % مقحم للجراثيم إن % ونوا ، أو أغبوا % % 24(@)(@@) % كانوا السيوف إذا عا % % ينوا المقاتل هبوا % % 25(@)(@@) % والزاغبيات إن أش % رعوا عن الدار ذبوا 
ms72	 % % 26(@)(@@) % منازل كان فيها % % للقوم امن ورعب % % 27(@)(@@) % تكد فيها الأنابي % % والرباجط القب % % 29(@)(@@) % رأي يغب لحزم % ونائل لا يغب % % 30(@)(@@) % ينقاد فيكل يوم % % منا الابي الصعب % % 31(@)(@@) % يجذ أصل وريق ال % % ويدرج عقب % % PageV01P233 32(@)(@@) % لا مبغض القوم يبقى % % ولا المجل المحب % 33(@)(@@) % سواء الملس في غا % % رة الردى والجرب % 34(@)(@@) % يجري القضاء ويمضي % % الطبيب والمستطيب % % 35(@)(@@) % كم ذا الامان % % 36(@)(@@) % وبالزيال لغربا % % نها شحيج ونعب % 37(@)(@@) % يغر سلم الليالي % % والسلم منهن حرب % % 38(@)(@@) % لنا من الدهر ربض % على وعيد ووثب % % 39(@)(@@) % يوما غرور ويوما % عدو علينا وشغب % % 40(@)(@@) % ينحو المضيق ، وقد أع % الطريق اللحب % % 41(@)(@@) % أ أخر اللعب جد % % أم اخر الجد لعب % % PageV01P234 42(@)(@@) % شقيقتي ان خطبا % % عدا عليك لخطب % % 43(@)(@@) % وان رزأ رماني % % بالبعد عنك لصعب % 44(@)(@@) % سهم اضصابك منه % % للقدر فوق وغرب % 45(@)(@@) % لا النصل منه بباب % % يوما ولا الريش لغب % % 46(@)(@@) % يبيت بعدك في % % جعي الجوى والكرب % 47(@)(@@) % كما يبيت رميض % بعد السنام الاجب % % 48(@)(@@) % اني على قضض % % م يطمئن الجنب % 49(@)(@@) % لو رد عنك المنايا ال % % ال طعن وضرب % % 50(@)(@@) % لخاض فيها سنان % % ماض وطبق عضب % % 51(@)(@@) % وقام دون الردى % % غلظ السواعد غلب % % PageV01P235 52(@)(@@) % وناقلت بالعوالي ذؤب % % ذؤبان ليل تخب % 53(@)(@@) % قضيت نحبا قضى بع % % ده من المجد نحب % % 54(@)(@@) % ولم يكن لك إلا % من المقادير خطب % % 55(@)(@@) % ودون كل حجاب % من العفافة حجب % 56(@)(@@) % وقبرك الصون من قب % ان يضمك ترب % % 57(@)(@@) % كانني كل يوم % % قلبي اليك اصب % % 58(@)(@@) % كم ذا الأمان وللنا % % قرح عاد قلبي ندب % 59(@)(@@) % يكل واقع طرفي % % عمن سواك وينبو % % 60(@)(@@) % أجل قبرك عن أن % أقول حياه ركب % 61(@)(@@) % أو ان اقول سقاه % % صوب الغمام المرب % % PageV01P236 62(@)(@@) % الا لحاجة نفس % % تهفو اليك وتصبو % % 63(@)(@@) % أو ان يبل غليل % % ان بل قبرك شرب % % 64(@)(@@) % وكيف يظمأ قبر % % فيه الزلال العذب % 65(@)(@@) % أم كيف تظلم أرض % أجن فيها الشهب % 66(@)(@@) % نوارها المجد لا % % وة الربى والعرب % 67(@)(@@) % جاورت جارا تلقا % % ك منه 
ms73	 برور حب % % 68(@)(@@) % شعب غدا ، وهو لل % ه والملائك شعب % % 69(@)(@@) % يا نومة ثم منها % % إلى الجنان المهب % % 70(@)(@@) % إن كان للشخص بعد % فللعلائق قرب % 71(@)(@@) % أغبه ، وبرغمي % % إن الزيارة غب % PageV01P237 72(@)(@@) % لئن خلا منك طرف % لقد ملي منك قلب % 73(@)(@@) % وان غربت فلطا % % لعات شرق وغرب % 74(@)(@@) % خلاك ذم وذم % % للدهر فيك وقصب % % 75(@)(@@) % ولم يزل بعد يومي % % مني على الدهر عتب % % 76(@)(@@) % فكم ابيت وعندي % % لذي المقادير ذنب % % PageV01P238 البحر : متقارب تام 1(@)(@@) % اودع في كل يوم حبيبا % % وأهدي إلى الأرض شخصا غريبا % % 2(@)(@@) % وارجع عنه جميل العزاء % % أمسح عن ناظري الغروبا % % 3(@)(@@) % كأني لم أدر أن السبي % % ل سبيلي ، وأني ملاق شعوبا % % 4(@)(@@) % وأن ورائي سوقا عنيفا % وأن أمامي يوما عصيبا % % 5(@)(@@) % ولا انني بعد طول البقاء % % اصاب كما ان غيري اصيبا % % 6(@)(@@) % اماني اوضع في غيها % % لريح الغرور بها مستطيبا % % 7(@)(@@) % تذكر عواقب موبي النبات % ولا تتبع العين مرعى خصيبا % % 8(@)(@@) % قعدت بمدرجة النائبات % % يمر الزمان علي الخطوبا % % 9(@)(@@) % على الهم أنفق شرخ الشباب % وأعطي المنايا حبيبا حبيبا % % 10(@)(@@) % تصاممت عن هتفات المنون % % بغيري ولا بد من أن أجيبا % % PageV01P239 11(@)(@@) % واعلم اني ملاقي التي % % شعبن قبائلنا والشعوبا % % 12(@)(@@) % ألا إن قومي لورد الحمام % مضوا امما واجابوا المهيبا % % 13(@)(@@) % بمن أتسلى وأيدي المنون % تخالس فرعي قضيبا قضيبا % % 14(@)(@@) % نزعن قوادم ريش الجناح % % وأثبتن في كل عضو ندوبا % % 15(@)(@@) % نجوم ، إذا شهدوا الأنديات % رجوم اذا ما اقاموا الحروبا % % 16(@)(@@) % إذا عقدوا للعطاء الحبى % % وان زعزعوا للطعان الكعوبا % % 17(@)(@@) % عراعر لا ينطقون الخنا % % ولا يحفظون الكلام المعيبا % % 18(@)(@@) % يرم الفتى منهم جهده % فإن قال قال بليغا خطيبا % % 19(@)(@@) % جلابيب لا تضمر الفاحشات % % وأردية لا تضم العيوبا % % 20(@)(@@) % وبشر يهاب على حسنه % % فتحسبه غضبا أو قطوبا % % PageV01P240 21(@)(@@) % لقد أرزمت إبلي بعدكم % وأبدى لها كل مرعى جدوبا % % 22(@)(@@) % نزعت أزمتها للمقام % واعفيت منها الذرى والجنوبا % % 23(@)(@@) % لمن اطلب المال من بعدكم % % واحفى الحصان وانضى الجنيبا % % 24(@)(@@) % حوامي جبال رعاها الحمام % فسوى بهن 
ms74	 الثرى والجنوبا % % 25(@)(@@) % وكم واضح منكم كالهلال % % ل هالت يداي عليه الكثيبا % % 26(@)(@@) % ونازعني الموت من شخصه % سنانا طريرا وعضبا مهيبا % % 27(@)(@@) % وحلما رزينا وأنفا حميا % وعزما جريا ورايا مصيبا % % 28(@)(@@) % صوارم اغمدتها في الصعيد % % وفللت منها الظبا والغروبا % % 29(@)(@@) % أقول لركب خفاف المزاد % وقد بدلوا بالوضاء الشحوبا % % 30(@)(@@) % الموا باجواز تلك القبور % % فعروا الجياد وجزوا السبيبا % % PageV01P241 31(@)(@@) % قفوا فامطروا كل عين دما % بها واملؤا كل قلب وجيبا % % 32(@)(@@) % ولا تعقروا غير حب القلوب % % ب ، إذا عقر الناس بزلا ونيبا % % 33(@)(@@) % وإني على أن رماني الزمان % واعقب بالقلب جرحا رغيبا % % 34(@)(@@) % لتعجم مني ضروس الخطو % % ب قلبا جليدا وعودا صليبا % % 35(@)(@@) % وابقى العواجم من صعدتي % % عشوزنة تستقل النيوبا % % 36(@)(@@) % أخلاء ! لا زال جم البروق % أجش الرعود يطيع الجنوبا % % 37(@)(@@) % إذا ما مطاياه جبن الفلا % % انمنا عليها الوجا واللغوبا % % 38(@)(@@) % يشق الزاد على تربكم % % ويمري على كل قبر ذنوبا % % 39(@)(@@) % وأسأل أين مصاب الغمام % شروقا ، إذا ما غدا ، أو غروبا % % 40(@)(@@) % أضن على القطر أن يستهل % على غير اجداثكم أو يصوبا % % PageV01P242 41(@)(@@) % غلبت عليكم فيا صفقة % غبنت بها العيش غصنا رطيبا % % 42(@)(@@) % فلولا الحياء لعط القلوب % عليكم عصائب عطوا الجيوبا % % 43(@)(@@) % ولم يك قدر الرزايا بكم % جنانا مروعا ودمعا سكوبا % % 44(@)(@@) % وإن ضرايحكم في الصعيد % لتكسو الخبيث من الأرض طيبا % % 45(@)(@@) % وهبنا لفيض الدموع الخدود % % عليكم ، وحر الغرام القلوبا % % 46(@)(@@) % لقد شغلتني المراثي لكم % % بوجدي عن ان اقول النسيبا % % 47(@)(@@) % وكنت أعد ذنوب الزمان % فبعدكم لا أعد الذنوبا % % 48(@)(@@) % أراب الردى فيكم جاهدا % وزاد ، فجاز مدى أن يريبا % % 49(@)(@@) % أ أنشد من قد اضل الحمام % % عناء لعمرك اعيا الطبيبا % % PageV01P243 البحر : مجزوء الكامل 1(@)(@@) % لو كان يعتبني الحمام % % م لطال بعد اليوم عتبي % % 2(@)(@@) % إني وما عاتبته % إلا وأعتبني بذنبي % % 3(@)(@@) % صبرا أخي ، فإنها % % تمضى ولو وقعت بهضب % % 4(@)(@@) % هون عليك ، فقد يكو % % ن الصعب عندك غير صعب % 5(@)(@@) % وانهض فما حملت على % % قصف الفقار ولا اجب % % 6(@)(@@) % كنت الطبيب لمثلها % % لو 
ms75	 يتقى قدر بطب % 7(@)(@@) % ولئن رمى رامي الردى % % غرضا ، فزعزع غير سربي % % 8(@)(@@) % فلقد اصاب بسهمه % % الغرضين من عيني وقلبي % % PageV01P244 البحر : منسرح 1(@)(@@) % اذهب ولا تبعدن من رجل ! % إن كرام الرجال قد ذهبوا % % 2(@)(@@) % أدركت فوق الذي طلبت ندى % % غمرا وفات اللئام ما طلبوا % % 3(@)(@@) % لا يخلف الدهر ما تجود به % ولا يعير الرجال ما تهب % % 4(@)(@@) % عرض نقي من الوصوم ، إذا % % احك عرض المذمم الجرب % % 5(@)(@@) % مضى التليد الأعلى لطيبه % واستأخر المنسمان والذنب % % 6(@)(@@) % ترعية طاعت الصعاب له % واستوسقت في زمامه العرب % 7(@)(@@) % يا دهر رشقا بكل نائبة % قد انتهى العتب وانقضى العجب % % 8(@)(@@) % رد يدي ما استطعت عن أربي % % لم يبق لي بعد موتهم أرب % PageV01P245 البحر : طويل 1(@)(@@) % على اي غرس امن الدهر بعد ما % % رمى فادح الايام في الغصن الرطب % % 2(@)(@@) % ذوى قبل أن تذوي الغصون ، وعهده % % قريب بأيام الربيلة والخصب % 3(@)(@@) % كفى أسفا للقلب ما عشت أنني % % بكفي على غيني حثوت من الترب % % 4(@)(@@) % جرت خطرة مكنها وفي القلب عطشة % % رفعت لها راسي عن البارد العذب % % 5(@)(@@) % وقلت لجفني رد دمعا على دم % وللقلب عالج قرح ندب على ندب % % 6(@)(@@) % ومما يطيب النفس بعدك انني % % على قرب من ماء وردك أو قرب % % 7(@)(@@) % الا لا جوى مس الفؤاد كذا الجوى % % ولا ذنب عندي للزمان كذا الذنب % 8(@)(@@) % خلا منك طرفي وامتلا منك خاطري % % كانك من عيني نقلت إلى قلبي % % PageV01P246 البحر : مجزوء الكامل 1(@)(@@) % ما للهموم كأنها % % نار على قلبي تشب % 2(@)(@@) % والدمع لا يرقا له % غرب كأن العين غرب % 3(@)(@@) % لوداع اخوان الشباب % % ب مضت مطاياهم تخب % 4(@)(@@) % فارقتهم ، والعين عي % ن بعدهم ، والقلب قلب % 5(@)(@@) % ما كنت احسب انني % % جلد على الارزاء صعب % % 6(@)(@@) % أو انني ابقى وظه % % ري بعد أقراني أجب % 7(@)(@@) % لا الوجد منقطع الوقود % % د ولا مزار الدمع غب % 8(@)(@@) % ما اخطأتك النائبا % % ت اذا اصابت من تحب % % PageV01P247 البحر : طويل 1(@)(@@) % أقول ، وقد أرسلت أول نظرة % ولم أر من أهوى قريبا إلى 
ms76	 جنبي % % 2(@)(@@) % لئن كنت أخليت المكان الذي أرى % % فهيهات أن يخلو مكانك من قلبي % % 3(@)(@@) % وكنت أظن الشوق للبعد وحده % ولم ادر ان الشوق للبعد والقرب % % 4(@)(@@) % خلا منك قلبي وامتلا منك خاطري % % كانك من عيني نمقلت إلى قلبي % % PageV01P248 البحر : طويل 1(@)(@@) % أيا شاكيا مني لذنب جنيته % فديتك من شاك إلى حبيب % % 2(@)(@@) % لئن راب مني ما يريب فإنني % % على عدواء الدهر غير مريب % % 3(@)(@@) % وإني لأرعى منك والغيب بيننا % % هوى قلما يرعى بظهر مغيب % % 4(@)(@@) % فهب لي ذنبا واحدا ، كان قلته % % فما زلل من حازم بعجيب % 5(@)(@@) % فيا حسن حال الود ما دمت مذنبا % اتوب وما دامت تعد ذنوبي % % PageV01P249 البحر : كامل تام 1(@)(@@) % لا والذي قصد الحجيج لبيته % % ما بين ناء نازح وقريب % 2(@)(@@) % والحجر والحجر المقبل تلتقي % % فيه الشفاه ، وركنه المحجوب % 3(@)(@@) % لا كان موضعك الذي ملكته % % بين الاصالع بعد ذا لحبيب % % 4(@)(@@) % إني وجدت لذاذة لك في الحشا % % ليست لماكول ولا مشروب % % 5(@)(@@) % لي انة الشاكي اذا بعد المدى % % ما بيننا وتنفس المكروب % PageV01P250 البحر : خفيف تام 1(@)(@@) % إن طيف الحبيب زار طروقا % والمطايا بين القنان وشعب % 2(@)(@@) % فوق اكوارهن انضاء شوق % % طرقوا بالغرام دون الركب % 3(@)(@@) % كلما انت المطي من الاعياء % % انوا من الجوى والكرب % % 4(@)(@@) % زارني واصلا على غير وعد % % وانثنى هاجرا على غير ذنب % 5(@)(@@) % كان قلبي اليه رائد عيني % % فعلى العين منة للقلب % % 6(@)(@@) % بت ألهو بناعم الجيد غض % وفم بارد المجاجة عذب % % 7(@)(@@) % بل وجدي ومن راى اليوم قبلي % % ناقعا للغليل من غير شرب % % 8(@)(@@) % سامحا لي على البعاد بنيل % % كان يلويه في زمان القرب % 9(@)(@@) % كان عندي أن الغرور لطرفي % % فإذا ذلك الغرور لقلبي % % PageV01P251 البحر : طويل 1(@)(@@) % حلفت باعلام المحصب من منى % % وما ضم ذاك القاع والمنزل الرحب % % 2(@)(@@) % وكل بجاوي يجر زمامه % إذا ما تراخت في أزمتها النجب % 3(@)(@@) % وترجيع أصوات الحجيج وقد بدا % % وقور النواحي تستبد به الحجب % 4(@)(@@) % وروعة يوم النحر والهدى حائر % % وكل دم اودى بجمته الركب % % 5 
ms77	(@)(@@) % لقد جل ما بيني وبينك عن قلى % % سواء تدانى البعد أو بعد القرب % 6(@)(@@) % ولي دمع عين لا يرنق ساعة % ونار غرام بين جنبي لا تخبو % % 7(@)(@@) % وقلب يمور الطرف ان قرفى الحشا % % وطرف ، إذا سكنته نفر القلب % 8(@)(@@) % وجسم اذا جردته من قميصه % % على الناس قالوا هكذا يفعل الحب % % 9(@)(@@) % فما لي على ما بي أعنف في الهوى % % ويرمضني العذل المؤرق والعتب % 10(@)(@@) % على حين أعطيك الوفاء مصرحا % وأصفيك محض الود ما عظم الخطب % PageV01P252 11(@)(@@) % وكنت اذا فارقت دارك ساعة % % صمت ، فلا جد لدي ولا لعب % 12(@)(@@) % الا ليت شعري هل ابيتن ليلة % % بميثاء يلطى في اباطحها الثرب % % 13(@)(@@) % تطرقها ماء الغمام ودرجت % % بها الريح مخضرا كما نشر العصب % % 14(@)(@@) % وهل أذعرن قلب الظلام بفتية % تهاوى بهم قود السوالف أو قب % 15(@)(@@) % وهل أردن ماء وردنا بمثله % جميعا وفي غصن الهوى ورق رطب % % 16(@)(@@) % وهل لي بدار انت فيها اقامة % % فانشرلا ما تطوى الرسائل والكتب % % 17(@)(@@) % سلوت المعالي ان سلوتك ساعة % % وما انا الا مغرم بالعلى صب % % PageV01P253 البحر : طويل 1(@)(@@) % يقر بعيني ان ارى لك منزلا % بنعمان يزكو تربه ويطيب % % 2(@)(@@) % وأرضا بنوار الأقاحي صقيلة % تردد فيها شمأل وجنوب % 3(@)(@@) % واي حبيب غيب الناءي شخصه % % وحال زمان دونه وخطوب % 4(@)(@@) % تطاولت الاعلام بيني وبينه % % واصبح نائي الدار وهو قريب % % 5(@)(@@) % لك الله من مطلولة القلب بالهوى % % قتيلة شوق ، والحبيب غريب % 6(@)(@@) % أقل سلامي إن رأيتك خيفة % وأعرض كيما لا يقال مريب % 7(@)(@@) % واطرق والعينان يومض لحظها % % إليك ، وما بين الضلوع وجيب % 8(@)(@@) % يقولون مشغوف الفؤاد مروع % % ومشغوفة تدعو به فيجيب % 9(@)(@@) % وما علموا انا إلى غير ريبة % % بقاء الليالي نغتدي ونؤب % % 10(@)(@@) % عفافي من دون التقية زاجر % وصونك من دون الرقيب رقيب % PageV01P254 11(@)(@@) % عشقت ومالي يعلم الله حاجة % % سوى نظري والعاشقون ضروب % % 12(@)(@@) % وما لي يالمياء بالشعر طائل % % سوى ان اشعاري عليك نسيب % % 13(@)(@@) % أحبك حبا لو جزيت ببعضه % أطاعك مني قائد وجنيب % 14(@)(@@) % وفي القلب داء في يديك 
ms78	 دواؤه % % إلا رب داء لا يراه طبيب % 15(@)(@@) % سرى لك من اوطانه كل عارض % % تضاحك فيه البرق وهو قطوب % 16(@)(@@) % ولا زال خفاق النسيم مرقرقا % عليك ، وأنواء الغمام تصوب % PageV01P255 البحر : طويل 1(@)(@@) % أغيب فأنسى كل شيء سوى الهوى % % وان فجعتني بالحبيب النوائب % % 2(@)(@@) % ولا زاد يوم البين إلا صبابة % فلا الشوق منسي ولا الدمع ناضب % % 3(@)(@@) % احن اذا حنت ركابي وفي الحشا % % بلابل لا تعيا بهن النجائب % % 4(@)(@@) % فعندي اشتياق ما يحن اخو الهوى % % وعندي لغوب ما تحن الركائب % % 5(@)(@@) % وإني لأرعى من وداد أحبتي % % علي بعد ما لا تراعي الاقارب % % PageV01P256 البحر : سريع 1(@)(@@) % هل ناشد لي بعقيق الحمى % % غزيلا مر على الركب % 2(@)(@@) % افلت من قانصه غرة % % وعاد بالقلب إلى السرب % % 3(@)(@@) % وأظمأ القلب إلى مالك % لا يحسن العدل على القلب % % 4(@)(@@) % يعجب من عجبي به في الهوى % % واعجبي منه ومن عجبي % % 5(@)(@@) % أقرب بالود ، وينأى به % ويلي على بعدك من قرب % 6(@)(@@) % منعم يعطف منه الصبا % % لعب الصبا بالغصن الرطب % % 7(@)(@@) % بلادة النعمة في طبعه % وربما ناقش في الحب % % 8(@)(@@) % اما اتقى الله على ضعفه % % معذب القلب بلا ذنب % 9(@)(@@) % يا ماطلا لي بديون الهوى % % من دل عينيك على قلبي % % PageV01P257 البحر : وافر تام 1(@)(@@) % رماني كالعدو يريد قتلي % % فغالطني وقال انا الحبيب % % 2(@)(@@) % وانكرني فعرفني اليه % % لظى الأنفاس والنظر المريب % 3(@)(@@) % وقالوا لم اطعت وكيف اعصي % % أميرا من رعيته القلوب % PageV01P258 البحر : كامل تام 1(@)(@@) % وشممت في طفل العشية نفحة % % حبست برامة صحبتي وركابي % % 2(@)(@@) % متململين على الرحال كأنما % % مروا ببعض منازل الاحباب % % 3(@)(@@) % ذكرت لي الارب القديم من الهوى % % عهد الصبا وليالي الاطراب % % 4(@)(@@) % فبعثت دمعي ثم قلت لصاحبي : % ايه دموعك يا أبا الغلاب % % 5(@)(@@) % في ساعة لما التفت إلى الصبا % % بعدت مسافته على الطلاب % % 6(@)(@@) % وتأرجت منها زلازل ريطتي % % حتى تعهارف طيبها اصحابي % % 7(@)(@@) % فكانما استعقبت فارة تاجر % % وبعثت فضلتها إلى أثوابي % % 8(@)(@@) % اشكو اليك ومن هواك شكايتي % % ويهون عندك أن أبيت كما بي % % 9(@)(@@) % يا ماطلي 
ms79	 بالدين وهو محبب % % من لي بدائم وعدك الكذاب % % PageV01P259 البحر : خفيف تام 1(@)(@@) % اي عيد من الهوى عاد قلبي % % بعد ما جعجع الدجا بالركب % % 2(@)(@@) % لو دعاني من غير ارضك داع % % لغرام لكنت غير ملبي % % 3(@)(@@) % اين ظبي بذي النقا يوقد النا % % ر عشاءبالمندليالرطب % % 4(@)(@@) % كلما اخمدت زهاها بضوء الحسن % % من جيده وضوء القلب % % 5(@)(@@) % سكن الهضب من قبا فوجدنا % % اثرا للهوى بذاك الهضب % % 6(@)(@@) % ليت أحبابنا ، وقد أشرقونا % % سوغونا برد الزلال العذب % 7(@)(@@) % يا لها نظرة على الشعب دلت % غرورا على غزال الشعب % % 8(@)(@@) % قسموا السوء بين عيني وقلبي % % لم جنى ناظري فعذب قلبي % % PageV01P260 البحر : طويل 1(@)(@@) % ألا أيها الركب اليمانون عهدكم % % على ما أرى ، بالأبرقين قريب % 2(@)(@@) % وان غزالا جزتم بكناسه % % على النأي عندي والمطتال حبيب % % 3(@)(@@) % ولما التقينا دل قلبي على الجوى % % دليلان : حسن في العيون وطيب % 4(@)(@@) % ولي نظرة لا تملك العين أختها % % مخافة يثنوها علي رقيب % % 5(@)(@@) % وهل بنفعني اليوم دعوى برائة % % لقلبي ولحظي يا اميم مريب % % 6(@)(@@) % وأنهلني في القعب فضل غبوقه % خليطان : ريق بارد وضريب % 7(@)(@@) % ولو نفضت تلك الثنيات بردها % % على الصبر الممرور كاد يطيب % 8(@)(@@) % فيا برد ماء ذاب ما ذيق برده % % بلى ان لي قلبا عليه يذوب % % PageV01P261 البحر : سريع 1(@)(@@) % يا ريم ذا الأجرع يرعى به % ثمار قلبي بدل الرطب % % 2(@)(@@) % هناك شرب الدمع من ناظري % % يا مشرقي بالبارد العذب % % 3(@)(@@) % انتا على البعد همومي اذا % % غبت ، وأشجاني على القرب % 4(@)(@@) % لا أتبع القلب إلى غيركم % عيني لكم عين على قلبي % % PageV01P262 البحر : كامل تام 1(@)(@@) % لا يبعدن الله برد شبيبة % ألقيته بمنى ، ورحت سليبا % % 2(@)(@@) % شعر صحبت به الشباب غرانقا % % والعيش مخضر الجناب رطيبا % % 3(@)(@@) % بعد الثلاثين انقراض شبيبة % عجبا اميم لقد رأيت عجيبا % % 4(@)(@@) % قد كان لي قططا يزين لمتي % % شروى السنان يزين الأنبوبا % % 5(@)(@@) % فاليوم اطلب الهوى متكلفا % حصرا والقي الغانيات مريبا % % 6(@)(@@) % اما بكيت على الشباب فانه % % قد كان عهدي بالشباب قريبا % % 7(@)(@@) % لو كان يرجع ميت بتفجع 
ms80	 % % وجوى شققت على الشباب جيوبا % % 8(@)(@@) % وائن حننت إلى منى من بعدها % % فلقد دفنت بها الغداة حبيبا % % PageV01P263 البحر : كامل تام 1(@)(@@) % ولقد مررت على ديارهم % وطلولها بيد البلى نهب % % 2(@)(@@) % فوقفت حتى ضج من لغب % % نضوي ولج بعذلي الركب % % 3(@)(@@) % وتلفتت عيني ، فمذ خفيت % عنها الطلول تلفت القلب % % PageV01P264 البحر : كامل تام 1(@)(@@) % ولق اكون من الغواني مرة % % بأعز منزلة الحبيب الأقرب % 2(@)(@@) % اقتادهن بفاحم متخايل % % فيريبني ويرين لي ويزين بي % % 3(@)(@@) % واذا دعوت اجبن غير شوامس % % زفف النياق إلى رغاء المصعب % 4(@)(@@) % فاليوم يلوين الوجوه صوادفا % صد الصحاح عن الطلي الاجرب % % 5(@)(@@) % واذا لطفت لهن قال عواذلي % % ذئب الغضاة يريغ ود الربرب % % 6(@)(@@) % فلئن فجعت بلمة فينانة % مات الشباب بها ولما يعقب % % 7(@)(@@) % فلقد فجعت بكل فرع باذخ % من عيص مدركة الأعز الأطيب % 8(@)(@@) % قومي تقارعت السنون عليهم % فثلمن كل فتى كحد المقضب % % 9(@)(@@) % شعبا مفرقة يطير فضاضها % % كالقعب منصدعا ولما يرأب % % 10(@)(@@) % هتف الردى بجميعهم فتتابعوا % % طلق العطاس بني أب وبني أب % PageV01P265 11(@)(@@) % وردوا واني بعدهم كظمية % % تسل القوارب عن بلوغ المشرب % % 12(@)(@@) % طرق الزمان بكل خطب بعدهم % % فإذا رأيت عجيبة لم أعجب % PageV01P266 البحر : وافر تام 1(@)(@@) % غدا في الجيرة الغادين لبي % % جميعا ، ثم راجعني وثابا % % 2(@)(@@) % لئن فارقتهم وبقيت حيا % % لقد فارقت بعدهم الشبابا % % PageV01P267 البحر : وافر تام 1(@)(@@) % تمل من التصابي حين تمسي % % ولا أمم صباك ، ولا قريب % 2(@)(@@) % سواد الراس سلم للتصابي % % وبين البيض والبيض الحروب % 3(@)(@@) % وولاك الشباب على الغواني % % فبادر قبل يعزلك المشيب % % PageV01P268 البحر : كامل تام 1(@)(@@) % الدمع مذ بعد الخليط قريب % % والشوق يدعو ، والزفير يجيب % 2(@)(@@) % ما كنت اعلم ان يوم فراقكم % % تبقي علي نواظر وقلوب % % 3(@)(@@) % إن لم تكن كبدي غداة وداعكم % % ذابت فاعلم انها ستذوب % % 4(@)(@@) % داء طلبت له الاساة فلم يكن % % إلا التعلل بالدموع طبيب % 5(@)(@@) % اما اقمت فان دمعي غالب % % لعواذلي ، وتجلدي مغلوب % 6(@)(@@) % ابقوا عليلا بعدهم لا برؤه % % يجى ولا الامال فيه تخيب % % 7(@)(@@) % كطريد يوم الورد طال هيامه 