ms1561	 الثقات لأن في رواية الضعفاء عنه مناكير كثيرة.(@)(@@)(@@)(@@) ||| AUTO عمران بن إسحاق، أبو مروان(@)(@@) شيخ، يروي عن شعبة بن الحجاج، روى عنه إسماعيل بن عياش، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عمران بن عبد الله البصري(@)(@@) يروي عن الحكم بن أبان، روى عنه إسحاق بن أبي إسرائيل.(@)(@@)(@@)(@@) ||| AUTO عمران بن موسى(@)(@@) شيخ، يروي عن سفيان الثوري.(@)(@@) (641) -[5: 358] حدثنا أحمد بن يحيى بن زهير، ثنا معمر بن سهل، ثنا عمران بن موسى، ثنا سفيان، عن المغيرة، عن أبي الأحوص، عن عبد الله، عن النبي صلى الله عليه وسلم: أنه كان يسلم عن يمينه وعن يساره: السلام عليكم ورحمة الله، السلام عليكم ورحمة الله(@)(@@)(@@)(@@) ||| AUTO عمران بن الجارود(@)(@@) من بني الحارث بن عباد، يروي عن أسيد بن طارق عن أمه عن عائشة، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عمران بن هارون، أبو موسى الصوفي(@)(@@) من أهل الرملة، وهو الذي يقال له: عمران بن أبي عمران، يروي عن أبي خالد الأحمر وأهل العراق، روى عنه أبو نشيط محمد بن هارون وأهل الشام، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO عمران بن أبي جميل الدمشقي(@)(@@) يروي عن ابن عيينة وابن أبي الرجال، حدثنا عنه الحسن بن سفيان الشيباني وغيره، مات سنة أربع وأربعين ومائتين.(@)(@@) (642) -[5: 358] حدثنا محمد بن المعافى العابد بصيداء، ثنا عمران بن أبي جميل، ثنا إسماعيل بن سماعة، ثنا الأوزاعي، عن محمد بن المنكدر، عن جابر: أن الترك من رسول الله صلى الله عليه وسلم الوضوء مما مست النار PageV01P002 [ج 5: ص 359](@)(@@)(@@)(@@) ||| AUTO عمران بن ميسرة(@)(@@) من أهل البصرة، يروي عن عبد الوارث بن سعيد، حدثنا عنه أبو خليفة.(@)(@@)(@@)(@@) ||| AUTO عمران بن موسى القزاز(@)(@@) من أهل البصرة، يروي عن عبد الوارث بن سعيد والبصريين، حدثنا عنه شيوخنا وغيره.(@)(@@)(@@)(@@) ||| AUTO عمران بن محمد، أبو عاصم(@)(@@) مولى الأنصار، يروي عن مالك بن سعير بن الخمس، حدثنا عنه محمد بن أحمد بن علي الحواري بالموصل.(@)(@@)(@@)(@@) ||| AUTO عقبة بن عمار العبسي(@)(@@) من أهل الكوفة، يروي المقاطيع، روى عنه ابن المبارك.(@)(@@)(@@)(@@) ||| AUTO عقبة بن سنان(@)(@@) يروي عن أبي خالد 
ms1562	 الدالاني، روى عنه عبد السلام بن حرب.(@)(@@)(@@)(@@) ||| AUTO عقبة بن مسروق(@)(@@) يروي عن ميسرة، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO عقبة بن أسيد(@)(@@) يروي عن نعمان بن بشير عن نائلة، روى عنه يحيى بن راشد.(@)(@@)(@@)(@@) ||| AUTO عقبة بن نافع(@)(@@) يروي عن خالد بن يزيد، روى عنه ابنه وهب بن عقبة.(@)(@@)(@@)(@@) ||| AUTO عقبة بن موسى(@)(@@) من أهل بغداد، يروي عن محمد بن الفضل بن عطية، روى عنه ابنه موسى بن عقبة بن موسى.(@)(@@)(@@)(@@) ||| AUTO عقبة بن مكرم الضبي(@)(@@) يروي عن قدامة بن حماطة، روى عنه محمد بن ربيعة.(@)PageV01P002(@)(@@) [ج 5: ص 360](@)(@@)(@@)(@@) ||| AUTO عقبة بن المغيرة، أبو العلاء الشيباني(@)(@@) من أهل الكوفة، يروي عن أبي إسحاق السبيعي، روى عنه محمد بن عقبة السدوسي.(@)(@@)(@@)(@@) ||| AUTO عقبة بن علقمة البيروتي(@)(@@) يروي عن الأوزاعي، روى عنه العباس بن الوليد بن مزيد وأهل الشام، يعتبر حديثه من غير رواية ابنه محمد بن عقبة عنه لأن محمدا كان يدخل عليه الحديث ويجيب فيه.(@)(@@)(@@)(@@) ||| AUTO عقبة بن قبيصة بن عقبة(@)(@@) يروي عن أبيه وعبيد الله بن موسى، روى عنه الحضرمي وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عقبة بن مكرم العمي المالكي، أبو عبد الملك الهلالي(@)(@@) من أهل البصرة، يروي عن ابن أبي عدي والبصريين، حدثنا عنه شيوخنا الحسين بن عبد الله وهو عقبة بن مكرم بن أفلح بن جراد فيما قيل، مات سنة خمسين ومائتين أو قبلها بقليل أو بعدها بقليل.(@)(@@)(@@)(@@) ||| AUTO عامر بن شفي(@)(@@) يروي عن عبد الكريم الجزري، روى عنه عبيد الله بن عمرو الرقي.(@)(@@)(@@)(@@) ||| AUTO عامر بن يحيى(@)(@@) يروي عن حميد بن أبي حميد، روى عنه حفص بن عبيد الله قاضي بلقاء.(@)(@@)(@@)(@@) ||| AUTO عامر بن مدرك الحارثي(@)(@@) يروي عن مالك بن مغول والثوري، روى عنه معمر بن سهل والأهوازي وعمر بن شيبة، ربما أخطأ.(@)PageV01P002(@)(@@) [ج 5: ص 361](@)(@@)(@@)(@@) ||| AUTO عامر بن صالح بن رستم بن أبي عامر الخزاز، كنيته أبو بكر المزني(@)(@@) من أهل البصرة، يروي عن أبيه وأيوب بن موسى، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عامر بن يساف 
ms1563	(@)(@@) وقد قيل: أساف، يروي عن يحيى بن أبي كثير، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عامر بن الفرات، أبو عمرو الذهلي(@)(@@) من أهل الشام، يروي عن شعبة وابن أبي ذئب، روى عنه عمار بن الحسن الهمداني.(@)(@@)(@@)(@@) ||| AUTO عامر بن خداش(@)(@@) يروي عن شريك، روى عنه ابنه عمرو بن عامر ومحمود بن غيلان.(@)(@@)(@@)(@@) ||| AUTO عامر بن سيار النجليني(@)(@@) من أهل الشام، يروي عن أبي معشر نجيح السندي وأهل العراق والحجاز، حدثنا عنه الحسن بن عبد الله القطان وغيره، ربما أغرب.(@)(@@)(@@)(@@) ||| AUTO العلاء بن المنهال العنبري(@)(@@) من أهل الكوفة، يروي عن عاصم بن كليب، روى عنه أبو أسامة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO العلاء بن راشد الواسطي الجرمي(@)(@@) يروي عن حلام بن صالح، روى عنه يزيد بن هارون.(@)(@@) العلاء بن راشد الواسطي(@)(@@) مولى يونس، يروي عن منصور بن زاذان، روى عنه موسى بن إسماعيل، وليس هذا بالعلاء بن خالد البصري، ذاك واه، وقد روى التبوذكي عنهما، فذكرناه في كتاب الضعفاء.(@)(@@)(@@)(@@) ||| AUTO العلاء بن برد بن سنان(@)(@@) يروي عن أبيه، روى عنه الحسن بن محمد بن الصباح وأهل العراق.(@)PageV01P002(@)(@@) [ج 5: ص 362](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO العلاء بن حصين(@)(@@) يروي عن أبي حنيفة، روى عنه يوسف بن واقد.(@)(@@)(@@)(@@) ||| AUTO العلاء بن صالح التيمي(@)(@@) يروي عن المنهال بن عمرو، روى عنه أبو أحمد الزبيري.(@)(@@) العلاء(@)(@@) ابن أخي شعيب الوزان، يروي المقاطيع، روى عنه شعبة بن الحجاج.(@)(@@)(@@)(@@) ||| AUTO العلاء بن محمد(@)(@@) شيخ، يروي عن محمد بن عمرو، روى عنه أهل البصرة.(@)(@@) (643) -[5: 362] حدثنا محمد بن علي الصيرفي بالبصرة، ثنا عثمان بن طالوت بن عباد الجحدري، ثنا العلاء بن محمد، عن محمد بن عمرو، عن أبي سلمة، عن أبي هريرة، قال: قال رسول الله صلى الله عليه وسلم: من صام رمضان وقامه إيمانا واحتسابا غفر له ما تقدم من ذنبه(@)(@@)(@@)(@@) ||| AUTO العلاء بن عصيم(@)(@@) من أهل الكوفة، كنيته أبو عبد الله كان مؤذن مسجد حسين الجعفي، يروي عن زهير بن معاوية وحماد بن زيد، روى عنه العراقيون، مات سنة خمس ومائتين.(@)(@@)(@@)(@@) ||| AUTO العلاء 
ms1564	 بن عبد الجبار(@)(@@) مولى الأنصار، من أهل البصرة، كنيته أبو الحسن، سكن مكة، يروي عن حماد بن سلمة وأبي عوانة، روى عنه ابنه عبد الجبار بن العلاء، مات سنة ثنتي عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO العلاء بن المبارك، أبو محمد الرواسي(@)(@@) من أهل الكوفة، يروي عن حفص بن غياث، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO العلاء بن حصين، أبو حصين(@)(@@) يروي عن سفيان بن عيينة، روى عنه أهل العراق.(@)PageV01P002(@)(@@) [ج 5: ص 363](@)(@@)(@@)(@@) ||| AUTO العلاء بن هارون(@)(@@) يروي عن يزيد بن هارون، روى عنه حسان بن حسان.(@)(@@)(@@)(@@) ||| AUTO العلاء بن بشر(@)(@@) شيخ، يروي عن ابن عيينة، روى عنه جعدية بن يحيى المناكير.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عمرو الحنفي(@)(@@) من أهل الكوفة، يروي عن عبد الله بن إدريس، روى عنه الحسين بن إسحاق التستري، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO عطاء بن صالح بن عطاء(@)(@@) يروي عن أبيه عن الحسن، روى عنه علي بن حمزة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن عثمان القرشي(@)(@@) يروي المقاطيع، روى عنه عفيف بن سالم.(@)(@@)(@@)(@@) ||| AUTO العلاء بن عطاء بن عبد الرحمن(@)(@@) يروي عن حبيب العجمي، روى عنه عمر بن أبي خليفة.(@)(@@)(@@)(@@) ||| AUTO عطاء بن نقادة الأسدي(@)(@@) يروي عن عيينة بن عاصم، روى عنه يعقوب بن محمد بن الزهري.(@)(@@)(@@)(@@) ||| AUTO عطاء بن جبلة(@)(@@) يروي عن منصور بن زاذان، روى عنه محمد بن مخراق الفريابي.(@)(@@)(@@)(@@) ||| AUTO عطاء بن السائب بن محمد بن عطاء بن أبي السائب الكناني ثم الليثي(@)(@@) من أهل مرو، يروي عن ابن المبارك وأقرانه، روى عنه ابنه أبو صالح منصور بن عطاء بن السائب، ومات عطاء سنة أربع عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO عطاء بن محمد الحراني(@)(@@) من عباد أهل الثغر وقرائهم، روى عنه أحمد بن حنبل الحكايات.(@)PageV01P002(@)(@@) [ج 5: ص 364](@)(@@)(@@)(@@) ||| AUTO عاصم بن عمر بن عبد العزيز بن مروان القرشي(@)(@@) يروي عن أبيه، روى عنه برد أبو العلاء وحماد الأبح.(@)(@@)(@@)(@@) ||| AUTO عاصم بن نسيب النخعي(@)(@@) يروي عن طلحة بن مصرف عن إبراهيم بن يزيد النخعي، روى عنه شعبة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عبد العزيز الأشجعي(@)(@@) يروي عن الحارث بن عبد 
ms1565	 الرحمن، روى عنه إسحاق بن موسى الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عاصم بن أبي بكر الزهري، كنيته أبو ضمرة(@)(@@) من أهل المدينة، يروي عن مالك وعبد الرحمن بن زيد بن أسلم الحكايات في الرقائق، روى عنه الحسن بن عبد العزيز الجروي.(@)(@@)(@@)(@@) ||| AUTO عاصم بن هبيرة(@)(@@) يروي عن المغيرة بن مقسم قوله، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO عاصم بن بشر بن أنس(@)(@@) يروي عن أبيه، روى عنه مهدي بن ميمون.(@)(@@)(@@)(@@) ||| AUTO عاصم بن حكيم، أبو محمد(@)(@@) يروي عن يحيى بن أبي عمرو السيباني، روى عنه ابن وهب وأيوب بن سويد.(@)(@@)(@@)(@@) ||| AUTO عاصم بن سيار الرقاشي(@)(@@) يروي عن كثير عن ابن المسيب، روى عنه موسى بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عاصم بن مهجع الأسدي(@)(@@) يروي عن مالك بن أنس، روى عنه العباس بن عبد العظيم العنبري.(@)(@@)(@@)(@@) ||| AUTO عاصم بن يوسف اليربوعي التميمي، كنيته أبو عمر(@)(@@) من أهل PageV01P002 [ج 5: ص 365] الكوفة، يروي عن قطبة بن عبد العزيز والكوفيين، روى عنه إبراهيم بن يعقوب الجوزجاني.(@)(@@)(@@)(@@) ||| AUTO عاصم بن يزيد العمري(@)(@@) يروي عن ابن عيينة وسليم بن مسلم، روى عنه محمد بن مسلم بن مبارك، ربما أغرب.(@)(@@)(@@)(@@) ||| AUTO عاصم بن علي بن عاصم، أبو الحسن(@)(@@) يروي عن شعبة وابن أبي ذئب، روى عنه أبو زرعة الرازي، مات سنة إحدى وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عاصم بن النضر الأحول(@)(@@) من أهل البصرة، يروي عن المعتمر بن سليمان والبصريين، حدثنا عنه عبدان بمعسكر مكرم وغيره من شيوخنا.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عباس الهذلي(@)(@@) من أهل البصرة، يروي عن عبد الوهاب الثقفي، روى عنه أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عاصم بن عمر بن علي المقدمي(@)(@@) يروي عن أبيه، ثنا أبو يعلى، ثنا عاصم بن عمر بن علي بن مقدم فذكر، حدثنا.(@)(@@)(@@)(@@) ||| AUTO عتبة بن ضمرة بن حبيب بن صهيب الزبيدي(@)(@@) من أهل الشام، يروي عن أبيه، روى عنه أحمد بن أبي يافع الموصلي.(@)(@@)(@@)(@@) ||| AUTO عتبة بن أبان بن صمعة(@)(@@) الذي يعرف بعتبة الغلام، من عباد أهل البصرة وقرائهم، له حكايات عجيبة في الرقائق، يروي عن عبد الواحد بن زيد 
ms1566	 وشميط بن عجلان، روى عنه أهل البصرة، ما له حديث مسند يرجع إليه.(@)PageV01P002(@)(@@) [ج 5: ص 366](@)(@@)(@@)(@@) ||| AUTO عتبة أبو أمية الدمشقي(@)(@@) يروي عن معاوية، روى عنه معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO عتبة بن تميم التنوخي(@)(@@) يروي عن الوليد بن عامر اليزني، روى عنه إسماعيل بن عياش.(@)(@@)(@@)(@@) ||| AUTO عتبة بن عبد الله بن خالد بن معدان(@)(@@) يروي عن أبيه عن جده، روى عنه بقية بن الوليد.(@)(@@)(@@)(@@) ||| AUTO عتبة بن عبد الملك السهمي(@)(@@) يروي عن زرارة بن كريم، روى عنه عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO أبو خليد اسمه عتبة بن حماد الحكمي القارئ(@)(@@) إمام مسجد دمشق، يروي عن الأوزاعي والزبيدي، روى عنه هشام بن خالد الأزرق، وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO عتبة بن علي بن مسلم، أبو الحسن السكوني(@)(@@) من أهل حمص كان في سوق البز بها، يروي عن معاوية بن يحيى الصدفي، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عتبة بن السكن(@)(@@) من أهل الشام، يروي عن الأوزاعي، روى عنه عمران بن بكار الحمصي وموسى بن سهل الرملي، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO عتبة بن سعيد بن حبان الرحض(@)(@@) من أهل حمص، يروي عن إسماعيل بن عياش والشاميين، روى عنه إبراهيم بن سعيد الجوهري وعثمان بن سعيد الدارمي.(@)(@@)(@@)(@@) ||| AUTO عتبة بن عبد الله بن عتبة اليحمدي، أبو عبد الله(@)(@@) من أهل مرو، يروي عن PageV01P002 [ج 5: ص 367] مالك بن أنس وأبي غانم يونس بن نافع، حدثنا عنه إسحاق بن إبراهيم بن إسماعيل، وغيره من شيوخنا.(@)(@@)(@@)(@@) ||| AUTO عياش بن يونس، أبو معاذ الشامي(@)(@@) يروي عن نمران بن عتبة، روى عنه أهل الشام.(@)(@@)(@@)(@@) ||| AUTO عياش بن الوليد، أبو الوليد الرقام(@)(@@) من أهل البصرة، يروي عن عبد الأعلى بن عبد الأعلى والبصريين، روى عنه محمد بن يحيى الذهلي والبخاري محمد بن إسماعيل.(@)(@@)(@@)(@@) ||| AUTO عمير بن عبد الرحمن(@)(@@) يروي عن عمرو بن عبد العزيز، روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO عمير بن عبد المجيد، أبو المغيرة الحنفي(@)(@@) من أهل البصرة، يروي عن شعبة، روى عنه أهل العراق، وهو أخو أبي بكر وأبي 
ms1567	 علي الحنفيين.(@)(@@)(@@)(@@) ||| AUTO عمير بن عمار الصائدي(@)(@@) يروي عن إبراهيم بن سعد، روى عنه الكوفيون.(@)(@@)(@@)(@@) ||| AUTO عمير بن مرداس الزريقي، من نهاوند(@)(@@) يروي عن أبي نعيم وأهل العراق، روى عنه أهل بلده، يغرب.(@)(@@)(@@)(@@) ||| AUTO عباس بن غزوان(@)(@@) يروي عن عمر بن عبد العزيز، روى عنه ضمرة بن ربيعة.(@)(@@)(@@)(@@) ||| AUTO عباس بن أبي شملة(@)(@@) مولى طلحة بن عمر بن عبيد الله بن معمر التيمي، يروي عن موسى بن يعقوب الزمعي ومالك بن أنس، كنيته أبو الفضل، من أهل المدينة، روى عنه إبراهيم بن المنذر الحزامي.(@)(@@)(@@)(@@) ||| AUTO عباس بن جعفر بن طلق بن زيد الشني العبدي(@)(@@) من أهل البصرة، يروي عن PageV01P002 [ج 5: ص 368] أبيه، روى عنه نصر بن علي الجهضمي.(@)(@@)(@@)(@@) ||| AUTO عباس بن طالب الأزدي البصري، أبو الفضل(@)(@@) سكن مصر، يروي عن حماد بن زيد، روى عنه محمد بن داود بن ناجية وأهل مصر، مات سنة سبع عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO عباس بن الوليد، أبو الفضل البصري(@)(@@) يروي عن شعبة وهمام، روى عنه صالح بن زياد السوسي أبو شعيب وعمر بن عثمان الحمصي.(@)(@@)(@@)(@@) ||| AUTO عباس بن الوليد بن حماد القرشي، أبو الفضل(@)(@@) من أهل البصرة، يروي عن يحيى بن سعيد والبصريين، حدثنا عنه الحسن بن سفيان وأبو يعلى، وهو ابن أخي عبد الأعلى بن حماد النرسي.(@)(@@)(@@)(@@) ||| AUTO عباس بن الفضل الأزرق العبدي(@)(@@) من أهل البصرة، يروي عن السري بن يحيى، روى عنه يعقوب بن سفيان، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO عباس بن الفضل القيسي(@)(@@) من أهل البصرة، يروي عن عبد الوارث بن سعيد والبصريين، روى عنه أحمد بن منصور الرمادي.(@)(@@)(@@)(@@) ||| AUTO عباس بن الحسين البغدادي(@)(@@) يروي عن مبشر بن إسماعيل والشاميين، روى عنه محمد بن إسماعيل، مات قريبا من سنة أربعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عباس بن عثمان البجلي، أبو الفضل(@)(@@) المكتب، من أهل دمشق، يروي عن عراك بن خالد عن إبراهيم بن أبي عبلة، حدثنا عنه عمرو بن سعيد بن سنان الطائي PageV01P002 [ج 5: ص 369] وغيره، مات سنة تسع وثلاثين ومائتين، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد 
ms1568	 العظيم العنبري، أبو الفضل(@)(@@) من أهل البصرة، يروي عن يزيد بن هارون وعبد الرزاق، حدثنا عنه إسحاق بن إبراهيم القاضي وغيره، مات سنة ست وأربعين ومائتين، وكان من عقلاء الناس.(@)(@@)(@@)(@@) ||| AUTO عباس بن الفضل بن أبي روح الحلبي(@)(@@) يروي عن أسباط بن محمود وابن نمير، حدثنا عنه ابن ناجية، مات بحران سنة إحدى وستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عباس بن يزيد بن أبي حبيب البحراني، أبو الفضل(@)(@@) عداده في أهل البصرة، يعرف بعباسويه، وكان على القضاء بهمدان، يروي عن ابن عيينة وابن أبي عدي وابن علية والبصريين، حدثنا عنه علي بن أحمد بن سعيد وغيره، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO عباس بن الضحاك، أبو الفضل(@)(@@) من أهل بلخ، يروي عن مكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عباس بن محمد بن يونس(@)(@@) من أهل بلخ، يروي عن المكي بن إبراهيم، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO عباس بن بكار(@)(@@) من أهل البصرة، كنيته أبو الوليد، يروي عن أبي بكر الهذلي وأهل البصرة وأهل البصرة، يروي عنه محمد بن زكريا العلاني وغيره، من أهل بلده، مات بالبصرة وهو ابن ثلاث وتسعين سنة، وكان يغرب حديثه عن الثقات، لا بأس به.(@)(@@)(@@)(@@) ||| AUTO عباس بن الوليد بن صبح السلمي(@)(@@) من أهل دمشق، يروي عن عبد PageV01P002 [ج 5: ص 370] الجبار بن عطاء عن معمر، مستقيم الأمر في الحديث، حدثنا عنه الحسين بن سفيان وغيره.(@)(@@)(@@)(@@) ||| AUTO عباس بن الوليد بن مزيد العذري، أبو الفضل(@)(@@) من أهل بيروت، يروي عن شعيب بن إسحاق ومحمد بن شعيب بن شابور، حدثنا عنه مكحول وغيره، وكان من خيار عباد الله من المتقنين في الروايات، كان مولده في رجب سنة تسع وستين ومائة، ومات سنة سبعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عباس بن إسماعيل المقرئ(@)(@@) من أهل بغداد، سكن الشام، يروي عن علي بن مسهر، روى عنه أهل الجزيرة.(@)(@@)(@@)(@@) ||| AUTO عباس بن عبد الله الترقفي، أبو الفضل الباكسائي(@)(@@) يروي عن يزيد بن هارون، ثنا عنه عبد الله بن قحطبة وغيره.(@)(@@)(@@)(@@) ||| AUTO عباس بن الفضل الرياشي، أبو الفضل(@)(@@) من 
ms1569	 أهل البصرة، يروي عن أبي عاصم، وكان راويا للأصمعي، حدثنا عنه إسحاق بن إبراهيم القاضي وغيره، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عباس بن محمد بن حاتم بن واقد الدوري، أبو الفضل(@)(@@) من أهل بغداد، يروي عن الأنصاري وعبيد الله بن موسى، حدثنا عنه محمد بن المنذر بن سعيد وغيره، مات سنة إحدى وسبعين ومائتين ببغداد.(@)(@@)(@@)(@@) ||| AUTO عباس بن أبي طالب، أبو محمد(@)(@@) من أهل بغداد، يروي عن أبي عاصم وأبي نعيم، حدثنا عنه محمد بن إسحاق بن إبراهيم الثقفي، واسم أبي طالب جعفر بن الزبرقان البزار.(@)(@@)(@@)(@@) ||| AUTO عباس بن سفيان الدبوسي(@)(@@) يروي عن الفضيل بن عياض الحكايات، روى عنه عبد الله بن عبد الرحمن الدارمي السمرقندي، ما أراه سمع من الفضيل، وذاك أنه ربما PageV01P002 [ج 5: ص 371] أدخل بينه وبين الفضل الحسن بن جعفر البخاري، فإن صح سماعه من الفضيل فهو من هذه الطبقة وإلا تحول إلى الطبقة الخامسة.(@)(@@)(@@)(@@) ||| AUTO عباس بن صالح بن علي بن مساور(@)(@@) مولى بني أمية، من أهل حران، يروي عن أبي نعيم، حدثنا عنه أبو عروبة، مات سنة أربع وسبعين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عباس بن إسماعيل بن حماد البغدادي(@)(@@) مولى بني هاشم، يروي عن أبي الوليد ومسلم وأقرانهم، حدثنا عنه ابن قتيبة.(@)(@@)(@@)(@@) ||| AUTO عباس بن مصعب بن بشر المروزي(@)(@@) يروي عن العراقيين وأهل بلده، وكان يتحفظ ممن يتعاطى علم التواريخ والأنساب، عاجله الموت فلم يصنف فيه شيئا، حدثنا عنه ابن أخيه أحمد بن محمد بن مصعب بن بشر بمرو، وكان راويا لمحمد بن شجاع وأبي حمزة وسائر مشايخهم.(@)(@@)(@@)(@@) ||| AUTO عباس بن السندي(@)(@@) من أهل أنطاكية، يروي عن القعنبي والبصريين، حدثنا عنه أبو الطيب الدارمي بأنطاكية.(@)(@@)(@@)(@@) ||| AUTO عباس بن محمد بن عمرو بن الحارث الجمحي، أبو الفضل(@)(@@) يروي عن أبي الوليد الطيالسي، حدثنا عنه محمد بن عبد الرحمن الأصبهاني.(@)(@@)(@@)(@@) ||| AUTO عنبسة العابد(@)(@@) من أهل الكوفة، يروي عن محمد بن جعفر بن محمد، روى عنه زيد بن الحباب.(@)(@@)(@@)(@@) ||| AUTO عنبسة الوراق(@)(@@) يروي عن أبي لبابة، روى عنه يحيى بن سعيد القطان. 
ms1570	(@)(@@)(@@)(@@) ||| AUTO عنبسة بن خالد بن يزيد الأيلي، ابن أخي يونس بن يزيد(@)(@@) يروي عن عمه يونس الأيلي، روى عنه أحمد بن صالح المصري، مات سنة سبع وتسعين ومائة.(@)PageV01P002(@)(@@) [ج 5: ص 372](@)(@@)(@@)(@@) ||| AUTO أبو المنذر المروزي، اسمه عنبسة بن يحيى الزاهد(@)(@@) سكن بيكث، يروي عن يزيد بن هارون وعبد الرزاق وأبي نعيم، روى عنه أهل الشاش، مات سنة إحدى وأربعين ومائتين، وكان ممن ينصر السنة ويذب عنها ويقمع من يخالفها.(@)(@@)(@@)(@@) ||| AUTO عمارة بن عبد الله الأنصاري(@)(@@) أحد بني دينار بن النجار، من أهل المدينة، يروي عن عمار بن مهاجر، روى عنه محمد بن يعقوب بن محمد الزهري.(@)(@@)(@@)(@@) ||| AUTO عمارة الأحمر(@)(@@) يروي عن حبيب بن يسار وحبيب بن يزيد، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO عون بن ذكوان، أبو جناب الحرشي(@)(@@) يروي عن بهز بن حكيم، روى عنه غسان بن مالك ويونس المؤدب، يخطئ ويخالف.(@)(@@)(@@)(@@) ||| AUTO عون بن كهمس بن الحسن(@)(@@) من أهل البصرة، يروي عن أبيه عن عبد الله بن بريدة وعن داود بن مساور، روى عنه خليفة بن خياط العصفري.(@)(@@)(@@)(@@) ||| AUTO عون بن علي بن عبيد الله بن أبي رافع(@)(@@) يروي عن أبيه، عداده في أهل المدينة، روى عنه موسى بن يعقوب الزمعي.(@)(@@)(@@)(@@) ||| AUTO عون بن معمر البجلي(@)(@@) من أهل البصرة، يروي عن إبراهيم الصائغ، روى عنه أبو همام الخاركي وسعيد بن عامر، وكان متقنا ضابطا، يغرب، وكان جار السلام بن أبي مطيع.(@)(@@)(@@)(@@) ||| AUTO عون بن أبي عون القربي(@)(@@) يروي عن حماد بن زيد، روى عنه عمرو بن شبة.(@)(@@)(@@)(@@) ||| AUTO عون بن سلام القرشي(@)(@@) من أهل الكوفة، يروي عن الحسن بن صالح بن حي وقيس بن الربيع وزهير بن معاوية، روى عنه الحضرمي، مستقيم الحديث.(@)PageV01P002(@)(@@) [ج 5: ص 373](@)(@@)(@@)(@@) ||| AUTO عون بن الحكم بن سنان القربي(@)(@@) يروي عن أبيه عن مالك بن دينار، روى عنه هشام السيرافي.(@)(@@)(@@)(@@) ||| AUTO عون بن يزيد المروزي(@)(@@) شيخ، يروي عن أبي معاوية الضرير، حدثنا عنه عبد الله بن محمد السعدي، مستقيم الأمر في الحديث.(@)(@@)(@@)(@@) ||| AUTO عمار بن حفص 
ms1571	 بن عمر بن سعد القرظ(@)(@@) أخو عمر بن حفص، يروي عن أبيه، روى عنه عبد الرحمن بن سعد وابنه محمد بن عمار المؤذن.(@)(@@)(@@)(@@) ||| AUTO عمار بن مالك(@)(@@) كوفي، يروي عن المنهال بن عمرو، روى عنه أبو خالد الدالاني.(@)(@@)(@@)(@@) ||| AUTO عمار بن عبد الله بن يسار(@)(@@) يروي عن أبيه عن عبد الرحمن بن أبي ليلى، روى عنه العباس بن القاسم أبو مريم.(@)(@@)(@@)(@@) ||| AUTO عمار بن سعد بن عمار المخزومي المؤذن(@)(@@) يروي عن عبيدة بن محمد بن عمار بن ياسر، روى عنه علي بن مجاهد.(@)(@@)(@@)(@@) ||| AUTO عمار بن الحسن بن بشر النسائي، أبو الحسن الهمداني(@)(@@) يروي عن جرير بن عبد الحميد وسلمة بن الفضل، حدثنا عنه محمد بن أحمد بن أبي عون وغيره من شيوخنا، كان أصله من الري فانتقل إلى نسا وسكنها، كان مولده سنة تسع وستين ومائة، ومات سنة ثنتين وأربعين ومائتين.(@)(@@) (644) -[5: 373] سمعت أحمد بن محمد بن الحسن النسوي، يقول: سمعت عمار بن الحسن ينشد من قبله:(@)(@@) عمار لا تغفل عن العمل واعمل لنفسك قبل الموت في مهل(@)(@@) وربع عليه فإن الله سايلها وليس ينفعها قول بلا عمل.(@)(@@)(@@)(@@) ||| AUTO عمار بن زربى بن منصور(@)(@@) ابن أخي بشر بن منصور، كنيته أبو المعتمر، من أهل البصرة إمام مسجد عمر بن مرزوق وكان ضريرا، يروي عن البصريين، حدثنا عنه PageV01P002 [ج 5: ص 374] الحسن بن سفيان، يغرب ويخطئ.(@)(@@)(@@)(@@) ||| AUTO عمار بن نصير المروزي(@)(@@) يروي عن أبي سعيد الشرقي عن أبي حمزة عن ابن عباس، روى عنه أهل مرو.(@)(@@)(@@)(@@) ||| AUTO عمار بن عبد الجبار المروزي(@)(@@) مولى بني سعد، كنيته أبو الحسن، يروي عن ورقاء وشعبة، روى عنه أهل بلده، مات بمكة بعد التشريق بيوم سنة إحدى عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO عمار بن طالوت(@)(@@) شيخ، بصري، يروي عن أبي عاصم وابن وهب، حدثنا عبد الرحمن بن محمد بن عبد الرحمن الطهراني بالري، ثنا عمار بن طالوت بن عباد الجحدري، ذاك لم يذكره.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عمار بن عثمان الحلبي(@)(@@) يروي الرقائق، سمع جعفر بن سليمان الضبعي وأهل العراق، 
ms1572	 روى عنه محمد بن الحسين البرجلاني.(@)(@@) عمار بن عثمان(@)(@@) من أهل البصرة، يروي عن عبد الوارث بن سعيد والبصريين، روى عنه حميد بن الربيع الخزاز وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عمار بن هارون المستملي، أبو ياسر(@)(@@) بصري، يروي عن حماد بن سلمة، حدثنا عنه الحسن بن سفيان وغيره، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO عمار بن خالد الواسطي(@)(@@) يروي عن يزيد بن هارون وعلي بن غراب، حدثنا عنه الوليد بن بيان وغيره من شيوخنا، مات سنة ستين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عمار بن رجاء(@)(@@) من أهل إستراباذ، يروي عن يزيد بن هارون، حدثنا عنه أبو نعيم عبد الملك بن محمد بن عدي.(@)PageV01P002(@)(@@) [ج 5: ص 375](@)(@@)(@@)(@@) ||| AUTO عدي بن عبد الرحمن(@)(@@) وليس بالطائي، يروي عن محمد بن عمرو بن علقمة، روى عنه إبراهيم بن طهمان.(@)(@@)(@@)(@@) ||| AUTO عدي بن عبد الحميد(@)(@@) يروي عن عروة بن محمد، روى عنه معمر بن راشد.(@)(@@)(@@)(@@) ||| AUTO عدي بن الفضل(@)(@@) شيخ، يروي عن عمر بن عبد العزيز، روى عنه المعتمر بن سليمان، وليس هذا بصاحب عبد الله بن عمر وأيوب، ذاك مولى بني تيم أدخلناه في الضعفاء.(@)(@@)(@@)(@@) ||| AUTO عصمة بن زامل الطائي(@)(@@) يروي عن أبيه، روى عنه وكيع بن الجراح.(@)(@@)(@@)(@@) ||| AUTO عصمة بن عزرة الفقيمي(@)(@@) من أهل الكوفة، يروي عن المغيرة بن مقسم، روى عنه الحسن بن عمر.(@)(@@)(@@)(@@) ||| AUTO عصمة بن سالم الهنائي(@)(@@) يروي عن أشعث بن جابر الحداني، روى عنه مسلم بن إبراهيم.(@)(@@)(@@)(@@) ||| AUTO عصمة بن عثمان، أبو محمد(@)(@@) شيخ، من أهل جوزجان، يروي عن أبي أسامة، روى عنه أحمد بن سيار، وقال: كان حسن المذهب محبا لأهل الخير.(@)(@@)(@@)(@@) ||| AUTO عصمة بن محمد(@)(@@) شيخ، من أهل سرخس، من أصحاب أبي لبيد، يروي عن ابن عيينة، روى عنه أهل بلده، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عصمة بن المتوكل الحنفي(@)(@@) قاضي شيراز، يروي عن العراقيين وزافر بن سليمان، روى عنه أحمد بن عبد الله بن يوسف الجصاص أبو جعفر بياع الحديد، مستقيم الحديث.(@)PageV01P002(@)(@@) [ج 5: ص 376](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عصمة بن الفضل، أبو الفضل النيسابوري(@)(@@) يروي عن يحيى بن آدم 
ms1573	 وأبي نعيم، حدثنا عنه محمد بن إسحاق الثقفي.(@)(@@) عصمة بن الفضل(@)(@@) شيخ، يروي عن يعلى بن عبيد، روى عنه إبراهيم بن إسحاق الأنصاري، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO عصام بن خالد(@)(@@) شيخ، حمصي، يروي عن ابن ثوبان، روى عنه محمد بن عوف الحمصي أشياء، يغرب عنها فيها.(@)(@@)(@@)(@@) ||| AUTO عصام بن يزيد بن عجلان(@)(@@) مولى مرة الطيب، من أهل الكوفة، سكن أصبهان، ولقب عصام جبر، يروي عن الثوري ومالك بن مغول، روى عنه ابنه محمد بن عصام، يتفرد ويخالف، وكان صدوقا، حديثه عند الأصبهانيين.(@)(@@)(@@)(@@) ||| AUTO عصام بن الحسين، أبو عون(@)(@@) أصله من سمرقند، سكن الجوزجان وبها عقبة، يروي عن جرير وعيسى بن يونس، روى عنه أحمد بن سيار، وكان صاحب سنة، ثبتا في الحديث يتفقه، وكان يخضب رأسه ولحيته.(@)(@@)(@@)(@@) ||| AUTO عصام بن يوسف بن ميمون بن قدامة البلخي(@)(@@) أخو إبراهيم بن يوسف، يروي عن ابن المبارك، روى عنه أهل بلده، وكان صاحب حديث، ثبتا في الرواية، وربما أخطأ، وكنيته أبو عصمة، وكان يرفع يديه عند الركوع وعند رفع الرأس منه، وأخوه إبراهيم بن يوسف كان يرفع، ومات عصام سنة عشر ومائتين.(@)(@@)(@@)(@@) ||| AUTO عصام بن رواد بن الجراح العسقلاني(@)(@@) يروي عن أبيه، حدثنا عنه أصحابنا.(@)(@@)(@@)(@@) ||| AUTO عبادة بن كليب، أبو غسان(@)(@@) يروي عن الثوري والكوفيين، روى عنه أحمد بن عمران الأخنسي ومحمد بن عبادة.(@)PageV01P002(@)(@@) [ج 5: ص 377](@)(@@)(@@)(@@) ||| AUTO عوف بن محمد، أبو غسان المرادي(@)(@@) يروي عن البصريين، روى عنه يحيى بن حكيم المقرئ، مات في النصف من محرم سنة تسع وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO عبادة بن زياد(@)(@@) شيخ، يروي عن شريك بن عبد الله بن أبي زهير، قال: رأيت الحسن بن علي يخضب بالوسمة، روى عنه الحضرمي.(@)(@@)(@@)(@@) ||| AUTO عفان بن جبير(@)(@@) يروي عن أبي حريز، روى عنه جعفر بن عون.(@)(@@)(@@)(@@) ||| AUTO عفان بن مسلم بن عبد الله الصفار، كنيته أبو عثمان(@)(@@) مولى زيد بن ثابت الأنصاري، من أهل البصرة، سكن بغداد، يروي عن شعبة وحماد بن سلمة، روى عنه عبد الله بن أبي عرابة الشاشي وأهل 
ms1574	 العراق، مات سنة عشرين ومائتين ببغداد يوم الخميس لإحدى عشرة ليلة بقيت من ربيع الآخر، قد قيل إنه مولى عروة بن ثابت الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عفان بن سيار الجرجاني(@)(@@) يروي عن ابن عيينة وشريك النخعي والكوفيين، روى عنه عمار بن رجاء الإسترابادي وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO عتاب بن بشير الحراني(@)(@@) مولى لبني أمية، كنيته أبو الحسن، وقد قيل أبو سهل، يروي عن خصيف وعلي بن بديمة، روى عنه إسحاق بن إبراهيم الحنظلي وأهل بلده، مات سنة تسعين ومائة، وكان يخضب رأسه ولحيته بالحناء، وكان ممن يخالف، وقد قيل إن عتابا مات سنة ثمان وثمانين ومائة.(@)PageV01P002(@)(@@) [ج 5: ص 378](@)(@@)(@@)(@@) ||| AUTO عتاب بن حرب بن عبد الله أبو بشر بن ابنة صالح بن رستم(@)(@@) من أهل البصرة، يروي عن جده صالح بن رستم عن أبي مليك، روى عنه إبراهيم بن يعقوب الجوزجاني.(@)(@@)(@@)(@@) ||| AUTO عتاب بن زياد المروزي(@)(@@) يروي عن أبي حمزة وابن المبارك، روى عنه الفضل بن أبي طالب وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO عتاب بن درست(@)(@@) شيخ، بصري، يروي عن عبد الله بن عيسى عن يحيى البكاء عن ابن عمر في الغسل، حدثنا عنه الحسن بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عتاب بن أعين(@)(@@) من أهل الري، يروي عن سفيان الثوري، روى عنه أهل الري.(@)(@@)(@@)(@@) ||| AUTO عتاب بن خليل الأبلي(@)(@@) سكن المنصورة، يروي عن الأنصاري عبيد الله بن موسى.(@)(@@) (645) -[5: 378] حدثنا عنه أحمد بن محمد بن الأزهر يتفرد، ثنا محمد بن عبد الله بن الجنيد، ثنا عتاب بن الخليل بالمنصورة، ثنا عبيد الله بن موسى ابنا أبو جعفر الرازي، عن الربيع بن أنس، في قوله تعالى {ولا تصعر خدك للناس} ولا يكون الغني والفقير عندك في العلم سواء.(@)(@@)(@@)(@@) ||| AUTO عوف بن محمد، أبو غسان المرادي(@)(@@) يروي عن البصريين، روى عنه يحيى بن حكيم المقرئ، مات للنصف من محرم يوم الخميس سنة تسع عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO عفيف بن سالم البجلي(@)(@@) من أهل الموصل، يروي عن الثوري، روى عنه محمد بن عبد الله بن عمار وأهل بلده، مات سنة ثلاث وثلاثين ومائتين، 
ms1575	 وكان من العباد.(@)PageV01P002(@)(@@) [ج 5: ص 379](@)(@@)(@@)(@@) ||| AUTO عبيس بن بيهس(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه البصريون، ربما أخطأ.(@)(@@)(@@)(@@) ||| AUTO عبيس بن مرحوم بن عبد العزيز العطار(@)(@@) مولى آل معاوية بن أبي سفيان، من أهل البصرة، يروي عن أبيه، روى عنه بشر بن عبيس والبصريون، مات سنة سبع عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO عرفجة العابد(@)(@@) من أهل الكوفة، ليس له حديث مسند يرجع إليه، وله الحكايات في التعبد، روى عنه خلف بن نعيم.(@)(@@)(@@)(@@) ||| AUTO عسكر بن إبراهيم بن سعيد، أبو سعيد المروزي(@)(@@) يروي عن منصور بن النعمان، عن أبي مجلز، أن أبا موسى نام وسط أصحابه، فقال: هل وجدتم ريحا هل سمعتم صوتا، قالوا: لا، قال: فقام صلى ولم يتوضأ، روى عنه الفضل بن موسى السيناني.(@)(@@)(@@)(@@) ||| AUTO عميرة بن عبد المؤمن، أبو سماعة الرهاوي(@)(@@) مولى لهم، يروي عن عصام بن بشير، روى عنه أهل الجزيرة.(@)(@@)(@@)(@@) ||| AUTO عياض بن عبد الله الفهري(@)(@@) يروي عن مخرمة بن سليمان عن كريب، روى عنه ابن وهب.(@)(@@)(@@)(@@) ||| AUTO عوام بن سليمان المديني(@)(@@) يروي عن أبيه، روى عنه إسحاق بن إبراهيم الحنظلي.(@)(@@)(@@)(@@) ||| AUTO عوام بن عباد بن العوام(@)(@@) يروي عن أبيه، روى عنه العباس بن إسماعيل العريق.(@)PageV01P002(@)(@@) [ج 5: ص 380](@)(@@)(@@)(@@) ||| AUTO علقمة بن عمر الكوفي(@)(@@) يروي عن أبي بكر بن عياش والكوفيين، حدثنا عنه أحمد بن الحسين الجرادي بالموصل وغيره، يغرب.(@)(@@)(@@)(@@) ||| AUTO عقيل بن يحيى الطهراني(@)(@@) من أهل الري، يروي عن أبي عاصم وأهل العراق، حدثنا عنه غير واحد بالري.(@)(@@)(@@)(@@) ||| AUTO عتيق بن محمد، أبو بكر(@)(@@) شيخ، يروي عن الدراوردي وأهل الحجاز، روى عنه إبراهيم بن إسحاق الأنصاري.(@)(@@)(@@)(@@) ||| AUTO عروة بن سعيد الأنصاري(@)(@@) سكن عبادان، يروي عن أبي عوانة عن قتادة عن أنس عن مالك بن صعصعة قصة المعراج، حدثنا عنه الحسن بن سفيان.(@)(@@)(@@)(@@) ||| AUTO عروة بن محمد الخراز(@)(@@) من أهل الرقة، يروي عن عبيد الله بن عمرو وموسى بن أعين، روى عنه أيوب الوزان وأهل الجزيرة، يخطئ ويغرب.(@)(@@)(@@)(@@) ||| AUTO عراك بن خالد بن يزيد بن صالح بن 
ms1576	 صبيح المري، كنيته أبو الضحاك(@)(@@) من أهل دمشق، يروي عن أبيه عن إبراهيم بن أبي عبلة، روى عنه هشام بن عمار وأهل الشام، ربما أغرب وخالف.(@)(@@)(@@)(@@) ||| AUTO علوان بن داود البجلي(@)(@@) من أهل الكوفة، يروي عن مالك بن مغول، روى عنه عمر بن عثمان الحمصي.(@)(@@)(@@)(@@) ||| AUTO عرعرة بن البرند بن النعمان، أبو عمر الناجي السامي(@)(@@) من ولد سامة بن PageV01P002 [ج 5: ص 381] لؤي، يروي عن روح بن القاسم وشعبة، روى عنه علي بن المديني وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عويذ بن أبي عمران الجوني(@)(@@) يروي عن أبيه، روى عنه العباس بن الفضل الأزرق، من أهل البصرة.(@)(@@)(@@)(@@) ||| AUTO عيينة بن عاصم(@)(@@) يروي عن أبيه، روى عنه عبد العزيز بن رستم الأسدي.(@)(@@)(@@)(@@) ||| AUTO عكير بن شمير بن يزيد القيسي، أبو سلمة(@)(@@) من أهل البصرة، يروي عن أبيه، روى عنه التبوذكي.(@)(@@)(@@)(@@) ||| AUTO عرفطة(@)(@@) شيخ، يروي عن أبي بشر جعفر بن أبي وحشية، روى عنه عامر الأحول.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO عيصا بن أبي بكر بن عبد الرحمن بن أبي سفيان بن حويطب(@)(@@) روى وحشية، روى عنه عامر الأحول.(@)(@@) عيصا بن أبي بكر بن عبد الرحمن بن أبي سفيان بن حويطب(@)(@@) يروي عن أبيه، عداده في أهل المدينة، يروي عنه غسان بن عبد الحميد.(@)(@@)(@@)(@@) ||| AUTO عقال بن شبة بن عقال بن صعصعة بن ناجئة المجاشعي(@)(@@) يروي عن أبيه عن جده عن صعصعة وله صحبة، روى عنه إبراهيم بن إسحاق بن رواحة المزني.(@)(@@)(@@)(@@) ||| AUTO عتيق بن يعقوب بن صديق بن موسى بن عبد الله بن الزبير بن العوام، أبو بكر القرشي(@)(@@) من أهل المدينة، يروي عن مالك، روى عنه إبراهيم بن سعيد الجوهري وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO عكرمة بن إبراهيم العدني(@)(@@) من أهل اليمن، يروي عن الحكم بن أبان، روى عنه أهل بلده والغرباء.(@)(@@) (646) -[5: 381] حدثنا الحسن بن سفيان، ثنا إبراهيم بن معاوية بن فرات البصري، حدثني عكرمة بن إبراهيم العدني، ثنا الحكم بن أبان، عن عكرمة، عن ابن عباس، قال: قال رسول الله صلى الله عليه وسلم: الأرواح جنود مجندة، فما 
ms1577	 تعارف منها ائتلف، وما تناكر منها اختلف(@)(@@)(@@)(@@) ||| AUTO عكرمة بن طارق السرخسي، كنيته أبو عون(@)(@@) يروي عن هشيم وأبي عوانة، PageV01P002 [ج 5: ص 382] كان صاحب حديث يحفظه، نقله المأمون معه إلى العراق وولاه قضاء الشرقية، وكان علي بن عيسى الكراشكي يكتب له، ومات بالعراق، روى عنه ابنه الفضل بن عكرمة.(@)(@@)(@@)(@@) ||| AUTO عطية بن بقية بن الوليد الحمصي(@)(@@) يروي عن أبيه، ثنا وغيره من شيوخنا، يخطئ ويغرب، يعتبر حديثه إذا روى عنه القطان عن أبيه غير الأشياء المدلسة.(@)(@@)(@@)(@@) ||| AUTO عائشة بنت يونس بن عبيد(@)(@@) امرأة ليث بن أبي سليم، تروى عن زوجها.(@)(@@) (647) -[5: 382] حدثني عبد الله بن جابر بطرسوس، ثنا جعفر بن محمد الأذني، قال: سمعت محمد بن عيسى بن الطباع، يقول: حدثتني عائشة امرأة ليث بن أبي سليم، قالت: كان لنا جيران يسرقون ويشربون، فقال ليث بن أبي سليم: ما أقل طلب هؤلاء للحور العين، حدثني مجاهد أن الحور العين خلقن من الزعفران. بسم الله الرحمن الرحيم(@)(@@)(@@)(@@) || AUTO باب الغين(@)(@@) قال أبو حاتم رضي الله عنه:(@)(@@) وممن يروي عن: أتباع التابعين ممن ابتدأ اسمه على الغين(@)(@@)(@@)(@@) ||| AUTO غسان بن الأغر بن حصين النهشلي(@)(@@) يروي عن زياد بن حصين، روى عنه الصلت بن محمد الخاركي وغيره وحبان بن علي.(@)(@@)(@@)(@@) ||| AUTO غسان بن عبيد الموصلي(@)(@@) يروي عن شعبة نسخة مستقيمة، رواها عنه أيوب بن محمد الوزان، حدثنا القطان بالرقة عن أيوب بها.(@)(@@)(@@)(@@) ||| AUTO غسان بن سليمان الهروي(@)(@@) يروي عن إبراهيم بن طهمان وسفيان الثوري، روى عنه محمد بن عمرويه الهروي الذي كان ببغداد وهو أخو مالك بن سليمان غسان، صدوق ومالك واه.(@)(@@)(@@)(@@) ||| AUTO غسان بن المفضل الغلابي(@)(@@) من أهل البصرة، يروي عن أبي عاصم PageV01P002 [ج 5: ص 383] النبيل والبصريين، روى عنه ابنه المفضل بن غسان، وقد رأى صالحا المري وسمع منه أشياء، حكاها عنه ابنه المفضل عنه عن صالح.(@)(@@)(@@)(@@) ||| AUTO غسان بن مالك بن عباد السلمي(@)(@@) بصري، يروي عن عون بن ذكوان أبي جناب وعنبسة بن عبد الرحمن، روى عنه محمد بن محمد بن مرزوق 
ms1578	 الباهلي وجعفر بن أبان الحراني.(@)(@@)(@@)(@@) ||| AUTO غسان بن عمرو بن عبيد الله العبدي(@)(@@) يروي عن حمزة الزيات، روى عنه أبو الربيع الزهراني.(@)(@@)(@@)(@@) ||| AUTO غسان بن عبد الحميد بن عبيد بن يسار الكناني(@)(@@) من أهل المدينة، يروي عن ابن إسحاق، روى عنه أبو غسان محمد بن يحيى بن عبد الحميد الكناني ابن أخيه.(@)(@@)(@@)(@@) ||| AUTO غسان بن الفضل الشجري، أبو عمر(@)(@@) يروي عن حزم بن أبي حزم وكان راويا لصبيح بن سعيد، لم ندخله في أتباع التابعين لأن صبيحا ليس بثقة، روى عنه محمد بن حيان، من أهل هراة وأهل بلده.(@)(@@)(@@)(@@) ||| AUTO غسان بن الربيع، أبو محمد الكوفي(@)(@@) سكن الموصل، يروي عن الليث بن سعد وحماد بن سلمة والناس، حدثنا عنه أبو يعلى بالموصل.(@)(@@)(@@)(@@) ||| AUTO غسان بن عمر، أبو الهذيل العجلي(@)(@@) من أهل الكوفة، يروي عن الثوري، روى عنه محمد بن سلام البيكندي.(@)(@@)(@@)(@@) ||| AUTO عوث بن جابر بن غيلان بن منبه اليماني(@)(@@) يروي عن عقيل بن معقل بن منبه عن وهب بن منبه بكتاب في الحكمة، روى عنه محمد بن رافع القشيري.(@)PageV01P002(@)(@@) [ج 5: ص 384](@)(@@)(@@)(@@) ||| AUTO غيلان بن أنس الدمشقي(@)(@@) يروي عن عمر بن عبد العزيز، روى عنه شعيب بن أبي حمزة.(@)(@@)(@@)(@@) ||| AUTO غياث بن حمزة(@)(@@) من أهل سرخس، يروي عن يزيد بن هارون، وكان صاحب عبادة وفضل، روى عنه أهل بلده.(@)(@@)(@@)(@@) ||| AUTO غياث بن جعفر(@)(@@) مستملي سفيان بن عيينة، يروي عن ابن عيينة، حدثنا عنه الحسين بن إدريس الأنصاري، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO غضين(@)(@@) شيخ، كوفي، يروي عن عمه عن الشعبي، روى عنه مروان بن معاوية الفزاري.(@)(@@)(@@)(@@) ||| AUTO غالب بن فهيد، أبو الحسن(@)(@@) من أهل الكوفة، وهو الذي يقال له: غالب بن فهيد المغالبي، كان يعنى بعلم الفرائض.(@)(@@) (648) -[5: 384] حدثنا عمرو بن محمد الهمداني، ثنا الفضل بن سهل الأعرج، ثنا غالب بن فهيد، ثنا عبد الرحمن بن أبي الزناد، عن أبيه، عن خارجة بن زيد بن ثابت، عن عمر، قال: لا يرث أخ ولا أخت لأم مع جد أب الأب(@)(@@)(@@)(@@) ||| AUTO غالب بن وزير 
ms1579	 الغزي(@)(@@) من أهل فلسطين، يروي عن وكيع بن الجراح، حدثنا عنه ابن قتيبة وغيره، مستقيم الحديث.(@)(@@)(@@)(@@) ||| AUTO غضبان بن حنظلة بن نعيم العنزي(@)(@@) يروي عن أبيه، روى عنه أبو عاصم النبيل.(@)(@@)(@@)(@@) ||| AUTO غصن بن إسماعيل(@)(@@) من أهل أنطاكية، يروي عن ثوبان عن نافع والزهري، روى عنه محمد بن غالب الأنطاكي، ربما خالف.(@)(@@)(@@)(@@) ||| AUTO غفيرة بنت واقد(@)(@@) متعبدة كانت بالبصرة، تروي عن: حميدة بنت ثابت البناني PageV01P002 [ج 5: ص 385] عن أبيها ثابت، روى عنه محمد بن عبد الملك الدقيقي.(@)(@@) (649) -[5: 385] حدثنا عبد الملك بن محمد بن سميع الدمشقي، ثنا محمد بن عبد الملك الدقيقي، حدثتنا غفيرة بنت واقد، قالت: حميدة بنت ثابت، حدثتني قالت: كان أنس وأبو طلال في بيت ثابت، فقال أنس: يا أبا طلال متى فقدت بصرك؟ فقال: وأنا صبي أعقل، قال: فهل لا أحدثك حديثا حدثنيه حبيبي صلى الله عليه وسلم يرويه عن جبرائيل، وجبرائيل يرويه عن الله عز وجل وعلا، قال: يا جبرائيل، ما جزاء من سلبت كريمتيه؟ فقال: سبحانك لا علم لنا إلا ما علمتنا، قال: جزاؤه الخلود في داري، والنظر إلى وجهي(@)(@@)(@@)(@@) || AUTO باب الفاء(@)(@@) قال أبو حاتم رضي الله عنه:(@)(@@) وممن روى من تبع الأتباع عن أتباع التابعين ممن ابتدأ اسمه على الفاء(@)(@@)(@@)(@@) ||| AUTO الفضل بن مهلهل، أبو المفضل الكوفي(@)(@@) من العباد، أخو المفضل بن مهلهل، يروي عن حبيب بن أبي عمرة، روى عنه الحسن بن الربيع البوراني.(@)(@@)(@@)(@@) ||| AUTO الفضل بن ميمون، أبو سلمة السلمي البصري(@)(@@) صاحب الطعام، يروي عن منصور بن زاذان، روى عنه أبو عامر العقدي.(@)(@@)(@@)(@@) ||| AUTO الفضل أبو يزيد(@)(@@) يروي عن سعيد بن مسروق، والد سفيان، روى عنه زيد بن حباب.(@)(@@)(@@)(@@) ||| AUTO الفضل بن عميرة الطفاوي(@)(@@) يروي عن ميمون الكردي، روى عنه حرمي بن عمارة.(@)(@@)(@@)(@@) ||| AUTO الفضل بن العلاء، أبو العلاء الكوفي(@)(@@) وقد قيل أبو العباس، يروي عن إسماعيل بن أمية، روى عنه محمد بن عقبة.(@)PageV01P002(@)(@@) [ج 5: ص 386](@)(@@)(@@)(@@) ||| AUTO الفضل بن خالد، أبو معاذ النحوي المروزي(@)(@@) مولى باهلة، يروي عن ابن المبارك وعبيد 
ms1580	 بن سليمان، روى عنه محمد بن علي بن الحسن بن شقيق وأهل بلده، مات سنة إحدى عشرة ومائتين.(@)(@@)(@@)(@@) ||| AUTO الفضل أبو مساور البصري(@)(@@) ختن أبي عوانة، يروي عن أبي عوانة، روى عنه البصريون النضر بن طاهر وغيره.(@)(@@)(@@)(@@) ||| AUTO الفضل بن موفق الثقفي، كنيته أبو الجهم(@)(@@) من أهل الكوفة، وهو الذي يقال له: الفضل بن أبي المتئد، يروي عن مسعر بن كدام، روى عنه ابن أبي شيبة وأهل العراق.(@)(@@)(@@)(@@) ||| AUTO الفضل بن عنبسة بن ماهان الراسبي الواسطي، أبو الحسن الخزاز(@)(@@) يروي عن يزيد بن إبراهيم التستري، روى عنه قتيبة بن سعيد.(@)(@@)(@@)(@@) ||| AUTO الفضل بن غانم، أبو علي(@)(@@) من أهل بغداد، يروي عن ابن عيينة وعبد الرحمن بن مغراء وأهل العراق، حدثنا عنه ابن منيع، قال: كتبت عنه سنة ثمان وعشرين ومائتين.(@)(@@)(@@)(@@) ||| AUTO الفضل بن زياد البغدادي الذي يقال له: الطستي، أبو العباس(@)(@@) يروي عن إسماعيل بن عياش وأهل العراق، حدثنا عنه الحسن بن سفيان.(@)(@@)(@@)(@@) ||| AUTO الفضل بن الصباح، أبو العباس البغدادي(@)(@@) يروي عن أبي ضمرة أنس بن عياض، روى عنه يعقوب بن سفيان.(@)(@@)(@@)(@@) ||| AUTO الفضل بن إسحاق العباداني(@)(@@) يروي عن الأشجعي، ثنا عنه أبو يعلى.(@)PageV01P002(@)(@@) [ج 5: ص 387](@)(@@)(@@)(@@) ||| AUTO الفضل بن إسحاق الدوري بغدادي(@)(@@) يروي عن معاذ بن معاذ وابن أبي عدي، حدثنا عنه محمد بن إبراهيم الفاسي وغيره.(@)(@@)(@@)(@@) ||| AUTO الفضل بن يعقوب الجزري، أبو العباس(@)(@@) سكن البصرة، يروي عن أبي عاصم وأهل العراق، حدثنا عنه ابن خزيمة وغيره، مات بعد الخمسين والمائتين.(@)(@@)(@@)(@@) ||| AUTO الفضل بن سخيت، أبو العباس السندي(@)(@@) بغدادي.(@)(@@) (650) -[5: 387] يروي عن صالح بن بيان، عن هشام بن عروة، عن أبيه، عن عائشة، كان النبي صلى الله عليه وسلم يأكل الرطب بالبطيخ. حدثنا به الحسن بن سفيان عنه(@)(@@)(@@)(@@) ||| AUTO الفضل بن يعقوب الرخامي(@)(@@) من أهل بغداد، كنيته أبو العباس، يروي عن عبيد الله بن موسى وأبي عاصم، حدثنا عنه محمد بن عمر بن يوسف.(@)(@@)(@@)(@@) ||| AUTO الفضل بن موسى بن عيسى الهاشمي(@)(@@) من أهل سامرة، أصله من البصرة، يروي عن الأنصاري وعبد 