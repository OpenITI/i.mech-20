ms61	 مالكا رق العلى % % وسواه للعلياء غاصب % % 4(@)(@@) % يا من ضياء كماله % % ملأ المشارق والمغارب % % 5(@)(@@) % يا من ثناه وشكره % % أبد الزمان علي واجب % % 6(@)(@@) % يا سيفي الماضي الذي % % أفدي به مهج النوائب % % 7(@)(@@) % يا ناصري عند الخطوب إذا عدمت أخا وصاحب % . . . % 8(@)(@@) % أشكو إليك جفاء دهر ليس يعتب من يعاتب % . . . % 9(@)(@@) % يسلي قلوب العاشقين عن الأحبة والحبائب % . . . % 10(@)(@@) % تنفسك ترشقني سهام صروفه من كل جانب % . . . % PageV01P264 11(@)(@@) % ما إن يزال مكتبا % % لي من نوائبه كتائب % % 12(@)(@@) % ولقد لجأت إليك من % % دون الأعاجم والأعارب % % 13(@)(@@) % ووثقت منك بماجد % % جم المحامد والمناقب % % 14(@)(@@) % ورجوت أكرم سيد % % ما عاد من يرجوه خائب % % 15(@)(@@) % وإلى حماك بعثتها % % غراء تهزؤ بالكواكب % % 16(@)(@@) % هي مثل ما قال البها % % تحكي عقودا في ترائب % % 17(@)(@@) % وتخال في أوراقها % % ذهبا على الأوراق ذائب % % 18(@)(@@) % ذكرت لا مستبطئا % % وعدا ولا زار وعاتب % % 19(@)(@@) % لكن خشيت بأنني % % عن فكرك الميمون عازب % % 20(@)(@@) % لا زلت عن نوب الزمان السود محروس الجوانب % . . . % PageV01P265 البحر : - 1(@)(@@) % أتت تفتر عن زهر الأقاح % % بيوت منك عطرت النواحي % % 2(@)(@@) % حياض تلك قل لي أم رياض % % أجادت صقلها أيدي الرياح % % 3(@)(@@) % ألذ جنى من العسل المصفى % % وأحلى من معانقة الملاح % % 4(@)(@@) % أتتني من مليك العصر حقا % % وسيد أهل حي على الفلاح % % 5(@)(@@) % صفي الدين نخبة آل طه % % وواسط عقد أرباب السماح % % 6(@)(@@) % ونجل السابقين إلى المعالي % % وأندى العالمين بطون راح % % 7(@)(@@) % وأسد الحرب إذ لا غاب إلا % % سيوف الهند أو سمر الرماح % % 8(@)(@@) % أتتني فانثنيت بها غراما % % أهيم من المساء إلى الصباح % % 9(@)(@@) % فسرت عن فؤادي كل هم % % ودام بها ابتهاجي وانشراحي % % 10(@)(@@) % ولكن ضمنت منه عتابا % % بلا ذنب أتيت ولا اجتراح % % PageV01P266 11(@)(@@) % رويدك سيدي لا تلح ظلما % % فلي عذر أرد به اللواحي % % 12(@)(@@) % فلم يك في السراج إذا لعمري % % جرى ذاك التخاصم والتلاحي % % 13(@)(@@) % وما أنا والسراج وأنت شمس % % بك الأرجاء تشرق والنواحي % % 14(@)(@@) % ولكني بليت بخصم سوء % % خسيس الأصل ذي وجه وقاح % % 15(@)(@@) % سفيه لا يرد لسانه في 
ms62	 % % ميادين السفاهة عن جماح % % 16(@)(@@) % يظل يهين أعراض البرايا % % فكم عرض لديه مستباح % % 17(@)(@@) % ولما أن رأينا الأمر يفضي % % إلى أشياء معضلة قباح % % 18(@)(@@) % بذلت النفس دون الصحب حبا % % لصونهم وسعيا في الصلاح % % 19(@)(@@) % وقمت أذب عنهم ثم كيلا % % يكون الجد عاقبة المزاح % % 20(@)(@@) % فهل أخطا محبك بعد هذا % % وهل فيما أتاه من جناح % % PageV01P267 البحر : - 1(@)(@@) % فيك أما في سواك فلا % % أنظم التشبيب والغزلا % % 2(@)(@@) % وأسد الأذن إن عذلوا % % فيك كيلا أسمع العذلا % % 3(@)(@@) % من لقلب ما سلاك وإن % % قالت العذال فيه سلا % % 4(@)(@@) % ودموع فيك حين جرت % % جعلت خدي لها سبلا % % 5(@)(@@) % وخيال منك حين سرى % % يتخطى نحوي المقلا % % 6(@)(@@) % قد رأى قلبي فسله إذا % % هل رأى في طيه بدلا % % 7(@)(@@) % ونصيح غير متهم % % قد أطال العذل فيك بلا % % 8(@)(@@) % يا نصيحي أنت أكبر من % % أن تقول الغي والخطلا % % 9(@)(@@) % أنت فيما قلته ثقة % % غير أن القلب ما قبلا % % 10(@)(@@) % كيف أسلو حب ذي كفل % % بهلاك الخلق قد كفلا % % PageV01P268 11(@)(@@) % كم رنا ثم انثنى ميدا % % فأغار البيض والأسلا % % 12(@)(@@) % ليت شعري عن لواحظه % % أسيوفا كن أم مقلا % % 13(@)(@@) % وعن الأعطاف هل سرقت % % ميد الأغصان والميلا % % 14(@)(@@) % وفتور في لواحظه % % كيف يوهي الفارس البطلا % % 15(@)(@@) % وكؤوس من مراشفه % % حوت الصهباء والعسلا % % 16(@)(@@) % كخصال الفضل إذ جمعت % % في سليل السادة الفضلا % % 17(@)(@@) % من إذا جادت أنامله % % قالت العلياء لا شللا % % 18(@)(@@) % كم له في الناس من نعم % % ضربت بين الورى مثلا % % 19(@)(@@) % كم قتام تحت ظلمته % % عانق العسالة الذيلا % % 20(@)(@@) % ترك الأتراب في تعب % % وعلى هام السماك علا % % PageV01P269 21(@)(@@) % ربما ازدادت طلاقته % % حين يلقى الحادث الجللا % % 22(@)(@@) % لو رأت عيناك نائله % % لرأيت العارض الهطلا % % 23(@)(@@) % أو تيدي يوم معركة % % قلت ليث الغاب قد حملا % % 24(@)(@@) % سيدي وافي قريضكم % % فشفى الأوصاب والعللا % % 25(@)(@@) % وطلبتم أن أجيبكم % % فأطعت الأمر ممتثلا % % PageV01P270 البحر : - 1(@)(@@) % يا بن خير الورى ومن % % جاء بالحق والهدى % % 2(@)(@@) % وابن صنو النبي حيدر نفسي له الفدا % . . . % 3(@)(@@) % والهمام الذي تأزر بالمجد 
ms63	 وارتدى % . . . % 4(@)(@@) % والكريم الذي تقدم في حلبة الندى % . . . % 5(@)(@@) % والذي طاب في البرية أصلا ومحتدا % . . . % 6(@)(@@) % والذي لم يحط بنعماه من قام منشدا % . . . % 7(@)(@@) % أنت غيث على العفاة وليث على العدى % . . . % 8(@)(@@) % لك أشكو نوائبا تركتني مسهدا % . . . % 9(@)(@@) % وسهاما بها رماني زماني فأقصدا % . . . % 10(@)(@@) % وديونا غدا بهن منامي مشردا % . . . % PageV01P271 11(@)(@@) % فأعني بنفحة وجزيل من الجدا % . . . % PageV01P272 البحر : - 1(@)(@@) % أذن الندى عن نداء الشعر صماء % % فليس يجديك إنشاد وإنشاد % % 2(@)(@@) % يا قالة الشعر مهلا لا أبا لكم % % رويدكم ما لزند المدح إيراء % % 3(@)(@@) % إنا لفي زمن ود الفصيح به % % لو انه ألكن في القول فأفاء % % 4(@)(@@) % كم تمدحون ولا تعطون جائزة % % كأنما مدحكم بالمنع إغراء % % 5(@)(@@) % لو كان في الطين أو في الماء رزقكم % % يوما لأعجز حتى الطين والماء % % 6(@)(@@) % ويا مرجي نوالا أنت في زمن % % فيه المكارم والعلياء أسماء % % 7(@)(@@) % إياك إياك أن تدلي بسابقة % % فإن ذلك إن حققته الداء % % 8(@)(@@) % ولا تقل إن أردت النجح قد قتلت % % أمامكم لي أجداد وآباء % % 9(@)(@@) % يقصي المحب ويدني من عقيدته % % نضب وجبر وتشبيه وإرجاء % % 10(@)(@@) % كم ملحدين ونصاب كأنهم % % لمفرط القرب أرحام وأحماء % % PageV01P273 11(@)(@@) % ومن يكن ذا صلاح في عقيدته % % فإنما حظه طرد وإقصاء % % 12(@)(@@) % إن تستمح قيل كل في السؤال وإن % % عاتبت قيل بذي القول هجاء % % 13(@)(@@) % أستغفر الله ليس الهجو من شيمي % % لكنني رجل للضيم أباء % % 14(@)(@@) % ما الملك إلا مضاع السرج مطرح % % إن لم يكن لعنان البذل إرخاء % % 15(@)(@@) % أين الملوك الألي ما جاء آملهم % % إلا وقابله بشر وإعطاء % % 16(@)(@@) % حتى ينسون من ري ومن شبع % % قوما لهم أكبد للجوع حراء % % 17(@)(@@) % قل للمساكين أهل الشعر يا تعب الأفكار إن لم يصبهم منه إثراء % . . . % 18(@)(@@) % هذي الملوك ملوك العصر هل أحد % % منهم على سنن المعروف مشاء % % 19(@)(@@) % كم قد مدحنا فما أجدت مدائحنا % % لأنهم إنما يعطون من شاؤوا % % 20(@)(@@) % يا أحم دعوة عان قل ناصره % % وخانه لجفا الدهر الأحباء % % PageV01P274 21(@)(@@) % اسمع شكية معل معلن حزنا % % إن كان ينفع إعلان وإعلاء 
ms64	 % % 22(@)(@@) % ما للقوافي إذا أقوت معاهدها % % أفي زمانك يوهي الشعر إقواء % % 23(@)(@@) % من ذا الذي من مقام الذل ينهضها % % إن نالها بنعال الذل إيطاء % % 24(@)(@@) % أف لها خطة يشقى ملابسها % % ضاقت بصاحبها للأرض ارجاء % % 25(@)(@@) % وحرفة أزجيت فينا بضاعتها % % فربح بائعها فقر وإكداء % % 26(@)(@@) % إيها أغث مستغيثا أنت قط له المرجو إن مسه بأس وضراء % . . . % PageV01P275 البحر : - 1(@)(@@) % نعم هذه حزوي وتلك زرود % % فهل ذلك العيش النضير يعود % % 2(@)(@@) % وهل تقتضي فيها لبانات عاشق % % وتذكر أيمان لنا وعهود % % 3(@)(@@) % وهل لليال قد مضت ثم عودة % % وهل لي من بعد الصدور ورود % % 4(@)(@@) % وهل أجتني زهر اللقا من أحبتي % % على حين أغصان الشباب تميد % % 5(@)(@@) % وهل أبلغن ممن أحب على الهوى % % ورغم النوى ما أشتهي وأريد % % 6(@)(@@) % سقى الله أكناف العقيق سحائبا % % يبيت عليها ودقهن يجود % % 7(@)(@@) % ولله دهر قد مضى لي بالغضا % % وعيش قضى بالرقمتين حميد % % 8(@)(@@) % جنيت به روض المنى وهو يانع % % وقد غاب عنا كاشح وحسود % % 9(@)(@@) % وما أنس لا أنس الحمى فسقى الحمى % % وأهليه صخاب الرعود ركود % % 10(@)(@@) % يمثلهم شوقي لعيني وبيننا % % جبال عوال أو مهامه بيد % % PageV01P276 11(@)(@@) % هم نقضوا عهدي جهارا وعهدهم % % لدي على طول البعاد أكيد % % 12(@)(@@) % وغيداء أما جفنها فهو فاتر % % ضعيف وأما قلبها فشديد % % 13(@)(@@) % إذا أعلمت سود اللحاظ حسبتها % % لدى الفتك أيقاظا وهن رقود % % 14(@)(@@) % تكلفني فوق الذي بي من الهوى % % على أن وجدي ما عليه مزيد % % 15(@)(@@) % وتوعدني بالوصل سرا وكم لها % % وعود مطال بعدهن وعود % % 16(@)(@@) % فإياك من وعد الغواني بوصلها % % فهن اللواتي وعدهن وعيد % % 17(@)(@@) % خليلي هل تدنو الديار لمغرم % % تمالت عليه أعين وقدود % % 18(@)(@@) % أما قلتما لي إذ وقفنا على الحمى % % نكرر تسال الربى ونعيد % % 19(@)(@@) % أفق فبحزوي أو زرود خيامهم % % أما هذه حزوى وتلك زرود % % 20(@)(@@) % وأمركما لي بالتصبر ضلة % % ألا إن أمرا رمتماه بعيد % % PageV01P277 21(@)(@@) % ومن لي بالصبر الجميل وقد أتت % % لقتلي من حشد الغرام جنود % % 22(@)(@@) % وما تركت جهدا عزائم سلوتي % % ولكن شيطان الغرام مريد % % 23 
ms65	(@)(@@) % وإن كنت لا أستطيع صبرا على النوى % % فإني على حمل الهوى لجليد % % 24(@)(@@) % يقل اصطباري والغرام بحاله % % ويبلى شبابي والغرام جديد % % 25(@)(@@) % فليس كمثلي في المحبين مغرم % % ولا مثل عز المكرمات مجيد % % 26(@)(@@) % فتى ساد أبناء المكارم كلهم % % وما الناس إلا سيد ومسود % % 27(@)(@@) % فتى أقعدته كاهل المجد والعلى % % جحاجح من أبناء أحمد صيد % % 28(@)(@@) % غدا وزمام الدهر طوع يمينه % % يصرفه أنا يشا ويريد % % 29(@)(@@) % إذا ما داعي المطالب ماله % % يلبيه منه طارف وتليد % % 30(@)(@@) % فدع حاتما إن شيم بارق نائل % % فما لأخي جود سواه وجود % % PageV01P278 31(@)(@@) % وفارس عبد لو توهم بأسه % % لذاب لو أن القلب منه حديد % % 32(@)(@@) % أعز الهدى مر في الزمان بما تشا % % فأنت لعمري في بنيه وحيد % % 33(@)(@@) % تظن الكرام المجد ما يبتنونه % % وليس سوى ما تبتني وتشيد % % 34(@)(@@) % فكم من فخار أنت دون الورى له % % نهضت وأبناء الزمان قعود % % 35(@)(@@) % ومكرمة بكر بنيت أساسها % % وهم عن بناء المكرمات رقود % % 36(@)(@@) % ورب رفيع الذكر أخملت ذكره % % فكل عميد مذ نشأت عميد % % 37(@)(@@) % وأتعبت أهل السبق في حلبة العلى % % بما رحت منها تبتدي وتعيد % % 38(@)(@@) % وكم أظهرت أوصافك الغر للورى % % براهين مجد ما لهن جحود % % 39(@)(@@) % وكم نقصت للنيل يوما أصابع % % وبحرك ما ازداد النوال يزيد % % 40(@)(@@) % شمائل تزري بالصبا وبلاغة % % وبأس يذيب الراسيات وجود % % PageV01P279 41(@)(@@) % وما لست أحصي من فضائل جمة % % غدت وهي في جيد الفخار عقود % % 42(@)(@@) % على أقعدت عجزا سواك كأنها % % جوامع في أعناقهم وقيود % % 43(@)(@@) % وسمعا لها مصقولة اللفظ حلوة % % يقصر عنها جرول ولبيد % % 44(@)(@@) % إذا أنشدت حلت غراما حبى النهى % % وكادت لها الشم الجبال تميد % % 45(@)(@@) % أبثك شوقا لي إليك مضاعفا % % لنيرانه بين الضلوع وقود % % 46(@)(@@) % تحمل قلبي من فراقك لوعة % % يقلقل رضوى بعضها ويؤود % % 47(@)(@@) % فما طرق القلب الجريح لبعدكم % % هدو ولا الطرف القريح هجود % % 48(@)(@@) % وسل عن ودادي سر قلبك إنه % % لعمري على ما أدعيه شهيد % % 49(@)(@@) % عسى من قضى بالبين بيني وبينكم % % يرد لنا ما قد مضى ويعيد % % 50 
ms66	(@)(@@) % سقى الغيث ريا سوحك الرحب إنه % % لجنة عدن لو يكون خلود % % PageV01P280 51(@)(@@) % ولا زال معمور الفنا بك دائما % % يحل به بعد الوفود وفود % % 52(@)(@@) % وما دمت لا تخشى الليالي فإنما % % طوالعها مهما بقيت سعود % % 53(@)(@@) % فما لمخوف مع وجودك صولة % % ولا لتصاريف الزمان طريد % % 54(@)(@@) % وإنكم آل المطهر في الورى % % جواهر والمجد المؤثل جيد % % PageV01P281 البحر : - 1(@)(@@) % وفت لك ذات المبسم العذب بالوصل % % ووافت على طول التباعد والمطل % % 2(@)(@@) % من الغيد تحكي إن بدت غصن النقا % % وشمس الضحى فاستجن ما شئت واستجلي % % 3(@)(@@) % أشد مضاءا من ظبي الهند لحظها % % وأحلا مذاقا لفظها من جنى النحل % % 4(@)(@@) % دعاني إلى وجدي بها سحر طرفها % % ودل فؤادي نحوها ملق الدل % % 5(@)(@@) % وليلة زارتني وعندي هجرها % % غرام مضى بالجسم والروح والعقل % % 6(@)(@@) % ضممت قوام القد ليلة وصلها % % فحققت ظني إنها ألف الوصل % % 7(@)(@@) % وفزت وقد نامت عيون عواذلي % % من المرشف المعسول بالعل والنهل % % 8(@)(@@) % ويعذلني خالي الفؤاد من الجوى % % ولكن في أذني وقرا عن العذل % % 9(@)(@@) % وإني على أخذ الغرام بمقودي % % لأصبو إلى المجد المؤثل والفضل % % 10(@)(@@) % أروح وأغدو دائما ليس لي سوى % % طلاب العلى والحمد لله من شغل % % PageV01P282 11(@)(@@) % أهيم بأبكار القريض فلم أزل % % لها أبدا ما عشت أملي وأستملي % % 12(@)(@@) % فمن ملح سيرتها أدبية % % ومن غزل ما قاله أحد قبلي % % 13(@)(@@) % ومن مدح كالروض حسنا بعثتها % % إلى ذي العطاء الجم والنائل الجزل % % 14(@)(@@) % إلى كعبة الجدوى إلى حرم الغنى % % إلى المعقل الأسمى إلى الجانب السهل % % 15(@)(@@) % إلى السيد الندب الذي ليس في العلى % % له مثل والمثل يبصر بالمثل % % 16(@)(@@) % إلى شرف الدين الحسين الذي له % % عزائم أغنته عن الخيل والرجل % % 17(@)(@@) % إلى الماجد الوهاب أسمح من خبا % % بكف وأسما من يسير على رجل % % 18(@)(@@) % إلى أصيد رحب الفنا جود كفه % % إذا ضن هامي الوبل تغني عن الوبل % % 19(@)(@@) % إلى ملك جارته أملاك عصره % % ولكنه من دونهم فاز بالخصل % % 20(@)(@@) % إلى فرع مجد أصله سيد الورى % % فبورك من فرع كريم ومن أصل % % PageV01P283 21(@)(@@) % وذو 
ms67	 الجود لم يبرح به ذا صبابة % % فليس يرى عارا أشد من البخل % % 22(@)(@@) % ومنجز ميعاد الأماني لوقته % % فما قال إلا أتبع القول بالفعل % % 23(@)(@@) % إذا انهمرت من كفه سحب نائل % % فأي محل يشتكي صولة المحل % % 24(@)(@@) % تهن عقيد المجد بالمنة التي % % حبيت بها واشكر لذي المن والفضل % % 25(@)(@@) % أنلت قصاري ما اقترحت على المنى % % ولف القدير الحق شملك بالأهل % % 26(@)(@@) % وجاءك هذا الدهر مستغفرا لما % % جنى سابقا فاغفر له زلة النعل % % 27(@)(@@) % وقابله بالصفح الجميل فقد أتى % % إليك أسيرا للضراعة والذل % % 28(@)(@@) % ولا زلت موفور الغنى حائز المنى % % مبيد الأعادي مالك العقد والحل % % PageV01P284 البحر : - 1(@)(@@) % يا شفا نفسي ويا برء فؤادي من سقامه % . . . % 2(@)(@@) % وإمامي يوم يأتي كل شخص بإمامه % . . . % 3(@)(@@) % وهمام الدهر في هذا الورى وابن همامه % . . . % 4(@)(@@) % والذي يمتعني الله تعالى بدوامة % . . . % 5(@)(@@) % هاكها من عبدك الباقي على حفظ ذمامه % . . . % 6(@)(@@) % سبحة حازت من الحسن المعلى من سهامه % . . . % 7(@)(@@) % والدعا يا خير أملاك الورى أقصى مرامه % . . . % 8(@)(@@) % وابق ما غنت على العود مرنات حمامه % . . . % PageV01P285 البحر : - 1(@)(@@) % فراقكم هاج اشتياقي وأشجاني % % وأغرى جفوني بالسهاد وأشجاني % % 2(@)(@@) % وأبدي سقامي فيكم ما كتمته % % وعبر شأني في الصبابة عن شاني % % 3(@)(@@) % وهيهات أن يخفى الذي بي من الهوى % % وسر غرامي بعدكم مثل إعلاني % % 4(@)(@@) % أأحبابنا حتى متى وإلى متى % % أرى ذاكرا بالغيب من ظل ينساني % % 5(@)(@@) % ألا عطفة بالوصل منكم لمغرم % % أسير الجوى صادي الجوانح حران % % 6(@)(@@) % بما بيننا من حرمة الود والهوى % % وعقد الإخا فكوا أسيركم العاني % % 7(@)(@@) % تخذتكم دون الأنام أحبة % % وعاصيت فيكم كل من ظل يلحاني % % 8(@)(@@) % فكيف سمعتم ما روته حواسدي % % وقالوه من زور علي وبهتان % % 9(@)(@@) % ووالله ما رمت التبدل عنكم % % ولا مر لي في القلب خاطر سلوان % % 10(@)(@@) % وإن التسلي والتبدل عنكم % % لأمران في دين الغرام أمران % % PageV01P286 11(@)(@@) % وعاهدتموني بالعقيق على الهوى % % فأين مواثيقي ترون وإيماني % % 12(@)(@@) % ولي فيكم يوم الوداع مهفهف % % جفاني فأغرى بالمدامع أجفاني % % 13(@)(@@) % كلفت به إذ صار في الحسن واحدا % % فلم يثنني 
ms68	 عن حبه أبدا ثاني % % 14(@)(@@) % وعنفني من لم يذق كأس صبوتي % % ولا بات ذا قلب كقلبي ولهان % % 15(@)(@@) % عفا الله عمن لامني لو رأى الذي % % كلفت به يوم العقيق لأعفاني % % 16(@)(@@) % غزال كأن الله صور خلقه % % من النيرات الزهر في شكل إنسان % % 17(@)(@@) % يميس بقد يحسد الغصن لينه % % ويبسم عن در نضيد ومرجان % % 18(@)(@@) % وفي خده ورد جني قطافه % % ولكن سيف اللحظ يجني على الجاني % % 19(@)(@@) % أروم لقاه ثم أخشى رقيبه % % فآخذ عنه جانبا حين يلقاني % % 20(@)(@@) % أتاني هواه بعد تركي للهوى % % فأذكرني ما الدهر من قبل أنساني % % PageV01P287 21(@)(@@) % إلى الله أشكو ظالمين تعاهدا % % علي وكانا أصل همي وأحزاني % % 22(@)(@@) % هوى ضقت ذرعا عن تحمل بعضه % % ودهرا عن الهادي بن أحمد أقصاني % % 23(@)(@@) % فتى المجد والعلياء من صار مجمعا % % على فضله قاصي البرية والداني % % 24(@)(@@) % فتى ألقت الآداب طوعا لفكره مقاليد تسليم إليه وإذعان % . . . % 25(@)(@@) % فتى مد للاحسان باع مبرز % % فلم يختلف في فضل سؤدده اثنان % % 26(@)(@@) % فتى ورث العلياء عن خير سادة % % مراجيح أحلام مساميح غران % % 27(@)(@@) % فتى ساد قبل الحلم أبناء جنسه % % وشاد لربع المجد أرفع بنيان % % 28(@)(@@) % أخو نجدة إن يدع للبأس والفدى % % فلا عاجز تلقاه ثم ولا واني % % 29(@)(@@) % حوى قصبات السبق طفلا وناشئا % % وبذ الأعالي من شباب وشبان % % 30(@)(@@) % لقد جمع الهادي بن أحمد في الورى % % مكارم شتى ما اجتمعن لإنسان % % PageV01P288 31(@)(@@) % خطابا كما افترت ثغور زواهر % % وخلقا كما اهتزت معاطف أغصان % % 32(@)(@@) % ونثرا كما رقت كؤوس سلافة % % ونظما كما راقت قلائد عقيان % % 33(@)(@@) % أمولى القوافي السائرات التي غدت % % يقر لها فكرا لبيد وحسان % % 34(@)(@@) % أبثك شوقا لي اليك أقله % % يهدد من ركني ثبير وثهلان % % 35(@)(@@) % أروح بقلب فارغ من تصبري % % وأغدو بصدر من شجوني ملآن % % 36(@)(@@) % فهل عطفه بالقرب منكم لشيق % % إلى ورد هاتيك الشمائل ظمآن % % 37(@)(@@) % وخذها كما لآحت نجوم زواهر % % دجى أو كما فاحت أزاهر بستان % % 38(@)(@@) % ومن سريعا بالجواب فإن لي % % إليك اشتياق المغرم الدنف العاني % % 39(@)(@@) % وحي الحسين الملك نجل 
ms69	 مطهر % % أخا المجد سامي المرتقى عالي الشاني % % 40(@)(@@) % وإخوته الغر الأكارم من بنوا % % بناء المعالي فوق هامة كيوان % % PageV01P289 41(@)(@@) % تحية صب شوقه وغرامه % % لسوحهم لا للعقيق ونعمان % % 42(@)(@@) % ولا تعتبن في أن كتبي تأخرت % % فما عن ملال كان مني وشنئان % % 43(@)(@@) % ولكن لأحوال عرت لا عرفتها % % وطول هموم لم تزل قط تغشاني % % 44(@)(@@) % رماح أذى للحاسدين تنوشني % % وكف زمان لم تمد بإحسان % % 45(@)(@@) % تنمر لي يا بن الكرام وطالما % % قديما على حسن العوائد أجراني % % 46(@)(@@) % فكم وقعة بيني وبين صروفه % % تهون لها أيام عبس وذبيان % % 47(@)(@@) % وحسبي داء حرفة أدبية % % غدت سببا في وضع قدري ونقصاني % % 48(@)(@@) % ولو لم يكن من جوره غير أنه % % رماني بسهم البعد عنك فأصماني % % 49(@)(@@) % وما زلت مني في الضمير ممثلا % % فألقاك في طي الضمير وتلقاني % % 50(@)(@@) % دنوت إلى قلبي وإن كنت نازحا % % عليك سلام الله من نازح داني % % PageV01P290 البحر : - 1(@)(@@) % سرى طيفها وهنا إلي فحياني % % فيا حبذا طيف من السقم أحياني % % 2(@)(@@) % بعيد السرى يجتاب كل تنوفة % % ولم يثنه عن قصد مغرمه ثاني % % 3(@)(@@) % أيا زائرا من بعد نأي وفرقة % % وعاود لما عاود النوم أجفاني % % 4(@)(@@) % بعيشك يا طيف الأحبة قل لهم % % أما عطفة ترجى على المدنف العاني % % 5(@)(@@) % وهل ذاكري أحباب قلبي على النوى % % أم الحب أغرى من أحب بنسياني % % 6(@)(@@) % على أن هذا الهجر والصد منهم % % لحالان في شرع الصبابة حلوان % % 7(@)(@@) % وحرمة أيام الوصال التي قضت % % وطيب ليالينا بذي الرمل والبان % % 8(@)(@@) % لقد تلفت روحي اشتياقا إليكم % % وهاجت صباباتي إليكم وأحزاني % % 9(@)(@@) % وقد كدت أقضي بعدكم يا أحبتي % % ومن بعدكم ما كان بالموت أحراني % % 10(@)(@@) % وأغيد كالغصن الرطيب إذا مشى % % من الترك فتاك اللواحظ فتان % % PageV01P291 11(@)(@@) % يرنحه سكر الصبابة والصبا % % كما رنحت ريح الصبا غصن البان % % 12(@)(@@) % كلفت به كالبدر حل بسعده % % وعاصيت فيه كل من ظل يلحاني % % 13(@)(@@) % ولم أنس في نعمان يوما جنيت من % % أزاهر خديه شقائق نعمان % % 14(@)(@@) % يقولون ما ألقاك في نار حبه % % فقلت لهم لا تعتبوا 
ms70	 خده القاني % % 15(@)(@@) % دعوني وذنبي في هواه فخاله % % إلى الحب من طور المحاسن ناداني % % 16(@)(@@) % سأثني عناني نحوه غير سامع % % ملاما وكيف الكفر من بعد إيمان % % 17(@)(@@) % ويا شرف الإسلام يا من صفاته % % الحميدة حقا ما اجتمعن لإنسان % % 18(@)(@@) % أتتني على بعد قصيدتك التي % % أقر لها قاصي البرية والداني % % 19(@)(@@) % بعثت بها حسناء يا خير محسن % % فأطلقت جهدي بين حسن وإحسان % % 20(@)(@@) % وأرسلتها حوراء مصحوبة الرضى % % فقلت انظروها فهي من حور رضوان % % PageV01P292 21(@)(@@) % كسرت قناة الناصين بها كما % % رفعت بها يا بن الأكارم من شاني % % 22(@)(@@) % فمن أين لي في أن أجاريك طاقة % % وبحرك يأبى أن يقاس بغدراني % % 23(@)(@@) % ولكن من عجز أقابل بالحصى % % قلائد من در نظيم وعقيان % % 24(@)(@@) % توصلت في مدحي إلى مدح ماجد % % به افتخرت أبنا معد وعدنان % % 25(@)(@@) % إمام الهدى رب الندى واسع الجدا % % مبيد العدى مروي صدى كل عطشان % % 26(@)(@@) % فتى حاز شأو المكرمات بهمة % % تريه البعيد الصعب مستسهلا داني % % 27(@)(@@) % فمن كالحسين السيد الندب في الورى % % يشيد العلى والمجد من غير ما واني % % 28(@)(@@) % ولما شكوت الدهر يا خير ماجد % % غدوت بقلب من همومي حران % % 29(@)(@@) % وبت كأني ساورتني ضئيلة % % من الرقش من أنيابها السم يغشاني % % 30(@)(@@) % لحا الله دهرا حاربتك صروفه % % ومالت بطغيان عليك وعدوان % % PageV01P293 31(@)(@@) % وأنت الذي شرفته ورفعته % % على أعصر مرت قديما وأزمان % % 32(@)(@@) % فمال ولو وفاك ما تستحقه % % بنى لك بيتا فوق هامة كيوان % % 33(@)(@@) % فلا تبتئس وابشر فسعدك مقبل % % سيأتيك ما تهوى وإن رغم الشاني % % 34(@)(@@) % وسوف ترى السبع الدراري مطيعة % % لأمرك فيما تشتهي ذات إذعان % % 35(@)(@@) % عليك سلام مثل أخلاقك التي % % هي الروض لا بل زهرها غب هتان % % PageV01P294 البحر : - 1(@)(@@) % حتام أكتم ما الدموع تبيح % % وإلام أغدو مغرما وأروح % % 2(@)(@@) % وإلى متى أصبو إلى ريح الصبا % % ومهيج نار جواي تلك الريح % % 3(@)(@@) % ومعنف نحو الملامة جانح % % لو كان لي نحو السلو جنوح % % 4(@)(@@) % يملي على من ليس يسمع قوله % % في الحب قولا كله مطروح % % 5(@)(@@) % ومعذبي من لا 
ms71	 أبوح بذكره % % ويكاد يعميني الهوى فأبوح % % 6(@)(@@) % من لو رآه البدر قال مخاطبا % % أنت المليح وما سواك مليح % % 7(@)(@@) % نشوان من خمر الرضاب لقده % % منها غبوق دائما وصبوح % % 8(@)(@@) % أعطيته روحي ومالي طالبا % % للوصل وهو بما طلبت شحيح % % 9(@)(@@) % ومتى شكوت له الهوى قال اصطبر % % فالصبر فيه لذي الهوى ترويح % % 10(@)(@@) % أمكلفي صبرا جميلا في الهوى % % تكليف ما لا يستطاع قبيح % % PageV01P295 11(@)(@@) % أرفق بجسم أنت سالب روحه % % أيعيش جسم فارقته الروح % % 12(@)(@@) % وانظر إلى قلبي عليك وناظري % % هذا قريح هوى وذاك جريح % % 13(@)(@@) % وسل المدامع عن غرامي فهو في % % متن الخدود بمدمعي مشروح % % 14(@)(@@) % إن لا تكن لي زورة تحيى بها % % روحي فموت من هواك مريح % % 15(@)(@@) % حيا الحيا زمن الغوير وأنت لي % % بالقرب منك وبالوصال سموح % % 16(@)(@@) % إذ لا أخاف الكاشحين وقولهم % % هذا الفتى المستهتر المفضوح % % 17(@)(@@) % يا عاذلين أنا الذي قد قلتم % % فاغدوا هبلتم في الملام وروحوا % % 18(@)(@@) % ولقد وقفنا للوداع ببارق % % إذ بارق البين المظل يلوح % % 19(@)(@@) % إذ ليس إلا مدمع متدفق % % إثر الهوادج أو دم مسفوح % % 20(@)(@@) % لم ندر هل تلك النفوس ذوائبا % % أم أدمع فوق الخدود تسيح % % PageV01P296 21(@)(@@) % وببابل سقت الغوادي بابلا % % ملقى بآثار الخيام طريح % % 22(@)(@@) % سمع الصبابة وهي حقا باطل % % وعصى النصيح وإنه لنصيح % % 23(@)(@@) % متيقنا جور الغرام وأن ما % % يروى عن المقل المراض صحيح % % 24(@)(@@) % قد عبرت عبراته عما به % % إن الهوى تلويحه تصريح % % 25(@)(@@) % أضحى يحدثه أحاديث الهوى % % عنهم خزامى بابل والشيح % % 26(@)(@@) % قلق الفؤاد كأنما هبت له % % من حضرة الهادي بن أحمد ريح % % 27(@)(@@) % سباق غايات المعالي من له % % طرف إلى نيل الفخار طموح % % 28(@)(@@) % خلق يحاكي البدر حين يلوح مع % % خلق يحاكي الزهر حين يفوح % % 29(@)(@@) % من إن دجت ظلم النوائب حلها % % رأي له في المشكلات رجيح % % 30(@)(@@) % ندب يجل عن المدائح كلها % % لو أن شعر العالمين مديح % % PageV01P297 31(@)(@@) % وإذا أشار الناس نحو مسود % % فهو المشار إليه والملموح % % 32(@)(@@) % شهم يلاقي النائبات بعزمة % % تدع الشوامخ وهي بيد فيح % % 33 
ms72	(@)(@@) % وفضائل ما حازها أحد غدت % % ولها على شمس النهار وضوح % % 34(@)(@@) % وندى كما انهل الغمام ورآءه % % نسب كما انشق الصباح صريح % % 35(@)(@@) % يتناقل الأدباء در قريضه % % فكأنه التهليل والتسبيح % % 36(@)(@@) % يا أفصح الفصحاء غير مدافع % % أقلل لمثلك أن يقال فصيح % % 37(@)(@@) % إذ أنت للأدباء درة تاجها % % بل أنت في جسد المعالي روح % % 38(@)(@@) % خذها كما ابتسمت أزاهر أيكة % % قد زانها التهذيب والتنقيح % % 39(@)(@@) % غراء تجتلب القلوب غرابة % % لم لا وأنت بدرها الممدوح % % 40(@)(@@) % أشكو عظيم جوى إليك مضاعفا % % لي من سموم سمومه تلويح % % PageV01P298 41(@)(@@) % وصروف دهر يا بن أحمد لم يزل % % يبدو لهن تجهم وكلوح % % 42(@)(@@) % فابعث قريضك رقية يحيى بها % % قلبي فقد أودى به التبريح % % PageV01P299 البحر : - 1(@)(@@) % ملكتموا فاعدلوا في الصب أو جوروا % % ذنب الأحبة في العشاق مغفور % % 2(@)(@@) % وقد تقرر في قلبي مقركم % % دون الورى فأقيموا فيه أو سيروا % % 3(@)(@@) % يا مخربي ربع صبري بالجفا عبثا % % الحمد لله ربع الود معمور % % 4(@)(@@) % ويا مطول هجراني بلا سبب % % أما بدا لك في التطويل تقصير % % 5(@)(@@) % ومنكرا ما ألاقي في محبته % % حبي كطرفك بين الناس مشهور % % 6(@)(@@) % أنا الكئيب المعنى في هواك وإن % % أظهرت أني بما ألقاه مسرور % % 7(@)(@@) % ألا خلاص لقلبي من صبابته % % فإنه في تعاطي الحب مغرور % % 8(@)(@@) % كم ذا أكابد ما لو مر أيسره % % بالطور دك له من ثقله الطور % % 9(@)(@@) % وكم أرى طاويا كشحي على شجن % % ونار شوق لها في القلب تسعير % % 10(@)(@@) % وكم أراقب ساري الطيف يطرقني % % وإنما الطيف تخييل وتزوير % % PageV01P300 11(@)(@@) % يا للحمى كم على واديه طل دم % % وكم فؤاد محب ثم مأسور % % 12(@)(@@) % وبي مليك جمال سيف مقلته % % مظفر بقلوب الناس منصور % % 13(@)(@@) % نبي حسن له من روض وجنته % % جنات عدن ومن ألحاظه حور % % PageV01P301 البحر : - 1(@)(@@) % دعا فؤادي يقاسي الشوق والكمدا % % في حب من لم يدع لي حبه جلدا % % 2(@)(@@) % لا تتعبا ففؤادي غير ممتثل % % إن رمتما منه إصلاح الذي فسدا % % 3(@)(@@) % أوسعتماه ملاما في الغرام وما % % وجدتما في الهوى بعض الذي وجدا 
ms73	 % % 4(@)(@@) % أستودع الله روحا في الهوى تلفت % % وفيه أحتسب الدمع الذي نفدا % % 5(@)(@@) % أجريته في ميادين الهوى غررا % % وللغرام مدى لا ينتهي أبدا % % 6(@)(@@) % وكان لي جسد أودى السقام به % % فها أنا اليوم لا روحا ولا جسدا % % 7(@)(@@) % نفسي الفداء لمعسول اللمى غنج % % تعلم الغصن منه اللين والميدا % % 8(@)(@@) % كالظبي حين عطا والليث حين سطا % % والغصن حين خطا والبدر حين بدا % % 9(@)(@@) % حاشا الرقيب فلا وصل أسر به % % منه خلا أنه بالوصل لي وعدا % % 10(@)(@@) % ما شمت منذ أظلت سحب عارضه % % بوارق الثغر إلا أمطرت بردا % % PageV01P302 11(@)(@@) % ولا أغازل ريما من مقلده % % إلا أنازل من الحاظه أسدا % % PageV01P303 البحر : - 1(@)(@@) % عيناي فيك بأسياف البكى اجترحا % % هذا وما اقترفا ذنبا ولا اجترحا % % 2(@)(@@) % يا من رأيت الهوى من أجله حسنا % % فيه ولو أنه في غيره قبحا % % 3(@)(@@) % ومن حوى الحسن دون الخلق عن كمل % % حتى غدا كيف شاء الحسن واقترحا % % 4(@)(@@) % ما ضر لو سمح المولى بزورته % % لمغرم في الهوى بالروح قد سمحا % % 5(@)(@@) % أضل وجهك حسادي عدمتهم % % حتى رأوه هلالا وهو شمس ضحى % % 6(@)(@@) % والله لو أن حسادي إذن نظروا % % أثيل فرعك بان الفرق واتضحا % % 7(@)(@@) % زد خاطري شررا أو ناظري سهرا % % وزد عظامي نحولا والحشا برحا % % 8(@)(@@) % أنا الذي ما شكا ثقل الهوى أبدا % % ولا أصاخ للاح فيك حين لحا % % PageV01P304 البحر : - 1(@)(@@) % إليك عني فما السلوان من شاني % % يكفيك ما سال في خدي من شاني % % 2(@)(@@) % ياعاذلي كيف أسلو عن هوى رشإ % % به تسليت عن صبري وسلواني % % 3(@)(@@) % لا تشتغل بي فقلبي عنك في شغل % % بما أكابد من شجو وأشجان % % 4(@)(@@) % رح عن هواي خلي القلب في دعة % % وخل ما بين أحشائي ونيراني % % 5(@)(@@) % نصحت والنصح مالي فيه من أرب % % ما كان أغناك عن هذا وأغناني % % 6(@)(@@) % يا بارد القلب قلبي منك في لهب % % واراقد الجفن قد أسهرت أجفاني % % 7(@)(@@) % ويا حبيبا حفظنا عهد صحبته % % في الحب أين مواثيقي وأيماني % % 8(@)(@@) % أحين ما غبت والأيام ما برحت % % تبدي الكمينين من 
ms74	 حقد وشنئآن % % 9(@)(@@) % نسيت محض ودادي فيك واعجبا % % ولم تزل قيد فكري كيف تنساني % % 10(@)(@@) % أغير البعد قلبا منك أعرفه % % أم هل سمعت مقال الحاسد الشاني % % PageV01P305 11(@)(@@) % أنا الذي لم يغيرني جفاك ولا % % همت بإخراج وجدي كف سلوان % % PageV01P306 البحر : - 1(@)(@@) % بلغت ما شئت من حزني ومن كمدي % % وما بلغت مدى للهجر منك مدي % % 2(@)(@@) % هلا ذكرت لقلبي قبل محنته % % أن المنية للعشاق بالرصد % % 3(@)(@@) % تعاطت الحب نفسي غير عالمة % % أن المحبة لا تبقي على أحد % % 4(@)(@@) % أشكو إلى الله ما ألقاه من كلف % % ولوعة أحرقت نيارانها كبدي % % 5(@)(@@) % يا أهل بابل رفقا بعض صدكم % % مالي على البين والهجران من جلد % % 6(@)(@@) % لقد وهبتكم روحي بلا ثمن % % وبعت نومي بتسهيدي يدا بيد % % 7(@)(@@) % وبالحمى لا عدته كل سارية % % ظبي لواحظه يفتكن بالأسد % % 8(@)(@@) % يحل عقد اصطباري في محبته % % بسحر ناظره النفاث في العقد % % 9(@)(@@) % ما فوق النبل من أهداب مقلته % % إلا وفرق بين الروح والجسد % % 10(@)(@@) % ولا تأود منه القد معتدلا % % إلا أبان الذي في البان من أود % % PageV01P307 البحر : - 1(@)(@@) % كيف البقا وجميل الصبر فيك فني % % أما ترى جسدي للسقم في كفن % % 2(@)(@@) % وما حياة كئيب قلبه أسفا % % قد بان عن جسد للسقم لم يبن % % 3(@)(@@) % يا ساكن القلب أجريت الدموع دما % % وما عطفت على جار ولا سكن % % 4(@)(@@) % ومرسل الطيف تعليلا وتسلية % % لكي أشاهد مرآى وجهه الحسن % % 5(@)(@@) % لم يطرق النوم باب الجفن من أسف % % فما ارتقا بي لطيف منك يطرقني % % 6(@)(@@) % ما ضر لو جدت للصب المشوق بما % % سلبته من منام أنت عنه غني % % 7(@)(@@) % إليك أشكو تلافي في هواك أسى % % وما أكابد من شجو ومن شجن % % 8(@)(@@) % نزهت سمعي وطرفي والجوانح عن % % هوى سواك وعن عذل وعن وسن % % 9(@)(@@) % وكيف يدركني طيف الخيال ولو % % وافي إلي لفرط السقم لم يرني % % 10(@)(@@) % يا منزلا كان بالجرعاء يجمعنا % % بكت عليك عيون العارض الهتن % % PageV01P308 11(@)(@@) % ويوم وصل قطعناه بكاظمه % % كأنه عارض في سالف الزمن % % 12(@)(@@) % أيام عين حسودي فيك نائمة % % عني 
ms75	 وعنك وعين الحظ تلحظني % % 13(@)(@@) % أيام كنت عن الواشين في صمم % % وكنت مني مكان الروح من بدني % % 14(@)(@@) % ما كنت أعرف ما شرع الغرام فمذ % % عرفت ناظرك الفتان عرفني % % 15(@)(@@) % ومذ عرفتك فارقت الحياة أسى % % يا ليت معرفتي إياك لم تكن % % PageV01P309 البحر : - 1(@)(@@) % وبي معذر خد ورد وجنته % % قد ظل يشكر صوب العارض الغدق % % 2(@)(@@) % عاينت من خده القاني وعارضه % % فيروزج الصبح مع يا قوته الشفق % % 3(@)(@@) % ولاح لي ثغره الدري في لعس % % كما تكلل خد الخود بالعرق % % 4(@)(@@) % وروضة الحسن في خديه مؤنقة % % وللمياه دبيب غير مسترق % % 5(@)(@@) % نزه لحاظك منه في لواحظه % % فالنرجس الغض فيها شاخص الحدق % % 6(@)(@@) % واعجب للوني وعقد الدر في فمه % % من أصفر فاقع أو أبيض يقق % % 7(@)(@@) % إذا تبسم يوما قلت قد طلعت % % شمس النهار ولاحت أنجم الغسق % % 8(@)(@@) % عانقته وهو مرخ من ذوائبه % % سترا يمد حواشيه على الأفق % % 9(@)(@@) % وإذ تنشقت من ريحان عارضه % % نشرا تعطر منه كل منتشق % % 10(@)(@@) % مسحت آثار لثمي خيفة بيدي % % حتى اكتست أرجا من نشره العبق % % PageV01P310 11(@)(@@) % يا تاركي فيه سكرانا أميد به % % سكرا كما نبه الوسنان من أرق % % 12(@)(@@) % ورافعي فوق أهل الحب مرتبة % % ما كان قط إليها قبل ذاك رقي % % 13(@)(@@) % هون قليلا على أهل الغرام فقد % % أركبتهم طبقا في الأرض عن طبق % % 14(@)(@@) % نفسي فداء سهام منك مرسلة % % لم تغن عنها صلاب البيض والدرق % % 15(@)(@@) % ووجنة أوقدت نار الغرام فمن % % مسته لم ينج منها غير محترق % % 16(@)(@@) % تبدو لنا من دم العشاق في حلل % % كما بدا السيف محمرا من العلق % % 17(@)(@@) % وقامة مثل غصن البان ناعمة % % بدت فهيجت الورقاء في الورق % % 18(@)(@@) % هيفاء مهما جرى ماء الشباب بها % % فالماء في هرب والغصن في قلق % % 19(@)(@@) % تغدو الغصون لديها وهي مطرقة % % والطير تسجع من تيه ومن شبق % % PageV01P311 البحر : - 1(@)(@@) % أكثرت عذلك لو وجدت مطيعا % % ونصحت جهدك لو وجدت سميعا % % 2(@)(@@) % هيجت في قلبي الجريح بلا بلا % % وأفضت من جفني القريح دموعا % % 3(@)(@@) % وقرعت مني بالملامة مسمعا 
ms76	 % % لا يسمع التأنيب والتقريعا % % 4(@)(@@) % قل للذي هجر المنازل والربى % % واختط أفئدة لنا وضلوعا % % 5(@)(@@) % أدري العواذل أنني بملامهم % % أزداد فيك صبابة وولوعا % % 6(@)(@@) % دعهم فلو نظروك أول نظرة % % كنا اشتركنا في هواك جميعا % % PageV01P312 البحر : - 1(@)(@@) % رح خاليا عما تكابد أضلعي % % واعذر محبا للملامة لا يعي % % 2(@)(@@) % أو فاعتبر سقمي ودمعي في الهوى % % واعذل هنالك ما بدا لك أو دع % % 3(@)(@@) % وأراك لمت وما رأيت معذبي % % فانظر إليه وقل هنالك تسمع % % 4(@)(@@) % آه لأنفاس يشب لهيبها % % لولا سحائب أدمع لم تقلع % % 5(@)(@@) % لا كنت من نار توقد في الحشا % % وجزيت خيرا يا سحائب أدمعي % % 6(@)(@@) % ماذا على المحتملين عشية % % لو تسمعون شكايتي وتضرعي % % 7(@)(@@) % رحلوا فكم تركوا لناس مقلة % % عبرى وقلب بالفراق مروع % % 8(@)(@@) % إياك يا شمس الضحى من بعدما % % غابت شموس خدورهم أن تطلعي % % 9(@)(@@) % يا دمع غير مخيب يا صبر غير % % مطرد يا قلب غير مودع % % 10(@)(@@) % إن ينكروا وجدي بهم وصبابتي % % فالسقم بينة على ما أدعي % % PageV01P313 11(@)(@@) % وأنا الوفي على النوى بعهودهم % % وصبابتي طبع بغير تطبع % % 12(@)(@@) % لا ودهم بعد الفراق بمهل % % عندي ولا سر الهوى بمضيع % % PageV01P314 البحر : - 1(@)(@@) % أما الشباب فقد تحمل راحلا % % والشيب حط على عذارك نازلا % % 2(@)(@@) % وارتد وجه العيش أسود حالكا % % بادي المحاق وكان بدرا كاملا % % 3(@)(@@) % واها لأيام قطعت مكابدا % % حر الغرام وكن ظلا زائلا % % 4(@)(@@) % ويقل أن أبكي لأيام الحمى % % أو أن أكون بها لروحي باذلا % % 5(@)(@@) % جررت أذيال الصبا فيها ولو % % أني عقلت لكنت فيها خاملا % % 6(@)(@@) % يا ليت موتي قبل أيام الصبا % % أو ليتني فيها أطعت العاذلا % % 7(@)(@@) % أيام أنحلت القوام المنثني % % ضما وبددت الوشاح الجائلا % % 8(@)(@@) % ما نبهت مني فؤادا راقدا % % نعس العيون ولا دعت متثاقلا % % 9(@)(@@) % واحبهن وهن كن قواتلي % % فاعجب لمقتول يحب القاتلا % % 10(@)(@@) % أتراه ما علم العيون صوارما % % قلبي ولا علم القدود ذوابلا % % PageV01P315 11(@)(@@) % ومليحة الدل التي في حبها % % أنفقت من صبري عليها الحاصلا % % 12(@)(@@) % لم ترض من ألبابنا وعيوننا % % حتى يصرن دمالجا وخلاخلا % % 13 
ms77	(@)(@@) % إني اعتبرت الصبر عنها والهوى فوجد ت % % ذا حقا وذلك باطلا % % 14(@)(@@) % لولاك يا ذات اللمى المعسول لم % % أهمل على الأطلال دمعا هاطلا % % 15(@)(@@) % ما السحر عندي ما ادعته بابل % % فرناك هذي السود تسحر بابلا % % PageV01P316 البحر : - 1(@)(@@) % أيا وجد ما أبقيت حتى على صبري % % ويا دمع أطلعت الوشاة على سري % % 2(@)(@@) % ويا قلب إن ساعدت من لام في الهوى % % فلا زلت في نار الصبابة والهجر % % 3(@)(@@) % ويا عاذلي إن كنت تطلب سلوتي % % فأطلق فؤادي فهو في ربقة الأسر % % 4(@)(@@) % وإلا فدعني والغرام فما سوى % % فؤادي يفنى أو سوى عبرتي تجري % % 5(@)(@@) % وعذرك في ترك الملامة واضح % % ومالي في ترك الصبابة من عذر % % 6(@)(@@) % ولم يتلق العذل قلبي وإنما % % تلقاه مني ما بأذني من وقر % % 7(@)(@@) % وبي فاتر الألحاظ تزري لحاظه % % ومعطفه المياد بالبيض والسمر % % 8(@)(@@) % إذا ما غزت ألحاظه قلب عاشق % % تعود سريعا بالغنيمة والنصر % % 9(@)(@@) % غزال إلى سوق القلوب جفونه % % جلبن الهوى من حيث أدري ولا أدري % % 10(@)(@@) % يعلم علم السحر هاروت إن رنا % % بناظره النفاث في عقد الصبر % % PageV01P317 11(@)(@@) % ويحكيه قد الغصن عند اعتداله % % إذا ما تثنى في غلائله الخضر % % 12(@)(@@) % وهيهات أين الغصن منه وما له % % رضاب سلافي ولا شنب دري % % 13(@)(@@) % عجبت لخمر لم أذقها بثغره % % على أنني منها مدى الدهر في سكر % % 14(@)(@@) % ونون عذار في صحيفة خده % % ولم تق ماضي مقلتيه من الكسر % % 15(@)(@@) % أبث له شجوي فيزداد قسوة % % إذا قلت يوما راقب الله في أمري % % 16(@)(@@) % إلى الله أشكو إن في القلب لوعة % % يضيق بها إن أضرمت نارها صبري % % 17(@)(@@) % وحاجات نفس عز عندي بلوغها % % وهن اقتراحي واشتراطي على الدهر % % PageV01P318 البحر : - 1(@)(@@) % دعوت إلى السلوان غير سميع % % وألزمت ترك الحب غير مطيع % % 2(@)(@@) % أمن بعد أن قامت شهودي على الهوى % % يجوز عن دعوى الغرام رجوعي % % 3(@)(@@) % ولو مثل ما قد قلت لي انه الهوى % % لما همت يوما في ربى وربوع % % 4(@)(@@) % ولكن جفون يوم نعمان فتر % % صوارمها لا تتقى بدروع % % 5(@)(@@) % وكنت على 
ms78	 الصبر الجميل معولا % % ألاقي به الأحداث غير جزوع % % 6(@)(@@) % فقد فرعني الصبر في مركز الهوى % % وفضت بغارات الغرام جموعي % % 7(@)(@@) % أسكان نعمان الأراك إلى متى % % وحتى متى وجدي بكم وولوعي % % 8(@)(@@) % مضى العمر فيكم وانقضى وصبابتي % % تؤجج نيران الجوى بضلوعي % % 9(@)(@@) % وقلتم خلي يدعي الحب باطلا % % سقامي لماذا فيكم ودموعي % % 10(@)(@@) % ألا رحمه سكان نعمان إنني % % بحمل الذي ألقاه غير ضليع % % PageV01P319 11(@)(@@) % أصد وهجران ولم آت في الهوى % % بذنب سوى ذلي لكم وخضوعي % % 12(@)(@@) % فإن كان فرط الحب ذنبي إليكم % % فيا ليت شعري ما يكون شفيعي % % 13(@)(@@) % رعى الله عصرا قد مضى لي بقربكم % % وشملي بكم إذ ذاك غير صديع % % 14(@)(@@) % إذ العيش غض والزمان مساعد % % وسربي بالهجران غير مروع % % 15(@)(@@) % وإذ أنا آوي من عزيز حماكم % % إلى مربع رحب الفناء مريع % % 16(@)(@@) % وددت لو أن الحزن ساعة بنتم % % عصاني وأن الصبر كان مطيعي % % 17(@)(@@) % وبالرغم مني أن أعيش لساعة % % أخاطبكم فيها بخير وديع % % 18(@)(@@) % أكفكف أسراب المدامع والهوى % % يقول أذيعي سره وأضيعي % % 19(@)(@@) % لي الله كم أمسي وأضحي متيما % % بحب منوع للوصال منيع % % 20(@)(@@) % بحب رشا لولاح للشمس وجهه % % لما أذنت من شرقها بطلوع % % PageV01P320 21(@)(@@) % من الغيد يحمي بالصفاح كناسه % % فكم من أسير حوله وصريع % % PageV01P321 البحر : - 1(@)(@@) % وأغيد وسنان اللحاظ قوامه % % قضيب نقا يعلوه بدر تمام % % 2(@)(@@) % مرامي سواجيه أصابت مقاتلي % % ولم أحظ منه مرة بمرامي % % 3(@)(@@) % فيا كبدي في الوصل منه تقطعي % % غراما ويا نفسي اذهبي بسلام % % 4(@)(@@) % ويا دمعي الجاري ونار جوانحي % % قفا حدثا عن صبوتي وغرامي % % 5(@)(@@) % ولم أنس يوما زرته وهو نائم % % وشوقي إليه جاذب بزمامي % % 6(@)(@@) % فأضرمت بالتقبيل نيران خده % % وأطفأت بالترشاف حر أوامي % % 7(@)(@@) % ونزهني في روضة من خدوده % % وأسكرني من ريقه بمدام % % 8(@)(@@) % وما كان يرضي بالوصال وإنما % % توهمني طيفا لفرط سقامي % % PageV01P322 البحر : - 1(@)(@@) % تخطر كالبدر المنير على غصن % % وأسفر عن ليل الذوائب في دجن % % 2(@)(@@) % ومن وقد غاب الرقيب برشفة % % من الشنب البراق أحلى من المن % % 3(@)(@@) % وقام يريني لحظه وقوامه 
ms79	 % % يقول استقم إن شئت للضرب والطعن % % 4(@)(@@) % غزال غدت تجني علي لحاظه % % وعهدي بالأغصان تجنى ولا تجني % % 5(@)(@@) % إذا ظن صدق العذل ضن بوصله % % فيقتل من لا يجتني الذنب بالظن % % PageV01P323 البحر : - 1(@)(@@) % وفي لي ولم يسمع كلام مفند % % وجاد بطيب الوصل عن غير موعد % % 2(@)(@@) % وقد أديم الليل للوصل طاويا % % من الدجن نحوي فدفدا بعد فدفد % % 3(@)(@@) % من الغيد يحكي وجهه البدر مشرقا % % على غصن لدن المعاطف أملد % % 4(@)(@@) % ولم أنس خمرا من لماه شربتها % % لها حبب من در ثغر منضد % % 5(@)(@@) % وخال يروم الصبر مني عن هوى % % يقل اصطباري عنده وتجلدي % % 6(@)(@@) % على حين ملكت الهوى غير نادم % % زمامي وأعطيت الصبابة مقودي % % 7(@)(@@) % فهلا وقلبي عن هوى الغيد فارغ % % طليق وأحكام الصبابة في يدي % % 8(@)(@@) % رعى الله أيام الصبا فلكم بها % % جنيت ثمار اللهو عن روضها الندي % % 9(@)(@@) % وحيا بنعمان الأراك أحبة % % هم مطلبي من كل شيء ومقصدي % % 10(@)(@@) % وروض سقته السحب أقداح وبلها % % وغنت عليه الورق ألحان معبد % % PageV01P324 11(@)(@@) % وقد عبثت ريح الصبا بغصونه % % فمن ساكن منها ومن متأود % % 12(@)(@@) % وصاغ الصبا فيه لمعصم نهره % % من الزهر حليا من لجين وعسجد % % 13(@)(@@) % ظللنا به والعمر مقتبل الصبا % % وهاني الحيا فيه يروح ويغتدي % % 14(@)(@@) % وقد سل أسياف البروق لوامعا % % وأقبل يحدو مرعدا بعد مرعد % % PageV01P325 البحر : - 1(@)(@@) % ولم أنس إذ زارت وسادي وقد غدا % % عليها من الليل البهيم لبوس % % 2(@)(@@) % على حين أودى بي أليم صدودها % % وبي من تباريح الغرام رسيس % % 3(@)(@@) % فبتنا بأهنا العيش في ذمة الدجى % % لنا من أحاديث الغرام دروس % % 4(@)(@@) % تغازلني منها عيون مريضة % % تسل قلوب دونها ونفوس % % 5(@)(@@) % وليس لنا غير الرضاب مدامة % % ولا غير لمياء الشفاة كؤوس % % 6(@)(@@) % فمن لثم ثغر كاللآلي منضد % % إلى ضم قد كالقناة يميس % % 7(@)(@@) % ونحسو مداما ما رأت كف عاصر % % ولا كدرتها بالمزاج قسوس % % 8(@)(@@) % ليالي لا شيب المفارق ضاحك % % علينا ولا وجه الزمان عبوس % % 9(@)(@@) % وحق على أهل الصبابة طاعتي % % فإني فيهم ما علمت رئيس % % PageV01P326 البحر : - 1(@)(@@) % ولم 
ms80	 أنس إذ زارت وسادي وقد غدا % % عليها من الليل البهيم لبوس ؛ % 2(@)(@@) % على حين أودى بي أليم صدودها % % وبي من تباريح الغرام رسيس ؛ % 3(@)(@@) % فبتنا بأهنا العيش في ذمة الدجى % % لنا من أحاديث الغرام دروس ؛ % 4(@)(@@) % تغازلني منها عيون مريضة % تسل قلوب دونها ونفوس ؛ % 5(@)(@@) % وليس لنا غير الرضاب مدامة % ولا غير لمياء الشفاة كؤوس ؛ % 6(@)(@@) % فمن لثم ثغر كاللآلي منضد % إلى ضم قد كالقناة يميس ؛ % 7(@)(@@) % ونحسو مداما ما رأت كف عاصر % ولا كدرتها بالمزاج قسوس % 8(@)(@@) % ليالي ؛ لا شيب المفارق ضاحك % علينا ولا وجه الزمان عبوس ؛ % 9(@)(@@) % وحق على أهل الصبابة طاعتي % % فإني فيهم ما علمت رئيس . % PageV01P327 البحر : - 1(@)(@@) % خليلي كفا عن ملام فتى صب % رويدكما ؛ ماذا يفيدكما عتبي % % 2(@)(@@) % تلومان قلبي أن يحب جهالة % ولم توردا قلبيكما مورد الحب % 3(@)(@@) % إلى الله أشكو إن في القلب لوعة ؛ % يضيق بها صدري ويشقى بها قلبي ؛ % 4(@)(@@) % بليت بمن لم أقض منه لبانتي ؛ % ومن لي لو أني قضيت به نحبي % % 5(@)(@@) % وقى الله من دل الحمام على فتى % له مقلة لا تستفيق من الصب ؛ % 6(@)(@@) % وما بي بغض للحياة وإنما % % رأيت لقاء الموت أروح للكرب ؛ % 7(@)(@@) % وحسبي ضنى في الحب أني لم أجد % سوى الموت للداء المخامر من طب ؛ % 8(@)(@@) % وبي جائر الأحكام لم يرض في الهوى % % بقتل الورى حتى تعدى إلى السلب ؛ % 9(@)(@@) % تلعب ريان الشباب بقده % % تلعب أيدي الريح بالغصن الرطب ؛ % 10(@)(@@) % ودون الشفاه اللعس حصباء لؤلؤ % ومطرد يجري من البارد العذب % % PageV01P328 11(@)(@@) % دعاني إلى حكم الصبابة بعد ما % % سلا رفقتي عن غيها وارعوى صحبي % % 12(@)(@@) % وقام يريني لحظه وقوامه ؛ % يقول استقم إن شئت للطعن والضرب ؛ % 13(@)(@@) % يقولون لي لا ترم طرفك نحوه % % فتكرار رجع الطرف داعية الحب ؛ % 14(@)(@@) % وهل نافعى أن لا أراه بناظري ؛ % وقد رسمت تلك المحاسن في قلبي % % PageV01P329 البحر : - 1(@)(@@) % هات عن أهل الحمى ما فعلوا % % هل أقاموا بعدنا أم رحلوا % % 2(@)(@@) % إن يكونوا رحلوا عن ناظري % % فبأكناف فؤادي نزلوا ؛ % 3(@)(@@) % عمرك الله إذا ما 