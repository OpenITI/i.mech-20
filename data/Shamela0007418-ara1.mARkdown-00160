ms141	 الماخكي (@)(@@) بفتح المعجمة إلى ماخك جد.(@)(@@)(@@)(@@) $DIC_NIS$ الماخواني (@)(@@) بضمها إلى ماخوان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الماخي (@)(@@) إلى ماخ رجل.(@)(@@)(@@)(@@) $DIC_NIS$ المادري (@)(@@) بفتح المهملة وراء إلى مادرة رجل.(@)(@@)(@@)(@@) $DIC_NIS$ المادرائي (@)(@@) بفتحها والراء إلى مادرايا قرية بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ الماذرائي (@)(@@) بوزنه والذال معجمة إلى ماذرا جد.(@)(@@)(@@)(@@) $DIC_NIS$ المارباني (@)(@@) بقتح الراء والباء الموحدة إلى ماربان قرية قرب أصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ المأربي (@)(@@) بكسر الراء وموحدة إلى مأرب ناحية باليمن منها أبيض بن حمال الصحابي: PageV01P232(@)(@@)(@@)(@@) $DIC_NIS$ الماردي (@)(@@) بكسر الراء ومهملة إلى ماردة جد.(@)(@@)(@@)(@@) $DIC_NIS$ المارديني (@)(@@) مثله إلى ماردين بلد بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ المارستاني (@)(@@) بفتح الراء إلى المارستان المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ المارشكي (@)(@@) بكسر الراء وسكون المعجمة إلى مارشك قرية بطوس.(@)(@@)(@@)(@@) $DIC_NIS$ المارملي (@)(@@) بكسر الراء وضم الميم ولام إلى مارمل قرية ببلخ قلت: المازري: بكسر الزاي وراء إلى مازر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ المازلي (@)(@@) بضم الزاي ولام إلى مازل قرية بنيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ المازني (@)(@@) بكسرهما ونون إلى مازن قبيلة من تميم ومن قيس عيلان ومن شيبان بن ذهل ومن طيء ومن الدئل.(@)(@@)(@@)(@@) $DIC_NIS$ المازياري (@)(@@) بكسرها وتحتية وراء إلى مازيار رجل صلبه المعتصم.(@)(@@)(@@)(@@) $DIC_NIS$ الماستيني (@)(@@) بسكون المهملة وكسر الفوقية وتحتية ونون إلى ماستين قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الماسخي (@)(@@) إلى ماسخة بخاء معجمة بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الماسرجسي (@)(@@) بفتح المهملة الأولى وسكون الراء وكسر الجيم إلى ماسرجس جد.(@)(@@)(@@)(@@) $DIC_NIS$ الماسكاني (@)(@@) بفتح المهملة إلى ماسكان بلد بنواحي كرمان.(@)(@@)(@@)(@@) $DIC_NIS$ الماسكي (@)(@@) بفتحها إلى ماسك جد.(@)(@@)(@@)(@@) $DIC_NIS$ المارسور (@)(@@) بضم المهملة وراء وموحدة وذال معجمة إلى مارسور قرية بجرجان. PageV01P233(@)(@@)(@@)(@@) $DIC_NIS$ الماشي (@)(@@) بمعجمة إلى بيع الماشي المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ الماصري (@)(@@) بكسر المهملة وراء إلى قيس الماصر لأنه أول من مصر الفرات ودجلة.(@)(@@)(@@)(@@) $DIC_NIS$ المافروخي (@)(@@) بفتح الفاء وضم الراء المشددة وخاء معجمة إلى مافروخ جد.(@)(@@)(@@)(@@) $DIC_NIS$ الماقلاصاني (@)(@@) بفتح القاف وصاد مهملة إلى ماقلاصان قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الماكسيني (@)(@@) بكسر الكاف والمهملة إلى ماكسين مدينة بالجزيرة.(@)(@@)(@@)(@@) $DIC_NIS$ الماكياني (@)(@@) بكسر الكاف وتحتية إلى ماكيان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الماكيني (@)(@@) بكسرها إلى ماكينة جد.(@)(@@)(@@)(@@) $DIC_NIS$ المالجي (@)(@@) بفتح اللام وجيم إلى مالج جد المالحاني: بكسر اللام ومهملة إلى بيع السمك المالح.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms142	 المالقي (@)(@@) بالكسر وقاف إلى مالقة بلد بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ المالكي (@)(@@) بطن من تغلب ومن عامر ومن أسد بن خزيمة ومن ثقيف ومن تميم ومن بكر بن وائل ومن الخزرج ومن الأزد ومن كندة ومن السكون ومن الحارث بن كعب ومن جعفي ومن بجيلة وإلى مذهب مالك وإلى المالكية قرية على الفرات.(@)(@@)(@@)(@@) $DIC_NIS$ الماليني (@)(@@) بكسر اللام إلى مالين قرى مجتمعة من عمل هراة.(@)(@@)(@@)(@@) $DIC_NIS$ المالي (@)(@@) إلى مالة جد.(@)(@@)(@@)(@@) $DIC_NIS$ المامطيري (@)(@@) بفتح الميمين وكسر المهملة وتحتية وراء إلى مامطير بلد بناحية آمل طبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ الماماني (@)(@@) إلى مامان جد. PageV01P234(@)(@@)(@@)(@@) $DIC_NIS$ المأموني (@)(@@) إلى المأمون الخليفة.(@)(@@)(@@)(@@) $DIC_NIS$ المانقاني (@)(@@) بسكون النون وقاف إلى مانقان محلة بسنج.(@)(@@)(@@)(@@) $DIC_NIS$ الماوردي (@)(@@) إلى بيع الماورد.(@)(@@)(@@)(@@) $DIC_NIS$ الماهاني (@)(@@) إلى ماهان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الماهياباذي (@)(@@) بكسر الهاء وتحتية وموحدة ةمعجمة إلى ماهياباذ محلة بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الماهياني (@)(@@) بكسر الهاء إلى ماهيان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ المايقي (@)(@@) بكسر التحتية وقاف إلى مايق قرية بنواحي أستوا.(@)(@@)(@@)(@@) $DIC_NIS$ المايمرغي (@)(@@) بسكون التحتية والراء وفتح الميمين آخره معجمة إلى مايمرغ قرية بنواحي نخشب وأخرى على طرف جيحون.(@)(@@)(@@)(@@) $DIC_NIS$ المايني (@)(@@) بكسر التحتية ونون إلى ماين من بلاد فارس.(@)(@@)(@@)(@@) $DIC_NIS$ المايوسي (@)(@@) بضم التحتية ومهملة.(@)(@@)(@@)(@@) || باب الميم والباء(@)(@@)(@@)(@@) $DIC_NIS$ المباردي (@)(@@) بكسر الراء ومهملة إلى عمل المبرد.(@)(@@)(@@)(@@) $DIC_NIS$ المباركي (@)(@@) إلى مبارك بلفظ المفعول بلد بين واسط وبغداد ونهر بالبصرة أيضا وجد.(@)(@@)(@@)(@@) $DIC_NIS$ المبارمي (@)(@@) بالفتح وكسر الراء المهملة إلى عمل المبرم وهو المبضع.(@)(@@)(@@)(@@) $DIC_NIS$ المبذولي (@)(@@) بالفتح وسكون الموحدة وضم المعجمة ولام إلى مبذول بطن من ضبة ومن الأنصار.(@)(@@)(@@)(@@) $DIC_NIS$ المبيضي (@)(@@) بالضم والفتح وكسر التحتية المشددة ومعجمة إلى البياض عرف به طائفة من الشيعة لهم لواء أبيض خالفوا به شعار العباسية.(@)(@@)(@@)(@@) || باب الميم والتاء(@)(@@)(@@)(@@) $DIC_NIS$ المتعي (@)(@@) بضم أوله والفوقية ومهملة إلى متع بطن من فهم. PageV01P235 المتكلم والمتطبب: إلى علم الكلام والطب.(@)(@@)(@@)(@@) $DIC_NIS$ المتكي (@)(@@) بالفتح والسكون إلى متك جد.(@)(@@)(@@)(@@) $DIC_NIS$ المتنبيء (@)(@@) أبو الطيب ادعى النبوة.(@)(@@)(@@)(@@) $DIC_NIS$ المتوثي (@)(@@) بالفتح وضم التاء المشددة آخره مثلثة إلى متوث بلد بين قرقوب والأهواز.(@)(@@)(@@)(@@) $DIC_NIS$ المتوكلي (@)(@@) إلى المتوكل على الله الخليفة.(@)(@@)(@@)(@@) $DIC_NIS$ المتوي 
ms143	 (@)(@@) بالفتح وضم التاء المشددة إلى متويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ المتي (@)(@@) بالفتح والتشديد إلى مت جد.(@)(@@)(@@)(@@) $DIC_NIS$ قلت: المتيجي (@)(@@) بالفتح وكسر الفوقية المشددة وتحتية وجيم إلى متيجة من ناحية بجاية انتهى.(@)(@@)(@@)(@@) || باب الميم والثاء(@)(@@)(@@)(@@) $DIC_NIS$ المثامني (@)(@@) بالفتح ومثلثة وكسر الميم ثم نون إلى المثامنة كان ملوك حمير يتخذون من أصحابهم ثمانية خواص يلي أحدهم بعد موت الملك فكانون يسمون بذلك.(@)(@@)(@@)(@@) || باب الميم والجيم(@)(@@)(@@)(@@) $DIC_NIS$ المجاسري (@)(@@) بالضم وجيم وكسر المهملة وراء إلى مجاسر بطن من طيء.(@)(@@)(@@)(@@) $DIC_NIS$ المجاشعي (@)(@@) بوزنه والشين معجمة وبعدها مهملة إلى مجاشع بطن من تميم وجد.(@)(@@)(@@)(@@) $DIC_NIS$ المجاشي (@)(@@) بالفتح آخره معجمة.(@)(@@)(@@)(@@) $DIC_NIS$ المجبر (@)(@@) جابر الكسر.(@)(@@)(@@)(@@) $DIC_NIS$ المجبري (@)(@@) مثله بزيادة ياء النسب إلى المجبر بن عبد الرحمن بن عمر بن الخطاب.(@)(@@)(@@)(@@) $DIC_NIS$ المجبستي (@)(@@) بفتح أوله والمهملة وضم الجيم وسكون الموحدة آخره فوقية إلى مجبست قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ المجداباذي (@)(@@) بالفتح وسكون الجيم ومهملة PageV01P236 وموحدة آخره معجمة إلى مجداباذ قرية بهمذان.(@)(@@)(@@)(@@) $DIC_NIS$ المجدر.(@)(@@) الذي به أثر الجدري.(@)(@@)(@@)(@@) $DIC_NIS$ المجدواني (@)(@@) بضم الميم والمهملة إلى مجدوان قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ المجدوني (@)(@@) بالكسر والسكون والضم إلى مجدون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ المجدعي (@)(@@) بالضم وفتح الجيم والمهملة المشددة وعين مهملة إلى المجدع بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ المجربي (@)(@@) بفتح الميم والراء وموحدة إلى مجربة بطن من كنانة ومن تميم.(@)(@@)(@@)(@@) $DIC_NIS$ المجزمي (@)(@@) بالكسر والسكون وفتح الزاي إلى المجزم بطن من سامة بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ المجفري (@)(@@) بالضم والفتح وكسر الفاء المشددة وراء إلى مجفر بطن من تميم وقال ابن ماكولا رحمه الله بسكون الجيم.(@)(@@)(@@)(@@) $DIC_NIS$ المجمر (@)(@@) بالضم والسكون والكسر نعيم كان يجمر المسجد أي يبخره.(@)(@@)(@@)(@@) $DIC_NIS$ المجندر (@)(@@) بالضم والفتح وسكون النون وكسر المهملة وراء الذي يجندر الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ المجمعي (@)(@@) بالضم والفتح وتشديد الميم ومهملة إلى مجمع بطن من جعفي.(@)(@@)(@@)(@@) $DIC_NIS$ المجوجي (@)(@@) بالفتح وسكون الجيم الأولى وفتح الواو إلى مجوجا لقب جد.(@)(@@)(@@)(@@) $DIC_NIS$ المجوسي (@)(@@) بالفتح والضم إلى درب المجوس محلة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ المجهولي (@)(@@) إلى المجهولية طائفة من الخوارج.(@)(@@)(@@)(@@) || باب الميم والحاء(@)(@@)(@@)(@@) $DIC_NIS$ المحاربي (@)(@@) بالضم ومهملة وكسر الراء إلى محارب بطن من قريش ومن 
ms144	 عبد القيس وجد.(@)(@@)(@@)(@@) $DIC_NIS$ المحاسبي (@)(@@) بالضم الحارث بن أسد الزاهد سمي به لكثرة محاسبته لنفسه.(@)(@@)(@@)(@@) $DIC_NIS$ المحاملي (@)(@@) بالفتح وكسر الميم الثانية إلى بيع المحامل التي يحمل فيها الناس في السفر.(@)(@@)(@@)(@@) $DIC_NIS$ المحبري (@)(@@) بالضم وفتح المهملة والباء المشددة وراء إلى حفظ كتاب المحبر لمحمد بن حبيب.(@)(@@)(@@)(@@) $DIC_NIS$ المحبقي (@)(@@) بوزنه وقاف إلى سلمة بن المحبق. PageV01P237(@)(@@)(@@)(@@) $DIC_NIS$ المحبوبي (@)(@@) بالفتح والسكون وضم الموحدة الأولى أبو العباس راوي الترمذي إلى جده محبوب.(@)(@@)(@@)(@@) $DIC_NIS$ المحثلي (@)(@@) بفتح أوله والمثلثة ولام إلى محثل بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ المحرمي (@)(@@) بالضم والسكون وكسر الراء إلى محرم.(@)(@@)(@@)(@@) $DIC_NIS$ المحفوظي (@)(@@) إلى محفوظ جد.(@)(@@)(@@)(@@) $DIC_NIS$ المحكمي (@)(@@) بالضم والفتح وتشديد الكاف المكسورة إلى المحكمة من الخوارج قالوا لعلي كيف تحكم.(@)(@@)(@@)(@@) $DIC_NIS$ المحملمي (@)(@@) بوزنه بلام إلى محلم بن تميم ومحلم بن ذهل بن شيبان.(@)(@@)(@@)(@@) $DIC_NIS$ المحلي (@)(@@) بفتحتين وتشديد اللام إلى المحلة بلد بديار مصر.(@)(@@)(@@)(@@) $DIC_NIS$ المحمداباذي (@)(@@) صدره بلفظ محمد ثم موحدة وآخره معجمة إلى محمد أباد محلة خارج نيسابور.(@)(@@)(@@)(@@) $DIC_NIS$ المحمدي (@)(@@) إلى محمد بن الحنفية.(@)(@@)(@@)(@@) $DIC_NIS$ المحمري (@)(@@) بتشديد المكسورة إلى المحمرة طائفة بابك لأنهم لبسوا الحمرة أيامه.(@)(@@)(@@)(@@) $DIC_NIS$ المحمودي (@)(@@) إلى محمود جد.(@)(@@)(@@)(@@) $DIC_NIS$ المحموي (@)(@@) مثله بلا دال إلى محمويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ المحمي (@)(@@) كالمرمي إلى محم جد.(@)(@@)(@@)(@@) $DIC_NIS$ المحولي (@)(@@) بالضم والفتح وتشديد الواو المفتوحة إلى محول قرية ببغداد.(@)(@@)(@@)(@@) || باب الميم والخاء(@)(@@)(@@)(@@) $DIC_NIS$ المخبزي (@)(@@) بفتح الميم والموحدة وسكون المعجمة بينهما وزاي إلى المخبز وهو موضع الخبز. PageV01P238(@)(@@)(@@)(@@) $DIC_NIS$ المخدوجي (@)(@@) بالفتح والسكون وضم المهملة وجيم إلى مخدوج بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ المخراقي (@)(@@) بالكسر آخره قاف إلى مخراق جد.(@)(@@)(@@)(@@) $DIC_NIS$ المخرمي (@)(@@) بفتح أوله والراء وسكون المعجمة إلى المسور بن مخرمة وبالضم والفتح وكسر الراء المشددة إلى المخرم محلة ببغداد نزلها ولد يزيد بن المخرم.(@)(@@)(@@)(@@) $DIC_NIS$ المخزومي (@)(@@) بالزاي إلى مخزوم قبيلة من كعب بن لؤي وبطن من عبس ومن هذيل.(@)(@@)(@@)(@@) $DIC_NIS$ المخشلبي (@)(@@) بفتح أوله والشين المعجمة واللام وموحدة إلى مخشلب وهو خرز.(@)(@@)(@@)(@@) $DIC_NIS$ المخلدي (@)(@@) بفتح أوله واللام إلى مخلد جد.(@)(@@)(@@)(@@) $DIC_NIS$ المخلص (@)(@@) بالضم والفتح وكسر اللام المشددة إلى تخليص الذهب من 
ms145	 الغش.(@)(@@)(@@)(@@) $DIC_NIS$ المخلطي (@)(@@) بالضم وفتح الخاء واللام المشددة إلى بيع المخلط وهو الفاكهة اليابسة من كل نوع.(@)(@@)(@@)(@@) $DIC_NIS$ المخولي (@)(@@) بوزنه إلى مخول جد.(@)(@@)(@@)(@@) $DIC_NIS$ المخي (@)(@@) بالفتح والتشديد إلى مخة جدة وبالضم إلى المخ جد.(@)(@@)(@@)(@@) || باب الميم والدال(@)(@@)(@@)(@@) $DIC_NIS$ المدائني (@)(@@) بالفتح إلى المدائن مدينة على سبعة فراسخ من بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ المدركي (@)(@@) بالضم والسكون وكسر الراء إلى مدرك جد.(@)(@@)(@@)(@@) $DIC_NIS$ المدلجي (@)(@@) بوزنه إلى مدلج بطن من كنانة ومن سعد هذيم.(@)(@@)(@@)(@@) $DIC_NIS$ المدني (@)(@@) يتلو في المديني.(@)(@@)(@@)(@@) $DIC_NIS$ المدوري (@)(@@) بالضم وفتح المهملة والواو المشددة وراء إلى المدور جد.(@)(@@)(@@)(@@) $DIC_NIS$ المدوي (@)(@@) بالفتح والضم إلى مدوة قرية ببنج ديه وبتشديد المهملة إلى مدويه جد.(@)(@@)(@@)(@@) $DIC_NIS$ المديانكثي (@)(@@) بالضم وسكون المهملة والنون وفتح التحتية والكاف ثم مثلثة إلى مديانكث قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ المديني (@)(@@) بفتح أوله والتحتية إلى مدين جد وبكسر المهملة وسكون التحتية إلى مدينة مرو ومدينة نيسابور ومدينة أصبهان ومدينة المبارك بقزوين ومدينة بخارى ومدينة سمرقند ومدينة نسف وبقلة إلى المدينة النبوية والأكثر إليها مدني بفتحتين.(@)(@@)(@@)(@@) || باب الميم والذال (@)PageV01P239(@)(@@)(@@)(@@) $DIC_NIS$ المذاري (@)(@@) بفتح أوله والمعجمة ثم راء إلى المذار قرية بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ المذحجي (@)(@@) بفتح الميم وسكون المعجمة وكسر الحاء المهملة وجيم إلى مذحج قبيلة من اليمن.(@)(@@)(@@)(@@) $DIC_NIS$ المذعوري (@)(@@) بالفتح والسكون وضم المهملة وراء إلى مذعور جد.(@)(@@)(@@)(@@) $DIC_NIS$ المذكر (@)(@@) الواعظ.(@)(@@)(@@)(@@) $DIC_NIS$ المذهبي (@)(@@) بالضم والسكون وكسر الهاء وموحدة أبو علي التميمي راوي المسند إلى جده المذهب.(@)(@@)(@@)(@@) $DIC_NIS$ المذيامجكثي (@)(@@) بالكسر والسكون وفتح التحتية والميم والكاف وسكون الجيم آخره مثلثة إلى مذيامجكث قرية بكرمينية.(@)(@@)(@@)(@@) $DIC_NIS$ المذيانكني (@)(@@) بالضم والسكون وتحتية ثم نون ساكنة بعدها كاف مفتوحة ونون إلى مذيانكن قرية ببخارى.(@)(@@)(@@)(@@) || باب الميم والراء(@)(@@)(@@)(@@) $DIC_NIS$ المرابطي (@)(@@) إلى مرابطة الثغور.(@)(@@)(@@)(@@) $DIC_NIS$ المراجلي (@)(@@) بالفتح وكسر الجيم ولام إلى عمل المراجل.(@)(@@)(@@)(@@) $DIC_NIS$ المرادي (@)(@@) بالضم إلى مراد بطن من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ المراري (@)(@@) بالفتح والتشديد إلى مرار جد وبالتخفيف إلى بيع المرار وهو حبال القنب وبالضم إلى آكل المرار وهو نبت.(@)(@@)(@@)(@@) $DIC_NIS$ المراغي (@)(@@) بالفتح آخره معجمة إلى المراغ قبيلة من الأزد والمراغة مدينة بأزربيجان قلت: وبلد بصعيد مصر 
ms146	 انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ المراقي (@)(@@) بالضم وقاف إلى المراقبة مدينة بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ قلت (@)(@@) قلت المراكشي: بالضم وتشديد الراء وكسر الكاف ومعجمة إلى مراكش انتهى. PageV01P240(@)(@@)(@@)(@@) $DIC_NIS$ المراني (@)(@@) بالفتح والتشديد إلى مران بطن من جعفي وبالضم والتشديد إلى ذي مران جد.(@)(@@)(@@)(@@) $DIC_NIS$ المراوحي (@)(@@) بالفتح إلى عمل المراوح.(@)(@@)(@@)(@@) $DIC_NIS$ المراي (@)(@@) بفتحتين وهمزة إلى امرئ القيس.(@)(@@)(@@)(@@) $DIC_NIS$ المربدي (@)(@@) بالكسر والسكون وفتح الموحدة ومهملة إلى المربد موضع بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ المربعي (@)(@@) بالضم وفتح الراء والموحدة المشددة ومهملة إلى رباط المربعة بسمرقند وبالضم والسكون وكسر الفوقية إلى مرتع بن معاوية بن كندة.(@)(@@)(@@)(@@) $DIC_NIS$ المرثدي (@)(@@) بفتح أوله والمثلثة ودال مهملة إلى مرثد جد.(@)(@@)(@@)(@@) $DIC_NIS$ المرجي (@)(@@) بالفتح والسكون وجيم إلى المرج بلد بالموصل وقرية بين بغداد وهمدان.(@)(@@)(@@)(@@) $DIC_NIS$ المرجئة (@)(@@) بالضم والسكون وكسر الجيم طائفة من القدرية أرجؤوا أي أخروا العمل عن الإيمان.(@)(@@)(@@)(@@) $DIC_NIS$ المرحبي (@)(@@) بفتح أوله والحاء المهملة وباء موحدة إلى مرحب جد.(@)(@@)(@@)(@@) $DIC_NIS$ المرداري (@)(@@) بالضم والسكون ومهملة وراء إلى مردار رأس المردارية من المعتزلة.(@)(@@)(@@)(@@) $DIC_NIS$ المرداسنجي (@)(@@) بالضم والسكون وفتح الدال والسين المهملتين وسكون النون وجيم إلى مرداسنحة لقب جد.(@)(@@)(@@)(@@) $DIC_NIS$ المرزباني (@)(@@) بالفتح والسكون وضم الزاي وموحدة إلى مرزبان جد.(@)(@@)(@@)(@@) $DIC_NIS$ المرزيني (@)(@@) بالضم والسكون وكسر الزاي إلى مرزين قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ المرسي (@)(@@) بالفتح والسكون ومهملة إلى المرس قرية نحو المدينة وبالضم إلى مرسية قرية بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ المرعشي (@)(@@) بفتح أوله والعين المهملة ومعجمة إلى مرعش بلد بالشام وجد.(@)(@@)(@@)(@@) $DIC_NIS$ المرغباني (@)(@@) بفتح أوله والمعجمة والموحدة إلى مرغبان قرية بكس.(@)(@@)(@@)(@@) $DIC_NIS$ المرغبوني (@)(@@) مثله بضم الباء الموحدة إلى مرغبون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ المرغيناني (@)(@@) بالفتح والسكون وكسر المعجمة PageV01P241 وتحتية ونونين بينهما ألف إلى مرغينان مدينة بفرغانة.(@)(@@)(@@)(@@) $DIC_NIS$ المرندي (@)(@@) بفتحتين وسكون النون ومهملة إلى مرند بلد بأذربيجان.(@)(@@)(@@)(@@) $DIC_NIS$ المروروذي (@)(@@) بفتح الميم والواو الأولى وضم الراء الثانية المشددة آخره معجمة إلى مرو الرود أشهر مدن خراسان.(@)(@@)(@@)(@@) $DIC_NIS$ المروتي (@)(@@) بفتح أوله والواو ثم فوقية إلى ذي المروة قرية بمكة أو المدينة.(@)(@@)(@@)(@@) $DIC_NIS$ المرودي (@)(@@) بالفتح أوله والواو ثم زاي إلى مرو الشاه جان ومحلة المراوزة ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ المروي (@)(@@) بفتحتين إلى 
ms147	 مروة مدينة بالحجاز نحو وادي القرى.(@)(@@)(@@)(@@) $DIC_NIS$ المرهبي (@)(@@) بالضم والسكون وكسر الهاء وموحدة إلى مرهبة بطن من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ المريدي (@)(@@) بالضم والفتح وسكون التحتية ومهملة. PageV01P242(@)(@@)(@@)(@@) $DIC_NIS$ المريسي (@)(@@) بالفتح وكسر الراء وتحتية ومهملة إلى مريس قرية بمصر منها بشر المريسي.(@)(@@)(@@)(@@) $DIC_NIS$ المريضي (@)(@@) بوزنه ومعجمة إلى المريض جد.(@)(@@)(@@)(@@) $DIC_NIS$ المريني (@)(@@) بالضم والكسر وتحتية ونون إلى مرين قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ المري (@)(@@) بالفتح والتشديد إلى مر بطن من طيء والمرية بلد بالأندلس وبالضم إلى مرة بطن من غطفان ومن عبد القيس ومن جهينة ومن طيء ومن همدان ومن قضاعة ومن تميم ومن شيبان.(@)(@@)(@@)(@@) $DIC_NIS$ المريقي (@)(@@) بالضم وكسر الراء المشددة وتحتية وقاف.(@)(@@)(@@)(@@) || باب الميم والزاي(@)(@@)(@@)(@@) $DIC_NIS$ المزاحمي (@)(@@) بالضم والزاي والحاء المهملة إلى مزاحم جد والمزاحمة قرية برحبة مالك بن طوق.(@)(@@)(@@)(@@) $DIC_NIS$ المزرقي (@)(@@) بالفتح وسكون الزاي وفتح الراء PageV01P243 وقاف إلى المزرقة قرية قرب بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ المزرنكي (@)(@@) بفتح أوله والراء والكاف وسكون الزاي والنون الأولى إلى مزرنكن قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ المزكي (@)(@@) بالتشديد الذي يزكي الشهود.(@)(@@)(@@)(@@) $DIC_NIS$ المزنوي (@)(@@) بضم أوله والنون إلى مزنوى قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ المزني (@)(@@) بالضم والسكون إلى مزن قرية بسمرقند وبفتح الزاي إلى مزينة بنت كلب بن وبرة إلى مزنة قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ المزبري (@)(@@) بالفتح وكسر الزايين إلى مزيز جد.(@)(@@)(@@)(@@) $DIC_NIS$ المزيناني (@)(@@) بالفتح والكسر إلى مزينان بلد بخراسان.(@)(@@)(@@)(@@) $DIC_NIS$ المزي (@)(@@) بالكسر والتشديد إلى المزة قرية بدمشق.(@)(@@)(@@)(@@) || باب الميم والسين(@)(@@)(@@)(@@) $DIC_NIS$ المساحقي (@)(@@) بالضم إلى مساحق جد.(@)(@@)(@@)(@@) $DIC_NIS$ المسافري (@)(@@) بالضم إلى مسافر جد.(@)(@@)(@@)(@@) $DIC_NIS$ المسائلي (@)(@@) بالفتح إلى المسائل.(@)(@@)(@@)(@@) $DIC_NIS$ المسبحي (@)(@@) إلى مسبح بلفظ فاعل سبح جد.(@)(@@)(@@)(@@) $DIC_NIS$ المستعيني (@)(@@) إلى المستعين الخليفة.(@)(@@)(@@)(@@) $DIC_NIS$ المستغفري (@)(@@) إلى المستغفر جد.(@)(@@)(@@)(@@) $DIC_NIS$ المستملي (@)(@@) الذي يستملي على العلماء. PageV01P244(@)(@@)(@@)(@@) $DIC_NIS$ المستيناني (@)(@@) بالفتح والسكون وكسر الفوقية وتحتية ونونين بينهما ألف إلى مستينان قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ المسدي (@)(@@) بالضم والفتح وتشديد المهملة الذي يعمل سدى الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ المسروقي (@)(@@) إلى مسروق جد.(@)(@@)(@@)(@@) $DIC_NIS$ المسعري (@)(@@) بالكسر والسكون وفتح العين المهملة وراء إلى مسعر جد.(@)(@@)(@@)(@@) $DIC_NIS$ المسعودي (@)(@@) إلى مسعود رجل.(@)(@@)(@@)(@@) $DIC_NIS$ المسكيني (@)(@@) إلى مسكين بن الحارث صاحب الشافعي رضي الله 
ms148	 تعالى عنه.(@)(@@)(@@)(@@) $DIC_NIS$ المسكي (@)(@@) بالكسر إلى بيع المسك.(@)(@@)(@@)(@@) $DIC_NIS$ المسلمي (@)(@@) إلى المسلمة جدة.(@)(@@)(@@)(@@) $DIC_NIS$ المسلي (@)(@@) بالضم والسكون ولام إلى مسلية قبيلة من مذحج ومحلة لهم بالكوفة.(@)(@@)(@@)(@@) $DIC_NIS$ المسمعي (@)(@@) بكسر الميم الأولى وفتح الثانية إلى مسمع.(@)(@@)(@@)(@@) $DIC_NIS$ المسناني (@)(@@) بالكسر والسكون ونونين إلى مسنان قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ المسندي (@)(@@) بالضم وفتح النون إلى الحديث المسند.(@)(@@)(@@)(@@) $DIC_NIS$ المسوحي (@)(@@) بضمتين إلى المسوح الشعر.(@)(@@)(@@)(@@) $DIC_NIS$ المسوسي (@)(@@) بفتح أوله والواو وسكون المهملة الأولى إلى مسوس قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ المسيبي (@)(@@) بالضم وفتح المهملة والتحتية المشددة وموحدة إلى المسيب جد.(@)(@@)(@@)(@@) $DIC_NIS$ المسيحي (@)(@@) بالفتح والكسر ومهملة إلى مسيح جد.(@)(@@)(@@)(@@) || باب الميم والشين(@)(@@)(@@)(@@) $DIC_NIS$ المشاط (@)(@@) إلى عمل الأمشاط.(@)(@@)(@@)(@@) $DIC_NIS$ المشاطي (@)(@@) بالفتح والتشديد إلى مشاط رجل.(@)(@@)(@@)(@@) $DIC_NIS$ المشاني (@)(@@) بالضم والتخفيف إلى مشان قرية PageV01P245 بالبصرة.(@)(@@)(@@)(@@) $DIC_NIS$ المشتلي (@)(@@) بفتح أوله والفوقية وسكون المعجمة ولام إلى مشتلة قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ المشتولي (@)(@@) بضمهما وسكون الشين المعجمة إلى مشتول قرية بمصر.(@)(@@)(@@)(@@) $DIC_NIS$ المشتوي (@)(@@) مثله.(@)(@@)(@@)(@@) $DIC_NIS$ المشجعي (@)(@@) بفتح أوله والجيم وسكون المعجمة آخره مهملة إلى مشجعة بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ المشرقي (@)(@@) بالكسر والسكون وفتح الراء وقاف إلى مشرق بطن من همدان المشرقي بالضم والسكون والكسر إلى مشرق رجل.(@)(@@)(@@)(@@) $DIC_NIS$ المشروقي (@)(@@) بالفتح والسكون والضم إلى مشروق بقعة باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ المشطاحي (@)(@@) بالكسر والسكون ومهملتين.(@)(@@)(@@)(@@) $DIC_NIS$ المشظي (@)(@@) بالكسر وتشديد المعجمة إلى المشظ بطن من كلب.(@)(@@)(@@)(@@) $DIC_NIS$ المشغراني (@)(@@) بفتح أوله والغين المعجمة والراء إلى مشغرا قرية بدمشق.(@)(@@)(@@)(@@) $DIC_NIS$ المشكاني (@)(@@) بالضم والسكون إلى مشكان قرية بنواحي همذان وجد.(@)(@@)(@@)(@@) || باب الميم والصاد(@)(@@)(@@)(@@) $DIC_NIS$ المصاحفي (@)(@@) إلى كتابة المصاحف.(@)(@@)(@@)(@@) $DIC_NIS$ المصامدي (@)(@@) بكسر الميم الثانية ودال مهملة إلى المصامدة بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ المصراثائي (@)(@@) بالكسر والسكون وراء ومثلثة إلى مصراثا قرية بسواد بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ المصري (@)(@@) بالكسر إلى مصر الشهيرة.(@)(@@)(@@)(@@) $DIC_NIS$ المصطلقي (@)(@@) بالضم والسكون وفتح الطاء وكسر اللام وقاف إلى بني المصطلق بطن من خزاعة.(@)(@@)(@@)(@@) $DIC_NIS$ المصعبي (@)(@@) بالضم والسكون وفتح العين المهملة وموحدة إلى مصعب جد.(@)(@@)(@@)(@@) $DIC_NIS$ المصقلي (@)(@@) بفتح أوله والقاف إلى مصقلة جد.(@)(@@)(@@)(@@) $DIC_NIS$ المصمودي (@)(@@) بالفتح والسكون والضم آخره مهملة إلى مصمودة قبيلة من البربر بالغرب. PageV01P246(@)(@@)(@@)(@@) $DIC_NIS$ المصيصي (@)(@@) بكسر 
ms149	 الميم والمهملة المشددة إلى المصيصة مدينة على ساحل البحر.(@)(@@)(@@)(@@) || باب الميم والضاد(@)(@@)(@@)(@@) $DIC_NIS$ المضري (@)(@@) بالضم وفتح المعجمة وراء إلى مضر بن نزار.(@)(@@)(@@)(@@) $DIC_NIS$ المطاعي (@)(@@) إلى مطاع جد.(@)(@@)(@@)(@@) $DIC_NIS$ المطاميري (@)(@@) بالفتح وكسر الميم الثانية وراء إلى المطامير ضيعة بحلوان.(@)(@@)(@@)(@@) $DIC_NIS$ المطبخي (@)(@@) بفتح أوله والباء الموحدة إلى المطبخ المعروف.(@)(@@)(@@)(@@) $DIC_NIS$ المطرز (@)(@@) إلى تطريز الثياب.(@)(@@)(@@)(@@) $DIC_NIS$ المطرفي (@)(@@) بالضم والفتح وكسر الراء المشددة وفاء إلى مطرف جد.(@)(@@)(@@)(@@) $DIC_NIS$ المطرفي (@)(@@) بالكسر والسكون وفتح الراء وفاء إلى مطرف لقب عبد الله بن عمرو بن عثمان بن عفان رضي الله تعالى عنهم.(@)(@@)(@@)(@@) $DIC_NIS$ المطردودي (@)(@@) إلى مطرود فخذ من سليم.(@)(@@)(@@)(@@) $DIC_NIS$ المطري (@)(@@) بفتحتين إلى مطر جد وبطن من ذهل بن شيبان قلت: وإلى المطرية بلد بمصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ المطلبي (@)(@@) بالضم وتشديد الطاء المفتوحة وكسر اللام وموحدة إلى المطلب بن عبد مناف.(@)(@@)(@@)(@@) $DIC_NIS$ المطوعي (@)(@@) بالضم وفتح الطاء المشددة وكسر الواو ومهملة إلى المطوعة وهم الذين أرصدوا أنفسهم للجهاد.(@)(@@)(@@)(@@) $DIC_NIS$ المطهري (@)(@@) بالضم وفتح الطاء والهاء المشددة إلى مطهر قرية من عمل مازندارن وجد.(@)(@@)(@@)(@@) $DIC_NIS$ المطيبي (@)(@@) بوزنه إلى المطيب جد.(@)(@@)(@@)(@@) $DIC_NIS$ المطيري (@)(@@) بالفتح والكسر إلى المطيرة قرية بنواحي سر من رأى.(@)(@@)(@@)(@@) || باب الميم والظاء(@)(@@)(@@)(@@) $DIC_NIS$ المظالمي (@)(@@) الذي ترفع إليه الظلامات فيرفعها.(@)(@@)(@@)(@@) $DIC_NIS$ المظهري (@)(@@) بالضم وفتح المعجمة والهاء المشددة إلى مظهر جد.(@)(@@)(@@)(@@) || باب الميم والعين(@)(@@)(@@)(@@) $DIC_NIS$ المعاذي (@)(@@) بالضم آخره معجمة إلى معاذ جد.(@)(@@)(@@)(@@) $DIC_NIS$ المعاركي (@)(@@) بالضم وكسر الراء إلى معارك جد.(@)(@@)(@@)(@@) $DIC_NIS$ المعاز (@)(@@) إلى رعاية المعزى.(@)(@@)(@@)(@@) $DIC_NIS$ المعافري (@)(@@) بالفتح وكسر الفاء وراء إلى المعافر بطن من قحطان. PageV01P247(@)(@@)(@@)(@@) $DIC_NIS$ المعاولي (@)(@@) بوزنه إلى المعاول بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ المعاوي (@)(@@) بالضم إلى معاوية بطن من الأوس ومن كندة وجد.(@)(@@)(@@)(@@) $DIC_NIS$ المعبدي (@)(@@) بفتح أوله والموحدة إلى أم معبد الخزاعية ومعبد بن العباس بن عبد المطلب والمعبدية من الخوارج رأسهم معبد.(@)(@@)(@@)(@@) $DIC_NIS$ المعبر (@)(@@) إلى تأويل الرؤيا.(@)(@@)(@@)(@@) $DIC_NIS$ المعبري (@)(@@) بوزنه إلى معبر جد.(@)(@@)(@@)(@@) $DIC_NIS$ المعتزلي (@)(@@) إلى الاعتزال لأن رأسهم واصل بن عطاء كان يجلس إلى الحسن البصري رضي الله تعالى عنه فلما أظهر رأيه طرده عنه فاعتزل عنه. 
