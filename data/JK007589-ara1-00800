ms781	(@)(@@) % يكنى أبا الفضل وهو منتجع ال % % فضل وماقلت ذاك عن ملق % % 10(@)(@@) % وخير مايكتنى الرجال به % % كنية لا نحلة ولاسرق % % PageV01P3068 11(@)(@@) % عبد المليك المقلد المنن ال % % زهر قديما معاقد الريق % % 12(@)(@@) % يتخذ المال حين يملكه % واقية كالدروع والدرق % % 13(@)(@@) % من آل عباس الكرام ذوي ال % % سؤدد والفائزين بالسبق % 14(@)(@@) % بحر بحور إذا نزلت به % % أصبحت من موجه بمصطفق % % 15(@)(@@) % يفهق بالنائلين ساجله % % عند السؤالين أيما فهق % % 16(@)(@@) % منطلق الكف واللسان إذا % % سوئل وامتيح أي منطلق % % 17(@)(@@) % بنائل من ندى وآخر من % % علم ففيه أتم مرتفق % % 18(@)(@@) % يجري إلى كل غاية شطط % لم تلتمس قبله ولم تطق % % 19(@)(@@) % كما جرى الطرف غير ذي صكك % يفل من غربه ولاطرق % 20(@)(@@) % شاهد أعراقه التي كرمت % % صفاء أخلاقه من الرنق % % PageV01P3069 21(@)(@@) % أصبح من فضله يحل من ال % % أهواء طرا بملتقى الفرق % % 22(@)(@@) % ظلنا لديه بمنزل خصب % في مرع تارة وفي غدق % 23(@)(@@) % يسمعنا الشدو عنده غرد % كالسطر في المسمعين لا اللحق % % 24(@)(@@) % يشدو فيحيي لنا السرور وإن % % ألفاه ميتا في آخر الرمق % % 25(@)(@@) % متى يقدر لمن ينادمه % مصطبح يتصل بمغتبق % 26(@)(@@) % يسقي الندامى فيشربون له % % كشرب فرعون ساعة الغرق % % 27(@)(@@) % قديمه مطرب ومحدثه % فهو جديد الجديد والخلق % % 28(@)(@@) % ماعيبه غير أنه رجل % يدعو ذويحلمنا إلى النزق % % 29(@)(@@) % يقلق من حسن مايجيء به الز % زميت بل يطمئن ذو القلق % % 30(@)(@@) % كنيته شقة السلامة والس % % سلم سلام لتلك في الشققص أبو سليمان ذو الإصابة وال % % PageV01P3070 31(@)(@@) % إحسان وابن الملوك لا السوق % ياحسن ذاك الغناء يشفعه % % 32(@)(@@) % هدير تلك الحمائم الحزق % من ذي تلاوين وشيه حسن % 33(@)(@@) % ومن بهم الدجى ومن لهق % % ونحن نسقي شراب ذي فجر % 34(@)(@@) % ثناؤه من فواكه الرفق % % لايمنع الري طالبيه ولا % % 35(@)(@@) % يسقي نديما له على تأق % % وفاه قوامه قيامهم % 36(@)(@@) % وأنفقت كفه بلا فرق % % على دنان كأنها جثث % 37(@)(@@) % من قوم عاد عظيمة الخلق % % فجاء شيء إذا الذباب دنا % % 38(@)(@@) % منه دنوا دنا من الزهق % % يلقاك في رقة الشراب وفي % % 39 
ms782	(@)(@@) % نشر الخزامى وصفرة الشفق % ظاهره ظاهر يحرمه % % 40(@)(@@) % وما على شاربيه من رهق % % له صريح كأنه ذهب % PageV01P3071 41(@)(@@) % ورغوة كاللآلىء الفلق % % يختال في منظر يزينه % % 42(@)(@@) % من الرحيق العتيق مسترق % تديره جونة تحرق بالد % % 43(@)(@@) % ل إذا البيض جدن بالرمق % % سوداء لم تنتسب إلى برص الش % 44(@)(@@) % قر ولا كلفة ولابهق % % ليست من العبس الأكف ولا ال % % 45(@)(@@) % فلح الشفاه الخبائث العرق % % بل من بنات الملوك ناعمة % 46(@)(@@) % تنشر بالدل ميت الشبق % % في لين سمورة تخيرها ال % % 47(@)(@@) % فراء أو لين جيد الدلق % تذكرك المسك والغوالي والس % 48(@)(@@) % سك ذوات النسيم والعبق % هيفاء زينت بخمص محتضن % 49(@)(@@) % أوفى عليه نهود معتنق % % غصن من الأبنوس ألف من % % 50(@)(@@) % مؤتزر معجب ومنتطق % % يهتز من ناهديه في ثمر % PageV01P3072 51(@)(@@) % ومن دواجي ذراه في ورق % % أكسبها الحب أنها صبغت % 52(@)(@@) % صبغة حب القلوب والحدق % فانصرفت نحوها الضمائر وال % % 53(@)(@@) % أبصار يعنق أيما عنق % يفتر ذاك السواد عن يقق % 54(@)(@@) % من ثغرها كاللآلىء النسق % كأنها والمزاح يضحكها % % 55(@)(@@) % ليل تفرى دجاه عن فلق % % سحماء كالمهرة والمطهمة الد % 56(@)(@@) % دهماء تنضو أوائل الصيق % % تجري ويجري رسيلها معها % % 57(@)(@@) % شأوين مستعجلين في طلق % % لها هن تستعير وقدته % 58(@)(@@) % من قلب صب وصدر ذي حنق % % كأنما حره لخابره % % 59(@)(@@) % ما ألهبت في حشاه من حرق % % يزداد ضيقا على المراس كما % % 60(@)(@@) % تزداد ضيقا أنشوطة الوهق % % له إذا ما القمد خاطه % % PageV01P3073 61(@)(@@) % أزم كأزم الخناق بالعنق % يقول من حدث الضمير به % % 62(@)(@@) % طوبى لمفتاح ذلك الغلق % % أخلق بها أن تقوم عن ذكر % 63(@)(@@) % كالسيف يفري مضاعف الحلق % % إن جفون السيوف أكثرها % % 64(@)(@@) % أسود والحق غير مختلق % % خذها أبا الفضل كسوة لك من % % 65(@)(@@) % خر الأماديح لا من الخرق % % وصفت فيها الذي هويت على ال % % 66(@)(@@) % وهم ولم تختبر ولم تذق % إلا بأخبارك التي وقعت % 67(@)(@@) % منك إلينا عن ظبية البرق % حاشا لسوداء منظر سكنت % 68(@)(@@) % دارك إلا من مخبر يقق % % وبعض مافضل السواد به % % 69(@)(@@) % والحق ذو سلم وذو 
ms783	 نفق % % أن لا تعيب السواد حلكته % 70(@)(@@) % وقد يعاب البياض بالبهق % % واها لها خلعة تشق أخا الض % PageV01P3074 71(@)(@@) % ضغن ولا تستشق عن حرق % % أتاك طوعا وداد قائلها % % 72(@)(@@) % ولم يعد كارها ولم يسق % وإن منعت الصحاب أكسية % 73(@)(@@) % تقي أذى القر أو أذى اللثق % مستأثرا دونهم بلبسكها % % 74(@)(@@) % لامعقبا فيقة من الفيق % % أعقبهم لاتقم بمخترق الذ % % 75(@)(@@) % ذم فتلفى بأي مخترق % % لحاجتي إن بعثتها لي في % % 76(@)(@@) % إسكاف والدير وجه متفق % % أولا فما سد باب معذرة % 77(@)(@@) % كلا ولا سد باب مرتزق % % ن % PageV01P3075 البحر : - 1(@)(@@) % أقول وقدقالت لطالب رفدها % % رويدك إن الرفق أبقى وألحق % % 2(@)(@@) % إذا أنت لم تسعف جديدا بحاجة % فأنت إذا أخلقت بالرد أخلق % 3(@)(@@) % وقالت تأن القلب يعلق به الهوى % % ونعلم يقينا هل لحبك مصدق % % 4(@)(@@) % هنالك تؤتى كل نيل طلبته % وتفتح بابا كان دونك يغلق % % 5(@)(@@) % فقلت لها لم تبعدي غير أنه % % مبادرة الآفات ياحب أوثق % % 6(@)(@@) % أحاذر موتا فاجعا أو شييبة % % أفات بها أو ألفة تتفرق % % 7(@)(@@) % وأشياء شتى من قلى وملالة % ومن بدل يحلى بعين فيعشق % % 8(@)(@@) % فكيف ترجي أن يدوم وصالنا % % على حالة والدهر لونان أبلق % PageV01P3076 البحر : - 1(@)(@@) % قل لمن يملك رقي % سيدي قد حان عتقي % % 2(@)(@@) % أنت لي مولى ظلوم % لاتكافئني بعشقي % % 3(@)(@@) % غير أني بك صب % شهد الله بصدقي % % 4(@)(@@) % أيها القائل صبرا % طال بي صبري ورفقي % % 5(@)(@@) % جعل الله مليكي % % في جنان الخلد رزقي % % PageV01P3077 البحر : - 1(@)(@@) % له قلم يستتبع السيف طائعا % تطوع ذناباه التي لا تفارقه % 2(@)(@@) % وما ذنب الأقلام إلا ممثلا % بهن سيوف الهند كيف تطابقه % % PageV01P3078 البحر : - 1(@)(@@) % رأيت التقاط جنى نخلة % إذا ساقطته ولم ترقها % % 2(@)(@@) % أكن لكفك من شوكها % % وإن هي لم توفها حقها % % 3(@)(@@) % لقد أحسنت نخلة أنزلت % على كف ممتاحها رزقها % % 4(@)(@@) % وما جشمت كفه شوكها % % ولا جشمت رجله سحقها % % PageV01P3079 البحر : - 1(@)(@@) % أبا حسن خان ذاك النبي % % ذ عرق تفصد منه العروق % 2(@)(@@) % غدا وهو ترعف منه الأنو % % ف كرها وتشرق فيه الحلوق % 3(@)(@@) % وروحي 
ms784	 تتوق إلى غيره % % وأنت إلى العرف عندي تتوق % % 4(@)(@@) % فصلني بدستيجة عذبة % فأني إليها مشوق مشوق % % 5(@)(@@) % أصلك بدستيجة مثلها % % من الخل تغلو وللخل سوق % % 6(@)(@@) % لابد منها وأنت الذي % % بصغرى أياديه تقضى الحقوق % PageV01P3080 البحر : - 1(@)(@@) % لست أبكي على نوال صديق % راعني بعد بره بالعقوق % % 2(@)(@@) % إنما أشتكي فساد وداد % حال مجناه من جفاف العروق % 3(@)(@@) % أحمد الخالق الذي لو رعاني % % لم يكل حاجتي إلى مخلوق % % 4(@)(@@) % صرت كلا على الصديق مصاغا % طالبا منه غير مامرزوق % % 5(@)(@@) % تلك عندي مصيبتان ويكفي % % بعض إحداهما شجا في الحلوق % % 6(@)(@@) % يا أبا سهل الذي اعتد حقي % % ظالما من محقرات الحقوق % 7(@)(@@) % أنا بالله عائذ من عنوق % سمتني أخذهن من بعد نوق % 8(@)(@@) % سمتني الخسف والجفاء وغرب % % ت بذاك الجفاء بعد الشروق % % 9(@)(@@) % وتلونت لي وأخلفني نو % ؤك إلا تملقا ببروق % % 10(@)(@@) % إن هذا لحادث لم أخله % % في طروق الخطوب ذات الطروق % % PageV01P3081 11(@)(@@) % كم عدات نسختها بعدات % حل إنجازها من العيوق % % 12(@)(@@) % لاتصدق مقالة ابن خرخشا % % ذ فما عائب لكم بصدوق % % 13(@)(@@) % زعم الشيخ أن مولدك المي % % مون في الغدر غير ما مسبوق % % 14(@)(@@) % مولد فيه كوكب لك يحذي % % ك ملالا لكل إلف علوق % % 15(@)(@@) % ولما ريعت القلوب ولا لي % % عت بشيء كمبغض موموق % % PageV01P3082 البحر : - 1(@)(@@) % قد قلت بيتا لك تلقاءه % نادرة توجب إحناقي % % 2(@)(@@) % فلا تنادر قائلا عنده % % أخاف أن يحزن معناقي % % 3(@)(@@) % ضاق خناقي فالتمس قطعة % ولاتكن عونا لخناقي % % 4(@)(@@) % فما أخو ودي بتلعابة % يلعب بالنار لإحراقي % % 5(@)(@@) % يضحي إذا جاددته عابثا % والجد من خلقي وأخلاقي % % 6(@)(@@) % عندك ماء فأجز غصتي % % أو لا فإياك وإشراقي % % 7(@)(@@) % أمرضني عسري وقد خلتني % % عند مداواتك إفراقي % % PageV01P3083 البحر : - 1(@)(@@) % لا تكثرن ملامة العشاق % فكفاهم بالوجد والأشواق % 2(@)(@@) % إن البلاء يطاق غير مضاعف % فإذا تضاعف كان غير مطاق % 3(@)(@@) % أتلومهم للنفع أم لتزيدهم % % باللوم إقلاقا على إقلاق % 4(@)(@@) % ما للذي أضحى يلوم ذوي الهوى % % أمسى صريع مواقع الأحداق % % 5(@)(@@) % أنى يعنف كل معنوف به % % يثني يديه على 
ms785	 حشا خفاق % 6(@)(@@) % تهدي الحمامة والغراب لقلبه % % شجوا بساق تارة وبغاق % % 7(@)(@@) % ويشوقه برق السحاب وإنما % % يعنى ببرق المبسم البراق % % 8(@)(@@) % متصعدا زفراته متحدرا % عبراته أبدا قريح مآقي % % 9(@)(@@) % لم يسق فوه من الثغور شفاءه % فلوجنتيه من المدامع ساقي % % 10(@)(@@) % يبكي الشجي بعبرة مهراقة % بل بالدماء على دم مهراق % % PageV01P3084 11(@)(@@) % تضحي أحبته تولى سفحه % % عند الفراق وعند كل تلاقي % % 12(@)(@@) % يجزونه طول الجفاء بأنه % % لم يخل من شغف مدر فواق % % 13(@)(@@) % شهد الوفاء وكل شيء صادق % أن الجزاء هناك غير وفاق % 14(@)(@@) % أصغت إلى العشاق أذني مرة % ومن الجميل تعاطف العشاق % % 15(@)(@@) % فشكا الشجي من الخلي ملامة % وشكى الوفي تلون المذاق % % 16(@)(@@) % فدع المحب من الملامة إنها % % بئس الدواء لموجع مقلاق % % 17(@)(@@) % لاتطفئن جوى بلوم إنه % % كالريح تغري النار بالإحراق % % 18(@)(@@) % وأرى رقى العذال غير نوافع % لاسيما لمتيم مشتاق % % 19(@)(@@) % ما للمحب إذا تفاقم داؤه % غير الحبيب يزوره من راقي % % 20(@)(@@) % أخذ الإله لنا بثأر قلوبنا % % من مصميات للقلوب رشاق % PageV01P3085 21(@)(@@) % رقت مياه وجوههن لناظر % وقلوبهن عليه غير رقاق % 22(@)(@@) % هيف القدود إذا نهضن لملعب % وإذا مشين ثوادق الإيناق % % 23(@)(@@) % حرنت بهن روادف ممكورة % ومتونهن الغيد في إعناق % % 24(@)(@@) % يهززن أغصانا تباعد بالجنى % % وتروق بالإثمار والإيراق % % 25(@)(@@) % ومن البلية منظر ذو فتنة % نائي المنافع شاعف الإيناق % % 26(@)(@@) % ومن العجائب أن سمحنا للهوى % % بدمائنا وبخلن بالأرياق % % 27(@)(@@) % مزن يمطن الري عن أفواهنا % % ويجدن للأبصار بالإبراق % 28(@)(@@) % صيد حرمناه على إغراقنا % % في النزع والحرمان في الإغراق % % 29(@)(@@) % وأما ومن لو شاء ما خلق الهوى % % ولما ابتلى أصحابه بفراق % % 30(@)(@@) % مامن مزيد من بلية عاشق % وندى وخير في أبي إسحاق % % PageV01P3086 31(@)(@@) % لله إبراهيم واحد عصره % % ما أشبه الأخلاق بالأعراق % % 32(@)(@@) % أضحت فضائله تؤم به العلا % % وكأنهن إلى السماء مراقي % % 33(@)(@@) % لصفحت عن دهري به وذنوبه % % قد أوبقته أشدما إيباق % 34(@)(@@) % ملك له فطن دقاق في العلا % % تركته والأخلاق غير دقاق % 35(@)(@@) % يستعبد الأحرار إلا أنه % % يستعبد الأحرار بالإعتاق % % 36(@)(@@) % ومتى أصابك منه رق 
ms786	 صنيعة % فكطوق زين لاكغل وثاق % 37(@)(@@) % يارب أسرى للخطوب أصابهم % % منه بإعتاق وباسترقاق % 38(@)(@@) % ولما تعمد رقهم لكنه % % لابد للمعروف من أرباق % % 39(@)(@@) % والرق في الإعتاق حكم للعلا % % حكمت به والأسر في الإطلاق % % 40(@)(@@) % رق الصنائع في الرقاب وأسرها % % مامنهما وأبيك إلا باقي % % PageV01P3087 41(@)(@@) % يامن يقبل كف كل ممخرق % هذا ابن أحمد غير ذي مخراق % % 42(@)(@@) % قبل أنامله فلسن أناملا % لكنهن مفاتح الأرزاق % % 43(@)(@@) % حظيت وفازت من أنامل سيد % نفع المسود فساد باستحقاق % % 44(@)(@@) % نفخاته ملك وفي تأميله % % روح القلوب ومسكة الأرماق % % 45(@)(@@) % وإلى ابن أحمد أرقلت بي ناقتي % % في كل أغبر قاتم الأعماق % % 46(@)(@@) % جبت الخروق بكل خرق ماجد % إن الخروق مسالك الأخراق % % 47(@)(@@) % نأتم أروع نهتدي بجبينه % % والله ضارب قبة ورواق % % 48(@)(@@) % كالبدر تم وكللته سعوده % % لازال شانئه هلال محاق % % 49(@)(@@) % قالت سعودي يوم فزت بقربه % % قسما لفزت بأنفس الأعلاق % % 50(@)(@@) % حر تذكره الخطوب خلاقة % في الحال تنسي الحر كل خلاق % % PageV01P3088 51(@)(@@) % يلقي الرجال ثناؤه وعطاؤه % بذكاء رائحة وطيب مذاق % % 52(@)(@@) % خرق يعم ولا يخص بفضله % % لكنه كالغيث في الإطباق % % 53(@)(@@) % عفت مدائحه وعف فما ترى % % منكوحة إلا بخير صداق % % 54(@)(@@) % ألفيت عاذله يروض سماحه % ليعوق منه وليس بالمنعاق % 55(@)(@@) % شكرا بني حواء إن أخاكم % من خير ما رزقت يد الرزاق % % 56(@)(@@) % أضحى ابن أحمد ساح ماء سماحه % % فيه وماء شبابه الغيداق % % 57(@)(@@) % وأمد من ماء الحياء بثالث % صافي القرارة رائق الرقراق % % 58(@)(@@) % لله أمواه هناك ثلاثة % تغذى بهن مكارم الأخلاق % % 59(@)(@@) % أوفى بأعلى رتبة وتواضعت % آلاؤه فأحطن بالأعناق % 60(@)(@@) % كالشمس في كبد السماء محلها % % وشعاعها في سائر الآفاق % PageV01P3089 61(@)(@@) % بل كالسماء وكل مازينت به % % وكأرضها في قربه من لاقي % % 62(@)(@@) % يامن يسائل من له بكفائه % % من للسماء وأرضها بطباق % % 63(@)(@@) % آسى هنات مستشار خليفة % كافي شآم مستماح عراق % % 64(@)(@@) % مازال مشترك القرى في دهره % % بين الطوارق منه والطراق % % 65(@)(@@) % فقرى لطارقه يحل نطاقها % % من بعد ماشدت أشد نطاق % % 66(@)(@@) % وقرى يليه لطارق طلب القرى % % فجرى له بالعين 
ms787	 والأوراق % % 67(@)(@@) % قسم الزمان على ضياء ساطع % وندى كمعروف السماء بعاق % % 68(@)(@@) % من لمحة بمشورة لمملك % % أو نفحة بجدى لذي إملاق % % 69(@)(@@) % فله إذا الأيام أشبه خيرها % % يوم الضعيفة صبحت بطلاق % 70(@)(@@) % يوم كيوم الصحو في إشراقه % % وغد كيوم الغيث في الإغداق % PageV01P3090 71(@)(@@) % لابل كلا يوميه يصبح فائزا % بمحامد الإغداق والإشراق % % 72(@)(@@) % ياقرب مستقياته لوروده % % يابعد أغوار هناك عماق % % 73(@)(@@) % قل للإمام إذ اجتباه لأمره % % ظفرت يداك بفاتق رتاق % % 74(@)(@@) % مفتاح رأي حين يغلق بابه % % مغلاق شر أيما مغلاق % % 75(@)(@@) % متوقد الحركات تحسب أمره % لمعان برق أو حفيف براق % % 76(@)(@@) % فإذا تفرد للخطوب بفكره % % فله سكينة حية مطراق % % 77(@)(@@) % وإذا التقى أمر الوزير وأمره % سدا طريق الحادث المنباق % % 78(@)(@@) % شهد الخليفة إذ أعانا بأسه % أن النصال تعان بالأفواق % % 79(@)(@@) % إني رأيتك يابن أحمد سيدا % % فينا بحق واجب وحقاق % % 80(@)(@@) % لاحظت رفدك عند إرفاد الورى % % فرأيته كاليم عند سواقي % % PageV01P3091 81(@)(@@) % جادوا وجدت فأحدقت بثمادهم % % غمرات بحرك أيما إحداق % % 82(@)(@@) % فتزاجروا عن غيهم وتصارحوا % % نصحا جلا الشبهات بعد ملاق % % 83(@)(@@) % ورأيت رأيك بين آراء العدا % % كالسيف بين جماجم أفلاق % % 84(@)(@@) % كادوا وكدت فأزهقت مادبروا % % إحدى هناتك أيما إزهاق % % 85(@)(@@) % أرهقتهم قدر البوار بقوة % وهبت لرأيك أوشك الإرهاق % 86(@)(@@) % ما للدهاة لدى محالك موئل % لافي سلالمهم ولا الأنفاق % 87(@)(@@) % أنت الذي كبح المكائد كيده % حتى ركضن دوامي الأشداق % 88(@)(@@) % لله درك من مضر مرفق % متأله الإضرار والإرفاق % % 89(@)(@@) % كم ظل يوم ممطر لك مصعق % متحمد الإمطار والإصعاق % % 90(@)(@@) % لبست محاسنك المحامد إنها % % نظرت فلم تر غيرها من واقي % % PageV01P3092 91(@)(@@) % خذها شرودا في البلاد مقيمة % سمرا لذي سمر وزاد رفاق % % 92(@)(@@) % أنت الذي ماقال فيه مقرظ % قولا فأسلمه بلا مصداق % % 93(@)(@@) % أنت الذي للوعد منه وعنده % % سبق وللإنجاز وشك لحاق % % 94(@)(@@) % من ذا يعد الحمد غيرك مغنما % ويرى المواهب أفضل الإنفاق % % 95(@)(@@) % من ذا يعد النفل فرضا واجبا % أو يجعل الميعاد كالميثاق % % 96(@)(@@) % يفديك من يثني عليه صديقه % بعبوس كبر وابتسام نفاق % % 97(@)(@@) % يامن 
ms788	 يجود لدى السؤال بطرفه % ولدى النوال بأحسن الإطراق % % 98(@)(@@) % يامن صفت لي في ذراه شرائعي % % حتى تركت تتبع الأرزاق % % 99(@)(@@) % أضحى المديح يساق نحوك إنه % % يلفى ببابك نافق الأسواق % % 100(@)(@@) % فالبسه مالبس الحمام حلبه % في الأيك من وشح ومن أطواق % % PageV01P3093 101(@)(@@) % وعمرت ماعمرت مكارمك التي % % تبلى ثياب الدهر وهي بواقي % % 102(@)(@@) % واسلم أبا إسحاق لابس غبطة % وعداك للإبعاد والإسحاق % % PageV01P3094 البحر : - 1(@)(@@) % أيها البيهقي أحسنت في شعر % % ك إحسان ذي طباع وحذق % 2(@)(@@) % قرط الله بظر أمك بالدر % % ر فقد أنجبت بشاعر صدق % PageV01P3095 البحر : - 1(@)(@@) % لم يزل قلبه إليهم مشوقا % % ثم أضحى لديهم معلوقا % % 2(@)(@@) % بان قلبي فشاقني وجدير % حق للقلب بائنا أن يشوقا % % 3(@)(@@) % يا فتى بان قلبه وهو ثاو % قل لحاديك قد أنى أن تسوقا % % 4(@)(@@) % جل مقدار ما نأى عنك فارحل % % عرمسا تترك الحصى مدقوقا % % 5(@)(@@) % فاطلب القلب والذين سبوه % عائقا كل عائق أن يعوقا % % 6(@)(@@) % لم تدعني حبائل الشادن الأك % % حل حتى نشبت فيها نشوقا % % 7(@)(@@) % علقتني حبالة منه ما انفك % ك فيها بنبله مرشوقا % % 8(@)(@@) % أحلال أن يحزق الصيد صبرا % من رأى في حباله محزوقا % % 9(@)(@@) % طالب الله مقلتيه السحوري % % ن بحقي وقده الممشوقا % % 10(@)(@@) % منع العين قرة العين أن تل % % تذ طعم الرقاد بل أن تذوقا % % PageV01P3096 11(@)(@@) % ما أنى مسعدا حماما سجوعا % فيه أو زاجرا غرابا نعوقا % % 12(@)(@@) % ويك ياعائب الحبيب لتسلى % % عنه مهلا طلبت أحوى عقوقا % % 13(@)(@@) % بأبينا حديث من عبت مسمو % % عا وبالنفس وجهه مرموقا % % 14(@)(@@) % قد رضينا الحبيب لوكان مر % ضيا لدينا بعهده موثوقا % % 15(@)(@@) % أيها الذائق الممرات صبرا % إن شهدا في إثرها ملعوقا % % 16(@)(@@) % آل نوبخت ليس يعدم راجي % % كم صبوحا من رفدكم وغبوقا % % 17(@)(@@) % كم نوال لكم بكور طروق % % قد كفى نوبة بكورا طروقا % % 18(@)(@@) % رب واد أحل من بعد إحرا % % م فأضحى عفاؤه محلوقا % % 19(@)(@@) % جدتم جودة فأصبح رائي % % ه بآثارها عليه مروقا % % 20(@)(@@) % طفقت تمطر العفاة سماء % من جداكم فما أساءت طفوقا % % PageV01P3097 21(@)(@@) % حسبكم ويب غيركم قد تركتم 
ms789	 % % كل حر بفعلكم مرقوما % % 22(@)(@@) % أي جيد ترونه ليس يمسي % % في عري عارفاتكم مربوقا % % 23(@)(@@) % وإذا ماجريتم في مدى الحك % % مة خلفتم الطلوب اللحوقا % % 24(@)(@@) % وتقاسون بالسراة ومازل % % تم تفوقون فائقا لامفوقا % % 25(@)(@@) % فتكونون للوجوه أنوفا % وتكونون للرؤوس فروقا % % 26(@)(@@) % قد وسطتم وفقتم وتقدم % تم فأنذرت حاسدا أن يموقا % % 27(@)(@@) % لاتلجن في معاندة الحق % ق فتعتد جاهلا مألوقا % % 28(@)(@@) % كم عدو لكم غدا يجتديكم % % ولقد بات نابه محروقا % % 29(@)(@@) % فاجتدى نخلة قريبا جناها % % قد أنافت على النخيل بسوقا % % 30(@)(@@) % لايراها أشاءة من يسامي % % ها ولا من بغى جناها سحوقا % % PageV01P3098 31(@)(@@) % أيها الطالبون خيرا وشرا % إن شوكا فيها وإن عذوقا % % 32(@)(@@) % لاتزل عين شانيء تتقذا % % كم معورا إنسانها مبخوقا % % 33(@)(@@) % ووقاكم به الإله ولقا % % ه من الجائحات حدا حلوقا % % 34(@)(@@) % لم أقل إذ صحبتكم بعد أقوا % % م تبدلت بعد نوق عنوقا % % 35(@)(@@) % يحذق الناس ماتعاطوا وما أح % % سب مدحا في مثلكم محذوقا % % 36(@)(@@) % يا أبا سهل الذي راع في السؤ % % دد لا لاحقا ولاملحوقا % % 37(@)(@@) % بل سبوقا إلى البعيد من الغايا % % ت عند الجراء لامسبوقا % % 38(@)(@@) % والذي أبصر السحاب عطايا % % ه فأضحى يشيم منه البروقا % % 39(@)(@@) % ورآه العيوق في فلك المج % % د فأمسى يخاله العيوقا % % 40(@)(@@) % والذي يبهر البدور ببدر % لايرى كاسفا ولاممحوقا % % PageV01P3099 41(@)(@@) % وإذا رامه عدو رآه % % جبلا فوق رأسه منتوقا % % 42(@)(@@) % وإذا امتاحه ولي رآه % % عارضا واهي الكلى معقوقا % % 43(@)(@@) % وإذا الخصم لبس الحق بالبا % % طل كان المميز الفاروقا % % 44(@)(@@) % مالقينا مثل البثوق اللواتي % % منحت منك بعد بر عقوقا % % 45(@)(@@) % لاقصورا من الكرامة عنا % % غير أن اللقاء أضحى معوقا % % 46(@)(@@) % تركت لي حشا عليك خفوقا % % وفؤادا إليك صبا مشوقا % % 47(@)(@@) % عجبا من خليفة وأمير % كلفا البحر أن يسد البثوقا % % 48(@)(@@) % كيف يرجى لسد بثق جواد % لم يزل ماء جوده مبثوقا % % 49(@)(@@) % أريحي تخاف بائقة الطوفا % % ن من بطن كفه أن تبوقا % % 50(@)(@@) % ولي السد وهو أقوم بالفت % % ح وإن كان قد يسد الفتوقا % % PageV01P3100 51(@)(@@) % وجدير شرواه أن يرتق المف 
ms790	 % % توق طورا ويفتق المرتوقا % % 52(@)(@@) % شق بحرا من البحار وأرسى % % جبلا شامخا يفوق الأنوقا % % 53(@)(@@) % هز للماء هذمة كعصا مو % % سى فأضحى عموده مفروقا % % 54(@)(@@) % بين فرقيه برزخ مثل رضوى % % عفق البثق فانتهى معفوقا % % 55(@)(@@) % وثنى النيل نحو مسلكه الأر % شد لما اعتدى وجار فسوقا % % 56(@)(@@) % يابن نوبخت وابن أبنائه الصي % % د كذا تشبه الغصون العروقا % % 57(@)(@@) % لاعدمناك حولا قلبيا % % مخلطا مزيلا فتوقا رتوقا % % 58(@)(@@) % لتقلدت حفر اسناءة الني % % ل كميشا تخال سيفا دلوقا % % 59(@)(@@) % تسبق الفجر بالغدو عيها % % ثم لاتستفيق إلا غسوقا % % 60(@)(@@) % لازما بطنها تراها قناة % وترى طينها هناك خلوقا % % PageV01P3101 61(@)(@@) % وترى السافيات تجري بها الأر % % واح مسكا يذرونه مسحوقا % % 62(@)(@@) % كم حلوق بللتها قد أفاءت % % لك ذكرا في الناس يشجي الحلوقا % % 63(@)(@@) % كان مما حدثت ضيفك أن قل % % ت وقد حل في ذراك طروقا % % 64(@)(@@) % لو ترانا في بطن إسناية الني % % ل لأبصرت هاربا مرهوقا % % 65(@)(@@) % هاربا من مغوثة كم أغاثت % % من لهيف ونفست مخنوقا % % 66(@)(@@) % تقدم الماء وهو يتبعنا في % % ها مخلى سبيله مدفوقا % % 67(@)(@@) % كلما استقبلته فيها صعودا % % ء شققنا له هناك شقوقا % % 68(@)(@@) % فإذا ما احزأل فيها نجونا % % منه عدوا فلا يسيء اللحوقا % % 69(@)(@@) % والمساحي تسوقه نحو مجرا % % ه فيا حسنه هناك مسوقا % % 70(@)(@@) % عجبا أن تفر منه وقد حم % % مل من ميرة الحياة وسوقا % % PageV01P3102 71(@)(@@) % بل لتطريقنا له وهو المه % % روب منه ولم يكن ذاك موقا % % 72(@)(@@) % دأبنا ذاك سائر اليوم حتى % % ملأ الماء بطنها المشقوقا % % 73(@)(@@) % لو تراها وقد تسامت ذراها % % خلت أمواجها جمالا ونوقا % % 74(@)(@@) % صنع وال يمسي ويصبح مصبو % % حا بإتعاب جسمه مغبوقا % % 75(@)(@@) % وهب النفس للعلا فجزته % رتبة تفرع النجوم سموقا % % 76(@)(@@) % يا أبا سهل الذي راق مرئي % % ا وطاب المخبور منه مذوقا % % 77(@)(@@) % لم تزل مبدئا معيد الفضل % وبما أنت فاعل محقوقا % % 78(@)(@@) % لا عجيب صفاء ودك للخل % % ل إذا كان خيمك الراووقا % % 79(@)(@@) % مثل ذاك الطباع صفي من الأق % % ذاء مستأثرا بذاك سبوقا % % 80(@)(@@) % قد قرأنا كتابك 
ms791	 الحسن النظ % % م فخلناه لؤلؤا منسوقا % % PageV01P3103 81(@)(@@) % ووقفنا على خطابك إيا % % ي فأصبحت وامقا موموقا % % 82(@)(@@) % وبأني معشوق نفسك لا تض % حي وتمسي إلا إلي مشوقا % % 83(@)(@@) % فرأينا تطولا وسمعنا % % منطقا مونقا كوجهك روقا % % 84(@)(@@) % إن تكن عاشقا لعبدك تعشق % عاشقا لم تزل له معشوقا % % 85(@)(@@) % ولأنت المحقوق بالعشق لا المر % % زوق لكن إخالني المرزوقا % % 86(@)(@@) % غير أني إذا تأملت إخلا % % صك ودي أهلتني أن أروقا % % 87(@)(@@) % أنا من إن عشقته فلود % خالص منه لم يكن ممذوقا % % 88(@)(@@) % وكأني وقد طويت إليك النا % % س جاوزت نحو ماء خروقا % % 89(@)(@@) % ولعمري لقد وردتك عذبا % لاجوى آجنا ولا مطروقا % % 90(@)(@@) % دائم العهد لا ينقلك الغد % % ر إذا خيل بعضهم زاووقا % % PageV01P3104 91(@)(@@) % إن تكن جاحدا لنعماك عندي % % لاتجدني لها كفورا سروقا % % 92(@)(@@) % تلك شمس لها لديك غروب % وتلاقي لها لدي شروقا % % 93(@)(@@) % إن هذا من الأمور لبدع % حين ترعي الأمور عينا رموقا % % 94(@)(@@) % شرق شمس فيه تغيب وغرب % فيه تبدي صباحها المفتوقا % % 95(@)(@@) % أنت من راشني أثيث رياشي % % وكسا اللحم عظمي المعروقا % % 96(@)(@@) % واتقاني بحق سلطان ودي % % قسمة ماذممتها وطسوقا % % 97(@)(@@) % مجريا ذاك سنة لي ما دا % % م نهار لليله موسوقا % % 98(@)(@@) % ولما كنت مستودع الما % % ء سقاء مهزما مخروقا % % 99(@)(@@) % لا ولا مثل زارع في سباخ % غادرت جل زرعه ماروقا % % 100(@)(@@) % أنا ممن يستقرض العرف مف % % عولا ويقضي أضعافه منطوقا % % PageV01P3105 101(@)(@@) % ورأيناك لاتقاضي إذا أق % % رضت قرضا إلا لسانا نطوقا % % 102(@)(@@) % بل وجدناك لامريغا جزاء % بل إلى البذل لا سواه تؤوقا % % 103(@)(@@) % حاش لله لم تكن عند إفضا % % ل إلى غير ذاته لتتوقا % % 104(@)(@@) % يا مهانا تلاده كل هون % متحفى بضيفه مرفوقا % % 105(@)(@@) % سالما عرضه وإن بات بالأل % % سن من عاذلاته مسلوقا % % 106(@)(@@) % نصب وفدين ركب ماء وطورا % ركب ظهر يعول سباسب خوقا % % 107(@)(@@) % لاكمن أعتب العواذل مذمو % % ما فأضحى أديمه ممزوقا % % 108(@)(@@) % كم وعيد أخلفت لو حق أمسى % % من أصابت سماؤه مصعوقا % % 109(@)(@@) % وعدات أنجزت عفوا وحاشى % % عدة منك أن تشوك 
ms792	 بروقا % % 110(@)(@@) % ياسمي الصدوق في الوعد إس % % ماعيل أنى يكون إلا صدوقا % % PageV01P3106 111(@)(@@) % ورعا أن تقارف البخل كفا % % ك وهيهات أن تلاقي فروقا % % 112(@)(@@) % رابط الجأش في الخطوب وماتع % % دم قلبا من خوف ذم خفوقا % % 113(@)(@@) % تركب السيف في المعالي ولكن % تتقي شفرة اللسان العروقا % % 114(@)(@@) % وتشيم الأمور غير مضاه % راعي الثلة النؤوم النعوقا % % 115(@)(@@) % قد بلونا يوميك يابن علي % فحمدنا المغيوم والمطلوقا % % 116(@)(@@) % يومك الحاتمي والتارك الخص % % م مزلا مقامه زحلوقا % % 117(@)(@@) % لك يوم من الندى ذو سماء % لم تزل ثرة الفروغ دفوقا % % 118(@)(@@) % شفع يوم من الحجى ذي حجاج % تدع الشبهة الثبوت زلوقا % % 119(@)(@@) % تنتحي مقتل الخصيم وقورا % لاخفيفا عند الخفوف نزوقا % % 120(@)(@@) % منطقيا تصرف الجنس والفص % % ل وما ولدا جموعا فروقا % % PageV01P3107 121(@)(@@) % بار حمد الرجال بين ملوك الن % ناس حتى أقمت للحمد سوقا % % 122(@)(@@) % وغدا الشعر في فنائك مبرو % % را وقد كان برهة معقوقا % % 123(@)(@@) % فابق يفديك من يفي بك مف % ديا ومن ليس عادلا ثفروقا % % 124(@)(@@) % إن تقدم منافسيك فلن يذ % % كر للنصل إن تقدم فوقا % % 125(@)(@@) % غير ماطاعن على من يسامي % % ك ولكن لفائق أن يفوقا % % 126(@)(@@) % لو مدحناك بالمديح الذي قد قي % % ل في الناس لم يكن مسروقا % % 127(@)(@@) % ولكنا في ما فعلناه كالحكا % % م ردوا على محق حقوقا % % 128(@)(@@) % مدح الأولون قوما بأخلا % % قك من قبل أن ترى مخلوقا % % 129(@)(@@) % نحلوهم ذخائرا لك بالبا % % طل منقيلهم وكان زهوقا % % 130(@)(@@) % فانتزعنا الغصوب من غاصبيها % % فحبا صادق بها مصدوقا % % PageV01P3108 البحر : - 1(@)(@@) % طلع الرقي في شاشية % وعليه سيفه والمنطقه % 2(@)(@@) % فبدا للناس منه منظر % عجب سبحان رب خلقه % 3(@)(@@) % إن إكن أبصرت شخصا مثله % % فثيابي في الجوالي صدقه % PageV01P3109 البحر : - 1(@)(@@) % قولا لذات الركب المحلوق % هل لك في أير عظيم الحوق % 2(@)(@@) % أنعظ من بلبلة الإبريق % . . . . . . . . . . . . . . . . . . . . % PageV01P3110 البحر : - 1(@)(@@) % كان أناس يرون أني في ال % % آداب صفو ماشابه رنق % 2(@)(@@) % وكان لي بينهم وعندهم % مضطرب واسع ومرتفق % 3(@)(@@) % حتى إذا ما صحبتكم نظروا % % وأنتم منتلاحظ الحدق % 4(@)(@@) % فقلدوا 
ms793	 رأيكم فزهدهم % في فعلقي لديهم خلق % % 5(@)(@@) % رجوت منكم حيا فأخلفني % % كلا ولكن أصابني صعق % % PageV01P3111 البحر : - 1(@)(@@) % يا سليمان ظماء % قطعت عنك السواقي % % 2(@)(@@) % شخت فأذن بفراق % وتجهز لانطلاق % % 3(@)(@@) % بنت عني بطلاق % وطلاق وطلاق % 4(@)(@@) % فرطت فيك ثلاث % آخذات بالخناق % 5(@)(@@) % فالبس اليأس من الرج % عى وطالب بالصداق % % 6(@)(@@) % نحن قوم مالدينا % % للمولي من خلاق % % 7(@)(@@) % نأكل اللحم ونرمي % % بكراديس العراق % % 8(@)(@@) % ماعلينا بعد شرب ال % % خمر من طرح الزقاق % % 9(@)(@@) % قد تبدلنا بك المر % % د فدع باب النفاق % % 10(@)(@@) % وفتنا ببدور % منهم ذات اتساق % % PageV01P3112 11(@)(@@) % وشغفنا بغصون % منهم هيف رشاق % % 12(@)(@@) % فاترك الركض وسلم % ذاك للخيل العتاق % % 13(@)(@@) % أنت راض حين تجري % % بعد سبق بلحاق % 14(@)(@@) % فاصطبر ياحب نفسي % % كل بدر لمحاق % 15(@)(@@) % ومتى خانك صبر % فاجتلب ماء المآقي % % 16(@)(@@) % وابك أيام حياة % أنت منها في سباق % % 17(@)(@@) % قد مشقنا في قراطي % % سك هاتيك الرقاق % % 18(@)(@@) % وسبقنا في ميادي % % نك أصحاب السباق % % 19(@)(@@) % كم سقاني فوك من ري % % قك بالكأس الدهاق % % 20(@)(@@) % ربما التفت إلى الصب % % ح لنا ساق بساق % PageV01P3113 21(@)(@@) % في نقاب من لثام % وإزار من عناق % % 22(@)(@@) % ذهبت نضرة خدي % % ك وما شيء بباقي % % 23(@)(@@) % فالزم المنقاش واعلم % أنه دهر ارتفاق % % 24(@)(@@) % ليس من دائك هذا % % غير طول النتف راقي % % 25(@)(@@) % أين سلطان عزيز % لك في أرض العراق % % 26(@)(@@) % كنت في ملك من المر % % دة مرهوب الشقاق % 27(@)(@@) % قد محاجورك فيه % % كل حق وحقاق % 28(@)(@@) % لم يكن ملكك يرضي % % ملك السبع الطباق % % 29(@)(@@) % فرماه بزوال % أودهاه بانفتاق % % 30(@)(@@) % هربت منك المودا % % ت على ظهر البراق % % PageV01P3114 31(@)(@@) % فاسل عنا قد سقانا % % عنك بالسلوة ساقي % % 32(@)(@@) % كنت شيئا فتلاشي % % ت وماشيء بباقي % % 33(@)(@@) % فوردنا منك عذبا % وصدرنا عن زعاق % % 34(@)(@@) % كنت عقا بالمحبي % % ن فعقتك عقاق % % 35(@)(@@) % فاله عما فات منه % % ما إلى النجم مراقي % % 36(@)(@@) % لن ترى موقف مستع % % د على حر اشتياق % % 37(@)(@@) % لا ولا نفس محب % ترتقي بين التراقي % % 38(@)(@@) % فك مأسورك ذو القد % % رة 
ms794	 من ذاك الوثاق % 39(@)(@@) % لم يدع منه عذارا % % ك هوى غير اختلاق % % 40(@)(@@) % ذق عقاب العذر واعلم % % أنه غير مطاق % % PageV01P3115 41(@)(@@) % قد أكلناك لذيذا % طيبا حلو المذاق % % 42(@)(@@) % ولفظناك كريها % غير مكروه الفراق % % 43(@)(@@) % خير أحوالك أن تس % لم من داء الحلاق % % PageV01P3116 البحر : - 1(@)(@@) % أخالقي رب ورب رازقي % % مارازقي تالله إلا خالقي % % 2(@)(@@) % فلا تشوه خلتي خلائقي % % ولايعوج طمعي طرائقي % % PageV01P3117 البحر : - 1(@)(@@) % قد حلفنا على الصفاء جميعا % فاجتهدنا وذاك جهد المطبق % 2(@)(@@) % فبأي الأحكام توجب تصدي % % قك حتما ولا ترى تصديقي % % 3(@)(@@) % وبأي الأحكام قولك برها % % ن وقولي من خلبات البروق % 4(@)(@@) % ليس في العدل أن تحكم في قو % % لك فارجع إلى سواء الطريق % 5(@)(@@) % مامن الدعوتين إن ضفت دعوى % % غير محتاجة إلى تحقيق % % 6(@)(@@) % ولنا إن رددت ما تدعيه % % رد ماتدعيه ضيقا بضيق % % 7(@)(@@) % ووصفت الذي يحق على الإخ % % وان من رعيهم ذمام الصديق % % 8(@)(@@) % ورأيت النفوس أيسر من خذ % ل صديق عند احتضار الحقوق % % 9(@)(@@) % ولعمري لقد صدقت ولوقد % % خيض من دونه أجيج الحريق % % 10(@)(@@) % غير أن الطباع تستتبع المط % % بوع في كل فسحة ومضيق % % PageV01P3118 11(@)(@@) % حشمتي خلقة ولي من الخل % % قة أن تستقيد للمخلوق % % PageV01P3119 البحر : - 1(@)(@@) % أغثنا فأنت المرء يهتف باسمه % % إذا الأمر أضحى آخذا بالمخنق % 2(@)(@@) % ولا تمطل الغصان بالماء إنه % % متى يمطل الغصان بالماء يزهق % 3(@)(@@) % تكذب أقوام علينا وأعلقوا % % مخالبهم في لحمنا كل معلق % % 4(@)(@@) % وصدقهم من قد عرفت مكانه % % فمزق منا الشلو كل ممزق % % 5(@)(@@) % نحن بحال تذكر المرء فرضه % لدى كل واري الزند مثلك معرق % % 6(@)(@@) % فلا يسبقنك السابقون بكشفها % % فما زلت بالخيرات غير مسبق % % 7(@)(@@) % ومالي من قرض لديك أعده % % ولكن متى يحمله طولك يلحق % % 8(@)(@@) % نعائي إليك النفس إن لم تلافها % % فقد جعلت بين الحيازم ترتقي % % PageV01P3120 البحر : - 1(@)(@@) % أنا راع لما صفا منك قدما % عائف منك آجنا مطروقا % % 2(@)(@@) % فانس ذكري فإن قلبي ناس % لك ماعاقب الغروب الشروقا % % 3(@)(@@) % كن كأن لم تلاقني قط في النا % % س ولاتجعلن ذكراي سوقا 
ms795	 % % 4(@)(@@) % وتيقن بأنني غير راء % لك حقا حتى ترى لي حقوقا % % 5(@)(@@) % وبأني مفوق ألف فوق % لك إن فوقت يمينك فوقا % % PageV01P3121 البحر : - 1(@)(@@) % غموض الحق حين تذب عنه % % يقلل ناصر الخصم المحق % 2(@)(@@) % تضل عن الدقيق عقول قوم % فتحكم للمجل على المدق % 3(@)(@@) % وعند الله خالق كل شيء % تميز كل ذي كذب وصدق % 4(@)(@@) % وماينفك لي أبدا خصوم % أقابل منهم خرقا برفق % % PageV01P3122 البحر : - 1(@)(@@) % لايبعدن شبابك الغرنيق % أيام منظره عليك أنيق % 2(@)(@@) % سقيا لأزمان مضت أيامها % % بيضا كأن غروبهن شروق % % 3(@)(@@) % إذ للشبيبة صبوة تصبى بها % % وبشاشة يصبى بها وتروق % 4(@)(@@) % يهتز فيك لأريحيات الصبا % % غصن تفيأه الظباء وريق % 5(@)(@@) % هيهات أيتها الكواعب كالدمى % % مالي بكن مع المشيب صديق % 6(@)(@@) % مني عليكن السلام تحية % إن الشباب هراقه مهريق % 7(@)(@@) % لم تجمع الأيام شمل أحبة % إلا وشرط صروفها التفريق % % 8(@)(@@) % يا آل طاهر المطهر كاسمه % % إن اللسان بمدحكم لطليق % 9(@)(@@) % إن ينسني عصر الشباب وعهده % % عصر فعصركم لذاك خليق % % 10(@)(@@) % قد قلت للدهر الملح بصرفه % % لما اعتصمت بحبلكم ستفيق % % PageV01P3123 11(@)(@@) % أمسى مجاوركم يحل فعهدكم % % ما للخطوب بها عليه طريق % 12(@)(@@) % من خان أو نكث العهود فعهدكم % % عهد أمر على الوفاء وثيق % 13(@)(@@) % وكأن وعدكم تقيل عهدكم % % فلقاحه بنتاجه مرهوق % 14(@)(@@) % لتعذ بسيبكم المطامع والمنى % % فعليكم لعداتها التصديق % % 15(@)(@@) % ما زلتم ترقون في درج العلى % % حتى أشار إليكم العيوق % % 16(@)(@@) % مهما سرقت عن الأوائل فيكم % فلغير باع بالمديح يضيق % % 17(@)(@@) % لكنهم نحلوا سواكم مجدكم % % فرددت حقكم وذاك حقيق % % 18(@)(@@) % ما المدح مسروق لكم من غيركم % % بل منكم في غيركم مسروق % % PageV01P3124 البحر : - 1(@)(@@) % علاك قناع المشيب اليقق % وثوب المشيب جديد خلق % 2(@)(@@) % علاك فأبرق إبراقة % تراع لها ظبيات البرق % 3(@)(@@) % وأنى تراع بما أومنت % به من حبالك ذات العلق % 4(@)(@@) % ومن نبلك المرسلات التي % % صوائبها في الرمايا نسق % % 5(@)(@@) % بلى في المشيب لها رائع % وإن هو أطفأ فيها الحرق % 6(@)(@@) % وشرخ الشباب وإن صادها % % أحب إليها لذاك الأنق % 7(@)(@@) % أعاذلتي إن بكيت الشبا 
ms796	 % % ب إني لم أبك ثوبا سحق % 8(@)(@@) % لقد علم الدهر أن الشبا % % ب ثوب لدى الناس لا كالخرق % % 9(@)(@@) % لذاك يدب خفيا له % % فيسلبه سلبا لا كالسرق % % 10(@)(@@) % ولو كان يسلبه جهرة % للاقى القنا دونه والدرق % % PageV01P3125 11(@)(@@) % وحق له مع إقدامه % إذا ابتز مثل الشباب الفرق % % 12(@)(@@) % رعانا الأمير أبو أحمد % فأرعى المريع وأسقى الغدق % % 13(@)(@@) % وضم الشتيت ولم الجمي % % ع وانتظم الشمل حتى اتفق % % 14(@)(@@) % وأغنى الفقير وحاط الغني % ي مالم يحط والد ذو شفق % 15(@)(@@) % عبيد الإله بن عبد الإله % % ه خير الملوك وخير السوق % 16(@)(@@) % فأضحى وأمسى وقد أجمعت % % عليه بأهوائهن الفرق % % 17(@)(@@) % وظلوا وباتوا به آمني % % ن في ظل عيش أثيث الورق % % 18(@)(@@) % لياليهم مثل أيامهم % ضياء وأنسا وما من أرق % % 19(@)(@@) % وايامهم كلياليهم % سكونا وروحا ومامن غسق % % 20(@)(@@) % يداه يمينان لكنه % % إذا شاء عل الظبا بالعلق % PageV01P3126 21(@)(@@) % وطورا شمالان لكنه % % إذا شاء سح الندى فانبعق % 22(@)(@@) % مهيب إذا سار في جيشه % % وقد لاح كوكبه فائتلق % % 23(@)(@@) % أشارت إليه قلوب الورى % % وكف البنان وغض الحدق % % 24(@)(@@) % بلا سبب فالتمس رفده % % فإنك تقرب ماء رفق % 25(@)(@@) % وهل يستعد الرشاء امرؤ % لورد الفرات إذا ما فهق % 26(@)(@@) % ألا فارجه واخشه إنه % % هو البحر وفيه الغنى والغرق % 27(@)(@@) % ألا فارجه واخشه إنه % % هو الغيث فيه الحيا والصعق % 28(@)(@@) % مضر بملتمس ضره % % وفيه لمرتفق مرتفق % % 29(@)(@@) % هو السيف إن أنت أنحيته % % لرأسك أو رأس قرن فلق % % 30(@)(@@) % هو الماء فاشربه ذا غلة % وذا غصة وتوق الشرق % % PageV01P3127 31(@)(@@) % هو النار فاصطلها واستضئ % بها في الدجى وتوق الحرق % % 32(@)(@@) % إذا ماوعى مدحه المادحو % % ن طاب نسيمهم والعرق % % 33(@)(@@) % فتنشر أرواحهم نشرة % ومامنهم ذو لسان نطق % % 34(@)(@@) % فإن أنشدوا مدحه غادروا % % من المسك في كل شيء عبق % % 35(@)(@@) % إذا كذب الناس أوكذبوا % % لدى القول والفعل يوما صدق % 36(@)(@@) % وحلم يوازن مثقاله % % جبال الشرى وجبال السلق % 37(@)(@@) % به يجمع الملك أشتاته % إذا ماعصا الناس طارت شقق % % 38(@)(@@) % يباشر شوك القنا حاسرا % ويلبس دون اللسان 
ms797	 الحلق % % 39(@)(@@) % إذا بت والفكر تستخرجا % % ن مفتاح أمر عسير الغلق % % 40(@)(@@) % وأنت لأمر العلا مؤثر % على كل ناعمة المعتنق % PageV01P3128 41(@)(@@) % وأبدى لك الصبح عن واضح % % ين رأيك منبلجا والفلق % 42(@)(@@) % فلله صبحك ماذا جلا % % ولله ليلك ماذا وسق % % 43(@)(@@) % وإما أجرت من الحادثا % % ت جارا فليس عليه رهق % % 44(@)(@@) % يرى الدهر جارك في شاهق % تأزر من لجة وانطلق % % 45(@)(@@) % وقد علقت قبضتاه عرى % % بها عصم الله تلك الوثق % % 46(@)(@@) % فهل من سبيل إلى مثله % % أبى الله ذاك على من خلق % % 47(@)(@@) % فدونكها يابن سيف الملو % % ك لهو المجالس زاد الرفق % % PageV01P3129 البحر : - 1(@)(@@) % سبقت إلي صنيعة من محسن % وأراك تأنف أن تكون اللاحقا % % 2(@)(@@) % وإذا جمعت إلى اللحاق محبة % للسبق بالإحسان كنت السابقا % % 3(@)(@@) % ماقدر ماتجدي عليك بطالتي % % قدر تبيع به لسانا ناطقا % % 4(@)(@@) % إن لم تكن في فعل خير قائدا % فاطلب بجهدك أن تكون السائقا % % PageV01P3130 البحر : - 1(@)(@@) % قل للسفيه شنيف % دعني وعاد بليقا % % 2(@)(@@) % أخاك ذاك المراعي % % خوينا أو طبيقا % % 3(@)(@@) % يامن حسبناه بدءا % علقا فكان عليقا % % 4(@)(@@) % لم يجعل الله فضلا % % شاركتني فيه ضيقا % % 5(@)(@@) % بل واسعا لا كرزق % يدعوه داع رزيقا % % 6(@)(@@) % فلم تكالبت فيه % % يا مشحذيا خليقا % % 7(@)(@@) % لكن رضعت عريقا % % للؤم ساء عريقا % % 8(@)(@@) % صبرا لصوب سحاب % قد شمت منه بريقا % % 9(@)(@@) % لقيت أم ربيق % وسوف تلقى ربيقا % % 10(@)(@@) % فاستنجدن طوينا % ومكسبا وزريقا % % PageV01P3131 11(@)(@@) % أقران ظهرك أو فاب % % غ من حذارى نفيقا % % 12(@)(@@) % بل قد أقمت بذكري % % ك ياشنيف سويقا % % PageV01P3132 البحر : - 1(@)(@@) % مستبعد هيهات إعتاقه % مستأسر يعسر إطلاقه % 2(@)(@@) % صب رقيق القلب خفاقه % عناه فظ القلب خفاقه % 3(@)(@@) % محبب قلل إحسانه % % جدا وإن كثر عشاقه % 4(@)(@@) % لدن من الأغصان في روضة % من نرجس تنظر أحداقه % % 5(@)(@@) % يحسن في التجريد إثماره % وفي الشفوف الخضر إيراقه % 6(@)(@@) % فاقت دجى الليل دجى فرعه % وفاق ضوء الصبح إشراقه % % 7(@)(@@) % أخلق إذا جرد رمانه % في العين أن يكثر رماقه % % 8(@)(@@) % وهو المنى إن زيد في حسنه % % حريرة الحر وأعلاقه % 9 
ms798	(@)(@@) % لاضره ظلمي ولا نابه % % إقراحه قلبي وإقلاقه % % 10(@)(@@) % وإن غدا أظلم من قاسم % ذاك الذي يجفو وأشتاقه % PageV01P3133 11(@)(@@) % ياعجبا من ناظري إنه % % أضحت تقذاني آماقه % 12(@)(@@) % أعرض عني وجفا جانبي % % تقديمه البر وإلحاقه % 13(@)(@@) % والعذل شيء منه منقاده % % والفضل شيء منه منساقه % % 14(@)(@@) % ما أقرب المعروف من كفه % % فلم أغبتني أفواقه % % 15(@)(@@) % واغبر في دولته جبي % % وهو ربيع عم إغداقه % 16(@)(@@) % وحسبه ذكرى بإحسانه % % فأي شيء منه يعتاقه % % 17(@)(@@) % لا أشتكي البدر على بعده % % لقد أضاءت لي آفاقه % % 18(@)(@@) % ليس بمكفور ولا ضائع % إيناسه نفسي وإرفاقه % % 19(@)(@@) % لي أمل فيه إذا أخلقت % آمال قوم راث إخلاقه % % 20(@)(@@) % تحيا به نفسي وتلتذه % % وقد دنا بل آن إحقاقه % % PageV01P3134 21(@)(@@) % فاعقد لسان اللوم عن قاسم % % أو فليكن بالشكر إطلاقه % % 22(@)(@@) % وكيف يلحى خادم سيدا % إليه محياه وإنطاقه % % 23(@)(@@) % لايسرقن الحق من قاسم % فليس يخفي الحق سراقه % % 24(@)(@@) % من قاسم صيغت أماديحه % ومن حمام الأيك أطواقه % % 25(@)(@@) % لقاسم في كل حالاته % % شمائل السيف وأخلاقه % % 26(@)(@@) % مضاؤه إن أنت أعملته % % وقده الحلو ورقراقه % 27(@)(@@) % فتى يقر القلب إحسانه % كما يقر العين إيناقه % 28(@)(@@) % إن طلب الخير فمفتاحه % أو طلب الشر فمغلاقه % 29(@)(@@) % جربته في وعده فاستوى % % ميعاده عندي وميثاقه % % 30(@)(@@) % ماقيل في القاسم مدح له % % إلا وفي القاسم مصداقه % % PageV01P3135 31(@)(@@) % بفعله لا بأقاويلنا % % أربت على الأطلاق أطلاقه % % 32(@)(@@) % سيان في ميزان تقديره % % إفادة المال وإنفاقه % % 33(@)(@@) % يوجد مسبوقوه في فضله % % تترى ولا يوجد سباقه % % 34(@)(@@) % وكيف لا يثمر أحلى الجنى % % من وزراء الصدق أعراقه % % 35(@)(@@) % غيث مغيث عرفه ودقه % % وبشره بالناس إبراقه % % 36(@)(@@) % إذا تعاطى مغرق مدحه % % أقصر والتقصير إغراقه % % 37(@)(@@) % قد حمل الله بحملانه % % من حملته نحوه ساقه % % 38(@)(@@) % يابن سليمان الذي باسمه % % تحيا لهذا الخلق أرماقه % 39(@)(@@) % ياعدة الملك وأملاكه % % لحادث ينباق منباقه % % 40(@)(@@) % يامن له الكيد الذي لم يزل % % يفلق صم الصخر أفلاقه % PageV01P3136 41(@)(@@) % مامفزع العافي إذا شفه % % حرمانه واشتد إملاقه % % 42(@)(@@) % يامعقل الجاني على نفسه % % إذا جنى مافيه إيباقه % % 43(@)(@@) % لردك 
ms799	 المصر إلى أمنه % ردت إلى مصرك أباقه % 44(@)(@@) % وبابنك المرخص أمواله % % تغولي الحمد وأعلاقه % 45(@)(@@) % لولا مكان الحمد من قاسم % أوشك أن تكسد أسواقه % % 46(@)(@@) % قيم ملك وابن قوامه % % فتاق ما أعيا ورتاقه % % 47(@)(@@) % فالنجح ما ينجح إمضاؤه % % والحزم ما ينتج إطراقه % % 48(@)(@@) % من أهل بيت ساسة راضة % لديهم السم ودرياقه % % 49(@)(@@) % تجري على بطنان أيديهم % % نقائم الله وأرزاقه % % 50(@)(@@) % ذو العرف لا يبعد متاحه % والنكر لا تدر أعماقه % % PageV01P3137 51(@)(@@) % كم جامح أصبح إذ راضه % % تدمى لطول الكبح أشداقه % % 52(@)(@@) % شهاب نور ضامن للهدى % % وليس بالمأمون إحراقه % % 53(@)(@@) % غيث مغيث ضامن للحيا % % وليس بالمأمون إصعاقه % % 54(@)(@@) % يضحي إلى بذل السدى والندى % % وهو مشوق القلب مشتاقه % % 55(@)(@@) % يستعبد الحر له عرفه % % وقصده في ذاك إعتاقه % % 56(@)(@@) % قلت لمن جاراه لا يستوي % % صهال مضمار ونهاقه % % 57(@)(@@) % حقق للسيد تأميله % فيه ولا حقق إشفاقه % % 58(@)(@@) % وطال للحق به عمره % ودام للباطل إزهاقه % % 59(@)(@@) % واحتل من عاداه في منزل % حميمه آن وغساقه % % PageV01P3138 البحر : - 1(@)(@@) % أطبقت للنوم جفنا ليس ينطبق % وبت والدمع في خدي يستبق % 2(@)(@@) % لم يسترح من له عين مؤرقة % وكيف يعرف طعم الراحة الأرق % 3(@)(@@) % محمد وعلي فتتا كبدي % % إذا ذكرتهما والعيس تنطلق % 4(@)(@@) % خلان حل بقلبي من فراقهما % % ماكنت أخشى عليه قبل نفترق % % 5(@)(@@) % قلب رقيق تلظت في جوانبه % % نار الصبابة حتى كاد يحترق % 6(@)(@@) % وددت لم تم لي حجي بقربهما % % ماكل ما تشتهيه النفس يتفق % 7(@)(@@) % لايعجب الناس من وجدي ومن قلقي % % إن المشوق إلى أحبابه قلق % % PageV01P3139 البحر : - 1(@)(@@) % لايكشف الله عن وهب بن إسحاق % % من البلاء سماء ذات إطباق % 2(@)(@@) % قالوا الخبيث قد استسقى فقلت لهم % % لايشفه طب ذي طب ولا راق % 3(@)(@@) % قد كان يكثر من هاضوم غلمته % % بجهده لو وقاه حتفه واقي % % 4(@)(@@) % لايرج بعدك للهاضوم منفعة % إن مت من الماء ياوهب بن إسحاق % % 5(@)(@@) % إذا دعا لك داع قلت حينئذ % لازال من وصب الشكوى على ساق % % 6(@)(@@) % إن رأيت حيائي خلته خنثا % قد غر من غر 
ms800	 من أفعى بإطراق % 7(@)(@@) % بمثل ظنك هذا يا أبا حسن % أمنت كل ممر المتن غرناق % 8(@)(@@) % حتى عثوا في نساء كالدمى عرب % إذ لم يكن بينهم باب بمغلاق % % 9(@)(@@) % أحسنت ظنك جدا بالرجال فكن % % على محاذرة منهم وإشفاق % % 10(@)(@@) % لاتعدم الماء من سقيا ويعقبه % % سقياك في النار من مهل وغساق % PageV01P3140 البحر : - 1(@)(@@) % وثدي ناهدات % لم يخضدها العناق % 2(@)(@@) % بينها حلي نفيس % كفؤه تلك الحقاق % 3(@)(@@) % في صدور ساليات % لم يلذعها الفراق % % PageV01P3141 البحر : - 1(@)(@@) % وزائرة الخيال بلا اشتياق % تأوبها ولكن باشتياقي % % 2(@)(@@) % فيا كذب اللقاء وقد تلاقى % % خيالانا ويا صدق الفراق % PageV01P3142 البحر : - 1(@)(@@) % مالي يزاحمني الخلصان في طرقي % % ولا أزاحمه بالشعر في طرقه % 2(@)(@@) % لايجهلن على حلمي أخو ثقة % فالجهل من خلقي إن كان من خلقه % PageV01P3143 البحر : - 1(@)(@@) % ياليت شعري والحوادث جمة % هل أشتكي دهري وأنت صديقي % % 2(@)(@@) % وشكايتي الأيام دون شكايتي % % إن خانني عند النهوض فريقي % % 3(@)(@@) % إني أعوذ بما تأكد عقده % بيني وبينك أن تضيع شقيقي % % 4(@)(@@) % أو أن يجور به الزمان عن الغنى % % أو بي وأنت طريقه وطريقي % % PageV01P3144 البحر : - 1(@)(@@) % هل للمسمى بما تكنى الكلاب به % % قولا سيلحقه عارا فيلحقه % 2(@)(@@) % يا مبتلى ببلاء لا ثواب له % % يوم الحساب ولكن سوف يوبقه % 3(@)(@@) % ماقلت فيك هجاء خلته كذبا % إلا بدت منك سوءات تحققه % % 4(@)(@@) % أنى اجتبيت أبا حفص وصحبته % % حتى غدوت تؤاخيه فتصدقه % % 5(@)(@@) % بالله ربك هل شبهت صلعته % % برأس أير عظيم كنت تعشقه % PageV01P3145 البحر : - 1(@)(@@) % فيم التنازع والشقاق % والأمر بينكما وفاق % 2(@)(@@) % ولخصمه فيها ولا % % دة من بكفيه الطلاق % % 2(@)(@@) % فلخالد فيها ولا % % بالله ربك حقا % % 2(@)(@@) % ألبنت بنتكما معا فلخالد فيها ولا بالله ربك حقا ولخصمه فيها ولا دة من بكفيه الطلاق % % شهدت به السبع الطباق % % PageV01P3146 البحر : - 1(@)(@@) % يا ذا الطواحن قل لي % % بالله ربك حقا % % 2(@)(@@) % أهن أدوم طحنا % أم شفر أختك سحقا % % PageV01P3147 البحر : - 1(@)(@@) % بكعبة الله بل بخالقها % % أقسم لوأن خالدا غرقا % % 2(@)(@@) % وجاءه منقذ لينقذه % % وهو كظيم يعالج الشرقا % % 3(@)(@@) % ماوقعت كفه وقد 