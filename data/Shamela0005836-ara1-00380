ms363	 شيخ مالك ثقة مشهور قال أبو حاتم ليس بالقوي وقال مالك وسئل الحديث(@)(@@) PageV00P000(@)(@@) عن ابن قسيط بحديث في القصاص فامتنع وقال ليس رجله عندنا هناك(@)(@@)(@@)(@@) | 7119 - (@)(@@) يزيد بن عبد الله الجهني عن هاشم الأوقص وعنه بقية لا يصح خبره(@)(@@)(@@)(@@) | 7120 - (@)(@@) يزيد بن عبد الله بن عوف عن ابن عمر مجهول(@)(@@)(@@)(@@) | 7121 - (@)(@@) يزيد بن عبد الله البيسري أبو خالد القرشي بصري عن ابن جريج مقل تكلم فيه روى عنه قطن بن نسير(@)(@@)(@@)(@@) | 7122 - (@)(@@) عه / يزيد بن عبد الرحمن أبو خالد الدالاني مشهور حسن الحديث قال أحمد لا بأس به وقال ابن حبان فاحش الوهم لا يجوز الاحتجاج به(@)(@@)(@@)(@@) | 7123 - (@)(@@) ق / يزيد بن عبد الملك النوفلي عن المقبري مجمع على ضعفه(@)(@@)(@@)(@@) | 7124 - (@)(@@) يزيد بن عبد الملك النميري عن عائذ وعنه سليمان الشاذكوني إسناد مظلم والخبر منكر(@)(@@)(@@)(@@) | 7125 - (@)(@@) يزيد بن عبيد الله عن عمرو بن أبي هريرة مجهول(@)(@@)(@@)(@@) | 7126 - (@)(@@) يزيد بن عدي بن حاتم عن ابيه في الصوم لا يصح حديثه قاله البخاري أظن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 7127 - (@)(@@) يزيد بن عطاء اليشكري مولى أبي عوانة قال أحمد حديثه مقارب وقال ابن سعد ضعيف قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) | 7128 - (@)(@@) يزيد بن عطاء شيخ للعلاء بن عبد الجبار ضعفه ابن معين(@)(@@)(@@)(@@) | 7129 - (@)(@@) يزيد بن عطارد عن ابن عمر قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) | 7130 - (@)(@@) يزيد بن عمر التميمي روى عنه جميع بن عمر في الصفات لا يصح حديثه(@)(@@)(@@)(@@) | 7131 - (@)(@@) يزيد بن عمر عن مجالد بن سعيد مجهول(@)(@@)(@@)(@@) | 7132 - (@)(@@) يزيد بن عمرو الأسلمي تابعي مجهول والخبر منكر(@)(@@)(@@)(@@) | 7133 - (@)(@@) ق / يزيد بن عوف شيخ لبقية لا يعرف(@)(@@)(@@)(@@) | 7134 - (@)(@@) ت ق / يزيد بن عياض بن جعدبة عن الأعرج قال النسائي وغيره متروك(@)(@@)(@@)(@@) | 7135 - (@)(@@) يزيد بن عيسى البصري عن حماد بن سلمة قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) | 7136 - (@)(@@) يزيد بن فراس عن أبان بن عثمان مجهول(@)(@@)(@@)(@@) | 7137 - (@)(@@) د س / يزيد بن كعب العوذي لا يدرى من هو وخبره أن السجل كتب الوحي(@)(@@)(@@)(@@) | 7138 - (@)(@@) يزيد بن الكميت كوفي ير