ms21	 % 8(@)(@@) % لما سرت في حاجة البلاد % و لحق الاعجاز بالهوادي % % 9(@)(@@) % فاختلط السواد بالسواد % اظفرت الثرى بمن تعادي % % 10(@)(@@) % فرويت هاماته الصوادي % % كم حملت لم قتر من زاد % PageV01P066 11(@)(@@) % ومن رواء سنة جماد % و حلبت من روقة العتاد % 12(@)(@@) % من القلاص الخور والجلاد % و المقربات الصفوة الجياد % 13(@)(@@) % ومن حبير اليمنة الأبراد % من أتحميات ومن وراد % 14(@)(@@) % هدية من صمد جواد % ليس بمولود ولا ولاد % 15(@)(@@) % ممنوعة من حاضر وباد % حتى تحل في الصعيد الثادي % % PageV01P067 البحر : طويل 1(@)(@@) % تقي جمحاتي لست طوع مؤنبي % % وليس جنيبي ، إن عذلت ، بمصحبي % % 2(@)(@@) % فلم توفدي سخطا إلى متنصل % ولم تنزلي عتبا بساحة معتب % 3(@)(@@) % رضيت الهوى والشوق خدنا وصاحبا % فإن أنت لم ترضي بذلك فاغضبي % % 4(@)(@@) % تصرف حالات الفراق مصرفي % % على صعب حالات الأسى ومقلبي % % 5(@)(@@) % ولي بدن يأوي ، إذا الحب ضافه % إلى كبد حرى وقلب معذب % 6(@)(@@) % وخوطية شمسية رشئية % مهفهفة الأعلى رداح المحقب % 7(@)(@@) % تصدع شمل القلب من كل وجهة % وتشعبه بالبث من كل مشعب % 8(@)(@@) % بمختبل ساج من الطرف أحور % ومقتبل صاف من الثغر أشنب % 9(@)(@@) % من المعطيات الحسن والمؤتياته % مجلببة أو فاضلا لم تجلبب % 10(@)(@@) % لو ان امرأ القيس بن حجر بدت له % لما قال مرا بي على أم جندب % PageV01P068 11(@)(@@) % فتلك شقوري لا ارتيادك بالأذى % % محلي إلا تبكري تتأوبي % % 12(@)(@@) % أحاولت إرشادي ؟ فعقلي مرشدي % % أم استمت تأديبي فدهري مؤدبي % % 13(@)(@@) % هما أظلما حالي ثمت أجليا % % ظلاميهما عن وجه أمرد أشيب % 14(@)(@@) % شجى في حلوق الحادثات ، مشرق % به عزمه في الترهات مغرب % 15(@)(@@) % كأن له دينا على كل مشرق % من الأرض أو ثأرا لدى كل مغرب % 16(@)(@@) % رأيت لعياش خلائق لم تكن % لتكمل إلا في اللباب المهذب % 17(@)(@@) % له كرم لو كان في الماء لم يغض % وفي البرق ماشام امرؤ برق خلب % 18(@)(@@) % أخو أزمات ، بذله بذل محسن % إلينا ولكن عذره عذر مذنب % 19(@)(@@) % إذا أمه العافون ألفوا حياضه % ملاء وألفوا روضه غير مجدب % 20(@)(@@) % إذا قال أهلا مرحبا نبعت 
ms22	 لهم % مياه الندى من تحت أهل ومرحب % PageV01P069 21(@)(@@) % يهولك أن تلقاه صدرا لمحفل % ونحرا لأعداء وقلبا لموكب % 22(@)(@@) % مصاد تلاقت لوذا بريوده % قبائل حيي حضرموت ليعرب % 23(@)(@@) % بأروع مضاء على كل أروع % وأغلب مقدام على كل أغلب % 24(@)(@@) % كلوذهم فيما مضى من جدوده % بذي العرف والإحماد قيل ومرحب % 25(@)(@@) % ذوون ، قيول لم تزل كل حلبة % تمزق منهم عن أغر محنب % 26(@)(@@) % همام كنصل السيف كيف هززته % وجدت المنايا منه في كل مضرب % 27(@)(@@) % تركت حطاما منكب الدهر إذ نوى % % زحامي لما أن جعلتك منكبي % % 28(@)(@@) % وما ضيق أقطار البلاد أضافني % % إليك ولكن مذهبي فيك مذهبي % % 29(@)(@@) % وأنت بمصر غايتي وقرابتي % % بها وبنو الآباء فيها بنو أبي % % 30(@)(@@) % ولاغرو أن وطأت أكناف مرتعي % % لمهمل أخفاضي ورفهت مشربي % % PageV01P070 31(@)(@@) % فقومت لي ما اعوج من قصد همتي % % وبيضت لي ما اسود من وجه مطلبي % % 32(@)(@@) % وهاتا ثياب المدح فاجرر ذيولها % % عليك وهذا مركب الحمد فاركب % PageV01P071 البحر : وافر تام 1(@)(@@) % أنا بشر قد استفتحت بابا % وقد أتممته إلا قليلا % % 2(@)(@@) % فأصبح وهو جبار وعهدي % % به مذ أشهر يدعى فسيلا % % 3(@)(@@) % فلا أدري من الأعلى فعالا % ومن يبني العلى عرضا وطولا % % 4(@)(@@) % أمعطي الجزيل بلا امتنان % به ، أم من أفدت به الجزيلا ! % 5(@)(@@) % رأيتك تعرك الحاجات حتى % % تعيد بذاك أصعبها ذلولا % % 6(@)(@@) % وتصرخ من دعاك إلى المعالي % % بيا عبد الحميد ويا بجيلا % % 7(@)(@@) % هو الشكر الجسيم على الأعادي % % إذا شكر الرجال غدا ضئيلا % % 8(@)(@@) % فإنك لو ترى المعروف وجها % إذا لرأيته حسنا جميلا % % PageV01P072 البحر : وافر تام 1(@)(@@) % يد الشكوى أتتك على البريد % تمد بها القصائد بالنشيد % 2(@)(@@) % تقلب بينها أملا جديدا % تدرع حلتي طمع جديد % 3(@)(@@) % شكوت إلى الزمان نحول جسمي % % فارشدني إلى عبد الحميد % 4(@)(@@) % فجئتك راكبا أمل القوافي % % على ثقة من البلد البعيد % PageV01P073 البحر : خفيف تام 1(@)(@@) % من سجايا الطلول ألا تجيبا % % فصواب من مقلة أن تصوبا % % 2(@)(@@) % فاسألنها ، واجعل بكاك جوابا % تجد الشوق سائلا ومجيبا % % 3(@)(@@) % قد عهدنا الرسوم وهي عكاظ % للصبى 
ms23	 تزدهيك حسنا وطيبا % % 4(@)(@@) % أكثر الأرض زائرا ومزورا % وصعودا من الهوى وصبوبا % % 5(@)(@@) % وكعابا كأنما ألبستها % % غفلات الشباب بردا قشيبا % % 6(@)(@@) % بين البين فقدها قلما تع % رف فقدا للشمس حتى تغيبا % % 7(@)(@@) % لعب الشيب بالمفارق بل ج % % د فأبكى تماضرا ولعوبا % % 8(@)(@@) % خضبت خدها إلى لؤلؤ العق % % د دما أن رأت شواتي خضيبا % % 9(@)(@@) % كل داء يرجى الدواء له إلا % % الفظيعين : ميتة ومشيبا % % 10(@)(@@) % يا نسيب الثغام ذنبك أبقى % % حسناتي عند الحسان ذنوبا % % PageV01P074 11(@)(@@) % ولئن عبن ما رأين لقد أن % كرن مستنكرا وعبن معيبا % % 12(@)(@@) % أو تصدعن عن قلى لكفى بالش % يب بيني وبينهن حسيبا % % 13(@)(@@) % لو رأى الله أن للشيب فضلا % جاورته الأبرار في الخلد شيبا % % 14(@)(@@) % كل يوم تبدي صروف الليالي % % خلقا من أبي سعيد رغيبا % % 15(@)(@@) % طاب فيه المديح والتذ حتى % % فاق وصف الديار والتشبيبا % % 16(@)(@@) % لو يفاجا ركن النسيب كثير % بمعانيه خالهن نسيبا % % 17(@)(@@) % غربته العلى على كثرة النا % % س ، فأضحى في الأقربين جنيبا % % 18(@)(@@) % فليطل عمره ، فلو مات في مر % و مقيما بها لمات غريبا % % 19(@)(@@) % سبق الدهر بالتلاد ولم ين % تظر النائبات حتى تنوبا % % 20(@)(@@) % فإذا ما الخطوب أعفته كانت % راحتاه حوادثا وخطوبا % % PageV01P075 21(@)(@@) % وصليب القناة والرأي والإس % لام ، سائل بذاك عنه الصليبا % % 22(@)(@@) % وعر الدين بالجلاد ولك % ن وعور العدو صارت سهوبا % % 23(@)(@@) % فدروب الإشراك صارت فضاء % وفضاء الإسلام يدعى دروبا % % 24(@)(@@) % قد رأوه وهو القريب بعيدا % ورأوه ، وهو البعيد ، قريبا % % 25(@)(@@) % سكن الكيد فيهم إن من أع % % ظم إرب ألا يسمى أريبا % % 26(@)(@@) % مكرهم عنده فصيح وإن هم % خاطبوا مكره رأوه جليبا % % 27(@)(@@) % ولعمر القنا الشوارع تمري % % من تلاع الطلى نجيعا صبيبا % % 28(@)(@@) % في مكر للروع كنت أكيلا % للمنايا في ظله وشريبا % % 29(@)(@@) % لقد انصعت والشتاء له وج % ه يراه الكماة جهما قطوبا % % 30(@)(@@) % طاعنا منحر الشمال متيحا % لبلاد العدو موتا جنوبا % % PageV01P076 31(@)(@@) % في ليال تكاد تبقي بخد الشم % س من ريحها البليل شحوبا % % 32(@)(@@) % سبرات إذا الحروب أبيخت % هاج صنبرها فكانت 
ms24	 حروبا % % 33(@)(@@) % فضربت الشتاء في أخدعيه % ضربة غادرته عودا ركوبا % % 34(@)(@@) % لو أصخنا من بعدها لسمعنا % % لقلوب الأيام منك وجيبا % % 35(@)(@@) % كل حصن من ذي الكلاع وأكشو % % ثاء أطلقت فيه يوما عصيبا % % 36(@)(@@) % وصليلا من السيوف مرنا % وشهابا من الحريق ذنوبا % % 37(@)(@@) % وأرادوك بالبيات ومن ه % % ذا يرادي متالعا وعسيبا % % 38(@)(@@) % فرأوا قشعم السياسة قد ثق % ف من جنده القنا والقلوبا % % 39(@)(@@) % حية الليل يشمس الحزم منه % إن أرادت شمس النهار الغروبا % % 40(@)(@@) % لو تقصوا أمر الأزارق خالوا % % قطريا سما لهم أو شبيبا % % PageV01P077 41(@)(@@) % ثم وجهت فارس الأزد والأو % حد في النصح مشهدا ومغيبا % % 42(@)(@@) % فتصلى محمد بن معاذ % جمرة الحرب وامترى الشؤبوبا % % 43(@)(@@) % بالعوالي يهتكن عن كل قلب % صدره أو حجابه المحجوبا % % 44(@)(@@) % طلبت أنفس الكماة فشقت % من وراء الجيوب منهم جيوبا % % 45(@)(@@) % غزوة متبع ولو كان رأي % لم تفزد به لكانت سلوبا % % 46(@)(@@) % يوم فتح سقى أسود الضواحي % % كثب الموت رائبا وحليبا % % 47(@)(@@) % فإذا ما الأيام أصبحن خرسا % كظما في الفخار قام خطيبا % % 48(@)(@@) % كان داء الإشراك سيفك واش % % تدت شكاة الهدى ، فكنت طبيبا % % 49(@)(@@) % أنضرت أيكتي عطاياك حتى % % صار ساقا عودي وكان قضيبا % % 50(@)(@@) % ممطرا لي بالجاه والمال لا أل % % قاك إلا مستوهبا أو وهوبا % % PageV01P078 51(@)(@@) % فإذا ما أردت كنت رشاء % وإذا ماأردت كنت قليبا % % 52(@)(@@) % باسطا بالندى سحائب كف % بنداها أمسى حبيب حبيبا % % 53(@)(@@) % فإذا نعمة امرئ فركته % فاهتصرها إليك ولهى عروبا % % 54(@)(@@) % وإذا الصنع كان وحشا فمل % % يت برغم الزمان صنعا ربيبا % % 55(@)(@@) % وبقاء حتى يفوت أبو يع % % قوب في سنه أبا يعقوبا % % PageV01P079 البحر : كامل تام 1(@)(@@) % يوم الفراق لقد خلقت طويلا % % لم تبق لي جلدا ولا معقولا % % 2(@)(@@) % لو حار مرتاد المنية لم يرد % إلا الفراق على النفوس دليلا % % 3(@)(@@) % قالوا الرحيل فما شككت بأنها % % نفسي عن الدنيا تريد رحيلا % % 4(@)(@@) % الصبر أجمل غير أن تلددا % في الحب أحرى أن يكون جميلا % % 5(@)(@@) % أتظنني أجد السبيل إلى العزا % % وجد الحمام إذا إلي سبيلا ! % 6 
ms25	(@)(@@) % رد الجموح الصعب أسهل مطلبا % من رد دمع قد أصاب مسيلا % % 7(@)(@@) % ذكرتكم الأنواء ذكري بعضكم % فبكت عليكم بكرة وأصيلا % % 8(@)(@@) % وبنفسي القمر الذي بمحجر % % أمسى مصونا للنوى مبذولا % % 9(@)(@@) % إني تأملت النوى فوجدتها % % سيفا علي مع الهوى مسلولا % % 10(@)(@@) % لا تأخذيني بالزمان ، فليس لي % % تبعا ولست على الزمان كفيلا % % PageV01P080 11(@)(@@) % من زاحف الأيام ثم عبا لها % % غير القناعة لم يزل مفلولا % % 12(@)(@@) % من كان مرعى عزمه وهمومه % روض الأماني لم يزل مهزولا % % 13(@)(@@) % لو جاز سلطان القنوع وحكمه % في الخلق ما كان القليل قليلا % % 14(@)(@@) % الززق لا تكمد عليه فإنه % يأتي ولم تبعث إليه رسولا % % 15(@)(@@) % لله درك أي معبر قفرة % لا يوحش ابن البيضة الإجفيلا % % 16(@)(@@) % بنت الفضاء متى تخد بك لا تدع % في الصدر منك على الفلاة غليلا % % 17(@)(@@) % أو ما تراها ، ما تراها ، هزة % تشأى العيون تعجرفا وذميلا ! % 18(@)(@@) % لو كان كلفها عبيد حاجة % يوما لأنسي شدقما وجديلا % % 19(@)(@@) % بالسكسكي الماتعي تمتعت % همم ثنت طرف الزمان كليلا % % 20(@)(@@) % لا تدعون نوح بن عمرو دعوة % للخطب إلا أن يكون جليلا % % PageV01P081 21(@)(@@) % يقظ إذاما المشكلات عرونه % ألفينه المتبسم البهلولا % % 22(@)(@@) % ما زال يبرمهن حتى إنه % ليقال ، ما خلق الإله سحيلا % % 23(@)(@@) % ثبت المقام يرى القبيلة واحدا % ويرى فيحسبه القبيل قبيلا % % 24(@)(@@) % كم وقعة لك في المكارم فخمة % غادرت فيها ما ملكت فتيلا % % 25(@)(@@) % أوطأت أرض البخل فيها غارة % تركت حزون الحادثات سهولا % % 26(@)(@@) % فرأيت أكثر ماحبوت من اللهى % % نزرا وأصغر ما شكرت جزيلا % % 27(@)(@@) % لم يترك في المجد من جعل الندى % % في ماله للمعتفين وكيلا % % 28(@)(@@) % أوليس عمرو بث في الناس الندى % % حتى اشتهينا أن نصيب بخيلا % % 29(@)(@@) % أشدد يديك بحبل نوح معصما % تلقاه حبلا بالندى موصولا % % 30(@)(@@) % ذاك الذي إن كان خلك لم تقل % يا ليتني لم أتخذه خليلا % % PageV01P082 البحر : كامل تام 1(@)(@@) % كشف الغطاء فأوقدي أو أخمدي % % لم تكمدي فظننت ان لم يكمد % 2(@)(@@) % يكفيكه شوق يطيلث ظماءه % و اذا سقاه سقاه سم الأسود % 3(@)(@@) % عذلت 
ms26	 غروب دموعه عذاله % بسواكب فندن كل مفند % 4(@)(@@) % أتت النوى دون الهوى ، فأتى الأسى % % دون الاسى بحرارة لم تبرد % 5(@)(@@) % جارى إليه البين وصل خريدة % ماشت إليه المطل مشي الأكبد % 6(@)(@@) % عبث الفراق بدمعه بقلبه % عبثا يروح الجد فيه ويغتدي % % 7(@)(@@) % يا يوم شرد يوم لهوي لهوه % بصبابتي وأذل عز تجلدي % % 8(@)(@@) % ما كان أحسن لو غبرت فلم نقل % ما كان أقبح يوم برقة منشد % 9(@)(@@) % يوم أفاض جوى اغاض تعزيا % خاض الهوى بحري حجاه المزيد % 10(@)(@@) % عطفوا الخدور على وشي الخدود صيانة % وشي البرود بمسجف وممهد % PageV01P083 11(@)(@@) % أهلا وسهلا بالإمام ومرحبا % سهلت حزونة كل أمر قردد % 12(@)(@@) % غل المروراة الصحاصح عزمه % بالعيس إن قصدت وإن لم تقصد % 13(@)(@@) % متجرد ثبت المواطىء حزمه % متجرد للحادث المتجرد % 14(@)(@@) % فانتاش مصر من اللتيا والتي % % بتجاوز وتعطف وتغمد % 15(@)(@@) % في دولة لحظ الزمان شعاعها % % فارتد منقلبا بعيني أرمد % 16(@)(@@) % من كان مولده تقدم قبلها % % أو بعدها فكأنه لم يولد % 17(@)(@@) % الله يشهد أن هديك للرضا % % فينا ويلعن كل من لم يشهد % 18(@)(@@) % أولي أمة أحمد ما أحمد % بمضيع ما أوليت امة أحمد % 19(@)(@@) % أما الهدى فقد اقتدحت بزنده % في العالمين فويل من لم يهتد % 20(@)(@@) % نحن الفداء من الردى لخليفة % برضاه من سخط الليالي نفتدي % % PageV01P084 21(@)(@@) % ملك إذا ما ذيق مر المبتلى % % عند الكريهة عذب ماء المحتذ % 22(@)(@@) % هدمت مساعيه المساعي وابتنت % خطط المكارم في عراض الفرقد % 23(@)(@@) % سبقت خطا الأيام عمرياتها % % ومضت فصارت مسندا للمسند % 24(@)(@@) % ما زال يمتحن العلى ويروضها % % حتى اتقته بكيمياء السؤدد % 25(@)(@@) % فكأنما ظفرت يداه بالمنى % % 26(@)(@@) % سخطت لهاه على جداه سخطة % فاسترفدت أقصى رضا المسترفد % 27(@)(@@) % صدمت مواهبه النوائب صدمة % شغبت على شغب الزمان الأنكد % 28(@)(@@) % وطئت خزون الجود حتى خلتها % % فجرت عيونا في متون الجلمد % 29(@)(@@) % وأرى الأمور المشكلات تمزقت % ظلماتها عن رأيك المتوقد % 30(@)(@@) % عن مثل نصل السيف إلا أنه % مذ سل اول سلة لم يغمد % PageV01P085 31(@)(@@) % فبسطت أزهرها بوجه أزهر % وقبضت أربدها بوجه أربد 
ms27	 % 32(@)(@@) % % للراغبين زهادة في العسجد % 33(@)(@@) % لو يعلم العافون كم لك في الندى % % من فرحة وقريحة لم تخمد % 34(@)(@@) % و كأنما نافست قدرك حظه % و حسدت نفسك حين أن لم تحسد % 35(@)(@@) % % عصفت به أرواح جودك في غد % 36(@)(@@) % % فيها بشأو خلائق لم تجهد % 37(@)(@@) % % و حطمت بالانجاز ظهر الموعد % 38(@)(@@) % % فاقام عنك وأنت سعد الاسعد % 39(@)(@@) % % مرها وتربة ارضه من إثمد % 40(@)(@@) % هذا أمين الله آخر مصدر % شجي الظماء يه وأول مورد % PageV01P086 41(@)(@@) % ووسيلتي فيها اليك طريفة % شام يدين بحب آل محمد % 43(@)(@@) % حتى لقد ظن الغواة وباطل % أني تجسم في روح ال . . . . . % 45(@)(@@) % و متى يخيم في الفؤاد عناؤها % % فغناؤها يطوي المراحل في اليد % PageV01P087 البحر : كامل تام 1(@)(@@) % إني اتتني من لدنك صحيفة % غلبت هموم الصدر ، وهي غوالب % 2(@)(@@) % وطلبت ودي والتنائف بيننا % % فنداك مطلوب ومجدك طالب % 3(@)(@@) % فلتلقينك حيث كنت قصائد % فيها لأهل المكرمات مآرب % 4(@)(@@) % فكأنما هي في السماع جنادل % وكأنما هي في العيون كواكب % 5(@)(@@) % وغرائب تأتيك إلا أنها % % لصنيعك الحسن الجميل أقارب % 6(@)(@@) % نعم إذا رعيت بشكر لم تزل % نعما ، وإن لم ترع ، فهي مصائب % 7(@)(@@) % كثرت خطايا الدهر في ، وقد يرى % % بنداك ، وهو إلي منها تائب % 8(@)(@@) % وتتابعت أيامه وشهوره % عصبا يغرن كأنهن مقانب % 9(@)(@@) % من نكبة محفوفة بمصيبة % جذ السنام لها وجذ الغارب % 10(@)(@@) % أو لوعة منتوجة من فرقة % حق الدموع علي فيها واجب % PageV01P088 11(@)(@@) % وولهت مذ زمت ركابك للنوى % % فكأنني مذ غبت عني غائب % PageV01P089 البحر : طويل 1(@)(@@) % تحمل عنه الصبر يوم تحملوا % % وعادت صباه في الصبا وهي شمأل % 2(@)(@@) % بيوم كطول الدهر في عرض مثله % ووجدي من هذا وهذاك أطول % 3(@)(@@) % تولوا فولت لوعتي تحشد الأسى % % علي وجاءت عبرتي وهي تهمل % 4(@)(@@) % بذلت لهم مكنون دمعي ، فإن ونى % % فشوقي على ألا يجف موكل % 5(@)(@@) % ألا بكرت معذورة حين تعذل % تعرفني م العيش ما لست أجهل % 6(@)(@@) % أأتبع ضنك الأمر ، والأمر مدبر % وأدفع في صدر الغنى وهو مقبل % 7(@)(@@) % محمد يا بن 
ms28	 المستهل تهللت % عليك سماء من ثنائي تهطل % 8(@)(@@) % وكم مشهد أشهدته الجود ، فانقضى % % ومجدك يستحيا ومالك يقتل % 9(@)(@@) % بلوناك أما كعب عرضك في العلى % % فعال ولكن خذ مالك أسفل % 10(@)(@@) % تحملت ما لو حمل الدهر شطره % لفكر دهرا أي عبأيه أثقل % PageV01P090 11(@)(@@) % أبوك شقيق لم يزل وهو للندى % % شقيق وللملهوف حرز ومعقل % 12(@)(@@) % أفاد من العليا كنوزا لو انها % % صوامت مال ما درى أين تجعل % 13(@)(@@) % فحسب امرئ أنت امرو آخر له % % وحسبك فخرا أنه لك أول % 14(@)(@@) % وهل للقريض الغض أو من يحوكه % % على أحد إلاعليك معول ! % 15(@)(@@) % ليهن امرأ أثنى عليك بأنه % % قول وإن أربى فلا يتقول % 16(@)(@@) % سهلن عليك المكرمات فوصفها % % علينا إذا ما استجمعت فيك أسهل % 17(@)(@@) % رأيتك للسفرالمطرد غاية % يؤمونها حتى كأنك منهل % 18(@)(@@) % سألتك ألا تسأل الله حاجة % سوى عفوه مادمت ترجى وتسأل % 19(@)(@@) % وإياك لا إياي أمدح مثلما % % عليك يقينا لا علي المعول % 20(@)(@@) % ولست ترى أن العلى لك عندما % % تقول ولكن العلى حين تفعل % PageV01P091 21(@)(@@) % ولا شك أن الخير منك سجية % ولكن خير الخير عندي المعجل % PageV01P092 البحر : - 1(@)(@@) % أأطلال هند ساء ما اعتضت من هند % اقايضت حور العين بالعور ا . . . . . . % 2(@)(@@) % اذا شئن بالالوان كن عصابة % من الهند والآذان كن من الصغد % 3(@)(@@) % لعجنا عليك العيس بعد معاجها % % على البيض اترابا على النؤي والود % 4(@)(@@) % فلا دمع ما لم يجر في اثره دم % ولا وجد ما لم تعي عن صفة الوجد % 5(@)(@@) % ومقدودة رؤد تكاد تقدها % % اصابعها بالعين من حسن القد % 6(@)(@@) % تعصفر خديها العيون بحمرة % % اذا وردت كانت وبالا على الورد % 7(@)(@@) % اذا زهدتني في الهوى خيفة الردى % % جلت لي عن وجه يزهد في الزهد % 8(@)(@@) % وقفت بها اللذات في متنفس % من الغيث يسقي روضة في ثرى جعد % 9(@)(@@) % و صفراء احدقنا بها في حدائق % تجود من الأثمار بالثعد والمعد % 10(@)(@@) % بقاعية تجري علينا كؤوسها % % فتبدي الذي نخفي وتخفي الذي نبدي % % PageV01P093 11(@)(@@) % بنصر بن منصور بن بسام انفرى % % لنا شظف الأيام 
ms29	 عن عيشة رغد % 12(@)(@@) % ألا لا يمد الدهر كفا بسيئ % إلى مجتدي نصر فتقطع للزند % 13(@)(@@) % بسيب أبي العباس بدل أزلنا % % بخفض وصرنا بعد جزر إلى مد % % 14(@)(@@) % غنيت به عمن سواه وحولت % % عجاف ركابي من سعيد إلى سعد % 15(@)(@@) % له خلق سهل ونفس طباعها % % ليان ولكن عزمه من صفا صلد % 16(@)(@@) % رأيت الليالي قد تغير عهدها % % فلما تراءى لي رجهن إلى العهد % 17(@)(@@) % أسائل نصر لاتسله ، فإنه % احن إلى الأرفاد منك إلى الرفد % 18(@)(@@) % فتى ما يبالي حين تجتمع العلى % % له أن يكون المال في السحق والبعد % 19(@)(@@) % فتى جوده طبع فليس بحافل % أفي الجور كان الجود منه أو القصد % 20(@)(@@) % إذا طرقته الحادثات بنكبة % مخضن سقاء منه ليس بذي زبد % PageV01P094 21(@)(@@) % و نبهن مثل السيف لو لو تسله % يدان لسلته ظباه من الغمد % 22(@)(@@) % سأحمد نصرا ماحييت وإنني % % لأعلم أن قد جل نصر عن الحمد % 23(@)(@@) % تجلى به رشدي وأثرت به يدي % % و فاض يه ثمدي وأورى يه زندي % % 24(@)(@@) % فإن يك أربى عفو شكري على ندى % % أناس فقد أربى نداه على جهدي % % 25(@)(@@) % ومازال منشورا علي نواله % وعندي حتى قد بقيت بلا عندي % % 26(@)(@@) % وقصر قولي من بعد ما أرى % % أقول فأشجي امة وانا وحدي % % 27(@)(@@) % بغيت بشعري فاعتلاه ببذله % فلا يبغ في شعر له أحد بعدي % % PageV01P095 البحر : طويل 1(@)(@@) % لقد أخذت من دار ماوية الحقب % أنحل المغاني للبلى هي أم نهب ! % 2(@)(@@) % وعهدي بها إذ ناقض العهد بدرها % % مراح الهوى فيها ومسرحه الخصب % 3(@)(@@) % مؤزرة من صنعة الوبل والندى % % بوشي زلت وشي ، وعصب ولا عصب % 4(@)(@@) % تحير في آرامها الحسن ، فاغتدت % قرارة من يصبي ونجعة من يصبو % % 5(@)(@@) % سواكن في بر كما سكن الدمى % % نوافر من سوء كما نفر السرب % 6(@)(@@) % كواعب أتراب لغيداء أصبحت % وليس لها في الحسن شكل ولاترب % 7(@)(@@) % لها منظر قيد النواظر لم يزل % يروح ويغدو في خفارته الحب % 8(@)(@@) % يظل سراة القوم مثنى وموحدا % نشاوى بعينيها كأنهم شرب % 9(@)(@@) % إلى خالد 
ms30	 راحت بنا أرحبية % مرافقها من عن كراكرها نكب % 10(@)(@@) % جرى النجد الأحوى عليها فأصبحت % من السير ورقا وهي في نجدها صهب % PageV01P096 11(@)(@@) % إلى ملك لولا سجال نواله % لما كان للمعروف نقي ولا شخب % 12(@)(@@) % من البيض محجوب عن السوء والخنا % % ولا تحجب الأنواء من كفه الحجب % 13(@)(@@) % مصون المعالي لا يزيد أذاله % ولامزيد ولاشريك ولا الصلب % 14(@)(@@) % ولا مرتا ذهل ولا الحصن غاله % ولا كف شأويه علي ولا صعب % 15(@)(@@) % وأشباه بكر المجد بكر بن وائل % وقاسط عدنان وأنجبه هنب % 16(@)(@@) % مضوا وهم أوتاد نجد وأرضها % % يرون عظاما كلما عظم الخطب % 17(@)(@@) % وما كان بين الهضب فرق وبينهم % سوى أنهم زالوا ولم يزل الهضب % 18(@)(@@) % لهم نسب كالفجر ما فيه مسلك % خفي ولا واد عنود ولا شعب % 19(@)(@@) % هو الإضحيان الطلق ، رفت فروعه % % وطاب الثرى من تحته وزكا الترب % 20(@)(@@) % يذم سنيد القوم ضيق محله % على العلم منه أنه الواسع الرحب % PageV01P097 21(@)(@@) % رأى شرفا ممن يريد اختلاسه % % بعيد المدى فيه على أهله قرب % 22(@)(@@) % فيا وشل الدنيا بشيبان لاتغض % ويا كوكب الدنيا بشيبان لا تخب % 23(@)(@@) % فما دب إلا في بيوتهم الندى % % ولم ترب إلا في جحورهم الحرب % 24(@)(@@) % أولاك بنو الأحساب لولا فعالهم % درجن ، فلم يوجد لمكرمة عقب % 25(@)(@@) % لهم يوم ذي قار مضى وهو مفرد % وحيد من الأشباه ليس له صحب % 26(@)(@@) % به علمت صهب الأعاجم أنه % به أعربت عن ذات أنفسها العرب % 27(@)(@@) % هو المشهد الفصل الذي ما نجا به % % لكسرى بن كسرى لا سنام ولاصلب % 28(@)(@@) % أقول لأهل الثغر قد رئب الثأى % % وأسبغت النعماء والتأم الشعب % 29(@)(@@) % فسيحوا بأطراف الفضاء وأرتعوا % % قنا خالد من درب لكم درب % 30(@)(@@) % فتى عنده خير الثواب وشره % ومنه الإباء الملح والكرم العذب % PageV01P098 31(@)(@@) % أشم شريكي يسير أمامه % مسيرة شهر في كتائبه الرعب % 32(@)(@@) % ولما رأى توفيل راياتك التي % % إذا ما اتلأبت لا يقاومها الصلب % 33(@)(@@) % تولى ولم يأل الردى في اتباعه % كأن الردى في قصده هائم صب % 34(@)(@@) % كأن بلاد 
ms31	 الروم عمت بصيحة % فضمت حشاها أو رغا وسطها السقب % 35(@)(@@) % بصاغرة القصوى وطمين واقترى % % بلاد قرنطاووس وابلك السكب % 36(@)(@@) % غدا خائفا يستنجد الكتب مذعنا % عليك فلا رسل ثنتك ولا كتب % 37(@)(@@) % وما الأسد الضرغام يوما بعاكس % % صريمته إن أن بصبص الكلب % 38(@)(@@) % ومر ونار الكرب تلفح قلبه % وما الروح إلا أن يخامره الكرب % 39(@)(@@) % مضى مدبرا شطر الدبور ، ونفسه % على نفسه من سوء ظن بها إلب % 40(@)(@@) % جفا الشرق حتى ظن من كان جاهلا % بدين النصارى أن قبلته الغرب % PageV01P099 41(@)(@@) % رددت أديم الدين أملس بعدما % % غدا ولياليه وأيامه جرب % 42(@)(@@) % بكل فتى ضرب يعرض للقنا % % محيا محلى حليه الطعن والضرب % 43(@)(@@) % كماة ، إذا تدعى نزال لدى الوغى % % رأيتهم رجلى ، كأنهم ركب % 44(@)(@@) % من المطريين الأولى ليس ينجلي % % بغيرهم للدهر صرف ولا لزب % 45(@)(@@) % وما اجتليت بكر من الحرب ناهد % ولاثيب إلا ومنهم لها خطب % 46(@)(@@) % جعلت نظام المكرمات ، فلم تدر % رحا سؤدد إلا وأنت لها قطب % 47(@)(@@) % إذا افتخرت يوما ربيعة أقبلت % مجنبتي مجد وأنت لها قلب % 48(@)(@@) % يجف الثرى منها وتربك لين % وينبو بها ماء الغمام وما تنبو % % 49(@)(@@) % بجودك تبيض الخطوب إذا دجت % وترجع في ألوانها الحجح الشهب % 50(@)(@@) % هو المركب المدني إلى كل سؤدد % وعلياء إلا أنه المركب الصعب % PageV01P100 51(@)(@@) % إذا سبب أمسى كهاما لدى امرئ % أجاب رجائي عندك السبب العضب % 52(@)(@@) % وسيارة في الأرض ليس بنازح % على وخدها حزن سحيق ولا سهب % 53(@)(@@) % تذر ذرور الشمس في كل بلدة % وتمضي جموحا مايرد لها غرب % 54(@)(@@) % عذارى قواف كنت غير مدافع % أبا عذرها لا ظلم ذاك ولا غصب % 55(@)(@@) % إذا أنشدت في القوم ظلت كأنها % % مسرة كبر أو تداخلها عجب % 56(@)(@@) % مفصلة باللؤلو المنتقى لها % % من الشعر إلا أنه اللؤلؤ الرطب % PageV01P101 البحر : كامل تام 1(@)(@@) % كفي وغاك ، فإنني لك قالي % % ليست هوادي عزمتي بتوالي % % 2(@)(@@) % أنا ذوعرفت فإن عرتك جهالة % فأنا المقيم قيامة العذال % 3(@)(@@) % عطفت ملامتها على ابن ملمة % كالسيف جاب الصبر شخت الآل % 4(@)(@@) % عادت 
ms32	 له أيامه مسودة % حتى توهم أنهن ليالي % % 5(@)(@@) % لا تنكري عطل الكريم من الغنى % % فالسيل حرب للمكان العالي % % 6(@)(@@) % وتنظري خبب الركاب ينصها % % محيي القريض إلى مميت المال % 7(@)(@@) % لما بلغنا ساحة الحسن انقضى % % عنا تعجرف دولة الإمحال % % 8(@)(@@) % بسط الرجاء لنا برغم نوائب % كثرت بهن مصارع الآمال % 9(@)(@@) % أغلى عذارى الشعر إن مهورها % % عند الكريم وإن رخصن غوالي % % 10(@)(@@) % ترد الظنون به على تصديقها % % ويحكم الآمال في الأموال % PageV01P102 11(@)(@@) % أضحى سمي أبيك فيك مصدقا % بأجل فائدة وأيمن فال % % 12(@)(@@) % ورأيتني فسألت نفسك سيبها % % لي ثم جدت وما انتظرت سؤالي % % 13(@)(@@) % كالغيث ليس له ، أريد غمامه % % أو لم يرد ، بد من التهطال % PageV01P103 البحر : طويل 1(@)(@@) % قفوا جددوا من عهدكم بالمعاهد % وإن هي لم تسمع لنشدان ناشد % 2(@)(@@) % لقد أطرق الربع المحيل لفقدهم % و بينهم إطراق ثكلان فاقد % 3(@)(@@) % و ابقوا لضيف الحزن مني بعدهم % % قرى من جوى سار وطيف معاود % 4(@)(@@) % سقته ذعافا عادة الدهر فيهم % % و سم الليالي فوق سم الاساود % 5(@)(@@) % به علة للبين صماء لم تصخ % لبرء ولم توجب عيادة عائد % 6(@)(@@) % و في الكلة الوردية اللون جوذر % من العين ورد اللون ورد المجاسد % 7(@)(@@) % رماني بخلف بعد ما عاش حقبة % ولاسمري فيها لأول عاضد % 8(@)(@@) % غدت مغتدى الغضبى وأوصت خيالها % % بهجران نضو العيس نضو الخرائد % 9(@)(@@) % و قالت نكاح الحب يفسد شكله % و كم نكحوا حبا وليس بفاسد % 10(@)(@@) % سآوي بهذا القلب من لوعة الهوى % % إلى ثغب من نطفة اليأس بارد % PageV01P104 11(@)(@@) % و أروع لا يلقي المقاليد لامرئ % و كل امرئ يلقي له بالمقالد % 12(@)(@@) % له كبرياء المشتري وسعوده % وسورة بهرام وظرف عطارد % 13(@)(@@) % أغر يداه فرضتا كل طالب % وجدواه وقف في سبيل المحامد % 14(@)(@@) % فتى لم يقم فرضا بيوم كريهة % إلى كل أفق وافدا غير وافد % 15(@)(@@) % و لااشتدت الأيام الا ألانها % % اشم شديد الوطء فوق الشدائد % 16(@)(@@) % بلوناه فيها ماجدا ذا حفيظة % و ما كان ريب الدهر فيهابماجد % 17(@)(@@) % غدا قاصدا للمجد حتى أصابه 
ms33	 % وكم من مصيب قصده غير قاصد % 18(@)(@@) % هم حسدوه لا ملومين مجده % وماحاسد في المكرمات بحاسد % 19(@)(@@) % قراني اللهى والود حتى كأنما % % أفاد الغنى من نائلي وفوائدي % % 20(@)(@@) % فأصبح يلقاني الزمان من اجله % بإعظام مولود ورأفة والد % PageV01P105 21(@)(@@) % يصد عن الدنيا اذا عن سؤدد % و لو برزت في زي عذراء ناهد % 22(@)(@@) % إذا المرء لم يزهد وقد صبغت له % بعصفرها الدنيا فليس بزاهد % 23(@)(@@) % فواكبدي الحرى وواكبد الندى % % لأيامه لو كن غير بوائد % 24(@)(@@) % و هيهات ما ريب الزمان بمخلد % غريبا ولاريب الزمان بخالد % PageV01P106 البحر : طويل 1(@)(@@) % على مثلها من أربع وملاعب % أذيلت مصونات الدموع السواكب % 2(@)(@@) % أقول لقرحان من البين لم يضف % رسيس الهوى تحت الحشا والترائب % 3(@)(@@) % أعني أفرق شمل دمعي فإنني % % أرى الشمل منهم ليس بالمتقارب % 4(@)(@@) % وما صار في ذا اليوم عذلك كله % عدوي حتى صار جهلك صاحبي % % 5(@)(@@) % ومابك إركابي من الرشد مركبا % ألا إنما حاولت رشد الركائب % 6(@)(@@) % فكلني إلى شوقي وسر يسر الهوى % % إلى حرقاتي بالدموع السوارب % 7(@)(@@) % أميدان لهوي من أتاح لك البلى % % فأصبحت ميدان الصبا والجنائب ؟ ! % 8(@)(@@) % أصابتك أبكار الخطوب فشتتت % هواي بأبكار الظباء الكواعب % 9(@)(@@) % وركب يساقون الركاب زجاجة % من السير لم تقصد لها كف قاطب % 10(@)(@@) % فقد أكلوا منها الغوارب بالسرى % % فصارت لها أشباحهم كالغوارب % PageV01P107 11(@)(@@) % يصرف مسراها جذيل مشارق % إذا آبه هم عذيق مغارب % 12(@)(@@) % يرى بالكعاب الرود طلعة ثائر % وبالعرمس الوجناء غرة آيب % 13(@)(@@) % كأن به ضغنا على كل جانب % من الأرض أو شوقا إلى كل جانب % 14(@)(@@) % إذا العيس لاقت بي أبا دلف فقد % % تقطع مابيني وبين النوائب % 15(@)(@@) % هنالك تلقى الجود حيث تقطعت % تمائمه والمجد مرخى الذوائب % 16(@)(@@) % تكاد عطاياه يجن جنونها % % إذا لم يعوذها بنغمة طالب % 17(@)(@@) % إذا حركته هزة المجد غيرت % عطاياه أسماء الأماني الكواذب % 18(@)(@@) % تكاد مغانيه تهش عراصها % % فتركب من شوق إلى كل راكب % 19(@)(@@) % إذا ماغدا أغدى كريمة ماله % هديا ولو زفت لألأم خاطب % 20(@)(@@) % يرى أقبح الأشياء أوبة آيب 
ms34	 % كسته يد المأمول حلة خائب % PageV01P108 21(@)(@@) % وأحسن من نور تفتحه الصبا % % بياض العطايا في سواد المطالب % 22(@)(@@) % إذا ألجمت يوما لجيم وحولها % % بنو الحصن نجل المحصنات النجائب % 23(@)(@@) % فإن المنايا والصوارم والقنا % % أقاربهم في الروع دون الأقارب % 24(@)(@@) % جحافل لا يتركن ذا جبرية % سليما ولا يحربن من لم يحارب % 25(@)(@@) % يمدون من أيد عواص عواصم % تصول بأسياف قواض قواضب % 26(@)(@@) % إذا الخيل جابت قسطل الحرب صدعوا % % صدور العوالي في صدور الكتائب % 27(@)(@@) % إذا افتخرت يوما تميم بقوسها % % وزادت على ما وطدت من مناقب % 28(@)(@@) % فأنتم بذي قار أمالت سيوفكم % عروش الذين استرهنوا قوس حاجب % 29(@)(@@) % محاسن من مجد متى تقرنوا بها % % محاسن أقوام تكن كالمعايب % 30(@)(@@) % مكارم لجت في علو كأنها % % تحاول ثأرا عند بعض الكواكب % PageV01P109 31(@)(@@) % وقد علم الأفشين وهو الذي به % يصان رداء الملك عن كل جاذب % 32(@)(@@) % بأنك لما اسحنكك الأمر واكتسى % % أهابي تسفي في وجوه التجارب % 33(@)(@@) % تجللته بالرأي حتى أريته % به ملء عينيه مكان العواقب % 34(@)(@@) % بأرشق إذ سالت عليهم غمامة % جرت بالعوالي والعتاق الشوازب % 35(@)(@@) % نضوت له رأيين سيفا ومنصلا % وكل كنجم في الدجنة ثاقب % 36(@)(@@) % وكنت متى تهزز لخطب تغشه % ضرائب أمضى من رقاق المضارب % 37(@)(@@) % فذكرك في قلب الخليفة بعدها % % خليفتك المقفى بأعلى المراتب % 38(@)(@@) % فإن تنس يذكر أو يقل فيك حاسد % يفل قوله أو تنأ دار تصاقب % 39(@)(@@) % فأنت لديه حاضر غير حاضر % % جميعا وعنه غائب غير غائب % 40(@)(@@) % إليك أرحنا عازب الشعر بعدما % % تمهل في روض المعاني العجائب % PageV01P110 41(@)(@@) % غرائب لاقت في فنائك أنسها % % من المجد فهي الآن غير غرائب % 42(@)(@@) % ولو كان يفنى الشعر أفناه ما قرت % حياضك منه في العصور الذواهب % 43(@)(@@) % ولكنه صوب العقول إذا انجلت % سحائب منه أعقبت بسحائب % 44(@)(@@) % أقول لأصحابي هو القاسم الذي % % به شرح الجود التباس المذاهب % 45(@)(@@) % وإني لأرجو أن ترد ركائبي % % مواهبه بحرا ترجى مواهبي % % PageV01P111 البحر : طويل 1(@)(@@) % غدا الملك معمو الحرا والمنازل % منوروحف الروض عذب المناهل % 2(@)(@@) % بمعتصم بالله أصبح 
ms35	 ملجأ % ومعتصما حرزا لكل موائل % 3(@)(@@) % لقد ألبس الله الإمام فضائلا % وتابع فيها باللهى والفواضل % 4(@)(@@) % فأضحت عطاياه نوازع شردا % تسائل في الآفاق عن كل سائل % 5(@)(@@) % مواهب جدن الأرض حتى كأنما % % أخذن بآداب السحاب الهواطل % 6(@)(@@) % إذا كان فخرا للممدح وصفه % % بيوم عقاب أو ندى منه هامل % 7(@)(@@) % فكم لحظة أهديتها لابن نكبة % فأصبح منها ذا عقاب ونائل % 8(@)(@@) % شهدت أمير المؤمنين شهادة % كثير ذوو تصديقها في المحافل % 9(@)(@@) % لقد لبس الأفشين قسطلة الوغى % % محشا بنصل السيف غير مواكل % 10(@)(@@) % وسارت به بين القنابل والقنا % % عزائم كانت كالقنا والقنابل % PageV01P112 11(@)(@@) % وجرد من آرائه حين أضرمت % به الحرب حدا مثل حد المناصل % 12(@)(@@) % رأى بابك منه التي لا شوى لها % % فترجى سوى نزع الشوى والمفاصل % 13(@)(@@) % تراه إلى الهيجاء أول راكب % وتحت صبير الموت أول نازل % 14(@)(@@) % تسربل سربالا من الصبر وارتدى % % عليه بغضب في الكريهة قاصل % 15(@)(@@) % وقد ظللت عقبان أعلامه ضحى % بعقبان طير في الدماء نواهل % 16(@)(@@) % أقامت مع الرايات حتى كأنها % % من الجيش إلا أنها لم تقاتل % 17(@)(@@) % فلما رآه الخرميون والقنا % % بوبل أغاليه مغيث الأسافل % 18(@)(@@) % رأوا منه ليثا فابذعرت حماتهم % وقد حكمت فيه حماة العوامل % 19(@)(@@) % عشية صد البابكي عن القنا % % صدود المقالي لا صدود المجامل % 20(@)(@@) % تحدرمن لهبيه يرجو غنيمة % بساحة لا الواني ولا المتخاذل % PageV01P113 21(@)(@@) % فكان كشاة الرمل قيضه الردى % % لقانصه من قبل نصب الحبائل % 22(@)(@@) % وفي سنة قد أنفد الدهر عظمها % % فلم يرج منها مفرج دون قابل % 23(@)(@@) % فكانت كناب شارف السن طرقت % بسقب وكانت في مخيلة حائل % 24(@)(@@) % وعاذ بإطراف المعاقل معصما % وأنسي أن الله فوق المعاقل % 25(@)(@@) % فولى وماأبقى الردى من حماته % له غير أسآر الرماح الذوابل % 26(@)(@@) % أما وأبيه وهو من لا أبا له % يعد لقد أمسى مضيء المقاتل % 27(@)(@@) % فتوح أمير المؤمنين تفتحت % لهن أزاهير الربا والخمائل % 28(@)(@@) % وعادات نصر لم تزل تستعيدها % % عصابة حق في عصابة باطل % 29(@)(@@) % وما هو إلا الوحي أو حد مرهف % تميل ظباه 
ms36	 أخدعي كل مائل % 30(@)(@@) % فهذا دواء الداء من كل عالم % وهذا دواء الداء من كل جاهل % PageV01P114 31(@)(@@) % فيا أيها النوام عن ريق الهدى % % وقد جادكم من ديمة بعد وابل % 32(@)(@@) % هو الحق إن تستيقظوا فيه تغنموا % % وإن تغفلوا ، فالسيف ليس بغافل % PageV01P115 البحر : طويل 1(@)(@@) % طوتني المنايا يوم ألهو بلذة % وقد غاب عني أحمد ومحمد ! % 2(@)(@@) % جزى الله أيام الفراق ملامة % كما ليس يوم في التفرق يحمد % 3(@)(@@) % إذا ما انقضى يوم بشوق مبرح % اتى باشتياق فادح بعده غد % 4(@)(@@) % فلم يبق مني طول شوقي اليهم % سوى حسرات في الحشا تتردد % 5(@)(@@) % خليلي ما أرتعت طرفي ببهجة % وما انبسطت مني إلى لذة يد % 6(@)(@@) % و لا استحدثت نفسي خليلا مجددا % فيذهلني عنه الخليل المجدد % 7(@)(@@) % و لا حلت عن عهدي الذي قد عهدتما % % فدوما على العهد الذي كنت اعهد % 8(@)(@@) % فإن تختلوا دوني بأنس ولذة % فإني بطول البث والشوق مفرد % PageV01P116 البحر : بسيط تام 1(@)(@@) % مالي بعادية الأيام من قبل % لم يثن كيد النوى كيدي ولاحيلي % % 2(@)(@@) % لا شيء إلا أباتته على وجل % ولم تبت قط من شيء على وجل % 3(@)(@@) % قد قلقل الدمع دهر من خلائقه % % طول الفراق ولا طول من الأجل % 4(@)(@@) % سلني عن الدين والدنيا أجبك ، وعن % أبي سعيد وفقديه فلا تسل % 5(@)(@@) % من كان حلي الأماني قبل ظعنته % % فصرت مذ سار ذا أمنية عطل % 6(@)(@@) % نأي الندى لا تنائي خلة وهوى % والفجع بالمجد غير الفجع بالغزل % 7(@)(@@) % لئن غدا شاحبا تخدي القلاص به % لقد تخلفت عنه شاحب الأمل % 8(@)(@@) % ملقى الرجاء وملقى الرحل في نفر % الجود عندهم قول بلا عمل % 9(@)(@@) % أضحوا بمستن سيل الذم وارتفعت % أموالهم في هضاب المطل والعلل % 10(@)(@@) % من كل أظمى الثرى والأرض قد نهلت % ومقشعر الربا والشمس في الحمل ! % PageV01P117 11(@)(@@) % وأخرس الجود تلقى الدهر سائله % كأنه واقف منه على طلل ! % 12(@)(@@) % قد كان وعدك لي بحرا فصيرني % % يوم الزماع إلى الضحضاح والوشل % 13(@)(@@) % وبين الله هذا من بريته % % في قوله ' خلق الإنسان من 
ms37	 عجل ' % 14(@)(@@) % لله وخد المهاري أي مكرمة % هزت وأي غمام قلقلت خضل ! % 15(@)(@@) % خير الأخلاء خير الأرض همته % وأفضل الركب يقرو أفضل السبل % 16(@)(@@) % حطت إلى عمدة الإسلام أرحله % % والشمس قد نفضت ورسا على الأصل % 17(@)(@@) % ملبيا طالما لبى مناديه % إلى الوغى غير رعديد ولاوكل % 18(@)(@@) % ومحرما أحرمت أرض العراق له % من الندى واكتست ثوبا من البخل % 19(@)(@@) % وسافكا لدماء البدن قد سفكت % به دماء ذوي الإلحاد والنحل % 20(@)(@@) % وراميا جمرات الحج في سنة % رمى بها جمرات اليوم ذي الشعل % PageV01P118 21(@)(@@) % يردي ويرقل نحو المروتين كما % % يردي ويرقل نحو الفارس البطل % 22(@)(@@) % تقبل الركن ركن البيت نافلة % ظهر كفك معمو من القبل % 23(@)(@@) % لما تركت بيوت الكفر خاوية % بالغزو آثرت بيت الله بالقفل % 24(@)(@@) % والحج والغزو مقرونان في قرن % فاذهب فأنت زعاف الخيل والإبل % 25(@)(@@) % نفسي فداؤك إن كانت فداءك من % صرف الحوادث والأيام والدول % 26(@)(@@) % لاملبس ماله من دون سائله % % سترا ولا ناصب المعروف للعذل % 27(@)(@@) % لاشمسه جمرة تشوى الوجوه بها % % يوما ولا ظله عنا بمنتقل % 28(@)(@@) % تحول أمواله عن عهدها أبدا % ولم يزل قط عن عهد ولم يحل % 29(@)(@@) % ساري الهموم طموح العزم صادقه % % كأن آراءه تنحط من جبل % 30(@)(@@) % أبقى على جولة الأيام من كنفي % % رضوى وأسير في الآفاق من مثل % PageV01P119 31(@)(@@) % نبهت نبهان بعد النوم وانسكبت % بك الحياة على الأحياء من ثعل % 32(@)(@@) % كم قد دعت لك بالإخلاص من مرة % فيهم وفداك بالآباء من رجل % 33(@)(@@) % إن حن نجد وأهلوه إليك فقد % مررت فيه مرور العارض الهطل % 34(@)(@@) % وأي أرض به لم تكس زهرتها % % وأي واد به ظمآن لم يسل ! % 35(@)(@@) % ما زال للصارخ المعلي عقيرته % % غوث من الغوث تحت الحادث الجلل % 36(@)(@@) % من كل أبيض يجلو منه سائله % خدا أسيلا به خذ من الأسل % PageV01P120 البحر : رجز تام 1(@)(@@) % ياسهم للبرق الذي استطارا % % بات على رغم الدجى نهارا % % 2(@)(@@) % حتى اذا ما انجد الأبصارا % % وبلا جهارا أو ندى سرارا % % 3(@)(@@) % آض لنا ماء وكان نارا % % أرضى 
ms38	 الثرى وأسخط الغبارا % % PageV01P121 البحر : بسيط تام 1(@)(@@) % قل للأمير قد نال ما طلبا % % ورد من سالف المعروف ما ذهبا % % 2(@)(@@) % من نال من سؤدد زاك ومن حسب % ما حسب واصفه من وصفه حسبا % % 3(@)(@@) % إذا المكارم عقت واستخف بها % % أضحى الندى والسدى أما له وأبا % % 4(@)(@@) % ترضى السيوف به في الروع منتصرا % ويغضب الدين والدنيا إذا غضبا % % 5(@)(@@) % في مصعبيين ما لاقوا مريد ردى % للملك إلا أصاروا خده تربا % % 6(@)(@@) % كأنهم وقلنسي البيض فوقهم ، % يوم الهياج ، بدور قلنست شهبا % % 7(@)(@@) % فداء نعلك معطى حظ مكرمة % أصغى إلى المطل حتى باع ما وهبا % % 8(@)(@@) % إني وإن كان قوم مالهم سبب % إلا قضاء ، كفاهم دوني السببا % % 9(@)(@@) % وكنت أعلم علما لاكفاء له % أن ليس كل قطار ينبت العشبا % % 10(@)(@@) % وربما عدلت كف الكريم عن ال % % قوم الحضور ونالت معشرا غيبا % % PageV01P122 11(@)(@@) % لمضمر غلة تخبو ، فيضرمها % % إني سبقت ويعطي غيري القصبا % % 12(@)(@@) % ونادب رفعة قد كنت آملها % % لديك لا فضة أبكي ولا ذهبا % % 13(@)(@@) % أدعوك دعوة مظلوم وسيلته % إن لم تكن بي رحيما فارحم الأدبا % % 14(@)(@@) % احفظ وسائل شعر فيك ما ذهبت % خواطف البرق إلا دون ما ذهبا % % 15(@)(@@) % يغدون مغتربات في البلاد فما % % يزلن يؤنسن في الآفاق مغتربا % % 16(@)(@@) % ولا تضعها ، فما في الأرض أحسن من % نظم القوافي إذا ماصادفت حسبا % % PageV01P123 البحر : طويل 1(@)(@@) % لهان علينا أن نقول وتفعلا % % ونذكر بعض الفضل عنك وتفضلا % % 2(@)(@@) % أبا جعفر أجريت في كل تلعة % لنا جعفرا من فيض كفيك سلسلا % % 3(@)(@@) % فكم قد أثرنا من نوالك معدنا % وكم قد بنينا في ظلالك معقلا ! % 4(@)(@@) % رجعت المنى خضرا تثنى غصونها % % علينا وأطلقت الرجاء المكبلا % % 5(@)(@@) % ومايلحظ العافي جداك مؤملا % سوى لحظة حتى يؤوب مؤملا % % 6(@)(@@) % لقد زدت أوضاحي امتدادا ولم أكن % بهيما ولا أرضى من الأرض مجهلا % % 7(@)(@@) % ولكن أياد صادفتني جسامها % % أغر فأوفت بي أغر محجلا % % 8(@)(@@) % إذا أحسن الأقوام أن يتطاولوا % % بلا نعمة أحسنت أن تتطولا % % 9(@)(@@) % تعظمت عن ذاك التعظم منهم % وأوصاك نبل 
ms39	 القدر ألا تنبلا % % 10(@)(@@) % تبيت بعيدا أن توجه حيلة % على نشب السلطان أو تتأولا % % PageV01P124 11(@)(@@) % إذا ما أصابوا غرة فتمولوا % % بها راح بيت المال منك ممولا % % 12(@)(@@) % هززت أمير المؤمنين محمدا % فكان ردينيا وأبيض منصلا % % 13(@)(@@) % فما إن تبالي أن تجهز رأيه % إلى ناكث ألا تجهز جحفلا % % 14(@)(@@) % ترى شخصه وسط الخلاقة هضبة % وخطبته دون الخلافة فيصلا % % 15(@)(@@) % وأنك إذ ألبسته العز منعما % وسربلته تلك الخلافة فيصلا % % 16(@)(@@) % لتقضي به حق الرعية آخرا % وتقضي به حق الخلافة أولا % % 17(@)(@@) % فما هضبتا رضوى ولا ركن معنق % ولا الطود من قدس ولا أنف يذبلا % % 18(@)(@@) % بأثقل منه وطأة حين يغتدي % % فيلقي وراء الملك نحرا وكلكلا % % 19(@)(@@) % منيع نواحي السر فيه ، حصينها % % إذا صارت النجوى المذالة محفلا % % 20(@)(@@) % ترى الحادث المستعجم الخطب معجما % لديه ومشكولا إذا كان مشكلا % % PageV01P125 21(@)(@@) % وجدناك أندى من رجال اناملا % وأحسن في الحاجات وجها وأجملا % % 22(@)(@@) % تضيء إذا اسود الزمان وبعضهم % % يرى الموت أن ينهل أو يتهللا % % 23(@)(@@) % ووالله ما آتيك إلا فريضة % وآتي جميع الناس إلا تنفلا % % 24(@)(@@) % وليس امرؤ في الناس كنت سلاحه % عشية يلقى الحادثات بأعزلا % % 25(@)(@@) % يرى درعه حصداء والسيف قاضيا % وزجيه مسمومين والسوط مغولا % % 26(@)(@@) % سأقطع أمطاء المطايا برحلة % إلى البلد الغربي هجرا وموصلا % % 27(@)(@@) % إلى الرحم الدنيا التي قد أجفها % % عقوقي عسى أسبابها أن تبللا ! % 28(@)(@@) % قبيل وأهل لم ألاق مشوقهم % لوشك النوى إلا فواقا كلا ولا % % 29(@)(@@) % كأنهم كانوا لخفة وقفتي % % معارف لي أو منزلا كان منزلا % % 30(@)(@@) % ولو شيت لما التاث بري عليهم % ولم يك إجمالا لكان تجملا % % PageV01P126 31(@)(@@) % فلم أجد الأخلاق إلا تخلفا % ولم أجدش الأفضال إلا تفضلا % % 32(@)(@@) % وأصرف وجهي عن بلاد غدا بها % % لساني مشكولا وقلبي مقفلا % % 33(@)(@@) % وجد بها قوم سواي ، فصادفوا % % بها الصنع أعشى والزمان مغفلا % % 34(@)(@@) % كلاب أغارت في فريسة ضيغم % طروقا وهام أطعمت صيد أجدلا % % 35(@)(@@) % وإن صريح الرأي والحزم لامرئ % إذا بلغته الشمس أن يتحولا % % 36(@)(@@) % وإلا تكن تلك الأماني غضة % ترف فحسبي 
ms40	 أن تصادف ذبلا % % 37(@)(@@) % فليس الذي قاسى المطالب غدوة % هبيدا كمن قاسى المطالب حنظلا % % 38(@)(@@) % لئن هممي أوجدنني في تقلبي % % مآلا ، لقد أفقدنني منك موئلا % % 39(@)(@@) % وإن رمت أمرا مدبر الوجه إنني % % سأترك حظا في فنائك مقبلا % % 40(@)(@@) % وإن كنت أخطو ساحة المحل إنني % % لأترك روضا من جداك وجدولا % % PageV01P127 41(@)(@@) % كذلك لا يلقي المسافر رحله % % إلى منقل حتى يخلف منقلا % % 42(@)(@@) % ولا صاحب التطواف يعمر منهلا % وربعا إذا لم يخل ربعا ومنهلا % % 43(@)(@@) % ومن ذا يداني أو ينائي وهل فتى % % يحل عرى الترحال أو يترحلا ! % 44(@)(@@) % فمرني بأمر أحوذي فإنني % % رأيت العدا أثروا وأصبحت مرملا % % 45(@)(@@) % فسيان عندي صادفوا لي مطمعا % أعاب به أو صادفوا لي مقتلا % % 46(@)(@@) % ووالله لا أنفك أهدي شواردا % إليك يحملن الثناء المنخلا % % 47(@)(@@) % تخال به بردا عليك محبرا % وتحسبه عقدا عليك مفصلا % % 48(@)(@@) % ألذ من السلوى وأطيب نفحة % من المسك مفتوقا وأيسر محملا % % 49(@)(@@) % أخف على قلب وأثقل قيمة % وأقصر في سمع الجليس وأطولا % % 50(@)(@@) % ويزهى له قوم ولم يمدحوا به % إذا مثل الراوي به أو تمثلا % % PageV01P128 51(@)(@@) % على أن إفراط الحياء استمالني % % إليك ولم أعدل بعرضي معدلا % % 52(@)(@@) % فثقلت بالتخفيف عنك وبعضهم % يخفف في الحاجات حتى يثقلا ! % PageV01P129 البحر : كامل تام 1(@)(@@) % إني نظرت ولا صواب لعاقل % فيما يهم به اذا لم ينظر % 2(@)(@@) % فإذا كتابك قد تخير لفظه % و اذا كتابي ليس بالمتخير % 3(@)(@@) % و اذا رسوم في كتابك لم تدع % شكا لنظار ولا متفكر % 4(@)(@@) % شكل ونقط لا يخيل كأنه ال % % خيلان لاحت بين تلك الأسطر % PageV01P130 البحر : بسيط تام 1(@)(@@) % قد نابت الجزع من أروية النوب % واستحقبت جدة من ربعها الحقب % 2(@)(@@) % ألو بصبرك إخلاق اللوى وهفا % % بلبك الشوق لما أقفر اللبب % 3(@)(@@) % خفت دموعك في إثر الحبيب لدن % خفت من الكثبش القضبان والكثب % 4(@)(@@) % من كل ممكورة داب النعيم لها % % 5(@)(@@) % أطاعها الحسن وانحط الشباب على % % فؤادها وجرت في روحها النسب % 6(@)(@@) % لم أنسها وروف البين تظلمها % % ولامعول إلا الواكف السرب % 7 