ms41	 لموجد علتي % % 2(@)(@@) % فمن هو نفسي أو مغاير عينها % % ومن هو اجزائي ومن هو جملتي % % 3(@)(@@) % إذا عاينت عيني سبيل وجودها % % بفكري وذاتا لم تكن غير نشأتي % % 4(@)(@@) % أقول لها من أنت قالت مكلمي % % فقلت أرى ثنتين من خلف كلتي % % 5(@)(@@) % فقالت وكثر ما تشاء فإنني % % وإن كنت فدا أنتم أصل كثرتي % % 6(@)(@@) % فيا من هو المقصود في كل وجهة % بوجهي إذا ما كنت لي عين قبلتي % % 7(@)(@@) % فما عاينت عيناي فردا مقسما % % إلى عدد إلا الذي هو علتي % % 8(@)(@@) % هو الكل والأجزاء عين وجوده % % فيا مثبتي بي لست غير مثبتي % % 9(@)(@@) % لقد حرت في أمر تقسم واحدا % فأين وجودي قل لي أم أين وحدتي % % 10(@)(@@) % فيا من يرى عقدي وحيرة خاطري % % ويسرع بالتقريب في حل عقدتي % % PageV01P165 11(@)(@@) % علمت بأني عبده وهو سيدي % % وسلم لي علمي وأنشأ حيرتي % % 12(@)(@@) % وأعلم أني حائر وهو فارغ % % كما هو في شغل فيا حسرتي التي % % 13(@)(@@) % تباعدني في عين قربي شهودها % % فما حسن أفعالي وما سوء فعلتي % % 14(@)(@@) % لقد علمت نفسي وجودا محققا % وغابت به عني فلم تدر حكمتي % % PageV01P166 البحر : بسيط تام 1(@)(@@) % إني أرى إبلا يقتادها رجل % من أمر خالقه يعتاده ذاتي % % 2(@)(@@) % أسماؤه ظهرت من سيد عصمت % أقواله قد أتت نحوي بإثبات % % 3(@)(@@) % لقد رآني وجود الحق من قبلي % % وقال لي إن ذا من الكرامات % 4(@)(@@) % كأنه هو في المعنى وصرته % ولم أجد فارقا بين العاملات % 5(@)(@@) % فعين الله لي من جوده كرما % % روحا تنزه عن علم الإشارات % % 6(@)(@@) % أفادني منه أسرارا مخبأة % % معصومة الحال من علم الخفيات % % 7(@)(@@) % فعندما حصلت في القلب عشت بها % % وصرت حيا ولكن بين أموات % % 8(@)(@@) % فلم أجد كرسول الله من بشر % % أو وارثيه وهم أهل الحميات % 9(@)(@@) % لهم خبالات صيد من ذواتهم % وهم ظهور فمن أهل الخيالات % % 10(@)(@@) % والطير صيد ولكن أين قانصه % % صيد يصيد قوي في الدلالات % % PageV01P167 11(@)(@@) % من فاز بالنظر العلوي فاز بما % % في الغيب من فرح فيه ولذات % % PageV01P168 البحر : مجزوء الرمل 1(@)(@@) % أقتلوني 
ms42	 يا عداتي % % بوفائي بعداتي % % 2(@)(@@) % إنني أحيى بهذا % % فحياتي في مماتي % % 3(@)(@@) % ينقل الشخص اختصاصا % % من هنا لا عن ممات % 4(@)(@@) % ويراه الحس في صو % % رة أقوام موات % 5(@)(@@) % وبعين الكشف يعلم % أن ذا غير مواتي % % 6(@)(@@) % بل حياة استمرت % % في فتى أو فتيات % % 7(@)(@@) % أنا أبصرت علوما % % كالجور الزاخرات % % 8(@)(@@) % في فؤادي وعيونا % من سحاب معصرات % 9(@)(@@) % ينتهي من غير حد % نظر لا بأدات % 10(@)(@@) % فأنا فرد وحيد % وأنا الكل بذاتي % % PageV01P169 11(@)(@@) % عين إفرادي صحيح % % إنه عين ثباتي % % 12(@)(@@) % كم دعوت الله فيهم % بزوال في ثبات % 13(@)(@@) % ما أرى غير وجودي % % في اجتماعي وشتاتي % % 14(@)(@@) % كلما قلت أتاني % % قيل لي اسكن فسيأتي % % 15(@)(@@) % كمل الله وجودي % % بأب ثم بنات % 16(@)(@@) % فأنا ابن وأنا أي % ضا أب في المحدثات % 17(@)(@@) % ما لنا منه سوى ما % % قد علمتم من سمات % % 18(@)(@@) % ونعوت أظهرتها % % محدثات وصفات % 19(@)(@@) % لم أجد عين غناه % % دون ذكري حين ياتي % % 20(@)(@@) % فغناه عن وجودي % % وأنا فيه بذاتي % % PageV01P170 21(@)(@@) % ليت شعري كيف هذا % % وبقائي في وفاتي % % 22(@)(@@) % وأنا غير فقيد % % ناظرا حال حياتي % % 23(@)(@@) % قد تحيرت وما لي % % مخرج من غمراتي % % 24(@)(@@) % إنني عبد ذليل % لرفيع الدرجات % 25(@)(@@) % أرى كثرا في وحيد % يا لها من خطرات % 26(@)(@@) % كلما رمت انفكاكا % % لم أزل في عثراتي % % 27(@)(@@) % فتراني الدهر أبكي % % لدوام الحسرات % 28(@)(@@) % ثم ناجاني بأمر % فيه ذكر الحسنات % 29(@)(@@) % إن سمعنا وأطعنا % % ثم ذكر السيئات % 30(@)(@@) % إن سمعنا وعصينا % % ما أتى في الكلمات % PageV01P171 31(@)(@@) % بين إلقاء صريح % % بين أو نفثات % % 32(@)(@@) % ثم ما لي غير سكنى % % درج أو دركات % % 33(@)(@@) % في شهود أو حجاب % عن نعيم اللحظات % PageV01P172 البحر : بسيط تام 1(@)(@@) % ناداني الحق من عقلي ومن ذاتي % % فالسلب للعقل والإثبات للذات % 2(@)(@@) % كآية الشورى سلب وهي مثبتة % % ما قد نفته من إدراك لآلات % 3(@)(@@) % إني عملت على تحصيل شاهده % % حتى شهدت لما أضمرت آياتي % % 4(@)(@@) % فلم أعرج على أهل ولا ولد % % ولا على أحد من البريات % 5(@)(@@) % إلا به 
ms43	 فرأيت الكل صورته % % فكنت حيا به ما بين أموات % 6(@)(@@) % وعندما شهدت عيني منائحه % % ذوقا علمت به ما بين أموات % 7(@)(@@) % % ذوقا علمت به علم الخفيات % 8(@)(@@) % فكنت أشهده في كل حادثة % شهود من قد رآه في الحميات % % 9(@)(@@) % فسلم الأمر في بعد وفي كثب % % وجاد جودا بإيجاد على آلات % % 10(@)(@@) % بقاب قوسين أو أدنى علمت به % % علمي به في الثرى والسمهريات % PageV01P173 11(@)(@@) % إن الخلاف وفاق ليس يعلمه % % إلا الذي ذاقه عند الزيارات % % 12(@)(@@) % كمثل أسمائه الحسنى لمعتبر % % والعين واحدة والكل للذات % 13(@)(@@) % مع الخلاف الذي فيها لناظرها % % عند التقابل من أقوى الدلالات % % 14(@)(@@) % على الذي قلته إن كنت ذا نظر % % وكنت فيه من أرباب الكرامات % 15(@)(@@) % الحق يعلم ما وهم بصوره % فإنه الحق في درك النبوات % % 16(@)(@@) % من قال إن وجود الحق في صور % ورآها فهو جهل بالمقامات % 17(@)(@@) % لو قال مع قال علما لا خفاء به % والنقض يصحبه مع العلامات % 18(@)(@@) % لن قال مع كان أولى وهو مجهلة % أيضا ولو قال إن العين في اللاتي % % 19(@)(@@) % أصاب في كل وجه من مقالته % شرعا وعقلا وفيه نفي آفات % PageV01P174 البحر : متقارب تام 1(@)(@@) % خليلي لا تعجلا واكتما % % حديثي حذارا على مهجتي % % 2(@)(@@) % فإني اتحدت بمن قام لي % % إذا ما توجهت في قبلتي % % 3(@)(@@) % ففي كل شيء له صورة % إذا ما بدت فلها وجهتي % % 4(@)(@@) % وذاك الذي كنت أملته % % فما كان بعضي سوى جملتي % % 5(@)(@@) % تملكني وتملكته % % فلي عزه وله ذلتي % % 6(@)(@@) % وإن أنت تعكس ما قلته % يصح فجمعي في وحدتي % % 7(@)(@@) % وفي حال حبي أنا كاره % % له ولحبي فيا حيرتي % % 8(@)(@@) % أتاني ليلا على غفلة % % فثبت إتيانه حجتي % % 9(@)(@@) % لو أن الذي همت فيه هوى % % يكون على ديني أو ملتي % % 10(@)(@@) % لما كنت أشكو الجوى والنوى % % ولكنه ليس من عترتي % % PageV01P175 11(@)(@@) % يخالفني ووفاقي له % لذاك توقفت في وقفتي % % 12(@)(@@) % هويت السمان ومن لي بهم % % وحبي لعينهم نحلتي % % 13(@)(@@) % وما سمن القوم إلا الذي % % يبلغني منهم منيتي % % 14(@)(@@) % يقيني بهم مشحم 
ms44	 ملحم % يقيني من الأخذ في عثرتي % % PageV01P176 البحر : مجتث 1(@)(@@) % الله يعلم نفسي % % وما عليه أجنت % 2(@)(@@) % فحكمة الله لما % % طلبتها ما تجنت % 3(@)(@@) % فكم تمنت نفوس % إدراكها واطمأنت % 4(@)(@@) % ولو درت أن هذا % % يضرها ما استكنت % % 5(@)(@@) % لذاك خابت فذابت % ولم تنل ما تمنت % 6(@)(@@) % ولو تمت عقول % إليه بالشوق حنت % 7(@)(@@) % نالته علما ولكن % % ضلت به حين ظنت % 8(@)(@@) % لقد منحت مقاما % له الخلائق أنت % % 9(@)(@@) % كما خصصت بأمر % عنه الملائك جنت % % PageV01P177 البحر : طويل 1(@)(@@) % ثلاثة أسماء تكو ن بينها % % على ما تراه العين شكل مثلث % 2(@)(@@) % ثوى في جنان راحلا ومودعا % لأمر من الغيب الإلهي يحدث % 3(@)(@@) % ثنيت عنان الفكر فيه فلم أصب % % إلى أن أتاني الروح في الروع ينفث % 4(@)(@@) % ثبت له حتى إذا ما انقضى الذي % % أتاني به عينا فقمت أحدث % 5(@)(@@) % ثناء على الله الذي خصه بما % % جرى عند نسيان فلم يك ينكث % 6(@)(@@) % ثمال لأسماء إلهية بدت % بسلطانها فهو الإمام المحدث % % 7(@)(@@) % ثقلت بهذا الجسم عن نيل مطلبي % % مدى هذه الدنيا إلى حين أبعث % 8(@)(@@) % ثناني عليه فارحا لا مجاهدا % لذا أنا مسموع إذا ما يحدث % % 9(@)(@@) % ثقيل على الأسماع ما جئتها به % وفي الأرض والأفلاك والكل محدث % 10(@)(@@) % ثمانية حمالة عرش ذاته % % أنا وصفاتي بل أنا العرش فابحثوا % % PageV01P178 البحر : طويل 1(@)(@@) % نظرت إلى عين الوجود فلم أرى % % قديما ولكني رأيت حديثا % % 2(@)(@@) % أظن الذي قد كان بيني وبينه % % بيانا يسمى للحجاب كلوثا % % 3(@)(@@) % فشبهت نفسي في طلاب حقيقتي % % بليل أتى يبغي النهار حثيثا % % 4(@)(@@) % ليأخذ منه تارة فيرده % % إلى الغيب حتى لا يرى مبثوثا % % 5(@)(@@) % وهل يعدم العلات إلا قديمها % % ولكن نراه في العيان حدوثا % % 6(@)(@@) % فمد بنا حبلا من العلو نازلا % ولم يك في نعت الحبال رثيثا % % 7(@)(@@) % له قوة تغشى النعاس عيوننا % % لها ألسن فينا وكم وكميثا % % 8(@)(@@) % ويعطى قليلا من وجودي لأنني % % قليل ويعطينا الوجود أثيثا % % 9(@)(@@) % أضاحك في يوم السرور كرائما % وأقبل في اليوم العبوس ليوثا % % 10(@)(@@) % سمعنا حديثا 
ms45	 بالرصافة طيبا % وعند مسيئي لو سمع خبيثا % % PageV01P179 البحر : خفيف تام 1(@)(@@) % ما لقوم إذا تفكررت فيهم % لا يكادون يفقهون حديثا % % 2(@)(@@) % هم بعين القديم في كل حال % يطلبون الوجود منه حثيثا % % 3(@)(@@) % فيبثون علمه لشخوص % ما لديهم علم بذاك نثيثا % % 4(@)(@@) % قلت للعيسوي فيك انتباهق % % للذي قلته فقال كميثا % % PageV01P180 البحر : بسيط تام 1(@)(@@) % الفرق بين القديم الذات والحدث % يبين للمنكر المحجوب في الجدث % 2(@)(@@) % فاصبر عليه ولا تحفل بصولته % % ما دام في عالم التقييد بالخبث % 3(@)(@@) % الدهر ينقله لو كان يعقله % % لي اسم شيخ من اسم الكهل والحدث % % 4(@)(@@) % هذي شبيبته هذي كهولته % % هذا هو الهرم ما ينفك عن حدث % 5(@)(@@) % فما ترى طيبا يلذ مطعمه % % ألا ترى ضده المنعوت بالخبث % 6(@)(@@) % أين الحبائب من جمع الإناث من الذ % كران إذ جمعوا لحنا على خبث % % 7(@)(@@) % فليس ثم سوى فرق يبينه % ما قلته فاسترح فيه أو اكترث % PageV01P181 البحر : خفيف تام 1(@)(@@) % كيف يخشى فؤاد من ليس يخشى % % غير محبوبه القديم ويرجو % % 2(@)(@@) % كل قلب قد داخلته حظوظ % من كيان العلى فذا القلب ينجو % % PageV01P182 البحر : منسرح 1(@)(@@) % يا لابسا خرقة التصوف ما % % عليك فيما لبسته حرج % 2(@)(@@) % إن كنت من عصبة منزهة % قد عرفوا ذاتهم وما مرجوا % % 3(@)(@@) % قاموا على عفة ومسغبة % تهلك حتى أتاهم الفرج % 4(@)(@@) % تحصنوا بالعلي حين علوا % % وخصهم بالشهود إذ عرجوا % % 5(@)(@@) % فانظر إلى حالهم وحليتهم % % وحصن تقديسه الذي ولجوا % % 6(@)(@@) % وادخل من الموضع الذي دخلوا % % تخرج بالحلية التي خرجوا % % PageV01P183 البحر : بسيط تام 1(@)(@@) % إذا يضيق بنا أمر ليزعجنا % % نصبر فإن انتهاء الضيق ينفرج % 2(@)(@@) % بذاك خالقنا الرحمن عودنا % % في كل ضيق له قد شاءه فرج % % 3(@)(@@) % ألا ترى الأرض عن أزهارها انفرجت % % كما السماء لها في ذاتها فرج % 4(@)(@@) % والكون علو وسفل ليس غيرهما % % والأمر بينهما بالنص مندرج % % 5(@)(@@) % وكل شيء من الأكوان نعلمه % موحدا هو في القرآن مزدوج % 6(@)(@@) % حتى الوجود الذي إليه مرجعنا % % بما له من صفات الكون يزدوج % % 7(@)(@@) % فليس يوجد فرد ليس 
ms46	 يشفعه % % شيء سوى من له التقسيم والدرج % 8(@)(@@) % ذاك الإله الذي لا شيء يشبهه % % من خلقه فبه الإصباح تتبلج % % 9(@)(@@) % وهو العزيز فلا مثل يعادله % وإنما بمتاب العبد يبتهج % % 10(@)(@@) % فكيف من هو محتاج ومفتقر % إلى أمور بنا إن لم يكن حرج % PageV01P184 11(@)(@@) % فلا يصح على الإطلاق أن لنا % % حكم الغنى ولهذا فيه يندرج % 12(@)(@@) % الحب شاهد عدل في قضيتنا % % إذا الخلائق فيما قلته مرجوا % % 13(@)(@@) % هم المصابيح في الظلماء إن ولجوا % % كما هم العمى إن زالوا وإن خرجوا % % 14(@)(@@) % سبحانه وتعالى أن يحيط به % % علما عقول لما في ذاته دلجوا % % 15(@)(@@) % أما تراها على الأعقاب ناكصة % % لما رأت فنيت في ذلك المهج % % 16(@)(@@) % فليس يدرك مجهول حقيقته % وفيه خلف لأقوام لهم حجج % % 17(@)(@@) % لو أنهم نظروا في حسن صورته % % قالوا به قرن قالوا به فلج % 18(@)(@@) % قالوا بعينيه في إبصاره وطف % قالوا به كحل قالوا به دعج % 19(@)(@@) % فما أقاموا على حال وما جمعوا % % عليه في علمهم فيه وما درجوا % % 20(@)(@@) % هذا مع الخلق كيف الحق فاعتبروا % % ما في بيوتهم من نوره سرج % PageV01P185 البحر : بسيط تام 1(@)(@@) % تاه الفؤاد بذكر الله وابتهجا % % ولاح صبح الهدى للعبد وابتلجا % % 2(@)(@@) % وأسرج الله من أنوار حكمته % ومن معارفه في قلبه سرجا % % 3(@)(@@) % فظل يفتح من أبواب رحمته % % على خليقته ما كان قد رتجا % % PageV01P186 البحر : بسيط تام 1(@)(@@) % إني اتخذت إلى ذي العرش معراجا % فإن لي شرعة منه ومنهاجا % % 2(@)(@@) % على لسان رسول منه ألبسني % % به المهيمن في إسرائه تاجا % % 3(@)(@@) % إذا رأيت وفود الله قد وصلوا % % يأتون دين الإله الحق أفواجا % % 4(@)(@@) % فاستغفر الله واطلب عفوه كرما % وكن فقيرا إلى الرحمن محتاجا % % 5(@)(@@) % معاشر الناس إن الله أنبتكم % % من أرضه نطفا في النشء أمشاجا % % 6(@)(@@) % وثم أولجكم لما أماتكم % فيها لأمر أراد الحق إيلاجا % % 7(@)(@@) % وقد علمت بأن الله يخرجكم % % بعد الممات من الأجداث إخراجا % % 8(@)(@@) % من بعد إنزاله من أجل نشأتكم % ماء كمثل مني الناس ثجاجا % % 9(@)(@@) % وصير الناس أقساما منوعة 
ms47	 % % ثلاثة في كتاب الله أزواجا % % 10(@)(@@) % لو أن ما عندنا من علم صانعنا % % يكون في رهج الاسواق ما راجا % % PageV01P187 البحر : بسيط تام 1(@)(@@) % إني نذرت وما في النذر من حرج % بذل الذي ملكت كفي من المهج % 2(@)(@@) % لوجه ربي إن جاد الإله على % % قلبي بمعرفة الأوزان والدرج % 3(@)(@@) % في العلم بالله إلا بالغير ان لنا % % نفسا قد اعتادت التنزيه في الفرج % 4(@)(@@) % ما بين أطباق أفلاك مزينة % بزينة الله في التأديب والدلج % 5(@)(@@) % إني أسير إليه وهو يطلبني % % في كل حال بسر غير منزعج % % 6(@)(@@) % وذاك أني في سيري أشاهده % يسير بي نحو ذاتي سيرض مبتهج % 7(@)(@@) % في كل حال فيفنيني مشاهدة % % عني وما عندنا في ذاك من حرج % 8(@)(@@) % لم يبق عقل ولا حس أحس به % % فيرحم الغصن ما في اللدن من عوج % 9(@)(@@) % أومت إلي وقد ظلت محفتها % % بكفها والذي في الطرف من غنج % 10(@)(@@) % لا تركبن بحارا لست تعرفها % % فقد تلاطمت الأمواج في اللجج % PageV01P188 11(@)(@@) % واثبت على السيف إن السيف مرحمة % ولا توسط فإن الهلك في الثبج % % 12(@)(@@) % قد ضفت ذرعا بما تأتي شكايته % فهل لديكم بما يشكوه من فرج % PageV01P189 البحر : طويل 1(@)(@@) % جميل ولا يهوى جلي ولا يرى % % لقد حار فيه صاحب الفكر والحجج % 2(@)(@@) % جنيت بمصحوب على كل حالة % تحيره الأمواج في هذه اللجج % 3(@)(@@) % جرى معه الفكر الصحيح إلى مدى % % فما غاب عن ثف ولا بلغ البثج % 4(@)(@@) % جميع النهى غرقى شهود أو فكرة % % ففي عينه نفي العقول مع المهج % 5(@)(@@) % جمعت له ذاتي فلم تك غيره % فحرت فما أدري ثوى في أم خرج % % 6(@)(@@) % جزى القدر المحتوم في كل كائن % بما هو فيه ما عليه به حرج % 7(@)(@@) % جزى الله عنا من يجازي مسيئنا % % على سوءه حسنا فأصبح يبتهج % 8(@)(@@) % جزاء وفاقا لا اتفاقا وإنهم % % يقولون بالتوحيد والأمر مزدوج % % 9(@)(@@) % جنينا عليه بالقبول فأمرنا % % مريج فعين الكون تبدو إذا مرج % % 10(@)(@@) % جماع بأثنى قيل فيها طبيعة % تولد منه كل ما دب أو درج 
ms48	 % % PageV01P190 البحر : كامل تام 1(@)(@@) % البرق يلمع والرعود تسبح % والغيث ينزل والمنازل تصبح % 2(@)(@@) % مخضرة هاماتها وبقاعها % % والزهر في روضاتها يتفتح % 3(@)(@@) % فترى جنان الخلد أنشاها لنا % % بصدور أعلام إذا هي تشرح % 4(@)(@@) % وقطوفها تدنو فتطعم من له % ذوق إا هي بالعبارة تفصح % 5(@)(@@) % فالخلق منه إذا نظرت مهلل % ومكبر ومعظم ومسبح % % 6(@)(@@) % والكل مثن بالذي هو أهله % فالله يعطي من يشاء ويمنح % PageV01P191 البحر : بسيط تام 1(@)(@@) % بالعصر أقسم أن الخير يلزم من % % في الوزن يخسر ميزانا ويرجحه % % 2(@)(@@) % حتى إذا جاء يوم الحشر موقفنا % % الخوف يبهمه والوزن يوضحه % 3(@)(@@) % وليس باب من الأبواب يغلقه % إلا وفعلك يأتيه فيفتحه % 4(@)(@@) % فالجود يمنحه والعدل يصلحه % والعلم يوضحه والوزن يفضحه % % 5(@)(@@) % إن كان شرا فشرا أنت كاسبه % % أو كان خيرا فخيرا أنت تمنحه % % PageV01P192 البحر : بسيط تام 1(@)(@@) % المرجفان هما الإبريق والطاس % والأحمران كذاك اللحم والراح % 2(@)(@@) % والشحم ثم الشباب الأبيضان إلى % % شهود هذين نفس القوم ترتاح % 3(@)(@@) % والتمر والماء عندي الأسودان يرى % % كأنه في ظلام الليل مصباح % 4(@)(@@) % الجاه والذهب المسكوك نعتهما % % الأصفران ووجه التبر وضاح % % 5(@)(@@) % إذا تجلى لك المطلوب فيه بدت % لناظر القلب في الأشباح أرواح % % 6(@)(@@) % هي المعاني قد راحت وما برحت % قد قيدتها عن التسريح أشباح % % 7(@)(@@) % لو أنها سألت عنهم جماعتهم % % لقال قائلهم راحوا وما راحوا % % 8(@)(@@) % في فقد ما قلته الآلام أجمعها % % كما بوجد إنها للنفس أفراح % 9(@)(@@) % إني نصحتكم لما رحمتكم % وذا الوجود قليل فيه نصاح % % PageV01P193 البحر : بسيط تام 1(@)(@@) % باب المعارف مفتوح لقارعه % % وكيف يقرع باب وهو مفتوح % 2(@)(@@) % ما ذاك إلا لما في الدار من حرم % % والشخص ذو بصر والصدر مشروح % 3(@)(@@) % وصاحب الدار غيران وذو مقة % % في أهله والهوى رمز وتشريح % 4(@)(@@) % وليس يقرع هذا الباب غير فتى % % له قليب به وجد وتبريح % 5(@)(@@) % له قليب مع أهل الدار حيره % % هوى له فيه تطفيف وترجيح % 6(@)(@@) % ما الحب إلا لأهل الدار ليس لها % % وقد يكون لها وفيه تلويح % % 7(@)(@@) % لأنهم عينها إن كنت 
ms49	 ذا نظر % ولا تقل هي دار إنه ريح % % PageV01P194 البحر : بسيط تام 1(@)(@@) % إن الذي فرض القرآن يرجعكم % إلى معاد وفيه العيش والفرح % 2(@)(@@) % يأتي إليك به من كل ناحية % عوارف الخير والآلاء والمنح % % 3(@)(@@) % وحار منها رجال سادة صبروا % % عن بابه الدهر ما زالوا وما برحوا % % 4(@)(@@) % إن الذين بسهم الحب قد قتلوا % % وددت لو أنهم ماتوا وما جرحوا % % 5(@)(@@) % لله قوم إذا ما أصلحوا فسدوا % % وثم قوم إذا ما أفسدوا صلحوا % % PageV01P195 البحر : كامل تام 1(@)(@@) % حمدا الإله يقدس الأرواحا % % باللام لا بالباء والأشباحا % % 2(@)(@@) % حمد سرى نحو المهيمن سره % % ليشاهد الأقلام والألواحا % % 3(@)(@@) % حياه عند نزوله في لا ولا % % من شرف المشكاة والمصباحا % % 4(@)(@@) % حتى يراقب نشأة ممزوجة % ويواصل الإمساء والإصباحا % % 5(@)(@@) % حر عن الأغيار عبد للذي % % جلى إليه وجهه الوضاحا % % 6(@)(@@) % حاذر غوائل مكره في بسطه % لا تأمن الرزاق والفتاحا % % 7(@)(@@) % حنت إليه ركائب من شوقه % منحته فتح الباب والمفتاحا % % 8(@)(@@) % حاميم يتلوها طواسم رمزه % % ليسخر الأفلاك والأرواحا % % 9(@)(@@) % حاربت من أهواه فيه بأمره % لأحصل الأكساب والأرباحا % % 10(@)(@@) % حتى أوافي الضد صحبة عاشق % وأجانب العدال والمنصاحا % % PageV01P196 البحر : وافر تام 1(@)(@@) % ولست لمن أجالده بغير % جزاء إذ أجالده كفاحا % % 2(@)(@@) % ولكني أجالد فيه نفسي % % وأبغي الفوز فيه والنجاحا % % PageV01P197 البحر : خفيف تام 1(@)(@@) % صحت بالكوكب المنير عشاء % يا نظير النور بدر الصباح % 2(@)(@@) % يا حبيبي وهل علي إذا ما % % جئتكم عن حقيقة من جناح % 3(@)(@@) % أين سر الوصال بالله قل لي % % منكما في الطلاق أو في النكاح % 4(@)(@@) % عمل هل يصح فيه ازدواج % أي وتهيام بالوجوه الصباح % 5(@)(@@) % نكح المغرب الصباح فأبدى % % ربنا عند ذاك نور الصلاح % 6(@)(@@) % فأنارت أرض الوجود وأبدت % % كل شيء مخبأ في البطاح % % 7(@)(@@) % ثم غابا عن الوجود زمانا % حين حلت عساكر الاقتراح % % 8(@)(@@) % وأقاما بربوة المحو حتى % % ما أهلت أهلة الافتتاح % 9(@)(@@) % قيل يا كوكبان هبا بخير % % كمهب الجنوب بين الرياح % 10(@)(@@) % وانعما بالشهود حالا وعلما % واسعيا للصلاة عند الرواح % PageV01P198 11(@)(@@) % ثم لما من الكريم 
ms50	 عليهم % % باتصال الذوات بعد انتزاح % 12(@)(@@) % قلت : ليت الإله يشرح صدري % % لعلوم تنال دون تلاحي % % 13(@)(@@) % جاءني الكوكب العلي رسولا % من حكيم مهيمن فتاح % % 14(@)(@@) % قال يا سائل الكريم علوما % ما على عالم بها من جناح % % 15(@)(@@) % إن تكن تحسن استماع خطابي % % خذ حباك الإله بالانشراح % 16(@)(@@) % فعل أشباحنا على الروح يبدو % % وكذا فعله على الأشباح % 17(@)(@@) % حكمة مهد الحكيم ثراها % % وبنا سقفها لأمر متاح % % 18(@)(@@) % يا أخي قم تر حبيبك عينا % فاعلا في الجسوم والأرواح % PageV01P199 البحر : سريع 1(@)(@@) % ألبست ست العيش مثل الذي % % ألبسني أهل التقى والسماح % 2(@)(@@) % خرقة أهل الله فخرا وما % % على الذي يلبسها من جناح % 3(@)(@@) % وشرطها أن تلبيها على الشر % % ط الذي يلبس أهل الصلاح % % 4(@)(@@) % مقامها الفوز غدا والنجاح % في كل ما تطلبه والفلاح % PageV01P200 البحر : خفيف تام 1(@)(@@) % شرع القتل للرجوع سريعا % للذي جئت منه عند الكفاح % 2(@)(@@) % دون موت وإن عيني تراه % ميتا قد علمت معنى السراح % 3(@)(@@) % جعل الله في الشهادة رزقا % للذي نالها بغير انتزاح % % 4(@)(@@) % فهو إن كان في العيان فسادا % فهو عند الإله عين الصلاح % 5(@)(@@) % كل ما كان أو يكون وما لا % % إنما كونه بأمر متاح % % 6(@)(@@) % ما يريد العبيد منه تعالى % % غير درك المنى وخفض الجناح % % 7(@)(@@) % ما على من يريد ردا إليه % % في الذي قد أتى به من جناح % % 8(@)(@@) % ما يريد العصاة منه تعالى % % غير عفو عن الذنوب القباح % % 9(@)(@@) % ما يريد الفقير منه تعالى % % غير بذل الندى وجود السماح % 10(@)(@@) % هو ليلي إذا أتيت أناجي % % ونهاري عند المسا والصباح % PageV01P201 11(@)(@@) % لو تراني إذا وصلت إليه % % من وجودي في بسطة وانشراح % 12(@)(@@) % لست أبغي سواه في كل حال % أنا فيه من ضيق أو انفساح % % PageV01P202 البحر : مجزوء الكامل 1(@)(@@) % فهو القوي إذا قضى % % وهو القوي إذا منح % 2(@)(@@) % فالحمد لله الذي % % بهما على قلبي فتح % % 3(@)(@@) % إني رأيت الحق وال % ميزان في يده رجح % 4(@)(@@) % فسألته ما يبتغي % % فأجاب ما يدري فصح % 5(@)(@@) % قول الخلائق كلهم 
ms51	 % % إن الكريم له المنح % 6(@)(@@) % ما زلت أعبده له % % والمؤمنين ومن صلح % % 7(@)(@@) % من ليس يعبده كذا % % بين الخلائق يفتضح % % 8(@)(@@) % وإذا فهمت مقالتي % % زند المشاهد ينقدح % 9(@)(@@) % فترى الذي قد قلته % % من نور زندك قد وضح % % 10(@)(@@) % فاقدح زناد وجوده % % فالكشف فيه لمن قدح % PageV01P203 11(@)(@@) % إني نصحتكم وقد % أدى الأمانة من نصح % PageV01P204 البحر : رمل تام 1(@)(@@) % كل فعل كان مني حكمه % بين ندب ووجوب ومباح % 2(@)(@@) % ثم مكروه وحظر فانظروا % % كل هذا عينه عين الصلاح % 3(@)(@@) % علم ذات نعت تنزيه لها % % ثم أسماء معان تستباح % 4(@)(@@) % وصفات الفعل فرض فعلها % % ثم إدراك به كان الفلاح % % 5(@)(@@) % فانظروا ما قلت في خالقنا % % والزموا الباب وقولوا لا براح % 6(@)(@@) % فجميع الناس قد أسعدهم % % بين تقييد وقول بالسراح % 7(@)(@@) % فالذي أطلق منهم علمه % % رب جود ووفاء وسماح % 8(@)(@@) % % رب حرب ونزاع وكفاح % 9(@)(@@) % إنما العلم الذي أطلبه % % بإلهي هو بالشرع الصراح % % 10(@)(@@) % مسكن الشخص الذي يحظى به % بيته المعلوم فينا بالضراح % % PageV01P205 البحر : طويل 1(@)(@@) % خبير بما أبدى عليم بما أخفى % % علي من التفريغ من كرم السخ % 2(@)(@@) % خفى بما أبداه من نور ذاته % % عن العقل والأبصار في عالم السلخ % 3(@)(@@) % خبرت وجود الكون في كل حالة % فعاينته قد حاز مرتبة المسخ % 4(@)(@@) % خؤونا أمينا صادقا كاذبا وما % % تقابلت الأحوال إلا من الطبخ % % 5(@)(@@) % خلقت لأمر لا أقوم بحقه % % وذلك لاستعدادنا حالة النفخ % 6(@)(@@) % خصصنا بأسماء الإله عناية % وبالصورة المثلى وأكرمت بالنسخ % 7(@)(@@) % خصوصية جاءت من الله تبتغي % % كرامة شيخ نالها زمن الشرخ % 8(@)(@@) % خصيص به ذاك المقام لأنه % تولد ما بين العفار إلى المرخ % % 9(@)(@@) % خفيف مع الطبع الثقيل إذا مشى % % يحوز طريق الشاة والفيل والرخ % 10(@)(@@) % خبيئة صاف كرم الله ذاته % % بها فله من نورها سورة الدخ % PageV01P206 البحر : مخلع البسيط 1(@)(@@) % البدر في المحو لا يجارى % % وفي تناهيه لا يحد % 2(@)(@@) % صح له النور بعد محو % % ثم إليه يعود بعد % 3(@)(@@) % سرائر سرها ثلاث % % رب مليك والله فرد % 4(@)(@@) % في المحو 
ms52	 صحت له فأثنت % عليه لما أتاه يعدو % % PageV01P207 البحر : كامل تام 1(@)(@@) % فأنا الذي لا عين لي موجود % وأنا الذي لا حكم لي مفقود % 2(@)(@@) % عنقاء مغرب قد تعورف ذكرها % % عرفا وباب وجودها مسدود % 3(@)(@@) % ما صير الرحمن ذكري باطلا % لكن لمعنى سره مقصود % 4(@)(@@) % هو أنني وهابه أسرارهم % % عرفانها فصراطنا ممدود % % 5(@)(@@) % والسالكون على مراتب نورهم % % فأجلهم من نوره التجريد % PageV01P208 البحر : كامل تام 1(@)(@@) % الله يعلم والدلائل تشهد % أني إمام العالمين محمد % 2(@)(@@) % لكن لنا وقت نراقب كونه % % فإذا أتى فالسلك فيه مهند % % PageV01P209 البحر : طويل 1(@)(@@) % أنا المحي لا أكنى ولا أتبلد % % أنا العربي الحاتمي محمد % 2(@)(@@) % لكل زمان واحد هم عينه % وإني ذاك الشخص في العصر أوحد % 3(@)(@@) % وما الناس إلا واحد بعد واحد % حرام على الأدوار شخصان يوجد % 4(@)(@@) % أقابل عضات الزمان بهمة % تذل لها السبع الشداد وتخمد % 5(@)(@@) % مويدنا فيه على كل حالة % إله السما وهو النصير المؤيد % 6(@)(@@) % وما ذاك عن حق ولكن عناية % % اتتني وحسادي تروم وتجهد % % PageV01P210 البحر : بسيط تام 1(@)(@@) % يوم المعارج يوم لا انقضاء له % % دنيا وآخرة لا ينقضي أمده % 2(@)(@@) % وكل ما ينقضي منه لحادثة % تكون فيه وفيها ينتهي أبده % % 3(@)(@@) % ولو يعد الذي يكون من حدث % في يومه ما انتهى في يومه عدده % 4(@)(@@) % لو كان لي سند ما كنت مستندا % إليه والعلم يقضي أنني سنده % PageV01P211 البحر : بسيط تام 1(@)(@@) % الوهم يصلح ما الألباب تفسده % % في الحق لكنها ما لوهم تبعده % 2(@)(@@) % العقل يحكم والأوهام تحكمه % % فيه فتضبطه ولا تحدده % 3(@)(@@) % وكيف يحكم عقل قاصر حدث % على مكونه والعجز مشهده % 4(@)(@@) % تنوع الذات بالأفكار إن لها % % مثل الهيولى ولكن لا تعدده % % 5(@)(@@) % يرمي الإله بها من كان عنه به % وليس يرمي به إلا ويقصده % 6(@)(@@) % العقل بالنظر الفكري يمسكه % % والكشف يرسله ولا يقيده % 7(@)(@@) % لو كان للعقل حكم في مكونه % % لما أتى شرعه وقتا يفنده % % PageV01P212 البحر : طويل 1(@)(@@) % تنوعت الأحوال فاعترف العبد % وكان له القرب المعين والبعد % 2(@)(@@) % ألم تر أن 
ms53	 الله قد وعد الذي % % أتاه به صدقا وقد صدق الوعد % % 3(@)(@@) % فمن كان ذا عهد وليا بعهده % يوفي له بالشرع ما قرر العهد % % 4(@)(@@) % فسلم إليه الأمر في كل حالة % % فلله هذا من قبل من بعد % 5(@)(@@) % أنا المؤمن السجاد أبغي بسجدتي % % شهود إله قيل فيه هو الفرد % 6(@)(@@) % وما هو إلا الواحد الأحد الذي % % يقر به عقد ويجحده عقد % 7(@)(@@) % فمن شاء فليرحل ومن شاء فليقم % فقد عرف المعنى وقد حققا لقصد % PageV01P213 البحر : طويل 1(@)(@@) % أمرت فلم أسمع دعوت فلم تجب % ألا ليت شعري من هو الرب والعبد % 2(@)(@@) % تسترت عني بي فقلت بأني % % ظهرت فلم تخف خفيت فلم أبد % 3(@)(@@) % طلبتكم مني فلم أر غيركم % فهل حكم القبل المحكم والبعد % 4(@)(@@) % قعدت بكم عنكم لكوني كونكم % % فلما قعدنا قمت أنت بنا تعدو % % 5(@)(@@) % إليكم عسى يبدو وجودي إليكم % فألقيته في إسم يقال له الفرد % 6(@)(@@) % فأسماؤك الحسنى يكثر كونها % % وجودي ولولا ذاك لم يكن البعد % 7(@)(@@) % فمن يحصها حالا يكون بجنة % ومن يحصها عدا يكون له الحد % 8(@)(@@) % لي البعد والتداني من اسمكم % فبعدي لكم قرب وقربي بكم بعد % 9(@)(@@) % إذا أنت أعطيت النعيم وجدتني % % شكورا وإن لم تعطني فلك الحمد % % 10(@)(@@) % مركبنا يبغيه برهان وجدكم % % وأفراده بالذات يطلبها الحد % PageV01P214 11(@)(@@) % فمن قام في الأفراد فالحد آجل % ومن قام في التركيب برهانه النقد % % 12(@)(@@) % فكم بين موضوع حماه محرم % % وكم بين محمول يساعده الجد % 13(@)(@@) % إذا غطني ملقى الحديث بباطني % % ففي حل تركيبي يكون له قصد % % 14(@)(@@) % فيفصم عني وهو للذات قاهر % إذا بلغ المقصود من غطى الجهد % % 15(@)(@@) % أسايره حتى إذا ينقضي الذي % % أتاني به ألوي على عقبي أعدو % % 16(@)(@@) % يزملني من كان عندي حاضرا % لما هد مني ما تضمنه العهد % 17(@)(@@) % ولست بما قد قلته بمشرع % لقومي ولكني ورثت فلم أعد % 18(@)(@@) % بما أنا مأمور به أنا آمر % وما لي مهما جاني منهما بد % 19(@)(@@) % لعبت بشطرنج العقول مدبرا % ولي في الذي يبدو القبول أو الرد 
ms54	 % 20(@)(@@) % وبالنرد يلهو صاحب الشرع والحجى % % وقد عرف المطلوب من لهوه النرد % PageV01P215 21(@)(@@) % وبينهما شطرنج نرد لمن يرى % % ويقضي عليه ما يقابله العقد % % 22(@)(@@) % تولى على الأسرار سلطان وده % % وأفلح شر كان سلطانه الود % 23(@)(@@) % له حرمات في شهور تعينت % % فواحدهم فرد وباقيهم سرد % % 24(@)(@@) % إذا أنت شاهدت الوجود وجوده % بذلك ما يعطيه من قدحه الزند % 25(@)(@@) % ولكنه بالريح روح بقائه % % يقال له في عرفنا النفخ والوقد % 26(@)(@@) % فيفعل فعل النور والنار وسمه % كما لهما الإطفاء والذم والحمد % % 27(@)(@@) % فخض بفتح النون إذ عم نفعه % ورحمته والضم من شأنه السد % 28(@)(@@) % فتطمع فيه الكاعبات لنفعه % % وترهب منه في أماكنها الأسد % PageV01P216 البحر : بسيط تام 1(@)(@@) % تنزيهك الحق حد أنت تعلمه نعت المهيمن بالإطلاق تقييد % وكل ما قيل فيه فهو تحديد % 2(@)(@@) % وإن سكت على عجز أفوز به % % فذلك العجز أيضا فيه تقييد % % 3(@)(@@) % فليس يخرج في ظني ومعرفتي % % شيء عن القيد لا شرك وتوحيد % 4(@)(@@) % تنزيهك الحق حد أنت تعلمه % إن النزيه بنفي الحد محدود % % 5(@)(@@) % إن قلت ليس كذا أثبته بكذا % % وذا لباس نزيه فيه تجريد % 6(@)(@@) % سلب التحير عنه لا يشرفه % وكيف يشرف بالتنزيه معبود % 7(@)(@@) % لو لم يكن في كذا لزال عنه كذا % % وزال عنه به حمد وتمجيد % 8(@)(@@) % أسماؤه تطلب الأكوان أجمعها % % فنعتها بالغنى المعلوم مفقود % 9(@)(@@) % لولا القبول الذي منا لما ظهرت % آثارها فلنا من ذلك الجود % 10(@)(@@) % إن الوجود الذي أثبته نسب % فلا وجود فما في العين موجود % PageV01P217 11(@)(@@) % بذا المحال الذي ترمي به فطر % وكيف يقبله والكون مشهود % 12(@)(@@) % أثبت عينك عند النفي نافية % % فمن نفيت وباب النفي مسدود % 13(@)(@@) % وكيف تنفي وجودا أنت تثبته % عقلا وعينا وحوض العقل مورود % % PageV01P218 البحر : بسيط تام 1(@)(@@) % والله لا ناله مما أنا سيد % من المعارف والزلفى ولا لبد % 2(@)(@@) % ولا تعين في شيء يكون لنا % % ولو يعيش الذي قد عاشه لبد % 3(@)(@@) % لله قوم لهم علم ومعرفة % وهم عليه إذا يدعوهم لبد % % 4(@)(@@) % عمي وأبصارهم بالنور ناظرة 
ms55	 % لو يشهدون الذي شهدته شهدوا % % 5(@)(@@) % لا يشهدون وإن قامت حقائقهم % بهم معاينة من ربهم شهدوا % % 6(@)(@@) % إن العبيد الذين الحق عينهم % % لنفسه واصطفاهم كلهم عبدوا % % 7(@)(@@) % جلاله واستمروا في عبادته % ولو تجلى لهم في عينهم عبدوا % % 8(@)(@@) % ولا تردد فيه من تردده % إلا رجال به من نفسهم عبدوا % % 9(@)(@@) % من أجله قام بي ما يشهدون به % % المسك والند والتخليق والجسد % 10(@)(@@) % وإنني لتجليه إذا نظرت % عين المحقق في ذاتي له جسد % % PageV01P219 11(@)(@@) % لما تعين مني ما اتصفت به % لذاك قام بمن يدري به حسد % 12(@)(@@) % دنوا من الحضرة العلياء حين بدت % أعلام صدقهم منهم وما بعدوا % % 13(@)(@@) % إن أسدلت حجب الأغيار ودونهم % أبقاهم وبرفع الستر قد بعدوا % % 14(@)(@@) % لله قوم غزاة ما لهم عدد % وإن أسماءه الحسنى هي العدد % 15(@)(@@) % مقدم العسكر الجرار سيدهم % % وهم كثيرون لا يحصى لهم عدد % 16(@)(@@) % إن ينصروا الله ينصرهم بهمته % ومن خواطرهم يأتيهم المدد % % 17(@)(@@) % تاه الزمان فلم يظفر بحصرهم % وما حواهم فلم تقطعهم المدد % % 18(@)(@@) % لما تعرض لي من كنت أحسبه % معي ومستندي لم يبق لي سند % % 19(@)(@@) % من كان أسماؤه الحسنى له سندا % معنعنا في ترقيه علا السند % % PageV01P220 البحر : بسيط تام 1(@)(@@) % بالشرع أعلم ما البرهان ينكره % والشرع أولى بما أولي وأقصده % 2(@)(@@) % الأين والكيف والأعضاء أجمعها % % مع القوى وبها أثني وأحمده % 3(@)(@@) % له كما جاء في الشرع المطهر من % زيغ العقول ومن وهم يحدده % % 4(@)(@@) % لذاك جاء بإيمان يصدقه % وحرم الفكر في ذات يعبده % % 5(@)(@@) % أهل العقول عصوه فهي زيهم % بما تولده والكشف يفسده % 6(@)(@@) % فظنها أنها في كل ما نظرت % أصابت الحق والبرهان يعضده % PageV01P221 البحر : رمل تام 1(@)(@@) % إن لي ربا كريما أجده % كالذي نعلم أو نعتقده % 2(@)(@@) % هو مني وأنا منه به % % ولذا في كل حال أجده % 3(@)(@@) % كل من نال الذي قد نلته % % من وجود قد تعالى مشهده % 4(@)(@@) % إن أستاذي الذي أدبني % % هو شخص في وجودي يشهده % 5(@)(@@) % هو مني والد معتبر % وأنا منه كهو أو 
ms56	 ولده % % 6(@)(@@) % لا أسميه لأني عالم % % أنه يكره ذا بل يعبده % % 7(@)(@@) % ولذا قلت بشخص للذي % % قد روى من قد تعالى سنده % 8(@)(@@) % ما قصدنا لنوال غيره % هو رفدي فأنا أسترفده % 9(@)(@@) % إنه النائب عن خالقنا % % برضانا ولذا نعتمده % 10(@)(@@) % من يكن يعرفه جهلا به % % أن يرى في كل حال نعبده % % PageV01P222 11(@)(@@) % وبهذا الأمر قد كلفنا % % وعلمنا أن هذا مقصده % 12(@)(@@) % فليكن عندك من ذا خبر % منصف تعرفه لا تجحده % % PageV01P223 البحر : بسيط تام 1(@)(@@) % إذا رأيت وجودا ما له حد % أقبلت أعدو إليه وهو بي يعدو % % 2(@)(@@) % فقال لي وهو من ذاتي يخاطبني % % إن الوجود الذي رأيته فقد % 3(@)(@@) % فقلت : أنت معي فقال : أنت معي % % كالفرد يضرب فيه عندنا الفرد % 4(@)(@@) % لما رأيت وجودي لا يزايلني % % علمت أن وجود السيد العبد % % 5(@)(@@) % بذا أتت في كتاب الله صورته % % الأمر لله من قبل ومن بعد % 6(@)(@@) % الحق عندي معي بي وهو معتمدي % % في كل حال إذا أروح أو أغدو % % 7(@)(@@) % الجود يبغي وجودي فهو لي سند % وما لنا منه في أعياننا بد % 8(@)(@@) % كمثل أسمائه الحسنى التي ثبتت % بالنص يطلبها التقييد والعد % 9(@)(@@) % إن العقول لتحصيها مفصلة % % فيها الخلاف وفيها المثل والضد % 10(@)(@@) % كذلك الحكم في كوني فأما أنا % % أثبتها فلها الإثبات والوجد % PageV01P224 11(@)(@@) % والحلم فينا الذي يعطي حقائقنا % % الحل والعقد والتليين والشد % 12(@)(@@) % هو الذي لم يزل يخفي حقيقته % بما هي اليوم في أبصارنا تبدو % % 13(@)(@@) % منه الأمور التي تشقى وتسعدنا % % أخرى ويشهد ذا الغي والرشد % PageV01P225 البحر : بسيط تام 1(@)(@@) % علمي بربي عزيز ليس يعرفه % إلا الذي ذاقه من خلقه أحد % % 2(@)(@@) % وهم رجال ذوو علم ومعرفة % لأنهم وجدوا عين الذي أجد % 3(@)(@@) % مضى بكل الذي في النفس من جلد % لم يبق لي سبد منه ولا لبد % 4(@)(@@) % وليس علمي بشيء غاب عن بصري % % لأنني عينه والأمر متحد % 5(@)(@@) % فلست أجهلني ولا أكيفه % % لو أنني عشت ما قد عاشه لبد % 6(@)(@@) % ما زال يطلبني من كنت أطلبه % % وليس يثبت من 
ms57	 قولي هنا عدد % % 7(@)(@@) % لانها نسب والعين واحدة % % ما بيننا وبهذا العلم ينفرد % % 8(@)(@@) % إني رويت علوما عن مهيمنها % % وما لنا غير أسماء لها سند % % 9(@)(@@) % هم الشيوخ لنا إن كنت تعرف ما % % ذكرته وهم السادات والعدد % % 10(@)(@@) % بهم يدافعهم وليس غيرهم % هناك فاعلم بأن الساكن البلد % % PageV01P226 11(@)(@@) % لولا تحكمهم لم ندر أنهم % هم وعين حجاب الناظر الجسد % 12(@)(@@) % لذاك يحسدنا من ليس يعرفنا % % وليس ثم فلا عين ولا حسد % % PageV01P227 البحر : بسيط تام 1(@)(@@) % حس يفرق والأرواح تتحد % أنا الفقير وأنت السيد الصمد % 2(@)(@@) % أنت الذي بجمال الكون ينفرد % % وأنت أيضا بذات العين تتحد % 3(@)(@@) % فليس يبقى لعين الاتحاد بنا % % في كوننا كثرة تبدو ولا عدد % 4(@)(@@) % العلم يشهد أن الأمر واحدة % كما أتتك به الآيات فاتئدوا % % 5(@)(@@) % لو كلف الخلق ما عاشوا عبادته % % من غير حد لما ملوا وما عبدوا % % 6(@)(@@) % تغلي من أجلي أجفاني لنار هوى % % بالقلب من داخل الأحشاء تتقد % 7(@)(@@) % لله قوم بترك الاقتداء شقوا % % وآخرون بترك الاقتدا سعدوا % % 8(@)(@@) % الحق أبلج ما يخفى على أحد % وقد تنازع فيه النسر والأسد % % 9(@)(@@) % عليه أجمع أهل الأرض كلهم % عقلا وشرعا فما يرمى به أحد % % 10(@)(@@) % من أعجب الأمر فيهم ما أفوه به % % هم المقرون بالأمر الذي جحدوا % % PageV01P228 11(@)(@@) % وإنما اختلفت فيه مقاصدهم % % فنعم ما قصدوا وبئس ما وجدوا % % 12(@)(@@) % إلا إمام بعين الشرع أدركه % له الإصابة نعم الركن والسند % % 13(@)(@@) % هو الكريم فما تحصى مواهبه % من العطايا ومنه الجود والرفد % % 14(@)(@@) % لما توهم أن الأمر مغلطة % عقل المنازع تاه العقل فاستندوا % % 15(@)(@@) % إلى الشريعة لا تلوي على نظر % من العيون التي أصابها الرمد % 16(@)(@@) % لو أنها شفيت مما بها نظرت % يعطي العلوم بسير الكوكب الرصد % 17(@)(@@) % وإن ربك بالمرصاد فازدجروا % % يدري بذلك سباق ومقتصد % % 18(@)(@@) % ترنو إليك عيون ما لها بصر % % لما تمكن منها الغل والحسد % 19(@)(@@) % وذاك حين رأت كشفا قد اختلفت % % عليه عند ذوي ألبابه الجدد % % 20(@)(@@) % فقال شخص بما الثاني يقابله % % وكلهم ناظر في 
ms58	 الله مجتهد % PageV01P229 21(@)(@@) % منوع في التجلي حكمه أبدا % % ما ثم روح تراه ما له جسد % % 22(@)(@@) % فلو تجلى إلى الاسرار كان له % % حكم يخالف هذا ما له أمد % % 23(@)(@@) % وإنما يتجلى في بصائرنا % % فيحكم الوهم فيه بالذي يجد % 24(@)(@@) % وقتا ينزهه وقتا يشبهه % % وقتا يمثله جسما ويعتقد % % 25(@)(@@) % إن الحديث على ما قد تخيله % وقد تحكم فيه الغي والرشد % % 26(@)(@@) % سبحانه وتعالى أن تراه على % % ما قد رأى نفسه فإنه الأحد % % 27(@)(@@) % والواحد الحق لا غير يشفعه % % والغير ما ثم فاستره إذا يرد % 28(@)(@@) % لو كان لي نظر في ما نظرت % % عيني إليه به ما ضمني البلد % % 29(@)(@@) % هو الأمين الذي آلى به قسما % في حق من لم يكن لكونه أمد % 30(@)(@@) % لو انتفى الأزل المعلوم عنه كما % % عنه انتفى إذ نفاه الحال والبلد % % PageV01P230 البحر : بسيط تام 1(@)(@@) % هيهات هيهات لا مال ولا ولد % % نعم ولا سبد يبقى ولا لبد % 2(@)(@@) % وليس ينفعني إذا وردت على % % رب السموات إلا الواحد الصمد % 3(@)(@@) % سبحانه وتعالى أن يكيفه % % عقل وأن يمتري في كونه أحد % % 4(@)(@@) % هو المهيمن فوق العرش أعمده % % بنصبه ما له في فعله مرد % % 5(@)(@@) % المال عندي وحال الفقر يحجبني % % عنه فعين افتقاري ذلك السند % 6(@)(@@) % إلى غني ملي لا افتقار له % % إلى الأمور التي إليه تستند % 7(@)(@@) % إذا يحكمني فيما يملكني % % في الحال أحجره فكيف اعتمد % % 8(@)(@@) % عليه فيه وعندي الضعف يمنعني % % عن التصرف فيه هكذا أجد % % 9(@)(@@) % وقوة الحال عين العلم أذهبها % % بالأصل صبرا ولا صبر ولا جلد % % 10(@)(@@) % لو كنت أصبر أو أقوى على جلد % % ما ضمني للذي قد عالني بلد % PageV01P231 11(@)(@@) % وما أنا الغوث أحمي الخلق منه ولا % % أنا له بدل ولا أنا وتد % 12(@)(@@) % لكنني خاتم بالعلم منفرد % لله مرتقب بالسر متحد % 13(@)(@@) % لا يعتريني لما قد قلت عني أذى % % ولا ينهنهني عن بغيتي الأسد % PageV01P232 البحر : طويل 1(@)(@@) % سما فاعتلى في كل حال مقام من % % إذا قيل أنت الرب قال أنا العبد % 2(@)(@@) % على الكل 
ms59	 عهد قد عرفت مقامه % فمن لا يفي بالعهد ليس له عهد % % 3(@)(@@) % كذا نصه في الوحي عبد مقرب % محمد المختار والعلم الفرد % % 4(@)(@@) % وجاء به نص الكتاب مؤيدا % كلام رسول صادق وعده الوعد % 5(@)(@@) % فلله ما يخفى ولله ما يبدو % % ولله فيه الأمر قبل ومن بعد % 6(@)(@@) % ولم يدر هذا الأمر إلا أولوا النهى % % من السادة الغر الذين هم قصد % 7(@)(@@) % قويم إذا حادت مقاصد مثله % عن المرتبة العليا فخانهم الحد % 8(@)(@@) % أقاموا براهين العدالة عنده % فقولهم قول وحدهم حد % 9(@)(@@) % وحال لهم في كل غيب ومشهد % مذاق عزيز طعمه العسل الشهد % % 10(@)(@@) % وذلك عن وحي من الله واصل % إلى النحل فانظر فيه يا أيها العبد % % PageV01P233 11(@)(@@) % فإن كان إلهاما من الله إنه % % هو الغاية القصوى إلى نيلها تعدو % % 12(@)(@@) % فما فيه من ترك استناد معنعن % ومن كان هذا علمه جاءه السعد % % 13(@)(@@) % فليس له إلا الغيوب شهادة % ومن كان هذا حاله ما له حد % % 14(@)(@@) % تجنب براهين النهى إنها عمى % % إلى جنب ما قلنا فقربكم البعد % % 15(@)(@@) % لو أن الذي قلناه يقدر قدره % % لنوديت بين الناس يا سعد يا سعد % 16(@)(@@) % كما جاء من أسرى إليه به على % % براق الهدى نحو الذي قلت يشتد % 17(@)(@@) % ومنه أخذنا علمه بشهادة % من الذوق ذقناها وشاهدنا الوجد % 18(@)(@@) % إلى كل خير سابقا ومسارحا % وقد جاء في القرآن أنوارها تبدو % % 19(@)(@@) % أروح عليها بكرة وعشية % بشوق إلى تحصيلها وكذا أغدو % % 20(@)(@@) % ألا إن بذل الوسع في الله واجب % ودار الذي ما من صداقته بد % PageV01P234 21(@)(@@) % وليس سوى النفس التي عابد لها % % وكانت من الأعداء لمن حاله الرشد % 22(@)(@@) % تعبدت يا هذا بكل فضيلة % وأنت لها أهل إذا حصل الجهد % 23(@)(@@) % وساعدك التقوى فنلت بها المنى % % ولكن إذا أعطاك من ذاته الجد % 24(@)(@@) % إذا جاءك الوفد الكريم مغلسا % % وساعده من عند مرسله الرفد % % 25(@)(@@) % فذلك بشرى منه إنك مجتبى % % وإن لك الزلفى كما أخبر الوفد % % 26(@)(@@) % وما الوفد إلا رسله وكتابه % وليس لما جاءت 
ms60	 به رسله ضد % 27(@)(@@) % يقاومه فاعلم بأنك واصل % إليه ولا هجر هناك ولا صد % 28(@)(@@) % فواصل ذوي الأرحام مما منحته % % وإن أنت لم تفعل فذالكم الطرد % 29(@)(@@) % وحاذر من الجود الإلهي إنه % % له المكر في تلك المنائح والرد % 30(@)(@@) % فلو كان عن رب لكان مخلصا % كما يحلم الشطرنج أن يحكم النرد % PageV01P235 31(@)(@@) % ألا إنها الأفلاك في حكمها بها % % قد أودع فيها الله من علمه تعدو % % 32(@)(@@) % على كل مخلوق وإن قضاءه % % عليه به فاحمد فمن شانك الحمد % 33(@)(@@) % فحقق تنقل إن كنت بالحق حقه % % ولا تعتمد إلا على من له المجد % % 34(@)(@@) % وذلك من يدري إذا كنت عالما % وقد أثبت التحقيق من حاله الجحد % 35(@)(@@) % ولا تجحدن إلا كفورا لعلمه % % لذلك لم يخلد وإن ذكر الخلد % % 36(@)(@@) % فما الخلد إلا للذي ظل مشركا % يروح ويغدو دائما فيه ولا يعدو % % PageV01P236 البحر : بسيط تام 1(@)(@@) % إن الفروع لها أصل يولدها % % وهي الأصول لمن أيضا تولده % 2(@)(@@) % الحق أصل وجودي ثم معرفتي % % أصل لعلمي به إن كنت تشهده % 3(@)(@@) % به أتانا رسول الله في خبر % عكس الذي قال من بالفكر يجحده % 4(@)(@@) % الله أنزه أن تدرى حقيقته % % وأن يولده من كان يعبده % 5(@)(@@) % وإنما قلت ذا مما لنا وردت % به النصوص التي للشرع تعضده % 6(@)(@@) % إن تنصروا الله ينصركم ويشهدكم % إصلاح من أنت تبغيه فتفسده % % PageV01P237 البحر : سريع 1(@)(@@) % من اتقى الله فذاك الذي % % أساء ظنا بالذي أوجده % % 2(@)(@@) % فمن يشاهد ما رمزنا له % فليتق الله الذي أشهده % % PageV01P238 البحر : كامل تام 1(@)(@@) % وكفى برب الواردات شهوداقل للذي نظم الوجود عقودا % هلا اتخذت عليك فيه شهودا % % 2(@)(@@) % عدلا من الأكوان من ساداته % المصطفين معالما وحدودا % % 3(@)(@@) % إن الذين يبايعونك إنهم % % ليبايعون الحاضر المفقودا % % 4(@)(@@) % فإذا مضى زمن مضى لمروره % عقد فجدد للإمام عقودا % % 5(@)(@@) % اشهد عليه بها جوارح ذاته % % وكفى برب الواردات شهودا % % 6(@)(@@) % إن الإمام هو الذي شهدت له % صم الجبال بكونه معبودا % % PageV01P239 البحر : - 1(@)(@@) % ما راينا من غاية % إلا كانت لنا ابتدا % % 2 