ms978	 ذات مرة ... يقطع أضغان النواجي ضريرها(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ط - ط(@)(@)(@)(@)(@@) الطرط: الحمق. والطرط: الأحمق. والطرط: خفة شعر الحاجبين حتى لا يستبين؛ رجل أطرط وامرأة طرطاء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ظ - ظ(@)(@)(@)(@)(@@) الظرر: الحجارة الحادة التي تشق على الواطئ عليها.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ع - ع(@)(@)(@)(@)(@@) العرر، وهو داء يصيب الإبل؛ بعير أعر بين العرر.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - غ - غ(@)(@)(@)(@)(@@) الغرر: معروف.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ف - ف(@)(@)(@)(@)(@@) الرفف: الرقة في الثوب وغيره؛ ثوب رف بين الرفف. وليس بثبت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ق - ق(@)(@)(@)(@)(@@) الرقق من قولهم: في عظمه رقق، أي دقة، ورجل به رقق، أي ضعف.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ك - ك(@)(@)(@)(@)(@@) ركك: ماء معروف. وزعم الأصمعي أنه رك وأن زهيرا لم يستقم له الشعر في رك فقال ركك. ورجل ركيك بين الركاكة، إذا كان ضعيفا. والكرك: جيل معروف، وقد تكلمت به العرب. والكرك: الشديد الحمرة؛ خوج كرك، إذا كان كذلك، وربما قالوا: ثوب كرك.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ل - ل(@)(@)(@)(@)(@@) أهملت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - م - م(@)(@)(@)(@)(@@) المرر: جمع مرة، وهي مرر الحبل، أي قواه.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ر - ن - ن(@)(@)(@)(@)(@@) أهملت وكذلك حالها مع الواو والهاء والياء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO حرف الزاي(@)(@)(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ز - س - س(@)(@)(@)(@)(@@) أهملت وكذلك حالها مع الشين والصاد والضاد والطاء والظاء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ز - ع - ع(@)(@)(@)(@)(@@) العزز: الغلظ من الأرض. والعزز أيضا: ضيق أحاليل الناقة والشاة. والعزاز: الصلب من الأرض.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ز - غ - غ(@)(@)(@)(@)(@@) أهملت وكذلك حالها مع الفاء والقاف.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ز - ك - ك(@)(@)(@)(@)(@@) الزكيك والزكك: مشي فيه تقارب خطو. قال الراجز:(@)(@)(@@) فهو يزك دائم التزعم(@)(@)(@@) مثل زكيك الناهض المحمم(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ز - ل - ل(@)(@)(@)(@)(@@) الزلل: مصدر زل يزل زللا وزليلا. والزلل مثل الرسح سواء؛ رجل أزل وامرأة زلاء، وهو خفة لحم العجز. ويقال: رجع فلان على زلزه، إذا رجع على الطريق الذي أخذ فيه.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ز - م - م(@)(@)(@)(@)(@@) أهملت وكذلك حالها مع النون والواو والهاء والياء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO حرف السين(@)(@)(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - ش - ش(@)(@)(@)(@)(@@) أهملت الى الظاء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - ع - ع(@)(@)(@)(@)(@@) العسس: الطلب بالليل.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - غ - غ(@)(@)(@)(@)(@@) أهملت وكذلك الفاء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - ق 
ms979	 - ق(@)(@)(@)(@)(@@) القسس: طلب الشيء؛ بات الأسد يقتس، أي يطلب ما يأكله.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - ك - ك(@)(@)(@)(@)(@@) والسكك: صغر الأذن؛ رجل أسك وامرأة سكاء بينة السكك. وأنشد:(@)(@)(@@) أسك صعل كالظليم الآئب(@)(@)(@@) والكسس: صغر الأسنان ولصوقها باللثة؛ رجل أكس وامرأة كساء، والجمع كس. قال الشاعر:(@)(@)(@@) فداء خالتي لبني حيي ... خصوصا يوم كس القوم روق(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - ل - ل(@)(@)(@)(@)(@@) أمر سلس بين السلس والسلوسة والسلامة.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - م - م(@)(@)(@)(@)(@@) أهملت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - ن - ن(@)(@)(@)(@)(@@) مر على سننه وسننه وسننه، إذا مر على قصده واستوائه.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO س - و - و(@)(@)(@)(@)(@@) أهملت وكذلك الهاء والياء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO حرف الشين(@)(@)(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ص - ص(@)(@)(@)(@)(@@) الشصص والشصاص: اليبس؛ والغلظ في العيش أيضا شصص وشصاص.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ض - ض(@)(@)(@)(@)(@@) أهملت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ط - ط(@)(@)(@)(@)(@@) الشطط: مجاوزة الحد في الجور، وهو الإشطاط أيضا؛ شط في حكمه وأشط، وأبى الأصمعي إلا أشط. والشطاط: تمام الطول وحسنه.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ظ - ظ(@)(@)(@)(@)(@@) الشظاظ: عود كالخلال يجمع به عروتا العكمين، والجمع أشظة. والإشظاظ: مصدر أشظ الفحل إذا أنهظ. وقال زهير:(@)(@)(@@) إذا جنحت نساؤكم إليه ... أشظ كأنه مسد مغار(@)(@)(@@) قال أبو بكر: أغارت بنو الصيداء من بني أسد على إبل زهير فاحتفوها وأخذوا راعيها يسارا فقال زهير:(@)(@)(@@) يا حار لا أرمين منكم بداهية ... لم يلقها سوقة قبلي ولا ملك PageV02P066 أردد يسارا ولا تعنف علي ولا ... تمعك بعرضك إن الغادر المعك(@)(@)(@@) فلم يردوه عليه فقال:(@)(@)(@@) تعلم أن شر الناس حي ... ينادى في شعارهم يسار(@)(@)(@@) ولولا عسبه لرددتموه ... وشر منيحة أير مفعار(@)(@)(@@) إذا جنحت نساؤكم إليه ... أشظ كأنه مسد مغار(@)(@)(@@) يبربر حين تدنو من بعيد ... إليه وهو قبقاب قطار(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ع - ع(@)(@)(@)(@)(@@) العشش من قولهم: شجرة عشة: قليلة الورق قصيرة الأغصان؛ وامرأة عشة: صغيرة الجسم، وكذلك النخلة إذا عطشت فقصر سعفها. ومنه قول الشاعر:(@)(@)(@@) فما شجرات عيصك في قريش ... بعشات الفروع ولا ضواحي(@)(@)(@@) وأعششت بالرجل، إذا أزعجته عن موضعه.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - غ - غ(@)(@)(@)(@)(@@) أهملت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ف - ف(@)(@)(@)(@)(@@) الشفف: الرقة والخفة في الحال، وربما سميت رقة الحال شففا. 
ms980	(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ق - ق(@)(@)(@)(@)(@@) الشقق: جمع شقة وشقة.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ك - ك(@)(@)(@)(@)(@@) الشكك: الطرائق؛ ورجل مختلف الشكك، إذا كان متفاوت الأخلاق، وهي الشكائك أيضا. والشكاك: الفرق من الناس.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ل - ل(@)(@)(@)(@)(@@) الشلل من قولهم: شلت يده شللا. ويقولون للرجل إذا ظفر: لا شللا ولا تشل ولا تشلل يدوك، أي لا شلت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - م - م(@)(@)(@)(@)(@@) الشمم: ارتفاع الأنف وإشراف أرنبته. والمشش: داء يصيب الخيل. قال أبو بكر: وليس في كلام العرب المضاعف كلمة يستبين فيها التضعيف في فعل يفعل إلا: مشش الفرس مششا؛ ولححت عينه، إذا كثر عليها الرمص، حتى تلتصق أجفانه؛ وصمم؛ ويللت سنه يللا، إذا قصرت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - ن - ن(@)(@)(@)(@)(@@) الشنن: الضعف، واشتقاقه من قولهم: تشنن السقاء، إذا يبس وضعف.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ش - و - و(@)(@)(@)(@)(@@) أهملت وكذلك الهاء والياء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO حرف الصاد(@)(@)(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - ض - ض(@)(@)(@)(@)(@@) أهملت وكذلك الطاء والظاء والعين.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - غ - غ(@)(@)(@)(@)(@@) الغصص: الغصة في الحلق.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - ف - ف(@)(@)(@)(@)(@@) أهملت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - ق - ق(@)(@)(@)(@)(@@) القصص من قولهم: قصصت الشيء قصصا، إذا اتبعته؛ والقصص: اتباعك الأثر، من قوله جل وعز: " فارتدا على آثارهما قصصا " . وقص الشاة: صدرها، وقصصها واحد.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - ك - ك(@)(@)(@)(@)(@@) الصكك: اصطكاك العرقوبين.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - ل - ل(@)(@)(@)(@)(@@) اللصص: تراكب الأسنان بعضها على بعض. وللصص موضعان فأحدهما الذي تقدم ذكره والآخر تقارب الكتفين حتى تلصق إحداهما بالأخرى.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - م - م(@)(@)(@)(@)(@@) فرس صمم، إذا صمم في عدوه؛ وقال قوم: بل الصمم الشديد الصلب. والصمم في الأذن: معروف.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - ن - ن(@)(@)(@)(@)(@@) أهملت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ص - و - و(@)(@)(@)(@)(@@) أهملت وكذلك حالها مع الهاء والياء.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO حرف الضاد(@)(@)(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ض - ط - ط(@)(@)(@)(@)(@@) أهملت وكذلك الظاء والعين والغين.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ض - ف - ف(@)(@)(@)(@)(@@) الضفف: شدة العيش؛ وقال قوم من أهل اللغة: بل الضفف أن يقل الطعام ويكثر آكلوه. والفضض: التفرق؛ يقال: تفضض الشيء، إذا تفرق فضضا وفضاضا.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ض - ق - ق(@)(@)(@)(@)(@@) القضض: الحصى الصغار.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ض - ك - ك(@)(@)(@)(@)(@@) الضككك الضيق.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ض - ل - ل(@)(@)(@)(@)(@@) أهملت.(@)(@)(@)(@)(@@)(@@)(@@) || AUTO ض - م 