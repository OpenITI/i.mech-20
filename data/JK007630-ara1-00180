ms161	 % % 47(@)(@@) % و لم يعدل أبا لك يعربيا % زميل مثل خالك في معد % 48(@)(@@) % جزيتك عن وفائك لي ثناء % يود أخي مكانك فيه عندي % % 49(@)(@@) % و لولا الود عز عليك مدحي % % و لولا الفضل عز عليك ودي % % 50(@)(@@) % بني عبد الرحيم بكم تعالت % % يدي وورى على الظلماء زندي % % PageV01P477 51(@)(@@) % و إن أودى بنيسابور قومي % % فجدكم من الأملاك جدي % % 52(@)(@@) % و أصدق ما محضت القوم مدحي % % إذا ما كان مجد القوم مجدي % % 53(@)(@@) % تفاعيني لترديني الليالي % % فأذكركم فتنهسني بدرد % 54(@)(@@) % و أزحم فيكم نكبات دهري % % بعصبة غالب وبني الأشد % 55(@)(@@) % لذلك ما حبوتكم صفايا % % ذخائر خير ما أحبو وأهدي % % 56(@)(@@) % طوالع من حجاب القلب عفوي % % بهن يبذ غاية كل جهد % % 57(@)(@@) % تجوب الأرض تقطع كل يوم % % مدى عامين للساري المجد % 58(@)(@@) % يرين وبعد لم يروين حسنا % % كأن سطورهن وشوع برد % 59(@)(@@) % إذا روت رجالكم كهولا % % سأرن لصبية منكم ومرد % 60(@)(@@) % و لولاكم لما ظفرت بكفء % يسر ولا سعت قدما لرشد % PageV01P478 61(@)(@@) % و لكن زفها الأحرار منكم % % فما اشقيت حرتها بعبد % 62(@)(@@) % فضلتم سؤددا وفضلت قولا % % فكل في مداه بغير ند % 63(@)(@@) % بكم ختم الندى وبي القوافي % % بقيتم وحدكم وبقيت وحدي % % PageV01P479 البحر : - 1(@)(@@) % تظن ليالينا عودا % % على العهد من برقتي ثهمدا % % 2(@)(@@) % و هل خبر الطيف من بعدهم % % إذا طاب يصدقك الموعدا % % 3(@)(@@) % و يا صاحبي أين وجه الصباح % % و أين غد صف لعيني غدا % % 4(@)(@@) % أسدوا مسارح ليل العرا % % ق أم صبغوا فجره أسودا % % 5(@)(@@) % و خلف الضلوع وفير أبي % % و قد برد الليل أن يبردا % % 6(@)(@@) % خليلي لي حاجة ما أخف % برامة لو حملت مسعدا % % 7(@)(@@) % أريد لتكتم وابن الأرا % % ك يفضحها كلما غردا % % 8(@)(@@) % و بالرمل سارقة المقلتي % % ن تكحل أجفانها المرودا % % 9(@)(@@) % إذا هصرت هصرت بانة % و إن سئلت سئلت جلمدا % % 10(@)(@@) % أحب وإن أخصب الحاضرون % % ببادية الرمل أن أخلدا % % PageV01P480 11(@)(@@) % و أهوى الظباء لأم البنين % بما تشبه الرشأ الأغيدا % % 12(@)(@@) % و عينا يردن لصاب الغوير % % بأنقع من مائه 
ms162	 للصدى % % 13(@)(@@) % فليت وشيبي بحام العذار % زمان الغضا عاد لي أمردا % % 14(@)(@@) % و يا قلب قبلك ضل القلو % % ب لو كنت أملك أن تنشدا % % 15(@)(@@) % أرى كبدي قسمت شقتين % مع الشوق غور أو أنجدا % % 16(@)(@@) % فبالنعف ضائعة شعبة % و أخرى بميسان ما أبعدا % % 17(@)(@@) % و ما خلت لي واسطا عقلة % تعلم نومي أن يشردا % % 18(@)(@@) % و لا أنني أستشم الجنو % % ب أطيب ريحي أو بردا % % 19(@)(@@) % و أطرح منحدرا ناظري % % لها أبتغي رفدها المصعدا % % 20(@)(@@) % و أحمد من نشرها أنه % % إذا هب مثل لي أحمدا % % PageV01P481 21(@)(@@) % و لا كنت قبلك في حاجة % لتحمل عنقي لريح يدا % % 22(@)(@@) % أسالك دجلة تجري به % % محايدة موجها المزبدا % % 23(@)(@@) % صهابية اللون قارية % تخالف صبغتها المولدا % % 24(@)(@@) % تحن وما سمعت في الظلا % % م غير غناء النواتي حدا % % 25(@)(@@) % لها رسن في يمين الشمال % % إذا ضل قائف أرض هدى % % 26(@)(@@) % تحمل سلمت على المهلكات % و ساق لك الله أن ترشدا % % 27(@)(@@) % رسائل عني تقيم الجموح % و تستعطف العنق الأصيدا % % 28(@)(@@) % أجيراننا أمس جار الفرا % % ق بيني وبينكم واعتدى % % 29(@)(@@) % جفا المضجع السبط جنبي لكم % % محافظة ونفى المرقدا % % 30(@)(@@) % و أوحشتم ربع أنسي فعاد % % يهدم بانيه ما شيدا % % PageV01P482 31(@)(@@) % و فاجأني بينكم بغتة % و لم أك للبين مستعددا % % 32(@)(@@) % ففي جسدي ليس في جبتي % % نوافذ ما سل أو سددا % % 33(@)(@@) % تمتنك عيني وقلبي يراك % % بشوقي حاشاك أن تفقدا % % 34(@)(@@) % كأني سرعة ما فتني % % عدمتك من قبل أن توجدا % % 35(@)(@@) % لئن نازعتني يد الملك فيك % % فلم أستطع بدفاع يدا % % 36(@)(@@) % فحظ عساه وإن ساءني % % يكون بما سرني أعودا % % 37(@)(@@) % دعوك لتعدل ميل الزمان % و يصلح رأيك ما أفسدا % % 38(@)(@@) % يسومون كفك سبر الجراح % % و قد أخذت في العظام المدى % % 39(@)(@@) % سيبصر مستقربا من دعا % % ك موضع تفريطه مبعدا % % 40(@)(@@) % و يعلم كيف انجفال الخطوب % % إذا سل منك الذي أغمدا % % PageV01P483 41(@)(@@) % و إن كان منكبه منجبا % % درى أي صمصامة قلدا % % 42(@)(@@) % و قبلك لو أثلث الفرقدي % % ن خابط عشوائهم 
ms163	 ما اهتدى % % 43(@)(@@) % و لما رأوك أمام الرعي % % ل ألقوا إلى عنقك المقودا % % 44(@)(@@) % و أدنوا لحمل المهمات من % % ك بزلاء عجلزة جلعدا % % 45(@)(@@) % إذا ثقل الحمل قامت به % % و إن ظلعت نهضت أجلدا % % 46(@)(@@) % تكون لراكبها ما استقا % % م دون خطار الفيافي فدى % % 47(@)(@@) % و تضحى على الخمس لا تستري % % ب عجرفة أن ترى الموردا % % 48(@)(@@) % تطيع اللسان فإن عوسرت % أثاروا بها الأسد الملبدا % % 49(@)(@@) % إذا ما الفتى لم تجد نفسه % % بهمتها في العلا مصعدا % % 50(@)(@@) % سوى غلط الحظ أو أن يع % % ذ في قومه نسبا قعددا % % PageV01P484 51(@)(@@) % فلله أنت ابن نفس سمت % لغايتها قبل أن تولدا % % 52(@)(@@) % إذا خير اختار إحدى اثنتي % % ن إما العلاء وإما الردى % % 53(@)(@@) % كأني أراك وقد زاحموا % % بك الشمس إذ عزلوا الفرقدا % % 54(@)(@@) % و خاطوا النجوم قميصا عليك % % و لاثوا السحاب مكان الردا % % 55(@)(@@) % و صانوك عن خرق في الحلي % % فحلوا طلي خيلك المسجدا % % 56(@)(@@) % و إن أخلق الدهر ألقابهم % % بما كثر منها وما رددا % % 57(@)(@@) % رضوا باختياري أن أصطفي % % لك اللقب الصادق المفردا % % 58(@)(@@) % فكنيت نفسك أم العلاء % % و سميت كفك قطر الندى % % 59(@)(@@) % و هل سمعوا في اختلاف اللغات % % بلجة بحر تسمى يدا % % 60(@)(@@) % منى فيك بلت يدي منذ شم % % ت عارضها المبرق المرعدا % % PageV01P485 61(@)(@@) % فتم فراغ عهودي فقد % % أمنتك من قبل أن تعهدا % % 62(@)(@@) % فلا ترمين بحقي ورا % % ء ظهر النسيئة ملقى سدى % % 63(@)(@@) % و لا يشغلنك عز الولا % % ة عن حرماتي وبعد المدى % % 64(@)(@@) % فليس الوفي المراعى القريب % و لكنه من رعى الأبعدا % % 65(@)(@@) % تحليت طعمة عيشي المري % % ر يوم لقيتك مسترغدا % % 66(@)(@@) % و أيقنت أن زماني يص % % ير عبدي مذ صرت لي سيدا % % 67(@)(@@) % و أصبح من كان يقوى علي % و غايته في أن يحسدا % % 68(@)(@@) % و قد كنت أصعب من أن أصا % % د رأسا وأعوز أن أوجدا % % 69(@)(@@) % إذا استام ودي أو مدحتي % % فتى رام أخنس مستطردا % % 70(@)(@@) % يفالت قطعا حبال القنيص % % يرى كل موطنه مشردا % % PageV01P486 71 
ms164	(@)(@@) % فآنستني بمديح الرجال % % و ذللتني لقبول الجدا % % 72(@)(@@) % و لو راض خلقك لؤم الزمان % % لعلمه المجد والسؤددا % % 73(@)(@@) % فما أمكن القول فاسمع أزرك % % قوافي بادئة عودا % % 74(@)(@@) % قواضي حق الندى والودا % % دمثني تؤمك أو موحدا % % 75(@)(@@) % إذا أكل الدهر أعواضها % % من المال عمرها سرمدا % % 76(@)(@@) % لو اسطاع سامع أبياتها % % إذا قام راو بها منشدا % % 77(@)(@@) % لصير أبياتها سبحة % و مثل قرطاسها مسجدا % % 78(@)(@@) % مهنئة أبدا من علاك % % بما استأنف الحظ أو جددا % % 79(@)(@@) % و بالصوم والعيد حتى تكو % % ن آخر من صام أو عيدا % % 80(@)(@@) % و حتى ترى واحدا باقيا % % كما كنت في دهرنا أوحدا % % PageV01P487 البحر : - 1(@)(@@) % أخلق الدهر لمتي وأجدا % % شعرات أرينني الأمر جدا % % 2(@)(@@) % لم يزل بي واشي الليالي إلى سم % % ع معير الشباب حتى استردا % % 3(@)(@@) % صبغة كانت الحياة فما أف % % رق أودي دهري بها أو أردى % % 4(@)(@@) % يا بياض المشيب بعني بأيا % % مك ليلا نضوته مسودا % % 5(@)(@@) % يا لها سرحة تصاوح تنو % % ما وعهدي بها تفاوح رندا % % 6(@)(@@) % لم أقل قبلها لسوداء عطفا % و اقترابا ولا لبيضاء بعدا % % 7(@)(@@) % عدت الأربعون سن تمامي % % و هي حلت عراي عقدا فعقدا % % 8(@)(@@) % بان نقصي بأن كملت وأحسس % % ت بضعفي لما بلغت الأشدا % % 9(@)(@@) % رجعت عني العيون كما تر % % جع عن حاجب الغزالة رمدا % % 10(@)(@@) % ليت بيتا بالخيف أمس استضفنا % % ه قرانا ولو غراما ووجدا % % PageV01P488 11(@)(@@) % و سقاة على القليب احتسابا % % عوضونا اللمى شفاء وبردا % % 12(@)(@@) % راح صحبي بفوزة الحج يحدو % % ن وعنسي باسم البخيلة تحدى % % 13(@)(@@) % و لحاظي مقيدات بسلع % فكأني أضللت فيه المجدا % % 14(@)(@@) % رب ليل بين المحصب و الخي % % ف لبسناه للخلاعة بردا % % 15(@)(@@) % و خيام بسفح أحد على الأق % % مار تبنى فحي يا رب أحدا % % 16(@)(@@) % لا عدا الروح في تهامة أنفا % % سا إذا استروحت تمنيت نجدا % % 17(@)(@@) % و أعان الرقاد حيرة طرف % لم يجد في الطلاب يقظان رشدا % % 18(@)(@@) % نمت أرجو هندا فكل مثال % خيلت لي الأحلام إلا هندا % % 19(@)(@@) % عجبا لي ولابتغائي مودا 
ms165	 % % ت ليال طباعها لي أعدا % % 20(@)(@@) % نطقت في نفوسها وتعفف % % ت فما ود من يرى بك صدا % % PageV01P489 21(@)(@@) % أجلبت عريكة دهري % % فرمى بي وقام أملس جلدا % % 22(@)(@@) % كل يوم أقول ذما لعيشي % % فإذا فاتني غدا قلت حمدا % % 23(@)(@@) % زفرات على الزمان إذا استب % % ردت منها تنفسا زدن وقدا % % 24(@)(@@) % يا لحظي الأعمى أما يتلقى % % قائدا يبتغي الثواب فيهدي . % 25(@)(@@) % يا زمان النفاق ما لك زاد الله % بيني وبين أهلك بعدا % % 26(@)(@@) % من عذيري من صحبة الناس ما أخ % % فرها ذمة وأخبث عهدا % % 27(@)(@@) % كم أخ حائم معي واصل لي % % فإذا خلفت به الحال صدا % % 28(@)(@@) % و صديق سبط وايامه وس % % طى فلما انتهت تقلص جعدا % % 29(@)(@@) % ليته غير منصف لي إسعا % % دا على الدهر منصف لي ودا % % 30(@)(@@) % و إذا لم تجد من الصبر بدا % % فتعزل وجد من الناس بدا % % PageV01P490 31(@)(@@) % يدفع الله لي ويحمي عن الصا % % حب فردا كما وفى لي فردا % % 32(@)(@@) % أجنت أوجه الرجال فما أن % % كرت من بشر وجهه العذب وردا % % 33(@)(@@) % كيفما خالفت عطاش أماني % % نا إليه كان النمير العدا % % 34(@)(@@) % ملك الجود أمره فحديث ال % % مال عن راحتيه أعطى وأجدى % % 35(@)(@@) % زذ لجاجا إذا سألت وإلحا % % حا عليه يزدك صبرا ورفدا % % 36(@)(@@) % لا ترى والمياه تعطي وتكدي % % حافرا قط في ثراه أكدي % % 37(@)(@@) % كلما عرضت له رغبة الدن % % يا تواني عنها عفافا وزهدا % % 38(@)(@@) % كثر الناس مالها واقتناها % % سيرا تشرف الحديث وحمدا % % 39(@)(@@) % لحقته بغاية المجد نفس % لم تحدد فضلا فتبلغ حدا % % 40(@)(@@) % عدت الفقر في المكارم ملكا % % و فناء الأيام في العز خلدا % % PageV01P491 41(@)(@@) % و أب حط في السماء ولو شا % % ء تخطى مكانها وتعدى % % 42(@)(@@) % من بهاليل أنبتوا ريشة الأر % % ض وربوا عظامها والجلدا % % 43(@)(@@) % أرضعتها أيديهم درة الخص % % ب فروت تلاعها والوهدا % % 44(@)(@@) % بين جم منهمو سابور أقيا % % ل يعدون مولد الدهر عدا % % 45(@)(@@) % لهم حاضر الممالك إن فا % % خر قوم منها بقفر ومبدى % % 46(@)(@@) % أخذوا عذرة الزمان وسدوا % % فرج الغيل 
ms166	 يقنصون الأسدا % % 47(@)(@@) % سير العدل في مآثرهم تر % % وى وحسن التدبير عنهم يؤدي % % 48(@)(@@) % و إذا اغبرت السنون وأبدى % % شعث الأرض وجهها المربدا % % 49(@)(@@) % طردوا الأزل بالثراء وقاموا % % أثر المحل يخلفون الأندا % % 50(@)(@@) % توجوا مضغة وساد كهول ال % % ناس أبناؤهم شبابا ومردا % % PageV01P492 51(@)(@@) % عدد الدهر سيدا من % % هم وعد الحسين جدا فجدا % % 52(@)(@@) % حبس الناس أن يجاورك في السؤ % % دد تعريجهم وسيرك قصدا % % 53(@)(@@) % و وقى الملك زلة الرأي أن صر % % ت بتدبير أمره مستبدا % % 54(@)(@@) % لك يوم عنه مراس مع الحر % % ب يرد السوابق الشعر جردا % % 55(@)(@@) % تركب الدهر فيه ظهرا إلى النص % % ر وتستصحب الليالي جندا % % 56(@)(@@) % و جدال يوما ترى منك فيه % % فقر الوافدين خصما ألدا % % 57(@)(@@) % كل عوصاء يسبق الكلم الهد % ار في شوطها الجواد النهدا % % 58(@)(@@) % أنا ذاك الحر الذي صيرته % % لك أخلاقك السواحر عبدا % % 59(@)(@@) % معلق من هواك كفى بحبل % لم يزده البعاد إلا عقدا % % 60(@)(@@) % ملك الشوق أمر قلبي عليه % % مذ غدا البين بيننا ممتدا % % PageV01P493 61(@)(@@) % أشتكي البعد وهو ظلم ولولا % % لذة القرب ما ألمت البعدا % % 62(@)(@@) % ليت من يحمل الضعيف على الأخ % % طار ألقى رحلي اليك وأدى % % 63(@)(@@) % فتروت عيني ولو ساعة من % % ك فإني من بعدها لا أصدى % % 64(@)(@@) % و على النأي فالقوافي تحيا % % تك مني تسري مراجا ومغدي % % 65(@)(@@) % كل عذراء تفضح الشمس في الصب % % ح وتوري في فحمة الليل زندا % % 66(@)(@@) % لم تدنس باللمس جسما ولم تص % % بغ لها غضة اللواحظ خدا % % 67(@)(@@) % أرجأت الأعطاف مهدى جناها % % لك يهدى إلى الربيع الوردا % % 68(@)(@@) % فتلق السلام والشوق منها % % ذاك يشكي وذا يطيب فيهدى % % 69(@)(@@) % و احب جيد النيروز منها بطوقي % % ن وفصل لليلة العيد عقدا % % 70(@)(@@) % و تسلم من الحوادث ما ك % % ر على عقبه الزمان وردا % % PageV01P494 71(@)(@@) % ما أبالي إذا وجدتك من تف % % قد عيني لا أبصرت لك فقدا % % PageV01P495 البحر : - 1(@)(@@) % إذا فطمت قرارة كل وادي % % فدرت باللوى حلم الغوادي % % 2(@)(@@) % و مرت تهتدي بالريح فيه % % مطايا الغيث مثقلة 
ms167	 الهوادي % % 3(@)(@@) % ففتحت الربا خدا وسدت % % بشكر المزن أفواه الوهاد % 4(@)(@@) % اناديه وتنشده المغاني % % و لكن لا حياة لمن تنادى % % 5(@)(@@) % و ما أربي إلى سقيا ربوع % لها من مقلتي سار وغادي % % 6(@)(@@) % حملت يد السحاب الجون فيها % % و لست معودا حمل الأيادي % % 7(@)(@@) % و لو بكت السماء لها وجفني % % تيقنت البخيل من الجواد % 8(@)(@@) % ضممت بمسقط العلمين صحبي % % و قد صاح الكلال به بداد % 9(@)(@@) % على أرج الثرى لما ضللنا % % تضوع منه في الأنفاس هادي % % 10(@)(@@) % و قد سقط السرى والنجم هاو % عيون الركب في حط الرقاد % PageV01P496 11(@)(@@) % ندامى صبوة دارت عليهم % % بأيدي العيس أكواب السهاد % 12(@)(@@) % إذا شربوا السرى اقترحوا عليه % % صفير حمامة وغناء حادي % % 13(@)(@@) % و لما عز ماء الركب فيهم % % وقفت أحل من عيني مزادي % % 14(@)(@@) % تحوم وقد تقلصت الأداوي % % على أجفاني الأبل الصوادي % % 15(@)(@@) % أجدك هل ترى بذيول سلمى % % نضارة حاضر وخيام بادي % % 16(@)(@@) % خرقن لكل عين في سواد ال % % خدور خصاصة مثل السواد % 17(@)(@@) % و ما أتبعت ظعن الحي طرفي % % لأغنم نظرة فتكون زادي % % 18(@)(@@) % و لكني بعثت بلحظ عيني % % وراء الركب يسأل عن فؤادي % % 19(@)(@@) % و في نوام هذا الليل شمس % و في سهري لها وجفا وسادي % % 20(@)(@@) % إذا ذكرت نزت كبدي إليها % % هبوب الداء نبه بالعداد % PageV01P497 21(@)(@@) % عجبت يضميني زمني وأرضى % % و يحصدني ولم أبلغ حصادي % % 22(@)(@@) % و تنفق مسرفات من شبابي % % لياليه الصعاب بلا اقتصاد % 23(@)(@@) % و عهدي بالتشابه والتنافي % % يجران التصادق والتعادي % % 24(@)(@@) % فما بال الليالي وهي سود % يزال بها البياض من السواد % 25(@)(@@) % توق الناس إن الداء يعدى % % و إن قربوا فحظك في البعاد % 26(@)(@@) % و لا يغررك ذو ملق يغطى % % أذاه وجمره تحت الرماد % 27(@)(@@) % كلا أخويك ذو رحم ولكن % % أخوك أخوك في النوب الشداد % 28(@)(@@) % عذيري من صديق الوجه يحنى % % أضالعه على قلب مضادي % % 29(@)(@@) % لوي يده على حبل لعنقي % % و قال اضمم يديك على ودادي % % 30(@)(@@) % تمنى وهو ينقصني تمامي % % و أين الزبرقان من الدآدي % % PageV01P498 31 
ms168	(@)(@@) % و مجتمعين يرتفدون عيبي % % فلا يزن اجتماعتهم انفرادي % % 32(@)(@@) % إذا انتسبوا لفضل لم يزيدوا % % على نسب ابن حرب من زياد % 33(@)(@@) % ألام على عزوف النفس ظلما % % و ما لومي على خلقي وعادي % % 34(@)(@@) % و يخدعني البخيل يريد ذمي % % و هل عند الهشيمة من مراد % 35(@)(@@) % كفاني آل إسماعيل إني % % بلغت بهم من الدنيا مرادي % % 36(@)(@@) % و أن محمدا داري نفاري % % فلان له وأسلس من قيادي % % 37(@)(@@) % رقى خلقي بأخلاق كرام % ألانت من عرائكه الشداد % 38(@)(@@) % و كنت أذم شر الناس قدما % % و عيبهم فصح على انتقادي % % 39(@)(@@) % و كم خابطت عشواء الأماني % % و كاذبني على الظن ارتيادي % % 40(@)(@@) % فلما أن سللت على الدياجي % % ربيب النعمة استذكى زنادي % % PageV01P499 41(@)(@@) % و أنبض من يديه لي غديرا % % و قد أعيا فمي مص الثماد % 42(@)(@@) % جلا لي غرة رويت جمالا % % أسر بها ووجه البدر صادي % % 43(@)(@@) % تفاديها السماء بنيريها % % فتعرف حظها فيما تفادى % % 44(@)(@@) % من الوافين أحلاما وصبرا % % إذا الجلي هفت بحلوم عاد % 45(@)(@@) % بني البيض الخفاف توارثوها % % مع الأحساب والخيل الوراد % 46(@)(@@) % تضاحك في أكفهم العطايا % % و تكلح عنهم يوم الجلاد % 47(@)(@@) % مطاعيم إذا النكباء قرت % % وجب القحط أسمة البلاد % 48(@)(@@) % لهم أيد إذا سئلوا سباط % موصلة بأسياف جعاد % 49(@)(@@) % إذا كلت من الضرب المواضي % % أعانوها بأفئدة حداد % 50(@)(@@) % طووا سلف الفخار فلم توصم % طوارفهم بمعروف التلاد % PageV01P500 51(@)(@@) % إذا الأحساب طأطأت استشاطوا % % على متمرد الشرفات عادي % % 52(@)(@@) % يعد المجد واحدهم بألف % من النجباء في قيم البلاد % 53(@)(@@) % إذا ولدوا فتى سعت المعالي % % تباشر بينها بالإزدياد % 54(@)(@@) % نموك أغر من ملك أغر % جوادا بالكرائم من جواد % 55(@)(@@) % أخا طعمين حلوك للموالي % % بلا من ومرك للمعادي % % 56(@)(@@) % إذا لم يختضب لك غرب سيف % دما خضبت سيفا بالمداد % 57(@)(@@) % فأنت إذا ركبت شهاب حرب % و أنت إذا جلست شهاب نادي % % 58(@)(@@) % إذا رجع الحسيب إلى فخار % قديم أو حديث مستفاد % 59(@)(@@) % فحسبك بالموفق من فخار % و بيت الباهلية من عتاد % 60(@)(@@) % و من يسند إلى طرفيك 
ms169	 مجدا % % يبت من جانبيه في مهاد % PageV01P501 61(@)(@@) % فداؤك دائر الأبيات يأوى % % إلى وقصاء لاطئة العماد % 62(@)(@@) % يتوب إذا هفا غلطا بجود % و لم يتب اتقاء للمعاد % 63(@)(@@) % إذا جاراك في مضمار فضل % عدته عن اللحاق بك العوادي % % 64(@)(@@) % إليك سرت مطامعنا فعادت % % مواقر من ندى لك مستعاد % 65(@)(@@) % يخدن فصائلا فيدعن وسما % لأرجلهن في الصم الصلاد % 66(@)(@@) % يقادحن الحصى شررا كأنا % % حذوناها مناسم من زناد % 67(@)(@@) % حملن إليك من تحف القوافي % % غرائب من مثان أو وحاد % 68(@)(@@) % هدايا تفخر الأسماع فيها % % على الأبصار أيام التهادي % % 69(@)(@@) % مخلصة من الكلم المعنى % % بطول الكر والمعنى المعاد % 70(@)(@@) % نوافث في عقود السحر تنمى % % فصاحتها إلى رمل العقاد % PageV01P502 71(@)(@@) % تمنى وهي تنظم فيك أن لو % % تكون ترائبا مهج الأعادي % % 72(@)(@@) % تخال العرب عجرا عن مداها % % نبيط العرب لم تنطق بضاد % 73(@)(@@) % لأيام البشائر والتهاني % % بها نشر الروائح والغوادي % % 74(@)(@@) % يجرر ذيلها يوم شريف % فيجعلها على عيد معاد % 75(@)(@@) % شواهد أن جدك في ارتقاء ال % % سعود وأن عمرك في امتداد % 76(@)(@@) % كفاها منك عفوك في العطاء ال % % جزيل وقد وفت لك باجتهادي % % 77(@)(@@) % فكيف خلطتني بسواي فيما % % أنلت وأنت تشهد باتحادي % % 78(@)(@@) % تمادى بي جفاؤك ثم جاءت % % مواصلة أعق من التمادي % % 79(@)(@@) % ألم تك لي من الذهب المصفى % % يد بيضاء تشرق في الأيادي % % 80(@)(@@) % منوهة إذا انتشرت بذكرى % % و لائقة بمجدك واعتقادي % % PageV01P503 81(@)(@@) % رضائي أن تهزك ريح شوق % إلى قربي ويوحشك افتقادي % % 82(@)(@@) % إذا ما لم يكن نيلا شريفا % % فحسبي من صلاتك بالوداد % PageV01P504 البحر : - 1(@)(@@) % نبهته فقام مشبوح العضد % أغلب لوسيم الهوان ما رقد % 2(@)(@@) % في يده مذروبة مزيدة % و درعه سابغة من اللبد % 3(@)(@@) % إذا غدا لم يحتشم هاجرة % و إن سرى لم يخ من ليل برد % 4(@)(@@) % إن هم لم يحبس على مشورة % و إن غدا لسفر لم يستعد % 5(@)(@@) % لكل باغي قنص طريدة % تنفر منه وله كل الطرد % 6(@)(@@) % هب بلبيك وقد دعوته % % مكتفيا بقوله إلى الأبد % 7(@)(@@) % و خير من ساند 
ms170	 ظهري أسد % أو رجل في صدره قلب أسد % 8(@)(@@) % و قال في لهاة أي خطر % تقذف بي وعرض ما أي بلد % 9(@)(@@) % و ما الذي رابك قلت حاجة % في أفق المجد فقام فصعد % 10(@)(@@) % يسبقني سعيا لما أريده % % حتى لقد أدرك بي ما لم أرد % PageV01P505 11(@)(@@) % فردين إلا صارمين اعتنقا % % و ضامرين وردا أين قدد % 12(@)(@@) % تضمر أحشاء الدياجي والفلا % % منى ومنه جسدين بجسد % 13(@)(@@) % كأن إثرينا إذا ما أصبحا % % على الثرى مسحب رمح أو مسد % 14(@)(@@) % حتى بلغت مسرح العز به % % بأول الشوط وأقرب الأمد % 15(@)(@@) % و رب عزم قبلها ركبته % ففت أن أظلم أو أن أضطهد % % 16(@)(@@) % و غارة من الكلام شنها % % على اللئام كل معنى مطرد % 17(@)(@@) % شهدتها مغامرا وكنت بال % % حض عليها غائبا كمن شهد % 18(@)(@@) % و لذة صرفت وجهي كرما % % عنها وفيها رغبة لمن زهد % 19(@)(@@) % لم يعتلقني بأثام حبلها % % و لم ينلني عارها ولم يكد % 20(@)(@@) % و حلة طرقت من أبياتها % % أمنعها بابا وأعلاها عمد % PageV01P506 21(@)(@@) % و الحي إما خالف أو حاضر % خيط الكرى بجفنه قد انعقد % 22(@)(@@) % و ليس إلا بالنباح حرس % لهم وإلا مقلة النار رصد % 23(@)(@@) % فبت أستقري الحديث وحده % % و غيره لولا العفاف لي معد % 24(@)(@@) % و دون إرهابي حد صارم % عانقته ومقول منه أحد % 25(@)(@@) % و كم بذات الرمل من نافرة % بغير أشراك الشباب لم تصد % 26(@)(@@) % أحسن من بذل هواها منعها % % و من وصال الغانيات ما تصد % 27(@)(@@) % نومي محفوظ إذا ما زرتها % % و موضعي إن غبت عنه مفتقد % 28(@)(@@) % يعجب قلبي مطلها لطول ما % % يكر بي المطل إليها ويرد % 29(@)(@@) % لله أحباب وفيت لهم % بما استحقوا من أسى ومن كمد % 30(@)(@@) % لم يكفهم شقوة عيني بعدهم % % حتى استعانوا بالدموع والسهد % PageV01P507 31(@)(@@) % مضوا بجمات الحياة معهم % % و عولوا بشفتى على الثمد % 32(@)(@@) % صحبت قوما بعدهم حبالهم % % سحيلة الفتل رخيات العقد % 33(@)(@@) % و ما على من كده حر الظما % % إذا رأى الماء الأجاج فورد % 34(@)(@@) % يضرب قوم في وجوه 
ms171	 إبلي % % و قد كفاهم أنها عنهم حيد % 35(@)(@@) % لا تعجل الكوم إلى ذيادها % % فهي قماح عنكم لو لم تذد % 36(@)(@@) % ما للبخيل يتحامى جانبي % % متى رآني عاكفا على النقد % 37(@)(@@) % يستر عني القعب داف حنظلا % % فيه وقد أمر في في الشهد % 38(@)(@@) % ما أبصر الدهر بما أريده % % لو كان في الحكم علي يفتصد % 39(@)(@@) % أنولني منزلة بين الغني % % و الفقر لم يبخل بها ولم يجد % 40(@)(@@) % و شر أقسامك حظ وسط % أرعن لم تخمل به ولم تسد % PageV01P508 41(@)(@@) % أغرى الليالي بي أني عارف % بالسهل من أخلاقهن والنكد % 42(@)(@@) % و أنني أقدح في صروفها % % بعزمة تضيء لي على البعد % 43(@)(@@) % تطلعني على اليقين ظنتي % % كأن يومي مخبري بسر غد % 44(@)(@@) % يا بائعي مرتخصا بثمني % % سوف يذم مستعيض ما حمد % 45(@)(@@) % مثلي نضارا ضنت الكف به % % لو كان في الناس بصير ينتقد % 46(@)(@@) % قد فطنت لحظها مطالبي % % و أبصرت عيني الضلال والرشد % 47(@)(@@) % و قد علمت أي برق أمتري % % مزنته وأي بحر أستمد % 48(@)(@@) % و وسعت أيدي بني أيوب لي % % و بشرهم ملء المنى ما لا وود % 49(@)(@@) % فما أبالي وهم الباقون لي % % من ذا فنى في الناس أو من ذا نفد % 50(@)(@@) % و لا أروم الرزق من غيرهم % و إنما أطلب من حيث أجد % PageV01P509 51(@)(@@) % المانعون بالجوار والحمى % % و الناهضون بالعديد والعدد % 52(@)(@@) % و الغامرون المحل من جودهم % بكل كف ذاب في عام جمد % 53(@)(@@) % و الضاربون في اليفاع والذرى % % إذا بيوت الذل عاذت بالوهد % 54(@)(@@) % تضيء تحت الليل أحسابهم % لضيفهم إن حاجب النار خمد % 55(@)(@@) % مدوا إلى الحاجات من ألسنهم % % ذوابلا منذ استقامت لم تمد % 56(@)(@@) % لا تتقيها هامة بمغفر % و لا يداريها عن الجسم الزرد % 57(@)(@@) % تبهر في الأسماع كل جائف % إذا استقامت لحمة الجرح فسد % 58(@)(@@) % تعرفوا بالمجد حتى سافرت % % أخبارهم بطيبه وهم قعد % 59(@)(@@) % و اختلفوا لا أخطأت بسهمها % % أمنية صوب نداهم تعتمد % 60(@)(@@) % و أفسدوا الدنيا على أبنائها % % فما ترى مثلهم فيمن تلد % PageV01P510 61(@)(@@) % هم ما 
ms172	 هم أصلا ومن فروعهم % % أبلج أربي طارفا على التلد % 62(@)(@@) % و في بمجد قومه محمد % فبرهم وربما عق الولد % 63(@)(@@) % و بان من بينهم بهمة % خلة كل سؤدد منها تسد % 64(@)(@@) % تم وبدر التم بعد ناقص % و زاد والبحر المحيط لم يزد % 65(@)(@@) % و دبر الدنيا برأي واحد % يأنف أن يشركه فيها أحد % 66(@)(@@) % تراه وهو في الجميع واحدا % % و البدر في حفل النجوم منفرد % 67(@)(@@) % إذا استشار لم يزد بصيرة % و لا يلوم رأيه إذا استبد % 68(@)(@@) % حتى لقد أصبح باتحاده % % يتيمة الدهر وبيضة البلد % 69(@)(@@) % قام فنال المكرمات متعبا % % و فاز بالراحة مخفوض قعد % 70(@)(@@) % و خام عن حمل الحقوق معشر % فلم يرعه حملها ولم يؤد % % PageV01P511 71(@)(@@) % و لو درى النائم أي قدم % يحرزها الساهر لاشتاق السهد % 72(@)(@@) % و ربما برح بالعين الكرى % % و كانت الراحة داء للجسد % 73(@)(@@) % تسلمت من القذى أخلاقه % و الماء يقذى بالسقاء والزبد % 74(@)(@@) % و انتظم القلوب سلك وده % % فما يرى من لا يحب ويود % 75(@)(@@) % لا رفق الغيظ بقلب محفظ % عليك إن لم يقل الشعر اعتقد % 76(@)(@@) % جاراك يرجو أن يكون لاحقا % % سوم السحوق فات أن يجنى بيد % 77(@)(@@) % ينقاد للذلة طوع نسب % حيران في الأحساب أعمى لم يقد % 78(@)(@@) % يدين بالبخل إذا سيل فإن % % أخطأ يوما بنوال لم يعد % 79(@)(@@) % مد بحبل شره فانفصمت % % أسبابه وأنت بالخير تمد % 80(@)(@@) % فكلما جاز مدى جاوزته % % مقاربا للمجد من حيث بعد % PageV01P512 81(@)(@@) % بك اعتلقت ويدي وحشية % و ضم أنسي شمله وهو بدد % 82(@)(@@) % و ارتاض مني لك خلق قامص % لم يدر قبل ما العطاء والصفد % 83(@)(@@) % ملكت قلبي شعفا فما وفى % % بقدر وجدي بك صبري والجلد % 84(@)(@@) % حتى حواني أولا فأولا % % و واحد أول ألف في العدد % 85(@)(@@) % كم أيكة أنبتها جودك لي % % ترب ثراها طيب والماء عد % 86(@)(@@) % و كلما صوح منها غصن % عاد بها جودك غضات جدد % 87(@)(@@) % قد ملأت أوعيتي ثمارها % % فقدك إن رد عباب السيل قد % 88(@)(@@) % لم تبق في 
ms173	 خلة تسدها % % و إنما الخلة بالمال تسد % 89(@)(@@) % لي فيك من كل فقيد خلف % فابق فما يضرني من أفتقد % 90(@)(@@) % إذا السنان سلمت طريرة % علياه فلتمض الأنابيب قصد % PageV01P513 91(@)(@@) % و اضرب بسهم في العلاء فائز % من يد عمر فائز لا يقتصد % 92(@)(@@) % تنفض عنك الحادثات شعبا % % حيث التهاني حافلات تحتشد % 93(@)(@@) % كل صباح شمس إقبالك في % % فتوقه مفتنة شمس الأبد % 94(@)(@@) % جذلان بين مادح وحاسد % فموجبات المدح يوجبن الحسد % PageV01P514 البحر : - 1(@)(@@) % خاطر بها إما ردى أو مراد % و ردلها أين وجدت المراد % 2(@)(@@) % و لا تماطلها بجماتها % % معللا أظماءها بالثماد % 3(@)(@@) % باعد عزيزا بين أسفارها % % فعزة النجم السري والبعاد % 4(@)(@@) % لله رام بلباناته % طول الليالي وعروض البلاد % 5(@)(@@) % يقدم إما مبلغا نفسه % % معذرة أو بالغا ما أراد % 6(@)(@@) % يحفزه الضيم فتنبو به % % مضاجع الغيد ولين المهاد % 7(@)(@@) % إذا أحس الهون صاحت به % % نخوته أو طار أو قيل كاد % 8(@)(@@) % يعجم منه الدهر إن رابه % جلد العصا صلب حصاة الفؤاد % 9(@)(@@) % سمت به الهمة حتى نجا % % منفردا من بين هذا السواد % 10(@)(@@) % موليا آخر حاجاته % خزائم العيس ولجم الجياد % PageV01P515 11(@)(@@) % أقسم مهما اكتحلت عينه % بمثله لا اكتحلت بالرقاد % 12(@)(@@) % و بات مغمور العلا شاكرا % % ميسوره يقنع بالإقتصاد % 13(@)(@@) % يرضى من الحظ بما جاءه % % عفوا وما الحظ سوى الاجتهاد % 14(@)(@@) % ينام للضيم على ظهره % % مراوح الخد وثير الوساد % 15(@)(@@) % إن راعه من يومه رائع % قال عدوا فرس الذل عاد % 16(@)(@@) % ما أكثر المنحى على مجده % % لبلغة ترجى ورزق يفاد % 17(@)(@@) % و مؤثر المال على عرضه % مجتهدا ينقص من حيث زاد % 18(@)(@@) % عد عن الدنيا وأبنائها % % وبع موداتهم بالبعاد % 19(@)(@@) % ما هذه الدهماء إلا دبى % ينشره في الأرض حب الفساد % 20(@)(@@) % إلا فتى يأنف من عيشة % لغيره فيها عليه اعتداد % PageV01P516 21(@)(@@) % و دولة تخطب راياتها % % باسم سواه في رؤس الصعاد % 22(@)(@@) % مثل أي القاسم غيران يس % % تفيد من عزته ما استفاد % 23(@)(@@) % يجود بالنفس كما جاد أو % % يسود بالواجب من حيث ساد % 24 
ms174	(@)(@@) % هيهات قامت معجزات العلا % % فيه وبانت آية الإنفراد % 25(@)(@@) % لا تلد الأرض له من أخ % أعقمها من بعد طول الولاد % 26(@)(@@) % شاد به الله بني مجده % راسية والله ما شاء شاد % 27(@)(@@) % بان من الناس فما عابه % % شيء سوى تشبيهه بالعباد % 28(@)(@@) % أبلج في كل دجى فحمة % عمياء لا يقدح فيها الزناد % 29(@)(@@) % يصيب بالأول من ظنه % % فليس يستثنى ولا يستعاد % 30(@)(@@) % تهفو قوى الحلم وغضباته % % تأوى إلى مستحصفات شداد % PageV01P517 31(@)(@@) % أرهف من آرائه ذبلا % % ترود للطعن أمام الطراد % 32(@)(@@) % و قاد للأعداء رقاصة % تعزف لولا يده أن تقاد % 33(@)(@@) % معرقات كان أماتها % % ربائطا ما بين أبيات عاد % 34(@)(@@) % يشكمها إن خلعت لجمها % % ما جر من فضل نواصي الأعاد % 35(@)(@@) % خضبها الطعن بماء الطلى % % فشهبها في شعرات الوراد % 36(@)(@@) % يحالف الصبر عليها فتى % ما بدأ الكرة إلا أعاد % 37(@)(@@) % يبذل في حفظ العلا مهجة % تكبر أن تفديها نفس فاد % 38(@)(@@) % يرى طلاب العز أو برده % في حر ما يشرب يوم الجلاد % 39(@)(@@) % شجاعة سببها جوده % إن الفتى يشجع من حيث جاد % 40(@)(@@) % يا راكب الدهماء لم يحفها % % سير ولا حنت لتغريد حاد % PageV01P518 41(@)(@@) % حددها الطالي فما علبها % % على بياض الجسم لبس الحداد % 42(@)(@@) % لا تلتوي من ظما والثرى % % مكد وأكباد المطايا صواد % 43(@)(@@) % يحفزها من مثله سائق % يضل خريت الفلا وهو هاد % 44(@)(@@) % راكبها وهو على ظهرها % % موطأ الجنب قليل السهاد % 45(@)(@@) % يكرع في صاف قليل القذى % % عدب ويرعى أبدا بطن واد % 46(@)(@@) % بلغ بلغت الخير خير امرئ % % شدت عليه حبوات البواد % 47(@)(@@) % قل للوزير اعترقت بعدكم % % عظمى نيوب الأزمات الحداد % 48(@)(@@) % و ارتجع البخل وأبناؤه % % ما أسأرت عندي كف الجواد % 49(@)(@@) % غاض الندى بعدك يا بحره % و بان مذ بنت بفضل السداد % 50(@)(@@) % و اغبر جو كنت خضرته % فشمطت فيه الربا والوهاد % PageV01P519 51(@)(@@) % دين من العدل عفا رسمه % % شرعته للناس بعد ارتداد % 52(@)(@@) % و سنة في المجد قد قوضت % أقمت من أطنابها والعماد % 53(@)(@@) % و مهمل من كلم نادر 
ms175	 % نفقته مدحك بعد الكساد % 54(@)(@@) % عاد يوفى أجره كاملا % % عندك حيا قبل يوم المعاد % 55(@)(@@) % عرفته والناس من حاسد % أو جاهل بالقول والإنتقاد % 56(@)(@@) % أوحشت بالبعد فلا أوحشت % منك مغاني الكرم المستفاد % 57(@)(@@) % و شل سرح الأمر من قبضة ال % % راعي فأمسى هجمة لا تذاد % 58(@)(@@) % معطل المجلس والمنبر ال % % مركوب عاري السرج رخو البداد % 59(@)(@@) % تعلق الممسك أطرافه % % منه برسغي قاطع لا يصاد % 60(@)(@@) % كأنما صاح غراب النوى % % بداد فيه بعد جمع بداد % PageV01P520 61(@)(@@) % قد أسف الرأس على تاجه % % و أنكر العاتق فقد النجاد % 62(@)(@@) % و وجه بغداد على حسنه % % أسفع مكسوف عليه اربداد % 63(@)(@@) % كانت حريما بك ممنوعة ال % % ظهر فعادت وهي دار الجهاد % 64(@)(@@) % في كل بيت من أذى عولة % تبدا ومن خوف أنين يعاد % 65(@)(@@) % و كيف لا ينكر عهد الحمى % % يفوته العام بصوب العهاد . % 66(@)(@@) % يا مبدئ الإحسان فينا أعد % فالبدر إن مر مع الشهر عاد % 67(@)(@@) % قم فأثرها عزمة لم تنم % ضعفا ولم تنقص لغير ازدياد % 68(@)(@@) % عاجل بها جدع انوف طغت % و أرؤس قد أينعت للحصاد % 69(@)(@@) % يحسبها الأعداء قد أخمدت % و إنما جمرك تحت الرماد % 70(@)(@@) % لا تأخذ الدهر بزلاته % وسعه بالعفو وبالإعتماد % PageV01P521 71(@)(@@) % و لا تكشف عن صدور خبت % أضغانها من قاتل أو مضاد % 72(@)(@@) % فكلما تبصره صالحا % % فإنما يصلح بعد الفساد % 73(@)(@@) % أنا الذي رد زماني يدي % % من بعد شدى بكم واعتضاد % 74(@)(@@) % و طمعت في ذئاب العدا % % حتى حلا مضغ لها وازداد % 75(@)(@@) % وفت في حالي وفي عيشتي % % بطلبي ظلكم وافتقاد % 76(@)(@@) % لا نسي الله لكم والعلا % % ما زدتم في عدتي أو عتاد % 77(@)(@@) % و نعمة أتقلتم كاهلي % % بحملها وهي يد من أياد % 78(@)(@@) % كم ناخس ظهري على شكركم % % و حاسد في مدحكم أو معاد % 79(@)(@@) % و منكر حفظي لكم يرتمي % % مقاتلي من خطإ واعتماد % 80(@)(@@) % و ليس للخابط إلا العشا % % منى وللخارط إلا القتاد % PageV01P522 81(@)(@@) % و ناشطات أبدا نحوكم % % من عقل الفكر ليان المقاد % 82(@)(@@) % سوافر عن غرر 
ms176	 وضح % % ينصع منهن سواد المداد % 83(@)(@@) % يخلطن فرض الحق في مدحكم % % بخالص الحب وصفو الوداد % 84(@)(@@) % حافظة فيكم عهود الندى % % حفظ الربا عهد السواري الغواد % 85(@)(@@) % و قلما يرعى أياديكم % في القرب من لم يرعها في البعاد % PageV01P523 البحر : - 1(@)(@@) % أمن أسماء والمسرى بعيد % خيال كلما بخلت يجود % 2(@)(@@) % طوى طي البرود عراص نجد % و زار كما تأرجت البرود % 3(@)(@@) % يشق الليل والأعداء فردا % % شجاعا وهو يذعره الوليد % 4(@)(@@) % مواقد عامر وسروح طي % و ما قطعت برملتها زرود % 5(@)(@@) % له ما للبدور من الدياجي % % فأرقني وأصحابي هجود % 6(@)(@@) % فقمت له أطوقه عناقا % % يدا ضعفت وباعثها شديد % 7(@)(@@) % يد القناص تخفق أين مدت % حبالته فتضبط ما تصيد % 8(@)(@@) % فيا لك سحرة سرقت لو أني % % غدا فيها يتم لي الجحود . % 9(@)(@@) % و كيف وترب بابل سلخ شهر % برياها شهود وأرداني . % 10(@)(@@) % أما ومشعشعين بذات عرق % صلا يقرى العراق له عمود % PageV01P524 11(@)(@@) % و رام سهم عينيه بسلح % و بالزوراء يقتل من يريد % 12(@)(@@) % لما وفت الصوارم والعوالي % % بما جنت المحاجر والقدود % 13(@)(@@) % و كم يأوى المشقر من غزال % تحاذر من كناسته الأسود % 14(@)(@@) % تقلم حوله الأظفار عين % و يهتم دونه الأنياب جيد % 15(@)(@@) % و أبيض من نجوم بني هلال % وجوه العيش بعد نواه سود % 16(@)(@@) % هويت له الذي يهواه حتى % % حلا إعراضه لي والصدود % 17(@)(@@) % نفضن الحب أسمالا وعندي % % لهن على القلى حب جديد % 18(@)(@@) % و رحن وقد سفكن دما حراما % % تصيح به الأنامل والخدود % 19(@)(@@) % أما تنهاك عن عيد التصابي % % مواض من شبابك لا تعود % 20(@)(@@) % و قادحة لها في كل يوم % ذبول من نشاطك أو خمود % PageV01P525 21(@)(@@) % طوالع في عذارك لا الأحاظي % % قسمن طلوعهن ولا السعود % 22(@)(@@) % و قالوا حلمتك فقلت شوقا % % متى مبدى الخلاعة لي يعيد % 23(@)(@@) % يجر علي أبيضها خمولا % % و كنت بجاه أسودها أسود % 24(@)(@@) % و لم أر كالبياض مذمما في % % مواطن وهو في أخرى حميد % 25(@)(@@) % فتلحاه العوارض والمفالي % % و ترضاه الترائب والنهود % 26(@)(@@) % عدمت مكارم الأيام من 
ms177	 ذا الش % % قي بها ومن فيها السعيد % 27(@)(@@) % مع الفضل الخصاصة والتمني % % و حول العجز تزدحم الجدود % 28(@)(@@) % تقام على الفقير وما جناها % % إذا وجبت على المثرى الحدود % 29(@)(@@) % و ما لك من أخ في الدهر إلا % % أخوك طريف مالك والتليد % 30(@)(@@) % محضت الناس مختبرا فكل % بكئ دون زبدته زهيد % PageV01P526 31(@)(@@) % هم حولي مع النعمى قيام % و هم عني مع الجلي قعود % 32(@)(@@) % توق تحية ابن العم يوما % % فرب فم بقبلته يكيد % 33(@)(@@) % و لا تخدعك مسحة ظهر أفعى % % فتحت لثاته ناب حديد % 34(@)(@@) % و أغلب ما أتاك الشر ممن % % تذب الشر عنه أو تذود % 35(@)(@@) % و حولك من قبيلك من تكون ال % % قليل به وإن كثر العديد % 36(@)(@@) % مداج أو مباد أو حسود % و شرهم على النعم الحسود % 37(@)(@@) % و مولى عره بك مشخمر % بطول الحفر يهدم ما تشيد % 38(@)(@@) % نصحت لمارق من آل عوف % % لو أن النصح يبلغ ما أريد % 39(@)(@@) % و قلت له قناتك لا تدعها % % توصم بالعقوق ولا تميد % 40(@)(@@) % و بيتك لا تبدل فيه غدرا % % فإن عليك ما يجني الندود % PageV01P527 41(@)(@@) % و لا تعبث بعز مزيدي % لتنقصه وأنت به تزيد % 42(@)(@@) % هم التحموك معروقا وضموا % % عزيبك وهو منتحس طريد % 43(@)(@@) % و مدوا ضبعك المغمور حتى % % سما بك بعد مهبطه صعود % 44(@)(@@) % إلى ناد تفوه به وتغشى % % و سامرة يشب لها وقود % 45(@)(@@) % عنوا بثراك واغترسوك حتى % % بسقت على العضاه وأنت عود % 46(@)(@@) % و ربوا نعمة لك لا يغطي % % عليها الستر غمطك والجحود % 47(@)(@@) % فما غني المبصر وهو باغ % بما تجدي المشورة أو تفيد % 48(@)(@@) % و قام يقودها سوقا عجافا % أعز من القيام بها القعود % 49(@)(@@) % يلوث جبينه منها بعار % تبيد المخزيات ولا يبيد % 50(@)(@@) % فكيف وأنت طير البغي فيها % % جرت لك بالتي عنها تحيد % PageV01P528 51(@)(@@) % نزلت لها بدار الهون جارا % % لأقوام تضام وهم شهود % 52(@)(@@) % صديق العجز أسلمك الأداني % % بجرمك واستراب بك البعيد % 53(@)(@@) % تقاذفك المهامة والفيافي % % و تنكرك التهائم والنجود % 54(@)(@@) % فما لك لا 
ms178	 وألت وأنت حر % يحيرك من عشيرتك العبيد % 55(@)(@@) % و أن الجار لا حي عزيز % بأسرته ولا ميت فقيد % 56(@)(@@) % و لو بأبي الأغر صرخت فاءت % عليك فضول رأفته تعود % 57(@)(@@) % إذن لأثرت عاطفة وحلما % تموت له الضغائن والحقود % 58(@)(@@) % و كان الصفح أبرد في حشاه % % إذا التهبت من الحنق الكبود % 59(@)(@@) % و عاد أبر بالأنساب منكم % % و بالقربي لو أنك تستعيد % 60(@)(@@) % نتجت من المنى بطنا عقيما % % نمى بك والمنى أم ولود % PageV01P529 61(@)(@@) % أتنشد ما أضل الحزم منها % % أطل أسفا فليس لها وجود . % 62(@)(@@) % و توعده وذلك ذل جار % متى اجتمع المذلة والوعيد % 63(@)(@@) % تريدون الرؤس وقد خلقتم % % ذنابي لا انتفاع بأن تريدوا % % 64(@)(@@) % و يأبى الله إلا مزيديا % % على أسد يؤمر أو يسود % 65(@)(@@) % فدعها للذي جفلت إليه % % و سله العفو فهو به يجود % 66(@)(@@) % دعوا قوما يخاصم في علاهم % % رقابكم المواثق والعهود % 67(@)(@@) % بأي سلاحكم قارعتموهم % % أبي الماضي الشبا ونبا الحديد % 68(@)(@@) % و إن سيوفكم لتكون فيهم % % مكاوي لا تنش لها الجلود % 69(@)(@@) % ففخرا يا خزيم فكل فخر % إلى أنواركم أعمى بليد % 70(@)(@@) % لكم نار القرى وندى العشايا % % و فرسان الصباح وعوا فنودوا % % PageV01P530 71(@)(@@) % و أندية وألسنة هبوب % إذا انتضيت وأحلام ركود % 72(@)(@@) % و منكم كل ولاج خروج % و ذو حزمين صدار ورود % 73(@)(@@) % موقر ما أقل السرج ثبت % إذا مالت من الرهج اللبود % 74(@)(@@) % إذا مضر تطامن كل بيت % لها وعلا بربوتها الصعيد % 75(@)(@@) % و كانت جمرة الناس احتبيتم % % و فيكم عز سورتها العتيد % 76(@)(@@) % بنى لكم أبو المظفار مجدا % % على موت الزمات له خلود % 77(@)(@@) % و قدمكم على الناس اضطرارا % % مقامات وأيام شهود % 78(@)(@@) % إجارة حاتم ودم شريق % به لبات حجر والوريد % 79(@)(@@) % و طعنة حاتم وطر قديم % قضى مروان فيها ما يردي % 80(@)(@@) % و صاحت باسم صامت نفس حر % ربيع المقترين بها يجود % PageV01P531 81(@)(@@) % و صخر ذاب صخر على قناكم % % ولان لكم به الحجر الشديد % 82(@)(@@) % و يوم عتيبة علم عريض % تباشره المواسم والوفود % 83 
ms179	(@)(@@) % كرائم من دماء باردات % لديكم لاديات ولا مقيد % 84(@)(@@) % و إن ببابل منكم لبحرا % % لو أن البحر جاد كما يجود % 85(@)(@@) % إذا الوادي جرى ملحا أجاجا % % ترقرق ماؤه العذب البرود % 86(@)(@@) % فتى السن مكتهل حجاه % طريف الملك سؤدده تليد % 87(@)(@@) % إذا اشتبهت كوااكبهم طلوعا % % فنور الدولة القمر الوحيد % 88(@)(@@) % أناف به وقدمه عليكم % % أب كرم أناف به الجدود % 89(@)(@@) % أغر قسيمه السيف المحلى % و مسحب ذيله الروض المجود % 90(@)(@@) % يعود إذا تغرب في العطايا % % و يقلع في الهنات فلا يعود % PageV01P532 91(@)(@@) % بليل الريق من كلم سدسد % يقوم بنصره رمح سديد % 92(@)(@@) % تراغت حول قبته بكار % شفار الجازرين لها قتود % 93(@)(@@) % تراه الخيل أفرس من تمطت % به والجيش أشجع من يقود % 94(@)(@@) % و يغنى ثم يفقر راحتيه % % مقال المادحين الفقر جود % 95(@)(@@) % من الغادي ينقله حصان % مفدي السبق أو عنس وخود % 96(@)(@@) % إذا ركب الطريق وفي بشرطي % % أخ منه على أربي عقيد % 97(@)(@@) % إذا بلغت عن إنسان ينزو % % وراء ضلوعه قلب عميد % 98(@)(@@) % يرى المرعى الخصيب يصدعنه % % و يظمأ وهو يمكنه الورود % 99(@)(@@) % فقل لأمير هذا الحي عني % % أيجمع لي بك الأمل البديد % 100(@)(@@) % أحن إلى لقائك والليالي % % علي مع العوائق لي جنود % PageV01P533 101(@)(@@) % و تجذبني نوازع موقظات % إليك وراءها قدر رقود % 102(@)(@@) % و كم وعدت بك الأمال نفسي % % و يقضي الدهر أن تلوى الوعود % 103(@)(@@) % فهل من عطفة بالود إني % % على شحط النوى خل ودود % 104(@)(@@) % محب بالصفات ولم أشاهد % كأني من نجيكم شهيد % 105(@)(@@) % و كم ملك سواكم مد نحوي % % يديه فقصر الباع المديد % 106(@)(@@) % و معصوب بذكرى أو بشعري % % أحول عنه شعري أو أحيد % 107(@)(@@) % أحاذر أن تبدلني أكف % سوائم صانني عنها الغمود % 108(@)(@@) % لعل علاكم وندى يديكم % % سينهضني بمثقلة تؤود % 109(@)(@@) % و مجتمع عليها القول أني % بها والقول مشترك فريد % 110(@)(@@) % من الغر الغرائب لم يعبها ال % % كلام الوغد والمعنى الرديد % PageV01P534 111(@)(@@) % نوادر تلقط الأسماع منها % % عن الأفواه ما نثر النشيد % 112(@)(@@) % تسير بوصفكم وتقيم فيكم % % خوالد 
ms180	 فهي قاطنة شرود % 113(@)(@@) % و ليس يضر راجيكم لرفد % تلومه إذا قصد القصيد % PageV01P535 البحر : - 1(@)(@@) % جم لها الوادي وعز الذائد % و طاب ما حدث عنها الرائد % 2(@)(@@) % فخلها راتعة مجرورة % وراءها الأرسان والمقاود % 3(@)(@@) % يخلف ما استسلف من جراتها % % كهل أثيث ومعين بارد % 4(@)(@@) % حيث المغير لا ينال فرصة % منها ولا يطمع فيها الطارد % 5(@)(@@) % تذب عنها من سمات ربها % % صوارم ليس لها مغامد % 6(@)(@@) % إذا بدت في عنق أو حارك % فهي عليها أعين رواصد % 7(@)(@@) % و نم فقد حرمها هذا الحمى % % و ضمها وهي دخان شارد % 8(@)(@@) % و أعجز الناس جميعا رعيها % % فاليوم يرعاها جميعا واحد % 9(@)(@@) % أروع لا يغلبه المكر ولا % % تدب في حريمه المكايد % 10(@)(@@) % أعارها عينا فكانت عوذة % لها وشيطان الزمان مارد % PageV01P536 11(@)(@@) % أفرشها كافي الكفاة أمنه % فالظل سكب والنسيم بارد % 12(@)(@@) % دان بتاج الحضرة الدهر لها % % و حل حبل الذل عنها العاقد % 13(@)(@@) % و صدقت أن الربيع بعدها % % بوارق من يده رواعد % 14(@)(@@) % غاصت غصون المجد تحت مائها % % فأورق الذاوي وقام المائد % 15(@)(@@) % و ضحك القاطب من وجه الثرى % % و سال وادي المكرمات الجامد % 16(@)(@@) % و بشر الفضل بقايا أهله % لا تقنطوا في الناس بعد ماجد % 17(@)(@@) % نقل لأبناء الطلاب والمنى % % و الحاج ضاقت بهم المقاصد % 18(@)(@@) % يتاجرون المجد فتخيس في % % أيديهم البضائع الكواسد % 19(@)(@@) % تضمكم حنوته وأنتم % عزون في الآفاق أو بدائد % 20(@)(@@) % زم الأمور فلوى أعناقها % % ساع إلى الغايات وهو قاعد % PageV01P537 21(@)(@@) % و دبر الدنيا على علاتها % % فصلحت والدهر دهر فاسد % 22(@)(@@) % ماض له من عزمه مجرد % يذب من جهل الزمان غامد % 23(@)(@@) % يرى بوجه اليوم صدر غده % تعطيه ما في المصدر الموارد % 24(@)(@@) % لا يأخذ التدبير إلا من عل % فالناس ينحطون وهو صاعد % 25(@)(@@) % رأى انتهاء مجده مبتدأ % لما أعان الكف منه الساعد % 26(@)(@@) % أسهره حب العلا منفردا % % و هو على ظن العيون راقد % 27(@)(@@) % جد وقارا والزمان هازل % و جاد عفوا والسحاب جامد % 28(@)(@@) % و لاح في الملك شهابا فوري % % زناده 