ms61	 راحة منه شج % ما زال معثرا به منذ نشا % % PageV01P190 البحر : دو بيت 1(@)(@@) % كلفت فؤادي فيه ما لم يسع ، % حتى يئست رأفته من جزعي % % 2(@)(@@) % ما زلت أقيم ، في هواه ، عذري % % حتى رجع العاذل يهواه معي % % PageV01P191 البحر : - 1(@)(@@) % أصبحت وشاني معرب عن شاني % % حي الأشواق ميت السلوان % 2(@)(@@) % يامن نسخ الوعد بهجر ونأى % % فرح أملي بوعد زور ثان % PageV01P192 البحر : دو بيت 1(@)(@@) % ألعاذل كالعاذر عندي يا قوم % أهدى لي من أهواه في طيف اللوم % 2(@)(@@) % لاأعتبه ، إن لم يزر في حلمي ، % فالسمع يرى ما لا يرى طيف النوم % PageV01P193 البحر : دو بيت 1(@)(@@) % عيني ، بخيال زائر مشبهه ، % قرت فرحا فديت من وجهه % 2(@)(@@) % قد وحده قلبي وما شبهه % طرفي فلذا في حسنه نزهه % PageV01P194 البحر : دو بيت 1(@)(@@) % % كالبدر يجل حسنه عن وصف % 2(@)(@@) % ماأحسن واو صدغه حين بدت % يا رب ، عسى تكون واوالعطف % PageV01P195 البحر : دو بيت 1(@)(@@) % يا قوم ، إلى كم ذا التجني ، يا قوم ، % لا نوم لمقلة المعنى ، لا نوم % 2(@)(@@) % قد برح بي الوجد ، فمن يسعفني ، % ذا وقتك يا دمعي فاليوم اليوم % PageV01P196 البحر : دو بيت 1(@)(@@) % إن مت وزار تربتي من أهوى % % لبيت مناجيا بغير النجوى % % 2(@)(@@) % في السر أقول يا ترى ما صنعت % ألحاظك بي وليس هذا شكوى % % PageV01P197 البحر : دو بيت 1(@)(@@) % ما بال وقاري فيك قد أصبح طيش % والله لقد هزمت من صبري جيش % 2(@)(@@) % بالله ، متى يكون ذا الوصل متى % % يا عيش محب تصليه ، يا عيش ! % PageV01P198 البحر : دو بيت 1(@)(@@) % ما أصنع ، قد أبطأ علي الخبر ، % ويلاه ! إلى متى ، وكم أنتظر ؟ % 2(@)(@@) % كم أحمل كم أكتم كم أصطبر % يقضى أجلي وليس يقضى وطر % PageV01P199 البحر : دو بيت 1(@)(@@) % قد راح رسولي وكما راح أتى % % بالله متى نقضتم العهد متى ؟ % 2(@)(@@) % ما ذا ظني بكم ، ولا ذا أملي ، % قد أدرك في سؤله من شمتا % % PageV01P200 البحر : دو بيت 1(@)(@@) % روحي لك يا زائر في الليل فدى % % يا مؤنس وحشتي إذا الليل هدى % % 2(@)(@@) % إن كان فراقنا مع الصبح بدا 
ms62	 % % لا أسفر ، بعد ذاك ، صبح ، أبدا % % PageV01P201 البحر : دو بيت 1(@)(@@) % يا حادي ، قف بي ساعة في الربع ، % كي أسمع ، أوأرى ظباء الجزع % 2(@)(@@) % إن لم أرهم ، أوأستمع ذكرهم ، % لاحاجة لي بناظري والسمع % PageV01P202 البحر : دو بيت 1(@)(@@) % بالشعب كذا عن يمنة الحي قف % واذكر جملا من شرح حالي وصف % 2(@)(@@) % إن هم رحموا كان وإلا حسبي % % منهم وكفى بأن فيهم تلفي % % PageV01P203 البحر : دو بيت 1(@)(@@) % أهوى رشأ رشيق القد حلي % % قد حكمه الغرام والوجد علي % 2(@)(@@) % إن قلت : خذ الروح ! يقل لي : عجبا ! % ألروح لنا فهات من عندك شي % % PageV01P204 البحر : دو بيت 1(@)(@@) % لما نزل الشيب براسي وخطا % % والعمر مع الشباب ولي وخطا % % 2(@)(@@) % أصبحت بسمر سمرقند وخطا ، % لا أفرق ما بين صواب وخطا % % PageV01P205 البحر : خفيف تام 1(@)(@@) % سيدي ! ما قبيلة في زمان ، % مر فيها ، في العرب ، كم حي شاعر % 2(@)(@@) % ألق منها حرفا ودع مبتداها % % ثانيا تلق مثلها في العشائر % 3(@)(@@) % وإذا ما صحفت حرفين منها % % كل شطر ، مضعفا ، اسم طائر % PageV01P206 البحر : سريع 1(@)(@@) % ما اسم ، إذا ما سأل المرء ، عن % تصحيفه ، خلا له أفحمه % 2(@)(@@) % فنصف يس له أول % من غير ما شك ، ولا جمجمه % 3(@)(@@) % وإن ترد ثانيه فهو لا % % يذكر للسائل ، كي يفهمه % 4(@)(@@) % وإن تقل : بين لنا ما الذي % % منه تبقى بعد ذا قلت مه % 5(@)(@@) % بينه لي ، إن كنت ذا فطنة ، % فإنني قد جئت بالترجمه % PageV01P207 البحر : خفيف تام 1(@)(@@) % يا خبيرا باللغز بين لنا ما % % حيوان تصحيفه بعض عام % 2(@)(@@) % ربعه إن أضفته لك منه % نصفه إن حسبته عن تمام % PageV01P208 البحر : مجزوء الخفيف 1(@)(@@) % مااسم قوت لأهله ، % مثل طيب تحبه % 2(@)(@@) % قلبه إن جعلته % أولا فهو قلبه % PageV01P209 البحر : خفيف تام 1(@)(@@) % أي شئ حلو إذا قلبوه % بعد تصحيف بعضه كان خلوا % 2(@)(@@) % كاد إن زيد فيه من ليل صب % ثلثاه يرى ، من الصبح ، أضوا % % 3(@)(@@) % وله اسم حروفه مبتداها % % مبتدا أصله ، الذي كان مأوى % % PageV01P210 البحر : مجزوء الخفيف 1(@)(@@) % مااسم شيء من الحيا ، % نصفه قلب نصفه 
ms63	 % 2(@)(@@) % وإذا رخم اقتضى % % طيبه حسن وصفه % PageV01P211 البحر : سريع 1(@)(@@) % إسم الذي تيمني حبه ، % تصحيف طير ، وهو مقلوب % 2(@)(@@) % ليس من العجم ولكنه % إلى اسمه في العرب منسوب % 3(@)(@@) % حروفه ، إن حسبت ، مثلها ، % لحاسب الجمل ، أيوب % PageV01P212 البحر : خفيف تام 1(@)(@@) % خبروني عن اسم شئ شهي % إسمه ظل ، في الفواكه ، سائر % 2(@)(@@) % نصفه طائر وإن صحفوا ما % % غادروا من حروفه فهو طائر % PageV01P213 البحر : مجزوء الرجز 1(@)(@@) % مااسم فتى ، حروفه % % تصحيفها ، إن غيرت % 2(@)(@@) % في الخط عن ترتيبها % % مقلته ، إن نظرت % 3(@)(@@) % أدعو له من قلبه % بعودة منه سرت % % PageV01P214 البحر : مجتث 1(@)(@@) % يا سيدا ، لم يزل ، في % % كل العلوم ، يجول % 2(@)(@@) % مااسم لشيء لذيذ ، % له النفوس تميل % 3(@)(@@) % تصحيف مقلوبه في % % بيوت حي نزول % PageV01P215 البحر : سريع 1(@)(@@) % ما بلدة في الشأم ، قلب اسمها % % تصحيفه اخرى بأرض العجم % 2(@)(@@) % وثلثه إن زال من قلبه % وجدته طيرا ، شجي النغم % 3(@)(@@) % وثلثه نصف وربع له % وربعه ثلثاه حين انقسم % PageV01P216 البحر : مجتث 1(@)(@@) % لما اسم اما ترتضيه % من كل معنى وصورة % % 2(@)(@@) % تصحيف مقلوبه اسما % % حرف وأول سورة % % PageV01P217 البحر : خفيف تام 1(@)(@@) % مااسم قوت يعزى لأول حرف % منه بئر بطيبة مشهورة % % 2(@)(@@) % ثم تصحيفها لثانيه مأوى ، % ولنا مركب وباقيه سورة % % PageV01P218 البحر : خفيف تام 1(@)(@@) % ما اسم طير ، إذا نطقت بحرف % منه مبداه كان ماضي فعله % 2(@)(@@) % وإذا ما قلبته فهو فعلي % % طربا ، إن أخذت لغزي بحله % PageV01P219 البحر : سريع 1(@)(@@) % إسم الذي أهواه تصحيفه ، % وكل شطر منه مقلوب % 2(@)(@@) % يوجد في تلك إذن قسمة % ضئزى ، عيانا ، وهو مكتوب % PageV01P220 البحر : خفيف تام 1(@)(@@) % ما اسم شيء من النبات ، إذا ما % % قلبوه وجدته حيوانا % 2(@)(@@) % وإذا ما صحفت ثلثيه حاشا % بدأه ، كنت واصفا إنسانا % % PageV01P221 البحر : سريع 1(@)(@@) % ما اسم لطير شطره بلدة % في الشرق ، من تصحيفها مشربي % % 2(@)(@@) % وما بقي تصحيف مقلوبه ، % مضعفا قوم من المغرب % PageV01P222 البحر : سريع 1(@)(@@) % مااسم بلا جسم يرى صورة ، % وهو إلى الإنسان محبوبه % 2(@)(@@) % وقلبه تصحيقه صنوه % % فاعن به يعجبك ترتيبه % 3(@)(@@) % حاشيتا الإسم 
ms64	 ، إذا افردا ، % أمر به والأمن مصحوبه % 4(@)(@@) % حروفه أني تهجيتها % % فكل حرف منه مقلوبه % PageV01P223 البحر : سريع 1(@)(@@) % ما اسم ، إذا فتشت شعري تجد % تصحيفه ، في الخط ، مقلوبه % 2(@)(@@) % وهو إذا صحفت ثانيه من % أنواع طير ، غير محبوبه % PageV01P224 البحر : سريع 1(@)(@@) % ونقط حرف فيه إن زال مع % ألف به ، بيع بخروبه % 2(@)(@@) % ونصفه الثلثان من آلة % لجنسه في الضرب منسوبه % 3(@)(@@) % ونصفه الآخر نصف اسم من % جانسه ، يتبع أسلوبه % 4(@)(@@) % وقلبه قلب ، لما فهمه ، % من بعد لام ، كل أعجوبه % 5(@)(@@) % حاشيتاه عوذة ، بعدما % % صحفتا ، في الذكر ، مطلوبه % 6(@)(@@) % والجيم فيه إن تعد داله % والدال جيما فيه محسوبه % 7(@)(@@) % من بعد حرفين به صحفا % والزاي واو ، فيه مكتوبه % 8(@)(@@) % صار اسم من شرفه الله بال % وحي كما شرف مصحوبه % PageV01P225 البحر : بسيط تام 1(@)(@@) % نشرت في موكب العشاق أعلامي % % وكان قبلي بلى في الحب أغلامي % % 2(@)(@@) % وسرت فيه ولم أبرح بدولته ، % حتى وجدت ملوك العشق خدامي % % 3(@)(@@) % ولم أزل منذ أخذ العهد في قدمي % % لكعبة الحسن ، تجريدي وإحرامي % % 4(@)(@@) % وقد رماني هواكم في الغرام إلى % % مقام حب شريف شامخ سام % 5(@)(@@) % جهلت أهلي فيه أهل نسبته % وهم أعز أخلائي وألزامي % % 6(@)(@@) % قضيت فيه إلى حين انقضا أجلي % % شهري ودهري وساعاتي وأعوامي % % 7(@)(@@) % ظن العذول بأن العذل يوقفني % % نام العذول وشوقي زائد نام % 8(@)(@@) % إن عام إنسان عيني في مدامعه ، % فقد أمد بإحسان وإنعام % 9(@)(@@) % يا سائقا عيس أحبابي عسى مهلا % وسر رويدا ، فقلبي بين أنعام % 10(@)(@@) % سلكت كل مقام في محبتكم % وما تركت مقاما قط قدامي % % PageV01P226 11(@)(@@) % وكنت أحسب أني قد وصلت إلى % % أعلى ، وأغلى مقام ، بين أقوامي % % 12(@)(@@) % حتى بدا لي مقام لم يكن أربي ، % ولم يمر بأفكاري وأوهامي % % 13(@)(@@) % إن كان منزلتي في الحب عندكم % ما قد رأيت ، فقد ضيعت أيامي % % 14(@)(@@) % أمنية ظفرت روحي بها زمنا % واليوم أحسبها أضغاث أحلام % 15(@)(@@) % وإن يكن فرط وجدي في محبتكم % إثما فقد كثرت في الحب آثامي % % 16(@)(@@) % ولو علمت بأن الحب آخره % هذا 
ms65	 الحمام ، لما خالفت لوامي % % 17(@)(@@) % أودعت قلبي إلى من ليس يحفظه % أبصرت خلفي ، وما طالعت ق دامي % % 18(@)(@@) % لقد رماني بسهم من لواحظه % أصمى فؤادي ، فواشوقي إلى الرامي % % 19(@)(@@) % آها على نظرة منه أسر بها ، % فإن أقصى مرامي رؤية الرامي % % 20(@)(@@) % إن أسعد الله روحي ، في محبته ، % وجسمها بين أرواح وأجسام % PageV01P227 21(@)(@@) % وشاهدت واجتلت وجه الحبيب فما % % أسى وأسعد أرزاقي وأقسامي % % 22(@)(@@) % ها قدأظل زمان الوصل ، يا أملي ، % فامنن ، وثبت به قلبي وأقدامي % % 23(@)(@@) % وقد قدمت ، وماقدمت لي عملا ، % إلا غرامي ، وأشواقي ، وإقدامي % % 24(@)(@@) % دار السلام إليها قد وصلت إذن % من سبل أبواب إيماني وإسلامي % % 25(@)(@@) % يا ربنا أرني أنظر إليك بها % % عند القدوم ، وعاملني بإكرام % PageV01P228 
ms66	