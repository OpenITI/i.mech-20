ms341	 لأهلها(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P419(@)(@@) {وقالوا} المشركون {لولا} هلا {يأتينا} محمد {بآية من ربه} مما يقترحونه {أو لم تأتهم} بالتاء والياء {بينة} بيان {ما في الصحف الأولى} المشتمل عليه القرآن من أنباء الأمم الماضية وإهلاكهم بتكذيب الرسل(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P419(@)(@@) {ولو أنا أهلكناهم بعذاب من قبله} قبل محمد الرسول {لقالوا} يوم القيامة {ربنا لولا} هلا {أرسلت إلينا رسولا فنتبع آياتك} المرسل بها {من قبل أن نذل} في القيامة {ونخزى} في جهنم(@)(@@) PageV01P419(@)(@@)(@@)(@@) | 13 - (@)(@@) PageV01P420(@)(@@) {قل} لهم {كل} منا ومنكم {متربص} منتظر ما يؤول إليه الأمر {فتربصوا فستعلمون} في القيامة {من أصحاب الصراط} الطريق {السوي} المستقيم {ومن اهتدى} من الضلالة أنحن أم أنتم = 21 سورة(@)(@@)(@@)(@@) | الأنبياء(@)(@@) مكية وهي مائة واثنتا عشرة آية نزلت بعد سورة إبراهيم بسم الله الرحمن الرحيم(@)(@@) PageV01P420(@)(@@) {اقترب} قرب {للناس} أهل مكة منكري البعث {حسابهم} يوم القيامة {وهم في غفلة} عنه {معرضون} عن التأهب له بالإيمان(@)(@@) PageV01P420(@)(@@) {ما يأتيهم من ذكر من ربهم محدث} شيئا فشيئا أي لفظ قرآن {إلا استمعوه وهم يلعبون} يستهزئون(@)(@@) PageV01P420(@)(@@) {لاهية} غافلة {قلوبهم} عن معناه {وأسروا النجوى} الكلام {الذين ظلموا} بدل من واو {وأسروا النجوى {هل هذا} أي محمد {إلا بشر مثلكم} فما يأتي به سحر {أفتأتون السحر} تتبعونه {وأنتم تبصرون} تعلمون أنه سحر(@)(@@) PageV01P420(@)(@@) {قال} لهم {ربي يعلم القول} كائنا {في السماء والأرض وهو السميع} لما أسروه {العليم} به(@)(@@) PageV01P420(@)(@@) {بل} للانتقال من غرض إلى آخر في المواضع الثلاثة {قالوا} فيما أتى به من القرآن هو {أضغاث أحلام} أخلاط رآها في النوم {بل افتراه} اختلقه {بل هو شاعر} فما أتى به شعر {فليأتنا بآية كما أرسل الأولون} كالناقة والعصا واليد قال تعالى(@)(@@) PageV01P420(@)(@@) {ما آمنت قبلهم من قرية} أي أهلها {أهلكناها} بتكذيبها ما أتاها من الآيات {أفهم يؤمنون} لا(@)(@@) PageV01P420(@)(@@) {وما أرسلنا قبلك إلا رجالا نوحي} وفي قراءة بالياء وفتح الحاء {إليهم} لا ملائكة {فاسألوا أهل الذكر} العلماء بالتوراة والإنجيل {إن كنتم لا تعلمون} ذلك فإنهم يعلمونه وأنتم إلى تصديقهم أقرب من تصديق المؤمنين بمحمد(@)(@@) PageV01P421(@)(@@) {وما جعلناهم} أي الرسل {جسدا} بمعنى أجسادا {لا يأكلون الطعام} 
ms342	 بل يأكلونه {وما كانوا خالدين} في الدنيا(@)(@@) PageV01P421(@)(@@) {ثم صدقناهم الوعد} بإنجائهم {فأنجيناهم ومن نشاء} المصدقين لهم {وأهلكنا المسرفين} المكذبين لهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {لقد أنزلنا إليكم} يا معشر قريش {كتابا فيه ذكركم} لأنه بلغتكم {أفلا تعقلون} فتؤمنون به(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {وكم قصمنا} أهلكنا {من قرية} أي أهلها {كانت ظالمة} كافرة {وأنشأنا بعدها قوما آخرين}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {فلما أحسوا بأسنا} شعر أهل القرية بالإهلاك {إذا هم منها يركضون}(@)(@@) يهربون مسرعين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) فقالت لهم الملائكة استهزاء {لا تركضوا وارجعوا إلى ما أترفتم} نعمتم {فيه ومساكنكم لعلكم تسألون} شيئا من دنياكم على العادة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {قالوا يا} للتنبيه {ويلنا} هلاكنا {إنا كنا ظالمين} بالكفر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {فما زالت تلك} الكلمات {دعواهم} يدعون بها ويرددونها {حتى جعلناهم حصيدا} كالزرع المحصود بالمناجل بأن قتلوا بالسيف {خامدين} ميتين كخمود النار إذا طفئت(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {وما خلقنا السماء والأرض وما بينهما لاعبين} عابثين بل دالين على قدرتنا ونافعين عبادنا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {لو أردنا أن نتخذ لهوا} ما يلهى به من زوجة أو ولد {لاتخذناه من لدنا} من عندنا من الحور العين والملائكة {إن كنا فاعلين} ذلك لكنا لم نفعله فلم نرده(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P421(@)(@@) {بل نقذف} نرمي {بالحق} الإيمان {على الباطل} الكفر {فيدمغه} يذهبه {فإذا هو زاهق} ذاهب ودمغه في الأصل أصاب دماغه بالضرب وهو مقتل {ولكم} يا كفار مكة {الويل} العذاب الشديد {مما تصفون} الله به من الزوجة أو الولد(@)(@@) PageV01P421(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P422(@)(@@) {وله} تعالى {من في السماوات والأرض} ملكا {ومن عنده} أي الملائكة مبتدأ خبره {لا يستكبرون عن عبادته ولا يستحسرون} لا يعيون(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {يسبحون الليل والنهار لا يفترون} عنه فهو كالنفس منا لا يشغلنا عنه شاغل(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {أم} بمعنى بل للانتقال والهمزة للإنكار {اتخذوا آلهة} كائنة {من الأرض} كحجر وذهب وفضة {هم} أي الآلهة {ينشرون} أي يحيون الموتى لا ولا يكون إلها إلا من يحيي الموتى(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {لو كان فيهما} أي السماوات والأرض {آلهة إلا الله} أي غيره {لفسدتا} أي خرجتا عن نظامهما المشاهد لوجود التمانع بينهم على وفق العادة عند تعدد الحاكم من التمانع في 
ms343	 الشيء وعدم الاتفاق عليه {فسبحان} تنزيه {الله رب} خالق {العرش} الكرسي {عما يصفون} الكفار الله به من الشريك له وغيره(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {لا يسأل عما يفعل وهم يسألون} عن أفعالهم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {أم اتخذوا من دونه} تعالى أي سواه {آلهة} فيه استفهام توبيخ {قل هاتوا برهانكم} على ذلك ولاسبيل إليه {هذا ذكر من معي} أمتي وهو القرآن {وذكر من قبلي} من الأمم وهو التوراة والإنجيل وغيرهما من كتب الله ليس في واحد منها أن مع الله إلها مما قالوا تعالى عن ذلك {بل أكثرهم لا يعلمون الحق} توحيد الله {فهم معرضون} عن النظر الموصل إليه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {وما أرسلنا من قبلك من رسول إلا نوحي} وفي قراءة بالياء وفتح الحاء {إليه أنه لا إله إلا أنا فاعبدون} أي وحدوني(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {وقالوا اتخذ الرحمن ولدا} من الملائكة {سبحانه بل} هم {عباد مكرمون} عنده والعبودية تنافي الولادة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {لا يسبقونه بالقول} لا يأتون بقولهم إلا بعد قوله {وهم بأمره يعملون} أي بعده(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P422(@)(@@) {يعلم ما بين أيديهم وما خلفهم} ما عملوا وما هم عاملون {ولا يشفعون إلا لمن ارتضى} تعالى أن يشفع له {وهم من خشيته} تعالى {مشفقون} خائفون(@)(@@) PageV01P422(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P423(@)(@@) {ومن يقل منهم إني إله من دونه} أي الله أي غيره وهو إبليس دعا إلى عبادة نفسه وأمر بطاعتها {فذلك نجزيه جهنم كذلك} كما نجزيه {نجزي الظالمين} المشركين(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P423(@)(@@) {أو لم} بواو وتركها {ير} يعلم {الذين كفروا أن السماوات والأرض كانتا رتقا} سدا بمعنى مسدودة {ففتقناهما} جعلنا السماء سبعا والأرض سبعا أو فتق السماء أن كانت لا تمطر فأمطرت وفتق الأرض أن كانت لا تنبت فأنبتت {وجعلنا من الماء} النازل من السماء والنابع من الأرض {كل شيء حي} من نبات وغيره أي فالماء سبب لحياته {أفلا يؤمنون} بتوحيدي(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P423(@)(@@) {وجعلنا في الأرض رواسي} جبالا ثواب ل {أن} لا {تميد} تتحرك {بهم وجعلنا فيها} الرواسي {فجاجا} مسالك {سبلا} بدل طرقا نافذة واسعة {لعلهم يهتدون} إلى مقاصدهم في الأسفار(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P423(@)(@@) {وجعلنا السماء سقفا} للأرض كالسقف للبيت {محفوظا} 
ms344	 عن الوقوع {وهم عن آياتها} من الشمس والقمر والنجوم {معرضون} لا يتفكرون فيها فيعلمون أن خالقها لا شريك له(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P423(@)(@@) {وهو الذي خلق الليل والنهار والشمس والقمر كل} تنوينه عوض عن المضاف إليه من الشمس والقمر وتابعه وهو النجوم {في فلك} مستدير كالطاحونة في السماء {يسبحون} يسيرون بسرعة كالسابح في الماء وللتشبيه به أتى بضمير جمع من يعقل(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P423(@)(@@) ونزل لما قال الكفار إن محمدا سيموت {وما جعلنا لبشر من قبلك الخلد} البقاء في الدنيا {أفائن مت فهم الخالدون} فيها لا فالجملة الأخيرة محل الاستفهام الإنكاري(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P423(@)(@@) {كل نفس ذائقة الموت} في الدنيا {ونبلوكم} نختبركم {بالشر والخير} كفقر وغنى وسقم وصحة {فتنة} مفعول له أي لننظر أتصبرون وتشكرون أم لا {وإلينا ترجعون} فنجازيكم(@)(@@) PageV01P423(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P424(@)(@@) {وإذا رآك الذين كفروا إن} ما {يتخذونك إلا هزؤا} أي مهزوءا به يقولون {هذا الذي يذكر آلهتكم} أي يعيبها {وهم بذكر الرحمن} لهم {هم} تأكيد {كافرين} به إذ قالوا ما نعرفه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P424(@)(@@) ونزل في استعجالهم العذاب {خلق الإنسان من عجل} أي أنه لكثرة عجله في أحواله كأنه خلق منه {سأريكم آياتي} مواعيدي بالعذاب {فلا تستعجلون} فيه فأراهم القتل ببدر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P424(@)(@@) {ويقولون متى هذا الوعد} بالقيامة {إن كنتم صادقين} فيه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P424(@)(@@) قال تعالى {لو يعلم الذين كفروا حين لا يكفون} يدفعون {عن وجوههم النار ولا عن ظهورهم ولا هم ينصرون} يمنعون منها في القيامة وجواب لو ما قالوا ذلك(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P424(@)(@@) {بل تأتيهم} القيامة {بغتة فتبهتهم} تحيرهم {فلا يستطيعون ردها ولا هم ينظرون} يمهلون لتوبة أو معذرة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P424(@)(@@) {ولقد استهزئ برسل من قبلك} فيه تسلية للنبي صلى الله عليه وسلم {فحاق} نزل {بالذين سخروا منهم ما كانوا به يستهزئون} وهو العذاب فكذا يحيق بمن استهزأ بك(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P424(@)(@@) {قل} لهم {من يكلؤكم} يحفظكم {بالليل والنهار من الرحمن} من عذابه إن نزل بكم أي لا أحد يفعل ذلك والمخاطبون لا يخافون عذاب الله لإنكارهم له {بل هم عن ذكر ربهم} أي القرآن {معرضون} لا يتفكرون فيه(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P424(@)(@@) {أم} فيها معنى 
ms345	 الهمزة للإنكار أي أ {لهم آلهة تمنعهم} مما يسوؤهم {من دوننا} أي ألهم من يمنعهم منه غيرنا لا {لا يستطيعون} أي الآلهة {نصر أنفسهم} فلا ينصرونهم {ولا هم} أي الكفار {منا}(@)(@@) من عذابنا {يصحبون} يجارون يقال صحبك الله أي حفظك وأجارك(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P424(@)(@@) {بل متعنا هؤلاء وآباءهم} بما أنعمنا عليهم {حتى طال عليهم العمر} فاغتروا بذلك {أفلا يرون أنا نأتي الأرض} نقصد أرضهم {ننقصها من أطرافها} بالفتح على النبي {أفهم الغالبون} لا بل النبي وأصحابه(@)(@@) PageV01P424(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P425(@)(@@) {قل} لهم {إنما أنذركم بالوحي} من الله لا من قبل نفسي {ولا يسمع الصم الدعاء إذا} بتحقيق الهمزتين وتسهيل الثانية بينها وبين الياء {ما ينذرون} هم لتركهم العمل بما سمعوه من الإنذار كالصم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P425(@)(@@) {ولئن مستهم نفحة} وقعة خفيفة {من عذاب ربك ليقولن يا} للتنبيه {ويلنا} هلاكنا {إنا كنا ظالمين} بالإشراك وتكذيب محمد(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P425(@)(@@) {ونضع الموازين القسط} ذوات العدل {ليوم القيامة} أي فيه {فلا تظلم نفس شيئا} من نقص حسنة أو زيادة سيئة {وإن كان} العمل {مثقال} زنة {حبة من خردل أتينا بها} بموزونها {وكفى بنا حاسبين} محصين كل شيء(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P425(@)(@@) {ولقد آتينا موسى وهارون الفرقان} أي التوراة الفارقة بين الحق والباطل والحلال والحرام {وضياء} بها {وذكرا} عظة بها {للمتقين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P425(@)(@@) {الذين يخشون ربهم بالغيب} عن الناس أي في الخلاء عنهم {وهم من الساعة} أي أهوالها {مشفقون} خائفون(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P425(@)(@@) {وهذا} أي القرآن {ذكر مبارك أنزلناه أفأنتم له منكرون} الاستفهام فيه للتوبيخ(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P425(@)(@@) {ولقد آتينا إبراهيم رشده من قبل} أي هداه قبل بلوغه {وكنا به عالمين} بأنه أهل لذلك(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P425(@)(@@) {إذ قال لأبيه وقومه ما هذه التماثيل} الأصنام {التي أنتم لها عاكفون} أي على عبادتها مقيمون(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P425(@)(@@) {قالوا وجدنا آباءنا لها عابدين} فاقتدينا بهم(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P425(@)(@@) {قال} لهم {لقد كنتم أنتم وآباؤكم} بعبادتها {في ضلال مبين} بين(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P425(@)(@@) {قالوا أجئتنا بالحق} في قولك هذا {أم أنت من اللاعبين} فيه(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P425(@)(@@) {قال بل ربكم} المستحق للعبادة {رب} مالك {السماوات والأرض الذي فطرهن} خلقهن على غير مثقال سبق {وأنا 
ms346	 على ذلكم} الذي قلته {من الشاهدين} به(@)(@@) PageV01P425(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P426(@)(@@) {وتالله لأكيدن أصنامكم بعد أن تولوا مدبرين}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P426(@)(@@) {فجعلهم} بعد ذهابهم إلى مجتمعهم في يوم عيد لهم {جذاذا} بضم الجيم وكسرها فتاتا بفأس {إلا كبيرا لهم} علق الفأس في عنقه {لعلهم إليه} أي إلى الكبير {يرجعون} فيرون ما فعل بغيره(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P426(@)(@@) {قالوا} بعد رجوعهم ورؤيتهم ما فعل {من فعل هذا بآلهتنا إنه لمن الظالمين} فيه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {قالوا} أي بعضهم لبعض {سمعنا فتى يذكرهم} أي يعيبهم {يقال له إبراهيم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {قالوا فأتوا به على أعين الناس} أي ظاهرا {لعلهم يشهدون} عليه أنه الفاعل(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {قالوا} له بعد إتيانه {أأنت} بتحقيق الهمزتين وإبدال الثانية ألفا وتسهيلها وإدخال ألف بين المسهلة والأخرى وتركه {فعلت هذا بآلهتنا يا إبراهيم}(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {قال} ساكتا عن فعله {بل فعله كبيرهم هذا فاسألوهم} عن فاعله {إن كانوا ينطقون} فيه تقديم جواب الشرط وفيما قبله تعريض لهم بأن الصنم المعلوم عجزه عن الفعل لا يكون إلها(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {فرجعوا إلى أنفسهم} بالتفكر {فقالوا} لأنفسهم {إنكم أنتم الظالمون} بعبادتكم من لا ينطق(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {ثم نكسوا} من الله {على رؤوسهم} أي ردوا إلى كفرهم وقالوا والله {لقد علمت ما هؤلاء ينطقون} أي فكيف تأمرنا بسؤالهم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {قال أفتعبدون من دون الله} أي بدله {ما لا ينفعكم شيئا} من رزق وغيره {ولا يضركم} شيئا إذا لم تعبدوه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P426(@)(@@) {أف} بكسر الفاء وفتحها بمعنى مصدر أي نتنا وقبحا {لكم ولما تبعدون من دون الله} أي غيره {أفلا تعقلون} أن هذه الأصنام لا تستحق العبادة ولا تصلح لها وإنما يستحقها الله تعالى(@)(@@) PageV01P426(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P427(@)(@@) {قالوا حرقوه} أي إبراهيم {وانصروا آلهتكم} أي بتحريقه {إن كنتم فاعلين} نصرتها فجعوا له الحطب الكثير وأضرموا النار في جميعه وأوثقوا إبراهيم وجعلوه في منجنيق ورموه في النار قال تعالى(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P427(@)(@@) {قلنا يا نار كوني بردا وسلاما على إبراهيم} فلم تحرق منه غير وثاقه وذهبت حرارتها وبقيت إضاءتها وبقوله {وسلاما} سلم من الموت ببردها(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {وأرادوا به كيدا} وهو التحريق {فجعلناهم الأخسرين} في مرادهم 
ms347	(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {ونجيناه ولوطا} بن أخيه هاران من العراق {إلى الأرض التي باركنا فيها للعالمين} بكثرة الأنهار والأشجار وهي الشام نزل إبراهيم بفلسطين ولوط بالمؤتفكة وبينهما يوم(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {ووهبنا له} أي لإبراهيم وكان سأل ولدا كما ذكر في الصافات {إسحاق ويعقوب نافلة} أي زيادة على المسؤول أو هو ولد الولد {وكلا} أي هو وولداه {جعلنا صالحين} أنبياء(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {وجعلناهم أئمة} بتحقيق الهمزتين وإبدال الثانية ياء يقتدى بهم في الخير {يهدون} الناس {بأمرنا} إلى ديننا {وأوحينا إليهم فعل الخيرات وإقام الصلاة وإيتاء الزكاة} أي أن تفعل وتقام وتؤتى منهم ومن أتباعهم وحذف هاء إقامة تخفيف {وكانوا لنا عابدين}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {ولوطا آتيناه حكما} فصلا بين الخصوم {وعلما ونجيناه من القرية التي كانت تعمل} أي أهلها الأعمال {الخبائث} من اللواط والرمي بالبندق واللعب بالطيور وغير ذلك {إنهم كانوا قوم سوء} مصدر ساءه نقيض سره {فاسقين}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {وأدخلناه في رحمتنا} بأن أنجيناه من قومه {إنه من الصالحين}(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {و} اذكر {نوحا} وما بعده بدل منه {إذ نادى} دعا على قومه بقوله {رب لا تذر} إلخ {من قبل} أي قبل إبراهيم ولوط {فاستجبنا له فنجيناه وأهله} الذين في سفينته {من الكرب العظيم} أي الغرق وتكذيب قومه له(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P427(@)(@@) {ونصرناه} منعناه {من القوم الذين كذبوا بآياتنا} الدالة على رسالته أن لا يصلوا إليه بسوء {إنهم كانوا قوم سوء فأغرقناهم أجمعين(@)(@@) PageV01P427(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P428(@)(@@) {و} اذكر {داود وسليمان} أي قصتهما ويبدل منهما {إذ يحكمان في الحرث} هو زرع أو كرم {إذ نفشت فيه غنم القوم} أي رعته ليلا بلا راع بأن انفلتت {وكنا لحكمهم شاهدين} فيه استعمال ضمير الجمع لاثنين قال داود لصاحب الحرث رقاب الغنم وقال سليمان ينتفع بدرها ونسلها وصوفها إلى أن يعود الحرث كما كان بإصلاح صاحبها فيردها إليه(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P428(@)(@@) {ففهمناها} أي الحكومة {سليمان} وحكمهما باجتهاد ورجع داود إلى سليمان وقيل بوحي والثاني ناسخ للأول {وكلا} منهما {آتينا} ه {حكما} نبوة {وعلما} بأمور الدين {وسخرنا مع داود الجبال يسبحن والطير} كذلك سخرا للتسبيح معه لأمره به إذا 
ms348	 وجد فترة لينشط له {وكنا فاعلين} تسخير تسبيحهما معه وإن كان عجبا عندكم أي مجاوبته للسيد داود(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P428(@)(@@) {وعلمناه صنعة لبوس} وهي الدرع لأنها تلبس وهو أول من صنعها وكان قبلها صفائح {لكم} في جملة الناس} لنحصنكم} بالنون لله وبالتحتانية لداود وبالفوقانية للبوس {من بأسكم} حربكم مع أعدائكم {فهل أنتم} يا أهل مكة {شاكرون} نعمي بتصديق الرسول أي اشكروني بذلك(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P428(@)(@@) {و} سخرنا {لسليمان الريح عاصفة} وفي آية أخرى رخاء أي شديدة الهبوب وخفيفته حسب إرادته {تجري بأمره إلى الأرض التي باركنا فيها} وهي الشام {وكنا بكل شيء عالمين} من ذلك علم الله تعالى بأن ما يعطيه سليمان يدعوه إلى الخضوع لربه ففعله تعالى على مقتضى علمه(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P428(@)(@@) {و} سخرنا {من الشياطين من يغوصون له} يدخلون في البحر فيخرجون منه الجواهر لسليمان {ويعملون عملا دون ذلك} أي سوى الغوص من البناء وغيره {وكنا لهم حافظين} من أن يفسدوا ما عملوا لأنهم كانوا إذا فرغوا من عمل قبل الليل أفسدوه إن لم يشتغلوا بغيره(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P428(@)(@@) {و} اذكر {أيوب} ويبدل منه {إذ نادى ربه} لما ابتلي بفقد جميع ماله وولده وتمزيق جسده وهجر جميع الناس له إلا زوجته سنين ثلاثا أو سبعا أو ثماني عشرة وضيق عيشه {أني} بفتح الهمزة بتقدير الياء {مسني الضر} أي الشدة {وأنت أرحم الراحمين(@)(@@) PageV01P428(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P429(@)(@@) {فاستجبنا له} نداءه {فكشفنا ما به من ضر وآتيناه أهله} أولاده الذكور والإناث بأن أحيوا له وكل من الصنفين ثلاث أو سبع {ومثلهم معهم} من زوجته وزيد في شبابها وكان له أندر للقمح وأندر للشعير فبعث الله سحابتين أفرغت إحداهما على أندر القمح الذهب وأفرغت الأخرى على أندر الشعير الورق حتى فاض {رحمة} مفعول له {من عندنا} صفة {وذكرى للعابدين} ليصبروا فيثابوا(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P429(@)(@@) {و} اذكر {إسماعيل وإدريس وذا الكفل كل من الصابرين} على طاعة الله وعن معاصيه(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P429(@)(@@) {وأدخلناهم في رحمتنا} من النبوة {إنهم من الصالحين} لها وسمي ذا الكفل لأنه تكفل بصيام جميع نهاره وقيام جميع ليله وأن يقضي بين الناس 
ms349	 ولا يغضب فوفى بذلك وقيل لم يكن نبيا(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P429(@)(@@) {و} اذكر {ذا النون} صاحب الحوت وهو يونس بن متى ويبدل منه {إذ ذهب مغاضبا} لقومه أي غضبان عليهم مما قاسى منهم ولم يؤذن له في ذلك {فظن أن لن نقدر عليه} أي نقضي عليه بما قضيناه من حبسه في بطن الحوت أو نضيق عليه بذلك {فنادى في الظلمات} ظلمة الليل وظلمة البحر وظلمة بطن الحوت {أن} أي بأن {لا إله إلا أنت سبحانك إني كنت من الظالمين} في ذهابي من بين قومي بلا إذن(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P429(@)(@@) {فاستجبنا له ونجيناه من الغم} بتلك الكلمات {وكذلك} كما نجيناه {ننجي المؤمنين} من كربهم إذا استغاثوا بنا داعين(@)(@@)(@@)(@@) | 8 - (@)(@@) PageV01P429(@)(@@) {و} اذكر {زكريا} ويبدل منه {إذ نادى ربه} بقوله {رب لا تذرني فردا} أي بلا ولد يرثني {وأنت خير الوارثين} الباقي بعد فناء خلقك(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P429(@)(@@) {فاستجبنا له} نداءه {ووهبنا له يحيى} ولدا {وأصلحنا له زوجه} فأتت بالولد بعد عقمها {إنهم} أي من ذكر من الأنبياء {كانوا يسارعون} يبادرون {في الخيرات} الطاعات {ويدعوننا رغبا} في رحمتنا {ورهبا} من عذابنا {وكانوا لنا خاشعين} متواضعين في عبادتهم(@)(@@) PageV01P429(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {و} اذكر مريم {التي أحصنت فرجها} حفظته من أن ينال {فنفخنا فيها من روحنا} أي جبريل حيث نفخ في جيب درعها فحملت بعيسى {وجعلناها وابنها آية للعالمين} الإنس والجن والملائكة حيث ولدته من غير فحل(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {إن هذه} أي ملة الإسلام {أمتكم} دينكم أيها المخاطبون أي يجب أن تكونوا عليها {أمة واحدة} حال لازمة {وأنا ربكم فاعبدون} وحدون(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {وتقطعوا} أي بعض المخاطبين {أمرهم بينهم} أي تفرقوا أمر دينهم متخالفين فيه وهم طوائف اليهود والنصارى قال تعا لي {كل إلينا راجعون} أي فنجازيه بعمله(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {فمن يعمل من الصالحات وهو مؤمن فلا كفران} أي لا جحود {لسعيه وإنا له كاتبون} بأن نأمر الحفظة بكتبه فنجازيه عليه(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {وحرام على قرية أهلكناها} أريد أهلها {أنهم لا} زائدة {يرجعون} أي ممتنع رجوعهم إلى الدنيا(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {حتى} غاية لامتناع رجوعهم {إذا فتحت} بالتخفيف والتشديد 
ms350	 {يأجوج ومأجوج} بالهمز وتركه اسمان أعجميان لقبيلتين ويقدر قبله مضاف أي سدهما وذلك قرب القيامة {وهم من كل حدب} مرتفع من الأرض {ينسلون} يسرعون(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {واقترب الوعد الحق} أي يوم القيامة {فإذا هي} أي القصة {شاخصة أبصار الذين كفروا} في ذلك اليوم لشدته يقولون {يا} للتنبيه {ويلنا} هلاكنا {قد كنا} في الدنيا {في غفلة من هذا} اليوم {بل كنا ظالمين} أنفسنا بتكذيبنا للرسل(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {إنكم} يا أهل مكة {وما تعبدون من دون الله} أي غيره من الأوثان {حصب جهنم} وقودها {أنتم لها واردون} داخلون فيها(@)(@@)(@@)(@@) | 9 - (@)(@@) PageV01P430(@)(@@) {لو كان هؤلاء} الأوثان {آلهة} كما زعمتم {ما وردوها} دخلوها {وكل} من العابدين والمعبودين {فيها خالدون}(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P430(@)(@@) {لهم} العابدين {فيها زفير وهم فيها لا يسمعون} شيئا لشدة غليانها ونزل لما قال بن الزبعرى عبد عزير والمسيح والملائكة فهم في النار على مقتضى ما تقدم(@)(@@) PageV01P430(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {إن الذين سبقت لهم منا} المنزلة {الحسنى} ومنهم من ذكر {أولئك عنها مبعدون}(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {لا يسمعون حسيسها} صوتها {وهم في ما اشتهت أنفسهم} من النعيم {خالدون}(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {لا يحزنهم الفزع الأكبر} وهو أن يؤمر بالعبد إلى النار {وتتلقاهم} تستقبلهم {الملائكة} عند خروجهم من القبور يقولون لهم {هذا يومكم الذي كنتم توعدون} في الدنيا(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {يوم} منصوب باذكر مقدرا قبله {نطوي السماء كطي السجل} اسم ملك {للكتاب} صحيفة بن آدم عند موته واللام زائدة أو السجل الصحيفة والكتاب بمعنى المكتوب واللام بمعنى على وفي قراءة للكتب جمعا {كما بدأنا أول خلق} من عدم {نعيده} بعد إعدامه فالكاف متعلقة بنعيد وضميره عائد إلى أول وما مصدرية {وعدا علينا} منصوب بوعدنا مقدرا قبله وهو مؤكد لمضمون ما قبله {إنا كنا فاعلين} ما وعدناه(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {ولقد كتبنا في الزبور} بمعنى الكتاب أي كتب الله المنزلة {من بعد الذكر} بمعنى أم الكتاب الذي عند الله {أن الأرض} أرض الجنة {يرثها عبادي الصالحون} عام في كل صالح(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {إن في هذا} القرآن {لبلاغا} كفاية في دخول الجنة {لقوم عابدين} عاملين به(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {وما أرسلناك} يا 
ms351	 محمد {إلا رحمة} أي للرحمة {للعالمين} الإنس والجن بك(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P431(@)(@@) {قل إنما يوحى إلي أنما إلهكم إله واحد} أي ما يوحى إلي في أمر الإله إلا وحدانيته {فهل أنتم مسلمون} منقادون لما يوحى إلي من وحدانية الإله والاستفهام بمعنى الأمر(@)(@@) PageV01P431(@)(@@)(@@)(@@) | 10 - (@)(@@) PageV01P432(@)(@@) {فإن تولوا} عن ذلك {فقل آذنتكم} أعلمتكم بالحرب {على سواء} حال من الفاعل والمفعول أي مستوين في علمه لا أستبد به دونكم لتتأهبوا {وإن} ما {أدري أقريب أم بعيد ما توعدون} من العذاب أو القيامة المشتملة عليه وإنما يعلمه الله(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P432(@)(@@) {إنه} تعالى {يعلم الجهر من القول} والفعل منكم ومن غيركم {ويعلم ما تكتمون} أنتم وغيركم من السر(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P432(@)(@@) {وإن} ما {أدري لعله} أي ما أعلمتكم به ولم يعلم وقته {فتنة} اختبار {لكم} ليرى كيف صنعكم {ومتاع} تمتع {إلى حين} أي انقضاء آجالكم وهذا مقابل للأول المترجى بلعل وليس الثاني محلا للترجي(@)(@@)(@@)(@@) | 11 - (@)(@@) PageV01P432(@)(@@) {قل} وفي قراءة قال {رب احكم} بيني وبين مكذبي {بالحق} بالعذاب لهم أو النصر عليهم فعذبوا ببدر وأحد وحنين والأحزاب والخندق ونصر عليهم {وربنا الرحمن المستعان على ما تصفون} من كذبكم على الله في قولكم اتخذ ولدا وعلي في قولكم ساحر وعلى القرآن في قولكم شعر = 22 سورة(@)(@@)(@@)(@@) | الحج(@)(@@) مكية إلا {ومن الناس من يعبد الله} الآيتين أو إلا {هذان خصمان} الست آيات فمدنيات وآياتها 78 نزلت بعد النور بسم الله الرحمن الرحيم(@)(@@) PageV01P432(@)(@@) {يأيها الناس} أي أهل مكة وغيرهم {اتقوا ربكم} أي عقابه بأن تطيعوه {إن زلزلة الساعة} أي الحركة الشديدة للأرض التي يكون بعدها طلوع الشمس من مغربها الذي هو قرب الساعة {شيء عظيم} في إزعاج الناس الذي هو نوع من العقاب(@)(@@) PageV01P433(@)(@@) {يوم ترونها تذهل} بسببها {كل مرضعة} بالفعل {عما أرضعت} أي تنساه {وتضع كل ذات حمل} أي حبلى {حملها وترى الناس سكارى} من شدة الخوف {وما هم بسكارى} من الشراب {ولكن عذاب الله شديد} فهم يخافونه(@)(@@) PageV01P433(@)(@@) ونزل في النضر بن الحارث وجماعته {ومن الناس من يجادل في الله بغير علم} قالوا الملائكة بنات الله 
ms352	 والقرآن أساطير الأولين وأنكروا البعث وإحياء من صار ترابا {ويتبع} في جداله {كل شيطان مريد} أي متمرد(@)(@@) PageV01P433(@)(@@) {كتب عليه} قضي على الشيطان {أنه من تولاه} أي اتبعه {فأنه يضله ويهديه} يدعوه {إلى عذاب السعير} أي النار(@)(@@) PageV01P433(@)(@@) {يأيها الناس} أي أهل مكة {إن كنتم في ريب} شك {من البعث فإنا خلقناكم} أي أصلكم آدم {من تراب ثم} خلقنا ذريته {من نطفة} مني {ثم من علقة} وهي الدم الجامد {ثم من مضغة} وهي لحمة قدر ما يمضغ {مخلقة} مصورة تامة الخلق {وغير مخلقة} أي غير تامة الخلق {لنبين لكم} كمال قدرتنا لتستدلوا بها في ابتداء الخلق على إعادته {ونقر} مستأنف {في الأرحام ما نشاء إلى أجل مسمى} وقت خروجه {ثم نخرجكم} من بطون أمهاتكم {طفلا} بمعنى أطفالا {ثم} نعمركم {لتبلغوا أشدكم} أي الكمال والقوة وهو ما بين الثلاثين إلى الأربعين سنة {ومنكم من يتوفى} يموت قبل بلوغ الأشد {ومنكم من يرد إلى أرذل العمر} أخسه من الهرم والخرف {لكيلا يعلم من بعد علم شيئا} قال عكرمة من قرأ القرآن لم يصر بهذه الحالة {وترى الأرض هامدة} يابسة {فإذا أنزلنا عليها الماء اهتزت} تحركت {وربت} ارتفعت وزادت {وأنبتت من} زائدة {كل زوج} صنف {بهيج} حسن(@)(@@) PageV01P433(@)(@@) {ذلك} المذكور من بدء خلق الإنسان إلى آخر إحياء الأرض {بأن} بسبب أن {الله هو الحق} الثابت الدائم {وأنه يحيى الموتى وأنه على كل شيء قدير}(@)(@@) PageV01P434(@)(@@) {وأن الساعة آتية لا ريب} شك {فيها وأن الله يبعث من في القبور} ونزل في أبي جهل(@)(@@) PageV01P434(@)(@@) {ومن الناس من يجادل في الله بغير علم ولا هدى} معه {ولا كتاب منير} له نور معه(@)(@@) PageV01P434(@)(@@) {ثاني عطفه} حال أي لاوي عنقه تكبرا عن الإيمان والعطف الجانب عن يمين أو شمال {ليضل} بفتح الياء وضمها {عن سبيل الله} أي دينه {له في الدنيا خزي} عذاب فقتل يوم بدر {ونذيقه يوم القيامة عذاب الحريق} أي الإحراق بالنار ويقال له(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P434(@)(@@) {ذلك بما قدمت يداك} أي قدمته عبر عنه بهما دون غيرهما لأن أكثر الأفعال تزاول 
ms353	 بهما {وأن الله ليس بظلام} أي بذي ظلم {للعبيد} فيعذبهم بغير ذنب(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P434(@)(@@) {ومن الناس من يعبد الله على حرف} أي شك في عبادته شبه بالحال على حرف جبل في عدم ثباته {فإن أصابه خير} صحة وسلامة في نفسه وماله {اطمأن به وإن أصابته فتنة} محنة وسقم في نفسه وماله {انقلب على وجهه} أي رجع إلى الكفر {خسر الدنيا} بفوات ما أمله منها {والآخرة} بالكفر {ذلك هو الخسران المبين} البين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P434(@)(@@) {يدعو} يعبد {من دون الله} من الصنم {ما لا يضره} إن لم يعبده {وما لا ينفعه} إن عبده {ذلك} الدعاء {هو الضلال البعيد} عن الحق(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P434(@)(@@) {يدعو لمن} اللام زائدة {ضره} بعبادته {أقرب من نفعه} إن نفع بتخيله {لبئس المولى} هو أي الناصر {ولبئس العشير} الصاحب هو وعقب ذكر الشاك بالخسران بذكر المؤمنين بالثواب في(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P434(@)(@@) {إن الله يدخل الذين آمنوا وعملوا الصالحات} من الفروض والنوافل {جنات تجري من تحتها الأنهار إن الله يفعل ما يريد} من إكرام من يطيعه وإهانة من يعصيه(@)(@@) PageV01P434(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P435(@)(@@) {من كان يظن أن لن ينصره الله} أي محمدا نبيه {في الدنيا والآخرة فليمدد بسبب} بحبل {إلى السماء} أي سقف بيته يشده فيه وفي عنقه {ثم ليقطع} أي ليختنق به بأن يقطع نفسه من الأرض كما في الصحاح {فلينظر هل يذهبن كيده} في عدم نصرة النبي {ما يغيظ} منها المعنى فليختنق غيظا منها فلا بد منها(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P435(@)(@@) {وكذلك} أي مثل إنزالنا الآية السابقة {أنزلناه} أي القرآن الباقي {آيات بينات} ظاهرات حال {وأن الله يهدي من يريد} هداه معطوف على هاء أنزلناه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P435(@)(@@) {إن الذين آمنوا والذين هادوا} هم اليهود {والصابئين} طائفة منهم {والنصارى والمجوس والذين أشركوا إن الله يفصل بينهم يوم القيامة} بإدخال المؤمنين الجنة وإدخال غيرهم النار {إن الله على كل شيء} من عملهم {شهيد} عالم به علم مشاهدة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P435(@)(@@) {ألم تر} تعلم {أن الله يسجد له من في السماوات ومن في الأرض والشمس والقمر والنجوم والجبال والشجر والدواب} أي يخضع له بما يراد 
ms354	 منه {وكثير من الناس} وهم المؤمنون بزيادة على الخضوع في سجود الصلاة {وكثير حق عليه العذاب} وهم الكافرون لأنهم أبوا السجود المتوقف على الإيمان {ومن يهن الله} يشقه {فما له من مكرم} مسعد {إن الله يفعل ما يشاء} من الإهانة والإكرام(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P435(@)(@@) {هذان خصمان} أي المؤمنون خصم والكفار الخمسة خصم وهو يطلق على الواحد والجماعة {اختصموا في ربهم} أي في دينه {فالذين كفروا قطعت لهم ثياب من نار} يلبسونها يعني أحيطت بهم النار {يصب من فوق رؤوسهم الحميم} الماء البالغ نهاية الحرارة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P435(@)(@@) {يصهر} يذاب {به ما في بطونهم} من شحوم وغيرها {و} تشوى به {الجلود}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P435(@)(@@) {ولهم مقامع من حديد} لضرب رؤوسهم(@)(@@) PageV01P435(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P436(@)(@@) {كلما أرادوا أن يخرجوا منها} أي النار {من غم} يلحقهم بها {أعيدوا فيها} ردوا إليها بالمقامع {و} قيل لهم {ذوقوا عذاب الحريق} أي البالغ نهاية الإحراق(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P436(@)(@@) وقال في المؤمنين {إن الله يدخل الذين آمنوا وعملوا الصالحات جنات تجري من تحتها الأنهار يحلون فيها من أساور من ذهب ولؤلؤ} بالجر أي منهما بأن يرصع اللؤلؤ بالذهب وبالنصب عطفا على محل من أساور {ولباسهم فيها حرير} هو المحرم لبسه على الرجال في الدنيا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P436(@)(@@) {وهدوا} في الدنيا {إلى الطيب من القول} وهو لا إله إلا الله {وهدوا إلى صراط الحميد} أي طريق الله المحمودة ودينه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P436(@)(@@) {إن الذين كفروا ويصدون عن سبيل الله} طاعته {وعن} المسجد الحرام الذي جعلناه} منسكا ومتعبدا {للناس سواء العاكف} المقيم {فيه والباد} الطارئ {ومن يرد فيه بإلحاد} الباء زائدة {بظلم} أي بسببه بأن ارتكب منهيا ولو شتم الخادم {نذقه من عذاب أليم} مؤلم أي بعضه ومن هذا يؤخذ خبر إن أي نذيقهم من عذاب أليم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P436(@)(@@) {و} اذكر {إذ بوأنا} بينا {لإبراهيم مكان البيت} ليبنيه وكان قد رفع زمن الطوفان وأمرناه {أن لا تشرك بي شيئا وطهر بيتي} من الأوثان {للطائفين والقائمين} المقيمين به {والركع السجود} جمع راكع وساجد المصلين(@)(@@) PageV01P436(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P437(@)(@@) {وأذن} ناد {في الناس بالحج} فنادى على جبل أبي قبيس يأيها 
ms355	 الناس إن ربكم بنى بيتا وأوجب عليكم الحج إليه فأجيبوا ربكم والتفت بوجهه يمينا وشمالا وشرقا وغربا فأجابه كل من كتب له أن يحج من أصلاب الرجال وأرحام الأمهات لبيك اللهم لبيك وجواب الأمر {يأتوك رجالا} مشاة جمع راجل كقائم وقيام {و} ركبانا {على كل ضامر} أي بعير مهزول وهو يطلق على الذكر والأنثى {يأتين} أي الضوامر حملا على المعنى {من كل فج عميق} طريق بعيد(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P437(@)(@@) {ليشهدوا} أي يحضروا {منافع لهم} في الدنيا بالتجارة أو في الآخرة فيهما أقوال {ويذكروا اسم الله في أيام معلومات} أي عشر ذي الحجة أو يوم عرفة أو يوم النحر إلى آخر أيام التشريق أقوال {على ما رزقهم من بهيمة الأنعام} الإبل والبقر والغنم التي تنحر في يوم العيد وما بعده من الهدايا والضحايا {فكلوا منها} إذا كانت مستحبة {وأطعموا البائس الفقير} أي الشديد الفقر(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P437(@)(@@) {ثم ليقضوا تفثهم} أي يزيلوا أوساخهم وشعثهم كطول الظفر {وليوفوا} بالتخفيف والتشديد {نذورهم} من الهدايا والضحايا {وليطوفوا} طواف الإفاضة {بالبيت العتيق} أي القديم لأنه أول بيت وضع للناس(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P437(@)(@@) {ذلك} خبر مبتدأ مقدر أي الأمر أو الشأن ذلك المذكور {ومن يعظم حرمات الله} هي ما لا يحل انتهاكه {فهو} أي تعظيمها {خير له عند ربه} في الآخرة {وأحلت لكم الأنعام} أكلا بعد الذبح {إلا ما يتلى عليكم} تحريمه في {حرمت عليكم الميتة} الآية فالاستثناء منقطع ويجوز أن يكون متصلا والتحريم لما عرض من الموت ونحوه {فاجتنبوا الرجس من الأوثان} من للبيان أي الذي هو الأوثان {واجتنبوا قول الزور} أي الشرك بالله في تلبيتكم أو شهادة الزور(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P437(@)(@@) {حنفاء لله} مسلمين عادلين عن كل دين سوى دينه {غير مشركين به} تأكيد لما قبله وهما حالان من الواو {ومن يشرك بالله فكأنما خر} سقط {من السماء فتخطفه الطير} أي تأخذه بسرعة {أو تهوي به الريح} أي تسقطه {في مكان سحيق} بعيد فهو لا يرجى خلاصه(@)(@@) PageV01P437(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P438(@)(@@) {ذلك} يقدر قبله الأمر مبتدأ {ومن يعظم شعائر الله فإنها} أي فإن تعظيمها وهي 
ms356	 البدن التي تهدى للحرم بأن تستحسن وتستسمن {من تقوى القلوب} منهم وسميت شعائر لإشعارها بما تعرف به أنها هدي كطعن حديد بسنامها(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P438(@)(@@) {لكم فيها منافع} كركوبها والحمل عليها ما لا يضرها {إلى أجل مسمى} وقت نحرها {ثم محلها} أي مكان حل نحرها {إلى البيت العتيق} أي عنده والمراد الحرم جميعه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P438(@)(@@) {ولكل أمة} أي جماعة مؤمنة سلفت قبلكم {جعلنا منسكا} بفتح السين مصدر وبكسرها اسم مكان أي ذبحا قربانا أو مكانه {ليذكروا اسم الله على ما رزقهم من بهيمة الأنعام} عند ذبحها {فإلهكم إله واحد فله أسلموا} انقادوا {وبشر المخبتين} المطيعين المتواضعين(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P438(@)(@@) {الذين إذا ذكر الله وجلت} خافت {قلوبهم والصابرين على ما أصابهم} من البلايا {والمقيمي الصلاة} في أوقاتها {ومما رزقناهم ينفقون}(@)(@@) يتصدقون(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P438(@)(@@) {والبدن} جمع بدنة وهي الإبل {جعلناها لكم من شعائر الله} أعلام دينه {لكم فيها خير} نفع في الدنيا كما تقدم وأجر في العقبى {فاذكروا اسم الله عليها} عند نحرها {صواف} قائمة على ثلاث معقولة اليد اليسرى {فإذا وجبت جنوبها} سقطت إلى الأرض بعد النحر وهو وقت الأكل منها {فكلوا منها} إن شئتم {وأطعموا القانع} الذي يقنع بما يعطى ولا يسأل ولا يتعرض {والمعتر} والسائل أو المعترض {كذلك} أي مثل ذلك التسخير {سخرناها لكم} بأن تنحر وتركب وإلا فلم تطق {لعلكم تشكرون} إنعامي عليكم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P438(@)(@@) {لن ينال الله لحومها ولا دماؤها} أي لا يرفعان إليه {ولكن يناله التقوى منكم} أي يرفع إليه منكم العمل الصالح الخالص له مع الإيمان {كذلك سخرها لكم لتكبروا الله على ما هداكم} أرشدكم لمعالم دينه ومناسك حجه {وبشر المحسنين} أي الموحدين(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P438(@)(@@) {إن الله يدافع عن الذين آمنوا} غوائل المشركين {إن الله لا يحب كل خوان} في أمانته {كفور} لنعمته وهم المشركون المعنى أنه يعاقبهم(@)(@@) PageV01P438(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P439(@)(@@) {أذن للذين يقاتلون} أي المؤمنين أن يقاتلوا وهذه أول آية نزلت في الجهاد {بأنهم} أي بسبب أنهم {ظلموا} لظلم الكافرين إياهم {وإن الله على نصرهم لقدير}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P439(@)(@@) هم {الذين أخرجوا من ديارهم بغير حق} 
ms357	 في الإخراج وما أخرجوا {إلا أن يقولوا} أي بقولهم {ربنا الله} وحده وهذا القول حق فالإخراج به إخراج بغير حق {ولولا دفع الله الناس بعضهم} بدل بعض من الناس {ببعض لهدمت} بالتشديد للتكثير وبالتخفيف {صوامع} للرهبان {وبيع} كنائس للنصارى {وصلوات} كنائس لليهود بالعبرانية {ومساجد} للمسلمين {يذكر فيها} أي المواضع المذكورة {اسم الله كثيرا} وتنقطع العبادات بخرابها {ولينصرن الله من ينصره} أي ينصر دينه {إن الله لقوي} على خلقه {عزيز} منيع في سلطانه وقدرته(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P439(@)(@@) {الذين إن مكناهم في الأرض} بنصرهم على عدوهم {أقاموا الصلاة وآتوا الزكاة وأمروا بالمعروف ونهوا عن المنكر} جواب الشرط وهو وجوابه صلة الموصول ويقدر قبله هم مبتدأ {ولله عاقبة الأمور} أي مرجعها إليه في الآخرة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P439(@)(@@) {وإن يكذبوك} إلى آخره فيه تسلية للنبي صلى الله عليه وسلم {فقد كذبت قبلهم قوم نوح} تأنيث قوم باعتبار المعنى {وعاد} قوم هود {وثمود} قوم صالح(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P439(@)(@@) {وقوم إبراهيم وقوم لوط}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P439(@)(@@) {وأصحاب مدين} قوم شعيب {وكذب موسى} كذبه القبط لا قومه بنو إسرائيل أي كذب هؤلاء رسلهم فلك أسوة بهم {فأمليت للكافرين} أمهلتهم بتأخير العقاب لهم {ثم أخذتهم} بالعذاب {فكيف كان نكير} أي إنكاري عليهم بتكذيبهم بإهلاكهم والاستفهام للتقرير أي هو واقع موقعه(@)(@@) PageV01P439(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P440(@)(@@) {فكأين} أي كم {من قرية أهلكتها} وفي قراءة أهلكناها {وهي ظالمة} أي أهلها بكفرهم {فهي خاوية} ساقطة {على عروشها} سقوفها {و} كم من {بئر معطلة} متروكة بموت أهلها {وقصر مشيد رفيع خال بموت أهله(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P440(@)(@@) {أفلم يسيروا} أي كفار مكة {في الأرض فتكون لهم قلوب يعقلون بها} ما نزل بالمكذبين قبلهم {أو آذان يسمعون بها} أخبارهم بالإهلاك وخراب الديار فيعتبروا {فإنها} أي القصة {لا تعمى الأبصار ولكن تعمى القلوب التي في الصدور} تأكيد(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P440(@)(@@) {ويستعجلونك بالعذاب ولن يخلف الله وعده} بإنزال العذاب فأنزله يوم بدر {وإن يوما عند ربك} من أيام الآخرة بسبب العذاب {كألف سنة مما تعدون} بالتاء والياء في الدنيا(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P440(@)(@@) {وكأين من قرية أمليت لها وهي ظالمة ثم أخذتها} المراد أهلها {وإلي 
ms358	 المصير} المرجع(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P440(@)(@@) {قل يأيها الناس} أي أهل مكة {إنما أنا لكم نذير مبين} بين الإنذار وأنا بشير للمؤمنين(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P440(@)(@@) {فالذين آمنوا وعملوا الصالحات لهم مغفرة} من الذنوب {ورزق كريم} هو الجنة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P440(@)(@@) {والذين سعوا في آياتنا} القرآن بإبطالها {معجزين} من اتبع النبي أي ينسبونهم إلى العجز ويثبطونهم عن الإيمان أو مقدرين عجزنا عنهم وفي قراءة معاجزين مسابقين لنا أي يظنون أن يفوتونا بإنكارهم البعث والعقاب {أولئك أصحاب الجحيم} النار(@)(@@) PageV01P440(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P441(@)(@@) {وما أرسلنا من قبلك من رسول} هو نبي أمر بالتبليغ {ولا نبي} أي لم يؤمر بالتبليغ {إلا إذا تمنى} قرأ {ألقى الشيطان في أمنيته} قراءته ما ليس من القرآن مما يرضاه المرسل إليهم وقد قرأ النبي صلى الله عليه وسلم في سورة النجم بمجلس من قريش بعد {أفرأيتم اللات والعزى ومناة الثالثة الأخرى} بإلقاء الشيطان على لسانه من غير علمه صلى الله عليه وسلم به تلك العرانيق العلا وإن شفاعتهن لترتجى ففرحوا بذلك ثم أخبره جبريل بما ألقاه الشيطان على لسانه من ذلك فحزن فسلي بهذه الآية ليطمئن {فينسخ الله} يبطل {ما يلقي الشيطان ثم يحكم الله آياته} يثبتها {والله عليم} بإلقاء الشيطان ما ذكر {حكيم} في تمكينه منه بفعل ما يشاء(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P441(@)(@@) {ليجعل ما يلقي الشيطان فتنة} محنة {للذين في قلوبهم مرض} شقاق ونفاق {والقاسية قلوبهم} أي المشركين عن قبول الحق {وإن الظالمين} الكافرين {لفي شقاق بعيد} خلاف طويل مع النبي صلى الله عليه وسلم والمؤمنين حيث جرى على لسانه ذكر آلهتهم بما يرضيهم ثم أبطل ذلك(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P441(@)(@@) {وليعلم الذين أوتوا العلم} التوحيد والقرآن {أنه} أي القرآن {الحق من ربك فيؤمنوا به فتخبت} تطمئن {له قلوبهم وإن الله لهاد الذين آمنوا إلى صراط} طريق {مستقيم} أي دين الإسلام(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P441(@)(@@) {ولا يزال الذين كفروا في مرية} شك {منه} أي القرآن بما ألقاه الشيطان على لسان النبي ثم أبطل {حتى تأتيهم الساعة بغتة} أي ساعة موتهم أو القيامة فجأة {أو يأتيهم عذاب يوم عقيم} هو يوم بدر لا خير فيه 
ms359	 للكفار كالريح العقيم التي لا تأتي بخير أو هو يوم القيامة لا ليل بعده(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P441(@)(@@) {الملك يومئذ} أي يوم القيامة {لله} وحده وما تضمنه من الاستقرار ناصب للظرف {يحكم بينهم} بين المؤمنين والكافرين بما بين بعده {فالذين آمنوا وعملوا الصالحات في جنات النعيم} فضلا من الله(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P441(@)(@@) {والذين كفروا وكذبوا بآياتنا فأولئك لهم عذاب مهين} شديد بسبب كفرهم(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P441(@)(@@) {والذين هاجروا في سبيل الله} أي طاعته من مكة إلى المدينة {ثم قتلوا أو ماتوا ليرزقنهم الله رزقا حسنا} هو رزق الجنة {وإن الله لهو خير الرازقين} أفضل المعطين(@)(@@) PageV01P441(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P442(@)(@@) {ليدخلنهم مدخلا} بضم الميم وفتحها أي إدخالا أو موضعا {يرضونه} وهو الجنة {وإن الله لعليم} بنياتهم {حليم} عن عقابهم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P442(@)(@@) الأمر {ذلك الذي} قصصناه عليك {ومن عاقب} جازى من المؤمنين {بمثل ما عوقب به} ظلما من المشركين أي قاتلهم كما قاتلوه في الشهر الحرام {ثم بغي عليه} منهم أي ظلم بإخراجه من منزله {لينصرنه الله إن الله لعفو} عن المؤمنين {غفور} لهم عن قتالهم في الشهر الحرام(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P442(@)(@@) {ذلك} النصر {بأن الله يولج الليل في النهار ويولج النهار في الليل} أي يدخل كلا منهما في الآخر بأن يزيد به وذلك من أثر قدرته تعالى التي بها النصر {وأن الله سميع} دعاء للمؤمنين {بصير} بهم حيث جعل فيهم الإيمان فأجاب دعاءهم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P442(@)(@@) {ذلك} النصر أيضا {بأن الله هو الحق} الثابت {وأن ما يدعون} بالياء والتاء يعبدون {من دونه} وهو الأصنام {هو الباطل} الزائل {وأن الله هو العلي} أي العالي على كل شيء بقدرته {الكبير} الذي يصغر كل شيء سواه(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P442(@)(@@) {ألم تر} تعلم {أن الله أنزل من السماء ماء} مطرا {فتصبح الأرض مخضرة} بالنبات وهذا من أثر قدرته {إن الله لطيف} بعباده في إخراج النبات بالماء {خبير} بما في قلوبهم عند تأخير المطر(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P442(@)(@@) {له ما في السماوات وما في الأرض} على جهة الملك {وإن الله لهو الغني} عن عباده {الحميد} لأوليائه(@)(@@) PageV01P442(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P443(@)(@@) {ألم تر} تعلم {أن الله سخر لكم ما في 
ms360	 الأرض} من البهائم {والفلك} السفن {تجري في البحر} للركوب والحمل {بأمره} بإذنه {ويمسك السماء} من {أن} أو لئلا {تقع على الأرض إلا بإذنه} فتهلكوا {إن الله بالناس لرءوف رحيم} في التسخير والإمساك(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P443(@)(@@) {وهو الذي أحياكم} بالإنشاء {ثم يميتكم} عند انتهاء آجالكم {ثم يحييكم} عند البعث {إن الإنسان} أي المشرك {لكفور} لنعم الله بتركه توحيده(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P443(@)(@@) لكل أمة جعلنا منسكا} بفتح السين وكسرها شريعة {هم ناسكوه} عاملون به {فلا ينازعنك} يراد به لا تنازعهم {في الأمر} أي أمر الذبيحة إذ قالوا ما قتل الله أحق أن تأكلوه مما قتلتم {وادع إلى ربك} إلى دينه {إنك لعلى هدى} دين مستقيم(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P443(@)(@@) {وإن جادلوك} في أمر الدين {فقل الله أعلم بما تعملون} فيجازيكم عليه وهذا قبل الأمر بالقتال(@)(@@)(@@)(@@) | 6 - (@)(@@) PageV01P443(@)(@@) {الله يحكم بينكم} أيها المؤمنون والكافرون {يوم القيامة فيما كنتم فيه تختلفون} بأن يقول كل من الفريقين خلاف قول الآخر(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P443(@)(@@) {ألم تعلم} الاستفهام فيه للتقرير {أن الله يعلم ما في السماء والأرض إن ذلك} أي ما ذكر {في كتاب} هو اللوح المحفوظ {إن ذلك} أي علم ما ذكر {على الله يسير} سهل(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P443(@)(@@) {ويعبدون} أي المشركون {من دون الله ما لم ينزل به} هو الأصنام {سلطانا} حجة {وما ليس لهم به علم} أنها آلهة {وما للظالمين} بالإشراك {من نصير} يمنع عنهم عذاب الله(@)(@@) PageV01P443(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P444(@)(@@) {وإذا تتلى عليهم آياتنا} من القرآن {بينات} ظاهرات حال} تعرف في وجوه الذين كفروا المنكر} أي الإنكار لها أي أثره من الكراهة والعبوس {يكادون يسطون بالذين يتلون عليهم آياتنا} أي يقعون فيهم بالبطش {قل أفأنبئكم بشر من ذلكم} بأكره إليكم من القرآن المتلو عليكم هو {النار وعدها الله الذين كفروا} بأن مصيرهم إليها {وبئس المصير} هي(@)(@@)(@@)(@@) | 7 - (@)(@@) PageV01P444(@)(@@) {يأيها الناس} أي أهل مكة {ضرب مثل فاستمعوا له} وهو {إن الذين تدعون} تعبدون {من دون الله} أي غيره وهم الأصنام {لن يخلقوا ذبابا} اسم جنس واحده ذبابة يقع على المذكر والمؤنث {ولو اجتمعوا له} لخلقه {وإن يسلبهم الذباب شيئا} مما 