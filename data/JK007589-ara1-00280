ms261	 يزهى على كل تاج % 6(@)(@@) % يتلقاك في الغلائل منها % % وجه شمس وجسم دمية عاج % 7(@)(@@) % أسبلت من ذراه جعدا أثيثا % جائزا حد متنها الرجراج % % 8(@)(@@) % جاريا فوق متنها جرية الما % % وإن كان حالك الأمواج % 9(@)(@@) % فهي أما السراج منها فوها % % ج وأما الظلام منها فداجي % % 10(@)(@@) % رملة عبلة من البدن غصن % % مخطف مرهف من الإدماج % PageV01P985 11(@)(@@) % فلأعطافها صنوف اهتزاز % % ولأردافها صنوف ارتجاج % 12(@)(@@) % طلعت في لبوسها وحلاها % % كمهاة في روضة مبهاج % 13(@)(@@) % ثم قالت بطرفها سوف تدري % % فأضافت علي رحب الفجاج % 14(@)(@@) % حددت طرفها وعيدا لصب % صرعته بطرفها وهو ساجي % % 15(@)(@@) % ليت شعري علام أوعد بالهج % % ر وودي ود بغير مزاج % 16(@)(@@) % وأنا الخاضع الشحيح على السر % ر كشحي على دم الأوداج % 17(@)(@@) % والتي ما رأيتها قط إلا % % عاد عندي الحسان مثل السماج % 18(@)(@@) % يا له من صبا بغير تصاب % % وشجى خالص بغير تشاجي % % 19(@)(@@) % قل لمن حرمت علي جداها % % أين لطف الغني للمحتاج % 20(@)(@@) % عجبا لي وللذي سولت لي % % منك نفسي وللذي أنا راجي % % PageV01P986 21(@)(@@) % أنا راج لأن يفوز بحظ % منك قلبي وليته منك ناجي % % 22(@)(@@) % ليت شعري أسحر عينيك داء ال % % قلب أم نار خدك الوهاج % 23(@)(@@) % أيها الناس ويحكم هل مغيث % لشيخ يستغيث من ظلم شاجي % % 24(@)(@@) % من مجيري من أضعف الناس ركنا % ولعينيه سطوة الحجاج % 25(@)(@@) % شادن يرتعي القلوب ببغدا % % د ولا يرتعي الخلا بالنباج % 26(@)(@@) % أورث القلب سحر عينيه داء % % ما له غير ريقه من علاج % 27(@)(@@) % ولئن قلت شادن إن قلبي % % لأسير لغادة مغناج % 28(@)(@@) % يومها للنديم يوم نعيم % والتذاذ وحبرة وابتهاج % 29(@)(@@) % ذات شدو إذا جرت فيه للشر % ب جرى أمرها على المنهاج % 30(@)(@@) % يبعث الساكن البعيد اهتياجا % ويداوي حرارة المهتاج % PageV01P987 31(@)(@@) % أقبلت والربيع يختال في الرو % % ض وفي المزن ذي الحيا الثجاج % 32(@)(@@) % ذو سماء كأدكن الخز قد غي % يمت وأرض كأخضر الديباج % 33(@)(@@) % وتجلى عن كل ما نتمنى % % موعد الكذخذاة والهيلاج % 34(@)(@@) % فظللنا في نزهتين وفي حس % نيين بين الأرمال والأهزاج 
ms262	 % 35(@)(@@) % نغمة تسحر القلوب وضرب % هو بين الترتيل والإدراج % 36(@)(@@) % سيرة بين سيرتين من القص % % ف تنسيك سيرة الهملاج % 37(@)(@@) % ونعمنا بليلة ليس للهم % م لديها قرى سوى الإزعاج % % 38(@)(@@) % قد جعلنا الكؤوس فيها نجوما % وجعلنا الأكف كالأبراج % % 39(@)(@@) % تم فيها النعيم كل تمام % وعلا قدره عن الإخداج % 40(@)(@@) % بفتاة تسرنا في المثاني % % وعجوز تسرنا في الزجاج % PageV01P988 41(@)(@@) % لم نزل نشرب المدامة حتى % % عاد منها الفصيح كاللجلاج % 42(@)(@@) % أخذت من رؤوس قوم كرام % % ثأرها عند أرجل الأعلاج % 43(@)(@@) % وطئتها الأعلاج فانتقمت من % نا شمول تضيء ضوء السراج % 44(@)(@@) % فترى كل مصقع ذا سقاط % % وترى كل قيم ذا اعوجاج % 45(@)(@@) % يا لها ليلة قضينا بها حا % % جا وإن علقت قلوبا بحاج % 46(@)(@@) % رفعتنا السعود فيها إلى الفو % % ز فكانت كليلة المعراج % PageV01P989 البحر : - 1(@)(@@) % يا للرجال توسموا وتبينوا % % في خالد شبها من الحجاج % 2(@)(@@) % إغضاؤه عمن يقر بذنبه % % وحلول نقمته بكل مداجي % % 3(@)(@@) % رجل يحب الصادقين لصدقهم % % والصدق أفضل نجوة للناجي % % PageV01P990 البحر : - 1(@)(@@) % يا داعيا نحو العلاء مثوبا % لبيك إن الحق أزهر أبلج % 2(@)(@@) % انشأت تنطق بالصواب ولم تزل % % قدما وسهمك في الصواب الأفلج % 3(@)(@@) % فشكرت سيدنا بفضله % % ولقائل الحق المبين منهج % 4(@)(@@) % ولئن نطقت بحكمة وبلاغة % ومن الكلام محقق ومثبج % 5(@)(@@) % فلقد وجدت لمن مدحت مآثرا % من مثلها يبنى المديح وينسج % 6(@)(@@) % ما زال يلبس مذ تأزر وارتدى % % مدحا تحبر باسمه وتدبج % 7(@)(@@) % وليجزلن لك الثواب ولم يكن % % لخليقة منه نتيج مخدج % 8(@)(@@) % وليقبلن صحيح ودك إنه % % لا يدفع الحسنى بما هو أسمج % 9(@)(@@) % وليشكرنك وهو أعلم عالم % % أن المديح به ينير ويبهج % 10(@)(@@) % وبأن ما حليته من منطق % حسن فمن فعلاته يستنتج % PageV01P991 11(@)(@@) % فاعجب لشكر البحر إن حليته % % والحلي من بطنانه يستخرج % 12(@)(@@) % أبشر أجارك من زمانك ماجد % % حبل الجوار لديه حبل مدمج % 13(@)(@@) % ما دون معروف العلاء وعفوه % عند الرجوع إليه باب مرتج % 14(@)(@@) % إن العلاء لماجد ولماجد % من معشر طلبوا العلاء فأدلجوا % % 15(@)(@@) % ملك إذا الكرب الشداد تظاهرت 
ms263	 % % فبوجهه وبرأيه تتفرج % 16(@)(@@) % ممن إذا أبت الخطوب أو التوت % % عاج الأبي به وقام الأعوج % 17(@)(@@) % لا عيب في نعماه إلا أنها % % للخاطبين وغيرهم تتبرج % 18(@)(@@) % أو أنها تصفو لنا وتعمنا % % حتى يخيل أننا نستدرج % 19(@)(@@) % أضحى الملوك وهم مجاز نحوه % % للطالبين الخير وهو معرج % PageV01P992 البحر : - 1(@)(@@) % أمامك فانظر أي نهجيك تنهج % % طريقان شتى مستقيم وأعوج % 2(@)(@@) % ألا أيهذا الناس طال ضريركم % % بآل رسول الله فاخشوا أو ارتجوا % % 3(@)(@@) % أكل أوان للنبي محمد % قتيل زكي بالدماء مضرج % 4(@)(@@) % تبيعون فيه الدين شرائمة % فلله دين الله قد كاد يمرج % 5(@)(@@) % لقد ألحجوكم في حبائل فتنة % % وللملحجوكم في الحبائل ألحج % 6(@)(@@) % بني المصطفى كم يأكل الناس شلوكم % % لبلواكم عما قليل مفرج % 7(@)(@@) % أما فيهم راع لحق نبيه % % ولا خائف من ربه يتحرج % 8(@)(@@) % لقد عمهوا ما أنزل الله فيكم % % كأن كتاب الله فيهم ممجمج % 9(@)(@@) % ألا خاب من أنساه منكم نصيبه % % متاع من الدنيا قليل وزبرج % 10(@)(@@) % أبعد المكنى بالحسين شهيدكم % % تضيء مصابيح السماء فتسرج % PageV01P993 11(@)(@@) % شوى ما أصابت أسهم الدهر بعده % % هوى ما هوى أو مات بالرمل بحرج % 12(@)(@@) % لنا وعلينا ولا عليه ولا له % % تسحسح أسراب الدموع وتنشج % 13(@)(@@) % وكيف نبكي فائزا عند ربه % % له في جنان الخلد عيش مخرفج % 14(@)(@@) % وقد نال في الدنيا سناء وصيتة % وقام مقاما لم يقمه مزلج % 15(@)(@@) % فإن لا يكن حيا لدينا فإنه % % لدى الله حي في الجنان مزلج % 16(@)(@@) % وكنا نرجيه لكشف عماية % % بأمثاله أمثالها تتبلج % 17(@)(@@) % فساهمنا ذو العرش في ابن نبيه % % ففاز به والله أعلى وأفلج % 18(@)(@@) % مضى ومضى الفراط من أهل بيته % % يؤم بهم ورد المنية منهج % 19(@)(@@) % فأصبحت لا هم أبسؤوني بذكره % % كما قال قبلي في البسوء مؤرج % 20(@)(@@) % ولا هو نساني أساي عليهم % بلى هاجه والشجو للشجو أهيج % PageV01P994 21(@)(@@) % أبيت إذا نام الخلي كأنما % % تبطن أجفاني سيال وعوسج % 22(@)(@@) % أيحيى العلا لهفي لذكراك لهفة % يباشر مكواها الفؤاد فينضج % 23(@)(@@) % أحين تراءتك العيون جلاءها % % وإقذاءها أضحت مراثيك تنسج % 24 
ms264	(@)(@@) % بنفسي وإن فات الفداء بك الردى % % محاسنك اللائي تمح فتنهج % 25(@)(@@) % لمن تستجد الأرض بعدك زينة % فتصبح في أثوابها تتبرج % 26(@)(@@) % سلام وريحان وروح ورحمة % عليك وممدود من الظل سجسج % 27(@)(@@) % ولا برح القاع الذي أنت جاره % يرف عليه الأقحوان المفلج % 28(@)(@@) % ويا أسفي ألا ترد تحية % سوى أرج من طيب رمسك يأرج % 29(@)(@@) % ألا إنما ناح الحمائم بعدما % % ثويت وكانت قبل ذلك تهزج % 30(@)(@@) % أذم إليك العين إن دموعها % % تداعى بنار الحزن حين توهج % PageV01P995 31(@)(@@) % وأحمدها لو كفكفت من غروبها % % عليك وخلت لاعج الحزن يلعج % 32(@)(@@) % وليس البكا أن تسفح العين إنما % % أحر البكاءين البكاء المولج % 33(@)(@@) % أتمتعني عيني عليك بدمعة % % وأنت لأذيال الروامس مدرج % 34(@)(@@) % فإني إلى أن يدفن القلب داءه % % ليقتلني الداء الدفين لأحوج % 35(@)(@@) % عفاء على دار ظعنت لغيرها % % فليس بها للصالحين معرج % 36(@)(@@) % ألا أيها المستبشرون بيومه % % أظلت عليكم غمة لا تفرج % 37(@)(@@) % أكلكم أمسى اطمأن مهاده % % بأن رسول الله في القبر مزعج % 38(@)(@@) % فلا تشمتوا وليخسإ المرء منكم % % بوجه كأن اللون منه اليرندج % 39(@)(@@) % فلو شهد الهيجا بقلب أبيكم % % غداة التقى الجمعان والخيل تمعج % 40(@)(@@) % لأعطى يد العاني أو ارمد هاربا % كما ارمد بالقاع الظليم المهيج % PageV01P996 41(@)(@@) % ولكنه ما زال يغشى بنحره % % شبا الحرب حتى قال ذو الجهل أهوج % 42(@)(@@) % وحاشا له من تلكم غير أنه % % أبى خطة الأمر التي هي أسمج % 43(@)(@@) % وأين به عن ذاك لا أين إنه % % إليه بعرقيه الزكيين محرج % 44(@)(@@) % كأني به كالليث يحمي عرينه % % وأشباله لا يزدهيه المهجهج % 45(@)(@@) % يكر على أعدائه كر ثائر % ويطعنهم سلكى ولا يتخلج % 46(@)(@@) % كدأب علي في المواطن قبله % % أبي حسن والغصن من حيث يخرج % 47(@)(@@) % كأني أراه والرماح تنوشه % % شوارع كالأشطان تدلى وتخلج % 48(@)(@@) % كأني أراه إذ هوى عن جواده % % وعفر بالترب الجبين المشجج % % 49(@)(@@) % فحب به جسما إلى الأرض إذ هوى % % وحب به روحا إلى الله تعرج % 50(@)(@@) % أأرديتم يحيى ولم يطو أيطل % طرادا ولم يدبر من الخيل منسج % PageV01P997 51(@)(@@) % تأتت 
ms265	 لكم فيه منى السوء هينة % وذاك لكم بالغي أغرى وألهج % 52(@)(@@) % تمدون في طغيانكم وضلالكم % % ويستدرج المغرور منكم فيدرج % 53(@)(@@) % أجنوا بني العباس من شنآنكم % % وأوكوا على ما في العياب وأشرجوا % % 54(@)(@@) % وخلوا ولاة السوء منكم وغيهم % % فأحر بهم أن يغرقوا حيث لحجوا % % 55(@)(@@) % نظار لكم أن يرجع الحق راجع % إلى أهله يوما فتشجوا كما شجوا % % 56(@)(@@) % على حين لا عذرى لمعتذريكم % % ولا لكم من حجة الله مخرج % 57(@)(@@) % فلا تلقحوا الآن الضغائن بينكم % % وبينهم إن اللواقح تنتج % 58(@)(@@) % غررتم إذا صدقتم أن حالة % % تدوم لكم والدهر لونان أخرج % 59(@)(@@) % لعل لهم في منطوي الغيب ثائرا % سيسمو لكم والصبح في الليل مولج % 60(@)(@@) % بمجر تضيق الأرض من زفراته % % له زجل ينفي الوحوش وهزمج % PageV01P998 61(@)(@@) % إذا شيم بالأبصار أبرق بيضه % % بوارق لا يستطيعهن المحمج % 62(@)(@@) % توامضه شمس الضحى فكأنما % % يرى البحر في أعراضه يتموج % 63(@)(@@) % له وقدة بين السماء وبينه % تلم بها الطير العوافي فتهرج % 64(@)(@@) % إذا كر في أعراضه الطرف أعرضت % % حراج تحار العين فيها فتحرج % 65(@)(@@) % يؤيده ركنان ثبتان رجله % وخيل كأرسال الجراد وأوثج % 66(@)(@@) % عليها رجال كالليوث بسالة % بأمثالها يثنى الأبي فيعنج % 67(@)(@@) % تدانوا فما للنقع فيهم خصاصة % تنفسه عن خيلهم حين ترهج % 68(@)(@@) % فلو حصبتهم بالفضاء سحابة % % لظل عليهم حصبها يتدحرج % 69(@)(@@) % كأن الزجاج اللهذميات فيهم % فتيل بأطراف الرديني مسرج % 70(@)(@@) % يود الذي لاقوه أن سلاحه % % هنالك خلخال عليه ودملج % PageV01P999 71(@)(@@) % فيدرك ثأر الله أنصار دينه % % ولله أوس آخرون وخزرج % 72(@)(@@) % ويقضي إمام الحق فيكم قضاءه % % تماما وما كل الحوامل تخدج % 73(@)(@@) % وتظعن خوف السبي بعد إقامة % % ظعائن لم يضرب عليهن هودج % 74(@)(@@) % وقد كان في يحي مذمر خطة % وناتجها لو كان للأمر منتج % 75(@)(@@) % هنالكم يشفى تبيع جهلكم % % إذا ظلت الأعناق بالسيف تودج % 76(@)(@@) % محضتكم نصحي وإني بعدها % % لأعنق فيما ساءكم وأهملج % 77(@)(@@) % مه لا تعادوا غرة البغي بينكم % % كما يتعادى شعلة النار عرفج % 78(@)(@@) % أفي الحق أن يمسوا خماصا وأنتم % % يكاد أخوكم بطنة يتبعج % 79 
ms266	(@)(@@) % تمشون مختالين في حجراتكم % % ثقال الخطا أكفالكم تترجرج % 80(@)(@@) % وليدهم بادي الطوى ووليدكم % % من الريف ريان العظام خدلج % PageV01P1000 81(@)(@@) % تذودونهم عن حوضهم بسيوفكم % % ويشرع فيه أرتبيل وأبلج % 82(@)(@@) % فقد ألجمتهم خيفة القتل عنكم % % وبالقوم حاج في الحيازم حوج % 83(@)(@@) % بنفسي الألى كظتهم حسراتكم % % فقد علزوا قبل الممات وحشرجوا % % 84(@)(@@) % ولم تقنعوا حتى استثارت قبورهم % % كلابكم منها بهيم وديزج % 85(@)(@@) % وعيرتموهم بالسواد ولم يزل % % من العرب الأمحاض أخضر أدعج % 86(@)(@@) % ولكنكم زرق يزين وجوهكم % % بني الروم ألوان من الروم نعج % 87(@)(@@) % لئن لم تكن بالهاشميين عاهة % لما شكلكم تالله إلا المعلهج % 88(@)(@@) % بآية ألا يبرح المرء منكم % % يكب على حر الجبين فيعفج % 89(@)(@@) % يبيت إذا الصهباء روت مشاشه % % يساوره علج من الروم أعلج % 90(@)(@@) % فيطعنه في سبة السوء طعنة % يقوم لها من تحته وهو أفحج % PageV01P1001 91(@)(@@) % لذاك بني العباس يصبر مثلكم % % ويصبر للموت الكمي المدجج % 92(@)(@@) % فهل عاهة إلا كهذي وإنكم % % لأكذب مسؤول عن الحق ينهج % 93(@)(@@) % فلا تجلسوا وسط المجالس حسرا % ولا تركبوا إلا ركائب تحدج % 94(@)(@@) % أبى الله إلا أن يطيبوا وتخبثوا % % وأن يسبقوا بالصالحات وتفلجوا % % 95(@)(@@) % وإن كنتم منهم وكان أبوكم % % أباهم فإن الصفو بالرنق يمزج % 96(@)(@@) % أروني امرأ منهم يزن بأبنة % ولا تنطقوا البهتان فالحق أبلج % 97(@)(@@) % لعمري لقد أغرى القلوب ابن طاهر % % ببغضائكم ما دامت الريح تنأج % 98(@)(@@) % سعى لكم مسعاة سوء ذميمة % سعى مثلها مستكره الرجل أعرج % 99(@)(@@) % فلن تعدموا ما حنت النيب فتنة % تحش كما حش الحريق المؤجج % 100(@)(@@) % وقد بدأت لو تزجرون بريحها % % بوائجها من كل أوب تبوج % PageV01P1002 101(@)(@@) % بني مصعب ما للنبي وأهله % % عدو سواكم أفصحوا أو فلجلجوا % % 102(@)(@@) % دماء بني عباسكم وعليهم % لكم كدماء الترك والروم تهرج % 103(@)(@@) % يلي سفكها العوران والعرج منكم % % وغوغاؤكم جهلا بذلك تبهج % 104(@)(@@) % وما بكم أن تنصروا أوليائكم % % ولكن هنات في القلوب تنجنج % 105(@)(@@) % ولو أمكنتكم في الفريقين فرصة % لقد بينت أشياء تلوى وتحنج % 106(@)(@@) % إذن لاستقدتم منهما وتر فارس % وإن ولياكم فالوشائج أوشج % 107(@)(@@) % أبى 
ms267	 أن تحبوهم يد الدهر ذكركم % % ليالي لا ينفك منكم متوج % 108(@)(@@) % وإني على الإسلام منكم لخائف % بوائق شتى بابها الآن مرتج % 109(@)(@@) % وفي الحزم أن يستدرك الناس أمركم % % وحبلهم مستحكم العقد مدمج % 110(@)(@@) % نظار فإن الله طالب وتره % % بني مصعب لن يسبق الله مدلج % PageV01P1003 111(@)(@@) % لعل قلوبا قد أطلتم غليلها % % ستظفر منكم بالشفاء فتثلج % PageV01P1004 البحر : - 1(@)(@@) % بني المشرف جذ الله دابركم % % ما ضر معقبكم لو أنه درجا % % PageV01P1005 البحر : - 1(@)(@@) % ولحية لو شاء ذو المعارج % أغنى بها كواسد النواسج % % 2(@)(@@) % بنسج مسحين لخان الديزج % وفرق الباقي على الكواسج % PageV01P1006 البحر : - 1(@)(@@) % يا قمرا فوق رأسه تاج % يخجل من حسن لونه العاج % 2(@)(@@) % إذا تمشى يكاد يجذبه % % ردف له كالكثيب رجراج % 3(@)(@@) % كأنما في جيوبه قمر % % وفي السراويل منه أمواج % 4(@)(@@) % إن كنت عني ممتعا بغنى % فإن فقري إليك محتاج % PageV01P1007 البحر : - 1(@)(@@) % يا ويح من أصبح في غمة % ليس له من كربها مخرج % 2(@)(@@) % فروحه تزعج عن جسمه % % وجسمه عن بيته يزعج % PageV01P1008 البحر : - 1(@)(@@) % إن اللسان الذي نسجت به % % مدحك يسطيع نقض ما نسجا % % 2(@)(@@) % لكنني غير جاعل حسني % % وإن شجتني إساءة سمجا % % 3(@)(@@) % هماي همان لست متبعا % أولاهما بالخنا إذا اعتلجا % % 4(@)(@@) % وما الذي يؤمن المسيء إلى ال % % محسن من جهله إذا حرجا % % 5(@)(@@) % آثرت فيك النسيم من عتر ال % % مسك فلا تجعلنه هرجا % % PageV01P1009 البحر : - 1(@)(@@) % وقينة أبرد من ثلجه % % تظل منها النفس في ضجه % 2(@)(@@) % ما أكذب المطنب في وصفها % % لا صدق الله له لهجه % 3(@)(@@) % فظيعة فالحلق في سكتة % وبطنها القرقار في رجه % 4(@)(@@) % خالصة النتن ولكنها % % في ريقها من سلحها مجه % 5(@)(@@) % كأنها في نتنها ثومة % لكنها في اللون اترجه % 6(@)(@@) % تبدو بوجه قحل يابس % % قد نزعت من صحنه البهجه % 7(@)(@@) % ذات فم أخطأ من كلبة % % ومضرط أوقع من قبجه % 8(@)(@@) % تفاوتت خلقتها فاغتدت % لكل من عطل محتجه % 9(@)(@@) % لا تلكم الأوصال مهتزة % كلا ولا الأرداف مرتجه % 10(@)(@@) % ما جن من عشق فؤاد بها % % كلا ولا ذابت بها مهجه 
ms268	 % PageV01P1010 11(@)(@@) % رسم محيل بان سكانه % % فما على أمثاله عرجه % 12(@)(@@) % قد كتبت في بدن ناحل % أسماء من لاعبها . . . % 13(@)(@@) % كأنها والوشم في جلدها % % زرنيخة شيبت بنيلنجه % % 14(@)(@@) % ما لامرىء أظهر وجدا بها % % عذر لدى الناس ولا حجه % % 15(@)(@@) % تروح للفسق فإن عوتبت % % أعتبت لللائم بالدلجه % % 16(@)(@@) % خراجة للفسق دخالة % % تعجبها الدخلة والخرجه % PageV01P1011 البحر : - 1(@)(@@) % إن الدمشقي عبد حاجته % % وعبد من يرتجي لحاجته % 2(@)(@@) % يبرم إخوانه بزوجته % % في كحل يوم وبإدلاجته % 3(@)(@@) % حتى إذا ما قضى لبانته % % من حاجة غاب في عجاجته % 4(@)(@@) % وانصاع إما إلى غضارته % % مسارعا أو إلى زجاجته % 5(@)(@@) % يخلد في اللحم والثريد وفي % % ما مجه الكوب من مجاجته % 6(@)(@@) % أصبح قد لج في مهاجرتي % % لا فكه الله من لجاجته % 7(@)(@@) % لا يذكر الخل عند ذلك في % % ضغطة دهر ولا انفراجته % 8(@)(@@) % تبارك الله كيف خفته % % إذا تشاحى على فجاجته % 9(@)(@@) % فقد رأى القلب من نذالته % % ما رأت العين من سماجته % 10(@)(@@) % ثمت يأوي إلى حليلته % % كالديك يأوي إلى دجاجته % PageV01P1012 11(@)(@@) % شقاق ساج يبيت ليلته % % منشاره في مشق ساجته % % 12(@)(@@) % ثم انتحى ينسج القريض وما % % نساجة الشعر من نساجته % PageV01P1013 البحر : - 1(@)(@@) % لأنت شين القيان يا غنجه % ذميمة القد في الورى سمجه % 2(@)(@@) % رأيت كل القيان تألفني % % وأنت عني أراك منعرجه % PageV01P1014 البحر : - 1(@)(@@) % ومجرد كالسيف جرد نفسه % % لمجرد يكسوه ما لا ينسج % 2(@)(@@) % ثوب تمزقه الأنامل رقة % ويذيبه الماء القراح فينهج % % 3(@)(@@) % فكأنه لما استوى في خصره % % نصفان ذا عاج وذا فيروزج % % PageV01P1015 البحر : - 1(@)(@@) % شعرات في الرأس بيض ودعج % حل رأسي جيلان روم وزنج % 2(@)(@@) % طار عن هامتي غراب شباب % % وعلاه مكانه شاهمرج % 3(@)(@@) % حل في صحن هامتي منه لونا % % ن كما حل رقعة شطرنج % 4(@)(@@) % أيها الشيب لم حللت برأسي % % إنما لي عشر وعشر وبنج % PageV01P1016 البحر : - 1(@)(@@) % أما الزمان إلى سلمى فقد جنحا % % وعاد معتذرا من كل ما اجترحا % % 2(@)(@@) % وليس ذاك بصنعي بل بصنع فتى % % ما زال يدني بلطف الصنع ما نزحا % % 3(@)(@@) % مبارك الوجه ميمون نقيبته 
ms269	 % % يوري الزناد بكفيه إذا قدحا % % 4(@)(@@) % به غدوت على الأيام مقتدرا % فقد صفحت عن الأيام أن صفحا % % 5(@)(@@) % رفعت منه رفيع الذكر ممتدحا % ألفى أباه رفيع الذكر ممتدحا % % 6(@)(@@) % معطى لسان فم معطى لسان يد % % إن أجملا فصلا أو فسرا شرحا % % 7(@)(@@) % لو أن عبد الحميد اليوم شاهده % % لطان بين يديه مذعنا وسحا % % 8(@)(@@) % ضربت شعري عن الكتاب قاطبة % صفحا إليه ومثلي نحوه جنحا % % 9(@)(@@) % إياه كانت تراعي همتي وله % % كانت تصون أديم الوجه والمدحا % % 10(@)(@@) % أتأرت عيني سواد الناس كلهم % فما رأيت سواه فيهم وضحا % % PageV01P1017 11(@)(@@) % يفدي أبا الصقر إن قاموا بفديته % % قوم إذا مذقوا أفعالهم صرحا % % 12(@)(@@) % فرع تفرع من شيبان شاهقة % من ساورتها أماني نفسه نجحا % % 13(@)(@@) % واهتز في نبعة صماء ما عرفت % % سهلا ولا رئمت سيلا وإن طفحا % % 14(@)(@@) % لا تشرب الماء إلا من ذؤابتها % % إذا الغمام عليها من عل نضحا % % 15(@)(@@) % فات المذاكي في بدء وفي عقب % سبقا إلى الغاية القصوى وما قرحا % % 16(@)(@@) % فتى إذا شئت لا جهلا ولا سفها % كهلا إذا شئت لا شيبا ولا جلحا % % 17(@)(@@) % فتاه شرخ شبابي وكهله % % حلم إذ شال حلم ناقص رجحا % % 18(@)(@@) % في وجهه روضة للحسن مونقة % ما راد في مثلها طرف ولا سرحا % % 19(@)(@@) % طل الحياء عليها واقع أبدا % كاللؤلؤ الرطب لو رقرقته سفحا % % 20(@)(@@) % وجه إذا ما بدت للناس سنته % كانت محاسنه حولا لهم سبحا % % PageV01P1018 21(@)(@@) % أنا الزعيم لمكحول بغرته % % ألا يرى بعدها بؤسا ولا ترحا % % 22(@)(@@) % ممن إذا ما تعاطى نيل مكرمة % % نالت يداه منال الطرف ما طمحا % % 23(@)(@@) % لو يخطب الشمس لم ترغب ببهجتها % % عن خير من خطب الأزواج أو نكحا % % 24(@)(@@) % مهما أتى الناس من طول ومن كرم % % فإنما دخلوا الباب الذي فتحا % % 25(@)(@@) % لاقى الرجال غبوق المجد فاغتبقوا % % منه ولاقى صبوح المجد فاصطبحا % % 26(@)(@@) % خرق به نشوة من أريحيته % % هيهات من منتشيها أن يقال صحا % % 27(@)(@@) % يعطي المزاح ويعطي الجد حقهما % % فالموت إن جد والمعروف إن مزحا % % 28(@)(@@) % ممن إذا كان 
ms270	 لاحي البخل يعذره % % فما يبالي بلاحي الجود كيف لحى % % 29(@)(@@) % إن قال لا قالها للآمرين بها % % ولم يقلها لمن يستمنح المنحا % % 30(@)(@@) % يا بعد معناه من معنى اللئام إذا % % شحوا بلفظة لاأفواههم وشحا % % PageV01P1019 31(@)(@@) % لو لم يزد في بسيط الأرض نائله % % لضاق منها علينا كل ما انفسحا % % 32(@)(@@) % أضحت بجدواه أرض الله واسعة % أضعاف ما مد منها ربها ودحا % % 33(@)(@@) % فلاقحات الأماني قد نتجن به % % وحائلات الأماني قد طوت لقحا % % 34(@)(@@) % لو أن أفعاله الحسنى غدت شية % للمجد ما عدت التحجيل والقرحا % % 35(@)(@@) % لا تحمدن بليغا في مدائحه % % أفعاله فسحت في مدحه الفسحا % % 36(@)(@@) % ولو تجاوزه المداح لم يجدوا % % في الأرض عنه ولا في القول منتدحا % % 37(@)(@@) % بزر جمهر بني العباس رستمهم % % جلمود خطبين ما صكوا به رضحا % % 38(@)(@@) % ماضي الأداتين من سيف ومن قلم % % كبش الكتابة كبش الحرب إن نطحا % % 39(@)(@@) % وافى عطارد والمريخ مولده % % فأعطياه من الحظين ما اقترحا % % 40(@)(@@) % له من البأس حد لو أشار به % % إلى الحديد على علاته فلحا % % PageV01P1020 41(@)(@@) % ويمن رأي ورفق لو مشى بهما % % بين الأنيس وبين الجنة اصطلحا % % 42(@)(@@) % في كفه قلم ناهيك من قلم % % نبلا وناهيك من كف بها اتشحا % % 43(@)(@@) % يمحو ويثبت أرزاق العباد به % % فما المقادير إلا ما وحى ومحا % % 44(@)(@@) % كأنما القلم العلوي في يده % % يجريه في أي أنحاء الأمور نحا % % 45(@)(@@) % هذا وإن جمحت هيجاء أقمحها % % نكلا من الشر ما يكبح به انكبحا % % 46(@)(@@) % يغشى الوغى فترى قوسا ونابلها % % إذ لا تزال ترى قوسا ولا قزحا % % 47(@)(@@) % ذو رميتين مفداتين واحدة % % تصمي الرمايا وأخرى توصل المنحا % % 48(@)(@@) % يغلغل النبل في الدرع التي رتقت % % رتقا فلو صب فيها الماء ما رشحا % % 49(@)(@@) % ويطعن الطعنة النجلاء يتبعها % % شخب درير إذا لاقى الحصى ضرحا % % 50(@)(@@) % ويضرب الهام ضربا لا كفاء له % % ترى لما طار منه موقعا طرحا % % PageV01P1021 51(@)(@@) % لمثل ذلك في الهيجاء من عمل % % أنحى على الأدوات القين واجتنحا % % 52(@)(@@) % يصول منه بمن عادى خليقته % % ورد السيال ترى في لونه 
ms271	 صبحا % % 53(@)(@@) % ليث إذا زأر الليث الهزبر له % % لم يحسب الليث إلا ثعلبا ضبحا % % 54(@)(@@) % عادى فبادى العدا فيه عداوته % % ولم يخافت بها نجواه بل صدحا % % 55(@)(@@) % وقال إذ قعقعوا شن الوعيد له % % لن يرهب الليث ضأنا قعقعت وذحا % % 56(@)(@@) % يا من إذا ضاقت الأعطان في هنة % % زادت شدائدها أعطانه فيحا % % 57(@)(@@) % ليهن الملك أن أصلحت فاسده % % وأن حرست من الإفساد ما صلحا % % 58(@)(@@) % رددته جعفري الرأي بعد هوى % % في الواثقية لو لم تثنه جمحا % % 59(@)(@@) % بيارشوخ وفتيان لهم قدم % فيمن وفى لمواليه ومن نصحا % % 60(@)(@@) % يا رب رأي صواب قد فتحت لهم % % لولاك يا فاتح الأبواب ما انفتحا % % PageV01P1022 61(@)(@@) % ولم تزل معهم في يوم وقعتهم % % بالحائنين وناب الحرب قد كلحا % % 62(@)(@@) % حتى أدلتم وهبت ريح نصركم % وخاب وجه عدو الحق وافتضحا % % 63(@)(@@) % وما بغيتم ولكن كنتم فئة % سقيتم من بغى الكأس التي جدحا % % 64(@)(@@) % شهدت أن عظيم الترك يومئذ % بيمنك افتتح الفتح الذي فتحا % % 65(@)(@@) % ما كان إلا كسهم سددته يد % فما تلعثم ذاك السهم أن ذبحا % % 66(@)(@@) % بصرته رشده في نصر سادته % % بضوء رأيك حتى بان فاتضحا % % 67(@)(@@) % فليشكروا لك أن كابدت دونهم % تلك الغمار التي تودي بمن سبحا % % 68(@)(@@) % نصرتهم بلسان صادق ويد % قولا وصولا ولقيت العدا ترحا % % 69(@)(@@) % حتى أفأت عليهم ظل نعمتهم % % عودا كما فاء ظل بعدما مصحا % % 70(@)(@@) % ببعض حقك أن أصبحت عندهم % % مشاورا في جسيم الأمر منتصحا % % PageV01P1023 71(@)(@@) % أنت الذي رد بعد الله دولتهم % % فليوف كادح صدق أجر ما كدحا % % 72(@)(@@) % لولاك ما قام قطب في مركبه % أخرى الليالي ولا دارت عليه رحى % % 73(@)(@@) % بك استقادت مطايا الملك مذعنة % وأردف الصعب منها بعدما رمحا % % 74(@)(@@) % نفسي فداؤك يا من لا مؤمله % % أكدى ولا مستظل في ذراه ضحا % % 75(@)(@@) % لولاك أصبح في بدو وفي حضر % ديوان أهلك بين الناس مطرحا % % 76(@)(@@) % أضحى بك الشعر حيا بعد ميتته % إلا حشاشة نفس علقت شبحا % % 77(@)(@@) % لا يسلب الله نعمى أنت لابسها % % فما مشيت بها في أرضه 
ms272	 مرحا % % 78(@)(@@) % كم كاشح لك لا تجدي عداوته % % عليه ما عاش إلا الورى والكشحا % % 79(@)(@@) % ممن ينافس في العلياء صاحبها % % ولو تحمل أدنى ثقلها دلحا % % 80(@)(@@) % تعشي بضوئك عينيه فينبحه % لينبح الكلب ضوء البدر ما نبحا % % PageV01P1024 81(@)(@@) % لما تبسم عنك المجد قلت له % % قهقه فلا ثعلا تبدي ولا قلحا % % 82(@)(@@) % أجراك مجر فما أخزيت حلبته % % بل وجه أي جواد سابق سبحا % % 83(@)(@@) % قال الإمام وقد درت حلوبته % % بمثلك استغزر المستغزر اللقحا % % 84(@)(@@) % أتاك راجيك لا كف له مرنت % % على السؤال ولا وجه له وقحا % % 85(@)(@@) % على قعود صحيح الظهر تامكه % ما كل من طول ترحال ولا طلحا % % 86(@)(@@) % فانظر إليه بعين طالما ضرحت % عنها قذى خلة المختل فانضرحا % % 87(@)(@@) % فما يجلي الذي تكنى به قنصا % كما تجلي ابن حاجات إذا سنحا % % 88(@)(@@) % بل طرف عينيك أذكى حين تثقبه % للمجد من طرف عينيه إذا لمحا % % 89(@)(@@) % بك افتتحت ونفسي جد واثقة % ألا أقول بغب ساء مفتتحا % % 90(@)(@@) % أمطر نداك جنابي يكسه زهرا % أنت المحيا برياه إذا نفحا % % PageV01P1025 91(@)(@@) % إن أنت أنهضت حالي بعدما رزحت % فأنت أنهضت ملكا بعدما رزحا % % 92(@)(@@) % لا بدع أن تنهض الرزحى وتنعشهم % وان تحمل عنهم كل ما فدحا % % 93(@)(@@) % كأنني بك قد خولتني أملي % % وأنت جذلان مملوء به فرحا % % 94(@)(@@) % أثني عليك بنعماك التي عظمت % % وقد وجدت بها في القول منفسحا % % 95(@)(@@) % أقول فيما أجيب السائلين به % % أيان ذلك والبرهان قد وضحا % % 96(@)(@@) % لاقيت أكرم من خب المطي به % % ومن مشى فوق ظهر الأرض مذ سطحاص لاقيت من لا أبالي بعده أبدا % 97(@)(@@) % من ضن عني بمعروف ومن سمحا % % ألقيت سجلي منه إذ متحت به % % 98(@)(@@) % إلى كريم يروي سجل من متحا % % فاضت يداه إلى أن خلت سيبتها % % 99(@)(@@) % بحرين جاشا لحين المد فانتطحا % % وجاد جودين أما الكف فانبسطت % % 100(@)(@@) % بما أنال وأما الصدر فانشرحا % % ورب معط إذا جادت أنامله % % PageV01P1026 101(@)(@@) % ضن الضمير بما أعطى وما منحا % % عفى كلوم زماني ثم قلمه % % 102(@)(@@) % عني فاحفاه ثم اقتص 
ms273	 ما جرحا % % وما تصامم عني إذ هتفت به % % 103(@)(@@) % كالناظرين بصوت الهاتف البححا % % يا عائف الطير من طلاب نائله % % 104(@)(@@) % لا يثنينك عنه بارح برحا % % عف الثناء الذي تثني عليه به % % 105(@)(@@) % ولا تعف باكرات الطير والروحا % % فإن قصرك أن تلقى بعقوته % % 106(@)(@@) % بحرا من العرف لا كدرا ولا نزحا % % إذا الونى قيد الحسرى وعقلها % % 107(@)(@@) % نسيت هناك حياءها وخلاقها % % شبقا وعند الماح ينسى الداح % % 107(@)(@@) % فيممته استفادت في الخطا روحا % % 107(@)(@@) % إذا تعاصت قينة مرة % فلا تجشمها بتفاحه % 107(@)(@@) % لكن بدستنبوية ضخمة % % لقلبها في غمزها راحه % % PageV01P1027 107(@)(@@) % فإنها تذعن في لحظة % % معتزة للنيك مرتاحة % 107(@)(@@) % فإنها يفك القفل عن كعثب % كرؤية الحسناء مفتاحه % % 107(@)(@@) % كامل تتجمل الحسناء كل تجمل % حتى إذا ما أبرز المفتاح % PageV01P1028 البحر : - 1(@)(@@) % نظرت في وجوه شعري وجوه % أوسعت قبل خلقها تقبيحا % % 2(@)(@@) % فغدت وهي زاريات عليه % % والذي أنكرته منها أتيحا % % 3(@)(@@) % أبصرت في صقاله صورا من % % ه قباحا فأظهرت تكليحا % % 4(@)(@@) % شهد الله أنها عند ذاكم % % أعنتت سالما وعرت صحيحا % % 5(@)(@@) % عاينت فيه قبحها فاجتوته % % ظالمات هناك ظلما صريحا % % 6(@)(@@) % ورأته وجوه قوم وضاء % فرأت وجهه وضيئا صبيحا % 7(@)(@@) % هكذا المنظر الصقيل يؤدي % % ما يوازي به بليغا فصيحا % 8(@)(@@) % والمرايا تري الجميل جميلا % وكذاكم تري القبيح قبيحا % % 9(@)(@@) % هاكها يا سعيد غراء عذرا % % ء تداوي بها الفؤاد القريحا % % 10(@)(@@) % مثلا للعقول تضعف والشع % ر يصفى فلا تراه قليحا % % PageV01P1029 البحر : - 1(@)(@@) % قدمت لي وعدا فأين نجاحه % قد حان يا بن الأكرمين سراحه % 2(@)(@@) % لا يعجبنك حسن ما قدمته % % فتسيء بعد إساءة تجتاحه % 3(@)(@@) % واعلم بأنك إن فترت عن الذي % % أسلفت من عرف خبا مصباحه % 4(@)(@@) % ليس الجواد بمن يجود غدوه % حتى يجود غدوه ورواحه % 5(@)(@@) % ويطول بين السائلين بقاؤه % % وكأن خاتم وجوده مفتاحه % 6(@)(@@) % لا يستحيل ولا يغير عهده % % إمساؤه أبدا ولا إصباحه % 7(@)(@@) % ماذا أجيب به التي عودتها % % عادات نائلك الذي تمتاحه % 8(@)(@@) % أأقول ويحك حال بعدك بخله % % أم حال بعدك جوده وسماحه % PageV01P1030 البحر : - 1 
ms274	(@)(@@) % أعاذل إن شرب الراح رشد % لأن الراح تأمر بالسماح % 2(@)(@@) % تقينا شح أنفسنا وذاكم % % إذا ذكر الفلاح من الفلاح % PageV01P1031 البحر : - 1(@)(@@) % لولا عبيد الله قل % ت ولم أخف رهق الجناح % 2(@)(@@) % يا مادح القوم اللئا % % م وطالبا نيل الشحاح % 3(@)(@@) % ما أنت في زمن المدي % % ح ولا الهجاء ولا السماح % 4(@)(@@) % حدثت أكف ليس ين % % بط ماءها إلا المساحي % % 5(@)(@@) % وجلود قوم ليس تأ % % لم غير أطراف الرماح % 6(@)(@@) % ما شئت من مال حمى % يأوي إلى عرض مباح % 7(@)(@@) % فاشغل قريضك بالنسي % % ب وبالفكاهة والمزاح % PageV01P1032 البحر : - 1(@)(@@) % يا ذا الذي لو هجاه مادحه % % عوقب هلا يثاب بالمدح % 2(@)(@@) % تعتده بهرج المديح ولا % % تعتده هاجيا كممتدح % % 3(@)(@@) % مطرح الشعر في مدائحه % % وفي الأهاجي غير مطرح % 4(@)(@@) % كلا ولكنها يد خلقت % % للنكر لا للعارفات والمنح % PageV01P1033 البحر : - 1(@)(@@) % إذا ساء ظن بمسترفد % أطال القصيد له المادح % 2(@)(@@) % وقدما إذا استبعد المستقى % % أطال الرشاء له الماتح % PageV01P1034 البحر : - 1(@)(@@) % تجنب سليمان قفل الندى % % فقد يئس الناس من فتحه % 2(@)(@@) % ولو كان يملك أمر استه % % لما طمع الحش في سلحه % % PageV01P1035 البحر : - 1(@)(@@) % لما رأيت الشعر أصبح خاملا % نبهته بفتى أعر صريح % 2(@)(@@) % لم أمتدحه لخلة أبصرتها % % في مجده فسددتها بمديح % 3(@)(@@) % تفيء الأيور على أهلها % % من الغنم ما لا تفيء الرماح % 4(@)(@@) % بعينيك فرسانها الذائدو % % ن عن بيضة الملك لا تستباح % 5(@)(@@) % جياعا نياعا ذوي فاقة % % يباع لهم بالبتات السلاح % 6(@)(@@) % وأنت ابن خل وراقوده % % إلى بابك المفتدى والمراح % PageV01P1036 البحر : - 1(@)(@@) % تأدب كي يقال فتى أديب % % لتحصر عنه ألسنة المديح % % 2(@)(@@) % لقد حفظ الفتى ما في يديه % % بغاية حيلة اللحز الشحيح % PageV01P1037 البحر : - 1(@)(@@) % لي لسان ما زال يطريك في النث % % ر وفي النظم غير ما مستريح % 2(@)(@@) % وارتكاب الديون إياي في ظل % لك يهجوك باللسان الفصيح % 3(@)(@@) % والعقاب الجميل منك على ذا % % ك حقيق دون العقاب القبيح % 4(@)(@@) % وهو ألا يراني الناس إلا % % في محل من اليسار فسيح % 5(@)(@@) % ليت شعري إن لم يزح علتي جو 
ms275	 % % دك والحظ هل لها من مزيح % 6(@)(@@) % إن من جورك المبرح بالمن % نة والصبر أيما تبريح % % 7(@)(@@) % أن ترى العرف عند مثلي نكرا % وأرى المدح فيك كالتسبيح % PageV01P1038 البحر : - 1(@)(@@) % إذا ما مدحت أبا صالح % % فأعدد له الشتم قبل المديح % 2(@)(@@) % فإني ضميتك عن لؤمه % % ببخل عتيد ورد قبيح % 3(@)(@@) % وأنى يجود ولا عرقه % % كريم ولا وجهه بالصبيح % PageV01P1039 البحر : - 1(@)(@@) % عقيد الندى أطلق مدائح جمة % % حبائس عندي قد أتى أن تسرحا % % 2(@)(@@) % ولم احتبسها إذ حبست مثوبتي % % لأن مديحا لم يجد بعد ممدحا % % 3(@)(@@) % ولا أن بيتا في قريضي مثبجا % أخاف لدى الإنشاد أن يتصفحا % % 4(@)(@@) % وما كان فيما قلت زيغ علمته % % فأرجأته حتى يقام ويصلحا % % 5(@)(@@) % ولكن لي نفس عليك شفيقة % % تحاذر وجدان العدا فيك مقدحا % % 6(@)(@@) % إذا استشهدت ألحاظهم عند منشدي % % شواهد وجد إن تعاجمت أفصحا % % 7(@)(@@) % فأدي إليهم كل ما قد علمته % % رواء إذا ورى لساني صرحا % % 8(@)(@@) % هنالك ينحي الحاسدون شفارهم % % لعرض مناهم أن يروا فيه مجرحا % % 9(@)(@@) % فتلحى لعمري في ثواب لويته % % وأنت امرؤ في الجود يلحاك من لحا % % 10(@)(@@) % وكنت متى ينشد مديح ظلمته % % يكن لك أهجى كلما كان أمدحا % % PageV01P1040 11(@)(@@) % إذا أحسن المدح امرؤ كان حسنه % % للابسه قبحا إذا هو أقبحا % % 12(@)(@@) % ومبتسم للمدح في ذي مروءة % % فلما درى أن لم يثوبه كلحا % % 13(@)(@@) % رأى حسنا لاقاه جاز بسيء % فهلل إكبارا لذاك وسبحا % % 14(@)(@@) % غششتك إن أنشدت مدحيك عاطلا % وعرضتك اللوم ممسى ومصبحا % % 15(@)(@@) % ولست براض أن أراه مطوقا % من العرف طوقا أو أراه موشحا % % 16(@)(@@) % لأبهج ذا ود وأكبت حاسدا % مسوءا بما تسدي وأهدي مترحا % % 17(@)(@@) % وأدفع لؤما طالما قد دفعته % % بجهدي فأمسى عن حراك مزحزحا % % 18(@)(@@) % مودة نفس شبتها بنصيحة % وأنت حقيق أن تود وتنصحا % % 19(@)(@@) % وإن كنت ألقى ما لديك ممنعا % ويلقاه أقوام سواي ممتحا % % 20(@)(@@) % فيا أيها الغيث الذي امتد ظله % % رواقا على الدنيا وصاب فسحسحا % % PageV01P1041 21(@)(@@) % ويا أيها المرعى الذي اهتز نبته % % وبكر فيه خصبه وتروحا % % 22(@)(@@) % عذرتك لو 
ms276	 كانت سماء تقشعت % سحائبها أو كان روض تصوحا % % 23(@)(@@) % ولكنها سقيا حرمت رويها % % وعارضها ملق كلاكل جنحا % % 24(@)(@@) % وأكلاء معروف حميت مريعها % % وقد عاد منها السهل والحزن مسرحا % % 25(@)(@@) % عرضت لأذوادي وبحرك زاخر % % فلما أردن الورد ألقين ضحضحا % % 26(@)(@@) % فلو لم ترد أذواد غيري غماره % % لقلت سراب بالمتان توضحا % % 27(@)(@@) % فيا لك بحرا لم أجد فيه مشربا % وإن كان غيري واجدا فيه مسبحا % % 28(@)(@@) % سأفخر إذ أعطاني الله مفخرا % وأبجح إذ أعطاني الله مبجحا % % 29(@)(@@) % مديحي عصا موسى وذلك أنني % % ضربت به بحر الندى فتضحضحا % % 30(@)(@@) % فيا ليت شعري إن ضربت به الصفا % % أيبعث لي منه جداول سيحا % % PageV01P1042 31(@)(@@) % كتلك التي أبدت ثرى البحر يابسا % وشقت عيونا في الحجارة سفحا % % 32(@)(@@) % سأمدح بعض الباخلين لعله % % إن اطرد المقياس أن يتسمحا % % 33(@)(@@) % ملكت فأسجح يا أبا الصقر إنه % % إذا ملك الأحرار مثلك أسجحا % % 34(@)(@@) % تقبل مديحي بالندى متقبلا % أو اطرحه بالمنع المبين مطرحا % % 35(@)(@@) % فما حق من أطراك ألا تثيبه % % إياسا ولا يأسا إذا كان أروحا % % 36(@)(@@) % ألم ترني جمت عليك قريحتي % % وكان عجيبا أن أجم وتنزحا % % 37(@)(@@) % فآونة أكسوك وشيا محبرا % % وآونة أكسوك ريطا مسيحا % % 38(@)(@@) % محضتك مدحا أنت أهل لمحضه % % وإن كان أضحى بالعتاب مضيحا % % 39(@)(@@) % وهبني لم أبلغ من المدح مبلغا % رضيا ألم أكدح لذلك مكدحا % % 40(@)(@@) % بلى واجتهاد المرء يوجب حقه % % وإن أخطأ القصد الذي نحوه نحا % % PageV01P1043 41(@)(@@) % أتاك شفيعي واسمه قد علمته % % لترجعه يدعى به وبأفلحا % % PageV01P1044 البحر : - 1(@)(@@) % ومونقة الرواد مهتزة الربا % % يحاسنها سار وغاد ورائح % 2(@)(@@) % توقد فيها كلما تلع الضحى % % مصابيح تذكو حين تخبو المصابح % 3(@)(@@) % تضاحك نواراتها زهراتها % % لها أرج في نافح العطر نافح % 4(@)(@@) % إذا مدها المهموم في صعدائه % % إلى قلبه انساحت عليه الجوانح % 5(@)(@@) % زجرت ثناء الناس ثم انتجعته % % ولم يتخالجني سنيح وبارح % PageV01P1045 البحر : - 1(@)(@@) % غصن من البان في وشاح % ركب في مغرس رداح % 2(@)(@@) % يهتز طوعا لغير ريح % % والغصن يهتز للرياح % 3(@)(@@) % غصن ولكنه فتاة % % بديعة الشكل في الملاح % % 4 
ms277	(@)(@@) % زينت بوجه عليه فرع % % يحكي ظلاما على صباح % 5(@)(@@) % ينفسح الطرف حين تبدو % % غرته أيما انفساح % 6(@)(@@) % يا حسن خد لها رقيق % يكاد يدمى بلا جراح % 7(@)(@@) % ترنو بطرف لها مريض % % بين جفون لها صحاح % 8(@)(@@) % لم يذكرها المحب إلا % % طار اشتياقا بلا جناح % 9(@)(@@) % مثلهما آخذي نصيب % من الفكاهات والمزاح % % 10(@)(@@) % في عض خد ولثم ثغر % ورشف ريق وشرب راح % % PageV01P1046 11(@)(@@) % بلا نفار ولا نقار % ولا ضرار ولا تلاحي % % 12(@)(@@) % ولا لجاج ولا ضجاج % ولا حران ولا جماح % 13(@)(@@) % ذوي سرور ذوي حبور % ذوي نشاط ذوي مراح % 14(@)(@@) % بحيث لا لغو فيه إلا % % غناء طير به فصاح % 15(@)(@@) % طير تغني إذا تغنت % % مهما أراد بلا اقتراح % 16(@)(@@) % محل صدق يحل فيه % % أهل السعادات والفلاح % 17(@)(@@) % طاب فما يبرحان منه % % ولا يريدان من براح % 18(@)(@@) % يا حسن قول الفتاة حبى % % أنجحت أقصى مدى النجاح % 19(@)(@@) % تفعل ما تشتهي هنيئا % ليس على الصب من جناح % 20(@)(@@) % حقك أن تستبيح مني % % ما ليس مني بمستباح % PageV01P1047 21(@)(@@) % ما زلت لا تستريح حتى % % حللت في خير مستراح % 22(@)(@@) % أنت الذي كان في طلابي % % أخا غدو أخا رواح % 23(@)(@@) % أنت الذي كان في طلابي % % معرض النحر للرماح % 24(@)(@@) % كم من سلاح حملت حتى % % سبيت قلبي بلا سلاح % PageV01P1048 البحر : - 1(@)(@@) % نصحت أبا بكر فرد نصيحتي % % وقال صه وجه المحرش أقبح % 2(@)(@@) % وحدثته عن أخته فصدقته % % وأمحض نصح الناصحين المصرح % 3(@)(@@) % فقال عذيري منك شيخا مكلفا % % أنبخل يا هذا وأختي تسمح % 4(@)(@@) % لها أجرها إن أحسنت فلنفسها % % وميزانها يوم القيامة يرجح % 5(@)(@@) % أتعجب من أنثى تناك بحقها % % وهأنذا شيخ أكب لإأنكح % 6(@)(@@) % فقلت له حسبي لها بك قدوة % أقلني فإني إنما كنت أمزح % 7(@)(@@) % فذلك أغراه بهجري ولن ترى % % زمانك هذا تاجر النصح يربح % 8(@)(@@) % أيا بن حريث لا تهدك عضيهة % فإنك بالهون الطويل موقح % 9(@)(@@) % وكن آمنا سير الهجاء فإنما % % يسيره المرء المهجى الممدح % 10(@)(@@) % نباهة أشعار الفتى وخمولها % % على حسب من تلقاه يهجو ويمدح % PageV01P1049 11 
ms278	(@)(@@) % فإن قالها في نابه حملت له % % وإن قالها في خامل فهي رزح % 12(@)(@@) % تسير بسير اسم المقولة باسمه % % فتسنح في الآفاق طورا وتبرح % 13(@)(@@) % عجبت لقيل الناس إنك أقرن % وأنت الأجم المستضام المنطح % 14(@)(@@) % فكيف تباري بالقرون وطولها % % ولست ترى عن نعجة لك تنطح % 15(@)(@@) % تعرضت لي جهلا فلما عجمتني % % تكشف عنك الجهل والليل يصبح % 16(@)(@@) % وما كنت ثعلبا بتنوفة % % اتيحت له صقعاء في الجو تلمح % 17(@)(@@) % تصف له طورا وتقبض تارة % إذا ما أفاءت فوقه ظل يضبح % 18(@)(@@) % فلما تعالت في السماء فحلقت % % وأمكنها والأرض درماء صردح % 19(@)(@@) % تدلت عليه من مدى مستقلها % % وبينهما خرق من اللوح أفيح % 20(@)(@@) % برز تصيخ الطير منه مخافة % % فهن مصفات إلى الأرض جنح % PageV01P1050 21(@)(@@) % وكم قائل لما هجوتك غيرة % أمالك في أعراضنا متندح % PageV01P1051 البحر : - 1(@)(@@) % الحب ريحان المحب وراحه % % وإليه إن شحطت نواه طماحه % % 2(@)(@@) % يغدو المحب لشأنه وفؤاده % نحو الحبيب غدوه ورواحه % 3(@)(@@) % عندي حديث أخي الصبابة عن حشا % % لي لا تزال كثيرة أتراحه % 4(@)(@@) % وبحيث أري النحل حد حماتها % % وبحيث لذات الهوى أبراحه % 5(@)(@@) % أصبحت مملوكا لأحسن مالك % % لو كان كمل حسنه إسجاحه % 6(@)(@@) % لم يعنه أرقي وفيه لقيته % حتى أضر بمقلتي إلحاحه % 7(@)(@@) % كلا ولا دمعي وفيه سفحته % % حتى أضر بوجنتي تسفاحه % % 8(@)(@@) % لا مسه بعقوبة من ربه % % إقلاقه قلبي ولا إقراحه % % 9(@)(@@) % لولا يدال من الحبيب محبه % فتدال من أحزانه أفراحه % % 10(@)(@@) % يا ليت شعري هل يبيت معانقي % % ويداي من دون الوشاح وشاحه % % PageV01P1052 11(@)(@@) % ويشمني تفاحه أو ورده % ذاك الجني وورده تفاحه % 12(@)(@@) % ظبي أصح وأمرضت ألحاظه % % والحسن حيث مراضه وصحاحه % % 13(@)(@@) % يغدو فتكثر باللحاظ جراحنا % % في وجنتيه وفي القلوب جراحه % % 14(@)(@@) % من قائل عني لمن احببته % هل ينقع اللوح الذي ألتاحه % % 15(@)(@@) % هل أنت منصف عاشق متظلم % % طول النحيب شكاته وصياحه % % 16(@)(@@) % قسما لقد خيمت منك بمنزل % لي حزنه ولمن سواي بطاحه % 17(@)(@@) % ما بال ثغرك مشربا لي سكره % ولمن سواي فدتك نفسي راحه % 18(@)(@@) % نفسي معذبة به 
ms279	 من دونه % ويباحه دوني ولست أباحه % % 19(@)(@@) % من دون ما قد سمتني نسك الهوى % % وغدا الصبا ولبوسه أمساحه % % 20(@)(@@) % ولكم أبيت النصح فيك ولم يكن % % مثلي يعاف العذب حين يماحه % % PageV01P1053 21(@)(@@) % ولقد أقول لمن ألح يلومني % % وإخاله لحياطتي إلحاحه % % 22(@)(@@) % ولقد أقول لعاذلي متنمرا % كالمستغش وحقه استنصاحه % % 23(@)(@@) % يا من يقبح عند نفسي حبها % % أرني لحاك الله أين قباحه % % 24(@)(@@) % أصدوده أم دله أم بخله % % أخطأت تلك ملاحه وصباحه % % 25(@)(@@) % لولا التعزز في الحبيب وملحه % % ما حل للمستملح استملاحه % % 26(@)(@@) % وجدا الأحبة طيب محظوره % عند المحب ولن يطيب مباحه % % 27(@)(@@) % أكفأت لومك كله ومججته % يا لائمي فامحه من يمتاحه % % 28(@)(@@) % وعساك تنصحني وليس لعاشق % % عين تريه ما يرى نصاحه % 29(@)(@@) % ما كان أحذقني بصرم معذبي % % لولا مهفهف خلقه ورداحه % % 30(@)(@@) % لكنه كالعيش سائغ شهده % يصبى إليه وإن أغص ذباحه % PageV01P1054 31(@)(@@) % مالي ومالك هل أفوز بلذتي % % وعليك وزر قرافها وجناحه % 32(@)(@@) % كلا فلا تكثر ملامك واطرح % % عنك الهذاء فإنني طراحه % 33(@)(@@) % وأما لقد ظلم المعذل في الهوى % % أإليه مصروف الهوى ومتاحه % 34(@)(@@) % أنى يكون كما يشاء مدبر % بيدي سواه سقامه وصحاحه % 35(@)(@@) % مني اللجاجة في الهوى وسبيله % % ومن العذول هريره ونباحه % 36(@)(@@) % وإلى ابن إسماعيل منه مهاجرى % % ومن الزمان إذا أليح سلاحه % 37(@)(@@) % حسن أخي الإحسان والخلق الذي % % يبني المكارم جده ومزاحه % 38(@)(@@) % ومسائل لي عنه قلت فداؤه % % في عصرنا سمحاؤه وشحاحه % 39(@)(@@) % ذاك امرؤ يلقاك منه فتى الندى % % غطريفه كهل الحجا جحجاحه % 40(@)(@@) % حسن المحيا كاسمه بسامه % % ضحاكه لجليسه وضاحه % PageV01P1055 41(@)(@@) % يمسي ويصبح من وضاءة أمره % وكأنما إمساؤه إصباحه % 42(@)(@@) % عاداته في ماله استفساده % وسبيله في مجده استصلاحه % 43(@)(@@) % يرجى فيوفي بالمؤمل عنده % % لا بل يفت وفاءه إرجاحه % 44(@)(@@) % ومتى تعذر مطلب في ماله % فبجاهه وبيمنه استنجاحه % 45(@)(@@) % إن ابن إسماعيل مفزع هارب % قدما ومفدى طالب ومراحه % 46(@)(@@) % دفاع جار حفاظه مناعه % نفاح ضيف سماحه مناحه % % 47(@)(@@) % في شيمتيه صرامة وسلامة % % فهناك حدا منصل وصفاحه % % 48(@)(@@) % والسيف ذو متن يلذ 
ms280	 مساسه % % لكن له حد يهاب كفاحه % % 49(@)(@@) % لرجاله منه اثنتان تتابعت % بهما له وتسايرت أمداحه % % 50(@)(@@) % فلراهب ألا يريث أمانه % ولراغب ألا يريث نجاحه % % PageV01P1056 51(@)(@@) % في ظله أمن النخيب فؤاده % % وبجوده انجبر الكسير جناحه % % 52(@)(@@) % هذا له إكرامه ومقامه % % ولذاك عاجل رفده وسراحه % % 53(@)(@@) % فإليه ينتعل القريب حذاءه % % وإليه يمسح سبسبا مساحه % % 54(@)(@@) % كم سائق ساق المطي يؤمه % حتى اقتدى بذلوله ممراحه % % 55(@)(@@) % ولقد ترانا ننتحيه ودونه % % للعيس أغبر واسع قرواحه % 56(@)(@@) % فيظل يقصر للمسير طويله % % ويبيت يقبض للسرى رحراحه % % 57(@)(@@) % يطوي مدى السفر الميمم سفره % حسنا فيقرب عندهم طماحه % % 58(@)(@@) % وأحق مطوي مداه لقاطع % % سفر تلوح لتاجر أرباحه % % 59(@)(@@) % ولكم كست ظلماء ليل وفده % % ثوبا جديدا لم يحن إمحاحه % % 60(@)(@@) % فهدت عيونهم له أضواؤه % % وهدت أنوفهم له أرواحه % % PageV01P1057 61(@)(@@) % شمل التنوفة فائح من نشره % % قطع الفضاء إلى الأنوف مفاحه % % 62(@)(@@) % وجلا الدجنة لائح من نوره % % كشف الغطاء عن العيون ملاحه % % 63(@)(@@) % لا تخطئن أبا علي إنه % % باب الغنى وسؤاله مفتاحه % % 64(@)(@@) % عيث أظل فبشرتك بروقه % % ومرت لك النفحات منه رياحه % % 65(@)(@@) % ما زال يتبع بشره معروفه % % والغيث يتبع برقه تنضاحه % 66(@)(@@) % أصبحت أشكره وإن لم يرضني % % إسقاطه شأوي ولا إرزاحه % % 67(@)(@@) % وأذيع شكواه وإن لم يشكني % % إنزاره صفدي ولا إيتاحه % % 68(@)(@@) % ألقى الكسوف على المديح وسيبه % كاسي المديح جماله فضاحه % % 69(@)(@@) % فبما اعتلاه بدا عليه كسوفه % % وبما كساه تلألأت أوضاحه % % 70(@)(@@) % كائن له حزم إلي يروقني % % حسنا ويقبح عندي استقباحه % % PageV01P1058 71(@)(@@) % أنشدته مدحي فأنشد طوله % تئق السماح بماله نفاحه % % 72(@)(@@) % صب الفؤاد إلى الندى مشتاقه % % طرب الطباع إلى الثدى مرتاحه % % 73(@)(@@) % بعث الجدا فجرت الي رغابه % % من بعد ما عسرت علي وتاحه % % 74(@)(@@) % طرف يغول الجهد مني عفوه % % بحر يغرق لجتي ضحضاحه % % 75(@)(@@) % فكأن نائله أراد فضيحتي % % مما اعتلى متحي هناك متاحه % % 76(@)(@@) % وإذا الجدا فضح المديح فمقبح % يعتد من إحسانه إقباحه % % 77(@)(@@) % يا آل حماد تقاعس أمركم % % عن ختمه وتجدد استفتاحه % 78(@)(@@) % أنتم حقيقة كل شيء فاضل % % وذوو 