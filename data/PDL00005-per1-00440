ms436	 گشتم طربها را روان گشتم(@)(@@) 41 می اندرگفتگو آمد پس از گفتار جنگ آمد %~% خم و خمخانه اندر چشم من تاریک و تنگ آمد(@)(@@) 42 به گوش من همی از باغ بانگ نای و چنگ آمد %~% کس ار می خورد بی آواز نی بر سرش سنگ آمد(@)(@@) 43 مرا باری همه مهر از می بیجاده رنگ آمد %~% زمرد را روان خواهم چواز روی پرنگ آمد(@)(@@) 44 به خاصه کزهوا شبگیر آواز کلنگ آمد %~% زکاخ میر بانگ رود بو نصر پلنگ آمد(@)(@@) 45 کنون هر عاشقی کو را می روشن به چنگ آمد %~% به طرف باغ همدم با نگاری شوخ و شنگ آمد(@)(@@) 46 ملک یوسف کنون در کاخ خود چون رودزن خواند %~% ندیمان را و خوبان را به نزد خویشتن خواند(@)(@@) 47 من بیجاده گون خواهد بت سیمین ذقن خواند %~% بتی خواند که اورا شاخ باغ نسترن خواند(@)(@@) 48 گروهی ماهرویان را به خدمت بر چمن خواند %~% نگاری از چگل خواند نگاری از ختن خواند(@)(@@) 49 ز خوب آیت الکرسی سه ره بر تن به تن خواند %~% مرا گر آرزوش آید میان انجمن خواند(@)(@@) 50 گهی اشعار من خواند گهی ابیات من خواند %~% وگر شیرین سخن گویم مرا شیرین سخن خواند(@)(@@) 51 امیر این گویدم زیرا که او دلها نگه دارد %~% به نزد خویشتن هرکهتری را پایگه دارد(@)(@@) 52 چه باشد گرچو من مداح در هر شهرو ده دارد %~% ز مدح اندر نماندهر که از رادی سپه دارد(@)(@@) 53 به نزد میر ابو یعقوب نیک ایمن نگه دارد %~% زبهر زایر آوردن به ره برمرد ره دارد(@)(@@) 54 عدو را بند و چه دارد ولی را تاج و گه دارد %~% همیشه روز بدخواهان دولت را سیه دارد(@)(@@) 55 نه چاهی را به گه دارد نه گاهی را به چه دارد %~% زعفوش بهره ورتر هر که افزون ترگنه دارد(@)(@@) 56 امیرا! باهنر میرا خداوندت معین بادا %~% ز ایزد بر تن و جانت 
ms437	 هزاران آفرین بادا(@)(@@) 57 به دست تو همیشه جام و شمشیرو نگین بادا %~% کمینه چاکری زان تو بیش از مستعین بادا(@)(@@) 58 کسی کو بر زمین عیب تو جوید در زمین بادا %~% همه شغل تو با نیکان و سالاران دین بادا(@)(@@) 59 ره آموز تو اندر کارها روح الامین بادا %~% همه ساله چنین بادی همه روزه چنین بادا(@)(@@) 60 زمانه دشمنت را وقت کین اندر کمین بادا %~% زعدل توجهان همواره چون خلد برین بادا(@)(@@) 61 گرازده فضل تو شاها یکی در آفتابستی %~% همانادر پرستیدنش هر کس را شتابستی(@)(@@) 62 ور آن رادی که اندر دست تست اندر سحابستی %~% ز بارانش زمین پر گوهر و پر زرنابستی(@)(@@) 63 وراین پاکی که اندرمذهب تست اندرآبستی %~% به آب اندر نگه کردن همه مزد و ثوابستی(@)(@@) 64 ور این آرام کاندر حلم تست اندر ترابستی %~% حدیث زلزله کردن به چشم خلق خوابستی(@)(@@) 65 ور این خوشی که اندر خلق تست اندر شرابستی %~% علاج دردها را چون دعای مستجابستی(@)(@@) 66 امیرا ! گرجوانمردی به کار آید جوانمردی %~% وگر مردی همی باید به مردی در جهان فردی(@)(@@) 67 همی پاید ز تو رادی همی پوید ز تو مردی %~% خزانه درخروش آمد چو آگه شد که می خوردی(@)(@@) 68 ز غم بفزاید اندر گونه دینارها زردی %~% به هر هفته جهانی را بپیمایی وبنوردی(@)(@@) 69 چو گفتی صید خواهم کرد کردی و عجب کردی %~% به صحرا شیر افکندی ز بیشه کرگ آوردی(@)(@@) 70 بلی شاگرد سلطانی و لیکن نیک شاگردی %~% نباید روزگاری دیر کاستاد جهان گردی(@)(@@) 71 امیرا ! تابه زین کردی به غزنین اسب تازی را %~% دو پای اندر تکاپو یست گرگانی و رازی را(@)(@@) 72 اگر زان سو فروتازی تماشا را و بازی را %~% نه شامی رادل اندرتن بماندنه حجازی را(@)(@@) 73 به تک بردی نشیبی را برآوردی فرازی را %~% بر آوردی حقیقی را فروبردی مجازی را(@)(@@) 74 امیرا ! کارسازی تو و زینی کارسازی را %~% نیندیشی بلندی را 
ms438	 نیندیشی فرازی را(@)(@@) 75 به مردی شادمان کردی روان میر غازی را %~% بدنی خوشنود کردستی نظام دین تازی را(@)(@@) 76 طراز جامه شاهان همی بینم به نام تو %~% بر اسبان برفکنده خلعتی زین و ستام تو(@)(@@) 77 همی ترسند جباران عالم از حسام تو %~% ستاره از فلک رشوت فرستد زی سهام تو(@)(@@) 78 مه و خورشید را رشک آید ای خسرو ز جام تو %~% خطایی کس نیابد هیچگه اندر کلام تو(@)(@@) 79 نظام عالمی بنهاد یزدان در نظام تو %~% به شکر اندر جهان مانده ست هر کس زیر وام تو(@)(@@) 80 سزد بر مهتران فخر آورد کهتر غلام تو %~% منظم کشور و لشکر بوداز انتظام تو(@)(@@) 81 کجا اندر جهان میری و سالاری همی بینم %~% ز شکر منتت بر گردنش باری همی بینم(@)(@@) 82 نه اندرمردمی کردن ترا یاری همی بینم %~% نه جز آزادگی کردن ترا کاری همی بینم(@)(@@) 83 زتو خوبی به جای خلق بسیاری همی بینم %~% کریمی را بر تو تیز بازاری همی بینم(@)(@@) 84 ز کردار تو هر کس را به گفتاری همی بینم %~% ز نیکویی به هر دم از تو کرداری همی بینم(@)(@@) 85 بر دیگر کسان با هر گلی خاری همی بینم %~% ترابر جایگه بیخار گلزاری همی بینم(@)(@@) 86 امیرا! بر نتابد پیل خفتان گرانت را %~% زگردان کس به زه کردن نداند مرکمانت را(@)(@@) 87 نگه کن تا کمر بینی که چون زیبد میانت را %~% یقین بخردان بنگر که چون ماند گمانت را(@)(@@) 88 همی رشوت پذیردجان جباران سنانت را %~% همی دعوی کند پایندگی بخت جوانت را(@)(@@) 89 چنان خوداده ای بر چیز بخشیدن بیانت را %~% که در بخشیدن گنجی نرنجاند زبانت را(@)(@@) 90 زمانه آشکارا کرد نتواندنهانت را %~% همه آسایش و شادی تنت را باد وجانت را(@)(@@) 91 ترا عار آیدار جز گرد مردی پر جگر گردی %~% کنون معروفی و فردا ازین معروفتر گردی(@)(@@) 92 تو آن شاهی که اندر صید گرد شیر نر 
ms439	 گردی %~% به میدان گر سالاران بازور و هنر گردی(@)(@@) 93 به نام نیکو ودولت فریدون دگرگردی %~% به مردی چون پدر گشتی به شاهی چون پدر گردی(@)(@@) 94 شه فرخنده پی هستی شه پیروز گر گردی %~% بزرگی را و شاهی را درخت بارور گردی(@)(@@) 95 چو اسکندر به پیروزی جهان را گرد بر گردی %~% به داد و عدل در گیتی چو نوشیروان سمر گردی(@)(@@) 96 امیرا باش تا سلطان ترا طبل و علم سازد %~% ز بهر جنگ بدخواهان ترا خیل و حشم سازد(@)(@@) 97 سپاهی از عرب خواهد سپاهی از عجم سازد %~% ترا اندر سپهداری مکان روستم سازد(@)(@@) 98 در آن کشور که تو خواهی ترا باغ ارم سازد %~% چوایوان مداین مر ترا ایوان جم سازد(@)(@@) 99 ز بهر خدمتت مردان مرد محتشم سازد %~% زمال خویشتن یک یک ز بهر تو نعم سازد(@)(@@) 100 به مدح تو عطا بخشد بنام تو درم سازد %~% نه آن خسرو ز فرزندان همی یک خوب کم زد(@)(@@) 101 بسازد کار تو زیرا که شاه کارسازست او %~% امیر حق شناسست او شه کهتر نوازست او(@)(@@) 102 جهان او را ست و ز شاهان گیتی بی نیازست او %~% خداوند نشیبست اوخداوند فراز ست او(@)(@@) 103 گهی کهتر نوازست او گهی دشمن گدازست %~% به رادی چون سحابست اوبه پاکی چون نماز ست او(@)(@@) 104 حجاز او گر ترا بخشد خداوند حجازست او %~% وگر گویی طرازم ده خداوند طراز ست او(@)(@@) 105 به طاعت خلق را ز ایزد سوی جنت جو از ست او %~% ترا از آشکارا یکدل و پاکیزه رازست او(@)(@@) 106 دگر نوروز را خیل از در مشکوی بگذاری %~% به هنجاری که کاری تو گل خودروی بگذاری(@)(@@) 107 وز آن سوخان وزین سورای را یکسوی بگذاری %~% نه آنجا رنگ بگذاری نه اینجا بوی بگذاری(@)(@@) 108 قضای تیغها را بر سر بدگوی بگذاری %~% به نیرو زورمندان را بر و بازوی بگذاری(@)(@@) 109 نه تاب اندر تن شیر نر 
ms440	 از نیروی بگذاری %~% نه طاقت در روان دشمن بدخوی بگذاری(@)(@@) 110 کجا چوگان به کف گیری ز کیوان گوی بگذاری %~% به نیزه موی بشکافی به ناوک روی بگذاری(@)(@@) 111 همی تا بر جهان فضلست فرزندان آدم را %~% چو بر هر چشمه ای حیوان وبر هر چاه زمزم را(@)(@@) 112 همی تابرخزان باشد بهی نوروز خرم را %~% چو بر خلدی وبر کرباس دیبار او ملحم را(@)(@@) 113 همیشه تابه گیتی شادیی از پی بود غم را %~% چنان چون کز پی هر سور دارد دهر ماتم را(@)(@@) 114 همی تا بر هنرهر جای بستایند رستم را %~% چنان کاندر جهانداری و اندر مرتبت جم را(@)(@@) 115 مقدم بادی اندر پادشاهی هر مقدم را %~% مطیع خویش گردانیده جباران عالم را(@)(@@) 116 سپه را پشتبان بادی جهان را پادشا بادی %~% جهان را پادشا بادی طرب را آشنا بادی(@)(@@) 117 امیر کاردان بادی شه فرمانروا بادی %~% عجم را روستم بادی عرب را مرتضا بادی(@)(@@) 118 مخالف را شقا بادی موافق را بقا بادی %~% معین مؤمنان بادی امید اولیا بادی(@)(@@) 119 خداوند سخن بادی خداوند سخا بادی %~% خداوند نعم بادی خداوند عطا بادی(@)(@@) 120 شفای هر غمی بادی و دفع هر بلا بادی %~% بزرگی را بقا بادی بقا را منتها بادی PageV1P336(@)(@@)(@@)(@@) || [genre: Tj](@)(@@) 1 همی گفتم که کی باشد که خرم روزگار آید %~% جهان از سر جوان گردد بهار غمگسار آید(@)(@@) 2 بهار غمگسار آید که هر کس را به کار آید %~% بهاری کاندر و هر روز می را خواستار آید(@)(@@) 3 زهر بادی که بر خیزد کنون بوی بهار آید %~% کنون ما را ز باد بامدادی بوی یار آمد(@)(@@) 4 چو روی کودکان ما درخت گل به بار آید %~% نگار لاله رخ باما به خرم لاله زار آید(@)(@@) 5 می مشکین گسارد تا گه بوس و کنار آید %~% هوا خوش گردد و با طبع خسروسازگار آید(@)(@@) 6 کرامی خوردن آیینست می خوردن کنون باید %~% بپرس از 