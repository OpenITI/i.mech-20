ms1281	 . |(@)(@@) 4947 - حدثناه محمد بن موسى القطان الواسطي ، قال : نا عاصم | ابن علي قال : نا قيس عن سالم الأفطس ، عن سعيد بن جبير ، عن | ابن عباس بنحوه .(@)(@@) ولا نعلم روي عن ابن عباس متصلا إلا من هذين الوجهين . |(@)(@@) 4948 - حدثنا موسى بن إسحاق قال : نا منجاب بن الحارث ، | PageV11P198 | قال : نا علي بن مسهر ، عن مسلم ، عن مجاهد ، عن ابن عباس ، في | قوله الله - تبارك وتعالى - : ^ ( واللاتي يأتين الفاحشة من نسائكم ) ^ قال : | كن يحبسن في البيوت حتى يمتن ، فلما نزلت سورة النور ونزلت الحدود | نسختها .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن ابن عباس ، وقد | روي بغير هذا اللفظ عن عبادة بن الصامت . |(@)(@@) 4949 - حدثنا موسى بن إسحاق ، قال : نا محمد بن إسحاق | المسيبي قال : نا العباس بن أبي شملة ، عن الحارث بن عبد الرحمن بن أبي | PageV11P199 | ذباب ، عن مجاهد ، عن ابن عباس - رضي الله عنهما - أن النبي - [ & ] - | قال : ' من لم يكن معه هدي فقد حل له أهله ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - إلا | من هذا الوجه بهذا الإسناد ، والعباس بن أبي شملة مدني والحارث بن أبي | عبد الرحمن قد روى عن مجاهد غير حديث . |(@)(@@) 4950 - حدثنا جعفر بن أحمد ابن أخي وكيع بن الجراح قال : | نا محمد بن بشر قال : نا مسعر عن عمرو بن مرة عن مجاهد عن ابن | عباس - رضي الله عنهما - أنه قرأ سورة ' ص ' ، فسجد فيها ، ثم قال : | ^ ( أولئك الذين هداهم الله فبهداهم اقتده ) ^ وما يمنعه أن يسجد فيها | وقد قص الله عليه الأنبياء . | PageV11P200(@)(@@) وهذا الحديث رواه معاوية بن هشام عن شيبان ، عن جابر الجعفي ، | عن عمرو بن مرة ، عن مجاهد ، عن ابن عباس - رضي الله عنهما - قال : | دخلت على رسول الله - [ & ] - في بيته وهو يقرأ سورة ' ص ' | فسجد فيها ، وقال ابن عباس : وما يمنعه أن يسجد فيها وقد قص الله عليه | الأنبياء ، وذكر فيهم داود ثم قال : ^ ( أولئك الذين هداهم الله فبهداهم | اقتده ) ^ . ولم يرو عمرو عن مجاهد عن ابن عباس إلا 
ms1282	 هذا الحديث . |(@)(@@) 4951 - حدثنا بشر بن آدم قال : نا أبو عاصم ، عن ابن | جريج ، قال : أنا عبد الكريم أن مجاهدا أخبره ، عن ابن عباس - رضي | الله عنهما - قال : أتيت أنا والفضل على أتان فمررنا بين يدي رسول الله | - [ & ] - بعرفة وهو يصلي المكتوبة ليس شيء يستره يحول | بيننا وبينه . | PageV11P201(@)(@@) وهذا الحديث لا نعلمه يروى إلا عن ابن عباس ، وقد روي عن ابن | عباس من غير وجه بألفاظ فذكرنا [ 282 ] كل حديث منها بلفظه في | موضعه . |(@)(@@) 4952 - حدثنا محمود بن بكر قال : نا أبي ، عن عيسى بن | المختار ، عن ابن أبي ليلى ، عن عبد الكريم ، عن مجاهد ، عن ابن عباس | - رضي الله عنهما - أن النبي - [ & ] - قال : ' نهيت أن | أصلي إلى النيام والمتحدثين ' .(@)(@@) وهذا الحديث لا نعلمه يروى إلا عن ابن عباس وروي عنه من | وجهين وهذا الوجه أحسن الوجهين اللذين يرويان عنه . | PageV11P202 |(@)(@@) 4953 - حدثنا أحمد بن عبدة قال : أنا سفيان - يعني ابن عيينة - | عن عمرو بن دينار ، عن عطاء وابن جريج ، عن عطاء جميعا عن ابن | عباس - رضي الله عنهما - أن النبي - [ & ] - أخر صلاة | العشاء حتى ذهب من الليل ما شاء الله ، فقال له عمر : رقد النساء | والولدان ، فخرج وهو يقول : ' لولا أن أشق على أمتي لأمرتهم أن يصلوا | هذه الساعة ' .(@)(@@) وهذا الحديث قد روي عن ابن عباس وعن غيره بألفاظ مختلفة | فذكرنا كل حديث منها في موضعه بلفظه . |(@)(@@) 4954 - حدثنا نصر بن علي قال : نا سفيان بن عيينة ، عن عمرو | عن عطاء عن ابن عباس - رضي الله عنهما - أن النبي - [ & ] - | كان إذا أكل طعاما لعق أصابعه . | PageV11P203(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - من غير | وجه وهذا الإسناد من أحسن إسناد يروى في ذلك . |(@)(@@) 4955 - حدثنا أحمد بن عبدة قال : أنا سفيان عن عمرو عن | عطاء عن ابن عباس - رضي الله عنهما - قال : لحق المسلمون رجلا في | غنيمة له فسلم فقتلوه وأخذوا غنيمته فأنزل الله : ^ ( ولا تقولوا لمن ألقى | إليكم السلام لست مؤمنا تبتغون عرض الحياة الدنيا ) ^ الغنيمة .(@)(@@) وهذا الحديث قد روي 
ms1283	 عن ابن عباس من غير هذا الوجه ، وهذا | الطريق أحسن طريقا يروى عنه في ذلك . |(@)(@@) 4956 - حدثنا أحمد بن بكار الباهلي قال : نا سفيان بن عيينة ، | عن عمرو ، عن عطاء ، عن ابن عباس - رضي الله عنهما - قال : قدمني | رسول الله - [ & ] - في ضعفة أهله من جمع بليل .(@)(@@) وهذا الحديث قد روي عن ابن عباس من وجوه بألفاظ مختلفة يزيد | كل واحد منهم على صاحبه ، فذكرنا كل حديث منها في موضعه بلفظه . | PageV11P204 |(@)(@@) 4957 - وحدثنا أحمد بن عبدة ، قال : أنا سفيان عن عمرو بن | دينار ، عن عطاء ، عن ابن عباس - رضي الله عنهما - إنما رمل النبي | - [ & ] - ليري المشركين قوته .(@)(@@) وهذا الحديث قد روي عن ابن عباس من غير وجه ، فذكرناه في | هذا الموضع بهذا الإسناد لحسن إسناده ولعزة طريقه . |(@)(@@) 4958 - حدثنا أحمد بن عبدة قال : أنا سفيان عن عمرو ، عن | عطاء ، عن ابن عباس - رضي الله عنهما - في قول الله - تبارك وتعالى - : | ^ ( ألم تر إلى الذين بدلوا نعمة الله كفرا وأحلوا قومهم دار البوار ) ^ | قال : هم كفار قريش أهل مكة الذين قتلوا يوم بدر .(@)(@@) وإنما ذكرنا هذا الحديث وإن لم نذكر عن النبي - [ & ] - | فيه شيئا ، لأنا لا نحفظ هذا الكلام عن النبي - [ & ] - | PageV11P205 | رواه صحابي فذكرناه من أجل ذلك . |(@)(@@) 4959 - حدثنا عمرو بن علي قال : نا أبو عاصم عن زكريا بن | إسحاق ، عن عمرو بن دينار ، عن عطاء ، عن ابن عباس . |(@)(@@) 4960 - وحدثنا محمد بن معمر قال : نا روح بن عبادة ، عن | زكريا بن إسحاق ، عن عمرو بن دينار ، عن عطاء ، عن ابن عباس : | ^ ( الذين يجتنبون كبائر الإثم والفواحش إلا اللمم ) ^ قال : اللمة من | الزنا ، وقال ابن عباس : قال رسول الله - [ & ] - : |(@)(@@) % ' إن تغفر اللهم تغفر جما % % وأي عبد لك لا ألما ' % PageV11P206(@)(@@) وهذا الحديث لا نعلم أحدا أسنده غير زكريا بن إسحاق ، عن | عمرو بن دينار ولا نعلمه يروى عن النبي - [ & ] - من | وجه متصل إلا من هذا الوجه . |(@)(@@) 4961 - حدثنا محمد بن المثنى ، قال : نا أبو داود ، قال : نا | شعبة ، قال : أخبرني أيوب قال : سمعت 
ms1284	 عطاء يحدث عن ابن عباس - رضي | الله عنهما - أنه قال : أشهد على رسول الله - [ & ] - أو | قال عطاء : أشهد على ابن عباس أن النبي - [ & ] - خرج | يوم فطر أو أضحى فصلى ، ثم خطب ، ثم أتى النساء فأمرهن بالصدقة ، | فجعلن يلقين . |(@)(@@) 4962 - حدثناه محمد بن عبد الملك القرشي قال : نا حماد بن | زيد ، عن أيوب ، عن عطاء ، عن ابن عباس ، عن النبي - [ & ] - | بنحوه . |(@)(@@) 4963 - حدثنا عمرو بن علي قال : نا عاصم بن هلال ، عن | PageV11P207 | أيوب ، عن عطاء ، عن ابن عباس - رضي الله عنهما - قال : أشهد | على رسول الله - [ & ] - أنه خطب بعد الصلاة فأمرنا | ونهانا ، وظن أنه لم يسمع النساء فأتاهن ومعه بلال فوعظهن وأمرهن | ونهاهن وأمرهن أن يتصدقن وبسط بلال ثوبه ، فجعلت المرأة تلقي الخرص | والخاتم .(@)(@@) وهذا الحديث قد روي عن ابن عباس من غير وجه بألفاظ مختلفة | وروي عن عطاء عن ابن عباس من غير هذا الوجه وهذا الطريق من | أحسن طريق يروى عن عطاء عن ابن عباس . |(@)(@@) 4964 - حدثنا عمرو بن علي قال : نا عبد الأعلى بن عبد الأعلى | السامي قال : نا هشام - يعني ابن حسان - عن قيس بن سعد ، عن | عطاء ، عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | كان إذا قال : ' سمع الله لمن حمده ' قال : ' اللهم ربنا لك | الحمد ملء السماوات وملء الأرض [ 283 ] وملء ما شئت من شيء | بعد ' . | PageV11P208(@)(@@) وهذا الحديث قد روي عن ابن عباس من غير وجه واختلفوا عن | قيس بن سعد فقال بعض من رواه عن قيس ، عن عطاء وقال بعضهم عن | طاوس والحديث بعطاء أشبه . |(@)(@@) 4965 - حدثنا عقبة بن مكرم العمي ومحمد بن معمر والسكن بن | سعيد قالوا : نا وهب بن جرير قال : حدثني أبي قال : سمعت قيس بن | سعد يحدث عن عطاء عن ابن عباس - رضي الله عنهما - قال : بعثني | العباس إلى النبي - [ & ] - وهو في بيت ميمونة خالتي | فبت معه تلك الليلة ، فقام يصلي من الليل ، فقمت فتوضأت وقمت عن | شماله ، فتناولني من خلف ظهره ، فجعلني عن يمينه .(@)(@@) وهذا الحديث لا 
ms1285	 نعلم حدث به أحد عن قيس بن سعد إلا جرير | ابن حازم ، ولا نعلم حدث به عن جرير إلا وهب ابنه . |(@)(@@) 4966 - حدثنا عقبة بن مكرم قال : نا محمد بن عبد الله | PageV11P209 | الخزاعي قال : نا حماد بن سلمة عن قيس بن سعد ، عن عطاء ، عن | ابن عباس - رضي الله عنهما - أنه قال : ألم تعلم يا زيد بن أرقم أن رسول | الله - [ & ] - أهدي له عضو صيد فلم يأكل ، وقال : ' إنا | حرم ' قال : نعم . |(@)(@@) 4967 - حدثنا عقبة بن مكرم قال : نا محمد بن عبد الله | الخزاعي قال : نا حماد بن سلمة ، عن قيس بن سعد ، عن عطاء ، | عن ابن عباس - رضي الله عنهما - أن رسول الله - [ & ] - | أفاض من جمع فيما أحسب وأسامة ردفه . | PageV11P210(@)(@@) وهذا الحديث قد روي عن ابن عباس من غير وجه أن النبي - [ & ] | أردف الفضل ، وحديث قيس أردف أسامة ، ولا نعلم | حدث بهذا الحديث عن قيس إلا حماد بن سلمة . |(@)(@@) 4968 - حدثنا محمد بن إسحاق البغدادي وعلي بن شعيب قالا : | نا أسود بن عامر قال : نا أيوب بن عتبة عن يحيى بن أبي كثير ، عن | عطاء ، عن ابن عباس - رضي الله عنهما - أن النبي - [ & ] - | نهى عن بيع الغرر .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا من هذا الوجه وقد | روي عن ابن عباس ولا نعلم رواه عن يحيى بن أبي كثير إلا أيوب بن | عتبة . |(@)(@@) 4969 - حدثنا الفضل بن سهل قال : نا أسود بن عامر ، قال : نا | PageV11P211 | أيوب بن عتبة عن يحيى بن أبي كثير ، عن عطاء وعكرمة ، عن ابن | عباس - رضي الله عنهما - أن النبي - [ & ] - تزوج | ميمونة وهو محرم .(@)(@@) وهذا الحديث لا نعلمه يروى عن يحيى بن أبي كثير ، عن عطاء إلا | من هذا الوجه ، ولا نعلم حدث به عن يحيى إلا أيوب بن عتبة ، وقد روي | عن ابن عباس من غير وجه . |(@)(@@) 4970 - حدثنا حسين بن علي بن جعفر الأحمر قال : نا قبيصة | ابن عقبة قال : نا فطر عن عطاء ، عن ابن عباس - رضي الله | عنهما 
ms1286	 - أن النبي - [ & ] - قال : ' أفطر الحاجم والمحجوم ' .(@)(@@) وهذا الحديث إنما ذكرناه ليتبين اختلاف الناس عن عطاء ، فإنه | PageV11P212 | رواه غير قبيصة ، عن فطر ، عن عطاء ، عن النبي - [ & ] - | مرسلا ، ولا نعلم أحدا قال عن ابن عباس إلا قبيصة . رواه عبد الملك بن | أبي سليمان وابن جريج ، عن عطاء ، عن أبي هريرة موقوفا إلا داود بن | عبد الرحمن ، فإنه ذكره عن ابن جرير ، عن عطاء ، عن أبي هريرة ، عن | النبي - [ & ] - . وذكره أبو حاتم عن الأنصاري ، عن ابن | جريج ، عن عطاء ، عن أبي هريرة ، عن النبي - [ & ] - . ولم | يتابعه عن الأنصاري أحد أسنده ورواه ليث عن عطاء ، عن عائشة هكذا | رواه خالد الواسطي وشيبان ، ورواه محمد بن سعيد الأموي ، عن ليث ، | عن عطاء ، عن عروة بن عياض ، عن عائشة ، عن النبي - [ & ] - ، | ورواه سلام أبو المنذر ، عن عطاء ، عن جابر بن عبد الله ، فذكرنا | حديث فطر ليتبين هذا الاختلاف فيه . |(@)(@@) 4971 - حدثنا عقبة بن مكرم وأحمد بن ثابت الجحدري قالا : نا | أبو عامر عبد الملك بن عمرو قال : نا رباح بن أبي معروف ، عن عطاء ، | عن ابن عباس ، عن النبي - [ & ] - . |(@)(@@) 4972 - وحدثنا محمد بن إسحاق البغدادي قال : نا يونس بن | محمد ، عن الليث بن سعد ، عن أبي الزبير ، عن عطاء ، عن ابن عباس | - رضي الله عنهما - ، عن النبي - [ & ] - أنه احتجم وهو | PageV11P213 | محرم . |(@)(@@) 4973 - وحدثنا أحمد بن ثابت قال : نا بشر بن الحسن وكان من | خيار الناس ، عن ابن جريج ، عن عطاء ، عن ابن عباس - رضي الله | عنهما - أن النبي - [ & ] - احتجم بلحيي جمل وهو محرم .(@)(@@) وهذا الحديث قد روي عن ابن عباس من وجوه كثيرة بألفاظ | مختلفة ، وروي عن غير ابن عباس ، فذكرنا هذه الأسانيد من جملة ما | يروى عن ابن عباس في ذلك ، فأما حديث أبي الزبير ، فلا نعلم أسند أبو | الزبير ، عن عطاء ، عن ابن عباس ، غير هذا الحديث وحديث ابن جريج | فلا نعلم أسنده إلا بشر بن الحسن . |(@)(@@) 4974 - حدثنا أحمد بن إسحاق الأهوازي قال : نا موسى بن | داود قال : نا عبد الله بن المؤمل 
ms1287	 ، عن عطاء عن ابن عباس - رضي الله | عنهما - أن رسول الله - [ & ] - بعث أبا موسى في سرية | PageV11P214 | في البحر فبينا هم كذلك قد رفعوا الشراع في ليلة مظلمة إذا هاتف من | فوقهم يهتف بأهل السفينة قفوا أخبركم بقضاء قضاه الله على نفسه فقال | أبو موسى : أخبر إن كنت مخبرا ، قال : إن الله - تبارك وتعالى - قضى على | نفسه أنه من أعطش نفسه له في يوم صائف سقاه الله يوم العطش .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا من هذا الوجه وقد | روي عن [ 284 ] أبي موسى من قوله وفيه زيادة كلام من قول أبي | موسى .(@)(@@) آخر التاسع والثلاثين والحمد لله كثيرا كما هو أهله . | PageV11P215 |(@)(@@) | حديث المكيين عن ابن عباس(@)(@@) 4975 - أخبرنا أبو الحسن محمد بن أيوب بن حبيب بن يحيى | الرقي ، قال : نا أبو بكر أحمد بن عمرو بن عبد الخالق البزار قال : نا أحمد | ابن عبدة قال : أنا سفيان - يعني ابن عيينة - عن عمرو - يعني ابن | دينار - عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - سمع النبي | - [ & ] - يقول : ' إنكم ملاقو الله غدا حفاة عراة | غرلا ' .(@)(@@) وهذا الحديث قد روي عن ابن عباس من غير هذا الوجه ، وروي | عن غير ابن عباس ، ولا نعلمه يروى عن ابن عباس بأصح إسناد من هذا | الإسناد . | PageV11P216 |(@)(@@) 4976 - حدثنا أحمد بن عبدة قال : أنا سفيان ، عن عمرو ، عن | سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - قال : كان النبي - [ & ] - | إذا نزل عليه القرآن يقرؤه ليحفظه ، فأنزل الله - تبارك | وتعالى - : ^ ( لا تحرك به لسانك لتعجل به إن علينا جمعه وقرآنه ) ^ .(@)(@@) وهذا الحديث قد رواه غير واحد عن ابن عيينة عن عمرو ، عن | سعيد مرسلا . |(@)(@@) 4977 - وحدثناه أحمد بن عبدة والحسن بن الصباح ، عن | ابن عيينة ، عن عمرو ، عن سعيد ، عن ابن عباس . |(@)(@@) 4978 - حدثنا أبو كريب قال : نا سفيان عن عمرو ، عن سعيد | ابن جبير ، عن ابن عباس ، عن النبي - [ & ] - . | PageV11P217 |(@)(@@) 4979 - وحدثنا أحمد بن عبدة قال : أنا سفيان عن عمرو عن | سعيد 
ms1288	 بن جبير - أشك في حديث ابن عبدة - قال : عن ابن عباس - أو | قال : عن سعيد - ولم يقل : عن ابن عباس قال : كان النبي - [ & ] - | لا يعرف خاتمة السورة حتى ينزل : بسم الله الرحمن الرحيم ، فإذا | نزل : بسم الله الرحمن الرحيم علم أن السورة قد ختمت ، واستقبلت - أو | ابتدئت - سورة أخرى .(@)(@@) وهذا الحديث يرويه عن عمرو من حديث ابن عيينة جماعة مرسلا . |(@)(@@) 4980 - حدثنا أحمد بن عبدة ، أنا سفيان ، عن عمرو ، عن | سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - أن رجلا كان | واقف على راحلته مع رسول الله - [ & ] - إذ وقع عن | بعيره فوقصه وهو محرم ، فقال رسول الله - [ & ] - : | PageV11P218 | ' اغسلوه بماء وسدر وكفنوه في ثوبيه ، ولا تخمروا رأسه ولا تقربوه | طيبا ؛ فإنه يبعث يوم القيامة يهل أو يلبي ' . |(@)(@@) 4981 - وحدثنا محمد بن مرزوق قال : نا محمد بن بكر | قال : نا ابن جريج قال : أخبرني عمرو بن دينار أن سعيد بن جبير | أخبره ، عن ابن عباس - رضي الله عنهما - قال : أقبل رجل حرام مع رسول الله - [ & ] - فخر من فوق بعيره فوقصه وقصا | فمات ، فقال رسول الله - [ & ] - : ' اغسلوه بماء وسدر | وألبسوه ثوبيه ولا تخمروا رأسه ، فإنه يأتي يوم القيامة يلبي ' . |(@)(@@) 4982 - حدثنا محمد بن مرزوق ، قال : نا محمد بن بكر قال : | PageV11P219 | نا ابن جريج قال : أخبرني أبو الزبير عن سعيد بن جبير بمثل خبر | عمرو إياي عنه . |(@)(@@) 4983 - وحدثناه ميمون بن الأصبغ قال : نا وهب بن جرير | قال : نا أبي عن قيس بن سعد عن عمرو بن دينار ، عن سعيد بن جبير ، | عن ابن عباس عن النبي - [ & ] - بنحوه . |(@)(@@) 4984 - وحدثنا الفضل بن يعقوب الجزري قال : نا عبد الأعلى | قال : نا محمد بن إسحاق قال : نا أبان بن صالح عن عمرو بن دينار | PageV11P220 | عن سعيد بن جبير ، عن ابن عباس ، عن النبي - [ & ] - | بنحو حديث ابن عيينة .(@)(@@) وهذا الحديث لا نعلمه يروى بإسناد أحسن من هذه الأسانيد ، وقد | روى ذلك عن سعيد بن جبير مسلم بن أبي حرة عن سعيد بن جبير . |(@)(@@) 4985 - حدثناه أحمد 
ms1289	 بن عبدة ، عن ابن عيينة ، عن مسلم بن | أبي حرة ، عن سعيد بن جبير ، عن ابن عباس .(@)(@@) ولم يسند مسلم بن أبي حرة غير هذا الحديث ، ورواه مطر الوراق | وأبو بشر عن سعيد بن جبير فاقتصرنا على من ذكرنا . |(@)(@@) 4986 - حدثنا الحسن بن عرفة قال : نا هشيم عن أشعث بن | سوار ، عن أبي الزبير ، عن سعيد بن جبير ، عن ابن عباس . | PageV11P221 |(@)(@@) 4987 - وحدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله | عن سفيان عن أبي الزبير ، عن سعيد بن جبير ، عن ابن عباس . |(@)(@@) 4988 - وحدثنا محمد بن بشار قال : نا أبو عامر ، قال : نا | قرة عن أبي الزبير ، عن سعيد بن جبير ، عن ابن عباس . |(@)(@@) 4989 - وحدثنا عمر بن موسى الشامي قال : نا حماد بن | سلمة ، عن أبي الزبير ، عن سعيد بن جبير ، عن ابن عباس - رضي | PageV11P222 | الله عنهما - أن النبي - [ & ] - جمع بين الظهر والعصر | والمغرب والعشاء بالمدينة من غير خوف ؛ لكي لا يحرج أمته .(@)(@@) وهذا الحديث رواه عن أبي الزبير عن سعيد بن جبير جماعة | فاقتصرنا على من ذكرنا منهم . |(@)(@@) 4990 - وحدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله بن | موسى قال : نا عمر بن صهبان ، عن أبي الزبير ، عن سعيد بن | جبير ، عن ابن عباس - رضي الله عنهما - قال : كان النبي - [ & ] - | في غزوة تبوك يؤخر الظهر حتى يبرد ، ثم يصلي الظهر والعصر ثم | لا ينزل حتى يغيب الشفق ثم يصلي المغرب والعشاء .(@)(@@) وهذا الحديث لا نعلم رواه بهذا اللفظ ، عن أبي الزبير ، عن سعيد | ابن جبير ، عن ابن عباس إلا عمر بن صهبان ، وهو عمر بن محمد بن | صهبان رجل من أهل المدينة ليس بالقوي وقد روى عنه [ 285 ] جماعة | من أهل العلم واحتملوا حديثه . |(@)(@@) 4991 - حدثنا محمد بن مرزوق بن بكير قال : نا عمرو بن صالح | PageV11P223 | قاضي رام هرمز قال : نا يحيى بن أبي أنيسة ، عن أبي الزبير ، عن سعيد | ابن جبير قال : كنا عند ابن عباس في المسجد - مسجد الحرام - ، وذكر | عنده شيئا 
ms1290	 من القدر فأهوى بيده ، وذلك بعدما ذهب بصره ، فقلت : ليس | في القوم منهم أحد قال : كنت أرى أن فيهم أحدا فآخذ برقبته ، وذلك | أني سمعت رسول الله - [ & ] - يقول ك ' ما بعث الله نبيا ثم | قبضه إلا جعل من بعده فترة ، فتملأ من تلك الفترة جهنم ' إنهم | القدريون . |(@)(@@) 4992 - وحدثناه محمد بن عبد الرحيم قال : نا صدقة بن سابق | عن سليمان بن قرم ، عن أبي الزبير ، عن سعيد بن جبير ، عن ابن | عباس ، عن النبي - [ & ] - بنحوه أو قريبا منه . | PageV11P224(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - | بهذا اللفظ إلا من هذا الوجه الذي ذكرناه . |(@)(@@) 4993 - حدثنا عبد الواحد بن غياث قال : نا عدي بن الفضل | قال : نا إسماعيل بن أمية عن أبي الزبير عن ابن عباس . |(@)(@@) 4994 - وحدثنا بشر بن معاذ قال : نا موسى بن عيسى قال : نا | محمد بن إسحاق عن إسماعيل بن أمية ، عن أبي الزبير ، عن ابن عباس . | وقال ابن إدريس : عن ابن إسحاق عن إسماعيل بن أمية ، عن أبي | الزبير ، عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - قال : قال | رسول الله - [ & ] - : ' لما أصيب إخوانكم جعل الله | أرواحهم في جوف طير خضر ترد أنهار الجنة ، فتأكل من ثمارها وتأوي | إلى قناديل معلقة في ظل العرش ، فلما وجدوا طيب مطعمهم ومشربهم | PageV11P225 | قالوا : لو يعلمون إخواننا بما أكرمنا الله ، فقال الله تبارك وتعالى : أنا | مبلغهم عنكم ' فأنزل الله تبارك وتعالى : ^ ( ولا تحسبن الذين قتلوا في | سبيل الله أمواتا بل أحياء عند ربهم يرزقون * فرحين بما آتاهم الله من | فضله ويستبشرون بالذين لم يلحقوا بهم من خلفهم ألا خوف عليهم | ولا هم يحزنون ) ^ .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا بهذا الإسناد . |(@)(@@) 4995 - حدثنا محمد بن مرزوق قال : نا عمرو بن صالح | قال : نا الأشعث بن سوار عن أبي هبيرة ، عن سعيد بن جبير ، عن ابن | عباس - رضي الله عنهما - قال : بعثني أبي إلى النبي - [ & ] - | وكانت ليلة خالتي فجئت فاضطجعت على الفراش فقال : ' أنام | الغلام ؟ ' ولم أنم 
ms1291	 ، وأنا أسمع كلامه ، قال : فصلى أربع ركعات يطيل فيهن | القراءة والركوع والسجود ، قال : ثم اضطجع قال : ثم قام فصلى خمس | ركعات ، وقمت فتوضأت وقمت عن يساره فأخذ بيدي من خلفه | فأقامني عن يمينه ، قال : ففهمت من دعائه وهو يقول : ' اللهم اجعل في | سمعي نورا ، وفي بصري نورا ، وفي قلبي نورا ، وفي لساني نورا ، وعن | يميني نورا ، وعن يساري نورا ، وقدامي نورا ، وخلفي نورا ، وتحتي نورا ، | PageV11P226 | وفوقي نورا ، اللهم أعظم لي نورا ' .(@)(@@) وهذا الحديث قد روي عن النبي - [ & ] - من وجوه | كثيرة في صفة صلاة رسول الله - [ & ] - برواية ابن عباس | عنه ، وكل يذكر عن ابن عباس في روايته ما يجب أن يعاد الحديث من | أجله . ولا نعلم أسند أبو هبيرة ، عن سعيد بن جبير ، عن ابن عباس إلا | هذا الحديث ، وأبو هبيرة اسمه يحيى بن عباد رجل من أهل الكوفة ثقة . |(@)(@@) 4996 - حدثنا محمد بن المثنى أبو موسى قال : نا محمد بن أبي | عدي ، عن سعيد بن أبي عروبة ، عن قتادة ، عن عزرة ، عن سعيد بن | جبير ، عن ابن عباس ^ ( وعلى الذين يطيقونه فدية طعام مساكين ) ^ | قال : كانت رخصة للشيخ الكبير والمرأة الكبيرة ، وهما يطيقان الصيام أن | يفطرا ، ويطعما مكان كل يوم مسكينا ثم نسخت وأثبت أنهما إذا لم | يطيقا الصيام أن يفطرا ويطعما مكان كل يوم مسكينا ، والحبلى والمرضع | إذا خافتا ، وكان ابن عباس يقول لأم ولد له حبلى : أنت بمنزلة التي لا | تطيقه ، فعليك الفداء ولا قضاء عليك . | PageV11P227(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ بإسناد أحسن من هذا | الإسناد . |(@)(@@) 4997 - حدثنا محمد بن المثنى ، قال : نا عبد الصمد بن عبد | الوارث قال : نا همام عن قتادة ، عن عزرة ، عن سعيد بن جبير ، عن | ابن عباس - رضي الله عنهما - أن النبي - [ & ] - كان يقرأ | في صلاة الصبح يوم الجمعة ب : ^ ( تنزيل ) ^ السجدة ، و ^ ( هل أتى على | الإنسان ) ^ .(@)(@@) وهذا الحديث رواه ابن عباس ، ولا نعلم روي عن ابن عباس إلا | من طريقين أحدهما رواه مسلم البطين ، عن سعيد بن جبير ، عن ابن 
ms1292	 | عباس ، وقتادة ، عن عزرة ، وفي حديث مسلم زيادة فأخرناه ؛ لنذكره في | PageV11P228 | موضعه بلفظه . |(@)(@@) 4998 - وحدثنا هارون بن إسحاق قال : نا عبدة بن سليمان | قال : نا سعيد - يعني ابن أبي عروبة - عن قتادة ، عن عزرة ، عن سعيد | بن جبير ، عن ابن عباس - رضي الله عنهما - أن النبي - [ & ] - | سمع رجلا يلبي عن شبرمة فقال له النبي - [ & ] - : | ' لب عن نفسك ، ثم لب عن شبرمة ' . | PageV11P229(@)(@@) وهذا الحديث قد رواه غير عبدة ، عن ابن أبي عروبة ، عن قتادة عن | عزرة ، عن سعيد بن جبير ، عن ابن عباس موقوفا ، ولا نعلم أحدا | أسنده ، عن ابن أبي عروبة إلا عبدة ، ولا نعلم أسند عزرة عن سعيد ، عن | ابن عباس إلا هذه [ 286 ] الثلاثة الأحاديث ، وعزرة رجل مشهور من | أهل الكوفة ، روى عنه داود بن أبي هند وقتادة وهو عزرة بن عبد | الرحمن . |(@)(@@) 4999 - حدثنا أبو موسى قال : نا ابن أبي عدي عن سعيد عن | علي بن الحكم عن ميمون بن مهران ، عن سعيد بن جبير ، عن ابن | PageV11P230 | عباس - رضي الله عنهما - أن رسول الله - [ & ] - نهى يوم | خيبر عن كل ذي ناب من السباع ، وعن كل ذي مخلب من الطير .(@)(@@) وهذا الحديث لا نعلم رواه أحد عن ميمون بن مهران ، عن سعيد | ابن جبير إلا علي بن الحكم ، وقد رواه أبو بشر والحكم عن ميمون بن | مهران ، عن ابن عباس ، ولم يذكرا سعيد بن جبير بين ميمون بن مهران | وبين ابن عباس . |(@)(@@) 5000 - حدثنا محمد بن المثنى قال : نا أبو معاوية ، عن | الأعمش ، عن مسلم البطين ، عن سعيد بن جبير ، عن ابن عباس - رضي | الله عنهما - قال : قال رسول الله - [ & ] - : ' ما من أيام | العمل الصالح فيها أحب إلى الله - عز وجل - من هذه الأيام ' - يعني : | أيام العشر قالوا : يا رسول الله ، ولا الجهاد في سبيل الله ؟ قال : ' ولا | PageV11P231 | الجهاد في سبيل الله ، إلا رجل خرج بنفسه وماله فلم يرجع بشيء ' .(@)(@@) وهذا الحديث قد رواه الحكم بن عتيبة عن سعيد بن جبير ، عن ابن | عباس . |(@)(@@) 5001 - حدثنا به يوسف 
ms1293	 عن سلمة عن الحجاج ، عن | الحكم .(@)(@@) ورواه القاسم بن أبي أيوب عن سعيد ، عن ابن عباس . |(@)(@@) 5002 - حدثناه أحمد بن سنان الواسطي قال : نا يزيد قال : أنا PageV11P232 | أصبغ بن زيد عن القاسم بن أبي أيوب ، عن سعيد بن جبير ، عن ابن | عباس .(@)(@@) ورواه أبو إسحاق الهمداني ، عن سعيد بن جبير ، عن ابن عباس . |(@)(@@) 5003 - وحدثناه إبراهيم بن محمد بن سلمة قال : نا الحسن بن | عطية ، عن قيس ، عن أبي إسحاق ، عن سعيد بن جبير ، عن ابن | عباس . |(@)(@@) 5004 - حدثنا أبو موسى قال : نا أبو معاوية قال : نا | الأعمش ، عن مسلم البطين ، عن سعيد بن جبير ، عن ابن عباس - رضي | الله عنهما - قال : أتت امرأة النبي - [ & ] - فقالت : يا | رسول الله إن أمي ماتت وعليها صوم شهر أفأقضي عنها ؟ قال : فقال | ' أرأيت لو كان على أمك دينا ما كنت تقضينه عنها ؟ ' قالت : بلى ، قال : | PageV11P233 | ' فدين الله أحق أن يقضى '(@)(@@) وهذا الحديث لا نعلم أحدا يرويه بهذا اللفظ إلا مسلم البطين | وخالفه أبو بشر في روايته ، وليس حديث مسلم بالمحفوظ عن النبي - [ & ] - | وإنما هذا الحديث عندي - والله أعلم - مجمل ؛ لأنه لم | يخبرها كيف تقضيه بنفسها أو تطعم عن كل يوم مسكينا . |(@)(@@) 5005 - حدثنا عبد الله بن سعيد ، قال : نا أبو خالد عن | الأعمش عن الحكم ومسلم البطين ، عن سعيد بن جبير ، وعطاء | ومجاهد ، عن ابن عباس - رضي الله عنهما - قال : جاءت امرأة إلى النبي | - [ & ] - فقالت : إن أختي ماتت وعليها صيام شهرين | متتابعين فقال : ' أرأيت لو كان على أختك دينا أكنت تقضينه ؟ ' قالت : | نعم ، قال : ' فحق الله أحق ' . |(@)(@@) 5006 - حدثنا أبو موسى قال : نا وهب بن جرير قال : نا شعبة | عن مخول ، عن مسلم البطين ، عن سعيد بن جبير ، عن ابن عباس . | PageV11P234 |(@)(@@) 5007 - وحدثنا محمد بن عبد الملك القرشي قال : نا أبو عوانة ، | عن مخول ، عن مسلم البطين ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - أن النبي - [ & ] - كان يقرأ يوم الجمعة | في صلاة الصبح ب : ^ ( ألم تنزيل ) ^ ، و ^ ( هل أتى على 
ms1294	 الإنسان ) ^ .(@)(@@) وزاد أبو عوانة عن مسلم ، عن سعيد ، عن ابن عباس ، ويقرأ في | الجمعة بسورة الجمعة و ^ ( إذا جاءك المنافقون ) ^ . |(@)(@@) 5008 - وحدثناه محمد بن عثمان قال : نا عبيد الله بن موسى ، | عن إسرائيل ، عن أبي إسحاق ، عن مسلم البطين ، عن سعيد بن | PageV11P235 | جبير ، عن ابن عباس - رضي الله عنهما - عن النبي - [ & ] - | أنه كان يقرأ في صلاة الفجر يوم الجمعة : ^ ( ألم تنزيل ) ^ | السجدة ، و ^ ( هل أتى على الإنسان ) ^ .(@)(@@) وهذا الحديث لا نعلم رواه : كان النبي - [ & ] - يقرأ | في الجمعة بسورة الجمعة ، والمنافقين . إلا من حديث مسلم عن سعيد بن | جبير ، عن ابن عباس ، ولا نعلم أسند أبو إسحاق ، عن مسلم غير هذا | الحديث . |(@)(@@) 5009 - حدثنا يوسف بن موسى قال : نا جرير ، عن الأعمش ، | عن مسلم البطين والمنهال ، عن سعيد بن جبير ، عن ابن عباس - رضي الله | عنهما - قال : أنزل الله القرآن إلى سماء الدنيا ليلة القدر جملة واحدة ، كان | جبريل ينزله - يعني : على النبي - [ & ] - . |(@)(@@) 5010 - حدثنا محمد بن المثنى أبو موسى قال : نا محمد بن | PageV11P236 | جعفر قال : نا شعبة عن سماك - يعني ابن حرب - عن سعيد بن جبير ، | عن ابن عباس - رضي الله عنهما - قال : قال رسول الله - [ & ] - : | ' يدخل عليكم رجل يدخل بعيني شيطان ' فدخل رجل أزرق | فقال : يا محمد علام يشتمني أو علام يسبني هذا ؟ قال : وجعل يحلف | فنزلت هذه الآية : ^ ( ويحلفون على الكذب وهم يعلمون ) ^ الآية والآية | الأخرى . |(@)(@@) 5011 - حدثنا أحمد بن محمد الأنماطي قال : نا محمد بن سعيد | قال : نا عمرو بن أبي قيس عن سماك ، عن سعيد بن جبير ، عن ابن | PageV11P237 | عباس - رضي الله عنهما - أن النبي - [ & ] - قنت ثلاثين | صباحا في صلاة الضحى . |(@)(@@) 5012 - وحدثناه عبد الله بن معاوية قال : نا ثابت أبو زيد وهو | ابن يزيد عن هلال بن خباب ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - أن [ 287 ] النبي - [ & ] - قنت ثلاثين | صباحا .(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن سماك إلا عمرو بن أبي قيس | PageV11P238 | وقد روي عن النبي - [ & ] - في قنوته من وجوه 
ms1295	 بألفاظ | مختلفة ، فذكرنا كل حديث منهما بلفظه في موضعه . |(@)(@@) 5013 - حدثنا محمد بن المثنى قال : نا أبو داود قال : نا شعبة | عن أبي بشر عن سعيد بن جبير ، عن ابن عباس . |(@)(@@) 5014 - وحدثنا عبد الله بن سعيد قال : نا عبد الله بن إدريس عن | أبي إسحاق عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - أن | رسول الله - [ & ] - توفي وأنا ابن خمس عشرة . وقال في | حديث ابن إدريس : قبض النبي - [ & ] - وأنا ختين . |(@)(@@) 5015 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله ، | عن إسرائيل ، عن أبي إسحاق ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : سئل : مثل من كنت حيث توفي النبي - [ & ] - ؟ | PageV11P239 | قال : أنا يومئذ مختون . |(@)(@@) 5016 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا | إسرائيل ، عن أبي إسحاق ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : كان النبي - [ & ] - يوتر ب : | ^ ( سبح اسم ربك الأعلى ) ^ و ^ ( قل يا أيها الكافرون ) ^ و ^ ( قل هو | الله أحد ) ^ .(@)(@@) ومعنى هذا الحديث عندنا - والله أعلم - أنه كان يجعل هذه السور | فيما يقرؤه في وتره ويسمي صلاة الليل وترا ، وأن الوتر لا يجوز إلا أن | يكون ركعة ، هذا معنى فعل رسول الله - [ & ] - وقوله . |(@)(@@) 5017 - حدثنا الحسين بن علي البغدادي المعروف بابن علويه | قال : نا حجاج بن محمد قال : نا يونس بن أبي إسحاق عن | PageV11P240 | أبيه ، عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - قال : ولد | النبي - [ & ] - عام الفيل .(@)(@@) وهذا الحديث لا نعلمه رواه عن يونس بن أبي إسحاق إلا حجاج | ابن محمد وكان ثقة . |(@)(@@) 5018 - حدثنا أبو موسى قال : نا محمد بن جعفر قال : نا | شعبة ، عن عطاء بن السائب ، عن سعيد بن جبير ، عن ابن عباس ، وعن | عدي بن ثابت ، عن سعيد ، عن ابن عباس رفعه أحدهما إلى النبي - [ & ] - | قال : ' إن جبريل كان يدس في فم فرعون الطين مخافة | أن يقول لا إله إلا الله ' وقال غيره : ' مخافة أن تدركه الرحمة ' . |(@)(@@) 5019 
ms1296	 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله بن | PageV11P241 | موسى قال : نا ابن أبي ليلى عن المنهال بن عمرو عن سعيد بن | جبير ، عن ابن عباس - رضي الله عنهما - قال : أتى النبي - [ & ] - | رجل فقال : إن على أمي رقبة مؤمنة وعندي أمة سوداء . فقال | النبي - [ & ] - : ' ائتني بها ' فقال لها رسول الله - [ & ] - : | ' أتشهدين أن لا إله إلا الله وأني رسول الله ؟ ' قالت : نعم ، | قال : ' فأعتقها ' .(@)(@@) وهذا الحديث قد روي بنحو معناه عن النبي - [ & ] - | من وجوه بألفاظ مختلفة نذكر كل لفظ منها في موضعه بإسناده . |(@)(@@) 5020 - حدثنا محمد بن عثمان قال : نا عبيد الله بن موسى عن | العلاء بن صالح ، عن المنهال بن عمرو قال : حدثني سعيد بن جبير ، | قال : أتى ابن عباس رجل فقال : أنزل على رسول الله - [ & ] - | PageV11P242 | عشرا بالمدينة وعشرا بمكة ، قال : ممن سمعت هذا ؟ قال : بلغني | أو سمعت الناس يقولون . فقال ابن عباس : لقد أنزل عليه بمكة عشرا | وخمس وأكثر .(@)(@@) وهذا الكلام لا نعلمه يروى عن النبي - [ & ] - إلا | من هذا الوجه وقد روي عن ابن عباس بخلاف هذا اللفظ . |(@)(@@) 5021 - حدثنا الحسين بن منصور قال : نا أبو الجواب قال : نا | عمار بن رزيق عن الأعمش عن المنهال عن سعيد عن ابن عباس ، | عن النبي - [ & ] - . |(@)(@@) 5022 - وحدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن الحكم عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - | PageV11P243 | أن الصعب بن جثامة أهدى إلى رسول الله - [ & ] - | وهو بقديد وهو محرم لحم حمار وحشي ، فرده رسول الله - [ & ] - | وهو يقطر دما .(@)(@@) وهذا الحديث قد روي عن ابن عباس من وجوه فذكرنا كل | حديثه منها بلفظه ، في موضعه ، ولا نعلم روى هذا الحديث عن | الأعمش عن المنهال إلا عمار بن رزيق ، وقد خالفه أبو معاوية فرواه عن | الأعمش عن حبيب عن سعيد بن جبير عن ابن عباس وزاد فيه : ' لولا أنا | محرمون لقبلناه منك ' وإنما ذكرناه لاختلاف الأعمش لنبين ذلك . حدثناه | أبو موسى عن أبي معاوية . |(@)(@@) 5023 - حدثنا محمد بن 
ms1297	 المثنى قال : نا أبو معاوية قال : نا | الأعمش عن حبيب عن سعيد بن جبير ، عن ابن عباس - رضي الله | عنهما - قال : جمع رسول الله - [ & ] - بين الظهر والعصر | والمغرب والعشاء بالمدينة من غير خوف ولا مطر . فقيل له : ما أراد | بذلك ؟ قال : أراد ألا يحرج أمته .(@)(@@) وهذا الحديث زاد فيه حبيب : من غير خوف ولا مطر . وغيره لا | يذكر المطر ، على أن عبد الكريم قد قال نحو ذلك ، والحفاظ يروونه : من | PageV11P244 | غير خوف ولا عذر . |(@)(@@) 5024 - حدثنا أبو موسى قال : نا يحيى بن حماد قال : نا أبو عوانة | عن الأعمش ، عن أبي صالح ، عن أبي هريرة - رضي الله عنه - عن | النبي - [ & ] - [ 288 ] قال : ' تجوزوا في الصلاة فإن | خلفكم الضعيف والكبير وذو الحاجة ' . |(@)(@@) 5025 - حدثنا أبو موسى قال : نا يحيى بن حماد قال : نا أبو عوانة | عن الأعمش ، عن حبيب ، عن سعيد بن جبير ، عن ابن عباس ، عن | النبي - [ & ] - بمثل ذلك .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن الأعمش عن حبيب إلا أبا | عوانة . |(@)(@@) 5026 - وحدثنا يوسف بن موسى قال : نا جرير عن | PageV11P245 | الأعمش ، عن حبيب أو عدي ، عن سعيد بن جبير ، عن ابن عباس | - رضي الله عنهما - قال : لا يبغض الأنصار رجل يؤمن بالله واليوم | الآخر . |(@)(@@) 5027 - حدثنا محمد بن مرزوق قال : نا عبد الله بن رجاء | قال : نا المسعودي ، عن حبيب بن أبي ثابت ، عن سعيد بن جبير ، عن | PageV11P246 | ابن عباس - رضي الله عنهما - أن رجلا جاء إلى النبي - [ & ] - | فقال : إني نذرت أن أذبح ببوانة . فقال : ' لعل في قلبك من | الجاهلية شيء ' قال : لا . قال : ' فأوف بنذرك ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ عن ابن عباس إلا من | رواية المسعودي ، عن حبيب ، عن سعيد ، عن ابن عباس . |(@)(@@) 5028 - حدثنا محمد بن عبد الله قال : نا عبد الرحمن بن غزوان | قال : نا المسعودي عن حبيب عن سعيد بن جبير عن ابن عباس | - رضي الله عنهما - أن النبي - [ & ] - قال : ' أول من يقوم | - أو : أول من يدعى - يوم القيامة الحمادون لله على 
ms1298	 كل حال ' . | PageV11P247(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا بهذا الإسناد ، ورواه | عن حبيب المسعودي وقيس . |(@)(@@) 5029 - حدثنا عمر بن الخطاب قال : نا قبيصة قال : نا سفيان ، | عن حبيب ، عن سعيد بن جبير عن ابن عباس - رضي الله عنهما - قال : | لما نزلت : ^ ( وأنذر عشيرتك الأقربين ) ^ جعل رسول الله - [ & ] - | يدعوهم قبائل قبائل .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه عن حبيب عن سعيد عن ابن | عباس إلا الثوري ، ولا نعلم أحدا يرويه عن الثوري إلا معاوية بن هشام | وقبيصة . |(@)(@@) 5030 - حدثنا محمد بن عثمان قال : نا عبيد الله قال : نا | سفيان عن حبيب ، عن سعيد ، عن ابن عباس . | PageV11P248 |(@)(@@) 5031 - وحدثنا أبو بريد قال : نا مؤمل ، عن سفيان ، عن | حبيب ، عن سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - أن | النبي - [ & ] - لبى حتى رمى جمرة العقبة .(@)(@@) وغير حبيب يرويه عن ابن عباس عن الفضل بن عباس . |(@)(@@) 5032 - حدثنا أسيد بن عاصم قال : نا عامر بن إبراهيم قال : | نا يعقوب القمي عن جعفر بن أبي المغيرة ، عن سعيد بن جبير ، عن | PageV11P249 | ابن عباس - رضي الله عنهما - قال : خرج إلينا رسول الله - [ & ] - | وقد أظلتنا سحابة ونحن نطمع فيها فقال : ' إن الملك الذي | يسوقها دخل علي فسلم علي ، وأخبرني أنه يسوقها إلى وادي | كذا ' . |(@)(@@) 5033 - حدثنا إسماعيل بن عبد الله الأصبهاني قال : نا حسن | ابن حفص قال : نا خطاب بن جعفر بن أبي المغيرة ، عن أبيه ، عن | سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - قال : كان رسول | الله - [ & ] - يطوف في النخل بالمدينة فجعل الناس | يقولون : فيها صاع ، فيها وسق . فقال رسول الله - [ & ] - : | ' فيها كذا وكذا ' ثم قال رسول الله - [ & ] - : ' إنما أنا | بشر ، فما حدثتكم عن الله فهو حق ، وما قلت فيه من قبل نفسي فإنما | أنا بشر أخطئ وأصيب ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس إلا من هذا الوجه بهذا | الإسناد . | PageV11P250 |(@)(@@) 5034 - حدثنا علي بن حرب الرازي قال : نا محمد بن سعيد | ابن سابق قال : نا يعقوب بن عبد 
ms1299	 الله الأشعري - وهو القمي - عن | جعفر ابن أبي المغيرة عن سعيد بن جبير ، عن ابن عباس - رضي الله | عنهما - قال : قال رجل : يا رسول الله ، من أولياء الله ؟ قال : ' الذين إذا | رؤوا ذكر الله ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا من هذا الوجه بهذا | الإسناد ، وقد رواه غير محمد بن سعيد عن يعقوب عن جعفر ، عن سعيد | ابن جبير مرسلا . |(@)(@@) 5035 - حدثنا محمد بن عثمان بن كرامة قال : نا عبيد الله | PageV11P251 | قال : نا يعقوب - يعني القمي - عن جعفر بن أبي المغيرة عن سعيد بن | جبير ، عن ابن عباس - رضي الله عنهما - أن النبي - [ & ] - | كان لا يفطر أيام البيض في سفر ولا حضر .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا من هذا الوجه بهذا | الإسناد . |(@)(@@) 5036 - حدثنا أبو هشام محمد بن يزيد الرفاعي قال : نا وكيع | قال : نا سفيان عن سلمة بن كهيل ، عن عمران السلمي ، عن ابن عباس | - رضي الله عنهما - قال : سأل أهل مكة النبي - [ & ] - أن | يجعل لهم الصفا ذهبا ، وأن يحول الجبال عنهم حتى يزرعوا . فقيل : إن | PageV11P252 | شئت أن نؤتيهم الذي سألوا فإن كفروا أهلكوا كما هلك من كان | قبلهم ، فأنزل الله - تبارك وتعالى - : ^ ( وما منعنا أن نرسل بالآيات إلا أن | كذب بها الأولون وآتينا ثمود الناقة مبصرة ) ^ [ 289 ] . |(@)(@@) 5037 - وحدثنا أبو هشام قال : نا وكيع قال : نا طلحة | القناد عن جعفر بن أبي المغيرة عن سعيد بن جبير ، عن ابن عباس ، | عن النبي - [ & ] - بنحوه .(@)(@@) وهذا الحديث لم نسمعه إلا من أبي هشام حديث طلحة القناد عن | PageV11P253 | جعفر . |(@)(@@) 5038 - وحدثنا يوسف بن موسى قال : نا جرير عن | الأعمش ، عن جعفر بن أبي وحشية ، وهو أبو بشر ، عن سعيد بن | جبير ، عن ابن عباس - رضي الله عنهما - قال : سأل أهل مكة النبي | - [ & ] - أن يجعل لهم الصفا ذهبا . . . ثم ذكر نحوه .(@)(@@) وهذا الحديث لا نعلمه يروى عن النبي - [ & ] - من | وجه صحيح إلا من هذا الوجه . |(@)(@@) 5039 - حدثنا إبراهيم بن هانئ قال : نا محمد بن عبد الواهب | قال 
ms1300	 : نا يعقوب القمي عن جعفر بن أبي المغيرة ، عن سعيد بن جبير ، | عن ابن عباس - رضي الله عنهما - قال : عاد رسول الله - [ & ] - | رجلا من الأنصار ، فلما دنا من منزله سمعه يتكلم في الداخل فلما | PageV11P254 | استأذن عليه دخل فلم ير أحدا فقال له رسول الله - [ & ] - : | ' سمعتك تكلم غيرك ' فقال : يا رسول الله ، لقد دخلت الداخل | اغتماما بكلام الناس مما بي من الحمى ، فدخل علي رجل ما رأيت رجلا | قط بعدك أكرم مجلسا ولا أحسن حديثا قال : ' ذاك جبريل وإن منكم | لرجال لو أن أحدهم يقسم على الله لأبره ' .(@)(@@) وهذا الحديث لا نعلمه يروى عن ابن عباس عن النبي - [ & ] - | إلا من هذا الوجه بهذا الإسناد . |(@)(@@) 5040 - حدثنا يوسف بن موسى قال : نا جرير ، عن | الأعمش ، عن جعفر بن أبي وحشية ، عن سعيد بن جبير ، عن ابن | عباس - رضي الله عنهما - قال : كان رسول الله - [ & ] - | PageV11P255 | يرفع صوته بالقرآن ويخفض أحيانا فأنزل الله تبارك وتعالى : ^ ( ولا تجهر | بصلاتك ولا تخافت بها وابتغ بين ذلك سبيلا ) ^ . |(@)(@@) 5041 - وحدثناه محمد بن مسكين قال : نا الفاريابي ، قال : نا | سفيان عن الأعمش ، عن جعفر بن أبي وحشية ، عن سعيد بن جبير ، | عن ابن عباس عن النبي - [ & ] - بنحوه .(@)(@@) وهذا الحديث لا نعلم أحدا يرويه بهذا اللفظ بإسناد متصل إلا عن | PageV11P256 | ابن عباس بهذا الإسناد . |(@)(@@) 5042 - حدثنا أبو موسى محمد بن المثنى قال : نا أبو أحمد | الزبيري قال : نا سفيان عن الأعمش ، عن جعفر بن أبي وحشية ، عن | سعيد بن جبير ، عن ابن عباس - رضي الله عنهما - قال : كانوا يكرهون أن | يرضخوا لأنسابهم وهم مشركون فنزلت : ^ ( ليس عليك هداهم ) ^ حتى | بلغ : ^ ( وما تنفقوا من خير فإن الله به عليم ) ^ . فرخص لهم .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا من هذا الوجه بهذا | الإسناد . | PageV11P257 |(@)(@@) 5043 - حدثنا محمد بن المثنى قال : نا عثمان بن عمر قال : نا | شعبة ، عن أبي بشر ، عن سعيد بن جبير ، عن ابن عباس - رضي الله | عنهما - أن النبي - [ & ] - قال : ' نصرت بالصبا ، | وأهلكت عاد بالدبور ' .(@)(@@) وهذا الحديث 