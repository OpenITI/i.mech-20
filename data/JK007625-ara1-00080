ms61	 بسلوة % % ثباتي على إبرام وجدي نقيضها % % 13(@)(@@) % أأغضي على حد من الضيم مرمض % % وسيفي بتار الحدود رميضها % % 14(@)(@@) % أغثني بالإرشاد فالطرق إنما % % يدل بها خريتها ونفيضها % % 15(@)(@@) % أعني على بلواى فالعمر غمرة % % يعاين أهوال الردى من يخوضها % % 16(@)(@@) % شجاني انضمامي والخطوب كثيرة % % إلى خطة يؤذي الأسود بعوضها % % 17(@)(@@) % تساوى لديها غثها وسمينها % % وأودى بها منحوضها ونحيضها % % 18(@)(@@) % ولي عند تحقيق المعاني أدلة % % تزيف في وقت النضار نقوضها % % 19(@)(@@) % حظوظي على علاتها وشتاتها % % كأبيات شعر ما يصح عروضها % % 20(@)(@@) % جوامد لكن نار عزمي تذيبها % % جوامح لكن طول صبري يروضها % % PageV01P238 21(@)(@@) % ستشرق في أوج الصعود سعودها % % وإن زاد إظلام الحظوظ حضيضها % % 22(@)(@@) % بجود أمير المؤمنين وسيبه % % تفيض على أرض الأماني فيوضها % % 23(@)(@@) % إمام البرايا خيرها مستضيئها % % غزير الأيادي جمها مستفيضها % % 24(@)(@@) % تفيض لترويض الرجاء مياهه % % وللنجح يرجى عدها ونضيضها % % 25(@)(@@) % جزيل العطايا وافر الفضل وارف الظلال % % طويل المأثرات عريضها % % 26(@)(@@) % تبدل بالأموال آمال وفده % % فكن فاقة منا بوجد يعيضها % % 27(@)(@@) % ويفتح من مداحه باللها اللها % % وقد حال من دون القريض جريضها % % 28(@)(@@) % إذا اقترحت منا القرائح مدحه % % تسابق من شوق إليه قريضها % % 29(@)(@@) % مواليه مشكور المساعي نجيحها % % وشانيه مردود المباغي دحوضها % % 30(@)(@@) % أتتنا وفود الكرمات بجوده % % ووافى إلينا قضها وقضيضها % % PageV01P239 31(@)(@@) % إذا ظمئت آمالنا وردت له % % بحار لهى يروي العطاش فضيضها % % 32(@)(@@) % من الأسرة الغر التي بولائها % % أفاض المبرات الغزار مفيضها % % 33(@)(@@) % مكرمة أعراضها ومهانة % % لإظهار عز الأولياء عروضها % % 34(@)(@@) % موالاتهم في الله عن صدق نية % % غسول لأدران الذنوب رحوضها % % 35(@)(@@) % هم الكاشفو الغماء في كل لزبة % % عدا بنيوب النائبات عضوضها % % 36(@)(@@) % أضاء بهم شرق البلاد وغربها % % وحيزت لهم أطوالها وعروضها % % 37(@)(@@) % ومن عجب صلت لقبلة بأسهم % % رؤوس أعاد من ظباهم محيضها % % 38(@)(@@) % تدل على الرعب الذي في قلوبها % % مفاصل للأعداء شاج نقيضها % % 39(@)(@@) % وما هامر هام من الودق إن بكى % % تبسم مرهوم الرياض أريضها % % 40(@)(@@) % واديها وطاب نسيمها % % وغرد شاديها وغنى غريضها % % PageV01P240 41(@)(@@) % بأغزر من جود الإمام الذي به % % إذا شكت 
ms62	 الآمال يشفى مريضها % % 42(@)(@@) % حباني على ضن الزمان بثروة % % حلا زبدها في عيشتي ومخيضها % % 43(@)(@@) % جناح رجائي ريش والناس منهم % % رجائي محصوص الخوافي مهيضها % % 44(@)(@@) % إليك أمير المؤمنين أحثها % % نياقا تردى بالهزال نغوضها % % 45(@)(@@) % طلائع آمال رذايا مطالب % % تداعت بتعريق النحول نحوضها % % 46(@)(@@) % حوامل آراب حوامل نجحها % % إذا عقمت ميلادها ونفوضها % % 47(@)(@@) % لئن عافت الأقدار عن قصد بابكم % % وعارضني عند المسير عروضها % % 48(@)(@@) % فإني أنى كنت في ظل طاعة % % لغير هداكم ما تقام فروضها % % 49(@)(@@) % سأطلب ربي في ورود بحاركم % % وأهجر قوما أظمأتني بروضها % % PageV01P241 البحر : بسيط تام 1(@)(@@) % يا يوسف الحسن والإحسان يا ملكا % % بجده صاعدا أعداؤه هبطوا % % 2(@)(@@) % حللت من وسط العلياء في شرف % % ومركز الشمس من أفلاكها الوسط % % 3(@)(@@) % هنيت صونك دمياط التي اجتمعت % % لها الفرنج فما حلوا ولا ربطوا % % 4(@)(@@) % مصر بيوسفها أضحت مشرفة % % وكل أمر لها بالعدل منضبط % % 5(@)(@@) % وحين وافى صلاح الدين أصلحها % % فللمصالح من أيامه نمط % % PageV01P242 البحر : طويل 1(@)(@@) % عفا الله عنكم مالكم أيها الرهط % % قسطتم ومن قلب المحب لكم قسط % % 2(@)(@@) % شرطتم له حفظ الوداد وخنتم % % حنانيكم ما هكذا الود والشرط % % 3(@)(@@) % جعلتم فؤاد المستهام بكم لكم % % محطا فعنه ثقل همكم حطوا % % 4(@)(@@) % إذا كنتم في القلب والدار قد نأت % % فسيان من أحبابه القرب والشحط % % 5(@)(@@) % ثوى همه لما ثوى الوجد عنده % % مقيما وشط الصبر في جيرة شطوا % % 6(@)(@@) % وأرقه طيف طوى نحوه الدجى % % وقد كاد جيب الليل بالصبح ينعط % % 7(@)(@@) % تشاغلتم عنه وثوقا بوده % % كأن رضاكم عن محبكم سخط % % 8(@)(@@) % جزعت غداة الجزع لما رحلتم % % وأسقطني من بينكم ذلك السقط % % 9(@)(@@) % ملكتم فأنكرتم قديم مودتي % % كأن لم يكن في البين معرفة قط % % 10(@)(@@) % فدت مهجتي من لا يذم لمهجتي % % إذا حاكمته وهو في الحكم مشتط % % PageV01P243 11(@)(@@) % يريك ابتساما عن شتيت مقبل % % كأن نظيم الدر ألفه السمط % % 12(@)(@@) % وما كنت أدري قبل سطوة طرفه % % بأن ضعيفا فاترا مثله يسطو % % 13(@)(@@) % وهب أن بالقرطين منه معلق % % لذنب الهوى قلبي فلم علق القرط % % 14(@)(@@) % وأهيف 
ms63	 للإشفاق من ضعف خصره % % محل نطاق للقلوب به ربط % % 15(@)(@@) % على قربه في الحالتين محسد % % من الثغر والشعر الأراكة والمشط % % 16(@)(@@) % بوجنته نور المدامة مشرق % % ومقلته نشوى وفي فيه إسفنط % % 17(@)(@@) % تزين عذاريه كتابة حسنه % % ومن خاله في وجنتيه لها نقط % % 18(@)(@@) % فؤادك خال يا خليلي فلا تلم % % فؤادا سباه الخال والخد والخط % % 19(@)(@@) % يلازم قلبي في الهوى القبض مثلما % % يلازم كف الناصر الملك البسط % % 20(@)(@@) % مليك حوى الملك العقيم بضبطه % % كريم وما للمال في يده ضبط % % PageV01P244 21(@)(@@) % ومولى سرير الملك حف بشخصه % % كما حف بالإنسان من ناظر وسط % % 22(@)(@@) % مليك لنجم النجح من أفق عزه % % سنا ولطير السعد في وكره قحط % % 23(@)(@@) % إذا لثمت أيدي الملوك فعنده % % مدى الدهر إجلالا له تلثم البسط % % 24(@)(@@) % لنوم الرعايا وادعين سهاده % % إذا وادعوا الأملاك في نومهم غطوا % % 25(@)(@@) % أكف ملوك العصر لا وكف عندها % % وكف المليك الناصر البحر لا الوقط % % 26(@)(@@) % عطايا نقود لا نسايا فكلها % % تعجل لا وعد هناك ولا قسط % % 27(@)(@@) % أغر لكف الكفر كف ببأسه % % كما لفقار الفقر من جوده وهط % % 28(@)(@@) % أياديه غر وهي غير مغبة % % وإحسانه غمر وليس له غمط % % 29(@)(@@) % يحب ضجيج الشاكرين إذا دعوا % % ويهوى سؤال المعتفين إذا أطوا % % 30(@)(@@) % ويعبق عرف العرف والسقط عنده % % وند الندى لا البان والرند والقسط % % PageV01P245 31(@)(@@) % إلى طوله المعروف طول يد الرجا % % وفي بحر جدواه لآمالنا غط % % 32(@)(@@) % صنائعه ربط الكرام وإنها % % لوفد أياديه المصانع والربط % % 33(@)(@@) % يمر ويحلو حالة السخط والرضا % % فنعمته دأب ونقمته فرط % % 34(@)(@@) % من القوم تلقاهم عن النكر إن دعوا % % بطاء وإن يدعوا إلى العرف لا يبطلوا % % 35(@)(@@) % هم رضعوا در الحجى في مهودهم % % أما جد وانضمت على السؤدد القمط % % 36(@)(@@) % يصبون فيما يقصدون فكم رموا % % بسهم الثراء المملقين فلم يخطوا % % 37(@)(@@) % متى يقدروا يعفوا وإن يعدوا يفوا % % وإن يبذلوا يغنوا وإن يسألوا يعطوا % % 38(@)(@@) % يصيب الذي يصبو إلى قصد بابهم % % في غير هذا القصد يخطي الذي يخطو % % 39(@)(@@) % وما أسعد الملك الذي نحو بابه 
ms64	 % % مطايا بأبناء الرجاء غدت تمطوا % % 40(@)(@@) % وما روضة غناء حسنا كأنما % % لوارفها من نسج نوارها مرط % % PageV01P246 41(@)(@@) % إذا قادني للنرجس النضر ناضر % % تلاه عذار للبنفسج مختط % % 42(@)(@@) % وللورد خد للحياء مورد % % وللبان قد جيده أبدا يعطو % % 43(@)(@@) % تلوح به الأشجار صفا كأنها % % سطور كتاب والغدير لها كشط % % 44(@)(@@) % تغني على أعوادها الورق مثلما % % يرتل للتوراة ألحانها سبط % % 45(@)(@@) % كأن سقيط الطل عبرة مغرم % % وبارقة من نار لوعته سقط % % 46(@)(@@) % ترى لمحيا الشمس من هامر الحيا % % لثام حياء دونه ليس ينحط % % 47(@)(@@) % بأزكى وأذكى منك حسنا وإنما % % بحسناك لا بالروض للعائذ الغبط % % 48(@)(@@) % لك الصدر والباع الرحيبان في العلى % % وذاك المحيا الطلق والأنمل السبط % % 49(@)(@@) % لراجيكم ماء البشاشة والندى % % جميعا وحظ الحاسد النار والنفط % % 50(@)(@@) % عنالك طوعا نيل مصر ودجلة العراق % % ودان العرب والعجم والقبط % % PageV01P247 51(@)(@@) % وللنيل شط ينتهي سيبه به % % ونيلك للراجين نيل ولا شط % % 52(@)(@@) % وعفوك ورد والجناة جناته % % وبيضك شوك في العداة لها خرط % % 53(@)(@@) % عدوك مثل الشمع في نار حقده % % له عنق إصلاح فاسده القط % % 54(@)(@@) % فداؤك ممتد المطال محجب % % وحاجبه للكبر والعجب ممتط % % 55(@)(@@) % فداؤك قوم في الندي وفي الندى % % وجوههم سهم وأسهمهم مرط % % 56(@)(@@) % لتبك دما عين العدو فقد جرى % % على الأرض من أوداجه دمه العبط % % 57(@)(@@) % منعت حمى الإسلام للنصر معطيا % % غداة عوت من دونه الأذؤب المعط % % 58(@)(@@) % وصلت وكم فرجت عنا ملمة % % بسهم الرزايا في الكرام لها لهط % % 59(@)(@@) % بعودك عاد الحق واتضح الهدى % % وهب نسيم النصر وانفرج الضغط % % 60(@)(@@) % وأنت أجرت الشام من شؤم جاره % % ولم يكف رهط الكفر حتى بغى رهط % % PageV01P248 61(@)(@@) % أجرت وقد جاروا ودنت وقد عدوا % % وصلت وقد خاروا ولنت وقد لطوا % % 62(@)(@@) % فلا يعبأ المولى بمن ملء جأشه % % هوى وبقوم حشو جيشهم زط % % 63(@)(@@) % كثير تعديهم قليل غناؤهم % % وهم ولا أصابوا رشدهم همل رهط % % 64(@)(@@) % عدلت فلا ظلم وطلت فلا مدى % % وقلت فلا مين وجدت فلا قحط % % 65(@)(@@) % فميز مكان المخلصين فإنما الأعادي % % أناس في رؤوسهم خلط % % 66 
ms65	(@)(@@) % وقرب وليا صح فيك ضميره % % ولا يأمن التمساح من دأبه السرط % % 67(@)(@@) % نبا بي مقام الجاهلين فعفته % % وقد نضنضت للنهش حياته الرقط % % 68(@)(@@) % هم منعوا رفدي قبول ونائل % % وذا وشل برض وذا أكل خمط % % 69(@)(@@) % وكم مطمع في خيره بشر وجهه % % ومشتمل منه على شره الإبط % % 70(@)(@@) % لأبدى بلا عذر حظوظ فضائلي % % نفار العذارى من عذار به وخط % % PageV01P249 71(@)(@@) % وجئتك ألقى العز عندك ملقيا % % قلائد للأسماع من درها لقط % % 72(@)(@@) % أعرني جميلا واصطنعني واصف لي % % جميلك حتى يشمت الحاسد الملط % % 73(@)(@@) % أعني فعين الفضل عان مقيد % % بعقلة حرمان نداك لها نشط % % 74(@)(@@) % وأوعز بتشريفي ورسمي فإنه % % لحمدي جزاء قد تقدمه الشرط % % 75(@)(@@) % إلام زماني لا يزال مسلطا % % على نابه من أهله نابه السلط % % 76(@)(@@) % سعت نحوكم مني مطايا مطالب % % لأنسعها في النجح عندكم مغط % % 77(@)(@@) % فدم ظافرا أبا المظفر بالعدى % % حليف قبول لا يكون لها حبط % % 78(@)(@@) % بقيت ولا زالت عداك مفيدة % % سعودا ولا تحسن صعودا ولا هبط % % 79(@)(@@) % ولو كنت جارا للمعري لم يقل % % لمن جيرة سيموا النوال فلم ينطوا % % PageV01P250 البحر : منسرح 1(@)(@@) % اسلم لبكر الفتوح مفترعا % % ودم لملك البلاد منتزعا % % 2(@)(@@) % فإن أولى الورى بها ملك % % غدا بعبء الخطوب مضطلعا % % 3(@)(@@) % إن ضاق أمر فغير همته % % لكشف ضيق الأمور لن يسعا % % 4(@)(@@) % يا محيي العدل بعد ميتته % % ورافع الحق بعدما اتضعا % % 5(@)(@@) % ونور دين الهدى الذي قمع الشرك % % وعفى الضلال والبدعا % % 6(@)(@@) % أنت سليمان في العفاف وفي الملك % % وتحكي بزهدك اليسعا % % 7(@)(@@) % حزت البقا والحياء والكرم المحض % % وحسن اليقين والورعا % % 8(@)(@@) % أسقطت أقساط ما وجدت من المكس % % بعدل والقاسط ارتدعا % % 9(@)(@@) % ولم تدع في ابتغاء مصلحة الدين % % لنا باقيا ولن تدعا % % 10(@)(@@) % وكل ما في الملوك مفترق % % من المعالي لملكك اجتمعا % % PageV01P251 11(@)(@@) % همتك الربط والمدارس تبنيها % % ثوابا وتهدم البيعا % % 12(@)(@@) % ما زلت ذا فطنة مؤيدة % % على غيوب الأسرار مطلعا % % 13(@)(@@) % ببأسك البيض والطلى اصطبحت % % بعدلك الذئب والطلا رتعا % % 14(@)(@@) % كم صائد لم يقع له قنص % % في شرك وهو 
ms66	 فيه قد وقعا % % 15(@)(@@) % ومالك حين رمت قلعته % % غدا مطيعا للأمر متبعا % % 16(@)(@@) % عنا خشوعا لرب مملكة % % لغير رب السماء ما خشعا % % 17(@)(@@) % كان مقيما بها على الفلك الأعلى % % شهابا بنوره سطعا % % 18(@)(@@) % لكنما الشهب ما تنير إذا % % لاح عمود الصباح فانصدعا % % 19(@)(@@) % يدفعها طائعا إليك وكم % % عنها إباء بجهده دفعا % % 20(@)(@@) % هي التي في علوها زحل % % كر على وردها وما كرعا % % PageV01P252 21(@)(@@) % وهي التي قاربت عطارد في الأفق % % فلاحا والفرقدين معا % % 22(@)(@@) % كأن منها السها إذا استرق السمع % % أتاها في خيفة ودعا % % 23(@)(@@) % هضبة عز لولاك ما ارتقيت % % وطود ملك لولاك ما فرعا % % 24(@)(@@) % ما قبلت في ارتقاء ذروتها % % من ملك لا رقي ولا خدعا % % 25(@)(@@) % عزت على المالك الشهيد واعطتك % % قيادا ما زال ممتنعا % % 26(@)(@@) % للأب لو جل خطبها لغدا % % محرما لابنه وما شرعا % % 27(@)(@@) % ما زلت محمود في أمورك محمودا % % بثوب الإقبال مدرعا % % PageV01P253 البحر : كامل تام 1(@)(@@) % لا تفن من فرق الفراق الأدمعا % % فهي الشهود على الغرام المدعى % % 2(@)(@@) % واستبق صبرك ما استطعت فإنه % % عون لقلبك إن هما ثبتا معا % % 3(@)(@@) % قلب أصابته العيون ولم يزل % % من مسها بالهاجسات مروعا % % 4(@)(@@) % ما باله قد صد عند صدودهم % % عني ولما ودعوني ودعا % % 5(@)(@@) % ومن التحير أنني أبصرته % % في ظعنهم وسألت عنه الأضلعا % % 6(@)(@@) % أصبحت إذ شيعتهم لثلاثة % % صبري وغمضي والفؤاد مشيعا % % 7(@)(@@) % أو ما اتقيتم حين رعتم سربه % % فيه تقي الدين ذاك الأروعا % % 8(@)(@@) % عمر بن شاهنشاه من هو عامر % % أركان ملك الشام حين تضعضعا % % 9(@)(@@) % خضع العدو بعد تعزز % % لكم وحق عدوكم أن يخضعا % % 10(@)(@@) % من معشر غر يرون جميع ما % % لم يبذلوه في السماح مضيعا % % PageV01P254 11(@)(@@) % في مصر واليمن اجتلينا منهم % % في عصرنا تبعا ليوسف تبعا % % 12(@)(@@) % الحاويان بملك مصر ومكة % % والشام واليمن الحظايا الأربعا % % 13(@)(@@) % لما عصى الأعداء بالعاصي جرى % % بدمائهم طوعا سيولا دفعا % % PageV01P255 البحر : طويل 1(@)(@@) % بنفسي وما أحوى وروحي ومهجتي % % كتاب لأسباب الفضائل جامع % % 2(@)(@@) % يخبر عن قلب حوته أضالع % % ويوم النوى قلبي 
ms67	 نفته الأضالع % % 3(@)(@@) % ومن عجب إنسان عيني ظاميا % % وقد غرقته في المياه المدامع % % PageV01P256 البحر : طويل 1(@)(@@) % تألق برق من تهامة لامع % % يبشر أن الله للشمل جامع % % 2(@)(@@) % يحاكي خفوق القلب مني خفوقه % % فهل راعه مثلي من البين رائع % % 3(@)(@@) % لقد طال ليلي لانتظار صباحكم % % فهل لتباشير الصباح طلائع % % 4(@)(@@) % صفت وضفت في الجود منك وفي العلى % % مشارع بالحسنى لنا ومدارع % % 5(@)(@@) % كأنك شمس الدولة البدر بيننا % % ونحن حواليك النجوم الطوالع % % PageV01P257 البحر : كامل تام 1(@)(@@) % صب تولى حالتيه في الهوى % % جلد له عاص ودمع طيع % % 2(@)(@@) % ذو ناظر ربع الكرى في جفنه % % خال وحوض الدمع منه مترع % % 3(@)(@@) % مولاي شمس الدولة الملك الذي % % شمس السيادة من سناه تطلع % % 4(@)(@@) % لولا أرجي قرب عودك لم يكن % % لي في الحياة لأجل بعدك مطمع % % 5(@)(@@) % قسما ببيت أمه زواره % % والطائفون الساجدون الركع % % 6(@)(@@) % مالي سواك من الحوادث ملجأ % % مالي سواك من النوائب مفزع % % 7(@)(@@) % ولانت فخر الدين فخري في العلى % % وملاذ آمالي وركني الأمنع % % 8(@)(@@) % إلا بخدمتك المجلة موقعي % % والله ما للملك عندي موقع % % 9(@)(@@) % وبغير قربك كل ما أرجوه من % % درك المنى متعذر متمنع % % 10(@)(@@) % النصر إن أقبلت نحوي مقبل % % واليمن إن أسرعت نحوي مسرع % % PageV01P258 البحر : دو بيت 1(@)(@@) % بالله عرفت ما بقلبي صنعوا % % خلوه بنار شوقهم ينصدع % % 2(@)(@@) % ما لم أر شملي بهم يجتمع % % ما أحسبني بعيشتي أنتفع % % PageV01P259 البحر : منسرح 1(@)(@@) % رأيتني بالفقيع منفرا % % أضيع من فقع قاعها الضائع % % 2(@)(@@) % بعت بمصر دمشق عن غرر % % مني فيا غبن صفقة البائع % % 3(@)(@@) % صبري والقلب عاصيان وما % % غير همومي وأدمعي طائعي % % PageV01P260 البحر : بسيط تام 1(@)(@@) % صب لتذكار أهل الجزع ذو جزع % % أطاعه دمعه والصبر لم يطع % % 2(@)(@@) % وكان يطمع في طيف يلم وقد % % بان الرقاد فما في الطيف من طمع % % 3(@)(@@) % يا لائما يدعي نصح المحب ولم % % يترك له وجده سمعا ولم يدع % % 4(@)(@@) % أتعبت نفسك تنهى غير متبع % % حكم الملام وتلحي غير مستمع % % 5(@)(@@) % إن يجد لومي في الجود عاشقه % % توران شاه كلانا 
ms68	 غير مرتدع % % 6(@)(@@) % هو الجواد الذي عشق السماح به % % أفضى إلى أمد في الجود مخترع % % 7(@)(@@) % يا رائد الخصب إن تقصد ذراه تجد % % في ظله خير مصطاف ومرتبع % % PageV01P261 البحر : كامل تام 1(@)(@@) % يا هل لسالف عيشتي بفنائكم % % من عودة محمودة ورجوع % % 2(@)(@@) % قد غبتم عن ناظري ما أذنت % % للقلب شمس مرة بطلوع % % 3(@)(@@) % كنت المشفع في المطالب عندكم % % فغدوت أطلب طيفكم بشفيع % % 4(@)(@@) % أصبحت أقنع بالسلام على النوى % % وبقربكم كم بت غير قنوع % % PageV01P262 البحر : متقارب تام 1(@)(@@) % أيا من له همة في العلى % % لذروتها أبدا فارعه % % 2(@)(@@) % ومن كفه ديمة ما تزال % % بالعرف هامية هامعه % % 3(@)(@@) % وللفضل في سوق أفضاله % % بضائع نافقة نافعه % % 4(@)(@@) % وهل كابن عصرون في عصرنا % % إمام أدلته قاطعه % % 5(@)(@@) % فخير فوائده جمة % % وبحر موارده واسعه % % 6(@)(@@) % أيا شرف الدين شرفتني % % بإهداء رائقة رائعه % % 7(@)(@@) % أطعت أوامرك الساميات % % وما برحت همتي طائعه % % 8(@)(@@) % أرى كل جارحة لي تودد % % لو أنها أذن سامعه % % 9(@)(@@) % وأما الشتاء وكافاته % % وكفك عن كفه الرابعه % % 10(@)(@@) % فنفسي تطيق إذا لم تكن % % بميسور سيدنا قانعه % % PageV01P263 البحر : كامل تام 1(@)(@@) % مقصوده أعصي الهوى وأطيعه % % هذا لعمر هواك لا أسطيعه % % 2(@)(@@) % سمعي أصم عن العذول وعذله % % فعلام يقرع مسمعي تقريعه % % 3(@)(@@) % غلب النزاع إلى الحسان تجلدي % % والقلب مغلوب العزا منزوعه % % 4(@)(@@) % لا تنزعن إلى ملام متيم % % لا يستتب عن النزاع نزوعه % % 5(@)(@@) % وملاحة الرشأ المليح تروقه % % وملامة اللاحي الملح تروعه % % 6(@)(@@) % ياعزه لو لم يعز عزاؤه % % يا ذله إن لم تعنه دموعه % % 7(@)(@@) % وبمهجتي حلو الشمائل عذبها % % لكنه مر الصدود شنيعه % % 8(@)(@@) % نشوان من خمر الصبا قلبي به % % أفديه مخمور الغرام صريعه % % 9(@)(@@) % غصن على حقف يميل ويستوي % % فكأنما يعصيه حين يطيعه % % 10(@)(@@) % رئم وفي قلب المحب كناسه % % قمر وفي ليل العذار طلوعه % % PageV01P264 11(@)(@@) % وكأن قلب محبه إقطاعه % % وكأن خط عذاره توقيعه % % 12(@)(@@) % مساوب سهم اللحظ منه محبه % % ملسوب عقرب صدغه ملسوغه % % 13(@)(@@) % لله عيش بالحمى أسلفته % % والشمل غير مفرق مجموعه % % 14(@)(@@) % أيام دارت للشباب 
ms69	 كؤوسه % % فينا ودرت بالسرور ضروعه % % 15(@)(@@) % رويت بأنواء العهاد عهوده % % وزهت بأنوار الربيع ربوعه % % 16(@)(@@) % أفراجع ما مر من أيامه % % هيهات لا يرجى إلي رجوعه % % 17(@)(@@) % وجدي مقيم ما يزال بظاعن % % توديع قلبي أنسه توديعه % % 18(@)(@@) % ملاك مهجته عليكم حفظها % % فالملك ليس لمالك تضييعه % % 19(@)(@@) % لا تنسبوا قلبي إلي فإنه % % لكم وفيكم جرحه وصدوعه % % 20(@)(@@) % وبيوسف المستنجد بن المقتفي % % دين الهدى سامي العماد رفيعه % % PageV01P265 21(@)(@@) % ضافي رداء الفخر صاف روحه % % نامي ضياء البشر زاك روعه % % 22(@)(@@) % حالي الضمائر بالعفاف وبالتقى % % لله ما تحنو عليه ضلوعه % % 23(@)(@@) % محمر نصل النصر في يوم الوغى % % المغبر مبيض العطاء نصوعه % % 24(@)(@@) % في الأمن إلا ماله وعدوه % % فكلاهما في الحالتين مروعه % % 25(@)(@@) % لله أصل هاشمي طاهر % % طابت وطالت في العلاء فروعه % % 26(@)(@@) % لك نائل محي وبأس مهلك % % فلأنت ضرار الزمان نضوعه % % 27(@)(@@) % يا أفضل الخلفاء دعوة قانع % % برضاك ما كشف القناع قنوعه % % 28(@)(@@) % أيكون مثلي في زمانك ضائعا % % هيهات يا مولاي لست تضيعه % % 29(@)(@@) % أودع جميلا لي أذعه فخير من % % أودعته منك الجميل مذيعه % % 30(@)(@@) % حسب المؤمل منجحا في قصده % % أن الرجاء إلى نداك شفيعه % % PageV01P266 البحر : بسيط تام 1(@)(@@) % هم الملوك ذوو بأس ومكرمة % % إن سالوا أمنوا أو حاربوا خيفوا % % 2(@)(@@) % أغناهمالقدس عن قول الورى فتحت % % عكا وصيدا وبيروت وأرسوف % % 3(@)(@@) % جيش الفرنج إذا لاقى سوابقهم % % كأنه جبل بالريح منسوف % % PageV01P267 البحر : مجزوء الخفيف 1(@)(@@) % مغرم القلب مدنف % % وجده ليس يوصف % % 2(@)(@@) % وعدونا وأخلفوا % % ووفينا ولم يفوا % % PageV01P268 البحر : مجزوء الخفيف 1(@)(@@) % أنا ضيف بربعكم % % أين أين المضيف % % 2(@)(@@) % أنكرتني معارفي % % مات من كنت أعرف % % PageV01P269 البحر : كامل تام 1(@)(@@) % ما بعد يومك للمعنى المدنف % % غير العويل وحسرة المتأسف % % 2(@)(@@) % ما أجرأ الحدثان كيف سطا على الأسد % % المخوف سطا ولم يتخوف % % 3(@)(@@) % من ذا رأى الأسد الهصور فريسة % % أم أبصر الصبح المنير وقد خفي % % 4(@)(@@) % من ثابت دون الكماة سواه إن % % زلت بهم أقدامهم في الموقف % % 5(@)(@@) % ما كان أسنى البدء لو لم يستتر % % ما كان أبهى الشمس 
ms70	 لو لم تكسف % % 6(@)(@@) % ما كنت أخشى أن تلم ملمة % % يوما وأنت لكربها لم تكشف % % 7(@)(@@) % أيام عمرك لم تزل مقسومة % % لله بين تعبد وتعرف % % 8(@)(@@) % متهجدا لعبادة أو تاليا % % من آية أو ناظرا في مصحف % % 9(@)(@@) % فجع الندا والبأس منك بحاتم % % وبحيدر والحلم منك بأحنف % % 10(@)(@@) % بالملك فزت وحزته عن قدرة % % ومضيت عنه بسيرة المتعفف % % PageV01P270 11(@)(@@) % ووصفت يا أسدا لدين محمد % % مدحا بما ملك به لم يوصف % % 12(@)(@@) % وقفوت آثار الشريعة كلها % % وقد اهتدى من للشريعة يقتفي % % 13(@)(@@) % أأنفت من دنياك حين عرفتها % % فلويت وجه العارف المتنكف % % 14(@)(@@) % يا ناصر الدين استعذ بتصبر % % مدن إلى مرضاة رب مزلف % % 15(@)(@@) % وتعز نجم الدين عنه مهنأ % % أبد الزمان بملك مصر ويوسف % % 16(@)(@@) % لا تستطيع سوى الدعاء فكلنا % % إلا بما في الوسع غير مكلف % % PageV01P271 البحر : خفيف تام 1(@)(@@) % هي كتبي فليس تصلح من بعدي % % لغير العطار والإسكافي % % 2(@)(@@) % هي إما مزاود للعقاقير % % وإما بطائن للخفاف % % PageV01P272 البحر : بسيط تام 1(@)(@@) % يا مهديا فقرا جلت قلائدها % % عن وصف مطر لها أو رصف رصاف % % 2(@)(@@) % ومن فضائله عن حصرها حصرت % % في العصر ألسن مداح ووصاف % % 3(@)(@@) % رواقه في العلى ضاف ومورده % % في الفضل للمرتجي إفضاله ضاف % % 4(@)(@@) % تروم مني إنصافا وهل عرفت % % خلائقي غير إحسان وإنصاف % % PageV01P273 البحر : متقارب تام 1(@)(@@) % فديتك من ظالم منصف % % وناهيك من باخل مسعف % % 2(@)(@@) % بلقياك يشفى سقامي الممض % % ولكن بسفك دمي تشتفي % % 3(@)(@@) % وتخلف وعدك لي بالوصال % % حناتيك من واعد مخلف % % 4(@)(@@) % وتستحسن العذر طبعا ومن % % وفى من ذوي الحسن حتى تفي % % 5(@)(@@) % أمثلك كل حبيب جفا % % ومثلي كل حبيب جفي % % 6(@)(@@) % أيا لين العطف قاسي الفؤاد % % بعيشك بالله لن واعطف % % 7(@)(@@) % فما ترك الوجد لي مسكة % % ولا منة لي لم تضعف % % 8(@)(@@) % تلاف قصدك لي متلف % % فؤادي من الأسف المتلف % % 9(@)(@@) % وإن كنت لا بد لي قاتلا % % بما صنع الوجد بي فاكتف % % 10(@)(@@) % تناهيت في قتلتي عامدا % % فحيث انتهيت بقتلي قف % % PageV01P274 11(@)(@@) % ثناياك برئي في رشفها % % وقد طال سقمي 
ms71	 ولم أرشف % % 12(@)(@@) % أنجو ومن قدك السمهري % % لحيني وفي جفنك المشرفي % % 13(@)(@@) % أيا مسرفا في عذابي اقتصد % % أعيذك من شطط المسرف % % 14(@)(@@) % نحولي من خصرك الناحل % % السقيم كعاشقك المدنفف % % 15(@)(@@) % ومن سقم لحظك ذاك المريض % % شفائي وأشفى أنا لو شفي % % 16(@)(@@) % على خطف قلبي يحل الشباك % % عقد وشاحك في مخطف % % 17(@)(@@) % أنا المستهام بذاك القوام % % وذاك الموشح والمعطف % % 18(@)(@@) % وذاك المقبل والمبسم المفدى % % المقدم والقرقف % % 19(@)(@@) % بخدك من وهج شعلة % % أحاطت بقلبي فما تنطقي % % 20(@)(@@) % فإن تخف الحاظك القاتلات % % دمي فبخديك ما يختفي % % PageV01P275 21(@)(@@) % غدا عاذلي عاذرا مذ رأى % % عذارك كالقمر الأكلف % % 22(@)(@@) % وقال أرى خده مرهفا % % ولا عيب في خصره المرهف % % 23(@)(@@) % أقاح وآس وورد لها اجتماع % % على غصن أهيف % % 24(@)(@@) % ترفق رفيقي فليت الذي % % يعنف في الحب لم يعنف % % 25(@)(@@) % عرام عرا وزمان عدا % % فهل ظالم منهما منصفي % % 26(@)(@@) % زمان خلا من جميل فليس % % لغير ذوي نقصه يصطفي % % 27(@)(@@) % جنى ظلمة الفضل حظي المنير % % ولولا سنا الشمس لم تكسف % % 28(@)(@@) % ويا ليت دهري إذا لم يكن % % بسؤلي يسعف لم يعسف % % 29(@)(@@) % أيبلغ دهري قصدي وقد % % قصدت بمصر ذرى يوسف % % 30(@)(@@) % ويوسف مصر بغير التقى % % وبذل الصنائع لم يوصف % % PageV01P276 31(@)(@@) % فسر وافتح القدس واسفك به % % دماء متى تجرها ينظف % % 32(@)(@@) % وأهد إلى الأسبتار البتار % % وهد السقوف على الأسقف % % 33(@)(@@) % وخلص من الكفر تلك البلاد % % يخلصك الله في الموقف % % PageV01P277 البحر : دو بيت 1(@)(@@) % القلب كما عهدتم ذو لهف % % والجسم كما عهدتم ذو دنف % % 2(@)(@@) % ما أعلم مقصودكم من تلفي % % من بعدكم يا أسفي يا أسفي % % PageV01P278 البحر : كامل تام 1(@)(@@) % إن الخطوب على عداك مخوفها % % وكذا الليالي سالمتك صروفها % % 2(@)(@@) % وقضى القضاء برتبة لك في العلى % % شماء لم يفرع إليك منيفها % % 3(@)(@@) % وأتتك أقدار السماء أتتك من % % خيراتها أنواعها وصنوفها % % 4(@)(@@) % وتحملي ريح الشمال تحية % % عني حكاك رقيقها ولطيفها % % 5(@)(@@) % ليعود في ريح الجنوب جوابها % % إن كان يحتمل القوي ضعيفها % % 6(@)(@@) % وصف الحسين تجد وراه محاسنا % % يا صاح يكرم ضيفها ومضيفها 
ms72	 % % 7(@)(@@) % من همه في المكرمات حريصها % % من نفسه في المخزيات عيوفها % % 8(@)(@@) % وإذا حوى عشرات آداب فتى % % فله على رغم الحسود ألوفها % % 9(@)(@@) % كن يا ابن حراز لودي محرزا % % لك في العهود تليدها وطريفها % % 10(@)(@@) % أنا أحنف في الحلم عن أمثالهم % % وشريعتي ما عشت فيه حنيفها % % PageV01P279 11(@)(@@) % لي همة تأبى الدنايا قد سمت % % وأعز نفسي بأسها وعزوفها % % 12(@)(@@) % ولكم عراني حادث ثم انجلى % % عني كما يعرو البدور خسوفها % % 13(@)(@@) % أهدى السقام إلى النحافة بعدكم % % والسمر يحسد في الطعان نحيفها % % 14(@)(@@) % ماذا تسر ولا ية عمالها % % في ذلة وعزيزها مصروفها % % 15(@)(@@) % في الحظ منصرف حكى متصرفا % % هي لفظة وبنقطة تصحيفها % % PageV01P280 البحر : منسرح 1(@)(@@) % يروقني في المها مهفهفها % % ومن قدود الحسان أهيفها % % 2(@)(@@) % ومن عيون الظباء أفترها % % ومن خصور الملاح أنحفها % % 3(@)(@@) % ما سقمي غير سقم أعينها % % ثم شفائي الشفاه أرشفها % % 4(@)(@@) % يسكرني قرقف يشعشعها % % لحظ الطلا لا الطلا وقرقفها % % 5(@)(@@) % يا ضعف قلبي من أعين نجل % % أقتلها بالقلوب أضعفها % % 6(@)(@@) % ومن عذار كأنه حلق % % وأحكام في سروه مضعفها % % 7(@)(@@) % ومن خدود حمر موردة % % أدومها للحياء أطرفها % % 8(@)(@@) % في سلب لبي تلطفت فأتى % % نحوي بخط الصبا ملطفها % % 9(@)(@@) % يا منكرا من هوى بليت به % % علاقة ما يكاد يعرفها % % 10(@)(@@) % دع سر وجدي فما أبوح به % % وخل حالي فلست أكشفها % % PageV01P281 11(@)(@@) % واصرف كؤوس الملام عن فئة % % عن شرعة الحب لست تصرفها % % 12(@)(@@) % من شرف الحب حل في مهج % % أقبلها للغرام أشرفها % % 13(@)(@@) % لا يستطيب السلو مغرمها % % ولا يلذ الشفاء مدنفها % % 14(@)(@@) % فالقلب في لوعة أعالجها % % والعين في عبرة أكفكفها % % 15(@)(@@) % كأن قلبي وحب مالكه % % مصر وفيها المليك يوسفها % % 16(@)(@@) % هذا بسلب الفؤاد يظلمني % % وهو بقتل الأعداء ينصفها % % 17(@)(@@) % الملك الناصر الذي ابدا % % بعز سلطانه يشرفها % % 18(@)(@@) % قام بأحوالها يدبرها % % حسنا وأثقالها يخففها % % 19(@)(@@) % بعدله والصلاح يعمرها % % وبالندى والجميل يكنفها % % 20(@)(@@) % من دنس الغادرين يرحضها % % ومن خباث العدا ينظفها % % PageV01P282 21(@)(@@) % وإن مصرا بملك يوسفها % % جنة خلد يروق زخرفها % % 22(@)(@@) % وإنه في السماح حاتمها % % وإنه 
ms73	 في الوقار أحنفها % % 23(@)(@@) % كم آمل بالندى يحققه % % ومنية بالنجاح يسعفها % % 24(@)(@@) % وليس يوليك وعد عارفة % % إلا وعند النجاز يضعفها % % 25(@)(@@) % حكم في ماله العفاة فما % % ينفذ فيه إلا تصرفها % % 26(@)(@@) % وإن شمل اللها يفرقه % % لمكرمات له يؤلفها % % 27(@)(@@) % ذو شرف مكرماته سرف % % ويستحق الثناء مسرفها % % 28(@)(@@) % وعزمة بالهدى تكفلها % % وهمة للعلى تكلفها % % 29(@)(@@) % يوسف مصر التي ملاحمها % % جاءت بأوصافه تعرفها % % 30(@)(@@) % كتب التواريخ لا يزينها % % إلا بأوصافه تعرفها % % PageV01P283 31(@)(@@) % ومن يمير العفاة في سنة % % أسمنها للجذوب أعجفها % % 32(@)(@@) % آيات دين الإله ظاهرة % % فيك ويثني عليك مصحفها % % 33(@)(@@) % كم جحفل بالعراء ذي لجب % % بالصف منه يضيف صفصفها % % 34(@)(@@) % كالبحر طامي العباب لاعبة % % بموجه للرياح أعصفها % % 35(@)(@@) % كتيبة منتضى مهندها % % إلى الردى مشرع مثقفها % % 36(@)(@@) % غادرتها للنسور مأكلة % % حيث بأشلائها تضيفها % % 37(@)(@@) % منتصفا من رؤوس طاعنة % % بباترات الظبى تنصفها % % 38(@)(@@) % وحطت دمياط إذ أحاط بها % % من برجوم البلاء يقذفها % % 39(@)(@@) % لاقت غواة الفرنج خيبتها % % فزاد من حسرة تأسفها % % 40(@)(@@) % فر فريريها وأزعجها % % نداء داويها تلهفها % % PageV01P284 41(@)(@@) % يمطر مطرانها العذاب كما % % يردى بهد السقوف أسقفها % % 42(@)(@@) % تكسر صلبانها وتنكسها % % لقصم أصلابها وتقصفها % % 43(@)(@@) % أوردت قلب القلوب أرشية % % من القنا للدماء تنزفها % % 44(@)(@@) % وليتها سفكها معاملها % % عاملها والسنان مشرفها % % 45(@)(@@) % تعسفت نحوك الطريق فما % % أجدى سوى هلكها تعسفها % % 46(@)(@@) % وحسبها في العمى تهافتها % % بل لسهام الردى تهدفها % % 47(@)(@@) % يمضى لك الله في قتالهم % % عزيمة للجهاد ترهفها % % 48(@)(@@) % إن أظلمت سدفة أنرت لها % % أبهى ليالي البدور مسدفها % % 49(@)(@@) % بشائر الدين في إزالته % % مواعد الله ليس يخلفها % % 50(@)(@@) % أدركت ما أعجز الملوك وقد % % بات إلى بعضه تشوفها % % PageV01P285 51(@)(@@) % جاوزت غايات كل منقبة % % يعز إلا عليك موقفها % % 52(@)(@@) % وإن طرق العلاء واضحة % % آمنها في السلوك أخوفها % % 53(@)(@@) % صلاح دين الهدى لقد سعدت % % مملكة بالصلاح تتحفها % % 54(@)(@@) % عندي بشكر النعمى ثمار يد % % زاكية الغرس أنت تقطفها % % 55(@)(@@) % فاقبل نقودا من الفضائل لا % % يصاب إلا لديك مصرفها % % 56(@)(@@) % أصداف دري إليك أحملها % % وعن جميع الملوك أصدفها % % 57(@)(@@) % إن 
ms74	 لم تصخ لي فهذه درري % % لأي ملك سواك أرصفها % % 58(@)(@@) % وهل لآمالنا سوى ملك % % ينقدها بره ويسلفها % % 59(@)(@@) % دنيا من الفضل قد خلت وبدا % % للنقص في أهله تعيفها % % 60(@)(@@) % وكل سوق للفضل كاسدة % % بان لأعدائه تحيفها % % PageV01P286 61(@)(@@) % وهل يروح الرجاء في نفر % % كلهم في العلى مزيفها % % 62(@)(@@) % وقد عطفت لي فضائلي ووفت % % لكن حظوظي أعيا تعطفها % % 63(@)(@@) % وفضلي الشمس في مطالعها % % لكن جهل الزمان يكسفها % % 64(@)(@@) % قد أعربت فيك بالثنا كلمي % % وحاسدي ضلة يحرفها % % 65(@)(@@) % أسدى لنا شيركوه عارفة % % يوسف من بعدهما سيخلفها % % 66(@)(@@) % أنت قمين بكل تالدة % % إنك يا ابن الكرام تطرفها % % PageV01P287 البحر : مجتث 1(@)(@@) % ليل الشباب تولى % % والشيب صبح تألق % % 2(@)(@@) % ما الشيب إلا غبار % % من ركض عمري تعلق % % 3(@)(@@) % ركبت لما تكهلت % % بعد أدهم أبلق % % 4(@)(@@) % وضاع مفتاح وصل الحسان % % فالباب مغلق % % 5(@)(@@) % ولا حزامي وثيق % % ولا عناني مطلق % % PageV01P288 البحر : طويل 1(@)(@@) % وما هذه الأيام إلا صحائف % % يؤرخ فيها ثم يمحى ويمحق % % 2(@)(@@) % ولم أر في دهري كدائرة المنى % % توسعها الآمال والعمر ضيق % % PageV01P289 البحر : مجزوء الرمل 1(@)(@@) % ليس في الدنيا جميعا % % بلدة مثل دمشق % % 2(@)(@@) % ويسليني عنها % % في سبيل الله عشقي % % 3(@)(@@) % والتقى الأصل ومن يتركها % % يشقى ويشقي % % 4(@)(@@) % كم رشيق شاغل عنه % % بسهم الغزو رشقي % % 5(@)(@@) % وامتشاق البض يغني % % عنه بالأقلام مشقي % % PageV01P290 البحر : خفيف تام 1(@)(@@) % دار غير اللبيب إن كنت ذا لب % % ولاطفه حين يأتي بحذق % % 2(@)(@@) % فأخو السكر لا يخاطبه الصاحي % % إلى أن يفيق إلا برفق % % 3(@)(@@) % كم قد أمرت بحفر خندق معقل % % حتى سكنت اللحد في محفوره % % 4(@)(@@) % كم قيصر للروم رمت بقسره % % إرواء بيض الهند من تاموره % % 5(@)(@@) % أوتيت فتح حصونه وملكت عقر % % بلاده وسبيت أهل قصوره % % 6(@)(@@) % أزهدت في دار الفناء وأهلها % % ورغبت في الخلد المقيم وحوره % % 7(@)(@@) % أو ما وعدت القدس أنك منجز % % ميعاده في فتحه وظهوره % % 8(@)(@@) % فمتى تجير القدس من دنس العدا % % وتقدس الرحمن في تطهيره % % 9(@)(@@) % يا حاملين سريره مهلا فمن % % عجب نهوضكم بحمل ثبيره % % 10(@)(@@) % يا 
ms75	 عابرين بنعشه أنشقتم % % من صالح الأعمال نشر عبيره % % PageV01P291 11(@)(@@) % نزلت ملائكة السماء لدفنه % % مستجمعين على شفير حفيره % % 12(@)(@@) % ومن الجفاء له مقامي بعده % % هلا وفيت وسرت عند مسيره % % 13(@)(@@) % حياك معتل الصبا بنسيمه % % وسقاك منهل الحيا بدروره % % PageV01P292 البحر : خفيف تام 1(@)(@@) % جامع الشمل بعد طول الفراق % % للمحبين كافل بالتلاق % % 2(@)(@@) % ولعل الأيام تسمح بالوصل % % ونقضي لبانة المشتاق % % 3(@)(@@) % يا أخلائي الكرام المضاهين % % بطيب العروق طيب العراق % % 4(@)(@@) % يا صبورا على الصبابة بعدي % % لك طول البقاء ما أنا باق % % 5(@)(@@) % فأجرني من النوى بالتلاقي % % وارث لي إذ لاقيت ما أنا لاق % % PageV01P293 البحر : سريع 1(@)(@@) % يا رب حتام أعاني الهوى % % في ذنب ذا المغرب لا أرتقي % % 2(@)(@@) % غارت في الشمس فمن أجل ذا % % لم تبقني أطلع في المشرق % % PageV01P294 البحر : طويل 1(@)(@@) % تغنم زمان الجود في اللهو واسبق % % وفز باجتماع الشمل قبل التفرق % % 2(@)(@@) % هلموا نسابق نحو مشمس جلق % % وثم لما نهوى على الأكل نلتقي % % 3(@)(@@) % تصفر شوقا لانتظار قدومنا % % ومن يتعشق ذا الفضائل يشتق % % 4(@)(@@) % وما رمقت للشوق رمد عيونه % % فإن تترفق منه تنظر وترفق % % 5(@)(@@) % إذا حضرت أطباقه غاب رشدنا % % لما يتلاقى من مشوق وشيق % % 6(@)(@@) % لأن مذاب الشهد فيه مجسد % % أجد له عهد الرحيق المعتق % % 7(@)(@@) % وما اصفر إلا خوف أيدي جناته % % فليس له أمن من المتطرق % % 8(@)(@@) % حكى جمرات بالفضا قد تعلقت % % فيا عجبي من جمرة المتعلق % % 9(@)(@@) % كأن نجوم الأرض فوق غصونه % % فيا حيرتي من نجة المتألق % % 10(@)(@@) % وجناتها محمرة وجناتها % % فمن يرها مثلي يحب ويعشق % % PageV01P295 11(@)(@@) % بدت بين أوراق الغصون كأنها % % كرات نضار في لجين مطرق % % 12(@)(@@) % تساقطها أشجارها فكأنها % % دنانير في أيدي الصيارف ترتقي % % 13(@)(@@) % ومشمش بستان الزكي بشهده % % شهادته تقضي فزك وصدق % % 14(@)(@@) % يقول رفيقي في دمشق تعجبا % % أما لك بستان مقالة مشفق % % 15(@)(@@) % فقلت إلى باب البريد وسوقه % % لأمثالنا تجنى بساتين جلق % % 16(@)(@@) % ولو كان لي بالسهم سهم وجدت لي % % منالي بأيام الثمار ومرفقي % % 17(@)(@@) % إذا كنت مبتاعا من السوق مشمشي % % فما لي إلا 
ms76	 لذة المتسوق % % 18(@)(@@) % وما لي بأرباب البساتين خلطة % % فيصبح في حيطانها متسلقي % % 19(@)(@@) % كرام وثوقي في الشتاء بودهم % % ولكنهم في الصيف ينسون موثقي % % 20(@)(@@) % وما ثم من يجدي ويقري ويقتني % % ثنائي سوى المحيي الكريم الموفق % % PageV01P296 21(@)(@@) % وذلك يوم واحد ليس غيره % % أمن أجل يوم واحد قلت لي اسبق % % 22(@)(@@) % على أنني لو قيل بالصين دعوة % % أثرت إليها لوعة المتحرق % % 23(@)(@@) % فإن جئت قبلي جلقا فارم منعما % % حديثي ينادي المنعمين وحلق % % 24(@)(@@) % لعل كريما ينتخي لضيافتي % % بمشمشة عند القدوم وينتقي % % 25(@)(@@) % فلا تنس نشو الدين نشوة خاطري % % وقل عن صبوحي كيف شئت ورقق % % 26(@)(@@) % وهات وساعدني وخذ من قريحتي % % لطيمة داري من الحمد واعبق % % PageV01P297 البحر : مجتث 1(@)(@@) % دمشق تقصد عظمي % % بعرقة أي عرقه % % 2(@)(@@) % إخفاقه لرجائي % % فيها وللقلب خفقه % % 3(@)(@@) % أقمت فيها وحيدا % % كالدار ضمته حقه % % PageV01P298 البحر : مجزوء الرمل 1(@)(@@) % قد نزلنا في جوارك % % وحللنا قرب دارك % % 2(@)(@@) % وسرينا في الدياجي % % فهدانا ضوء نارك % % 3(@)(@@) % فتدارك أمرنا اليوم % % بطول متدارك % % 4(@)(@@) % وتفرد باغتنام الشكر % % من غير مشارك % % PageV01P299 البحر : متقارب تام 1(@)(@@) % عجبت من الموت كيف اهتدى % % إلى ملك في سجايا ملك % % 2(@)(@@) % وكيف ثوى الفلك المستدير % % في الأرض الأرض وسط الفلك % % PageV01P300 البحر : مجزوء الكامل 1(@)(@@) % أما الغبار فإنه % % مما أثارته السنابك % % 2(@)(@@) % والجو منه مظلم % % لكن أنار به السنابك % % 3(@)(@@) % يا دهر لي عبد الرحيم % % فلست أخشى مس نابك % % PageV01P301 البحر : مجزوء الرمل 1(@)(@@) % بانقيادي لمرادك % % وبصدقي في ودادك % % 2(@)(@@) % وبسقياك من الحفظ % % عهودي بعهادك % % 3(@)(@@) % لا تحمل قلبي المشتاق % % أثقال بعادك % % 4(@)(@@) % ما على الوجد فؤادي % % صابرا مثل فؤادك % % 5(@)(@@) % ولقد أضحى على رغم % % العدا طوع قيادك % % 6(@)(@@) % واعتقادي في وداديك % % صحيح كاعتقادك % % 7(@)(@@) % واعتضادي بك في كل % % المعاني كاعتضادك % % 8(@)(@@) % لب من لو لم يؤمل % % منك عرفا لم ينادك % % 9(@)(@@) % وأصب مرمى مرامي % % فمرادي من مرادك % % 10(@)(@@) % واعتمد ما يحرز الدهر % % به شكر عمادك % % PageV01P302 11(@)(@@) % أجره في بعثك الكتب % % على مشكور عادك % % PageV01P303 البحر : سريع 1(@)(@@) % طريق مصر ضيق المسلك % % سالكه 
ms77	 لا شك في مهلك % % 2(@)(@@) % وحب مصر صار جبا لمن % % أوقعه في شبك الشوبك % % 3(@)(@@) % لكنما من دونها كعبة % % محجوجة مبرورة المنسك % % 4(@)(@@) % بها صلاح الدين يشكى الذي % % إليه من أيامه يشتكي % % PageV01P304 البحر : دو بيت 1(@)(@@) % ما أعلم والحظ عزيز الدرك % % لم أحرم تقبيل يمين الملك % % 2(@)(@@) % يا من بمراده مدار الفلك % % أبشر بوقوع شاكر في الشرك % % PageV01P305 البحر : مخلع البسيط 1(@)(@@) % بالملك الناصر استنارت % % في عصرنا أوجه الفضائل % % 2(@)(@@) % علي من حقه فروض % % شكرا لما جاد من نوافل % % 3(@)(@@) % يوسف مصر الذي إليه % % تشد آمالنا الرواحل % % 4(@)(@@) % أجريت نيلين في ثراها % % نيل نجيع ونيل نائل % % 5(@)(@@) % رأيك في الدهر عن رزايا % % جلا مهماته الجلائل % % 6(@)(@@) % كم كرم من نداك حار % % وكم دم من عداك سائل % % 7(@)(@@) % وكم معاد بلا معاد % % ومستطيل بغير طائل % % 8(@)(@@) % وحاسد كاسد المساعي % % وسائد ناطق الوسائل % % 9(@)(@@) % أقررت عين الإسلام حتى % % لم يبق فيها قذى لباطل % % 10(@)(@@) % وكيف يزهى بملك مصر % % من يستقل ذنبا لنائل % % PageV01P306 11(@)(@@) % وما نفيت السودان حتى % % حكمت البيض في المقاتل % % 12(@)(@@) % صيرت رحب الفضاء ضيقا % % عليهم كفة لحابل % % 13(@)(@@) % وكل رأي منهم كراء % % وأرض مصر كلام واصل % % 14(@)(@@) % وقد خلت منهم المغاني % % وأقفرت منهم المنازل % % 15(@)(@@) % وما أصيبوا إلا بطل % % فكيف لو أمطروا بوابل % % 16(@)(@@) % وقد تجلى بالحق ما بالباطل % % في مصر كان عاجل % % 17(@)(@@) % والسود بالبيض قد أبيحوا % % فهي بواز بهم نوازل % % 18(@)(@@) % مؤتمن القوم خان حتى % % غالته من شره غوائل % % 19(@)(@@) % عاملكم بالخنا فأضحى % % ورأسه فوق رأس عامل % % 20(@)(@@) % وحالف الذل بعد عز % % والدهر أحواله حوائل % % PageV01P307 21(@)(@@) % يا مخجل البحر بالأيادي % % قد آن أن تفتح السواحل % % 22(@)(@@) % فقدس القدس من خباث % % أرجاس كفر غتم أراذل % % PageV01P308 البحر : منسرح 1(@)(@@) % لا أوحش الله منك يا علم الدين % % ندي الكرام والفضلا % % 2(@)(@@) % أعن قلا ذا الصدود أم ملل % % حاشا العلى من ملالة وقلا % % 3(@)(@@) % هل جائز في العلى لرب على % % أن يغتدي هاجرا لرب على % % 4(@)(@@) % كنت أخا إن جفا الزمان وفى % % أو 
ms78	 قطع الود أهله وصلا % % 5(@)(@@) % إن أظلمت خطة أضاء لنا % % أو ظلم الخطب جائرا عدلا % % 6(@)(@@) % رفيق رفق لنا إذا عنف الدهر % % وخلا يسدد الخللا % % 7(@)(@@) % صديق صدق مازال إن كذب السعاة % % للأصدقاء محتملا % % 8(@)(@@) % فما الذي كدر الصفاء من الود % % ولم يرو ورده الغللا % % 9(@)(@@) % فضلك روح العلى وهل بدن % % من روحه الدهر واجد بدلا % % 10(@)(@@) % عذب بما شئت من معاتبة % % أما بهذا الهجر الممض فلا % % PageV01P309 11(@)(@@) % في العمر ضيق فصنه منتهزا % % في سعة الصدر فرصة العقلا % % 12(@)(@@) % أما كفى نائب الزمان على % % تفريق شمل الألاف مشتملا % % 13(@)(@@) % ما بالنا ما نرى وإن كرموا % % لا من الأصدقاء كل بلا % % 14(@)(@@) % إذا شعفنا بقرب ذي شعف % % بقربنا قيل قد نأى وسلا % % 15(@)(@@) % زهدت فينا وسوف تطلبنا % % رب رخيص بعد الكساد غلا % % 16(@)(@@) % إن كان في طبعك الملال من الشيء % % فهلا مملت ذا المللا % % 17(@)(@@) % بعد كمال الإخاء تنقصه % % فحاذر النقص بعد ما كملا % % 18(@)(@@) % كم صاحب قال لي ألست على % % بلاء ودي تقيم قلت بلى % % 19(@)(@@) % كفى لخلي بدين خلته % % مجدي وفضلي ومحتدي كفلا % % 20(@)(@@) % وكل علم لم يكس صاحبه % % حلما تراه عطلا بغير حلى % % PageV01P310 21(@)(@@) % لحفظ قلب الصديق أجترع الصاب % % وأبقي لكأسه العسلا % % 22(@)(@@) % إن أنكر الحق كنت معترفا % % به أو اعوج كنت معتدلا % % 23(@)(@@) % أو قال ما قال كنت مستمعا % % إليه بالقول منه محتفلا % % 24(@)(@@) % فضلك في العالمين ليس له % % مثل وقد سار في الورى مثلا % % 25(@)(@@) % فأولنا الفضل يا ولي أولى الفضل % % ولا تبغ حل عقد ولا % % 26(@)(@@) % يا علم الدين أنت علامة العلم % % الجلي الأوصاف وابن جلا % % 27(@)(@@) % عرفني العذر في اجتراحك ذنب % % الصد واحضر مستحييا خجلا % % 28(@)(@@) % وافضل جميلا هذ القضية بالعدل % % وخل التفصيل والجملا % % 29(@)(@@) % واعذر جهولا إذا حسدت فما % % صار حسودا إلا لما جهلا % % 30(@)(@@) % وجلت من هجرك المخوف فصل % % واجل عن القلب ذلك الوجلا % % PageV01P311 31(@)(@@) % وابخل بودي يا سمح فالسمحاء الغر % % صيد بودهم بخلا % % 32(@)(@@) % إن الكرام الذين أعرفهم % % قد أوضحوا لي 
ms79	 من عرفهم سبلا % % 33(@)(@@) % يسامحون الصديق إن زلت النعل % % ويغضون إن رأوا زللا % % 34(@)(@@) % وهم خفاف إلى المكارم لي % % لكنهم عن مكارهي ثقلا % % 35(@)(@@) % فكن من المرتجى غناؤهم % % في صدق ودي وحقق الأملا % % PageV01P312 البحر : بسيط تام 1(@)(@@) % فالشام يغبط مصرا مذ حللت بها % % كما الفرات عليكم يحسد النيلا % % 2(@)(@@) % نلتم من الملك عفوا من الملوك به % % عنوا قديما وراموه فما نيلا % % PageV01P313 البحر : منسرح 1(@)(@@) % قد صح عزمي على المسير فلا % % أبغي مقامي والقلب قد رحلا % % 2(@)(@@) % أمضي إلى دمية مقبلها % % أرشف منه المدام والعسلا % % 3(@)(@@) % مصور بل مدور عجب % % ترى به وهو جامد شعلا % % 4(@)(@@) % ففي قلوب الأشجار منه جذا % % وفي ظهور الغضون منه كلى % % 5(@)(@@) % طلوا بماء النضار ظارهه % % لباطن في حشاه نار طلا % % 6(@)(@@) % تخفى إذا ما بدا لعينك في % % فيك وفيه النوى إذا وصلا % % 7(@)(@@) % حلي تبر على عرائس أغصان % % تشكت من قبلها عطلا % % 8(@)(@@) % حمر حسان الوجوه قد لبست % % من خضر أوراقها لها حللا % % 9(@)(@@) % عرائس من خدورها برزت % % تحسب أشجارها لها كللا % % 10(@)(@@) % حلاوة لا يمل آكلها % % إذا الحلاوات أحدثت مللا % % PageV01P314 11(@)(@@) % زهر كشهب السماء راجمة % % جن جناة بقطفها كفلا % % 12(@)(@@) % عيونها الرمد في ترقبنا % % جاحظة أبرزت لنا مقلا % % 13(@)(@@) % ماذا التواني وذا التأخر والإبطاء % % قدم مسيرنا عجلا % % 14(@)(@@) % تغدو خفاقا إلى مواسمها % % من قبل نبلى بصحبة النقلا % % 15(@)(@@) % قد انتظرنا من الخزانة ما % % نعطى فأكدى نوابها البخلا % % 16(@)(@@) % فإن عدمنا من عندهم ذهبا % % فما عدمنا عنه به بدلا % % 17(@)(@@) % وكلنا في عوارف الملك الناصر % % نرعى ونسلك السبلا % % PageV01P315 البحر : وافر تام 1(@)(@@) % أظنهم وقد عزموا ارتحالا % % ثنوا عنا جمالا لا جمالا % % 2(@)(@@) % سروا والصبح مبيض الحواشي % % فلما حال عهد الوصل حالا % % 3(@)(@@) % هم اعتادوا الملال فكيف ملوا % % وصالهم وما ملوا الملالا % % 4(@)(@@) % أحادي عيسهم بالله رفقا % % فإن السير أورثها الكلالا % % 5(@)(@@) % وعج نحو الأراك بها فإني % % أراه لاجتماع الشمل فالا % % 6(@)(@@) % سقى صوب الحيا تلعات نجد % % وحيا بالحمى تلك التلالا % % 7(@)(@@) % أخلائي وهل في الناس 
ms80	 خل % % به أخلي من الأحزان بالا % % 8(@)(@@) % لئن لم أشف صدري من حسودي % % ولم أذق العدا داء عضالا % % 9(@)(@@) % فلا أدركت من أدبي مرادا % % ولا صادفت من حسبي منالا % % 10(@)(@@) % ولا وخدت إليكم بي جمال % % ولا واليت مولانا الجمالا % % PageV01P316 11(@)(@@) % هو المغنى إذا ما المرء أقوى % % هو المنجي إذا ما الخطب هالا % % 12(@)(@@) % وقائلة أفي الدنيا كريم % % سواه فقلت لا وأبي العلا لا % % 13(@)(@@) % أطلت على الورى كرما وفخرا % % كذلك من حوى هذين طالا % % 14(@)(@@) % وحزت المجد عن كسب وارث % % فيا صدر الورى حزت الكمالا % % 15(@)(@@) % خصصت بكل منقبة وفضل % % تعالى من حباك به تعالى % % PageV01P317 البحر : كامل تام 1(@)(@@) % والغصن مهزوز القوام كأنما % % دارت عليه من الشمال شمول % % 2(@)(@@) % والدهر كالليل البهيم وأنتم % % غرر تنير ظلامه وحجول % % PageV01P318 البحر : هزج 1(@)(@@) % ترى يجتمع الشمل % % ترى يتفق الوصل % % 2(@)(@@) % ترى العيش الذي مر % % مريرا بعدهم يحلو % % 3(@)(@@) % ترى من شاغل الهم % % فؤادي المبتلى يخلو % % 4(@)(@@) % بغيري شغلوا عني % % وعندي بهم شغل % % 5(@)(@@) % وكانوا لا يملون % % فما بالهم ملوا % % 6(@)(@@) % وراموا سلوة المغرم % % والمغرم لا يسلو % % 7(@)(@@) % إذا ما كنت لا أسلو % % فماذا ينفع العذل % % 8(@)(@@) % ألا ياقلب إن العز % % في شرع الهوى ذل % % 9(@)(@@) % وما دل على ذلك % % إلا ذلك الدل % % 10(@)(@@) % ألا يا حبذا بالجزع % % ذاك البان والأثل % % PageV01P319 11(@)(@@) % إذ الأبكار للآصال % % في بهجتها تتلو % % 12(@)(@@) % وأنفاس صبا الأسحار % % بالصحة تعتل % % 13(@)(@@) % هديل الورق في مورقة % % أفنانها هدل % % 14(@)(@@) % وأكناف الصبا خضر % % وأفناء الحمى خضل % % 15(@)(@@) % وللذات أبواب % % وما من دونها قفل % % 16(@)(@@) % ترى يرجع من طيب % % زماني ذلك الفصل % % 17(@)(@@) % تغربت فلا دار % % ولا جار ولا أهل % % 18(@)(@@) % أخلائي ببغداد % % وهل لي غيركم خل % % 19(@)(@@) % سقى مغناكم دمعي % % إذا ما احتبس الوبل % % 20(@)(@@) % بعثت إمام أمة النار نحوها % % فزار إمام أرناطها ذلك الحبسا % % PageV01P320 21(@)(@@) % ولله نص النصر جاء لنصله % % فلا قونسا أبقى لرأس ولا قنسا % % 22(@)(@@) % حكى عنق الداوي صل بضربة % % طرير الشبا عودا لمضرابه حسا % % 23(@)(@@) % أيوم وغى تدعوه 