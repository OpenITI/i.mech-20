ms146	 الله عنهما .(@)(@@)(@@)(@@) $ ( 1345 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم إلى وليمة فليجب وإن كان صائما ) )(@)(@@) ( ابن منيع ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1346 ) قال النبي :(@)(@@) | 30 ( إذا دعي أحدكم فجاء مع الرسول فإن ذالك له إذن ) )(@)(@@) ( خد د هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1347 ) قال النبي :(@)(@@) | 30 ( إذا دعيتم إلى كراع فأجيبوا ) ( م ) عن ا$ بن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1348 ) قال النبي :(@)(@@) | 30 ( إذا ذبح أحدكم فليجهز ) )(@)(@@) ( ه عد هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1349 ) قال النبي :(@)(@@) | 30 ( إذا ذكر أصحابي فأمسكوا ، وإذا ذكرت النجوم فأمسكوا ، وإذا ذكر القدر فأمسكوا ) )(@)(@@) ( طب ) عن ابن مسعود ( عد ) عن ابن مسعود وعن ثوبان وعن عمر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 1350 ) قال النبي :(@)(@@) | 30 ( إذا ذكرتم بالله فإنتهوا ) ( البزار ) عن أ$ بي سعيد المقبري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1351 ) قال النبي :(@)(@@) | 30 ( إذا ذلت العرب ذل الإسلام ) )(@)(@@) ( ع ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1352 ) قال النبي :(@)(@@) | 30 ( إذا ذهب أحدكم إلى الغائط فليذهب معه بثلاثة أحجار يستطيب بهن فإنها تجزي عنه ) )(@)(@@) ( حم د ن ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1353 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم الرؤيا الحسنة فليفسرها وليخبر بها ، وإذا رأى الرؤيا القبيحة فلا يفسرها ولا يخبر بها ) )(@)(@@) ( ت ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1354 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم الرؤيا يحبها فإنما هي من الله فليحمد الله عليها وليحدث بها ، وإذا رأى غير ذالك مما يكره فإنما هي من الشيطان فليستعذ بالله ولا يذكرها لأحد فإنها لا تضره ) )(@)(@@) ( حم خ ت ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1355 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم الرؤيا يحبها فإنما هي من الله PageV01P207 فليحمد الله عليها وليحدث بها ، وإذا رأى غير ذالك مما يكره فإنما هي من الشيطان فليستعذ بالله من شرها ولا يذكرها لأحد فإنها لا تضره ) )(@)(@@) ( حم خ ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1356 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم الرؤيا يكرهها 
ms147	 فليبصق عن يساره ثلاثا وليستعذ بالله من الشيطان ثلاثا وليتحول عن جنبه الذي كان عليه ) )(@)(@@) ( م د ه ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1357 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم المرأة التي تعجبه فليرجع إلى أهله حتى يقع بهم فإن ذالك معهم ) )(@)(@@) ( حب ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1358 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم ا| مر أة حسناء فأعجبته فليأت أهله فإن البضع واحد ومعها مثل الذي معها ) )(@)(@@) ( خط ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1359 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم بأخيه بلاء فليحمد الله ولا يسمعه ذالك ) )(@)(@@) ( ابن النجار ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1360 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم جنازة فإن لم يكن ماشيا معها فليقم حتى يخلفها أو تخلفه أو توضع من قبل أن تخلفه ) )(@)(@@) ( ق ن ) عن عامر بن ربيعة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1361 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم رؤيا يكرهها فليتحول وليتفل عن يساره ثلاثا وليسأل الله من خيرها وليتعوذ بالله من شرها ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1362 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم رؤيا يكرهها فليتفل عن يساره ثلاث مرات ثم ليقل : اللهم إني أعوذ بك من الشيطان وسيئات الأحلام فإنها لا تكون شيئا ) )(@)(@@) ( ابن السنى ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1363 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم مبتلى فقال : الحمد لله الذي عافاني PageV01P208 مما ابتلاك به ، وفضلني عليك وعلى كثير من عباده تفضيلا كان شكر تلك النعمة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1364 ) قال النبي :(@)(@@) | 30 ( إذا رأى أحدكم من نفسه أو ماله أو من أخيه ما يعجبه فليدع له بالبركة فإن العين حق ) )(@)(@@) ( ع طب ك ) عن عامر بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1365 ) قال النبي :(@)(@@) | 30 ( إذا رأى المؤمن ما فسح له في قبره فيقول : دعوني أبشر أهلي فيقال له : اسكن ) ( حم ) و ال| ضياء عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1366 ) قال النبي :(@)(@@) | 30 ( إذا رأت فأنزلت فعليها 
ms148	 الغسل ) )(@)(@@) ( ه ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1367 ) قال النبي :(@)(@@) | 30 ( إذا راح أحدكم إلى الجمعة فليغتسل ) )(@)(@@) ( خ ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1368 ) قال النبي :(@)(@@) | 30 ( إذا راح منا سبعون رجلا إلى الجمعة كانوا كسبعين موسى الذين وفدوا إلى ربهم أو أفضل ) )(@)(@@) ( طس ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1369 ) قال النبي :(@)(@@) | 30 ( إذا رأيت الأمة ولدت ربتها ورأيت أصحاب البنيان يتطاولون بالبنيان ، ورأيت الحفاة الجياع العالة كانوا رؤوس الناس فذلك من معالم الساعة وأشراطها ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1370 ) قال النبي :(@)(@@) | 30 ( إذا رأيت العالم يخالط السلطان مخالطة كثيرة فاعلم أنه لص ) )(@)(@@) ( فر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1371 ) قال النبي :(@)(@@) | 30 ( إذا رأيت الله تعالى يعطي العبد من الدنيا ما يحب وهو مقيم على معاصيه فإنما ذالك منه استدراج ) )(@)(@@) ( حم طب هب ) عن عقبة بن عامر PageV01P209 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1372 ) قال النبي :(@)(@@) | 30 ( إذا رأيت المذي فاغسل ذكرك وتوضأ وضوءك للصلاة ، وإذا نضحت الماء فاغتسل ) )(@)(@@) ( د ن حب ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1373 ) قال النبي :(@)(@@) | 30 ( إذا رأيت الناس قد مرجت عهودهم ، وخفت أماناتهم وكانوا هاكذا وشبك بين أنامله ، فالزم بيتك ، واملك عليك لسانك ، وخذ ما تعرف ودع ما تنكر وعليك بخاصة أمر نفسك ، ودع عنك أمر العامة ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1374 ) قال النبي :(@)(@@) | 30 ( إذا رأيت أمتي تهاب الظالم أن تقول له : إنك ظالم فقد تودع منهم ) )(@)(@@) ( حم طب ك هب ) عن ابن عمرو ( طس ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1375 ) قال النبي :(@)(@@) | 30 ( إذا رأيت كلما طلبت شيئا من أمر الآخرة وابتغيته يسر لك ، وإذا أردت شيئا من أمر الدنيا وابتغيته عسر عليك فاعلم أنك على حال حسنة ، وإذا رأيت كلما طلبت شيئا من أمر الآخرة وابتغيته عسر عليك ، وإذا طلبت شيئا من أمر الدنيا وابتغيته يسر لك فأنت على حال قبيحة ) )(@)(@@) ( ابن المبارك في الزهد ) عن سعيد بن أبي سعيد مرسلا ( هب ) عن 
ms149	 عمر بن الخطاب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1376 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم آية فاسجدوا ) )(@)(@@) ( د ت ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1377 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الأمر لا تستطيعون تغييره فاصبروا حتى يكون الله هو الذي يغيره ) )(@)(@@) ( عد هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1378 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الجنازة فقوموا فمن تبعها فلا يقعد حتى PageV01P210 توضع ) )(@)(@@) ( حم ق 3 ) عن أبي سعيد ( خ ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1379 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الجنازة فقوموا لها حتى تخلفكم أو توضع ) )(@)(@@) ( حم ق 4 ) عن عامر بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1380 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الحريق فكبروا فإن التكبير يطفئه ) )(@)(@@) ابن السنى ( عد وابن عساكر ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1381 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الحريق فكبروا فإنه يطفىء النار ) )(@)(@@) ( عد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1382 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الرايات السود قد جاءت من قبل خراسان فأتوها فإن فيها خليفة الله المهدي ) )(@)(@@) ( حم ك ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1383 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الرجل أصفر الوجه من غير مرض ولا علة ، فذالك من غش للإسلام في قلبه ) )(@)(@@) ( ابن السنى وأبو نعيم في الطب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1384 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الرجل قد أعطي زهدا في الدنيا وقلة منطق فاقتربوا منه فإنه يلقن الحكمة ) )(@)(@@) ( ه حل هب ) عن أبي خلاد ( حل هب ) عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1385 ) قال الن بي :(@)(@@) | 30 ( إذا رأيتم الرجل يتعزى بعزاء الجاهلية فأعضوه بهن أبيه ولا تكنوا ) )(@)(@@) ( حم ت ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1386 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الرجل يعتاد المساجد فاشهدوا له بالإيمان ) ) PageV01P211(@)(@@) ( حم ت ه ) و ابن خزيمة ( حب ك هق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1387 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الرجل يقتل صبرا فلا تحضروا مكانه فلعله يقتل ظلما ، فتنزل السخطة فتصيبكم ) )(@)(@@) ( ابن سعيد طب ) عن خرشة 
ms150	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1388 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم العبد ألم الله به الفقر والمرض فإن الله يريد أن يصافيه ) )(@)(@@) ( فر ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1389 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم اللاتي ألقين على رؤوسهن مثل أسنمة البعر فأعلموهن أنه لا تقبل لهن صلاة ) )(@)(@@) ( طب ) عن أبي شقرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1390 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الذين يسبون أصحابي فقولوا لعنة الله على شركم ) )(@)(@@) ( ت ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1391 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الليل قد أقبل من هاهنا فقد أفطر الصائم ) )(@)(@@) ( ق د ) عن عبد الله بن أبي أوفى ا رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1392 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم المداحين فاحثوا في وجوههم التراب ) )(@)(@@) ( حم خد م د ت ) عن المقداد بن الأسود ( طب هب ) عن ابن عمر ( طب ) عن ابن عمرو ( الحاكم ) في الكنى عن أنس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 1393 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الناس قد مرجت عهودهم ، وخفت أماناتهم ، وكانوا هاكذا وشبك بين أصابعه ، فالزم بيتك ، واملك عليك لسانك ، وخذ بما تعرفه ، ودع ما تنكر وعليك بأمر خاصة نفسك ، ودع عنك أمر العامة ) )(@)(@@) ( د ) عن ابن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1394 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الهلال فصوموا ، وإذا رأيتموه فأفطروا ، فإن PageV01P212 غم عليكم فأقدروا له ) )(@)(@@) ( ق ن ه حب ) عن ابن عمر رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1395 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم الهلال فصوموا وإذا رأيتموه فأفطروا ، فإن أغمي عليكم فعدوا ثلاثين يوما ) )(@)(@@) ( حم ق ) عن جابر ( حم م ن ه ) عن أبي هريرة ( ن ) عن ابن عباس ( د ) عن حذيفة ( حم ( 3 ) عن طلق بن علي رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 1396 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم عمودا أحمر من قبل المشرق في شهر رمضان فادخروا طعامكم سنتكم فإنها سنة جوع ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1397 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم منهن يعني الحيات شيئا في مساكنكم فقولوا : أنشدكن العهد الذي أخذ عليكم نوح ، أنشدكن 
ms151	 العهد الذي أخذ عليكم سليمان أن لا تؤذونا ، فإن عدن فاقتلوهن ) )(@)(@@) ( د ) عن عبد الرحمان بن أبي ليلى رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1398 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم من يبيع أو يبتاع في المسجد فقولوا : لا أربح الله تجارتك ، وإذا رأيتم من ينشد فيه ضالة فقولوا لا رد الله عليك ضالتك ) )(@)(@@) ( ت ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1399 ) قال النبي :(@)(@@) | 30 ( إذا رأيت من أخيك ثلاث خصال فارجه : الحياء والأمانة والصدق ، وإذا لم ترها فلا ترجه ) )(@)(@@) ( عد فر ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1400 ) قال النبي :(@)(@@) | 30 ( إذا رأيتم هلال ذي الحجة وأراد أحدكم أن يضحي فليمسك عن شعره وأظفاره ) )(@)(@@) ( م ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1401 ) قال النبي :(@)(@@) | 30 ( إذا رأيتني على مثل هاذه الحالة يعني البول فلا تسلم PageV01P213 علي فإنك إن فعلت ذالك لم ( أرد عليك ) ) )(@)(@@) ( ه ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1402 ) قال النبي :(@)(@@) | 30 ( إذا رجع أحدكم من سفره فليرجع إلى أهله بهدية ولو لم يجد إلا أن يلقي في مخلاته حجرا أو حزمة حطب فإن ذالك مما يعجبهم ) )(@)(@@) ( ابن شاهين في الأفراد وابن النجار ) عن أبي رهم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1403 ) قال النبي :(@)(@@) | 30 ( إذا رجف قلب المؤمن في سبيل الله تحاتت خطاياه كما يتحات عذق النخلة ) )(@)(@@) ( طب حل ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1404 ) قال النبي :(@)(@@) | 30 ( إذا رد الله على العبد المسلم روحه من الليل فسبحه ومجده واستغفره غفر له ما تقدم من ذنبه ، وإن هو قام فتوضأ وصلى فذكره واستغفره ودعاه تقبل منه ) )(@)(@@) ( ابن السنى والخرائطي في مكارم الأخلاق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1405 ) قال النبي :(@)(@@) | 30 ( إذا رددت على السائل ثلاثا فلم يذهب فلا بأس أن تزبره ) ( قط ) في الأفراد عن ابن عباس ( طس ) عن أ$ بي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 1406 ) قال النبي :(@)(@@) | 30 ( إذا رعف أحدكم في صلاته فلينصرف فليغسل عنه الدم ثم ليعد وضوءه وليستقبل صلاته ) )(@)(@@) ( قط طب 
ms152	 ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1407 ) قال النبي :(@)(@@) | 30 ( إذا رفعت رأسك من السجود فلا تقع كما يقعي الكلب ، ضع ألييك بين قدميك وألزق ظاهر قدميك بالأرض ) )(@)(@@) ( ه ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1408 ) قال النبي :(@)(@@) | 30 ( إذا ركب أحدكم الدابة فليحملها على ملاذها ، فإن الله تعالى يحمل على القوي والضعيف ) )(@)(@@) ( قط في الأفراد ) عن عمرو بن العاضي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1409 ) قال النبي :(@)(@@) | 30 ( إذا ركبتم هاذه البهائم العجم فإنجوا عليها فإذا كانت PageV01P214 سنة فانجوا ، وعليكم بالدلجة فإنما يطويها الله ) )(@)(@@) ( طب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1410 ) قال النبي :(@)(@@) | 30 ( إذا ركبتم هاذه الدواب فأعطوها حظها من المنازل ولا تكونوا عليها شياطين ) )(@)(@@) ( قط في الأفراد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1411 ) قال النبي :(@)(@@) | 30 ( إذا ركع أحدكم فليقل في ركوعه : سبحان ربي العظيم ثلاثا فإذا فعل ذالك تم ركوعه وذالك أدناه ، وإذا سجد فليقل في سجوده سبحان ربي الأعلى ثلاثا فإذا فعل ذالك فقد تم سجوده وذالك أدناه ) )(@)(@@) ( د ت ه ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1412 ) قال النبي :(@)(@@) | 30 ( إذا ركعت فضع كفيك على ركبتيك حتى تطمئن ، وإذا سجدت فأمكن جبهتك من الأرض حتى تجد حجم الأرض ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1413 ) قال النبي :(@)(@@) | 30 ( إذا رمى أحدكم جمرة العقبة فقد حل له كل شيء إلا النساء ) )(@)(@@) ( د ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1414 ) قال النبي :(@)(@@) | 30 ( إذا رميت الجمار كان لك نورا يوم القيامة ) ( البزار ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1415 ) قال النبي :(@)(@@) | 30 ( إذا رميت الصيد فأدركته بعد ثلاث ليال وسهمك فيه فكله ما لم ينتن ) )(@)(@@) ( د ) عن أبي ثعلبة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1416 ) قال النبي :(@)(@@) | 30 ( إذا رميت بالمعراض الصيد فخرق فكله وإن أصابه بعرضه فلا تأكله فإنه وقيذ ) )(@)(@@) ( حم م د ت ه ) عن عدي بن حاتم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1417 ) قال النبي :(@)(@@) | 30 ( إذا رميت بسهمك 
ms153	 وغاب ثلاثة أيام وأدركته فكله ما PageV01P215 لم ينتن ) )(@)(@@) ( حم م ) عن أبي ثعلبة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1418 ) قال النبي :(@)(@@) | 30 ( إذا رميتم وحلقتم فقد حل لكم الطيب والثياب وكل شيء إلا النساء ) )(@)(@@) ( م هق ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1419 ) قال النبي :(@)(@@) | 30 ( إذا رويت أهلك من اللبن غبوقا فاجتنب ما نهى الله عنه من ميتة ) )(@)(@@) ( ك هق ) عن سمرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1420 ) قال النبي :(@)(@@) | 30 ( إذا زار أحدكم أخاه فألقى له شيئا يقيه من التراب وقاه الله عذاب النار ) )(@)(@@) ( طب ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1421 ) قال النبي :(@)(@@) | 30 ( إذا زار أحدكم أخاه فجلس عنده فلا يقومن حتى يستأذنه ) )(@)(@@) ( فر ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1422 ) قال النبي :(@)(@@) | 30 ( إذا زار أحدكم قوما فلا يصل بهم وليصل بهم رجل منهم ) )(@)(@@) ( حم 3 ) عن مالك بن الحويرث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1423 ) قال النبي : $ 30 ( إذا زالت الأفياء وراحت الأرواح فاطلبوا إلى الله حوائجكم فإنها ساعة الأوابين ، وإنه كان للأوابين غفورا ) ( هب ) عن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1424 ) قال النبي :(@)(@@) | 30 ( إذا زالت الشمس فصلوا ) )(@)(@@) ( طب ) عن خباب رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1425 ) قال النبي :(@)(@@) | 30 ( إذا زخرفتم مساجدكم وحليتم مصاحفكم فالدمار عليكم ) )(@)(@@) ( الحكيم ) عن أبي الدرداء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1426 ) قال النبي :(@)(@@) | 30 ( إذا زلزلت تعدل نصف القرآن وقل يا أيها الكافرون PageV01P216 تعدل ربع القرآن ، وقل هو الله أحد تعدل ثلث القرآن ) )(@)(@@) ( ت ك هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1427 ) قال النبي :(@)(@@) | 30 ( إذا زنى العبد خرج منه الإيمان فكان على رأسه كالظلة فإذا أقلع رجع إليه ) )(@)(@@) ( د ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1428 ) قال النبي :(@)(@@) | 30 ( إذا زنت أمة أحدكم فتبين زناها فليجلدها ولا يثرب ، ثم إن زنت فليجلدها ولا يثرب ، ثم إن زنت الثالثة فليبعها ولو بحبل من شعر ) )(@)(@@) ( حم ق ن د ه ) عن أبي هريرة وزيد بن خالد رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1429 ) قال 
ms154	 النبي :(@)(@@) | 30 ( إذا زنت الأمة فاجلدوها ، فإن زنت فاجلدوها ، فإن زنت فاجلدوها ثم بيعوها ولو بضفير ) )(@)(@@) ( حم ه ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1430 ) قال النبي :(@)(@@) | 30 ( إذا زوج أحدكم خادمه عبده أو أجيره فلا ينظر إلى ما دون السرة وفوق الركبة ) ( د هق ) عن ا$ بن عمرو رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1431 ) قال النبي :(@)(@@) | 30 ( إذا سافرتما فأذنا وأقيما وليؤمكما أكبركما ) )(@)(@@) ( ت ن حب ) عن مالك بن الحويرث رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1432 ) قال النبي :(@)(@@) | 30 ( إذا سافرتم فليؤمكم أقرؤكم وإن كان أصغركم ، وإذا أمكم فهو أميركم ) )(@)(@@) ( البزار ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1433 ) قال النبي :(@)(@@) | 30 ( إذا سافرتم في الخصب فأعطوا الإبل حظها من الأرض ، وإذا سافرتم في السنة فأسرعوا عليها السير ، وإذا عرستم بالليل فاجتنبوا الطريق ، فإنها طرق الدواب ومأوى الهوام بالليل ) )(@)(@@) ( م د ت ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P217(@)(@@)(@@)(@@) $ ( 1434 ) قال النبي :(@)(@@) | 30 ( إذا ساق الله إليك رزقا من غير مسألة ولا إشراف نفس فخذه فإن الله أعطاكه ) )(@)(@@) ( حب ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1435 ) قال النبي :(@)(@@) | 30 ( إذا سأل أحدكم الرزق فليسأل الحلال ) )(@)(@@) ( عد ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1436 ) قال النبي :(@)(@@) | 30 ( إذا سئل أحدكم أمؤمن هو فلا يشك في إيمانه ) )(@)(@@) ( طب ) عن عبد الله بن زيد الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1437 ) قال النبي :(@)(@@) | 30 ( إذا سأل أحدكم ربه مسألة فتعرف الإجابة فليقل الحمد لله الذي بنعمته تتم الصالحات ، ومن أبطأ عنه ذالك فليقل : الحمد لله على كل حال ) )(@)(@@) ( البيهقي ) في الدعوات عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1438 ) قال النبي :(@)(@@) | 30 ( إذا سأل أحدكم فليكثر فإنما يسأل ربه ) )(@)(@@) ( حب ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1439 ) قال النبي :(@)(@@) | 30 ( إذا سئل الرجل عن أخيه فهو بالخيار إن شاء سكت وإن شاء قال فصدق ) )(@)(@@) ( د ) في مراسيله ( هق ) عن الحسن مرسلا ( ز ) .(@)(@@)(@@)(@@) $ ( 1440 ) قال النبي :(@)(@@) | 30 ( إذا