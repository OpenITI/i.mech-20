ms121	 ما زادكم منهن غير جوايف % % هوادر يرددن المسابر واليدا % % PageV01P423 31(@)(@@) % دعوا لقم العلياء للمهتدي به % % وخلوا طريقا غار فيه وأنجدا % % 32(@)(@@) % لأطولكم طولا ، إذا المزن أصبحت % غوارز لا يعدمن خلفا مجددا % % 33(@)(@@) % نهيتكم عن ذي هماهم مشبل % حمى بجنوب السيء ضالا وعرقدا % % 34(@)(@@) % فضافض غيل في الدماء عييه % % كأن على ليتيه سبا موردا % % 35(@)(@@) % يفرق بين الجحفلين زثيره % % كما اط نجدي الغمام وارعدا % % 36(@)(@@) % يجر سآبي الدماء وراءه % مجر الخليع الشرعبي المعضدا % % 37(@)(@@) % و حذرتكم مغلولبا ذا غطامط % % اذا كب بوصي السفين وازبدا % % 38(@)(@@) % له زجل كالفحل يقرع شوله % الظ بقرقار الهدير ورددا % % 39(@)(@@) % الا اخرس الغاوي ولا فاه قائل % % بامثالها ما بلل القطر جلمدا % % 40(@)(@@) % ولاوجد الراجون افقك مظلما % % وزند الندى يوما بكفك مصلدا % % PageV01P424 41(@)(@@) % ولاسمع الاعداء الا باصلم % % ولا نظر الحساد الا بارمدا % % 42(@)(@@) % فليس المنى ما عشت قالصة الجنى % % علينا ولا النعمى بناقصة الجدا % % 43(@)(@@) % بقيت بقاء القول فيك فانه % % إذا بلغ الباقي المدى جاوز المدى % % 44(@)(@@) % ولابعد المأمول من ان تناله % % فان فات في ذا اليوم ادركته غدا % % 45(@)(@@) % و مليت حتى تسأم العيش ملة % % فلو خلد الاقوام كنت المخلدا % % PageV01P425 البحر : طويل 1(@)(@@) % إباء أقام الدهر عني وأقعدا % % وصبر على الأيام أنأى وأبعدا % % 2(@)(@@) % وقلب تقاضاه الجوانح انة % % إذا راح ملآنا من الهم ، أو غدا % % 3(@)(@@) % أخوذ على أيدي المطامع بالنوى % % نزاعا ، وما يزداد إلا تبعدا % % 4(@)(@@) % إذا ركبت اماله ظهر نية % % رأيت غلاما غائر الشوق متجدا % % 5(@)(@@) % غذي زماع لا يمل كأنما % % يرى الليل كورا والمجرة مقودا % % 6(@)(@@) % يلثم عرنين الحسام بهمة % تكلفه خوض الليالي مجردا % % 7(@)(@@) % أيا خاطبا ودي على النأي ، إنني % % صديقك إن كنت الحسام المهندا % % 8(@)(@@) % فإني رأيت السيف أنصر للفتى % % إذا قال قولا ماضيا أو توعدا % % 9(@)(@@) % أرى بين نيل العز والذل ساعة % من الطعن تقتاد الوشيج المقصدا % % 10(@)(@@) % فمن أخرته نفسه مات عاجزا % و من قدمته نفسه مات سيدا % % PageV01P426 11(@)(@@) % إذا كان إقدام الفتى ضائرا له % فما المجد مطلوبا ، ولا 
ms122	 العز مفتدى % % 12(@)(@@) % فدى لابن عباد ضنين بنفسه % إذا نقض الروع الطراف الممددا % % 13(@)(@@) % ودبر أطراف الرماح ، وإنما % % يدبر قبل الطعن رأيا مسددا % % 14(@)(@@) % به طال من خطوي وكنت كانني % % مشيت إلى نيل المعالي مقيدا % % 15(@)(@@) % ومن مات في حبس المذلة قلبه % رأى العز في دار المذلة مولدا % % 16(@)(@@) % يسر الفتى حمل النجاد ، وربما % % رأى حتفه في صفحتي ما تقلدا % % 17(@)(@@) % لنال المعالي من يدل بنفسه % % ولا يذخر الآباء مجدا موطدا % % 18(@)(@@) % و ما يستفاد العز من شيمة الفتى % % اذا كان في دين المعالي مقلدا % % 19(@)(@@) % أبا قاسم هذا الذي كنت راجيا % لا رغم اعداء واكبت حسدا % % 20(@)(@@) % لئن كنت في مدح العلى فاغرا فما % وان ظمئت امالنا كنت موردا % % PageV01P427 21(@)(@@) % فيا ليت رعيان القضيمة خيروا % % لبست إليك الشرعبي المعضدا % % 22(@)(@@) % و لو كان لا يجني على المرء بأسه % % لدرعني العزم الدلاص المسردا % % 23(@)(@@) % وليل دفعناه إليك ، كأنما % % دفعنا به لجا من اليم مزبدا % % 24(@)(@@) % وشمس خلعناها عليك مريضة % وكنا لبسناها رداء موردا % % 25(@)(@@) % وملك أنفنا أن نقيم ببابه % فزودنا زاد امرىء ما تزودا % % 26(@)(@@) % وأمرد حي ملتح بلثامه % يطول جوادا قادح السن أجردا % % 27(@)(@@) % رأى أرجل الخوص الخماص كأنما % % تسالب أيديها النجاء العمردا % % 28(@)(@@) % تركنا لا يد العيس ما خلف ظهرها % % ومن ذل في دار رأى البعد أحمدا % % 29(@)(@@) % وسرنا على رغم الظلام كأننا % % بدور تلاقي من جنابك اسعدا % % 30(@)(@@) % تركت اليك الناس طرا كانني % % أرى كل محجوب بعيرا معبدا % % PageV01P428 31(@)(@@) % % باني رعيت العز غضا مجددا % % 32(@)(@@) % فلله نور في محياك انه % % يمزق جلبابا من الليل اربدا % % 33(@)(@@) % ولله ما ضمت ثناياك ، إنها % % ثنايا جبال تطلع البأس والندى % % 34(@)(@@) % أغر ضوءها ، يا قبلة المجد ، إنني % % ارى غرر الامال نحوك سجدا % % 35(@)(@@) % وأنت الذي ما احتل في الأرض مقعدا % من الجد الا شتق في الجومصعدا % % 36(@)(@@) % إذا ظمئت عيس إليك ، فإنما % % حقائبها تروي لجينا وعسجدا % % 37(@)(@@) % تكتمك الأسرار حزما وفطنة % وتفضحك الآراء عزا وسؤددا % % 38(@)(@@) % وما كنت إلا السيف يعرف 
ms123	 منتضى % % وينكر في بعض المواطن مغمدا % % 39(@)(@@) % وحي جلال قد صبحت بغارة % من الخيل يستاق النعام المشردا % % 40(@)(@@) % ويوم من الأيام شوهت وجهه % بأغبر كد الطير حتى تبلدا % % PageV01P429 41(@)(@@) % رمت بك أقصى المجد نفس شريفة % وقلب جريء لا يخاف من الردى % % 42(@)(@@) % و همة مقدام على كل فتكة % % يفارق فيها طبعه ما تعودا % % 43(@)(@@) % مقيم بصحراء الضغائن مصحرا % % اذا اخمدت من نارها اوقدا % % 44(@)(@@) % لك القلم الماضي الذي لو قرنته % بجري العوالي كان أجرى وأجودا % % 45(@)(@@) % إذا انسل من عقد البنان حسبته % يحوك على القرطاس بردا معمدا % % 46(@)(@@) % يغازل منه الخط عينا كحيلة % إذا عاد يوما ناظر الرمح أرمدا % % 47(@)(@@) % و ان مج نصل من دم الصرب احمرا % % أراق دما من مقتل الخطب أسودا % % 48(@)(@@) % اذا استرعفته همة منك غادرت % % قوادمه تجري وعيدا وموعدا % % 49(@)(@@) % ساثني باشعاري عليك فانني % % رأيت مسود القوم يطري المسودا % % 50(@)(@@) % فما عرفتني الأرض غيرك مطلبا % % ولا بلغتني العيس إلاك مقصدا % % PageV01P430 51(@)(@@) % ألا إن ترك الحمد تبخيل محسن % وما بذل المعطاء الا ليحمدا % % 52(@)(@@) % % فإني إلى غير الندى باسط يدا % % 53(@)(@@) % خطبت اليك الود لاشيء غيره % % وود الفتى كالبر يعطى ويجتدى % % 54(@)(@@) % دعاني اليك العز حتى اجبته % % ومن طلبته جمة الماء أوردا % % 55(@)(@@) % وإني لأرجو من جوارك فعلة % أغيظ بها الحساد مثنى وموحدا % % 56(@)(@@) % و مدحك هذا بكر مدح مدحته % % وكنت أروض القول حتى تسددا % % 57(@)(@@) % ولو علقت مني بغيرك مدحة % لكنت كمن يعتاض بالماء جلمدا % % 58(@)(@@) % و لست براض هذه لك تحفة % % أضمنها فيك الثناء المخلدا % % 59(@)(@@) % فإن كان شعري فاتك اليوم آبيا % علي ، فإني سوف أعطيكه عدا % % 60(@)(@@) % ولولاك ما أومى إلى المدح شاعر % يعد عليا للعلى ومحمدا % % PageV01P431 61(@)(@@) % أبوه أبوه المستطيل بنفسه % على العز مصروفا به ومقلدا % % 62(@)(@@) % فتى سنه عن خمسه عشرة حجة % % تربى له فضلا ومجدا ومحتدا % % 63(@)(@@) % فتي الصبا كهل الفضائل ما مشى % % إلى العمر إلا احتل في الفضل مقعدا % % 64(@)(@@) % % حديثا ولا يدعو من الناس منجدا % % 65(@)(@@) % ولا طالبا 
ms124	 من دهره فوق قوته % كفاني من الغدران ما نقع الصدا % % 66(@)(@@) % سأحمد عيشا صان وجهي بمائه % وان كان ما اعطى قليلا مصردا % % 67(@)(@@) % و قالوا لقاء الناس انس وراحة % % ولو كنت ارضى الناس ماكنت مفردا % % 68(@)(@@) % طربت إلى الفضل الذي فيك وانتشى % % لذكرك شعري راقدا ومسهدا % % 69(@)(@@) % وما كنت إلا عاشقا ضاع شجوه % فأصبح يستملي الحمام المغردا % % 70(@)(@@) % و ليس عجيبا ان طغى فيك مقول % % رآك حقيقا في المعالي ، فجودا % % PageV01P432 71(@)(@@) % بعدت عن الاتشاد من غير رغبة % % ولكنني استخلفت نعماك منشدا % % 72(@)(@@) % فمرني بأمر قبل موتي فانني % % ارى المرء لا يبقى وان بعد المدى % % 73(@)(@@) % وما الميت إلا راحل كره النوى % % وأعجله المقدار أن يتزودا % % PageV01P433 البحر : كامل تام 1(@)(@@) % أثر الهوادج في عراص البيد % % مثل الجبال على الجمال القود % 2(@)(@@) % يطلعبن من رمل الشقيق لواغبا % زحف الجنوب بعارض ممدود % 3(@)(@@) % كم بان في المتحملين عشية % % من ذي لمى خضر الرضاب برود % % 4(@)(@@) % وقضيب اسحله لو انعطف الصبا % % يوما لنا بقوامه الأملود % 5(@)(@@) % مروا على رملي زرود فهل ترى % % الصاقة لحشى برمل ذرود % % 6(@)(@@) % متلفتين من القباب كانما % % انتقبوا باعين ربرب وخدود % % 7(@)(@@) % غرسوا الغصون على النقا وترنحوا % % من كل مائلة الغدائر رود % 8(@)(@@) % إن اللآلي بين أصداف اللمى % % غلبت مراشفها على مجلودي % % 9(@)(@@) % ولووا بوعدي يوم خف قطينهم % ومن الصدود اللي بالموعود % 10(@)(@@) % لم ترضني تلك الليالي عنهم % بنوالهم ، فأقول يوما : عودي % % PageV01P434 11(@)(@@) % سيان قربهم علي ، وبعدهم % لولا الجوى وعلاقة المعمود % % 12(@)(@@) % ربعت على آثاركم نجدية % غراء ذات بوارق ورعود % 13(@)(@@) % تسقي معالم منكم لولا النوى % % لم أرمها بقلى ، ولا بصدود % 14(@)(@@) % و لعجت فيها طارحا عن ناظري % % ثقل الدموع ، وثانيا من جيدي % % 15(@)(@@) % هل تبردون حرارة من حائم % % حران عن ذاك الغدير مذود % % 16(@)(@@) % فلقد تمعك في مواطئ عيسكم % % يوم الوداع ، تمعك الموؤود % 17(@)(@@) % وأما وذياك الغزيل إنه % عرض الزلال وحال دون ورودي % % 18(@)(@@) % أغدو إلى طرد الظباء ، وأنثني % % وانا الطريدة للظباء الغيد % % 19(@)(@@) % حتام تعتلق البطالة مقودي % % ويعودني 
ms125	 لهوى الظعائن عيدي % % 20(@)(@@) % عشرون اردفها الزمان باربع % % ارهفنني ومنعن من تجريدي % % PageV01P435 21(@)(@@) % أعلقت في سرب الخطوب حبائلي % % وقدحت في ظلم الأمور زنودي % % 22(@)(@@) % وكرعت في حلو الزملان ومره % % ما شئت واعتقب العواجم عودي % % 23(@)(@@) % و فرعت رابية العلى متمهلا % كفاه أخمطة العلى ، والجود % 24(@)(@@) % وخبطت في المتعرضين بقولة % جداء من بدع الزمان شرود % % 25(@)(@@) % فضربت أوجههم بغير مناصل % وهزمت جمعهم بغير جنود % 26(@)(@@) % ما ضرني ، لما فللت غروبهم % أني كثرت لهم وقل عديدي % % 27(@)(@@) % و أبي الذي حسد الرجال قديمه % % إن المناقب آية المحسود % 28(@)(@@) % ذو السن والشرف الذي جمعت به % كفاه اخمطه العلى والجود % % 29(@)(@@) % احدى اخامصه رقاب عداته % % من سيد بلغ العلى ومسود % % 30(@)(@@) % فالان اذ نبذ المشيب شبيبتي % % نبذ القذى ، وأقام من تأويدي % % PageV01P436 31(@)(@@) % وفررت من سن القروح تجاربا % وعسا على قعس السنين عمودي % % 32(@)(@@) % ولبست في الصغر العلى مستبدلا % اطواقها بتمائم المولود % % 33(@)(@@) % و صفقت فيث ايدي الخلائف راهنا % % لهم يدي بوثائق وعقود % % 34(@)(@@) % وحللت عندهم محل المجتبى % % ونزلت منهم منزل المودود % % 35(@)(@@) % فغر العدو يريد ذم فضائلي % % هيهات ألجم فوك بالجلمود % 36(@)(@@) % همسا ، فكم أسكت قبلك كاشحا % بمناقبي ، وعلي فضل مزيد % 37(@)(@@) % مالي اريغ النصف من متحامل % % أو أطلب الإجمال عند حسود % 38(@)(@@) % أم كيف يرأمني ، وليس بمنجبي % % اترى الرؤوم تكون غير ولود % % 39(@)(@@) % فلأنهضن إلى المعالي نهضة % ملء الزمان تفي بطول قعودي % % 40(@)(@@) % إجمح أمامك إن هممت بفعلة % وتغاب عن عذل وعن تفنيد % PageV01P437 41(@)(@@) % وإذا التفت إلى العواقب بدلت % قلب الجري بمهجة الرعديد % 42(@)(@@) % قد قلت للابل الطلاح حدوتها % % غلس الظلام بسائق غريد % % 43(@)(@@) % من كل مضطرب الزمام كانه % % في الليل زم بأرقم مطرود % 44(@)(@@) % فتل الطوى أجوافها بظهورها % % واحل اكل لحومها للبيد % % 45(@)(@@) % إن لم تري كافي الكفاة ، فلم يزل % % منكن مسقط ظالع أو مود % 46(@)(@@) % بهداه يستضوي الورى وبهديه % قرب الطريق لهم إلى المعبود % % 47(@)(@@) % اسد إذا جر القبائل خلفه % % حل الطلى بلوائه المعقود % % 48(@)(@@) % ومقصر في الطول غير مقصر % في 
ms126	 الضرب يقطع كل حبل وريد % % 49(@)(@@) % ومزعزع مثل الجرير ، إذا انحنى % % للطعن شيع بالطوال الميد % 50(@)(@@) % ما مر يسحب منه إلا رده % ريان يقطر من دماء الصيد % % PageV01P438 51(@)(@@) % والجيش يرفع عمة من قسطل % فوق القنا ويجر ذيل حديد % 52(@)(@@) % سلف لكل كتيبة يطأ العدى % % فيها مفاجأة بغير وعيد % % 53(@)(@@) % في غلمة حملوا القنا وتحملوا % % اعباء يوم المأزق المشهود % % 54(@)(@@) % قوم ، إذا ركبوا الجياد تجلببوا % % بقساطل وتعمموا ببنود % 55(@)(@@) % و اذا سروا كمنوا كمون اراقم % % واذا لقوا برزوا بروز اسود % % 56(@)(@@) % و اذا هتفت بهم ليوم كريهة % % تدمى غوارب نحرها المورود % % 57(@)(@@) % كثروا الحصى بجموعهم وتلاحقوا % % بك من قيام في السروج قعود % 58(@)(@@) % كم من عدو قد ابات كانما % % يطوي الضلوع على قنا مقصود % 59(@)(@@) % لوعيد محتضر العدى بحسامه % قبل احتمال ضغائن وحقود % % 60(@)(@@) % و موللات كالرماح تلمظت % % فيها المنون تلمظ المزؤود % % PageV01P439 61(@)(@@) % سود المخاطم ينتظمن محاسنا % % بيضا ، يضئن على الليالي السود % 62(@)(@@) % كتفتح النوار فتقه الحيا % % أو كالصباح فرى الدجى بعمود % % 63(@)(@@) % ما زال قدر من عقيرة سيفه % % علما أمام رواقه الممدود % 64(@)(@@) % وجفان جود كالركايا تستقى % % أبدا بأيدي نزل ووفود % 65(@)(@@) % كم حجة لك في النوافل نوهت % بدعاء دين العدل والتوحيد % % 66(@)(@@) % و مجادل ادمى جدالك قلبه % % وأعضه بجوانب الصيخود % 67(@)(@@) % وشفيت ممترض الهدى من معشر % سدوا من الآراء غير سديد % 68(@)(@@) % قارعتهم بالقول حتى أذعنوا % % وأطلت نوم الصارم المغمود % 69(@)(@@) % جمر بمسهكة الرياح نسفته % % كان الضلال يمده بوقود % % 70(@)(@@) % في كل معضلة أضب رتاجها % % يلقي إليك الدين بالإقليد % PageV01P440 71(@)(@@) % فالله يشكر والنبي محمد % وقفات مبد في النضال معيد % 72(@)(@@) % رأي يغب ، إذا الرجال تلهوجوا % % الآراء ، أو عجلوا عن التسديد % 73(@)(@@) % لو كان يمكنني التقلب لم يكن % % إلا إليك تهائمي ونجودي % % 74(@)(@@) % و طويت ما بعدت مسافة بيننا % % ان البعيد اليك غير بعيد % % 75(@)(@@) % وأنخت عيسي في جنابك طارحا % بفناء دارك انسعى وقتودي % % 76(@)(@@) % و تركت اسوقها نكوس عقيرة % % متبدلات صوارم بقيود % % 77(@)(@@) % بيني وبينك حرمتان تلاقتا % % نثري الذي 
ms127	 بك يقتدي وقصيدي % % 78(@)(@@) % ووصايل الادب الذي تصل الفتى % % لا باتصال قبائل وجدود % % 79(@)(@@) % قد كنت اعقل عن سواك عقائلي % % وأصون در قلائدي وعقودي % % 80(@)(@@) % و احوك افواف القريض فلا ارى % % ان ادنس باللئام برودي % % PageV01P441 81(@)(@@) % ولقد ذممت الناس قبلك كلهم % % فالان طرق لي إلى المحمود % % 82(@)(@@) % إن أهد أشعاري إليك ، فإنه % كالسرد أعرضه على داود % 83(@)(@@) % لكنني أعطيت صفو خواطري % % وسقيت ما صبت علي رعودي % % 84(@)(@@) % وسمحت بالموجود عند بلاغتي % % إني كذاك أجود بالموجود % PageV01P442 البحر : طويل 1(@)(@@) % اعاتب لومي وما الذنب واحد % % وهن الليالي الباديات العوائد % % 2(@)(@@) % وأهون شيء في الزمان خطوبه % اذا لم يعاونها العدو المعاند % % 3(@)(@@) % وكيف تلذ العيش عين ثقيلة % % على الخلق أو قلب على الدهر واجد % % 4(@)(@@) % وناضب مال ، وهو في الجود فائض % وناقص حظ وهو في المجد زائد % % 5(@)(@@) % تضوت شبابا لم انل فيه سبة % % على ان شيطان البطالة مارد % % 6(@)(@@) % وكل فتى لم يرض عن عزمة القنا % % ومن عددي قلب جري وساعد % 7(@)(@@) % وعندي إباء لا يلين لغامز % ولو نازعتنيه الرقاق البوارد % 8(@)(@@) % % ذليلا ولو ناجى علاه الفراقد % % 9(@)(@@) % و لولا الوزير الازدشيري وحده % % لغاض المعالي والندى والمحامد % % 10(@)(@@) % وسد طريق المجد عن كل سالك % وضاقت على الآمال هذي الموارد % PageV01P443 11(@)(@@) % فتى نفحتني منه ريح بليلة % % تغادر عودي وهو ريان مائد % % 12(@)(@@) % ومد بضبعي يوم لا العزم ناصر % ولا الرمح مناع ، ولا العضب ذائد % 13(@)(@@) % وساعد جدي في بلوغي إلى العلى % % وما بلغ الآمال إلا المساعد % 14(@)(@@) % على حين ولاني المقارب صده % وزاد على الصد العدو المباعد % 15(@)(@@) % تود العلى طلابها وهو وادع % % ويبلغ ما لم يبلغوا وهو قاعد % % 16(@)(@@) % يخلى له عن كل عز وسؤدد % ويلقى اليه في الامور المقالد % % 17(@)(@@) % انيس سروج الخيل في كل ظلمة % % وبين الغواني مضجع منه بارد % 18(@)(@@) % هموم تناجي بالعلاء وهمة % % لها فارط في كل مجد ورائد % 19(@)(@@) % يعلمه بهرام كل شجاعة % % ويقطعه اقصى المعالي عطارد % % 20(@)(@@) % و كيف يغص الاقربون بورده % % وقد نهلت منه الرجال 
ms128	 الاباعد % % PageV01P444 21(@)(@@) % لك الله ما الآمال الا ركائب % % وانت لها هاد وحاد وقايد % % 22(@)(@@) % أبى لك إلا الفضل نفس كريمة % ورأي إلى فعل الجميل معاود % 23(@)(@@) % وطود من العلياء مدت سموكه % فطالت ذراه واطمأن القواعد % 24(@)(@@) % وإني لأرجو من علائك دولة % تنذلل لي فيها الرقاب العواند % % 25(@)(@@) % ويوما يظل الخافقين بمزنة % رذاذ ، غواديها الرؤوس الشوارد % 26(@)(@@) % لا عقد مجدا يعجز الناس حله % % وتنحل من هام الاعادي معاقد % % 27(@)(@@) % فمن ذا يراميني ولي منك جنة % ومن ذا يدانيني ولي منك عاضد % % 28(@)(@@) % علي رداء من جمالك واسع % % وعندي عز من جلالك خالد % % 29(@)(@@) % ولو كنت ممن يملك المال رقه % % لقلت بعنقي من نداك قلائد % % 30(@)(@@) % فلا تتركني عرضة لمضاغن % % يطارد في اضغانه واطارد % % PageV01P445 31(@)(@@) % و لولا صدود منك هانت عظائم % % تشق على غيري وذلت شدائد % 32(@)(@@) % و لكنك المرء الذي تحت سخطه % % أسود ترامى بالردى وأساود % 33(@)(@@) % كانك للارض العريضة مالك % % وحيدا ، وللدنيا العظيمة والد % 34(@)(@@) % فعودا إلى الحلم الذي أنت أهله % فمثلك بالإحسان باد وعائد % 35(@)(@@) % و حام على ما بيننا من قرابة % % فان الذي بيني وبينك شاهد % % 36(@)(@@) % وأرع مقالي منك أذنا سميعة % لها بلقاء السائلين عوائد % % 37(@)(@@) % ومر بجواب يشبه البدء عوده % % ليردي عدوا ، أو ليكبت حاسد % PageV01P446 البحر : مجزوء الوافر 1(@)(@@) % أكافينا النصيح بقي % % فينا دائما ابدا % % 2(@)(@@) % قمت إلى العلى قدما % % وتبسط بالنوال يد % % 3(@)(@@) % لئن حرقتني عذلا % لقد نوهت بي صعدا % % 4(@)(@@) % فطلت الاطولين علا % % وفت الابعدين مدى % % 5(@)(@@) % علي طروق وردكم % وليس علي ان اردا % % PageV01P447 البحر : سريع 1(@)(@@) % اذا احتبى بالعشب الوادي % % وانحل فيه الواكف الغادي % % 2(@)(@@) % وفوفت ريح الصبا متنه % تفويف اعلام وابرادي % % 3(@)(@@) % فلا سقاك الله من صفوة % % أو تنجزي في السير ميعادي % % 4(@)(@@) % رب طلاب أتلع رمته % وحاجة عالية الهادي % % 5(@)(@@) % معتجرا بالليل أحدو به % بزلاء تستولي على الحادي % % 6(@)(@@) % لا أرد الماء ، ولو أنني % % ضجيع اسدام واعداد % % 7(@)(@@) % كانني روعاء مطرودة % % يزور عنها جانب الوادي % % 8(@)(@@) % هذا ، وكم فيض ترشفته % والماء 
ms129	 لا يلوي على الصادي % % 9(@)(@@) % تؤم بي الخرقاء مخطومة % امام وراد ورواد % % 10(@)(@@) % اشرف بيت من بني هاشم % % وخير اطناب واعماد % % PageV01P448 11(@)(@@) % القت اليه ناقتي في السرى % % وما له من حتفه فاد % 12(@)(@@) % تركت من ليست له همة % % ملتفتا في الماء والزاد % 13(@)(@@) % تلوث موسى بابنه في العلى % % بفضل اجداد واجداد % % 14(@)(@@) % نعم حمى الدرع ليوم الوغى % % انت وراع الحلم للنادي % % 15(@)(@@) % إذا القنا مد مدى باعه % عانقته في ثوب فرصاد % % 16(@)(@@) % أدعوك ، والدهر له وقفة % ما بين اصداري وايرادي % % 17(@)(@@) % لمثلها ادعو بنات السرى % % تخلط أعناقا بأعضاد % 18(@)(@@) % نفسي كما تعرق صبارة % % لو لم يفض الخطب من آدي % % 19(@)(@@) % ولو أمنت الدهر أحداثه % صافحت كف الضيغم العادي % % 20(@)(@@) % مالي لا ارغب عن بلدة % % ترغب في كثرة حسادي % % PageV01P449 21(@)(@@) % ما الرزق بالكرخ مقيم ، ولا % % طوق العلى في جيد بغداد % % 22(@)(@@) % بكل أرض ، إن توردتها % % ديار أشكال وأضداد % 23(@)(@@) % انحلني فيها طلاب العلى % % وذاك فخري عند أندادي % % 24(@)(@@) % لو كان دائي من غرام الهوى % % جزعت من ابصار عوادي % % 25(@)(@@) % أين الغواني من طلابي وما % % أطلب إلا الرائح الغادي % % 26(@)(@@) % اكثر ما يلقينني ساهرا % ما بين اعراف واكتاد % % 27(@)(@@) % وقل ما يلقينني راقدا % ما بين احشاء واجيادي % % 28(@)(@@) % ان مسنى ناب الردى لم اقل % % يا ليت موتي كان ميلادي % % 29(@)(@@) % سيان ما سيري على سابح % أو شرجع تخفق ابرادي % % 30(@)(@@) % % لها المقادير بمرصاد % PageV01P450 31(@)(@@) % تفدي الفتى في عيشه السن % % وما له من حنفه فاد % % 32(@)(@@) % قالوا ، وما أنكرها قولة % من مائق في الغي منقاد % 33(@)(@@) % الظلم والانصاف من فعل من % % يحكم في الحاضر والبادي % % 34(@)(@@) % فقلت اني وجميع الورى % % منه على وعد وإيعاد % 35(@)(@@) % إن كان إسلامي على هذه % فكل غي عند إرشادي % % 36(@)(@@) % هيهات لا احسد ذا قدرة % % ولو حوى عاقر اغمادي % % 37(@)(@@) % ولو حسدت الفضل في اهله % % PageV01P451 البحر : خفيف تام 1(@)(@@) % شقيت منك بالعلاء الاعادي % % والمعالي ضرائر الحساد % 2(@)(@@) % واستقاد الزمان بعد التداني % % من رجال تفاءلوا بالبعاد % % 3(@)(@@) % ورعيت الإياب 
ms130	 غضا جديدا % وتبدلت مطمحا بالقياد % % 4(@)(@@) % واذا ما الشجاع شمر برديه % % ه ، فلله أي يوم جلاد % 5(@)(@@) % أمرعت أرضنا بكل مكان % واستجابت لنا بروق الغوادي % % 6(@)(@@) % وحبانا بوبله كل أفق % واتانا بسيله كل واد % % 7(@)(@@) % اترى آن للمنى ان تقاضى % % حاجة طال مطلها في الفؤاد % % 8(@)(@@) % بين هم تحت المناسم مطرو % % ح وعزم على ظهور الجياد % % 9(@)(@@) % ومهار يكدها كل يوم % % طرد ، أو قوارح في الطراد % 10(@)(@@) % من قلوب لها التقلب في العز % م وايد طليقة بالايادي % % PageV01P452 11(@)(@@) % ما يبالي الهمام اين ترقى % % وخباء العلى امين العباد % % 12(@)(@@) % يا حياة يشجى بها كل حي % % والتوالي شجية بالهوادي % % 13(@)(@@) % إن سما بالنفاق غيرك ، فالأو % عال ملوية على الأطواد % 14(@)(@@) % أو تعاطى مداك فالمرء مسبو % % ق اذا كف من عنان الجواد % % 15(@)(@@) % حركت عزمة المعالي ، ولكن % يحدث السيل خفة في الجماد % 16(@)(@@) % كيف يستعمل السماح وبذل ال % % المال غير المعلم المستفاد % % 17(@)(@@) % نحن في عصبة ترى الجور عدلا % وتسمي الضلال دار رشاد % 18(@)(@@) % لو أجيزت له العيادة يوما % وديار تسطو على الوراد % % 19(@)(@@) % إنما أنت نعمة الله في الأر % ض ، إذا كان نقمة للعباد % 20(@)(@@) % لك طبع تعرفته الليالي % % وامترى فيه كل قار وبادي % % PageV01P453 21(@)(@@) % جاعل قسوة الوعيد على الايام % % عبدا لرقة النيعاد % % 22(@)(@@) % ايكون البخيل غير بخيل % % أم يكون الجواد غير جواد % 23(@)(@@) % لأجار الزمان من كل بؤس % ظاهر الجد طاهر الأجداد % 24(@)(@@) % فرحات به العيون كما تف % % رح بالعشب اعين الرواد % % 25(@)(@@) % واضح العزم متلئب المطايا % % سمحت كفه به للمنايا % % 26(@)(@@) % أخذت كفه بصخرة عزم % دوخت بالطلاب هام البلاد % 27(@)(@@) % وجبان لويت عنه ، فأمسى % % وجل العين من قراع الرقاد % % 28(@)(@@) % مستطيرا كأن هداب جفني % % يه على الناظرين شوك القتاد % % 29(@)(@@) % لا أقال الإله من خانك العه % د ، وجازاك بغضة بالوداد % 30(@)(@@) % ظن بالعجز ان حسبك ذل % % والمواضي تصان بالأغماد % PageV01P454 31(@)(@@) % قصر الدهر من ذراه ، وقد كا % % ن بتلك الظبى طويل النجاد % 32(@)(@@) % وأذل الزمان بعدك عطفي % ه ، وقد كان من 
ms131	 أعز العباد % 33(@)(@@) % كنت ليثا وكان ذئبا ولكن % % لا تلذ الأشكال بالأضداد % 34(@)(@@) % و تمادى بما جناه على الأيام % % يام حتى جنى عليه التمادي % % 35(@)(@@) % سمحت كفه به المنايا % % بعد ان لم يكن من الاجواد % % 36(@)(@@) % ظن ان المدى يطول وفي الآ % % مال ما لا يعان بالأجداد % 37(@)(@@) % كل حي يغالط العيش بالد % % هر وكل تعدو عليه العوادي % % 38(@)(@@) % لو رجعنا إلى العقول يقينا % لرأينا الممات في الميلاد % 39(@)(@@) % كيف لا يطلب الحمام عليل % % حكم الدهر فيه رأي المعاد % 40(@)(@@) % لو اجتزت له العيادة يوما % لقضى من فظاظة العواد % % PageV01P455 41(@)(@@) % أو تصدى لمجمع جرحته % % ألسن القوم بالعيون الحداد % 42(@)(@@) % هكذا تدرك النفوس من الأع % داء برد القلوب والأكباد % 43(@)(@@) % كل حبس يهون عند الليالي % % بعد حبس الارواح في الاجساد % % 44(@)(@@) % % حشاء مزرورة على الاحقاد % % 45(@)(@@) % نلت بعضا وسوف تدرك كلا % إنما السيل بعد قطر العهاد % 46(@)(@@) % مثل ما مر لا تعيد الليالي % % والحديث السفيه غير معاد % 47(@)(@@) % رب يوم شهدته ، والمنايا % % تطرح الطعن من رؤوس الصعاد % % 49(@)(@@) % خلق الخيل بالنخيع وكانت % % غرر الخيل معقلا للجساد % % 50(@)(@@) % يا قريع الزمان ، دعوة صب % بالاماني متيم بالمراد % % 51(@)(@@) % لك إن ذمت المحاضر يوما % عنفوان الثناء في كل ناد % % PageV01P456 52(@)(@@) % نظر العيد منك بدرا تخفى % % برهة عن نواظر الاعياد % % 53(@)(@@) % فتهن السرور فاليوم مص % % قول الحواشي مجرر الابراد % % 54(@)(@@) % من مرام بعاده لتدان % ومراد نقصانه لازدياد % % 55(@)(@@) % لو قدرنا على المنى لفدينا % ذي الاضاحي من الظبي بالاعادي % % 56(@)(@@) % إنما نحن مشبهوك وما الأش % شبال الا طبائع الاساد % % 57(@)(@@) % نحن ذاك الغرار من هذه البي % % ض وذاك الشرار من ذا الزناد % 58(@)(@@) % هذه تحفتي اليك وخير الش % % شعر ما كان تحفة الإنشاد % 59(@)(@@) % وضميري إذا طرحتك فيه % جاش لي بحره بخير العتاد % % 60(@)(@@) % أنا من صفوة النبي ، وغيري % % ولد لا يعد في الأولاد % PageV01P457 البحر : منسرح 1(@)(@@) % خير الهوى ما نجا من الكمد % وعاشق العز ماجد الكبد % 2(@)(@@) % ما حمل الذل ظهر مارنة % % ولا انزوى عن 
ms132	 طبيعة الصيد % % 3(@)(@@) % كيف يربي الحياة مقتبل % يرى المنى عاقرا بلا ولد % 4(@)(@@) % يعذلني في الزماع كل فتى % % والسيف إن قر في الغمود صدي % % 5(@)(@@) % انا النضار الذي يضن به % % لو قلبتني يمين منتقد % % 6(@)(@@) % اني اظن الظنون صادقة % % كأن يومي طليعة لغدي % % 7(@)(@@) % ما وتر الدهر لمتي ، ويدي % % تاخذ قبل المشيب بالقود % % 8(@)(@@) % تغدر بي وفرتي وكنت اذا % % طلبت غير الوفاء لم اجد % % 9(@)(@@) % بعدكم حنت الركاب ، وسا % % ل الركب بالصحصحان والجدد % 10(@)(@@) % والليل بين النجوم تحسبه % % يحظر في نثرة من الزرد % % PageV01P458 11(@)(@@) % ليلي ببغداذ لا اقر به % % كانني فيه ناظر الرمد % % 12(@)(@@) % ينفر نومي كان مقلته % % تشرج اجفانها على ضمد % % 13(@)(@@) % افكر في حالة اطوالها % % و فعلة تخصب القنا بيدي % % 14(@)(@@) % للنفس أن تبعث العزائم والرأ % % ي وكل الفعال للجسد % % 15(@)(@@) % ها انها نومة بسورتها % % اقالت العين عثرة السهد % % 16(@)(@@) % لا اطردت بي إليك سابحة % حتى ارى النقع عالي الكتد % % 17(@)(@@) % مالي لا اركب البعاد ولا % % أدعى على القرب بيضة البلد % 18(@)(@@) % أصحب من لا ألوم صحبته % غير نزور الندى ولا جحد % % 19(@)(@@) % فتى رأى الدهر غير مؤتمن % % فما فشا سره إلى أحد % 20(@)(@@) % وأتهم الخيل ، فهو يمتحن ال % % رة قبل الطراد بالطرد % % PageV01P459 21(@)(@@) % في كل فج يقود راحلة % % تجذبها الأرض جذبة المسد % 22(@)(@@) % لا يبعد الله غلمة ركبوا % % أغراضهم واستفوا من البعد % 23(@)(@@) % رموا بعهد النعيم ، واصطنعوا % % كل بخيل الذباب مطرد % % 24(@)(@@) % قلوا على كثرة العدو لهم % كم عدد لا يعد في العدد % % 25(@)(@@) % لي فيهم أشرف الحظوظ ، إذ ال % % روع أعان الحسام بالعضد % 26(@)(@@) % و اين مثل الحسين ان احسنت % % صنائع البيض والقنا القصد % 27(@)(@@) % ابلج ان صاحت المطي به % % فدى التنائي بعيشة الرغد % 28(@)(@@) % ما خلع الدهر عنه سابغة % % والليث لا ينتضى من اللبد % % 29(@)(@@) % لو أمطرته السماء أنجمها % % عزا لما قال للسماء قدي % % 30(@)(@@) % لا يسال الضيف عن منازله % % ومنزل البدر غير مفتقد % % PageV01P460 31(@)(@@) % رأى الظبى في الغمود آجنة % والخيل ملطومة عن الأمد % 32 
ms133	(@)(@@) % فاسئل اسيافه واوردها % % غمر المنايا بمائها الثمد % % 33(@)(@@) % تخلق أجفانها ويعرضها % % دم الطلى في غلائل جدد % % 34(@)(@@) % يا قائد الخيل في سنابكها % % ما يشمت السهل منه بالجلد % 35(@)(@@) % يفديك يوم الخصام ممتهن % كأنه مضغة لمزدرد % 36(@)(@@) % وصارخ رافع عقيرته % فككت عنه جوامع الزرد % 37(@)(@@) % إذا المنى قابلتك أوجهها % % صفدت باع المطال بالصفد % 38(@)(@@) % رب مخوف كأن طلعته % تلقى المطايا بطلعة الأسد % 39(@)(@@) % حططت فيه الرحال محتزما % وأنت ثاني المهند الفرد % 40(@)(@@) % تسحب برديك في ملاعبه % % وما اقتفته براثن الأسد % PageV01P461 41(@)(@@) % زادك في كل ما خصصت به % في كل امن ويوم محتشد % % 42(@)(@@) % كل اصم الكعوب معتدل % % خلت أنابيبه من الأود % 43(@)(@@) % و كل طاغي الغرار تلحظه % % من غمده في طرائق قدد % % 44(@)(@@) % ولامة سال فوقها زرد % % كالماء في قطعة من الزبد % 45(@)(@@) % حكمك بالسيف غير منهجم % وأنت بالضرب غير متثد % 46(@)(@@) % لله بيت رفعت عمته % % أغناه سلطانه عن العمد % 47(@)(@@) % خلائق طلقة معبسة % كالصاب يجري بصورة الشهد % 48(@)(@@) % فأنت يوم النوال في حلل % منها ويوم النوال في زرد % % 49(@)(@@) % علامة العز ان حسدت به % % أن المعالي قرائن الحسد % 50(@)(@@) % كم لك من وقفة صقلت بها % % رسائلا دبجت على البرد % % PageV01P462 51(@)(@@) % تنوب عن كنهها معارفها % % وفضل بدر ينوب عن أحد % 52(@)(@@) % ناجاك شعري وكنت اخرسه % % عن الورى قانعا بمقتصدي % % 53(@)(@@) % كان نزاعي اليك يسمح بي % % فالان مذ عدت ضن بي بلدي % % PageV01P463 البحر : طويل 1(@)(@@) % نصافي المعالي ، والزمان معاند % وننهض بالآمال ، والجد قاعد % 2(@)(@@) % تمر بنا الأيام غير رواجع % كما صافحت مر السيول الجلامد % % 3(@)(@@) % وتمكننا من مائها كل مزنة % وتمنعنا فضل السحاب المزاود % % 4(@)(@@) % وما مرضت لي في المطالب همة % % واحداثه في كل يوم عوائد % % 5(@)(@@) % عوائد هم لا يحيين غبطة % % بهن ولا تلقى لهن الوسائد % % 6(@)(@@) % ولله ليل يملأ القلب هوله % % وقد قلقت بالنائمين المراقد % 7(@)(@@) % يقر بعيني ان ارى ارض بابل % % تخوض مغانيها الجياد المذاود % % 8(@)(@@) % وأسحب فيها برد جذلان شامت % اذا شاء غنته الرقاق البوارد % % 9(@)(@@) % سللنا رقاب 
ms134	 العيس من خلل الدجى % % تلاعبها اشطانها والمقاود % % 10(@)(@@) % وقد حف بالبدر النجوم كأنه % هدي تهاداه الاماء الولائد % % PageV01P464 11(@)(@@) % وفي اعين القوم انضمام من الكرى % % وطرفا لسرى بين الأزمة شاهد % 12(@)(@@) % فمضطرب في غرزة مترنح % % وآخر مكبوب على الرحل ساجد % 13(@)(@@) % وغائرة قد وقر النوم لحظها % % تسفه جفنيها الهموم العوائد % % 14(@)(@@) % تقود جيادا ما اتهمن على مدى % % بلى ربما ارتابت بهن الاوابد % % 15(@)(@@) % إذا جال في أشداقها الظمء قلصت % لها الأرض وانقادت اليها الموارد % % 16(@)(@@) % أبحنا لها تقتض من عذر الربى % % فكرت عليها بالعجاج الفدافد % 17(@)(@@) % طرائق بيد يعسل الآل بينها % % كما اضطرب السرحان والليل بارد % % 18(@)(@@) % هجمنا على غول الطريق وبعده % وما ركضت فيه الرياح الصوارد % 19(@)(@@) % أأرسل خيل اللحظ في طلب الهوى % % ومن ظنها أن الخدود طرائد % 20(@)(@@) % ولي شغل في طالب ضل قصده % % أسائل عنه ما يقول المقاصد % PageV01P465 21(@)(@@) % أقول لدهر تاه إذ صيد ليثه : % كذاك يصاد الليث والليث راقد % % 22(@)(@@) % اثلم هذا النصل بالضرب ضارب % % وزعزع هذا الطود بالوطء صاعد % % 23(@)(@@) % تعز فما كل المصائب قادم % % عليك ، ولا كل النوائب عائد % 24(@)(@@) % ينال الفتى من دهره قدر نفسه % % وتأتي على قدر الرجال المكايد % 25(@)(@@) % فدى لك يا مجد المعالي وبأسها % % فعال جبان شجعته الحقائد % % 26(@)(@@) % فما تركت منك الصوارم والقنا % % ولا أخذت منك الحسان الخرائد % 27(@)(@@) % عزلت ولكن ما عزلت عن الندى % % وجودك في جيد العلى لك شاهد % % 28(@)(@@) % بوجهك ماء العز في العزل ذائب % ووجه الذي ولي من الماء جامد % % 29(@)(@@) % فانت ترجي الملك وهو زواله % % بغير جلاد فيه وهو مجالد % % 30(@)(@@) % فلا يفرح الأعداء فالغزل معرض % اذا راح عنه صادر جاء وارد % % PageV01P466 31(@)(@@) % وما كنت إلا السيف يمضي ذبابه % ولا ينصر العلياء من لا يجالد % % 32(@)(@@) % نضي فقصى حق الضرائب في الوغى % % وأثنت عليه حين رد المغامد % 33(@)(@@) % فأعطوا عنان الضر غيرك إذ رأوا % % يمينك تستولي عليها الفوائد % 34(@)(@@) % وما كنت يوما في الزمان بممسك % % عرى المال ان ضجت اليك المواعد % % 35(@)(@@) % ولا كنت ترضى 
ms135	 أن تصح ببلدة % اذا قيل عضو من زمانك فاسد % % 36(@)(@@) % أيا غدوة ساء الحسين صباحها % % وسر العدى فيها الزمان المعاند % % 37(@)(@@) % لحققت عندي ان كل صبيحة % % مجاجة سم والليالي اساود % % 38(@)(@@) % يعرفك الإخوان كل بنفسه % وخير اخ من عرفتك الشدايد % % 39(@)(@@) % وطاغ يعير البغي غرب لسانه % % وليس له عن جانب الدين ذائد % % 40(@)(@@) % شننت عليه الحق حتى رددته % صموتا ، وفي أنيابه القول راقد % PageV01P467 41(@)(@@) % يدل بغير الله عضدا وناصرا % وناصرك الرحمن ، والمجد عاضد % 42(@)(@@) % تعير رب الخير بالي عظامه % الا نزهت تلك العظام البوائد % % 43(@)(@@) % ولكن رأى سب النبي غنيمة % وما حوله إلا مريب وجاحد % 44(@)(@@) % ولو كان بين الفاطميين رفرفت % عليه العوالي والظبي السواعد % % 45(@)(@@) % ألا إن جدب الحلم عندك مخصب % وان لئيم المجد عندك رافد % % 46(@)(@@) % ضجرت من العلياء فاخترت عزلها % % كانك قد افنت نداك المحامد % % 47(@)(@@) % تركت قلوصا بالفلاة ووحشها % % تجاذبه عن نفسه وتراود % % 48(@)(@@) % ستذكرك الارماح وهي قوارب % % وليس لها إلا القلوب موارد % 49(@)(@@) % حوى المجد يا قيس بن عيلان ماجد % وجل ، فما يلقى له فيه حاسد % 50(@)(@@) % فتى يحتوي أرماحكم ، وهو صارم % ويسري جيوشا نحوكم ، وهو واحد % PageV01P468 51(@)(@@) % ويوم عويث والسيوف بوارق % % تظل المنايا والقسي رواعد % % 52(@)(@@) % رددتهم ، والسمر بين ظهورهم % تعقل فيه الموت والموت شارد % % 53(@)(@@) % وقد خلقت فيها عيونا قريحة % ينامون عمر الليل ، وهي سواهد % 54(@)(@@) % أسنة فهر في صدور جيادهم % كان قناها للجياد مقاود % % 55(@)(@@) % هم ذخروا اعمارهم لسيوفه % % فأولى لها والحرب عذراء ناهد % 56(@)(@@) % رأيت فيافي تقتضي هبواته % وترغب أرساغ الجياد القوادد % 57(@)(@@) % مدى يمخض الاشواط حتى يعيدها % % ولا زبدة الا الجواد المجاود % % 58(@)(@@) % لنعم حريم العزم أنت وثغره % اذا رجح الرأي الالد المجالد % % 59(@)(@@) % الست من القوم الذين اذا سطوا % % تبرى من التاج العظيم المعاقد % 60(@)(@@) % سياطهم بيض الظبى وسجونهم % إذا غضبوا دون العلاء الملاحد % PageV01P469 61(@)(@@) % رقاب العدى والعيس فيهم ذليلة % وللبيض ما نيطت عليه القلائد % 62(@)(@@) % يعشش طير الخضب في حجراتهم % وتعقل منهن البيوت الشوارد % % 63(@)(@@) % وما والد مثل 
ms136	 ابن موسى لمولد % % قريب تجافاه الرجال الأباعد % 64(@)(@@) % حمى الحج واحتل المظالم رتبة % % على ان ريعان النقابة زائد % % 65(@)(@@) % فاقبل والدنيا مشوق وشايق % % وأعرض ، والدنيا طريد وطارد % 66(@)(@@) % وساعده ، يوم استقل ركابه % أخوه ، وقال البين : نعم المساعد % 67(@)(@@) % هما صبرا والحق يركب راسه % % عشية زالت بالفروع القواعد % % 68(@)(@@) % تفرد بالعلياء عن أهل بيته % وكل يهاديه إلى المجد والد % 69(@)(@@) % وتختلف الآمال في ثمراتها % % اذا اشرقت بالري والماء واحد % % 70(@)(@@) % ومد على الجوزاء اطناب منزل % % يلوذ بحقويه السها والفراقد % PageV01P470 71(@)(@@) % فقر لنيران البوارق مصطل % % وظمء لاحواض الغمائم وارد % % 72(@)(@@) % احق بلاد الله بالمزن ارضه % % اذا شام اقصى خطره البرق رائد % % 73(@)(@@) % كاني به والعز ينضو همومه % % وقد خضعت تلك الخطوب النواكد % % 74(@)(@@) % اعاد اليه الله ماضي سروره % % ورد الليالي وهي بيض أماجد % 75(@)(@@) % منيت بشوق ينحر الدمع سيفه % اذا حادثته بالصقال المعاهد % % 76(@)(@@) % أآل هذيم هل تقر قلوبكم % وقلب بن عدنان على الدهر واجد % % 77(@)(@@) % إذا جحدوا نعماك لوت رقابهم % لمنك اطواق بها وقلائد % % 78(@)(@@) % ولا زالت الأسياف تسبي حريمهم % وتسبي حريم المال منك القصائد % PageV01P471 البحر : - 1(@)(@@) % انظر إلى الايام كيف تعود % % وإلى المعالي الغر كيف تزيد % 2(@)(@@) % وإلى الزمان نبا ، وعاود عطفه % فارتاح ظمآن واورق عود % % 3(@)(@@) % نعم طلعن على العدو بغيظه % % فتركنه حمر الجنان يميد % % 4(@)(@@) % قد عاود الايام ماء شبابها % % فالعيش غض والليالي غيد % % 5(@)(@@) % اقبال عز كالاسنة مقبل % % يمضي وجد في العلاء جديد % % 6(@)(@@) % وعلى لأبلج من ذؤابة هاشم % % يثني عليه السؤدد المعقود % % 7(@)(@@) % قد فات مطلوبا وادرك طالبا % ومقارعوه على الامور قعود % % 8(@)(@@) % خسأت عيونهم وقد طمحت له % % عدد عراض في العلى وعديد % 9(@)(@@) % ما صال إلا انجاب غي مظلم % واندق من عمد الضلال عمود % % 10(@)(@@) % يأسو ويجرح ، فالجراحة عزمة % تصمى وآسيها الندى والجود % % PageV01P472 11(@)(@@) % سطو وصفح يطرقان عدوه % % أبدا ، ووعد صادق ووعيد % 12(@)(@@) % عن اي باع في العلاء رميتم % % ليثا تقيه مقادر وجدود % 13(@)(@@) % طاشت سهامكم وفارق نزعه % % سهم إلى قلب العدو سديد % % 14(@)(@@) % حسدوك 
ms137	 لما فات سعيك سعيهم % صعدا فما نقع الغليل حسود % % 15(@)(@@) % ورأوا بوايجها تلوح ، وريحها % % تسري ، وعارضها الغزير يجود % 16(@)(@@) % عجل الزمان بها اليك وحطمت % % بين الضلوع ضغائن وحقود % % 17(@)(@@) % قد كنت اخشى ان يقول مخبر % % كادوا وما أعطوا المراد فكيدوا % % 18(@)(@@) % أو ان يقال اقارب نزعت بهم % % ظنن ، فكل بالعقوق بعيد % 19(@)(@@) % سئلوا العواد فجانبوه فعاودوا % % والان اذ ملك الزمان وقيدوا % % 20(@)(@@) % لولا الالية منك الا تنتضي % % عضبا يقوم مقامه التفنيد % PageV01P473 21(@)(@@) % لسننت في الأقوام ، غير ملوم % ما سن يوم ابن الزبير يزيد % 22(@)(@@) % اليوم أصحرت الضغائن ، وانجلت % تلك الموارن والجباه السود % % 23(@)(@@) % وتراجعوا عصبا إليك ، وخلفهم % عنف السباق وللقلوب وئيد % % 24(@)(@@) % فاصفح فسوف ينال صفحك منهم % % ما لا ينال العضب ، وهو حديد % 25(@)(@@) % وحذار من ويل العقاب وقد بدت % % ملء العيون بوارق ورعود % % 26(@)(@@) % وتغنموا عفوا يفيض وفيئة % % تدنو وحلما لا يزال يعود % % 27(@)(@@) % فلسطوة الضرغام اجمل بالفتى % % من ان يرى عال عليه السيد % % 28(@)(@@) % ما السؤدد المطلوب إلا دون ما % % يرمى اليه السؤدد المولود % % 29(@)(@@) % فإذا هما اتفقا تكسرت القنا % % ان غالبا وتضعضع الجلمود % % 30(@)(@@) % وأجل ما ضرب الرجال بحدة ا % % لأعداء مجد طارف وتليد % PageV01P474 31(@)(@@) % الان اطلقت النصول ورشحت % % 32(@)(@@) % وتبلج البيت الحرام طلاقة % مذ قيل ان جماله مردود % % 33(@)(@@) % وعلى المظالم والنقابة همة % يقظى ، وظل أمانة ممدود % 34(@)(@@) % حمدا لانعمك الجسام فلم يزل % % أبدا يزيد لها علي مزيد % 35(@)(@@) % عليتني حتى تحققت العدى % % اني حميم للعلى وعقيد % % 36(@)(@@) % وتركت حسادي على زفراتهم % % عوج الضلوع فواجد وعميد % % 37(@)(@@) % فلاشكرنك ما تجاذب مقولي % % نثر يشق على العدى وقصيد % % 38(@)(@@) % والشكر أنفس ما وجدت ، وإنما % % أمل الفتى أن يقبل الموجود % PageV01P475 البحر : بسيط تام 1(@)(@@) % جري النسيم على ماء العناقيد % % وعللي بالأماني كل معمود % 2(@)(@@) % يا نفحة هزت الأحشاء شائقة % وذكرت نفحات الخرد الغيد % % 3(@)(@@) % يضمها الليل في اثناء غيهبه % % والقطر يلمس أطراف الجلاميد % 4(@)(@@) % كأنها عن طريق المزن طائشة % لحظ تردده أجفان مزؤود % 5(@)(@@) % ليت الأحبة أغرين الرياح بنا 
ms138	 % % وان نأين على شحط وتبعيد % % 6(@)(@@) % وليتهن على يأس اللقاء لنا % % عللن بالوعدسير الضمر القود % 7(@)(@@) % أبيت ، والليل مبثوث حبائله % والوجد يقنص مني كل مجلود % 8(@)(@@) % شوقا إليك ، وإشفاقا عليك ، ولي % % دمعان ما بين محلول ومعقود % 9(@)(@@) % ليس الغريب الذي تنأى الديار به % إن الغريب قريب غير مودود % 10(@)(@@) % يا طائر البان ما غربت عن سكن % % يوما ولا كنت عن مأوى بمطرود % % PageV01P476 11(@)(@@) % وانت في ظل افنان مهدلة % % تحنو عليك بقنوان العناقيد % % 12(@)(@@) % ملأت عشيك طعما غير محتلس % بلا رقيب ، وورد غير تصريد % 13(@)(@@) % تبكي ومالك من الف فجعت به % % ولا لويت ، على بعد ، بموعود % 14(@)(@@) % ظلمت ما انت من همي ولا كمدي % % إن العليل لقلب عاده عيدي % % 15(@)(@@) % انا الذي ان بكى وجدا فحق له % % كم بين باك من البلوى وغريد % % 16(@)(@@) % وخلة جذبت تثني مودتها % % عني ، وأمسكت عنها بالمواعيد % 17(@)(@@) % مني إلى الدهر شكوى غير غافلة % % عن موثق بحبال العجز مصفود % % 18(@)(@@) % يحارب الهم إن مال الرقاد به % حتى تجلى غيابات المراقيد % % 19(@)(@@) % بيني وبين المنى اني اقول لها % % بيني وبينك قطع البيد والبيد % % 20(@)(@@) % وساهمين على الأكوار دأبهم % قرع السياط باعناق المقاحيد % % PageV01P477 21(@)(@@) % عاطيتهم من علالات الكرى نطفا % والسير يرجم جلمودا بجلمود % 22(@)(@@) % وللحداة على آثارنا زجل % % يغزي المطايا بأجواز القراديد % 23(@)(@@) % يقطعون حبى الأيام عن طبع % وتحتبي بالمعالي والمحاميد % 24(@)(@@) % ويهجرون اذا جدت عزائمهم % % دنيا تلاعب بالغر المجاويد % % 25(@)(@@) % ما الفقر عار وإن كشفت عورته % وانما العار مال غير محمود % % 26(@)(@@) % تلقى أكفهم في كل نائبة % ملوية بحبال البأس والجود % % 27(@)(@@) % إن صاح صائحهم يوم الوغى هجموا % % على السوابق بالبيض المذاويد % 28(@)(@@) % وكم عدو مشت فيه رماحهم % فاستنصر الركض من جرداء قيدود % 29(@)(@@) % من كل أبلج إن خبت عزائمه % القت اليه الاماني بالمقاليد % % 30(@)(@@) % إذا تحرق ، أحشاء الفلا ملئت % من رعيه خاطر الريبال والسيد % % PageV01P478 31(@)(@@) % وإن جرى شرقت بالخصل راحته % أخذا وبدد أنفاس المجاهيد % 32(@)(@@) % يابن الحسين وما دعواي كاذبة % اذا نسبتك في الشم المناجيد % % 33 
ms139	(@)(@@) % الطاعنين من الاعداء ما لحقوا % % والخيل تلطم هامات الصياخيد % % 34(@)(@@) % معودون من الايام مرتبة % % لا يستطيل اليها كل صنديد % % 35(@)(@@) % يأبون يلبس الاظلام ربعهم % % ليلا وما عذبوا طرفا بتسهيد % % 36(@)(@@) % ويغضبون اذا عاطيتهم همما % مرفهات ، وهما غير مكدود % 37(@)(@@) % هم الضيوف لأرض غير آهلة % من الانيس وورد غير مورود % % 38(@)(@@) % فانمت ابسطهم باعا اذا بسطوا % % ايديهم لوعيد أو لموعود % % 39(@)(@@) % الان جاءت خيول السعد راكضة % % تجري بيوم مضيء الوجه مجدود % 40(@)(@@) % بمولد صقل الاباء حليته % % فطوق المجد أعناق المواليد % PageV01P479 41(@)(@@) % مولودة نهب الراؤون بهجتها % % لثماوعانقها في ثوب محسود % % 42(@)(@@) % كانت شهابا كسا ظلماءه وضحا % والليل يدخل في أثوابه السود % 43(@)(@@) % جاءت بها ليلة تثنى سوالفها % % في صدر يوم رشيق القد املود % % 44(@)(@@) % لله شمس علي جاءت بجوهرة % % غراء ، عن قمر بالمجد مسعود % 45(@)(@@) % ما عددت منك الا نطفة سلكت % % إلى الاماني طريق الماء في العود % % 46(@)(@@) % نشرت منها خمارا في الفخار طوى % % مع النوائب تيجان الصناديد % % 47(@)(@@) % شريفة رشحت منها مناسبها % % لحلية العز مجرى الليث والجيد % % 48(@)(@@) % ما كنت تقبل بذل الدهر تكرمة % حتى حباك ببذل غير مردود % 49(@)(@@) % أعطاك كنز فخار كان يصرفه % من نسل غيرك في شتى عباديد % % 50(@)(@@) % شجى لنفس شجاع الحرب معترضا % وفرحة لفؤاد العاتق الرود % PageV01P480 51(@)(@@) % فرقت عنك العدى تدمى ضمائرها % % بباع عز على الأيام ممدود % 52(@)(@@) % لا زلت تملك ، والأحداث راغمة % عناق غصن الأماني غير مخضود % 53(@)(@@) % وتستنير لك الأيام ملهية % ينمى بها كل إصباح إلى عيد % 54(@)(@@) % يا مطلق السمع والاسماع ما برحت % % أسيرة في يدي عذل وتفنيد % 55(@)(@@) % ورب رزء من الايام منهجهم % % عزاك منه النهى عن خير مفقود % 56(@)(@@) % ما زلت ترقب إحسان الزمان له % حتى تبدلت مولودا بمولود % PageV01P481 البحر : طويل 1(@)(@@) % عجبت من الايام انجازها وعدي % % وتقريبها ما كان مني على بعد % 2(@)(@@) % وإن الليالي ، مذ لبست رداءها % % تحاذر من حدي فتزري على جدي % % 3(@)(@@) % ولي ان يطل عمري مع الدهر وقفة % % تذلل احداث الزمان لمن بعدي % % 4(@)(@@) % واني لمر 
ms140	 البأس مسترعف الظبى % % واني لحلو الجود مستمطر الرفد % % 5(@)(@@) % إذا بزني مالي عطاء تركته % حميدا ، وطالبت القواضب بالرد % 6(@)(@@) % وقد عجمت مني الليالي مذربا % % تخلل أنياب الأساود والأسد % 7(@)(@@) % اذا خب فيه ملء حيزومه الجوى % % توقر يخفى منه غير الذي يبدي % % 8(@)(@@) % وكنت اذا الايام جلن بساحتي % % رجعن ولم يبلغن اخر ما عندي % % 9(@)(@@) % ولكنها نفس ، كما شئت ، حرة % تصول ولو في ماضغ الاسد الورد % % 10(@)(@@) % واعظم ما القيت شجوا ولوعة % % عتاب اخ فل الزمان به حدى % % PageV01P482 11(@)(@@) % أقيك الردى ما كان ما كان عن قلى % % ولكن هنات كدن يلعبن بالجلد % 12(@)(@@) % ولا تحسبن القلب جازت كلومه % % إلى القلب ، إلا بعدما حز في الجلد % 13(@)(@@) % منحتك ما عندي من الصد معلنا % وعقد ضميري أن أدوم على الود % 14(@)(@@) % ولم اغد محلول اللحاظ طلاقة % % وقلبي معقود الجنان على الحقد % % 15(@)(@@) % سجايا رعين المجد في تلعاته % وناقلن في العلياء غورا إلى نجد % % 16(@)(@@) % وقد كنت ابغي رتبة بعد رتبة % % فآنف لي من أن أفوز بها وحدي % % 17(@)(@@) % حفاظا على القربى الرؤوم ، وغيرة % على الحسب الداني وبقيا على المجد % % 18(@)(@@) % ولم لا ؟ ونحن الراجعان من العلى % % إلى المغرس الريان والسؤدد الرغد % 19(@)(@@) % من القوم أشباه المكارم فيهم % وعرق المعالي الغر والحسب العد % % 20(@)(@@) % حسدت عليك الأجنبين محبة % ونافست فيك الابعدين على الود % % PageV01P483 21(@)(@@) % وقد كان لذع ، فاتقيت شباته % % بقلب على الضراء كالحجر الصلد % 22(@)(@@) % تجلدت حتى لم يجد في مغمزا % % وعدت كما عاد الجراز إلى الغمد % % 23(@)(@@) % وها انا عريان الجنان من التي % % تسوء ومنفوض الضلوع من الوجد % % 24(@)(@@) % وكم سخط أمسى دليلا إلى رضى % % وكم خطأ اضحى طريقا إلى عمد % % 25(@)(@@) % أقلب عينا في الإخاء صحيحة % اذا ارتمت الاعداء بالاعين الرمد % % 26(@)(@@) % واني مذ عاد التودد بيننا % % تجلى الدجى عن ناظري وورى زندي % % 27(@)(@@) % وعاد زماني بعدما غاض حسنه % أنيقا كبرد العصب أو زمن الورد % 28(@)(@@) % وكنت سليب الكف من كل ثروة % % فأصبحت من نيل الأماني على وعد % 29(@)(@@) % وفارقت ضيق الصدر 