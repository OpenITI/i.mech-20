ms481	 محمد بن سليمان الهاشمي عن أبيه عن جده الأكبر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4512 ) قال النبي :(@)(@@) | 30 ( إمسحوا رغام الغنم وطيبوا مراحها وصلوا في جانب مراحها فإنها من دواب الجنة ) )(@)(@@) ( هق ) في المعرفة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4513 ) قال النبي :(@)(@@) | 30 ( إمسحوا على الخفاف ثلاثة أيام ) )(@)(@@) ( طب ) عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4514 ) قال النبي :(@)(@@) | 30 ( إمسحوا على الخفين والخمار ) )(@)(@@) ( حم ) عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4515 ) قال النبي :(@)(@@) | 30 ( أمسك عليك بعض مالك فهو خير لك ) )(@)(@@) ( ق 3 ) عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4516 ) قال النبي :(@)(@@) | 30 ( أمسكوا أنفسكم وأهليكم في البيوت عند فورة العشاء الأولى فإن فيها تعم الجن ) )(@)(@@) ( عبد بن حميد ) عن جابر رضي الله عنه ( ز ) .(@)(@@) PageV02P152(@)(@@)(@@)(@@) $ ( 4517 ) قال النبي :(@)(@@) | 30 ( أمسكوا عليكم أموالكم ولا تفسدوها ، فإنه من أعمر عمرى فهي للذي أعمرها حيا وميتا ولعقبه ) )(@)(@@) ( حم م حب ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4518 ) قال النبي :(@)(@@) | 30 ( أمم ميلا عد مريضا ، إمم ميلين أصلح بين اثنين ، إمم ثلاثة أميال زر أخا في الله ) )(@)(@@) ( ابن أبي الدنيا في كتاب الإخوان ) عن مكحول مرسلا .(@)(@@)(@@)(@@) $ ( 4519 ) قال النبي :(@)(@@) | 30 ( أمشوا أمامي ، خلوا ظهري للملائكة ) )(@)(@@) ( ابن سعد ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4520 ) قال النبي :(@)(@@) | 30 ( أمط الأذى عن الطريق فإنه لك صدقة ) )(@)(@@) ( خد ) عن أبي برزة الأسلمي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4521 ) قال النبي :(@)(@@) | 30 ( أملك عليك لسانك ) )(@)(@@) الباوردي وابن قانع ( طب ) عن الحارث بن هشام عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 4522 ) قال النبي :(@)(@@) | 30 ( أملك عليك لسانك ، وليسعك بيتك ، وابك على خطيئتك ) )(@)(@@) ( ت حسن حل هب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4523 ) قال النبي :(@)(@@) | 30 ( أملكوا العجين فإنه أعظم للبركة ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4524 ) قال النبي :(@)(@@) | 30 ( أملك يدك ) )(@)(@@) ( تخ ) عن أسود بن أصرم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4525 ) قال النبي :(@)(@@) | 30 ( أم القرآن عوض من غيرها وليس غيرها منها عوض ) PageV02P153 )(@)(@@) ( قط ك هق ) عن عبادة رضي 
ms482	 الله عنه .(@)(@@)(@@)(@@) $ ( 4526 ) قال النبي :(@)(@@) | 30 ( أم القرآن هي السبع المثاني والقران العظيم ) )(@)(@@) ( خ هب ) عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4527 ) قال النبي :(@)(@@) | 30 ( أم الولد حرة وإن كان سقطا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4528 ) قال النبي :(@)(@@) | 30 ( أم أيمن أمي بعد أمي ) )(@)(@@) ( ابن عساكر ) عن سليمان بن أبي شيخ معضلا .(@)(@@)(@@)(@@) $ ( 4529 ) قال النبي :(@)(@@) | 30 ( أمتي لغر المحجلون ) )(@)(@@) ( سمويه والضياء ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4530 ) قال النبي :(@)(@@) | 30 ( أمتي أمة مباركة لا يدرى أولها خير أو آخرها ) )(@)(@@) ( ابن عساكر ) عن عمرو بن عثمان مرسلا .(@)(@@)(@@)(@@) $ ( 4531 ) قال النبي :(@)(@@) | 30 ( أمتي أمة مرحومة مغفور لها ، متاب عليها ) )(@)(@@) ( الحكيم في الكنى ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4532 ) قال النبي :(@)(@@) | 30 ( أمتي خمس طبقات ، كل طبقة أربعون سنة ، الطبقة الأولى : أنا ومن معي أهل علم ويقين إلى الأربعين ، والطبقة الثانية : أهل بر وتقوى إلى الثمانين ، والطبقة الثالثة : أهل تواصل وتراحم إلى العشرين ومائة ، والطبقة الرابعة : أهل تقاطع وتظالم إلى الستين ومائة ، والطبقة الخامسة : أهل هرج ومرج إلى المائتين ، حفظ امرؤ نفسه ) )(@)(@@) ( الحسن بن سفيان وابن منده والإسماعيلي في الصحابة وأبو نعيم عن الأشنب بن آدم التميمي عن أبيه قال عبد البر وفي إسناده ضعف وقال أبو نعيم : وفي إسناده نظر ) .(@)(@@)(@@)(@@) $ ( 4533 ) قال النبي :(@)(@@) | 30 ( أمتي على خمس طبقات ، فأربعون سنة أهل بر وتقوى ، ثم الذين يلونهم إلى عشرين ومائة سنة أهل تراحم وتواصل ، ثم الذين PageV02P154 يلونهم إلى ستين ومائة أهل تدابر وتقاطع ، ثم الهرج والهرج ، النجا النجا ) )(@)(@@) ( ه ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4534 ) قال النبي :(@)(@@) | 30 ( أمتي على خمس طبقات ، كل طبقة أربعون عاما ، فأما طبقتي وطبقة أصحابي فأهل علم وأيمان ، وأما الطبقة الثانية ما بين الأربعين إلى الثمانين فأهل بر وتقوى ، ثم ذكر نحوه ) )(@)(@@) ( ه ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4535 ) قال النبي :(@)(@@) | 30 ( أمتي هاذه أمة مرحومة ليس عليها عذاب في الآخرة ، إنما عذابها في الدنيا : الفتن والزلازل والقتل والبلايا ) )(@)(@@) ( د طب ك 
ms483	 هب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4536 ) قال النبي :(@)(@@) | 30 ( أمتي يوم القيامة غر من السجود محجلون من الوضوء ) )(@)(@@) ( ت حسن صحيح غريب ) عن عبد الله بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4537 ) قال النبي :(@)(@@) | 30 ( أم قومك ، فمن أم قوما فليخفف فإن فيهم الكبير ، وإن فيهم المريض ، وإن فيهم الضعيف ، وإن فيهم ذا الحاجة ، فإذا صلى أحدكم وحده فليصل كيف شاء ) )(@)(@@) ( م ) عن عثمان بن أبي العاصي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4538 ) قال النبي :(@)(@@) | 30 ( أمك ثم أمك ثم أمك ثم أباك ثم الأقرب فالأقرب ) )(@)(@@) ( حم د ت ك ) عن معاوية بن حيدة ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4539 ) قال النبي :(@)(@@) | 30 ( أمك وأباك ، وأختك وأخاك ، وأدناك أدناك ) )(@)(@@) ( ع طب ك ) عن صعصعة المجاشعي ( ك ) عن أبي رمثة ( طب ) عن أسامة بن شريك رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 4540 ) قال النبي :(@)(@@) | 30 ( أمك وأباك ، وأختك وأخاك ، ومولاك حقا ورحما موصولة ) )(@)(@@) ( د ) عن بكر بن الحارث الأنماري رضي الله عنه ( ز ) .(@)(@@) PageV02P155(@)(@@)(@@)(@@) $ ( 4541 ) قال النبي :(@)(@@) | 30 ( أم ملدم تأكل اللحم وتشرب الدم ، بردها وحرها من جهنم ) )(@)(@@) ( طب ) عن شبيب بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4542 ) قال النبي :(@)(@@) | 30 ( أمنوا إذا قرىء : غير المغضوب عليهم ولا الضالين ) )(@)(@@) ( ابن شاهين ) في السنة عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4543 ) قال النبي :(@)(@@) | 30 ( أمني جبريل عند البيت مرتين فصلى بي الظهر حين زالت الشمس وكانت قدر الشراك ، وصلى بي العصر حين كان ظله مثله ، وصلى بي المغرب حين أفطر الصائم ، وصلى بي العشاء حين غاب الشفق ، وصلى بي الفجر حين حرم الطعام والشراب على الصائم ، فلما كان الغد صلى بي الظهر حين كان ظله مثله ، وصلى بي العصر حين كان ظله مثليه ، وصلى بي المعرب حين أفطر الصائم ، وصلى بي العشاء إلى ثلثي الليل ، وصلى بي الفجر فأسفر ، ثم التفت إلي وقال : يا محمد هاذا وقت الأنبياء من قبلك ، والوقت ما بين هاذين الوقتين ) )(@)(@@) ( حم د ت ك ) عن ابن عباس رضي الله 
ms484	 عنهما .(@)(@@)(@@)(@@) $ ( 4544 ) قال النبي :(@)(@@) | 30 ( أمناء المسلمين على صلاتهم وسحورهم المؤذنون ) )(@)(@@) ( هق ) عن أبي محذورة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4545 ) قال النبي :(@)(@@) | 30 ( أمنع الصفوف من الشيطان الصف الأول ) )(@)(@@) ( أبو الشيخ في الثواب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4546 ) قال النبي :(@)(@@) | 30 ( أمهلوا حتى ندخل ليلا لكي تمتشط الشعثة ، وتستحد المغيبة ) )(@)(@@) ( ق د ن ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 4547 ) قال النبي :(@)(@@) | 30 ( أميران وليسا بأميرين : المرأة تحج مع القوم فتحيض قبل أن تطوف بالبيت طواف الزيارة فليس لأصحابها أن ينفروا حتى يستأمروها ، والرجل يتبع الجنازة فيصلي عليها فليس له أن يرجع حتى يستأمر أهلها ) )(@)(@@) ( المحاملي في أماليه ) عن جابر رضي الله عنه .(@)(@@) PageV02P156(@)(@@)(@@)(@@) $ ( 4548 ) قال النبي :(@)(@@) | 30 ( أميطي عنا قرامك هاذا فإنه لا تزال تصاويره تعرض لي في صلاتي ) )(@)(@@) ( حم خ ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4549 ) قال النبي :(@)(@@) | 30 ( أمين هاذه الأمة أبو عبيدة بن الجراح ) )(@)(@@) ( حم ) عن خالد بن الوليد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 4550 ) قال النبي :(@)(@@) | 30 ( أمان لأمتي من الاختلاف ، الموالاة لقريش ، قريش أهل الله ، قريش أهل الله ، قريش أهل الله ، فإذا خالفتها قبيلة من العرب صاروا حزب إبليس ) )(@)(@@) ابن جرير عن ابن عباس رضي الله عنهما وفيه إسحاق بن الاركون ضعفوه .(@)(@@)(@@)(@@) $ ( 4551 ) قال النبي :(@)(@@) | 30 ( أما إن ربك يحب المدح ، وفي لفظ الحمد ) )(@)(@@) ( حم خد ) ( ن ) و ابن سعد والصحاوي والباوردي وابن قانع ( طب ك هب ص ) عن الأسود بن سريع رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4552 ) قال النبي :(@)(@@) | 30 ( أما يستحي أحدكم أن يضرب امرأته كما يضرب العبد ، يضربها أول النهار ثم يضاجعها آخره ، أما يستحي ) )(@)(@@) ( عب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4553 ) قال النبي :(@)(@@) | 30 ( أما إني على ما ترون بحمد الله قد قرأت البارحة السبع الطوال ) )(@)(@@) ابن خزيمة ( ع حب ك هب ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4554 ) قال النبي :(@)(@@) | 30 ( أما تخشى أن ترى له بخارا في جهنم ، أنفق يا بلال ولا تخخ من ذي العرش إقلالا 
ms485	 ) )(@)(@@) الحكيم عن ابن مسعود ( هب ) عن أبي هريرة ( طب ) عن ابن مسعود وأبي سعيد الخدري وأبي هريرة ثلاثتهم عن بلال رضي الله عنهم قال : دخل علي رسول الله وعندي صبرة من التمر ، فقال : ما هاذا ؟ PageV02P157 قلت : يا رسول الله دخرته لك ولضيفانك ، قال : فذكره .(@)(@@)(@@)(@@) $ ( 4555 ) قال النبي :(@)(@@) | 30 ( أما علمت يا ع| ائشة أن المؤمن تعيبه النكبة والشوكة فيكافأ بأسوأ عمله ، ومن حوسب عذب قالت : أليس يقول الله فسوف يحاسب حسابا يسيرا ، قال ذالكم العرض : يا عائشة من نوقق الحساب عذب ) )(@)(@@) ( د ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4556 ) قال النبي :(@)(@@) | 30 ( أما ترضون أن تكون للناس هجرة ولكم هجرتان ) )(@)(@@) ابن قانع عن خالد بن سعيد بن عمرو بن العاص عن أبيه عن خالد بن سعيد بن العاص وكان من مهاجرة الحبشة هو وأخوه عمرو بن سعيد فلما قدموا جزعوا أن لا يكونوا شهدوا بدرا ، فقال النبي فذكره .(@)(@@)(@@)(@@) $ ( 4557 ) قال النبي :(@)(@@) | 30 ( أما لكم في أسوة ، إنه ليس في النوم تفريط إنما التفريط على من لم يصل حتى يجيء وقت صلاة أخرى ، فمن فعل ذالك فليصلها حين ينتبه لها فإذا كان الغد فليصلها عند وقتها ) )(@)(@@) ابن سعد والبغوي عن أبي قتادة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4558 ) قال النبي :(@)(@@) | 30 ( أما إنك إن عفوت عنه فإنه يبوء باثمه وإثم صاحبك ) )(@)(@@) ( د ن ) عن وائل بن حجر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4559 ) قال النبي :(@)(@@) | 30 ( أما إنها كائنة ولم يأت تأويلها بعد ) )(@)(@@) ( حم ت ) حسن غريب عن سعد بن أبي وقاص رضي الله عنه قال : لما نزلت قل هو القادر على أن يبعث عليكم عذابا من فوقكم . قال النبي فذكره .(@)(@@)(@@)(@@) $ ( 4560 ) قال النبي :(@)(@@) | 30 ( أما يستطيع أحدكم أن يكسب كل يوم مثل أحد ذهبا ؟ قالوا : ومن يستطيع ذالك يا رسول الله ؟ قال : كلكم يستطيعه ، سبحان الله أعظم من أحد ، ولا إلاه إلا الله أعظم من أحد ، والله أكبر أعظم من أحد ، PageV02P158 والحمد لله أعظم من أحد ) )(@)(@@) ( طب ) و الرافعي وابن النجار عن عمران بن حصين 
ms486	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4561 ) قال النبي :(@)(@@) | 30 ( أما يسرك أن لا تأتي بابا من أبواب الجنة إلا وجدته عنده يسعى يفتح لك ) )(@)(@@) ( حم ن ) و البغوي ( حب طب ك ) عن معاوية بن قرة عن أبيه .(@)(@@)(@@)(@@) $ ( 4562 ) قال النبي :(@)(@@) | 30 ( أما والله إنه لنبي ابن نبي يعني ابنه إبراهيم ) )(@)(@@) ابن عساكر وضعفه عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4563 ) قال النبي :(@)(@@) | 30 ( أما إن الإيمان لا يدخل أجوافهم حتى يحبوكم لي قاله للعباس ) )(@)(@@) ( عد ) و ابن عساكر عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4564 ) قال النبي :(@)(@@) | 30 ( أما علمت أن عم الرجل صنو أبيه ) )(@)(@@) ( حم ) و ابن عساكر عن علي وابن عساكر عن ابن مسعود ( قط ) وابن عساكر عن أبي رافع ابن عساكر عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4565 ) قال النبي :(@)(@@) | 30 ( أما إنه كان هو صانع بك يوم القيامة ، يقول : يا رب سل فيم قتلني ) )(@)(@@) ( ن ) عن بريدة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4566 ) قال النبي :(@)(@@) | 30 ( أما إنه لو سمى لكفاكم ) )(@)(@@) ( ت ) حسن صحيح عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4567 ) قال النبي :(@)(@@) | 30 ( أما إنه لا ينبغي لأحد أن يكون خيرا من يحيى بن زكريا ، أما سمعتم الله تعالى حيث وصفه في القرآن ، وسيدا وحصورا ونبيا من الصالحين لم يعمل بسيئة قط ولم يهم بها ) )(@)(@@) ابن خزيمة وقال : ليس إسناده من شرطنا ( قط ) في الأفراد وقال غريب ( طب ) وابن مردويه عن ابن عباس رضي الله عنهما .(@)(@@) PageV02P159(@)(@@)(@@)(@@) $ ( 4568 ) قال النبي :(@)(@@) | 30 ( أما كان يجد هاذا ما يسكن به رأسه ، أما كان يجد هاذا ما يغسل به ثيابه ) )(@)(@@) ( حم د ع حب ك حل ض ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4569 ) قال النبي :(@)(@@) | 30 ( أما إنه قد صدقك وهو كذوب ، تعلم من تخاطب منذ ثلاث ليال يا أبا هريرة ؟ قال : لا ، قال : ذاك شيطان ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4570 ) قال النبي :(@)(@@) | 30 ( أما إنك لو أعطيتها بعض إخوانك كان أعظم لأجرك ) )(@)(@@) ( خ ) عن ابن عباس رضي الله عنهما أن ميمونة أعتقت وليدة 
ms487	 فقال النبي فذكره ( حم د ك حب ) عن ميمونة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4571 ) قال النبي :(@)(@@) | 30 ( أما ترضين أن تكوني سيدة نساء أهل الجنة قاله لفاطمة ) )(@)(@@) ( خ ه عق ) عن عائشة عن فاطمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4572 ) قال النبي :(@)(@@) | 30 ( أما ترضى أن تكون مني بمنزلة هاارون من موسى ) )(@)(@@) ( طب ) عن مالك بن الحسن بن مالك بن الحويرث رضي الله عنه عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 4573 ) قال النبي :(@)(@@) | 30 ( أما والذي نفس محمد بيده ليبعثن منكم يوم القيامة إلى الجنة مثل الليل الأسود جمعيا تحيطون الأرض تقول الملائكة : لما جاء مع محمد أكثر مما جاء مع الأنبياء ) )(@)(@@) ( طب ) عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4574 ) قال النبي :(@)(@@) | 30 ( أما إني لم أستخلفكم تهمة لكم ولاكنه أتاني جبريل فأخبرني أن الله عز وجل يباهي بكم الملائكة ) )(@)(@@) ( ش حم م ت ن حب ) عن معاوية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4575 ) قال النبي :(@)(@@) | 30 ( أما إنك لو قلت حين أمسيت أعوذ بكلمات الله PageV02P160 التامات كلها من شر ما خلق لم يضرك شيء حتى تصبح ) )(@)(@@) الحكيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4576 ) قال النبي :(@)(@@) | 30 ( أما إنه لو قال حين أمسى : أعوذ بكلمات الله التامات من شر ما خلق ثلاثا لم تضره ) )(@)(@@) ابن السني في عمل يوم وليلة عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4577 ) قال النبي :(@)(@@) | 30 ( أما إنك لو لم تعطه شيئا كتبت عليك كذبة ) )(@)(@@) ( خ د طب هق ض ) عن عبد الله بن عامر بن ربيعة قال : دعتني أمي يوما فقالت : تعال أعطك ، فقال لها رسول الله : وما أردت أن تعطيه ؟ قالت : أعطيه تمرا قال فذكره .(@)(@@)(@@)(@@) $ ( 4578 ) قال النبي :(@)(@@) | 30 ( أما والله إن أحدكم ليخرج بمسألته من عندي يتأبطها وما هي له إلا نار ، قال عمر : لم تعطيها إياهم ؟ قال : ما أصنع ؟ يأبون إلا ذالك ، ويأبى الله لي البخل ) )(@)(@@) ( حم ع ن ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4579 ) قال النبي :(@)(@@) | 30 ( أما والذي نفسي بيده لجعيل بن سراقة 
ms488	 خير من طلاع الأرض كلها مثل عيينة والأقرع ، ولاكن تألفتهما ليسلما ، ووكلت جعيل بن سراقة إلى إسلامه ) )(@)(@@) الحديث ضعيف بالإرسال لاكن له ما يعضده وقد ذكر فيه إنه روى ابن إسحاق في المغازي عن محمد بن إبراهيم التيمي قال : قيل : يا رسول الله أعطيت عيينة بن حصن والأقرع بن حابس وتركت جعيلا قال فذكره . ابن سعد عن شريك بن عبد الله بن أبي نمر مرسلا .(@)(@@)(@@)(@@) $ ( 4580 ) قال النبي :(@)(@@) | 30 ( أما ترضى أن تبلغ ما بلغت ثم يأتي الشام فيقتله منافق من أهل الشام ) )(@)(@@) ابن سعد عن عبد الملك بن عمير أن بشيرا بن سعد جاء بالنعمان بن بشير رضي الله عنهما إلى النبي فقال : يا رسول الله ، أدع لابني هاذا ، قال : فذكره .(@)(@@) PageV02P161(@)(@@)(@@)(@@) $ ( 4581 ) قال النبي :(@)(@@) | 30 ( أما إن الأرض تقبل من هو شر منه ولاكن الله أراد أن يريكم عظم الدم عنده ) )(@)(@@) ( طب ) عن عمران بن حصين ( طب ) عن أبي الزناد بلاغا .(@)(@@)(@@)(@@) $ ( 4582 ) قال النبي :(@)(@@) | 30 ( أما ترضين يا فاطمة أن الله عز وجل اطلع إلى أهل الأرض فاختار منهم رجلين ، فجعل أحدهما أباك والآخر بعلك ) )(@)(@@) ( طب ) وتعقب عن أبي هريرة ( طب ) و ( الحاكم ) وتعقب والخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4583 ) قال النبي :(@)(@@) | 30 ( أما ترضين أني زوجتك أقدم أمتي سلما ، وأكثرهم علما ، وأعظمهم حلما ) )(@)(@@) ( حم طب ) عن معقل بن بسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4584 ) قال النبي :(@)(@@) | 30 ( أما ترضين أني زوجتك أول المسلمين إسلاما ، وأعلمهم علما ، فإنك سيدة نساء أمتي ، كما سادت مريم نساء قومها ) )(@)(@@) ( طب ) عن فاطمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4585 ) قال النبي :(@)(@@) | 30 ( أما علمت أن الدم حرام أكله ) )(@)(@@) قال سالم : حجمت النبي فلما وليت المحجمة منه شربته قال فذكره . ابن مندة عن سالم بن الحجام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4586 ) قال النبي :(@)(@@) | 30 ( أما إنها لا تنفعه ، ولاكنها تكون في عقبه ، إنهم لن يخزوا أبدا ، ولن يذلوا أبدا ، ولن يفتقروا أبدا ) )(@)(@@) البغوي ( طب ص ) عن سل مان بن عامر الضبي رضي الله عنه قال : قلت 
ms489	 : يا رسول الله إن أبي كان يقري الضيف ، ويكرم الجار ، ويفي بالذمة ، ويعطي في النائبة ، فما ينفعه ذالك ؟ قال : مات مشركا ؟ قلت : نعم ، قال : فذكره .(@)(@@)(@@)(@@) $ ( 4587 ) قال النبي :(@)(@@) | 30 ( أما علمت يا عائشة أني قلت لربي فيما بيني وبينه : إنما أنا بشر أغضب ، فأي دعوة دعوت بها على غضب على أحد من أمتي ، أو أحد PageV02P162 من أهل بيتي أو أحد من أزواجي ، فاجعلها عليه بركة ومغفرة ورحمة وطهورا ) )(@)(@@) الشيرازي في الألقاب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4588 ) قال النبي :(@)(@@) | 30 ( أما يخشى الذي يرفع رأسه قبل الإمام ويضعه قبل الإمام أن يبدل الله رأسه رأس حمار ) )(@)(@@) الخطيب عن بهز بن حكيم عن أبيه عن جده رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4589 ) قال النبي :(@)(@@) | 30 ( أما علمت أن الله تعالى حرم من الرضاع ما حرم من النسب ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4590 ) قال النبي :(@)(@@) | 30 ( أما إنك لو لم تأتها لأتتك ) )(@)(@@) ( طب هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4591 ) قال النبي :(@)(@@) | 30 ( أما سمعت بلالا ينادي ثلاثا فما منعك أن تجيء به كنت أنت الذي تجيء به يوم القيامة فلن أقبله منك ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4592 ) قال النبي :(@)(@@) | 30 ( أما إنها لا تزيدك إلا وهنا ، وإنك لو مت وإن ترى أنها تنفعك لمت على غير الفطرة ) )(@)(@@) ( حم طب ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4593 ) قال النبي :(@)(@@) | 30 ( أما أنهما يعذبان وما يعذبان في كبير ، أما أحدهما فكان يغتاب الناس ، وأما الآخر فكان لا يتأذى من بوله أما إنه سيهون عليهما ما كانتا رطبتين ) )(@)(@@) ( خ ) في الأدب و ابن أبي الدنيا في ذم الغيبة عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4594 ) قال النبي :(@)(@@) | 30 ( أما أنتم لن تزالوا في صلاة ما انتظرتموها ، أما إنها صلاة لم يصلها أحد ممن كان قبلكم من الأمم يعني العشاء ) )(@)(@@) ( طب ) عن المنكدر .(@)(@@)(@@)(@@) $ ( 4595 ) قال النبي :(@)(@@) | 30 ( أما إنكم لو قتلتموه لكان أول فتنة وآخرها ) )(@)(@@) ( طب ) PageV02P163 عن أبي بكرة رضي 
ms490	 الله عنه .(@)(@@)(@@)(@@) $ ( 4596 ) قال النبي :(@)(@@) | 30 ( أما إنك لو كنت حججت بها يعني على الجمل الحبيس كان في سبيل الله ، أقرئها مني السلام ورحمة الله ، وأخبرها أنها تعدل حجة معي عمرة في رمضان ) )(@)(@@) ( ك ) عن ابن عباس رصي الله عنهما .(@)(@@)(@@)(@@) $ ( 4597 ) قال النبي :(@)(@@) | 30 ( أما يستطيع أحدكم أن يقرأ ألف آية في كل يوم ؟ قالوا : ومن يستطيع ذالك ؟ قال : أما يستطيع أحدكم أن يقرأ : ألهاكم التكاثر ) )(@)(@@) ( ك هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4598 ) قال النبي :(@)(@@) | 30 ( أما علمت يا عمر أن عم الرجل صنو أبيه ، إنا كنا احتجنا فاستسلفنا العباس صدقة عامين ) )(@)(@@) ( ق ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4599 ) قال النبي :(@)(@@) | 30 ( أما إنه في ضحضاح من نار عليه نعلان تصب منهما أم رأسه يعني أبا طالب ) )(@)(@@) ( هناد ) عن أبي عثمان مرسلا .(@)(@@)(@@)(@@) $ ( 4600 ) قال النبي :(@)(@@) | 30 ( أما إنه سيشهد معك مشاهد أجرها عظيم ، وذكرها كبير ، وثناؤها حسن ) )(@)(@@) ( حل ) عن علي رضي الله عنه قال : ذكرت للنبي عمارا قال : فذكره .(@)(@@)(@@)(@@) $ ( 4601 ) قال النبي :(@)(@@) | 30 ( أما يخشى أن يكون له بخار في النار ، أنفق بلال ولا تخش من ذي العرش إقلالا ) )(@)(@@) الحارث عن بلال رضي الله عنه قال : دخل النبي وعندي صبر من تمر فقال : فما هاذا ؟ فقلت : ادخرته لشتائنا قال فذكره . ( حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4602 ) قال النبي :(@)(@@) | 30 ( أما يخشى أن يخسف الله عز وجل به في نار جهنم ، أنفق يا بلال ولا تخش من ذي العرش إقلالا ) )(@)(@@) الحكيم ( هب ) عن عائشة رضي الله عنها .(@)(@@) PageV02P164(@)(@@)(@@)(@@) $ ( 4603 ) قال النبي :(@)(@@) | 30 ( أما إنه إن كان يسعى على والديه أو أحدهما فهو في سبيل الله ، وإن كان يسعى على نفسه فهو في سبيل الله ) )(@)(@@) ( هق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4604 ) قال النبي :(@)(@@) | 30 ( أما أنت يا جعفر فأشبه خلقك خلقي ، وأشبه خلقي خلقك ، وأنت مني وشجرتي ، وأما أنت يا علي فختني وأبو ولدي وأنا منك وأنت مني ، وأما أنت يا زيد فمولاي ومني وإلي ، وأحب القوم إلي 
ms491	 ) )(@)(@@) ( حم طب ) و البغوي ( ك ض ) عن محمد بن أسامة بن زيد عن أبيه .(@)(@@)(@@)(@@) $ ( 4605 ) قال النبي :(@)(@@) | 30 ( أما لحوم الجزور فكلها ، وأما الخمر فلا تشربها ) )(@)(@@) البغوي وضعفه الإسماعيلي وابن قانع وأبو نعيم عن بشير الثقفي رضي الله عنه قال : قلت : يا رسول الله ، إني نذرت في الجاهلية أن لا آكل لحم الجزور ولا أشرب الخمر ، قال فذكره .(@)(@@)(@@)(@@) $ ( 4606 ) قال النبي :(@)(@@) | 30 ( أما أنا فأتوضا وضوئي للصلاة ثم آخذ ملء كفي ثلاث مرات فأصبه على رأسي ثم أغسل ، وفي لفظ ثم أفيض بعد على سائر جسدي ) )(@)(@@) ( طب ص ) عن جبير بن مطعم قال : ذكرنا عند النبي الغسل من الجنابة فقال : فذكره .(@)(@@)(@@)(@@) $ ( 4607 ) قال النبي :(@)(@@) | 30 ( أما الحسن فقد نحلته حلمي وهيبتي ، وأما الحسين فقد نحلته نجدتي وجودي ) )(@)(@@) ابن عساكر عن محمد بن عبيد الله بن أبي رافع عن أبيه عن جده أن فاطمة رضي الله عنها أتت بابنيها فقالت : يا رسول الله انحلهما ، قال : نعم ، فذكره .(@)(@@)(@@)(@@) $ ( 4608 ) قال النبي :(@)(@@) | 30 ( أما محمد فشبيه عمنا أبي طالب وأما عبد الله فشبيه خلقي وخلقي ) )(@)(@@) ( ط ) ابن سعد ( حم طب ) وأبو نعيم في المعرفة ( ك ) وابن عساكر PageV02P165 عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4609 ) قال النبي :(@)(@@) | 30 ( أما الوقوف عشية عرفة فإن الله يهبط إلى السماء الدنيا فيباهي بكم الملائكة فيقول هاؤلاء عبادي جاؤوني شعثا يرجون رحمتي ، فلو كانت ذنوبكم كعدد الرمل وكعدد القطر أو الشجر لغفرتها لكم ، أفيضوا عبادي مغفورا لكم ولمن شفعتم له ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4610 ) قال النبي :(@)(@@) | 30 ( أما أنا فلا أصلي عليه ) )(@)(@@) ( ن ) عن جابر بن سمرة رضي الله عنه أن رجلا قتل نفسه ، فقال النبي : فذكره .(@)(@@)(@@)(@@) $ ( 4611 ) قال النبي :(@)(@@) | 30 ( أما الميراث فله ، وأما أنت فاحتجبي منه يا سودة فإنه ليس لك بأخ ) )(@)(@@) ( حم ) و الطحاوي ( قط ك طب هق ) عن ابن الزبير رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4612 ) قال النبي :(@)(@@) | 30 ( أما الظاهرة فالإسلام وما حسن من خلقك ، وما أسبغ عليك من 
ms492	 الرزق ، وأما الباطنة يا ابن عباس فما ستر عليك من عيوبك ، إن الله عز وجل يقول : إني جعلت للمؤمن ثلث ماله بعد وفاته أكفر به خطاياه بعد موته ، وجعلت المؤمنين والمؤمنات يستغفرون له ، وسترت عليه عيوبه التي لو علم بها أهله دون عبادي لتبدوه ) )(@)(@@) ابن مردويه ( هب ) والديلمي وابن النجار عن ابن عباس رضي الله عنهما أنه قال : يا رسول الله قول الله : { وأسبغ عليكم نعمه ظاهرة وباطنة } ، قال : فذكره .(@)(@@)(@@)(@@) $ ( 4613 ) قال النبي :(@)(@@) | 30 ( أما الذي أسألكم لربي فتعبدوه ولا تشركوا به شيئا ، وأما الذي أسألكم لنفسي فتمنعوني مما تمنعون به أنفسكم ) )(@)(@@) ( طب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4614 ) قال النبي :(@)(@@) | 30 ( أما الذي أسأل لربي أن تؤمنوا به ولا تشركوا به PageV02P166 شيئا ، وأما الذي أسأل لنفسي فإني أسألكم أن تطيعوني أهدكم سبل الرشاد ، وأسألكم لي ولأصحابي أن تواسونا في ذات أيديكم ، وأن تمنعونا بما منعتم منه أنفسكم فإذا فعلتم ذالك فلكم على الله الجنة وعلي ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4615 ) قال النبي :(@)(@@) | 30 ( أما أنت يا أبا بكر فأخذت بالوثقى ، وأما أنت يا عمر فأخذت بالقوة ) )(@)(@@) ( ط حم ) و عبد بن حميد ( ه ) والطحاوي عن جابر رضي الله عنه قال : قال رسول الله لأبي بكر رضي الله عنه : أي حين توتر ؟ قال : أول الليل بعد العتمة ، قال : فأنت يا عمر ، قال : آخر الليل ، قال فذكره .(@)(@@)(@@)(@@) $ ( 4616 ) قال النبي :(@)(@@) | 30 ( أما هم فقد سعوا أن الملائكة لا تدخل بيتا فيه صورة ، هاذا إبراهيم مصور فما له يستقسم ) )(@)(@@) ( خ ) عن ابن عباس رضي الله عنهما قال : دخل النبي البيت فوجد فيه صورة إبراهيم بيده الأزلام قال : لذكره .(@)(@@)(@@)(@@) $ ( 4617 ) قال النبي :(@)(@@) | 30 ( أما بعد يا ع| ائشة إنه بلغني عنك كذا وكذا ، فإن كنت بريئة فسيبرئك الله ، وإن كنت ألممت بذنب فاستغفري الله وتوبي إليه ، فإن العبد إذا اعترف بذنبه ثم تاب ، تاب الله عليه ) )(@)(@@) ( خ م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4618 ) قال النبي :(@)(@@) | 30 ( أما بعد فإنه 
ms493	 لم يخف علي شأنكم الليلة ، ولاكني خشيت أن تفرض عليكم صلاة الليل فتعجزوا عنها ) )(@)(@@) ( م ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4619 ) قال النبي :(@)(@@) | 30 ( أما أبو جهم فلا يضع عصاه على عاتقه ، وأما معاوية فصعلوك لا مال له ) )(@)(@@) ( حم خ م د ن ) عن فاطمة بنت قيس القرشية الفهرية أخت الضحاك وكانت عند عمرو بن حفص بن المغيرة فطلقها فخطبها معاوية وأبو جهم بن حذيفة فاستشارت النبي قال فذكره .(@)(@@) PageV02P167(@)(@@)(@@)(@@) $ ( 4620 ) قال النبي :(@)(@@) | 30 ( أما أبو جهم فأخاف عليك قسقاسه بالعصا ، وأما معاوية فرجل أخلف من المال ) )(@)(@@) عبد الرزاق عن فاطمة بنت قيس رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4621 ) قال النبي :(@)(@@) | 30 ( أما بعد فإن الله هو حرم مكة ولم يحرمها الناس ، وإنما أحلها لي ساعة من النهار أمس ، وهي اليوم حرام كما حرمها الله عز وجل أول مرة ، وإن أعتى الناس على الله عز وجل ثلاثة : رجل قتل فيها ، ورجل قتل غير قاتله ، ورجل طلب بذحل في الجاهلية ) )(@)(@@) ( حم هق ) عن أبي شريح الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4622 ) قال النبي :(@)(@@) | 30 ( أما أنت يا جعفر فأشبهت خلقي وخلقي ، وأنت من شجرتي التي أنا منها ، وأما الجارية فأقض بها لجعفر تكون مع خالتها فإنما الخالة أم ) )(@)(@@) ( ك ) عن علي رضي الله عنه وروى ( د هق ) آخره .(@)(@@)(@@)(@@) $ ( 4623 ) قال النبي :(@)(@@) | 30 ( أما إذا فعلتما فاقتسما وتوخيا الحق ثم استهما ثم تحالا ) )(@)(@@) ( د ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4624 ) قال النبي :(@)(@@) | 30 ( أما بعد أيها الناس إن الشمس والقمر آيتان من آيات الله لا ينكسفان لموت أحد ولا لحياة أحد ، وإذا رأيتم ذالك فافزعوا إلى المساجد ) )(@)(@@) ( حم ) و ابن سعد عن محمود بن لبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4625 ) قال النبي :(@)(@@) | 30 ( أما ما ذكرت من الغيرة فسوف يذهبها الله عنك ، وأما ما ذكرت من السن فقد أصابني مثل الذي أصابك ، وأما ما ذكرت من العيال فإنما عيالك عيالي ) )(@)(@@) ( حم ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4626 ) قال النبي :(@)(@@) | 30 ( أما السن فأنا أكبر منك 
ms494	 ، وأما الأطفال فهم إلى الله PageV02P168 ورسوله ، وأما الغيرة فأدعو الله فيذهبها عنك ) )(@)(@@) ( حم طب ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4627 ) قال النبي :(@)(@@) | 30 ( أما بعد فأقروا بشهادة أن لا إلاه إلا الله وأني رسول الله ، وأدوا الزكاة ، وخطوا المساجد وإلا غزوتكم ) )(@)(@@) ( طس ) عن أبي شداد .(@)(@@)(@@)(@@) $ ( 4628 ) قال النبي :(@)(@@) | 30 ( أما قولك : تقول قريش ما أسرع ما تخلف عن ابن عمه وخذله ، فإن لك بي أسوة ، قالوا ساحر وكاهن وكذاب ، أما ترضى أن تكون مني بمنزلة هاارون من موسى إلا أنه لا نبي بعدي ، وأما قولك أتعرض لفضل الله هاذه أبهار من فلفل جاءنا من اليمن فبعه واستمتع به أنت وفاطمة حتى يؤتيكم الله من فضله ، فإن المدينة لا تصلح إلا بي أو بك ) )(@)(@@) ( ك ) وتعقب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4629 ) قال النبي :(@)(@@) | 30 ( أما أبوك فلو كان أقر بالتوحيد فصمت وتصدقت عنه نفعه ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4630 ) قال النبي :(@)(@@) | 30 ( أما بعد فإن محمدا يشهد أن لا إلاه إلا الله ، وأنه عبده ورسوله ، ثم إن مالك بن مرارة الرهاوي رضي الله عنه حدثني أنك أسلمت من أول حمير وقتلت المشركين فأبشر بخير وأمل خيرا ) )(@)(@@) ابن سعد عن شهاب بن عبد الله الخولاني أن زرعة ذا مزن أسلم فكتب إليه رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 4631 ) قال النبي :(@)(@@) | 30 ( أما بعد ذالكم فإنه قد وقع بنا رسول لكم مقفلنا من أرض الروم بالمدينة ، فبلغ ما أرسلتم به ، وخبر عما قبلكم ، وأنبأنا بإسلامكم وقتلكم المشركين ، فإن الله قد هداكم بهداه إن أصلحتم وأطعتم الله ورسوله ، وأقمتم الصلاة وآتيتم الزكاة ، وأعطيتم من المغنم خمس الله وسهم النبي صفيه ، وما كتب على المؤمنين من الصدقة ) )(@)(@@) ابن سعد عن شهاب بن عبد الله الخولاني عن رجل من حمير وفد على رسول الله فذكره .(@)(@@) PageV02P169(@)(@@)(@@)(@@) $ ( 4632 ) قال النبي :(@)(@@) | 30 ( أما بعد ، فما بال أقوام إذا غزونا تخلف أحدهم في عيالنا ، نبيب كنبيب التيس ، أما إني علي أن لا أوتي بأحد فعل ذالك إلا 
ms495	 نكلت به ) )(@)(@@) ( ك ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4633 ) قال النبي :(@)(@@) | 30 ( أما الوضوء فإنك إذا توضأت فغسلت كفيك فأنقيتهما خرجت خطاياك من بين أظافرك وأناملك فإذا تمضمضت واستنشقت منخريك وغسلت وجهك ويديك إلى المرفقين ومسحت رأسك ، وغسلت رجليك إلى الكعبين ، اغتسلت من عامة خطاياك ، فإن أنت وضعت وجهك لله عز وجل خرجت من خطاياك كيوم ولدتك أمك ) )(@)(@@) ( ن طب ) عن أبي أمامة عن عمرو بن عبسية رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4634 ) قال النبي :(@)(@@) | 30 ( أما ما يحبك الله عليه فالزهد في الدنيا ، وأما ما يحبك الناس عليه فانبذ إليهم هاذا الغشاء ) )(@)(@@) ( حل ) عن مجاهد مرسلا ( حل ) عن أرطأة بن المنذر مرسلا ( حل ) عن الربيع بن خثيم مرسلا .(@)(@@)(@@)(@@) $ ( 4635 ) قال النبي :(@)(@@) | 30 ( أما أحدهما فكان يعذب بالنميمة ، وأما الآخر فكان لا يتقي البول ، ولن يعذبا ما دامت هاذه رطبة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4636 ) قال النبي :(@)(@@) | 30 ( أما قولك في مقام الناس بين يدي رب العالمين يوم القيامة فألف سنة لا يؤذن لهم ، وأما قولك : ما يشق على المؤمن من ذالك المقام فإن المؤمنين فريقان فأما السابقون فكالرجلين تناجيا فطالت نجواهما ثم انصرفا فادخلا الجنة ، وبين الجنة والنار حوضي ، شرفاته على الجنة ، وتضرب شرفاته على النار ، طوله شهر ، وعرضه شهر ، أشد بياضا من اللبن ، وأحلى من العسل ، فيه أقداح من فضة وقوارير ، من شرب منه كأسا لم يجد عطشا ، ولا غرثا حتى يقضى بين العباد فيدخل الجنة ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنهما .(@)(@@) PageV02P170(@)(@@)(@@)(@@) $ ( 4637 ) قال النبي :(@)(@@) | 30 ( أما بعد ذاكم أيها الناس ارتضخوا من الفضل ، ارتضخ امرؤ بصاع ، ببعض صاع ، بقبضة ، بتمرة ، بشق تمرة ، إن أحدكم لاقى الله فقائل له : ألم أجعلك سميعا بصيرا ؟ ألم أجعل لك مالا وولدا ؟ فماذا قدمت ؟ فينظر بين يديه ومن خلفه وعن يمينه وعن شماله فلا يجد شيئا ، فلا يتقي النار إلا بوجهه ، فاتقوا النار ولو بشق تمرة ، فإن لم تجدوا فبكلمة طيبة ، إني لا أخشى عليكم الفاقة لينصرنكم الله وليعطينكم 
ms496	 ، أو ليسخرن لكم حتى تسير الظعينة بين الحيرة ويثرب ، إن أخوف ما تخاف على ظعينها السرق ) )(@)(@@) ( حم طب ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4638 ) قال النبي :(@)(@@) | 30 ( أما بعد فما بال المسلم يقتل المسلم وهو يقول : إني مسلم ، أبى الله علي فيمن قتل مسلما ) )(@)(@@) ( طب ) عن عقبة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4639 ) قال النبي :(@)(@@) | 30 ( أما بعد فإن أهل الشرك والأوثان كانوا يدفعون من هاذا الموضع إذا كانت الشمس على رؤوس الجبال كأنها عمائم الرجال ، وإنا ندفع بعد أن تغيب ) )(@)(@@) ( طب ك هق ) عن المسور بن مخرمة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4640 ) قال النبي :(@)(@@) | 30 ( أما هاذا الذي جاء فجلس إلينا فإنه تاب فتاب الله عليه ، وأما الذي مضى قليلا فإنه استحيى فاستحيى الله منه ، وأما الذي مضى على وجههه فإنه استغنى فاستغنى الله عنه ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4641 ) قال النبي :(@)(@@) | 30 ( أما بعد في شأن هاذا الرجل يعني مسيلمة فقد أكثرتم في شأنه ، فإنه كذاب من ثلاثين كذابا يخرجون قبل الدجال ، وإنه ليس بلد إلا يدخله رعب المسيح إلا المدينة ، على كل نقب من أنقابها ملكان يذبان عنها PageV02P171 رعب المسيح ) )(@)(@@) ( حم طب ك ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4642 ) قال النبي :(@)(@@) | 30 ( أما بعد أيها الناس فقدموا لأنفسكم تعلمن ، والله ليضعفن أحدكم ثم ليدعن غنمه وليس لها راع ثم ليقولن له ربه ، ليس له ترجمان ولا حاجب يحجبه دونه : ألم يأتك رسول بلغك ، وآتيتك مالا وأفضلت عليك فما قدمت لنفسك ؟ فلينظرن يمينا وشمالا فلا يرى شيئا ، ثم لينظر قدامه فلا يرى غير جهنم ، فمن استطاع أن يتقي وجهه من النار ولو بشق تمرة فليفعل ، ومن لم يجد فبكلمة طيبة ، فإن بها يجزي الحسنة عشر أمثالها إلى سبعمائة ضعف ، والسلام على رسول الله ) )(@)(@@) ( هناد ) عن أبي سلمة بن عبد الرحمان بن عوف رضي الله عنه قال : كانت أول خطبة خطبها رسول الله بالمدينة أنه قام فيهم فحمد الله وأثنى عليه ثم قال : فذكره .(@)(@@)(@@)(@@) $ ( 4643 
ms497	 ) قال النبي :(@)(@@) | 30 ( أما فاصطبر للفاقة وأعد للبلاء تجفافا ، فوالذي بعثني بالحق لهما إلى من يحبني أسرع من هبوط الماء من رأس الجبل إلى أسفله ) )(@)(@@) ( طب ) عن محمد بن إبراهيم بن غنمة الجهني عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 4644 ) قال النبي :(@)(@@) | 30 ( أما فأعني بكثرة السجود ) )(@)(@@) ( حم ) عن رجل خدم النبي ، البعوي عن أبي فراس الأسلمي ربيعة بن كعب خادم النبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4645 ) قال النبي :(@)(@@) | 30 ( أما لا فأدوها عن الصغير والكبير والذكر والأنثى ، والحر والعبد صاعا من تمر أو صاعا من زبيب ، أو صاعا من شعير ، أو صاعا من أقط ) )(@)(@@) ( هق ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4646 ) قال النبي :(@)(@@) | 30 ( أما لا فأحسنوا إليه حتى يأتي أجله ) )(@)(@@) عبد بن حميد عن جابر في الجمل الذي أراد أهله نحره فشكى إلى النبي .(@)(@@)(@@)(@@) $ ( 4647 ) قال النبي :(@)(@@) | 30 ( أم القرآن هي السبع المثاني والقرآن العظيم ) PageV02P172 )(@)(@@) ( خ هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4648 ) قال النبي :(@)(@@) | 30 ( أم قومك ، فمن أم قوما فليخفف فإن فيهم الكبير ، وإن فيهم المريض ، وإن فيهم الضعيف ، وإن فيهم ذا الحاجة ، فإذا صلى أحدكم وحده فليصل كيف شاء ) )(@)(@@) ( ش م ) عن عثمان بن أبي العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4649 ) قال النبي & : ' أمتي غر محجلون ، غر من السجود ، محجلون من آثار الوضوء ' أبو أحمد الحاكم وقال غريب عن عبد الله بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4650 ) قال النبي :(@)(@@) | 30 ( أمتي ثلاثة أثلاث ، فثلث يدخلون الجنة بغير حساب ولا عذاب ، وثلث يحاسبون حسابا يسيرا ثم يدخلون الجنة ، وثلث يمحصون ويكشفون ثم يأتي الملائكة فيقولون وجدناهم يقولون : لا إلاه إلا الله وحده ، ويقول الله : صدقوا لا إلاه إلا أنا ، أدخلوهم الجنة بقول لا إلاه إلا الله وحده ، واحملوا خطاياهم أهل التكذيب ، فهي التي قال الله وليحملن أثقالهم وأثقالا مع أثقالهم ) )(@)(@@) ابن أبي حاتم ( طب ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4651 ) قال النبي :(@)(@@) | 30 ( أمة مسخت ما أدري ما فعلت ولا أدري لعل هاذا منها يعني الضب 
ms498	 ) )(@)(@@) ( حم ) عن حذيفة ( حم م ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4652 ) قال النبي :(@)(@@) | 30 ( أتشكون فيها يا ابن الخطاب ؟ والذي نفسي بيده لقد جئتكم بها بيضاء نقية ، لا تسألوهم عن شيء فيخبروكم بحق فتكذبونه ، وباطل فتصدقونه ، والذي نفسي بيده لو أن موسى كان حيا ما وسعه إلا إن يتبعني ) )(@)(@@) ( حم ) عن جابر أن عمر رضي الله عنهما أتى النبي بكتاب أصابه من بعض أهل الكتاب فغضب وقال : فذكره .(@)(@@)(@@)(@@) $ ( 4653 ) قال النبي :(@)(@@) | 30 ( امرؤ القيس بن حجر قائد الشعراء يوم القيامة إلى النار ) )(@)(@@) ( عد ) و ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4654 ) قال النبي :(@)(@@) | 30 ( امرؤ القيس سائق الشعراء إلى النار ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4655 ) قال النبي :(@)(@@) | 30 ( امرؤ القيس بن حجر قائد الشعراء إلى النار يوم القيامة ، وهو رجل مذكور في الدنيا منسي في الآخرة ) )(@)(@@) ( كر ) عن فروة بن سعيد بن عفيف بن معدي كرب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 4656 ) قال النبي :(@)(@@) | 30 ( أمران أتخوفهما على أمتي : الشرك بالله والشهوة الخفية ، أما إنهم لا يعبدون شمسا ولا قمرا ولا حجرا ولا وثنا ، ولاكنهم يراؤون بأعمالهم ، قيل : وما الشهوة الخفية ، قال : يصبح العبد صائما فتعرض له شهوة من شهواته فيواقعها ويدع صومه ) )(@)(@@) ( حم ) و الحكيم ( طب ك هب ) عن شداد بن أوس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4657 ) قال النبي :(@)(@@) | 30 ( أمر الله عز وجل بعبد إلى النار فلما وقف على شفاها التفت فقال : أما والله يا رب إنه كان ظني بك لحسن ، فقال الله عز وجل : ردوه فأنا عند حسن ظن عبدي بي ، فغفر له ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4658 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله وأن محمدا رسول الله ، وأن يستقبلوا قبلتنا ، ويأكلوا ذبيحتنا ، ويصلوا صلاتنا ، فإذا فعلوا ذالك فقد حرمت علينا دماؤهم وأموالهم إلا بحقها ، لهم ما للمسلمين وعليهم ما على المسلمين ) )(@)(@@) ( حم خ د ت ) حسن صحيح غريب ( ن حب قط هق 
ms499	 ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4659 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يقولوا : لا إلاه إلا الله ، فإذا قالوها عصموا مني دماءهم وأموالهم إلا بحقها ، قيل : وما حقها ؟ قال : زنا بعد إحصان ، أو كفر بعد إسلام ، أو قتل نفس فيقتل بها ) )(@)(@@) ابن جرير ( طس ) عن أنس رضي الله عنه وحسن .(@)(@@)(@@)(@@) $ ( 4660 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله PageV02P174 وأني رسول الله ، ويقيموا الصلاة ، ويؤتوا الزكاة ) )(@)(@@) ( ه ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4661 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يقيموا الصلاة ، ويشهدوا أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، فإذا فعلوا ذالك فقد اعتصموا وعصموا دماءهم وأموالهم إلا بحقها وحسابهم على الله عز وجل ) )(@)(@@) تمام عن معاذ بن جبل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4662 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله وأني رسول الله ، ويقيموا الصلاة ويؤتوا الزكاة ) )(@)(@@) ( ك ) عن أنس عن أبي بكر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4663 ) قال النبي :(@)(@@) | 30 ( أمرت أن أقاتل الناس حتى يقولوا : لا إلاه إلا الله فإذا قالوهااعصموا مني دماءهم وأموالهم إلا من أمر بحق ) )(@)(@@) البغوي عن رجل من بلقين .(@)(@@)(@@)(@@) $ ( 4664 ) قال النبي :(@)(@@) | 30 ( أمرت أن أسجد على سبعة أعضاء ، ولا أكف شعرا ولا ثوبا ) )(@)(@@) الخطيب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4665 ) قال النبي :(@)(@@) | 30 ( أمرت بيوم الأضحى عيدا جعله الله لهاذه الأمة ، قيل : أرأيت إن لم أجد إلا منيحة أنثى فاضحي بها ؟ قال : لا ، ولكن تأخذ من شعرك ، وتقلم أظفارك وتقص شاربك ، وتحلق عانتك فذالك تمام ضحيتك عند الله عز وجل ) )(@)(@@) ( حم د ن حب ك هق ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4666 ) قال النبي :(@)(@@) | 30 ( أمرت أن أبشر خديجة ببيت في الجنة من قصب ) )(@)(@@) الخطيب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4667 ) قال النبي :(@)(@@) | 30 ( أمرنا أن نكلم الناس على قدر عقولهم ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4668 ) قال 
ms500	 النبي :(@)(@@) | 30 ( امسحه بيمينك وقل باسم الله أعوذ بعزة الله وقدرته PageV02P175 من شر ما أجد سبع مرات ) )(@)(@@) ( د ت ) صحيح ( طب ) عن عثمان بن أبي العاصي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4669 ) قال النبي :(@)(@@) | 30 ( امسحوا على الخفين والموق ) )(@)(@@) ( طب ) و البغوي عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4670 ) قال النبي :(@)(@@) | 30 ( امسحوا على الخمر والموق ) )(@)(@@) ( طب ) عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4671 ) قال النبي :(@)(@@) | 30 ( امسحوا على النصيف والموق ) )(@)(@@) ( ض ) عن بلال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4672 ) قال النبي :(@)(@@) | 30 ( أمسك عليك زوجك واتق الله ) )(@)(@@) ( حم خ ت حب ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4673 ) قال النبي :(@)(@@) | 30 ( أمسك بنصالها ) )(@)(@@) ( حم ) و الدارمي ( خ م ن ه ) وابن خزيمة ( حب ) عن جابر قال : مر رجل في المسجد معه سهام فقال له النبي فذكره .(@)(@@)(@@)(@@) $ ( 4674 ) قال النبي :(@)(@@) | 30 ( أمسك عليك أربعا وفارق سائرهن ) )(@)(@@) ( حب ) عن ابن عمر رضي الله عنهما قال : أسلم غيلان الثقفي وعنده عشر نسوة ، فقال رسول الله فذكره .(@)(@@)(@@)(@@) $ ( 4675 ) قال النبي :(@)(@@) | 30 ( أمسكوا عليكم أموالكم ولا تعطوها أحدا ، فمن أعمر شيئا فهو له ) )(@)(@@) ( عب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4676 ) قال النبي :(@)(@@) | 30 ( أمك ثم أمك ثم أمك ثم أباك ، ثم الأقرب PageV02P176 فالأقرب ) )(@)(@@) ( حم دت ) حسن ( طب ك هق ) عن بهز بن حكيم عن أبيه عن جده ( حم ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 4677 ) قال النبي :(@)(@@) | 30 ( امكثي قدر ما كانت تحبسك حيضتك ثم اغتسلي وصلي ) )(@)(@@) ( م د ن ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 4678 ) قال النبي :(@)(@@) | 30 ( امكثي في بيتك حتى يبلغ الكتاب أجله ) )(@)(@@) ( ت ) حسن صحيح ( ن ه ك ) عن الفريعة بنت مالك أخت أبي سعيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 4679 ) قال النبي :(@)(@@) | 30 ( امكثي في بيتك الذي أتاك فيه نعي زوجك حتى يبلغ الكتاب أجله ، أربعة أشهر وعشرا ) )(@)(@@) ( حم طب ك ) عن الفريعة بنت مالك رضي الله عنها .(@)(@@)(@@)(@@) ||| ( الهمزة مع النون(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 4680 ) قال النبي :(@)(@@) | 30 ( إن أبيتم إلا أن تجلسوا فاهدوا السبيل 