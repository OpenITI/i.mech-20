ms961	 الغذاء والإرقال % 684(@)(@@) % بلكلا الشاكيين نزل منها % % نزلا طيبا من الأنزال % % 685(@)(@@) % شد من متنها هوى بعضها بعضا % وقد هم خصرها بانخزال % 686(@)(@@) % كاد لولاه أن يلين قضيب % من كثيب على شفير انهيال % 687(@)(@@) % بل حمى جسمها وقد أسلمته % رقة سابرية لانحلال % 688(@)(@@) % مستعار رنوها من مهاة % مستعار عطوها من غزال % % 689(@)(@@) % بل هي المستعار ذلك منها % % للمها والظباء غير انتحال % 690(@)(@@) % ظبية إن عطت جنت ثمرات % من قلوب ولم تنش غصن ضال % PageV01P3762 691(@)(@@) % ذات جيد عطوله أحسن الحل % % ي عليه وليس بالمعطال % 692(@)(@@) % روضة الليل عاطر النشر فيه % % حين تعتل نكهة المنفال % % 693(@)(@@) % أيما منظر تزودت منه % % يوم ردت جمالها لاحتمال % % 694(@)(@@) % ذاك يوم رأيتها فيه مليء % للعين من بهجة وحسن دلال % 695(@)(@@) % لبست حلة الشباب وظلت % تتهادى في غصنه الميال % 696(@)(@@) % صبغة أرجوانية في صفاء % وقوام مهفهف في اعتدال % 697(@)(@@) % وزهاها سواد فرع بهيم % فهي سكرى لذاك سكر اختيال % 698(@)(@@) % لتزد في اختيالها ولعمري % % إنها في مزية المختال % 699(@)(@@) % أقبلت في القبول تمشي الهوينا % % وهي حسنا كالحظ في الإقبال % 700(@)(@@) % قد تجلت على محاسن ليست % عند فقد الحلي والإعطال % PageV01P3763 701(@)(@@) % ظاهرت شكة عليها بأخرى % % لامرىء غير مؤذن بقتال % 702(@)(@@) % ويح أعدائها أذلك منها % % فرط حشد لحاسر معزال % 703(@)(@@) % لاتظاهر سلاحها لمحب % فكفاه بسهمها القتال % 704(@)(@@) % أيها العائبي بخفة لحمي % % بجلى منه كسوة الأوصال % 705(@)(@@) % وهنيئا لك الفضول من اللح % % م ففاخر بها ذوات الحجال % 706(@)(@@) % قل ما توجد الفضائل إلا % % في خفاف الرجال دون الثقال % 707(@)(@@) % ينظم الدر في السلوك وتأبى % % عزة الدر نظمه في الحبال % 708(@)(@@) % كم غليظ من الرجال ثقيل % ناقص الوزن شائل المثال % 709(@)(@@) % من أناس أوتوا حلوم العصافي % % ر فلم تغنهم جسوم البغال % 710(@)(@@) % وقضيف من الرجال خفيف % راجح الوزن عند وزن الرجال % % PageV01P3764 711(@)(@@) % مكن أناس ذوي جسوم شخات % قد أمرت على نفوس نبال % 712(@)(@@) % حظهم وافر من الروح روح ال % % له لاوافر من الصلصال % % 713(@)(@@) % لم يخالطهم من الحمأ المس % % نون إلا طيف 
ms962	 كطيف الخيال % 714(@)(@@) % من كهول جحاجح تعرف الحن % % كة فيهم وفتية أزوال % 715(@)(@@) % خلقوا للخطوب يمضون فيها % % فهم مرهفون مثل النصال % 716(@)(@@) % يتلظون حدة وذكاء % كتلظي ثوائر الأصلال % 717(@)(@@) % يستشفون رقة وصفاء % عن رقيق من الطباع زلال % 718(@)(@@) % مثل ما تستشف آنية البل % لور عن ماء مزنة سلسال % % 719(@)(@@) % بين تلك الثياب أرواح نور % علقت منهم بأشبال آل % 720(@)(@@) % جثث لطفت على قدر الأر % % واح إن الآلات كالعمال % PageV01P3765 721(@)(@@) % لم تكن آلة ليخلقها الخا % % لق إلا شبيهة المؤتال % 722(@)(@@) % هم مفاتيح كل قفل عسير % وأطباء كل داء عضال % 723(@)(@@) % هم مصابيح كل ليل بهيم % وأدلاء كل أمر ضلال % 724(@)(@@) % فليعب عائب سواهم وإلا % % فليلاطم أسنة في عوال % 725(@)(@@) % ما يعيب العماة لولا عماهم % % من مصابيح أذكيت في ذبال % 726(@)(@@) % لو رأى الله أن في البدن فضلا % ما زوى الفضل عن علي المعالي % % 727(@)(@@) % ما زوى الله عن علي بن يحيى % % وزواه عني فلست أبالي % % 728(@)(@@) % من فتى أسمن المكارم حتى % % هزلته وحبذا من هزال % 729(@)(@@) % لم يثقل ولم يشذب وإن كا % % نت له هيبة الطوال البجال % % 730(@)(@@) % طاله بالعظام قوم فأضحى % % بمساعيه وهو فوق الطوال % PageV01P3766 731(@)(@@) % فليطلهم بالصالحات البواقي % % وليطولوه بالعظام البوالي % % 732(@)(@@) % ماجد سائر الندى في فياف % مقفرات منأهله أفلال % 733(@)(@@) % سالكا فجه بغير صحاب % وهو ما شئت من مهيب مهال % % 734(@)(@@) % يا لقوم لأنسه وهداه % بين تلك المهامه الأغفال % 735(@)(@@) % أآنسته من مجده مؤنسات % أوحشته بقلة الأشكال % % 736(@)(@@) % وهداه من وجهه ضوء بدر % نوره الدهر غير ذي اضمحلال % 737(@)(@@) % من رجال توقلوا في المعالي % % بالمساعي توقل الأوعال % 738(@)(@@) % بل ترقى إلى العلا طالبوها % % وتدلى إلى العلا من معال % 739(@)(@@) % منحته فضوله كل فضل % حل بين النبيل والتنبال % 740(@)(@@) % بل أبى بذله الفضول تعد % من ظلوم كرائم الأموال % PageV01P3767 741(@)(@@) % يفضل المفضلون إلا ابن يحيى % % فهو عال عن خطة الإفضال % 742(@)(@@) % غير راض لسائليه بقصد % عند إثرائه ولا إقلال % 743(@)(@@) % فإذا ماله تعذر وصى % % جاهه بعده على السؤال % 744(@)(@@) % فتراه 
ms963	 لهم رشاء وطورا % جمة يستقونها بالعقال % % 745(@)(@@) % كل من يبن لا يبن من النا % % س عيال عليه أو كالعيال % 746(@)(@@) % ما يقاسي العفاة من عض دهر % ما يقاسى فيهم من العذال % 747(@)(@@) % بل هو المرء يحجم العذل عنه % % لا لخوف الخنا بل الإجلال % 748(@)(@@) % يتبارى إليه وفدان شتى % % وفد شكر يحث وفد سؤال % 749(@)(@@) % بل عطاياه لاتزال تباري % % وافدات إلى ذوي الآمال % % 750(@)(@@) % موغلات في كل فج من الأر % % ض تفوت الرياح في الأيقال % % PageV01P3768 751(@)(@@) % بالغات إلى المقصر عنها % % نائلات بعيد كل منال % 752(@)(@@) % يرقد الطالبون وهي إليهم % % أرقات الوجيف والإرقال % 753(@)(@@) % رحلت نحو من تثاقل عنها % % وكفته مؤونة الترحال % 754(@)(@@) % لاتزل عنه نعمة لو أزيلت % لم تجد عنه وجهة للزوال % 755(@)(@@) % فلئن كان للرعية غيثا % أصبحت في حياه كالأهمال % 756(@)(@@) % إنه للجموح يجمح في الغي % ي لنكل من أعظم الأنكال % 757(@)(@@) % في يد الله والخليفة منه % % سيف كيد على ذوي الإخلال % 758(@)(@@) % هو أجلى عن الخليفة لما % % سلت السيف فتنة الجهال % 759(@)(@@) % رد بالأمس عرقها في ثراها % % نابتا بعد أيما استئصال % 760(@)(@@) % أسندت ركنها إليه فأرسى % % ولقد كان زال كل مزال % PageV01P3769 761(@)(@@) % آلها أولها وحق لأمر % آله أن يؤول خير مآل % 762(@)(@@) % لم يكن للصفاح لولا علي % شوكة في العدى ولا للإلال % 763(@)(@@) % كيده كاد حد كل سنان % وشبا كل مرهف فصال % % 764(@)(@@) % كان مثل الرحا هناك وكانت % عدد الحرب كلها كالثفال % 765(@)(@@) % أيها السائلي بجمع ابن ليث % % لج ذاك النعام في الإجفال % 766(@)(@@) % قفلوا خاسرين بل أقفل القو % م وهم كارهون للإقفال % 767(@)(@@) % بل عدت جلهم عوادي المنايا % % عن نوى المقفلين والقفال % 768(@)(@@) % فجلتهم مثقفات ظماء % تتقيها النحور بالإرغال % 769(@)(@@) % ظل مرانهن أشطان موت % % لدلاهن في الصدور تدال % 770(@)(@@) % وفلتهم مهندات حداد % تحسن الفلي عن سواء المفالي % % PageV01P3770 771(@)(@@) % فثوى هامهم بمثوى هوان % ليس فيه سوى الرياح فوالي % % 772(@)(@@) % قد أذيلت لهم لحى كالجوا % % ليق تليها عنافق كالمخالي % % 773(@)(@@) % ونجا فلهم على فل خيل % كن أقبلن كالقطا الأرسال % % 774 
ms964	(@)(@@) % بعدما قدروا لهن مروجا % من سيوح مريعة ودوالي % % 775(@)(@@) % بين بغداد والحديثة يخصم % ن بها الريف آمنات الرعال % 776(@)(@@) % أمل القوم ثوبة البدن فيهن % ن فأعجلن ثوبة الأبوال % 777(@)(@@) % صادفوا دون ذاك شوك القنا ال % % لدن وودوا لو كان شوك السيال % 778(@)(@@) % أسرعت فيهم مكائد كانت % % قبل دبت لهم دبيب النمال % 779(@)(@@) % بث منها الحكيم فيهم سهاما % وقعت في مواضع الآجال % 780(@)(@@) % يا ابن يحيى حلفت لو غبت عنها % % أعضل الداء أيما إعضال % PageV01P3771 781(@)(@@) % بهداك اهتدت حيارى المنايا % % يوم ضلت مقاتل الأقيال % 782(@)(@@) % ظاهر الأولياء منك ظهيرا % ناصح الجيب غير ذي إدغال % 783(@)(@@) % يوم جاء الصفار تكنفه الكف % فار حمر العيون صهب السبال % 784(@)(@@) % بخميس له لجيب صهيل % راغ في عرضه رغاء الجمال % 785(@)(@@) % فيه مستلئمون كالجلة الجر % ب طلاهن بالعبيبة طال % 786(@)(@@) % غير أن احتكاكهن من العر % ر بحد اللقاء لا الأجذال % 787(@)(@@) % أقبلوا مقبلا تمخض منه % % حاملا كالنساء بالأحمال % 788(@)(@@) % فوق شقر من الحرائر جرد % % لاحقات البطون بالآطال % 789(@)(@@) % مسرجات مجللات تجافي % % ف حديد مواضع الأجلال % 790(@)(@@) % ملبسات من التهاويل زيا % يستفز القلوب قبل التبال % % PageV01P3772 791(@)(@@) % راعت الناس يوم ذلك حتى % % قال قوم أخيلهم أم سعالي % % 792(@)(@@) % وأبى قلبك المشيع إلا % % جرأة الليث مثلك الرئبال % 793(@)(@@) % فتفاءلت إذ بدت في شعور % كشعور المعيز أصدق فال % 794(@)(@@) % قلت شاء مجنبات لأسد % عودت جرها إلى الأشبال % 795(@)(@@) % والموالي بمسمع من ولي % جاهد النصر ليس بالخذال % % 796(@)(@@) % واستثاروا عجاجة الكر قدما % مشرعي كل ذابل عسال % % 797(@)(@@) % من رماح إذا عسلن تضمن % ن قرا كل عاسل بسال % % 798(@)(@@) % قد مشت فيهم حميا حفاظ % كحميا سلافة الجريال % % 799(@)(@@) % بعدما سهلت لهم سبل ال % % كر بتدبير ناقض فتال % % 800(@)(@@) % راض بالرأي مصعب الخطب حتى % % عاد مثل الطليح في التذلال % % PageV01P3773 801(@)(@@) % وجرت عند كرهم ريح نصر % تحت عثنون ذلك القسطال % % 802(@)(@@) % بابتهال امرىء تقي ذكي لي % % له قبل ذاك ليل ابتهال % 803(@)(@@) % فإذا الكلب عن حماهم طريد % قد كفاه الطراد دون النزال % 804(@)(@@) % صد عنهم 
ms965	 وكان صبا إليهم % % حين لاقاهم صدود مقالي % % 805(@)(@@) % وتلته على الوحى واثقات % من صبيب الدماء بالأنعال % 806(@)(@@) % غير مرتاعة لفور نجيع % من صريع ولا لصوت انجدال % 807(@)(@@) % فوقها طالبون كانوا قديما % يطلبون الإدبار بالإقبال % 808(@)(@@) % يتقاضون في الغلول نضالا % من ديون السلاح بعد نضال % 809(@)(@@) % لهم في الظهور سبح طويل % بعد طعن الكلى وضرب القلال % 810(@)(@@) % لم يخيموا عن النزال ولكن % % نزل النصر قبل دعوى نزال % % PageV01P3774 811(@)(@@) % شمروا في الوغى وذلل يعقو % % ب وألوى التشمير بالأسبال % 812(@)(@@) % والموالي مشمرون وكم % % ذيل حباه التشمير بالأسبال % % 813(@)(@@) % ذلل الحيل حين شمرت لل % % حرب فما زادها سوى الأثقال % 814(@)(@@) % ولعمر القنا الذي استدبرته % % لو تمتعن منه باستقبال % 815(@)(@@) % ضل يعقوب إذ يعد التهاوي % % ل لمن لا يهال بالأهوال % 816(@)(@@) % لزمته زجاجها لعيون % ليس فيها كوالىء بل كوالي % % 817(@)(@@) % لا رأت يومك الفظيع الموالي % % فالموالي لما صنعت موالي % % 818(@)(@@) % كدت أعداءهم بكيد عظيم % % ذب للقوم في شخاص ضئال % 819(@)(@@) % فاجتلى هامهم بسيف دهاء % لم يزل قاطعا بغير استلال % 820(@)(@@) % وبك استيقظوا وقد زاول الغا % % در قبل القتال باب الختال % PageV01P3775 821(@)(@@) % قلت إذ سطر الأساطير مهلا % رمت من لا يزل لاسترسال % 822(@)(@@) % أرسلوا نحوه السهام جوابا % لرسالاته وللإرسال % 823(@)(@@) % عظمت غفلة امرىء مبتداه % % رام من ذراك باستغفال % 824(@)(@@) % جادلت ترهاتهم فاستنز % % لتها إلى النار أيما إزلال % % 825(@)(@@) % حكمة منك ربما جعل السي % % ف لسانا لها غداة الجدال % 826(@)(@@) % بعدما قلت لاسم كيدك زرهم % % مجلبا في عساكر الأرجال % 827(@)(@@) % فمضى بادئا ومعناه خا % % ف غير رعب يصول كل مصال % 828(@)(@@) % ظل لما أطل تنفل عنه % % عزمات الطغاة كل انفلال % 829(@)(@@) % وقديما ذكرت فاشتمل المجر % % على الرعب منك كل اشتمال % 830(@)(@@) % وغدا ربه يرى كل شيء % كائدا شديد المحال % PageV01P3776 831(@)(@@) % وجلا قلبه بلا أخذ حذر % غير مافي حشاه من قلقال % 832(@)(@@) % لو تدلى إليه حبل من الله % % رآه حبلا من الأحبال % 833(@)(@@) % واسم كيد المجرب الكيد كي % د ظاهر قبل بطان ختال % % 834(@)(@@) % ليس ينفك صائلا في 
ms966	 صدور % صولة بالقلوب قبل الصيال % 835(@)(@@) % ما عجبنا من انفلال ابن ليث % عن حسام لمثله فلال % % 836(@)(@@) % حول يغرق المداهون منه % % في غمار يرونها كالضحال % 837(@)(@@) % بل لإقدامه مع الرعب لكن % % ساقه الحين راكب استبسال % % 838(@)(@@) % مستطار الفؤاد مشعر خوف % لا طمأنينة ولا استرسال % 839(@)(@@) % ثكلت أم من تعادي وما كن % % ت تعادي إلا بني مثكال % 840(@)(@@) % لك إطراقة إذا ناب خطب % هي أدهى من سورة الأبطال % PageV01P3777 841(@)(@@) % يستثير المكائد الصمع منها % % أي صل هناك في العرزال % % 842(@)(@@) % وقى الله ابن يحيى عن الأم % مة شرا قد هم باستفحال % 843(@)(@@) % فتنة كان أهلها قد تعدوا % % قدح نيرانها إلى الإشعال % 844(@)(@@) % أطفأتها دماؤهم بل سيوف % أبهلتهن أيما إبهال % 845(@)(@@) % وامرؤ مصلح إذا عاين القو % م أرادوا الأديم بالإنغال % % 846(@)(@@) % جرد الرأي والعزيمة والجد % د وولى الوكال أهل الوكال % % 847(@)(@@) % ومضى كالقضاء يأذن في سف % ك دماء العدا لأسد بسال % 848(@)(@@) % وكذاك القضاء يأذن في القت % % ل وفيه عن القتال تعالي % % 849(@)(@@) % قائل المدح في علي بن يحيى % % غير مستكره ولامحتال % 850(@)(@@) % بل إذا قاله أتته المعاني % % والقوافي تنثال أي انثيال % % PageV01P3778 851(@)(@@) % لاتطالبه بالثواب فما رد % د ثواب من مثله بحلال % % 852(@)(@@) % لن يحل الثواب إلا إذا ما % % كان في المدح موضع لاعتمال % 853(@)(@@) % فاطو كشحا عن الثواب لديه % % والتمس نيل ماجد منه نال % 854(@)(@@) % بذل المال للرعية والنف % % س لراعيه ديدني بذال % 855(@)(@@) % للندى والردى مواطن كره % لايطاليه حرهن مصال % 856(@)(@@) % ملك أورثته ساسان اليونا % % ن من والد وعم وخال % 857(@)(@@) % بيت نار وبيت نور من الحك % % مة طالا شواهق الأجبال % 858(@)(@@) % لست أنفك قائما يا بن يحيى % % فيك بالمدح غير ذي إخلال % 859(@)(@@) % وإلى الله بعد هذا تشكي % % حاجتي منك خلة الإغفال % 860(@)(@@) % أصبحت حاجتي إليك ترجى % % في عقال أمر من عقال % PageV01P3779 861(@)(@@) % وأراني إليك دون أناس % لاتداني بحورهم أوشالي % % 862(@)(@@) % ولهذا ومثله غير شك % كان بين القوابل استهلالي % % 863(@)(@@) % ما بكاء الوليد إلا لأمر % حق من مثله مشيب القذال 
ms967	 % % 864(@)(@@) % أتراه بكى من الروح والرح % % ب على غمة وضيق مجال % 865(@)(@@) % لا ولكن جلى هناك عليه % % ما سيلقى من العجائب جالي % % 866(@)(@@) % أبصرت نفسه الذي هو لاق % فرأت منه منظرا لأهوال % 867(@)(@@) % من خطوب تغشى به كل حده % % وصروف ترمي به كل جال % % 868(@)(@@) % فبكى معولا لذلك ومحقو % % ق بطول البكاء والإعوال % 869(@)(@@) % أوليست أعجوبة أن أراني % % وحكيم يعدني في الرذال % 870(@)(@@) % أصبح الشعر باليمين لديه % غير شعري فإنه بالشمال % PageV01P3780 871(@)(@@) % ليت شعري علام تحرم مثلي % % يا ثمالي وليس حين ثمال % % 872(@)(@@) % رزق الشعر منك والقائلوه % % كل حظ فما لشعري ومالي % % 873(@)(@@) % والقوافي يشهدن لي صادقات % باضطلاعي بهن واستقلالي % % 874(@)(@@) % وبأن الذي كسوتك منهن % % ن طراز ما كان بالهلهال % % 875(@)(@@) % غير أني قعدت عنك بوجه % لم توقحه عادة التسآل % % 876(@)(@@) % مشفق أن ترى وأنت كريم % ضرع المستنيل للمستنال % 877(@)(@@) % واثقا منك بالعطايا التي % % تسعى إلى القاعدين غير أوال % 878(@)(@@) % ناظرا أن ترد نقيا يراه % عض دهر مصمم صوال % 879(@)(@@) % والذي يوجب اختلاف وحرص % فقعودي أولى به واتكالي % % 880(@)(@@) % وعداني عن التظلم منه % % ما دهاني به من الأوجال % % PageV01P3781 881(@)(@@) % حالتي رثة فساقط حميدا % بجديد الرياش عني نسالي % % 882(@)(@@) % دعة الواثقين أوجب حقا % من هوي الحراص فوق الرمال % % 883(@)(@@) % فأزرني لها يديك فما زل % % ن نشاطا للهمة المكسال % % 884(@)(@@) % للبداءات يابن يحيى عوادا % % ت فعاود وللهوادي توالي % % 885(@)(@@) % أتبع الكف ساعدا قلما مث % % لك أسدى يدا بلا استكمال % 886(@)(@@) % قد لعمري أنهلتني لو أتمت % نعمة العل نعمة الإنهال % % 887(@)(@@) % ليس من جدته بوسمي عرف % غانيا عن وليك المتوالي % % 888(@)(@@) % لايقولن قائل فلتة منه % % تلاها من الندامة تال % 889(@)(@@) % والعطايا مالم تكرر مرارا % بين قيل من الأعادي وقال % 890(@)(@@) % وإذا ما أصاب رام بفذ % عد من خطيآته في النضال % PageV01P3782 891(@)(@@) % لن يسمى مسددا أو يوالي % % من يديه الصياب كل توالي % % 892(@)(@@) % اخضل الشكر بالندى فتضوع % % ريح ريحانه على الإخضال % 893(@)(@@) % قد أمح الذي كسوت من النع % % مى فأصبحت منه في أسمال % % 894 
ms968	(@)(@@) % فأعده لازلت لابس نعمى % % سابغات جديدة السربال % 895(@)(@@) % أنا من قال مطنبا فيك قولا % باقي الذكر سائر الأمثال % 896(@)(@@) % فاحم أنفا من المجازاة عن با % % ق بفان وعن جديد ببال % % 897(@)(@@) % فلنعمى يديك أولى بأن تن % مى على الدهر من رواسي الجبال % 898(@)(@@) % وتعلم أني وإن أنا أذلل % % ت بما قلت فيك من أقوال % 899(@)(@@) % عارف النفس أنني لم أجاوز % فيك قول العدا بجهد احتفال % 900(@)(@@) % مثل لا يجاوزون الذي قلت % إلى غيره بوجه احتيال % PageV01P3783 901(@)(@@) % ليس يستطيع أن يقول المعادي % % فيك إلا الذي يقول الموالي % % 902(@)(@@) % وتطول بركبة أرتجيها % % منك تدعى فتاحة الأقفال % 903(@)(@@) % تتشكى سبيلها خيل صدق % ولاتشكى سآمة الأعمال % % 904(@)(@@) % لم أجشمك أن تكون شفيعا % لي إلا إلى فتى مفضال % 905(@)(@@) % أبلج الوجه كالهلال بل البد % % ر بل الشمس بل فقيد المثال % % 906(@)(@@) % لايضاهيه في المحاسن إلا % % ما يسديه كفه من فعال % 907(@)(@@) % محسن مجمل وليس ببدع % ذاك من مثله ولا بمحال % 908(@)(@@) % ذانك الحسن والجمال حقيقا % % ن بكنه الإحسان والإجمال % % 909(@)(@@) % أحسن الله خلقه فبداه % % في انتساخ من حسنه وامتثال % 910(@)(@@) % يستملان فعله من كتاب % خط في وجهه بلا استملال % PageV01P3784 911(@)(@@) % أريحي معطي العطية في العط % % لة أضعاف أختها وهو والي % % 912(@)(@@) % والجواد الطباع من لاتراه % % حائلا جوده مع الأحوال % 913(@)(@@) % ليس ممن إذا ألح شفيع % أخلق الجاه عنده بابتذال % 914(@)(@@) % وإذا صوحت نتائج وعد % قد ترامت به شهور المطال % 915(@)(@@) % كشف الوعد من نتائج صدق % معجلات لم تضو في الإعجال % % 916(@)(@@) % وعجيب من الحوافل أن تج % % مع بين التعجيل والإجزال % % 917(@)(@@) % أقسم المجد أنه لا يجل % لي وعده عن ضوى ولا عن حيال % % 918(@)(@@) % وعسى حاسد يقول فهلا % نزلت درة بلا استنزال % 919(@)(@@) % كيف لا يسبق الشفيع نداه % % بعطايا تنهل كل انهلال % 920(@)(@@) % ولعمري ماذاك إلا لفضل % عميت عنه أعين الجهال % % PageV01P3785 921(@)(@@) % لأبي الصقر إخوة هم لديه % % بمحل من الأخوة عال % 922(@)(@@) % ليس مستأثرا عليهم يد الده % % ر بعلق من المحامد غال % 923(@)(@@) % فهو يستجلب 
ms969	 الشفاعة منهم % % لا لنقص في جوده بل كمال % 924(@)(@@) % يتوخى من ذاك أن يشركوه % % من حلى المجد في الذي هو حال % 925(@)(@@) % ويفوزوا بالحمد من حيث لا يص % لون غرما يصلاه للحمد صال % % 926(@)(@@) % هكذا يفعل الجواد إذا كا % % ن جوادا بالمنفسات الغوالي % % 927(@)(@@) % وحقيق من كان شرواه في الفض % % ل بتنفيل أفضل الأنفال % % 928(@)(@@) % مثله عرض الأخلاء للحم % % د لهم بحق الخلال % 929(@)(@@) % فمتى نول امرؤ بشفيع % فلحمد إلى الشفيع ممالي % % 930(@)(@@) % ذاك ظني به وليس بظن % بل يقين ذو غرة كالهلال % PageV01P3786 931(@)(@@) % فليطل رغم حاسديه على الفض % % ل طوالا يجوز حد الطوال % % 932(@)(@@) % إنما يشفع الكرام من النا % % س إلى كل ماجد فعال % 933(@)(@@) % لن يعيب السحاب أن يتولى % % منه أيدي الرياح حل العزالي % % 934(@)(@@) % فالق في حاجتي أخاك أبا الصق % % ر تجده مشمر الأذيال % 935(@)(@@) % واهتبل عطلة الكريم ففيها % % يستقى من جمامة كل دال % % 936(@)(@@) % فرعت ماجدا فأصبح يبني % % سورة المجد جاهدا غير آل % 937(@)(@@) % هي حال الجواد يعدم فيها % % كل شيء لجوده مغتال % 938(@)(@@) % فافترصها وكفه لي ملاء % % من نوال ووجهه لي خالي % % 939(@)(@@) % لاتخف بخله وبادر نداه % % فهو للفال أغول الأغوال % 940(@)(@@) % تلق من ليس وجهه يقذي الع % % ين ولا دره على أميال % PageV01P3787 941(@)(@@) % وهو مستروح لقاءك إيا % % ه يرى أنه نسيم الشمال % 942(@)(@@) % متصد لحاجة لك قد أش % % فى نداه على شفى منهال % 943(@)(@@) % ومتى ما لقيته كان غيثا % أمرته الجنوب بالتهطال % % 944(@)(@@) % ليس من كنت ريحه ببعيد % من سماء تبله ببلال % 945(@)(@@) % وامرؤ يستقى بجاهك أهل % بسجال روية وسجال % 946(@)(@@) % لك وجه مشفع من رآه % % زاح عنه هناك كل اعتلال % % 947(@)(@@) % ينزل القطر من ذرا المزن في المح % ل على كل جردة ممحال % % 948(@)(@@) % ليس ينفك للشفاعة مبذو % % لا وما إن يزداد غير صقال % 949(@)(@@) % وكذلك الكريم سآل حاجا % % ت سواه وليس بالسئال % 950(@)(@@) % صنت نفسا أذلت في المجد منها % % لاعدمناك من مصون مذال % PageV01P3788 951(@)(@@) % كم منيع الجدا شفعت إليه % % لخليل رأيته ذا 
ms970	 اختلال % 952(@)(@@) % جاد إذ صافحت يداك يديه % ورأى وجهك العظيم الجلال % 953(@)(@@) % ففككت البخيل من غل بخل % وفككت الفقير من سوء حال % 954(@)(@@) % فإذا أنت قد فككت أسير % % ين وقدما فككت من أغلال % 955(@)(@@) % ومنحت الذميم منحة حمد % ومنحت العديم منحة مال % 956(@)(@@) % فإذا أنت قد أنلت نوالي % % ن وقدما أنلت كل نوال % 957(@)(@@) % فلأكن بعض من غرست تبي % % ين فضل شكريك غير ما إذلال % 958(@)(@@) % سترى كل من ندبت إليه % % أن شكري لشكره ذو عيال % 959(@)(@@) % ولقاء الوزير في الحاجة الأخ % % رى فلا تنتظر استعجالي % % 960(@)(@@) % فوا أيدي المطي نحو الأل % بل وأيدي الحجيج فوق الآل % PageV01P3789 961(@)(@@) % إن نعماكما تشمل قوما % منهم المرء لا يفي بقبالي % % 962(@)(@@) % لو قضى الدهر للمحق لأضحوا % % لايسوي خدودهم بنعالي % % 963(@)(@@) % يأكلون الآكال دوني وليسوا % % لشكر المؤثرين بالأكال % 964(@)(@@) % أنكرا منكرا من الأمر نكرا % واعدلا بي هديتما إعدالي % % 965(@)(@@) % فقديما أنكرتما الحظ والحر % % مان لم تجريا على استئهال % % 966(@)(@@) % يا علي العلا أيا حسن الحسنى % % ابن يحيى الحيا لدى الإمحال % 967(@)(@@) % إن ظني فلا يقع دون ظني % % همك الطامح البعيد المغالي % % 968(@)(@@) % أن سترقى بي المراقي حتى % % أتعالى في باذخ متعالي % % 969(@)(@@) % أنت ذاك الذي عهدتك قدما % لايغاليك في المساعي مغالي % % 970(@)(@@) % لوتجاريك في مكارمك الري % % ح لخيلت مشكولة بشكال % % PageV01P3790 971(@)(@@) % رب ذي حاجة أرقت لها % % ليلا طويلا وبات ناعم بال % 972(@)(@@) % نام عما يعينه منها وما نم % % ت ولو نمت بات ذا بلبال % 973(@)(@@) % غير ما سمتني وتالله أدري % % أي كسبي ترى به إبسالي % % 974(@)(@@) % ما أرى ذاك غير نحلي لك % % الود وحوكي ثيابه وانتحالي % % 975(@)(@@) % إن تقاضيتك احتجزت وإن طا % % ل سكوتي قابلته باهتمال % % 976(@)(@@) % وغريب مستنكر من سجايا % % ك تناسي الغريم ذي الإهمال % 977(@)(@@) % أين تغليسك البكور لحاجا % % ت نيام عنها ذوي استثقال % 978(@)(@@) % أين تهجيرك الرواح على الأي % ن مجدا للاعب بطال % % 979(@)(@@) % أين تشميرك الذيول ومستك % فيك في بال فاكه ذيال % 980(@)(@@) % أين سعي عهدته لك بلغ % أتراني وافقت 
ms971	 شوط الكلال % PageV01P3791 981(@)(@@) % أم لذنب نبوت عني فلم با % % ن اكتساب الذنوب للأطفال % 982(@)(@@) % إنما كل ما أتى لي في ظل % لك حول أو دونه بليال % 983(@)(@@) % وهب الذنب واقعا أين إم % % هالك ذاك الشبيه بالإهمال % 984(@)(@@) % ما عرفناك بالبوادر كلا % % بل عرفناك بالعطايا العجال % % 985(@)(@@) % أم ملال عراك مني فأنى % % حان قبل اللقاء حين الملال % % 986(@)(@@) % وهب الحين حينه أتراه % % خان أخلاقه تجمل قال % % 987(@)(@@) % لا لعمري لاسيما صنو مجد % فيه مافيك من حميد الخصال % % PageV01P3792 البحر : - 1(@)(@@) % وقفات رأيك في الخطوب تأمل % ونفاذ عزمك في الأمور توكل % 2(@)(@@) % لله درك من عماد خلافة % % ماذا تصون بك الملوك وتبذل % 3(@)(@@) % مازلت تعمد للمخوف صيانة % وتسل فيه كما يسل المنصل % 4(@)(@@) % فرق الشكوك وفي الشكوك تلبس % جمع الأمور وفي الأمور تزيل % 5(@)(@@) % جلب المعاش وفي المعاش تعذر % حقن الدماء وفي الدماء تبزل % % 6(@)(@@) % هنأ الموفق أنه حظ له % % ظفرت يداه به يطيب ويجزل % % 7(@)(@@) % كافي المشاهد لا يخور ولا يني % % ثبت السجية ليس فه تغول % % 8(@)(@@) % متسربل ثوب الشباب ولم يزل % بالحزم فيه وبالوقار تكهل % % 9(@)(@@) % فيه إذا افترض البدار تسرع % وله إذا حذر العثار ترسل % % 10(@)(@@) % حمال أثقال يقوم بحملها % % كالطود ليس بجانبيه تخلخل % % PageV01P3793 11(@)(@@) % فليعلم الملك المظفر أنه % % ما للسلامة ما أقام ترحل % 12(@)(@@) % سدت على الخلل المداخل كلها % % ولقد يرى في كل باب يدخل % 13(@)(@@) % نعم الوزير اختاره لأموره % في كل نائبة ونعم المدخل % 14(@)(@@) % رجل له أني وكيف نسبته % % في الأكرمين تصعد وتنزل % % 15(@)(@@) % يقظان فيه تساقط وتغافل % % إذ في سواه تسقط وتغفل % 16(@)(@@) % مصقولة أخلاقه لاتجتوى % % مشحوذة عزماته لاتنكل % 17(@)(@@) % ولاهما رأيا له ومروءة % فالرأي يشحذ والمروءة تصقل % 18(@)(@@) % تفدى بآباء البرية بلبلا % وفداه بالأبناء طرا بلبل % 19(@)(@@) % وكناه بالصقر العقاب كناية % ولخير إخوتك الذكي القلقل % % 20(@)(@@) % ذاك الذي لا ينقضي معروفه % % إلا بمعروف له لا يعطل % PageV01P3794 21(@)(@@) % ذاك الذي سبق الكرام فما لهم % % إلا امتثال خلفه وتمثل % 22(@)(@@) % إن قال قالوا ما يقول وإن أبى 
ms972	 % % فضلا أبوه فما عداه تثقل % 23(@)(@@) % ولهم إذا نزلوا اليفاع تحول % عنه وليس له هناك تحول % 24(@)(@@) % وترى تبدله فتحسب زينة % وكأن زينة آخرين تبدل % % 25(@)(@@) % وترى تعملهم فتحسب هيبة % وكأن هيبته هناك تعمل % % 26(@)(@@) % هو جوهر والناس أعراض وهم % % يتبدلون وليس فه تبدل % % 27(@)(@@) % هذا مقال الحاسديك برغمهم % % ولهم من الحسد الممض تململ % 28(@)(@@) % وبنور شمسك أبصروك فإنها % % تجلو عمى الأبصار عمن يكحل % 29(@)(@@) % ما قرظوك محبة لكنهم % % لهم بذاك تتوج وتكلل % 30(@)(@@) % ومن العجائب أن أسائل مثلهم % % وصفاتك الحسنى بوصفك تكفل % % PageV01P3795 31(@)(@@) % أنشأت أسألهم بمثلك بعدما % % أرجت برياك الربى والأهجل % 32(@)(@@) % فكأنني بسؤالهم متنور % شعل الذبال وللنهار ترحل % 33(@)(@@) % يا من تعرفت العفاة بجوده % إن التشاغل باللئام تبطل % 34(@)(@@) % إني امرؤ أودى الزمان بثروتي % % وألح يكلمني وكفك تدمل % % 35(@)(@@) % فشددت نحوك أرحلي مستيقنا % أني امرؤ ستشد نحوي أرحل % 36(@)(@@) % أرجو لديك تعجلا وتأجلا % ولمرتجيك تعجل وتأجل % % 37(@)(@@) % فليستمحك فما مطامع نفسه % % حلم ألم ولا مناه تعلل % 38(@)(@@) % وعد المنى وعد عليك نجاحه % وفلاحه والوعد عنك تكفل % % 39(@)(@@) % ألفيت حاصل وعد غيرك خلفة % ورأيت رفدك قبل وعدك يحصل % 40(@)(@@) % مستحمدا لاتستذم ومشرقا % لاتدلهم ونابها لا يخمل % PageV01P3796 41(@)(@@) % لم تله عن حق المليك ولم تضع % حق الملوك فأي حق يبطل % 42(@)(@@) % عاونتهم ولزمت طاعة ربهم % % ففضلت بالحسنى ومثلك يفضل % 43(@)(@@) % وأحق من دعت الملوك لأمرها % % من عنده عون وفيه تبتل % 44(@)(@@) % ممن يبيت مع البراءة خاشعا % لله فيه تخوف وتوجل % % 45(@)(@@) % تتحلل الشبهات في طرقاته % % وله بأفنية الحذار تظلل % 46(@)(@@) % وسلوك من طلب البوار تخمط % وسلوك من طلب النجاة تخلل % 47(@)(@@) % فيمن سواك على الضعاف تحامل % أبدا وفيك عن الضعاف تحمل % 48(@)(@@) % ولمعشر لا ينعمون تطاول % ولراحتيك الثرتين تطول % 49(@)(@@) % ولقد نفيت عن التطول عيبه % فغدا وأصعبه مراما يسهل % % 50(@)(@@) % ولرب شيء ذي محاسن جمة % % وله مقابح إن أديم تأمل % % PageV01P3797 51(@)(@@) % عيب التطول أنه لا واجب % ونراك توجبه وفيك تنصل % 52(@)(@@) % كملت بالإيجاب منه محاسنا % قد كنت أحسب أنها لاتكمل 
ms973	 % 53(@)(@@) % وإذا تجمل بالنطول أهله % فله بما قد زدت فيه تجمل % 54(@)(@@) % وقرنت بالإيجاب أن صفيته % % من كل إذلال كمن يتنقل % % 55(@)(@@) % يأبى لك التفضيل إلا أن ترى % % وعلى التطول من يديك تفضل % % 56(@)(@@) % لبروق وجهك في الوجوه تهلل % ولصوب كفك في الأكف تهلل % 57(@)(@@) % وترى نوافل ما أتيت فرائضا % والفرض عند بني الزمان تنفل % % 58(@)(@@) % متغافلا عن ذكر ما أسديته % وإذا وعدت فذاكر لاتغفل % % 59(@)(@@) % متواضعا أبدا وقدرك يعتلي % % متضائلا أبدا وأمرك يعبل % 60(@)(@@) % فقت الأنام صنيعة وصنائعا % لازلت تستعلي وقرنك يسفل % % PageV01P3798 61(@)(@@) % فإذا الأماثل خايروك صنيعة % فكأن أيمنهم هنالك أشمل % % 62(@)(@@) % وفرعت من شيبان ذروة هضبة % تعلو السحاب فأي شأنك يضؤل % % 63(@)(@@) % لم لا تلوذبك الخلافة بعدما % % أثبت مرساها وفيه تزلزل % 64(@)(@@) % أثبت آساس البنية بالصفا % % لكن أجرافا لهن تهيل % 65(@)(@@) % فأنمت ليل الخائفين مكحلا % فيه السهاد وللدثور تزمل % % 66(@)(@@) % ترعى وتمثل في صلاتك تارة % لمن احتباك فخلفه لك يمثل % % 67(@)(@@) % تغدو وفيك تشدد وتودد % كالدهر فيه توعر وتسهل % % 68(@)(@@) % وبشير من عاملته ونذيره % في حالتيك تبسم وتبسل % % 69(@)(@@) % وكأن شخصك حين يعقد حبوة % جبل تخاشع في ذراه الأجبل % % 70(@)(@@) % وإذا وقرت أو اهتززت لصولة % أرسى يلملم أو تزعزع يذبل % % PageV01P3799 71(@)(@@) % وسألت عنك الحاسدين فكلهم % % قالوا مقالا ليس فيه تقول % % 72(@)(@@) % ذاك الوزير بحقه وبصدقه % % يصفي النصيحة للمولك وينخل % 73(@)(@@) % ذاك المؤمل للرعاة ومن رعوا % % إن صح للمتأملين تأمل % % 74(@)(@@) % لا مطل فيك لطالب منك الغنى % % وإذا طلبت فإن شأوك يمطل % 75(@)(@@) % وإذا اختبرت فللعفاة تعود % يدعو إليك وللعداة تنكل % 76(@)(@@) % وإذا سئلت فلا نداك تكلف % وإذا مدحت فلا ثناك تمحل % 77(@)(@@) % وكأن لهوتك التي تعطى لها % كأن سجلك في العاطش أسجل % 78(@)(@@) % وكأن ذمتك التي هي عصمة % ذمم الورى وكأن حبلك أحبل % 79(@)(@@) % فمتى دعا المعتاف نحوك مرة % فأل دعتني من فعالك أفؤل % % 80(@)(@@) % خذها إليك مقرة بمعايب % ترجو تغمدها لديك وتأمل % PageV01P3800 81(@)(@@) % وأقل حقك أن ترى متجاوزا % عن شاعر في القول منه تهلهل % 82(@)(@@) % ماضره ألا 
ms974	 يجيد وماله % بسوى نداك إلى جداك توسل % % 83(@)(@@) % بل ما عليك من المدائح أحكمت % أم هلهلت في وشي نفسك ترفل % % 84(@)(@@) % ما قد كستك يداك مما أسدتا % % كاف ومدح المادحين تأكل % 85(@)(@@) % من كان يزعم طيب نشرك آتيا % مما يقول فذاك منه تنحل % 86(@)(@@) % تتصرف الأرواح كيف تصرفت % وثراك من مسك حباه قرنفل % 87(@)(@@) % لم تذك نشرك في البلاد مدائح % لركابها في الخافقين تقلقل % 88(@)(@@) % يكفيك نقل الشعر ذكرك إنه % % ذكر له بسدى يديك تنقل % 89(@)(@@) % أغنى العيان عن السماع وما يرى % % فهو اليقين وما يقال تختل % % 90(@)(@@) % بلغت مآثرك البعيد فما الذي % % نرويه عنك بمدحنا أو تنقل % PageV01P3801 91(@)(@@) % هذا لذاك وإن أجاد مجيدنا % % فلما فعلت عن المقال تمهل % 92(@)(@@) % وبأن أجدت أجاد مدحا مادح % قسما بمدحك ليس عنك تحلل % % 93(@)(@@) % لولا البدائع من فعالك لم يكن % % للمادحين إلى البديع تغلغل % % 94(@)(@@) % أرجو وإن رذلت مدائح قلتها % % أن لا يكون لديك مدح يرذل % % 95(@)(@@) % لتخلف الشعراء عندك رأفة % ولسبق سابقهم لديك تقبل % 96(@)(@@) % فمتى تقدم أو تأخر شاعر % عن شأو صاحبه ففيك تحمل % 97(@)(@@) % ما كل مثلوم الكلام بساقط % قد يقتنى سيف وفيه تفلل % % 98(@)(@@) % ويقوم طرف دون شوط رسيله % % ويحليان حلى لهن تصلصل % 99(@)(@@) % عشقتك أبكار القريض وعونه % % فغدت إليك عواصيا من يعذل % % 100(@)(@@) % ورأت لهاك عفاتها أكفاءها % % فغدت هناك عواصيا من يعضل % PageV01P3802 101(@)(@@) % كم من قواف لا ينال وصالها % % قد أصبحت ولها إليك توصل % % 102(@)(@@) % باتت معاولها عليك تقاتل % وغدت إليك لها إليك تقتل % 103(@)(@@) % متغزلات عند أروع ماله % إلا مع المدح الوضاء تغزل % 104(@)(@@) % بل لاتغزل عند من لبنانه % % رفض التغزل بل هناك تبعل % 105(@)(@@) % سأسوء قوما بامتداحك همهم % % في أن تذم وفي صنيعك يرذل % 106(@)(@@) % لهم إذا أجملت فيك تجمل % ولهم إذا فصلت فيك تفصل % 107(@)(@@) % فاسلم لمدح المادحين ولاتزل % % ذا نائل يحبى وكيد يقتل % % 108(@)(@@) % فكر كمقدار السماء إذا انتحى % % لم يعصم الأوعال منه توقل % 109(@)(@@) % ومناصح تعلى ونبل يعتلي % % وصفائح تعلو وسمر تنهل % 110 
ms975	(@)(@@) % لمنابذيك ولابن سلمك جنة % لثمارها أبدا عليك تهدل % % PageV01P3803 111(@)(@@) % أنا من تحلله الزمان بتركه % % ولمستجيرك بالأمان تجلل % 112(@)(@@) % عزب من النعم الجسام مقدر % بل أن يقدر لي بهن تأهل % PageV01P3804 البحر : - 1(@)(@@) % أقاسم لاتسدد سبيلي إلى الرضا % % فأنت المولى فتح كل سبيل % 2(@)(@@) % ولاتجعلن الظن ماعشت صاحبا % فلست تراه صاحبا لنبيل % 3(@)(@@) % أتقبل دعوى الظن وهي مخيلة % وتترك مثلي وهي غير مخيل % % 4(@)(@@) % وقد سار مدحي فيك كل مسيرة % % مزحزحة بل سال كل مسيل % % 5(@)(@@) % فإن قلت قد صح الذي أتت جاحد % فهب ذنب جان لاعتذار ذليل % % 6(@)(@@) % أطال علي الليل أن قد منعتني % % رضاك وكان الليل غير طويل % 7(@)(@@) % وأنك صدقت الظنون وما أتت % % على ما ادعت من قصتي بدليل % 8(@)(@@) % وإن العدا مذ علتني وحجبتني % % رأوا وجه قال عند ذاك وقيل % % 9(@)(@@) % وإن جدت لي بالكثر قالوا مبغض % فدى نفسه من قربه بجزيل % 10(@)(@@) % وإن جدت لي بالقل قال خطيبهم % % قليل رمى في وجهه بقليل % PageV01P3805 11(@)(@@) % وجودك بالفضل الذي قد بذلته % % شفاء فلا تمزجه لي بغليل % 12(@)(@@) % وكل الذي أسلفتني من صنيعة % جميل فلا تردفه غير جميل % 13(@)(@@) % أنلت فإن شئت الإقالة محسنا % أقلت ولم أعهدك غير مقيل % % 14(@)(@@) % وقالوا عليل قلت كلا وإن يكن % عليلا فما إحسانه بعليل % 15(@)(@@) % كساه الذي أعلاه برءا وصحة % وكانت له الأيام خير خليل % 16(@)(@@) % وأضحى وأمسى والسلامة عنده % % لحاف مبيت أو فراش مقيل % PageV01P3806 البحر : - 1(@)(@@) % ومعتذر من نعمة قد أفادها % % وآخر ممتن علي بباطل % 2(@)(@@) % فدت نفس هذا نفس هذا من الردى % % وممن كل محذور من الأمر نازل % 3(@)(@@) % وكيف وأنى لامرىء غير فاضل % من الناس أن يرضى فداء لفاضل % 4(@)(@@) % رأيت المكنى بالحسين تحاسنت % أفاعليه حتى علا كل فاعل % 5(@)(@@) % إذا طال شكر طول كفيه مرة % ثنى الطول طلابا بتلك الطوائل % 6(@)(@@) % حباني فلم يترك فعالا لفاعل % وقلت فلم أترك مقالا لقائل % 7(@)(@@) % بلى قد تركت القول في اليوم كله % % لغير غدا بل لي غدا في المحافل % 8(@)(@@) % سأمجده من آجل 
ms976	 بعد عاجل % ويمجدني من آجل بعد عاجل % 9(@)(@@) % فتى نصب الشطرنج كيما يرى به % % عواقب لاتسمو لها عين جاهل % 10(@)(@@) % وأجدى على السلطان في ذاك أنه % % يريد بها كيف اتقاء الغوائل % % PageV01P3807 11(@)(@@) % وتصريف مافيه إذا ما اعتبرته % % مثال لتصريف القنا والقنابل % % 12(@)(@@) % تأمل حجاه في دقايق هزله % % تجده حجاه في الهنات الجلائل % 13(@)(@@) % رأى خيرها لما التقينا ولم يزل % يرى خير ما في الدست رأية عاقل % 14(@)(@@) % فأبصر أعقاب الأحاديث في غد % بعيني عتيق من عتاق الأجادل % 15(@)(@@) % إذا قلب الآراء في الدست مرة % رأيت مجدا في مخيلة هازل % 16(@)(@@) % وما كان ممن يصطفيها فكاهة % كبعض الملاهي أو كإحدى المشاغل % 17(@)(@@) % شهدت لقد نادمته فوجدته % % سميعا فقيه القلب عن كل سائل % 18(@)(@@) % أصم عن الفحشاء والعذل في الندى % % طويل التمادي في شقاق العواذل % 19(@)(@@) % يجود فيعطي ماله في حقوقه % % على منهج بين السبيلين عادل % 20(@)(@@) % فإن هاجه هيج من العذل أصبحت % فرائضه مشفوعة بنوافل % PageV01P3808 21(@)(@@) % هو النيل يجري في سواء سبيله % فلا تنتحي عن قصده للمعادل % 22(@)(@@) % فإن كفكفته الريح عن وجه جريه % طما واغتدى آذيه في السواحل % % 23(@)(@@) % له راحة روحاء تشهد أنها % % مغيض لصنع أو مفيض لنائل % 24(@)(@@) % جزته يد أغلت يديه بحقه % جزاء امرىء عن حقه غير غافل % 25(@)(@@) % ولاخمل المعروف منه فإنه % % تحمل منه نابها غير خامل % 26(@)(@@) % قصرت له من طول شكري ولم تغض % % بحوري ولا ألفيته غير طائل % % 27(@)(@@) % ولكنه فجر بدا قبل شمسه % % ونغشه قطر بشرت قبل وابل % % 28(@)(@@) % رويد المكنى بالحسين رويده % % سأجري به في المشبهات الأطاول % 29(@)(@@) % وماذاك عن جودي وفضل مثوبتي % % ولكنه عن فضله المتكامل % 30(@)(@@) % سيضطرني حتى أكرر مدحه % % تتابع كرات له بالفواضل % % PageV01P3809 31(@)(@@) % ولم تك جدواه عطية باخل % ولكنها منه سجية باذل % 32(@)(@@) % أخ لم يزل يرمي مقاتل عسرتي % % رمى الله عنه قرنه بالمقاتل % 33(@)(@@) % أبى الله أن يلقى الندى منه هفوة % إذا ما الندى أضحى خطيئة باخل % 34(@)(@@) % تحية روح ندمان ومجنى % % فكاهات تجر الذيول % 34(@)(@@) % كأن 
ms977	 عفاة فضلك في مجال % % وكيف تريث عودة من يجول % 34(@)(@@) % يردهم انهيالك بالعطايا % % وما ينهال منك هناك جول % 34(@)(@@) % فلا تتقدم الضعفاء منا % % إلي معروفك الجلد الحمول % % 34(@)(@@) % أفكه معشر ولهم فضول % واغللنا وليس لنا فضول % 34(@)(@@) % وما بي أن انافسه نفيسا % وكيف ينافس الحر البذول % % 34(@)(@@) % بدأت بمعشر ليسوا عيالا % عليك فلو بدات بمن تعول % PageV01P3810 34(@)(@@) % وإن نفاستى حظا عليه % % للؤم في الخليفة بل سفول % 34(@)(@@) % ولكن المكانة منك حظ % تجور لها الفلاسفة العدول % % 34(@)(@@) % وفكه معشر ضعفاء مثلي % % ولكن كلهم طبن حيول % % 34(@)(@@) % كشهري لديك ومعشري % طفلين شأنهما الوغول % % 34(@)(@@) % إذا شاءا أطافا كل يوم % بحيث يخالف النهم الأكول % 34(@)(@@) % وكل فتى له وجه وثيق % متى ما شاء أمكنه النزول % 34(@)(@@) % كمصباح الكرام بني بويب % أبى حسن لشانئه الهبول % % 34(@)(@@) % ألا إن القصاص لخيم سوء % أبته لك العمومة والخؤول % % 34(@)(@@) % ولكن خانني شركاء سوء % % وغلوا لا صفا لهم الغلول % % 34(@)(@@) % يتابع في أغراضه صوب نبله وافرأساء الرأي أم عزب الرسولوقد حضرت شمول و الشمولأظن الرأي ساء ولم وأنيوذاك النور ليس له أفولأحين بسطت فضلك زال عنيكريم مكن حفاظك لا يزول وحالت صفحة ما كان رأي يريني أنها أبدا تحول ايا أملي أتمرع بطن ك % % إذا كان بعض الصوب فلتة نابل % % PageV01P3811 34(@)(@@) % أساء الرأي أم عزب الرسول % وقد حضرت شمول و الشمول % 34(@)(@@) % أظن الرأي ساء ولم وأني % وذاك النور ليس له أفول % 34(@)(@@) % أحين بسطت فضلك زال عني % % كريم مكن حفاظك لا يزول % 34(@)(@@) % ونحوك تعمل السفر المطايا % % وفي أذرائك الإنس الحلول % 34(@)(@@) % ايا أملي أتمرع بطن كف % لعاف واللقاء له محول % % 34(@)(@@) % بل الثقلان كلهم عيال % عليك لأنك الغيث الهطول % 34(@)(@@) % فمالك في القصاص فدتك نفسي % % وقدرتك عن منافستي يطول % 34(@)(@@) % حلفت لتجزلن لي العطايا % % ورأيك أنك البر الوصول % 34(@)(@@) % أما في الطول جمعمك بين بري % وتقريبي وقد وقع القبول % % 34(@)(@@) % نعم وتزيدني ما أنت أولى % % به ويحق فضلك ما أقول % PageV01P3812 34(@)(@@) % وتضمن ذاك أعراق كرام % تهزك 
ms978	 لي وأخلاق سهول % 34(@)(@@) % كأنك بي اقول وقد اتاني % % رسولك بعدما غالته غول % 34(@)(@@) % وحالت صفحة ما كان رأي % يريني أنها أبدا تحول % % 34(@)(@@) % وأتبع نائلا بغنى وشيك % إن القطر تتبعه مرقال ذمول % % 34(@)(@@) % وقد سيرت أنكم غيوث % تجود ولا تكون لها وحوا % 34(@)(@@) % وما ارتفعت كهمتك الثريا % % ولا ألت كجاريك الوعول % 34(@)(@@) % عطايا تعتفى منها العطايا % % وعقل تستقى منه العقول % % 34(@)(@@) % ألست معان معرفة وعرف % فكيف يغول مدحك من يغول % 34(@)(@@) % وما أمتن شكري وامتداحي % % وهل لك من حلى مدحي عطول % % 34(@)(@@) % وما بي نيل ما استوهبت لكن % % حب لحب ساكنها الطلول % PageV01P3813 34(@)(@@) % ورفلني ونفلني فعندي % % ثناء فيك مرقال ذمول % % 34(@)(@@) % ولم تزل الكرامة أو سواها % % فروعا تستبان بها الأصول % 34(@)(@@) % ولاحظني بطرفك لا جديدا % ولا مستكرها فيه فول % 34(@)(@@) % وعهدك صغة الله استجدت % فلاتك كالخضاب لها نصول % 34(@)(@@) % وأوضاح الأغر مفضلات % ولكن دون غرته الحجول % % 34(@)(@@) % ومالي لا أقول وقد اقرت % لي الشبان طرا والكهول % % 34(@)(@@) % وإني للفتى القوال فيكم % % وإنك للفتى فينا الفعول % 34(@)(@@) % وإنا في صناعتنا لرهط % ودولتنا بدولتكم تدول % 34(@)(@@) % وليس معارضتي إلا زهير % % ومن ابكته حومل والدخول % % 34(@)(@@) % وليس يشده لا كتاب % مضمن عزمة فيها بذول % % PageV01P3814 34(@)(@@) % وقد سر المكارم ان أدلتم % % كما سر المجمرة القفول % 34(@)(@@) % وما الراجي بمحروم لديكم % % ولا المشنوء عندكم السؤول % % 34(@)(@@) % أرجي من نوالك فيض بحر % إذا ما أنكد الوشل الضمول % 34(@)(@@) % ولم أزجر هناك الطير لكن % ثناؤك حين تحتفل الحفول % 34(@)(@@) % صحبتك جاعلا سيماك فألي % % وحسبي حين تشتبه الفؤول % % 34(@)(@@) % فزدني منك تقريبا وبشرا % فإن الجنس تتبعه الفصول % % 34(@)(@@) % وما أنا بالمقتصر في التقاصي % % ولا انت الدفوع ولا المطول % 34(@)(@@) % لك الآلاء عندي والأيادي % % فلم مست تخالطها تبول % % 34(@)(@@) % علي أني أرى التسبب امسى % % وهي أو كاد يدركه البطول % % 34(@)(@@) % ولا خطر التسحب لي ببال % كما يتسحب الحمق الجهول % PageV01P3815 34(@)(@@) % وما استبطأت طولك في عتابي % % كما يستبطئ الخرق العجول % % 34(@)(@@) % وليس حصول فائدة حصولا % إذا ما أخطأالغرض الحصول 
ms979	 % 34(@)(@@) % وإذن الوجه لا الحجاب إذن % وفي الأحشاء لا الدار الدخول % 34(@)(@@) % وحظي بالوصول ليك حظي % % ولكن الوصال هو الوصول % 34(@)(@@) % وإني للمغفل حين يرعى % % وإنك أنت لا الراعي الغفول % 34(@)(@@) % عذلتكم على استمرار ظلمي % % ولولا الظلم ما عذل العذول % 34(@)(@@) % وما من مزنكم ما فيه دجن % ولا من ريحكم هيف جفول % 34(@)(@@) % تشكى ما اشتكاه أنين مضنى % % وتحكى ما حكى دمع همول % 34(@)(@@) % ولو اني أشاء لقلت غيري % % ظلامتها جفاؤك يا ملول % 34(@)(@@) % منحتكها مطفلة تباري % % ذباب السيف ليس لها نكول % % PageV01P3816 34(@)(@@) % وأرجو توبة منكم نصوحا % وبعض القوم توبته ختول % % 34(@)(@@) % وما بي سلوة فأقول سيروا % % فإن الريح طيبة قبول % 34(@)(@@) % على أني أرى ما نلتموه % % إلي لدى تأمله يؤول % 34(@)(@@) % وأنت إذا المثابة ظللتنا % % دليل هدى يلوذ به الضلول % % 34(@)(@@) % ووجه مثل بدر السعيد أمسى % % وليس عليه من ليل سدول % 34(@)(@@) % ولست كمن له قلم مطاع % تهال الرجل منه والخيول % 34(@)(@@) % وإن عاد الرئيس لبخس حقي % % غضبت وغضبتي أمر يهول % 34(@)(@@) % وأحسبهم ستنذرهم بيأس % عقول لا تباع بها العقول % 34(@)(@@) % وإن عادوا إلى اخرى سواها % % تتبعت الطوائل والذحول % 34(@)(@@) % وما أفعالكم بمفعلات % وقولي في مدائحكم مقول % PageV01P3817 34(@)(@@) % إذا ما ليلة قصرت عليكم % % فليس لها هناك علي طول % 34(@)(@@) % وقلبي بينكم عان بعان % عليه من روادفه كبول % 34(@)(@@) % ولست بموعد بالشر لكن % % كذا تدلي شقاشقها الفحول % 34(@)(@@) % وقد زاح المزاح وآن جد % كجد الليث حفته الشبول % 34(@)(@@) % قضيت من الدعابة نخب لهو % % وما ترك المداعبة الرسول % 34(@)(@@) % يصيب مقاتلي ومعي سلاحي % % وأنتم حاضرون ولا أصول % % 34(@)(@@) % أأثني حربتي عن كل قرن % وأنتم حاضرون ولا أصول % % 34(@)(@@) % فإن تك محضري كلا ثقيلا % ففي الكرماء تحتمل الكلول % % 34(@)(@@) % يقابل والعيون مصححات % % ويدبر والعيون إليه حول % 34(@)(@@) % طفيليون من نحلل ذراه % فأم طعامه الأم الثكول % PageV01P3818 34(@)(@@) % ومالي زوجة إلا الأماني % % معللة بلا لقح تشول % 34(@)(@@) % أبات المال نسوتهم حبالي % % وبت وزوجتي بكر بتول % 34(@)(@@) % ومما اشتكي أني فريد % وأن الناس كلهم بعول 
ms980	 % % 34(@)(@@) % فدبر لي عليك عساك تنقى % % ضميرك لي وقد ينقي الغسول % 34(@)(@@) % ضموم كلما انفرجت صدوع % صدوع كلما التبست شكول % 34(@)(@@) % ونعم الجذل للتدبير نأوي % % إليه إذا تضعضعت الجذول % 34(@)(@@) % فيا لهفي ويا أسفي امثلي % % لكل مذلة جمل ذلول % PageV01P3819 البحر : - 1(@)(@@) % أبدر السماء وغيث السما % % ء لازلت حيا مدالا مديلا % % 2(@)(@@) % أتاني أنك راعيتني % % وساءلت عني سؤالا طويلا % % 3(@)(@@) % فأكبرت ذاك وأعظمته % % وإن كان فيما تسدي قليلا % % 4(@)(@@) % ورفعت رأسا به خشعه % وأثقبت للدهر طرفا كليلا % % 5(@)(@@) % وأصبحت أخطر ذا نخوة % عزيزا وأضحى عدوي ذليلا % % 6(@)(@@) % وأقسمت بالله أن لا يزا % % ل مقدار نفسي عندي جليلا % % 7(@)(@@) % ولم لا يجل امرؤ نفسه % % وأنت ترى فيه رأيا جميلا % % 8(@)(@@) % ويا لهف نفسي لما طلب % ت أن كان بختي بختا عليلا % % 9(@)(@@) % أيطلبني سيد لا أزا % % ل أبغي بجهدي إليه سبيلا % % 10(@)(@@) % فأخفى عليه ويخفى علي % ي أي فد بغاني مغيما مخيلا % % PageV01P3820 11(@)(@@) % ليمطرني مطرة لا يزا % % ل عودي منها وريقا ظليلا % % 12(@)(@@) % أقول لنفسي وقد أثخنت % % فأبدت عويلا وأخفت غليلا % % 13(@)(@@) % عزاؤك يا نفس لاتهلكي % % فإن لأمرك أمرا أصيلا % % 14(@)(@@) % وإن أمامك مندوحة % ومولى كريما ورفدا جزيلا % % 15(@)(@@) % ومن شأنه أن إذا هم % م ثم مستكثرا أن يرى مستحيلا % % 16(@)(@@) % وإن سبق الرأي وعد له % % بمنفسه جل أن يستقيلا % % 17(@)(@@) % أراه بحق مليكا علي % ي مقتدرا ويراني خليلا % % 18(@)(@@) % سيطلبني فضله عائدا % كما يتتبع سيل مسيلا % % 19(@)(@@) % جعلت بذاك سنا وجهه % % بشيرا وجود يديه كفيلا % % 20(@)(@@) % ولن أتقاضاه حسبي به % % على نفسه للمعالي وكيلا % % PageV01P3821 21(@)(@@) % ولست أرى شاعرا عادلا % % يكون لسماه عندي عديلا % % 22(@)(@@) % جعلت الصباح على نفسه % % دليلا لعيني وحسبي دليلا % % PageV01P3822 البحر : - 1(@)(@@) % إذا ما جلته الحرب أعرض رمحه % % على لاحق الأقراب نهد المراكل % 2(@)(@@) % تهاتفت الأبطال هنك فارسا % شهدنا لقد صدقت بشرى القوابل % 3(@)(@@) % فإن طاعنوه كان أول طاعن % وإن نازلوه كان أول نازل % % 4(@)(@@) % يشيعه قلب رواع وصارم % صقيل قديم عهده بالصياقل % 5(@)(@@) % يشيم بروق الموت من صفحاته 