ms2468	 المدني قاضي بغداد.(@)(@@)(@@)(@@) | 3118 - (@)(@@) " سعيد " بن عبد الرحمن بن عبد الله الزبيدي بضم الزاي أبو شيبة الكوفي قاضي الري.(@)(@@)(@@)(@@) | 3119 - (@)(@@) " سعيد " بن عبد العزيز بن أبي يحيى التنوخي أبو محمد الدمشقي الفقيه ثبت.(@)(@@)(@@)(@@) | 3120 - (@)(@@) " سعيد " بن عبيد الله بن جبير بن حية2 الثقفي الجبيري بصري عن عمه زياد وبكر المزني.(@)(@@)(@@)(@@) | 3121 - (@)(@@) " سعيد " بن عثمان البلوي المدني روى عنه عيسى بن يونس فقط.(@)(@@)(@@)(@@) | 3122 - (@)(@@) " سعيد " بن أبي عروبة واسمه مهران اليشكري مولاهم أبو النضر البصري PageV07P230(@)(@@) الحافظ العلم.(@)(@@)(@@)(@@) | 3123 - (@)(@@) " سعيد " بن عمارة بن صفوان الكلاعي الحمصي.(@)(@@)(@@)(@@) | 3124 - (@)(@@) " سعيد " بن عمرو بن اشوع الهمداني الكوفي قاضيها ثبت.(@)(@@)(@@)(@@) | 3125 - (@)(@@) " سعيد " بن عمير بن نيار بكسر النون بعدها تحتانية وقيل بين عمير ونيار عقبة الحارثي عن جده لامه البراء بن عازب رضى الله عنه.(@)(@@)(@@)(@@) | 3126 - (@)(@@) " سعيد " بن غزوان1 شامي عن أبيه وعنه معاوية بن صالح.(@)(@@)(@@)(@@) | 3127 - (@)(@@) " سعيد " بن كثير بن عفير2 الأنصاري مولاهم أبو عثمان المصري الحافظ عالم بالأنساب روى عنه البخاري ومحمد بن إسحاق الصاغاني.(@)(@@)(@@)(@@) | 3128 - (@)(@@) " سعيد " بن كثير بن المطلب بن أبي وداعة السهمي أبو إسماعيل المكي عن عمه جعفر وعنه ابن جريج.(@)(@@)(@@)(@@) | 3129 - (@)(@@) " سعيد " بن أبي كريب الهمداني عن جابر وعنه أبو إسحاق.(@)(@@)(@@)(@@) | 3130 - (@)(@@) " سعيد " بن محمد الوراق الثقفي أبو الحسن الكوفي نزيل بغداد عنه أحمد وابن المديني.(@)(@@)(@@)(@@) | 3131 - (@)(@@) " سعيد " بن محمد بن سعيد3 الجرمي الكوفي روى عنه البخاري ومسلم.(@)(@@)(@@)(@@) | 3132 - (@)(@@) " سعيد " بن محمد بن جبير بن مطعم النوفلي المدني عن جده وأبيه وأبي هريرة وعنه ابن عمه عثمان ابن أبي سليمان وابن أبي ذئب.(@)(@@)(@@)(@@) | 3133 - (@)(@@) " سعيد " بن المرزبان العبسي مولى حذيفة أبو سعد الكوفي البقال بموحدة الأعور.(@)(@@)(@@)(@@) | 3134 - (@)(@@) " سعيد " بن مزاحم بن أبي مزاحم الأموي مولى عمر بن عبد العزيز عن أبيه وعنه قتيبة. PageV07P231(@)(@@)(@@)(@@) | 3135 - (@)(@@) " سعيد " بن مسلمة بن هاشم بن عب