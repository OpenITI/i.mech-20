ms141	 الإله عن ذلك الصب % % ر على الهول جنة وحريرا % % 15(@)(@@) % وأراك الإله في جنة الخلد % نعيما بها وملكا كبيرا % % PageV01P530 البحر : طويل 1(@)(@@) % أدرها بأمن لا يغيرك الوهم ، % وزف على الجلاس ما خلف الكرم % 2(@)(@@) % وداو أذاها بالسماع ، فإنها % % بلا نغم غم ، بلا دسم سم % 3(@)(@@) % معتقة لو غسلوا ميتا بها % % لما ذاب منه المخ وانهشم العظم % 4(@)(@@) % ولولا اتقاء الله قلت بأنها % % بها تنطق الأموات أو تسمع الصم % 5(@)(@@) % فلم ير يوما كاسها من رأى الأذى ، % ولا مسها بالكف من مسه الهم % 6(@)(@@) % فخذها على طيب السماع ، فإنها % % بشاشة وجه العيش إن عبس الهم % 7(@)(@@) % ولا تخش من إثم ، إذا ما شربتها ، % لظاهر قول الناس إن اسمها الإثم % 8(@)(@@) % ولو أن وصف الشيء عين لذاته ، % أو الذكر للشيء المراد هو الجرم % 9(@)(@@) % لما مات من سموه باللفظ خالدا ، % ولا خر ملك في الثرى واسمه نجم % 10(@)(@@) % كما خر نجم الدين من عرش ملكه % % ولم يغن عنه الباس والعزم والحزم % PageV01P531 11(@)(@@) % مضى الملك المنصور من دست ملكه % ولم ينجه الملك الممنع والحكم % 12(@)(@@) % مليك أفا العدل في كل معشر ، % فليس له ، إلا لأمواله ، ظلم % 13(@)(@@) % وما غيبته الأرض ، إلاذ لأنها ، % لأقدامه ، ما كان يمكنها اللثم % 14(@)(@@) % وخلف أشبالا سعوا مثل سعيه % % لئلا يعم الناس من بعده اليتم % 15(@)(@@) % ملوكا حذوا في الجود حذو أبيهم % ففي كل وصف من نداه لهم قسم % 16(@)(@@) % وأشرق في الشبهاء في الدست منهم ، % وقد غاب عنها نجمها ، بدرها التم % 17(@)(@@) % هو الصالح الملك الذي لبس البها ، % وللناس منه ، فوق ثوب البها ، رقم % 18(@)(@@) % جميع أمارات الشهيد ظواهر % عليه تساوى الباس والرأي والفهم % 19(@)(@@) % وأهون شيء عنده الخيل واللهى ، % وأنفق شيء عنده النثر والنظم % 20(@)(@@) % وأحسن أيام السماح ولودها ، % إذا أعجب النجال أيامها العقم % PageV01P532 21(@)(@@) % ورب حديث من علاه سمعته ، % لحلو جناه ، من حلوق النهى طعم % 22(@)(@@) % وفيض نوال من يديه أفدته ، % له في قلوب الناس من جسدي وسم % 23(@)(@@) % ولما أراد الدهر كيدي فزرته ، % وبت ، ولي 
ms142	 في صحف إنعامه رسم % 24(@)(@@) % فأخر صرف الدهر عني ، فلا يرى % % مقابلتي لما درى أنه الخصم % PageV01P533 البحر : خفيف تام 1(@)(@@) % هجرت بعدك القلوب الجسوما % % حين أمست منك الربوع رسوما % % 2(@)(@@) % وخلت من سناك زهر المغاني ، % فاستحال النهار ليلا بهيما % % 3(@)(@@) % يا هلالا أودى به الخسف لما % % صار عند الكمال بدرا وسيما % % 4(@)(@@) % وقضيبا رمنا لذيذ جماه ، % فذوى حين صار غصنا قويما % % 5(@)(@@) % ما ظننا المنون ترقى إلى البد % % ر ، وأن الحمام يغشى النجوما % % 6(@)(@@) % هد قلبي من كان يؤنس قلبي % % إذ نبذناه بالعراء سقيما % % 7(@)(@@) % ونأى يوسفي ، فقد ذهبت عينا % % ي من حزنه ، وكنت كظيما % % 8(@)(@@) % يا صغيرا حوى عظيم صفات ، % أوجبت في قلوبنا التعظيما % % 9(@)(@@) % خلقا طاهرا ، وكفا صناعا ، % ولسانا طلقا ، وطبعا سليما % 10(@)(@@) % كنت رقي ، فصرت مالك رقي % % بحجى منك يستخف الحلوما % % PageV01P534 11(@)(@@) % ويدين ثنت عنان يراع % أنبتت في الطروس درا نظيما % 12(@)(@@) % ومقال ، إذا دعاه لبيب % ظن أني منك استفدت العلوما % % 13(@)(@@) % وإذا ما تلوت نظمي ونثري ، % خالني منك أطلب التعليما % % 14(@)(@@) % يا خليلا ، ما زال خصما لخصمي % % كيف صيرت لي الغرام غريما % % 15(@)(@@) % كيف جرعتني الحميم من الحز % % ن ، وقد كنت لي صديقا حميما % % 16(@)(@@) % نمت عن حاجتي ، فأحدثت عندي % % لتنائيك مقعدا ومقيما % % 17(@)(@@) % وترحلت عن فنائي رحيلا ، % صير الحزن في الفؤاد مقيما % % 18(@)(@@) % لست أنساك ، والمنية تخفي % % منك نطقا عذبا وصوتا رخيما % % 19(@)(@@) % ومسحت الجبين منك بكفي ، % فأعاد المسيح قلي كليما % % 20(@)(@@) % كنت أملت أن تشيع نعشي ، % وتواري في الترب عظمي الرميما % % PageV01P535 21(@)(@@) % وتوقعت أن أرد بك الخط % % ب ، فأمسى نواك خطبا جسيما % % 22(@)(@@) % قد تبوأت قاطنا الخل % % د ، فأورثت في فؤادي الجحيما % % 23(@)(@@) % وتفردت بالنعيم من العي % % ش ، وأبقيت لي العذاب الأليما % % 24(@)(@@) % فسقى عهدك العهاد ، فقد فز % % 25(@)(@@) % وعليك السلام حيا ، وميتا ، % ورضيعا ، ويافعا ، وفطيما % % PageV01P536 البحر : خفيف تام 1(@)(@@) % يا بدورا تغيب تحت التراب ، % وجبالا تمر مر السحاب % 2(@)(@@) % إن في ذلك ، اعتبارا وذكرى ، % يتوعى بها ذوو الألباب % 3(@)(@@) % قل لصادي الآمال لا 
ms143	 ترد العي % % ش ، فإن الحياة لمع سراب % 4(@)(@@) % أين رب السرير والجيزة البي % ضاء ذات النخيل والأعناب % 5(@)(@@) % عرصات كأنهن سماء ، % قد توارت شموسها في الحجاب % 6(@)(@@) % أين رب الآراء والرتبة العل % % ياء ، والماجد الرفيع الجناب % 7(@)(@@) % والذي لقبوه بالأبلج الو % هاب طورا ، والعابس النهاب % 8(@)(@@) % ليث إبنا أرتق الملك المن % % صور ، رب الإحسان والأنساب % 9(@)(@@) % صاحب الرتبة التي نكص العا % % لم من دونها على الأعقاب % 10(@)(@@) % ومجلي لبس الأمور ، إذا بر % % قع قبح الخطا وجوه الصواب % PageV01P537 11(@)(@@) % حاز حلم الكهول طفلا وأعطي % % ورع الشيب في أوان الشباب % 12(@)(@@) % جل عن أن تقبل الناس كفي % % ه ، فكان التقبيل للاعتاب % 13(@)(@@) % لم ترنح أعطافه نشوة المل % % ك ، ولا يزدهيه فرط أعتجاب % 14(@)(@@) % رافع النار بالبقاع ، إذا أخ % مد برد الشتاء صوت الكلاب % 15(@)(@@) % ومحيل العام المحيل ، إذا اعتا % % د لسان الفصيح نطق الذباب % 16(@)(@@) % عرفوا ربعه ، وقد أنكر الجو % % د ، برفع اللوا ونصب العتاب % 17(@)(@@) % وقدور بما حوت راسيات ، % وجفان مملوة كالجوابي % % 18(@)(@@) % ملك أصبح الخلائق والأ % % يام والأرض بعده في اضطراب % 19(@)(@@) % فاعتبر خضرة الرياض تجدها % % أثر اللطم في خدود الروابي % % 20(@)(@@) % حملوه على الرقاب ، وقد كا % % ن نداه أطواق تلك الرقاب % PageV01P538 21(@)(@@) % ما أظن المنون تعلم ماذا % % قصفت بعده من الأصلاب % 22(@)(@@) % يا رجيم الخطوب ، فاسترق السم % % ع ، فأفق العلى بغير شهاب % 23(@)(@@) % فليطل ، بعده على الدهر عتبي ، % رب ذم ملقب بعتاب % 24(@)(@@) % أيها الذاهب الذي عرض الأم % % وال والناس بعده للذهاب % 25(@)(@@) % طار لب السماح ، يوم توفي % % ت ، وشقت مرائر الآداب % 26(@)(@@) % وعلا في العلا عويل العوالي ، % ونحيب اليراع والقرضاب % 27(@)(@@) % لو يرد الردى بقوة بأس % لوقيناك في الأمور الصعاب % 28(@)(@@) % بأسود بيض الوجوه ، طوال ال % % باع ، شم الأنوف ، غلب الرقاب % 29(@)(@@) % تركوا اللهو للغواة ، وأفنوا % % عمرهم في كتائب ، أو كتاب % 30(@)(@@) % وجياد مثل العقارب نحو ال % % روع تسعى شوائل الأذناب % PageV01P539 31(@)(@@) % كل طرف مطهم ، سائل الغ % رة ، جعد الرسغين ، سبط الإهاب % 32(@)(@@) % كنت ذخرا لنا ، لو أن 
ms144	 المنا % % يا جنبت عن رفيع ذاك الجناب % 33(@)(@@) % لم أكن جازعا ، وأنت قريب ، % لبعاد الأهلين والأنساب % 34(@)(@@) % كان لي جودك العميم أنيسا % في انفرادي ، وموطنا في اغترابي % % 35(@)(@@) % ما بقائي من بعد فقدك ، إلا % كبقاء الرياض بعد السحاب % % PageV01P540 البحر : طويل 1(@)(@@) % عيون لها مرأى الأحبة إثمد ، % عجيب لها في عمرها كيف ترمد % 2(@)(@@) % وعين خلت من نور وجه حبيبها ، % عجبت لها ، من بعده ، كيف ترقد % 3(@)(@@) % ولي لمقلة قد أنكر الغمض جفنها ، % وعرفها صرف النوى كيف تسهد % 4(@)(@@) % تراعي النجوم السائرات ، كأنما % % تمثل فيهن المليك محمد % 5(@)(@@) % تحاوله بين النجوم ، لأنه % لرتبته فوق الكواكب مقعد % 6(@)(@@) % مليك ، لو أن الريح تشبه جوده ، % لما أوشكت يوما من الدهر تركد % 7(@)(@@) % مبدد شمل المال ، وهو مجمع ، % وجامع شمل الحمد ، وهو مبدد % 8(@)(@@) % فلا نمق الاعذار يوما لسائل ، % ولا قال للوفاد : موعدكم غد % 9(@)(@@) % دهته المنايا ، وهي من دون بأسه ، % كذا الصارم الصمصام يفنيه مبرد % 10(@)(@@) % فيا ملكا قد أطلق الجود ذكره ، % وكل نزيل من نداه مقيد % PageV01P541 11(@)(@@) % لقد كنت للوفاد وبلا ، وللعدى % % وبالا ، به تشقى أناس وتسعد % 12(@)(@@) % فكم أنشأت كفاك في المحل عارضا ، % وخد الثرى من عارض الخطب أمرد % 13(@)(@@) % وكم أرسلت يمناك في الحرب للعدى % % سحاب نكال بالصواهل يرعد % 14(@)(@@) % إذا ما ونى مسراه ثقلا يحثه % جواد وعضب : أجرد ومجرد % 15(@)(@@) % فينظم فيها الرمح ما السيف ناثر ، % وينثر فيها العضب ما اللدن ينضد % 16(@)(@@) % فمفردها من نثر سيفك توأم ، % وتوأمها من نظم رمحك مفرد % 17(@)(@@) % وفي معلك الآداب كم لك موقف ، % لأهل الحجى منه مقيم ومقعد % 18(@)(@@) % ولم يبق من آي المفاخر آية ، % ولا غاية ، إلا وعندك توجد % 19(@)(@@) % عليك سلام الله ، لا زال سرمدا % كجودك حتى بعد فقدك سرمد % 20(@)(@@) % فلو خلد المعروف قبلك ماجدا % لكنت بإسداء الجميل مخلد % PageV01P542 البحر : منسرح 1(@)(@@) % بكى عليك الحسام والقلم ، % وانفجع العلم فيك والعلم % 2(@)(@@) % وضجت الأرض ، فالعباد بها % % لاطمة ، والبلاد تلتطم % 3(@)(@@) % تظهر أحزانها على ملك ، % جل ملوك الورى له خدم % 4 
ms145	(@)(@@) % أبلج ، غض الشباب ، مقتبل العم % % ر ، ولكن مجده هرم % 5(@)(@@) % محكمق في الورى ، وآمله % يحكم في ماله ويحتكم % 6(@)(@@) % يجتمع المجد والثناء له ، % وماله ، في الوفود ، يقتسم % 8(@)(@@) % قد سئمت جوده الأنام ، ولا % % يلقاه ، من بذله الندى ، سأم % 9(@)(@@) % ما عرفت منه لا ، ولا نعم ، % بل دونهن الآلاء والنعم % 10(@)(@@) % الواهب الألف ، وهو مبتسم ، % والقاتل الألف ، وهو مقتحم % 11(@)(@@) % مبتسم والكماة عابسة ، % وعابس ، والسيوف تبتسم % PageV01P543 12(@)(@@) % يستصغر العضب أن يصول به % % إن لم تجرد من قبله الهمم % 13(@)(@@) % ويستخف القناة يحملها ، % كأنها في يمنه قلم % 14(@)(@@) % لم يعلم العالمون ما فقدوا % % منه ، ولا الأقربون ما عدموا % % 15(@)(@@) % ما فقد فرد من الأنام ، كمن % إن مات ماتت لفقده أمم % 16(@)(@@) % والناس كالعين إن نقدتهم ، % تفاوتت عند نقدك القيم % 17(@)(@@) % يا طالب الجود قد قضى عمر ، % فكل جود وجوده عدم % 18(@)(@@) % ويا منادي الندى ليدركه ! % أقصر ، ففي مسمع الندى صمم % 19(@)(@@) % مضى الذي كان للأنام أبا ، % فاليوم كل الأنام قد يتموا % % 20(@)(@@) % وسار فوق الرقاب مطرحا ، % وحوله الصافنات تزدحم % 21(@)(@@) % مقلبات السروج شاخصة ، % لها زفير ذابت به اللجم % PageV01P544 22(@)(@@) % وحل دارا ضاقت بساكنها ، % ودون أدنى دياره إرم % 23(@)(@@) % كأنه لم يطل إلى رتب ، % تقصر من دون نيلها الهمم % 24(@)(@@) % ولم يمهد للملك قاعدة % بها عيون العقول تحتلم % 25(@)(@@) % ولم تقبل له الملوك يدا % ترغب في سلمها ، فتستلم % 26(@)(@@) % ولم يقد للحروب أسد وغى ، % تسري بها من رماحها أجم % 27(@)(@@) % ولم يصل والخميس مرتكب % عبابه ، والعجاج مرتكم % 28(@)(@@) % أين الذي كان للورى سندا ، % ورحب أكنافه لها حرم % 29(@)(@@) % أين الذي إن سرى إلى بلد % لا ظلم يبقى به ، ولا ظلم % 30(@)(@@) % أين الذي يحفظ الذمام لنا % % إن خفرت عند غيره الذمم % 31(@)(@@) % يا ناصر الدين ، وابن ناصره ، % ومن به في الخطوب يعتصم % PageV01P545 32(@)(@@) % وصاحب الرتبة التي وطئت % لها على هامة السهى قدم % 33(@)(@@) % تثني عليك الورى ، وما شهدوا % % من السجايا إلا بما علموا % % 34(@)(@@) % يبكيك مألوفك التقى أسفا ، % وصاحباك العفاف والكرم % 35(@)(@@) % لم 
ms146	 يشق يوما بك الجليس ، ولا % % مس نداماك عندك الندم % 36(@)(@@) % أغنيتني بالوداد عن نسبي ، % كأنما الود بيننا رحم % 37(@)(@@) % لولا التسلي بمن تركت لنا % % ألم بي من تدلهي لمم % 38(@)(@@) % وفي بقاء السلطان تسلية % لكل قلب بالحزن يضطرم % 39(@)(@@) % الملك الصالح الذي ظهرت % منه السجايا ، وطابت الشيم % 40(@)(@@) % لا زال يغني الزمان في دعة ، % والذكر عال ، والملك منتظم % PageV01P546 البحر : بسيط تام 1(@)(@@) % يا ليت شعري ، وقد أودى بك القدر ، % بأي عذر إلى العلياء يعتذر % 2(@)(@@) % وكيف جار عليك الدهر معتديا ، % أما تعلم منك العدل يا عمر % 3(@)(@@) % يا ابن الملوك الألى كان الزمان لهم % % طوعا وأقبل صرف الدهر يأتمر % 4(@)(@@) % يا ناصر الدين ، يا من جود راحته % % بين الأنام على الأيام ينتصر % 5(@)(@@) % أنت الجواد الذي لولا مكارمه ، % لأصبح الجود عينا ما بها بصر % 6(@)(@@) % تعطي وتبسط بعد البذل معذرة ، % وعذر غيرك دون البذل يبتدر % 7(@)(@@) % فقت الملوك جميعا في عطا وسطا ، % فأنت كالبحر فيه النفع والضرر % 8(@)(@@) % وحزت أخلاق شمس الدين مكتسبا % والشمس مكتسب من نورها القمر % 9(@)(@@) % خاطرت في طلب العلياء مجتهدا % وما يخاطر إلا من له خطر % 10(@)(@@) % رفعت ذكرك بالإنعام منتجدا ، % به ، وغيرك بالأموال يفتخر % PageV01P547 11(@)(@@) % قد كان جودك لي عين الحياة إذا % % وردته ، وحواني ربعك الخضر % 12(@)(@@) % أعزز علي بأن أدعوك ذا أمل ، % فلا يجاب برفد منك ينهمر % 13(@)(@@) % وأن يحث إلى مغناك وفد ثنا ، % وليس منك به عين ولا أثر % 14(@)(@@) % طابت مراثيك لي بعد المديح ، ومن % % بعد السرور براني الحزن والفكر % 15(@)(@@) % كأن حزنك من أسمائه سقر ، % فذاك في القلب لا يبقي ، ولا يذر % 16(@)(@@) % سقى ضريحك صوب المزن منبجسا % حتى يدبج أقصى تربه الزهر % 17(@)(@@) % وكيف أسأل صوب المزن ري ثرى % % حللت فيه ، وفيه البحر والمطر % PageV01P548 البحر : وافر تام 1(@)(@@) % نفوس الصيد أثمان المعالي ، % إذا هزت معاطفها العوالي % % 2(@)(@@) % وأبدت أوجه البيض ابتساما ، % يطيل بكاء آجال الرجال % 3(@)(@@) % ومن عشق العلاء ، وخاف حتفا % غدا عند الكريهة ، وهو سالي % % 4(@)(@@) % ولم يحز العلى 
ms147	 إلا كمي ، % رحيب الصدر في ضيق المجال % 5(@)(@@) % تيقن أن طيب الذكر يبقى ، % وكل نعيم ملك في زوال % 6(@)(@@) % لذاك سمت بركن الدين نفس % تعلم ربها طلب الكمال % 7(@)(@@) % سمت فأرته حر الكر بردا ، % ويحموم المنية كالزلال % 8(@)(@@) % فألبس عرضه درعا حصينا ، % وصير جسمه غرض النبال % 9(@)(@@) % تبوأ جنة الفردوس دارا ، % وحل على الأرائك في ظلال % 10(@)(@@) % وخلف كل قلب في اشتغال ، % وكل لهيب صدر في اشتعال % PageV01P549 11(@)(@@) % بروحي من أذاب نواه روحي ، % وأفقد فقده عزي ومالي % % 12(@)(@@) % ولم أك قبل يوم رداه أدري % % بأن الترب برج للهلاك % 13(@)(@@) % وقالوا : قد أصبت ، فقلت : كلا ، % وما وقع النبال على الجبال % 14(@)(@@) % ولم أعلم بأن الرمس يمسي % % بموج الحرب من صدف اللآلي % % 15(@)(@@) % أيا صخرا احنان أدمت نوحي ، % فها أنا فيك خنساء الرجال % 16(@)(@@) % وفت لي فيك أحزاني ودمعي ، % وخان عليك صبري واحتمالي % % 17(@)(@@) % بذلت النفس في طلب المعالي ، % كبذلك للهى يوم النوال % 18(@)(@@) % تسابق للوغى قبل التنادي ، % كبذلك للهى يوم النوال % 19(@)(@@) % شددت القلب في حوض المنايا ، % ووبل النبل منحل العزالي % % 20(@)(@@) % لبست على ثياب الوشي قلبا ، % غنيت به عن الدرع المذال % PageV01P550 21(@)(@@) % تهز لملتقى الأعداء عطفا ، % يهز رطيبه مرح الدلال % 22(@)(@@) % فعشت ، وأنت ممدوح السجايا ، % ومت ، وأنت محمود الخلال % 23(@)(@@) % أركن الدين كم ركن مشيد % هددت بفقد ذياك الجمال % 24(@)(@@) % ربوعك بعد بهجتها طلول ، % وحاليها من الأنوار خال % 25(@)(@@) % تنوح لفقدك الجرد المذاكي ، % وتبكيك الصوارم والعوالي % % 26(@)(@@) % يحن إلى يمينك كل عضب ، % وتشتاق الأعنة للشمال % 27(@)(@@) % أتسلبك المنون ، وأنت طود ، % وترخصك الكماة ، وأنت غال % 28(@)(@@) % وتضعف عزمة البيض المواضي ، % وتقصر همة الأسل الطوال % 29(@)(@@) % ولم تحطم قناة في طعان ، % ولم تفلل صفاح في قتال % 30(@)(@@) % ولا اضطرمت جياد في طراد ، % ولا اعتركت رجال في مجال % PageV01P551 31(@)(@@) % ولا رفعوا بوقع الخيل نقعا ، % ولا نسج الغبار على الجلال % 32(@)(@@) % وتمسي اللاذخية في رقاد ، % توهم فعلها طيف الخيال % 33(@)(@@) % ولم تقلع لقلعتهم عروش ، % إذا استوت الأسافل والأعالي % % 34(@)(@@) % ولا وادي جهنم حين حلوا 
ms148	 % % به أمسى عليهم شر فال % 35(@)(@@) % سأبكي ما حييت ، ولست أنسى % % صنائعك الأواخر والأوالي % % 36(@)(@@) % ولو أني أبلغ فيك سؤلي ، % بكيتك بالصوارم والعوالي % % 37(@)(@@) % بكلذ مهند الحدين ماض % تدب به المنية كالنمال % 38(@)(@@) % يريك به ركام الموت موجا ، % وتمنعه الدماء من الصقال % 39(@)(@@) % وإسمر ناهز العشرين لدن ، % رديني المناسب ذي اعتدال % 40(@)(@@) % يضيء على أعاليه سنان % ضياء النار في طرف الذبال % PageV01P552 41(@)(@@) % وأشفي من دماء عداك نفسا ، % تنوط القول منها بالفعال % 42(@)(@@) % لعل الصالح السلطان يجلو % % بغرة وجهه ظلم الضلال % 43(@)(@@) % ويجريها من الشعبين قبا ، % إلى الهيجاء تسعى كالسعالي % % 44(@)(@@) % يحرضها الطراد على الأعادي ، % كأن الكر يذكرها المخالي % % 45(@)(@@) % عليها كل ماضي العزم ذمر ، % كمي في الجلاد وفي الجدال % 46(@)(@@) % ويشفي عند أخذ الثأر منهم % % نفوسا ليس تقنع بالمطال % 47(@)(@@) % وأعلم أن عزمته حسام ، % ولكن التفاضي كالصقال % PageV01P553 البحر : خفيف تام 1(@)(@@) % لو يرد الردى ببذل الأيادي ، % أبقت المكرمات كعب الإيادي % % 2(@)(@@) % ولأبقت فتى المهذب أيد % طوقت بالندى رقاب العباد % 3(@)(@@) % ولو أن الحمام يدفع بالبا % % س ، وبيض الظبى وحمر الصعاد % 4(@)(@@) % لحمته يوم الهياج حماة % ترعف البيض من نجيع الأعادي % % 5(@)(@@) % وكماة يظلها من وشيج ال % % خط غاب يسير بالآساد % 6(@)(@@) % بصفاح تخال موج المنايا ، % في صفا متنها عيون الجراد % 7(@)(@@) % كل صافي الفرند بالماء ر % يان ولكنه إلى الدم صادي % % 8(@)(@@) % غير أن الأيام بالخلق تجري % % لبلوغ الآجال جري الجياد % 9(@)(@@) % كيف ترجو المقام ، والخلق سفر ، % نحن ركب وحادث الدهر حادي % % 10(@)(@@) % أين رب السرير والحيرة البي % % ضاء ، أم أين رب ذات العماد % PageV01P554 11(@)(@@) % إن أسباب فاصلات المنايا % % قد أبادت فرعون ذا الأوتاد % 12(@)(@@) % ما اعتمادي على الزمان ، وقد أو % % دى بمولى عليه كان اعتمادي % % 13(@)(@@) % بمديد الظلال مقتضب الرا % % ي بسيط الندى طويل النجاد % 14(@)(@@) % مسرف في السماح يوهمه الجو % % د بأن الإقصاد في الإقتصاد % 15(@)(@@) % لم ترنح أعطافه نسمة الكب % ر ، ولا أقتاده عنان العناد % 16(@)(@@) % حاكم حكم المؤمل في الما % % ل ، وقاض قضى بحتف الأعادي % % 17 
ms149	(@)(@@) % وسرت منه سيرة العدل في النا % % س مسير الأرواح في الأجساد % 18(@)(@@) % شمس دين الله الذي ضبط الأح % % كام ضبط الأموال بالأعداد % 19(@)(@@) % رب حلم للبطش فيه كمون ، % كلظى النار كامنا في الزناد % 20(@)(@@) % سطوة تظمىء الرواة من الرع % % ب ، ونطق يروي النفوس الصوادي % % PageV01P555 21(@)(@@) % وانتقاد ، إذا جلت ظلمة اللف % % ظ كأن العدى فيه في جلاد % 22(@)(@@) % ذو يراع رطب المشافر يبس ال % % متن جم الضمير خلو الفؤاد % 23(@)(@@) % كنت فيها خلوا من الحساد % ن صبيا ، كمبضع الفصاد % 24(@)(@@) % فإذا ما جرى بحلبة طرس % ركض الرعب في قلوب الأعادي % % 25(@)(@@) % يطلق اللفظ في السجل فيأتي % % بالمعاني مقرونة في صفاد % 26(@)(@@) % ما رأينا من قبل مجراه خطا % ساطع النور في ظلام المداد % 27(@)(@@) % كل خط سواده في بياض ، % وتراه بياضه في السواد % 28(@)(@@) % أين خصب الأكناف في الزمن الما % % حل ، والسبط في السنين الجعاد % 29(@)(@@) % والجواد السهل اللقاء ، إذا ما % % كان سهل اللقاء غير جواد % 30(@)(@@) % سلبته الأيام غدرا ، وكانت % طوع كفيه في الأمور الشداد % PageV01P556 31(@)(@@) % وأصيبت لفقده ، فلهذا % % ألبست بعده ثياب حداد % 32(@)(@@) % كان عضدا للآملين ، فأمسى % % بنواه يفت في الأعضاد % 33(@)(@@) % كان زين الأولاد والمال إن زي % % ن سواه بالمال والأولاد % 34(@)(@@) % يا حساما ما خلت أن أديم ال % % أرض يمسي له من الأمجاد % 35(@)(@@) % كنت يوم الندى سريعا إلى الب % ر ، ويوم الردى أبي القياد % 36(@)(@@) % أي ناد للجود لم تك فيه % حاضرا بالندى ، وذكرك باد % 37(@)(@@) % أصبحت بعدك المكارم فقرا ، % والمعالي عواطل الأجياد % 38(@)(@@) % وتوفي السماح ، يوم توفي % % ت ، فهل كنتما على ميعاد % 39(@)(@@) % فعزيز على المكارم أن تخ % % فى ، وفي الناس طيب ذكرك باد % 40(@)(@@) % أو ينادى للمكرمات ، فلا يس % % بق منك الندى نداء المنادي % % PageV01P557 41(@)(@@) % رقدة ما نراك من قبلها ذق % ت عن المكرمات طعم رقاد % 42(@)(@@) % ما شهدنا من قبلها لك حالا % % 43(@)(@@) % أحسن اللهث عنك صبر المعالي ، % وعزاء الإنشاء والإنشاد % 44(@)(@@) % وأطال الله عمر مراثي % % ك فإني فيها حليف اجتهاد % 45(@)(@@) % وسقت قبرك 
ms150	 الغوادي ، وإن كا % % نت دموعي روائحا وغوادي % % 46(@)(@@) % فلعمري لقد عهدت إلى الدم % % ع ليغنيه عن دموع العهاد % PageV01P558 البحر : سريع 1(@)(@@) % ما دام جري الفلك الدائر ، % لم يبق من بر ولا فاجر % 2(@)(@@) % ما عطف الدهر على حاتم ، % كلا ، ولا قصر عن مادر % 3(@)(@@) % إن خيول الدهر إن طاردت % أتبعت الأول بالآخر % 4(@)(@@) % لا تحرصن منه على مورد ، % فعاية الوارد كالصادر % 5(@)(@@) % أبعد عبد الله بحر الندى % % لزلة الأيام من غافر % 6(@)(@@) % مجري الندى في الأرض حتى نهى % % بسيطها من بحره الوافر % 7(@)(@@) % ومخصب في بلد ماحل ، % وعادل في زمن جائر % 8(@)(@@) % ومن غدت سيرة إنعامه % تملأ سمع المثل السائر % 9(@)(@@) % أصبح دست الملك من بعده ، % خلوا بلا ناه ولا آمر % 10(@)(@@) % وأصبح العين بلا ناظر ، % كأنها العين بلا ناظر % PageV01P559 البحر : طويل 1(@)(@@) % هو الدهر مغرى بالكريم وسلبه ، % فإن كنت في شك بذاك فسل به % 2(@)(@@) % أرانا المعالي كيف ينهد ركنها ، % وكيف يغور البدر من بين شهبه % 3(@)(@@) % أبعد غياث الدين يطمع صرفه % بصرف خطاب الناس عن ذم خطبه % 4(@)(@@) % وتخطو إلى عبد الكريم خطوبه ، % ويطلب منا اليوم غفران ذنبه % 5(@)(@@) % سليل النبي المصطفى ، وابن عمه ، % ونجل الوصي الهاشمي لصلبه % 6(@)(@@) % فتى كان مثل الغيث يخشى وباله % ويرجى لطلاب الندى وبل سحبه % 7(@)(@@) % رقيق حواشي العيش في يوم سلمه ، % كثيف حواشي الجيش في يوم حربه % 8(@)(@@) % فلا يتقي الأسياف إلا بوجهه ، % ولا يلتقي الأضياف إلا بقلبه % 9(@)(@@) % ولا ينظر الأشياءض إلا بعقله ، % ولا يسمع الأنباء إلا بلبه % 10(@)(@@) % إذا جال في يوم الردى قيل من له ؟ % وإن جاد في يوم الندى قيل من به ؟ % PageV01P560 11(@)(@@) % أمن بعد ما تمت محاسن بدره ، % ودارت على كل الورى كاس حزنه % 12(@)(@@) % دهته المنايا ، وهي في حد سيفه ، % وصرف الليالي وهو من بعض حبه % 13(@)(@@) % كأن لم يقدها كالأجادل سربا ، % ويرفع قب الليل من نقع قبه % 14(@)(@@) % ولم يقرع الأسماع وقع خطابه ، % ولم يطرق الهيجاء موقع خطبه % 15(@)(@@) % ولا كان يوم الدست صاحب صدره 
ms151	 ، % وللجيش يوم الحرب مركز قطبه % 16(@)(@@) % أتعتزه الأعداء في يوم لهوه ، % فلا أتوه جحفلا يوم حربه % 17(@)(@@) % ولم أر قبل اليوم ليث عريكة ، % أذاقته طعم الموت عضة كلبه % 18(@)(@@) % ولو كان ما بين الصوارم والقنا ، % وفوق متون الخيل إدراك نحبه % 19(@)(@@) % لكان جميل الذكر عن حسن فعله ، % ينفس عن قلبش الفتى بعض كربه % 20(@)(@@) % أبي قياد النفس آثر حتفه ، % ولم يبد يوما للعدى لين جنبه % PageV01P561 21(@)(@@) % كأن بني عبد الحميد لفقده ، % ذرى جبل هدت جلامد هضبه % 22(@)(@@) % أتسلبه الأعداء من بين رهطه ، % وتغتاله الأيام من دون صحبه % 23(@)(@@) % وتفقده في دولة ظاهرية % بها الذئب يعدو رائعا بين سربه % 24(@)(@@) % بدولة ملك يغصب الليث قوته ، % ويقتل من يلقاه شدة رعبه % 25(@)(@@) % فلو كان شمس الحق والدين شاهدا % لمصرع ذاك الندب ساعة ندبه % 26(@)(@@) % بكاه بأطراف الأسنة والظبى ، % بدمع من اللبات مسقط سكبه % 27(@)(@@) % وشن على عرب العذارين غارة % يضيق بها في البر واسع رحبه % 28(@)(@@) % فتعجب لبات الكماة بطعنه ، % ويعرب هامات الحماة بضربه % 29(@)(@@) % فلا نقط إلا من سنان قناته ، % ولا شكل إلا من مضارب عضبه % 30(@)(@@) % أبا الحرب بادر واتخذها صنيعة ، % تبدل مر القول فيكم بعذبه % PageV01P562 31(@)(@@) % فكم لغياث الدين من حق منة % تطوق بالإنعام أعناق صحبه % 33(@)(@@) % قضى نحبه ، والذكر منه مخلد % بأفواهنا لم يقض يوما لنحبه % 34(@)(@@) % ومذ رجعت أترابه من وداعه ، % تلقاه في أكفانه عفو ربه % 35(@)(@@) % سقى قبره من صيب المزن وابل ، % يجر على أرجائه ذيل خصبه % 36(@)(@@) % ومن عجب أن السحاب بقبره ، % وأسأل من صوب الحيا ري ربه % PageV01P563 البحر : بسيط تام 1(@)(@@) % حبل المنى بحبال اليأس معقود ، % والأمن من حادث الأيام مفقود % 2(@)(@@) % والمرء ما بين أشراك الردى غرض % صميمه بسهام الحتف مقصود % 3(@)(@@) % لا تعجبن ، فما في الموت من عجب ، % إذ ذاك حد به الإنسان محدود % 4(@)(@@) % فالمستفاد من الأيام مرتجع ، % والمستعار من الأعمار مردود % 5(@)(@@) % وللمنية أظفار ، إذا ظفرت ، % رأيت كل عميد وهو معمود % 6(@)(@@) % لم ينج بالبأس منها ، مع شراسته ، % ليث العرين 
ms152	 ، ولا بالحيلة السيد % 7(@)(@@) % قد ضل من ظن بعض الكائنات لها % % مكث ، وللعالم العلوي تخليد % 8(@)(@@) % ألم يقولوا بأن الشهب خالدة % طبعا ، فأين شهاب الدين محمود % 9(@)(@@) % من كان في علمه بين الورى علما % يهدى به إن زوت أعلامها البيد % 10(@)(@@) % ومن روت فضله حساد رتبته ، % وعنعنت عن أياديه الأسانيد % PageV01P564 11(@)(@@) % فضل به أوجه الأيام مشرقة ، % كأنه لحدود الدهر توريد % 12(@)(@@) % مهذب اللفظ لا في القول لجلجة % منه ، ولا عنده في الرأي ترديد % 13(@)(@@) % لا يهدم المن منه عمر مكرمة ، % ولايعمد بالمطل المواعيد % 14(@)(@@) % إن كان يقصد مقصود لبذل ندى % % فإنه للندى والفضل مقصود % 15(@)(@@) % له اليراع الذي راغ الخطوب به % في حلبة الطرس تصويب وتصعيد % 16(@)(@@) % أصم أخرس مشقوق اللسان ، إذا % % طارحتهث سمعت منه الأغاريد % 17(@)(@@) % إن شاء تسويد مبيض الطروس فمن % % إنشائه لبياض الناس تسويد % 18(@)(@@) % لو خط سطرا ترى عكس القياس به : % الشمس طالعة ، والليل الأناشيد % 19(@)(@@) % رشيقة السبك لا المعنى بمبتذل % منها ولا لفظها بالعسف مكدود % 20(@)(@@) % يا صاحب الرتبة المعذور حاسدها ؛ % إن السعيد على النعماء محسود % PageV01P565 21(@)(@@) % ما شام بعدك أهل الشام بارقة % للفضل حين ذوى من ربه العود % 22(@)(@@) % إليك قد كان يعزى العلم منتسبا ، % واليوم فيك يعزى العلم والجود % 23(@)(@@) % كماخطبة لك راع الخطب موقعها ، % وكم تقلد منه ، الدهر ، تقليد % 24(@)(@@) % ولفظة لا يسد الغير موضعها ، % غراء تحسب ماء ، وهي جلمود % 25(@)(@@) % وجحفل لجدال البحث مجتمع ، % كأنه لجلاد الحرب محشود % 26(@)(@@) % قد جرد الشوس فيه قضب ألسنة ، % في معرك يومه المشهور مشهود % 27(@)(@@) % بصارم لا يرد الدرع ضربته ، % ولو سنى نسجه المردود داود % 28(@)(@@) % حتى إذا نكص القوم الكمي به ، % وأعوزت عند دعواه الأسانيد % 29(@)(@@) % ألقوا مقاليدهم فيه إلى بطل % شهم ، إلى مثله تلقى المقاليد % 30(@)(@@) % يا مفقدي مع وجودي فيض أنعمه % همي وموجود وجدي وهو مفقود % PageV01P566 31(@)(@@) % وجاعل الفضل فيما بيننا نسبا ، % إذ كان في نسب الآباء تبعيد % 32(@)(@@) % قد كان يجدي التناسي عنك دفع أسى ، % لو أن مثلك في المصرين موجود 
ms153	 % 33(@)(@@) % قد أخلقت ثوب صبري فيك حادثة % أضحى بها لثياب الحزن تجديد % 34(@)(@@) % برغم أنفي أن يدعوك ذو أمل ، % فلا يسح عهاد منك معهود % 35(@)(@@) % وأن يرى ربعك العافي ، وليس به % % مرعى خصيب ، وظل منك ممدود % 36(@)(@@) % أبكي ، إذا ما خلا أوصاف مجدك لي ، % فكري وأطلب صبري ، وهو مطرود % 37(@)(@@) % وألتجي بالتسلي أن ستخلفها % % أبناؤك الغر أو أبناؤك الصيد % 38(@)(@@) % فسوف ترثيك مني كل قافية ، % بها لذكرك بين الناس تخليد % 39(@)(@@) % وأسمع الناس أوصافا عرفت بها ، % حتى كأنك في الأحياء معدود % 40(@)(@@) % فلا عدا الغيث تربا أنت ساكنه ، % مع علمنا أن فيه الغيث ملحود % PageV01P567 41(@)(@@) % ودام ، والظل ممدود بساحته ، % والسدر والطلع محصور ومنضود % PageV01P568 البحر : بسيط تام 1(@)(@@) % كان الزمان بلقياكم يمنينا ، % وحادث الدهر بالتفريق يثنينا % % 2(@)(@@) % فعندما صدقت فيكم أمانينا ، % أضحى التنائي بديلا من تدانينا % % 3(@)(@@) % وناب عن طيب لقيانا تجافينا % % 4(@)(@@) % خلنا الزمان بلقياكم يسامحنا % % لكي تزان بذكراكم مدائحنا % % 5(@)(@@) % فعندما سمحت فيكم قرائحنا % % بنتم وبنا فما ابتلت جوانحنا % % 6(@)(@@) % شوقا إليكم ولا جفت مآقينا % % 7(@)(@@) % لم يرضنا أن دعا بالبين طائرنا ، % شق الجيوب ، وما شقت مرائرنا % % 8(@)(@@) % يا غائبين ومأواهم سرائرنا ، % تكاد حين تناجيكم ضمائرنا % % 9(@)(@@) % يقضي علينا الأسى لولا تأسينا % % 10(@)(@@) % حمدت أيام أنس لي بكم سعدت ، % وأسعدت إذ وفت فيكم بما وعدت % PageV01P569 11(@)(@@) % فاليوم إذ غبتم ، والدار قد بعدت ، % حالت لفقدكم أيامنا فغدت % 12(@)(@@) % سودا ، وكانت بكم بيضا ليالينا % % 13(@)(@@) % فزنا بنيل الأماني من تشرفنا ، % بقربكم ، إذا برينا من تكلفنا % % 14(@)(@@) % حتى كأن الليالي في تصرفنا ، % إذا جانب العيش طلق من تألفنا % % 15(@)(@@) % ومورد اللهو صاف من تصافينا % % 16(@)(@@) % كم قد وردنا مياه العز صافية ، % وكم عللنا بها الأرواح ثانية % 17(@)(@@) % إذ عينها لم تكن بالمن آنية ، % وإذ هصرنا غصون الأنس دانية % 18(@)(@@) % قطوفها ، فجنينا منه ماشينا % % 19(@)(@@) % يا سادة كان مغناهم لنا حرما ، % وكان ربع حماة للنزيل حمى % % 20(@)(@@) % كم قد سقيتم مياه الجود رب ظما % % ليسق عهدكم عهد الغمام فما % % PageV01P570 21(@)(@@) % كنتم لأرواحنا إلا 
ms154	 رياحينا % % 22(@)(@@) % هل يعلم المسكرونا من سماحهم % برشف راح الندى من كأس راحهم % 23(@)(@@) % أنا لبسنا الضنا بعد التماحهم ، % من مبلغ الملبسينا بانتزاحهم % 24(@)(@@) % ثوبا من الحزن لا يبلي ويبلينا % % 25(@)(@@) % إذا ذكرنا زمانا كان يدركنا ، % بالقرب منكم ، وفي اللذات يشركنا % % 26(@)(@@) % لا نملك الدمع والأحزان تملكنا ؛ % إن الزمان الذي قد كان يضحكنا % % 27(@)(@@) % آنا بقربكم قد صار يبكينا % % 28(@)(@@) % نعى المؤيد قوم لودروا ووعوا ، % أي الملوك إلى أي الكرام نعوا % % 29(@)(@@) % أظنه ، إذ سقانا الود حين سعوا ، % غيظ العدى من تساقينا الهوى فدعوا % % 30(@)(@@) % بأن نغص ، فقال الدهر آمينا % % PageV01P571 31(@)(@@) % لما رأوا ما قضينا من مجالسنا ، % وسبط أنس رأينا من مجالسنا % % 32(@)(@@) % دعوا لنفجع في الدنيا بأنفسنا ، % فانحل ما كان معقودا بأنفسنا % % 33(@)(@@) % وانبت ما كان موصولا بأيدينا % % 34(@)(@@) % أين الذين عهدنا الجود يوثقنا % % في ربعهم ، ولهم بالشكر ينطقنا % % 35(@)(@@) % وكان فيهم بهم منهم تأنقنا ، % وقد نكون وما يخشى تفرقنا % % 36(@)(@@) % فاليوم نحن ، وما يرجى تلاقينا % % 37(@)(@@) % يا غائبين ، ولا تخلو خواطرنا % % من شخصهم وإن اشتاقت نواظرنا % % 38(@)(@@) % والله لا ينقضي فيكم تفكرنا ، % لا تحسبوا نأيكم عنا يغيرنا % % 39(@)(@@) % إن طال ما غير النأي المحبينا % % 40(@)(@@) % إنا ، وإن زادنا تفريقنا غللا ، % إلى اللقا ، وكسانا بعدكم عللا % PageV01P572 41(@)(@@) % لم ندع غيركم سؤلا ، ولا أملا ، % والله ما طلبت أرواحنا بدلا % 42(@)(@@) % منكم ، ولا انصرفت عنكم أمانينا % % 43(@)(@@) % إذا ذكرت حمى العاصي وملعبه ، % والقصر والقبة العليا بمرقبه % 44(@)(@@) % أقول ، والبرق سار في تلهبه : % يا ساري البرق غادي القصر فاسق به % 45(@)(@@) % من كان صرف الهوى والود يسقينا % % 46(@)(@@) % يا غادي المزن إن وافيت حلتنا % % على حماة ، فجد فيها محلتنا % % 47(@)(@@) % واقر السلام بها عنا احبتنا ، % ويا نسيمض الصبا بلغ تحيتنا % % 48(@)(@@) % من لو على البعد متنا كان يحيينا % % 49(@)(@@) % سلطان عصر إله العرش بوأه % من المعالي ، وللخيرات هيأه % 50(@)(@@) % براه زينا ، ومما شان برأه ، % ربيب ملك كأن الله أنشأه % PageV01P573 51(@)(@@) % مسكا ، وقدر إنشاء الورى طينا % % 52(@)(@@) % نحن الفداء لمن أبقى لنا خلفا 
ms155	 ، % من ذكره ، وإن ازددنا به أسفا % 53(@)(@@) % وإن نكن دون أن يفدى بنا أنفا ، % ما ضر إن لم نكن أكفاءه شرفا % 54(@)(@@) % وفي المودة كاف من تكافينا % % 55(@)(@@) % يا من يرى مغنم الأموال مغرمة % إن لم يفد طالبي جدواه مكرمة % 56(@)(@@) % إنا ، وإن حزت ألقابا مكرمة ، % لسنا نسميك إجلالا وتكرمة % 57(@)(@@) % وقدرك المعتلي عن ذاك يغنينا % % 58(@)(@@) % كم قد وصفت بأوصاف مشرفة ، % في خط ذي قلم أو نطق ذي شفة % 59(@)(@@) % فقد عرفناك منها أي معرفة ، % إذا انفردت وما شوركت في صفة % 60(@)(@@) % فحسبنا الوصف إيضاحا وتبيينا % % PageV01P574 61(@)(@@) % خلفت بعدك للدنيا وآملها % % نجلا يسر البرايا في تأملها % % 62(@)(@@) % فلم تقل عنك نفس في تململها : % يا جنة الخلد أبدلنا بسلسلها % % 63(@)(@@) % والكوثر العذب زقوما وغسلينا % % 64(@)(@@) % كم خلوة هزنا للبحث باعثنا ، % فليس يؤنسنا إلاذ مباحثنا % % 65(@)(@@) % فاليوم أخرس بالتفريق نافثنا ، % كأننا لم نبت ، والوصل ثالثنا % % 66(@)(@@) % والدهر قد غض من أجفان واشينا % % 67(@)(@@) % وليلة قد حلا فيها تنادمنا ، % والعز يكنفنا ، والسعد يقدمنا % % 68(@)(@@) % ونحن في خلوة ، والدهر يخدمنا ، % سرين في خاطر الظلماء يكتمنا % % 69(@)(@@) % حتى يكاد لسان الصبح يفشينا % % 70(@)(@@) % لله كم قد قضينا منكم وطرا ، % قد كان عينا فأمسى بعدكم خبرا % % PageV01P575 71(@)(@@) % لا تعجبوا إن جعلنا ذكركم سمرا ، % إنا قرأنا الأسى يوم النوى سورا % 72(@)(@@) % متلوة ، واتخذنا الصبر تلقينا % % 73(@)(@@) % كم من حبيب عدلنا مع ترحله ، % إلى سواه ، فأغنى عن تأمله % % 74(@)(@@) % وصعب ورد عدلناه بأسهله ، % أما هواك ، فلم يعدل بمنهله % 75(@)(@@) % شربا وإن كان يروينا ، فيظمينا % % 76(@)(@@) % تشكو إلى الله نفس بع ما لقيت % غب النعيم الذي من بعده شقيت % 77(@)(@@) % فيا سحابا به كل الورى سقيت : % عليك منى سلام الله ما بقيت % 78(@)(@@) % صبابة منك تخفيها وتخفينا % % PageV01P576 البحر : طويل 1(@)(@@) % بكيت دما لو كان سكب الدما يغني ، % وضاعفت حزني لو شفى كمدا حزني % % 2(@)(@@) % وأعرضت عن طيب الهناء لأنني % % نقمت الرضى حتى على ضاحك المزن % 3(@)(@@) % أرى العيش في الدنيا كاحلام نائم ، % فلذاتها تفنى ، وأحداثها تفني % % 4(@)(@@) % فمن 
ms156	 حادث جم صفقت له يدي ، % ومن فادح صعب قرعت له سني % % 5(@)(@@) % أفي الست والعشرين أفقد ستة ، % جبالا غدت من عاصف الموت كالعهن % 6(@)(@@) % فقدت ابن عمي وابن عمي وصاحبي ، % وأكبر غلماني بها ، وأخي ، وابني % % 7(@)(@@) % متى تخلف الأيام كابن محمد % ونجل سرايا بعده ، وفتى الركن % 8(@)(@@) % رجالا لو ان الشامخات تساقطت % عليهم ، لكان القلب من ذاك في أمن % 9(@)(@@) % فجعت بندب كان يملأ ناظري ، % فأصبح ناعي نديه مالئا أذني % % 10(@)(@@) % عفيف نواحي الصدر ، من طي ريبة ، % سليم ضمير القلب من دنس الضغن % PageV01P577 11(@)(@@) % قريب إلى المعروف والخير والتقى ، % بعيد عن الفحشاء والإفك والأفن % 12(@)(@@) % جبان عن الفحشا ، شحيح بعرضه ، % إذا عيب بعض الناس بالشح والجبن % 13(@)(@@) % ومن أتعب اللوام في بذل بره ، % فلائمه يثني ، وآمله يثني % % 14(@)(@@) % مضى طاهر الأثواب والنفس والخطى ، % عفيف مناط الذيل والجيب والردن % 15(@)(@@) % ولم يبق من تذكاره غير زفرة ، % تفرق بين النوم ، في الليل ، والجفن % 16(@)(@@) % ولو سلبته الحرب مني لشاهدت % كما شاهدت في ثار أخواله مني % % 17(@)(@@) % وأبكيت أجفان الصوارم والقنا % % نجيعا ، غداة الكر في الضرب والطعن % 18(@)(@@) % فيا ابن أبي والأم ، قد كنت لي أبا % حنوا ، ولكن في الإطاعة لي كابني % % 19(@)(@@) % ليهنك أن الدمع بعدك مطلق ، % لفرط الأسى ، والقلب بالهم في سجن % 20(@)(@@) % جعلت جبال الصبر بالحزن صفصفا ، % وصيرت أطواد التجلد كالعهن % PageV01P578 21(@)(@@) % وحاولت نظم الشعر فيك مراثيا ، % فأرتج حتى كدت أخطىء في الوزن % 22(@)(@@) % بنيت على أن أتقي بك شدتي ، % ولم أدر أن الذهر ينقض ما أبني % % 23(@)(@@) % وبلغت ما أملت فيك سوى البقا ، % وما رمته إلا الوقوف على الدفن % 24(@)(@@) % سبقت إلى الزلفى ، وما من مزية % من الفضل إلا كنت أولى بها مني % % 25(@)(@@) % خلفت أباك الندب في كل خلة % من المجد ، حتى كدت عنه لنا تغني % % 26(@)(@@) % سرايا خصال من سرايا ورثتها ، % على أن هذا الورد من ذلك الغصن % 27(@)(@@) % جزاك الذي يممت سعيا لبيته ، % وأعلم أن الحزن والموت واحد % 28(@)(@@) % ووفاك من لم تنس في الدهر ذكره 
ms157	 % % شفاعته ، والناس في الحشر كاللكن % 29(@)(@@) % فقد كنت تحيي الليل بالذكر ضارعا % إلى الله ، حتى صرت بالنسك كالشن % 30(@)(@@) % فيؤنسني ترتيب نفلك في الضحى ، % ويطربني ترتيل وردك في الوهن % PageV01P579 31(@)(@@) % أمنت صروف الدهر بعدك والأذى ، % فمن ذا رأى من صار بالخوف في أمن % 32(@)(@@) % سأبكيك بالعز الذي كنت ملبسي ، % لديك ، وثقل كنت تحمله عني % % 33(@)(@@) % % عليذ ، فذا يضني القلوب ، وذا يفني % % 34(@)(@@) % فإن كان عمر البين قد طال بيننا ، % كما طال في آناء مدته حزني % % 35(@)(@@) % فحبك في قلبي ، وذكرك في فمي ، % وشخصك في عيني ، ولفظك في أذني % % PageV01P580 البحر : منسرح 1(@)(@@) % لا عبد يغني عنه ولا ولد ، % ما كل عبد عليه يعتمد % 2(@)(@@) % ولا سليل يسره تلفي ، % كناضح في رضاي يجتهد % 3(@)(@@) % ذا يتمنى فقدي لكي يجد ال % % مال ، وهذا لحزنه يجد % 4(@)(@@) % ربيب بيتي ، بل رب نعمته ، % ومن به في الأمور أعتضد % 5(@)(@@) % يسعى لنفعي بالطبع منه ، ولا % % يقصر في فعله ويضطهد % 6(@)(@@) % قد يقطع الصارم المهند بالطب % % ع ويمضي برغمه الوتد % 7(@)(@@) % وهو القوي الأمين إن عرضت % لي أزمة كان منه لي مدد % 8(@)(@@) % منظره صالح ، ومخبره ، % فالبدر في بردتيه ، والأسد % 9(@)(@@) % كان لسانا لي ناطقا ، ويدا % طولى ، وظهرا إليه أستند % 10(@)(@@) % لم تك لي دار مية عرضا ، % إذ لي منه العلياء والسند % PageV01P581 11(@)(@@) % كفلته يافعا ، فكنت له % كالوالد البر ، وهو لي ولد % 12(@)(@@) % معتقدا فيه ماتحقق لي % % من وده وهو فيذ معتقد % 13(@)(@@) % فقدته ، فارتضيت همته ، % والناس مثل النضار تنتقد % 14(@)(@@) % وظلت أغذوه بالعلوم ، وما % % يزينه ، وهو فيه مجتهد % 15(@)(@@) % فجاء مستعذب الخلائق واللف % % ظ ، ومصباح فهمه يقد % 16(@)(@@) % مهذب اللفظ ، ما بمنطقه % زيغ ، ولا في خلاله أود % 17(@)(@@) % يعرب ألفاظه ، فينفث في % % سحر المعاني ، وما بها عقد % 18(@)(@@) % إن خط طرسا ، فالدر منتظم ، % أو قال لفظا ، فجوهر بدد % 19(@)(@@) % لله قلب رثت علائقه % % به ، وأثواب حزنه جدد % 20(@)(@@) % قطعت من غيره الرجاء فما % % وجدت مثلا له ، ولا أجد % PageV01P582 البحر : كامل تام 1(@)(@@) % أصفيح ماء أم أديم 
ms158	 سماء ، % فيه تغور كواكب الجوزاء ؟ % 2(@)(@@) % ما كنت أعلم قبل موتك موقنا % أن البدور غروبها في الماء % 3(@)(@@) % ولقد عجبت ، وقد هويت بلجة ، % فجرى على رسل بغير حياء % 4(@)(@@) % لو لم يشق لك العباب ، وطالما % % أشبهت موسى باليد البيضاء % 5(@)(@@) % أنف العلاء عليك من لمس الثرى % % وحلول باطن حفرة طلماء % 6(@)(@@) % وأجل جسمك أن يغير لطفه % % عفن الثرى وتكاثف الأرجاء % 7(@)(@@) % فأحله جدثا طهورا مشبها % أخلاقه في رقة وصفاء % 8(@)(@@) % ما ذاك بدعا أن يضم صفاؤه % نورا يضن به على الغبراء % 9(@)(@@) % فالبحر أولى في القياس من الثرى ، % بجوار تلك الدرة الغراء % 10(@)(@@) % يا مالكي ! إني عليك متيم ؛ % يا صخر ! ني فيك كالخنساء % PageV01P583 11(@)(@@) % ولقد ألوذ بكنز صبري طالبا % حسن العزاء ، ولات حين عزاء % 12(@)(@@) % وأعاف شرب الماء يطفح لجه ، % فأصد عنه ، وأنثني بظماء % 13(@)(@@) % وغذا رأيت مدامعي مبيضة % مثل المياه مزجتها بدماء % 14(@)(@@) % لا يطمع العذال حسن تجلدي ، % فلذاك خوف شماتة الأعداء % 15(@)(@@) % فلئن خفضت لهم جناح تحملي ، % فالقلب منصوب على الإغراء % PageV01P584 البحر : خفيف تام 1(@)(@@) % لو أفادتنا العزائم حالا ، % لم نجد حسن العزاء محالا % % 2(@)(@@) % كيف يولي العزم صبرا جميلا % حين وارى الترب ذاك الجمالا % % 3(@)(@@) % ما ظننا أن ريح المنايا % % تنسف الطود ، وتردي الجبالا % % 4(@)(@@) % جار صرف الدهر فينا بعدل % لم نجد للقول فيه مؤالا % % 5(@)(@@) % أفما تنفك أيدي المنايا % % تسلب المال ، وتفني الرجالا % % 6(@)(@@) % فإذا أبدى لها المرء سلما ، % جردت عضبا ، وراشت نبالا % % 7(@)(@@) % كلما رمنا نمو هلال % غيبت بدرا أصاب الكمالا % % 8(@)(@@) % فإذا ما قلت قد زال حزن ، % أبدلت أحداثها اللام دالا % % 9(@)(@@) % كيف دكت طود حلم نداه ، % سبق الوعد ، وأفنى السؤالا % % 10(@)(@@) % كيف كف الدهر كفا كريما % ليمين الدهر كانت شمالا % % PageV01P585 11(@)(@@) % ثمل من نشوة الجود أضحى % % لليتامى والأيامى ثمالا % % 12(@)(@@) % نعم لسائليه جواب ، % لم يصل يوما إلى لن ولا لا % % 13(@)(@@) % دوحة من عرق آل وشاح ، % قد دنت للطالبين منالا % % 14(@)(@@) % قد رست أصلا وطابت ثمارا ، % وزكت فرعا ومدت ظلالا % % 15(@)(@@) % أزعج النادي 
ms159	 بنجواه ناع ، % كم نفوس في دموع أسالا % % 16(@)(@@) % فسمعنا منه ندبا لندب % أبعد الصبر ، وأدنى الخيالا % % 17(@)(@@) % بات يهدي للقلوب اشتغالا % % ولنيران الهموم اشتعالا % % 18(@)(@@) % قد مررنا في مغانيه ركبا ؛ % وغوادي الدمع تجري انهمالا % % 19(@)(@@) % وسألنا النار عنه ، فقالت : % كان تاج الدين ركنا ، فزالا % % 20(@)(@@) % كان وبلا للعفاة هتونا ، % ولأحزاب العداة وبالا % % PageV01P586 21(@)(@@) % كان تاج الدين للدهر تاجا ، % زاد هام الدهر منه جمالا % % 22(@)(@@) % كان زلزالا لباغ عصاه ، % ولباغي الرفد منه زلالا % % 23(@)(@@) % كان للأعداء ذلا وبؤسا ، % ولراجي الجود عزا ومالا % % 24(@)(@@) % كان للناس جميعا كفيلا ، % فكأن الخلق كانوا عيالا % % 25(@)(@@) % راع أحزاب العدى بيراع ، % طالما أنشأ السحاب الثقالا % % 26(@)(@@) % ناحل الجسم قصير دقيق % دق في الحرب الرماح الطوالا % % 27(@)(@@) % يجعل النوم عليهم حراما ، % كلما أبرز سحرا حلالا % % 28(@)(@@) % فإذا ما خط اسود نقش % خلته في وجنة الدهر خالا % % 29(@)(@@) % يا كريما طاب أصلا وفرعا ، % وسما أما وعما وخالا % % 30(@)(@@) % وخليلا مذ شربت وفاه % لم أرد نبعا به أو خلالا % % PageV01P587 31(@)(@@) % وإذا ما فهت باسم أبيه ، % كان للميثاق والعهد فالا % % 32(@)(@@) % إن أسأنا لم يرعنا بلوم ، % وإذا لمناه أبدى احتمالا % % 33(@)(@@) % كان عصر الأنس منك رقادا ، % ولذيذ العيش فيه خيالا % % 34(@)(@@) % من لدست الحكم بعدك قاض % لم يمل يوما إذا الدهر مالا % % 35(@)(@@) % من لإصلاح الرعايا ، إذا ما % % أفسدت منها يد الدهر حالا % % 36(@)(@@) % من لإطفاء الحروب ، إذا ما % % صار آل المرء بالكر آلا % % 37(@)(@@) % وإذا صار الجدال جلادا ، % أخمد الحرب ، وأفنى الجدالا % % 38(@)(@@) % رب يوم معرك الحرب فيه % حطم السمر وفل النصالا % % 39(@)(@@) % ذكر الأحقاد فيه رجال ، % حبب الطعن إليها النزالا % % 40(@)(@@) % في مكر واسع الهول ضنك ، % لا يطيق الطرف فيه مجالا % % PageV01P588 41(@)(@@) % ألبس الجو العجاج لثاما ، % وكسا الخيل الغبار جلالا % % 42(@)(@@) % شمت في إصلاحهم عضب عزم % فيهما ، إن جار دهر ومالا % % 43(@)(@@) % بك كف الله كف الرزايا ، % وكفى الله الأنام القتالا % % 44(@)(@@) % فلئن وارتك أرض ، فها قد % % سار منك الذكر فيها وجالا % % 45(@)(@@) % لم يمت من طاب ذكرا 
ms160	 ، وأبقى % % بعده شبها له أو مثالا % % 46(@)(@@) % أسد خلف شبلي عرين % شيدا مجدا له لن ينالا % % 47(@)(@@) % ظل زين الدين للدهر زينا ، % وجمال الدين فيه جمالا % % 48(@)(@@) % فأرانا الله أقصى الأماني % % فيهما ، إن جاء دهر ومالا % % 49(@)(@@) % وحباك الله في الخلد روحا ، % ونعيما خالدا لن يزالا % % PageV01P589 البحر : طويل 1(@)(@@) % صروف الليالي لا يدوم لها عهد ، % وأيدي المنايا لا يطاق لها رد % 2(@)(@@) % تسالمنا سهوا ، وتسطو تعمدا ، % فإسعافها عسف ، وإقصادها قصد % 3(@)(@@) % عجبت لمن يغتر فيها لجنة % من العيش ما فيها سلام ولا برد % 4(@)(@@) % أفي كل يوم للنوائب غارة % يشق عليها الجيب أو يلطم الخد % 5(@)(@@) % أرى كل مألوف يعجل فقده ، % فما بال فقد الإلف ليس له فقد % 6(@)(@@) % فقدت رجالا كان في البؤس بأسهم ، % هو الظهر لي والباع واليد والزند % 7(@)(@@) % يزيدهم ليل الخطوب ، إذا دجا ، % ضياء وحسن الضد يظهره الضد % 8(@)(@@) % أرى كل من يستخلص الشكر بعدهم % % من الناس نحرا لا يليق به عقد % 9(@)(@@) % لذاك هجرت الإلف أعلم أنني % % لك السيف لا يبليه ، إن بلي ، الغمد % 10(@)(@@) % وزرت بلادا ينبت العز أرضها ، % وينجح في أبناء أبياتها العقد % PageV01P590 11(@)(@@) % مخافة أن أضحي من الخل خاليا ، % وحيدا ، وأمسي عند من ما له عند % 12(@)(@@) % ولما عطفت العيس ، آخر رحلة ، % إلى معهد لي ، والحبيب به عهد % 13(@)(@@) % وشارفت أعلام الطويلة ذاكرا % عهود الصبا ، والشيب لما يلح بعد % 14(@)(@@) % سألت حمى الفيحاء : ما بال ربعها % % جديبا ، وقد كانت نضارته تبدو % % 15(@)(@@) % وما بالها لم يرو من مائها الصدى % % لظام ، ولا يوري لقاصدها زند % 16(@)(@@) % فقالت : قضى من كان بالسعد لي قضى ، % وصوح نبت العز وانهدم المجد % 17(@)(@@) % فأصبح مجد الدين في الترب ثاويا ، % وزال السماح السبط والرجل الجعد % 18(@)(@@) % فتى علمته غاية الزهد نفسه ، % فأصبح حتى في الحياة له زهد % 19(@)(@@) % ولم أر بدرا قبله حازه الثرى ، % ولم أر بحرا قبله ضمه اللحد % 20(@)(@@) % سليل صفي المصطفى ، وابن سبطه ، % لقد طاب منه الأم والأب والجد % PageV01P591 21(@)(@@) % فصيح ، إذا الخصم الألد تعالمت 