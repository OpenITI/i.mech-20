ms418	 رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3970 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأواخر من رمضان في تاسعة تبقى وفي سابعة تبقى وفي خامسة تبقى ) )(@)(@@) ( حم خ د ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 3971 ) قال النبي :(@)(@@) | 30 ( التمسوها في العشر الأواخر من رمضان والتمسوها في التاسعة والسابعة والخامسة ) )(@)(@@) ( د ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3972 ) قال النبي :(@)(@@) | 30 ( ألح رجل بيا أرحم الراحمين فنودي أن قد سمعتك فما حاجتك ؟ ) )(@)(@@) ( أبو الشيخ في الثواب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3973 ) قال النبي :(@)(@@) | 30 ( ألحد آدم وغسل بالماء وترا ، فقالت الملائكة هاذه سنة ولد آدم من بعده ) )(@)(@@) ( ابن عساكر ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3974 ) قال النبي :(@)(@@) | 30 ( ألحدوا ولا تشقوا فإن اللحد لنا والشق لغيرنا ) )(@)(@@) ( حم ) عن جرير رضي الله عنه .(@)(@@) PageV02P071(@)(@@)(@@)(@@) $ ( 3975 ) قال النبي :(@)(@@) | 30 ( ألحقوا الفرائض بأهلها فما بقي فلأولى رجل ذكر ) )(@)(@@) ( حم ق ت ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3976 ) قال النبي :(@)(@@) | 30 ( الزم البيت ولو لم تصب شيئا تأكله إلا المسك ) )(@)(@@) ( ابن لال ) عن أبي الطفيل رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3977 ) قال النبي :(@)(@@) | 30 ( الزم بيتك ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3978 ) قال النبي :(@)(@@) | 30 ( الزم رجلها فثم الجنة ) )(@)(@@) ( ه ) عن جاهمة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3979 ) قال النبي :(@)(@@) | 30 ( ألزم نعليك قدميك فإن خلعتهما فاجعلهما بين رجليك ولا تجعلهما عن يمينك ولا عن يمين صاحبك ولا وراءك فتؤذي من خلفك ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3980 ) قال النبي :(@)(@@) | 30 ( الزموا الجهاد تصحوا وتستغنوا ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3981 ) قال النبي :(@)(@@) | 30 ( الزموا هاذا الدعاء : اللهم إني أسألك باسمك الأعظم ورضوانك الأكبر فإنه اسم من أسماء الله ) )(@)(@@) ( البغوي وابن قانع طب ) عن حمزة بن عبد المطلب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3982 ) قال ال