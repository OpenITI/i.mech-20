ms661	(@)(@)(@@) -عبد الواحد...(@)(@)(@@)(@@)(@@) $ الرازي: -محمد بن عبد الواحد...(@)(@)(@@)(@@)(@@) $ الرازي: -محمود بن علي بن الحسن الحمصي.(@)(@)(@@)(@@)(@@) $ رأس الشيعة:(@)(@)(@@) -الحسن بن زهرة بن الحسن.(@)(@)(@@)(@@)(@@) $ راشد بن ابراهيم بن إسحاق بن إبراهيم البحراني.(@)(@)(@@) الشيخ الفقيه ناصر الدين كما في «فهرس» منتجب بن بابويه و«الأربعين» للشهيد، أو نصير الدين كما جاء في «الرياض» و«أمل الآمل» . قال الشيخ سليمان البحراني في «تأريخ علماء البحرين» : كان شيخا فقيها عالما متكلما أديبا لغويا. وقال شمس الدين محمد بن أحمد بن صالح القسيني في إجازته للطومان العاملي، المذكورة في «إجازات البحار-ص 101-104» ضمن إجازة صاحب «المعالم» : إن والدي الشيخ أحمد بن صالح القسيني أجيز له من راشد بن ابراهيم (صاحب الترجمة) في سنة 605 ثم توفي المجيز بعد أشهر.(@)(@)(@@) ووصفه بالأوصاف التي ذكرت ثم قال: إنه يروي الشيخ راشد هذا عن القاضي جمال الدين علي بن عبد الجبار الطوسي عن والده عبد الجبار عن الشيخ الطوسي. وقال العلامة الحلي في «إجازة بني زهرة» إن راشد هذا يروي عن(@)(@)PageV04P064(@) ضياء الدين أبي الرضا فضل الله الراوندي، وعن أبي العامر سالم بن مارويه (الثقات: 118) في سنة 591، عن أبي البقاء هبة الله بن نما عن أبي البقاء هبة الله بن ناصر بن نصر عن أبيه عن الرئيس أبي الغنائم أحمد بن علي عمن حدثه حكاية قتل مقلد بن رافع في سنة 390. أقول: ويروي عن صاحب الترجمة عميد الرؤساء هبة الله كما في «إجازة صاحب المعالم» ، وتاج الدين الحسن بن علي الدربي المذكور في ص 40 كما في «إجازة بني زهرة» ، وسديد الدين يوسف والد العلامة الحلي كما في إجازة محمد السبط للأمين الاسترابادي، كما نقله في «الرياض» وتنظر فيه. أقول: لا يبعد رواية سديد الدين في شبابه عن الشيخ راشد في هرمه.(@)(@)(@@)(@@)(@@) $ الرافضي:(@)(@)(@@) -أحمد بن علي بن معقل.(@)(@)(@@)(@@)(@@) $ الرافضي: -الحسن بن محمد بن أحمد بن نجا.(@)(@)(@@)(@@)(@@) $ الرافضي: -أبو الفضل بن شهردوير.(@)(@)(@@)(@@)(@@) $ الرافضي: -أبو القاسم بن الحسين الحلي.(@)(@)(@@)(@@)(@@) $ الرافضي: -محمد بن أحمد بن محمد بن علي بن العلقمي.(@)(@)(@@)(@@)(@@) $ الراوندي:(@)(@)(@@) -الحسن بن محمد بن 
ms662	 عبد الله.(@)(@)(@@)(@@)(@@) $ الراوندي: -علي بن سعيد بن هبة الله.(@)(@)(@@)(@@)(@@) $ الربعي:(@)(@)(@@) -محمد بن جعفر بن هبة الله بن نما.(@)(@)(@@)(@@)(@@) $ الربعي: -محمد بن جهيم.(@)(@)(@@)(@@)(@@) $ ربيب الدين:(@)(@)(@@) -الحسن بن محمد بن يحيى بن علي.(@)(@)PageV04P065(@)(@)(@@)(@@)(@@) $ ابن أبي الربيع:(@)(@)(@@) -أحمد بن محمد...(@)(@)(@@)(@@)(@@) $ ربيع بن محمد الكوفي.(@)(@)(@@) القاضي عفيف الدين. يروي عنه عبد الكريم ابن أحمد بن طاوس في «فرحة الغري» في 15-ع 2-688 ووصفه بالقاضي العالم الفاضل المدرس عفيف الدين... وذكر أنه يروي عن القاضي الزاهد علي بن يد (زيد خ. ل. ) الهمداني المتوفى في رجب 663 ودفن بالسهلة.(@)(@)(@@)(@@)(@@) $ رجا (ابن... ) :(@)(@)(@@) -أبو الحسن...(@)(@)(@@)(@@)(@@) $ رده (ابن... ) :(@)(@)(@@) -الحسين...(@)(@)(@@)(@@)(@@) $ رده (ابن... ) : -الحسين بن أبي الفرج...(@)(@)(@@)(@@)(@@) $ رده (ابن... ) : -الحسين بن محمد بن عبد الله...(@)(@)(@@)(@@)(@@) $ رشيد الدين:(@)(@)(@@) -فضل الله بن أبي الخير الحمداني.(@)(@)(@@)(@@)(@@) $ رشيد الدين: -محمد بن أبي القاسم.(@)(@)(@@)(@@)(@@) $ الرضي:(@)(@)(@@) -علي بن أحمد بن أبي هاشم.(@)(@)(@@)(@@)(@@) $ رضي الدين:(@)(@)(@@) -علي بن أحمد بن الوزير.(@)(@)(@@)(@@)(@@) $ رضي الدين: -علي بن موسى بن جعفر بن طاوس.(@)(@)(@@)(@@)(@@) $ رضي الدين: -محمد بن الحسن الاسترابادي.(@)(@)(@@)(@@)(@@) $ رضي الدين: -محمد بن الحسن بن علي بن محمد.(@)(@)PageV04P066(@)(@)(@@)(@@)(@@) $ رضي الدين: -محمد بن محمد بن محمد بن زيد بن الداعي.(@)(@)(@@)(@@)(@@) $ رضي الدين: -هبة الله بن حامد بن أحمد.(@)(@)(@@)(@@)(@@) $ رضي الدين بن عرفة.(@)(@)(@@) السيد المتكلم. جرى بينه وبين الأمير حسام الدين أبي الحسن بن رجا المذكور في ص 38 بحث في الإمامة وكيفية حصول اللطف بها. فانتصر له واختار قوله من أجاب الأمير حسام الدين مفصلا بعد وقعه تتر في حلب 658. والنسخة موجودة في المكتبة الرضوية.(@)(@)(@@)(@@)(@@) $ ركن الاسلام:(@)(@)(@@) -الحسن بن علي بن الحسن الطبري.(@)(@)(@@)(@@)(@@) $ الرملي:(@)(@)(@@) -الأشرف بن الأغر.(@)(@)(@@)(@@)(@@) $ الرهمي:(@)(@)(@@) -علي بن حسان.(@)(@)(@@) اسكن(@)(@)PageV04P067(@)(@)(@@)(@@)(@@) || «ز»(@)(@)(@@)(@@)(@@) $ الزاهد:(@)(@)(@@) -الحسن بن أحمد بن يوسف.(@)(@)(@@)(@@)(@@) $ الزاهد: -الحسين بن حماد بن أبي الخير.(@)(@)(@@)(@@)(@@) $ الزاهد: -علي بن زيد الهمداني.(@)(@)(@@)(@@)(@@) $ الزاهد: -علي بن يد الهمداني.(@)(@)(@@)(@@)(@@) $ الزاهد: -ورام بن أبي فراس.(@)(@)(@@)(@@)(@@) $ ابن الزبيب.(@)(@)(@@) إثنان، أحدهما: الشيخ نظام الدين أحمد بن محمد بن عبد الغني. والثاني: عز الدين الحسن بن زبيب الدين أبي طالب اليوسفي الآبي صاحب «كشف الرموز» الذي فرغ منه 672، واحتمل 
ms663	 في «الرياض» أنهما إبنا عم. فهما غير ابن زينب محمد بن ابراهيم النعماني تلميذ الكليني المذكور في «النوابغ-230» .(@)(@)(@@)(@@)(@@) $ الزرقني (-زرقاني) :(@)(@)(@@) -محمد بن الحسن بن علي بن محمد.(@)(@)(@@)(@@)(@@) $ زكريا بن محمد بن محمود.(@)(@)(@@) المولى أبو عمرو الكموني القزويني. كتب لنفسه بخطه «صحاح اللغة» للجوهري. وفرغ من الكتابة 629. رأيت النسخة بمكتبة سردار كابلي حيدر قليخان بكرمانشاه. قال السمعاني:(@)(@)PageV04P068(@)(@)(@@) الكموني نسبة إلى بني كمونة وذكر منهم من علماء القرن الثالث حتى السادس وقال: أصلهم من بغداد وكلهم من أهل الحديث... فليس لهم علاقة بسعد ابن منصور بن الحسن بن كمونة الاسرائيلي (م 683) ، مؤلف «تنقيح الأبحاث» (ذ-4: 460) الذي طبعه موسى پرلمان في 1967 وأثبت أنه يهودي ولذلك تركت ذكره مع أني ذكرت كتبه في الذريعة. وراجع محمد المؤمن القزويني.(@)(@)(@@)(@@)(@@) $ الزمان:(@)(@)(@@) -عين.. شيخ... حجة...(@)(@)(@@)(@@)(@@) $ الزنجي (ابن... ) :(@)(@)(@@) -محمد...(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) :(@)(@)(@@) -الحسن بن زهرة بن الحسن.(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) : -عبد الله بن علي...(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) : -علي بن محمد بن عبد الله.(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) : -محمد بن عبد الله بن علي...(@)(@)(@@)(@@)(@@) $ زهرة (ابن... ) : -محمد بن علي بن... الحلبي.(@)(@)(@@)(@@)(@@) $ الزيدي:(@)(@)(@@) -علي بن يد الهمداني.(@)(@)(@@)(@@)(@@) $ الزيدي: -محمد بن محمد بن جعفر بن أحمد.(@)(@)(@@)(@@)(@@) $ زين الدين:(@)(@)(@@) -أحمد بن محمد بن عبد الله بن جعفر.(@)(@)(@@)(@@)(@@) $ زين الدين: -الحسن بن ربيب الدين.(@)(@)PageV04P069(@)(@)(@@)(@@)(@@) $ زين الدين: -الحسن بن محمد بن يحيى.(@)(@)(@@)(@@)(@@) $ زين الدين: -علي بن محمد بن سعيد.(@)(@)(@@)(@@)(@@) $ زين الدين: -علي بن محمد بن المطهر.(@)(@)(@@)(@@)(@@) $ زين الدين: -علي بن يوسف بن جبير.(@)(@)(@@)(@@)(@@) $ زين الدين: -محمد بن عبد الواحد الرازي.(@)(@)(@@)(@@)(@@) $ زين الدين: -محمد بن القاسم بن محمد.(@)(@)(@@) اسكن(@)(@)PageV04P070(@)(@)(@@)(@@)(@@) $ الساعي (ابن... ) :(@)(@)(@@) -علي بن أنجب بن عثمان.(@)(@)(@@)(@@)(@@) || «س»(@)(@)(@@)(@@)(@@) $ سالار (ابن... ) :(@)(@)(@@) -علي بن فضل الله.(@)(@)(@@)(@@)(@@) $ سالم بن بدران بن علي بن سالم.(@)(@)(@@) معين الدين المازني المصري أستاذ الخواجه نصير الدين الطوسي (م 672) . كتب له إجازة سنة 629، ويروي عنه محمد بن القاسم بن محمد البرزهي البيهقي، كما ذكره في إجازته للسيد جمال الدين محمد بن الناصر الوراميني في 661. وصفه في هذه الإجازة بقوله: [الإمام الأجل العالم البارع الفاضل المتبحر العلامة معين الدين 
ms664	 سالم ابن بدران بن سالم المازني المصري نور الله مضجعه] (1) . وله كتاب «التحرير» نقل عنه الخواجه نصير الدين في «الفرائض النصيرية» مسألة المتوفى الذي خلف ابن ابن عم له من قبل أبي أبيه ويقال له «تحرير الفرائض» (ذ-3: 377) ونسخة منه كانت عند الشيخ محمد السماوي بالنجف.(@)(@)(@@)(@@)(@@) $ سالم بن محفوظ بن غريزة(@)(@)(@@) بن وشاح السوراوي (2) سديد الدين الحلي.(@)(@)PageV04P071(@)(@)(@@) من الفقهاء المتكلمين. له «التبصرة» قرأه عليه تلميذه رضي الدين علي بن طاوس (م 664) ، وله «المنهاج» في الكلام، قرأه عليه تلميذه المحقق الحلي وقرأ بعضه رضي الدين ابن طاوس المذكور. ومن تلاميذه سديد الدين يوسف بن علي بن المطهر والد العلامة الحلي. يروي عن نجيب الدين يحيى الأكبر الآتي جد المحقق الحلي المذكور في ص 30 وعن حسين بن رطبة السوراوي (الثقات: 83) . وقال الحر في «الأمل» : يروي العلامة تصانيف المترجم له عن أبيه عن المؤلف. انتهى. وليس المترجم له ابن محفوظ بن وشاح الآتي، ولا أخ تاج الدين محمد بن محفوظ الآتي في الثامنة.(@)(@)(@@)(@@)(@@) $ السبزواري:(@)(@)(@@) -محمد بن محمد بن محمد بن...(@)(@)(@@)(@@)(@@) $ السبيع (ابن... ) :(@)(@)(@@) -قريش...(@)(@)(@@)(@@)(@@) $ السديد:(@)(@)(@@) -جعفر القطاع.(@)(@)(@@)(@@)(@@) $ السديد: -علي بن أحمد...(@)(@)(@@)(@@)(@@) $ سديد الدين:(@)(@)(@@) -جعفر القطاع.(@)(@)(@@)(@@)(@@) $ سديد الدين: -الحسين بن حشرم.(@)(@)(@@)(@@)(@@) $ سديد الدين: -عبد الواحد الرازي.(@)(@)(@@)(@@)(@@) $ سديد الدين: -سالم بن محفوظ.(@)(@)(@@)(@@)(@@) $ سديد الدين: -محمود بن علي بن الحسن الحمصي.(@)(@)(@@)(@@)(@@) $ سديد الدين: -يوسف بن علي بن محمد بن المطهر.(@)(@)PageV04P072(@)(@)(@@)(@@)(@@) $ سراب شاهواري:(@)(@)(@@) -محمد بن علي بن الحسين بن علي.(@)(@)(@@)(@@)(@@) $ السروي:(@)(@)(@@) -مجد الدين...(@)(@)(@@)(@@)(@@) $ أبو السعادات:(@)(@)(@@) -أسعد بن عبد القاهر بن أسعد.(@)(@)(@@)(@@)(@@) $ ابن سعادة:(@)(@)(@@) -أحمد بن علي بن سعيد.(@)(@)(@@)(@@)(@@) $ سعد الدين:(@)(@)(@@) -محمد بن المؤيد بن أبي الحسن الحموي.(@)(@)(@@)(@@)(@@) $ سعد الدين بن نجم الدين بن الحسن بن علي الطبري.(@)(@)(@@) صاحب «تفضيل القرابة على الصحابة» الذي ألفه بعد ما ورد إصفهان في 673 ورأى أهلها بين مفضل للصحابة ومفضل للقرابة. رأيت النسخة الناقصة عند السيد أبي القاسم الرياضي الخوانساري ذهب بها معه عندما هاجر إلى كشمير (ذ-4: 360) .(@)(@)(@@)(@@)(@@) $ السعدي:(@)(@)(@@) -محمد بن عباس...(@)(@)(@@)(@@)(@@) $ السعدي: -مصلح الدين...(@)(@)(@@)(@@)(@@) $ سفرويه (1) :(@)(@)(@@) -أسعد بن عبد القاهر بن 
