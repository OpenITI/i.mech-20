ms393	 لنگر(@)(@@) 114 به خنجرش ملک‌الموت اگر دوچار شود %~% کند سجودکه این خواجه است و من چاکر(@)(@@) 115 به بارگاهش اگر بنگرد سپهر برین %~% برد نماز که این مهترست و من ‌کهتر(@)(@@) 116 خلل نیابد ملکش ز حاسدان آری %~% عروس دنیا بکر است با همه شوهر(@)(@@) 117 پدید نوک پرند آورش زکوهه پیل %~% چنانکه اختر سوزان ز تل خاکستر(@)(@@) 118 ایا به مهر تو طوبی دمیده از سجین %~% ایا به قهر تو ز قوم رسته ازکوثر(@)(@@) 119 روان‌کند دم تیغ تو خون ز چشم زره %~% گره شودگه‌کین تو دل ز ناف سپر(@)(@@) 120 کجا سنان تو آنجا مجاورست بلا %~% کجا عنان تو آنجا ملازمست ظفر(@)(@@) 121 چو وصف خنگ تو خوانم بپردم خامه %~% چو مدح تیغ تو رانم بسوزدم دفتر(@)(@@) 122 نشسته‌یی ز بر باد کاین مرا توسن %~% گرفته‌یی ز نخ مرگ‌کاین مرا خنجر(@)(@@) 123 مثل بود که به چنبر کسی نبندد باد %~% مگر نه خنگ تو بادیست بسته بر چنبر(@)(@@) 124 به عهد دولت تو بالله ار قبول‌کنم %~% که طفل خون خورد اندر مشیمه مادر(@)(@@) 125 گواه عدل تو اینک بس است خنجر تو %~% که جمع‌کرده به یکجای آب با آذر(@)(@@) 126 نشان عزم تو اینک بس است باره تو %~% که یک زمان رود از باختر سوی خاور(@)(@@) 127 ز بحر جود تو جوییست لجه عمان %~% به جنب قدر تو گوییست گنبد اخضر(@)(@@) 128 شها تو دانی و داند خدا و خلق خدای %~% که من به فطرت خویشم ترا ثنا گستر(@)(@@) 129 ترا گزیده‌ام از هرچه در قطار وجود %~% ترا ستوده‌ام از هرکه در شمار بشر(@)(@@) 130 تو نیز رشته‌کارم به دیگران مگذار %~% تو نیز ربقه امرم به این و آن مسپر(@)(@@) 131 به پای بند توام به‌که از مهان خلخال %~% به فرق تیغ توام به‌که از شهان افسر(@)(@@) 132 به بندگان قدیم تو چون مراست خلوص %~% تو هم مرا زیرم بنده قدیم شمر(@)(@@) 133 همیشه تا به صلابت بود 
ms394	 پلنگ مثل %~% هماره تا به سماحت بود سحاب سمر(@)(@@) 134 ترا ستاره مطیع و ترا زمانه غلام %~% ترا فرشته معین و ترا خدا یاور(@)(@@) 135 انوشه مانی چندان که چون به روز نشور %~% ز شور غلغله‌ گوش زمانه ‌گردد کر(@)(@@) 136 گمان بری که گروهی ز دادخواهانند %~% که ظلم رفته بدیشان ز ظالمی ابتر(@)(@@) 137 شمیده‌دل به غلامی کنی ز خشم خطاب %~% که ای غلام چه غوغاست رو بیار خبر PageV1P210(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 فرو بگرفته‌ گیتی را به باغ و راغ وکوه و در %~% نم ابرو دم باد و تف برق و غو تندر(@)(@@) 2 شخ از نسرین هوا از مه چمن ازگل تل از سبزه %~% حواصل‌بال و شاهین‌چشم و هدهدتاج و طوطی‌پر(@)(@@) 3 ز ابرو اقحوان و لاله و شاه اسپرم بینی %~% هوا اسود زمین ابیض دمن احمر چمن اخضر(@)(@@) 4 عقیق و کهربا و بسد و پیروزه را ماند %~% شقیق و شنبلید و بوستان‌ افروز و سیسنبر(@)(@@) 5 ز صنع ایزدی محوند و مات و هائم و حیران %~% اگر لوشا اگر ارژنگ اگر مانی اگر آزر(@)(@@) 6 کنون‌کز سنبل و شمشاد باغ و بوستان دارد %~% چمن تزیین دمن تمکین زمین آیین زمان زیور(@)(@@) 7 به صحن باغ و طرف راغ و زیر سرو و پای جو %~% بزن گام و بجو کام و بخور جام و بکش ساغر(@)(@@) 8 به ویژه با بتی شنگول و شوخ و شنگ و بی‌پروا %~% سخن‌پرداز و خوش‌آواز و افسونساز و حیلت‌گر(@)(@@) 9 سمن‌خوی و سمن‌بوی و سمن‌روی و سمن‌سیما %~% پری‌طبع و پریزاد و پریچهر و پری‌پیکر(@)(@@) 10 برش‌ا دیبا فرش زیبا قدش طوبی خدش جنت %~% تنش روشن خطش جوشن رخش ‌گلشن لبش شکر(@)(@@) 11 به بالاکش به سیما خوش به مو دلکش به خو آتش %~% به چشم آهو به قد ناژو به خد مینو به خط عنبر(@)(@@) 12 چو سیمین ‌سرومن ‌کش‌‌هست‌روی‌و موی‌و چهر و لب %~% مه روشن شب تاری‌گل سوری می احمر 
ms395	(@)(@@) 13 کفش رنگی دلش سنگین خطلش مشکین لبش شیرین %~% به خو توسن به رو سوسن به رخ گلشن به تن مرمر(@)(@@) 14 دو هاروت و دو ماروت و دوگلبرگ و دو مرجانش %~% پر از خواب و پر از تاب و پر از آب و پر از شکر(@)(@@) 15 مرا هست از غم و اندیشه و فکر و خیال او %~% بقا مشکل دو پا درگل هوا در دل هوس در سر(@)(@@) 16 ز عشقش چون انار و نار و مار و اژدها دارم %~% بری ‌کفته دلی تفته تنی چفته قدی جنبر(@)(@@) 17 ولیکن من ازو شادم‌که سال و ماه و روز و شب %~% به طوع و طبع و جان و دل ثنای شه ‌کند از بر(@)(@@) 18 طراز تاج و تخت و دین و دولت ناصرالدین شه %~% که جوید نام و راند کام و پاشد سیم و بخشد زر(@)(@@) 19 ملک ‌اصل و ملک ‌نسل و ملک ‌رسم و ملک ‌آیین %~% ملک‌طبع و ملک‌خوی و ملک‌روی و ملک‌منظر(@)(@@) 20 عدوبند و ظفرمند و هنرجوی و هنرپیشه %~% عطابخش و صبارخش و سماقدر و سخاگستر(@)(@@) 21 قوی‌حال و قوی‌یال و قوی‌بال و قوی‌بازو %~% جهانجوی و جهانگیر و جهاندار و جهانداور(@)(@@) 22 شهنشاهی‌که هست او را به طوع و طبع و جان و دل %~% قضا تابع قدر طالع ملک خادم فلک چاکر(@)(@@) 23 حقایق‌خوان دقایق‌دان معارک‌جو بلارک‌زن %~% فلک‌پایه گرنمایه هماسایه همایون‌فر(@)(@@) 24 ز فیض فضل و فرط بذل و خلق خوب و خوی خوش %~% دلش صافی‌کفش‌کافی دمش شافی رخش انور(@)(@@) 25 به رای و فکرت و طبع و ضمیرش جاودان بینی %~% خرد مفتون هنر مکنون شغف مضمون شرف مضمر(@)(@@) 26 زهی ای بر تن و اندام و چشم و جسم بدخواهت %~% عصب‌زنجیر و رگ‌شمشیر و مژگان‌تیر و مو نشتر(@)(@@) 27 حسام فر و فال و بخت و اقبال ترا زیبد %~% سپهر آهن قضا قبضه شرف صیقل ظفر جوهر(@)(@@) 28 در آن روزی‌که‌گوش وهوش و 
ms396	 مغز و دل ز هم پاشد %~% غوکوس و تک رخش و سرگرز و دم خنجر(@)(@@) 29 ز سهم تیر و تیغ و گرز و کوپال ‌گوان ‌گردد %~% قضاهایم قدر حیران زمان عاجز زمین مضطر(@)(@@) 30 خراشد سنگ و پاشدگرد و ریزد خاک و سنبدگل %~% به سم اشهب به دم ابرش به تک ادهم به نعل اشقر(@)(@@) 31 بلا گاز و بدن آهن سنان آتش زمین کوره %~% تبر پتک و سپر سندان نفس دم مرگ آهنگر(@)(@@) 32 دلیران از پی جنگ و نبرد و فتنه و غوغا %~% روان در صف دهان پر تف سنان برکف سپر بر سر(@)(@@) 33 تو چون ببر و پلنگ و پیل و ضرغام ازکمین خیزی %~% به‌کف تیغ و به بر خفتان به تن درع وبه سر مغفر(@)(@@) 34 به زیرت او همی چالاک و چست و چابک و چعره %~% شخ‌آشوب و زمین‌کوب و ره‌انجام و قوی‌پیکر(@)(@@) 35 سرین و سم و ساق و سینه و کتف و میان او %~% سطبر و سخت و باریک و فراخ و فربه و لاغر(@)(@@) 36 دم و اندام و یال و بازو و زین و رکاب او %~% شراع و زورق و بلط و ستون و عرشه و لنگر(@)(@@) 37 پیش باد و سمش سندان تنش ابر و تکش طوفان %~% کفش برف و خویش باران دوش برق و غوش تندر(@)(@@) 38 به‌ یک آهنگ و جنگ و عزم و جنبش در کمند آری %~% دو صد دیو و دو صد گیو و دو صد نیو و دو صد صفدر(@)(@@) 39 به یک ناورد و رزم و حمله و جنبش ز هم دری %~% دو صد پیل و دو صد شیر و دو صد ببر و دو صد اژدر(@)(@@) 40 به دشت از سهم تیر و تیغ و گرز و برزت اندازد %~% سنان قارن‌ سپر بیژن‌‌کمان بهمن‌‌کمر نوذر(@)(@@) 41 شها قاآنی از درد و غم و رنج و الم‌گشته %~% قدش چنگ و تغش تار 
ms397	 و دمش نای و دلش مزهر(@)(@@) 42 سزد کز فیض و فضل و جود و بذلت زین سپس آرد %~% نهالش بیخ و بیخش شاخ و شاخش برگ و برگش بر(@)(@@) 43 نیارد حمد و مدح و شکر و توصیفت‌گرش باشد %~% محیط آمه شجر خامه فلک نامه جهان دفتر(@)(@@) 44 الا تا زاید و خیزد الا تا روید و ریزد %~% نم از آب‌و تف از نار وگل از خاک و خس از صرصر(@)(@@) 45 حسود و دشمن و بدگوی و بدخواه ترا بادا %~% به سرخاک و به چشم آب و به لب باد و به دل آذر(@)(@@) 46 به سال و ماه و روز و شب بود بدخواه جاهت را %~% کجک برسر نجک دردل حسک بالین خسک بستر PageV1P211(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 لبالب کن ای مهربان ماه ساغر %~% از آن آب‌گلگون از آن آتش تر(@)(@@) 2 کزان آتش تر بسوزیم دیوان %~% وز آن آب‌گلگون بشوییم دفتر(@)(@@) 3 همای من ای باز طوطی تکلم %~% تذرو من ای ‌کبک طاووس پیکر(@)(@@) 4 چو مرغ شباهنگ بی‌زاغ زلفت %~% پرد کرکس آهم از چرخ برتر(@)(@@) 5 چو دمسیجه بسیار دم لابه‌کردم %~% نگشی چو عنقا دمی سایه‌گستر(@)(@@) 6 اگر خواهیم همچو ساری نواخوان %~% اگر خواهیم همچو قمری نواگر(@)(@@) 7 چو بلبل برون آور از نای آوا %~% چو طوطی فرو ریز از کام شکر(@)(@@) 8 چو طاووس برخیز ه از بط بیفشان %~% به ساغر میی همچو خون‌کبوتر(@)(@@) 9 شرابی که گر در بن خار ریزی %~% گل و سنبل و ارغوان آورد بر(@)(@@) 10 شود صعوه از وی همای همایون %~% شود عکه از آن عقاب دلاور(@)(@@) 11 شرابی ازان جان آفاق زنده %~% چو از نار سوزنده جان سمندر(@)(@@) 12 بدو چشم بیننده تابنده عکسش %~% چو خورشید رخشان به برج دو پیکر(@)(@@) 13 چه نستوده مر دستی ای باغ پیرا %~% چه آشفته مغزستی ای‌ کیمیاگر(@)(@@) 14 نه شدیار خواهد نه تیمار دهقان %~% نه فرار باید نه گوگرد احمر(@)(@@) 15 از 
