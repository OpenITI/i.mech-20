ms513	 بخارستی(@)(@@) 11 شاخ گل گر نکشیدی ستم از بهمن %~% نه چینن زرد و نوان و نه نزارستی(@)(@@) 12 ای به نوروز شده همچو خران فتنه %~% من نخواهم که مرا همچو تو یارستی(@)(@@) 13 گوئی «امسال تهی دست چه دانم کرد» %~% کاشک امسال تو را کار چو پارستی(@)(@@) 14 دلم از تو به همه حال بشستی دست %~% گر تو را در خور دل دست گزارستی(@)(@@) 15 فتنه سبزه شدت دل چو خر ای بیهش %~% فتنه سبزه نشدی گر نه حمارستی(@)(@@) 16 نیست فرقی به میان تو و آن خر %~% جز همی باید که‌ت پای چهارستی(@)(@@) 17 سیرتی بهتر از این یافتیی بی‌شک %~% گرت ننگستی از این سیرت و عارستی(@)(@@) 18 گر گل حکمت بر جان تو بشکفتی %~% مر تو را باغ بهاری چه بکارستی(@)(@@) 19 مجلست بستانستی و رفیقان را %~% از درخت سخن خوب ثمارستی(@)(@@) 20 وین گل و لاله خاکی که همی روید %~% با گل دانش پیشت خس و خارستی(@)(@@) 21 پیش گلزار سخن‌های حکیمانه‌ت %~% کار لاله بد و کار گل زارستی(@)(@@) 22 مردم آن است که چون مرد ورا بیند %~% گوید «ای کاش که‌م این صاحب غارستی»(@)(@@) 23 فضل بایدش و خرد بار که خرما بن %~% گر نه بار آوردی یار چنارستی(@)(@@) 24 خرد است آنکه اگر نور چراغ او %~% نیستی عالم یکسر شب تارستی(@)(@@) 25 خرد است آنکه اگر نیستی او از ما %~% نه صغارستی هرگز نه کبارستی(@)(@@) 26 گر نبوده‌ستی این عقل به مردم در %~% خلق یکسر بتر از کژدم و مارستی(@)(@@) 27 تو چه گوئی که اگر عقل نبوده‌ستی %~% یک تن از مردم سالار هزارستی(@)(@@) 28 ورنه با عقل همی جهل جفا جستی %~% گرد دانا جهلا را چه مدارستی(@)(@@) 29 سر به جهل از خرد و حق همی تابد %~% آنکه حق است که بر سرش فسارستی(@)(@@) 30 یله کی کردی هر فاحشه را جاهل %~% گر نه از بیم حد و کشتن و دارستی(@)(@@) 31 آنکه طبع 
ms514	 یله کردی به خوشی هرگز %~% معصفر گونه و نیروی شخارستی(@)(@@) 32 ای دهان باز نهاده به جفای من %~% راست گوئی که یکی کهنه تغارستی(@)(@@) 33 چند گوئی که «از آن تنگ دره حجت %~% هم برون آیدی ار نیک سوارستی»(@)(@@) 34 اندر این تنگ حصارم ننشستی دل %~% گرنه گرد دلم از عقل حصارستی(@)(@@) 35 کار تو گر به میان من و تو ناظر %~% حاکمی عادل بودی بس خوارستی(@)(@@) 36 کار دنیا گر بر موجب عقلستی %~% مر مرا خیره درین کنج چه کارستی(@)(@@) 37 بل سخن‌های دلاویز بلند من %~% بر سر گنبد گردنده عذارستی(@)(@@) 38 ور سخن‌هام فلاطون بشنوده‌ستی %~% پیش من حیران چون نقش جدارستی(@)(@@) 39 یوز و باز سخن و نکته‌م را بی‌شک %~% دل دانای سخن پیشه شکارستی(@)(@@) 40 دهر پر عیبم همچون که تو بگزیدی %~% گر مرا تن چو تو پر عیب و عوارستی(@)(@@) 41 مر مرا گر پس دانش نشده‌ستی دل %~% همچو تو اسپ و غلامان و عقارستی(@)(@@) 42 بی‌شمارستی مال و خدم و ملکم %~% گر نه بیمم همه از روز شمارستی(@)(@@) 43 بی‌قرارستی جانم چو تو در کوشش %~% گر بدانستی کاین جای قرارستی PageV1P270(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 از آن پس کاین جهان را آزمودی گر خردمندی %~% در این پر گرد و ناخوش جای دل خیره چرا بندی(@)(@@) 2 به بیماری از این جای سپنجی چون شوی بیرون %~% مخور تیمار چندینی نه بنیادش تو افگندی(@)(@@) 3 یکی فرزند خواره پیسه گربه است ای پسر گیتی %~% سزد گر با چنین مادر ز بار و بن نپیوندی(@)(@@) 4 چنان چون مر تو را پند است مرده جد بر جدت %~% تو مر فرزند فرزندان فرزندانت را پندی(@)(@@) 5 جهان مست است نرمی کن که من ایدون شنوده‌ستم %~% که با مستان و دیوانه حلیمی بهتر از تندی(@)(@@) 6 بخواهد خورد مر پروردگان خویش را گیتی %~% نخواهد رستن از چنگال او سندی و نه هندی(@)(@@) 7 جهانا ز آزمون سنجاب و از کردار پولادی %~% به 
ms515	 زیر نوش در نیشی به روی زهر بر قندی(@)(@@) 8 به روز و شب همی کاهد تن مسکین من زیرا %~% به رنده روز و سوهان شبم دایم همی رندی(@)(@@) 9 ز چون و چند بیرونی ازیرا عقل نشناسد %~% نه مر بودنت را چونی نه مر گشتنت را چندی(@)(@@) 10 نخوانی پیش و نپسندی ز فرزندان بسیارت %~% مگر آن را کزو ناید بجز بدفعلی و رندی(@)(@@) 11 بسا شاهان با ملک و سپاه و گنج آگنده %~% که‌شان بربودی از گاه و بدین چاه اندر افگندی(@)(@@) 12 کجا پیوسته‌ای صحبت که دیگر روز نگسستی %~% درختی کی نشانده‌ستی که از بیخش نه برکندی(@)(@@) 13 خردمندا مراد ایزد از دنیا به حاصل کن %~% مراد او تو خود دانی چه چیز است ار خردمندی(@)(@@) 14 خداوندی همی بایدت و خدمت کرد نتوانی %~% گرش خدمت کنی بدهد خداوندت خداوندی(@)(@@) 15 مرا ایزدی دین است چون دین یافتی زان پس %~% دگر مر خویشتن را در سپنجی جای نپسندی(@)(@@) 16 بدین مهلت که داده‌ستت مباش از مکر او ایمن %~% بترس از آتش تیزش مکن در طاعتش کندی(@)(@@) 17 چو فضل دین ایزد را ز نفس خویش بفگندی %~% چه باشد فضل سوی او تو را بر رومی و سندی(@)(@@) 18 به گوش اندر همی گویدت گیتی «بار بر خر نه» %~% تو گوش دل نهاده‌ستی به دستان نهاوندی(@)(@@) 19 اگر دانی که فردا بر تو خویش و اهل و پیوندت %~% بگرید زار چندینی بدین خوشی چرا خندی(@)(@@) 20 بباید بی‌گمان رفتنت از اینجا سوی آن معدن %~% که آنجا بدروی بی‌شک هر آنچ اینجا پراگندی(@)(@@) 21 حکایت‌های شاهان را همی خوانی و می‌خندی %~% همی بر خویشتن خندی نه بر شاه سمرقندی(@)(@@) 22 چرا بر عهد و سوگند رسول خویش نشتابی %~% به سوی عهد فرزندش گر اهل عهد و سوگندی(@)(@@) 23 گر اهل عهد و پیمانی از اهل خاندانی تو %~% وگر زین خانه بیرونی بر افسوسی و ترفندی(@)(@@) 24 نیائی سوی نور 
ms516	 ایرا به تاریکی درون زادی %~% وگر زی نور نگرائی در این تاریک چه بندی(@)(@@) 25 اگر فردا شفاعت را از احمد طمع میداری %~% چرا امروز دشمن دار اهل‌البیت و فرزندی PageV1P271(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای داده دل و هوش بدین جای سپنجی %~% بیم است که از کبر در این جای نگنجی(@)(@@) 2 والله که نیاید به ترازوی خرد راست %~% گر نعمت دنیا را با رنج بسنجی(@)(@@) 3 ور مملکت روم بگیری چو سکندر %~% هرگز نشود ملک تو این جای سپنجی(@)(@@) 4 وز بند و بلای فلکی رسته نگردی %~% هرچند تو را بنده شود رومی و طنجی(@)(@@) 5 چون روزی تو نانی و یک مشت برنج است %~% از بهر چه چندین به شب و روز برنجی(@)(@@) 6 ور همچو خز و بز بپوشدت گلیمی %~% خزت چه همی باید و دیبای ترنجی(@)(@@) 7 فردات تهی دست به کنجی بسپارند %~% هرچند ملک‌وار کنون بر سر گنجی(@)(@@) 8 صنعت به تو ضایع شد ازیرا که شب و روز %~% مشغول به شطرنج و به نرد و شش و پنجی(@)(@@) 9 از بهر چه دادند تو را عقل چه گوئی %~% ناخوش بخوری چون خر و چون غلبه بلنجی(@)(@@) 10 وز بهر چه دادند تو را بار خدائی %~% وز بهر چه شد بنده تو را هندو و زنجی(@)(@@) 11 زیرا که تو بیش آمدی اندر دین زیشان %~% پس چون نکنی شکر و زیادت نلفنجی(@)(@@) 12 امروز که شاهی و رتب فنج بیندیش %~% زیرا که نماند ابدی شاهی و فنجی(@)(@@) 13 از مکر خداوند همی هیچ نترسی %~% زان است که با بنده پر از مکر و شکنجی(@)(@@) 14 اندیشه کن از بندگی امروز که بنده‌ت %~% در پیش به پای است و تو بنشسته به شنجی(@)(@@) 15 همچون کدوئی سوی نبیدو سوی مزگت %~% آگنده به گاورس دو خرواری غنجی(@)(@@) 16 با مسجد و با مؤذن چون سر که و ترفی %~% با مسخره و مطرب چون شیر و برنجی(@)(@@) 17 والله 
ms517	 که نسجند نماز تو ازیراک %~% روی تو به قبله است و به دل با دف و صنجی(@)(@@) 18 تا خوی تو این است اگر گوهر سرخی %~% نزدیک خردمند زراندود برنجی(@)(@@) 19 رخسار تو را ناخن این چرخ شکنجید %~% تو چند لب و زلفک بت روی شکنجی(@)(@@) 20 لختی به ترنج از قبل جانت میان سخت %~% از بهر تن این سست میان چند ترنجی(@)(@@) 21 آن است خردمند که خوردنش خلنج %~% زان است که تو بی‌خرد از کاسه خلنجی(@)(@@) 22 گرگی تو که بی‌نفعی و بی‌خنج ولیکن %~% خود روز و شب اندر طلب نفعی و خنجی(@)(@@) 23 همسایه بی‌فایده گر شاید ما را %~% همسایه نیک است به افرنجه فرنجی PageV1P272(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 این تن من تو مگر بچه گردونی %~% بچه گردونی زیرا سوی من دونی(@)(@@) 2 او همان است که بوده است ولیکن تو %~% نه همانا که همانی که دگرگونی(@)(@@) 3 طمع خیره چه داری که شوی باقی %~% نشود چون ازلی بوده اکنونی(@)(@@) 4 تو مر آن گوهر بیرونی باقی را %~% چون یکی درج برآورده به افسونی(@)(@@) 5 با تو تا مقرون است این گهر باقی %~% تو به زیب و به جمال ای تن قارونی(@)(@@) 6 زان گهر یافته‌ای ای گهر تیره %~% این قد سروی وین روی طبرخونی(@)(@@) 7 لیکن آنگه که گهرت از تو شود بیرون %~% تو همان تیره گل گنده مسنونی(@)(@@) 8 ای درونی گهر تیره نمی‌دانی %~% که درونی نشود هرگز بیرونی(@)(@@) 9 گر فزونی نپذیرد جز کاهنده %~% چه همی بایدت این چونین افزونی(@)(@@) 10 گفته باشم به حقیقت صفتت ای تن %~% گرت گویم صدف لولوی مکنونی(@)(@@) 11 اندر این مرده صدف ای گهر زنده %~% چونکه مانده‌ستی بندی شده چون خوی(@)(@@) 12 غره گردنده به دریای جهان اندر %~% گر نه ذوالنونی ماننده ذوالنونی(@)(@@) 13 تو در این قبه خضرا و بر این کرسی %~% غرض صانع سیاره و گردونی(@)(@@) 14 دام و دد دیو تو گشتند و بفرمانت %~% زانکه تو 
