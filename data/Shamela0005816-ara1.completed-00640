ms621	 - شبرمة بن الطفيل يروي عن على روى عنه إياس بن نذير PageV04P371(@)(@@)(@@)(@@) $ 3406 - شابة أبو رقيم المكي يروي عن بن عباس روى عنه ابنه رقيم بن شابة(@)(@@)(@@)(@@) $ 3407 - شبر شيخ قال صحبت عمر بن الخطاب فكان يتوضأ وضوئه غدوة إلى الليل ويمسح على خفيه رواه الفضل بن موسى السيناني عن الأصبغ بن علقمة عن حميد بن مرة الربعي عن شبر أنه صحب عمر بن الخطاب رضي الله عنه(@)(@@)(@@)(@@) $ 3408 - شيحة بن عبد الله بن قيس أبو حبرة الضبعي من أصحاب علي بن أبي طالب رضي الله عنه وابن عباس من أهل البصرة ممن عمر وكان من العباد مات هرما في عبادته روى عنه أهل البصرة شبيل بن عزرة وغيره(@)(@@)(@@)(@@) || (باب الصاد)(@)(@@) قال أبو حاتم وممن روى عن الصحابة ورآهم ممن ابتدأ اسمه على الصاد(@)(@@)(@@)(@@) $ 3409 - صالح بن خوات بن جبير المدني أخو أم عمرو بنت خوات بن جبير PageV04P372 يروي عن سهل بن أبي حثمة روى عنه القاسم بن محمد(@)(@@)(@@)(@@) $ 3410 - صالح بن إبراهيم بن عبد الرحمن بن عوف الزهري القرشي المدني أخو سعد بن إبراهيم يروي عن أنس بن مالك إن كان سمع منه روى عنه عمرو بن دينار والماجشون كنيته أبو عمران مات وعلى المدينة إبراهيم بن هشام بن إسماعيل المخزومي وأمه أم كلثوم بنت سعد بن أبي وقاص(@)(@@)(@@)(@@) $ 3411 - صالح بن خيوان السبائي يروي عن السائب بن خباب وعبد الله بن عمرو روى عنه بكر بن سوادة(@)(@@)(@@)(@@) $ 3412 - صالح بن أبي زيد النخعي يروي عن أم سلمة روى عنه موسى الجهني إن كان سمع منه(@)(@@)(@@)(@@) $ 3413 - صالح بن حجير كنيته أبو حجير يروي عن معاوية بن حديج PageV04P373 روى عنه ثابت البناني(@)(@@)(@@)(@@) $ 3414 - صالح بن دينار الهلالي يروي عن عمرو بن الشريد روى عنه عامر الأحول(@)(@@)(@@)(@@) $ 3415 - صالح بن بشير بن فديك يروي عن فديك وهو جده وله صحبة روى عنه الزهري(@)(@@)(@@)(@@) $ 3416 - صالح بن دينار التمار مدني والد داود بن صالح يروي عن أبي سعيد الخدري روى عنه ابنه 
ms622	 داود بن صالح(@)(@@)(@@)(@@) $ 3417 - صالح الجذامي ويقال الحداني وقد قيل الحرامي من أهل البصرة يروي عن أبي الدرداء روى عنه ثابت البناني(@)(@@)(@@)(@@) $ 3418 - صالح أبو عبد الله مولى الجندعيين من أهل المدينة يروي عن أبي هريرة روى عنه أبو الأسود محمد بن عبد الرحمن بن نوفل وسعيد بن أبي هلال PageV04P374(@)(@@)(@@)(@@) $ 3419 - صالح بن رستم أبو عبد الله السلمي مولى بنى هاشم يروي عن عبد الله بن حوالة روى عنه عبد الله بن عبد الرحمن بن يزيد بن جابر(@)(@@)(@@)(@@) $ 3420 - صالح بن صريم الإفريقي ويروي عن عبد الله بن عمرو روى عنه الإفريقي(@)(@@)(@@)(@@) $ 3421 - صالح بن عجلان يروي عن أبي أمامة روى عنه سليمان بن بلال(@)(@@)(@@)(@@) $ 3422 - صالح بن مهران مولى عمرو بن حريث يروي عن أبي هريرة روى عنه أبو بكر بن عياش(@)(@@)(@@)(@@) $ 3423 - صالح بن أبي سليمان يروي عن بن عمر وأبي هريرة وابن عباس روى عنه أبو بلج وشعبة(@)(@@)(@@)(@@) $ 3424 - صالح بن راشد القرشي يروي عن بن عباس روى عنه رفدة بن قضاعة(@)(@@)(@@)(@@) $ 3425 - صالح بن أبي أمامة يروي عن أنس بن مالك عداده في أهل PageV04P375 المدينة روى عنه محمد بن إسحاق بن يسار هو صالح بن عبد الرحمن اسم أبي أمامة عبد الرحمن(@)(@@)(@@)(@@) $ 3426 - صالح بن جبير الشامي يروي عن أبي جمعة روى عنه الأوزاعي ومعاوية بن صالح(@)(@@)(@@)(@@) $ 3427 - صالح بن ربيعة بن الهدير التيمي القرشي يروي عن عائشة روى عنه هشام بن عروة(@)(@@)(@@)(@@) $ 3428 - صالح بن شريح يروي عن أبي عبيدة بن الجراح وكان كاتبا لعبد الله بن قرط وكان عبد الله أميرا على حمص لأبي عبيدة بن الجراح روى عنه ابنه محمد بن صالح(@)(@@)(@@)(@@) $ 3429 - صالح بن أبى طريف أبو الصيداء يروي عن أبي سعيد الخدري روى عنه أبو روق عطية بن الحارث الهمداني(@)(@@)(@@)(@@) $ 3430 - صالح بن درهم الباهلي أبو الأزهر يروي عن بن عمر روى عنه مروان بن معاوية(@)(@@)(@@)(@@) $ 3431 - صالح بن سعيد يروي عن عائشة روى عنه نافع بن عمر(@)(@@)(@@)(@@) $ 3432 - صالح الشيباني 
ms623	 يروي عن على روى عنه بن أبى زرعة PageV04P376(@)(@@)(@@)(@@) $ 3433 - صالح بن أبي صالح السدوسي يروي عن على وعائشة روى عنه خلاد بن عمرو(@)(@@)(@@)(@@) $ 3434 - صالح بن عتبة يروي عن عمر روى عنه حريز بن عثمان الرحبي(@)(@@)(@@)(@@) $ 3435 - صالح بن عروة يروي عن بن عمر روى عنه جعفر بن برقان(@)(@@)(@@)(@@) $ 3436 - صالح بن ميسرة الخزاعي البصري يروي عن أنس روى عنه سعيد بن واصل(@)(@@)(@@)(@@) $ 3437 - صالح المعلم من أهل البصرة يروي عن بن عمر روى عنه عمارة بن زاذان(@)(@@)(@@)(@@) $ 3438 - صالح بن مسعود الجدلي من أهل الكوفة يروي عن أبي جحيفة روى عنه مروان بن معاوية الفزاري ثنا أبو يعلى ثنا إبراهيم بن محمد بن عرعرة قال ثنا مروان بن معاوية قال ثنا صالح بن مسعود قال سمعت أبا جحيفة يقول أتينا رسول الله صلى الله عليه وسلم فأمر لنا بثنتي عشرة قلوصا وكنا في استخراجها فجاءتنا وفاته فمنعناها الناس حتى اجتمعوا قال فقلت لأبي جحيفة حدثني عن رسول الله PageV04P377 صلى الله عليه وسلم فقال كان أبيض قد شمط عارضاه(@)(@@)(@@)(@@) $ 3439 - صالح بن حبيب أبو موسى المدني سكن الشام يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه لقمان بن عامر(@)(@@)(@@)(@@) $ 3440 - صدقة بن يسار الجزري سكن مكة يروي عن بن عمر روى عنه مالك والثوري وهو مولى لبعض أهل مكة مات في ولاية أبي العباس السفاح(@)(@@)(@@)(@@) $ 3441 - صدقة أبو توبة يروي عن أنس بن مالك روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 3442 - صدقة بن عيسى أبو محرز يروي عن أنس بن مالك روى عنه عبيد الله بن موسى(@)(@@)(@@)(@@) $ 3443 - الصلت بن إياس الحنفي أخو عبد الله بن إياس بن أبي مريم يروي عن بن عمر في الوتر روى عنه عبد المؤمن بن خالد(@)(@@)(@@)(@@) $ 3444 - الصلت بن عبد الرحمن الأنصاري المكى يروي عن أبي رافع روى PageV04P378 عنه حبيب بن أبي ثابت وأبو بكر بن نافع العمرى(@)(@@)(@@)(@@) $ 3445 - الصلت بن عمر الدهان يروي عن على روى عنه نصير بن زياد 
ms624	 وكامل بن العلاء(@)(@@)(@@)(@@) $ 3446 - الصلت بن قديد الحنفي وقد قيل بن قويد كنيته أبو الأحمر يروي عن أبي هريرة روى عنه عمار بن محمد(@)(@@)(@@)(@@) $ 3447 - الصلت بن عبد الله المخزومي يروي عن بن عمر روى عنه الأوزاعي(@)(@@)(@@)(@@) $ 3448 - الصلت الحرقى يروي عن على روى عنه عبد الكريم بن أبي المخارق(@)(@@)(@@)(@@) $ 3449 - صفوان بن يعلى بن أمية التيمي القرشي يروي عن أبيه روى PageV04P379 عنه عطاء ومحمد بن جبير بن مطعم(@)(@@)(@@)(@@) $ 3450 - صفوان بن محرز بن زياد المازني من أهل البصرة يروي عن أبي موسى وابن عمر وكان من العباد اتخذ لنفسه سربا يبكى فيه روى عنه الحسن وقتادة ومات سنة أربع وسبعين في ولاية عبد الملك وكنيته أبو عبد الله كان إذا قام إلى تهجده قام معه سكان داره تسجد معه(@)(@@)(@@)(@@) $ 3451 - صفوان بن عبد الله بن صفوان بن أمية بن خلف الجمحي القرشي من أهل مكة يروي عن بن عمر وعمه يعلى بن صفوان وهو الذي يروي عن أم الدرداء روى عنه الزهري(@)(@@)(@@)(@@) $ 3452 - صفوان بن الأصم يروي عن أنس روى عنه الغاز بن جبلة وهو أبو هشام بن الغاز PageV04P380(@)(@@)(@@)(@@) $ 3453 - صفوان مولى عمر بن علي يروي عن أبي هريرة روى عنه عبيد الله بن المغيرة(@)(@@)(@@)(@@) $ 3454 - صباح بن عبد الله أبو شراعة البجلي كوفي همداني يروي عن أنس بن مالك عداده في أهل الكوفة روى عنه أهلها أبو إسحاق السبيعي وغيره(@)(@@)(@@)(@@) $ 3455 - صباح بن ثابت القشيري يروي عن أنس بن مالك روى عنه بن المبارك(@)(@@)(@@)(@@) $ 3456 - صهيب أبو الصهباء البكري من أهل البصرة يروي عن على وابن مسعود وابن عباس روى عنه سعيد بن جبير وطاوس(@)(@@)(@@)(@@) $ 3457 - صهيب مولى العباس بن عبد المطلب يروي عن عثمان وعلى روى عنه أبو صالح السمان(@)(@@)(@@)(@@) $ 3458 - صهيب الحذاء مولى عبد الله بن عامر يروي عن عبد الله بن عمرو روى عنه عمرو بن دينار(@)(@@)(@@)(@@) $ 3459 - صهيب مولى العتواريين من أهل المدينة يروى عن أبى هريرة PageV04P381 وأبي سعيد الخدري روى عنه نعيم بن 
ms625	 عبد الله المجمر(@)(@@)(@@)(@@) $ 3460 - صهيب يروي عن سفينة روى عنه عمرو بن يزيد الأموي(@)(@@)(@@)(@@) $ 3461 - صبيح مولى آل سعيد بن العاص وهو والد مسلم بن صبيح يروي عن أبي هريرة روى عنه أبو يعفور(@)(@@)(@@)(@@) $ 3462 - صبيح مولى زيد بن أرقم ويقال مولى أم سلمة يروي عن زيد بن أرقم روى عنه السدى(@)(@@)(@@)(@@) $ 3463 - صبيح بن عميرة يروي عن عبد الله بن عمرو روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 3464 - صبيح بن عبد الله العبسي يروي عن عمر وعثمان روى عنه سماك بن حرب(@)(@@)(@@)(@@) $ 3465 - صبيح مولى عبد الله بن رباح كان كاتبا لعبد الله بن عمر روى عنه عبد الرحمن بن عبد الله المكي(@)(@@)(@@)(@@) $ 3466 - صعصعة بن صوحان من أهل الكوفة يروي عن على روى عنه PageV04P382 أبو إسحاق وعبد الله بن بريدة وهو أخو زيد بن صوحان يخطىء(@)(@@)(@@)(@@) $ 3467 - صعصعة بن يزيد يروي عن بن عباس روى عنه أبو إسحاق السبيعي(@)(@@)(@@)(@@) $ 3468 - صعصعة بن مالك يروي عن أبي هريرة روى عنه ابنه زفر بن صعصعة(@)(@@)(@@)(@@) $ 3469 - صعصعة بن معاوية عم الأحنف بن قيس يروي عن أبي ذر روى عنه الحسن كنيته أبو أيوب مات في أول ولاية الحجاج على العراق(@)(@@)(@@)(@@) $ 3470 - صلة بن زفر أبو العلاء العبسي من أهل الكوفة يروى عن بن مسعود وحذيفة روى عنه أبو وائل والشعبي مات في خلافة بن الزبير(@)(@@)(@@)(@@) $ 3471 - صلة بن أشيم العدوى أبو الصهباء من عباد أهل البصرة وزهادهم روى عنه أهلها قتل سنة خمس وسبعين بكابل في أول ولاية الحجاج بن يوسف وقد قيل إن أبا الصهباء قتل في ولاية يزيد بن معاوية(@)(@@)(@@)(@@) $ 3472 - صهبان بن عبد الجبار بن مالك اللخمي أبو طلاسة من أهل بيت المقدس سمع عمر بن الخطاب روى عنه أهل فلسطين PageV04P383(@)(@@)(@@)(@@) $ 3473 - صيفى بن صهيب بن سنان مولى بن جدعان التيمي القرشي من النمر بن قاسط يروي عن أبيه روى عنه عمرو بن دينار القهرمان وابناه زياد ويزيد ابنا صيفى(@)(@@)(@@)(@@) $ 3474 - صيفى أبو زياد مولى أفلح مولى أبي 
ms626	 أيوب الأنصاري يروي عن أبي سعيد الخدري وأبي اليسر كعب بن عمرو عداده في أهل المدينة روى عنه عبيد الله بن عمر وسعيد بن أبي هلال(@)(@@)(@@)(@@) $ 3475 - صيفى شيخ يروي عن أبي اليسر كعب بن عمرو روى عنه عبد الله بن سعيد بن أبي هند إن لم يكن الأول فلا أدرى من هو ولا بن من هو(@)(@@)(@@)(@@) $ 3476 - صيفى بن بشر يروي عن أبي موسى الأشعري روى عنه أبو عمران الجوني(@)(@@)(@@)(@@) $ 3477 - صحار بن أبجر بن جابر العجلي يروي عن بن مسعود روى عنه زيد بن أسلم(@)(@@)(@@)(@@) $ 3478 - صخر بن أبي سمية يروي عن عبد الله بن عمرو روى عنه زيد بن أسلم(@)(@@)(@@)(@@) $ 3479 - صخر بن مالك يروي عن أبي أمامة روى عنه زيد بن اسلم(@)(@@)(@@)(@@) $ 3480 - الصبي بن معبد التغلبي من أهل الكوفة يروي عن عمر روى عنه أبو وائل ومجاهد PageV04P384(@)(@@)(@@)(@@) $ 3481 - صعب العنزي ويقال صعيب كنيته أبو العيوف يروي عن أسماء بنت أبي بكر روى عنه أبو الغريف الهمداني ومجمع بن يحيى(@)(@@)(@@)(@@) $ 3482 - صقير العبدي يروي عن سليمان بن صرد وله صحبة روى عنه أبو إسحاق الهمداني(@)(@@)(@@)(@@) $ 3483 - صبيح أبو العلاء يروي عن أنس بن مالك روى عنه حماد بن سلمة وعبد العزيز بن المختار(@)(@@)(@@)(@@) $ 3484 - صديق بن موسى يروي عن رجل من أصحاب النبي صلى الله عليه وسلم ويروي عن المدنيين روى عنه عثمان بن أبي سليمان وابن ابنه عتيق بن يعقوب بن صديق الزبيري(@)(@@)(@@)(@@) $ 3485 - صريع شيخ يروي عن عائشة روى عنه الوليد بن أبي مالك(@)(@@)(@@)(@@) ||| (النساء)(@)(@@)(@@)(@@) $$ 3486 - صفية بنت الحارث تروي عن عائشة لا يقبل الله صلاة امرأة PageV04P385 حاضت بغير خمار روى عنها محمد بن سيرين(@)(@@)(@@)(@@) $$ 3487 - صفية بنت أبي عبيد امرأة عبد الله بن عمر بن الخطاب وهى أخت المختار بن أبي عبيد المتنبي بالعراق تروي عن حفصة وعائشة زوجتي رسول الله صلى الله عليه وسلم روى عنه نافع مولى بن عمر وعمر بن عثمان بن عبد الدار القرشي(@)(@@)(@@)(@@) $$ 3488 - صفية بنت شيبة بن 
ms627	 عثمان بن طلحة الحجبي تروي عن عائشة وأم حبيبة عدادها في أهل المدينة روى عنها نافع وابنها منصور بن عبد الرحمن(@)(@@)(@@)(@@) $$ 3489 - صفية بنت بحرة قالت رأيت لأبي محذورة قصة في مقدم رأسه يرسلها فقلت له ألا تحلقها قال لا إن رسول الله صلى الله عليه وسلم وضع يده عليها روى عنها أيوب بن ثابت(@)(@@)(@@)(@@) $$ 3490 - صميتة خالة أبي نعامة العدوى تروي عن جدها سلمان بن عامر روى عنها أبو نعامة العدوى PageV04P386(@)(@@)(@@)(@@) || (باب الضاد)(@)(@@) قال أبو حاتم وممن شافه الصحابة وروى عنهم ممن ابتدأ اسمه على الضاد(@)(@@)(@@)(@@) $ 3491 - الضحاك بن قيس الكندي يروي عن عمر بن الخطاب روى عنه محمد بن المنتشر والمسعودي قتل في سنة سبع وعشرين ومائة وذلك أنه لم يبايع مروان بن محمد الحمار فاجتمع إليه جلة الناس والتقى هو ومروان بنصيبن فقالوا للضحاك والله ما اجتمع إلى داع دعي إلى هذا الرأي منذ كان الإسلام ما اجتمع معك فتأخر وقدم خيلك ورجلك وتلقى هذه الطاغية فقال إي والله ما لي في دنياكم هذه حاجة وإنما أردت هذه الطاغية لله على أن رأيته أن أحمل عليه حتى يحكم الله بيني وبينه وعلى الدين سبعة دراهم وفي كمي منها ثلاثة دراهم ثم اقتتلوا فقتل الضحاك في المعركة سنة سبع وعشرين ومائة(@)(@@)(@@)(@@) $ 3492 - الضحاك بن عبد الرحمن بن عرزب الشامي الأشعري من أهل الشام كنيته أبو زرعة يروي عن أبي موسى وأبي هريرة وواثلة روى عنه مكحول وأهل الشام وهو الذي يقال له بن عزرم بالميم والصحيح بالباء وكان يسكن قرية يقال لها كوكب من كورة نابلس من تخوم الأردن(@)(@@)(@@)(@@) $ 3493 - الضحاك بن فيروز الديلمي يروي عن أبيه روى عنه أبو وهب الجيشاني PageV04P387(@)(@@)(@@)(@@) $ 3494 - الضحاك بن رباح يروي عن بن عمر روى عنه يحيى بن أبي عمرو الشيباني(@)(@@)(@@)(@@) $ 3495 - الضحاك بن عبد الله القرشي يروي عن أنس بن مالك روى عنه بكير بن الأشج(@)(@@)(@@)(@@) $ 3496 - الضحاك بن زميل الأملوكي يروي عن بن عباس روى عنه عياش بن عباس القتباني 
ms628	(@)(@@)(@@)(@@) $ 3497 - الضحاك بن شرحبيل المشرقي يروي عن أبي سعد الخدري روى عنه الزهري وحبيب بن أبى ثابت ويقال بن شراحيل(@)(@@)(@@)(@@) $ 3498 - الضحاك بن شرحبيل العكي أصله من عكة انتقل إلى مصر يروي عن بن عمر روى عنه موسى بن أيوب الغافقي(@)(@@)(@@)(@@) $ 3499 - ضمرة بن عبد الله بن أنيس الجهني يروي عن أبيه روى عنه الزهري(@)(@@)(@@)(@@) $ 3500 - ضمرة بن سعيد المازني الأنصاري من أهل المدينة يروي عن أبي سعيد الخدري روى عنه مالك وابن عيينة(@)(@@)(@@)(@@) $ 3501 - ضمرة بن حبيب بن صهيب الزبيدي الشامي كنيته أبو عتبة وقد قيل أبو بشر يروي عن أبي أمامة وسلمة بن نفيل السكوني PageV04P388 روى عنه هلال بن يساف والشاميون مات سنة ثلاثين ومائة وكان مؤذن مسجد دمشق(@)(@@)(@@)(@@) $ 3502 - ضمضم بن الحارث بن جوس الهفاني يروي عن أبي هريرة روى عنه يحيى بن أبي كثير وعكرمة بن عمار ومن قال ضمضم بن جوس فقد نسبه إلى جده(@)(@@)(@@)(@@) $ 3503 - ضمضم أبو المثنى الأملوكي الحمصي من أهل الشام يروي عن عتبة بن عبد السلمي وهذا الذي يقال له المليكي روى عنه صفوان بن عمرو(@)(@@)(@@)(@@) $ 3504 - ضمضم بن عمرو الحنفي كنيته أبو الأسود يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه التبوذكي(@)(@@)(@@)(@@) $ 3505 - ضرار بن عمران البرجمي سألت بن عمر فقلت رجل له امرأة وله أم ولد يقسم لها كما يقسم للحرة قال أليست أمة قال نعم قال فلا رواه بن المبارك عن الأصبغ بن علقمة عن ضرار بن عمران وقال الفضل بن موسى عن الأصبغ بن علقمة عن ضرار بن عبد الرحمن قال سألت بن عمر PageV04P389(@)(@@)(@@)(@@) $ 3506 - ضرار بن مسلم الباهلي يروي عن أنس بن مالك روى عنه عمر بن أبي خليفة(@)(@@)(@@)(@@) $ 3507 - ضبة بن محصن العنزي من أهل البصرة يروي عن أبي هريرة وأم سلمة روى عنه قتادة والحسن وعبد الرحمن بن أبي ليلى وقد سمع عمر بن الخطاب(@)(@@)(@@)(@@) $ 3508 - ضريب بن نقير بن سمير القيسي من قيس بن ثعلبة أبو السليل الجريري من 
ms629	 أهل البصرة يروي عن أبي ذر روى عنه كهمس بن الحسن وسعيد بن إياس الجريري ثنا أبو قتيبة بن أبي السري قال ثنا معتمر بن سليمان قال ثنا كهمس بن الحسن عن أبي السليل عن أبي ذر قال جعل نبي الله يقرأ هذه الآية ومن يتق الله يجعل له مخرجا ويرزقه من حيث لا يحتسب ثم قال يا أبا ذر لو أن الناس أخذوا بها لكفتهم(@)(@@)(@@)(@@) $ 3509 - ضبيعة بن حصين يروي عن حذيفة روى عنه أبو بردة PageV04P390(@)(@@)(@@)(@@) $ 3510 - الضوء بن الصلصال بن الدلهمس يروي عن أبيه وله صحبة روى عنه ابنه محمد بن الضوء يعتبر حديثه من غير رواية ابنه عنه(@)(@@)(@@)(@@) || (باب الطاء)(@)(@@) قال أبو حاتم وممن شافه الصحابة وروى عنهم ممن ابتدأ اسمه على الطاء(@)(@@)(@@)(@@) $ 3511 - طاوس بن كيسان اليماني الهمداني كنيته أبو عبد الرحمن أمه من أبناء فارس وأبوه من النمر بن قاسط مولى بحير الحميري يروي عن بن عمر وابن عباس كان من عباد أهل اليمن ومن فقهائهم ومن سادات التابعين روى عنه عمرو بن دينار والناس مرض بمنى مات بمكة سنة إحدى ومائة قبل التروية بيوم قبل مجاهد بسنتين وصلى عليه هشام بن عبد الملك بين الركن والمقام وقد قيل إنه مات سنة ست ومائة وكان طاوس قد حج أربعين حجة وكان مستجاب الدعوة فيما قيل PageV04P391(@)(@@)(@@)(@@) $ 3512 - طلحة بن عبد الله بن عوف بن عبد عوف الزهري بن أخي عبد الرحمن بن عوف يروي عن أبي هريرة وعمه كنيته أبو عبد الله وكان فقيها يكتب الوثائق وكان يقال له طلحة الندى لجوده روى عنه الزهري مات بالمدينة سنة سبع وتسعين وهو بن ثنتين وسبعين سنة وأمه فاطمة بنت مطيع بن الأسود(@)(@@)(@@)(@@) $ 3513 - طلحة بن عبد الله بن عثمان بن عبيد الله بن معمر التيمي يروي عن عائشة روى عنه أبو عمران الجوني وسعد بن إبراهيم(@)(@@)(@@)(@@) $ 3514 - طلحة بن عبد الله بن عبد الرحمن بن أبي بكر الصديق يروي عن عائشة وأسماء بنتى أبي بكر روى عنه 
ms630	 عثمان بن أبي سليمان وابنه محمد بن طلحة(@)(@@)(@@)(@@) $ 3515 - طلحة بن هلال العامري يروي عن عبد الله بن عمرو روى عنه سعد بن إبراهيم ثنا عمر بن محمد الهمداني ثنا أبو الأشعث أحمد بن المقدام العجلي ثنا محمد بن بكر البرساني عن شعبة عن سعد بن إبراهيم قال سمعت طلحة بن هلال رجلا من بني عامر قال سمعت عبد الله بن عمرو يقول قال رسول الله صلى الله عليه وسلم يا عبد الله بن عمرو صم صيام الدهر من جاء بالحسنة فله عشر أمثالها فقلت إني أطيق أكثر PageV04P392 من ذلك قال صم صيام داود وكان يصوم يوما ويفطر يوما(@)(@@)(@@)(@@) $ 3516 - طلحة بن عبيد الله بن كريز الكعبي الخزاعي عداده في أهل المدينة يروي عن رجل من أصحاب النبي صلى الله عليه وسلم روى عنه محمد بن سوقة(@)(@@)(@@)(@@) $ 3517 - طلحة بن نافع المكي أبو سفيان مولى قريش يروي عن جابر بن عبد الله وأبي سعيد الخدري روى عنه الأعمش وعتبة بن أبي حكيم والناس وكان الأعمش يدلس عنه(@)(@@)(@@)(@@) $ 3518 - طلحة بن مصرف بن كعب بن عمرو بن جحدب بن معاوية بن سعد بن الحارث من ذهل بن سلمة كنيته أبو عبد الله الإيامي من أهل الكوفة يروي عن بن أبي أوفى وأنس روى عنه أهل الكوفة مات سنة ثنتي عشرة ومائة قبل زبيد بعشر سنين ثنا أبو قحطبة قال ثنا العباس بن عبد العظيم العنبري قال ثنا أبو مهدي عن مالك بن مغول عن طلحة بن مصرف قال سألت بن أبي أوفى هل أوصى رسول الله صلى الله عليه وسلم قال لا قلت فلم كتب على الناس الوصية قال أوصى بكتاب الله PageV04P393(@)(@@)(@@)(@@) $ 3519 - طلحة بن يزيد الأنصاري يروي عن زيد بن أرقم روى عنه عمرو بن مرة(@)(@@)(@@)(@@) $ 3520 - طلحة بن أبي حدرد يروي المراسيل روى عنه محمد بن معن الغفاري عن عمه عنه(@)(@@)(@@)(@@) $ 3521 - طلحة بن خراش بن عبد الرحمن بن خراش بن الصمة السلمي الأنصاري من أهل المدينة يروي عن 
ms631	 جابر بن عبد الله روى عنه موسى بن إبراهيم بن كثير بن بشير بن الفاكه الأنصاري ويحيى بن عبد الله بن يزيد بن أنيس(@)(@@)(@@)(@@) $ 3522 - طلحة بن أبي طلحة العنبري يروي عن أنس بن مالك روى عنه محمد بن ثابت(@)(@@)(@@)(@@) $ 3523 - طلحة بن العلاء أبو العلاء يروي عن بن عمر روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 3524 - طلحة بن جبر شيخ يروي عن أبي جحيفة روى عنه وكيع PageV04P394(@)(@@)(@@)(@@) $ 3525 - طلحة بن رافع يروي المراسيل روى عنه صالح بن كيسان(@)(@@)(@@)(@@) $ 3526 - طلحة بن أبي حفصة الحضرمي يروي عن عمر روى عنه عبد الله بن كثير ويقال بن أبي حفصة(@)(@@)(@@)(@@) $ 3527 - طارق بن عبد الرحمن البجلي من أهل الكوفة يروي عن بن أبي أوفى روى عنه الثوري وشعبة(@)(@@)(@@)(@@) $ 3528 - طارق بن عبد الرحمن بن القاسم القرشي يروي عن ميمونة روى عنه عكرمة بن عمار مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 3529 - طارق بن قرة يروي عن على روى عنه شبيب بن غرقدة(@)(@@)(@@)(@@) $ 3530 - طارق بن أحمر يروي عن بن عمر روى عنه عبد الكريم بن مالك(@)(@@)(@@)(@@) $ 3531 - طارق بن مخاشن الأسلمي يروي عن أبي ذر روى عنه الزهري(@)(@@)(@@)(@@) $ 3532 - طارق بن زياد يروي عن على روى عنه إبراهيم بن عبد الأعلى(@)(@@)(@@)(@@) $ 3533 - طريف بن مجالد أبو تميمة الهجيمي من أهل البصرة يروى PageV04P395 عن أبي موسى وأبي هريرة روى عنه قتادة وحكيم الأثرم مات سنة خمس وتسعين وقد قيل سنة سبع وتسعين(@)(@@)(@@)(@@) $ 3534 - طريف البراد يروي عن أبي هريرة روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 3535 - طريف بن يزيد الحنفي يروي عن أبي موسى روى عنه أهل اليمامة(@)(@@)(@@)(@@) $ 3536 - طريف يروي عن على روى عنه ابناه محمد وموسى ابني طريف(@)(@@)(@@)(@@) $ 3537 - طريف العكي يروي عن علي قال من عرض عرضنا له بالسيف روى عنه جابر الجعفي لست أدري أهو الأول أم لا(@)(@@)(@@)(@@) $ 3538 - طريف البراد يروي عن أبي هريرة روى عنه محمد بن عبد الرحمن بن عبد الله(@)(@@)(@@)(@@) $ 3539 - طريف يروي عن بن عباس روى 
ms632	 عنه الأعمش(@)(@@)(@@)(@@) $ 3540 - طلق بن خشاف من بنى بكر بن وائل ثم من بنى قيس بن ثعلبة يروي عن عثمان وعائشة روى عنه سواد بن مسلم ومسلم بن أبي الأسود(@)(@@)(@@)(@@) $ 3541 - طلق بن حبيب العنزي يروي عن جابر وابن الزبير وأنس وكان PageV04P396 عابدا مرجيا روى عنه أيوب وعمرو بن دينار(@)(@@)(@@)(@@) $ 3542 - طليق بن محمد شيخ يروي عن عمران بن حصين روى عنه سليمان التيمي(@)(@@)(@@)(@@) $ 3543 - طليق بن قيس أخو عبد الرحمن بن قيس أبي صالح يروي عن أبي الدرداء وابن عباس روى عنه عبد الله بن الحارث(@)(@@)(@@)(@@) $ 3544 - الطفيل بن سخبرة من أزد شنوءة أخو عائشة لأمها أمهما أم رومان وهو يروي عن عائشة روى عنه الزهري(@)(@@)(@@)(@@) $ 3545 - الطفيل بن أبي بن كعب الأنصاري المدني يروي عن أبيه وابن عمر روى عنه عبد الله بن محمد بن عقيل وكان صديقا لابن عمر كنيته أبو بطن أمه بنت طفيل بن عمرو وقد كان عظيم البطن يكنى به PageV04P397(@)(@@)(@@)(@@) $ 3546 - طالوت بن أبي بكر بن خالد بن عرفطة العرفطي حليف بنى زهرة يروي عن عمر روى النضر بن إسماعيل عن أبي طالوت عنه روى علي بن مسمى عن عبد الرحمن بن إسحاق عن طالوت بن أبى بكر عن بن عباس(@)(@@)(@@)(@@) $ 3547 - طالوت أبو سعيد القرشي يروي عن بن عباس روى عنه العلاء بن المسيب(@)(@@)(@@)(@@) $ 3548 - طرفة المسلي يروي عن على وحذيفة روى عنه سالم بن أبي الجعد(@)(@@)(@@)(@@) $ 3549 - طرفة الحضرمي يروي عن بن أبي أوفى روى عنه محمد بن جحادة(@)(@@)(@@)(@@) $ 3550 - طيسلة بن مياس يروي عن بن عمر روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 3551 - طيسلة المحاربي يروي عن أعشى بنى مازن روى عنه ابنه صدقة بن طيسلة PageV04P398(@)(@@)(@@)(@@) $ 3552 - طيسلة بن علي البهدلي من أهل اليمامة يروي عن بن عمر في الكبار السبع روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 3553 - طحرب شيخ يروي عن الحسن بن علي روى عنه مجالد بن سعيد(@)(@@)(@@)(@@) ||| (النساء)(@)(@@)(@@)(@@) $$ 3554 - طليحة بنت ربيعة بن الحارث تروى عن عائشة روى عنها 
ms633	 أهل الكوفة حدثنا بن مكرم ثنا معمر بن سهل قال ثنا عامر بن مدرك قال ثنا عيسى بن عبد الرحمن البجلي عن أمه طليحة بنت ربيعة بن الحارث قالت سألت عائشة عن العمرة في ذي الحجة فقالت أنا اعتمرت في ذي الحجة فقلت يا رسول الله أحرم نساءك بحجة وعمرة غيري فأمر أخي فأخرجنى التنعيم PageV04P399(@)(@@)(@@)(@@) || (باب الظاء)(@)(@@) قال أبو حاتم وممن سمع من الصحابة وروى عنهم ممن ابتدأ اسمه على الظاء(@)(@@)(@@)(@@) $ 3555 - ظبيان بن صبيح الضبي يروى عن بن مسعود قال لا يقام الحد في المسجد روى عنه مبارك بن فضالة(@)(@@)(@@)(@@) $ 3556 - ظبيان بن عمارة الكوفي يروي عن على روى عنه سويد أبو قطبة(@)(@@)(@@)(@@) $ 3557 - ظالم بن عمرو بن جندل بن سفيان بن يعمر بن حلبس بن نفاتة بن عدى بن الديل أبو الأسود الديلي يروي عن عمران بن حصين روى عنه أهل البصرة وقد قيل اسم أبي الأسود عمرو بن ظالم وشهد مع على صفين وولى البصرة لابن عباس ومات بها وقد أسن وهو أول من تكلم في النحو(@)(@@)(@@)(@@) $ 3558 - أبو صفرة العتكي والد المهلب بن أبي صفرة اسمه ظالم بن بشر بن صبح أدرك جماعة من الصحابة روى عنه ابنه المهلب PageV04P3400(@)(@@)(@@)(@@) || (باب العين)(@)(@@) قال أبو حاتم وممن روى عن الصحابة وشافههم في الأقاليم ممن ابتدأ اسمه على العين(@)(@@)(@@)(@@) $ 3559 - أبو سلمه بن عبد الرحمن بن عبد عوف بن الحارث بن زهرة بن كلاب بن مرة بن كعب بن لؤي بن غالب الزهري القرشي وأمه تماضر بنت الأصبغ بن عمرو بن ثعلبة بن حصين بن ضمضم بن عدى بن كلب وهى أول كلبيه تزوجها قرشي في الإسلام وذاك أن رسول الله صلى الله عليه وسلم بعث عبد الرحمن بن عوف إلى كلب وأمره أن يتزوج بنت سيدهم وكان الاصبغ سيدهم فتزوج بابنته كان مالك بن أنس يقول أبو سلمه بن عبد الرحمن اسمه كنيته وقال محمد بن عمرو اسمه عبد الله يروي عن بن عباس وأبي هريرة وابن عمر 
ms634	 PageV05P001 روى عنه الزهري والناس وكان من سادات قريش مات سنة أربع ومائة وقد قيل سنة أربع وتسعين(@)(@@)(@@)(@@) $ 3560 - عبد الله بن عبيد الله بن أبي مليكه بن عبد الله بن جدعان بن عمرو بن كعب القرشي التيمي كنيته أبو بكر وقد قيل أبو محمد وكان أحول رأى ثمانين من أصحاب النبي صلى الله عليه وسلم وأمه ميمونه بنت الوليد بن أبي حسين بن عامر بن الحارث بن نوفل بن عبد مناف المليكي يروى عن بن عباس وابن الزبير وعائشه روى عنه بن جريج والناس مات سنة سبع عشرة ومائة وقد قيل سنة ثمان عشرة ومائه واسم أبي مليكه زهير بن عبد الله بن جدعان(@)(@@)(@@)(@@) $ 3561 - أبو قلابة عبد الله بن زيد الجرمي من عباد أهل البصرة وزهادهم يروي عن أنس بن مالك ومالك بن الحويرث روى عنه أيوب وخالد PageV05P002 مات بالشام سنة أربع ومائة في ولاية يزيد بن عبد الملك حدثني بقصة موته محمد بن المنذر بن سعيد قال ثنا يعقوب بن إسحاق بن الجراح قال ثنا الفضل بن عيسى عن بقية بن الوليد قال ثنا الأوزاعي عن عبد الله بن محمد قال خرجت إلى ساحل البحر مرابطا وكان رابطنا يومئذ عريش مصر قال فلما انتهيت إلى الساحل فإذا أنا ببطيحة وفي البطيحة خيمة فيها رجل قد ذهب يداه ورجلاه وثقل سمعه وبصره وما له من جارحة تنفعه إلا لسانه وهو يقول اللهم أوزعني أن أحمدك حمدا أكافىء به شكر نعمتك التي أنعمت بها علي وفضلتني على كثير ممن خلقت تفضيلا قال الأوزاعي قال عبد الله قلت والله لآتين هذا الرجل ولأسألنه أنى له هذا الكلام فهم أم علم أم إلهام ألهم فأتيت الرجل فسلمت عليه فقلت سمعتك وأنت تقول اللهم أوزعني أن أحمدك حمدا أكافىء به شكر نعمتك التي أنعمت بها علي وفضلتني على كثير من خلقت تفضيلا فأي نعمة من نعم الله عليك تحمده عليها وأي فضيلة تفضل بها عليك تشكره عليها قال وما ترى ما صنع ربي 
ms635	 والله لو أرسل السماء علي نارا فأحرقتني وأمر الجبال فدمرتني وأمر البحار فغرقتني وأمر الأرض فبلعتني ما ازددت لربي إلا شكرا لما أنعم علي من لساني هذا ولكن يا عبد الله إذ أتيتني لي إليك حاجة قد تراني على أي حالة أنا أنا لست أقدر لنفسي على ضر ولا نفع ولقد كان معي بني لي يتعاهدني في وقت صلاتي فيوضيني PageV05P003 وإذا جعت أطعمني وإذا عطشت سقاني ولقد فقدته منذ ثلاثة أيام فتحسسه لي رحمك الله فقلت والله ما مشى خلق في حاجة خلق كان أعظم عند الله أجرا ممن يمشي في حاجة مثلك فمضيت في طلب الغلام فما مضيت غير بعيد حتى صرت بين كثبان من الرمل فإذا أنا بالغلام قد افترسه سبع وأكل لحمه فاسترجعت وقلت أنى لي وجه رقيق آتي به الرجل فبينما أنا مقبل نحوه إذ خطر على قلبي ذكر أيوب النبي صلى الله عليه وسلم فلما أتيته سلمت عليه فرد علي السلام فقال ألست بصاحبي قلت بلى قال ما فعلت في حاجتي فقلت أنت أكرم على الله أم أيوب النبي قال بل أيوب النبي قلت هل علمت ما صنع به ربه أليس قد ابتلاه بماله وآله وولده قال بلى قلت فكيف وجده قال وجده صابرا شاكرا حامدا قلت لم يرض منه ذلك حتى أوحش من أقربائه وأحبائه قال نعم قلت فكيف وجده ربه قال وجده صابرا شاكرا حامدا قلت فلم يرض منه بذلك حتى صيره عرضا لمار الطريق هل علمت قال نعم قلت فكيف وجده ربه قال صابرا شاكرا حامدا أوجز رحمك الله قلت له إن الغلام الذي أرسلتني في طلبه وجدته بين كثبان الرمل وقد افترسه سبع فأكل لحمه فأعظم الله لك الأجر وألهمك الصبر فقال المبتلى الحمد لله الذي لم يخلق من ذريتي خلقا يعصيه فيعذبه بالنار ثم استرجع وشهق شهقة فمات فقلت إنا لله وإنا إليه راجعون عظمت PageV05P004 مصيبتي رجل مثل هذا إن تركته أكلته السباع وإن قعدت لم أقدر على ضر ولا 
ms636	 نفع فسجيته بشملة كانت عليه وقعدت عند رأسه باكيا فبينما أنا قاعد إذ تهجم علي أربعة رجال فقالوا يا عبد الله ما حالك وما قصتك فقصصت عليهم قصتي وقصته فقالوا لي اكشف لنا عن وجهه فعسى أن نعرفه فكشفت عن وجهه فانكب القوم عليه يقبلون عينيه مرة ويديه أخرى ويقولون بأبي عين طال ما غضت عن محارم الله وبأبي وجسمه طال ما كنت ساجدا والناس نيام فقلت من هذا يرحمكم الله فقالوا هذا أبو قلابة الجرمي صاحب بن عباس لقد كان شديد الحب لله وللنبي صلى الله عليه وسلم فغسلناه وكفناه بأثواب كانت معنا وصلينا عليه ودفناه فانصرف القوم وانصرفت إلى رباطي فلما أن جن علي الليل وضعت رأسي فرأيته فيما يرى النائم في روضة من رياض الجنة وعليه حلتان من حلل الجنة وهو يتلو الوحي سلام عليكم بما صبرتم فنعم عقبى الدار فقلت ألست بصاحبي قال بلى قلت أنى لك هذا قال إن لله درجات لا تنال إلا بالصبر عند البلاء والشكر عند الرخاء مع خشية الله عز وجل في السر والعلانية(@)(@@)(@@)(@@) $ 3562 - عبد الله بن نوفل بن الحارث بن عبد المطلب أخو الحارث بن نوفل كنيته أبو محمد يروي عن عمر بن الخطاب وجماعة من الصحابة روى عنه أهل المدينة وهو أول قاض كان بالمدينة من التابعين أمه PageV05P005 ضريبة بنت سعيد بن جندب بن عبد الله بن رافع قتل يوم الجمعة سنة ثلاث وستين(@)(@@)(@@)(@@) $ 3563 - عبد الله بن محيرز القرشي كان يتيما في حجر أبي محذوره يروي عن أبي سعيد الخدري وأبي محذوره سكن فلسطين وكان من العباد وكان يشبه بعبد الله بن عمر روى عنه الزهري ومكحول وابنه عبد الرحمن بن محيريز مات في ولاية الوليد بن عبد الملك(@)(@@)(@@)(@@) $ 3564 - عبد الله بن كعب بن مالك السلمي الأنصاري يروي عن أبيه وابن عباس عداده في أهل المدينة روى عنه الزهري مات سنة سبع أو ثمان وتسعين في ولاية سليمان بن عبد الملك(@)(@@)(@@)(@@) $ 3565 - عبد الله بن مطرف 
ms637	 بن عبد الله بن الشخير العامري كنيته أبو جزىء يروي عن أبي برزة روى عنه حميد بن هلال مات قبل أبيه(@)(@@)(@@)(@@) $ 3566 - عبد الله بن عبد الله بن عمر بن الخطاب أخو عبيد الله بن عبد الله PageV05P006 كنيته أبو عبد الرحمن يروي عن أبيه يروي عنه القاسم بن محمد والزهري ونافع مات سنة خمس ومائة أول ما استخلف هشام بن عبد الملك وكان أوصى إليه عبد الله بن عمر وأمه صفية بنت أبي عبيد بن مسعود بن عمرو الثقفي(@)(@@)(@@)(@@) $ 3567 - عبد الله بن محمد بن أبي بكر الصديق أخو القاسم بن محمد يروي عن عائشة روى عنه الزهري ونافع(@)(@@)(@@)(@@) $ 3568 - عبد الله بن أبي زكريا الشامي واسم أبيه إياس بن يزيد من العرب يروي عن معاوية كنيته أبو يحيى وكان من العباد روى عنه أهل الشام مات في ولاية هشام بن عبد الملك وهو من الخزاعة كان يقول عالجت لساني عشرين سنة حتى استقام(@)(@@)(@@)(@@) $ 3569 - عبد الله بن عامر بن كريز بن ربيعة بن حبيب بن عبد شمس بن عبد مناف عامل عثمان بن عفان على البصرة يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه الناس مات بمكة ودفن PageV05P007 بعرفات سنة تسع وخمسين قبل وفاة معاوية بسنة وكنيته أبو عبد الرحمن وقد قيل إن له من النبي صلى الله عليه وسلم رؤية وهو الذي افتتح عامة فارس وخراسان وسجستان(@)(@@)(@@)(@@) $ 3570 - عبد الله بن خالد بن أسيد بن أبي العيص بن أمية يروي عن جماعه من الصحابة روى عنه أهل الحجاز أمه ريطة بنت عبد الله بن خزاعي بن الحويرث(@)(@@)(@@)(@@) $ 3571 - عبد الله بن سليمان بن زيد بن ثابت الخزرجي الأنصاري أخو سعيد بن سليمان يروي عن أنس بن مالك عداده في أهل المدينة روى عنه ابنه خارجه بن عبد الله(@)(@@)(@@)(@@) $ 3572 - عبد الله بن سعد بن أبي وقاص الزهري القرشي أخو عامر وسعد ومصعب وعمر ويحيى وإبراهيم ومحمد بني سعد بن أبي وقاص يروي عن 
ms638	 أبي أيوب عداده في أهل المدينة روى عنه خارجة بن عبد الله(@)(@@)(@@)(@@) $ 3573 - عبد الله بن حنين مولى عباس بن عبد المطلب ويقال مولى PageV05P008 علي روى عنه ابنه إبراهيم بن عبد الله بن حنين مات في ولاية يزيد بن عبد الملك والصحيح أنه مولى مثقب ومثقب مولى مسحل ومسحل مولى شماس وشماس مولى العباس بن عبد المطلب ولذلك قيل مولى العباس(@)(@@)(@@)(@@) $ 3574 - عبد الله بن الحارث بن نوفل الهاشمي يروي عن بن عباس وميمونة روى عنه ابناه إسحاق وعبد الله ويزيد بن أبي زياد توفى سنة تسع وسبعين قتله السموم ودفن بالأبواء وصلى عليه سليمان بن عبد الملك وهو عبد الله بن الحارث بن نوفل بن الحارث بن عبد المطلب كنيته أبو محمد من فقهاء أهل المدينة وقد قيل إنه مات بعمان(@)(@@)(@@)(@@) $ 3575 - أبو عبد الرحمن السلمي اسمه عبد الله بن حبيب عداده في أهل الكوفة يروي عن عثمان وعلى وابن مسعود روى عنه الكوفيون مات سنة أربع وسبعين في ولاية بشر بن مروان على العراق وقد قيل سنة اثنتين وسبعين وزعم شعبة أن أبا عبد الرحمن لم يسمع من عثمان ولا عبد الله وسمع عليا PageV05P009(@)(@@)(@@)(@@) $ 3576 - عبد الله بن عبد الرحمن بن أبي بكر الصديق عداده في أهل المدينة يروي عن أم سلمه روى عنه زيد بن عبد الله بن عمر(@)(@@)(@@)(@@) $ 3577 - عبد الله بن دينار مولى بن عمر عداده في أهل المدينة يروي عن بن عمر روى عنه مالك وشعبه والثوري مات سنة سبع وعشرين ومائه(@)(@@)(@@)(@@) $ 3578 - عبد الله بن قيس بن مخرمة يروي عن زيد بن خالد الجهني روى عنه أبو بكر بن محمد بن عمرو بن حزم(@)(@@)(@@)(@@) $ 3579 - عبد الله بن شقيق العقيلي عداده في أهل البصرة يكنى أبا عبد الرحمن وقيل أبا عامر يروي عن عائشة وأبي هريرة روى عنه الجريري وخالد الحذاء مات سنة ثمان ومائه وهو والد عامر العقيلي الذي روى عنه يحيى بن أبي كثير(@)(@@)(@@)(@@) $ 3580 - عبد الله بن عبيد بن عمير 
ms639	 بن قتادة الليثي كنيته أبو هاشم عداده في أهل مكة يروي عن بن عمر وأبيه روى عنه الزهري والناس وهو PageV05P010 والد محمد بن عبد الله بن عبيد بن عمير ومات عبد الله بن عبيد سنة ثلاث عشرة ومائه وكان مستجاب الدعوة كانت السحابة ربما مرت به أقسمت عليك ألا تمطرين فتمطر(@)(@@)(@@)(@@) $ 3581 - أبو سنان الأسدي عبد الله بن سنان كوفي يروي عن بن مسعود روى عنه أهل الكوفة مات في ولاية الحجاج بن يوسف قبل الجماجم(@)(@@)(@@)(@@) $ 3582 - عبد الله بن إبراهيم بن قارظ الزهري من أهل المدينة يروي عن أبي هريرة روى عنه الزهري(@)(@@)(@@)(@@) $ 3583 - عبد الله بن أبي أيوب الأنصاري أخو خالد بن أبي أيوب يروي عن أبيه روى عنه ابنه بشر بن عبد الله بن أبي أيوب(@)(@@)(@@)(@@) $ 3584 - عبد الله بن خباب بن الأرت حليف بني زهره يروي عن أبيه روى الزهري عن عبد الله بن عبد الله بن الحارث بن نوفل عنه قتل زمن علي بن أبي طالب رضي الله عنه(@)(@@)(@@)(@@) $ 3585 - عبد الله بن خباب مولى بني عدي بن النجار الأنصاري عداده في أهل المدينة يروي عن أبي سعيد الخدري روى عنه القاسم بن محمد ويزيد بن الهاد(@)(@@)(@@)(@@) $ 3586 - عبد الله بن أنس بن مالك الأنصاري من أهل البصرة يروى عن PageV05P011 أبيه روى عنه يزيد الرشك(@)(@@)(@@)(@@) $ 3587 - عبد الله بن سلمة يروي عن علي بن أبي طالب روى عنه عمرو بن مرة يخطأ(@)(@@)(@@)(@@) $ 3588 - عبد الله بن حفص بن عمر بن سعد الزهري القرشي كنيته أبو بكر يروي عن بن عمر وكان راويا لعروة روى عنه شعبة وابن جريج(@)(@@)(@@)(@@) $ 3589 - عبد الله بن فروخ مولى آل طلحة بن عبيد الله يروي عن أم سلمه وطلحه بن عبيد الله روى عنه طلحة بن يحيى(@)(@@)(@@)(@@) $ 3590 - عبد الله بن بديل بن ورقاء الخزاعي يروي عن جماعة من أصحاب رسول الله صلى الله عليه وسلم قتل يوم صفين في أصحاب علي بن أبي طالب وهو عبد الله بن بديل 
ms640	 بن ورقاء بن عبد العزى بن مازن بن عدي بن عمرو بن ربيعة بن حارثة وهو خزاعه وقد قيل انه قتل يوم الجمل(@)(@@)(@@)(@@) $ 3591 - عبد الله بن مخرمه أبو مخرمه من أهل الشام يرويه عن جماعة من الصحابة روى عنه أهل الشام PageV05P012(@)(@@)(@@)(@@) $ 3592 - عبد الله بن الخليل الحضري عداده من أهل الكوفة يروي عن زيد بن أرقم روى عنه الشعبي(@)(@@)(@@)(@@) $ 3593 - عبد الله بن أوس الخزاعي يروي عن بريده الأسلمي روى عنه إسماعيل بن أبي خالد(@)(@@)(@@)(@@) $ 3594 - عبد الله بن باباه المكي مولى آل حجير بن أبي إهاب وهو الذي يقال له بن بابي يروي عن جبير بن مطعم وعبد الله بن عمرو روى عنه عمرو بن دينار وأبو الزبير وابن أبي نجيح(@)(@@)(@@)(@@) $ 3595 - عبد الله بن أبي طلحة الأنصاري واسم أبي طلحة زيد بن سهل من أهل بدر يروي عن أبيه روى عنه ابنه إسحاق بن عبد الله بن أبي طلحة(@)(@@)(@@)(@@) $ 3596 - عبد الله بن عبد الرحمن بن أبي صعصعه المازني الأنصاري من أهل المدينة يروي عن أبي سعيد الخدري روى عنه ابناه محمد وعبد الرحمن(@)(@@)(@@)(@@) $ 3597 - عبد الله بن الأغر يروي عن بن مسعود روى عنه أبو إسحاق السبيعي PageV05P013(@)(@@)(@@)(@@) $ 3598 - عبد الله بن الأشج يروي عن بن عباس روى عنه ابنه بكير بن عبد الله بن الأشج(@)(@@)(@@)(@@) $ 3599 - عبد الله بن إسحاق بن حازم يروي عن أنس بن مالك روى عنه الربيع بن حطان(@)(@@)(@@)(@@) $ 3600 - أبو الزعراء الأعدل الكبير اسمه عبد الله بن هانئ الهمداني من أهل الكوفة يروي عن بن مسعود روى عنه سلمه بن كهيل(@)(@@)(@@)(@@) $ 3601 - عبد الله بن شرحبيل بن حسنه قرشي يروي عن عثمان بن عفان روى عنه الزهري وسعد بن إبراهيم(@)(@@)(@@)(@@) $ 3602 - عبد الله بن عبد الرحمن الأشهلي من أهل المدينة يروي عن حذيفه روى عنه عمرو بن أبي عمرو مولى المطلب(@)(@@)(@@)(@@) $ 3603 - عبد الله بن السائب بن خلاد يروي عن أبيه وأمه أنيسة بنت ثعلبة(@)(@@)(@@)(@@) $ 3604 - أبو عامر الجيشاني اسمه عبد الله 