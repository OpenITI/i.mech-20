ms321	 نیست مه نو که دگر ساقی دور %~% جام لبریز به کف از می رخشان دارد(@)(@@) 4 برمه عید نخواهم نظر کس که تمام %~% صورت دایره غبغب جانان دارد(@)(@@) 5 شب عید است و دگر شاطر گردان ز هلال %~% کشتی نقره به دست از پی دوران دارد(@)(@@) 6 سزد ار سیم کواکب دهدش دور که او %~% سمت شاطری آصف دوران دارد(@)(@@) 7 صاحب سیف و قلم کز قلم و سیفش خصم %~% همچو مریخ و عطارد تن بی‌جان دارد(@)(@@) 8 مرکز دایره ملک ابوالقاسم بیک %~% که ز آصف صفتی عز سلیمان دارد(@)(@@) 9 آن که از عین شرف نقطه نوک قلمش %~% فخر بر مردمک دیده اعیان دارد(@)(@@) 10 و آن که از فرط عطا رشحه کلک کرمش %~% طعنه بر موهبت قلزم و عمان دارد(@)(@@) 11 مدعی دارد از آن آه ز دستش که به دست %~% خامه داوری و خاتم فرمان دارد(@)(@@) 12 بحر الطاف وی آن قلزم گوهرخیز است %~% که در آن عدد ریگ بیابان دارد(@)(@@) 13 دجله همتش آن بحر سحاب‌انگیز است %~% که گوهر بیشتر از قطره باران دارد(@)(@@) 14 ای قدر قدر قضا رتبه که معمار ازل %~% عالمی را ز وجود تو به سامان دارد(@)(@@) 15 توئی آن شمع فلک بزم ملک پروانه %~% که جهانی ز تو پروانه احسان دارد(@)(@@) 16 رشحه کلک درو سلک تو روحیست روان %~% که ترشح ز سرچشمه حیوان دارد(@)(@@) 17 قصر قدر تو بنائیست که یک ایوانش %~% وسعت عرصه این کاخ نه ایوان دارد(@)(@@) 18 بام ایوان تو عرشیست که هر کنگره‌اش %~% صد کتک دار بسان مه و کیوان دارد(@)(@@) 19 فلک آراسته نه خر گه والا که در آن %~% والئی همچو تو بنشیند و دیوان دارد(@)(@@) 20 آصفا تا شده‌ای واسطه عزت من %~% دشمن اعراض ازین واسطه چندان دارد(@)(@@) 21 که اگر شق شود از غم چو قلم نیست محال %~% و گر از غصه چو نالی شود امکان دارد(@)(@@) 22 تا به ذیل کرمت 
ms322	 دست توسل زده‌ام %~% سیل اشک از مژه‌اش سر به گریبان دارد(@)(@@) 23 جگر حرب ندارد بمن اما ز حسد %~% پاره پاره جگری بر سر مژگان دارد(@)(@@) 24 محتشم را که خرد داشته بر مداحی %~% سبب اینست که ممدوح سخندان دارد(@)(@@) 25 نیست در بند زر و سیم که از نقد سخن %~% یک جهان گنج نهان در دل ویران دارد(@)(@@) 26 در مدیح تو که نامت شرف دیوان‌هاست %~% اهتمام از پی آرایش دیوان دارد(@)(@@) 27 تا به دریای هوا کشتی زرین هلال %~% گذر از گردش این گنبد گردان دارد(@)(@@) 28 کشتی جاه تو را فیض دعای فقرا %~% سالم از تفرقه و امن ز طوفان دارد PageV1P630(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ز آهم بر عذار نازکش زلف آن چنان لرزد %~% که عکس سنبل اندر آب از باد وزان لرزد(@)(@@) 2 دلم افتد ز پا هرگه بلرزد زلف او آری %~% رسن باز افتد از سررشته هرگه ریسمان لرزد(@)(@@) 3 به صورتخانه چین گر قد و عارض عیان سازی %~% مصور را ورق در دست و کلک اندر بنان لرزد(@)(@@) 4 خرامان چو شوی گردد تنت سر تا قدم لرزان %~% به سان گلبنی کز نازکی گلها بر آن لرزد(@)(@@) 5 جوانی جان من پند غلام پیر خود بشنو %~% مکن کاری که از دستت دل پیر و جوان لرزد(@)(@@) 6 ز دهشت آن چنانم کز برای شرح درد دل %~% چو گیرم دامن آن گل مرا دست و زبان لرزد(@)(@@) 7 نویسم در بیان معجز لعلش اگر حرفی %~% ز عجز اندر بنانم خامه معجز بیان لرزد(@)(@@) 8 ز آه سرد من لرزد دل محزون در آن کاکل %~% چه مرغی کز نسیم صبح دم بر آشیان لرزد(@)(@@) 9 چو گردم مایل لعلش دلم از زهر چشم او %~% شود لرزان چو دزدی چو دزدی کز نهیب پاسبان لرزد(@)(@@) 10 چو نالم با جرس دور از مه محمل‌نشین خود %~% ز افغان جهان گیرم دل صد کاروان لرزد(@)(@@) 11 به قصد خون مظلومان 
ms323	 چو بندد بر میان خنجر %~% دلم چون برگ بید از بحر آن نازک میان لرزد(@)(@@) 12 رساند ترک چوگان باز من چون صولجان برگو %~% دلم چون گو رود از جا تنم چون صولجان لرزد(@)(@@) 13 که تاب آرد به جز من پیش تیر آن کمان ابرو %~% که پی در پی ز سهم ناوکش پشت کمان لرزد(@)(@@) 14 چنان خونریز و بی‌باکست چشم او که هر ساعت %~% ز تاب نیش مژگانش مرا رگهای جان لرزد(@)(@@) 15 نیندیشد ز خون مردم آن مژگان مگر آندم %~% که رمح موشکاف اندر کف شاه جهان لرزد(@)(@@) 16 جهان دارای دارافر فریدون ملک ملک آرا %~% که وقت دقت عدلش دل نوشیروان لرزد(@)(@@) 17 شه گیتی ستان طهماسب خان کز بیم رزم او %~% تن پیل دمان کاهد دل شیر ژیان لرزد(@)(@@) 18 گران‌قدری که ذاتش با وجود آن سبک روحی %~% به هیبت گر نهد پا بر زمین هفت آسمان لرزد(@)(@@) 19 جهانگیری که چون گردد تزلزل در زمین افکن %~% زمین لنگر گسل گردیده تا آخر زمان لرزد(@)(@@) 20 چو تیرش پر گشاید وحشت اندر وحش و طیر افتد %~% چو تیغش جان ستاند انس و جان را جسم و جان لرزد(@)(@@) 21 چو گردد از نهیب لشگرش خیل عدو هازم %~% دل گردون ز بانگ القتال و الامان لرزد(@)(@@) 22 اطاقه باد جولان چون خورد بر سرو آزادش %~% پر مرغان طوبی آشیان از بیم آن لرزد(@)(@@) 23 رود رنگ از رخ اعدا چه تیغ خون چکان او %~% ز باد حمله‌اش مانند شاخ ارغوان لرزد(@)(@@) 24 هژبریهای آن شیر ژیان در بیشه مردی %~% گر آید در بیان دل در بر ببر بیان لرزد(@)(@@) 25 ز باد تیغ تیز او دل اعدا شود لرزان %~% چنان کز تیزی باد خزان برگ رزان لرزد(@)(@@) 26 گه تقریر و تحریر فصول دفتر مهرش %~% زبان کلک در بند آید و کلک زبان لرزد(@)(@@) 27 اگر فغفور چین آید به قصد آستین بوسش %~% ز چین ابروی 
ms324	 دربان او بر آستان لرزد(@)(@@) 28 به دورش دزد گرد کاروان گردد به چاوشی %~% به عهدش گرگ را بر میش دل بیش از شبان لرزد(@)(@@) 29 نهنگ سرکش کشتی شکن در روزگار او %~% به دریا بر سر کشتی به شکل بادبان لرزد(@)(@@) 30 ز بیم آن که ننشیند خلاف رای او نقشی %~% به طاس چرخ دایم کعبتین فرقدان لرزد(@)(@@) 31 دبیرش چون کند آغاز کار از خامه قط کردن %~% دبیران جهان را بند بند استخوان لرزد(@)(@@) 32 الا ای خسرو روی زمین که اسباب حفظ تو %~% اگر نبود زمین با هفت گردون جاودان لرزد(@)(@@) 33 تو ای آن تخت شوکت را مکین کز صولتت هرگه %~% بجنبد لنگر تمکین مکان و لامکان لرزد(@)(@@) 34 گر افتد ماهی رمحت به بحر آسمان شاید %~% که در دست سماک رامح از سهمش سنان لرزد(@)(@@) 35 به میدان خنک سیمین تنک زرین رنگ چون رانی %~% ز هیبت چون جرس دل در بر روئین تنان لرزد(@)(@@) 36 تب بغض تو لرزاند عدو را تا دم آخر %~% کسی را که این چنین گیرد تب لرز آن چنان لرزد(@)(@@) 37 سلیمان مسندا مپسند کز لنگر گسل بادی %~% دلی با لنگر سنگین‌تر از کوه گران لرزد(@)(@@) 38 وز آثار هوای یار و فقر و آتشین طبعی %~% خصوصا در زمان چون تو شاهی هر زمان لرزد(@)(@@) 39 به این فقر و فنا هرگاه گوید محتشم خود را %~% میان مردم از خجلت زبانش در دهان لرزد(@)(@@) 40 چو طفلی کز ادیب خویشتن دایم بود لرزان %~% گه از کین جان گاهی ز بیداد زمان لرزد(@)(@@) 41 ور از فرض محالش همچو طفلان بهر آسایش %~% بخوابانند در گهواره امن و امان لرزد(@)(@@) 42 ردیف افتاد پس دور از قوا فی‌ختم کن ای دل %~% سخن را بر دعا تا کی بوان گفتن فلان لرزد(@)(@@) 43 ز تحریک طبیعت تا درین مهد گران جنبش %~% تن سیماب کافتاده است دور از بطن کان لرزد(@)(@@) 44 تن 
ms325	 دشمن که اکنون می‌تپد بر روی خاک از تو %~% بزیر خاک نیز از صولتت سیماب سان لرزد PageV1P631(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا بدن دستگاه جان باشد %~% دست دست خدایگان باشد(@)(@@) 2 پادشاهی که حکم او همه جا %~% بر سر خسروان روان باشد(@)(@@) 3 شیر حربی کزو لباس حیات %~% بر تن صفدران دران باشد(@)(@@) 4 شاه طهماسب‌خان که سپهش %~% همچو سنجر هزار خان باشد(@)(@@) 5 آن که نبود برون ز کشور او %~% هرکه را در زمین مکان باشد(@)(@@) 6 وانکه زیر نگین بود او را %~% هرچه در تحت آسمان باشد(@)(@@) 7 گر به رفع قضا نویسد حکم %~% اهتمام قدر در آن باشد(@)(@@) 8 وز به عزل قدر دهد فرمان %~% اقتضای قضا چنان باشد(@)(@@) 9 همتش چون به بذل پردازد %~% کیسه پرداز بحر و کان باشد(@)(@@) 10 کرمش کیسه‌ای که پر سازد %~% مخزن گنج شایگان باشد(@)(@@) 11 ای به جائی که قصد قدر تو را %~% پایه بر فرق فرقدان باشد(@)(@@) 12 بام ایوان عرش سای تو را %~% چرخ نه پایه نردبان باشد(@)(@@) 13 جودت ار نرخها کند تعیین %~% عمر جاوید را یگان باشد(@)(@@) 14 کان برآرد به زینهار انگشت %~% چون تو را خامه در بنان باشد(@)(@@) 15 هرچه گیرد ز بحر و کان ایام %~% دل و دست تواش ضمان باشد(@)(@@) 16 دل چو بحر اندر اضطراب افتد %~% چون کف تو گوهرفشان باشد(@)(@@) 17 دهر اگر خواهد از تو طول بقا %~% حشر و نشر اندرین جهان باشد(@)(@@) 18 می‌رسد مطلعی دگر که چه زر %~% در بلاد سخن روان باشد PageV1P632(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ملک اگر جسم و عدل جان باشد %~% ملک و عدل خدایگان باشد(@)(@@) 2 شهسواری که نعل شبرنگش %~% افسر شاه خاوران باشد(@)(@@) 3 سرفرازی که گرد نعلینش %~% زینت افسر سران باشد(@)(@@) 4 آن که از صدمت عدالت او %~% دزد چاوش کاروان باشد(@)(@@) 5 وانکه از هیبت سیاست او %~% گرگ یاغی سگ شبان باشد(@)(@@) 6 ای فلک رتبه کابلق حکمت %~% همه جا مطلق‌العنان باشد 
