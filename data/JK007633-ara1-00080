ms61	 % % على نصره الإسلام من ليس ينصف % % PageV01P181 11(@)(@@) % وتحذيره الأعراب أن يسفكوا الدما % % وأن ينهبوا الأموال أو يتخطفوا % % 12(@)(@@) % فكم أفسدوا في الأرض بعد صلاحها % % وكم سفكوا الدم الحرام وأسرفوا % % 13(@)(@@) % وكم قد أغاروا في الدروب وكم عثوا % % وكم قطعوا سبل الحجيج وخفوا % % 14(@)(@@) % فقال ادخلوا في السلم طرا وأسلموا % % وإلا فحرب وعده ليس يخلف % % 15(@)(@@) % وأقسم لا نعطي على ديننا الرشا % % وما عندنا إلا حسام ومصحف % % 16(@)(@@) % فمن لم يقومه الكتاب أقامه % % حدود الضبا والسمهري المثقف % % 17(@)(@@) % فهل يستقيم الدين إلا بدعوة % % إلى الله يتلوها سنان ومرهف % % 18(@)(@@) % وقد فرض الله الجهاد على الورى % % لمن كان عن نهج الشريعة يصدف % % 19(@)(@@) % وقد كان يبدي الحلم والصفح عنهم % % ويعطيهم الأموال كي يتألفوا % % 20(@)(@@) % فلما أبوا إلا الخلاف تمردا % % رماهم بما يؤذي النفوس ويتلف % % PageV01P182 21(@)(@@) % بجيش لهام حشوه الخيل والقنا % % تهب رياح الموت منه وتعصف % % 22(@)(@@) % يقودهم شبل الإمام وأنه % % لبالجود والإقدام والمجد يوصف % % 23(@)(@@) % وأما إمام المسلمين فإنه % % لمسعر حرب بالمساكين يرأف % % 24(@)(@@) % صفوحا عن الجاني وإن كان مجرما % % سؤلا عن العاني به يتلطف % % 25(@)(@@) % وينصر أهل الدين والعلم والحجى % % ويكرمهم بالمكرمات ويتحف % % 26(@)(@@) % مطاياه في غزو العدو مشيحة % % عطايا تزري بالكنوز وتجحف % % 27(@)(@@) % هو البحر ينتاب العطاش وروده % % وكل امرىء يروي المزاد ويعرف % % 28(@)(@@) % فاسيافه من خصمه تزعف الدما % % وأقلامه بالبذل والجود ترعف % % 29(@)(@@) % لقد أتعب الكتاب كتب صكاكه % % فكدت على أقلامهم أتخوف % % 30(@)(@@) % ودونك من نظم القريض قصيدة % % وجيزة لفظ باللآلي ترصف % % PageV01P183 31(@)(@@) % أتتك من الإحساء بكر خريدة % % تميس وخمر التيه يثنى ويعطف % % 32(@)(@@) % يعطر رياها سدوسا وبرة % % وسامعها من روضها الزهر يقطف % % 33(@)(@@) % وأزكى صلاة الله ثم سلامه % % على من به ختم النبوة يعرف % % 34(@)(@@) % كذا الصحب ما غنى حمام مطوق % % فجاوبه ورق على الدوح يهتف % % PageV01P184 البحر : بسيط تام 1(@)(@@) % بشراك يا منفق الأموال بالخلف % % وعدا من الله حقا غير مختلف % % 2(@)(@@) % في كل يوم ينادي في الورى ملك % % وآخر بنداء وهو غير خفي % % 3(@)(@@) % يا رب يا 
ms62	 ربنا ارزق منفقا خلفا % % واحكم على ممسك الأموال بالتلف % % 4(@)(@@) % وقال خير الورى حثا لخازنه % % انفق ولا تخش إفلالا ولا تخف % % 5(@)(@@) % يا رب قائلة يوما وقد عذلت % % مالي أراك بنظم الشعر ذا كلف % % 6(@)(@@) % والدهر أبناؤه بالمال قد بخلوا % % فهم يرون الندى ضربا من السرف % % 7(@)(@@) % كأنما قد تواصوا في الطباع على % % منع الحقوق وشد العقد بالحلف % % 8(@)(@@) % ما للقريض إذا أهديته ثمن % % ولو نظمت لهم درا من الصدف % % 9(@)(@@) % قلت ابشري فلقد جاد الزمان لنا % % بعارض جاد بالأموال والتحف % % 10(@)(@@) % أمامنا الندب ميمون النقيبة من % % ساس الرعية بالإحسان والنصف % % PageV01P185 11(@)(@@) % بنى الأمور على أساس التقى فرست % % والغير يبني على أوهى شفا جرف % % 12(@)(@@) % سما بهمته نحو العلا فعلا % % حتى استوى فوق هام المجد والشرف % % 13(@)(@@) % أندي البرية كفا وهو أشجع من % % قد هز عطفيه بين البيض والحجف % % 14(@)(@@) % العفو والحلم والإحسان شيمته % % لا خير في الطيش والإمساك والعنف % % 15(@)(@@) % أخي مكارم عن معن بن زائدة % % تروى وعن فارس الهيجا أبي دلف % % 16(@)(@@) % وعن برامكة كانت أكفهم % % تجنى على سائر الأموال بالتلف % % 17(@)(@@) % كأنه بحر جود والورود له % % ما بين منتضح منه ومغترف % % 18(@)(@@) % من عصبة نصروا الإسلام وانتهجوا % % منهاج صحب رسول الله والسلف % % 19(@)(@@) % أحيوا من السنة الغراء دارسها % % كما نفوا وأماتوا بدعة الخلف % % 20(@)(@@) % لولا دفاع إله العالمين بهم % % لا صبح الدين بين الناس كالهدف % % PageV01P186 21(@)(@@) % نثني عليه بما أولى وشر فتى % % من نال معروف حر غير معترف % % 22(@)(@@) % لكن نقول لقد أولى الجميل وقد % % أعطى الجزيل بلا من ولا سرف % % 23(@)(@@) % لا زال لطف من الرحمن يشمله % % ولم يزل منه في حفظ وفي كنف % % 24(@)(@@) % ثم الصلاة مدى الأزمان ما قطفت % % من الغصون جناها كف مقتطف % % 25(@)(@@) % على الذي أشرقت أنوار مولده % % بالبشر فارتجف الإيوان ذو الشرف % % 26(@)(@@) % وأخمدت ليلة الميلاد طلعته % % نار المجوس فنالوا غاية الأسف % % 27(@)(@@) % والآل والصحب ما قال الأديب لنا % % بشراك يا منفق الأموال بالخلف % % PageV01P187 البحر : - 1(@)(@@) % بالجد يدنوا كل أمر شاسع 
ms63	 % % والجد يفتح كل باب مغلق % % 2(@)(@@) % وإذا سمعت بأن مجدودا حوى % % عودا فأثمر في يديه فصدق % % 3(@)(@@) % لو كان بالحيل الغنى لوجدتني % % بنجوم أفلاك السماء تعلقي % % 4(@)(@@) % لكن من رزق الحجى حرم الغنى % % صدان مفترقان أي تفرق % % 5(@)(@@) % ومن الدليل على القضاء وكونه % % بؤس اللبيب وطيب عيش الأحمق % % 6(@)(@@) % وأحق خلق الله بالهم امرؤ % % ذو همة يبلى برزق ضيق % % PageV01P188 البحر : كامل تام 1(@)(@@) % بالجد يدنو كل أمر شاسع % % حاولته في مغرب أو مشرق % % 2(@)(@@) % وبه ترى الأمر العسير ميسرا % % والجد يفتح كل باب مغلق % % 3(@)(@@) % وإذا سمعت بأن مجدودا حوى % % عودا من العيدان ليس بمورق % % 4(@)(@@) % فاخضر حين حوته راحة كفه % % فورا وأثمر في يديه فصدق % % 5(@)(@@) % لو كان بالحيل الغنى لوجدتني % % أثرى الورى في خصب عيش مغدق % % 6(@)(@@) % وبلغت أعلى رتبة ورأيتني % % بنجوم أفلاك السماء تعلقي % % 7(@)(@@) % لكن من رزق الحجى حرم الغنى % % فانظر وسل إن لم تكن بمصدق % % 8(@)(@@) % فالعقل في الدنيا الدنية والغنى % % ضدان مفترقان أي تفرق % % 9(@)(@@) % ومن الدليل على القضاء وكونه % % في اللوح مكتوبا ولما تخلق % % 10(@)(@@) % أيضا وإن الرزق كان بقسمة % % بؤس اللبيب وطيب عيش الأحمق % % PageV01P189 11(@)(@@) % وأحق خلق الله بالهم امرؤ % % ذو همة شهم فصيح المنطق % % 12(@)(@@) % من طبعة حب المكارم والعلا % % لكنه يبلى برزق ضيق % % PageV01P190 البحر : بسيط تام 1(@)(@@) % أنفق ولا تخش من ذي العرش اقلالا % % ولا تطع في سبيل الجود عذالا % % 2(@)(@@) % فالمنفقون لهم من ربهم خلف % % ورب شح إلى الإتلاف قد آلا % % 3(@)(@@) % من جاد جاد عليه الله واستترت % % عيوبه وكفى بالجود سربالا % % 4(@)(@@) % من جاد ساد ومن شحت أنامله % % بالبذل أمست له الأعوان خذالا % % 5(@)(@@) % ثنتان كلتاهما للود جالبة % % صبر جميل وكف يبذل المالا % % 6(@)(@@) % لا تحسب المجد سهلا في تناوله % % لولا المشقة كل للعلا نالا % % 7(@)(@@) % مما أضر بأهل الملك أن خزنوا % % للنائبات من النقدين أموالا % % 8(@)(@@) % وضيعوا الجند في وقت الرخاء وما % % خافوا الخطوب ولم يلقوا لها بالا % % 9(@)(@@) % حتى إذا قام للهيجا قائمها % % وأشعل الحرب مذكى 
ms64	 الحرب إشعالا % % 10(@)(@@) % قاموا يريدون تأليف الجنود بما % % كنزوا فلم يدركوا آمالا % % PageV01P191 11(@)(@@) % كذاك من ضيع الأحرار محتقرا % % واختار غمرا أو باشا وأنذالا % % 12(@)(@@) % والحزم لو شكروا النعماء وادخروا % % للحرب خيلا وفرسانا وأبطالا % % 13(@)(@@) % من يحفظ الجند بالإحسان يلقهم % % إن يدعهم في الوغى يأتوه إرسالا % % 14(@)(@@) % فاجعل عطاك لإحرار الورى ثمنا % % تملك به مهجا منهم وأوصالا % % 15(@)(@@) % لا ملك يثبت إلا بالرجال ولا % % يقنى الرجال سوى من كان بذالا % % 16(@)(@@) % والمال يربو لمن ربى رعيته % % بعدله ونفى للظلم أغلالا % % 17(@)(@@) % والطرق أمنها بالعدل فامتلأت % % أنسا فلا يرهب السلاك معتالا % % 18(@)(@@) % يا فيصل المجد يا من للفخار حوى % % فاستوجب المدح تفصيلا واجمالا % % 19(@)(@@) % أوضحت للسنة الغرا رسول هدى % % عفت فأحييت للإسلام إطلالا % % 20(@)(@@) % أتى بك الله من مصر لملتنا % % نصرا وقهرا لمن عادى واذلالا % % PageV01P192 21(@)(@@) % فأنت طالع سعد حينما طلعت % % نجومه زدتنا حظا واقبالا % % 22(@)(@@) % نازلت آل حميد في سبيتهم % % حتى سبيت لهم عزا وأموالا % % 23(@)(@@) % جاؤوك بالجد في خيل وفي خيلا % % تكاد ترجف منه الأرض زلزالا % % 24(@)(@@) % كانوا جراء عليكم من سفاهتهم % % حتى رأوا منك في الهيجاء أهوالا % % 25(@)(@@) % أقريتهم عاجلا لما بكم نزلوا % % كالمستضعفين صمصاما وعسالا % % 26(@)(@@) % ومن حياض المنايا بعد أن طعموا % % أوريتهم عللا منها وانهالا % % 27(@)(@@) % فأدبروا هربا ذعرا وما صبروا % % لما رأوا الصبر بين الأسل قتالا % % 28(@)(@@) % لوا سراعا ولم يلووا على أحد % % وأصبحوا في بقاع الأرض فلالا % % 29(@)(@@) % وخلفوا خلفهم رغما عقائلهم % % مع البنين واغناما وآبالا % % 30(@)(@@) % فأصبحت مغنما للمسلمين وفي % % يديك تقسمها للناس أنفالا % % PageV01P193 31(@)(@@) % واه لها وقعة من أفقها طلعت % % شمس الهدى فمحت للشرك أطلالا % % 32(@)(@@) % فتح به فتحت للدين أعينه % % فأبصرت بعدد مع طال ما سالا % % 33(@)(@@) % فتح به فتح الرحمن أفئدة % % غلفا ادار عليها الرين اقفالا % % 34(@)(@@) % فتح به استبشرت هجر وقد فخرت % % لما ملكت لها مدنا واعمالا % % 35(@)(@@) % أثواب عدلك قد ألبستها جددا % % من بعد أن خلعت للظلم أسمالا % % 36(@)(@@) % فيها بثثت أمور العدل فانتشرت % % وحكم الشرع أقوالا وأفعالا % % 37 
ms65	(@)(@@) % فأصبحت بك هجر كالعروس زهت % % بحليها لم تذر شنفا وخلخالا % % 38(@)(@@) % ماست من التيه واختالت وحق لها % % بزينة العدل أن تزهو وتختالا % % 39(@)(@@) % تلك المكارم لا قعبان من لبن % % شيبا بماء فعادا بعد أبوالا % % 40(@)(@@) % فاحمد إلهك إذ ولاك أنعمه % % واشكره ما دمت تعظيما واجلالا % % PageV01P194 41(@)(@@) % وهاك مني قريضا قد حوى ذررا % % ما إن ترى مثلها في الحسن أمثالا % % 42(@)(@@) % جهد المقل وقد أهداه معتذرا % % لا خيل عندي أهديها ولا مالا % % 43(@)(@@) % ثم الصلاة على الهادي وعترته % % ورحمة تشمل الأصحاب والآلا % % 44(@)(@@) % ما لاح برق وما غنى الحمام وما % % سح العمام بجود الورق فإنها لا % % PageV01P195 البحر : كامل تام 1(@)(@@) % شكرت يديك يد المقل الأمل % % لنوالها الجم الغفير الأجزل % % 2(@)(@@) % منن رقيت بها إلى فلك العلا % % حتى قعدت على السماك الأعزل % % 3(@)(@@) % ولبست من تقوى الإله ملابسا % % والدين أفضل حلية المتجمل % % 4(@)(@@) % ففتحت للدين الحنيفي أعينا % % وكفت سحائبها بدمع مسبل % % 5(@)(@@) % ضحكت نواجذه وأصبح وجهه % % بعد التعبس مشرقا بتهلل % % 6(@)(@@) % لما أقمت فروضه وحدوده % % تجدود مرهفة وسمر ذبل % % 7(@)(@@) % حللت اخلاط الردى فسمي الهدى % % وحللت عقدة كل خطب مشكل % % 8(@)(@@) % ودعائما أرسيتها بعزائم % % للملك بعد تحرك وتزلزل % % 9(@)(@@) % ما راعك الخطب الذي قد شابهت % % أيامه ظلمات ليل اليل % % 10(@)(@@) % لكن جليت ظلامه بلوامع % % ويسهم عزم كالشهاب المرسل % % PageV01P196 11(@)(@@) % سيان حالك في المسرة والأسى % % جلدا وذا شأن اللبيب الأكمل % % 12(@)(@@) % ما جاش جاشك في الحوادث إذ دهت % % في فتنة تغلى كغلي المرجل % % 13(@)(@@) % أذكى الجهول ضرامها لسفاهة % % كي يستضيء بنورها فبها صلى % % 14(@)(@@) % قطع الذي أمر الإله بوصله % % فلأجل ذا أسبابه لم توصل % % 15(@)(@@) % وجنى على الإسلام شر جناية % % فأقر عين أخي النفاق المبطل % % 16(@)(@@) % فأحل منتهكا لحرمة مسلم % % ملك فعوقب بالعقاب الأعجل % % 17(@)(@@) % طلب العلو ببغيه وبظلمه % % جهلا فرد إلى الحضيض الأسفل % % 18(@)(@@) % ولأجل نصرة نفسه بذل القوى % % ولكن من خذل المهيمن يخذل % % 19(@)(@@) % حتى إذا ملك الخزائن واستوى % % جهرا على القصر المشيد الأطول % % 20(@)(@@) % ملأ الإله فؤاده وصحابه % % رعبا وصاح 
ms66	 به القضاء الا انزل % % PageV01P197 21(@)(@@) % لا تحسب الملك القصور وما حوت % % من آلة للحرب أو متمول % % 22(@)(@@) % بل مالك الملك الإله وأنه % % جعل الخلافة في الإمام الأعدل % % 23(@)(@@) % جمع الإله له القلوب فأجمعت % % كل النفوس على إمامة فيصل % % 24(@)(@@) % وانقاد كل المسلمين لأمره % % طوعا وتلك مواهب المتفضل % % 25(@)(@@) % حتى إذا حدق الخميس بمن بغي % % حنقا وجدبه الذي لم يهزل % % 26(@)(@@) % عض على طرف البنان وقال من % % فرط الأسى يا ليتني لم أفعل % % 27(@)(@@) % فهناك أيقن أن أنجم سعده % % أفلت وطالع نحسه لم يأفل % % 28(@)(@@) % وهناك أسلمه الحكيم إلى البلى % % لما طغى وأطاع كل مضلل % % 29(@)(@@) % في الظلم والعدوان والفعل الذي % % أضحى عن الشرع الشريف بمعزل % % 30(@)(@@) % ودهاه ما صنع الإله لعبده % % من ذلك الفتح المبين الأعجل % % PageV01P198 31(@)(@@) % فرأى التحصن مانعا هيهات أن % % تغني الحصون عن القضاء المنزل % % 32(@)(@@) % فأتاه بأس الله داخل حصنه % % مع صاحبيه فلم يروا من موئل % % 33(@)(@@) % فغدوا حصيدا للسيوف وللقنا % % صرعاء بين مجرح ومجندل % % 34(@)(@@) % وسقى بما أسقت يداه حميمه % % كأسا أمر مذاقه من حنظل % % 35(@)(@@) % وأهالها من وقعة أبقت لنا % % عبرا لكل مفكر متأمل % % 36(@)(@@) % تنبيك أن الظلم أشأم طائر % % والبغي أسرع صارع ومخذل % % 37(@)(@@) % وتريك شؤم قطيعة القربى فلن % % يقطع حبال قريبه لم يمهل % % 38(@)(@@) % فلقد بلغت من العدى يا فيصل % % أقصى مناك ونلت كل مؤمل % % 39(@)(@@) % فاحمد إلهك إذا أنالك ملكه % % وحباك بالنصر العزيز الأجمل % % 40(@)(@@) % وسقاك صفو الملك بعد كدورة % % فنهلتنا من عذاب ذاك المنهل % % PageV01P199 41(@)(@@) % فاحفظ فواضله بواجب شكره % % أن الشكور لفي مزيد تفضل % % 42(@)(@@) % وراع الرعية وما وليت أمورها % % بإقامة العدل السوي الأمثل % % 43(@)(@@) % فالعدل تحكيم الشريعة في الورى % % حقا فما عن عدلها من معدل % % 44(@)(@@) % وسياسة الشرع الشريف هي التي % % جمعت لكل طريق عدل أسهل % % 45(@)(@@) % فأقم بها عوجا الأمور معالجا % % فهي الدواء لكل داء معضل % % 46(@)(@@) % واجعل بطانتك الخيار ذوي النهى % % واحذر مخالطة السفيه الأرذل % % 47(@)(@@) % كم دولة فسدت بآراء العدى % % إذ لاطفوا قاداتها لتحيل % % 48(@)(@@) % لا تستشر 
ms67	 إلا لبيبا ناصحا % % بالعقل يختبر الأمور ويجتلي % % 49(@)(@@) % فلرب ذي نصح يظن بنصحه % % ولرب آخر ناصح لم يعقل % % 50(@)(@@) % وإذا هما اجتمعا لشخص واحد % % فأقبل جميع مقاله لا تهمل % % PageV01P200 51(@)(@@) % واسيء ظنونك في الزمان فإنه % % من فطنة الرجل النبية الأنبل % % 52(@)(@@) % ما حسن ظن في الزمان وأهله % % إلا سجية إبله ومغفل % % 53(@)(@@) % زمن به فقد الأمانة والوفا % % والصدق كالعنقاء غير محصل % % 54(@)(@@) % وتوكلن على الإله فإنه % % نعم الوكيل لعبده المتوكل % % 55(@)(@@) % هذي نفائس فكرة قد صغتها % % ببديع نظم كالزلال السلسل % % 56(@)(@@) % لازلت كهفا للعفاة ومربعا % % للوافدين وللضيوف النزل % % 57(@)(@@) % فاجعل جوائزها التجاوز والرضى % % صفحا وقابلها بحسن تقبل % % 58(@)(@@) % ثم الصلاة على النبي محمد % % والآل مع صحب هداة كمل % % PageV01P201 البحر : وافر تام 1(@)(@@) % على الوالي المهذب خير والي % % إمام المسلمين أخي المعالي % % 2(@)(@@) % سلام فاق عرف المسك نفحا % % بنظم مثل منظوم اللآلي % % 3(@)(@@) % تضمن مدحه بخصال نجد % % حواها وهي من خير الخصال % % 4(@)(@@) % عفاف ثم إقدام وحزم % % وجود بالمكارم والنوال % % 5(@)(@@) % إذا الراجي أتاه لنيل رفد % % حباه الرفد من قبل السؤال % % 6(@)(@@) % وإن أعطى الملوك لهم عطاء % % فنزر في عطاياه الجزال % % 7(@)(@@) % يجيىء المستنون له وفودا % % على الإبل الملهدة الهزال % % 8(@)(@@) % فيلقون الربيع إذا أناخوا % % بساحته وحطوا للرحال % % 9(@)(@@) % بشاشته تبشرهم بأن لم % % يخب شكوى المطى من الكلال % % 10(@)(@@) % وكم ضيف يرون لديه ثاو % % ونار للقرى فوق القلال % % PageV01P202 11(@)(@@) % وعن إقدامه سل كل قرم % % من الشجعان أبطال القتال % % 12(@)(@@) % ينبئك الأداني والأقاصي % % بشدة بأسه عند النزال % % 13(@)(@@) % وكم جيش يجر إلى الأعادي % % كتائبه كأعراض الجبال % % 14(@)(@@) % يدمر كل غدار وباغ % % ويرجع وهو محمود الفعال % % 15(@)(@@) % فإن تطلب له في العصر مثلا % % فقد حاولت إدراك المحال % % 16(@)(@@) % تتبعنا ذخائره جميعا % % فلم نبصر له من كنز مال % % 17(@)(@@) % ولكن كنزه التقوى وظن % % جميل في المهيمن ذي الجلال % % 18(@)(@@) % وربط الأعوجيات العوادي % % وجمع البيض والسمر العوال % % 19(@)(@@) % وتقليد الرجال بكل طوق % % من المعروف ذي قدر وبال % % 20(@)(@@) % بطلعته الزمان زها افتخارا % % ولم تكتم أياديه 
ms68	 الليال % % PageV01P203 21(@)(@@) % سيشكر فضله من كان حرا % % ولكن أين أحرار الرجال % % 22(@)(@@) % فأهل العصر مثل الطير طبعا % % بخفتها وأحلام السعال % % 23(@)(@@) % فإن جربت أكثرهم تجدهم % % على صنفين ختال وقال % % 24(@)(@@) % علامات النفاق بهم تراها % % ثلاث هن من شر الخلال % % 25(@)(@@) % خيانتهم واخلاق لوعد % % وكثرة كذبهم عند المقال % % 26(@)(@@) % % فسل على البوادي سيف عزموقاتلهم على منع العقال % % 27(@)(@@) % وأدبهم إذا انتهبوا وعاثوا % % بحد المرهقات وبالنكال % % 28(@)(@@) % وأني من سيوفك لست أنبو % % أنافخ من قلاك ولا أبالي % % 29(@)(@@) % وأنسج في علاك برود مدح % % وادراعا تقي وقع النصال % % 30(@)(@@) % فإن فقت الملوك وأنت منهم % % فإن المسك بعض دم الغزال % % PageV01P204 31(@)(@@) % ودونك من بنات الفكر بكرا % % حكت حسن الغزالة والهلال % % 32(@)(@@) % إليك أتت من الإحساء تطوى % % لها البيدا بحل وارتحال % % 33(@)(@@) % وصلى الله مولانا تعالى % % على الهادي النبي وخير آل % % PageV01P205 البحر : طويل 1(@)(@@) % أتقبل عذر الصب أم أنت عادله % % بذكرى حبيب عنه شطت منازله % % 2(@)(@@) % غزال حوى كل المحاسن وألبها % % يغازلني بعد العشا وأغازله % % 3(@)(@@) % فتاة كأن الشمس غرة وجهها % % فأنى يبين البدر حين تقابله % % 4(@)(@@) % نأت فنأى عن صبها كل عاذل % % فياليتها تدنوا وتدنو عواذله % % 5(@)(@@) % فمن لعذول لا يزال يجهله % % يجادلني في حبها وأجادله % % 6(@)(@@) % وما أنا إلا كالفتى في اعتلاله % % فلا أثر تبديه فيه عوامله % % 7(@)(@@) % وقد أصبحت سلمى بأبعد شقة % % يكل بها كوم المطي وهازله % % 8(@)(@@) % تميمية حلت بتيما ودونها % % من الجبل الطائي قفار وحائله % % 9(@)(@@) % فعن مثلها فاثن العنان ميمما % % مليكا عظيما لم يخب قط سائله % % 10(@)(@@) % إله السما والأرض فاسأله راغبا % % تنل كل ما ترجوا وما أنت آمله % % PageV01P206 11(@)(@@) % فنشكوا إلى الله الزمان الذي استوى % % لدى أهله قس الكلام وباقله % % 12(@)(@@) % به اندرست كل العلوم واقفرت % % فأنكر فضل العلم وبالعلم جاهله % % 13(@)(@@) % وقائلة أقصر فما بعد فيصل % % لذي أدب حظ فماذا تحاوله % % 14(@)(@@) % أترغب في نظم القريض وجسمه % % موارى بقبر غيبته جنادله % % 15(@)(@@) % فقلت دعيني أن يكن مات فيصل % % فخالقه حي وما مات نائله % % 16(@)(@@) % فقد ورث المجد 
ms69	 المؤثل والندى % % لنحل زكت أخلاقه وشمائله % % 17(@)(@@) % أبو النجم عبد الله حامي حمى الهدى % % بغرته بشرى الندى مخائله % % 18(@)(@@) % بنجد حثا المال الجزيل تبرعا % % فعاشت به أيتامه وأرامله % % 19(@)(@@) % وكم غارة شعواء شن على العدى % % وكم فارس منهم نعته حلائله % % 20(@)(@@) % فأثخن حربا بالحروف فسالمت % % ودانت له نجد وذلت قبائله % % PageV01P207 21(@)(@@) % ومن دم سراق الحجيج عنيبة % % سقى البيض حتى انهل الرمح حامله % % 22(@)(@@) % وقائع سل عنها الحجاز وغيره % % ونجدا ومن في البحر ينبيك ساحله % % 23(@)(@@) % جهادا ودرءا للفساد ونية % % وسعيا به يرجو المثوبة فاعله % % 24(@)(@@) % تولى فلم يرض المكوس لدينه % % عفافا ومن يعفف تعف عوامله % % 25(@)(@@) % ولما نمى الركبان أخبار عدله % % إلينا وشاعت في البلاد فضائله % % 26(@)(@@) % بعثنا له در القريض بمدحه % % وخير الثنا ما لا يكذب قائله % % 27(@)(@@) % فأبلغه تسليما إذا فض ختمه % % تأرج من أرض الرياض معاقله % % 28(@)(@@) % فيا أيها الوالي نصرت على العدى % % وسددت في الأمر الذي أنت فاعله % % 29(@)(@@) % حنانيك لا تسمع بنا قول كاشح % % ولا حاسد تغلو علينا مراجله % % 30(@)(@@) % ولا تصغ للنمام سمعك إنما % % يجيء به الإفساد والإثم حاصله % % PageV01P208 31(@)(@@) % وما هو إلا فاسق أو منافق % % يريك صريح النصح والغش داخله % % 32(@)(@@) % ولا يدخل النمام في الحشر جنة % % حديثا عن المختار يرويه ناقله % % 33(@)(@@) % وأكرم بني الشيخ الرئيس الذي نهى % % عن الشرك لما شاع في الأرض باطله % % 34(@)(@@) % وألف في التوحيد تأليفه الذي % % شجت في حلوق المشركين دلائله % % 35(@)(@@) % كذا عبد الرحمن أعني حفيده % % بنور الهدى يهدي فمن ذا يعادله % % 36(@)(@@) % ينافح عن دين الهدى كل مبطل % % فيبطل تمويهاته ويناضله % % 37(@)(@@) % وعبد اللطيف الحبر لا تنس فضله % % إمام هدى بالعلم يزهو محافله % % 38(@)(@@) % فمن رام خذلانا لهم وتنقصا % % لقدرهم بالبغي فالله خاذله % % 39(@)(@@) % فدونك نظما كالزلال وعذوبة % % صفت للعطاش الواردين مناهله % % 40(@)(@@) % وكل امرىء يهدي على قدر وسمه % % فدونك ما نهدي فهل أنت قابله % % PageV01P209 41(@)(@@) % وختمي صلاة الله ثم سلامه % % على من به الإرسال عمت رسائله % % 42(@)(@@) % محمد المبعوث من آل هاشم % % كذا الصحب 
ms70	 ما غنت بروض بلابله % % PageV01P210 البحر : وافر تام 1(@)(@@) % علام تلوم في سلمي علا ما % % وقد شغف الفؤاد بها وهاما % % 2(@)(@@) % وتكثر في الهوى العذري عذلي % % ولو انصفت لم تبد الملاما % % 3(@)(@@) % فكرر ذكرها فلذاك عندي % % ألذ من المدامة للنداما % % 4(@)(@@) % فمن لفتى إذا ما شام برقا % % تألق هجعة هجر المناما % % 5(@)(@@) % وإن هبت صبا من أرض نجد % % بعرف الشيح منها والخزامى % % 6(@)(@@) % تصابى قلبه واهتز وجدا % % كأن هبوبها يسقى المداما % % 7(@)(@@) % تذكرني الخيام بأرض نجد % % وقلبي عند من سكن الخياما % % 8(@)(@@) % فتاة لو رأى غيلان منها % % محاسنها لما قال اهتياما % % 9(@)(@@) % تمام الحج أن تقف المطايا % % بخرقا بعد أن تضع اللثاما % % 10(@)(@@) % طرقنا أهلها ليلا فقالت % % من الأني وأهلونا نياما % % PageV01P211 11(@)(@@) % فقلت لها محب جاء ضيفا % % فلا تجفى محبا مستهاما % % 12(@)(@@) % فقالت كيف زرت ودون وصلى % % حروب نارها تذكي الضراما % % 13(@)(@@) % وقومي أشرعوا دوني رماحا % % وسلوا البيض وانتثلوا السهاما % % 14(@)(@@) % فقلت أما سمعتي أو شعرتي % % بأن امامنا أبدى الكماما % % 15(@)(@@) % تبدل بالثياب جلود نمر % % وسل على أولي الظلم الحساما % % 16(@)(@@) % فصار الذئب للأغنام سلما % % وصاحب في الفلا النعم النعاما % % 17(@)(@@) % إمام للهدى يدعو البرايا % % ويبعث للعدى جيشا لهاما % % 18(@)(@@) % وإن ذكر الندى فيداه غوث % % تسح الجود والمنن الجساما % % 19(@)(@@) % فكم أعطى السوابق مسرجات % % وكم أعيت عطاياه الكراما % % 20(@)(@@) % وكم أصلى الأعادي نار حرب % % فكان وقودها جثثا وهاما % % PageV01P212 21(@)(@@) % وإن ذكر علاه فلست أحصى % % مزايا مناقبه عظاما % % 22(@)(@@) % همام فاضل فطن ذكي % % إله الملك قد ألقى إلزماما % % 23(@)(@@) % لذلك قد تركنا أرض هجر % % وراء والرياض لنا إماما % % 24(@)(@@) % فسرنا والأمير وما خشينا % % من البرد المضرة والسقاما % % 25(@)(@@) % بأيدي العيس نطوي كل قفر % % ونحدوها لكي تصل الإماما % % 26(@)(@@) % فلما أن نخناها جميعا % % بساحته واقرينا السلاما % % 27(@)(@@) % بلغنا كل مأمول وقصد % % ونلنا فوق ما نبغي المراما % % 28(@)(@@) % فقال لنا ملاطفة ورفقا % % أجئتم والشتاء دهى الأناما % % 29(@)(@@) % فقلنا في موتكم أتينا % % ولو ترك القطا لغفا وناما % % 30(@)(@@) % ونهدي كل آونة وحين % % صلاة الله نتبعها 
ms71	 السلاما % % PageV01P213 31(@)(@@) % مدى الأيام ما طلعت شموس % % إلى من كان للرسل الختاما % % 32(@)(@@) % نبي عم بعثته البرايا % % وأصحاب له كانوا كراما % % PageV01P214 البحر : طويل 1(@)(@@) % أأسلوا وقلبي للغرام غريم % % وجسمي كطرف الغانيات سقيم % % 2(@)(@@) % ولي مقلة لا يقلع العذل دمعها % % وقلب إذا جن الدجاء يهيم % % 3(@)(@@) % أبيت أراعي أنجم الليل ساهدا % % كأني إذا جن الظلام سقيم % % 4(@)(@@) % وأصبو إلى ريح الصبا كلما صبت % % وجاد بأنفاس الحبيب نسيم % % 5(@)(@@) % وأسعد قمري الحمام بنوحه % % كأني لسجاع الحمام حميم % % 6(@)(@@) % وأهتز شوقا كلما لاح بارق % % من العارض النجدي حين أشيم % % 7(@)(@@) % ولوعا بسلمى حين شط مزارها % % وحالت وعور دونها وحزوم % % 8(@)(@@) % وقفت على الأطلال أبكي وما بها % % سوى ندمي عند الطلول نديم % % 9(@)(@@) % فتاة تضاهي البدر حسنا فمثلها % % إذا قستها بالغانيات عديم % % 10(@)(@@) % إذا أقبلت قلت الصباح لنا بدا % % وإن أدرت قلت الدجاء بهيم % % PageV01P215 11(@)(@@) % كأن ظلام الليل خيم جنحه % % على الشعر أو مد الجناح ظليم % % 12(@)(@@) % لقد أسقمت منها جفون سقيمة % % ومذ كلمتني فالفؤاد كليم % % 13(@)(@@) % وقد أوقدت نار الصبابة في الحشا % % وأحشاؤها مثل الحرير هظيم % % 14(@)(@@) % لقد منحتني في الشبيبة وصلها % % وقدي كعود السمهري قويم % % 15(@)(@@) % فلما علا رأسي البياض تباعدت % % وذو الشيب عند الغانيات مشوم % % 16(@)(@@) % فأصبحت مأسور الفؤاد بحبها % % وما ذاك من كيد النساء عظيم % % 17(@)(@@) % فما بالها تصبو إلى كل يافع % % وتهجر شيخا والداه تميم % % 18(@)(@@) % ألم تدر أن المقرئين شيعتي % % ولي عهد ود بالإمام قديم % % 19(@)(@@) % إمام حوى كل المكارم والعلا % % وطاب له في العالمين أروم % % 20(@)(@@) % له نسب في وائل بن ربيعة % % نماه إلى أعلى الفخار صميم % % PageV01P216 21(@)(@@) % تفرع من صيد الملوك الذين هم % % لهم مكرمات جمة وحلوم % % 22(@)(@@) % هم نصروا دين الهدى بعد أن عفت % % له بين سكان البلاد رسوم % % 23(@)(@@) % وأحيوا بأطراف الأسنة سنة % % لخير الورى منها العظام رميم % % 24(@)(@@) % وقد ورثوا المجد الأثيل لفيصل % % فعاد كريم الأصيل وهو كريم % % 25(@)(@@) % إليه تشد اليعملات لرغبة % % وخوف إذا آذى النفوس غشوم % % 26(@)(@@) % فيا من في ساحاته 
ms72	 كل خائف % % وفي قصره للمرملين نعيم % % 27(@)(@@) % يجود بما تحوى اليدان كأنه % % غمام يوالي وبله ويديم % % 28(@)(@@) % وما هو بالنزق العجول إلى الأذى % % ولكنه واعي الجنان حليم % % 29(@)(@@) % صفوح عن الجاني ولكن عقابه % % لمن رام أسباب الفساد أليم % % 30(@)(@@) % هو الضيغم الضرغام في كل معرك % % إذا شب من نار الحروب جحيم % % PageV01P217 31(@)(@@) % يخوض لظى الهيجاء والنقع ثائر % % وطير المنايا بالمنون تحوم % % 32(@)(@@) % فكم جحفل بالمرهفات أباده % % فقتلاهم مثل الهشيم هشيم % % 33(@)(@@) % فللأرض منهم ما جرى من دمائهم % % وللطير منهم والسباع لحوم % % 34(@)(@@) % وإن طنبت حول العدو خيامه % % فقل جبل راسي الأساس مقيم % % 35(@)(@@) % فيا أيها الوالي الذي لا يصده % % عن العدل ساع بالنميم أثيم % % 36(@)(@@) % واحسانه كالغيث قد عم نفعه % % فمنكره أو مزدريه لئيم % % 37(@)(@@) % إليك شددت العيس أشكو ظلامتي % % فقد رام خسفي حاسد وظلوم % % 38(@)(@@) % وجار علي العاملون بخرصهم % % وظلم الورى يوم الحساب وخيم % % 39(@)(@@) % وإنك للمظلوم كهف ومعقل % % يلوذ به مستضعف ويتيم % % 40(@)(@@) % وإنك نجم للهدى يهتدي به % % ويرمي به عند السماع رجيم % % PageV01P218 41(@)(@@) % فدونكها بكرا عليها قلائد % % وعقد من الدر النفيس نظيم % % 42(@)(@@) % أتتك من الإحساء ترفل في الحلى % % تخوض بها السراب رسيم % % 43(@)(@@) % وما مهرها إلا القبول فجد به % % لينزاح عن قلب المحب هموم % % 44(@)(@@) % فلا زلت بالدين العزيز مؤيدا % % وبالبيض للدين القويم تقيم % % 45(@)(@@) % وأزكى صلاة الله ما طاف طائف % % وما نيط بالبيت العتيق حطيم % % 46(@)(@@) % على من هو الماحي لكل ضلالة % % نبي الهدى بالمؤمنين رحيم % % PageV01P219 البحر : طويل 1(@)(@@) % بعدل ولاة الأمر ترسو دعائمه % % ونأمن في قفر الفلاة سوائمه % % 2(@)(@@) % وبالحزم والكتمان والجد والحجا % % ينال أخو العلياء ما هو رائمه % % 3(@)(@@) % وحكمك محمود العواقب إن يكن % % له صارم ينفي الذي لا يلائمه % % 4(@)(@@) % وأسوس أهل الملك من ساس من رعى % % برفق فإن لم يغن أغناه صارمه % % 5(@)(@@) % كذاك إمام المسلمين لنفسه % % أناة فإن لم ثغن أغنت عزائمه % % 6(@)(@@) % هو البحر من أصدافه الدر يجتني % % وإن طاش بالأمواج لم ينج عائمه % % 7(@)(@@) % تخلق بالصفح الجميل وبالندى 
ms73	 % % وبالحلم مذ نيطت عليه تمائمه % % 8(@)(@@) % مروءاته أفنت خزائن جمعه % % فهل أنت في فعل المكارم لاثمه % % 9(@)(@@) % عطاياه كالوسمى إن شيم برقه % % ويممه الرجوان ما خاب شائمه % % 10(@)(@@) % بمدحته رنت بهجر بلابل % % وغنت بنجد ورقه وحمائمه % % PageV01P220 11(@)(@@) % فشاد بناء المجد بالجود فاعتلى % % ومن يبنه بالبخل لاشك هادمه % % 12(@)(@@) % وإن أنت شبهت الإمام وجوده % % بمعن أو الطائي فإنك هاضمه % % 13(@)(@@) % موائده مثل الربيع لممحل % % وتشبع أصناف الطيور ملاحمه % % 14(@)(@@) % إذا بعث الجيش اللهام إلى العدى % % تلته سراحين الفلا وحوائمه % % 15(@)(@@) % فأطعمها مما تنال رماحه % % لحوما وحظ الجيش منها غنائمه % % 16(@)(@@) % يجاهد بالقرآن من زاغ واعتدى % % فإن هم أبوا سلت عليهم صوارمه % % 17(@)(@@) % فغادر قتلى يعصب الطير حولها % % وترتادها عقباته وقشاعمه % % 18(@)(@@) % ولولاه في هذا الزمان لما بدت % % من الدين في جل الديار معالمه % % 19(@)(@@) % ولا أمنت طرق الحجيج ولا انتهى % % عن الظلم للمظلوم بالسيف ظالمه % % 20(@)(@@) % ولكن أخاف المفسدين فسالموا % % وسفك الدما بالحق للدم عاصمه % % PageV01P221 21(@)(@@) % ومن يجتمع فيه الشجاعة والندى % % يقر له بالفضل من لا يسالمه % % 22(@)(@@) % إلا أنه إنسان عين زمانه % % تناوم عنه الدهر أو هب نائمه % % 23(@)(@@) % مفاخره شمس يراها حسوده % % فما باله يبد ما هو كاتمه % % 24(@)(@@) % فأنشده بيتا قاله بعض من مضى % % وما حاد عن بيت القصيدة ناظمه % % 25(@)(@@) % إذا ظفرت منك العيون بنظرة % % أثاب لها معى المطي ورازمه % % 26(@)(@@) % فلا النظم يحوى مدحه إن مدحته % % ولا الطرس يوعى كل ما أنا راقمه % % 27(@)(@@) % ولكنني أهدى له صالح الدعا % % ومدحا كمثل المسك إن فض خاتمه % % 28(@)(@@) % وأزكى صلاة والسلام بأثرها % % على من به للدين قامت دعائمه % % 29(@)(@@) % نبي الهدى بحر الندى مثخن العدى % % ومنهلهم كأسا غداقا علاقمه % % 30(@)(@@) % كذا الآل والأصحاب مالاح بارق % % وما جاد بالودق الكثير غمائمه % % PageV01P222 البحر : سريع 1(@)(@@) % ما هتف الورق وغنى الحمام % % أو غرد القمرى جنح الظلام % % 2(@)(@@) % أو هب للصبح نسيم الصبا % % إلا صبا قلب الفتى المستهام % % 3(@)(@@) % وجدا بسلمى حين شطت بها % % مسافة البعد وعز المرام % % 4(@)(@@) % بهكنة تحوى صنوف 
ms74	 البها % % كأنها في الحسن بدر التمام % % 5(@)(@@) % مياسة الأعطاف من ظلمها % % تسقى محبيها كؤوس المدام % % 6(@)(@@) % قد زارني في هجعة طيفها % % من بعد أن نام كثير الأنام % % 7(@)(@@) % فقلت في الأعتاب ما الجفا % % إن الوفا بالعهد دين الكرام % % 8(@)(@@) % وما الذي حلل في شرعكم % % هجران ذي ود بهجر أقام % % 9(@)(@@) % قالت خذ العذر فمن بيننا % % قد حال أوباش جفاة طغام % % 10(@)(@@) % قوم من الأعراب من جهلهم % % قد خرقوا الدين ودست الكمام % % PageV01P223 11(@)(@@) % وقطعوا السبل وعاثوا بها % % وحللوا سفك الدماء الحرام % % 12(@)(@@) % عادات سوء رضعوا ثديها % % فاستصعبوا بعد الرضاع الفطام % % 13(@)(@@) % والذئب قد يعدو على غرة % % في غنم الراعي لها إذ ينام % % 14(@)(@@) % والنار بالزندين ايراؤها % % وأول الحرب قبيح الكلام % % 15(@)(@@) % فقلت لا تخشى ولا تحذري % % ما صحب السيف يمين الإمام % % 16(@)(@@) % وما تجلت للهدى شمسه % % إلا انجلى عنها دخان القتام % % 17(@)(@@) % أتحسبين الجبن من طبعه % % لا والذي يحيى رميم العظام % % 18(@)(@@) % فإن تأنى فله عزمة % % وهكذا شأن الرئيس الهمام % % 19(@)(@@) % لكن سلي الله مغيث الورى % % أن يحيي الأرض بوبل الغمام % % 20(@)(@@) % فتسرح الأنعام في نبته % % ويبعث الوالي بجيش لهام % % PageV01P224 21(@)(@@) % فيه جياد الخيل مجنونة % % من كل قبا الجمت باللجام % % 22(@)(@@) % تحمل للحرب أسود الشرى % % والبيض والسمر وزرق السهام % % 23(@)(@@) % قد طال صوم الخيل في طيلها % % فاشتاقت اليوم لترك الصيام % % 24(@)(@@) % تعدو مع الريات منشورة % % على الإمام الشهم وابن الامام % % 25(@)(@@) % وعصبة من قومهم قد نشوا % % في نصرة الدين ورعي الذمام % % 26(@)(@@) % يا راكبا من أرض هجر ضحى % % إن رمت نجدا فالرياض الإمام % % 27(@)(@@) % أنخ قلوصك لدى قصرها % % وبلغ الوالي أتم السلام % % 28(@)(@@) % وقل له إن جهاد العدى % % في ضمنه العز ونيل المرام % % 29(@)(@@) % وقد أتى النقل عن المصطفى % % بأنه في الدين أعلى السنام % % 30(@)(@@) % ما جرد الصمصام ذو همة % % عند اعوجاج الأمر إلا استقام % % PageV01P225 31(@)(@@) % فبالأماني لا ينال المنى % % لأنها تشبه حلم المنام % % 32(@)(@@) % والمجد لا يدركه مولع % % بلثمة الحسناء ذات اللثام % % 33(@)(@@) % فثب وثوب الليث نحو العلا % % وبادر الخصم 
ms75	 بسل الحسام % % 34(@)(@@) % وجاز ذا الحسنى بإحسانه % % واسق الأعادي من كؤوس الحمام % % 35(@)(@@) % وحكم السيف بمن قد عتا % % ينقاد للحق ألد الخصام % % 36(@)(@@) % وهاك في الأداب منظومة % % مثل اللآلي في عقود النظام % % 37(@)(@@) % قد برزت من ناظم ناصح % % في وده موف لكم بالذمام % % 38(@)(@@) % ثم صلاة الله مقرونة % % برحمة منه وأزكى سلام % % 39(@)(@@) % على نبي كان للأنبيا % % والرسل في الختم كمسك الختام % % 40(@)(@@) % وإله الغر وأصحابه % % ما هتف الورق وغنى الحمام % % PageV01P226 البحر : كامل تام 1(@)(@@) % من ذا يعيب أئمة الإسلام % % أهل النهي والفضل والأحلام % % 2(@)(@@) % أو من يعاديهم سوى ذي ريبة % % في الدين ليس بثابت الأقدام % % 3(@)(@@) % فهم النجوم هدى لأصحاب السرى % % وهم لدين الله كالأعلام % % 4(@)(@@) % أنصار سنة أحمد كم أسسوا % % للمسلمين قواعد الأحكام % % 5(@)(@@) % منهم بنجد عالم ومجدد % % للدين ذو علم وذو أقدام % % 6(@)(@@) % نصر الهدى ونفى الردى ورمى العدى % % بثواقب من علمه وسهام % % 7(@)(@@) % وحمى حمى التوحيد من شبه العدى % % وضلالهم أكرم به من حام % % 8(@)(@@) % وأدلة التوحيد ألف شملها % % فأزاح ليل الشك والأهام % % 9(@)(@@) % ومشاهد اشراك هد بناءها % % بدليل وحي قاطع وحسام % % 10(@)(@@) % من بعد أن عكفت عليها فرقة % % نبذوا الهدى وشرائع الإسلام % % PageV01P227 11(@)(@@) % طافوا بأرجاء القبور وقربوا % % نسكا لها كعبادة الأصنام % % 12(@)(@@) % فأتاهم بالنور من صبح الهدى % % فجلى به قطعا من الإظلام % % 13(@)(@@) % فجزاه رب العرش خير جزائه % % وحباه بالإحسان والأنعام % % 14(@)(@@) % ونحا طريقته الإمام حفيده % % أكرم به من عالم وإمام % % 15(@)(@@) % أعني بذلك شيخنا علم الهدى % % زين لأهل العلم والحكام % % 16(@)(@@) % قد رد من كل العلوم شواردا % % ندت وقاد صعابها بزمام % % 17(@)(@@) % فلقد كفى وشفى بتصنيفاته % % وأذل من أضحى ألد خصام % % 18(@)(@@) % فهموا دعاة الدين بل أنصاره % % كم أيقظوا من معشر نوام % % 19(@)(@@) % قل للسفيه ومن سعى في ثلبهم % % أنى تضر شوامخ الأعلام % % 20(@)(@@) % لو كنت من أهل الوغى أبصرتنا % % ولقيت كل سميدع مقدام % % PageV01P228 21(@)(@@) % لكن أراك من البهائم راتعا % % فكرهت نظم الدر للأنعام % % 22(@)(@@) % فاسمع هداك الله نظما رائقا % % ازهاره فتحت من الأكمام 
ms76	 % % 23(@)(@@) % وخريدة زفت إليك بدلها % % تشفى الضجيج ببارد بسام % % 24(@)(@@) % وعلى النبي محمد وصحابه % % والآل خير تحية وسلام % % PageV01P229 البحر : طويل 1(@)(@@) % على فيصل بحر الندى والمكارم % % بكينا بدمع مثل صوب الغمائم % % 2(@)(@@) % إمام نفى أهل الضلالة والخنا % % بسمر القنا والمرهفات الصوارم % % 3(@)(@@) % فكم فل من جمع لهم جاء صائلا % % وأفنى رؤوسا منها في الملاحم % % 4(@)(@@) % يجر عليهم جحفلا بعد جحفل % % ويرميهم في حربه بالقواصم % % 5(@)(@@) % فما زال هذا دأبه في جهادهم % % تغير بنجد خيله والتهائم % % 6(@)(@@) % إلى أن أقيم الدين في كل قرية % % وأصبح عرش الملك عالي الدعائم % % 7(@)(@@) % وأخلى القرى من كل شرك وبدعة % % وما زال ينهى عن ركوب المحارم % % 8(@)(@@) % ويعطى جزيل المال محتقرا له % % سماحا ويعفو عن كثير الجرائم % % 9(@)(@@) % مناقب جود قد حواها جبلة % % فحاز من الثنا عربها والأعاجم % % 10(@)(@@) % تغمده المولى الكريم برحمة % % واسكنه الفردوس مع كل ناعم % % PageV01P230 11(@)(@@) % فلا جزع مما قضى الله فاصطبر % % وإلا ستسلو مثل سلو البهائم % % 12(@)(@@) % فلما تولى خلف الملك بعده % % لنجل خليق بالإمامة حازم % % 13(@)(@@) % فقام بعون الله بالأمر سائسا % % رعيته مستيقظا غير نائم % % 14(@)(@@) % فتابع أهل العدل في كف كفه % % عن المكس أن المكس شر المظالم % % 15(@)(@@) % وشابه في الأخلاق والده الذي % % فشا ذكره بالخير بين العوالم % % 16(@)(@@) % وقرب أهل الفضل والعلم والنهى % % وجانب اتباع الهوى غير نادم % % 17(@)(@@) % ومن يستشر في أمره كل ناصح % % لبيب يكن فيما جرى غير نادم % % 18(@)(@@) % على يده جل الفتوح تتابعت % % فساوى القرى في الأمن مرعى السوائم % % 19(@)(@@) % وأسلمت الأعراب كرها وجانبوا % % حضورا لدى الطاغوت عند التحاكم % % 20(@)(@@) % فذكرنا عبد العزيز وشيخه % % وما كان في تلك الليالي القوادم % % PageV01P231 21(@)(@@) % فلا زال منصور اللواء مؤيدا % % على كل باع معتد ومخاصم % % 22(@)(@@) % فدونك أبياتا حوت كل مدحة % % فأضحت كمثل الدر في سلك ناظم % % 23(@)(@@) % ونهدي صلاة الله خالقنا على % % نبي عظيم القدر للرسل خاتم % % 24(@)(@@) % محمد الهادي وأصحابه الألي % % حموا دينه بالمرهفات الصوارم % % 25(@)(@@) % صلاة وتسليما يدومان ما سرى % % نسيم الصبا وانهل صوب الغمائم 
ms77	 % % PageV01P232 البحر : وافر تام 1(@)(@@) % خرجنا والأمير بنجم سعد % % نقود الخيل بالإبل الرسيم % % 2(@)(@@) % تدوس بنا الحصا في كل فج % % فتوري القدح في الليل البهيم % % 3(@)(@@) % نهضنا للجهاد بلا توان % % سوى قدر الترحل للمقيم % % 4(@)(@@) % لنجمع لامة للحرب كنا % % نداولها لذلك من قديم % % 5(@)(@@) % فسار الجيش مثل البحر هبت % % عليه العاصفات من النسيم % % 6(@)(@@) % قبائل من عقيل قد توافت % % وقوم ينتمون إلى تميم % % 7(@)(@@) % يؤم ابن الإمام بهم جميعا % % عنيزة وهي في أرض القصيم % % 8(@)(@@) % نقاتل فيه أوباشا لئاما % % أطاعوا فتنة الغاوي الرجيم % % 9(@)(@@) % فإن فاءوا فإن الله يهدي % % لمن شاء للصراط المستقيم % % 10(@)(@@) % وإلا كان قتلهم يسيرا % % بحول القادر الرب العظيم % % PageV01P233 11(@)(@@) % لأنهم أناس أهل جهل % % ونقص في الديانة والحلوم % % 12(@)(@@) % بحلم إمامنا اغتروا زمانا % % ولما يرهبوا غضب الحليم % % 13(@)(@@) % إماما ماجد الأحساب ينمى % % إلى أعلى الذوائب والصميم % % 14(@)(@@) % إلى العلياء يسمون افتخارا % % يفعل المجد للعظيم الرميم % % 15(@)(@@) % فلا زالت به الأيام غرا % % يطيب عرفها عرف النسيم % % 16(@)(@@) % ولا زالت كتائبه توالي % % بنصر الحق والدين القويم % % 17(@)(@@) % إماما قد حماه الله طبعا % % من الإسراف والخلق الذميم % % 18(@)(@@) % إذا ما جاءه طلاب عرف % % يرى في وجهه بشرى الكريم % % 19(@)(@@) % وأفضل ما يكون به اختتامي % % صلاة الهنا البر الرحيم % % 20(@)(@@) % على الهادي الرسول وكل بر % % من الأصحاب ذي خلق كريم % % PageV01P234 البحر : بسيط تام 1(@)(@@) % سبحان من قدر الأشياء سبحانا % % قضى وقدر ما يجري وما كانا % % 2(@)(@@) % قضى بألطافه الحسنى ورحمته % % أنا نسير من الإحساء ركبانا % % 3(@)(@@) % نؤم حاكم نجد في رياض ندى % % تستنبت الجود لا شوكا وسعدانا % % 4(@)(@@) % حتى إذا سار نحو الخرج محدقة % % به النجائب مع خيل وفرسانا % % 5(@)(@@) % سرنا بصحبته انسنا به فغدا % % يولى الأرامل والأيتام إحسانا % % 6(@)(@@) % جاز اليمامة فاعتاشت أراملها % % من نيله وكسا من كان عريانا % % 7(@)(@@) % ومر بالقرية الأخرى فحولها % % نعما وبث العطا في أهل نعجانا % % 8(@)(@@) % حتى أتى الدلم المعروف معتبرا % % بما جرى محدثا لله شكوانا % % 9(@)(@@) % فجاد بالوابل الهطال راحته % % على بقاع دهاها الجدب أزمانا 
ms78	 % % 10(@)(@@) % فاهتزت الأرض منها روضة وربت % % زهرا ورجع فيها الطير ألحانا % % PageV01P235 11(@)(@@) % فواهنيئا لأرض الخرج باكرها % % غيث ببذل الندى ما زال هتانا % % 12(@)(@@) % أكرم به من إمام عم نائله % % يعطي الجزيل من الأموال مجانا % % 13(@)(@@) % من عصبة نصروا دين الهدى فهدوا % % وأصبحوا لدعاة الدين أعوانا % % 14(@)(@@) % مبارك الأمر ميمون نقيبته % % فالله يجزيه بالإحسان إحسانا % % 15(@)(@@) % لكنه ذكر الحسنى فهيجني % % وجد وزاد غرام القلب أشجانا % % 16(@)(@@) % والصب تزداد بالذكرى صبابته % % والأذن تعشق مثل العين أحيانا % % 17(@)(@@) % ثم الصلاة على الهادي وشيعته % % وناصر المصطفى بالشعر حسانا % % PageV01P236 البحر : كامل تام 1(@)(@@) % سبحان من عقد الأمور وحلها % % واعز شرعة أحمد وأجلها % % 2(@)(@@) % وقضى على فئة عتت عن أمره % % بهوانه فأهانها وأذلها % % 3(@)(@@) % كفرت بأنعم ربها فأذاقها % % بأس الحروب فلا أقول لعها % % 4(@)(@@) % وحمى سياسة ملكنا بمهذب % % وال إذا ربت الحوادث فلها % % 5(@)(@@) % بالعزم والرأي السديد وإنما % % فيه الأناءة ذو الجلال أحلها % % 6(@)(@@) % يدعو مخالفه إلى نهج الهدى % % فإذا أبى شهر السيوف وسلها % % 7(@)(@@) % فسقى وروى أرضهم بدمائهم % % قتلا وأنهلها بذاك وعلها % % 8(@)(@@) % في كل ملحمة تعيش نسورها % % منها وترتاد السباع محلها % % 9(@)(@@) % رجفت عنيزة رهبة من جيشه % % لما غشى حيطانها وأظلها % % 10(@)(@@) % فعصت غواة أوردوها للردى % % وأمير سوء قادها فأضلها % % PageV01P237 11(@)(@@) % واختارت السلم الذي حقن الدما % % إذ وافقت من للهداية دلها % % 12(@)(@@) % فتحا به نصر المهيمن حزبه % % وأزاح أوغار الصدور وغلها % % 13(@)(@@) % فانظر إلى صنع المليك بلطفه % % وبعطفه كشف الشدائد كلها % % 14(@)(@@) % لا تيأسن إذا الكروب ترادفت % % فلعلها ولعلها ولعلها % % 15(@)(@@) % واصبر فإن الصبر يبلغك المنى % % حتى ترى قهر العدو أقلها % % 16(@)(@@) % والزم تقى الله العظيم ففي التقى % % عز النفوس فلا يجامع ذلها % % 17(@)(@@) % وإذا ذكرت بمدحة ذا شيمة % % فإمامنا ممن تفيا ظلها % % 18(@)(@@) % أعني أخا المجد المؤثل فيصلا % % نفسي تتوق إلى حماه تولها % % 19(@)(@@) % كفاه في بذل الندى كسحابة % % جادت بها بوابلها فسابق طلها % % 20(@)(@@) % ما زال يسمو للعلا حتى حوى % % دق المكارم في الفخار وجلها % % PageV01P238 21(@)(@@) % يشرى المدائح بالنفائس رغبة % % حتى بمفتاح 
ms79	 اللهى فتح اللها % % 22(@)(@@) % فإذا أناخ مصابرا لقبيلة % % في الحرب أسأمها الوغى وأملها % % 23(@)(@@) % ساس الرعية حين قام بعدله % % وببذله غمر النوال مقلها % % 24(@)(@@) % مني إليك خريدة هجرية % % حسناء يهوى كل صب دلها % % 25(@)(@@) % طوت المفاوز نحو قصرك لم تهب % % لصا ولا ذئب الفلاة وصلها % % 26(@)(@@) % فأجز وعجل بالقراء فلم تزل % % تقري الضيوف بها وتحمل كلها % % 27(@)(@@) % لا زلت بالنصر العزيز مؤيدا % % تدعي الأعز ومن قلاك أذلها % % 28(@)(@@) % والله أحمده على نعمائه % % رب البرية ذا الجلال وإن لها % % 29(@)(@@) % ثم الصلاة على النبي محمد % % ما باشر الأرض السماء قبلها % % 30(@)(@@) % والآل والأصحاب ما نسخ الضيا % % من شمسنا وقت الظهير ظلها % % PageV01P239 البحر : رجز تام 1(@)(@@) % الحمد لله الذي قد أبطلا % % بشرعه حيلة من تحيلا % % 2(@)(@@) % ورام بالحيلة أن يحللا % % ما حرم الشرع له وعطلا % % 3(@)(@@) % وبعد ذا فأفضل التحية % % نهدي إلى ذي الشيم المرضية % % 4(@)(@@) % فقيه عصره بلا مدافع % % ذا الفضل والعلم الشريف النافع % % 5(@)(@@) % عبد اللطيف بن أئمة الهدى % % من نصر الدين بهم وجددا % % 6(@)(@@) % وبعد ذا يا صفوة الإخوان % % طرا ويا نادرة الزمان % % 7(@)(@@) % ماذا ترى في رجل لئيم % % يدعونه الجهال بالحكيم % % 8(@)(@@) % أراد أن يسلب وقف المسجد % % لقلة التقوى وعظم الحسد % % 9(@)(@@) % فاحتال مع جماعة في ورقه % % مكذوبة مصنوعة مخترقه % % 10(@)(@@) % حوت لكل باطل مزيف % % مثل دم على قميص يوسف % % PageV01P240 11(@)(@@) % فساقنا الشيخ إلى القاضي الذي % % قدمته أكرم به من جهبذي % % 12(@)(@@) % أحضرنا واستنطق الخصم فما % % رأى لديه حجة واستعجما % % 13(@)(@@) % حتى رآه يشبه المبرسم % % يهذي وما يحسن في التكلم % % 14(@)(@@) % ولم يزل عن أمره يستخبر % % حتى بدا الأمر الذي لا ينكر % % 15(@)(@@) % صك عليه ختم قاضي البلد % % لا يستطيع جحده من أحد % % 16(@)(@@) % أثبت أن النخل وقف المسجد % % فزال ليل الشك والتردد % % 17(@)(@@) % وقد أبان إنما الحكيم % % مزور وأنه أثيم % % 18(@)(@@) % بجحده لذلك العقار % % وبيع مائه الزلال الجاري % % 19(@)(@@) % قد باعه بمائتي ريال % % بصيغة المخادع المحتال % % 20(@)(@@) % وجاء بالتمويه للعباره % % مطولا لمدة الإجاره % % PageV01P241 21(@)(@@) % إلى ثلاثمائة سنينا 
ms80	 % % يخادعون الله واللذينا % % 22(@)(@@) % تلاعب بالدين واستهزاء % % كأنهم لم يقرأوا الأحياء % % 23(@)(@@) % فما ترى في مثل ذا المزور % % هل هو بالتأديب والحبس حرى % % 24(@)(@@) % أو أنه يستوجب النكالا % % كما نرى في دينا محتالا % % 25(@)(@@) % فامنن علينا بالجواب الشافي % % في ردعكم للظالمين كافي % % 26(@)(@@) % لا زلتم للعالمين منهلا % % ورادعين كل من تحيلا % % 27(@)(@@) % ثم صلاة الله والسلام % % ما اختلف الضياء والظلام % % 28(@)(@@) % على النبي العربي أحمدا % % وآله من بهديه اهتدى % % PageV01P242 البحر : كامل تام 1(@)(@@) % يا منزل الآيات والفرقان % % بيني وبينك حرمة القرآن % % 2(@)(@@) % اشرح به صدري لمعرفة الهدى % % واعصم به قلبي من الشيطان % % 3(@)(@@) % يسر به أمري واقض مآربي % % واجر به جسدي من النيران % % 4(@)(@@) % واحطط به وزري واخلص نيتي % % واشدد به ازري واصلح شأني % % 5(@)(@@) % واكشف به ضرى وحقق توبتي % % واربح به بيعي بلا خسران % % 6(@)(@@) % طهر به قلبي وصف سريرتي % % اجمل به ذكري وأغل مكاني % % 7(@)(@@) % واقطع به طمعي وشرف همتي % % كثر به ورعي واحي جناني % % 8(@)(@@) % اسهر به ليلي واضم جوارحي % % اسبل بفيض دموعها أجفاني % % 9(@)(@@) % امزجه يا رب بلحمي مع دمي % % واغسل به قلبي من الأضغان % % 10(@)(@@) % أنت الذي صورتني وخلقتني % % وهديتني لشرائع الإيمان % % PageV01P243 11(@)(@@) % أنت الذي علمتني ورحمتني % % وجعلت صدري واعي القرآن % % 12(@)(@@) % أنت الذي أطعمتني وسقيتني % % من غير كسب يد ولا دكان % % 13(@)(@@) % وجبرتني وسترتني ونصرتني % % وغمرتني بالفضل والإحسان % % 14(@)(@@) % أنت الذي آويتني وحبوتني % % وهديتني من حيرة الخذلان % % 15(@)(@@) % وزرعت لي بين القلوب مودة % % وعطف منك برحمة وحنان % % 16(@)(@@) % ونشرت لي في العالمين محاسنا % % وسترت عن أبصارهم عصياني % % 17(@)(@@) % وجعلت ذكري في البرية شائعا % % حتى جعلت جميعهم إخواني % % 18(@)(@@) % والله لو علموا قبيح سريرتي % % لأبي السلام على من يلقاني % % 19(@)(@@) % ولا عرضوا عني وملوا صحبتي % % ولبؤت بعد كرامة بهوان % % 20(@)(@@) % لكن سترت معائبي ومثالبي % % وحلمت عن سقطي وعن طغياني % % PageV01P244 21(@)(@@) % فلك المحامد والمدائح كلها % % بخواطري وجوارحي ولساني % % 22(@)(@@) % ولقد مننت علي رب بأنعم % % مالي بشكر أقلهن يدان % % 23(@)(@@) % فوحق حكمتك التي آتيتني % % حتى شددت بنورها 