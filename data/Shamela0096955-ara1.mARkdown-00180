ms170	 الكندي: عن ابن أبي عروبة، كأنه البصري، وأبوه أبو الحر.(@)(@@)(@@)(@@) $ 4217 - مغيرة: عن محمد بن زيد، لا يعرف. -ق-(@)(@@)(@@)(@@) || مفرج(@)PageV01P396(@)(@@)(@@)(@@) $ 4218 - مفرج بن شجاع: عن يزيد بن هارون، قال الخطيب: مجهول.(@)(@@)(@@)(@@) || مفضل(@)PageV01P396(@)(@@)(@@)(@@) $ 4219 - مفضل بن صالح: عن الأعمش، قال البخاري: منكر الحديث. -ت-(@)(@@)(@@)(@@) $ 4220 - مفضل بن صدقة: شيخ لمعن القزاز، ضعفوه.(@)(@@)(@@)(@@) $ 4221 - مفضل بن عبد الله الكوفي: ضعفه أبو حاتم، هو ابن صالح. -ق-(@)(@@)(@@)(@@) $ 4222 - مفضل بن فضالة البصري: مقارب الحديث، لا يحتج به، قال الترمذي: مفضل بن فضالة المصري.(@)(@@)(@@)(@@) $ 4223 - مفضل بن فضالة المصري: أوثق وأشهر منه. -د، ت، ق- ومفضل بن محمد الضبي، عن أبي رجاء العطاردي، تركه أبو حاتم.(@)(@@)(@@)(@@) || مقاتل(@)PageV01P396(@)(@@)(@@)(@@) $ 4224 - مقاتل بن سليمان البلخي المفسر: قال وكيع وغيره: كذاب.(@)(@@)(@@)(@@) $ 4225 - مقاتل بن الفضل اليمامي: عن مجاهد، ليس بشيء.(@)(@@)(@@)(@@) $ 4226 - مقاتل بن قيس: عن علقمة بن مرثد، ضعيف الحديث.(@)(@@)(@@)(@@) || مقدام(@)PageV01P396(@)(@@)(@@)(@@) $ 4227 - مقدام بن داود الرعيني: صويلح، قال ابن أبي حاتم: تكلموا فيه.(@)(@@)(@@)(@@) || مكبر(@)PageV01P397(@)(@@)(@@)(@@) $ 4228 - مكبر بن عثمان: عن الوضين بن عطاء، متكلم فيه.(@)(@@)(@@)(@@) || مكرم(@)PageV01P397(@)(@@)(@@)(@@) $ 4229 - مكرم بن حكيم الخثعمي: قال الأزدي: ليس حديثه بشيء.(@)(@@)(@@)(@@) || مكحول(@)PageV01P397(@)(@@)(@@)(@@) $ 4230 - مكحول الدمشقي: وثقوه، قال محمد بن سعد: ضعيف. -عه-(@)(@@)(@@)(@@) || مكي(@)PageV01P397(@)(@@)(@@)(@@) $ 4231 - مكي بن عبد الله الرعيني: عن ابن عيينة، تفرد عنه بحديث.(@)(@@)(@@)(@@) $ 4232 - مكي بن قنبر: عن جعفر بن سليمان الضبعي: مجهول.(@)(@@)(@@)(@@) || منخل(@)PageV01P397(@)(@@)(@@)(@@) $ 4233 - منخل بن حكيم: عن ابن عون: مجهول.(@)(@@)(@@)(@@) || مندل(@)PageV01P397(@)(@@)(@@)(@@) $ 4234 - مندل بن علي: ضعفه أحمد والدارقطني.(@)(@@)(@@)(@@) || منذر(@)PageV01P397(@)(@@)(@@)(@@) $ 4235 - منذر بن زياد: عن ابن المنكدر، قال الدارقطني: متروك. -ق، د-(@)(@@)(@@)(@@) $ 4236 - منذر بن سعد: شيخ لسعد بن أبي هلال: مجهول.(@)(@@)(@@)(@@) $ 4237 - منذر، أبو حسان: عن سمرة، قال الدولابي: يرمى بالكذب.(@)(@@)(@@)(@@) || منصور(@)PageV01P398(@)(@@)(@@)(@@) $ 4238 - منصور بن دينار: عن الزهري، قال النسائي: ليس بالقوي.(@)(@@)(@@)(@@) $ 4239 - منصور بن زياد: قاضي شمشاط، تكلم فيه الأزدي.(@)(@@)(@@)(@@) $ 4240 - منصور بن صقير: قال أبو حاتم: ليس بقوي، سمع موسى بن أعين.-ق-(@)(@@)(@@)(@@) $ 4241 - منصور بن عبد الله بن الأحوص القرشي: مجهول.(@)(@@)(@@)(@@) $ 4242 - منصور بن عبد الله، أبو علي الذهلي الخالدي: كذبه الإدريسي.(@)(@@)(@@)(@@) $ 4243 - منصور بن 
ms171	 عبد الحميد الجزري: تركه ابن حبان.(@)(@@)(@@)(@@) $ 4244 - منصور بن عبد الرحمن الغداني الأشل: قال أبو حاتم: لا يحتج به، ووثقه غيره. -م، د-(@)(@@)(@@)(@@) $ 4245 - منصور بن عمار القاص: قال العقيلي: فيه تجهم، وقال الدارقطني: له أحاديث لا يتابع عليها.(@)(@@)(@@)(@@) $ 4246 - منصور بن مجاهد: قال الأزدي: كان يضع الحديث، روى عنه تميلة بن بدر.(@)(@@)(@@)(@@) $ 4247 - منصور بن معاذ: روى عنه وكيع: مجهول.(@)(@@)(@@)(@@) $ 4248 - منصور بن أبي منصور: عن ابن عمر رضي الله عنهما: مجهول.(@)(@@)(@@)(@@) $ 4249 - منصور بن الموفق: عن عمار بن عدي، قيل: كان يضع الحديث.(@)(@@)(@@)(@@) $ 4250 - منصور بن يعقوب: عن شريك، منكر الحديث مقل.(@)(@@)(@@)(@@) || المنكدر(@)PageV01P399(@)(@@)(@@)(@@) $ 4251 - المنكدر بن محمد بن المنكدر: اختلف قول محمد ويحيى فيه، وقد وثق. -ت-(@)(@@)(@@)(@@) || المنهال(@)PageV01P399(@)(@@)(@@)(@@) $ 4252 - المنهال بن بحر، أبو سلمة: عن حماد بن سلمة، في حديثه نظر.(@)(@@)(@@)(@@) $ 4253 - المنهال بن خليفة البكري: شيخ لأبي معاوية، ضعفه ابن معين. -د، ت، ق-(@)(@@)(@@)(@@) $ 4254 - المنهال بن عمرو: وثقه ابن معين وغيره، وتركه شعبة. -عه، خ-(@)(@@)(@@)(@@) $ 4255 - المنهال بن عمرو: عن شعبة، شيخ ما علمت فيه ضعفا.(@)(@@)(@@)(@@) || منير(@)PageV01P399(@)(@@)(@@)(@@) $ 4256 - منير بن الزبير: عن مكحول، قال ابن حبان: يأتي عن الثقات بالمعضلات، قلت: هو مقل جدا. -ق-(@)(@@)(@@)(@@) $ 4257 - منير بن عبد الله: عن أبيه، قال الأزدي: ضعيف.(@)(@@)(@@)(@@) || مهاجر(@)PageV01P399(@)(@@)(@@)(@@) $ 4258 - مهاجر بن غانم: مجهول.(@)(@@)(@@)(@@) $ 4259 - مهاجر بن كثير: عن الحكم بن مصقلة، قال أبو حاتم: متروك.(@)(@@)(@@)(@@) $ 4260 - مهاجر بن مخلد. مولى أبي بكرة: لينه وهيب بن خالد. -ت، س، ق-(@)(@@)(@@)(@@) $ 4261 - مهاجر بن منيب: عن أبي المليح: مجهول.(@)(@@)(@@)(@@) $ 4262 - مهاجر: عن معاوية بن قرة، كذلك، مهاجر اليمامي مهاجر اليمامي، كذلك، و مهدي بن الأسود كذلك.(@)(@@)(@@)(@@) || مهدي(@)PageV01P400(@)(@@)(@@)(@@) $ 4263 - مهدي بن هلال: عن يونس بن عبيد، متهم بالوضع.(@)(@@)(@@)(@@) || مهران(@)PageV01P400(@)(@@)(@@)(@@) $ 4264 - مهران بن أبي عمر الرازي: ثقة، قال البخاري: في حديثه اضطراب. -ق-(@)(@@)(@@)(@@) || مهلب(@)PageV01P400(@)(@@)(@@)(@@) $ 4265 - مهلب بن أبي حبيبة: عن الحسن: مجهول. -د، س-(@)(@@)(@@)(@@) $ 4266 - مهلب بن عثمان: عن نافع، قال الأزدي: كذاب.(@)(@@)(@@)(@@) $ 4267 - مهلب بن عيسى: شيخ لبقية، قال الأزدي: ساقط.(@)(@@)(@@)(@@) || مهنا(@)PageV01P400(@)(@@)(@@)(@@) $ 4268 - مهنا بن عبد الحميد، أبو شبل: 
ms172	 مجهول. -د-(@)(@@)(@@)(@@) || موسى(@)PageV01P400(@)(@@)(@@)(@@) $ 4269 - موسى بن إبراهيم المروزي: عن ابن لهيعة، تركه الدارقطني.(@)(@@)(@@)(@@) $ 4270 - موسى بن أسد وموسى بن أيوب: عن أبيه: مجهولان.(@)(@@)(@@)(@@) $ 4271 - موسى بن أيوب الغافقي: عن عمه عن علي، أنكره ابن معين. -د، ق-(@)(@@)(@@)(@@) $ 4272 - موسى بن بلال: عن أبي عبد الرحمن السدي، وهاه الأزدي.(@)(@@)(@@)(@@) $ 4273 - موسى بن جعفر الأنصاري: عن عمه، حديثه موضوع.(@)(@@)(@@)(@@) $ 4274 - موسى بن أبي حبيب: عن زين العابدين علي، ضعفه أبو حاتم.(@)(@@)(@@)(@@) $ 4275 - موسى بن خلف العمي: بصري، قال ابن حبان: كثرت روايته للمناكير. -د، س-(@)(@@)(@@)(@@) $ 4276 - موسى بن داود الكوفي: شيخ مجهول.(@)(@@)(@@)(@@) $ 4277 - موسى بن دهقان: عن أبي سعيد الخدري، ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 4278 - موسى بن دينار: عن سعيد بن جبير، مقل، كذبه حفص بن غياث.(@)(@@)(@@)(@@) $ 4279 - موسى بن سالم: عن عبيد الله بن عمر، قال أبو حاتم: منكر الحديث.(@)(@@)(@@)(@@) $ 4280 - موسى بن سعد، مولى أبي بكر: يروي عن الحكم: مجهول.(@)(@@)(@@)(@@) $ 4281 - موسى بن سهل الوشاء: عن ابن علية، قال الدارقطني: ضعيف.(@)(@@)(@@)(@@) $ 4282 - موسى بن سيار: عن قتادة: مجهول، ضعفه يحيى القطان.(@)(@@)(@@)(@@) $ 4283 - موسى بن شيبة: شيخ لمعمر، قال أحمد: أحاديثه مناكير.(@)(@@)(@@)(@@) $ 4284 - موسى بن صالح: عن ابن أبي ليلى، قال أبو حاتم: منكر الحديث.(@)(@@)(@@)(@@) $ 4285 - موسى بن طالب: عن أبيه، عن عطاء، ضعفه الأزدي وأباه.(@)(@@)(@@)(@@) $ 4286 - موسى بن طريف: شيخ للأعمش، ضعفه الدارقطني، وجماعة.(@)(@@)(@@)(@@) $ 4287 - موسى بن أبي الطفيل: مجهول.(@)(@@)(@@)(@@) $ 4288 - موسى بن عامر المري الدمشقي: ينفرد عن الوليد بن مسلم. -د-(@)(@@)(@@)(@@) $ 4289 - موسى بن عبد الله بن حسن: في أدبار النساء، قال البخاري: فيه نظر.(@)(@@)(@@)(@@) $ 4290 - موسى بن عبد الله الطويل: عن أنس، قال ابن حبان: روى أشياء موضوعة.(@)(@@)(@@)(@@) $ 4291 - موسى بن عبد الرحمن الثقفي الصنعاني: دجال، قال ابن حبان: وضع على ابن جريج عن عطاء عن ابن عباس كتابا في التفسير.(@)(@@)(@@)(@@) $ 4292 - موسى بن عبد الملك بن عمير: عن أبيه، قال أبو حاتم: ضعيف الحديث.(@)(@@)(@@)(@@) $ 4293 - موسى بن عبيدة الرب