ms461	 4582، إتحاف 6085.(@)(@)PageV02P712(@)(@)(@@)(@@)(@@) || AUTO 724 - باب النهي عن متعة النساء(@)(@)(@@) 2218 - (1) أخبرنا جعفر بن عون، عن عبد العزيز بن عمر بن عبد العزيز، عن الربيع بن سبرة، أن أباه حدثه: " أنهم ساروا مع رسول الله - صلى الله عليه وسلم - في حجة الوداع فقال: «استمتعوا من هذه النساء» والاستمتاع عندنا: التزويج، فعرضنا ذلك على النساء، فأبين إلا أن نضرب بيننا وبينهن أجلا، فقال رسول الله - صلى الله عليه وسلم -: «افعلوا» فخرجت أنا وابن عم لي معه برد، ومعى برد، وبرده أجود من بردي، وأنا أشب منه، فأتينا على امرأة فأعجبها شبابي وأعجبها برده فقالت: برد كبرد، وكان الأجل بينى وبينها عشرا، فبت عندها تلك الليلة، ثم غدوت فإذا رسول الله - صلى الله عليه وسلم - قائم بين الركن والباب "، فقال: «يا أيها الناس، إني قد كنت أذنت لكم في الاستمتاع* من النساء، ألا وإن الله قد حرم ذلك إلى يوم القيامة، فمن كان عنده منهن شيء فليخل سبيلها، ولا تأخذوا مما آتيتموهن شيئا» (¬1).(@)(@@) [ب 2115، د 2241، ع 2195، ف 2336، م 2199] تحفة 3809، إتحاف 4958.(@)(@@) 2219 - (2) أخبرنا محمد بن يوسف، ثنا ابن عيينة، عن الزهري، عن الربيع بن سبرة الجهني، عن أبيه قال: " نهى رسول الله - صلى الله عليه وسلم - عن نكاح المتعة عام الفتح " (¬2).(@)(@@) [ب 2116، د 2242، ع 2196، ف 2337، م 2200] تحفة 3809، إتحاف 4958.(@)(@@) 2220 - (3) أخبرنا محمد، ثنا ابن عيينة، عن الزهري، عن الحسن، وعبد الله، عن أبيهما قال: سمعت عليا يقول لابن عباس: " إن رسول الله - صلى الله عليه وسلم - نهى عن المتعة: متعة النساء، وعن لحوم الحمر الأهلية عام خيبر " (¬3).(@)(@@) [ب 2117، د 2243، ع 2197، ف 2338، م 2201] تحفة 10263، إتحاف 14721.(@)(@)(@@)(@@)(@@) || AUTO 725 - باب في نكاح المحرم(@)(@)(@@) 2221 - (1) أخبرنا عثمان بن محمد، ثنا ابن عيينة، عن أيوب بن موسى، عن نبيه بن وهب، عن أبان بن عثمان، عن عثمان، عن النبي - صلى الله عليه وسلم - قال: «المحرم لا ينكح ولا ينكح» * (¬4).(@)(@@) [ب 2118، د 2244، ع 2198، ف 2339، م 2202] تحفة 9776، إتحاف 13626.(@)(@)PageV02P713(@)(@)(@@)(@@)(@@) || AUTO 726 - باب كم كانت مهور أزواج النبي - صلى الله عليه وسلم - وبناته(@)(@)(@@) 2222 - (1) أخبرنا 
ms462	 نعيم بن حماد، ثنا عبد العزيز - هو ابن محمد - عن يزيد بن عبد الله، عن محمد بن إبراهيم، عن أبي سلمة قال: " سألت عائشة، كم كان صداق أزواج رسول الله - صلى الله عليه وسلم -؟ قالت: كان صداقه لأزواجه اثنتي عشرة أوقية ونشا ".(@)(@@) وقالت: " أتدري ما النش؟ ، قال: قلت: لا، قالت: نصف أوقية، فهذا صداق رسول الله - صلى الله عليه وسلم - لأزواجه" (¬1).(@)(@@) [ب 2119، د 2245، ع 2199، ف 2340، م 2203] تحفة 17739.(@)(@@) 2223 - (2) أخبرنا عمرو بن عون، أنا هشيم (¬2)، عن منصور بن زاذان، عن ابن سيرين، عن أبي العجفاء السلمي قال: " سمعت عمر بن الخطاب، يخطب فحمد الله وأثنى عليه، ثم قال: ألا لا تغالوا في صداق النساء، فإنها لو كانت مكرمة في الدنيا، أو تقوى عند الله، كان أولاكم بها رسول الله - صلى الله عليه وسلم - ما أصدق امرأة* من نسائه ولا أصدقت امرأة من بناته فوق اثنتى عشرة أوقية، ألا وإن أحدكم ليغالي بصداق امرأته حتى يبقى لها في نفسه عداوة حتى يقول: كلفت لك علق (¬3) القربة - أو عرق (¬4) القربة - " (¬5).(@)(@@) [ب 2120، د 2246، ع 2200، ف 2341، م 2204] تحفة 10655، إتحاف 15858.(@)(@)(@@)(@@)(@@) || AUTO 727 - باب ما يجوز أن يكون مهرا(@)(@)(@@) 2224 - (1) أخبرنا عمرو بن عون، أنا حماد بن زيد، عن أبي حازم، عن سهل بن سعد قال: أتت امرأة إلى النبي - صلى الله عليه وسلم - فقالت: إنها وهبت نفسها لله ولرسوله، فقال رسول الله - صلى الله عليه وسلم -: «ما لي في PageV02P714(@)(@@) النساء من حاجة» فقال رجل: زوجنيها، قال: «أعطها ثوبا». قال: لا أجد، قال: «أعطها ولو خاتما من حديد» فاعتل له فقال: «ما معك من القرآن؟ » قال: كذا وكذا، قال: «فقد زوجتكها على ما معك من القرآن» (¬1).(@)(@@) [ب 2121، د 2247، ع 2201، ف 2342، م 2205] تحفة 4670، إتحاف 6215.(@)(@)(@@)(@@)(@@) || AUTO 728 - باب في خطبة النكاح(@)(@)(@@) 2225 - (1) حدثنا أبو الوليد، وحجاج قالا: ثنا شعبة قال: أنا أبو إسحاق قال: سمعت أبا عبيدة، يحدث عن عبد الله قال: " علمنا رسول الله - صلى الله عليه وسلم - خطبة الحاجة: «الحمد لله - أو إن الحمد لله - نحمده ونستعينه 
ms463	 ونستغفره، ونعوذ بالله من شرور أنفسنا، من يهده الله فلا مضل له، ومن يضلل فلا هادي له، أشهد أن لا إله إلا الله*، وأشهد أن محمدا عبده ورسوله» ثم يقرأ ثلاث آيات {ياأيها الذين آمنوا اتقوا الله حق تقاته ولا تموتن إلا وأنتم مسلمون} (¬2) {ياأيها الناس اتقوا ربكم الذي خلقكم من نفس واحدة وخلق منها زوجها وبث منهما رجالا كثيرا ونساء واتقوا الله الذي تساءلون به والأرحام إن الله كان عليكم رقيبا} (¬3)، {ياأيها الذين آمنوا اتقوا الله وقولوا قولا سديدا (70) يصلح لكم أعمالكم ويغفر لكم ذنوبكم ومن يطع الله ورسوله فقد فاز فوزا عظيما} (¬4) ثم يتكلم بحاجته " (¬5).(@)(@@) [ب 2122، د 2248، ع 2202، ف 2343، ن؟ ؟ ، م 2206] تحفة 9618، إتحاف 13346.(@)(@)PageV02P715(@)(@)(@@)(@@)(@@) || AUTO 729 - باب الشرط في النكاح(@)(@)(@@) 2226 - (1) أخبرنا* أبو عاصم، عن عبد الحميد بن جعفر، عن يزيد بن أبي حبيب، عن مرثد (¬1) بن عبد الله، عن عقبة بن عامر، عن النبي - صلى الله عليه وسلم -[قال: «إن أحق الشروط أن توفوا به ما استحللتم به الفروج» (¬2).(@)(@@) [ب 2123، د 2249، ع 2203، ف 2344، م 2207] تحفة 9953، إتحاف 13898.(@)(@)(@@)(@@)(@@) || AUTO 730 - باب في الوليمة(@)(@)(@@) 2227 - (1) أخبرنا أبو النعمان، ثنا حماد بن زيد، عن ثابت، عن أنس: " أن النبي - صلى الله عليه وسلم -] (¬3) رأى على عبد الرحمن بن عوف صفرة، فقال: «ما هذه الصفرة؟ » قال: تزوجت امرأة على وزن نواة من ذهب، قال ": «بارك الله لك، أولم ولو بشاة» (¬4).(@)(@@) [ب 2124، د 2250، ع 2204، ف 2345، م 2208] تحفة 288، إتحاف 444.(@)(@)(@@)(@@)(@@) || AUTO 731 - باب ما جاء في إجابة الوليمة(@)(@)(@@) 2228 - (1) أخبرنا عبد الله بن سعيد، ثنا عقبة بن خالد، عن عبيد الله، عن نافع، عن ابن عمر قال: قال رسول الله - صلى الله عليه وسلم -: «إذا دعى أحدكم إلى وليمة فليجب» (¬5).(@)(@@) قال أبو محمد: " ينبغى أن يجيب، وليس الأكل عليه بواجب ".(@)(@@) [ب 2125، د 2251، ع 2205، ف 2346، م 2209] تحفة 7884، إتحاف 10937.(@)(@)PageV02P716(@)(@)(@@)(@@)(@@) || AUTO 732 - باب في العدل بين النساء(@)(@)(@@) 2229 - (1) أخبرنا أبو الوليد، ثنا همام، عن قتادة، عن النضر بن أنس، عن بشير بن نهيك، عن أبي هريرة، عن النبي - صلى 
ms464	 الله عليه وسلم - قال: «من كانت له امرأتان فمال إلى إحداهما، جاء يوم القيامة وشقه مائل» (¬1).(@)(@@) [ب 2126، د 2252، ع 2206، ف 2347، م 2210] تحفة 12213، إتحاف 17904.(@)(@)(@@)(@@)(@@) || AUTO 733 - باب في القسمة بين النساء(@)(@)(@@) 2230 - (1) أخبرنا عمرو بن عاصم، ثنا حماد بن سلمة، عن أيوب، عن أبي قلابة، عن عبد الله بن يزيد الخطمي، عن عائشة قالت: كان رسول الله - صلى الله عليه وسلم - يقسم فيعدل، ويقول: «اللهم هذه قسمتى فيما أملك، فلا تلومني فيما تملك ولا أملك» (¬2).(@)(@@) [ب 2127، د 2253، ع 2207، ف 2348، م 2211] تحفة 16290.(@)(@)(@@)(@@)(@@) || AUTO 734 - باب الرجل يكون عنده النسوة(@)(@)(@@) *(@)(@@) 2230 - (1) أخبرنا إسماعيل، ثنا ابن المبارك، عن يونس بن يزيد، عن الزهري، عن عروة، عن عائشة قالت: " كان رسول الله - صلى الله عليه وسلم - إذا سافر أقرع بين نسائه، فأيتهن خرج* سهمها خرج بها معه" (¬3).(@)(@@) [ب 2128، د 2254، ع 2208، ف 2349، م 2212] تحفة 16703.(@)(@)PageV02P717(@)(@)(@@)(@@)(@@) || AUTO 735 - باب الإقامة عند الثيب والبكر إذا بنى بها(@)(@)(@@) 2231 - (1) أخبرنا يعلى، ثنا محمد بن إسحاق، عن أيوب، عن أبي قلابة، عن أنس بن مالك قال: قال رسول الله - صلى الله عليه وسلم -: «للبكر سبع، وللثيب ثلاث» (¬1).(@)(@@) [ب 2129، د 2255، ع 2209، ف 2350، م 2213] تحفة 944، إتحاف 1260.(@)(@@) 2232 - (2) أخبرنا عبد الله بن محمد بن أبي شيبة، ثنا يحيى بن سعيد، عن سفيان، عن محمد بن أبي بكر، عن عبد الملك بن أبي بكر بن عبد الرحمن بن الحارث بن هشام، عن أبيه، عن أم سلمة: أن رسول الله - صلى الله عليه وسلم - لما تزوج أم سلمة أقام عندها ثلاثا، وقال: «إنه ليس بك على أهلك هوان، إن شئت سبعت لك، وإن سبعت لك سبعت لسائر نسائي» (¬2).(@)(@@) [ب 2130، د 2256، ع 2210، ف 2351، م 2214] تحفة 18229.(@)(@)(@@)(@@)(@@) || AUTO 736 - باب بناء الرجل بأهله في شوال(@)(@)(@@) 2233 - (1) أخبرنا عبيد الله بن موسى، عن سفيان، عن إسماعيل بن أمية، عن عبد الله بن عروة، عن عروة، عن عائشة قالت: " تزوجني رسول الله - صلى الله عليه وسلم - في شوال، وأدخلت عليه في شوال، فأي نسائه كان أحظى عنده مني؟ ، قال: وكانت تستحب 
ms465	 أن يدخل على النساء في شوال (¬3).(@)(@@) [ب 2131، د 2257، ع 2211، ف 2352، م 2215] تحفة 16355.(@)(@)(@@)(@@)(@@) || AUTO 737 - باب القول عند الجماع(@)(@)(@@) 2234 - (1) أخبرنا عبيد الله بن موسى، عن إسرائيل، عن منصور، عن سالم، عن كريب، عن ابن عباس قال: قال رسول الله - صلى الله عليه وسلم -: «ما يمنع أحدكم أن يقول حين يجامع أهله: بسم الله، اللهم جنبنا الشيطان، وجنب الشيطان ما رزقتنا، فإن قضى الله ولدا لم يضره الشيطان» (¬4).(@)(@@) [ب 2132، د 2258، ع 2212، ف 2353، م 2216] تحفة 6365 إتحاف 8757.(@)(@)PageV02P718(@)(@)(@@)(@@)(@@) || AUTO 738 - باب النهي عن إتيان النساء في أعجازهن(@)(@)(@@) 2235 - (1) أخبرنا عبد الله بن سعيد، ثنا أبو أسامة، عن الوليد* بن كثير، عن عبيد الله بن عبد الله بن الحصين، عن عبد الملك بن عمرو بن قيس الخطمي، عن هرمي بن عبد الله قال: سمعت خزيمة بن ثابت قال: سمعت رسول الله - صلى الله عليه وسلم - يقول: «إن الله لا يستحيى من الحق، لا تأتوا النساء في* أعجازهن» (¬1).(@)(@@) [ب 2133، د 2259، ع 2213، ف 2354، م 2217] تحفة 3530 إتحاف 4496.(@)(@@) 2236 - (2) أخبرنا خالد بن مخلد، ثنا مالك، عن محمد بن المنكدر، عن جابر بن عبد الله: أن اليهود قالوا للمسلمين: من أتى امرأته وهي مدبرة جاء ولده أحول، فأنزل الله تعالى: (نساؤكم حرث لكم فأتوا حرثكم أنى شئتم) (¬2).(@)(@@) [ب 2134، د 2260، ع 2214، ف 2355، م 2218] تحفة 3030 إتحاف 3690.(@)(@)(@@)(@@)(@@) || AUTO 739 - باب الرجل يرى المرأة فيخاف على نفسه(@)(@)(@@) 2237 - (1) أخبرنا قبيصة، أنا سفيان، عن أبي إسحاق، عن عبد الله بن حلام، عن عبد الله بن مسعود قال: رأى رسول الله - صلى الله عليه وسلم - امرأة فأعجبته، فأتى سودة وهي تصنع طيبا، وعندها نساء فأخلينه، فقضى حاجته ثم قال: «أيما رجل رأى امرأة تعجبه فليقم إلى أهله، فإن معها مثل الذي معها» (¬3).(@)(@@) [ب 2135، د 2261، ع 2215، ف 2356، م 2219] إتحاف 12764.(@)(@)PageV02P719(@)(@)(@@)(@@)(@@) || AUTO 740 - باب في تزويج الأبكار(@)(@)(@@) 2238 - (1) أخبرنا عبد الله بن مطيع، ثنا هشيم، أنا سيار، عن الشعبي، ثنا جابر بن عبد الله قال: كنا مع رسول الله - صلى الله عليه وسلم - في سفر فلما 
ms466	 قفلنا تعجلت، فلحقني راكب، قال: فالتفت فإذا أنا برسول الله - صلى الله عليه وسلم - فقال لي: «ما أعجلك يا جابر؟ » قال: إني حديث عهد بعرس، قال: «أفبكرا تزوجتها أم ثيبا؟ » قال: قلت: بل ثيبا، قال: «فهلا بكرا تلاعبها وتلاعبك» قال: ثم قال لي: «إذا قدمت فالكيس الكيس» (¬1) قال: فلما قدمنا ذهبنا ندخل، قال: «أمهلوا حتى ندخل ليلا» أي عشاء: «لكى تمتشط الشعثة وتستحد المغيبة» (¬2).(@)(@@) [ب 2136، د 2262، ع 2216، ف 2357، م 2220] تحفة 2342 إتحاف 2822.(@)(@)(@@)(@@)(@@) || AUTO 741 - باب في الغيلة(@)(@)(@@) 2239 - (1) أخبرنا خالد* بن مخلد، ثنا مالك، عن محمد بن عبد الرحمن بن نوفل الأسدي، عن عروة، عن عائشة، عن جدامة (¬3) بنت وهب الأسدية قالت: قال رسول الله - صلى الله عليه وسلم -: «لقد هممت أن أنهى عن الغيلة، حتى ذكرت أن فارس والروم يصنعون ذلك، فلا يضر أولادهم» (¬4).(@)(@@) قال أبو محمد: " الغيلة أن يجامعها وهى ترضع ".(@)(@@) [ب 2137، د 2263، ع 2217، ف 2358، م 2221] تحفة 15786.(@)(@)PageV02P720(@)(@)(@@)(@@)(@@) || AUTO 742 - باب النهي عن ضرب النساء(@)(@)(@@) 2240 - (1) أخبرنا جعفر بن عون، أنا هشام بن عروة، عن أبيه، عن عائشة قالت: " ما ضرب رسول الله - صلى الله عليه وسلم - خادما قط، ولا ضرب بيده شيئا قط، إلا أن يجاهد في سبيل الله " (¬1).(@)(@@) [ب 2138، د 2264، ع 2218، ف 2359، م 2222] تحفة 16848.(@)(@@) 2241 - (2) أخبرنا محمد بن أحمد بن أبي خلف، ثنا سفيان، عن الزهري، عن عبيد* الله بن عبد الله، عن إياس بن عبد الله بن أبي ذباب قال: قال رسول الله - صلى الله عليه وسلم -: «لا تضربوا إماء الله». فجاء عمر إلى رسول الله - صلى الله عليه وسلم - فقال: قد ذئرن (¬2) على أزواجهن. فرخص في ضربهن، فأطاف بآل رسول الله - صلى الله عليه وسلم - نساء كثير يشكون أزواجهن "، فقال النبي - صلى الله عليه وسلم -: «لقد طاف بآل محمد نساء كثير يشكون أزواجهن، ليس أولئك بخياركم» (¬3).(@)(@@) [ب 2139، د 2265، ع 2219، ف 2360، م 2223] تحفة 1746 إتحاف 2046.(@)(@@) 2242 - (3) أخبرنا جعفر بن عون، أنا هشام بن عروة، عن أبيه، عن عبد الله بن زمعة قال: خطب رسول الله - صلى 
ms467	 الله عليه وسلم - الناس يوما ووعظهم في النساء فقال: «ما بال الرجل يجلد امرأته جلد العبد، ولعله يضاجعها في آخر يومه» (¬4).(@)(@@) [ب 2140، د 2266، ع 2220، ف 2361، م 2224] تحفة 5294.(@)(@)(@@)(@@)(@@) || AUTO 743 - باب مداراة الرجل أهله(@)(@)(@@) 2243 - (1) أخبرنا محمد بن عبد الله الرقاشي، ثنا عبد الوارث، ثنا الجريري، عن أبي العلاء، عن نعيم بن قعنب، عن أبي ذر أن رسول الله - صلى الله عليه وسلم - قال: «إن المرأة خلقت من ضلع، فإن* تقمها كسرتها، فدارها فإن فيها أودا أو بلغة» (¬5).(@)(@@) [ب 2141، د 2267، ع 2221، ف 2362، م 2225] تحفة 11990 إتحاف 17636.(@)(@)PageV02P721(@)(@)(@@) 2244 - (2) أخبرنا خالد بن مخلد، ثنا مالك، عن أبي الزناد، عن الأعرج، عن أبي هريرة قال: قال رسول الله - صلى الله عليه وسلم -: «إنما المرأة كالضلع الأعوج إن تقمها تكسرها، وإن تستمتع تستمتع وفيها عوج» (¬1).(@)(@@) [ب 2142، د 2268، ع 2222، ف 2363، م 2226] تحفة 13841.(@)(@)(@@)(@@)(@@) || AUTO 744 - باب في العزل(@)(@)(@@) 2245 - (1) أخبرنا سليمان بن داود الهاشمي، عن إبراهيم بن سعد، عن الزهري، عن عبيد الله بن عبد الله بن عتبة، عن أبي سعيد قال: سأل رجل رسول الله - صلى الله عليه وسلم - عن العزل فقال: «أوتفعلون ذلك؟ ، فلا عليكم أن لا تفعلوا، فإنه ليس من نسمة قضى الله تعالى أن تكون إلا كانت» (¬2).(@)(@@) [ب 2143، د 2269، ع 2223، ف 2364، م 2227] تحفة 4141 إتحاف 5442.(@)(@@) 2246 - (2) أخبرنا يزيد بن هارون، أنا ابن عون، عن محمد بن سيرين، عن عبد الرحمن بن بشر، يرد الحديث إلى أبي سعيد الخدري قال: " قلنا: يا رسول الله، الرجل يكون له الجارية فيصيب منها، ويكره أن تحمل أفيعزل عنها؟ ، وتكون عنده المرأة ترضع فيصيب منها، ويكره أن تحمل فيعزل عنها؟ "، قال: «لا عليكم أن لا تفعلوا، فإنما هو القدر» (¬3).(@)(@@) قال ابن عون: فذكرت ذلك* للحسن، فقال: " والله لكأن هذا زاجرا، والله لكأن هذا زاجرا ".(@)(@@) [ب 2144، د 2270، ع 2224، ف 2365، م 2228] تحفة 4113 إتحاف 5401.(@)(@)PageV02P722(@)(@)(@@)(@@)(@@) || AUTO 745 - باب في الغيرة(@)(@)(@@) 2247 - (1) أخبرنا يعلى، ثنا الأعمش، عن شقيق، عن عبد الله قال: قال رسول الله - صلى الله عليه وسلم -: «ليس أحد أغير 
ms468	 من الله لذلك حرم الفواحش، وليس أحد أحب إليه المدح من الله» (¬1).(@)(@@) [ب 2145، د 2271، ع 2225، ف 2366، م 2229] تحفة 9256 إتحاف 12681.(@)(@@) 2248 - (2) أخبرنا أبو المغيرة، ثنا الأوزاعي، ثنا يحيى بن أبي كثير، عن محمد بن إبراهيم قال: حدثني ابن جابر بن عتيك حدثني أبي أن رسول الله - صلى الله عليه وسلم - قال: «من الغيرة ما يحب الله، ومنها ما يبغض الله، فالغيرة التي يحب الله: الغيرة في الريبة، والغيرة التي يبغض الله*: «لغيرة في غير ريبة» (¬2).(@)(@@) [ب 2146، د 2272، ع 2226، ف 2367، م 2230] تحفة 3174 إتحاف 3880.(@)(@@) 2249 - (3) أخبرنا زكريا بن عدي، ثنا عبيد الله بن عمرو، عن عبد الملك بن عمير، عن وراد مولى المغيرة، عن المغيرة قال: " بلغ رسول الله - صلى الله عليه وسلم - أن سعد بن عبادة يقول: لو وجدت معها رجلا لضربتها بالسيف غير مصفح "، فقال رسول الله - صلى الله عليه وسلم -: «أتعجبون من غيرة سعد؟ ، أنا أغير من سعد، والله أغير مني، ولذلك حرم الفواحش ما ظهر منها وما بطن، ولا شخص أغير من الله، ولا أحب إليه من المعاذر، ولذلك بعث النبيين مبشرين ومنذرين، ولا شخص أحب إليه المدح من الله، ولذلك وعد الجنة» (¬3).(@)(@@) [ب 2147، د 2273، ع 2227، ف 2368، م 2231] تحفة 11538 إتحاف 16986.(@)(@)PageV02P723(@)(@)(@@)(@@)(@@) || AUTO 746 - باب في حق الزوج على المرأة(@)(@)(@@) 2250 - (1) أخبرنا هاشم بن القاسم، ثنا شعبة، أنا قتادة، عن زرارة بن أوفي العامري، عن أبي هريرة، عن النبي - صلى الله عليه وسلم - قال: «إذا باتت المرأة هاجرة لفراش زوجها، لعنتها الملائكة حتى ترجع» (¬1).(@)(@@) [ب 2148، د 2274، ع 2228، ف 2369، م 2232] تحفة 12897 إتحاف 18374.(@)(@)(@@)(@@)(@@) || AUTO 747 - باب في اللعان(@)(@)(@@) 2251 - (1) أخبرنا عبيد الله بن عبد المجيد، ثنا مالك، عن ابن شهاب، عن سهل بن سعد: " أن عويمرا العجلاني قال: يا رسول الله، أرأيت رجلا وجد مع امرأته رجلا، أيقتله فتقتلونه، أم كيف يفعل؟ "، فقال رسول الله - صلى الله عليه وسلم -: «قد أنزل الله فيك وفي صاحبتك، فاذهب فأت بها».(@)(@@) قال سهل: " فتلاعنا وأنا مع الناس عند رسول الله - صلى الله 
ms469	 عليه وسلم -، فلما فرغا من تلاعنهما قال: كذبت* عليها يا رسول الله إن أمسكتها، فطلقها ثلاثا قبل أن يأمره رسول الله - صلى الله عليه وسلم - ".(@)(@@) قال ابن شهاب: " فكانت تلك بعد سنة المتلاعنين "* (¬2).(@)(@@) [ب 2149، د 2275، ع 2229، ف 2370، م 2233] تحفة 4805 إتحاف 6274.(@)(@@) 2252 - (2) أخبرنا محمد بن يوسف، عن الأوزاعي، عن ابن شهاب، عن سهل بن سعد: " أن عويمرا أتى عاصم بن عدي، وكان سيد بني عجلان، فذكر مثله، ولم يذكر طلقها ثلاثا " (¬3).(@)(@@) [ب 2149، د 2276، ع 2230، ف 2371، م 2234] تحفة 4805 إتحاف 6274.(@)(@)PageV02P724(@)(@)(@@) 2253 - (3) أخبرنا يزيد بن هارون، أنا عبد الملك بن أبي سليمان قال: سمعت سعيد بن جبير يقول: " سئلت عن المتلاعنين في إمارة مصعب بن الزبير، أيفرق بينهما؟ ، فما دريت ما أقول، قال: فقمت حتى أتيت منزل عبد الله بن عمر فقلت للغلام: استأذن لي عليه، فقال: إنه قائل لا تستطيع أن تدخل عليه، قال: فسمع ابن عمر صوتي فقال: ابن جبير؟ ، فقلت: نعم، فقال: ادخل، فما جاء بك هذه الساعة إلا حاجة، قال: فدخلت عليه فوجدته وهو مفترش برذعة رحله، متوسد مرفقة - أو قال: نمرقة، شك عبد الله - حشوها ليف فقلت: يا أبا عبد الرحمن المتلاعنان أيفرق بينهما؟ ، قال: سبحان الله، نعم، إن أول من سأل عن ذلك فلان فقال: يا رسول الله، أرأيت لو أن أحدنا رأى امرأته على فاحشة كيف يصنع؟ ، إن سكت سكت على أمر عظيم، وإن تكلم فمثل ذلك، قال: فسكت النبي - صلى الله عليه وسلم - فلم يجبه فقام لحاجته، فلما كان بعد ذلك أتى النبي - صلى الله عليه وسلم - فقال: يا رسول الله، إن الذي سألتك عنه قد ابتليت به، قال: فأنزل الله تعالى هؤلاء الآيات: التى في سورة النور {والذين يرمون أزواجهم} (¬1) حتى ختم هؤلاء الآيات قال: فدعا الرجل فتلاهن عليه، وذكره بالله وأخبره أن عذاب الدنيا أهون من عذاب الآخرة، فقال: ما كذبت عليها، ثم دعا المرأة فوعظها وذكرها وأخبرها أن عذاب الدنيا أهون من عذاب الآخرة، فقالت: والذي بعثك بالحق إنه لكاذب، فدعا 
ms470	 الرجل فشهد* أربع شهادات بالله إنه لمن الصادقين {والخامسة أن لعنت الله عليه إن كان من الكاذبين} (¬2) ثم أتي بالمرأة فشهدت أربع شهادات بالله* إنه لمن الكاذبين {والخامسة أن غضب الله عليها إن كان من الصادقين} (¬3) ثم فرق بينهما " (¬4).(@)(@@) [ب 2150، د 2277، ع 2231، ف 2372، م 2235] تحفة 7058 إتحاف 9733.(@)(@@) 2254 - (4) أخبرنا محمد بن عبد الله الرقاشي قال: حدثني مالك قال: سمعت نافعا، عن عبد الله بن عمر قال: " فرق رسول الله - صلى الله عليه وسلم - بين المتلاعنين، وألحق الولد بأمه " (¬5).(@)(@@) [ب 2151، د 2278، ع 2232، ف 2373، م 2236] تحفة 8322 إتحاف 11175.(@)(@)PageV02P725(@)(@)(@@)(@@)(@@) || AUTO 748 - باب في العبد يتزوج بغير إذن سيده(@)(@)(@@) 2255 - (1) أخبرنا أبو نعيم، ثنا الحسن بن صالح، عن عبد الله بن محمد بن عقيل قال: سمعت جابرا يقول: قال رسول الله - صلى الله عليه وسلم -: «أيما عبد تزوج بغير إذن مواليه، أو أهله فهو عاهر» (¬1).(@)(@@) [ب 2152، د 2279، ع 2233، ف 2374، م 2237] تحفة 2366 إتحاف 2862.(@)(@@) 2256 - (2) أخبرنا مالك بن إسماعيل، ثنا مندل بن علي، عن ابن جريج، عن موسى بن عقبة، عن نافع، عن ابن عمر، عن النبي - صلى الله عليه وسلم - قال: «أيما عبد تزوج بغير إذن مواليه فهو زان» (¬2).(@)(@@) [ب 2153، د 2280، ع 2234، ف 2375، م 2238] تحفة 8508 إتحاف 11393.(@)(@)(@@)(@@)(@@) || AUTO 749 - باب الولد للفراش(@)(@)(@@) 2257 - (1) أخبرنا محمد بن يوسف، ثنا ابن عيينة، عن الزهري، عن ابن المسيب، عن أبي هريرة، يرفعه قال: «الولد للفراش، وللعاهر الحجر» (¬3).(@)(@@) [ب 2154، د 2281، ع 2235، ف 2376، م 2239] تحفة 13134 إتحاف 18639.(@)(@@) 2258 - (2) حدثنا عبد الله بن مسلمة، ثنا مالك، عن الزهري، عن عروة، عن عائشة زوج النبي - صلى الله عليه وسلم -، أن رسول الله - صلى الله عليه وسلم - قال: «الولد للفراش» (¬4).(@)(@@) [ب 2155، د 2282، ع 2236، ف 2377، م 2240].(@)(@)PageV02P726(@)(@)(@@) 2259 - (3) أخبرنا الحكم بن نافع، أنا شعيب، عن الزهري، أخبرني عروة، أن عائشة زوج النبي - صلى الله عليه وسلم - قالت: " كان عتبة بن أبي وقاص عهد إلى أخيه: سعد بن أبي وقاص أن يقبض إليه ابن وليدة زمعة، فقال عتبة: إنه ابني، فلما قدم النبي - صلى الله 
ms471	 عليه وسلم - زمن الفتح أخذ سعد بن أبي وقاص* ابن وليدة زمعة، فإذا هو أشبه الناس بعتبة بن أبي وقاص، فقال النبي - صلى الله عليه وسلم -: «هو لك يا عبد بن زمعة» من أجل أنه ولد على فراش أبيه، وقال النبي - صلى الله عليه وسلم -: «احتجبى منه يا سودة بنت زمعة» مما رأى من شبهه بعتبة بن أبي وقاص. وسودة بنت زمعة: زوج النبي - صلى الله عليه وسلم - " (¬1).(@)(@@) [ب 2156، د 2283، ع 2237، ف 2378، م 2241] تحفة 16478.(@)(@)(@@)(@@)(@@) || AUTO 750 - باب من جحد ولده وهو يعرفه(@)(@)(@@) 2260 - (1) أخبرنا عبد الله بن صالح، حدثني الليث، حدثني يزيد بن عبد الله، عن عبد الله بن يونس، عن سعيد بن* أبي سعيد، عن أبي هريرة، أنه سمع رسول الله - صلى الله عليه وسلم - يقول: حين أنزلت آية الملاعنة: «أيما امرأة أدخلت على قوم نسبا ليس منهم، فليست من الله في شيء، ولم يدخلها الله جنته، وأيما رجل جحد ولده وهو ينظر إليه، احتجب الله منه، وفضحه على رءوس الأولين والآخرين» (¬2).(@)(@@) قال عبد الله: قال محمد بن كعب القرظي، وسعيد، يحدثه به: "بهذا، قد بلغني هذا الحديث عن رسول الله - صلى الله عليه وسلم - ".(@)(@@) [ب 2157، د 2284، ع 2238، ف 2379، 2380، م 2242] تحفة 12972 إتحاف 18485.(@)(@)PageV02P727(@)(@)(@@)(@@)(@@) || AUTO 751 - باب الرجل يتزوج امرأة أبيه(@)(@)(@@) 2261 - (1) أخبرنا عبد الله بن جعفر الرقي، ثنا عبيد الله بن عمرو، عن زيد، عن عدي بن ثابت، عن يزيد بن البراء، عن أبيه قال: لقيت عمي ومعه راية فقلت: أين تريد؟ ، فقال: بعثني رسول الله - صلى الله عليه وسلم - إلى رجل نكح امرأة أبيه، فأمرني أن أضرب عنقه، وآخذ ماله (¬1).(@)(@@) [ب 2158، د 2285، ع 2239، ف 2381، م 2243] تحفة 15534.(@)(@)(@@)(@@)(@@) || AUTO 752 - باب قول الله تعالى: {لا يحل لك النساء من بعد}(@)(@)(@@) 2262 - (1) أخبرنا معلى بن أسد (¬2) قال: ثنا وهيب، عن داود بن أبي هند، عن محمد بن أبي موسى (¬3)، عن رجل من الأنصار: يسمى زيادا قال: " قلت لأبي بن كعب: أرأيت لو أن أزواج النبي - صلى الله عليه وسلم - متن كان 
ms472	 يحل له أن يتزوج؟ ، قال: نعم، إنما أحل الله له ضربا من النساء، ووصف له صفة، فقال: {لا يحل لك النساء من بعد} (¬4) من بعد هذه الصفة "* (¬5).(@)(@@) [ب 2159، د 2286، ع 2240، ف 2382، م 2244] إتحاف 40.(@)(@)PageV02P728(@)(@)(@@) 2263 - (2) أخبرنا المعلى، ثنا وهيب، عن ابن جريج، عن عطاء، عن عبيد بن عمير، عن عائشة قالت: " ما توفي رسول الله - صلى الله عليه وسلم - حتى أحل الله له أن يتزوج من النساء ما شاء " (¬1).(@)(@@) [ب 2160، د 2287، ع 2241، ف 2383، م 2245] تحفة 16328.(@)(@)(@@)(@@)(@@) || AUTO 753 - باب في الأمة يجعل عتقها صداقها(@)(@)(@@) 2264 - (1) أخبرنا مسدد، ثنا حماد بن زيد، عن شعيب، بن الحبحاب، عن أنس: " أن رسول الله - صلى الله عليه وسلم - أعتق صفية، وجعل عتقها صداقها " (¬2).(@)(@@) [ب 2161، د 2288، ع 2242، ف 2384، م 2246] تحفة 1429 إتحاف 1213.(@)(@@) 2265 - (1) أخبرنا أبو النعمان، ثنا أبو عوانة، عن قتادة، عن أنس: " أن رسول الله - صلى الله عليه وسلم - أعتق صفية وتزوجها، وجعل عتقها صداقها " (¬3).(@)(@@) [ب 2162، د 2289، ع 2243، ف 2385، م 2247] تحفة 912 إتحاف 1606.(@)(@)(@@)(@@)(@@) || AUTO 754 - باب فضل من أعتق أمة ثم تزوجها(@)(@)(@@) *(@)(@@) 2266 - (1) أخبرنا عمرو بن عون، أنا هشيم، عن صالح بن صالح بن حي الهمداني قال: " كنت عند الشعبي، فأتاه رجل من أهل خراسان فقال: يا أبا عمرو إن من قبلنا من أهل خراسان يقولون في الرجل إذا أعتق أمته ثم تزوجها فهو كالراكب بدنته. فقال الشعبى: حدثني أبو بردة بن أبي موسى عن أبيه قال قال رسول الله - صلى الله عليه وسلم -: «ثلاثة يؤتون أجرهم مرتين: رجل من أهل الكتاب آمن بنبيه ثم أدرك النبي فآمن به واتبعه، وعبد مملوك أدى حق الله وحق مواليه فله PageV02P729(@)(@@) أجران، ورجل كانت له أمة فغذاها فأحسن غذاءها، وأدبها فأحسن تأديبها، فأعتقها وتزوجها فله أجران» (¬1)(@)(@@) ثم قال للرجل: خذ هذا* الحديث بغير شيء، فقد كان يرحل فيما دون هذا إلى المدينة ".(@)(@@) قال هشيم: " أفادوني بالبصرة فأتيته فسألته عنه ".(@)(@@) [ب 2163، د 2290، ع 2244، ف 2386، م 2248] تحفة 9107 إتحاف 12290.(@)(@@) 2267 - (2) أخبرنا سهل بن حماد، عن شعبة، عن صالح بن حي، عن 
ms473	 الشعبي، عن أبي بردة، عن أبيه، عن النبي - صلى الله عليه وسلم -: نحو هذا الحديث (¬2).(@)(@@) [ب 2163، د 2291، ع 2245، ف 2387، م 2249] تحفة 9107.(@)(@)(@@)(@@)(@@) || AUTO 755 - باب الرجل يتزوج المرأة فيموت قبل أن يفرض لها(@)(@)(@@) 2268 - (1) أخبرنا محمد بن يوسف، ثنا سفيان، عن منصور، عن إبراهيم، عن علقمة، عن عبد الله: " في رجل تزوج امرأة ولم يكن فرض لها شيئا، ولم يدخل بها، ومات عنها، قال فيها: لها صداق نسائها، وعليها العدة، ولها الميراث ".(@)(@@) قال معقل الأشجعي: " قضى رسول الله - صلى الله عليه وسلم - في بروع بنت واشق: امرأة من بني رواس، بمثل ما قضيت (¬3)، قال: ففرح بذلك ".(@)(@@) قال أبو محمد: وسفيان (¬4) يأخذ بهذا.(@)(@@) [ب 2164، د 2292، ع 2246، ف 2388، 2389، 2390، م 2250] تحفة 11461 إتحاف 12995، 16883.(@)(@)(@@)(@@)(@@) || AUTO 756 - باب ما يحرم من الرضاع(@)(@)(@@) 2269 - (1) أخبرنا إسحاق، ثنا روح، ثنا مالك، عن عبد الله بن أبي بكر بن عمرو بن حزم، عن عمرة، عن عائشة: " أنها كانت مع النبي - صلى الله عليه وسلم - في بيت حفصة، فسمعت صوت إنسان، قالت: قلت: يا رسول الله، سمعت صوت إنسان في بيتك، فقال رسول الله - صلى الله عليه وسلم -: «أراه فلانا» لعم PageV02P730(@)(@@) حفصة من الرضاعة، قالت عائشة: يا رسول* الله، ولو كان فلان حيا لعمها من الرضاعة دخل علي؟ "، فقال رسول الله - صلى الله عليه وسلم -: «نعم، يحرم من الرضاعة ما يحرم من الولادة» (¬1).(@)(@@) [ب 2165، د 2293، ع 2247، ف 2391، م 2251] تحفة 17900.(@)(@@) 2270 - (2) أخبرنا جعفر بن عون، أنا هشام بن عروة، عن أبيه قال: أخبرتني عائشة: " أن عمها أخا أبي القعيس جاء يستأذن عليها بعد ما ضرب الحجاب، فأبت أن تأذن له حتى يأتي رسول الله - صلى الله عليه وسلم - فأستأذنه، فلما جاء النبي - صلى الله عليه وسلم - ذكرت ذلك له فقالت: جاء* عمي أخو أبي القعيس فرددته حتى أستأذنك، قال: «أوليس بعمك؟ » قالت: إنما أرضعتني المرأة ولم يرضعني الرجل"، فقال: «إنه عمك فليلج عليك» (¬2).(@)(@@) قالت (¬3): وكانت عائشة تقول: " يحرم من الرضاعة ما يحرم من الولادة " (¬4).(@)(@@) [ب 2166، د 2294، ع 2248، ف 2392، 2393، م 2252] تحفة 16869.(@)(@@) 2271 
ms474	 - (3) أخبرنا صدقة بن الفضل، ثنا يحيى بن سعيد، عن مالك، حدثني عبد الله بن دينار، عن سليمان بن يسار، عن عروة، عن عائشة، عن النبي - صلى الله عليه وسلم - قال: «تحرم الرضاعة ما تحرم الولادة» (¬5).(@)(@@) [ب 2167، د 2295، ع 2249، ف 2394، م 2253] تحفة 16344.(@)(@@) 2272 - (4) قال مالك: وحدثني عبد الله بن أبي بكر، عن عمرة، عن عائشة، عن النبي - صلى الله عليه وسلم -: مثله (¬6).(@)(@@) [ب 2167، د 2296، ع 2250، ف 2395، م 2254] تحفة 17900.(@)(@)PageV02P731(@)(@)(@@)(@@)(@@) || AUTO 757 - باب كم رضعة تحرم؟(@)(@)(@@) 2273 - (1) أخبرنا عبد الله بن صالح، حدثني الليث، حدثني يونس، عن ابن شهاب، عن عروة، عن عائشة، عن النبي - صلى الله عليه وسلم - قال: «لا تحرم المصة والمصتان» (¬1).(@)(@@) [ب 2168، د 2297، ع 2251، ف 2396، م 2255] تحفة 17232.(@)(@@) 2274 - (2) أخبرنا سليمان بن حرب، ثنا حماد بن زيد، عن أيوب، عن أبي الخليل، عن عبد الله بن الحارث، عن أم الفضل: " أن رجلا أتى النبي - صلى الله عليه وسلم - فقال: يا رسول الله، إني قد تزوجت امرأة وعندي أخرى، فزعمت الأولى أنها أرضعت الحدثى " (¬2)، فقال: «لا تحرم الإملاجة (¬3) ولا الإملاجتان» (¬4).(@)(@@) [ب 2169، د 2298، ع 2252، ف 2397، م 2256] تحفة 18051.(@)(@@) 2275 - (3) أخبرنا إسحاق، أنا روح، ثنا مالك، عن عبد الله بن أبي بكر، عن عمرة، عن عائشة قالت: نزل القرآن بعشر رضعات معلومات يحرمن، ثم نسخن بخمس معلومات، فتوفي رسول الله - صلى الله عليه وسلم - وهن مما يقرأ من القرآن (¬5).(@)(@@) [ب 2170، د 2299، ع 2253، ف 2398، م 2257] تحفة 17897.(@)(@)PageV02P732(@)(@)(@@)(@@)(@@) || AUTO 758 - باب ما يذهب مذمة الرضاع(@)(@)(@@) 2276 - (1) أخبرنا عثمان بن محمد، ثنا عبدة، عن هشام*، عن أبيه، عن حجاج بن حجاج الأسلمي، عن أبيه أنه قال: " يا رسول الله، ما يذهب عني* مذمة (¬1) الرضاع؟ "، قال: «الغرة: العبد أو الأمة» (¬2).(@)(@@) [ب 2171، د 2300، ع 2254، ف 2399، م 2258] تحفة 3295 إتحاف 4139.(@)(@)(@@)(@@)(@@) || AUTO 759 - باب شهادة المرأة الواحدة على الرضاع(@)(@)(@@) 2277 - (1) أخبرنا أبو عاصم، عن ابن جريج، عن ابن أبي مليكة قال: حدثني عقبة بن الحارث، ثم قال: " لم يحدثنيه ولكن سمعته يحدث القوم قال: تزوجت بنت أبي إهاب فجاءت أمة سوداء فقالت: إني 
ms475	 أرضعتكما، فأتيت النبي - صلى الله عليه وسلم - فذكرت ذلك له فأعرض عني ".(@)(@@) قال أبو عاصم: قال في الثالثة، أو الرابعة قال: «كيف وقد قيل؟ » ولم يقل: نهاه عنها.(@)(@@) قال أبو عاصم: وقال عمر بن سعيد بن أبي حسين، عن ابن أبي مليكة: «فكيف وقد قيل؟ » (¬3) ولم يقل نهاه عنها.(@)(@@) قال أبو محمد: كذا عندنا.(@)(@@) [ب 2172، د 2301، ع 2255، ف 2400، 2401، م 2259] تحفة 9905 إتحاف 13850.(@)(@)PageV02P733(@)(@)(@@)(@@)(@@) || AUTO 760 - باب في رضاعة الكبير(@)(@)(@@) 2278 - (1) أخبرنا أبو الوليد الطيالسي، ثنا شعبة، عن أشعث بن سليم، عن أبيه، عن مسروق، عن عائشة: " أن رسول الله - صلى الله عليه وسلم - دخل عليها وعندها رجل فتغير وجهه، وكأنه كره ذلك، فقالت: إنه أخي فقال: «انظرن من إخوانكن؟ فإنما الرضاعة من المجاعة» (¬1).(@)(@@) [ب 2173، د 2302، ع 2256، ف 2402، م 2260] تحفة 17658.(@)(@@) 2279 - (1) أخبرنا أبو اليمان: الحكم بن نافع، أنا شعيب، عن الزهري، عن عروة، عن عائشة قالت: " جاءت سهلة بنت سهيل بن عمرو - وكانت تحت أبي حذيفة بن عتبة بن ربيعة - رسول الله - صلى الله عليه وسلم - فقالت: إن سالما مولى أبي حذيفة يدخل علينا وأنا فضل (¬2)، وإنما نراه ولدا، وكان أبو حذيفة تبناه كما تبنى النبي - صلى الله عليه وسلم - زيدا، فأنزل الله تعالى: {ادعوهم لآبائهم هو أقسط عند الله} (¬3) فأمرها النبي - صلى الله عليه وسلم - عند ذلك أن ترضع سالما " (¬4).(@)(@@) قال أبو محمد: هذا لسالم خاصة (¬5).(@)(@@) [ب 2174، د 2303، ع 2257، ف 2403، م 2261] تحفة 16467.(@)(@)PageV02P734(@)(@)(@@)(@@)(@@) || AUTO 761 - باب في النهي عن التحليل(@)(@)(@@) 2280 - (1) أخبرنا* أبو نعيم، ثنا سفيان، عن أبي قيس، عن الهزيل، عن عبد الله قال: لعن رسول الله - صلى الله عليه وسلم - المحل والمحلل له (¬1).(@)(@@) [ب 2175، د 2304، ع 2258، ف 2404، م 2262] تحفة 9595 إتحاف 13285.(@)(@)(@@)(@@)(@@) || AUTO 762 - باب في وجوب نفقة الرجل على أهله(@)(@)(@@) *(@)(@@) 2281 - (1) أخبرنا جعفر بن عون، أنا هشام بن عروة، عن أبيه، عن عائشة: " أن هند: أم معاوية امرأة أبي سفيان، أتت النبي - صلى الله عليه وسلم - فقالت: يا رسول الله، إن أبا سفيان رجل شحيح، وإنه لا يعطيني ما يكفيني 
ms476	 وبني، إلا ما أخذت منه وهو لا يعلم، فهل على في ذلك جناح؟ "، فقال:(@)(@@) «خذي ما يكفيك وولدك بالمعروف» (¬2).(@)(@@) [ب 2176، د 2305، ع 2259، ف 2405، م 2263] تحفة 16960.(@)(@)(@@)(@@)(@@) || AUTO 763 - باب في حسن معاشرة النساء(@)(@)(@@) 2282 - (1) أخبرنا محمد بن يوسف، ثنا سفيان، عن هشام بن عروة، عن أبيه، عن عائشة قالت: قال رسول الله - صلى الله عليه وسلم -: «خيركم خيركم لأهله، وإذا مات صاحبكم فدعوه» (¬3).(@)(@@) [ب 2177، د 2306، ع 2260، ف 2406، م 2264] تحفة 16919.(@)(@)PageV02P735(@)(@)(@@)(@@)(@@) || AUTO 764 - باب في تزويج الصغار إذا زوجهن آباؤهن(@)(@)(@@) 2283 - (1) أخبرنا إسماعيل بن خليل، أنا علي بن مسهر، عن هشام، عن أبيه، عن عائشة قالت: تزوجني رسول الله - صلى الله عليه وسلم - وأنا بنت ست سنين، فقدمنا المدينة فنزلنا في بني الحارث بن الخزرج، فوعكت فتمزق رأسي فأوفي جميمة (¬1)، فأتتني أم رومان وإني لفي أرجوحة، ومعي صواحبات لي، فصرخت بي فأتيتها وما أدري ما تريد، فأخذت بيدي حتى أوقفتني على باب الدار، وإني لأنهج حتى سكن بعض نفسي، ثم أخذت شيئا من ماء فمسحت به وجهي ورأسي ثم أدخلتني الدار، فإذا نسوة من الأنصار في البيت فقلن: على الخير والبركة، وعلى خير طائر، فأسلمتني إليهن فأصلحن من شأني، فلم يرعني إلا رسول الله - صلى الله عليه وسلم - ضحى، فأسلمتني إليه وأنا يومئذ ابنة* تسع سنين (¬2).(@)(@@) [ب 2178، د 2307، ع 2261، ف 2407، م 2265] تحفة 17106.(@)(@)(@@)(@@)(@@) || AUTO 765 - باب السنة في الطلاق(@)(@)(@@) 2284 - (1) أخبرنا خالد بن مخلد، ثنا مالك، عن نافع، عن ابن عمر: " أنه طلق امرأته وهي حائض، فذكر ذلك عمر للنبي - صلى الله عليه وسلم - " فقال: «مره أن يراجعها، ويمسكها حتى تطهر، ثم تحيض، ثم تطهر، ثم إن* شاء أمسك، وإن شاء طلق، قبل أن يمس، فتلك العدة التى أمر الله أن يطلق لها النساء» (¬3).(@)(@@) [ب 2179، د 2308، ع 2262، ف 2408، م 2266] تحفة 8336، إتحاف 11212.(@)(@)PageV02P736(@)(@)(@@) 2285 - (2) أخبرنا عبيد الله بن موسى، أنا سفيان، عن محمد بن عبد الرحمن قال: " سمعت سالما، يذكر عن ابن عمر، أن عمر قال للنبي - صلى الله عليه وسلم - حين طلق ابن عمر امرأته 
ms477	 "، فقال: «مره فليراجعها، ثم ليطلقها وهى طاهرة» (¬1).(@)(@@) قال أبو محمد: رواه ابن المبارك، ووكيع: «أو حامل» (¬2).(@)(@@) [ب 2180، د 2309، ع 2263، ف 2409، 2410، م 2267] تحفة 6797 إتحاف 9555.(@)(@)(@@)(@@)(@@) || AUTO 766 - باب في الرجعة(@)(@)(@@) 2286 - (1) أخبرنا إسماعيل بن خليل، وإسماعيل بن أبان قالا: ثنا يحيى بن أبي زائدة، عن صالح بن صالح، عن سلمة بن كهيل، عن سعيد بن جبير، عن ابن عباس، عن عمر قال: " طلق رسول الله - صلى الله عليه وسلم - حفصة ثم راجعها " (¬3).(@)(@@) [ب 2181، د 2310، ع 2264، ف 2411، م 2268] تحفة 10493 إتحاف 15487.(@)(@@) 2287 - (2) أخبرنا سعيد بن سليمان، عن هشيم، عن حميد، عن أنس: " أن النبي - صلى الله عليه وسلم - طلق حفصة ثم راجعها " (¬4).(@)(@@) قال أبو محمد: كان علي بن المديني أنكر هذا الحديث، وقال: ليس عندنا هذا الحديث بالبصرة عن حميد.(@)(@@) [ب 2182، د 2311، ع 2265، ف 2412، م 2269] إتحاف 997.(@)(@)(@@)(@@)(@@) || AUTO 767 - باب لا طلاق قبل نكاح(@)(@)(@@) 2288 - (1) أخبرنا الحكم بن موسى، ثنا يحيى بن حمزة، عن سليمان بن داود، حدثني الزهري، عن أبي بكر بن محمد بن عمرو بن حزم، عن أبيه، عن جده.(@)(@)PageV02P737(@)(@)(@@) قال الحكم: قال لي يحيى بن حمزة: أفصل (¬1) أن رسول الله - صلى الله عليه وسلم - كتب إلى أهل اليمن*: «أن لا يمس القرآن إلا طاهر، ولا طلاق قبل إملاك، ولا عتاق حتى يبتاع» (¬2).(@)(@@) قيل لأبي محمد: من سليمان؟ ، قال: أحسبه كاتبا من كتاب عمر بن عبد العزيز.(@)(@@) [ب 2183، د 2312، ع 2266، ف 2413، م 2270].(@)(@)(@@)(@@)(@@) || AUTO 768 - باب ما يحل المرأة لزوجها الذي طلقها فبت طلاقها(@)(@)(@@) 2288 - (1) أخبرنا محمد بن يوسف، ثنا ابن عيينة، عن الزهري قال: سمعت عروة بن الزبير، عن عائشة قالت: " جاءت امرأة رفاعة القرظي إلى رسول الله - صلى الله عليه وسلم - وعنده أبو بكر، وخالد بن سعيد بن العاص على الباب ينتظر أن يؤذن له على رسول الله - صلى الله عليه وسلم -، فقالت: يا رسول الله، إني كنت عند رفاعة فطلقني فبت طلاقي، قال: «أتريدين أن*ترجعي إلى رفاعة؟ ، لا حتى يذوق عسيلتك وتذوقي عسيلته» (¬3) فنادى خالد بن سعيد أبا بكر: 
ms478	 ألا ترى ما تجهر به هذه عند رسول الله - صلى الله عليه وسلم -؟ ".(@)(@@) [ب 2184، د 2313، ع 2267، ف 2414، م 2271] تحفة 16436.(@)(@@) 2290 - (2) أخبرنا فروة بن أبي المغراء، ثنا علي بن مسهر، عن هشام بن عروة، عن أبيه، عن عائشة قالت: " طلق رفاعة - رجل من بني قريظة - امرأته فتزوجها عبد الرحمن بن الزبير (¬4)، فدخلت على رسول الله - صلى الله عليه وسلم - فقالت: يا رسول الله، والله إن معه إلا مثل هدبتي هذه "،(@)(@)PageV02P738(@)(@)(@@)(@@)(@@) || CHECK 770 - باب النهي عن أن تسأل المرأة زوجها طلاقها(@)(@)(@@) فقال لها رسول الله - صلى الله عليه وسلم -: «لعلك تريدين أن ترجعي إلى رفاعة؟ ، لا، حتى يذوق عسيلتك - أو قال: تذوقي عسيلته » (¬1).(@)(@@) [ب 2185، د 2314، ع 2268، ف 2415، م 2272] تحفة 16436.(@)(@)(@@)(@@)(@@) || AUTO 769 - باب في الخيار(@)(@)(@@) 2291 - (1) أخبرنا يعلى، ثنا إسماعيل بن أبي خالد، عن الشعبي، عن مسروق قال: سألت عائشة، عن الخيرة فقالت: " قد خيرنا رسول الله - صلى الله عليه وسلم - أفكان طلاقا؟ " (¬2).(@)(@@) [ب 2186، د 2315، ع 2269، ف 2416، م 2273] تحفة 17614.(@)(@)(@@) 770 - باب النهي عن أن تسأل المرأة زوجها* طلاقها(@)(@@) 2292 - (1) أخبرنا محمد بن الفضل، ثنا حماد بن زيد، عن أيوب، عن أبي قلابة، عن أبي أسماء، عن ثوبان قال: قال رسول الله - صلى الله عليه وسلم -: «أيما امرأة سألت زوجها الطلاق من غير ما بأس، فحرام عليها رائحة الجنة» (¬3).(@)(@@) [ب 2187، د 2316، ع 2270، ف 2417، م 2274] تحفة 2103 إتحاف 2500.(@)(@)(@@)(@@)(@@) || AUTO 771 - باب في الخلع(@)(@)(@@) 2293 - (1) أخبرنا يزيد بن هارون، أنا يحيى بن سعيد، أن عمرة أخبرته: " أن حبيبة بنت سهل، تزوجها ثابت بن قيس بن شماس، فذكرت أن رسول الله - صلى الله عليه وسلم - كان هم أن يتزوجها، وكانت جارة له، وأن ثابتا ضربها فأصبحت على باب رسول الله - صلى الله عليه وسلم - في الغلس، وأن رسول الله - صلى الله عليه وسلم - خرج فرأى إنسانا فقال: «من هذا؟ » قالت: أنا حبيبة بنت سهل، فقال: «ما شأنك؟ » قالت: لا PageV02P739(@)(@@) أنا ولا ثابت، فأتى ثابت إلى رسول الله - صلى الله عليه وسلم -، فقال له رسول الله - صلى الله 
ms479	 عليه وسلم -: «خذ منها وخل سبيلها» فقالت: يا رسول الله، عندي كل شيء أعطانيه، فأخذ منها وقعدت عند أهلها " (¬1).(@)(@@) [ب 2188، د 2317، ع 2271، ف 2418، م 2275] تحفة 15792.(@)(@)(@@)(@@)(@@) || AUTO 772 - باب في طلاق البتة(@)(@)(@@) 2294 - (1) حدثنا سليمان* بن حرب، ثنا جرير بن حازم، عن الزبير بن (¬2) سعيد - رجل من بني عبد المطلب - قال: " بلغني حديث عن عبد الله بن علي بن يزيد بن ركانة، وهو في قرية له فأتيته، فسألته فقال: حدثني أبي، عن جدي: أنه طلق امرأته البتة فأتى النبي - صلى الله عليه وسلم - فذكر ذلك له، فقال: «ما أردت؟ » فقال: واحدة، قال: «آلله؟ » قال: آلله "، قال: «هو ما نويت» (¬3).(@)(@@) [ب 2189، د 2318، ع 2272، ف 2419، م 2276] تحفة 3613 إتحاف 4597.(@)(@)(@@)(@@)(@@) || AUTO 773 - باب في الظهار(@)(@)(@@) 2295 - (1) أخبرنا زكريا بن عدي، ثنا عبد الله بن إدريس، عن محمد بن إسحاق، عن محمد بن عمرو، وعن سليمان* بن يسار، عن سلمة بن صخر البياضي قال: " كنت امرأ أصيب من النساء ما لا يصيب غيري، فلما دخل شهر رمضان خفت أن أصيب في ليلي شيئا فيتتابع بي ذلك إلى أن أصبح - قال - فتظاهرت إلى أن ينسلخ، فبينا هي ليلة تخدمني إذ تكشف لي منها شيء، فما لبثت أن نزوت عليها، فلما أصبحت خرجت إلى قومي فأخبرتهم وقلت: امشوا معي إلى رسول الله - صلى الله عليه وسلم -، فقالوا: لا والله لا نمشي - صلى الله عليه وسلم - معك ما نأمن أن ينزل فيك القرآن أو أن يكون فيك من رسول الله - صلى الله عليه وسلم - مقالة يلزمنا عارها، ولنسلمنك بجريرتك، فانطلقت إلى رسول الله - صلى الله عليه وسلم - فقصصت عليه قصتي، فقال: «يا سلمة أنت بذاك؟ » قلت: أنا بذاك، قال: «يا سلمة أنت(@)(@)PageV02P740(@)(@)(@@)(@@)(@@) || CHECK 774 - باب في المطلقة ثلاثا ألها السكنى والنفقة أم لا؟(@)(@)(@@) بذاك؟ » قلت: أنا بذاك، قال: «يا سلمة أنت بذاك؟ » قلت: أنا بذاك، وها أنا ذا صابر نفسي، فاحكم في ما أراك الله، قال: «فأعتق رقبة» قال: فضربت صفحة رقبتي فقلت: والذي بعثك بالحق ما أصبحت 
ms480	 أملك رقبة غيرها، قال: «فصم شهرين متتابعين» قلت: وهل أصابني الذى أصابني إلا في الصيام؟ قال: «فأطعم وسقا من تمر ستين مسكينا» فقلت: والذي بعثك بالحق لقد بتنا ليلتنا وحشى ما لنا طعام، قال: «فانطلق إلى صاحب صدقة بني زريق فليدفعها إليك، وأطعم ستين مسكينا وسقا من تمر، وكل بقيته أنت وعيالك» قال: فأتيت قومي* فقلت: وجدت عندكم الضيق وسوء الرأي ووجدت عند رسول الله - صلى الله عليه وسلم - السعة وحسن الرأي، وقد أمر لي بصدقتكم " (¬1).(@)(@@) [ب 2190، د 2319، ع 2273، ف 2420، م 2277] تحفة 4555 إتحاف 9029(@)(@)(@@) 774 - باب في المطلقة* ثلاثا ألها السكنى والنفقة أم لا؟(@)(@@) 2296 - (1) أخبرنا محمد بن يوسف، ثنا سفيان، عن سلمة بن كهيل، عن الشعبي، عن فاطمة بنت قيس: " أن زوجها طلقها ثلاثا (¬2)، فلم يجعل لها النبي - صلى الله عليه وسلم - نفقة ولا سكنى، قال سلمة: فذكرت ذلك لإبراهيم فقال: قال عمر بن الخطاب: لا ندع كتاب ربنا وسنة نبيه بقول امرأة، فجعل لها السكنى والنفقة " (¬3).(@)(@@) [ب 2191، د 2320، ع 2274، ف 2421، 2422، م 2278] تحفة 18025، 10383.(@)(@)PageV02P741(@)(@)(@@) 2297 - (2) أخبرنا يعلى (¬1)، ثنا زكريا، عن عامر قال: حدثتني فاطمة بنت قيس: " أن زوجها طلقها ثلاثا، فأمرها النبي - صلى الله عليه وسلم - أن تعتد عند ابن عمها ابن أم مكتوم " (¬2).(@)(@@) [ب 2192، د 2321، ع 2275، ف 2423، م 2279] تحفة 18025.(@)(@@) 2298 - (3) أخبرنا محمد بن العلاء، ثنا حفص بن غياث، عن الأشعث، عن الحكم وحماد، عن إبراهيم، عن الأسود، عن عمر قال: " لا ندع كتاب ربنا وسنة نبيه بقول امرأة، المطلقة ثلاثا لها السكنى والنفقة " (¬3).(@)(@@) [ب 2193، د 2322، ع 2276، ف 2424، م 2280] تحفة 10405 إتحاف 15165.(@)(@@) 2299 - (4) أخبرنا طلق بن غنام، عن حفص بن غياث، عن الأعمش، عن إبراهيم، عن الأسود، عن عمر نحوه (¬4).(@)(@@) [ب 2193، د 2323، ع 2277، ف 2425، م 2281] تحفة 10405 إتحاف 15165.(@)(@@) 2300 - (5) أخبرنا عبد الله بن محمد، ثنا حفص، عن الأعمش، عن إبراهيم، عن الأسود قال:(@)(@@) قال عمر] (¬5): " لا نجيز قول امرأة في دين الله، المطلقة ثلاثا لها السكنى والنفقة " (¬6).(@)(@@) قال أبو محمد: " لا أرى السكنى والنفقة للمطلقة " (¬7).(@)(@@) [ب 2194، د 2324، ع 2278، ف 