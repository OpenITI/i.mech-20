ms889	 يتقي % % فكذاك أيضا يتقي التجهيلا % % 154(@)(@@) % بل أعجلوك عن المراس كأنهم % % عنف من السيل استخف حميلا % % 155(@)(@@) % لافل حدك من حسام صارم % ترك القراع بحده تفليلا % % 156(@)(@@) % لو حكت في السيف الذي كافحته % ماحاك فيك لأسرع التهليلا % % 157(@)(@@) % لو مسه الألم الذي أحذاكه % % أو دون ذاك لما استفاق صليلا % % 158(@)(@@) % أو فل فيه حر وجهك فلة % في حر وجهك ريع منه وهيلا % % 159(@)(@@) % لله نفس يوم ذاك أذلتها % % ولرب شيء صين حين أذيلا % % 160(@)(@@) % لوقفتها نصب الكريهة موقفا % ماكان تعذيرا ولاتحليلا % % PageV01P3518 161(@)(@@) % لاجاهلا قدر الحياة مغمرا % بل عارفا قدر الحياة بسيلا % % 162(@)(@@) % مثل الهزبر المستميت إذا ارتدى % % أشباله من خلفه والغيلا % % 163(@)(@@) % والحرب تغلى بالكماة قدورها % % والموت يأكل ماطهته نشيلا % % 164(@)(@@) % تخذوا الحديد مغافرا وأشلة % وتخذت صبرك مغفرا وشليلا % % 165(@)(@@) % نفس طلبت بها العلا فبلغتها % % وركبت منها كاهلا وتليلا % % 166(@)(@@) % وإذا أذلت النفس في طلب العلا % % فلتلفين لما ملكت مذيلا % % 167(@)(@@) % أتراك بعد النفس تبخل باللهى % % الله جارك أن تكون بخيلا % % 168(@)(@@) % ما كنت تمضي باللقاء مصمما % فتكون في شيء س واه كليلا % % 169(@)(@@) % من جاد بالحوباء جاد بماله % فالمال أيسر هالك تعجيلا % % 170(@)(@@) % ونظرت مابخل امرىء وسماحه % والرأي يوجد أهله التأويلا % % PageV01P3519 171(@)(@@) % فالبخل جبن والسماح شجاعة % لاشك حين تصحح التحصيلا مص مااستشرفت منك العيون ضئيلا % % 172(@)(@@) % لكن عظيما في الصدور جليلا % % أقبلت في خلع الولاية طالعا % 173(@)(@@) % والناس حولك يوفضون قبيلا % % فكأنك البدر المنير مكللا % 174(@)(@@) % من طالعات سعوده إكليلا % % كم من غليل يوم ذلك هجته % 175(@)(@@) % لازلت في صدر الحسود غليلا % % من كان حمله لبوس ولا ية % 176(@)(@@) % وأعازه التعظيم والتبجيلا % % فبذات نفسك مايكون جمالها % % 177(@)(@@) % وبمائه كان الحسام صقيلا % % تبا لمن تعمي بصيرة رأيه % 178(@)(@@) % حتى يراك بما سواك نبيلا % % إني لأكبر أن أراك مهنأ % 179(@)(@@) % إلا بما يتجاوز التأميلا % % لأحق منك بأن يهنأ معشر % 180(@)(@@) % رزقوك حظا في الحظوظ جزيلا % % أنصفتهم وأقمت عدلك فيهم % PageV01P3520 181(@)(@@) % ميزان قسط لا يميل مميلا % % فهدت عيونهم وأفرخ روعهم % % 182(@)(@@) % وأقام 
ms890	 منهم من أراد رحيلا % % من بعد ماسأل الحميم حميمه % 183(@)(@@) % مابال دفك بالفراش مذيلا % % لايعدموك فقد نصحت إمامهم % % 184(@)(@@) % ووضعت إصرهم وكان ثقيلا % % أرفقتهم في خرجهم ووفرتهم % % 185(@)(@@) % وكذا المدر يقدم التحفيلا % % فتنافسوا بك في العمارة بعدما % % 186(@)(@@) % طال العداء فعطلت تعطيلا % % فقضاك ريع العدل ماأعطيتهم % % 187(@)(@@) % أوفى قضاء واصطنعت جميلا % % والعدل مغزرة لكل حلوبة % 188(@)(@@) % والجور يعقب رسلها تشويلا % % لم لاتكون لدى إمامك مرتضى % 189(@)(@@) % لاينبغي بك في الكفاة بديلا % % وإذا وليت فليس يعدم قائلا % 190(@)(@@) % ماكان رأي إمامنا ليفيلا % % تجبي له مال البلاد وحمدها % % PageV01P3521 191(@)(@@) % إذ لاتضيع من الحقوق فتيلا % % قال الإمام وقد جمعتهما له % % 192(@)(@@) % حظان مثلهما بمثلك نيلا % % أنت الذي يمري اللقاح برفقه % 193(@)(@@) % ملء الوطاب ولا يجيع فصيلا % % أسمعته شكر الرعية بعدما % % 194(@)(@@) % جار الولاة فأسمعوه عويلا % % كسبت له التجوير قبلك عصبة % 195(@)(@@) % فكسبت بعدهم له التعديلا % % ولقد قطعت إليه كل حبالة % % 196(@)(@@) % لايستطيع لها الدهاة حويلا % % ولقد ركبت إليه كل مخوفة % 197(@)(@@) % لو زل راكبها لطاح قتيلا % % ووهبت نفسك للمتالف دونه % 198(@)(@@) % ورأيت ذلك في الإمام قليلا % % شهد الخليفة والرعية أنه % % 199(@)(@@) % ماكان جولكم عند ذلك مهيلا % % شهد الخليفة والرعية أنه % % 200(@)(@@) % ماكان رأيك عند ذاك سحيلا % % أنت الذي قطع الحبائل بعدما % % PageV01P3522 201(@)(@@) % أزمت أزام وعضلت تعضيلا % % فنجوت من أيدي الأخابث سالما % 202(@)(@@) % ورهنتهم لهفا عليك طويلا % % ولئن نجوت لقد ركبت عزيمة % 203(@)(@@) % حذاء تسبق داعرا وجديلا % % وأجلت رأيا أحوذيا مثله % 204(@)(@@) % فيما ينوب من الخطوب أجيلا % % ولقل ماينجو امرؤ من مثلها % % 205(@)(@@) % بالرأي إلا أن يكون أصيلا % % دبرت تدبير المدبر إنه % % 206(@)(@@) % ماكان عند مضلة ضليلا % % بل كنت للملك السعيد وديعة % 207(@)(@@) % أمر الإله بحفظها جبريلا % % بل ذا وذاك وإن وهبت لأمة % 208(@)(@@) % تعفو فضولكوأصيلا % % ولقد بلاك الطالبون فثبطوا % % 209(@)(@@) % أن يدركوك وخذلوا تخذيلا % % ورأوا مكانك ريثما أخليته % 210(@)(@@) % كمكان بعض الراسيات أزيلا % % فسروا على حرد إليك وأعملوا % % PageV01P3523 211(@)(@@) % طلبا يحث به الرعيل رعيلا % % فسترت دونهم بستر كثافة % 212(@)(@@) % حتى خفيت وما خفيت 
ms891	 ضئيلا % % فثنوا أعنة راجعين بخيبة % 213(@)(@@) % كرجوعهم أيام ساقوا الفيلا % % ولعلهم لو أدركوك لأرسلت % 214(@)(@@) % طير العذاب عليهم السجيلا % % ولما خفيت بأن وجهك لم يكن % % 215(@)(@@) % في كل ليل دامس قنديلا % % لكن بأن خالوا بدرا باهرا % 216(@)(@@) % وإذا أخال شبيه شيء خيلا % % ماقدر ليل أن تكون لبسته % 217(@)(@@) % فاختين نورك تحته واغتيلا % % أنى تجلك الدجى بأبدرها % % 218(@)(@@) % لن تستطيع لك الدجى تجليلا % % ولما خفيت بأن نشرك لم ينل % 219(@)(@@) % أقصى مدى نشر ونيف ميلا % % لكن بأن حسبوه ريا روضة % 220(@)(@@) % هبت لها ريح الشمال بليلا % % والله ثبطهم بذاك فكذبوا % % PageV01P3524 221(@)(@@) % فيك اليقين وصدقوا التخبيلا % % كم ليلة نسي الصباح مساؤها % % 222(@)(@@) % قد بت فيها بالسهاد كحيلا % % مانمت نوم غريرة في خدرها % % 223(@)(@@) % لكن سريت سرى الرجال رجيلا % % ولعمر جمع الزنج يوم لقيتهم % % 224(@)(@@) % ماصادفوك يراعة إجفيلا % % شهدت بذلك في جبينك ضربة % 225(@)(@@) % كانت على صدق اللقاء دليلا % % تركت بوجهك للحفيظة ميسما % 226(@)(@@) % مارجعت ورق الحمام هديلا % % من بعد ما غادرتهم وكأنما % % 227(@)(@@) % قعرت بهم عصف الرياح نخيلا % % مازلت تنكؤهم بحد شائك % 228(@)(@@) % لم تألهم قرحا ولاتقتيلا % % تقريهم طعنا أبج وتارة % 229(@)(@@) % ضربا يزيل بينهم تزييلا % % حتى إذا ألب الجميع وأللوا % % 230(@)(@@) % تلقاء نحرك حدهم تأليلا % % أسروك إذ كثروك لالعزيمة % PageV01P3525 231(@)(@@) % فشلت عليك ولالصبر عيلا % % لكن رموك بدهمهم وكأنهم % % 232(@)(@@) % جيش أجاب دعاء إسرافيلا % % فانقدت طوع الحزم لامستقتلا % 233(@)(@@) % خرقا ولاسلس القياد ذليلا % % ورأيت أن تبقى لهم فتكيدهم % % 234(@)(@@) % أجدى ومثلك أحسن التمييلا % % وقتال من لاتستطيع قتاله % 235(@)(@@) % في الناس يكسب رأيك التفييلا % % ومن اتقى التحيين فيما يتقي % % 236(@)(@@) % فكذاك أيضا يتقي التجهيلا % % بل أعجلوك عن المراس كأنهم % % 237(@)(@@) % عنف من السيل استخف حميلا % % لافل حدك من حسام صارم % 238(@)(@@) % ترك القراع بحده تفليلا % % لو حكت في السيف الذي كافحته % 239(@)(@@) % ماحاك فيك لأسرع التهليلا % % لو مسه الألم الذي أحذاكه % % 240(@)(@@) % أو دون ذاك لما استفاق صليلا % % أو فل فيه حر وجهك فلة % PageV01P3526 241(@)(@@) % في حر وجهك ريع منه وهيلا % % لله نفس 
ms892	 يوم ذاك أذلتها % % 242(@)(@@) % ولرب شيء صين حين أذيلا % % لوقفتها نصب الكريهة موقفا % 243(@)(@@) % ماكان تعذيرا ولاتحليلا % % لاجاهلا قدر الحياة مغمرا % 244(@)(@@) % بل عارفا قدر الحياة بسيلا % % مثل الهزبر المستميت إذا ارتدى % % 245(@)(@@) % أشباله من خلفه والغيلا % % والحرب تغلى بالكماة قدورها % % 246(@)(@@) % والموت يأكل ماطهته نشيلا % % تخذوا الحديد مغافرا وأشلة % 247(@)(@@) % وتخذت صبرك مغفرا وشليلا % % نفس طلبت بها العلا فبلغتها % % 248(@)(@@) % وركبت منها كاهلا وتليلا % % وإذا أذلت النفس في طلب العلا % % 249(@)(@@) % فلتلفين لما ملكت مذيلا % % أتراك بعد النفس تبخل باللهى % % 250(@)(@@) % الله جارك أن تكون بخيلا % % ما كنت تمضي باللقاء مصمما % PageV01P3527 251(@)(@@) % فتكون في شيء س واه كليلا % % من جاد بالحوباء جاد بماله % 252(@)(@@) % فالمال أيسر هالك تعجيلا % % ونظرت مابخل امرىء وسماحه % 253(@)(@@) % والرأي يوجد أهله التأويلا % % فالبخل جبن والسماح شجاعة % 254(@)(@@) % لاشك حين تصحح التحصيلاه % % جبن البخيل من الزمان وصرفه % 255(@)(@@) % فتهيب الإفضال والتنويلا % % واستشعرت نفس الجواد شجاعة % 256(@)(@@) % فرجا الزمان على الزمان مديلا % % وإذا امرؤ منح الشجاعة لم يجد % 257(@)(@@) % عنه السماح لرحله تحويلا % % ولقل ماجاد امرؤ ليست له % % 258(@)(@@) % نفس ترى حد الزمان فليلا % % ليشمر الغادي إليك ذيوله % % 259(@)(@@) % كيما يروح مرفلا ترفيلا % % فلرب تشمير إليك رأيته % 260(@)(@@) % بالأمس أعقب أهله تذييلا % % جعل البخيل لما يفيد قرارة % PageV01P3528 261(@)(@@) % لكن جعلت لما تفيد مسيلا % % صرفت يداك إلى المكارم والعلا % % 262(@)(@@) % عن مالك التثمير والتأثيلا % % شذبت في دار الفناء أثيله % 263(@)(@@) % ليكون في دار البقاء أثيلا % % ماسولت نفس لصاحبها الغنى % % 264(@)(@@) % إلا انبريت تصدق التسويلا % % تعد المنى عنك الغنى فتفي به % % 265(@)(@@) % وتقيم جودك بالوفاء كفيلا % % وتفي بما يعد الكذوب كأنما % % 266(@)(@@) % كفلت ذلك دونه تكفيلا % % ولو استطعت إذا وفيت بوعده % 267(@)(@@) % نفلته حسن الثنا تنفيلا % % ولرب مرجو سواك مؤمل % 268(@)(@@) % ألفاه راجيه عليك محيلا % % فقبلت منه حوالة مكروهة % 269(@)(@@) % ورأيتها حظا إليك أميلا % % ونقدت صاحبها الثواب معجلا % 270(@)(@@) % إذا ما سألت بنقده تأجيلا % % يفديك من تفدي بمالك عرضه % PageV01P3529 271(@)(@@) % وتذود عنه الذم والتبخيلا % % لولاك أصبح عرض كل 
ms893	 مبخل % 272(@)(@@) % شلوا يمزقه الهجاء أكيلا % % الناس أدهم أنت فيه غرة % 273(@)(@@) % جعل الأفاضل تحتها تحجيلا % % لو كنت في عصر النبي محمد % 274(@)(@@) % أوحى الإله بمدحك التنزيلا % % شاركت إبراهيم في اسم واحد % 275(@)(@@) % ونسخته شبها كإسماعيلا % % لم يبق إبراهيم إرث خليفة % 276(@)(@@) % إلا وقد قبلتها تقبيلا % % ولئن تقدمك الخليل بزلفة % 277(@)(@@) % لبمثل ماتسديه كان خليلا % % تقواك تقواه وبرك بره % 278(@)(@@) % لله دركما أبا وسليلا % % ولقد دعوت الله مثل دعائه % 279(@)(@@) % عند البلاء فزل عنك زليلا % % يفتن فيك المادحون وكلهم % % 280(@)(@@) % يتجنب التشبيه والتمثيلا % % فت العديل فما يقال كأنه % % PageV01P3530 281(@)(@@) % من ذا رأى لك في الأنام عديلا % % هذا أبا إسحاق موقف عائذ % 282(@)(@@) % بك من نوائب لم يدعن ثميلا % % يتواعد الأيام منك بجحفل % 283(@)(@@) % ينفي الأوابد هدة وصهيلا % % شئز المقيل بحيث عبدك ضاحيا % 284(@)(@@) % فامهد لعبدك في ذراك مقيلا % % وأفىء عليه الظل بعد زواله % % 285(@)(@@) % لازال ظلك ماحييت ظليلا % % يامن عليه عيال آدم بعده % 286(@)(@@) % أكفل أخاك وإن غدوت معيلا % % يامن تكفل للعباد برزقهم % % 287(@)(@@) % أتخالني فيمن كفلت دخيلا % % سويت بين الخلق إلا واحدا % 288(@)(@@) % قد كان يأمل عندك التفضيلا % % لاتقسم الضيزى كقسمة معشر % 289(@)(@@) % نصبوا موازين الفواضل ميلا % % صن عرض عبدك أن يذال فإنه % % 290(@)(@@) % ماكان قط لبذلة منديلا % % صن وجه عبدك عن سؤال معاشر % PageV01P3531 291(@)(@@) % ألفاهم شر البرية حيلا % % من مانع مرعى وآخر باذل % 292(@)(@@) % مرعى توخمه الكرام وبيلا % % إن من منن فاستمر مريره % 293(@)(@@) % من منة فعلت ومن قيلا % % فكأن مايسديه شهد معجب % 294(@)(@@) % فيه الذعاف مثملا تثميلا % % أصبحت أرجو منك عاجل نائل % 295(@)(@@) % مازال مرجوا لديك منيلا % % وكأنني بي شاكر لك قائل % 296(@)(@@) % لاقيت خير منفل تنفيلا % % لاقيت من لاقى الزمان تحاميا % 297(@)(@@) % عني فنكل صرفه تنكيلا % % وأقال جدي بعد طول عثاره % 298(@)(@@) % لازلت للجد العثور مقيلا % % لاقيت إبراهيم واحد عصره % % 299(@)(@@) % وكفى به من جملة تفصيلا % % لاقيت من ألوى بنحسي سعده % 300(@)(@@) % لازال سعدا للنحوس مزيلا % % قالت لحراماني سماحة كفه % PageV01P3532 301(@)(@@) % لن تستطيع لسنتي تبديلا % % صدقت 
ms894	 منى نفسي لديه عداتها % % 302(@)(@@) % ولقد عهدت عداتها تعليلا % % وارتشت ريش غنى أطار جديده % % 303(@)(@@) % مارث من حالي فطار نسيلا % % أنت الذي ماقيل حين مدحته % 304(@)(@@) % خاطبت رسما بالفلاة محيلا % % بل قيل لي لافال رأيك مادحا % 305(@)(@@) % أملت مأمولا وشمت مخيلا % % أصبحت بين خصاصة وتجمل % 306(@)(@@) % والمرء بينهما يموت هزيلا % % فامدد إلي يدا تعود بطنها % % 307(@)(@@) % بذل النوال وظهرها التقبيلا % % ووسيلتي أني قصدتك لاأرى % % 308(@)(@@) % إلا عليك لحاجتي تعويلا % % وأجبت من قال اتصل بوصيلة % 309(@)(@@) % حسبي بسؤدد من مدحت وصيلا % % مافي خلائق من مدحت نقيصة % 310(@)(@@) % أبغي لها بوسيلة تكميلا % % جعل الرشاء لمن طوالة شربه % PageV01P3533 311(@)(@@) % لا لامرىء مثلي يؤم النيلا % % ساحت موارده فليس رشاؤه % 312(@)(@@) % إلا شرائع سهلت تسهيلا % % علام تقتسم الوسائل بينهم % % 313(@)(@@) % حمدي فيذهب جله تضليلا % % لاأشرك الشركاء في حمد امرىء % % 314(@)(@@) % منه أؤمل وحده التمويلا % % أنى أخول من سواه محامدي % % 315(@)(@@) % وهو الذي أرجو به التحويلا % % وكلت مجدك باقتضائك حاجتي % % 316(@)(@@) % وكفى به متقاضيا ووكيلا % % إني رأيتك جنة عدنية % 317(@)(@@) % قد هدلت ثمراتها تهديلا % % حملت فذللت الغصون بحملها % % 318(@)(@@) % وكفت أكف جناتها التذليلا % % أحسنت فيك الظن وهي وسيلة % 319(@)(@@) % شفعت إن أحسنت فيك القيلا % % ولو التقيت وحاتما لحسبته % 320(@)(@@) % أعداه جودك أن عراك نزيلا % % فقد اكتنفت بكل أمر لاترى % % PageV01P3534 321(@)(@@) % معه إلى بخس الجزاء سبيلا % % خذها أبا إسحاق صنعة شاعر % 322(@)(@@) % صنع أطال لفكره التمهيلا % % وأطاعه حرف الروي فلم يجىء % 323(@)(@@) % فيه بمفعول يشوب فعيلا % % كثرت معاني المدح فيك فهيأت % 324(@)(@@) % للمادح التكثير والتطويلا % % فأطلت إيفاء لمجدك حقه % 325(@)(@@) % بل لست فيك وإن أطلتمطيلا % % ولما جعلتك إذ أطلت كمورد % 326(@)(@@) % قذف أمر رشاؤه فأطيلا % % ن % PageV01P3535 البحر : - 1(@)(@@) % تطول ياقريع بني فراس % فإنك من ذوي الأيدي الطوال % % 2(@)(@@) % وكل يد أطال الحظ منها % % بلا طول مقصرة المنال % 3(@)(@@) % وما يبقى على الحدثان شيء % سوى شرف من الأفعال عالي % % 4(@)(@@) % هي الدنيا تزول بساكنيها % % فأفضلها البعيد من الزوال % 5(@)(@@) % وقد مكنت من درج وثاق % فلا تجبن من الرتب 
ms895	 العوالي % % 6(@)(@@) % واعدد سحنة للحظ ليست % لعمرو إنه مني ببال % 7(@)(@@) % فإن الحظ لاشركاء فيه % % وليس بمؤنس حظ مخالي % % 8(@)(@@) % لكا لمرعى الخصيب بلا سوام % أو البلد الرحيب بلا حلال % 9(@)(@@) % فلا تأنس أبا حسن بحظ % ومعمره من الأخيار خالي % % 10(@)(@@) % ألا يوما إلى مثلي مذالا % بكم في حشوة السقط المذال % PageV01P3536 11(@)(@@) % وقد حظيت بحظكم رزايا % % يطأطىء ذكرها صيد القذال % 12(@)(@@) % كعمرو أو كأنداد لعمرو % ألا يا قوم للكفر الجلال % % 13(@)(@@) % أتشحن روضة عرضت وطالت % بأشباه النعام أو الرئال % 14(@)(@@) % دعوتك خاضعا من تحت تحت % فلا تشمخ فتدعى من معال % 15(@)(@@) % وينصرني عليك الناس نصرا % يطول به على الطاغي دلالي % % 16(@)(@@) % وقبلك مانصرت على ظلوم % وما أعملت أطراف الإلال % 17(@)(@@) % ولكني أويت من اعتصامي % % إلى عيطاء شاهقة القلال % 18(@)(@@) % وتلك أعز لي من كل رمح % وصمصام إذا دعيت نزال % 19(@)(@@) % وكم عز الذليل بلا قتال % وكم ذل العزيز مع القتال % 20(@)(@@) % حلفت برأي سيدنا المصفى % % إذا فالاه غامضة مفالي % % PageV01P3537 21(@)(@@) % ونقصي بعد رجحاني لديه % % وقد يئس الموازن من عدالي % % 22(@)(@@) % لقد أوقعت من أمرين أمرا % أتى منه فسادي أو خبالي % % 23(@)(@@) % فإما أن تكون ثللت عرشي % % وإما أن تكون أهلت جالي % % 24(@)(@@) % أتلتمس الشفاء لديك حالي % % فتمنى منك بالداء العضال % % 25(@)(@@) % مطال منك قد أضنى اصطباري % % وظلم منك قد أفنى احتيالي % % 26(@)(@@) % وكان مطال مدحي بالمساعي % % هداك الله أحسن من مطالي % % 27(@)(@@) % فماطلني الجزاء تؤل بمدحي % % من الأمد البعيد إلى مآل % % 28(@)(@@) % حلفت لقد حكمت بغير عدل % أمنت وأنت تشغلني اشتغالي % % 29(@)(@@) % لحيت لي الزمان وأنت عطل % وضافرت الزمان وأنت والي % % 30(@)(@@) % وكيف ولم أمنت عليك عتبي % % وسيلي بالأوابد وانثيالي % % PageV01P3538 31(@)(@@) % أكنت ظننت سهوي عن حقوقي % % أم استيقنت جبني وانخذالي % % 32(@)(@@) % أم استعهدت حلمي واغتفاري % % أم استكفيت حزمي في حوالي % % 33(@)(@@) % كلا الحسبين يوجب أن يضاهى % % فساجلني فإنك ذو سجال % % 34(@)(@@) % أخفت عواقب السوء فخفها % % فكل إساءة مجنى وبال % % 35(@)(@@) % أم استعليت عن إتيان سوء % فكن في ذاك فوقي أوحيالي 
ms896	 % % 36(@)(@@) % كلا الأمرين من كرم وحزم % فإنك فيه ذو عم وخال % 37(@)(@@) % وعظتك أيها الإنسان وعظي % % فلا أك واعظ الدمن الخوالي % % 38(@)(@@) % وأنت الحي كل الحي فاترك % غروب الوعي للرمم البوالي % % 39(@)(@@) % ورج تغافلي لك وانخداعي % % ولاترج اختداعي واغتفالي % % 40(@)(@@) % تواردنا ونحن على وداد % فلا نصدر ونحن على تقالي % % PageV01P3539 41(@)(@@) % فلست بمن يعلل بالهواهي % % ولست بمن يفزع بالسعالي % % 42(@)(@@) % وسعت الناس إنصافا وبرا % وإفضالا فهم لك كالعيال % 43(@)(@@) % سواي فإنني أوسعت خسفا % بلا جرم وأعجبك احتمالي % % 44(@)(@@) % على أني أعادي من تعادي % % كما أني أوالي من توالي % % 45(@)(@@) % بلى ذنبي ولست أتوب منه % % ولو أني قليت على المقالي % % 46(@)(@@) % لسان بالثناء عليك رطب % وقلب من مديحك في مجال % % 47(@)(@@) % أعد نظرات أبا حسن فإني % % أراك وهمت في أمري وحالي % % 48(@)(@@) % ولا والله ماتسوى أمور % تراها قيمتي أبدا قبالي % % 49(@)(@@) % أزور فلا أرى منك اهتشاشا % كما أني أغيب فلا تبالي % % 50(@)(@@) % وقد يؤتى هجور من سلو % كما يؤتى زؤور من ملال % PageV01P3540 51(@)(@@) % ولم أكثر فأوجب عذر قال % ولم أهجر فأوجب عذر سالي % % 52(@)(@@) % فما بال الجفاء جفاء سال % وما بال اللقاء لقاء قالي % % 53(@)(@@) % لقد أشجيتني بالظلم حتى % % جعلت تعجبني جل اشتغالي % % 54(@)(@@) % وكم أرضيت من قوم وقوم % خدودهم تسافل عن نعالي % % 55(@)(@@) % أبيت فصالهم من بعد ري % وما أرويتني وترى فصالي % % 56(@)(@@) % بخست وفضلوا حتى كأني % % حبيت بنقصهم وحبوا كمالي % % 57(@)(@@) % على أني أحاول بعض حقي % % وأيسر ماأسد به اختلالي % % 58(@)(@@) % أراك إن اعتزلتك ذات يوم % أبا حسن سيوحشك اعتزالي % % 59(@)(@@) % فكيف إن ارتحلت إلى بلاد % تباعد عنك تصبرلارتحالي % % 60(@)(@@) % أليس من الشدائد أن تراني % % على ودي وقد شدت رحالي % % PageV01P3541 61(@)(@@) % بل وكفتك وحشتنا جميعا % إذا بكرت لطيتها جمالي % % 62(@)(@@) % ولكن قد وثقت بصدق ودي % % وآمنك اختبارك من زيالي % % 63(@)(@@) % ولم لا واعتقادك في فؤادي % % مساكن مهجتي أخرى الليالي % % 64(@)(@@) % هويتك ناشئا قبل التلاقي % % هوى حدثا تكهل باكتهالي % % 65(@)(@@) % ولم يك للرواء هواي لكن % لمحمود الشمائل والخصال % 66(@)(@@) % وكل مودة 
ms897	 قبل اختيار % فتلك هوى طباع لاانتحال % % 67(@)(@@) % رأت مافيك نفسي رأي حدس % فلم يخطىء سدادي واعتدالي % % 68(@)(@@) % فلما أن لقيتك واعترفنا % % جلا عني ظلام الليل جالي % % 69(@)(@@) % وقال الرأي لي قولا فصيحا % وقعت على الهدى بعد الضلال % 70(@)(@@) % فكيف أميل بين هوى ورأي % % إلى صرم وقد شد اعتقالي % % PageV01P3542 71(@)(@@) % لقد حرسا وصالك من ملالي % % وصرمي شئت صرمي أو وصالي % % 72(@)(@@) % فلو بودلت بالدنيا جميعا % علقتك وانحرفت عن البدال % % 73(@)(@@) % ولايظلمك من قبل التلاقي % % هوى سبق اختياري وانتحالي % % 74(@)(@@) % ولاحاباك بعد الخبر رأي % رأى فضل اليمين على الشمال % 75(@)(@@) % وكم أصبحت معتلا عليه % % فجادل عنك أنواع الجدال % 76(@)(@@) % وأيسر حجة للرأي مما % % تكامل فيك يعصف باعتلالي % % 77(@)(@@) % ومثلك يا أبا حسن حقيق % بصوني عن فراقك واعتقالي % % 78(@)(@@) % لشكر محبتي قبل التلاقي % % وشكم مودتي بعد التبالي % % 79(@)(@@) % أعيذك أن يرى مثلي عدو % لديك بحال مطرح مذال % 80(@)(@@) % فيوسع رأيك المحمود ذما % ويطعن في اختيارك غير آلي % % PageV01P3543 81(@)(@@) % وهب أني عدمت الفضل طرا % سوى علمي بفضلك في الرجال % 82(@)(@@) % أما في ذاك عندك مايعفي % % عل مابعد ذلك من خلالي % % 83(@)(@@) % كفافي يا أبا حسن يسير % وشكري ذو المثاقيل الثقال % 84(@)(@@) % وكم شيء له بذر يسير % وريع مثل أطواد الجبال % 85(@)(@@) % أنا السيف المجرد في الأعادي % % أبا حسن فلا تغفل صقالي % % 86(@)(@@) % أترضى أن تقلدني حساما % وبي طبع وجفني غير حالي % % 87(@)(@@) % معاذ الله أن ترضى بهذا % % وأنت بحيث أنت من المعالي % % 88(@)(@@) % فجدد لي الصقال وحل جفني % % يكن لك يوم تلبسني جمالي % % 89(@)(@@) % وصني يوم سلمك إن صوني % % يسرك يوم حربك بابتذالي % % 90(@)(@@) % ألم تعلم هداك الله أني % % أبر على المناضل والمغالي % % PageV01P3544 91(@)(@@) % متى حققت لم أقعد بحقي % % وإن جادلت لم يخش انجدالي % % 92(@)(@@) % رويدك إنني كاسيك بردا % جديدا من قريض غير بالي % % 93(@)(@@) % تنافسه مسامع سامعيه % % ويطوى منشديه على اختيال % 94(@)(@@) % مديحا إن تثبه يكن مديحا % من الحلل المحبرة الغوالي % % 95(@)(@@) % وإن تظلمه تجعله هجاء % % أشد على الكريم من النبال % 96(@)(@@) % وليس 
ms898	 بلفظة لي فيك لكن % بما للناس من قيل وقال % 97(@)(@@) % يرون مدائحا جزيت بظلم % % فألسنهم أحد من النصال % 98(@)(@@) % وكم من ناصر لي لم أرده % يماحل ظالمي عني محالي % % 99(@)(@@) % وأعوان الضعيف أولو احتشاد % لنصرته وعنه ذو نضال % % 100(@)(@@) % وكم شعر مدحت به ظلوما % فصار هجاءه لا بافتعالي % % PageV01P3545 101(@)(@@) % ولو أني أشاء سكت عنه % % مجاهرة ودب له اغتيالي % % 102(@)(@@) % ولكن المحق له نصير % من الأيام والعقب المتالي % % 103(@)(@@) % وذم الناس مجلوب رخيص % لأيسر علة والحمد غالي % % 104(@)(@@) % وأهل الظرف منصورون قدما % لهم من كل طائفة موالي % % 105(@)(@@) % فلا تبعث عليك لسان حفل % وحفل بعد حفل واحتفال % 106(@)(@@) % أقاسي ساهرا إذا لا تقاسي % % رياضتي القريض ولاارتجالي % % 107(@)(@@) % وأركب أخمصي إذ لاتراعي % % حفاي كيف كان ولاانتعالي % % 108(@)(@@) % سأدعو الله مبتهلا إليه % % عليك مع الدعاة على الإلال % 109(@)(@@) % وإن لم يبتهل جهرا لساني % % عليك فنيتي لك بابتهال % 110(@)(@@) % وظلت لما غاص في بحرها % % آمل أن يرجع تأميلا % % PageV01P3546 110(@)(@@) % لم يملأ الآفاق لكنه % % قد دوخ الآفاق تجويلا % % 110(@)(@@) % يا طالب التفضيل في شنطف % حسبك بالجملة تفصيلا % % 110(@)(@@) % قالت صغير كاس في فعله % % فلم أحاول عنه تحويلا % % 110(@)(@@) % ولم يغص في بحركم قامة % حتى أراه عزرائيلا % % 110(@)(@@) % قلت وما تهوين من عاجز % لم يمش من صحرائكم ميلا % % 110(@)(@@) % بكت على أيري بعين استها % % حتى لقد بلت مناديلا % % 110(@)(@@) % حتى إذا صادمت خرطومها % % باليأس تنزيلا وتأويلا % % 110(@)(@@) % ثم تخلصت ففاصلتها % % فصلها الجزار تفصيلا % % 110(@)(@@) % واستدخلت إيري فعودته % % برب أن يرجع تأميلا % % 110(@)(@@) % حلت سراويلي على واسع % ما خلته إلا سراويلا % PageV01P3547 110(@)(@@) % وقلت لما حاولت رجعتي % % لساء تسويلك تسويلا % % 110(@)(@@) % أقسمت لو ألبسته جمة % يوسعها كفك ترجيلا % % 110(@)(@@) % هل يخجل التسفيل من كله % % يصلح للتسفيل تسفيلا % % 110(@)(@@) % من نتن حشيها وتشويهها % % ومن لظى تبا وتضليلا % 110(@)(@@) % تسفيلنا أملح من وجهها % % فما تبالي القال والقتيلا % % 110(@)(@@) % لا تعذلوا بظراء زمردة % تضحى لها الأيدي خلاخيلا % % 110(@)(@@) % فانصرفت مكروبة شنطف % تساجل الدمع المثاكيلا % % 110(@)(@@) % عذرت ذاك الوجه أنه % يصلح للرأس 
ms899	 منديلا % % 110(@)(@@) % ثم تحملت وكللته % % من فاخر الدر أكاليلا % % 110(@)(@@) % صادم حافات حري كلها % % مكلل الرأس ثآليلا % % PageV01P3548 110(@)(@@) % ولست والله تذوقينه % % إلا إذا هومت تخييلا % % 110(@)(@@) % من اغتدى بعدك يخشى لظى % % لم يعتقد في الله تعديلا % % 110(@)(@@) % ولست أخشى النار لظى % % لم يعتقد في الله تعديلا % % 110(@)(@@) % وكل من ظنك محظورة % معتقد في الله تبخيلا % % 110(@)(@@) % أنت حلال غير محجوزة . % حسبي بتشويهك تحليلا % % 110(@)(@@) % فعد ونكني الآن قلت اغربي % % لا أشتهي العمش المهازيلا % % 110(@)(@@) % ما ذقته عودا ولو سبلت % % وقوفه في الفسق تسبيلا % % 110(@)(@@) % قد عذب الله امرءا ناكها % % طورين تعجيلا وتأجيلا % 110(@)(@@) % احللت تنكيلي بباب استها % % فكان للتنكيل تنكيلا % % 110(@)(@@) % أما يرعى جلال الحق حر سريعإذا تغنت شنطف مرةفاصفح ودع عنك الأباطيلاضرابة بالطبل ضراطة تجيب بالتطبيل تطبيلا بذيءلها ضراط ريحه عاصف تطفىء بالليل القاناديلا بذيءمسمومة الريق إذا قبلتصحفت التقبيل تقبيلاقبلها جلمود عرادة يحسن لل % % وإن حجدت بصيرته جلالي % % PageV01P3549 110(@)(@@) % إذا تغنت شنطف مرة % فاصفح ودع عنك الأباطيلا % % 110(@)(@@) % ضرابة بالطبل ضراطة % تجيب بالتطبيل تطبيلا % 110(@)(@@) % لها ضراط ريحه عاصف % تطفىء بالليل القاناديلا % % 110(@)(@@) % مسمومة الريق إذا قبلت % % صحفت التقبيل تقبيلا % % 110(@)(@@) % قبلها جلمود عرادة % يحسن للبخراء تقبيلا % % 110(@)(@@) % فاحشة النقصان لكنها % % قدكملت بالبظر تفضيلا % % 110(@)(@@) % أزري بها الله فلم يعطها % % إلا بطول البظر تفضيلا % % 110(@)(@@) % إذا بدا الفيل وخرطومه % % قلنا أعارت بظرها الفيلا % % 110(@)(@@) % غول يبيت الشرب من قبحها % % خولت الأهواء تخويلا % % 110(@)(@@) % عطلت الأرباب لا قدست % وما ترى للأير تعطيلا % % PageV01P3550 110(@)(@@) % ما أحسن الأرقم طوقا لها % % وأحسن الأسود إكليلا % 110(@)(@@) % لكنها مرت على سمعها % % قصة هابيل وقابيلا % % 110(@)(@@) % لا تعبد الله ولكنها % % تعبد بالليل الغراميلا % % 110(@)(@@) % من رتل الآية ألفيتها % % ترتل الشهقة ترتيلا % 110(@)(@@) % في وجهها سميا وفي ساقها % % من فعلها تلك الأفاعيلا % % 110(@)(@@) % واضحة الأثرين من طول ما % % تناك إبراكا وتجديلا % 110(@)(@@) % افادها تبراكها غرة % وبذلها الرجلين تحجيلا % 110(@)(@@) % والله ما أدري إذا كرعت % أأحسنت أم أقبحت قيلا % % 110(@)(@@) % في سكرة الموت لنا مذهل % عنها وما أسرفت 
ms900	 تمثيلا % 110(@)(@@) % إذا تغنت سطعت نكهة % تتركنا عنها مشاغيلا % % PageV01P3551 110(@)(@@) % يابسة العود وقد ذللت % قطوفها للنيك تذليلا % % 110(@)(@@) % لو رامت التوبة لم تستطيع % لسنة الشيطان تبديلا % % 110(@)(@@) % تحققت بالفسق في داره % وزادت التكريع تطفيلا % % 110(@)(@@) % ليست تواري من أخ سوءة % % طالبة إذ ذاك تنويلا % % 110(@)(@@) % لو حسنت معشار ما قبحت % خولت الأهواء تخويلا % % PageV01P3552 البحر : - 1(@)(@@) % إذا أنت أزمعت الصنيعة مرة % فلا تعتصر ماء الصنيعة بالمطل % 2(@)(@@) % ولاتخلط الحسنى بسوء فإنه % % يجشمنا أن نخلط الشكر بالعذل % 3(@)(@@) % أترضى بأن تكنى بسهل وأن ترى % % وما مطلب الحاجات عندك بالسهل % 4(@)(@@) % أنفت لعشاقالمكارم أن ترى % % مواعيدهم مثل البوارق في المحل % % 5(@)(@@) % ولاسيما بعد المشيب وبعدها % % أراهم هدي منهاجهم سرج العقل % % 6(@)(@@) % تعلم أبا سهل بأني عالم % على علم ذي علم بعلمي وذي جهل % % 7(@)(@@) % وأني أرى حسن الأمور وقبحها % % بألوي من الآراء مستحكم الجدل % 8(@)(@@) % ومما أرى أن النوال إذا أتى % % على الكره كان المنع خيرا من البذل % 9(@)(@@) % ولم لا وقد ألجأت ملتمس الجدا % % إلى الطلب المذموم والخلق والوغل % 10(@)(@@) % واعطيته المنزور بعد مطاله % % فخست منه وانتسبت إلى الفضل % PageV01P3553 11(@)(@@) % أرى الجزل من نيل الرجال هنيؤه % ومانائل جزل مع المطل بالجزل % 12(@)(@@) % وها إنني من بعدها متمثل % بوفق من الأمثال في منطق فصل % 13(@)(@@) % مطلت مطال النخل فاثبت ثباته % واجن جناه أو فدع نكد النخل % 14(@)(@@) % ولا يك ماتجديه كالبقل خسة % وكالنخل تأخيرا فما ذاك بالعدل % % PageV01P3554 البحر : - 1(@)(@@) % سئل الأير ماتريد إلى الكع % ثب قال الدخول قيل ألا ادخل % 2(@)(@@) % قال أبغي الخروج قيل ألا فاخ % % رج فقال الخروج ماليس يسهل % 3(@)(@@) % إنما شأني التردد فيه % % داخلا خارجا أغيب وأنصل % 4(@)(@@) % شهوة القلب لبثه بين أيد % وشفائي ترددي بين أرجل % 5(@)(@@) % هم ذاك العناق والنيك همي % % وكلانا في شأنه ليس يغفل % % 6(@)(@@) % ولي الدهر طعنة ذات غور % غير أن لست حين أطعن أقتل % 7(@)(@@) % وترى لي كريمة القوم حقا % وذماما وحرمة حين أمثل % 8(@)(@@) % وعليها يخف لي لا لغيري % % كل شيء من 