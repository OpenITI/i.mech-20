ms286	 نایه عمر تو مقید به دوام %~% وز ازل جامه جاه تو مزین به طراز(@)(@@) 39 ساحت عز ترا نیست کناری بخرام %~% عرصه عمر ترا نیست کرانی بگراز PageV1P0424(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 زندگانی ولی نعمت من باد دراز %~% در مزید شرف و دولت و پیروزی و ناز(@)(@@) 2 باد معلوم خداوند که من بنده همی %~% نیستم جمله حقیقت چو نیم جمله مجاز(@)(@@) 3 از موالید جهانم من و در کل جهان %~% چیست کان را متغیر نکند عمر دراز(@)(@@) 4 از خلاف حرکت مختلف آمد همه چیز %~% اندرین منزل شادی و غم و ناز و نیاز(@)(@@) 5 در بنی‌آدم چونان که صوابست خطاست %~% کو ز خاک است و همه خاک نشیبست و فراز(@)(@@) 6 این معانی همه معلوم خداوند منست %~% چون چنین است به مقصود حدیث آیم باز(@)(@@) 7 زیبد ار رمز دو از سر هوای دل خویش %~% پیش تو باز نمایم به طریق ایجاز(@)(@@) 8 اولا تا که ز خدام توام نتوان گفت %~% که در کس به سلامی مثلا کردم باز(@)(@@) 9 خدمت تو چو نمازست مرا واجب و فرض %~% به خدایی که جز او را نتوان برد نماز(@)(@@) 10 پایم از خطه فرمان تو بیرون نشود %~% سرم ار پیش تو چون شمع ببرند به گاز(@)(@@) 11 در همه ملک تو انگشت به کاهی نبرم %~% تا نیابم ز رضای تو به صد گونه جواز(@)(@@) 12 نیست بر رای تو پوشیده که من خدمت تو %~% از برای تو کنم نز پی تشریف و نواز(@)(@@) 13 چون چنین معتقدم خدمت درگاه ترا %~% بهر آزار دلی از در عفوم بمتاز(@)(@@) 14 درخیال تو نه بر وفق مرادت چو دهم %~% صورت ساحت من قاعده کینه مساز(@)(@@) 15 گیرم از روی عیانش نتوان کرد عتاب %~% آخر از وجه نصیحت بتوان گفت به راز(@)(@@) 16 قصه کوتاه کنم غصه بپردازم به %~% تا نجاتی بودم باشد ازین گرم و گداز(@)(@@) 17 دی در آن وقت که بر رای رفیعت 
ms287	 بگذشت %~% که فلان باز حدیث حرکت کرد آغاز(@)(@@) 18 گرهی گشت بر ابروی شریفت پیدا %~% از سیاست شده با عقده گردون انباز(@)(@@) 19 نه مرا زهره آن کز تو بپرسم کان چیست %~% نه گمانی که کند گرد ضمیرت پرواز(@)(@@) 20 ساعتی بودم و واقف نشدم رفتم و دل %~% در کف غم چو تذروی شده در چنگل باز(@)(@@) 21 گر به تشریف جوابم نکنی آگه از آن %~% دهر بر جامه عمرم کشد از مرگ طراز(@)(@@) 22 تا بود نیک و بد و بیش و کم اندر پی هم %~% تا بود سال و مه و روز و شب اندر تک و تاز(@)(@@) 23 روز و شب جز سبب رافت و انصاف مباش %~% سال و مه جز ندب دولت و اقبال مباز(@)(@@) 24 داده بر باد رضای تو فلک خرمن دهر %~% شسته از آب خسخای تو جهان تخته آز(@)(@@) 25 نامه عمر ترا از فلک این باد خطاب %~% زندگانی ولی نعمت من باد دراز PageV1P0425(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای بر اعدا و اولیا پیروز %~% در مکافات این و آن‌شب و روز(@)(@@) 2 بر یکی جود فایضت غالب %~% وز دگر جاه قاهرت کین‌توز(@)(@@) 3 بذل نزدیک همت تو چو وام %~% کرمت وام تو ز شکر اندوز(@)(@@) 4 داده بی‌میل و کرده بی‌کینه %~% دور این مایه‌ساز صورت‌سوز(@)(@@) 5 قالب دوستانت را دل شیر %~% حال دشمنانت را سگ و یوز(@)(@@) 6 ای بحق هر دو تصرف تو %~% مالک هر دوی بدر و بدفوز(@)(@@) 7 زانکه اقبال خویش را دیدم %~% با رخ دلگشای جان‌افروز(@)(@@) 8 گفتمش هان چگونه داری حال %~% زیراین ورطه تاب حادثه‌سوز(@)(@@) 9 گفت ویحک خبر نداری تو %~% که بگو بازگشت آخر گوز(@)(@@) 10 حدثان کرد رای پای‌افزار %~% آسمان گشت مرغ دست‌آموز(@)(@@) 11 شب محنت به آخر آمد و شد %~% شب من روز و روز من نوروز(@)(@@) 12 روزم از روز بهترست اکنون %~% از مراعات شمس دین بهروز(@)(@@) 13 باد عمرش چو جاه روز افزون %~% عمر 
ms288	 اعداش عمر روز سپوز(@)(@@) 14 حاسدانش همیشه سرگردان %~% غم بر ایشان ز بخت بد فیروز(@)(@@) 15 وقت بر آبریز سبلتشان %~% آنکه گویند صوفیانش گوز(@)(@@) 16 جاودان از فلک خطابش این %~% کای بر اعداد و اولیا پیروز PageV1P0426(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 چون مراد خویش را با ملک ری کردم قیاس %~% در خراسان تازه بنهادم اقامت را اساس(@)(@@) 2 چون غنیمت را مقابل کرده شد با ایمنی %~% عقل سی روز و طمع ماهی بود راسابراس(@)(@@) 3 ای طمع از خاک رنگین گر تهی داری تو کیس %~% وی طرب از آب رنگین گر تهی داری تو کاس(@)(@@) 4 وی دل ار قومی نکردند از تو یاد اندر رحیل %~% عیب نبود زانکه از اطوار نسناسند ناس(@)(@@) 5 تا خداوندی چو مجد دولت و دین بوالحسن %~% حق‌شناس بندگان باشد چه غم او را شناس(@)(@@) 6 آنکه از کنه کمالش قاصرست ادراک عقل %~% راست چونان کز کمال عقل ادارک حواس(@)(@@) 7 آکه با جودش سبکساری نیاید ز انتظار %~% وانکه با بذلش گرانباری نباشد از سپاس(@)(@@) 8 یابد از یک التفاتش ملک استغنا نیاز %~% همچنان کز کیمیا ترکیب زر یابد نحاس(@)(@@) 9 خواستم گفتن که دست و طبع او بحرست و کان %~% عقل گفت این مدح باشد نیز با من هم پلاس(@)(@@) 10 دست او را ابر چون گویی وآنجا صاعقه %~% طبع او را کان چرا خوانی و آنجا احتباس(@)(@@) 11 دهر و دوران در نهاد خویش از آن عالی‌ترند %~% کز سر تهمت منجمشان بپیماید به طاس(@)(@@) 12 در لباس سایه و نور زمان عقلش بدید %~% گفت با خود ای عجب نعم‌البدن بس‌اللباس(@)(@@) 13 ای نداده چرخ جودت تن درین سوی شمار %~% وی نهاده دخل جاهت پای از آن روی قیاس(@)(@@) 14 ای به رسم خدمت از آغاز دوران داشته %~% طارم قدر ترا هندوی هفتم چرخ پاس(@)(@@) 15 عالم قدرت مجسم نیست ورنه باشدی %~% اندرونی سطح او بیرون عالم را مماس(@)(@@) 16 مرگ بیرون ماند از گیتی چو 
ms289	 تقدیر محال %~% گر درو سدی کشی از خاک حزم و آب باس(@)(@@) 17 بر تو حاجت نیست کس را عرض کردن احتیاج %~% زانکه باشد از همه کس التماست التماس(@)(@@) 18 انظرونا نقتبس من نورکم کی گفت چرخ %~% کافتاب از آفتاب همتت کرد اقتباس(@)(@@) 19 ختم شد بر تو سخا چونان که بر من شد سخن %~% این سخن در روی گردون هم بگویم بی‌هراس(@)(@@) 20 دور نبود کاین زمان بر وفق این دعوی که رفت %~% در دماغش خود شهادت را همی گردد عطاس(@)(@@) 21 شاعری دانی کدامین قوم کردند آنکه بود %~% ابتداشان امر القیس انتهاشان بوفراس(@)(@@) 22 واینکه من خادم همی پردازم اکنون ساحریست %~% سامری کو تا بیابد گوشمال لامساس(@)(@@) 23 از چه خیزد در سخن حشو از خطا بینی طبع %~% وز چه خیزد پرزه بر دیبا ز ناجنسی لاس(@)(@@) 24 تا بود سیر السوانی در سفر دور فلک %~% واندران دوران نظیر گاو او گاو خراس(@)(@@) 25 گاو گردون هرگز اندر خرمن عمرت مباد %~% تا مه کشت‌زار آسمان را هست داس(@)(@@) 26 تا که باشد این مثل کالیاس احدی الراحتین %~% بادی اندر راحتی کورا نباشد بیم یاس(@)(@@) 27 دامن بخت تو پاک از گرد آس آسمان %~% وز جفای آسمان خصم تو سرگردان چو آس(@)(@@) 28 بی‌سپده‌دم شب خذلان بدخواهت چنانک %~% تا به صبح حشر می‌گوید احاد ام سداس PageV1P0427(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 زهی دست تو بر سر آفرینش %~% وجود تو سر دفتر آفرینش(@)(@@) 2 فضا خطبه‌ها کرده در ملک و ملت %~% به نام تو بر منبر آفرینش(@)(@@) 3 چهل سال مشاطه کون کرده %~% رسوم ترا زیور آفرینش(@)(@@) 4 طرازی نه چون طاهربن مظفر %~% به عهد تو در ششتر آفرینش(@)(@@) 5 اگر فضله گوهر تو نبودی %~% حقیر آمدی گوهر آفرینش(@)(@@) 6 گشاد نفاذ تو گردون فطرت %~% بپردازد از دفتر آفرینش(@)(@@) 7 وگر اختر تو نبودی نگشتی %~% سعادت‌رسان اختر آفرینش(@)(@@) 8 به باد عدم بردهد گر بخواهد %~% خلاف تو خاکستر آفرینش(@)(@@) 9 فنا بارها 
ms290	 کرد عزم مصمم %~% که تا بشکند چنبر آفرینش(@)(@@) 10 شکوه تو دریافت آن کار اگرنه %~% بکردی فنا در خور آفرینش(@)(@@) 11 به دیوان جاهت گذارند انجم %~% خراج نهم کشور آفرینش(@)(@@) 12 وز اقطاع جودت رسانند ارکان %~% وجوب همه لشکر آفرینش(@)(@@) 13 تو ای سرور آفرینش نبینی %~% که هر دم قضا مادر آفرینش(@)(@@) 14 به زجر تمام از طبیعت بپرسد %~% که هم به نشد سرور آفرینش(@)(@@) 15 ترا کردگار از برای تحفظ %~% موکل کند بر سر آفرینش(@)(@@) 16 تکسر چه باشد که با چون تو شحنه %~% بگردد به گرد در آفرینش(@)(@@) 17 حوادث چرا بستری گستردکان %~% به معنی بود بستر آفرینش(@)(@@) 18 گوا می‌کنم بر تو هان ای طبیعت %~% درین داوری داور آفرینش(@)(@@) 19 که تا گرم و سردی برویش نیاری %~% که این است خشک و تر آفرینش(@)(@@) 20 الا تا مزاج عناصر به نسبت %~% زیادت کند پیکر آفرینش(@)(@@) 21 تو بادی که جز با تو نیکو نیاید %~% قبای بقا در بر آفرینش(@)(@@) 22 دوام ترا بیخ در آب و خاکی %~% کزو رست برگ و بر آفرینش(@)(@@) 23 بقای تو چندان که در طول و عرضش %~% نشاید بجز محور آفرینش PageV1P0428(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای شادی جان آفرینش %~% وی گوهر کان آفرینش(@)(@@) 2 ای محرم خلوتی که آنجا %~% محسوت نشان آفرینش(@)(@@) 3 ای بلبل بوستان تجرید %~% در شوره‌ستان آفرینش(@)(@@) 4 در جلوه کشیده کشف نطقت %~% اسرار نهان آفرینش(@)(@@) 5 در بدو وجود گفته پیرت %~% کای بخت جوان آفرینش(@)(@@) 6 ناجسته ز فکرتت روانتر %~% تیری ز کمان آفرینش(@)(@@) 7 آزاد مراتب یقینت %~% زاسیب گمان آفرینش(@)(@@) 8 بی‌فاتحه ثنا نبرده %~% نام تو زبان آفرینش(@)(@@) 9 در شیوه اختراع و ابداع %~% با تاب و توان آفرینش(@)(@@) 10 گم کرده گران رکابی تو %~% تیزی عنان آفرینش(@)(@@) 11 در بی‌جهتی هلال قدرت %~% فارغ ز بنان آفرینش(@)(@@) 12 در بی‌صفتی علو نعتت %~% برتر ز بیان آفرینش(@)(@@) 13 نابسته نبوده تا که بوده %~% پیش تو میان آفرینش(@)(@@) 14 صیت 
ms291	 تو گرفته صد ولایت %~% زانسوی جهان آفرینش(@)(@@) 15 ده یازده قبول داری %~% بر کل مکان آفرینش(@)(@@) 16 بیش است زکوة مایه تو %~% از سود و زیان آفرینش(@)(@@) 17 سوگند به جان تو خورد عقل %~% یعنی که به جان آفرینش(@)(@@) 18 ای نازده آفرینشت راه %~% عبادی و آن آفرینش(@)(@@) 19 هر نوبت مجلست بهاریست %~% در فصل خزان آفرینش(@)(@@) 20 سر گم شده نعره مریدانت %~% نواب فغان آفرینش(@)(@@) 21 افتاده بر آستانه سمع %~% مست از تو روان آفرینش(@)(@@) 22 لوزینه استعارت تست %~% آرایش خوان آفرینش(@)(@@) 23 نقد سخنت چو رایج افتاد %~% در داد و ستان آفرینش(@)(@@) 24 صراف سخن که نفس کلیست %~% بر طرف دکان آفرینش(@)(@@) 25 پرسید ز عقل کل که آن چیست %~% گفتا همه دان آفرینش(@)(@@) 26 تا ابلق تند دهر رامست %~% اندر خم ران آفرینش(@)(@@) 27 در خدمت دور دولتت باد %~% دوران و زمان آفرینش(@)(@@) 28 شیرین ز زبان شکرینت %~% تا حشر دهان آفرینش PageV1P0429(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای نهان گشته در بزرگی خویش %~% وز بزرگی ز آسمان شده بیش(@)(@@) 2 آفتاب این چنین بود که تویی %~% آشکار و نهان ز تابش خویش(@)(@@) 3 تو ز اندیشه آن سویی و جهان %~% همه زین سوی عقل دوراندیش(@)(@@) 4 باد بر سده تو هم نرسد %~% باد فکرت نه باد خاک پریش(@)(@@) 5 وهم را بین که طیره برگشتست %~% پر بیفکنده پای ز ابله ریش(@)(@@) 6 ای توانگر ز تو بسیط زمین %~% وز نظیر تو آسمان درویش(@)(@@) 7 بی‌تو رفتست ورنه در زنبور %~% در پی نوش کی نشستنی نیش(@)(@@) 8 لطف ار پای درنهد به میان %~% گرگ را آشتی دهد با میش(@)(@@) 9 آسمان گر سلاح بربندد %~% تیر تدبیر تو نهد در کیش(@)(@@) 10 ماهتاب از مزاج برگدد %~% گر به حلق تو بر بمالد خیش(@)(@@) 11 ور کند چوب آستان تو حکم %~% شحنه چوبها شود آدیش(@)(@@) 12 جان نو داده‌ای جهانی را %~% فرق ناکرده اهل مذهب و کیش(@)(@@) 13 این نه خلقست نور 
ms292	 خورشیدست %~% که به بیگانه آن رسد چو به خویش(@)(@@) 14 شاد باش ای به معجزات کرم %~% مریمی از هزار عیسی بیش(@)(@@) 15 تا نگویی که شعر مختصرست %~% مختصر نیست چون تویی معنیش(@)(@@) 16 بخدای ار کس این قوافی را %~% به سخن برنشاندی به سریش PageV1P0430(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دوش سرمست آمدم به وثاق %~% با حریفی همه وفا و وفاق(@)(@@) 2 دیدم از باقی پرندوشین %~% شیشه‌ای نیمه بر کناره طاق(@)(@@) 3 می چون عهد دوستان به صفا %~% تلخ چون عیش عاشقان به مذاق(@)(@@) 4 هر دو در تاب خانه‌ای رفتیم %~% که نبد آشنا هوای رواق(@)(@@) 5 بنشستیم بر دریچگکی %~% که همی دید قوسی از آفاق(@)(@@) 6 بر یمینم ز منطقی اجزا %~% بر یسارم ز هندسی اوراق(@)(@@) 7 همه اطراف خانه لمعه برق %~% زان رخ لامع و می براق(@)(@@) 8 شکر و نقل ما ز شکر وصال %~% جرعه جام ما ز خون فراق(@)(@@) 9 نه مرا مطربان چابک‌دست %~% نه مرا ساقیان سیمین ساق(@)(@@) 10 غزلکهای خود همی خواندم %~% در نهاوند و راهوی و عراق(@)(@@) 11 ماه ناگه برآمد از مشرق %~% مشرقی کرد خانه از اشراق(@)(@@) 12 به سخن درشدیم هر سه بهم %~% چون سه یار موافق مشتاق(@)(@@) 13 ماه را نیکویی همی گفتیم %~% که دریغی به اجتماع و محاق(@)(@@) 14 ذوشجون شد حدیث و دردادیم %~% قصه چرخ ازرق زراق(@)(@@) 15 گفتم آیا کسی تواند کرد %~% در بساط زمین علی الاطلاق(@)(@@) 16 منع تقدیر او به استقلال %~% کشف اسرار او به استحقاق(@)(@@) 17 نه در آن دایره که در تدویر %~% نتوانند زد نطق ز نطاق(@)(@@) 18 نه از آن طایفه که نشناسد %~% معنی احتراق از احراق(@)(@@) 19 ماه گفتا که برق وهمی بود %~% که برین گنبد آمدی به براق(@)(@@) 20 در خراسان ز امتش دگریست %~% که برو عاشقست ملک عراق(@)(@@) 21 عصمت ایزدی رکاب و عنانش %~% مدد سرمدی ستام و جناق(@)(@@) 22 دانی آن کیست واحدالدین است %~% آن ملک خلقت ملوک اخلاق(@)(@@) 23 گفتم 
