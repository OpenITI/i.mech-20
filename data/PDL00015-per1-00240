ms231	 و محل تو شده راس و ذنب(@)(@@) 50 باد بر پای عنا خواه تو از دامن بند %~% باد بر گردن اعدات گریبان ز کنب(@)(@@) 51 باد فرخندت نوروز و رجب اندر عز %~% باد چونین دو هزارت مه نوروز و رجب PageV1P0455(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 احسنت یا بدرالدجی لبیک یا وجه‌العرب %~% ای روی تو خاقان روز وی موی تو سلطان شب(@)(@@) 2 شمس‌الضحی ایوان تو بدر الظم دیوان تو %~% فرمان همه فرمان تو ای مهتر عالی نسب(@)(@@) 3 خه خه بنامیزد مهی هم صدر و بدر درگهی %~% از درد دلها آگهی ای عنصر جود و ادب(@)(@@) 4 فردوس اعلا روی تو حکم تجلی کوی تو %~% ای در خم گیسوی تو جانها همه جانان طلب(@)(@@) 5 صدر معین را سر تویی دنیا و دین را فر تویی %~% بر مهتران مهتر تویی از تست دلها را طرب(@)(@@) 6 رویت چو «طاها» طاهرست «و اللیل» مویت ظاهرست %~% امر «لعمرک» ناظرست دریا ک پاک آمد لقب(@)(@@) 7 برنه قدم ای شمع دین بر شهپر روح‌الامین %~% کرو بیانت بر یمین روحانیانت دست چپ(@)(@@) 8 نازان ز قربت جد و عم خرم به دیدارت حشم %~% بنمای هان ای محتشم قرب دو عالم در دو لب(@)(@@) 9 گر از تو نشنیدی صلا شمع نبوت بر ملا %~% خورشید بفگندی قبا ناهید بشکستی قصب(@)(@@) 10 هستی سزای منزلت هم ابتدا هم آخرت %~% آری عزیز مملکت هستی تو ملکت را نسب(@)(@@) 11 در جام جانها دست کن چون نیست کردی هست کن %~% ما را ز کوثر مست کن این بس بود ما العنب(@)(@@) 12 بر یاد او کن جام نوش چشم از همه عالم بپوش %~% گندم نمای جو فروش آخر مباش ای بوالعجب PageV1P0456(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 یارب چه بود آن تیرگی و آن راه دور و نیمشب %~% وز جان من یکبارگی برده غم جانان طرب(@)(@@) 2 گردون چو روی عاشقان در لولو مکنون نهان %~% گیتی چو روی دلبران پوشیده از عنبر سلب 
ms232	(@)(@@) 3 روی سما گوهر نگار آفاق را چهره چو قار %~% آسوده طبع روزگار از شورش و جنگ حلب(@)(@@) 4 اجرام چرخ چنبری چون لعبتان بربری %~% پیدا سهیل و مشتری خورشید روشن محتجب(@)(@@) 5 این اختران در وی مقیم از لمع چون در یتیم %~% این راجع و آن مستقیم این ثابت و آن منقلب(@)(@@) 6 محکم عنان در چنگ من سوی نگار آهنگ من %~% بسپرده ره شبرنگ من گاهی سریع و گه خبب(@)(@@) 7 باد بهاری خویش او ناورد و جولان کیش او %~% صحرا و دریا پیش او چون مهره پیش بوالعجب(@)(@@) 8 از نعل او پر مه زمین و ز گام او کوته زمین %~% وز هنگ او آگه زمین وز طبع او خالی غضب(@)(@@) 9 آهو سرین ضرغام بر کیوان منش خورشید فر %~% خارا دل و سندان جگر رویین سم و آهن عصب(@)(@@) 10 در راه چو شبرنگ جم با شیر بوده در اجم %~% آمخته جولان در عجم خورده ربیع اندر عرب(@)(@@) 11 در منزل «سلما» و «می » گشتم همی ناخورده می %~% تن همچو اندر آب نی دل همچو بر آتش قصب(@)(@@) 12 آمد به گوشم هر زمان آواز خضر از هر مکان %~% کایزد تعالی را بخوان در قعر قاع مرتهب(@)(@@) 13 خسته دل من در حزن گفتی مر الاتعجلن %~% چون گفتمی با دیده من «انا صببنا الما صب»(@)(@@) 14 راهی چنان بگذاشتم باغ ارم پنداشتم %~% از صبر تخمی کاشتم آمد ببر بعدالتعب(@)(@@) 15 روز آمده درمان من آسوده از غم جان من %~% از خیمه جانان من آمد به گوش من شغب(@)(@@) 16 آواز اسب من شنید آن ماهپیش من دوید %~% وصل آمد و هجران پرید آمد نشاط و شد کرب(@)(@@) 17 باوی نشستم می به دست او بت بدو من بت پرست %~% از عشق او من گشته مست او مست بذر آب عنب(@)(@@) 18 هم ناز دیدم هم بلا هم درد دیدم هم دوا %~% هم خوف دیدم هم رجا 
ms233	 هم خار دیدم هم رطب(@)(@@) 19 گه دست یازیدم همی زلفش ترازیدم همی %~% گه نرد بازیدم همی یک بوسه بود و یک ندب(@)(@@) 20 بر من همی کرد او ثنا خندان همی گفت او مرا %~% بر خوان مدیح او کجا المدح فیه قد وجب PageV1P0457(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بتی که گر فکند یک نظر بر آتش و آب %~% شود ز لطف جمالش مصور آتش و آب(@)(@@) 2 کرشمه‌ای گر ازو بیند آب و آتش هیچ %~% شود ز چشمش بی‌شک معبهر آتش و آب(@)(@@) 3 ز سیم و شکر روی و لب آن کند با من %~% نکردهرگز بر سیم و شکر آتش و آب(@)(@@) 4 لب و دو عارض با آب و نارش آخر برد %~% ز طبع و روی من آن ماه دلبر آتش و آب(@)(@@) 5 ز آه من نشگفت وز چهرش ار گیرد %~% سپهر بر شده و چشم اختر آتش و آب(@)(@@) 6 میار طعنه اگر عارض و لبش جویم %~% از آنکه جست کلیم و سکندر آتش و آب(@)(@@) 7 ز خطرت دل و چشم وی اندرین دل و چشم %~% بسان ابر بهاری ست مضمر آتش و آب(@)(@@) 8 بشب بخفته خوش و من ز هجر او کرده %~% ز دیده و دل بالین و بستر آتش و آب(@)(@@) 9 ز درد فرقت آن ابر حسن و شمع سرای %~% چو ابر و شمعم در چشم و بر سر آتش و آب(@)(@@) 10 به دل گرفت به وقتی نگار من که همی %~% کنند لانه و باده بدل بر آتش و آب(@)(@@) 11 ببین تو اینک بر لاله قطره باران %~% اگر ندیدی بر هم مقطر آتش و آب(@)(@@) 12 بطبع شادی زاید ز زاده‌ای کو را %~% پدر صبا و زمین بود مادر آتش و آب(@)(@@) 13 ز برق و باد به بینی بر آسمان و زمین %~% حسام‌وار شدست وز ره در آتش و آب(@)(@@) 14 پدید کرد تصاویر مانی ابر و زمین %~% برآورید 
ms234	 تماثیل آزر آتش و آب(@)(@@) 15 مزاج و طبع هوا گرم و نرم شد نشگفت %~% اگر بزاید از پشم و مرمر آتش و آب(@)(@@) 16 چو طبع سید گردد چمن به زینت و فر %~% چو عدل سید گردد برابر آتش و آب(@)(@@) 17 سر محامد سید محمد آنکه شدست %~% بلند همت و نظمش به گوهر آتش و آب(@)(@@) 18 مهی که گر فکند یک نظر به لطف و به خشم %~% شود بسوی ثری و دو پیکر آتش و آب(@)(@@) 19 به نور رایش گشته منور انجم و چرخ %~% به ذات عونش گشته معمر آتش و آب(@)(@@) 20 به نزد بخشش و بذلش محقر ابر و بحار %~% به نزد حشمت و حلمش مستر آتش و آب(@)(@@) 21 مسخر خضر ار گشت باد و آب و زمین %~% مثال امر ورا شد مسخر آتش و آب(@)(@@) 22 به حلم و خشمش کردند وصف از آن معنی %~% مهیب و سهل بود بر غضنفر آتش و آب(@)(@@) 23 زند به امرش اگر هیچ خواهد از خورشید %~% به حد باختر و حد خاور آتش و آب(@)(@@) 24 گر آب و آتش اندر خلاف او کوشند %~% ز باد و خاک بینند کیفر آتش و آب(@)(@@) 25 به حکم نافذ نشگفت اگر برون آرد %~% ز چوب و سنگ چو موسی پیمبر آتش و آب(@)(@@) 26 ز باد قدرت اگر کرد جانور عیسی %~% شود ز فرش بی‌باد جانور آتش و آب(@)(@@) 27 زهی ز مایه رایت منور انجم و چرخ %~% زهی ز سایه تیغت مظفر آتش و آب(@)(@@) 28 گه موافقت ار چون دل تو بودی چرخ %~% بدی به چرخ برین قطب و محور آتش و آب(@)(@@) 29 شمال جودت بر آب و آتش ار نوزید %~% چرابه گونه چو سیمست و چون زر آتش و آب(@)(@@) 30 ز باس و سعی تو بدست ورنه بی‌سببی %~% بطبع خشک چرا آمد و تر آتش و آب(@)(@@) 31 به صدر دولت بایسته‌ای 
ms235	 واندر خور %~% چنانکه هست و ببایست و در خور آتش و آب(@)(@@) 32 به طبع خویش نبینند هیچ اگر خواهی %~% به قدر و قد تو پستی وو نظر آتش و آب(@)(@@) 33 سموم خشم تو گر برزند به ابر و زمین %~% نسیم خلق تو گر بروزد بر آتش و آب(@)(@@) 34 شو ز بیم تو لرزان زمین و ابر عقیم %~% شود ز خلق تو چون مشک و عنبر آتش و آب(@)(@@) 35 شود ز قدر تو عالیتر از سپهر زمین %~% رود به امر تو از بحر و اخگر آتش و آب(@)(@@) 36 اگر نه بیم و امیدت بدی به بحر و هوا %~% وگر نه هیبت و حکمت بدی بر آتش و آب(@)(@@) 37 برو عتاب و عقوبت خدای کی کردی %~% ز بهر یونس و قومش مسخر آتش و آب(@)(@@) 38 به هفت کشور خشمت رسید و نظم آری %~% جدا که دید خود از هفت کشور آتش و آب(@)(@@) 39 ز قدر و نظم تو دارند بهره زان نشدند %~% چو باد و خاک کثیف و مدور آتش و آب(@)(@@) 40 معاقبست حسودت به دو مکان به دو چیز %~% به سان فرعون در مصر و محشر آتش و آب(@)(@@) 41 میان طبع تو و طبع حاسدت در نظم %~% کفایت‌ست در آن شعر داور آتش و آب(@)(@@) 42 که چون در آید در طبع تو شود بی‌شک %~% بر آن دو طبع دگر کبر و مفخر آتش و آب(@)(@@) 43 به زیر فکرت و کلک تو خاست بر در نظم %~% ز خاک و باد از آنست برتر آتش و آب(@)(@@) 44 چو بود خاطر و طبع تو کلک را همراه %~% ببوسد ار چه بود کلک و دفتر آتش و آب(@)(@@) 45 اگر ندارد نسبت به خامه تو چراست %~% به نزد خامت هم خیر و هم شر آتش و آب(@)(@@) 46 شد از بها مدیحت سخنور اختر و کلک %~% شد از سخا وجودت توانگر آتش 
ms236	 و آب(@)(@@) 47 جهان بگیر به آن باد پای خاک نهاد %~% که هست با تک او کند و مضطر آتش و آب(@)(@@) 48 گه مسیر بود بر نهاد چرمه تو %~% به نزد عقل مصور شود گر آتش و آب(@)(@@) 49 به پست و بالا چون آب و آتشست مگر %~% شدست از پی تو اسب پیکر آتش و آب(@)(@@) 50 به سان صرصر لیکن به گاه تابش و خوی %~% که دید ساخته در طبع صرصر آتش و آب(@)(@@) 51 جهان ندید مگر چرمه ترا در تک %~% به هیچ مستقری سایه‌گستر آتش و آب(@)(@@) 52 زمانه ساخت ز هفت اختر و چهار ارکان %~% برای زینت بزمت دو لشکر آتش و آب(@)(@@) 53 بخواه از آنکه چو خوردی چو طبع خود بندد %~% دماغ و طبع ترا زیب و زیور آتش و آب(@)(@@) 54 بصوفت آب و بطبع آتش و ندیده جهان %~% مگر به جام توچون دو برادر آتش و آب(@)(@@) 55 تو روی شادی افروز و آب غم بر از آن %~% هنی و روشن در جام و ساغر آتش و آب(@)(@@) 56 که بهر پیرهنی من گزیدم از دل و چشم %~% ز جور چرخ چو دماغ و سمندر آتش و آب(@)(@@) 57 در آب و آتش بی‌حد چرا شوم غرقه %~% چو هست باد و هوا را مقدر آتش و آب(@)(@@) 58 ز خون ببست دل و چشم پس چو آهن و خاک %~% چراست در دل و چشمم مجاور آتش و آب(@)(@@) 59 برید فکرت کلک تو خواست بر در نظم %~% ز خاک و باد از آنست برتر آتش و آب(@)(@@) 60 ولیک از آتش و آبست دیده و دل من %~% چو در ثنای تو کردم مکرر آتش و آب(@)(@@) 61 همیشه تا به زمینست و چرخ گنج و نجوم %~% همیشه تا به سعیرست و کوثر آتش و آب(@)(@@) 62 سخاو لطف ترا بنده باد ابر و هوا %~% سنا و حلم ترا باد چاکر 
ms237	 آتش و آب(@)(@@) 63 مباد قاعده دولت تو زیر و زبر %~% همیشه تا که بود زیر و ازبر آتش و آب PageV1P0458(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 مرد هشیار در این عهد کمست %~% ور کسی هست بدین متهمست(@)(@@) 2 زیرکان را ز در عالم و شاه %~% وقت گرمست نه وقت کرمست(@)(@@) 3 هست پنهان ز سفیهان چو قدم %~% هر کرفا در ره حکمت قدمست(@)(@@) 4 و آن که راهست ز حکمت رمقی %~% خونش از بیم چو شاخ به قمست(@)(@@) 5 و آن که بیناست درو از پی امن %~% راه در بسته چو جذر اصمست(@)(@@) 6 از عم و خال شرف مر همه را %~% پشت دل بر شبه نقش غمست(@)(@@) 7 هر کجا جاه در آن جاه چهست %~% هر کجا سیم در آن سیم سمست(@)(@@) 8 هر کرا عزلت خرسندی خوست %~% گر چه اندر سقر اندر ارمست(@)(@@) 9 گوشه گشتست بسان حکمت %~% هر که جوینده فضل و حکمست(@)(@@) 10 دست آن کز قلم ظلم تهیست %~% پای آنکس به حقیقت قلمست(@)(@@) 11 رسته نزد همه کس فتنه گیاه %~% هر کجا بوی تف و نام نمست(@)(@@) 12 همه شیران زمین در المند %~% در هوا شیر علم بی‌المست(@)(@@) 13 هر که را بینی پر باد ز کبر %~% آن نه از فربهی آن از ورمست(@)(@@) 14 از یکی در نگری تا به هزار %~% همه را عشق دوام و درمست(@)(@@) 15 پادشا را ز پی شهوت و آز %~% رخ به سیمین برو سیمین صنمست(@)(@@) 16 امرا را ز پی ظلم و فساد %~% دل به زور و زر و خیل و حشمست(@)(@@) 17 سگ پرستان را چون دم سگان %~% بهر نان پشت دل و دین به خمست(@)(@@) 18 فقها را غرض از خواندن فقه %~% حیله بیع و ریا و سلمست(@)(@@) 19 علما را ز پی وعظ و خطاب %~% جگر از بهر تعصب به دمست(@)(@@) 20 صوفیان را ز پی رندان کام %~% قبله‌شان شاهد و شمع و شکمست(@)(@@) 21 زاهدان را 
ms238	 ز برای زه و زه %~% «قل هوالله احد» دام و دمست(@)(@@) 22 حاجیان را ز گدایی و نفاق %~% هوس و هوش به طبل و علمست(@)(@@) 23 غازیان را ز پی غارت و سهم %~% قوت از اسب و سلاح و خدمست(@)(@@) 24 فاضلان را ز پی لاف فضول %~% روی در رفع و جر و جزم و ضمست(@)(@@) 25 ادبا را ز پی کسب لجاج %~% انده نصب لن و جزم لمست(@)(@@) 26 متکلم را از راه خیال %~% غم اثبات حدوث و قدمست(@)(@@) 27 چرخ پیمای ز بهر دو دروغ %~% به سیه مسطر و شکل رقمست(@)(@@) 28 مرد طب را ز پی خلعت و نام %~% همه اندیشه او بر سقمست(@)(@@) 29 مرد دهقان ز پی کسب معاش %~% از ستور و خر و خرمن خرمست(@)(@@) 30 خواجه معطی ز پی لاف و ریا %~% تازه از مدحت و لرزان ز ذمست(@)(@@) 31 باز سایل را در هر دو جهان %~% دوزخش «لا» و بهشتش «نعم»ست(@)(@@) 32 طبع برنا را بر یک ساعت عیش %~% عاشق شرب و بت و زیر و بمست(@)(@@) 33 کهل را از قبل حرمت و عز %~% انده نفقه و زاد حرمست(@)(@@) 34 پیر نز بهر گناه از پی مال %~% تا دم مرگ ندیم ندمست(@)(@@) 35 سعی ساعی به سوی عالم از آن %~% که فلان جای فلان محتشمست(@)(@@) 36 چشم عامی به سوی عالم زان %~% که فلان در جدل کیف و کمست(@)(@@) 37 قد هر موی شکاف از پی ظلم %~% همچو دندانه شانه بهمست(@)(@@) 38 مرد ظالم شده خرسند بدین %~% که بگویند: فلان محترمست(@)(@@) 39 همگان سغبه صیدند و حرام %~% کو کسی کز پی حق در حرمست(@)(@@) 40 اینهمه مشغله و رسم و هوس %~% طالبان ره حق را صنمست(@)(@@) 41 همه بد گشته و عذر همه این: %~% گر بدم من نه فلان نیز همست(@)(@@) 42 اینهمه بیهده دانی که چراست %~% زان که بوالقاسمشان بوالحکمست(@)(@@) 43 جم از این قوم بجستست کنون %~% دیو با خاتم 
