ms341	 من ذاك المحيا فعاله % % 12(@)(@@) % محا الجدب عن وجه البرايا بأنمل % % تريك حيا الوسمي كيف انهماله % % 13(@)(@@) % ألم تره والله يبسط عمره % % يمر على الوادي فتثنى رماله % % 14(@)(@@) % رئيس بيد القائلين سكونه % % ويفضل عن يمنى الغمام شماله % % 15(@)(@@) % له قلم ان قال روى سجله % % مسامعنا أو جال روت سجاله % % 16(@)(@@) % حرام على الحالين سحر بديعه % % إذا جال في سلب العقول حلاله % % 17(@)(@@) % يجول به في الحرب والسلم ماجد % % مؤيدة أقواله وفعاله % % 18(@)(@@) % من المالكي رق المديح بنائل % % كأن بحار الأرض في الجود آله % % 19(@)(@@) % يزيد اتضاعا كلما زاد رفعة % وكم صاعد أخنى عليه اختياله % % 20(@)(@@) % ألا أيها الباغي منالا لشأوه % % اليك فليس الأمر مما تناله % % PageV01P1529 21(@)(@@) % له الله من غالي السجية عذبها % % كما انهل من فرع السحاب زلاله % % 22(@)(@@) % نزلت بمغناه فلم أخش حادثا % وكيف وهذا جاهه لي وماله % % 23(@)(@@) % أمولاي ان الحال مد رجاؤه % % اليك وأن القصد آل مآله % % 24(@)(@@) % دعاك لتمييز الوسائل طالب % فلا غرو أن يسمو بريك حاله % % PageV01P1530 البحر : - 1(@)(@@) % يا سائلي بدمشق عن أحوالي % % قف واستمع عن سيرة البطال % % 2(@)(@@) % ودع استماع تغزلي وتعشقي % % ماذا زمان العشق والأغزال % % 3(@)(@@) % طول النهار لباب ذا من باب ذا % % أسعى لعمر أبيك سعي ظلال % % 4(@)(@@) % لاحظ لي في ذاك الا أنه % % قد خف من طول المسير طحالي % % 5(@)(@@) % أسعى على شغل وأترك خلوة % فأعود لا علمي ولا أعمالي % % 6(@)(@@) % واذا تغير مورد وقصدت لي % % صحبا وجدت الصحب مثل الآل % % 7(@)(@@) % هذا الزمان ليس فيه خادم % تقضى الأمور به سوى مثقالي % % 8(@)(@@) % أترى الزمان يعينني بولاية % أحمي بها وجهي عن التسآل % % 9(@)(@@) % زحل يقارن حاجتي وقد انحنى % % ظهري من الهم انحناء الدال % % 10(@)(@@) % ما ضر إسماعيل غوث ذوي الرجا % % لو صانني عن هذه الأحوال % % PageV01P1531 11(@)(@@) % بشفاعة مقبولة تذر الغنى % % خبرا لمبتدإ الرجا في الحال % % 12(@)(@@) % أولست غرس ندى يديه فكيف لا % % يحيي الغراس بوابل هطال % % 13(@)(@@) % يا سيدا عمت صنائعه الورى % % بعوائد المعروف والافضال % % 14(@)(@@) % ما بعد ديمتك الروية ديمة 
ms342	 % % يشكو لها ظمأ ذوو الإقلال % % 15(@)(@@) % هذي شكاية مستغيث موجع % أنهى قضيته ورأيك عالي % % PageV01P1532 البحر : - 1(@)(@@) % ما للعذول على هواك ومالي % % أفدي بروحي من أحب ومالي % % 2(@)(@@) % يا مجريا دمعي وموقف لوعتي يا من اذا سألوه عن بدر الدجى والمسك قال أخي الشقيق وخالي % % من جسمي المضنى على اطلالسقط بيت ص % % 3(@)(@@) % رفقا بمن كحل الجفاء جفونه % % فغدا الكرى منها على أميال % % 4(@)(@@) % صب اذا ذكر العقيق وأهله % % نثر الدموع على هواه لآلي % % 5(@)(@@) % يروي الأمالي عن قلاك طويلة % % فالى متى يروي أمالي القالي % % 6(@)(@@) % وتقاتل العذال فيك وربما % % قوى جفاك مطامع العذال % % 7(@)(@@) % هيهات مانزلوا به الادعا % % بجبينك المشروق يا لهلال % % 8(@)(@@) % الطرف في ذاك الجبين منعم % والقلب من ذاك التجنب صالي % % 9(@)(@@) % ضدان مثل ندى ابن ريان الفتى % % لنزيله والبأس يوم نزال % % 10(@)(@@) % يهمي بصاب للعدو اذا طغى % % واذا الولي دعا همت بزلال % % PageV01P1533 11(@)(@@) % جاور سليمان المنيع جواره % % تأمن به من جنة الاهوال % % 12(@)(@@) % المعتلي رتبا يشيب لعجزه % % عن قدرها الاعلى عذار هلال % % 13(@)(@@) % والساتر الدنيا بذيل مكارم % % أحيت أواخرها فعال أوالي % % 14(@)(@@) % والطالب الاخرى بعزم للكرى % % يفني ويحيى بالسجود ليالي % % 15(@)(@@) % لا تتخذ بدلا لديه وعدة % % في هذه الدنيا من الابدال % % 16(@)(@@) % واقصد جنابي جاهه ونواله % % إن خفت حالي عسرة ونكال % % 17(@)(@@) % واقرأ على ريب الزمان براءة % % وعلى رجائك سورة الأنفال % % 18(@)(@@) % الاصل ريان فلا عجب اذا % % ما الفرع فآء على الورى بظلال % % 19(@)(@@) % لو لم تصح يمناه حي على الندى % % ما فاز ظام للندى ببلال % % 20(@)(@@) % هذا هو الشرف الذي بأقله % % ضرب القديم غرائب الامثال % % PageV01P1534 21(@)(@@) % رأي إلى طرق الرشاد مسدد % وسجية جبلت على الاجمال % % 22(@)(@@) % وفضائل وضحت وحلت رتبة % % فهي الكواكب في سنا ومنال % % 23(@)(@@) % ويراعة تذر الركائبي والعدى % % ما بين نزل مكارم ونزال % % 24(@)(@@) % من معطف المران فيه نسبة % % ولها جنى يعزى إلى العسال % % 25(@)(@@) % يا ماجدا أحيي مآثر قومه % % بمحامد أرخص نشر غوالي % % 26(@)(@@) % لله همتك الممكن رفعها % % ماذا جزمت بها من الافعال 
ms343	 % % 27(@)(@@) % وهباتك اللاتي تعجل رفدها % % ويجيب طالبها بغير سؤال % % 28(@)(@@) % لاعيب في نعماك إلا أنها % % مع عدلها ظلامة للمال % % 29(@)(@@) % تجنى عليه وانما تجنى به % % ثمر المحامد والثناء الغالي % % PageV01P1535 البحر : - 1(@)(@@) % من مبلغ علماء الاعصر الأول % % ان التفاصيل قد جمعن في الجمل % % 2(@)(@@) % تجمعت في فتى العليا ولا عجب % ان يجمع الله كل الناس في رجل % % 3(@)(@@) % قاضي القضاة الذي سارت مآثره % % بغير مثل يوازيها سوى المثل % % 4(@)(@@) % جمال ذي الأرض لازالت محاسنه % % عن أفقها وجمال الدين والدول % % 5(@)(@@) % من أنشر العلم من بعد الهمود ومن % % ضمت يداه المعالي وهو كالهمل % % 6(@)(@@) % من استقامت به الاوقات واعتدلت % % للناس قبل نزول الشمس في الحمل % % 7(@)(@@) % من لو أعارت حلاه المشتري شرفا % لم تعترضه عوادي النحس من زحل % % 8(@)(@@) % أما دمشق فقد فازت بما ارتقبت % % من طارف السعد أو من تالد الامل % % 9(@)(@@) % فليهنها أن راعي حكمها يقظ % بالعلم حكم لا بالسعي والحيل % % 10(@)(@@) % ليت ابن ادريس لاقى ابن الدروس بها % % لكان يملأ قلب الأم بالجذل % % PageV01P1536 11(@)(@@) % ليت القضاة الأولى عادوا لما فقدوا % % مواقع القلم المرعي بالمقل % % 12(@)(@@) % ماأوضح الحكم فيها عن إمام هدى % % بالعلم متزر بالحلم مشتمل % % 13(@)(@@) % لين الخلائق صعب البأس مانعه % % كأنه الجد بين السهل والجبل % % 14(@)(@@) % أغر لو كان منه في الهلال سنا % لم يستهل بسعد غير متصل % % 15(@)(@@) % و ظاهري الايادي غير خافية % وليس عن شيم العليا بمعتزل % % 16(@)(@@) % موكل بنقيات الأمور له % % إلى العلى عزم لا وان ولا وكل % % 17(@)(@@) % تزين العلم في عينيه حملها % % كل الدجى وحماها النوم في الكلل % % 18(@)(@@) % لم يكس في حلل العلياء يوسعها % % حتى لها عن قدود البيض في الحلل % % 19(@)(@@) % له صفات بها الأقلام راكعة % كأنها من قبيل الصحف في قبل % % 20(@)(@@) % سل علمه عن خفيات محجبة % وعن إحاطة أوصاف فلا تسل % % PageV01P1537 21(@)(@@) % مكارم لو رأى الطائي مسرحها % % لقال لا ناقتي فيها ولا جمل % % 22(@)(@@) % و منطق لو أراد الفخر غايته % % لبات بالري يشكو بارح الغلل % % 23(@)(@@) % و سؤدد يتدانى 
ms344	 من تواضعه % % ولو ترقت اليه الشهب لم تصل % % 24(@)(@@) % و فصل قول يلذ الخصم موقعه % حتى يود قضآء غير منفصل % % 25(@)(@@) % قالت يراعته والفكر يرشدها % % اصالة الرأي صانتني عن الخطل % % 26(@)(@@) % و أنشدت وبأرض الشام مركزها % % أعلى الممالك ما يبنى على القلل % % 27(@)(@@) % و عطلت كتبا في الدين مارقة % % فكل درع كتاب قد من قبل % % 28(@)(@@) % قد اختمت بيضة الاسلام والتحقت % % بعش أقلامه في الحادث الجلل % % 29(@)(@@) % كم سعادة علوم قد تقدمهم % % تقدمك السعي بالهادي على الكفل % % 30(@)(@@) % اذا قصصت على راو له خبرا % حلى من الذوق أو حلى من العطل % % PageV01P1538 31(@)(@@) % اذا شدا صوت عافيه ومادحه % % غدا وحاشاه مثل الشارب الثمل % % 32(@)(@@) % يا مالي البيت بيت الشعر من مدح % % وكان أقفر بالوعسآء من طلل % % 33(@)(@@) % يا من رأى جوده العافون منسرحا % فوجهوا العيس تطوي الرمل بالرمل % % 34(@)(@@) % ثنى امتداحك شعري عن عوائده % % فما بدأت بتشبيب ولا غزل % % 35(@)(@@) % هذا على أن لي عينا مسهدة % % للحب مخلوقة الانسان من عجل % % 36(@)(@@) % أستلمح البرق غربي الديار متى % % تقدح أشعته الأحشاء تشتعل % % 37(@)(@@) % و أستصح بمعتل الصبا جسدي % % وربما صحت الأجسام بالعلل % % 38(@)(@@) % و أذكر العيش مصقولا سوالفه % % اذ مصر داري وأحبابي بها خولي % % 39(@)(@@) % هيهات ذكرك أحلى في فمي وكلا % % كفيك لا ذوا اللمي أشهى إلى قبلي % % 40(@)(@@) % تشاغل الناس في لذات دهرهم % وأنت بالفضل والأفضال في شغل % % PageV01P1539 البحر : - 1(@)(@@) % كل حي قاض عليه زوال % % والى هذه السبيل مآله % % 2(@)(@@) % يا جلالا عن الزمان تقضى % % عز رب قضى وجل جلاله % % 3(@)(@@) % ما اقتضى حظنا بقاءك فينا % % واحدا تشمل الأنام ظلاله % % 4(@)(@@) % هاديا للندى وللعلم ترجى % % كل يوم أقواله وفعاله % % 5(@)(@@) % أين ذاك الغمام يدنو إلى النا % % س ندى كفه ويعلو مناله % % 6(@)(@@) % أين أحكامه وأين علاه % % أين أقلامه وأين نواله % % 7(@)(@@) % قف بقبر الامام يا نادب الفض % % ل وخل البكاء تهمي سجاله % % 8(@)(@@) % و انثر الدمع حول مثواه نثرا % مثل ما يثنثر الكلام ارتجاله % % 9(@)(@@) % ودع الشعر كان للشعر وقت % % بنداه 
ms345	 وقد تغير حاله % % 10(@)(@@) % و سلا الصب واستراح المعنى % % لا صباباته ولا عذاله % % PageV01P1540 11(@)(@@) % أقفرت ساحة العلى فبيوت الش % % عر من بعد بعده أطلاله % % 12(@)(@@) % آه للطالبين علما ورفدا % بعد ما غاض عزمه واحتفاله % % 13(@)(@@) % طالب العلم فيه للنحو نوح % لا تسل عنه كيف أصبح حاله % % 14(@)(@@) % طالب الجود مات من كان في الج % % ود تباري يمنى يديه شماله % % 15(@)(@@) % طالب العلم مطلقا خل عنه % % قيد العلم حزنه وكلاله % % 16(@)(@@) % مات من كان ملتقى كل قصد % والى الله قصده واتكاله % % 17(@)(@@) % عجبا من سريره يوم أودى % % كيفما أورقت ورقت ظلاله % % 18(@)(@@) % عجبا من زمانه حين ولى % % كيفما سيرت ودكت جباله % % 19(@)(@@) % صعدت روحه لأمثالها الزه % % ر وفي الأرض أين أين أمثاله % % 20(@)(@@) % فتهاوت كواكب الأفق تسعى % % وانحنى يبدأ السلام هلاله % % PageV01P1541 21(@)(@@) % و عدمنا نحن الندى ولقينا % % يتقاضى وفد الرجال جلاله % % 22(@)(@@) % ياله من مصاب دين ودنيا % % طال فينا اشتغاله واشتعاله % % 23(@)(@@) % شاب كالشيخ طفله وبكا الأش % % ياخ فيه كأنهم أطفاله % % 24(@)(@@) % ونعت مصر والشام إماما % طرزت مجد ذا وذاك خلاله % % 25(@)(@@) % كم مقام كما سمعت ملوكي % % ولديه تصرفت أفعاله % % 26(@)(@@) % كم بيمناه قصة قد اجيب % % وسؤول بها أجيب سؤاله % % 27(@)(@@) % كم قريب دعا به وبعيد % % وهو هام يد الندى هطاله % % 28(@)(@@) % كم أتتني مع الركاب لهاه % ووفت لي مع الزمان خصاله % % 29(@)(@@) % لو بقدر الأسى بكيت لسالت % % مهجة كم وفت لها أفضاله % % 30(@)(@@) % في سبيل العلى غمام تولى % % بعد ما أخصب الورى إقباله % % PageV01P1542 31(@)(@@) % هكذا عادة الزمان بنوه % % بسط ظل كما ترى وزواله % % 32(@)(@@) % و دفين على بقايا دفين % % مثل ما قال من سرت أمثاله % % 33(@)(@@) % كم إلى كم هذا التغافل منا % % عن يقين الردى وهذا التباله % % 34(@)(@@) % جاد يا قاضي القضاة ضريحا % كنت فيه غيث يسر انهماله % % 35(@)(@@) % و جزى الله جود كفك عنا % % وتولاك جوده ونواله % % 36(@)(@@) % لك منا نشر النسيم ثناء % % ولنا بالأسى عليك اعتلاله % % PageV01P1543 البحر : - 1(@)(@@) % بلغا القاصدين أن الليالي % % قبضت جملة العلى بالكمال % % 2(@)(@@) % وقفا 
ms346	 في مدارس النقل والعق % % ل ونوحا معي على الأطلال % % 3(@)(@@) % سائلاها عسى يجيب صداها % % أين ولى مجيب أهل السؤال % % 4(@)(@@) % أين ولى بحر العلوم وأبقى % % بين أجفاننا الدموع لآلي % % 5(@)(@@) % أين ذاك الذهن الذي قد ورثنا % % عنه مافي الحشا من الأشعال % % 6(@)(@@) % أين ذاك البحث الذي يحرس الح % % فل على غير أهبة واحتفال % % 7(@)(@@) % أين ملك الأقلام يوم انتصار % كعوالي الرماح يوم نزال % % 8(@)(@@) % ينقل الناس عن حديث هداها % % طرق العلم عن متون العوالي % % 9(@)(@@) % و تفيد الجنى من اللفظ حلوا % حين كانت نوعا من العسال % % 10(@)(@@) % أين تلك الأوصاف تنفح طيبا % رخصت عنه فنون الغوالي % % PageV01P1544 11(@)(@@) % يالها من رزية في حشا الاس % % لام من وقعها كحد النصال % % 12(@)(@@) % يالها وقعة على الرمل أبقت % % للبرايا لواعجا كالجبال % % 13(@)(@@) % نقصت بهجة الحياة فلا ين % % كر تأثير للنقص بعد الكمال % % 14(@)(@@) % و انطوى مبسم العلوم وأغضت % % مقلة البحث دونها والجدال % % 15(@)(@@) % و كحلنا الجفون بالسهد حتى % % بات منها الكرى على أميال % % 16(@)(@@) % أيها الراحل الذي عطلت من % % بعده القاصدون شد الرحال % % 17(@)(@@) % كنت غوث الوجود حقا ولكن % % ليس في الناس عنك من إبدال % % 18(@)(@@) % كنت دون الأنام عونا على خف % % ض حياة لنا بتمييز حال % % 19(@)(@@) % فليمت من يشا ويذهب من شآ % % ء فإنا بعدها لا نبالي % % 20(@)(@@) % كم ليمناك عندنا من أياد % ليس فيها لواصف من شمال % % PageV01P1545 21(@)(@@) % كم لها من فتوة وفتاو % قاضيات مآرب السوآل % % 22(@)(@@) % هي مثل الأطواق عند عفاة % وهي للملحدين كالأغلال % % 23(@)(@@) % غاب علم التفسير عنا وهمت % % كتب الفقه فيك بالأعوال % % 24(@)(@@) % و دموع الحديث سلسلها الحز % % ن وأنكى في القلب جرح النصال % % 25(@)(@@) % و أرى النحو واجما ليس منه % % قلب زيد وقلب عمر و بخال % % 26(@)(@@) % قصرت في الكلام مرتبة الأس % % ماء واعتل سائر الأفعال % % 27(@)(@@) % ليت شعري لمن أعزي على الخط % % ب وحال الأنام طرا كحالي % % 28(@)(@@) % أترى هل علمت يا ابن علي % أن دمعي من الأسى متوالي % % 29(@)(@@) % أنت في جنة النعيم مقيم % % وفؤادي 
ms347	 عليك بالنار صالي % % 30(@)(@@) % أنت جار للشافعي وقلبي % % مالكي الأهواء والأهوال % % PageV01P1546 31(@)(@@) % يا ضلالي من بعد ذاك المحيا % % وافتقاري من بعد ذاك النوال % % 32(@)(@@) % قربا مربط الكآبة مني % % نفحت حرب لوعتي من جمال % % 33(@)(@@) % لو نسيت الفضائل ما كن % % ت بناس صنائع الأفضال % % 34(@)(@@) % كيف أنسى ذاك الندى وهو عندي % % مستجد أمام عيني وبالي % % 35(@)(@@) % كيف أنشيء من المقال بديعا % زال من كان عارفا بمقالي % % 36(@)(@@) % زال عني ذاك الثنا فقضي قل % % بي فرض الاحزان عند الزوال % % 37(@)(@@) % و اعتزلت الورى وليس عجيبا % بعد ما مات قامع الاعتزال % % 38(@)(@@) % أي قلب لم يرم بعد سراه % % بفنون الأوجاع والأوجال % % 39(@)(@@) % أي دنيا يصفو لها أمل المر % % ء وهذي مصارع الآمال % % 40(@)(@@) % أي خلق من المنية يحمي % % وهي تسري إليه مسرى الخيال % % PageV01P1547 41(@)(@@) % أي تاج وللأهلة في الأف % % ق قسي ترمي الورى بنبال % % 42(@)(@@) % جاد مثواك يا محمد غيث % % باسم البرق مستهل الغزال % % 43(@)(@@) % و سلام على الفضائل في لح % % دك والفضل والندى والمعالي % % PageV01P1548 البحر : - 1(@)(@@) % برغمي أن غاض الندى بكماله % % فلم يبق الا زورة من خياله % % 2(@)(@@) % والا دموع من جفون كأنها % % ترد على مثواه فيض نواله % % 3(@)(@@) % أسفت لبدر بان عنه محمد % % فبان بمعنى حسنه وجماله % % 4(@)(@@) % وولى كما ولى السحاب مودعا % وفي كل روض نفحة من سجاله % % 5(@)(@@) % وزال وقد أبقى جواهر بحره % % ومات وقد أحيى مناقب آله % % 6(@)(@@) % ألا في سبيل الله مصرع ماجد % % تزيلت العلياء مثل زواله % % 7(@)(@@) % فقدناه فياض المكارم واللهى % % يشف ضياء المجد بين خلاله % % 8(@)(@@) % لئن قصرت أيدي الحوادث بعده % % لعهدي بها مغلولة بنكاله % % 9(@)(@@) % بروحي وصاح الصفات كأنما % % طبعن دراري الحسن بعد خصاله % % 10(@)(@@) % أما والذي أنشأ أياديه والحيا % % لقد فقد الظمآن صفو زلاله % % PageV01P1549 11(@)(@@) % وقد زال من أفق الأثير عن الورى % % سنا كوكب تسهو السها لمناله % % 12(@)(@@) % فمن للعلى يهدي سبيل رشادها % % ومن للرجا يمحو ظلام ضلاله % % 13(@)(@@) % و من ليراع قد أفاض مداده % % وجر من الأطراس ذيل خياله % % 14(@)(@@) % و من 
ms348	 لخطوط غاب بدر كمالها % % فهلا فداه الخط بابن هلاله % % 15(@)(@@) % و من لمعان في المهارق تجتلى % % بحلي وجوه الخود بين حجاله % % 16(@)(@@) % إلى الله اشكو يوم فقدك انه % % رمى كل عقل ناشط بعقاله % % 17(@)(@@) % و قوس من ثقل الرزية أظهرا % فلا غرو أن أصمى الحشا بنباله % % 18(@)(@@) % بكاك فقير رافع لك قصة % % نصبت على التمييز كسرة حاله % % 19(@)(@@) % و ممتدح لهفان يسألك الغنى % % أجرت معاني مدحه بسؤاله % % 20(@)(@@) % و مطلب كان ارتحالك قبله % % فعطلت الأيام شد رحاله % % PageV01P1550 21(@)(@@) % و عصر حلا جملت مرآه برهة % % وخلفته ينعي أتم رجاله % % 22(@)(@@) % كأنك لم تنهض باعباء دولة % % تكلف سعي الدهر فوق احتماله % % 23(@)(@@) % كأنك لم تحمل يراعا تمرها % % وتعضدها في سلمه وصياله % % 24(@)(@@) % و من عجب مقدار فرع يراعة % % وقد وسع الدنيا بفيء نواله % % 25(@)(@@) % كأنك لم تبسط بنان مؤمل % % يمين غوادي المزن دون شماله % % 26(@)(@@) % و ما هي الاهمة لك أنفذت % % وصاة رسول الله عند بلاله % % 27(@)(@@) % فأنفقت ما أحرزت بالبذل ذخره % % وما ذخر مال المرء غير ابتذاله % % 28(@)(@@) % عزاء العلى عن راحل بيد الردى % % وكل مقيم مؤذن بارتحاله % % 29(@)(@@) % و ما الدهر الاخيط فجر وليله % % يجران من شخص الفتى بانتقاله % % 30(@)(@@) % و اني وان احسنت سلوة فاقد % لمضمر شجو مثخن بنصاله % % PageV01P1551 31(@)(@@) % أينفذ عني الحزن بعد محمد % % وما استنفذت كفي نوافل ماله % % 32(@)(@@) % أأنسى له في كل جدب غمائما % تحث على رغم الحيا ومطاله % % 33(@)(@@) % أأنسى له في كل درج قلائدا % منظمة من رفده ومقاله % % 34(@)(@@) % سأبكيه ما لاح الظلام بظلمه % % وابكيه ما ناخ الحمام بضاله % % 35(@)(@@) % و ما أنا الا بالجميل مطوق % % أولى أسى لا كنت أن لم أواله % % 36(@)(@@) % صدحت له بالمدح عند لقائه % % وهذا أوان النوح عند زواله % % PageV01P1552 البحر : - 1(@)(@@) % فتحت لي بابا من الود ما % % عهدته يرضى بإهمالك % % 2(@)(@@) % فحبذاك اللغز من فاتح % % ودك لي من بعد إغفالك % % 3(@)(@@) % ألغزته في واقف خاضع % % كالعبد في تصريف أفعالك % % 4(@)(@@) % مافيه من عيب ويا طالما % % قد رده في حكمه 
ms349	 مالك % % 5(@)(@@) % لكن لي في وسطه غالبا % فرع أعاذ الله من ذلك % % 6(@)(@@) % لا الشعر والتوشيح أدرى ومن % % تصريعك استملي وأمثالك % % 7(@)(@@) % تخشى اذا أبصرته مرتجى % % فاعجب له في كل أحوالك % % 8(@)(@@) % أعجبني والله مع نظمه % % رضوانك المعهود يا مالك % % PageV01P1553 البحر : - 1(@)(@@) % ودعت بابك لا وداع القالي % % يا من لمدحي في علاه أمالي % % 2(@)(@@) % يا من سرت مدحي له فتزاحمت % % في الخافقين قصائري وطوالي % % 3(@)(@@) % لي سيرة المشغول في نعمائه % % إن لم تكن لي سيرة البطال % % 4(@)(@@) % يا مانحي غرر المواهب سبقا % % من قبل ما سبقت له آمالي % % 5(@)(@@) % يا خافضا بجواره عيشي فقد % % نضبت على التمييز صورة حالي % % 6(@)(@@) % يا من كبار بني شاموافضله % % فتطفلوا أن بلغت أطفالي % % 7(@)(@@) % دم يا ابن فضل الله في حلي الثنا % % والأجر كم زفت عليه معالي % % 8(@)(@@) % هذا نداك قلآئد الأعناق أو % % هذا ثناك خواتم الأعمال % % 9(@)(@@) % إن سرت لا ألقى مثالك في الورى % % قسما ولا يلقى ثناك مثالي % % PageV01P1554 البحر : - 1(@)(@@) % مرحبا بالحيا لكل جديب % لا عدمنا نواله وظلاله % % 2(@)(@@) % ملك الجود والثنا والمعالي % % والسجيات كلها والاصالة % % 3(@)(@@) % رقمت حلة الرياض فخلنا % % أن روضا قد استعار خلاله % % 4(@)(@@) % وابتغى الأفق للعلى فحسبنا % % أنه يفعل الجواد هلاله % % 5(@)(@@) % هو أزكى الأنام لا شك فيه % % يوم فخر وخيرهم لا محاله % % 6(@)(@@) % جاء من صيده السعيد كبدر % % ما رأى الطرف في السناء مثاله % % 7(@)(@@) % كم غزال رمى فلو أمكن الشم % % س من الخوف ما تسمت غزاله % % 8(@)(@@) % ولعمري لو استجار به الوح % % ش ثنى بعد مااستقلت نباله % % 9(@)(@@) % أيد الله ملكه ووقاه % % وحمى سربه وصان جلاله % % PageV01P1555 البحر : - 1(@)(@@) % أمولانا فلان الين رفقا % على ضعفي وسلمي واعتزالي % % 2(@)(@@) % رجوت على الليالي منك عونا % بحقك لا تكن عون الليالي % % 3(@)(@@) % أما والله لم يخطر بفكري % % حديث الغض منك ولا ببالي % % 4(@)(@@) % وكيف وأنت سباق البرايا % % وحسبي أنني لثناك تالي % % 5(@)(@@) % وأنك نعم من أعددت صحبا % اذا ما الصحب أضحوا مثل آل % % 6(@)(@@) % وبين خصالنا نسب وشيج % % من الآداب 
ms350	 رقام الخلال % % 7(@)(@@) % ولو عطف الوشاة على ضعيف % % إذا شهدوا بشكري واحتفالي % % 8(@)(@@) % رعاك الله راجع في رأيا % ولا تدحض حقوق فتى موالي % % 9(@)(@@) % وهبني كنت قد أخطأت فامنن % % بحلم إنه سبب المعالي % % 10(@)(@@) % وغمض إن أساء الخل عينا % تفد سنن الطريق ولا تبالي % % PageV01P1556 11(@)(@@) % نعم واستر ولو كالشمس ذنبا % فغايتنا الجميع إلى الزوال % % PageV01P1557 البحر : - 1(@)(@@) % معاطف أو مراشف دبل % % أحلى لممتارها من العسل % % 2(@)(@@) % يافوز من مات في وقائعها % % ما بين تلك العسالة الدبل % % 3(@)(@@) % ويا هنا من يضم مهجته % % على ولاء في ابن الامام علي % % 4(@)(@@) % قاضي القضاة الذي مواهبه % % قد خلقت للرجاء من عجل % % 5(@)(@@) % لا عيب في جوده سوى نعم % تحرم بالسبق لذة الأمل % % 6(@)(@@) % كم وقعة لي مع الزمان وقد % % دفعت عني كوقعة الجمل % % 7(@)(@@) % فسر بايضاح معربات سنا % % وعد لبذل الصلات بالجمل % % PageV01P1558 البحر : - 1(@)(@@) % سرت لحسنك في العشاق أمثال % % ومالحسنك يا معشوق أمثال % % 2(@)(@@) % حوالة الصب قد أعيت وحيلته % % على لقاك فقل لي كيف أحتال % % 3(@)(@@) % تقسمت فيك يا جيد الغزال وفي % % مدح الدوادار أمداح وأغزال % % 4(@)(@@) % رسم بباب الحمى العزي مكتتب % % قابل حماه وقل عز وإقبال % % 5(@)(@@) % قد علم الله في أقلام راحته % وبالسيوف فأرزاق وآجال % % 6(@)(@@) % يا سائد الملك بالآراء يعلمها % % لا جيش يسعى مساعيها ولا مال % % 7(@)(@@) % هنئت فوزك دنيا ثم آخرة % % فقد زكت لك في الدارين أعمال % % PageV01P1559 البحر : - 1(@)(@@) % ونشيطة الأعطاف إلا أنها % % بجفونها لثياب سقمي تغزل % % 2(@)(@@) % بيتان من قلبي ونظمي ذالها % % متغزل سكنت وذا متغزل % % 3(@)(@@) % ودموع قيس قيس دمعي بعدها % % كالبحر عند ندى محمد جدول % % 4(@)(@@) % ملك سما ونما وجاد على الورى % % فليجتنوا وليجتدوا وليجتلوا % % 5(@)(@@) % يا أيها الملك البسيطة أبحرا % أهل الندى وهو البسيط الأول % % 6(@)(@@) % أهلا بمقدمك السعيد وحبذا % % عيش على رغم الأعادي مقبل % % 7(@)(@@) % طلع الهلال ويمن وجهك للورى % % يتفاضلان وأنت أنت الافضل % % PageV01P1560 البحر : - 1(@)(@@) % قالت وفي صدر نار القلب منزلها % % يا ليت أنك لم تكرم به نزلي % % 2(@)(@@) % مليحة إن تكن في حسنها 
ms351	 صنما % فيا عذولي لا بوركت من هبلي % % 3(@)(@@) % فيها وفي مدح أوفى السائدين علا % تقسم الشعر في مدح وفي غزل % % 4(@)(@@) % دم للعلى يا ابن فضل الله مرتقيا % أفق المعالي وقد أربى على الأول % % 5(@)(@@) % يا من عرفت به كسب الالوف ومن % % تمامها أنها جاءت ولم أسل % % 6(@)(@@) % لم يبق جودك لي شيئا أؤمله % % تركتني أصحب الدنيا بلا أمل % % 7(@)(@@) % كل الكفاة ذوي الآراء ماثلة % % مثل السيوف ولكن ذو الفقار علي % % PageV01P1561 البحر : - 1(@)(@@) % مبلل أصداغ أثارت بلابلي % % وجرت هوى عشاقها بالسلاسل % % 2(@)(@@) % ومشمش بستان ثرياه أشرقت % % وأين الثريا من يد المتناول % % 3(@)(@@) % بلى أن تصافح بالرجا يد أحمد % تصافح ثرياها يد المتطاول % % 4(@)(@@) % كريم شكت بمنى الغيوث شماله % % فيالك من غيث كريم الشمائل % % 5(@)(@@) % مقسمة جدواه بين فواضل % لمداحه تهدي وبين فضائل % % 6(@)(@@) % تعلمهم نظم الثنا مبدعاته % % فيا لعقول حثها بعقائل % % 7(@)(@@) % على السبعة السيارة امتاز فضله % % فلا زال ذا طول عليها وطائل % % PageV01P1562 البحر : - 1(@)(@@) % يا آل أيوب سقتكم % سحب الرضا تحت الضرائح وبلها % % 2(@)(@@) % لهفي على أوقات ملك أسبغت % % نعماكم فوق البرية ظلها % % 3(@)(@@) % ما كان أقوى في العداة أشدها % % بأسا و أعلى في النجوم محلها % % 4(@)(@@) % وفدى لكم متسرع أنحى على % % أموالكم فأزالها وأذلها % % 5(@)(@@) % كم أنشدت من بعدها أيديكم % % ما كان أكثرها لنا وأقلها % % 6(@)(@@) % ناديت ساحتكم وقلت لصاحبي % % ما كان أسرع للمنادى فضلها % % 7(@)(@@) % فدنا وقال لعلها معذورة % % من بعد أهليها فقلت لعلها % % PageV01P1563 البحر : - 1(@)(@@) % أترى يقضي بكم أملي % % قبل ما يقضي بكم أجلي % % 2(@)(@@) % أيها الغياب بعد جفا % % ما على هجرين من قبل % % 3(@)(@@) % في سبيل الله دمع فتى % مسرع الاجفان من همل % % 4(@)(@@) % لا تلم إنسان مقلته % % خلق الانسان من عجل % % PageV01P1564 البحر : - 1(@)(@@) % خذ العدس المشتهى مأكلا % % وكن يا أخا الجود نعم الأكيل % % 2(@)(@@) % فلو لم تكن عندي المعتلى % % لما جدت منه بهذا الجليل % % 3(@)(@@) % وأقسم لولاك يا سيدي % % عدمت الصديق وحق الخليل % % PageV01P1565 البحر : - 1(@)(@@) % بعين الله يسري ثم شكري % % لبرك وابتهاجي وابتهالي % % 2 
ms352	(@)(@@) % قبضت من الكمال نداك صفوا % بريئا من سؤال أو مطال % % 3(@)(@@) % فيا لله من عادات بر % أتتني بالتمام وبالكمال % % PageV01P1566 البحر : - 1(@)(@@) % لقد كنت أرجو في صباي وصبوتي % % مغازلة الغر القوافي التي تحلو % % 2(@)(@@) % فلما انقضى عصر الشباب وشارفت % % منية مثلي ما لها في الورى مثل % % 3(@)(@@) % فجاءت بدرج عند ما أنا دارج % % وجاءت بوصل حيث لا ينفع الوصل % % PageV01P1567 البحر : - 1(@)(@@) % رب صديق كلغز سيدنا % % بخالص الود ثم ينتقل % % 2(@)(@@) % كدرهم وجهه يشف عن النق % % د خلاصا وقلبه زغل % % PageV01P1568 البحر : - 1(@)(@@) % ألا يا حسنها فرجية من % % فراجي الفخر كانت م الطوال % % 2(@)(@@) % رأى الخياط صافية شمولا % صفاء بياضها فأدارها لي % % PageV01P1569 البحر : - 1(@)(@@) % تركت للفظ الحاجبية رونقا % له لا لالفتاظ الأوائل تقبل % % 2(@)(@@) % اذا كتب النحو استمالت عيوننا % % أبينا وقلنا الحاجبية أول % % PageV01P1570 البحر : - 1(@)(@@) % أمولاي ما إسم جلي إذا % % تعوض عن حرفه الأول % % 2(@)(@@) % لك الوصف من شخصه سالما % فان قلعت عينه فهو لي % % PageV01P1571 البحر : - 1(@)(@@) % فقدت أخلائي الذين سألتهم % % دوام الوفا إن الوفا قليل % % 2(@)(@@) % وإن افتقادي واحدا بعد واحد % % دليل على أن لا يدوم خليل % % PageV01P1572 البحر : - 1(@)(@@) % هنئت ما أوتيته من دولة % % حملتك في العينين من إجلالها % % 2(@)(@@) % في مقلة الأجفان أنت فقل لنا % % أنت ابن مقلتها أم ابن هلالها % % PageV01P1573 البحر : - 1(@)(@@) % إن الإمامين مد الله ظلهما % % تواردا في الندى والعلم والعمل % % 2(@)(@@) % كلاهما قد علا في العالمين فلا % % عدمت من ذا وذا جاه الإمام علي % % PageV01P1574 البحر : - 1(@)(@@) % بأبي نافرا كثير الدلال % % إن هذا النفار شأن الغزال % % 2(@)(@@) % حبذا مقلة لست أدري % % أبهدب تصول أم بنبال % % 3(@)(@@) % صنفت شجونا بغزال جفن % % فقرأنا مصنفا للغزالي % % 4(@)(@@) % وهوينا حلو القوام فنادى % % لا عجيب حلاوة العسال % % 5(@)(@@) % ما رأى الناس قبله قيد رمح % أطلع الشمس في ظلام الليالي % % 6(@)(@@) % تلك منه ذوائب لست أنف % % ك بآفاق جنحها في ضلال % % 7(@)(@@) % عشقته مثلي وخافته خوفي % % فاستجارت لديه بالأذيال % % 8(@)(@@) % من معيني على الهوى زاد حتى % % أهملته نصائح العذال % % 9(@)(@@) % في جمال الحبيب مت شجونا 
ms353	 % وبروحي أفدي تراب الجمال % % PageV01P1575 البحر : - 1(@)(@@) % نقب على ودي الجميل % % وقنع الضب بالقليل % % 2(@)(@@) % كليم قلبي عليك يكوي % % بنار حبيك يا خليلي % % 3(@)(@@) % يا مصر أما بشمس حسن % % أو شمس علم لي استميلي % % 4(@)(@@) % شمس هدى لا تزال منه % % تظهر في طالع جميل % % 5(@)(@@) % بسيط بحر الندى مديد % % كامل بحر الثنا طويل % % 6(@)(@@) % رجاي في بره سمين % % كالفيل لا كالرجا النحيل % % 7(@)(@@) % يضمن لي رفده المهنى % % يا لك من ضامن كفيل % % PageV01P1576 البحر : - 1(@)(@@) % بروحي ممنوع اللقا غير أنني % % أواصل بالتنجيم والفكر شكله % % 2(@)(@@) % و أقسم من خديه والثغر بالضحى % % وبالفجر ما أبصرت في العصر مثله % % 3(@)(@@) % و ما أبصرت عيناي من وارث العلى % % كناصر دين الله يبسط فضله % % 4(@)(@@) % أميرا اذا قابلت وصفا ونسبة % % ترى الفضل مأثور الصفات ونجله % % 5(@)(@@) % ترى عمري المنتمى عدويه % % ففيه المعالي تتبع الفرع أصله % % 6(@)(@@) % أمولاي إن أهلتني لعناية % فما زلت بالمعروف والشكر أهله % % 7(@)(@@) % فديناك من أصل ببطحاء مكة % % وفرعا على الأقطار قد مد ظله % % PageV01P1577 البحر : - 1(@)(@@) % بيت امتداحي ثم بيت ممدحي % % يا بيت عاتكة الذي أتغزل % % 2(@)(@@) % هذا وذاك وذا أحاول صده % % حذر العدى وبه الفؤاد موكل % % 3(@)(@@) % و يميل عني من يصد وأنني % % قسما اليه مع الصدود لأميل % % 4(@)(@@) % فليهنه الشهر الأصم عرفته % % عند المدائح مصغيا يتهلل % % 5(@)(@@) % بالرغم أن يصغى لشكوى اليوم من % % حظ تقول به الهموم وتفعل % % 6(@)(@@) % و يردني عن باب ساداتي امرؤ % % مفتاح بابهم لمثلي أمثل % % 7(@)(@@) % و أبيك يا ابن علي ان تشوقي % % من تحت قلبي المستهام ومن عل % % PageV01P1578 البحر : - 1(@)(@@) % ليهن بدر الحسن في حلة % % تعذيب قلبي وهو في حل % % 2(@)(@@) % و ليهن سمعي عند حلو اسمه % % ما كرر العذال من عذلي % % 3(@)(@@) % و ليهن شهر الصوم أتقى الورى % % وليبق ما شاء بلا مثل % % 4(@)(@@) % إمام أعلام الهدى والندى % % قاضي قضاة الفضل والفصل % % 5(@)(@@) % أقسم في الأنفال من بره % % وكثرة الطلاب كالنمل % % 6(@)(@@) % في العلم والنسبة ما مثله % % في رده الفرع إلى الأصل % % PageV01P1579 البحر : - 1(@)(@@) % خليلي 
ms354	 والشواق تروي حديثها % % دموع الأسى من مرسل ومسلسل % % 2(@)(@@) % على نازل بالقلب مرتحل به % % قفا نبك من ذكرى حبيب ومنزل % % 3(@)(@@) % و الا انظرا من خاله فوق خده % % إلى خير نار عندها خير مصطل % % 4(@)(@@) % سبكت بها ودي فصح كأنه % % سجايا بني السبكي للمتأمل % % 5(@)(@@) % أولئك ساداتي الذين هم هم % غياث المرجى عصمة المتوسل % % 6(@)(@@) % لقاضي قضاة المسلمين عليها % % ندى ويد كالبارق المتهلل % % 7(@)(@@) % امام لنا من اسمه وسماته % % سيول من الأرزاق تنحط من عل % % PageV01P1580 البحر : - 1(@)(@@) % فتانة الصب تجلى في حماه فيا % % لها غزالة أفق في منازله % % 2(@)(@@) % حتى اذا سحبت مثنى ذوائبها % % فيا لها من غزال في حبائله % % 3(@)(@@) % من لحظها وتثني غصن قامتها % % لا تسألوا من فؤادي عن بلابله % % 4(@)(@@) % إن أقبل الوجه أشكو جور ناظره % % أو أقبل القد أشكو جور عادله % % PageV01P1581 البحر : - 1(@)(@@) % قاضي القضاة عليها وتقيها % % مالي على خلق سواك معول % % 2(@)(@@) % سبق اعتناؤك في نوالك لي فما % % أنفك في هذا وذا أتأمل % % 3(@)(@@) % فمن الحوالة لي ربيع آخر % % ومن المواهب لي ربيع أول % % 4(@)(@@) % لازلت ذا فضل يطل على الورى % % وعلى الكواكب من علي ومن عل % PageV01P1582 البحر : - 1(@)(@@) % يا أيها العالم الفرد الوزير ومن % % أرجو نداه اذا جافاني الأمل % % 2(@)(@@) % و عاقني عن نداك الصاحبي وعن % % رسمي من العيد وحل ليس يحتمل % % 3(@)(@@) % و فاتني صحن حلو والشواء فلا % % شمس لمطلع آمالي ولا حمل % % 4(@)(@@) % عش للمفصل من حمد يقال اذا % % بدا على مثل هذا تنفق الجمل % % PageV01P1583 البحر : - 1(@)(@@) % يا اماما صفاته % % ذات فضل مكمل % % 2(@)(@@) % دم جمالا لمخبر % % وحياة لمجتلي % % 3(@)(@@) % يرجم الفقر من ندا % % ك برفد معجل % % 4(@)(@@) % حجر من دراهم % % حطه السيل من عل % % PageV01P1584 البحر : - 1(@)(@@) % هنئت بالنعم الجميلة % % يا صاحب النعم الجزيله % % 2(@)(@@) % ست تخبرنا النقا % % أنها ست جليله % % 3(@)(@@) % و كذاك ألف مثلها % % فاهنأ بعقباها الكفيلة % % 4(@)(@@) % و ديار ضدك ذمته % % وسيوف حيلته كليله % % PageV01P1585 البحر : - 1(@)(@@) % و أزهر وضاح الصفات عليها % % مدحت به المدح الذي أنا قائله % % 2(@)(@@) % يقولون 
ms355	 ماذا من أياديه ترتضي % % فقلت التي تضى لمثلي نوافله % % 3(@)(@@) % أقدم اسمي مصدرا في مديحه % % ويفعل صوب الغيث ما هو فاعله % % 4(@)(@@) % و ما البر الا مانوته هباته % % لعاف ولكن اهنأ البر عاجله % % PageV01P1586 البحر : - 1(@)(@@) % أسعد الدين والدنيا بقطف % % على من كنت تغمر بالنوال % % 2(@)(@@) % رجوت على الليالي منك عونا % بعيشك لا تكن غوث الليالي % % 3(@)(@@) % و لا تسعف ولا تسعف بأمر % ولكن لا علي إذا ولا لي % % PageV01P1587 البحر : - 1(@)(@@) % يا واحدا في المعالي % % تهوى المعالي جماله % % 2(@)(@@) % دم في مراتب فضل % % عضدت فيها الأصاله % % 3(@)(@@) % فلم تقم بكلال % % ولم ترث عن كلاله % % PageV01P1588 البحر : - 1(@)(@@) % بقيت ابن فضل الله مفردا % كشهرك أو شعري الذي لك قائله % % 2(@)(@@) % فلو أنني ضمنت بيتا لمبدع % % قديما لقال الناس إني قائله % % 3(@)(@@) % أقول لفقري مرحبا لتيقني % % بأن عليا بالمكارم قاتله % % PageV01P1589 البحر : - 1(@)(@@) % يا أيها الملك المربى برؤيته % % عن كل فضل سمعناه من الأول % % 2(@)(@@) % كم جملة وصلت لي من نداك وكم % % تفيصلة ألبستني أجمل الحلل % % 3(@)(@@) % لقد غدت فكر الأمداح جائزة % % بين التفاصيل من نعماك والجمل % % PageV01P1590 البحر : - 1(@)(@@) % شكرا تقي الدين للمنن التي % % رفعت على حامي حماك ظلالها % % 2(@)(@@) % لله أنت فقد وصلت إلى مدى % % في الفضل أعيي السائدين مثالها % % 3(@)(@@) % وغدوت وجها مثل خالك في الورى % % يا حبذا وجه الأنام وخالها % % PageV01P1591 البحر : - 1(@)(@@) % يا سيد الوزراء لا مستثنيا % في فضله أحدا ولا إفضاله % % 2(@)(@@) % فقد كنت ترحم قبلها حال امريء % % متغرب تدري حقيقة حاله % % 3(@)(@@) % حاشا لشمسك أن ترد مؤملا % عن أفقها يشكو انقطاع حباله % % PageV01P1592 البحر : - 1(@)(@@) % ماذا أقول اليوم ان أكثر الع % % الم عن جودك تسآلي % % 2(@)(@@) % وقيل هل أجدى المديح الذي % % حبرته في مجده العالي % % 3(@)(@@) % ان قلت لا كذبني الناس أو % % قلت نعم كذبني حالي % % PageV01P1593 البحر : - 1(@)(@@) % يا اماما قال المقلد والعا % % لم فيه بواجب التفضيل % % 2(@)(@@) % ما على عاشق يقول على حك % % م التداوي بالضم والتقبيل % % 3(@)(@@) % لا كمن تنتحي بمعشوقه النح % % و فمن فاعل ومن مفعول % % PageV01P1594 البحر : - 1 
ms356	(@)(@@) % مولاى كم من شذرة نظمت في % % معنى وليس لها اليك وصول % % 2(@)(@@) % قسما ببيتك في المعالي إنني % % أولى ببيت سواي حيث يقول % % 3(@)(@@) % يا بدر حسادي عليك كثيرة % % والمسعدون على هواك قليل % % PageV01P1595 البحر : - 1(@)(@@) % الحمد لله اذ زمان % حلا لنا بالهنا جلاله % % 2(@)(@@) % بكافل للرجا وزير % يرضع أبناءنا نواله % % 3(@)(@@) % فحبذا بره رضاعا % وحبذا رأيه كفاله % % PageV01P1596 البحر : - 1(@)(@@) % سقيا للحدك يا علي فانه % % لحد الرئاسة والثنآء العالي % % 2(@)(@@) % مالي ونظم القول بعدك في الورى % % ذهب المقال فلات حين مقالي % % 3(@)(@@) % لا زال قلبي رافضي تصبر % أسفا عليك ومدمعي متوالي % % PageV01P1597 البحر : - 1(@)(@@) % شكوت وبالشكوى إلى غير راحم % تعذر مني للمراد حصول % % 2(@)(@@) % وصولات قوم بالكثير تقسمت % % لديكم ومالي لي وصول % % 3(@)(@@) % خضبت مشيبي بالدموع فما به % % ولكن بقلبي للهموم نصول % % PageV01P1598 البحر : - 1(@)(@@) % يا سيدي يا صلاح الدين لا صلحت % % ان أنس برك أفكاري ولا حالي % % 2(@)(@@) % يا من جفاني فلفظي بعد جفوته % % وجيد قصدي لا حلو ولا حالي % % 3(@)(@@) % ان لم يعدلي فلا صاد الحروف ولا % % لام معانقة فيها ولا حا لي % % PageV01P1599 البحر : - 1(@)(@@) % خذ من عبيدك مقتضى نياتها % % في الحمد واعذر مقتضى أقوالها % % 2(@)(@@) % قسما لو اسطاعت اليك جسومهم % % بعثت دروج المدح من أوصالها % % PageV01P1600 البحر : - 1(@)(@@) % تأملت من بعد الصبا خال وجنة % لغيداء لم أطمع بعود وصالها % % 2(@)(@@) % وكنت أخا سعدي فأصبحت عمها % % فهيهات لي جد بتقبيل خالها % % PageV01P1601 البحر : - 1(@)(@@) % ولي رقيب اذا مالحب واصلني % % قرينه قلت ليت الحيب لم يصل % % 2(@)(@@) % يقول تنقيل مرآه وسرعته % % سبحان من خلق الانسان من عجل % % PageV01P1602 البحر : - 1(@)(@@) % يا حبذا يومي بوادي جلق % وفرجتي مع الغزال الحالي % % 2(@)(@@) % من أول الجبهة قد قبلته % % مرتشفا لآخر الخلخال % % PageV01P1603 البحر : - 1(@)(@@) % آها لحاذق ذهن % يقول في العشق من ولي % % 2(@)(@@) % قال العذار لحدقي % % ما أنت من خل بقل ي % % PageV01P1604 البحر : - 1(@)(@@) % تجلدت كتب التاريخ ثم شكت % % من خجلة خير تاريخ لخير ولي % % 2(@)(@@) % تكاد إن نظرت هذي المحاسن أن % % تموت في جلدها من شدة الخجل % % PageV01P1605 البحر : - 1 
ms357	(@)(@@) % سبحان من وكل بي مشفعا % تاجا على رأسي عطاه الجميل % % 2(@)(@@) % وكلته في كل ما أرتجي % % وحسبي الله ونعم الوكيل % % PageV01P1606 البحر : - 1(@)(@@) % سعيت في حب هيفا % % تحلو وتكوي طفيله % % 2(@)(@@) % وقيل عين لها اسما % فقلت ستي بخيله % % PageV01P1607 البحر : - 1(@)(@@) % وغادة أنحل جسمي خصرها % % وكان جسمي قبل مرآها نحيل % % 2(@)(@@) % وطولت همل بطول شعرها % % فقلت ذا يا شعرها هم طويل % % PageV01P1608 البحر : - 1(@)(@@) % أفدي مليحا أسودا فاح شذا % % مسك لنا فقاعه وشكله % % 2(@)(@@) % كأنه نادي على حليته % % فقال فقاعي مسك كله % % PageV01P1609 البحر : - 1(@)(@@) % أقول لعثمان الأديب وقد صبا % % لأرداف من يهواه بعد اعتزالها % % 2(@)(@@) % وقد ساقها من بعد ما قد تغيرت % % وقد هزلت حتى بدا من هزالها % % PageV01P1610 البحر : - 1(@)(@@) % إمام دين الله سمعا لمن % % أبعدتموه وهو باقي الوله % % 2(@)(@@) % لو سرت ميلا عنك لم تتخذ % % عيني سوى إحسانكم مكحله % % PageV01P1611 البحر : - 1(@)(@@) % من أدب النفس أن يوقر مو % % لانا بتدبيره الجليل علا % % 2(@)(@@) % وإنما المفترون قد حفظوا % % تلجي الضرورات في الامور إلى % % PageV01P1612 البحر : - 1(@)(@@) % يا عاتبين ولا والله أذكرهم % % إلا بخير وإن مالوا علي ولي % % 2(@)(@@) % شويت يا مهجتي إن كنت عاتبهم % % وإن وجدت لسانا قائلا فقلي % % PageV01P1613 البحر : - 1(@)(@@) % عمامتي كبرتها غالطا % فقيل لي باردة جزله % % 2(@)(@@) % كبيرة فتاضت على جبهة % قلت نعم مع أنها سهله % % PageV01P1614 البحر : - 1(@)(@@) % تصدق برفد على السائلي % % ن ما كان يمكن رفد جميل % % 2(@)(@@) % ولا تأمنن عروض الزمان % % فان الزمان فعول فعول % % PageV01P1615 البحر : - 1(@)(@@) % عرج على قبل الكمال وقل له % % سحبت عليك السحب من أذيالها % % 2(@)(@@) % قسما لقد نقصت وأعوزت العلى % % يا شوقها لتمامها وكمالها % % PageV01P1616 البحر : - 1(@)(@@) % واحربا من هوى رشيق % % معذر كالقضيب مائل % % 2(@)(@@) % عذاره لا يغيث دمعي % % وسائل لا يجيب سائل % % PageV01P1617 البحر : - 1(@)(@@) % من كان هفواته متنصلا % في باب عزكم فما اتنصل % % 2(@)(@@) % أظهرت اذ أذنبت فضل حلومكم % % فأنا امرؤ بذنوبه يتوسل % % PageV01P1618 البحر : - 1(@)(@@) % يارب إن ابني وشعري كما % % تراهما في حالة حائله % % 2(@)(@@) % الشعر محتاج إلى قابل % % والإبن محتاج إلى قابله % % PageV01P1619 البحر : - 1(@)(@@) % يقول بيت 
ms358	 المال لما رأى % % تدبير مولانا الجلي الجليل % % 2(@)(@@) % الله أعطاني وكيلا رضى % فحسبي الله ونعم الوكيل % % PageV01P1620 البحر : - 1(@)(@@) % يا رب ليل بته متنعما % % برشيقة تغني بردف مثقل % % 2(@)(@@) % إيري بجانب كسها في جحرها % % عرف المحل فبات دون المنزل % % PageV01P1621 البحر : - 1(@)(@@) % يا عاذلي لست مثلي في هوى وجوى % % فخل بالله عن لومي وعن عذلي % % 2(@)(@@) % أضحى لريان ردف قد علا وربا % % يا حيبذا جبل الريان من جبل % % PageV01P1622 البحر : - 1(@)(@@) % لا تخف عيلة ولا تخش فقرا % % يا كثير المحاسن المختاله % % 2(@)(@@) % لك عين وقامة كل يوم % % تلك غزالة وذي فتاله % % PageV01P1623 البحر : - 1(@)(@@) % قاضي القضاة جمعت للزهد الندى % % فعدوت في الحالين تبعث بالولي % % 2(@)(@@) % تأتي هباتك كالسيول لنا ولا % % عجب لسيل حين يأتي من عل ي % % PageV01P1624 البحر : - 1(@)(@@) % صدق الذي قد سار في أمثاله % % بيت بديع النظم في أقواله % % 2(@)(@@) % واذا امرؤ أسدى اليك صنيعة % % من جاهه فكأنها من ماله % % PageV01P1625 البحر : - 1(@)(@@) % يا كاتب الخاص ويا شاعرا % أصبح بالآداب يختال % % 2(@)(@@) % حوالتي قد أعجزت حيلتي % % فانهض عسى ينجح محتال % % PageV01P1626 البحر : - 1(@)(@@) % أمين العلى والعلم دعوة ناشيء % بيتك تلقى تلقى حيثما كان فضله % % 2(@)(@@) % أبوك بأرض الشام أصل إقامتي % % فأكرم مقاما كان أصلك أصله % % PageV01P1627 البحر : - 1(@)(@@) % حلوا بعقد الحسن أجيادهم % % وحاولوا صبري حتى استحال % % 2(@)(@@) % فآه من عاطل صبر مضى % % والحمد لله على كل حال % % 3(@)(@@) % أيا حسنا قد هوى شائبا % لقد بتما والهوى مشكل % % 4(@)(@@) % فلو بتما عند قدريكما % % لبت وأعلا كما الاسفل % % 5(@)(@@) % بروحي خليلا لم أجد مع صدوده % % إلى القلب عنه سلوة تتخلل % % 6(@)(@@) % ويعلم بأسي من جميل وفائه % % فما ضره بالقول لو يتجمل % % 7(@)(@@) % أتاني علي الباسي بشعره % % فيا لك من شعر ثقيل مطول % % 8(@)(@@) % مكر مفر مدبر مقبل معا % كجلمود صخر حطه السيل من عل ي % % 9(@)(@@) % يداوي أسى العشاق من نحو أرضكم % % نسيم صبا أضحى عليه قبول % % 10(@)(@@) % بروحي من ذاك النسيم اذا سرى % % طبيبا يداوي الناس وهو عليل % % PageV01P1628 11(@)(@@) % مبقل الخد قالوا % % فقلت ما ذاك يسلي % % 12 
ms359	(@)(@@) % هذا الزمرد حقا % ماذي حوائج بقلي % % 13(@)(@@) % لا أرى لي في الشام بعد مادعى % % أحبتي وسادتي الرحيل % % 14(@)(@@) % وكيف أختار المقام في حمى % لا صاحب فيه ولا خليل % % 15(@)(@@) % سألت الحلال فأعطى وقد % % سألناك يا من عليه يدل % % 16(@)(@@) % وأنت في الدولة ابن المعز % فلا تقصرن عن ابن الاجل % % 17(@)(@@) % شهاب الدين يا غوث الموالي % % ومن حاز الثنا والفضل كله % % 18(@)(@@) % أغث قوما إلى البطيخ أمسوا % % قياما يسألون عن الأهلة % % 19(@)(@@) % يفديك عبد مودة % أسليته عن أهله % % 20(@)(@@) % وكتبت عهدة رقه % % بالمكرمات فحله % % PageV01P1629 21(@)(@@) % علي ديون من ثا لم أقم بها % % فيا عجبا لي في ازدياد من الفضل % % 22(@)(@@) % وأعجب من ذا أنك الشمس أشرقت % % وها أنا منها حيثما كنت في ظل % % 23(@)(@@) % أرسلت بعدكم بجهد نحوكم % % جبنا فيا خجلي ويا جهلي % % 24(@)(@@) % وبخلت عن مفروض حقكم % فجمعت بين الجبن والخل % % 25(@)(@@) % يا متقنا علم الشريعة والندى % % أنت الأحق بما يقول الأول % % 26(@)(@@) % تجب الزكاة على الذين وعدتهم % % وعدا فانهم بذاك تمولوا % % 27(@)(@@) % يا دهر رفقا فما أبقيت لي أملا % في ثروة أتمناها ولا جذل % % 28(@)(@@) % قطعت باليأس آمالي لديك فقد % % تركتني أصحب الدنيا بلا أمل % % 29(@)(@@) % أهلا بسائرة الصبا من نحوكم % % وبما عهدنا من تعاهد طولها % % 30(@)(@@) % أملت على الزهر المقطب ذكركم % % حتى تبسم ضاحكا من قولها % % PageV01P1630 31(@)(@@) % غاب الوزير وكان العطف شيمته % % وجئت نعم أمير بالرجاء ملي % % 32(@)(@@) % فشيبة الحمد عندي والولاء معا % حقان بين أبي بكر وبين علي % % 33(@)(@@) % بقلت وجنة المليح وقد ول % ى زمان الضنا الذي كنت أملك % % 34(@)(@@) % يا عذار المليح دعني فاني % % لست في ذا الزمان من خل بقلك % % 35(@)(@@) % يا ابن النبوة والفتوة والتقى % % عذرا لمعلوم الولا لا يجهل % % 36(@)(@@) % كم بيت مدح قلت فيك لنظمه % % يا بيت عاتكة الذي أتغزل % % 37(@)(@@) % دامت صلاة الحمى الزيني واصلة % % كأن احسانها نصبا على الحال % % 38(@)(@@) % ولا برحنا وان شط المزار بنا % % من هالة البدر معنى في ابن منهال % % 39(@)(@@) % يا فتى العليا وصاحبها % % ما 
ms360	 ترى في واثق الأمل % % 40(@)(@@) % تاليا إنسان مقلته % % خلق الانسان من عجل % % PageV01P1631 41(@)(@@) % رأينا تواقيع تاج العلوم % % على قصص ذات وصف جلي % % 42(@)(@@) % بنسك وجود وخط أجاد % % فقلت الثلاثة خط الولي % % 43(@)(@@) % يا صاحبي لك من سقم ومن كبر % عنق متين وفي الخدين تسهيل % % 44(@)(@@) % وطلعة شمل الخيلان وجنتها % % فعمها خالها قوداء شمليل % % 45(@)(@@) % سار الأمير علي في كفالته % % لمأمن الدهر سير الانزع البطل % % 46(@)(@@) % فنحن في الفضل ماضيه وحاضره % % نروي الثنا عن أمير المؤمنين علي % % 47(@)(@@) % وضعت سلاح الصبر عنه فما له % % يقاتل بالالحاظ من لا يقاتله % % 48(@)(@@) % وسال عذار حول خديه جائر % % على مهجتي فليتق الله سائله % % 49(@)(@@) % أحمد الله كم أجود في الخل % % ق مقالا وما يفيد المقال % % 50(@)(@@) % كلمي في الأنام سحر ولكن % % أنا والسحر باطل بطال % % PageV01P1632 51(@)(@@) % أهلا بمقدمك السعيد وحبذا % % عيش على رغم الأعادي مقبل % % 52(@)(@@) % طلع الهلال وبمن وجهك للورى % % يتفاضلان وأنت أنت الأفضل % % 53(@)(@@) % عش يا إمام العلى والعلم ذا نعم % لقاصر السعي مثلي طامح الأمل % % 54(@)(@@) % أقسمت ما عثرت بالفقر لي قدم % الا وصاح رجائي فيك يا لعلي % % 55(@)(@@) % وسمي برك يا ولي الوقت قد % % أربت بوادره على الأمل الملي % % 56(@)(@@) % لا يعدم الشام اقتتال وزارة % يسعى بها الوسمي من حول الولي % % 57(@)(@@) % أما حمى قاضي القضاة فانني % % عن جاهه أروي الصحيح وماله % % 58(@)(@@) % مهما سألت عن اختلاف مقاصدي % % قالت حلاه أجزته بسؤاله % % 59(@)(@@) % رسمت عوادي السحر من ألحاظه % % سطر الضنا من فوق جسمي البالي % % 60(@)(@@) % فاذتا تأمله الخبير به رأى % % رسم ابن مقلة من يد ابن هلال % % PageV01P1633 61(@)(@@) % حضرت صلاة العصر خلف مبلغ % بهي المحيا يعشق الجمع شكله % 62(@)(@@) % فأقسم من خديه والثغر بالضحى % % وبالصبح ما أبصرت في العصر مثله % % 63(@)(@@) % ألا رب ليل واعدت فيه بالجفا % % ويا ويح روحي إن جفتها وويلها % % 64(@)(@@) % فبت كأني شعرها وهو مسبل % % أقبل رجلها وأمسك ذيلها % % 65(@)(@@) % أفدي التي ساق اليها مهجتي % % فرع طويل فوق حسن طائل % % 66(@)(@@) % قلبي بصدغيها إلى طلعتها % % يساق 