ms2771	 الله عنها .(@)(@@)(@@)(@@) $ 26048 قال النبي :(@)(@@) | 30 ( لا خير في قراءة إلا بتدبر ولا عبادة إلا بفقه ، ومجلس فقه خير من عبادة ستين سنة ) )(@)(@@) ( قط ) في الأفراد عن ابن عمر رضي الله عنهما وهو ضعيف .(@)(@@)(@@)(@@) ||| ( اللام ألف مع الدال(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26049 قال النبي :(@)(@@) | 30 ( لا دعوة في الإسلام ، ذهب أمر الجاهلية ، الولد للفراش وللعاهر الحجر ) )(@)(@@) ( حم د ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@) PageV08P280(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 26050 قال النبي :(@)(@@) | 30 ( لا دين لمن لا تقية له ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) ||| ( اللام ألف مع الذال(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 26051 قال النبي :(@)(@@) | 30 ( لا ذبيحة لغير الله ولا ذبيحة عليكم إلا واحدة أضحية لعشر ذي الحجة ، الشاة عن الرجل وعن أهله ) )(@)(@@) ابن قانع عن ابن عمرو بن الحارث العذري عن أبيه .(@)(@@)(@@)(@@) ||| ( اللام ألف مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26052 قال النبي :(@)(@@) | 30 ( لا ربا فيما كان يدا بيد ) )(@)(@@) ( حم ق ن ه ) عن أسامة بن زيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 26053 قال النبي :(@)(@@) | 30 ( لا رضاع إلا ما فتق الأمعاء ) )(@)(@@) ( ه ) عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ 26054 قال النبي :(@)(@@) | 30 ( لا رضاع إلا ما نشر اللحم وأنبت العظم ) )(@)(@@) ( د ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@) PageV08P281(@)(@@)(@@)(@@) $ 26055 قال النبي :(@)(@@) | 30 ( لا رقية إلا من عين أو حمة أو دم ) )(@)(@@) ( م ه ) عن بريدة ، ( حم د ت ) عن عمران رضي الله عنه .(@)(@@)(@@)(@@) $ 26056 قال النبي :(@)(@@) | 30 ( لا رقية إلا من عين أو حمة أو دم لا يرقا ) )(@)(@@) ( د ك ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 26057 قال النبي :(@)(@@) | 30 ( لا ربا إلا في المضامين والملاقيح وحبل الحبلة ) )(@)(@@) أبو بكر بن أبي داود في جزء من حديثه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 26058 قال النبي :(@)(@@) | 30 ( لا ربا في يد بيد إنما الربا في الدين ) )(@)(@@) ( طب ) عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ 26059 - قال النبي صلى الله عليه وسلم : ' لا 
ms2772	 ربا فيما كان يدا بيد لا ربا إلا في النسيئة ' | ( حم خ ) والعدني ( طب ) عن أسامة بن زيد رضي الله عنه . |(@)(@@)(@@)(@@) $ 26060 - قال النبي صلى الله عليه وسلم : ' لا ربا إلا في الدين ' ( طب ) عن أسامة بن زيد | رضي الله عنه . |(@)(@@)(@@)(@@) $ 26061 - قال النبي صلى الله عليه وسلم : ' لا رضاع إلا ما كان في الحولين ' ( قط ) عن ابن | عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 26062 - قال النبي صلى الله عليه وسلم : ' لا رضاع بعد فطام ولا يتم بعد احتلام ' ابن عساكر | عن علي رضي الله عنه . |(@)(@@)(@@)(@@) $ 26063 - قال النبي صلى الله عليه وسلم : ' لا رضاع بعد الفصال ، ولا وصال ولا يتم بعد | الحلم ، ولا صمت يوم إلى الليل ، ولا طلاق قبل النكاح ' عبد الرزاق عن علي | PageV08P282 | رضي الله عنه . |(@)(@@)(@@)(@@) $ 26064 - قال النبي صلى الله عليه وسلم : ' لا رضاع بعد فصال ، ولا يتم بعد احتلام ، ولا | عتق إلا بعد ملك ، ولا طلاق إلا بعد النكاح ، ولا يمين في قطيعة ، ولا تغرب بعد | هجرة ، ولا هجرة بعد الفتح ، ولا يمين لولد مع والد ، ولا يمين لامرأة مع زوج ، ولا يمين لعبد مع سيده ، ولا نذر في معصية الله ، ولو أن أعرابيا حج عشر حجج ثم | هاجر كانت عليه حجة إن استطاع إليه سبيلا ، ولو أن صبيا حج عشر حجج ثم احتلم | كانت عليه حجة إن استطاع إليه سبيلا ، ولو أن عبدا حج عشر حجج ثم أعتق كانت | عليه حجة إن استطاع إليه سبيلا ' ( ط هق ) عن جابر رضي الله عنه . |(@)(@@)(@@)(@@) $ 26065 - قال النبي صلى الله عليه وسلم : ' لا رقبى ولا عمرى ، فمن أعمر شيئا أو أرقبه فهو له | حياته ومماته ' ( عب طب ) عن ابن عمر رضي الله عنهما . |(@)(@@)(@@)(@@) ||| ( اللام ألف مع الزاي | من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26066 - قال النبي صلى الله عليه وسلم : ' لا زكاة في حجر ' ( عد هق ) عن ابن عمرو رضي | الله عنه . |(@)(@@)(@@)(@@) $ 26067 - قال النبي صلى الله عليه وسلم : ' لا زكاة في مال حتى يحول عليه الحول ' ( ه ) عن | عائشة رضي 
ms2773	 الله عنها . |(@)(@@)(@@)(@@) ||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 26068 - قال النبي صلى الله عليه وسلم : ' لا زكاة في شيء من الحرث نخله وزرعه وكرمه حتى | يبلغ خمسة أوساق ، فما بلغ خمسة أوساق ففيه الزكاة ، فما كان منه بالدواليب | PageV08P283 | والأيدي والنواضح ففيه نصف العشر ، وما كان مما تسقيه السماء والأنهار ففيه | العشر ، والوسق ستون صاعا ، ولا زكاة في شيء من الفضة حتى تبلغ خمسة أواق ففيه | الزكاة ، والأوقية أربعون درهما فإذا بلغ مائتي درهم ففيه خمس دراهم ' الرافعي عن | أبي سعيد أبو عوانة ( قط ) وضعفه عن جابر رضي الله عنه . |(@)(@@)(@@)(@@) ||| ( اللام ألف مع السين | من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26069 - قال النبي صلى الله عليه وسلم : ' لا سبق إلا في خف أو حافر أو نصل ' الشافعي | ( ط حم 4 ) عن أبي هريرة ( طب ) عن ابن عباس رضي الله عنهما . |(@)(@@)(@@)(@@) $ 26070 - قال النبي صلى الله عليه وسلم : ' لا سمر إلا لمصل أو مسافر ' ( حم طب حل هق ) | عن ابن مسعود رضي الله عنه . |(@)(@@)(@@)(@@) ||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 26071 - قال النبي صلى الله عليه وسلم : ' لا سمر بعد صلاة العشاء إلا لأحد رجلين : لمصل | أو مسافر ' عبد الرزاق ( حل ) عن ابن مسعود رضي الله عنه . |(@)(@@)(@@)(@@) $ 26072 - قال النبي صلى الله عليه وسلم : ' لا سهو في وثبة الصلاة إلا في قيام عن جلوس أو | جلوس عن قيام ' ( ك هق ) عن ابن عمر رضي الله عنهما . |(@)(@@)(@@)(@@) $ 26073 - قال النبي صلى الله عليه وسلم : ' لا سهم في الإسلام لمن لا صلاة له ، ولا صلاة | لمن لا وضوء له ' البزار عن أبي هريرة رضي الله عنه . | PageV08P284 |(@)(@@)(@@)(@@) ||| ( اللام ألف مع الشين | من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26074 - قال النبي صلى الله عليه وسلم : ' لا شؤم وقد يكون اليمن في الدار والمرأة والفرس ' | ( ت ه ) عن حكيم بن معاوية رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26075 - قال النبي صلى الله عليه وسلم : ' لا شغار في الإسلام ' ( حم ه حب ) عن أنس ، | ( م ) عن ابن عمر رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 26076 - قال النبي صلى الله عليه 
ms2774	 وسلم : ' لا شفعة إلا في دار أو عقار ' ( هق ) وضعفه عن أبي | هريرة رضي الله عنه . |(@)(@@)(@@)(@@) $ 26077 - قال النبي صلى الله عليه وسلم : ' لا شفعة لشريك على شريك إذا سبقه بالشراء ، ولا | لصغير ، ولا لغائب ' ( ه ) عن ابن عمر رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 26078 - قال النبي صلى الله عليه وسلم : ' لا شيء أغير من الله تعالى ' ( حم ق ) عن أسماء | بنت أبي بكر رضي الله عنهما . |(@)(@@)(@@)(@@) $ 26079 - قال النبي صلى الله عليه وسلم : ' لا شيء في البهائم ، والعين حق ، وأصدق الطيرة | الفأل ' ( حم ت ) عن حابس رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) ||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 26080 - قال النبي صلى الله عليه وسلم : ' لا شفعة لصغير ولا لغائب ولا لشريك على شريك إذا | سمعه بالشري والشفعة كحل العقال ' ( طب هق ) والخطيب عن ابن عمر رضي الله | عنهما . | PageV08P285 |(@)(@@)(@@)(@@) $ 26081 - قال النبي صلى الله عليه وسلم : ' لا شفعة لنصراني ' ( عد هق ) عن أنس رضي الله | عنه . |(@)(@@)(@@)(@@) $ 26082 - قال النبي صلى الله عليه وسلم : ' لا شؤم ، فإن يك شؤم ففي : الفرس والمرأة | والمسكن ' ( طب ) عن عبد المهيمن بن عباس بن سهل بن سعد عن أبيه عن جده . |(@)(@@)(@@)(@@) $ 26083 - قال النبي صلى الله عليه وسلم : ' لا شيء في الهام ، والعين حق ، وأصدق الطيرة | الفأل ' ( حم ت ) غريب وابن سعد ( ع ) وابن خزيمة والبغوي والباوردي وابن قانع | ( طب ) وأبو نعيم ( ض ) عن حية بن جابر التميمي عن أبيه قال البغوي : لا أعلم له | غيره ، قال ( ت ) : وروى عن حية عن أبيه عن أبي هريرة ، ( طب ) عن أبي أمامة | رضي الله عنه . |(@)(@@)(@@)(@@) $ 26084 - قال النبي صلى الله عليه وسلم : ' لا شبه لها هي ورب الكعبة : ريحانة تهتز ، ونور | يتلألأ ، ونهر مطرد ، وزوجة لا تموت ، في خلود ونعمة في مقام أمين ' الخطيب عن | ابن عباس رضي الله عنهما قال : ذكر رسول الله صلى الله عليه وسلم الجنة فقال فذكره وقال غريب . |(@)(@@)(@@)(@@) ||| ( اللام ألف مع الصاد | من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26085 - قال النبي صلى الله عليه وسلم : ' لا صاعي تمر 
ms2775	 بصاع ، ولا صاعي حنطة بصاع ، | ولا درهمين بدرهم ' ( ط حم ن حب ) عن أبي سعيد رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26086 - قال النبي صلى الله عليه وسلم : ' لا صاعين بصاع ، ولا درهمين بدرهم ' ( ق ن ) | عن أبي سعيد رضي الله عنه ( ز ) | PageV08P286 |(@)(@@)(@@)(@@) $ 26087 - قال النبي صلى الله عليه وسلم : ' لا صام من صام الأبد ' ( ق ن ه ) عن ابن عمرو | رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26088 - قال النبي صلى الله عليه وسلم : ' لا صام من صام الدهر ، صوم ثلاثة أيام صوم الدهر | كله ' ( خ ) عن ابن عمرو رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26089 - قال النبي صلى الله عليه وسلم : ' لا صرورة في الإسلام ' ( حم د ك هق ) عن ابن | عباس ، ( طب ) عن جبير بن مطعم رضي الله عنهم . |(@)(@@)(@@)(@@) $ 26090 - قال النبي صلى الله عليه وسلم : ' لا صوم فوق صوم داود شطر الدهر : صم يوما | وأفطر يوما ' ( خ ن ) عن ابن عمرو رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26091 - قال النبي صلى الله عليه وسلم : ' لا صلاة بحضرة طعام ، ولا ، وهو يدافعه | الأخبثان ' ( م د ) عن عائشة رضي الله عنها . |(@)(@@)(@@)(@@) $ 26092 - قال النبي صلى الله عليه وسلم : ' لا صلاة بعد الصبح حتى ترتفع الشمس ، ولا صلاة | بعد العصر حتى تغرب الشمس ' ( ق ن ه ) عن أبي سعيد ، ( حم د ه ) عن عمر | رضي الله عنه . |(@)(@@)(@@)(@@) $ 26093 - قال النبي صلى الله عليه وسلم : ' لا صلاة بعد الفجر إلا سجدتين ' ( ت ) عن ابن | عمر رضي الله عنهما ( ز ) . |(@)(@@)(@@)(@@) $ 26094 - قال النبي صلى الله عليه وسلم : ' لا صلاة لجار المسجد إلا في المسجد ' ( قط ) عن | جابر ، وعن أبي هريرة رضي الله عنهما . |(@)(@@)(@@)(@@) $ 26095 - قال النبي صلى الله عليه وسلم : ' لا صلاة لملتفت ' ( طب ) عن عبد الله بن سلام | رضي الله عنه . | PageV08P287 |(@)(@@)(@@)(@@) $ 26096 - قال النبي صلى الله عليه وسلم : ' لا صلاة لمن لا وضوء له ، ولا وضوء لمن لم يذكر | اسم الله عليه ' ( حم د ه ك ) عن أبي هريرة ، ( ه ) عن سعيد بن زيد رضي الله | عنه . |(@)(@@)(@@)(@@) $ 26097 - قال 
ms2776	 النبي صلى الله عليه وسلم : ' لا صلاة لمن لم يقرأ بأم القرآن فصاعدا ' ( م د ن ) | عن عبادة بن الصامت رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26098 - قال النبي صلى الله عليه وسلم : ' لا صلاة لمن لم يقرأ بفاتحة الكتاب ' ( حم ق 4 ) | عن عبادة رضي الله عنه . |(@)(@@)(@@)(@@) $ 26099 - قال النبي صلى الله عليه وسلم : ' لا صلاة لمن لم يقرأ في كل ركعة الحمد وسورة في | فريضة أو غيرها ' ( ه ) عن أبي سعيد رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26100 - قال النبي صلى الله عليه وسلم : ' لا صلاة لمن لا وضوء له ، ولا وضوء لمن لم يذكر | اسم الله عليه ، ولا صلاة لمن لم يصل على النبي ، ولا صلاة لمن لم يحب الأنصار ' | ( ه ك ) عن سهل بن سعد رضي الله عنه ( ز ) . |(@)(@@)(@@)(@@) $ 26101 - قال النبي صلى الله عليه وسلم : ' لا صيام لمن لم يفرضه من الليل ' ( ه ) عن | حفصة رضي الله عنها ( ز ) . |(@)(@@)(@@)(@@) ||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 26102 - قال النبي صلى الله عليه وسلم : ' لا صام ولا أفطر ' ( حب ) عن أبي قتادة رضي الله | عنه أن أعرابيا سأل النبي صلى الله عليه وسلم عن صوم الدهر قال فذكره . |(@)(@@)(@@)(@@) $ 26103 - قال النبي صلى الله عليه وسلم : ' لا صام ولا أفطر من صام الأبد ' ( حم طب ) عن | أسماء بنت يزيد رضي الله عنها . | PageV08P288 |(@)(@@)(@@)(@@) $ 26104 - قال النبي صلى الله عليه وسلم : ' لا صدقة في الكسعة والجبهة والنخة ' ( طب ) | عن عبد الرحمن بن سمرة رضي الله عنه . |(@)(@@)(@@)(@@) $ 26105 - قال النبي صلى الله عليه وسلم : ' لا صدقة إلا عن ظهر غنى ، واليد العليا خير من اليد | السفلى ، وابدأ بمن تعول ' ( حم ) عن أبي هريرة رضي الله عنه . |(@)(@@)(@@)(@@) $ 26106 - قال النبي صلى الله عليه وسلم : ' لا صدقة ولا جهاد ! فيم يدخل الجنة ؟ ' ( طس | ك هق ) عن بشير بن الخصاصية رضي الله عنه . |(@)(@@)(@@)(@@) $ 26107 - قال النبي صلى الله عليه وسلم : ' لا صداق دون عشرة دراهم ' ( قط هق ) وضعفاه عن | جابر رضي الله عنه . |(@)(@@)(@@)(@@) $ 26108 - قال النبي صلى الله عليه وسلم 
ms2777	 : ' لا صام من صام الدهر ، صوم ثلاثة أيام صوم الدهر | كله ، قال : إني أطيق أكثر من ذلك ، قال : فصم صوم داود ، كان يصوم يوما ويفطر | يوما ، ولا يفر إذا لاقى وهو أفضل الصيام ، قال : إني أطيق أفضل من ذلك ، قال : | لا أفضل من ذلك ' ( خ ) عن ابن عمرو رضي الله عنه . |(@)(@@)(@@)(@@) $ 26109 - قال النبي صلى الله عليه وسلم : ' لا صفر ولا هامة ولا يعدي سقيم صحيحا ' القاضي | محمد بن عبد الباقي الأنصاري في جزء من حديثه عن شيوخه عن علي رضي الله | عنه . |(@)(@@)(@@)(@@) $ 26110 - قال النبي صلى الله عليه وسلم : ' لا صدقة في الزرع ولا في الكرم ولا في النخل إلا | ما بلغ خمسة أوسق فذلك مائة فرق ' ابن جرير ( قط هق ) عن جابر وأبي سعيد رضي | الله عنهما قال ( قط ) : إسناده صالح . |(@)(@@)(@@)(@@) $ 2611 - قال النبي صلى الله عليه وسلم : ' لا صدقة في الرقة حتى تبلغ مائتي درهم ' | PageV08P289 | ( ك هق ) عن جابر رضي الله عنه . |(@)(@@)(@@)(@@) $ 26112 - قال النبي صلى الله عليه وسلم : ' لا صفر ولا هامة ولا عدوى ولا يتم شهران ستين | يوما ، ومن خفر ذمة الله لم يرح رائحة الجنة ' ( طب ) وابن عساكر عن | عبد الرحمن بن أبي عميرة المزني رضي الله عنه .(@)(@@)(@@)(@@) $ 26113 قال النبي :(@)(@@) | 30 ( لا صوم بعد النصف من شعبان حتى رمضان ، ومن كان عليه صوم يوم فليسرده ولا يقطعه ) )(@)(@@) الديلمي عن أبي هريرة وعمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 26114 قال النبي :(@)(@@) | 30 ( لا صدقة في الكسعة والجبهة والنخة ) )(@)(@@) الحاكم في الكنى ا عن عبد الرحمان بن سمرة ، ( هق ) عن الحسن ( د ) في مراسيله ، ( هق ) عن الحسن مرسلا أبو عبيد في الغريب ، ( هق ) عن كثير بن زياد الخراساني مرسلا وعن الضحاك مرسلا .(@)(@@)(@@)(@@) $ 26115 قال النبي :(@)(@@) | 30 ( لا صلاة لحائض إلا بخمار ) )(@)(@@) ( هق ) في المعرفة عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 26116 قال النبي :(@)(@@) | 30 ( لا صلاة بعد صلاة العصر ) )(@)(@@) ( طب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 26117 قال النبي :(@)(@@) | 30 ( لا صلاة لمن دخل المسجد والإمام قائم يصلي 
ms2778	 فلا ينفرد وحده بصلاته ولاكن يدخل مع الإمام في الصلاة ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 26118 قال النبي :(@)(@@) | 30 ( لا صلاة بعد الفجر حتى تطلع الشمس ، ولا بعد العصر حتى تغرب الشمس ، من طاف فليصل ) )(@)(@@) ( عد هق ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV08P290(@)(@@)(@@)(@@) $ 26119 قال النبي :(@)(@@) | 30 ( لا صلاة بعد طلوع الفجر إلا ركعتي الفجر ) )(@)(@@) ( هق ) عن ابن عمر ، ( هق ) عن ابن عمرو ، ( هق ) عن أبي هريرة ، ( هق ) عن سعيد بن المسيب مرسلا .(@)(@@)(@@)(@@) $ 26120 قال النبي :(@)(@@) | 30 ( لا صلاة بعد الإقامة إلا المكتوبة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 26121 قال النبي :(@)(@@) | 30 ( لا صلاة لمن سمع النداء فلم يأته إلا من عذر ) )(@)(@@) أبو بكر بن المقري في الأربعين عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 26122 قال النبي :(@)(@@) | 30 ( لا صلاة في العيدين قبل صلاة الإمام ، ولا ذبح يوم النحر حتى يصلي الإمام ) )(@)(@@) الديلمي عن مقاتل بن سليمان عن جرير بن عبد الله بن جرير البجلي عن أبيه عن جده .(@)(@@)(@@)(@@) $ 26123 قال النبي :(@)(@@) | 30 ( لا صلاة لمن لا يتخشع في صلاته ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 26124 قال النبي :(@)(@@) | 30 ( لا صلاة لمن لا يطيع الصلاة ، وطاعة الصلاة أن ينهى عن الفحشاء والمنكر ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 26125 قال النبي :(@)(@@) | 30 ( لا صلاة لمن لم يتوضأ ، ولا وضوء لمن لم يذكر اسم الله عليه ) )(@)(@@) عبد الرزاق عن عمارة بن غزية رضي الله عنه .(@)(@@)(@@)(@@) $ 26126 قال النبي :(@)(@@) | 30 ( لا صلاة لمن لا تشهد له ) )(@)(@@) ( طس ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 26127 قال النبي :(@)(@@) | 30 ( لا صلاة إلا بقراءة فاتحة الكتاب فما زاد ) )(@)(@@) ( هق ) في القراءة عن أبي سعيد رضي الله عنه .(@)(@@) PageV08P291(@)(@@)(@@)(@@) $ 26128 قال النبي :(@)(@@) | 30 ( لا صلاة بعد العصر حتى تغرب الشمس ، ولا صلاة بعد الفجر حتى تطلع الشمس إلا بمكة ، إلا بمكة ، إلا بمكة ) )(@)(@@) ( حم ) و ابن خزيمة ، ( قط طس حل هق ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 26129 قال النبي :(@)(@@) | 30 ( لا 
ms2779	 صلاة لمن لا وضوء له ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ 26130 قال النبي :(@)(@@) | 30 ( لا صلاة إلا بفاتحة الكتاب وآيتين من القرآن معها ) )(@)(@@) ( طب ) عن عبادة رضي الله عنه .(@)(@@)(@@)(@@) $ 26131 قال النبي :(@)(@@) | 30 ( لا صلاة إلا بقراءة ، ولو بفاتحة الكتاب ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 26132 قال النبي :(@)(@@) | 30 ( لا صلاة لمن لا وضوء له ، ولا وضوء لمن لم يذكر اسم الله تعالى عليه ، ولا يؤمن بالله من لا يؤمن بي ، ولا يؤمن بي من لا يحب الأنصار ) )(@)(@@) ( ص حم ) و الشاشي والطحاوي ، ( قط عق ض ) عن سعيد بن زيد ، ( طب ) عن أبي سبرة ، ( ك ) عن أسماء بنت سعيد بن زيد أنها سمعت رسول الله إلى قوله : من لا يؤمن بي .(@)(@@)(@@)(@@) $ 26133 قال النبي :(@)(@@) | 30 ( لا صلاة لمن صلى خلف الصف فردا ) )(@)(@@) ابن قانع عن عبد الرحمان بن علي بن شيبان عن أبيه عن جده .(@)(@@)(@@)(@@) $ 26134 قال النبي :(@)(@@) | 30 ( لا صلاة لمن سمع النداء ثم لم يأته إلا من علة ) )(@)(@@) الحاكم في الكنى وضعفه عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 26135 قال النبي :(@)(@@) | 30 ( لا صلاة إلا بقرآن بفاتحة الكتاب فما زاد ) )(@)(@@) ( حم عق ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV08P292(@)(@@)(@@)(@@) $ 26136 قال النبي :(@)(@@) | 30 ( لا صلاة لمن لم يمس أنفه الأرض ما يمس الجبين ) )(@)(@@) ( ك هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 26137 قال النبي :(@)(@@) | 30 ( لا صلاة مكتوبة في يوم مرتين ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 26138 قال النبي :(@)(@@) | 30 ( لا صيام بعد النصف من شعبان حتى يدخل رمضان ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) ||| ( اللام ألف مع الضاد(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26139 قال النبي :(@)(@@) | 30 ( لا ضرر ولا ضرار ) )(@)(@@) ( حم ه ) عن ابن عباس ، ( ه هق ) عن عبادة بن الصامت ، ( طب ) وأبو نعيم عن ثعلبة بن أبي مالك القرظي رضي الله عنهم .(@)(@@)(@@)(@@) $ 26140 قال النبي :(@)(@@) | 30 ( لا ضمان على مؤتمن ) )(@)(@@) ( هق ) وضعفه عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال 
ms2780	 من الجامع الكبير )(@)(@@)(@@)(@@) $ 26141 قال النبي :(@)(@@) | 30 ( لا ضرر ولا ضرار ، من ضار ضاره الله ، ومن شاق شاق الله عليه ) )(@)(@@) مالك عن عمر بن يحيى المازني عن أبيه مرسلا ، ( قط ك هق ) عنه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 26142 قال النبي :(@)(@@) | 30 ( لا ضرر ولا ضرار ، وللرجل أن يضع خشبة في PageV08P293 حائط جاره ، والطريق الميتاء سبعة أذرع ) )(@)(@@) ( حم عب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 26143 قال النبي :(@)(@@) | 30 ( لا ضرب فوق عشر ضربات إلا في حدود الله ) )(@)(@@) ( عب ) عن سل يمان بن يسار مرسلا .(@)(@@)(@@)(@@) ||| ( اللام ألف مع الطاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 26144 قال النبي :(@)(@@) | 30 ( لا طاعة لأحد في معصية الله إنما الطاعة في المعروف ) )(@)(@@) ( ق ن ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 26145 قال النبي :(@)(@@) | 30 ( لا طاعة لمخلوق في معصية الخالق ) )(@)(@@) ( حم ك ) عن عمران والحكم بن عمرو الغفاري رضي الله عنه .(@)(@@)(@@)(@@) $ 26146 قال النبي :(@)(@@) | 30 ( لا طاعة لمن لم يطع الله ) )(@)(@@) ( حم ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 26147 قال النبي :(@)(@@) | 30 ( لا طلاق إلا فيما يملك ، ولا عتق إلا فيما يملك ، ولا بيع إلا فيما يملك ، ولا وفاء نذر إلا فيما يملك ، ولا نذر إلا فيما ابتغي به وجه الله ، ومن حلف على معصية فلا يمين له ، ومن حلف على قطيعة رحم فلا يمين له ) )(@)(@@) ( د ك ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 26148 قال النبي :(@)(@@) | 30 ( لا طلاق إلا لعدة ، ولا عتاق إلا لوجه الله ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV08P294(@)(@@)(@@)(@@) $ 26149 قال النبي :(@)(@@) | 30 ( لا طلاق قبل النكاح ) )(@)(@@) ( ه ) عن علي ، ( ك ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 26150 قال النبي :(@)(@@) | 30 ( لا طلاق قبل النكاح ، ولا عتاق قبل ملك ) )(@)(@@) ( ه ) عن المسور رضي الله عنه .(@)(@@)(@@)(@@) $ 26151 قال النبي :(@)(@@) | 30 ( لا طلاق ولا عتاق في إغلاق ) )(@)(@@) ( حم د ه ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 26152 قال النبي :(@)(@@) | 30 ( لا طيرة وخيرها الفأل ، قيل : يا رسول الله وما الفأل ؟ قال : الكلمة 