ms301	 % % فما ينأى بيومك أن تخافي % % 2(@)(@@) % فطورا تعرضين على زلال % وطورا تعرضين على ذعاف % 3(@)(@@) % ومن يشرب بصاف غير رنق % % يرد يوما برنق غير صافي % % 4(@)(@@) % غمست يدي في أمر فمن لي % % وأين بنزع كفي وانكفافي % % 5(@)(@@) % كفاني أنني حرب لقومي % % وذلك لي من الضراء كاف % % 6(@)(@@) % حطمت صعادهم حتى استقاموا % % مجاوزة بهم حد الثقاف % 7(@)(@@) % فصرت لذمهم غرضا رجيما % يراموني بمثل حصى القذاف % % 8(@)(@@) % وأكذب بالتصون مدعيهم % % والجم فائليهم بالعفاف % % 9(@)(@@) % ولو أني أطعت الرشد يوما % لابدلت التحامل بالتجافي % % 10(@)(@@) % وأغضيت اللواحظ عن ذنوب % وموضعها لعيني غير خاف % % PageV01P1060 11(@)(@@) % ولكن الحمية في تأبى % % قراري للرجال على التكافي % % 12(@)(@@) % وانظر سبة وعظيم عار % % رضاي من المنازع بالكفاف % % 13(@)(@@) % ولو أني رميت أصاب سهمي % % ولكني أنقب عن شغافي % % 14(@)(@@) % فما سهمي السديد من النوابي % % ولا باعي الطويل من الضعاف % % 15(@)(@@) % ولي أنف كأنف الليث يأبى % % شميمي للمذلة واستيافي % % 16(@)(@@) % وقد عرف العدى وبلوا قديما % % خطاي إلى المنايا وازدلافي % % 17(@)(@@) % لي العزم الذي قد جربوه % % يقد مضارب البيض الخفاف % 18(@)(@@) % وربط الجأش والاقدام ذل % % يزلزلها الردى يوم الوقاف % % 19(@)(@@) % وقد كلت صوارمها وملت % عرانين القنى من الرعاف % % 20(@)(@@) % فعال أغر ريان العوالي % % من الأعداء ملآن الصحاف % % PageV01P1061 21(@)(@@) % يضيف ، فلا يميز من يراه % أمارات المضيف من المضاف % 22(@)(@@) % إذا عد المناقب جاء بيتي % % يجر ذيول أحساب ضوافي % % 23(@)(@@) % أقلوا ، لا أبا لكم ، وخلوا % % مطاعنة الأسنة بالأشافي % % 24(@)(@@) % فقد مدت غيابات المخازي % % على عرصاتكم مد الطراف % 25(@)(@@) % صفوت لكم فرنقتم غديري % % وأي مضاغن رجع المصافي % % 26(@)(@@) % ويوشك أن يقام على التقالي % % أنابيب رجعن إلى التصافي % % 27(@)(@@) % مضى زمن التمازح والتداني % % وذا زمن التزايل والتنافي % % 28(@)(@@) % لئن أعلى بنائكم اصطناعي % % فسوف يثل عرشكم انحرافي % % 29(@)(@@) % أداوي دائهم فيزيد خبثا % وليس لداء ذي البغضاء شاف % % 30(@)(@@) % حنوت عليهم ولرب حان % على جان وإن بعد التلافي % % PageV01P1062 31(@)(@@) % فما قلبي وإن جهلوا بقاس % % ولا حلمي وإن قطعوا بهاف % % 32(@)(@@) % فما تغني القوادم من جناح % % تحامل ، إن قعدن به 
ms302	 الخوافي % % 33(@)(@@) % وعندي للزمان مسومات % % من الأشعار تخترق الفيافي % % 34(@)(@@) % قصائد أنست الشعراء طرا % عوائهم على أثر القوافي % % 35(@)(@@) % بوارد للغليل كان قلبي % % يعب بهن في برد النطاف % % 36(@)(@@) % أسر بهن أقواما ، وأرمي % % أقيواما ، بثالثة الأثافي % % PageV01P1063 البحر : طويل 1(@)(@@) % وفى بمواعيد الخليط وأخلفوا % % وكم وعدوا القلب المعنى ولم يفوا % % 2(@)(@@) % وما ضرهم أن لم يجودوا بمقنع % من النيل اذمنوا قليلا وسوفوا % % 3(@)(@@) % أفي كل يوم لفتة ثم عبرة % % على رسم دار أو مطي موقف % % 4(@)(@@) % وركب على الأكوار يثني رقابهم % % لداعي الصبا ، عهد قديم ومألف % 5(@)(@@) % فمن واجد قد ألزم القلب كفه % % ومن طرب يعلو اليفاع ويشرف % 6(@)(@@) % ومستعبر قد اتبع الدمع زفرة % % تكاد لها عوج الضلوع تثقف % % 7(@)(@@) % قضى ما قضى من أنة الشوق وانثنى % % بدار الجوى والقلب يهفو ويرجف % % 8(@)(@@) % ولم تغن حتى زايل البعد بيننا % % وحتى رمانا الأزلم المتغطرف % 9(@)(@@) % كأن الليالي كن آلين حلفة % بأن لا يرى فيهن شمل مؤلف % % 10(@)(@@) % ألم خيال العامرية بعدما % % تبطننا جفن من الليل أوطف % % PageV01P1064 11(@)(@@) % يحيي طلاحا حين هموا بوقعة % تهاووا على الأذقان مما تعسفوا % % 12(@)(@@) % وقيدين قد مال النعاس بهامهم % % كما أرعشت أيدي المعاطين قرقف % % 13(@)(@@) % أعاريب لا يدرون ما الريف بالفلا % % ولا يغبطون القوم أما تريفوا % % 14(@)(@@) % رذايا هوى إن عن برق تطاولوا % % وإن عارضوا الطير الغوادي تعيفوا % % 15(@)(@@) % توارك للشق الذي هو آمن % نوازل بالأرض التي هي أخوف % % 16(@)(@@) % أيا وقفة التوديع هل فيك راجع % إشارته ذاك البنان المطرف % % 17(@)(@@) % وهل مطمعي ذاك الغزال بلفتة % وإن ثور الركب العجال وأوجفوا % % 18(@)(@@) % عشية لا ينفك لحظة مبهت % % مراقبة منا ، ودمع مكفكف % 19(@)(@@) % فلله من غنى الحداة ورائه % % ولله ما ورى العبيط المسجف % % 20(@)(@@) % وسائلة عني كأني لم ألج % حمى قومها واليوم بالنقع مسدف % % PageV01P1065 21(@)(@@) % لئن كنت مجهولا بذلي في الهوى % % فإني بعزي عند غيرك أعرف % 22(@)(@@) % فلا تعجبي أني تعرقني الضنى % % فإن الهوى يقوى علي وأضعف % % 23(@)(@@) % يقرع باسمي الجيش ثم يردني % % إلى طاعة الحسناء قلب مكلف % 24 
ms303	(@)(@@) % سلي بي ألم أنغل في لهواتها % % وفحل المردى دوني بنابيه يصرف % % 25(@)(@@) % سلي بي ألم أحمل على الضيم ساعدي % % وقد ثلم الماضي ، ورض المثقف % 26(@)(@@) % سلي بي ألم أثن الأعنة ظافرا % تحدث عن يومي نزار وخندف % % 27(@)(@@) % وحي تخطت بي أعز بيوته % صدور المواضي والوشيج المرعف % % 28(@)(@@) % سلي بي ألم أصبر على الظمء بعدما % % هوى بالمهارى نفنف ثم نفنف % % 29(@)(@@) % وكل غلام ملء درعيه نجدة % ولوثة أعرابية وتغطرف % 30(@)(@@) % على كل طاو فيه جد وميعة % وطاوية فيها هباب وعجرف % % PageV01P1066 31(@)(@@) % وقد أتبعت سمر العوالي زجاجها % % وحن من الأنباض جزع معطف % % 32(@)(@@) % فإن تسمعوا صوت المرنات تعلموا % % بمن جعلت تدعو النواعي وتهتف % % 33(@)(@@) % لنا الدولة الغراء ، ما زال عندها % % من الجور واق أو من الظلم منصف % 34(@)(@@) % بعيدة صوت في العلى ، غير رافع % بها صوته المظلوم والمتحيف % 35(@)(@@) % ونحن أعز الناس شرقا ومغربا % وأكرم أبصار على الأرض تطرف % % 36(@)(@@) % بنواكل فياض اليدين من الندى % % إذا جاد ألغى ما يقول المعنف % 37(@)(@@) % وكل محيا بالسلام معظم % % كثير إليه الناظر المتشوف % % 38(@)(@@) % وأبيض بسام كأن جبينه % سنا قمر أو بارق متكشف % % 39(@)(@@) % حيي ، فإن سيم الهوان رأيته % يشد ولا ماضي الغرارين مرهف % 40(@)(@@) % لنا الجبهات المستنيرات في العلى % % إذا التثم الأقوام زلا وأغدفوا % % PageV01P1067 41(@)(@@) % أبونا الذي أبدى بصفين سيفه % ضغاء ابن هند ، والقنا يتقصف % 42(@)(@@) % ومن قبل ما أبلى ببدر وغيرها % % ولا موقف إلا له فيه موقف % 43(@)(@@) % ورثنا رسول الله علوي مجده % % ومعظم ما ضم الصفا والمعرف % % 44(@)(@@) % وعند رجال أن جل تراثه % % قضيب محلى ، أو رداء مفوف % 45(@)(@@) % يريدون أن نلقي إليهم أكفنا % % وهن دمنا أيديهم ، الدهر ، تنطف % 46(@)(@@) % فلله ما أقسى ضمائر قومنا % % لقد جاوزوا حد العقوق وأسرفوا % % 47(@)(@@) % يضنون أن نعطي نصيبنا من العلا % % وقد عالجوا دين العلى وتسلفوا % % 48(@)(@@) % وهذا أبي الأدنى الذي تعرفونه % % مقدم مجد أول ومخلف % 49(@)(@@) % مؤلف ما بين الملوك إذا هفوا % % وأشفوا على حز الرقاب وأشرفوا % % 50(@)(@@) % إذا قال : ردوا غارب الحلم راجعوا % % وإن 
ms304	 قال : مهلا بعض ذا الجد وقفوا % % PageV01P1068 51(@)(@@) % وبالأمس لما صال قادر ملكهم % وأعرض منه الجانب المتخوف % % 52(@)(@@) % تلافاه حتى سامح الضغن قلبه % % وأسمح لما قيل لا يتألف % % 53(@)(@@) % وكان ولي العقد والعهد بينه % وبين بهاء الملك يسعى ويلطف % % 54(@)(@@) % ولما التقى نجوى عقيل لنبوة % % ومد لهم حبل من الغدر محصف % % 55(@)(@@) % لوى عطفه لي القني رقابهم % ولو لسواه استعطفوا ما تعطفوا % % 56(@)(@@) % وسل مضرا لما سما لديارها % % فهب ونام العاجز المتضعف % 57(@)(@@) % تولجها كالسيل صلحا وعنوة % فأبقى ورد البيض ظمأى تلهف % 58(@)(@@) % له وقفات بالحجيج شهودها % % إلى عقب الدنيا منى والمخيف % % 59(@)(@@) % ومن مأثرات غير هاتيك لم تزل % لها عنق عال على الناس مشرف % 60(@)(@@) % حمى فاه عن بسط الملوك وقد كبت % % عليها جباه من رجال وآنف % PageV01P1069 61(@)(@@) % زمام علا لو غيره رام جره % لساق به حاد من الذل معنف % 62(@)(@@) % جرى ما جرى قبلي وها أنا خلفه % % إلى الأمد الأقصى أغذ وأوجف % % 63(@)(@@) % ولولا مراعاة الأبوة جزته % % ولكن لغير العجز ما أتوقف % % 64(@)(@@) % حذفت فضول العيش حتى رددتها % % إلى دون ما يرضى به المتعفف % 65(@)(@@) % وأملت أن أجري خفيفا إلى العلى % % إذا شئتم أن تلحقوا فتخففوا % % 66(@)(@@) % حلفت برب البدن تدمى نحورها % % وبالنفر الأطوار لبوا وعرفوا % % 67(@)(@@) % لأبتذلن النفس حتى أصونها % % وغيري في قيد من الذل يرسف % % 68(@)(@@) % فقد طالما ضيعت في العيش فرصة % % وهل ينفع الملهوف ما يتلهف % % 69(@)(@@) % وإن قوافي الشعر ما لم أكن لها % % مسفسفة ، فيها عتيق ومقرف % 70(@)(@@) % أنا الفارس الوثاب في صهواتها % % وكل مجيد جاء بعدي مردف % % PageV01P1070 البحر : كامل تام 1(@)(@@) % أشكو إليك مدامعا تكف % بعد النوى ، وجوانحا تجف % 2(@)(@@) % وحشا ، إذا ذكر الفراق هفا % % في جانبيه الشوق والأسف % % 3(@)(@@) % فجعت بعلق مضنة يده % فأقام لا عوض ، ولا خلف % 4(@)(@@) % كالناشط امتنعت موارده % ونأت عليه الروضة الأنف % 5(@)(@@) % أنس تناقص مع تكامله % لا بدع إن البدر ينكسف % 6(@)(@@) % لا يبعد الله الذين نأوا % % وقفوا الغرام بنا وما وقفوا % % 7(@)(@@) % أي القوى قطعوا ، وأي دم 
ms305	 % سفكوا ، وأي جراحة قرفوا % % 8(@)(@@) % لم أنس موقفنا ووقفتهم % % بعد النوى ، ودموعنا تكف % 9(@)(@@) % متساكتين من الوجوم ، وقد % % نطقت علينا الأدمع الذرف % 10(@)(@@) % يا راكب الكوماء ، غاربها % % كالطود أوفى فوقه الشعف % % PageV01P1071 11(@)(@@) % يطأ الظلام على مفارقه % % والليل في أجفانه وطف % % 12(@)(@@) % ذرع الدجا وطوى خميصته % % ولها على قمم الربى كفف % % 13(@)(@@) % حتى نضا الإظلام صيغته % وطواه جون الليل منكشف % 14(@)(@@) % ماض إذا أهوى به كنف % % من جنح ليل ضمه كنف % % 15(@)(@@) % أبلغ فتى حمد مذكرة % تنقد منها البيض والزغف % % 16(@)(@@) % نفثات مكروب ألظ به % % حر الجوى وعلا به الكلف % % 17(@)(@@) % ما كان أسرع ما نبا زمن % وتكدرت من ودنا نطف % 18(@)(@@) % حبل غدا بأكفنا طرف % % منه ، وفي أيدي النوى طرف % 19(@)(@@) % هل حسن ذاك الدهر مرتجع % % أم طيب ذاك العيش مؤتنف % % 20(@)(@@) % أم هل يباح الورد ثانية % ويلذ برد الماء مرتشف % % PageV01P1072 21(@)(@@) % لهفي على ذاك الزمان وهل % % يثني زمانا ماضيا لهف % % 22(@)(@@) % انبت بعدك حبلنا ، وحدت % كلا لطيته نوى قذف % 23(@)(@@) % وانفك سلك نظامنا ، بددا % ولقد عنينا وهو مؤتلف % % 24(@)(@@) % وتجنب البتي جانبنا % % ونبا فلا ود ولا شعف % % 25(@)(@@) % وقلى مجالسنا ومال به % % عطف إلى البغضاء منعطف % 26(@)(@@) % وأزيح ذاك الأنس أجمعه % % وأميط ذاك البر واللطف % % 27(@)(@@) % جعل الوصية تحت أخمصه % % وأتى الإساءة وهو معترف % % 28(@)(@@) % إنا نذم إليك خلته % فهو الملول الغادر الطرف % 29(@)(@@) % فلعلنا ، ولعل مطمعة % يوما بقربك منه ننتصف % 30(@)(@@) % فسقى ليالينا التي سلفت % % فرط من الأنواء أو سلف % % PageV01P1073 31(@)(@@) % يحدى بسوط الريح تحفزه % % هفافة في سوقها عنف % 32(@)(@@) % نتج الصباح عشاره سبلا % % جوادا وألقح شوله السدف % % 33(@)(@@) % ندعوك حين الشمل منشعب % فتلافنا ، والرأي مختلف % 34(@)(@@) % إن لم تقم تلك الغصون غدا % % منهن منآد ومنقصف % % 35(@)(@@) % لا تحسبن قولي مماذقة % وجدي ببعدك فوق ما أصف % PageV01P1074 البحر : كامل تام 1(@)(@@) % جرعتني غصصا ورحت مسلما % % فلأسقينك مثلها أضعافا % % 2(@)(@@) % إن نجتمع يوما أكن لك جذوة % % حمراء ، توسع جانبيك ثقافا % % 3(@)(@@) % أنسى التفاتي لا أراك ورجعتي % % أبكي الديار ، وأندب الألافا 
ms306	 % % 4(@)(@@) % أنسى ارتفاقي ، والعيون هواجع % وجوانبي عن مضجعي تتجافى % % 5(@)(@@) % أنسى اشتمالي بالسقام مقيمة % عندي عقائله وأنت معافى % % 6(@)(@@) % كم قد أردت على التبدل خاطري % % فإني وازغ عن البديل وعافى % % 7(@)(@@) % ورقبته فرأيته متمنعا % وبعثته فوجدته وقافا % % 8(@)(@@) % وعذرته بعد الإباء لأنه % ظن الذي يطرى كأنت فخافا % % 9(@)(@@) % ولقد جنيت علي عمدا لا كمن % % عرف الجناية مخطئا فتلافى % % 10(@)(@@) % ما هكذا من كان يزعم أنه % عين الصديق ولا كذا من صافى % % PageV01P1075 11(@)(@@) % هب لم يكن لك بالوفاء عوائد % أتراك ما أحسنت أن تتوافى % % 12(@)(@@) % ومن العجائب أن وفيت لغادر % نقض العهود وضيع الأحلافا % % 13(@)(@@) % لا كنت من ريب الزمان بسالم % إن كنت تسلم من يدي كفافا % % 14(@)(@@) % بل لا التذذت من الزمان بشربة % إن لم أعضك من الزلال ذعافا % % 15(@)(@@) % إن حاف لي دهر عليك ، فطالما % % مال الزمان علي فيك وحافا % % PageV01P1076 البحر : خفيف تام 1(@)(@@) % كل شيء من الزمان طريف % والليالي مغانم وحتوف % 2(@)(@@) % لا يبذ الهموم إلا غلام % % يركب الهول ، والحسام رديف % 3(@)(@@) % كلما حزت النوائب فينا % % اطلعتنا على الكلوم القروف % % 4(@)(@@) % يا أبا الفضل ، والأمور فنون % تبعث الهم والخطوب صروف % % 5(@)(@@) % وحفاظي كما علمت ، ولكن % أنكر الغدر ودي المعروف % 6(@)(@@) % إنما الغدر في الرجال أذب % % إن تأملت ، والوفاء ألوف % 10(@)(@@) % ما يذل الزمان بالفقر حرا % % كيف ما كان فالشريف شريف % 11(@)(@@) % إن تكرمت ، فالخليل كريم % أو تمنعت فالملول عنيف % % 12(@)(@@) % أو يكن أنكر الإخاء قديما % منك قلب فإن قلبي عروف % % 14(@)(@@) % ك ، فأين التكرم المألوف % إنما البر منزل مألوف % PageV01P1077 البحر : خفيف تام 1(@)(@@) % أقعدتنا زمانة وزمان % % جائر عن قضاء حق الشريف % PageV01P1078 البحر : خفيف تام 1(@)(@@) % كم ذميل إليكم ووجيف % وصدود عنا لكم وصدوف % 2(@)(@@) % وغرام بكم لو أن غراما % جر نفعا للواجد المشغوف % % 17(@)(@@) % كل يوم وداع ركب عجال % بالنوى أو عناء ركب وقوف % 18(@)(@@) % ت وأخليت لي مكان الرديف % وطويل على الديار وقوفي % % 25(@)(@@) % لم يثقف عودي الزمان ، ولكن % ضج عود الزمان من تثقيفي % % 26(@)(@@) % قلت للدهر 
ms307	 يوم رام اختداعي % % عن جناني الماضي ونفسي العزوف % % 32(@)(@@) % ونزاع يهفو إليه يلبي % % هفوات المصرصر الغطريف % % 35(@)(@@) % إن شكواك للزمان مبين % لي على قدر عقله المضعوف % % 38(@)(@@) % والحظوظ البلهاء من ذي الليالي % % أنكحت بنت عامر من ثقيف % 40(@)(@@) % إن حرمت الرزق الذي نال منه % % فدواء العيي داء الحصيف % % PageV01P1079 41(@)(@@) % عمل فاضح وأجمل من بعض % % الولايات عطلة المصروف % % 42(@)(@@) % فاصطبر للخطوب رب اصطبار % % شق فجرا من ليلهن المخوف % % 43(@)(@@) % إنما نلبس الدروع ثقالا % لرجوع إلى خفاف الشفوف % 45(@)(@@) % إن أولى بالصبر إن حرجته % من حشاه منها كثير القروف % 47(@)(@@) % قر عينا بطارقات الشكايا % % ما تجافت مطرقات الحتوف % 51(@)(@@) % كلما كان زائد العقل أمسى % % ناقصا من تليده والطريف % % PageV01P1080 البحر : كامل تام 1(@)(@@) % قضت المنازل يوم كاظمة % أن المطي يطول موقفها % % 2(@)(@@) % لمع من الأطلال يحزننا % % محتلها البالي ومألفها % % 3(@)(@@) % سبقت مدامعها برشتها % % من قبل أن يومي مكفكفها % % 4(@)(@@) % وتكلفت من صوب ماطرها % % فوق الذي يرجو مكلفها % % 5(@)(@@) % إن كنت انفدت الدموع بها % % فالوجد بعد اليوم يخلفها % % 6(@)(@@) % لا منة مني على طلل % ديم طلاع العين أذرفها % % 7(@)(@@) % ولواعج نفسي ينفسها % % وبلابل دمعي يخففها % % 8(@)(@@) % ظعنوا فللأحشاء مذ طعنوا % % حرق تعسفها وتعسفها % % 9(@)(@@) % لا تنشدن الدار بعدهم % إني على الإقواء أعرفها % % 10(@)(@@) % وعلامة للشوق أضمره % طربي إلي الإيقاع أشرفها % % PageV01P1081 11(@)(@@) % في كل يوم لي غريم هوى % % يلوي الديون ولا يسوفها % % 12(@)(@@) % رفقا بقلبي يا أبا حسن % % العين منك وأنت تطرفها % % 13(@)(@@) % فكأنني بعلائق شعب % % قد زال عن أمم تألفها % % 14(@)(@@) % ومقومات من غصون هوى % % يعوج أطوارا مثقفها % % 15(@)(@@) % في القلب منك جراحة أبدا % ما زلت أدملها وتفرقها % % 16(@)(@@) % كم من معاقد بت تفسخها % % ومواعد بالقرب تخلفها % % 17(@)(@@) % أما الحفاظ فأنت تمطله % % والمحفظات فأنت تسلفها % % 18(@)(@@) % سأروم عصف النفس عنك وإن % % كان الغرام إليك يعطفها % % 19(@)(@@) % ولطالما استصرفتها مللا % ولئن صحوت فسوف أصرفها % % 20(@)(@@) % وإذا طلبت بها السلو أبى % % إلا النزاع إليك مدنفها % % PageV01P1082 21(@)(@@) % فكأن منسيها يذكرها % % أو ما يؤسيها يسوفها % % 22(@)(@@) % تمضي ونحوكم 
ms308	 تلفتها % % وإلى لقائكم تشوفها % % 23(@)(@@) % فهواكم والشوق يعذرها % % وذميم فعلكم يعنفها % % 24(@)(@@) % هل يعطفنكم توجعها % % أو يقبلن بكم تلهفها % % 25(@)(@@) % فاستبق منها ما يضن به % تلك الصبابة أنت ترشفها % % 26(@)(@@) % لا تأمننها إن أسأت بها % % هي ما علمت وأنت تعرفها % % 27(@)(@@) % إن كان يطمعكم تذللها % % فلسوف يفزعكم تغطرفها % % 28(@)(@@) % ولئن غلا فيكم تهالكها % % فليكثرن عنكم تعففها % % 29(@)(@@) % سأروغ عن ورد الهوان به % % هي غرفة لا بد أغرفها % % 30(@)(@@) % إن الهضيمة إن أقاد لها % % قدر لعمرك لا أؤثفها % % PageV01P1083 31(@)(@@) % يدنو بنفسي لينها كرما % % ويبين عند الضيم عجرفها % % 32(@)(@@) % قسما برب الراقصات هوى % % أمم البناء العود موجفها % % 33(@)(@@) % يطلبن رابدة الظليم إذا % % طرق الظلام أضل مسدفها % % 34(@)(@@) % بلغت على علل السرى ، وغدت % وملاؤها بالبدن نصفها % % 35(@)(@@) % يغدو على الأرقال مؤتدما % من نيها العامي نفنفها % % 36(@)(@@) % ينجو على رمق مقدمها % % ويقيم معذورا مخلفها % % 37(@)(@@) % وبحيث جعجعت العريب ضحى % % مثل الحني بلى معطفها % % 38(@)(@@) % وبفضل ما أوعى محصبها % % وأقر من قدم معرفها % % 39(@)(@@) % إني على طول الصدود لكم % % كالنفس مأمون تحيفها % % 40(@)(@@) % أرضى وأغضب في حبابكم % ورقاب ودي لا أصرفها % % PageV01P1084 41(@)(@@) % جاءتكم أسلا مشرعة % متوقعا فيكم تقصفها % % 42(@)(@@) % قد بات فيها قائل صنع % % يهمي لهاذمها ويرهفها % % 43(@)(@@) % أعزز علي بأن يكون لكم % % بالأمس ثقفها مثقفها % % 44(@)(@@) % وبراقعا للعار ضافية % يبقى على الأيام مغدفها % % 45(@)(@@) % يجلى لأعينكم مشوهها % % ولقد يكون لكم مفوفها % % 46(@)(@@) % إن تستعيذوا من توسطها % % أعراضكم ، فكفى تطرفها % % 47(@)(@@) % فتزاجروا من قبل أن تردوا % % بموارد . . . . . . ترشفها % % 48(@)(@@) % وتغنموا بطاء عارضها % % من قبل أن يمريه حرجفها % % 49(@)(@@) % فلترجعوا أمما تلومها % % ولتقلعوا ندما توقفها % % PageV01P1085 البحر : طويل 1(@)(@@) % أقول لها بين الغديرين والنقا % % سواد الدجى بيني وبين المناصف % % 2(@)(@@) % خذي الجانب الوحشي لا تتعرضي % % لحي حلال باللوى والأصالف % 3(@)(@@) % أمامك ! إن الخوف حاد مشمر % وما للمطايا مثل حادي المخاوف % 4(@)(@@) % فمرت تظن النسع صوتا أجيله % فلا عذر إلا تتقي بالعجارف % % 5(@)(@@) % وقعت بها في أول الفجر وقعة % % غشاشا ، كما أقضي ألية حالف % 6(@)(@@) % وأشممتها رمل الأنيعم 
ms309	 غدوة % فسافت بأنف منكر غير عارف % % 7(@)(@@) % أحملها الشوق القديم فتنبري % % باجلا دعاني القلب جم المشاغف % % 8(@)(@@) % كثير التفات الطرف في كل مذهب % % بأنة مصدور على البين لاهف % % 9(@)(@@) % إذا ما دعاه الشوق راوح كفه % على لاعج في مضمر القلب لاطف % % 10(@)(@@) % أعاد له البرق الحجازي موهنا % عقابيل أيام اللقاء السوالف % % PageV01P1086 11(@)(@@) % كأن به من خطب ظمياء غصة % يسيغ شجاها بالدموع الذوارف % 12(@)(@@) % كان أثيوابي على ذئب ردهة % % دني الليل فاستثنى رياح التنائف % % 13(@)(@@) % أقومها ، حتى إذا قيل راكب % تظالعت مر المائل المتجانف % 14(@)(@@) % عسفنا بأرقال المطي وطالما % % صبرنا على ضيم العدى والمخاسف % 15(@)(@@) % وما سرني أني أقيم على الأذى % % وأني بدار الهون بعض الخلائف % 16(@)(@@) % فجوبي الملا أو جاوري بي ربيعة % % وأسرة عيلان الطوال الغطارف % % 17(@)(@@) % من البيض ، غران المجالي ، إذا انتدوا % % بدا لك بسامون شم المراعف % % 18(@)(@@) % هناك إذا استلبست ألبست فيهم % جناحي عتيق آمن الظل واجف % 19(@)(@@) % بحيث إذا أعطى الذمام حبالة % علقت بها غير البوالي الضعائف % % 20(@)(@@) % إذا ما طلعت النقب ، والليل دونه % % أمنت العدى إلا تلفت خائف % % PageV01P1087 21(@)(@@) % نجوت فكم من عضة في أنامل % عليك ولهف من قلوب لواهف % % 22(@)(@@) % أتوعدني بالقارعات بجيلة % % لقد ذل من عرضتم للمتالف % 23(@)(@@) % إذا غضبوا للأمر كان وعيدهم % حبيق الألايا وارتعاد الروانف % % 24(@)(@@) % لهم نبعات الشر ينتبلونها % % ضروبا ، فمن بادي عقوق وراصف % 25(@)(@@) % مجاهيل أغفال ، إذا ما تعرضوا % % بأحسابهم أنكرتهم بالمعارف % 26(@)(@@) % وكم أسرة من غيركم ذات شوكة % % دبينا إلى عيدانهم بالقواصف % % 27(@)(@@) % عطفنا إليها بالعوالي أسنة % % شروعا كأذناب الغظاء الدوالف % 28(@)(@@) % وعدنا بها حمرا تقيء صدورها % % دماء العدى قطر الأنوف الرواعف % % 29(@)(@@) % وكنا ، إذا داع دعا لوقيعة % سحبنا لها الأرماح سحب المطارف % 30(@)(@@) % عجبت لذي لونين خالط شيمتي % % فكشفت منه مخزيات المكاشف % % PageV01P1088 31(@)(@@) % ضممت يدي منه وكانت غباوة % % على ضرب مردود من الورق زائف % % 32(@)(@@) % يخاوص عين النار خوفا من القرى % % إذا نار قوم أوقدت بالمشارف % 33(@)(@@) % وإن آنس الأضياف صمت كلبه % % وطأطأ أعناق المطي الصوارف % % 34(@)(@@) % نبذتك 
ms310	 نبذ السن بعد انفصامها % % وإني لمجذام القرين المخالف % 35(@)(@@) % إذا المروء مضته قذاة بطرفه % % فغير ملوم إن رماها بحاذف % 36(@)(@@) % وما أنت من جدي فيرجع راجع % من الرحم البلهاء بعض العواطف % % 37(@)(@@) % حلفت بمن عج الملبون باسمه % عجيج المطايا من منى والمواقف % 38(@)(@@) % عجافا كأوتار الحنايا من الطوى % % على مثل أعجاس القسي العطائف % % 39(@)(@@) % طوى الضمر من أجوافها بعدما انتهت % ثمائلها ، طي البرود اللطائف % 40(@)(@@) % ترى كل مجهود ، إذا منه السرى % % أكب على السرجين إكباب راعف % PageV01P1089 41(@)(@@) % ورب الهدايا المشعرات نكبها % % عجالا ورب الراقصات الخوانف % % 42(@)(@@) % وما بالصفا من حالق ومقصر % ومن ماسح ركن العتيق وطائف % % 43(@)(@@) % وساع إلى أعلام جمع ، ودافع % وماش على جنبي الآل وواقف % % 44(@)(@@) % لأعراضكم عندي أشد مهانة % من الحنظل العامي عند النواقف % 45(@)(@@) % فلا تستهبوا الشر من رقداته % % فيسحتكم سحت السنين الخوالف % 46(@)(@@) % قوافي يقطرن السمام كأنها % % ملاغم حيات الرمال الزواحف % % 47(@)(@@) % فكم حمضة منكم لنا بقرارة % يعود إليها ناشط بعد قاطف % 48(@)(@@) % وإياكم أن تحملوا من قوارضي % % على ظهر زعراء الملاطين شارف % 49(@)(@@) % تخب بجانيكم وفي كل ساعة % % يتاح لها منكم براق ورادف % % 50(@)(@@) % دعوا السلف القمقام تسري رفاقه % % لنيل المعالي ، واقعدوا في الخوالف % PageV01P1090 51(@)(@@) % وذاك أديم لم تكونوا سراته % % بلى ربما استأثرتم بالزعانف % % 52(@)(@@) % تغطوا ولا تستكشفوني عواركم % % فما جلبة إلا لها ظهر قارف % 53(@)(@@) % وإن مدت الأيام بيني وبينكم % أطلت بكاء العاجز المتهاتف % % PageV01P1091 البحر : بسيط تام 1(@)(@@) % الله يعلم ميلي عن جنابكم % ولو تناهيت لي في البر واللطف % 2(@)(@@) % فكيف بي وعلى عينيك ترجمة % % من الحقود وعنوان من الشنف % % 3(@)(@@) % أطيف منك بوجه غير ملتفت % % إلى المناجي وعطف غير منعطف % % 4(@)(@@) % فما أغبك من عذر ولا شغل % ولا أزورك من وجد ولا شغف % 5(@)(@@) % قد كان قبلك مرجو فواضله % راق إلى المجد طلاع إلى الشرف % 6(@)(@@) % تمر نفحة نعماه ، إذا خطرت % من القبول بجنبي روضة أنف % % 7(@)(@@) % إن تستعضك المعالي بعد ذاك فقد % % أفحشن في بدل منه وفي خلف % % 8(@)(@@) % يهتن للمرء 
ms311	 تفريه أظافره % % كما تهش سباع الطير للجيف % % 9(@)(@@) % إذا نجا من يديه غير منعقر % أفنى أنامله عضا من الأسف % 10(@)(@@) % يظن أني وصال به سببي % % إني إذا من أمير المؤمنين نفي % % PageV01P1092 11(@)(@@) % إذا لبست جمالا أنت ملبسه % % فإنني قد طرحت المجد عن كتفي % % 12(@)(@@) % لا قدس الله نفسا منك جامعة % كيد البغال إلى ذي الجلة الشرف % 13(@)(@@) % ولا سقي الغيث دارا أنت ساكنها % % إلا بأغبر ناري الذرى قصف % PageV01P1093 البحر : كامل تام 1(@)(@@) % لمن الحدوج تهزهن الأنيق % % والركب يطفو في السراب ويغرق % 2(@)(@@) % يقطعن أعراض العقيق ، فمشئم % يحدو ركائبه الغرام ومعرق % % 3(@)(@@) % أبقوا سيرا بعدهم لا يفتدى % % مما يجن وطالبا لا يلحق % % 4(@)(@@) % يهفو الولوع به فيطرف طرفه % % ويزيد جولان الدموع ، فيطرق % 5(@)(@@) % ووراء ذاك الخدر عارض مزنة % % لا ناقع ظمأ ولا متألق % % 6(@)(@@) % ومحجب ، فإذا بدا من نوره % للركب ملتهب المطالع مونق % 7(@)(@@) % خروا على شعب الرحال وأسندوا % % أيدي الطعان إلى قلوب تخفق % 8(@)(@@) % هل عهدنا بعد التفرق راجع % أو غصننا بعد التسلب مورق % % 9(@)(@@) % شوق أقام وأنت غير مقيمة % % والشوق بالكلف المعنى أعلق % 10(@)(@@) % ما كنت أحظى في الدنو فكيف بي % % واليوم نحن مغرب ومشرق % % PageV01P1094 11(@)(@@) % من أجل حبك قلت عاود أنسه % ذاك الحمى وسقي اللوى والأبرق % 12(@)(@@) % طرق الخيال ببطن وجرة بعدما % % زعم العواذل أنه لا يطرق % 13(@)(@@) % أتحننا بعد الرقاد وقسوة % % أيام أصفيك الوداد وأمذق % 14(@)(@@) % إني اهتديت وما اهتديت وبيننا % % سور علي من الطعان وخندق % % 15(@)(@@) % ومطلحين لهم بكل ثنية % ملقى وسادته الثرى والمرفق % % 16(@)(@@) % أو قابضين على الأزمة ، والكرى % % يغشى أكفهم النعاس ، فتمرق % 17(@)(@@) % أوموا إلى الغرض البعيد فكلهم % % ماض يخب مع الرجاء ويعنق % % 18(@)(@@) % وإلى أمير المؤمنين نجت بهم % % ميل الجماجم سيرهن تدفق % % 19(@)(@@) % كنقانق الظلمان أعجلها الدجى % % وحدا بها زجل الرواعد مبرق % 20(@)(@@) % يطلبن زائدة المكارم والندى % % حيث استقر بها العلاء المعرق % % PageV01P1095 21(@)(@@) % الزاخر الغدق الذي يروى به % ظمأ المنى ، والوابل المتبعق % 22(@)(@@) % أبغاة هذا المجد إن مرامه % دحض يزل الصاعدين ويزلق % 23 
ms312	(@)(@@) % هيهات ظنكم تمرد مارد % % من دون نيلكم ، وعز الأبلق % 24(@)(@@) % لا حرجوا هذي البحار فربما % % كان الذي يروي المعاطش يغرق % 25(@)(@@) % ودعوا مجاذبة الخلافة ، إنها % % أرج بغير ثنائهم لا يعبق % 26(@)(@@) % غنيت بهم تحتز دون منالها % % قمم العدى ويرد عنها الفيلق % % 27(@)(@@) % كعقائل الأبطال تجلب دونها % % بيض القواضب والقنا المتدقق % % 28(@)(@@) % فهم لذروتها التي لا ترتقي % % أبدا وبيضتها التي لا تفلق % % 29(@)(@@) % أشفت فكنت شفائها ولقد ترى % % شلوا بأظفار العدو يمزق % % 30(@)(@@) % كنت الصباح رمى إليها ضوءه % % ومضى بهبوته الظلام الأورق % % PageV01P1096 31(@)(@@) % فسنامها لا يمتطى ونباتها % % لا يختلى ، وفناؤها لا يطرق % 32(@)(@@) % ووزنت بالقسطاس غير مراقب % والعدل مهجور الطريق مطلق % 33(@)(@@) % في كل يوم للعدو ، إذا التوى % % بظباك يوم أوارة ومحرق % 34(@)(@@) % أنتم موادع كل خطب يتقى % % 35(@)(@@) % وأبوكم العباس ما استسقى به % % بعد القنوط قبائل إلا سقوا % % 36(@)(@@) % بعج الغمام بدعوة مسموعة % % فأجابه شرق البوارق مغدق % 37(@)(@@) % ما منكم إلا ابن أم للندى % % أو مصبح بدم مصبح بدم الأعادي مغبق % % 38(@)(@@) % لله يوم أطلعتك به العلى % % علما يزاول بالعيون ويرشق % % 39(@)(@@) % لما سمت بك غرة موموقة % % كالشمس تبهر بالضياء وتومق % % 40(@)(@@) % وبرزت في برد النبي وللهدى % % نور على اطرار وجهك مشرق % % PageV01P1097 41(@)(@@) % وعلى السحاب الجود ليث معظما % ذاك الرداء وزر ذاك اليلمق % % 43(@)(@@) % في موقف تغضي العيون جلالة % فيه ، ويعثر بالكلام المنطق % 44(@)(@@) % وكأنما فوق السرير ، وقد سما % % أسد على نشزات غاب مطرق % % 45(@)(@@) % والناس إما راجع متهيب % % مما رأى أو طالع متشوق % % 46(@)(@@) % مالوا إليك محبة ، فتجمعوا % % ورأوا عليك مهابة ، فتفرقوا % % 47(@)(@@) % وطعنت من غرر الكلام بفيصل % % لا يستقل به السنان الأزرق % % 48(@)(@@) % وغرست في حب القلوب مودة % تزكو على مر الزمان وتورق % % 49(@)(@@) % وأنا القريب إليك فيه ودونه % % ليدي عدوك طود عز أعنق % 50(@)(@@) % عطفا ، أمير المؤمنين ، فإننا % % في دوحة العلياء لا نتفرق % 51(@)(@@) % ما بيننا ، يوم الفخار ، تفاوت % % PageV01P1098 52(@)(@@) % إلا الخلافة ميزتك ، فإنني % % أنا عاطل منها ، وأنت مطوق % PageV01P1099 البحر : رجز تام 1(@)(@@) % رأى على الغور وميضا 
ms313	 فاشتاق % % ما أجلب البرق لماء الآماق % % 2(@)(@@) % ما للوميض ، والفؤاد الخفاق % قد ذاق من بين الخليط ما ذاق % 3(@)(@@) % داء غرام ما له من إفراق % قد كل آسيه ، وقد مل الراق % 4(@)(@@) % لآل ليلى في الفؤاد أعلاق % تزيد من حيث تقضى الأشواق % % 5(@)(@@) % قامت ترآئيك بقلب مقلاق % % وللوداع عجل وإرهاق % 6(@)(@@) % من ثقب الدر النقي براق % % يرمي القلوب وأسيلا رقراق % % 7(@)(@@) % يقوم لليل مقام الإشراق % حي إذا قام الوغي على ساق % % 8(@)(@@) % ردوا القنا وطاعنوا بالأحداق % % أحبهم على الضنا والإيراق % % 9(@)(@@) % حب الضنين المال بعد الإملاق % أن مودات القلوب أرزاق % % 10(@)(@@) % من منصفي من الملول المذاق % % قلبي وطرفي من جوى وإقلاق % PageV01P1100 11(@)(@@) % في غرق ما ينقضي وإحراق % يضن حتى بالخيال الطراق % % 12(@)(@@) % رمى الإله بالرميض الذلاق % كل غراب بالزيال نعاق % 13(@)(@@) % يا ناق أداك المؤدى يا ناق % % ماذا المقام والفؤاد قد تاق % % 14(@)(@@) % هل حاجة المأسور إلا الاطلاق % % ألهاك عن ليل السرى والإعناق % 15(@)(@@) % مناشط الشيح ورعي الطباق % % سيري إلى ورد الجموم الفهاق % % 16(@)(@@) % حمل المساعي غير حمل الأوساق % بحيث تسري للعلاء أعراق % % 17(@)(@@) % نور الغواشي ومساك الأرماق % من مشعر باتوا بليل العشاق % % 18(@)(@@) % إلى المعالي والندى بالأشواق % % كانوا إذا أظلم ليل الطراق % 19(@)(@@) % شهب الدياجي ونجوم الآفاق % % بيض وجوه كالظبى وأعناق % % 20(@)(@@) % أطوع من تيجانها والأطواق % سيان منهم سابق ولحاق % PageV01P1101 21(@)(@@) % من قاد غير المجد منهم أو ساق % % مهلا إلى أين الصعود يا راق % 22(@)(@@) % ضل المجارون وقام السباق % % لم يلحقوا يوما غبار الاطلاق % % 23(@)(@@) % إلا قذى لناظر ، أو حملاق % قد رجعوا عنك بلي الأعناق % 24(@)(@@) % هيهات فات الأعوجي المعناق % % سهم من الله بعيد الأغراق % % 25(@)(@@) % أعطى ديون القوم خصل الأسباق % مسعاة مجد عاق عنها ما عاق % 26(@)(@@) % خطبتها على النجيع المهراق % غراء ما ناكحها بمطلاق % 27(@)(@@) % ليس لها إلا الجراز الذلاق % يضرحها ضرح القذى من الماق % 28(@)(@@) % ضربا أخاديد وطعنا شهاق % % نائي القرارات بعيد الأعماق % 29(@)(@@) % يذكرنا وابل طعن دفاق % % 30(@)(@@) % جماجما من العريب اقلاق % % أنذرتهم وثب هريت 
ms314	 الاشداق % % PageV01P1102 31(@)(@@) % طوى من الدماج طي المخراق % % صل على حتف العدو مطراق % 32(@)(@@) % محاذر اللحظ مرجى الإطلاق % سحائب تشئم بعد أعراق % % 33(@)(@@) % لنا حياها والزلال الغيداق % % وللعدى إرعادها والإبراق % 34(@)(@@) % في كل يوم ذو الجلال الخلاق % يبري لقوس المجد منكم أفواق % % 35(@)(@@) % ارقني طولك بعد الاعتاق % % أساغ ريقي والخناق قد ضاق % % 36(@)(@@) % فأنعم بنيروز إليك مشتاق % % والق به من خير ما يلقى اللاق % 37(@)(@@) % فما وقيت ، فالعدى بلا واق % عهد على الأيام باقي الميثاق % 38(@)(@@) % أن لا يرى غصنك ذاوي الأوراق % % ضوا من الأثمار بعد الإيراق % % 39(@)(@@) % ما أهون الفاني إذا كنت الباق % % PageV01P1103 البحر : مجزوء الرمل 1(@)(@@) % خل دمعي وطريقه % أحرام أن أريقه % 2(@)(@@) % كم خليط بأن عني % % ما قضى الدمع حقوقه % % 5(@)(@@) % من لبرق هب وهنا % من أبانين وسوقه % 7(@)(@@) % من غمام كالمتالي % % وخيال دلس القل % 8(@)(@@) % لاح فاقتاد فؤادا % قي على النأي وريقه % 10(@)(@@) % ومغاوير الحفيظا % % مك أعياد الخليقه % 20(@)(@@) % وملوك في ثراهم % % رج للدين مضيقه % 26(@)(@@) % بوجوه واضحات % ه ، إذا ضل طريقه % 27(@)(@@) % وأكف منفقات % ب على العين طروقه % 28(@)(@@) % وبأخلاق رقاق % % دون أعراض صفيقه % % PageV01P1104 35(@)(@@) % طعن فوار الوديقه % عز قدما وفريقه % 38(@)(@@) % احذر الشمس بجون % % يعجل الليل غسوقه % 39(@)(@@) % جلب الخيل ليوم % ض أراب مستذيقه % 40(@)(@@) % مطلت بالرعد حتى % % نسي القود عليقه % % 42(@)(@@) % كل صدر بالعوالي % % يسمع الطعن شهيقه % % 43(@)(@@) % في هجير من أوار ال % % بالأسابي عميقه % 45(@)(@@) % يا قوام الدين والفا % % هامهم غير مفيقه % % 49(@)(@@) % سبق السيل فأعيا % % كل باغ أن يعوقه % % 50(@)(@@) % لا تعاط اليوم عبأ % ب يدمى ، ودقيقه % 52(@)(@@) % حسب الأوشال جهلا % كالعياليم العميقه % PageV01P1105 53(@)(@@) % ومدى الجازر تدمى % % كالمباتير الرقيقه % % 57(@)(@@) % في معال باقيات % % للعدا غير مذيقه % % 58(@)(@@) % واثقا بالدهر تعطى % % من رزاياه وثيقه % % 61(@)(@@) % آمن المرتع ترعى % % فيلق جر على أر % 64(@)(@@) % إن نعاق الأعادي % % ي ، وإن كنت سحيقه % 65(@)(@@) % م إلى الظئر الشفيقه % ف ، وأطوادا زليقه % PageV01P1106 البحر : كامل تام 1(@)(@@) % يا دار ما طربت إليك النوق % إلا وربعك شائق ومشوق % % 2 
ms315	(@)(@@) % جاءتك تمرح في الأزمة والبرى % % والزجر ورد والسياط عليق % 3(@)(@@) % وتحن ما جد المسير كأنما % % كل البلاد محجر وعقيق % % 4(@)(@@) % دار تملكها الفراق فرقها % % بالمحل من أسر الغمام طليق % % 5(@)(@@) % شرقت بأدمعها المطي كأنما % % فيها حنين اليعملات شهيق % 6(@)(@@) % خفقت يمانية على أرجائها % % وطغت عليها زعزع وخربق % % 7(@)(@@) % في كل أصباح وكل عشية % % يسري عليها للدموع فريق % % 8(@)(@@) % سخط الغراب على المساقط بينها % % فله بأنجاز الفراق نعيق % % 9(@)(@@) % فتوزعت تلك القذاة نواظر % % وتقسمت تلك الشجاة حلوق % 10(@)(@@) % الآن أقبل بي الوقار عن الصبا % % فغضضت طرفي والظباء تروق % % PageV01P1107 11(@)(@@) % ولو أنني لم أعط مجدي حقه % % أنكرت طعم العز حين أذوق % 12(@)(@@) % رمت المعالي فامتنعن ولم يزل % % أبدا يمانع عاشقا معشوق % 13(@)(@@) % وصبرت حتى نلتهن ولم أقل % % ضجرا دواء الفارك التطليق % % 14(@)(@@) % ما كنت أول من جثا بقميصه % % عبق الفخار وجيبه مخروق % % 15(@)(@@) % كثرت أماني الرجال ، ولم تزل % متوسعات ، والزمان يضيق % 16(@)(@@) % من كل جسم تقتضيه حفرة % % فكأنه من طينها مخلوق % % 17(@)(@@) % ومفازة تلد الهجير خرقتها % % والأرض من لمع السراب بروق % 18(@)(@@) % بنجاء صامتة البغام كأنها % % والآل يركض في الفلاة فنيق % % 19(@)(@@) % سبقت إليك العزم طائشة الخطى % % فنجت وأعناق المطي تفوق % % 20(@)(@@) % جذبت بضبعي من تهامة قاصدا % والنجم في بحر الظلام غريق % % PageV01P1108 21(@)(@@) % مستشريا برقا تقطع خيطه % فله عن طرر البلاد شروق % % 22(@)(@@) % هز المجرة أفقه وكأنها % % غصن بأحدق النجوم وريق % % 24(@)(@@) % والليل محلول النطاق عن الضحى % % عار ، وعقد الصبح فيه وثيق % 25(@)(@@) % ما كان الأهجعة حتى انثنى % % والطرف من سكر النعاس مفيق % % 26(@)(@@) % وتماسكت تلك العمائم بعد ما % % أرخى جوانبها كرى وخفوق % 27(@)(@@) % ما رفهت ركباتها إلا وفي % % جلد الظلام من الضياء خروق % % 28(@)(@@) % يا ناق عاصي من يماطلك السرى % % فلحيق غيرك بالعقال خليق % 29(@)(@@) % وردي حياض فتى معد كلها % % فالحبل اتلع والقليب عميق % % 30(@)(@@) % وإذا تراخت حبوتي أوثقتها % % بفناء بيت تربه العيوق % % 31(@)(@@) % في بلدة حرم على أعدائه % % وعلى النوائب ربوة إزليق % PageV01P1109 32(@)(@@) % تتزاحم الأضياف في أبياته % % فرقا تحن إلى 
ms316	 القرى وتتوق % 33(@)(@@) % وإذا رآهم لم يقل متمثلا % أبنى الزمان لكل رحب ضيق % % 34(@)(@@) % عجبا لربعك كيف تخصب أرضه % % وجنابه بدم السوام شريق % 35(@)(@@) % والخيل تعلم أن حشو ظهورها % % منه نهى ينجاب عنها الموق % % 36(@)(@@) % ما زال يجنبها إلى أعدائه % والشمس تسحب والفلاة تضيق % % 37(@)(@@) % من كل رقاص كأن صهيله % نغم وما مج الطعان رحيق % % 38(@)(@@) % طرف تعود أن يخلق وجهه % % في حيث ينضو النقع وهو سبوق % 39(@)(@@) % ذو جلدة حمراء تحسب أنها % % من طول تخليق الرهان خلوق % % 40(@)(@@) % واليوم ملطوم السوالف بالظبا % % والليل مرتعد النجوم خفوق % 41(@)(@@) % لقطت نفوسهم شفاه صوارم % % فرغت وأسياف العوامل روق % PageV01P1110 42(@)(@@) % في كل يوم يندبون مصارعا % للوحش فيها والنسور طروق % 43(@)(@@) % نشوانة الأعطاف من دم فتية % فيهم صبوح للردى وغبوق % % 44(@)(@@) % تبكي عليها غير راحمة لها % % بالهاطلات رواعد وبروق % 45(@)(@@) % طلعت وفي سجف % الغيوب فتوق % 46(@)(@@) % ويكر والفرس الجواد مبلد % % ويقد والعضب الحسام معوق % 47(@)(@@) % كرات من شدت قوائم عزمه % % فلها رسيم في العلى وعنيق % % 48(@)(@@) % كفاه ادبتا السهام فما لها % % في النبض عن خطإ البنان مروق % 49(@)(@@) % لولا احتذاء السهم طاعة قوسه % ما شيع النصل المصمم فوق % 50(@)(@@) % يدني الحمام بكفه مترسل % % لقضائه نائي السنان رشيق % % 51(@)(@@) % نفضت على الأيام منه شمائل % ابرزن وجه الدهر وهو طليق % % PageV01P1111 52(@)(@@) % وأقام أسواق الضراب فللردى % % فيهن من سبي النفوس رقيق % % 53(@)(@@) % نفسي فداؤك أي يوم لم تقم % % لك فيه من جلب القواضب سوق % 54(@)(@@) % قمر يهاب الموت ضوء جبينه % % واليوم خوار العجاج غسوق % % 55(@)(@@) % والسيف ليس يهاب قبل قراعه % % حتى يمس العين منه بريق % 56(@)(@@) % عشق السماح وكل سحر للمنى % % فيه بأنفاث السؤال يحيق % 57(@)(@@) % طهرت قلبي مذ علمت بأنه % % لترى مدائحه العظام طريق % % 58(@)(@@) % كم كاهل للشعر أثقل نعته % % عطفيه وهو لما يؤد مطيق % % 59(@)(@@) % طأطأت فرع المجد ثم جنيته % % فارتد وهو على عداك سحوق % 60(@)(@@) % فرع أشار إلى السماء فجازها % % حتى كأن له النجوم عروق % % 61(@)(@@) % ومبخل شهدت عليه يمينه % في حيث يمنعها الندى 
ms317	 ويعوق % PageV01P1112 62(@)(@@) % يبكي إذا بكت السحاب كأنه % % أبدا على طرف الغمام شفيق % 63(@)(@@) % وإذا تعرض عارض أغضى له % % ألا يرى الأنواء كيف تريق % 64(@)(@@) % لو أبدت الأيام جانب وجهه % لتشبثته مظالم وحقوق % % 65(@)(@@) % إن سار سار إلى النزال بخفية % حتى كأن سلاحه مسروق % % 66(@)(@@) % بيت أقام البخل فيه فاستوى % % بفنائه المحروم والمرزوق % % 67(@)(@@) % يرجو بلوغ نداك وهو محقق % % مع حرصه أن الجواد عتيق % % 68(@)(@@) % في الطينة البيضاء غرسك أنه % % غرس تداوله البقاع عريق % 69(@)(@@) % فإذا التثمت فكل وجه باسل % % وإذا حسرت فكل خد روق % % 70(@)(@@) % الله جارك ، والمطي جوائر % والنصر درعك ، والحسام ذليق % 71(@)(@@) % لا زلت تجنب من سيوفك في العدى % % نحرا يخب وراءه التشريق % PageV01P1113 72(@)(@@) % وإذا جهرت بصوت عزمك مسمعا % أصغى إليك اليمن والتوفيق % 73(@)(@@) % شرفت مدحي فاعتلى بك طوده % ومن المدائح فائق ومفوق % % 74(@)(@@) % شهدت له خيل الخواطر أنه % خير الصهيل ، وما سواه نهيق % PageV01P1114 البحر : كامل تام 1(@)(@@) % لو صح أن البين يعشقه % ما استعبرت في السير أينقه % % 2(@)(@@) % قمر على غصن يرنحه % مر اللحاظ وليس يرشقه % % 3(@)(@@) % طأطأت لحظ العين حين خطا % % والبين يرمقني ويرمقه % 4(@)(@@) % واذبت دمعي يوم ودعني % % في صحن خد ذاب رونقه % % 5(@)(@@) % ودعته والبدر تحسبه % % متقاعسا في الفجر أعنقه % 6(@)(@@) % والليل يكبو فيه أدهمه % والصبح ينهض منه أبلقه % 7(@)(@@) % واللثم يركض في سوالفه % وتكاد خيل الدمع تسبقه % 8(@)(@@) % ما غرني يوم اللقاء ولا % % خدع ارتياح هواي ريقه % % 9(@)(@@) % وعلمت حين نشرت مطرفه % % إن الفراق غدا يمزقه % % 10(@)(@@) % بكت الجفون ، وأنت طارفها % % وشكا الفؤاد وأنت محرقه % % PageV01P1115 11(@)(@@) % ودي لخير الناس أذخره % % ما كل ود فيك أنفقه % 12(@)(@@) % ود تقادم عهده فصفا % % وجديد ود المرء أخلقه % 13(@)(@@) % لمشمر الأطراف منزعج % % الاعطاف يهجعه تأرقه % % 14(@)(@@) % لأغر تعشي الشمس غرته % % ويشق جيب الليل مشرقه % % 15(@)(@@) % يسري فتحجبه خلائقه % % ويضيء أوجهها تخلقه % 16(@)(@@) % أبدت خبي المجد طلعته % وأذاع سر المجد منطقه % 17(@)(@@) % ولقلما شرقت أسنته % إلا وصفو الحمد يشرقه % % 18(@)(@@) % وإذا استرق المحل مرتبعا % أمر السحاب الجون يعتقه 
ms318	 % 19(@)(@@) % وإذا تأمل شخصه ملك % أوما إلى قدميه مفرقه % 20(@)(@@) % في كفه عارى الذباب له % % لمع يدلك كيف ترمقه % % PageV01P1116 21(@)(@@) % أطغاه رونق غربه ، فطغى % % والماء يطغيه ترقرقه % % 22(@)(@@) % جذلان يرقص في الرؤوس إذا % % غنته بالصهلات سبقه % 23(@)(@@) % صلى الردى لو يستطيع إلى % % نصل براحته مخلقه % % 24(@)(@@) % يؤوي الضيوف ودون حجرته % % باب على الأحداث يغلقه % 25(@)(@@) % وإذا النوائب زعزعت يده % % في الطعن جاءته تملقه % % 26(@)(@@) % عريان خيل الغدر من دنس % % لا يستطيع الغدر يعلقه % % 27(@)(@@) % الجود ينهاه ويأمره % % والدهر يرجوه ويفرقه % 28(@)(@@) % هو قادر لكن صولته % في البطش يصرعها ترفقه % % 29(@)(@@) % ولرب مجهول ركائبه % خلف الرياح الهوج تخرقه % 30(@)(@@) % قلقلت بالأجفاف تربته % والقيظ عن أمم يحرقه % PageV01P1117 31(@)(@@) % ذمتك ربوته ووهدته % % وشكاك فدفده وسملقه % % 32(@)(@@) % ولرب ورد بت قاربه % لا يطمئن به تدفقه % 33(@)(@@) % والماء يرعد في جوانبه % % جزعا وظمء العيس يشرقه % % 34(@)(@@) % لما لحظت الدهر زايله % أظلامه وافتر ضيقه % % 35(@)(@@) % ساورته ، ففضضت سورته % وارتاح في نعماك مملقه % 36(@)(@@) % وكذاك هم الريح في غصن % تثنيه ، أو ماء تصفقه % 37(@)(@@) % لما رآك الملك منصلتا % بالسيف ترعده وتبرقه % 38(@)(@@) % استنكف التعديل مايله % % واسترجع التحكيم أخرقه % % 39(@)(@@) % أفل السماح وأنت شارقه % % ودجا العلاء وأنت مشرقه % % 40(@)(@@) % ولرب يوم شمت بارقه % والموت يهطله ويودقه % PageV01P1118 41(@)(@@) % والسيف قائمه يفارقه % والرمح عامله يطلقه % % 42(@)(@@) % والشمس تجري وهي مهملة % % في ثوب نقع لا تخرقه % 43(@)(@@) % والخيل تطبع في حوافرها % % وشما تداوله ، وتخلقه % 44(@)(@@) % من كل ذيال السبيب رمى % % بيديه أولى النقع أولقه % % 45(@)(@@) % أشليت عزمك في كتائبه % % والسهم يشليه مفوقه % % 46(@)(@@) % فاسلم على الأيام تلبسها % % فالدهر ثوب أنت مخلقه % PageV01P1119 البحر : طويل 1(@)(@@) % بود الرذايا أنها في السوابق % % وكم للعلى من طالب غير لاحق % % 2(@)(@@) % وفي شدة الدهر اعتبار لعاقل % وفي لذة الدنيا غرور لواثق % 3(@)(@@) % أرى العيش أياما تمر وليثنا % % نباعد من أحداثها والبوائق % % 4(@)(@@) % شهي إلى الناس النجاء من الردى % % ولا عنق إلا وهي في فتر خانق % 5(@)(@@) % مستريح من الجوى % % كاذب الود ماذق % % 5(@)(@@) % وأكثر من شاورته 
ms319	 غير حازم % % وأكثر من صاحبت غير الموافق % % 6(@)(@@) % إذا أنت فتشت القلوب وجدتها % % قلوب الأعادي في جسوم الأصادق % 6(@)(@@) % ل غير الموافق % من جميع الخلائق % % 7(@)(@@) % وعندي من الود الذي لا يشوبه % % لحاظ المرائي أو كلام المنافق % 8(@)(@@) % أغالط نفسي بعد مرأى ومسمع % ولا أنظر الدنيا بعين الحقائق % % PageV01P1120 9(@)(@@) % على أنني أدري ، إذا كان قائدي % % بقائي ، فإن الموت لا شك سائقي % % 10(@)(@@) % وما جمعي الأموال إلا غنيمة % % لمن عاش بعدي واتهاما لرازقي % % 11(@)(@@) % تنفس في رأسي بياض كأنه % صقال تراق في النصول الروانق % 12(@)(@@) % وما جزعي إن حال لون وإنما % % أرى الشيب عضبا قاطعا حبل عاتقي % % 13(@)(@@) % فما لي أذم الغادرين ، وإنما % % شبابي أدنى غادر بي وماذق % % 14(@)(@@) % % ومن لي أن يبقى بياض المفارق % 15(@)(@@) % وإن وراء الشيب ما لا أجوزه % بعائقة تنسي جميع العوائق % 16(@)(@@) % وليس نهار الشيب عندي بمزمع % رجوعا إلى ليل الشباب الغرانق % % 17(@)(@@) % وما العز إلا غزوك الحي بالقنا % % وربط المذاكي في خدور العواتق % % 18(@)(@@) % وإغمادك الأسياف في كل هامة % وركزك أطراف القنا في الحمالق % % PageV01P1121 19(@)(@@) % ولا ترتضي أن تدنس العرض ساعة % % ومشيك في ثوب من الزين رائق % % 20(@)(@@) % فللعز ما أدنى لياني من القنا % % وأكره رمحي في صدور الفيالق % 21(@)(@@) % سقى الله نفسا ما أضر بقاؤها % % بجسمي ، وأغراها بما كان عارقي % % 22(@)(@@) % تكلفني سيرا إلى غير غاية % مضرا بأبناء الجديل ولاحق % % 23(@)(@@) % وليل كعين الظبى إلا نجومه % % 24(@)(@@) % جريا على الظلماء حتى كأنني % % أراها بألحاظ الرزايا الطوارق % 25(@)(@@) % وركب أناخوا ساعة ، فتناهبوا % % ثرى البيد في أعضادهم والمرافق % % 26(@)(@@) % وساروا بأيدي العيس عجلى كأنها % % خراطم أقلام جرت في المهارق % % 27(@)(@@) % وما أنا ممن يضجر السير قلبه % % وتذكره الأمواه حر الودائق % % 28(@)(@@) % ولكن شريك الوحش في كل مهمة % % وردف الليالي في الربى والأبارق % PageV01P1122 29(@)(@@) % رعى الله من فارقت من غير رغبة % % على الوجد مني والسقام المطابق % 30(@)(@@) % يباعد عني من غرامي لأجله % ويقرب من قلبي له غير وامق % 31(@)(@@) % إذا شئت أن لا تهجر الهم فاغترب % % وإن 
ms320	 شئت أن يأتي الحمام ففارق % 32(@)(@@) % فكل غريب يألف الهم قلبه % ولا سيما قلب الغريب المفارق % 33(@)(@@) % فكيف بطرف لحظه لحظ مدنف % % سقيم وجسم قلبه قلب عاشق % % 34(@)(@@) % إذا كنت ممن يجحد الشوق في النوى % % فكم فاض دمعي من حنين الأيانق % 35(@)(@@) % وكم أنا وقاف على كل منزل % وكم أنا مرتاح إلى كل بارق % 36(@)(@@) % أحن إلى من لا يحن صبابة % وما واجد قلبا مشوق وشائق % % 37(@)(@@) % وعندي من الأحباب كل عظيمة % % تزهد في قرب الضجيع المعانق % % 38(@)(@@) % تعطلت الأحشاء من كل أنة % % فلا القرب يضنيني ولا البعد شائقي % % PageV01P1123 39(@)(@@) % وما في الغواني من سرور لناظر % ولا في الخزامى من نسيم لناشق % 40(@)(@@) % رمى الله بي من هذه الأرض غيرها % % وقطع من هذا الأنام علائقي % % 41(@)(@@) % فكم فيهم من واعد غير منجز % وكم فيهم من قائل غير صادق % % 42(@)(@@) % يظنون أن المجد فيمن له الغنى % % وأن جميع العلم فضل التشادق % % 43(@)(@@) % وفاء كأنبوب اليراع لصاحب % وغدر كأطراف الرماح الزوالق % 44(@)(@@) % ولولا ابن موسى لم يكن في زماننا % % معاذ لجان أو محل لطارق % % 45(@)(@@) % ولا دبرت سمر القنا كف فارس % % ولا مد في رزق المنى باع رازق % % 46(@)(@@) % تغمدنا من كل أرض بنفحة % وأمطرنا من كل جو بوادق % % 47(@)(@@) % إذا هم لم يبعد به زجر زاجر % % وإن ثار لم يعطف به نعق ناعق % % 48(@)(@@) % وإن رام أملاك البلاد بفتكة % % مشى الذل في تيجانها والمناطق % PageV01P1124 49(@)(@@) % له العز والمجد التليد وراثة % وأخذا عن البيض الظبى والسوابق % 50(@)(@@) % وما زال يلقى كل غبراء فخمة % % تغالى بأطراف القنا والعقائق % % 51(@)(@@) % وما برحت في عصر سيوفه % % مواضع تيجان الرجال البطارق % % 52(@)(@@) % يجردها مثل الأقاحي على الطلى % % ويغمدها محمرة كالشقائق % % 53(@)(@@) % تبلغه أقصى الأماني رماحه % وآراؤه ، والرأي أمضى مرافق % 54(@)(@@) % وخيل كأطراف العوالي جريئة % على الطعن مسقاة دماء الموارق % % 55(@)(@@) % إذا عن طرد أو طراد تبادرت % % طراد الأعادي قبل طرد الوسائق % 56(@)(@@) % تدير عيونا بدد الروع لحظها % % وغطى مآقيها غبار السمالق % 57(@)(@@) % نواصب آذان إلى كل 