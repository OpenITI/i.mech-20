ms61	 إذا تشاجرت العوالي % % يفر من الفرار إلي القتال % % 25(@)(@@) % وكم كسبته جرد الخيل مجدا % وليس لهن منه سوى الكلال % % 26(@)(@@) % يوسطها الوشيج وفي كلاها % % أنابيب من الأسل الطوال % % 27(@)(@@) % يتابع جوده ويظن بخلا % وفوق الجود أغراس الفعال % % 28(@)(@@) % كأن صلاته لهم صلاة % فليس تتم إلا أن يوالي % % 29(@)(@@) % مكارم ما ألم بها كريم % سواه ولا خطرن له ببال % % 30(@)(@@) % ورثت الفضل عن جد فجد % إلى هود النبي على التوالي % % PageV01P187 31(@)(@@) % تنقل من كريم في كريم % كما ارتمت المنازل بالهلال % % 32(@)(@@) % نصرت ابن النبي كما نصرتم % % أباه لقد حذوت على مثال % % 33(@)(@@) % فإن حاربت فيه فرب حرب % % لكم في نصرة التقوى سجال % % 34(@)(@@) % فزين مجدك الحقب البواقي % % ومجد جدودك الحقب الخوالي % % 35(@)(@@) % وجود الناس من موجود طي % وجودهم لجود بنيك تال % 36(@)(@@) % يسومون النفوس بكل عضب % % يكل فيرخص المهج الغوالي % % 37(@)(@@) % إذا أبصرتهم فوق المذاكي % % رأيت الأسد من فوق السعالي % % 38(@)(@@) % كأنهم عليها وهي تعدو % % لؤام الريش من فوق النبال % % 39(@)(@@) % إذا ابتدروا إلى الهيجاء قلنا % % سهام يبتدرن إلى نصال % % 40(@)(@@) % بأيمان كأبحرها غزار % % وأحلام كأجبلها ثقال % % PageV01P188 41(@)(@@) % رأيت الناس مثل كعوب رمح % % فمنهن السوافل والأعالي % % 42(@)(@@) % ومن ذا يستطيع وأي قلب % % بجيش الفخر يفخر في مقال % % 43(@)(@@) % وحاتم طيء لك عن يمين % وزيد الخيل منك على الشمال % % 44(@)(@@) % وهذان اللذان يقر طوعا % بفضلهما المخالف والموالي % % 45(@)(@@) % وفيك عن القديم غنى ويغني % % ضياء الصبح عن شعل الذبال % % 46(@)(@@) % إذا ما جاء شمس الدين غطى % % سناه كل شمس أو هلال % % 47(@)(@@) % ثأرت بقاتلي عمرو بن هند % وما أنساكه طول الليالي % % 48(@)(@@) % صفوت خلائقا وندى وأصلا % فقد أزريت بالماء الزلال % % 49(@)(@@) % ولو يحلو كماء المزن خلق % % لما شرق امرؤ فيه بحال % 50(@)(@@) % أرجي في ظلالك أن أرجى % % ويلقي العز قوم في ظلالي % % PageV01P189 51(@)(@@) % ففضلك قد غدا للفضل جيدا % وهذا المدح عقد من لآلي % % 52(@)(@@) % وقد يسبيك جيد الخود عطلا % ويسبي ضعف ذلك وهو حالي % % 53(@)(@@) % رأيت العرض يحسن بالقوافي % % كماحسن المهند بالصقال % % 54 
ms62	(@)(@@) % بغير مفرج تبقى كريما % لقد حدثت نفسك بالمحال % % 55(@)(@@) % أقول إذا ملأت العين منه % % وقاك الله من عين الكمال % % PageV01P190 البحر : - 1(@)(@@) % عبسن من شعر في الرأس مبتسم % ما نفر البيض مثل البيض في اللمم % % 2(@)(@@) % ظنت شبيبته تبقى وما علمت % % أنالشبيبة مرقاة إلى الهرم % 3(@)(@@) % ما شاب عزمي ولا حزمي ولا خلقي % % ولا وفائي ولا ديني ولا كرمي % % 4(@)(@@) % وإنما اعتاض رأسي غير صبغته % % والشيب في الرأس دون الشيب في الهمم % % 5(@)(@@) % بالنفس قائلة في يوم رحلتنا % % هواك عندي فسر إن شئت أو أقم % % 6(@)(@@) % فبحت وجدا فلامتني فقلن لها % % لا تعذليه فلم يلؤم ولم يلم % % 7(@)(@@) % لما صفا قلبه شفت سرائره % والشيء في كل صاف غير مكتتم % % 8(@)(@@) % بعض التفرق أدنى للقاء وكم % % لاءمت شملا بشمل غير ملتئم % % 9(@)(@@) % كيف المقام بأرض لا يخاف بها % % ولا يرجى شبا رمحي ولا قلمي % % 10(@)(@@) % فقبلتني توديعا فقلت لها % % كفي فليس ارتشاف الخمر من شيمي % % PageV01P191 11(@)(@@) % لو لم يكن ريقها خمرا لما انتطقت % % بلؤلؤ من حباب الثغر منتظم % % 12(@)(@@) % ولو تيقنت غير الراح في فمها % % ما كنت ممن يصد اللثم باللثم % 13(@)(@@) % وزاد ريقتها بردا تحدرها % % على حصى برد من ثغرها شبم % % 14(@)(@@) % إني لأطرف طرفي عن محاسنها % % تكرما وأكف الكف عن أمم % % 15(@)(@@) % ولا أهم ولي نفس تنازعني % % أستغفر الله إلا ساعة الحلم % % 16(@)(@@) % لا أكفر الطيف نعمى أنشرت رمما % منا كما تفعل الأرواح بالرمم % % 17(@)(@@) % حيا فأحيا وأغنتنا زيارته % عن اعتساف الفلا بالأينق الرسم % % 18(@)(@@) % وصل الخيال ووصل الخود إن سمحت % % سيان ما أشبه الوجدان بالعدم % % 19(@)(@@) % فالدهر كالطيف بؤساه وأنعمه % عن غير قصد فلا تمدح ولا تلم % 20(@)(@@) % لا تحمد الدهر في بأساء يكشفها % % فلو أردت دوام البؤس لم يدم % PageV01P192 21(@)(@@) % خالف هواك فلولا أن أهوانه % شجو لما اقتنص العقبان بالرخم % % 22(@)(@@) % ترجو الشفاء بجفنيها وسقمهما % % وهل رأيت شفاء جاء من سقم % % 23(@)(@@) % وتشتفي بصبا نجد فإن خطرت % % كانت جوى لك دون الناس كلهم % % 24(@)(@@) % وكيف تطفي صبا نجد 
ms63	 صبابته % % والريح زائدة في كل مضطرم % % 25(@)(@@) % أصبو وأصحو ولم يكلم ببائقة % عرضي كما تكلم الأعراض بالكلم % % 26(@)(@@) % لا تحسبن حسب الآباء مكرمة % لمن يقصر عن غايات مجدهم % % 27(@)(@@) % حسن الرجال بحسناهم وفخرهم % % بطولهم في المعالي لا بطولهم % % 28(@)(@@) % ما اغتابني حاسد إلا شرفت به % % فحاسدي منعم في زي منتقم % % 29(@)(@@) % فالله يكلأ حسادي فأنعمهم % % عندي وإن وقعت عن غير قصدهم % % 30(@)(@@) % ينبهون على فضلي إذا كبتت % % صحيفتي في المعالي عنونت بهم % % PageV01P193 31(@)(@@) % يا طالب المجد في الآفاق مجتهدا % والمجد أقرب من ساق إلى قدم % 32(@)(@@) % قل نصر دولة دين الله لي أمل % قولا وقد نلت أقصى غاية الهمم % % 33(@)(@@) % كم حدت عنه فنادتني فضائله % يا خاتم الأدب امدح خاتم الكرم % % 34(@)(@@) % وقادني نحوه التوفيق ثم دعا % % هذا الطريق إلى العلياء فاستقم % % 35(@)(@@) % وقصره عرفات العرف فاغن به % وكفه كعبة الافضال فاستلم % % 36(@)(@@) % ترى الملوك على أبوابه عصبا % وفدا فدع غيرهم من سائر الأمم % % 37(@)(@@) % يحفه كل محفوف بموكبه % عزا ويخدمه ذو الجند والخدم % % 38(@)(@@) % تظل مزدحمات في مواكبه % تيجان كل مهيب الناس والنقم % % 39(@)(@@) % تفيؤوا ظل ملك منه محتشم % ورب ملك مذال غير محتشم % % 40(@)(@@) % والملك كالغاب منه خدر ذي لبد % ومنه مرتبع للشاء والنعم % % PageV01P194 41(@)(@@) % هم أعظم الناس أقدارا ومقدرة % لكن أتى فضله من فوق فضلهم % % 42(@)(@@) % إذا بدا طبق التقبيل ساحته % فما على الأرض شبر غير ملتثم % % 43(@)(@@) % فساحة الثغر ثغر أشنب رتل % مفلج فهو مرشوف بكل فم % % 44(@)(@@) % فلو تؤثر في الأفواه أنمله % وأرض موكبه لم يخل من رثم % % 45(@)(@@) % كأن أرضك مغناطيس كل فم % فالطبع يجذبها بالطوع والرغم % % 46(@)(@@) % لما علوت غمرت العالمين ندى % والمزن يعلو فيروي الأرض بالديم % % 47(@)(@@) % ترقا وما رقأت نعماك عن أحد % بوركت من عال ومنسجم % % 48(@)(@@) % مقسم في العلى لليمن يمنته % واليسر يسرته والكل للكرم % % 49(@)(@@) % إن قال لا فهي آلاء مضاعفة % وإن يقل نعما أفضت إلى نعم % % 50(@)(@@) % تبدو صرامته في ماء غرته % والماء بعض صفات الصارم الخذم % PageV01P195 51 
ms64	(@)(@@) % هو الجريء على مال يجود به % % والكر في الجود مثل الكر في البهم % % 52(@)(@@) % مفرق الجود مقسوم مواهبه % في علية الناس والأوساط والحشم % % 53(@)(@@) % والغيث إن جاد بالمعروف وزعه % بين الشناخيب والغيطان والأكم % % 54(@)(@@) % به إلى كل شرب للعلى ظمأ % % برح ومهما ارتوى من مائهن ظمي % % 55(@)(@@) % ويعتريه إلى بذل اللهى نهم % والظرف أجمعه في ذلك النهم % % 56(@)(@@) % إليك نظمت أجواز الفلاة على % % خرقاء تهوي هوي الجارح القرم % 57(@)(@@) % كأنما البيد من دامي مناسمها % % مصاحف كتبت أعشارها بدم % % 58(@)(@@) % أخفافها شاكلات كل مشكلة % بجمرة معلمات كل منعجم % % 59(@)(@@) % وأدهم واضح الأوضاح مشترك % % بين النهار وبين الليل منقسم % % 60(@)(@@) % للضوء أرساغه إلا حوافره % % فإنهن مع الجلباب للظلم % % PageV01P196 61(@)(@@) % محلولك علق التحجيل أكرعه % كما تعلق بدء النار في الفحم % % 62(@)(@@) % جرى فجلى فحيا الصبح غرته % لثما ومسح بالأرساغ والخدم % % 63(@)(@@) % وقبل الفجر كي يجزيه قبلته % فارتد باللمظ المشفوع بالرثم % % 64(@)(@@) % أضحى بعدلك ثغر الثغر مبتسما % وكان قبل عبوسا غير مبتسم % % 65(@)(@@) % ما ينقم الثغر إلا أن محوت به % % ليلا من الظلم كانوا منه في حرم % % 66(@)(@@) % قد عظم الله أملاكا ملكت به % بني عقيل وما يحوون من نعم % % 67(@)(@@) % لو لم تحزها أبا نصر لما وجدت % % كفءا يشاكل في أخذ ولا كرم % % 68(@)(@@) % لو تطلب الشمس غير البدر ما اتصلت % % بمثله في سناء القدر والعظم % % 69(@)(@@) % زادت إلى عزها عزا به مضر % وربما صيدت العلياء بالحرم % % 70(@)(@@) % خمسون ألفا يغطي البر جمعهم % بموج بحر من الماذي ملتطم % % PageV01P197 71(@)(@@) % من كل من يتلقى وجه زائره % % بكوكب بهلال الفطر ملتثم % % 72(@)(@@) % مجربون على محبورة غنيت % % عن لأعنة فاستغنوا عن الحزم % % 73(@)(@@) % في الوحش زادهم والمزن ماؤهم % % تحملتهم فأغنتهم عن الأدم % % 74(@)(@@) % تصاهل الخيل من تحت الرماح بهم % % فليس يفضي بهم شيء إلى هرم % % 75(@)(@@) % ونغمة السيف أحلى نغمة خلقت % % إذا ترنم بعد البيض في اللمم % % 76(@)(@@) % والعيش في ظهر أفران مكلمة % بمثلهن وفرسان بمثلهم % % 77(@)(@@) % إذ الأسنة في الهيجاء ألسنة % يعربن عن كل مقدام 
ms65	 ومنهزم % % 78(@)(@@) % محمرة من دم الأبطال أنصلهم % % كأنما نصلوا الأرماح بالعنم % % 79(@)(@@) % قد كدت أنكر شعري حين حاوله % مني وحاشاك أملاك بلا همم % % 80(@)(@@) % لا يألمون لنقص البخل وهو بهم % % مبرح كيف للأموات بالألم % % PageV01P198 81(@)(@@) % يحكيك في الخلق لا في الخلق أكثرهم % % وربما شبه الإنسان بالصنم % % 82(@)(@@) % ولست أنكر قدر الشعر إن به % نقل المآثر عن عاد وعن إرم % 83(@)(@@) % خير المناقب ما كان البيان له % سلكا وفصل بالأمثال والحكم % % 84(@)(@@) % رث كل من بخلت كفاه من ملك % % فأكثر الناس خزان لغيرهم % % 85(@)(@@) % ذو الجود يورث في محياه أنعمه % % والنكس يورث بعد الموت والعدم % % 86(@)(@@) % وقيمة المرء ما جادت به يده % وقدرك الأنفس الغالي من القيم % % 87(@)(@@) % والفضل أشياء شتى أنت جملتها % % وصيغة أنت معناها فدم تدم % % PageV01P199 البحر : - 1(@)(@@) % أخذن زمام الدمع خوف انسجامه % % فلما استقلوا حل عقد ذمامه % 2(@)(@@) % غدوا بهلال من هلال بن عامر % % مرام هلال الأفق دون مرامه % % 3(@)(@@) % تردد فيه الحسن من عن يمينه % % ويسرته وخلفه وأمامه % % 4(@)(@@) % جلت لك وجها من براقعه كما % % جلا الورد أنفاس الصبا من كمامه % % 5(@)(@@) % يشف سناه من وراء ستوره % % كما شف ضوء البدر تحت جهامه % % 6(@)(@@) % وما زودت نيلا بلى إن جفنها % % أعار فؤادي شعبة من سقامه % % 7(@)(@@) % فظلت متى تنزح من العين عبرة % تجم بملء العين أو بجمامه % % 8(@)(@@) % هي البدر لولا كلفة في أديمه % % هي الظبي لولا دقة في عظامه % % 9(@)(@@) % هي البدر لكن تستسر زمانها % % وهل يستسر البدر عند تمامه % % 10(@)(@@) % لقد صدع البين المشتت شملنا % % كصدع الصفا لا مطمع في التئامه % % PageV01P200 11(@)(@@) % فإن يك شخصي بالثغور فمهجتي % % بنجد سقاه المزن صوب غمامه % % 12(@)(@@) % فهل ترين عيناي بيض خدوره % % مجاورة بالدو بيض نعامه % % 13(@)(@@) % فأشتم من حوذانه وعراره % % وقيصومه وشيحه وبشامه % 14(@)(@@) % وإني لنعم المرء خامره الهوى % % وما خامر الفحشاء حوب أثامه % % 15(@)(@@) % إذا ما أراد الطيف في النوم لثمه % غطا فمه عنه بثني لثامه % % 16(@)(@@) % فكيف يرجي منه حال انتباهه % % صبوا وهذا فعله في منامه 
ms66	 % % 17(@)(@@) % إذا ما دعا للهجر خل فلبه % % إليه ولو كان الردى في صرامه % % 18(@)(@@) % ولم ألتمس بالعتب إصلاح قلبه % % وهل يشترى قلب امرئ بخصامه % % 19(@)(@@) % يضر مقام الأكرمين بهم كما % % يضر بماء المزن طول مقامه % % 20(@)(@@) % فلا تعتقن من محمل السيف عاتقا % ولا فرسا من سرجه ولجامه % % PageV01P201 21(@)(@@) % فموت الفتى في العز مثل حياته % % وعيشته في الذل مثل حمامه % % 22(@)(@@) % ومن فاته نيل العلى بعلومه % وأقلامه فليبغها بحسامه % % 23(@)(@@) % صرير شبا الأقلام عند كلامها % % فداء صليل السيف عند كلامه % % 24(@)(@@) % ورأيك في الرمح المقوم إنما % % قوام العلى مستودع في قوامه % % 25(@)(@@) % وجرد جعلنا آمدا أمدا لها % % ببيداء يوم المرء فيها كعامه % % 26(@)(@@) % يلوك بهيم الخيل فيها لجامه % إلى أن تراه أرثما بلغامه % % 27(@)(@@) % يذرن جمام الماء من كل منهل % % ليكرعن من شرب العلى في جمامه % % 28(@)(@@) % وما عدمت في الدهر خيلي أكارما % ولكنها تبغي كريم كرامه % % 29(@)(@@) % أبا طاهر محيي الندى بعد موته % % نداه وباني المجد بعد انهدامه % % 30(@)(@@) % كريم المحيا يألف الجود كفه % كما يألف الآجال صدر حسامه % % PageV01P202 31(@)(@@) % تظل المنايا تقتدي بسنانه % % كما يقتدي كل امرئ بإمامه % % 32(@)(@@) % رويدا فإن الجود مثل رضاعه % % لديه وترك الجود مثل فطامه % % 33(@)(@@) % هو البحر لا تطلب بعد ذلك رده % % ومن ذا يرد البحر عند التطامه % % 34(@)(@@) % هني الندى يفتض ختم نواله % % ووجهك نضر ماؤه بختامه % % 35(@)(@@) % غدا سعيه والله يشكره له % سناما لهذا المجد فوق سنامه % % 36(@)(@@) % فلو ملك الآفاق دع عنك آمدا % غلام له مااستكثرت لغلامه % % 37(@)(@@) % ولم ينل العلياء بالجد وحده % ولكن بعالي جده واعتزامه % % 38(@)(@@) % وطعن كأن الجيش في الروع جوهر % % ورمح عبيد الله سلك نظامه % % 39(@)(@@) % وضرب يظل السيف في الهام خاطبا % به وصليل السيف مثل كلامه % % 40(@)(@@) % تمج دروع القوم منه دماءهم % % كما مج فيض الخمر نسج فدامه % PageV01P203 41(@)(@@) % يطول بكفيه القصير من القنا % % ويفري بيمناه غرار كهامه % % 42(@)(@@) % كما أن ظفر الليث يفري بكفه % وينبو بكفي غيره عن مرامه % 43(@)(@@) % وقور فما إن يقلق الخطب 
ms67	 حزمه % % ولا جسمه في السرج فقد حزامه % % 44(@)(@@) % يخال على الجرداء بعض عظامها % % فروسية أو تلك بعض عظامه % % 45(@)(@@) % كريم يسوس الحاسدين بعفوه % فإن كفروه ساسهم بانتقامه % % 46(@)(@@) % فلا يغرر الأعداء منه ابتسامه % % فإن قطوب السيف عند ابتسامه % % 47(@)(@@) % إذا ما رماه المرء عن قوس بغضه % % أصبن المنايا قلبه بسهامه % % 48(@)(@@) % وكم غادر قد شب نار عداوة % له فدحاه كيده في ضرامه % % 49(@)(@@) % فصفحا فما زال الزمان كما ترى % % أكارمه مرمية بلئامه % % 50(@)(@@) % وأصلح ببعض القوم بعضا فإنه % % يداوي بلحم الصل شر سمامه % % PageV01P204 51(@)(@@) % لكل امرئ منهم دواء فداوه % % كذاك وقد كل امرئ بزمامه % % 52(@)(@@) % رعاك الذي استرعاك أمره عباده % % وحياك من أحياك غوث أنامه % % 53(@)(@@) % ودم يدم المعروف في الناس إنما % % دوامك هذا علة لدوامه % % PageV01P205 البحر : - 1(@)(@@) % بعثن غداة تقويض الخيام % منية كل صب مستهام % % 2(@)(@@) % وملن إلى الوداع وكل جفن % % يفيض الدمع كالقدح الجمام % % 3(@)(@@) % جرت عبراتهن على عبير % % كما اصطفق الحباب على المدام % % 4(@)(@@) % ظباء صادها قناص بين % فأبدلها الهوادج بالخيام % % 5(@)(@@) % أراميهن باللحظات خلسا % فترجع نحو راميها سهامي % % 6(@)(@@) % برود ريقهن وكيف يحمى % % ومجراه على برد تؤام % % 7(@)(@@) % وأقسم ما معتقة شمول % ثوت في الدن عاما بعد عام % % 8(@)(@@) % إذا ما شارب القوم احتساها % % أحس لها دبيبا في العظام % % 9(@)(@@) % بأطيب من مجاجتهن طعما % إذا استيقظن من سنة المنام % % 10(@)(@@) % ولم أرشف لهن جنى ولكن % % شهدن بذاك أعواد البشام % % PageV01P206 11(@)(@@) % إذا كشفت براقعهن قلنا % % ضياء البدر من تحت الجهام % % 12(@)(@@) % سقام جفونهن سقام قلبي % % وهل يبرا السقام من السقام % % 13(@)(@@) % واني عند مقدرتي ووجدي % % بهن مع الشبيبة والغرام % % 14(@)(@@) % أعف عن الخناعند انتباهي % % وأحلم عنه في حال المنام % % 15(@)(@@) % هوى لا عيب فيه ولا أثام % إذا ما الحب أفسد بالأثام % % 16(@)(@@) % وأقسم صادقا لو هم قلبي % % بفعل دنيئة خدلت عظامي % % 17(@)(@@) % وأظلمهن إن ناديت يوما % بإحداهن يا بدر التمام % % 18(@)(@@) % كما ظلم الندى من قاس يوما % ندى كف المفرج بالغمام % % 19(@)(@@) % فتى جبلت يداه على العطايا 
ms68	 % % كما جبل اللسان على الكلام % % 20(@)(@@) % نزلت به فقربني كريم % تقسمه العلى خير اقتسام % % PageV01P207 21(@)(@@) % فيسراه لنيل أو عنان % % ويمناه لرمح أو حسام % % 22(@)(@@) % وطوقني صنائع ليس تخفى % % وكيف خفاء أطواق الحمام % % 23(@)(@@) % لقد أحيى المكارم بعد موت % وشاد بناءها بعد انهدام % % 24(@)(@@) % ويقسم ماله في كل وفد % % كلحم البدن في البلد الحرام % % 25(@)(@@) % بصفحة خده للبشرماء % كمثل الماء في صفح الحسام % % 26(@)(@@) % ولم أر قبله أسدا يلاقي % % ضيوفا بالتحية والسلام % % 27(@)(@@) % يزر الدرع منه على هزبر % أبي شبل مخالبه دوام % 28(@)(@@) % فتى لقي الوغى قبل اثغار % وقاد جيوشها قبل احتلام % % 29(@)(@@) % فليس يراح للغمرات حتى % % يراع الحوت في اللجج العظام % % 30(@)(@@) % يغادر قرنه والرمح فيه % % صليبا بين رهبان قيام % PageV01P208 31(@)(@@) % تكفنه البواتر في دماء % وتدفنه الحوافر في القتام % % 32(@)(@@) % تفيض دم العدى من كل درع % % كفيض الخمر من خلل الفدام % % 33(@)(@@) % وتسمعهم كلام الموت جهرا % بآذان من الطعن التؤام % % 34(@)(@@) % ولم يك طعنه أذنا ولكن % % يكون السمع من قرع الكلام % % 35(@)(@@) % يمهد في الطلى أشداق عنس % % تحلب بالدما بدل اللغام % % 36(@)(@@) % له من نفسه أبدا مناد % يناديه إلى الرتب الجسام % % 37(@)(@@) % فيوم الجود حي على العطايا % % ويوم الحرب حي على الزحام % % 38(@)(@@) % لو أن المجد يدرك بالهوينى % % لما فضل الكرام على اللئام % % 39(@)(@@) % تجمل كل مملكة يداه % % وإن كانت جمالا للأنام % % 40(@)(@@) % كذاك الدر أحسن ما تراه % % على عنق الخريدة في النظام % % PageV01P209 41(@)(@@) % ونعمة غيره عار عليه % % كمثل الحلي للسيف الكهام % % 42(@)(@@) % رآه الله للعلياء أهلا % فأعلاه على قمم الكرام % % 43(@)(@@) % فقابل فضل خالقه بشكر % وإن الشكر داعية الدوام % % 44(@)(@@) % بنوه لجيشه أبدا امام % % بمنزلة النصول من السهام % % 45(@)(@@) % فبورك ولده أبدا سهاما % وبورك سهم دين الله رامي % % 46(@)(@@) % سواء فيهم قول المنادي % % هلموا للطعان أو الطعام % % 47(@)(@@) % نزلتم طيبا حرما وكنتم % % مكان الركن منها والمقام % % 48(@)(@@) % أتتك رسائل السلطان ترضى % % وتقنع من هباتك بالزمام % % 49(@)(@@) % أمانا من جميع الناس طرا % فأنعم بالأمان وبالدوام % % 50(@)(@@) % إليك جعلت صدر المهر 
ms69	 سلكا % أسد به الموامي بالموامي % % PageV01P210 51(@)(@@) % إذا ورد القرارة بعد أين % حشا فاه على فأس اللجام % % 52(@)(@@) % فكم ملك إغادر عن يميني % % وعن يسراي إذ كنتم أمامي % % 53(@)(@@) % ولست بذي عمى عن رزق سوء % % أغادره ولكن عن تعام % % 54(@)(@@) % إذا قنع الهزبر بقوت كلب % فليس الفرق إلا في الأسامي % % 55(@)(@@) % رضعت الجود قبل الدر طفلا % وما لرضاع جودك من فطام % % 56(@)(@@) % فجود سواك رمية غير رام % وجودك رمية من كف رام % % PageV01P211 البحر : - 1(@)(@@) % نفسي الفداء للحظها من رام % % ولطرفها من أنصل وسهام % % 2(@)(@@) % ولثغرها من ضوء برق لامع % لو أتبعته لنا بصوب غمام % % 3(@)(@@) % قالوا تأس بجفنها في سقمه % شتان بين سقامه وسقامي % % 4(@)(@@) % سقم الجفون وإن تزايد صحة % أبدا وسقمي كل يوم نام % % 5(@)(@@) % أتبعتهم يوم الرحيل بمهجتي % % تبع الفلاء الخيل بعد فطام % % 6(@)(@@) % وأقمت بعد وللزمان عجائب % منها ترحل مهجتي ومقامي % % 7(@)(@@) % رحلوا بمثل البدر إلا أنه % عند المحاق يكون بدر تمام % % 8(@)(@@) % وجلون من خلل البراقع أوجها % كالورد بين أكنة الأكمام % % 9(@)(@@) % وأرى خيال العامرية أنه % واف إذا غدرت بعقد ذمام % % 10(@)(@@) % فلثمنني فجعلت ثم تحرجا % بيني وبين اللثم ثني لثامي % % PageV01P212 11(@)(@@) % وهجرت رشف رضابهن لأنه % % خمر ولست براشف لمدام % % 12(@)(@@) % وهبوه غير الخمر لست بذائق % في فعلي الشبهات شبه حرام % % 13(@)(@@) % عف الظواهر والضمائر لم أزل % % متنزها في يقظتي ومنامي % % 14(@)(@@) % دع عنك ذكر العامرية إنه % % وأبيك مغناطيس كل غرام % % 15(@)(@@) % أما فضائلها على أترابها % % فكفضل حيدرة على الحكام % % 16(@)(@@) % خير القضاة على القضاء اختاره % % بعد اختبار منه خير إمام % % 17(@)(@@) % فقضى بحكم الجور في أمواله % % وقضى بحكم الله في الأيتام % % 18(@)(@@) % ألف اتباع العدل في أحكامه % % حتى بتقسيم الطلى والهام % % 19(@)(@@) % تتيقن الأموال حين تحل في % % كفيه أن ليست بدار مقام % % 20(@)(@@) % وإذا أتى مال خزائنه بدا % % بوداعه الخزان قبل سلام % % PageV01P213 21(@)(@@) % طلق الجبين مع اليمين موقر % في الحالتين النقض والإبرام % % 22(@)(@@) % ومهذب الأقوال والأفعال وال % % أخوال والآباء والأعمام % % 23(@)(@@) % ومعين ماء الجود يشرب وفده 
ms70	 % % فيه ويصدر وهو بحر طام % % 24(@)(@@) % وترى بوجه أبي الحسين بشاشة % مثل الفرند بصفح كل حسام % % 25(@)(@@) % ويلوح منه على أسرة وجهه % % نور الهدى وسكينة الإسلام % % 26(@)(@@) % فخر الفصاحة والسماحة والنهى % % والبأس والآلاء والإنعام % % 27(@)(@@) % يخفي النوال إذا أتاه تكرما % حتى كأن الجود فعل أنام % % 28(@)(@@) % تدنو سهام الوصف دون علائه % % أو يصيب الشمس سهم الرامي % % 29(@)(@@) % أعدى ندى كفيه صوروأهلها % % والبدر يقلب طبع كل ظلام % % 30(@)(@@) % ولو أن صورا جنة ما استكثرت % % وأبيك من غلمانه لغلام % % PageV01P214 31(@)(@@) % يعفو فيفعل حلمه بعدوه % % ما تفعل الأسياف بالأجسام % % 32(@)(@@) % والحلم في بعض المواطن نعمة % تسطو بها أبدا على الأقوام % % 33(@)(@@) % والليث أعبس ما بدا وجها إذا % % أبصرته في صورة البسام % % 34(@)(@@) % وإذا تنمر مغضبا فانظر إلى % % جيش على ظهر الجواد لهام % % 35(@)(@@) % جيش له ظهر الحصان معسكر % % ذو يمنتين وساقة وأمام % % 36(@)(@@) % وكأنما جمع الأعادي جوهر % وسنانه في الجمع سلك نظام % % 37(@)(@@) % لبق الأنامل بالرماح وطالما % % أغنى عن الأرماح بالأقلام % % 38(@)(@@) % ما قط قط إلى العدى قلما له % % إلا وناب به عن الصمصام % % 39(@)(@@) % قلم يقلم ظفر كل ملمة % ويكف كف نوائب الأيام % % 40(@)(@@) % وترى بحافته المنايا والمنى % % ومقاتل الأعداء والأعدام % % PageV01P215 41(@)(@@) % من آل حيدرة الذين شعارهم % % فيض الندى الهامي وضرب الهام % % 42(@)(@@) % قهروا بحار الأرض أجمع بالندى % % وجبالها برجاحة الأحلام % % 43(@)(@@) % يتسنمون من المعالي مرتقى % عنه تزل مواطئ الأقدام % % 44(@)(@@) % يتتابعون إلى العلاء تتابعا % كتتابع الأقدام في الأقدام % % 45(@)(@@) % يقعون من هذا الزمان وأهله % % كمواقع الأعياد في الأيام % % 46(@)(@@) % ألفيت منهم في طرابلس ندى % % ترك الكرام لدي غير كرام % % 47(@)(@@) % القوم جسم أنت روحهم وهم % % في الناس كالأرواح في الأجسام % % 48(@)(@@) % لا زلت في نعم يخلد ملكها % % كرم الإله القادر العلام % % PageV01P216 البحر : - 1(@)(@@) % هل الوجد الا أن تلوح خيامها % % فيقضى بإهداء السلام ذمامها % % 2(@)(@@) % وقفت بها أبكي وترزم ناقتي % % وتصهل أفراسي ويدعو حمامها % % 3(@)(@@) % ولو بكت الورق الحمائم شجوها % % بعيني محا أطواقهن انسجامها % % 4(@)(@@) % وفي كبدي أستغفر الله غلة % % إلى برد 
ms71	 يثني عليه لثامها % % 5(@)(@@) % وبرد رضاب سلسل غير أنه % % إذا شربته النفس زاد هيامها % % 6(@)(@@) % فيا عجبا من غلة كلما ارتوت % % من السلسبيل العذب زاد اضطرامها % % 7(@)(@@) % كأن بعيد النوم في رشفاتها % % سلاف رحيق رق منها مدامها % % 8(@)(@@) % ويعبق رياها وأنفاسها معا % كنافجة قد فض عنها ختامها % % 9(@)(@@) % ولم أنسها يوم التقى در دمعها % % ودر الثنايا فذها وتؤامها % % 10(@)(@@) % وقد بسمت عن ثغرها فكأنه % قلائد در في العقيق انتظامها % % PageV01P217 11(@)(@@) % وقد نثرت در الكلام بعتبها % % ولذ بسمعي عتبها وملامها % % 12(@)(@@) % فلم أدر أي الدر أنفس قيمة % % أأدمعها أم ثغرها أم كلامها % % 13(@)(@@) % وقد سفرت عن وجهها فكأنه % تحسر عن شمس النهار جهامها % % 14(@)(@@) % ومن حيث مادارت بطلعتها يرى % % لاشراقها في الحسن نور أمامها % % 15(@)(@@) % فألقت عصاها في رياض كأنها % % تشق عن المسك الفتيق كمامها % % 16(@)(@@) % وضاحكها نور الأقاحي فراقني % % تبسمه رأد الضحى وابتسامها % % 17(@)(@@) % نظرت ولي عينان عين ترقرقت % % ففاضت وأخرى حار فيها جمامها % % 18(@)(@@) % فلم أر عيبا غير سقم جفونها % % وصحة أجفان الحسان سقامها % % 19(@)(@@) % خليلي هل يأتي مع الطيف نحوها % % سلامي كما يأتي إلي سلامها % % 20(@)(@@) % ألمت بنا في ليلة مكفهرة % % فما سفرت حتى تجلى ظلامها % % PageV01P218 21(@)(@@) % أتت موهنا والليل أسود فاحم % % طويل حكاه فرعها وقوامها % % 22(@)(@@) % فأبصر مني الطيف نفسا أبية % تيقظها من عفة ومنامها % % 23(@)(@@) % إذا كان حظي أين حل خيالها % % فسيان عندي نأيها ومقامها % % 24(@)(@@) % وهل نافعي أن تجمع الدار بيننا % % بكل مكان وهي صعب مرامها % % 25(@)(@@) % أسيدتي رفقا بمهجة عاشق % % يعذبها بالبعد عنك غرامها % % 26(@)(@@) % لك الخير جودي بالجمال فإنه % % سحابة صيف لا يرجى دوامها % % 27(@)(@@) % وما الحسن إلا دولة فاصنعي بها % % يدا قبل أن تمضي ويغبر ذامها % % 28(@)(@@) % أرى النفس تستحلي الهوى وهو حتفها % % بعيشك هل لنفس حمامها % % 29(@)(@@) % وعيس أذابت نيتي جل نيها % % فرحلي من بعد السنام سنامها % % 30(@)(@@) % تسارع بالبيداء خوصا كأنها % % قسي ولكن الرجال سهامها % % PageV01P219 31(@)(@@) % فلو حزمت من ضميرها بخزامها % % لجالت على أوساطهن خزامها % % 32(@)(@@) % جنبنا إليها كل عوجا 
ms72	 كأنما % % يناط على أعلى الرماح لجامها % % 33(@)(@@) % كأني في البيداء بيت قصيدة % % تناشدني غيطانها وأكامها % % 34(@)(@@) % إلى أن لثمنا كف حسان إنها % % أمان من الفقر المضر التثامها % % 35(@)(@@) % فلما استلمنا راحة ابن مفرج % % تدفق بالجود الصريح غمامها % % 36(@)(@@) % هو الملك يبلي بسطه قبل وقتها % % سجود ملوك فوقها وقيامها % % 37(@)(@@) % وإن قبلت منه ركابا وراحة % % فقد فاز بالحظ الجزيل سهامها % % 38(@)(@@) % إذا عاينته من بعيد ترجلت % % فإن هي لم تفعل ترجل هامها % % 39(@)(@@) % تصادم تيجان الملوك ببابه % % ويكثر في يوم السلام ازدحامها % % 40(@)(@@) % نمته إلى أعلى المراتب عصبة % يسود من قبل البلوغ غلامها % % PageV01P220 41(@)(@@) % هي الأسد إلا أنها تبذل القرى % % لطارقها والأسد يحمى طعامها % % 42(@)(@@) % إذا ما استهل الطفل منهم تهللت % % وجوه المعالي واستهل ركامها % % 43(@)(@@) % وإن فطموا أطفالهم بعد برهة % فعن درها لا عن علاها فطامها % % 44(@)(@@) % جلاد على مر الجلاد إذا ارتمت % % كلام الأعادي بالدما وكلامها % % 45(@)(@@) % غلائلها أدراعها وسماعها % % صليل المواضي والدماء مدامها % % 46(@)(@@) % تظل المنايا حيث ظلت سيوفها % % وتمسي العطايا حيث أمست خيامها % % 47(@)(@@) % فما السعد كل السعد إلا عطاؤها % % وما النحس كل النحس إلا انتقامها % % 48(@)(@@) % وأكثر ما فيها من العيب أنها % % تروع بالضيف المنيخ سوامها % % 49(@)(@@) % ألا إن طيا للمكارم كعبة % وحسان منها ركنها ومقامها % % 50(@)(@@) % بناصر دين الله أيد نصرها % % وجاز على كل الملوك احتكامها % % PageV01P221 51(@)(@@) % بعيد مداه ليس تألف كفه % من المكرمات الغر إلا جسامها % % 52(@)(@@) % ولو أن للانواء جود يمينه % لجادت بآمال النفوس رهامها % % 53(@)(@@) % ولو أن للأقمار ضوء جبينه % % لما زال عنها نورها وتمامها % % 54(@)(@@) % وليس بمشغول البنان عن الندى % % إذا شغل الكف اليمين حسامها % % 55(@)(@@) % سجية نفس للمكارم همها % % وشمة نفس للمعالي اهتمامها % % 56(@)(@@) % إذا اسودت الحرب استضاءت بسيفه % % من الضرب أو ينجاب عنه قتامها % % 57(@)(@@) % لدى فازة للنقع أوتاد مثلها % % عتاق المذاكي والرماح دعامها % % 58(@)(@@) % تظل كعوب الرمح فيها رواكعا % إلى كل قلب والسنان إمامها % % 59(@)(@@) % تحكم في قصرى الضلوع قصارها % % وتمرق في صم العظام عظامها % % 60(@)(@@) % فمن زرد 
ms73	 فوق العوالي كأنها % % خواتم أودى في البنان التحامها % % PageV01P222 61(@)(@@) % ومن زرد قد طار أنصافه كما % % تطاير عن أعلى البنان قلامها % % 62(@)(@@) % إذا طلعت راياته لعداته % % فليس عجيبا فلها وانهزامها % % 63(@)(@@) % لقد علقت قحطان منك أبا الندى % % بعروة مجد لا يخاف انفصامها % % 64(@)(@@) % وكانت سيوفا دثرا فشحذتها % % فطير ماضيها الطلى وكهامها % % 65(@)(@@) % فإن كابدت جدبا فأنت ريبعها % % وإن باشرت حربا فأنت حسامها % % 66(@)(@@) % بذكر الذي أوليت كان افتخارها % % وفضل الذي أوليت كان كرامها % % 67(@)(@@) % قليل لك الأرضون ملكا وأهلها % % عبيدا فهل مستكثر لك شامها % % 68(@)(@@) % فسر وافتح الدنيا فأن ملوكها % % بها وبهم نقص وأنت تمامها % % 69(@)(@@) % ألا إن أوصاف الأمير جواهر % وإن مديحي سلكها ونظامها % % 70(@)(@@) % وقد بلغت نفسي إليك فإن يكن % % لها في الغنى حظ فذا العام عامها % % PageV01P223 البحر : - 1(@)(@@) % هم علموا عيني سؤال المعالم % بنوعين هطال عليها وساجم % 2(@)(@@) % أبوا ظنة بي أن أرى غير مغرم % فهموا بقلبي أن يرى غير هائم % % 3(@)(@@) % كأنهم إذ أزمعوا سلبوا الكرى % % جفوني فما أحظى بلذة نائم % % 4(@)(@@) % وهبت نصيبي من سلوي لعاذلي % % وصارمت حبلي من محب مكاتم % % 5(@)(@@) % وما بحت حتى استنطق الشوق أدمعي % % وذكرني عهد الحمى المتقادم % % 6(@)(@@) % فسرت أشيم الجود في كل معدن % % وأنتقد الناس انتقاد الدراهم % % 7(@)(@@) % فلم أر مثل اليمن رب إمارة % حميد بن محمود حليف المكارم % % 8(@)(@@) % هو الجبل العالي الذي شرفاته % % تعلى على أس النجوم النواجم % % 9(@)(@@) % فإن قال قوم إنه مثل حاتم % % ففي كل عضو منه أمثال حاتم % % 10(@)(@@) % فيا طيئا طي الأمير ومن غدا % % له شرف عالي الذرى والدعائم % % PageV01P224 11(@)(@@) % بقيت ليوميك اللذين علاهما % % مصنفة في عربها والأعاجم % % 12(@)(@@) % فيوم وغى يسطو فقسوة جائر % % ويوم رضى يحنو بعطفة راحم % % 13(@)(@@) % ولما رأى الله الندى في عباده % % مقاما وركن الجود ليس بقائم % % 14(@)(@@) % حباك ببحر من نوال إذا طما % % ثوى البحر في تياره المتلاطم % % 15(@)(@@) % لئن سلمت طي إليك عنانها % % فأصبحت أسنى ذخرها للعظائم % % 16(@)(@@) % وعدل فيها عدة الدولة الذي % % يشار إليه في كتاب الملاحم 
ms74	 % % 17(@)(@@) % فما عدم التوفيق عن مستحقه % % وليس الخوافي في الورى كالقوادم % % PageV01P225 البحر : - 1(@)(@@) % قسما بوصلك إن بعد مرامه % أغرى فؤاد متيم بغرامه % 2(@)(@@) % ويلومه فيك العذول وفي الهوى % % شغل له عن عذله وملامه % % 3(@)(@@) % ولربما هجر الصبا واقتاده % % سحر العيون إلى الصبا بزمامه % % 4(@)(@@) % وبنفسي الرشأ الذي لحظاته % في القلب أسرع من غرار حسامه % % 5(@)(@@) % هل يشفين كبدي ببرد عناقه % % أو يظفرن كفي بحل لثامه % % 6(@)(@@) % قد كنت آمل عطفه لو لم يجر % % صرف الفراق علي في أحكامه % % 7(@)(@@) % ولقد ملأت يدي من عصر الصبا % % وعففت عن حرمانه وأثامه % % 8(@)(@@) % نهنه فؤادك عن ملابسة الصبى % % وارغب بنفسك عن تحمل ذامه % % 9(@)(@@) % أو ليس في قرب الوزير جميع ما % % ألهاك عن يوم الوصال وعامه % % 10(@)(@@) % قل للوزير ابن الفرات ولم تزل % % تتوكف الآمال صوب غمامه % % PageV01P226 11(@)(@@) % إن صدني عنك الزمان فإنه % % صد أرى لقياك في أحلامه % % 12(@)(@@) % إن ينأ عنك فرب نأي حسنت % % عقباه للمشتاق قرب حمامه % % 13(@)(@@) % أوعدت بالصبر الجميل فإنه % % صبر الجفون عن الكرى ولمامه % % 14(@)(@@) % فبأي وجه أشتكي الزمن الذي % % أيام قربك كن من أيامه % % 15(@)(@@) % وجمال وجهك في السفور فإنه % % وجه حكاه البدر عند تمامه % % 16(@)(@@) % ووحق ودك وهي أبعد غاية % % يجري إليها البر في أقسامه % % 17(@)(@@) % ما حال قلبي عن هواك ولا جرى % % حسن التصبر منك في أوهامه % % 18(@)(@@) % إني وإن عاد الزمان إلى الذي % % أهواه بعد جماحه وعرامه % % 19(@)(@@) % لا أشكر المعروف إلا منك أو % % ما قربت كفاك بعد مرامه % % 20(@)(@@) % أو حيث لا يجب الثناء بغير ما % % أولى الوزير القرب من إنعامه % % PageV01P227 21(@)(@@) % كم قد تملكني الزمان فعاد لي % % مستخدما إذ صرت من خدامه % % 22(@)(@@) % وإلى الوزير رفعت فيه ظلامة % % عنوانها من عبده وغلامه % % 23(@)(@@) % يا من إذا بدأ الجميل جرى إلى % % أقصى مدى الغايات في استتمامه % % 24(@)(@@) % إرغب بعبدك أن يدنس لفظه % بشكاة صرف زمانه وخصامه % % 25(@)(@@) % وأجره من أيامه وأقله من % % إجرامه وأنره في إظلامه % % 26(@)(@@) % يا من يباري الغر من أخواله 
ms75	 % % كرما ويحكي الصيد من أعمامه % % 27(@)(@@) % كالبدر عند تمامه والغيث في % % إرهامه والليث في إقدامه % % 28(@)(@@) % ما المرهفات البيض من أسيافه % % كالمرهفات السود من أقلامه % % 29(@)(@@) % ويقول عند سماع رائق لفظه % لا فرق بين لسانه وحسامه % % 30(@)(@@) % يا ابن الفرات وما الفرات بجدول % من بحرك المورود فيض جمامه % % PageV01P228 31(@)(@@) % اسمع مديح فتى لبرك شاكر % % متبده في نثره ونظامه % % 32(@)(@@) % واسلم على رغم الحوادث ما دعت % % وتجاوبت في الأيك ورق حمامه % % PageV01P229 البحر : - 1(@)(@@) % ذكر الحمى فبكى لسجع حمامه % وغدا غريما للنوى بغرامه % % 2(@)(@@) % يا منزلا ما كنت أحسب أنني % % أحيا إذا ما بنت عن آرامه % % 3(@)(@@) % مني السلام على رباك تحية % % إن كنت تقنع من جوى بسلامه % % 4(@)(@@) % وإذا السحاب عداك صوب غمامه % % فسقاك دمع العين صوب سجامه % % 5(@)(@@) % مغنى غنيت لدى شموس فنائه % % ونعمت وصلا من بدور خيامه % % 6(@)(@@) % من كل معلول اللحاظ أعلني % % وجدا وعللني بكأس مدامه % % 7(@)(@@) % لم أنسه إذ زارني متلثما % كالغصن في حركاته وقوامه % % 8(@)(@@) % عانقت غصن البان تحت وشاحه % % ولثمت بدر التم تحت لثامه % % 9(@)(@@) % وجعلت أرعى العين روض جماله % % متمتعا والسمع در كلامه % % 10(@)(@@) % هذا ودون إزاره لي عفة % صدت بحمد الله عن آثامه % % PageV01P230 11(@)(@@) % نعم شكرت بها الأمير لأنه % خلع العفاف علي في إنعامه % % 12(@)(@@) % ملأ القلوب مهابة ومحبة % منه فبات النجم دون مرامه % % 13(@)(@@) % وأنال من بذل الندى في يومه % % مالم ينله سواه عند قيامه % % 14(@)(@@) % وسخا فأدرك قاعدا من مجده % % ما لم ينله سواه عند قيامه % % 15(@)(@@) % طلق المحيا للعفاة وإنما % % يلفى العبوس به على لوامه % % 16(@)(@@) % تتقاصر الأفهام دون صفاته % % ويغض عنه الطرف من إعظامه % % 17(@)(@@) % يقظان في كسب العلاء وإن ينم % % فكأنه يقظان عند منامه % % 18(@)(@@) % يلقى الوزارة وهي دون محله % % ويرى المخدم وهو من خدامه % % 19(@)(@@) % تنبو الصفائح عن صحائف كتبه % % وتقلم الأرماح من أقلامه % % 20(@)(@@) % ويذم صفو حياته من لم يبت % % مستعصما بولائه وذمامه % % PageV01P231 21(@)(@@) % كالغيث في إسجامه والليث في % % إقدامه والسيف في إخذامه % % 22(@)(@@) % إن شاء 
ms76	 عد الغر من أخواله % % أو شاء عد الغر من أعمامه % % 23(@)(@@) % قوم إذا ما المجد أصبح قسمة % فلهم أعالي رأسه وسنامه % % 24(@)(@@) % من كل من يسمو بإرث سريره % % والتاج عن كسراه أو بهرامه % % 25(@)(@@) % يكبو زناد الذم عن أعراضه % % ويضيء طرز المدح من أكمامه % % 26(@)(@@) % فضل لو أن الدهر قدم عصره % % لأبان نقص زياده وهشامه % % 27(@)(@@) % فاسلم على رغم الحسود ولا تزل % % للدهر ركنا دائما بدوامه % % 28(@)(@@) % حتى يسر بك الولي ويغتدي % % أنف الحسود به لصيق رغامه % % PageV01P232 البحر : - 1(@)(@@) % لمن الرسوم بعرصة البردان % أقوت غداة ترحل الأظعان % 2(@)(@@) % دمن عفين فأصبحت غربانها % % يردين بين منازل الضيفان % % 3(@)(@@) % ولقد تعم الضيف فيها مكرما % ما شاء بين غلائق وجفان % % 4(@)(@@) % طرقتك علوة بالعراق وأهلها % % ما بين تثليث إلى نجران % % 5(@)(@@) % أنى اهتدت لك بين شعث قد رمت % % بهم البلادنوائب الحدثان % % 6(@)(@@) % متوسدين ذراع كل مطية % عجفاء مثل حنية الشريان % % 7(@)(@@) % طرقت وفي جفني وجفن مهندي % % وهنا غرارا رقدة ويمان % % 8(@)(@@) % في بدن مثل البدور لتمها % % يسليننا بنواظر الغزلان % % 9(@)(@@) % ينضاع منهن العبير كأنما % % يحملن فأر المسك في الأردان % % 10(@)(@@) % وبسمن عن برد هممت برشفه % % لولا الحياء وخشية الرحمن % % PageV01P233 11(@)(@@) % يرخصن في النوم الوصال وطالما % % أغلين صفقته على اليقظان % % 12(@)(@@) % ثم انتبهت فما رأيت يمانيا % إلا سهيلا دائم الخفقان % % 13(@)(@@) % فدعوت أصحابي فقام أخفهم % % نوما يميل تمايل السكران % % 14(@)(@@) % تكبو بأعناق الركاب وكلها % % ملق لفرط كلاله بجران % % 15(@)(@@) % ولقد شجاك الظاعنون ولم تزل % % يشجو فؤادك باكر الأظعان % % 16(@)(@@) % رحلوا غداة البين كل شملة % عيرانة وشمردل عيران % % 17(@)(@@) % رعت الحميم فآض فوق ظهورها % % من نيهن كهبة الركان % % 18(@)(@@) % عاجلننا بفراقهن فجاءة % % قبل الصباح وناعب الغربان % % 19(@)(@@) % وسفحن للبين المدامع فالتقى % % دران در مدامع وجمان % % 20(@)(@@) % الآن تسأل دارهم عن أهلها % % أو هل تجيبك غير ذات لسان % % PageV01P234 21(@)(@@) % لم يبق فيها غير شعب جثم % قد قلدت قطعا من الأرسان % % 22(@)(@@) % يا غلو إن جار الزمان بحكمه % % فينا وكل اثنين يفترقان % % 23(@)(@@) % فاستبدلي بي إن رغبت 
ms77	 مشيعا % لبقا بضرب جماجم الأقران % % 24(@)(@@) % لا تجعلي مثلا كراعي ثلة % يبتاع عيرا ناهقا بحصان % % 25(@)(@@) % أو كامرئ يوما أراق سقاءه % % لبريق آل كاذب اللمعان % % 26(@)(@@) % إني إذا نبذ المحب عنانه % بيد الحبيب قبضت ثني عناني % % 27(@)(@@) % تبا لقلب ليس فيه موضع % إلا لحب فلانة وفلان % % 28(@)(@@) % وإذا الفتى ألف الهوان فنبني % % ما الفرق بين الكلب والانسان % % 29(@)(@@) % موت الذليل كعيشه ويد الفتى % % شلاء أو مقطوعة سيان % % 30(@)(@@) % فلئن سلمت لأقضين لبانتي % % بذميل كل شملة مذعان % % PageV01P235 31(@)(@@) % أرمي الفجاج بها لألقي رحلها % % في حيث تلقى أرحل الفتيان % % 32(@)(@@) % عند الأمير غريب بن محمد % ملك الملوك وفارس الفرسان % % 33(@)(@@) % ملك يطوف المعتفون ببابه % % كطوافهم بالبيت ذي الأركان % % 34(@)(@@) % طلق يلوح على أسرة وجهه % % نور الهدى وسكينة الايمان % % 35(@)(@@) % ألقى الإله عليه منه محبة % فتراه محبوبا بكل جنان % % 36(@)(@@) % متواضعا لله جل ولو يشا % % صقع الملوك له على الأذقان % % 37(@)(@@) % ملك يهين النفس في يوم الوغى % % وهوانها في الحرب غير هوان % % 38(@)(@@) % فيمينه للمشرفية والندى % % وجبينه للبيض والتيجان % % 39(@)(@@) % جبل الأنام على الخلاف ولا أرى % % في جوده رجلين يختلفان % % 40(@)(@@) % يهتز للمعروف وهو سجية % للأكرمين كهزة النشوان % % PageV01P236 41(@)(@@) % لله در يد الخطوب فإنها % % صدأ اللئام وصيقل الفتيان % % 42(@)(@@) % جردن مثل أبي سنان صارما % في كل ناحية له حدان % % 43(@)(@@) % كالليث إلا أن جارك آمن % والليث ليس بآمن الجيران % % 44(@)(@@) % فاسلم وإن رغم الحسود مخلدا % أبدا ليومي نائل وطعان % % 45(@)(@@) % يارب جيش قد كففت بمثله % % والخيل تعثر في النجيع القاني % % 46(@)(@@) % بشوازب فيه كأن فروجها % % أبواب خالية من السكان % % 47(@)(@@) % ومعرض دون الكتيبة نفسه % للموت بين مثقف وسنان % % 48(@)(@@) % أو جيته نجلاء تنفخ بالدما % % نفخا كجيب الناكل المرنان % % 49(@)(@@) % وعصابة مال الكرى برؤوسهم % % ميل الصبا بذوائب الأغصان % % 50(@)(@@) % سفع الهجير جباههم وخدودهم % فكأنما يطلين بالقطران % % PageV01P237 51(@)(@@) % من كل أشعت ضم في أقطاره % % ليل عليه بحاصب شفان % % 52(@)(@@) % يعوي لتنبحه الكلاب كما عوى % % ذئب بأعلى قلة الصمان % % 53(@)(@@) % نادته نارك وهي غير فصيحة % وهنا 
ms78	 بخفق ذوائب النيران % % 54(@)(@@) % فهوى بصحبته لديك وأدركوا % % منك المنى وعطا يديك أماني % % 55(@)(@@) % وغدوا عبيدك بالجميل وإنما % % يستعبد الأحرار بالاحسان % % 56(@)(@@) % أنسيتنا كعب بن مامة والفتى % % معن بن زائدة أخا شيبان % % 57(@)(@@) % وتركت حاتم تابعا لك مثل ما % % تبع الثريا كوكب الدبران % % 58(@)(@@) % تشري الثناء بما غلا ولو أنه % في منزل من دونه القمران % % 59(@)(@@) % متيقنا أن الثناء مخلد % % باق وأن المال شيء فان % % 60(@)(@@) % أو هل يباريك السحاب وجوده % % ماء وجود يديك بالعقبان % % PageV01P238 61(@)(@@) % بل كيف تجدب بلدة تأوي بها % % ويداك في أرجائها بحران % % 62(@)(@@) % والدهر عين أنت إنسان لها % % لا خير في عين بلا إنسان % % 63(@)(@@) % ظني بك الحسنى فإن أوليتها % % فليشكرنك ما بقيت لساني % % PageV01P239 البحر : - 1(@)(@@) % حييتما من دمنتي طللين % عطلين موحشتين مقفرتين % % 2(@)(@@) % عفى عراصهما على طول البلى % % نوء الرشا وبوارح الفرعين % % 3(@)(@@) % ومحاهما من آل محوة والصبا % % أذيال غاديتين رائحتين % % 4(@)(@@) % وكأنما أبقين من رسميهما % % طرسين من أثواب ذي القرنين % % 5(@)(@@) % يا من رأى ظعن الخليط كأنها % % نخل الربى أو دوم ذي الحدقين % % 6(@)(@@) % يقطعن بالأحداج بطن مقضب % قلت الربى ومشارق الجبلين % % 7(@)(@@) % من كل بيضاء الجبين خريدة % صفر الحشا سحارة العينين % % 8(@)(@@) % تصطاد ألباب الرجال كأنما % % ترمي ببعض عزائم الملكين % % 9(@)(@@) % وتختال مبسمها ولؤلؤ عقدها % % درين مؤتلفين منتظمين % % 10(@)(@@) % وإذا مشت قطف الخطى فكأنها % % ملك الخورنق ماس في بردين % % PageV01P240 11(@)(@@) % تزهو على القمر المنير بوجهها % % وتتيه من حسن على الثقلين % % 12(@)(@@) % فبنرجس العينين سحر إن رنت % % أو أسفرت فشقائق الخدين % % 13(@)(@@) % ولها سلاح لا يضر دنوه % والبعد منه جالب للحين % % 14(@)(@@) % ريانة الخلخال ظامئة الحشا % % هركولة خرعوبة الساقين % % 15(@)(@@) % ريا العظام ندية أعطافها % % رخص البنان دقيقة الخصرين % % 16(@)(@@) % قد كان لي عيش بهن فخانه % صرف النوى وتقلب العصرين % % 17(@)(@@) % أيام لم يقص المحبين النوى % % عنا ولم ينعق غراب البين % % 18(@)(@@) % قالت بريهة إذ شجتها رحلتي % % ورنت مناظرتين باكيتين % % 19(@)(@@) % فحسبت أدمعها ولفظ عتابها % % درين مفترقين منتثرين % % 20(@)(@@) % أنى تريد ترحلا عن أرضنا % % نفديك 
ms79	 بالأبوين والأخوين % % PageV01P241 21(@)(@@) % فأجبتها صبرا فإني ناهض % عنك الغداة صبيحة الإثنين % % 22(@)(@@) % ولأقتلن العدم قتلة ثائر % % بالجود من نفحات كف حسين % % 23(@)(@@) % الماجد ابن أبي هشام ذي الندى % % محض الفخار مهذب الجدين % % 24(@)(@@) % ورث المعالي عن أبيه وجده % % فنشا بمجد معلم الطرفين % % 25(@)(@@) % بيت السماح جماهري مجده % تعلو به يمن على النجمين % % 26(@)(@@) % يفضي لهيبته الزمان إذا انتضى % % عضب المنابر باتر الحدين % % 27(@)(@@) % متقلد من رأيه وحسامه % % سيفين قد نيطا إلى كتفين % % 28(@)(@@) % نعم تباح لراهب أو راغب % جم المواهب باسط الكفين % % 29(@)(@@) % حاز الفخار بجده وبجده % % فهو المفضل كامل الشرفين % % 30(@)(@@) % ياأيها المولى الأجل ومن له % همم تجاوز مطلع القمرين % % PageV01P242 31(@)(@@) % ما أنت فاعله الغداة بشاعر % % رث الثياب مشعث القدمين % % 32(@)(@@) % قد طاف في طلب العلى وادي القرى % % والعز من عدن إلى السدين % % 33(@)(@@) % وإلى عمان وفارس ثم انتحى % % بالري نحو جزيرة البحرين % % 34(@)(@@) % وأقام في شيراز سبعة أشهر % % وأناب من كل بخف حنين % % 35(@)(@@) % وأنا على الأيام أعتب عاتب % ونداك يقضي بينهن وبيني % % 36(@)(@@) % لا زلت في رتب المعالي ساحبا % ذيل المكارم مسبل الكمين % % 37(@)(@@) % ما نور الإصباح جلباب الدجى % % وتجاوب الطيران في غصنين % % PageV01P243 البحر : - 1(@)(@@) % أحياه بعد الله إذ حياه % % طيف يسري الهم عنه سراه % % 2(@)(@@) % أهدى السلام على تنائي أرضه % % يا حبذا المهدى ومن أهداه % % 3(@)(@@) % أهداه أحور من ظباءتهامة % % كالظبي ألحاظ الظباء ظباه % % 4(@)(@@) % كلت لواحظ مقلتيه وإنما % % لحظ العيون أكله أمضاه % % 5(@)(@@) % يعدي ولا يعديه سقم جفونه % % والسيف ليس يضره حداه % % 6(@)(@@) % ما العيش غير جواره في روضة % ينضاف رياها إلى رياه % % 7(@)(@@) % يثني النسيم الأقحوان بمثله % % فيها كما تتلاثم الأفواه % % 8(@)(@@) % نفسي الفداء له على هجرانه % % أبدا ومن لي أن أكون فداه % % 9(@)(@@) % أستودع الله الحجاز وأهله % % وسقاهم سيل الحيا وسقاه % % 10(@)(@@) % أهوى الحجاز وطلحه وسياله % وأراكه وبشامه وعضاه % % PageV01P244 11(@)(@@) % فسقى الإله سهوله وحزونه % % ومروجه ووهاده ورباه % % 12(@)(@@) % غيثا يطبق بالفلاة فيستوي % % بالروض منظر أرضه وسماه % % 13(@)(@@) % كيمين عباس أبي الحسن الذي % % بهر 
ms80	 الأنام سناؤه وسناه % % 14(@)(@@) % ملك يقر بفضله وببذله % % وبعدله أصحابه وعداه % % 15(@)(@@) % جبل الأنام على الخلاف ولا أرى % % رجلين يختلفان في علياه % % 16(@)(@@) % قد صاغه الرحمن من كرم فلو % % لمسته راحة باخل أعداه % % 17(@)(@@) % اليمن في يمناه كيف تصرفت % % أحواله واليسر في يسراه % % 18(@)(@@) % يجلو جبينا للعفاة ترقرقت % % وتدفقت للبشر فيه مياه % % 19(@)(@@) % ويبشر العافين بشر جبينه % % بالنجح قبل تنالهم جدواه % % 20(@)(@@) % ولجوده من نفسه داع إذا % % ناداه حي على الندى لباه % % PageV01P245 21(@)(@@) % يدري الجواد إذا استوى في متنه % % أن الفقير إلى الحزام سواه % % 22(@)(@@) % فكأنه لثباته في طرفه % % عضو تمكن في سواء قراه % % 23(@)(@@) % لا يقتني العلياء إلا بالظبي % % قدما إذا قصرت صدور قناه % % 24(@)(@@) % والبيض ألسنة نواطق ما لها % % إلا الجماجم والرقاب شفاه % % 25(@)(@@) % ماضي العزائم لو أناب عزيمة % عن حد كل مهند أغناه % % 26(@)(@@) % يا من يفنده على إعطائه % % لوم السحائب أن تسج سفاه % % 27(@)(@@) % أتلومه في الجود وهو رضاعه % قدما ومن بعد الرضاع غذاه % % 28(@)(@@) % فإذا نهاه عاذل عن جوده % % لم يثنه وكأنه أغراه % % 29(@)(@@) % لا يستطاع لفضله وصف ولو % % أن العباد بأسرهم أفواه % % 30(@)(@@) % فقد اغتدى في كل شيء كاملا % فوقاه من عين الكمال الله % % PageV01P246 31(@)(@@) % إقدام حيدرة وبأس محمد % فيه ولا يعدوهما أبواه % % 32(@)(@@) % نسبا ترى عنوانه في وجهه % % فلو أن أميا يراه قراه % % 33(@)(@@) % أشبهت في العلياء جدك أحمدا % إن الأكارم في العلى أشباه % % 34(@)(@@) % قسم الندى فحوى الأنام بأسرهم % % منه اسمه وحويتم معناه % % 35(@)(@@) % فمن ادعى بعد النبي وآله % % معنى الفضائل كذبت دعواه % % 36(@)(@@) % لو ينسل المعروف كنت ابنا له % أو كان مولودا لكنت أباه % % 37(@)(@@) % من كان نحو ابن الإمامة سيره % فالنجح والتوفيق مكتنفاه % % 38(@)(@@) % ما قال لا مذ كان إلا قوله % % عند الشهادة لا إله سواه % % 39(@)(@@) % وقد اعتزمت على الرحيل فإن رأى % % إمضاء أمر وليه أمضاه % % 40(@)(@@) % ولقد علمت بأن موتي عنده % % عزا يفوق العيش عند سواه % % PageV01P247 41(@)(@@) % لكنه هجم الشتاء وعنده % % ممن تكون تهامة مثواه % % 42(@)(@@) % يا أيها 