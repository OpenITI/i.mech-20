ms321	 قذاة أن تعد أذى %~% وأن تقضى بأوصاب وآلام(@)(@@) 6 وليس يقذفني فقري إلى نوبي ، %~% ولا يسلمني منهن إسلامي(@)(@@) 7 والناس في غمرات أعملوا فكرا ، %~% كالسرب يرتع في رغل وقلام(@)(@@) 8 وما يعرون من مكر ولا حيل %~% أطراف سمر ، ولا أطراف أقلام(@)(@@) 9 أعياك خل ، ولولا قدرة سلفت %~% لم يمكن الجمع بين الخاء واللام(@)(@@) 10 فلا تغرنك في الأيام خادعة %~% من الحسان بوحي أو بكلام PageV01P1495(@)(@@) 11 ينأى الغلام ، ولو لم يرض والده ، %~% عن احتياج إلى حلي وعلام(@)(@@) 12 فاردد أمورك ، فيما أنت فاعله ، %~% إلى بري من الأدناس علام(@)PageV01P1496(@)(@@) البحر : بسيط تام(@)(@@) 1 من ادعى الخير من قوم فهم كذب %~% لا خير في هذه الدنيا ولا خير(@)(@@) 2 وسيرة الدهر مما تنفك معجبة %~% كالبحر ، تغرق في ضحضاحها السير(@)(@@) 3 نمتار ، من أمنا الغبراء ، حاجتنا %~% وللبسيطة من أجسادنا مير(@)(@@) 4 كم غيرتنا بأمر خط حادثه ، %~% وربنا الله لم تلمم به الغير(@)PageV01P1497(@)(@@) البحر : بسيط تام(@)(@@) 1 إلهنا الحق ! خفف واشف من وصب ، %~% فإنها دار أثقال وآلام(@)(@@) 2 يسر علينا رحيلا لا يلبثنا %~% إلى الحفائر من أهل وأخلام(@)(@@) 3 وجازنا عن خطايانا بمغفرة ؛ %~% فكم حلمت ، ولسنا أهل أحلام(@)(@@) 4 قد أسلم الرجل النصران ، مرتغبا %~% وليس ذلك من حب لإسلام(@)(@@) 5 وإنما رام عزا في معبشته %~% أو خاف ضربة ماضي الحد قلام(@)(@@) 6 أو شاء تزويج مثل الظبي ، معلمة ، %~% للناظرين بأسوار وعلام(@)(@@) 7 قد حاول الناس رزق الله ، فابتكروا %~% مجاهدين بأرماح وأقلام(@)(@@) 8 نرجو من الله رحبا إثر ضيقة %~% من الأمور ، ونورا بعد إظلام(@)(@@) 9 له الممالك قد بانت دلائلها %~% للمفكرين ، برايات وأعلام(@)(@@) 10 والحظ عن غير سعي ، بل مواهبه %~% كأنها ضرب أيسار بأزلام PageV01P1498(@)(@@) 12 ويح لجيلي والأجيال ، إن بعثوا %~% إلى حساب قديم اللطف علام(@)(@@) 13 محصي الجرائم ، فعال العظائم ، نص %~% ار الهضائم ، جاز ، غير ظلام(@)PageV01P1499(@)(@@) البحر : بسيط تام(@)(@@) 1 عققت دنياك إن حاولت خدمتها ، %~% إياك والأم ، لا تدعى من الآم(@)(@@) 2 وتحت رجلك منها مفرق ترب ، %~% أنى اتجهت بإعراق وإشآم(@)(@@) 3 أسمتني أم دفر غير 
ms322	 مرعية ، %~% وزاد أهلك إعناتي وإسآمي(@)PageV01P1500(@)(@@) البحر : بسيط تام(@)(@@) 1 تشكت ، الضيعة ، الشقراء ، جاهدة ، %~% فقيل صبرا إلى أن ينبت الشقر(@)(@@) 2 ولا مقر على اللذات أولها %~% شهد يغر ولكن غبه مقر(@)(@@) 3 آلى الزمان ، يقينا ، أن سيجمعنا ، %~% إلى التراب ، ورسل الموت تنتقر(@)(@@) 4 يغنى الفتى بالمنايا عن مآربه %~% وينفخ الروح في طفل ، فيفتقر(@)(@@) 5 عرفت أمرا ، فلا تزعجك حادثة ، %~% ما كان مثلك من أمثالها يقر(@)(@@) 6 عندي لخلى إعظام لنته %~% وإنني للذي أوليه محتقر(@)PageV01P1501(@)(@@) البحر : بسيط تام(@)(@@) 1 لا تزدرن صغارا في ملاعبهم %~% فجائز أن يروا سادات أقوام(@)(@@) 2 وأكرموا الطفل عن نكر يقال له ، %~% فإن يعش يدع كهلا بعد أعوام(@)(@@) 3 ولا تناموا عن الدنيا وغرتها %~% فإن أبيتم ، فكونوا خير نوام(@)(@@) 4 لا تظلموا من بنيها واحدا أبدا ، %~% حتى تعدوا ذوي فطر كصوام(@)PageV01P1502(@)(@@) البحر : بسيط تام(@)(@@) 1 بعض الأقارب مكروه تجاورهم ، %~% وإن أتوك ذوي قربى وأرحام(@)(@@) 2 كالعين والحاء تأبى أن تقارنها %~% في لفظها ، فحماها قربها حامي(@)PageV01P1503(@)(@@) البحر : بسيط تام(@)(@@) 1 سم الهلال إذا عاينته قمرا %~% إن الأهلة ، عن وشك ، لأقمار(@)(@@) 2 ولا تقولن حجين أنه لقب %~% وانما يافظ التلقيب أغمار(@)(@@) 3 هل صح قول من الحاكي ، فنقبله ، %~% أ / كل ذاك أباطيل وأسمار(@)(@@) 4 أما العقول ، فآلت أنه كذب ، %~% والعقل غرس ، له ، بالصدق ، أثمار(@)(@@) 5 ما هاج للحازم الماضي سوى حزن %~% عود يجاوبه ، في الشرب ، مزمار(@)(@@) 6 هل تعرف الماء ، تغشاه القطا زمرا %~% قبل الصباح ، وفيه الجن سمار(@)(@@) 7 كأن كيوان في ظلماء حندسه %~% من الهمود وطول المكث ، مسمار(@)(@@) 8 من يرزق الحظ يسعد حيث كان به %~% ومن يخيب فإن الموت مضمار(@)(@@) 9 كانت عجائب ، والمقدار صيرها %~% إلى ابن حرب ، ولاقى ، الحتف ، عمار(@)(@@) 10 ما فات أعيا ، ولم ترجع إلى مضر %~% عين ، وجول ، في الآفاق ، أنمار PageV01P1504(@)(@@) 11 ينهي لسانك عن شيء منافقة %~% والسر بالشيء ، ينهى عنه أمار(@)PageV01P1505(@)(@@) البحر : بسيط تام(@)(@@) 1 سألتكم : لا تكنوني لتكرمة ، %~% وصغروني تصغيرا بترخيم(@)(@@) 2 فالمرء يخلق من أشياء أربعة %~% وكلها راجع للأصل والخيم(@)(@@) 3 وما 
ms323	 ألومك في خفضي ومنقصتي ، %~% لكن ألومك في رفعي وتفخيمي(@)PageV01P1506(@)(@@) البحر : -(@)(@@) 1 أبعد من الناس تطرح ثقل ألفتهم ، %~% ولا ترد لكل أعوانا وأنصارا(@)(@@) 2 ولا تحاول من قوم ، إذا صحبوا ، %~% أذكوا لرغمك أسماعا وأبصارا(@)(@@) 3 لما تبينت طول الدهر ، طال به %~% فكري ، فأشعر هذي النفس إقصارا(@)(@@) 4 يا لهف ! كم مدن أملاك غدون ، فلا %~% فيه ، وكم فلوات عدن أمصارا(@)(@@) 5 والله أكبر ، لا يدنو القياس له ، %~% ولا يجوز كان أو صارا(@)(@@) 6 لا ملك لي ، وأرى الدنيا تحاصرني ، %~% وما حججت ، وقد لاقيت إحصارا(@)PageV01P1507(@)(@@) البحر : بسيط تام(@)(@@) 1 ليس اغتنام الصديق شأني %~% فلا تكن ، شأنك اغتنامي(@)(@@) 2 في الأرض حي وغير حي ، %~% فجامد بيننا ونامي(@)(@@) 3 غيب ميت ، فما رأته %~% عين سوى رؤية المنام(@)(@@) 4 فلا يبال اللبيب منا %~% في منسم حل أو سنام(@)(@@) 5 نأي زنام أوان يدهى %~% حدث بالناي عن زنام(@)(@@) 6 والغدر في الآدمي طبع %~% فاحترزي قبل أن تنامي(@)(@@) 7 من ادع أنه وفي %~% فلينتسب في سوى الأنام(@)PageV01P1508(@)(@@) البحر : وافر تام(@)(@@) 1 أدنياي ! اذهبي ، وسواي أمي ، %~% فقد ألممت ، ليتك لم تلمي(@)(@@) 2 وكان الدهر ظرفا ، لا لحمد %~% تؤهله العقول ، ولا لذم(@)(@@) 3 وأحسب سانح الإزميم نادى %~% ببين الحي عن صحراء زم(@)(@@) 4 إذا بكر جنى فتوق عمرا ، %~% فإن كليهما لأب وأم(@)(@@) 5 وخف حيوان هذي الأرض ، واحذر %~% مجيء النطح من روق وجم(@)(@@) 6 وفي كل الطباع طباع نكر ، %~% وليس جميعهن ذوات سم(@)(@@) 7 وما ذنب الضراغم حين صيغت %~% وصير قوتها مما تدمي ؟(@)(@@) 8 فقد جبلت على فرس وضرس %~% كما جبل الوقود على التنمي(@)(@@) 9 ضياء لم يبن لعيون كمه ؛ %~% وقول ضاع في آذان صم(@)(@@) 10 لعمرك ، ما أسر بيوم فطر ، %~% ولا أضحى ، ولا بغدير خم PageV01P1509(@)(@@) 11 وكم أبدى تشيعه غوي ، %~% لأجل تنسب ببلاد قم(@)(@@) 12 وما زال الزمان بلا ارتياب %~% يعد الجدع للأنف الأشم(@)(@@) 13 أحاضنة الغلام ضممت منه %~% أذاك ، فأرضعي حنشا ، وضمي(@)(@@) 14 فلو وفقت لم تسقي جنينا ، %~% ولم تضعي الوليد ، ولم تهمي(@)(@@) 15 لهان على أقاربك الأداني 
ms324	 %~% قيامك عن خديج غير تم(@)(@@) 16 سألت عن الحقائق وهي سر %~% ويخشاك المخبر أن تنمي(@)(@@) 17 وكيف يبين للأفهام معنى %~% له من ربه قدر معمي ؟(@)(@@) 18 وعندي لو أمنتك علم أمر %~% عن الجهال غيبه مكمي(@)(@@) 19 وسمى أن أراق الماء جبس %~% يراقب جنة أن لا يسمي(@)(@@) 20 رأيت الحق لؤلؤة توارت %~% بلج من ضلال الناس جم PageV01P1510(@)(@@) 21 أحث الخلق من ذكر وأنثى %~% على حسن التعبد والتأمي(@)(@@) 22 %~% أعز عليك من خال وعم(@)(@@) 23 ونحن ميممون مدى بعيدا %~% كأنا عائمون غمار يم(@)(@@) 24 متى يتبلج المبيض يرعى %~% لقوم تحت أخضر مدلهم(@)PageV01P1511(@)(@@) البحر : بسيط تام(@)(@@) 1 أمور سكان هذي الأرض كلهم %~% كلفظهم : فيه منظوم ومنثور(@)(@@) 2 يلقي ، المهند مأثورا ، أخو كرم ، %~% ولا يشيع قبيح عنه ، مأثور(@)PageV01P1512(@)(@@) البحر : وافر تام(@)(@@) 1 لقد كرمت عليك فتاة قوم %~% شربت ، بفضلها ، فضلات كرم(@)(@@) 2 وسقت إليك سوء الجرم عمدا ، %~% وأنت معلل بسويق جرم(@)(@@) 3 أرى هرما يعيد نبات نبع ، %~% وإن كان الصليب كنبت هرم(@)(@@) 4 لقد خاب الذي حلبت يداه %~% سفاهة عقله بأذى وغرم(@)(@@) 5 سيخفت كل صوت : زار ليث ، %~% ونبأة باغم ، وهدير قرم(@)(@@) 6 زماني من له وتري وقوسي %~% وكفي والسهام ، فكيف أرمي ؟(@)PageV01P1513(@)(@@) البحر : بسيط تام(@)(@@) 1 جيب الزمان على الآفات مزرور %~% ما فيه الا شقي الجد مضرور(@)(@@) 2 أرى شواهد جبر لاأحققه %~% كأن كلا ، إلى ما ساء ، مجرور(@)(@@) 3 هون عليك ، فما الدنيا بدائمة ، %~% وإنما أنت مثل الناس مغرور(@)(@@) 4 ولو تصور أهل الدهر صورته ، %~% لم يمس منهم لبيب ، وهو مسرور(@)(@@) 5 لقد حججت فأعطيتك السرى عنتا %~% فهل علمت بأن الحج مبرور ؟(@)(@@) 6 والخير والشر ممزوجان ، ما افترقا ، %~% فكل شهد عليه الصاب مذرور(@)(@@) 7 وعالم فيه أضداد مقابلة %~% غنى وفقر ومكروب ومقرور(@)PageV01P1514(@)(@@) البحر : وافر تام(@)(@@) 1 أقضي الدهر من فطر وصوم ، %~% وآخذ بلغة يوما بيوم(@)(@@) 2 وأعلم أن غايتي المنايا ؛ %~% فصبرا ، تلك غاية كل قوم(@)(@@) 3 وسامتني إهانتها الليالي ؛ %~% ومن لي أن تخليني وسومي ؟(@)(@@) 4 فإن تقف الحوادث دون نفسي ، %~% فما يتركن إشمامي ورومي 
ms325	(@)(@@) 5 أعوم اللج والحيتان حولي %~% وما أنا محسن ، في ذاك ، عومي(@)(@@) 6 وأيام الحياة ظلال عتر ؛ %~% وكيف بأن يكن ظلال دوم(@)(@@) 7 لعل العيش تسهيد ونصب ، %~% وراحتي الحمام أتى بنوم(@)(@@) 8 وما كان المهيمن ، وهو عدل ، %~% ليقصر حيلتي ، ويطيل لومي(@)PageV01P1515(@)(@@) البحر : بسيط تام(@)(@@) 1 تخيل من بني الدنيا ، غدا عجبا ، %~% للمفكرين ، وكل الناس محسور(@)(@@) 2 كأن إعراب أعراب ثووا زمنا %~% بالدو ، فينا ، بحكم النحو ، مأسور(@)(@@) 3 فناطق ، يسكن الأمصار من عجم ، %~% نطق ابن بيداء لما يحوه سور(@)(@@) 4 وناظم لعروض الشعر عن عرض %~% وما يحس بأن البيت مكسور(@)(@@) 5 ومغتد بحبال الصيد ينصبها ، %~% كيما يفيء له من ذاك ميسور(@)PageV01P1516(@)(@@) البحر : وافر تام(@)(@@) 1 لقد هجم الزمان على تميم %~% بأجمعهم ، فمن آل الهجيم(@)(@@) 2 فما حمت السروج ظبى سريج %~% ولا لجم الجياد بني لجيم(@)PageV01P1517(@)(@@) البحر : بسيط تام(@)(@@) 1 لا يبصر القوم في مغناك غسل يد %~% على الطعام ، إلى أن يرفع السور(@)(@@) 2 ولا يكن ذاك إلا بعد كفهم %~% أكفهم ، ويسير الفعل ميسور(@)(@@) 3 فإن تقريب خدام الفتى حرضا ، %~% والضيف يأكل ، رأي منه مخسور(@)PageV01P1518(@)(@@) البحر : وافر تام(@)(@@) 1 أما لأمير هذا المصر عقل %~% يقيم ، عن الطريق ، ذوي النجوم ؟(@)(@@) 2 فكم قطعوا السبيل على ضعيف ، %~% ولم يعفوا النساء من الهجوم(@)(@@) 3 هم ناس ، ولو رجموا استحقوا %~% بأنهم شياطين الرجوم(@)(@@) 4 إذا افتكر اللبيب رأى أمورا ، %~% ترد الضاحكات إلى الوجوم(@)PageV01P1519(@)(@@) البحر : بسيط تام(@)(@@) 1 الصمت أولى ، وما رجل ممنعة ، %~% إلا لها بصروف الدهر تعثير(@)(@@) 2 والنقل غير أنباء سمعت بها ؛ %~% وآفة القول تقليل وتكثير(@)(@@) 3 والعقل زين ، ولكن فوقه قدر ، %~% فما له ، في ابتغاء الرزق ، تأثير(@)PageV01P1520(@)(@@) البحر : وافر تام(@)(@@) 1 إلى الليثين ترسل ، باقتدار ، %~% نوائبها يد القدر الهجوم(@)(@@) 2 فمن أسد يعد من الضواري %~% ومن أسد يعد من النجوم(@)PageV01P1521(@)(@@) البحر : بسيط تام(@)(@@) 1 ما باختياري ميلادي ، ولا هرمي ، %~% ولا حياتي ، فهل لي بعد تخيير ؟(@)(@@) 2 ولا إقامة إلا عن يدي قدر %~% ولا مسير إذا لم يقض تسيير(@)(@@) 3 زعمت أنك تهديني لواضحة %~% كذبت ، هذا 
ms326	 الذي تحكيه تحيير(@)(@@) 4 عيرت أمرا ، فهل غيرت منكره ، %~% أم ليس عندك للنكراء تغيير ؟(@)PageV01P1522(@)(@@) البحر : وافر تام(@)(@@) 1 يقول الناس : إن الخمر تودي %~% بما في الصدر من هم قديم(@)(@@) 2 ولولا أنها باللب تزري %~% لكنت أخا المدامة والنديم(@)PageV01P1523(@)(@@) البحر : بسيط تام(@)(@@) 1 غير وأنكر ، على ذي الفحش ، منطقه ، %~% إذا أجاز خنى زير خنازير(@)(@@) 2 اما الجسوم فأنس في مناظرها %~% لها ، من النحض ، تشبيك وتأزير(@)(@@) 3 كأنها ورجال ينهضون بها %~% من الفخامة هونات بهازير(@)(@@) 4 يعزز الملك توقيرا وحق له %~% على المآثم تأديب وتعزير(@)PageV01P1524(@)(@@) البحر : وافر تام(@)(@@) 1 أبالقدر المتاح تدين جن %~% تسمع ، غير هائبة الرجوم(@)(@@) 2 وتعلم أن ما لم يقض صعب %~% فما تخشى المنية في الهجوم(@)(@@) 3 بإذن الله ينفذ كل أمر ؛ %~% فنهنه فيض أدمعك السجوم(@)(@@) 4 يجوز بحكمه موت الثريا %~% وأن تبقى السماء بلا نجوم(@)(@@) 5 وكم وجم الفتى من بعد ضحك %~% وأضحك بعد إفراط الوجوم(@)PageV01P1525(@)(@@) البحر : وافر تام(@)(@@) 1 إذا ما جاءني رجل بذام %~% فإن القول ما قالت حذام(@)(@@) 2 أرى سيف بن ذي يزن فرته %~% صروف الدهر بالسيف الهذام(@)(@@) 3 وأذوت غاضرا ورمت حبالا %~% سليل أخي طليحة بانجذام(@)(@@) 4 وما زيد بن حارثة حبيب %~% إلى الحي المصبح من جذام(@)(@@) 5 ألم تر لامرىء القيس بن حجر %~% بكى متشبها بفتى حذام(@)(@@) 6 كذاك تناسخ الدنيا ، فملي %~% مزادك قبل تقضيب الوذام(@)PageV01P1526(@)(@@) البحر : كامل تام(@)(@@) 1 قطع الطريق بمهمه ، ونظيره ، %~% في المصر فعل منجم ومعزم(@)(@@) 2 تتوافق الأسماء منا والعلى %~% متباينات فانه جهلك واحزم(@)(@@) 3 هيهات ! ما الجوزاء ، ترزم عندها %~% وجناء ، كالجوزاء ذات المرزم(@)(@@) 4 وتشابه الأخلاق من متباعدي %~% نجر ، وليس خزيمة من أخزم(@)(@@) 5 وبعين سلوان ، التي في قدسها %~% طعم يوهم أنها من زمزم(@)(@@) 6 والمرء يسخط ما أتاه ، وكم فتى %~% كالشن ينفع أهله بمهزم(@)(@@) 7 غضب المملك أن خرجا لم يفر %~% والعبد أن سقاءه لم يخزم(@)(@@) 8 والخير أفضل ما اعتقدت فلا تكن %~% هملا وصل لقبلة أو زمزم(@)(@@) 9 ووجدت نفس الحر تجعل كفه %~% صفرا ، وتلزمه بما 
ms327	 لم يلزم(@)PageV01P1527(@)(@@) البحر : مخلع البسيط(@)(@@) 1 كم سبحت أربع جوار %~% لها بتسبيحها حبور(@)(@@) 2 فمن جنوب ومن شمال %~% ومن صبا أختها الدبور(@)(@@) 3 والشهب ، جمعا ، وشعرياها ، %~% تلك الغميصاء والعبور(@)(@@) 4 فمجدوا ربكم إلى أن %~% تلفظ ، أمواتها ، القبور(@)(@@) 5 فكل ما تفعل البرايا %~% إلا تقى ربها يبور(@)(@@) 6 والصبر ، حزم ، على الرزايا ، %~% وقبلنا فضل الصبور(@)(@@) 7 وهل أمنتم على ثبير %~% ان يتوارى به الثبور(@)(@@) 8 فكل ذي مشية سيرمى %~% بعثرة ، ما لها جبور(@)(@@) 9 طال وقوفي وراء جسر %~% وانما ينظر العبور(@)(@@) 10 ان ابن آسي مضى ولكن %~% دل على فضله الزبور(@)PageV01P1528(@)(@@) البحر : كامل تام(@)(@@) 1 علمي بأني جاهل متمكن %~% عندي ، وإن ضيعت حق العالم(@)(@@) 2 والظلم يمهل بعض من يسعى له %~% ومحل نقمته بنفس الظالم(@)(@@) 3 ما بال من طلب الهدى ، بمفاوز %~% قفر ، وطالب غيره بمعالم ؟(@)(@@) 4 والمرء في حال التيقظ هاجع %~% يرنو إلى الدنيا بمقلة حالم(@)(@@) 5 وأخو الحجى أبدا يجاهد طبعه ، %~% فتراه ، وهو محارب ، كمسالم(@)(@@) 6 سأل الطبيب عن الشكاية مدنف %~% يرجو سلامته ، وليس بسالم(@)PageV01P1529(@)(@@) البحر : وافر تام(@)(@@) 1 إذا سنة بكى تشرين فيها %~% وساعده بدمعته أذار(@)(@@) 2 فرودي حيث شئت ، بغير أزل ، %~% وليس عليك من جدب حذار(@)(@@) 3 فذاك أوان تخضر الروابي ، %~% لناظرها ، وتبيض الوذار(@)(@@) 4 أيلقى العذر أم أبت الخطايا ، %~% قديما ، أن يكون لك اعتذار ؟(@)PageV01P1530(@)(@@) البحر : كامل تام(@)(@@) 1 أسكت وخل مضلهم وشؤونه ، %~% ليسوقهم بعصاه ، أو بحسامه(@)(@@) 2 نصحوا فما قبلوا وباعوا كثكثا ، %~% من شر معدنه ، بقيمة سامه(@)(@@) 3 فكأنهم غنم ترود ، أسامها %~% من لا يبالي كيف حال مسامه(@)(@@) 5 دفن السرور فما يبين لعاقل %~% رزء ، يكون الموت في أقسامه(@)(@@) 6 كذب امرؤ نسب القبيح إلى الذي %~% خلق الأنام ، وخط في برسامه(@)PageV01P1531(@)(@@) البحر : وافر تام(@)(@@) 1 ثلاث مآرب : عنس ، وكور ، %~% ونهج قد أبان ، فهل بكور ؟(@)(@@) 2 وبعض الناس ، في الدنيا ، كطير %~% أوانف أن تلائمها الوكور(@)(@@) 3 ذكور لا إناث لها ولكن %~% قرائنها المهندة الذكور(@)(@@) 4 عرفتكم بني حواء قدما %~% فكلكم أخو ضغن مكور(@)(@@) 5 وما فيكم ، على 
ms328	 الإحسان ، جاز ، %~% ولا منكم على النعمى شكور(@)PageV01P1532(@)(@@) البحر : كامل تام(@)(@@) 1 هذي الحياة مسافة ، فاصبر لها ، %~% كيما تبين وأنت غير ملوم(@)(@@) 2 من لي بناجية سفيهة مدلج %~% فالعيس لم تحمد ذوات حلوم(@)(@@) 3 روح الظلوم إذا هوت ، فإذا ارتقت ، %~% فكأنما هي دعوة المظلوم(@)(@@) 4 أما ركاب الجود ، فهي عواطب ، %~% وسرى الأنام على ركاب اللوم(@)(@@) 5 في عالم أخذ الإله عقولهم %~% فغدوا جميعهم بلا معلوم(@)PageV01P1533(@)(@@) البحر : وافر تام(@)(@@) 1 أمور تستخف بها حلوم %~% وما يدري الفتى لمن الثبور(@)(@@) 2 كتاب محمد ، وكتاب موسى ، %~% وإنجيل ابن مريم والزبور(@)(@@) 3 نهت أمما غما قبلت وبارت %~% نصيحتها فكل القوم بور(@)(@@) 4 ودارا ساكن وحياة قوم ، %~% كجسر فوقه اتصل العبور(@)(@@) 5 يعطل منزل ، ويزار قبر ، %~% وما تبقى الديار ولا القبور(@)(@@) 6 حمام فاتك ، فهل انتصار ، %~% وكسر دائم ، فمتى الجبور ؟(@)(@@) 7 وملك كالرياح جرت قبول ، %~% فلم تلبث وأعقبت الدبور(@)(@@) 8 أصول قد بنين على فساد ، %~% وتقوى الله سوق لا تبور(@)(@@) 9 ليطلع المليك عليك فيها ، %~% وانت على نوائبها صبور(@)PageV01P1534(@)(@@) البحر : رجز تام(@)(@@) 1 شر على المرأة من حمامها ، %~% إرسالك الفاضل من زمامها(@)(@@) 2 ومشيها تضرب في أكمامها %~% يفوح ريا الطيب من أمامها(@)(@@) 3 زائرة المسجد في إلمامها %~% تأتم ، والخيبة في ائتمامها(@)(@@) 4 بأجدل ما عف عن حمامها %~% أعاذها الخالق من إمامها(@)(@@) 5 وريقها المشروب في ضمامها %~% سمام أفعى بان عن سمامها(@)(@@) 6 إن نزلت عصماء من شمامها %~% فلا سقاها الطل من غمامها(@)(@@) 7 إذا احتوى الريم على رمامها ، %~% لزومها البيت مع اهتمامها(@)(@@) 8 حتى يجيء الوفد من حمامها ، %~% وحملها المغزل في إتمامها(@)(@@) 9 أوفى بما تعقد من ذمامها(@)PageV01P1535(@)(@@) البحر : كامل تام(@)(@@) 1 للحال بالقدر اللطيف تغير ، %~% فلينأ عنك تفاؤل وتطير(@)(@@) 2 قد حار آدم ، في القضاء ، وآله ، %~% أفللملائك ، في السماء ، تحير ؟(@)(@@) 3 تتخيرين الأمر كي تحظي به ؛ %~% هيهات ليس ، على الزمان ، تخير(@)(@@) 4 وتديري عند السماك أو السهى %~% فلكل جسم ، في التراب ، تدير(@)PageV01P1536(@)(@@) البحر : سريع(@)(@@) 1 إجتنب الناس وعش واحدا %~% لا تظلم الناس ولا تظلم(@)(@@) 2 
ms329	 وجدت دنياك ، وإن ساعفت ، %~% لا بد من وقعتها الصيلم(@)(@@) 3 لو بعث المنصور نادى : أيا %~% مدينة التسليم لا تسلمي(@)(@@) 4 قد سكن القفر بنو هاشم ، %~% وانتقل الملك إلى الديلم(@)(@@) 5 لو كنت أدري أن عقباهم %~% لذاك لم أقتل أبا مسلم(@)(@@) 6 قد خدم الدولة مستنصحا %~% فألبسته شية العظلم(@)(@@) 7 ما دام غير الله من دائم %~% فاغضب على الأقدار ، أو سلم(@)(@@) 8 طوفت في الآفاق عصرا ، فما %~% أسفرت من حندسك المظلم(@)(@@) 9 سألت أقواما فلم تلف من %~% يهديك من رشد إلى معلم(@)(@@) 10 فاحلم عن الجاهل مستكبرا ، %~% فالعين إن تلق الكرى تحلم PageV01P1537(@)(@@) 11 إن وفاة النكس ، في جبنه ، %~% مثل وفاة الفارس المعلم(@)PageV01P1538(@)(@@) البحر : كامل تام(@)(@@) 1 أنا بالليالي والحوادث أخبر %~% سفر يجد بنا وجسر يعبر . . .(@)(@@) 2 واجهت قبرة ، فخفت تطيرا ؛ %~% ما كل ميت ، لا أبا لك ، يقبر(@)(@@) 3 من أحسن الأحداث وضعك غابرا %~% في الترب ، يأكله تراب أغبر(@)(@@) 4 ما أجهل الأمم ، الذين عرفتهم ، %~% ولعل سالفهم أضل وأتبر(@)(@@) 5 يدعون في جمعاتهم بسفاهة %~% لأميرهم ، فيكاد يبكي المنبر(@)(@@) 6 جئنا على كره ونرحل رغما %~% ولعلنا ما بن ذلك نجبر(@)(@@) 7 ما قيل في عظم المليك وعزه ، %~% فالله أعظم في القياس وأكبر(@)(@@) 8 وكأنما رؤياك رؤيا نائم ، %~% بالعكس ، في عقبى الزمان ، تعبر(@)(@@) 9 فإذا بكيت بها فتلك مسرة ، %~% واذا ضحكت فذاك عين تعبر(@)(@@) 10 سر الفتى من جهله بزمانه %~% وهو الأسير ، ليوم قتل يصبر PageV01P1539(@)(@@) 11 لعبت به أيامه ، فكأنه %~% حرف يلين في الكلام وينبر(@)(@@) 12 عجز الأطبة عن جروح نوائب ، %~% ليست ، بغير قضاء ربك ، تسبر(@)(@@) 13 والمين أغلب في المعاشر ، كم أخ %~% للدفر فهو اذا يسمى : العنبر(@)(@@) 14 شرف اللئيم ، وكم شرف رأسه %~% هدر يقط ، كما يقط المزبر(@)(@@) 15 سل أم غيلان الصموت عن ابنها ، %~% وبنات أوبر ، ما أبوها أوبر(@)(@@) 16 والشر يجلبه العلاء ، وكم شكا ، %~% نبأ ، علي ، ما شكاه قنبر(@)PageV01P1540(@)(@@) البحر : -(@)(@@) 1 يضحي الفتى المرؤوس بالسيد ال %~% الماجد ، كالمرؤوس بالصارم(@)(@@) 2 غريزة ، في الناس ، معروفة ، %~% تثقل المكروم بالكارم(@)(@@) 3 والدهر لا ينكر 
ms330	 تسويده %~% بني كليب لبني الهارم(@)(@@) 4 ويخمص الإنسان من نخوة ة %~% ساكنة في أنفه الوارم(@)(@@) 5 بيت العلى بيت قريض ، ولا %~% بد من الكاسر والخارم(@)(@@) 6 إن يحرم السائل عندي جدا ، %~% فلست ، عند الله ، بالحارم(@)(@@) 7 لو كنت أسطيع له راحة ، %~% راح بها في عامه العارم(@)(@@) 8 ضد زكاة المال من زاد %~% حال ، عن المسكين والغارم(@)(@@) 9 والحق أن تطلب ، ما بيننا ، %~% جناية الجرم من الجارم(@)PageV01P1541(@)(@@) البحر : سريع(@)(@@) 1 نطقت حيا نيرا ، فاعذري %~% من نطق النير أو لومي(@)(@@) 2 سلي على الخير ، فعهدي به ، %~% مع التقصي غير معلوم(@)(@@) 3 أنصف مولانا ، وكل امرىء %~% يظلم ، والظلم من اللوم(@)(@@) 4 قد يقتل الحر ، وما دينه %~% في طاعة الله بمكلوم(@)(@@) 5 لا شيء في الجو وآفاقه %~% أصعد من دعوة مظلوم(@)PageV01P1542(@)(@@) البحر : منسرح(@)(@@) 1 إن سرور المدام لم يدم %~% بل أعقبت بالهموم والسدم(@)(@@) 2 والكأس من كاس في التعثر ، وال %~% ندمان لفظ أتى من الندم(@)(@@) 3 ما زال مستهترا بها لهجا %~% حتى انثنى مؤسرا من العدم(@)(@@) 4 كيف له أن يكون شاربها %~% بالأهل بعد السوام والخدم(@)(@@) 5 أقبل يهوي بها إلى فمه %~% حتى توقى تفري الأدم(@)(@@) 6 يوسع الجلد والعظام لها ، %~% أطبقة مازجت دما بدم(@)(@@) 7 مقتولة ، في الحديث ، ضاحكة ، %~% موطوءة ، في القديم ، بالقدم(@)(@@) 8 قد ظهر السر بعد خفيته %~% من قائل بالزمان والقدم(@)(@@) 9 لم تخلد الراح والمزاهر وال %~% قينات حيي عاد ، ولا قدم(@)PageV01P1543(@)(@@) البحر : كامل تام(@)(@@) 1 يا صالح اجعل وصف شخصك واسمه %~% مثلين إنك في بحارك ماهر(@)(@@) 2 ما فضة الإنسان إلا فضة ، %~% والتبر تتبير ، وجدك ظاهر(@)(@@) 3 والدر در للهجوم تسره %~% إن الجواهر بالأذاة جواهر(@)(@@) 4 كذب الذي سمى المملك قاهرا ؛ %~% نحن الأذلة والمليك القاهر(@)(@@) 5 وكذاك يدعى طاهرا من كله %~% نجس ، ويفقد ، في الأنام ، الطاهر(@)PageV01P1544(@)(@@) البحر : -(@)(@@) 1 ما أكرم الله _ عز من ملك _ %~% ورزقنا من دلائل الكرم(@)(@@) 2 كم عال من كافر وكافرة %~% من ابتداء الصبا إلى الهرم(@)(@@) 3 ثم استقلا إلى قبورهما ، %~% والقبر للنازلين كالحرم(@)(@@) 4 
ms331	 إذا عظام الفتى به أرمت ، %~% حسبته من ثمود ، أو إرم(@)(@@) 5 قد وطىء الأخمصان ، ويحهما ، %~% على جسوم الرجال والحرم(@)(@@) 6 يا جسد الميت كم أضيف إلى %~% تربك من ياسر ومن برم(@)(@@) 7 وأوقد الناس فوق أرضهم %~% أمثالها من مجمع الضرم(@)(@@) 8 لو أنصفوا نزهوا سوامهم %~% عن غليان الكسور في البرم(@)(@@) 9 قرم هوى مقرم بصارمه ، %~% يدعو به : لا شفيت من قرم(@)(@@) 10 حرمتني الكون في الرياض وأن %~% أنشق ريا العرار والبرم PageV01P1545(@)(@@) 11 أو أرد الماء ، بعد خامسة ، %~% في هجمات الحلال والصرم(@)(@@) 12 قضيت بي حق رفقة وفدت %~% حسبك من مأثم ومجترم(@)(@@) 13 رب مهاة نفت بمذودها ال %~% أعداء من طفلها ، فلم يرم(@)(@@) 14 حم لها نابل ، فغادرها %~% مخضوبة بالنجيع وهي رمي(@)PageV01P1546(@)(@@) البحر : -(@)(@@) 1 لو زعمت نفسي الرشاد لها %~% حلفا ، لكذبتها بمزعمها(@)(@@) 2 دار ، إذا سمحت بلذتها ، %~% فإن بؤسا وراء أنعمها(@)(@@) 3 إن غفر الله لي فلا أسف %~% على الذي فات من تنعمها(@)(@@) 4 أكلتها جمرة حرارتها %~% صدت أخا الحرص عن تطعمها(@)PageV01P1547(@)(@@) البحر : كامل تام(@)(@@) 1 الحظ عاش بشر ما آشتكى %~% نظرا ، وعمر أكمها بشار(@)(@@) 2 وهي الحوادث عود ولواقح %~% وشوائل ، وحوائل ، وعشار(@)(@@) 3 كم شرن من أري ، يكون مقيله %~% ثغرا يشار له وليس يشار(@)(@@) 4 يرجى له ، بتمول ، إنشار(@)(@@) 5 ونرى مباشرة التراب مهانة ، %~% وإليه ترجع هذه الأبشار(@)(@@) 6 قد ضن من رزق الغنى بزكاته %~% وغدا فلا فلح ولا تعشار(@)(@@) 7 لم يعط ربع العشر من أوراقه ، %~% فترام من سقي الحيا أعشار(@)PageV01P1548(@)(@@) البحر : -(@)(@@) 1 رب إكفني حسرة الندامة في ال %~% عقبى ، فإني محالف الندم(@)(@@) 2 والظلم في وقدة ، فلو عرضت %~% شربة ماء لما غلت بدمي(@)(@@) 3 ولم يكن ، في غمامنا ، وشل ، %~% ولا قليب لنا ، ولا أدم(@)(@@) 4 عفوك للروح ، وهي قادرة ، %~% وجسمها كالهباء للقدم(@)(@@) 5 لا تفرق العين ، حين تبصره ، %~% ما بين كف تبين من قدم(@)(@@) 6 والملك فينا هو الفقير لما %~% يلزمه من معونة الخدم(@)(@@) 7 يكفيك عبد وليس يقنعه %~% ألف ، وكم دمت وهو لم يدم(@)(@@) 8 وكيف ترجى 
ms332	 السعود في زمن ، %~% يساره راجع إلى العدم ؟(@)PageV01P1549(@)(@@) البحر : متقارب تام(@)(@@) 1 وددت وفاتي في مهمه ، %~% به لامع ليس بالمعلم(@)(@@) 2 أموت به واحدا مفردا ، %~% وأدفن في الأرض لم تظلم(@)(@@) 3 وأبعد عن قائل : لا سلمت ؛ %~% وآخر قال : ألا ياسلم(@)(@@) 4 أحاذر أن تجعلوا مضجعي %~% إلى كافر خان ، أو مسلم(@)(@@) 5 إذا قال : ضايقتني في المحل ! %~% قلت : أساؤوا ، ولم أعلم(@)PageV01P1550(@)(@@) البحر : كامل تام(@)(@@) 1 أقصرت من قصر النهار ، وقد أنى %~% مني الغروب وليس لي إقصار(@)(@@) 2 وينال طالب حاجة بفلاته %~% مالا تجود بمثله الأمصار(@)(@@) 3 وإذا الحوادث جهزت جيشا لها %~% خمدت قريش فيه والأنصار(@)(@@) 4 أنا ما حججت فكم تحج نوائب %~% شخصي ، ويفقد ، عندها ، الإحصار(@)(@@) 5 قدم الزمان وعمره إن قسته %~% فلديه أعمار النسور قصار(@)(@@) 6 والهم منتشر ولكن ربه %~% يوما ، يصير إلى الثرى ، فيصار(@)(@@) 7 و المعصرات من الخزاد عواصف %~% كالمعصرات صنيعها أعصار(@)(@@) 8 كم يسمع الناس العظات ، وكم رأوا %~% غير الجميل ، فغضت الأبصار(@)PageV01P1551(@)(@@) البحر : متقارب تام(@)(@@) 1 سلي الله ربك إحسانه %~% فإنك إن تنظري تألمي(@)(@@) 2 وليس اعتقادي خلود النجوم ، %~% ولا مذهبي قدم العالم(@)PageV01P1552(@)(@@) البحر : كامل تام(@)(@@) 1 أفطر وصم ، أو صم وأفطر ، خائفا ، %~% صوم المنية ما له إفطار(@)(@@) 2 وأزرع من تربي ولا أرتاع من %~% تربي ، وفي قرب الانيس خطار(@)(@@) 3 من كالصعيد الحر ، من أبنائه %~% زهر الربيع وروضة المعطار(@)(@@) 4 وكأن في كف الزمان ، بنوره ، %~% قطرا ، تعم بنشره الأقطار(@)(@@) 5 متمطرين إلى الخيانة والأذى %~% لا حس يتبعها ، ولا أوطار(@)(@@) 6 ومن الفضيلة للجوامد أنها %~% لاحس يبعثها ولاأوطار(@)(@@) 7 تخذ الغراب على المفارق موقعا %~% ولقد علمت بأنه سيطار(@)PageV01P1553(@)(@@) البحر : مجزوء المتقارب(@)(@@) 1 قفي وقفة تعلمي %~% وإن سلموا ، فاسلمي(@)(@@) 2 فما قلت من لوعة : %~% ألمي بنا يا لم . . .(@)(@@) 3 وكيف صعودي إلى %~% الثريا بلا سلم ؟(@)(@@) 4 أيخلص هذا الورى %~% من الحندس المظلم ؟(@)(@@) 5 أيهم لم يكن %~% ظلوما ، ولم يظلم ؟(@)(@@) 6 ولا بد للحادثا %~% ت من وقعة صيلم(@)(@@) 7 تبيد أعاديهم %~% مع الترك والديلم(@)(@@) 8 ويثنيك في راحة %~% كأنك لم 
ms333	 تؤلم(@)(@@) 9 ولم يبق صرف الردى %~% على بطل معلم(@)(@@) 10 يخضب هام العدى %~% بنحو من العظلم PageV01P1554(@)(@@) 11 وكم بذ من قرح %~% مدى الجذع الأزلم(@)(@@) 12 ولست من الركب إذ %~% يعوجون في المعلم(@)(@@) 13 إذا طمعوا فاقتنع %~% وإن جهلوا فاحلم(@)(@@) 14 ولا يدنون الفتى %~% لعرس ، ولا يولم(@)(@@) 15 فإن ظهرت زلتي %~% فقل لرفيقي : لم(@)PageV01P1555(@)(@@) البحر : كامل تام(@)(@@) 1 ما للأنام ؟ وجدتهم ، من جهلهم %~% بالدين ، أشباه النعام ، أو النعم(@)(@@) 2 فمجادل وصل الجدال ، وقد درى %~% أن الحقيقة فيه ليس كما زعم(@)(@@) 3 علم الفتى النظار أن بصائرا %~% عميت ، فكم يخفى اليقين ، وكم يعم(@)(@@) 4 لو قال سيد غضا : بعثت بملة %~% من عند ربي ؛ قال بعضهم : نعم !(@)PageV01P1556(@)(@@) البحر : كامل تام(@)(@@) 1 يا روح ! شخصي منزل أوطنته ، %~% ورحلت عنه ، فهل أسفت وقد هدم(@)(@@) 2 عيد المريض ، وعاونته خوادم ، %~% ثم انتقلت فما أعين ولا خدم(@)(@@) 3 لقد استراح معلل ومساهر %~% منه ، وإن غدت النوائح تلتدم(@)(@@) 4 حملوه ، بعد مجادل وأسرة ، %~% حمل الغريب ، فحط في بيت ردم(@)(@@) 5 ما زال في تعب وهم دائم %~% فلعله عدم الأذاة بأن عدم(@)(@@) 6 لو كان ينطق ميت لسألته : %~% ماذا أحس ، وما رأى لما قدم ؟(@)(@@) 7 إن تشو في دار الجنان فإنما %~% فارقت من دنياك نارا تحتدم(@)(@@) 8 من ذا يلومك في هواك مسيئة ؛ %~% كل الأنام بحبها كلف سدم(@)(@@) 9 فاعذر خليلك إن جفاك ولا تجد ؛ %~% وإذا الزيارة ساعفتك فلا تدم(@)(@@) 10 بئس العشير أنا الغداة ، وصاحبي %~% مثلي ، فإني ما ندمت ولا ندم(@)PageV01P1557(@)(@@) البحر : -(@)(@@) 1 دنياي _ ويحك _ ما طرقتك مختارا %~% تارا ، ولكن القضاء حكم(@)(@@) 2 قضيت أيام الشباب على %~% مضض وقد طال البقاء فكم . . .(@)(@@) 3 يكفيك أن المدح فيك يرى %~% كذبا وذما ، في العقول ، حكم(@)(@@) 4 وبنوك مثلك فيهم جبل %~% عال ، وواد غائر ، وأكم(@)PageV01P1558(@)(@@) البحر : رجز تام(@)(@@) 1 لحرص في كل الأقانين يصم %~% أما رأيت كل ظهر ينقصم ؟(@)(@@) 2 وعروة من كل حي تنفصم %~% أما سمعت الحادثات تختصم ؟(@)(@@) 3 أم حبك الأشياء يعمي ويصم(@)PageV01P1559(@)(@@) البحر : رمل تام(@)(@@) 1 
ms334	 صاحب الشرطة إن أنصفني %~% فهو خير لي من عدل ظلم(@)(@@) 2 من أراد الخير فليعمد له %~% فعليه لذوي اللب علم(@)(@@) 3 حكم الناس غواة مثل ما %~% حكمت قبل حصاة وزلم(@)(@@) 4 لا تهاون بصغير من عدى(@)(@@) 5 وترقب من مليك صنعه %~% فمن البيع قياض وسلم(@)(@@) 6 يجمع الجنس شريفا ولقى %~% كحديد ، منه سيف وجلم(@)(@@) 7 خالد غاو وبكر صالح %~% ومن الأشجار نخل وسلم(@)(@@) 9 رب شيخ ظل يهديه ، إلى %~% سبل الحق غلام ما احتلم(@)(@@) 10 وكأن الشر أصل فيهم ، %~% وكذا النور حديث في الظلم(@)(@@) 11 أعجب العضب لما هذ ، فقد %~% كل ، أو صادف بؤسا ، فانثلم PageV01P1560(@)(@@) 12 ومع الضير بلوغ للمنى %~% ومع النفع تشك وألم(@)PageV01P1561(@)(@@) البحر : سريع(@)(@@) 1 رب ! متى أرحل عن هذه ال %~% دنيا فإني قد أطلت المقام(@)(@@) 2 لم أدر ما نجمي ، ولكنه %~% في النحس ، مذ كان ، جرى واستقام(@)(@@) 3 فلا صديق يترجى يدي ؛ %~% ولا عدو يتخشى انتقام(@)(@@) 4 والعيش سقم ، للفتى ، منصب ؛ %~% والموت يأتي بشفاء السقام(@)(@@) 5 والترب مثواي ومثواهم ؛ %~% وما علمنا أحدا منه قام(@)PageV01P1562(@)(@@) البحر : -(@)(@@) 1 والدنا الدهر به طيشة ، %~% فليس فيه من بنيه حليم(@)(@@) 2 ما ركب المرء سوى ظالم ، %~% يعدو إلى الفتنة عدو الظليم(@)(@@) 3 دنياهم دار بلا جنة %~% فالقوم فيها في عذاب أليم(@)(@@) 4 مستلمين الركن ، مستلئمين %~% السرد كل منهم مستليم(@)(@@) 5 رب ! متى أرحل عن عالمي ؟ %~% فأنت بالناس خبير عليم(@)(@@) 6 فالمالك الهالك ، والمرسر ال %~% معسر والسالم مثل السليم(@)(@@) 7 ما نال فرعون بها نعمة ؛ %~% ولا صفا عيش لموسى الكليم(@)PageV01P1563(@)(@@) البحر : -(@)(@@) 1 روحي كالنار أذابت دمي %~% غليا ، فلما بردت غاض دم(@)(@@) 2 لا تقدم ، الدهر ، على مأثم ؛ %~% واستغفر الواحد رب القدم(@)(@@) 3 شربت في العسجد عن عزة %~% ومشربي من خزف أو أدم(@)(@@) 4 أعوذ بالخالق من معشر %~% إذا غلت قدرهم لم تدم(@)(@@) 5 هذي نجوم شاهدت تبعا ، %~% ومن مضى من حمير أو قدم(@)(@@) 6 بروجها كالبرج في الأرض ، إن %~% طال مداه في العصور انهدم(@)(@@) 7 فاندم على الذنب إذا جئته ، %~% فمن شروط التائبين 
ms335	 الندم(@)(@@) 8 والخدم الأحجال في اللفظ وال %~% مقصد كالقوم دعوا بالخدم(@)(@@) 9 ماهنة الجسم هي الرجل ، وال %~% خلخال ، في المنزل ، عند القدم(@)(@@) 10 والمال كالتابع ، أهون به ، %~% ورب يسر في قوام العدم(@)PageV01P1564(@)(@@) البحر : -(@)(@@) 1 رب درفس خلفه ذائب %~% أروح من رب الدرفس العلم(@)(@@) 2 ليس الفتى من رأسه مبدلا %~% رأسا كما يفعل باري القلم(@)(@@) 3 وهذه الدنيا ، على أنها %~% محبوبة ، لم تخلنا من ألم(@)(@@) 4 يلام ذو اليسر ، وأي امرئ %~% أدرك منها طرفا ، لم يلم ؟(@)(@@) 5 قد يوجد الكهل حليف النهى %~% كأنه من جهله ما احتلم(@)(@@) 6 كان تقيا قبل إمكانه %~% حتى إذا مكن منها ظلم(@)(@@) 7 يحسب أن الصبح باد له ، %~% وهو ، نهارا ، خابط في الظلم(@)(@@) 8 ومن بديع الجور ، ما بيننا ، %~% حربك من ألقى إليك السلم(@)(@@) 9 إن إناء الخير من عسجد ، %~% لو خر هضب فوقه ما انثلم(@)(@@) 10 إن زجر الله حديدا نبا ، %~% أو أمر الله حريرا كلم PageV01P1565(@)(@@) 11 أروح من عيش جنى لي أذى %~% موت حباني راحة واصطدم(@)(@@) 12 طيف حمام زارني في الكرى ؛ %~% فمرحبا بالطيف لما ألم(@)(@@) 13 أينكر التقليد مستبصر ، %~% قبل ركن البيت ثم استلم(@)(@@) 14 والجذع الأزلم لم يبق ذا %~% رمح من الناس ، ولا ذا زلم(@)PageV01P1566(@)(@@) البحر : منسرح(@)(@@) 1 يا أمة ، في التراب ، هامدة ، %~% تجاوز الله عن سرائركم(@)(@@) 2 يا ليتكم لم تطوا إماءكم %~% ولا دنوتم إلى حرائركم(@)(@@) 3 إن استرحتم مما نكابده %~% فنحن ، من بعد ، في جرائركم(@)(@@) 4 فما خطب الخاطبون نسوتكم %~% وأسكت الحس من ضرائركم(@)(@@) 5 ذر البلى ، فوقكم ، رمادته ، %~% ولم تعودوا إلى ذرائركم(@)(@@) 6 لو شاء ربي أمر ، مقتدرا ، %~% ما نقض الموت من مرائركم(@)PageV01P1567(@)(@@) البحر : كامل تام(@)(@@) 1 بين الغريزة والرشاد نفار ، %~% وعلى الزخارف ضمت الأسفار(@)(@@) 2 وإذا اقتضيت ، مع السعادة ، كابيا ، %~% أوريته نارا فقيل عفار(@)(@@) 3 أما زمانك بالأنيس ، فآهل ، %~% لكنه ، مما تود ، قفار(@)(@@) 4 أقفرت من جهتين : قفر مفازة %~% وطعام ليل جاء وهو قفار(@)(@@) 5 وإذا تساوى فيالقبيح فعالنا %~% فمن التقي ، وأينا الكفار ؟(@)(@@) 6 والناس بين إقامة وتحمل 
ms336	 %~% وكأنما أيامهم أسفار(@)(@@) 7 والحتف أنصف بينهم ، لم تمتنع %~% منه الئال ولا نجا الأغفال(@)(@@) 8 و الذنب ما غفرانه بتصنع %~% منا ولكن ربنا الغفار(@)(@@) 9 وكم اشتكت أشفار عين سهدها ، %~% وشفاؤها مما ألم شفار(@)(@@) 10 والمرء مثل الليث ، يفرس دائما ، %~% ولقد يخيب ، وتظفر الأظفار PageV01P1568(@)(@@) 11 ولطالما صابرت ليلا عاتما ، %~% فمتى يكون الصبح والإسفار ؟(@)(@@) 12 يرجو السلامة ركب خرق متلف %~% ومن الخفير أتاهم الإخفار !(@)PageV01P1569(@)(@@) البحر : خفيف تام(@)(@@) 1 إن أكلتم فضلا ، وأنفقتم فضلا %~% لا ، فلا يدخلن وال عليكم(@)(@@) 2 لا تولوا أموركم أيدي النا %~% س ، إذا ردت الأمور إليكم(@)PageV01P1570(@)(@@) البحر : -(@)(@@) 1 قد ندمنا على القبيح ، فأمسي %~% على غبر قهوة نتنادم(@)(@@) 2 خالق لا يشك فيه قديم %~% وزمان ، على الأنام ، تقادم(@)(@@) 3 جائز أن يكون آدم ، هذا ، %~% قبله آدم ، على إثر آدم(@)(@@) 4 خدم الله غيرنا ، وأرانا %~% أهل غي لربنا نتخادم(@)(@@) 5 لست أنفي عن قدرة الله أشباح %~% ح ضياء ، بغير لحم ولا دم(@)(@@) 6 وبصير القوم مثلي أعمى %~% فهلموا في حندس نتصادم(@)PageV01P1571(@)(@@) البحر : كامل تام(@)(@@) 1 كم بالمدينة من غريب نازل %~% لا ضابئ منهم ولا قيار(@)(@@) 2 أما الذين تديروا ، فتحملوا ، %~% وتخلفت بعد القطين ديار(@)(@@) 3 سار الزمان بهم إلى أجداثهم %~% وكذا الزمان بأهله سيار(@)(@@) 4 كن حيث شئت بلجة ، أو ربوة ، %~% أو وهدة ، سينالك التيار(@)(@@) 5 قد أعرست عرس الامير بتابع %~% ضرع ، فأين حليلها المغيار ؟(@)(@@) 6 والدهر سيد في الخديعة ، ضيغم %~% في الفرس ، طائر مسلك طيار(@)(@@) 7 والأرض تقتات الجسوم ، كأنما %~% هذا الحمام ، لتربها ، ميار(@)(@@) 8 والله يحمد كلما طال المدى %~% طمت الشرور ، وقلت الأخيار(@)(@@) 9 لا حظ ، في الدنيا ، لعالي همة ، %~% والوحش أفضل صيدها الأعيار(@)PageV01P1572(@)(@@) البحر : مجزوء الخفيف(@)(@@) 1 أعوز الشث والسلم %~% وأديمي به حلم(@)(@@) 2 فهنيئا لمن مضى %~% قبل أن يجري القلم(@)(@@) 3 لم تصب جسمه الكلوم %~% م ، ولا دينه كلم(@)(@@) 4 إنما صاحب التقى %~% تاجر يدفع السلم(@)(@@) 5 عجب الناس للجنين %~% إذا مسه الألم(@)(@@) 6 علم الله أنه %~% إن يطل عمره ظلم(@)(@@) 7 أصبح الشيخ ماردا %~% بعدما 
ms337	 حج واستلم(@)(@@) 8 خط أمر لفاعل %~% إن يجىء غيره يلم(@)(@@) 9 من فتى يعرف الهلا %~% ل غلاما قد احتلم(@)(@@) 10 وسهيلا مع المعا %~% في كفه زلم ؟ PageV01P1573(@)(@@) 11 خبط القوم في الضلا %~% فهل تكشف الظلم(@)(@@) 12 في بلاد مضلة %~% ليس ، في أرضها ، علم(@)(@@) 13 دونها يقصر الخيال %~% إذا طيفه ألم(@)PageV01P1574(@)(@@) البحر : كامل تام(@)(@@) 1 ماللفتى عقرت حجاه وما له %~% حمراء صافية ، فقيل عقار(@)(@@) 2 قرعت بماء ، وهي ذائب عسجد ، %~% فطفت عليه من اللجين نقار(@)(@@) 3 أودى أبوها ، وهو أسود حالك ، %~% فأقام ، يخلفه عليها القار(@)(@@) 4 لو كان قدسا ثم هبت ريحها %~% بهضابه لم يبق فيه وقار(@)(@@) 5 قد أفقرته ، وفي تجنبها غنى ، %~% ومن المليك غناه والإفقار(@)(@@) 6 لو تحمل الشرب الرواسي ، أوهموا ، %~% أن ليس ، فوق ظهورهم ، أوقار(@)PageV01P1575(@)(@@) البحر : متقارب تام(@)(@@) 1 ألا فانعموا واحذروا ، في الحياة ، %~% ملما يسمى زوال النعم(@)(@@) 2 أرى قدرا بث أحداثه ، %~% فخص بهن أناسا وعم(@)(@@) 3 وأن القنا حملتها الأكف %~% لطعن الكماة ، وشل النعم(@)(@@) 4 فلا تأمنوا الشر من صاحب %~% وإن كان خالا لكم ، وابن عم(@)(@@) 5 أتوكم بإقبالهم والحسام %~% فشد به زاعم ما زعم(@)(@@) 6 تلوا باطلا وجلوا صارما %~% وقالوا صدقنا فقلتم نعم(@)(@@) 7 أفيقوا ، فإن أحاديثهم %~% ضعاف القواعد والمدعم(@)(@@) 8 زخارف ما ثبتت في العقو %~% عمى عليكم بهن المعم(@)(@@) 9 يدول الزمان لغير الكرام ، %~% وتضحي ممالك قوم طعم(@)(@@) 10 وما تشعر الإبل الآركات %~% أعمت إلى الرسل أو لم تعم(@)PageV01P1576(@)(@@) البحر : كامل تام(@)(@@) 1 قد أذكرت هذي السنون من الأذى ، %~% - لا أن ناسيها له إذكار -(@)(@@) 2 وتعارف القوم ، الذين عرفتهم ، %~% بالمنكرات فعطل الإنكار(@)(@@) 3 ياللمنية من عوان أبكرت %~% فأوت إليها العون والأبكار(@)(@@) 4 هل تعلم الطير الغوادي علمنا ، %~% أم لا تصح لمثلها أفكار ؟(@)(@@) 5 لو أنها شعرت بما هو كائن %~% لم تتخذ لفراخها الأوتار(@)PageV01P1577(@)(@@) البحر : -(@)(@@) 1 إذا مدحوا آدميا مدح %~% مولى الموالي ورب الأمم(@)(@@) 2 وذاك الغني عن المادحين ، %~% ولكن لنفسي عقدت الذمم(@)(@@) 3 له سجد الشامخ المشمخر ، %~% على ما بعرنينه من شمم(@)(@@) 4 ومغفرة الله 
ms338	 مرجوة ، %~% إذا حسبت أعظمي في الرمم(@)(@@) 5 مجاور قوم تمشى الفنا %~% ما بين أقدامهم والقمم(@)(@@) 6 فيا ليتني هامد لا أقوم %~% إذا نهضوا ينفضون اللمم(@)(@@) 7 ونادى المنادي على غفلة ، %~% فلم يبق في أذن من صمم(@)(@@) 8 وجاءت صحائف قد ضمنت %~% كبائر آثامهم واللمم(@)(@@) 9 فليت العقوبة تحريقة %~% فصاروا رمادا بها ، أو حمم(@)(@@) 10 رأيت بني الدهر في غرة %~% وليست جهالتهم بالأمم PageV01P1578(@)(@@) 11 فنسك أناس لضعف العقول ؛ %~% ونسك أناس لبعد الهمم(@)PageV01P1579(@)(@@) البحر : كامل تام(@)(@@) 1 يا ظالما ! عقد اليدين ، مصليا ، %~% من دون ظلمك يعقد الزنار(@)(@@) 2 أتظن أنك للمحاسن كاسب %~% وخبي أمرك شرة وشنار ؟(@)(@@) 3 ومع الفتى من نفسه نمية %~% ما زال يحلف أنها دينار(@)(@@) 4 ليل بلا نور ، أجن بمهمه %~% حبس الأدلة ، ليس فيه منار(@)(@@) 5 وهي الحياة : فعفة أة فتنة %~% ثم الممات ، فجنة أو نار(@)PageV01P1580(@)(@@) البحر : طويل(@)(@@) 1 أدين برب واحد ، وتجنب %~% قبيح المساعي ، حين يظلم دائن(@)(@@) 2 لعمري ، لقد خادعت نفسي برهة ، %~% وصدقت في أشياء من هو مائن(@)(@@) 3 وخانتني الدنيا مرارا ، وإنما %~% يجهز بالذم الغواني الخوائن(@)(@@) 4 أعلل بالآمال قلبا مضللا %~% كأني لم أشعر بأني حائن(@)(@@) 5 يحدثنا عما يكون منجم ، %~% ولم يدر إلا الله ما هو كائن(@)(@@) 6 ويذكر من شأن القران شدائدا ، %~% وفي أي دهر لم تبت القرائن(@)(@@) 7 أرى الحيرة البيضاء حارت قصورها %~% خلاء ولم تثبت لكسرى المدائن(@)(@@) 8 وهجن ، لذات الملوك ، زوالها ، %~% كما غدرت بالمنذرين الهجائن(@)(@@) 9 ركبنا على الأعمار ، والدهر لجة %~% فما صبرت للموج تلك السفائن(@)(@@) 10 لقد حمد الأبناء قوم ، وطالما %~% أتتك من الأهل الشرور الدفائن PageV01P1581(@)(@@) 11 كنائن صدق كثرت عدد الفتى %~% فهن بحق ، للسهام ، كنائن(@)(@@) 12 تجيء الرزايا بالمنايا كأنما %~% نفوس البرايا للحمام رهائن(@)(@@) 13 تنطس في كتب الوثائق خائف %~% منيته ، والمرء لا بد بائن(@)(@@) 14 يضن عليها بالثمين حليلها %~% وتودع في الأرض الشخوص الثمائن(@)(@@) 15 يخاف إذا حل الثرى أن يقينها %~% لآخر من بعض الرجال ، القوائن(@)(@@) 16 يصون الكريم العرض بالمال جاهدا ، %~% وذو اللؤم للأموال بالعرض صائن(@)(@@) 17 
ms339	 متى ما تجد مسترفد الجود شاتما ، %~% ففي البخل للوجه الذي زين شائن(@)PageV01P1582(@)(@@) البحر : كامل تام(@)(@@) 1 أتعار عينك يا أبن أحمر ضلة %~% ويسوم ليس ببارح ، وتعار(@)(@@) 2 من قبل باهلة ، التي ينمى لها %~% جداك ، قيلت فيهما الأشعار(@)(@@) 3 وكذاك أحكام الزمان ، وإنما %~% ثوب الحياة وما يضم معار(@)(@@) 4 والدهر عار لا يغدر ملبسا %~% فالمجد مندرس به والعار(@)PageV01P1583(@)(@@) البحر : طويل(@)(@@) 1 لعمرك ، ما الدنيا بدار إقامة ؛ %~% ولا الحي ، في حال السلامة ، آمن(@)(@@) 2 وإن وليدا حلها لمعذب %~% جرت لسواه بالسعود الأيامن(@)(@@) 3 ونال بنوها ما حبتهم جدودهم ، %~% على أن جد المرء في الجد كامن(@)PageV01P1584(@)(@@) البحر : كامل تام(@)(@@) 1 أعمارنا جاءت كآي كتابنا : %~% منها طوال وفيت ، وقصار(@)(@@) 2 والنفس في آمالها كطريدة %~% بين الجوارح ، ما لها أنصار(@)(@@) 3 ومن الرجال محارف في دينه %~% وعن المقادر غضت الأبصار(@)(@@) 4 صلى فقصر وهو غير مسافر %~% متيمما ومحله الأمصار(@)(@@) 5 دفع الزكاة إلى الغني ، سفاهة ، %~% وغدا يحج فرده الإحصار(@)(@@) 6 إني رقدت فعمت في لجج المنى %~% ثم آنتبهت فعادني إقصار(@)(@@) 7 إن كنت صاحب جنة ، في ربوة ، %~% فتوق أن ينتابها إعصار(@)PageV01P1585(@)(@@) البحر : طويل(@)(@@) 1 عجبت لكهل قاعد بين نسوة ، %~% يقات بما ردت عليه الروادن(@)(@@) 2 يعال على ذم ويزجر بعضه %~% كما زجرت ، بين الجياد ، الكوادن(@)(@@) 3 يكاد الورى لا يعرف الخير بعضه %~% على أنه كالترب فيه معادن(@)(@@) 4 أتحاربنا أيامنا ، ولنا رضى %~% بذلك ، لو أن المنايا تهادن(@)(@@) 5 إذا كان جسمي ، للرغام ، أكيلة ، %~% فكيف يسر النفس أني بادن ؟(@)(@@) 6 ومن شر أخدان الفتى أم زنبق ، %~% وتلك عجوز أهلكت من تخادن(@)(@@) 7 تخبر عن أسراره قرناءه ، %~% ومن دونها قفل منيع وسادن(@)PageV01P1586(@)(@@) البحر : كامل أحذ(@)(@@) 1 لا علم لي بم يختم العمر %~% شجر الحياة له الردى ثمر(@)(@@) 2 تغنيك ساعات ، مواشكة ، %~% عما تغول البيضة السمر(@)(@@) 3 والإنس قربها أنسا %~% وكأنها الآساد والنمر(@)(@@) 4 حجبت عقلك عن محاورة %~% بالخمر ، وهي لمثله خمر(@)(@@) 5 من سره بدن يعيش به ، %~% فسروري التلويح والضمر(@)(@@) 6 ليل يجن وفي حنادسه %~% قمر ، تجاول 
ms340	 تحته قمر(@)(@@) 7 والسود في الهبوات تكشفها %~% خضر المتون ، صدورها حمر(@)(@@) 8 والناس في تيه ، بلا أمر ، %~% والله يفصل عنده الأمر(@)(@@) 9 وتكشف الغمرات عن رجل ، %~% وهو الجهول ، بشأنه ، الغمر(@)(@@) 10 %~% يختار ، لا زيد ولا عمرو PageV01P1587(@)(@@) 11 عمنا على در فأعوزنا %~% إن الجواهر دونها الغمر(@)(@@) 12 وأرى المعاشر في غرائزهم %~% سوء الطباع : الختل والقمر(@)(@@) 13 نار ، فميتهم الرماد هبا ، %~% وكأنما أحياؤهم جمر(@)(@@) 14 وتشوقني ، في الجنح ، زامرة ، %~% ما دينها لعب ولا زمر(@)(@@) 15 أين الذين كلامهم أبدا %~% قطر الجهام ، وجودهم همر(@)(@@) 16 إن يغمروك بنائل وندى %~% منهم فما بصدروهم غمر(@)(@@) 17 ليس أمروء في العصر أعلمه %~% إلا وباطن أمره إمر(@)(@@) 18 اما اللئيم فعنده حلل %~% وغدا الكريم ، وثوبه طمر(@)(@@) 19 طمر الجهول إلى مراتبه ، %~% ثم آنثنى وخبا } ه طمر(@)PageV01P1588(@)(@@) البحر : كامل أحذ(@)(@@) 1 عبر الشباب ، لأمه العبر ، %~% لا غابر منه ولا غبر(@)(@@) 2 كالأدهم الجاري مضى فاذا %~% آثاره بمفارقي غبر(@)(@@) 3 ونعوذ بالخلاق ، من أمم %~% أوفى المنازل منهم القبر(@)(@@) 4 إبر العقارب ، فوق ألسنهم ، %~% محمولة فكلامهم أبر(@)(@@) 5 وخبرتهم ، فوجدت أخبرهم %~% لا إيل ، عندهم ، ولا جبر(@)(@@) 6 هل يعصمنك من لقاء ردى %~% بالرغم أنك عالم حبر(@)(@@) 7 وحصلت من ورق على ورق %~% بيض يشق متونها حبر(@)(@@) 8 فضت نهاك بفضة سبكت %~% ولقد أتى بتبارك التبر(@)(@@) 9 والله أكبر ، فالولاء له ، %~% وكذا الولاء يحوزه الكبر(@)(@@) 10 لو لم تكن ، في القوم ، أصغرهم ، %~% ما بان فيك عليهم كبر PageV01P1589(@)(@@) 11 و الداء يطرد بالأمر وصر %~% ف الخطب وقت نزوله الصبر(@)(@@) 12 والعيش سقم ، لا سآم له ، %~% وجراحه يعيا بها السبر(@)(@@) 13 و الناس شرهم كخيرهم %~% وتساوت النعرات والدبر(@)(@@) 14 ماآل ببر إن وصفتهم %~% الا ضراغم جدثها ببر(@)(@@) 15 هاو إلى وهد ، يخالفه %~% راقي الهضاب كأنه وبر(@)(@@) 16 يوفي على شرفات منبره ، %~% من همه التحقيق والنبر(@)(@@) 17 يتلو العظات ، وليس متعظا ، %~% بل شده لحزامه الضبر(@)(@@) 18 قد أقطع السبروت يملأ ، بال %~% آل ، المروت ، فيشحب السبر(@)(@@) 20 أودى الزمان بذي الأمان ، فلا ال %~% عرجي موجود 