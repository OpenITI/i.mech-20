ms41	(@)(@@) % فلما تر غير الرفق فينا سجيا % وإن كان بعض القوم أبدى لها عنفا % % 15(@)(@@) % تحمل أعباء الصدارة كامل % % فناء به ما لم يخف وما خفا % % 16(@)(@@) % طوى كشحه منها على غير لطفها % % وأظهر من وجه الخداع بها اللطفا % % 17(@)(@@) % نحا أن يتم الدست فيها لحزبه % % علينا وضن الأمر فيما نحا يخفى % % 18(@)(@@) % وقد فاته أنا أول المعية % % بها نخطف الأسرار من قلبه خطفا % % 19(@)(@@) % وأنا نرى من قد تأبط شره % % بعين تقد الإبط أو تخلع الكتفا % % 20(@)(@@) % لنا فطنة نرمي الزمان بنورها % % فيبدو حجاب الغيب منه وقد شفا % % PageV01P129 21(@)(@@) % رمانا بشزر اللحظ نزور طرفه % % فصحنا به أن غض يا كامل الطرفا % % 22(@)(@@) % فما نحن بعد اليوم مهما تنوعت % % عناصرنا من أمه تحمل الخسفا % % 23(@)(@@) % مددنا إلى كف الإخاء أكفنا % % نصافحه شوقا فمد لنا الكفا % % 24(@)(@@) % فطاب لنا منه العناق وضمنا % % إليه فقبلناه من عينه ألفا % % 25(@)(@@) % أذلا وهذا العز صرح سابغا % علينا إذن فالعز أن ندرك الحتفا % % 26(@)(@@) % إذا نحن قمنا محنقين رأيتنا % % ندك جبال الظلم ننسفها نسفا % % 27(@)(@@) % ونحن إذا ما الحرب أفنت جيادنا % % قتالا ركبنا الموت في حربنا طرفا % % 28(@)(@@) % تربع في صدر الوزارة كامل % % فخط من النقصان في وجهها حرفا % % 29(@)(@@) % وأنحى عليها بالجفاء مشتتا % نجاحا بركنيها الركينين ملتفا % % 30(@)(@@) % لقد أغضب الدستور فعلا ونيه % % ومن أعلنوا الدستور والشعب والصحف % % PageV01P130 31(@)(@@) % % فأعياه إيضاح الحقيقة فاستعفى % % 32(@)(@@) % ولم يطلب الإمهال إلا لأنه % % رأى عذره إن لم يطل سبكه زيفا % % 33(@)(@@) % كذالك من صاغ الكلام ملفقا % % تمهل حينا يكثر الخط والحذفا % % 34(@)(@@) % ومن قال حقا قاله عن بديهة % % ويحتاج للتفكير مكن موه الخلف % % 35(@)(@@) % فيا أيها ' الصدر ' الجديد أتعظ به % % فإياك أن تطغى وأن تثنى العطفا % % 36(@)(@@) % ويا مجلس النواب سر غير عاثر % % إلى المجد لا تلقى كلالا ولا ضعفا % % 37(@)(@@) % ودع عنك مذموم التجافي فإنما % % لغير التجافي اختارك الشعب % % 38(@)(@@) % ألم تر أرجاء البلاد محولة % % من العلم فاستمطر لها الديم الوطفا % % 39(@)(@@) % بلاد جفاها الأمن فهي مريضة % % فحقق 
ms42	 لها من طب رأيك أن تشفي % % 40(@)(@@) % فإن لأهليها عليك لذمة % ومثلك من راعى الذمام ومن % % PageV01P131 41(@)(@@) % وما أنت إلا أمة قد تقدمت % % أماما وقد خلت تقهقرها خلفا % % 42(@)(@@) % ولا تنس مغبر العراق وأهله % % فإن البلاء الجم من حوله احتفا % % 43(@)(@@) % فدجله أمست كالد جيل شحيحة % % فلا أنبتت زرعا ولا أشبعت ظلفا % % 44(@)(@@) % وإن ' الفرات ' العذب أمسى مرنقا % به الماء يجفو أو به الماء قد جفا % % 45(@)(@@) % سل ' الحلة ' الفيحاء عنه فإنها % % حكت شهداء الطف إذ نزلوا الطفا % % 46(@)(@@) % فيا ويل قوم في العراق قد انطووا % % على الذل إذ أمست قلوبهم غلفا % % 47(@)(@@) % ولم يذكروا مجدا لهم كان ضاربا % رواقا على هام كواكب قد أوفى % % 48(@)(@@) % وكانوا به شم العرانين فاغتدوا % % يقاسون أهوالا به تجدع الأنفا % % 49(@)(@@) % يرجون من أهل القبور رجاءهم % % ومن يحمل الدبوس أو يضرب الدفا % % PageV01P132 البحر : طويل 1(@)(@@) % علام حرمنا منذ حين تلاقيا % % أفي سفر قد كنت أم كنت لاهيا % % 2(@)(@@) % عهدناك لا تلهو عن الخل ساعة % % فكيف علينا قد أطلت التجافيا % % 3(@)(@@) % ومالي اراك اليوم وحدك جالسا % بعيدا عن الخلان تأبى التدانيا % % 4(@)(@@) % أنابك خطب أم عراك تعشق % % فإني أرى حزنا بوجهك باديا % % 5(@)(@@) % وما بال عينيك اللتين أراهما % % تديران لحظا يحمل الحزن وانيا % % 6(@)(@@) % واي جوى قد عدت اصفر فاقعا % به بعد أن قد كنت أحمر قانيا % % 7(@)(@@) % تكلم فما هذا الوجوم فانني % % عهدتك غربدا بشعرك شاديا % % 8(@)(@@) % تجلد تجلد ياسليم ولا تكن % % بما ناب من صرف الزمان مباليا % % 9(@)(@@) % ولا تبتئس بالدهر ان خطوبه % % سحابة صيف لا تدوم ثوانيا % % 10(@)(@@) % فقال ولم يملك بوادر أدمع % % تناثرن حتى خلتهن لياليا % % PageV01P133 11(@)(@@) % لقد هجتني يا أحمد اليوم بالأسى % % وذكرتني ما كنت بالامس ناسيا % % 12(@)(@@) % اتعجب من حزني وتعلم انني % % قريع تياريح تشيب النواصيا % % 14(@)(@@) % ترحلت عنها لا علي ولا ليا % % 15(@)(@@) % وقد كنت اشكوا الكاشحين من العدى % % فأصبحت من جور الأخلاء شاكيا % % 16(@)(@@) % ومارحت استشفى القلوب مداويا % من الحقد الا عدت عنها كما هيا % % 17(@)(@@) % وداريت 
ms43	 حتى قيل لي متعلق % % وما كان من داء التملق دائيا % % 18(@)(@@) % وحتى دعاني الحزم أن خل عنهم % فإن صريح الرأي ألا تداريا % % 19(@)(@@) % ورب أخ أو قرت قلبي بحبه % % فكنت على قلبي بحبيه جانيا % % 20(@)(@@) % أراد انقيادي للهوان وما درى % % باني حر النفس صعب قياديا % % 21(@)(@@) % إذا ما سمائي جاد بالذل غيثها % % أبيت عليها أن تكون سمائيا % % PageV01P134 22(@)(@@) % الا فابك لي يااحمد اليوم رحمة % % ودعنى وشأني والاسى وفؤاديا % % 23(@)(@@) % فان احق الناس بالرحمة امروء % % أضاع ودادا عند من ليس وافيا % % 24(@)(@@) % وما كان حظي وهو في الشعر ضاحك % % ليظهر إلا في سوى الشعر باكيا % % 25(@)(@@) % ركبت بحور الشعر رهوا ومائجا % وأقحمت منها كل هول يراعيا % % 26(@)(@@) % وسيرت سفني في طلاب فنونه % % وألقيت في غير المديح المراسيا % % 27(@)(@@) % وقلت أعصني يا شعر في المدح إنني % % ارى الناس موتى تستحق المراثيا % % 28(@)(@@) % ولو رضيت نفسي بأمر يشينها % % لما نطقت بالشعر الا اهاجيا % % 29(@)(@@) % وكم قام ينعى حين انشدت مادحا % الي الندى ناع فانشدت راثيا % % 30(@)(@@) % وكم بشرتني بالوفاء مقالة % % فلما انتهت للفعل كانت مناعيا % % 31(@)(@@) % وقالت بكى امسكت فضل ردائه % % وكفكفت دمعا فوق خديه جاريا % % PageV01P135 32(@)(@@) % وقلت له هون عليك فإنما % % تنوب دواهي الدهر من كان داهيا % % 33(@)(@@) % % فكنت الفتى الاعلى وكانو الادانيا % % 34(@)(@@) % لعل الذي أشجاك يعقب راحة % % فقد يشكر الإنسان ما كان شاكيا % % 35(@)(@@) % ألا رب شر جر خيرا وربما % % يجر تجافينا إلينا التصافيا % % 36(@)(@@) % فلو أن ماء البحر لم يك مالحا % % لرحنا من الطوفان نشكو الغواديا % % 37(@)(@@) % ولولا اختلاف الجذب والدفع لم تكن % % نجوم بأفلاك لهن جواريا % % 38(@)(@@) % وكيف نرى للكهرباء ظواهرا % اذا هي في الاثبات لم تلق نافيا % % 39(@)(@@) % تموت القوى ان لم تكن في تباين % % ويحين ما دام التباين باقيا % % 40(@)(@@) % فلا تعجبن من أننا في تنافر % % ألم تغن عنهم أن ملكت القوافيا % % 41(@)(@@) % فطر في سماوات القريض مرفرفا % % وأطلع لنا فيها النجوم الدراريا % % PageV01P136 42(@)(@@) % فانت امروء تعطي القوافي حقها % % فتبدو وان ارخصتهن غواليا % % 43(@)(@@) % يجيبك عفوا 
ms44	 إن أمرت شرودها % % وتأتيك طوعا إن دعوت العواصيا % % 44(@)(@@) % فقال وقد ألقى على الصدر كفه % فتشد بها قلبا من الوجد هافيا % % 45(@)(@@) % لقد جئتى بالقول رطبا ويابسا % فداويت لي سقما وهيجت ثانيا % % 46(@)(@@) % فإني وإن أبدى لي القوم جفوة % % أمنى لهم مما احب الامانيا % % 47(@)(@@) % وما انا عن قومي غنيا وان اكن % % أطاول في العز الجبال الرواسيا % % 48(@)(@@) % إذا ناب قومي حادث الدهر نابني % % وان كنت عنهم نازح الدار نائيا % % 49(@)(@@) % وما ينفع الشعر الذي أنا قائل % % اذا لم اكن للقوم في النفع ساعيا % % 50(@)(@@) % ولست على شعري أروم مثوبة % % ولكن نصح القوم جل مراميا % % 51(@)(@@) % وما الشعر إلا أن يكون نصيحة % % تنشط كسلانا وتهض ثاويا % % PageV01P137 52(@)(@@) % وليس سرى القوم من كان شاعرا % % ولكن سري القوم من كان هاديا % % 53(@)(@@) % فعلمهم كيف التقدم في العلى % ومن أي طرق يبتغون المعاليا % % 54(@)(@@) % وابلى جديد الغي منهم برشده % % وجدد رشدا عندهم كان باليا % % 55(@)(@@) % وسافر عنهم رائدا خصب نفعهم % % يشق الطواقي أو يجوب المواليا % % PageV01P138 البحر : بسيط تام 1(@)(@@) % اشر فعل البرايا فعل منتحر % % وأفحش القول منهم قول مفتخر % % 2(@)(@@) % ان التمدح من عجب ومن أشر % % والمرء في العجب ممقوت وفي الاشر % % 3(@)(@@) % يا راجي الأمر لم يطلب له سببا % كيف الرماية عن قوس بلا وتر % % 4(@)(@@) % ليس التسبب من عجز ولا خور % % وانما العجز تفويض إلى القدر % % 5(@)(@@) % دع الأناسي وانسبني لغيرهم % إن شئت للشاه أو إن شئت للبقر % % 6(@)(@@) % فإن للبشر الراقي بخلقته % % من قد انفت به أني من البشر % % 7(@)(@@) % ألبس حياتك احوال المحيط وكن % % كالماء يلبس ما للظرف من جدر % % 8(@)(@@) % وان ابيت فلا تجزع وانت بها % % عار من الأنس أو كاس من لبضجر % % 9(@)(@@) % إن رمت عزا على فقر تكابده % % فاستغن عن مال اهل البذخ والبظفر % % 10(@)(@@) % اذانظرت إلى الجزئي تصلحه % % فارقبه من مرقب الكلي في النظر % % PageV01P139 11(@)(@@) % فان نفعك شخصا واحد ربما % % يكون منه عموم الناس في الضرر % % 12(@)(@@) % قد يقبح الشئ وضعا وهو من حسن % % كالنعش 
ms45	 يدهش مرأى وهو من شجر % % 13(@)(@@) % فالقبح كالحسن في حكم النهى عرض % % وليس يثبت إلا عند معتبر % % 14(@)(@@) % لا تعجبن الذي عقل يروح به % % لينتج الشر خيرا غير منتظر % % 15(@)(@@) % فانما لمعات الخير كامنة % % بين الشرور كمون النار في الحجر % % 16(@)(@@) % سبحان من أوجد الأشياء واحدة % % وانما كثرة الاشياء بالصور % % 17(@)(@@) % هب منشأ القوم يبقى مبهما أبدا % فهل ترى فيه عقلا غير منبر % % 18(@)(@@) % الحب والبغض لا تأمن خداعهما % % فكم هما أخذا قوما على غرر % % 19(@)(@@) % فالبغض يبدي كدورا في الصفاء كما % % أن المحبة تبدي الصفو في الكدر % % 20(@)(@@) % واشنع الكذب عندي ما يمازجه % % شئ من الصدق تمويها على الفكر % % PageV01P140 21(@)(@@) % فان ابطال هذا في النهى عسر % % وليس إبطال محض الكذب بالعسر % % 22(@)(@@) % قالوا عشقت معيب الحسن قلت لهم % % كفوا الملام فما قلبي بمنزجر % % 23(@)(@@) % ما العشق إلا العمى عن عيب من عشقت % هذي القلوب ولا اعني عمى البصر % % 24(@)(@@) % قالوا ابن من أنت يا هذا فقلت لهم % % أبي امرؤ جده الأعلى أبو البشر % % 25(@)(@@) % قالوا فهل نال مجدا قلت واعجبي % % اتسألوني بمجد ليس من ثمري % % 26(@)(@@) % لا در در قصيد راح ينظمه % % من ليس يعرف معنى الدر والدرر % 27(@)(@@) % يبكي الشعور لشعر ظل ينقده % % من لا يفرق بين الشعر والشعر % % 28(@)(@@) % قالتنواروقد انشدتها سحرا % ممن تعلمت نفث السحر في السحر % % 29(@)(@@) % فقلت من سحر عينيك الذي سحرت % % به المشاعر من سمع ومن بصر % % PageV01P141 البحر : طويل 1(@)(@@) % لقد طوحتني في البلاد مضاعا % % ظوائح جاءت بالخطوب تباعا % % 2(@)(@@) % فبارحت ارضا ماملأت حقائبي % % سوى حبها عند البراح متاعا % % 3(@)(@@) % عتبت على بغداد عتب مودع % % أمضته فيها الحادثات قراعا % % 4(@)(@@) % أضاعتني الأيام فيها ولو درت % % لعز عليها ان اكون مضاعا % % 5(@)(@@) % لقد أرضعتني كل خسف وإنني % % لأشكرها أن لم تتم رضاعا % % 6(@)(@@) % وما انا بالجاني عليها وانما % % نهضت خصاما دونها ودفاعا % % 7(@)(@@) % وأعملت اقلامي بها عربية % % فلم تبد أصغاء لها وسماعا % % 8(@)(@@) % ولو كنت أدري انها أعجمية % % تخذت بها السيف الجراز يراعا % % 9 
ms46	(@)(@@) % ولو شئت كايلت الذين انطووا بها % % على الحقد صاعا بالعداء فصاعا % % 10(@)(@@) % ولكن هي النفس التي قد أبت لها % % طباع المعالي أن تسوء طباعا % % PageV01P142 11(@)(@@) % أبيت عليهم أن أكون بذلة % % وتأبى الضواري أن تكون ضباعا % % 12(@)(@@) % على أنني داريت ما شاء حقدهم % % فلم يجد نفعا ما أتيت وضاعا % % 13(@)(@@) % وأشقى الورى نفسا وأضيعهم نهى % لبيب بداري في نهاه رعاعا % % 14(@)(@@) % تركت من الشعر المديح لأهله % % ونزهت شعري أن يكون قذاعا % % 15(@)(@@) % وأنشدته يجلو الحقيقة بالنهى % % ويكشف عن وجه الصواب قناعا % % 16(@)(@@) % وأرسلته عفوا فجاء كما ترى % % قوافي تجتاب البلاد سراعا % % 17(@)(@@) % وقفت غداة البين في الكرى وقفة % % لهاكربت نفسي تطير شعاعا % % 18(@)(@@) % أودع أصحابي وهم محدقون بي % % وقد ضقت بالبين المشت ذراعا % % 19(@)(@@) % أودعهم في الكرخ والطرف مرسل % % إلى الجانب الشرقي منه شعاعا % % 20(@)(@@) % % كأن برأسي يا أميم صداعا % % PageV01P143 21(@)(@@) % وكنت أظن البين سهلا فمذ أتى % % شرى البين مني ما أراد وباعا % % 22(@)(@@) % وإني جبان في فراق أحبتي % % وأن كنت في غير الفراق شجاعا % % 23(@)(@@) % كإني وقد جد الفراق سفينه % % أشالت على الريح الهجوم شراعا % % 24(@)(@@) % فمالت بها الأرواح والبحر مائج % % وقد أشكت الواحها تتداعى % % 25(@)(@@) % فتحسبني من هزة في أفدعا % ترى هضابا زلزلت وتلاعا % 26(@)(@@) % فما أنا إلا قومة وإنحناءة % % وسر أذاعته الدموع فذاعا % % 27(@)(@@) % رعى الله قوما والرصافة كلما % % تذكرتهم زاد الفؤاد نزاعا % % 28(@)(@@) % أبيت وما أقوى الهموم بمضجع % % تصارعني فيه الهموم صراعا % % 29(@)(@@) % وألهو بذكراهم على السير كلما % % هبطت وهادا أو علوت يفاعا % % 30(@)(@@) % هم القوم أما الصبر عنهم فقد عصى % % وأما اشتياقي نحوهم فأطاعا % % PageV01P144 31(@)(@@) % لقد حكموني في الأمور فلم أكن % % لأنطق إلا أمرا ومطاعا % % 32(@)(@@) % % زجرت كلابا أم قحمت سباعا % % 33(@)(@@) % سلام على وادي السلام وإنني % % لأجعل تسليمي عليه وداعا % % 34(@)(@@) % له الله من واد تكاسل أهله % % فباتوا عطاشا حوله وجياعا % % 35(@)(@@) % رآهم عبيدا فاستبد بمائه % % 36(@)(@@) % جرى شاكرا صنع الطبيعة إنها % % أبانت يدا في جانبيه الصناعا % % 37(@)(@@) % وما أنس لا أنس المياه بدجلة % % وإن 
ms47	 هي تجري في العراق ضياعا % % 38(@)(@@) % ولو أنها تسقي العراق لما رمت % % 39(@)(@@) % وما وجدت ريح وإن قد تناوحت % % مهبا به إلا قرى وضياعا % % 40(@)(@@) % سأجري عليها الدمع غير مضيع % % وأنوب قاعا من هناك فقاعا % % PageV01P145 41(@)(@@) % وأذكر هاتيك الرباع بحسنها % % فنعمت على شحط المزار رباعا % % PageV01P146 البحر : طويل 1(@)(@@) % الا لفت منا إلى الزمن الخالد % % فتغبط من أسلافنا كل مفضال % % 2(@)(@@) % تلونا أناسا في الزمان تقدموا % % وكم عبرة فيمن تقدم للتالي % % 3(@)(@@) % ألا فاذكروا يا قوم أربع مجدكم % % فقد درست إلا بقية أطلال % % 4(@)(@@) % تطلبتم صفو الحياة وأنتم % بجهل ، وهل تصفو الحياة لجهال ؟ % 5(@)(@@) % وما أنتم إلا كسكران طافح % % تحسى من الصهباء عشرة أرطال % % 6(@)(@@) % مشي بارتعاش في الطريق فتارة % % يقوم وأخرى ينهوي فوق أو حال % % 7(@)(@@) % يمد إلى الجدران كف استناده % % فتقذفه الجدران قذيفة أذلال % % 8(@)(@@) % ويفتح للطراق مقلة حانق % % فيغمضها خزيان عن شتم عذال % % 9(@)(@@) % رمى الدهر قومي بالخمول فلمتهم % % وأوسعتهم عذلا فلم يجد تعذالي % % 10(@)(@@) % فهاج البكى يأسي فلما بكيتهم % % بدمعي حتى بل دمعي سربالي % % PageV01P147 11(@)(@@) % نظرت إلى الماضي وفي العين حمرة % % كأن على اماقها نضح جريالي % % 12(@)(@@) % فشمت بروق الأولين منيرة % % على أفق من ذلك الزمن الخالي % % 12(@)(@@) % سيروا البرق بينهن رسولا % % 13(@)(@@) % ' تنورتها من أذرعات وأهلها % % بيثرب أدنى دارها نظر عال ) % 14(@)(@@) % وقلبت طرفي في سماء رجالها % % وهم فوق عرش من جلال محلال % % 15(@)(@@) % فآنست آتارا وهم سلك درها % % وأبصوت أعمالا وهم جيدها الحالي % % 16(@)(@@) % ولما طويت الدهر بيني وبينهم % % على بعد أزمان هناك وأجيال % % 17(@)(@@) % قعدت بأوساط القرون فجاءني % ' أبو بكر الرازي ' فقمت لإجلال % % 18(@)(@@) % فتى عاش أعمالا جساما وإنما % % تقدر أعمار الرجال بأعمال % % 19(@)(@@) % حكم رياضي طبيب منجم % % أديب وفي الكمياء حلال أشكال % % PageV01P148 20(@)(@@) % أني فيلسوفا للنفوس مهذبا % % بأفضل أفعال وأحسن أقوال % % 21(@)(@@) % لقد طبب الأرواح من داء جهلها % % كما طبب الأجسام من كل إغلال % % 22(@)(@@) % تولد عام الأربعين الذي انقضى % % لثالث قرن ذي مآثر أزوال % % 23(@)(@@) % إلى زكريا ينتمي إنه له % % أب تاجر 
ms48	 في الري صاحب أموال % % 24(@)(@@) % على حين كانت بلدة الري عادة % % إلى العلم تعطو جيدها غير معطال % % 25(@)(@@) % مدارس بالشبان تزهو ودونها % % كتاتيب للتعليم تزهو بأطفال % % 26(@)(@@) % بها جل درس القوم طب وحكمة % % وفلسفة فيها لهم أي إيغال % % 27(@)(@@) % وكانت نفيسات الصنائع عندهم % % يحاوالها ذو الفقر منهم وذو المال % % 28(@)(@@) % % بل الحال في البلدان طرا كذا الحال % % 29(@)(@@) % فإن هدى الإسلام أنهى فتوحه % % وآصلها للحد أحسن إيصال % % PageV01P149 30(@)(@@) % وبدل أبطال الحروب من الورى % % بأبطال علم للجهالة قتال % % 31(@)(@@) % فدارت رحى تلك العلوم وقطبها % % ببغداد مركوز بربوة إجلال % % 32(@)(@@) % وكانت يد المأمون في ذاك أخجلت % % لسان العلي في شكره أي إخجال % % 33(@)(@@) % تدرج في تلك المدارس ناشئا % % مترجمنا يسعى بجد وإقبال % % 34(@)(@@) % تعلم فن الصوت باديء بدئه % % ومارس تفصيلا به بعد إجمال % % 35(@)(@@) % فكانت بموسيقى اللحون دروسه % % تغنى بأهزاج وتشدو أرمال % % 36(@)(@@) % وقد جاوز العشرين سنا ولم يكن % % بشئ سوى فن الغناء بميال % % 37(@)(@@) % فرام أبوه منه تحويل عزمه % % بجذب إلى شغل التجار وإدخال % % 38(@)(@@) % فقال له دعني مع العلم إنني % % إذا ما أمت الجهل أحييت آمالي % % 39(@)(@@) % وهل يستطيع المرء شغلا إذا غدا % % له شاغل بالعلم عن كل أشغال % % PageV01P150 40(@)(@@) % هنالك استقى الرازي من العلم شربه % % فجاد بإعلال له بعد إنهال % % 41(@)(@@) % سعى سعيه نحو التعلم بادئا % بعلم لدى أهل التفلسف ذي بال % % 42(@)(@@) % وقد كان مفتاح العلوم تفلسف % % تفك به من جهلهم كل أغلال % % 43(@)(@@) % فزاول أنواع العلوم تنقلا % % 44(@)(@@) % نضا همة في العلم مشحوذة الشبا % % جلت ما لحرب الجهل من ليل قسطال % % 45(@)(@@) % وقد أكمل الطب المفيد قراءة % على الطبري الحبر أحسن إكمال % % 46(@)(@@) % ومذ جاوز الرازي لثلاثين واغتدى % % مدلا على أقرانه أي إدلال % % 47(@)(@@) % رأى من تمام العلم للمرء أنه % % يسيح بضرب في البلاد وتجوال % % 48(@)(@@) % وما العلم إلا بالسياحة إنها % % لمن عملوا في علمهم درس أعمال % % 49(@)(@@) % فقام وشد الرجل والغرز وامتطى % % لقطع الفيافي متن هوجاء شملال % % PageV01P151 50(@)(@@) % فجاء بلاد الشام توا وجازها % % إلى مصر في 
ms49	 وخد حثيث وإر قال % % 51(@)(@@) % وخاض عباب البحر للغرب قاصدا % % مواطنا للإسلام لم يسلها السالي % % 52(@)(@@) % ففيها احتلاه العز مذ لاح طالعا % لها كهلال يجتلى عند إهلال % % 53(@)(@@) % وحل حلول البدر في السعد نائلا % بقرطبه آماله ناعم البال % % 54(@)(@@) % وهب هبوب الريح ثمة ذكره % % يطير على صيت من العلم جوال % % 55(@)(@@) % وودعها من بعد ذلك راجعا % إلى مصر لا توديع مستكره قال % % 56(@)(@@) % ومنها إلى بغداد سافر قاطعا % إليها الفلا ما بين حل وترحال % % 57(@)(@@) % فأرقى عصر التسيار من عرصاتها % % بمغرس عرفان ومنبت إفضال % % 58(@)(@@) % وبغداد كانت وهي إذ ذاك جنه % % بها العلم أجرى منه أنهار سلسال % % 59(@)(@@) % كأن رجال العلم في غرفاتها % % بلابل تشدو غدوة بين أدغال % % PageV01P152 60(@)(@@) % فكم محفل للكتب فيه خزانة % % وكم مرصد دان وكم مرقب عال % % 61(@)(@@) % ولما غدا الرازي ببغداد باسطا % % 62(@)(@@) % أقيم لمارستانها عن كفاءة % % رئيسا بتطبيب وتدبير أحوال % % 63(@)(@@) % فرتب مرضاه وأصلح شأنه % % بما كان لم يخطر لسابق أجيال % % 64(@)(@@) % وضل به يسعى طبيبا ممرضا % ويبذل جهدا لم يكن فيه بالآلى % % 65(@)(@@) % % لدى سرر المرضى تقرر في الحال % % 66(@)(@@) % فقد كان يلقيها على القوم ناطقا % بأوضح تبيان وأحسن إملال % % 67(@)(@@) % لقد أشغل الرازي ببغداد شغله % عدا الطب في الكمياء أعظم إشغال % % 68(@)(@@) % فقضى بها أيامه في تجارب % % وواصل أبكارا لهن بآضال % % 69(@)(@@) % فلقب فيها بالمجرب حرمة % % تفرد مخصوصا بها بين أمثال % % PageV01P153 70(@)(@@) % وأصبح مشهورا بأسنى مآثر % % من العلم لم يسبق إليها وأعمال % % 71(@)(@@) % فإن أبا بكر لأول مفصح % % إلى الناس بالدرس السريري مقوال % % 72(@)(@@) % وأول من أبدى لهم كيف يبتنى % % ويفرش مارستانهم قصد إبلال % % 73(@)(@@) % وألف في المستشفيات مؤلفا % تقصى به في وصفها دون إغلال % % 74(@)(@@) % ولا تنس للرازي الكحول فإنه % % يجدد طول الدهر ذكراه في البال % % 75(@)(@@) % ومن عمل الرازي انعقاد لسكر % % وما كان في محصوله غير سيال % % 76(@)(@@) % أرى العلم كالمرآة يصدأ وجهه % % وليس سوى حسن الخلائق من جال % % 77(@)(@@) % أخو العلم لا يغلو على سوء خلقه % % وذو الجهل إن أخلاقه 
ms50	 حسنت غال % % 78(@)(@@) % ولو وازن العلم الجبال ولم يكن % % له حسن خلق لم يزن وزن مثقال % % 79(@)(@@) % وإن المساوي وهي في خلق عالم % % لأقبح منها وهي في خلق جهال % % PageV01P154 80(@)(@@) % ( لعمري وما أدري وقد آذن البلى % % بأحسن أخلاق وأشرف أفعال % % 81(@)(@@) % خلائق غر إن أردت بيانها % % بدأت بحرف الحاء والميم والدال % % 82(@)(@@) % % بكل هزيل الجسم من سقم إقلال % % 83(@)(@@) % % ويفتقد المرضى بفحص وتسال % % 84(@)(@@) % وتيهم بالمال والعلم مسعدا % لتطبيب أوجاع وتأمين أوجال % % 85(@)(@@) % وما كان يقنو المال إلا لبذله % % لتعليم علم أو لإعطاء سؤال % % 86(@)(@@) % وكان حليف الجد لم يأل جهده % % بدحض خصوم العلم من كهزال % % 87(@)(@@) % فكم راح مخذولا به متطبب % % سعى كاذبا في طبه سعي إضلال % % 88(@)(@@) % وكان سليما في العقيدة قلبه % % 89(@)(@@) % وخل تفاصيل الألى ينسبونه % % لزيغ فقد أغناك عنهن إجمالي % % PageV01P155 90(@)(@@) % ولما قضى الرازي ببغداد برهة % % مضى قافلا للري شوقا إلى الآل % % 92(@)(@@) % وألف للمنصور إذ ذاك بأسمه % % كتابا حوى من الطب أحسن أقوال % % 93(@)(@@) % ولم تصف للرازي أواخر عمره % % وعاد أخاهم شديد وبالبال % % 94(@)(@@) % فقد عميت عيناه من بعد واغتدى % % يجول من الفقر الشديد بأسمال % % 95(@)(@@) % وإن عدا الدهر شنشنة له % % يصول بها قهرا على كل مفضال % % 96(@)(@@) % ولما انتهى نحو الثمانين عمره % % قضى نحبه من غير مال وأنسال % % 97(@)(@@) % ولكنه في الناس خلف بعده % % من العلم آثارا قليلة أمثال % % 98(@)(@@) % فكم كتب أبقى بها الذكر في الورى % % وألفها نسجا على خير منوال % % 99(@)(@@) % وما ضر من أحيا له العلم بعده % % على الدهر ذكرا أنه ميت بال % % 100(@)(@@) % وإني وإن طنبت في بحر علمه % % لمقتصر منه على بعض أوشال % % PageV01P156 101(@)(@@) % وها أنا أنهي القول لا لتمامه % % ولكن لعجزي عن نهوض بأجبال % % 102(@)(@@) % وأجعل هذا الشعر مسكا ختامه % % بما قال في بيتين معناهما حال % % 103(@)(@@) % ' بعمري وما أدري وقد أذن البلى % % بعاجل ترحال إلى أين ترحالي ) % 104(@)(@@) % ( وأين محل الروح بعد خروجهم % % من الهيكل المنحل والجسد البالي ' % PageV01P157 البحر : طويل 1(@)(@@) % هو الدهر لم يرحم إذا شد 
ms51	 في حرب % % ولم يتئد إما تمخض بالخطب % % 2(@)(@@) % يزمجر أحيانا ويضحك تارة % % فيظهر في بردين للجد واللعب % % 3(@)(@@) % فلا هو في سلم فنأمن بطشه % % 4(@)(@@) % يسالم حتى تأخذ القوم غرة % % فيهجم زحفا في زعازعة النكب % % 5(@)(@@) % أرى الدهر كالميزان يصعد بالحصى % % ويهبط بالموزون ذي الثمن المربي % % 6(@)(@@) % أدال من العرب الأعاجم بعدما % % أدال بني عباسها من بني حرب % % 7(@)(@@) % ولم أر للأيام أشنع سبة % % لعمرك من ملك العلوج على العرب % % 8(@)(@@) % صفت لبني العباس أحواض عزهم % % زمانا وعادت بعد مخلبة الشرب % % 9(@)(@@) % عنت لهم الدنيا فساسوا بلادها % % بعدل أضاء الملك في سالف الحقب % % 10(@)(@@) % فكانوا طفاح الأرض عزا ومنعة % % خلائف ساسوا بالسيوف وبالكتب % % PageV01P158 11(@)(@@) % لقد ملكوا ملكا بكت أخرياته % % بدمع على المستعصم الشهم منصب % % 12(@)(@@) % تشاغل بالذات عن حوط ملكه % % فدارت على ابن العلقم رحى الشغب % % 13(@)(@@) % أطال هجودا في مضاجع لهوه % % على ترف والدهر يقظان ذو ألب % % 14(@)(@@) % لقد غره أن الخطوب روابض % % ولم يدر أن الليث يربض للوثب % % 15(@)(@@) % فكان كمروان الحمار إذا انقضت % % به دولة مدت يد الفتح للغرب % % 16(@)(@@) % جرت فتنه من شيعة الكرخ جلحت % % نرد هلاكو بالقتال على العقب % % 17(@)(@@) % فقامت لدى ابن العلقم ضغائن % % تحجرن من تحت النياط على القلب % % 18(@)(@@) % فأضمر للمستعصم الغدر وانطوى % % على الحقد مدفوعا إلى الغش والكذب % % 19(@)(@@) % وخادعه في الأمر وهو وزيره % % مواربة إذ كان مستضعف الإرب % % 20(@)(@@) % فأبعد عنه في البلاد جنوده % % وشتتهم من أوب أرض إلى أوب % % PageV01P159 21(@)(@@) % ودس إلى الطاغي هلاكو رسالة % % مغلغلة يدعوه فيها إلى الحرب % % 22(@)(@@) % وقال له إن جئت بغداد غازيا % تملكنها من غير طعن ولا ضرب % % 23(@)(@@) % فثار هلاكو بالمغول تؤمه % % كتائب خضر تضرب السهل بالصعب % % 24(@)(@@) % وقاد جيوشا لم تمر بمخصب % % من الأرض إلا عاد ملتهب الجدب % % 25(@)(@@) % جيوش ترد الهضب في السير صفصفا % % وتعرك في تسيارها الجنب بالجنب % % 26(@)(@@) % فما عتمت حتى بنت بغبارها % % سماء على ارض العراق من الترب % % 27(@)(@@) % ولما أبادت الجيش بغداد هالكا % على رغم فتح الدين 
ms52	 قائده الندب % % 28(@)(@@) % أقامت على أسوار بغداد برهة % % تعض بها عض الثقاف على الكعب % % 29(@)(@@) % فضاق عليها بالحصار خناقها % % وغصت بكرب ياله الله من كرب % % 30(@)(@@) % وقد حم فيها الامن بالرعب فانبرت % % له رخصاء من عيون أولى الرعب % % PageV01P160 31(@)(@@) % هناك دعا المستعصم القوم باكيا % % بدمع على لحييه منهمل سكب % % 32(@)(@@) % فابدى له ابن العلقم تحزنا % طوى تحته كشحا على المكر والخلب % % 33(@)(@@) % وقال له قد ضاق بالخطب ذرعا % % وأنت ترى ما للمغول من الخطب % % 34(@)(@@) % فكم نحن نبقى والعدو محاصر % % نذل ونشقى في الدفاع وفي الذب % % 35(@)(@@) % وماذا عسى تجدي الحصون بأرضنا % % وهم قد أقاموا راصدين على الدرب % % 36(@)(@@) % فدع ' يا أمير المؤمنين ' قتالهم % % على هدنة تبقيك ملتئم الشعب % % 37(@)(@@) % ولسنا ' وإن كانت كبارا قصورنا ' % % 38(@)(@@) % فهادنه وأخرج في رجالك نحوه % % وصاهره واشدد منه أزرك بالقرب % % 39(@)(@@) % وإلا فإن الأمر قد جد جده % % وليس سوى هذا لصدعك من رأب % % 40(@)(@@) % فلما رأى المستعصم الخرق واسعا % وأن ليس للداء الذي حل من طب % % PageV01P161 41(@)(@@) % مشى كارها والموت يعجل خطوه % % يؤم لفيفا من بنين ومن صحب % % 42(@)(@@) % وراح بعقد الصلح يجمع شمله % % 43(@)(@@) % فأمسكه رهنا وقتل صحبه % % هلاكو ولم يسمع لهم قط من عتب % % 44(@)(@@) % وأغرى ببغداد الجنود كما غدا % % بأدماء يغرى كلبه صاحب الكلب % % 45(@)(@@) % فضلت بهم بغداد ثكلى مرنه % % تفجع بين القتل والسبي والنهب % % 46(@)(@@) % % وصبوا عليها بطشهم أيما صب % % 47(@)(@@) % وأمسى بهم قصر الخلافة خاشعا % % مهتكة أستاره خائف السرب % % 48(@)(@@) % وباتت به من واكف الدمع بالبكا % % عيون المها شتراء منزوعة الهدب % % 49(@)(@@) % وراحت سبايا للمغول عقائل % % من اللاء لم تمدد لهن يد الثلب % % 50(@)(@@) % لقد شربوا بالهون أوشال عزها % % وما أسأروا شيئا لعمرك من القعب % % PageV01P162 51(@)(@@) % فقلص ظل كان في الملك وارفا % وأمحل الملك كان مغلولب العشب % % 52(@)(@@) % لقد بات إذ ذاك الخليفة جاثما % % على الخسف مرقوبا بأربعة غلب % % 53(@)(@@) % وخارت قواه بالسعار لمنعه % % 54(@)(@@) % فقال وقد نقت ضفادع بطنه % % إلا كسرة يا قوم اشفى بها سغب % % 55(@)(@@) % فقال 
ms53	 هلاكو عاجلوه بقصعة % % من الذهب إلا بريز واللؤلؤ الرطب % % 56(@)(@@) % وقالوا له كل ما بدا لك إنها % % 57(@)(@@) % ألست لهذا اليوم كنت ادخرتها % % فدونك فانظر هل تنوب عن الحب % % 58(@)(@@) % وكنت بها دون المماليك معجبا % وفاتك أن المقت من ثمر العجب % % 59(@)(@@) % ولو كنت في عز البلاد أهنتها % % وأنزلت منها الجند في منزل خصب % % 60(@)(@@) % لما أكلتك اليوم حربي وإن غدت % % PageV01P163 61(@)(@@) % سأبذلها دون جنودي تزيدهم % % صيالا بها فوق المطهمة القب % % 62(@)(@@) % وسوف وإن لم يبق إلا حديثنا % % تميز ملوك الأرض دأبك من دأبي % % 63(@)(@@) % هنالك والطوسي أفتى بقتله % % قروءة بقتل أدب أفجع الادب % % 64(@)(@@) % أشار هلاكو نحو علج فتله % % فخر صريعا لليدين وللجنب % % 65(@)(@@) % فأدرج في لبد وديس بأرجل % % إلى ان قضى بالرفس ثمة والضرب % % 66(@)(@@) % وقد أثخنت بغداد من بعد قتله % % جروح بوار جاء بالحجج الشهب % % 67(@)(@@) % وما اندملت تلك الجروح وإنما % % ببغداد منها اليوم ندب على ندب % % PageV01P164 البحر : كامل تام 1(@)(@@) % قضت المطامع أن نطيل جدالا % % وأبين إلا باطلا ومحالا % % 2(@)(@@) % في كل يوم للمطامع ثورة % % باسم السياسة تستجيش قتالا % % 3(@)(@@) % ماض من سلسوا البلاد لوانهم % % كانوا على طلب الوفاق عيالا % % 4(@)(@@) % أمن السياسة أن يقتل بعضنا % % بعضا ليدرك غيرنا الآمالا % % 5(@)(@@) % لادر در اولي السياسة انهم % % قتلوا الرجال ويتموا الاطفالا % % 6(@)(@@) % غرسوا المطامع واغتدروا يسقونها % % بدم هريق على الثرى سيالا % % 7(@)(@@) % تثروا الدماء على البطاح شقائقا % % وتوهموها الروضة المحلالا % % 8(@)(@@) % واعلم بأني لا أخاف منيتي % % سبقت ولاترة ولا اذحالا % % 9(@)(@@) % قالوا كرهت الحرب قلت لأنها % % دارت لتغصب الحقوق الالا % % 10(@)(@@) % وأجلت فكري في الحروب فلم أجد % % إن الهوائف لا تزال بمسمع % % PageV01P165 11(@)(@@) % طاشت منافعها الصغار عن الورى % % ورست مآثمها الكبار جبالا % % 12(@)(@@) % ما اجشع الحرب الضروس فانها % % تحسو النفوس وتأكل الاموالا % % 13(@)(@@) % كم سح من رهج الحروب على الربى % % وبل الدماء فزادها امحالا % % 14(@)(@@) % لولا الحروب ومحرقات صواعق % % منها لابقلت الربي ابقالا % % 15(@)(@@) % قبحت بنا الأرض الفضاء وما حوت % % في غير ما زمن الفطحل جمالا % % 16 
ms54	(@)(@@) % أبني السياسة ان سلكتم بالورى % % طرق الرشاد فعلموا الجهالا % % 17(@)(@@) % ان جرت حرب الكمال لامة % % إن الحياة كثيرة أعمالها % % 18(@)(@@) % ان الحيلة كثيرة اعمالها % % فدعوا الانام وحاربوا الاعمالا % % 19(@)(@@) % وتقحموا حرب الحياة فانها % % 20(@)(@@) % واستلئموا زرد الوفاق واشرعوا % % فيها تعاونكم قنا ونصالا % % PageV01P166 21(@)(@@) % وأقنوا لكم بيض المساعي شزبا % % تجري رعالا المنى فرعالا % % 22(@)(@@) % واعلوا على صهواتهن رواكضا % % للمكرمات تسابق الآجالا % % 23(@)(@@) % ودعوا صيالا في الملاحم إن في % % هذي الحياة ملاحما وصيالا % % 24(@)(@@) % أو كلما طمع القوي شراهة % % اكل الضعيف تحيفا واغتالا % % 25(@)(@@) % لا غرو أن يلد الزمان بمره % % كأبي دلامة من بنيه رجالا % % 26(@)(@@) % اذراح يقتل بالعواطف قرنه % % قتلا ادام حياته واطالا % % 27(@)(@@) % اذ جهز ' المنصور ' جيشا قاده % ' روح ' يريد من ' الشراة ' قتالا % % 28(@)(@@) % فمضى وفيه أبو دلامة مكرها % % للحرب أخرج كي يصيب نكالا % % 29(@)(@@) % حتى إذا التقت الجيوش وعبئت % % صفا فصفا يمنة وشمالا % % 30(@)(@@) % برز الكمي من الشراة مجردا % للسيف يطلب من يطيق نزالا % % PageV01P167 31(@)(@@) % فأجال روح في الجنود لحاظه % % والقوم ينتظرون منه مقالا % % 32(@)(@@) % فدعا اليه أبا دلامة قائلا % % يا ليث دونك ذلك الرئبالا % % 33(@)(@@) % فجرى اليه أبا دلامة هازلا % % ثم استقال فلم يكن ليقالا % % 34(@)(@@) % فشكا لروح جوعه فازاده % % بدجاجتين وحثه استعجالا % % 35(@)(@@) % فانصاع من عجل وسمط زاده % % ومضى يخب لقرنه مختالا % % 36(@)(@@) % فأتى وقد شهر الكمي بوجهه % % سيفا يروع غراره الاغوالا % % 37(@)(@@) % فدنا اليه أبو دلامة قائلا % % مهلا فأغمد سيفك القصالا % % 38(@)(@@) % اني اتيت وما اتيت مقاتلا % % من لست أطلب عنده أذحالا % % 39(@)(@@) % فاسمع مقالة من أتاك ولم يكن % فيما يقول مخادعا محتالا % % 40(@)(@@) % واعلم اني لا اخاف منيتي % % جبنا ولا أتهيب الأبطالا % % PageV01P168 41(@)(@@) % لكن ارى سفك الدماء محرما % % وأعيذ رأيك أن تراه حلالا % % 42(@)(@@) % أمن المروءة أن نريق دماءنا % % سفها لمطمع طامع وضلالا % % 43(@)(@@) % هل كنت من قيل اللقاء رأيتني % % يوما وهل مني لقيت نكالا % % 44(@)(@@) % أم هل طرقت خيام قومك جانيا % % أم هل خربت بحيهم آبالا % % 45(@)(@@) % ماذا جرى بيني وبينك قبل ذا % % مما 
ms55	 يجر خصومة وجدالا % % 46(@)(@@) % حتى شهرت علي سيفك تبتغي % % ضربا يقطع مني الأوصالا % % 47(@)(@@) % فاربأ نفسك ان تكون من الاولى % % زحفوا جنونا للوغى وخبالا % % 48(@)(@@) % فرأى الكمي مقالة متعاليا % % حقا وكل حقيقة تتعالى % % 49(@)(@@) % % سيفا أجادته القيون صقالا % % 50(@)(@@) % ولوى العنان من المطهم قائلا % % رح بالامان فلا لقيت وبالا % % PageV01P169 51(@)(@@) % فمشى اليه أبو دلامة مخرجا % % زادا تعلق بالسموط مشالا % % 52(@)(@@) % ودعاه يا بن أولي المكارم راشدا % % اكرم اخاك بة قفة امهالا % % 53(@)(@@) % إني لأرجو أن تكون مؤاكلي % % في ذا الشواء الا تحب إكالا % % 54(@)(@@) % فتدانيا متخالفين واقبلا % % 55(@)(@@) % حتى إذا أكلا شواء أدبرا % % بعد الوداع ووليا الاكفالا % % 56(@)(@@) % رجعا فسار أبو دلامة طافرا % % والمهر يجفل تحته إجفالا % % 57(@)(@@) % حتى اذا وافى الامير وقام عن % % كثب ترجل دونه إجلالا % % 58(@)(@@) % وغدا يقول وكان روح ضاحكا % % إني كفيتك قرني الرئبالا % % 59(@)(@@) % وقتلته بالقول لا بمهندي % % والحرب أحرى أن تكون مقالا % % 60(@)(@@) % وأخذت في الهيجا عليه مواثقا % % ألا يعود ينازل الأبطالا % % PageV01P170 61(@)(@@) % % مني تقول إذا شكوت الحالا % % 62(@)(@@) % لا تيأسن فللزمان تنفس % فارقبه ان يتبدل الابدالا % % 63(@)(@@) % والدهر طاه سوف ينضج أهله % % بالحادثات يزيدها إشعالا % % 64(@)(@@) % ان الدهور وهن امهر سابك % % سترد أضداد الورى أشكالا % % 65(@)(@@) % حتى كأني بالطباع تبدلت % % غير الطباع وزلزلت زلزالا % % 66(@)(@@) % وكأنني بيني الملاحم أصبحوا % % لابي دلامة كلهم امثالا % % PageV01P171 البحر : خفيف تام 1(@)(@@) % قوض الدهر بالخراب عمادي % % ورمتني يداه بالأنكاد % 2(@)(@@) % كم انادي وليس لي من مجيب % % واضياعاه جهرة كم انادى % % 3(@)(@@) % ضعضع الدهر من بنائي اركا % % نا شدادا طالت على الاطواد % % 4(@)(@@) % طالما رفرفت من العلم رايا % % ت فخار مني على بغداد % % 5(@)(@@) % كنت للعلم روضة باكرت از % % هارها الغر بالعهاد الغوادي % % 6(@)(@@) % وجميع الأنام تضرب أكبا % % د المظايا كي تجتني اورادي % % 7(@)(@@) % فالغزالي سله بي وابا إسحاق عما حويت من ارشاد % % اق عما حويت من إرشاد % % 8(@)(@@) % سله إذ في طلابي الإبل النج % ب تحفي مضروبة الأكباد % % 9(@)(@@) % فرمتني صواعق الدهر فانهد % % بنائي وصرت بعض الوهاد % % 10 
ms56	(@)(@@) % فبكتني من السماء دراريها % % ا وكانت تعد من حسادى % % PageV01P172 11(@)(@@) % أهل بغداد ما لأعينكم تغ % مض عني كأنكم في رقاد % % 12(@)(@@) % أهل بغداد هل ترق قلوب % منكم راعها انقضاض عمادي % % 13(@)(@@) % رق حتى قلب الجماد لفقدي % % فلتكونن قلوبكم من جماد % % 14(@)(@@) % أفلا تنجدون مدرسة العلم % % لم وعهدي بكم أولى إنجاد % % 15(@)(@@) % اين ما شيد من نظامي ربعي % % فلقد كان نجعة المرتاد % % 16(@)(@@) % اين تلك العلوم وهي التي كانت % % ربوعي تذيعها في البلاد % % 17(@)(@@) % كيف قضت خيامها زعزع الدهر % % ر وكانت رصينة الأوتاد % % 18(@)(@@) % أقفرت سوحها وقد نعى الع % % لم فلاحت تجر ثوب الحداد % % 19(@)(@@) % وتوارت بالجهل ظلما وكانت % % خافقا فوقها لواء الرشاد % % 20(@)(@@) % ايها الدهر كلما شئت فافعل % % إذ حدا في ركائبي غير حاد % % PageV01P173 21(@)(@@) % ورعاني من راح من ظلمه العدل % % ل فقيدا ميعاده في المعاد % % 22(@)(@@) % فرقوا جمع امة قبلهم كانت % % لعمري وحيدة الاتحاد % % PageV01P174 البحر : وافر تام 1(@)(@@) % لقد سمعوا من الوطن الأنينا لقد سمعوا من الوطن الأنينا % % فضجوا بالبكاء له حنينا % % 2(@)(@@) % وأنبأه بصارمه اليقينا % % جميعا للدفاع مسلحينا % % 3(@)(@@) % وثاروا من مرابضهم أسودا % % بصوت الاتحاد مزمجرينا % % 4(@)(@@) % شباب كالصوارم في مضاء % يرون ، وكالشموس منورينا % % 5(@)(@@) % سلانيك الفتاة حوت ثراء % بهم فقضت عن الوطن الديونا % % 6(@)(@@) % لقد جمعوا الجموع فمن نصارى % % ومن هود هناك ومسلمينا % % 7(@)(@@) % فكانوا الجيش الف من جنود % % مجندة ومن متطوعين % % 8(@)(@@) % وشاهت أوجه المتمردينا % % وما هم فيه متحدين دينا % % 9(@)(@@) % هي الاوطان تجعل في بنيها % % 10(@)(@@) % وتتركهم أولي أنف كبار % يرون حياة ذي ذل جنونا % % PageV01P175 11(@)(@@) % وأن الموت خير من حياة % % يظل المرء فيها مستكينا % % 12(@)(@@) % مشوا والوالدات مشيعات % % 13(@)(@@) % يقلن وهن من فرح بواك % % وهم من حزنهم متبسمونا % % 14(@)(@@) % على الباغين منتصرين سيروا % % وعودوا للديار مضفرينا % % 15(@)(@@) % ولا تبقوا الذين قد استبدوا % % وراموا كيدنا وتخونونا % % 16(@)(@@) % فإن لم تنقذوا الأوطان منهم % % فلستم يا بنين لنا بنينا % % 17(@)(@@) % فقد هاجوا على الدستور شرا % بدار الملك كي يستعبدونا % % 18(@)(@@) % هم الاشرار باسم الدين قاموا % % فعاثوا في 
ms57	 المواطن مفسدينا % % 19(@)(@@) % فما تركوا من الدستور شورى % % ولا أبقوا لنغمته طنينا % % 20(@)(@@) % وكم قد قلن من قول شجى % % PageV01P176 21(@)(@@) % ومذ حان الوداع دنون منهم % % فقبلن الصوارم والجفونا % % 22(@)(@@) % وما أنسى التي برزت وقالت % % وقد لفتوا لرؤيتها العيونا % % 23(@)(@@) % ألا يا راحلين لحرب قوم % % 24(@)(@@) % خذوني للوغى معكم خذوني % % ممرضة لجرحاكم حنونا % % 25(@)(@@) % وان لم تفعلوا فخذوا ردائي % % به سدوا الجروح اذا دمينا % % 26(@)(@@) % ولما جد جدهم استقلوا % % على ظهر القطار مسافرينا % % 27(@)(@@) % فطاروا في مراكبه سراعا % % باجنحة البخار مرفرفينا % % 28(@)(@@) % وظل الجيش صبحا أو مساء % % تسير جموعه متتابعينا % % 29(@)(@@) % فلم يتصرم الأسبوع إلا % % وهم بربا فروق مخيمونا % % 30(@)(@@) % هنالك قمت مرتحلا اليهم % % لأبصر ما أؤمل أن يكونا % % PageV01P177 31(@)(@@) % % تكاد به تظن الماء طينا % % 32(@)(@@) % ركبت بها على اسم الله بحرا % % غدا بسكون لجته رهينا % % 33(@)(@@) % % يعز على الطبيعة ان يهونا % % 34(@)(@@) % ومرأى البحر أحسن كل شيء % اذا لبست غواربه سفينا % % 35(@)(@@) % اتينا دار قسطنطين صبحا % % وقد فتحت لهم فتحا مبينا % % 36(@)(@@) % وظل الجيش جيش الله يشفي % % بحد سيوفه الداء الدفينا % % 37(@)(@@) % فأزهق أنفس الطاغين حتى % % سقاهم من عدالته المنونا % % 38(@)(@@) % % احلهم المقابر والسجونا % % 39(@)(@@) % وحطوا قصر يلدز عن سماء % % له فانحط أسفل سافلينا % % 40(@)(@@) % واصبح خاشع البنيان يغضي % % عيونا عن تطاوله عمينا % % PageV01P178 41(@)(@@) % خلا من ساكنيه وحارسيه % % 42(@)(@@) % هوى عبد الحميد به هويا % % إلى درك الملوك الظالمينا % % 43(@)(@@) % وانزل عن سرير الملك خلعا % % وأفرد لا نديم ولا قرينا % % 44(@)(@@) % فسيق إلى سلانيك احتباسا % % له كي يستريح بها مصونا % % 45(@)(@@) % ولكن كيف راحة مستبد % % غدا بديار اسرار احرار سجينا % % 46(@)(@@) % يراهم حول مسكنه سياجا % % ويعجز ان ينيم لها عيونا % % 47(@)(@@) % وموت المرء خير من مقام % % له بين الذين سقوه هونا % % 48(@)(@@) % لقد نقض اليمين وخان فيها % % 49(@)(@@) % وقد كانت به البلدان تشقى % % شقاء من تجبره مهينا % % 50(@)(@@) % فكم اذكى بها نيران ظلم % % وكم من اهلها قتل المئينا % % PageV01P179 51(@)(@@) % وكان يدير من سفه رحاها % % بجعجعة ولم يرها طحينا % % 52(@)(@@) % وقد كانت 
ms58	 به الايام تمضي % % شهورا والشهور مضت سنينا % % 53(@)(@@) % ولما ضاق صدر الملك يأسا % % وصار يردد الوطن الانينا % % 54(@)(@@) % اتى الجيش الجليل له مغيثا % % فصدق من بني الوطن الظنونا % % 55(@)(@@) % واضحى سيف قائده المفدى % % على الدستور محتفظا أمينا % % 56(@)(@@) % حماه من العداة فكان منه % % مكان الليث اذ يحمي العرين % % 57(@)(@@) % واسقط ذلك الجبار قهرا % % 58(@)(@@) % فقرت اعين الدستور امنا % % وشاهدت اوجه المتمردينا % % PageV01P180 البحر : خفيف تام 1(@)(@@) % لمن القصر لا يجيب سؤآلي % % آهلات ربوعه أم خوالي ؟ % 2(@)(@@) % مشمخر البناء حيث ترآءى % % باليا مجده بلح الاطلال % % 3(@)(@@) % لم تصبه زلزال الأرض لكن % % قد رمته السماء بالزلزال % % 4(@)(@@) % وكسته الأيام بالصمت لما % % نطقت فيه حادثات الليالي % % 5(@)(@@) % فتراءت ابكاره شاحبات % % باكيات بأعين الآصال % % 6(@)(@@) % ايها القصر ايه بعض جواب % % لا تكن ساكتا على تسآلي % % 7(@)(@@) % ليت شعري والصمت فيك عميق % % ذاكر انت عهدهم أم سال % % 8(@)(@@) % ما تداعى منك البناء ولكن % % قد تداعى بناء تلك المعالي % % 9(@)(@@) % كنت كل البلاد في الطول والعرض % % وكل العباد في الاعمال % % 10(@)(@@) % كنت مأوى العلى مثار الدنايا % % مهبط العز ، مصدر الإذلال % % PageV01P181 11(@)(@@) % كنت جبا وأي جب عميق % % بالعا للنفوس والاموال % % 12(@)(@@) % موردا الخائنين كنت وكانت % % منك تدلي مطامع العمال % % 13(@)(@@) % قصر عبد الحميد أنت ولكن % % اين يا قصر اين عرش الجلال % % 14(@)(@@) % اين خاقانك الذي كان يدعى % % قاسم الرزق ، باعث الآجال % % 15(@)(@@) % ما ارى اليوم ذلك المجد الا % % كخيال تمر بعد خيال % % 16(@)(@@) % هل وقوفي على مبانيك إلا % % كوقوفي على الطلول البوالي % % 17(@)(@@) % قد تخونتنا ثلاثين عاما % جئت فيها لنا بكل محال % % 18(@)(@@) % تلك اعوام رفعة للاداني % % تلك الاعوام حطت للاعالي % % 20(@)(@@) % يثب العدل طافرا كلما م % % ر عليها مشمر الأذيال % % 21(@)(@@) % ملأت خطة الزمان شنارا % % فأبتها كل العصور الخوالي % % PageV01P182 22(@)(@@) % وكأني أرى اضطراب نفوس % % كنت تغتالها وأي اغتيال % % 23(@)(@@) % أسمع الآن فيك ما كان يعلو % % من أنين لها ومن إعوال % % 26(@)(@@) % وترقت إلى ذؤابة اعلى % % كوكب في سمائه جوال % % 27(@)(@@) % وهي اليوم أحرقتك بشهب % % قذفتها عليك ذات 
ms59	 اشتعال % % 28(@)(@@) % لم يضع مجدها وان هي امست % % ضائعات الاشلاء والاوصال % % 29(@)(@@) % كيف ننسى تلك الخطوب اللواتي % % لقحت منك حربها عن حيال % % 30(@)(@@) % يوم كنا وكان للجهل حكم % % خاذل كل عالم مفضال % % 31(@)(@@) % آمر من عتوه كل امر % % يغرس البغض في قلوب الرجال % % 32(@)(@@) % أفأصبحت نادما أيها القص % % ر تبالي بالقوم أم لا تبالي ؟ % 33(@)(@@) % لم تفدك الندامة اليوم شيئا % قضى الامر فاصطبر باحتمال % % PageV01P183 34(@)(@@) % وعزاء فلست أول قصر % % نكس الدهر من ذراه العوالي % % 35(@)(@@) % قد تداعى من قبل إيوان كسرى % % بعد ان طال شاهقات الجبال % % 36(@)(@@) % وكأين من قصر ملك ترامى % % ساقطا بالملوك والاقيال % % 37(@)(@@) % ولسنا ' وإن كانت كبارا قصورنا ' % % 37(@)(@@) % فابق يا قصر عابس الوجه كيما % % يصبح الملك باسم الآمال % % 38(@)(@@) % وتعثر فلا لعا لك حتى % % ينهض العدل ناشطا من عقال % % 39(@)(@@) % إنما نحن أمة تدرأ الضي % % م وتأبى أن تستكين لوالي % % 40(@)(@@) % امة سادت الانام وطابت % % عنصرا من أواخر وأوالي % % 41(@)(@@) % فإذا ما غلا الغشوم نهضنا % % فقذفناه سافلا من عال % % 42(@)(@@) % نملأ الأرض ان مشينا لحرب % % بزئير الغضنفر الرئبال % % PageV01P184 43(@)(@@) % واذا ما غل المليك رددناه % % ذليلا يقال بالاغلال % % 44(@)(@@) % نحن من شعلة الجحيم خلقنا % % لأولى الجور لا من الصلصال % % 45(@)(@@) % يا ملوك الانام هلا اعتبرتم % % حائمات على الذي فيك أبقي % % 46(@)(@@) % ليس عبد الحميد فردا ولكن % % كم لعبد الحميد من أمثال % % 47(@)(@@) % فاتركوا الناس مطلقين والا % % عشتم موثقين بالاوجال % % 48(@)(@@) % هل جنيتم من التجبر الا % % كل اثم عليكم ووبال % % 51(@)(@@) % فمشى اليه أبو دلامة مخرجا % % زادا تعلق بالسموط مشالا % % PageV01P185 البحر : بسيط تام 1(@)(@@) % إذا انقضى مارت فاكسر خلفه الكوزا % % واحفل بتموز ان ادركت تموزا % % 2(@)(@@) % اكرم بتموز شهرا ان عاشره % % قد كان للشرق تكريما وتعزيزا % % 3(@)(@@) % شهر به الناس قد اضحت محررة % % من رق من كان يقفوا اثر جنكيزا % % 4(@)(@@) % سل اهل باريز عن تموز تلق لهم % % يوما به كان مشهودا لباريزا % % 5(@)(@@) % كانت لهم فيه لما ثار ثائرهم % % بسالة هدت البستيل مبزوزا % % 6(@)(@@) % وان تموز شهر 
ms60	 قام فيه لنا % % على اليفاع لواء العز مركوزا % % 7(@)(@@) % في شهر تموز صادفنا لما وعدت % % بيض الصوارم بالدستور تنجيزا % % 8(@)(@@) % هي المساواة عمتنا فما تركت % % فضلا لبعض على بعض تمييزا % % 9(@)(@@) % أمست لنا قسمة بالملك عادلة % % حكما وكانت علاتها ضيزى % % 10(@)(@@) % كنا من الجور عميانا وليس لنا % % من قائدين ولم نملك عكاكيزا % % PageV01P186 11(@)(@@) % حتى نهضنا إلى العلياء تقدمنا % % عصابة برزت في المجد تبريزا % % 12(@)(@@) % ان تلقهم تلق منهم في الوغى جبلا % % أو هجتهم للمنايا هجت راموزا % % 13(@)(@@) % قوم إذا طعموا في حومة تخذوا % % قصاعهم من قحوف القوم لا الشيزى % % 14(@)(@@) % قمنا على الملك الجبار نقرعه % % بالسيف منصلتا والرمح مهزوزا % % 15(@)(@@) % حتى تركناه في هيجاء معضلة % % ألقت ضراما على الطاغين مأزوزا % % 16(@)(@@) % إنا لنأبى على الطاغي تهضمنا % % حتى نهوز في الهيجاء تهويزا % % 17(@)(@@) % ونأكل الموت دون العز نمضغه % % كمضغنا التمر برنيا وسهريزا % % 18(@)(@@) % لا عاش من لا يخوض الموت مرتضيا % % بقاءه بعصي الذل موكوزا % % 19(@)(@@) % راعت سلانيك دار الملك فانتبهت % % من ذاك طهران تخشى امر تبريزا % % 20(@)(@@) % حتى غدت وهي في تمور ناكسة % % رايات شاه رماه الخلع مجنوزا % % PageV01P187 21(@)(@@) % فالشاه في شهر تموز هوى وكذا % % عبد الحميد هوى في شهر تموزا % % 22(@)(@@) % يا شهر تموز لا راعتك رائعة % % ولالقيت من الاحداث ارزيزا % % 23(@)(@@) % يا شهر تموز قد زينت رايتنا % % بالعدل توشية فيها وتطريزا % % 24(@)(@@) % من لي بانجم هذا الافق انظمها % % قصائدا فيك مدحا أو أراجيزا % % 25(@)(@@) % أو انحت الماس اقلاما معرضة % % امدها ذهبا في الطرس ابريزا % % 26(@)(@@) % واجعل الجو في تموز امدحه % % طرسا أجادته كف النور ترزيزا % % PageV01P188 البحر : بسيط تام 1(@)(@@) % يا شرق بشراك ابدى شمسك الفلك % % وزال عنك وعن آفاقك الحلك % % 2(@)(@@) % أضحى بك القوم أحرارا قد اعتصموا % % من النجاة بحبل ليس ينبتك % % 4(@)(@@) % ناد به القول عن أهليه مستمع % % والحق متبع ، والأمر مشترك % % 5(@)(@@) % ناد اذا نفرت عنا الامور به % % إن لم يتم له من شأوه الدرك % % 6(@)(@@) % يصطاد فيه شرود الحق عن كثب % % كالماء يصطاد في ضحضاحه السمك 