ms1201	 الحسناء روى عنه أبو قتيبة وأهل البصرة يخطىء(@)(@@)(@@)(@@) $ 10275 - فرقد أبو واصل يروي عن أبي صادق روى عنه عبد الرحمن بن مغراء الدوسي(@)(@@)(@@)(@@) $ 10276 - فرقد أبو الربيع يروي عن سعيد بن جبير روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 10277 - فتح الموصلي أبو محمد من عباد أهل الجزيرة ومتقنيهم ليس له حديث يرجع إليه روى عنه عفيف بن سالم والمواصلة(@)(@@)(@@)(@@) $ 10278 - فراس بن يحيى الهمداني الخارفي المكتب من أهل الكوفة PageV07P322 يروي عن الشعبي وعطية روى عنه الثوري وشعبة مات سنة تسع وعشرين ومائة(@)(@@)(@@)(@@) $ 10279 - فطر بن خليفة الخياط من أهل الكوفة كنيته أبو بكر يروي عن أبي الزبير روى عنه يحيى القطان والكوفيون مات سنة ثلاث وخمسين ومائة وقد قيل إنه سمع أبا الطفيل فإن صح ذلك فهو من التابعين(@)(@@)(@@)(@@) $ 10280 - فائد بن كيسان الجزار أبو العوام بصري مولى باهلة يروي عن أبي عثمان النهدي روى عنه حماد بن سلمة(@)(@@)(@@)(@@) $ 10281 - فائد مولى عبيد الله بن علي بن أبي رافع يروي عن عبيد الله بن أبي رافع روى عنه الفضل بن سليمان حدثنا أبو يعلى قال ثنا المقدمي قال ثنا الفضيل بن سليمان قال ثنا فائد مولى عبيد الله بن علي بن أبي رافع عن عبيد الله أن سلمى جدته أخبرته أن رسول الله صلى الله عليه وسلم بعث أبا رافع إلى بني أمية بن زيد بن نفيل الكلابي PageV07P323(@)(@@)(@@)(@@) $ 10282 - فليح بن سليمان الخزاعي الأسلمي كنيته أبو يحيى من أهل المدينة يروي عن الزهري والمدنيين روى عنه بن المبارك وابن وهب مات سنة ثمان وستين ومائة وهو فليح بن سليمان بن أبي المغيرة بن حنين وأبو المغيرة أخو عبيد بن حنين مولى آل زيد بن الخطاب(@)(@@)(@@)(@@) $ 10283 - فليح الشماس يروي عن عبيد بن أبي عبيد روى عنه عيسى بن شعيب(@)(@@)(@@)(@@) $ 10284 - فرج بن يحمد الكلاعي من أهل الشام يروي عن أبي حمزة القاص روى عنه صفوان بن عمرو السكسكي(@)(@@)(@@)(@@) $ 10285 - فرج بن سعيد بن علقمة بن أبيض بن حمال السبأى من أهل اليمن 
ms1202	 يروي عن عمه ثابت بن علقمة روى عنه الحميدي عبد الله بن الزبير PageV07P324(@)(@@)(@@)(@@) $ 10286 - فافاه شيخ يروي عن الأعمش روى عنه أبو قرة حدثنا المفضل بن محمد الجندي بمكة قال ثنا علي بن زياد اللحجي قال ثنا أبو قرة عن بن جريج عن فافاه عن الأعمش عن شقيق عن بن مسعود قال قال رسول الله صلى الله عليه وسلم من حلف على يمين صبر ليقتطع بها مال امرئ مسلم لقي الله وهو عليه غضبان(@)(@@)(@@)(@@) $ 10287 - الفرزدق بن جواس يروي عن عكرمة روى عنه أهل مرو حدثنا محمد بن إسحاق الثقفي قال ثنا زياد بن أيوب ثنا أبو تميلة عن صحار بن عامر بن عوف قال ثنا الفرزدق بن جواس قال قدم علينا عكرمة ونحن مع شهر بن حوشب بجرجان فقلنا لشهر ألا نأتيه فقال ائتوه فإنه لم تكن أمة إلا وقد كان لها حبر وإن مولى هذا كان حبر هذه الأمة(@)(@@)(@@)(@@) $ 10288 - فرج بن يزيد يروي عن يزيد بن أبي مالك روى عنه الشاميون المقاطيع PageV07P325(@)(@@)(@@)(@@) $ 10289 - فياض بن غزوان يروي عن طلحة بن مصرف وزبيد اليامي وقد سمع طلحة من أنس روى عنه الكوفيون(@)(@@)(@@)(@@) $ 10290 - فزع شهد القادسية يروي عن المقنع وقد قيل إن للمقنع صحبة ولست أعرف فزعا ولا مقنعا ولا أعرف بلدهما ولا أعرف لهما أبا وإنما ذكرتهما للمعرفة لا للاعتماد على ما يرويانه(@)(@@)(@@)(@@) || (باب القاف)(@)(@@) قال أبو حاتم رضي الله عنه ومن أتباع التابعين الذين رووا عن التابعين ممن ابتدأ اسمه على القاف(@)(@@)(@@)(@@) $ 10291 - قيس بن مسلم الجدلي من قيس غيلان من أهل الكوفة يروي عن سعيد بن جبير والكوفيين روى عنه الثوري وشعبة مات سنة عشرين ومائة(@)(@@)(@@)(@@) $ 10292 - قيس بن الحارث المدحجي الحمصي يروي عن الصنابحي روى PageV07P326 عنه أبو عبيد حاجب سليمان بن عبد الملك(@)(@@)(@@)(@@) $ 10293 - قيس بن عبد الرحمن بن أبي صعصعه من أهل المدينة يروي عن المدنيين وكان راويا لسعد بن إبراهيم روى عنه موسى بن عبيدة الربذي وهم أخوة ثلاثة عبد الله وعبد 
ms1203	 الرحمن وقيس بنوا عبد الرحمن بن أبي صعصعة(@)(@@)(@@)(@@) $ 10294 - قيس بن يزيد بن سلمة بن قيس الضمري يروى عن مولاته سدرة عن أبي ذر روى عنه موسى الجهني(@)(@@)(@@)(@@) $ 10295 - قيس بن عبد الله الهمداني يروي عن أبي إدريس الخولاني روى عنه محمد بن ربيعة(@)(@@)(@@)(@@) $ 10296 - قيس بن دينار أبو ثابت والد حبيب بن أبي ثابت من أهل الكوفة يروي المراسيل روى عنه ابنه حبيب بن أبي ثابت(@)(@@)(@@)(@@) $ 10297 - قيس بن حازم يروي عن علي بن الحسين روى عنه عمرو بن ثابت(@)(@@)(@@)(@@) $ 10298 - قيس بن عبد الله بن الحارث بن قيس يروي المقاطيع روى PageV07P327 عنه المغيرة بن مقسم(@)(@@)(@@)(@@) $ 10299 - قيس بن سعد المكي الحبشي مولى أم علقمة كنيته أبو عبد الله يروي عن عطاء ومجاهد روى عنه حماد بن سلمة وسيف بن سليمان مات سنة سبع عشرة ومائة وقد قيل سنة تسع عشرة ومائة وكان يخلف عطاء بن أبي رباح في مجلسه وكان يتفقه بقوله ويفتي به(@)(@@)(@@)(@@) $ 10300 - قيس بن أبي مسلم من أهل الكوفة يروي عن ربعي بن حراش روى عنه موسى الصغير والأجلح وهو الذي يقال له قيس بن رمانة وكان اسم أبي مسلم رمانة(@)(@@)(@@)(@@) $ 10301 - قيس بن مسعود بن الحكم الزرقي يروي عن أبيه عن علي أن النبي صلى الله عليه وسلم جلس بعد ما كان يقوم للجنازة روى عنه موسى بن عقبة هكذا قاله بن جريج وقال بن المبارك عن موسى بن عقبة عن إسماعيل بن مسعود بن الحكم عن أبيه(@)(@@)(@@)(@@) $ 10302 - قيس بن يسير بن عمرو الشيباني من أهل الكوفة أخو الزبرقان بن يسير يروي عن يسير بن عمرو روى عنه ابنه عمرو PageV07P328 بن قيس الشيباني(@)(@@)(@@)(@@) $ 10303 - قيس أبو حبيب مولى قيس بن سعد يروي المقاطيع روى عنه ابنه يزيد بن قيس(@)(@@)(@@)(@@) $ 10304 - قيس بن سالم يروي عن أبي حزرة وأبي أمامة بن سهل بن حنيف روى عنه الليث بن سعد(@)(@@)(@@)(@@) $ 10305 - قيس بن الحجاج الحميري من أهل مصر يروي عن حنش روى عنه المصريون(@)(@@)(@@)(@@) $ 10306 
ms1204	 - قيس بن مرثد يروي عن عطاء بن أبي رباح روى عنه يزيد بن سنان أبو فروة الجزري يعتبر بحديثه من غير رواية أبي فروة عنه(@)(@@)(@@)(@@) $ 10307 - قيس بن عبد الملك بن قيس بن مخرمة القرشي يروي عن عبد الله بن عوسجة روى عنه فليح بن سليمان PageV07P329(@)(@@)(@@)(@@) $ 10308 - قيس بن رباح الحداني يروي عن مليكة بنت هانئ بن أبي صفرة روى عنه ابنه نوح بن قيس وهو الطاحي(@)(@@)(@@)(@@) $ 10309 - قيس بن بشر التغلبي من أهل قنسرين يروي عن أبيه روى عنه هشام بن سعد(@)(@@)(@@)(@@) $ 10310 - قيس بن الأحنف النخعي يروي المقاطيع روى عنه يزيد بن أبي زياد(@)(@@)(@@)(@@) $ 10311 - قيس بن سليم العنبري التميمي من أهل الكوفة يروي عن أصحاب علي وابن مسعود روى عنه عبد الله بن المبارك ما رفع قيس رأسه إلى السماء سنين كثيرة تعظيما لله عز وجل(@)(@@)(@@)(@@) $ 10312 - القاسم بن أبي بزة كنيته أبو عاصم وقد قيل أبو عبد الله من أهل مكة واسم أبي بزة يسار وقد قيل نافع يروى عن PageV07P330 سعيد بن جبير ومجاهد روى عنه عمرو بن دينار وعبد الملك بن أبي سليمان مات سنة أربع عشرة أو خمس عشرة ومائة وكان يسار جده من فارس أسلم على يد السائب بن صيفى وقد قيل إنه مات سنة خمس وعشرين ومائة والأول أصح لم يسمع التفسير من مجاهد أحد غير القاسم بن أبي بزة وأخذ الحكم وليث بن أبي سليم وابن أبي نجيح وابن جريج وابن عيينة من كتابه ولم يسمعوا من مجاهد(@)(@@)(@@)(@@) $ 10313 - القاسم بن محمد بن عبد الرحمن بن الحارث بن هشام يروي عن أبي بكر بن عبد الرحمن بن الحارث بن هشام عن أبي سلمة وعن عبيد الله بن عبد الله عن بن مسعود روى عنه حبيب بن أبي ثابت(@)(@@)(@@)(@@) $ 10314 - القاسم بن حميد بن عبد الرحمن بن عوف المدني يروي عن أبيه عن جده قال قالوا يا رسول الله أوصنا فقال أوصيكم بالمهاجرين الأولين وبأبنائهم من بعدهم رواه عتيق بن يعقوب الزبيدي 
ms1205	 عن حميد بن القاسم عن أبيه وهو أخو عبد الرحمن بن حميد بن عبد الرحمن بن عوف PageV07P331(@)(@@)(@@)(@@) $ 10315 - القاسم بن مخيمرة الهمداني كنيته أبو عروة يروي عن شريح بن هانئ والكوفيين وما أحسبه سمع أبا موسى روى عنه الحكم بن عيينة وأهل العراق وكان من خيار الناس مات في خلافة عمر بن عبد العزيز حدثنا محمد بن المنذر بن سعيد قال ثنا أبو زرعة قال ثنا أبو مسهر قال ثنا سعيد بن عبد العزيز قال قال القاسم بن مخيمرة ما اجتمع على مائدتي لونان من طعام واحد ولا أغلقت بابي ولي خلفه درهم قال أبو حاتم رضي الله عنه كان القاسم بن مخيمرة من صالحي أهل الكوفة ثم انتقل منها إلى الشام وسكنها مرابطا ومات سنة مائة وليس يصح له عندي عن أبي موسى سماع ولذلك أدخلناه في هذه الطبقة(@)(@@)(@@)(@@) $ 10316 - القاسم بن عبيد الله بن عبد الله بن عمر بن الخطاب العدوى يروي عن سالم بن عبد الله روى عنه عمر بن محمد ويحيى بن المتوكل PageV07P332(@)(@@)(@@)(@@) $ 10317 - القاسم بن الحكم يروي عن عامر بن ربيعة عن عثمان روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 10318 - القاسم بن أبي القاسم يروي عن قاص الأجناد روى عنه عمر بن السائب(@)(@@)(@@)(@@) $ 10319 - القاسم بن عبد الرحمن بن عبد الله بن مسعود يروي عن أبيه روى عنه أهل الكوفة مات في ولاية خالد بن عبد الله القسري(@)(@@)(@@)(@@) $ 10320 - القاسم بن ربيعة يروي عن عقبة بن أوس عن عبد الله بن عمر روى عنه خالد الحذاء(@)(@@)(@@)(@@) $ 10321 - القاسم بن عاصم يروي عن زهدم الجرمي عن أبي موسى روى عنه أيوب السختياني(@)(@@)(@@)(@@) $ 10322 - القاسم الجعفي من أهل الكوفة يروي عن الشعبي روى عنه الكوفيون(@)(@@)(@@)(@@) $ 10323 - القاسم بن عبد الله المعافري من أهل مصر يروي عن سعيد بن PageV07P333 المسيب روى عنه يحيى بن أيوب المصري(@)(@@)(@@)(@@) $ 10324 - القاسم بن عبد الرحمن يروي عن أبيه عن أبي هريرة روى عنه هنيد بن القاسم(@)(@@)(@@)(@@) $ 10325 - القاسم بن فياض بن عبد الرحمن 
ms1206	 بن جندة يروي عن سعيد بن المسيب عداده في أهل اليمن روى عنه هشام بن يوسف قاضي صنعاء(@)(@@)(@@)(@@) $ 10326 - القاسم بن صفوان مولى بنى قيس بن ثعلبة يروي عن أبي رافع عن أبي هريرة روى عنه شعبة وإسماعيل بن عياش(@)(@@)(@@)(@@) $ 10327 - القاسم بن الوليد الهمداني يروي عن الشعبي روى عنه ابنه الوليد بن القاسم الكوفي وعبيدة بن الأسود مات سنة إحدى وأربعين ومائة(@)(@@)(@@)(@@) $ 10328 - القاسم بن أبي العباس الشاعر واسم أبي العباس السائب بن فروخ من أهل مكة يروي عن أبي جعفر محمد بن علي روى عنه PageV07P334 سعيد بن حسان(@)(@@)(@@)(@@) $ 10329 - القاسم بن مسلم اليشكري يروي عن شهر بن حوشب روى عنه ثابت بن عمارة(@)(@@)(@@)(@@) $ 10330 - القاسم بن مسلم مولى على يروي عن أبيه عداده في أهل الكوفة روى عنه هاشم بن البريد(@)(@@)(@@)(@@) $ 10331 - القاسم بن العباس بن محمد بن معتب بن أبي لهب القرشي من أهل المدينة يروي عن الحجازيين روى عنه بن أبي ذئب قتل سنة إحدى وثلاثين ومائة كنيته أبو محمد وأمه أم ولد وقيل إنه مات أيام الحرورية بالمدينة(@)(@@)(@@)(@@) $ 10332 - القاسم بن شريح يروى عن ثعلبة عن أنس روى عنه سفيان الثوري(@)(@@)(@@)(@@) $ 10333 - القاسم بن عبيد الله الأسدي شيخ يروي عن أبي المليح عن واثلة روى عنه خطاب بن عثمان الفوزى يغرب ويخطىء(@)(@@)(@@)(@@) $ 10334 - القاسم بن حسان يروي عن عمه عبد الرحمن بن حرملة عن بن PageV07P335 مسعود روى عنه الركين بن الربيع الفزاري(@)(@@)(@@)(@@) $ 10335 - القاسم بن يحيى بن عطاء بن مقدم يروي عن يحيى بن سعيد الأنصاري وعبيد الله بن عمر روى عنه بن أخيه مقدم بن محمد بن يحيى(@)(@@)(@@)(@@) $ 10336 - القاسم بن سلمان يروي عن الشعبي روى عنه علي بن ثابت(@)(@@)(@@)(@@) $ 10337 - القاسم بن أبي أيوب الأسدي الأعرج من أهل واسط يروي عن سعيد بن جبير روى عنه شعبة والأصبغ بن زيد ومن زعم أنه القاسم بن أيوب فقد وهم(@)(@@)(@@)(@@) $ 10338 - القاسم بن غنام الأنصاري من أهل المدينة يروي عن جدته عن أم فروة روى 
ms1207	 عنه الضحاك بن عثمان وعبيد الله بن عمر العمري(@)(@@)(@@)(@@) $ 10339 - القاسم بن جبير يروي عن عبد الملك بن عباد بن جعفر المراسيل روى عنه الكوفيون PageV07P336(@)(@@)(@@)(@@) $ 10340 - القاسم بن عمرو العبدي يروي عن أبي جعفر محمد بن علي وأبي قلابة روى عنه سلام بن مسكين وقرة بن خالد(@)(@@)(@@)(@@) $ 10341 - القاسم بن كثير بياع السابري كنيته أبو هاشم من أهل الكوفة يروي عن قيس الخارفي عن علي سبق رسول الله صلى الله عليه وسلم وصلى أبو بكر وثلث عمر ثم أصابتنا فتنة روى عنه سفيان الثوري حدثنا عمر بن محمد الهمداني قال ثنا الفضل بن سهل الأعرج قال ثنا أبو نعيم عن سفيان(@)(@@)(@@)(@@) $ 10342 - القاسم بن عبد الواحد بن أيمن المكي مولى أبي عمرو القرشي يروي عن عبد الله بن محمد بن عقيل والحجازيين روى عنه همام بن يحيى وعبد الوارث بن سعيد(@)(@@)(@@)(@@) $ 10343 - القاسم بن حبيب التمار من أهل الكوفة يروي عن سلمة بن كهيل والكوفيين روى عنه وكيع بن الجراح PageV07P337(@)(@@)(@@)(@@) $ 10344 - القاسم بن الفضل بن معدان الحداني من أهل البصرة كنيته أبو المغيرة وكان نازلا بجنب حدان فنسب إليهم يروي عن معاوية بن قرة والبصريين روى عنه مسلم وأهل البصرة مات سنة سبع وستين ومائة حدثنا بن قحطبة قال ثنا أحمد بن سنان القطان قال حدثنا عبد الرحمن بن مهدي وذكر القاسم بن الفضل الحداني قال كان من قدماء أشياخنا ومع ذلك من ثبتهم(@)(@@)(@@)(@@) $ 10345 - القاسم بن محمد بن عبد الله بن محمد بن عقيل بن أبي طالب يروي عن عبد الله بن محمد بن عقيل عن جابر روى عنه إسحاق بن محمد الفروي(@)(@@)(@@)(@@) $ 10346 - القاسم بن الوليد الهمداني من أهل الكوفة يروي عن الأعمش وطلحة بن مصرف روى عنه عبيدة بن الأسود يخطىء ويخالف(@)(@@)(@@)(@@) $ 10347 - القاسم بن الحكم البصري الأنصاري يروى عن أبى PageV07P338 عبادة الزرقي روى عنه محمد بن المثنى الزمن(@)(@@)(@@)(@@) $ 10348 - القاسم بن غصن يروي عن سليمان التيمي روى عنه محمد بن عبد العزيز الرملي وأهل فلسطين(@)(@@)(@@)(@@) $ 10349 
ms1208	 - القاسم بن معن بن عبد الرحمن بن عبد الله بن مسعود الهذلي من أهل الكوفة يروي عن إسماعيل بن أبي خالد روى عنه المعافى بن سليمان الجزري وكان على قضاء الكوفة مات بعد جرير بن عبد الحميد بقليل في خلافة هارون كنيته أبو عبد الله(@)(@@)(@@)(@@) $ 10350 - القاسم بن مالك المزني كنيته أبو جعفر من أهل الكوفة يروي عن أبي خالد والكوفيين روى عنه أهل العراق(@)(@@)(@@)(@@) $ 10351 - قدامة بن أخت سهم بن منجاب يروي عن سهم بن منجاب عن العلاء بن الحضرمي روى عنه الصلت بن مطر PageV07P339(@)(@@)(@@)(@@) $ 10352 - قدامة بن عبد الله بن عبدة العامري كنيته أبو روح يروي عن جسرة بنت دجاجة روى عنه أبو إسحاق الفزاري(@)(@@)(@@)(@@) $ 10353 - قدامة بن إبراهيم بن محمد بن حاطب الجمحي يروي عن عائشة بنت قدامة بن مظعون عن أبيها روى عنه ابنه عبد الملك بن قدامة(@)(@@)(@@)(@@) $ 10354 - قدامة بن زائدة الثقفي والد زائدة بن قدامة من أهل الكوفة يروى عن بن أبي مليكة روى عنه شريك(@)(@@)(@@)(@@) $ 10355 - قدامة بن الهيثم من أهل البصرة يروي عن عطاء بن أبي رباح وعطاء الخراساني روى عنه معلى بن أسد وقتيبة بن سعيد(@)(@@)(@@)(@@) $ 10356 - قدامة بن موسى بن عمر بن قدامة بن مظعون يروي عن أبيه عن قدامة بن مظعون روى عنه يحيى بن سعيد الأنصاري وجعفر PageV07P340 وعثمان مات سنة ثلاث وخمسين ومائة وكان إمام مسجد رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) $ 10357 - قدامة بن حماطة الضبي يروي عن المدنيين وعمر بن عبد العزيز روى عنه الثوري وجرير بن حازم(@)(@@)(@@)(@@) $ 10358 - قتادة بن عبد الله بن أبي قتادة من أهل المدينة يروي عن أبيه روى عنه الحجاج بن أرطأة(@)(@@)(@@)(@@) $ 10359 - قتادة بن سليمان يروي عن الحسن روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 10360 - قتادة بن سوار الجرمي من أهل البصرة أخو أنيس بن سوار يروي عن أبيه عن مالك بن الحويرث روى عنه عبد الله بن أبي الأسود القواريري(@)(@@)(@@)(@@) $ 10361 - قتادة بن الفضيل بن عبد الله بن قتادة الرهاوي 
ms1209	 كنيته أبو حميد يروي عن إبراهيم بن أبي عبلة روى عنه علي بن بحر بن البري وأهل حران مات سنة مائتين وكان يخضب رأسه ولحيته وقد قيل قتادة بن الفضل بن عبد الله PageV07P341(@)(@@)(@@)(@@) $ 10362 - قباث بن رزين اللخمي كنيته أبو هاشم من أهل مصر يروي عن عكرمة روى عنه بن المبارك والمقرئ مات سنة ست وخمسين ومائة(@)(@@)(@@)(@@) $ 10363 - قرة العجلي من أهل الكوفة يروي عن عبد الملك بن قعقاع وابن سابط روى عنه إسماعيل بن أبي خالد يخطئ(@)(@@)(@@)(@@) $ 10364 - قرة بن خالد السدوسي كنيته أبو خالد من أهل البصرة يروي عن الحسن وابن سيرين وعمرو بن دينار روى عنه يحيى بن سعيد القطان وابن مهدي وكان متقنا مات سنة أربع وخمسين ومائة حدثنا إبراهيم بن خريم قال ثنا عبد بن حميد قال ثنا عثمان بن عمر قال ثنا قرة بن خالد السدوسي عن أبي الزبير عن جابر أن النبي صلى الله عليه وسلم دعا بصحيفة عند موته فكتب لهم فيها شيئا لا يضلون ولا يضلون وكان في البيت لغط وتكلم عمر فرفضها(@)(@@)(@@)(@@) $ 10365 - قرة بن عبد الرحمن بن حيوئيل بن ناشرة المعافري أصله من PageV07P342 المدينة سكن مصر يروي عن الزهري روى عنه الأوزاعي وابن وهب ورشدين بن سعد سمعت عمر بن حفص البزار بجنديسابور يقول سمعت إسحاق بن ضيف يقول سمعت أبا مسهر يقول سمعت يزيد بن السمط يقول أعلم الناس بالزهري قرة بن عبد الرحمن بن حيوئيل قال أبو حاتم رضي الله عنه هذا الذي قاله يزيد بن السمط ليس بشيء يحكم به على الإطلاق وكيف يكون قرة بن عبد الرحمن أعلم الناس بالزهري وكل شيء روى عنه لا يكون ستين حديثا بل أتقن الناس في الزهري مالك ومعمر والزبيدي ويونس وعقيل وابن عيينة هؤلاء الستة أهل الحفظ والإتقان والضبط والمذاكرة وبهم يعتبر حديث الزهري إذا خالف بعض أصحاب الزهري بعضا في شيء يرويه وكان إسماعيل بن عياش يقول إن قرة بن عبد الرحمن اسمه يحيى وقرة لقب سمعت 
ms1210	 الفضل بن محمد العطار بأنطاكية يحكيه PageV07P343 عن عبد الوهاب بن الضحاك عنه وهذا شيء يشبه لا شيء لأن عبد الوهاب بن الضحاك واه لم يكن هذا الشأن من صناعته فيرجع إليه فيما يحكيه عنه(@)(@@)(@@)(@@) $ 10366 - قطن بن وهب بن عويمر بن الأجدع الخزاعي يروي عن يحنس مولى الزبير عن بن عمر في فضل المدينة روى عنه مالك بن أنس(@)(@@)(@@)(@@) $ 10367 - قارظ بن شيبة بن قارظ حليف لبني زهرة من أهل المدينة يروى عن بن غطفان عن بن عباس روى عنه بن أبي ذئب(@)(@@)(@@)(@@) $ 10368 - قنان بن عبد الله التميمي من أهل الكوفة يروي عن عبد الرحمن بن عوسجة عن البراء بن عازب روى عنه مروان بن معاوية وقد قيل قنان بن عبد الرحمن(@)(@@)(@@)(@@) $ 10369 - قنان بن عتبة قال سمعت الشعبي يقول لا ينبغي لحامل القرآن PageV07P344 أن ينام عن أقل من مائة آية روى عنه عتاب بن محمد بن شوذب البلخي(@)(@@)(@@)(@@) $ 10370 - قحذم بن أبي قحذم الجرمي من أهل البصرة واسم أبي قحذم النضر بن معبد يروي عن سالم بن عبد الله ومكحول روى عنه قتيبة بن سعيد وعلي بن المديني(@)(@@)(@@)(@@) $ 10371 - قحذم بن سليمان يروي عن معاوية بن قرة عن أبيه عن النبي صلى الله عليه وسلم لتملأن الأرض جورا وظلما روى عنه ابناه هشام ومحبر وهشام هو والد الوليد بن هشام القحذمي الذي حدثنا عنه أبو خليفة ومحبر هو والد داود بن المحبر صاحب كتاب العقل(@)(@@)(@@)(@@) $ 10372 - قصاقص أبو عاصم يروي عن سعيد المقبري مولاه روى عنه حاتم بن عبيد الله لم أر في حديثه ما يوجب أن يعدل به عن الثقات إلى المجروحين حدثني أبو القاسم العباس بن شاذان المقرئ PageV07P345 بالري قال ثنا عبد الرحمن بن عمر رسته قال ثنا حاتم بن عبيد الله قال ثنا أبو عاصم قصاقص قال ثنا سعيد المقبري عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم من أخذ من الطريق بغير حقه طوق به يوم القيامة من سبع أرضين(@)(@@)(@@)(@@) $ 10373 
ms1211	 - قران بن تمام من أهل الكوفة يروي عن جماعة من التابعين روى عنه أهل الكوفة مات في ولاية هارون يخطئ(@)(@@)(@@)(@@) $ 10374 - قيراط أبو العالية يروي عن مجاهد والحسن روى عنه شريك(@)(@@)(@@)(@@) $ 10375 - قطرى الخشاب من أهل الكوفة يروي عن سريع مولى عمرو بن حريث روى عنه جعفر بن عون(@)(@@)(@@)(@@) $ 10376 - قطرى مولى طارق يروي عن رجل عن عبد القيس عن علي روى عنه أبو داود الطيالسي(@)(@@)(@@)(@@) $ 10377 - قريش بن حيان العجلي كنيته أبو بكر أصله من عمان سكن PageV07P346 البصرة يروي عن ثابت البناني وبكر بن وائل روى عنه شعبة بن الحجاج والبصريون وهو الذي روى عنه عثمان بن عمر بن فارس عن العلاء بن عبد الرحمن(@)(@@)(@@)(@@) $ 10378 - قزعة بن يحيى يروي عن أبي الشعثاء روى عنه عمرو بن دينار ومجاهد(@)(@@)(@@)(@@) $ 10379 - قزعة مولى لعبد القيس يروي عن عكرمة روى عنه رزام بن سعد الخراساني(@)(@@)(@@)(@@) $ 10380 - القعقاع بن يزيد الضبي من أهل الكوفة يروي عن الحسن والنخعي روى عنه الثوري وجرير بن عبد الحميد الرازي(@)(@@)(@@)(@@) $ 10381 - القعقاع بن الصلت يروي عن الشعبي روى عنه جرير بن عبد الحميد الرازي(@)(@@)(@@)(@@) $ 10382 - القعقاع بن سعيد الكندي يروي عن أبيه روى عنه رجاء بن حميد(@)(@@)(@@)(@@) $ 10383 - قيظى بن شداد السلمي يروي عن شداد المقاطيع روى عنه ابنه عمرو بن قيظى PageV07P347(@)(@@)(@@)(@@) $ 10384 - قشير بن عمرو يروي عن بجالة عداده في أهل الكوفة روى عنه داود بن أبي هند(@)(@@)(@@)(@@) $ 10385 - قرين بن عمر يروي عن أبي سلمة بن عبد الرحمن وعامر بن سعد روى عنه عبيد الله بن عبد الرحمن بن موهب وابن أبي ذئب(@)(@@)(@@)(@@) $ 10386 - قبيصة بن مروان من أهل البصرة يروي عن أبي عمران الجوني روى عنه حماد بن زيد(@)(@@)(@@)(@@) $ 10387 - قرظة بن أرطأة يروي عن كثير بن شهاب عن عمر بن الخطاب أنه سئل عن الجبن فقال إنما هو من اللبأ واللبن فإذا اشتهيت فكل حدثناه الفضل بن الحباب الجمحي قال ثنا محمد بن كثير قال ثنا سفيان عن أبي إسحاق عن قرظة 
ms1212	 بن أرطاة(@)(@@)(@@)(@@) $ 10388 - قسيم مولى عمارة بن عقبة يروي عن قزعة عن أبي سعيد روى عنه أبان بن صالح(@)(@@)(@@)(@@) $ 10389 - قطبة بن عبد العزيز من أهل الكوفة يروي عن الأعمش PageV07P348 روى عنه يحيى بن آدم وعاصم بن يوسف اليربوعي(@)(@@)(@@)(@@) || (باب الكاف)(@)(@@) قال أبو حاتم رضى الله عنه ومن أتباع التابعين الذين رووا عن التابعين ممن ابتدأ اسمه على الكاف(@)(@@)(@@)(@@) $ 10390 - كثير بن مدرك الأشجعي كنيته أبو مدرك يروي عن الأسود بن يزيد عداده في أهل الكوفة روى عنه أبو مالك الأشجعي(@)(@@)(@@)(@@) $ 10391 - كثير بن معن بن عبد الرحمن بن عوف يروي عن الصنابحي روى عنه صفوان بن سليم(@)(@@)(@@)(@@) $ 10392 - كثير بن كثير بن المطلب بن أبي وداعة السهمي القرشي يروي عن أبيه عن جده روى عنه بن جريج وابن عيينة وقد روى عن بعض أهله عن المطلب(@)(@@)(@@)(@@) $ 10393 - كثير بن حبيش يروي عن عمرة بنت عبد الرحمن روى عنه الأسود بن العلاء بن جارية PageV07P349(@)(@@)(@@)(@@) $ 10394 - كثير بن أبي كثير التيمي كنيته أبو النضر كوفي يروي عن ربعي بن خراش روى عنه أهل الكوفة(@)(@@)(@@)(@@) $ 10395 - كثير بن سعد بن رومان يروي عن أبيه عن بن عمر روى عنه محمد بن مطرف(@)(@@)(@@)(@@) $ 10396 - كثير بن معدان الراسبي من أهل البصرة كنيته أبو محمد يروي عن سالم والقاسم روى عنه جرير بن حازم والبصريون وهو الذي يقال له كثير بن أبي أعين كان اسم أبي أعين معدان وهو الذي يقال له كثير العنبري(@)(@@)(@@)(@@) $ 10397 - كثير بن الحارث يروي عن القاسم أبي عبد الرحمن روى عنه معاوية بن صالح(@)(@@)(@@)(@@) $ 10398 - كثير بن يسار أبو الفضل يروي عن الحسن وثابت روى عنه حماد بن زيد والبصريون PageV07P350(@)(@@)(@@)(@@) $ 10399 - كثير بن سويد الجندي يروي عن عبد الله بن زبيب عداده في أهل اليمن روى عنه معمر(@)(@@)(@@)(@@) $ 10400 - كثير بن اليمان أبو اليمان الرحال يروي عن أم ذرة وشداد بن أبي عمرو روى عنه الدراوردي وعمار أبو هاشم وقد قيل اسم أبي اليمان الرحال كثير بن جريج(@)(@@)(@@)(@@) $ 10401 
ms1213	 - كثير بن سالم يروي عن محمد بن علي بن الحنفية روى عنه علي بن صالح بن حي(@)(@@)(@@)(@@) $ 10402 - كثير بن فرقد من أهل المدينة يروي عن نافع روى عنه مالك بن أنس وهو الذي روى عنه عمرو بن الحارث عن نافع عن بن عمر عن رسول الله صلى الله عليه وسلم قال من حلف على يمين ثم قال إن شاء الله فله ثنياه حدثناه الحسن بن سفيان قال ثنا أحمد بن عيسى قال ثنا بن وهب قال حدثني عمرو بن الحارث عن كثير بن فرقد PageV07P352(@)(@@)(@@)(@@) $ 10403 - كثير بن عبد الرحمن الغطفاني يروي عن سعيد بن المسيب روى عنه بن أبي ذئب حدثنا إبراهيم بن خزيم قال ثنا عبد بن حميد قال ثنا محمد بن عمرو الواقدي قال ثنا بن أبي ذئب قال حدثني كثير بن عبد الرحمن الغطفاني عن محمد بن عبد الرحمن بن ثوبان عن أبي سعيد الخدري قال جاء رجل إلى النبي صلى الله عليه وسلم فقال يا رسول الله أرأيت من لقيني يريد أن يأخذ مالي فقال ناشده الله ثلاث مرات فإن أبى فقاتله فإن قتلك دخلت الجنة وإن قتلته دخل النار(@)(@@)(@@)(@@) $ 10404 - كثير بن أبي المختار أبو يوسف يروي عن أبيه عداده في أهل البصرة روى عنه نوح بن قيس الطاحي(@)(@@)(@@)(@@) $ 10405 - كثير بن عبد الله بن أسلم الرماح كوفي يروي عن نافع عن بن عمر قال قال رسول الله صلى الله عليه وسلم إذا حضر العشاء PageV07P352 وأقيمت الصلاة فابدؤوا بالعشاء روى عنه إسماعيل بن حماد بن أبي سليمان(@)(@@)(@@)(@@) $ 10406 - كثير بن عبد الرحمن العامري يروي عن عطاء روى عنه إسماعيل بن عمر البزار وهو الذي يقال له كثير بن أبي كثير المؤذن(@)(@@)(@@)(@@) $ 10407 - كثير بن زياد البرساني الأزدي من أهل البصرة كنيته أبو سهل يروي عن الحسن وقع إلى بلخ وسمرقند فحدثهم بما وراء النهر فروى عنه البصريون وأهل خراسان وكان ممن يخطئ(@)(@@)(@@)(@@) $ 10408 - كثير بن نباتة أبو العلاء يروى عن بن سيرين سكن اليمن 
ms1214	 روى عنه المعتمر بن سليمان(@)(@@)(@@)(@@) $ 10409 - كثير بن قيس يروي عن سالم بن عبد الله عن أبيه في الجمع بين الصلاتين روى عنه محمد بن سواء ويزيد بن زريع وأهل البصرة(@)(@@)(@@)(@@) $ 10410 - كثير بن قاروند أبو إسماعيل النواء من أهل الكوفة يروى PageV07P353 عن عدى بن ثابت وعطية العوفي روى عنه يوسف بن خالد السمتي والكوفيون(@)(@@)(@@)(@@) $ 10411 - كثير بن زيد مولى الأسلميين من أهل المدينة يروي عن الوليد بن رباح وسالم بن عبد الله روى عنه حماد بن زيد ووكيع بن الجراح كنيته أبو محمد مات سنة ثمان وخمسين ومائة في آخر أيام أبي جعفر(@)(@@)(@@)(@@) $ 10412 - كثير بن عبد الله اليشكري يروي عن الحسن روى عنه مسلم بن إبراهيم(@)(@@)(@@)(@@) $ 10413 - كثير بن جعفر المدني يروي عن زياد وعلاقة ابني عبد الله بن مربع عن سهل بن سعد روى عنه إبراهيم بن المنذر الحزامي(@)(@@)(@@)(@@) $ 10414 - كثير بن حبيب الليثي البصري أبو سعيد يروي عن ثابت روى عنه علي بن المديني والبصريون مات سنة ثمان أو تسع PageV07P354 وسبعين ومائة(@)(@@)(@@)(@@) $ 10415 - كعب بن عبد الرحمن بن كعب بن مالك السلمي الأنصاري من أهل المدينة يروي عن أبيه روى عنه عتاب بن محمد بن شوذب(@)(@@)(@@)(@@) $ 10416 - كعب بن فروخ أبو عبد الله البصري يروي عن حماد بن أبي سليمان روى عنه عبيد الله بن عبد المجيد الحنفي(@)(@@)(@@)(@@) $ 10417 - كعب بن علقمة التنوخي من أهل مصر يروي عن عيسى بن هلال الصدفي وعبد الرحمن بن جبير بن نفير روى عنه سعيد بن أبي أيوب والمصريون(@)(@@)(@@)(@@) $ 10418 - كعب أبو المعلى يروي عن عطاء روى عنه حرمي بن عمارة(@)(@@)(@@)(@@) $ 10419 - كلثوم بن زياد أبو عمرو يروي عن سليمان بن حبيب المحاربي روى عنه الوليد بن مسلم وأهل الشام PageV07P355(@)(@@)(@@)(@@) $ 10420 - كلثوم بن جبر والد ربيعة بن كلثوم كنيته أبو محمد يروى المراسيل روى عنه بن عون مات سنة ثلاثين ومائة(@)(@@)(@@)(@@) $ 10421 - كلثوم بن معاوية يروي عن ثابت البناني روى عنه عكرمة بن عمار(@)(@@)(@@)(@@) $ 10422 - كلثوم بن جوشن يروي عن 
ms1215	 الحسن روى عنه عبد الملك بن بهز بن حكيم وعبيد الله بن عمرو الرقى(@)(@@)(@@)(@@) $ 10423 - كليب بن ذهل يروي عن الحجازيين روى عنه يزيد بن أبي حبيب(@)(@@)(@@)(@@) $ 10424 - كليب بن وائل يروي عن حبيب بن أبى مليكة عن بن عمر روى عنه زائدة بن قدامة(@)(@@)(@@)(@@) $ 10425 - كليب بن صبح يروي عن الزبرقان روى عنه عياش بن عباس(@)(@@)(@@)(@@) $ 10426 - كليب شيخ يروي عن أبي أيوب عن أبي هريرة روى عنه هشام الدستوائي(@)(@@)(@@)(@@) $ 10427 - كلاب بن علي العامري يروي عن سعيد بن جبير روى عنه PageV07P356 عمرو بن ثابت ومنصور بن المعتمر وروايته عن جبير بن مطعم فيها انقطاع لأنه لم يره(@)(@@)(@@)(@@) $ 10428 - كريب بن الحارث بن أبي موسى الأشعري يروي عن أبي بردة روى عنه عاصم الأحول حدثنا أحمد بن علي بن المثنى قال ثنا هدبة بن خالد قال ثنا عبد الواحد بن زياد قال ثنا عاصم الأحول عن كريب بن الحارث بن أبي موسى عن أبي بردة عن أبي موسى أن النبي صلى الله عليه وسلم قال اللهم اجعل فناء أمتي أو قتل أمتي قتلا في سبيلك بالطعن والطاعون(@)(@@)(@@)(@@) $ 10429 - كريب بن يحيى يروي عن الصنابحي روى عنه يحيى بن أبي عمر الشيباني(@)(@@)(@@)(@@) $ 10430 - كريب الكندي يروي عن علي بن الحسين روى عنه الجراح بن الضحاك(@)(@@)(@@)(@@) $ 10431 - كريب بن أبي كريب يروي المقاطيع روى عنه محمد بن إسحاق PageV07P357(@)(@@)(@@)(@@) $ 10432 - كيسان أبو عمر الفزاري يروي عن يزيد بن بلال عن علي روى عنه يحيى بن يعلى الأسلمي(@)(@@)(@@)(@@) $ 10433 - كيسان مولى هشام القردوسى يروى عن بن سيرين روى عنه أبو نعيم(@)(@@)(@@)(@@) $ 10434 - كندير بن سليمان البجلي يروي عن الشعبي روى عنه مروان بن معاوية الفزاري(@)(@@)(@@)(@@) $ 10435 - كهمس بن الحسن النمري من النمر بن قاسط وقد قيل إنه تميمي كنيته أبو الحسن كان نازلا في بني قيس بالبصرة يروي عن عبد الله بن بريدة وعبد الله بن شقيق روى عنه بن المبارك والمقرئ والبصريون مات سنة تسع وأربعين ومائة(@)(@@)(@@)(@@) $ 10436 - كهمس بن الحسن القيسي 
ms1216	 العابد من أهل البصرة يروي الرقائق ما له حديث مسند يرجع إليه روى عنه البصريون الحكايات PageV07P358 هذا كهمس بن الحسن البصري القيسي وذلك كهمس بن الحسن التميمي(@)(@@)(@@)(@@) $ 10437 - كهيل شيخ يروي عن أبيه عن علي روى عنه محمد بن مجاشع(@)(@@)(@@)(@@) $ 10438 - كامل بن عقبة أبو الفضل يروي عن الشعبي روى عنه مروان بن معاوية(@)(@@)(@@)(@@) $ 10439 - كامل بن خليفة العنبري يروي عن أبي ريحان عن بن عمر روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 10440 - كامل بن رجاء بن حيوة الكندي من أهل فلسطين أخو عاصم بن رجاء روى عن أبيه والشاميين يروي عنه أبو مسهر(@)(@@)(@@)(@@) $ 10441 - كريم بن أبي مطر قال رأيت مع عكرمة غلاما حجاما فقال إني اشتريته منذ ثلاثة أيام وقد كسب لي ثلاثة دراهم روى عنه أبو تميلة يحيى بن واضح(@)(@@)(@@)(@@) $ 10442 - كهف القشيري يروي عن ثمامة بن حزن عن عمر روى عنه PageV07P359 ابنه عبد الله بن كهف(@)(@@)(@@)(@@) $ 10443 - كريز بن معقل الباهلي يروي عن هشام بن عقبة عن بن عمر روى عنه عبد الصمد بن عبد الوارث(@)(@@)(@@)(@@) $ 10444 - كهدل بن وقاص بن سريع يروي عن الحسن روى عنه أيوب بن النجار(@)(@@)(@@)(@@) || (باب اللام)(@)(@@) قال أبو حاتم رضي الله عنه ومن أتباع التابعين الذين رووا عن التابعين ممن ابتدأ اسمه على اللام(@)(@@)(@@)(@@) $ 10445 - الليث بن سعد رحمه الله مولى فهم من قيس بن غيلان كنيته أبو الحارث من أهل مصر يروي عن عطاء ونافع والزهري روى عنه بن المبارك والناس وكان مولده يوم الخميس في شهر شعبان سنة أربع وتسعين ومائة ومات في النصف من شعبان سنة خمس وسبعين ومائة وصلى عليه موسى بن عيسى الهاشمي أول رحلته إلى المدينة ومكة سنة ثلاث عشرة ومائة فسمع في تلك السنة PageV07P360 من بن أبي مليكة وعطاء والزهري وأبي الزبير ونافع وكان رحمة الله عليه من سادات أهل زمانه فقها وعلما وورعا وفضلا وسخاء كان لا يختلف إليه أحد إلا وأدخله في جملة عياله ما دام يختلف إليه ثم يزوده 
ms1217	 عند الخروج بالبلغة إلى وطنه(@)(@@)(@@)(@@) $ 10446 - ليث بن المتوكل يروي عن أبي قلابة روى عنه محمد بن عبد الله بن عبيد بن عمير(@)(@@)(@@)(@@) $ 10447 - ليث بن جهم المؤذن من أهل البصرة يروي عن الخزاعي بن زياد روى عنه الفضل بن دكين(@)(@@)(@@)(@@) $ 10448 - لوط بن إسحاق بن المغيرة بن نوفل بن الحارث بن عبد المطلب كنيته أبو المغيرة أمه أم إسحاق بنت سعد بن المغيرة بن نوفل بن الحارث يروي عن جماعة من التابعين روى عنه أهل المدينة مات في ولاية أبي جعفر(@)(@@)(@@)(@@) $ 10449 - لبطة بن الفرزدق المجاشعي التميمي الشاعر يروي عن أبيه عن أبي سعيد الخدري وأبي هريرة روى عنه سفيان بن عيينة والقاسم بن فضل PageV07P361(@)(@@)(@@)(@@) $ 10450 - لقمان الحنفي يروي المقاطيع روى عنه جعفر بن سليمان الضبعي(@)(@@)(@@)(@@) $ 10451 - لهيعة بن عقبة يروي عن عمرو بن ربيعة عن سلامة بن وقش قال سمعت رسول الله صلى الله عليه وسلم يقول من صام يوما ابتغاء وجه الله بعده الله من النار كبعد غراب طار وهو فرح حتى مات هرما رواه بن لهيعة عن زبان بن فائد عن لهيعة بن عقبة ويشبه أن يكون هذا هو سلمة بن سلامة بن وقش أسقط بن لهيعة ذكر سلمة من الإسناد لأنه ليس في أصحاب النبي صلى الله عليه وسلم رجل يقال له سلامة إنما هو سلمة بن سلامة بن وقش بن زعوراء ذكرناه في كتاب الصحابة(@)(@@)(@@)(@@) $ 10452 - لقيط الكوفي يروي عن أبي بردة روى عنه واصل مولى أبي عيينة(@)(@@)(@@)(@@) $ 10453 - لوذان بن سليمان يروي عن هشام بن عروة روى عنه بقية بن الوليد(@)(@@)(@@)(@@) || (باب الميم)(@)(@@) قال أبو حاتم رضى الله عنه ومن أتباع التابعين الذين رووا عن التابعين ممن ابتدأ اسمه على الميم PageV07P362(@)(@@)(@@)(@@) $ 10454 - محمد بن عبد الله بن الحسن بن الحسن بن علي بن أبي طالب الهاشمي كنيته أبو عبد الله يروي عن جماعة من التابعين روى عنه أهل المدينة أمه هند بنت أبي عبيدة بن علي بن ربيعة بن الأسود الأسيدي قتل بالمدينة 
ms1218	 سنة خمس وأربعين ومائة وهو بن خمس وأربعين سنة(@)(@@)(@@)(@@) $ 10455 - محمد بن نافع بن جبير بن مطعم القرشي من أهل المدينة يروي عن كريب مولى بن عباس روى عنه بن إسحاق(@)(@@)(@@)(@@) $ 10456 - محمد بن أبي بكر بن محمد بن عمرو بن حزم الأنصاري المدني أخو عبد الله بن أبي بكر كنيته أبو عبد الملك كان على القضاء بالمدينة يروي عن أبيه روى عنه بن عيينة مات سنة اثنتين وثلاثين ومائة وهو بن اثنتين وسبعين سنة(@)(@@)(@@)(@@) $ 10457 - محمد بن عبد الرحمن بن محمد بن عبد الرحمن بن أسعد بن زرارة PageV07P363 يروي عن عمته عمرة بنت عبد الرحمن وسالم بن عبد الله روى عنه شعبة(@)(@@)(@@)(@@) $ 10458 - محمد بن بلال بن أبي بكر بن عبيد الله بن عبد الله بن عمر بن الخطاب يروي عن المدنيين روى عنه أبو عقيل(@)(@@)(@@)(@@) $ 10459 - محمد بن علي بن يزيد بن ركانة بن عبد يزيد القرشي يروي عن أبيه وعكرمة روى عنه بن جريج وابن إسحاق(@)(@@)(@@)(@@) $ 10460 - محمد بن عبد الله بن محمد بن عبد الرحمن بن أبي بكر الصديق يروي عن أبيه عن عائشة روى عنه بن إسحاق وسليمان بن بلال وهو الذي يقال له بن أبي عتيق وأبو عتيق جده محمد بن عبد الرحمن(@)(@@)(@@)(@@) $ 10461 - محمد بن عكرمة بن عبد الرحمن بن الحارث بن هشام يروي عن جماعة من التابعين روى عنه إبراهيم بن سعد(@)(@@)(@@)(@@) $ 10462 - محمد بن عبد الرحمن بن نوفل بن الأسود بن نوفل بن خويلد بن أسد بن عبد العزى أبو الأسود القرشي الأسدي يتيم عروة بن الزبير PageV07P364 وكان في حجره فنسب إليه يروي عن عروة بن الزبير روى عنه مالك بن أنس وأهل المدينة مات سنة سبع عشرة ومائة(@)(@@)(@@)(@@) $ 10463 - محمد بن المنتشر الهمداني بن أخي مسروق بن الأجدع يروي عن حبيب بن سالم عن النعمان بن بشير روى عنه ابنه إبراهيم بن محمد(@)(@@)(@@)(@@) $ 10464 - محمد بن عبد الله بن عبد الرحمن بن أبي صعصعه المازني الأنصاري من أهل المدينة كنيته 
ms1219	 أبو عبد الرحمن يروي عن أبيه عن أبي سعيد الخدري روى عنه مالك وابن إسحاق واسم أبي صعصعة عمرو بن زيد بن عوف بن مبذول بن غنم بن مازن بن النجار وأم محمد نائلة بنت الحارث بن عبد الله بن كعب بن عمرو بن عوف بن مبذول(@)(@@)(@@)(@@) $ 10465 - محمد بن عبد الله بن عبيد مولى آل طلحة بن عبيد الله القرشي من أهل الكوفة يروي عن عيسى بن طلحة وقد أدرك السائب بن يزيد روى عنه الثوري وشعبة وكان من أعلم الناس بالعربية PageV07P365(@)(@@)(@@)(@@) $ 10466 - محمد بن عبد الرحمن مولى آل طلحة يروي عن عيسى بن طلحة عن أبي هريرة روى عنه مسعر بن كدام وأخاف أن يكون هذا هو الأول(@)(@@)(@@)(@@) $ 10467 - محمد بن واسع الأزدي من أهل البصرة كنيته أبو بكر يروي عن سالم بن عبد الله والحسن روى عنه البصريون مات سنة ثلاث وعشرين ومائة وكان من العباد المتقشفة والزهاد المتجردين للعبادة وكان قد خرج إلى خراسان غازيا وكان في فتح ما وراء النهر مع قتيبة بن مسلم وقد قيل إنه مات سنة سبع وعشرين ومائة وقد قيل إن محمد بن واسع مات سنة ثلاث وعشرين ومائة وقد خرج الخلق في جنازته(@)(@@)(@@)(@@) $ 10468 - محمد بن حي بن يعلى بن أمية الثقفي يروي عن صفوان بن يعلى عن يعلى روى عنه عبد الله بن أمية بن خالد بن أسيد(@)(@@)(@@)(@@) $ 10469 - أبو الرجال اسمه محمد بن عبد الرحمن بن عبد الله بن حارثة بن النعمان الأنصاري يروي عن أمه عمرة بنت عبد الرحمن روى عنه PageV07P366 يحيى بن سعيد الأنصاري والثوري ومالك وإنما قيل له أبو الرجال لأنه كان له عشر بنين رجال فسمى أبا الرجال وكنيته أبو عبد الرحمن وأمه عمرة بنت عبد الرحمن بن سعد بن زرارة(@)(@@)(@@)(@@) $ 10470 - محمد بن طلحة بن عبد الله بن عبد الرحمن بن أبي بكر الصديق يروي عن أبيه عن معاوية بن جاهمة روى عنه بن جريج وعبد الرحمن بن أبي بكر وكان عاملا لعمر 
ms1220	 بن عبد العزيز على مكة(@)(@@)(@@)(@@) $ 10471 - محمد بن عمران بن إبراهيم بن محمد بن طلحة بن عبيد الله كنيته أبو سليمان أمه أسماء بنت سلمة بن عمر بن أبي سلمة بن عبد الأسد يروي عن جماعة من التابعين روى عنه أهل بلده كان على القضاء PageV07P367 بالمدينة لبني أمية ولبني هاشم ومات وهو على القضاء بالمدينة سنة أربع وخمسين ومائة فبلغ أبا جعفر موته فقال اليوم استوت قريش(@)(@@)(@@)(@@) $ 10472 - محمد بن عمرو بن أبي بن كعب الأنصاري من أهل المدينة يروي عن امرأة أبي عن أبي روى عنه شعبة عن محمد بن عبد الرحمن عنه(@)(@@)(@@)(@@) $ 10473 - محمد بن أبي أمامة بن سهل بن حنيف الأنصاري الأوسي من أهل المدينة أخو سهل بن أبي أمامة يروي عن أبيه والحجازيين روى عنه مالك بن أنس(@)(@@)(@@)(@@) $ 10474 - محمد بن عمارة بن عمرو بن حزم الأنصاري من أهل المدينة يروي عن المدنيين ومحمد بن إبراهيم بن الحارث روى عنه أهل الحجاز(@)(@@)(@@)(@@) $ 10475 - محمد بن أسامة بن محمد بن أسامة بن زيد بن الحارثة مولى النبي صلى الله عليه وسلم يروي عن أبيه عن أسامة بن زيد روى عنه محمد بن إسحاق(@)(@@)(@@)(@@) $ 10476 - محمد بن عمرو بن الحارث بن المصطلق الخزاعي الذي يقال له بن الحارث بن أبي ضرار يروي عن أبيه وعمته بنت الحارث PageV07P368 روى عنه خالد بن سلمة(@)(@@)(@@)(@@) $ 10477 - محمد بن إياس بن سلمة بن الأكوع يروي عن أبيه روى عنه عبد الرحمن بن حرملة(@)(@@)(@@)(@@) $ 10478 - محمد بن عبد الرحمن بن أبي لبيبة يروي عن سعيد بن المسيب روى عنه محمد بن عبد الله بن عمرو بن عثمان وهو الذي يقال له محمد بن عبد الرحمن بن لبيبة كان اسم أمه لبيبة وكنية أبيه أبو لبيبة(@)(@@)(@@)(@@) $ 10479 - محمد بن صفوان الجمحي يروي عن سعيد بن المسيب روى عنه مالك والدراوردي(@)(@@)(@@)(@@) $ 10480 - محمد بن أبي عبيد المعافري من أهل مصر يروي عن عطاء بن يسار روى عنه سعيد بن أبي أيوب(@)(@@)(@@)(@@) $ 10481 - محمد بن صهيب 