ms41	 ما لقيت على انتحاب % 14(@)(@@) % أكلم لمحة في الترب منها % % كلام المستجير من العذاب % % 15(@)(@@) % كأني عندها أشكو إليها % % همومي والشكاة إلى التراب % % 16(@)(@@) % سقى الله القباب بتل ' عبدى ' % وبالشرقين أيام القباب % % 17(@)(@@) % وأياما لنا قصرت وطابت % على ( فرعان ) نائمة الكلاب % 18(@)(@@) % لقد شط المزار فبت صبا % % يطالعني الهوى من كل باب % % 19(@)(@@) % وعهدي بالفراع وأم بكر % % ثقال الردف طيبة الرضاب % % PageV01P146 20(@)(@@) % من المتصيدات بكل نبل % تسيل إذا مشت سيل الحباب % % 21(@)(@@) % مصورة يحار الطرف فيها % % كأن حديثها سكر الشراب % % 22(@)(@@) % ليالي لا أعوج على المنادي % % ولا العذال من صعم الشباب % % 23(@)(@@) % وقائلة رأتني لا أبالي % % جنوح العاذلات إلى عتاب : % 24(@)(@@) % مللت عتاب أغيد كل يوم % وشر ما دعاك إلى العتاب % 25(@)(@@) % إذا بعث الجواب عليك حربا % فما لك لا تكف عن الجواب % % 26(@)(@@) % أصون عن اللئام لباب ودي % % وأختص الأكارم باللباب % % 27(@)(@@) % وأي فتى من البوغاء يغني % % مقامي في المخاطب والخطاب % % 28(@)(@@) % وتجمع دعوتي آثار قومي % % هم الأسد الخوادر تحت غاب % % 29(@)(@@) % ولاة العز والشرف المعلى % % يردون الفضول على المصاب % % PageV01P147 30(@)(@@) % نقود كتائبا ونسوق أخرى % % وفعنا فوقهم غر السحاب % 31(@)(@@) % وأبرارا نعود إذا غضبنا % % بأحلام رواجح كالهضاب % % 32(@)(@@) % وإن نسرع بمرحمة لقوم % فلسنا بالسراع إلى العقاب % % 33(@)(@@) % نرشح ظالما ونلم شعثا % ونرضى بالثناء من الثواب % 34(@)(@@) % ترانا حين تختلف العوالي % % وقد لاذ الأذلة بالصعاب % % 35(@)(@@) % نقود كتائبنا ونسوق أخرى % % كأن زهاءهن سواد لاب % % 36(@)(@@) % إذا فزعت بلاد بني معد % حميناها بأغلمة غضاب % % 37(@)(@@) % وكل متوج بالشيب يغدو % % طويل الباع منتجع الجناب % 38(@)(@@) % من المتضمنين شبا المنايا % % يكون مقيله ظل العقاب % PageV01P148 البحر : كامل أحذ 1(@)(@@) % كل امرئ نصب لحاجته % % وعليه يحمل أو له نصبه % 2(@)(@@) % فاربع على خلق له خطر % في الصالحين يفوز محتسبه % 3(@)(@@) % عي الشريف يشين منصبه % وترى الوضيع يزينه أدبه % 4(@)(@@) % وحراثة التقوى لمحترث % كرم المعاد وما له حسبه % 5(@)(@@) % وتنقص المولى مواليه % عار يكون بوجهه ندبه % 6(@)(@@) % وإذا نسيبك غل ساعده % ونأى فليس بنافع نسبه % % 7 
ms42	(@)(@@) % ومن البلاء أخ جنايته % علق بنا ولغيرنا نشبه % 8(@)(@@) % خذ من صديقك غير متعبه % % إن الجواد يؤوده تعبه % % 9(@)(@@) % واستغن بالوجبات عن ذهب % لم يبق قبلك لامرىء ذهبه % 10(@)(@@) % يرد الحريص على متالفه % والليث يبعث حتفه كلبه % PageV01P149 البحر : طويل 1(@)(@@) % ألا ما لقلبي لا يزول عن الهوى % % وقد زعموا أن القلوب تقلب % 2(@)(@@) % أ ( صفراء ) ما لي في المدامة سلوة % فأسلو ولا في الغانيات معقب % 3(@)(@@) % إذا لم تر الذهلي أنوك فالتمس % % له نسبا غير الذي يتنسب % 4(@)(@@) % وأما بنو قيس فإن نبيذهم % كثير ولكن درهم القوم كوكب % 5(@)(@@) % وسيد تيم اللات تحت غذائه % هزبر وأما في اللقاء فثعلب % 6(@)(@@) % وقد كان في ( شيبان ) عز فحلقت % به في قديم الدهر عنقاء مغرب % 7(@)(@@) % وحيا ' لجيم ' قسوران تنزعت % % شباتهما لم يبق ناب ومخلب % 8(@)(@@) % وأنذل من يمشي ' ضبيعة ' إنهم % % زعانف لم يخطب إليهم محجب % 9(@)(@@) % و ' يشكر ' خصيان عليهم غضارة % وهل يدرك المجد الخصي المجبب % % 10(@)(@@) % لقد زاد أشراف العراق ' ابن حاتم ' % كما ساد أهل المشرقين ( المهلب ) % PageV01P150 11(@)(@@) % صفت لي يد الفياض ' روح بن حاتم ' % بملك يد كالماء يصفو ويعذب % 12(@)(@@) % طلوب ومطلاب إليه إذا غدا % % وخير خليليك الطلوب المطلب % PageV01P151 البحر : خفيف تام 1(@)(@@) % يفخر الباهلي أن جعل الل % ه له وحده حرا من وراء % % 2(@)(@@) % ولقد قلت يوم زاف لمسعو % % د وألقى عنه قناع الحياء % % 3(@)(@@) % خبرتني القنفاء عنك بشيء % فاتقي الله في استك البخراء % % 4(@)(@@) % لا تدع زنية ودع زب يحيى % % واسأل أختيك عن لذيذ الزناء % % PageV01P152 البحر : منسرح 1(@)(@@) % لا فجع إلا كما فجعت به % من فارس كان دوننا حدبا % % 2(@)(@@) % يا صفحه عن جواب جاهلنا % % حلما ويا عزه إذا غلبا % % 3(@)(@@) % ويا قراه العدو مرهفة % بيضا ويا لينه إذا صحبا % % 4(@)(@@) % ويا جداه لمن ألم به % % يوما ويا وصله لمن قربا % % 5(@)(@@) % لو نال خلدا من قبله أحد % مدت إلى الخلد كفه سببا % % PageV01P153 البحر : طويل 1(@)(@@) % أجارتنا لا تجرعي وأنيبي % % أتاني من الموت المطل نصيبي % % 2(@)(@@) % بنيي على 
ms43	 قلبي وعيني كأنه % ثوى رهن أحجار وجار قليب % 3(@)(@@) % كأني غريب بعد موت ( محمد % وما الموت فينا بعده بغريب % 4(@)(@@) % صبرت على خير الفتو رزئته % ولولا اتقاء الله طال نحيبي % % 5(@)(@@) % لعمري لقد دافعت موت ' محمد ' % لو ان المنايا ترعوي لطبيب % 6(@)(@@) % وما جزعي من زائل : عم فجعه % ومن ورد آباري وقصد شعيبي % % 7(@)(@@) % فأصبحت أبدي للعيون تجلدا % ويا لك من قلب عليه كئيب % 8(@)(@@) % يذكرني نوح الحمام فراقه % وإرنان أبكار النساء وثيب % 9(@)(@@) % ولي كل يوم عبرة لا أفيضها % % لأحظى بصبر أو بحط ذنوب % PageV01P154 10(@)(@@) % إلى الله أشكو حاجة قد تقادمت % % على حدث في القلب غير مريب % 11(@)(@@) % دعته المنايا فاستجاب لصوتها % % فلله من داع دعا ومجيب % 12(@)(@@) % أظل لأحداث المنون مروعا % كأن فؤادي في جناح طلوب % % 13(@)(@@) % عجبت لإسراع المنية نحوه % وما كان لو مليته بعجيب % 14(@)(@@) % رزئت بنيي حين أروق عوده % وألقى علي الهم كل قريب % 15(@)(@@) % وقد كنت أرجو أن يكون ( محمد % لنا كافيا من فارس وخطيب % 16(@)(@@) % وكان كريحان العروس بقاؤه % ذوى بعد إشراق الغصون وطيب % 17(@)(@@) % أغر طويل الساعدين سميذع % كسيف المحامي هز غير كذوب % 18(@)(@@) % غدا سلف منا وهجر رائح % على أثر الغادين قود جنيب % PageV01P155 19(@)(@@) % وما نحن إلا كالخليط الذي مضى % % فرائس دهر مخطئ ومصيب % % 20(@)(@@) % نؤمل عيشا في حياة ذميمة % أضرت بأبدان لنا وقلوب % 21(@)(@@) % وما خير عيش لا يزال مفجعا % بموت نعيم أو فراق حبيب % % 22(@)(@@) % إذا شئت راعتني مقيما وظاعنا % مصارع شبان لدي وشيب % PageV01P156 البحر : هزج 1(@)(@@) % دعاك الحب بالشعب % من الذلفاء بالقلب % % 2(@)(@@) % نأته ونأى عنها % % وأبدت قالة العجب % 3(@)(@@) % فقد وقفني الهجر % من الموت على جنب % 4(@)(@@) % وقدما ذاك ما زال % % محل اللهو في القرب % 5(@)(@@) % رهينا بالذي لاقي % ت بين الرغب والرهب % 6(@)(@@) % فرهبي منك في شعفي % % ومن موت الهوى رغبي % % 7(@)(@@) % لقد حاربني صبري % % وما سالمني حبي % % 8(@)(@@) % فلا يقربني هذا % % ولا هاذاك من حزبي % % 9(@)(@@) % وما أذنبت من ذنب % سوى حبي فما ذنبي % % 10 
ms44	(@)(@@) % ونوم العين ممنوع % وماء العين في سكب % PageV01P157 11(@)(@@) % ألا لا لا أرى مثلي % % ومثل الشوق في قلبي % % 12(@)(@@) % أدنيها من الجدوى % % وتدنيني من الكرب % % 13(@)(@@) % وقد قلت لها سرا % % وإعلانا لدى صحبي : % 14(@)(@@) % أما حسبك يا أسما % % ء أني منك في حسب % 15(@)(@@) % كفتك الغاية الدنيا % % مع القصوى التي تكبي % % 16(@)(@@) % وفي أسهل ما يأتي % % به كاف من الصعب % 17(@)(@@) % فلما لم أنل حظا % % بما كدرت من شربي % % 18(@)(@@) % شكوت القلب والذلفا % % ء مع وجدي إلى ربي % % 19(@)(@@) % فأصبحت بما حليت % من مشربي العذب % 20(@)(@@) % كذي الطب تعناه % وما بالقلب من طب % PageV01P158 21(@)(@@) % وساهي النفس محزونا % يزجي النفس بالغلب % 22(@)(@@) % ولو يسطيع إذ شطت % % على ما كان من عتب % 23(@)(@@) % حذاها وجهه نعلا % فلم تمش على الترب % 24(@)(@@) % ( أعبادة ) من حب % ك في الأحشاء كاللهب % 25(@)(@@) % إذا استغفيت أضناني % % ضنا المحمول في الخشب % 26(@)(@@) % فإن حدثت يوما عن % فتى مات من الحب % 27(@)(@@) % فقولي تصدقي : ذاكم % صفي من بني كعب % 28(@)(@@) % ليال منك أهواها % % هوى في الجد واللعب % 29(@)(@@) % فمنها ليلة بالتا % % ج أسهت للهوى لبي % % PageV01P159 البحر : بسيط تام 1(@)(@@) % يا صاح لا تجر في لومي وتأنيبي % % ما كل من لم يجب قوما بمغلوب % % 2(@)(@@) % هب لي انتقاصك عرضا غير منتقص % فما متاعك في الدنيا بمرهوب % % 3(@)(@@) % إني وإن كان حلمي واسعا لهم % لا أستهل على جار بشؤبوب % % 4(@)(@@) % طلاب أمر لهول الناس حظوته % على القلوب ركوب غير مسلوب % 5(@)(@@) % كم من بديعة شر قد فتكت بها % % في ليلة مثل لج البحر يعبوب % 6(@)(@@) % منهن ليلة باتت غير نائمة % حرى وحرب أخي الحنان عرقوب % 7(@)(@@) % بات القليفع فيما يبتغي أجلي % % وليس ما ضاف من هجري بتعييب % % 8(@)(@@) % جاءت وجاء السجوجي من بني وأل % والزق يحدو وكاها ساكن اللوب % 9(@)(@@) % يهفون دون أكيراح ومثلهم % طفل الحسام بباب الملك معصوب % 10(@)(@@) % لما التقينا على ملك نساوره % صعب المرام كحر النار مشبوب % PageV01P160 11(@)(@@) % قالت هلكت ولم أهلك فقلت لها % % في مثلها كنت صفاح 
ms45	 الأعاجيب % 12(@)(@@) % حاولتم العرش عندي في سلاسله % هيهات رمتم قريبا غير مقروب % 13(@)(@@) % ضمت قناني على الميراث فيئكم % والسيلان ذو الوجهين يعسوب % 14(@)(@@) % فأصبحت بعد ما عض الثقاف بها % % ريا المفاصل ملساء الأنابيب % 15(@)(@@) % كأنما دهنت دهنا وقد عركت % ليل التمام بتعضيض وتقليب % 16(@)(@@) % كأنني من رقاهم ليلة احتضروا % % مذبذب بين إصعاد وتصويب % 17(@)(@@) % يرمون قلبي بأسحار وأمحقها % % عني بحرف من القرآن مكتوب % 18(@)(@@) % حتى إذا أشرفت نفسي على طمع % فاستعجل الصبح أمثال الأهابيب % % 19(@)(@@) % سحرت ريفا لبفزول فدامجه % % إذ ألفت فيه بين الشاة والذيب % 20(@)(@@) % وقد عطفت مكيحا بعد حيصته % % على الوديق فما وتر بمطلوب % PageV01P161 21(@)(@@) % وقد خنقت مليحا في منازله % حتى استمر طريدا غير مصحوب % 22(@)(@@) % وقد قرعت القرينا إذ قرعت له % بالعنكبوت وكان الحوب بالحوب % 23(@)(@@) % وقد تركت أبا اللصين معترضا % وما اعتراض ذباب طن مذبوب % 24(@)(@@) % يروح الغي يعبوبا له شرف % وفي الرشاد بليدا غير يعبوب % % 25(@)(@@) % وقد عرفت عريفا ناك خالته % وقد تلفع شيبا غير مخضوب % 26(@)(@@) % يصب في فلسها من ماء فيشته % % صب الوليدة في المصحاة بالكوب % 27(@)(@@) % والعبد زوج الزواني قد نفخت له % % مني بسجل ذنوبا غير مشروب % 28(@)(@@) % يمشي بأير مهيب في عشيرته % وما الفتى بمهيب في المقانيب % % 29(@)(@@) % ممن يروعك مطلوبا برؤيته % وقد تراه مصيخا غير مطلوب % PageV01P162 البحر : بسيط تام 1(@)(@@) % يا صاحبي أعيناني على طرب % قد آب ليلي وليت الليل لم يؤب % 2(@)(@@) % نصبت والشوق عناني ونصبني % % إلى ' سليمى ' وراعيهن في نصب % 3(@)(@@) % في القصر ذي الشرفات البيض جارية % ريا الترائب والأرداف والقضب % 4(@)(@@) % الله أصفى لها ودي وصورها % % فضلا على الشمس إذ لاحت من الحجب % 5(@)(@@) % أحب فاها وعينيها وما عهدت % إلي من عجب ويلي من العجب % 6(@)(@@) % داء المحب ولو يشفى بريقتها % % كانت لأدوائه كالنار للحطب % % 7(@)(@@) % وناكث بعد عهد كان قدمه % وكيف ينكث بين الدين والحسب % 8(@)(@@) % والله أنفك أدعوها وأطلبها % % حتى أموت وقد أعذرت في الطلب % 9(@)(@@) % قد قلت لما ثنت عني ببهجتها % % واعتادني الشوق بالوسواس 
ms46	 والوصب % 10(@)(@@) % يا أطيب الناس أردانا وملتزما % مني علي بيوم منك واحتسبي % % PageV01P163 11(@)(@@) % إن المحبين لا يشفي سقامهما % % إلا التلاقي فداوي القلب واقتربي % % 12(@)(@@) % كم قلت لي عجبا ثم التويت به % % ولا لما قلت من راس ولاذنب % 13(@)(@@) % لا تتعبيني فإني من حديثكم % % بعد الصدود الذي حدثت في تعب % % 14(@)(@@) % يدعو إلى الموت طيف لا يؤرقني % % وعارض منك في جدي وفي لعبي % % 15(@)(@@) % فالقي محبا حماه النوم ذكركم % % كأنه يوم لا يلقاك في لهب % % 16(@)(@@) % قالت : أكل فتاة أنت خادعها % % بشعرك الساحر الخلاب للعرب % 17(@)(@@) % كم قد نشبت بغيري ثم زغت بها % % فاستحي من كذب لا خير في الكذب % 18(@)(@@) % هبني لقيت كما تلقى وخامرني % % داء كدائك من جن ومن كلب % 19(@)(@@) % أنى لنا بك أو أنى بنا لكم % % ونحن في قيم غيران في نشب % % 20(@)(@@) % لا نستطيع ولا نسطاع من سرف % فالصفح أمثل من وصل على رقب % % PageV01P164 21(@)(@@) % أنت المشهر في أهلي وفي نفري % % ودونك العين من جار ومغترب % 22(@)(@@) % ولو أطيعك في نفسي معالجة % أنهبت عرضي وما عرضي بمنتهب % 23(@)(@@) % فاحلب لبونك إبساسا وتمرية % لا يقطع الدر إلا عي محتلب % 24(@)(@@) % إنا وإن لم تكن منا مساعفة % بما هويت وكنا عنك في أشب % 25(@)(@@) % نهوى الحديث ونستبقي مناصبنا % % إن الصحيحة لا تبقى مع الجرب % 26(@)(@@) % خافت عيونا فخفت قبل حاجتنا % % وروعتنا بإعراض ولم تصب % % 27(@)(@@) % فليس لي عندها حبل أمت به % إلا المودة من نعمى ولا نشب % 28(@)(@@) % فقد نسيت وقلبي في صبابته % % كأنه عندها حيران في سبب % 29(@)(@@) % قد غبت عنها فما رقت لغيبتنا % % وقد شهدت فلم تشهد ولم تغب % 30(@)(@@) % أمسي حزينا وتمسي في مجاسدها % % لا تشتكي الحب في عظم ولا عصب % PageV01P165 31(@)(@@) % كأنها حجر من بعد نائلها % % شطت علي وإن ناديت لم تجب % PageV01P166 البحر : خفيف تام 1(@)(@@) % آب ليلي بعد السلو بعتب % من حبيب أصاب عيني بسكب % 2(@)(@@) % لقيتني يوم الثلاثاء تمشي % % بالتصابي وبالعناء لقلبي % % 3(@)(@@) % كان لي ( باب مقسم ) باب غي % وافقت صحبه وما 
ms47	 ثاب صحبي % % 4(@)(@@) % ساقطت منطقا إلي رخيما % فسبتني به وقد كنت أسبي % % 5(@)(@@) % لم يوهن من المقال لساني % % لجواب مجيبه غير حرب % % 6(@)(@@) % قلت : هل بعد ذا تلاق فقالت % كيف تلفى صحيحة بين جرب % 7(@)(@@) % ما تولت حتى استدار بي الح % كما دارت الرحا فوق قطب % % 8(@)(@@) % عاد حبي بتلك غضا جديدا % رب ما قد لقيت منهن حسبي % % 9(@)(@@) % صورة الشمس في قناع فتاة % عرضت لي فليس لبي بلب % 10(@)(@@) % لا تكن لي الحياة إن لم تكن لي % % شربة من رضابها غير غصب % % PageV01P167 11(@)(@@) % خلقت وحدها فلست براء % مثلها صاح لا تصابى وتصبي % % 12(@)(@@) % أيها الناصح الرسول إليها % % قل لها عن متيم القلب صب % 13(@)(@@) % حدثيني فأنت قرة عيني % % هل تحبينني فهل نلت حبي % % 14(@)(@@) % أبهمت دونك الفجاج فلا أل % قى سبيلا إليك في غير ترب % 15(@)(@@) % ما على النوم لو تعرضت فيه % % فبلوناك في سخاب وإتب % % 16(@)(@@) % أنا من حبك الضعيف الذي لا % أستطيع السلو عنك بطب % 17(@)(@@) % ولو أن الهوى تزحزح عني % % شيعتني فيا فدا كل حنب % 18(@)(@@) % فاذكريني - ذكرت في ظلة العر % % ش بخير - تفرجي بعض كربي % % 19(@)(@@) % ما دعاني هواك منذ افترقنا % % باشتياق إلا نهضت ألبي % % 20(@)(@@) % أشتهي قربك المؤمل والل % % ه قريبا فهل تشهيت فربي % % PageV01P168 21(@)(@@) % سوف أصفي لك المودة مني % % ثم أعفيك أن تراعي بذنب % 22(@)(@@) % فصليني وصال مثلي ودومي % % لا تكوني ذواقة كل ضرب % % 23(@)(@@) % ليت شعري جددت يوم التقينا % % أم تصدين من لقيت بلعب % % 24(@)(@@) % قد شككنا فيما عهدت إلينا % % وظمئنا فوجهينا لشرب % 25(@)(@@) % ليتني قد حييت حتى أراه % في محب لكم وفوق المحب % 26(@)(@@) % يتغنى إذا خلا باسمك الحق % ويكنيك في العدى ' أم وهب ' % 27(@)(@@) % ويفدي سواك في مجلس القو % م ويعنيك بالتفدي وربي % % PageV01P169 البحر : خفيف تام 1(@)(@@) % حن قلبي إلى غزال ربيب % فاعتراني لذاك كالتصويب % 2(@)(@@) % كيف صبري عن الغزال ولم أل % ق شفاء من الغزال الربيب % 3(@)(@@) % منع النوم ذكره فتأرق % ت لذكرى من شادن مخضوب % 4(@)(@@) % لا تعزى 
ms48	 الفؤاد عنه ولا يق % % صر خطوي إلى مناخ المشيب % 5(@)(@@) % ولقد أسأل ( المغيرة ) لما % % دوي القلب عن دواء القلوب % 6(@)(@@) % فأشارت بها قريبا وما المم % % نوع عندي نواله بقريب % % 7(@)(@@) % فصبرت الفؤاد حتى إذا طا % % ل بي المشتكى وأعيا طبيبي % % 8(@)(@@) % وجفاني الصديق من يأس أن أب % رأ واعتل عائدي من نسيبي % % 9(@)(@@) % جئت مستشفيا إليها لما بي % % وشفاء المحب عند الحبيب % 10(@)(@@) % فاتقي الله يا حبيب وجودي % % بشفاء لعاشق مكروب % % PageV01P170 11(@)(@@) % نام أصحابه وبات مكبا % في أعاجيب من هواك العجيب % % 12(@)(@@) % ليس بالمبتغي سواك ولا البا % % ئع منكم نصيبه بنصيب % 13(@)(@@) % يقطع الدهر ما يغيب عنه % من هواكم بعبرة ونحيب % % 14(@)(@@) % لم تنم عيني ولم يزل الدم % % ع نظاما يستن فوق التريب % % 15(@)(@@) % مستهاما إذا الجلوس أفاضوا % % في حديث أكب مثل الغريب % % 16(@)(@@) % ليس بالناظر الجواب فيرعى % % قول حداثه ولا بالمجيب % % 17(@)(@@) % تنتحي النفس في هواها فيرضى % % من حديث لاجلوس بالمحبوب % % 18(@)(@@) % نوليه واتقي إلهك فيه % % ليس ما قد فعلت بالتعتيب % % 19(@)(@@) % قد أبت نفسه سواك وتأبي % ن سواه بالصرم والتعذيب % % 20(@)(@@) % لو قدرنا على رقى سحر ' هارو % % ت ) طلبنا الوصال بالتحبيب % PageV01P171 البحر : مجزوء الرمل 1(@)(@@) % طال في هند عتابي % % واشتياقي وطلابي % % 2(@)(@@) % واختلافي كل يوم % بمواعيد كذاب % % 3(@)(@@) % كلما جئت لوعد % كان ممسى في تباب % % 4(@)(@@) % أخلفت حين أريدت % مثل إخلاف السراب % % 5(@)(@@) % لامني فيها يزيد % وجفا دون صحابي % % 6(@)(@@) % قلت للائم فيها : % غص منها بالشراب ! % 7(@)(@@) % لا تطاع الدهر فيما % % قد عناني بقراب % % 8(@)(@@) % ليت من لام محبا % % ورماه باعتياب % % 9(@)(@@) % أرهقت هند حياتي % % ما لهند من متاب % % 10(@)(@@) % ناله الله بسقم % شاغل أو بعذاب % % PageV01P172 11(@)(@@) % حبلتني بمناها % % ورقاها فالخلاب % % 12(@)(@@) % كيف لا تأوي لشخص % هائم القلب مصاب % % 13(@)(@@) % دنف في حب هند % ذي شكاة وانتحاب % % 14(@)(@@) % دخل الحب لهند % قلبه من كل باب % % 15(@)(@@) % ليت لي قوسا ونبلا % حين تربا حبابي % % 16(@)(@@) % فأصيب القلب منها % % بمحدات صياب % % 17(@)(@@) % من سهام الحب إني % % أشتهيها للحباب % % 18(@)(@@) % ولقد 
ms49	 تامت فؤادي % % بصدود واجتناب % % 19(@)(@@) % يوم قامت تتهادى % % بين إتب وسخاب % % 20(@)(@@) % أملح الناس جميعا % سافرا أو في نقاب % % PageV01P173 21(@)(@@) % كملت في العين حسنا % وجمالا في الثياب % % 22(@)(@@) % اذكري ليلة نلهو % % في رعود وسحاب % % 23(@)(@@) % وحديثا نصطفيه % % في عفاف وتصابي % % 24(@)(@@) % ورسولا بات يسري % % في هواكم بالكتاب % 25(@)(@@) % ينذر العاشق حتى % % نصبوا حد الحراب % 26(@)(@@) % من عدو نتقيه % % وبني عم غضاب % 27(@)(@@) % طرقت حبي بهم % كاد ينسيني مآبي % % 28(@)(@@) % واسترادتني على الهو % ل بطاعون الشباب % % 29(@)(@@) % يوم قالت تحذر العي % ن على ذات الحجاب % % 30(@)(@@) % كن غرابا حين تأتي % % بيننا أو كغراب % % PageV01P174 31(@)(@@) % حذر العين فإنا % % لم نكن أهل معاب % % 32(@)(@@) % فتحضرت بنفسي % % نحوها دون القراب % % 33(@)(@@) % فالتقينا بحديث % من شكاة وعتاب % % 34(@)(@@) % منطق منها ومني % % غير تحقيق سباب % % 35(@)(@@) % قلت لما برحت بي % % لم يكن هذا احتسابي % % 36(@)(@@) % حيث أرجوكم فسمتم % زوركم سوط عذاب % % 37(@)(@@) % ليتني قبل هواكم % % كنت في بطن التراب % % 38(@)(@@) % فبكت ' هند ' وقالت % % حب لا تنكر خطابي % % 39(@)(@@) % غلظة بعد التلاقي % % بعدها لين جواب % % PageV01P175 البحر : خفيف تام 1(@)(@@) % نور عيني أصبت عيني بسكب % % يوم فارقتني على غير ذنب % 2(@)(@@) % كيف لم تذكري المواثيق والعه % % د وما قلت لي وقلت لصحبي % % 3(@)(@@) % ما تصبرت عن لقائك إلا % % قل صبري وباشر الموت قلبي % % 4(@)(@@) % ليتني مت قبل حبك يا قر % ة عيني أو عشت في غير حب % 5(@)(@@) % ليس شيء أجل من فرقة النف % س فحسبي فجعت بالنفس حسبي % % 6(@)(@@) % كف عيشي وما نعود كما كن % % نا إلى الله أشتكي جهد كربي % % 7(@)(@@) % فرغ الناس من معالجة النا % % س جميعا وأنت همي وربي % % PageV01P176 البحر : سريع 1(@)(@@) % أفنيت عمري وتقضى الشباب % % بين الحميا والجواري الأواب % 2(@)(@@) % فالآن شفعت إمام الهدى % % وربما طبت لحب وطاب % 3(@)(@@) % صحوت إلا أن ذكر الهوى % % يدعو إلى الشوق فأنسى مآب % % 4(@)(@@) % لله دري لا أرى عاشقا % إلا جرى دمعي وطال انتحاب % % 5(@)(@@) % كأن قلبي ببقايا الهوى % % معلق بين خوافي عقاب % % 6(@)(@@) % يا حبذا الكأس 
ms50	 وحور الدمى % % أزمان ألهو والهوى لايعاب % 7(@)(@@) % يا صاح بلاني طلاب الهوى % % وصرف إبريق عليه النقاب % % 8(@)(@@) % يوما نعيم أخلقا جدتي % % ولمة مثل جناح الغراب % % 9(@)(@@) % والله ما لاقيت مثليهما % % في عامر الأرض ولا في الخراب % % 10(@)(@@) % لهفي على يومي بذي باسم % ومجلس بين خليج وغاب % PageV01P177 11(@)(@@) % يا مجلسا أكرم به مجلسا % حف بريحان وعيش عجاب % 12(@)(@@) % بت به أسقى رهاوية % لعيب ست خلقت للعاب % 13(@)(@@) % ثم غدونا وغدا ذاهبا % وكل عيش مؤذن بالذهاب % 14(@)(@@) % لهوت حتى راعني غاديا % % صوت أمير المؤمنين المجاب % 15(@)(@@) % لبيك لبيك هجرت الصبا % % ونام عذالي ومات العتاب % % 16(@)(@@) % لا ناكثا عهدا ولا طالبا % سخطك ما غنى الحمام الطراب % 17(@)(@@) % أبصرت رشدي وهجرت المنى % % وربما ذلت لهن الرقاب % 18(@)(@@) % يا حامد القول ولم يبله % سبقت بالسيل انهلال السحاب % 19(@)(@@) % الفعل أولى بثناء الفتى % % ما جاءه من خطل أو صواب % % 20(@)(@@) % دع قول واء وانتظر فعله % يثني على اللقحة ما في العلاب % % PageV01P178 21(@)(@@) % إذا غدا المهدي في جنده % % أو راح في آل الرسول الغضاب % % 22(@)(@@) % بدا لك المعروف في وجهه % % كالظلم يجري في ثنايا الكعاب % % 23(@)(@@) % لا كالفتى المهدي في رهطه % % ذو شيبة كهل ولا ذو شباب % % 24(@)(@@) % لا يحسن الفحش وينكي العدى % % ويعتريه الجود من كل باب % % 25(@)(@@) % ضراب أعناق وفكاكها % % في مجلس الملك وظل العقاب % % 26(@)(@@) % في صدره حلم وفي درعه % % مظفر الحزم كريم المآب % 27(@)(@@) % ترى حجابا دونه هائلا % والروح والأمن وراء الحجاب % % 28(@)(@@) % جرى اللهاميم على إثره % جري البراذين خلاف العراب % PageV01P179 البحر : كامل تام 1(@)(@@) % ما رد سلوته إلى إطربه % حتى ارعوى وحدا الصبا بركابه % % 2(@)(@@) % إن كان ليس به الجنون فإنما % % لعب الرقاة بقلبه أو ما به % % 3(@)(@@) % إلى ' عبيدة ' شوقه ونزاعه % % إن المحب معذب بحبابه % % 4(@)(@@) % ما زال مذ زال الغزال منقبا % بطريفة من عينه ونقابه % % 5(@)(@@) % ريم تعرض كالبرود لرأيه % % فصبا ووكله الصبا بطلابه % % 6(@)(@@) % عرضت له بجمالها ودلالها % % عند المثاب فحيل دون مثابه % 7(@)(@@) % تغدو له العبرات عند غدوه 
ms51	 % % وتؤوبه الزفرات عند إيابه % % 8(@)(@@) % إن قيل : من حلب الصبا لفؤاده % % فاذكر عبيدة ليس من جلابه % % 9(@)(@@) % شخص برؤيته مناه وهمه % وحديثه في جده ولعابه % % 10(@)(@@) % أنى أروم به السلو ولم أزل % % بخياله أرقى وطيب ثيابه % % PageV01P180 11(@)(@@) % لو مت ثم سقيتني برضابه % % رجعت حياة جنازتي برضابه % % 12(@)(@@) % إن خط قبري نائيا عن بيته % % فاجعل حنوطي من دقاق ترابه % % 13(@)(@@) % سقيا له ولمدخل أدخلته % يوم الخميس عليه في أترابه % % 14(@)(@@) % ولقد عجبت من الجري يقول لي % % لما بدا في حليه وخضابه % % 15(@)(@@) % أهو الحبيب بدا لعينك أم دنت % شمس النهار إليك في جلبابه % % 16(@)(@@) % فزنا بمجلسنا فيا لك مجلسا % قصر النهار وصاحبي ازرى به % % 17(@)(@@) % نصل الحديث إذا أمنا عينه % عجبا به ونروح من عيابه % % 18(@)(@@) % و ( رباب ) ترمق من ألم بعينها % % سلمت من الأقذاء عين ربابه % % 19(@)(@@) % حتى إذا انخرق الصفاء بمنطق % بلغ العتاب وكان دون عتابه % % 20(@)(@@) % قالت : ( كتامة ) داخل وكأنما % % بعثت له ابن مفدم بعذابه % % PageV01P181 21(@)(@@) % قد كان يشفق من تقاصر يومه % % في بيته وكتامة المنتابه % % 22(@)(@@) % شحا عليه ورهبة من يومه % % فالآن أصبح موقنا بذهابه % % 23(@)(@@) % ولقد أقول لشامت بفراقه % % ملق الحديث إذا غدا كذابه : % 24(@)(@@) % سامح أخاك إذا غدوت لحاجة % واترك مساخطه إلى إعتابه % % 25(@)(@@) % فلقد أسوي للضغائن مثلها % % وأصي البغيض ولست بالهيابه % % 26(@)(@@) % وأحد من ولد الجديل أعاره % طرف النسوع أخذن في أقرابه % % 27(@)(@@) % عرد إذا خرس المطي كأنما % % يغدو يجرجر دارس في نابه % % 28(@)(@@) % وإذا سرى كحل الزميل بأرقة % من قرع بازله ومن قيقابه % % 29(@)(@@) % وكأن منفضج الحميم بليته % دهن شببت سواده بملابه % % 30(@)(@@) % غول البلاد إذا المقيل تحرقت % % آرامه وجرت بماء سرابه % % PageV01P182 31(@)(@@) % يثب الإكام إذا عرضن لوجهه % % من عرب أغلب ليس من إنعابه % % 32(@)(@@) % بنجاء منسرح اليدين تخاله % عند الكلال يزاد في إلهابه % % 33(@)(@@) % دامي الأظل على الحداب كأنما % % خضبت بعصفره رؤوس حدابه % % 34(@)(@@) % وكأنه من وحش وجرة ناشط % يقرو العقنقل آلفا بعذابه % % 35(@)(@@) % جذل المها وصوار كل خميلة % لا عن تجفله 
ms52	 نجاء خبابه % % 36(@)(@@) % أرج القنان إذا ترجلت الضحى % % صخب القنابر تحت ظل سحابه % % 37(@)(@@) % للشمس يسجد طائعا ريحانه % % ويبيت يأرق ضيفه بذبابه % % 38(@)(@@) % حتى إذا طلع الزمان بعيشة % فيها وسال عليه بعض شعابه % % 39(@)(@@) % حنف المبيت له بأوجس ليلة % من صوت راعده ومن تسكابه % % 40(@)(@@) % فأقام يشخصه الثرى ويسيره % قرب السفا ليسيح في منجابه % % PageV01P183 41(@)(@@) % صرر الأديم إذا أرب به الندى % % غشي الألاء يلوذ من إربابه % % 42(@)(@@) % حتى إذا غدت الورى وغدا بها % % مثل المريض أفاق من أوصابه % % 43(@)(@@) % وتجوبت مزق الدجى عن واضح % كالفرق وانكشفت سماء ضبابه % % 44(@)(@@) % سبق الشروق إليه أشعث شاحب % تلد الضراء فهن من أكسابه % % 45(@)(@@) % فانصاع من حذر على حوبائه % % وتبعنه ينسبن في منسابه % % 46(@)(@@) % حتى إذا سمع الضباح خلافه % وعرضنه طلقا على أعطابه % % 47(@)(@@) % كر الشبوب على الضراء بروقه % % فاختل لبة زانج وزنابه % % 48(@)(@@) % ومضى يزل على المتان كأنه % نجم لمسترق هوى بشهابه % % 49(@)(@@) % فكذاك ذلك إذ رفعت قيوده % أصلا وميثرتي على أصلابه % % 50(@)(@@) % هجر المقامة أن تكون مناخه % % بأغر تزدحم الوفود ببابه % % PageV01P184 51(@)(@@) % متحاسدين على لقاء مسود % رحب الفناء جد على أصحابه % % 52(@)(@@) % رجل إذا زأرت أسود قبيلة % زأر المهلب وابنه في غابه % % 53(@)(@@) % داود إنك قد بلغت بحاتم % شرف العلى وذهبت في أسبابه % % 54(@)(@@) % وبنى قبيصة والمهلب معقلا % وبنيت بيتك في ذرى صلابه % % 55(@)(@@) % هذا وذاك وذا وأنت ، ولم تزل % تزداد في شرف البنى ورحابه % % 56(@)(@@) % هل تجفون فتى يقول لمجدب % وسق المطي يفر من أجدابه % % 57(@)(@@) % داود غيثك إن بسطت بلاده % % فانزل ضمنت لك الحبا بجنابه % % 58(@)(@@) % وأبل يلتهم الخصوم مرغم % بصواب منطقه وغير صوابه % % 59(@)(@@) % وجهت عن بنت السبيل سبيله % بمحالة وردعته بجوابه % % 60(@)(@@) % وإذا الخطوب تقنعت عن لاقح % تدع الذليل لنسره وغرابه % % PageV01P185 61(@)(@@) % ألقت بنو يمن إليك أمورها % % وربيعة بن نزار الربابه % % 62(@)(@@) % قعد الأغر لدى الكريهة والذي % % عند الملاحم يشتفى بضرابه % % 63(@)(@@) % سهم اللقاء إذا غدا في درعه % % رأبت مشاهده الثأى برئابه % % 64(@)(@@) % % من لين جانبه ولين حجابه 
ms53	 % % 65(@)(@@) % وإذا اكتحلت به رأيت مبتلا % لبس النعيم على أديم شبابه % % 66(@)(@@) % ينفي مواهبه النوافذ كلها % % من سيب مشرك الندى وهابه % % 67(@)(@@) % يعطي البدور مع البدور ولو عرا % % حق لأعطى ما له برقابه % % 68(@)(@@) % وإذا تنزل في البطاح قبابه % في المحرمين عرفته بقبابه % % 69(@)(@@) % وقيانه الغر النواصف أهلها % % وقيام غاشيه على أبوابه % % 70(@)(@@) % من راغب يعد العيال نواله % بعد الرجوع وراهب لعقابه % % PageV01P186 البحر : طويل 1(@)(@@) % نأتك على طول التجاور ( زينب % وما شعرت أن النوى سوف تصقب % % 2(@)(@@) % كأن الذي غال الرحيل رقادها % % بما عضبت من قربنا النفس تعضب % % 3(@)(@@) % تداعى إلى ما فاتنا من وداعنا % % على بعدها بالوأي إذ تتقرب % 4(@)(@@) % فإن تنصبي يوما إلى لمة الهوى % % فإني بما ألقى إلى تلك أنصب % % 5(@)(@@) % سلي تخبري أن المعنى بذكركم % على سنة فيمن يحيب ويدأب % % 6(@)(@@) % إذا ذاد عنه عقربا من هواكم % % برقيته دبت له منك عقرب % 7(@)(@@) % فبات يدني قلبه من جلادة % % ليقلبه عنكم فلا يتقلب % 8(@)(@@) % أبى منك ما يلقى ويأبى فؤاده % سواك ، فيلمي هجره ثم يغلب % 9(@)(@@) % لذي نصحه عنكن به أجنبية % وعن نصح دنياه به القلب أجنب % PageV01P187 10(@)(@@) % فؤاد على نهي النصيح كأنما % % يحث بما ينهى إليه ويتعب % 11(@)(@@) % فمات بما يرخى له من خناقه % % ويحيا علوقا في الحبال فينشب % % 12(@)(@@) % كشاكية من عينها غرب قرحة % تداوى بما تدوى عليه وتذرب % 13(@)(@@) % يغص إذا نال الطعام لذكركم % % ويشرق من وجد بكم حين يشرب % % 14(@)(@@) % فلا مذهب عنكم له شط أو دنا % % سواك وف الأرض العريضة مذهب % 15(@)(@@) % على النأي محزون وفي القرب مغرم % فيا كبدا أن الطريقين أركب % 16(@)(@@) % إذا خدرت رجلي شفيت بذكرها % % أذاها فأهفوا باسمها حين تنكب % 17(@)(@@) % لقد عنيت عما أقاسي بذكرها % % وعما يقول الشاهدي حين أطرب % 18(@)(@@) % يرى الناس ما نبدي بزينب إذ نأت % عجيبا ، وما يخفى من الحب أعجب % 19(@)(@@) % يروح ويغدو واجدا ينتحي الهوى % % على رجل مصبور على الورد أجرب % PageV01P188 20(@)(@@) % إذا عرض القوم الحديث بذكرها % % أئن كما أن المريض الموصب 
ms54	 % 21(@)(@@) % إذا ما نأت فالعيش ناء لنأيها % % وإن قربت فالموت بالقرب يقرب % 22(@)(@@) % كفاك من الذلفاء لو كنت تكتفي % % مواعد لم تذهب بها حيث تذهب % % 23(@)(@@) % وقائلة حين استحق رحيلنا % % وأجفان عينيها تجود وتكسب : % 24(@)(@@) % أغاد إلى ' حران ' في غير شيعة % وذلك شأو عن هوانا مغرب % % 25(@)(@@) % فقلت لها : كلفتني طلب الندى % % وليس وراء ابن الخليفة مطلب % 26(@)(@@) % سيكفي فتى من شيعة حد سيفه % % وكور علافي ووجناء ذعلب % % 27(@)(@@) % إذا استوعرت دار عليه رمى بها % % بنات الصوى منها ركوب ومصعب % 28(@)(@@) % فعدى إلى يوم ارتحلت وسائلي % % نوافلك الفعال من جاء يضرب % % 29(@)(@@) % لعلك أن تستيقني أن زورتي(@)(@@) % سليمان ) من سير الهواجر يعقب % PageV01P189 30(@)(@@) % وماء عفاء لا أنيس بجوه % % حليفاه من شتى عفاء وطحلب % 31(@)(@@) % وردت إذا التاث الهجان وقد خوى % % عليه من الظلماء بيت مطنب % 32(@)(@@) % نعوج على التأويب صعر من البرى % % نواشط في لج من الليل تنعب % 33(@)(@@) % إذا ما أنخناها لغير تئية % على غرض الحاجات والقوم لغب % % 34(@)(@@) % وقعن فريصات السديس كما دعا % % على فنن من ضالة الأيك أخطب % % 35(@)(@@) % قلائص إن حركت كفا تكمشت % % كأن على أكسائها الجن تجلب % % 36(@)(@@) % سقين بحذاء النجاء شملة % إذا قال يعفور الفلاة تأوبوا % % 37(@)(@@) % مفرجة الضبعين ممهورة القرى % % تحذ عليها راكب متنقب % 38(@)(@@) % سرى الليل والتهجير في كل سبسب % يعارضه من عارض النص سبسب % 39(@)(@@) % دياميم ترمي بالمطي إليكم % % تظل بنات الأزل فيهن تلعب % PageV01P190 40(@)(@@) % وكم جاوزت من ظهر أرعن شاخص % ومن بطن واد جوفه متصوب % 41(@)(@@) % لها هاتف يحكي غناء عشنقا % سميعا بما أدى له الصوت معرب % 42(@)(@@) % فغنت غناء عينه ولسانه % قريب مصار الصوت ليس يثقب % 43(@)(@@) % هو الخنف لا إنس ولا نجل جنة % يعيش ولا يغذوه أم ولا أب % 44(@)(@@) % إليك أبا أيوب أسمعت صاحبي % % أغانيه والناعجات تسرب % 45(@)(@@) % إذا خرجت من عينه قلت ليتني % % يجوب الدجى منها حرار وتنعب % 46(@)(@@) % شربت برنق من مدام ولو دنت % حياض ' سليمان ' صفا لي مشرب % 47(@)(@@) % إذا جئت ' حرانا ' وزرت أميرها 
ms55	 % % فربك مضمون وواديك معشب % 48(@)(@@) % هناك امرؤ إن النوال لمن دنا % % له عطن سهل وكف تحلب % 49(@)(@@) % درور لقوم بالحياة على الرضى % % على أن فيها موتهم حين يغضب % PageV01P191 50(@)(@@) % ألا أيها المستعتب الدهر مسه % من الضيق والتأنيب ناب ومخلب % 51(@)(@@) % إذا قذيت عين الزمان فداوها % % بقرب ' سليمان ' فإنك معتب % 52(@)(@@) % عداك العدى ما سار تحت لوائه % % بطاريق في الماذي كهل وأشيب % 53(@)(@@) % هو المرء يستعلي ' قريشا ' بنفعه % % ودفع عدو فاحش حين يكلب % % 54(@)(@@) % رزين حصاة العلم لا يستخفه % % أحاديث يستوعي عليها المعيب % 55(@)(@@) % شبيه أمير المؤمنين وسيفه % به يتقى في النائبات ويصعب % 56(@)(@@) % يهش لميقات الجهاد فؤاده % فلا يتطرقه البنان المخضب % 57(@)(@@) % إذا الحرب قامت قام حتى يفيدها % % قعودا وحثحوث الكتيبة مطنب % 58(@)(@@) % له كل عام غزوة بمسوم % % يقود المنايا رايه حين يذهب % 59(@)(@@) % لهام كأن البيض في حجراته % % نجوم سماء ( نورها ) متجوب % PageV01P192 60(@)(@@) % كراديس خيل لا تزال مغيرة % بها الملك الرومي عان معذب % 61(@)(@@) % كأن بنات اليون بعد إيابه % % موزعة بين الصحائب ربرب % 62(@)(@@) % مواهب مغبوط بها من ينالها % % صفايا سبايا الروم بكر وثيب % 63(@)(@@) % وما قصدت قوما محلين خيله % فتصرف إلا عن دماء تصبب % 64(@)(@@) % جدير بترك النائحات إذا غدا % % لهن على القتلى عويل ومندب % 65(@)(@@) % أغر هشامي القنا إذا انتمى % % نمته بدور ليس فيهن كوكب % 66(@)(@@) % جميل المحيا حين راح كأنما % % تخير في ديباجة الوصف مذهب % 67(@)(@@) % يزين سرير الملك زينا وينتهي % % به المنبر المنصوب في يوم يخطب % PageV01P193 البحر : رمل تام 1(@)(@@) % وأخ ذي ثقة آخيته % ماجد الأعراق مأمون الأدب % 2(@)(@@) % أمحض الله له أخلاقه % فهي كالإبريز من سر الذهب % 3(@)(@@) % عزني المعروف حتى علقت % كل كف لي منه بسبب % % 4(@)(@@) % فهو يعطيني وأعطي فضله % سبل الغيث تدلى فسكب % 5(@)(@@) % فإذا أبصر وجهي مقبلا % ضحكت عيناه من غير عجب % % 6(@)(@@) % وإذا كلمته واحدة % هيجت منه علالات الطرب % 7(@)(@@) % وإذا ما غبت عنه ساعة % أن للغيبة من غير وصب % 8(@)(@@) % فهو لي والحمد لله غنى % % وعفاف من دني 
ms56	 المكتسب % 9(@)(@@) % من تجارات أشابت مفرقي % % وكستني ثوب ذل ونصب % 10(@)(@@) % وملوك إن تعرضت لهم % عرضوا ديني وشيكا للعطب % PageV01P194 البحر : سريع 1(@)(@@) % نغص طيب العيش تنصيب % وفي الملمات الأعاجيب % 2(@)(@@) % والدهر طلاع بأحكامه % % والمرء مخدوع ومكذوب % 3(@)(@@) % والناس من غاد ومن رائح % % يحصى عليه البر والحوب % 4(@)(@@) % لا يشتهي الموت ويمنى به % % كرها وطيب العيش تعذيب % 5(@)(@@) % قل لابن داود إذا جئته % سيبك موجود ومطلوب % 6(@)(@@) % أنجز حر وأيه طائعا % والعبد مكدود ومضروب % 7(@)(@@) % للمرء من أفعاله مشبه % فافعل شبيها بك يعقوب % 8(@)(@@) % حلبت للقوم فلا تنسني % % وأنت عرف الجود محلوب % 9(@)(@@) % يبقي لذي المعروف معروفه % حمدا وتنزاح الأكاذيب % PageV01P195 البحر : طويل 1(@)(@@) % جفا وده فازور أو مل صاحبه % وأزرى به أن لا يزال يعاتبه % % 2(@)(@@) % خليلي لا تستنكرا لوعة الهوى % % ولا سلوة المحزون شطت حبائبه % 3(@)(@@) % شفى النفس ما يلقى بعبدة عينه % وما كان يلقى قلبه وطبائبه % % 4(@)(@@) % فأقصر عرزام الفؤاد وإنما % % يميل به مس الهوى فيطالبه % 5(@)(@@) % إذا كان ذواقا أخوك من الهوى % % موجهة في كل أوب ركائبه % 6(@)(@@) % فخل له وجه الفراق ولا تكن % مطية رحال كثير مذاهبه % 7(@)(@@) % أخوك الذي إن ربته قال إنما % % أربت وإن عاتبته لان جانبه % % 8(@)(@@) % إذا كنت في كل الذنوب معاتبا % صديقك لم تلق الذي لا تعاتبه % 9(@)(@@) % فعش واحدا أو صل أخاك فإنه % % مفارق ذنب مرة ومجانبه % 10(@)(@@) % إذا أنت لم تشرب مرارا على القذى % % ظمئت وأي الناس تصفو مشاربه % % PageV01P196 11(@)(@@) % وليل دجوجي تنام بناته % وأبناؤه من هوله وربائبه % 12(@)(@@) % حميت به عيني وعين مطيتي % % لذيذ الكرى حتى تجلت عصائبه % % 13(@)(@@) % وماء ترى ريش الغطاط بجوه % % خفي الحيا ما إن تلين نضائبه % 14(@)(@@) % قريب من التغرير ناء عن القرى % % سقاني به مستعمل الليل دائبه % 15(@)(@@) % حليف السرى لا يلتوي بمفازة % % نساه و لا تعتل منها حوالبه % 16(@)(@@) % أمق غريري كأن قتوده % على مثلث يدمى من الحقب حاجبه % % 17(@)(@@) % غيور على أصحابه لا يرومه % خليط ولا يرجو سواه صواحبه % 18(@)(@@) % إذا ما 
ms57	 رعى سنين حاول مسحلا % يجد به تعذامه ويلاعبه % % 19(@)(@@) % أقب نفى أبناءه عن بناته % % بذي الرضم حتى ما تحس ثوالبه % 20(@)(@@) % رعى ورعين الرطب تسعين ليلة % على أبق والروض تجري مذانبه % % PageV01P197 21(@)(@@) % فلما تولى الحر واعتصر الثرى % % لظى الصيف من نجم توقد لاهبه % 22(@)(@@) % وطارت عصافير الشقائق واكتسى % % من الآل أمثال الملاء مساربه % 23(@)(@@) % وصد عن الشول القريع وأقفرت % % ذرى الصمد مما استودعته مواهبه % 24(@)(@@) % ولاذ المها بالظل واستوفض السفا % % من الصيف نئاج تخب مواكبه % 25(@)(@@) % غدت عانة تشكو بأبصارها الصدى % % إلى الجأب إلا أنها لا تخاطبه % % 26(@)(@@) % وظل على علياء يقسم أمره % أيمضي لورد باكرا أم يواتبه % 27(@)(@@) % فلما بدا وجه الزماع وراعه % من الليل وجه يمم الماء قاربه % % 28(@)(@@) % فبات وقد أخفى الظلام شخوصها % % يناهبها أم الهدى وتناهبه % 29(@)(@@) % إذا رقصت في مهمه الليل ضمها % % إلى نهج مثل المجرة لاحبه % 30(@)(@@) % إلى أن أصابت في الغطاط شريعة % من الماء بالأهوال حفت جوانبه % % PageV01P198 31(@)(@@) % بها صخب المستوفضات على الولى % % كما صخبت في يوم قيظ جنادبه % % 32(@)(@@) % فأقبلها عرض السري وعينه % ترود وفي الناموس من هو راقبه % % 33(@)(@@) % أخو صيغة زرق وصفراء سمحة % يجاذبها مستحصد وتجاذبه % 34(@)(@@) % إذا رزمت أنت وأن لها الصدى % % أنين المريض للمريض يجاوبه % 35(@)(@@) % كأن الغنى آلى يمينا غليظة % عليه خلا ما قربت لا يقاربه % % 36(@)(@@) % يؤول إلى أم ابنتين يؤوده % إذا ما أتاها مخفقا أو تصاخبه % 37(@)(@@) % فلما تدلى في السري وغره % % غليل الحشا من قانص لا يواثبه % 38(@)(@@) % رمى فأمر السهم يمسح بطنه % % ولباته فانصاع والموت كاربه % 39(@)(@@) % ووافق أحجارا ردعن نضيه % فأصبح منها عامراه وشاخبه % % 40(@)(@@) % يخاف المنايا إن ترحلت صاحبي % % كأن المنايا في المقام تناسبه % PageV01P199 41(@)(@@) % فقلت له : إن العراق مقامه % وخيم إذا هبت عليك جنائبه % 42(@)(@@) % لعلك تسدني بسيرك في الدجى % % أخا ثقة تجدي عليك مناقبه % 43(@)(@@) % من الحي قيس قيس عيلان إنهم % عيون الندى منهم تروى سحائبه % % 44(@)(@@) % إذا المجحد المحروم ضمت حباله % حبائلهم سيقت إليه رغائبه % % 45(@)(@@) % ويوم عبوري 
ms58	 طغا أو طغا به % % لظاه فما يروى من الماء شاربه % 46(@)(@@) % رفعت به رحلي على متخطرف % يزف وقد أوفى على الجذل راكبه % 47(@)(@@) % وأغبر رقاص الشخوص مضلة % موارده مجهولة وسباسبه % 48(@)(@@) % لألقى بني عيلان إن فعالهم % % تزيد على كل الفعال مراكبه % 49(@)(@@) % ألاك الألى شقوا العمى بسيوفهم % % عن الغي حتى أبصر الحق طالبه % % 50(@)(@@) % إذا ركبوا بالمشرفية والقنا % % وأصبح مروان تعد مواكبه % % PageV01P200 51(@)(@@) % فأي امرىء عاص وأي قبيلة % وأرعن لا تبكي عليه قرائبه % 52(@)(@@) % رويدا تصاهل بالعراق جيادنا % % كأنك بالضحاك قد قام نادبه % 53(@)(@@) % وسام لمروان ومن دونه الشجا % % وهول كلج البحر جاشت غواربه % 54(@)(@@) % أحلت به أم المنايا بناتها % % بأسيافنا إنا ردى من نحاربه % % 55(@)(@@) % وما زال منا ممسك بمدينة % % يراقب أو ثغر تخاف مرازبه % % 56(@)(@@) % إذا الملك الجبار صعر خده % مشينا إليه بالسيوف نعاتبه % 57(@)(@@) % وكنا إذا دب العدو لسخطنا % % وراقبنا في ظاهر لا نراقبه % % 58(@)(@@) % ركبنا له جهرا بكل مثقف % وأبيض تستسقي الدماء مضاربه % 59(@)(@@) % وجيش كجنح الليل يرجف بالحصى % % وبالشول والخطي حمر ثعالبه % 60(@)(@@) % غدونا له والشمس في خدر أمها % % تطالعنا والطل لم يجر ذائبه % PageV01P201 61(@)(@@) % بضرب يذوق الموت من ذاق طعمه % وتدرك من نجى الفرار مثالبه % 62(@)(@@) % كأن مثال النقع فوق رؤوسهم % % وأسيافنا ليل تهاوى كواكبه % % 63(@)(@@) % بعثنا لهم موت الفجاءة إننا % % بنو الملك خفاق علينا سبائبه % 64(@)(@@) % فراحوا : فريقا في الإسار ومثله % قتيل ومثل لاذ بالبحر هاربه % 65(@)(@@) % وأرعن يغشى الشمس لون حديده % وتخلس أبصار الكماة كتائبه % % 66(@)(@@) % تغص به الأرض الفضاء إذا غدا % % تزاحم أركان الجبال مناكبه % % 67(@)(@@) % كأن جناباويه من خمس الوغى % % شمام وسلمى او أجأ وكواكبه % 68(@)(@@) % تركنا به كلبا وقحطان تبتغي % % مجيرا من القتل المطل مقانبه % 69(@)(@@) % أباحت دمشقا خيلنا حين ألجمت % وآبت بها مغرور حمص نوائبه % % 70(@)(@@) % ونالت فلسطينا فعرد جمعها % % عن العارض المستن بالموت % PageV01P202 71(@)(@@) % وقد نزلت منا بتدمر نوبة % كذاك عروض الشر تعرو نوائبه % % 72(@)(@@) % تعود بنفس لا تزل عن الهدى % % كما زاغ عنه ثابت وأقاربه % % 73 
ms59	(@)(@@) % دعا ابن سماك للغواية ثابت % جهارا ولم يرشد بنيه تجاربه % % 74(@)(@@) % ونادى سعيدا فاستصب من الشقا % % ذنوبا كما صبت عليه ذنائبه % % 75(@)(@@) % ومن عجب سعي ابن أغنم فيهم % وعثمان إن الدهر جم عجائبه % % 76(@)(@@) % وما منهما إلا وطار بشخصه % نجيب وطارت للكلاب رواجبه % % 77(@)(@@) % أمرنا بهم صدر النهار فصلبوا % % وأمسى حميد ينحت الجذع صالبه % % 78(@)(@@) % وباط ابن روح للجماعة إنه % زأرنا إليه فاقشعرت ذوائبه % % 79(@)(@@) % وبالكوفة الحبلى جلبنا بخيلنا % % عليهم رعيل الموت إنا جوالبه % % 80(@)(@@) % أقمنا على هذا وذاك نساءه % مآتم تدعو للبكا فتجاوبه % % PageV01P203 81(@)(@@) % أيامى وزوجات كأن نهاءها % % على الحزن أرءام الملا ورباربه % % 82(@)(@@) % بكين على مثل السنان أصابه % حمام بأيدينا فهن نوادبه % % 83(@)(@@) % فلما اشتفينا بالخليفة منهمو % % وصال بنا حتى تقضت مآربه % % 84(@)(@@) % دلفنا إلى الضحاك نصرف بالردى % % ومروان تدمى من جذام مخالبه % % 85(@)(@@) % معدين ضرغاما وأسود سالخا % حتوفا لمن دبت إلينا عقاربه % 86(@)(@@) % وما أصبح الضحاك إلا كثابت % عصانا فأرسلنا المنية تادبه % PageV01P204 البحر : خفيف تام 1(@)(@@) % طرقتنا بالزابيين الرباب % رب زور عليك منه اكتئاب % 2(@)(@@) % ولقد قلت لابن جهمة إذ بت % % ت مشوقا ونام عني الصحاب : % 3(@)(@@) % غنني بالرباب إن كنت تشدو % % غار نومي وجن في الشراب % 4(@)(@@) % أمسكت عني الرقاد فتاة % دارها الخبت والربى والقباب % 5(@)(@@) % مقبل مدبر قريب بعيد % % يتصدى لنا وفيه احتجاب % 6(@)(@@) % كسراب الموماة تبصره العي % ن وإن جئته اضمحل السراب % 7(@)(@@) % أو كبدر السماء غير قريب % حين أوفى والضوء فيه اقتراب % 8(@)(@@) % وطلاب الرباب من دونها السي % ف سفاه والطيف منها عذاب % % 9(@)(@@) % لو أقامت نعمت بالا ولكن % ذهبت والشقا علي الذهاب % % 10(@)(@@) % ساقها الأزرق الغيور إلى الشا % % م فذات الأشياء منها خراب % PageV01P205 11(@)(@@) % طاب حزن بين الجوانح منها % % وانتظاري هل للحبيب إياب % 12(@)(@@) % وولوع الخيال بي من صديق % لا أراه حتى يشيب الغراب % % 13(@)(@@) % يا بن موسى اسقني ودع عنك بكرا % إن بكرا خلو وإني مصاب % % 14(@)(@@) % لا أرى آنسي مقام الجواري % % ومسير الرباب فيه ارتقاب % % 15(@)(@@) % يوم حنت إلي مرفضة 
ms60	 الدم % % ع وحنت إلى سواي الرباب % % 16(@)(@@) % لا تلمني فيها يزيد بن زيد % وارع ودي إليك يهدى الجواب % % 17(@)(@@) % في لقاء الرباب شاف من الشو % % ق إلى وجهها ، وأين الرباب % % 18(@)(@@) % رحت في حبها وراحت دوارا % بين أترابها عليها الحجاب % % 19(@)(@@) % في جنان خضر وقصر مشيد % قيصري حفت به الأعناب % % 20(@)(@@) % فوقها ملعب الحمام ويستن % خليج من دونها صخاب % % PageV01P206 21(@)(@@) % وبعيد ما لا ينال وفي الح % % ب عناء وللنوى أحقاب % 22(@)(@@) % ليت شعري عن الرباب وقد شط % % ت بها الدار هل لها إصقاب % % 23(@)(@@) % أصبحت في بني الشموس فأصبحت % غريبا تعتادني الأطراب % 24(@)(@@) % وسقي كالعبقري إذا غر % د مكاؤه تغنى الذباب % % 25(@)(@@) % عازب حف بالبراعيم تغدو % % ه نجوم السما وهن اعتقاب % 26(@)(@@) % متناهي الريحان يسجد للشمس % مس مبينا وما عليه اتئاب % 27(@)(@@) % بت ضيفا معي الريم والأع % % والرائع الأناة الكعاب % % 28(@)(@@) % ذاك شأني به ووافى بي الرو % % ع كميت مشذب نعاب % % 29(@)(@@) % أعوجي الآباء شارك فيه % % لاحق والوجيه ثم الغراب % % 30(@)(@@) % . . . . . صانه الجد والم % % ففيه ذل وفيه التهاب % % PageV01P207 31(@)(@@) % ومنيف القذال وقره القو % د وذكى فؤاده الإجلاب % 32(@)(@@) % فهو صافي الأديم كالدملج % الأحمر طرف تزينه الأقراب % % 33(@)(@@) % وخروج من الأضاميم في المنس % % منه وفي القطاة انتصاب % % 34(@)(@@) % شمري أجش كالشبب الغا % % أقرت جنانه الكلاب % % 35(@)(@@) % شاخص القلب والمسامع والطر % % ف إلى ما يهاب أو لا يهاب % % 36(@)(@@) % وإذا ما جرى ليدرك شيئا % فاته وانتحى به الإدآب % 37(@)(@@) % قلت : ريح تحن بين أواس % أو براع غنى به القصاب % % 38(@)(@@) % فبه أطلب المعالي أو رو % % ح مديحا كما تقاد العراب % 39(@)(@@) % ولقد قلت إذ تولتني الهم % % وسدت من دوني الأبواب % 40(@)(@@) % ليس عند اللئام فضل ولكن % عند روح على الثناء ثواب % PageV01P208 41(@)(@@) % أين روح عني فإن لروح % نفحات يغنى بها المنتاب % 42(@)(@@) % ملك من ملوك قحطان تجري % % من يديه لنا العطايا الرغاب % 43(@)(@@) % عنده الحلم والشجاعة والجو % % د مساكا وليس فيه خلاب % 44(@)(@@) % وعلى وجهه الأغر قبول % وكأن المعروف فيه كتاب % 45 