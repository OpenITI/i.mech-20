ms581	 هاجسا % % 8(@)(@@) % ويرويوذاك الذي ألقاك من خطراته % % هوانا . . . . . . . . . . . . . . . . . . . . % 9(@)(@@) % أصم صميميت إذا ما سألته % % حسبتك ساءلت الرسوم الدوارسا % % PageV01P2311 البحر : - 1(@)(@@) % يفي بإبطاء جنى الن % نخل إذا ما غرسا % % 2(@)(@@) % عقبى له محمودة % إذا تعالى ورسا % % 3(@)(@@) % يبقى على الدهر إذا % % عود سواه يبسا % % 4(@)(@@) % جرى مع الزرع إلى ال % % فضل فكان الفرسا % % PageV01P2312 البحر : - 1(@)(@@) % كل داع لعلي % إنما يدعو لنفسه % 2(@)(@@) % وعلي من يتمنى % % يومه مرجوع وكسه % % 3(@)(@@) % قد رأى من قد رأى % % يوم علي يوم تعسه % % 4(@)(@@) % ود حساد علي % أنهم حشو لرمسه % % 5(@)(@@) % أي وصاف علي % لا يقرون بنحسه % % PageV01P2313 البحر : - 1(@)(@@) % وصاحب لم أك من جنسه % ما زلت أوفيه على بخسه % 2(@)(@@) % ولى وما أوليته سيئا % أتبعه الله قفا أمسه % % 3(@)(@@) % بل أحسن الله مجازاته % % على الذي استثمرت من غرسه % % 4(@)(@@) % أخلقت نفسي بمصافاته % % فصانني بالصرم عن نفسه % % PageV01P2314 البحر : - 1(@)(@@) % ترحل من هويت وكل شمس % ستكسف أو ستغرب حين تمسي % % 2(@)(@@) % وما ألهاك عن ذكرى حبيب % كعدك أمس يوم بعد أمس % 3(@)(@@) % رأيت الدهر يجرح ثم يأسو % % يؤسي أو يعوض أو ينسي % % 4(@)(@@) % أبت نفسي الهلاع لرزء شيء % كفى شجوا لنفسي رزء نفسي % % 5(@)(@@) % أتهلع وحشة لفراق إلف % وقد وطنتها لحلول رمس % % 6(@)(@@) % سأتخذ الزماع خليل صدق % يرادفني على وجناء عنس % % 7(@)(@@) % إلى ملك يهش إلى المعالي % % ولا يبتاع مكرمة ببخس % % 8(@)(@@) % أبى أيوبقرم بني زريق % وكل قبيلة تسمو برأس % 9(@)(@@) % بدا فبدت مخايل من كريم % طويل الباع أروع غير نكس % 10(@)(@@) % كأن عجاج موكبه تجلى % % هناك بوجهه عن قرن شمس % % PageV01P2315 11(@)(@@) % يحف بشخصه من أقربيه % % غيوث مفاقر وليوث بأس % % 12(@)(@@) % مروا درر الحروب دما وقاسوا % % من الهيجاء ضرسا بعد ضرس % % 13(@)(@@) % فما نيلت أنوفهم بذم % ولا ريمت رؤوسهم بعكس % % 14(@)(@@) % تراهم في الندي إذا ندوه % % كأن حلومهم هضبات حرس % % 15(@)(@@) % وإن لاقيتهم في يوم روع % لقيت الجن في أشباح إنس % % 16(@)(@@) % هم الجبل الذي لو زال يوما % لأضحى الملك لا يرسيه مرسي % % 17(@)(@@) % ألم يرني الأمير حبست 
ms582	 شعري % % عليهولم أذله بمدح جبس % % 18(@)(@@) % ولم أك شاربا إلا بعذب % وإن أعطشت خمسا بعد خمس % % 19(@)(@@) % فداه معاشر نكبت عنهم % وما أفديه بالعرض الأخس % % 20(@)(@@) % إذا امتدحوا وإن لم يستثابوا % % حسبت وجوههم طليت بورس % % PageV01P2316 21(@)(@@) % وما جربتهم إلا بغيري % % وما استخشنت جانبهم بلمسي % % 22(@)(@@) % إليه بعثتها ترمي بشخصي % % ولم أك قبل ذاك لها بحلس % % 23(@)(@@) % على ثقة بأن لها لديه % % مناخا بالسعادة غير شأس % % 24(@)(@@) % وأن سيريش ما أبريه منها % % بشحم مثل هداب الدمقس % % 25(@)(@@) % وكان إذا عراه الحق أعطى % % بخمس من أنامله وخمس % % 26(@)(@@) % عطايا بين بشر واعتذار % وليست بين إذلال وعبس % % 27(@)(@@) % أهابت بالرجاء لهى يديه % % إليإليلات أوان يأس % 28(@)(@@) % لعمر محامد حملت إليه % % لما بيعت بضائعها بوكس % % 29(@)(@@) % جعلت على ملوك الأرض طرا % مجاز مطيتيوعليه حبسي % % PageV01P2317 البحر : - 1(@)(@@) % ليهنك لبس المهرجان وإن غدا % % تهنئه الدنيا بأنك لابسه % 2(@)(@@) % وأنك ركن الملكوالملك الذي % % تطول مقاييس الملوك مقايسه % % 3(@)(@@) % ويهنيك أن لم يبق مجد ترومه % يداكوأن لم تبق كف تنافسه % % 4(@)(@@) % وأنك ذللت الخطوب فأذعنت % لعزك حتى ليس خطب يمارسه % % 5(@)(@@) % فقد فرغتك الشاغلات وحبذا % % فراغك من أحكام ما أنت سائسه % % 6(@)(@@) % ألا فاله لهو المرء مثلك إنه % مدارس علم لا تمل مدارسه % % 7(@)(@@) % تظل له من ذات نفسك قادحا % وليس يداني قادح العلم قابسه % % 8(@)(@@) % وبذل كريم ليس ينفك ماله % كرائمه مبذولة ونفائسه % % 9(@)(@@) % لكل جليس من يديه ووجهه % % يد الدهر يوم غائم الجو شامسه % % 10(@)(@@) % تطيب مجانيه جميعا وإنما % % تطيب مجاني من تطيب مغارسه % PageV01P2318 11(@)(@@) % وأخذ بحظ من سماع إذا التقى % % وهم الفتى المهموم ماتت هواجسه % % 12(@)(@@) % تسير بك الدنيا إذا ما تنازعت % نواطقه ألحانه وخوارسه % % 13(@)(@@) % وشرب شمول أطلق الله شربها % % تدين لها بكر الشباب وعانسه % % 14(@)(@@) % من الكمت ألوانا ولولا اصطلاؤها % % علاها قميص أصفر اللون وارسه % % 15(@)(@@) % وقت شاربيها النار عمدا بنفسها % % وما كان جسم النار جسما تلامسه % % 16(@)(@@) % فقاست أليم الطبخ يوما مكملا % يخالسها أجزاءها وتخالسه % % 17(@)(@@) % فلما تجلى حلها من حرامها % % وزالت 
ms583	 عن المرتاب فيها وساوسه % % 18(@)(@@) % ثوت في قرار الدن حتى تهلهلت % % ملابسها عن صفوها وملابسه % % 19(@)(@@) % وزفت إلى شرب كرام فمهرجوا % % بها مهرجانا غاب عنه مناحسه % % 20(@)(@@) % وحفته في أفق السماء سعوده % وفي الأرض خيرياته ونراجسه % % PageV01P2319 21(@)(@@) % لدى ملك يأبى له الزهو قدره % ويزهى به جلاسه ومجالسه % % 22(@)(@@) % له راحة لو مست الصخر أنبعت % % جوانبه ماءوأورق يابسه % % 23(@)(@@) % إذا وجهه أو رأيه أو فعاله % تبلجن في ليل تجلت حنادسه % % 24(@)(@@) % رأى الراح قدما والسماعولم تزل % % مسددة آراؤه ومحادسه % % 25(@)(@@) % شعارين يهتز الكريم عليهما % % كما اهتز صمصام جلته مداوسه % % 26(@)(@@) % إذا خامرا نفس امرىء زينا له % % سدى أو ندى أو ورد موت يغامسه % % 27(@)(@@) % فضافاهما للمجد لا أن نفسه % إذا لم يهزاها لمجد تشاكسه % % 28(@)(@@) % وما البحر أضحى والبحار شعابه % ولا اليث أمسى والليوث فرائسه % 29(@)(@@) % بأصدق جودا منه في كل أزمة % وبأسا إذا ما الروع ريعت فوارسه % 30(@)(@@) % به أعتب الدهر المذمم أهله % فأثل راجيهوأمل يائسه % % PageV01P2320 31(@)(@@) % غدا يبتني ما يبتنيولو اكتفى % % كفاه من المجد الحديث قدامسه % % 32(@)(@@) % ولكن أبى إلا فعالا بمثله % % إذا ضاع إرث يحرس الإرث حارسه % % 33(@)(@@) % فيا قائل السوءى لتطفيء نوره % وذلك نور لا تبوخ مقابسه % % 34(@)(@@) % نل النجم فاطمسهوأنى تناله % ولو نلته ما خلت أنك طامسه % % 35(@)(@@) % أبا أحمد . لا زال مجدك غصة % لكل حسود أو يواريه رامسه % % 36(@)(@@) % حلفت لأنت القائل الفاعل الذي % % غدا المجد محبوسا عليه حبائسه % % 37(@)(@@) % يراك إذا نال النظير نظيره % نظيرك مثل النجم عزت ملامسه % % 38(@)(@@) % رأست بني الدنياوليس بنازل % بمنزلة المرؤوس من أنت رائسه % % 39(@)(@@) % ألا رب قول قلته يا ابن طاهر % أصاخت له بعد الهدير قناعسه % % 40(@)(@@) % وفعل رآك الفاعلون فعلته % فأغضواوكل ذله لك عاكسه % % PageV01P2321 41(@)(@@) % لك القول يستحيي ذوو القول بعده % من القول حتى يترك النبس نابسه % % 42(@)(@@) % إلى الفعل يستخذي له كل فاعل % من الناس حتى الأصيد الرأس ناكسه % % 43(@)(@@) % عجبت لمن أهدى لك الشعر تحفة % ومن قال شعرا وهو دونك خانسه % % 44(@)(@@) % أيهدي إليك الشعر 
ms584	 بعد سماعه % % بشعرك إلا غافل القلب ناعسه % % 45(@)(@@) % وأنت الذي يدعو الكلام بقدرة % فيأتيه وحشي الكلام وآنسه % % 46(@)(@@) % أذلك أم يزويه عنك وقد رأى % % عطاياك إلا عاثر الجد ناعسه % % 47(@)(@@) % وأنت الذي سح النوال بنانه % كما سح غيث ضاحك المزن راجسه % % 48(@)(@@) % تكاد تعوق الشعر عنك عوائق % إذا قاسه يوما بشعرك قائسه % % 49(@)(@@) % فيحدو به أن ليس للحمد بائع % يراك وإن أغلى عليك تماكسه % 50(@)(@@) % تقول الذي ينهى عن الشعر أهله % بكل طراز لم يروا ما يجانسه % % PageV01P2322 51(@)(@@) % وتفعل ما يدعو إليهفكلهم % % يكر عليه عائدا فيلابسه % % 52(@)(@@) % فتركهم إياه إقرار أنفس % بأنك دون الإنس والجن فارسه % % 53(@)(@@) % وقولهم إياه شكر تقودهم % % إليه بفعل لم تشنه خسائسه % % 54(@)(@@) % عوائد عرف يوقظ الشكر نخسه % وكيف ينام الشكر والعرف ناخسه % % 55(@)(@@) % على أنهم من أحسن القول منهم % فمنكومن آثارك امتار هاجسه % % 56(@)(@@) % تعلم ما قد قلته وفعلته % فأهدى جنى الغرس الذي أنت غارسه % % 57(@)(@@) % لئن نفس الأعداء حظك إنه % لحظ جزيل لا يعنف نافسه % % 58(@)(@@) % وإن بخس المطرون حقك إنه % لحق ثقيل لا يظلم باخسه % % 59(@)(@@) % فعش أبدا في خفض عيش وغبطة % وإن رعمت من ذي شقاق معاطسه % % 60(@)(@@) % ولا زلت في يوم ترن قيانه % % فكم لك من يوم أرنت معاجسه % % PageV01P2323 61(@)(@@) % ومعترك ضنك تلوح زجاجه % وتبرق هندياته وقوانسه % % 62(@)(@@) % شهدت فضلت ترهات أخي المنى % % وقفت على آثارهن بسابسه % % 63(@)(@@) % أتاك مدلا والحمام يسوقه % ولم تنهه من قال سوء عواطسه % % 64(@)(@@) % يراني بعين من غرور وباطل % منى من ضلالوالمنايا تشاوسه % % 65(@)(@@) % فلا قال والخطي حولك بينه % % فوارسه كالغيل فيه عنابسه % % 66(@)(@@) % بأرعن جرار عراض صدوره % كثاف نواحيهضخام كرادسه % % 67(@)(@@) % فذيدت أمانيه وهن خوامس % وقد كان مما لا تذاد خوامسه % % 68(@)(@@) % وأورد حوضا ظل عقد وروده % % يجود بماء النفس والبحر قالسه % % 69(@)(@@) % وكم من منى حال المنى دون نيلها % % وظن مدل خاس بالعهد خائسه % 70(@)(@@) % ومن قامس الحوت الملجج مرة % ليقمسه فالحوت لا شك قامسه % % PageV01P2324 71(@)(@@) % وكم لك من ضد أذاقته حتفه % مناصل موت 
ms585	 ناجز ومداعسه % 72(@)(@@) % وآخر نجاه نجاء موائل % إلى عقر دار أنت لا شك جائسه % % 73(@)(@@) % عنيت بأخلاق الزمان تروضها % % ليبأس عاتيهوينعم بائسه % % 74(@)(@@) % منحتكها كالروض جادته ديمة % بكت فوقه حتى تضاحك عابسه % % 75(@)(@@) % غدا بين مفتوق وبين مكمم % مبرنسة قسانه وشمامسه % % 76(@)(@@) % يصلي لقرن الشمس ميلا رؤوسه % % إليها إذا لم يتبع الريح مائسه % % 77(@)(@@) % فطورا توليه المجوس صلاته % وطورا توليه النصارى برانسه % % 78(@)(@@) % على أنه يثني على الله نشره % بنعمى غد إذ لم يزل وهو غارسه % % 79(@)(@@) % حيا جاده وسميه ووليه % % يراوحه طورا وطورا يغالسه % % 80(@)(@@) % إذا لم يصبه وابل طله الندى % % فغادره خضرا حسانا طنافسه % % PageV01P2325 81(@)(@@) % وكنت إذا ما الشعر صينت بناته % حقيقا بأن تجلى عليك عرائسه % % 82(@)(@@) % تقاعس شعري عن سواك فسقته % إليك فأضحى معنقا متقاعسه % % PageV01P2326 البحر : - 1(@)(@@) % ومدامة كحشاشة النفس % لطفت عن الإدراك باللمس % 2(@)(@@) % لنسيمها في قلب شاربها % % روح الرجاءوراحة اليأس % 3(@)(@@) % وتمد في أمل ابن نشوتها % % حتى يؤمل مرجع الأمس % % PageV01P2327 البحر : - 1(@)(@@) % ومهفهف تمت محاسنه % حتى تجاوز منية النفس % 2(@)(@@) % تصبو الكؤوس إلى مراشفه % % وتهش في يده إلى الحبس % 3(@)(@@) % أبصرته والكأس بين فم % منه وبين أنامل خمس % 4(@)(@@) % فكأنها وكأن شاربها % % قمر يقبل عارض الشمس % PageV01P2328 البحر : - 1(@)(@@) % خوان عيسى من نصف ترمسة % وصحفتاه من فلقتي عدسه % 2(@)(@@) % ذلك فضل الإله يمنحه % من شاء لا ذاك حظ من نفسه % 3(@)(@@) % من ذرة ذرة جرادقه % % تخفى على العين فهي ملتمسه % % 4(@)(@@) % لوتحلت بالحرير لآنسربت % % من خلل النسج غير محتبسه % 5(@)(@@) % إذا افترست الرغيف أن له % كأن ليثا هنالك افترسه % 6(@)(@@) % حتى إذاماطفقت تأكله % صعد من فرط حسرة نفسه % 7(@)(@@) % كأنما كل لقمة أكلت % منزوعة من يديه مختلسه % 8(@)(@@) % مغفل عن أمور نسوته % % مذل على بيت خبزه حرسه % 9(@)(@@) % يقتبس الجار ناره فيرى % % نار سراجي هداه مقتبسه % 10(@)(@@) % وإن رأى أو أحس آونة % دخان نار لجاره كبسه % PageV01P2329 البحر : - 1(@)(@@) % لهوت عن وصف الطلول الدارسه % بروضة عذراء غير عانسه % 2(@)(@@) % جادت لها كل سماء راجسه % % رائحة بالغيث أو 
ms586	 مغالسه % % 3(@)(@@) % فأصبحت من كل وشي لابسه % % خضراء ما فيها خلاة يابسه % % 4(@)(@@) % كأنما الألسن عنها لاحسه % % ضاحكة النوار غير عابسه % % 5(@)(@@) % كأنها معشوقة مؤانسه % % فيها شموس للبهار وارسه % % 6(@)(@@) % كأنها جماجم الشمامسه % % ذوي القدود من ذوي القمامسه % % 7(@)(@@) % تروقك النورة منها الناكسه % % بعين يقظى وبجيد ناعسه % % 8(@)(@@) % لؤلؤة الطل عليها قارسه % % وخرم في صبغة الطيالسه % % 9(@)(@@) % يحكي الطواويس غدت مطاوسه % % كأنما تلك الفروع المائسه % % 10(@)(@@) % تغمسها في اللازورد غامسه % % وصفوة النعمان والقوابسه % % PageV01P2330 11(@)(@@) % من ناصع الحمرة ريا قالسه % % تكاد تحت الظلمات الدامسه % % 12(@)(@@) % تهوي إليها كل كف قابسه % % لنعمة الخلة والمجالسه % % 13(@)(@@) % في نفس من شمأل مسالسه % % لينة الهزهاز لا معافسه % % 14(@)(@@) % نضاخة بالطل غير رامسه % % والجد عال والكؤوس كائسه % 15(@)(@@) % دع ذاوذد عنك الهموم الهالسه % % ونهس ذؤبان الخطوب الناهسه % % 16(@)(@@) % بمدره كلتا يديه تارسه % % يأوي إلى عادية قدامسه % % 17(@)(@@) % جذل حكاك في الأمور المائسه % % ذي شهب ترمى بها الأبالسه % % 18(@)(@@) % خلافة الله بها مرادسه % % أقلامه كفء الرماح الداعسه % % 19(@)(@@) % عند الخطوب والحروب الضارسه % % من آل وهب طالت المقايسه % % 20(@)(@@) % وقل لأهل الأعين المشاوسه % % هل نابس يبرز لي أو نابسه % % PageV01P2331 21(@)(@@) % أو هامس يكذبني أو هامسه % % عز القضاء الأيدي المخالسه % % 22(@)(@@) % أضحت وما يندس قولي نادسه % % نفس أبي محمد منافسه % % 23(@)(@@) % في كل مجد وله ملابسه % % وللمساعي دونه ممارسه % 24(@)(@@) % وللوصايا والنهى مدارسه % % وللعلوم كلها مداوسه % % 25(@)(@@) % بل للغيوب في الصدور جائسه % % كأنما السبعة غير الطامسه % % 26(@)(@@) % جارية عن أمرهاوكانسه % % من علمها بالخطرات الهاجسه % % 27(@)(@@) % لاتخطىء المكنون وهي حادسه % % يا لك نفسا ما لها مجانسه % % 28(@)(@@) % بكل وحشى جميل آنسه % % من كل مألوف قبيح شامسه % % 29(@)(@@) % تقوم بالفادح وهي جالسه % % وافية بالعهد غير خائسه % % 30(@)(@@) % مبخوسة في الشكر غير باخسه % % في العرف تسديه ولا مماكسه % % PageV01P2332 31(@)(@@) % كيسة في ذاك لا مكايسه % % ما ركستها في ضلال راكسه % % 32(@)(@@) % ولا تعدت سننا مشاخسه % % ليست لها شريكة مشاكسه % % 33(@)(@@) % من ذاتها بالمنفسات نافسه % نفس كريم للعلا ملامسه % % 34(@)(@@) % وفي الغمار دونها مغامسه 
ms587	 % % فيه سجايا للعطايا ناخسه % % 35(@)(@@) % فوفره في وقعات حامسه % % ووفده في هيسات هائسه % % 36(@)(@@) % نالت يداه كل كف يائسه % % ففات طولا كل كف لامسه % % 37(@)(@@) % ومر يجري والجياد خانسه % % ليست له دون قصي حابسه % % 38(@)(@@) % ولا له دون علي عاكسه % % أشهم من نجم السماء الخامسه % % 39(@)(@@) % أكرم من نجم السماء السادسه % % أذكى حجا من هرمس الهرامسه % % 40(@)(@@) % أنكا شبا من ضيغم خنابسه % % أعذب من صفو النطاف القارسه % % PageV01P2333 41(@)(@@) % من غير أن تبأس منه بائسه % % قد أفلت عنك النجوم الناحسه % 42(@)(@@) % فلا تخف تعس الجدود التاعسه % % قد كذب الله النفوس اليائسه % % 43(@)(@@) % بشيمة منه وكف آئسه % % ما برحت للمكرمات سائسه % % 44(@)(@@) % وللغروس المثمرات غارسه % % غاذية أطفالهن كانسه % % 45(@)(@@) % عين من الله عليها حارسه % % فإنها في كل فضل رائسه % % 46(@)(@@) % دونكها من صنعة الفلافسه % % وانظر أجمتك الأكف الخالسه % % 47(@)(@@) % هل أرضت النحل الشفاه اللائسه % % جزاء ما أضحت وأمست جارسه % % PageV01P2334 البحر : - 1(@)(@@) % قل لأبي سهل الذي ورث الر % روم لطيف العلوم والفرسا % % 2(@)(@@) % أما عهودي فلم تزل حبسا % عليك فاجعل إزاءها حبسا % % 3(@)(@@) % كم وقفة منك كنت أعهدها % % أعتدها حين نلتقي أنسا % % 4(@)(@@) % فما لها بدلت وأعقبها % % ريب يريب الخلائق الشمسا % % 5(@)(@@) % أنت ماحي من مودتنا % % ظلما فأعقب من مأتم عرسا % % 6(@)(@@) % أنت طبيب فلا تكن شكسا % والطب يأبى الخلائق الشكسا % % 7(@)(@@) % ودع ودادا يصح من سقم % ولا تجدد لدائه نكسا % % 8(@)(@@) % عاتبت شحا عليك لا عبثا % كيما أجد المعاهد اللبسا % % 9(@)(@@) % ولم تزل هكذا طريقة من % % ثقف أقواله ومن فرسا % % 10(@)(@@) % معاتب المخلصين ناطقة % ولا أحب المعاتب الخرسا % % PageV01P2335 البحر : - 1(@)(@@) % يا قمر الموكب والمجلس % أفطر على القهوة والنرجس % 2(@)(@@) % أما ترى مونق أنواره % % كأنه الأنوار في الحندس % 3(@)(@@) % سقيا له إن ابتساماته % % تحكي ابتساماتك في المجلس % 4(@)(@@) % ونشره نشرك لكنه % دونك في الأصل وفي المغرس % 5(@)(@@) % وحقه الشرب على وجهه % مع السماع المعجب المنفس % 6(@)(@@) % اشرب عليه إنه مؤنس % وإنه في زمن مؤنس % 7(@)(@@) % في زمن الغيث الذي لم يزل % % يحكيك في 
ms588	 الجودولم أعكس % 8(@)(@@) % واسمع وأسمعنا بما لم تزل % % من شهرنا الظاعن في محبس % 9(@)(@@) % جزاك عنا الله من سيد % مثوبة المربح لا الموكس % 10(@)(@@) % فأي أموالك لم تعطنا % % وأي أنوارك لم تقبس % PageV01P2336 11(@)(@@) % أنت الذي قلت بآلائه % % علما ولم أظنن ولم أحدس % 12(@)(@@) % زاولت تمجيدك في ساعة % فأي معنى فيك لم يهجس % 13(@)(@@) % لكنني قصرت مستيئسا % من نيل شأو فائت مؤيس % % 14(@)(@@) % شأوك إن الله أجراكه % ومن يجاود ربه يفلس % % PageV01P2337 البحر : - 1(@)(@@) % لا تحبسن الكأس فيما تحبس % % واشرب معتقة تضيء وتقبس % 2(@)(@@) % طوت السنين فمات عنها هدرها % % ونسيمها خي لها متنفس % 3(@)(@@) % حياك فطرك بالعروس وبالذي % % يحكيه في النفحات وهو النرجس % % 4(@)(@@) % فاشرب على الحسنين كأسا حسنها % % شكل لحسنهما وتم المجلس % % PageV01P2338 البحر : - 1(@)(@@) % يا أيها الملك السعيد المعرس % لا زلت تخلق ما كساك الملبس % 2(@)(@@) % إن يهد منفسة إليك وليها % % فلقد أتيح لها الكفي المنفس % % 3(@)(@@) % وبحقكم وبحقها قدرت لكم % % ومن الحقوق مبين وملبس % % 4(@)(@@) % من غرس أيديكم جنت أيديكم % كرمت مجانيكم وطاب المغرس % % PageV01P2339 البحر : - 1(@)(@@) % لا تقصدن لحاجة % إلا امرأ فرحا بنفسه % 2(@)(@@) % أنى يسر بمدحه % % من لا يسر بضوء شمسه % 3(@)(@@) % أم كيف يهتز امرؤ % غرض بمهجته وعرسه % % 4(@)(@@) % نكب هديت من الرجا % % ل يوق جدك جل تعسه % % 5(@)(@@) % ممراضهم وذميمهم % % وقريبهم من ورد رمسه % % 6(@)(@@) % وعلى ذوي عاهاتهم % % يوم يدمرهم بنحسه % % 7(@)(@@) % ومشهريهم في الأنا % % م بظلم آملهم وبخسه % % 8(@)(@@) % سخط الإله على أول % % ئك إنهم من شر غرسه % % 9(@)(@@) % وعدا الزمان عليهم % طرا فألحقهم بأمسه % % 10(@)(@@) % فهم الألى ما منهم % أحد يمس ندى بخمسه % % PageV01P2340 11(@)(@@) % للنجم أقرب منهم % من كف ملتمس ولمسه % % 12(@)(@@) % ومتى كسوتهم الهجا % % ء فإنه بهج بلبسه % % 13(@)(@@) % قد عودوا مس الهوا % % ن فما لهم حفل بمسه % % 14(@)(@@) % يفدون كل سميدع % لم يشق سائله بعبسه % % 15(@)(@@) % كأبي المهند إنه % % كيقين راجيه وحدسه % % 16(@)(@@) % ملك يعجل بالعطا % % ء ولا يرى إعمال حبسه % % 17(@)(@@) % وإلى الأجل من الفعا % % ل تراه يجنح لا أخسه % % 18(@)(@@) % يبني 
ms589	 على أساسه % % وقوام بنيان يأسه % % 19(@)(@@) % ألقى هواه على البري % ية إنهم أبناء جنسه % % 20(@)(@@) % ومتى استثير عرامه % % لقي الأسود جهيز فرسه % % PageV01P2341 21(@)(@@) % قبل الجلاد عناقه % وجلاده من قبل دعسه % % 22(@)(@@) % وطعانه قبل النضا % % ل يمر ذلك طول حرسه % % 23(@)(@@) % فترى الليوث هواربا % منه إذا نذرت بجرسه % 24(@)(@@) % وإذا خلا من مغرم % ضخم فذلك يوم وكسه % % 25(@)(@@) % وإذا اجتلى من مدحه % % بكرا فذلك يوم عرسه % % 26(@)(@@) % جعل الإله عليه وا % % قية تقيه مثل بأسه % % 27(@)(@@) % وثنى إليه عن الخلي % % فة وجه ممتاح وعنسه % % 28(@)(@@) % فهما هواه وهمه % % وإمامه من قبل درسه % % 29(@)(@@) % همست إلي بفضله % % آثاره من قبل همسه % % 30(@)(@@) % مثل المغني أنبأت % عن حذقه نغمات جسه % % PageV01P2342 31(@)(@@) % من كان يعكس مدحه % فالمدح فيه بغير عكسه % % 32(@)(@@) % لا يفخرن ذوو العلا % % إن المفاخر تاج رأسه % % PageV01P2343 البحر : - 1(@)(@@) % وخضراء من حوك الربيع شهدتها % % مغيمة شمس اليوم معهودة الأمس % % 2(@)(@@) % سقاها الحيا ثم استحار جهامه % عليها فلم تظمأ ولم تضح للشمس % % PageV01P2344 البحر : - 1(@)(@@) % زفت إلى بدر الدجى الشمس % ولاح سعد وخبا نحس % 2(@)(@@) % وأقبلت نفس إلى منية % بمثلها تغتبط النفس % 3(@)(@@) % سيدة تهدى إلى سيد % لم يمس في سؤدده لبس % % 4(@)(@@) % ذلك عرس الدهر من أجله % % حن غد والتفت الأمس % % PageV01P2345 البحر : - 1(@)(@@) % جفتني أن صددت ولي لديها % % أسيرا ذلة بدن ونفس % 2(@)(@@) % وأغضبها انصراف الطرف عنها % % وفيه علي خسران ووكس % 3(@)(@@) % ولكني عشيت لنور شمس % % ملاحظتي لها سرق وخلس % % 4(@)(@@) % وأنى لي بنظرة مستديم % إذا ما قابلت عيني شمس % 5(@)(@@) % وكم صدت وإن لم أجن ذنبا % وأعقب صدها قطب وعبس % % 6(@)(@@) % فلم أعتب لذاك وإن أضاقت % % علي الأرض حتى قلتحبس % % 7(@)(@@) % أيا شمس النهار سنا وعزا % يقصر عنهما نظر ولمس % 8(@)(@@) % أحل أن تنامي عن سهادي % % ولي مذ بان عني النوم خمس % % 9(@)(@@) % ولم آمل غدا لك فيه عدل % % وإلا قلت خير منه أمس % % 10(@)(@@) % أبش وتعبسين وذاك بخس % وليس يحل في الإسلام بخس % % PageV01P2346 11(@)(@@) % تطيعين الوشاة إذا وشوا بي % % وأكثر قيلهم 
ms590	 دحس وحدس % % 12(@)(@@) % وكم واش وشى بك غير آل % فآب وحظه تعس ونكس % % 13(@)(@@) % أميز كل شيء من أموري % % سوى أمري لديك ففيه لبس % % 14(@)(@@) % أيسفك للوشاة دم ثمين % وقيمة كل ما يحكون فلس % 15(@)(@@) % غرست هوى فربيه بحفظ % فليس يرب بالتضييع غرس % % PageV01P2347 البحر : - 1(@)(@@) % وجهي يرق عن اقتضائك حاجتي % % وإذا سكت نسيت أو تتناسى % % 2(@)(@@) % وإذا اقتضيت مطلتني ولويتني % % فلقيت منك شكاسة ومراسا % % 3(@)(@@) % أعريتني من فضل كفك كله % % يا من جعلت له الثناء لباسا % % 4(@)(@@) % وإخال أني جاعل فمعجل % بيني وبينك عفتي والياسا % % 5(@)(@@) % أطلق أبا العباس وجهك ضاحكا % فلما عهدتك مرة عباسا % % 6(@)(@@) % أعلم ملالك أن نفسي حرة % هجرت أناسا قبله وأناسا % % PageV01P2348 البحر : - 1(@)(@@) % ألوى بقلبك من غصون الناس % غصن يتيه عل غصون الآس % 2(@)(@@) % بل شادن ذو نعمة في نعمة % يكتن منها في أكن كناس % 3(@)(@@) % ظبي يصيد ولا يصاد محاذر % نبل الهوى وحبائل الإيناس % 4(@)(@@) % غر شموس إن أحس بريبة % أعجب بجامع غرة وشماس % 5(@)(@@) % يسبي القلوب بمقلة مكحولة % بفتور غنج لا فتور نعاس % 6(@)(@@) % ومقبل عذب كأن نسيمه % وهنا نسيم منابت البسباس % 7(@)(@@) % أثني عليه بطيب فيه ولم أنل % منه نوالا قط غير خلاس % % 8(@)(@@) % قمر يجود بأن أراه حسرة % ويضن بالإرشاف والإلماس % 9(@)(@@) % يذكي الجوى ويذودني عن مشرب % خصر العلالة للجوى مساس % 10(@)(@@) % وإذا شكوت إليه طول عذابه % % فأقل قاس رحمة لمقاسي % % PageV01P2349 11(@)(@@) % لقد استوى تقويمه ولقد غدا % % لا تستوي حالاه عند قياس % 12(@)(@@) % يتحمل الأوزار لا يعي بها % % في كل مأسور بدار تناسي % % 13(@)(@@) % وإذا خطا أعياه ثقل مؤزر % يرتج تحت موشح مياس % 14(@)(@@) % فتراه يمشي في الدهاس وإنما % % يمشي فيجذبه كثيب دهاس % % 15(@)(@@) % يا للرجال ألا معين لأيد % صب الفؤاد على ضعيف قاس % % 16(@)(@@) % أيضيمني خنث الشمائل لو نضا % % عنه غلالته حساه حاس % % 17(@)(@@) % ومن العجائب أن تحل ظلامة % بفتى أناس من فتاة أناس % % 18(@)(@@) % ولقد ينال من القوي ضعيفه % ككليب الطاغي وكالجساس % % 19(@)(@@) % إن أصل من ناري هواه وهجره % % ما 
ms591	 قد أمل حديثه جلاسي % % 20(@)(@@) % فقد اصطلى ناري هوى وعقوبة % % قبلي سحيم في ابنة الحسحاس % % PageV01P2350 21(@)(@@) % إن الكتابة أصبحت عربية % زهراء ترغب عن بني الأكداس % % 22(@)(@@) % خطبت شريفا طاهرا وتنزهت % % عن أدنياء علمتهم أرجاس % % 23(@)(@@) % قد كانت الأقلام في أيامهم % % حمرا فعادت أيما أفراس % % 24(@)(@@) % تجري إلى الغايات في حلباتها % % وتجوس دار الكفر كل مجاس % 25(@)(@@) % بأغر أبلج لم تزل أيامه % مشغولة بالكيس لا بالكاس % % 26(@)(@@) % بين الحداثة والرثاثة سنه % وكذاك سن البازل القنعاس % % 27(@)(@@) % لقي التجارب غانيا عن عونها % % بقريحة أذكى من النبراس % % 28(@)(@@) % ذاك الذي استكفاه رعية أمره % % كافي الخلائف من بني العباس % % 29(@)(@@) % فغدا له في زينه وغنائه % % كالعين وهي أعز ما في الراس % % 30(@)(@@) % ألقى مراسيه لديه وما له % % إلا المحبة والوفاء مراسي % % PageV01P2351 31(@)(@@) % يمضي مكائده إلى أعدائه % % كالنبل صادرة عن الأعجاس % 32(@)(@@) % بل كالمقادر إن تحصن دونها % % متحصن هجمت مع الأنفاس % % 33(@)(@@) % لله إسماعيل واحد عصره % % من جارح في النائبات وآس % % 34(@)(@@) % المستضاء الوجه في بهم الدجى % % والمستضاء الرأي في الأبئاس % % 35(@)(@@) % تجري الأمور على السداد إذا جرت % % أقلامه في ساحة القرطاس % % 36(@)(@@) % أقلام ميمون النقيبة حازم % يجرين بالإنعام والإبئاس % % 37(@)(@@) % ما انفك يرعفها دما ويمجها % % عسلا مدادهما من الأنفاس % % 38(@)(@@) % يا سائلي عنه سألت عن امرىء % تلقاه وهو من الفضائل كاس % % 39(@)(@@) % تلقى مغيما مشمسا في حالة % هطل الإغامة نير الإشماس % % 40(@)(@@) % فلنا ندى من كفهولنا هدى % من رأيه في الليل ذي الأغباس % % PageV01P2352 41(@)(@@) % ما ضر مهتديا به في حندس % عدم الهداة وغيبة الأقباس % % 42(@)(@@) % ماء بلا رنق إذا ما استعرضت % % أخلاقهنار بغير نحاس % % 43(@)(@@) % جمع السلامة والشهامة إنه % % شخص يحوز محاسن الأجناس % % 44(@)(@@) % لذكاؤه لهب الحريقوحلمه % أندى وأبرد من ندى الأغلاس % % 45(@)(@@) % وترى شهيدا ظاهرا من جوده % % بمغيب من جوده هجاس % % 46(@)(@@) % قد قلت حين رأيت باطن كفه % % أندى من المتحلب الرجاس % % 47(@)(@@) % ورأيت جمرة ذهنه ولهيبها % % في ساعة التبليد والإبلاس % % 48(@)(@@) % عجبا لأقلام الوزيروكيف لا % % تستبدل الإيراق بالإيباس % % 49(@)(@@) % بل كيف لا 
ms592	 تأتج في آلاته % % نيران هاجسة بغير مساس % % 50(@)(@@) % لحققن أن يورقن من ذاك الندى % % أو يحترقن بذلك المقباس % PageV01P2353 51(@)(@@) % قدمه إن ذكر المكارم ذاكر % فحظوظه منهن غير خساس % % 52(@)(@@) % قصد المحامد حين أكسد تجرها % % فابتاع كاسدها بغير مكاس % % 53(@)(@@) % ورأى العلا مهجورة فأوى لها % % وحنى عليها والقلوب قواس % % 54(@)(@@) % وأما وإسماعيل حلفة صادق % راعي الرعاة وسائس السواس % % 55(@)(@@) % لولا شجاعته لهاب طريقة % خشناء مقفرة من الأناس % % 56(@)(@@) % ولمثله ركب المهيبة وحده % وتحمل العظمى بغير مواس % % 57(@)(@@) % فيه اثنتان يقل من يحويهما % % في دهرنا ويجل في المقياس % % 58(@)(@@) % ينسى صنيعته ويذكر وعده % أكرم بذلك من ذكور ناس % % 59(@)(@@) % أضحت به الدنيا رياضا كلها % % والدهر كالأعياد والأعراس % % 60(@)(@@) % وكأنما آباؤه وجدوده % نشروا به طرا من الأرماس % PageV01P2354 61(@)(@@) % برجائه اكتست الركاب رحالها % % وبجوده عريت من الأحلاس % % 62(@)(@@) % صرف السماع نوى المقلد نحوه % وحدا القياس إليه بالقياس % % 63(@)(@@) % فكلاهما صدقته عنه شهوده % واستبدل الإدراك بالإيجاس % % 64(@)(@@) % عند امرىء حرس الأنام بحزمه % % وكأن ثروته بلا أحراس % % 65(@)(@@) % يا أيها الغيث الذي بغياثه % % أضحت عواري الأرض وهي كواس % % 66(@)(@@) % أنا من سؤالك بين ميسور الغنى % % لا شك فيهوبين ملك الياسص ستنيلني الآمال أو ستردني % % 67(@)(@@) % ملكا بيأس من جميع الناس % % من ذا تخيبه فتطمع نفسه % 68(@)(@@) % في رفد غيرك آخر الأحراس % % أم من تهش له فيرجف قلبه % 69(@)(@@) % خوف المفاقر غير ذي وسواس % % أعتقت من أعطيته وحرمته % 70(@)(@@) % من مطمع أبدا ومن إفلاس % % من تعطه يسعد ومن لا تعطه % % PageV01P2355 71(@)(@@) % يسعد بصونكه عن الأدناس % وكذا الكريم حباؤه وإباؤه % 72(@)(@@) % أمران ما بكليهما من باس % % وهاب يأس أو إياس منفس % 73(@)(@@) % ولرب يأس قد وفى بإياس % % والرفد يمنحه الفتى حظا له % % 74(@)(@@) % واليأس يكساه أعز لباس % % أنت الذي إن جاد عادوإن أبى % % 75(@)(@@) % ترك الكذاب لمعشر أنكاس % % يعدون راجيهم مواعد لا يني % % 76(@)(@@) % منهن في تعب وطول مراس % % ويدر درك للألى يبغونه % 77(@)(@@) % عفوا بلا مسح ولا إبساس % % مهما أتيت فأنت فيه مسدد % 78(@)(@@) % سهم الصواب لكفة 
ms593	 البرجاس % % فالناس من تكرار وصفك بالحجا % % 79(@)(@@) % ومن الثناء عليك في مدراس % % من قائل اكرم به أو قائل % % 80(@)(@@) % أحزم به في المتح والإمراس % % إلا عدوا أخرسته ضغينة % PageV01P2356 81(@)(@@) % لا زال منها الدهر في إخراس % % ولقد أقول لحاسد لك لن يرى % % 82(@)(@@) % عتبي سوى الإرغام والإتعاس % % ما أنت ويبك من أبي الصقر الذي % % 83(@)(@@) % تركت تعاطيه منى الأكياس % % سلم لإسماعيل إني ناصح % 84(@)(@@) % لك واله عن وسواسك الخناس % % حاول معاطفه فهن نواعم % 85(@)(@@) % واترك مكاسره فهن عواس % % وكذا عهدتك لينا ذا ميعة % 86(@)(@@) % يسر الخلائق محصد الأمراس % % ممن تراعى الوحش حول فنائه % % 87(@)(@@) % وتراع منه الأسد في الأخياس % % يهتز عودك للنسيم وإن جرت % % 88(@)(@@) % نكبا معصفة فعودك عاس % % وتخف للداعي اللهيف وإن بدا % % 89(@)(@@) % روع يخف له فطودك راس % % كم خف نهضك للدعاة وكم رست % 90(@)(@@) % قدماك في يوم عراك عماس % لك عدل ذي تقوى وظلم أخي ندى % % PageV01P2357 91(@)(@@) % لا ظلم غصاب ولا بخاس % % فإذا وهبت ظلمت مالك محسنا % 92(@)(@@) % وإذا حكمت وزنت بالقسطاس % % إن كنت يوما مدركي بإغاثة % 93(@)(@@) % فاليوم يا ابن السادة الرواس % % أنا بين أظفار الزمان وخائف % % 94(@)(@@) % منه شبا الأنياب والأضراس % % والنائبات لمن نسيت ذواكر % 95(@)(@@) % لكنهن لمن ذكرت نواس % % فامنن علي بنظرة تنجي بها % % 96(@)(@@) % شلوي من الفراسة النهاس % % فكم اشتليت من امرىء مستلحم % 97(@)(@@) % وفرست من مستأسد فراس % % وهب الإله لما بنيت من البنا % % 98(@)(@@) % شرف الذرى ووثاقة الآساس % % خذها وإن قلت لمثلك تحفة % 99(@)(@@) % من فاخرات ملابس اللباس % % إن شئت قلت مليحة ما ضرها % % 100(@)(@@) % أن لم يقلها المكتني بنواس % % أو شئت قلت جميلة ما عابها % % PageV01P2358 101(@)(@@) % أن لم يقلها المكتني بفراس % % يا حسنها بكرا وعند ولادها % % 102(@)(@@) % ما أنت مانحها وذات نفاس % % هل أنت ذاكر موعد قدمته % 103(@)(@@) % أم أنت ناس ذاك أم متناس % % بي من درورك واختصاصك جانبي % % 104(@)(@@) % بالجدب حر صلا وحز مواس % % طال الغليل وقد سقيت معاشرا % 105(@)(@@) % دوني وما صبروا على الإخماس % % ن % PageV01P2359 البحر : - 1(@)(@@) % ما نكهت في 
ms594	 مجلس شنطف % إلا خشينا قتلها نفسا % % 2(@)(@@) % مقصوعة الخلقة دحداحة % % تطرحها القلة في المنسا % % 3(@)(@@) % نكهتها تقتل جلاسها % % لقرب مفساها في المحسى % % 4(@)(@@) % واسعة الثقبين بغاءة % قد أقطعت بيعتها القسا % % 5(@)(@@) % خافت على عذرتها غيلة % فاتخذت فقحتها ترسا % % 6(@)(@@) % وإن تشاجت سمعت هاتفا % يهتف من خلف بها تعسا % % 7(@)(@@) % تالله أدري عند إبذارها % % أأبذرت أم أندرت جعسا % % 8(@)(@@) % أندر لها ضرسا إذا أبذرت % % بل لاتدع في فمها ضرسا % % 9(@)(@@) % أغضبني الشعر فعاقبته % بوجهها فاعتده حبسا % % PageV01P2360 البحر : - 1(@)(@@) % أشجتك أطلال لخو % % لة كالمهارق درس % 2(@)(@@) % أودت بهن الباكيا % % ت الضاحكات الرجس % 3(@)(@@) % والعاصفات القاصفا % % ت المعصرات الرمس % 4(@)(@@) % ما إن بها إلا الجآص ذر والظباء الكنس % % ولقد تحل بها الحسا % % 5(@)(@@) % ن القاصرات الأنس % من كل رود كالقضي % % 6(@)(@@) % ب نماه دعص أوعس % خود لها وجه علي % % 7(@)(@@) % ه من القسامة ملبس % كالبدر حفته السعو % % 8(@)(@@) % د وغاب عنه الأنحس % ولها غدائر حلك % 9(@)(@@) % فوق الروادف ميس % ولها وشاح جائل % 10(@)(@@) % زجل وحجل أخرس % % وكأنما يرنو بمق % % PageV01P2361 11(@)(@@) % لتها غزال أعيس % % ذعرته نبأة قانص % 12(@)(@@) % فله لذاك توجس % % حتى متى تبكي الديا % % 13(@)(@@) % ر وفرع رأسك مخلس % % هل يرجع الدمع الذي % % 14(@)(@@) % سلبته عنك الأحرس % % قولا لدبس شر من % % 15(@)(@@) % يطأ التراب ويرمس % % تبا لدهر أنت في % % 16(@)(@@) % ه مقدم ومرأس % % لو أن إبليسا رآ % % 17(@)(@@) % ك لكاد ذعرا يبلس % % ولراعه وجه من الت % 18(@)(@@) % تحسين قيء أملس % % وكأن صوتك حين تص % % 19(@)(@@) % دح صوت رعد يرجس % % فإذا صدحت مؤذنا % 20(@)(@@) % كادت تموت الأنفس % % وترت قلوب العالمي % % PageV01P2362 21(@)(@@) % ن ضعيفها والأليس % % ودعوا عليك بقاصما % % 22(@)(@@) % ت في الظهور تؤيس % % فكأنما دعوات من % % 23(@)(@@) % يدعو جميعا تنكس % % وإذا مررت فللأنا % % 24(@)(@@) % م إليك طرف أشوس % ووجوه من يلقاك من % % 25(@)(@@) % هم قاطبات عبس % % فطوال دهرك أنت مش % % 26(@)(@@) % توم وعرضك أدنس % % وإذا جلست أذى خشا % % 27(@)(@@) % مك من يضم المجلس % % فكأنما الكرياس ين % % 28(@)(@@) % فخ منك حين تنفس % % وإذا نهضت كبا بوج 
ms595	 % % 29(@)(@@) % هك للجبين المعطس % فالأنف منك لعظمه % % 30(@)(@@) % أبدا لرأسك يعكس % حتى يظن الناس أن % PageV01P2363 31(@)(@@) % نك في التراب تفرس % ولأنت أجدر بالذي % % 32(@)(@@) % قال الفتى المتنطس % % إن كان أنفك هكذا % % 33(@)(@@) % فالفيل عندك أفطس % يا من له في وجهه % % 34(@)(@@) % أزج عليه مكنس % ما إن رأينا عاطسا % 35(@)(@@) % بأبي قبيس يعطس % وإذا جلست على الطري % % 36(@)(@@) % ق ولا أرى لك تجلس % قيل السلام عليكما % % 37(@)(@@) % فتجيب أنت ويخرس % خذها إليك طما بها % % 38(@)(@@) % متلاطم متبجس % شنعا شوارد كالسها % % 39(@)(@@) % م جبارها لا تدرس % كشفت عيوبك مثل ما % % 40(@)(@@) % كشف الظلام المقبس % ن % % PageV01P2364 البحر : - 1(@)(@@) % أيركب عمر حوله من يحفه % ويعوزني قوت أعول به عرسي % % 2(@)(@@) % كذبت لقد أغنى عفاتي قاسم % % وإني لأعطي الحق ما حملت خمسي % % 3(@)(@@) % سوى أنني أشكو إذا ما امتدحته % فضائل تعييني وتعيي بني جنسي % % 4(@)(@@) % وإيعاده إياي منه وقد صفت % ظلالي ولم تذمم سجاياه في غرسي % % 5(@)(@@) % هو الشمس يغشاني سناها ونفعها % % وتعجز لمسي حين يطلبها لمسي % % 6(@)(@@) % صفا وجفا واشتد وجدي بقربه % وفي دينكم ضربي وفي دينكم حبسي % % 7(@)(@@) % وإني لأرجو أن ينكر منعما % على زمن قد طال إعماله بخسي % % PageV01P2365 البحر : - 1(@)(@@) % قل للأمير وما بالحق من باس % دع عنك ضربك أخماسا لأسداس % 2(@)(@@) % من اثنتين فلا تبخل بواحدة % إما النوال وإما راحة الياس % % PageV01P2366 البحر : - 1(@)(@@) % طاب نيروزك في يوم الخميس % وجرى مجرى سعيد لا نحيس % 2(@)(@@) % لم يكن إلا سرورا كله % وحبورا وحباء للجليس % % 3(@)(@@) % ظل معروفك ينهل لنا % % من يمينيك نفيسا من نفيس % % 4(@)(@@) % فصل النيروز واشفع وتره % بأخ وامنن عليه بأنيس % % 5(@)(@@) % والبس النعمى جديدا ثوبها % % أو ترى نفسك في العمر اللبيس % % 6(@)(@@) % مصغيا نحو الملاهي ناعما % بين أشباه المها والخندريس % % 7(@)(@@) % يا بني وهب غدت نعماؤكم % % قد ثوت في داركم مثوى حبيس % % 8(@)(@@) % ما لها عنكم زوال أبدا % فأمنوا من روعة اليوم البئيس % % 9(@)(@@) % نحوكم تجري الأحاظي كلها % % وإليكم تنتهي أخرى العجيس % % 10(@)(@@) % فالبسوها وامنحونا فضلها % % يا بني كل رئيس 
ms596	 لرئيس % % PageV01P2367 البحر : - 1(@)(@@) % يرجف القرد بأني % % زائل العقل موسوس % 2(@)(@@) % حاول القرد لعمري % % عكس أمر ليس يعكس % 3(@)(@@) % أتراه يتظنى % % أن عين الشمس تطمس % % 4(@)(@@) % إن أوسوس فحقيق % يسعد القرد وأنحس % % 5(@)(@@) % أصبح الناشىء ممن % % يتغنى وهو أخرس % % 6(@)(@@) % نافقا عند أناس % تعسوا والدهر أتعس % % 7(@)(@@) % قل له عني وإن أص % % بحت أطرى وأكيس % % 8(@)(@@) % ته على الدهر وقل ما % % شئت واظلم وتغطرس % % 9(@)(@@) % لم يقدس منك شيء % ولك الجد المقدس % % 10(@)(@@) % كيف لا يشتد وس % واسي وأشعارك تدرس % % PageV01P2368 11(@)(@@) % وضياء الشمس لا يق % بس والظلماء تقبس % % 12(@)(@@) % لم أكن أنفس شيئا % وعلى مثلك أنفس % % 13(@)(@@) % قيل لي إنك شعر % % ت فضاق المتنفس % % 14(@)(@@) % ثم عزيت فؤادي % % بعدما حار وأبلس % % 15(@)(@@) % قلت إنا لبخير % إن أخونا لم يفرس % % 16(@)(@@) % ما اقتنى مثلك دهر الس % سوء إلا حين أفلس % % PageV01P2369 البحر : - 1(@)(@@) % سهل عندي خلتي أنني % % طال على خسفكم محبسي % % 2(@)(@@) % فالآن ما استجشأت من مطعمي % % عندي وما استخشنت من ملبسي % % 3(@)(@@) % جزيتم عن طيب ما أغتذي % % خيرا وعن نعمة ما أكتسي % % 4(@)(@@) % أعجب بأن رويتم غلتي % % ومن سوى منهلكم أحتسي % % 5(@)(@@) % كم من أناس أملوا فضلكم % % محرسهم أضيق من محرسي % % 6(@)(@@) % ومن أيادي فضلكم أنكم % % لا تعدموني من به أأتسي % % 7(@)(@@) % لا شيء إلا ذمكم وحده % أصبح معمورا به مجلسي % % 8(@)(@@) % قست بما ألقاه من ظلمكم % % فقري وما أخطأت في مقيسي % % 9(@)(@@) % فكان مس الفقر فيما أرى % % ألين إرغاما على معطسي % % PageV01P2370 البحر : - 1(@)(@@) % وشمول أرقها الدهر حتى % % ما توارى قذاتها بلبوس % % 2(@)(@@) % وردة اللون في خدود الندامى % % وهي صفراء في خدود الكؤوس % % 3(@)(@@) % سهلة في الحلوق لا غول فيها % % وهي خشناء صعبة في الرؤوس % % 4(@)(@@) % وكأن الشعاع منها على الكف % ف جساد على مداك عروس % % 5(@)(@@) % تتلقى بالعبس وهي تحيي % % بنسيم فيه حياة النفوس % % 6(@)(@@) % لطفت فاعتدت تحل من الأج % ساد من لطفها محل النفوس % % 6(@)(@@) % جمعت آيتينمحيية طو % % را وطورا مميتة للنفوس % % 6(@)(@@) % سقط بيتين جمعت آيتينمحيية طورا وطورا مميتة 
ms597	 للنفوس لطفت فاعتدت تحل من الأج ساد من لطفها محل النفوس % % PageV01P2371 البحر : - 1(@)(@@) % ما في حياة عبيد الله منفعة % عندي سوى أنه تعويذ عباس % 2(@)(@@) % يرد عنه عيون الحاسدين له % % وكل سحر ووسواس وخناس % % 3(@)(@@) % عليه وجه يرد العين خاسئة % والعين تفلق متن الجندل القاسي % % 4(@)(@@) % شتان ما بين عباس وصاحبه % % في الفضل والخير عند الله والناس % % 5(@)(@@) % فالله يفديه من كأس المنون به % % فوجهه آثر الوجهين بالكاس % % PageV01P2372 البحر : - 1(@)(@@) % رأيت أباك الخير شق من اسمه % % لك اسمك إذ قال القوابل فارس % 2(@)(@@) % طلعت عليه يوم تمك طلعة % مباركة لم تحتضرها المناحس % 3(@)(@@) % فلما رأى فيك النجابة محضة % كساك من الأسماء ما هو لابس % % 4(@)(@@) % وزادك حرفا لا يراه مميز % يخالف بين اسميكما بل يجانس % 5(@)(@@) % تقاربتما في اسميكما وكذا كما % % تكونان في المعنى إذا قاس قائس % PageV01P2373 البحر : - 1(@)(@@) % رأيت خضاب المرء عند مشيبه % % حدادا على شرخ الشبيبة يلبس % 2(@)(@@) % وإلا فما يغري امرءا بخضابه % % أيطمع أن يخفى شباب مدلس % 3(@)(@@) % وكيف بأن يخفى المشيب لخاضب % وكل ثلاث صبحه يتنفس % 4(@)(@@) % وهبه يواري شيبه أين ماؤه % وأين أديم للشبيبة أملس % PageV01P2374 البحر : - 1(@)(@@) % عجب الجاهلون أن أبصروه % نزه الناس في بساتين رأسه % 2(@)(@@) % كيف لو أبصروه وهو مجد % يعمل الكف في مصافع نفسه % % 3(@)(@@) % قلت للسائلي عن غضبي كا % % ن علي وعن قلاي لعرسه % % 4(@)(@@) % ضرطت عرسه على رأس أيري % % فتوهمت أن ذاك بدسه % % PageV01P2375 البحر : - 1(@)(@@) % أرى خالدا يرمي صفاتي عداوة % ويشتم عرضي سادرا في المجالس % 2(@)(@@) % ولو كان من قحطان حقا كما ادعى % % لما جاز أن ينسى أيادي فارس % % 3(@)(@@) % أخالد لم ناقضت أصلك ضلة % وقد كنت شيخا عالما بالمقايس % % 4(@)(@@) % أتنمى إلى قحطان ثم تسبني % % ضللت سبيل الأدعياء الأكايس % % 5(@)(@@) % هجرت المسيغي الماء قحطان بعدما % % لقوا من أبي يكسوم إحدى الدهارس % % 6(@)(@@) % ولو كنت ذا طب بتصحيح دعوة % بكيت على أصدائهم في النواوس % % PageV01P2376 البحر : - 1(@)(@@) % عجب الشيخ خالد من أناس % يعكسون الأمور أعجب عكس % 2(@)(@@) % أنكروا أن يكون مسلك 
ms598	 أير % ثقبة لا تزال مسلك جعس % % 3(@)(@@) % لكن الشيخ خالد يحبس الأص % % لع فيها برغمهم أي حبس % 4(@)(@@) % ويرى أن رفع أم سويد % فوق مقدارها مهانة نفس % PageV01P2377 البحر : - 1(@)(@@) % ماذا يريد الناس من خالد % وثقل قرنيه على رأسه % 2(@)(@@) % اصبحت قنعت الكتابة خزية % قد كان قنعها أبوك الهندسة % % 2(@)(@@) % فليبعد الله الكتابة انها % % لا شك إذ قبلتك غير مقدسة % % 2(@)(@@) % تكنى أبا يعلى ولست باهلها % % ما لم يقلها القائلون منكسه % % 2(@)(@@) % دنست يا ابن أبي امية كنية % غنيت زمانا وهي غير مدنسه % % 2(@)(@@) % كاملتالله با ابن أبي أمية قل لنا % % إن كنتض مسعدة فأين المنحسه % % 2(@)(@@) % هل نقموا منه سوى جوده % % ويب نفس فيه عن عرسه % % 2(@)(@@) % أليس فيهم رجل منصف % فينصف البائس من نفسه % % 2(@)(@@) % قد ولعوا بالشيخ يؤذونه أليس فيهم رجل منصف فينصف البائس من نفسههل نقموا منه سوى جودهويب نفس فيه عن عرسه كاملتالله با ابن أبي أمية قل لنا إن كنتض مسعدة فأين المنحسهدنست يا ابن أبي امية كنيةغنيت زمانا وهي غير مدنسه تكن % % عجله الله إلى رمسه % % 2(@)(@@) % الرجزصدا عن الأطلال لما استيأسا % % من أن تحير النطق أو أن تنبسا % % PageV01P2378 3(@)(@@) % خوفا على أدوائه أن تنكسا % % بل ذو الحجى لا يستحير أخرسا % % 4(@)(@@) % إلا إذا استجهله فرط الأسى % % لا يحرم الله الطلول الدرسا % % 5(@)(@@) % سقيا ترديهن نورا أملسا % % أقاحيا أو حنوة أو نرجسا % % 6(@)(@@) % تكاد رياه إذا تنفسا % % تنشيء في تلك الموات أنفسا % % 7(@)(@@) % تربه الأنوار ربا مرغسا % % بكل محموم الظلال أغبسا % % 8(@)(@@) % إذا أضاء البرق فيه أرجسا % % إن لم يؤب جنح الظلام غلسا % % 9(@)(@@) % فقد لهونا بالطلول أحرسا % % أيام يؤوين الظباء الأنسا % % 10(@)(@@) % والدهر يجني أنعما وأبؤسا % % أنا ابن أعلى كل من تفرسا % % 11(@)(@@) % بيتا وأزكاهم ثرى ومغرسا % % والوارث المجد الطويل مقيسا % % 12(@)(@@) % والباع والعز التليد الأقعسا % % عن كل وضاح يجلي الحندسا % % PageV01P2379 13(@)(@@) % تمم بي من مجده ما أسسا % % فأيها الملقي علي الأحلسا % % 14(@)(@@) % شمس الضحى أبرع من أن تطمسا % % يعقوب لاقيت هزبرا مفرسا 
ms599	 % % 15(@)(@@) % يزيده عض الحروب حمسا % % تنجاب عنه الغمرات أملسا % % 16(@)(@@) % يخاله القرن إذا تشرسا % % يدير في المحجر منه قبسا % % 17(@)(@@) % يستوقف الألف إذا تبهنسا % % حجرا على الآساد حيث عرسا % % 18(@)(@@) % أذاك أم قرن صيال أسوسا % % لا ممتطى الظهر ولا مخيسا % % 19(@)(@@) % أصيد يأبى رأسه أن يعكسا % % أهوج إن وزعته تغطرسا % % 20(@)(@@) % يغشى الفحول البزل بركا مهرسا % % إذا أحس البكر منه جرسا % % 21(@)(@@) % لط العسيب باسته واخرمسا % % أذاك أم كبش نطاح أرأسا % % 22(@)(@@) % يولي الكباش هامة كروسا % % يهوين منها للرؤوس كوسا % % PageV01P2380 23(@)(@@) % كأنما يصدمن منها عرمسا % % أعيت على الرادين أن تؤيسا % % 24(@)(@@) % حتى تراها بالجريض نسسا % % سكرى وما باتت تعل الأكؤسا % % 25(@)(@@) % أذاك أم أفعى نآدا دهرسا % % أملت له الأحداث حتى عنسا % % 26(@)(@@) % ببطن واد وحدا فيه خسا % % ما بض واديه ندى ولا اكتسى % % 27(@)(@@) % نبتا لدن آواه إلا أيبسا % % إذا استدر في المشيب وسوسا % % 28(@)(@@) % وسوسة الحم إذا تحسحسا % % يعجل من أنحى عليه المنهسا % % 29(@)(@@) % من أن يرجي البرء أو أن ييأسا % % أو أن يراعي الجاريات الخنسا % % 30(@)(@@) % بل شاعرا ثبت المقام أحوسا % % مردى بأمثال القوام مردسا % % 31(@)(@@) % يرسلهن نقرسا فنقرسا % % تقرو القبور مرمسا فمرمسا % % 32(@)(@@) % حتى يوافين العجوز المومسا % % أمك والشيخ اللئيم معطسا % % PageV01P2381 33(@)(@@) % لا بورك الزوجان بل لا قدسا % % يا ابن السفاح يقنا لا محدسا % % 34(@)(@@) % وابن التي لم يلق من تحسسا % % أروض منها للزنا وأسوسا % % 35(@)(@@) % ريا بماء غصنها حتى عسا % % تبيع من أربحها وأوكسا % % 36(@)(@@) % سيان من أسنى لها وخسسا % % ثم أعدت كسبها المحبسا % % 37(@)(@@) % فادخرت منه الرغيب المنفسا % % لترغب المقتر فيه المفلسا % % 38(@)(@@) % إذا تحنى ظهرها وقوسا % % ولم ير الزناة فيها ملبسا % % 39(@)(@@) % كذاك تلقى الحول المجرسا % % يأخذ من ليانه لما قسا % % 40(@)(@@) % تفري الغراميل إذا الليل غسا % % أحوق يقذي مشفراه نجسا % % 41(@)(@@) % أوسع من طوق الرحا وأسلسا % % يبلع ما يبلع حوت يونسا % % 42(@)(@@) % لو انتحاه سهم أعمى قرطسا % % أين عسى يعدل عنه لاعسا % % PageV01P2382 43(@)(@@) % تكاد من غلمته أن تسلسا % % إذا اعترى النوم العيون النعسا 
ms600	 % % 44(@)(@@) % أجسمها جوف الدجى أن تهمسا % % كأنما أرقها داء النسا % % 45(@)(@@) % حتى تلاقي بعض من تعسسا % % سكران ليل عابرا أو حرسا % % 46(@)(@@) % لو فرشوها الجندل المضرسا % % إذا لخالته هناك السندسا % % 47(@)(@@) % لاقت بعينيك الأيور الدحسا % % فقذفت منك بأعمى أطمسا % % 48(@)(@@) % يرى النهار ظلمات دمسا % % واستخلفت بنتك تعسا أتعسا % % 49(@)(@@) % متى تلاق الراهب المبرنسا % % تقبض عليه قبض رام معجسا % % 50(@)(@@) % حتى إذا كان حرا أن يقلسا % % وانتفجت أوراده واقعنسسا % % 51(@)(@@) % كعنق الهيق إذا توجسا % % ورضيته منظرا وملمسا % % 52(@)(@@) % ردته في أرحامها مكوسا % % فلو رآها شيخها ما عبسا % % PageV01P2383 53(@)(@@) % وقال بوركت كميا مدعسا % % تنوقا بوركتما تنطسا % % 54(@)(@@) % وبالرفاء والبنين أعرسا % % دونكها تكسوك ثوبا أطلسا % % 55(@)(@@) % يخاوض المجلس فيها المجلسا % % ما أقمر ابنا أبد واشمسا % % 56(@)(@@) % لو استعنت في المعاني هرمسا % % أو استجشمت في الكلام فقعسا % % 57(@)(@@) % كي يصرخاك مثلها لأبلسا % % ن % PageV01P2384 البحر : - 1(@)(@@) % سلالة نور ليس يدركه اللمس % إذا ما بدا أغضى له البدر والشمس % 2(@)(@@) % به أمست الأهواء يجمعها هوى % % كأن نفوس الناس في حبه نفس % PageV01P2385 البحر : - 1(@)(@@) % لله وراق مررنا به % % في صف أصحاب القراطيس % 2(@)(@@) % من أصبر الناس على صفعه % % كأنها وقعة فطيس % % PageV01P2386 البحر : - 1(@)(@@) % قل للأمير إذا مثلت له % % يا ركن أهل إقامة الخمس % 2(@)(@@) % يهنيك أن الفطر حين بدا % % نشر السرور به من الرمس % 3(@)(@@) % نطقت بنات اللهو فيه معا % من بعض خفض الصوت والهمس % 4(@)(@@) % وجرى لنا فلك الكؤوس به % % فأمات هم النفس ذي الهجس % 5(@)(@@) % ومن السعادة أن رأيت أبا ال % % عباس ملء العين والنفس % 6(@)(@@) % سلفت فيه فراسة صدقت % فحمدت ما سلفت بالأمس % 7(@)(@@) % أجنى جنى طابت مذاقته % إذا كان غرس مبارك الغرس % 8(@)(@@) % كم فيه من جدية عذرت % مشتق كنيته من العبس % 9(@)(@@) % ومحامد نادت مسميه % % تالله ما سميت بالعكس % 10(@)(@@) % فاسعد بطول حياته أبدا % يفضي به حرس إلى حرس % PageV01P2387 11(@)(@@) % واشرب على رغم العدو وما % % يلقاه من تعس ومن نكس % 12(@)(@@) % كأسا كأنك حين تشربها % % قمر يقبل عارض الشمس % 13(@)(@@) % مشمولة كالمسك 