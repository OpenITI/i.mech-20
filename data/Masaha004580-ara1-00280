)(@)(@@)(@@)(@@) ||| 172(@)(@)(@@) @HAD017 لا ترغب في خلطة الملوك فإنهم يستكثرون من الكلام رد السلام ويستقلون من العقاب ضرب الرقاب(@)(@)(@@)(@@)(@@) ||| 173(@)(@)(@@) @HAD06 لا تسيء الخطاب فيسوئك نكير الجواب(@)(@)PageV01P753(@)(@)(@@)(@@)(@@) ||| 174(@)(@)(@@) @HAD07 لا تسرعن إلى بادرة وجدت عنها مندوحة(@)(@)(@@)(@@)(@@) ||| 175(@)(@)(@@) @HAD09 لا تطلبن طاعة غيرك وطاعة نفسك عليك ممتنعة(@)(@)(@@)(@@)(@@) ||| 176(@)(@)(@@) @HAD019 لا تعجلن إلى صديق واش وإن تشبه بالناصحين فإن الساعي ظالم لمن سعى به غاش لمن سعى إاليه(@)(@)(@@)(@@)(@@) ||| 177(@)(@)(@@) @HAD09 لا يمنعكم رعاية الحق لأحد عن إقامة 
ms279	 الحق عليه(@)(@)(@@)(@@)(@@) ||| 178(@)(@)(@@) @HAD09 لا يستنبط إجابة دعائك وقد سددت طريقه بالذنوب(@)(@)(@@)(@@)(@@) ||| 179(@)(@)(@@) @HAD09 لا تحارب من يعتصم بالدين فإن مغالب الدين محروب(@)(@)(@@)(@@)(@@) ||| 180(@)(@)(@@) @HAD09 لا تغالب من يستظهر بالحق فإن مغالب الحق مغلوب(@)(@)(@@)(@@)(@@) ||| 181(@)(@)(@@) @HAD016 لا تأمنن ملولا وإن تحلى بالصلة فإنه ليس في البرق الخاطفة مستمتع لمن يخوض الظلمة(@)(@)(@@)(@@)(@@) ||| 182(@)(@)(@@) @HAD011 لا يكون المضمون لك طلبه أولى بك من المفروض عليك عمله(@)(@)(@@)(@@)(@@) ||| 183(@)(@)(@@) @HAD018 لا تمهر الدنيا دينك فإن من أمهر الدنيا دينه زفت اليه بالشقاء والعناء والمحنة والبلاء(@)(@)(@@)(@@)(@@) ||| 184(@)(@)(@@) @HAD07 لا تبيعوا الآخرة بالدنيا ولا تستبدلوا(@)(@)PageV01P754(@)(@)(@@) @HAD010 الفناء بالبقاء ولا تجعلوا يقينكم شكا ولا علمكم جهلا(@)(@)(@@)(@@)(@@) ||| 185(@)(@)(@@) @HAD010 لا تجهل نفسك فإن الجاهل بمعرفة نفسه جاهل بكل شيء(@)(@)(@@)(@@)(@@) ||| 186(@)(@)(@@) @HAD023 لا يفتننكم الدنيا ولا يغلبنكم الهوى ولا يطولن عليكم الأمد ولا يغرنكم الأمل فإن الأمل ليس من الدين في شيء(@)(@)(@@)(@@)(@@) ||| 187(@)(@)(@@) @HAD016 لا تقولن ما لا تفعله فإنك لا تخلو في ذلك من عجز يلزمك وذم تكسبه(@)(@)(@@)(@@)(@@) ||| 188(@)(@)(@@) @HAD011 لا تعتذر من أمر أطعت الله سبحانه فيه فكفى بذلك منقبة(@)(@)(@@)(@@)(@@) ||| 189(@)(@)(@@) @HAD015 لا تكثرن من صحبة اللئيم فإنه إن صحبتك نعمة حسدك وإن طرقتك نائبة قذفك(@)(@)(@@)(@@)(@@) ||| 190(@)(@)(@@) @HAD07 لا تتخذ عدو صديقك صديقا فتعادي صديقك(@)(@)(@@)(@@)(@@) ||| 191(@)(@)(@@) @HAD014 لا تعاجل الذنب بالعقوبة واترك بينهما للعفو موضعا تحرز به الآخرة والمثوبة(@)(@)(@@)(@@)(@@) ||| 192(@)(@)(@@) @HAD032 لا يدعونك ضيق لزمك في عهد الله إلى النكث فإن صبرك على ضيق ترجو إنفراجه وفضل عاقبته خير لك من غدر تخاف به تعبه وتحيط بك من الله لأجله العقوبة(@)(@)(@@)(@@)(@@) ||| 193(@)(@)(@@) @HAD04 لا تسرعن إلى بادرة(@)(@)PageV01P755(@)(@)(@@) @HAD014 ولا تعجلن بعقوبة وجدت عنها مندوحة فإن ذلك منهكة للدين مقرب من الغير(@)(@)(@@)(@@)(@@) ||| 194(@)(@)(@@) @HAD010 لا تطيعوا النساء في المعروف حتى لا يطمعن في الم