ms2491	 " بن مضارب عن العريان ابن الهيثم وعنه الأسود بن سنان أو بن شيبان لا يعرف.(@)(@@)(@@)(@@) | 3631 - (@)(@@) " عبد الله " بن مطر أبو ريحانة البصري عن سفينة وابن عباس وعنه بشر بن المفضل.(@)(@@)(@@)(@@) | 3632 - (@)(@@) " عبد الله " بن المطلب بن عبد الله بن حنطب المخزومي المدني عن أنس.(@)(@@)(@@)(@@) | 3633 - (@)(@@) " عبد الله " بن معاذ بن نشيط الصنعاني صاحب معمر عن يونس بن يزيد وعنه إبراهيم بن المنذر.(@)(@@)(@@)(@@) | 3634 - (@)(@@) " عبد الله " بن معانق الأشعري الشامي أبو معانق عن أبي مالك.(@)(@@)(@@)(@@) | 3635 - (@)(@@) " عبد الله " بن معبد الزماني1 بصري عن أبي هريرة.(@)(@@)(@@)(@@) | 3636 - (@)(@@) " عبد الله " بن معقل بن مقرن المزني أبو الوليد الكوفي بصري عن أبيه وعنه الشعبي.(@)(@@)(@@)(@@) | 3637 - (@)(@@) " عبد الله " بن مكنف2 الأنصاري المدني عن أنس وعنه ابن إسحاق.(@)(@@)(@@)(@@) | 3638 - (@)(@@) " عبد الله " بن منير3 أبو عبد الرحمن المروزي الزاهد الحافظ عن النضر بن شميل.(@)(@@)(@@)(@@) | 3639 - (@)(@@) " عبد الله " بن موسى بن إبراهيم بن محمد بن طلحة بن عبيد الله التيمي أبو محمد المدني عن صفوان ابن سليم وعنه إبراهيم بن المنذر. PageV07P270(@)(@@)(@@)(@@) | 3640 - (@)(@@) " عبد الله " بن مولة1 القشيري عن بريدة الأسلمي وعنه أبو نضرة.(@)(@@)(@@)(@@) | 3641 - (@)(@@) " عبد الله " بن موهب الهمداني أو الخولاني قاضي فلسطين2 عن تميم وعنه ابنه يزيد والزهري.(@)(@@)(@@)(@@) | 3642 - (@)(@@) " عبد الله " بن ملاذ الأشعري الشامي عن تميم بن أوس وعنه جرير بن أبي حازم.(@)(@@)(@@)(@@) | 3643 - (@)(@@) " عبد الله " بن مهاجر الشعيثي3 النصري الدمشقي عنه ابنه محمد.(@)(@@)(@@)(@@) | 3644 - (@)(@@) " عبد الله " بن المؤمل هبة الله المخزومي المكي العابدي4 عنه الشافعي وأبو نعيم.(@)(@@)(@@)(@@) | 3645 - (@)(@@) " عبد الله " بن ميسرة الحارثي أبو الوليد أو أبو إسحاق الكوفي أو الواسطي يقال: له أبو ليلى عن الشعبي وعنه هشيم.(@)(@@)(@@)(@@) | 3646 - (@)(@@) " عبد الله " بن ميمون بن داود المخزومي مولاهم المكي القداح عن يحيى الأنصاري وعنه زياد بن يحيى.(@)(@@)(@@)(@@) | 3647 - (@)(@@) " عبد الله " بن نافع بن العمياء عن ربيعة بن الحارث وعنه عمران.(@)(@@)(@@)(@@) | 3648 - (@)(@@) " عبد الله " بن نافع الهاشمي مولاهم أبو جعفر الكوفي مولى الحسن بن علي رضى الله عنهما عن مولاه.(@)(@@)(@@)(@@) | 3649 - (@)(@@) " عبد الله " بن نافع 
ms2492	 المدني مولى بن عمر رضى الله عنهما عن أبيه وعنه عيسى بن يونس.(@)(@@)(@@)(@@) | 3650 - (@)(@@) " عبد الله " بن نافع الصائغ المخزومي مولاهم أبو محمد المدني عن أبي أسامة PageV07P271(@)(@@) ومالك وعنه قتية.(@)(@@)(@@)(@@) | 3651 - (@)(@@) " عبد الله " بن نجيد بن عمران ابن حصين الخزاعي البصري عن أبيه وعنه ابنه يوسف لا يعرف.(@)(@@)(@@)(@@) | 3652 - (@)(@@) " عبد الله " بن نجي1 بن سلمة الحضرمي الكوفي أبو لقمان عن علي رضى الله عنه وعنه أبو زرعة.(@)(@@)(@@)(@@) | 3653 - (@)(@@) " عبد الله " بن أبي نجيح يسار المكي أبو يسار أو أبو أحمد الثقفي مولاهم عن طاوس.(@)(@@)(@@)(@@) | 3654 - (@)(@@) " عبد الله " بن نسطاس2 المدني مولى كثير بن الصلت الكندي عن جابر وعنه هاشم.(@)(@@)(@@)(@@) | 3655 - (@)(@@) " عبد الله " بن نعيم بن همام القيني3 الشامي العابد الدمشقي عن الضحاك بن عرزب ومكحول وعنه ابن جريج وابناه عاصم وعبد الغني قال يحيى بن معين تكلم فيه.(@)(@@)(@@)(@@) | 3656 - (@)(@@) " عبد الله " بن نهيك كوفي عن علي وعنه أبو إسحاق السبيعي وحده ووثقه ابن حبان.(@)(@@)(@@)(@@) | 3657 - (@)(@@) " عبد الله " بن هارون حجازي عن زباد بن سعد وعنه صفوان.(@)(@@)(@@)(@@) | 3658 - (@)(@@) " عبد الله " بن هارون وقيل بن أبي هارون حجازي اقدم من الذي قبله.(@)(@@)(@@)(@@) | 3659 - (@)(@@) " عبد الله " بن هانئ الكندي أبو الزعراء الأكبر الكوفي عن عمر رضى الله عنه وعنه ابن أخته. PageV07P272(@)(@@)(@@)(@@) | 3660 - (@)(@@) " عبد الله " بن همام النهدي الكوفي عن علي رضى الله عنه وعنه عيسى بن عبد الرحمن السلمي وحده.(@)(@@)(@@)(@@) | 3661 - (@)(@@) " عبد الله " بن واقد بن الحارث بن عبد الله الحنفي أبو رجاء الخراساني عن أبي هارون وعنه إسحاق.(@)(@@)(@@)(@@) | 3662 - (@)(@@) " عبد الله " بن الوليد بن ميمون الأموي مولاهم أبو محمد المكي المعروف بالعدني عن الثوري وعنه أحمد.(@)(@@)(@@)(@@) | 3663 - (@)(@@) " عبد الله " بن الوليد بن عبد الله بن معقل بن مقرن المزني العجلي نزل فيهم عن أبي جعفر الباقر وعنه أبو أسامة.(@)(@@)(@@)(@@) | 3664 - (@)(@@) " عبد الله " بن وهب بن مسلم القرشي مولاهم أبو محمد المصري الفقيه أحد الأئمة عن مالك ويونس بن يزيد وعنه ابن مهدي.(@)(@@)(@@)(@@) | 3665 - (@)(@@) " عبد الله " بن وهب بن منبه الصنعاني1 عن أبيه 
ms2493	 وعنه جماعة قال أبو داود معروف.(@)(@@)(@@)(@@) | 3666 - (@)(@@) " عبد الله " بن يحيى بن أبي كثير اليمامي عن أبيه وعنه ابن أخيه يحيى بن أبي كثير بن يحيى.(@)(@@)(@@)(@@) | 3667 - (@)(@@) " عبد الله " بن يحيى بن سلمان الثقفي أبو يعقوب التوأم2 بصري عنه خلف بن هشام.(@)(@@)(@@)(@@) | 3668 - (@)(@@) " عبد الله " بن يحيى الأنصاري من ولد كعب بن مالك وثق.(@)(@@)(@@)(@@) | 3669 - (@)(@@) " عبد الله " بن يزيد رضيع عائشة رضى الله عنها بصري.(@)(@@)(@@)(@@) | 3670 - (@)(@@) " عبد الله " بن يزيد الدمشقي عن ربيعة بن يزيد وعنه عبد الله بن عقيل.(@)(@@)(@@)(@@) | 3671 - (@)(@@) " عبد الله " بن يزيد النخعي الصهباني الكوفي عن إبراهيم النخعي وعنه زائدة. PageV07P273(@)(@@)(@@)(@@) | 3672 - (@)(@@) " عبد الله " بن يزيد المدني مولى المنبعث عن أبيه وعنه ربيعة بن أبي عبد الرحمن.(@)(@@)(@@)(@@) | 3673 - (@)(@@) " عبد الله " بن يزيد بن الصلت الشيباني عن داود وعنه محمد بن عبد العزيز الأيلي.(@)(@@)(@@)(@@) | 3674 - (@)(@@) " عبد الله " بن يسار هو ابن أبي نجيح.(@)(@@)(@@)(@@) | 3675 - (@)(@@) " عبد الله " بن يوسف التنيسي1 أبو محمد الكلاعي أصله من دمشق.(@)(@@)(@@)(@@) | 3676 - (@)(@@) " عبد الله " بن يونس2 حجازي.(@)(@@)(@@)(@@) | 3677 - (@)(@@) " عبد الله " أبو بكر الحنفي البصري عن أنس رضى الله عنه.(@)(@@)(@@)(@@) | 3678 - (@)(@@) " عبد الله " أبو موسى الهمداني عن الوليد بن عقبة.(@)(@@)(@@)(@@) | 3679 - (@)(@@) " عبد الله " الزرقي عن بعض الصحابة وعنه علي بن مسعدة فقط.(@)(@@)(@@)(@@) | 3680 - (@)(@@) " عبد الله " والد حمزة عن سعد وعنه ابنه حمزة لا يعرف. PageV07P274(@)(@@)(@@)(@@) | من اسمه عبد الأعلى إلى عبد الحميد(@)(@@)(@@)(@@) | 3681 - (@)(@@) " عبد الأعلى " بن اعين الكوفي الشيباني مولاهم الكوفي عن نافع وعنه عبد الله بن موسى.(@)(@@)(@@)(@@) | 3682 - (@)(@@) " عبد الأعلى " بن عامر الثعلبي3 الكوفي.(@)(@@)(@@)(@@) | 3683 - (@)(@@) " عبد الأعلى " بن عبد الأعلى السامي4 أبو محمد البصري عن يونس وعنه إسحاق.(@)(@@)(@@)(@@) | 3684 - (@)(@@) " عبد الأعلى " بن أبي المساور الزهري مولاهم الجرار5 أبو مسعود الكوفي نزيل المدائن عن الشعبي وعنه يزيد بن هارون.(@)(@@) 3685 – " عبد الاكرم " بن أبي حنيفة الكوفي عن أبيه وعنه شعبة.(@)(@@) 3686 – " عبد الجبار " بن العباس الهمداني الشبامي6 نزل الكوفة عن عدي وعنه PageV07P274(@)(@@) ابن المبارك رحمه الله تعالى.(@)(@@) 3687 – " عبد الجبار " بن عمرو الأيلي مولاهم عن نافع وعنه 
ms2494	 ابن وهب.(@)(@@) 3688 – " عبد الجبار " بن وائل بن حجر1 الحضرمي أبو محمد الكوفي أرسل عن أبيه عن أخيه علقمة وعنه ابنه سعيد وأبو إسحاق.(@)(@@) 3689 – " عبد الجبار " بن الورد المكي المخزومي مولاهم أبو هشام عن عطاء وعنه وكيع.(@)(@@) 3690 – " عبد الجليل " بن عطية القيسي2 أبو صالح البصري عن شهر وعنه ابن مهدي.(@)(@@)(@@)(@@) | 3691 - (@)(@@) " عبد الحكم " بن ذكوان السدوسي البصري عن أبي رجاء وعنه مروان بن معاوية.(@)(@@)(@@)(@@) | 3692 - (@)(@@) " عبد الحكم " بن عبد الله القسملي3 عن أنس وعنه عفان وغيره ضعفوه.(@)(@@)(@@)(@@) | 3693 - (@)(@@) " عبد الحكم " بن منصور الواسطي أبو سهل أو أبو سفيان الخزاعي الواسطي.(@)(@@) 3694 – " عبد الحميد " بن إبراهيم أبو تقي4 الحمصي عن إسماعيل بن عياش.(@)(@@) 3695 – " عبد الحميد " بن عبد الله بن عبد الله بن أويس الأصبحي أبو بكر بن أبي أويس بن مالك المدني عن أبيه وعنه اخوه إسماعيل.(@)(@@)(@@)(@@) | 3696 - (@)(@@) " عبد الحميد " بن بهرام الفزاري المدائني صاحب شهر بن حوشب.(@)(@@)(@@)(@@) | 3697 - (@)(@@) " عبد الحميد " بن جعفر بن عبد الله بن الحكم بن رافع الأنصاري أبو الفضل PageV07P275(@)(@@) المدني عن أبيه وعنه القطان.(@)(@@)(@@)(@@) | 3698 - (@)(@@) " عبد الحميد " بن حبيب بن أبي العشرين الدمشقي أبو سعيد كاتب الأوزاعي روى عنه فقط وعنه أبو الجماهر.(@)(@@)(@@)(@@) | 3699 - (@)(@@) " عبد الحميد " بن الحسن الهلالي أبو عمرو أو أبو أمية أو أبو عمرة كوفي سكن الري عن قتادة.(@)(@@)(@@)(@@) | 3700 - (@)(@@) " عبد الحميد " بن زياد أو زيد بن صيفي ابن صهيب الرومي عن أبيه عن جده وعنه ابنه علي.(@)(@@)(@@)(@@) | 3701 - (@)(@@) " عبد الحميد " بن سالم أبو سالم مولى عمرو بن الزبير عن أبي هريرة.(@)(@@)(@@)(@@) | 3702 - (@)(@@) " عبد الحميد " بن سليمان أخو فليح الخزاعي الضرير أبو عمر المدني نزيل بغداد عن العلاء وعنه سعيد بن منصور.(@)(@@)(@@)(@@) | 3703 - (@)(@@) " عبد الحميد " بن سنان مكي عن عبيد بن عمير.(@)(@@)(@@)(@@) | 3704 - (@)(@@) " عبد الحميد " بن عبد الله بن عبد الله1 بن عمر العمري المدني روى كتاب صدقات عمر رضى الله عنه وعنه يحيى بن سعيد.(@)(@@)(@@)(@@) | 3705 - (@)(@@) " عبد الحميد " بن عبد الرحمن بن زيد بن الخطاب العدوي أبو عمر المدني الأعرج 
ms2495	 الجزري عن أبيه وابن عباس وعنه الحكم بن عتيبة.(@)(@@)(@@)(@@) | 3706 - (@)(@@) " عبد الحميد " بن عبد الرحمن الحماني2 أبو يحيى الكوفي لقبه بشمين عن الأعمش وعنه ابنه يحيى وأبو كريب. PageV07P276(@)(@@)(@@)(@@) | من اسمه عبد الخالق وعبد ربه(@)(@@)(@@)(@@) | 3707 - (@)(@@) " عبد الخالق" عن أنس وعنه عنبسة بن عبد الرحمن القرشي مجهول.(@)(@@) PageV07P276(@)(@@)(@@)(@@) | 3708 - (@)(@@) " عبد الحي " بن سويد عن أبي هشام محمد بن يزيد الرفاعي روى عنه ابن ماجة.(@)(@@)(@@)(@@) | 3709 - (@)(@@) " عبد ربه " بن أبي أمية عن الحارث بن عبد الله بن أبي ربيعة وعنه ابن جريج وحده يقال: اسمه عبد الله.(@)(@@)(@@)(@@) | 3710 - (@)(@@) " عبد ربه " بن بارق الحنفي الكوسج أبو عبد الله الكوفي أصله من اليمامة ويقال: اسمه عبد الله البصري عن جده لامه سماك بن الوليد.(@)(@@)(@@)(@@) | 3711 - (@)(@@) " عبد ربه " بن الحكم بن سفيان ابن عبد الله ويقال: ابن عثمان ابن بشير الثقفي الطائفي تابعي أرسل وعنه عبد الله بن عبد الرحمن بن يعلى الطائفي.(@)(@@)(@@)(@@) | 3712 - (@)(@@) " عبد ربه " بن سليمان زيتون بزاي النبات المعروف الدمشقي عن أم الدرداء مجهول وعنه إسماعيل بن عياش قلت: وعنه رجاء بن أبي سلمة وثقه بن حبان.(@)(@@)(@@)(@@) | 3713 - (@)(@@) " عبد ربه " بن نافع الكناني الحناط بمهملة ونون نزيل المدائن أبو شهاب الأصغر عن ليث وعنه يحيى بن آدم.(@)(@@)(@@)(@@) | 3714 - (@)(@@) " عبد ربه " ويقال: عبد رب بن يزيد أو بن أبي يزيد عن أبي عياض وعنه قتادة.(@)(@@) PageV07P277(@)(@@)(@@)(@@) | من اسمه عبد الرحمن(@)(@@)(@@)(@@) | 3715 - (@)(@@) " عبد الرحمن " بن إسحاق بن عبد الله بن الحارث القرشي العامري المدني نزيل البصرة ويقال: له عباد عن أبيه وعنه إبراهيم بن طهمان.(@)(@@)(@@)(@@) | 3716 - (@)(@@) " عبد الرحمن " بن إسحاق بن سعد بن الحارث الواسطي أبو شيبة الأنصاري الكوفي عن عمه النعمان ابن سعد وأبيه إسحاق.(@)(@@)(@@)(@@) | 3717 - (@)(@@) " عبد الرحمن " بن أمية الثقفي ويقال: ابن يعلى بن أمية عنه ابنه عمرو.(@)(@@) PageV07P277(@)(@@)(@@)(@@) | 3718 - (@)(@@) " عبد الرحمن " بن بديل بن ميسرة العقيلي البصري عن أبيه.(@)(@@)(@@)(@@) | 3719 - (@)(@@) " عبد الرحمن " بن أبي بكر عن جابر وعنه أبو حومل.(@)(@@)(@@)(@@) | 3720 - (@)(@@) " عبد الرحمن " بن أبي بكر بن عبيد الله بن أبي مليكة المليكي المدني. 
