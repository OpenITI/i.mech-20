ms101	(@)(@@) % و ملمة ولي الزمان فتوقعها % % مني رقعت به وسيع هناتها % % 65(@)(@@) % من حامل صحف الثناء أمانة % لا يستطيع النكث قرع صفاتها % % 66(@)(@@) % شكرا كما ضحكت إليه مجودة % بالحزن باقي الطل في حنواتها % % 67(@)(@@) % يغدو فينقل ثقلها بسكينة % في سمتها هدى وفي إخباتها % % 68(@)(@@) % طب بعلم فروضها وقروضها % % حتى يؤديها على أوقاتها % % 69(@)(@@) % أبلغ أبا الحسن التي ما بعدها % % مرمى لغالبة المنى ورماتها % % 70(@)(@@) % عني مغلغلة تسر حديثها % % أم الكواكب أو أعير صفاتها % % PageV01P295 71(@)(@@) % من منبع الحلو الحلال إذا غدا % % ملح القرائح ذاهبا بفراتها % % 72(@)(@@) % لو نازل الرهنان حط قنانها % % فصبت إليه وحل من عزماتها % % 73(@)(@@) % يجزيك عن كسب العلاء وحبه % ما تنطق الخرساء بعد صماتها % % 74(@)(@@) % و ترد أعراض الكرام كأنها % % يمينة تختال في حبراتها % % 75(@)(@@) % ثمنا لودك إن يكن ثمنا له % % بذل القوافي فيك مكنوناتها % % 76(@)(@@) % تسخو به لك من نخيلة سرها % % نفس ترى بك ما ترى بحياتها % % PageV01P296 البحر : - 1(@)(@@) % خصيماي من ظمياء واش وشامت % و حظاي مظنون لديها وفائت % 2(@)(@@) % و قلبي لها وحشية ضل خشفها % % تطاول تبغيه الربا وتلافت % 3(@)(@@) % مضت ليلة تقتصه بعد ليلة % و يوم تداجيه الشخوص الثوابت % 4(@)(@@) % تناشد عنه النجم أين طريقه % % تحارفه طورا وطورا تسامت % 5(@)(@@) % و لا هو منها حيث يجمع شارد % و لا يرتجى للعود إن عاد فالت % 6(@)(@@) % سوى أنها مرت بماء سويقة % سحيرا ورام بالشريعة بائت % 7(@)(@@) % على يده للرزق أذلغ أحرس % و ضلعاء فوها ساعة النزع صائت % 8(@)(@@) % يقوت شعاثا مقترين بفضلها % % أطابت له أو جانبته المقاوت % 9(@)(@@) % فما رابها إلا دم ونويرة % و منتقيات من عظام رفائت % 10(@)(@@) % فعادت تماشي اليأس موضع ظله % % و للحين لو أغنى الحذار مواقت % PageV01P297 11(@)(@@) % و خبرني السفار أن قد تبدلت % فقلت حديث مضحك وهو كابت % 12(@)(@@) % أسد مكاني في الهوى من تعوضت % مدى وأبيها بيننا متفاوت % 13(@)(@@) % أمنها خيال والجنوب خوافق % بجانب خبت والجفون خوافت % 14(@)(@@) % طوى الليل نجما وهو يستقل الخطا % % بساهلة الأرداف ثم يعانت % 15(@)(@@) % فبتنا به في 
ms102	 ضوعة وإنارة % و بان اللوى خزيان والبدر باهت % 16(@)(@@) % نرى أن فأر المسك تحت رحالنا % % فتائق من أردانه وفتائت % 17(@)(@@) % سل الخيم بالبيضاء من جانب الحمى % % أتجمع أو طارى بكن الشتائت % 18(@)(@@) % و هل لطريد سله الدهر مدرك % فتعقل لي ليلاتكن الفلائت % 19(@)(@@) % إذ العيش حي والزمان مراهق % % فتى وريحان البطالة نابت % 20(@)(@@) % تلون رأسي صبغتين فميت % و ذونبة أو لاحق متماوت % PageV01P298 21(@)(@@) % و أمست على أيدي الغواني حبائلي % % و هن بأطراف البنان بتائت % 22(@)(@@) % و ما الدهر إلا داء هم مماطل % % مدى العيش أو خطب هجوم مباغت % 23(@)(@@) % عذيري من الإخوان لا أستشف من % % قلوبهم من وامق لي وماقت % 24(@)(@@) % خفافا إلى ما ساءني فمصالت % به أو مداج كيف لي لو يصالت % 25(@)(@@) % جعلت الجفاء عوذة لي منهم % و في الناس أجساما قلوب عفارت % 26(@)(@@) % و علمني نبذي لهم وتوحدي % % بنفسي أني في التكثر غالت % 27(@)(@@) % سل السارح المخدوع أعجف ما له % % جفاء السمي والسنون السوانت % 28(@)(@@) % توغل يرجوها وتخلف ظنه % % منابع أكدي ماؤها ومنابت % 29(@)(@@) % إلى أين وابن الغاضرية شاهد % يغرك نجم أو يدلك خارت % 30(@)(@@) % تلق الحيا من جوه وارع روضه % تدر العجاف أو تعيش الموائت % PageV01P299 31(@)(@@) % ألا إنما بدر السماء ابن شمسها % % و بدر بني عوف على الأرض ثابت % 32(@)(@@) % فتى لا على الأعذار بالعهد ناكث % و لامع فرط الجود للسن ناكت % 33(@)(@@) % يبيت خميصا جنبه ووساده % و طارقه خصبا كما شاء بائت % 34(@)(@@) % إذا الليلة الطولي أمرت وأيبست % فللضيف منه متمر الليل رابت % 35(@)(@@) % ترى ما له سله الجود لا التي % % تناعر حوليها الحداة المصاوت % 36(@)(@@) % رخي البنان في النوائب كلما % % أضب على المال الحسيب المباكت % 37(@)(@@) % تهادى نساء الحي وصف حنانه % % و تأباه في الروع الرجال المصالت % 38(@)(@@) % ترى الحلم مشحونا وراء ردائه % % إذا مر ينزو الطائش المتهافت % 39(@)(@@) % فهل مبلغ عني خزيمة ما وعى % % حصاها البديد أو رباها الثوابت % 40(@)(@@) % و في لك مجدا ما تعدين في أبي % % قوام إذا خان الفروع النوابت 
ms103	 % PageV01P300 41(@)(@@) % ولدت وأولدت الكبير ومثله % قليل وأمات الصقور مقالت % 42(@)(@@) % سبقت فلم يعلق غبارك جامح % وفت فلم يملك صفاتك ناعت % 43(@)(@@) % و جربك الأعداء غمزا وهزة % فما خدشت في مرويتك النواحت % 44(@)(@@) % فداك صديق وجهه وفؤاده % % معاد على دين المعالي معانت % 45(@)(@@) % يريك الرضا والغل حشو جفونه % و قد تنطق العينان والفم ساكت % 46(@)(@@) % طوى بغضة في جفنه فهو باسم % و في فيه ليث كاشر لك هارت % 47(@)(@@) % أهبت بشعري فانبرت لك عيسه % بما حملت وهي الخضوع الخوابت % 48(@)(@@) % فعادت بما أرعيتها ولبانها % % طواع على لي الحبال ضواغت % 49(@)(@@) % و نادتك لغوات السؤال فأفصحت % % يداك وأيدي المانعين صوامت % 50(@)(@@) % و أوسعتني مالا أتى لم تخض له ال % % دياجي ولم تنفض عليه السبارت % PageV01P301 51(@)(@@) % و خلقا كما شعشعتها ذهبية % ببابل أهدتها إليك الحوانت % 52(@)(@@) % و لم تك حاشا مجد نفسك كامرئ % % تصامم عني وهو للمدح ناصت % 53(@)(@@) % و قوم كأن الشعر فيهم بلية % أعرت وعافتها الأكف الزوافت % 54(@)(@@) % فكن سامعا ما امتد باعك في العلا % % و سر محب أو تخيب شامت % 55(@)(@@) % ثناء فم الراوي عليك مسلم % به ومصلي الشكر باسمك قانت % 56(@)(@@) % تزورك منه في أوان فروضها % % قواف لها عند الكرام مواقت % 57(@)(@@) % يفدن الغنى أضعاف ما يستفدنه % و هن بقايا والعطايا فوائت % 58(@)(@@) % أقول لأيامي دعي لي أو خذي % % فما أنت إلا المقبلات اللوافت % 59(@)(@@) % فلست أبالي من تزيل ركبه % و ثابت لي على المودة ثابت % PageV01P302 البحر : - 1(@)(@@) % حماها بأطراف الرماح حماتها % % فلا حفلها منا ولا خلواتها % % 2(@)(@@) % و ذبب عنها من عقيل بن عامر % أراقم لا تحوي شباها رقاتها % % 3(@)(@@) % عشيرة مكلوء البيوت محصن % يعز بنوها أن ترام بناتها % % 4(@)(@@) % معودة طرد العيوب غيوبها % % إذا حفظت عوراتها أسلاتها % % 5(@)(@@) % و حرم واليها الولوع بذكرها % % و إن عتبت أخرى عليها سماتها % % 6(@)(@@) % فهل مغمز في جانب من ورائه % % سلامة يا قلبي وهذي حصاتها % % 7(@)(@@) % فكم في بيوت العامريات من هوى % % يناط كما نيطت بها خالفاتها % % 8(@)(@@) % و مثلك أسرى 
ms104	 لا يسام فداؤها % % هوانا وقتلى لا تساق دياتها % % 9(@)(@@) % بلى لك منها في الكرى إن وفي الكرى % % و في الريح حظ إن جرت نفحاتها % % 10(@)(@@) % و ليل بذي ضال قصير طويله % % على البدن تطوي درجه ناجياتها % % PageV01P303 11(@)(@@) % ترى العيس في أجوازه بقلوبها % % إلى قصده ما لا ترى لحظاتها % % 12(@)(@@) % بها من حنين تحته ما بركبها % % و إن نطقوا الشكوى وطال صماتها % % 13(@)(@@) % إذا الريح قرت فاستهزت ضلوعهم % % تصلوا بما تذكى لهم زفراتها % % 14(@)(@@) % سرت بنشاوى من معاقرة السرى % % وسائدهم فوق الثرى ركباتها % % 15(@)(@@) % نضوا ما نضوا من ليلهم ثم هوموا % % غرارا وقد خاط العيون سناتها % % 16(@)(@@) % على ساعة جن الفلاة ووحشها % % تريها الشخوص الزور عنا فلاتها % % 17(@)(@@) % تخطت الينا الغور فالعرض فالحمى % % و ما ذاك ممشاها ولا خطواتها % % 18(@)(@@) % فبتنا لها في نعمة شكرت لها % % و ما هي جدواها ولا أعطياتها % % 19(@)(@@) % عواطف دنيا في الكرى لو أردتها % % على مثلها يقظان عز التفاتها % % 20(@)(@@) % فلم أرها وعند قوم أداتها % % من العيش إلا وهي عندي أداتها % % PageV01P304 21(@)(@@) % سقى الله شرا دوحة لي سيالها % % و للناس ملقى ظلها وجناتها % % 22(@)(@@) % و لودا ولي من حظها بطن حائل % معنسة شابت وشاب لداتها % % 23(@)(@@) % أغامز منها صخرة إرمية % تفل النيوب وهي جلد صفاتها % % 24(@)(@@) % و كيف تسام النصف أم تلونت % معارفها إن حوشيت منكراتها % % 25(@)(@@) % ترى الوكل المغمور كحل لحاظها % % و كحل أخي الهم البعيد قذاتها % % 26(@)(@@) % هوت برؤس الناس سفلا وحلقت % بأذنابها مجنونة طائراتها % % 27(@)(@@) % فعندك منها أن ترى ببغاثها % % كواسب جوحص فيه بزاتها % % 28(@)(@@) % ركبت من الأيام ظهر ملون % صبائغه والخيل شتى شياتها % % 29(@)(@@) % و قلبتها يوما فيوما مجربا % % فلا سوءها يبقى ولا حسناتها % % 30(@)(@@) % سأحملها حتى تخف وسوقها % % و أحلم حتى ترعوى جهلاتها % % PageV01P305 31(@)(@@) % لعل مميت الحظ يحييه آنفا % فإن الحظوظ موتها وحياتها % % 32(@)(@@) % فلا يؤيسنك صدها من وصالها % % و لا مطلها من أن تصح عداتها % % 33(@)(@@) % ألم تر ملك المكرميين ناره % خبت غلطا ثم اعتلت وقداتها % % 34(@)(@@) % هفا الدهر فيهم 
ms105	 مستغرا بغيره % % فخاضوا وشاكت رجله عثراتها % % 35(@)(@@) % بغى نقل ما أعطوا سفاها ولم تكن % % هضاب شروري زائلا راسياتها % % 36(@)(@@) % هم السحب ملء الأفق والدهر تحتها % % جفاء إذا سالت به سائلاتها % % 37(@)(@@) % علا السيل حتى الصين يفعم بحرها % % فيطغى وفي بغداد يجري فراتها % % 38(@)(@@) % حمى ناصر الدين العلا بعد من مضى % % فضمت قواصيها ولم شتاتها % % 39(@)(@@) % و أضحى بتاج الدولة العز مفرقا % % لها تتلظى فوقه خرزاتها % % 40(@)(@@) % و إن فروجا سدها مثل سعيه % % لضيقة أن ترتجى خطفاتها % % PageV01P306 41(@)(@@) % رعاها أبو الأشبال حتى دنا بها % % لها من شميم سرحها حسراتها % % 42(@)(@@) % أخو عزمات لا يراع صديقها % % كما لم ينم ولا تنام عداتها % % 43(@)(@@) % كريم المحيا رطبة قسماته % إذا ما الليوث استجهمت عابساتها % % 44(@)(@@) % على الصدر منه هيبة تملأ الحشا % % ممررة أخلاقه محلياتها % % 45(@)(@@) % و من رأيه في الحرب عضب وذابل % و ما الحرب إلا سيفها وقناتها % % 46(@)(@@) % كريم فما الأحساب إلا اقتناؤها % % لديه ولا الأموال إلا هباتها % % 47(@)(@@) % إذا اعترضته هزة الجود ساكنا % % نزت بالندى في كفه نزواتها % % 48(@)(@@) % أفاد الندى فلم تزل برياضه % % رياح العلا أو صوحت شجراتها % % 49(@)(@@) % من القوم فضوا عذرة الأرض سادة % و شابت وهم أربابها وولاتها % % 50(@)(@@) % فمن حلمهم أركانها وجبالها % % و من جودهم أمواهها ونباتها % % PageV01P307 51(@)(@@) % و ليسوا كمن جن الزمان برفعه % % و جاءت به من دولة فلتاتها % % 52(@)(@@) % و لا كذبا طارت به الريح طيرة % فأقعصه أن طأطأت عاصفاتها % % 53(@)(@@) % تقيلتهم والنفس يكرم أصلها % % على عرقها الساري فتكرم ذاتها % % 54(@)(@@) % بك اهتز فرعاها وأنيع ظلها % % و طاب جناها وانتهت بركاتها % % 55(@)(@@) % جمعت لها سذان كل فضيلة % % تعز على من رامها مفرداتها % % 56(@)(@@) % فمن كان من قوم سفا في أديمهم % % و زعنفة تزري فأنت سراتها % % 57(@)(@@) % لئن عركت في جنب طودك نبوة % من الدهر لا تمحى بعذر هناتها % % 58(@)(@@) % و هز العدا من حسن صبرك صعدة % فقد علموا بالهز كيف ثباتها % % 59(@)(@@) % و ما كنت إلا الشمس ليثت جهامة % على خدها ثم انجلت غاشياتها % % 60(@)(@@) % تنصل 
ms106	 منها المالك لما تبينت % لعينه أخراها ومعتقباتها % % PageV01P308 61(@)(@@) % و أبصرها شنعاء يبقى حديثها % % ذميما ولا تبقى له عائداتها % % 62(@)(@@) % فردك رد السيف في الغمد لم تعب % % مضاربه إن ثلمت شفراتها % % 63(@)(@@) % فكيف يليق الحسن أوجه دولة % إذا عدمت تيجانها خرزاتها % % 64(@)(@@) % رعى الله نفسا لا الغنى زادها علا % و لا فقرها حطت له درجاتها % % 65(@)(@@) % معظمة في حدها وسنانها % % و سلطانها لا ما حوت ملكاتها % % 66(@)(@@) % إذا قزعت يوما من الدهر نكبة % إليها عست فلم نسغها لهاتها % % 67(@)(@@) % و أنت الذي تعطي وعامك أشهب % عطاء رجال خضرت سنواتها % % 68(@)(@@) % مع الجود أني ملت غير مصرف % يمينك إلا حيث شاءت عفاتها % % 69(@)(@@) % أقلني أقلني جفوة ما اعتمدتها % % و هجرة أعوام خلت ما ابتداتها % % 70(@)(@@) % و سعيا بطيئا عن مقامي من العلا % % لديك إذا الأقدام فازت سعاتها % % PageV01P309 71(@)(@@) % فما كان إلا الحظ منكم حرمته % و دنيا كثير بالغنى فلتاتها % % 72(@)(@@) % تريد بنفسي كل ما لا تريده % % و تمنعها ما تقتضي شهواتها % % 73(@)(@@) % و إني لكم ذاك الذي لا حباله % % ترث ولا يخشى عليه انبتاتها % % 74(@)(@@) % مقيم على نعمائكم حافظ لها % % مضب على ما أوجبت حرماتها % % 75(@)(@@) % ينقل قوما قربهم وبعادهم % % و نفسي لا تهفو بها مبدلاتها % % 76(@)(@@) % تحن إلى أيامكم في ذراكم % و تحفزها من عهدكم مذكراتها % % 77(@)(@@) % و عندي لكم ن أسخطتكم سوالفي % % عوائد ترضى مجدكم آنفاتها % % 78(@)(@@) % تسير على عاداتها بصفاتكم % % طوالع تمشي بالعلا مثقلاتها % % 79(@)(@@) % نوازل في عرض الفلا وصواعدا % ترد على روحاتها غدواتها % % 80(@)(@@) % تخال هواديها بنشر علائكم % % برود زوبيد نشرت حبراتها % % PageV01P310 81(@)(@@) % يقص بها تحت الظلام سميرها % % و ترجزكم وجه النهار حداتها % % 82(@)(@@) % تطربها الأسماع فيكم كأنما % % عزيف الملاهي ما تقول رواتها % % 83(@)(@@) % كأن الأولى دارت عليهم بيوتها % % بنو نشوة دارت عليهم سقاتها % % 84(@)(@@) % مبشرة أيامكم باتصالها % % ترى الحسن قبل أن ترى أخرياتها % % 85(@)(@@) % خوالد ما لبي الحجيج وطوفوا % % و عجت بسفحي مكة عرفاتها % % 86(@)(@@) % و ما عقروها واجبات جنوبها % % تفجر من لباتها فاجراتها % % 87(@)(@@) % تزوركم الأعياد 
ms107	 مجلوة بها % % تحلى بما صاغت لكم عاطلاتها % % 88(@)(@@) % إذا لعنت قوما لئاما ما فإنما % % على ذكركم تسليمها وصلاتها % % PageV01P311 البحر : - 1(@)(@@) % أهفو لعلوي الرياح إذا جرت % و أظن رامة كل دار أقفرت % 2(@)(@@) % و يشوقني روض الحمى متنفسا % % يصف الترائب والبروق إذا جرت % 3(@)(@@) % متعللات بعد طارفة النوى % أو أبرأت داء الجوى أو عللت % 4(@)(@@) % يا دين قلب من ليالي حاجر % مكرت به فقضت عليه وانقضت % 5(@)(@@) % و مضاجع بالعنف بات يعدها % % غنما وأصبح وده لو لم يبت % 6(@)(@@) % و مليحة لو أنصفت عين المها % % في الحسن ما ثنت الصليف ولا رنت % 7(@)(@@) % بيضاء من كلل الخدور وربما % % ذكرت بداوة قومها فتسهمت % 8(@)(@@) % أخذت وأعطت من ضياء الشمس ما اح % % تكمت فجمعت الجمال ووفرت % 9(@)(@@) % و كأنما وليت خطائط وجهها % % يدها فجاءت في الكمد كما اشتهت % 10(@)(@@) % ملكت على بانات جو أمرها % % فلها الإمارة ما استقامت وانثنت % PageV01P312 11(@)(@@) % فإذا أرادت بالقضيب مساءة % و تنقمت جرما عليه تأودت % 12(@)(@@) % سنحت لنا دون الغدير فما سقى % صفو الغدير وعذبه من أعطشت % 13(@)(@@) % و رمت فلولا أنها ثعلية % قلنا رأت ثعلا رمى فتعلمت % 14(@)(@@) % غدرت فلولا أنها نذرت دمي % % لم تعرف النذر الذي فيه وفت % 15(@)(@@) % و على النقا والعيس تحفر في النقا % % أخفافها من ثقل ما قد حملت % 16(@)(@@) % حلفت على قتلي فلما أن رأت % % بذماي باقية الرماق تأولت % 17(@)(@@) % أبشر فانك في الحياة مخلد % يا من رأى يوم القليب ولم يمت % 18(@)(@@) % و تشرفت لتشب جمرة صدره % بنت الأراك وهل تشب وما انطفت % 19(@)(@@) % ورقاء ذكرها الحداة هوى لها % % طارت ألائفها به فتذكرت % 20(@)(@@) % هتفت على خضراء كيف ترنمت % من فوقها مالت بها فترنحت % PageV01P313 21(@)(@@) % لو كان ينجو من علاقات الهوى % % شيء لضعف أو لمرحمة نجت % 22(@)(@@) % و لقد طربت كما حزنت لصوتها % % فشككت هل غنت بشجو أو بكت % 23(@)(@@) % قف يا أخا الملهوف وقفة مرسل % حمل الأمانة هضبة أو أديت % 24(@)(@@) % و اجهر بصوتك التي لو خاطبت % في السر أو عال 
ms108	 القنان لأسمعت % 25(@)(@@) % و قل التحية والسلام وحاجة % من بعد أن خابت وإن هي أنجحت % 26(@)(@@) % يا أخت سعد فيم بات معذبا % % قلبي عليك كأنما عيني جنت % 27(@)(@@) % ردى الفؤاد علي فهو وديعة % مضمونة مغرومة إن ضيعت % 28(@)(@@) % إن كان ظنك بالخيانة والقلي % % أن يشمت اللاحي عليك فقد شمت % 29(@)(@@) % و عمية الأوضاح خرساء الصدى % % عشيت على ضوء الصباح وأظلمت % 30(@)(@@) % مردت على عين الدليل ورأيه % فتخاله فيها أضل بما خرت % PageV01P314 31(@)(@@) % تتغاير البوغاء شميمه % فيها وينكر صوته والملتفت % 32(@)(@@) % مركوبة جوب المهاري جوها % % غرر المقامر فيه أخست أو زكت % 33(@)(@@) % و إذا الركاب استيأست في جهلها % % كيف النجاء توكلت واستسلمت % 34(@)(@@) % داوستها أبغى العلاء بهمة % لو شاورت أم الشقيق لما سمت % 35(@)(@@) % تفلى على الكرماء تنفض منهم % طرق المطالب أسهلت أو أحزنت % 36(@)(@@) % و وراءها لولا المطامع منهم % قرباء لو قنعت بهم ما أبعدت % 37(@)(@@) % نبه بني عبد الرحيم ولا تبل % معهم عيون الدهر كيف استيقظت % 38(@)(@@) % و استفتهم في المجد تسأل أنفسا % % لقنت على جهل الورى وتفهمت % 39(@)(@@) % خبث التراب وما عليه وماؤها % % شرف فطابت وحدها وتطهرت % 40(@)(@@) % فكأن زاكي عرقها لم يسق من % % ماء الزمان وفي ثراه ما نبت % PageV01P315 41(@)(@@) % قوم إذا حدر التناكر لثمهم % و جلا الصفاح أكفهم فتحسرت % 42(@)(@@) % كفرت وجوههم البدور وآمنت % لأكفهم أيدي السحاب فكفرت % 43(@)(@@) % شفعوا العلاء تليده بطريفه % % فتقدمت علياؤهم وتأخرت % 44(@)(@@) % ولدتهم الأرض التي قد أجمعت % في الأكثرين فأكيست وتنجبت % 45(@)(@@) % جاءت بهم وهي الولود كأنهم % % غرباء جاءوا في العقام أو القلت % 46(@)(@@) % متواردين على العلاء كأنهم % % ضربوا له ميقات يوم لم يفت % 47(@)(@@) % راضوا الأمور فتيهم كمسنهم % % سوم الكعوب تلاحقت فتنظمت % 48(@)(@@) % شرعوا إلى ثغر الخطوب ذوابلا % % لولا صنيعة نفسها ما فضلت % 49(@)(@@) % جوفا ترى الصم الصعاب وراءها % % في الحرب تقفو ما حذت أو مثلت % 50(@)(@@) % كتبوا على شهب الطروس لنا كما % % طعنوا على الخيل الوراد أو الكمت % PageV01P316 51(@)(@@) % و الجالس القوال منهم آخذ % منها بأنفاس الشجاع المنصلت % 52 
ms109	(@)(@@) % خذ من حديثهم حديث قديمهم % % و اعجب لأطراف العلا كيف التقت % 53(@)(@@) % و اسأل زعيم الدين عما خلفه % % من مجدهم فهو الشهادة والثبت % 54(@)(@@) % قمر هو المرآة عن أحسابهم % % مهما رأت مما يقابلها حكت % 55(@)(@@) % أدى فروضهم وسن نوافلا % % في المجد تممت الفروض وكملت % 56(@)(@@) % فضح السوابق مالك أشواطه % % جاري الرياح فحل عنه وقيدت % 57(@)(@@) % و تقرطت أيامه بيتيمة % منه صفت للناظرين وأشرقت % 58(@)(@@) % لم يدر جهد الغائصين وكيدهم % % من أي أصداف البحار استخرجت % 59(@)(@@) % قد جولوا فيها الظنون وأكثروا % % بالخوض لما استغربت واستعظمت % 60(@)(@@) % قالوا من البحر المحيط تصعدت % لا بل من الفلك المحيط تنزلت % PageV01P317 61(@)(@@) % بيضاء ملء يد المنى ملمومة % % ملك المنى وحوى الغنى من أعطيت % 62(@)(@@) % يا جامع الحسنات بعد شذوذها % % مزقا وموجدها أوان تعذرت % 63(@)(@@) % و مقطر الأقران عن صهوات ما % % ربطت من الرأي الأصيل وضمرت % 64(@)(@@) % كم واثق منهم بعصمة رأيه % % و حسابه من هفوة أو من غلت % 65(@)(@@) % ضايقته حتى أقر بعجزه % % لما وضعت لد يدك على النكت % 66(@)(@@) % و منطق ظن البلاغة آية % نصبت له علما وشخصا صورت % 67(@)(@@) % قال الكثير موسعا لهواته % عجبا فلما قلت واحدة سكت % 68(@)(@@) % حسب الفصاحة في التشادق وحده % % ما كل ما وصف الأسود به الهرت % 69(@)(@@) % و أرى الوزارة مذ حملت لواءها % % نصرت على فشل الولاة وظفرت % 70(@)(@@) % ساندت فيها ما عليك صلاحه % و فساده إن أصلحت أو أفسدت % PageV01P318 71(@)(@@) % ثنى أخوك أخاك فيها مسهما % % و بعثت ثالثها الذي بك عززت % 72(@)(@@) % أنتم فوارسها المذاود دونها % % إن حوربت وملوكها إن سولمت % 73(@)(@@) % و ظهوركم لصدورها مخلوقة % مظلومة إن ضويقت أو زوحمت % 74(@)(@@) % نصبت لكم وتمهدت فمتى طرا % % من غيركم طار نبت واستوحشت % 75(@)(@@) % هي ملككم فمتى استعيرت منكم % لتجمل وأردتموها استرجعت % 76(@)(@@) % أبناء نسبتها وأبعل عذرها % % و إذا عدتكم أعزبت وتأيمت % 77(@)(@@) % تفدى أبا الحسن التراب وطئته % % قمم هوت من تحت رجلك إذ علت % % 78(@)(@@) % و محدث بك في الوساوس نفسه % % نفس لعمرك ضلة ما سولت % 79 
ms110	(@)(@@) % لو ثاقلوك به وألقي يذبل % معه لكانت قسمة ما عدلت % 80(@)(@@) % أغنيتني بك عن سواك فلم أبل % فتحت أنامل معشر أو أقفلت % PageV01P319 81(@)(@@) % و سقيت أعذب شربتيك فما أرى % % بأسا ببارقة همت أو أخلبت % 82(@)(@@) % و صفوت لي بالود والصهباء لم % % تشب العقول بطعمها حتى صفت % 83(@)(@@) % أنكرت ود أخي وعهد أحبتي % % و كريم عهدك طينة ما أخلقت % 84(@)(@@) % فمتى طلبت من الزمان سواك أو % % شرواك فاشهد أن ذاك من العنت % 85(@)(@@) % و لترضينك ما سمعت نواهض % بالشكر لم تخف اللغوب ولا ونت % 86(@)(@@) % يقضين ما أسلفن من ايدي غنى % وسعت حقوق المقرضين وأفضلت % 87(@)(@@) % يغنى بها العرض الفقير وإن رأت % % عرضا غنيا زيدته وأثلت % 88(@)(@@) % ريحانة ما استشفت أرواحها % % و سلافة تصحى إذا ما أسكرت % 89(@)(@@) % تقضي على الألباب أين خلاصها % % من شوبها ما استحظيت أو ألغيت % 90(@)(@@) % ضجت منابرها بدعوتها لكم % % فلو ادعت بكم النبوة صدقت % PageV01P320 91(@)(@@) % إن صاحبت يوما اليكم عاطلا % % حلته أو تفل النواحي عطرت % 92(@)(@@) % و المهرجان وكل يوم عاكم % % في لطفه مما كست أو زخرفت % 93(@)(@@) % فتملها وتمله متلوة % و مقابلا ما كر أو ما أنشدت % 94(@)(@@) % حتى ترى الأجداث تنفض أهلها % % و الشمس في خضرائها قد كورت % PageV01P321 البحر : - 1(@)(@@) % لمن الحمول سلكن فلجا % % يطلعنه فجا ففجا % % 2(@)(@@) % يخبطن بالأيدي الطري % % ق فما يكدن يجدن نهجا % % 3(@)(@@) % سود بما صبغ الهج % % ير جلودهن الحمر وهجا % % 4(@)(@@) % من كل حاملة الهلا % % ل بنى عليها البين برجا % % 5(@)(@@) % بيتا يسير وفيه قلب % % ك فهو جسمك خيل حدجا % % 6(@)(@@) % لك من وراء سجوفه % % ما أوسعتها الريح فرجا % % 7(@)(@@) % رمح ونصل لا كما % % سموهما هيفا وغنجا % % 8(@)(@@) % كالبيض لم تلح السما % % ثم كنهن فلحن بلجا % % 9(@)(@@) % لم أيسن من الظلا % % م رفعن لي فنظرن سرجا % % 10(@)(@@) % و على الطليعة فارد % كالرئم خاف فرام ملجا % % PageV01P322 11(@)(@@) % خالست قبلته الوشا % % ة ادغمت الحرف دمجا % % 12(@)(@@) % ففتحت عن غر تم % % ج المسك والصهباء مجا % % 13(@)(@@) % لو لم تكن مخلوقة % للرشف لم 
ms111	 يخلقن فلجا % % 14(@)(@@) % و مؤاخذ أن حرت يو % % م وداعه والبين يفجا % % 15(@)(@@) % لو كان خاصمني بعي % % شي وحده كان الأحجا % % 16(@)(@@) % و بسيطة دون العلا % % ء نفضتها نشرا ودرجا % % 17(@)(@@) % كلفت حاجاتي بها % % مرحا يرى التغرير أحجي % % 18(@)(@@) % و أخ صفوت كما صفا % % و مزجت لما شاء مزجا % % 19(@)(@@) % رمت التمام لوده % % و أراد إجهاضنا وخدجا % % 20(@)(@@) % أمعي هزيلا ثم أن % % ت علي إن أعطيت نفجا % % PageV01P323 21(@)(@@) % و مفارق لي كابن عيسى غم أيامي و % % أرجى % 22(@)(@@) % راودت قلبي عن نوا % % ه فكلما لاطفت لجا % % 23(@)(@@) % و حملتها كالداء أش % % رج فوقه الأضلاع شرجا % % 24(@)(@@) % متنظرا هذا الإيا % % ب لعرها كيا ونضجا % % 25(@)(@@) % فإن انتصرت بقربه % % فلقل صبرت وكنت ملجا % % 26(@)(@@) % أو عدن أيامي الحسا % % ن به فقد أسلفن سمجا % % 27(@)(@@) % يا بن الوزارة أثبتت % في بيته وتدا أشجا % % 28(@)(@@) % أبلى وأخلق قومه % أثوابها فورثن نهجا % % 29(@)(@@) % يتنقلون على مرا % % كبها فما يضعون سرجا % % 30(@)(@@) % و مشت أمور بعدهم % % بمعاشر فمشين عرجا % % PageV01P324 31(@)(@@) % من آل ماسرجيس مح % % سود العلا يخشى ويرجى % % 32(@)(@@) % متقيل في المجد سن % % ة مغرمين به ألجا % % 33(@)(@@) % جارين سد الجو شو % % طهم وشق الأرض رجا % % 34(@)(@@) % فصل الخطابة ناطق % ما قال إلا كان فلجا % % 35(@)(@@) % مستردفا يده وأخ % % رس عج في القرطاس عجا % % 36(@)(@@) % كالرمح صدره % و كعوبه نصلا وزجا % % 37(@)(@@) % هذا يمج بما يخ % % ط وذاك يخد درجا % % 38(@)(@@) % ملك السماح يديه يم % % رج فيهما العافين مرجا % % 39(@)(@@) % مغري بأثقال النوا % % ل يخالها دينا وخرجا % % 40(@)(@@) % سوغتني ودا غبر % % ت برنقه غصان أشجى % % PageV01P325 41(@)(@@) % و سحرتني بخلائق % كن العيون فكن دعجا % % 42(@)(@@) % فلتطرقنك ما بكر % % ن غواديا وسرين دلجا % % 43(@)(@@) % زهر كثابته النجو % % م سوائر يهدجن هدجا % % 44(@)(@@) % موسومة بك أنك ال % % مقصود فيهن المرجى % % 45(@)(@@) % ما أنشدت خلت البرو % % د عرضن تفويفا ونسجا % % 46(@)(@@) % و سواك يسمعها فيح % % زن سمعه من حيث يشجى % % 47(@)(@@) % يرتاب منها بالثنا % % ء كأنه بالمدح يهجى % % 48(@)(@@) % خادعته 
ms112	 فأضر بي % % غشى وكان الصدق أنجى ة % % 49(@)(@@) % فتملها ما راح سر % % ح أو رأيت البيت حجا % % PageV01P326 البحر : - 1(@)(@@) % أشوقا و من تهوى خلي الجوانح % لك الله من وافى الأمانة ناصح . % 2(@)(@@) % فما كل عهد بالسليم على النوى % % و لا كل ثاو حافظ عهد نازح % 3(@)(@@) % حبيبك من خلفت بين ضلوعه % % و سرت فؤادا لا يلين لكاشح % % 4(@)(@@) % لمن منزل أنكرته فعرفته % % و قد راح أهلوه بطيب الروائح % 5(@)(@@) % خليلي والواشون حولى عصابة % فمن مسرف في لومه ومسامح % 6(@)(@@) % أجل في جناب الركب طرفك هل ترى % % أسى بارحا أو طائرا غير بارح % 7(@)(@@) % و خلف الستور الرقم من كان بينه % على طول ما سترت حبي فاضحى % % 8(@)(@@) % و هبت له عيني وقلبي وإنما % % لعزته هانت علي جوارحي % % 9(@)(@@) % أفي كل دار صاحب أصلحت له الر % % عاية قلبي وهو لي غير صالح % 10(@)(@@) % و خاطب شكر يرخص البخل مهره % عليه فيمسي وهو الأم ناكح % PageV01P327 11(@)(@@) % أهز بعتبي منه طودا كأنني % % أريد لأكسو العير جلدة سابح % % 12(@)(@@) % إذا ما عليل البخل لم يبر داءه % % مخافة هاج لم يثب قول مادح % 13(@)(@@) % بلى . في فتى من أسرتي إن شكرتها % % منائح تعطيه حلالامدائحي % % 14(@)(@@) % هنيئا لكم يا طالبي سيب كفه % % أبيحت قليبا فليفز دلو ماتح % 15(@)(@@) % يخيم غاد للسؤال ورائح % بساحة غاد للسماحة رائح % 16(@)(@@) % صباحك واليروز يجلوه فانعمن % % رأي خير مصبوح رأي خير صابح % 17(@)(@@) % هو الجدع فاستقبل به بكر عامه % % و إن كان مما كر في سن قارح % 18(@)(@@) % إذا وجه يوم غيره كان عابسا % % تبسم عن ساعات أبلج واضح % % 19(@)(@@) % و عش بين جد للخطوب محارب % حرى وجد للسعود مصالح % 20(@)(@@) % سليما على الأيام طرا طوالها % % رقاق العشايا يا صالحات المفاتح % PageV01P328 البحر : - 1(@)(@@) % لها بعد خطو لات حين مراح % قضاء بوصل غدوة برواح % 2(@)(@@) % و هل هي إلا رقدة فاسمحا بها % % و حسبكما أن توقظا لسماح % 3(@)(@@) % و إلا فسير الريح أسرع طية % و كم هب لي شوق هبوب رياح % 4 
ms113	(@)(@@) % أقول لها والنهروان طريقها % % هناك اسنحى لا زلت طير نجاح % 5(@)(@@) % ألمى بها في السحب ثم تحفلي % % فسحبي تحياتي بأنضر ساح % 6(@)(@@) % و قولي سلام يا بن روح تظنه % % صبيبة طل في صبابة راح % 7(@)(@@) % شكوت فيا للشوق أين تصبري % % و نمت فيا لليل أين صباحي % % 8(@)(@@) % و غرك إسماحي فسرك أن ترى % % إذا عنف المقتاد كيف جماحي % % 9(@)(@@) % رعى الله ظبيا ساحا لي رعته % % بنفرة قلب للعقوق مباح % 10(@)(@@) % و توهب للعذر الصراح مودتي % % لديك وبعض العذر غير صراح % PageV01P329 11(@)(@@) % رسائل تعدوني وكتب تجوزني % % صداي على ماء يذاد قراح % 12(@)(@@) % تلوح لعيني كلما مر خاطف % % بناحية منها بكت بنواحي % % 13(@)(@@) % بمن ليت شعري وهي ليت تعجب % يرد شبابي إن حملت سلاحي % % 14(@)(@@) % أبن لي هل جاذبتني في مودة % فعيرتني يا صاح عيرة صاح % 15(@)(@@) % و هل رمت أسباب السماء لبغية % فحلقت إلا طائرا بجناحي % % 16(@)(@@) % سقى الله نفسي كيف يكرم عهدها % % على نفر ممن أحب شحاح % 17(@)(@@) % أروم انتصارا منك ثم يردني % % هوى لم تدنسه ملامة لاحي % % 18(@)(@@) % فأغمد في الود الحداد صوارمي % % و أكسر في الحب السداد رماحي % % 19(@)(@@) % فلا تنكرن هذي العوائد إنما % % لساني سكران وقلبي صاحي % % 20(@)(@@) % و لا تلزمني في العتاب بقية % فسادك فيها فاتك بصلاحي % % PageV01P330 21(@)(@@) % و لما أتاني ما أقر جوارحي % % و أبرأ من تلك الهنات جراحي % % 22(@)(@@) % خلطت التهاني بالتشاكي مرجيا % بموضع جدي أن يكون مزاحي % % 23(@)(@@) % و بعد فيا لله أية فرحة % تخبرني عن أي فوز قداح % 24(@)(@@) % إذا كانت الجوزاء للمشتري حلى % و كان قباح غيرها لقباح % 25(@)(@@) % فما اتفق السعدان حتى تكافآ % % أعز في أعز بطاح % 26(@)(@@) % و لو قيل غير الشمس سيقت هدية % إلى البدر لم أفرح له بنكاح % 27(@)(@@) % فأنتم بنو مال على الدهر هالك % وقاء لأعراض عليه صحاح % 28(@)(@@) % شباب مراجيح تفرعت النهي % % بهم عن شيوخ في الندى ملاح % 29(@)(@@) % تعقب غدا يمنا وسعدا بها أبا ال % % حسين وسعيا مؤذنا بنجاح % 30(@)(@@) % كأنك بالأشبال حولك ربضا 
ms114	 % % ليوم رواء أو ليوم كفاح % PageV01P331 31(@)(@@) % صباحا صباحا كل يوم بشارة % إلى سبعة مثل البدور صباح % PageV01P332 البحر : - 1(@)(@@) % ما كان سهما غار بل ظبي سنح % إن لم يكن قتل الفؤاد فقد جرح % 2(@)(@@) % جلب الجمال يريد أنفسنا به % % ثمنا فتاجرناه فيه كما اقترح % 3(@)(@@) % أرجت جنان السفح فيه بنافض % ردنيه عن عرف الجنان إذا نفح % 4(@)(@@) % عرق المجاسد فاض ماء شبابه % % و الورد أطيب منه ريحا ما رشح % 5(@)(@@) % في جيده الكافور سبحة عنبر % ما كان أغفلني وليس عن السبح % 6(@)(@@) % و أما ومشيته توقر تارة % % صلفا وأحيانا يجن من المرح % 7(@)(@@) % و مواعد لي في خلال وعيده % % مزجت بدمع صبابتي دمع القدح % 8(@)(@@) % لأشاطرن هواه جسمي إن وفى % و لأبخلن على العواذل إن سمح % 9(@)(@@) % راحت تعنف في الصبا ما آن أن % % يثنيك عن أشر الثني نهى القرح % 10(@)(@@) % و الخمس والعشرون تعذر فاسدا % % لو ناهزته الأربعون وما صلح % PageV01P333 11(@)(@@) % مناك ظنك بي غرورا أنني % % أصحو وفي الظن المحال المطرح % 12(@)(@@) % كالليث والغمر استغر بثغره % % فدنا إليه فاسئلي عما كلح % 13(@)(@@) % و الصاحب التمس الغمام تشبها % % بيديه لا جرم انظري كيف افتضح % 14(@)(@@) % جاراهما ويكاد يغرق فيهما % % بالجود إلا أنه فيه سبح % 15(@)(@@) % للعز ما منع الحسين فلم تنل % % كف الزمان وللمكارم ما منح % 16(@)(@@) % إن هم أبصر غايتيه بحزمه % % كالطرف يدرك نوره أني طرح % 17(@)(@@) % أو جد في خطب كفاه ووجهه % % متبسم فيقول حاسده مزح % 18(@)(@@) % كم نعمة لم تلهه عن عصمة % و جماد عام لم يعقه أن انفسح % 19(@)(@@) % و مدامة عذراء بات نديمها % % و بغارة شعواء يومئذ صبح % 20(@)(@@) % رفقا فجربه وقل في ناره % % إن أضرمت وقد اشتواك بما لفح % PageV01P334 21(@)(@@) % و اهتز كلكله فكنت سحيقة % بددا فأين يكون ركنك إن نطح % 22(@)(@@) % بي أنت ضج السيف حتى إنه % % لو كان يوم يسل ذا صوت لبح % 23(@)(@@) % و شكا جوادك في الضوامر بثه % % لما استراحت وهو تحتك لم يرح % 24(@)(@@) % طرف تعود أنه لو طارد ال 
ms115	 % % ريح الشمال عليه فارسه بطح % 25(@)(@@) % و أغر يسرج يوم يسرج وجهه % زهر الكواكب قام فيها أو سرح % 26(@)(@@) % و مؤدب الأعضاء لا يهفو به % % جنباه ما حس الغلام وما مسح % 27(@)(@@) % فسواه ما خلع اللجام ومد طغ % % يانا وما منع الركاب وما رمح % 28(@)(@@) % و لك المقام زأرت فيه والقنا % % أجم فهان على عرينك من نبح % 29(@)(@@) % و الرأي أعجزه الصواب فلم يشر % فيه سواك ولو أشار لما نصح % 30(@)(@@) % أمؤاخذي كرما علي قضيته % إن ضاق عنه لسان شكري أو رزح % PageV01P335 31(@)(@@) % غفرا متى قصرت عنك فإنني % % بالمدح أولى لو بلغتك بالمدح % 32(@)(@@) % هذا ولم تحفزك قدرة خاطري % % ما جاءه عفوا وما فيه كدح % 33(@)(@@) % كم نومة للعاشقين وهبتها % % ليلا أراقب ديكه حتى صدح % 34(@)(@@) % و الليلة البهماء تولد فكرتي % % غراء يحسدها الصباح إذا وضح % 35(@)(@@) % و لأنت باستحسانها أنطقتني % % و شرحت بالإكرام صدري فانشرح % 36(@)(@@) % و نسيت ما أعطيتنيه وفيهم % حاشا سماحك من إذا أعطى لمح % 37(@)(@@) % فلغيرك المتسهل المبذول في اس % % ترخاصه ولك الغرائب والملح % PageV01P336 البحر : - 1(@)(@@) % لمن الحمول بجو ضاحي % % من باكر غلسا وضاحى % % 2(@)(@@) % مثل الأداحي تحتها % % أمثال أمات الأداحي % % 3(@)(@@) % يحملن أقمارا حمل % % ن السقم في مقل صحاح % 4(@)(@@) % من دون أطراف الحدي % % ث لهن أطراف الرماح % 5(@)(@@) % من مخبري عن رائح % % ين نكرت بعدهم مراحي % % 6(@)(@@) % هيهات لو صدق الدلي % % ل سألت ليلي عن صباحي % % 7(@)(@@) % و النجم يحمل كأسها % % منها الحباب بغير راح % 8(@)(@@) % حظر الكرى من لا يطا % % ع سواه في حظر المباح % 9(@)(@@) % راض إذا سفك الدما % % ء بما تقلد من جناح % 10(@)(@@) % كثر الملاح وما له % % مثل بإقرار الملاح % PageV01P337 11(@)(@@) % بأبي ثناياه لقد % % غولطت عنها بالأقاحي % % 12(@)(@@) % غلط المقايس بابن أي % % وب السحابة في السماح % 13(@)(@@) % و محمد أزكى نسي % % م ثرى وأندى بطن راح % 14(@)(@@) % و أعتم حين يخص جو % % د الغيث ساحا بعد ساح % 15(@)(@@) % طالت به عين إلى ال % % علياء واسعة الطماح % 16(@)(@@) % و يد تقلب 
ms116	 أنملا % % ت مكارم سبط سجاح % 17(@)(@@) % لم تدر أن الله خا % % لق هذه الأيدي الشحاح % 18(@)(@@) % من معشر يتذممو % % ن المال ليس بمستباح % 19(@)(@@) % لا يطعمون مع العش % % ي حلاوة النعم المراح % 20(@)(@@) % فإذا تزاحمت الوفو % % د على بيوتهم الفساح % PageV01P338 21(@)(@@) % يسروا فكان لمن يفو % % ز بضيفه فوز القداح % 22(@)(@@) % في عرضهم سرف القصا % % ص وما لهم هدر الجراح % 23(@)(@@) % فإذا انتضوا زبر الصحا % % ئف ثلموا زبر الصفاح % 24(@)(@@) % و إذا قيامة سؤدد % كذبتك في الصور القباح % 25(@)(@@) % بلجوا على ضوء الصبا % % ح ببهجة الغرر الصباح % 26(@)(@@) % لبيك عدة ما اكتسب % % ت وقد دعوتك من صلاح % 27(@)(@@) % و ضممتني والدهر مج % % تمع الصروف على أطراحي % % 28(@)(@@) % و إذا شهرت عليه سي % % فا عاد يدميني جراحي % % 29(@)(@@) % قد كنت مقترحا فجا % % ء بك الزمان على أقتراحي % % 30(@)(@@) % لا توسعني من نوا % % لك فوق ما يسع امتداحي % % PageV01P339 31(@)(@@) % دعني أطير بشكره % % ما دام يحملني جناحي % % 32(@)(@@) % في كل شاردة مبا % % عدة الغدو مع الرواح % 33(@)(@@) % بكر ولود من بنا % % ت الناتجات بلا لقاح % 34(@)(@@) % أحبوك منها كل عي % % د بالخريدة والرداح % 35(@)(@@) % تصف اللطائم طيبها % % من طيبك الشرف الصراح % % 36(@)(@@) % ما كسرت رجم الجما % % ر وسوقت بدن الأضاحي % % PageV01P340 البحر : - 1(@)(@@) % أغش بآمالي كأني أنصح % و أبقى لأشقى بالبقاء وأفرح % 2(@)(@@) % و أصبو إلى وجه من الدهر مسفر % ضحوك ووجهي في الخمار مكلح % 3(@)(@@) % و يعجبني إملاء يوم وليلة % و ما الموت إلا غابق أو مصبح % 4(@)(@@) % مطلت بديني والغريم مصمم % و أحسنت ظني والمسيء مصرح % 5(@)(@@) % تدمى المنايا الناس حولي وإنما % % دمي ذاك في أثوابهم يتنضح % 6(@)(@@) % و أسلو إذا أبصرت جلدي أملسا % % و ما صحة في الجلد والقلب يجرح % 7(@)(@@) % إذا مر يستقري من الهالك الردي % % يميل في أبنائه ويرجح % 8(@)(@@) % تطامنت أرجو أن أفوت لحاظه % % فأخفي وعين الموت زرقاء تلمح % 9(@)(@@) % و قد غرني ليل الشباب فأين بي % % أضل وفجر الشيب عريان مصبح % 10(@)(@@) % و أقرب شيء من قضيب جفوفه 
ms117	 % إذا الورقات الخضر ظلت تصوح % PageV01P341 11(@)(@@) % تتيم بالعمر الجذاع وخانهم % % فما لي أرجو وده حين أنزح % 12(@)(@@) % و قد كان قدامى مدى منه يرتجى % % هو اليوم ملقى من ورائي يطرح % 13(@)(@@) % حسوت بمر الدهر حبا لحلوه % % فطورا يصفى لي وطورا يصبح % 14(@)(@@) % إذا برني في صاحب بز صاحبا % % أغنى بشعري تارة وأنوح % 15(@)(@@) % أبيح التراب أوجها كان مسخطي % % على الشمس منها الساهم المتلوح % 16(@)(@@) % و أحثو بكفي أو أشق حفيرة % يهال على قلبي ثراها ويصرخ % 17(@)(@@) % ترى الحق مطروفا وتعشى لواحظ % يراقصها هذا السراب الملوح % 18(@)(@@) % يود الفتى أن البسيطة داره % و ما فوقها مال عليه يروح % 19(@)(@@) % و سيعة بطن جل ما هو محرز % و مطرح جنب جهد ما يتفسح % 20(@)(@@) % تبايعنا الدنيا منى بنفوسنا % % فتوكس غبنا والمبايع مصلح % PageV01P342 21(@)(@@) % فلا نحن من فرط الخسارة نرعوي % % و لا هي ترضى فرط ما هي تربح % 22(@)(@@) % فما لك يا دنيا وأنت بطينة % و نحن خماص تبخلين ونسمح % 23(@)(@@) % ألا طرقت لا يملأ الليل صدرها % % و لا تتحاشى صارخا حين تصبح % 24(@)(@@) % مغلغلة لا طود يعصم ما ارتقت % % و لا موئل من حيث تهبط أبطح % 25(@)(@@) % وصولا إلى البيت الذي تستضيفه % % و لا موقد يوري ولا كلب ينبح % 26(@)(@@) % لها من قرى ما استصلحت وتخيرت % حشايا توطى أو صفايا تذبح % 27(@)(@@) % أصابت صريح المجد من حيث ينتمي % % و غضت لحاظ الفضل من حيث تطمح % 28(@)(@@) % و حلت فحكت بركها من محمد % بجانب ركن لم يكن قبل ينطح % 29(@)(@@) % قويم على عرك الخطوب فما له % % و قد زحمته زحمة يتطوح % 30(@)(@@) % سلا مقعص الأقران من أي طعنة % تقطر عن ظهر الكفاية يطرح % PageV01P343 31(@)(@@) % و قاطع مثناة الحبال حرانه % بأي زمام قيد يعنو ويسمح % 32(@)(@@) % و من هز من بين الوسائد طوده % و في دسته ثهلان لا يتزحزح % 33(@)(@@) % و قولا وإن لم يخرق الترب صائح % إليه ولم يفهم صدى الأرض موضح % 34(@)(@@) % أبا حسن أما الرجاء فخائب % % و أما الرجا فيما نعاك 
ms118	 فمنجح % 35(@)(@@) % حملت الرزايا جازعا ثم صابرا % % على ذاك حسن الصبر بعدك يقبح % 36(@)(@@) % و واصلت من أحببت ثم فقدته % فما نازل إلا وفقدك أبرح % 37(@)(@@) % ذكرتك إذ غص الندي فلم يشر % نصيح ولم ينطق لسان مفصح % 38(@)(@@) % و لا أضمرت صدقا معاقد حبوة % جثا بفخار ربها يتبجح % 39(@)(@@) % و قد غاض بحر كان فكرك مده % % و أرتج باب كان في فيك يفتح % 40(@)(@@) % و قد جاء نجم من جمادى بليلة % بليل يريك الطول أن ليس تصبح % PageV01P344 41(@)(@@) % يسائل عن أطناب بيتك ضيفها % % ردائد خطف البرق فيما تلوح % 42(@)(@@) % تعيف طيرا بارحات يسرنه % بفقدك قد كانت ميامين تسنح % 43(@)(@@) % فبات صعيد الأرض والريح زاده % شقيا بما يستاف أو يتنقح % 44(@)(@@) % بليلة بؤس فات معتامها القرى % % كما فاتها منك المصلى المسبح % 45(@)(@@) % و للأمر كنت الليث إما حفظته % تعاوت تعاطاه ثعالب تضبح % 46(@)(@@) % رعى بعدك الشق الذي كنت حاميا % له وعتا الخرق الذي كنت تنصح % 47(@)(@@) % و خلى للعجز التنافس واستوى % % على الجهل سرح سائم ومسرح % 48(@)(@@) % و قام رجال كان فضلك مقعدا % % لهم فتراءوا للعلا وترشحوا % % 49(@)(@@) % بلا عائب تزري على سيئاتهم % % محاسنه والنقص بالفضل يفضح % 50(@)(@@) % لئن حرصوا فيما عمرت تعافه % فربت ساع للدنية يكدح % PageV01P345 51(@)(@@) % تمالوا على ما كنت تأباه أوحدا % و منوا بما استضعفته وتمدحوا % % 52(@)(@@) % و ما ازدحموا أن القذى بعدك انجلى % % عن الماء لكن يشربون وتقمح % 53(@)(@@) % فداك وهل حي فداء لميت % قصير الخطا يكبو بما كنت تجمح % % 54(@)(@@) % تعجب لما ساد من حظ نفسه % % و قد يدرك الجد الدني فيفلح % 55(@)(@@) % و لما رأيت الدهر ضاقت ضلوعه % بحملك وهي للئام تفسح % 56(@)(@@) % أنفت من الدنيا الذليلة عارفا % % إذا عيشة ضامتك فالموت أروح % 57(@)(@@) % و ذكرنيك الود أحليت طعمه % % و أصفيت فهو الآن يقذي ويملح % 58(@)(@@) % ضربت عن الإخوان صفحا مؤملا % % بأن الردى لي عنك وحدك يصفح % 59(@)(@@) % و أغنيتني ودا ورفدا بحاجة % من اليوم ما أرتاد أو أتمنح % 60(@)(@@) % أعلل نفسي عنك لو أن 
ms119	 مسقما % % يفيق بنوع من جوى أو يصبح % PageV01P346 61(@)(@@) % و أرقع أيامي أروم صلاحها % % و قد فسد العيش الذي كنت تصلح % 62(@)(@@) % سألت بك الأيام أرجو مسرة % فلما أبت إلا التي هي اترح % 63(@)(@@) % ضحكت إلى ناعيك أحسب أنه % % و قد جد إكبارا ليومك يمزح % 64(@)(@@) % عفا ربع أنسي منك ضيقا وما عفا % % بساحة قلبي منزل لك أفيح % 65(@)(@@) % به ساكن من طيب عهدك عامر % يريح عزيب الحزن من حيث يسرح % 66(@)(@@) % إذا ذبلت فيه على الصبر جمرة % خمودا ورى زند من الذكر يقدح % 67(@)(@@) % و ذاك اللسان الرطب لا زال في فمي % % هو اليوم يرثي مثله أمس يمدح % 68(@)(@@) % يقول وإن لم يغن عنك وإنما % % ملأت إناء نعمة فهو يرشح % 69(@)(@@) % و لو رد قبلي الموت بالشعر أو مضى % % شبا لسن أو عاش في الدهر مفصح % 70(@)(@@) % نجا لائذا بالعز في غير قومه % % و قد سبق الناس الغريب المقرح % PageV01P347 71(@)(@@) % و مستنزل النعمان عن سطواته % % ينتقي من عذرة وينقح % 72(@)(@@) % و عروة لم يصغ الردى لنسيبه % % و لم يعط في قيس مناه الملوح % 73(@)(@@) % و غير غيلان المهاري بعنسه % فلم تنجه من عدوة الموت صيدح % 74(@)(@@) % و لكنه شرط الوفاء وغمة % على الصدر باستخراجها أتروح % 75(@)(@@) % ذممت فؤادي فيك والحزن محرق % و عاتبت جفن العين والدمع مقرح % 76(@)(@@) % و ما عجب للدمع أن ذل عزه % % فما جم إلا أنه لك ينزح % 77(@)(@@) % و أقسم ما جازاك قلب بما طوى % % غليلا ولا قول يطول فنشرح % 78(@)(@@) % و لا كان في حكم الوثيقة أن أرى % % عليك الثرى كلا وجسمي ريح % 79(@)(@@) % و ما أنا إلا قاعد عن فضيلة % إذا قمت فيها مائلا أترنح % 80(@)(@@) % سقاك وإن كان الثرى بك غانيا % % عن السحب غاد بالحيا متروح % PageV01P348 81(@)(@@) % حمول لماء المزن تطفو لصوبه % % فواغر أفواه الجواء فتطفح % 82(@)(@@) % إذا خار ضعفا أو تراخى حدت به % % مواقر من نوء السماكين دلح % 83(@)(@@) % يجفل طرد الريح فيها كأنها % % سفين جوار أو مراسيل جنح % 84(@)(@@) % شجاع كأنت 
ms120	 أو جواد بمائه % % فإن عاقه ضن فعيني تسفح % 85(@)(@@) % ليعلم قبر بالمدينة أنني % % من الغيث أوفي أو من الغيث أسمح % PageV01P349 البحر : - 1(@)(@@) % أمرتكم أمري بنعمان ناصحا % % و قلت احبسوها تلحق الحي رائحا % % 2(@)(@@) % فماريتموني تخبرون اجتهادها % % فأبتم بلا حاج وأبن طلائحا % % 3(@)(@@) % و قد صدقتني في الصبا عن مكانهم % % أخابير أرواح سبتني نوافحا % % 4(@)(@@) % كأن الثرى من طيبها فت فوقه % % مجيزون من دارين فأرا فوائحا % % 5(@)(@@) % لقاء على نعمان كان غنيمة % و هيهات يدنو بعد أن فات نازحا % % 6(@)(@@) % حمى دونه حر السماوة ظهرها % % و عبس وجها ناجر فيه كالحا % % 7(@)(@@) % إلى الحول حتى يشرب القيظ ماءهم % % بنجد وإما يسلخون البوارحا % % 8(@)(@@) % لعلك في إرسالي الدمع لائم % و قد عطف الناس المطي جوانحا % % 9(@)(@@) % نعم قد تجرعت الدموع عليهم % عذابا وأقرحت الجفون الصحائحا % % 10(@)(@@) % و ما قلت غاضت بالبكاء ركية % من العين إلا أرسل الشوق ماتحا % % PageV01P350 11(@)(@@) % فهل ظبية بالغور يجزي وفاؤها % % هوى لم يطع فيها على النأي كاشحا % % 12(@)(@@) % إذا اعترضته من سلو معوضة % محاسن في أخرى رآها مقابحا % % 13(@)(@@) % و من أين ينسى من يرى الغصن مائلا % % مثالك والظبي المروع سانحا % % 14(@)(@@) % أرى عينه عينيكو الغور بيننا % % فأدمى لقد أبعدت يا سهم جارحا % % 15(@)(@@) % يعنف في حب البداوة فارغ % من الوجد لم يقر الغرام الجوانحا % % 16(@)(@@) % فيا ليت لي من دار قومي واسرتي % % جوارك رواحا عليك وصابحا % % 17(@)(@@) % و من ترهات الريف أرضا قطنتها % % من الجدب فيها يأكلون النواضحا % % 18(@)(@@) % إذا ما شربت الوصل عذبا مرقوقا % % بها لم أعف أن أشرب الماء مالحا % % 19(@)(@@) % دعوني ونعمان الأراك أروده % % يجاوب صوتي طيره المتناوحا % % 20(@)(@@) % عسى سارح من دار مية يامن % يقيض لي عن شائم طار بارحا % % PageV01P351 21(@)(@@) % سقى ما سقت خدي الدموع الحيا الغضا % % بواكر من جماته وروائحا % % 22(@)(@@) % فكم ليلة فيه نضوت حميدة % و ألبست يوما برقع العيش صالحا % % 23(@)(@@) % وهم ترى القلب الرحيب وراءه % % من الضيق لهفا يستعيب المراوحا % % 24(@)(@@) % تلطفته حتى وجدت مفارجا % % لصدري من غماته 