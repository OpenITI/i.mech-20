ms241	 به % % حتى يقوم على رغم الطواغيت % 4(@)(@@) % أترتضي لحقوقي رعي ذي عور % وقد جعلتك رجما للعفاريت % 5(@)(@@) % وقد فتحت عليك الشرق متصلا % بالغرب لم تخل من نصر وتثبيت % % 6(@)(@@) % ألم يكن قدر حقي أن توفيه % % إلا أعيور لا يهدي لتوقيت % 7(@)(@@) % لو كان حقك ما رعيت موقفه % إلا بأعين نظام اليواقيت % 8(@)(@@) % لكن حقي خسست الرقيب له % % فوقته الدهر مأخوذ بتنحيت % 9(@)(@@) % راعيت حقي بذي عين مقوتة % أجريت رزقي عليه غير تقويت % 10(@)(@@) % ماذا يكون جواب المرء حينئذ % أعاذك الله من لؤم وتبكيت % PageV01P890 11(@)(@@) % طهر ثيابك ممن لا يؤهله % عند العطاس ذوو التقوى لتشميت % 12(@)(@@) % طهر ثيابك ممن لا ثياب له % % من ذنبه غير أطمار مهاريت % 13(@)(@@) % سيره عنك إلى رستاق معجلة % أو قفرة من قفار الأرض سختيت % 14(@)(@@) % معادن الزفت أولى أن تلائمه % يا معدن المسك فانبذه إلى هيت % 15(@)(@@) % أبا علي وظلما ما كنيت بها % % لقد ضللت بأتياه سباريت % 16(@)(@@) % كيف النجاة وقد أوغلت معتسفا % ولست بين فيا فيها بخريت % 17(@)(@@) % أقبلت أعور عوارا تحاربني % % وما العواوير أكفاء المصاليت % 18(@)(@@) % ماذا دعاك بلا أجر تطالبه % إلى قتالك قدام التوابيت % 19(@)(@@) % نبهت حربي وكانت عنك راقدة % فاصبر لأنكر تصبيح وتنبيت % 20(@)(@@) % كأنني بك قد قابلت نائرتي % % بالخرق تخبط فيه خبط عميت % PageV01P891 21(@)(@@) % كمتق لفح نار يستعد لها % % بالجهل در عين من نفط وكبريت % 22(@)(@@) % فكان عونا عليه ما استعان به % % وشتتته يداه أي تشتيت % 23(@)(@@) % أصبحت أعيا أخي عي وأهذره % قبحا لكل غبي غير سكيت % 24(@)(@@) % يلقيك في الغي عي ناطق أبدا % ويسلم المرء ذو العي الصميميت % 25(@)(@@) % خذها تبوعا لمن ولى مسومة % كأنها كوكب في إثر عفريت % PageV01P892 البحر : - 1(@)(@@) % أصلع يكنى بأبي الجلحت % حبلق كالماعز الكلوخت % 2(@)(@@) % ذو هامة مثل الصفاة المرت % تنصب في مهوى جبين صلت % 3(@)(@@) % تبرق بالليل بريق الطست % صبحها الله بقفد سخت % 4(@)(@@) % ولحية مثل غراب الحمت % كأنها مدهونة بزفت % 5(@)(@@) % سرحها الله له بالسلت % تعرفه الأنباط بالبذنقت % 6(@)(@@) % وفارس الأحرار بالبذنخت % قضى عليه 
ms242	 بقضاء بت % 7(@)(@@) % من أكل الناس لخبز بحت % يلته بالريق أي لت % 8(@)(@@) % أحسب حساب بني نوبخت % بأنه نحس شقي البخت % 9(@)(@@) % يلقط حب الأدم المنفت % لقط حمام جاء من جيرفت % 10(@)(@@) % كأنما يلقطه بشقت % يؤدي الندامى بعد طول الصمت % PageV01P893 11(@)(@@) % يذكر حمدان عميد البرت % معبس الوجه طويل السكت % 12(@)(@@) % كأنما عض على جلفت % أثقل من طلعة يوم السبت % 13(@)(@@) % على ابن كتاب بليد هبت % مذبذب بين الجهات الست % 14(@)(@@) % ابن كبنت وأخ كأخت % % PageV01P894 البحر : - 1(@)(@@) % إلف لنا بارع الصفات % % غراب بين المغنيات % 2(@)(@@) % مكدح شهرنا بكي % مطفل فائق الثبات % 3(@)(@@) % لا يؤمن الناس من غدو % و ولا رواح ولا بيات % 4(@)(@@) % قد اشترى الدور من ذويها % % وطالب القوم بالبتات % 5(@)(@@) % يا مسلمون انفروا جميعا % إليه أو انفروا ثبات % 6(@)(@@) % ذو رقية من رقى طفيل % يأخذ بالعين كالسبات % 7(@)(@@) % أغري بالمحسنين وصفي % % وهمه وصف محسنات % 8(@)(@@) % ووجه مظلومة هواه % وهمها في بني الفرات % 9(@)(@@) % غير أني أراك تفخر أني % % بك قد لطت مرة ثم تيتا % % 9(@)(@@) % يصطبح الخمر كل يوم % ولو على الريق والفتات % PageV01P895 9(@)(@@) % ما علمنا من لؤلؤ ما ذكرنا % % هي وقف إذا هممت فعلنا % % 9(@)(@@) % بغلة النيك لؤلؤ فاله عنها % % تعلف الأير ليس تعلف قتا % % 9(@)(@@) % إن بيت الفتاة بيت سفاح % كلما شئت فيه نيكا وجدتا % % 9(@)(@@) % إنما مسه وفاجأتموه % فتقى شركم فواراه في استه % % 9(@)(@@) % فهنيئا نيكي لأمك قدما % وحديثا بلؤلؤ وعهرنا % % 9(@)(@@) % يا بن عبدون قد عهرنا قديما % وحديثا بلؤلؤ وعهرتا % % 9(@)(@@) % كان غنى في مجلس فلحينا % % فانثنى ساكتا فقلنا أجدتا % % 9(@)(@@) % سرنا بالسكوت يرحمك الل % % ه فإنا في نعمة ما سكتا % % 9(@)(@@) % ما تبالي خريت في مجلس القو % م إذا ما غنيتهم أم ضرطتا % % 9(@)(@@) % ويخال النديم انك تفسو % % إن تنفست نحوه أو نكهتا % % PageV01P896 9(@)(@@) % إن دعوناك للواط فلا بد % عا وإن كان باطلا ما زعمتا % % 9(@)(@@) % فقديما لواط أمك معرو % % ف بيحيى بن صالح قد علمتا % % 9(@)(@@) % خفيفوقروه لجاهه ولسمته % واحفظوه أيضا لحرمه أخته 
ms243	 % 9(@)(@@) % لا تقولوا على ابن بوران بهتا % % نا فقدما جبهتموه ببهته % 9(@)(@@) % يشهد الله أن أيري سلك % ما جرى مرتين في قلب خرته % 9(@)(@@) % قد ركبنا الذي ركبت زمانا % وركضنا في حلية وركضتا % % PageV01P897 البحر : - 1(@)(@@) % فقدتك يا كنيزة كل فقد % وذقت الموت أول من يموت % 2(@)(@@) % فقد أوتيت رحب فم وفرج % كأنك من كلا طرفيك حوت % 3(@)(@@) % ويابسة الأسافل والأعالي % % كأنك في المجالس عنكبوت % 4(@)(@@) % عظام قد براها السل بريا % فما فيها لبعض الطير قوت % 5(@)(@@) % وإن غنيت زنيت الندامى % % فلا عمرت بحضرتك البيوت % 6(@)(@@) % رزقتك ليلة فرزقت رزقا % بودي أنه أبدا يفوت % 7(@)(@@) % سأقترح السكوت عليك دهري % % فأحسن ما تغنين السكوت % PageV01P898 البحر : - 1(@)(@@) % بليت بفلتة فضحكت فلته % فلا تغضب كلا الأمرين بغته % 2(@)(@@) % ولي فضل عليك لأن فعلي % % بغير أذى عليك فلم كرهته % 3(@)(@@) % أتسمعني الأذى وتشمنيه % وتجشمني رضى ما قد فعلته % 4(@)(@@) % وتغضب إن ضحكت بغير عمد % ولم تسمع أذاي ولا شممته % PageV01P899 البحر : - 1(@)(@@) % تدارك وهبا كلام استه % وقد كاد من عيه أن يموتا % % 2(@)(@@) % وأقسم بالله لو أنه % % كفاها الكلام كفته السكوتا % % PageV01P900 البحر : - 1(@)(@@) % له قرون سمقت في العلا % % أطالها رب البريات % 2(@)(@@) % يسترق السمع على قرنه % إبليس في جو السموات % PageV01P901 البحر : - 1(@)(@@) % تنفس في وجهي فكدت أموت % وأعرض عني ساعة فحييت % 2(@)(@@) % وأنتنني حتى ظننت بأنني % % وحقكما يا صاحبي خريت % 3(@)(@@) % فإن لم أكن فتشت حقا غلالتي % % لأغسل عنها سلحها فعميت % PageV01P902 البحر : - 1(@)(@@) % عهدنا بالرياح كانت تبارى % % بالعطايا الرغاب والنفحات % 2(@)(@@) % لكن الآن لا تزال تبارى % % بالعدات الكواذب المخلفات % PageV01P903 البحر : - 1(@)(@@) % رجل عليه لحية % منها قرامل زوجته % 2(@)(@@) % لو يجمع الله اللحى % % كانت حذافة لحيته % PageV01P904 البحر : - 1(@)(@@) % نجا يونس في اللج % ة من حاوية الحوت % 2(@)(@@) % بتسبيح له منج % وعته أذن الحوت % 3(@)(@@) % فكم نوع من الآفا % % ت مصروف عن الحوت % 4(@)(@@) % وحيتانكم نسل % أتى من ذلك الحوت % 5(@)(@@) % وقد حزن من التسبي % % ح ميراثا عن الحوت % 6(@)(@@) % فما إن يطمع الصيا % % د في ذرية الحوت 
ms244	 % PageV01P905 البحر : - 1(@)(@@) % وإذا اشتهيت خرا فمثل نتنه % فعيوبه تسليك عن حسناته % 2(@)(@@) % سبحان خالقه إذا خضخضته % ماذا يفوح عليك من نكهاته % PageV01P906 البحر : - 1(@)(@@) % فزعت إلى الخضاب فلم تجدد % به خلقا ولا أحييت ميتا % % 2(@)(@@) % فدعه ولا تعن به فواقا % فأجدى منه قولك لو وليتا % % 3(@)(@@) % فدع عنك الخضاب ولا ترده % % فأجدى . . . . . . . . . . . . . . . % 4(@)(@@) % خضبت الشيب حين بدا لتدعى % % فتى حدثا ضلالا ما ارتجيتا % % 5(@)(@@) % ألا حاولت أن تدعى غلاما % بحلق العارضين إذا التحيتا % % 6(@)(@@) % رأيتك إذ كساك الشيب ثوبا % تراه العين أسوأ ما اكتسيتا % % 7(@)(@@) % أترجو أن يقال فتى بشيب % تسوده % % 8(@)(@@) % أبت آثار دهرك أن تعفى % % بكفك شئت ذلك أم أبيتا % % PageV01P907 البحر : - 1(@)(@@) % إذا عرضت لحية للفتى % % وطالت وصارت إلى سرته % 2(@)(@@) % فنقصان عقل الفتى عندنا % % بمقدار ما زاد في لحيته % PageV01P908 البحر : - 1(@)(@@) % لكم حجاب ولنا أنفس % تمنعنا الذل عزيزات % 2(@)(@@) % تاه وتهنا فسمونا بها % % وهي عن الذل مصونات % PageV01P909 البحر : - 1(@)(@@) % أنت تيس والتيس أش % به شيء بخلقتك % 2(@)(@@) % لهم أيور كالحصان الكمت % % لها فياش كرؤوس البخت % 2(@)(@@) % لو لم يقصر حبلت بست % وهكذا نيك بني نوبخت % 2(@)(@@) % ولم يزل جلدات شديد النحت % % يرهزها من فوقها والتحت % 2(@)(@@) % ناك أبو العباس نيك الغت % ناك على السمت وغير السمت % 2(@)(@@) % أنت أولى بقرنه % وهو أولى بلحيتك % PageV01P910 البحر : - 1(@)(@@) % بما أهجوك يا أنت % أليس أنت الذي أنت % PageV01P911 البحر : - 1(@)(@@) % أكف الغواني بالخنا خضرات % وهن بأقران الهوى ظفرات % 2(@)(@@) % ضعفن وكان الضعف منهن قوة % فهن على الألباب مقتدرات % 3(@)(@@) % ومنتقبات بالضياء وضاءة % كما هن بالظلماء معتجرات % 4(@)(@@) % خلقن من الأضداد فاسودت الذرا % % سواد الدجى وابيضت البشرات % 5(@)(@@) % ومسن وكثبان المآزر رجح % وقضبان ما وشحن مضطمرات % 6(@)(@@) % بكرن على باكورتي فابتكرنها % % وهن لها إذ ذاك مبتكرات % 7(@)(@@) % كلانا اجتنى ما يشتهي من خليله % % فأغصان ما نهواه منهصرات % 8(@)(@@) % ذكرت الصبا وهنا فلا الوجد مقلع % لشيء ولا الأحشاء مصطبرات % 9(@)(@@) % غليل أبى أن يطفيء الدمع ناره % ويضرمه أن تعصب الزفرات % 10(@)(@@) % ألا إنما الدنيا الشباب 
ms245	 وإنما % % سرور الفتى هاتيكم السكرات % PageV01P912 11(@)(@@) % ولا خير في الدنيا إذا ما رعيتها % % وقد أيبست أجنابها الخضرات % 12(@)(@@) % نراع إذا لاحت نجوم مشيبنا % % كأن نجوم الليل منكدرات % 13(@)(@@) % وتنفطر الأكباد عند شموله % كأن الطباق السبع منفطرات % 14(@)(@@) % سينسيك أيام الشباب وبردها % % فتى ماجد أيامه سبرات % 15(@)(@@) % مواصلة آصالها غدواتها % % من اللاء لم تخلق لها جمرات % 16(@)(@@) % ولم تسلك الأيام عن زهراتها % % بمثل فتى أخلاقه زهرات % 17(@)(@@) % كمثل أبي العباس إن كان مثله % وهل مثله دامت له الخيرات % 18(@)(@@) % أخو السرو من آل الفرات وكلهم % سراة ولكن للسراة سراة % 19(@)(@@) % يد الله يا آل الفرات عليكم % % وأيديكم بالعرف منهمرات % 20(@)(@@) % تحل أياديكم بحق وإنها % % لديكم بلا حق لمحتقرات % PageV01P913 21(@)(@@) % أياد بواد لا تفيق وشاية % بأيد انتهاء وهي مستترات % 22(@)(@@) % قرى لكم تخفونه وهو ظاهر % سجاياكم قدما به يسرات % 23(@)(@@) % وكيف بأن يخفى قراكم وإنما % % بلاد بني الدنيا لكم حجرات % 24(@)(@@) % أزرتم قراكم كل قوم فجاءهم % % هنيئا ولم تقطع له القفرات % 25(@)(@@) % جريتم مع السباق في كل حلبة % فجئتم ولم ترهقكم الفترات % 26(@)(@@) % رجحتم على أكفائكم إذا وزنتم % % وهل يستوي الآلاف والعشرات % 27(@)(@@) % لنا أثرات دونكم بثرائكم % % ولكن لكم بالسؤدد الأثرات % 28(@)(@@) % حلمتم وفيكم منعة فأكفكم % قوادر لا يعجزن مغتفرات % 29(@)(@@) % أكف عن الهافين طرا صوافح % وهن من الباغين منتصرات % 30(@)(@@) % كأنكم لينا وحدا مناصل % لها الصفحات الملس الشفرات % PageV01P914 31(@)(@@) % إذا افتخر السادات يوما سكتم % ولم تسكت الأحلام والأمرات % 32(@)(@@) % وما فخر قوم والمفاخر كلها % % بهم عند ذكر الفخر مفتخرات % 33(@)(@@) % لهم شيم إن لم تكن أزلية % فإن بحار الأرض محتفرات % 34(@)(@@) % مفجرة قبل السؤال وبعده % صوافي جمام الماء لا كدرات % 35(@)(@@) % تكلم عنكم ما تبين صنائع % سترن وهن الدهر مشتهرات % 36(@)(@@) % ومنكم أبو العباس ذاك الذي له % تقاصر في أبدانها القصرات % 37(@)(@@) % فتى لا قضاياه علينا بوادر % ولا الجود منه باللهى خطرات % 38(@)(@@) % ولكن قضاياه سداد وجوده % ينابيع بالمعروف منفجرات % 39(@)(@@) % هو المرء يسعى والمساعي ثقيلة % ويسبق والأنفاس منبهرات % 40(@)(@@) % له 
ms246	 ضحكات حين يسأل حاجة % إذا كثرت من غيره الضجرات % PageV01P915 41(@)(@@) % يقول ويولي منة بعد منة % % فيطنب والأقوال مختصرات % 42(@)(@@) % فلو أنزلت بعد النبيين سورة % إذا أنزلت في مدحه سورات % 43(@)(@@) % جرى وجرت أقلامه خيل حلبة % وأقلام قوم عنده حمرات % 44(@)(@@) % نصيحا إذا غش الولاة كفاتهم % وفيا إذا ما خيفت الغدرات % 45(@)(@@) % أمينا على مال الملوك وفيئهم % % وسوقهم ليست له خثرات % 46(@)(@@) % ضليعا إذا ما استحمل الخطب ناهضا % بأعبائه ليست له عثرات % 47(@)(@@) % يروي فتستل السيوف ولم تزل % له هدآت في غبها نفرات % 48(@)(@@) % وكم هدآت للأريب أريبة % يخال الأعادي أنها فترات % 49(@)(@@) % أخو الفكر اللائي إذا فكر الورى % % تناست هداها فهي مدكرات % 50(@)(@@) % لقد خير فيه للوزير ولم يزل % أبو الصقر مختارا له الخيرات % PageV01P916 51(@)(@@) % به تتعرى المرهفات وتارة % تستر والأغماد منحسرات % 52(@)(@@) % أمنت ولو غاض الفرات من الصدى % % لأنك لي يا ابن الفرات فرات % 53(@)(@@) % ترى الدهر مرتاعا إذا ما تتابعت % إلى صرفه من أحمد نظرات % 54(@)(@@) % محاذرة ممن إذا ما تحررت % عوارفه زالت بها النكرات % 55(@)(@@) % أساءت لي الأيام يا ابن محرر % وهن إلي الآن معتذرات % 56(@)(@@) % رأيت مطافي حول حقويك عائذا % فهن لمن أبصرته حذرات % 57(@)(@@) % وأوعدتها تنكيرك النكر صادقا % فقلت رويدا تنجلي الغمرات % 58(@)(@@) % إلى الله أشكو سوء رأي مؤمل % معارف شعري عنده نكرات % 59(@)(@@) % وقد كنت من حرمانه في بلية % فقد أردفت حرمانه الحسرات % 60(@)(@@) % توالت على العافين آلاء عرفه % وأخفقت والآمال منتظرات % PageV01P917 61(@)(@@) % فأنى أثاب الثيبات ولم يثب % عذارى ولم تفضض لها عذرات % 62(@)(@@) % أعذ كلماتي فيه من قول قائل % % أرى شجرات ما لها ثمرات % 63(@)(@@) % أمنطويات دون كفي صلاته % وأسراب مدحي فيه منتشرات % 64(@)(@@) % أرى الشعر يحيي المجد والبأس والندى % % تبقيه أرواح لها عطرات % 65(@)(@@) % وما المجد لولا الشعر إلا معاهد % وما الناس إلا أعظم نخرات % 66(@)(@@) % وقد صغت ما التيجان أشباه بعضه % وقد حكت ما أشباهه الحبرات % PageV01P918 البحر : - 1(@)(@@) % رمت نداكم يا بني طاهر % % فرمت مخ الذر في عسرته % 2(@)(@@) % أملت من 
ms247	 رفد سليمانكم % ما أمل المعتز من نصرته % PageV01P919 البحر : - 1(@)(@@) % لهفي على مودة % تكدرت حين صفت % 2(@)(@@) % ذكرتها أيمانها % % فحلفت ما حلفت % PageV01P920 البحر : - 1(@)(@@) % ولا عيب في أخلاقه غير أنه % أخو عزمات في الندى محلات % 2(@)(@@) % جدود تنجيهم من اللوم فوقها % % جدود تنجيهم من الهلكات % PageV01P921 البحر : - 1(@)(@@) % مدح عليك ثيابها فكأنما % % نهلت من المسك لذكي وعلت % 2(@)(@@) % تالله مالك أن تعيب ملابسا % من ذلك العرق الذكي ابتلت % 3(@)(@@) % هبها تخلت من فضائل نفيها % % أتخالها مما أعرت تخلت % PageV01P922 البحر : - 1(@)(@@) % فتى يتقي لحظ العيون ويرعوي % % ويغشى رماح الخط مشتبكات % PageV01P923 البحر : - 1(@)(@@) % إذا أجاد الذي يشبهه % وأحكم الوصف فيه بالنعت % 2(@)(@@) % قال كرات الأديم قد حشيت % بسمسم قمعت بكيمخت % PageV01P924 البحر : - 1(@)(@@) % سجايا إذا همت بخير تسرعت % إليه وإن همت بشر تناءت % PageV01P925 البحر : - 1(@)(@@) % قد كنت أبكي على من مات من سلفي % % وأهل ودي جميع غير أشتات % 2(@)(@@) % فاليوم إذ فرقت بيني وبينهم % نوى بكيت على أهل المودات % 3(@)(@@) % وما حياة امرىء أضحت مدامعه % مقسومة بين أحياء وأموات % PageV01P926 البحر : - 1(@)(@@) % وحبب يوم السبت عندي أنني % % تنادمني فيه الذي أنا أحببت % 2(@)(@@) % ومن عجب الأشياء أني مسلم % حنيف ولكن خير أيامي السبت % PageV01P927 البحر : - 1(@)(@@) % ومختضبات من نجيع دمائها % % إذا جنيت من بكرة الغدوات % 2(@)(@@) % تكاد بأن تطغى إذا ما لمستها % % فأرحمها من سائر الغدوات % PageV01P928 البحر : - 1(@)(@@) % بنفسج جمعت أوراقه فحكى % % كحلا تشرب دمعا يوم تشتيت % 2(@)(@@) % واللازوردية تزهو بزرقتها % % وسط الرياض على حمر اليواقيت % 3(@)(@@) % كأنها وضعاف القضب تحملها % % أوائل النار في أطراف كبريت % PageV01P929 البحر : - 1(@)(@@) % بكت شجوها الدنيا فلما تبينت % مكانك منها استبشرت وتغنت % 2(@)(@@) % لتستمتع الدنيا بوجهك دهرها % % فقد طالما اشتاقت إليك وحنت % PageV01P930 البحر : - 1(@)(@@) % يا مادح الحقد محتالا له شبها % لقد سلكت إليه مسلكا وعثا % % 2(@)(@@) % لن يقلب العيب زينا من يزينه % % حتى يرد كبيرا عاتيا حدثا % % 3(@)(@@) % قد أبرم الله أسباب الأمور معا % فلن ترى سببا منهن منتكثا % % 4(@)(@@) % يا دافن الحقد في ضعفي جوانحه % ساء الدفين الذي أمستله جدثا % % 5 
ms248	(@)(@@) % الحقد داء دوي لا دواء له % يري الصدور إذا ما جمره حرثا % % 6(@)(@@) % فاستشف منه بصفح أو معاتبة % فإنما يبرأ المصدور ما نفثا % % 7(@)(@@) % واجعل طلابك للأوتار ما عظمت % % ولا تكن لصغير الأمر مكترثا % % 8(@)(@@) % والعفو أقرب للتقوى وإن جرم % من مجرم جرح الأكباد أو فرثا % % 9(@)(@@) % يكفيك في العفو أن الله قرظه % وحيا إلى خير من صلى ومن بعثا % % 10(@)(@@) % شهدت أنك لو أذنبت ساءك أن % % تلقى أخاك حقودا صدره شرثا % % PageV01P931 11(@)(@@) % إذن وسرك أن ينسى الذنوب معا % وأن تصادف منه جانبا دمثا % % 12(@)(@@) % فكيف تمدح أمرا كنت تكرهه % فكر هديت تميز كل ما اغتلثا % % 13(@)(@@) % وليس يخفى من الأشياء أقربها % % إلى السداد إذا ما باحث بحثا % % 14(@)(@@) % فارجع إلى الحق من قرب ومن أمم % ولا تمن منى طفل إذا مرثا % % 15(@)(@@) % فمن تثاقل عن حق فبادره % إليه خصم سفى في وجهه وحثا % % 16(@)(@@) % والفلج للحق والمدلي بحجته % إذا الخصيم هناكم للخصيم جثا % % 17(@)(@@) % إني إذا خلط الإخوان صالحهم % % بسيىء الفعل جدا كان أو عبثا % % 18(@)(@@) % جعلت صدري كظرف السبك حينئذ % يستخلص الفضة البيضاء لا الخبثا % % 19(@)(@@) % ولست أجعله كالحوض أمدحه % بحفظ ما طاب من ماء وما خبثا % % 20(@)(@@) % ولا أزين عيبي كي أسوغه % نفسي ولا أنطق البهتان والرفثا % % PageV01P932 21(@)(@@) % تغبيب ذي العيب عنه كي تزينه % حنث وإن هو لم يحلف فقد حنثا % % 22(@)(@@) % والعيب عيبان فيمن لا يقبحه % فإن تجاهل عيبيه فقد ثلثا % % 23(@)(@@) % لا تجمعن إلى عيب تعاب به % % عيب الخداع فلن تزداد طيب نثا % % 24(@)(@@) % كم زخرف القول من زور ولبسه % على العقول ولكن قلما لبثا % % 25(@)(@@) % إن القبيح وإن صنعت ظاهره % يعود ما لم منه مرة شعثا % % PageV01P933 البحر : - 1(@)(@@) % ولقد سئمت مآربي % % فكأن طيبها خبيث % 2(@)(@@) % إلا الحديث فإنه % مثل اسمه أبدا حديث % PageV01P934 البحر : - 1(@)(@@) % دعني وإيا أبي علي % الأعور المعور الخبيث % 2(@)(@@) % ليمطرن العذاب حتى % % تراه في حال مستغيث % 3(@)(@@) % أهلا وسهلا أبا علي % نزلت بالمنزل الدميث % 4(@)(@@) % عندي قرى غير مستراث % فكن له 
ms249	 غير مستريث % 5(@)(@@) % صبرا قليلا أبا علي % تسمع غدا شائع الحديث % 6(@)(@@) % عندي هدايا من اللواتي % % أهدى جرير إلى البعيث % % 7(@)(@@) % عندي لمن عن في سبيلي % % وقام للنيك كالنجيث % 8(@)(@@) % ما شاء من ديمة ركود % تهمي ومن وابل حثيث % PageV01P935 البحر : - 1(@)(@@) % أستغفر الله من تركي علانية % ذنبا هممت به في شادن خنث % 2(@)(@@) % ظبي دعتني عيناه ومنطقه % بنية صدقت عن ظاهر عبث % 3(@)(@@) % فلم أجبه وحظي في إجابته % لكن سكت كأني غير مكترث % 4(@)(@@) % لا بل فررت وظل الصيد يطلبني % % والله ما كنت فيها بالفتى الدمث % 5(@)(@@) % أقسمت بالله لما قمت محتجزا % إني انبعثت بقلب غير منبعث % PageV01P936 البحر : - 1(@)(@@) % يا أحمد ابن أبيه % ويا ربيب حريث % 2(@)(@@) % ما زلت تعوي سفاها % حتى منيت بليث % PageV01P937 البحر : - 1(@)(@@) % إن أنت صادفت شيخ سوء % كأنما الذقن منه حبثى % % 2(@)(@@) % فاستجر الله يا خليلي % % وضع على حلقه الهلبثا % % PageV01P938 البحر : - 1(@)(@@) % قد قلت للعذال عند تتبعي % % بالقص شيبا كل يوم يحدث % 2(@)(@@) % كثر الخبيث من النبات فهذبت % منه الأطايب وهي بعد ستخبث % 3(@)(@@) % وإخال أني للخضاب محالف % وهو المحالف لا محالة ينكث % 4(@)(@@) % أضحى الزمان بلمتي متعبثا % وأمام أحداث الزمان تعبث % 5(@)(@@) % ولما كرثت لأن شيبي شائع % لكن ما يجنى ويعقب يكرث % 6(@)(@@) % أصبحت في الدنيا أروح وأغتدي % % وإخالني في غير أرضي أحرث % 7(@)(@@) % ولقد تطيب مع المشيب معيشة % ويكون من بعد الخفوف تلبث % PageV01P939 البحر : - 1(@)(@@) % تفاءلت والفأل لي معجب % فقلت وما أنا بالعابث % 2(@)(@@) % أبو حسن وأبو مثله % كنيا أبي حسن ثالث % 3(@)(@@) % قضى الله والله لي بالغنى % % يمين امرىء غير ما حانث % 4(@)(@@) % إذا ما هما اكتنفا حاجتي % % فما ضرها عقد النافث % 5(@)(@@) % ولا سيما والذي أرتجي % % أبو الصقر ما النجح بالرائث % 6(@)(@@) % أبا الصقر لا زلت غيثا لنا % % حماما على المارق الناكث % % 7(@)(@@) % حبتك الأوائل من وائل % بمجد قديم لهم ماكث % 8(@)(@@) % وحسبك من سلف لامرىء % وحسبهم بك من وارث % 9(@)(@@) % ورثتهم ثم أحييتهم % وكم خلف وارث باعث % 10(@)(@@) % ليهنئهم سيد أيد 
ms250	 % صحيح الروية في الكارث % PageV01P940 11(@)(@@) % يكنى أبا الصقر في رأيه % وفي البأس يكنى أبا الحارث % 12(@)(@@) % نفى العائثين سوى جوده % % وحسبك في المال من عائث % PageV01P941 البحر : - 1(@)(@@) % بلوت عليا فألفيته % وفيا وألفيت قوما نكث % 2(@)(@@) % فتى طب في كل أحواله % ونزهه الله عما خبث % 3(@)(@@) % لإخوانه ثلثا ماله % وليس له منه إلا الثلث % 4(@)(@@) % وما زال يحيى كذا قبله % وهم أهل بيت لهذا ورث % PageV01P942 البحر : - 1(@)(@@) % ناشدتك الله في قدري ومنزلتي % % لديك لا يتطرق منهما العبث % % 2(@)(@@) % من صاحب خلط الحسنى بسيئة % وما الدهاء دهاه ولا اللوث % 3(@)(@@) % لكن مزاح قبيح الوجه كالحه % أولى به من بروز الصفحة الجدث % 4(@)(@@) % يا من إلى وصله الإسراع مفترض % ومن على وده التعويج واللبث % 5(@)(@@) % إن كنت عندك قبل اليوم من ذهب % فذلك الصفو لم يعرض له الخبث % 6(@)(@@) % أمر حبلي صناع الكف ماهرها % % فما لمرة ذاك الحبل منتكث % 7(@)(@@) % أنا الذي أقسمت قدما خلائقه % ألا يشيع له سخف ولا رفث % 8(@)(@@) % وحرمتي بك إن الله عظمها % % وما أديمي مما تقرم العثث % 9(@)(@@) % إن الكلام الذي رعثته شبه % تستنكف الأذن منه حين ترتعث % 10(@)(@@) % ما كان لي في الذي أنهاه زاعمه % إليك رقية محتال ولا نفث % PageV01P943 11(@)(@@) % وما سكت اعترافا بالحديث له % لكن كظمت وبي من حره لهث % 12(@)(@@) % وخلت جبهي بالتكذيب ذا ثقة % عنفا وإن قال قولا فيه مكترث % 13(@)(@@) % لا سيما ولعل الهزل غايته % لا غيره ولبذر الجد محترث % 14(@)(@@) % ولم أزل سبط الأخلاق واسعها % % وإن غدوت امرأ في لحيتي كثث % 15(@)(@@) % آبائي الروم توفيل وتوفلس % ولم يلدني ربعي ولا شبث % 16(@)(@@) % وما ذهبت إلى فخر على أحد % % لكنه القول يجري حين يبتعث % 17(@)(@@) % شحي عليك اقتضاني العذر لا ظمأ % مني إلى مدح أسبابي ولا غرث % 18(@)(@@) % فاحفظ علي مكاني منك واسم به % عما تعاب به الأرواح والجثث % 19(@)(@@) % لا يحدثن على ما كان لي حدث % فإن جارك مضمون له الحدث % 20(@)(@@) % وارفق بخصمي والممه على شعث % لا زلت ما عشت 
ms251	 ملموما بك الشعث % PageV01P944 البحر : - 1(@)(@@) % تبحثت عن أخباره فكأنما % % نبشت صداه بعد مر ثلاث % % 2(@)(@@) % تلقتني الأنباء عنه شبيهة % نواشر أرواح لهن خباث % PageV01P945 البحر : - 1(@)(@@) % أيها الناكث العهود ستجني % % ندما من عهودك المنكوثه % 2(@)(@@) % أنا بالله وحده مستغيث % ويمينا لتأتيني المغوثه % 3(@)(@@) % فاخش رب السماء وأمن هجائي % % قد كفتني أخبارك المبثوثه % 4(@)(@@) % لست أهجوك ما حييت ببيت % وستهجوك عني الأحدوثه % PageV01P946 البحر : - 1(@)(@@) % مطايب عيش زايلته مخابثه % ومقبل حظ أطلقته روائثه % 2(@)(@@) % ودولة إفضال ويمن وغبطة % كأن حزون الدهر فيها دمائثه % 3(@)(@@) % وغيث أظل الأرض شرقا ومغربا % فقيعانه خضر النبات أثائثه % 4(@)(@@) % فظبي له سحران طرف ونغمة % يجد بك الإغرام حين تعابثه % 5(@)(@@) % يناغم أوتارا فصاحا يروقنا % % تأنيه في تصريفها وحثاحثه % 6(@)(@@) % ويلحظ ألحاظا مراضا كأنها % % تغانج من يرنو لها وتخانثه % 7(@)(@@) % فيسبيك بالسحر الذي في جفونه % ويصيبك بالسحر الذي هو نافثه % 8(@)(@@) % يحن إليه القلب وهو سقامه % ويألف ذكراه الحشا وهو فارثه % 9(@)(@@) % يجيع وشاح الدر منه مجاله % ويشبع مرط الخز منه ملاوثه % 10(@)(@@) % وقد طلعت باليمن والسعد كله % % لنا والثرى ريان تندى مباحثه % PageV01P947 11(@)(@@) % ثلاثة أعياد فللفطر واحد % وللعرف ثانيه وللهو ثالثه % 12(@)(@@) % يعبدها فرع من المجد طيب % جناه إذا ما الفرع جمت خبائثه % 13(@)(@@) % ألا فاسقني في الفطر كأسا روية % لعل لهاث الصوم ينقع لاهثه % 14(@)(@@) % مشعشعة يضحى لها العود ناطقا % تناغى مثانيه لنا ومثالثه % 15(@)(@@) % مع ابن وزير لم يزل ومحله % من الفضل يرضاه النبي ووارثه % 16(@)(@@) % وما كنت مكذوبا وما كنت كاذبا % لدى الله لو قلت النبي وباعثه % 17(@)(@@) % من الصالحين المصلحين بيمنه % غدا العيش محمودا ولمت مشاعثه % 18(@)(@@) % إذا لم يعث في ماله لعفاته % فما يعرف العيث الذي هو عائثه % 19(@)(@@) % تضمن تذليل الزمان فأصبحت % أواعره ذلت لنا وأواعثه % 20(@)(@@) % وأيد بابن مثله في غنائه % % إذا كثرت من ريب دهر كوارثه % PageV01P948 21(@)(@@) % أغر يكنى بالحسين تضمنت % % محاسنه ألا تغب مغاوثه % 22(@)(@@) % إذا ما عبيد الله ضاهاه قاسم % فثم قديم المجد ضاهاه حادثه % 23(@)(@@) % ألا بورك 
ms252	 الزرع الذي هو زارع % من البر والحرث الذي هو حارثه % 24(@)(@@) % ويا حالفا أن ما رأى مثل قاسم % % على ظهري الحنث الذي أنت حانثه % 25(@)(@@) % بررت وعهد الله برا مبينا % وإن كثرت من ذي شقاق هنابثه % 26(@)(@@) % أبى أن يرى الحق الذي هو باخس % أخاه أو العهد الذي هو ناكثه % 27(@)(@@) % حليم عليم إن تجاهل دهره % جواد كريم إن ألحت مغارثه % 28(@)(@@) % يظل وتدبير الممالك جده % وبذل العطايا المنفسات معابثه % 29(@)(@@) % فتى يقتل الأموال في سبل العلا % % لتورثه المجد السني موارثه % 30(@)(@@) % ضرور نفوع عاجل النفع ثره % على معتفيه آجل الضر رائثه % PageV01P949 31(@)(@@) % نهى جوده عن كل سمح وباخل % شذى القول حتى أحسن القول رافثه % 32(@)(@@) % ترى صاحبيه ذا سؤال يميحه % فواضله أو ذا سؤال يباحثه % 33(@)(@@) % وما يجتبي الميسور من لا يزوره % ولا الؤلؤ المنثور من لا يحادثه % 34(@)(@@) % وإما أغذ السير في إثر خطة % فلا العجز ثانيه ولا الشك رائثه % 35(@)(@@) % إذا ما تلاقى كيده وعداته % فثم تلاقى أجدل وأباغثه % 36(@)(@@) % وإما أراغ الحزم للخطب مرة % فلا الحزم معييه ولا الخطب كارثه % 37(@)(@@) % أظل إذ لاقيت غرة وجهه % وليلي نهار ساكن الظل ماكثه % 38(@)(@@) % ليقصر عليه اليوم في ظل غبطة % ولا يقصر العمر الذي هو لابثه % 39(@)(@@) % ولا زال قصر القفص أعمر منزل % به وبدهر صالح لا يماغثه % 40(@)(@@) % فما فضله والمدح دعوى ومدع % ولكن هما مسك ذكي ومائثه % PageV01P950 البحر : - 1(@)(@@) % يا رب لا تبعث بغيث عيثا % % فإنه إن حث غيث غيثا % % 2(@)(@@) % عادت لبون الممطرات ليثا % % وأنت أهدى عجلا وريثا % % PageV01P951 البحر : - 1(@)(@@) % رويدك أيها الرجل المنادى % % أبا عيسى أتيح لك الغياث % 2(@)(@@) % لقد أسمعت إذ ناديت حيا % له تلقاء داعيه انبعاث % 3(@)(@@) % أبو عيسى العلاء فتى المعالي % % فداه كل من ولد الإناث % 4(@)(@@) % فتى لا يستراث له فعال % وشاكره يجد ويستراث % 5(@)(@@) % إذا أولى أياديه أناسا % فأولاها لأخراها احتثاث % 6(@)(@@) % حكيم لا معاقده ضعاف % تذم ولا معاهده رثاث % 7(@)(@@) % فليس له انتكاف عن ثناء % ولا كرم إذا 
ms253	 خيف انتكاث % 8(@)(@@) % فتى صلحت به الدنيا وكانت % % وحالاها اضطراب والتياث % 9(@)(@@) % أقام بعدله الطرفين منها % % وليس كمعشر جاروا وعاثوا % % 10(@)(@@) % وفي العدل اجتناء جنى وبقيا % % على مجنى وفي الجور اجتثاث % PageV01P952 البحر : - 1(@)(@@) % أغصان بان تحتهن وعاث % أنى ينؤن بنا وهن دماث % 2(@)(@@) % ما في حبائل كيدهن رثاثة % لكن حبال وصالهن رثاث % 3(@)(@@) % حور سحرن وما نفثن برقية % فبلغن ما لا يبلغ النفاث % 4(@)(@@) % لحظاتهن إذا رنون إلى الفتى % % بلوى ولكن ريقهن غياث % 5(@)(@@) % قل للفضيل إذا انتحى في نسجه % لا تنسجن فغزلك الأنكاث % 6(@)(@@) % لهفي على سبك البرية في لظى % % لتميز الصفوات والأخباث % 7(@)(@@) % فاخزأ فإنك حين تذكر في الورى % % واقلب كمثل المسك حين يماث % 8(@)(@@) % أفعالك الأنجاس غير مدافع % عنها كما أقوالك الأرفاث % 9(@)(@@) % وإذا سألت الناس عنك ولم تكن % لتطيب حين يثيرك البحاث % 10(@)(@@) % ما أنت عندي لبلاد بزينة % بل أنت فيها للعباد أثاث % PageV01P953 10(@)(@@) % ما إن تزال قنا العبيد صوادرا % عنه على أطرافها الأرواث % % 10(@)(@@) % لفضيحة أبدا يحل إزاره % وعلى الحلاق مع البغاء يلاث % 10(@)(@@) % من معشر كسبوا الحرام فكلهم % منه ش باع والبطون غراث % % 10(@)(@@) % بل عامل من خلفه وأمامه % عملان يقطع فيهما ويعاث % 10(@)(@@) % لولا الرشا منه هنالك والرقى % % قسما لما غلب المبال مراث % 10(@)(@@) % هون عليك فإن رجلك شعبة % من أربع تكفيكهن ثلاث % 10(@)(@@) % قالوا فتى الكتاب إلا أنه % % من شرطه الأنصاف لا الأثلاث % 10(@)(@@) % انت الفراش لمن اضل فراشه % % وكذاك طرزك للذكور إناث % 10(@)(@@) % يا من سماد قراحه من أرضه % لا غيرها وغلامه الحراث % 10(@)(@@) % كم بت بين أيورهم متقسما % حتى كأنك بينها ميراث % PageV01P954 10(@)(@@) % لك ان تقوم على ثلاثك مركبا % وعلى أن يتفارس الأحداث % 11(@)(@@) % يا سوأة أبدا تواري سوأة % حتى يواري شخصك الأجداث % % 12(@)(@@) % ن أنت لم تخبر الإمام بها % % كنت كمن خان أو كمن نكثا % % 12(@)(@@) % أو ابن ميمون إذ يضارطه % جهلا ولا يحفلان سوء نثا % % 12(@)(@@) % هبها كإحدى هنات أحمد إذ % % يضرط في كل مجلس عبثا % % 12(@)(@@) % قد 
ms254	 بدرت سبة الخطيب فما % % لجلج في كل مجلس عبثا % % 12(@)(@@) % وضع قناع الحياء عنك فقد % أصبح في اهل دهرنا خنثا % % 12(@)(@@) % هون عليك لاتي منيت بها % % فإنها فقحة قضت تفثا % % 12(@)(@@) % بيناك عند الوزير تخطب في % % خطب إذا الكير قد نفى خبثا % % 12(@)(@@) % لا تطو عنه الحديث محتشما % فالاست في الحين تنطق الرفثا % % PageV01P955 12(@)(@@) % من ضراطة الحتار بها % % فمعرت ويبها فتى دمثا % % 12(@)(@@) % يا وهب يا صاحب البريد ألا % % تكتب بالحادث الذي حدثا % % 12(@)(@@) % جدعا لآنف معشر تضحى لهممنسرح يا وهب يا صاحب البريد ألاتكتب بالحادث الذي حدثامن ضراطة الحتار بهافمعرت ويبها فتى دمثا بذيءن أنت لم تخبر الإمام بهاكنت كمن خان أو كمن نكثا لا تطو عنه الحديث محتشما فالاست في الحين تنطق الرفث % % ريحانة يا أيها الكراث % % 12(@)(@@) % بل هذا يضارط ذا % % لا صحح الله تلكم الجثثا % % 12(@)(@@) % يا طيبها ضراطة وإن خبثت % وربما طاب بعض ما خبثا % % PageV01P956 البحر : - 1(@)(@@) % شرب البيهقي والبين ناء % من يدي واحد الأنام ثلاثا % % 2(@)(@@) % من شراب يفوق كل شراب % % ويد لم تزل حيا وغياثا % % 3(@)(@@) % ثم ولى متوجا تاج فخر % سوف يبقى لعقبه ميراثا % % 4(@)(@@) % لو درى البين بالذي غاب عنه % ملأ البين ثوبه أحداثا % % 5(@)(@@) % حسدا أو سقته أيدي المنايا % % من حمام الردى كؤوسا حثاثا % % 6(@)(@@) % قبح البين إنه غير شك % شر من أودع الذكور الإناثا % % 7(@)(@@) % قد مللنا بشاعة الوجه منه % وأحاديثه الغثاث الرثاثا % % 8(@)(@@) % يحضر البين لا شهي الملاقا % % ة وإن غاب غاب لا مستراثا % % 9(@)(@@) % وأما والأمير لولا حبال % نالها منه لم تكن أنكاثا % % 10(@)(@@) % لسقته عداوتي جرع المو % ت ولاحتثه الهجاء اجتثاثا % % PageV01P957 11(@)(@@) % كان أشقى الأنام فانبعث الحا % % ئن يا شؤمه عليه انبعاثا % % 12(@)(@@) % هو تيس ولا تزال ترى التي % س شقيا عن المدى بحاثا % % 13(@)(@@) % رجل يحمل القرون ويمشي % % لا ترى عنده لذاك اكتراثا % % 14(@)(@@) % قيل لي إن جاره ابن أبي العق % لين أضحى لأرضه حراثا % % 15(@)(@@) % رجل توحش المجالس منه % % وإذا مات أوحش الأجداثا % % PageV01P958 البحر 
ms255	 : - 1(@)(@@) % أين من يشتري حمارا ضليعا % ليس في مشيه دنية ريث % 2(@)(@@) % يحمل الدين والأمانة والمن % ن اضطلاعا ويحمل ابن حريث % PageV01P959 البحر : - 1(@)(@@) % لها ناظر بالسحر في القلب نافث % ووجه على كسب الخطيئات باعث % 2(@)(@@) % وقد كغصن البان مضطمر الحشا % % تنوء به كثبان رمل أواعث % 3(@)(@@) % يجاذبها عند النهوض وينثني % % بأعطافها فرع سخام جثاجث % 4(@)(@@) % كأن صباحا واضحا في قناعها % % أناخ عليه جنح ليل مغالث % 5(@)(@@) % وتبسم عن عقدين من حب مزنة % به ماث صفو الراح بالمسك مائث % 6(@)(@@) % يغص بها الخلخال والعاج والبرى % % وأثوابها بالخصر منها غوارث % 7(@)(@@) % ربيبة أتراب حسان كأنها % % بنات أداح لم يشنهن طامث % 8(@)(@@) % غرائر كالغزلان حور عيونها % % رخيمات دل ناعمات خوانث % 9(@)(@@) % يعدن فما ينجزن وعدا لواعد % وهن لميثاق الخليل نواكث % 10(@)(@@) % غنيت بها فيهن والشمل جامع % وأغصان عيشي مورقات أثائث % PageV01P960 11(@)(@@) % وللهو مهتاد أنيق وللصبا % % مغان بهن الغانيات لوابث % 12(@)(@@) % يمنيننا منهن نجح مواعد % أكف بحبات القلوب ضوابث % 13(@)(@@) % وأعيان غزلان مراض جفونها % % لواحظها في كل نفس عوائث % 14(@)(@@) % إذا هن قربن الظما من نفوسنا % % إلى الري تلقى دون ذاك الهنابث % 15(@)(@@) % ويلحفن لا ينقصن في ذات بيننا % % على الدهر معهودا وهن حوانث % 16(@)(@@) % وإن نحن أبرمنا القوى من حبالنا % % أبى الوصل دهر بالمحبين عابث % 17(@)(@@) % ومختلفات بالنمائم بيننا % % نوابث عن أسرارنا وبواحث % 18(@)(@@) % يباكرن فينا نجعة العتب بيننا % % كما انتجع الورد العطاش اللواهث % 19(@)(@@) % فبدد منا الشمل بعد انتظامه % صروف طوت أسبابنا وحوادث % 20(@)(@@) % وكل جديد لا محالة مخلق % وباعث هذا الخلق للخلق وارث % PageV01P961 21(@)(@@) % وهن الليالي حاكمات على الورى % % بنقض ولا يبقى عليهن ماكث % 22(@)(@@) % ومن لم ينل ملك المكارم باللهى % % فأمواله للشامتين موارث % 23(@)(@@) % يسود الفتى ما كان حشو ثيابه % حجا وتقى والحلم من بعد ثالث % 24(@)(@@) % وغيث على العافين منهمر الحيا % % وليث هصور للعداة ملائث % 25(@)(@@) % وصفح وإكرام وعقل يزينه % خلائق لا يخزى بهن دمائث % 26(@)(@@) % وكفان في هذي ردى كل ظالم % وفي هذه للمستغيث مغاوث % 27(@)(@@) % فكن سيدا 
ms256	 ذا نعمة غير خامل % وصن منك عرضا أن يسبك رافث % PageV01P962 البحر : - 1(@)(@@) % يا دهر ما سبك غير ذي الخبث % إلا من الجور أو من العبث % 2(@)(@@) % لا تسبكن الكرام إنهم % أصفى نفوس أوت إلى جثث % 3(@)(@@) % أعللت ظلما أبا الحسين وقد % % أتلف في الجود كل محترث % 4(@)(@@) % كأنه شارب على ظمإ % للمجد أو آكل على غرث % 5(@)(@@) % عجل رحيل السقام عنه وأم % تعه صحيحا بالمكث واللبث % 6(@)(@@) % الحازم الصارم الشباة على % % ما فيه من جفوة ومن أرث % 7(@)(@@) % والباذل النائل الجزيل إذا % % ما المستغيث اللهيف لم يغث % 8(@)(@@) % ذو الحسنات المشهرات أخو الع % زف عن السيئات والرفث % 9(@)(@@) % فتى إذا ما الثناء صيغ من ال % إفك لذي اللؤم صوغ مغتلث % 10(@)(@@) % ماث له المسك صدق مخبره % فأي مسك هناك لم يمث % PageV01P963 11(@)(@@) % منكفت الشر كل منكفت % منبعث الخير كل منبعث % 12(@)(@@) % ترتعث الأذن من مدائحه % ما ليس من غيرها بمرتعث % PageV01P964 البحر : - 1(@)(@@) % برضاب ثغرك يستغي % ث متيم بك إن أغثته % 2(@)(@@) % عاهدته أن لا تخو % % ن فما لعهدك قد نكثته % PageV01P965 البحر : - 1(@)(@@) % يا وجنتيه اللتين من بهج % % في صدغيه اللذين من دعج % 2(@)(@@) % ما حمرة فيكما أمن خجل % أم صبغة الله أم دم المهج % 3(@)(@@) % فقال كل الذي نحلتهما % % حق وما يمسيان في حرج % 4(@)(@@) % أما رأيت القلوب عندهما % % يجرحها مخلبان من سبج % 5(@)(@@) % عدلا من الله إننا وهما % % لغاية في تفاوت الدرج % 6(@)(@@) % خدان فينا لظى حريقهما % % ونوره فيهما بلا وهج % 7(@)(@@) % ما إن تزال القلوب في حرق % عليهما والعيون في لجج % PageV01P966 البحر : - 1(@)(@@) % اردد علي قراطيسي ممزقة % كيما تكون رؤوسا للدساتيج % % 2(@)(@@) % فإن ذلك أجدى من تشاغلها % % بحفظ مدحك يا علج الفلاليج % % PageV01P967 البحر : - 1(@)(@@) % من ذا رأت عيناه مثلي في الشجا % % أهدى الي النرجس البنفسجا % % 2(@)(@@) % ما أحسن الشكلين زوجا مزوجا % % ما أملح الزوجين بل ما أغنجا % % 3(@)(@@) % كلاهما مسك إذا تأرجا % % أبلغ سراج الحسن ذاك المسرجا % % 4(@)(@@) % أن الهوى مر به فعرجا % % لما رأى ذاك الجبين الأبلجا 
ms257	 % % 5(@)(@@) % منه وذاك الحاجب المزججا % % والناظر الساحر منه الأدعجا % % 6(@)(@@) % ذا الحركات في الحشا وإن سجا % % وصحن تلك الوجنة المضرجا % % 7(@)(@@) % والثغر منه الواضح المفلجا % % والشعر المحلولك المدرجا % % 8(@)(@@) % والخلق منه العمم الخدلجا % % والخلق القيم لا المعوجا % % 9(@)(@@) % والعقل والوصل الممر المدمجا % % أذكى شهاب الحسن لا بل أججا % % 10(@)(@@) % فوهج القلب كما توهجا % % أقسمت بالليل إذا الليل دجا % % PageV01P968 11(@)(@@) % بل بسنا الصبح إذا تبلجا % % لأكسون الكلم المدبجا % % 12(@)(@@) % وهبا رجائي ورجاء من رجا % % لا أخطأت وهبا نجاة من نجا % % 13(@)(@@) % ولا يزل هم له مفرجا % % فقد علا من كل رشد منهجا % % 14(@)(@@) % أكسوه مدحي طائعا لا محرجا % % عن مقة تلقى الضمير مشرجا % % 15(@)(@@) % من دونها بحفظها بل مرتجا % % ماذا يعوق مدحتي أن تنسجا % % 16(@)(@@) % لمحسن أسلفني فروجا % % أيسر ما استوجب أن يتوجا % % 17(@)(@@) % حر إذا استنجد يوما أرهجا % % وحرك الهمة لا بل أزعجا % % 18(@)(@@) % وراح للخيرات ثم أدلجا % % ولم يزل منذ تعاطى المدرجا % % 19(@)(@@) % يهتاج للمعروف لا مهيجا % % خرقا يؤاتي مدحه من لجلجا % % 20(@)(@@) % ولا يعفي فضله من مجمجا % % يأمر جدواه بأن تبرجا % % PageV01P969 21(@)(@@) % فإن رأى كفا كريما زوجا % % جدوى ترى منها الغنى مستنتجا % % 22(@)(@@) % صتما تماما خلقه لا مخدجا % % من ناله حاذر أن يستدرجا % % 23(@)(@@) % أنشر من شكري مواتا مدرجا % % حتى غدا عبدا له مستعلجا % % 24(@)(@@) % لكنني أشكو إليه الأنبجا % % فإنه لج إلى أن لججا % % 25(@)(@@) % في هجره إياي حتى سمجا % % بل أغلق الحانوت ثم شرجا % % 26(@)(@@) % دوني وأعدى هجره الهفشرجا % % ولم أزل بالطيبات ملهجا % % 27(@)(@@) % لا بل إلى ذات الصلاح محوجا % % فليلجم المعروف حر أسرجا % % 28(@)(@@) % ببعض ما صفر أو ما سذجا % % لا بأس إن أقرع أو إن أترجا % % 29(@)(@@) % كلا وإن جلب أو إن سكبجا % % واذكر بنفشا يخلف الهليلجا % % 30(@)(@@) % سمانجون اللون يحكي النيلجا % % فإنه إن زار عودا أبهجا % % PageV01P970 31(@)(@@) % ولم يزل في مرج شكري ممرجا % % وفي وداد لم يكن ممزجا % % 32(@)(@@) % يا صاحب البر الذي تولجا % % قسرا بلا إذن وما تحرجا % % 33(@)(@@) % تمم وإلا كان برا 
ms258	 أعرجا % % إنك أن تممت برا هملجا % % 34(@)(@@) % بل اهذب الإحضار مأمون الوجى % % إلى نهايات العلا واستخرجا % % 35(@)(@@) % مالك عندي من خراج فزجا % % وهو الثناء المستماح المرتجى % % 36(@)(@@) % ذاك الذي من اكتساه استبهجا % % والشكر إن أنضجت جاء منضجا % % 37(@)(@@) % يرضي وإن لهوجته تلهوجا % % فلا يعد كرم كريم عوسجا % % 38(@)(@@) % على أخ حر كريم المنتجى % % لم ينتقده العلماء بهرجا % % 39(@)(@@) % ولم يجده الجهلاء أهوجا % % وانظر ولا تغش الطريق الأعوجا % % 40(@)(@@) % كم فرجت غماء عمن فرجا % % فلينتظر مثر مضيقا محرجا % % PageV01P971 41(@)(@@) % سيجعل الله لكل مخرجا % % ويعرج البر إليه معرجا % % PageV01P972 البحر : - 1(@)(@@) % وقائلة بالنصح لم لا تزوج % فقلت لها غيري إلى القرن أحوج % 2(@)(@@) % كشيخ رأيناه تزوج آنفا % فأمسى وما دناه كسرى المتوج % 3(@)(@@) % علا قرنه في الجو حتى كأنه % % إلى النجم يرقى أو إلى الله يعرج % 4(@)(@@) % على أنه جعد البنان دحيدح % إذا ما مشى مستعجلا قيل يدرج % 5(@)(@@) % أظن أبا حفص سيحسب أنه % % هو الرجل المعني والحق أبلج % PageV01P973 البحر : - 1(@)(@@) % عيني إلى من أحب تختلج % والصبر عن حسن وجهه سمج % 2(@)(@@) % طال اشتياقي إلى منعمة % يستعبد القلب طرقها الغنج % 3(@)(@@) % لو طلعت في الظلام غرتها % % ظلت ستور الظلام تنفرج % 4(@)(@@) % متى أرى خلوة يظل بها % % ريقي بريق الخليل يمتزج % 5(@)(@@) % قد أفضي الطيز إلى فقحة % مفتوقة بالطعن مضروجة % 5(@)(@@) % يا حور ما للحبيب يفعل بي % % أشياء لا يستحلها الحرج % 5(@)(@@) % ويلك يا قد البرستوجه % % ما انت والله بمغنوجه % % 5(@)(@@) % نكنا فنكنا منك دراعة % من قبلها والدبر مفروجه % % 5(@)(@@) % فبالقناني أنت محذوفهقربة % وطيزها المهتوك فلوجه % % 5(@)(@@) % فأنت في الفقحة مجروحة % وأنت في الكعثب معفوجه % PageV01P974 5(@)(@@) % وأنت إن غنيت مثلوجة % وأنت إن حدثت مفلوجه % 5(@)(@@) % وإن تمشيت فدحروجة % وإن تفحجت ففرجه % 5(@)(@@) % لقد لفظنا منك ملفوظة % % وقد مججنا منك ممجوجه % % 5(@)(@@) % يا جبهة جلحاء مقبوبة % % وفقحة رسحاء محلوجه % % 5(@)(@@) % أمن مسوخ الله مسروقة % % أم من مسوخ الله منتوخه % % 5(@)(@@) % يا كعبة للنيك منصوبة % لكنها ليست بمحجوبه % % PageV01P975 البحر : - 1(@)(@@) % لو صادت البقة فيل الزنج % وهملج 
ms259	 البرغوث تحت السرج % % 2(@)(@@) % وأصبح الهفت كشطر البنج % % ما كن في الحج ولا في الدج % 3(@)(@@) % أعجب من لعبك بالشطرنج % % PageV01P976 البحر : - 1(@)(@@) % مدحتك مختارا فلم تك طائلا % فلا تلحني إن هجوتك محرجا % % 2(@)(@@) % إذا مادح ارقت عينيه باطلا % كواك بمكواة الهجاء فأنضجا % % 3(@)(@@) % ولا بد من حمل الهجاء ثقافه % على عود ممدوح إذا كان أعوجا % % 4(@)(@@) % فإن قلت سمج ما أتيت فصادق % وبخسك حقي كان من قبل أسمجا % % 5(@)(@@) % على أنه لا ذنب عند ذوي النهى % % لناقد أرض عرف الناس بهرجا % % 6(@)(@@) % رأى الناس يغترون منك بظاهر % كذوب فجلى من غرورك ما دجا % % 7(@)(@@) % هجاك فلم يترك رجاء لمن رجا % % جداك ولا بقى هجاء لمن هجا % % 8(@)(@@) % وقد كان من يرجوك في سجن حيرة % % فأوجدهم من ذلك السجن مخرجا % % 9(@)(@@) % ألا رب غر باعك النوم ليله % وراقب ضوء الفجر حتى تبلجا % % 10(@)(@@) % يدبج فيك الشعر ضل ضلاله % فكافأت بالحرمان ما كان دبجا % % PageV01P977 البحر : - 1(@)(@@) % لا غرني يا صاحب الدستيجه % بهجة تلك الصورة البهيجه % 2(@)(@@) % كانت عدات منك لي نفيجه % مقدمات ما لها نتيجه % PageV01P978 البحر : - 1(@)(@@) % يا طيب الثغر والمجاجه % اقض لنا حاجة بحاجه % 2(@)(@@) % خذ من دنانيرنا وبعنا % . . . ودعنا من اللجاجه % 3(@)(@@) % وأنت يا سيدي رخيص % بخلع كسرى عليك تاجه % 4(@)(@@) % عرج علينا نصب غداء % ونعمل العود والزجاجه % 5(@)(@@) % يا حسن الوجه لا تسمج % فتفسد الحسن بالسماجه % 6(@)(@@) % هل مانعي حاجتي مليح % خلو من البغض والفجاجه % 7(@)(@@) % وإنما حاجتي إليه % % حاجة ديك إلى دجاجه % PageV01P979 البحر : - 1(@)(@@) % أراك أشفقت من الفالج % % علي أو من بلغم هائج % 2(@)(@@) % إن كان هذا يا بن ساداتنا % % فاخلفه لي بالطائر الدارج % % 3(@)(@@) % أو لا فحسبي سمكي إنه % % خير مزاج الجسم للمازج % % 4(@)(@@) % ولا تخف من مطعم بارد % % على امرىء صور من مارج % % 5(@)(@@) % لا تحسبوا ضربة صيادكم % % أتت على المنتوج والناتج % % 6(@)(@@) % فإن في دجلة حيتانها % % عديد ضعفي موجها المائج % % 7(@)(@@) % أنت الذي لا ينتهي جوده % أو يتناهى لهج اللاهج % % 8(@)(@@) % وابن الألى أربت مساعيهم 
ms260	 % % على نسيج الشعر والناسج % % 9(@)(@@) % وما ابن عمار أرى مقلعا % أو نلتقي في رهج راهج % % PageV01P980 البحر : - 1(@)(@@) % يا باني الدرج الذي % % أولى به هدم الدرج % 2(@)(@@) % بئس البنا هي في المسا % % جد والديار فلا تلج % 3(@)(@@) % لا سيما لأبي البنا % % ت الناظرات من . . . % 4(@)(@@) % وإخال أنك قائل % % فيها لنسوتنا فرج % 5(@)(@@) % وكذاك أنتم معشر % في عود غيرتكم عوج % 6(@)(@@) % لو أن قمل رؤوسكم % % ذات القرون إذا درج % % 7(@)(@@) % شاء العروج إلى السما % % ء على قرونكم عرج % 8(@)(@@) % لولا الجوار وحفظه % حدثت عنك ولا حرج % % PageV01P981 البحر : - 1(@)(@@) % هب على رأسك العنا % % قيد والقار والسبج % 2(@)(@@) % هب على رأسك الدجى % % ثبجا فوقه ثبج % % 3(@)(@@) % جمة فوق جمة % % درجا خلفه درج % 4(@)(@@) % أين وجه كأنه % % عدم الروح والفرج % % 5(@)(@@) % أين رأس كأنه % % من مشق استها خرج % 6(@)(@@) % أين خطم كأنما % % فوك من تحته شرج % % 7(@)(@@) % أين عين بعيدة % من فتور ومن دعج % % 8(@)(@@) % فوقها حاجب أحص % % ص بعيد من الزجج % 9(@)(@@) % يا سليبا من الملا % % حة والحسن والبهج % 10(@)(@@) % مزج القبح كله % % فيك بالمقت فامتزج % PageV01P982 11(@)(@@) % لك وجه تذوب مق % تا وبغضا له المهج % 12(@)(@@) % ما بأمثاله يبش % شر جفن إذا اختلج % 13(@)(@@) % أنضج القبح فيك جد % دا وما أنضج المشج % 14(@)(@@) % أيها السائلي به % % وضح الصبح فانبلج % 15(@)(@@) % هو كالبحر حدث الن % % ناس عنه ولا حرج % 16(@)(@@) % هو ما شئت من جنو % % ن وحمق ومن هوج % 17(@)(@@) % وإذا مازح أمرأ % % جمد الروح أو ثلج % 18(@)(@@) % أيها الناس ويحكم % طالبوه بمن فلج % PageV01P983 البحر : - 1(@)(@@) % سكيننا هذا له حدة % تصلح للتقطيع والوجء % 2(@)(@@) % يفجأ من لامسه حتفه % بل حتفه أوحى من الفجء % PageV01P984 البحر : - 1(@)(@@) % شجو قلبي من سائر الخلق شاجي % % ليس للقلب دونها من معاج % 2(@)(@@) % أفردتها بالقلب أفراد حسن % % خلقت وحدها بلا أزواج % 3(@)(@@) % فجرى حبها من القلب والأح % % شاء مجرى خلاف مجرى اللجاج % 4(@)(@@) % هو حب جاء الهوى فيه والرأ % % ي سواء وليس بالإلهاج % 5(@)(@@) % ذات جيد يزهى على كل عقد % % وجبين 