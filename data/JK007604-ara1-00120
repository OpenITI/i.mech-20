ms101	(@)(@@) % أأردت أن تأتي علي بما % % حدثتني ، وتغمني دهري % % 5(@)(@@) % هذا ، وتذكرني لكل أخ ، % يغشاك ، ذكر المادح المطري % % 6(@)(@@) % لتزينني ، والشين ذكرك لي ، % فاذكر هناتك واله عن ذكري % % 7(@)(@@) % واقطع بسيف صارم ذكر % أسباب كتب بيننا تجري % % 8(@)(@@) % فإن امتنعت ، فلا مواترة ، % حسبي كتاب منك في الدهر % 9(@)(@@) % فإذا هممت ، ولا هممت به ، % فبشعرة ، واكتب من البحر % 10(@)(@@) % واجمع حوائجك التي حضرت % عند الكتاب إلي في سطر % PageV01P477 11(@)(@@) % ما ذاك إلا أنني رجل ، % لا أستخف صداقة البصري % % 12(@)(@@) % ذهبت بنا كوفان مذهبها ، % وعدمت عن ظرفائها صبري % % PageV01P478 البحر : طويل 1(@)(@@) % وجدت لكل الناس في الجود خطة % ولو كان سقي الماء في منتهى القر % 2(@)(@@) % سوى المعبديين الذين قدورهم % تحرز فيها العنكبوت من الحر % 3(@)(@@) % هم أحرزوا الرغفان حت تكلمت : % أمنا بحول الله من حذر الكسر % PageV01P479 البحر : وافر تام 1(@)(@@) % إذا ما كنت عند قيان موسى ، % فعند الله ، فاحتسب السرورا % % 2(@)(@@) % خنافس خلف عيدان قعود ، % يطول قربها اليوم القصيرا % % 3(@)(@@) % إذا غنين صوتا كان موتا ، % وهجن به عليك الزمهريرا % % PageV01P480 البحر : خفيف تام 1(@)(@@) % قل لمن يدعي سليما سفاها : % لست منها ولا قلامة ظفر % 2(@)(@@) % إنما أنت من سليم كواو % ألحقت في الهجاء ظلما بعمرو % % PageV01P481 البحر : مجزوء الوافر 1(@)(@@) % دع الرسم الذي دثرا ، % يقاسي الريح والمطرا % % 2(@)(@@) % وكن رجلا أضاع العل % م في اللذات والخطرا % % 3(@)(@@) % ألم تر ما بنى كسرى ، % بعازب حرة يلقى % % 4(@)(@@) % منازه بين دجلة وال % فرات تفيأت شجر ا % % 5(@)(@@) % بأرض باعد الرح % من عنها الطلح والعشرا % % 6(@)(@@) % ولم يجعل مصايدها % % يرابيعا ، ولا وحرا % % 7(@)(@@) % ولكن حور غزلان % تراعي بالملا بقرا % % 8(@)(@@) % وإن شئنا حثثنا الطي % ر من حافاتها زمرا % % 9(@)(@@) % و ‘ ن قلنا اقتلوا عنكم ، % يباكر شربها الخمرا % % 10(@)(@@) % أتاك حليب صأفية % شجا قطفا ومعتصرا % % PageV01P482 11(@)(@@) % فذاك العيش لا سيدا % بقفرتها ، ولا وبرا % % 12(@)(@@) % بعازب حضرة يلفى % % بها العصفور منجحرا % % 13(@)(@@) % إذا ما كنت بالأشيا % % ء في الأعراب معتبرا % % 14(@)(@@) % فإنك أيما رجل ، % وردت ، فلم تجد صدرا % % 15(@)(@@) % ومن 
ms102	 عجب لعشقهم ال % % جفاة الجلف والصحرا % % 16(@)(@@) % فقيل مرقش أودي ، % ولم يعجز وقد قدرا % % 17(@)(@@) % وقد أودى ابن عجلان ، % ولم يفطن له خبرا % % 18(@)(@@) % فحدث كاذبا عنه ، % وقال بغير ما شعرا % % 19(@)(@@) % ولو كان ابن عجلان % من البلوى كما ذكرا % % 20(@)(@@) % ومر يريد ديوان ال % هوى وأخبه عذرا % % PageV01P483 21(@)(@@) % تعد الشيح والقيصو % % م ، والفقهاء والسمرا % % 22(@)(@@) % جني الآس والنسري % % ن والسوسان إن زهرا % % 23(@)(@@) % ويغنيها عن المرجا % % ن أن تتقلد البعرا % % 24(@)(@@) % وتغدو في براجدها % % تصيد الذئب والنمرا % % 25(@)(@@) % أما والله لا أشرا ، % حلفت به ولا بطرا % % 26(@)(@@) % لو ان مرقشا حي % % 27(@)(@@) % كأن ثيابه أطلع % ن من أزراره قمرا % % 28(@)(@@) % ومر يريد ديونض ال % خراج مضمخا عطرا % % 29(@)(@@) % بوجه سابري لو % تصوب ماؤه قطرا % % 30(@)(@@) % وقد خطت حواضنه % له من عنبر طررا % % PageV01P484 31(@)(@@) % بعين خالط التفتي % % ر في أجفانها الحورا % % 32(@)(@@) % يزيدك وجهه حسنا ، % إذا ما زدته نظرا % % 33(@)(@@) % لأيقن أن حب المر % د يلفى سهله وعرا % % 34(@)(@@) % ولا سيما ، وبعضهم % إذا حييته انتهرا % % PageV01P485 البحر : منسرح 1(@)(@@) % قل لزهير ، إذا اتكا وشدا : % أقلل أو اكثر ، فأنت مهذار % 2(@)(@@) % سخنت من شدة البرودة ح % % تى صرت عندي كأنك النار % 3(@)(@@) % لا يعجب السامعون من صفتي % % كذلك الثلح بارد حار % PageV01P486 البحر : - 1(@)(@@) % أيا أمين الله من للندى ، % وعصمة الضعفى ، وفك الأسير % 2(@)(@@) % خلفتنا بعدك نبكي على % % دنياك والدين بدمع غزير % 3(@)(@@) % يا وحشتا بعدك ! ماذا بنا % % أحل من ضنك صروف الدهور % 4(@)(@@) % لاخير للأحياء في عيشهم % بعدك ، والزلفى لأهل القبور % PageV01P487 البحر : طويل 1(@)(@@) % ومستعبد إخوانه بثرائه % لبست له كبرا ، أبر على الكبر % 2(@)(@@) % إذا ضمني يوما وإياه محفل % رأى جانبي وعرا يزيد على الوعر % 3(@)(@@) % أخالفه في شكله ، وأجره % على المنطق المنزور ، والنظر الشزر % 4(@)(@@) % لقد زادني تيها على الناس أنني % % أراني أغناهم ، وإن كنت ذا فقر % 5(@)(@@) % فوالله لا يبدي لساني لجاجة % إلى أحد حتى أغيب في القبر % 6(@)(@@) % فلا تطمعن في ذاك مني سوقة % ولا ملك الدنيا المحجب في 
ms103	 القصر % 7(@)(@@) % فلو لم أرث فخرا لكانت صيانتي % % فمي عن سؤال الناس حسبي من الفخر % % PageV01P488 البحر : خفيف تام 1(@)(@@) % حي ربع الغنى ، وأطلال حسن ال % % حال أقوين من زمان ودهر % 2(@)(@@) % جادها وابل ملث من الإف % لاس تمريه ريح بؤس وضر % 3(@)(@@) % ثاويات ما بين دار لقيط ، % ما يزايلنها ، فكتاب بحر % 4(@)(@@) % فحذاء الصباغ من دار تيجا % % ت إلى الجدول الذي ليس يجري % % 5(@)(@@) % ترتعي عفر شدة الحال فيها % % وظبا فاقة ، وظلمان فقر % 6(@)(@@) % لم يزر من سكانها حاجث الأ % % يام إلا فتى أعين بصبر % 7(@)(@@) % جوف بيت منها خواء خراب ، % ذهب السيل منه شطرا بشطر % % 8(@)(@@) % عدم المؤنسين غير كراري % % س يسلبن همه في قمطر % % 9(@)(@@) % وجزاز فيها الغريب ، إذا جا % % ع قراها ، فمال بطا لطهر % % 10(@)(@@) % ثم والى بين الجشاء ، كأن قد % بيع الشبع من . . . . . . . . . جزر % % PageV01P489 11(@)(@@) % والرقاشي من تكرمه تج % زأ أمعاؤه بإنشاد شعر % PageV01P490 البحر : طويل 1(@)(@@) % ألا قل لعمرو كيف أني واحد ، % ومثلك يا ذا في الأنام كثير % 2(@)(@@) % قطعت إخائي بادئا ، وجفوتني ، % وليس أخي من في الوداد يجور % 3(@)(@@) % ولو أن بعضي رابني لقطعته ، % فكيف تراني للعدو أصير % 4(@)(@@) % عليك سلام ، سوف دون لقائكم % تمر شهور بعدهن شهور % PageV01P491 البحر : سريع 1(@)(@@) % قولا لإخواني أرى ودعم % أودت به عقارب تسري % % 2(@)(@@) % وعاد ما عاودت من وصلكم % عندي ، وبالا آخر الدهر % 3(@)(@@) % وصرت ، والأمثال مضروبة % في بعض ما يؤثر في الشعر % 4(@)(@@) % كالأمة الورهاء ، لا ماءها % % أبقت ، ولا أبقت أذى البطر % PageV01P492 البحر : طويل 1(@)(@@) % إذا ما افترقنا فادر أن لست من ذكري ، % ولاتك في شك ، كأنك لاتدري % % 2(@)(@@) % وخت على عمد ، بعلمك ، وانسني ، % ولا تر لي الإحسان يوما من الدهر % 3(@)(@@) % كشفت خبيئات الأمور ، وأدركت % يدي فلتات الرأي في مبتدا الأمر % 4(@)(@@) % عليك سلام ، لا لود رعيته ، % ولكن مثلي لا يقيم على صغر % PageV01P493 البحر : رجز تام 1(@)(@@) % لما غدا الثعلب من وجاره ، % يلتمس الكسب على صغاره % 2(@)(@@) % جذلان قد هيج من دواره % عارضته في سنن امتياره % 3 
ms104	(@)(@@) % بضرم يمرح في شواره ، % في الحلق الصفر وفي أسياره % 4(@)(@@) % مضطرم القصرى من اضطماره ، % قد نحت التلويح من أقطاره % 5(@)(@@) % من بعد ما كان إلى أصباره ، % غضا كسته الخور من عشاره % 6(@)(@@) % أيام لا يحبس من عثاره ، % وهو طلى لم يدن من شفاره % 7(@)(@@) % في منزل يحجب عن زواره ، % يساس فيه طرفي نهاره % 8(@)(@@) % حتى إذا أحمد في ابتياره ، % وآض مثل القلب من نضاره % 9(@)(@@) % كأنما قرب من هجاره ، % يجمع قطريه من انضماره % 10(@)(@@) % وإن تمطى تم في أشباره ، % عشر ، إذا قدر في اقتداره % PageV01P494 11(@)(@@) % كأن لحييه لدى افتراره ، % شك مسامير على طواره % 12(@)(@@) % كأن ، خلف ملتقى أشفاره ، % جمر غضى يدمن في استعاره % % 13(@)(@@) % سمع ، إذا استروح لم تماره ، % إلا بأن يطلق من عذاره % 14(@)(@@) % فانصاع كالكوكب في انحداره ، % لفت المشير موهنا بناره % 15(@)(@@) % حتى إذا أخصف في إحضاره ، % خرق أذنيه شبا أظفاره % 16(@)(@@) % حتى إذا ما انشام في غباره ، % عافره أخرق في عفاره % 17(@)(@@) % فتلتل المفصل من فقاره ، % وقد عنه جانبي صداره % 18(@)(@@) % لا خير في الثعلب في ابتكاره ! % % PageV01P495 البحر : رجز تام 1(@)(@@) % إذا الشياطين رأت زنبورا ، % قد قلد الحلقة والسيورا % % 2(@)(@@) % دعت لخزتن الفلا ثبورا ، % أدفى ترى في شدقه تأخيرا % % 3(@)(@@) % ترى إذا عارضته مغرورا ، % خناجرا قد نبتت سطورا % % 4(@)(@@) % مشبكات تنظم السحورا ، % أحكم في تأديبه صغيرا ! % 5(@)(@@) % حتى توفى الستة الشهورا ، % من سنة أو بلغ الشفورا % % 6(@)(@@) % وعرف الإيحاء والصفيرا ، % و الكف أن تومىء أو تشيرا % % 7(@)(@@) % يعطيك أقصى حضره الموفورا ، % شدا ترى من همزه الأظفورا % % 8(@)(@@) % منتشطا من أذنه سيورا ، % فما يزال والغا تامورا % % 9(@)(@@) % من ثعلب غادره عفيرا ، % أو أرنب جورها تجويرا % % 10(@)(@@) % فأمتع الله به الأميرا ! % ولا يزال فرحا مسرورا ! % PageV01P496 11(@)(@@) % مكرما من غبطة مبرورا ، % يزين المنبر والسريرا % % PageV01P497 البحر : رجز تام 1(@)(@@) % قد أغتدي والليل في اعتكاره ، % بأغضف يموج في شواره % 2(@)(@@) % مؤدب ما يصطلى بناره ، % كالوتر المخضر في إمراره % 3(@)(@@) % أشرف متناهث على فقاره ، % يسبق مر الريح في إحضاره % 4(@)(@@) % في حس جني 
ms105	 على إصراره ، % سمع فلاة غير ما اقشعراره % 5(@)(@@) % لا يمهل الظبي على إقداره ، % حتى يرى بين شبا أظفاره % 6(@)(@@) % قبل رجوع الطرف عن إمراره ، % محله من يمن وداره % PageV01P498 البحر : سريع 1(@)(@@) % قد أغتدي ، والصبح مشهور ، % قد طلعت فيه التباشير % 2(@)(@@) % بمخطف الأيلل في خطمه % طول ، وفي شدقيه تأخير % 3(@)(@@) % عملس العجز ، بعيد الخطى ، % مسلجم المتنين محضير % 4(@)(@@) % حتى ذعرنا كنسا لم يصب % بها من الأحداث مقدور % 5(@)(@@) % اقترنت من خشية للردى % % عفرها في النقع زنبور % 6(@)(@@) % كأنه سهم إلى غاية ، % أو كوكب في الأفق محدور % 7(@)(@@) % فحان منها قرهب عفرت % من بعده عنز ويعفور % 8(@)(@@) % حتى إذا والى لنا أربعا ، % واثنين ، والمجهود موفور % 9(@)(@@) % رحنا به ننضح أعطافه ، % وهو بما أولاه مشكور % 10(@)(@@) % رحنا به في تربة ، إذ أتت % ومثله للجهد مذخور % PageV01P499 البحر : رجز تام 1(@)(@@) % يا أيها المطنب ذا الغرور ، % في صفة السود من الطيور % 2(@)(@@) % في الحسن الهداء والتخيير ، % ريب شهادات لدعوى زور % 3(@)(@@) % اسمع فما نباك كالخبير ، % من ذي صفات حاذق نحرير % 4(@)(@@) % صفاته محكمة التحيير ، % ما جعل الأسود كاليعفور % 5(@)(@@) % أطيار يعفور ذوات الخير ، % أولى بذات فضلها المذكور % 6(@)(@@) % هذا ثناء حسنها المشهور ، % ياحسنها فوق أعالي الدور % 7(@)(@@) % في حجر شامخة التحجير ، % إذا تهادين من الوكور % 8(@)(@@) % بعرصة الإناث والذكور ، % وطرد الغيور كالغيور % 9(@)(@@) % تكرير تهديل على تكرير ، % كأن في هديلها الجهير % 10(@)(@@) % ترنم العيدان والزمير ، % أو كدوي النحل في القفير % PageV01P500 11(@)(@@) % من مجتنى الذوب أخي التغرير % ذوات هام جهمة التدوير % 12(@)(@@) % وأعين أصفى من البلور ، % في لامع من حمرة منير % 13(@)(@@) % لمع اليواقيت مع الشذور ، % إلى قراطيم نبال حور % 14(@)(@@) % كتوأمات اللؤلؤ المذخور ، % فصل مقرونا من المنثور % 15(@)(@@) % ذوات ريش كمداري الحور ، % وأرجل في حمرة الحرير % 16(@)(@@) % جرد ، كظهر الأدم المبشور % بين البطون الملس والظهور % 17(@)(@@) % من بين ما سبط ، وذي تنمير % كم طائر منهن ذي تشمير % 18(@)(@@) % حزور ، ذي ذنب قصير ، % من مزجل أرسل في البحور % 19(@)(@@) % فشق هول الحور والغمور ، % كفعله بالحزن والوعور 
ms106	 % 20(@)(@@) % يقطع ، كالمستطرد المذعور ، % وخاطف العقبان والصقور % PageV01P501 21(@)(@@) % كالحالق الكاسر للتغوير ، % أو سهم رام قاصد ، طرير % 22(@)(@@) % أو لفت نار بيد المشير ، % حتى هوى للوكر كالممطور % 23(@)(@@) % فضعضع الحجرة بالنعير ، % وكبروا ؛ فأيما تكبير % % 24(@)(@@) % فرب ساع عندها ، بشير % أبر منه قسم النذير % PageV01P502 البحر : رجز تام 1(@)(@@) % لما رأيت الليل قد تشزرا % % عني ، وعن معروف صبح أسفرا % % 2(@)(@@) % كسوت كفي جستبانا مشعرا ، % فروة سنجاب ، لؤاما ، أوبرا % % 3(@)(@@) % تقي بنان الكف ألاتخصرا ، % وغمزة البازي إذا ماطفرا % % 4(@)(@@) % قسمت فيه الكف إلا الخنصرا % % أعددت للبغثان حتفا ممقرا % % 5(@)(@@) % أبرش ، بطنان الجناح ، أقمرا ، % أرقط ، ضاحي الدفتين ، أنمرا % % 6(@)(@@) % كأن شدقيه ، إذا تضورا ، % صدغان من عرعرة تفطر % 7(@)(@@) % كأن عينيه ، إذا ما أثأرا ، % فصان قضا من عقيق أحمرا % % 8(@)(@@) % في هامة علياء تهدي منسرا ، % كعطفة الجيم بكف أعسرا % % 9(@)(@@) % يقول من فيها بعقل فكرا : % لو زادها عينأ إلى فاء ورا % % 10(@)(@@) % فاتصلت بالجيم كانت جعفرا ، % فالطير يلقاه مدقا مدسرا % % PageV01P503 البحر : رجز تام 1(@)(@@) % قد أغتدي ، والليل داج عسكره ، % والصبح يفري جله ، ويدحره % 2(@)(@@) % كاللهب المرتج طار شرره ، % بأحجن الكلوب ، أقنى منسره % 3(@)(@@) % معاود الإقدام حين تذمره ، % أحوى الظهار ، جسد مثعذره % 4(@)(@@) % كأنما زعفره مزعفره ، % لا يوئل الأبغث منه حذره % 5(@)(@@) % حينا يساهيه ، وحينا يدجره ، % يهوي له مخالبا تشر شره % 6(@)(@@) % طورا يفريه ، وطورا ينقره ، % والسرب لا ينفعه تستره % 7(@)(@@) % من الإوز الخانسات تقفره ، % صكا ؛ إذا جد به تقدره % 8(@)(@@) % كطالب الأوتار طلت مئره ، % أو لمحل النحب كان ينذره % PageV01P504 البحر : - 1(@)(@@) % قد كاد هذا الفخ أن يعقرا % % وانحرف العصفور أن ينقرا % % 2(@)(@@) % غيبت بالترب عليه له % بالمستوى ؛ خشية أن ينفرا % % 3(@)(@@) % كما رأى الترب ، رأى جثوة % مائلة الشخص فما استنكرا % % 4(@)(@@) % حتى إذا أشرفها ، موفيا ، % وعاين الحب له مظهرا % % 5(@)(@@) % خاطبه من نفسه زاجر ، % قد كنت لا أرهب أن يزجرا % % 6(@)(@@) % فأعمل الفكر قليلا ، فلا % % يقتله الرحمن ما فكرا % % 7(@)(@@) % فاحتربت لا ونعم ساعة ، % ثم انجلى جند نعم مدبرا % % 8(@)(@@) % فضم كشحيه إلى جؤجؤ ، % كان إذا 
ms107	 استنجده شمرا % % 9(@)(@@) % فلم يرعني غير تدويمه ، % آمن ما كنت له مضمرا % % PageV01P505 البحر : رجز تام 1(@)(@@) % قد أغتدي ، والصبح محمر الطرر ، % والليل تحدوه تباشير السحر % 2(@)(@@) % وفي تواليه نجوم كالسرر ، % بسحق الميعة ميال العذر % 3(@)(@@) % كأنه يوم الرهان المحتضر ، % طاو غدا ينفض صبيان المطر % 4(@)(@@) % عن زف ملحاح بعيد المنكدر % أقنى يظل طيره على حذر % 5(@)(@@) % يلذن منه تحت أفنان الشجر % من صادق الوعد طروح بالنظر % 6(@)(@@) % كأنما عيناه في وقبي حجر % بين مآق لم تخرق بالإبر % PageV01P506 البحر : بسيط تام 1(@)(@@) % وقهوة عتقت في دير شماس ، % تفتر في كأسها عن ضوء مقباس % 2(@)(@@) % لولا مداراة حاسيها ، إذا اقتربت % من فيه ، لانتهبت من مقلة الحاسي % % 3(@)(@@) % لها أليفانش من لون ورائحة ، % مثوى مقرهما في العين والراس % 4(@)(@@) % مزاجها دمع حاسيها ؛ فأي فتى % لم يبك إذ ذاقها من حرقة الكاس ! % 5(@)(@@) % سلم ، ولكنها حرب لذائقها ؛ % ياحبذا بأسها ما كان من باس % 6(@)(@@) % نازعتها فتية ، غرا ، غطارفة ، % ليسوا إذا امتحنوا يوما بأنكاس % 7(@)(@@) % لا يبطرون ، ولا يخزون ناديهم ، % كأنهم جثث من غير أنفاس % 8(@)(@@) % يديرها هاشمي الطرف ، معتدل ، % أبهى إذا ما مشى من طاقة الآس % 9(@)(@@) % حث المدام ، وغنانا على طرب : % الآن طاب الهوى يامعشر الناس % 10(@)(@@) % حتى إذا ظن أني غير محتمل ، % أشار نحوي لأمر بين جلاسي % % PageV01P507 11(@)(@@) % فقلت أضرب في معروفه مثلا ، % لعادة قد مضت مني إلى الآسي : % PageV01P508 البحر : خفيف تام 1(@)(@@) % كدر العيش أنني محبوس ، % واقشعرت عن المدام الكؤوس % 2(@)(@@) % وحمت درها كروم الفلالي % % ج وحالت عن طعمها الخندريس % 3(@)(@@) % ولعمري لئن تماسك غربي ، % ونهاني عنها الهمام الرئيس % 4(@)(@@) % لقد استمتعت من اللهو نفسي ، % وحياة الفتى نعيم وبوس % 5(@)(@@) % وجليس كأن ، في وجنتيه ، % كل حسن تصبو إليه النفوس % 6(@)(@@) % قد أصبنا منه ؛ فنستغفر الل % ه كثيرا ، وقد يصاب الجليس % PageV01P509 البحر : طويل 1(@)(@@) % ألا لا تلمني في العقار جليسي ، % ولا تلحني في شربها بعبوس % 2(@)(@@) % لقد بسط الرحمن مني مودة % إليها ، ومن قوم لدي جلوس % 3(@)(@@) % تعشقها قلبي ، فبغض عشقها % % إلي 
ms108	 من الأموال كل نفيس % 4(@)(@@) % جننت على عذراء ، غير قوية ، % شديدة بطش في الزجاج شموس % 5(@)(@@) % ترى كأسها عند المزاج كأنها % % نثرت عليها حلي رأس عروس % PageV01P510 البحر : كامل تام 1(@)(@@) % كيف النزوع عن الصبا والكاس % قس ذا لنا يا عاذلي بقياس % 2(@)(@@) % وإذا عددت سني كم هي ، لم أجد % للشيب عذرا في النزول براسي % % 3(@)(@@) % قالوا شمطت ؛ فقلت ما شمطت يدي % % عن أن تحث إلى فمي بالكاس % 4(@)(@@) % صفراء ، زان رواءها مخبورها ، % فلها المهذب من ثناء الحاسي % % 5(@)(@@) % وكأن شاربها لفرط شعاعها % % بالليل ، يكرع في سنا مقباس % 6(@)(@@) % وألذ من إنعام خلة عاشق % نالته بعد تصعب ، وشماس % 7(@)(@@) % فالراح طيبة ، وليس تمامها % % إلا بطيب خلائق الجلاس % 8(@)(@@) % فإذا نزعت عن الغواية ، فليكن % لله ذاك النزع لا للناس % 9(@)(@@) % وإذا أردت مديح قوم لم تمن % في مدحهم ؛ فامدح بني العباس % PageV01P511 البحر : سريع 1(@)(@@) % إن الذي ضن بقرطاسه ، % أوحشني من بعد إيناسه % 2(@)(@@) % آذنني باليأس من وصله % و القلب مشغوف على ياسه % 3(@)(@@) % وماجد في الفرع من هاشم % إذا انتمى طار بعباسه % 4(@)(@@) % نازعته القهوة في فتية ، % كلهم زين لجلاسه % 5(@)(@@) % سنتهم في شربها بينهم % من ردها صبت على راسه % 6(@)(@@) % إذا حساها بعضهم لم يدع % ما يغمر الذرة في كاسه % 7(@)(@@) % يالك من تفاحة غضة % طيبها حبي بأنفاسه % 8(@)(@@) % فزاد طيبا ريحها طيبه ، % فطاب منها ريح جلاسه % 9(@)(@@) % وطابت الكأس ، وإبريقنا % % من موضع التقبيل من كاسه % PageV01P512 البحر : رمل تام 1(@)(@@) % قل لمن يبكي على رسم درس % واقفا ، ما ضر لو كان جلس % 2(@)(@@) % اترك الربع ، وسلمي جانبا ، % واصطبح كرخية مثل القبس % 3(@)(@@) % بنت دهر ، هجرت في دنها ، % ورمت كل قذاة ودنس % 4(@)(@@) % كدم الجوف ، إذا ما ذاقها % % شارب قطب منها وعبس % PageV01P513 البحر : بسيط تام 1(@)(@@) % قالوا نزعت ، ولما يعلموا وطري ، % في كل أغييد ، ساجي الطرف ، مياس % 2(@)(@@) % كيف النزوع ، وقلبي قد تقسمه % لحظ العيون ، ولون الراح في الكاس % 3(@)(@@) % إذا نزعت إلى رشد تكنفني % % رأيان قد شغلا يسري ، وإفلاسي % % 4(@)(@@) % فاليسر 
ms109	 في القصف للأيام مبتذل ، % و العسر في وصل من أهوى من الناس % 5(@)(@@) % لاخير في العيش إلا بالمدام مع ال % أكفاء في الورد والخيري والآس % 6(@)(@@) % ومسمع يتغنى ، والكؤوس لها % % حث علينا بأخماس وأسداس % 7(@)(@@) % ياموري الزند قد أعيت قوادحه ، % اقبس إذا شئت من قلبي بمقباس % PageV01P514 البحر : بسيط تام 1(@)(@@) % لأقطعن نياط الهم بالكاس ، % فليس للهم مثل الكأس من آس % 2(@)(@@) % فسقنيها سلافا ، سلسلا ، حجبت % في دنها حقبا في ركن ديماس % 3(@)(@@) % صفراء تضحك عند المزج من شغب % كأن أعينها أنصاف أجراس % 4(@)(@@) % كأن كاساتنا ، والليل معتكر ، % سرج توقد في محراب شماس % 5(@)(@@) % هذا وذاك ، وفتيان لهم أدب ، % شم الأنوف ، سراة غير أنكاس % 6(@)(@@) % نازعتهم قهوة صفراء ، صافية ، % بشاجن خنث ، كالغصن مياس % 7(@)(@@) % مخنث اللفظ ، يسبيني بمقلته ، % مقرطق ، قرشي الوجه ، عباسي % % 8(@)(@@) % كأن إكليله تاج ابن مارية ، % إذ راح معتصبا بالورد والآس % 9(@)(@@) % وقد يغنيك من سكر ومن طرب ، % والكأس تختال من ساق إلى حاسي % % 10(@)(@@) % لله درك قد عذبتني حرقا ، % بالقرب والبعد ، والإطماع والياس % PageV01P515 البحر : بسيط تام 1(@)(@@) % لا خرب الله كرخ السوس والسوسا ، % يوما ، ولا مجلسا بالسوس مأنوسا % % 2(@)(@@) % وحبذا حانة بالكرخ تجمعنا ، % نطيع فيها بشرب الخمر إبليسا % % 3(@)(@@) % راحا مشعشعة ، حمراء ، صافية ، % بالكرخ عتقها الدهقان فادوسا % % 4(@)(@@) % محالف الدين ، قد شابت ذوائبه % يدعونه الناس ربانا وقسيسا % % 5(@)(@@) % حتى إذا ما صفت في دنها بزلت % حمراء ، تذهب عنك الهم والبوسا % % 6(@)(@@) % نازعتها واضح الخدين . معتدلا % يحكي ببهجته للناس بلقيسا % % 7(@)(@@) % مقرطق ، خرسنوه في حداثته ، % لم يغذ والله في مرو ولا طوسا % % PageV01P516 البحر : سريع 1(@)(@@) % دعني من الناس ، ومن لومهم % واحس ابنة الكرم مع الحاسي % % 2(@)(@@) % وابك على ما فات منها ، ولا % % تبك على ربع بأوطاس % 3(@)(@@) % فخمرة أنت لها رابح % % في حالتي يسر ، وإفلاس % 4(@)(@@) % ريحانة من كف ريحانة ، % تزهو على الخيري والاس % 5(@)(@@) % يكاد يعطيني جنى ريقه ، % من فيه ، لولا رقبة الناس % 6(@)(@@) % وليلة سامرت لذاتها % % بشادن ، أحور ، مياس % 7(@)(@@) % نأخذ من صهباء ، كرخية % نكتالها ، وزنا بمقياس 
ms110	 % 8(@)(@@) % أشرب من ريقته مرة ، % ومرة من فضلة الكاس % 9(@)(@@) % متى يرم في سكره منطقا ، % تقل به خطرة وسواس % 10(@)(@@) % حتى انثنى مثل صريع الهوى ؛ % والنوم قد عانق جلاسي % % PageV01P517 11(@)(@@) % أسلس لي حل سراويله ، % من بعد إفضائي إلى الياس % 12(@)(@@) % فنلت ما ضن به صاحيا ، % و القلب مني جامح قاس % 13(@)(@@) % لا خير في اللذات ما لم يكن % صاحبها منكشف الراس % PageV01P518 البحر : بسيط تام 1(@)(@@) % اعزم على سلوة إلا عن الكاس ، % ودع سواها من اللذات للناس % 2(@)(@@) % فالعيش في مجلس حفت جوانبه % بالنرجس الغض ، والنسرين والآس % 3(@)(@@) % أشهى إلى النفس من عدو الكلاب على % % أرانب الصيد ، أو من رمي برجاس % 4(@)(@@) % لا سيما إن أديرت من مقرطقة ، % أو مرهف كقضيب البان مياس % 5(@)(@@) % إطراقه مطمع ، والوصل ممتنع ، % فأنت منه على الإطماع والياس ! % PageV01P519 البحر : طويل 1(@)(@@) % فداؤك نفسي قد طربت إلى الكاس % وتقت إلى شم البنفسج والآس % 2(@)(@@) % فهل لك في أن نجعل اليوم نسكنا ، % ونشربها في البيت سرا من الناس % 3(@)(@@) % فإن فطنوا قلنا : نصارى وعيدهم ، % وليس لشرب الراح في العيد من باس % 4(@)(@@) % وإن أكبروا الإفطار ، أو شنعوا به ، % أعدنا لهم بوما جديدا على الراس % PageV01P520 البحر : كامل تام 1(@)(@@) % اربع على الطلل الذي انتسفت % منه المعالم أنجم النحس % 2(@)(@@) % واستوطنته العفر قاطنة ، % ولقد يكون مرابع الإنس % 3(@)(@@) % لعبت به ريح يمانية ، % و حواصب تركته كالطرس % 4(@)(@@) % فلئن عفا ، وعفت معالمه ، % فلقد خضعت ، وكنت ذا نفس % 5(@)(@@) % وحللت عقد هواي مقتصرا ، % لصبوح موفية على الشمس % 6(@)(@@) % صفراء سلك جمان لؤلؤها % % ألفات كاتب سيد الفرس % 7(@)(@@) % ترمي الحباب بمثله صعدا ، % دقت مسالكها عن الحس % 8(@)(@@) % و كأنما هي ، حين تبرزها % % للشاربين ، عصارة الورس % 9(@)(@@) % و إذا ترام تفوت لامسها ، % مثل الهباء يفوت باللمس % 10(@)(@@) % وموحد في الحسن ، جلله % بردائه ذو الطول والقدس % PageV01P521 11(@)(@@) % إن شئت قلت خريدة جليت % للشرب ، يوم صبيحة العرس % 12(@)(@@) % وأعيذه من أن يكون له % ما تحت مئزرها من الرجس % 13(@)(@@) % غنى على طرب يرجعه ، % ليحث كأس معاود 
ms111	 الحبس % 14(@)(@@) % يا خير من وخدت بأرحله % نجب الركاب بمهمه حلس % 15(@)(@@) % فثنى عليه لواحظا نطقت % منه بمثل نواطق المس % 16(@)(@@) % و ثنى يغنينا معارضه : % لمن الديار بجانبي لجس % 17(@)(@@) % فلو ان قسا كان حاضره ، % لصبت إليه عبادة القس % PageV01P522 البحر : رمل تام 1(@)(@@) % اسقنيها يا نديمي يغلس ، % لا بضوء الصبح بل ضوء القبس % 2(@)(@@) % قهوة عتقها خمارها % % زمنا في الدن بحتا ، وحبس % 3(@)(@@) % ثم زفت في قميص أدكن ، % فتحلت كفتاة في العرس % 4(@)(@@) % صبها الشادن في طاساتها ، % فترامت بشرار يقتبس % 5(@)(@@) % ولها رائحة المسك ؛ فإن % شمها الشارب من كأس عبس % PageV01P523 البحر : بسيط تام 1(@)(@@) % ياعاذلي بملام مر بالياس ، % فلست أقلع عن ريحانة الكاس % 2(@)(@@) % تباعد العذل عن قلبي على ثقة ، % كما تباعد بين الورد والآس % 3(@)(@@) % إن المزاج لها إلف ، يعانقها ، % وفيه طعم يحاكي قبلة الحاسي % % 4(@)(@@) % فاشرب نديمي على العينين والراس ، % كذاك ، وستفتح اللذات بالكاس % 5(@)(@@) % وغنني ، قد أجاب العود شائقه % وحرك الناي مني بعض وسواسي : % 6(@)(@@) % ياموقد النار قد أعيت قوادحه ، % اقبس إذا شئت من قلبي بمقباس % % PageV01P524 البحر : كامل تام 1(@)(@@) % نفس المدامة أطيب الأنفاس ، % أهلا بمن بحميه عن أنجاس % 2(@)(@@) % فإذا خلوت بشربها في مجلس ، % فاكفف لسانك عن عيوب الناس % 3(@)(@@) % في الكأس مشغلة ، وفي لذاتها % % فاجعل حديثك كله في الكاس % 4(@)(@@) % صفو التعاشر في مجانبة الأذى ، % وعلى اللبيب تخير الجلاس % PageV01P525 البحر : رمل تام 1(@)(@@) % اسقنيها يا نديمي بغلتس % لا بضوء الصبح بل ضوء القبس % 2(@)(@@) % اسقنيها من قيامي خمسة ، % فإذا دارت فمن شاء حبس % 3(@)(@@) % وعلى ذكر حبيبي فاسقني ، % لا على ذكر محل قد درس % 4(@)(@@) % إن ذكراه على هجرانه ، % لتجلي كرب قلب مختلس % 5(@)(@@) % كان يلقاني زمانا واصلا ، % فالتوى من بعد وصلي ، وشمس % 6(@)(@@) % أفسد الواشون إلفي حسدا ، % تعس الواشي لوقت ونكس % PageV01P526 البحر : هزج 1(@)(@@) % إذا أجرى أمين الل % ه في الحلبة أفراسا % % 2(@)(@@) % أقمنا حلبة اللهو ، % فأجرينا بها الكاسا % % 3(@)(@@) % وأنشأنا بها من ط % رف الريحان أجناسا % % 4(@)(@@) % بميدان جعلنا خي % له طاسا وأكواسا 
ms112	 % % 5(@)(@@) % وصيرنا على السبق % مكان القصب الآسا % % 6(@)(@@) % ومجريهن ساق يب % % عث الإبريق والطاسا % % 7(@)(@@) % نراه قمرا يجلو ال % % دجى ، قد فتن الناسا % % 8(@)(@@) % يحاكي الصنم المعبو % % د والغصن إذا ماسا % % 9(@)(@@) % وإن جاذبته نام ، % وإن هازضلته باسا % % 10(@)(@@) % فلما ودج الدن ، % وسالت خمرهث راسا % % PageV01P527 11(@)(@@) % بكى ، وانتحب العود ، % وأبدى الدف وسواسا % % 12(@)(@@) % وقام الناي يشكو ب % ث ما لاقى وما قاسى % % 13(@)(@@) % وصاح الصنج حتى أخ % رس الندمان إخراسا % % 14(@)(@@) % فقل لي يا أباعيسى % % بحقي ، هل ترى باسا % % 15(@)(@@) % شباب خلعوا عن فت % كهم عذرا وأمراسا % % 16(@)(@@) % جروا في حلبة اللذا % % ت حتى سبقوا الناسا % % PageV01P528 البحر : بسيط تام 1(@)(@@) % يد لوجهك عندي لو شعرت بها % % مجمجت فيه ضرارا لي بأنفاس % 2(@)(@@) % لما أشرت إليه أنه شجني ، % جرى به العذر لي في ألسن الناس % 3(@)(@@) % فإن هم للقائي بعدها رجعوا ، % أريتهم مرة أخرى من الراسي % % 4(@)(@@) % ما مسني الهجر إلا مسني سقم ، % وليس بي إن هجرت الهجرمن باس % PageV01P529 البحر : سريع 1(@)(@@) % قل لنداماي وجلاسي : % هل لي من عبدة من آس % 2(@)(@@) % أو قائل يخبرها حالفا : % أن ليس منها بي من باس % 3(@)(@@) % فراجعي الوصل فإن زرتكم % قدر فراق فاحلقي راسي % % 4(@)(@@) % أو لا ففيم الصد عن عاشق % ليس لكم ما عاش بالناسي % % 5(@)(@@) % أقامه حبكم مثلجما ، % يعض معلوبا على راسي % % 6(@)(@@) % حتى لقد مج دما خالصا ، % من لثة تجري وأضراس % 7(@)(@@) % لو شئت ، والله ، لأرضيته ، % فلا تقيميه على الياس % PageV01P530 البحر : وافر تام 1(@)(@@) % خلعت وليس يملك رد راسي ، % ولا يدني بإطماع وياس % 2(@)(@@) % بليت من الشقاء سامري ، % يعاملني الغداة بلا مساس % 3(@)(@@) % يرى حرجا عليه مس ثوبي ، % وأن أسقى وإياه بكاس % 4(@)(@@) % وأقسم لا يكلمني ثلاثا ، % بعدتهن إلا وهو ناس % 5(@)(@@) % فمن ذا يبلغ الحلاف عني ، % يقول له : فداك أبو نواس % PageV01P531 البحر : بسيط تام 1(@)(@@) % إني عشقت ، وهل في العشق من باس ، % ما مر مثل الهوى شيء على راسي % % 2(@)(@@) % مالي وللناس ، كم يلحونني سفها ، % ديني لنفسي ودين الناس للناس 
ms113	 % % 3(@)(@@) % ما للعداة ، إذا ما زرت مالكتي ، % كأن أوجههم تطلى بأنقاس % 4(@)(@@) % الله يعلم ما تركي زيارتكم ، % إلا مخافة أعدائي وحراسي % % 5(@)(@@) % و لو قدرنا على الإتيان جئتكم % سعيا على الوجه أو مشيا على الراس % 6(@)(@@) % وقد قرأت كتابا من صحائفكم % لا يرحم الله إلا راحم الناس % PageV01P532 البحر : سريع 1(@)(@@) % كفاك ما مر على راسي % % من شاجن هيج وسواسي % % 2(@)(@@) % أفضل ما أبلغ من نعته % تحدثي عن قلبه القاسي % % 3(@)(@@) % كل أحاديثي سوى ذكرها ، % منكشف مني لجلاسي % % 4(@)(@@) % لا حبذا الشركة في حبها ، % وحبذا الشركة في الكاس ! % PageV01P533 البحر : بسيط تام 1(@)(@@) % أني تشاف المغاني ، وهي أدراس ، % كأن باقيها في العين أطراس % 2(@)(@@) % أزرى بها كل ما أزرى بمشبهها % % فهن ، إلا الصدا ، صم وأخراس % 3(@)(@@) % فما استرقك فيما عندها طمع ، % إلا استعزك فيما عندها الناس % 4(@)(@@) % وقد يضم علي الليل نقبته % ولا مسامر إلا السوء والباس % PageV01P534 البحر : منسرح 1(@)(@@) % ونابه في الهوى لنا ناس ، % قطع لي بالهجران أنفاسي % % 2(@)(@@) % لست لها واصفا مخافة أن % يعرف ما بي جماعة الناس % 3(@)(@@) % أكثر وصفي لها شكاية ما % % فيها قضى الله لي على راسي % % 4(@)(@@) % يطمعني لحظهان ويؤنسني % % باللفظ منها فؤادها القاسي % % 5(@)(@@) % فصرت باللحظ من معذبتي ، % واللفظ بين الرجاء والياس % 6(@)(@@) % أسعد يوم لها حظيت به % تحسب أني لقولها ناس % 7(@)(@@) % لذالك اليوم ما حييت ، وما % % ترجم قولي سواد أنقاسي % % 8(@)(@@) % تقول لي ، والمدام مرسلة ، % تفيض حولي نفوس جلاسي : % 9(@)(@@) % هل لك أن تطرد النعاس فقد % % طاب انضواع المدام والآس % 10(@)(@@) % قلت لها : فابتدي وهاتي ، فما % % حسوت منها فإنني حاس % PageV01P535 11(@)(@@) % وغايتي أن أنال فضلتها % % في الكأس من شربها أو الطاس % 12(@)(@@) % ثم أظن الحذار نبهها ، % وما بها قد أردت من باس % 13(@)(@@) % قالت : فدع عنك الاحتيال لما % % أردت سكري له وإنعاسي % % 14(@)(@@) % أعرضت عنها وقد فهمت لكي % % 15(@)(@@) % ثم دعتها زقنا ، فمج بها % % في الكأس راحا كضوء مقباس % 16(@)(@@) % ثم تحست ، حتى إذا شربت % نصفا ، كما قيس لي بمقياس % 17(@)(@@) % نازعتها الكأس 
ms114	 ، فيه فضلتها ، % ففزت بالكاس بعد إمراس % 18(@)(@@) % فكادت النفس للسرور بها ، % تخرج بين المدام والكاس % PageV01P536 البحر : هزج 1(@)(@@) % رأيت العيش ما كنت % به المغبوط في الناس % 2(@)(@@) % وعيش ما به عندي % % ولا عندك من باس % 3(@)(@@) % معاطاتك من أحبب % ت فوق الورد والآس % 4(@)(@@) % من الراح ، وإقران % ك منه الراس بالراس % 5(@)(@@) % وإنباهكه في سا % % دة من خير جلاسي % % 6(@)(@@) % يحاكي خبل المأمو % % م قد شط عن الآسي % % 7(@)(@@) % فيحسو ما يبقيه % من الفضلة في الكاس % PageV01P537 البحر : مجزوء الكامل 1(@)(@@) % زهدت جنان في الذي % % رغبت إليها فيه نفسي % % 2(@)(@@) % فزهدت في الدنيا وصا % % رت منيتي في زور رمسي % % 3(@)(@@) % وطويتث عيني أن ترا % % ني عينها ، وأمت حسي % % 4(@)(@@) % كيلا يروع ذلك ال % وجه المليح سماع حسي % % PageV01P538 البحر : خفيف تام 1(@)(@@) % صاحب الحب صابرا لا يصدن % ك منه تجهم وعبوس % 2(@)(@@) % وأقل اللجاج واصبر على الجه % د ، فإن الهوى نعيم وبوس % 4(@)(@@) % فلعل الزمان يدنيك منه ، % إن خطب الهوى جليل نفيس % PageV01P539 البحر : سريع 1(@)(@@) % أحس الهوى صرفا مع الحاسي ، % وسل عنك الهم بالكاس % 2(@)(@@) % واتخذ الفتك إماما ، ولا % % تبن بني إلا بآساس % 3(@)(@@) % يا شؤم قلب لم يزل شؤمه % في اللوح مكتوبا على راسي % % 4(@)(@@) % عذبني ربي بمن قلبه ، % في البعد ، مثل الحجر القاسي % % 5(@)(@@) % أحور فتان قطوف الخطى ، % أغيد مثل الغصن مياس % 6(@)(@@) % أبيت ليلي ونهاري معا ، % معلقا منه بوسواس % 7(@)(@@) % بان ، وإن لم يك لي نائل % منه ، لأرجوه على ياس % PageV01P540 البحر : مجزوء الخفيف 1(@)(@@) % لاتراني يئست من % تك ، وإن كنت موئسا % % 2(@)(@@) % ربما أحسن الحبي % % ب ، وإن كان قد أسا % % 3(@)(@@) % بأبي وجهكض الذي % % من رآه تنفسا % % 4(@)(@@) % أقطتع الدهر سيدي % % منك باللو والعسى % % PageV01P541 البحر : هزج 1(@)(@@) % دموعي مزجت كاسي ، % وما أظهرت وسواسي % % 2(@)(@@) % ولكن نطقت عيني ، % فنمت عن هوى القاسي % % 3(@)(@@) % وقالوا في بالظن ، % فنكست لهم راسي % % 4(@)(@@) % ومن يسلم ياحبي % من ألسنة الناس % 5(@)(@@) % وهبني بحت بالحب ، % فهل في الحب من باس ؟ ! % PageV01P542 البحر : مجزوء الرمل 1(@)(@@) % وغزال 
ms115	 في الدحى ، لي % ث ظلام ذي فراس % 2(@)(@@) % بت أسقيه من الرا % % ح بكاس بعد كاس % 3(@)(@@) % وأحييه إلى أن % مال من ثقل النعاس % 4(@)(@@) % ثم أدنيت يميني % % نحوه رفقا لماس % 5(@)(@@) % فتصدى قائلا لي % % بابتهار وانتعاس : % 6(@)(@@) % كم ترى مثلك يا جا % % هل قد مر براسي % % 7(@)(@@) % فاخذناه اقتصادا ، % عنوة غير مكاس % 8(@)(@@) % ليس للريحانة الغ % % ضة بد من مساس % PageV01P543 البحر : هزج 1(@)(@@) % رأيت المسجد الجام % % ع قفاعة إبليس % 2(@)(@@) % بناه الله والطال % ع بر غير منحوس % 3(@)(@@) % به خلت ظباء الإن % تس في أقبح مأنوس % 4(@)(@@) % إذا راحوا على العشا % % ق أهل الضر والبوس % 5(@)(@@) % فكم في الصحن من قلب % كليم الجرح ، مخلوس % 6(@)(@@) % بعثنا في سبيل الغي % أفواج الكراديس % 7(@)(@@) % فكردوس لعمار ، % وكردوس لعبدوس % 8(@)(@@) % وعمرو صاحب الراي % ة لا بل درهم الكيس % 9(@)(@@) % تلاقيهم بإعظام ، % وإجلال ، وتقديس % 10(@)(@@) % ويلقونا من التيه % بتكليح وتعبيس % PageV01P544 11(@)(@@) % فيا رب إليك المش % تكى ، تيه الطواويس ! % PageV01P545 البحر : مجزوء الكامل 1(@)(@@) % نبه نديمك ، قد نعس ، % يسقسك كأسا في الغلس % 2(@)(@@) % صرفا كأن شعاعها % % في كف شاربها قبس % 3(@)(@@) % مما تخير كرمها % % كسرى بعانة ، واغترس % 4(@)(@@) % تدع الفتى ، وكأنما % % بلسانه منها خرس % 5(@)(@@) % يدعى ؛ فيرفع رأسه ، % فإذا استقل به نكس % 6(@)(@@) % يسقيكها ذو قرطق ، % يلهى ويعجل من حبس % 7(@)(@@) % خنث الجفون كأنه % ظبي الرياض ، إذا نعس % 8(@)(@@) % أضحى الإمام محمد ، % للدين نورا يقتبس % 9(@)(@@) % ورث الخلافة خمسة ، % و بخير سادسهم سدس % 10(@)(@@) % تبكي البدور لضحكه ، % والسيف يضحك إن عبس % PageV01P546 البحر : هزج 1(@)(@@) % وجيه محمد شمس ، % وملك محمد عرس % 2(@)(@@) % وكفاه تجودان ، % بما لا تأمل النفس % 3(@)(@@) % فما في جوده من ، % ولا في بذله حبس % 4(@)(@@) % شهيداي على ما قل % ت فيه الجن والإنس % PageV01P547 البحر : مجزوء الكامل 1(@)(@@) % قل للخليفة إنني % % حتى أراك بكل باس % 2(@)(@@) % من ذا يكون أبا نواسك ، % إذ حبست أبا نواس ! ؟ % 3(@)(@@) % أقصيته ، ونسيته ، % ولعهده بك غير ناس % 4(@)(@@) % قد كنت آمل غير ذا ، % لو كنت تنصف في القياس % 5 
ms116	(@)(@@) % إن أنت لم ترفع له % رأسا فديت فنصف راس % PageV01P548 البحر : مجزوء الكامل 1(@)(@@) % بك أستجير من الردى ، % وأعوذ من سطوات باسك % 2(@)(@@) % وحياة رأسك لا أعو % % د لمثلها ، وحياة راسك % 3(@)(@@) % من ذا يكون أبا نوا % % سك إن قتلت أبا نواسك ! ؟ % PageV01P549 البحر : هزج 1(@)(@@) % أما وصدود مخمور ، % بعينيه ، عن الكاس % 2(@)(@@) % فلما خشي الإلحا % % ح من صحب وجلاس % 3(@)(@@) % وألا يقبلوا عذرا ، % تحساها مع الحاسي % % 4(@)(@@) % بكفي فاتر اللحظ ، % رخيم الدل ، مياس % 5(@)(@@) % لنا منه مواعيد % بعينيه ، وبالراس % 6(@)(@@) % لئن سميت عباسا ، % فما أنت بعباس % 7(@)(@@) % لدى الجود ، ولكن % % ك عباس لدى الباس % 8(@)(@@) % و بالفضل لك الفضل ، % أبا الفضل ، على الناس % PageV01P550 البحر : منسرح 1(@)(@@) % هل لديار حييتها درس % من صمم ما هتفت ، أو خرس % 2(@)(@@) % غيب عنهن سكنهن ، فما % % بهن من جنة ولا أنس % 3(@)(@@) % إلا شبيها بهن في وضح ال % % جيد ، وحسن العيون ، واللعس % 4(@)(@@) % وصاحب رعته ، وقد ماتت ال % % ظلماء ، إلا حشاشة الغلس % 5(@)(@@) % بخمرة تجتلى لخاطبها % % كجلوة البكر ليلة العرس % 6(@)(@@) % ما انفك لله في رعيته % ذخيرة من ربيعة الفرس % 7(@)(@@) % إذا سنى ذا خبا لمدته ، % أضرم من ذاك راكي القبس % PageV01P551 البحر : - 1(@)(@@) % قل لبني الأشعث لن تصلحوا % % باللوم عندي أمر عباس % 2(@)(@@) % حتى تردوه إلى ربه % يطبعه خلقا من الراس % 3(@)(@@) % ألوم عباسا على بخله ، % كأن عباسا من الناس % 4(@)(@@) % وإنما العباس في قومه ، % كالثوم بين الورد والآس % PageV01P552 البحر : هزج 1(@)(@@) % ألا قل لأمين الل % ه ، وابن القادة الساسه : % 2(@)(@@) % إذا ما ناكث سر % ك أن تفقده راسه % 3(@)(@@) % فلا تقتله بالسيف ، % وزوجه بعباسه % PageV01P553 البحر : متقارب تام 1(@)(@@) % جمحت أبا مسلم ، فاحبس % وقصر من النظر الأشوس % 2(@)(@@) % ولا تغترر بركوب الكميت ، % وما تستجيد من الملبس % 3(@)(@@) % و مشيك بالنخو وسط الرحاب ، % وإن قيل ذا صاحب المجلس % 4(@)(@@) % وقول الفيوج : كتاب الأمير ، % وختم القراطيس بالجرجس % 5(@)(@@) % وكم قد رأينا مطاعا هنا % % ك صار المذلل للمجلس % PageV01P554 البحر : وافر تام 1(@)(@@) % ألم تربع على الطلل الطماس % عفاه كل 
ms117	 أسحم ذي ارتجاس % 2(@)(@@) % وذاري الترب مرتكم حصاه ، % نسيج الميث ، معنقة الدهاس % 3(@)(@@) % سوى سفع أعارتها الليالي % % سواد الليل من بعد اغبساس % 4(@)(@@) % وأورق حالف المثواة ، هاب ، % كضاوي الفراخ من الهلاس % 5(@)(@@) % منازل من عفيرة ، أو سليمى ، % أو الدهماء أخت بني الحماس % 6(@)(@@) % كأن معاقد الأوضاح منها % % بجيد أغن نوم في الكناس % 7(@)(@@) % وتبسم عن أغر كأن فيه % % مجاج سلافة من بيت راس % 8(@)(@@) % فمن ذا مبلغ عمرا رسولا ، % فقد ذكرت ودك غير ناس % 9(@)(@@) % فلم أهجرك هجر قلى ، ولكن % نوائب لا نزال لها نقاسي % % 10(@)(@@) % نوائب تعجز الأدباء عنها ، % ويعيا دونها اللقن النطاسي % % PageV01P555 11(@)(@@) % وقد نافحت عن أحساب قوم ، % هم ورثوا مكارم دي نواس % 12(@)(@@) % فإن تك أوقدت للحرب نار ، % فما غطيت خوف الحرب راسي % % 13(@)(@@) % سأبلي خير ما أبلى محام ، % إذا ما النبل ألجم بالقياس % 14(@)(@@) % وسمت الوائلين بفاقرات ، % بهن وسمت رهط أبي فراس % 15(@)(@@) % وما أبقيت من عيلان إلا % كما أبقى من البظر المواسي % % 16(@)(@@) % وقالت كاهل ، وبنو قعين : % حنانك إننا لسنا بناس ! % 17(@)(@@) % فما بال النعاج ثغت بشتمي ، % وفي زمعاتهن دم الغراس % 18(@)(@@) % وما حامت عن الأحساب ، إلا % لترفع ذكرها بأبي نواس ! % PageV01P556 البحر : سريع 1(@)(@@) % قولا لمن يعشق قصرية ، % يستف حرفا قبل إفلاسه % 2(@)(@@) % فقد ثوى في كف سداجة ، % مسرعة في قلع أضراسه % 3(@)(@@) % تواصل العاشق ، حتى إذا % % ما أخذ الفقر بأنفاسه % 4(@)(@@) % دلت بغدر ، وقرون الفتى % % تهتز بالكشخ على راسه % PageV01P557 البحر : بسيط تام 1(@)(@@) % ما منك سلمى ولا أطلالها الدرس ، % ولا نواطق من طير ولا خرس % 2(@)(@@) % ياهاشم بن حديج لو عددت أبا % مثل القلمس لم يعلق بك الدنس % 3(@)(@@) % إذ صبح الملك النعمان وافده ، % و من قضاعة أسرى . عنده حبس % % 4(@)(@@) % فابتاعهم بإخاء الدهر ما عمروا ، % فلم ينل مثلها من مثله أنس % % 5(@)(@@) % أو رحت مثل حوي في مكارمه ، % هيهات منك حوي حين يلتمس % 6(@)(@@) % أو كالسموأل ، إذ طاف الهمام به % في جحفل لجب الأصوات يرتجس % 7(@)(@@) % فاختار ثكلا ، ولم يغدر بذمته ، % إذ قيل 
ms118	 أشرف تر الأوداج تنبجس % 8(@)(@@) % ما زاد ذاك على تيه خصصت به ، % وكيف يعدل غير السوءة الغرس % PageV01P558 البحر : كامل تام 1(@)(@@) % إن البرامكة الذين تعلموا % % فعل الملوك فعلموه الناسا % % 2(@)(@@) % كانوا إذا غرسوا سقوا ، وإذا بنوا % % لم يهدموا لبنائهم آساسا % % 3(@)(@@) % وإذا هم صنعوا الصنيعة في الورى ، % جعلوا لها طول البقاء لباسا % % PageV01P559 البحر : سريع 1(@)(@@) % يامظهرا شكوى على صرمه ، % مقبحا خلقي لدى الناس % 2(@)(@@) % أفسدت قلبي بعد إصلاحه ، % فعاد بالصرم من الراس % PageV01P560 البحر : سريع 1(@)(@@) % الحمد لله ! ألم ينهني % % تجربة الناس عن الناس % 2(@)(@@) % فأمنع النفس هواها ؛ فقد % % أذلني للناس إفلاسي % % 3(@)(@@) % سكت للدهر وأحداثه ، % حتى خرا الدهر على راسي % % PageV01P561 البحر : رجز تام 1(@)(@@) % أقول للقانص حين غلسا ، % و الصبح في النقاب ما تنفسا % % 2(@)(@@) % يقود كلبا للطراد أطلسا ، % لم يلف عن فريسة تحوسا % % 3(@)(@@) % ما رشق الظباء إلا قرطسا ، % ورثه النجدة مما أسسا % % 4(@)(@@) % أب وخال لم يزل مرأسا ، % تخاله العين لمن تفرسا % % 5(@)(@@) % في حومة الطر هماما أشوسا ، % إن هم بالشدة يوما غلسا % % 6(@)(@@) % فأعدم ، الخزان منه الأنفسا ، % حتى لقد أبكى القنان الطمسا % % 7(@)(@@) % بوركت قناصا سليلا أخنسا ! % فكم رأينا ضاويا مهلسا % % 8(@)(@@) % يشكو ، إذا لاقاك ، جدا تعسا ، % أصبح من كسبك قد تكردسا % % PageV01P562 البحر : رجز تام 1(@)(@@) % قد أغتدي ، قبل مذاذ الخامس ، % بضرم ينغض كف اللامس % 2(@)(@@) % بجلدة تندى ، وحجم يابس ، % عليه ، من منضوحة القلانس % 3(@)(@@) % قنفاء ذات عذاب نوايس ، % يهوع فوها كهواع القالس % PageV01P563 البحر : رجز تام 1(@)(@@) % قد أغتدي قبل طلوع الشمس ، % باحجن الخطم ، كمي النفس % 2(@)(@@) % غرثان إلا أكله بالأمس ، % آنس ، بالطمس وماء الطمس % 3(@)(@@) % كنظر المجنون أو ذي المس ، % حتى إذا أقصد بعد الحبس % 4(@)(@@) % عشرين من حباريات قعس ، % مثل النصارى في ثياب طلس % 5(@)(@@) % فهن بين أربع وخمس ، % صرعى ، ومستدم أميم الرأس % 6(@)(@@) % وحرب يشفن بعد التعس % كأنما صبغتها بورس % PageV01P564 البحر : وافر تام 1(@)(@@) % رأيت لقوس أيوب سهاما ، % مثقفة السوالف ، ما تطيش % 2(@)(@@) % سهام ، لا يذوب لها غراء ، % ولم يشدد لها عقب وريش % 3 
ms119	(@)(@@) % يباكر جيبه ، فيصيد منه ، % ولا يبغي عليه من يحوش % 4(@)(@@) % ولا ينجي الصواية أن يراها % % تضاءل فوقها درز جحيش % 5(@)(@@) % يزر رعالها بالسن زرا ، % و لا تشقى بغدوته الوحوش % PageV01P565 البحر : وافر تام 1(@)(@@) % أمات الله من جوع رقاشا ، % فلولا الجوع ما ماتت رقاش % 2(@)(@@) % ولو أشممت موتاهم رغيفا ، % وقد سكنوا القبور ، إذا لعاشوا ! % PageV01P566 البحر : مجزوء الخفيف 1(@)(@@) % يا غلاما يود كت % مان أمر له فشا % % 2(@)(@@) % أترى أن ما بنا % % صمم عنك ، أو عشا % % 3(@)(@@) % قد رأينا اختصاص طر % فك باللمح خنبشا % % 4(@)(@@) % وتواليك بالرقا % % ع إذا خفت من وشا % % 5(@)(@@) % حاكيات بلفظها % % عروة ، أو مرقشا % % 6(@)(@@) % خبرني ، فدتك نف % تي ، أيا مثشبه الرشا % % 7(@)(@@) % لم تختار أنوكا ، % خامل القدر ، أعمشا % % 8(@)(@@) % أوما ترعوي عن ال % % غي ، في شر من مشى % % 9(@)(@@) % وجد اللوم ضائعا % فرعى فيه ، واختشى % % 10(@)(@@) % ثم ألوى بلحية % مد منها ، ونفشا % % PageV01P567 11(@)(@@) % فإذا ما رأيته ، % وهو مستفحل الحشا % % 12(@)(@@) % قلت راع مملأ ، % راح يستاق أكبشا % % PageV01P568 البحر : رجز تام 1(@)(@@) % يا رب ثور بمكان قاص ، % ذي زمع دلامص دلاص % 2(@)(@@) % بات يراعي النجم من خصاص ، % صبحته بضمر خماص % 3(@)(@@) % لاحقة أظباؤها ، شواص ، % فهن بعد الحضر النصاص % 4(@)(@@) % منه لها حيث يكون الخاصي ، % يكشر عن ناب له قراص % 5(@)(@@) % أرنبة سوداء كالعناصي ، % بها يعاطي ، وبها يعاصي % % 6(@)(@@) % يصيد بالقرب وبالأقاصي ، % كل سمين دهن رقاص % PageV01P569 البحر : وافر تام 1(@)(@@) % ألم ترني أبحت اللهو نفسي ، % وديني ، واعتكفت على المعاصي % % 2(@)(@@) % كأني لا أعود إلى معاد ، % ولا أخشى هنالك من قصاص % PageV01P570 البحر : رجز تام 1(@)(@@) % أنعت كلبا مرهفا خميصا ، % ذا شية ما عدمت وبيصا % % 2(@)(@@) % تخال في أجفانه فصوصا ، % أدب حتى أحكم التقنيصا % % 3(@)(@@) % وعرل الإيحاء والتعويصا ، % بورك كلبا نهما حريصا ! % 4(@)(@@) % هتك عن حجب الظبا قميصا ، % فمحصت آراءها تمحيصا % % 5(@)(@@) % حتى ترى غاليها رخيصا ، % تمنحه الطورين والشخوصا % % 6(@)(@@) % أضحى به مالا له مخصوصا ، % لم ير من عيش له تنغيصا ! % PageV01P571 البحر : رجز تام 1(@)(@@) % آلف ما صدت من القنيص ، آلف ما 
ms120	 صدت من القنيص ، % بكل باز واسع القميص % 2(@)(@@) % ذي برنس مذهب رصيص ، % وهامة ومنسر حصيص % 3(@)(@@) % وجؤجؤ عول باليص ، % مدبج ، معين الفصوص % 4(@)(@@) % على الكراكي نهم حريص ، % آنس عشرين بذات العيص % 5(@)(@@) % فانسل عن سكاره الممحوص ، % وانقض يهوي ، وهو كالوبيص % 6(@)(@@) % دانى جناحيه إلى نصيص ، % فاعتام منها كل ذي خميص % 7(@)(@@) % فقده بمخلب قبوص ، % فكم ذبحنا ثم من موقوص % % 8(@)(@@) % وكم لنا في البيت من مقصوص % معدة للشي والمصوص % PageV01P572 البحر : رجز تام 1(@)(@@) % أنعت كلبا جال في رباطه ، % جول مصاب فر من أسعاطه % 2(@)(@@) % عند طبيب خاف من سياطه ، % هجنا به ، وهاج من نشاطه % 3(@)(@@) % كالكوكب الدري في انخراطه ، % عند تهاوي الشد وانبساطه % 4(@)(@@) % يقمم القائد في حطاطه ، % وقده البيداء في اعتباطه % 5(@)(@@) % لما رأى العلهب في أقواطه ، % سابحه ، وقر في التباطه % 6(@)(@@) % كالبرق يذري المرو بالتقاطه ، % مثل قلي طار في أنفاطه % 7(@)(@@) % وانصاع يتلوه على قطاطه ، % أغضف لا ييأس من خلاطه % 8(@)(@@) % يصيد بعد البعد وانبساطه ، % إن لم يبت القلب في انتياطه % 9(@)(@@) % فلم يزل يأخذ في لطاطه ، % كالصقر ينقض على غطاطه % 10(@)(@@) % يقشر جلد الأرض من بلاطه ، % بأربع يقول في إفراطه % PageV01P573 11(@)(@@) % لشدة الجري ولاستحطاطه ، % ما إن تمس الأرض في أشواطه % 12(@)(@@) % قد خدشت رجلاه في آباطه ، % وخرم الأذنين بانتشاطه % 13(@)(@@) % خلج ذراعيه إلى ملاطه ، % ينقد عنه الضيق بانعطاطه % 14(@)(@@) % في هبوات الضيق أو رياطه ، % فأدرك الظبي ولم يباطه ! % 15(@)(@@) % ولف عشرين إلى أشراطه ، % فلم نزل نقرن في رباطه % 16(@)(@@) % ويخمط الشاؤون من خماطه ، % ويطبخ الطابخ من أسقاطه % 17(@)(@@) % حتى علا في الجو من شياطه % % PageV01P574 البحر : رجز تام 1(@)(@@) % أعددت كلبا للطراد سلطا ، % مقلدا قلائدا ومقطا % % 2(@)(@@) % فهو النجيب ، والحسيب رهطا ، % ترى له خطين خطا خطا % % 3(@)(@@) % و ملطا سهلا ، ولحيا سبطا ، % ذاك ومتنين إذا تمطى % % 4(@)(@@) % قلت شراكان أجيدا قطا ، % من أدم الطائف عطا عطا % % 6(@)(@@) % ينشط أذنيه بهن نشطا ، % تخال مأزمين منه شرطا % % 7(@)(@@) % ما إن يقعن الأرض ، إلا فرطا ، % كأنما يعجلن شيئا لقطا % % PageV01P575 البحر : هزج 