ms81	 بالطمع(@)(@)(@@)(@@)(@@) ||| 49(@)(@)(@@) @HAD04 إن للباقين بالماضين معتبرا(@)(@)(@@)(@@)(@@) ||| 50(@)(@)(@@) @HAD04 إن للآخر بالأول مزدجرا(@)(@)(@@)(@@)(@@) ||| 51(@)(@)(@@) @HAD08 إن كفر النعمة لؤم ومصاحبة الجاهل شؤم(@)(@)(@@)(@@)(@@) ||| 52(@)(@)(@@) @HAD08 إن الفقر مذلة للنفس مدهشة للعقل جالب للهموم(@)(@)(@@)(@@)(@@) ||| 53(@)(@)(@@) @HAD09 إن عمرك مهر سعادتك إن أنفذته فى طاعة ربك(@)(@)(@@)(@@)(@@) ||| 54(@)(@)(@@) @HAD010 إن أنفاسك أجزاء عمرك فلا تفنها إلا فى طاعة تزلفك(@)(@)(@@)(@@)(@@) ||| 55(@)(@)(@@) @HAD018 إن عمرك وقتك الذي أنت فيه ما فات مضى وما سيأتيك فأين قم فاغتنم الفرصة بين العدمين(@)(@)(@@)(@@)(@@) ||| 56(@)(@)(@@) @HAD012 إن الله سبحانه يجرى الأمور على ما يقتضيه لا على ما ترتضيه(@)(@)(@@)(@@)(@@) ||| 57(@)(@)(@@) @HAD08 إن للقلوب خواطر سوء والعقول تزجر منها(@)(@)(@@)(@@)(@@) ||| 58(@)(@)(@@) @HAD08 إن عمرك عدد أنفاسك وعليها رقيب يحصيها(@)(@)(@@)(@@)(@@) ||| 59(@)(@)(@@) @HAD06 إن ذهاب الذاهبين لعبرة للقوم المتخلفين(@)(@)(@@)(@@)(@@) ||| 60(@)(@)(@@) @HAD08 إن الله سبحانه ليبغض الوقح المتجرىء على المعاصي(@)(@)(@@)(@@)(@@) ||| 61(@)(@)(@@) @HAD09 إن الله سبحانه يحب كل سمح اليدين حريز الدين(@)(@)(@@)(@@)(@@) ||| 62(@)(@)(@@) @HAD07 إن الله سبحانه يحب المتعفف الحيي التقى(@)(@)PageV01P222(@)(@)(@@) @HAD01 الراضي(@)(@)(@@)(@@)(@@) ||| 63(@)(@)(@@) @HAD07 إن أفضل الإيمان إنصاف المرء من نفسه(@)(@)(@@)(@@)(@@) ||| 64(@)(@)(@@) @HAD06 إن أفضل الجهاد مجاهدة الرجل نفسه(@)(@)(@@)(@@)(@@) ||| 65(@)(@)(@@) @HAD010 إن من العدل أن تنصف فى الحكم وتجتنب الظلم(@)(@)(@@)(@@)(@@) ||| 66(@)(@)(@@) @HAD06 إن أفضل العلم السكينة والحلم(@)(@)(@@)(@@)(@@) ||| 67(@)(@)(@@) @HAD08 إن القبح فى الظلم بقدر الحسن فى العدل(@)(@)(@@)(@@)(@@) ||| 68(@)(@)(@@) @HAD08 إن الزهد فى الجهل بقدر الرغبة فى العقل(@)(@)(@@)(@@)(@@) ||| 69(@)(@)(@@) @HAD012 إن اليوم عمل ولا حساب وغدا حساب ولا عمل(@)(@)(@@)(@@)(@@) ||| 70(@)(@)(@@) @HAD010 إن جد الدنيا هزل وعزها ذل وعلوها سفل(@)(@)(@@)(@@)(@@) ||| 71(@)(@)(@@) @HAD015 إن الله سبحانه عند اضمار كل مضمر وقول كل قائل وعمل كل عامل(@)(@)(@@)(@@)(@@) ||| 72(@)(@)(@@) @HAD010 إن الزهد في ولاية الظالم بقدر الرغبة في ولاية العادل(@)(@)(@@)(@@)(@@) ||| 73(@)(@)(@@) @HAD07 إن هذه القلوب أوعية فخيرها أوعاها للخير(@)(@)(@@)(@@)(@@) ||| 74(@)(@)(@@) @HAD09 إن هذه الطبايع متباينة وخيرها أبعدها من الشر(@)(@)(@@)(@@)(@@) ||| 75(@)(@)(@@) @HAD015 إن ولي محمد (صلى الله عليه وآله) من أطاع الله وإن بعدت لحمته(@)(@)(@@)(@@)(@@) ||| 76(@)(@)(@@) @HAD010 إن عدو محمد (صلى الله عليه وآله) من عصى(@)(@)PageV01P223(@)(@)(@@) @HAD05 الله وان قربت قرابته(@)(@)(@@)(@@)(@@) ||| 77(@)(@)(@@) @HAD010 إن أولى الناس بالأنبياء (عليهم السلام) أعملهم بما جاؤا به(@)(@)(@@)(@@)(@@) ||| 78(@)(@)(@@) @HAD013 إن بشر المؤمن في وجهه وقوته في دينه وحزنه في قلبه(@)(@)(@@)(@@)(@@) ||| 79(@)(@)(@@) @HAD08 إن الله سبحانه ليبغض الطويل الأمل السيىء 
ms82	 العمل(@)(@)(@@)(@@)(@@) ||| 80(@)(@)(@@) @HAD035 وقال (عليه السلام) عند دفن رسول الله (صلى الله عليه وآله) إن الصبر لجميل إلا عنك وإن الجزع لقبيح إلا عليك وإن المصاب بك لجليل وانه قبلك وبعدك لجلل(@)(@)(@@)(@@)(@@) ||| 81(@)(@)(@@) @HAD09 إن من مشى على ظهر الأرض لصائر الى بطنها(@)(@)(@@)(@@)(@@) ||| 82(@)(@)(@@) @HAD07 إن الأمور إذا تشابهت اعتبر آخرها بأولها(@)(@)(@@)(@@)(@@) ||| 83(@)(@)(@@) @HAD08 إن الليل والنهار مسرعان فى هدم الأعمار(@)(@)(@@)(@@)(@@) ||| 84(@)(@)(@@) @HAD011 إن فى كل شيىء موعظة وعبرة لذوى اللب والإعتبار(@)(@)(@@)(@@)(@@) ||| 85(@)(@)(@@) @HAD010 إن ماضي يومك منتقل وباقية متهم فاغتنم وقتك بالعمل(@)(@)(@@)(@@)(@@) ||| 86(@)(@)(@@) @HAD010 إن ماضي عمرك أجل وآتيه أمل والوقت عمل(@)(@)(@@)(@@)(@@) ||| 87(@)(@)(@@) @HAD013 إن المؤمن ليستحيي إذا مضى له عمل فى غير ما عقد عليه إيمانه(@)(@)(@@)(@@)(@@) ||| 88(@)(@)(@@) @HAD014 إن العدل ميزان الله سبحانه الذي وضعه في الخلق ونصبه لإقامة الحق فلا(@)(@)PageV01P224(@)(@)(@@) @HAD08 تخالفه فى ميزانه ولا تعارضه فى سلطانه(@)(@)(@@)(@@)(@@) ||| 89(@)(@)(@@) @HAD09 إن مالك لحامدك فى حياتك ولذامك بعد وفاتك(@)(@)(@@)(@@)(@@) ||| 90(@)(@)(@@) @HAD011 إن التقوى عصمة لك فى حياتك وزلفى لك بعد مماتك(@)(@)(@@)(@@)(@@) ||| 91(@)(@)(@@) @HAD011 إن حلم الله تعالى على المعاصي جرأك وبهلكة نفسك أغراك(@)(@)(@@)(@@)(@@) ||| 92(@)(@)(@@) @HAD013 إن أمرا لا تعلم متى يفجأك ينبغي أن تستعد له قبل أن يغشاك(@)(@)(@@)(@@)(@@) ||| 93(@)(@)(@@) @HAD021 إن لله سبحانه عبادا يختصهم بالنعم لمنافع العباد يقرها في أيديهم ما بذلوها فإذا منعوها نزعها منهم وحولها إلى غيرهم(@)(@)(@@)(@@)(@@) ||| 94(@)(@)(@@) @HAD013 إن أحسن الزي ما خلطك بالناس وجملك بينهم وكف ألسنتهم عنك(@)(@)(@@)(@@)(@@) ||| 95(@)(@)(@@) @HAD09 إن المودة يعبر عنها اللسان وعن المحبة العيان(@)(@)(@@)(@@)(@@) ||| 96(@)(@)(@@) @HAD07 إن محل الإيمان الحنان وسبيله الأذنان(@)(@)(@@)(@@)(@@) ||| 97(@)(@)(@@) @HAD07 إن لأنفسكم أثمانا فلا تبيعوها إلا بالجنة(@)(@)(@@)(@@)(@@) ||| 98(@)(@)(@@) @HAD010 إن من باع نفسه بغير الجنة فقد عظمت عليه المحنة(@)(@)(@@)(@@)(@@) ||| 99(@)(@)(@@) @HAD012 إن بذوي العقول من الحاجة إلى الأدب كما يظمأ الزرع إلى المطر(@)(@)(@@)(@@)(@@) ||| 100(@)(@)(@@) @HAD010 إن الله تعالى يحب السهل النفس السمح الخليقة القريب الأمر(@)(@)PageV01P225(@)(@)(@@)(@@)(@@) ||| 101(@)(@)(@@) @HAD015 إن أفضل الناس من حلم عن قدرة وزهد عن عتبة وأنصف عن قوة(@)(@)(@@)(@@)(@@) ||| 102(@)(@)(@@) @HAD014 إن كرم الله سبحانه لا ينقض حكمته فلذلك لا يقع الإجابة في كل دعوة(@)(@)(@@)(@@)(@@) ||| 103(@)(@)(@@) @HAD012 إن للا إله إلا الله شروطا وإنى وذريتى من شروطها(@)(@)(@@)(@@)(@@) ||| 104(@)(@)(@@) @HAD024 إن 
ms83	 الدنيا دار خبال ووبال وزوال وانتقال لا تساوي لذاتها تنغيصها ولا يفي سعودها بنحوسها ولا يقوم صعودها بهبوطها(@)(@)(@@)(@@)(@@) ||| 105(@)(@)(@@) @HAD014 إن من فضل الرجل أن ينصف من نفسه ويحسن إلى من أساء إليه(@)(@)(@@)(@@)(@@) ||| 106(@)(@)(@@) @HAD034 وعزى (عليه السلام) قوما بميت فقال: إن هذا الأمر ليس بكم بدا ولا إليكم إنتهى وقد كان صاحبكم هذا يسافر فعدوه فى بعض سفراته فإن قدم عليكم وإلا قدمتم عليه(@)(@)(@@)(@@)(@@) ||| 107(@)(@)(@@) @HAD012 إن الله سبحانه قد وضع العقاب على معاصيه زيادة لعباده عن نقمته(@)(@)(@@)(@@)(@@) ||| 108(@)(@)(@@) @HAD012 إن من باع جنة المأوى بعاجلة الدنيا تعس جده وخسرت صفقته(@)(@)(@@)(@@)(@@) ||| 109(@)(@)(@@) @HAD013 إن طاعة النفس ومتابعة أهويتها أس كل محنة ورأس كل غواية(@)(@)(@@)(@@)(@@) ||| 110(@)(@)(@@) @HAD011 إن هذه النفوس طلعة إن تطيعوها تنزع بكم الى شر غاية(@)(@)PageV01P226(@)(@)(@@)(@@)(@@) ||| 111(@)(@)(@@) @HAD014 إن النفس أبعد شيىء منزعا وإنها لا تزال تنزع إلى معصية في هوى(@)(@)(@@)(@@)(@@) ||| 112(@)(@)(@@) @HAD010 إن مجاهدة النفس لتزمها عن المعاصي وتعصمها عن الردى(@)(@)(@@)(@@)(@@) ||| 113(@)(@)(@@) @HAD011 إن هذه النفس لأمارة بالسوء فمن أهملها جمحت به إلى المئاثم(@)(@)(@@)(@@)(@@) ||| 114(@)(@)(@@) @HAD011 إن نفسك لخدوع إن تثق بها يقتدك الشيطان إلى إرتكاب المحارم(@)(@)(@@)(@@)(@@) ||| 115(@)(@)(@@) @HAD021 إن النفس لأمارة بالسوء والفحشاء فمن ائتمنها خانته ومن استنام إليها أهلكته ومن رضي عنها أوردته شر الموارد(@)(@)(@@)(@@)(@@) ||| 116(@)(@)(@@) @HAD014 إن مقابلة الإسائة بالإحسان وتغمد الجرائم بالغفران لمن أحسن الفضائل وأفضل المحامد(@)(@)(@@)(@@)(@@) ||| 117(@)(@)(@@) @HAD019 إن المؤمن لا يمسي ولا يصبح إلا ونفسه ظنون عنده فلا يزال زاريا عليها ومستزيدا لها(@)(@)(@@)(@@)(@@) ||| 118(@)(@)(@@) @HAD011 إن النفس لجوهرة ثمينة من صانها رفعها ومن ابتذلها وضعها(@)(@)(@@)(@@)(@@) ||| 119(@)(@)(@@) @HAD09 إن الكف عند حيرة الضلال خير من ركوب الأهوال(@)(@)(@@)(@@)(@@) ||| 120(@)(@)(@@) @HAD016 إن قدر السؤال أكثر من قيمة النوال فلا تستكثروا ما أعطيتموه فإنه لن يوازي قدر السؤال(@)(@)(@@)(@@)(@@) ||| 121(@)(@)(@@) @HAD08 إن اليسير من الله سبحانه لأكرم من الكثير(@)(@)PageV01P227(@)(@)(@@) @HAD02 من خلقه(@)(@)(@@)(@@)(@@) ||| 122(@)(@)(@@) @HAD020 إن دعوة المظلوم مجابة عند الله سبحانه لأنه يطلب حقه والله تعالى أعدل من أن يمنع ذا حق حقه(@)(@)(@@)(@@)(@@) ||| 123(@)(@)(@@) @HAD010 إن غاية تنقصها اللحظة وتهدمها الساعة لحرية بقصر المدة(@)(@)(@@)(@@)(@@) ||| 124(@)(@)(@@) @HAD09 إن قادما يقدم بالفوز أو الشقوة لمستحق لأفضل العدة(@)(@)(@@)(@@)(@@) ||| 125(@)(@)(@@) @HAD010 إن 
ms84	 غائبا يحدوه الجديدان الليل والنهار لحري بسرعة الأوبة(@)(@)(@@)(@@)(@@) ||| 126(@)(@)(@@) @HAD014 إن المغبون من غبن عمره وإن المغبوط من أنفذ عمره فى طاعة ربه(@)(@)(@@)(@@)(@@) ||| 127(@)(@)(@@) @HAD014 إن غدا من اليوم قريب يذهب اليوم بما فيه ويأتي الغد لاحقا به(@)(@)(@@)(@@)(@@) ||| 128(@)(@)(@@) @HAD014 إن ما تقدم من خير يكن لك ذخره وما تؤخره يكن لغيرك خيره(@)(@)(@@)(@@)(@@) ||| 129(@)(@)(@@) @HAD024 إن للناس عيوبا فلا تكشف ما غاب عنك فإن الله سبحانه يحلم عليها واستر العورة ما استطعت يستر الله عليك ما تحب ستره(@)(@)(@@)(@@)(@@) ||| 130(@)(@)(@@) @HAD011 إن المرء على ما قدم قادم وعلى ما خلف نادم(@)(@)(@@)(@@)(@@) ||| 131(@)(@)(@@) @HAD012 إن عظيم الأجر مقارن عظيم البلاء فإذا أحب الله سبحانه قوما إبتلاهم(@)(@)(@@)(@@)(@@) ||| 132(@)(@)(@@) @HAD08 إن الغاية أمامكم وإن الساعة ورائكم تحدوكم(@)(@)PageV01P228(@)(@)(@@)(@@)(@@) ||| 133(@)(@)(@@) @HAD012 إن لكم نهاية فانتهوا إلى نهايتكم وإن لكم علما فانتهوا بعلمكم(@)(@)(@@)(@@)(@@) ||| 134(@)(@)(@@) @HAD010 إن الوفاء توأم الصدق وما أعرف جنة أوقى منه(@)(@)(@@)(@@)(@@) ||| 135(@)(@)(@@) @HAD013 إن بأهل المعروف من الحاجة الى اصطناعه أكثر مما بأهل الرغبة اليهم منه(@)(@)(@@)(@@)(@@) ||| 136(@)(@)(@@) @HAD017 إن لله سبحانه سطوات ونقمات فإذا نزلت بكم فادفعوها بالدعاء فإنه لا يدفع البلاء إلا الدعاء(@)(@)(@@)(@@)(@@) ||| 137(@)(@)(@@) @HAD014 إن كلام الحكيم اذا كان صوابا كان دواء واذا كان خطاء كان داء(@)(@)(@@)(@@)(@@) ||| 138(@)(@)(@@) @HAD014 إن أهل الجنة ليتراؤون منازل شيعتنا كما يترائى الرجل منكم الكواكب فى أفق السماء(@)(@)(@@)(@@)(@@) ||| 139(@)(@)(@@) @HAD08 إن أنصح الناس أنصحهم لنفسه وأطوعهم لربه(@)(@)(@@)(@@)(@@) ||| 140(@)(@)(@@) @HAD08 إن أغش الناس أغشهم لنفسه وأعصاهم لربه(@)(@)(@@)(@@)(@@) ||| 141(@)(@)(@@) @HAD012 إن الدنيا ماضية بكم على سنن وأنتم والآخرة فى قرن(@)(@)(@@)(@@)(@@) ||| 142(@)(@)(@@) @HAD013 إن الدنيا لمفسدة الدين مسلبة اليقين وانها لرأس الفتن وأصل المحن(@)(@)(@@)(@@)(@@) ||| 143(@)(@)(@@) @HAD010 إن الله سبحانه جعل الطاعة غنيمة الأكياس عند تفريط العجزة(@)(@)(@@)(@@)(@@) ||| 144(@)(@)(@@) @HAD09 إن النار لا ينقصها ما أخذ منها ولكن(@)(@)PageV01P229(@)(@)(@@) @HAD017 يخمدها أن لا تجد حطبا وكذلك العلم لا يفنيه الإقتباس لكن بخل الحاملين له سبب عدمه(@)(@)(@@)(@@)(@@) ||| 145(@)(@)(@@) @HAD018 إن الله سبحانه يعطى الدنيا من يحب ومن لا يحب ولا يعطى الدين إلا من يحب(@)(@)(@@)(@@)(@@) ||| 146(@)(@)(@@) @HAD016 إن الله سبحانه يمنح المال من يحب ويبغض ولا يمنح العلم إلا من أحب(@)(@)(@@)(@@)(@@) ||| 147(@)(@)(@@) @HAD012 إن الله تعالى لا 
ms85	 يعطي الدين إلا لخاصته وصفوته من خلقه(@)(@)(@@)(@@)(@@) ||| 148(@)(@)(@@) @HAD015 إن للإسلام غاية فانتهوا إلى غايته واخرجوا إلى الله مما افترض عليكم من حقوقه(@)(@)(@@)(@@)(@@) ||| 149(@)(@)(@@) @HAD011 إن تلخيص النية من الفساد أشد على العاملين من طول الإجتهاد(@)(@)(@@)(@@)(@@) ||| 150(@)(@)(@@) @HAD021 إن أمامك طريقا ذا مسافة بعيدة ومشقة شديدة ولا غنى بك عن حسن الإرتياد وقدر بلاغك من الزاد(@)(@)(@@)(@@)(@@) ||| 151(@)(@)(@@) @HAD013 إن النفس التي تطلب الرغائب الفانية لتهلك فى طلبها وتشقي في منقلبها(@)(@)(@@)(@@)(@@) ||| 152(@)(@)(@@) @HAD012 إن لله تعالى في السراء نعمة الإفضال وفي الضراء نعمة التطهير(@)(@)(@@)(@@)(@@) ||| 153(@)(@)(@@) @HAD014 إن النفس التي تجهد في اقتناء الرغائب الباقية لتدرك طلبها وتسعد في منقلبها(@)(@)(@@)(@@)(@@) ||| 154(@)(@)(@@) @HAD011 إن من أعطى من حرمه ووصل من قطعه وعفا(@)(@)PageV01P230(@)(@)(@@) @HAD09 عمن ظلمه كان له من الله سبحانهالظهير والنصير(@)(@)(@@)(@@)(@@) ||| 155(@)(@)(@@) @HAD013 إن مثل الدنيا والآخرة كرجل له إمرأتان إذا أرضى إحداهما أسخط الأخرى(@)(@)(@@)(@@)(@@) ||| 156(@)(@)(@@) @HAD023 إن من غرته الدنيا بمحال الآمال وخدعته بزور الأمانى أورثته كمها وألبسته عمى وقطعته عن الأخرى وأوردته موارد الردى(@)(@)(@@)(@@)(@@) ||| 157(@)(@)(@@) @HAD014 إن الله سبحانه أبى أن يجعل أرزاق عباده المؤمنين إلا من حيث لا يحتسبون(@)(@)(@@)(@@)(@@) ||| 158(@)(@)(@@) @HAD04 إن المؤمنين هينون لينون(@)(@)(@@)(@@)(@@) ||| 159(@)(@)(@@) @HAD03 إن المؤمنين محسنون(@)(@)(@@)(@@)(@@) ||| 160(@)(@)(@@) @HAD03 إن المؤمنين خائفون(@)(@)(@@)(@@)(@@) ||| 161(@)(@)(@@) @HAD011 إن سخاء النفس عما فى أيدي الناس لأفضل من سخاء البذل(@)(@)(@@)(@@)(@@) ||| 162(@)(@)(@@) @HAD020 إن الوعظ الذي لا يمجه سمع ولا يعدله نفع ما سكت عنه لسان القول ونطق به لسان الفعل(@)(@)(@@)(@@)(@@) ||| 163(@)(@)(@@) @HAD016 إن المسكين لرسول الله فمن أعطاه فقد أعطى الله ومن منعه فقد منع الله سبحانه(@)(@)(@@)(@@)(@@) ||| 164(@)(@)(@@) @HAD019 إن أفضل الدين الحب فى الله والبغض فى الله والأخذ فى الله والعطاء فى الله سبحانه(@)(@)(@@)(@@)(@@) ||| 165(@)(@)(@@) @HAD03 إن الدين لشجرة(@)(@)PageV01P231(@)(@)(@@) @HAD013 أصلها الإيمان بالله وثمرها الموالاة فى الله والمعاداة فى الله سبحانه(@)(@)(@@)(@@)(@@) ||| 166(@)(@)(@@) @HAD024 إن مكرمة صنعتها إلى أحد من الناس إنما أكرمت بها نفسك وزينت بها عرضك فلا تطلب من غيرك شكر ما صنعت إلى نفسك(@)(@)(@@)(@@)(@@) ||| 167(@)(@)(@@) @HAD016 إن من مكارم الأخلاق أن تصل من قطعك وتعطي من حرمك وتعفو عمن ظلمك(@)(@)(@@)(@@)(@@) ||| 168(@)(@)(@@) @HAD014 إن الله تعالى يدخل بحسن النية وصالح السريرة من يشاء 
ms86	 من عباده الجنة(@)(@)(@@)(@@)(@@) ||| : 169(@)(@)(@@) @HAD017 إن من رزقه الله عقلا قويما وعملا مستقيما فقد ظاهر لديه النعمة وأعظم عليه المنة(@)(@)(@@)(@@)(@@) ||| 170(@)(@)(@@) @HAD015 إن المجاهد نفسه على طاعة الله وعن معاصيه عند الله سبحانه بمنزلة بر شهيد(@)(@)(@@)(@@)(@@) ||| 171(@)(@)(@@) @HAD017 إن العاقل من عقله في إرشاد ومن رأيه فى إزدياد فلذلك رأيه سديد وفعله حميد(@)(@)(@@)(@@)(@@) ||| 172(@)(@)(@@) @HAD016 إن الجاهل من جهله فى إغواء ومن هواه فى إغراء فقوله سقيم وفعله ذميم(@)(@)(@@)(@@)(@@) ||| 173(@)(@)(@@) @HAD011 إن هذه القلوب تمل كما تمل الأبدان فابتغوا لها طرائف الحكم(@)(@)(@@)(@@)(@@) ||| 174(@)(@)(@@) @HAD08 إن أفضل الخير صدقة السر وبر الوالدين(@)(@)PageV01P232(@)(@)(@@) @HAD03 وصلة الرحم(@)(@)(@@)(@@)(@@) ||| 175(@)(@)(@@) @HAD013 إن المؤمن يرى يقينه في عمله وإن المنافق يرى شكه في عمله(@)(@)(@@)(@@)(@@) ||| 176(@)(@)(@@) @HAD013 إن أولياء الله تعالى كل مستقرب أجله مكذب أمله كثير عمله قليل زلله(@)(@)(@@)(@@)(@@) ||| 177(@)(@)(@@) @HAD022 إن أمرنا صعب مستصعب لا يحتمله إلا عبد إمتحن الله قلبه للايمان ولا يعي حديثنا إلا صدور أمينة وأحلام رزينة(@)(@)(@@)(@@)(@@) ||| 178(@)(@)(@@) @HAD033 إن الله تعالى أطلع على الأرض فاختارنا واختار لنا شيعة ينصروننا ويفرحون لفرحنا ويحزنون لحزننا ويبذلون أنفسهم وأموالهم فينا فاؤلئك منا وإلينا وهم معنا في الجنة(@)(@)(@@)(@@)(@@) ||| 179(@)(@)(@@) @HAD024 إن أمرنا صعب مستصعب خشن مخشوشن سر مستسر مقنع لا يحتمله إلا ملك مقرب أو نبى مرسل أو مؤمن إمتحن الله سبحانه قلبه للإيمان(@)(@)(@@)(@@)(@@) ||| 180(@)(@)(@@) @HAD018 إن مع كل إنسان ملكين يحفظانه فإذا جاء أجله خليا بينه وبينه وإن الأجل لجنة حصينه(@)(@)(@@)(@@)(@@) ||| 181(@)(@)(@@) @HAD015 إن فضل القول على الفعل لهجنة وإن فضل الفعل على القول لجمال وزينة(@)(@)(@@)(@@)(@@) ||| 182(@)(@)(@@) @HAD019 إن الزاهدين فى الدنيا لتبكي قلوبهم وان ضحكوا ويشتد حزنهم وان فرحوا ويكثر مقتهم أنفسهم(@)(@)PageV01P233(@)(@)(@@) @HAD05 وان اغتبطوا بما أوتوا(@)(@)(@@)(@@)(@@) ||| 183(@)(@)(@@) @HAD019 إن الأكياس هم الذين للدنيا مقتوا وأعينهم عن زهرتها أغمضوا وقلوبهم عنها صرفوا وبالدار الباقية تولهوا(@)(@)(@@)(@@)(@@) ||| 184(@)(@)(@@) @HAD010 إن العاقل يتعظ بالأدب والبهائم لا يتعظ إلا بالضرب(@)(@)(@@)(@@)(@@) ||| 185(@)(@)(@@) @HAD019 إن لله سبحانه ملك ينادى فى كل يوم يا أهل الدنيا لدوا للموت وابنوا للخراب واجمعوا للذهاب(@)(@)(@@)(@@)(@@) ||| 186(@)(@)(@@) @HAD08 إن السعداء بالدنيا غدا هم الهاربون منها اليوم(@)(@)(@@)(@@)(@@) ||| 187(@)(@)(@@) @HAD013 إن الله سبحانه أمر بالعدل والإحسان ونهى 
ms87	 عن الفحشاء والظلم(@)(@)(@@)(@@)(@@) ||| 188(@)(@)(@@) @HAD021 إن الله سبحانه فرض في أموال الأغنياء أقوات الفقراء فما جاع فقير إلا بما منع غنى والله سائلهم عن ذلك(@)(@)(@@)(@@)(@@) ||| 189(@)(@)(@@) @HAD017 إن المرء يشرف على أمله فيقطعه حضور أجله فسبحان الله لا أمل يدرك ولا مؤمل يترك(@)(@)(@@)(@@)(@@) ||| 190(@)(@)(@@) @HAD012 وسمع (عليه السلام) رجلا يقول إنا لله وإنا إليه راجعون @HAD@ فقال إن قولنا إنا لله إقرار على أنفسنا بالملك وقولنا إليه راجعون إقرار على أنفسنا بالهلك(@)(@)(@@)(@@)(@@) ||| 191(@)(@)(@@) @HAD027 إن المرء إذا هلك قال الناس ما ترك وقالت الملائكة ما قدم لله آبائكم فقدموا بعضا يكن لكم ذخرا ولا تخلفوا كلا فيكون عليكم كلا(@)(@)PageV01P234(@)(@)(@@)(@@)(@@) ||| 192(@)(@)(@@) @HAD027 إن الحازم من شغل نفسه بجهاد نفسه فأصلحها وحبسها عن أهويتها ولذاتها فملكها وان للعاقل بنفسه عن الدنيا وما فيها وأهلها شغلا(@)(@)(@@)(@@)(@@) ||| 193(@)(@)(@@) @HAD025 إن الناظر بالقلب العامل بالبصر يكون مبتدء عمله أن ينظر عمله عليه أم له فإن كان له مضى فيه وان كان عليه وقف عنه(@)(@)(@@)(@@)(@@) ||| 194(@)(@)(@@) @HAD023 إن العاقل من نظر في يومه لغده وسعى في فكاك نفسه وعمل لما لا بد له ولا محيص له عنه(@)(@)(@@)(@@)(@@) ||| 195(@)(@)(@@) @HAD017 إن أولياء الله تعالى لأكثر الناس له ذكرا وأدومهم له شكرا وأعظمهم على بلائه صبرا(@)(@)(@@)(@@)(@@) ||| 196(@)(@)(@@) @HAD013 إن خير المال ما أكسب ثناء وشكرا وأوجب ثوابا وأجرا(@)(@)(@@)(@@)(@@) ||| 197(@)(@)(@@) @HAD021 إن الله سبحانه جعل الذكر جلاء القلوب تبصر به بعد العشوة وتسمع به بعد الوقرة وتنقاد به بعد المعاندة(@)(@)(@@)(@@)(@@) ||| 198(@)(@)(@@) @HAD013 إن الحازم من قيد نفسه بالمحاسبة ووملكها بالمبالغة وقتلها بالمجاهدة(@)(@)(@@)(@@)(@@) ||| 199(@)(@)(@@) @HAD024 إن للذكر أهلا أخذوه من الدنيا بدلا فلم تشغلهم تجارة ولا بيع عنه يقطعون به أيام الحياة ويهتفون به في آذان الغافلين(@)(@)(@@)(@@)(@@) ||| 200(@)(@)(@@) @HAD021 إن من رأى عدوانا يعمل به ومنكرا يدعى إليه فأنكره بقلبه فقد سلم وبرىء ومن أنكره بلسانه فقد(@)(@)PageV01P235(@)(@)(@@) @HAD032 أوجر وهو أفضل من صاحبه ومن أنكره بسيفه لتكون حجة الله العليا وكلمة الظالمين السفلى فذلك الذي أصاب سبيل الهدى وقام على الطريق ونور في قلبه اليقين(@)(@)(@@)(@@)(@@) ||| 201(@)(@)(@@) @HAD027 إن من أحب العباد الى الله سبحانه عبدا أعانه 
ms88	 على نفسه فاستشعر الحزن وتجلبب الخوف فزهر مصباح الهدى في قلبه وأعد القرى ليومه النازل به(@)(@)(@@)(@@)(@@) ||| 202(@)(@)(@@) @HAD020 إن القرآن ظاهره أنيق وباطنه عميق لا تفنى عجائبه ولا تنقضى غرائبه ولا تكشف الظلمات إلا به(@)(@)(@@)(@@)(@@) ||| 203(@)(@)(@@) @HAD016 إن أفضل الناس عند الله من أحيا عقله وأمات شهوته وأتعب نفسه لصلاح آخرته(@)(@)(@@)(@@)(@@) ||| 204(@)(@)(@@) @HAD020 إن لله تعالى في كل نعمة حقا من الشكر فمن أداه زاده منها ومن قصر عنه خاطر بزوال نعمته(@)(@)(@@)(@@)(@@) ||| 205(@)(@)(@@) @HAD022 إن من كان مطيته الليل والنهار فإنه يسار به وان كان واقفا ويقطع المسافة وان كان مقيما وادعا(@)(@)(@@)(@@)(@@) ||| 206(@)(@)(@@) @HAD012 إن الكيس من كان لشهوته مانعا ولنزوته عند الحفيظة واقما قامعا(@)(@)(@@)(@@)(@@) ||| 207(@)(@)(@@) @HAD015 إن الله سبحانه قد أنار سبيل الحق وأوضح طرقه فشقوة لازمة أو سعادة دائمة(@)(@)(@@)(@@)(@@) ||| 208(@)(@)(@@) @HAD018 إن من بذل نفسه في طاعة الله سبحانه ورسوله كانت نفسه ناجية سالمة وصفقته رابحة غانمة(@)(@)(@@)(@@)(@@) ||| 209(@)(@)(@@) @HAD03 إن في الفرار(@)(@)PageV01P236(@)(@)(@@) @HAD019 موجدة الله سبحانه والذل اللازم الدائم وإن الفار غير مزيد فى عمره ولا مؤخر عن يومه(@)(@)(@@)(@@)(@@) ||| 210(@)(@)(@@) @HAD036 إن المرء قد يسره درك ما لم يكن ليفوته ويسوئه فوت ما لم يكن ليدركه فليكن سرورك بما نلت من آخرتك وليكن أسفك على ما فاتك منها وليكن همك فيها لما بعد الموت(@)(@)(@@)(@@)(@@) ||| 211(@)(@)(@@) @HAD021 إن الله سبحانه إذا أراد بعبد خيرا وفقه لإنفاد أجله في أحسن عمله ورزقه مبادرة مهله في طاعته قبل الفوت(@)(@)(@@)(@@)(@@) ||| 212(@)(@)(@@) @HAD027 إن أمامك عقبة كئودا المخفف فيها أحسن حالا من المثقل والمبطىء عليها أقبح أمرا من المسرع وإن مهبطها بك لا محالة إلى جنة أو نار(@)(@)(@@)(@@)(@@) ||| 213(@)(@)(@@) @HAD026 إن أعظم الناس حسرة يوم القيمة رجل إكتسب مالا من غير طاعة الله فورثه رجلا أنفقه في طاعة الله فدخل به الجنة ودخل الأول النار(@)(@)(@@)(@@)(@@) ||| 214(@)(@)(@@) @HAD011 إن الناس الى صالح الأدب أحوج منهم إلى الفضة والذهب(@)(@)(@@)(@@)(@@) ||| 215(@)(@)(@@) @HAD018 إن هذا القرآن هو الناصح الذي لا يغش والهادي الذي لا يضل والمحدث الذي لا يكذب(@)(@)(@@)(@@)(@@) ||| 216(@)(@)(@@) @HAD013 إن هذا الموت لطالب حثيث لا يفوته المقيم ولا يعجزه من هرب 
ms89	(@)(@)(@@)(@@)(@@) ||| 217(@)(@)(@@) @HAD03 إن في الموت(@)(@)PageV01P237(@)(@)(@@) @HAD019 لراحة لمن كان عبد شهوته وأسير أهويته لأنه كلما طالت حياته كثرت سيئاته وعظمت على نفسه جناياته(@)(@)(@@)(@@)(@@) ||| 218(@)(@)(@@) @HAD028 إن أخسر الناس صفقة وأخيبهم سعيا رجل أخلق بدنه في طلب آماله ولم تساعده المقادير على إرادته فخرج من الدنيا بحسراته وقدم على الآخرة بتبعاته(@)(@)(@@)(@@)(@@) ||| 219(@)(@)(@@) @HAD021 إن للمحن غايات لابد من إنقضائها فناموا إليها أو لها إلى حين انقضائها فإن إعمال الحيلة فيها قبل ذلك زيادة لها(@)(@)(@@)(@@)(@@) ||| 220(@)(@)(@@) @HAD017 إن للمحن غايات وللغايات نهايات لها فاصبروا حتى تبلغ نهاياتها فالتحرك لها قبل إنقضائها زيادة لها(@)(@)(@@)(@@)(@@) ||| 221(@)(@)(@@) @HAD030 إن الله سبحانه فرض عليكم فرائض فلا تضيعوها وحد لكم حدودا فلا تعتدوها ونهاكم عن إشياء فلا تنتهكوها وسكت عن أشياء ولم يدعها نسيانا فلا تتكلفوها(@)(@)(@@)(@@)(@@) ||| 222(@)(@)(@@) @HAD015 إن الفرص تمر مر السحاب فانتهزوها إذا أمكنت فى أبواب الخير وإلا عادت ندما(@)(@)(@@)(@@)(@@) ||| 223(@)(@)(@@) @HAD014 إن حوائج الناس إليكم نعمة من الله عليكم فاغتنموها ولا تملوها فتتحول نقما(@)(@)(@@)(@@)(@@) ||| 224(@)(@)(@@) @HAD013 إن خير المال ما أورثك ذخرا وذكرا وأكسبك حمدا وأجرا(@)(@)(@@)(@@)(@@) ||| 225(@)(@)(@@) @HAD07 إن أفضل الأعمال ما استرق به حر(@)(@)PageV01P238(@)(@)(@@) @HAD03 استحق به أجر(@)(@)(@@)(@@)(@@) ||| 226(@)(@)(@@) @HAD027 إن مادحك لخادع لعقلك غاش لك في نفسك بكاذب الإطراء وزور الثناء فإن حرمته نوالك أو منعته إفضالك وسمك بكل فضيحة ونسبك إلى كل قبيحة(@)(@)(@@)(@@)(@@) ||| 227(@)(@)(@@) @HAD018 إن النفس حمضة والأذن مجاجة فلا تجب فهمك بالإلحاح على قلبك فإن لكل عضو من البدن إستراحة(@)(@)(@@)(@@)(@@) ||| 228(@)(@)(@@) @HAD023 إن قوما عبدوا الله سبحانه رغبة فتلك عبادة التجار وقوما عبدوه رهبة فتلك عبادة العبيد وقوما عبدوه شكرا فتلك عبادة الأحرار(@)(@)(@@)(@@)(@@) ||| 229(@)(@)(@@) @HAD014 إن الحياء والعفة من خلائق الإيمان وانهما لسجية الأحرار وشيمة الأبرار(@)(@)(@@)(@@)(@@) ||| 230(@)(@)(@@) @HAD019 إن من أبغض الخلائق إلى الله تعالى رجلا وكله الله إلى نفسه جائرا عن قصد السبيل سائرا بغير دليل(@)(@)(@@)(@@)(@@) ||| 231(@)(@)(@@) @HAD039 إن من كانت العاجلة أملك به من الآجلة وأمور الدنيا أغلب عليه من أمور الآخرة فقد باع الباقي بالفاني وتعوض البائد عن الخالد وأهلك نفسه ورضي لها بالحائل الزائل ونكب بها عن نهج السبيل(@)(@)(@@)(@@)(@@) ||| 232(@)(@)(@@) @HAD023 إن أول 
ms90	 ما تغلبون عليه من الجهاد جهاد بأيديكم ثم بألسنتكم ثم بقلوبكم فمن لم يعرف بقلبه معروفا ولم ينكر منكرا قلب(@)(@)PageV01P239(@)(@)(@@) @HAD03 فجعل أعلاه أسفله(@)(@)(@@)(@@)(@@) ||| 233(@)(@)(@@) @HAD016 إن الموت لهادم لذاتكم ومباعد طلباتكم ومفرق جماعاتكم قد أعلقتكم حبائله وأقصدتكم مقاتله(@)(@)(@@)(@@)(@@) ||| 234(@)(@)(@@) @HAD018 إن الله تعالى أوصاكم بالتقوى وجعلها رضاه من خلقه فاتقوا الله الذى أنتم بعينه ونواصيكم بيده(@)(@)(@@)(@@)(@@) ||| 235(@)(@)(@@) @HAD023 إن العاقل ينبغي أن يحذر الموت في هذه الدار ويحسن له التأهب قبل أن يصل إلى دار يتمنى فيها الموت فلا يجده(@)(@)(@@)(@@)(@@) ||| 236(@)(@)(@@) @HAD022 إن تقوى الله حمت أوليائه محارمه وألزمت قلوبهم مخافته حتى أسهرت لياليهم واظمأت هواجرهم فأخذوا الراحة بالتعب والري بالظمأ(@)(@)(@@)(@@)(@@) ||| 237(@)(@)(@@) @HAD015 إن للموت لغمرات هي أفظع من أن تستغرق بصفة أو تعتدل على عقول أهل الدنيا(@)(@)(@@)(@@)(@@) ||| 238(@)(@)(@@) @HAD09 إن الموت لمعقود بنواصيكم والدنيا تطوى من خلفكم(@)(@)(@@)(@@)(@@) ||| 239(@)(@)(@@) @HAD019 إن المتقين ذهبوا بعاجل الدنيا والآخرة شاركوا أهل الدنيا في دنياهم ولم يشاركهم أهل الدنيا في آخرتهم(@)(@)(@@)(@@)(@@) ||| 240(@)(@)(@@) @HAD026 إن تقوى الله سبحانه هي الزاد والمعاد زاد مبلغ ومعاد منجح دعا إليها أسمع داع ووعاها خير واع فاسمع داعيها وفاز واعيها(@)(@)(@@)(@@)(@@) ||| 241(@)(@)(@@) @HAD012 إن التقوى حق الله سبحانه عليكم والموجبة على الله حقكم فاستعينوا(@)(@)PageV01P240(@)(@)(@@) @HAD07 بالله عليها وتوسلوا إلى الله بها(@)(@)(@@)(@@)(@@) ||| 242(@)(@)(@@) @HAD030 إن تقوى الله لم تزل عارضة نفسها على الأمم الماضين والغابرين لحاجتهم إليها غدا إذا أعاد الله ما أبدأ وأخذ ما أعطى فما أقل من حملها حق حملها(@)(@)(@@)(@@)(@@) ||| 243(@)(@)(@@) @HAD010 إن لتقوى الله حبلا وثيقا عروته ومعقلا منيعا ذروته(@)(@)(@@)(@@)(@@) ||| 244(@)(@)(@@) @HAD021 إن التقوى منتهى رضا الله من عباده وحاجته من خلقه فاتقوا الله الذي ان أسررتم علمه وان أعلنتم كتبه(@)(@)(@@)(@@)(@@) ||| 245(@)(@)(@@) @HAD022 إن التقوى دار حصن عزيز لمن لجأ إليه والفجور دار حصن ذليل لا يحرز أهله ولا يمنع من لجأ إليه(@)(@)(@@)(@@)(@@) ||| 246(@)(@)(@@) @HAD018 إن التقوى في اليوم الحرز والجنة وفي غد الطريق إلى الجنة مسلكها واضح وسالكها رابح(@)(@)(@@)(@@)(@@) ||| 247(@)(@)(@@) @HAD015 إن تقوى الله عمارة الدين وعماد اليقين وإنها لمفتاح صلاح ومصباح نجاح(@)(@)(@@)(@@)(@@) ||| 248(@)(@)(@@) @HAD015 إن من صرحت له العبر عما بين يديه من 
ms91	 المثلات حجزه التقوى عن تقحم الشبهات(@)(@)(@@)(@@)(@@) ||| 249(@)(@)(@@) @HAD017 إن من فارق التقوى أغرى باللذات والشهوات ووقع فى تيه السيئات ولزمه كثير التبعات(@)(@)(@@)(@@)(@@) ||| 250(@)(@)(@@) @HAD03 إن تقوى الله(@)(@)PageV01P241(@)(@)(@@) @HAD024 مفتاح سداد وذخيرة معاد وعتق من كل ملكة ونجاة من كل هلكة بها ينجو الهارب وتنج المطالب وتنال الرغائب(@)(@)(@@)(@@)(@@) ||| 251(@)(@)(@@) @HAD013 إن الدهر لخصم غير مخصوم ومحتكم غير ظلوم ومحارب غير محروب(@)(@)(@@)(@@)(@@) ||| 252(@)(@)(@@) @HAD012 إن الموت لزائر غير محبوب واتر غير مطلوب وقرن غير مغلوب(@)(@)(@@)(@@)(@@) ||| 253(@)(@)(@@) @HAD016 إن اكرم الموت القتل والذي نفسي بيده لألف ضربة بالسيف أهون من ميتة على الفراش(@)(@)(@@)(@@)(@@) ||| 254(@)(@)(@@) @HAD036 إن الغاية القيمة وكفى بذلك واعظا لمن عقل ومعتبرا لمن جهل وبعد ذلك ما تعلمون من هول المطلع وروعات الفزع واستكاك الأسماع واختلاف الأضلاع وضيق الأرماس وشدة الإبلاس(@)(@)(@@)(@@)(@@) ||| 255(@)(@)(@@) @HAD019 إن للقلوب شهوة وكراهة وإقبالا وإدبارا فأتوها من إقبالها وشهوتها فإن القلب إذا أكره عمى(@)(@)(@@)(@@)(@@) ||| 256(@)(@)(@@) @HAD015 إن العلم يهدى ويرشد وينجي وإن الجهل يغوي ويضل ويردي(@)(@)(@@)(@@)(@@) ||| 257(@)(@)(@@) @HAD017 إن للقلوب إقبالا وإدبارا فإذا أقبلت فاحملوها على النوافل وإذا أدبرت فاقتصروا بها على الفرائض(@)(@)(@@)(@@)(@@) ||| 258(@)(@)(@@) @HAD017 إن السلطان لأمين الله في الأرض ومقيم العدل في البلاد والعباد ووزعته في الأرض(@)(@)(@@)(@@)(@@) ||| 259(@)(@)(@@) @HAD03 إن أبصار هذه(@)(@)PageV01P242(@)(@)(@@) @HAD018 الفحول طوامح وهي سبب هبابها فإذا نظر أحدكم إلى إمرأة فأعجبته فليمس أهله فإنها هى امرأة بامرأة(@)(@)(@@)(@@)(@@) ||| 260(@)(@)(@@) @HAD010 إن أحسن الناس عيشا من حسن عيش الناس في عيشه(@)(@)(@@)(@@)(@@) ||| 261(@)(@)(@@) @HAD020 إن إحسانك إلى من كادك من الأضداد والحساد لأغيظ عليهم من مواقع إسائتك منهم وهو داع إلى صلاحهم(@)(@)(@@)(@@)(@@) ||| 262(@)(@)(@@) @HAD08 إن رأيك لا يتسع لكل شييء ففرغه للمهم(@)(@)(@@)(@@)(@@) ||| 263(@)(@)(@@) @HAD010 إن مالك لا يغني جميع الناس فاخصص به أهل الحق(@)(@)(@@)(@@)(@@) ||| 264(@)(@)(@@) @HAD010 إن كرامتك لا تتسع لجميع الناس فتوخ بها أفاضل الخلق(@)(@)(@@)(@@)(@@) ||| 265(@)(@)(@@) @HAD013 إن ليلك ونهارك لا يستوعبان لجميع حاجاتك فاقسمها بين عملك وراحتك(@)(@)(@@)(@@)(@@) ||| 266(@)(@)(@@) @HAD011 إن أوقاتك أجزاء عمرك فلا تنفد لك وقتا إلا فيما ينجيك(@)(@)(@@)(@@)(@@) ||| 267(@)(@)(@@) @HAD011 إن نفسك مطيتك إن أجهدتها قتلتها وان رفقت بها أبقيتها(@)(@)(@@)(@@)(@@) ||| 268(@)(@)(@@) @HAD013 إنك إن أخللت بشيىء من هذا التقسيم فلا تقوم نوافل تكتسبها 
ms92	 بفرائض تضيعها(@)(@)(@@)(@@)(@@) ||| 269(@)(@)(@@) @HAD021 إن أخاك حقا من غفر زلتك وسد خلتك وقبل عذرك وستر عورتك ونفى وجلك وحقق أملك(@)(@)PageV01P243(@)(@)(@@)(@@)(@@) ||| 270(@)(@)(@@) @HAD057 إن الذي في يديك قد كان له أهل قبلك وهو صائر إلى من بعدك وانما أنت جامع لأحد رجلين إما رجل عمل فيما جمعت بطاعة الله فسعد بما شقيت به أو رجل عمل فيما جمعت بمعصية الله فشقي بما جمعت وليس أحد هذين أهلا أن تؤثره على نفسك ولا تحمل له على ظهرك(@)(@)(@@)(@@)(@@) ||| 271(@)(@)(@@) @HAD012 إن العبد بين نعمة وذنب لا يصلحها إلا الإستغفار والشكر(@)(@)(@@)(@@)(@@) ||| 272(@)(@)(@@) @HAD030 إن الأمر بالمعروف والنهي عن المنكر لا يقربان من أجل ولا ينقصان من رزق لكن يضاعفان الثواب ويعظمان الأجر وأفضل منهما كلمة عدل عند إمام جائر(@)(@)(@@)(@@)(@@) ||| 273(@)(@)(@@) @HAD059 إن الله سبحانه أمر عباده تخييرا ونهاهم تحذيرا وكلف يسيرا ولم يكلف عسيرا وأعطى على القليل كثيرا ولم يعص مغلوبا ولم يطع مكرها ولم يرسل الأنبياء لعبا ولم ينزل الكتاب عبثا وما خلق السماوات والأرض وما بينهما باطلا ذلك ظن الذين كفروا فويل للذين كفروا من عذاب النار(@)(@)(@@)(@@)(@@) ||| 274(@)(@)(@@) @HAD029 إن العهود قلائد في الأعناق إلى يوم القيمة فمن وصلها وصله الله فمن نقضها خذله الله ومن إستخف بها خاصمته إلى الذي أكدها وأخذ خلقه بحفظها(@)(@)(@@)(@@)(@@) ||| 275(@)(@)(@@) @HAD011 إن صلة الأرحام لمن موجبات الإسلام وإن الله سبحانه أمر(@)(@)PageV01P244(@)(@)(@@) @HAD015 باكرامها وإنه تعالى يصل من وصلها ويقطع من قطعها ويكرم من أكرمها(@)(@)(@@)(@@)(@@) ||| 276(@)(@)(@@) @HAD030 إن أكرم الناس من اقتنى اليأس ولزم القنوع والورع وبرىء من الحرص والطمع فإن الطمع والحرص الفقر الحاضر وإن اليأس والقناعة الغنى الظاهر(@)(@)(@@)(@@)(@@) ||| 277(@)(@)(@@) @HAD023 إن المجاهد نفسه والمغالب غضبه والمحافظ على طاعة ربه يرفع الله سبحانه له ثواب الصائم القائم وينيله درجة المرابط الصابر(@)(@)(@@)(@@)(@@) ||| 278(@)(@)(@@) @HAD016 إن أفضل ما استجلب الثناء والسخاء وإن أجزل ما استدرت به الأرباح الباقية الصدقة(@)(@)(@@)(@@)(@@) ||| 279(@)(@)(@@) @HAD029 إن من شغل نفسه بالمفروض عليه عن المضمون له ورضي بالمقدور عليه وله كان أكثر الناس سلامة في عافية وربحا في غبطة وغنيمة في مسرة(@)(@)(@@)(@@)(@@) ||| 280(@)(@)(@@) @HAD065 إن الله تعالى 
ms93	 لم يجعل للعبد وإن اشتدت حيلته وعظمت طلبته وقويت مكيدته اكثر مما سمي له في الذكر الحكيم ولم يحل بين العبد في ضعفه وقلة حيلته أن يبلغ دون ما سمي له في الذكر الحكيم وان العارف لهذا العامل به أعظم الناس راحة في منفعة وان التارك له والشاك فيه لأعظم الناس شغلا في مضرة(@)(@)(@@)(@@)(@@) ||| 281(@)(@)(@@) @HAD015 إن ههنا- وأشار بيده إلى صدره- لعلما جما لو أصبت له حملة بلى أصيب(@)(@)PageV01P245(@)(@)(@@) @HAD035 لقنا غير مأمون عليه مستعملا آلة الدين للدنيا أو مستظهرا بنعم الله على عباده وبحججه على أوليائه أو منقادا لحملة الحق لا بصيرة له في أحنائه ينقدح الشك في قلبه لأول عارض من شبهة(@)(@)(@@)(@@)(@@) ||| 282(@)(@)(@@) @HAD015 إن الدنيا دار عناء وفناء وغير وعبر ومحل فتنة ومحنة(@)(@)(@@)(@@)(@@) ||| 283(@)(@)(@@) @HAD015 إن الدنيا قد أدبرت وآذنت بوداع وان الآخرة قد أقبلت وأشرفت باطلاع(@)(@)(@@)(@@)(@@) ||| 284(@)(@)(@@) @HAD015 إن الدنيا دار فجايع من عوجل فيها فجع بنفسه ومن أمهل فيها فجع بأحبته(@)(@)(@@)(@@)(@@) ||| 285(@)(@)(@@) @HAD037 إن الدنيا معكوسة منكوسة لذاتها تنغيص ومواهبها تغصيص وعيشها عناء وبقائها فناء تجمح بطالبها وتردي راكبها وتخون الواثق بها وتزعج المطمئن إليها وان جمعها الى انصداع ووصلها إلى انقطاع(@)(@)(@@)(@@)(@@) ||| 286(@)(@)(@@) @HAD018 إن من هوان الدنيا على الله أن لا يعصى إلا فيها ولا ينال ما عنده إلا بتركها(@)(@)(@@)(@@)(@@) ||| 287(@)(@)(@@) @HAD025 إن الدنيا كالحية لين مسها قاتل سمها فأعرض عما يعجبك فيها لقلة ما يصحبك منها وكن آنس ما تكون بها أحذر ما تكون منها(@)(@)(@@)(@@)(@@) ||| 288(@)(@)(@@) @HAD021 إن دنياكم هذه لأهون في عيني من عراق خنزير في يد مجذوم وأحقر من ورقة في فم جراد ما لعلي(@)(@)PageV01P246(@)(@)(@@) @HAD07 ونعيم يفنى ولذة لا تبقى(@)(@)(@@)(@@)(@@) ||| 289(@)(@)(@@) @HAD016 إن الدنيا كالغول تغوي من أطاعها وتهلك من أجابها وإنها لسريعة الزوال وشيكة الإنتقال(@)(@)(@@)(@@)(@@) ||| 290(@)(@)(@@) @HAD017 إن الدنيا تقبل إقبال الطالب وتدبر إدبار الهارب وتصل مواصلة الملول وتفارق مفارقة العجول(@)(@)(@@)(@@)(@@) ||| 291(@)(@)(@@) @HAD024 إن الدنيا منزل قلعة وليست بدار نجعة خيرها زهيد وشرها عتيد وملكها يسلب وعامرها يخرب (النجعة طلب الكلاء في مواضعه)(@)(@)(@@)(@@)(@@) ||| 292(@)(@)(@@) @HAD047 إن الدنيا لهي الكنود العنود والصدود الجحود والحيود الميود 
ms94	 حالها إنتقال وسكونها زلزال وعزها ذل وجدها هزل وكثرتها قل وعلوها سفل أهلها على ساق وسياق ولحاق وفراق وهي دار حرب وسلب ونهب وعطب(@)(@)(@@)(@@)(@@) ||| 293(@)(@)(@@) @HAD016 إن الدنيا غرور حائل وظل زائل وسناد مائل تصل العطية بالرزية والأمنية بالمنية(@)(@)(@@)(@@)(@@) ||| 294(@)(@)(@@) @HAD019 إن الدنيا عيشها قصير وخيرها يسير وإقبالها خديعة وإدبارها فجيعة ولذاتها فانية وتبعاتها باقية(@)(@)(@@)(@@)(@@) ||| 295(@)(@)(@@) @HAD024 إن الدنيا دار أولها عناء وآخرها فناء في حلالها حساب وفي حرامها عقاب من استغنى فيها فتن ومن افتقر فيها حزن(@)(@)(@@)(@@)(@@) ||| 296(@)(@)(@@) @HAD012 إن الدنيا دار شخوص ومحلة تنغيص ساكنها ظاعن وقاطنها بائن(@)(@)PageV01P247(@)(@)(@@) @HAD042 وبرقها خالب ونطقها كاذب وأموالها محروبة وأعلاقها مسلوبة ألا وهى المتصدية العتون والجامحة الحرون والمانية الخؤون (الخلب السحاب الذي لا مطر فيه فكأنه يخدع ويقال لمن يعد ولا ينجز إنما أنت كبرق خلب)(@)(@)(@@)(@@)(@@) ||| 297(@)(@)(@@) @HAD025 إن الدنيا دار محن ومحل فتن من ساعاها فاتته ومن قعد عنها واتته ومن أبصر إليها عمته ومن أبصر بها بصرته(@)(@)(@@)(@@)(@@) ||| 298(@)(@)(@@) @HAD028 إن الدنيا تدني الآجال وتباعد الآمال وتبيد الرجال وتغير الأحوال من غالبها غلبته ومن صارعها صرعته ومن عصاها أطاعته ومن تركها أتته(@)(@)(@@)(@@)(@@) ||| 299(@)(@)(@@) @HAD023 إن الدنيا تخلق الأبدان وتجدد الآمال وتقرب المنية وتباعد الأمنية كلما اطمئن صاحبها منها إلى سرور أشخصته منها إلى محذور(@)(@)(@@)(@@)(@@) ||| 300(@)(@)(@@) @HAD028 إن الدنيا خيرها زهيد وشرها عتيد ولذتها قليلة وحسرتها طويلة تشوب نعيمها ببؤس وتقرن سعودها بنحوس وتصل نفعها بضر وتمزج حلوها بمر(@)(@)(@@)(@@)(@@) ||| 301(@)(@)(@@) @HAD019 إن الدنيا غرارة خدوع معطية منوع ملبسة نزوع لا يدوم رخائها ولا ينقضي عنائها ولا يركد بلائها(@)(@)(@@)(@@)(@@) ||| 302(@)(@)(@@) @HAD020 إن الدنيا كالشبكة تلتف على من رغب فيها وتتحرز عمن أعرض عنها فلا تمل إليها بقلبك ولا تقبل(@)(@)PageV01P248(@)(@)(@@) @HAD09 عليها بوجهك فتوقعك فى شبكتها وتلقيك فى هلكتها(@)(@)(@@)(@@)(@@) ||| 303(@)(@)(@@) @HAD024 إن الدنيا تعطي وترجع وتنقاد وتمتنع وتوحش وتؤنس وتطمع وتؤيس يعرض عنها السعداء ويرغب فيها الأشقياء(@)(@)(@@)(@@)(@@) ||| 304(@)(@)(@@) @HAD022 إن الدنيا دار بالبلاء معروفة وبالغدر موصوفة لا تدوم أحوالها ولا يسلم نزالها ألعيش فيها مذموم والأمان فيها معدوم(@)(@)(@@)(@@)(@@) ||| 305(@)(@)(@@) @HAD021 إن الدنيا ظل الغمام وحلم المنام والفرح الموصول بالغم 
ms95	 والعسل المشوب بالسم سلابة النعم أكالة الأمم جلابة النقم(@)(@)(@@)(@@)(@@) ||| 306(@)(@)(@@) @HAD033 إن الدنيا لا تفي لصاحب ولا تصفو لشارب نعيمها ينتقل وأحوالها تتبدل ولذاتها تفنى وتبعاتها تبقى فأعرض عنها قبل أن تعرض عنك واستبدل بها قبل أن تستبدل بك(@)(@)(@@)(@@)(@@) ||| 307(@)(@)(@@) @HAD064 إن الدنيا ربما أقبلت على الجاهل بالأتفاق وأدبرت عن العاقل بالأستحقاق فإن اتتك منها سهمة مع جهل أو فاتتك منها بغية مع عقل فإياك أن يحملك ذلك على الرغبة في الجهل والزهد في العقل فإن ذلك يزري بك ويرديك (بأبي أنت وأمي يا أمير المؤمنين روحي لك الفداء يا ابن أبي طالب يا أخا رسول الله ووصيه ووزيره)(@)(@)(@@)(@@)(@@) ||| 308(@)(@)(@@) @HAD09 إن من نكد الدنيا أنها لا تبقى على حالة(@)(@)PageV01P249(@)(@)(@@) @HAD029 ولا تخلو من إستحالة تصلح جانبا بفساد جانب وتسر صاحبا بمسائة صاحب فالكون فيها خطر والثقة بها غرر والإخلاد إليها محال والإعتماد عليها ضلال(@)(@)(@@)(@@)(@@) ||| 309(@)(@)(@@) @HAD027 إن الدنيا سريعة التحول كثيرة التنقل شديدة الغدر دائمة المكر فأحوالها تتزلزل ونعيمها يتبدل ورخائها يتنقص ولذاتها تتنغص وطالبها يذل وراكبها يزل(@)(@)(@@)(@@)(@@) ||| 310(@)(@)(@@) @HAD030 إن الدنيا حلوة نضرة حفت بالشهوات وراقت بالقليل وتحلت بالآمال وتزينت بالغرور لا تدوم حبرتها ولا تؤمن فجعتها غرارة ضرارة حائلة زائلة نافدة بائدة أكالة غوالة(@)(@)(@@)(@@)(@@) ||| 311(@)(@)(@@) @HAD036 إن الدنيا يونق منظرها ويوبق مخبرها قد تزينت بالغرور وغرت بزينتها دار هانت على ربها فخلط حلالها بحرامها وخيرها بشرها وحلوها بمرها لم يصفها الله لأوليائه ولم يضن بها على أعدائه(@)(@)(@@)(@@)(@@) ||| 312(@)(@)(@@) @HAD041 إن للدنيا مع كل شربة شرقا ومع كل أكلة غصصا لا تنال منها نعمة إلا بفراق أخرى ولا يستقبل فيها المرء يوما من عمره إلا بفراق آخر من أجله ولا يحيى له فيها أثر إلا مات له أثر(@)(@)(@@)(@@)(@@) ||| 313(@)(@)(@@) @HAD035 إن الدنيا دار صدق لمن صدقها ودار عافية لمن فهم عنها ودار غنى لمن تزود منها ودار موعظة لمن إتعظ بها قد آذنت ببنيها ونادت بفراقها ونعت نفسها وأهلها(@)(@)PageV01P250(@)(@)(@@) @HAD038 فمثلت لهم ببلائها البلاء وشوقتهم بسرورها إلى السرور راحت بعافية وتبكرت بفجيعة ترغيبا وترهيبا وتخويفا وتحذيرا فذمها رجال 
ms96	 غداة الندامة وحمدها آخرون ذكرتهم فذكروا وحدثتهم فصدقوا فاتعظوا منها بالغير والعبر(@)(@)(@@)(@@)(@@) ||| 314(@)(@)(@@) @HAD036 إن الدنيا منتهى بصر الأعمى لا يبصر مما وراها شيئا والبصير ينفذها بصره ويعلم أن الدار ورائها فالبصير منها شاخص والأعمى إليها شاخص والبصير منها مزود والأعمى إليها متزود(@)(@)(@@)(@@)(@@) ||| 315(@)(@)(@@) @HAD021 إن للدنيا رجالا لديهم كنوز مذخورة مذمومة عندكم مدحورة يكشف بهم الدين ككشف أحدكم رأس قدره يلوذون كالجراد فيهلكون جبابرة البلاد(@)(@)(@@)(@@)(@@) ||| 316(@)(@)(@@) @HAD038 إن الدنيا والآخرة عدوان متفاوتان وسبيلان مختلفان فمن أحب الدنيا وتوالاها أبغض الآخرة وعاداها وهما بمنزلة المشرق والمغرب وماش بينهما فكلما قرب من واحد بعد من الآخر وهما بعد ضرتان(@)(@)(@@)(@@)(@@) ||| 317(@)(@)(@@) @HAD036 إن الدهر يجرى بالباقين كجريه بالماضين لا يعود ما قد ولى منه ولا يبقى سرمدا ما فيه آخر فعاله كأوله متسابقة أموره متظاهرة أعلامه لا ينفك مصاحبه من عناء وفناء وسلب وحرب(@)(@)(@@)(@@)(@@) ||| 318(@)(@)(@@) @HAD013 إن الدهر موتر قوسه لا تخطى سهامه ولا تؤسى جراحه يرمى الصحيح(@)(@)PageV01P251(@)(@)(@@) @HAD04 بالسقم والناجى بالعطب(@)(@)(@@)(@@)(@@) ||| 319(@)(@)(@@) @HAD018 إن الدنيا لمشغلة عن الآخرة لم يصب صاحبها منها سببا إلا فتحت عليه حرصا عليها ولهجا بها(@)(@)(@@)(@@)(@@) ||| 320(@)(@)(@@) @HAD035 إن الله تعالى جعل الدنيا لما بعدها وابتلا فيها أهلها ليعلم أيهم أحسن عملا ولسنا للدنيا خلقنا ولا بالسعى لها أمرنا وإنما وضعنا فيها لنبتلى بها ونعمل فيها لما بعدها(@)(@)(@@)(@@)(@@) ||| 321(@)(@)(@@) @HAD041 إن الدنيا دار منى لها الفناء ولأهلها منها الجلاء وهي حلوة خضرة قد عجلت للطالب والتبست بقلب الناظر فارتحلوا عنها بأحسن ما يحضركم من الزاد ولا تسئلوا فيها إلا الكفاف ولا تطلبوا منها اكثر من البلاغ(@)(@)(@@)(@@)(@@) ||| 322(@)(@)(@@) @HAD061 إن الدنيا لا يسلم منها إلا بالزهد فيها أبتلى الناس بها فتنة فما أخذوا منها لها أخرجوا منه وحوسبوا عليه وما أخذوا منها لغيرها قدموا عليه وأقاموا فيه وإنها عند ذوي العقول كالظل بينا تراه سائغا حتى قلص وزائدا حتى نقص وقد أعذر الله سبحانه إليكم فى النهي عنها وأنذركم وحذركم منها فأبلغ(@)(@)(@@)(@@)(@@) ||| 323(@)(@)(@@) @HAD040 إن الدنيا لم تخلق لكم دار مقام ولا محل قرار وإنما جعلت لكم مجازا لتزودوا 
ms97	 منها الأعمال الصالحة لدار القرار فكونوا منها على أوفاز ولا تخدعنكم العاجلة ولا تغرنكم فيها الفتنة كقوله تعالى لموسى" ع":(@)(@)(@@) @HAD039 يا موسى لا تطول في الدنيا أملك فتقسي قلبك وقاسى القلب مني بعيد إلى قوله سبحانه وصح إلى من كثرة الذنوب صياح المذنب الهارب من عدوه واستعن بي على ذلك فإني نعم العون ونعم المستعان(@)(@)PageV01P252(@)(@)(@@)(@@)(@@) ||| 324(@)(@)(@@) @HAD039 إن الزهادة قصر الأمل والشكر على النعم والورع عن المحارم فإن غرب ذلك عنكم فلا يغلب الحرام صبركم ولا تنسوا عند النعم شكركم فقد أعذر الله سبحانه إليكم بحجج مسفرة ظاهرة وكتب بارزة العذر واضحة(@)(@)(@@)(@@)(@@) ||| 325(@)(@)(@@) @HAD021 إن على من أجلي جنة حصينة فإذا جاء يومي إنفرجت عني وأسلمتني فحينئذ لا يطيش السهم ولا يبرء الكلم(@)(@)(@@)(@@)(@@) ||| 326(@)(@)(@@) @HAD021 وقال (عليه السلام) وقد طلب رجل من بيت مال المسلمين شيئا وهو ممن لا يستحق أن يعطيه:(@)(@)(@@) @HAD040 إن هذا المال ليس لي ولا لك وإنما هو للمسلمين وجلب أسيافهم فإن شركتهم في حربهم شركتهم فيه وإلا فجنا أيديهم لا يكون لغير أفواههم هذا جناي وخياره فيه وكل جان جناه في فيه(@)(@)(@@)(@@)(@@) ||| 327(@)(@)(@@) @HAD020 إن الله سبحانه يحب أن تكون نية الإنسان للناس جميلة كما يحب أن تكون نيته في طاعته قوية غير مدخولة(@)(@)PageV01P253(@)(@)(@@)(@@)(@@) ||| 328(@)(@)(@@) @HAD011 إن العافية في الدين والدنيا لنعمة جميلة وموهبة جزيلة(@)(@)(@@)(@@)(@@) ||| 329(@)(@)(@@) @HAD013 إن الليل والنهار يعملان فيك فاعمل فيهما ويأخذان منك فخذ منهما(@)(@)PageV01P254(@)(@)(@@)(@@)(@@) ||| ألفصل العاشر مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام)(@)(@)(@@) في حرف الألف بحرف الشرط بلفظ إن المخففة وقال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD05 إن أتاكم الله بنعمة فاشكروا(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD05 إن ابتلاكم الله بمصيبة فاصبروا(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD08 إن تصبروا ففي الله من كل مصيبة خلف(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD010 إن تبذلوا أموالكم في جنب الله فإن الله مسرع الخلف(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD08 إن صبرت جرى عليك القلم وأنت مأجور(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD09 وإن جزعت جرى عليك القدر وأنت مأزور(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD013 إن صبرت أدركت بصبرك منازل الأبرار وان جزعت أوردك جزعك عذاب النار(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD09 إن صبرت صبر الأحرار وإلا سلوت سلو الأغمار 
ms98	(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD010 إن كان في الكلام بلاغة ففي الصمت السلامة من العثار(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD03 إن كان في(@)(@)PageV01P255(@)(@)(@@) @HAD06 الغضب الإنتصار ففي الحلم ثواب الأبرار(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD015 إن كنت جازعا على كل ما يفلت من يديك فاجزع على ما لم يصل إليك(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD013 إن كنت حريصا على طلب المضمون لك فكن حريصا على أداء المفروض عليك(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD012 إن استطعت أن لا يكون بينك وبين الله ذو نعمة فافعل(@)(@)(@@)(@@)(@@) ||| 14(@)(@)(@@) @HAD09 إن أحببت أن تكون أسعد الناس بما علمت فاعمل(@)(@)(@@)(@@)(@@) ||| 15(@)(@)(@@) @HAD017 إن أردت قطيعة أخيك فاستبق له من نفسك بقية ترجع إليها إن بدا له ذلك يوما ما(@)(@)(@@)(@@)(@@) ||| 16(@)(@)(@@) @HAD020 إن استنمت إلى ودودك فاحرز له من أمرك واستبق له من سرك ما لعلك أن تندم عليه وقتا ما(@)(@)(@@)(@@)(@@) ||| 17(@)(@)(@@) @HAD017 إن لم تردع نفسك عن كثير مما تحب مخافة مكروهه سمت بك الأهواء إلى كثير من الضرر(@)(@)(@@)(@@)(@@) ||| 18(@)(@)(@@) @HAD021 إن عقدت أيمانك فارض بالمقضي عليك ولك ولا ترج أحدا إلا الله سبحانه وانتظر ما أتاك به القدر(@)(@)(@@)(@@)(@@) ||| 19(@)(@)(@@) @HAD031 إن وقعت بينك وبين عدوك قصة عقدت بها صلحا وألبسته بها ذمة فحط عهدك بالوفاء وارع ذمتك بالأمانة واجعل نفسك جنة بينك وبين ما أعطيت من عهدك(@)(@)PageV01P256(@)(@)(@@)(@@)(@@) ||| 20(@)(@)(@@) @HAD022 إن أحببت سلامة نفسك وستر معايبك فاقلل كلامك وأكثر صمتك يتوفر فكرك ويستنر قلبك ويسلم الناس من يدك(@)(@)(@@)(@@)(@@) ||| 21(@)(@)(@@) @HAD015 إن لم تكن حليما فتحلم فإنه قل من تشبه بقوم إلا أوشك أن يصير منهم(@)(@)(@@)(@@)(@@) ||| 22(@)(@)(@@) @HAD09 إن صبرت صبر الأكارم وإلا سلوت سلو البهائم(@)(@)(@@)(@@)(@@) ||| 23(@)(@)(@@) @HAD030 وقال (عليه السلام) فيمن أثنى عليه إن نطقوا صدقوا وإن صمتوا لم يسبقوا إن نظروا إعتبروا وإن أعرضوا لم يلهوا إن تكلموا ذكروا وإن سكتوا تفكروا(@)(@)(@@)(@@)(@@) ||| 24(@)(@)(@@) @HAD063 وقال (عليه السلام) في حق من ذمه إن سقم هو نادم على ترك العمل وإن صح أمن مغترا فأخر العمل إن دعي إلى حرث الدنيا عمل وان دعي الى حرث الآخرة كسل ان استغنى بطر وفتن إن افتقر قنط ووهن إن أحسن إليه جحد وان أحسن تطاول وامتن إن عرضت له معصية 
ms99	 واقعها بالإتكال على التوبة(@)(@)(@@)(@@)(@@) ||| 25(@)(@)(@@) @HAD046 إن عزم على التوبة سوفها وأصر على الحوبة إن عوفي ظن أن قد تاب إن ابتلي ظن وارتاب إن مرض أخلص وأناب إن صح نسي وعاد واجترى على مظالم العباد إن أمن افتتن لاهيا بالعاجلة فنسي الأخرة وغفل عن المعاد(@)(@)(@@)(@@)(@@) ||| 26(@)(@)(@@) @HAD08 إن كانت الرعايا قبلي تشكو حيف رعاتها فإني(@)(@)PageV01P257(@)(@)(@@) @HAD014 اليوم أشكوا حيف رعيتي كأني المقود وهم القادة والموزع وهم الوزعة(@)(@)(@@)(@@)(@@) ||| 27(@)(@)(@@) @HAD031 إن عقلت أمرك أو أصبت معرفة نفسك فأعرض عن الدنيا وازهد فيها فإنها دار الأشقياء وليست بدار السعداء بهجتها زور وزينتها غرور وسحائبها متقشعة ومواهبها مرتجعة(@)(@)(@@)(@@)(@@) ||| 28(@)(@)(@@) @HAD05 إن آمنت بالله أمن منقلبك(@)(@)(@@)(@@)(@@) ||| 29(@)(@)(@@) @HAD06 إن أسلمت نفسك لله سلمت نفسك(@)(@)(@@)(@@)(@@) ||| 30(@)(@)(@@) @HAD012 إن كنتم راغبين لا محالة فارغبوا في جنة عرضها السماوات والأرض(@)(@)(@@)(@@)(@@) ||| 31(@)(@)(@@) @HAD08 إن كنتم عاملين فاعملوا لما ينجيكم يوم العرض(@)(@)(@@)(@@)(@@) ||| 32(@)(@)(@@) @HAD09 إن كنتم لا محالة متنزهين فتنزهوا عن معاصي القلوب(@)(@)(@@)(@@)(@@) ||| 33(@)(@)(@@) @HAD011 إن كنتم لا محالة متعصبين فتعصبوا النصرة الحق وإغاثة الملهوف(@)(@)(@@)(@@)(@@) ||| 34(@)(@)(@@) @HAD013 إن كنتم لا محالة متسابقين فتسابقوا إلى إقامة حدود الله والأمر بالمعروف(@)(@)(@@)(@@)(@@) ||| 35(@)(@)(@@) @HAD012 إن كنتم لا محالة متنافسين فتنافسوا في الخصال الرغيبة وخلال المجد(@)(@)(@@)(@@)(@@) ||| 36(@)(@)(@@) @HAD013 إن كنتم للنجاة طالبين فارفضوا الغفلة واللهو والزموا الاجتهاد والجد(@)(@)(@@)(@@)(@@) ||| 37(@)(@)(@@) @HAD04 إن كنتم لا محالة(@)(@)PageV01P258(@)(@)(@@) @HAD07 متطهرين فتطهروا من دنس العيوب والذنوب(@)(@)(@@)(@@)(@@) ||| 38(@)(@)(@@) @HAD09 إن كنتم في البقاء راغبين فازهدوا في عالم الفناء(@)(@)(@@)(@@)(@@) ||| 39(@)(@)(@@) @HAD09 إن كنتم للنعيم طالبين فاعتقوا أنفسكم من دار الشقاء(@)(@)(@@)(@@)(@@) ||| 40(@)(@)(@@) @HAD011 إن رغبتم فى الفوز وكرامة الآخرة فخذوا من الفناء للبقاء(@)(@)(@@)(@@)(@@) ||| 41(@)(@)(@@) @HAD09 إن كنتم تحبون الله فاخرجوا من قلوبكم حب الدنيا(@)(@)(@@)(@@)(@@) ||| 42(@)(@)(@@) @HAD024 إن رأيت من نسائك ريبة فاجعل لهن النكير على الكبير والصغير وإياك أن تكرر العتب فإن ذلك يغري بالذنب ويهون العتب(@)(@)(@@)(@@)(@@) ||| 43(@)(@)(@@) @HAD016 إن سمت همتك لإصلاح الناس فابدء بنفسك فإن تعاطيك صلاح غيرك وأنت فاسد اكبر العيب(@)(@)(@@)(@@)(@@) ||| 44(@)(@)(@@) @HAD015 إن جعلت دينك تبعا لدنياك أهلكت دينك ودنياك وكنت في الآخرة من الخاسرين(@)(@)(@@)(@@)(@@) ||| 45(@)(@)(@@) @HAD015 إن جعلت دنياك تبعا لدينك أحرزت دينك ودنياك وكنت في الآخرة من 
ms100	 الفائزين(@)(@)(@@)(@@)(@@) ||| 46(@)(@)(@@) @HAD04 إن اتقيت الله وقاك(@)(@)(@@)(@@)(@@) ||| 47(@)(@)(@@) @HAD04 إن أطعت الطمع أرداك(@)(@)(@@)(@@)(@@) ||| 48(@)(@)(@@) @HAD03 إن توقرت أكرمت(@)(@)(@@)(@@)(@@) ||| 49(@)(@)(@@) @HAD03 إن تخلص تفز(@)(@)PageV01P259(@)(@)(@@)(@@)(@@) ||| 50(@)(@)(@@) @HAD020 قيل له: إن أهل الكوفة لا يصلحهم إلا السيف فقال (عليه السلام): إن لم يصلحهم إلا إفسادي فلا أصلحهم الله(@)(@)(@@)(@@)(@@) ||| 51(@)(@)(@@) @HAD06 إن تنزهوا عن المعاصي يحببكم الله(@)(@)PageV01P260(@)(@)(@@)(@@)(@@) ||| الفصل الحادي عشر مما ورد من حكم أمير المؤمنين على بن ابيطالب (عليه السلام)(@)(@)(@@) في حرف الألف بلفظ أنا وهى ألف المتكلم قال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD035 أنا قسيم النار وخازن الجنان وصاحب الحوض وصاحب الأعراف وليس منا أهل البيت إمام إلا وهو عارف بأهل ولايته وذلك لقوله تعالى إنما أنت منذر ولكل قوم هاد(@)(@)(@@)(@@)(@@) ||| 2(@)(@)(@@) @HAD017 أنا صنو رسول الله والسابق إلى الإسلام وكاسر الأصنام ومجاهد الكفار وقامع الأضداد(@)(@)(@@)(@@)(@@) ||| 3(@)(@)(@@) @HAD011 أنا كاب الدنيا لوجهها وقادرها بقدرها ورادها على عقبها(@)(@)(@@)(@@)(@@) ||| 4(@)(@)(@@) @HAD020 أنا مع رسول الله صلوات الله وسلامه عليه ومعي عترتي على الحوض فليأخذ آخذكم بقولنا ويعمل بعملنا(@)(@)(@@)(@@)(@@) ||| 5(@)(@)(@@) @HAD021 إنا لننافس على الحوض وإنا لنذود عنه أعدائنا ونسقى منه أوليائنا فمن شرب منه شربة لم يظمأ بعدها أبدا(@)(@)PageV01P261(@)(@)(@@)(@@)(@@) ||| 6(@)(@)(@@) @HAD07 أنا يعسوب المؤمنين والمال يعسوب الفجار(@)(@)(@@)(@@)(@@) ||| 7(@)(@)(@@) @HAD010 أنا وضعت بكلكل العرب وكسرت نواجم ربيعة ومضر(@)(@)(@@)(@@)(@@) ||| 8(@)(@)(@@) @HAD032 أنا مخير في الإحسان إلى من لم أحسن إليه ومرتهن بإتمام الإحسان إلى من احسنت إليه لأني إذا أتممته فقد حفظته وإذا قطعته فقد أضعته واذا أضعته فلم فعلته(@)(@)(@@)(@@)(@@) ||| 9(@)(@)(@@) @HAD012 أنا على رد ما لم أقل أقدر مني على رد ما قلته(@)(@)(@@)(@@)(@@) ||| 10(@)(@)(@@) @HAD08 أنا شاهد لكم وحجيع يوم القيامة عليكم(@)(@)(@@)(@@)(@@) ||| 11(@)(@)(@@) @HAD015 أنا داعيكم إلى طاعة ربكم ومرشدكم إلى فرائض دينكم ودليلكم إلى ما ينجيكم(@)(@)(@@)(@@)(@@) ||| 12(@)(@)(@@) @HAD013 أنا وأهل بيتي أمان لأهل الأرض كما أن النجوم أمان لأهل السماء(@)(@)(@@)(@@)(@@) ||| 13(@)(@)(@@) @HAD015 أنا خليفة رسول الله فيكم ومقيمكم على حدود دينكم وداعيكم إلى جنة المأوى(@)(@)PageV01P262(@)(@)(@@)(@@)(@@) ||| (الفصل الثاني عشر) مما ورد من حكم أمير المؤمنين على بن أبيطالب (عليه السلام)(@)(@)(@@) في حرف الألف بلفظ إنى قال (عليه السلام)(@)(@)(@@)(@@)(@@) ||| 1(@)(@)(@@) @HAD013 إنى لعلى بينة من ربي وبصيرة 