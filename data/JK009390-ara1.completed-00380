ms361	 ؟ قال ؟ هي لك أو لأخيك أو للذئب ، قيل : فضالة الإبل ؟ قال : ما لك ولها ، معها سقاءها وحذاؤها ، ترد الماء وتأكل الشجر حتى يلقاها ربها ) )(@)(@@) ( مالك حم خ م د ت ن ه حب ) عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3367 ) قال النبي :(@)(@@) | 30 ( أعطاني ربي السبع الطول مكان التوراة ، والمبين مكان الإنجيل ، وفصلت بالمفصل ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3368 ) قال النبي :(@)(@@) | 30 ( أعط ابنتي سعد الثلثين ، وأعط أمهما الثمن ، وما بقي فهو لك ) )(@)(@@) ( حم د ت ه ن هق ض ش ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3369 ) قال النبي :(@)(@@) | 30 ( أعطه إياه فإن خير الناس أحسنهم قضاء ) )(@)(@@) ( ط حم م د ت ن ه ) و الدارمي وابن خزيمة والطحاوي ( طب ) عن أبي رافع رضي الله عنه قال : استلف النبي من رجل بكرا فقال اقضه ، فلم أجد إلا جملا خيارا رباعيا فقال فذكره .(@)(@@)(@@)(@@) $ ( 3370 ) قال النبي :(@)(@@) | 30 ( أعط السائل ولو جاء على فرس وأعط الأجير حقه قبل أن يبرد عرقه ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3371 ) قال النبي :(@)(@@) | 30 ( أعطني تمرتك وخذ تمرتي ، قال : يا رسول الله تمرتك أجود من تمرتي ، قال : أجل ولاكن فيها خيطا أحمر فخشيت أن أنظر إليها فتفتني عن صلاتي ) )(@)(@@) ( طب ) عن عبيد الله بن سرجس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3372 ) قال النبي :(@)(@@) | 30 ( أعطها إياه فإنها حظه من غزاته ) )(@)(@@) ( ك هق ) عن يعلى بن منية رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3373 ) قال النبي :(@)(@@) | 30 ( أعطوه فإن خيركم أحسنكم قضاء ) )(@)(@@) ( خ م ت ) عن PageV01P484 أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3374 ) قال النبي :(@)(@@) | 30 ( أعطوه أجره ما دام في رشحه ) )(@)(@@) ( ض ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3375 ) قال النبي :(@)(@@) | 30 ( أعطوني ردائي ، فلو كان لي عدد هاذه العضاة نعما لقسمته بينكم ، ثم لا تجدوني كذابا ولا بخيلا ولا جبانا ) )(@)(@@) ( حم خ حب ) عن جبير بن مطعم ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3376 ) قال النبي :(@)(@@) | 30 ( أعطي ولا تتحصي فيحصى عليك ) )(@)(@@) ( د ) عن 
ms362	 عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3377 ) قال النبي :(@)(@@) | 30 ( أعطيت آية الكرسي من كنز تحت العرش ولم يؤتها نبي قبلي ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3378 ) قال النبي :(@)(@@) | 30 ( أعطيت ما لم يعط أحد من الأنبياء قبلي : نصرت بالرعب ، وأعطيت مفاتيح الأرض ، وسميت أحمد ، وجعل لي التراب طهورا ، وجعلت أمتي خير الأمم ) )(@)(@@) ابن مردويه عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3379 ) قال النبي :(@)(@@) | 30 ( أعطيت نهرا في الجنة يدعى الكوثر وعرصته ياقوت ومرجان وزبرجد ولؤلؤ هو والله ما بين صنعاء وأيلة ، فيه أباريق مثل عدد نجوم السماء وأحب واردها إلي قومك يا آمنة ) )(@)(@@) الباوردي ( طب ) عن أسامة بن زيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3380 ) قال النبي :(@)(@@) | 30 ( أعطيت الكوثر نهرا في الجنة عرضه وطوله ما بين المشرق والمغرب ، لا يشرب منه أحد فيظما ولا يتوضا منه أحد فيتشعث أبدا ، لا يشربه إنسان أخفر ذمتي ولا قتل أهل بيتي ) )(@)(@@) ابن مردويه عن أنس رضي الله عنه .(@)(@@) PageV01P485(@)(@@)(@@)(@@) $ ( 3381 ) قال النبي :(@)(@@) | 30 ( أعطيت نهرا في الجنة يقال له الكوثر : ماؤه أشد بياضا من اللبن وأحلى من العسل ، وألين من الزبد ، فيه طيور أعناقها كالخرز ، قال عمر إنها لنا عمسة قال : أكلها أنعم منها ) )(@)(@@) ابن مردويه عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3382 ) قال النبي :(@)(@@) | 30 ( أعطيت الكوثر فضربت بيدي إلى تربته فإذا مسك أذفر ، وإذا حصاه اللؤلؤ ، وإذا حافاته قباب الدر ) )(@)(@@) ( ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3383 ) قال النبي :(@)(@@) | 30 ( أعطيت خمسا لم يعطهن نبي قبلي ، ولا أقوله فخرا ، بعثت إلى الناس كافة : الأحمر والأسود وكان النبي قبلي يبعث إلى قومه ، ونصرت بالرعب أمامي مسيرة شهر ، وأحلت لي الغنائم ولم تحل لأحد قبلي ، وجعلت لي الأرض مسجدا وطهورا ، وأعطيت الشفاعة فأخرتها لامتي فهي لمن لا يشرك بالله شيئا ) )(@)(@@) ( حم ) و الحكيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3384 ) قال النبي :(@)(@@) | 30 ( أعطيت خمسا لم يعطهن أحد قبلي من الأنبياء : جعلت لي الأرض طهورا ومسجدا ، ولم يكن نبي من الأنبياء يصلي حتى يبلغ محرابه 
ms363	 ، وأعطيت الرعب مسيرة شهر يكون بيني وبين المشركين مسيرة شهر فيقذف الله الرعب في قلوبهم ، وكان النبي إلى خاصة قومه وبعثت أنا إلى الجن والإنس ، وكان الأنبياء يعزلون الخمس فتجيء النار فتأكله ، وأمرت أن أقسمها في فقراء أمتي ، ولم يبق نبي إلا أعطي سؤله ، وأخرت شفاعتي لامتي ) )(@)(@@) ( هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3385 ) قال النبي :(@)(@@) | 30 ( أعطيت خمسا لم يعطهن أحد قبلي : أرسلت إلى الأبيض والأسود والأحمر ، وجعلت لي الأرض مسجدا وطهورا ، ونصرت بالرعب مسيرة شهر ، وأحلت لي الغنائم ولم تحل لأحد قبلي ، وأعطيت جوامع الكلم ) )(@)(@@) العسكري في الأمثال عن علي رضي الله عنه .(@)(@@) PageV01P486(@)(@@)(@@)(@@) $ ( 3386 ) قال النبي :(@)(@@) | 30 ( أعطيت فاتح الكلم ونصرت بالرعب ) )(@)(@@) العسكري عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3387 ) قال النبي :(@)(@@) | 30 ( أعطيت خمسا لم يعطهن أحد قبلي : بعثت إلى الأحمر والأسود ، وجعلت لي الأرض مسجدا وطهورا ، وأحلت لي الغنائم ولم تحل لأحد كان قبلي ، ونصرت بالرعب فيرعب العدو مني مسيرة شهر ، وقيل سل تعطه ، فاختبأت دعوتي شفاعتي لامتي وهي نائلة منكم إن شاء الله من لقي الله عز وجل لا يشرك به شيئا ) )(@)(@@) ( ط حم ) و الدارمي ( ع حب ك ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3388 ) قال النبي :(@)(@@) | 30 ( أعطيت أربعا لم يعطهن نبي قبلي : نصرت بالرعب مسيرة شهر ، وبعثت إلى كل أبيض وأسود ، وأحلت لي الغنائم ، وجعلت لي الأرض طهورا ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3389 ) قال النبي :(@)(@@) | 30 ( أعطيت خمسا لم يعطهن نبي قبلي : أرسلت إلى الأحمر والأسود ، وكان النبي يرسل إلى قومه خاصة ، ونصرت بالرعب حتى إن العدو ليخافني من مسيرة شهر أو شهرين ، وأحلت لي الغنائم ولم تحل لمن قبلي ، وجعلت الأرض مسجدا وطهورا ، وقيل لي سل تعطه فادخرت دعوتي شفاعة لأمتي فهي نائلة إن شاء الله لمن مات لا يشرك بالله شيئا ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3390 ) قال النبي :(@)(@@) | 30 ( أعطيت خمسا لم يعطهن نبي قبلي : بعثت إلى الناس كافة : الأحمر والأسود وإنما 
ms364	 كان يبعت كل نبي إلى قريته ، ونصرت بالرعب يرعب مني عدوي على مسيرة شهر ، وأعطيت المغنم ، وجعلت لي الأرض مسجدا وطهورا ، وأعطيت الشفاعة لأمتي ) )(@)(@@) الحكيم ( طب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3391 ) قال النبي :(@)(@@) | 30 ( أعطيت خمسا لم يعطهن نبي قبلي : بعثت إلى PageV01P487 الأحمر والأسود ، ونصرت بالرعب مسيرة شهر ، وجعلت لي الأرض مسجدا وطهورا ، وأحلت لي الغنائم ولم تحل لنبي كان قبلي ، وأعطيت الشفاعة وإنه ليس من نبي إلا قد سأل شفاعته وإني أخرت شفاعتي ، ثم جعلتها لمن مات من أمتي لا يشرك بالله شيئا ) )(@)(@@) ( حم طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3392 ) قال النبي :(@)(@@) | 30 ( أعطيت أمتي في شهر رمضان خمس خصال لم تعطه أمة قبلهم : خلوف فم الصائم أطيب عند الله من ريح المسك ، وتستغفر لهم الملائكة حتى يفطروا ، ويزين الله كل يوم جنته ثم يقول : يوشك عبادي الصالحون أن يلقوا عنهم المؤونة والأذى ويصيرون إليك ، وتصفد فيه مردة الشياطين ولا يخلصون فيه إلا ما كانوا يخلصون في غيره ، ويغفر لهم في آخر ليلة ، قيل : يا رسول الله أهي ليلة القدر ؟ قال : لا ولاكن العامل إنما يوفى أجره إذا قضى عمله ) )(@)(@@) ( حم ) و محمد بن نصر ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3393 ) قال النبي :(@)(@@) | 30 ( أعطيت أمتي في شهر رمضان خمسا لم يعطهن نبي قبلي : أما واحدة فإنه إذا كان أول ليلة من شهر رمضان نظر الله إليهم ، ومن نظر الله إليه لم يعذبه أبدا ، وأما الثانية فإن خلوف أفواههم حين يمسون أطيب عند الله من ريح المسك ، وأما الثالثة فإن الملائكة تستغفر لهم في كل يوم وليلة ، وأما الرابعة فإن الله يأمر جنته فيقول لها استعدي وتزيني لعبادي أوشك أن يستريحوا من تعب الدنيا إلى داري وكرامتي ، وأما الخامسة فإنه إذا كان آخر ليلة غفر لهم جميعا ، فقال رجل : أهي ليلة القدر ؟ قال : لا ، ألم تر إلى العمال يعملون فإذا فرغوا من أعمالهم وفوا أجورهم ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3394 
ms365	 ) قال النبي :(@)(@@) | 30 ( أعطيت هاذه الأمة ما لم يعط أحد : { ادعوني أستجب لكم } وإنما كان يقال هاذا للأنبياء ، وقوله : { وما جعل عليكم في PageV01P488 الدين من حرج } وإنما كان يقال هاذا للأنبياء ، وقوله : { وكذالك جعلناكم أمة وسطا لتكونوا شهداءءعلى الناس } وإنما كان يقال هاذا للنبي أنت شهيد على قومك ) )(@)(@@) الحكيم عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3395 ) قال النبي :(@)(@@) | 30 ( أعطيك خمسة آلاف شاة أو أعلمك خمس كلمات فيهن صلاح دينك ودنياك ؟ قل اللهم اغفر لي ذنبي ، ووسع لي خلقي ، وطيب لي كسبي ، وقنعني بما رزقتني ، ولا تذهب قلبي إلى شيء صرفته عني ) )(@)(@@) ابن النجار عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3396 ) قال النبي :(@)(@@) | 30 ( أعطيكم ما هو خير لكم منها السقاية ترزؤكم ولا ترزؤنها ) )(@)(@@) ابن سعد ( ك ) عن علي قال : قلت للعباس رضي الله عنهما : سل لنا رسول الله المهابة فسأله فقال فذكره .(@)(@@)(@@)(@@) $ ( 3397 ) قال النبي :(@)(@@) | 30 ( أعظم النكاح بركة أيسره مؤنة ) )(@)(@@) الخطيب في المتفق والمفترق عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3398 ) قال النبي :(@)(@@) | 30 ( أعظم سورة في القرآن : الحمد لله رب العالمين ) )(@)(@@) ( خ د ت ) عن أبي سعيد بن المعلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3399 ) قال النبي :(@)(@@) | 30 ( أعظم آية في القرآن آية الكرسي ) )(@)(@@) ( خ ) في التاريخ ( طب ) عن الأسفع البكري بالفاء وعيدان ( د ) عن ابن الأسفع وهو الأشهد ( حم ك ) عن أبي ذر الدارمي عن أنقع الكلاعي بن راهويه عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3400 ) قال النبي :(@)(@@) | 30 ( أعظم سورة في القرآن البقرة ، وأعظم آية فيها آية الكرسي ) )(@)(@@) أبو الشيخ في الثواب عن ابن عباس رضي الله عنهما .(@)(@@) PageV01P489(@)(@@)(@@)(@@) $ ( 3401 ) قال النبي :(@)(@@) | 30 ( أعظم الناس نصيبا في الإسلام أهل فارس ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3402 ) قال النبي :(@)(@@) | 30 ( أعظم الصدقة أن تصدق وأنت صحيح شحيح تخشى الفقر وتأمل الغنى ، ولا تمهل حتى إذا بلغت الحلقوم قلت لفلان كذا ولفلان كذا ، ألا وقد كان لفلان كذا ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله 
ms366	 عنه .(@)(@@)(@@)(@@) $ ( 3403 ) قال النبي :(@)(@@) | 30 ( أعظم الذنب أن تجعل لله ندا وهو خلقك ، ثم أن تقتل ولدك مخافة أن يطعم معك ، ثم أن ترى حليلة جارك ) )(@)(@@) ( حم خ م د ت ن ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3404 ) قال النبي :(@)(@@) | 30 ( اعف عنه في كل يوم سبعين مرة يعني الخادم ) )(@)(@@) ( د ت ) حسن غريب عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3405 ) قال النبي :(@)(@@) | 30 ( اعلفه ناضحك ) )(@)(@@) ( حم ع ض ) عن جابر أن رسول الله سئل عن كسب الحجام قال فذكره .(@)(@@)(@@)(@@) $ ( 3406 ) قال النبي :(@)(@@) | 30 ( اعلفوه الناضح يعني أجر الحجام ) )(@)(@@) ( طب ) عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3407 ) قال النبي :(@)(@@) | 30 ( اعلفها ناضحك وأطعمه ريقك يعني إجارة الحجام ) )(@)(@@) ( ت ) حسن ( ه ) و ابن قانع عن أبي محيضة عن أبيه .(@)(@@)(@@)(@@) $ ( 3408 ) قال النبي :(@)(@@) | 30 ( اعلف به الناضح واجعله في كرشه ) )(@)(@@) ( هق ) عن محيصة بن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3409 ) قال الن بي :(@)(@@) | 30 ( اعلم عددها ووعاءها ووكاءها ، فإن جاء أحد يخبرك بعددها ووعائها ووكائها فأعطه إياها وإلا فاستمتع بها ) )(@)(@@) ( حب ) عن أبي رضي الله عنه .(@)(@@) PageV01P490(@)(@@)(@@)(@@) $ ( 3410 ) قال النبي :(@)(@@) | 30 ( اعلم أنه من مات يشهد أن لا إلاه إلا الله وأني رسول الله دخل الجنة ) )(@)(@@) ( ط حم ش ن ع حل ) عن أنس رضي الله عنه وصحح .(@)(@@)(@@)(@@) $ ( 3411 ) قال النبي :(@)(@@) | 30 ( اعلم يا براء أن المرء إذا فعل ذالك بأخيه لوجه الله لا يريد بذالك جزاء ولا شكورا بعث الله إلى منزله عشرة من الملائكة يسبحون الله ويهللونه ويكبرونه ويستغفرونه له حولا كاملا ، فإذا كان الحول كتب له مثل عبادة أولائك الملائكة ، وحق على الله أن يطعمه من طيبات الجنة في جنة الخلد وملك لا يبيد ) )(@)(@@) أبو نعيم عن أنس ، أن أبي بن كعب لقي البراء بن مالك رضي الله عنهما فقال : يا أخي ما تشتهي ؟ قال : سويقا وتمرا فأطعمه حتى شبع فذكر البراء ذالك لرسول الله قال فذكره .(@)(@@)(@@)(@@) $ ( 3412 ) قال النبي :(@)(@@) | 30 ( أعلنوا هاذا النكاح واضربوا عليه بالغربال ) )(@)(@@) ( ه ) عن عائشة رضي 
ms367	 الله عنها .(@)(@@)(@@)(@@) $ ( 3413 ) قال النبي :(@)(@@) | 30 ( أعلماه فإنه أثبت للمودة بينكما ) )(@)(@@) ابن أبي الدنيا في كتاب الإخوان عن أنس رضي الله عنه أن رجلا قال : يا رسول الله إني لأحب هاذا قال فذكره .(@)(@@)(@@)(@@) $ ( 3414 ) قال النبي :(@)(@@) | 30 ( أعلم أمتي من بعدي علي بن أبي طالب ) )(@)(@@) الديلمي عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3415 ) قال النبي :(@)(@@) | 30 ( أعلم الناس من يجمع علم الناس إلى علمه ، وكل صاحب علم عن ثان ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3416 ) قال النبي :(@)(@@) | 30 ( اعمد إلى متاعك فاقذفه في السكة فإذا أتاك آت فقل : آذاني جاري فتخق عليه اللعنة ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن محمد بن PageV01P491 يوسف بن عبد الله بن سلام رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3417 ) قال النبي :(@)(@@) | 30 ( اعمل لله رأي العين ، فإن لم تكن تراه فإنه يراك ، وأسبغ طهرك ، وإذا دخلت المسجد فإذكر الموت ، فإن الرجل إذا ذكر الموت تحرى أن يحسن صلاته ، وصل صلاة رجل لا يظن أن يصلي صلاة غيرها ، وإياك وكل أمر يعتذر منه ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3418 ) قال النبي :(@)(@@) | 30 ( اعملوا بكتاب الله فما اشتبه عليكم فسلوا عنه أهل العلم يخبروكم ، وآمنوا بالتوراة والإنجيل ، وآمنوا بالفرقان فإن فيه البيان ، وهو الشاففع والمشفع ، والماحل والمصدق ) )(@)(@@) ( ك ) عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3419 ) قال النبي :(@)(@@) | 30 ( أعن أخاك ظالما أو مظلوما ) )(@)(@@) ( عد ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3420 ) قال النبي :(@)(@@) | 30 ( أعيدوا تمركم في وعائه ، وسمنكم في سقائه فإني صائم ) )(@)(@@) ( حم خ ) تعليقا ( حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3421 ) قال النبي :(@)(@@) | 30 ( اعملوا بالقرآن أحلوا حلاله وحرموا حرامه واقتدوا به ، ولا تكفروا بشيء منه ، وما تشابه عليكم منه فردوه إلى الله عز وجل وإلى أولي العلم من بعدي كما يخبروكم ، وآمنوا بالتوراة والإنجيل والزبور وما أوتي النبيون من ربهم ، وليسعكم القرآن وما فيه من البيان فإنه شافع مشفع وماحل مصدق ، ألا وإن لكل آية نورا يوم القيامة ، ألا وإني أعطيت سورة البقرة من الذكر الأول ، وأعطيت 
ms368	 طاه والطواسين من ألواح موسى ، وأعطيت فاتحة الكتاب وخواتيم القرآن من كنز تحت العرش ، وأعطيت المفصل نافلة ) )(@)(@@) محمد بن نصر ( طب ك هق ) وابن عساكر عن معقل بن يسار رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3422 ) قال النبي :(@)(@@) | 30 ( اعملوا فإنكم على عمل صالح لولا أن تغلبوا لنزلت PageV01P492 حتى أضع الحبل على هاذه يعني عاتقه ) )(@)(@@) ( حم خ ) عن ابن عباس رضي الله عنهما أن النبي أتى زمزم وهم يسقون ويعملون فيها فذكره .(@)(@@)(@@)(@@) $ ( 3423 ) قال النبي :(@)(@@) | 30 ( اعملوا فكل ميسر لما خلق له ) )(@)(@@) ( عم طب ) و البغوي والباوردي ( ض ) عن ذي اللحية الكلابي رضي الله عنه قال البغوي : ولا أعلم له غيره ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3424 ) قال النبي :(@)(@@) | 30 ( اعمم ففضل ما بين العموم والخصوص كما بين السماء والأرض يعني في الدعاء ) )(@)(@@) ( د ) في مراسيله ( هق ) عن عمرو بن شعيب مرسلا .(@)(@@)(@@)(@@) $ ( 3425 ) قال النبي :(@)(@@) | 30 ( أعمم ولا تخص فإن بين الخصوص والعموم كما بين السماء والأرض ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3426 ) قال النبي :(@)(@@) | 30 ( أعن أخاك ظالما أو مظلوما ) )(@)(@@) ( كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3427 ) قال النبي :(@)(@@) | 30 ( أعهد إليكم أن تقيموا الصلاة وتؤتوا الزكاة ، وتحجوا البيت الحرام ، وتصوموا رمضان فإن فيه ليلة خير من ألف شهر ، وتحرموا دم المسلم وماله والمعاهد إلا بحقه وتعتصموا بالله والطاعة ) )(@)(@@) ( هب ) عن قرة بن دعموص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3428 ) قال النبي :(@)(@@) | 30 ( أعهد إليكم أن تتقوا الله وتلزموا سنتي وسنة الخلفاء الهادية المهدية فعضوا عليها بالنواجذ ، وإن استعمل عليكم عبد حبشي فاسمعوا له وأطيعوا ، فإن كل بدعة ضلالة ) )(@)(@@) البغوي من طريق سعيد بن خيثم عن شيخ من أهل الشام .(@)(@@)(@@)(@@) $ ( 3429 ) قال النبي :(@)(@@) | 30 ( أعوذ برضاك من سخطك ، وأعوذ بعفوك من غضبك ، وأعوذ برحمتك من عذابك ، وأعوذ بك منك لا أحصي ثناء رحمتك ، ولا PageV01P493 ثناء عليك أنت كما أثنيت على نفسك ) )(@)(@@) ( قط ) في الأفراد عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3430 ) قال النبي :(@)(@@) | 30 ( أعوذ برضاك من سخطك ، وبعفوك من عقوبتك ، وبك 
ms369	 منك ، أثني عليك لا أبلغ كل ما فيك ) )(@)(@@) ( ك هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3431 ) قال النبي :(@)(@@) | 30 ( أعوذ بالله من عذاب جهنم ، وأعوذ بالله من عذاب القبر ، وأعوذ بالله من شر المسيح الدجال ، وأعوذ بالله من فتنة المحيا والممات ) )(@)(@@) ( ك ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3432 ) قال النبي :(@)(@@) | 30 ( أعوذ بالله من قلب لا يخشع ، وعلم لا ينفع ، ودعاء لا يسمع ، ونفس لا تشبع ، ومن الجوع فإنه بئس الضجيع ) )(@)(@@) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3433 ) قال النبي :(@)(@@) | 30 ( أعن أخاك ظالما أو مظلوما ، قيل : يا رسول الله أعينه مظلوما فكيف أعينه ظالما ؟ قال : ترده إلى الحق فذالك عون له ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3434 ) قال النبي :(@)(@@) | 30 ( أعوذ بالله من النار ، ويل لأهل النار ) )(@)(@@) ( د ه ) عن عبد الرحمان بن أبي ليلى عن أبيه رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 3435 ) قال النبي :(@)(@@) | 30 ( أعوذ بالله من الكفر والدين ، قيل : أتعدل الدين بالكفر ؟ قال : نعم ) )(@)(@@) ( حم ) و عبد بن حميد ( ع حب ك ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3436 ) قال النبي :(@)(@@) | 30 ( أعيذك بالله يا ك| عب بن عجرة من أمراء يكونون بعدي ، فمن غشي أبوابهم فصدقهم في كذبهم وأعانهم على ظلمهم فليس مني PageV01P494 ولست منه ولا يرد على الحوض ، ومن غغ أو لم يغغ فلم يصدقهم في كذبهم ولم يعنهم على ظلمهم فهو مني وأنا منه ، وسيرد على الحوض ، يا كعب بن عجرة الصلاة برهان والصوم جنة ، والصدقة تطفىء الخطيئة كما يطفىء الماء النار ، يا كعب بن عجرة إنه لا يربو لحم نبت من سحت إلا كانت النار أولى به ) )(@)(@@) ( ت ) حسن غريب عن كعب بن عجرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3437 ) قال النبي :(@)(@@) | 30 ( أعيذك بالله الأحد الصمد الذي لم يلد ولم يولد ولم يكن له كفوا أحد من شر ما تجد ، تعوذ بها فإنها تعدل بثلث القرآن ، ومن تعوذ بها فقد تعوذ بنسبة الله التي رضيها لنفسه ) )(@)(@@) الحكيم عن عثمان رضي الله عنه 
ms370	 .(@)PageV01P495(@)(@@)(@@)(@@) ||| ( الهمزة مع الغين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 3438 ) قال النبي :(@)(@@) | 30 ( أغبط الناس عندي مؤمن خفيق الحاذ ذو حظ من صلاة وكان رزقه كفافا فصبر عليه حتى يلقى الله ، وأحسن عبادة ربه ، وكان غامضا في الناس ، عجلت منيته وقل تراثه وقلت بواكيه ) )(@)(@@) ( حم ت ك هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3439 ) قال النبي :(@)(@@) | 30 ( أغبوا في العبادة وأربعوا ) )(@)(@@) ( ع ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3440 ) قال النبي :(@)(@@) | 30 ( اغتسلوا من البحر وتوضؤوا به فإنه الطهور ماؤه ، الحل ميتته ) )(@)(@@) ( تخ ك هق ) في المعرفة عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 3441 ) قال النبي :(@)(@@) | 30 ( اغتسلوا يوم الجمعة فإنه من اغتسل يوم الجمعة فله كفارة ما بين الجمعة إلى الجمعة وزيادة ثلاثة أيام ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3442 ) قال النبي :(@)(@@) | 30 ( اغتسلوا يوم الجمعة واغسلوا رؤسكم وإن لم تكونوا PageV02P005 جنبا ومسوا من الطيب ) )(@)(@@) ( حم حب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 3443 ) قال النبي :(@)(@@) | 30 ( اغتسلوا يوم الجمعة ولو كأسا بدينار ) )(@)(@@) ( عد ) عن أنس ( ش ) عن أبي هريرة رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 3444 ) قال النبي :(@)(@@) | 30 ( اغتنم خمسا قبل خمس : حياتك قبل موتك ، وصحتك قبل سقمك ، وفراغك قبل شغلك ، وشبابك قبل هرمك ، وغناك قبل فقرك ) )(@)(@@) ( ك هب ) عن ابن عباس ( حم ) في الزهد ( حل هب ) عن عمرو بن ميمون مرسلا .(@)(@@)(@@)(@@) $ ( 3445 ) قال الن بي :(@)(@@) | 30 ( اغتنموا الدعاء عند الرقة فإنها رحمة ) )(@)(@@) ( فر ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3446 ) قال النبي :(@)(@@) | 30 ( اغتنموا دعوة المؤمن المبتلى ) )(@)(@@) ( أبو الشيخ ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3447 ) قال النبي :(@)(@@) | 30 ( اغد عالما أو متعلما أو مستمعا أو محبا ولا تكن الخامسة فتهلك ) )(@)(@@) ( البزار طس ) عن أبي بكرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 3448 ) قال النبي :(@)(@@) | 30 ( أغدوا في طلب العلم فإن الغدو بركة ونجاح ) )(@)(@@) ( خط ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 3449 ) قال النبي :(@)(@@) | 30 ( أغدوا في طلب العلم فإني سألت ربي أن يبارك لأمتي في بكورها ويجعل ذالك اليوم الخميس 
