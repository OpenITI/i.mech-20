ms161	 النيهي (@)(@@) بالكسر إلى نيه بلد بين سجستان وإسفزاز.(@)(@@)(@@)(@@) | حرف الواو(@)(@@)(@@)(@@) || باب الواو والألف(@)(@@)(@@)(@@) $DIC_NIS$ الوابشي(@)(@@) بكسر الموحدة ومعجمة إلى وابش بطن من قيس عيلان.(@)(@@)(@@)(@@) $DIC_NIS$ الوابصي (@)(@@) بكسرها ومهملة إلى وابصة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الوابكني (@)(@@) بسكون الموحدة وفتح الكاف ونون إلى وابكنة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الوابلي (@)(@@) بكسر الموحدة إلى وابل جد وبمثلثة إلى واثلة بن الأسقع الصحابي.(@)(@@)(@@)(@@) $DIC_NIS$ الواثقي (@)(@@) إلى الواثق الخليفة.(@)(@@)(@@)(@@) $DIC_NIS$ الوادعي (@)(@@) بكسر المهملة ثم مهملة إلى وادعة بطن من همدان.(@)(@@)(@@)(@@) $DIC_NIS$ الوادي (@)(@@) إلى وادي القرى مدينة بالحجاز مما يلي الشام.(@)(@@)(@@)(@@) $DIC_NIS$ الوادييني (@)(@@) مثنى واد إلى مدينة في جبال الشراة.(@)(@@)(@@)(@@) $DIC_NIS$ الواذاري (@)(@@) بمعجمة وراء إلى واذار قرية بأصبهان. PageV01P270(@)(@@)(@@)(@@) $DIC_NIS$ الواذناني (@)(@@) بفتح المعجمة والنون الأولى إلى واذنان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الوارثي (@)(@@) إلى الوارث جد.(@)(@@)(@@)(@@) $DIC_NIS$ الواري (@)(@@) براء إلى وارة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الوازذي (@)(@@) بسكون الزاي ومعجمة إلى وازذ قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الوازعي (@)(@@) بكسر الزاي ومهملة إلى الوازع جد.(@)(@@)(@@)(@@) $DIC_NIS$ الواسطي (@)(@@) بكسر المهملة إلى واسط مدينة بالعراق مشهورة وإلى واسط الرقة وواسط اليهود قرية بطوس وواسط مرزاباذ قرية قرب مطيراباذ وواسط بلخ قرية بها.(@)(@@)(@@)(@@) $DIC_NIS$ الواشجردي (@)(@@) بكسر الجيم وسكون المعجمة قبلها والراء ومهملة إلى واشجرد بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ الواشجي (@)(@@) بكسر المعجمة وجيم إلى واشج بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الواصلي (@)(@@) إلى واصل جد.(@)(@@)(@@)(@@) $DIC_NIS$ الواضحي (@)(@@) إلى واضح جد.(@)(@@)(@@)(@@) $DIC_NIS$ الواعظي (@)(@@) إلى الواعظ. PageV01P271(@)(@@)(@@)(@@) $DIC_NIS$ الوافدي (@)(@@) بكسر الفاء إلى الوافد على النبي صلى الله عليه وسلم حيان بن مازن الطائي.(@)(@@)(@@)(@@) $DIC_NIS$ الواقدي (@)(@@) بكسر القاف إلى واقد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الواقفي (@)(@@) بكسرها وفاء إلى واقف بطن من الأوس.(@)(@@)(@@)(@@) $DIC_NIS$ الوالبي (@)(@@) بكسر اللام وموحدة إلى والبة بطن من أسد بن خزيمة ومن سعد مناة بن غامد.(@)(@@)(@@)(@@) $DIC_NIS$ الواهكاني (@)(@@) بسكون الهاء إلى واهكان قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الوائلي (@)(@@) بكسر التحتية إلى وائل بن حجر ووائلة بن جارية بطن من قضاعة ووائلة بطن من كنانة ومن هوازن ومن إياد ومن ذبيان ومن الأزد ومن جعفي ومن الأنصار ومن جذام ووايل قرية بسجستان.(@)(@@)(@@)(@@) || باب الواو والباء(@)(@@)(@@)(@@) $DIC_NIS$ الوبري (@)(@@) بفتحتين وراء إلى الوبر. 
ms162	(@)(@@)(@@)(@@) || باب الواو والتاء(@)(@@)(@@)(@@) $DIC_NIS$ الوتار (@)(@@) بتشديد الفوقية إلى عمل الوتر.(@)(@@)(@@)(@@) || باب الواو والثاء(@)(@@)(@@)(@@) $DIC_NIS$ الوثابي (@)(@@) بتشديد المثلثة إلى وثاب جد.(@)(@@)(@@)(@@) || باب الواو والجيم(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الوجيزي (@)(@@) إلى حفظ الوجيز انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الوجيهي (@)(@@) بالفتح وكسر الجيم إلى وجيه جد.(@)(@@)(@@)(@@) || باب الواو والحاء(@)(@@)(@@)(@@) $DIC_NIS$ الوحاظي (@)(@@) بالضم ومهملة وظاء معجمة إلى وحاظة بطن من جشم بن عبد شمس وقرية باليمن.(@)(@@)(@@)(@@) || باب الواو والخاء(@)(@@)(@@)(@@) $DIC_NIS$ الوخشمالي (@)(@@) بالفتح وسكون الخاء وضم الشين المعجمتين إلى وخشمال قرية ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الوخشي (@)(@@) بالفتح والسكون إلى وخش بلد بنواحي بلخ.(@)(@@)(@@)(@@) || باب الواو والدال(@)(@@)(@@)(@@) $DIC_NIS$ الوادعي (@)(@@) بالفتح ومهملتين إلى بني وداعة بطن من همدان وقال ابن الأثير: إنما هو وادعة كما سبق وإلى أبي وداعة السهمي. PageV01P272(@)(@@)(@@)(@@) $DIC_NIS$ الوداني (@)(@@) بالفتح وتشديد المهملة ونون إلى ودان.(@)(@@)(@@)(@@) $DIC_NIS$ الودعاني (@)(@@) بالفتح وسكون الدال المهملة ومهملة إلى ودعان جد.(@)(@@)(@@)(@@) || باب الواو والذال(@)(@@)(@@)(@@) $DIC_NIS$ الوذاري (@)(@@) بالفتح ومعجمة وراء إلى وذار قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الوذنكاباذي (@)(@@) بفتح أوله والمعجمة والكاف والباء الموحدة وسكون النون آخره معجمة إلى وذنكاباذ قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الوذلاني (@)(@@) بالكسر وسكون المعجمة إلى وذلان قرية بأصبهان.(@)(@@)(@@)(@@) || باب الواو والراء(@)(@@)(@@)(@@) $DIC_NIS$ الورازاني (@)(@@) بالفتح وراء ثم زاي إلى ورازان قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الوراق (@)(@@) هو الناسخ وبائع الورق.(@)(@@)(@@)(@@) $DIC_NIS$ الوراميني (@)(@@) بالفتح إلى ورامين قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الورتنيسي (@)(@@) بفتح الواو والفوقية وكسر النون وتحتية ومهملة إلى ورتنيس قرية بخراسان. PageV01P273(@)(@@)(@@)(@@) $DIC_NIS$ الورثاني (@)(@@) بفتحات ومثلثة ونون إلى ورثان قرية بشيراز.(@)(@@)(@@)(@@) $DIC_NIS$ الورثيني (@)(@@) بفتحتين وكسر المثلثة إلى ورثين قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الورداني (@)(@@) بالفتح والسكون ومهملة إلى وردان جد ووردانة قرية ببخارى وقيل هي بمعجمة.(@)(@@)(@@)(@@) $DIC_NIS$ الورزناني (@)(@@) بفتح الواو والزاي بينهما راء ساكنة إلى ورزنان قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الورسناني (@)(@@) مثله لكن بكسر السين المهملة إلى ورسنان محلة بسمرقند ويقال ورسنين.(@)(@@)(@@)(@@) $DIC_NIS$ الورشي (@)(@@) بالفتح والسكون ومعجمة إلى ورش القارىء.(@)(@@)(@@)(@@) $DIC_NIS$ الورغجني (@)(@@) بفتح أوله والراء والجيم وسكون الغين المعجمة إلى ورغجن قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الورغسري (@)(@@) بوزنه وفتح السين المهملة وراء إلى ورغسر قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الورقودي (@)(@@) بالفتح وسكون الراء وضم القاف ومهملة إلى ورقود قرية 
ms163	 بكرمينية.(@)(@@)(@@)(@@) $DIC_NIS$ الوركاني (@)(@@) بالفتح والسكون إلى وركان محلة بأصبهان وقرية بقاسان.(@)(@@)(@@)(@@) $DIC_NIS$ الوركي (@)(@@) إلى وركة قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الورنجي (@)(@@) بفتحتين وسكون النون وجيم إلى ورنج قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الوري (@)(@@) بفتحتين إلى ورة قرية بالطالقان.(@)(@@)(@@)(@@) || باب الواو والزاي(@)(@@)(@@)(@@) $DIC_NIS$ الوزاغري (@)(@@) بفتح الواو والزاي والمعجمة وراء إلى وزاغر قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ الوزان (@)(@@) إلى الوزن.(@)(@@)(@@)(@@) $DIC_NIS$ الوزدولي (@)(@@) بالفتح وسكون الزاي وضم المهملة إلى وزدول قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الوزغجني (@)(@@) بفتح الواو والمعجمة وسكون الزاي والجيم إلى وزغجن قرية بما وراء النهر.(@)(@@)(@@)(@@) $DIC_NIS$ الوزيري (@)(@@) إلى الوزير جد وغيره. PageV01P274(@)(@@)(@@)(@@) $DIC_NIS$ الوزويني (@)(@@) بالفتح والسكون وكسر الواو وتحتية ونون إلى وزوين قرية ببخارى.(@)(@@)(@@)(@@) || باب الواو والسين(@)(@@)(@@)(@@) $DIC_NIS$ الوساوسي (@)(@@) بفتح الواو الأولى وكسر الثانية ومهملتين إلى وساوس.(@)(@@)(@@)(@@) $DIC_NIS$ الوسسكري (@)(@@) بفتح الواو والمهملة الأولى والكاف وراء إلى وسسكر قرية بجردستان.(@)(@@)(@@)(@@) $DIC_NIS$ الوسيجي (@)(@@) بالفتح والكسر وتحتية وجيم إلى وسيج موضع ببلاد الترك.(@)(@@)(@@)(@@) $DIC_NIS$ الوشاء (@)(@@) بالفتح وتشديد المعجمة إلى بيع الوشي وهو نوع من ثياب الابريسم.(@)(@@)(@@)(@@) $DIC_NIS$ الوشقي (@)(@@) بالفتح وسكون المعجمة وقاف إلى وشق بطن من العتيك.(@)(@@)(@@)(@@) || باب الواو والصاد(@)(@@)(@@)(@@) $DIC_NIS$ الوصابي (@)(@@) بالفتح وتشديد المهملة موحدة إلى وصاب بطن من حمير وبالفاء إلى وصاف جد وسكة وصاف بنسف.(@)(@@)(@@)(@@) || باب الواو والضاد(@)(@@)(@@)(@@) $DIC_NIS$ الوضاحي (@)(@@) بالفتح وتشديد المعجمة إلى وضاح جد.(@)(@@)(@@)(@@) || باب الواو والطاء(@)(@@)(@@)(@@) $DIC_NIS$ الوطيسي (@)(@@) بالفتح والكسر ومهملة إلى الوطيس وهو التنور.(@)(@@)(@@)(@@) || باب الواو والعين(@)(@@)(@@)(@@) $DIC_NIS$ الوعلاني (@)(@@) بالفتح وسكون العين المهملة إلى وعلان بطن من مراد.(@)(@@)(@@)(@@) || باب الواو والقاف(@)(@@)(@@)(@@) $DIC_NIS$ الوقاصي (@)(@@) بتشديد القاف إلى سعد بن أبي وقاص ووقاص بطن من مذحج.(@)(@@)(@@)(@@) $DIC_NIS$ الوقاياتي (@)(@@) بالكسر إلى بيع الوقاية وهي المقنعة.(@)(@@)(@@)(@@) $DIC_NIS$ الوقداني (@)(@@) بالفتح وسكون القاف ومهملة إلى وقدان جد.(@)(@@)(@@)(@@) || باب الواو والكاف (@)PageV01P275(@)(@@)(@@)(@@) $DIC_NIS$ الوكيعي (@)(@@) بالفتح والكسر ومهملة إلى وكيع جد ورجل.(@)(@@)(@@)(@@) || باب الواو واللام(@)(@@)(@@)(@@) $DIC_NIS$ الولجي (@)(@@) بفتحتين وجيم إلى ولجة لقب.(@)(@@)(@@)(@@) $DIC_NIS$ الوليدي (@)(@@) بالفتح والكسر إلى الوليد جد.(@)(@@)(@@)(@@) || باب الواو والنون(@)(@@)(@@)(@@) $DIC_NIS$ قلت: الونائي (@)(@@) إلى ونا بالفتح قرية بصعيد مصر انتهى.(@)(@@)(@@)(@@) $DIC_NIS$ الونبي (@)(@@) بالفتح والسكون وباء موحدة إلى ونب بطن من مراد.(@)(@@)(@@)(@@) $DIC_NIS$ 
ms164	 الونجي (@)(@@) بفتحتين وجيم إلى ونج قرية بنسف.(@)(@@)(@@)(@@) $DIC_NIS$ الونكي (@)(@@) بوزنه إلى ونك قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الونندوني (@)(@@) بفتحتين وسكون النون الثاية وضم المهملة إلى ونندون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الونوساني (@)(@@) بالفتح والضم ومهملة إلى ونوسان جد.(@)(@@)(@@)(@@) $DIC_NIS$ الونوفاغي (@)(@@) بوزنه وفاء ومعجمة إلى ونوفانخ قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الوني (@)(@@) بالفتح والتشديد إلى ونة جد.(@)(@@)(@@)(@@) || باب الواو والهاء(@)(@@)(@@)(@@) $DIC_NIS$ الوهبني (@)(@@) بفتحتين وسكون الباء الموحدة ونون إلى وهبن قرية بالري.(@)(@@)(@@)(@@) $DIC_NIS$ الوهبي (@)(@@) بالفتح والسكون إلى وهب جد وبطن من كندة.(@)(@@)(@@)(@@) $DIC_NIS$ الوهراني (@)(@@) بالفتح والسكون وراء إلى وهران مدينة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الوهطي (@)(@@) كذلك إلى الوهط قرية بنواحي مكة شرفها الله تعالى.(@)(@@)(@@)(@@) || باب الواو واللام ألف(@)(@@)(@@)(@@) $DIC_NIS$ الولادي (@)(@@) بالفتح والتشديد ومهملة إلى ولاد قرية بأصبهان ظنا قلت: وجد ابن ولاد النحوي انتهى وبالكسر والتخفيف إلى ولاد بن أد بن طابخة. PageV01P276(@)(@@)(@@)(@@) $DIC_NIS$ الولاشجردي (@)(@@) بالفتح والتخفيف وسكون المعجمة والراء وكسر الجيم ودال مهملة إلى ولاشجرد قرية بين همذان وكرمان.(@)(@@)(@@)(@@) || باب الواو والياء(@)(@@)(@@)(@@) $DIC_NIS$ الويبودي (@)(@@) بالكسر وفتح الموحدة بين تحتية وواو ساكنتين ثم مهملة إلى ويبودا قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ الوبذاباذي (@)(@@) بالكسر وذالين معجمتين وموحدة إلى ويذاباذ محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ الويمي (@)(@@) بالكسر والسكون إلى ويمة بلد بين الري وطبرستان.(@)(@@)(@@)(@@) | حرف الهاء(@)(@@)(@@)(@@) || باب الهاء والألف(@)(@@)(@@)(@@) $DIC_NIS$ الهاروتي (@)(@@) بفوقية إلى هاروت قرية بواسط وبنون إلى الهارونية قرية بسواد العراق وإلى هارون جد.(@)(@@)(@@)(@@) $DIC_NIS$ الهالي (@)(@@) إلى هالة بن أبي هالة.(@)(@@)(@@)(@@) $DIC_NIS$ الهاشمي (@)(@@) إلى هاشم بن عبد مناف.(@)(@@)(@@)(@@) $DIC_NIS$ الهالكي (@)(@@) إلى الهالك بن عمرو بن أسد بن خزيمة.(@)(@@)(@@)(@@) || باب الهاء والباء(@)(@@)(@@)(@@) $DIC_NIS$ الهباري (@)(@@) بالفتح وتشديد الموحدة وراء إلى الهبار جد والهبارية جدة.(@)(@@)(@@)(@@) $DIC_NIS$ الهبراثاني (@)(@@) بالكسر والسكون وراء ومثلثة إلى هبراثان قرية بدهستان.(@)(@@)(@@)(@@) $DIC_NIS$ الهبرتائي (@)(@@) بفتحتين وسكون الراء وفوقية إلى هبرتا قرية بدهستان قال ابن الأثير رحمه الله تعالى: هو الذي قبله.(@)(@@)(@@)(@@) || باب الهاء والجيم(@)(@@)(@@)(@@) $DIC_NIS$ الهجري (@)(@@) بفتحتين إلى هجر بلد باليمن.(@)(@@)(@@)(@@) $DIC_NIS$ الهجيمي (@)(@@) مصغرا إلى بني الهجيم بطن من تميم ومحلة لهم بالبصرة.(@)(@@)(@@)(@@) || باب الهاء والدال(@)(@@)(@@)(@@) $DIC_NIS$ الهدادي (@)(@@) بالفتح وتخفيف المهملتين إلى هداد بطن من الأزد. 
ms165	(@)(@@)(@@)(@@) $DIC_NIS$ الهدلي (@)(@@) بالفتح والسكون إلى الهدل أخوة قريظة. PageV01P277(@)(@@)(@@)(@@) $DIC_NIS$ الهدوي (@)(@@) بفتحتين إلى هدا ناحية بمكة شرفها الله تعالى من جهة الطائف.(@)(@@)(@@)(@@) $DIC_NIS$ الهدهادي (@)(@@) بالفتح والسكون إلى هدهاد جد.(@)(@@)(@@)(@@) $DIC_NIS$ الهديري (@)(@@) مصغرا إلى الهدير جد.(@)(@@)(@@)(@@) $DIC_NIS$ الهدي (@)(@@) بالضم والتشديد إلى هدة جد.(@)(@@)(@@)(@@) || باب الهاء والذال(@)(@@)(@@)(@@) $DIC_NIS$ الهذلي (@)(@@) بالضم وفتح المعجمة إلى هذيل بن مدركة بن الياس بن مضر بن نزار.(@)(@@)(@@)(@@) $DIC_NIS$ الهذمي (@)(@@) بفتحتين إلى هذمة بطن من طيء وبالضم والفتح إلى سعد هذيم من قضاعة وهذيم بطن من كلب.(@)(@@)(@@)(@@) || باب الهاء والراء(@)(@@)(@@)(@@) $DIC_NIS$ الهرابي (@)(@@) بالفتح وتشديد الراء وموحدة إلى هراب بطن من سامة بن لؤي.(@)(@@)(@@)(@@) $DIC_NIS$ الهرثي (@)(@@) بالضم والسكون ومثلثة إلى هرث قرية بواسط.(@)(@@)(@@)(@@) $DIC_NIS$ الهرشي (@)(@@) بالفتح والسكون ومعجمة إلى الهرش جد.(@)(@@)(@@)(@@) $DIC_NIS$ الهرفي (@)(@@) بوزنه وفاء إلى هرفة جد.(@)(@@)(@@)(@@) $DIC_NIS$ الهرمزغندي (@)(@@) بضم الهاء والميم وسكون الراء والزاي والنون وفتح الغين المعجمة قبلها وبعدها مهملة إلى هرمزغندا قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الهرمزفرهي (@)(@@) بوزنه وفاء بعدها راء إلى هرمزفرة قرية بمرو.(@)(@@)(@@)(@@) $DIC_NIS$ الهرمي (@)(@@) بالفتح والسكون إلى هرمة بطن من فهر وبالكسر إلى هرم بطن من قضاعة.(@)(@@) الهرواني والهروي: بفتحتين إلى هراة مدينة بخراسان.(@)(@@)(@@)(@@) || باب الهاء والزاي (@)PageV01P278(@)(@@)(@@)(@@) $DIC_NIS$ الهزارسبي (@)(@@) بفتح الهاء والزاي والراء وسكون المهملة وموحدة إلى هزارسب قلعة بخوارزم.(@)(@@)(@@)(@@) $DIC_NIS$ الهزاني (@)(@@) بالكسر والزاي المشددة إلى هزان بطن من العتيك.(@)(@@)(@@)(@@) $DIC_NIS$ الهزمي (@)(@@) بالفتح والسكون إلى هزمة جد وبالضم والفتح إلى هزم جد.(@)(@@)(@@)(@@) $DIC_NIS$ الهزيلي (@)(@@) مصغرا إلى هزيلة امرأة وبالميم إلى هزيم بطن من حمير.(@)(@@)(@@)(@@) || باب الهاء والسين(@)(@@)(@@)(@@) $DIC_NIS$ الهسنجاني (@)(@@) بكسر الهاء والمهملة وسكون النون الأولى وجيم إلى هسنجان قرية بالري.(@)(@@)(@@)(@@) || باب الهاء والشين(@)(@@)(@@)(@@) $DIC_NIS$ الهشامي (@)(@@) إلى هشام رجل.(@)(@@)(@@)(@@) || باب الهاء والفاء(@)(@@)(@@)(@@) $DIC_NIS$ الهفاني (@)(@@) بالكسر وتشديد الفاء إلى هفان بطن من بني حنيفة.(@)(@@)(@@)(@@) || باب الهاء والكاف(@)(@@)(@@)(@@) $DIC_NIS$ الهكاري (@)(@@) بالفتح والتشديد وراء إلى الهكارية ولاية من أعمال الموصل.(@)(@@)(@@)(@@) || باب الهاء واللام(@)(@@)(@@)(@@) $DIC_NIS$ الهلجي (@)(@@) بفتحتين إلى هلجة جد.(@)(@@)(@@)(@@) || باب الهاء والميم(@)(@@)(@@)(@@) $DIC_NIS$ الهماني (@)(@@) بالضم ونون إلى همان قرية بسواد بغداد.(@)(@@)(@@)(@@) $DIC_NIS$ الهمداني (@)(@@) بالفتح والسكون ومهملة إلى همدان شعب 
ms166	 عظيم من قحطان وبفتح الميم ومعجمة إلى همذان مدينة بالجبال.(@)(@@)(@@)(@@) $DIC_NIS$ الهميمي (@)(@@) مصغرا إلى هميم بطن من أسد بن ربيعة بن نزار ومن اليمن ومن بلي.(@)(@@)(@@)(@@) || باب الهاء والنون (@)PageV01P279(@)(@@)(@@)(@@) $DIC_NIS$ الهنائي (@)(@@) بالضم إلى هناءة بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ الهنبي (@)(@@) بالكسر والسكون وموحدة إلى هنب بطن من ربيعة.(@)(@@)(@@)(@@) $DIC_NIS$ الهنتاتي (@)(@@) بالكسر والسكون وفوقيتين بينهما ألف إلى هنتاتة قبيلة من البربر بالغرب.(@)(@@)(@@)(@@) $DIC_NIS$ الهندواني (@)(@@) بالكسر وضم المهملة إلى باب هندوان محلة ببلخ.(@)(@@)(@@)(@@) $DIC_NIS$ الهندي (@)(@@) إلى بلاد الهند وإلى بني هند بطن من شيبان ومن عذرة.(@)(@@)(@@)(@@) $DIC_NIS$ الهنوي (@)(@@) بفتحتين إلى هنا بطن من قضاعة.(@)(@@)(@@)(@@) $DIC_NIS$ الهني (@)(@@) بكسرتين إلى هني بطن من طيء.(@)(@@)(@@)(@@) || باب الهاء والواو(@)(@@)(@@)(@@) $DIC_NIS$ الهوذي (@)(@@) بالضم ومعجمة إلى هوذ بطن من عذرة.(@)(@@)(@@)(@@) $DIC_NIS$ الهورقاني (@)(@@) بالضم وسكون الواو وفتح الراء والقاف إلى هورقان قرية بسنج.(@)(@@)(@@)(@@) $DIC_NIS$ الهرزني (@)(@@) بفتح الهاء والزاي إلى هوزن بطن PageV01P280 من ذي الكلاع.(@)(@@)(@@)(@@) || باب الهاء واللام والياء(@)(@@)(@@)(@@) $DIC_NIS$ الهياني (@)(@@) إلى هيان قرية بجرجان.(@)(@@)(@@)(@@) $DIC_NIS$ الهيتي (@)(@@) بالكسر وتحتية وفوقية إلى هيت مدينة على الفرات.(@)(@@)(@@)(@@) $DIC_NIS$ الهيذامي (@)(@@) بفتح الهاء والمعجمة إلى الهيذام بطن من تميم.(@)(@@)(@@)(@@) $DIC_NIS$ الهيساني (@)(@@) بوزنه بمهملة إلى هيسان قرية بأصبهان.(@)(@@)(@@)(@@) | حرف اللام ألف(@)(@@)(@@)(@@) || باب اللام ألف والحاء(@)(@@)(@@)(@@) $DIC_NIS$ اللاحقي (@)(@@) إلى لاحق جد.(@)(@@)(@@)(@@) || باب اللام ألف والذال(@)(@@)(@@)(@@) $DIC_NIS$ اللاذقي (@)(@@) بكسر المعجمة وقاف إلى اللاذقية مدينة بساحل بحر الشام.(@)(@@)(@@)(@@) || باب اللام ألف والراء(@)(@@)(@@)(@@) $DIC_NIS$ اللارجاني (@)(@@) بفتح الراء والجيم إلى اللارجان بلد بين الري وطبرستان.(@)(@@)(@@)(@@) $DIC_NIS$ اللارزي (@)(@@) بكسر الراء وزاي إلى لارز قرية بطبرستان.(@)(@@)(@@)(@@) || باب اللام ألف والزاي(@)(@@)(@@)(@@) $DIC_NIS$ اللازي (@)(@@) بزاي إلى اللاز قرية بخواف وبراء إلى اللاز جزيرة.(@)(@@)(@@)(@@) || باب اللام ألف والسين(@)(@@)(@@)(@@) $DIC_NIS$ اللاسكي (@)(@@) بفتح المهملة إلى لاسك نوع من الثياب بمازندران.(@)(@@)(@@)(@@) || باب اللام ألف والعين(@)(@@)(@@)(@@) $DIC_NIS$ اللعبي (@)(@@) بكسر المهملة وموحدة إلى لاعب جد.(@)(@@)(@@)(@@) || باب اللام ألف والكاف(@)(@@)(@@)(@@) $DIC_NIS$ اللاكمائي (@)(@@) بضم الكاف إلى لاكمان قرية بمرو.(@)(@@)(@@)(@@) || باب اللام ألف واللام(@)(@@)(@@)(@@) $DIC_NIS$ اللالكائي (@)(@@) بفتح اللام آخره همزة إلى بيع اللوالك التي تلبس في الرجل. PageV01P281(@)(@@)(@@)(@@) $DIC_NIS$ اللاآل (@)(@@) بمد الهمزة قبل اللام الثانية 
ms167	 إلى بيع اللؤلؤ.(@)(@@)(@@)(@@) $DIC_NIS$ اللالوي (@)(@@) إلى لالويه جد.(@)(@@)(@@)(@@) || باب اللام ألف والميم(@)(@@)(@@)(@@) $DIC_NIS$ اللامشي (@)(@@) بكسر الميم ومعجمة إلى لامش قرية بفرغانة.(@)(@@)(@@)(@@) $DIC_NIS$ اللامي (@)(@@) إلى لام جد.(@)(@@)(@@)(@@) || باب اللام ألف والهمزة(@)(@@)(@@)(@@) $DIC_NIS$ اللائي (@)(@@) بهمزة إلى لأي بطن من فزارة.(@)(@@)(@@)(@@) || باب اللام ألف والهاء(@)(@@)(@@)(@@) $DIC_NIS$ اللاهزي (@)(@@) بكسر الهاء وزاي إلى لاهز رجل.(@)(@@)(@@)(@@) $DIC_NIS$ اللاهفي (@)(@@) إلى اللاهف من يتلهف على ما فات.(@)(@@)(@@)(@@) | حرف الياء(@)(@@)(@@)(@@) || باب الياء والألف(@)(@@)(@@)(@@) $DIC_NIS$ اليابسي (@)(@@) بكسر الموحدة ومهملة إلى أبي اليابس جد ووادي اليابس موضع بالشام وجزيرة يابسة بالأندلس.(@)(@@)(@@)(@@) $DIC_NIS$ الياركثي (@)(@@) بسكون الراء وفتح الكاف ومثلثة إلى ياركث قرية بأسروشنة.(@)(@@)(@@)(@@) $DIC_NIS$ الياسري (@)(@@) بكسر المهملة وراء إلى عمار بن ياسر والياسرية قرية ببغداد.(@)(@@)(@@)(@@) $DIC_NIS$ اليافعي (@)(@@) بكسر الفاء ومهملة إلى يافع بطن من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ اليافوني (@)(@@) بضم الفاء ونون إلى يافا مدينة بساحل الشام وبقاف وفوقية إلى بيع الياقوت.(@)(@@)(@@)(@@) $DIC_NIS$ الياموري (@)(@@) براء إلى يامور قرية بالأنبار.(@)(@@)(@@)(@@) $DIC_NIS$ اليامي (@)(@@) إلى يام بطن من همدان. PageV01P282(@)(@@)(@@)(@@) $DIC_NIS$ الياني (@)(@@) بنون إلى يانة جد.(@)(@@)(@@)(@@) || باب الياء والتاء(@)(@@)(@@)(@@) $DIC_NIS$ ليتاخي (@)(@@) بفتح أوله وفوقية ومعجمة.(@)(@@)(@@)(@@) || باب الياء والثاء(@)(@@)(@@)(@@) $DIC_NIS$ اليثربي (@)(@@) بالفتح وسكون المثلثة وكسر الراء وموحدة إلى يثرب وهي أرض المدينة.(@)(@@)(@@)(@@) $DIC_NIS$ اليثيعي (@)(@@) بالضم وفتح المثلثة وسكون التحتية ومهملة إلى يثيع بطن من الأزد.(@)(@@)(@@)(@@) || باب الياء والحاء(@)(@@)(@@)(@@) $DIC_NIS$ اليحصبي (@)(@@) بالفتح وسكون الحاء وكسر الصاد المهملتين وموحدة إلى يحصب قبيلة من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ اليحمدي (@)(@@) بفتح أوله والميم وسكون المهملة بينهما آخره مهملة إلى يحمد بطن من الأزد.(@)(@@)(@@)(@@) $DIC_NIS$ اليحيوي (@)(@@) بفتح التحتيتين يحيويه جد.(@)(@@)(@@)(@@) || باب الياء والخاء(@)(@@)(@@)(@@) $DIC_NIS$ اليخامري (@)(@@) بالضم ومعجمة وكسر الميم وراء إلى يخامر رجل.(@)(@@)(@@)(@@) || باب الياء والذال(@)(@@)(@@)(@@) $DIC_NIS$ اليذخكثي (@)(@@) بالفتح وضم الذال وسكون الخاء المعجمتين وفتح الكاف ومثلثة إلى يذخكث قرية بفرغانة.(@)(@@)(@@)(@@) || باب الياء والراء(@)(@@)(@@)(@@) $DIC_NIS$ اليربوعي (@)(@@) بالفتح وسكون الراء وضم الموحدة ومهملة إلى يربوع بطن من بني تميم ومن هوازن ومن ذبيان.(@)(@@)(@@)(@@) $DIC_NIS$ اليرموكي (@)(@@) بوزنه إلى اليرموك موضع بالشام.(@)(@@)(@@)(@@) $DIC_NIS$ اليرغاني (@)(@@) بالفتح والسكون ومعجمة إلى يرغان جد.(@)(@@)(@@)(@@) || باب الياء والزاي (@)PageV01P283(@)(@@)(@@)(@@) $DIC_NIS$ اليزداذي (@)(@@) بالفتح وسكون الزاي ومهملة 
ms168	 ومعجمة إلى يزداذ جد.(@)(@@)(@@)(@@) $DIC_NIS$ اليزدي (@)(@@) بالفتح والسكون ومهملة إلى يزد مدينة بإصطخر.(@)(@@)(@@)(@@) $DIC_NIS$ اليزني (@)(@@) بفتحتين ونون إلى ذي يزن بطن من حمير.(@)(@@)(@@)(@@) $DIC_NIS$ اليزيدي (@)(@@) إلى يزيد جد.(@)(@@)(@@)(@@) || باب الياء والسين(@)(@@)(@@)(@@) $DIC_NIS$ اليسارغي (@)(@@) بفتح الياء والمهملة والراء ومعجمة إلى يسارغ بن يهوذ بن يعقوب عليه السلام.(@)(@@)(@@)(@@) $DIC_NIS$ اليساري (@)(@@) إلى يسار رجل.(@)(@@)(@@)(@@) $DIC_NIS$ اليسيركثي (@)(@@) بفح أوله والكاف وكسر المهملة وسكون التحتية والراء آخره مثلثة إلى يسيركث قرية بسمرقند.(@)(@@)(@@)(@@) || باب الياء والشين(@)(@@)(@@)(@@) $DIC_NIS$ اليشكري (@)(@@) بالفتح وسكون المعجمة وضم الكاف وراء إلى يشكر بن وائل بن قاسط.(@)(@@)(@@)(@@) || باب الياء والعين(@)(@@)(@@)(@@) $DIC_NIS$ اليعقوبي (@)(@@) إلى يعقوب جد.(@)(@@)(@@)(@@) $DIC_NIS$ اليعمري (@)(@@) بفتح أوله والميم وسكون المهملة آخره راء إلى يعمر بطن من كنانة.(@)(@@)(@@)(@@) || باب الياء والغين(@)(@@)(@@)(@@) $DIC_NIS$ اليغلبي (@)(@@) بفتح الياء واللام وسكون الغين المعجمة آخره موحدة إلى يغلب جد.(@)(@@)(@@)(@@) $DIC_NIS$ اليغنوي (@)(@@) بفتح الياء النون وسكون المهملة إلى يغنى قرية بنسف.(@)(@@)(@@)(@@) || باب الياء والفاء(@)(@@)(@@)(@@) $DIC_NIS$ اليفتلي (@)(@@) بفتح الياء والفوقية وسكون الفاء إلى يفتل بلد بطخارستان.(@)(@@)(@@)(@@) $DIC_NIS$ اليفرني (@)(@@) بفتح الياء والراء وضم الفاء آخره نون إلى يفرن قبيلة من البربر بالغرب.(@)(@@)(@@)(@@) || باب الياء والقاف(@)(@@)(@@)(@@) $DIC_NIS$ اليقطيني (@)(@@) إلى يقطين بلفظ القرع.(@)(@@)(@@)(@@) || باب الياء والميم(@)(@@)(@@)(@@) $DIC_NIS$ اليمابرتي (@)(@@) بفتح أوله والموحدة وسكون الراء وفوقية إلى يمابرت محلة بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ اليمامي (@)(@@) إلى اليمامة مدينة بالبادية وبالنون إلى اليمن كاليمني.(@)(@@)(@@)(@@) $DIC_NIS$ اليميني (@)(@@) إلى يمين جد.(@)(@@)(@@)(@@) || باب الياء والنون (@)PageV01P284(@)(@@)(@@)(@@) $DIC_NIS$ الينبعي (@)(@@) بالفتح وسكون النون وضم الموحدة ومهملة إلى ينبع قرية المدينة المنورة.(@)(@@)(@@)(@@) $DIC_NIS$ اليندهي (@)(@@) بفتح أوله والمهملة وسكون النون إلى قرية من عمل مرو الروذ.(@)(@@)(@@)(@@) || باب الياء والواو(@)(@@)(@@)(@@) $DIC_NIS$ اليواني (@)(@@) بالفتح ونون إلى يوان قرية بأصبهان.(@)(@@)(@@)(@@) $DIC_NIS$ اليوخسوني (@)(@@) بضم أوله والمهملة وسكون الخاء المعجمة إلى يوخسون قرية ببخارى.(@)(@@)(@@)(@@) $DIC_NIS$ اليوذوي (@)(@@) بالضم وفتح المعجمة إلى يوذى قرية بنسف ويقال إليها يوذي.(@)(@@)(@@)(@@) $DIC_NIS$ اليوسفي (@)(@@) إلى أبي يوسف جد.(@)(@@)(@@)(@@) $DIC_NIS$ اليوغنكي (@)(@@) بالضم وفتح المعجمة وسكون النون إلى يوغنك قرية بسمرقند.(@)(@@)(@@)(@@) $DIC_NIS$ اليوغي (@)(@@) بالضم ومعجمة إلى يوغة جد.(@)(@@)(@@)(@@) $DIC_NIS$ اليونارتي (@)(@@) بالضم ونون وسكون الراء وفوقية إلى يونارت قرية بأصبهان. 
ms169	(@)(@@)(@@)(@@) $DIC_NIS$ اليوناني (@)(@@) بفتح الياء واشتهر على الألسنة ضمها إلى يونان بن يافث بن نوح عليه السلام.(@)(@@)(@@)(@@) $DIC_NIS$ اليونسي (@)(@@) إلى يونس رجل.(@)(@@)(@@)(@@) || باب الياء والهاء(@)(@@)(@@)(@@) $DIC_NIS$ اليهودي (@)(@@) إلى درب اليهود ببغداد.(@)(@@)(@@)(@@) || باب الياء والياء(@)(@@)(@@)(@@) $DIC_NIS$ الييثعي (@)(@@) بفتح أوله وسكون التحتية أيضا وفتح المثلثة ومهملة إلى ييثع بن الهون بن خزيمة بن مدركة بن الياس بن مضر بن نزار.(@)(@@) وهذا آخر الكتاب ولله الحمد والمنة. PageV01P285(@)(@@)(@@)(@@) |PARATEXT|(@)(@@) [تم تم تم](@)(@@) قال مختصره الإمام العالم العلامة أبو الفضل جلال الدين السيوطي الشافعي رحمه الله تعالى رحمة واسعة اختصرته في عشرة أيام متوالية آخرها يوم الاثنين سابع عشر شهر صفر سنة ثلاث وسبعين وثنانمائة من نسخة صحيحة مقابلة على أصل ابن الأثير وفي آخرها ما نصه فرغ منه مؤلفه يوم الثلاثاء لعشر بقين من شهر جمادى الأولى سنة خمس عشرة وستمائة قال: وكنت عازما على استقصاء ما فات ابن السمعاني رحمه الله فاتفق أن الكتاب نسخ وسار في البلاد فلم أر أن أفسده فاقتصرت على هذا القدر قال مختصره رحمه الله: وقد استقصيت أنا في هذا المختصر كثيرا مما فاتهما واستدركت منه جمعا جما وغالب ما زدته من معجم البلدان لياقوت الحميري رحمهم الله تعالى أجمعين. PageV01P286 
ms170	