ms81	 برهاني % % 24(@)(@@) % لئن اجتبتني من رضاك معونة % % حتى تقوى أيدها إيماني % % 25(@)(@@) % لأسبحنك بكرة وعشية % % ولتخدمنك في الدجى أركاني % % 26(@)(@@) % ولأذكرنك قائما أو قاعدا % % ولأشكرنك سائر الأحيان % % 27(@)(@@) % ولأكتمن عن البرية خلتي % % ولاشكون إليك جهد زماني % % 28(@)(@@) % ولأقصدنك في جميع حوائجي % % من دون قصد فلانة وفلان % % 29(@)(@@) % ولأحسمن عن الأنام مطامعي % % بحسام يأس لم تشبه بناني % % 30(@)(@@) % ولأجعلن رضاك أكبر همتي % % ولأضربن من الهوى شيطاني % % PageV01P245 31(@)(@@) % ولأكسون عيوب نفسي بالتقى % % ولأقبضن عن الفجور عناني % % 32(@)(@@) % ولأمنعن النفس عن شهواتها % % ولأجعلن الزهد في أعواني % % 33(@)(@@) % ولأتلون حروف وحيك في الدجى % % ولأحرقن بنوره شيطاني % % 34(@)(@@) % أنت الذي يا رب قلت حروفه % % ووصفته بالوعظ والتبيان % % 35(@)(@@) % ونظمته ببلاغة أذلية % % تكييفها يخفي على الأذهان % % 36(@)(@@) % وكتبت في اللوح الحفيظ حروفه % % من قبل خلق الخلق في أزمان % % 37(@)(@@) % فالله ربي لم يزل متكما % % حقا إذا ما شاء ذو إحسان % % 38(@)(@@) % نادى بصوت حين كلم عبده % % موسى فأسمعه بلا كتمان % % 39(@)(@@) % وكذا ينادي في القيامة ربنا % % جهرا فيسمع صوته الثقلان % % 40(@)(@@) % أن يا عبادي انصتوا لي واسمعوا % % قول الإله المالك الديان % % PageV01P246 41(@)(@@) % هذا حديث نبينا عن ربه % % صدقا بلا كذب ولا بهتان % % 42(@)(@@) % لسنا نشبه صوته بكلامنا % % إذ ليس يدرك وصفه بعيان % % 43(@)(@@) % لا تحصر الأوهام مبلغ ذاته % % أبدا ولا يحويه قطر مكان % % 44(@)(@@) % وهو المحيط بكل شيء علمه % % من غير إغفال ولا نسيان % % 45(@)(@@) % من ذا يكيف ذاته وصفاته % % وهو القديم مكون الأكوان % % 46(@)(@@) % سبحانه ملكا على العرش استوى % % وحوى جميع الملك والسلطان % % 47(@)(@@) % وكلامه القرآن انزل آية % % وحيا على المبعوث من عدنان % % 48(@)(@@) % صلى عليه الله خير صلاته % % مالاح في فلكيها القمران % % 49(@)(@@) % هو جاء بالقرآن من عند الذي % % لا تعتريه نوائب الحدثان % % 50(@)(@@) % تنزيل رب العالمين ووحيه % % بشهادة الأحبار والرهبان % % PageV01P247 51(@)(@@) % وكلام ربي لا يجيء بمثله % % أحد ولو جمعت له الثقلان % % 52(@)(@@) % وهو المصون من الأباطل كلها % % ومن الزيادة فيه والنقصان % % 53(@)(@@) % من كان يزعم أن يباري نظمه % % ويراه مثل الشعر والهذيان % % 54 
ms82	(@)(@@) % فليأت منه بسورة أو آيه % % فإذا رأى النظمين يشتبهان % % 55(@)(@@) % فلينفرد باسم الألوهية وليكن % % رب البرية وليقل سبحاني % % 56(@)(@@) % فإذا تناقض نظمه فليلبسن % % ثوب النقيصة صاغرا بهوان % % 57(@)(@@) % أو فليقر بأنه تنزيل من % % سماه في نص الكتاب مثاني % % 58(@)(@@) % لا ريب فيه بأنه تنزيله % % وبداية التنزيل في رمضان % % 59(@)(@@) % الله فصله وأحكم آيه % % وتلاه تنزيلا بلا ألحان % % 60(@)(@@) % هو قوله وكلامه وخطابه % % بفصاحة وبلاغة وبيان % % PageV01P248 61(@)(@@) % هو حكمه هو علمه هو نوره % % وصراطه الهادي إلى الرضوان % % 62(@)(@@) % جمع العلوم دقيقها وجليلها % % فيه يصول العالم الرباني % % 63(@)(@@) % قصص على خير البرية قصة % % ربي فأحسن أيما إحسان % % 64(@)(@@) % كلماته منظومة وحروفه % % بتمام ألفاظ وحسن معان % % 65(@)(@@) % وأبان فيه حلاله وحرامه % % ونهى عن الآثام والعصيان % % 66(@)(@@) % من قال أن الله خالق قوله % % فقد استحل عبادة الأوثان % % 67(@)(@@) % من قال فيه عبارة وحكاية % % فغدا يجرع من حميم آن % % 68(@)(@@) % من قال أن حروفه مخلوقة % % فالعنه ثم اهجره كل أو أن % % 69(@)(@@) % لا تلق مبتدعا ولا متزندقا % % إلا بعبسة مالك الغضبان % % 70(@)(@@) % والوقف في القرآن خبث باطل % % وخداع كل مذبذب حيران % % PageV01P249 71(@)(@@) % قل غير مخلوق كلام الهنا % % واعجل ولا تك في الإجابة وأنى % % 72(@)(@@) % أهل الشريعة أيقنوا بنزوله % % والقائلون بخلقه شكلان % % 73(@)(@@) % وتجنب اللفظين أن كليهما % % ومقال جهم عندنا سيان % % 74(@)(@@) % يا أيها السنى خذ بوصيتي % % واخصص بذلك جملة الأخوان % % 75(@)(@@) % واقبل وصية مشفق متودد % % واسمع بفهم حاضر يقظان % % 76(@)(@@) % كن في أمورك كلها متوسطا % % عدلا بلا نقص ولا رجحان % % 77(@)(@@) % واعلم بأن الله رب واحد % % متنزه عن ثالث أو ثان % % 78(@)(@@) % الأول المبدى بغير بداية % % والآخر المفنى وليس بفان % % 79(@)(@@) % وكلامه صفة له وجلالة % % منه بلا أمد ولا حدثان % % 80(@)(@@) % ركن الديانة أن تصدق بالقضا % % لا خير في بيت بلا أركان % % PageV01P250 81(@)(@@) % الله قد علم السعادة والشقا % % وهما ومنزلتاهما ضدان % % 82(@)(@@) % لا يملك العبد الضعيف لنفسه % % رشدا ولا يقدر على خذلان % % 83(@)(@@) % سبحان من يجري الأمور بحكمة % % في الخلق بالأرزاق والحرمان % % 84(@)(@@) % نفذت مشيئته 
ms83	 بسابق علمه % % في خلقه عدلا بلا عدوان % % 85(@)(@@) % والكل في أم الكتاب مسطر % % من غير اغفال ولا نقصان % % 86(@)(@@) % فاقصد هديت ولا تكن متغاليا % % إن القدور تفور بالغليان % % 87(@)(@@) % دن بالشريعة والكتاب كليهما % % فكلاهما للدين واسطتان % % 88(@)(@@) % والخير والشريعة والكتاب كليهما % % بجميع ما تأتيه محتفظان % % 89(@)(@@) % ولكل عبد حافظان لكل ما % % يقع الجزاء عليه مخلوقان % % 90(@)(@@) % أمر بكتب كلامه وفعاله % % وهما لأمر الله مؤتمران % % PageV01P251 91(@)(@@) % والله صدق وعده ووعيده % % مما يعاين شخصه العيان % % 92(@)(@@) % والله أكبر أن تحد صفاته % % أو أن يقاس بجملة الأعيان % % 93(@)(@@) % وحياتنا في القبر بعد مماتنا % % حقا ويسألننا به الملكان % % 94(@)(@@) % والقبر صح نعيمه وعذابه % % وكلاهما للناس مدخران % % 95(@)(@@) % والبعث بعد الموت وعد صادق % % باعادة الأرواح في الأبدان % % 96(@)(@@) % وصراطنا حق وحوض نبينا % % صدق له عدد النجوم أواني % % 97(@)(@@) % يسقى بها السنى أعذب شربة % % ويذاد كل مخالف فتان % % 98(@)(@@) % وكذلك الأعمال يومئذ ترى % % موضوعة في كفة الميزان % % 99(@)(@@) % والكتب يومئذ تطايرني الورى % % بشمائل الأيدي وبالإيمان % % 100(@)(@@) % والله يومئذ يجىء لغرضنا % % مع أنه في كل وقت داني % % PageV01P252 101(@)(@@) % والأشعري يقول يأتي أمره % % ويعيب وصف الله بالإتيان % % 102(@)(@@) % والله في القرآن أخبر أنه % % يأتي بغير تنقل وتدان % % 103(@)(@@) % وعليه عرض الخلق يوم معادهم % % للحكم كي يتناصف الخصمان % % 104(@)(@@) % والله يومئذ نراه كما نرى % % قمرا بدا للست بعد ثمان % % 105(@)(@@) % يوم القيامة لو علمت بهوله % % لفررت من أهل ومن أوطان % % 106(@)(@@) % يوم تشققت السماء لهوله % % وتشيب فيه مفارق الولدان % % 107(@)(@@) % يوم عبوس قمطرير شره % % في الخلق منتشر عظيم الشان % % 108(@)(@@) % والجنة العليا ونار جهنم % % داران للخصمين دائمتان % % 109(@)(@@) % يوم يجيء المتقون لربهم % % وفدا على نجب من العقيان % % 110(@)(@@) % ويجيء المجرمون إلى لظى % % يتلمظون تلمظ العطشان % % PageV01P253 111(@)(@@) % ودخول بعض المسلمين جهنما % % بكبائر الآثام والطغيان % % 112(@)(@@) % والله يرحمهم بصحة عقدهم % % ويبدلوا من خوفهم بأمان % % 113(@)(@@) % وشفيعهم عند الخروج بمحمد % % وطهورهم في شاطىء الحيوان % % 114(@)(@@) % حتى إذا ظهروا هنالك ادخلوا % % جنات عدن وهي خير جنان % % 115(@)(@@) % فالله يجمعنا وإياهم بها % % من غير 
ms84	 تعذيب وغير هوان % % 116(@)(@@) % وإذا دعيت إلى أداء فريضة % % فانشط ولا تك في الإجابة واني % % 117(@)(@@) % قم بالصلاة الخمس واعرف قدرها % % فلهن عند الله أعظم شان % % 118(@)(@@) % لا تمنعن زكاة مالك ظالما % % فصلاتنا وزكاتنا اختان % % 119(@)(@@) % والوتر بعد الفرض آكد سنة % % والجمعة والزهراء والعيدان % % 120(@)(@@) % مع كل بر صلها أو فاجر % % مالم يكن في دينه بمشان % % PageV01P254 121(@)(@@) % وصيامنا رمضان فرض واجب % % وقيامنا المسنون في رمضان % % 122(@)(@@) % صلى النبي به ثلاثا رغبة % % وروى الجماعة أنها ثنتان % % 123(@)(@@) % إن التراوح راحة في ليله % % ونشاط كل عويجز كسلان % % 124(@)(@@) % والله ما جعل التراوح منكرا % % إلا المجوس وشيعة الصلبان % % 125(@)(@@) % والحج مفترض عليك وشرطه % % أمن الطريق وصحة الأبدان % % 126(@)(@@) % كبر هديت على الجنائز أربعا % % واسأل لها بالعفو والغفران % % 127(@)(@@) % إن الصلاة على الجنائز عندنا % % فرض الكفاية لا على الأعيان % % 128(@)(@@) % إن الأهلة للأنام مواقت % % وبها يقوم حساب كل زمان % % 129(@)(@@) % لا تفطرن ولا تصم حتى يرى % % شخص الهلال من الورى اثنان % % 130(@)(@@) % متثبتان على الذي يريانه % % حران في نقليهما ثقتان % % PageV01P255 131(@)(@@) % لا تقصدن ليوم شك عامدا % % فتصومه وتقول من رمضان % % 132(@)(@@) % لا تعتقد دين الجهالة أنهم % % أهل المحال وحزبة الشيطان % % 133(@)(@@) % جعلوا الشهور على قياس حسابهم % % ولربما كملا لنا شهران % % 134(@)(@@) % ولربما نقص الذي هو عندهم % % واف وأوفى صاحب النقصان % % 135(@)(@@) % إن الجهالة شر من وطىء الحصى % % من كل أنس ناطق أو جان % % 136(@)(@@) % مدحوا النبي وخونوا أصحابه % % ورموهم بالظلم والعدوان % % 137(@)(@@) % حبوا قرابته وسبوا صحبه % % جدلان عند الله منتقضان % % 138(@)(@@) % فكأنما آل النبي وصحبه % % روح يضم جميعها جسدان % % 139(@)(@@) % فئتان عقدهما شريعة أحمد % % بأبي وأمي ذانك الفئتان % % 140(@)(@@) % فئتان سالكتان في سبل الهدى % % وهما بدين الله قائمتان % % PageV01P256 141(@)(@@) % قل إن خير الأنبياء محمد % % وأجل من يمشي على الكثبان % % 142(@)(@@) % وأجل صحب الرسل صحب محمد % % وكذاك أفضل صحبه العمران % % 143(@)(@@) % رجلان قد خلقا لنصر محمد % % بدمي ونفسي ذانك الرجلان % % 144(@)(@@) % فهما اللذان تظاهرا لنبينا % % في نصره وهما له صهران % % 145(@)(@@) % بنتاهما أسنى نساء نبينا 
ms85	 % % وهما له بالوحي صاحبتان % % 146(@)(@@) % أبواهما أسنى صحابة أحمد % % يا حبذا الأبوان والبنتان % % 147(@)(@@) % وهما وزيراه اللذان هما هما % % لفضائل الأعمال مستبقان % % 148(@)(@@) % وهما لأحمد ناظراه وسمعه % % وبقربه في القبر مضطجعان % % 149(@)(@@) % كانا على الإسلام أشفق أهله % % وهما لدين محمد جبلان % % 150(@)(@@) % أصفاهما أقواهما أخشاهما % % أتقاهما في السر والإعلان % % PageV01P257 151(@)(@@) % أسناهما أزكاهما أعلاهما % % أوفاهم في الوزن والرجحان % % 152(@)(@@) % صديق أحمد صاحب الغار الذي % % هو في المغارة والنبي اثنان % % 153(@)(@@) % أعني أبا بكر الذي لم يختلف % % من شرعنا في فضله رجلان % % 154(@)(@@) % هو شيخ أصحاب النبي وخيرهم % % وإمامهم حقا بلا بطلان % % 155(@)(@@) % وأبو المطهرة التي تنزيهها % % قد جاءنا في النور والفرقان % % 156(@)(@@) % أكرم بعايشة الرضى من حرة % % بكر مطهرة الإزار حصان % % 157(@)(@@) % هي زوج خير الأنبياء وبكره % % وعروسه من جملة النسوان % % 158(@)(@@) % هي عرسه هي أنسه هي ألفه % % هي حبه صدقا بلا ادهان % % 159(@)(@@) % أوليس والدها يصافي بعلها % % وهما بروح الله مؤتلفان % % 160(@)(@@) % لما قضى صديق أحمد نحبه % % دفع الخلافة للإمام الثاني % % PageV01P258 161(@)(@@) % أعني به الفاروق فرق عنوة % % بالسيف بين الكفر والإيمان % % 162(@)(@@) % هو أظهر الإسلام بعد خفائه % % ومحا الظلام وباح بالكتمان % % 163(@)(@@) % ومضى وخلى الأمر شورى بينهم % % في الأمر فاجتمعوا على عثمان % % 164(@)(@@) % من كان يسهر ليله في ركعة وترا % % فيكمل ختمة القرآن % % 165(@)(@@) % ولى الخلافة صهر أحمد بعده % % أعني على العالم الرباني % % 166(@)(@@) % زوج البتول أخا الرسول وركنه % % ليث الحروب منازل الأقران % % 167(@)(@@) % سبحان من جعل الخلافة رتبة % % وبنى الإمامة أيما بنيان % % 168(@)(@@) % واستخلف الأصحاب كي لا يدعى % % من بعد أحمد في النبوة ثاني % % 169(@)(@@) % أكرم بفاطمة البتول وبعلها % % وبمن هما لمحمد سبطان % % 170(@)(@@) % عصنان أصلهما بروضة أحمد % % لله در الأصل والغصنان % % PageV01P259 171(@)(@@) % أكرم بطلحة والزبير وسعدهم % % وسعيدهم وبعابد الرحمن % % 172(@)(@@) % وأبي عبيدة ذي الديانة والتقى % % وامدح جماعة بيعة الرضوان % % 173(@)(@@) % قل خير قول في صحابة أحمد % % وامدح جميع الآل والنسوان % % 174(@)(@@) % دع ما جرى بين الصحابة في الوغى % % بسيوفهم يوم التقى الجمعان % % 175(@)(@@) % فقتيلهم منهم وقاتلهم لهم % % وكلاهما 
ms86	 في الحشر مرحومان % % 176(@)(@@) % والله يوم الحشر ينزع كل ما % % تحوي صدروهم من الأضغان % % 177(@)(@@) % والويل للركب الذين سعوا إلى % % عثمان فاجتمعوا على العصيان % % 178(@)(@@) % ويل لمن قتل الحسين فإنه % % قد باء من مولاه بالخسران % % 179(@)(@@) % لسنا نكفر مسلما بكبيرة % % فالله ذو عفو وذو غفران % % 180(@)(@@) % لا تقبلن من التوارخ كلما % % جمع الرواة وخط كل بنان % % PageV01P260 181(@)(@@) % أرو الحديث المنتقى عن أهله % % سيما ذوى الأحلام والأسنان % % 182(@)(@@) % كابن المسيب والعلاء ومالك % % والليث والزهري أو سفيان % % 183(@)(@@) % واحفظ رواية جعفر بن محمد % % فمكانه فيما أجل مكان % % 184(@)(@@) % واحفظ لأهل البيت واجب حقهم % % واعرف عليا أيما عرفان % % 185(@)(@@) % لا تنتقصه ولا تزد في قدره % % فعليه تصلى النار طائفتان % % 186(@)(@@) % إحداهما لا ترتضيه خليفة % % وتنصه الأخرى الها ثاني % % 187(@)(@@) % والعن زنادقة الجهالة أنهم % % أعناقهم غلت إلى الأذقان % % 188(@)(@@) % جحدوا الشرائع والنبوة واقتدوا % % بفساد ملة صاحب الإيوان % % 189(@)(@@) % لا تركنن إلى الجهالة أنهم % % شتموا الصحابة دون ما برهان % % 190(@)(@@) % لعنوا كما بغضوا صحابة محمد % % وودادهم فرض على الإنسان % % PageV01P261 191(@)(@@) % حب الصحابة والقرابة % % سنة ألقى بها ربي إذا أحياني % % 192(@)(@@) % احذر عقاب الله وارج ثوابه % % حتى تكون كمن له قلبان % % 193(@)(@@) % إيماننا بالله بين ثلاثة % % عمل وقول واعتقاد جنان % % 194(@)(@@) % ويزيد بالتقوى وينقص بالردى % % وكلاهما في القلب يعتلجان % % 195(@)(@@) % وإذا خلوت بريبة في ظلمة % % والنفس داعية إلى الطغيان % % 196(@)(@@) % فاستحى من نظر الإله وقل لها % % إن الذي خلق الظلام يراني % % 197(@)(@@) % كن طالبا للعلم واعمل صالحا % % فهما إلى سبل الهدى سببان % % 198(@)(@@) % لا تتبع علم النجوم فإنه % % متعلق بزخارف الكهان % % 199(@)(@@) % علم النجوم وعلم شرع محمد % % في قلب عبد ليس يجتمعان % % 200(@)(@@) % لو كان علم للكواكب أو قضا % % لم يهبط المريخ في السرطان % % PageV01P262 201(@)(@@) % والشمس في الحمل المضي سريعة % % وهبوطها في كوكب الميزان % % 202(@)(@@) % والشمس محرقة لستة أنجم % % لكنها والبدر ينخسفان % % 203(@)(@@) % ولربما اسودا وغاب ضياهما % % وهما لخوف الله يرتعدان % % 204(@)(@@) % أردد على من يطمئن إليهما % % ويظن أن كليهما ربان % % 205(@)(@@) % يا من يحب المشتري 
ms87	 وعطاردا % % ويظن أنهما له سعدان % % 206(@)(@@) % لم يهبطان ويعلوان تشرفا % % وبوهج حر الشمس يحترقان % % 207(@)(@@) % أتخاف من زحل وترجو المشتري % % وكلاهما عبدان مملوكان % % 208(@)(@@) % والله لو ملكا حياة أوفنا % % لسجدت نحوهما ليصطنعاني % % 209(@)(@@) % وليفسحا في مدتي ويوسعا % % رزقي وبالإحسان يكتنفاني % % 210(@)(@@) % بل كل ذلك في يد الله الذي % % ذللت لعزة وجهه الثقلان % % PageV01P263 211(@)(@@) % فقد استوى زحل ونجم المشتري % % والرأس والذنب العظيم الشان % % 212(@)(@@) % والزهرة الغراء مع مريخها % % وعطارد الوقاد مع كيوان % % 213(@)(@@) % إن قابلت وتربعت وتثلثت % % وتسدست وتلاحقت بقران % % 214(@)(@@) % إلها دليل سعادة أو شقوة % % لا والذي برأ الورى وبراني % % 215(@)(@@) % من قال بالتأثير فهو معطل % % للشرع متبع لقول ثان % % 216(@)(@@) % أن النجوم على ثلاثة أوجه % % فاسمع مقال الناقد الدهقان % % 217(@)(@@) % بعض النجوم خلقن زينا للسما % % كالدر فوق ترائب النسوان % % 218(@)(@@) % وكواكب تهدي المسافر في السرا % % ورجوم كل مثابر شيطان % % 219(@)(@@) % لا يعلم الإنسان ما يقضى غدا % % إذ كل يوم ربنا في شان % % 220(@)(@@) % والله يمطرنا الغيوث بفضله % % لا نوء عواء ولا دبران % % PageV01P264 221(@)(@@) % من قال إن الغيث جاء بهنعة % % أو صرفة أو كوكب الميزان % % 222(@)(@@) % فقد افترى إثما وبهتانا ولم % % ينزل به الرحمن من سلطان % % 223(@)(@@) % وكذا الطبيعة للشريعة ضدها % % ولقل ما يتجمع الضدان % % 224(@)(@@) % وإذا طلبت طبائعا مستسلما % % فاطلب شواظ النار في الغدران % % 225(@)(@@) % علم الفلاسفة الغواة طبيعه % % ومعاد أرواح بلا أبدان % % 226(@)(@@) % لولا الطبيعة عندهم وفعالها % % لم يمش فوق الأرض من حيوان % % 227(@)(@@) % والبحر عنصر كل ماء عندهم % % والشمس أول عنصر النيران % % 228(@)(@@) % والغيث أبخرة تصاعد كلما % % دامت بهطل الوابل الهتان % % 229(@)(@@) % والرعد عند الفيلسوف بزعمه % % صوت اصطكاك السحب في الأعنان % % 230(@)(@@) % والبرق عندهم شواظ خارج % % بين السحاب يضيء في الأحيان % % PageV01P265 231(@)(@@) % كذب أرسطاليسهم في قوله % % هذا وأسرف أيما هذيان % % 232(@)(@@) % الغيث يفرغ في السحاب من السما % % وبكليله ميكال بالميزان % % 233(@)(@@) % لاقطرة إلا وينزل نحوها % % ملك إلى الآكام والفيضان % % 234(@)(@@) % والرعد صيحة مالك وهو اسمه % % يزجى السحاب كسائق الأضعان % % 235(@)(@@) % والبرق شوظ النار يزجرها به % % زجر الحداة 
ms88	 العيس بالقبضان % % 236(@)(@@) % أفكان يعلم ذا أرسطاليسهم % % تدبير ما انفردت به الجهتان % % 237(@)(@@) % % أم غاب تحت الأرض أم صعد السمافرأى بها الملكوت رأى عيان % % 238(@)(@@) % أم كان دبر ليلها ونهارها % % أم كان يعلم كيف يختلفان % % 239(@)(@@) % أم سار بطليموس بين نجومها % % حتى رأى السيار والمتواني % % 240(@)(@@) % أم كان اطلع شمسها وهلالها % % أم هل تبصر كيف يعتقبان % % PageV01P266 241(@)(@@) % أم كان أرسل ريحها وسحابها % % بالغيث يهمل أيما هملان % % 242(@)(@@) % بل كان ذلك حكمة الله الذي % % بقضائه متصرف الأزمان % % 243(@)(@@) % لا تستمع قول الضوارب بالحصا % % والزاجرين الطير بالطيران % % 244(@)(@@) % فالفرقتان كذوبتان على القضا % % وبعلم غيث الله جاهلتان % % 245(@)(@@) % كذب المهندس والمنجم مثله % % فهما لعلم الله مدعيان % % 246(@)(@@) % الأرض عند كليهما كروية % % وهما بهذا القول مقترنان % % 247(@)(@@) % والأرض عند أولي النهى لسطيحة % % بدليل صدق واضح القرآن % % 248(@)(@@) % والله صيرهما فراشا للورى % % وبنى السماء بأحسن البنيان % % 249(@)(@@) % والله أخبر أنها مسطوحة % % وأبان ذلك أيما تبيان % % 250(@)(@@) % أأحاط بالأرض المحيطة علمهم % % أم بالحبال الشمخ الأركان % % PageV01P267 251(@)(@@) % أم يختبرون بطولها وبعرضها % % أم هل هما في القدر مستويان % % 252(@)(@@) % أم فجروا أنهارها وعيونها % % ماء به يروى صدى العشان % % 253(@)(@@) % أم أخرجوا أثمارها ونباتها % % والنخل ذات الطلع والقنوان % % 254(@)(@@) % أم هل لهم علم بعد ثمارها % % أم بأختلاف الطعم والألوان % % 255(@)(@@) % الله أحكم خلق ذلك كله % % صنعا وأتقن أيما اتقان % % 256(@)(@@) % قل للطبيب الفيلسوف بزعمه % % أن الطبيعة علمها برهان % % 257(@)(@@) % أين الطبيعة عند كونك نطفة % % في البطن إذ مشجت به الماآن % % 258(@)(@@) % أين الطبيعة حين عدت عليقة % % في أربعين وأربعين ثواني % % 259(@)(@@) % أين الطبيعة عند كونك مضغة % % في أربعين وقد مضى العددان % % 260(@)(@@) % أترى الطبيعة صورتك مصورا % % بمسامع وانوظر وبنان % % PageV01P268 261(@)(@@) % أترى الطبيعة أخرجتك منكسا % % من بطن أمك وهي الأركان % % 262(@)(@@) % أم فجرت لك باللبان ثديها % % فرضعتها حتى مضى الحولان % % 263(@)(@@) % أم صيرت في والديك محبة % % فهما بما يرضيك مغتبطان % % 264(@)(@@) % يا فيلسوف لقد شغلت عن الهدى % % بالمنطق الرومي واليوناني % % 265(@)(@@) % وشريعة الإسلام أفضل شريعة % % دين النبي الصادق العدناني % % 266 
ms89	(@)(@@) % هو دين رب العالمين وشرعه % % وهو القديم وسيد الأديان % % 267(@)(@@) % هو دين آدم والملائك قبله % % هو دين نوح صاحب الطوفان % % 268(@)(@@) % وله دعا هود النبي وصالح % % وهما لدين الله معتقدان % % 269(@)(@@) % وبه أتى لوط وصاحب مدين % % فكلاهما في الدين مجتهدان % % 270(@)(@@) % هو دين إبراهيم وابنيه معا % % وبه نجا من لفحة النيران % % PageV01P269 271(@)(@@) % وبه حمى الله الذبيح من البلا % % لما فداه بأعظم القربان % % 272(@)(@@) % هو دين يعقوب النبي ويونس % % وكلاهما في الله مبتليان % % 273(@)(@@) % هو دين داوود الخليفة وابنه % % وبه أذل له ملوك الجان % % 274(@)(@@) % هو دين يحيى مع أبيه وأمه % % نعم الصبي وحبذا الشيخان % % 275(@)(@@) % وله دعا عيسى بن مريم قومه % % لم يدعهم لعبادة الصلبان % % 276(@)(@@) % والله أنطقه صبيا بالهدى % % في المهد ثم سما على الصبيان % % 277(@)(@@) % وكمال دين الله شرع محمد % % صلى عليه منزل القرآن % % 278(@)(@@) % الطيب الزاكي الذي لم يجتمع % % يوما على زلل له أبوان % % 279(@)(@@) % الطاهر النسوان والد الذي % % من ظهره الزهراء والحسان % % 280(@)(@@) % وأولو النبوة والهدى ما منهم % % أحد يهودي ولا نصراني % % PageV01P270 281(@)(@@) % بل مسلمون ومؤمنون بربهم % % حنفاء في الإسرار والإعلان % % 282(@)(@@) % ولملة الإسلام خمس عقائد % % والله انطقني بها وهداني % % 283(@)(@@) % لا تعص ربك قائلا أو فاعلا % % فكلاهما في الصحف مكتوبان % % 284(@)(@@) % جمل زمانك بالسكوت فإنه % % زين الحليم وسترة الحيران % % 285(@)(@@) % كن جليس بيتك إن سمعت بفتنة % % وتوق كل منافق فتان % % 286(@)(@@) % أد الفرائض لا تكن متوانيا % % فتكون عند الله شر مهان % % 287(@)(@@) % أدم السواك مع الوضوء فإنه % % مرضي الإله مطهر الأسنان % % 288(@)(@@) % سم الإله لدى الوضوء بينة % % ثم استعذ من فتنة الولهان % % 289(@)(@@) % فأساس أعمال الورى نياتهم % % وعلى الأساس قواعد البنيان % % 290(@)(@@) % أسبغ وضوءك لا تفرك شمله % % فالفور والإسباع مفترضان % % PageV01P271 291(@)(@@) % فإذا انتشقت فلا تبالغ جيدا % % لكنه شم بلا امعان % % 292(@)(@@) % وعليك فرضا غسل وجهك كله % % والماء متبع به الجفنان % % 293(@)(@@) % واغسل يديك إلى المرافق مسبغا % % فكلاهما في الغسل مدخولان % % 294(@)(@@) % وامسح برأسك كله مستوفيا % % والماء ممسوح به الأذنان % % 295(@)(@@) % وكذا التمضمض في وضوئك سنة 
ms90	 % % بالماء ثم تمجه الشفتان % % 296(@)(@@) % والوجه والكفان غسل كليهما % % فرض ويدخل فيهما العظمان % % 297(@)(@@) % غسل اليدين لدى الوضوء نظافة % % أمر النبي بها على استحسان % % 298(@)(@@) % سيما إذا ما قمت في غسق الدجى % % واستيقظت من نومك العينان % % 299(@)(@@) % وكذلك الرجلان غسلهما معا % % فرض ويدخل فيهما الكعبان % % 300(@)(@@) % لا تستمع قول الجهالة أنهم % % من رأيهم أن تمسح الرجلان % % PageV01P272 301(@)(@@) % يتأولون قراءة منسوخة % % بقراءة وهما منزلتان % % 302(@)(@@) % إحداهما نزلت لتنسخ أختها % % لكن هما في الصحف مثبتتان % % 303(@)(@@) % غسل النبي وصحبه أقدامهم % % لم يختلف غسلهم رجلان % % 304(@)(@@) % والسنة البيضاء عند أولي النهي % % في الحكم قاضية على القرآن % % 305(@)(@@) % فإذا استوت رجلاك في خفيهما % % وهما في الأحداث طاهرتان % % 306(@)(@@) % وأردت تجديد الطهارة محدثا % % فتمامها أن يمسح الخفان % % 307(@)(@@) % وإذا أردت طهارة لجنابة % % فلتخلعا ولتغسل القدمان % % 308(@)(@@) % غسل الجنابة في الرقاب أمانة % % فأداؤها من أكمل الإيمان % % 309(@)(@@) % فإذا ابتليت فبادر بغسلها % % لا خير في متثبط كسلان % % 310(@)(@@) % وإذا اغتسلت فكن لجسمك دالكا % % حتى يعم جميعه الكفان % % PageV01P273 311(@)(@@) % وإذا عدمت الماء فكن متيمما % % من طيب ترب الأرض والجدران % % 312(@)(@@) % متيمما صليت أو متوضئا % % فكلاهما في الشرع مجزيتان % % 313(@)(@@) % والغسل فرض والتدلك سنة % % وهما بمذهب مالك فرضان % % 314(@)(@@) % والماء مالم تستحل أوصافه % % بنجاسة أو سائر الأدهان % % 315(@)(@@) % فإذا صغى في لونه أو طعمه % % مع ريحه من جملة الأضغان % % 316(@)(@@) % فهناك سمى طاهرا ومطهرا % % هذان أبلغ وصفه هذان % % 317(@)(@@) % فإذا صفى في لونه أو طعمه % % من حمأة الآبار والغاران % % 318(@)(@@) % جاز الوضوء لنا به وطهورنا % % فاسمع بقلب حاضر يقظان % % 319(@)(@@) % ومتى تمت في الماء نفس لم يجز % % منه الطهور لعلة السيلان % % 320(@)(@@) % إلا إذا كان الغدير مرجرجا % % غدقا بلا كيل ولا ميزان % % PageV01P274 321(@)(@@) % أو كانت الميتات مما لم تسل % % والماء قليل طاب للغسلان % % 322(@)(@@) % والبحر أجمعه طهور ماؤه % % وتحل ميتته من الحيتان % % 323(@)(@@) % إياك نفسك والعدو وكيده % % فكلاهما لأذاك مبتديان % % 324(@)(@@) % واحذر وضوءك مفرطا ومفرطا % % فكلاهما في العلم محذوران % % 325(@)(@@) % فقيل مائك في وضوئك خدعة % % لتعود صحته إلى البطلان 
ms91	 % % 326(@)(@@) % وتعود مغسولاته ممسوحة % % فاحذر غرور المارد الخوان % % 327(@)(@@) % وكثير مائك في وضوئك بدعة % % يدعو إلى الوسواس والمهملان % % 328(@)(@@) % لا تكثرن ولا تقلل واقتصد % % فالقصد والتوفيق مصطحبان % % 329(@)(@@) % وإذا استطبت ففي الحديث ثلاثة % % لم يجزنا حجر ولا حجران % % 330(@)(@@) % من أجل إن لكل مخرج غائط % % شرجا تضم عليه ناحيتان % % PageV01P275 331(@)(@@) % وإذا الأذى قد جاز موضع عادة % % لم يجز إلا الماء بالإمعان % % 332(@)(@@) % نقض الوضوء بقبلة أو لمسة % % أو طول نوم أو بمس ختان % % 333(@)(@@) % أو بولة أو غائط أو نومة % % أو نفخه في السر والإعلان % % 334(@)(@@) % ومن المذى أو الودى كلاهما % % من حيث يبدو البول ينحدران % % 335(@)(@@) % ولربما نفخ الخبيث بمكره % % حتى يضم لنفخه الفخذان % % 336(@)(@@) % وبيان ذلك صوته أو ريحه % % هاتان بينتان صادقتان % % 337(@)(@@) % والغسل فرض من ثلاثة أوجه % % دفق المنى وحيضة النسوان % % 338(@)(@@) % إنزاله في نومة أو يقظة % % حالان للتطهير موجبتان % % 339(@)(@@) % وتطهر الزوجين فرض واجب % % عند الجماع إذا التقى الفرجان % % 340(@)(@@) % فكلاهما إن أنزلا أو اكسلا % % فهما بحكم الشرع يغتسلان % % PageV01P276 341(@)(@@) % واغسل إذا أمذيت فرجك كله % % والأثيان فليس يفترضان % % 342(@)(@@) % والحيض والنفساء أصل واحد % % عند انقطاع الدم يغتسلان % % 343(@)(@@) % وإذا أعادت بعد شهرين الدما % % تلك استحاضة بعا ذي الشهران % % 344(@)(@@) % فلتغتسل لصلاتها وصيامها % % والمستحاضة دهرها نصفان % % 345(@)(@@) % فالنصف تترك صومها وصلاتها % % ودم المحيض وغيره لونان % % 346(@)(@@) % وإذا صفا منها وأشرق لونه % % فصلاتها والصوم مفترضان % % 347(@)(@@) % تفضي الصيام ولا تعيد صلاتها % % إن الصلاة تعود كل زمان % % 348(@)(@@) % فالشرع والقرآن قد حكما به % % بين النساء فليس يطرحان % % 349(@)(@@) % ومتى ترى النفساء طهرا تغتسل % % أولا فغاية طهرها شهران % % 350(@)(@@) % مس النساء على الرجال محرم % % حرث السباخ خسارة الحرثان % % PageV01P277 351(@)(@@) % لا تلق ربك سارقا أو خاثنا % % أو شاربا أو ظالما أو زاني % % 352(@)(@@) % قل إن رجم الزانيين كليهما % % فرض إذا زنيا على الإحصان % % 353(@)(@@) % والرجم في القرآن فرض لازم % % للمحصنين ويجلد البكران % % 354(@)(@@) % والخمر يحرم بيعها وشراؤها % % سيان ذلك عنانا سيان % % 355(@)(@@) % في الشرع والقرآن حرم شربها % % وكلاهما لا شك متبعان 
ms92	 % % 356(@)(@@) % أيقن بأشراط القيامة كلها % % واسمع هديت نصيحتي وبياني % % 357(@)(@@) % كالشمس تطلع من مكان غروبها % % وخروج دجال وهول دخان % % 358(@)(@@) % وخروج يا جوج وما جوج معا % % من كل صقع شاسع ومكان % % 359(@)(@@) % ونزول عيسى قاتلا دجالهم % % يقضي بحكم العدل والإحسان % % 360(@)(@@) % واذكر خروج فيصل ناقة صالح % % يسم الورى بالكفر والإيمان % % PageV01P278 361(@)(@@) % والوحي يرفع والصلاة من الورى % % وهما لعقد الدين واسطتان % % 362(@)(@@) % صل الصلاة الخمس أول وقتها % % إذ كل واحدة لها وقتان % % 363(@)(@@) % قصر الصلاة على المسافر واجب % % وأقل حد القصر مرحلتان % % 364(@)(@@) % كلتاهما في أصل مذهب مالك % % خمسون ميلا نقصها ميلان % % 365(@)(@@) % وإذا المسافر غاب عن أبياته % % فالقصر والإفطار مفعولان % % 366(@)(@@) % وصلاة مغرب شمسنا وصباحنا % % في الحضر والأسفار كاملتان % % 367(@)(@@) % والشمس حين تزول من كبد السما % % فالظهر ثم العصر واجبتان % % 368(@)(@@) % والظهر آخر وقتها متعلق % % بالعصر والوقتان مشتبكان % % 369(@)(@@) % لا تلتفت ما دمت فيها قائما % % واخشع بقلب خائف رهبان % % 370(@)(@@) % وكذا الصلاة غروب شمس نهارنا % % وعشائنا وقتان متصلان % % PageV01P279 371(@)(@@) % والصبح منفرد بوقت منفرد % % لكن لها وقتان مفرودان % % 372(@)(@@) % فجر وأسفار وبين كليهما % % وقت لكل مطول متوان % % 373(@)(@@) % فجر كذوب ثم فجر صادق % % ولربما في العين يشتبهان % % 374(@)(@@) % والظل في الأزمان مختلف كما % % زمن الشتا والصيف مختلفان % % 375(@)(@@) % فاقرأ إذا قرأ الإمام مخافتا % % واسكت إذا ما كان ذا إعلان % % 376(@)(@@) % ولكل سهو سجدتان فصلهما % % قبل السلام وبعده قولان % % 377(@)(@@) % سنن الصلاة مبنية وفروضها % % فاسأل شيوخ الفقه والإحسان % % 378(@)(@@) % فرض الصلاة ركوعها وسجودها % % ما إن تخالف فيهما رجلان % % 379(@)(@@) % تحريمها تكبيرها وخلالها % % تسليمها وكلاهما فرضان % % 380(@)(@@) % والحمد فرض في الصلاة قراتها % % آياتها سبع وهن مثاني % % PageV01P280 381(@)(@@) % في كل ركعات الصلاة معادة % % فيها ببسملة فخذ تبياني % % 382(@)(@@) % وإذا نسيت قراتها في ركعة % % فاستوف ركعتها بغير توان % % 383(@)(@@) % اتبع إمامك خافضا أو رافعا % % فكلاهما فعلان محمودان % % 384(@)(@@) % لا ترفعن قبل الإمام ولا تضع % % فكلاهما أمران مذمومان % % 385(@)(@@) % إن الشريعة سنة وفريضة % % وهما لدين محمد عقدان % % 386(@)(@@) % لكن أذان الصبح عند شيوخنا % % من قبل أن 
ms93	 يتبين الفجران % % 387(@)(@@) % هي رخصة في الصبح لا في غيرها % % من أجل يقظة غافل وسنان % % 388(@)(@@) % أحسن صلاتك راكعا أو ساجدا % % بتطمن وترفق وتدان % % 389(@)(@@) % لا تدخلن إلى صلاتك حاقنا % % فالإحتقان يخل بالأركان % % 390(@)(@@) % بيت من الليل الصيام بنية % % من قبل أن يتميز الخيطان % % PageV01P281 391(@)(@@) % يجزيك في رمضان نية ليلة % % إذ ليس مختلطا بعقد ثان % % 392(@)(@@) % رمضان شهر كامل في غقدنا % % ما حله يوم ولا يومان % % 393(@)(@@) % إلا المسافر والمريض فقد أتى % % تأخير صومهما لوقت ثان % % 394(@)(@@) % وكذاك حمل والرضاع كلاهما % % في فطره لنسائنا عذران % % 395(@)(@@) % عجل بفظرك والسحور مؤخر % % فكلاهما أمران مرغوبان % % 396(@)(@@) % حصن صيامك بالسكوت عن الخنا % % أطبق على عينيك بالأجفان % % 397(@)(@@) % لا تمش ذا وجهين من بين الورى % % شر البرية من له وجهان % % 398(@)(@@) % لا تحسدن أحدا على نعمائه % % إن الحسود لحكم ربك شان % % 399(@)(@@) % لا تسع بين الصاحبين نميمة % % فلأجلها يتباغض الخلان % % 400(@)(@@) % والعين حق غير سابقة لما % % يقضي من الأرزاق والحرمان % % PageV01P282 401(@)(@@) % والسحر كفر فعله لا علمه % % من ههنا يتفرق الحكمان % % 402(@)(@@) % والقتل حد الساحرين إذا هم % % علموا للكفر والطغيان % % 403(@)(@@) % وتحر بر الوالدين فإنه % % فرض عليك وطاعة السلطان % % 404(@)(@@) % لاتخرجن على الإمام محاربا % % ولو أنه رجل من الحبشان % % 405(@)(@@) % ومتى أمرت ببدعة أو زلة % % فاهرب بدينك آخر البلدان % % 406(@)(@@) % الدين رأس المال فاستمسك به % % فضياعه من أعظم الخسران % % 407(@)(@@) % لا تخل بامرأة لديك بريبة % % لو كنت في النساك مثل بنان % % 408(@)(@@) % إن الرجال الناظرين إلى النسا % % مثل الكلاب تطوف باللحمان % % 409(@)(@@) % إن لم تصن تلك اللحوم اسودها % % أكلت بلا عوض ولا أثمان % % 410(@)(@@) % لا تقبلن من النساء مودة % % فقلوبهن سريعة الميلان % % PageV01P283 411(@)(@@) % لا تتركن أحدا بأهلك خاليا % % فعلى النساء تقاتل الإخوان % % 412(@)(@@) % واغضض جفونك عن ملاحظة النسا % % ومحاسن الأحداث والصبيان % % 413(@)(@@) % لا تجعلن طلاق أهلك عرضة % % أن الطلاق لأخبث الإيمان % % 414(@)(@@) % إن الطلاق مع العتاق كلاهما % % قسمان عند الله ممقوتان % % 415(@)(@@) % واحفر لسرك في فؤادك ملحدا % % وادفنه في الأحشاء أي دفان % % 416(@)(@@) % إن الصديق 
ms94	 مع العدو كلاهما % % في السر عند أولي النهي شكلان % % 417(@)(@@) % لا يبدو منك إلى صديقك زلة % % واجعل فؤادك أوثق الخلان % % 418(@)(@@) % لا تحقرن من الذنوب صغارها % % فالقطر منه تدفق الخلجان % % 419(@)(@@) % وإذا نذرت فكن بنذرك موفيا % % فالنذر مثل العهد مسؤولان % % 420(@)(@@) % لا تشغلن بعيب غيرك غافلا % % عن عيب نفسك أنه عيبان % % PageV01P284 421(@)(@@) % لا تفن عمرك في الجدال مخاصما % % إن الجدال يخل بالأديان % % 422(@)(@@) % واحذر مجادلة الرجال فإنها % % تدعو إلى الشحناء والشنآن % % 423(@)(@@) % وإذا اضطرت إلى الجدال ولم تجد % % لك مهربا وتلاقت الصفان % % 424(@)(@@) % فاجعل كتاب الله درعا سابغا % % والشرع سيفك وابد في الميدان % % 425(@)(@@) % والسنة البيضاء دونك جنة % % واركب جواد العزم في الجولان % % 426(@)(@@) % واثبت بصبرك تحت ألوية الهدى % % فالصبر أوثق عدة الإنسان % % 427(@)(@@) % واطعن برمح الحق كل معاند % % لله در الفار الطعان % % 428(@)(@@) % واحمل بسيف الصدق حملة مخلص % % متجرد لله غير جبان % % 429(@)(@@) % واحذر بجهدك مكر خصمك أنه % % كالثعلب البري في الروغان % % 430(@)(@@) % أصل الجدال من السؤال وفرعه % % حسن الجواب بأحسن التبيان % % PageV01P285 431(@)(@@) % لا تلتفت عند السؤال ولا تعد % % لفظ السؤال كلاهما عيبان % % 432(@)(@@) % وإذا غلبت الخصم لا تهزأ به % % فالعجب يخمد جمرة الإحسان % % 433(@)(@@) % فلربما انهزم المحارب عامدا % % ثم انثنى قسطا على الفرسان % % 434(@)(@@) % واسكت إذا وقع الخصوم وقعقعوا % % فلربما المقوك في بحران % % 435(@)(@@) % ولربما ضحك الخصوم لدهشة % % فاثبت ولا تنكل عن البرهان % % 436(@)(@@) % فإذا أطالوا في الكلام فقل لهم % % إن البلاغة لجمت ببيان % % 437(@)(@@) % لا تغضبن إذا سئلت ولا تصح % % فكلاهما خلقان مذمومان % % 438(@)(@@) % وإذا انقلبت عن السؤال مجاوبا % % فكلاهما لا شك منقطعان % % 439(@)(@@) % واحذر مناظر بمجلس خيفة % % حتى تبدل خيفة بأمان % % 440(@)(@@) % ناظرا أديبا منصفا لك عاقلا % % وانصفه أنت بحسب ما تريان % % PageV01P286 441(@)(@@) % ويكون بينكما حكيم حاكما % % عدلا إذا جئتماه تحتكمان % % 442(@)(@@) % كن طول دهرك ساكتا متواضعا % % فهما لكل فضيلة بابان % % 443(@)(@@) % واخلع رداء الكبر عنك فإنه % % لا يستقل بحمله الكتفان % % 444(@)(@@) % كن فاعلا للخير قوالا له % % فالقول مثل الفعل مقترنان % % 445(@)(@@) % من غوث ملهوف وشبعة 
ms95	 جائع % % ودثار عريان وفدية عان % % 446(@)(@@) % فإذا فعلت للخير لا تمنن به % % لا خير في ممتدح منان % % 447(@)(@@) % اشكر على النعماء واصبر للبلا % % فكلاهما خلقان ممدوحان % % 448(@)(@@) % لا تشكون بعلة أو قلة % % فهما لعرض المرء فاضحتان % % 449(@)(@@) % صن حر وجهك بالقناعة إنما % % صون الوجوه مروءة الفتيان % % 450(@)(@@) % بالله ثق وله أنب وبه استعن % % فإذا فعلت فأنت خير معان % % PageV01P287 451(@)(@@) % وإذا عصيت فتب لربك مسرعا % % حذر الممات ولا تقل لم يان % % 452(@)(@@) % وإذا ابتليت بعسرة فاصبر لها % % فالعسر فرد بعده يسران % % 453(@)(@@) % لا تخش بطنك بالطعام تسمنا % % فجسوم أهل العلم غير سمان % % 454(@)(@@) % لا تتبع شهوات نفسك مسرفا % % فالله يبغض عابدا شهواني % % 455(@)(@@) % اقلل طعامك ما استطعت فإنه % % نفع الجسوم وصحة الأبدان % % 456(@)(@@) % واملك هواك بضبط بطنك إنه % % شر الرجال العاجز البطنان % % 457(@)(@@) % ومن استدل لفرجه ولبطنه % % فهما له مع ذا الهوى بطنان % % 458(@)(@@) % حصن التداوي المجاعة والظما % % وهما لفك نفوسنا قيدان % % 459(@)(@@) % اظميء نهارك ترو في دار العلا % % يوما يطول تلهف العطشان % % 460(@)(@@) % حسن الغذاء ينوب عن شرب الدوا % % سيما مع التقليل والإدمان % % PageV01P288 461(@)(@@) % إياك والغضب الشديد على الدوا % % فلربما أفضى إلى الخذلان % % 462(@)(@@) % دبر دواءك قبل شربك وليكن % % متألف الأجزاء والأوزان % % 463(@)(@@) % وتداو بالعسل المصفى واحتجم % % فهما لدائك كله برءان % % 464(@)(@@) % لا تدخل الحمام شبعان الحشا % % لا خير في الحمام للشبعان % % 465(@)(@@) % والنوم فوق السطح من تحت السما % % يفني ويذهب نضرة الأبدان % % 466(@)(@@) % لا تفن عمرك في الجماع فإنه % % يكسو الوجوه بحلة اليرقان % % 467(@)(@@) % احذرك من نفس العجوز وبضعها % % فهما لجسم ضجيعها سقمان % % 468(@)(@@) % عانق من النسوان كل فتية % % أنفاسها كروائح الريحان % % 469(@)(@@) % لا خير في صور المعازف كلها % % والرقص والإيقاع في القضبان % % 470(@)(@@) % إن التقى لربه متنزه % % عن صوت أوتار وسمع أغان % % PageV01P289 471(@)(@@) % وتلاوة القرآن من أهل التقى % % سيما بحسن شجا وحسن بيان % % 472(@)(@@) % أشهى وأوفى للنفوس حلاوة % % من صوت مزمار ونقر مثان % % 473(@)(@@) % وحنينة في الليل أطيب مسمع % % من نغمة النايات والعيدان % % 474(@)(@@) % أعرض عن الدنيا الدنية 
ms96	 زاهدا % % فالزهد عند أولي النهى زهدان % % 475(@)(@@) % زهد عن الدنيا وزهد في الثنا % % طوبى لمن أمسى له الزهدان % % 476(@)(@@) % لا تنتهب مال اليتامى ظالما % % ودع الربا فكلاهما فسقان % % 477(@)(@@) % واحفظ لجارك حقه وذمامه % % ولكل جار مسلم حقان % % 478(@)(@@) % واضحك لضيفك حين ينزل رحله % % إن الكريم يسر بالضيفان % % 479(@)(@@) % وأصل ذوي الأرحام منك وإن جفوا % % فوصالهم خير من الهجران % % 480(@)(@@) % واصدق ولا تحلف بربك كاذبا % % وتحر في كفرة الإيمان % % PageV01P290 481(@)(@@) % وتوق إيمان الغموس فإنها % % تدع الديار بلاقع الحيطان % % 482(@)(@@) % حد النكاح من الحرائر أربع % % فاطلب ذوات الحسن والإحصان % % 483(@)(@@) % لا تنكحن محدة في عدة % % فنكاحها وزناؤها شبهان % % 484(@)(@@) % عدد النساء لها فرائض أربع % % لكن يضم جميعها أصلان % % 485(@)(@@) % تطليق زوج داخل أو موته % % قبل الدخول وبعده سيان % % 486(@)(@@) % وحدودهن على ثلاثة اقرؤ % % أو أشهر وكلاهما جسران % % 487(@)(@@) % وكذاك عدة من توفى زوجها % % سبعون يوما بعدها شهران % % 488(@)(@@) % عدد الحوامل من طلاق أو فنا % % وضع الاجنة صارخا أو فاني % % 489(@)(@@) % وكذاك حكم السقط في إسقاطه % % حكم التمام كلاهما وضعان % % 490(@)(@@) % من لم تحض أو من تقلص حيضها % % قد صح في كلتيهما العددان % % PageV01P291 491(@)(@@) % كلتاهما تبقى ثلاثة أشهر % % حكماهما في النص مستويان % % 492(@)(@@) % عدد الجوار من الطلاق بحيضه % % ومن الوفاة الخمس والشهران % % 493(@)(@@) % فبطلقتين تبين من زوج لها % % لارد إلا بعد زوج ثاني % % 494(@)(@@) % وكذا الحرائر فالثلاث تبينها % % فيحل تلك وهذه زوجان % % 495(@)(@@) % فلتنكحا زوجيهما عن غبطة % % ورضا بلا دلس ولا عصيان % % 496(@)(@@) % حتى إذا امتزج النكاح بدلسة % % فهما مع الزوجين زانيتان % % 497(@)(@@) % إياك والتيس المحلل إنه % % والمستحل لردها تيسان % % 498(@)(@@) % لعن النبي محللا ومحللا % % فكلاهما في الشرع ملعونان % % 499(@)(@@) % لا تضربن أمة ولا عبدا جنى % % فكلاهما بيديك مأسوران % % 500(@)(@@) % اعرض عن النسوان جهدك وانتدب % % لعناق خيرات هناك حسان % % PageV01P292 501(@)(@@) % في جنة طابت وطاب نعيمها % % من كل فاكهة بها زوجان % % 502(@)(@@) % أنهارها تجري لهم من تحتهم % % محفوفة بالنخل والرمان % % 503(@)(@@) % غرفاتها من لؤلؤ وزبرجد % % وقصورها من خالص العقيان % % 504(@)(@@) % قصرت بها للمتقين كواعبا 
ms97	 % % يشبهن بالياقوت والمرجان % % 505(@)(@@) % بيض الوجوه شعورهن حوالك % % حمر الخدود عواتق الأجفان % % 506(@)(@@) % فلج الثغور إذا ابتسمن ضواحكا % % هيف الخصور نواعم الأبدان % % 507(@)(@@) % خضر الثياب ثديهن نواهد % % صفر الحلى عواطر الأردان % % 508(@)(@@) % طوبى لقوم هن أزواج لهم % % في دار عدن في محل أمان % % 509(@)(@@) % يسقون من خمر لذيذ شربها % % بأنامل لاخدام والولدان % % 510(@)(@@) % لو تنظر الحوراء عند وليها % % وهما فويق الفرش متكئان % % PageV01P293 511(@)(@@) % ينتازعان الكأس في أيديهما % % وهما بلذة شربها فرحان % % 512(@)(@@) % ولربما تسقيه كأسا ثانيا % % وكلاهما برضابها حلوان % % 513(@)(@@) % يتحدثان على الأرائك خلوة % % وهما بثوب الوصل مشتملان % % 514(@)(@@) % أكرم بجنات النعيم وأهلها % % إخوان صدق أيما إخوان % % 515(@)(@@) % جيران رب العالمين وحزبه % % أكرم بهم في صفوة الجيران % % 516(@)(@@) % هم يسمعون كلامه ويرونه % % والمقلتان إليه ناظرتان % % 517(@)(@@) % وعليهم فيهما ملابس سندس % % وعلى المفارق أحسن التيجان % % 518(@)(@@) % تيجانهم من لؤلؤ وزبرجد % % أو فضة من خالص العقيان % % 519(@)(@@) % وخواتم من عسجد وأساور % % من فضة كسيت بها الزندان % % 520(@)(@@) % وطعامهم من لحم طير ناعم % % كالبخت يطعم سائر الألوان % % PageV01P294 521(@)(@@) % وصحافهم ذهب ودر فائق % % سبعون ألفا فوق ألف خوان % % 522(@)(@@) % إن كنت مشتاقا لها كلفا بها % % شوق الغريب لرؤية الأوطان % % 523(@)(@@) % كن محسنا فيما استطعت فربما % % تجزي عن الإحسان بالإحسان % % 524(@)(@@) % واعمل لجنات النعيم وطيبها % % فنعيمها يبقى وليس بفان % % 525(@)(@@) % أدم الصيام مع القيام تعبدا % % فكلاهما عملان مقبولان % % 526(@)(@@) % قم في الدجى واتل الكتاب ولا تنم % % إلا كنومة حائر ولهان % % 527(@)(@@) % فلربما تأتي المنية بغتة % % فتساق من فرش إلى الأكفان % % 528(@)(@@) % يا حبذا عينان في غسق الدجى % % من خشية الرحمن باكيتان % % 529(@)(@@) % لا تقذفن المحسنات ولا تقل % % ما ليس تعلمه من البهتان % % 530(@)(@@) % لا تدخلن بيوت قوم حضر % % إلا بنحنحة أو استيذان % % PageV01P295 531(@)(@@) % لا تجزعن إذا دهتك مصيبة % % أن الصبور ثوابه ضعفان % % 532(@)(@@) % فإذا ابتليت بنكبة فاصبر لها % % الله حسبي وحده وكفاني % % 533(@)(@@) % وعليك بالفقه المبين شرعنا % % وفرائض الميراث والقرآن % % 534(@)(@@) % علم الحساب وعلم شرع محمد % % علمان مطلوبان متبعان % % 535(@)(@@) % لولا الفرائض ضاع ميراث الورى 
ms98	 % % وجرى خصام الولد والشيبان % % 536(@)(@@) % لولا الحساب وضربه وكسوره % % لم ينقسم سهم ولا سهمان % % 537(@)(@@) % لا تلتمس علم الكلام فإنه % % يدعو إلى التعطيل والهيمان % % 538(@)(@@) % لا يصحب البدعي إلا مثله % % تحت الدخان تأجج النيران % % 539(@)(@@) % علم الكلام وعلم شرع محمد % % يتغايران وليس يشتبهان % % 540(@)(@@) % أخذوا الكلام عن الفلاسفة الأولى % % جحدوا الشرائع غرة وأمان % % PageV01P296 541(@)(@@) % حملوا الأمور على قياس عقولهم % % فتبلدوا كتبلد الحيران % % 542(@)(@@) % مرجيهم يزري قدريهم % % والفرقتان لدي كافرتان % % 543(@)(@@) % ويسب مختاريهم دوريهم % % والقرمطي ملاعن الرفضان % % 544(@)(@@) % ويعيب كراميهم وهبيهم % % وكلاهما يروى عن ابن أبان % % 545(@)(@@) % لحجاجهم شبه نخال ورونق % % مثل السراب يلوح للظمآن % % 546(@)(@@) % دع أشعريهم ومعتزليهم % % يتناقرون تناقر الغربان % % 547(@)(@@) % كل يقيس بعقله سبل الهدى % % ويتيه تيه الواله الهيمان % % 548(@)(@@) % فالله يجزيهم بما هم أهله % % وله الثنا من قولهم براني % % 549(@)(@@) % من قاس شرع محمد في عقله % % قذفت به الأهواء في غدران % % 550(@)(@@) % لا تفتكر في ذات ربك واعتبر % % فيما به يتصرف الملوان % % PageV01P297 551(@)(@@) % والله ربي ما تكيف ذاته % % بخواطر الأوهام والأذهان % % 552(@)(@@) % امرر أحاديث الصفات كما أتت % % من غير تفسير ولا هذيان % % 553(@)(@@) % هو مذهب الزهري ووافق مالك % % وكلاهما في شرعنا علمان % % 554(@)(@@) % لله وجه لا يحد بصورة % % ولربنا عينان ناظرتان % % 555(@)(@@) % وله يدان كما يقول إلهنا % % ويمينه جلت عن الأيمان % % 556(@)(@@) % كلتا يدي ربي يمين وصفها % % فهما على الثقلين متفقتان % % 557(@)(@@) % كرسيه وسع السموات العلا % % والأرض وهو يعمه القدمان % % 558(@)(@@) % والله يضحك لا كضحك عبيده % % والكيف ممتنع على الرحمن % % 559(@)(@@) % والله ينزل كل آخر ليلة % % لسمائه الدنيا بلا كتمان % % 560(@)(@@) % فيقول هل من سائل فأجيبه % % فأنا القريب أجيب من ناداني % % PageV01P298 561(@)(@@) % حاشا الإله بأن تكيف ذاته % % فالكيف والتمثيل منتفيان % % 562(@)(@@) % والأصل أن الله ليس كمثله % % شيء تعالى الرب ذو الإحسان % % 563(@)(@@) % وحديثه القرآن وهو كلامه % % صوت وحرف ليس يفترقان % % 564(@)(@@) % لسنا نشبه ربنا بعباده % % رب وعبد كيف يشتبهان % % 565(@)(@@) % فالصوت ليس بموجب تجسيمه % % إذ كانت الصفتان تختلفان % % 566(@)(@@) % حركات ألسننا وصوت حلوقنا % % مخلوقة وجميع ذلك فإني 
ms99	 % % 567(@)(@@) % وكما يقول الله ربي لم يزل % % حيا وليس كسائر الحيوان % % 568(@)(@@) % وحياة ربي لم تزل صفة له % % سبحانه من كامل ذي الشان % % 569(@)(@@) % وكذلك صوت الهنا ونداؤه % % حقا أتى في محكم القرآن % % 570(@)(@@) % وحياتنا بحرارة وبرودة % % والله لا يعزى له هذان % % PageV01P299 571(@)(@@) % وقومها برطوبة ويبوسة % % ضدان أزواج هما ضدان % % 572(@)(@@) % سبحان ربي عن صفات عباده % % أو أن يكون مركبا جسداني % % 573(@)(@@) % إني أقول فأنصتوا لمقالتي % % يا معشر الخلطاء والأخوان % % 574(@)(@@) % إن الذي هو في المصاحف مثبت % % بأنامل الأشياخ والشبان % % 575(@)(@@) % هو قول ربي آيه وحروفه % % ومدادنا والرق مخلوقان % % 576(@)(@@) % من قال في القرآن ضد مقالتي % % فالعنه كل إقامة وأذان % % 577(@)(@@) % هو في المصاحف والصدور حقيقة % % أيقن بذلك أيما إيقان % % 578(@)(@@) % وكذا الحروف المستقر حسابها % % عشرون حرفا بعدهن ثماني % % 579(@)(@@) % هي من كلام الله جل جلاله % % حقا وهن أصول كل بيان % % 580(@)(@@) % حاء وميم قول ربي وحده % % من غير أنصار ولا أعوان % % PageV01P300 581(@)(@@) % من قال في القرآن ما قد قاله % % عبد الجليل وشيعة اللحيان % % 582(@)(@@) % فقد افترى كذبا وإثما واقتدى % % بكلاب كلب معرة النعمان % % 583(@)(@@) % خالطتهم حينا فلو عاشرتهم % % لضربتهم بصوارمي ولساني % % 584(@)(@@) % تعس العمى أبو العلاء فإنه % % قد كان مجموعا له العميان % % 585(@)(@@) % ولقد نظمت قصيدتين بهجوه % % أبيات كل قصيدة مئتان % % 586(@)(@@) % والآن أهجو الأشعري وحزبه % % وأذيع ما كتموا من البهتان % % 587(@)(@@) % يا معشر المتكلمين عدوتم % % عدوان أهل السبت في الحيتان % % 588(@)(@@) % كفرتم أهل الشريعة والهدى % % وطعنتم بالبغي والعدوان % % 589(@)(@@) % فلأنصرن الحق حتى أنني % % أسطو على ساداتكم بطعاني % % 590(@)(@@) % الله صيرني عصا موسى لكم % % حتى تلقف إفككم ثعباني % % PageV01P301 591(@)(@@) % بأدلة القرآن أبطل سحركم % % وبه أزلزل كل من لاقاني % % 592(@)(@@) % هو ملجأي هو مدرئي هو منجاي % % من كيد كل منافق خوان % % 593(@)(@@) % إن حل مذهبكم بأرض أجدبت % % أو أصبحت قفرا بلا عمران % % 594(@)(@@) % والله صيرني عليكم نقمة % % ولهتك ستر جميعكم أبقاني % % 595(@)(@@) % أنا في حلوق جميعكم عود الجشا % % أعيى أطبتكم غموض مكاني % % 596(@)(@@) % أنا حية الوادي أنا أسد الشرى % % أنا 
ms100	 مرهف ماضي الغرار يماني % % 597(@)(@@) % بين ابن حنبل وابن إسماعيلكم % % صخط يذيقكم الحميم الآن % % 598(@)(@@) % داريتم علم الكلام تشزرا % % والفقه ليس لكم عليه يدان % % 599(@)(@@) % الفقه مفتقر لخمس دعائم % % لم يجتمع منها لكم ثنتان % % 600(@)(@@) % حلم واتباع لسنة أحمد % % وتقى وكف أذى وفهم معان % % PageV01P302 601(@)(@@) % آثرتم الدنيا على أديانكم % % لا خير في دينا بلا أديان % % 602(@)(@@) % وفتحتم أفواهكم وبطونكم % % فبلعتم الدنيا بغير توان % % 603(@)(@@) % كذبتم أقوالكم بفعالكم % % وحملتم الدنيا على الأديان % % 604(@)(@@) % قراؤكم قد أشبهوا فقهاءكم % % فئتان للرحمن عاصيتان % % 605(@)(@@) % يتكالبان على الحرام وأهله % % فعل الكلاب بجيفة اللحمان % % 606(@)(@@) % يا أشعرية هل شعرتم أنني % % رمد العيون وحكة الأجفان % % 607(@)(@@) % أنا في كبود الأشعرية قرحة % % أربو فأقتل كل من يشناني % % 608(@)(@@) % ولقد برزت إلى كبار شيوخكم % % فصرفت منهم كل من ناواني % % 609(@)(@@) % وقلبت أرض حجاجهم ونثرتها % % فوجدتها قولا بلا برهان % % 610(@)(@@) % والله أيدني وثبت حجتي % % والله من شبهاتهم نجاني % % PageV01P303 611(@)(@@) % والحمد لله المهيمن دائما % % حمدا يلقح فطنتي وجناني % % 612(@)(@@) % أحسبتم يا أشعرية أنني % % ممن يقعقع خلفه بشنان % % 613(@)(@@) % أفتستر الشمس المضيئة بالسها % % أم هل يقاس البحر بالخلجان % % 614(@)(@@) % عمري لقد فتشتكم فوجدتم % % حمرا بلا عنن ولا ارسن % % 615(@)(@@) % أحضرتكم وحشرتكم وقصدتكم % % وكسرتكم كسرا بلا جبران % % 616(@)(@@) % أزعمتم أن القرآن عبارة % % فهما كما تحكون قرآنان % % 617(@)(@@) % إيمان جبريل وإيمان الذي % % ركب المعاصي عندكم سيان % % 618(@)(@@) % هذا الجويهر والعريض بزعمكم % % أهما لمعرفة الهدى أصلان % % 619(@)(@@) % من عاش في الدنيا ولم يعرفهما % % وأقر بالإسلام والفرقان % % 620(@)(@@) % أفمسلم هو عندكم أم كافر % % أم عاقل أم جاهل أو واني % % PageV01P304 621(@)(@@) % عطلتم السبع السموات العلا % % والعرش أخليتم من الرحمن % % 622(@)(@@) % وزعمتم أن البلاغ لأحمد % % في آية من جملة القرآن % % 623(@)(@@) % هذي الشقاشق والمخاوف والهوى % % والمذهب المستحدث الشيطاني % % 624(@)(@@) % سميتم علم الأصول ضلالة % % كأسم النبيذ لخمرة الأدنان % % 625(@)(@@) % ونعت محارمكم على أمثالكم % % والله عنها صانني وحماني % % 626(@)(@@) % أني اعتصمت بحبل شرع محمد % % وعضضته بنواجذ الأسنان % % 627(@)(@@) % أشعرتم يا أشعرية أنني % % طوفان بحر أيما طوفان % % 628(@)(@@) % أنا همكم أنا 