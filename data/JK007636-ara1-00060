ms56	 تكليفهم لي مهرب % % 54(@)(@@) % طلبوا في أرجلي شيئا وقد % % نقبوا رأسا بما قد طلبوا % % 55(@)(@@) % أشكو لأنعمك التي % % هي للعفاة سحائب % % 56(@)(@@) % حالي التي يرثي العدو % لها فكيف الصاحب % % PageV01P257 البحر : - 1(@)(@@) % فديتك غصنا ليس يبرح مثمرا % % من الحسن في الدنيا بكل غريب % % 2(@)(@@) % تفتح في وجناته الورد أحمرا % % فيا ليت ذاك الورد كان نصيبي % % PageV01P258 البحر : - 1(@)(@@) % وخاطر عنت الأشواق تعجبه % % جآذر الترك لازي الأعاريب % % 2(@)(@@) % من كل أهيف ضاقت عينه فمتى % % يجود لي من تلاقيه بمطلوبي % % 3(@)(@@) % يا زائري قاضي القضاة ليهنكم % % ما حقق التجريب من أبوابه % % 4(@)(@@) % أقسمت ما الحجر المكرم للغنى % % الا الذين تغشون من أعتابه % % 5(@)(@@) % لئن عذر الصاحب المرتجى % % لتأخير معلومي الواجب % % 6(@)(@@) % فقد رم حالي تاج العلى % % وناب الصديق عن الصاحب % % 7(@)(@@) % شكرا لها من أنعم قد شادها % % نعم العماد فمكنت أسبابي % % 8(@)(@@) % قالوا الحساب فقلت ان عوائدي % % أعطى على يده بغير حساب % % 9(@)(@@) % بشر أمير المعالي باتصال هنا % يحفه السعد من أقصى جوانبه % % 10(@)(@@) % واكتب على بيت سكناه العزيز به % % عزا يدوم وإقبالا لصاحبه % % PageV01P259 11(@)(@@) % يا سادة قد ظفرت عندهمو % % بيمن قصد ونجح مطلوب % % 12(@)(@@) % حاشاكمو أن يبيت جاركمو % % يشكو إلى الناس ضر أيوب % % 13(@)(@@) % جاءت الي الشوربا فحبذا % % يا سيدي منك طعام معجب % % 14(@)(@@) % أفاد جسمي قوة فها أنا % % كما يقال الأسد المشورب % % 15(@)(@@) % وغائب تذكرني كتبه % % لياليا دمعي لها في انسكاب % % 16(@)(@@) % فهاك بالمرسل من أدمعي % % حديث شجوي من كتاب الشهاب % % 17(@)(@@) % عذيري منه معرضا متجنيا % كأني له نحو الوداد أجاذب % % 18(@)(@@) % قسا فوق ما تقسو الجبال فلم يجب % % ندائي وأصداء الجبال تجاوب % % 19(@)(@@) % مولاي قد جئنا لنحمل قصة % % نحو الوزير فقم مع الأصحاب % % 20(@)(@@) % فاليوم حاجتنا اليك وانما % % يدعى الطبيب لشدة الأوصاب % % PageV01P260 21(@)(@@) % يغيب الذي أهواه عني ساعة % % فأسأم من ليل طويل أراقبه % % 22(@)(@@) % وكيف يطيب الليل عندي والكرى % % وليس إلى جنبي خليل ألاعبه % % 23(@)(@@) % علقتها غيداء حالية الطلا % % تجني على عقل المحب ولبه % % 24(@)(@@) % بخلت بلؤلؤ ثغرها عن لاثم % فتطوقت 
ms57	 بمثال ما بخلت به % % 25(@)(@@) % يا حسن كتاب الحساب وخلفهم % % غلمانهم بدفاتر وتعابي % % 26(@)(@@) % كم قد رجوت وفي حساب مثلهم % % فلقيته لكن بغير حساب % 27(@)(@@) % يا غائبين تعللنا لغيبتهم % % بطيب لهو ولا والله لم يطب % % 28(@)(@@) % ذكرت والكاس في كفي لياليكم % % فالكاس في راحة والقلب في تعب % % 29(@)(@@) % أمولاي شكرا لليراع الذي أرى % % بياض العطايا في سواد المطالب % % 30(@)(@@) % لقد قمت بالمسنون والفرض في الندى % % تضيع هذا المال في غير واجب % % PageV01P261 31(@)(@@) % دامت بسعدك للعداة مهالك % يا مطلب الجود الذي لا يحجب % % 32(@)(@@) % والله ما تدري إذا ما فاتنا % % طلب اليك من الذي نتطلب % % 33(@)(@@) % يا حبذا ملك حي الجيوش إلى % % خوض الوغى بشريق اللون محبوب % % 34(@)(@@) % تعجلوا الفال في نحر العدى فغدوا % % حمر الحلى والمطايا والجلابيب % % 35(@)(@@) % أهنيك بالعيد السعيد قدومه % % واشكر برا أنت من قبل واهبه % % 36(@)(@@) % لعمري لقد أصبحت عين زماننا % % فيا حبذا عين الزمان وحاجبه % % 37(@)(@@) % ليهنك يا عين الزمان وأهله % % ويهني الورى عام بسعدك آيب % % 38(@)(@@) % به للبرايا حاجب من هلاله % % ولحت فيا لله عين وحاجب % % 39(@)(@@) % للصاحب بن الصاحب الناصر من % % دعاه رأي في الصلاة الراتبة % % 40(@)(@@) % يمنح من قبل امتداح مجده % % جائزة ثم يراها واجبه % % PageV01P262 41(@)(@@) % لا غرو إن جئت النسيب بمدحة % من غير ما غزل وغير نسيب % % 42(@)(@@) % هزت رؤس السامعين بوصفه % % طربا فلم تحتج إلى تشبيب % % 43(@)(@@) % يا سيدي شكرا لها من أنعم % وقتي بها من بعد مصر خصيب % % 44(@)(@@) % قسما لقد أفردت في نظم وفي % % ود ففي الحالين أنت حبيب % % 45(@)(@@) % لا تنكروا حمرة الأظافر من % % فلان والقمل منه منسرب % % 46(@)(@@) % حمرتها من دماء ما قتلت % % والدم في النصل شاهد عجب % % 47(@)(@@) % إن الأمير سليمان اعتلى رتبا % في الخبر والخبر استعلت على الرتب % % 48(@)(@@) % مجانس الحسن بالحسان في صفة % وفارس الخيل وجه الترك والعرب % % 49(@)(@@) % يا ملاذي الغوث من عائلة % % ليس من تكليفهم لي مهرب % % 50(@)(@@) % طلبوا في أرجلي شيئا وقد % % نقبوا رأسا بما قد طلبوا % % PageV01P263 51(@)(@@) % أشكو لأنعمك التي 
