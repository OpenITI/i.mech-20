ms61	 الدجا % % 25(@)(@@) % وجهها قد عشقته % % لا سوارا ودملجا % % 26(@)(@@) % وأنا اليوم مغرم % % حبها مهجتي شجا % % 27(@)(@@) % كلما ناح طائر % % حث شوقي وهيجا % % 28(@)(@@) % وغدا الجفن من دمي % % في بكائي مضرجا % % 29(@)(@@) % ثم قلبي وقالبي % % للفنا قد تدرجا % % PageV01P334 البحر : - 1(@)(@@) % عرف المحبوب فابتهجا % % وعن الأكوان قد خرجا % % 2(@)(@@) % مستهام ليس يقنعه % % غير لحظ العين نهب رجا % % 3(@)(@@) % ضاق حتى لو تكون له % % وسعة الدارين ما انفرجا % % 4(@)(@@) % والنوى والشوق أتلفه % % لم يزل في الحب منزعجا % % 5(@)(@@) % لو لمن يهواه كان درى % % منزلا من شوقه عرجا % % 6(@)(@@) % آه من لي لم أجد أحدا % % عنه بالإدراك لي لهجا % % 7(@)(@@) % ليت لو ألقى له سببا % % أو أرى لي نحوه درجا % % 8(@)(@@) % ذاب صبري وانقضى جلدي % % والتواني أحرق المهجا % % 9(@)(@@) % رام بالأكوان يشغلني % % عنه كي أسلو فشوقي جا % % 10(@)(@@) % بي عليم غير أن له % % حكم تهزا بكل حجا % % PageV01P335 البحر : - 1(@)(@@) % قد أصبح قلبي في وهج % % ومدامع عيني كاللجج % % 2(@)(@@) % ومعاني الشوق قد اتضحت % % بلسان ضنى الجسم اللهج % % 3(@)(@@) % فعسى الألطاف تحف بنا % % ويلوح النور من السرج % % 4(@)(@@) % ولعل الرحمة تدركنا % % من بعد الشدة بالفرج ولعل علينا الله يجود بشرح الصدر من الحرج % % 5(@)(@@) % والذنب يزول بمغفرة % % ويصير الهالك منه نجي % % 6(@)(@@) % كرم المولى يحكي لججا % % فاسبح في هاتيك اللجج % % 7(@)(@@) % وادخل بيت التوفيق ولا % % تصعد إلا في ذي الدرج % % 8(@)(@@) % واعرفه به واعبده له % % واسجد إن أسفر وابتهج % % 9(@)(@@) % واسكر من خمرة طلعته % % وانظر نور الوجه البهج % % 10(@)(@@) % واترك عنك الأكوان بلا % % ترك وأسلك في ذا النهج % % PageV01P336 11(@)(@@) % مت واغسل عنك الغير وفي % % أكفان الصفوة فاندرج % % 12(@)(@@) % يا خمرة عين الحق لنا % % برضاب الحضرة فامتزجي % % 13(@)(@@) % واذهب يا كاس فإنك من % % وهم تمضي طورا وتجي % % 14(@)(@@) % ما ثم سوى الأحكام فلا % % تمدح شيا فالشيء هجي % % 15(@)(@@) % ذات كالروض ونحن بها % % من زهر الوصف شذا الأرج % % 16(@)(@@) % يا صاحب هذا المشرب قف % % أنت المقدام لدى الرهج % % 17(@)(@@) % جل بين صفوفك مفتخرا % % واسق الأسياف من المهج % % 18 
ms62	(@)(@@) % والكل سواك بغير هدى % % إن شئت فسر أو شئت عج % % 19(@)(@@) % لا تطلب غيرك إنك أنت % % مناك فحل عن ذا العوج % % 20(@)(@@) % هذا نصحي فاقبله وكن % % للجاهل حبلا في ودج % % PageV01P337 21(@)(@@) % أو كن للكل رياض هدى % % أو حسنا في الخد الضرج % % 22(@)(@@) % واشكر مولاك كما أولاك % % به واترك قول الهمج % % 23(@)(@@) % وصلاة الله بلا أمد % % وسلام الله مدى الحجج % % 24(@)(@@) % وتحية رب الخلق على % % طه منجينا من وهج وعلى الآل الاطهار له وعلى الأصحاب أولى البلج % % 25(@)(@@) % ما أسفر ضوء الصبح وما % % ولي ليل في الدهر دجي % % PageV01P338 البحر : - 1(@)(@@) % ما الشدة إلا للفرج % % وستأتي أنواع الفرج % % 2(@)(@@) % فاصبر فالله له حكم % % فيما يقضيه على المهج % % 3(@)(@@) % والكل يزول فلا تحزن % % من شيء راح فسوف يجي % % 4(@)(@@) % والدهر عجيب هالكه % % وعجيب أيضا منه نجي % % 5(@)(@@) % وتصاريف الأيام على % % أهل الدنيا إحدى الحجج % % 6(@)(@@) % العلم للبلوى خلقوا % % فمن البلوى لا تنزعج % % 7(@)(@@) % فجوابهم قد كان بلى % % في الأصل لمعنى ممتزج % % 8(@)(@@) % والله له غضب ورضى % % كالظلمة تظهر والبلج % % 9(@)(@@) % فاصعد بمراقي الخير إلى % % أعلى الغرفات من الدرج % % 10(@)(@@) % وإذا وكلت إلهك في % % أمر من أمرك فابتهج % % PageV01P339 11(@)(@@) % وابشر فهو المقضي ولا % % تضجر منه أو تختلج % % 12(@)(@@) % والشيء له وقت فإذا % % لم يأت فكن للوقت رجي % % 13(@)(@@) % والعسر ليسر يعقبه % % فاخرج عن ضيقك والحرج % % 14(@)(@@) % وسألتك يا مولاي بمن % % يمشون على أسنى النهج % % 15(@)(@@) % من كل رسول جاء لنا % % بالحق وبالدين البهج % % 16(@)(@@) % وبكل نبي منك أتى % % بطريق ليس بذي عوج % % 17(@)(@@) % وبنوح يشكر من غرقت % % بالدعوة منه ذوو الهرج % % 18(@)(@@) % ونجت أصحاب سفينته % % من كل فتى في الله شجي % % 19(@)(@@) % وبإبراهيم خليلك من % % نجاه الحق من الوهج % % 20(@)(@@) % وبخلته وإمامته % % لبنيه على مر الحجج % % PageV01P340 21(@)(@@) % وبتسيمة من قبل لنا % % بذوي الإسلام المنتهج % % 22(@)(@@) % وكليمك موسى من أنجى % % بك أمته يوم الخلج % % 23(@)(@@) % والفرق له كالطود غدا % % في لجة بحر مختلع % % 24(@)(@@) % وبروحك عيسى من ظهرت % % أنوار هداه على السرج % % 25(@)(@@) % أبرى الأعمى 
ms63	 والأبرص بل % % أحيى كم ميت مندرج % % 26(@)(@@) % وبطه أحمد من بهرت % % آيات هداه المنبلج % % 27(@)(@@) % وحمى دين الإسلام وقد % % وافى بالنصرة في الرهج % % 28(@)(@@) % وأبان بمدح الدين لنا % % عن ملته والكفر هجي % % 29(@)(@@) % وبأهل البيت بأجمعهم % % أرباب السبق لدى الدلج % % 30(@)(@@) % وبأصحاب المختار ومن % % بالسر أناروا كل دجي % % PageV01P341 31(@)(@@) % وأبي بكر الصديق بلا % % شك في الدين ولا مرج % % 32(@)(@@) % وبشيبته وسريرته % % تلك المعمورة باللهج % % 33(@)(@@) % وبمن فر الشيطان أسى % % منه لطريق منتهج % % 34(@)(@@) % عمر الفاروق ومن بسنا % % علياه أبان عن الفلج % % 35(@)(@@) % وبعثمان الزاكي الأخلاق % % شهيد الدار المعتلج % % 36(@)(@@) % وببحر العلم علي من % % قد فاح كروض مفترج % % 37(@)(@@) % صهر المختار وعمدته % % في الشدة والهم اللزج % % 38(@)(@@) % وبكل ولي فاح بنا % % من سيرته زاكي الأرج % % 39(@)(@@) % أن تفرج هم أحبتنا % % وتقيهم معترك الهمج % % 40(@)(@@) % وتزيل الغمة أجمعها % % عن هذا القلب المنزعج % % PageV01P342 41(@)(@@) % وادفع شر الأعداء ولا % % تغرقنا منهم في اللجج % % 42(@)(@@) % والطف يا رب اللطف بنا % % وانقذنا من هذا اللجج % % 43(@)(@@) % وصلاة الله مع التسليم % % على ذي السر المنذحج % % 44(@)(@@) % طه المختار وشيعته % % والصحب ذوي الحظ الفرج % % 45(@)(@@) % وعلى العبد المنسوب بهم % % لغني سامي المنعرج % % 46(@)(@@) % ما لعلع حادي النوق وما % % سار الركبتان على السرج % % PageV01P343 البحر : - 1(@)(@@) % لا بد للضيق في الدنيا من الفرج % % فافتح كفوف الرجا والحق بألف رجي % % 2(@)(@@) % واعلم بأنك مفتون وممتحن % % بما لديك من الإيساع والحرج % % 3(@)(@@) % والكل يذهب إن حزنا وإن فرحا % % فكن إذا ضاق أمر غير منزعج % % 4(@)(@@) % ولا تبت من كدور الدهر منقبضا % % فإنما الدهر ميال إلى العوج % % 5(@)(@@) % وأظهر البسط في كل الأمور وإن % % ضاقت عليك فقل يا أزمة انفرجي % % 6(@)(@@) % واشكر على كل حال أنت فيه فما % % عن حكمة قد خلا أمر إليك يجي % % 7(@)(@@) % واصبر وصابر لأحكام إلإله ولا % % تضجر وإياك في الدنيا من اللجج وأطلق النفس من سجن الهموم يفز غريق قلبك يا هذا من اللجج % % 8(@)(@@) % فربما رفعة من خفضة ظهرت % % وسافل قر في عال من الدرج % % 9(@)(@@) % وظلمة 
ms64	 الليل إن زادت فإن لها % % نورا أعد من الأقمار والسرج % % 10(@)(@@) % والضد للضد مجعول يزول به % % وليس ماض مع الآتي بممتزج % % PageV01P344 11(@)(@@) % يا حالة النقص ما عني الكمال نأى % % ونفحة المسك في ضمن الدم اللزج % % 12(@)(@@) % وكل شيء له وقت بكون به % % فلا تكن في القضايا غير مبتهج % % 13(@)(@@) % وحكم ربك فاصبر في الوجود له % % فإن حجته تعلو على الحجج % % 14(@)(@@) % وارفع وساوسك اللاتي تسوق إلى % % إتعاب نفسك واترك سيرة الهمج % % 15(@)(@@) % واذكر إلهك في سر وفي علن % % تنجو غدا من لهيب النار والوهج % % 16(@)(@@) % وبالصلاة تولع والسلام على % % طه الرسول إلينا واضح النهج % % 17(@)(@@) % والآل والصحب والأتباع أجمعهم % % بالخير ما هب ريح طيب الأرج % % PageV01P345 البحر : - 1(@)(@@) % إن بحر الوجود بالاختلاج % % لم يزل مكثرا من الأمواج % % 2(@)(@@) % واسمها الكانات حسا وعقلا % % في نهار يضيء وليل داجي % % 3(@)(@@) % لا تظن الوجود زاد وهذا % % غير أنواع زينة وابتهاج % % 4(@)(@@) % عدم كل ما ترى فتحقق % % بوجود في ظلمة كالسراج % % 5(@)(@@) % عينته شؤونه وهي منه % % وبها بعضه لبعض يناجي % % 6(@)(@@) % عظم الأمر وهو باطن خلق % % وهو عين الأفراد والأزواج % % 7(@)(@@) % قف هنا عند وحدة الأمر واشهد % % كثرة الخلق عين ما أنت راجي % % 8(@)(@@) % واحد أظهر المراتب منه % % في حساب الألوف للمحتاج % % 9(@)(@@) % إن ترده في كل شيء تجده % % واحدا ظاهرا بغير علاج % % 10(@)(@@) % فانظر الرتبة التي هو فيها % % ثم دعها وكنه بالامتزاج % % PageV01P346 11(@)(@@) % وليكن ظاهرا بما أنت فيه % % ظاهر فهو مادح أو هاجي % % 12(@)(@@) % وعليك الحكم الذي منه باد % % لا عليه فهالك أو ناجي % % 13(@)(@@) % صور تارة نقول وطورا % % لمعات من نوره الوهاج % % 14(@)(@@) % إن تكن عارفا عذرت قصورا % % في كلامي ولم تقل باحتجاج % % 15(@)(@@) % وإذا كنت جاهلا فتوقى % % حي ميت من هذه الأمواج % % PageV01P347 البحر : - 1(@)(@@) % إن الوجود بموجوداته امتزجا % % وهما بغير امتزاج فاعرف الدرجا % % 2(@)(@@) % رفيعها درجات كلهن له % % ذو العرش عرش محيط بالعوالم جا % % 3(@)(@@) % هي المراتب فيها نازل أبدا % % مراتب عنه عنها كلها خرجا % % 4(@)(@@) % وهي اعتباراته في نفسه ظهرت % % به 
ms65	 له فيه بالترتيب لا عوجا % % 5(@)(@@) % وكلها عدم وهو الوجود لها % % يضاف عند أولي عقل وأهل حجا % % 6(@)(@@) % وإنما هي تحقيقا تضاف له % % عندي كما جاء في القرآن منبلجا % % 7(@)(@@) % لله ما في السموات كذاك وما % % في الأرض بل كل شيء هكذا لهجا % % 8(@)(@@) % ولم يزل هو فيما فيه من نعم % % من التنزه عنها فانشق الأرجا % % 9(@)(@@) % فإن عرفت فقل ما شئت فيه وإن % % جهلته فالزم التقييد والحرجا % % 10(@)(@@) % جل الوجود الذي لا غير طلعته % % في كل شيء كنور والجميع دجا % % PageV01P348 11(@)(@@) % كالبحر والكل كالأمواج منه له % % منزه هو عنها فاحذر اللججا % % 12(@)(@@) % وافهم كلامي كفهمي أو فدعه ولا % % تتبع أولي الجهل فينا واترك الهمجا % % 13(@)(@@) % إنا عملنا وكنا جاهلين به % % فنعرف الجهل إذ منه الفؤاد نجا % % 14(@)(@@) % والجاهلون به من قبل ما علموا % % به فلا يعرفون العلم والنهجا % % 15(@)(@@) % الله أكبر هذا وجه خالقنا % % فينا بدا فرأينا الضيق والفرجا % % 16(@)(@@) % ونحن منه تقادير تلوح به % % فأهل يأس وإقناط وأهل رجا % % 17(@)(@@) % مقدر نفسه أشياء ظاهرة % % به له من أتاه أو إليه لجا % % PageV01P349 البحر : - 1(@)(@@) % قد أتينا الحمى على منهاج % % فانظروا عندكم له من هاجي % % 2(@)(@@) % سيرة أحمدية سرت فيها % % مستضيئا بنور ذاك السراج % % 3(@)(@@) % جل وجه عن العوالم بعلو % % بكمال الجمال والابتهاج % % 4(@)(@@) % جن الخلد جنة الخلد لكن % % تستر القلب عن بديع التناجي % % 5(@)(@@) % فتجرد عن السوى وبجيم الجمع % % فافرق قاف البقا في الدياجي % % 6(@)(@@) % إنما الجمع نور سر التجلي % % وبه الفرق بغية المحتاج % % 7(@)(@@) % جف جف المداد من أقلام % % جاريات السواد في لوح عاج % % 8(@)(@@) % فاكتبوا بالنضار يا أهل ودي % % في لجين الخدود والأوداج % % 9(@)(@@) % جل جل الجليل حيث تجلى % % بحلي الانفراد والازدواج % % PageV01P350 البحر : - 1(@)(@@) % عدم للوجود كالأمواج % % في امتزاج به بغير امتزاج % % 2(@)(@@) % ثم إنا ثلاثة وهو فرد % % ووجود حق عظيم ابتهاج % % 3(@)(@@) % نحن في ذاتنا وف العلم أيضا % % والكلام النفسي أصل التناجي % % 4(@)(@@) % عدم نحن في الثلاث وأما % % هو فهو الوجود عقلة تاج % % 5(@)(@@) % ربنا الحق 
ms66	 قد تنزه عنا % % مستحيل الأولاد والأزواج % % 6(@)(@@) % ما ظهرنا به سوى بكلام % % أزلي يضيء في ظل داجي % % 7(@)(@@) % وهو أيضا مراتب ليس تخفي % % عن إمام مكمل المعراج % % 8(@)(@@) % رتبة الذات قبل رتبة علم % % بعدها رتبة الكلام المناجي % % 9(@)(@@) % وهو فرد حق ونحن كثير % % باطل في كلامنا كالسراج % % 10(@)(@@) % فافهموا ما أقول يا قوم مني % % إنني البحر فيه ذو الأمواج % % PageV01P351 11(@)(@@) % هذه هذه بديعة وقت % % سمح الله فيه بالإفراج % % PageV01P352 البحر : - 1(@)(@@) % يا حسن بستان في اللوان اسمه البرج % % سرنا إليه مسير الشمس نحو البرج % % 2(@)(@@) % وفيه كنا وقد غنى حمام البرج % % وقلعة الأمن قد بتنا بها في البرج % % PageV01P353 البحر : - 1(@)(@@) % لي قصر عالي نصبتو من خشب كالبرج % % في وسط بستان في اللوان يسمى البرج % % 2(@)(@@) % وبت فيه بيات الشمس وسط البرج % % حتى المغنون لي فاقوا حمام البرج % % PageV01P354 البحر : - 1(@)(@@) % جنا بحكم التجلي قرية الفيجة % % على طريق لها كم فيه تدريجه % % 2(@)(@@) % والله حافظنا في كل تعويجه % % حتى شهدنا لضيق الأمر تفريجه % % PageV01P355 البحر : - 1(@)(@@) % من صالحيتنا طرنا بأجنحة % % هي السرور لبستان يسمى البرج % % 2(@)(@@) % ونحن في تحتنا كالنجم في فلك % % ما فارق البرج إلا وهو وسط البرج % % 3(@)(@@) % حتى كأنا حمام جاء في قفص % % ثم استقر وأمسى بائتا في البرج % % PageV01P356 البحر : - 1(@)(@@) % زينة العبد فقره واحتياجه % % والغني بالإله لاق ابتهاجه % % 2(@)(@@) % وهو في غيره مجرد وهم % % كم به رادت الردى أفواجه % % 3(@)(@@) % والجهول الذي يظن بشيء % % من متاع الدنيا يصح مزاجه % % 4(@)(@@) % ليس يغني الفقير شيء ولو سيق % % إليه من الوجود خراجه % % 5(@)(@@) % ولهذا تراه والحرص في حال % % افتقار وغنية معراجه % % 6(@)(@@) % وهي من داء حب دنياه ما زال % % مريضا أعيى الجميع علاجه % % 7(@)(@@) % والغني الغني بالذات لا بالعرض % % الزائل المثار عجاجه % % 8(@)(@@) % يا ابن يومين لا تخف قطع رزق % % كم فتى قبلك اكتفى محتاجه % % 9(@)(@@) % وكم ارتاب عال في كفاف % % وعليه في العيش ضاقت فجاجه % % 10(@)(@@) % ثم لما أن أسلم الأمر أثرت % % خادموه وأيسرت أزواجه % % PageV01P357 11(@)(@@) % فز براحات قلبك الغر يامن 
ms67	 % % زاد من فوت ما يروم انزعاجه % % 12(@)(@@) % واطرح الهم عن فؤادك واربح % % صفو عيش إن طبت طاب نتاجه % % 13(@)(@@) % لا تقل قل دون غيري رزقي % % كل رزق مقدر إخراجه % % 14(@)(@@) % قسمة الله لا زيادة فيها % % لا ولا نقص عذبه وأجاجه % % 15(@)(@@) % والفتى غير رزقه لم ينله % % ولو احتال واستطال لجاجه % % 16(@)(@@) % كم شجاع أراد رزق سواه % % يحتويه فقطعت أوداجه % % 17(@)(@@) % ولكم ضم رزق إنسان حصن % % فغزوه وهدمت أبراجه % % 18(@)(@@) % صاح لو كان فيك رزقك ما لم % % يفتح الله عاقك استخراجه % % 19(@)(@@) % ولو انضم تاج كسرى على رز ق % % فتى ذل وانزوى عنه تاجه كل ضيق وإن تطاول دهرا عن قريب بد يأتي انفراجه % % 20(@)(@@) % هذه عادة المهيمن فينا % % وعليها لقد جرى منهاجه % % PageV01P358 21(@)(@@) % أي وقت يمر من غير نوع % % من عطاء كسا الكساد رواجه % % 22(@)(@@) % كم لمولاي في الورى من أياد % % عند عبد بها استقام اعوجاجه % % 23(@)(@@) % وله كل ساعة وزمان % % بحر فضل تدفقت أمواجه % % 24(@)(@@) % ثق بلطف الإله في كل حال % % فهو في الخلق مستنير سراجه % % 25(@)(@@) % وإذا ضاق أو تعسر أمر % % ثم أبطأ انفساحه وانبلاجه % % 26(@)(@@) % وغدا القلب منه في سجن هم % % زائد الظلم لم يمت حجاجه % % 27(@)(@@) % فتوكل وارم السلاح ودع ما % % أنت فيه وليمض عنك هياجه % % 28(@)(@@) % واجعل الكون كله لم يكن من % % قبل يذهب عن الفؤاد ارتجاجه % % 29(@)(@@) % وتر الخير في الذي أنت فيه % % لكن الجهل سود الوجه زاجه % % 30(@)(@@) % والذي عنده الأمور تساوت % % تم في طاجن الحجا إنضاجه % % PageV01P359 البحر : - 1(@)(@@) % من لصب متيم ملتاح % % أخذ العلم عن خدود الملاح % % 2(@)(@@) % فقهته في الدين قامات غيد % % إن تثنت تزري بسمر الرماح % % 3(@)(@@) % وأرته ملاحة الحق حقا % % فعصى في اتباعه كل لاحي % % 4(@)(@@) % وغدا باطل الملامة شيا % % باطلا في اجتنابه إصلاحي % % 5(@)(@@) % طار قلبي على معاطف ظبي % % ما على من يحبه من جناح % % 6(@)(@@) % يتجلى بطلعة أرشدتني % % لكمالي وخيرتي وفلاحي % % 7(@)(@@) % يا كثيفا يلومني في لطيف % % إن هذا الملام غير مباح % % 8(@)(@@) % رمت مني والله شيئا 
ms68	 محالا % % كيف تسلو زجاجتي مصباحي % % 9(@)(@@) % لمتى أنت هكذا في عناء % % أنا لا أرعوي إلى النصاح % % 10(@)(@@) % وإذا كنت ليس عندك فرق % % بين لون الدجا ولون الصباح % % PageV01P360 11(@)(@@) % أتظن المشوق مثلك أعمى % % عن بروق احمي وتلك النواحي % % 12(@)(@@) % أعشق الحسن إن أردت التلاقي % % واتصال الأرواح بالأرواح % % 13(@)(@@) % وتهتك بكل أحور طرف % % كل أطوار وجهه أقداحي % % 14(@)(@@) % نسمات من داخل الستر هبت % % بعبير فأسكرت كل صاح هي محبوبتي بدت في وشاح رقمت فيه لون كل وشاح % % 15(@)(@@) % وتثنت تيها وقد ألبستني % % ثوبها وهو مؤذن بافتضاحي % % 16(@)(@@) % وأعارتني الجناح انتسابا % % فأنا طائر بذاك الجناح % % PageV01P361 البحر : - 1(@)(@@) % أنا دائما يا نور كل مليح % % بين الكناية فيك والتصريح % % 2(@)(@@) % أبدي الهوى طورا وأكتم تارة % % ومدامعي تنبيك عن تبريحي % % 3(@)(@@) % أما الحشاشة في هواك فإنني % % أنفقتها في رغبة الترويح % % 4(@)(@@) % أنا بين جسم من صدودك ناحل % % شغفا وقلب بالبعاد جريح % % 5(@)(@@) % وأضالع بالاصطبار شحيحة % % وجدا ودمع فيك غير شحيح % % 6(@)(@@) % وأنا الذي بين الحواسد والعدا % % ما بين هجو في الهوى ومديح % % 7(@)(@@) % مقل تسح ولا تشح فدمعها % % مغني اللبيب به عن التوضيح % % 8(@)(@@) % يا أيها البدر الذي لما بدا % % بالحسن أخرس نطق كل فصيح % % 9(@)(@@) % لك وجنة هي في النواظر جنة % % وجهنم في قلب كل طريح % % 10(@)(@@) % وترى العيون جمال وجهك مقبلا % % فتضج بالتهليل والتسبيح % % PageV01P362 11(@)(@@) % أحمامة الوادي قفي وترنمي % % فعلى غرامك ظاهر ترجيحي % % 12(@)(@@) % لا الصبر للتضعيف مفتقر ولا % % ذا الشوق محتاج إلى التصحيح % % 13(@)(@@) % لمعت بروق الأبرقين وقد جرت % % أمطار جفن بالبكاء قريح % % 14(@)(@@) % وروى النسيم لنا أحاديث الحمى % % عن عرفج عن زرنب عن شيح حتى أهاج بنا الغرام فياله في الحب من خبر رواه صحيح % % 15(@)(@@) % واسأل بلطف منيتي عني ولا % % تأتي بوجه للمليح قبيح % % 16(@)(@@) % وانعت له وجدي القديم وصف له % % شغفي وما ألقى من التبريح % % 17(@)(@@) % طفح الغرام علي حتى بالهوى % % صرحت في حبي لكل صبيح % % 18(@)(@@) % وكتمته لما بدا لنواظري % % نور الخباء وملت للتلميح % % 19(@)(@@) % وأنا الذي يهوى المليح 
ms69	 تعممي % % أبدا ومن شوقي له توشيحي % % PageV01P363 البحر : - 1(@)(@@) % تب منك حين تقول يا فتاح % % تلق المنى فالتوبة المفتاح % % 2(@)(@@) % وانهض إلى عين الوجود مجانبا % % ذاك النهوض فلاح فيه فلاح % % 3(@)(@@) % كم مشرق للشمس فيك ومغرب % % منه مساء دائما وصباح % % 4(@)(@@) % ولربما رمت القبول فلم تجد % % فاسمح بنفسك فالسماح رباح % % 5(@)(@@) % يا نهر طالوت الذي بليت به % % أقوامه ما هذه الألواح قل ليس مني كل من هو شارب مني فإني فاتن نصاح % % 6(@)(@@) % لعبت بك الأهواء في بحر القضا % % فارس السفينة أيها الملاح واقبل ولا تقبل وقم واقعد وقل واسكت ففي إنصاتك الإفصاح % % 7(@)(@@) % وافهم ولا تفهم وتب عن توبة % % هذا مقامك ما عليك جناح هو لا هو التواب بل هو أنت لا أنت المتاب عليه يا مصباح % % 8(@)(@@) % ومتى أحبك حين تبت فإنما % % محبوبة بك وجهه الوضاح % % 9(@)(@@) % والكائنات بسر توبتك اهتدت % % فهي الجسوم وذاتك الأرواح % % 10(@)(@@) % فاحذر فمكر الله توبة عبده % % إن تبت تب أن لا تتوب تراح % % PageV01P364 11(@)(@@) % من قام بي قامت به الأشيا ومن % % بالنفس قام تقيمه الأشباح % % 12(@)(@@) % كأس صفت بيد المدير فأسكرت % % ألباب أهل الله منه الراح % % 13(@)(@@) % فتمايلت شم الحبال وعربدت % % في النشأتين وطرفها طماح % % PageV01P365 البحر : - 1(@)(@@) % وذي طلع عن كل معنى تنزهت % % لها كل شي في الوجود يسبح % % 2(@)(@@) % وتسبيحها عنه علت حيث إنه % % من الخلق حكم ليس للحق يصلح % % 3(@)(@@) % لها الحسن بل والقبح والكل حكمها % % فتعطي لها الإيمان منها وتمنح % % 4(@)(@@) % يصورها كل امرئ حسب حاله % % وكل إناء بالذي فيه ينضح % % PageV01P366 البحر : - 1(@)(@@) % إشارات الجمال هي الملاح % % فحي على الجمال فلا جناح % % 2(@)(@@) % وجوه كالبدور على قدود % % إذا اهتزت فما السمر الرماح % % 3(@)(@@) % وألحاظ بألفاظ تنادي % % دم العشاق في الدنيا مباح % % 4(@)(@@) % ولا يك بالجلود لك افتتان % % فما تلك الجلود هي الملاح % % 5(@)(@@) % ولا يخفى عليك لطيف سر % % لأستار القلوب به افتضاح % % 6(@)(@@) % وما الفاني بمقصود ولكن % % وشى منه على الباقي وشاح % % 7(@)(@@) % وسل منا العيون تجبك عنه % % لعمرك فهي ألسنة 
ms70	 فصاح % % 8(@)(@@) % ولا تسل القلوب فتلك سكرى % % لأن جمال وجه الحب راح % % 9(@)(@@) % صدقتك ما المعاطف مائلات % % لها في كل جارحة جراح % % 10(@)(@@) % يظل بها المهفهف في ازدهاء % % على العشاق والخود الرداح % % PageV01P367 11(@)(@@) % بأبعد من قنا الإخلاص يسطو % % بها في حال صاحبه الصلاح % % 12(@)(@@) % ولا حمر الخدود موردات % % بحاجبة إذا لاح الفلاح % % 13(@)(@@) % وقل للغافلين هنا طريق % % إلى المحبوب ليس لكم يباح % % 14(@)(@@) % عميتم عنه والأقوام فيه % % حذار فدونه الأسد الكفاح % % 15(@)(@@) % ودعهم ينكروه فليس يأتي % % بعلم منهم الجهل الصراح % % 16(@)(@@) % وإن نبحوك كن من أهل بدر % % وكيف يضر بالبدر النباح % % 17(@)(@@) % إليك عن العواذل في التصابي % % إذا عصفت إليه بك الرياح % % 18(@)(@@) % وقد عفت السوى والنفس عفت % % هناك مضى الدجا وأتى الصباح % % PageV01P368 البحر : - 1(@)(@@) % أنا مجنون الملاح % % فاعقلوني بألواحي % % 2(@)(@@) % واقرؤوا نطقي فإني % % مثبت بالحق ماحي % % 3(@)(@@) % أخذت قلبي عيون % % غمزها سكري وراحي % % 4(@)(@@) % لا عيون من تراب % % هي أو ماء قراح % % 5(@)(@@) % بل عيون ناظرات % % لي من كل النواحي % % 6(@)(@@) % أينما وليت ألقى % % وجهها الحق كفاحي % % 7(@)(@@) % وبها كنت وما كنت % % وسكران وصاحي % % 8(@)(@@) % كل عين أنا عنها % % نظرة بل وحي واحي % % 9(@)(@@) % وجميعي هو من أجفانها % % المرضى الصحاح % % 10(@)(@@) % أنا إلا النور منها % % في مساء وصباح % % PageV01P369 11(@)(@@) % أنا إلا القول عنها % % في غدو ورواح % % 12(@)(@@) % تتجلى بي عليكم % % في قميصي ووشاحي % % 13(@)(@@) % قد هدت بي وأضلت % % بي كثيرا عن فلاح % % 14(@)(@@) % ولقد أنكرتموها % % من شهودي والتماحي % % 15(@)(@@) % فرمتكم من جحود الحق % % في الكفر الصراح % % 16(@)(@@) % وغزتكم بسيوفي % % وسبتكم برماحي % % 17(@)(@@) % لو عقلتم لو دريتم % % يا ذوي الجهل المتاح % % 18(@)(@@) % ونفوس في فساد % % لا ترى نور الصلاح % % 19(@)(@@) % فاحذر الليث وحول % % عنه يا كلب النباح % % 20(@)(@@) % ودعوه يا ذوي الأعين % % هاتيك الوقاح % % PageV01P370 21(@)(@@) % بيت حق واجب حر منه % % غير مباح % % 22(@)(@@) % لا تقل منه سلمنا % % ما حسستم بالجراح % % 23(@)(@@) % ستذقون غدا إن % % برد الجرح سلاحي % % 24(@)(@@) % وسترديكم سمومي % % وستلقيكم رياحي % % 25(@)(@@) % ويفي بالوعد بالنصر % % إلهي والنجاح % % 26(@)(@@) % ويريش 
ms71	 الله بالإمداد % % مقصوص الجناح % % PageV01P371 البحر : - 1(@)(@@) % هيكلي سام سليم الشبح % % طاهر الذيل نظيف القدح % % 2(@)(@@) % وإنائي بالتجلي طافح % % يتكفى بفنون الملح % % 3(@)(@@) % ومن المنبع روحي شربت % % وبصدر صدرت منشرح لا درى الغير ولا كان له لمحة من نور تلك اللمح % % 4(@)(@@) % أنا في المذكور والجاهل في الذكر % % والفكر وعقد السبح هو في بيت هوى منغلق وأنا في رفرف منفسح كلنا من نخلة واحدة لكن العجوة غير البلح % % 5(@)(@@) % وجهنا الحق غسلنا وسخ الغير % % عنه بمياه الوضح % % 6(@)(@@) % وتركنا الكل للكل فلا % % بالمذمات ولا بالمدح % % 7(@)(@@) % هي نفس كيفما شئت بدت % % لي بشخص بالسوى متشح % % 8(@)(@@) % وهو أمري نازل مرتفع % % بمزامير الورى في مرح % % 9(@)(@@) % كلهم منك خيالات فدع % % عنك يا عبد الغني واسترح % % 10(@)(@@) % وادخل البيت وبت في دعة % % وتعانق معه واصطلح % % PageV01P372 11(@)(@@) % واترك الكرسي والعرش وما % % تحته للغي أو للفلح % % 12(@)(@@) % واهجر الجنة والنار ولا % % تفتتن عن ذاته بالشبح % % 13(@)(@@) % وتمتع بالرقيقات وفز % % بالعطايا وافتخر بالمنح % % 14(@)(@@) % وانخلع عنك وعربد طربا % % وتهتك في الهوى وافتضح % % 15(@)(@@) % هذه دولتنا قد حضرت % % دولة العز وكنز الفرح % % 16(@)(@@) % وانفصلنا أبدا من أزل % % عين ماء دافق منفسح % % 17(@)(@@) % روضة زهرتها فائح % % فانتسق نفحتها وانصلح % % 18(@)(@@) % وتنصت لغنا بلبلها % % وعلى المطرب لا تقترح % % 19(@)(@@) % واحرق الجاهل في قشرته % % وهو لا يشعر بالمصطلح % % 20(@)(@@) % هو ألقى نفسه معتديا % % في المضيقات ولم ينفسح % % PageV01P373 21(@)(@@) % أنت بالتصديق في الراحة بي % % وهو في إنكاره في ترح % % PageV01P374 البحر : - 1(@)(@@) % يا من بالنور لوح ذاتي ماحي % % هات أرشفني بكاس روحي راحي % % 2(@)(@@) % واجعل بالفرق لي وبالجمع يدا % % واكشف سر الأجسام للأرواح % % PageV01P375 البحر : - 1(@)(@@) % أحزاننا بلقائكم أفراح % . . . % 2(@)(@@) % وزماننا قدح وأنتم راح % . . . % 3(@)(@@) % يا سادة من ذكرهم نرتاح % . . . % 4(@)(@@) % أبدا تحن إليكم الأرواح % % ووصالكم ريحانها والراح % % 5(@)(@@) % هذا الوجود جميعه إشراقكم % . . . % 6(@)(@@) % وجميع من في الكون هم عشاقكم % . . . % 7(@)(@@) % ما هكذا يا سادتي أخلاقكم % . . . % 8(@)(@@) % وقلوب أهل ودادكم تشتاقكم % % وإلى لذيذ لقائكم ترتاح % % 9(@)(@@) % من ذا ترى يدري بكم من يعرف 
ms72	 % . . . % 10(@)(@@) % أنتم حقيقة كل شيء يوصف % . . . % PageV01P376 11(@)(@@) % غلب الهوى أين المعين المسعف % . . . % 12(@)(@@) % وارحمتا للعاشقين تكلفوا % % ستر المحبة والهوى فضاح % % 13(@)(@@) % قوم صفا عما يغاير ماؤهم % . . . % 14(@)(@@) % وإليك من دون السوى إيماؤهم % . . . % 15(@)(@@) % كتموك حتى أنكرت أحشاؤهم % . . . % 16(@)(@@) % بالسر إن باحوا تباح دماؤهم % % وكذا دما البائحين تباح % % 17(@)(@@) % عرف الوصال يفوح فينا منهم % . . . % 18(@)(@@) % وسواهم المستحقرون فمن هم % . . . % 19(@)(@@) % قوم لهم حال شريف مبهم % . . . % 20(@)(@@) % فإذا همو كتموا تحدث عنهم % % عند الوشاة المدمع السفاح % % PageV01P377 21(@)(@@) % أوصافهم يسمو بها من يفهم % . . . % 22(@)(@@) % وهم الدواء من الردى والمرهم % . . . % 23(@)(@@) % كل المعارف والعلوم لديهم % . . . % 24(@)(@@) % وكذا شواهد للسقام عليهم % % فيها لمشكل أمرهم إيضاح % % 25(@)(@@) % يا سادتي مني السلام إليكم % . . . % 26(@)(@@) % فأنا هو المطروح بين يديكم % . . . % 27(@)(@@) % ومن الجميع على البعاد لديكم % . . . % 28(@)(@@) % خفض الجناح لكم وليس عليكم % % للصب في خفض الجناح جناح % % 29(@)(@@) % لجمالكم في كل قلب ساحة % . . . % 30(@)(@@) % وزهورنا بنسيمكم فواحة % . . . % PageV01P378 31(@)(@@) % هل للمتيم من حفاكم راحة % . . . % 32(@)(@@) % فإلى لقاكم نفسه مرتاحة % % وإلى رضاكم طرفه طماح % % 33(@)(@@) % كدر الحوادث زال عن عين الصفا % . . . % 34(@)(@@) % وبدا جمال أحبتي بعد الخفا % . . . % 35(@)(@@) % فبحق ذاك العهد يا أهل الوفا % . . . % 36(@)(@@) % عودوا بنور الوصل من غسق الجفا % % فالهجر ليل والوصال صباح % % 37(@)(@@) % قد راق في حان الوفا مشروبهم % . . . % 38(@)(@@) % ولهم أباح وصاله محبوبهم % . . . % 39(@)(@@) % صوفية تبدي الشهود غيوبهم % . . . % 40(@)(@@) % صافاهم فصفوا لها فقلوبهم % % في نوره المشكاة والمصباح % % PageV01P379 41(@)(@@) % يا قومنا أنا زائد وجدي بكم % % والصبر مني قد مضى في حبكم % % 42(@)(@@) % فاهنوا بما فزتم به من شر بكم % . . . % 43(@)(@@) % وتمتعوا فالوقت طاب بقربكم % % راق الشراب وراقت الأقداح % % 44(@)(@@) % لأمير حسن ما لديه جهاله % . . . % 45(@)(@@) % أنظر عذولي في الجمال جلاله % . . . % 46(@)(@@) % يا صاح ليس على المحب ملامه % % إن لاح في أفق الوصال ملاح % % 47(@)(@@) % رفقا بنا يا أهل ذياك اللوى % . . . % 48(@)(@@) % إن المتيم عن هواكم ما لوى % . . . % 49(@)(@@) % والله حلفه مغرم يشكو النوى % . . . % 50(@)(@@) % لا ذنب للعشاق إن غلب الهوى % % كتمانهم فنما الغرام وباحوا % % PageV01P380 51(@)(@@) % سلمى التي 
ms73	 يا ويح مهجة صبها % . . . % 52(@)(@@) % جرحت بمقلتها وأسهم هدبها % . . . % 53(@)(@@) % لله در عصابة في حبها % . . . % 54(@)(@@) % سمحوا بأنفسهم وما بخلوا بها % % لما رأوا أن السماح رباح % % 55(@)(@@) % شربوا كؤوس هوى الأحبة قهوة % . . . % 56(@)(@@) % ولهم غدت كل المكاره شهوة % . . . % 57(@)(@@) % طلبتهم الذات النزيهة نخوة % . . . % 58(@)(@@) % ودعاهم داعي الحقائق دعوة % % فغدوا بها مستأنسين وراحوا % % 59(@)(@@) % هم سادة منهم يطيب خضوعهم % . . . % 60(@)(@@) % للحب حيث به تنير ربوعهم % . . . % PageV01P381 61(@)(@@) % لما تزايد بالفراق ولوعهم % . . . % 62(@)(@@) % ركبوا على سفن الدجا فدموعهم % % بحر وشدة خوفهم ملاح % % 63(@)(@@) % نزعوا الثياب فعوضوا بثيابه % . . . % 64(@)(@@) % وعن الخطا قد ساقهم لصوابه % . . . % 65(@)(@@) % وهو المعز لهم برفع حجابه % . . . % 66(@)(@@) % والله ما طلبوا الوقوف ببابه % % حتى دعوا وأتاهم المفتاح % % 67(@)(@@) % هو إن نأى أو زاد في تقريبهم % . . . % 68(@)(@@) % يشكو كما يشكون فرط نحيبهم % . . . % 69(@)(@@) % وهم الذين تمتعوا بلبيبهم % . . . % 70(@)(@@) % لا يطربون لغير ذكر حبيبهم % % أبدا فكل زمانهم أفراح % % PageV01P382 71(@)(@@) % فيهم لقد دارت كؤوس سقاتهم % . . . % 72(@)(@@) % حتى بها زالت عقول صحاتهم % . . . % 73(@)(@@) % وحبيبهم لما بدا بصفاتهم % . . . % 74(@)(@@) % حضروا وقد غابت شواهد ذاتهم % % فتهتكوا لما رأوه وصاحوا % % 75(@)(@@) % نور التجلي الحق حير عقلهم % . . . % 76(@)(@@) % لفروعهم أخفى وأظهر أصلهم % . . . % 77(@)(@@) % قوم جميع الفضل مننسب لهم % . . . % 78(@)(@@) % فتشبهوا إن لم تكونوا مثلهم % % إن التشبه بالكرام فلاح % % 79(@)(@@) % سكرت غصون الروض من نسماتها % . . . % 80(@)(@@) % وترنمت أطياره بلغاتها % . . . % PageV01P383 81(@)(@@) % والذات تجلى في بديع صفاتها % . . . % 82(@)(@@) % قم يا نديم إلى المدام فهاتها % % في كأسها قد دارت الأقداح % % 83(@)(@@) % عرفت أهاليها بحفظ أمانة % . . . % 84(@)(@@) % وكمال عرفان ورفع مكانة % . . . % 85(@)(@@) % بكر أجل طلا وخير مدامه % . . . % 86(@)(@@) % من كرم إكرام بدن ديانة % % لا خمرة قد داسها الفلاح % % PageV01P384 البحر : - 1(@)(@@) % إن قلت يا روحي لسبوحي % % يقول لي بل أنت يا روحي % % 2(@)(@@) % وإن أقل يا روح روحي يقل % % ذلك نوري من له أوحي % % 3(@)(@@) % حتى يكون المحو عن لوحنا % % فيظهر المخفي في اللوح % % 4(@)(@@) % غير الوجود الحق ما ههنا % % فاستغنموا تحقيق ممنوح % % 5(@)(@@) % أحبني قدما ومن فرط ما % % أحبني صور ملموحي % % 6(@)(@@) % فصورتي محفوظة 
ms74	 عنده % % يشهدها مشهد ممدوح % % 7(@)(@@) % وهكذا كل البريات لو % % تدري بحال منه مشروح % % 8(@)(@@) % يا واحدا في كل شيء ولا % % شيء فمن سوح إلى سوح % % 9(@)(@@) % نحن جميعا لك لا أنه % % أنت لنا كالنور من يوح % % 10(@)(@@) % نحن تصاوير تصورتها % % حبا لها بالجسم والروح % % PageV01P385 11(@)(@@) % فادعت الحب وكانت به % % جارحة في زي مجروح % % PageV01P386 البحر : - 1(@)(@@) % فديتك يا من قد خفيت فلاحا % % وشوقي إليه لا يزال فلاحا % % 2(@)(@@) % ولا عجب إن طرت في رويتي له % % فمن لطفه أني وجدت جناحا % % 3(@)(@@) % ولما بدا وجه له من ورا الورى % % رأيت جميع الكائنات ملاحا % % 4(@)(@@) % تباركت من سر خفي عن السوى % % أباح لنا جهرا لقاه أباحا % % 5(@)(@@) % يقول لشي كن وما لشيء غيره % % إذا كان لكن قد سترت وباحا % % 6(@)(@@) % وما صبغة الأشياء إلا شؤونه % % بها يتجلى للأنام كفاحا % % 7(@)(@@) % تعاليت يا ساقي القلوب شرابه % % برؤية وجه منه ساعة لاحا % % 8(@)(@@) % لئن كانت الأكوان في الناس ظلمة % % فإنك عندي قد ظهرت صباحا % % 9(@)(@@) % وشمس سماء الذات منك لنا بدت % % وروض التجلي من صفاتك فاحا % % 10(@)(@@) % هو الكل إلا أن صولة فعله % % حجاب له يسقي البرية راحا % % PageV01P387 11(@)(@@) % فتسكر أرباب العقول فلا ترى % % سوى ما لها منها الخيال أتاحا % % 12(@)(@@) % وما الحسن إلا وهو للعقل تابع % % يرى ما يراه قبضة وسراحا % % 13(@)(@@) % ألا يا وحيد الذات أنت وجودنا % % وما نحن إلا الحكم منك متاحا % % 14(@)(@@) % خطوط بأقلام العقول تخيلا % % عن القلم الأعلى صدرن صحاحا % % 15(@)(@@) % وما القلم الأعلى سوى عن إرادة % % تجل انبعاثا إذ علت ورواحا % % 16(@)(@@) % إرادة غيب من مقام مقدس % % ببيدائه فهم المنزه ساحا % % 17(@)(@@) % قديمة عهد والجميع حوادث % % فليس لنا فيها الكلام مباحا % % PageV01P388 البحر : - 1(@)(@@) % حملت بنا أم من الأرواح % % والوضع كان لهيكل الأشباح % % 2(@)(@@) % قلم بلوح إن أردت فقل وإن % % قد شئت فالأقلام بالألواح % % 3(@)(@@) % هي ما ترى لا ما رأيت فإنها % % تجلي على الرائين كل صباح % % 4(@)(@@) % فإذا رأوا لا يعرفون لمن رأوا % % حتى تقوم لهم عقود نكاح % % 5 
ms75	(@)(@@) % حاء الحياء والحلم والحفظ احتوت % % كل الجمال وسائر الأفراح % % 6(@)(@@) % ولها من النور الشريف تشعشع % % كتشعشع الصهباء في الأقداح % % 7(@)(@@) % والحال يشهد والشهيد هو الذي % % شهد الأمور على أتم صلاح % % PageV01P389 البحر : - 1(@)(@@) % جميع الورى كل أحوالهم % % من الخير جود لهم يمنح % % 2(@)(@@) % وفضل من الله لو أنهم % % يكون له عندهم ملمح % % 3(@)(@@) % لشكرانهم بالذي جاءهم % % ونالوه منه ولا يمرحوا % % 4(@)(@@) % فلا يفرحوا بالذي جاءهم % % ونالوه منه ولا يمرحوا % % 5(@)(@@) % وأما بفضل إله الورى % % نعم فبذلك فليفرحوا % % PageV01P390 البحر : - 1(@)(@@) % كتاب الله جامع كل شيء % % وسنة أحمد المختار شرح % % 2(@)(@@) % وشرحهما الفتوحات التي من % % جناب القدس جاء بهن فتح % % 3(@)(@@) % لشيخ شيوخنا العربي من قد % % أتانا منه فيض هدى ومنح % % 4(@)(@@) % بمحيي الدين يدعي حيث أحيى % % لدين الله ذلك نعم مدح % % 5(@)(@@) % فتوحات بها العلماء زادت % % علوما نحو غيب الغيب تنحو % % 6(@)(@@) % بها الحيران للتحقيق يهدى % % وسكران الهوى والجهل يصحو % % 7(@)(@@) % ولكن إن هداه الله حتى % % من الإنكار لوح النفس يمحو % % 8(@)(@@) % ولا تعجب فإن كتاب ربي % % به خسرت رجال وهو ربح % % 9(@)(@@) % وسنة أحمد المختار قوم % % بها هم في ظلام وهي صبح % % 10(@)(@@) % ولولا في أوانيهم ضلال % % لما منهم ضلال كان نضح % % PageV01P391 11(@)(@@) % ووالله العظيم يمين عبد % % صدوق ما عليه بذاك جنح % % 12(@)(@@) % أئمة ديننا ما صنفوا في % % شريعتنا كتلك ولا يصح % % 13(@)(@@) % وكيف وقد حوت لعلوم رسم % % وكشف كله للناس نصح % % 14(@)(@@) % وفي الإسلام ليس لها نظير % % فيحوي ما حوت وهو الأصح % % PageV01P392 البحر : - 1(@)(@@) % إني أنا جسم فنفس فروح % % ثلاثة فيهن أغدو أروح % % 2(@)(@@) % وهن أصل واحد حادث % % يخفي سريعا وسريعا يلوح % % 3(@)(@@) % وراءه الأمر الذي يقتضي % % حقيقة تجهلها كل روح % % 4(@)(@@) % تنزهت في غيبها عندنا % % فما لها إلا شميم يفوح % % 5(@)(@@) % كاللمح من أبصارنا أمرها % % وهو الذي منه يكون الفتوح % % 6(@)(@@) % يا واحدا وهو كثير كما % % قلنا ولكني به لا أبوح % % 7(@)(@@) % خوفا على حرمته عند من % % يجهله أو يعتريه جموح % % 8(@)(@@) % فإن كل الفانيات التي % % بها الوجود الحق 
ms76	 كان السموح % % 9(@)(@@) % ما غيرته مذ تجلي بها % % وباطل في نور حق يطوح % % 10(@)(@@) % خذ لي أمانا منك يا سيدي % % جوانحي للقرب فيها جنوح % % PageV01P393 11(@)(@@) % وإنني أرجوك في كل ما % % أدعوك من خير وقلبي لحوح % % 12(@)(@@) % حقيقتي أنت ولكن غدا % % من بعد موتي لي بهذا وضوح % % 13(@)(@@) % يوم اللقا مرجعنا كلنا % % إليك يا مرجع أنوار يوح % % 14(@)(@@) % طوبى لمن يفهم أقوالنا % % كفهمنا فهو طروب صدوح % % 15(@)(@@) % أو يترك الإنكار إن لم يكن % % يدري ويصغي لكلام النصوح % % 16(@)(@@) % فإن حانات دواويننا % % خمارها يولي الغبوق الصبوح % % 17(@)(@@) % ولا ينال الكأس إلا فتى % % فيه لأسرار المعاني صلوح % % 18(@)(@@) % عليه ما نرمز لا يختفي % % وعنده من كل لفظ شروح % % 19(@)(@@) % وسر هذا أنه مؤمن % % بالغيب من معنى النظام السنوح % % 20(@)(@@) % يحفظ من طوفان وسواسه % % سفينة كان بها حفظ نوح % % PageV01P394 21(@)(@@) % لا تقرب المنكر يا مسلما % % فربما تعديك منه القروح % % 22(@)(@@) % وربما سالت جراحاته % % فنجست منك الفؤاد الطموح % % 23(@)(@@) % كم عصبة من جهلهم حالنا % % كادوا علينا يلبسون المسوح % % 24(@)(@@) % ما آمنوا بالغيب حتى على % % قلوبهم فيض التجلي يسوح % % 25(@)(@@) % بل صوروه في خيالاتهم % % وعندهم فيما رأوه رجوح % % 26(@)(@@) % وهو بعيد غاية البعد عن % % أن يشبه الغيب الحقيق النزوح % % 27(@)(@@) % والله مع هذا عليم بهم % % وإنه ذو العفو وهو الصفوح % % PageV01P395 البحر : - 1(@)(@@) % وجه من أهواه لاح % % فاختفى نور الصباح % % 2(@)(@@) % فاسقني الكأس الطفاح % % في غبوق واصطباح % % 3(@)(@@) % لم تقل أهل السماح % % موسم الأفراح راح % % PageV01P396 البحر : - 1(@)(@@) % هذه دعوى الوجود % % تمنع القلب الشهود % % 2(@)(@@) % فهو في أسر القيود % % وجنازير الحدود % % 3(@)(@@) % ليرى حال الأسود % % في ملاقاة الكفاح % % 4(@)(@@) % للغنى عبد فقير % % وإلى الله المصير % % 5(@)(@@) % صل يا ربي القدير % % لي على البدر المنير % % 6(@)(@@) % سيد الرسل البشير % % فائق كل الملاح % % PageV01P397 البحر : - 1(@)(@@) % حق عيني رؤية الوجه المليح % % قد أتانا خبر فيه صحيح % % 2(@)(@@) % قول طه إن للعين التي % % هي عين لك حقا قد أتيح % % 3(@)(@@) % فليؤد كل ذي حق هنا % % حقه الوارد في النص الصريح % % 4(@)(@@) % فهو 
ms77	 معروف لدى عارفنا % % خافيا عن كل ذي وجه قبيح % % 5(@)(@@) % وجه من ينكر دين المصطفى % % ويرى ذاك حراما ما أبيح % % 6(@)(@@) % إن هذا هو شرعي دائما % % وبه ألقى إلهي في الضريح % % 7(@)(@@) % فليمت غيظا ويفنى كمدا كل من ينكره لا يستريح أين نبت الورد في الخدين من % % كل بدر طالع من نبت شيح % % 8(@)(@@) % والذي ما عنده فرق يرى % % بين وجه الشعر والوجه الصبيح % % 9(@)(@@) % فهو حيوان ولا عقل له % % في هوى الدنيا له قلب قريح % % 10(@)(@@) % يعشق الملعونة الدنيا التي % % هو ملعون بها كلب نبيح % % PageV01P398 11(@)(@@) % إن يقل عنا عرته صبوة % % صبوة الجهل بها المر جريح % % 12(@)(@@) % ما صبا قلبي ولكن هام في % % مجتلى وجه كريم لا شحيح % % 13(@)(@@) % فانظروا العاشق منكم كيف في % % طمس قلب وعمى عين يسيح % % 14(@)(@@) % وانظروا العاشق منا كيف في % % فيض علم الله والفتح الفسيح % % 15(@)(@@) % ما لكم من نظر يا هؤلا % % غير بهتان وتشنيع فضيح % % 16(@)(@@) % فاستعدوا لسواد الوجه في % % يوم حق صادق الوعد رجيح % % 17(@)(@@) % واعملوا ما شئتموه ههنا % % كل قول هو منكم مثل ريح % % 18(@)(@@) % نحن قوم لا نبالي بالذي % % قيل فينا هو ذم أو مديح % % 19(@)(@@) % حسبنا الله الذي نعرفه % % وبه نهوى تجليه الرجيح % % 20(@)(@@) % أنكرت أمثالكم قبلي على % % مثل طه وعلى عيسى المسيح % % PageV01P399 21(@)(@@) % وعلى مثل خليل الله من % % جاء بالحق وإسحق الذبيح % % 22(@)(@@) % ثم زالوا ومضوا في غيهم % % وعن الباطل ذو الحق أزيح % % 23(@)(@@) % هكذا الدينا علينا وعلى % % منكرينا ما عليها مستريح % % PageV01P400 البحر : - 1(@)(@@) % إليك يا غير عني % % إني أحب المليح شوقا لوجه صبيح % % 2(@)(@@) % جارت علينا الحبائب % % يا هل ترى ما يكون والجور موت صريح % % PageV01P401 البحر : - 1(@)(@@) % إني أرى اليوم قلبي % % قد غاب عند الحبيب خلف الستائر طريح % % 2(@)(@@) % يا ليتني كنت حاضر % % بين الحمى والمقام قلبي هناك الجريح % % PageV01P402 البحر : - 1(@)(@@) % كم سحت بين البوادي % % أبغي جمال الوجود فلم أجد غير ريح % % 2(@)(@@) % هامت رجال التجلي % % وجاء طيب الوصال في عز ملك فسيح % % PageV01P403 البحر : - 1(@)(@@) % يا جيرة 
ms78	 الحي قوموا % % إلى شهود القديم فإنه قد أبيح % % 2(@)(@@) % صلوا على النور طه % % وسلموا يا رفاقي عبد الغني كم يصيح % % PageV01P404 البحر : - 1(@)(@@) % إن هذا الصبا وهذا الصباحا % % كشفا لي تلك الوجوه الصباحا % % 2(@)(@@) % كل وجه له من الله شكل % % أتراءى به الجمال الصراحا % % 3(@)(@@) % واحد لا سواه لكن عليه % % من تقاديره ترى أشباحا % % 4(@)(@@) % لك تبدو به وما هي شيء % % فتراها الأجسام والأرواحا % % 5(@)(@@) % وهو وهو الله الوجود تعالى % % عن شبيه له إذا غبت لاحا % % 6(@)(@@) % وإذا لحت غاب عنك فحاذر ه % % وسلم له وألق السلاحا % % 7(@)(@@) % أنت باب الوجود في يده إن % % شاء فتحا تكن المفتاحا % % 8(@)(@@) % وإذا لم يشأ فلا تعترضه % % وتأدب واخفض إليه الجناحا % % PageV01P405 البحر : - 1(@)(@@) % ركب الحجاز سرى الحادي بهم ودنا % . . . % 2(@)(@@) % وخلفوني أقاسي الشوق والحزنا % . . . % 3(@)(@@) % ومذ رأوني بأرض الشام مرتهنا % . . . % 4(@)(@@) % شدوا المطايا وقد نالوا المنى بمنى % % وكلهم بأليم الشوق قد باحا % % 5(@)(@@) % تلك البلاد سرت فينا منائحها % . . . % 6(@)(@@) % وقد تباشر غاديها ورائحها % . . . % 7(@)(@@) % وحين لذ لهم في الأرض سائحها % . . . % 8(@)(@@) % سارت ركائبهم تندى روائحها % % طيبا بما طاب ذاك الوفد أشباحا % % 9(@)(@@) % هم الرجال أجل الوافدين هم % . . . % 10(@)(@@) % لنحو أحبابهم قد أسرعت همم % . . . % PageV01P406 11(@)(@@) % طابوا بطيبة طيبا وانجلت غمم % . . . % 12(@)(@@) % نسيم قرب النبي المصطفى لهم % % روح إذا شربوا من ذكره راحا % % 13(@)(@@) % أواه لم أقض يوم البين من وطر % . . . % 14(@)(@@) % والشوق ألقى فؤاد الصب في خطر % . . . % 15(@)(@@) % فصحت للبدو لما كنت في حضر % . . . % 16(@)(@@) % يا سائرين إلى المختار من مضر % % سرتم جسوما وسرنا نحن أرواحا % % 17(@)(@@) % كم ذا أسلي فؤادي قصد محضرة % . . . % 18(@)(@@) % لهم وروحي عنهم غير صابرة % . . . % 19(@)(@@) % وكم نقول لهم من غير مقدرة % . . . % 20(@)(@@) % إنا أقمنا على عجز ومعذرة % % ومن أقام على عجز كمن راحا % % PageV01P407 البحر : - 1(@)(@@) % فرحي يا فرحي يا فرحي % % خمرة المحبوب ملء القدح % % 2(@)(@@) % قم بنا نشربها صافي % % يا نديمي واغتبق واصطبح % % 3(@)(@@) % خمرة الذات تجلت وعلت % % عن معاني الكون يوم الفرح % % 4(@)(@@) % لا يراها غيرها من أحد % % كل 
ms79	 طرف بالسوى منجرح % % 5(@)(@@) % هذه لا هذه أنت ولا % % أنت فاعرف عين هذا الشبح % % 6(@)(@@) % هو عين الكل لا كل سوى % % عينه عين العطا والمنح % % 7(@)(@@) % بيته الغيب فإن لم تستطع % % لا تحل عن بابه المنفتح % % 8(@)(@@) % ربما يقبلك البواب إن % % كنت ذا قلب له منطرح % % 9(@)(@@) % واحد عدده العقل لنا % % بانتظام كعقود السبح % % 10(@)(@@) % فتحقق وتدقق واعترف % % أنك الفرد الذي لم تلمح % % PageV01P408 11(@)(@@) % وتوحد واترك الكثرة عن % % وهمك الحاجب عنه واستح % % 12(@)(@@) % أنت حق واحد لا غيره % % غيره أنت فطب وانشرح % % 13(@)(@@) % وادخل الحضرة يا حضرته % % وتعانق معه واصطلح % % 14(@)(@@) % لمتى أنت سواه لمتى % % في نزاع أنت مت واسترح % % 15(@)(@@) % يا وجودا واحدا ليس له % % غير أسماء به لا تنمحي % % 16(@)(@@) % ظهرت عنه له في صور % % فانيات مثل قوس القزح % % 17(@)(@@) % كن له لا لسواه أبدا % % وانغسل عنك به وانمسح % % 18(@)(@@) % كن جمادا وإذا شئت به % % كن نباتا مثمرا كالبلح % % 19(@)(@@) % وإذا شئت كن الحيوان يا % % أيها الإنسان وقت المرح % % 20(@)(@@) % وانجمع إن شئت طورا وافترق % % كيفما كنت ولا تقترح % % PageV01P409 21(@)(@@) % هذه الأطوار لا تبقى له % % هي برق لاح للملتمح % % 22(@)(@@) % يتجلى هو في الكون بها % % لا بها مزدلف في قرح % % 23(@)(@@) % كم شحيح قام بالنفس فلم % % يلقها لما تجلت كم شحي % % PageV01P410 البحر : - 1(@)(@@) % عشقت في مكة ذات البها % % يدعونها الكعبة باسم صريح % % 2(@)(@@) % وهي كعوب غادة حرة % % كم قلب صب في هواها جريح % % 3(@)(@@) % محجوب بالستر عن كل من % % ينظرها من أجنبي قبيح % % 4(@)(@@) % وإنما ينظرها محرم % % فيبصر الوجه الجميل الصبيح % % 5(@)(@@) % رأيتها في مدتي مرة % % فراح جسمي في هواها طريح وطفت سبعا حولها لاثما يمين ربي هيئة المستبيح % % 6(@)(@@) % ويا له من حجر أسود % % كأنه الخال بخد المليح % % PageV01P411 البحر : - 1(@)(@@) % دين هذا الزمان محض ابتداع % % ثم دنياه فالحرام الصريح % % 2(@)(@@) % فاتركوا دينه ودنياه تنجوا % % واتبعوا العلم واقنعوا تستريحوا % % PageV01P412 البحر : - 1(@)(@@) % نوحي على فقدهم يا مقلتي نوحي % % والدمع طوفان هل منه نجا نوحي % % 2(@)(@@) % يا من ذا ابطؤا 
ms80	 جئنا لهم نوحي % % لأنبياء المحبة لم نزل نوحي % % PageV01P413 البحر : - 1(@)(@@) % أوميض برق بالأبيرق لاحا % % يستل عن غمد السحاب صفاحا % % 2(@)(@@) % أم نار أعلام الحجاز بدت لنا % % أم في ربا نجد أرى مصباحا % % 3(@)(@@) % أم تلك ليلى العامرية أسفرت % % عن وجهها ففشا الجمال وباحا % % 4(@)(@@) % أم تلك أنوار العذيب تشعشعت % % ليلا فصيرت المساء صباحا % % 5(@)(@@) % يا راكب الوجناء وقيت الردى % % قف بالمحصب واندب الملتاحا % % 6(@)(@@) % واسأل فديتك عن فؤاد متيم % % إن جئت حزنا أو طويت بطاحا % % 7(@)(@@) % وسلكت نعمان الأراك فعج إلى % % تلك الخيام ترى بهن فلاحا % % 8(@)(@@) % وأنخ بتلعات العقيق فإنه % % واد هناك عهدته فياحا % % 9(@)(@@) % وبأيمن العلمين من شرقيه % % كم معهد قلبي إليه تلاحى % % 10(@)(@@) % بلغت رشدك إن طلعت طويلعا % % عرج وأم أرينه الفواحا % % PageV01P414 11(@)(@@) % وإذا وصلت إلى ثنيات اللوى % % وقصدت نحو المأزمين رواحا % % 12(@)(@@) % فاذكر عهودي إن قدمت على الحمى % % فانشد فؤاد بالأبيطح طاحا % % 13(@)(@@) % واقرا السلام عريبه عني وقل % % لهمو أصرتم باللقاء شحاحا % % 14(@)(@@) % أنتم كرام وهو صب وامق % % غادرته لجنابكم ملتاحا % % 15(@)(@@) % يا ساكني نجد أما من رحمة % % صبري عليكم والتجلد راحا % % 16(@)(@@) % ما ضركم لو تسمحون بنظرة % % لأسير إلف لا يريد سراحا % % 17(@)(@@) % هلا بعثتم للمشوق تحية % % تهدي إليه مع النسيم صباحا % % 18(@)(@@) % فهو الذي طويت إليكم روحه % % في طي صافية الرياح رواحا % % 19(@)(@@) % يحيى بها من كان يحسب هجركم % % يردي الجسوم ويترك الأرواحا % % 20(@)(@@) % يطن نأيكمو إذا لذتم به % % مزحا ويعتقد المزاح مزاحا % % PageV01P415 21(@)(@@) % يا عاذل المشتاق جهلا بالذي % % سواك دعني واترك الإلحاحا % % 22(@)(@@) % فأنا الذي من يختبرني في الهوى % % يلقى مليا لا بلغت نجاحا % % 23(@)(@@) % أتعبت نفسك في نصيحة من يرى % % ترك الهوى ذنبا وليس مباحا % % 24(@)(@@) % لم تدر أنت فشأن كل متيم % % أن لا يرى الإقبال والإفلاحا % % 25(@)(@@) % أقصر عدمتك واطرح من أثخنت % % مقل الظباء فؤاده فتلاحى % % 26(@)(@@) % إن رام ينظر ثانيا جرحته في % % أحشاءه النجل العيون جراحا % % 27(@)(@@) % كنت الصديق قبيل نصحك مغرما % % والآن قلبك بالعداوة باحا % % 28(@)(@@) % هب أنت لي 