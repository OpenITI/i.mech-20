ms2874	 .(@)(@@)(@@)(@@) $ 27171 قال النبي :(@)(@@) | 30 ( لا ينظر الله تعالى إلى امرأة لا تشكر لزوجها وهي لا تستغني عنه ) )(@)(@@) ( طب ك هق ) و الخطيب عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 27172 قال النبي :(@)(@@) | 30 ( لا ينظر الله إلى الأشمط الزاني ، ولا العائل المزهو والذي يجر إزاره من الخيلاء ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 27173 قال النبي :(@)(@@) | 30 ( لا ينظر الله إلى رجل لا يقيم صلبه من ركوعه وسجوده ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27174 قال النبي :(@)(@@) | 30 ( لا ينظر الله يوم القيامة إلى مانع الزكاة ، ولا إلى آكل مال اليتيم ، ولا إلى ساحر ولا إلى غادر ) )(@)(@@) الديلمي عن أبي شريح رضي الله عنه .(@)(@@)(@@)(@@) $ 27175 قال النبي :(@)(@@) | 30 ( لا ينظر الله إلى قوم لا يجعلون عمائمهم تحت PageV09P058 ردائهم يعني في الصلاة ) )(@)(@@) أبو نعيم عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 27176 قال النبي :(@)(@@) | 30 ( لا ينظر الله إلى المسبل يوم القيامة ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27177 قال النبي :(@)(@@) | 30 ( لا ينقع بول في طست في البيت ، إن الملائكة لا تدخل بيتا فيه بول منقع ، ولا يبولن في مغتسل ) )(@)(@@) ( طس ) عن عبد الله بن يزيد رضي الله عنه .(@)(@@)(@@)(@@) $ 27178 قال النبي :(@)(@@) | 30 ( لا يهلك مع الدعاء أحد ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27179 قال النبي :(@)(@@) | 30 ( لا يوطن الرجل المسجد للصلاة أو لذكر الله إلا يبشبش الله به كما يبشبش أهل الغائب إذا قدم عليهم ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 27180 قال النبي :(@)(@@) | 30 ( لا ولكني تبسمت إذ كانا جميعا في درج واحدة في الجنة ) )(@)(@@) ابن عساكر عن يزيد بن أبي حبيب أن عكرمة بن أبي جهل قتل رجلا من الأنصار يقال له المجدر ، فأخبر رسول الله بذلك فتبسم ، فقال له رجل من الأنصار : يا رسول الله تبسمت أن قتل رجل من قومك رجلا منا قال فذكره .(@)(@@)(@@)(@@) $ 27181 قال النبي :(@)(@@) | 30 ( لا وإن تعتمر خير لك ) )(@)(@@) ( حم ت ) حسن صحيح ، ( ع ) و ابن خزيمة 
ms2875	 ، ( قط ض ) عن جبر رضي الله عنه أن رجلا قال : يا رسول الله ! أخبرني عن العمرة أواجبة هي ؟ قال فذكره .(@)(@@)(@@)(@@) $ 27182 قال النبي :(@)(@@) | 30 ( لا ! إنما ذلك عرق وليس بحيض ، فإذا أقبلت حيضتك فدعي الصلاة ، وإذا أدبرت فاغسلي عنك الدم وصلي ثم توضئي لكل صلاة حتى يجيء ذلك الوقت ) )(@)(@@) ( خ م د ت ن ه ) عن عائشة أن فاطمة قالت : PageV09P059 يا رسول الله ! إني امرأة أستحاض فلا أطهر أفأدع الصلاة ؟ قال فذكره .(@)(@@)(@@)(@@) $ 27183 قال النبي :(@)(@@) | 30 ( لا إنما عرق وليس بالحيضة ، اجتنبي الصلاة أيام محيضك ثم اغتسلي وتوضئي لكل صلاة وإن قطر الدم على الحصيرة ) )(@)(@@) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27184 قال النبي :(@)(@@) | 30 ( لا إنما يكفيك أن تحثي على رأسك ثلاث حثيات ثم تفيضين عليك الماء فتطهرين ) )(@)(@@) ( م ) عن أم سلمة رضي الله عنها قالت : قلت : يا رسول الله ! إني امرأة أشد ضفر رأسي أفأنقضه لغسل الجنابة ؟ قال فذكره .(@)(@@)(@@)(@@) $ 27185 قال النبي :(@)(@@) | 30 ( لا وإن كنت لا بد سائلا فاسأل الصالحين ) )(@)(@@) ( حم د هق ) عن ابن الفراسي أن الفراسي قال : من أسأل يا رسول الله ؟ قال فذكره .(@)(@@) PageV09P060(@)(@@)(@@)(@@) || ( حرف الياء )(@)(@@)(@@)(@@) ||| ( الياء مع الألف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 27186 قال النبي :(@)(@@) | 30 ( يا آل محمد ! من حج منكم فليهل بعمرة في حجته ) )(@)(@@) ( حب ) عن أم سلمة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27187 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! إن لكل قوم عيدا وهاذا عيدنا ) )(@)(@@) ( ق ن ه ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27188 قال النبي :(@)(@@) | 30 ( لا أبا بكر ! قل اللهم فاطر السماوات والأرض ، عالم الغيب والشهادة ، لا إلاه إلا أنت ، رب كل شيء ومليكه ، أعوذ بك من شر نفسي ومن شر الشيطان وشركه ، وأن أقترف على نفسي سوءا أن أجره إلى مسلم ) )(@)(@@) ( ت ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27189 قال النبي :(@)(@@) | 30 ( يا أبا بكر ! ما ظنك بإثنين الله ثالثهما ) )(@)(@@) ( حم ق ت ) عن أبي بكر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27190 قال النبي :(@)(@@) | 30 ( يا أبا ثعلبة ! كل 
ms2876	 ما ردت عليك قوسك وكلبك المعلم ويدك ، ذكي وغير ذكي ) )(@)(@@) ( د ) عن أبي ثعلبة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27191 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! أترى أن كثرة المال هو الغنى ؟ إنما الغنى غنى القلب والفقر فقر القلب ، من كان الغنى في قلبه فلا يضره ما لقي من الدنيا ، ومن كان الفقر في قلبه فلا يعنيه ما أكثر له في الدنيا ، وإنما يضر نفسه شحها ) )(@)(@@) ( ن حب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27192 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! إذا صمت من الشهر ثلاثة أيام فصم : PageV09P061 ثلاث عشرة ، وأربع عشرة ، وخمس عشرة ) )(@)(@@) ( ت ه ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27193 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! إذا طبخت فأكثر المرق وتعاهد جيرانك ) )(@)(@@) ( حم خد م ت ن ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27194 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! أرأيت إن أصاب الناس جوع شديد لا تستطيع أن تقوم من فراشك إلى مسجدك كيف تصنع ؟ تعفف ، يا أبا ذر ، أرأيت إن أصاب الناس موت شديد يكون البيت فيه بالعبد ، يعني القبر كيف تصنع ؟ اصبر ، يا أبا ذر ! أرأيت إن قتل الناس بعضهم بعضا حتى تغرق حجارة الزيت من الدماء كيف تصنع ؟ أقعد في بيتك وأغلق عليك بابك ، قال : فإن لم أترك ؟ قال : فائت من كنت معه فكن فيهم ، قال : فآخذ سلاحي ؟ قال : إذا تشاركهم فيما هم فيه ، ولاكن خشيت أن يردعك شعاع السيف فألق من طرف ردائك على وجهك كي يبوء بإثمه وإثمك ويكون من أصحاب النار ) )(@)(@@) ( حم د ه حب ك ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27195 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! ألا أدلك على كنز من كنوز الجنة : لا حول ولا قوة إلا بالله ) )(@)(@@) ( حم ن ه حب ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27196 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! ألا أعلمك كلمات تقولهن ، تلحق من سبقك ، ولا يدركك إلا من أخذ بعملك : تكبر دبر كل صلاة 
ms2877	 ثلاثا وثلاثين ، وتسبح ثلاثا وثلاثين ، وتحمد ثلاثا وثلاثين ، وتختم بلا إله إلا لله وحده لا شريك له له الملك وله الحمد ، وهو على كل شيء قدير ، من قال ذلك غفرت له ذنوبه ولو كانت مثل زبد البحر ) )(@)(@@) ( د ) عن أبي ذر رضي الله عنه .(@)(@@) PageV09P062(@)(@@)(@@)(@@) $ 27197 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! إنك امرؤ فيك جاهلية ، إنهم إخوانكم فضلكم الله عليهم ، فمن لم يلائمكم فبيعوه ولا تعذبوا خلق الله ) )(@)(@@) ( د ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27198 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! إنك ضعيف وإنها أمانة ، وإنها يوم القيامة خزي وندامة إلا من أخذها بحقها وأدى الذي عليه فيها ) )(@)(@@) ( م ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27199 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! إنه سيكون بعدي أمراء يميتون الصلاة فصل الصلاة لوقتها ، فإن صليت لوقتها كانت لك نافلة ، وإلا كنت قد أحرزت صلاتك ) )(@)(@@) ( م ت ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27200 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! إني أراك ضعيفا وإني أحب لك ما أحب لنفسي ، لا تتأمرن على اثنين ، ولا تولين مال يتيم ) )(@)(@@) ( م د ن ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27201 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! إني لأعرف آية لو أن الناس كلهم أخذوا بها لكفتهم : { ومن يتق الله يجعل له مخرجا ورزقه من حيث لا يحتسب } ) )(@)(@@) ( حم ن ه حب ك ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27202 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! لأن تغدو فتعلم آية من كتاب الله خير لك من أن تصلي مائة ركعة ، وأن تغدو فتعلم بابا من العلم عمل به أو لم يعمل خير لك من أن تصلي ألف ركعة تطوعا ) )(@)(@@) ( ه ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27203 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! ما أحب أن لي أحدا ذهبا أمسي ثالثة وعندي منه دينار إلا دينارا أرصده لدين إلا أن أقول به في عباد الله هاكذا وهاكذا وهاكذا ، يا أبا 
ms2878	 ذر ! الأكثرون هم لأقلون إلا من قال : هاكذا وهاكذا ) )(@)(@@) ( حم ق ) عن PageV09P063 أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27204 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! ما أحب أن لي مثل أحد ذهبا أنفقه كله إلا ثلاثة دنانير ) )(@)(@@) ( حم ق ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27205 قال النبي :(@)(@@) | 30 ( يا أبا ذر ! هل تدري أين تذهب الشمس إذا غابت ؟ فإنها تذهب حتى تأتي العرش فتسجد بين يدي ربها ، فتستأذن في الرجوع فيأذن لها وكأنها قد قيل لها ارجعي من حيث جئت فتطلع من مغربها فذالك مستقرها ) )(@)(@@) ( حم ق 3 ) عن أبي ذر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27206 قال النبي :(@)(@@) | 30 ( يا أبا رزين ! أليس كلكم يرى القمر ليلة البدر مخليا به ، فإنما هو خلق من خلق الله ، فالله أجل وأعظم ) )(@)(@@) ( حم د ه ك عن أبي رزين رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27207 قال النبي :(@)(@@) | 30 ( يا أبا سعيد ! من رضي بالله ربا ، وبالإسلام دينا ، وبمحمد نبيا وجبت له الجنة وأخرى يرفع بها العبد مائة درجة في الجنة ، ما بين كل درجتين كما بين السماء والأرض ، الجهاد في سبيل الله ، الجهاد في سبيل الله ، الجهاد في سبيل الله ) )(@)(@@) ( حم م ن ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27208 قال النبي :(@)(@@) | 30 ( يا أبا عمير ! ما فعل النعير ؟ ) )(@)(@@) ( حم خ ت ن ه ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27209 قال النبي :(@)(@@) | 30 ( يا أبا موسى ! لقد أوتيت مزمارا من مزامير آل داود ) )(@)(@@) PageV09P064 ( خ ت ) عن أبي موسى رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27210 قال النبي :(@)(@@) | 30 ( يا أبا هريرة ! جف القلم بما أنت لاق فاختص على ذالك أو ذر ) )(@)(@@) ( خ ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27211 قال النبي :(@)(@@) | 30 ( يا أبا هريرة ! كن ورعا تكن من أعبد الناس ، وارض بما قسم الله لك تكن من أغنى الناس . وأحب للمسلمين والمؤمنين ما تحب لنفسك وأهل بيتك ، واكره لهم ما تكره لنفسك وأهل بيتك تكن مؤمنا ، وجاور من جاورت 
ms2879	 بإحسان تكن مسلما ، وإياك وكثرة الضحك فإن كثرة الضحك فساد القلب ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27212 قال النبي :(@)(@@) | 30 ( يا ابن آدم ! إنك إن تبذل الفضل خير لك ، وإن تمسكه شر لك ، ولا تلام على كفاف ، وابدأ بمن تعول ، واليد العليا خير من اليد السفلى ) )(@)(@@) ( حم م ت ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27213 قال النبي :(@)(@@) | 30 ( يا ابن آدم ! هل تدري ما تمام النعمة ! الفوز من النار ، ودخول الجنة ) )(@)(@@) ( حم خد ت ) عن معاذ رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27214 قال النبي :(@)(@@) | 30 ( يا ابن الأكوع ! ملكت فأسجح ) )(@)(@@) ( خ ) عن سل مة بن الأكوع رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27215 قال النبي :(@)(@@) | 30 ( يا ابن الخصاصية ! ما أصبحت تنقم على الله أصبحت تماشي رسول الله ) )(@)(@@) ( حم ه ) عن بشير بن الخصاصية رضي الله عنه .(@)(@@)(@@)(@@) $ 27216 قال النبي :(@)(@@) | 30 ( يا ابن الخطاب ! اذهب فناد في الناس : إنه لا يدخل الجنة إلا المؤمنون ) )(@)(@@) ( حم م ) عن عمر رضي الله عنه ( ز ) .(@)(@@) PageV09P065(@)(@@)(@@)(@@) $ 27217 قال النبي :(@)(@@) | 30 ( يا ابن حوالة ! إذا رأيت الخلافة قد نزلت الأرض المقدسة فقد دنت الزلازل والبلابل والأمور العظام ، والساعة يومئذ أقرب من الناس من يدي هاذه من رأسك ) )(@)(@@) ( حم د ك ) عن العرباض رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27218 قال النبي :(@)(@@) | 30 ( يا ابن عايش ! ألا أخبرك بأفضل ما تعوذ به المتعوذون ؟ { قل أعوذ برب الفلق } ، و { قل أعوذ برب الناس } هاتين السورتين ) )(@)(@@) ( ن ) عن ابن عايش الجهني رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27219 قال النبي :(@)(@@) | 30 ( يا ابن عوف ! اركب فرسك ثم ناد : أن الجنة لا تحل إلا لمؤمن ) )(@)(@@) ( د ) عن العرباض رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27220 قال الن بي :(@)(@@) | 30 ( يا أبي ! إن ربي تبارك وتعالى أرسل إلي أن اقرإ القرآن على حرف ، فرددت إليه أن هون على أمتي ، فأرسل إلي الثانية : أن اقرأه على حرفين ، فرددت إليه أن هون على أمتي ، فأرسل إلي الثالثة أن اقرأه على سبعة أحرف ولك بكل ردة رددتها 
ms2880	 مسألة تسألنيها ، فقلت : اللهم اغفر لأمتي ، اللهم اغفر لأمتي ، وأخرت الثالثة ليوم يرغب إلي فيه الخلق كلهم حتى إبراهيم ) )(@)(@@) ( حم م ) عن أبي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27221 قال الن بي :(@)(@@) | 30 ( يا أبي ! إنه أنزل القرآن على سبعة أحرف ، كلهم شاف كاف ) )(@)(@@) ( ن ) عن أبي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27222 قال الن بي :(@)(@@) | 30 ( يا أبي ! إني أقرئت القرآن فقيل لي على حرف أو حرفين ؟ فقال الملك الذي معي قل : على حرفين ، قلت : على حرفين ، فقيل لي : على حرفين أو ثلاثة ؟ فقال الملك الذي معي قل : على ثلاثة ، قلت : على ثلاثة ، حتى بلغ سبعة أحرف ثم قال : ليس منها إلا شاف كاف ، إن قلت سميعا عليما ، وإن PageV09P066 قلت عزيزا حكيما ما لم تختم آية عذاب برحمة ، أو آية رحمة بعذاب ) )(@)(@@) ( د ) عن أبي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27223 قال النبي :(@)(@@) | 30 ( يا أخا سبإ لا بد من صدقة ) )(@)(@@) ( د ) عن أبيض بن حمال رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27224 قال النبي :(@)(@@) | 30 ( يا إخواني ! لمثل هاذا اليوم فأعدوا ) )(@)(@@) ( ه هق ) عن البراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27225 قال النبي :(@)(@@) | 30 ( يا أخي ! أشركنا في صالح دعائك ولا تنسنا ) )(@)(@@) ( حم ه ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27226 قال النبي :(@)(@@) | 30 ( يا أسامة ! أتشفع في حد من حدود الله ؟ ) )(@)(@@) ( ق د ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27227 قال النبي :(@)(@@) | 30 ( يا أسامة ! كيف تصنع بلا إله إلا الله إذا جاءت يوم القيامة ) )(@)(@@) ( م ) عن جندب الطيالسي ، والبزار عن أسامة بن زيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27228 قال النبي :(@)(@@) | 30 ( يا أسماء ! إن المرأة إذا بلغت المحيض لم يصلح أن يرى منها شيء إلا هاذا وهاذا ، وأشار إلى وجهه وكفيه ) )(@)(@@) ( د ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 27229 قال النبي :(@)(@@) | 30 ( يا أشج ! إن فيك لخلصتين يحبهما الله : الحلم والتؤدة ) )(@)(@@) ( ه ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 27230 قال النبي :(@)(@@) | 30 ( يا أعرابي ! إن الله غضب على سبطين من بني 