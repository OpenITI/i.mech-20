ms2621	 ليهلن ابن مريم بفج الروحاء حاجا أو معتمرا وليلبينهما ) )(@)(@@) ( حم م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24512 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ما أنزل في التوراة ولا في الإنجيل ولا في الزبور ولا في الفرقان مثلها ، يعني أم القرآن وإنها لسبع من المثاني والقرآن العظيم الذي أعطيته ) )(@)(@@) ( حم ت ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24513 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما من رجل يدعو امرأته إلى فراشه فتأبى عليه إلا كان الذي في السماء ساخطا عليها حتى يرضى عنها ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24514 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، والذي نفسي بيده ، والذي نفسي بيده ، ما من عبد يصلي الصلوات الخمس ، ويصوم رمضان ، ويخرج الزكاة ، PageV08P075 ويجتنب الكبائر السبع إلا فتحت له أبواب الجنة فقيل له ادخل الجنة بسلام ) )(@)(@@) ( ن حب ك ) عن أبي هريرة وأبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24515 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا تدخلون الجنة حتى تؤمنوا ، ولا تؤمنون حتى تحابوا ، أولا أدلكم على شيء إذا فعلتموه تحاببتم ؟ أفشوا السلام بينكم ) )(@)(@@) ( حم م د ت ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24516 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا تذهب الدنيا حتى يمر الرجل على القبر فيتمرغ عليه ويقول : يا ليتني كنت مكان صاحب هاذا القبر ، وليس به الدين إلا البلاء ) )(@)(@@) ( م ه ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24517 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا تقوم الساعة حتى تقتلوا إمامكم ، وتجتلدوا بأسيافكم ، ويرث دنياكم شراركم ) )(@)(@@) ( حم ت ه ) عن حذيفة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24518 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا تقوم الساعة حتى تكلم السباع الإنس ، وحتى يكلم الرجل عذبة سوطه ، وشراك نعله ، ويخبره فخذه بما يحدث أهله بعده ) )(@)(@@) ( حم ت حب ك ) عن أبي سعيد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24519 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا يؤمن أحدكم حتى أكون أحب إليه من والده وولده 
ms2622	 ) )(@)(@@) ( حم خ ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24520 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا يؤمن عبد حتى يحب لأخيه ما يحب لنفسه من الخير ) )(@)(@@) ( حم ن ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24521 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا يؤمن عبد حتى يحب لجاره ما يحب لنفسه ) )(@)(@@) ( م ) عن أنس رضي الله عنه ( ز ) .(@)(@@) PageV08P076(@)(@@)(@@)(@@) $ 24522 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لا يدخل قلب رجل الإيمان حتى يحبكم لله ولرسوله : يا أيها الناس من آذى عمي فقد آذاني ، فإنما عم الرجل صنو أبيه ) )(@)(@@) ( حم ت ك ) عن عبد المطلب بن ربيعة ، ( ك ) عن العباس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24523 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا يكلم أحد في سبيل الله والله أعلم بمن يكلم في سبيله إلا جاء يوم القيامة وجرحه يشخب ، اللون لون الدم ، والريح ريح المسك ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24524 قال النبي :(@)(@@) | 30 ( والله إنك لخير أرض الله وأحب أرض الله إلي ، ولولا أني أخرجت منك ما خرجت ) )(@)(@@) ( حم ت ه حب ك ) عن عبد الله بن عدي بن الحمراء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24525 قال النبي :(@)(@@) | 30 ( والله إني لأرجو أن أكون أخشاكم لله وأعلمكم بما أتقي ) )(@)(@@) ( م د ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ 24526 قال النبي :(@)(@@) | 30 ( والله إني لأستغفر الله وأتوب إليه في اليوم أكثر من سبعين مرة ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24527 قال النبي :(@)(@@) | 30 ( والله إني لأسمع بكاء الصبي وأنا في الصلاة فاحفف مخافة أن تفتتن أمه ) )(@)(@@) ( ت ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24528 قال النبي :(@)(@@) | 30 ( والله لأن يلج أحدكم بيمينه في أهله إثم له عند الله من أن يعطي كفارته التي افترض الله عليه ) )(@)(@@) ( حم ق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24529 قال النبي :(@)(@@) | 30 ( والله لأن يهدى بهداك واحد خير لك من حمر النعم ) )(@)(@@) ( د ) عن سهل بن سعد رضي الله 
ms2623	 عنه .(@)(@@)(@@)(@@) $ 24530 قال النبي :(@)(@@) | 30 ( والله لا يلقي الله حبيبه في النار ) )(@)(@@) ( حم ع ) و ابن منيع ، PageV08P077 ( ك ص ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24531 قال النبي :(@)(@@) | 30 ( والله للدنيا أهون على الله من هاذا عليكم ) )(@)(@@) ( حم م د ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24532 قال النبي :(@)(@@) | 30 ( والله لله أشد فرحا بتوبة عبده من رجل كان في سفر في فلاة من الأرض فأوى إلى ظل شجرة فنام تحتها ، واستيقظ فلم يجد راحلته ، فأتى شرفا فصعد عليه فأشرف فلم ير شيئا ، ثم أتى آخر فأشرف فلم ير شيئا ، فقال : أرجع إلى مكاني الذي كنت فيه فأكون فيه حتى أموت ، فذهب فإذا براحلته تجر خطامها ، فالله أشد فرحا بتوبة عبده من هاذا براحلته ) )(@)(@@) ( حم م ) عن النعمان بن بشير رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24533 قال النبي :(@)(@@) | 30 ( والله ليبعثنه الله يوم القيامة يعني الحجر له عينان يبصر بهما ، ولسان ينطق به ، يشهد على من استلمه بحق ) )(@)(@@) ( ت ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ 24534 قال النبي :(@)(@@) | 30 ( والله لينزلن ابن مريم حكما عادلا ، فليكسرن الصليب ، وليقتلن الخنزير ، وليضعن الجزية وليتركن القلاص فلا يسعى عليها ، ولتذهبن الشحناء والتباغض والتحاسد ، وليدعون إلى المال فلا يقبله أحد ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24535 قال النبي :(@)(@@) | 30 ( والله ما الدنيا في الآخرة إلا مثل ما يجعل أحدكم إصبعه هاذه في اليم فلينظر بم يرجع ؟ ) )(@)(@@) ( حم م ه ) عن المستورد رضي الله عنه .(@)(@@)(@@)(@@) $ 24536 قال النبي :(@)(@@) | 30 ( والله ما زال الشيطان يأكل معه حتى سمى ، فلم يبق في بطنه شيء إلا قاءه ) )(@)(@@) ( حم د ن ك ) عن أمية بن مخشى رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24537 قال النبي :(@)(@@) | 30 ( والله لا تجدون بعدي أعدل عليكم مني ) )(@)(@@) ( طب ك ) عن أبي هريرة ، ( حم ) عن أبي سعيد رضي الله عنه .(@)(@@) PageV08P078(@)(@@)(@@)(@@) $ 24538 قال النبي :(@)(@@) | 30 ( والله لا يؤمن ، والله لا يؤمن ، والله لا يؤمن ، الذي لا يأمن جاره بوائقه ) )(@)(@@) ( حم خ ) عن أبي شريح رضي 
ms2624	 الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24539 قال النبي :(@)(@@) | 30 ( وايم الله لا أقبل بعد يومي هاذا من أحد هدية إلا أن يكون مهاجرا قرشيا ، أو أنصاريا ، أو دوسيا ، أو ثقفيا ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24540 قال النبي :(@)(@@) | 30 ( وأي المؤمن حق واجب ) )(@)(@@) ( د ) في مراسيله عن زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ 24541 قال النبي :(@)(@@) | 30 ( وأي داء أدوى من البخل ) )(@)(@@) ( حم ق ) عن جابر ، ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24542 قال النبي :(@)(@@) | 30 ( وأي وضوء أفضل من الغسل ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24543 قال النبي :(@)(@@) | 30 ( والله إنك لخير أرض الله وأحب أرض الله إلي ، ولولا أني أخرجت منك ما خرجت ) )(@)(@@) ابن سعد ( ك ) وتعقب عن عبد الرحمان بن الحارث بن هشام عن أبيه .(@)(@@)(@@)(@@) $ 24544 قال النبي :(@)(@@) | 30 ( والله لقد سبق إلى جنات عدن أقوام ، ما كانوا أكثر الناس صلاة ولا صياما ولا حجا ولا اعتمارا ، ولاكنهم عقلوا عن الله مواعظ فوجلت قلوبهم ، واطمأنت إليه النفوس ، وخشعت منهم الجوارح ، ففاقوا الخليقة بطيب المنزلة ، وبحسن الدرجة عند الناس وعند الله في الآخرة ) )(@)(@@) ابن السني وابن شاهين والديلمي عن علي رضي الله عنه .(@)(@@) PageV08P079(@)(@@)(@@)(@@) $ 24545 قال النبي :(@)(@@) | 30 ( والله لا يقسم ورثتي بعدي دينارا ، ما تركت من شيء بعد نفقة نسائي ومؤنة عاملي فهو صدقة ) )(@)(@@) ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24546 قال النبي :(@)(@@) | 30 ( والله ما تعدل الدنيا جديا ذكرا من الغنم ) )(@)(@@) هناد عن الحسن مرسلا .(@)(@@)(@@)(@@) $ 24547 قال النبي :(@)(@@) | 30 ( والله لا تدع مضر عبدا إلا فتنوه أو قتلوه أو يضربهم الله والمؤمنون حتى لا يمنعوا ذنب تلعة ) )(@)(@@) ( حم ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24548 قال النبي :(@)(@@) | 30 ( والله لتصلين ، والله لا يعصى الله جهارا ) )(@)(@@) ابن منده وأبو نعيم عن الحكم بن مرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24549 قال النبي :(@)(@@) | 30 ( والله إني لاحبكما لحب الله إياكما ، إن الملائكة لتحبكما لحب الله إياكما ، أحب الله من أحبكما ، وصل الله من وصلكما ، قطع 
ms2625	 الله من قطعكما ، أبغض الله من أبغضكما في دنياكما وآخرتكما قاله لأبي بكر وعمر رضي الله عنهما ) )(@)(@@) ابن عساكر عن أبي سعيد رضي الله عنه ، وفيه داود بن سليمان الشيباني ضعيف .(@)(@@)(@@)(@@) $ 24550 قال النبي :(@)(@@) | 30 ( والله ما علمته إذ كان جاهلا ولا أطعمته إذ كان ساغبا ) )(@)(@@) ابن سعد ( طب ) عن عباد بن شرحبيل رضي الله عنه .(@)(@@)(@@)(@@) $ 24551 قال النبي :(@)(@@) | 30 ( والله لأغزون قريشا ، والله لأغزون قريشا ، والله لأغزون قريشا إن شاء الله ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24552 قال النبي :(@)(@@) | 30 ( والله يا تميمة لا ترجعن إلى عبد الرحمان حتى يذوق عسيلتك رجل غيره ) )(@)(@@) ( طب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24553 قال النبي :(@)(@@) | 30 ( والله إنهما لأثقل في الميزان من أحد يعني ساقي PageV08P080 ابن مسعود ) )(@)(@@) ( طب ) عن أبي الطفيل رضي الله عنه .(@)(@@)(@@)(@@) $ 24554 قال النبي :(@)(@@) | 30 ( والله لقد رأيت كلامك يصعد في السماء حتى فتح باب فدخل فيه ) )(@)(@@) ( حم ) عن عبد الله بن أبي أوفى ا رضي الله عنه أن رجلا دخل في الصف فقال : الله أكبر كبيرا ، والحمد لله بكرة وأصيلا ، فلما انصرف رسول الله قال فذكره .(@)(@@)(@@)(@@) $ 24555 قال النبي :(@)(@@) | 30 ( والله يا معشر قريي لتقيمن الصلاة ولتؤتن الزكاة ، أو لأبعثن عليكم رجلا فيضرب أعناقكم على الدين وحاضر النعل ) )(@)(@@) ( ك ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 24556 قال النبي :(@)(@@) | 30 ( والله لا تجدون أعدل عليكم مني ) )(@)(@@) ( طب ك ) عن أبي برزة رضي الله عنه .(@)(@@)(@@)(@@) $ 24557 قال النبي :(@)(@@) | 30 ( والله إنكم لتبخلون وتجبنون وتجهلون ، وإنكم لمن ريحان الله وإن آخر وطبة وطبها رب العالمين ) )(@)(@@) ( بز خ حم طب هق ) عن خولة بنت حكيم رضي الله عنها .(@)(@@)(@@)(@@) $ 24558 قال النبي :(@)(@@) | 30 ( والله لا يؤمن أحدكم حتى أكون أحب إليه من ولده ووالده ) )(@)(@@) ( ك ) عن فاطمة بنت عتبة رضي الله عنها .(@)(@@)(@@)(@@) $ 24559 قال النبي :(@)(@@) | 30 ( والله لا يدخل قلب امرىء إيمان حتى يحبكم لله ولقرابتي ) )(@)(@@) ( حم ) عن المطلب بن ربيعة رضي الله عنه .(@)(@@)(@@)(@@) $ 24560 قال النبي :(@)(@@) | 30 ( والله لا يخرج من 
ms2626	 النار من دخلها حتى يكونوا فيها أحقابا ، والحقب بضع وثمانون سنة ، والسنة ثلاثمائة وستون يوما ، كل يوم كألف PageV08P081 سنة مما تعدون ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24561 قال النبي :(@)(@@) | 30 ( والله للدنيا أهون على الله من هاذا عليكم ) )(@)(@@) ( حم م د ) و أبو عوانة عن جابر أن رسول الله مر بجدي أسك ميت فقال : بكم تحبون أن هاذا لكم ؟ قالوا : ما نحب أنه لنا بشيء وما نصنع به ؟ قال فذكره .(@)(@@)(@@)(@@) $ 24562 قال النبي :(@)(@@) | 30 ( والله لأستغفرن لك ما لم أنه عنك قاله لأبي طالب ) )(@)(@@) ( خ م ) عن سعيد بن المسيب عن أبيه .(@)(@@)(@@)(@@) $ 24563 قال النبي :(@)(@@) | 30 ( والله لا أزال بين ظهرانيهم ينازعوني ردائي ويصيبني غبارهم حتى يكون الله يريحني منهم ) )(@)(@@) ابن سعد عن عكرمة قال : قال العباس : يا رسول الله لو اتخذت عرشا فإن الناس قد آذوك قال فذكره .(@)(@@)(@@)(@@) $ 24564 قال النبي :(@)(@@) | 30 ( والله لقد آمنت بي حين كفر بي الناس ، وواستني حين طردني الناس ، وأعطتني مالها فأنفقته في سبيل الله تعالى ، ورزقني الله منها الولد وما رزقني من واحدة منكن يعني خديجة ) )(@)(@@) ( طب ) و الخطيب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24565 قال النبي :(@)(@@) | 30 ( والله لأحببته في الله فإن لك تحية الجنة والقه بها فإنه أبقى في المودة وخير في المعاد ) )(@)(@@) ابن النجار عن سلمان رضي الله عنه .(@)(@@)(@@)(@@) $ 24566 قال النبي :(@)(@@) | 30 ( والله الذي لا إلاه إلا هو ليغفرن الله يوم القيامة مغفرة ما خطرت على قلب بشر ، والله الذي لا إلاه إلا هو ليغفرن الله يوم القيامة للفاجر في ذنبه ، الأحمق في معيشته ) )(@)(@@) الديلمي عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24567 قال النبي :(@)(@@) | 30 ( والله ليشفعن عثمان بن عفان في سبعين ألفا من أمتي قد استوجبوا النار حتى يدخلهم الله الجنة ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@) PageV08P082(@)(@@)(@@)(@@) $ 24568 قال النبي :(@)(@@) | 30 ( والله ما من نبي إلا وولد الأنبياء غيري ، وإن ابنيك سيدا شباب أهل الجنة إلا ابني الخالة يحيى وعيسى قاله لفاطمة رضي الله عنها 
ms2627	 ) )(@)(@@) ( طب ) و أبو نعيم في فضائل الصحابة عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 24569 قال النبي :(@)(@@) | 30 ( والله لا يؤمن ، والله لا يؤمن ، والله لا يؤمن ، قالوا : من ؟ قال : جار لا يأمن جاره بوائقه ، قالوا : ما بوائقه ؟ قال : شره ) )(@)(@@) ( حم ك ) عن أبي هريرة ، ( حم ) عن أبي شريح الكعبي رضي الله عنه .(@)(@@)(@@)(@@) $ 24570 قال النبي :(@)(@@) | 30 ( والذي لا إلاه إلا هو لو أجد لكم الخبز واللحم لأطعمتكموه ، وإنه لعله أن تدركوا زمانا أو من أدركه منكم تلبسون فيه مثل أستار الكعبة يغدو عليكم ويراح فيه بالجفان ) )(@)(@@) ( حم حب طب ض ) عن طل حة بن عمرو النضري رضي الله عنه .(@)(@@)(@@)(@@) $ 24571 قال النبي :(@)(@@) | 30 ( والذي بعثني بالحق ليكونن بعدي فترة في أمتي تبتغي فيها المال من غير حله ، ويسفك فيها الدماء ، ويستبدل بها الشعر من القرآن ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24572 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ليخرجن من أمتي من قبورهم في صورة القردة والخنازير بمداهنتهم في المعاصي وكفهم عن النهي وهم يستطيعون ) )(@)(@@) أبو نعيم عن عبد الرحمان بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ 24573 قال النبي :(@)(@@) | 30 ( والذي نفس أبي القاسم بيده ، ما أهل مهل ، ولا كبر مكبر على شرف من الأرض إلا أهل ما بين يديه وكبر ما بين يديه بتكبيرة وتهليلة حتى ينقطع منقطع التراب ) )(@)(@@) أبو الشيخ عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 24574 قال النبي :(@)(@@) | 30 ( والذي بعثني بالحق ما اقتبس في آل محمد نار PageV08P083 منذ ثلاثين يوما ، فإن شئت أمرت لك بخمسة أعنز ، وإن شئت علمتك كلمات علمهن جبريل ، قولي : يا أول الأولين ، ويا آخر الآخرين ، ويا ذا القوة المتين ، ويا راحم المساكين ، ويا أرحم الراحمين ) )(@)(@@) أبو الشيخ في فوائد الأصبهانيين ، والديلمي عن فاطمة البتول ، وفيه إسماعيل بن عمر والبجلي ، قال أبو حاتم والدارقطني ضعيف ، وذكره ابن حبان في الثقات .(@)(@@)(@@)(@@) $ 24575 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده إنها لتعدل ثلث القرآن يعني { قل هو الله أحد } ) )(@)(@@) ( حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24576 
ms2628	 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، إن مثل المؤمن كمثل القطعة من الذهب ، ينفخ عليها صاحبها فلم تتغير ولم تنقص ، والذي نفسي بيده ، إن مثل المؤمن كمثل النخلة ، أكلت طيبا ، ووضعت طيبا ، لم تكسر ولم تفسد ) )(@)(@@) ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24577 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، ما خرج أحد من المدينة رغبة عنها إلا أبدلها الله خيرا منه أو مثله ) )(@)(@@) ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24578 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لتركبن سنن الذين من قبلكم حذو النعل بالنعل ) )(@)(@@) ( حم طب ) عن سهل بن سعد رضي الله عنه .(@)(@@)(@@)(@@) $ 24579 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده لو أصبح فيكم موساى ثم اتبعتموه وتركتموني لضللتم ضلالا بعيدا ، لأنكم حظي من الأمم ، وأنا حظكم من الأنبياء ) )(@)(@@) ابن سعد ، ( حم ) والحاكم في الكنى ا ، ( طب هب ) عن عبد الله بن ثابت الأنصاري ، ( طب ) عن أبي الدرداء ، ( هب ) عن عبد الله ابن الحارث رضي الله عنهم .(@)(@@) PageV08P084(@)(@@)(@@)(@@) $ 24580 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لكأني أنظر إليه في الجنة يعوم عوما ) )(@)(@@) ( ن ) الدعموص يعنى عامر بن الأكوع ، ( طب ) عن سلمة : هو ابن الأكوع رضي الله عنه .(@)(@@)(@@)(@@) $ 24581 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لعبد الله في الموازين يوم القيامة أثقل من أحد ) )(@)(@@) ( طب ) عن سارة بنت عبد الله بن مسعود رضي الله عنه عن أبيها .(@)(@@)(@@)(@@) $ 24582 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده إنه ليخفف عن المؤمن حتى يكون أهون عليه من صلاة مكتوبة يصليها في الدنيا يعني يوم القيامة ) )(@)(@@) ( حم ع ) و ابن جرير ، ( حب هق ) في البعث ، ( ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24583 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إنه ليختصم حتى الشاتان فيم انتطحتا ) )(@)(@@) ( حم ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24584 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لو أن قطرة من الزقوم قطرت في بحار الأرض لفسدت ، فكيف بمن يكون طعامه ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24585 قال النبي 
ms2629	 :(@)(@@) | 30 ( والذي نفسي بيده ، لا يبغضنا أهل البيت أحد إلا كبه الله في النار ) )(@)(@@) ( حب ك ) وتعقب ( ض ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24586 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لتدخلن الجنة كلكم إلا من أباى ، وشرد علاى الله شراد البعير ، قيل : يا رسول الله ومن يأباى أن لا يدخل الجنة ؟ قال : من أطاعني دخل الجنة ، ومن عصاني فقد أباى ) )(@)(@@) ولفظ ( طس ) : دخل النار ( صس حب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ 24587 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، لو تعلمون ما أعلم في PageV08P085 المسألة ، ما سأل رجل رجلا وهو يجد ليلة تقيه ) )(@)(@@) ( حم ن ) و الروياني وأبو عوانة ( ض ) عن عائذ بن عمرو المزني رضي الله عنه .(@)(@@)(@@)(@@) $ 24588 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا يؤمن أحدكم حتى يحبكم لحبي ، أترجون أن تدخلوا الجنة بشفاعتي ولا يرجوها بنو عبد المطلب ) )(@)(@@) ( ك ) عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ 24589 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لتخرجن من هاذا المسجد فتن كصياصي البقر ) )(@)(@@) أبو نعيم عن سبرة بن أبي سبرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24590 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لا يلي مسلم يتيما فيحسن ولايته ، ويضع يده على رأسه إلا رفعه الله عز وجل بكل شعرة درجة ، وكتب له بكل شعرة حسنة ، ومحى عنه بكل شعرة سيئة ) )(@)(@@) الخرائطي في مكارم الأخلاق وابن النجار عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ 24591 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما من امرأة تضع ثيابها في غير بيت إحدى أمهاتها إلا وهي هاتكة كل ستر بينها وبين الرحمان عز وجل ) )(@)(@@) ( حم طب ) و ابن عساكر عن سهل بن معاذ بن أنس عن أبيه عن أم الدرداء رضي الله عنها .(@)(@@)(@@)(@@) $ 24592 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إن في الجنة لبابا يسمى الريان ينادى عليه يوم القيامة : أين الصائمون هلموا إلى باب الريان ، لا يدخل معهم أحد غيرهم ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24593 
ms2630	 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، لو بدا لكم موسى فاتبعتموه وتركتموني لضللتم عن سواء السبيل ، ولو كان حيا وأدرك بنبوتي لاتبعني ) )(@)(@@) الدارمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24594 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لقد ابتدرها بضعة وثلاثون ملكا أيهم يصعد بها ) )(@)(@@) ( ن ) و ابن قانع ( هق ) عن رفاعة بن رافع قال : صليت خلف PageV08P086 رسول الله فعطست فقلت : الحمد لله حمدا كثيرا طيبا مباركا عليه كما يحب ربنا ويرضى قال فذكره .(@)(@@)(@@)(@@) $ 24595 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لقتل مؤمن أعظم عند الله من زوال الدنيا ) )(@)(@@) ( ن هب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 24596 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، ما بقي من دنياكم فيما مضى منها إلا كما بقي من يومكم هاذا فيما مضى منه ، وما يرى من الشمس إلا اليسير ) )(@)(@@) سمويه ( ص ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24597 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، ما امتلأت دار حبرة إلا امتلأت عبرة ، وما كانت فرحة إلا تبعتها ترحة ) )(@)(@@) ابن المبارك عن يحيى بن أبي كثير مرسلا .(@)(@@)(@@)(@@) $ 24598 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إن الرجل من أهل الجنة ليعطى قوة مائة رجل في المطعم والمشرب والشهوة والجماع ، قيل : فإن الذي يأكل ويشرب يكون له الحاجة ، قال : حاجة أحدهم عرق يفيض من جلودهم مثل ريح المسك ، فإذا البطن قد ضمر ) )(@)(@@) ( حم ) و هناد وعبد بن حميد والدارمي ( ع حب طب ض ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ 24599 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إن الرجل من أهل الجنة ليفضي في الغداة الواحدة إلى مائة عذراء ) )(@)(@@) ( هناد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24600 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ما لأحمر على أسود فضل إلا الفضل في دين ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24601 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إني لأنظر في الصلاة إلى من PageV08P087 ورائي ، كما أنظر إلى من بين يدي ، فسووا صفوفكم ، وأحسنوا ركوعكم وسجودكم ) )(@)(@@) ( عب ) عن أبي هريرة 
ms2631	 رضي الله عنه وهو صحيح .(@)(@@)(@@)(@@) $ 24602 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لو أنكم لا تذنبون فتستغفرون الله فيغفر لكم لذهب بكم ثم جاء بقوم يذنبون فيستغفرون فيغفر لهم ، ولو أنكم تخطئون حتى تبلغ خطاياكم السماء ثم تتوبون لتاب الله عليكم ) )(@)(@@) ابن زنجويه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24603 قال النبي :(@)(@@) | 30 ( والذي لا إلاه غيره ، لا يحل دم أحد يشهد أن لا إلاه إلا الله وأني رسول الله إلا باحدى ثلاث : التارك الإسلام ، المفارق للجماعة ، والثيب الزاني ، والنفس بالنفس ) )(@)(@@) ابن النجار عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24604 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، لخلوف فم الصائم أطيب عند الله من ريح المسك ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 24605 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، ما عمل أحد قط سرا إلا ألبسه الله رداء علانيته ، إن خيرا فخيرا وإن شرا فشرا ) )(@)(@@) ابن جرير عن عثمان رضي الله عنه .(@)(@@)(@@)(@@) $ 24606 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لو أتاكم يوسف وأنا نبيكم فاتبعتموه وتركتموني لضللتم ) )(@)(@@) ( عب هب ) عن الزهري مرسلا .(@)(@@)(@@)(@@) $ 24607 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا يسلم عبد حتى يسلم قلبه ، ولا يؤمن حتى يأمن جاره بوائقه ، قيل : وما بوائقه ؟ قال : غشه وظلمه ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24608 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما من أحد يتوب قبل موته بيوم PageV08P088 إلا قبل الله توبته ) )(@)(@@) البغوي عن رجل من الصحابة .(@)(@@)(@@)(@@) $ 24609 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، إن العبد ليأتي يوم القيامة وله حسنات أمثال الجبال الرواسي يظن أنه سيدخل بها الجنة ، فلا تزال مظلمته تأتيه حتى ما تبقى له حسنة وحتى يجعل عليه أمثال الجبال الرواسي ويؤمر به إلى النار ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24610 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما لأحمر على أسود فضل إلا بالفضل في دين الله عز وجل ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24611 قال النبي :(@)(@@) | 30 ( والذي نفسي 
ms2632	 بيده إن إبراهيم ليرغب في شفاعتي ) )(@)(@@) ( ك ) في تاريخه عن أبي بن كعب رضي الله عنه .(@)(@@)(@@)(@@) $ 24612 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إن فيكم لرجلا يقاتل الناس من بعدي على تأويل القرآن كما قاتلت المشركين على تنزيله وهم يشهدون أن لا إلاه إلا الله فيكبر قتلهم على الناس حتى يطعنوا على ولي الله تعالى ويسخطوا عمله كما سخط موسى أمر السفينة والغلام والجدار ، وكان ذالك كله رضى الله تعالى ) )(@)(@@) الديلمي عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ 24613 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إن الله عز وجل ليوحي إلى شجر الجنة أن اشغلي عبادي الذين شغلوا أنفسهم بذكري عن المعازف والمزامير فيسمعهم بأصوات ما سمع الخلائق مثلها بالتسبيح والتقديس ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24614 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لأن يأخذ أحدكم ترابا فيجعله في فيه خير له من أن يجعل في فيه ما حرم الله عليه ) )(@)(@@) ( ك ) في تاريخه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24615 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لسماع آية من كتاب الله أعظم PageV08P089 أجرا مثل صبير يتصدق به ، ولقراءة آية من كتاب الله أفضل من كل شيء دون العرش ) )(@)(@@) أبو الشيخ والديلمي عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ 24616 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ليعودن هاذا الأمر كما بدأ ، وليعودن كل إيمان إلى المدينة كما بدأ ، حتى يكون كل إيمان بالمدينة ) )(@)(@@) أبو نعيم عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ 24617 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما من شيء وعدتموه في الآخرة إلا قد عرض علي في مقامي هاذا حتى لقد عرضت علي النار فأقبل إلي منها شرر حتى حاذى خبائي هاذا ، فخشيت أن تغشاكم فقلت : أي رب وأنا فيهم ؟ فصرفها الله عنكم فأدبرت قطعا كأنها الزرابي فنظرت نظرة فرأيت عمران بن حربان بن الحارث أحد بني غفار متكئا في جهنم على فرس ، ورأيت فيها الحميرية صاحبة القطة التي ربطتها فلا هي أطعمتها ولا هي بعثتها ) )(@)(@@) ( طب ) عن عقبة بن 
ms2633	 عامر رضي الله عنه .(@)(@@)(@@)(@@) $ 24618 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما من عبد مسلم لبس ثوبا جديدا ثم يقول مثل ما قلت : الحمد لله الذي كساني ما أواري به عورتي ، وأتجمل به في حياتي ثم يعمد إلى سمل من أخلاقه الذي وضع فيكسوه إنسانا مسكينا فقيرا لا يكسوه إلا لله ، إلا كان في جوار الله وفي ضمان الله ما دام عليه منها سلك واحد حيا وميتا ) )(@)(@@) ( ك ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 24619 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لا يدخل الجنة إلا رحيم ، قالوا : كلنا رحيم ، قال : لا حتى ترحم العامة ) )(@)(@@) الحكيم عن أبي هريرة رضي الله عنه ، الحكيم عن الحسن مرسلا .(@)(@@)(@@)(@@) $ 24620 قال النبي :(@)(@@) | 30 ( والذي بعثني بالحق لا تنقضي هاذه الدنيا حتى يقع PageV08P090 بهم الخسف والمسخ والقذف ، قالوا : متى ذاك يا نبي الله ؟ قال : إذا رأيتم النساء قد ركبن السروج ، وكثرت القينات ، وشهد شهادات الزور ، وشرب الخمر لا يستخفى به ، وشرب المصلون في آنية أهل الشرك من الذهب والفضة ، واستغنى الرجال بالرجال والنساء بالنساء فاستغفروا واستعيذوا واتقوا القذف من السماء ) )(@)(@@) ( ك ) وتعقب ( عد هب ) وضعفه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24621 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، إن قدر ما بين شفير النار وقعرها لكصخرة زنتها خلفات بشحومهن ولحومهن وأولادهن يهوي فيما بين شفير النار وقعرها سبعين خريفا ) )(@)(@@) ( طب ) عن معاذ ، ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24622 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما من عبد يتصدق بصدقة حسنة طيبة فيضعها في جق إلا كانت تقع في يد الرحمان يربيها كما يربي أحدكم فصيله أو فلوه حتى إن التمرة واللقمة لتصير مثل الجبل العظيم ) )(@)(@@) الحكيم عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24623 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لو سكت لأعطيتني أذرعا ما دعوت به ) )(@)(@@) ( ت ) في الشمائل والبغوى ، ( طب ) عن أبي عبيد مولى رسول الله .(@)(@@)(@@)(@@) $ 24624 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لقد ابتدرها عشرة آلاف ملك كلهم حريص على أن 
ms2634	 يكتبها ، فما دروا كيف يكتبونها حتى رفعوها إلى ذي العزة فقال : اكتبوها كما قال عبدي يعني : الحمد لله حمدا طيبا مباركا فيه كما يحب ربنا أن يحمد وينبغي له ) )(@)(@@) ولفظ ( حب ) : ( كما يحب ربنا ويرضى ) ، ( حم ن حب ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24625 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لو أخطأتم حتى تملأ خطاياكم ما PageV08P091 بين السماء والأرض ثم استغفرتم الله لغفر لكم ، والذي نفسي بيده لو لم تخطئوا لجاء الله بقوم يخطئون ثم يستغفرون الله فيغفر لهم ) )(@)(@@) ( حم ع ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24626 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لقد سأل الله باسمه العظيم الذي إذا دعي به أجاب ، وإذا سئل به أعطى ) )(@)(@@) ( حم ن حب ) عن أنس رضي الله عنه قال : سمع النبي رجلا يدعو : اللهم إني أسألك بأن لك الحمد لا إلاه إلا أنت الحنان المنان بديع السماوات والأرض يا ذا الجلال والإكرام يا حي يا قيوم قال فذكره .(@)(@@)(@@)(@@) $ 24627 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده لأقتلنهم ولاصلبنهم ولأهدينهم وهم كارهون ، إني رحمة بعثني الله ولا يتوفاني حتى يظهر الله دينه ، لي خمسة أسماء : أنا محمد ، وأحمد ، وأنا الماحي الذي يمحو الله بي الكفر ، وأنا الحاشر الذي يحشر الناس على يدي ، وأنا العاقب ) )(@)(@@) ( طب ) عن محمد بن جبير بن مطعم عن أبيه .(@)(@@)(@@)(@@) $ 24628 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لجعيل بن سراقة خير من طلاع الأرض مثل عيينة والأقرع ولاكني أتألفهما ليسلما ، ووكلت جعيلا إلى إيمانه ) )(@)(@@) ابن إسحاق في المغازي عن محمد بن إبراهيم التيمي وهو مرسل حسن وله شاهد موصول ، إسناده صحيح من حديث أبي ذر ، رواه الروياني في مسنده وابن عبد الحكم في فتوح مصر .(@)(@@)(@@)(@@) $ 24629 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده إنه لمكتوب عند الله تبارك وتعالى في السماء السابعة : حمزة بن عبد المطلب أسد الله وأسد رسوله ) )(@)(@@) البغوي والباوردي ، ( طب ك ) وتعقب بن يحيى بن عبد الرحمان بن أبي لبيبة عن جده .(@)(@@) PageV08P092(@)(@@)(@@)(@@) $ 24630 قال النبي :(@)(@@) | 30 ( والذي نفسي 
ms2635	 بيده ، لا تقوم الساعة حتى يظهر الفحش والبخل ، ويخون الأمين ، ويؤتمن الخائن ، ويهلك الوعول ، ويظهر التحوت ، قيل : وما الوعول والتحوت ؟ قال : الوعول وجوه الناس ، والتحوت : الذين كانوا تحت أقدامهم ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24631 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، ليبيتن أناس من أمتي على أشر وبطر ولعب ولهو ، فيصبحون قردة وخنازير باستحلالهم المحرمات واتخاذهم القينات وشربهم الخمر ، وبأكلهم الربا ، ولبسهم الحرير ) )(@)(@@) ( عم ) في زوائد الزهد عن عبادة بن الصامت وعن عبد الرحمان بن غنم وعن أبي أمامة وعن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ 24632 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لو لم تكوني مسكينة لجررناك على وجهك ، أتغلب إحداكن أن تصاحب صويحبة في الدنيا معروفا ، فإذا حال بينه وبين من هو أولى به منه استرجع ثم قال : رب اسمي ما أمضيت فأعني على ما أبقيت ، فوالذي نفس محمد بيده إن أحدكم ليبكي فيستعير له صويحبه ، فيا عباد الله لا تعذبوا موتاكم ) )(@)(@@) ( طب ) عن قيلة بنت مخرمة رضي الله عنها .(@)(@@)(@@)(@@) $ 24633 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما من امرأة تضع ثيابها في غير بيت زوجها أو أمهاتها إلا وهي هاتكة كل ستر بينها وبين الرحمان ) )(@)(@@) ( طب ) عن أم الدرداء رضي الله عنها .(@)(@@)(@@)(@@) $ 24634 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لقد ظننت أنك أول من يسألني عن ذالك من أمتي لما رأيت من حرصك على العلم ، والذي نفسي بيده لما يهمني من انفصامهم على باب الجنة أهم عندي من تمام شفاعتي لهم ، وشفاعتي لمن يشهد أن لا إلاه إلا الله مخلصا وأن محمدا رسول الله يصدق لسانه قلبه ، وقلبه لسانه ) )(@)(@@) ( حب ك ) عن أبي هريرة رضي الله عنه قال : قلت : يا رسول الله ما رد إليك ربك في الشفاعة ؟ قال فذكره .(@)(@@) PageV08P093(@)(@@)(@@)(@@) $ 24635 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لا يؤمن أحدهم حتى يحبكم لحبي ، أترجون أن تدخلوا الجنة بشفاعتي ولا يرجوها بنو عبد المطلب ) )(@)(@@) ( طس ) عن عبد الله بن جعفر رضي الله عنه .(@)(@@)(@@)(@@) $ 24636 قال النبي 
ms2636	 :(@)(@@) | 30 ( والذي نفس محمد بيده ، إن المعروف والمنكر خليقتان ينصبان للناس يوم القيامة ، فأما المعروف فيبشر أصحابه ويعدهم الخير ، وأما المنكر فيقول إليكم إليكم وما يستطيعون له إلا لزاما ) )(@)(@@) ( حم ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ 24637 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ليختصمن كل شيء يوم القيامة حتى الشاتين فيما انتطحتا ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24638 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لساق عبد الله يعني ا| بن مسعود يوم القيامة أشد وأعظم من أحد وحراء ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24639 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لهما أثقل في الميزان يوم القيامة من أحد ) )(@)(@@) ( ك طب ) عن معاوية بن قرة عن أبيه ، ( حل ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24640 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما يسرني أن أحدا تحول لآل محمد ذهبا أنفقه في سبيل الله ، أموت يوم أموت وأدع منه دينارين ، إلا دينارين أعدهما لدين إن كان علي ) )(@)(@@) ( حم طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ 24641 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إن الدنيا أهون على الله من هاذه السخلة على أهلها ، ولو كانت الدنيا تعدل عند الله مثقال حبة خردل لم يعطها إلا PageV08P094 أولياءه وأحباءه من خلقه ) )(@)(@@) ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ 24642 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إنه ليرى بياض الأسود من الجنة من مسيرة ألف عام ) )(@)(@@) ( طب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ 24643 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، لقتل المؤمن أعظم عند الله يوم القيامة من زوال الدنيا ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 24644 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، ما أصبح عند آل محمد صاع حب ولا صاع تمر ) )(@)(@@) ( ه ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24645 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، لو كان أحد عندي ذهبا لأحببت أن لا يأتي علي ثلاث وعندي منه دينار أجد ، من يقبله مني ليس شيئا أرصده في دين 
ms2637	 علي ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24646 قال النبي :(@)(@@) | 30 ( والذي نفس محمد بيده ، ما من عبد يؤمن ثم يسدد إلا سلك به في الجنة ، وأرجو أن لا يدخلها أحد حتى تبوأوا أنتم ومن صلح من ذراريكم مساكن في الجنة ، ولقد وعدني ربي أن يدخل الجنة من أمتي سبعين ألفا بغير حساب ) )(@)(@@) ( ه هب ) عن رفاعة الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ 24647 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ليفتحن عليكم فارس والروم ، ولتصبن عليكم الدنيا صبا ، وليكثرن عندكم الخبز واللحم حتى لا يذكر على كثير منه اسم الله تعالى ) )(@)(@@) ( طب ) عن عبد الله بن بسر رضي الله عنه .(@)(@@)(@@)(@@) $ 24648 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إني لسيد الناس يوم القيامة بغير فخر ولا رياء ، وما من الناس إلا وهو تحت لوائي يوم القيامة ينتظرون الفرج ، وإن معي لواء الحمد فأمشي ويمشي الناس معي حتى آتي باب الجنة فأستفتح فيقال : من هاذا ؟ فأقول : محمد ، فيقال : مرحبا بمحمد ، فإذا رأيت ربي خررت له ساجدا PageV08P095 شكرا له ، فيقال : ارفع رأسك ، قل تطع ، واشفع تشفع ، فيخرج من النار من قد أجرم برحمة الله وشفاعتي ) )(@)(@@) ( طب ) عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ 24649 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ما على الأرض مسلم يصيبه أذى من مرض فما سواه إلا حط الله عنه خطاياه كما تحط الشجرة ورقها ) )(@)(@@) ( حم حب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 24650 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، ليأتين على الناس زمان لا يدري القاتل في أي شيء قتل ، ولا يدري المقتول في أي شيء قتل ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24651 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إنه لفي نهر من أنهار الجنة يتغمس فيه يعني ماعزا فقال هزال أنا أمرته أن يأتيك يا رسول الله ، قال : لو سترته بملحفتك كان خيرا ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 24652 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ليدخلن الجنة الفاجر في دينه ، الأحمق في معيشته 
ms2638	 ، والذي نفسي بيده ليدخلن الجنة الذي قد محشته النار بذنبه ، والذي نفسي بيده ليغفرن الله يوم القيامة مغفرة ما خطرت على قلب بشر ، والذي نفسي بيده ليغفرن الله يوم القيامة مغفرة يتطاول بها إبليس رجاء أن يصيبه ) )(@)(@@) ( طب هق ) في البعث عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ 24653 قال النبي :(@)(@@) | 30 ( والذي نفسي بيده ، إني لاحبكم إن الأنصار قد قضوا ما عليهم وبقي ما عليكم ، فأحسنوا إلى محسنهم وتجاوزوا عن مسيئهم ) )(@)(@@) ابن سعد عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24654 قال النبي :(@)(@@) | 30 ( والشاة إن رحمتها رحمك الله ) )(@)(@@) ( طب حم ك ) وتعقب عن معاوية بن قرة عن أبيه ، ( طب ) عن معقل بن يسار رضي الله عنه .(@)(@@) PageV08P096(@)(@@)(@@)(@@) ||| ( الواو مع الجيم(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ 24655 قال النبي :(@)(@@) | 30 ( وجب الخروج على كل ذات نطاق في العيدين ) )(@)(@@) ( حم ) عن عمرة بنت رواحة رضي الله عنها .(@)(@@)(@@)(@@) $ 24656 قال النبي :(@)(@@) | 30 ( وحبت أنتم شهداء الله في الأرض ) )(@)(@@) ( ت ه حب ) عن أنس ، ( حم ه حب ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24657 قال النبي :(@)(@@) | 30 ( وجبت صدقتك ، ورجعت إليك حديقتك ) )(@)(@@) ( حم ه ) عن ابن عمرو رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ 24658 قال النبي :(@)(@@) | 30 ( وجبت محبة الله على من أغضب فحلم ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنهما .(@)(@@)(@@)(@@) $ 24659 قال النبي :(@)(@@) | 30 ( وجهوا هاذا البيوت عن المسجد فإني لا أحل المسجد لحائض ولا جنب ) )(@)(@@) ( د ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ 24660 قال النبي :(@)(@@) | 30 ( وجب عليكم الأمر بالمعروف والنهي عن المنكر ما لم تخافوا أن يؤتى إليكم مثل الذي نهيتم عنه ، فإذا خفتم ذالك فقد حل لكم السكوت ) )(@)(@@) أبو نعيم والديلمي عن مسور رضي الله عنه .(@)(@@)(@@)(@@) $ 24661 قال النبي :(@)(@@) | 30 ( وجدت الحسنة نورا في القلب ، وزينا في الوجه ، PageV08P097 وقوة في العمل ، ووجدت الخطيئة سوادا في القلب ، ووهنا في العمل ، وشينا في الوجه ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 24662 قال النبي :(@)(@@) | 30 ( 