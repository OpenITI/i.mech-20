ms1381	 الوارث المنير الباعث القدير وفي لفظ المجيب المحيى المميت الحميد وفي لفظ الجميل الصادق الحفيظ المحيط الكبير القريب الرقيب الفتاح التواب القديم الوتر الفاطر الرزاق العلام العلي العظيم الغني الملك المقتدر الأكرم الرءوف المدبر المالك القاهر الهادي الشاكر الكريم الرفيع الشهيد الواحد ذا الطول ذا المعارج ذا الفضل الخلاق الكفيل الجليل(@)(@@) وأخرج أبو نعيم عن محمد بن جعفر قال سألت أبي جعفر بن محمد الصادق عن الأسماء التسعة والتسعين التى من أحصاها دخل الجنة فقال هى فى القرآن ففي الفاتحة خمسة أسماء يا ألله يا رب يا رحمن يا رحيم يا ملك وفي البقرة ثلاثة وثلاثون اسما يا محيط يا قدير يا عليم يا حكيم يا علي يا عظيم يا تواب يا بصير يا ولي يا واسع يا كافي يا رءوف يا بديع يا شاكر يا واحد يا سميع يا قابض يا باسط يا حي PageV02P269 ياقيوم ياغني ياحميد ياغفور ياحليم ياإله ياقريب يامجيب ياعزيز يانصير ياقوي ياشديد ياسريع ياخبير وفى آل عمران ياوهاب ياقائم ياصادق ياباعث يامنعم يامتفضل وفي النساء يارقيب ياحسيب ياشهيد يامقيت ياوكيل ياعلي ياكبير فى الأنعام يافاطر ياقاهر يالطيف يابرهان وفي الأعراف يامحيى يامميت وفي الأنفال يا نعم المولى ويا نعم النصير وفي هود ياحفيظ يامجيد ياودود يافعال لما تريد وفي الرعد ياكبير يامتعالى وفى إبراهيم يامنان ياوارث وفي الحجر ياخلاق وفي مريم يافرد وفي طه ياغفار وفي قد أفلح ياكريم وفي النور ياحق يامبين وفي الفرقان ياهادي وفي سبأ يافتاح وفي الزمر ياعالم وفي غافر ياقابل التوب ياذا الطول يارفيع وفي الذاريات يارزاق ياذا القوة يامتين وفي الطور يابر وفي اقتربت يامقتدر يامليك وفي الرحمن ياذا الجلال والإكرام يارب المشرقين يارب المغربين يا باقي يامعين وفي الحديد ياأول ياآخر ياظاهر ياباطن وفي الحشر ياملك ياقدوس ياسلام يامؤمن يا مهيمن ياعزيز ياجبار يامتكبر ياخالق يابارئ يامصور وفي البروج يامبدئ يامعيد وفي الفجر ياوتر وفي الإخلاص ياأحد ياصمد انتهى(@)(@@) وقد ذكر ابن حجر فى التلخيص أنه تتبعها من 
ms1382	 الكتاب العزيز إلى أن حرر هنا منه تسعة وتسعين ثم سردها فابحثه ويؤيد هذا ما أخرجه أبو نعيم عن ابن عباس وابن عمر قالا قال رسول الله صلى الله عليه وسلم لله تسعة وتسعون اسما من أحصاها دخل الجنة وهى في القرآن وأخرج البيهقي عن عائشة أنها قالت يا رسول الله علمني اسم الله الذى إذا دعى به أجاب قال لها قومي فتوضيء وادخلي المسجد فصلى ركعتين ثم ادعى حتى أسمع ففعلت فلما جلست للدعاء قال النبي صلى الله عليه وسلم اللهم وفقها فقالت اللهم إني أسألك بجميع أسمائك الحسنى كلها ما علمنا منها وما لم نعلم وأسألك باسمك العظيم الأعظم الكبير الأكبر الذى من دعاك به أجبته ومن سألك به أعطيته قال النبي صلى الله عليه وسلم أصبتيه أصبتيه(@)(@@) وقد أطال أهل العلم الكلام على الأسماء الحسنى حتى أن ابن العربي فى شرح الترمذي حكى عن بعض أهل العلم أنه جمع من الكتاب والسنة من أسماء الله ألف اسم وأخرج ابن جرير وابن أبي حاتم عن ابن عباس فى قوله @QB@ وذروا الذين يلحدون في أسمائه @QE@ قال الإلحاد أن يدعو اللات والعزى فى أسماء الله وأخرج ابن المنذر وابن أبي حاتم عنه قال الإلحاد التكذيب وأخرج ابن جرير وابن المنذر وأبو الشيخ عن ابن جريج فى الآية قال اشتقوا العزى من العزيز واشتقوا اللات من الله وأخرج ابن أبي حاتم عن عطاء فى الآية قال الإلحاد المضاهاة وأخرج ابن أبي حاتم عن الأعمش أنه قرأ @QB@ يلحدون @QE@ من لحد وقال تفسيرها يدخلون فيها ما ليس منها وأخرج عبد الرزاق بن حميد وابن جرير عن قتادة فى الآية قال يشركون <(@)(@@) > سورة الأعراف الآية ( 181 184 ) PageV02P270 <(@)(@@) > سورة الأعراف الآية ( 185 186 )(@)(@@) < <(@)(@@) | الأعراف : ( 181 ) وممن خلقنا أمة . . . . .(@)(@@) > > قوله @QB@ وممن خلقنا @QE@ خبر مقدم و @QB@ أمة @QE@ مبتدأ مؤخر و @QB@ يهدون @QE@ وما بعده صفة له ويجوز أن يكون @QB@ وممن خلقنا @QE@ هو المبتدأ كما تقدم فى قوله @QB@ ومن الناس من يقول @QE@ والمعنى أن من جملة من خلقه الله 
ms1383	 أمة يهدون الناس متلبسين بالحق أو يهدونهم بما عرفوه من الحق و بالحق @QB@ يعدلون @QE@ بينهم قيل هم من هذه الأمة وإنهم الفرقة الذين لا يزالون على الحق ظاهرين كما ورد فى الحديث الصحيح < <(@)(@@) | الأعراف : ( 182 ) والذين كذبوا بآياتنا . . . . .(@)(@@) > > ثم لما بين حال هذه الأمة الصالحة بين حال من يخالفهم فقال @QB@ والذين كذبوا بآياتنا سنستدرجهم من حيث لا يعلمون @QE@ والاستدراج هو الأخذ بالتدريج منزلة بعد منزلة والدرج كف الشئ يقال أدرجته ودرجته ومنه إدراج الميت فى أكفانه وقيل هو من الدرجة فالاستدراج أن يخطو درجة بعد درجة إلى المقصود ومنه درج الصبي إذا قارب بين خطاه وأدرج الكتاب طواه شيئا بعد شئ ودرج القوم مات بعضهم فى أثر بعض والمعنى سنسندينهم قليلا قليلا إلى ما يهلكهم وذلك بإدرار النعم عليهم وإنسائهم شكرها فينهمكون فى الغواية ويتنكبون طرق الهداية لاغترارهم بذلك وأنه لم يحصل لهم إلا بما لهم عند الله من المنزلة والزلفة < <(@)(@@) | الأعراف : ( 183 ) وأملي لهم إن . . . . .(@)(@@) > > قوله @QB@ وأملي لهم @QE@ معطوف على سنستدرجهم أي أطيل لهم المدة وأمهلهم وأؤخر عنهم العقوبة وجملة @QB@ إن كيدي متين @QE@ مقررة لما قبلها من الاستدراج والإملاء ومؤكدة له والكيد المكر والمتين الشديد القوي وأصله من المتن وهو اللحم الغليظ الذى على جانب الصلب(@)(@@) قال فى الكشاف سماء كيدا لأنه شبيه بالكيد من حيث إنه فى الظاهر إحسان وفي الحقيقة خذلان < <(@)(@@) | الأعراف : ( 184 ) أولم يتفكروا ما . . . . .(@)(@@) > > والاستفهام فى @QB@ أو لم يتفكروا @QE@ للإنكار عليهم حيث لم يتفكروا فى شأن رسول الله صلى الله عليه وسلم وفيما جاء به و @QB@ ما @QE@ فى @QB@ ما بصاحبهم @QE@ للاستفهام الإنكاري وهى فى محل رفع بالابتداء والخبر بصاحبهم والجنة مصدر أي وقع منهم التكذيب ولم يتفكروا أي شئ من جنون كائن بصاحبهم كما يزعمون فإنهم لو تفكروا لوجدوا زعمهم باطلا وقولهم زورا وبهتا وقيل إن @QB@ ما @QE@ نافية واسمها @QB@ من جنة @QE@ وخبرها بصاحبهم أي ليس بصاحبهم شئ مما يدعونه من الجنون فيكون هذا ردا لقولهم @QB@ يا أيها الذي نزل عليه الذكر إنك لمجنون @QE@ ويكون الكلام 
ms1384	 قد تم عند قوله @QB@ أو لم يتفكروا @QE@ والوقف عليه من الأوقاف الحسنة وجملة @QB@ إن هو إلا نذير مبين @QE@ مقررة لمضمون ما قبلها ومبينة لحقيقة حال رسول الله صلى الله عليه وسلم < <(@)(@@) | الأعراف : ( 185 ) أولم ينظروا في . . . . .(@)(@@) > > والاستفهام فى @QB@ أولم ينظروا في ملكوت السماوات والأرض @QE@ للإنكار والتقريع والتوبيخ ولقصد التعجيب من إعراضهم عن النظر فى الآيات البينة الدالة على كمال قدرته وتفرده بالإلهية والملكوت من أبنية المبالغة ومعناه الملك العظيم وقد تقدم بيانه والمعنى إن هؤلاء لم يتفكروا حتى ينتفعوا بالتفكر ولا نظروا فى مخلوقات الله حتى يهتدوا بذلك إلى الإيمان به بل هم سادرون فى ضلالتهم خائضون فى غوايتهم لا يعملون فكرا ولا يمعنون نظرا قوله @QB@ وما خلق الله من شيء @QE@ أي لم ينظروا فى ملكوت السموات والأرض ولا فيما خلق الله من شئ من الأشياء كائنا ما كان فإن في كل مخلوقاته عبرة للمعتبرين وموعظة للمتفكرين سواء كانت من جلائل مصنوعاته كملكوت السموات والأرض أو من دقائقها من سائر مخلوقاته قوله @QB@ وأن عسى أن يكون قد اقترب أجلهم @QE@ معطوف على ملكوت وأن هى المخففة من الثقيلة واسمها ضمير الشأن وخبرها عسى وما بعدها أي أو لم ينظروا فى أن الشأن والحديث عسى أن يكون قد اقترب أجلهم فيموتون عن قريب والمعنى إنهم إذا كانوا يجوزون قرب آجالهم فما لهم لا ينظرون فيما يهتدون PageV02P271 به وينتفعون بالتفكر فيه والاعتبار به @QB@ فبأي حديث بعده يؤمنون @QE@ الضمير يرجع إلى ما تقدم من التفكر والنظر فى الأمور المذكورة أي فبأي حديث بعد هذا الحديث المتقدم بيانه يؤمنون وفي هذا الاستفهام من التقريع والتوبيخ ما لا يقادر قدره وقيل الضمير للقرآن وقيل لمحمد صلى الله عليه وسلم وقيل للأجل المذكور قبله < <(@)(@@) | الأعراف : ( 186 ) من يضلل الله . . . . .(@)(@@) > > وجملة @QB@ من يضلل الله فلا هادي له @QE@ مقررة لما قبلها أي إن هذه الغفلة منهم عن هذه الأمور الواضحة البينة ليس إلا لكونهم ممن أضله الله ومن يضلله فلا هادى له أي فلا يوجد من يهديه إلى الحق 
ms1385	 وينزعه عن الضلالة ألبتة @QB@ ويذرهم في طغيانهم يعمهون @QE@ قرئ بالرفع على الاستئناف وبالجزم عطفا على محل الجزاء وقرئ بالنون ومعنى يعمهون يتحيرون وقيل يترددون وهو فى محل نصب على الحال <(@)(@@) >الآثار الواردة في تفسير الآيات وسبب النزول<(@)(@@) >(@)(@@) وقد أخرج ابن جرير وابن المنذر وأبو الشيخ عن ابن جريج فى قوله @QB@ وممن خلقنا أمة يهدون بالحق @QE@ قال ذكر لنا أن النبي صلى الله عليه وسلم قال هذه أمتى بالحق يحكمون ويقضون ويأخذون ويعطون وأخرج عبد بن حميد وابن جرير وابن المنذر عن قتادة فى الآية قال بلغنا أن نبي الله صلى الله عليه وسلم كان يقول إذا قرأها هذه لكم وقد أعطى القوم بين أيديكم مثلها ومن قوم موسى أمة يهدون بالحق وبه يعدلون وأخرج ابن أبي حاتم عن الربيع فى الآية قال قال رسول الله صلى الله عليه وسلم إن من أمتي قوما على الحق حتى ينزل عيسى ابن مريم متى نزل وأخرج ابن أبي حاتم وأبو الشيخ عن السدي فى قوله @QB@ سنستدرجهم من حيث لا يعلمون @QE@ يقول سنأخذهم من حيث لا يعلمون قال عذاب بدر وأخرج أبو الشيخ عن يحيى بن المثنى فى الآية قال كلما أحدثوا ذنبا جددنا لهم نعمة تنسيهم الاستغفار وأخرج ابن أبي الدنيا وأبو الشيخ والبيهقي فى الأسماء والصفات عن سفيان فى الآية قال نسبغ عليهم النعمة ونمنعهم شكرها وأخرج ابن أبي الدنيا والبيهقي عن ثابت البناني أنه سئل عن الاستدراج فقال ذلك مكر الله بالعباد المضيعين وأخرج أبو الشيخ فى قوله @QB@ وأملي لهم @QE@ يقول أكف عنهم @QB@ إن كيدي متين @QE@ إن مكري شديد ثم نسخها الله فأنزل @QB@ فاقتلوا المشركين حيث وجدتموهم @QE@ وأخرج ابن أبي حاتم عن ابن عباس قال كيد الله العذاب والنقمة وأخرج عبد بن حميد وابن جرير وابن المنذر وابن أبي حاتم وأبو الشيخ عن قتادة قال ذكر لنا أن نبي الله صلى الله عليه وسلم قام على الصفا فدعا قريشا فخذا فخذا يا بني فلان يا بني فلان يحذرهم بأس الله ووقائع 
ms1386	 الله إلى الصباح حتى قال قائل إن صاحبكم هذا لمجنون بات يصوت حتى أصبح فأنزل الله @QB@ أولم يتفكروا ما بصاحبهم من جنة إن هو إلا نذير مبين > @QB@(@)(@@) > سورة الأعراف الآية ( 187 188 ) PageV02P272 <(@)(@@) > سورة الأعراف الآية ( 189 192 )(@)(@@) < <(@)(@@) | الأعراف : ( 187 ) يسألونك عن الساعة . . . . .(@)(@@) > > قوله @QB@ يسألونك عن الساعة @QE@ السائلون هم اليهود وقيل قريش والساعة القيامة وهى من الأسماء الغالبة وإطلاقها على القيامة لوقوعها بغتة أو لسرعة حسابها وأيان ظرف زمان مبني على الفتح قال الزاجر % أيان تقضى حاجتي أيانا % أما ترى لنجحها أوانا % <(@)(@@) >(@)(@@) ومعناه معنى متى واشتقاقه من أي وقيل من أين وقرأ السلمي @QB@ أيان @QE@ بكسر الهمزة وهو فى موضع رفع على الخبر و @QB@ مرساها @QE@ المبتدأ عند سيبويه ومرساها بضم الميم أي وقت إرسائها من أرساها الله أي أثبها وبفتح الميم من رست أي ثبتت ومنه @QB@ وقدور راسيات @QE@ ومنه رسا الجبل والمعنى متى يرسيها الله أي يثبتها ويوقعها وظاهر @QB@ يسألونك عن الساعة @QE@ أن السؤال عن نفس الساعة وظاهر @QB@ أيان مرساها @QE@ أن السؤال عن وقتها فحصل من الجميع أن السؤال المذكور هو عن الساعة باعتبار وقوعها في الوقت المعين لذلك ثم أمره الله سبحانه بأن يجيب عنهم بقوله @QB@ قل إنما علمها عند ربي @QE@ أي علمها باعتبار وقوعها عند الله لا يعلمها غيره ولا يهتدى إليها سواه @QB@ لا يجليها لوقتها إلا هو @QE@ أي لا يظهرها لوقتها ولا يكشف عنها إلا الله سبحانه والتجلية إظهار الشئ يقال جلى لي فلان الخبر إذا أظهره وأوضحه وفي استئثار الله سبحانه بعلم الساعة حكمة عظيمة وتدبير بليغ كسائر الأشياء التى أخفاها الله واستأثر بعلمها وهذه الجملة مقررة لمضمون التى قبلها قوله @QB@ ثقلت في السماوات والأرض @QE@ قيل معنى ذلك أنه لما خفى علمها على أهل السموات والأرض كانت ثقيلة لأن كل ما خفى علمه ثقيل على القلوب وقيل المعنى لا تطيقها السموات والأرض لعظمها لأن السماء تنشق والنجوم تتناثر والبحار تنضب وقيل عظم وصفها عليهم وقيل ثقلت المسئلة عنها وهذه الجملة مقررة لمضمون ما قبلها أيضا @QB@ لا تأتيكم إلا 
ms1387	 بغتة @QE@ إلا فجأة على غفلة والبغتة مصدر فى موضع الحال وهذه الجملة كالتى قبلها فى التقرير قوله @QB@ يسألونك كأنك حفي عنها @QE@ قال ابن فارس الحفي العالم بالشيء والحفي المستقصى فى السؤال ومنه قول الاعشى % فإن تسألي عني فيارب سائل % حفي عن الأعشى به حيث أصعدا % <(@)(@@) > أ(@)(@@) يقال أحفى فى المسئلة وفي الطلب فهو محف وحفي على التكثير مثل مخصب وخصيب والمعنى يسألونك عن الساعة كأنك عالم بها أو كأنه مستقص للسؤال عنها ومستكثر منه والجملة التشبيهية فى محل نصب على الحال أي يسألونك مشبها حالك حال من هو حفي عنها وقيل المعنى يسألونك عنها كأنك حفي بهم أي حفي ببرهم وفرح بسؤالهم والأول هو معنى النظم القرآني على مقتضى المسلك العربي قوله @QB@ قل إنما علمها عند ربي @QE@ أمره الله سبحانه بأن يكرر ما أجاب به عليهم سابقا لتقرير الحكم وتأكيده وقيل ليس بتكرير بل أحدهما معناه الاستئثار بوقوعها والآخر الاستئثار بكنهها نفسها @QB@ ولكن أكثر الناس لا يعلمون @QE@ باستئثار الله بهذا وعدم علم خلقه به لم يعلمه ملك مقرب ولا نبي مرسل < <(@)(@@) | الأعراف : ( 188 ) قل لا أملك . . . . .(@)(@@) > > قوله @QB@ قل لا أملك لنفسي نفعا ولا ضرا إلا ما شاء الله @QE@ هذه الجملة متضمنة لتأكيد ما تقدم من عدم علمه بالساعة أيان تكون ومتى تقع لأنه إذا كان لا يقدر على جلب نفع له أو دفع PageV02P273 ضر عنه إلا ما شاء الله سبحانه من النفع له والدفع عنه فبالأولى أن لا يقدر على علم ما استأثر الله بعلمه وفي هذا من إظهار العبودية والإقرار بالعجز عن الأمور التى ليست من شأن العبيد والاعتراف بالضعف عن انتحال ما ليس له صلى الله عليه وسلم ما فيه أعظم زاجر وأبلغ واعظ لمن يدعى لنفسه ما ليس من شأنها وينتحل علم الغيب بالنجامة أو الرمل أو الطرق بالحصا أو الزجر ثم أكد هذا وقرره بقوله @QB@ ولو كنت أعلم الغيب لاستكثرت من الخير @QE@ أي لو كنت أعلم جنس الغيب لتعرضت لما فيه الخير فجلبته إلى نفسي وتوقيت 
ms1388	 ما فيه السوء حتى لا يمسني ولكني عبد لا أدري ما عند ربي ولا ما قضاه في وقدره لي فكيف أدري غير ذلك وأتكلف علمه وقيل المعنى لو كنت أعلم ما يريد الله عز وجل مني من قبل أن يعرفنيه لفعلته وقيل لو كنت أعلم متى يكون لي النصر فى الحرب لقاتلت فلم أغلب وقيل لو كنت أعلم الغيب لأجبت عن كل ما أسأل عنه والأولى حمل الآية على العموم فتندرج هذه الأمور وغيرها تحتها وقد قيل إن @QB@ وما مسني السوء @QE@ كلام مستأنف أي ليس بي ما تزعمون من الجنون والأولى أنه متصل بما قبله والمعنى لو علمت الغيب ما مسني السوء ولحذرت عنه كما قدمنا ذلك قوله @QB@ إن أنا إلا نذير وبشير لقوم يؤمنون @QE@ أي ما أنا إلا مبلغ عن الله لأحكامه أنذر بها قوما وأبشر بها آخرين ولست أعلم بغيب الله سبحانه واللام فى @QB@ لقوم @QE@ متعلق بكلا الصفتين أي بشير لقوم ونذير لقوم وقيل هو متعلق ببشير والمتعلق بنذير محذوف أي نذير لقوم يكفرون وبشير لقوم يؤمنون < <(@)(@@) | الأعراف : ( 189 ) هو الذي خلقكم . . . . .(@)(@@) > > قوله @QB@ هو الذي خلقكم من نفس واحدة @QE@ هذا كلام مبتدأ يتضمن ذكر نعم الله على عباده وعدم مكافأتهم لها مما يجب من الشكر والاعتراف بالعبودية وأنه المنفرد بالإلهية قال جمهور المفسرين المراد بالنفس الواحدة آدم وقوله @QB@ وجعل منها زوجها @QE@ معطوف على @QB@ خلقكم @QE@ أي هو الذى خلقكم من نفس آدم وجعل من هذه النفس زوجها وهى حواء خلقها من ضلع من أضلاعه وقيل المعنى @QB@ جعل منها @QE@ من جنسها كما فى قوله @QB@ جعل لكم من أنفسكم أزواجا @QE@ والأول أولى @QB@ ليسكن إليها @QE@ علة للجعل أي جعله منها لأجل يسكن إليها يأنس إليها ويطمئن بها فإن الجنس بجنسه أسكن وإليه آنس وكان هذا فى الجنة كما وردت بذلك الأخبار ثم ابتدأ سبحانه بحالة أخرى كانت بينهما فى الدنيا بعد هبوطهما فقال @QB@ فلما تغشاها @QE@ والتغشى كناية عن الوقاع أي فلما جامعها @QB@ حملت حملا خفيفا @QE@ علقت به بعد الجماع ووصفه بالخفة لأنه 
ms1389	 عند إلقاء النطفة أخف منه عند كونه علقة وعند كونه علقة أخف منه عند كونه مضغة وعند كونه مضغة أخف مما بعده وقيل إنه خف عليها هذا الحمل من ابتدائه إلى انتهائه ولم تجد منه ثقلا كما تجده الحوامل من النساء لقوله @QB@ فمرت به @QE@ أي استمرت بذلك الحمل تقوم وتقعد وتمضى فى حوائجها لا تجد به ثقلا والوجه الأول أولى لقوله @QB@ فلما أثقلت @QE@ فإن معناه فلما صارت ذات ثقل لكبر الولد فى بطنها وقرئ @QB@ فمرت به @QE@ بالتخفيف أي فجزعت لذلك وقرئ ? < فمارت به > ? من المور وهو المجئ والذهاب وقيل المعنى فاستمرت به وقد رويت قراءة التخفيف عن ابن عباس ويحيى بن يعمر ورويت قراءة ? < فمارت > ? عن عبد الله بن عمر وروى عن ابن عباس أنه قرأ ? < فاستمرت به > ? قوله @QB@ دعوا الله ربهما @QE@ جواب لما أي دعا آدم وحواء ربهما ومالك أمرهما @QB@ لئن آتيتنا صالحا @QE@ أي ولدا صالحا واللام جواب قسم محذوف و @QB@ لنكونن من الشاكرين @QE@ جواب القسم ساد مسد جواب الشرط أي من الشاكرين لك على هذه النعمة وفي هذا الدعاء دليل على أنهما قد علما أن ما حدث فى بطن حواء من أثر ذلك الجماع هو من جنسهما وعلما بثبوت النسل المتأثر عن ذلك السبب < <(@)(@@) | الأعراف : ( 190 ) فلما آتاهما صالحا . . . . .(@)(@@) > > @QB@ فلما آتاهما @QE@ ما طلباه من الولد الصالح وأجاب دعاءهما @QB@ جعلا له شركاء فيما آتاهما @QE@ قال كثير من المفسرين إنه جاء إبليس إلى حواء وقال لها إن ولدت ولدا فسميه باسمى فقالت وما اسمك قال الحرث PageV02P274 ولو سمى لها نفسه لعرفته فسمته عبد الحرث فكان هذا شركا فى التسمية ولم يكن شركا فى العبادة وإنما قصدا أن الحرث كان سبب نجاة الولد كما يسمى الرجل نفسه عبد ضيفه كما قال حاتم الطائي % وإني لعبد الضيف ما دام ثاويا % وما في إلا تلك من شيمة العبد % <(@)(@@) >(@)(@@) وقال جماعة من المفسرين إن الجاعل شركا فيما آتاهما هم جنس بني آدم كما وقع من المشركين منهم ولم يكن ذلك من آدم وحواء ويدل 
ms1390	 على هذا جمع الضمير فى قوله @QB@ فتعالى الله عما يشركون @QE@ وذهب جماعة من المفسرين إلى أن معنى @QB@ من نفس واحدة @QE@ من هيئة واحدة وشكل واحد @QB@ وجعل منها زوجها @QE@ أي من جنسها @QB@ فلما تغشاها @QE@ يعني جنس الذكر جنس الأنثى وعلى هذا لا يكون لآدم وحواء ذكر فى الآية وتكون ضمائر التثنية راجعة إلى الجنسين وقد قدمنا الإشارة إلى نحو هذا وذكرنا أنه خلاف الأولى لأمور منها @QB@ وجعل منها زوجها @QE@ بأن هذا إنما هو لحواء ومنها @QB@ دعوا الله ربهما @QE@ فإن كل مولولد يولد بين الجنسين لا يكون منهما عند مقاربة وضعه هذا الدعاء وقد قرأ أهل المدينة وعاصم ? < شركا > ? على التوحيد وقرأ أبو عمرو وسائر أهل الكوفة بالجمع وأنكر الأخفش سعيد القراءة الأولى وأجيب عنه بأنها صحيحة على حذف المضاف أي جعلا له ذا شرك أو ذوي شرك < <(@)(@@) | الأعراف : ( 191 ) أيشركون ما لا . . . . .(@)(@@) > > والاستفهام فى @QB@ أيشركون ما لا يخلق شيئا @QE@ للتقريع والتوبيخ أي كيف يجعلون لله شريكا لا يخلق شيئا ولا يقدر على نفع لهم ولا دفع عنهم قوله @QB@ وهم يخلقون @QE@ عطف على @QB@ ما لا يخلق @QE@ والضمير راجع إلى الشركاء الذين لا يخلقون شيئا أي وهؤلاء الذين جعلوهم شركاء من الأصنام أو الشياطين مخلوقون وجمعهم جمع العقلاء لاعتقاد من جعلهم شركاء أنهم كذلك < <(@)(@@) | الأعراف : ( 192 ) ولا يستطيعون لهم . . . . .(@)(@@) > > @QB@ ولا يستطيعون لهم @QE@ أي لمن جعلهم شركاء @QB@ نصرا @QE@ إن طلبه منهم @QB@ ولا أنفسهم ينصرون @QE@ إن حصل عليهم شئ من جهة غيرهم ومن عجز عن نصر نفسه فهو عن نصر غيره أعجز <(@)(@@) >الآثار الواردة في تفسير الآيات وسبب النزول<(@)(@@) >(@)(@@) وقد أخرج ابن إسحاق وابن جرير وأبو الشيخ عن ابن عباس قال قال حمل بن أبي قيس وشمول بن زيد لرسول الله صلى الله عليه وسلم أخبرنا متى الساعة إن كنت نبيا كما تقول فإنا نعلم ما هى فأنزل الله @QB@ يسألونك عن الساعة أيان مرساها قل إنما علمها عند ربي @QE@ إلى قوله @QB@ ولكن أكثر الناس لا يعلمون @QE@ وأخرج عبد بن حميد وابن جرير عن قتادة @QB@ أيان 
ms1391	 مرساها @QE@ أي متى قيامها @QB@ قل إنما علمها عند ربي لا يجليها لوقتها إلا هو @QE@ قال قالت قريش يا محمد أسر إلينا الساعة لما بيننا وبينك من القرابة قال @QB@ يسألونك كأنك حفي عنها قل إنما علمها عند الله @QE@ وذكر لنا أن نبي الله صلى الله عليه وسلم كان يقول تهيج الساعة بالناس والرجل يسقى على ماشيته والرجل يصلح حوضه والرجل يخفض ميزانه ويرفعه والرجل يقيم سلعته فى السوق قضاء الله لا تأتيكم إلا بغتة وأخرج ابن جرير وابن المنذر وابن أبي حاتم عن ابن عباس فى قوله @QB@ أيان مرساها @QE@ قال منتهاها وأخرج ابن أبي شيبة وعبد بن حميد وابن جرير وابن المنذر وابن أبي حاتم وأبو الشيخ عن مجاهد @QB@ لا يجليها لوقتها إلا هو @QE@ يقول لا يأتي بها إلا الله وأخرج ابن جرير وابن أبي حاتم عن قتادة في الآية قال هو يجليها لوقتها لا يعلم ذلك إلا الله وأخرج ابن أبي حاتم وأبو الشيخ عن ابن عباس فى قوله @QB@ ثقلت في السماوات والأرض @QE@ قال ليس شئ من الخلق إلا يصيبه من ضرر يوم القيامة وأخرج عبد الرزاق وابن جرير وابن المنذر وابن أبي حاتم عن قتادة فى قوله @QB@ ثقلت في السماوات والأرض @QE@ قال ثقل علمها على أهل السموات والأرض يقول كبرت عليهم وأخرج ابن جرير وابن المنذر وأبو الشيخ عن ابن جريج فى قوله @QB@ ثقلت في السماوات والأرض @QE@ قال إذا جاءت انشقت السماء وانتثرت النجوم وكورت الشمس وسيرت الجبال وما يصيب الأرض وكان ما قال الله سبحانه فذلك ثقلها فيهما وأخرج ابن أبي حاتم عن مجاهد فى قوله @QB@ لا تأتيكم إلا بغتة @QE@ فجأة آمنين وأخرج ابن أبي شيبة PageV02P275 وعبد بن حميد وابن المنذر ابن أبي حاتم وأبو الشيخ والبيهقي فى البعث عن مجاهد فى قوله @QB@ كأنك حفي عنها @QE@ قال استحفيت عنها السؤال حتى علمتها وأخرج ابن أبي حاتم وأبو الشيخ عن ابن عباس فى قوله @QB@ كأنك حفي عنها @QE@ يقول كأنك عالم بها أي لست تعلمها وأخرج ابن جرير وابن المنذر 
ms1392	 وابن أبي حاتم وأبو الشيخ والبيهقي عنه @QB@ كأنك حفي عنها @QE@ قال لطيف بها وأخرج ابن جرير وابن أبي حاتم وابن مردويه والبيهقي عنه أيضا @QB@ كأنك حفي عنها @QE@ يقول كأن بينك وبينهم مودة كأنك صديق لهم قال لما سأل الناس محمدا صلى الله عليه وسلم عن الساعة سألوه سؤال قوم كأنهم يرون أن محمدا حفي بهم فأوحى الله إليه @QB@ إنما علمها عند الله @QE@ استأثر بعلمها فلم يطلع ملكا ولا رسولا وأخرج عبد بن حميد عن عمرو بن دينار قال كان ابن عباس يقرأ كأنك حفى بها وأخرج ابن جرير وأبو الشيخ عن ابن جريج @QB@ قل لا أملك لنفسي نفعا ولا ضرا @QE@ قال الهدى والضلالة @QB@ ولو كنت أعلم الغيب @QE@ متى أموت @QB@ لاستكثرت من الخير @QE@ قال العمل الصالح وأخرج ابن أبي حاتم وأبو الشيخ عن ابن عباس فى قوله @QB@ ولو كنت أعلم الغيب لاستكثرت من الخير @QE@ قال لعلمت إذا اشتريت شيئا ما أربح فيه فلا أبيع شيئا لا ربح فيه @QB@ وما مسني السوء @QE@ قال ولا يصيبني الفقر وأخرج ابن جرير وأبو الشيخ عن ابن زيد فى قوله @QB@ وما مسني السوء @QE@ قال لاجتنبت ما يكون من الشر قبل أن يكون وأخرج أحمد والترمذي وحسنه وأبو يعلى وابن جرير وابن أبي حاتم والروياني والطبراني وأبو الشيخ والحاكم وصححه وابن مردويه عن سمرة عن النبي صلى الله عليه وسلم قال لما ولدت حواء طاف بها إبليس وكان لا يعيش لها ولد فقال سميه عبد الحرث فإنه يعيش فسمته عبد الحرث فعاش فكان ذلك من وحى الشيطان وأمره وأخرج عبد بن حميد وابن جرير وابن مردويه عن سمرة فى قوله @QB@ فلما آتاهما صالحا جعلا له شركاء @QE@ قال سمياه عبد الحرث وأخرج عبد بن حميد وأبو الشيخ عن أبي بن كعب نحو حديث سمرة المرفوع موقوفا عليه وأخرج سعيد بن منصور وابن المنذر وابن أبي حاتم عن ابن عباس قال حملت حواء فأتاها إبليس فقال إني صاحبكما الذى أخرجتكما من الجنة لتطيعنني أو لأجعلن له قرني أيل فيخرج 
ms1393	 من بطنك فيشقه ولأفعلن ولأفعلن يخوفهما سمياه عبد الحرث فأبيا أن يطيعاه فخرج ميتا ثم حملت فأتاهما ايضا فقال مثل ذلك فأبيا أن يطيعاه فخرج ميتا ثم حملت فأتاهما فذكر لهما فأدركهما حب الولد فسمياه عبد الحرث فذلك قوله @QB@ جعلا له شركاء فيما آتاهما @QE@ وأخرج ابن جرير وأبو الشيخ عن الحسن فى الآية قال كان هذا فى بعض أهل الملل وليس بآدم وأخرج أبو الشيخ وابن مردويه عن سمرة فى قوله @QB@ حملت حملا خفيفا @QE@ لم يستبن @QB@ فمرت به @QE@ لما استبان حملها وأخرج ابن جرير وابن أبي حاتم عن ابن عباس فى قوله @QB@ فمرت به @QE@ قال فشكت أحملت أم لا وأخرج ابن جرير وأبو الشيخ عن أيوب قال سئل الحسن عن قوله @QB@ فمرت به @QE@ قال لو كنت عربيا لعرفتها إنما هى استمرت بالحمل وأخرج ابن جرير وابن أبي حاتم عن السدي فى قوله @QB@ حملت حملا خفيفا @QE@ قال هى النطفة @QB@ فمرت به @QE@ يقول استمرت به وأخرج سعيد بن منصور وابن المنذر عن ابن عباس فى قوله @QB@ فمرت به @QE@ قال فاستمرت به وأخرج ابن أبي حاتم عن ميمون بن مهران @QB@ فمرت به @QE@ يقول استخفته وأخرج عبد بن حميد وابن أبي حاتم وأبو الشيخ عن أبي صالح فى قوله @QB@ لئن آتيتنا صالحا @QE@ فقال أشفقا أن يكون بهيمة فقالا لئن آتيتنا بشرا سويا وأخرج ابن أبي حاتم عن مجاهد نحوه وأخرج عبد الرزاق وابن جرير وابن المنذر وابن أبي حاتم عن الحسن في الآية قال غلاما سويا(@)(@@) وأخرج عبد بن حميد عن ابن عباس فى قوله @QB@ جعلا له شركاء @QE@ قال كان شريكا فى طاعة ولم يكن شريكا فى عبادة وأخرج ابن المنذر وابن أبي حاتم عنه قال ما أشرك آدم إن أولها شكر وآخرها مثل ضربه لمن بعده PageV02P276(@)(@@) وأخرج ابن جرير وابن أبي حاتم عن السدي فى قوله @QB@ فتعالى الله عما يشركون @QE@ هذا فصل من آية آدم خاصة فى آلهة العرب وأخرج ابن أبي حاتم عن أبي مالك نحوه وأخرج عبد بن حميد وأبو الشيخ 
ms1394	 عن الحسن فى الآية قال هذا فى الكفار يدعون الله فإذا آتاهما صالحا هودا أو نصرا ثم قال @QB@ أيشركون ما لا يخلق شيئا وهم يخلقون @QE@ يقول يطيعون ما لا يخلق شيئا وهى الشياطين لا تخلق شيئا وهى تخلق @QB@ ولا يستطيعون لهم نصرا @QE@ يقول لمن يدعوهم <(@)(@@) > سورة الأعراف الآية ( 193 198 )(@)(@@) < <(@)(@@) | الأعراف : ( 193 ) وإن تدعوهم إلى . . . . .(@)(@@) > > قوله @QB@ وإن تدعوهم إلى الهدى لا يتبعوكم @QE@ هذا خطاب للمشركين أي إن وتدعوا هؤلاء الشركاء إلى الهدى والرشاد بأن تطلبوا منهم أن يهدوكم ويرشدوكم لا يتبعوكم ولا يجيبوكم إلى ذلك وهو دون ما تطلبونه منهم من جلب النفع ودفع الضر والنصر على الأعداء قال الأخفش معناه وإن تدعوهم أي الأصنام إلى الهدى لا يتبعوكم وقيل المراد من سبق فى علم الله أنه لا يؤمن وقرئ @QB@ لا يتبعوكم @QE@ مشددا ومخففا وهما لغتان وقال بعض أهل اللغة أتبعه مخففا إذا مضى خلفه ولم يدركه واتبعه مشددا إذا مضى خلفه فأدركه وجملة @QB@ سواء عليكم أدعوتموهم أم أنتم صامتون @QE@ مقررة لمضمون ما قبلها أي دعاؤكم لهم عند الشدائد وعدمه سواء لا فرق بينهما لأنهم لا ينفعون ولا يضرون ولا يسمعون ولا يجيبون وقال @QB@ أم أنتم صامتون @QE@ مكان أصمتم لما فى الجلمة الإسمية من المبالغة(@)(@@) وقال محمد بن يحيى إنما جاء بالجملة الإسمية لكونها رأس آية يعني لمطابقة @QB@ ولا أنفسهم ينصرون @QE@ وما قبله(@)(@@) < <(@)(@@) | الأعراف : ( 194 ) إن الذين تدعون . . . . .(@)(@@) > > قوله @QB@ إن الذين تدعون من دون الله عباد أمثالكم @QE@ أخبرهم سبحانه بأن هؤلاء الذين جعلتموهم آلهة هم عباد لله كما أنتم عباد له مع أنكم أكمل منهم لأنكم أحياء تنطقون وتمشون وتسمعون وتبصرون وهذه الأصنام ليست كذلك ولكنها مثلكم فى كونها مملوكة لله مسخرة لأمره وفي هذا تقريع لهم بالغ وتوبيخ لهم عظيم وجملة @QB@ فادعوهم فليستجيبوا لكم @QE@ مقررة لمضمون ما قبلها من أنهم إن دعوهم إلى الهدى لا يتبعوهم وأنهم لا يستطيعون شيئا أي ادعوا هؤلاء الشركاء فإن كانوا كما تزعمون @QB@ فليستجيبوا لكم إن كنتم صادقين @QE@ فيما تدعونه لهم من قدرتهم على 
ms1395	 النفع والضر < <(@)(@@) | الأعراف : ( 195 ) ألهم أرجل يمشون . . . . .(@)(@@) > > والاستفهام فى قوله @QB@ ألهم أرجل @QE@ وما بعده للتقريع والتوبيخ أي هؤلاء الذين جعلتموهم شركاء ليس لهم شيء من الآلات التى هى ثابتة لكم فضلا عن أن يكونوا قادرين على ما تطلبونه منهم فإنهم كما ترون هذه الأصنام التى تعكفون على عبادتها ليست لهم @QB@ أرجل يمشون بها @QE@ فى نفع أنفسهم فضلا عن أن يمشوا فى نفعكم وليس @QB@ لهم أيد يبطشون بها @QE@ كما يبطش غيرهم من الأحياء وليس @QB@ لهم أعين يبصرون بها @QE@ كما تبصرون وليس PageV02P277 @QB@ لهم آذان يسمعون بها @QE@ كما تسمعون فكيف تدعون من هم على هذه الصفة من سلب الأدوات وبهذه المنزلة من العجز وأم فى هذه المواضع هى المنقطقة التى بمعنى بل والهمزة كما ذكر أئمة النحو وقرأ سعيد بن جبير @QB@ إن الذين تدعون @QE@ بتخفيف إن ونصب عبادا أي ما الذين تدعون @QB@ من دون الله عباد أمثالكم @QE@ على إعمال إن النافية عمل ما الحجازية وقد ضعفت هذه القراءة بأنها خلاف ما رجحه سيبويه وغيره من اختيار الرفع فى خبرها وبأن الكسائي قال إنها لا تكاد تأتي فى كلام العرب بمعنى @QB@ ما @QE@ إلا أن يكون بعدها إيجاب كما فى قوله @QB@ إن الكافرون إلا في غرور @QE@ والبطش الأخذ بقوة وقرأ أبو جعفر @QB@ يبطشون @QE@ بضم الطاء وهى لغة ثم لما بين لهم حال هذه الأصنام وتعاور وجوه النقص والعجز لها من كل باب أمره الله بأن يقول لهم ادعوا شركاءكم الذين تزعمون أن لهم قدرة على النفع والضر @QB@ ثم كيدون @QE@ أنتم وهم جميعا بما شئتم من وجوه الكيد @QB@ فلا تنظرون @QE@ أي فلا تمهلوني ولا تؤخرون إنزال الضرر بي من جهتها والكيد المكر وليس بعد هذا التحدي لهم والتعجيز لأصنامهم شيء < <(@)(@@) | الأعراف : ( 196 ) إن وليي الله . . . . .(@)(@@) > > ثم قال لهم @QB@ إن وليي الله الذي نزل الكتاب @QE@ أي كيف أخاف هذه الأصنام التى هذه صفتها ولى ولي ألجأ إليه وأستنصر به وهو الله عز وجل @QB@ الذي نزل الكتاب @QE@ وهذه الجملة تعليل لعدم المبالاة بها وولي الشيء هو الذى يحفظه 
ms1396	 ويقوم بنصرته ويمنع منه الضرر @QB@ وهو يتولى الصالحين @QE@ أي يحفظهم وينصرهم ويحول ما بينهم وبين أعدائهم قال الأخفش وقرئ ? < إن ولي الله الذى نزل الكتاب > ? يعني جبرائيل قال النحاس هى قراءة عاصم الجحدري والقراءة الأولى أبين لقوله @QB@ وهو يتولى الصالحين > @QB@ <(@)(@@) | الأعراف : ( 197 ) والذين تدعون من . . . . .(@)(@@) > > قوله @QB@ والذين تدعون من دونه لا يستطيعون نصركم ولا أنفسهم ينصرون @QE@ كرر سبحانه هذا لمزيد التأكيد والتقرير ولما فى تكرار التوبيخ والتقريع من الإهانة للمشركين والتنقص بهم وإظهار سخف عقولهم وركاكة أحلامهم < <(@)(@@) | الأعراف : ( 198 ) وإن تدعوهم إلى . . . . .(@)(@@) > > @QB@ وتراهم ينظرون إليك @QE@ جملة مبتدأة لبيان عجزهم أو حالية أي والحال أنك تراهم ينظرون إليك حال كونهم لا يبصرون والمراد الأصنام إنهم يشبهون الناظرين ولا أعين لهم يبصرون بها قيل كانوا يجعلون للأصنام أعينا من جواهر مصنوعة فكانوا بذلك فى هيئة الناظرين ولا يبصرون وقيل المراد بذلك المشركون أخبر الله عنهم بأنهم لا يبصرون حين لم ينتفعوا بأبصارهم وإن أبصروا بها غير ما فيه نفعهم <(@)(@@) >الآثار الواردة في تفسير الآيات<(@)(@@) >(@)(@@) وقد أخرج أبو الشيخ عن سعيد بن جبير قال يجاء بالشمس والقمر حتى يلقيا بن يدي الله تعالى ويجاء بمن كان يعبدهما فيقال @QB@ فادعوهم فليستجيبوا لكم إن كنتم صادقين @QE@ وأخرج ابن جرير وابن أبي حاتم وأبو الشيخ عن السدي فى قوله @QB@ وتراهم ينظرون إليك @QE@ قال هؤلاء المشركون وأخرج هؤلاء أيضا عن مجاهد فى قوله @QB@ وتراهم ينظرون إليك وهم لا يبصرون @QE@ ما يدعوهم إليه من الهدى <(@)(@@) > سورة الأعراف الآية ( 199 203 ) PageV02P278 <(@)(@@) > سورة الأعراف الآية ( 204 206 )(@)(@@) < <(@)(@@) | الأعراف : ( 199 ) خذ العفو وأمر . . . . .(@)(@@) > > قوله @QB@ خذ العفو @QE@ لما عدد الله ما عدده من أحوال المشركين وتسفيه رأيهم وضلال سعيهم أمر رسوله صلى الله عليه وسلم بأن يأخذ العفو من أخلاقهم يقال أخذت حقي عفوا أي سهلا وهذا نوع من التيسير الذى كان يأمر به رسول الله صلى الله عليه وسلم كما ثبت فى الصحيح أنه كان يقول يسروا ولا تعسروا وبشروا ولا تنفروا والمراد بالعفو هنا ضد الجهد وقيل المراد خذ العفو 
ms1397	 من صدقاتهم ولا تشدد عليهم فيها وتأخذ ما يشق عليهم وكان هذا قبل نزول فريضة الزكاة @QB@ وأمر بالعرف @QE@ أي بالمعروف وقرأ عيسى بن عمر بالعرف بضمتين وهما لغتان والعرف والمعروف والعارفة كل خصلة حسنة ترتضيها العقول وتطمئن إليها النفوس ومنه قول الشاعر % من يفعل الخير لا يعدم جوازيه % لا يذهب العرف بين الله والناس % <(@)(@@) >(@)(@@) @QB@ وأعرض عن الجاهلين @QE@ أي إذا أقمت الحجة فى أمرهم بالمعروف فلم يفعلوا فأعرض عنهم ولا تمارهم ولا تسافههم مكافأة لما يصدر منهم من المراء والسفاهة قيل وهذه الآية هى من جملة ما نسخ بآية السيف قاله عبد الرحمن بن زيد وعطاء وقيل هى محكمة قاله مجاهد وقتادة < <(@)(@@) | الأعراف : ( 200 ) وإما ينزغنك من . . . . .(@)(@@) > > قوله @QB@ وإما ينزغنك من الشيطان نزغ @QE@ النزغ الوسوسة وكذا النغز والنخس قال الزجاج النزغ أدنى حركة تكون ومن الشيطان أدنى وسوسة وأصل النزغ الفساد يقال نزغ بيننا أي أفسد وقيل النزغ الإغواء والمعنى متقارب أمر الله سبحانه نبيه صلى الله عليه وسلم إذا أدرك شيئا من وسوسة الشيطان أن يستعيذ بالله وقيل إنه لما نزل قوله @QB@ خذ العفو @QE@ قال النبي صلى الله عليه وسلم كيف يارب بالغضب فنزلت وجملة @QB@ إنه سميع عليم @QE@ علة لأمره بالاستعاذة أي استعذ به والتجيء إليه فإنه يسمع ذلك منك ويعلم به < <(@)(@@) | الأعراف : ( 201 ) إن الذين اتقوا . . . . .(@)(@@) > > وجملة @QB@ إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا @QE@ مقررة لمضمون ما قبلها أي إن شأن الذين يتقون الله وحالهم هو التذكر لما أمر الله به من الاستعاذة به والالتجاء إليه عند أن يمسهم طائف من الشيطان وإن كان يسيرا قرأ أهل البصرة ? < طيف > ? وكذا أهل مكة وقرأ أهل المدينة والكوفة @QB@ طائف @QE@ وقرأ سعيد بن جبير ? < طيف > ? بالتشديد قال النحاس كلام العرب فى مثل هذا طيف بالتخفيف على أنه مصدر من طاف يطيف قال الكسائي هو مخفف مثل ميت وميت قال النحاس ومعناه فى اللغة ما يتخيل فى القلب أو يرى فى النوم وكذا معنى طائف قال أبو حاتم سألت الأصمعي عن 
ms1398	 طيف فقال ليس فى المصادر فيعل قال النحاس ليس هو مصدرا ولكن يكون بمعنى طائف وقيل الطيف والطائف معنيان مختلفان فالأول التخيل والثاني الشيطان نفسه فالأول من طاف الخيال يطوف طيفا ولم يقولوا من هذا طائف قال السهيلي لأنه تخيل لا حقيقة له فأما قوله @QB@ فطاف عليها طائف من ربك @QE@ فلا يقال فيه طيف لأنه اسم فاعل حقيقة قال الزجاج طفت عليهم أطوف فطاف الخيال يطيف قال حسان % فدع هذا ولكن من لطيف % يؤرقني إذا ذهب العشاء % <(@)(@@) >(@)(@@) وسميت الوسوسة طيفا لأنها لمة من الشيطان تشبه لمة الخيال @QB@ فإذا هم مبصرون @QE@ بسبب التذكر أي منتبهون PageV02P279 وقيل على بصيرة وقرأ سعيد بن جبير @QB@ تذكروا @QE@ بتشديد الذال قال النحاس ولا وجه له فى الغريبة < <(@)(@@) | الأعراف : ( 202 ) وإخوانهم يمدونهم في . . . . .(@)(@@) > > قوله @QB@ وإخوانهم يمدونهم في الغي @QE@ قيل المعنى وإخوان الشياطين وهم الفجار من ضلال الإنس على أن الضمير فى إخوانهم يعود إلى الشيطان المذكور سابقا والمراد به الجنس فجاز إرجاع ضمير الجمع إليه @QB@ يمدونهم في الغي @QE@ أي تمدهم الشياطين فى الغي وتكون مددا لهم وسميت الفجار من الإنس إخوان الشياطين لأنه يقبلون منهم ويقتدون بهم وقيل إن المراد بالإخوان الشياطين وبالضمير الفجار من الإنس فيكون الخبر جاريا على من هوله وقال الزجاج فى الكلام تقديم وتأخير والمعنى والذين تدعون من دونه لا يستطيعون لكم نصرا ولا أنفسهم ينصرون @QB@ وإخوانهم يمدونهم في الغي @QE@ لأن الكفار إخوان الشياطين @QB@ ثم لا يقصرون @QE@ الاقصار الانتهاء عن الشيء أي لا تقصر الشياطين فى مد الكفار فى الغي قيل إن فى الغي متصلا بقوله @QB@ يمدونهم @QE@ وقيل بالإخوان والغي الجهل قرأ نافع @QB@ يمدونهم @QE@ بضم حرف المضارعة وكسر الميم وقرأ الباقون بفتح حرف المضارعة وضم الميم وهما لغتان يقال مد وأمد قال مكي ومد أكثر وقال أبو عبيد وجماعة من أهل اللغة فإنه يقال إذا كثر شيء شيئا بنفسه مده وإذا كثره بغيره قيل أمده نحو @QB@ يمددكم ربكم بخمسة آلاف من الملائكة @QE@ وقيل يقال مددت فى الشر وأمددت فى الخير وقرأ عاصم الجحدري 
ms1399	 ? < يمادونهم فى الغى > ? وقرأ عيسى بن عمر @QB@ ثم لا يقصرون @QE@ بفتح الياء وضم الصاد وتخفيف القاف < <(@)(@@) | الأعراف : ( 203 ) وإذا لم تأتهم . . . . .(@)(@@) > > قوله @QB@ وإذا لم تأتهم بآية قالوا لولا اجتبيتها @QE@ اجتبى الشيء بمعنى جباه لنفسه أي جمعه أي هلا اجتمعتها افتعالا لها من عند نفسك وقيل المعنى اختلقتها يقال اجتبيت الكلام انتحلته واختلقته واخترعته إذا جئت به من عند نفسك كانوا يقولون لرسول الله صلى الله عليه وسلم إذا تراخى الوحي هذه المقالة فأمره الله بأن يجيب عليهم بقوله @QB@ إنما أتبع ما يوحى إلي @QE@ أي لست ممن يأتي بالآيات من قبل نفسه كما تزعمون @QB@ إنما أتبع ما يوحى إلي من ربي @QE@ فما أوحاه إلي وأنزله علي أبلغته إليكم وبصائر جمع بصيرة أي هذا القرآن المنزل علي هو @QB@ بصائر من ربكم @QE@ يتبصر بها من قبلها وقيل البصائر الحجج والبراهين وقال الزجاج البصائر الطرق @QB@ وهدى ورحمة لقوم يؤمنون @QE@ معطوف على بصائر أي هذا القرآن هو بصائر وهدى يهتدى به المؤمنون ورحمة لهم < <(@)(@@) | الأعراف : ( 204 ) وإذا قرئ القرآن . . . . .(@)(@@) > > قوله @QB@ وإذا قرئ القرآن فاستمعوا له وأنصتوا @QE@ أمرهم الله سبحانه بالاستماع للقرآن والإنصات له عند قراءته لينتفعوا به ويتدبروا ما فيه من الحكم والمصالح قيل هذا الأمر خاص بوقت الصلاة عند قراءة الإمام ولا يخفاك أن اللفظ أوسع من هذا والعام لا يقصر على سببه فيكون الاستماع والإنصات عند قراءة القرآن فى كل حالة وعلى أي صفة مما يجب على السامع وقيل هذا خاص بقراءة رسول الله صلى الله عليه وسلم للقرآن دون غيره ولا وجه لذلك @QB@ لعلكم ترحمون @QE@ أي تنالون الرحمة وتفوزون بها بامتثال أمر الله سبحانه ثم أمره الله سبحانه أن يذكره فى نفسه فإن الإخفاء أدخل فى الإخلاص وأدعى للقبول قيل المراد بالذكر هنا ما هو أعم من القرآن وغيره من الأذكار التى يذكر الله بها وقال النحاس لم يختلف فى معنى < <(@)(@@) | الأعراف : ( 205 ) واذكر ربك في . . . . .(@)(@@) > > @QB@ واذكر ربك في نفسك @QE@ أنه الدعاء وقيل هو خاص بالقرآن أي اقرأ القرآن بتأمل وتدبرا و 
ms1400	 @QB@ تضرعا وخيفة @QE@ منتصبان على الحال أي متضرعا وخائفا والخيفة الخوف وأصلها خوفة قلبت الواو باء لانكسار ما قبلها وحكى الفراء أنه يقال فى جمع خيفة خيف قال الجوهري والخيفة الخوف والجمع خيف وأصله الواو أي خوف @QB@ ودون الجهر من القول @QE@ أي دون المجهور به من القول وهو معطوف على ما قبله أي متضرعا وخائفا ومتكلما بكلام هو دون الجهر من القول و @QB@ بالغدو والآصال @QE@ متعلق باذكر أي أوقات الغدوات وأوقات الأصائل والغدو جمع غدوة والآصال جمع أصيل قاله الزجاج والأخفش مثل PageV02P280 يمين وأيمان وقيل الآصال جمع أصل والأصل جمع أصيل فهو على هذا جمع الجمع قاله الفراء قال الجوهري الأصيل الوقت من بعد العصر إلى المغرب وجمعه أصل وآصال وأصائل كأنه جمع أصيلة قال الشاعر % لعمري لأنت البيت أكرم أهله % وأقعد فى أفنائه بالأصائل % <(@)(@@) >(@)(@@) ويجمع أيضا على أصلان مثل بعير وبعران وقرأ أبو مجلز والإيصال وهو مصدر وخص هذين الوقتين لشرفهما والمراد دوام الذكر لله @QB@ ولا تكن من الغافلين @QE@ أي عن ذكر الله < <(@)(@@) | الأعراف : ( 206 ) إن الذين عند . . . . .(@)(@@) > > @QB@ إن الذين عند ربك لا يستكبرون عن عبادته @QE@ المراد بهم الملائكة قال القرطبي بالإجماع قال الزجاج وقال عند ربك والله عز وجل بكل مكان لأنهم قريبون من رحمته وكل قريب من رحمة الله عز وجل فهو عنده وقال غيره لأنهم فى موضع لا ينفذ فيه إلا حكم الله وقيل إنهم رسل الله كما يقال عند الخليفة جيش كثير وقيل هذا على جهة التشريف والتكريم لهم ومعنى @QB@ ويسبحونه @QE@ يعظمونه وينزهونه عن كل شين @QB@ وله يسجدون @QE@ أي يخصونه بعبادة السجود التى هى أشرف عبادة وقيل المراد بالسجود الخضوع والذلة وفي ذكر الملأ الأعلى تعريض لبني آدم <(@)(@@) >الآثار الواردة في تفسير الآيات<(@)(@@) >(@)(@@) وقد أخرج سعيد بن منصور وابن أبي شيبة والبخاري وأبو داود والنسائي والنحاس فى = ناسخه وابن جرير وابن المنذر وابن أبي حاتم والطبراني وأبو الشيخ وابن مردويه والبيهقي فى الدلائل عن عبد الله بن الزبير فى قوله @QB@ خذ العفو @QE@ الآية قال ما نزلت 