ms461	 سنة ست وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO ثابت بن قيس الكوفي(@)(@@) عن: ابن مسعود، روى عنه: إبراهيم النخعي، وأبو زرعة بن عمرو بن جرير.(@)(@@)(@@)(@@) ||| AUTO ثابت بن قيس الزرقي الأنصاري(@)(@@) يروي عن: أبي هريرة، روى عنه: الزهري.(@)(@@)(@@)(@@) ||| AUTO ثابت بن قيس المدني، كنيته أبو الغصن(@)(@@) مولى لبني غفار، يروي عن: أنس بن مالك، روى عنه: عبد الرحمن بن مهدي.(@)(@@)(@@)(@@) ||| AUTO ثابت بن عبد الله بن الزبير(@)(@@) يروي عن: سعد بن أبي وقاص، روى عنه: عباد بن إسحاق، عن أبيه، أمه حنتمة بنت عبد الرحمن بن الحارث بن هشام المخزومي.(@)(@@)(@@)(@@) ||| AUTO ثابت بن أبي قتادة السلمي الأنصاري(@)(@@) واسم أبي قتادة الحارث بن ربعي،(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 2: ص 53] يروي عن: أبيه، روى عنه: ابنه مصعب بن ثابت، مات في ولاية الوليد بن عبد الملك، وكنيته أبو مصعب.(@)(@@)(@@)(@@) ||| AUTO ثابت بن السمط بن الأسود بن جبلة بن عدي بن ربيعة(@)(@@) أخو شرحبيل بن السمط، عداده في أهل الشام، يروي عن: جماعة من الصحابة، روى عنه: أهل الشام.(@)(@@)(@@)(@@) ||| AUTO ثابت بن عبيد الأنصاري كوفي(@)(@@) يروي عن: ابن عمر وزيد بن ثابت، روى عنه: ابن سيرين، والأعمش، وهو مولى زيد بن ثابت.(@)(@@)(@@)(@@) ||| AUTO ثابت بن قطبة المزني كوفي(@)(@@) يروي عن: ابن مسعود، روى عنه: الشعبي، وأبو إسحاق.(@)(@@)(@@)(@@) ||| AUTO ثابت بن معبد(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: عبد الملك بن عمير.(@)(@@) ثابت(@)(@@) مولى سفيان بن أبي مريم، يروي عن: معاوية، عداده في الشاميين، روى عنه: أبو بكر بن أبي مريم.(@)(@@)(@@)(@@) ||| AUTO ثابت بن سعد الطائفي، وقد قيل: الطائي(@)(@@) يروي عن: جابر بن عبد الله، ومعاوية، روى عنه: محمد بن عبد الله بن مهاجر، ومحمد بن عمر المحرمي أخو خالد بن عمر وأهل الشام.(@)(@@)(@@)(@@) ||| AUTO ثابت بن مشحل(@)(@@) يروي عن: أبي هريرة وهو مولاه، روى عنه: فليح بن سليمان.(@)(@@)(@@)(@@) ||| AUTO ثابت بن الأحنف بن الأعرج(@)(@@) مولى عبد الرحمن بن زيد بن الخطاب القرشي، مدني، يروي عن: أبي هريرة وابن عمر، روى عنه: عمرو بن دينار.(@)PageV01P002(@)(@@) [ج 2: ص 54](@)(@@)(@@)(@@) ||| AUTO 
ms462	 (@@)(@@)(@@) ||| AUTO ثابت بن يزيد الخولاني(@)(@@) يروي عن: أبي هريرة، روى عنه: عمرو بن الحارث، وخالد بن أبي يزيد.(@)(@@)(@@)(@@) ||| AUTO ثابت بن الحجاج(@)(@@) يروي عن: زيد بن ثابت، روى عنه: جعفر بن برقان.(@)(@@)(@@)(@@) ||| AUTO ثابت بن السمط(@)(@@) يروي عن: عبادة بن الصامت، روى عنه: ابن محيريز.(@)(@@)(@@)(@@) ||| AUTO ثابت بن طريف المرادي(@)(@@) يروي عن: أبي ذر الغفاري، روى عنه: أزهر بن عبد الله المرادي.(@)(@@)(@@)(@@) ||| AUTO ثابت بن زيد بن أرقم الأنصاري(@)(@@) يروي عن: أم سلمة، روى عنه: يزيد بن أبي زياد.(@)(@@)(@@)(@@) ||| AUTO ثابت بن مرداس(@)(@@) شيخ سمع زيد بن أرقم عند عبيد الله بن زياد، روى عنه: عبد العزيز بن محمد الدراوردي.(@)(@@)(@@)(@@) ||| AUTO ثابت بن أنس بن ظهير الأنصاري المدني(@)(@@) يروي المراسيل، روى عنه: ابنه الحسين بن ثابت.(@)(@@)(@@)(@@) ||| AUTO ثابت بن سرج أبو سلمة الدوسي(@)(@@) يروي عن: واثلة بن الأسقع، وبلال، روى عنه: الوليد بن مسلم.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO ثابت بن عبيد بن عازب(@)(@@) ابن أخي البراء بن عازب، يروي عن: أبيه، عن النبي صلى الله عليه وسلم في المستحاضة، ولأبيه صحبة، روى عنه: ابنه عدي.(@)(@@) ثابت بن عبيد(@)(@@) يروي عن: أنس بن مالك، روى عنه: يزيد بن مردانبه.(@)(@@) ثابت(@)(@@) مولى أم سلمة، يروي عن: عمر، روى عنه: أهل المدينة، مات في خلافة عمر بن الخطاب.(@)PageV01P002(@)(@@) [ج 2: ص 55](@)(@@)(@@)(@@) ||| AUTO ثابت(@)(@@) يروي عن: ابن عباس أنه قرأ السراط، روى عنه: عمرو بن دينار، ولا أدرى من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO ثابت بن هريم(@)(@@) يروي عن: ابن أبي طالب، روى عنه: المغيرة بن مقسم.(@)(@@) (99) -[2: 55] ثنا عمرو بن محمد الهمداني، قال: ثنا فضل بن سهل الأعرج، قال: ثنا يحيى بن أبي بكير، قال: ثنا هشيم، قال: ثنا مغيرة، عن ثابت بن هريم، عن علي، أنه " أمر رجلا أن يصلي بضعفة الناس يوم العيد أربعا، وخرج هو إلى الجبانة فصلى بهم ركعتين "(@)(@@)(@@)(@@) ||| AUTO ثابت بن الأعرج(@)(@@) من أهل المدينة، روى عنه: مالك، وقد قيل: إنه ثابت بن عياض الأحنف الذي روى عنه: ابن جريج.(@)(@@)(@@)(@@) ||| AUTO 
ms463	 ثمامة بن عبد الله بن أنس بن مالك الأنصاري(@)(@@) قاضي البصرة، يروي عن: أنس بن مالك، روى عنه: حماد بن سلمة وعبد الله بن المثنى.(@)(@@)(@@)(@@) ||| AUTO ثمامة بن حزن القشيري(@)(@@) يروي عن: عائشة، وقدم على عمر بن الخطاب، روى عنه: الجريري، والأسود بن شيبان، وأهل البصرة.(@)(@@)(@@)(@@) ||| AUTO ثمامة بن عقبة المحلمي(@)(@@) عن: زيد بن أرقم، عداده في أهل الكوفة، روى عنه: الأعمش وهارون بن سعد.(@)(@@)(@@)(@@) ||| AUTO ثمامة بن شفي أبو علي الهمداني الأصبحي(@)(@@) يروي عن: عقبة بن عامر، وفضالة بن عبيد، عداده في أهل مصر، روى عنه: ابن إسحاق، وعبد الرحمن بن حرملة.(@)(@@)(@@)(@@) ||| AUTO ثمامة بن شراحيل(@)(@@) يروي عن: ابن عباس، وابن عمر، روى عنه:(@)PageV01P002(@)(@@) [ج 2: ص 56] يحيى بن قيس الماربي، وعبد الله بن خريع بن جمال.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن أبي مالك القرظي المدني، كنيته أبو جعفر(@)(@@) وقد قيل: أبو يحيى، وكان إمام بني قريظة، وكان من كندة إلا أنه تزوج امرأة من بني قريظة، وقيل: قرظي، يروي عن: ابن عمر، روى عنه: الزهري وابن الهاد.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن عباد العبدي(@)(@@) ويقال: الليثي، من أهل البصرة، يروي عن: سمرة بن جندب، روى عنه: الأسود بن قيس.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن يزيد الكوفي(@)(@@) يروي عن: علي، روى عنه: حبيب بن أبي ثابت.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن ضبيعة(@)(@@) يروي عن: حذيفة بن اليمان، روى عنه: أبو بردة.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن سهل شيخ(@)(@@) يروي عن: عبد الله بن الحارث بن جزء الزبيدي، روى عنه: الليث بن سعد.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن مالك أبو بحر البصري(@)(@@) مولى أنس بن مالك سكن الكوفة، يروي عن: أنس بن مالك، روى عنه: الحسن بن عبيد الله، وقد قيل: ثعلبة بن عاصم، ويقال: إنه ثعلبة بن الحكم، وهو الذي يروي عن: أنس، عن النبي صلى الله عليه وسلم أنه قال: " ما قضى الله لمسلم قضاء إلا كان خيرا له.(@)(@@)(@@)(@@) ||| AUTO ثعلبة أبو الكنود الحمراوي(@)(@@) يروي عن: عائشة، روى عنه: سليمان بن أبي زينب.(@)(@@)(@@)(@@) ||| AUTO ثعلبة بن مسلم الجهني(@)(@@) يروي عن: أبي 
ms464	 هريرة، روى عنه: عقيل بن مدرك.(@)PageV01P002(@)(@@) [ج 2: ص 57](@)(@@)(@@)(@@) ||| AUTO ثعلبة بن عاصم(@)(@@) يروي عن: أنس بن مالك، روى عنه: عاصم الأحول.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO ثور بن قدامة(@)(@@) يروي عن: عمر، روى عنه: إبراهيم العقيلي، قال: جاءنا كتاب عمر بن الخطاب.(@)(@@)(@@)(@@) ||| AUTO ثور الكندي(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: عمرو بن قيس.(@)(@@) ثور(@)(@@) شيخ، يروي عن: أبي هريرة: أفطر الحاجم والمحجوم، روى عنه: ابنه شقيق بن ثور.(@)(@@)(@@)(@@) ||| AUTO ثوبان بن شهر الأشعري(@)(@@) يروي المراسيل، عداده في أهل الشام، روى عنه أهلها.(@)(@@)(@@)(@@) ||| AUTO ثروان بن ملحان التيمي(@)(@@) كوفي، يروي عن: عمار بن ياسر، روى عنه: سماك بن حرب، ومنهم من زعم أنه ملحان بن ثروان.(@)(@@)(@@)(@@) ||| AUTO ثميل الأشعري(@)(@@) يروي عن: أبي الدرداء، عداده في أهل الشام، روى عنه: عمر بن يزيد النصرى.(@)(@@)(@@)(@@) ||| AUTO ثويب أبو رشيد الشامي(@)(@@) يروي عن: أبي هريرة، وزيد بن ثابت، روى عنه: أبو سلمة بن عبد الرحمن.(@)(@@)(@@)(@@) || AUTO باب الجيم(@)(@@) قال أبو حاتم:(@)(@@) وممن روى عن الصحابة من التابعين وشافههم ممن ابتدأ اسمه على الجيم:(@)(@@)(@@)(@@) ||| AUTO جابر بن زيد أبو الشعثاء الأزدي اليحمدي(@)(@@) أصله من(@)PageV01P002(@)(@@)(@@)(@@) ||| AUTO [ج 2: ص 58] الجوف ناحية بعمان، وكان ينزل البصرة في الأزد في موضع يقال: درب الجوف، وكانت الإباضية تنتحله، وكان هو يتبرأ من ذلك، يروي عن: ابن عباس، وابن عمر، روى عنه: عمرو بن دينار، وكان من أعلم الناس بكتاب الله، وكان ابن عباس، يقول: لو أن أهل البصرة نزلوا عند قول جابر بن زيد لأوسعهم علما عما في كتاب الله، وكان فقيها، مات سنة ثلاث وتسعين، ودفن هو وأنس بن مالك في جمعة واحدة، وكان أبو الشعثاء أعور.(@)(@@)(@@)(@@) ||| AUTO جابر بن جلاس الكلبي(@)(@@) يروي عن: عمر، روى عنه: ابنه محمد بن جابر.(@)(@@)(@@)(@@) ||| AUTO جابر بن يزيد بن الأسود السوائي(@)(@@) يروي عن: أبيه، روى عنه: يعلى بن عطاء.(@)(@@)(@@)(@@) ||| AUTO جابر بن قبيصة(@)(@@) من بني أسد بن خزيمة، يروي عن: عمر بن الخطاب، روى عنه: محمد بن عبيد الله العرزمي.(@)(@@)(@@)(@@) ||| AUTO جابر بن 
ms465	 عمرو الراسبي، أبو الوازع(@)(@@) بصري، يروي عن: أبي برزة وعبد الله بن مغفل، روى عنه: شداد بن سعيد، وأبان بن صمعة.(@)(@@)(@@)(@@) ||| AUTO جابر بن العلاف(@)(@@) يروي عن: ابن الزبير، روى عنه: إبراهيم بن المهاجر.(@)(@@)(@@)(@@) ||| AUTO جابر الحذاء(@)(@@) يروي عن: ابن عمر، روى عنه: ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO جابر النخعي كوفي(@)(@@) يروي عن: أبي الدرداء، روى عنه: أبو إسحاق السبيعي.(@)(@@) جابر(@)(@@) يروي عن: علي، روى عنه: ابنه مزيدة بن جابر.(@)(@@)(@@)(@@) ||| AUTO جابر بن آزاد المقري(@)(@@) ومقرا قرية بدمشق، يروي عن: عمرو البكالي، روى صفوان عن: أمه، عنه.(@)PageV01P002(@)(@@) [ج 2: ص 59](@)(@@)(@@)(@@) ||| AUTO جنادة بن أبي أمية الدوسي(@)(@@) واسم أبي أمية كثير، يروي عن: عبادة بن الصامت، سكن الشام، روى عنه: أهلها، مات سنة سبع وستين، وقد قيل: إن له صحبة، وليس ذلك بصحيح.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عمرو بن أمية بن إياس الضمري المدني(@)(@@) يروي عن: أبيه، روى عنه: أبو سلمة بن عبد الرحمن، والزهري، مات سنة خمس وتسعين في ولاية الحجاج، وكان جعفر بن عمرو أخا عبد الملك بن مروان من الرضاعة، وأمه سخيلة بنت عبيدة بن الحارث بن المطلب.(@)(@@)(@@)(@@) ||| AUTO جعفر بن الزبير بن العوام القرشي المدني(@)(@@) يروي عن: أبيه، روى عنه: ابن أبي ذئب، وأم عروة ابنته.(@)(@@)(@@)(@@) ||| AUTO جعفر بن المطلب بن أبي وداعة السهمي، كنيته أبو كثير(@)(@@) يروي عن: عمرو بن العاص وأبيه، روى عنه: عبد العزيز بن رفيع، وقد روى ابن جريج، عن ابنه سعيد بن جعفر عنه، وقد روى ابن جريج أيضا، عن سعيد بن كثير بن المطلب ابن أخيه عنه.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عياض(@)(@@) يروي عن: أبي هريرة، روى عنه: إسحاق بن عبد الله بن أبي طلحة.(@)(@@)(@@)(@@) ||| AUTO جعفر بن حذيفة(@)(@@) يروي عن: علي، روى عنه: الحسن بن سعد.(@)PageV01P002(@)(@@) [ج 2: ص 60](@)(@@)(@@)(@@) ||| AUTO جعفر بن أبي ثور، كنيته أبو ثور(@)(@@) واسم أبيه عكرمة، يروي عن: جده جابر بن سمرة، روى عنه: أشعث بن سليم، ومحمد بن قيس، وعثمان بن عبد الله بن موهب.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عمرو بن حريث 
ms466	 المخزومي القرشي الكوفي(@)(@@) يروي عن: أبيه، روى عنه: مساور الوراق والمسعودي.(@)(@@)(@@)(@@) ||| AUTO جعفر بن خارجة(@)(@@) يروي عن: أنس بن مالك، روى عنه: المغيرة بن عبد الرحمن.(@)(@@)(@@)(@@) ||| AUTO جعفر بن الفرافصة(@)(@@) يروي عن: ابن عمر، روى عنه: يحيى بن أبي كثير.(@)(@@)(@@)(@@) ||| AUTO جعفر بن عبد الله بن الحكم بن رافع بن سنان الأنصاري(@)(@@) يروي عن: أنس بن مالك، وعلباء بن أحمر، روى عنه: سعيد بن أبي هلال، وهو والد عبد الحميد بن جعفر الأنصاري.(@)(@@) (100) -[2: 60] ثنا أبو يزيد القرشي خالد بن النضر بالبصرة، قال: ثنا محمد بن بشار، قال: ثنا محمد أبو بكر الحنفي، قال: ثنا عبد الحميد بن جعفر، قال: ثنا أبي، أنه سمع أنس بن مالك، يقول: " قد أنزل الله الآية التي تحرم الخمر، وما بالمدينة شراب يشرب إلا من تمر "(@)(@@)(@@)(@@) ||| AUTO جعفر بن جرفاس التيمي(@)(@@) يروي عن: علي، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO جعفر بن معبد أبو الوليد(@)(@@) يروي عن: أنس بن مالك، روى عنه: سلام بن مسكين.(@)(@@)(@@)(@@) ||| AUTO جعفر بن محمود بن محمد بن سلمة الأنصاري الحارثي(@)(@@) يروي عن:(@)PageV01P002(@)(@@) [ج 2: ص 61] جابر بن عبد الله، روى عنه: إبراهيم بن جعفر، وابن أخيه سليمان بن محمد بن محمود.(@)(@@)(@@)(@@) ||| AUTO جامع بن شداد أبو صخرة المحاربي(@)(@@) كوفي، يروي عن: طارق المحاربي، وله صحبة، روى عنه: أهل الكوفة، مات في شهر رمضان سنة ثمان عشرة ومائة، وقد قيل: إنه مات سنة سبع وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO جرير بن أبي عطاء القرشي(@)(@@) مولى بني زهرة، حجازي، يروي عن: ابن عمر، روى عنه: الزهري، عداده في أهل الحجاز.(@)(@@)(@@)(@@) ||| AUTO جرير الضبي(@)(@@) يروي عن: علي، روى عنه: ابنه غزوان بن جرير.(@)(@@)(@@)(@@) ||| AUTO جرير بن عتبة(@)(@@) يروي عن: عبادة بن الصامت، روى معاوية بن صالح، عن أبي الحكم عنه، وقد قيل: إنه عتبة بن جرير.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO جميل النجراني(@)(@@) يروي عن: حذيفة بن اليمان، روى عنه: عبد الله بن الحارث.(@)(@@)(@@)(@@) ||| AUTO جميل بن سنان(@)(@@) يروي عن: علي، روى عنه: عبد القاهر.(@)(@@)(@@)(@@) ||| AUTO جميل بن بشير(@)(@@) يروي 
ms467	 عن: أبي هريرة، روى عنه: عمرو بن أبي وهب الخزاعي.(@)(@@) جميل(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: ابنه جروة.(@)(@@)(@@)(@@) ||| AUTO جبلة بن سحيم الكوفي الشيباني، كنيته أبو سريرة(@)(@@) يروي عن: ابن عمر، روى PageV01P002 [ج 2: ص 62] عنه: مسعر، وشعبة، مات في ولاية هشام بن عبد الملك حين ولي يوسف بن عمر على العراق، وهو الذي يقال له: جبلة بن صهيب، وجبلة بن وهب، والصحيح سحيم.(@)(@@)(@@)(@@) ||| AUTO جبلة بن حممة(@)(@@) يروي عن: علي، روى عنه: عبد الله بن بشر الخثعمي.(@)(@@)(@@)(@@) ||| AUTO جبلة بن نافع(@)(@@) يروي عن: عبد الله بن الحارث بن جزء الزبيدي، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO جبلة بن أبي سليمان أبو عاصم الشقري(@)(@@) يروي عن: أنس بن مالك، روى عنه: أبو عاصم النبيل(@)(@@)(@@)(@@) ||| AUTO جبلة بن مطر(@)(@@) يروي عن: فضالة بن عبيد، روى عنه: الحسن بن يحيى الخشني.(@)(@@)(@@)(@@) ||| AUTO جندب بن كعب الأزدي(@)(@@) قاتل الساحر زمن الوليد بن عقبة، روى المراسيل، روى عنه: أبو عثمان النهدي.(@)(@@)(@@)(@@) ||| AUTO جندب بن سلامة(@)(@@) ويقال: سلام المدني، يروي عن: ابن عمر، روى عنه: مسلم بن جندب.(@)(@@) (101) -[2: 62] ثنا عبد الله بن جابر بطرسوس، قال: ثنا محمد بن يزيد المستملي، قال: ثنا ابن أبي فديك، عن ابن أبي ذئب، عن مسلم بن جندب، عن أبيه، عن ابن عمر، قال: قال رسول الله صلى الله عليه وسلم: " ثلاثة لا ترد: الطيب، والوسادة، واللبن "(@)(@@)(@@)(@@) ||| AUTO جندب الأزدي(@)(@@) يروي عن: سلمان، روى عنه: عبد الله بن شريك.(@)(@@)(@@)(@@) ||| AUTO جندب بن الحجاج(@)(@@) يروي عن: عمران بن حصين، روى عنه: يوسف بن سعد.(@)(@@)(@@)(@@) ||| AUTO جندب بن سليمان البارقي(@)(@@) يروي عن: ابن عباس، روى عنه: شبيب بن غرقدة.(@)PageV01P002(@)(@@) [ج 2: ص 63](@)(@@)(@@)(@@) ||| AUTO جبير بن نفير بن مالك بن عامر الحضرمي(@)(@@) أدرك الجاهلية، ولا صحبة له، يروي عن: أبي ذر، وأبي الدرداء، روى عنه: أهل الشام، كنيته أبو عبد الرحمن، مات سنة ثمانين بالشام.(@)(@@) (102) -[2: 63] ثنا العباس بن الخليل بن جابر الطائي أبو الخليل، بحمص من كتابة، قال: ثنا نصر بن خزيمة 
ms468	 بن علقمة بن محفوظ بن علقمة الحضرمي، قال: ثنا أبي، عن نضر بن علقمة، عن أخيه محفوظ بن علقمة، عن ابن عابد، قال: ثنا جبير بن نفير، عن عوف بن مالك، قال: قال رسول الله صلى الله عليه وسلم: " إن الأنبياء ليتكاثرون بأمتهم، وبكثرتهم فإني أرجو أني أكثرهم، ولقد أعطي موسى بن عمران خصلات لم يعطهن نبي، إنه مكث يناجي ربه أربعين يوما، ولا ينبغي لمتناجيين أن يتناجيا أطول من نجواهما "(@)(@@)(@@)(@@) ||| AUTO جبير بن حية الثقفي(@)(@@) يروي عن: المغيرة بن شعبة، والنعمان بن مقرن، روى عنه: ابنه زياد بن جبير.(@)(@@)(@@)(@@) ||| AUTO جبير بن شيبة بن عثمان بن عبد الدار(@)(@@) خازن الكعبة، يروي عن: أبيه وله صحبة، روى عنه: ابنه شيبة بن جبير.(@)(@@)(@@)(@@) ||| AUTO جبير بن أبي سليمان بن جبير بن مطعم(@)(@@) عن: ابن عمر، روى عنه: عبادة بن مسلم.(@)(@@)(@@)(@@) ||| AUTO جبير بن الحويرث(@)(@@) يروي عن: أبي بكر الصديق، روى عنه: سعيد بن عبد الرحمن بن يربوع.(@)(@@)(@@)(@@) ||| AUTO جبير بن أبي صالح(@)(@@) يروي عن: أبي هريرة، روى عنه: يزيد بن أبي زياد.(@)PageV01P002(@)(@@) [ج 2: ص 64](@)(@@)(@@)(@@) ||| AUTO جراح بن عبد الله الحكمي(@)(@@) أصله من اليمن، سكن الشام، ولاه ابن المهلب على خراسان، روى المراسيل، روى عنه: ابن سيرين.(@)(@@)(@@)(@@) ||| AUTO جراح بن الجراح(@)(@@) يروي عن: ابن عباس، روى عنه: يزيد بن أبي حبيب.(@)(@@)(@@)(@@) ||| AUTO جهم بن فضالة(@)(@@) يروي عن: أبي أمامة، روى قزعة بن سويد، عن أبيه عنه.(@)(@@)(@@)(@@) ||| AUTO جهضم بن الضحاك أبو رؤبة الباهلي(@)(@@) يروي عن: العداء بن خالد بن هوذة، رجل من أصحاب النبي صلى الله عليه وسلم باليمامة، روى عنه: عبد الصمد بن عبد الوارث، وسليم بن الحارث.(@)(@@) (103) -[2: 64] ثنا قيس بن حفص الدارمي، ثنا سليم بن الحارث، ثنا جهضم بن الضحاك الجهضمي، قال: قلت لعداء بن خالد بن هوذة: رأيت النبي صلى الله عليه وسلم قال: " نعم، وكان حسن السبلة ". قال: وكانت العرب تسمي اللحية السبلة(@)(@@)(@@)(@@) ||| AUTO جهم بن عمرو(@)(@@) يروي عن: ابن مسعود، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO 
ms469	 جهم بن أبي الجهم(@)(@@) يروي عن: عبد الله بن جعفر والمسور بن مخرمة، وهو مولى الحارث بن حاطب القرشي، روى عنه: محمد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO جهم بن المستمر(@)(@@) عن: ابن عباس، روى عنه: إبراهيم بن عبد الرحمن المخزومي.(@)(@@)(@@)(@@) ||| AUTO جهم بن عبد الرحمن بن موهب(@)(@@) يروي عن: عبد الله بن جعفر بن أبي طالب، روى عنه: الوليد بن جميع.(@)(@@)(@@)(@@) ||| AUTO جهم بن الأسود(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عبيد الله بن المغيرة.(@)(@@)(@@)(@@) ||| AUTO جارود بن أبي سبرة الهذلي البصري، وقد قيل: البهدلي(@)(@@) يروي عن:(@)PageV01P002(@)(@@) [ج 2: ص 65] أنس بن مالك، روى عنه: ربعي بن عبد الله، وعمرو بن أبي الحجاج، مات سنة عشرين ومائة بالبصرة.(@)(@@) (104) -[2: 65] ثنا القطان، قال: ثنا نوح بن حبيب، قال: ثنا وكيع بن الجراح، قال: ثنا ربعي بن عبد الله، عن الجارود بن أبي سبرة، عن أنس بن مالك، قال: " كان النبي صلى الله عليه وسلم إذا صلى في السفر استقبل براحلته نحو القبلة فكبر، ثم صلى على أي جهة أخذت "(@)(@@)(@@)(@@) ||| AUTO جارود بن عمير(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: إسرائيل بن يونس.(@)(@@)(@@)(@@) ||| AUTO جارية بن سليمان المسلي(@)(@@) يروي عن: ابن الزبير، روى عنه: إسماعيل بن أبي خالد.(@)(@@)(@@)(@@) ||| AUTO جنيد(@)(@@) شيخ، يروي عن: ابن عمر، روى عنه: مالك بن مغول.(@)(@@)(@@)(@@) ||| AUTO جميع بن عمير الحنفي الكوفي(@)(@@) أحد بني تيم الله بن ثعلبة، يروي عن: ابن عمر وعائشة، روى عنه: صدقة بن يسار، والعلاء بن صالح.(@)(@@)(@@)(@@) ||| AUTO جعدة بن هبيرة المخزومي(@)(@@) والد يحيى بن جعدة، يروي عن: علي، روى عنه: سعيد بن علاقة، ويزيد الأودي أبو إدريس، مات في زمن معاوية ولا أعلم لصحبته شيئا صحيحا، فأعتمد عليه، فلذلك أدخلناه في التابعين.(@)(@@)(@@)(@@) ||| AUTO جعد بن دينار أبو عثمان اليشكري البصري الصيرفي(@)(@@) يروي عن: أنس، روى عنه: شعبة، وحماد بن زيد، يخطئ.(@)(@@)(@@)(@@) ||| AUTO جعد بن عبد الرحمن بن أوس المدني(@)(@@) يروي عن: السائب بن PageV01P002 [ج 2: ص 66] يزيد، روى عنه: يحيى القطان والبصريون.(@)(@@)(@@)(@@) ||| AUTO جويرية بن قدامة 
ms470	 التميمي(@)(@@) يروي عن: عمر بن الخطاب، روى شعبة، عن أبي جمرة، عنه.(@)(@@) (105) -[2: 66] ثنا المنذر، قال: ثنا الحسن بن محمد بن الصباح، قال: ثنا شبابة، قال: ثنا شعبة، ثنا أبو جمرة، عن جويرية بن قدامة، قال: خطب عمر بن الخطاب، فقال: " رأيت كأن ديكا نقرني "، قال: فما لبث إلا قليلا حتى أصيب(@)(@@)(@@)(@@) ||| AUTO جبر بن نوف البكالي أبو الوداك(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: أبو إسحاق، وأبو التياح، وقد قيل: أبو الوداك البكيلي.(@)(@@)(@@)(@@) ||| AUTO جبر بن عبيدة(@)(@@) يروي عن: أبي هريرة، روى عنه: سيار أبو الحكم.(@)(@@)(@@)(@@) ||| AUTO جري بن كليب النهدي(@)(@@) يروي عن: علي، وبشير بن الخصاصية، روى عنه: قتادة.(@)(@@)(@@)(@@) ||| AUTO جري بن سمرة(@)(@@) يروي عن: علي، روى عنه: أبو إسحاق الهمداني.(@)(@@)(@@)(@@) ||| AUTO جري بن الحارث القرشي(@)(@@) مولى عثمان بن عفان، يروي عن: عثمان، روى عنه: هانئ مولى عثمان.(@)(@@)(@@)(@@) ||| AUTO جناح الشامي(@)(@@) مولى الوليد، وهو والد مروان بن جناح، يروي عن: واثلة بن الأسقع، روى عنه: عثمان بن حصين الشامي وزيد بن واقد.(@)(@@)(@@)(@@) ||| AUTO جندل(@)(@@) يروي عن: عمر بن الخطاب، روى عنه: عيسى بن يونس.(@)(@@)(@@)(@@) ||| AUTO جهضم بن الضحاك أبو رؤبة الباهلي(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم PageV01P002 [ج 2: ص 67] باليمامة، روى عنه: عبد الصمد بن عبد الوارث.(@)(@@)(@@)(@@) ||| AUTO جمهان(@)(@@) مولى الأسلميين، كنيته أبو العلاء، يروي عن: عثمان، وسعد، روى عنه عروة بن الزبير، كان علي بن المديني، يقول: أمي من ولد عباس بن جمهان.(@)(@@)(@@)(@@) ||| AUTO جهيم الفهري(@)(@@) يروي عن: عثمان، وسعد، وعمار، روى عنه: حصين بن عبد الرحمن، وأبو عون الثقفي.(@)(@@)(@@)(@@) ||| AUTO أبو الجلد الجوني اسمه جيلان بن أبي فروة الأسدي(@)(@@) بصري، ويقال: إن ابن فروة كان يقرأ الكتب، روى عنه أبو عمران الجوني.(@)(@@)(@@)(@@) ||| AUTO جون بن قتادة(@)(@@) بصري، يروي عن: سلمة بن المحبق، روى عنه: الحسن.(@)(@@)(@@)(@@) ||| AUTO جبار الطائي(@)(@@) يروي عن: ابن عباس، روى عنه: أبو إسحاق الهمداني.(@)(@@)(@@)(@@) ||| AUTO جلاس بن محمد الكلبي(@)(@@) يروي عن: ابن عمر، روى عنه: أبو جناب ومنهم من 
ms471	 زعم أنه جلاس بن عمرو.(@)(@@)(@@)(@@) ||| AUTO جروة بن جميل الطائي كوفي(@)(@@) يروي عن: جماعة من الصحابة، روى عنه: أهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO جحادة الأيامي(@)(@@) والد محمد بن جحادة، كوفي، يروي عن: عائشة مات في طريق مكة، روى عنه: ابنه محمد بن جحادة.(@)(@@)(@@)(@@) ||| AUTO جوثة بن عبيد المدني الديلي(@)(@@) يروي عن: أنس بن مالك، روى عنه: عياش بن عباس، روى عنه: غنجار، فقال: جوثة، وهو وهم، مات جوثة سنة سبع وعشرين ومائة، وكان كنيته أبا عبيد، ولا أعلم له سماعا من أحد من الصحابة إلا من أنس بن مالك فقط.(@)PageV01P002(@)(@@) [ج 2: ص 68](@)(@@)(@@)(@@) ||| AUTO جرثومة بن عبد الله النساج أبو محمد(@)(@@) مولى بلال بن أبي بردة، بصري، يروي عن: أنس بن مالك، روى عنه: التبوذكي.(@)(@@)(@@)(@@) ||| AUTO جرز بن جابر الخثعمي(@)(@@) ويقال: جزء بن جابر، يروي المراسيل، روى الزهري، عن أبي بكر بن عبد الرحمن، عنه.(@)(@@)(@@)(@@) ||| AUTO جشيب الشامي(@)(@@) عريف العرفاء يروي عن: أبي الدرداء، روى عنه: معاوية بن صالح.(@)(@@)(@@)(@@) ||| AUTO جابان(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: نبيط بن شريط، وسالم بن أبي الجعد.(@)(@@)(@@)(@@) ||| AUTO الجهدمة(@)(@@) امرأة بشير بن الخصاصية، روت عن: بشير ابن الخصاصية، روى عنها: إياد بن لقيط، وقد قيل: إنها بنت يزيد.(@)(@@)(@@)(@@) ||| AUTO جسرة بنت دجاجة(@)(@@) تروي عن: عائشة، روى عنها: أفلت بن خليفة، وقدامة العامري.(@)(@@)(@@)(@@) || AUTO باب الحاء(@)(@@) قال أبو حاتم:(@)(@@) وممن روى من التابعين عن الصحابة ممن ابتدأ اسمه على الحاء:(@)(@@)(@@)(@@) ||| AUTO الحسن بن الحسن بن علي بن أبي طالب الهاشمي(@)(@@) والد عبد الله بن PageV01P002 [ج 2: ص 69] الحسن بن الحسن، يروي عن: أبيه، روى عنه: ابنه إبراهيم بن الحسن، مات يعني عبد الله في سجن أبي جعفر سنة خمس وأربعين ومائة بالهاشمية.(@)(@@)(@@)(@@) ||| AUTO الحسن بن محمد بن علي بن أبي طالب(@)(@@) أخو عبد الله بن محمد، يروي عن: جابر بن عبد الله، روى عنه: الزهري، وعمرو بن دينار، مات في زمن عبد الملك، وكان من علماء الناس بالاختلاف، وكان يقول: من خلع أبا بكر، وعمر فقد 
ms472	 خلع السنة.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عبد الرحمن بن عوف الزهري(@)(@@) يروي عن: أبيه، روى عنه: كثير بن عبد الله اليشكري.(@)(@@)(@@)(@@) ||| AUTO الحسن بن سهيل بن عبد الرحمن بن عوف(@)(@@) يروي عن: ابن عمر، روى عنه: يزيد بن أبي زياد.(@)(@@)(@@)(@@) ||| AUTO الحسن بن أبي الحسن أبو سعيد البصري(@)(@@) واسم أبيه يسار مولى زيد بن ثابت الأنصاري، وكان من سبي ميسان، واسم أمه خيرة مولاة أم سلمة، ولد الحسن لسنتين بقيتا من خلافة عمر، وكان يوم الدار ابن أربع عشرة سنة، واحتلم سنة سبع وثلاثين، وخرج من المدينة ليالي صفين ولم يلق عليا، وقد أدرك بعض صفين، ورأى عشرين ومائة من أصحاب رسول الله صلى الله عليه وسلم وما شافه بدريا قط إلا عثمان وعثمان لم يشهد بدرا، مات في شهر رجب سنة عشر ومائة، وهو ابن تسع وثمانين سنة، وكان يدلس، وصلى عليه النضر بن عمرو المقري من حمير من أهل الشام، وكان الحسن من أفصح أهل البصرة لسانا، وأجملهم وجها، وأعبدهم عبادة، وأحسنهم عشرة، وأنقاهم بدنا رحمة الله عليه.(@)PageV01P002(@)(@@) [ج 2: ص 70](@)(@@)(@@)(@@) ||| AUTO الحسن بن علي بن أبي رافع(@)(@@) مولى رسول الله صلى الله عليه وسلم يروي عن: أبي رافع مولى رسول الله صلى الله عليه وسلم روى عنه: الضحاك بن عثمان، وبكير بن الأشج.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عثمان بن عبد الرحمن بن عوف الزهري(@)(@@) يروي عن: المسور بن مخرمة، وابن الزبير، روى عنه ولده.(@)(@@)(@@)(@@) ||| AUTO الحسن بن هادية من أهل عمان(@)(@@) يروي عن: ابن عمر، روى عنه: الزبير بن الخريت في فضل الحج.(@)(@@)(@@)(@@) ||| AUTO الحسن بن يزيد السعدي(@)(@@) أحد بني بهدلة، يروي عن: أبي سعيد الخدري، روى عنه: أبو الصديق الناجي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن مهران الكرماني(@)(@@) يروي عن: فرقد وله صحبة، روى عنه: محمد بن سلام البيكندي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن مالك بن الحويرث،(@)(@@) يروي عن: أبيه، روى عنه: ابنه مالك بن الحسن بن مالك بن الحويرث.(@)(@@)(@@)(@@) ||| AUTO الحسن بن محمد العبدي(@)(@@) يروي المراسيل، روى عنه: ابن المبارك الهنائي.(@)(@@)(@@)(@@) ||| AUTO الحسن 
ms473	 بن سعد بن معبد الكوفي(@)(@@) مولى علي بن أبي طالب، يروي عن: عبد الله بن جعفر، روى عنه: محمد بن أبي يعقوب، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO الحسن بن أسامة بن زيد(@)(@@) مولى رسول الله صلى الله عليه وسلم يروي عن: أبيه، روى عنه: مسلم بن أبي سهل النبال.(@)PageV01P002(@)(@@) [ج 2: ص 71](@)(@@)(@@)(@@) ||| AUTO الحسن بن يزيد العجلي(@)(@@) يروي عن: ابن مسعود، روى عنه: ابن أبي نجيح.(@)(@@)(@@)(@@) ||| AUTO الحسن بن الحسين(@)(@@) يروي عن: عمر بن الخطاب، أنه قال: " أفضل الغزو الرباط ". روى عنه: يزيد بن عبد الله بن أسامة بن الهادي.(@)(@@)(@@)(@@) ||| AUTO الحسن بن جابر(@)(@@) يروي عن: المقدام بن معدي كرب، كنيته أبو عبد الرحمن الكندي، ويقال: اللخمي، روى عنه: معاوية بن صالح، مات سنة ثمان وعشرين ومائة.(@)(@@)(@@)(@@) ||| AUTO الحسن بن عبد الله العرني(@)(@@) مولى بجيلة، يروي عن: ابن عباس، روى عنه: سلمة بن كهيل، يخطئ(@)(@@)(@@)(@@) ||| AUTO الحسن بن غالب التميمي(@)(@@) يروي عن: سلمان، روى عنه: الحكم أبو مضر.(@)(@@)(@@)(@@) ||| AUTO الحسن بن أيوب بن عبد الله الحضرمي(@)(@@) شامي، يروي عن: عبد الله بن بسر، روى عنه: يحيى بن صالح الوحاظي، وأهل الشام.(@)(@@) (106) -[2: 71] ثنا عمرو بن محمد بن بحير، قال: ثنا يحيى بن صالح الوحاظي، قال: ثنا الحسن بن أيوب الحضرمي، قال: ثنا عبد الله بن بسر، أنه كان في قرن رأسه شامة، فقال له النبي صلى الله عليه وسلم: " لتدركن قرنا "(@)(@@)(@@)(@@) ||| AUTO الحسن الكوفي(@)(@@) شيخ، يروي عن: ابن عباس، روى عنه: ليث بن أبي سليم، لا أدرى من هو ولا ابن من هو.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أوس النجاري الأنصاري المازني(@)(@@) كان من علماء PageV01P002 [ج 2: ص 72] الأنصار وقرائهم، يروي عن: عثمان بن عفان، روى عنه: عاصم بن عمر بن قتادة.(@)(@@)(@@)(@@) ||| AUTO الحارث بن الأزمع العبدي الوادعي الهمداني الكوفي(@)(@@) يروي عن: عمر، وابن مسعود، وعمرو بن العاص، روى عنه: الشعبي، مات في إمارة النعمان بن بشير بالكوفة سنة ستين في آخر ولاية معاوية.(@)(@@)(@@)(@@) ||| AUTO الحارث بن مضرب(@)(@@) يروي عن: عمار بن ياسر، روى عنه: أبو إسحاق 
ms474	 الهمداني.(@)(@@)(@@)(@@) ||| AUTO أبو كثير الزبيدي، اسمه الحارث بن جمهان الكوفي(@)(@@) يروي عن: علي، وابن مسعود، روى عنه: مسعر، وأهل الكوفة.(@)(@@)(@@)(@@) ||| AUTO الحارث بن سويد بن قلاص أبو عائشة التيمي الكوفي الأعور(@)(@@) يروي عن: علي، وابن مسعود، روى عنه: أبو حيان التيمي، وإبراهيم التيمي، مات في ولاية ابن الزبير، وصلى عليه عبد الله بن يزيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أبي الحارث الأزدي(@)(@@) كوفي، يروي عن: علي، روى عنه: سماك بن حرب، يقال: إنه من أهل نصيبين.(@)(@@)(@@)(@@) ||| AUTO الحارث بن حرمل(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: جندب، ذكره في باب جندب.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عمرو الباهلي(@)(@@) من أهل البصرة، روى عنه: ابنه عبد الله، ذكره في باب عبد الله.(@)PageV01P002(@)(@@) [ج 2: ص 73](@)(@@)(@@)(@@) ||| AUTO الحارث بن جندب(@)(@@) يروي عن: علي، روى عنه: رجاء بن حيوة.(@)(@@)(@@)(@@) ||| AUTO الحارث بن حبيش الأسدي(@)(@@) يروي عن: سعد بن أبي وقاص، وعلي، روى عنه: أبو وائل.(@)(@@)(@@)(@@) ||| AUTO الحارث بن ثوب الأسدي(@)(@@) كوفي، يروي عن: علي، روى عنه: العباس بن ذريح.(@)(@@)(@@)(@@) ||| AUTO الحارث بن حاطب(@)(@@) يروي عن: ابن الزبير، روى عنه: يوسف بن سعد.(@)(@@)(@@)(@@) ||| AUTO الحارث بن خفاف بن إيماء بن رحضة الغفاري(@)(@@) يروي عن: أبيه، روى عنه: خالد بن عبد الله بن حرملة.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الحارث بن عبد الله بن أبي ربيعة عمرو بن المغيرة الحجازي(@)(@@) يروي عن: عمر، وعائشة، روى عنه: سعيد بن جبير، ومجاهد، والشعبي، والزهري، أمه أم ولد.(@)(@@)(@@)(@@) ||| AUTO الحارث بن سعد بن أبي ذباب القرشي الحجازي(@)(@@) بعثه عمر مصدقا، وهو ابن عم أبي هريرة، يروي عن: أبي هريرة، روى عنه: يزيد بن هرمز.(@)(@@) الحارث بن عبد الله(@)(@@) كوفي، يروي عن: ابن مسعود، روى عنه: عمرو بن مرة.(@)PageV01P002(@)(@@) [ج 2: ص 74](@)(@@)(@@)(@@) ||| AUTO الحارث بن عمر الزبيدي(@)(@@) من أهل الكوفة، يروي عن: جماعة من أصحاب رسول الله صلى الله عليه وسلم روى عنه: ابن سيرين، وأهل العراق، مات في إمارة يزيد بن معاوية.(@)(@@)(@@)(@@) ||| AUTO الحارث بن رافع بن مكيث الجهني الربعي المدني(@)(@@) يروي عن: جابر 
ms475	 بن عبد الله، روى عنه: ابنه، خارجة بن الحارث.(@)(@@)(@@)(@@) ||| AUTO الحارث بن خالد بن العاص(@)(@@) سمع عائشة، تقول: قال لي رسول الله صلى الله عليه وسلم: " إن قومك قصروا من البيت، وتركوا منه أذرعا في الحجر، ولولا حداثة قومك بالكفر لهدمته، ولرددته على ما كان، وجعلت له بابين ". روى عنه: زرارة بن مصعب الشني.(@)(@@)(@@)(@@) ||| AUTO الحارث بن شبيل(@)(@@) كوفي، يروي عن: زيد بن أرقم، روى عنه: إسماعيل بن أبي خالد.(@)(@@) (107) -[2: 74] ثنا ابن قتيبة، قال: ثنا ابن أبي السري، قال: ثنا معتمر بن سليمان، قال: ثنا إسماعيل بن أبي خالد، عن الحارث بن شبيل، عن زيد بن أرقم، قال: " كنا نسلم بعضنا على بعض، ونتكلم حتى نزلت {وقوموا لله قانتين}، فأمرنا أن لا نتكلم في الصلاة "(@)(@@)(@@)(@@) ||| AUTO الحارث الخولاني(@)(@@) يروي عن: عبد الله بن عمرو، عداده في أهل مصر، روى سعيد بن أبي أيوب، عن عبد الله بن الوليد عنه.(@)(@@)(@@)(@@) ||| AUTO الحارث بن مخمر أبو حبيب القاضي الشامي(@)(@@) ولاه عبد الملك القضاء بعمان، يروي عن: أبي سعيد الخدري، روى عنه: القاسم بن مخيمرة، وحريز بن عثمان، ويقال: كنيته أبو حسين.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أبي العباس(@)(@@) يروي عن: أبي الطفيل، روى عنه: عبد الرحيم بن عبد ربه، ويقال: ابن أبي عياش.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عبد الله بن عياش(@)(@@) يروي عن: ابن عباس، روى عنه: إبراهيم بن عبد الرحمن بن عبد الله بن أبي ربيعة.(@)PageV01P002(@)(@@) [ج 2: ص 75](@)(@@)(@@)(@@) ||| AUTO الحارث بن عميرة الحارثي الأزدي(@)(@@) يروي عن: معاذ بن جبل، روى عنه: طلحة بن مصرف، عداده في أهل الكوفة، مات في ولاية يزيد بن معاوية.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أبي جميلة(@)(@@) يروي عن: أبي الدرداء، روى عنه: عبد الله بن أبي الحسين، وقال أيضا فيه: أنه يروي عن: أم الدرداء.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عمرو الهذلي المدني(@)(@@) يروي عن: عمرو بن مسعود، روى عنه: مسلم بن جندب، مات سنة سبعين، وقد قيل: ولد في عهد رسول الله صلى الله عليه وسلم.(@)(@@)(@@)(@@) ||| AUTO الحارث بن قيس الجعفي(@)(@@) كوفي، 
ms476	 يروي عن: ابن مسعود، روى عنه: خيثمة بن عبد الرحمن، والنخعي، مات في ولاية معاوية، وصلى أبو موسى الأشعري على قبره بعد ما دفن.(@)(@@)(@@)(@@) ||| AUTO الحارث بن لقيط النخعي الكوفي(@)(@@) شهد القادسية، يروي عن: عمر، روى عنه: ابنه حنش بن الحارث.(@)(@@)(@@)(@@) ||| AUTO الحارث بن زياد(@)(@@) يروي عن: أبي رهم السمعي، وقد أدرك أبا أمامة، روى عنه: يونس بن سيف.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أبي موسى الأشعري(@)(@@) يروي عن أبيه، روى عنه: ابنه كريب بن الحارث، من حديث عبد العزيز بن المختار.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عكرمة(@)(@@) يروي المراسيل، روى عنه: عباد بن إسحاق.(@)PageV01P002(@)(@@) [ج 2: ص 76](@)(@@)(@@)(@@) ||| AUTO الحارث بن قيس أبو موسى(@)(@@) كوفي، رأى عليا، روى عنه: محمد بن قيس الكوفي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن مخلد الزرقي الأنصاري المدني(@)(@@) يروي عن: أبي هريرة، روى عنه: سهيل بن أبي صالح وبسر بن سعيد.(@)(@@)(@@)(@@) ||| AUTO الحارث مولى ابن سباع(@)(@@) يروي عن: أبي سعيد الخدري، روى عنه: عبد الرحمن بن معاوية.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عمير الزبيدي الشامي(@)(@@) يروي عن: معاذ بن جبل، روى عنه: شريك.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عبد الرحمن، كنيته أبو عبد الرحمن(@)(@@) خال ابن أبي ذئب، غزا مع أصحاب رسول الله صلى الله عليه وسلم روى عنه: ابن أبي ذئب، مات سنة سبع وعشرين ومائة، وهو ابن ثلاث وسبعين سنة.(@)(@@)(@@)(@@) ||| AUTO الحارث بن معاقب(@)(@@) يروي عن: أبي هريرة، روى عنه: أبو الغصن ثابت بن قيس.(@)(@@)(@@)(@@) ||| AUTO الحارث بن نوفل(@)(@@) يروي عن: عائشة، روى عنه: ابنه عبد الله بن الحارث الهاشمي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن النعمان الليثي(@)(@@) يروي عن: أنس بن مالك، روى عنه: سعيد بن عمارة.(@)PageV01P002(@)(@@) [ج 2: ص 77](@)(@@)(@@)(@@) ||| AUTO الحارث بن معاوية الكندي(@)(@@) شامي، يروي عن: عمر، روى عنه: سليم بن عامر.(@)(@@)(@@)(@@) ||| AUTO الحارث بن يزيد الصنعاني(@)(@@) يروي عن: أبي ذر الغفاري، روى عنه: يحيى بن سعيد الأنصاري.(@)(@@)(@@)(@@) ||| AUTO الحارث الأشعري(@)(@@) والد مالك، يروي عن: أبي موسى، عداده في أهل الكوفة، روى عنه: ابنه مالك.(@)(@@)(@@)(@@) ||| AUTO الحارث بن فضيل(@)(@@) يروي عن: عبد الرحمن بن أبي قراد 
ms477	 وله صحبة، روى عنه: أبو جعفر الخطمي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن عبد(@)(@@) مولى عثمان بن عفان، روى عنه: أبو عقيل زهرة بن معبد حديث الوضوء، مات في ولاية معاوية.(@)(@@)(@@)(@@) ||| AUTO الحارث بن ميناء(@)(@@) يروي عن: عمر، روى عنه: محمد بن إبراهيم بن الحارث التيمي.(@)(@@)(@@)(@@) ||| AUTO الحارث بن أبي يزيد(@)(@@) مولى الحكم، مدني، يروي عن: جابر بن عبد الله، روى عنه: محمد بن يحيى المدني، وكثير بن زيد.(@)(@@)(@@)(@@) ||| AUTO الحارث بن محمد(@)(@@) يروي عن: أبي الطفيل إن سمع منه، روى عنه: زافر بن سليمان.(@)(@@)(@@)(@@) ||| AUTO الحارث بن يحمد الأشعري(@)(@@) عداده في أهل الشام، يروي عن: عبد الله بن PageV01P002 [ج 2: ص 78] عمر، روى عنه: عبد الرحمن بن يزيد بن جابر، وقد قيل: إنه الحارث بن يمجد، وهو الصحيح لا يحمد، ولاه الوليد بن عبد الملك القضاء بعد يزيد بن أبي مالك.(@)(@@)(@@)(@@) ||| AUTO الحارث بن يعقوب الأنصاري(@)(@@) مصري، يروي عن: سهل بن سعد، روى عنه: ابنه عمرو بن الحارث، وبكر بن مضر.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي ثابت(@)(@@) مولى بني أسد، كنيته أبو يحيى، عداده في أهل الكوفة، واسم أبي ثابت قيس بن دينار، يروي عن: ابن عمر، وابن عباس، روى عنه: الأعمش، والثوري، مات في شهر رمضان سنة تسع عشرة ومائة، كان مدلسا، ثنا الهيثم بن خلف الدوري ببغداد، قال: ثنا إسحاق بن موسى الأنصاري، قال: ثنا أبو بكر بن عياش، قال: قدم حبيب بن أبي ثابت على أهل الطائف فكأنما قرأ عليهم بشيء.(@)(@@)(@@)(@@) ||| AUTO حبيب بن سالم(@)(@@) مولى النعمان بن بشير، كوفي، يروي عن: النعمان بن بشير، روى عنه: أبو بشر، والكوفيون إبراهيم بن محمد بن المنتشر، وغيره.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي فضالة المالكي(@)(@@) وليس بالبصري، يروي عن: عمران بن حصين، روى عنه: سلام بن مسكين.(@)(@@)(@@)(@@) ||| AUTO حبيب بن صهبان الأسدي(@)(@@) يروي عن: عمار بن ياسر، كنيته أبو مالك الكاهلي، روى عنه: أبو حصين والأعمش.(@)(@@)(@@)(@@) ||| AUTO حبيب بن عبيد الرحبي الشامي(@)(@@) أدرك سبعين من أصحاب PageV01P002 [ج 2: ص 79] رسول الله صلى الله عليه وسلم 
ms478	 روى عنه: أهل الشام، وثور بن يزيد وغيره.(@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حبيب بن حماز الأسدي(@)(@@) يروي عن: علي وأبي ذر، روى عنه: سماك بن حرب، كنيته أبو كثير.(@)(@@)(@@)(@@) ||| AUTO أبو جمعة اسمه حبيب بن سباع(@)(@@) من عباد التابعين، رأى جماعة من الصحابة، روى عنه أهل فلسطين.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أوس(@)(@@) يروي عن: عمرو بن العاص، روى عنه: راشد بن سعد.(@)(@@) حبيب(@)(@@) مولى أسيد بن الأخنس، يروي عن: عثمان، روى عنه: عباد بن إسحاق.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي مليكة(@)(@@) يروي عن: ابن عمر، روى عنه: كليب بن وائل.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي حبيب أبو عميرة، ويقال: أبو كشوثاء(@)(@@) يروي عن: أنس بن مالك، روى عنه: خالد أبو العلاء.(@)(@@)(@@)(@@) ||| AUTO حبيب بن عبد الله(@)(@@) يروي عن: عائشة، روى عنه: يحيى بن عبد الله بن مالك.(@)(@@)(@@)(@@) ||| AUTO حبيب بن شداد(@)(@@) أحسبه مولى الزبير، يروي عن: طلحة بن عبيد الله، روى عنه: أبو بردة.(@)PageV01P002(@)(@@) [ج 2: ص 80](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO حبيب بن سبيعة الضبعي(@)(@@) يروي عن: رجل من أصحاب النبي صلى الله عليه وسلم روى عنه: ثابت البناني، ومنهم من زعم أنه سبيعة بن حبيب الضبعي، وقد وهم من قاله.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي كثير(@)(@@) يروي عن: ابن عمر، وابن عباس، روى عنه حماد بن زيد.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي جبيرة(@)(@@) يروي عن: يعلى بن سيابة، روى عنه: عاصم بن أبي النجود.(@)(@@)(@@)(@@) ||| AUTO حبيب بن أبي مليكة النهدي الحداني، كنيته أبو ثور(@)(@@) يروي عن: ابن عمر، روى عنه: الشعبي.(@)(@@)(@@)(@@) ||| AUTO حبيب بن مهران التيمي(@)(@@) كوفي، يروي عن: ابن أبي أوفى، روى عنه: عبد الواحد، وابن نمير، كنيته أبو مالك.(@)(@@) حبيب(@)(@@) يروي عن: أبيه، عن النبي صلى الله عليه وسلم روى عنه: ابنه هرماس بن حبيب.(@)(@@)(@@)(@@) ||| AUTO حبيب بن هند بن أسماء بن حارثة(@)(@@) يروي عن: أبيه، أن النبي صلى الله عليه وسلم بعثه إلى قومه يأمرهم بصيام عاشوراء، روى عنه: أهل المدينة، قال: محمد بن إسحاق، عن عبد الله بن أبي بكر، عن حبيب بن هند، عن 
ms479	 أبيه، وقال: وهيب، عن عبد الرحمن بن حرملة، عن يحيى بن هند، عن أبيه، وكأنهما أخوان إن شاء الله.(@)(@@)(@@)(@@) ||| AUTO حبيب بن يعلى بن أمية(@)(@@) يروي عن: ابن عباس، عن النبي صلى الله عليه وسلم: " لو أن لابن PageV01P002 [ج 2: ص 81] آدم واديين من مال لابتغى إليهما ثالثا ". روى عنه: مصعب بن شيبة.(@)(@@)(@@)(@@) ||| AUTO حبيب بن يزيد(@)(@@) يروي عن: زيد بن أرقم، روى عنه: عمارة الأحمر.(@)(@@)(@@)(@@) ||| AUTO حبيب بن هرم(@)(@@) يروي عن: عمه، عن النبي صلى الله عليه وسلم ولا أدري من عمه، روى عنه: عون بن ذكوان.(@)(@@)(@@)(@@) ||| AUTO حبيب بن سالم(@)(@@) يروي عن: أبي هريرة، روى عنه: محمد بن سعيد الأنصاري، إن لم يكن مولى النعمان بن بشير فلا أدري من هو.(@)(@@)(@@)(@@) ||| AUTO حبيب بن يسار(@)(@@) يروي عن: زيد بن أرقم، روى عنه: يوسف بن صهيب.(@)(@@)(@@)(@@) ||| AUTO حبيب الهذلي(@)(@@) يروي عن: أبي هريرة، روى عنه: مسلم بن جندب.(@)(@@)(@@)(@@) ||| AUTO حبيب بن إبراهيم بن سعد أبو يوسف(@)(@@) مولى سعيد بن عبد الملك، قال: " صليت خلف أنس بن مالك بالبصرة يوم الفطر، فكبر في الأولى سبعا، وفي الثانية خمسا ". روى عنه: إدريس بن يحيى الخولاني المصري، وقتيبة بن سعيد، وابن بكير.(@)(@@) (108) -[2: 81] ثنا محمد بن عبد الله بن الجنيد، قال: ثنا قتيبة بن سعيد، قال: ثنا حبيب بن إبراهيم بن سعد مولى لبني أمية، قال: رأيت أنس بن مالك بالبصرة " كبر عند الخروج إلى المصلى، فاجتمع إليه ناس فصلى بهم يوم الفطر، فكبر في الأولى سبعا، وفي الثانية خمسا "(@)(@@)(@@)(@@) ||| AUTO الحكم بن مسعود الثقفي(@)(@@) يروي عن: عمر، روى عنه: وهب بن منبه.(@)(@@)(@@)(@@) ||| AUTO الحكم بن أبي العاص الثقفي(@)(@@) أخو عثمان بن أبي العاص، عداده في أهل البصرة، روى عنه: معاوية بن قرة.(@)(@@)(@@)(@@) ||| AUTO الحكم بن قيس بن عاصم المنقري(@)(@@) يروي عن: أبيه، روى عنه: قتادة بن دعامة، وهو أخو حكيم بن قيس.(@)PageV01P002(@)(@@) [ج 2: ص 82](@)(@@)(@@)(@@) ||| AUTO الحكم بن عتيبة بن النهاس(@)(@@) مولى امرأة من كندة من بني عدي، كوفي، كنيته أبو محمد، وقد قيل: 
ms480	 أبو عبد الله، يروي عن: أبي جحيفة، وزيد بن أرقم، روى عنه: منصور، وشعبة، ولد سنة خمسين في ولاية معاوية، ومات سنة خمس عشرة ومائة، وقد قيل: سنة ثلاث عشرة ومائة، وكان يدلس، وكان سنه سن إبراهيم النخعي، وهو الحكم بن عتيبة بن النهاس بن حنطب بن يسار، من ولد سعد بن عجل.(@)(@@)(@@)(@@) ||| AUTO الحكم بن عبد الله بن إسحاق بن الأعرج الثقفي(@)(@@) يروي عن: أبي هريرة، وابن عباس، روى عنه: خالد الحذاء، وابن أخيه حاجب بن عمر الثقفي، وهو الذي سأل ابن عباس، عن صيام يوم عاشوراء، فقال: " إذا رأيت هلال المحرم فاعدد، فإذا أصبحت من تاسعة فأصبح منها صائما، فقلت: أكذلك كان محمد صلى الله عليه وسلم يصوم، قال: نعم.(@)(@@)(@@)(@@) ||| AUTO الحكم بن أيوب(@)(@@) يروي عن: أبي هريرة، روى عنه: الجريري.(@)(@@)(@@)(@@) ||| AUTO الحكم بن ميناء(@)(@@) يروي عن: ابن عمر، وابن عباس، روى يحيى بن أبي كثير، عن أبي سلام، عنه.(@)(@@)(@@)(@@) ||| AUTO الحكم بن ميناء المدني(@)(@@) يروي عن: بلال، روى عنه: ابنه شبيب بن الحكم، وهو الذي يروي عن: ابن عمر، وأبي هريرة: " لينتهين أقوام عن تركهم الجمعات أو ليختمن الله على قلوبهم وليكتبن من الغافلين "، روى عنه: معاوية بن سلام.(@)(@@)(@@)(@@) ||| AUTO الحكم بن الأزرق(@)(@@) يروي عن: عبد الله بن عمرو، روى عنه: عكرمة بن خالد.(@)(@@)(@@)(@@) ||| AUTO الحكم بن الوليد الوحاظي(@)(@@) يروي عن: عبد الله بن بسر، روى عنه: عبد الله بن عبد الجبار الخبائري، وكان الحكم إمام مسجد حمص.(@)(@@)(@@)(@@) ||| AUTO الحكم بن عمر(@)(@@) يروي عن: عبد الله بن بسر، روى عنه: أهل الشام.(@)PageV01P002(@)(@@) [ج 2: ص 83](@)(@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO (@@)(@@)(@@) ||| AUTO الحكم التجيبي(@)(@@) يروي عن: أبي هريرة، روى عنه: محمد بن قيس النخعي.(@)(@@) الحكم(@)(@@) يروي عن: ابن عباس، روى سفيان، عن أبي يحيى عنه.(@)(@@) الحكم(@)(@@) شيخ، يروي عن: أنس بن مالك، روى عنه: معاوية بن صالح، لا أدرى من هما ولا من أبوهما.(@)(@@)(@@)(@@) ||| AUTO حميد بن عبد الرحمن بن عوف الزهري القرشي(@)(@@) أخو إبراهيم، وأبي سلمة، وأم حميد، أولاد عبد الرحمن، 