ms201	 يكن بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 639 - عيسى بن إبراهيم(@)(@)(@@) (¬4)(@)(@@) الدورى، حدثنا يحيى بن معين قال: عيسى بن إبراهيم ليس بشئ، روى عنه بقية وكثير بن هشام.(@)(@)(@@)(@@)(@@) ||| AUTO 640 - وعيسى بن ميمون(@)(@)(@@) (¬5)(@)(@@) صاحب القاسم، عن عائشة، ليس بشئ.(@)(@)PageV02P292(@)(@)(@@)(@@)(@@) ||| AUTO 641 - وعدى بن الفضل(@)(@)(@@) (¬1)(@)(@@) لا يكتب حديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 642 - عبد الحميد بن جعفر(@)(@)(@@) (¬2)(@)(@@) قال: عبد الحميد بن جعفر كان يحيى بن سعيد يضعفه.(@)(@)(@@)(@@)(@@) ||| AUTO 643 - وعمرو بن على بن مقدم(@)(@)(@@) (¬3)(@)(@@) لم أكتب عنه شيئا، وكان واسطا نزل البصرة.(@)(@)(@@)(@@)(@@) ||| AUTO 644 - وعطاء بن طلق(@)(@)(@@) (¬4)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 645 - وعنبسة بن سعيد(@)(@)(@@) (¬5)(@)(@@) ضعيف، بصرى، وهو أخو أبى الربيع السمان.(@)(@)PageV02P293(@)(@)(@@)(@@)(@@) ||| AUTO 646 - وعبد الرحيم بن زيد العمى(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 647 - عبد الكريم أبو أمية(@)(@)(@@) (¬2)(@)(@@) قال: حدثنا هشام بن يوسف، عن معمر قال: قال لى أيوب: عبد الكريم أبو أمية غير ثقة فلا يحمل عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 648 - العوام بن حمزة(@)(@)(@@) (¬3)(@)(@@) قال يحيى: والعوام بن حمزة ليس حديثه بشئ يروى عنه يحيى القطان.(@)(@)(@@)(@@)(@@) ||| AUTO 649 - والعوام بن مراجم(@)(@)(@@) (¬4)(@)(@@) لم أسمع أحدا يحدث عنه إلا شعبة.(@)(@)(@@)(@@)(@@) ||| AUTO 650 - وعمران بن يزيد(@)(@)(@@) (¬5) PageV02P294(@)(@@) ليس يحتج بحديثه، روى عنه أبو النصر.(@)(@)(@@)(@@)(@@) ||| AUTO 651 - عمران العمى(@)(@)(@@) (¬1)(@)(@@) قال ابن المدينى: سألت عن عمران العمى؟ فقال: لم يكن به بأس، ولكنه لم يكن من أهل الحديث، وقد كتبت عنه أشياء فرميت بها.(@)(@)(@@)(@@)(@@) ||| AUTO 652 - عبد الواحد بن صفوان(@)(@)(@@) (¬2)(@)(@@) قال العباس: قال ابن معين: عبد الواحد بن صفوان بصرى وليس هو بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 653 - وعبد الله بن عرادة(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 654 - وعلي بن زيد(@)(@)(@@) (¬4)(@)(@@) ليس بحجة.(@)(@)(@@)(@@)(@@) ||| AUTO 655 - وعمر بن راشد(@)(@)(@@) (¬5)(@)(@@) ليس بشئ.(@)(@)PageV02P295(@)(@)(@@)(@@)(@@) ||| AUTO 656 - وعمر بن هارون(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 657 - وعبد العزيز بن حصين بن الترجمان خراسانى(@)(@)(@@) (¬2)(@)(@@) [ضعيف الحديث] (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 658 - وعبد الأعلى بن أبى عبد الله(@)(@)(@@) (¬4)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 659 - عبد الأعلى الثعلبى(@)(@)(@@) (¬5)(@)(@@) قال ابن المدينى: سألت يحيى عن عبد [100 /ب] الأعلى الثعلبى، فقال: تعرف وتنكر.(@)(@)PageV02P296(@)(@)(@@)(@@)(@@) ||| AUTO 660 - عبد الله بن سمه(@)(@)(@@) (¬1)(@)(@@) قال: وقلت ليحيى: إن عبد الله بن سمه يزعم أنه 
ms202	 كان يسأل المحدثين، فقال: ما سأل عبد الله أحدا قط، وأنا معه أنا كنت أسال وأكتب ثم ينسخها منى.(@)(@)(@@)(@@)(@@) ||| AUTO 661 - عمرو بن الأزهر(@)(@)(@@) (¬2)(@)(@@) قال العباس: قال ابن معين: عمرو بن الأزهر كان بواسط، وهو بصرى ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 662 - وعبد الحكيم(@)(@)(@@) (¬3)(@)(@@) واسطى كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 663 - وعبيد بن القاسم(@)(@)(@@) (¬4)(@)(@@) كان يكون فى مسجد الجامع، وكانت له هيئة وكان كذابا.(@)(@)(@@)(@@)(@@) ||| AUTO 664 - وعامر بن صالح(@)(@)(@@) (¬5)(@)(@@) كان يكون عند مسجد حصن، وكان ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 665 - وعبد القدوس الشامى(@)(@)(@@) (¬6) PageV02P297(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 666 - عنبسة بن عبد الرحمن(@)(@)(@@) (¬1)(@)(@@) الذى يروى عنه الوليد بن مسلم، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 667 - وعبد الله بن زحر(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 668 - وعبد العزيز بن عبد الله بن حمزة بن صهيب(@)(@)(@@) (¬3)(@)(@)(@@)(@@)(@@) ||| AUTO 669 - وعطاء بن عجلان(@)(@)(@@) (¬4)(@)(@)PageV02P298(@)(@)(@@)(@@)(@@) ||| CHECK 672 - وعبد الحميد بن [سليمان أخو] فليح(@)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 670 - وعبد الله بن أبى مريم(@)(@)(@@) (¬1)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 671 - وعثمان بن أبى العاتكة(@)(@)(@@) (¬2)(@)(@@) هو أبو حفص القاص، ليس بشئ.(@)(@)(@@) 672 - وعبد الحميد بن [سليمان أخو] (¬3) فليح (¬4)(@)(@@) ليس بشئ.(@)(@)PageV02P299(@)(@)(@@)(@@)(@@) ||| AUTO 673 - وعبد الله بن جعفر(@)(@)(@@) (¬1)(@)(@@) أبو على المدينى: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 674 - وعبيد الله بن عامر الأسلمى(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 675 - عطاء بن عجلان(@)(@)(@@) (¬3)(@)(@@) كوفى ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 676 - وعبد الغفور هو أبو الصباح(@)(@)(@@) (¬4)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 677 - وعبد الرحمن بن سليمان الأصبهانى(@)(@)(@@) (¬5)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 678 - عبد الله بن سنان(@)(@)(@@) (¬6)(@)(@@) كوفى كان ينزل القطيعة، وليس حديثه بشئ.(@)(@)PageV02P300(@)(@)(@@)(@@)(@@) ||| AUTO 679 - عبد الملك بن أبى سليمان(@)(@)(@@) (¬1)(@)(@@) وقال: صدقة بن الفضل: كان يحيى يضعف حديث عبد الملك بن أبى سليمان.(@)(@)(@@)(@@)(@@) ||| AUTO 680 - وعمار بن أبى عمار(@)(@)(@@) (¬2)(@)(@@) قال: وعمار بن أبى عمار مدنى يخالف فى أحاديث، وفى قلبى منه شئ.(@)(@@) وروى عن ابن عباس أنه توضأ لكل صلاة.(@)(@)(@@)(@@)(@@) ||| AUTO 681 - عامر الأحول(@)(@)(@@) (¬3)(@)(@@) وسئل عن عامر الأحول، فقال: شيخ، وحرك يده.(@)(@)(@@)(@@)(@@) ||| AUTO 682 - عيسى الحناط(@)(@)(@@) (¬4)(@)(@@) قال ابن المدينى: ذكروا ليحيى بن سعيد حديث عيسى الحناط عن الشعبى، عن ثلاثة PageV02P301(@)(@@) من أصحاب النبى - صلى الله عليه 
ms203	 وسلم -: "هو أحق بها ما لم تغتسل" (¬1).(@)(@@) فقال: والله ما يسرنى أنى حدثت بهذا الحديث وأنى تصدقت بمالى كله.(@)(@)(@@)(@@)(@@) ||| AUTO 683 - عبد العزيز بن أبان(@)(@)(@@) (¬2)(@)(@@) محمد بن سعيد القارى الترمذى، قال: شهدت وكيعا وسئل عن عبد العزيز بن أبان فقال: له لحية له هيئة.(@)(@@) [101/ أ] إسحاق بن راهويه، قال: شهدت جريرا، أو قال له يحيى بن آدم، يا أبا عبد الله إن عبد العزيز بن أبان، قال: إنك قرأت على منصور، فقال: إن كان يكذب يكذب فسود الله وجهه، ما كنا نسمع من منصور إلا خمسة خمسة إلا يوما واحدا حفظت منه أربعين حديثا.(@)(@)(@@)(@@)(@@) ||| AUTO 684 - عمرو بن مسلم(@)(@)(@@) (¬3)(@)(@@) قال ابن المدينى: ذكرت لعمر بن مسلم صاحب طاوس، فحرك يده، وقال: ما أرى هشام بن حجر (¬4) إلا أمثل منه.(@)(@)(@@)(@@)(@@) ||| AUTO 685 - عمرو بن شعيب(@)(@)(@@) (¬5)(@)(@@) قال ابن (¬6) المدينى: سمعت يحيى، يقول: حديث عمرو بن شعيب عندنا واهى.(@)(@)(@@)(@@)(@@) ||| AUTO 686 - عمر بن قيس(@)(@)(@@) (¬7) PageV02P302(@)(@@) قال: وقال يحيى: سمعت عمر بن قيس يحدث عن عطاء، عن عبيد بن عمير فى دية اليهودى والنصرانى عجائب.(@)(@)(@@)(@@)(@@) ||| AUTO 687 - عمر بن سعد(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: لم يكن عمر بن سعد ممن يعتمد عليه.(@)(@)(@@)(@@)(@@) ||| AUTO 688 - عمر بن أبى سلمة(@)(@)(@@) (¬2)(@)(@@) قال: وقال يحيى: كان شعبة يضعف عمر بن أبى سلمة.(@)(@)(@@)(@@)(@@) ||| AUTO 689 - عيسى الخياط(@)(@)(@@) (¬3)(@)(@@) قال: وقال يحيى: حدثنا عيسى الخياط بحديث الشعبى فى الرجل يتصدق بالصدقة ثم يرثها؟ فقال: عن ابن مسعود، قال يحيى: فقلت له: إنهم يروونه عن مسروق.(@)(@@) فقال ابن مسعود: فقمت وتركته (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 690 - عثمان بن سعد الكاتب(@)(@)(@@) (¬5)(@)(@@) قال: وذكر ليحيى عثمان بن سعد (*) الكاتب فجعل يعجب من الرواية (¬6).(@)(@)PageV02P303(@)(@)(@@)(@@)(@@) ||| AUTO 691 - عبد الله بن سعيد بن أبى سعيد المقبرى(@)(@)(@@) (¬1)(@)(@@) قال السباك: سمعت عبيد الله يقول: ترك يحيى بن سعيد حديث عبد الله بن سعيد(@)(@@) ابن أبى سعيد المقبرى.(@)(@)(@@)(@@)(@@) ||| AUTO 692 - عبد الله بن سعيد بن أبى هند(@)(@)(@@) (¬2)(@)(@@) قال: وقال: عبد الله بن سعيد بن أبى هند: نعرف وننكر (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 693 - عسل بن سفيان(@)(@)(@@) (¬4)(@)(@@) قال: وسمعت 
ms204	 يحيى بن معين، يقول: عسل بن سفيان بصرى كانوا يروون عنه، ثم ضعف حديثه فى حديث رواه عن آخر، عن أبى هريرة، فى السدل، كذا قال يحيى عن آخر، عن أبى هريرة وإنما هو عسل، عن عطاء، عن أبى هريرة (¬5).(@)(@)PageV02P304(@)(@)(@@)(@@)(@@) || AUTO حرف غ(@)(@)(@@)(@@)(@@) ||| AUTO 694 - غالب أبو الهذيل(@)(@)(@@) (¬1)(@)(@@) ابن أبى خيثمة، حدثنا عبد الله بن سعيد الكندى، حدثنا ابن إدريس، حدثنا أبى، عن غالب أبى الهذيل قال: وما كان غالب أبو الهذيل؟ قال: كان رافضيا.(@)(@)(@@)(@@)(@@) ||| AUTO 695 - غالب بن عبيد الله العقيلى(@)(@)(@@) (¬2)(@)(@@) يحيى بن معين قال: غالب بن عبيد الله العقيلى ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 696 - غالب بن عبد الله القرقسانى(@)(@)(@@) (¬3)(@)(@@) ابن إسماعيل قال: سمعت ابن عمار يقول: كتب المعافى بن عمران إلى وكيع ينهاه أن يحدث عن غالب بن عبد الله القرقسانى، وألقاه من رجاله.(@)(@)PageV02P305(@)(@)(@@)(@@)(@@) ||| AUTO 697 - غياث(@)(@)(@@) (¬1)(@)(@@) قال يحيى: وغياث كذاب [101/ ب]، ليس بثقة ولا مأمون.(@)(@)(@@)(@@)(@@) || AUTO حرف ف(@)(@)(@@)(@@)(@@) ||| AUTO 698 - فليح(@)(@)(@@) (¬2)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: سمعت والله أبا كامل مظفر يقول: فليح كنا نتهمه؛ لأنه يتناول أصحاب الزهرى.(@)(@)(@@)(@@)(@@) ||| AUTO 699 - الفضل بن دلهم(@)(@)(@@) (¬3)(@)(@@) قال: وسئل عن الفضل بن دلهم، عن الحسن، فقال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 700 - فضل أو فضيل بن سليمان النميرى(@)(@)(@@) (¬4)(@)(@)PageV02P306(@)(@)(@@)(@@)(@@) ||| CHECK 703 - الفضيل بن ميسرة(@)(@)(@@) قال: وسمعته يقول: فضل أو فضيل بن سليمان النميرى لا يكتب حديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 701 - الفرج بن فضالة(@)(@)(@@) (¬1)(@)(@@) قال: وسئل عن الفرج بن فضالة، فقال: هو ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 702 - فطر(@)(@)(@@) (¬2)(@)(@@) قال: وسمعت قطبة بن العلاء الغنوى، يقول: تركت فطرا؛ لأنه روى أحاديث إزراء على عثمان بن عفان، رحمه الله.(@)(@)(@@) 703 - الفضيل (¬3) بن ميسرة (¬4)(@)(@@) على قال: قال يحيى: قلت للفضيل بن ميسرة أبى معاذ: أحاديث أبى حريز؟ ، قال: سمعتها فذهب كتابى ثم أخذته بعد ذلك من إنسان.(@)(@)(@@)(@@)(@@) ||| AUTO 704 - فائد أبو الورقاء(@)(@)(@@) (¬5)(@)(@@) ضعيف.(@)(@)PageV02P307(@)(@)(@@)(@@)(@@) ||| AUTO 705 - فليح بن سليمان(@)(@)(@@) (¬1)(@)(@@) وسئل عن فليح بن سليمان فلم يقوى أمره، وقال مرة: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 706 - والفرات بن أبى الفرات(@)(@)(@@) (¬2)(@)(@@) بصرى، وليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 
ms205	 707 - فرات بن السائب(@)(@)(@@) (¬3)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO حرف ق(@)(@)(@@)(@@)(@@) ||| AUTO 708 - قزعة بن سويد(@)(@)(@@) (¬4)(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين، عن قزعة بن سويد؟ فقال: ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 709 - قرة بن عبد الرحمن(@)(@)(@@) (¬5) PageV02P308(@)(@@) قال: وسئل عن قرة بن عبد الرحمن، فقال: يقال فيه، وليس به بأس عندى، قال:(@)(@@) وسئل عنه مرة أخرى، فقال: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 710 - قطبة بن العلاء بن المنهال الغنوى(@)(@)(@@) (¬1)(@)(@@) قال أبو حاتم الرازى: قطبة بن العلاء بن المنهال الغنوى، يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 711 - وقزعة بن سويد البصرى(@)(@)(@@) (¬2)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 712 - وقابوس بن أبى ظبيان(@)(@)(@@) (¬3)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@@) قال: وقال أيد بن حنبل ضر به ابن أبى ليلى بشهادة شهد بها.(@)(@@) قال ابن المدينى: كان قابوس بن أبى ظبيان ضعيفا فى الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 713 - القاسم بن فياض(@)(@)(@@) (¬4) PageV02P309(@)(@@) قال ابن معين: القاسم بن فياض، ضعيف، وهو صنعانى، لقيه هشام بن يوسف.(@)(@)(@@)(@@)(@@) ||| AUTO 714 - والقاسم بن عبد الله بن عمر(@)(@)(@@) (¬1)(@)(@@) ليس بشئ. وقال مرة: هو ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 715 - القاسم بن عبد الرحمن(@)(@)(@@) (¬2)(@)(@@) ليس يساوى شيئا.(@)(@)(@@)(@@)(@@) ||| AUTO 716 - قابوس بن أبى ظبيان(@)(@)(@@) (¬3)(@)(@@) قال ابن المدينى: كان قابوس بن أبى ظبيان، ضعيفا فى الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 717 - القاسم بن عوف(@)(@)(@@) (¬4)(@)(@@) قال ابن المدينى: قيل ليحيى بن سعيد: نحفظ حديث قتادة: "إن هذه الحشوش محتضرة" (¬5). قال: لا، قلت: كان شعبة يحدث به عن قتادة، عن النضر بن أنس، عن زيد PageV02P310(@)(@@) ابن أرقم، وكان ابن أبى عروبة يحدثه، عن القاسم بن عوف [102/ أ]، عن زيد بن أرقم.(@)(@@) قال يحيى: شعبة لو علم أنه عن القاسم بن عوف لم يحمله، قلت: لم؟ ، قال: إنه تركه وقد رآه.(@)(@)(@@)(@@)(@@) ||| AUTO 718 - قيس(@)(@)(@@) (¬1)(@)(@@) قال السباك: سمعت أبا الوليد يقول: سمعت شعبة، يقول: كنت مع قيس فى بيت(@)(@@) فجعل يحدثنى عن أبى حسين حتى تمنيت أن البيت يقع على وعليه.(@)(@)(@@)(@@)(@@) ||| AUTO 719 - القاسم بن عوف الشيبانى(@)(@)(@@) (¬2)(@)(@@) قال ابن المدينى: ذكر ليحيى القاسم بن عوف الشيبانى، فقال: قال شعبة: 
ms206	 دخلت عليه؟ ، وحرك يحيى رأسه، فقلت ليحيى: ما شأنه؟ فجعل يجيد، فقلت: ضعفه فى الحديث؟ ، فقال: لو لم يكن يضعفه لروى عنه.(@)(@)(@@)(@@)(@@) || AUTO حرف ك(@)(@)(@@)(@@)(@@) ||| AUTO 720 - كثير بن زيد(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين، عن كثير بن زيد، روى عنه عبد الحميد PageV02P311(@)(@@) الحنفى؟ ، قال: ليس بذاك القوى، وكان قال أولا: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 721 - كثير بن عبد الله بن عمرو بن عوف(@)(@)(@@) (¬1)(@)(@@) ابن معين قال: كثير بن عبد الله بن عمرو بن عوف لجده صحبة وكثير ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 722 - وكليب بن وائل(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 723 - وكثير بن سليمان(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 724 - كثير بن شنظير(@)(@)(@@) (¬4)(@)(@@) ليس بشئ.(@)(@)PageV02P312(@)(@)(@@)(@@)(@@) ||| AUTO 725 - وكثير بن مروان(@)(@)(@@) (¬1)(@)(@@) شامى وليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO حرف ل(@)(@)(@@)(@@)(@@) ||| AUTO 726 - لقيط(@)(@)(@@) (¬2)(@)(@@) على قال: قلت ليحيى: سفيان، يعنى ابن عيينة، الذى روى عنه عمرو؟ ، قال: لا(@)(@@) أدرى.(@)(@)(@@)(@@)(@@) ||| AUTO 727 - ليث بن أبى سليمان(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين، عن ليث بن أبى سليمان قال: ليس حديثه بذاك. صدقة بن الفضل المروزى، قال: ليث أضعف العلمين وحبيب أقواهم.(@)(@)(@@)(@@)(@@) || AUTO حرف م(@)(@)(@@)(@@)(@@) ||| AUTO 728 - ميناء مولى عبد الرحمن بن عوف(@)(@)(@@) (¬4)(@)(@@) قال: حدثنا عبد الرزاق، عن أبيه، عن ميناء، مولى عبد الرحمن بن عوف، وميناء،(@)(@@) ليس بثقة، وربما قال: ومن ميناء إلا عدو لله.(@)(@)(@@)(@@)(@@) ||| AUTO 729 - مخرمة بن بكير(@)(@)(@@) (¬5)(@)(@@) قال: ومخرمة بن بكير.(@)(@)PageV02P313(@)(@)(@@)(@@)(@@) ||| AUTO 730 - ومجمع أبو إسماعيل بن مجمع(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 731 - مغيرة بن عبد الرحمن الحرانى(@)(@)(@@) (¬2)(@)(@@) صاحب أبى الزناد، ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 732 - ومسلمة بن محمد(@)(@)(@@) (¬3)(@)(@@) ليس حديثه بشئ، يروى عن هشام بن عروة (¬4).(@)(@)(@@)(@@)(@@) ||| AUTO 733 - وموسى بن عبيدة(@)(@)(@@) (¬5)(@)(@@) لا يحتج بحديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 734 - ومحمد بن كريب(@)(@)(@@) (¬6)(@)(@@) أخو رشدين ليس حديثه بشئ.(@)(@)PageV02P314(@)(@)(@@)(@@)(@@) ||| AUTO 735 - ومعلى بن عرفان(@)(@)(@@) (¬1)(@)(@@) ليس بشئ، وكان عرافا فى طريق مكة.(@)(@)(@@)(@@)(@@) ||| AUTO 736 - وموسى بن عثمان(@)(@)(@@) (¬2)(@)(@@) يحدث عن الحكم بن عتيبة ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 737 - ومحمد بن الفرات(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 738 - ومحمد بن أبان(@)(@)(@@) (¬4)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 739 - ومحمد بن الحسن 
ms207	 الهمدانى(@)(@)(@@) (¬5) PageV02P315(@)(@@) ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 740 - ومحمد بن الحسن الأسدى(@)(@)(@@) (¬1)(@)(@@) قد أدركته [102/ ب] وليس هو بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 741 - ومطرح بن يزيد(@)(@)(@@) (¬2)(@)(@@) كوفى ضعيف، يروى عنه سفيان، وهو مطرح بن يزيد، ويكنى أبا المهلب.(@)(@)(@@)(@@)(@@) ||| AUTO 742 - وموسى بن طريف(@)(@)(@@) (¬3)(@)(@@) الذى يحدث عنه الأعمش ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 743 - ومحمد بن عون الحراسانى(@)(@)(@@) (¬4) PageV02P316(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 744 - مندل(@)(@)(@@) (¬1)(@)(@@) قال: وسئل عن مندل، فقال: إنما تركناه لمكان الوديعة، يوفئ إلى أنه استودع فخان أو قيل: وديعة لم يحب أن يقبلها.(@)(@)(@@)(@@)(@@) ||| AUTO 745 - موسى الجهنى(@)(@)(@@) (¬2)(@)(@@) على بن المدينى، قال: سألت يحيى بن معين، عن موسى الجهنى؟ ، فقال: لم يكن بذاك.(@)(@@) ابن أبى خيثمة، قال: سألت يحيى بن معين، عن موسى الجهنى؟ فقال: لم يكن بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 746 - مطر الوراق(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: وقال يحيى بن معين: مطر الوراق ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 747 - معاوية بن صالح(@)(@)(@@) (¬4)(@)(@@) على قال: سألت يحيى، عن معاية بن صالح، فقال: ما كنا نأخذ من حديثه فى ذلك الزمان ولا حرفا.(@)(@)PageV02P317(@)(@)(@@)(@@)(@@) ||| AUTO 748 - ميمون بن أبى عبد الله(@)(@)(@@) (¬1)(@)(@@) على قال: سألت يحيى، عن ميمون بن أبى عبد الله الذى روى عنه عوف، عن زيد(@)(@@) ابن أرقم فحمض وجهه، وقال: زعم شعبة أنه كان فسلا.(@)(@)(@@)(@@)(@@) ||| AUTO 749 - معاذ بن معاذ(@)(@)(@@) (¬2)(@)(@@) على قال: سمعت معاذ بن معاذ قال: كتبت عنه عن الزهرى ورغبت عنه، قيل له: لم؟ قال: رأيته يأتى أشعث بن عبد الملك، فإذا قمنا جلس إلى صبيان فأملوها عليه.(@)(@@) قال على: فقلت لمعاذ: من هذا يا أبا المثنى؟ ، فقال: محمد بن أبى حفصة.(@)(@)(@@)(@@)(@@) ||| AUTO 750 - محمد بن أبى حفصة(@)(@)(@@) (¬3)(@)(@@) على بن المدينى، قال: قلت ليحيى: حملت عن محمد بن أبى حفصة؟ ، قال: نعم، كتبت حديثه كله ثم رميت به، قال: وهو نحو صالح بن أبى الأخضر.(@)(@)(@@)(@@)(@@) ||| AUTO 751 - محمد بن أبى حميد(@)(@)(@@) (¬4)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: محمد بن أبى حميد ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 752 - مخرمة بن بكير(@)(@)(@@) (¬5)(@)(@@) قال: وسمعته يقول: مخرمة بن بكير، يقال: إنه وقع إليه 
ms208	 كتاب أبيه فرواه ولم يسمعه.(@)(@)PageV02P318(@)(@)(@@)(@@)(@@) ||| AUTO 753 - مسلم بن يسار الجهنى(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: مسلم بن بشار الجهنى الذى روى عن عمر، رضى الله عنه، عن النبى - صلى الله عليه وسلم -: "إن الله مسح ظهر آدم"، لا يعرف.(@)(@)(@@)(@@)(@@) ||| AUTO 754 - محمد بن عبد الله بن مسلم(@)(@)(@@) (¬2)(@)(@@) قال: وسئل عن محمد بن عبد الله بن مسلم ابن أخى شهاب؟ ، فقال: ليس بذاك(@)(@@) القوى، وقال مرة أخرى: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 755 - مسلم الأعور(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته يقول: مسلم الأعور، يقال: إنه اختلط.(@)(@)(@@)(@@)(@@) ||| AUTO 756 - مسعدة بن اليسع(@)(@)(@@) (¬4)(@)(@@) قال: وسئل يحيى لم ترك حديث مسعدة بن اليسع؟ ، فقال: لأنه روى حديثا أنكروه، روى عن جعفر بن محمد أنه حدثه أنه رأى خفاشا مجنونا.(@)(@)(@@)(@@)(@@) ||| AUTO 757 - موسى بن دينار(@)(@)(@@) (¬5)(@)(@@) على قال: قال يحيى بن سعيد: دخلت على موسى بن دينار أنا وحفص بن غياث PageV02P319(@)(@@) فجعلت لا أريده على شئ إلا لقنه، فخرجنا فاتبعنا أبو شيخ، فجعلت أبين له أمره، وجعل لا يقبل (¬1).(@)(@)(@@)(@@)(@@) ||| AUTO 758 - محل الضبى(@)(@)(@@) (¬2)(@)(@@) ابن أبى خيثمة، قال: سألت يحيى عن محل الضبى، فقال: كان وسطا لم يكن بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 759 - معلى بن هلال الكوفى(@)(@)(@@) (¬3)(@)(@@) قال أبو حاتم الرازى: معلى بن هلال الكوفى، ذاهب الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 760 - المثنى بن سعيد(@)(@)(@@) (¬4)(@)(@@) وسئل عن المثنى بن سعيد فقال: ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 761 - ومروان بن سالم(@)(@)(@@) (¬5) PageV02P320(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 762 - ومروان بن شجاع(@)(@)(@@) (¬1)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 763 - ومحمد بن أبى حميد(@)(@)(@@) (¬2)(@)(@@) ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 764 - ومحمد بن مسلم الطائفى(@)(@)(@@) (¬3)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 765 - ومسلم بن كيسان الطائفى(@)(@)(@@) (¬4)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 766 - ومسلم بن كيسان الملائى الأعور(@)(@)(@@) (¬5) PageV02P321(@)(@@) أبو عبد الله الضبى ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 767 - ومسلمة بن على(@)(@)(@@) (¬1)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 768 - وموسى بن أبى كثير، أبو الصباح(@)(@)(@@) (¬2)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 769 - ومحمد بن زياد الطحان(@)(@)(@@) (¬3)(@)(@@) ذاهب الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 770 - والمطلب بن زياد(@)(@)(@@) (¬4) PageV02P322(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 771 - ومنصور بن أبى الأسود(@)(@)(@@) (¬1)(@)(@@) يكتب حديثه 
ms209	 ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 772 - ومحمد بن سابق(@)(@)(@@) (¬2)(@)(@@) صاحب مالك بن مغول، يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 773 - ومحمد بن حميد الرازى(@)(@)(@@) (¬3)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 774 - ومحمد بن حجاج اللخمى(@)(@)(@@) (¬4) PageV02P323(@)(@@) عن مجالد، كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 775 - محمد بن سالم(@)(@)(@@) (¬1)(@)(@@) قال: وسمعت نعيم بن حماد يقول: رأيت ابن المبارك يقول: اطرح حديث محمد بن سالم.(@)(@)(@@)(@@)(@@) ||| AUTO 776 - وميسرة بن عبد ربه(@)(@)(@@) (¬2)(@)(@@) قال: وميسرة بن عبد ربه كذاب يفتعل الحديث تسترى.(@)(@)(@@)(@@)(@@) ||| AUTO 777 - والمنكدر بن محمد بن المنكدر(@)(@)(@@) (¬3)(@)(@@) رجل صالح يكتب حديثه ولا يحتج به، ولم يكن بالحافظ.(@)(@)(@@)(@@)(@@) ||| AUTO 778 - ويوسف بن محمد بن المنكدر(@)(@)(@@) (¬4)(@)(@@) شبيه بأخيه.(@)(@)(@@)(@@)(@@) ||| AUTO 779 - ومحمد بن عبد الله ابن أخى الزهرى(@)(@)(@@) (¬5)(@)(@@) يكتب حديثه وليس بالقوى.(@)(@)PageV02P324(@)(@)(@@)(@@)(@@) ||| CHECK 780 - ومطرف الإسكاف(@)(@)(@@) 780 - ومطرف (¬1) الإسكاف (¬2)(@)(@@) الذى يحدث عنه عبد الله منكر الحديث، كوفى لا يكتب حديثه.(@)(@)(@@)(@@)(@@) ||| AUTO 781 - ومسلم بن خالد الزنجى(@)(@)(@@) (¬3)(@)(@@) مولى بنى مخزوم يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 782 - محمد بن فضاء(@)(@)(@@) (¬4)(@)(@@) ابن أبى خيثمة، قال: وسمعت يحيى بن معين، يقول: محمد بن فضاء ليس حديثه(@)(@@) بشئ.(@)(@)PageV02P325(@)(@)(@@)(@@)(@@) ||| AUTO 783 - موسى بن وردان(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: موسى بن وردان قاص كان يكون بمصر ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 784 - موسى بن فردى(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: موسى بن فردى، كوفى، وما سمعت أحدا يحدث عنه إلا الأشجعى.(@)(@)(@@)(@@)(@@) ||| AUTO 785 - محمد بن معاوية النيسابورى(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته يقول: محمد بن معاوية النيسابورى كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 786 - محمد بن أبى قيس الدمشقى(@)(@)(@@) (¬4)(@)(@@) أبو حاتم الرازى، قال: صلب محمد بن أبى قيس الدمشقى فى الزندقة.(@)(@@) قال: ومنهم من يقول: أبو عبد الرحمن الشامى، ومنهم من يقول: أبو عبد الرحمن(@)(@@) الأزدى.(@)(@)(@@)(@@)(@@) ||| AUTO 787 - ومحمد بن فضيل بن غزوان(@)(@)(@@) (¬5) PageV02P326(@)(@@) قال: ومحمد بن فضيل بن غزوان كثير الخطأ.(@)(@)(@@)(@@)(@@) ||| AUTO 788 - محمد بن جابر(@)(@)(@@) (¬1)(@)(@@) ابن أبى خيثمة، قال: سمعت يحيى يقول: محمد بن جابر ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 789 - مرجى بن رجاء(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: مرجى بن رجاء، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 790 - محمد بن راشد(@)(@)(@@) (¬3)(@)(@@) ميمون بن غيلان، حدثنا أبو 
ms210	 النضر، قال: كنت أوضى شعبة بباب مسجد الرصافة، فمر محمد بن راشد، فقال لى شعبة: سمعت من هذا شيئا؟ .(@)(@@) قلت: نعم حديث كذا وحديث كذا. قال: أما إنه معتزلى رافضى جسمى.(@)(@)(@@)(@@)(@@) ||| AUTO 791 - محمد بن جابر(@)(@)(@@) (¬4) PageV02P327(@)(@@) يحيى بن معين قال: كان محمد بن جابر كوفى أعمى، قال: قلت له: فإنما حديثه كذا، لأنه أعمى؟ . قال: لا، ولكن عمى واختلط عليه.(@)(@)(@@)(@@)(@@) ||| AUTO 792 - ومحمد بن عبيد الله(@)(@)(@@) (¬1)(@)(@@) أضعف من جابر الجعفى.(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 793 - والمنهال بن خليفة(@)(@)(@@) (¬2)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 794 - محمد بن القاسم(@)(@)(@@) (¬3)(@)(@@) وذكر محمد بن القاسم الأسدى فلم يرضه.(@)(@)(@@)(@@)(@@) ||| AUTO 795 - ومحمد بن فضالة(@)(@)(@@) (¬4)(@)(@@) قال: ومحمد بن فضالة ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 796 - ومحمد بن درهم(@)(@)(@@) (¬5) PageV02P328(@)(@@) الذى يروى عنه شبابة ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 797 - ومحمد بن ثابت العبدى(@)(@)(@@) (¬1)(@)(@)(@@)(@@)(@@) ||| AUTO 798 - ومحمد بن ثابت البنانى(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 799 - ومهدى بن هلال(@)(@)(@@) (¬3)(@)(@@) كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 800 - ومثنى بن سعيد(@)(@)(@@) (¬4)(@)(@)PageV02P329(@)(@)(@@)(@@)(@@) ||| AUTO 801 - ومحمد بن عثيم(@)(@)(@@) (¬1)(@)(@@) كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 802 - ومحمد بن الحارث الحارثى(@)(@)(@@) (¬2)(@)(@@) بصرى وليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 803 - ومحمد بن مجيب(@)(@)(@@) (¬3)(@)(@@) كان جار عباد بن عوام، وكان كذابا عدوا لله.(@)(@)(@@)(@@)(@@) ||| AUTO 804 - وموسى بن دهقان(@)(@)(@@) (¬4)(@)(@@) ليس بشئ.(@)(@@) قال ابن المدينى: سمعت يحيى بن سعيد ذكر موسى بن الدهقان، فقال: أفسدوه بآخره.(@)(@)PageV02P330(@)(@)(@@)(@@)(@@) ||| AUTO 805 - محمد بن الفضل(@)(@)(@@) (¬1)(@)(@@) قال ابن معين: ومحمد بن الفضل بن عطية ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 806 - ومحمد بن الفضل الخراسانى(@)(@)(@@) (¬2)(@)(@@) ليس بثقة وأبوه ثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 807 - ومحمد بن الحجاج الواسطى(@)(@)(@@) (¬3)(@)(@@) ليس بثقة. كان ينزل فصيل الكرخ.(@)(@)(@@)(@@)(@@) ||| AUTO 808 - ومحمد بن الحجاج المصفر(@)(@)(@@) (¬4)(@)(@@) ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 809 - ومحمد بن سعيد بن أبى سعيد(@)(@)(@@) (¬5)(@)(@@) ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 810 - ومعان بن رفاعة(@)(@)(@@) (¬6) PageV02P331(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 811 - ومسلمة الشامى(@)(@)(@@) (¬1)(@)(@@) ليس بشئ، وهو مسلمة بن على الخشنى.(@)(@)(@@)(@@)(@@) ||| AUTO 812 - ومحمد بن عبد الرحمن بن مجبر(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 813 - ومنصور بن دينار(@)(@)(@@) (¬3)(@)(@@) ضعيف الحديث، روى عنه وكيع.(@)(@)(@@)(@@)(@@) ||| AUTO 814 - محمد بن عبد العزيز بن عمر بن عبد الرحمن بن عوف(@)(@)(@@) (¬4) PageV02P332(@)(@@) قال ابن إسماعيل: هو منكر الحديث 
ms211	 وبمشورته جلد مالك.(@)(@)(@@)(@@)(@@) ||| AUTO 815 - محمد بن عبيد الله بن أبى رافع(@)(@)(@@) (¬1)(@)(@@) مولى النبى - صلى الله عليه وسلم -، قال ابن إسماعيل: هو منكر الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 816 - محمد بن عبيد الله العرزمى(@)(@)(@@) (¬2)(@)(@@) قال ابن إسماعيل: تركه ابن المبارك ويحيى.(@)(@)(@@)(@@)(@@) ||| AUTO 817 - ومحمد بن فرات الكوفى(@)(@)(@@) (¬3)(@)(@@) قال ابن إسماعيل: إنه منكر الحديث، وقال: هو أبو على التميمى.(@)(@)(@@)(@@)(@@) ||| AUTO 818 - محمد بن كثير(@)(@)(@@) (¬4)(@)(@@) أبو يوسف المصيصى، قال ابن إسماعيل: إن أحمد ضعفه، وقال: بعث إلى اليمن فأتى بكتاب معمر فأخذه ورواه.(@)(@)(@@)(@@)(@@) ||| AUTO 819 - محمد بن المحرم(@)(@)(@@) (¬5)(@)(@@) روى عن عطاء والحسن، قال ابن إسماعيل: هو منكر الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 820 - محمد بن عبد الله بن عبيد الله بن عمير(@)(@)(@@) (¬6) PageV02P333(@)(@@) قال السباك، قال عبيد الله، عن يحيى: محمد بن عبد الله بن عبيد بن عمير ترك حديثه.(@)(@)(@@)(@@)(@@) || AUTO حرف "ن"(@)(@)(@@)(@@)(@@) ||| AUTO 821 - ناصح الكوفى(@)(@)(@@) (¬1)(@)(@@) قال: ناصح الكوفى صاحب سماك ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 822 - والنضر بن إسماعيل البجلى(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 823 - ونوح بن دراج(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 824 - ونهشل(@)(@)(@@) (¬4) PageV02P334(@)(@@) ليس بشئ، روى عنه ابن نمير.(@)(@)(@@)(@@)(@@) ||| AUTO 825 - والنضر بن مطرف(@)(@)(@@) (¬1)(@)(@@) كوفى ضعيف، روى عنه الفزارى.(@)(@)(@@)(@@)(@@) ||| AUTO 826 - والنهاس بن قهم(@)(@)(@@) (¬2)(@)(@@) كان قاضيا، وليس هو بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 827 - والنعمام بن راشد(@)(@)(@@) (¬3)(@)(@@) ضعيف الحديث.(@)(@)PageV02P335(@)(@)(@@)(@@)(@@) ||| AUTO 828 - ونضر بن ثابت(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 829 - ونصر بن حاجب(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 830 - ونهشل الخراسانى(@)(@)(@@) (¬3)(@)(@@) يروى عن الضحاك، ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 831 - النضر بن شيبان(@)(@)(@@) (¬4)(@)(@@) ابن أبى خيثمة، قال: سئل يحيى بن معين عن حديث النضر بن شيبان، روى عن أبى سلمة بن عبد الرحمن، عن أبيه قال: ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 832 - ناجية(@)(@)(@@) (¬5)(@)(@@) قال: وسمعت يحيى بن معين، قال: حدثنا وكيع قال: قال شعبة: لقيت ناجية الذى PageV02P336(@)(@@) يروى [عنه] (¬1) أبو إسحاق فرأيته يلعب بالشطرنج فتركته فلم أكتب عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 833 - ناصح البكرى(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: ناصح البكرى ليس حديثه بشئ، وهو ناصح بن العلاء أبو العلاء.(@)(@)(@@)(@@)(@@) ||| AUTO 834 - نوح بن أبى مريم(@)(@)(@@) (¬3)(@)(@@) قال أبو حاتم الرازى: نوح بن أبى مريم 
ms212	 أبو عصمة، ذاهب الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 835 - ونضر بن عبد الرحمن الخزاز(@)(@)(@@) (¬4)(@)(@@) أبو عمر، ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 836 - وناصح أبو عبد الله المحملى(@)(@)(@@) (¬5)(@)(@@) متروك الحديث.(@)(@)PageV02P337(@)(@)(@@)(@@)(@@) || AUTO حرف "و"(@)(@)(@@)(@@)(@@) ||| AUTO 837 - الوليد بن كثير(@)(@)(@@) (¬1)(@)(@@) على قال: سمعت سفيان بن عيينة يقول: كان الوليد بن كثير أباضيا، ولكنه كان صدوقا.(@)(@)(@@)(@@)(@@) ||| AUTO 838 - وزير(@)(@)(@@) (¬2)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: وزير الذى يحدث بحديث معاوية: "أن النبى - صلى الله عليه وسلم - أعطاه سهما" (¬3)، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 839 - الوازع بن نافع(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: الوازع بن نافع جزرى عقيلى، ليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 840 - وقاء بن إياس(@)(@)(@@) (¬5) PageV02P338(@)(@@) قال على: سمعت يحيى بن سعيد يقول: ما كان وقاء بن إياس بالذى يعتمد عليه.(@)(@)(@@)(@@)(@@) ||| AUTO 841 - الوليد بن القاسم(@)(@)(@@) (¬1)(@)(@@) قال: وسئل عن الوليد بن القاسم بن الوليد الهمدانى؟ ، فقال: ضعيف الحديث، وأبو خيثمة يحدث عنه.(@)(@)(@@)(@@)(@@) ||| AUTO 842 - وضاح بن يحيى النهشلى(@)(@)(@@) (¬2)(@)(@@) قال أبو حاتم الرازى: وضاح بن يحيى النهشلى، كتبت عنه شيخ وليس بالمتقن.(@)(@)(@@)(@@)(@@) ||| AUTO 843 - واصل بن السائب الرقاشى(@)(@)(@@) (¬3)(@)(@@) صاحب أبى سورة ليس بالقوى.(@)(@)(@@)(@@)(@@) ||| AUTO 844 - واصل بن عبد الرحمن(@)(@)(@@) (¬4)(@)(@)PageV02P339(@)(@)(@@)(@@)(@@) ||| CHECK 847 - والوليد بن عمرو ساج(@)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) ||| AUTO 845 - الوليد بن أبى يونس(@)(@)(@@) (¬1)(@)(@@) قال يحيى: الوليد بن أبى يونس، ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 846 - ورقاء(@)(@)(@@) (¬2)(@)(@@) قال: وقال يحيى بن سعيد: ورقاء لا يساوى شيئا.(@)(@)(@@) 847 - والوليد بن عمرو (¬3) ساج(@)(@@) قال: والوليد بن عمرو ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 848 - واصل(@)(@)(@@) (¬4) PageV02P340(@)(@@) قال السباك الجرجانى: قال عبد الله بن سعيد: يقال: إن واصل، منكر الحديث، وهو الذى يروى عنه الأوزاعى [ ..... ] (¬1).(@)(@)(@@)(@@)(@@) || AUTO حرف "ه"(@)(@)(@@)(@@)(@@) ||| AUTO 849 - الهيثم بن بدر(@)(@)(@@) (¬2)(@)(@@) قال على: سألت جريرا عن الهيثم بن بدر الذى روى عنه مغيرة؟ فقال: كان صبيا وكان على خراج الرى.(@)(@)(@@)(@@)(@@) ||| AUTO 850 - هارون بن معروف بن وهب(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: حدث هارون بن معروف بن وهب، عن محمد بن أبى يحيى فقال يحيى: لم يسمع ابن وهب من محمد بن يحيى، ولو كان أدركه أدرك هشام بن 
ms213	 عروة.(@)(@)(@@)(@@)(@@) ||| AUTO 851 - الهيثم بن حميد(@)(@)(@@) (¬4)(@)(@@) قال: وأخبرنا أبو محمد التيمى قال: وأخبرنا أبو مسهر، حدثنا الهيثم بن حميد، وكان صاحب كتب لم يكن من أهل الإثبات ولا من أهل الحفظ، وقد كنت أمسك عن الحديث عنه استضعفته.(@)(@)(@@)(@@)(@@) ||| AUTO 852 - هشام بن سليمان(@)(@)(@@) (¬5) PageV02P341(@)(@@) قال: حدثنا موسى بن إسماعيل، حدثنا هشام بن سلمان المجاشعى، قال أبو سلمة: وكان ضعيفا.(@)(@)(@@)(@@)(@@) ||| AUTO 853 - هشام مولى عثمان(@)(@)(@@) (¬1)(@)(@@) قال: وقال يحيى: هشام مولى عثمان ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 854 - الهيثم بن جماز(@)(@)(@@) (*) (¬2)(@)(@@) قال أبو حاتم الرازى: الهيثم بن جماز ضعيف الحديث.(@)(@)(@@)(@@)(@@) ||| AUTO 855 - وهلال بن زيد(@)(@)(@@) (¬3)(@)(@@) أبو عقال (¬4)، سمع من أنس، ليس بالقوى.(@)(@)PageV02P342(@)(@)(@@)(@@)(@@) ||| AUTO 856 - هشام بن سعد(@)(@)(@@) (¬1)(@)(@@) قال يحيى بن معين: هشام بن سعد فيه الضعف، وهو صاحب محمد بن كعب القرظى.(@)(@)(@@)(@@)(@@) ||| AUTO 857 - وهياج بن بسطام(@)(@)(@@) (¬2)(@)(@@) قال: وهياج بن بسطام ليس بشئ. وهياج بن بسطام هروى ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 858 - هارون بن سعد(@)(@)(@@) (¬3)(@)(@@) قال: وكان هارون بن سعد من الخريبة (¬4)، ممن يعلموا فى التشيع، روى عنه(@)(@@) المسعودى.(@)(@)PageV02P343(@)(@)(@@)(@@)(@@) ||| AUTO 859 - والهيثم بن عدى(@)(@)(@@) (¬1)(@)(@@) كوفى، ليس بثقة، وكان يكذب، قال: وحدثنى بعض أصحابنا، قال: كانت جارية الهيثم، تقول: كان مولاى يقوم عامة الليل يصلى، فإذا أصبح جلس يكذب.(@)(@)(@@)(@@)(@@) ||| AUTO 860 - وهشام أبو المقدام(@)(@)(@@) (¬2)(@)(@@) ليس بثقة، وهو هشام بن زياد، أخو الوليد بن أبى هاشم، وهو هشام بن زياد، أخو(@)(@@) الوليد بن أبى هاشم (¬3)، وهو مولى عثمان.(@)(@)(@@)(@@)(@@) ||| AUTO 861 - والهذيل بن بلال(@)(@)(@@) (¬4)(@)(@@) كان ينزل المدائن وليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 862 - هشام بن حجير(@)(@)(@@) (¬5)(@)(@@) قال ابن المدينى: قرأت على يحيى: حدثنا عن هشام بن حجير، فقال يحيى: خليق أن أدعه، قلت: أضرب على حديثه؟ قال: إن شئت، فضربت عليه.(@)(@)(@@)(@@)(@@) || AUTO حرف "ى"(@)(@)(@@)(@@)(@@) ||| AUTO 863 - يزيد بن عياض بن جعدبة(@)(@)(@@) (¬6) PageV02P344(@)(@@) قال: يزيد بن عياض بن جعدبة ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 864 - ويونس بن الحارث الطائفى(@)(@)(@@) (¬1)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 865 - ويعقوب بن الوليد(@)(@)(@@) (¬2)(@)(@@) كان بخضرة الرصافة ولم يكن بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 866 - ويحيى بن كاسب(@)(@)(@@) (¬3)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 867 - يوسف السمتى(@)(@)(@@) (¬4) PageV02P345(@)(@@) قال: وكان يوسف السمتى 
ms214	 يكذب.(@)(@)(@@)(@@)(@@) ||| AUTO 868 - ويحيى بن سلمة بن كهيل(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 869 - ويحيى بن عبيد الله(@)(@)(@@) (¬2)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 870 - وياسين بن معاذ(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 871 - ويونس بن خباب(@)(@)(@@) (¬4) PageV02P346(@)(@@) رجل سوء [كان يشتم عثمان بن عفان]، قال ابن المدينى: سمعت يحيى بن سعيد(@)(@@) يقول: ما تعجبنى الرواية عن يونس بن خباب.(@)(@)(@@)(@@)(@@) ||| AUTO 872 - ويزيد بن سنان أبو فروة(@)(@)(@@) (¬1)(@)(@@) يروى عن الزهرى، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 873 - ويحيى بن سليم(@)(@)(@@) (¬2)(@)(@@) شيخ ضعيف، كوفى يروى عنه وكيع.(@)(@)(@@)(@@)(@@) ||| AUTO 874 - ويمان بن المغيرة(@)(@)(@@) (¬3)(@)(@@) ليس حديثه بشئ.(@)(@)PageV02P347(@)(@)(@@)(@@)(@@) ||| AUTO 875 - ويوسف بن عطية الصفار(@)(@)(@@) (¬1)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 876 - ويزيد بن جعدبة(@)(@)(@@) (¬2)(@)(@@) ليس بشئ، وأحسبه الذى ذكره فى أول هذا الحرف.(@)(@)(@@)(@@)(@@) ||| AUTO 877 - ويزيد بن درهم(@)(@)(@@) (¬3)(@)(@@) بصرى، وليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 878 - ويزيد بن عطاء(@)(@)(@@) (¬4)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 879 - ويحيى بن عمرو بن مالك النكرى(@)(@)(@@) (¬5) PageV02P348(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 880 - ويحيى بن راشد(@)(@)(@@) (¬1)(@)(@@) ليس بشئ، وكان يروى عن الجريرى.(@)(@)(@@)(@@)(@@) ||| AUTO 881 - ويزيد بن يوسف(@)(@)(@@) (¬2)(@)(@@) شامى، وليس بثقة.(@)(@)(@@)(@@)(@@) ||| AUTO 882 - ويزيد بن زريع الرملى(@)(@)(@@) (¬3)(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 883 - ابن السكن(@)(@)(@@) (¬4)(@)(@@) كان ابن السكن فى الحرم، وكان يقول: سمعت الشعبى ولم يكن شيئا.(@)(@)(@@)(@@)(@@) ||| AUTO 884 - يحيى بن عطاء بن عجلان(@)(@)(@@) (¬5)(@)(@@) الذى يروى عنه إسماعيل بن عياش، لم يكن بشئ.(@)(@)PageV02P349(@)(@)(@@)(@@)(@@) ||| AUTO 885 - يوسف بن مهران(@)(@)(@@) (¬1)(@)(@@) وسئل صدقة بن الفضل المروزى، عن يوسف بن مهران، فقال: هو شيخ.(@)(@)(@@)(@@)(@@) ||| AUTO 886 - يحيى بن عبيد الله(@)(@)(@@) (¬2)(@)(@@) قال السباك، عن عبيد الله، عن يحيى: إنه ترك حديث يحيى بن عبيد الله، وهو ابن موهب.(@)(@)(@@)(@@)(@@) ||| AUTO 887 - يحيى الأفريقى(@)(@)(@@) (¬3)(@)(@@) على بن المدينى قال: رأيت يحيى ضعف يحيى الأفريقى.(@)(@)(@@)(@@)(@@) ||| AUTO 888 - يحيى بن عبد الله(@)(@)(@@) (¬4)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى بن معين يقول: يحيى بن عبد الله يروى عن أبيه، عن أبى هريرة، ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 889 - يوسف بن أبى ذرة(@)(@)(@@) (¬5)(@)(@@) روى عنه أنس بن عياض، قال: لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 890 - يزيد بن أبى زياد(@)(@)(@@) (¬6)(@)(@@) قال: وسئل عن يزيد بن أبى زياد، فقال: ليس بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 891 - يزيد بن 
ms215	 إبراهيم(@)(@)(@@) (¬7) PageV02P350(@)(@@) على قال: قال يحيى: يزيد بن إبراهيم، عن قتادة، ليس بذاك.(@)(@)(@@)(@@)(@@) ||| AUTO 892 - يعلى أبو أمية بن يعلى(@)(@)(@@) (¬1)(@)(@@) ابن أبى خيثمة قال: سمعت يحيى يقول: يعلى أبو أمية بن يعلى ليس حديثه بشئ، وقال مرة أخرى: ضعيف.(@)(@)(@@)(@@)(@@) ||| AUTO 893 - يوسف بن خالد السمتى(@)(@)(@@) (¬2)(@)(@@) كذاب.(@)(@)(@@)(@@)(@@) ||| AUTO 894 - يزيد بن عطاء(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته يقول: يزيد بن عطاء ضعيف الحديث، وهو مولى أبى عوانة.(@)(@@) وقال مرة أخرى: ليس بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 895 - يحيى بن أبى أنيسة(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: يحيى بن أبى أنيسة ضعيف، وهو أخو زيد بن أبى أنيسة.(@)(@)(@@)(@@)(@@) ||| AUTO 896 - يحيى الجابر(@)(@)(@@) (¬5) PageV02P351(@)(@@) قال: وسمعته يقول: يحيى الجابر لا شئ.(@)(@)(@@)(@@)(@@) ||| AUTO 897 - يحيى الشحام(@)(@)(@@) (¬1)(@)(@@) قال: وذكر يحيى الشحام، فقال: نعرف وننكر.(@)(@)(@@)(@@)(@@) ||| AUTO 898 - يحيى بن مسلم(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: يحيى بن مسلم، ليس حديثه بشئ، روى عنه عبد الله بن داود، وروى عن زيد بن وهب.(@)(@@) على قال: سألت [ .......... ] (¬3).(@)(@)(@@)(@@)(@@) ||| AUTO 899 - يحيى بن عيسى(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: يحيى بن عيسى الرملى، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) ||| AUTO 900 - يحيى البكاء(@)(@)(@@) (¬5) PageV02P352(@)(@@) قال: وسمعته يقول: يحيى البكاء ليس بذاك.(@)(@@) قال: حدثنا عبيد الله بن عمر قال: لم يكن يحيى بن سعيد يرضى يحيى البكاء.(@)(@)(@@)(@@)(@@) ||| AUTO 901 - يزيد الرشك(@)(@)(@@) (¬1)(@)(@@) قال: وسئل عن يزيد الرشك، فقال: ضعيف، قال: وحدثنا يحيى بن معين قال: كان ابن علية يضعف يزيد الرشك.(@)(@@) * * *(@)(@)PageV02P353(@)(@)(@@)(@@)(@@) | AUTO 17 - باب الكنى والألقاب(@)(@)(@@)(@@)(@@) || AUTO 902 - أبو المغيرة القواس(@)(@)(@@) (¬1)(@)(@@) على بن المدينى قال: قال يحيى: كان التيمى سيئ الرأى فى عبد الله بن شقيق، قال: قلت له: فأبو المغيرة القواس؟ قال: كان شرا عنده منه.(@)(@@) قال يحيى: ولم أر أحدا عرف أبا المغيرة غيره.(@)(@)(@@)(@@)(@@) || AUTO 903 - أبو شهاب الحناط(@)(@)(@@) (¬2)(@)(@@) على قال: سمعت يحيى يقول: لم يكن أبو شهاب الحناط بالحافظ، ولم يرض يحيى أمره (¬3).(@)(@)(@@)(@@)(@@) || AUTO 904 - أبو واقد الليثى(@)(@)(@@) (¬4)(@)(@@) على قال: سمعت عبد الرحمن قال: أخبرنى وهيب قال: قدم علينا أبو واقد الليثى يعد (¬5) صالح بن محمد بن زائدة، قال: فسمعته يحدث قال: فلو شئت أن أكتب عندكم، 
ms216	 قال: فتركه.(@)(@)PageV02P354(@)(@)(@@)(@@)(@@) || AUTO 905 - ابن أبى المهدى سعيد بن سنان الحمصى(@)(@)(@@) (¬1)(@)(@@) محمد بن نصر قال: قال محمد بن يوسف: سألت أحمد بن حنبل، عن ابن أبى المهدى سعيد بن سنان الحمصى؟ ، فقال: أحاديثه منكرات، كلها يروى لابن عمر أشياء لم يروها أحد من أصحابه.(@)(@)(@@)(@@)(@@) || AUTO 906 - أبو هلال الراسبى(@)(@)(@@) (¬2)(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين، عن أبى هلال الراسبى؟ ، فقال: ليس بصاحب كتاب وهو ضعيف الحديث.(@)(@)(@@)(@@)(@@) || AUTO 907 - ابن أبى حرملة(@)(@)(@@) (¬3)(@)(@@) ابن المدينى قال: قلت ليحيى: ما رأيت ابن أبى حرملة، لو شئت أن ألقنه أشياء، فقلت: كان يلقن، قال: نعم.(@)(@)(@@)(@@)(@@) || AUTO 908 - أبو واقد(@)(@)(@@) (¬4)(@)(@@) قال ابن أبى خيثمة: وسئل يحيى بن معين، عن واقد الذى روى عنه وهب؟ ، فقال: ضعيف، قال: وسئل عن حديث وهب (¬5)، قال: حدتنى أبو واقد قال: حدثنى أبو أروى، قال: ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 909 - ابن أنيس بن أبى يحيى(@)(@)(@@) (¬6) PageV02P355(@)(@@) قال: وسمعته يقول: ابن أنيس بن أبى يحيى لا يكتب حديثه.(@)(@)(@@)(@@)(@@) || AUTO 910 - أبو حمزة(@)(@)(@@) (¬1)(@)(@@) قال: وسئل عن أبى حمزة الذى روى عنه إبراهيم، قال: اسمه ميمون، كوفى، ضعيف الحديث، وهو الذى حدث عنه حماد بن سلمة، وقد حدث عنه منصور بن المعتمر، قال: حدثنا أبى، حدثنا جرير، عن منصور، عن أبى حمزة، عن سعيد بن المسيب، فسئل يحيى بن معين، عن حديث منصور عن أبى حمزة؟ ، قال: قال أبو حمزة: ميمون القصاب: ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 911 - أبو الغيث(@)(@)(@@) (¬2)(@)(@@) قال: وسمعت يحيى بن معين يقول: أبو الغيث الذى يروى عنه ثور بن زيد ليس بثقة (¬3).(@)(@)(@@)(@@)(@@) || AUTO 912 - أبو الجمل(@)(@)(@@) (¬4)(@)(@@) قال: حدثنا أيوب بن محمد أبو الجمل، سئل يحيى بن معين، عن أبى الجمل، فقال: اسمه أيوب لا شئ.(@)(@)(@@)(@@)(@@) || AUTO 913 - أبو الوداك(@)(@)(@@) (¬5) PageV02P356(@)(@@) قال: وسمعته يقول: أبو الوداك ثقة ما له ولأبى هارون (¬1).(@)(@)(@@)(@@)(@@) || AUTO 914 - أبو هارون العبدى(@)(@)(@@) (¬2)(@)(@@) قال: وسمعت أحمد بن حنبل، يقول: لا يكتب حديث أبى هارون العبدى، قال: وقال يحيى: أبو هارون بصرى، اسمه: عمارة بن جوين.(@)(@)(@@)(@@)(@@) || AUTO 915 - أبو الغصن(@)(@)(@@) (¬3)(@)(@@) قال: وسمعته 
ms217	 وسئل عن أبى الغصن؟ ، فقال: ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 916 - أبو الأعشى العبيدى(@)(@)(@@) (¬4)(@)(@@) قال: وسئل عن أبى الأعشى العبيدى، عن أبى الأحوص؟ ، فقال: ضعيف لا يعرف.(@)(@)(@@)(@@)(@@) || AUTO 917 - أبو حمزة(@)(@)(@@) (¬5)(@)(@@) قال: وسئل عن أبى حمزة الذى روى عن سعيد بن المسيب، وروى عنه منصور بن(@)(@@) المعتمر؟ فقال: ميمون القصاب أبو حمزة، ليس بشئ.(@)(@@) على قال: قلت ليحيى: قال لكم أبو حمزة فى سماعه نحو مما قال ميمون المرائى؟ (¬6)، PageV02P357(@)(@@) قال: نعم، وشر من ذاك، قلت: كيف؟ ، قال: قال منه ما سمعت، ومنه ما حفظه بعضنا عن بعض، ومنه ما لم نسمع حدثنا به أصحابنا.(@)(@@) قال: فقيل ليحيى بن سعيد فى سعيد أخى أبى حمزة: أن عبد الرحمن كان يقول: كنت أتيت شيخ بالبصرة، فقال يحيى: إيش أقول كأنه يضعفه، قال: وسمعته يقول: أبو حمزة الثمالى (¬1)، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 918 - أبو حمزة الثمالى(@)(@)(@@) (¬2)(@)(@@) الحسين قال: حدثنا الحميدى، حدثنا سفيان، حدثنا أبو حمزة الثمالى.(@)(@@) قال الحميدى: أبو حمزة فيه ضعف، وكان وكيع إذا حدث عنه قال: حدثنا ثابت بن أبى صفية.(@)(@)(@@)(@@)(@@) || AUTO 919 - أبو ظلال(@)(@)(@@) (¬3)(@)(@@) ابن أبى خيثمة قال: سئل يحيى بن معين، عن أبى ظلال ما اسمه؟ ، فقال: هلال، وسئل عنه فقال: لا شئ.(@)(@)(@@)(@@)(@@) || AUTO 920 - أبو دراس(@)(@)(@@) (¬4)(@)(@@) قال: وسمعته يقول: أبو دارس صاحب الجوز ضعيف الحديث.(@)(@)(@@)(@@)(@@) || AUTO 921 - أبو خلف موسى بن خلف(@)(@)(@@) (¬5) PageV02P358(@)(@@) قال: وسمعته يقول: وسئل عن أبى خلف موسى بن خلف؟ قال: روى عنه عفان(@)(@@) ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 922 - أبو معاذ(@)(@)(@@) (¬1)(@)(@@) قال: وسمعت أحمد بن حنبل يقول: أبو معاذ الذى روى عنه الثورى عن الحسن(@)(@@) اسمه: سليمان بن أرقم وليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 923 - عليلة بن بدر(@)(@)(@@) (¬2)(@)(@@) قال ابن أبى خيثمة: وسمعت يحيى بن معين يقول: عليلة بن بدر ليس حديثه بشئ، وهو الربيع بن بدر.(@)(@)(@@)(@@)(@@) || AUTO 924 - أبو الربيع السمان(@)(@)(@@) (¬3) PageV02P359(@)(@@) قال: وسمعته يقول: أبو الربيع السمان، ليس حديثه بشئ ضعيف.(@)(@)(@@)(@@)(@@) || AUTO 925 - أبو حفص(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: أبو حفص، ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 926 - أبو بكر بن أبى الأسود(@)(@)(@@) (¬2)(@)(@@) قال: وكان 
ms218	 سيئ الرأى فى أبى بكر ابن أبى الأسود بن أخت عبد الرحمن بن مهدى، وهو عبد الله بن محمد (¬3) بن حميد بن أسود بن أبى الأسود.(@)(@)(@@)(@@)(@@) || AUTO 927 - أبو عبد الله محمد بن كثير(@)(@)(@@) (¬4)(@)(@@) قال: ولا تكتبوا عن أبى عبد الله محمد بن كثير أخى سليمان بن كثير العبدى.(@)(@)(@@)(@@)(@@) || AUTO 928 - ابن عائشة(@)(@)(@@) (¬5)(@)(@@) قال: وسمعته، وقال له إنسان: إن ابن عائشة، فسر: لعن الله من غير منار الأرض، PageV02P360(@)(@@) أنهم العلماء يفسدهم السلطان فيتغيرون، فقال: قبحه الله قد كنت أرى أنه يحسن شيئا، منار الأرض حدودها. على قال: قال يحيى: كان شعبة ينكر أن ظبيان سمع سلمان.(@)(@)(@@)(@@)(@@) || AUTO 929 - أبو صادق(@)(@)(@@) (¬1)(@)(@@) ابن أبى خيثمة قال: حدثنا خالد بن خداش، حدثنا أبو بكر بن شعيب، عن أبيه قال: رأيت أبا صادق صلى فى قطيفة.(@)(@@) قال: فقال له رجل: ما يقول فى عثمان؟ قال: إنى لأشنوه.(@)(@)(@@)(@@)(@@) || AUTO 930 - أبو حمزة القصاب(@)(@)(@@) (¬2)(@)(@@) قال: وسمعت يحيى بن معين يقول: أبو حمزة القصاب لا يكتب حديثه وهو ميمون الأعور.(@)(@)(@@)(@@)(@@) || AUTO 931 - أبو العلاء(@)(@)(@@) (¬3)(@)(@@) قال: وسئل عن حديث يزيد بن هارون، قال: أخبرنا أصبع بن زيد، عن أبى العلاء،(@)(@@) عن أبى أمامة، قال: لبس عمر ثوبا جيدا فكتب على أبى العلاء بخطه ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 932 - أبو الزاهرية(@)(@)(@@) (¬4)(@)(@@) قال: وسئل عن أبى الزاهرية روى عنه أصبع بن زيد فقال: لا شئ.(@)(@)(@@)(@@)(@@) || AUTO 933 - أبو عبد الله البكرى(@)(@)(@@) (¬5)(@)(@@) قال: وسئل عن أبى عبد الله البكرى، روى عنه هشيم بن بشير؟ ، فقال: لا ندرى PageV02P361(@)(@@) من أبو عبد الله.(@)(@)(@@)(@@)(@@) || AUTO 934 - أبو جناب الكلبى(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: أبو جناب الكلبى ضعيف الحديث.(@)(@)(@@)(@@)(@@) || AUTO 935 - ابن ثوبان(@)(@)(@@) (¬2)(@)(@@) قال: وسئل عن ابن ثوبان روى عنه الوليد بن مسلم؟ ، فقال: لا شئ.(@)(@)(@@)(@@)(@@) || AUTO 936 - أبو سفيان السروجى(@)(@)(@@) (¬3)(@)(@@) قال: وقال أبو سفيان السروجى عبد الرحيم بن مطرف ابن عم وكيع يكره الحديث،(@)(@@) عن أبى عبدالله العدوى.(@)(@)(@@)(@@)(@@) || AUTO 937 - أبو معاذ(@)(@)(@@) (¬4)(@)(@@) قال: وسمعت أحمد بن حنبل يقول: أبو معاذ الذى روى عنه سفيان الثورى، عن 
ms219	(@)(@@) الحسن اسمه سليمان بن أرقم ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 938 - أبو مالك النخعى(@)(@)(@@) (¬5) PageV02P362(@)(@@) قال: وسمعت يحيى يقول: أبو مالك النخعى ليس حديثه بشئ.(@)(@@) وأبو مالك النخعى: ضعيف الحديث.(@)(@)(@@)(@@)(@@) || AUTO 939 - أبو عقيل(@)(@)(@@) (¬1)(@)(@@) قال: وسمعته يقول: أبو عقيل صاحب بهية ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 940 - أبو قيس الدمشقى(@)(@)(@@) (¬2)(@)(@@) قال: وسمعته يقول: أبو قيس الدمشقى، ليس بشئ، روى عنه أبو معاوية.(@)(@)(@@)(@@)(@@) || AUTO 941 - ابن أبى لبيبة(@)(@)(@@) (¬3) PageV02P363(@)(@@) قال: وسمعته يقول: ابن أبى لبيبة الذى يروى عنه، وكيع ليس بشئ.(@)(@@) قال: وابن أبى لبيبة ليس حديثه بشئ.(@)(@)(@@)(@@)(@@) || AUTO 942 - أبو أيوب الأفريقى(@)(@)(@@) (¬1)(@)(@@) قال أبو حاتم الرازى: أبو أيوب الأفريقى، يقال له: عبد الله بن على، روى عنه ابن أبى زائدة، ليس بالمتين.(@)(@)(@@)(@@)(@@) || AUTO 943 - أبو شيبة(@)(@)(@@) (¬2)(@)(@@) قال: وأبو شيبة إبراهيم بن عثمان جد أبى بكر بن أبى شيبة ضعيف الحديث.(@)(@)(@@)(@@)(@@) || AUTO 944 - أبو بكر الداهرى(@)(@)(@@) (¬3)(@)(@@) قال: وأبو بكر الداهرى عبد الله بن حكيم ضعيف الحديث.(@)(@)(@@)(@@)(@@) || AUTO 945 - وأبو إسرائيل الملائى(@)(@)(@@) (¬4)(@)(@@) حسن الحديث لا يحتج به، فى حديثه أوهام.(@)(@)(@@)(@@)(@@) || AUTO 946 - وأبو بكر بن عبد الله بن أبى مريم الغسانى(@)(@)(@@) (¬5)(@)(@@) ضعيف الحديث وقاع.(@)(@)PageV02P364(@)(@)(@@)(@@)(@@) || AUTO 947 - وأبو فرة الجزرى الزهاوى(@)(@)(@@) (¬1)(@)(@@) يكتب حديثه ولا يحتج به.(@)(@)(@@)(@@)(@@) || AUTO 948 - وأبو مالك الجنبى(@)(@)(@@) (¬2)(@)(@@) عمرو بن هاشم لين الحديث.(@)(@)(@@)(@@)(@@) || AUTO 949 - والأجلح يحيى بن عبد الله بن حجية الكندى(@)(@)(@@) (¬3)(@)(@@) يكتب حديثه، ولا يحتج به.(@)(@)(@@)(@@)(@@) || AUTO 950 - أبو عاتكة البصرى(@)(@)(@@) (¬4)(@)(@@) صاحب أنس، ضعيفى الحديث.(@)(@)(@@)(@@)(@@) || AUTO 951 - وأبو سمعان(@)(@)(@@) (¬5)(@)(@@) ضعيف الحديث.(@)(@)(@@)(@@)(@@) || AUTO 952 - أبو قتادة الحرانى(@)(@)(@@) (¬6)(@)(@@) وقيل لأبى حاتم: ما تقول فى أبى قتادة الحرانى، وفيما روى أنه دفع إليه حديث أبى PageV02P365(@)(@@) نعيم، عن مسعر، فقرأه حتى بلغ موضع شك فيه أبو نعيم، فقال: ما هذا؟ ، فقال أبو حاتم: ذهب حديثه.(@)(@)(@@)(@@)(@@) || AUTO 953 - وأبو حمزة الثمالى(@)(@)(@@) (¬1)(@)(@@) قال: وأبو حمزة الثمالى، ثابت بن أبى صفية، يكتب حديثه ولا يحتج به.(@)(@@) قال: وأبو حمزة الثمالى ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 954 - وأبو الأسباط الحارثى(@)(@)(@@) (¬2)(@)(@@) صاحب يحيى بن أبى كثير الذى يحدث [عنه] (¬3)، حاتم بن إسماعيل ضعيف(@)(@@) الحديث. 
ms220	(@)(@)(@@)(@@)(@@) || AUTO 955 - وأبو آدم سليمان بن زيد(@)(@)(@@) (¬4)(@)(@@) مولى عبد الله بن أبى أوفى ليس بالقوى.(@)(@)(@@)(@@)(@@) || AUTO 956 - وغندر بن محمد بن جعفر(@)(@)(@@) (¬5)(@)(@@) ثقة فى شعبة، ويكتب حديثه عن غيره، ولا يحتج به.(@)(@)(@@)(@@)(@@) || AUTO 957 - عمر بن قيس(@)(@)(@@) (¬6)(@)(@@) قال: حدثنى يونس بن حبيب العجلى الأصبهانى، حدثنا أبو داود الطيالسى قال: كنا عند عمر بن قيس سندل بمكة، فحدثنا، عن عطاء، عن ابن عباس، عن أسامة قال: قال النبى - صلى الله عليه وسلم -: "لا ربا إلا فى نسيئة".(@)(@)PageV02P366(@)(@)(@@) قال أبو داود: فقلت أنا: حدثنا فلان عن أبى الجوزاء: أن ابن عباس رجع عن الصرف، فقال: انظروا إلى هذا أحدثه عمن جعلتى جعل بين الركن والمقام مراعه، وتحدثنى عن أبى الجوزاء، وأبى اللوز، وأبى الفستق (¬1).(@)(@)(@@)(@@)(@@) || AUTO 958 - وأبو عرنة موسى بن محمد بن مسكر(@)(@)(@@) (¬2)(@)(@@) ضعيف الحديث، كان قاضى المدينة.(@)(@)(@@)(@@)(@@) || AUTO 959 - أبو بكر بن نافع(@)(@)(@@) (¬3)(@)(@@) قال يحيى بن معين: أبو بكر بن نافع ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 960 - وأبو بكر بن أبى سبرة(@)(@)(@@) (¬4)(@)(@@) الذى يقال له: السبرى، ليس حديثه بشئ، وهو مدينى مات ببغداد.(@)(@)(@@)(@@)(@@) || AUTO 961 - ابن كاسب(@)(@)(@@) (¬5)(@)(@@) ليس بشئ.(@)(@)(@@)(@@)(@@) || AUTO 962 - وأبو البخترى(@)(@)(@@) (¬6)(@)(@@) كان خبيثا، وكان يحدث عن هشام بن عروة، عن أبيه، عن عائشة، وعن ثور بن زيد، عن خالد بن معدان، عن معاذ، وعن جعفر بن محمد، عن أبيه، عن على قالوا: قال رسول الله - صلى الله عليه وسلم - فى الخمير يقترض قال: "لا بأس".(@)(@@) وقال مرة: أبو البخترى يضع الحديث، يعنى القاضى، وقال مرة: كان يأخذ ثلاثا فيتذاكر عامة الليل يضع الحديث.(@)(@)PageV02P367(@)(@)(@@)(@@)(@@) || AUTO 963 - ابن زبالة(@)(@)(@@) (¬1)(@)(@@) قال: وابن زبالة المدينى ليس بثقة، كان يسرق الحديث.(@)(@)(@@)(@@)(@@) || AUTO 964 - وأبو جابر البياضى(@)(@)(@@) (¬2)(@)(@@) كذاب.(@)(@@) قال ابن المدينى: قال ليحيى: سألت مالك بن أنس، عن أبى جابر البياضى، فقال: لم يكن يرضاه.(@)(@)(@@)(@@)(@@) || AUTO 965 - ابن أبى خيثم بن عراك بن مالك(@)(@)(@@) (¬3)(@)(@@) قال ابن معين: وكان ابن أبى خيثم بن عراك بن مالك يصيح به الناس ياذا كلامين،(@)(@@) وكان لا يكتب عنه.(@)(@)(@@)(@@)(@@) || AUTO 966 - وأبو 