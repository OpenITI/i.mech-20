ms661	 سعادة % يراوح مغداها إليك وممساها % % 65(@)(@@) % ولا زالت الأيام تملك أمرها % % وتأمرها فيما تشاء وتنهاها % % 66(@)(@@) % وكنت بعين الله في كل نوبة % % تحاذرها نفسي عليك وتخشاها % % 67(@)(@@) % فإني متى علقت نفسي بحاجة % وخفت عليها الفوت ضمنتها الله % % PageV01P2073 البحر : - 1(@)(@@) % سألت غزالا شف قلبي عن اسمه % % فدافع عنه ثم قال وعماه % 2(@)(@@) % هو اسم يعاف الصالحون استماعه % % لأن الذي يهواه يبغضه الله % 3(@)(@@) % وتصحيفه مر على المرء طعمه % يمر على سمع الكريم فيأباه % 4(@)(@@) % ولو قيل لي ثلثاه من فعل صاحب % % تجافيته من بعد ما كنت أهواه % 5(@)(@@) % ولو قيل في أخرى سمعت بصيحة % لساهر ليل بالهموم تغشاه % 6(@)(@@) % ولكن إذا شبهته باسم غادة % فذلك مما تشتهيه وترضاه % PageV01P2074 البحر : - 1(@)(@@) % لمن طالعات في السراب أفول % يقومها الحادون وهي تميل % 2(@)(@@) % نواصل من جو خوائض مثله % صعود على حكم الزمان نزول % 3(@)(@@) % هواها وراء والسرى من أمامها % % فهن صحيحات النواظر حول % 4(@)(@@) % تضاغى وفي فرط التضاغي صبابة % وترغو وفي طول الرغاء غليل % 5(@)(@@) % تراد على نجد ويجذب شوقها % % مظل عراقي الثرى ومقيل % 6(@)(@@) % وما جهلت أن الحجاز معيشة % وروض يربيه الحيا وقبول % 7(@)(@@) % ولكن سحرا بابليا عقوده % % تحلل ألباب بها وعقول % 8(@)(@@) % نجائب إن ضل الحمام طريقه % % إلى أنفس العشاق فهي دليل % 9(@)(@@) % حملن وجوها في الخدور أعزة % وكل عزيز يوم رحن ذليل % 10(@)(@@) % قسمن العقول في الستور بأعين % قواتل لا يودى لهن قتيل % PageV01P2075 11(@)(@@) % وفيهن حاجات ودين غريمه % ملي ولكن الملى مطول % 12(@)(@@) % يخف على أهل القباب قضاؤها % % لنا وهي من في الرقاب ثقيل % 13(@)(@@) % أبى الربع بالبيضاء إلا تنكرا % % وقد تعرف الآثار وهي محول % 14(@)(@@) % ولما وقفنا بالديار تشابهت % جسوم براهن البلى وطلول % 15(@)(@@) % فباك بداء بين جنبيه عارف % وباك بما جر الفراق جهول % 16(@)(@@) % ونسأل عن ظمياء إلا يراعة % تميل مع الأرواح حيث تميل % 17(@)(@@) % ويعجبنا منها بزخرفة الكرى % % دنو إلى طول البعاد يؤول % 18(@)(@@) % فإن كان سؤلا للنفوس بلاؤها % % فإنك للبلوى وإنك سول % 19(@)(@@) % تهجر واش فيك عندي 
ms662	 فساءني % % فقلت عدو أنت قال عذول % 20(@)(@@) % وسفهني في أن تعلقت مانعا % فقلت وهل في الغانيات منيل % PageV01P2076 21(@)(@@) % إذا لم تكن حسناء إلا تخيلة % فلا عجب في أن يحب بخيل % 22(@)(@@) % وقبلك رضت الود وهو مماكس % وصافحت بالأيصار وهو جزيل % 23(@)(@@) % وأتعبني المحفوظ وهو مضيع % لعهدي والمألوف وهو ملول % 24(@)(@@) % وقلبت أبناء الزمان مجربا % % فكانوا كثيرا والصديق قليل % 25(@)(@@) % ولم أر كالأقسام أفسق سيرة % وأجور بين الناس وهي عدول % 26(@)(@@) % ولا كاتباع الحرص للمرء خلة % يدق عليها العرض وهو جليل % 27(@)(@@) % وقد زعموا أن العفاف غميزة % وأن التراخي في الطلاب نكول % 28(@)(@@) % وأن السؤال يسرة ونباهة % وكل انتباه بالسؤال خمول % 29(@)(@@) % إذا كفك الميسور والعرض وافر % فكل الذي فوق الكفاف فضول % 30(@)(@@) % ولكن مجدا فضل سعيك للعلا % % تطوف في إحرازها وتجول % PageV01P2077 31(@)(@@) % وأن تخبط الغبراء ضربا وراءها % % فتعرض في آفاقها وتطيل % 32(@)(@@) % بغى شرف الدين السماء فنالها % % بعزم على سقف السماء يطول % 33(@)(@@) % وخول أعناق المطي فساقها % % وراء التي يسمو بها ويصول % 34(@)(@@) % له كل يوم والرياح ظوالع % مناخ إلى أمر العلا ورحيل % 35(@)(@@) % نفى الضيم عنه أنف غضبان ثائر % يخف وقسط الحادثات ثقيل % 36(@)(@@) % ورأي يود السيف لو شافه الطلى % % به وهو مطرور الغرار صقيل % 37(@)(@@) % إذا هم فالبحر العميق مخاضة % توشل والأرض العريضة ميل % 38(@)(@@) % تحمل عبء المجد فاشتد كاهل % قوي على عض الرحال حمول % 39(@)(@@) % وأنصف أحكام السيادة ناشئا % % وقد غدرت شيب بها وكهول % 40(@)(@@) % فتى صحفه في النازلات دروعه % وأقلامه فيها قنا ونصول % PageV01P2078 41(@)(@@) % تشل العدا حتى يقال كتائب % وتحوي المدى حتى يقال خيول % 42(@)(@@) % وإن شهد اليوم القطوب تهللت % قسائم وجه كلهن قبول % 43(@)(@@) % يضحن إذا الأوضاح بالنقع أبهمت % ويبسمن أمنا والنفوس تسيل % 44(@)(@@) % وفارقها صلب العصا لم يرع له % % جنان ولم ترعد إليه خصيل % 45(@)(@@) % من القوم لم يخز القديم حديثهم % % ولم تتخذل بالفروع أصول % 46(@)(@@) % إذا الأب منهم قص مجدا على ابنه % % تقبل آثار الأسود شبول % 47(@)(@@) % تود النجوم السائرات بأنهم % % إذا ما 
ms663	 انتمت آل لها وقبيل % 48(@)(@@) % ويكرم صوب المزن لو أن ماءه % % ينبط من أيمانهم فيسيل % 49(@)(@@) % لهم من عميد الدولة اليوم ذروة % معاليهم وسطى وهن ذيول % 50(@)(@@) % أريت عيانا مجدهم وهم لنا % % أحاديث مظنون بها ونقول % PageV01P2079 51(@)(@@) % كرمت فلم تجحد لديك وسيلة % وطلت فلم يملك إليك وصول % 52(@)(@@) % وما ارتاب هذا الملك أنك شمسه % تعم فتضفو تارة وتزول % 53(@)(@@) % إذا غربت أبقت فوائد نورها % % وإن صبغت يوما فليس يحول % 54(@)(@@) % وما شك فيك الناس أنك مزنة % تلاقح فيها العام وهو محول % 55(@)(@@) % أحبوك حب العين مسترق الكرى % % وللعين عهد بالرقاد طويل % 56(@)(@@) % إذا كانت الشورى فأنت وما لهم % % إذا خير الإجماع عنك عدول % 57(@)(@@) % فإن وجدوا الأبدال لم يتعرضوا % % فكيف وما في الناس منك بديل % 58(@)(@@) % وقد علمت أم الوزارة أنها % % إذا غبت شمطاء القرون ثكول % 59(@)(@@) % تفارقها مستصلحا فهي فاقد % مولهة حتى يكون قفول % 60(@)(@@) % وتبذلها حتى تغار فترعوي % % بعول تعاطى بضعها وبعول % PageV01P2080 61(@)(@@) % وإعضالها خير لها من رجالها % % سواك وما كل الرجال فحول % 62(@)(@@) % لها غبطة يوما ويوما فجيعة % كذلك دولات الزمان تدول % 63(@)(@@) % وأبقى ذماها علمها أن أمرها % % إليك وإن طال البعاد يؤول % 64(@)(@@) % أنا المطلق المأسور بالقرب والنوى % % فيوما ويوما مظعن ونزول % 65(@)(@@) % تجيش الليالي ثم يخمد صرفها % % فتنقص فيما بيننا وتطيل % 66(@)(@@) % تغيب فلا فرط الأسى بمقبح % علي ولا الصبر الجميل جميل % 67(@)(@@) % فظاهر حالي مثل دمعي لائح % وباطنها مثل الغرام دخيل % 68(@)(@@) % ويأكلني فيك العدا وتعود لي % % فينتشر مرموم العظام أكيل % 69(@)(@@) % وقد أجدبت أرضي فلا يغفلنها % % مع القرب فيض في يديك بليل % 70(@)(@@) % أردني لأمر غيظه حظ صاحبي % % وحظي منه في العلاء جزيل % PageV01P2081 71(@)(@@) % وشافه بحالي ما يكافي كفايتي % % فأنت بفضلي شاهد وكفيل % 72(@)(@@) % ولا تخش من سيف خبرت مضاءه % % وإن كان فلا أن يكون نكول % 73(@)(@@) % فقد يغدق الوادي وأولاه قطرة % ويجسم فعل الرمح وهو نحيل % 74(@)(@@) % وكيف حذارى من جفائك دانيا % % وأنت على بعد الديار وصول % 75(@)(@@) % أتعتاض بالزوراء عنك سحابة 
ms664	 % حياها بحلوان علي هطول % 76(@)(@@) % معاذ علاك وارتياحك للندى % % وحق قديم العهد ليس يحول % 77(@)(@@) % ومبرمة الأسباب شائع ذكرها % % رقيب على نعماك لي ووكيل % 78(@)(@@) % وأنك لا يحلو على يدك الغنى % % ولا منك حتى تعتفى وتنيل % 79(@)(@@) % إذا قل نفع المال أو قل ربه % % فمالك فرض في السؤال يعول % 80(@)(@@) % دعوت القلوب فاستجابت كأنما % % هواك إلى حب القلوب رسول % PageV01P2082 81(@)(@@) % وكنت بما تولى على المدح حاجرا % وكل مديح في سواك غلول % 82(@)(@@) % فلا يسر في ذا البدر نقص ولا يطر % بذا الغصن الريان منك ذبول % 83(@)(@@) % ولا تنبسط كف الزمان بنبوة % تريدك إلا رد وهو شليل % 84(@)(@@) % وزارك بالنيروز وفد سعادة % له لبث لا ينتوي وحلول % 85(@)(@@) % يكون نذيرا بالخلود بشيره % وأنك تبقى والزمان يزول % 86(@)(@@) % فلو أمهل المقدار يومك ما جرى % % مدار الدراري قلت أنت عجول % 87(@)(@@) % وجاءتك عنى كل عذراء مهرها % % خفيف بحكم الجود وهو ثقيل % 88(@)(@@) % تحن إلى أترابها في بيوتكم % % كما حن للضرع الدرور فصيل % 89(@)(@@) % لها أخوات مثلها أو فويقها % % جثوم على أعراضكم ومثول % 90(@)(@@) % حظوظهم منها سمان حسائم % وحظ رجال آخرين هزيل % PageV01P2083 91(@)(@@) % وأنصفتموها إذ ظفرتم برقها % % فمالكها منكم أخ وخليل % 92(@)(@@) % فلو أن إفصاحي بها كان لكنة % لعلمني المعروف كيف أقول % PageV01P2084 البحر : - 1(@)(@@) % جارية تعزى إلى أبيها % % ولم تلد ولم يلد أبوها % % 2(@)(@@) % إذا سبى بالحسن وجه ناظر % سبت عيونا وسبت وجوها % % 3(@)(@@) % تركب ظهر الليل منها سربة % تعد أيام الزمان فيها % % 4(@)(@@) % يتيه من يأتم في الصبح بها % % وابن الظلام لا يخاف التيها % % 5(@)(@@) % تشنا أباها كل نفس أنه % % يفنى به البأس الذي يهنيها % % PageV01P2085 البحر : - 1(@)(@@) % يا صاحبي عرجا بي ساعة % على الطلول واسألا رباها % % 2(@)(@@) % من حلها من بعدنا يوما ومن % % تبدلت من بعدنا سعداها % % 3(@)(@@) % ومن تعاطى الكأس من ريقتها % % وارتشف الأشنب من لماها % % 4(@)(@@) % ومن رعى الروض بأكناف الحمى % % واقتنص النافر من ظباها % % 5(@)(@@) % يا سرحة الوادي سقتك مزنة % تضحك قبل الدوح من بكاها % % 6(@)(@@) % ويا أثيلات النقيبأورقت % % من 
ms665	 نحوك الأفنان من جناها % % 7(@)(@@) % ويا عريصات القليبمنلوى % % نعمان فالأثيلمن جرعاها % % 8(@)(@@) % إني بكن اليوم صب مغرم % ذو لوعة ما ينقضي جواها % % 9(@)(@@) % ما ذكرت نفسي أيام الحمى % % إلا وتجفو مقلتي كراها % % 10(@)(@@) % ولا تنسمت الصبا من أرضكم % % إلا شفاني الطيب من رياها % % PageV01P2086 البحر : - 1(@)(@@) % أتراها يوم صدت أن أراها % % علمت أني من قتلى هواها % % 2(@)(@@) % أم رمت جاهلة ألحاظها % % لم تميز عمدها لي من خطاها % % 3(@)(@@) % لا ومن أرسلها مفتنة % تحرج النسك بجمعوقضاها % % 4(@)(@@) % ما رمى نفسي إلا واثق % أنه يقضي عليها من رماها % % 5(@)(@@) % سنحت بين المصلى ومنى % مسنح الظبية تستقري طلاها % % 6(@)(@@) % فجزاها الله من فتكتها % % في حريم الله سواءا ما جزاها % % 7(@)(@@) % قال واشيهاوقد راودتها % % رشفة تبرد قلبي من لماها % % 8(@)(@@) % لا تسمها فمها إن الذي % % حرم الخمرة قد حرم فاها % % 9(@)(@@) % أعطيت من كل حسن ما اشتهت % فرآها كل طرف فاشتهاها % % 10(@)(@@) % وحماها خفر في وجهها % % ووقار قبل أن تسمي أباها % % PageV01P2087 11(@)(@@) % لو خلت من أسرة في قومها % % ونفاها حسب زاك نماها % % 12(@)(@@) % غدت الشمس إذا ما أسفرت % أختها والغصن إن ماست أخاها % % 13(@)(@@) % ورأت في العين من أشباهها % % من قبيل وعديد ما كفاها % % 14(@)(@@) % كيف والدهناء غاب دونها % % وظبا سعد أسود وقناها % % 15(@)(@@) % ولو أن النجم يرتاح لها % % لحظة في غيرجمع ما اجتلاها % % 16(@)(@@) % آه مما أسأرت في كبدي % % من جوى تلك الليالي البيض آها % % 17(@)(@@) % أشتكي البين وفي صدري ندوب % من زماني داميات ما اشتكاها % % 18(@)(@@) % ويند النوم عن عيني حبيب % هاجر يرحل عنى بكراها % % 19(@)(@@) % والليالي خالسات من لحاظي % % كل مولى قربه يجلو قذاها % % 20(@)(@@) % ديمي في المحل تسري وحماتي % % يوم أسد الغاب مبذول حماها % % PageV01P2088 21(@)(@@) % والمقاري والمصابيح إذا % % دجت الليلة أو جنت ضياها % % 22(@)(@@) % وإذا الرمل غدا معتصرا % % ظمأ واصطفن الناس المياها % % 23(@)(@@) % قمت أدعوهم جدوبا وضلالا % % فيلبونى أكفا وجباها % % 24(@)(@@) % كل كف قد براها الله من % % طينة لينة يوم براها % % 25(@)(@@) % حكمها يقضي على الناس ولكن % % جودها يقضى عليها ونداها 
ms666	 % % 26(@)(@@) % كزعيم الدين لم تعرف سواه % % سبل الخير ولم يعرف سواها % % 27(@)(@@) % طلب الغاية حتى ما يراها % % للعلا سالكة إلا رقاها % % 28(@)(@@) % وأباح المجد نفسا حرة % أمر المجد عليها ونهاها % % 29(@)(@@) % فإذا غالت به طاوعها % % وإذا مالت إلى الخفض عصاها % % 30(@)(@@) % حلقت مبتدئا همته % وانتهى المجد فلم يبلغ مداها % % PageV01P2089 31(@)(@@) % كلما استوقفها في موطن % % حابس طاشت تناصي منتهاها % % 32(@)(@@) % نقل السؤدد عن آبائه % % فحواها وارثا يوم حواها % % 33(@)(@@) % واستفادت نفسه من كسبه % شرفا زاد عليها وعلاها % % 34(@)(@@) % عوذته ناشئا أسرته % بالمعالي قبل ياسين وطاها % % 35(@)(@@) % فأراها الله أقصى ما تمنت % وكفاها الخوف فيه ووقاها % % 36(@)(@@) % فهى تدعوه اضطلاعا شيخها % % وقضايا السن تدعوه فتاها % % 37(@)(@@) % ولي الدولة من تدبيره % % مسحل لم يأل فتلا في عراها % % 38(@)(@@) % حسم الأدواء طب ما رأى % % جلدة معرورة إلا كواها % % 39(@)(@@) % حاملا عن قومه أعباءها % % وهي لا تثبت جنبا لقواها % % 40(@)(@@) % فلئن خاست به أو بهم % فغدا يصلى بما شبت يداها % % PageV01P2090 41(@)(@@) % سنراها بعدكم مشلولة % يسأل الطراد عنها راعياها % % 42(@)(@@) % يستغيث النصر تصويتا بهم % % وهي لا رجع لها إلا صداها % % 43(@)(@@) % أو عسى تعطفهم عاطفة % فيغارون لها مما دهاها % % 44(@)(@@) % فيرى أن الذي أجربها % % قطعها أرسانها ممن طلاها % % 45(@)(@@) % أيها المبلغ بالغيب رسولا % % لم يجشم حاجة إلا قضاها % % 46(@)(@@) % قل متى وفقت يوما أن ترى % % عزة نخبة عيني أن تراها % % 47(@)(@@) % يا شقيق النفس كم تكحل عين % بالدياجي أنت مصباح دجاها % % 48(@)(@@) % كم يداري الصبر قلبي كارها % % قلما استمتع بالصبر كراها % % 49(@)(@@) % كنت أشكو الشوق والمسرى قريب % كيف بي والدار قد شط نواها % % 50(@)(@@) % كلما أملت يوما ينشر ال % % عقلة استوقف يوما فطواها % % PageV01P2091 51(@)(@@) % قد أتتني فتطربت لها % % فعلة منك قليل من أتاها % % 52(@)(@@) % ضاعف المنة فيها أنها % % غير محسوب سقى أرضي حياها % % 53(@)(@@) % طرقت في غير ما إبانها % % لم تجل في ظن نفسي ومناها % % 54(@)(@@) % لم تحولك الملمات على % % ضغطها من كسبها أو مقتناها % % 55(@)(@@) % والمعالي أنك استحليتها % % طعمة في سنة مر جناها % % 56(@)(@@) % والفتى 
ms667	 في عسرة أو يسرة % من رأى صفقة ربح فشراها % % 57(@)(@@) % ولكم أخرى تبرعت بها % % قبلها استثمرتها مالا وجاها % % 58(@)(@@) % فعلي الشكر ما قال فصيح % طلع القول إلى فيه ففاها % % 59(@)(@@) % بغريبات على أنس بها % % ذلل يخضع في قودي مطاها % % 60(@)(@@) % سخرت لي فأطاعت إمرتي % % بعد أن شقت على الناس عصاها % % PageV01P2092 61(@)(@@) % لم يزل بالصم من حياتها % % لطف سحري حاويا حتى رقاها % % 62(@)(@@) % يترك الآذان أسرى حولها % % فم من حدث فيها أو رواها % % 63(@)(@@) % هي في تعنيسها أو شيبها % % غضة الحسن كأيام صباها % % 64(@)(@@) % لك منها كل ما سر وأرضى % % عاطل الأعراض لو كان حلاها % % 65(@)(@@) % زاد أيام التهاني غبطة % أنها ما ضفتكم من قراها % % 66(@)(@@) % حمل النيروز منها تحفة % لا تبالي في الهدايا ما عداها % % 67(@)(@@) % وأتى موصلها عني كتاب % لو وفى شرط المنى كان شفاها % % PageV01P2093 البحر : - 1(@)(@@) % أما وهواها عذرة وتنصلا % % لقد نقل الواشي إليها فأمحلا % % 2(@)(@@) % سعى جهده لكن تجاوز حده % % وكثر فارتابت ولو شاء قللا % % 3(@)(@@) % وقال فلم تقبل ولكن تلومت % على أنه ما قال إلا لتقبلا % % 4(@)(@@) % وطارحها أني سلوت فهل رأى % % له الذم مثلي عن هوى مثلها سلا % % 5(@)(@@) % أأنفض طوعا حبها عن جوانحي % % وإن كان حبا للجوانح مثقلا % % 6(@)(@@) % أبى الله والقلب الوفي بعهده % وإلف إذاعد الهوى كان أولا % % 7(@)(@@) % أيا صاحبي نجواي يوم سويقة % أناة وإن لم تسعدا فتجملا % % 8(@)(@@) % سلا ظبية الوادي وما الظبي مثلها % % وإن كان مصقول الترائب أكحلا % % 9(@)(@@) % أأنت أمرت البدر أن يصدع الدجى % % وعلمت غصن البان أن يتميلا % % 10(@)(@@) % وحرمت يوم البين وقفة ساعة % على عاشق ظن الوداع محللا % % PageV01P2094 11(@)(@@) % جمعت عليه حرقة الدمع والجوى % % وما اجتمع الداءان إلا ليقتلا % % 12(@)(@@) % هبي لي عيني واحملي كلفة الأسى % % على القلب إن القلب أصبر للبلا % % 13(@)(@@) % أراك بوجه الشمس والبعد بيننا % % فأقنع تشبيها بها وتمثلا % % 14(@)(@@) % وأذكر عذبا من رضابك مسكرا % % فما أشرب الصهباء إلا تعللا % % 15(@)(@@) % هنيئا لحب المالكية إنه % % رخيص له ما عز منى وما غلا % % 16(@)(@@) % تعلقتها 
ms668	 غرا وليدا وناشئا % % وشبت وناشي حبها ما تكهلا % % 17(@)(@@) % ووحدها في الحب قلبي فما له % % وإن وجد الأبدال أن يتبدلا % % 18(@)(@@) % رعى الله قلبي ما أبر بمن جفا % % وأصبره في النائبات وأحملا % % 19(@)(@@) % وكرم عهدي للصديق فإنه % % قليل على الحالات أن يتحولا % % 20(@)(@@) % ولين أيامي علي فإنني % % أزاحم ثهلانا عليه ويذبلا % % PageV01P2095 21(@)(@@) % وأهل زمان لا هوادة بينهم % % إذا استؤمنوا كانوا أخب وأختلا % % 22(@)(@@) % صديق نفاق أو عدو فضيلة % متى طب عاد الداء أدهى وأعضلا % % 23(@)(@@) % ولوج على الشر الذي يرصدونه % % متى وجدوا يوما إلى الشر مدخلا % % 24(@)(@@) % إذا ما رأوا عند امرئ زاد يومه % مشوا حسدا أو بات جوعان مرملا % % 25(@)(@@) % وفي الأرض عنهم مذهب وتفسح % فمن لي لو أسطيع أن أترحلا % % 26(@)(@@) % أهم ولكن من ورائي جواذب % أخاف على أعطانها أن تشللا % % 27(@)(@@) % وتعلقني الآمال في قلل العلا % % فأجعلها منهم ملاذا ومعقلا % % 28(@)(@@) % نعم عند ركن الدين وابن قوامه % % غنى ومراد أن أضام وأهملا % % 29(@)(@@) % وفي يده البيضاء يقطر ماؤها % % ربيع يرد الجدب أخضر مبقلا % % 30(@)(@@) % وبالقصر من دار السلام متوج % بإشراقه أخزى البدور وأخجلا % % PageV01P2096 31(@)(@@) % ترى خرزات الملك فوق جبينه % % كواكب نور ضوءها يملأ الفلا % % 32(@)(@@) % يميت النفوس قاطبا متنمرا % % ويحيى أوانا باسما متهللا % % 33(@)(@@) % إذا كفروا النعماء شام سيوفه % % وإن سألوا الإغضاء سام التفضلا % % 34(@)(@@) % قريب إلى المولى بعيد بعزه % % على مغمز الأعداء أن يتسهلا % % 35(@)(@@) % إذا من أعطى حلمه متبينا % % وإن هم أعطى أمره متعجلا % % 36(@)(@@) % حوى حوزة الدنيا فدبر أمرها % % مليا بتقويم الأمور معدلا % % 37(@)(@@) % أطاعته أعناق البلاد وأقبلت % إليه القلوب رغبة لا تعملا % % 38(@)(@@) % ودانت له الأقدار حتى تصرفت % على أمره الماضي صعودا ونزلا % % 39(@)(@@) % إذا طلب الأعداء أنفذ جحفلا % % لهاما من الإقبال يتبع جحفلا % % 40(@)(@@) % كفاه مكان السيف والرمح جده % فلو شاء يوم الروع حارب أعزلا % % PageV01P2097 41(@)(@@) % وكم عادة لله في النصر عنده % % تضمن باستمرارها وتكفلا % % 42(@)(@@) % ومن آية قامت بتثبيت ملكه % % وقد كادت الأقدام أن تتزيلا % % 43(@)(@@) % ظهرت جلال الدولتين بفضلها % % ومعجزها 
ms669	 حتى ظنناك مرسلا % % 44(@)(@@) % رأى الله أن الأرض أصلح سيرة % عليك وان الناس أجمل محفلا % % 45(@)(@@) % وأنك تأوي في أمورك كلها % % إليه منيبا نحوه متبتلا % % 46(@)(@@) % فولاك في ضيق الشدائد فرجة % وأعطاك منجى في الخطوب وموئلا % % 47(@)(@@) % وكم آبق من رق ملكك غامط % لنعماك لم ينهض بما قد تحملا % % 48(@)(@@) % عفوت مرارا عن تمادي ذنوبه % % فأنظرته بالعفو حتى توغلا % % 49(@)(@@) % وبالأمس لجوا في الشقاق وأجلبوا % % عليك وظنوها وحاشاك فيصلا % % 50(@)(@@) % فلم يجن ضعف الرأى إلا عليهم % ولا ازددت إلا قوة وتأثلا % % PageV01P2098 51(@)(@@) % فسائل بهم إما طريدا مشردا % % يلوذ بصفح أو قتيلا مجدلا % % 52(@)(@@) % فلا زال من عاداك أبعد شقة % وأخبث أياما وأخشن منزلا % % 53(@)(@@) % ولا زالت الرايات واسمك حليها % % خوافق تحوى الأرض سهلا وأجبلا % % 54(@)(@@) % إلى أن ترى بيض الملوك وسودها % % قياما على أخرى بساطك مثلا % % 55(@)(@@) % وبلغت في نجميك يا بدر كل ما % % تؤمل في نجم على أفق علا % % 56(@)(@@) % قديمها والطالع الآن قابسا % % ضياءك حتى يستقيم ويكملا % % 57(@)(@@) % فكانا على الأعداء سيفى تناصر % شبيهك فيما أحدثا وتقيلا % % 58(@)(@@) % وشداك والضرغام أمنع جانبا % % وأنهض إقداما إذا كان مشبلا % % 59(@)(@@) % وكثرت بالأولاد ترهف منصلا % % طريرا إلى الدنيا وتطبع منصلا % % 60(@)(@@) % فإنك من قوم ثوى الملك فيهم % فلم ينو من بعد الحلول ترحلا % % PageV01P2099 61(@)(@@) % أصولهم منصورة بفروعهم % % إذا قام منهم آخر كان أولا % % 62(@)(@@) % لكم في رقاب الناس أمراس ذمة % بعيد على استحصافها أن تحللا % % 63(@)(@@) % مفاتيح هذا الرزق بين أكفهم % % ونصرة دين الله بيضا وذبلا % % 64(@)(@@) % فما يشهدون الحرب إلا إذا غلت % ولا يشترون الحمد إلا إذا غلا % % 65(@)(@@) % أتعرف يا مولى الملوك كقصة % بليت بها الأمس والحر يبتلى % % 66(@)(@@) % أبعد قنوعي بالثماد تعففا % % وهجري أبواب الملوك تعزلا % % 67(@)(@@) % وظلمي فضلي واهتضامي توحدي % % مخافة أن أوذى وأن أتبذلا % % 68(@)(@@) % يسيئ رعاع الناس عندك سمعتي % % ويشعر أني حزت مالا مؤثلا % % 69(@)(@@) % ويغرى بإفقارى وأنت الذي ترى % % لمثلي أن يغنى وأن يتمولا % % 70(@)(@@) % ولكنها ما غيرت لك شيمة % كرمت بها إلا قليلا 
ms670	 كلا ولا % % PageV01P2100 71(@)(@@) % ولما سعى الساعي فجاءك كاذبا % % علي بجور كنت أعلى وأعدلا % % 72(@)(@@) % أتاك بزور فاتحا فمه به % % فألقمته بالرد تربا وجندلا % % 73(@)(@@) % تسرع فيها جالبا لك إثمها % % ولكن أراك الحق أن تتمهلا % % 74(@)(@@) % فلم تألني كشفا لصدق براءتي % % ولا نظرا في قصتي وتأملا % % 75(@)(@@) % وزنت بذكر المال مجدك في العلا % % فكان وزان المجد عندك أثقلا % % 76(@)(@@) % وحكمت رأيا طاهرياوهمة % بويهية ما طبقت كان مفصلا % % 77(@)(@@) % فأرضاك منى الصدق لما علمته % % ببينة لم أستعرها تقولا % % 78(@)(@@) % فإن فاجأتني همة من طروقها % % تروع منها جانبي وتوجلا % % 79(@)(@@) % حبست ولكن كان حبسا مشرفا % % أناف بذكرى واعتقالا مجملا % % 80(@)(@@) % ولم أر مثلي مستضاما مكرما % % ولا كاسبا للعز من حيث ذللا % % PageV01P2101 81(@)(@@) % لئن عد قوم نكبة حبس ليلة % لقد كنت منكوبا من الناس مقبلا % % 82(@)(@@) % وسبب لي هذا المقام تروعي % % وقد كنت عنه ساهيا أو مغفلا % % 83(@)(@@) % مكان تمناه الكواكب عزة % فتبغى إليه مهبطا وتنزلا % % 84(@)(@@) % ومن لجبين الشمس لو خر ساجدا % % لأرضك أو وافى ثراك مقبلا % % 85(@)(@@) % لبست به ثوبا ضفا لي فخره % بمدحك مجرورا علي مذيلا % % 86(@)(@@) % سيعلم من جر السعاية أنه % % بكرهي إلى ما ساق نفعي توصلا % % 87(@)(@@) % لقد غرس التعريض بي في وبيئة % متى استثمرت أجنته صابا وحنظلا % % 88(@)(@@) % إذا وسمت عرض اللئيم بميسم % من الذم باق ود لو كان أغفلا % % 89(@)(@@) % فكان شقيا خاب عندك سعيه % وفزت وكنت المنعم المتفضلا % % 90(@)(@@) % أقم في من عادات سيبك سنة % هي الغيث أو كانت أعم وأجزلا % % PageV01P2102 91(@)(@@) % فكم من نوال مسرف قد حقرته % % وفللت من جماعه فتفللا % % 92(@)(@@) % وعارفة لو يسأل البحر بعضها % % تعذر في إخراجها وتمحلا % % 93(@)(@@) % فمر في بالمعروف من سيب راحة % معودة أن تستهل وتهطلا % % 94(@)(@@) % وكن مرغما خصمى بأمر مشرف % توفر لي منه الضمان المعجلا % % 95(@)(@@) % وتجبر من جاهى الكسير وخلتي % % فأجدر من أسمنت من كنت مهزلا % % 96(@)(@@) % وثق بجزاء شعر عبدك ضامن % لما طاب منه في الشفاه وما حلا % % 97(@)(@@) % من الباقيات الصالحات أروضها % % بنفسي إذا 
ms671	 طابت وقلبي إذا خلا % % 98(@)(@@) % سوائر يقطعن البلاد حواملا % % دعاء مجابا أو ثناء منخلا % % 99(@)(@@) % إذا ما كسوت العيد منهن لبسة % ترفل فيها تائها وتخيلا % % 100(@)(@@) % ومد يد الراجي نوالك مدليا % بحرمتها مستشفعا متوسلا % % PageV01P2103 101(@)(@@) % يبشر عنها أنه عائد بها % % عليك مدى الأيام عمرا مطولا % % 102(@)(@@) % هو اليوم أعطاه الإله فضيلة % كما كنت ممن يحمل الأمر أفضلا % % 103(@)(@@) % فقابل به وجه الخلود مبلغا % % شروط المنى ما كر عيد وأقبلا % % 104(@)(@@) % وكن مفطرا بالبر والبس على التقى % % ثوابك وانزع صومك المتقبلا % % 105(@)(@@) % تزخرف جنات العلا لك مفطرا % % وصائم فرص كنت أو متنفلا % % 106(@)(@@) % إلى أن ترى صم الجبال فلائقا % % مسيرة والجو ماء مسلسلا % % 107(@)(@@) % إذا ما انجلى صبح ولست مملكا % % علينا فلا انشق الظلام ولا انجلى % % PageV01P2104 البحر : - 1(@)(@@) % لعل الركب أن خلصوا نجيا % % يرون الحزم أن يقفوا المطيا % % 2(@)(@@) % فإن على المشارف من رسيس % هوى يستنظر السير الوحيا % % 3(@)(@@) % بلهنية من الدنيا وظل % وروض أرضه يصف السميا % % 4(@)(@@) % وسارحة تعجج عن أداوى % % مواقر عفوها يسع العشيا % % 5(@)(@@) % وكالظبيات أعطافا عطاشا % % إذا ضمت وأردافا وريا % % 6(@)(@@) % يناضلن القلوب بصائبات % % يرقن وإن قتلن بها الرميا % % 7(@)(@@) % مكايد إن نجا غلطا عليها % % سقيم هوى أخذن به البريا % % 8(@)(@@) % أطور بهن أستجدي ضنينا % % وأستعدي على شجوى خليا % % 9(@)(@@) % فيا بأبي وعز أبي فداء % % لغيري الحب يبذل أو إليا % % 10(@)(@@) % نواعم من وجوه بينجمع % % إلى البطحاء رحت بها شقيا % % PageV01P2105 11(@)(@@) % وشماء الغدائر من سليم % يعلم عدل قامتها القنيا % % 12(@)(@@) % تناصع عقدها الشفاف عنق % لها وقصاء تنتهب الحليا % % 13(@)(@@) % توحش يوم تطلب سامريا % وتأنس يوم تجلب بابليا % % 14(@)(@@) % إذا استرشفت أنقع شربتيها % % سقنك مصردا وحمتك ريا % % 15(@)(@@) % تعد الشيب نعتا من ذنوبي % % فردي الوصل أو عدي سنيا % % 16(@)(@@) % وعاب العاذلون بها جنوني % % أهان الله أعقل عاذليا % % 17(@)(@@) % وهبت لخرقها في الحب حلمي % % فمرت بي رشيدا أو غويا % % 18(@)(@@) % ولم أك في العكوف على هواها % % بأول محسن يهوى مسيا % % 19(@)(@@) % ألا يا صاحبيالنهضان إني % % أحبك لا الجثوم ولا 
ms672	 العييا % % 20(@)(@@) % خليلي أنت ما طالعت عزمي % % وسرا في المطالب لي خفيا % % PageV01P2106 21(@)(@@) % عذيري منك تزعمني أميرا % % عليك وتنتحيني خارجيا % % 22(@)(@@) % تنفلنى البلية والرذايا % % وتغتصب النشائط والصفيا % % 23(@)(@@) % فلا أرينك تسأل بي قريبا % % وتسأل إن نأيتك بي حفيا % % 24(@)(@@) % وكايلني بغير يدى زماني % % فلم أعرف له صاعا سويا % % 25(@)(@@) % أخو وجهين تخبره وقاحا % % وتبصره بظاهره حييا % % 26(@)(@@) % وهوبا سالبا وأخا عدوا % % بفطرته ومنقادا أبيا % % 27(@)(@@) % فطنت لخلقه فزهدت فيه % % وبعض القوم يحسبني غبيا % % 28(@)(@@) % لحا الله العراق وزهرتيها % % حمى يسترعف الأنف الحميا % % 29(@)(@@) % بلاد ما اشتهت خصبا ولكن % % يكون على العدى مرعى وبيا % % 30(@)(@@) % مونثة الثرى والماء يعدي % % بحسن طباعها القدر الجريا % % PageV01P2107 31(@)(@@) % أرى إبلي على الخيرات فيها % % تلس الترب تحسبه النصيا % % 32(@)(@@) % منخسة على الأعطان طردا % % ولا جربي طردن ولا سبيا % % 33(@)(@@) % إذا ورد الغرائب أقحمتها % % على الإقراب خيفتها العصيا % % 34(@)(@@) % حماها الورد كل بخيل قوم % يكون بعرضه فيها سخيا % % 35(@)(@@) % إذا نسب الفضائل من أبيه % % ومنه نزعن عنه أجنبيا % % 36(@)(@@) % أقوم وصاحبي فأثير عنه % % بواركها البوازل والثنيا % % 37(@)(@@) % فما ندري أثرناها مطايا % % نواحل أو بريناها قسيا % % 38(@)(@@) % فحنت أو فقطعها صداها % % صباح الذل إن شربت مريا % % 39(@)(@@) % ولا حملت بلاد لم تلقني % % وإياها العهاد ولا الوليا % % 40(@)(@@) % دعوت لها العريب ورهط كسرى % % فلا القربى حمدت ولا القصيا % % PageV01P2108 41(@)(@@) % ونامت نصرة الأنباط عنها % % فنبهت الغلام القيصريا % % 42(@)(@@) % فهب فقام يلقى الضيم عنها % % كريم العود أروع شمريا % % 43(@)(@@) % يعارض دونها فيسد عنها % % طريق البغى أرقم عالجيا % % 44(@)(@@) % أصم إذا رقوه عن وداد % % عصى الحاوين والتقط الرقيا % % 45(@)(@@) % لقد راودت ناشزة الأماني % % على رجل تكون له هديا % % 46(@)(@@) % تقر لديه ساكنة حشاها % % وتألف عنده الأمر العصيا % % 47(@)(@@) % ورضت صعابها لجما وخزما % % مطيع الرأس فيها والعصيا % % 48(@)(@@) % فما اختارت سوى المختار خدنا % كفيلا في الصعاب لها كفيا % % 49(@)(@@) % أهبت به فلم أهزز كهاما % % إلى غرضي ولم أزجر بطيا % % 50(@)(@@) % وكان أخي وقد عرضت هنات % وفى فيها وليس أخي وفيا % % PageV01P2109 51(@)(@@) % وقام بنصر 
ms673	 حسن الظن فيه % % مقاما يزلق البطل الكميا % % 52(@)(@@) % حظيت به أثيث النبت كهلا % % بآية يوم أعرفه فتيا % % 53(@)(@@) % وكنت ذخرته لصباح يوم % فقير أن أكون به غنيا % % 54(@)(@@) % فما كذبت تباشير ارتيادي % % به قدما ولا كانت فريا % % 55(@)(@@) % كأني إذ بعثت وراء حاجي % % به أطررت نصلا فارسيا % % 56(@)(@@) % رعى سلف المودة لم يخنها % % ولم يك مع تقادمها نسيا % % 57(@)(@@) % وبات يضمها من جانبيها % % وذئب الغدر يرصدها ضريا % % 58(@)(@@) % وقد عاد الوفاء يعد عجزا % % وذكر العهد دينا جاهليا % % 59(@)(@@) % وجاهد أعزلا وقضى ديونا % % يماطلني الزمان بها مليا % % 60(@)(@@) % أبا الحسن انبلجت بها شهابا % % على ظلمات إخواني مضيا % % PageV01P2110 61(@)(@@) % خبرتهم فكنت بهم قليلا % % وهم كثر فكنت بك الثريا % % 62(@)(@@) % هم نسلوا الخوافي والقدامى % % فطرت بها أزيرق مضرحيا % % 63(@)(@@) % حططت عليك أوساقى وظهري % % بهن موقع عرا وعيا % % 64(@)(@@) % فكنت العود لا متنا شديدا % % عزمت به ولا قلبا جريا % % 65(@)(@@) % كأن مآربي بسواك تبغي % % ولاء القيظ يختبط الركيا % % 66(@)(@@) % فلا زالت بك الدنيا تريني % % طريق إصابتي وضحا جليا % % 67(@)(@@) % وتقسم من بقائك لي زماني % % على نقصانه الحظ السنيا % % 68(@)(@@) % متى تتعنس الدنيا عجوزا % % موقصة وتتركه صبيا % % 69(@)(@@) % وطارت طائرات رضاي تسري % % بوصفك رائحات أو غديا % % 70(@)(@@) % حبائر يحسب اليمني منها % % يذارعك الرداء العبقريا % % PageV01P2111 71(@)(@@) % تسد مطالع البيضا علوا % وتنفذ تحت مغربها هويا % % 72(@)(@@) % يحدث حاضرا عنهن باد % ويطرب مشرقي مغربيا % % 73(@)(@@) % صوادر عن موارد صافيات % أبحتك حوضها فاشرب هنيا % % 74(@)(@@) % لأقضي فيك حق الشكر شيئا % كما قضيت حق الود فيا % % PageV01P2112 البحر : - 1(@)(@@) % دل على عز والديه % واشتد مع لين جانبيه % 2(@)(@@) % زاد هوانا لدي لما % % أن قضيت حاجتي لديه % 3(@)(@@) % يقطع في طرفه فيجزى % % سوءا وما القطع في يديه % PageV01P2113 البحر : - 1(@)(@@) % لو كنت دانيت المودة قاصيا % % رد الحبائب يوم بن فؤاديا % % 2(@)(@@) % علمنني غدر الهوى وتركنني % % أتخيل العنقاء خلا وافيا % % 3(@)(@@) % أعطين بعد النوبهار خليطهم % % حتى لقين به سهيل يمانيا % % 4(@)(@@) % وسبقن طيتها الشمال كأنما % % خلفنها خلف الأيانق حاديا % % 5(@)(@@) % وطلعن في ليل يضل 
ms674	 وسكرة ال % % تفريق توهمينه نورا هاديا % % 6(@)(@@) % وعددن أيام الشباب كواملا % % ونظرن آرام الصريم جواريا % % 7(@)(@@) % وثنين أجيادا ترينك أنه % % من أجلها تسمى النساء غوانيا % % 8(@)(@@) % متكلمات بالأنامل أبرز ال % % جادي عاطلها لعينك حاليا % % 9(@)(@@) % من كل مفهمة ولم تنطق ولم % % أنصت ولكن كنت عنها واعيا % % 10(@)(@@) % عنهن صن نفسا فأكرم عاشق % من عز مقتربا وأسمح نائيا % % PageV01P2114 11(@)(@@) % واحذر مداجاة العذول فربما % % أشعرته جلدا فظنك ساليا % % 12(@)(@@) % بيني وبين الصبر أني ذاكر % % أيام كان الهم قلبي ناسيا % % 13(@)(@@) % أدمي بسني أخريات أناملي % % نظرا إلى زمن طرحت ورائيا % % 14(@)(@@) % ومحاسن آلت مقابح عيشتي % % ألا ترد بهن أمس الماضيا % % 15(@)(@@) % كن الخيال وفى لعيني ليله % عرضا فنمت له فخان لياليا % % 16(@)(@@) % وعلى للرفقاء في طلب العلا % % والجاعلين لها الخطار مراقيا % % 17(@)(@@) % نفس مذللة لما عزت به % % تغذى شميم الريح زادا كافيا % % 18(@)(@@) % ومهند لو رمت ماء فرنده % % تحت الهجيرة ظامئا لسقانيا % % 19(@)(@@) % ومعودات طي كل تنوفة % ما سار فيها البرق إلا كابيا % % 20(@)(@@) % متعرفات بالدماء كأنما % % ضفرن من عذب الرماح نواصيا % % PageV01P2115 21(@)(@@) % وبحي آل محمد إطراؤه % % مدحا وميتهم رضاه مراثيا % % 22(@)(@@) % هذا لهم والقوم لا قومي هم % جنسا وعقر ديارهم لا داريا % % 23(@)(@@) % إلا المحبة فالكريم بطبعه % % يجد الكرام الأبعدين أدانيا % % 24(@)(@@) % يا طالبييناشتفى من دائه ال % % مجد الذي عدم الدواء الشافيا % % 25(@)(@@) % بالضاربين قابهم عرض الفلا % % عقل الركائب ذاهبا أو جائيا % % 26(@)(@@) % شرعوا المحجة للرشاد وأرخصوا % % ما كان من ثمن البصائر غاليا % % 27(@)(@@) % وأما وسيدهم علي قولة % تشجي العدو وتبهج المتواليا % % 28(@)(@@) % لقد ابتنى شرفا لهم لو رامه % % زحل بباع كان عنه عاليا % % 29(@)(@@) % وأفادهم رق الأنام بوقفة % في الروع بات بها عليهم واليا % % 30(@)(@@) % ما استدرك الإنكار منهم ساخط % % إلا وكان بها هنالك راضيا % % PageV01P2116 31(@)(@@) % أضحوا أصادقه فلما سادهم % % حسدوا فأمسوا نادمين أعاديا % % 32(@)(@@) % فارحم عدوك ما أفادك ظاهرا % % نصحا وعالج فيك خلا خافيا % % 33(@)(@@) % وهب الغدير أبوا عليه قبوله % % نهيا فقل عدوا سواه مساعيا % % 34(@)(@@) % بدرا وأحداأختها من بعدها 
ms675	 % % وحنينوقارا بهن فصاليا % % 35(@)(@@) % والصخرة الصماء أخفى تحتها % % ماء وغير يديه لم يك ساقيا % % 36(@)(@@) % وتدبروا خبر اليهود بخيبر % وارضوا بمرحب وهو خصيم قاضيا % % 37(@)(@@) % هل كان ذاك الحصن يرهب هادما % % أو كان ذاك الباب يفرق داحيا % % 38(@)(@@) % وتفكروا في أمر عمروأولا % % وتفكروا في أمر عمرو ثانيا % % 39(@)(@@) % أسدان كانا من فرائس سيفه % % ولقلما هابا سواه مدانيا % % 40(@)(@@) % ورجالضبة عاقد حجزاتهم % % يومالبصيرة منمعين تفانيا % % PageV01P2117 41(@)(@@) % ضغموا بناب واحد ولطالما از % % دردوا أراقم قبلها وأفاعيا % % 42(@)(@@) % ولخطب صفين أجل وعندك ال % % خبر اليقين إذا سألت معاويا % % 43(@)(@@) % لم يعتصم بالمكر إلا عالما % % أن ليس إن صدق الكريهة ناجيا % % 44(@)(@@) % خلع الأمانة فارتدى بمعرة % وسمت جباه التابعين مخازيا % % 45(@)(@@) % وأحق بالتمييز عند محمد % من كان سامى منكبيه راقيا % % 46(@)(@@) % وأبرهم من كان عنه موقيا % % حوباءه فوق الفراش وفاديا % % 47(@)(@@) % قسما لقد عظم المصاب لأنه % % أضحى الإمام عن الأئمة ثاويا % % 48(@)(@@) % وبنفسي القمران غابا بعده % % هذاك مسموما وهذا صاديا % % 49(@)(@@) % ما إن لقوا إلا غلاظة محقد % منهم وقلبا بالضغائن قاسيا % % 50(@)(@@) % أصل التحية بالقريب مزاره % منهم وأبعثها تزور القاصيا % % PageV01P2118 51(@)(@@) % وأجلهم عن أن أقول سقاهم % غيث تجلل حيث حلوا كافيا % % 52(@)(@@) % هل يبلغنك يا أبا الحسن الذي % % جوزيت فيك وكا ضد جزائيا % % 53(@)(@@) % من معشر لما مدحتك غظتهم % % فتناوشوا عرضى وشانوا شانيا % % 54(@)(@@) % اسمع لينصفني انتقامك إنهم % % بالجور راضوني فجئتكشاكيا % % 55(@)(@@) % لما رأوا ما غاظ منى شنعوا % % حاشاك أني قلت فيك مداجيا % % 56(@)(@@) % لا كان إلا ميتا ميثاقه % من سره أن كان بعدك باقيا % % 57(@)(@@) % والله ينصب لعنه وعذابه % من قال فيك ومن يقول مرائيا % % 58(@)(@@) % والحق لم أطلب بمدحك شكرهم % % فيسوءني أن يجعلوه مرائيا % % 59(@)(@@) % بالقرب منك يهون عندي منهم % من كان برا بي فأصبح جافيا % % 60(@)(@@) % وبرغمهم لأسيرنها شردا % % لأتبعن منها بديئا تاليا % % PageV01P2119 61(@)(@@) % غرا أقد من الجبال معانيا % % فيها وألتقط النجوم قوافيا % % 62(@)(@@) % شكرا لصنعك عند فارس أسرتي % % وبما سلمت تفاؤلا وأياديا % % 63(@)(@@) % وتعصبا ومودة لك صيرا % % في حبك الشيعي 
ms676	 من إخوانيا % % PageV01P2120 البحر : - 1(@)(@@) % قم فانتشطها حسبها أن تعقلا % % ودع لها أيديها والأرجلا % % 2(@)(@@) % وارم بها عرض الفلا فإنها % % ما خلقت إلا رجوما للفلا % % 3(@)(@@) % ولا تحرج أن ترى شعارها % % حصت ولا البدن منها نحلا % 4(@)(@@) % فإن ما تنفض من أوبارها % % أثمان ما تنفض من طرق العلا % % 5(@)(@@) % لا يطرح الذل وراء ظهرها % % إلا فتى ينضي المطايا الذللا % % 6(@)(@@) % كم للظما توعد بالماء وكم % % ترعى الطوى وكم تمنى بالكلا % % 7(@)(@@) % على ثرى لا ينبت العز ولا % % يكون للحر الكريم منزلا % % 8(@)(@@) % خير من امتناعها وضمها % % في الهون أن تطرد أو تشللا % 9(@)(@@) % ما بابل بوطن لعازف % يأنف أن يضام أو يبتذلا % % 10(@)(@@) % دار يكون الناقص الخطو بها % % والصوت من كان الأتم الأكملا % % PageV01P2121 11(@)(@@) % كأنا أقسم خبث طينها % % لا يحمل الإنصاف فيما حملا % % 12(@)(@@) % وإن أرتك شارة طريرة % ترضى بها العين ووجها هلهلا % % 13(@)(@@) % فغر على المجد وواصل غيرها % % أخرى تليق الفضل والتفضلا % % 14(@)(@@) % ولا تكن إلا أخا صريمة % متى نبت دار به تحولا % % 15(@)(@@) % رم العلا بين بيوت أهلها % % مقلبا في طرقها مقلقلا % % 16(@)(@@) % فقلما يعدم نجح حاجة % من يقتني الخيل لها والإبلا % % 17(@)(@@) % كم راودت بين بيوت أهلها % % عن ريها فما سقوها بللا % % 18(@)(@@) % وفي بني الأصفر أوتار لها % % نام ولي ثأرها وغفلا % % 19(@)(@@) % و بالعراق عرب أصفتهم % مسلفة ثناءها المنخلا % % 20(@)(@@) % فما قروها والقرى ميسر % إلا المنى مكذوبة والأملا % % PageV01P2122 21(@)(@@) % لم يوقدوا نارا لها تؤنسها % % بهم ولم يرعوا إليها جملا % % 22(@)(@@) % لكن لها بالشرق من إخوتهم % % حي قرى أضيافهم حي هلا % % 23(@)(@@) % وجمرة من أسد ذاكية % تهدي على البعد الضيوف الضللا % % 24(@)(@@) % حي وقرب من عفيف أوجها % % أسرة الأقمار منها تجتلى % % 25(@)(@@) % وفاخر المجد بأيد سبطة % لهم تجود والحيا قد بخلا % % 26(@)(@@) % أمل إلى واديهم وادي الندى % % أعناقها ترع الخصيب المبقلا % % 27(@)(@@) % ترى الرياض والحياض فعمة % تكرع علا ما اشتهت ونهلا % % 28(@)(@@) % ادع إلى النصر الحسام المنتضى % % واسأل عن الغيث الغمام المسبلا % % 29(@)(@@) % واجل دجاها بفتى خزيمة % % ما 
ms677	 صدع البرق الغمام فانجلى % % 30(@)(@@) % وافتح بمجد الدين إن مد لها % % يمينه باب السماح المقفلا % % PageV01P2123 31(@)(@@) % بالعربي نسبا وكرما % % والفارسي سيرة ومنزلا % % 32(@)(@@) % وقل لأبناء دبيس ما طما % % بالشرق واديها وما تأثلا % % 33(@)(@@) % فخرا ومجدا بفتى جذع غدا % % من سركم ساد القروم البزلا % % 34(@)(@@) % شدوا الحبى بابن الحسين وانتدوا % % فوازنوا كل فخار ثقلا % % 35(@)(@@) % وكاثروا كواكب الأفق به % % مباهلين واستقلوا الأصلا % % 36(@)(@@) % إن كنتم من مضر لبابها ال % % محض وصافى طينها المصلصلا % % 37(@)(@@) % والأسد فيها نجدة وأنفسا % % إن ركبت أو دعيت لتنزلا % % 38(@)(@@) % فمن شهاب الدولة اليوم لكم % % آخر مجد فاق ذاك الأولا % % 39(@)(@@) % قدمه الله على علم به % % والله من فضل كان الأفضلا % % 40(@)(@@) % أمره بحقه عليكم % أسخط أو أرضاكم ما فعلا % % PageV01P2124 41(@)(@@) % فإن تطيعوا تجتنوها نحلة % بيضاء طاب مجتناها وحلا % % 42(@)(@@) % وإن تميلوا حيدا عن أمره % % وحسدا فانتقفوها حنظلا % % 43(@)(@@) % أولا فسدوا ثم ثغرا سده % % واحتملوا من مغرم ما احتملا % % 44(@)(@@) % من لكم بني أبيه من لكم % لولاه يبنى ما ابتنى من العلا % % 45(@)(@@) % ومن لكم يغدو بها مغيرة % تحسب في باقي الظلام شعلا % % 46(@)(@@) % نوازيا نزو الدبى مطلعة % على الأعادي أجلا فأجلا % % 47(@)(@@) % يقدمها منكم همام غابة % يعلم الطعن الأشل الأعزلا % % 48(@)(@@) % إذا حمى ليث الشرى عرينه % % حمى بها الملك وأحيا الدولا % % 49(@)(@@) % ومن سواه مشبع أضيافه % % غلبة من حيث يروى الأسلا % % 50(@)(@@) % وآخذ بيده وسيفه % % نفائسا يسلبها ما نولا % % PageV01P2125 51(@)(@@) % وأين أبياتكم من بيته % % إن طلب الوفد العماد الأطولا % % 52(@)(@@) % تخمد أولى الليل نيرانكم % % والشمس مع نيرانه كلا ولا % % 53(@)(@@) % وتحبطون وإماء بيته % % يقذفن فوق الجمرات المندلا % % 54(@)(@@) % ومن قرى أضيافه أن تنحر ال % % بدور حين تنحرون الإبلا % % 55(@)(@@) % كذاك ما فاض فصارت معه % % بحاركم فخائضا ووشلا % % 56(@)(@@) % أعطاكم فجار في أمواله % % وقام فيكم حاكما فعدلا % % 57(@)(@@) % فسلموا الإقرار بالفضل لمن % % راهن في السبق ففات المقلا % % 58(@)(@@) % واتبعوا لواءه فإنما ال % % مقبل منكم من أطاع المقبلا % % 59(@)(@@) % فخير من قادكم من لو سرى % % بنفسه كان الخميس 
ms678	 الجحفلا % % 60(@)(@@) % العلم المنصور منصوب لكم % % فاجتنبوا المنكوس والمخذلا % % PageV01P2126 61(@)(@@) % من موصل على النوى ألوكة % يفصحها مؤديا ومرسلا % % 62(@)(@@) % يبلغ عنى حملت ناجية % % ما ضم في عيابه وحملا % % 63(@)(@@) % إذا الفجاج صعبت تذكر ال % % فوز الذي يدركه فاستسهلا % % 64(@)(@@) % يمم أمير الأمراء جانبا % بجانب الأهواز تلك الحللا % % 65(@)(@@) % فحي عنهم وجهه المقبول بال % % جهد وصافح كفه المقبلا % % 66(@)(@@) % وقل له تحدثت فشوقت % عنك الرواة مطلقا ومرسلا % % 67(@)(@@) % تحدثوا أن يديك مزنة % تستضحك العام القطوب الممحلا % % 68(@)(@@) % وأنك المرء تقر عينه % % بفقره لسائل تمولا % % 69(@)(@@) % تعطى حياء مطرقا ملثما % % وقد وهبت مسنيا ومجزلا % % 70(@)(@@) % ويسفر الناس على بخلهم % % لأنهم لا يعرفون الخجلا % % PageV01P2127 71(@)(@@) % وأن أخلاقك ماء نطفة % رقت لها الريح صبا وشملا % % 72(@)(@@) % فلو سكبت خلقك المطرب في ال % % كاسات ما غادرت إلا ثملا % % 73(@)(@@) % وقيل إن الليث لا يحمي كما % % تحمي البلاد غابه والأشبلا % % 74(@)(@@) % لو حرص الموت على إيغاله % % يطلب من تمنعه ما وصلا % % 75(@)(@@) % يزور عن سرحك سرحان الغضا % % فما يشم الترب إلا وجلا % % 76(@)(@@) % وأن ملك الديلمي روضة % لولاك كانت بالسيوف تختلى % % 77(@)(@@) % أطمعته وفارس سريره % أرض العراق عنوة والجبلا % % 78(@)(@@) % سماك إذ نصرته نصيره % % ويده وسيفه قد خذلا % % 79(@)(@@) % يهزمنك صعدة خطارة % على العدا وينتضيك منصلا % % 80(@)(@@) % محاسن تواترت أخبارها % % وعدل الناقل فيما نقلا % % PageV01P2128 81(@)(@@) % فطبقت سائرة أوصافها % % في الأرض حتى ملأت عرض الفلا % % 82(@)(@@) % فهزني نحوك قلب لم يزل % بالأكرمين كلفا موكلا % % 83(@)(@@) % تيمه أهل العلا لكنهم % % حاشاك قد ماتوا معا وقد سلا % % 84(@)(@@) % وكانت الفوزة في زيارة % تشفي الغليل وتسد الخللا % % 85(@)(@@) % فمن بها لو سمح الدهر بها % % ودينه في مثلها أن يبخلا % % 86(@)(@@) % أرى مطارا وجناحى ناقص % فكيف لي نحوكم أن أصلا % % 87(@)(@@) % وما الفؤاد خانني لكنها % % حوادث عاقت وجسم نكلا % % 88(@)(@@) % فقدتها نواهضا خفائفا % تطوي الطريق محزنا ومسهلا % % 89(@)(@@) % ناطقة في الصحف عن آياتها % % على البعاد صامتات قولا % % 90(@)(@@) % غرائبا أبعث منها معجزا % % كأنني بعثت فيها مرسلا % % PageV01P2129 91(@)(@@) % مطبقات مفصلا فمفصلا % % وناطقات 
ms679	 فيصلا ففيصلا % % 92(@)(@@) % من كل بيت لو دعا بسحره % % أم النجوم طامنت أن تنزلا % % 93(@)(@@) % إن دار دار فلكا أو حل حل % جبلا أو سار سار مثلا % % 94(@)(@@) % ود الملوك نازحا ودانيا % % فقره جد بها أو هزلا % % 95(@)(@@) % كأنني حكمت في قلوبهم % % من لفظه الحلو العيون النجلا % % 96(@)(@@) % تعضله الغيرة من خطابه % % إذا القريض طلب التبعلا % % 97(@)(@@) % كم سامه من مرغب أو مرهب % % فلم يجب حبا ولا تجملا % % 98(@)(@@) % لكنني أراك من خطابه % % أكرم ملكا وأقل مللا % % 99(@)(@@) % لذاك أمكنتك من عنانه الص % % عب وأرخصت عليك ما غلا % % 100(@)(@@) % أهديته من قبل أن تخطبه % % تبرعا بالوصل أو تنفلا % % PageV01P2130 101(@)(@@) % فاشكر لمسعاي الذي سعيته % % متى شكرت شاعرا مطفلا % % 102(@)(@@) % محضتك النصح وما انتصحتني % % قولا فكايلني الجزاء عملا % % 103(@)(@@) % ومن شهود طربي إليكم % أنى تركت للمديح الغزلا % % PageV01P2131 البحر : - 1(@)(@@) % أصاب أو أخطأني راميا % % قد زجر السهم وسمى بيا % % 2(@)(@@) % جراحة مقصودة ما جنت % لكنه عد بها جانيا % % 3(@)(@@) % جوزي من حكم في لبه % % يوم العذيب الشادن الجازيا % % 4(@)(@@) % يا رب خذ لي أنت من مقلة % حمرتها من دم آماقيا % % 5(@)(@@) % تضعف عن حمل جلاليبها % % قاتلة حاملة ثاريا % % 6(@)(@@) % لو نشد البدر مضل له % % ما نشد الناعت إنشاديا % % 7(@)(@@) % لما تواقفنا على زمزم % أشرب ماء ليس لي شافيا % % 8(@)(@@) % بدا لها أن تسأل الركب بي % % عارفة تسأل عما بيا % % 9(@)(@@) % وامتد يعطو عزة جيدها % % فهل رأيت الرشأ العاطيا % % 10(@)(@@) % ما ضر من ضن بماعونه % وقد رآه بالمنى وافيا % % PageV01P2132 11(@)(@@) % لو غرفت راحته غرفة % فعب فيها ثم سقانيا % % 12(@)(@@) % سوفت من جمع فؤاديمنى % لو أنه منى غدا دانيا % % 13(@)(@@) % كن ثلاثا حلما في منى % % ثم مضى الركب وخلانيا % % 14(@)(@@) % يا من رأى النفر ولما يمت % نجوت فاخلد أبدا باقيا % % 15(@)(@@) % آه لأضلاعي وذكر الحمى % % من نفس ينفض أضلاعيا % % 16(@)(@@) % وزفرة أعدي بها عاذلي % % كم لسعة قد أعيت الراقيا % % 17(@)(@@) % ومن غمار في الهوى خضته % % مشمرا للصبر عن ساقيا % % 18(@)(@@) % وشبهة في الرأي مجهولة % لا 
ms680	 تجد النجم بها هاديا % % 19(@)(@@) % تيبس منها لهوات الحجا % % لا يبلغ الري بها الصاديا % % 20(@)(@@) % خرجت منها فارجا ضيقها % % مخلصا أسحب سرباليا % % PageV01P2133 21(@)(@@) % فكا لشجا قافية في اللها % % تماكس الحاذر والراقيا % % 22(@)(@@) % تخدع بالتأنيس من رامها % % صل صفا لا يرهب الحاويا % % 23(@)(@@) % بعثت من فكري لها رائضا % % ذلل منها اللحز الآبيا % % 24(@)(@@) % وقدتها أمكن من ظهرها % % أركبه أحساب إخوانيا % % 25(@)(@@) % ينقلني الود إلى مثلها % % والمال لا ينقل أخلاقيا % % 26(@)(@@) % وكم صديق عز داريته % % لو رزق الإنصاف دارانيا % % 27(@)(@@) % علمت شتى من أصابيغه % وهو يراني أبيضا صافيا % % 28(@)(@@) % يملني من حيث كاثرته % ولو تفرقنا تمنانيا % % 29(@)(@@) % أطلب غوثا كأبي طالب % % وعز أن ألقى له ثانيا % % 30(@)(@@) % خلصك الدهر من الناس لي % % من بعد تركاضي وتطوافيا % % PageV01P2134 31(@)(@@) % لأنعم من حيث قابلتها % % يوما بوجهي تتلقانيا % % 32(@)(@@) % تمت فلم تقعد بها خلة % تنقص منها العدد الوافيا % % 33(@)(@@) % من عثرة إن شمتها كلها % % واسطة العقد تراها هيا % % 34(@)(@@) % أجلها أنك أحرزتها % % إرثا حدا غابرها الماضيا % % 35(@)(@@) % لم تخل عن فضلك في بعضهم % % فضائل ينسبها خاليا % % 36(@)(@@) % خلاك أيوبوآباؤه % % تقول مجدي مجد آبائيا % % 37(@)(@@) % إذا الثمار اجتنيت حلوة % فاشكرلها الغارس والساقيا % % 38(@)(@@) % امدد إلى النجم يدا إنماواستم بأخلاقك ما شئت منمال ونفس لا تبع غاليا % % يكون عن غيركم عالياسقط بيت ص % % 39(@)(@@) % رشت فطارت بي محصوصة % تملأ من كسبي أو كاريا % % 40(@)(@@) % من بعد ما كنت قطاة بها % % قصيصة لا أتعب البازيا % % PageV01P2135 41(@)(@@) % بك استقامت لي عوج المنى % % وصدقت عائفتي فاليا % % 42(@)(@@) % وأرخت الأيام عن ربقتي % % أمرح أو أقطع أرسانيا % % 43(@)(@@) % أياديا أعطت يدي قوة % أمددتنيها بادئا تاليا % % 44(@)(@@) % فسمني الغدار إن لم أكن % % لها شكورا وبها جازيا % % 45(@)(@@) % في كل متروك لها شوطها % % تسابق السائق والحاديا % % 46(@)(@@) % جائلة واصلة ما علت % ثنية أو هبطت واديا % % 47(@)(@@) % تكون والليل بطئ القرى % % زادا لمن رافقها كافيا % % 48(@)(@@) % تسكر من تسنيمها صاحيا % وتطرب الكاتب والقاريا % % 49(@)(@@) % في كل ناد لكم ناقد % منها خطيب يملأ الناديا % % 50(@)(@@) % كمدحة مني 