ms431	 هم به معنی خانه‌زاد ذوالفقار(@)(@@) 8 عارف معنی‌پرست ار صورتی بیند چو تو %~% هم در آن باعت‌کند صورت‌پرستی اختیار(@)(@@) 9 خواجه اعظم پس از یزدان پرستد مر ترا %~% وندرین رمزیست کش صورت‌پرستی اختیار(@)(@@) 10 خواجه ‌را چشمیست‌ معنی ‌بین‌ به ‌هر صورت که ‌هست %~% زانکه ما صورت همی بینیم و او صورت‌نگار(@)(@@) 11 ای مهین تمثال هستی ای بهین تصویر عقل %~% تا چه نقشی ‌کز تو جوید عقل و هستی اعتبار(@)(@@) 12 نیک می‌تابی مگر مهتاب داری در بغل %~% نور می‌باری مگر خورشید داری درکنار(@)(@@) 13 نفس ‌و روح و عقل‌ و معنی را همی‌گوید حکیم %~% کس نمی‌بیند به چشم و من ندارم استوار(@)(@@) 14 زانکه تا نقش همایون ترا دیدم به چشم %~% نفس‌ و روح‌ و عقل‌ و معنی شد مصور هر چهار(@)(@@) 15 عارفت ار نقشت عیان بیند به مرآت وجود %~% در ظهور هستی غیبش نماید انتظار(@)(@@) 16 پرده‌ات را از ازل‌گویی فلک نساج بود %~% کز جلالش‌کرد پود و از جمالش بافت تار(@)(@@) 17 صورت شاهی و پیدا معنی شاهی ز تو %~% نقش هر معنی شود آری ز صورت آشکار(@)(@@) 18 هرکجا هستی‌تو شاه آنجا به‌معنی حاضرست %~% زان که تو سایه ی شهی شه سایه ی پروردگار(@)(@@) 19 زان ستادستند میران و بزرگان بر درت %~% هم بدان آیین ‌که بر دربار خسرو روزبار(@)(@@) 20 عیش دایم پیش روی و عمر جاوید از قفا %~% یمن دولت بر یمین و یسر شوکت بر یسار(@)(@@) 21 یک طرف سرهنگ و سرتیپان گروه اندر گره %~% یک طرف تابین و سربازان قطار اندر قطار(@)(@@) 22 زیر دست چاکران شاه ماه و آفتاب %~% زیر دست آفتاب و ماه چرخ و روزگار(@)(@@) 23 یک‌دو صف باترک زین چار میر ملک جم %~% کهترین سؤباز شاهنشاه صاحب اختیار(@)(@@) 24 روزگار و چرخ و مهر و ماه آری‌کیستند %~% تا شوند از قدر با سرباز خسرو همقطار(@)(@@) 25 هم به دست خیلی از خدام جام‌گوهرین %~% هم به دوش فوجی 
ms432	 از سرباز مار مورخوار(@)(@@) 26 جام آن شربت دهد احباب شه را روز عید %~% مار این ضربت زند خصم ملک را روزکلر(@)(@@) 27 آن نماید خنگ عشرت را به جام خود لجام %~% وین برآرد خصم خسرو را به مار خود دمار(@)(@@) 28 هم ز جام آن مصور صورت جمشید و جام %~% هم به مار این محول حالت ضحاک و مار(@)(@@) 29 زان جوان و پیر می رقصند امروز از نشاط %~% کاب ششپیر آمد از بخت جوان شهریار(@)(@@) 30 چون ‌که این آب روان از راه خلر ‌آمدست %~% چون شراب خلری زان مست‌گردد هوشیار(@)(@@) 31 آن ششپیرست آن یا آب شمشیر ملک %~% دوستان را دلپذیر و دشمنان را ناگوار(@)(@@) 32 جود شاهنشه مگر سرچشمه این آب بود %~% کاب می جوشد همی ‌از کوه و دشت و مرغزار(@)(@@) 33 از نشاط آنکه این آب آید از بخت ملک %~% شعر قاآنی چو تیغ شاه‌گشتست آبدار(@)(@@) 34 گو مغنی لحن شهرآشوب ننوازد از آنک %~% شهر بی‌آشوب‌ گشت از بخت شاه بختیار(@)(@@) 35 تا به ‌دهر اندر حصار ملک‌ گیتی هست چرخ %~% حزم شه چون چرخ بادا ملک ‌گیتی را حصار PageV1P226(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 باد میمون این بهین تشریف شاه‌کامگار %~% بر علیخان آن مهین فرزند صاحب‌اختیار(@)(@@) 2 شه‌ بود خورشید و او ماهست‌ و ابن ‌تشریف ‌نور %~% دایم از خورشدگیرد ماه نور مستعار(@)(@@) 3 پادشه‌ بحرست ‌و او درجست‌ و این ‌تشریف در %~% تربیت از بحر یابد درج در شاهوار(@)(@@) 4 شه بود ابر بهار او سرو فیض او مطر %~% سرو را سرسبز دارد از مطر ابر بهار(@)(@@) 5 دوست ‌دارد خانه‌زاد خوبش ‌را هرکس به طبع %~% این عجب نبود گر او را دوست دارد شهریار(@)(@@) 6 کودکست و نوجوان چون بخت شاه نامور %~% زین رهش داردگرمی بخت شاه نامدار(@)(@@) 7 رسم دیرینست کز میل طبیعت کودکان %~% دوست می‌دارند همسالان خود را بیشمار(@)(@@) 8 ای شبستان ظفر را طفل بختت نوعروس %~% وی ‌گلستان ‌کرم را 
ms433	 ابر دستت آبیار(@)(@@) 9 کوه با حزم تو چون فکر حکیمان تیزرو %~% باد با عزم تو چون عهدکریمان استوار(@)(@@) 10 دوش‌کردم حیرت‌از دستت‌که چون ریزدگهر %~% عقل ‌گفتا غافلی ‌کاو بحر دارد در جوار(@)(@@) 11 ماه‌آن چرخی‌کش آمد عرش اعظم زیردست %~% شبل‌ آن ‌شیری‌که بود از شیرخواری شیرخوار(@)(@@) 12 سرو آن باغی‌ کزو خجلت برد باغ بهشت %~% در آن بحری‌که از وی بحر عمان شرمسار(@)(@@) 13 وصف‌گرزت دی نوشتم خامه‌ام شد ریز ریز %~% مدح خلقت دوش‌ گفتم خانه‌ام شد مشکبار(@)(@@) 14 یادی از رخش تو کردم فکرت من شد روان %~% نامی از تیغ تو بردم شعر من شد آبدار(@)(@@) 15 گر کسی خواهد که عزرائیل را بیند به چشم %~% گو ببیند جان‌ شکر تیغ تو را در کارزار(@)(@@) 16 ور حکیمی وهم را خواهد مجسم بنگرد %~% گو ببیند بد سیر خصم تراگاه فرار(@)(@@) 17 دشمن از زور تو می‌ترسد نه از شمشیر تو %~% زور بازوی علی مرحب‌کشد نه ذوالفقار(@)(@@) 18 گشته تیغت لاغر از بس خورده خون دشمنان %~% راست بودست اینکه لاغر می‌شود بسیار خوار(@)(@@) 19 کی بوده‌ کاستاده بینم مر ترا پیش پدر %~% همچو خرم‌ گلبنی در پیش سرو جویبار(@)(@@) 20 کی بود کز یزد آیی نزد میر ملک جم %~% نصر و فتح از پیش و پس یمن از یمین یسر از یسار(@)(@@) 21 گرچه دوری از پدر نزدیک جان بنشاندت %~% گر به نزدیکان شاه از دور سازی جان نثار(@)(@@) 22 هم مگر کز خواجه‌ دوری ‌مهر او نزدیک تست %~% آری او مهرست و مهر از دور گردد نوربار(@)(@@) 23 بندگی ‌کن تا خداوندی ‌کنی‌ کز بندگی %~% مر علی را داد تشریف ولایت‌ کردگار(@)(@@) 24 جهدکن درکوچکی تا چون پدر گردی بزرگ %~% سعی‌کن تا همچو او درکودکی یابی وقار(@)(@@) 25 خدمت شاه جوان‌کن تا شود بختت جوان %~% پند پیرانست این کز عجز خیزد اقتدار(@)(@@) 26 آهن از آسیب پتک و کوره‌ گردد تیغ تیز %~% زر سرخ از تف نار و 
ms434	 بوته ‌گردد خوش ‌عیار(@)(@@) 27 سرفرازی راز سربازی طلب زیرا که شمع %~% تا نبازد سر نگردد سرفرازیش آشکار(@)(@@) 28 تا جهان باقیست شاهنشه جهانبان باد و تو %~% زیر ظل رحمتش ساکن چو چرخ و روزگار(@)(@@) 29 طبع قاآنی بآ‌نی این سخنها آفرید %~% چون خلایق را به امری قدرت پروردگار PageV1P227(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 با فال نیک بهر زمین‌بوس شهریار %~% آمد ز ملک جم سوی ری صاحب ‌اختیار(@)(@@) 2 کهتر غلام شاه خداوند ملک جم %~% کمتر رهی خواجه خداوند حق ‌گزار(@)(@@) 3 سالی دو پیش ازین‌که شد آشفته ملک جم %~% وز هم‌گسیخت سلسله نظم آن دیار(@)(@@) 4 ملکی‌ که بود جمع‌تر از خال‌ گلرخان %~% چون زلف یارگشت پریشان و بیقرار(@)(@@) 5 از اهتمام خواجه پی دفع شور و شر %~% فرمانروای ملک جمش کرد شهریار(@)(@@) 6 ازخواجه‌بار جست‌و سبک‌بار بست‌و ر‌فت %~% بی‌لشکر و معاون و همدست و پیشکار(@)(@@) 7 نی‌نی خطا چه رانم همراه خویش برد %~% هرچ آفریده در دو جهان آفریدگار(@)(@@) 8 زیرا که بود قاید او بخت خواجه‌ای %~% کز جود او وجود دوگیتی شد آشکار(@)(@@) 9 بس‌ کارهای طرفه به ششمه نمود کش %~% یک سال‌گفت نتوان بر وجه اختصار(@)(@@) 10 لیک آنچه ‌کرد از مدد بخت خواجه ‌کرد %~% کز نامیه است خرمی سرو جویبار(@)(@@) 11 خود سنگریزه‌کیست‌که بی‌معجز رسول %~% گوید سخن چو مرد سخن‌سنج هوشیار(@)(@@) 12 بی‌عون ایزدی چکند دور آسمان %~% بی‌زور حیدری چه برآید ز ذوالفقار(@)(@@) 13 اوج و حضیض موج ز بادست در بحور %~% جوش و خروش سل ز ابرست در بهار(@)(@@) 14 آن را که خواجه خواند فرزند خویشتن %~% گر ناظم دوگیتی‌گردد عجب مدار(@)(@@) 15 باری به ملک جم در خوف و رجا گشود %~% تا دوست را شکور کند خصم را شکار(@)(@@) 16 شورش نشاند و سور بنا کرد و برکشید %~% حصنی ‌که بد بروج فلک را درو مدار(@)(@@) 17 انهار کند و برکه وکاریز و جوی و جر %~% بستان فزود و قریه و پالیز و کشتزار(@)(@@) 18 
ms435	 برداشت طرح غله و تحمیل نان فروش %~% بخشید باج برف و تکالیف راهدار(@)(@@) 19 نظم سپه فزود و منال دو ساله داد %~% خود را عزیزکرد و درم را نمود خوار(@)(@@) 20 زر داد و تخم و گاو و تقاوی به هر زمین %~% و آورد پیشه‌ور زو دهاقین ز هر کنار(@)(@@) 21 از بسکه ساخت چینی از دود غصه‌‌گشت %~% چون دیگ ‌کاسه سر فغفور پر بخار(@)(@@) 22 کان‌کند وک‌ره‌بست‌و فلز جست‌وباغ‌باخت %~% سرو و نهال‌کشت و درختان میوه‌دار(@)(@@) 23 سد بست‌وکه‌شکست و بیاورد سوی شهر %~% ششپیر راکه هست یکی رود خوشگوار(@)(@@) 24 بهر طراز آب ز صد میل ره فزون %~% گه غارکوه‌ کرد و گهی‌کوه ‌کرد غار(@)(@@) 25 گه ‌کوه را شکافت چو شمشیر پادشه %~% گه دشت را چو خنگ ملک‌ کرد کوهسار(@)(@@) 26 کوهی راکه رازگفتی درگوش آسمان %~% چون سنگریزه در تک جوبینیش قرار(@)(@@) 27 غاری ‌که پای ‌گاو زمین سودیش به فرق %~% بر شاخ‌ گاو گردون یابیش رهسپار(@)(@@) 28 سدی سدید در دره‌یی بسته‌کاندرو %~% وهم از حد برون شدنش نیست اقتدار(@)(@@) 29 صد میل راه ‌کرده ترازو به یکدگر %~% همچون اساس عدل شهنشاه تاجدار(@)(@@) 30 وان چاههای چند که جم کند و زیر خاک %~% ماند از برای آب دو چشن در انتظار(@)(@@) 31 فرسوده بود و سوده و آکنده آنچنانک %~% گفتی تلیست هر یک از آنها به رهگذار(@)(@@) 32 هر چاه را دوباره به ماهی رساند وکرد %~% مزد آن‌ گرفت جان برادر که‌ کرد کار(@)(@@) 33 مزدوروار رفت به هر چاه و کار کرد %~% تا اوج ماه با گچ و ساروجش استوار(@)(@@) 34 آری‌ کدام مزد بهست از رضای شه %~% وز التفات خواجه و تایید کردگار(@)(@@) 35 از بهر حفر چاه ز بس تیشه زد به خاک %~% چشم زمین ز سوز درون ‌گشت اشکبار(@)(@@) 36 یوسف شنیده‌ام ‌که به چه‌ گریه می‌نمود %~% او بود یوسفی که چه‌ از وی گریست زار(@)(@@) 37 یکبار رفت یوسف مصری اگر به چه %~% او 
ms436	 بهر آزمون عمل شد هزار بار(@)(@@) 38 یوسف به چاه رفت و زان پس عزیز شد %~% او خود عزیز بودکه در شد به چاهسار(@)(@@) 39 فرقی دگر که داشت ز یوسف جز این نبود %~% کاو شد به جبر در چه و این یک به اختیار(@)(@@) 40 وز حکم‌ خواجه ساخت به ‌شیراز اندرون %~% چندین بنا که‌ کردن نتوانمش شمار(@)(@@) 41 حصنی رفیع ساخت به بالای آسمان %~% حوضی عمیق ‌کند به پهنای روزگار(@)(@@) 42 از قصرهاکه هریکشان رشک آسمان %~% وز باغها که هریکشان داغ قندهار(@)(@@) 43 گویی‌ کشیده شهرش افلاک در بغل %~% گویی‌گرفته راغش جنات در کنار(@)(@@) 44 باری پس از دو سال ‌که از هجر خواجه شد %~% چون نوک‌ کلک‌ خواجه ‌دلش چاک و تن نزار(@)(@@) 45 بیکی ز ره رسید که زی ملک خاوران %~% جیشی ‌کند گسیل شهنشاه‌ کامگار(@)(@@) 46 وان خواجه بزرگ خداجوی شه‌پرست %~% همت به‌ کار برده پی دفع نابکار(@)(@@) 47 با خویش‌گفت عاطفت خواجه مر مرا %~% برد از حضیض ذلت بر اوج افتخار(@)(@@) 48 از عهد شیرخوارگیم تربیت نمود %~% تا روزی اینچنین که شدم‌ گرد و شیرخوار(@)(@@) 49 سربازی از سپاه خدیو جهان بدم %~% بی‌نام و بی‌نشان و تهی‌دست و خاکسار(@)(@@) 50 و ایدون ز لطف خواجه به جایی رسیده‌ام %~% کم برده صف به صف بود و بدره باربار(@)(@@) 51 بودم نخست خاربنی خشک و عاقبت %~% زاقبال او شدم چوگل سرخ‌کامگار(@)(@@) 52 ایدر که ‌گاه بندگی و روز خدمت است %~% باید به عز خواجه‌ کمر بستن استوار(@)(@@) 53 بردن پی بسیج سپاه ملک به ری %~% اسب و ستور و بختی و اسباب ‌کارزار(@)(@@) 54 این ‌گفت ‌و برنشست‌ و به ‌ری‌ رقت و سر نهاد %~% بر خاکپای خواجه و زی شاه جست بار(@)(@@) 55 وز نزد هر دو آمد بیرون شکفته روی %~% زا‌نسان‌که از خلاص زر سرخ خوش عیار(@)(@@) 56 کرد از پی بسیج سفر صر های زر %~% چون نقد جان به پای غلامان شه‌نثار(@)(@@) 57 
ms437	 با صد دونده اسب و دو صد استر سترک %~% با چارصد هیون زمین‌کوب راهوار(@)(@@) 58 وز آن دهان شکافته ماران آهنین %~% کاول خورند مور و سپس قی ‌کنند مار(@)(@@) 59 آورد نزد شه دو هزار از برای جنگ %~% تا مارسان برآرند از خصم شه دمار(@)(@@) 60 شه خلعتیش داد همایون به دست خویش %~% چون نوک‌کلک خواجه زراندود و زرنگار(@)(@@) 61 آن جامه‌ای‌ که ‌گفتی جبریل بافته %~% از زلف و جعد حوری و غلمانش پود و تار(@)(@@) 62 هم داد شه به‌دست خودش یک درست ‌زر %~% یعنی چو زر درست شود بعد ازینت‌کار(@)(@@) 63 وز خواجه یافت عاطفتی‌ کز روان بدن %~% وز باد فرودین گل و از ابر مرغزار(@)(@@) 64 ازکردگار عقل و ز عقل شریف نفس %~% وز نفس پاک پیکر و از هوش هوشیار(@)(@@) 65 وز آب تازه ماهی و از سیم و زر فقیر %~% وز قرب دوست عاشق و از وصل‌ گل هزار(@)(@@) 66 وز مصطفی بلال و ز مهر فلک هلال %~% وز مرضی اویس وز نور قمر شمار(@)(@@) 67 یا حاجی از ورود حرم درگه طواف %~% یا ناجی از خلود ارم در صف شمار(@)(@@) 68 خواجه است نایب نبی و او به خدمتش %~% برچیده است ساعد همت اسامه‌وار(@)(@@) 69 هرک ازاسامه جست تخلف رسول گفت %~% نفرین بدو در است ز خلاق نور و نار(@)(@@) 70 آری ضمیر خواجه محک هست وز محک %~% نقدی‌ که خالصست فزون جوید اعتبار(@)(@@) 71 امروز در عوالم هستی ز نیک و بد %~% رازی نهفته نیست بر آن خضر نامدار(@)(@@) 72 ناگفته داند آرزوی طفل در رحم %~% نادیده یابد آبخور وحش در قفار(@)(@@) 73 از جود بخشد آنچه به هرگنج سیم و زر %~% وز حزم داند آنچه به هر شاخ برک و بار(@)(@@) 74 پیریست زنده‌دل‌که جوانست تا به حشر %~% زو بخت شهریار ظفرمند بختیار(@)(@@) 75 شاه جهانگشای محمدشه آنکه هست %~% جانسوز تیغش از ملک‌الموت یادگار(@)(@@) 76 ای خسروی که تا به دم روز 
ms438	 واپسین %~% ذکر محامدت نتوانم یک از هزار(@)(@@) 77 خصم تو همچو خاک نخواهد شدن بلند %~% الا دمی ‌که در سم اسبت شود غبار(@)(@@) 78 یا همچو آب میل صعود آن زمان ‌کند %~% کاجزای جسمش‌ از تف تیغت شود بخار(@)(@@) 79 یا آن زمان‌ که جسم و سرش از عتاب تو %~% این‌یک رود به‌نیزه و آن‌یک رود به دار(@)(@@) 80 پیوسته باد آتش تیغ تو مشتعل %~% تا حاسد شریر ترا سوزد از شرار PageV1P228(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 با فال نیک و حال خوش و بخت‌کامگار %~% از ملک جم به عزم سپاهان شدم سوار(@)(@@) 2 در زیر ران من فرسی ‌کافریده بود %~% اوهام را ز پویه او آفریدگار(@)(@@) 3 شخ ‌بر و که‌نورد و جهانگرد و گرم‌سیر %~% کم‌خسب و پرتوان و زمین‌کوب و رهسپار(@)(@@) 4 کز پی نگارم آمد و تنگم عنان گرفت %~% با چشم اشکبار و دوگیسوی مشکبار(@)(@@) 5 در زیر مه فراشته از سیم ساده سرو %~% بر برگ ‌گل‌ گذاشته از مشک سوده تار(@)(@@) 6 مویی به بوی سنبل و رویی به رنگ‌ گل %~% قدی به لطف طوبی و خدی به نور نار(@)(@@) 7 گیسوی تابدارش همسایه ی بهشت %~% زلفین عنبرینش پیرایه بهار(@)(@@) 8 لعلش پر آب بی‌مدد نور آفتاب %~% چشمش به خواب بی‌اثر برگ کو کنار(@)(@@) 9 بر سرو ماه هشته و بر ماه غالیه %~% بر رخ ستاره بسته و بر پشت‌کوهسار(@)(@@) 10 بر زهره رخش مه و خورشید مشتری %~% از حسرت خطش شبه و مشک سوگوار(@)(@@) 11 در روی و موی او چو اسیران روم و زنگ %~% دلهای داغ دیده قطار از پی قطار(@)(@@) 12 گیسو گشود و مغزم از آن‌ گشت عنبرین %~% عارض نمود و چشم از آن گشت لاله‌زار(@)(@@) 13 چنگی زدم به زلفش و از تار تار او %~% چون‌ تار چنگ خاست بسی نالهای زار(@)(@@) 14 وز هر مکنج او که گشودم به خاک ریخت %~% چندین هزار سلسله دلهای بیقرار(@)(@@) 15 وانگشتهای من چو زره‌گشت پرگره 
ms439	 %~% از پیچ و تاب و حلقه زلفین آن نگار(@)(@@) 16 القصه نارسیده لب شکوه باز کرد %~% وآن طبله طبله مشک پریشید بر عذار(@)(@@) 17 گفت ای نکرده یاد ز یاران و دوستان %~% این بود حق صحبت یاران حق‌گزار(@)(@@) 18 باری چه روی داد ندانم‌که بی‌سبب %~% مسکین دلم شکستی و بستی ز شهریار(@)(@@) 19 این‌گفت و از تگرگ بپوشید لاله برگ %~% وز نرگسش چکید به‌ گل دانهای نار(@)(@@) 20 بیجاده راگزید به الماس شکرین %~% یاقوت را مزید به لولوی شاهوار(@)(@@) 21 از ده هلال مریخ انگیخت از قمر %~% وز خون دیده بست ده انگشت را نگار(@)(@@) 22 از جزع بست دجله سیماب بر سمن %~% وز اشک ریخت سوده الماس در کنار(@)(@@) 23 گفتم بتا مموی و پریشان مساز موی %~% کز مویه ترسمت‌که چو مویی شوی نزار(@)(@@) 24 اشک‌تو انجمست و رخت مهر وکس ندید %~% کانجا که هست مهر شود انجم آشکار(@)(@@) 25 دیدم بسی ‌که خیزد از جویبار سرو %~% نشنیده‌ام‌که خیزد از سرو جویبار(@)(@@) 26 پروین بروز می‌ننماید ترا چه شد %~% کایدون بروز خوشه پروین‌کنی نثار(@)(@@) 27 جراره از چه پوشی بر ماه نوربخش %~% سیاره از چه پاشی بر مهر نور بار(@)(@@) 28 باری قسم به جوشن داود و مهر جم %~% یعنی به زلفکان تو وان لعل آبدار(@)(@@) 29 کز هرچه در جهان‌گذرم در هوای تو %~% الا ز خاکبوسی صدر بزرگوار(@)(@@) 30 سالار دهر معتمدالدوله آنکه هست %~% دیباچه جلالت و عنوان اقتدار(@)(@@) 31 صدری ‌که بر یسار وی افلاک را یمین %~% بدری‌که از یمین وی آفاق را یسار(@)(@@) 32 هر چیز در زمانه به هستیت مفتخر %~% جز ذات وی ‌که هستی از آن دارد افتخار(@)(@@) 33 بر خاک شوره تابد اگر نور روی او %~% خور جای خار روید از خاک شوره‌زار(@)(@@) 34 یک ناامید در همه‌گیتی ندیده چرخ %~% کاو را نکرده فضل عمیمش امیدوار(@)(@@) 35 دوران به دور دولت او جوید اختتام %~% گیهان ز فر شوکت او خواهد اعتبار(@)(@@) 36 گیتی 
ms440	 به عدل شامل اوگشته معتصم %~% هستی به ذات‌ کامل او جسته انحصار(@)(@@) 37 ای چون سپهر قصر جلال تو بی‌قصور %~% وی چون وجود لجه جود تو بی‌کنار(@)(@@) 38 تن را هوای مهر تو چون عمر سودمند %~% جان راسموم قهر تو چون مرگ ناگوار(@)(@@) 39 چون ذات عقل پایه جاهت بر از جهت %~% چون فیض روح مایه جودت بر از شمار(@)(@@) 40 بذل تو بی‌قیاس چو ادوار آسمان %~% فضل تو بی‌حساب چو اطوار روزگار(@)(@@) 41 در پیش خصم تیغ تو سدیست آهنین %~% برگرد ملک حزم تو حصنیست استوار(@)(@@) 42 عدلت به‌ کتف ماه ز کتان نهد رسن %~% حزمت به گرد آب ز آتش کشد حصار(@)(@@) 43 ناگفته دانی آرزوی طفل در رحم %~% نادیده یابی آبخور وحش در قفار(@)(@@) 44 از خاک‌گاه جود تو زرین دمد شجر %~% وز آب روز مهر تو مشکین جهد بخار(@)(@@) 45 خصم ترا به دهر محالست برتری %~% جز آنکه خاک‌ گردد و خاکش شود غبار(@)(@@) 46 ای بر زمین طاعت تو چرخ را سجود %~% وی در نگین خاتم تو ملک را مدار(@)(@@) 47 وقتی بران شدم‌ که به دیوان رقم ‌کنم %~% ز اوصاف تیغ‌جان‌شکرت بیتکی سه‌چار(@)(@@) 48 ننوشته نام تیغ توکز نوک‌کلک من %~% جست آتشی‌ که تا به فلک رفت ازان شرار(@)(@@) 49 هی سوخت دفتر من از اوصاف او و من %~% هی آب می‌زدم به وی از شعر آبدار(@)(@@) 50 زاندام اهل زنگ سیاهی برون رود %~% گر آفتاب تیغ تو تابد به زنگبار(@)(@@) 51 روزی نسیم خلق تو بر مغز من وزید %~% پر شد کنار و دامنم از نافه تتار(@)(@@) 52 چون نام همت تو برم از زبان من %~% در خوشه خوشه ریزد و دینار بار بار(@)(@@) 53 چون وصف مجلس تو کنم خیزد از لبم %~% آواز چنگ و نغمه نای و نوای تار(@)(@@) 54 کوهیست همتت ‌که چو بحرست موج‌خیز %~% بحریست رحمتت‌که چوکوهیست پایدار(@)(@@) 55 یا حبذا ز تیغ تو آن پاسبان بخت %~% کز وی 