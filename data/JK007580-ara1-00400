ms381	 فإما عاث فيه حاسدوه ؛ %~% وإما غاله متكسبوه(@)(@@) 39 وللأرمين خطب مستفيض %~% يعوم بلجه متعجبوه(@)(@@) 40 ولو قدروا على إيوان كسرى %~% لساموه الردى وتعقبوه PageV01P1763(@)(@@) 41 وقد منوا برزق الله جهلا %~% كأنهم لباغ سببوه(@)(@@) 42 إذا أصحاب دين أحكموه %~% أذالوا ما سواه وعيبوه(@)(@@) 43 وقد شهد النصارى أن عيسى %~% توخته اليهود ، ليصلبوه(@)(@@) 44 وما أبهوا ، وقد جعلوه ربا %~% لئلا ينقصوه ويجدبوه(@)(@@) 45 تمج قلوبهم ما أودعته %~% لسوء في الغرائز ، أشربوه(@)(@@) 46 أضاعوا السر لما استحفظوه ؛ %~% وقد صانوا الأديم وسربوه(@)(@@) 47 لهم نسب الرغام ، وذاك طهر ، %~% ولم يطهر به متنسبوه(@)(@@) 48 ونبئ في بني يعقوب موسى %~% بشرع ما تخلص متعبوه(@)(@@) 49 وكم نضت النواظر كل عام %~% وأتراب السعادة متربوه(@)(@@) 50 على حجر لهم تهوي جبال %~% ولم يستعفف ذنبا مذنبوه PageV01P1764(@)(@@) 51 ودون الأبيض المشتار زغب %~% لواسب عقنهم أن يلبسوه(@)(@@) 52 وقد ركب الذين مضوا سبيلا %~% إلى عليائهم لم يركبوه(@)(@@) 53 وحبل العيش منتكث ضعيف %~% ونعم الرأي ألا تجذبوه(@)(@@) 54 %~% بأسباب الحمام ، فقضبوه(@)(@@) 55 فمن سيف ، ومن رمح وسهم %~% ونصل أرهفوه وذربوه(@)(@@) 56 وما دفعت عن الملك المنايا %~% مقانبه ، ولا متنكبوه(@)(@@) 57 حسبتم يا بني حواء شيئا ، %~% فجاءكم الذي لم تحسبوه(@)(@@) 58 وجيران الغريب مبغضوه %~% إلى جلاسهم ، ومحببوه(@)(@@) 59 فإن يولوا قبيحا يذكروه ؛ %~% وإن يحبوا يشيعوا ما حبوه(@)(@@) 60 تقول الهند آدم كان قنا %~% لنا فسرى إليه مخببوه PageV01P1765(@)(@@) 61 أولئك يحرقون الميت نسكا %~% ويشعره لبانا ملهبوه(@)(@@) 62 ولو دفنوه في الغبراء ، جاءت %~% بما يسعى له متألبوه(@)(@@) 63 أديل الشر منكم فاحذروه %~% ومات الخير منكم فاندبوه(@)PageV01P1766(@)(@@) البحر : وافر تام(@)(@@) 1 تهجد معشر ليلا ونمنا %~% وفاز بحندس متهجدوه(@)(@@) 2 إلهك أوجد الأشياء جمعا ، %~% فلا يفخر بشيء موجدوه(@)(@@) 3 وربك أنجد الأقوام ، حتى %~% بنى أعلى القصور منجدوه(@)(@@) 4 فمجده فلم يخسر أناس %~% أنابوا للمليك ومجدوه(@)PageV01P1767(@)(@@) البحر : وافر تام(@)(@@) 1 ظلمتم غيركم فأديل منكم %~% وأخيار الأنام مظلموه(@)(@@) 2 تهاونتم بمطران النصارى ، %~% وأشياع ابن مريم عظموه(@)(@@) 3 وقال نبيكم لكم إذا ما %~% كريم القوم جاء ، فأكرموه(@)(@@) 4 فلا يرجع خطيبكم 
ms382	 بحقد %~% متى لاقاهم ، فتهضموه(@)PageV01P1768(@)(@@) البحر : وافر تام(@)(@@) 1 تحمل عن أبيك الثقل يوما %~% فإن الشيخ قد ضعفت قواه(@)(@@) 2 أتى بك عن قضاء لم ترده ، %~% وآثر أن تفوز بما حواه(@)(@@) 3 صديقك في الجهار عدو سر ، %~% فلا تأسف إذا شحطت نواه(@)(@@) 4 ركنت إلى الفقيه بغير علم %~% وكم زور لسائله رواه(@)(@@) 5 وما في نشر هذا الخلق نعمى ، %~% فهل يلحى الزمان إذا طواه ؟(@)(@@) 6 فصيل أخيك يشكو طول ظمء ، %~% بما لاقى فصيلك من غواه(@)(@@) 7 وكيف يؤمل الإنسان رشدا %~% وما ينفك متبعا هواه(@)(@@) 8 يظن لنفسه شرفا وقدرا %~% كأن الله لم يخلق سواه(@)(@@) 9 ألا تثني جمالك نحو مرعى ، %~% فهذا الرمل لم ينبت لواه(@)(@@) 10 ولست بمدرك أمرا قريبا %~% إذا ما خالقي عني زواه(@)PageV01P1769(@)(@@) البحر : كامل تام(@)(@@) 1 الراهب المسجون فرط عبادة %~% من حب دنياه الكذوب موله(@)(@@) 2 أعرفتم أصحابكم بحقيقة %~% أم كلكم عنهم غبي أبله ؟(@)(@@) 3 ذكر التأله فادعوه تخرصا %~% ما هذه أفعال من يتأله !(@)PageV01P1770(@)(@@) البحر : منسرح(@)(@@) 1 لم يبق في العالمين من ذهب ، %~% وإنما جل من ترى شبه(@)(@@) 2 دعهم فكم قطعت رقابهم %~% جدعا ، ولم يشعروا ولا أبهوا(@)(@@) 3 قد موزجوا بالنفاق فامتزجوا %~% والتبسوا في العيان ، واشتبهوا(@)(@@) 4 وما لأقوالهم إذا كشفت %~% حقائق ، بل جميعها شبه(@)(@@) 5 قد ذهبت عادهم وجرهمها ، %~% وهم على ما عهدت ما انتبهوا(@)PageV01P1771(@)(@@) البحر : خفيف تام(@)(@@) 1 أسهب الناس في المقال ، وما يظ %~% فر ، إلا بزلة ، مسهبوه(@)(@@) 2 والنفس لاجئة إلى جسد لها %~% خلقت محاذرة من الإصحار(@)(@@) 2 عجبا للمسيح بين أناس ،(@)(@@) 3 أسلمته إلى اليهود النصارى %~% وأقروا بأنهم صلبوه(@)(@@) 4 يشفق الحازم اللبيب على الطف %~% ل ، إذا ما لداته ضربوه(@)(@@) 5 وإذا كان ما يقولون في عيس %~% يقينا فأين كان أبوه(@)(@@) 6 كيف خلى وليده للأعادي ، %~% أم يظنون أنهم غلبوه ؟(@)(@@) 7 وإذا ما سألت أصحاب دين %~% غيروا ، بالقياس ، ما رتبوه(@)(@@) 8 لا يدينون بالعقول ولكن %~% بأباطيل زخرف كذبوه(@)PageV01P1772(@)(@@) البحر : طويل(@)(@@) 1 إذا كنت قد أتيت لبا وحكمة %~% فشمر عن الدنيا ، فأنت منافيها(@)(@@) 2 
ms383	 وكونن لها ، في كل أمر ، مخالفا ، %~% إلا سراب تنوفة مسخار(@)(@@) 2 أتخالفها في كل أمر تريده %~% فما لك خير في بنيها ولا فيها(@)(@@) 3 وهيهات ما تنفك ولهان مغرما %~% بورهاء لا يعطى الصفاء مصافيها(@)(@@) 4 فإن تك هذي الدار منزل ظاعن %~% فدار مقامي ، عن قليل ، أوافيها(@)(@@) 5 أرجي أمورا لم يقدر بلوغها %~% وأخشى خطوبا والمهيمن كافيها(@)(@@) 6 وإن صريع الخيل غير مروع %~% إذا الطير همت بالقتيل عوافيها(@)(@@) 7 بغبراء لم تحفل بطل ووابل %~% ونكباء تسفي بالعشي سوافيها(@)(@@) 8 أرى مرضا بالنفس ليس بزائل ؛ %~% فهل ربها مما تكابد شافيها ؟(@)(@@) 9 وفي كل قلب غدرة مستكنة %~% فلا تخدعن من خلة بتوافيها(@)PageV01P1773(@)(@@) البحر : طويل(@)(@@) 1 تنازع في الدنيا سواك ، وما له %~% ولا لك شيء بالحقيقة فيها(@)(@@) 2 ولكنها ملك لرب مقدر ، %~% يعير جنوب الأرض مرتدفيها(@)(@@) 3 ولم تحظ في ذاك النزاع بطائل %~% من الأمر ، إلا أن تعد سفيها(@)(@@) 4 أيا نفس لا تعظم عليك خطوبها %~% فمتفوقوها مثل مختلفيها(@)(@@) 5 وصفت لقوم رحمة أزلية ، %~% ولم تدركي بالقول أن تصفيها(@)(@@) 6 تداعوا إلى النزر القليل فجالدوا %~% عليه وخلوها لمغترفيها(@)(@@) 7 وما أم صل ، أو حليلة ضيغم ، %~% بأظلم من دنياك فاعترفيها(@)(@@) 8 تلاقي الوفود القادميها بفرحة ، %~% وتبكي على آثار منصرفيها(@)(@@) 9 ولم يتوازن في القياس نعيمها %~% وسيئة أودت بمقترفيها(@)(@@) 10 وأرزاقها تغشى أناسا بفترة ، %~% وتقصر ، حينا ، دون مكترفيها PageV01P1774(@)(@@) 11 وما هي إلا شاكة ليس عندها %~% _ وجدك _ إرطاب لمخترفيها(@)(@@) 12 فنالت ، على الخضراء ، شرب كميتها ، %~% وغالت على الغبراء معتسفيها(@)(@@) 13 كما نبذت للوحش والطير رازم %~% فألفت شرورا بين مختطفيها(@)(@@) 14 تناءت عن الإنصاف ، من ضيم لم يجد %~% سبيلا إلى غايات منتصفيها(@)(@@) 16 فأطبق فما ، عنها ، وكفا ومقلة ، %~% وقل لغوي الناس فاك لفيها(@)(@@) 17 كأن التي في الكأس ، يطفو حبابها ، %~% سمام حباب بين مرتشفيها(@)(@@) 18 تتابع أجزاء الزمان لطائفا %~% وتلحق تفريقا بمؤتلفيها(@)PageV01P1775(@)(@@) البحر : بسيط تام(@)(@@) 1 كأن أكوان أعمار ، نعيش بها ، %~% خيل يبدل ماضيها بتاليها(@)(@@) 2 ففذها يحمل الأشياء قاطبة ، %~% كلحمة العين ثم العين واليها(@)(@@) 3 
ms384	 تحط عنه لآت بعده أبدا ، %~% ولا تبيد ولا تثنى خواليها(@)(@@) 4 هون عليك ، فما الدنيا بدائمة ، %~% وليس عاطلها إلا كحاليها(@)(@@) 5 والعقل يزعم أياما ، تشاهدها %~% بيضا حوادث في داجي لياليها(@)(@@) 6 نفسي بها ونفوس الناس ملهجة %~% ونحن نخبر أنا لا نباليها(@)(@@) 7 أمرتني بسلو عن خوادعها %~% فانظر هل انت مع السالين ساليها ؟(@)(@@) 8 ولا ترى الدهر إلا من يهيم بها ، %~% طبعا ، ولكنه في اللفظ قاليها(@)(@@) 9 والجسم لا شك أرضي ، وقد وصلت %~% به لطائف عالاها معاليها(@)(@@) 10 والله يقدر أن تدعى بحكمته ، %~% أواخر من براياه ، أواليها PageV01P1776(@)(@@) 11 فقيل جاءته من أرض على كثب %~% وقيل خرت إليه من معاليها(@)PageV01P1777(@)(@@) البحر : بسيط تام(@)(@@) 1 ناديت أقضية الله التي سلفت : %~% إن المعالي بذتها معاليها(@)(@@) 2 وضعت نفسي ، فعاليها على قتب %~% من الغنى ، يعرف الجدوى فعاليها(@)(@@) 3 نوائب الدهر تستقري غوابرها %~% حتى ترى ، كحواليها ، خواليها(@)(@@) 4 أما نبال المنايا ، فهي مصمية %~% فما نبال مقال لا أباليها(@)(@@) 5 لا تمنع الغادة الحسناء نعمتها ، %~% وأن تقوم حواليها حواليها(@)(@@) 7 وما تفيد الغواني من لآليها %~% نفعا ، إذا جاء كيد من لياليها(@)(@@) 8 ولم تجدني طغاة الناس في طمع ، %~% حتى تعيش أواليها أواليها(@)(@@) 9 جماعة القوم جدت في تناظرها %~% كعانة الوحش جدت في تغاليها(@)(@@) 10 حق على أنفس منهم تكالؤها ، %~% فقد يخاف عليها من تكاليها(@)(@@) 11 بطن البسيطة أعفى من ظواهرها ، %~% فوسعا لي أهرب من سعاليها PageV01P1778(@)(@@) 12 وما تزال دواليها نوائبها %~% فمن شداد خطوب أو دواليها(@)(@@) 13 وقد أطلت وصاليها على سخط %~% مني ، وسيان غرقاها وصاليها(@)(@@) 14 وما استراح لعمري من سوائلها %~% إذا طغى ماؤها إلا سواليها(@)PageV01P1779(@)(@@) البحر : بسيط تام(@)(@@) 1 حاشيت غيري ، ونفسي ما أحاشيها ، %~% خشيتها ، وحليف اللب خاشيها(@)(@@) 2 واستجهلتني رجال ، لم تزل جهلا ، %~% إن الأوابي هاجتها عواشيها(@)(@@) 3 أما العراق ، فعمت أرضه فتن ، %~% مثل القيامة غشتها غواشيها(@)(@@) 4 والشام أصلح ، إلا أن هامته %~% فضت وأسرى على النيران عاشيها(@)(@@) 5 والقوم يردون من لاقوا بأردية ، %~% أعلامها الدم لم تكفف حواشيها(@)(@@) 6 ذوات قر يظنوا دارجات قرى 
ms385	 %~% مضت عليها ، ولم تقفل مواشيها(@)(@@) 7 أنستك ، هندا ، سيوف الهند ، ماحية %~% ما قال عاذلها ، أو قال واشيها(@)(@@) 8 وللزمان على أبنائه ، أبدا ، %~% حكومة ، لا يرد الحكم راشيها(@)PageV01P1780(@)(@@) البحر : بسيط تام(@)(@@) 1 حسبي من الجهل علمي أن آخرتي %~% هي المآل ، وأني لا أراعيها(@)(@@) 2 وأن دنياي دار لا قرار بها %~% وما أزال معنى في مساعيها(@)(@@) 3 كذلك النفس ما انفكت معللة %~% بباطل العيش ، حتى قام ناعيها(@)(@@) 4 يا أمة من سفاه لا حلوم لها ، %~% ما أنت إلا كضأن غاب راعيها(@)(@@) 5 تدعى لخير ، فلا تصغى له أذنا ، %~% فما ينادي لغير الشر داعيها(@)PageV01P1781(@)(@@) البحر : بسيط تام(@)(@@) 1 عجبت للظبي ، بانت عنه صاحبة ، %~% لاقت جنود منايا لا تناخيها(@)(@@) 2 فارتاع يوما ويوما ثم ثالثة ، %~% ومال بعد إلى أخرى يواخيها(@)(@@) 3 ما شد صرف زمان عقدة لأذى ، %~% إلا ومر لياليه يراخيها(@)PageV01P1782(@)(@@) البحر : بسيط تام(@)(@@) 1 إني لمن آل حواء ، الذين هم %~% ثقل على الأرض ، غانيها وعافيها(@)(@@) 2 جاروا على حيوان البر ، ثم عدوا %~% إلى البحار فغال الصيد ما فيها(@)(@@) 3 لم يقنع الحي منها من تقنصه %~% حتى أجاز أناس أكل طافيها(@)(@@) 4 كم درة قصدوها في موطنها %~% لعل كفا ، بمقدار ، توافيها(@)(@@) 5 فاستخدموا اللجة الخضراء ، تحملهم %~% سفائن ، بين أمواج تنافيها(@)(@@) 6 والطير جمعاء : ضعفاها وجارحها ، %~% حتى العقاب ، التي حدت أشافيها(@)(@@) 7 ينافقون ، وما جر النفاق لهم %~% خيرا ، فعثرتهم معي تلافيها(@)(@@) 8 إن الظواهر لم تشبه بواطنها %~% مثل القوادم خانتها خوافيها(@)(@@) 9 دنياك توجد أيام السرور بها %~% مثل القصيدة لم تذكر قوافيها(@)(@@) 10 وما وفت لخليل في معاشرة %~% ولا طمعنا لخل في توافيها PageV01P1783(@)(@@) 11 أم لنا ، ما فتئنا عائبين لها ، %~% فاشتط لاح لحاها في تجافيها(@)(@@) 12 ومن يطيق ورود الآجنات بها ، %~% وقد تشرق تارات بصافيها(@)(@@) 13 والنفس هشت إلى آس يطببها %~% ولم تهش إلى رب يعافيها(@)(@@) 14 حلت بدار ، فظنت أنها وطن %~% لها ، ومالك تلك الدار نافيها(@)(@@) 15 آمالنا في الثريا ، من تطاولها ، %~% وحلمنا في رياح طاش هافيها(@)(@@) 16 تقل أجسامنا الغبراء ، ثم إلى %~% بلى 
ms386	 تصير ، فتسفيها سوافيها(@)(@@) 17 فيا بني آدم الأعمار ويبكم %~% نفوسكم لم تمكن من تصافيها(@)(@@) 18 سرتم على الماء في الحاجات آونة %~% أما كفاكم سير في فيافيها(@)(@@) 19 تخاذل الناس فارتاحت عداتهم %~% إن المعاشر يرديها تقافيها(@)(@@) 20 والنفس لم يلف عنها مغنيا بدل %~% إن المراجل نصتها أثافيها PageV01P1784(@)(@@) 21 يعرى الكريم فيعرى بعد مذهبة %~% صفراء ، لا يهجر الصحراء ضافيها(@)(@@) 22 رحل على ناقة عفراء من عمر ، %~% فكم سريت وما سوطي بزافيها(@)(@@) 23 وما علافيها إلا يجد لها %~% ذما على في أو ذما على فيها(@)(@@) 24 هذي الحياة ، إذا ما الدهر خرقها ، %~% فما بنان أخي صنع يرافيها(@)(@@) 25 والموت داء البرايا لا يفارقها %~% وما تؤمل أن الله شافيها(@)(@@) 26 وليس فارسها إلا كراجلها ، %~% وقد يرى محتذيها مثل حافيها(@)PageV01P1785(@)(@@) البحر : بسيط تام(@)(@@) 1 كم حاول الرجل الدنيا بقوته %~% وماله ، فخطته ، أو تخطاها(@)(@@) 2 وقد يروم ضعيف نيل آخرة %~% فلا يشك لبيب أن سيعطاها(@)(@@) 3 والموت يعدو على الآساد ، مخدرة ، %~% والعين بين خزاماها وأرطاها(@)(@@) 4 وذات قرطين في حلي تعدهما %~% قد صار أجرا لذات الغسل قرطاها(@)PageV01P1786(@)(@@) البحر : -(@)(@@) 1 دنيا الفتى هذه عدو ، %~% تفريه عمدا بمنصليها(@)(@@) 2 غناه فيها ، عن الغواني ، %~% أجمل من فقره إليها(@)(@@) 3 وصبره في الشباب عنها %~% أيسر من صبره عليها(@)PageV01P1787(@)(@@) البحر : وافر تام(@)(@@) 1 إذا ابتكرت إلى العراف فاعرف %~% مكان عصا تصك بها قراها(@)(@@) 2 وساورها ، إذا أبدت سوارا ، %~% وبارئها متى كشفت براها(@)(@@) 3 وحذرها المنجم فهو ذئب %~% تشوقه الضوائن أن يراها(@)(@@) 4 فإن هي لم تجبه إلى قبيح ، %~% تحلبها المنافع ، وامتراها(@)(@@) 5 يقول لها زخارف مغريات %~% فراها الأولون أو افتراها(@)(@@) 6 وقد يجفو الكرى عنها جفونا %~% إذا ما حل في ساق كراها(@)PageV01P1788(@)(@@) البحر : وافر تام(@)(@@) 1 قران المشتري زحلا يرجى %~% لإيقاظ النواظر ، من كراها(@)(@@) 2 وهيهات البرية في ضلال ، %~% وقد فطن اللبيب لما اعتراها(@)(@@) 3 وكم رأت الفراقد والثريا %~% قبائل ثم أضحت في ثراها(@)(@@) 4 تقضى الناس جيلا بعد جيل %~% وخلفت النجوم كما تراها(@)(@@) 5 فراء الوحش وهي مسومات %~% بربات المعاطف 
ms387	 من فراها(@)(@@) 6 وما ظلم العشير ولا قراه ، %~% ظليم المقفرات ، ولا قراها(@)(@@) 7 إذا رجع الحصيف إلى حجاه ، %~% تهاون بالمذاهب وازدراها(@)(@@) 8 فخذ منها بما أداه لب %~% ولا يغمسك جهل في صراها(@)(@@) 9 وهت أديانهم من كل وجه %~% فهل عقل يشد به عراها ؟(@)(@@) 10 أتعلم جارسات في جبال ، %~% أراها قبلها سلف ، أراها PageV01P1789(@)(@@) 11 بما فيه المعاشر من فساد %~% توارى في الجوانح ، أو وراها(@)(@@) 12 فمن ساف الإماء ومن هراها ؟ %~% غدت منه المعاطس في براها(@)(@@) 13 يحط إلى الفوادر كل حين %~% منيعات الفوادر من ذراها(@)(@@) 14 وما تبقى الأراقم في حشاها %~% ولا الأسد الضراغم في شراها(@)(@@) 15 تقدم صاحب التوراة موسى %~% وأوقع في الخسار من اقتراها(@)(@@) 16 وقال رجاله : وحي أتاه ؛ %~% وقال الظالمون : بل افتراها(@)(@@) 17 أعبري تهوك في حديث %~% فباع المشكلات كما اشتراها(@)(@@) 18 وغايات بسطن إلى أمور %~% جراها الآجرون ، كما جراها(@)(@@) 19 أرى أم القرى خصت بهجر %~% وسارت نمل مكة عن قراها(@)(@@) 20 وكم سرت الرفاق إلى صلاح ، %~% فمارست الشدائد في سراها PageV01P1790(@)(@@) 21 يوافون البنية ، كل عام ، %~% ليلقوا المخزيات على قراها(@)(@@) 22 ضيوف ما قراها الله عفوا %~% ولكن من نوائبها قراها(@)(@@) 23 وما سيري إلى أحجار بيت ، %~% كؤوس الخمر تشرب في ذراها(@)(@@) 24 ولم تزل الأباطح ، منذ كانت ، %~% يدنس من فواجرها براها(@)(@@) 25 وبين يدي جميع الناس خطب %~% له نسيت مولعة غراها(@)(@@) 26 مهالك إن أجزت الخرق لآه %~% بها ، عز المهيمن إذ كراها(@)(@@) 27 تبارك من أدار بنات نعش %~% ومن برأ النعائم في حراها(@)(@@) 28 تمارى القوم في الدعوى ، وهبوا %~% إلى الدنيا ، فكلهم مراها(@)(@@) 29 وكم جمع النفائس رب مال ، %~% فلما جد مرتحلا ذراها(@)(@@) 30 تظل عيون هذا الدهر خزرا %~% تعد الماشيات وخوزراها PageV01P1791(@)(@@) 31 كتائب منسراها الليل يتلى %~% بصبح ، كيف يؤمن من سراها(@)(@@) 32 وأدواء ثوى بقراط ميتا %~% وجالينوس فاد وما دراها(@)(@@) 33 وما انفك الزمان بغير جرم ، %~% طوائفه تطيع من ادراها(@)(@@) 34 أهذي الدار ملك لابن أرض %~% بها رام المقام أم اكتراها(@)(@@) 35 على كره تيممها فألقى %~% بها 
ms388	 رحلا ، وعن سخط شراها(@)(@@) 36 وما برح الوجيف على المطايا %~% فأنت سليكها ، أو شنفراها(@)(@@) 37 إذا ما حرة هريت وسيفت ، %~% فمن ساف الدماء ومن هراها(@)(@@) 38 ونحن كأننا همل بجدب %~% عراة لا نمكن من عراها(@)(@@) 39 شبابك مثل جنح الليل ، فانظر %~% أعاد إلى الشبيبة من سراها(@)(@@) 40 وما نال الهجين من المعالي %~% إذا خطب الكريمة واستراها PageV01P1792(@)(@@) 41 أترهب هذه الغبراء نارا %~% تطبق مثل ما يهمي سراها(@)(@@) 42 فإن الله غير ملوم فعل ، %~% إذا أورى الوقود على وراها(@)PageV01P1793(@)(@@) البحر : وافر تام(@)(@@) 1 أتت خنساء مكة كالثريا %~% وخلت في المواطن فرقديها(@)(@@) 2 ولوصلت بمنزلها وصامت %~% لألفت ما تحاوله لديها(@)(@@) 3 ولكن جاءت الجمرات ترمي %~% وأبصار الغواة إلى يديها(@)(@@) 4 وليس محمد فيما أتته %~% ولا الله القدير بمحمديها(@)(@@) 5 إذا ما رامت الصلوات خود ، %~% فكن البيت أفضل مسجديها(@)(@@) 6 %~% يظن هناك أول ملحديها(@)PageV01P1794(@)(@@) البحر : خفيف تام(@)(@@) 1 كيف يصفو المقيم في أم دفر %~% وهو من كل وجهة يصطفيها(@)(@@) 2 من ديار قد جاءها القادم %~% الآتي ، فلم يعتبر بمنصرفيها(@)(@@) 3 واختلاف ، من الشؤون ، على %~% أن السجايا تضم مختلفيها(@)(@@) 4 وبزاة الأنيس تختطف الل %~% اللذات لو سلمت لمختطفيها(@)(@@) 5 عربي يسعى إلى الجارة الدنيا %~% يا ، فيدعى لما جناه سفيها(@)(@@) 6 وترى الكاسكي يختار عرسا ، %~% من سوى القرية التي هو فيها(@)PageV01P1795(@)(@@) البحر : طويل(@)(@@) 1 تفقهت في الدنيا ، فلم تلف طائلا ، %~% ولا خير في كسب أتاك من الفقه(@)(@@) 2 وإن تشرب الصهباء تعقبك شهوة ، %~% ولكن من الموت الشراب الذي يقهي(@)PageV01P1796(@)(@@) البحر : طويل(@)(@@) 1 وجدت سجايا الفضل في الناس غربة %~% وأعدم هذا الدهر مغتربيه(@)(@@) 2 وإن الفتى ، فيما أرى ، بزمانه %~% لأشبه منه شيمة بأبيه(@)(@@) 3 ووالدنا هذا التراب ، ولم يزل %~% أبر يدا من كل منتسبيه(@)(@@) 4 يؤدي إلى من فوقه رزق ربه ، %~% أمينا ، ويعطي الصون محتجبيه(@)(@@) 5 ولا شيء مثل الخير يزمع تركه %~% ويصبح مبذولا لمكتسبيه(@)(@@) 6 ويقسم حظ النفس ، شرقا ومغربا ، %~% على قدر من خامل ونبيه(@)(@@) 7 تشابهت الأشياء طبعا وصورة %~% وربك لم يسمع له بشبيه(@)PageV01P1797(@)(@@) البحر 
ms389	 : طويل(@)(@@) 1 متى ما تخالط عالم الإنس لا يزل ، %~% بسمعك وقر من مقال سفيه(@)(@@) 2 إذا ما الفتى لم يرم شخصك ، عامدا ، %~% بكفيه عن ضغن رماك بفيه(@)(@@) 3 وقد علم الله اعتقادي ، وإنني %~% أعوذ به من شر ما أنا فيه(@)PageV01P1798(@)(@@) البحر : طويل(@)(@@) 1 فتاة بغت أمرا من الدهر معجزا ، %~% وما رأيها لو مكنت بسفيه(@)(@@) 2 لتفدي عمرا ، جمة شركاؤه ، %~% بخمسين عمرا لا تشارك فيه(@)PageV01P1799(@)(@@) البحر : بسيط تام(@)(@@) 1 لو كان جسمك متروكا بهيئته ، %~% بعد التلاف ، طمعنا في تلافيه(@)(@@) 2 كالدن عطل من راح تكون به %~% ولم يحطم ، فعادت مرة فيه(@)(@@) 3 لكنه صار أجزاء مقسمة %~% ثم استمر هباء في سوافيه(@)PageV01P1800(@)(@@) البحر : بسيط تام(@)(@@) 1 ألغدر فينا طباع لا ترى أحدا %~% وفاؤه لك خير من توافيه(@)(@@) 2 أين الذي هو صاف لا يقال له : %~% لو أنه كان ، أو لولا كذا فيه ؟(@)(@@) 3 وتلك أوصاف من ليست جبلته %~% جبلة الإنس ، بل كل ينافيه(@)(@@) 4 ولو علمناه سرنا طالبين له ، %~% لعلنا بشفا عمرو نوافيه(@)(@@) 5 والدهر يفقد يوما ما به كدر ، %~% ويعوز الخل باديه كخافيه(@)(@@) 6 ومن أطال خلاجا في مودته ، %~% فهجره لك خير من تلافيه(@)(@@) 7 ورب أسلاف قوم شانهم خلف %~% والشعر يؤتي كثيرا من قوافيه(@)(@@) 8 نعى الطبيب إلى مضنى حشاشته %~% مهلا ، طبيب ، فإن الله شافيه(@)(@@) 9 عجبت للمالك القنطار من ذهب ، %~% يبغي الزيادة ، والقيراط كافيه(@)(@@) 10 وكثرة المال ساقت للفتى أشرا ، %~% كالذيل عثر عند المشي ضافيه PageV01P1801(@)(@@) 11 لقد عرفتك عصرا موقدا لهبا %~% من الشبيبة ، لم تنضب أنافيه(@)(@@) 12 والشيخ يحزن من في الشرخ يعهده %~% كأنه الربع هاج الشوق عافيه(@)(@@) 13 ومسكن الروح في الجثمان أسقمه ، %~% وبينها عنه من سقم يعافيه(@)(@@) 14 وما يحس ، إذا ما عاد متصلا %~% بالترب تسفيه في الهابي سوافيه(@)(@@) 15 فما يبالي أديم وهي جانبه %~% ولا يراع ، إذا حدت أشافيه(@)(@@) 16 وحبذا الأرض قفرا ، لا يحل بها %~% ضد تعاديه أو خلم تصاميه(@)(@@) 17 وما حمدت كبيرا في تحدبه ؛ %~% ولا عذلت صغيرا في تجافيه(@)(@@) 18 جنى أب وضع 
ms390	 ابنا لألذى غرضا %~% إن عق ، فهو على جرم يكافيه(@)PageV01P1802(@)(@@) البحر : بسيط تام(@)(@@) 1 أكرم بياضك عن خطر يسوده ، %~% وازجر يمينك عن شيب تنقيه(@)(@@) 2 لقيته بجلاء عن منازله ، %~% وليس يحسن هذا من تلقيه(@)(@@) 3 ألا تفكرت قبل النسل في زمن %~% به حللت ، فتدري أين تلقيه ؟(@)(@@) 4 ترجو له من نعيم الدهر ممتنعا ، %~% وما علمت بأن العيش يشقيه(@)(@@) 5 شكا الأذى فسهرت الليل ، وابتكرت %~% به الفتاة إلى شمطاء ترقيه(@)(@@) 6 وأمه تسأل العراف قاضية %~% عنه النذور ، لعل الله يبقيه(@)(@@) 7 وأنت أرشد منها حين تحمله %~% إلى الطبيب ، يداويه ويسقيه(@)(@@) 8 ولو رقى الطفل عيسى ، أو اعيد له %~% بقراط ، ما كان من موت يوقيه(@)(@@) 9 والحي في العمر مثل الغر يرقا في %~% سور العدى وإلى حتف ترقيه(@)(@@) 10 دنست عرضك ، حتى ما ترى دنسا ، %~% لكن قميصك ، للأبصار ، تنقيه(@)PageV01P1803(@)(@@) البحر : بسيط تام(@)(@@) 1 لا تحلفن على صدق ولا كذب %~% فإن أبيت فعد الحلف بالله(@)(@@) 2 أو يقو ، فهي له كحرة عاقل %~% حسناء يهواها ولا تهويه(@)(@@) 2 فقد أشرت إلى معنى له نبأ ، %~% وافى العقول بإعجاز وإيلاه(@)(@@) 3 يخاف كل رشيد من عقوبته %~% وإن تلفع ثوب الغافل اللاهي(@)PageV01P1804(@)(@@) البحر : سريع(@)(@@) 1 عنسي في الدنيا سوى الراهي ، %~% طلقتها تطليق إكراه(@)(@@) 2 والجد أبراها لمن راضها ، %~% فانهض إلى عنسك إبراه(@)(@@) 3 وإنما نحن أسارى بها %~% وسوف تودي بالأسارى هي(@)PageV01P1805(@)(@@) البحر : خفيف تام(@)(@@) 1 لن تريه إن كنت لما تريه %~% ثابتا خاتماه في خنصريه(@)(@@) 2 لم يجد عند أكبريه سموا ، %~% فاعترى فضله إلى أصغريه(@)(@@) 3 ظل يستخبر النجوم عن الغي %~% ب ، فجاء اليقين من خبريه(@)(@@) 4 قد مضت أربعون عنه بلا %~% حمد ، وذاك الأجل من عمريه(@)(@@) 5 ليس من خلة الزمان على %~% شيء ، ولو بات ثالثا قمريه(@)(@@) 6 قد رآه ما بين موت وقتل ؛ %~% هل يجوز النجاء من قدريه ؟(@)PageV01P1806(@)(@@) البحر : سريع(@)(@@) 1 نضحي ونمسي كبني آدم %~% وما على الغبراء إلا سفيه(@)(@@) 2 فنسأل العالم إنقاذنا %~% من عالم السوء ، الذي نحن فيه(@)PageV01P1807(@)(@@) البحر : منسرح(@)(@@) 1 الخلق من أربع 
ms391	 مجمعة %~% نار وماء وتربة وهوا(@)(@@) 2 إن السهى والسماك ما غفلا %~% عن ذكر مولاهما ، ولا سهوا(@)(@@) 3 والنيران المواصلان سنا ، %~% إن نله في أرضنا فما لهوا(@)(@@) 4 والشمس والغيث طاهيان له ، %~% يطعم أهل البلاد ما طهوا(@)PageV01P1808(@)(@@) البحر : طويل(@)(@@) 1 لعمرك ! ما زوج الفتاة بحازم ، %~% إذا ما الندامى ، في محلته ، غنوا(@)(@@) 2 أتى بيته بالراح والشرب ، لاهيا ، %~% فإما زنوا شطر الظعينة أو زنوا(@)(@@) 3 رآهم على ما يكره الناس ربهم %~% وعذت به مما تمنوا وما منوا(@)(@@) 4 وددت بعلم الله أن صحابتي %~% على كل حال أفردوني ، فما ثنوا(@)(@@) 5 إذا كان سكان البلاد كما هم %~% فلا تحفلن إن صغروا اسمك أو كنوا(@)(@@) 6 ينافس في الدنيا الخسيسة جاهل %~% رويدك يذهب عنك عارض هذا النو(@)(@@) 7 يسير عن الأرض الرحيبة أهلها %~% ويترك ما شادوا ، هناك ، وما بنوا(@)PageV01P1809(@)(@@) البحر : منسرح(@)(@@) 1 تسوقوا بالغنا لربهم ، %~% وأظهروا خيفة له ودعوا(@)(@@) 2 سعوا لدنياهم بآخرة %~% فبئس ما حاولوا غداة سعوا(@)(@@) 3 وخلفوا العقل من ورائهم ، %~% واستودعوا كل سوءة ، فرعوا(@)(@@) 4 ولم يعوا ما يقول واعظهم ، %~% لكن لقيل المحرضين وعوا(@)(@@) 5 مثل تيوس المعيز نازية %~% ولم يضاهوا الفحول حين قعوا(@)PageV01P1810(@)(@@) البحر : وافر تام(@)(@@) 1 تدين ، مغربي بانتحال ، %~% وعارض بالتنحل مشرقي(@)(@@) 2 فصمتا ، إن أردتم ، أو مقالا ، %~% فما في هذه الدنيا تقي(@)(@@) 3 نقاء لباسنا فيها كثير ، %~% وليس لأهلها عرض نقي(@)(@@) 4 %~% فمثل هبوطه ذاك الرقي(@)(@@) 5 وأعوزنا بياض العيش فيها ، %~% ولم يعوز بياض مفرقي(@)(@@) 11 وإن يلحق بك البكري غدرا %~% وإن رقي الفتى رتب المعالي ،(@)PageV01P1811(@)(@@) البحر : خفيف تام(@)(@@) 1 صفري من بعده رجبي ، %~% فانظرن أين جاد ذاك الحبي(@)(@@) 2 زعمت أن نارها ما خبت فا %~% رس ، والدهر فيه معنى خبي(@)(@@) 3 نام عنا ربينا ، وهلاك ال %~% ركب يخشى ، إن نام عنه الربي(@)(@@) 4 علم الكائنات في كل وجه %~% أول عنده السماك صبي(@)(@@) 5 خالق النيرات ما يتغابى العبد %~% لكنه ضعيف غبي(@)(@@) 6 أيها الغر ، إن خصصت بعقل ، %~% فاسألنه فكل عقل نبي(@)(@@) 7 حلبوا درة الكؤوس ، وألغوا %~% ما 
ms392	 رواه الكرخي والحلبي(@)(@@) 8 وشرابي ماء قراح ، وحسبي %~% لا يهنأ شرابك العنبي(@)(@@) 9 وكفاني ، مما يعب ، لجين %~% ي ، إذا عب صرفك الذهبي(@)(@@) 10 فتنتك السبيتان فبيضاء %~% ء وحمراء ، من كروم سبي PageV01P1812(@)(@@) 11 جلبت هذه بسمر ، وهاتي %~% بصفر لها أب لهبي(@)(@@) 12 قدر غالب ، وأمر قديم ، %~% يتضاهى ذليله والأبي(@)(@@) 13 واختلاف من عنصر ذي اتفاق ، %~% وتساوى الزنجي والعربي(@)(@@) 14 غركم بالخلاف أصفر قيس %~% برهة ثم أصفر ثعلبي(@)PageV01P1813(@)(@@) البحر : طويل(@)(@@) 1 لعمري ! لقد بعنا الفناء نفوسنا ، %~% بلا عوض عند البياع ولا ثنيا(@)(@@) 2 ولو بين دنيانا الدنية خيرت %~% وبين سواها ما أرادت سوى الدنيا(@)PageV01P1814(@)(@@) البحر : بسيط تام(@)(@@) 1 ساء بريا ، من البرايا ، %~% من لبس الدين سابريا(@)(@@) 2 إن كسرتني يد المنايا ، %~% فما الأطباء جابريا(@)(@@) 3 أمرت بالغدر أم دفر %~% ولم أطع فيك آمريا(@)(@@) 4 عبرت ، في عيشة ، مضيقا ، %~% فليوسع الحفر قابريا(@)(@@) 5 مفازة ما الضباب فيها ، %~% إلا عقيل بخافريا(@)(@@) 6 ما أحوجتني إلى ورود ، %~% لما سقتني الحمام ريا(@)(@@) 7 قد خبر الله من ضميري %~% ما لم يكن عند خامريا(@)(@@) 8 ولم يطل سامري حديثي ، %~% بل عشت في الدهر سامريا(@)(@@) 9 لو علم العازلون سري %~% لأصبح القوم عاذريا(@)(@@) 10 يا أمتي اتقوا شرورا %~% مني ، وبيتوا محاذريا PageV01P1815(@)(@@) 11 قامرة كلنا الليالي ، %~% فما أبالي بقامريا(@)(@@) 12 وارتني الأرض فاهجروني %~% لا يرهب العتب هاجريا(@)(@@) 13 هل كره القرب من عظامي ، %~% أعظم قوم مجاوريا(@)(@@) 14 ما بهشوا بالسلام نحوي %~% ولا أراهم محاوريا(@)(@@) 15 غنيت عن زائر ملم ، %~% فليشغل الخير زائريا(@)(@@) 16 أزايل الملك آل كسرى %~% وصار بالشام عامريا ؟(@)PageV01P1816(@)(@@) البحر : -(@)(@@) 1 قد خف جرمي وصار جرمي %~% أثقل من هضبة عليا(@)(@@) 2 نفسي أولى بما عناها ، %~% من هؤلاء وهؤليا(@)(@@) 3 لولا تقضي الشباب عني %~% عصيت في الغي عاذليا(@)(@@) 4 فهل تراني أكون برا %~% لو رد عصر الصبا إليا ؟(@)(@@) 5 إياك والخود إذ تجلى %~% ملبسة جيدها حليا(@)(@@) 6 كأنها ظبية خذول %~% مرضعة بالضحى طليا(@)(@@) 7 يا هند كوني مع الهوافي ؛ %~% وجانبي الخفض يا عليا(@)PageV01P1817(@)(@@) البحر : وافر تام(@)(@@) 1 لقد أمنتني 
ms393	 الأدماء أضحت %~% تراعي في مراتعها طليا(@)(@@) 2 بعدت من الأصادق والأعادي %~% فما أنا من ألاك ولا أليا(@)(@@) 3 دعا لي بالحياة أخو وداد %~% رويدك إنما تدعو عليا(@)(@@) 4 وما كان البقاء لي اختيارا %~% لو ان الأمر مردود إليا(@)PageV01P1818(@)(@@) البحر : وافر تام(@)(@@) 1 تروم شفاء ما الأقوام فيه ، %~% رويدك إن داء القوم أعيا(@)(@@) 2 فحاذر عقربا غشيتك لسبا ، %~% وأم أراقم وافتك سعيا(@)(@@) 3 وألقت هذه الأيام علما %~% إليك ، فلم تصادف منك وعيا(@)(@@) 4 ودينك ما علي الحكم فيه ، %~% فأبغي للذي أخفيت بغيا(@)(@@) 5 إذا الإنسان كف الشر عني ، %~% فسقيا في الحياة له ورعيا(@)(@@) 6 ويدرس إن أراد كتاب موسى %~% ويضمر ، إن أحب ولاء شعيا(@)PageV01P1819(@)(@@) البحر : مجزوء الكامل(@)(@@) 1 كل امرئ يضحي مريا %~% والدهر لا يبقي سريا(@)(@@) 2 فترو من هذي الحياة %~% لكي تموت النفس ريا(@)(@@) 3 ما للثريا قيمة ، %~% عند الذي خلق الثريا(@)(@@) 4 صار الأمير أبا مري %~% ثم أورثها مريا(@)(@@) 5 والحي ، للنكبات ، يس %~% تقري ، ويرجع للقريا(@)(@@) 6 ما عريت مما يخاف %~% ف عمايتان ، ولا عريا(@)PageV01P1820(@)(@@) البحر : -(@)(@@) 1 أصبحت ألحى خلتيا ، %~% هاتيك أبغضها وتيا(@)(@@) 2 ودعيت شيخا ، بعدما %~% سميت ، في زمن ، فتيا(@)(@@) 3 وكفيت صحبي إلتيا ، %~% بعد اللتيا واللتيا(@)(@@) 4 سقيا لأيام الشباب %~% وما حسرت مطيتيا(@)(@@) 5 أيام آمل أن أمس %~% الفرقدين براحتيا(@)(@@) 6 وأفيض إحساني على %~% جاري ، ثم ، وجارتيا(@)(@@) 7 فالآن تعجز همتي %~% عما ينال بخطوتيا(@)(@@) 8 أوصى ابنتيه لبيد %~% الماضي ، ولا أوصي ابنتيا(@)(@@) 9 والله يرحمني إذا %~% أودعت أضيق ساحتيا(@)(@@) 10 لا تجعلن حالي إذا %~% غيبت أيأس حالتيا PageV01P1821(@)(@@) 11 لست المفاخر في الرجا %~% ل ، بعمتي وخالتيا(@)(@@) 12 لكن أقر بأنني %~% ضرع ، أمارس دارتيا(@)PageV01P1822(@)(@@) البحر : سريع(@)(@@) 1 ما بالها ناوية شقة %~% تودي بشخص الناقة الناويه(@)(@@) 2 لم تأو للعيس ، ولا بد من %~% قبر إليه أوت الآويه(@)(@@) 3 وتقدم الأرض نفوس أتت %~% مخلوقة من أنفس تاويه(@)(@@) 4 والدهر كالحيوت والحوت في %~% إهلاكه ما حوت الحاويه(@)(@@) 5 إن تعمر الدار فلا بد من %~% يوم ردى يتركها خاويه(@)(@@) 6 فاهرب من الإنس 
ms394	 إلى الوحش كي %~% تسكن بالدوية الداويه(@)(@@) 7 إن يسمعوا شرا توافوا له %~% حفظا ، ومثل الشاعر الراويه(@)(@@) 8 ما أنفع السيف لمن شامه %~% أخضر ، ما روضته ذاويه(@)(@@) 9 ذبابه إن يشد يحدث له %~% جد يوازي لعب الغاويه(@)(@@) 10 يقتسر الدنيا لأخلافه ، %~% محتلبا أخلافها الصاويه PageV01P1823(@)(@@) 11 ألوى نبات الأرض ، وهو الذي %~% لم يلو بل ألوت به اللاويه(@)(@@) 12 هاوية نفسك ما ساءها ، %~% فلتخش أن تلقى إلى الهاويه(@)(@@) 13 من اتقى الله ، فأسد الشرى ، %~% لديه مثل ألأكلب العاويه(@)PageV01P1824(@)(@@) البحر : خفيف تام(@)(@@) 1 إرمنا يا ظلام في كل فج ، %~% فالمنى لم تزل تجر المنايا(@)(@@) 2 وحنى يائس من القرب جيدا %~% لوداع ، والعيس مثل الحنايا(@)(@@) 3 ودنا يا عذول أنا سلمنا %~% من هوانا ، ولم ندان الدنايا(@)(@@) 4 إن جهلا سلمي لآل سليمى ، %~% وثنائي على عذاب الثنايا(@)PageV01P1825(@)(@@) البحر : -(@)(@@) 1 ليس يبقى الضرب الطويل على الدهر ، %~% ولا ذو العبالة الدرحايه(@)(@@) 2 يا أبا القاسم ، الوزير ، ترحلت %~% وخلفتني ثفال رحايه(@)(@@) 3 وتركت الكتب الثمينة للناس %~% س ، وما رحت عنهم بسحايه(@)(@@) 4 ليتني كنت قبل أن تشرب الموت %~% أصيلا شربته في ضحايه(@)(@@) 5 إن نحتك المنون قبلي فإني %~% منتحاها ، وإنها منتحايه(@)(@@) 6 أم دفر تقول ، بعدك ، للذا %~% لا طعم لي فأين فحايه(@)(@@) 7 إن يخط الذنب اليسير حفيظاك %~% ك ، فكم من فضيلة محايه(@)PageV01P1826(@)(@@) البحر : -(@)(@@) 1 مجوسية وحنيفية %~% ونصرانة ويهوديه(@)(@@) 2 نفوس تخالف أديانها %~% وليست من الموت بمفديه(@)(@@) 3 تراقب مهديا أن يقوم ، %~% لتلقى إلى الحق مهديه(@)(@@) 4 فيا سعد ! كم خرجت ظبية %~% ترود بخضراء سعديه(@)(@@) 5 وتمسي من الردى مرديه(@)(@@) 6 لقد كان أبدى إليها الزما %~% ن ، ثم هي الآن مبديه(@)(@@) 7 ويا هند ما عصمت أهلها %~% قواضب في الضرب هنديه(@)(@@) 8 ولا ورد غاب له حلة %~% من الدم في الغيل ورديه(@)(@@) 10 تشبه بعض ببعض ، فما %~% تزال الشمائل قرديه(@)(@@) 11 قد امتزج العالم الآدمي %~% فغورية مع نجديه PageV01P1827(@)(@@) 12 وأم النميري تركية ؛ %~% وأم العقيلي صغديه(@)(@@) 13 وزوج الكلابية الكاسكي %~% وعرس الكلابي كرديه(@)PageV01P1828(@)(@@) البحر : طويل(@)(@@) 1 أليس أبوكم آدم إن 
ms395	 عزيتم %~% يكون سليلا للتراب إذا عزي(@)(@@) 2 يود الفتى لو عاش آخر دهره %~% سليما مؤتى ، لا أميت ولا رزي(@)(@@) 3 أنام ، لعمري ، ليس فيه موفق %~% لرشد ، فلا يحظى بخير متى حزي(@)(@@) 4 وباز يغادي الطير مهتضما لها ، %~% فهل يرتجي النصف الضعيف إذا بزي(@)(@@) 5 وجدت سفيه الإنس في سوء رأيه %~% إذا قيل : خف من قادر فوقنا هزي(@)(@@) 6 وردنا إلى الدنيا بإذن مليكنا %~% لمغزى ، ولسنا عالمين بما غزي(@)(@@) 7 ذوو النسك خير الناس في كل موطن ، %~% وزيهم بين المعاشر خير زي(@)(@@) 8 وهل ينفع الوشي السحيب مضللا %~% وإن ذكرت في القوم شيمته خزي(@)(@@) 9 ومن عجب دعواك علما وحكمة ، %~% وعلمك شيء قيل بالظن أو حزي(@)(@@) 10 وجئت بنمي إلى متعصب ، %~% فناداك دينار بكفك هبرزي(@)PageV01P1829(@)(@@) البحر : وافر تام(@)(@@) 1 تولي يا خبيثة ، لا هلمي ، %~% أقول ، إذا نأيت ، ولا تعالي(@)(@@) 2 وإما كنت يا نوبي ولاء ، %~% فإني لا أحاذر أن توالي(@)(@@) 3 تغالى القوم في طلب المعالي %~% فيا قمرا بذي كلاء تغالي(@)(@@) 4 ولو أوتيت ، في الأيام ، لبا %~% تقارضت الوداد ولم تقالي(@)PageV01P1830(@)(@@) البحر : سريع(@)(@@) 1 الدهر لا تأمنه لقوة ، %~% ترزق أفراخا لها بالسلي(@)(@@) 2 تضحي الثعالي خائفات لها %~% وتذعر الخشف وأم الطلي(@)(@@) 3 إن يرحل الناس ولم أرتحل %~% فعن قضاء لم يفوض إلي(@)(@@) 4 خلفت من بعد رجال مضوا %~% وذاك شر لي ، وشر علي(@)PageV01P1831(@)(@@) 
