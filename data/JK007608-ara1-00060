ms41	 % % 36(@)(@@) % إذا قطعت به شأوأ بلاها % % بأبعد غاية وأمد قابا % % 37(@)(@@) % تجاوزه المقاول وهو باق % % يبذ رقاب غلبهم غلابا % % 38(@)(@@) % كنصل السيف تسلم شفرتاه % ويخلق كل أيام قرابا % % 39(@)(@@) % اذا اشتجر القنا فصل الهوادي % % وإن قر الوغى فصل الخطابا % % 40(@)(@@) % بلى وبلت يداه من الأعادي % % أراقم نزعا وقنا صلابا % % PageV01P133 41(@)(@@) % فقوم بالأذى منها صعادا % وذلل بالرقي منها صعابا % % 42(@)(@@) % وغادر كل أرقم ذي طلوع % على الاعداء يدرع الترابا % % 43(@)(@@) % حذار بني الضغائن من جري % % اذا ما الريب بادهه ارابا % % 44(@)(@@) % يعض على لواحظ أفعوان % فان سيم الاذى طلب الوثابا % % 45(@)(@@) % وإن وراء ذاك الحلم صولا % وان لتلكم البقيا عقابا % % 46(@)(@@) % ولو أن الضراغم نابذته % تولج خلفها أجما وغابا % % 47(@)(@@) % رماكم بالضوامر مقربات % % يزاولن المحاني والشعابا % % 48(@)(@@) % ويعجلن الصريخ وهن زور % % إلى الأعداء يرسلن اللعابا % % 49(@)(@@) % فارعى من جماجمكم جميعا % وامطر من دماءكم سحابا % % 50(@)(@@) % لك الهمم التاي عرف الاعادي % % تشب بكل مظلمة شهابا % % PageV01P134 51(@)(@@) % اذا خفقت رياح العزم فيها % % تبلج عارض منها ، فصابا % % 52(@)(@@) % ومشرعة الأسنة ذات جرس % يقود عقاب رايتها العقابا % % 53(@)(@@) % تخوض الليل يلمع جانباها % % كأن الصبح قد حدر النقابا % % 54(@)(@@) % لها في فرجة الفجر اختلاط % % يرد الصبح من رهج غيابا % % 55(@)(@@) % وتغدو كالكواكب لامعات % تمزق من عجاجتها الحجابا % % 56(@)(@@) % يصافحها شعاع الشمس حتى % % كأن على الظبى ذهبا مذابا % % 57(@)(@@) % صدمت بها العدو ، وأنت تدعو % % نزال ، فأي داعية أجابا % % 58(@)(@@) % وقوضت الخيام تذب عنها % % أسود وغى ، وأصفرت الوطابا % % 59(@)(@@) % رأينا الطايع الميمون بدءا % يسلك في النوائب ، واعتقابا % % 60(@)(@@) % ولما جرت البيض المواضي % % رآك من الظبي امضى ذبابا % % PageV01P135 61(@)(@@) % فالحمك العدى حتى تهاووا % % ولا دمنا تحس ولا ضبابا % % 62(@)(@@) % هناك قدوم اعياد طراق % % تصوب العز ما وجدت مصابا % % 63(@)(@@) % وايام تجوز عليك بيض % % وقد قرعت من الإقبال بابا % % 64(@)(@@) % فكم يوم كيومك قدت فيه % % على الغرر ، المقانب والركابا % % 65(@)(@@) % إلى البلد الامين مقومات % % يماطلها التعجل والإيابا % % 66(@)(@@) % بحيث تفرغ الكوم المطايا % % حقائبها وتحتقب الثوابا % % 67(@)(@@) % معالم إن أجال الطرف 
ms42	 فيها % % مصر القوم أقلع ، أو أنابا % % 68(@)(@@) % ففزت بها ثماني معلمات % نصرت بها النبوة والكتابا % % 69(@)(@@) % بعثت لك الثناء على صنيع % إذا ما هبت دعوته أهابا % % 70(@)(@@) % رغائب قد قطعن حنين عيس % فلا نأيا اريغ ولا اغترابا % % PageV01P136 71(@)(@@) % وقبل اليوم ما أغمدن عني % % من الايام نائبة ونابا % % PageV01P137 البحر : بسيط تام 1(@)(@@) % لكل مجتهد حظ من الطلب % فاسبق بعزمك سير الانجم الشهب % % 2(@)(@@) % وارق المعالي التي اوفى ابوك بها % % فكم تناولها قوم بغير أب % 3(@)(@@) % ولا تجز بصروف الدهر في عصب % من القرائن غير السمر والقضب % % 4(@)(@@) % ندعوك في سنة شابت ذوائبها % % حتى تفرجها مسودة القصب % 5(@)(@@) % ولم تزل خدعات الدهر تطرقها % % حتى تعانق عود النبع والغرب % % 6(@)(@@) % اتيت تحتلب الايام اشطرها % % فكل حادثة منزوحة الحلب % % 7(@)(@@) % لولا وقارك في نصل سطوت به % % فاضت مضاربه من خفة الطرب % 8(@)(@@) % وحسن رأيك في الأرماح ينهضها % % إلى الطعان ، ولولا ذاك لم تثب % 9(@)(@@) % كن كيف شئت فان المجد محتمل % % عنك المغافر في بدء وفي عقب % 10(@)(@@) % ما زال بشرك في الأزمان يؤنسها % % حتى أضاءت سرورا أوجه الحقب % PageV01P138 11(@)(@@) % يفديك كل بخيل مات خاطره % فان خطرت عددناه من الغيب % % 12(@)(@@) % إذا المطامع حامت حول موعده % انت اليه انين المدنف الوصب % % 13(@)(@@) % وعصبة جاذبوك العز فانقبضت % % اكفهم عنم دراك المجد بالطلب % % 14(@)(@@) % شابهتهم منظرا اوفتهم خبرا % إن الرديني معدود من القصب % 15(@)(@@) % هابوا ابتسامك في دهياء مظلمة % % وليس يوصف ثغر الليث بالشنب % % 16(@)(@@) % سجية لك فاتت كل منزلة % % وضعضعت جنبات الحادث الأشب % 17(@)(@@) % نسيمها من طباع الروض مسترق % % وطيب لذتها من شيمة الضرب % 18(@)(@@) % تلقى الخميس إذا اسودت جوانبه % % بالمستنيرين من رأي وذي شطب % 19(@)(@@) % ونثرة فوقها صبر تظاهره % أرد منها لأذراب القنا السلب % 20(@)(@@) % لو لم يعوضك هجر العيش صالحة % % ما كنت تخرج من أثوابه القشب % PageV01P139 21(@)(@@) % يا ابن الذين ، إذا عدوا فضائلهم % عد الندى ضربهم في هامة النشب % % 22(@)(@@) % بألسن راضة لقول لو نضيت % % نابت عن السمر في الابدان والحجب % % 23(@)(@@) % لا يستثيرون 
ms43	 الاكل منصلت % % حامي الحقيقة طلاع على النقب % 24(@)(@@) % ذي عزمة إن دعاها الروع منتصرا % تلفتت عن غرار الصارم الخشب % 25(@)(@@) % يقرون حتى لو ان الضيف فاتهم % حثوا اليه صدور الاينق النجب % % 26(@)(@@) % أو أعوز الخطب في ليل بيوتهم % مدوا يد النار في الأعماد والطنب % 27(@)(@@) % لو أن بأسهم جارى الزمان إذا % لارتد عن شأوه مسترخي اللبب % 28(@)(@@) % إن أوردوا الماء لم تنهل جيادهم % حتى تعل برقراق الدم السرب % % 29(@)(@@) % قادوا السوابق محفاة مقودة % % كأنها بحثت عن مضمر الترب % 30(@)(@@) % اعطافها بالقنا الخطى مثقلة % % تكاد تعصف بالساحات والرحب % PageV01P140 31(@)(@@) % ما انفك يطعن في اعقاب حافلة % % بذابل من دم الاقران مختضب % % 32(@)(@@) % إذا امترى علق الأوداج عامله % اعشى العوالي فلم تنظر إلى سلب % % 33(@)(@@) % ولا يزال يجلي نقع قسطله % % بمحرج الغرب ملآن من الغضب % % 34(@)(@@) % إذا انتضاه ليوم الروع تحسبه % يسل من غمده خيطا من الذهب % % 35(@)(@@) % أو إن أشاح به سال الحمام له % في مضربيه فلم يرقأ ولم يصب % % 36(@)(@@) % جذلان يركع ان مال الضراب به % % مطربا في قباب البيض واليلب % 37(@)(@@) % يا أيها الندب إن السعد متضح % بطلقة الوجه جلت سدفة الريب % 38(@)(@@) % مولودة سقطت عن حجر والدة % جاءت بها ملء حجر المجد والحسب % % 39(@)(@@) % لما ظمئت إليها قبل رؤيتها % % أعطيت لذة ماء الورد بالقرب % 40(@)(@@) % باشر بطلعتها العلياء مقتبلا % فانها درة في حلية النسب % % PageV01P141 41(@)(@@) % واسعد بها واشكر الاقدار ان حملت % % اليك قرة عين العجم والعرب % % 42(@)(@@) % وحث خيل كؤوس العز جامحة % % إلى السرور بخيل اللهو واللعب % 43(@)(@@) % وانثر على الشرب سمطا من فواقعها % % وابن الغمام مسمى بابنة العنب % 44(@)(@@) % واصدم بكاسك صدر الدهر معتقلا % % بصارم اللهو يجلو قسطل الكرب % 45(@)(@@) % كاس اذا خضبت بالماء لمتها % % شابت وان زل عنها الماء لم تشب % % 46(@)(@@) % نفسي تقيك فكم وقيتني بيد % % وقد ألظ بي الرامون عن كثب % 47(@)(@@) % اذا اتقيت بك الاعداء رامية % % فواجب أن أوقيك النوائب بي % % 48(@)(@@) % أبا الحسين أعر شعري إصاخة من % % يروى مسامعه عن مسمع عجب % % 49 
ms44	(@)(@@) % إذا مدحتك لم أمتن عليك به % فالمدح باسمك والمعنى به نسبي % % PageV01P142 البحر : وافر تام 1(@)(@@) % الان جوانبي غمز الخطوب % % وأعجلني الزمان إلى المشيب % 2(@)(@@) % وكم يبقى على عجم الليالي % % وقرع الدهر جايرة الكعوب % % 3(@)(@@) % نبا ظهر الزمان وكنت منه % % على جنبي موقعة ركوب % 4(@)(@@) % وقالوا : الشيب زار ، فقلت : أهلا % بنور ذوائب الغصن الرطيب % 5(@)(@@) % ولم آك قبل وسمك لي محبا % فيبعد بي بياضك من حبيب % % 6(@)(@@) % ولا ستر الشباب علي عيبا % % فأجزع أن ينم على عيوبي % % 7(@)(@@) % ولم اذمم طلوعك بي لشيء % سوى قرب الطلوع إلى شعوب % 8(@)(@@) % واعظم ما الاقي ان دهري % % يعد محاسني لي من ذنوبي % % 9(@)(@@) % أقول إذا امتلأت أسى لنفسي : % أيا نفس اصبري أبدا وطيبي % % 10(@)(@@) % دعى خوض الظلام بكل ارض % % وإعمال النجيبة والنجيب % PageV01P143 11(@)(@@) % وجر ضوامر الاحشاء تجري % % كما تهوى الدلاء إلى القليب % % 12(@)(@@) % مترفة إلى الغايات حتى % % ترنح في الشكيم من اللغوب % % 13(@)(@@) % فليس الحظ للبطل المحامي % % ولا الاقبال للرجل المهيب % % 14(@)(@@) % ونيل الرزق يؤخذ من بعيد % كنيل الرزق يؤخذ من قريب % 15(@)(@@) % وغاية راكبي خطط المعالي % % كغاية من اقام عن الركوب % % 16(@)(@@) % اليس الدهر يجمعنا جميعا % على مرعى من الحدثان موبي % % 17(@)(@@) % كلانا تضرب الأيام فيه % بجرح من نوائبها رغيب % % 18(@)(@@) % ارى برد العفاف اغض حسنا % على رجل من البرد القشيب % % 19(@)(@@) % علي سداد نبلي يوم ارمي % % ورب النبل أعلم بالمصيب % 20(@)(@@) % ولي حث الركاب وشد رحلي % % وما لي علم غامضة الغيوب % PageV01P144 21(@)(@@) % وما يغني مضيك في صعود % % إذا ما كان جدك في صبوب % 22(@)(@@) % تطأطأت الذوائب للذنابى % % وأسجدت الموارن للعجوب % 23(@)(@@) % وخرق كالسماء خرجت منه % بجري أقب يركع في السهوب % 24(@)(@@) % يجر عنانه في كل يوم % % إلى الاعداء معقود السبيب % % 25(@)(@@) % وخوص قد سريت بهن ، حتى % % تقوضت النجوم إلى الغيوب % 26(@)(@@) % وجرد قد دفعت بهن ، حتى % % وطئن على الجماجم والتريب % 27(@)(@@) % ويوم ترعد الربلات منه % كما قطع الربى عسلان ذيب % 28(@)(@@) % هتكت فروجه بالرمح لما % % دعوا باسمي ، ويا لك من مجيب % 29 
ms45	(@)(@@) % وعند تعانق الاقران يبلى % % قراع النبع بالنبع الصليب % 30(@)(@@) % اخاؤك يا علي اساغ ريقي % % وودك يا علي جلى كروبي % % PageV01P145 31(@)(@@) % فيا عوني ، إذا عدت الليالي % % علي ، ويا مجني في الحروب % 32(@)(@@) % عجبت من الانام وانت منهم % % ومثلك في الأنام من العجيب % 33(@)(@@) % علوت عليهم في كل أمر % بطول الباع والصدر الرحيب % % 34(@)(@@) % وفتهم مراحا في سفور % بلا نزق وجدا في قطوب % 35(@)(@@) % خطاب مثل ماء المزن تبرى % % مواقعه العليل من القلوب % 36(@)(@@) % وعزم ان مضيت به جريا % % هوى مطر القنا بدم صبيب % % 37(@)(@@) % وحلم إن عطفت به معيدا % أطار قوادم اليوم العصيب % 38(@)(@@) % والفاظ كما لعبت شمال % % ملاعبها على الروض الخصيب % % 39(@)(@@) % بطرف لا يخفض من خضوع % % وقلب لا يتعتع من وجيب % 40(@)(@@) % تهن بمهرجانك ، واعل فيه % إلى العلياء أعناق الخطوب % PageV01P146 41(@)(@@) % وعش صافي الغدير من الرزايا % % به خالي الأديم من الندوب % 42(@)(@@) % لعلي أن أهزك في مرام % فأبلو منك مندلق الغروب % 43(@)(@@) % وحاج في الضمير معضلات % سأسلمها إلى عزم طلوب % 44(@)(@@) % لأقضيهن ، أو أقضي بهمي % % غريب الوجه في البلد الغريب % 45(@)(@@) % منازعة إلى العلياء حتى % % أزر على ذوائبها جيوبي % % 46(@)(@@) % فإما نيل جانبها ، وإما % % لقاء مسندين على الجنوب % PageV01P147 البحر : متقارب تام 1(@)(@@) % وفى ذا السرور بتلك الكرب % وهذا المقام بذاك التعب % % 2(@)(@@) % قدمت ، فأطرق صرف الزمان % عناء واغضت عيون النوب % % 3(@)(@@) % ومثلك من قذفته الخطو % % ب في صدر كل خميس لجب % % 4(@)(@@) % قريب المراد ، بعيد المرام % عظيم العلاء جليل الحسب % % 5(@)(@@) % ومن قلقل البين اطنابه % % ونال اقاصي المنى بالطلب % % 6(@)(@@) % غدت تشتكيك كؤوس المدام % ويثنى عليك القنا والقضب % % 7(@)(@@) % وكنا نصانع فيك الهموم % % فصرنا نصانع فيك الطرب % % 8(@)(@@) % اذا ما الفتى وصل الزائري % % ن اثنوا عليه نأي أو قرب % % 9(@)(@@) % وكيف يهنيك لفظ امرىء % يهني بقربك أعلى الرتب % 10(@)(@@) % وكنا بذكرك نشفي الغليل % وما بيننا امد منشعب % % PageV01P148 11(@)(@@) % إلى أن تهلل وجه الزمان % ومن بان مثلك عنه شحب % 12(@)(@@) % رأينا بوجهك نور اليقي % % ن ، حتى خلعنا ظلام الريب % 13 
ms46	(@)(@@) % ومازلت تمسح خد الصباح % % وترحم قلب الظلام الأشب % 14(@)(@@) % بمطرورة الصدر خفاقة % % تطير مجاذيفها كالعذب % 15(@)(@@) % تعانقك الريح في صدرها % % ويشتاقك الماء حتى يثب % 16(@)(@@) % تمر بشخصك مر الجياد % وتسري برحلك سير النجب % % 17(@)(@@) % اذا اطردت بك خلت القصو % % ر ترعد بالبعد أو تحتجب % % 18(@)(@@) % يسر بها عاشق لا يلذ % ذ بالناي أو نازح يقترب % % 19(@)(@@) % وقد بلغتك الذي رمته % % وحق المبلغ أن يصطحب % 20(@)(@@) % أبا قاسم كان هذا البعاد % إلى طرق القرب اقوى سبب % % PageV01P149 21(@)(@@) % فما كنت أول بدر أتى % % ولا كنت أول نجم غرب % 22(@)(@@) % ألا إنني حسرة الحاسدين % وما حسرة العجم إلا العرب % 23(@)(@@) % فلا لبسوا غير هذا الشعار % % ولا رزقوا غير هذا اللقب % % 24(@)(@@) % منحتك من منطقي تحفة % % رأيت بها فرصة تستلب % % 25(@)(@@) % تصفقها بالنشيد الرواة % كما صفق الماء بنت العنب % 26(@)(@@) % وأنت تساهمني في العلا % % ء فخرا ، وتشركني في النسب % PageV01P150 البحر : بسيط تام 1(@)(@@) % لأشكرنك ما ناحت مطوقة % وان عجزت عن الحق الذي وجبا % % 2(@)(@@) % فما التفت إلى نعماء سابغة % % إلا رأيتك فيها الأصل والسببا % % 3(@)(@@) % اخدمتني نوب الايام طائعة % % وكان كل الرضى أن آمن النوبا % % 4(@)(@@) % ولا لقيت يدا للدهر جارحة % % إذا بقيت ، ولا ألقى لها السببا % % 5(@)(@@) % وقد أقمت عماد البيت راسخة % على القواعد فامدد بعدها الطنبا % % PageV01P151 البحر : طويل 1(@)(@@) % لغير العلى مني القلى والتجنب % ولولا العلى ما كنت في الحب ارغب % % 2(@)(@@) % إذا الله لم يعذرك فيما ترومه % فما الناس الا عاذل أو مؤنب % % 3(@)(@@) % ملكت بحلمي فرصة ما استرقتها % % من الدهر مفتول الذراعين أغلب % 4(@)(@@) % فإن تك سني ما تطاول باعها % % فلي من وراء المجد قلب مدرب % % 5(@)(@@) % فحسبي اني في الاعادي مبغض % % وأني إلى غر المعالي محبب % 6(@)(@@) % وللحلم اوقات وللجهل مثلها % % ولكن أوقاتي إلى الحلم أقرب % 7(@)(@@) % يصول علي الجاهلون ، وأعتلي % % ويعجم في القائلون واعرب % % 8(@)(@@) % يرون احتمالي غصة ، ويزيدهم % لواعج ضغن انني لست اغضب % % 9(@)(@@) % وأعرض عن كأس النديم ، كأنها % % وميض غمام ، عائر المزن خلب % 10(@)(@@) % وقور ، فلا 
ms47	 الألحان تأسر عزمتي % % ولا تمكر الصهباء بي ، حين أشرب % PageV01P152 11(@)(@@) % ولا اعرف الفحشاء الا بوصفها % % ولا انطق العوراء والقلب مغضب % % 12(@)(@@) % تحلم عن كر القوارض شيمتي % % كان معيد المدح بالذم مطنب % % 13(@)(@@) % لساني حصاة يقرع الجهل بالحجى % % إذا نال مني العاضه المتوثب % 14(@)(@@) % ولست براض ان تمس عزائمي % % فضالات ما يعطى الزمان ويسلب % % 15(@)(@@) % غرائب آداب حباني بحفظها % % زماني وصرف الدهر نعم المودب % % 16(@)(@@) % تريشنا الأيام ثم تهيضنا % % الانعم ذا البادي وبئس المعقب % % 17(@)(@@) % نهيتك عن طبع اللئام ، فإنني % % ارى البخل يأتي والمكارم تطلب % % 18(@)(@@) % تعلم فان الجود في الناس فطنة % % تناقلها الاحرار والطبع اغلب % % 19(@)(@@) % تضافرني فيك الصوارم والقنا % % ويصحبني منك العذيق المرجب % 20(@)(@@) % نصحت وبعض النصح في الناس هجنة % وبعض التناجي بالعتاب تعتب % PageV01P153 21(@)(@@) % فان انت لم تعط النصيحة حقها % % فرب جموح كل عنه المؤنب % % 22(@)(@@) % سقى الله ارضا جاور القطر روضها % % اذ المزن تسقي والاباطح تشرب % % 23(@)(@@) % ذكرت بها عصر الشباب ، فحسرة % أفدت وقد فات الذي كنت أطلب % 24(@)(@@) % سكنتك والايام بيض كانها % % من الطيب في اثوابنا تتقلب % % 25(@)(@@) % ويعجبني منك النسيم اذا هفا % % الا كل ما سرى عن القلب معجب % % 26(@)(@@) % وفي الوطن المألوف للنفس لذة % وان لم ينلنا العز الا التقلب % % 27(@)(@@) % وبرق رقيق الطرتين لحظته % % اذا الجو خوار المصابيح اكهب % % 28(@)(@@) % فمر كما مرت ذوائب عشوة % تقاد بأطراف الرماح وتجنب % 29(@)(@@) % نظرت والحاظ النجوم كليلة % % وهيهات دون البرق شأ ومغرب % % 30(@)(@@) % فما الليل إلا فحمة مستشفة % وما البرق إلا جمرة تتلهب % PageV01P154 31(@)(@@) % أمن بعد أن أجللتها ورق الدجى % % سراعا واغصان الازمة تجذب % % 32(@)(@@) % وعدنا بها ممغوطة بنسوعها % % كما صافح الأرض السراء المعبب % % 33(@)(@@) % كأن تراجيع الحداة وراءها % % صفير تعاطاه اليراع المثقب % 34(@)(@@) % وردن بها ماء الظلام سواغبا % ولليل جو بالدراري معشب % 35(@)(@@) % تنفر ذود الطير عن وكراتها % % فكل ، إذا لاقيته ، متغرب % 36(@)(@@) % وتلتذ رشف الماء رنقا كأنه % % مع العز ثغر بارد الظلم أشنب % 37(@)(@@) % اذعنا له سر الكرى من عيوننا % % وسر العلى بين الجوانح 
ms48	 يحجب % % 38(@)(@@) % حرام على المجد ابتسامي لقربه % % وما هزني فيه العناء المقطب % % 39(@)(@@) % تهر ظنوني في المآرب إربة % ويجنب عزمي في المطالب مطلب % % 40(@)(@@) % ودهماء من ليل التمام قطعتها % % أغني حداء ، والمراسيل تطرب % PageV01P155 41(@)(@@) % ولو شئت غنتني الحمام عشية % ولكنني من ماء عيني اشرب % % 42(@)(@@) % أقول إذا خاض السميران في الدجى % % أحاديث تبدو طالعات وتغرب % 43(@)(@@) % الا غنياني بالحديث فانني % % رأيت الذ القول ما كان يطرب % % 44(@)(@@) % غناء اذا خاض المسامع لم يكن % % امينا على جلبابه المتجلبب % % 45(@)(@@) % ونشوان من خمر النعاس ذعرته % % وطيف الكرى في العين يطفو ويرسب % 46(@)(@@) % له مقلة يستنزل النوم جفنها % % إليه كما استرخى على النجم هيدب % 47(@)(@@) % سلكت فجاج الأرض غفلا ومعلما % تجد بها ايدي المطايا وتلعب % % 48(@)(@@) % وما شهوتي لوم الرفيق وانما % % كما يلتقي في السير ظلف ومخلب % 49(@)(@@) % عجبت لغيري كيف ساير نجمها % % وسيري فيها ، يا ابنة القوم ، أعجب % 50(@)(@@) % أسير وسرجي بالنجاد مقلد % وأثوي وبيتي بالعوالي مطنب % PageV01P156 51(@)(@@) % ومصقولة الأعطاف في جنباتها % % مراح لاطراف العوالي وملعب % % 52(@)(@@) % تجر على متن الطريق عجاجة % % يطارحها قرن من الشمس اعضب % % 53(@)(@@) % نهار بلألاء السيوف مفضض % % وجو بحمراء الأنابيب مذهب % 54(@)(@@) % ترى اليوم محمر الخوافي كانما % % على الجو غرب من دم يتصبب % 55(@)(@@) % صدمنا بها الاعداء والليل ضارب % % بارواقه جون الملاطين اخطب % % 56(@)(@@) % أخذنا عليهم بالصوارم والقنا % % وراعي نجوم الليل حيران مغرب % 57(@)(@@) % فلو كان امرا ثابتا عقلوا له % % ولكنه الأمر الذي لا يجرب % 58(@)(@@) % يراعون إسفار الصباح ، وإنما % % وراء لثام الليل يوم عصبصب % % 59(@)(@@) % وكل ثقيل الصدر من جلب القنا % % خفيف الشوى والموت عجلان مقرب % % 60(@)(@@) % يجم اذا ما استرعف الكر جهده % % كما جمت الغدران والماء ينضب % PageV01P157 61(@)(@@) % وما الخيل الا كالقداح نجيلها % % لغنم ، فإما فائز أو مخيب % 62(@)(@@) % دعوا شرف الاحساب يا آل ظالم % % فلا الماء مورود ولا الترب طيب % % 63(@)(@@) % لئن كنتم في آل فهر كواكبا % إذا غاض منها كوكب فاض كوكب % 64(@)(@@) % فنعتي كنعت البدر ينسب بينكم % % جهارا ، وما كل الكواكب تنسب 
ms49	 % 65(@)(@@) % صحبتم خضاب الزاعبيات ناصلا % ومن علق الاقران ما لا يخضب % % 66(@)(@@) % أهذب في مدح اللئام خواطري % % فاصدق في حسن المعاني واكذب % % 67(@)(@@) % وما المدح إلا في النبي وآله % يرام وبعض القول ما يتجنب % % 68(@)(@@) % وأولى بمدحي من أعز بفخره % ولا يشكر النعماء إلا المهذب % 69(@)(@@) % ارى الشعر فيهم باقيا وكانما % % تحلق بالأشعار عنقاء مغرب % 70(@)(@@) % وقالوا عجيب عجب مثلي بنفسه % % واين على الايام مثل أبي اب % % PageV01P158 71(@)(@@) % لعمرك ما اعجبت الا بمدحهم % % ويحسب أني بالقصائد معجب % 72(@)(@@) % اعد لفخري في المقام محمدا % % وأدعو عليا للعلى حين أركب % PageV01P159 البحر : بسيط تام 1(@)(@@) % المجد يعلم أن المجد من أربي % % ولو تماديت في غي وفي لعب % 2(@)(@@) % إني لمن معشر إن جمعوا لعلى % % تفرقوا عن نبي أو وصي نبي % % 3(@)(@@) % اذا هممت ففتش عن شبا هممي % % تجده في مهجات الأنجم الشهب % 4(@)(@@) % وان عزمت فعزمي يستحيل قذى % % تدمى مسالكه في اعين النوب % % 5(@)(@@) % ومعرك صافحت ايدي الحمام به % % طلى الرجال على الخرصان من كثب % % 6(@)(@@) % حلت حباها المنايا في كتائبه % بالضرب فاجتثت الأجساد بالقضب % 7(@)(@@) % تلاقت البيض في الاحشاء فاعتنقت % % والسمهري من الماذي واليلب % % 8(@)(@@) % بكت على الأرض دمعا من دمائهم % فاستعربت من ثغور النور والعشب % % PageV01P160 البحر : وافر تام 1(@)(@@) % الا لله بادرة الطلاب % % وعزم لا يروع بالعتاب % % 2(@)(@@) % وكل مشمر البردين يهوي % % هوي المصلتات إلى الرقاب % 3(@)(@@) % اعاتبه على بعد التنائي % % ويعذلني على قرب الاياب % % 4(@)(@@) % رأيت العجز يخضع لليالي % % ويرضى عن نوائبها الغضاب % % 5(@)(@@) % ولولا صولة الايام دوني % % هجمت على العلى من كل باب % 6(@)(@@) % ومن شيم الفتى العربي فينا % % وصال البيض والخيل العراب % % 7(@)(@@) % له كذب الوعيد من الأعادي % % ومن عاداته صدق الضراب % % 8(@)(@@) % سأدرع الصوارم والعوالي % % وما عريت من خلع الشباب % % 9(@)(@@) % واشتمل الدجى والركب يمضي % % مضاء السيف شذ عن القراب % % 10(@)(@@) % وكم ليل عبأت له المطايا % % ونار الحي حائرة الشهاب % % PageV01P161 11(@)(@@) % لقيت الأرض شاحبة المحيا % % تلاعب بالضراغم والذئاب % % 12(@)(@@) % فزعت إلى الشحوب وكنت طلقا % % كما فزع المشيب 
ms50	 إلى الخضاب % % 13(@)(@@) % ولم نر مثل مبيض النواحي % % تعذبه بمسود الاهاب % % 14(@)(@@) % أبيت مضاجعا أملي ، وإني % % ارى الامال اشقى للركاب % % 15(@)(@@) % اذا ما اليأس خيبنا رجونا % % فشجعنا الرجاء على الطلاب % 16(@)(@@) % أقول إذا استطار من السواري % % زفون القطر رقاص الحباب % 17(@)(@@) % كأن الجو غص به ، فأومى % % ليقذفه على قمم الشعاب % 18(@)(@@) % جدير أن تصافحه الفيافي % % ويسحب فوقها عذب الرباب % 19(@)(@@) % إذا هتم التلاع رأيت منه % رضابا في ثنيات الهضاب % % 20(@)(@@) % سقى الله المدينة من محل % % لباب الماء والنطف العذاب % PageV01P162 21(@)(@@) % وجاد على البقيع وساكنيه % رخي الذيل ملآن الوطاب % 22(@)(@@) % واعلام الغري وما استباحت % % معالمها من الحسب اللباب % % 23(@)(@@) % وقبرا بالطفوف يضم شلوا % قضى ظمأ إلى برد الشراب % % 24(@)(@@) % وسامرا ، وبغدادا ، وطوسا % هطول الودق منخرق العباب % 25(@)(@@) % قبور تنطف العبرات فيها % % كما نطف الصبير على الروابي % % 26(@)(@@) % فلو بخل السحاب على ثراها % % لذابت فوقها قطع السراب % 27(@)(@@) % سقاك فكم ظمئت اليك شوقا % على عدواء داري واقترابي % % 28(@)(@@) % تجافي يا جنوب الريح عني % % وصوني فضل بردك عن جنابي % % 29(@)(@@) % ولا تسري إلي مع الليالي % % وما استحقبت من ذاك التراب % % 30(@)(@@) % قليل أن تقاد له الغوادي % % وتنحر فيه اعناق السحاب % % PageV01P163 31(@)(@@) % اما شرق التراب بساكنيه % % فيلفظهم إلى النعم الرغاب % % 32(@)(@@) % فكم غدت الضغائن وهي سكرى % % تدير عليهم كأس المصاب % 33(@)(@@) % صلاة الله تخفق كل يوم % على تلك المعالم والقباب % 34(@)(@@) % وإني لا أزال أكر عزمي % % وإن قلت مساعدة الصحاب % 35(@)(@@) % وأخترق الرياح إلى نسيم % تطلع من تراب أبي تراب % 36(@)(@@) % بودي ان تطاوعني الليالي % % وينشب في المنى ظفري ونابي % % 37(@)(@@) % فأرمي العيس نحوكم سهاما % تغلغل بين أحشاء الروابي % % 38(@)(@@) % ترامي باللغام على طلاها % % كما انحدر الغثاء عن العقاب % 39(@)(@@) % وأجنب بينها خرق المذاكي % % فأملي باللغام على اللغاب % 40(@)(@@) % لعلي أن أبل بكم غليلا % تغلغل بين قلبي والحجاب % % PageV01P164 41(@)(@@) % فما لقياكم الا دليل % % على كنز الغنيمة والثواب % % 42(@)(@@) % ولي قبران بالزوراء أشفي % % بقربهما نزاعي واكتئابي % % 43(@)(@@) % أقود إليهما نفسي وأهدي % % سلاما لا يحيد عن 
ms51	 الجواب % 44(@)(@@) % لقاؤهما يطهر من جناني % % ويدرأ عن ردائي كل عاب % % 45(@)(@@) % قسيم النار جدي يوم يلقى % % به باب النجاة من العذاب % 46(@)(@@) % وساقي الخلق والمهجات حرى % % وفاتحة الصراط إلى الحساب % 47(@)(@@) % ومن سمحت بخاتمه يمين % تضن بكل عالية الكعاب % 48(@)(@@) % اما في باب خيبر معجزات % % تصدق ، أو مناجاة الحباب % 49(@)(@@) % أرادت كيده ، والله يأبى % % فجاء النصر من قبل الغراب % 50(@)(@@) % أهذا البدر يكسف بالدياجي % % وهذي الشمس تطمس بالضباب % % PageV01P165 51(@)(@@) % وكان اذا استطال عليه جان % % يرى ترك العقاب من العقاب % 52(@)(@@) % ارى شعبان يذكرني اشتياقي % % فمن لي أن يذكركم ثوابي % % 53(@)(@@) % بكم في الشعر فخري لا بشعري % % وعنكم طال باعي في الخطاب % 54(@)(@@) % أجل عن القبائح غير أني % % لكم أرمي وأرمى بالسباب % 55(@)(@@) % فاجهر بالولاء ولا اوري % % وأنطق بالبراء ، ولا أحابي % % 56(@)(@@) % ومن أولى بكم مني وليا % وفي ايديكم طرف انتسابي % % 57(@)(@@) % محبكم ولو بغضت حياتي % % وزائركم ولو عقرت ركابي % % 58(@)(@@) % تباعد بيننا غير الليالي % % ومرجعنا إلى النسب القراب % PageV01P166 البحر : مجزوء الكامل 1(@)(@@) % إنا نعيب ، ولا نعاب % ونصيب منك ولا نصاب % % 2(@)(@@) % آل النبي ومن تقلب % % في حجورهم الكتاب % % 3(@)(@@) % خلقت لهم سمر القنا % % والبيض والخيل العراب % % 4(@)(@@) % فاقني حياءك ، إن % ما الأيام غنم ، أو نهاب % 5(@)(@@) % من لذ ورد الموت لا % % يصفو له ابدا شراب % % 6(@)(@@) % وتطر في حيث السما % % ح الغمر والحسب اللباب % % 7(@)(@@) % في حيث للراجي الثوا % % ب ندى وللجاني العقاب % % 8(@)(@@) % قوم ، إذا غمز الزما % % ن قنيهم كرموا وطابوا % % 9(@)(@@) % واذا دعوا والخيل في الاج % % فال ، ثابوا ، أو أجابوا % % 10(@)(@@) % أبني عدي ! إنما % % سالت بخيلكم الشعاب % PageV01P167 11(@)(@@) % وشرفتم بالطعن ، والدن % ضرام أو ضراب % % 12(@)(@@) % ما كنتم إلا البحو % % ر توالغت فيها الذئاب % 13(@)(@@) % و قرعتم بالبيض حت % % تى ضاع في اللمم الشباب % 14(@)(@@) % و اليوم تستل السيو % % ف به وتنسل الرقاب % 15(@)(@@) % كتمت دمائكم الظبا % % كالشيب يكتمه الخضاب % 16(@)(@@) % فتنازعوا شمط الظ % % م فخلفه الاسد الغضاب % % 17(@)(@@) % و تعلموا أن الصبا % % ح ضبارم ، والليل غاب % 18 
ms52	(@)(@@) % لا صلح حتى تطمئن % % إلى مناسمها الركاب % % 19(@)(@@) % ويعود وجه الشمس لا % % نقع عليه ، ولا ضباب % 20(@)(@@) % حتى تشبت بالظبا الا % % ماد ، والجرد الرحاب % PageV01P168 21(@)(@@) % و تمد أطناب البيو % % ت ، وتضمر القوم القباب % 22(@)(@@) % وتردف الأدراع مش % رجة ، عليهن العياب % 23(@)(@@) % و ترى الربا والروض ينش % % شر من مطارفها السحاب % 24(@)(@@) % ما كان فضضه فضي % % الطل اذهبه الذهاب % % 25(@)(@@) % كانت نجوم الليل يك % مها من النقع الغياب % % 26(@)(@@) % فالان اصحر في السما % % ء البدر وانكشف النقاب % % 27(@)(@@) % وعلت إلى أوكارها العق % ان وانحط العقاب % % 28(@)(@@) % عودوا إلى ذاك الغدي % % ير وقل ما غدر الرباب % % 29(@)(@@) % وتغنموا تلك المنا % % زل وهي آمنة رغاب % % 30(@)(@@) % وتداركوا ذود المسا % % رح وهي بينكم سقاب % % PageV01P169 31(@)(@@) % وكأن أيام الهوى % % فيكم نشاوى أو طراب % 32(@)(@@) % متمنطقات بالحلي % وفي قلائدها الملاب % 33(@)(@@) % إني على لين النقي % % بة لا أعاب ولا أحاب % 34(@)(@@) % ما شد لي يوما على % % ذل ولا طمع حقاب % % 35(@)(@@) % من لي بغرة صاحب % % لا يستطيل عليه عاب % % 36(@)(@@) % ما حارب الأيام إ % % لا كان لي وله الغلاب % 37(@)(@@) % ولكل قول سامع % ولكل داعية جواب % 38(@)(@@) % هيهات أطلب ما يطو % % ل به بعاد واقتراب % % 39(@)(@@) % قل الصحاب ، فإن ظفر % ت بنعمة كثر الصحاب % % 40(@)(@@) % من لي به سمحا اذا % % صفرت من القوم الوطاب % PageV01P170 41(@)(@@) % غيران دون الجار لا % % يطوي عزايمه الحجاب % 42(@)(@@) % يستعذب المومات منز % % لة وان بعد الاياب % % 43(@)(@@) % رقت حواشي بيته % % مما يلاطمها السراب % 44(@)(@@) % لا يستقل برحله % % إلا الذوائب والهضاب % 45(@)(@@) % تهفو بكفيه الصوا % % رم أو تسيل بها الكعاب % % 46(@)(@@) % جذلان يلتقط النسيم % % م ، إذا تساقطت الثياب % 47(@)(@@) % يمى إليه الشيح ، وال % حوذان والإبل الجراب % 48(@)(@@) % وكان غرته وراء ل % % ثام ليلته شهاب % % 49(@)(@@) % من لي به يا دهر والا % % يام كالحة غضاب % 50(@)(@@) % إن الصديق مشيع % ان جل خطب أو خطاب % % PageV01P171 51(@)(@@) % ويجود عنك بنفسه % % والحرب تقرعها الحراب % 52(@)(@@) % وأخ حرمت الود من % ه ، وبيننا نسب قراب % 53(@)(@@) % نازعته ثدي الرضاع 
ms53	 % % وما يلذ لنا الشراب % 54(@)(@@) % يا سعد ! أعظم محنة % من لا يروعه العتاب % % 55(@)(@@) % يجني على جيرانه % حتى يعاقبه السباب % 56(@)(@@) % حسبي من الايام ان % % ابقى ويسعدني الطلاب % % PageV01P172 البحر : متقارب تام 1(@)(@@) % دوام الهوى في ضمان الشباب % وما الحب الا زمان التصابي % % 2(@)(@@) % احين فشا الشيب في شعره % % وكتم أوضاحه بالخضاب % 3(@)(@@) % تروعين اوقاته بالصدود % % وترمين أيامه بالسباب % 4(@)(@@) % تخطى المشيب إلى راسه % % وقد كان اعلى قباب الشباب % % 5(@)(@@) % كذاك الرياح إذا استلأمت % تقصف أعلى الغصون الرطاب % 6(@)(@@) % مشيب كما استل صدر الحسا % % م ، لم يرو من لبثه في القراب % 7(@)(@@) % نضى فاستباح حمى الملهيات % % وراع الغواني بظفر وناب % 8(@)(@@) % وألوى بجدة أيامه % فأصبح مقذى لعين الكعاب % 9(@)(@@) % تستر منه مجال السوار % إذا ما بدا ومناط النقاب % 10(@)(@@) % وكان ، إذا شردت نية % يرد رقاب الخطوب الغضاب % % PageV01P173 11(@)(@@) % وكنت أرقرق ماء الوصال % وبحر الشبيبة طاغي العباب % 12(@)(@@) % وكأسي معودة بالسماع % تركض بين القلوب الطراب % % 13(@)(@@) % اذا نصفت فهي في مئزر % % وتبرز ان اترعت في نقاب % % 14(@)(@@) % سمائي مذهبة بالبروق % % وأرضي مفضضة بالحباب % 15(@)(@@) % وروضي مطارفه غضة % % تطرز اطرافها بالذهاب % % 16(@)(@@) % وليل ترى الفجر في عطفه % كما شاب بعض جناح الغراب % % 17(@)(@@) % يغار الظلام على شمسه % إلى أن يواريها بالحجاب % 18(@)(@@) % وتصقل انجمه العاصفات % % اذا صديت من غمود السحاب % % 19(@)(@@) % وبرق ينفض اطرافه % % كما رمحت بلق خيل عراب % 20(@)(@@) % وماء يضارع خيط السقاء % % ويرمى به في وجوه الشعاب % PageV01P174 21(@)(@@) % تزعزع ريح الصبا متنه % كما لطم المزج خد الشراب % 22(@)(@@) % وذود يغادر وجه الصعيد م % % ن حلة العشب عاري الإهاب % 23(@)(@@) % فما تطلب البيد من ساهم % يثير عليها رقاب الركاب % 24(@)(@@) % يساعدها في احتمال الصدى % % ويشركها في ورود السراب % % 25(@)(@@) % يذكره أخذ أوتاره % صهيل السوابق حول القباب % 26(@)(@@) % دفعن بخضخضة للمزاد % % نجاء وخشخشة للعياب % % 27(@)(@@) % لبل أنابيبه بالطعان % وأنحل أسيافه بالضراب % 28(@)(@@) % يبيت وثوب الدجى شاحب % % طموح المعالم سامي الشهاب % 29(@)(@@) % وم كنت أجري إلى غاية % فاسألها أين وجه الاياب % % 30(@)(@@) % اذا استنهضت 
ms54	 هممي عزمة % % عصفت بايدي المطي العراب % % PageV01P175 31(@)(@@) % تحريت اعجازها بالسياط % % فخاضت صدور الامور الصعاب % % 32(@)(@@) % فكم قائف قد هدت لحظه % بدور مناسمها في التراب % 33(@)(@@) % إذا مات في وخدهن المدى % % لطمن خدود الربى والرحاب % % 34(@)(@@) % فداؤك نفسي يا من له % % من القلب ربع منيع الجناب % % 35(@)(@@) % فلولاك ما عاق قلبي الهوى % % وعز على كل شوق طلابي % % 36(@)(@@) % إذا ما صددت دعاني الهوى % % فملت إلى خدعات العتاب % % 37(@)(@@) % فيا جنتي إن رماني الزمان % ويا صاحبي ان جفاني صحابي % % 38(@)(@@) % دفعت بكفي زمامي إليك % وقد كنت ابطى على من حدابي % % 39(@)(@@) % فلا تحسبني ذليل القياد % فإني أبي على كل آبي % % 40(@)(@@) % وساع إلى الود شبهته % ويرتع مع أهله في جناب % PageV01P176 41(@)(@@) % يؤمن سطوة ليث العرين % ومضجعه بين غيل وغاب % 42(@)(@@) % حمته مذلته سطوتي % % وكيف ينال ذبابا ذبابي % % 43(@)(@@) % وملتثم قال لي لثمه % % عذاب الهوى في الثنايا العذاب % 44(@)(@@) % نعاقر بالضم كاس العناق % % ونسفك باللثم خمر الرضاب % 45(@)(@@) % عناق كما ارتج ماء الغدير % ولثم كما استن ولغ الذئاب % 46(@)(@@) % غدونا على صهوات الخطوب % جوادي رهان وسيفي قراب % % 47(@)(@@) % صقيلين تستلنا النائبات % فتثلم فيهن ، والدهر ناب % 48(@)(@@) % وغصنين يلعب فينا النسيم % % وتنطف عنا نطاف الرباب % % 49(@)(@@) % ونجمين يقصر عن نيلنا % % من الطالعات الذرى والروابي % % 50(@)(@@) % وكنا ، إذا مسنا حادث % نقلم بالصبر ظفر المصاب % % PageV01P177 51(@)(@@) % اليك تخطت فروج القلوب % % بكر من الآنسات العراب % 52(@)(@@) % أشبب فيها بذكر المشيب % وما استيأست لمتي من شبابي % % PageV01P178 البحر : وافر تام 1(@)(@@) % أغدرا يا زمان ويا شباب % اصاب بذا لقد عظم المصاب % % 2(@)(@@) % وما جزعي لان غرب التصابي % % وحلق عن مفارقي الغراب % 3(@)(@@) % فقبل الشيب أسلفت الغواني % % قلى وامالني عنها اجتناب % % 4(@)(@@) % عففت عن الحسان ، فلم يرعني % % المشيب ولم ينزقني الشباب % % 5(@)(@@) % تجاذبني يد الايام نفسي % % ويوشك ان يكون لها الغلاب % % 6(@)(@@) % وتغدر بي الأقارب والأداني % % فلا عجب اذا غدر الصحاب % % 7(@)(@@) % نهضت وقد قعدن بي الليالي % % فلا خيل أعن ولا ركاب % % 8(@)(@@) % وما ذنبي اذا اتفقت خطوب % % مغالبة ، وأيام 
ms55	 غضاب % 9(@)(@@) % وآمل أن تقي الأيام نفسي % % وفي جنبي لها ظفر وناب % 10(@)(@@) % فما لي والمقام على رجال % % دعت بهم المطامع ، فاستجابوا % % PageV01P179 11(@)(@@) % ولم أر كالرجاء اليوم شيئا % تذل له الجماجم والرقاب % % 12(@)(@@) % وكان الغبن لو ذلوا ونالوا % % فكيف إذا وقد ذلوا وخابوا % % 13(@)(@@) % يريدون الغنى ، والفقر خير % اذا ما الذل اعقبه الطلاب % % 14(@)(@@) % وبعض العدم مأثرة وفخر % وبعض المال منقصة وعاب % 15(@)(@@) % بناني والعنان اذا نبت بي % % ربى أرض ورحلي والركاب % 16(@)(@@) % وسابغة كأن السرد فيها % % زلال الماء لمعه الحباب % % 17(@)(@@) % من اللآئي يماط العيب عنها % % إذا نثلت لدى الروع العياب % 18(@)(@@) % اذا ادرعت تجنبت المواضي % % معاجمها وقهقهت الكعاب % % 19(@)(@@) % ومشرفة القذال تمر رهوا % كما عسلت على القاع الذئاب % 20(@)(@@) % مجلية تشق بها يداها % % كما جلى لغايته العقاب % PageV01P180 21(@)(@@) % ومرقبة ربأت على ذراها % % ولليل انجفال وانجياب % 22(@)(@@) % بقرب النجم عالية الهوادي % % يبيت على مناكبها السحاب % % 23(@)(@@) % إلى أن لوح الصبح انفتاقا % % كما جلي عن العضب القراب % 24(@)(@@) % و قد عرفت توقلي المعالي % % كما عرفت توقلي العقاب % 25(@)(@@) % ونقب ثنية سددت فيها % % أصم كأن لهذمه شهاب % 26(@)(@@) % لأمنع جانبا وأفيد عزا % وعز المرء ما عز الجناب % 27(@)(@@) % إذا هول دعاك فلا تهبه % % فلم يبق الذين ابوا وهابوا % % 28(@)(@@) % كليب عاقصته يد ، وأودى % % عتيبة يوم أقعصه ذؤاب % 29(@)(@@) % سواء من اقل الترب منا % % و من وارى معالمه التراب % % 30(@)(@@) % وإن مزايل العيش اختصارا % مساو للذين بقوا ، فشابوا % % PageV01P181 31(@)(@@) % فاولنا العناء اذا طلعنا % % إلى الدنيا ، وآخرنا الذهاب % 32(@)(@@) % إلى كم ذا التردد في الأماني % % وكم يلوي بناظري السراب % 33(@)(@@) % و لا نقع يثار ولا قتام % % و لا طعن يشب ولا ضراب % % 34(@)(@@) % و لا خيل معقدة النواصي % % يموج على شكائمها اللعاب % 35(@)(@@) % عليها كل ملتهب الحواشي % % يصيب من العدو ولا يصاب % 36(@)(@@) % أمام مجلجل كالليل تهوي % % أواخره ، الجمايل والقباب % 37(@)(@@) % وأين يحيد عن مضر عدو % اذا زخرت وعب لها العباب % % 38(@)(@@) % وقد زأدت ضراغمها الضواري % % و قد هدرت مصاعبها الصعاب % % 39(@)(@@) % هنالك 
ms56	 لا قريب يرد عنا % % و لا نسب نيط بنا قراب % % 40(@)(@@) % سأخطبها بحد السيف فعلا % إذا لم يغن قول ، أو خطاب % PageV01P182 41(@)(@@) % وآخذها ، وإن رغمت أنوف % مغالبة ، وإن ذلت رقاب % 42(@)(@@) % و إن مقام مثلي في الأعادي % % مقام البدر تنبحه الكلاب % 43(@)(@@) % رموني بالعيوب ملفقات % و قد علموا بأني لا أعاب % % 44(@)(@@) % و أني لا تدنسني المخازي % % و أني لا يروعني السباب % % 45(@)(@@) % ولما لم يلاقوا في عيبا % كسوني من عيوبهم وعابوا % % PageV01P183 البحر : متقارب تام 1(@)(@@) % اثرها على ما بها من لغب % % يقلقل أغراضها والحقب % 2(@)(@@) % ولا ترقب اليوم ميط الاذى % % عن اخفافها واندماء الجلب % % 3(@)(@@) % إلى أن تعجعجها كالحني % تجتر بالدم لا بالعشب % 4(@)(@@) % عليها أخامص مثل الصقور % طوال الرجاء جسام الارب % % 5(@)(@@) % وكل فتى حظ أجفانه % من الضيم مضمضة تستلب % 6(@)(@@) % فبينا يقال كرى جفنه % بقطع من الليل إذ قيل : هب % 7(@)(@@) % اذا وقعوا بعد طول الكلال % % لم يغمزوا قدما من تعب % 8(@)(@@) % ولما يعافوا على عزهم % % توسد أعضادها والركب % 9(@)(@@) % وعرج على الغر من هاشم % فأهد السلام لهم من كثب % 10(@)(@@) % وقل لبني عمنا الواجدين % % بني عمنا ، بعض هذا الغضب % PageV01P184 11(@)(@@) % اما آن للراقد المستمر % % في ظلم الغي أن يستهب % 12(@)(@@) % سرحتم سفاهتكم في العقوق % % ولم تحفلوا الحلم لما غرب % 13(@)(@@) % ولما ارنتم اران الجموح % % وماج بكم حبلكم واضطرب % % 14(@)(@@) % أقمنا أنابيبكم بالثقاف % وداوى الهناء مطال الجرب % 15(@)(@@) % ويا ربما عاد سوء العقاب % على المذنبين بحسن الأدب % 16(@)(@@) % % مضيض من الداء ان يستطب % % 17(@)(@@) % أطال وأعرض ما بيننا % % مبير الحياء مثير الريب % 18(@)(@@) % افي كل يوم لرق الهوان % % صبيبة انفسكم تنسكب % % 19(@)(@@) % إذا قادكم مثل قود الذلول % نفرنا نفور البعير الازب % % 20(@)(@@) % وفي كل يوم إلى داركم % % مزاحف من فيلق ذي لجب % PageV01P185 21(@)(@@) % بوهوهة الخيل تحت الرماح % % مكرهة ورغاء النجب % % 22(@)(@@) % سياط الجياد به إن ونين % وزجر الرحال بهال وهب % 23(@)(@@) % وتلقونها كقداح السرا % % ء ، قودا تجر العوالي وقب % 24(@)(@@) % كان حوافزها والصخور % % إذا ما ذرعن الدجى 
ms57	 في صخب % 25(@)(@@) % تسد على البيد خرق الشمال % % بما نسجت من سحيل الترب % 26(@)(@@) % وطئن النجيع بارساغهن % % مما انتعلن الربى والذأب % 27(@)(@@) % وكم قرع الدو من حافر % يخال على الأرض قعبا يكب % % 28(@)(@@) % تهز السيوف لأعناقكم % فتأبى مضارب تلك القضب % 29(@)(@@) % وتسفر احسابنا بيننا % % فنلقي طوائلنا أو نهب % % 30(@)(@@) % يناشدنا الله في حربكم % % عريق لكم في أبينا ضرب % PageV01P186 31(@)(@@) % وما أحدث الدهر من نبوة % وقطع ما بيننا من سبب % 32(@)(@@) % فإن النفوس إليكم تشاق % وإن القلوب عليكم تجب % 33(@)(@@) % وإنا نرى لجوار الديار % حقوقا فكيف جوار النسب % % 34(@)(@@) % تماسس ارحامنا والذمام % % م من دون ذاك علينا يجب % 35(@)(@@) % فان نرع شركة احسابنا % % جميعا ، فذلك دين العرب % 36(@)(@@) % اذا لبست بقواها قوى % % وإن طنب مس منها طنب % 37(@)(@@) % أراح بني عامر ذلهم % وعرضنا عزنا للتعب % % 38(@)(@@) % وفرنا عليهم طريق البقاء % % وخلوا لنا عن طريق العطب % 39(@)(@@) % فقد اصبحوا في ذمام الخمول % % لا تدريهم مرامي النوب % % 40(@)(@@) % أبى الناس إلا ذميم النفاق % إذا جربوا ، أو قبيح الكذب % PageV01P187 41(@)(@@) % كلاب تبصبص خوف الهوان % % وتنبح بين يدي من غلب % 42(@)(@@) % اذم لوجهي على ما به % % ولا يعدل الذل عندي النشب % % 43(@)(@@) % ومن وجد الرزق عند السيوف % % فلم يتحمل لذل الطلب % 44(@)(@@) % وان منازل هذا الزمان % % لانبائه نوب أو عقب % % 45(@)(@@) % لذلك يركب من قد سعى % % طويلا ويرحل من قد ركب % % 46(@)(@@) % انا ابن الاناجب من هاشم % % اذا لم يكن نجب من نجب % % 47(@)(@@) % تلاث برودهم بالرماح % وتلوى عمائمهم بالشهب % 48(@)(@@) % عتاق الوجوه وعتق الجياد % % في الضمر تعرفه والقبب % % 49(@)(@@) % يشف الوضاء خلال الشحو % % ب منها ، وخلف الدخان اللهب % 50(@)(@@) % وقار يهاب ، وناد يناب % وحلم يراح وراي يغب % % PageV01P188 51(@)(@@) % اذا استبق القوم طرق النجاء % % وذم الجبان قعود الهرب % % 52(@)(@@) % رأيتهم في ظلال القنا % % وقد ضاق للكرب عقد اللبب % % 53(@)(@@) % قد امتنعوا بحصون الدروع % % ع ، واستعصموا بقباب اليلب % 54(@)(@@) % أولئك قومي لم يغمزوا % % بهجنة ام ولا لؤم اب % % 55(@)(@@) % ومن قال : إن جميع الفخار % لغير ذوائب 
ms58	 قومي كذب % PageV01P189 البحر : طويل 1(@)(@@) % هل الطرف يعطي نظرة من حبيبه % % أم القلب يلقى راحة من وجيبه % % 2(@)(@@) % وهل لليالي عطفة بعد نفرة % % تعود فتلهى ناظرا عن غروبه % % 3(@)(@@) % ولله ايام عفون كما عفى % % ذوائب مياس العرار رطيبه % % 4(@)(@@) % احن إلى نور الربى في بطاحه % % وأظما إلى ريا اللوى في هبوبه % 5(@)(@@) % وذاك الحمى يغدو عليلا نسيمه % ويمسي صحيحا ماؤه في قليبه % % 6(@)(@@) % حببت لقلبي ظله في هجيره % % إذا ما دجا أو شمسه في ضريبه % 7(@)(@@) % وعهدي بذاك الظبي إبان زرته % رعاني ، ولم يحفل بعيني رقيبه % 8(@)(@@) % وحكم ثغري في إناء رضابه % وأدنى جوادي من إناء حليبه % 9(@)(@@) % هو الشوق مدلولا على مقتل الفتى % % اذا لم يعد قلبا بلقيا حبيبه % % 10(@)(@@) % تعيرني تلويح وجهي ، وإنما % % غضارته مدفونة في شحوبه % PageV01P190 11(@)(@@) % فرب شقاء قد نعمنا بمره % ورب نعيم قد شقينا بطيبه % % 12(@)(@@) % ولولا بواقي نائبات من الردى % % غفرت لهذا الدهر ماضي ذنوبه % % 13(@)(@@) % واني لعرفان الزمان وغدره % % أبيت وما لي فكرة في خطوبه % 14(@)(@@) % واصبح لا مستعظما لعظيمه % % بقلبي ولا مستعجبا لعجيبه % % 15(@)(@@) % يغم الفتى ذكر المشيب وربما % % يلقى انقضاء العمر قبل مشيبه % 16(@)(@@) % وينسيه بدء العيش ما في عقيبه % % وجيئته تبدي لنا عن ذهوبه % 17(@)(@@) % إلى كم اشق الليل عن كل مهمه % % وأرعى طلوع النجم حتى مغيبه % 18(@)(@@) % أخط بأطراف القنا كل بلدة % واملي جلابيب الملا من ندوبه % % 19(@)(@@) % وكنت اذا خوى نجيب تركته % % أسير عقال مؤلم من لغوبه % 20(@)(@@) % رجاء لعز أقتنيه وحالة % تزيد عدوي من غواشي كروبه % PageV01P191 21(@)(@@) % وبزلاء من جند الليالي لقيتها % % بقلب بعيد العزم فيها قريبه % 22(@)(@@) % نصبت لها وجهي وليس كعاجز % % يوقيه حر الطعن من يتقى به % % 23(@)(@@) % وخيل كأمثال القنا تحمل القنا % % على كل عنق عاقد من سبيبه % 24(@)(@@) % حملت عليها كل طعان سربة % كما نهز الساقي بجنبي قليبه % % 25(@)(@@) % قضى وطر العلياء من ركب القنا % % وأولغ بيضا من دم في صبيبه % 26(@)(@@) % وكم قعدة مني أقمت ببأسها % % إلى الطعن مياد القنا في كعوبه 
ms59	 % 27(@)(@@) % ولما ركبت الهول لم أرض دونه % ومن ركب الليث اعتلى عن نجيبه % 28(@)(@@) % تريح علينا ثلة المجد شزب % % تغالى وايد من قنا في صليبه % % 29(@)(@@) % وأبيض من عليا معد ، بنانه % مقاوم ريان الغرار خصيبه % % 30(@)(@@) % أخف إلى يوم الوغى من سنانه % و أمضى على هام العدى من قضيبه % % PageV01P192 31(@)(@@) % هل السيف الا منتصى من لحاظه % % أو البدر الا طالع من جيوبه % % 32(@)(@@) % إذا سئل انهال الندى من بنانه % % كما انهال أذيال النقا من كثيبه % 33(@)(@@) % جواد اذا ما مزق الذود عضبه % % أذاع الندى من جرده بعد نيبه % 34(@)(@@) % يسير امام النجم عند طلوعه % % ويهوي أمام النجم عند غروبه % 35(@)(@@) % رضيت به في صدر يوم عجاجه % على شمسه عارية من سهوبه % 36(@)(@@) % مضى يحرس الأقران بالطعن في الطلى % % وقد لج نعاب القنا في نعيبه % 37(@)(@@) % أنا ابن نبي الله وابن وصيه % % فخار علا عن نده وضريبه % % 38(@)(@@) % تأدب مني رائع الخطب بعدما % % تجلى سفيه الجد لي عن أديبه % 39(@)(@@) % فو الله لا ألقى الزمان بذلة % % و لوحط في فودي أمضى غروبه % % 40(@)(@@) % قنعت فعندي كل ملك نزوله % % عن العز والعلياء مثل ركوبه % % PageV01P193 41(@)(@@) % و ما اسفي الا على ما جلوته % % على سمع منزور النوالب نضوبه % % 42(@)(@@) % إذا ما رآني قطع اللحظ طرفه % % و عنون لي اطراقه عن قطوبه % % 43(@)(@@) % ومن لم يكن حمدي نصيبا لبشره % % جعلت ضروب الذم أدنى نصيبه % 43(@)(@@) % ولو أن عضبي ممكن ما ذممته % وكان مكان الذم ردع جيوبه % 44(@)(@@) % وإن عناء الناظرين كليهما % % إذا طمعا من بارق في خلوبه % % 45(@)(@@) % أعاب بشعري ، والذي أنا قائل % يقلقل جنبي عائب من معيبه % 46(@)(@@) % وكل فتى يرنو إلى عيب غيره % % سريعا وتعمى عينه عن عيوبه % 47(@)(@@) % وما قولي الأشعار إلا ذريعة % إلى أمل قد آن قود جنبيه % % 48(@)(@@) % و إني إذا ما بلغ الله منيتي % % ضمنت له هجر القريض وحوبه % 49(@)(@@) % فهل عائبي قول عقدت بفضله % فخارى وحصنت العلى بضروبه % % PageV01P194 50(@)(@@) % سأترك هذا الدهر يرغو رغاؤه % و تصرف من 
ms60	 غيظي بوادي نيوبه % % 51(@)(@@) % وأجعل عضبي دون وجهي وقاية % ليا من عندي ماؤه من نضوبه % % PageV01P195 البحر : منسرح 1(@)(@@) % كان قضاء الاله مكتوبا % لولاك كان العزاء مغلوبا % 2(@)(@@) % ما بقيت كفك الصناع لنا % % فكل كسر يكون مرؤوبا % % 3(@)(@@) % ما احتسبت المرء قد يهون وما % % أوجع ما لا يكون محسوبا % % 4(@)(@@) % نهضا بها صابرا ، فأنت لها % % و الثقل لا يعجز المصاعيبا % % 5(@)(@@) % فقد ارتك الاسى وان قدمت % % عن يوسف كيف صبر يعقوبا % % 6(@)(@@) % طمعت ، يا دهر ، أن تروعه % ظنا على الرغم منك مكذوبا % % 7(@)(@@) % ما يؤمن المرء بعد مسمعه % % قرع الليالي له الظنابيبا % % 8(@)(@@) % تنذر إحداثها ويأمنها % % ما آن ان يستريب من ريبا % % 9(@)(@@) % شل بنان الزمان كيف رمى % % مسوما للسباق مجنوبا % % 10(@)(@@) % طرف رهان رماه ذو غرر % % نال طلوبا ، وفات مطلوبا % % PageV01P196 11(@)(@@) % كان هلال الكمال منتظرا % وكان نوء العلاء مرقوبا % % 12(@)(@@) % وأعجمي الأصول تنصره % بداهة تفضح الأعاريبا % % 13(@)(@@) % مدت إليه الظبا قوائمها % % تعجله ضاربا ومضروبا % % 14(@)(@@) % مرشحا للجياد يطلعها % % على العدى ضمرا سراحيبا % % 15(@)(@@) % و للمباتير في وغى وقرى % % يولغها الهام والعراقيبا % % 16(@)(@@) % ذوى كما يذبل القضيب ، وكم % مأمول قوم يصير مندوبا % % 17(@)(@@) % صبرا فراعي البهام إن كثرت % % لابد من أن يحاذر الذبيا % % 18(@)(@@) % وإن دنيا الفتى وإن نظرت % % خميلة تنبت الاعاجيبا % % 19(@)(@@) % نسيغ أحداثها على مضض % ما جدح الدهر كان مشروبا % % 20(@)(@@) % إذا السنان الطرير دام لنا % % فدعه يستبدل الانابيبا % % PageV01P197 21(@)(@@) % و هل يخون الطعان يوم وغى % % إن نقص السمهري انبوبا % % 22(@)(@@) % ما هيبة السيف بالغمود ، ولا % % أهيب من أن تراه مسلوبا % % 23(@)(@@) % و البدر ما ضره تفرده % % ولا خبا نوره ولا عيبا % % 24(@)(@@) % وما افتراق الشبول عن أسد % بمانع أن يكون مرهوبا % % 25(@)(@@) % و الفحل إن وافقت طروقته % % ابدل مكن منجب مناجيبا % % 26(@)(@@) % و العنبر الورد إن عبثت به % % مثلما زاد عرفه طيبا % % 27(@)(@@) % يطيح مستصغر الشرار عن الز % % د ، ويبقى الضرام مشبوبا % % 28(@)(@@) % محصت النار كل شائبة % وزاد لون النضار تهذيبا % % 29(@)(@@) % إن زال ظفر ، فأنت تخلفه % و 