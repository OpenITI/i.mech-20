ms621	 يقال لهم النغف كأنهم جرو الكلاب عظما فيقتلهم الله جميعا وتسكن مختهم وأصواتهم حتى تنتن الأرض منهم فيبعث الله طائرا كأمثال أعناق الإبل تتقذفهم في البحر ويرسل الله مطرا فيغسل الأرض من نتنهم وذلك عند اقتراب الساعة(@)(@@)(@@)(@@) | 8932 - (@)(@@) أبو بكرة(@)(@@) ينزل الدجال هذه السبخة من قناة فيكون أكثر من يخرج إليه النساء حتى إن الرجل ليرجع إلى أمه وابنته وأخته وعمته وخالته فيوثقها أرباطا مخافة أن تخرج إليه(@)(@@)(@@)(@@) | 8933 - (@)(@@) أنس بن مالك(@)(@@) يكذب ابن آدم في عمره مرتين يكن(@)(@@) PageV00P000(@)(@@) صغيرا فيقول أنا كبير ويكن كبيرا فيقول أنا صغير(@)(@@)(@@)(@@) | 8934 - (@)(@@) أبو هريرة(@)(@@) يعقد الشيطان على قافية رأس أحدكم إذ هو نام ثلاث عقد يضرب مكان كل عقدة عليك ليلا طويلا فارقد فإن استيقظ فذكر الله انحلت عقدة فإن توضأ انحلت عقدة فأصبح نشيطا طيب النفس وإلا أصبح خبيث النفس كسلان(@)(@@)(@@)(@@) | 8935 - (@)(@@) أبو هريرة(@)(@@) ينزل عيسى بن مريم على ثمانمائة رجل وأربعمائة امرأة خيار من على الأرض وأصلح من مضى(@)(@@) فصل(@)(@@)(@@)(@@) | 8936 - (@)(@@) عباس بن عبد المطلب(@)(@@) يظهر الدين حتى يجاوز البحار بالخيل في سبيل الله ثم يأتي أقوام يقولون قد قرأنا القرآن من أقوامنا هل في أولئك خير أولئك منكم من هذه الأمة أولئك هم وقود النار(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8937 - (@)(@@) أبو أمامة(@)(@@) ينفع بإذن الله عز وجل من الجنون والجذام والبرص والعين والحمى يكتب أعوذ بكلمات الله التامات وأسمائه كلها عامة من شر السأمة والهامة ومن شر العين اللامة ومن شر حاسد إذا حسد ومن شر أبي قترة وما ولد(@)(@@)(@@)(@@) | 8938 - (@)(@@) الزبير بن العوام(@)(@@) يعمد أحدكم إلى ابنته ويزوجها القبيح الذميم إنهن يريدون ما تريدون(@)(@@)(@@)(@@) | 8939 - (@)(@@) يعلى وسلمة ابني أمية(@)(@@) يعمد أحدكم إلى أخيه فيعضه كعضاض النحل ثم يأتي يلتمس العقل لا عقل له(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8940 - (@)(@@) أبو هريرة(@)(@@) يعمد أحدكم في صلاته فيبرك كما يبرك الجمل(@)(@@)(@@)(@@) | 14 - (@)(@@) ابن عباس(@)(@@) يعمد أحدكم إلي جمرة من نار فيجعلها في يده ويزيل الخاتم من الذهب(@)(@@)(@@)(@@) | 8942 - (@)(@@) أبو هريرة(@)(@@) يعمد الشيطان إلى أحدكم فيقول له ثم يغدو بخير الناس 
ms622	 يعني حلم الشيطان(@)(@@)(@@)(@@) | 8943 - (@)(@@) أبو أيوب(@)(@@) يسئل أحدكم عن خبر السماء ويدع أظفاره وكأنها أظفار الطير يجمع فيها الجنابة والنفث(@)(@@)(@@)(@@) | 8944 - (@)(@@) مرداس الأسلمي(@)(@@) يذهب الصالحون الأول فالأول حتى تبقى حثالة لحثالة التمر والشعير لا يعبأ الله بهم شيئا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8945 - (@)(@@) عوف بن مالك(@)(@@) تخرب المدينة قبل يوم القيامة بأربعين سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8946 - (@)(@@) عثمان بن عفان(@)(@@) يشفع يوم القيامة الأنبياء والعلماء والشهداء(@)(@@)(@@)(@@) | 8947 - (@)(@@) أنس(@)(@@) يهرم ابن آدم ويبقى معه اثنتان الحرص والأمل أعوذ بالله وبالإسلام فإن قتل(@)(@@)(@@)(@@) | 8947 - (@)(@@) مكرر أنس(@)(@@) أعوذ بالله وبالإسلام فإن قتل كان شهيدا وإن قتل كان في النار(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 8948 - (@)(@@) أبو هريرة(@)(@@) يبصر أحدكم القذاة في عين أخيه وينسى الجذع والجذل في عينه(@)(@@)(@@)(@@) | 8949 - (@)(@@) عائشة(@)(@@) يغسل الميت أدنى أهله إليه فإن لم يعلم فأهل الأمانة وأهل الورع(@)(@@)(@@)(@@) | 8950 - (@)(@@) عائشة(@)(@@) يورث القسوة في القلب ثلاث خصال حب الطعام وحب النوم وحب الراحة(@)(@@)(@@)(@@) | 8951 - (@)(@@) علي(@)(@@) يرث الرجل الخاصة لأبيه وأمه دون أخوته لأبيه(@)(@@)(@@)(@@) | 8952 - (@)(@@) عمر بن الخطاب(@)(@@) يرث الولاء من يرث المال من ولد ووالد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8953 - (@)(@@) معاذ بن جبل(@)(@@) يجب على الرجل لامرأته ما يجب له عليها أن يتزين لها كما تتزين له في غير مأثم(@)(@@)(@@)(@@) | 8954 - (@)(@@) أبو هريرة(@)(@@) يلزم الوالدين من البر لولدهما ما يلزم الولد يؤدبانه ويزوجانه(@)(@@)(@@)(@@) | 8955 - (@)(@@) جابر(@)(@@) يكفيك من الكفن ملحفتان وإزار وما وراء ذلك فعقوبة وندامة(@)(@@)(@@)(@@) | 8956 - (@)(@@) معاوية بن يحيى بن المغيرة بن الحارث بن هشام(@)(@@) يكفي المؤمن الوقعة في الشهر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8957 - (@)(@@) أنس بن مالك(@)(@@) يجب على الإمام سكتتان سكتة عند افتتاح الصلاة فإذا قلت غير المغضوب عليهم ولا الضالين فيمكث حتى يقرأ من يبقى عليه منها شيء(@)(@@)(@@)(@@) | 8958 - (@)(@@) جابر بن عبد الله(@)(@@) ينزل الوافدون إلى الله عز وجل حتى يقفوا بين هذه الجبال فيقول الملبي لبيك اللهم لبيك فيجيبه الله لبيك وسعديك أجبت دعوتك وغفرت ذنبك وتقبلت نفقتك فاستأنف العمل(@)(@@)(@@)(@@) | 8959 - (@)(@@) أبو هريرة(@)(@@) ينزل عيسى بن مريم صلى الله عليه وسلم فيمكث أربعين سنة(@)(@@)(@@)(@@) | 8960 - (@)(@@) رافع بن كيسان(@)(@@) ينزل عيسى بن مريم عند باب دمشق 
ms623	 الشرقي عند المنارة البيضاء لست ساعات من النهار في ثوبين ممشقين كأنما يتحدر من رأسه اللؤلؤ(@)(@@)(@@)(@@) | 8961 - (@)(@@) أبو بكرة(@)(@@) ينزل طائفة من أمتي أرضا يقال لها البصرة(@)(@@) PageV00P000(@)(@@) قريبة من دجلة يكثر أهلها حتى تكون مصرا من الأمصار(@)(@@) فصل(@)(@@)(@@)(@@) | 8962 - (@)(@@) حذيفة(@)(@@) يأجوج ومأجوج ثلاثة كراهم منهم طول أحدهم عشرون ومائة ذراع ومنهم عشرون ومائة ومنهم من يلتحف أحدهم أذنه ويفرش الأخرى(@)(@@)(@@)(@@) | 8963 - (@)(@@) حذيفة(@)(@@) يأجوج ومأجوج أمة كل أمة أربعمائة ألف أمة لا يموت الرجل منهم حتى ينظر إلى ألف ذكر بين يديه من صلبه قد حمل السلاح لا يمرون بفيل ولا خنزير ولا وحش إلا أكلوه ومن مات منهم أكلوه مقدمتهم بالشام وسابقتهم بخراسان(@)(@@)(@@)(@@) | 8964 - (@)(@@) أبو هريرة(@)(@@) يحذرون في كل يوم حتى يكاد أن يروا شعاع الشمس فيقولون نرجع إليه غدا فيرجعون إليه وهو أشد ما كان حتى بلغت مدتهم فيجدونه كما تركوه فيحفرون فيخرجون على الناس فيفر الناس منهم(@)(@@)(@@)(@@) | 8965 - (@)(@@) عائشة(@)(@@) تنام عيناي ولا ينام قلبي(@)(@@)(@@)(@@) | 8966 - (@)(@@) أنس(@)(@@) يا أسفي على يوسف يا مصيبتي(@)(@@)(@@)(@@) | 8967 - (@)(@@) أبو هريرة(@)(@@) يلقى إبراهيم أباه آزر يوم القيامة وعلى وجه آزر قترة وغبرة فيقول له إبراهيم ألم أقل لك لا تعصني فيقول أبوه فاليوم لا أعصيك فيقول إبراهيم يا رب إنك وعدتني إلا تخزني يوم يبعثون فأي(@)(@@) PageV00P000(@)(@@) خزي أخزى من أبي إلا بعد فيقول الله تعالى إن حرمت الجنة على الكافرين(@)(@@) فصل(@)(@@)(@@)(@@) | 8968 - (@)(@@) أبو زهير الثقفي(@)(@@) يوشك أن تعلموا أهل الجنة من أهل النار خياركم من شراركم بالثناء الحسن والثناء السيء أنتم شهداء بعضكم على بعض(@)(@@)(@@)(@@) | 8969 - (@)(@@) ابن عباس(@)(@@) يوشك أن تروا شيطان الإنس يسمع أحدكم الحديث فيفشه على غيره فيصد الناس عن استماعه من صاحبه الذي يحدث به(@)(@@)(@@)(@@) | 8970 - (@)(@@) أبو سعيد(@)(@@) يوشك أن يكون خير مال الرجل المسلم غنيمته يتبع شعف الجبال ومواقع القطر يفر بدينه من الفتن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8971 - (@)(@@) أبو ذر(@)(@@) يوشك أن يكون أسعد الناس في الدنيا لكع بن لكع وأفضل الناس مؤمن بين كريمين(@)(@@)(@@)(@@) | 8972 - (@)(@@) عبد الله بن عمر(@)(@@) يوشك أن يظهر 
ms624	 العلم ويحزن العمل ويتواصل الناس بألسنتهم ويتباعدون فإذا فعلوا ذلك طبع الله على بقلوبهم وعلى سمعهم وعلى أبصارهم(@)(@@)(@@)(@@) | 8973 - (@)(@@) أبو سعيد(@)(@@) يوشك قلوب الناس أن تمتلئ شرا حتى يجري الناس فضلا بين الناس ما يجد قلبا يدخله ولا يزال الناس يسألون عن كل شيء حتى يقولوا كان الله قبل كل شيء فما كان قبل الله فإذا قالوا لكم فقولوا كان الله قبل كل شيء وليس فوقه شيء وهو الآخر بعد كل شيء فليس بعده شيء وهو الظاهر فوق كل شيء وليس فوقه شيء وهو الباطن دون كل شيء وليس دونه شيء وهو بكل شيء عليم فإن هم أعادوا المسألة فابصقوا في وجوههم فإن لم ينتهوا فاقتلوهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8974 - (@)(@@) حذيفة(@)(@@) يوشك أن يملأ الله أيديكم من العجم ويجعلهم أسدا لا يفرون فيضربون رقابكم ويأكلون فيكم(@)(@@)(@@)(@@) | 8975 - (@)(@@) أبو هريرة(@)(@@) يوشك أن يأتي على الناس زمان يسار فيه من غير شراب تزهق قلوبهم وأسماعهم فتصير منكوسة تسكر الأبصار من حب الدنيا وتقسوا القلوب بالعبرة إلى متاع الغرور فمن مات منهم يومئذ يميت حسرة حين لم يظفر بحاجته من الدنيا(@)(@@)(@@)(@@) | 8976 - (@)(@@) أبو هريرة(@)(@@) يوشك الإسلام أن يدرس لا يبقى إلا اسمه ويدرس القرآن فما يبقى إلا رسمه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8977 - (@)(@@) ثوبان(@)(@@) يوشك الأمم أن تداعى عليكم كما تداعى على القصعة أكلتها(@)(@@) غثاء كغثاء السيل ولينزعن الله المهابة من قلوبكم وليقذفن في قلوبكم الوهن حب الدنيا وكراهة الموت(@)(@@)(@@)(@@) | 8978 - (@)(@@) أبو هريرة(@)(@@) يوشك أن تظهر فتنة لا ينجي منها إلا الله أو دعاء كدعاء الغريق(@)(@@)(@@)(@@) | 8979 - (@)(@@) عبد الله بن رواح(@)(@@) يوشك أن يؤمر عليهم الرويجل(@)(@@) PageV00P000(@)(@@) فيجتمع عليهم قوم محلفة أقفيتهم بيض قمصهم فإذا أمرهم بشيء حصدوا(@)(@@)(@@)(@@) | 8980 - (@)(@@) أبو هريرة(@)(@@) يوشك من عاش معكم أن يرى عسي بن مريم إماما حكما عدلا يضع الجزية ويكسر الصليب ويقتل الخنزير وتضع الحرب أوزارها(@)(@@)(@@)(@@) | 8981 - (@)(@@) عبد الله بن عمرو(@)(@@) يوشك أن يأتي زمان يغربل فيه الناس غربلة وتبقى حثالة من الناس قد مرجت عهودهم وأماناتهم واختلفوا قيل فما تأمرنا قال تأخذون ما تعرفون 
ms625	 وتدعون ما تنكرون وتقبلون على أمر خاصتكم وتدعون أمر عامتكم(@)(@@) فصل(@)(@@) في تفسير آي القرآن(@)(@@)(@@)(@@) | 8982 - (@)(@@) علي بن أبي طالب(@)(@@) {يوم ندعوا كل أناس بإمامهم} بإمام زمانهم وكتاب ربهم عز وجل وبسنة نبيهم صلى الله عليه وسلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8983 - (@)(@@) علي بن أبي طالب(@)(@@) {يوم نحشر المتقين إلى الرحمن وفدا} أما والله ما يحشرون على أقدامهم ولا يساقون سوقا ولكنهم يؤتون بنوق الجنة لا ينظر الخلائق إلى مثلها أرجالها الذهب وأزمتها الزبرجد فيقعدون عليها حتى يقرعون باب الجنة(@)(@@)(@@)(@@) | 8984 - (@)(@@) ابن عمر {يوم يقوم الناس لرب العالمين} مقدار نصف يوم يهون ذلك المقام على المؤمن كتدني الشمس للغروب(@)(@@)(@@)(@@) | 8985 - (@)(@@) ابن مسعود(@)(@@) {يوم تبدل الأرض غير الأرض} بيضاء كأنها فضة لم يسفك فيها دم حرام ولم يعمل فيها خطيئة(@)(@@)(@@)(@@) | 8986 - (@)(@@) ابن عمر(@)(@@) {يوم تبيض وجوه وتسود وجوه} تبيض وجوه أهل السنة وتسود وجوه أهل البدع(@)(@@)(@@)(@@) | 8987 - (@)(@@) أبو سعيد(@)(@@) {يوم يأتي بعض آيات ربك} طلوع الشمس من مغربها(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 8988 - (@)(@@) ابن عمر(@)(@@) يوم القيامة أول يوم نظرت فيه عين إلى الله عز وجل(@)(@@)(@@)(@@) | 8989 - (@)(@@) أبو هريرة(@)(@@) يوم عاشوراء عيد نبي كان قبلكم فصوموا أنتم(@)(@@)(@@)(@@) | 8990 - (@)(@@) ابن مسعود(@)(@@) يوم كلم الله عز وجل موسى كان عليه جبة صوف وكساء صوف وسراويل صوف وكمة صوف ونعلين من جلد حمار غير ذكي الكمة القلنسوة(@)(@@)(@@)(@@) | 8991 - (@)(@@) أبو هريرة(@)(@@) يوم الجمعة يوم عيد وذكر فلا تجعلوا عيدكم يوم صيامكم ولكن اجعلوا يوم ذكر لا تختلطوا بأيام(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8992 - (@)(@@) محجز بن الأكوع(@)(@@) يوم الخلاص وما يوم الخلاص ثلاث مرات فقيل يا رسول الله وما يوم الخلاص قال يجيء الدجال فيصعد أحدا فينظر إلى المدينة فيقول لأصحابه انظروا إلى هذا القصر الأبيض هذا مسجد أحمد ثم يأتي المدينة فيجد بكل ثقب من ثقابها ملكا(@)(@@)(@@)(@@) | 8993 - (@)(@@) أبو هريرة(@)(@@) يوم القيامة على المؤمنين كقدر ما بين الظهر والعصر(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8994 - (@)(@@) أنس بن مالك(@)(@@) يوم الجمعة يوم تفعل ويوم قيام القيام المجامعة وتفعل تزين المرأة لزوجها(@)(@@)(@@)(@@) | 8995 - (@)(@@) جابر(@)(@@) يوم الجمعة ثلاث عشر ساعة لا يوجد عبد مسلم 
ms626	 يسأل الله شيئا إلا أعطاه إياه فالتمسوها آخر ساعة بعد العصر(@)(@@)(@@)(@@) | 8996 - (@)(@@) أبو سعيد(@)(@@) يوم السبت يوم مكر وخديعة والأحد يوم غرس وبناء والاثنين يوم سفر وطلب رزق ويوم الثلثاء يوم حديد وبأس شديد ويوم الأربعاء يوم الأخذ ولا عطاء ويوم الخميس يوم دخول على السلطان وطلب حوائج والجمعة يوم خطبة ونكاح(@)(@@)(@@)(@@) | 8997 - (@)(@@) جابر بن عبد الله(@)(@@) يوم الأربعاء يوم نحس مستمر(@)(@@)(@@)(@@) | 8998 - (@)(@@) عائشة(@)(@@) يوم عرفة يوم يعرفون والأضحى يوم يضحى الإمام والفطر يوم يفطر الإمام(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 8999 - (@)(@@) عمر بن الخطاب(@)(@@) يوم يموت عثمان تصلي عليه ملائكة السماء(@)(@@)(@@)(@@) | 9000 - (@)(@@) ابن عباس(@)(@@) يوم من أيام العادل أفضل من عبادة الرجل ستين سنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9001 - (@)(@@) أبو سعيد(@)(@@) يومان من الدهر لا تصومهما وساعتان من النهار لا تصلوا فيهما فإن النصارى يتحرونها يوم الفطر ويوم الأضحى وبعد صلاة الفجر حتى تطلع الشمس وبعد صلاة العصر إلى غروب الشمس(@)(@@) ذكر فصول آخر في فصل مالم يسم فاعله(@)(@@)(@@)(@@) | 9002 - (@)(@@) ابن مسعود(@)(@@) يقال للصادق صدق وبر ويقال للكاذب كذب وفجر ألا وإن العبد يكذب حتى يكتب عند الله كاذبا(@)(@@)(@@)(@@) | 9003 - (@)(@@) ابن عمر(@)(@@) تفتح أبواب السماء لخمس لقراءة القرآن(@)(@@) PageV00P000(@)(@@) وللقاء الزاحفين ولنزول القطر ولدعوة المظلوم وللآذان(@)(@@)(@@)(@@) | 9004 - (@)(@@) معاذ بن جبل(@)(@@) يقال للإمام العادل في قبره أبشر فإنك رفيق محمد(@)(@@)(@@)(@@) | 9005 - (@)(@@) عبد الرحمن بن سمرة(@)(@@) يقال للجلواز يوم القيامة دع سوطك وادخل النار(@)(@@)(@@)(@@) | 9006 - (@)(@@) أنس بن مالك(@)(@@) يوقف عبدان بين يدي الله عز وجل يوم القيامة فيأمر بهما إلى الجنة فيقولان يا ربنا بما أستأهلنا منك الجنة ولم نعمل عملا يجازينا الجنة فيقول الله عز وجل لهما عبداي ادخلا الجنة فإني اليت على نفسي أن لا يدخل النار من اسمه أحمد ومحمد(@)(@@)(@@)(@@) | 9007 - (@)(@@) أبو سعيد الخدري(@)(@@) تقسم الجنة يوم القيامة على عشرة(@)(@@) PageV00P000(@)(@@) آلاف جزء فتسعة آلاف وتسعمائة وتسعة وتسعون جزءا لأهل العقل وجزء واحد لسائر المؤمنين الغافلين ولصعاليك المهاجرين(@)(@@)(@@)(@@) | 9008 - (@)(@@) ابن مسعود(@)(@@) يفسح للغريب في قبره كبعده عن أهله(@)(@@)(@@)(@@) | 9009 - (@)(@@) أبو هريرة(@)(@@) يكتب للرجل في ركعتي الضحى ألف ألف حسنة 
ms627	(@)(@@)(@@)(@@) | 9010 - (@)(@@) ابن عمر(@)(@@) يرفع الأيدي عند سبع مواطن عند افتتاح الصلاة وعند القنوت وعند الوتر وعند البيت وعلى الصفا والمروة وبعرفات والمزدلفة وعند الموقفين وعند الجمرتين(@)(@@)(@@)(@@) | 9011 - (@)(@@) عقبة بن عامر(@)(@@) يكتب في كل إشارة يشير في صلاته عشر حسنات بكل إصبع حسنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9012 - (@)(@@) ابن عمر(@)(@@) يحمل هذا العلم من كل خلف عدو له ينفون عنه تحريف الغالين وانتحال المبطلين وتأويل الجاهلين(@)(@@)(@@)(@@) | 9013 - (@)(@@) أبو هريرة(@)(@@) يكره الضحك في موضعين عند رؤية الهلال وعند رؤية القرد(@)(@@)(@@)(@@) | 9014 - (@)(@@) علي(@)(@@) يكتب أنين المريض فإن كان صابرا كان أنينه حسنات وإن كان أنينه جزعا كتب هلوعا لا أجر له(@)(@@)(@@)(@@) | 9015 - (@)(@@) أنس(@)(@@) يكتب للصغير الحسنات ولا يكتب عليه السيئات(@)(@@) PageV00P000(@)(@@) وتكون حسناته لأبويه فإذا بلغ كتب عليه السيئات والحسنات(@)(@@)(@@)(@@) | 9016 - (@)(@@) أنس(@)(@@) يعذب اللسان بعذاب لا يعذب به شيئا من الجوارح فيقال له خرجت منك كلمة بلغت مشارق الأرض ومغاربها فسفك بك الدم الحرام وانتهك الفرج الحرام فوعزتي لأعذبنك بعذاب لا أعذب به شيئا من الجوارح(@)(@@)(@@)(@@) | 9017 - (@)(@@) أنس(@)(@@) يعذب المذنبون على قدر نقصان إيمانهم(@)(@@)(@@)(@@) | 9019 - (@)(@@) ابن عمر(@)(@@) يمسخ المكذبون بالقدر في قبورهم قردة وخنازير(@)(@@)(@@)(@@) | 9019 - (@)(@@) عبد الله بن عمرو(@)(@@) يلحد بمكة رجل من قريش يقال له عبد الله عليه نصف عذاب العالم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9020 - (@)(@@) أم سلمة(@)(@@) يقتل حسين بن علي على رأس ستين من مهاجري حين يعلوه القتير القتير الشيب(@)(@@)(@@)(@@) | 9021 - (@)(@@) البراء بن عازب(@)(@@) يكسى الكافر لوحين من نار في قبره فذلك قوله عز وجل {لهم من جهنم مهاد} {ومن فوقهم غواش وكذلك نجزي الظالمين}(@)(@@)(@@)(@@) | 9022 - (@)(@@) أبو هريرة(@)(@@) يستجاب لأحدكم مالم يعجل فيقول رب قد دعوت فلم يستجب لي(@)(@@)(@@)(@@) | 9023 - (@)(@@) عائشة(@)(@@) يستحب النكاح في رمضان رجاء البركة(@)(@@) فصل(@)(@@)(@@)(@@) | 9024 - (@)(@@) عبد الله بن عمر(@)(@@) يقتل هذا يومئذ مظلوما فنظرت إليه فإذا هو عثمان بن عفان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9025 - (@)(@@) أبو هريرة(@)(@@) يغسل الإناء من الهر كما يغسل من الكلب(@)(@@)(@@)(@@) | 9026 - (@)(@@) أنس(@)(@@) يعطى الشهيد ثلاثا أول قطرة من دمه غفر الله له ذنوبه وأول من يمسح التراب عن وجهه زوجته من الحور العين فإذا 
ms628	 رفع جنبه وقع في الجنة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9027 - (@)(@@) ابن مسعود(@)(@@) يفتح الله أبواب السماء في ثلث الليل الباقي(@)(@@)(@@)(@@) | 9028 - (@)(@@) أنس بن مالك(@)(@@) يعاد الوضوء من الرعاف السائل(@)(@@)(@@)(@@) | 9290 - (@)(@@) عائشة(@)(@@) يغتسل من أربع من الجنابة والجمعة والحجامة وغسل الميت(@)(@@)(@@)(@@) | 9030 - (@)(@@) علي بن أبي طالب(@)(@@) ينضح بول الغلام ويغسل بول الجارية يعني ما لم يطعم فإذا أطعم غسلا غسلا جميعا(@)(@@)(@@)(@@) | 9031 - (@)(@@) جابر بن عبد الله(@)(@@) يترك الغريق يوما وليلة ثم يدفن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9032 - (@)(@@) عائشة(@)(@@) يقطع اليد في ربع دينار فصاعدا(@)(@@)(@@)(@@) | 9033 - (@)(@@) واثلة بن الأسقع(@)(@@) يضمن المقدم على الدأية ثلثي ما أصاب وهو راكب ويضمن الوديعة الثلث(@)(@@)(@@)(@@) | 9034 - (@)(@@) ابن عباس(@)(@@) يؤدي المكاتب وبقدر ما عتق منه من دية الحر ويقدر ما رق منه دية العبد(@)(@@)(@@)(@@) | 9035 - (@)(@@) عائشة(@)(@@) يرد من صدقه الجانف في حياته ما يرد من وصية المجنف عند موته(@)(@@) PageV00P000(@)(@@) فصل(@)(@@)(@@)(@@) | 9036 - (@)(@@) حاطب(@)(@@) يزوج المؤمن في الجنة ثنتين وسبعين زوجة سبعين من نساء الآخرة وثنتين من نساء الدنيا(@)(@@)(@@)(@@) | 9037 - (@)(@@) جابر(@)(@@) يمثل القرآن يوم القيامة رجلا يؤتى بالرجل قد حمله مخالف أمره فينثل له خصما فيقول يا رب حملته إياي فبئس حامل تعدى حدودي وضيع فرائضي وركب معصيتي وترك طاعتي فما يزال يقذف عليه بالحجج حتى يقال شائكه فيأخذه بيده فما يرسله حتى يكبه على صخرة في النار(@)(@@)(@@)(@@) | 9038 - (@)(@@) أسماء بنت أبي بكر(@)(@@) يكفيكم من العظة ذكر الموت(@)(@@) PageV00P000(@)(@@) ويكفيكم من النفل ذكر الآخرة ويكفيكم من العبادة الورع ويكفيكم من الاستغفار ترك الذنوب ويكفيكم من الدعاء النصيحة ومن كانت فيه من هذه الخصال واحدة دخل الجنة مع أول زمرة الأنبياء(@)(@@)(@@)(@@) | 9039 - (@)(@@) جابر(@)(@@) يمثل الشمس للميت في قبره عند غروبها فيقوم فيمسح عينيه فيقول دعوني أصلي(@)(@@)(@@)(@@) | 9040 - (@)(@@) أبو سعيد(@)(@@) يسلط على الكافر في قبره تسعة وتسعين تنينا ينهشه ويلدغه حتى تقوم الساعة ولو أن تنينا منها نفخ في الأرض ما أنبتت خضرا(@)(@@)(@@)(@@) | 9040 - (@)(@@) مكرر ابن عمر(@)(@@) يسلطه الله عز وجل على ابن آدم ما خافه ولو أن ابن آدم لم يخف غير الله لم يسلط الله عليه غيره(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9041 
ms629	 - (@)(@@) ابن عمر(@)(@@) يعظم أهل النار حتى يصير ما بين شحمتي أذن أحدهم إلى عاتقه مسيرة سبعمائة عام(@)(@@)(@@)(@@) | 9042 - (@)(@@) أبو هريرة(@)(@@) يعظم الكافر في النار حتى يكون مقعده مسيرة ثلاثة أيام للراكب(@)(@@)(@@)(@@) | 9043 - (@)(@@) أسماء بنت أبي بكر(@)(@@) يعمر الدجال أربعين سنة السنة كالشهر والشهر كالجمعة والجمعة كاليوم واليوم كاحتراق السعفة في النار(@)(@@) فصل من ذوات الألف واللام(@)(@@)(@@)(@@) | 9044 - (@)(@@) ابن مسعود(@)(@@) اليد العليا خير من اليد السفلى واليد العليا للنفقة والسفلى السائلة إلى يوم القيامة(@)(@@)(@@)(@@) | 9045 - (@)(@@) ابن عمر(@)(@@) اليدان يسجدان كما يسجد الوجه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9046 - (@)(@@) أبو سعيد(@)(@@) اليدان جناحان والرجلان بريدان والأذنان قمعان والعينان دليلان واللسان ترجمان القلب ملك فإذا فسد الملك فسد سائره(@)(@@)(@@)(@@) | 9047 - (@)(@@) أبو مالك الأشعري(@)(@@) اليوم الموعود يوم القيامة والشاهد يوم الجمعة والمشهود يوم عرفة(@)(@@) PageV00P000(@)(@@) PageV05P547(@)(@@)(@@)(@@) | 9048 - (@)(@@) يزيد بن بشير(@)(@@) اليوم انتصفت العرب من العجم(@)(@@)(@@)(@@) | 9049 - (@)(@@) معاذ بن جبل(@)(@@) اليسير من الرياء شرك وإن الله عز وجل يحب الأتقياء الأخفياء الأبرياء الذين إذا غابوا لم يفتقدوا وإن حضروا لم يعرفوا قلوبهم مصابيح الهدى ينجون من كل غبراء مظلمة(@)(@@)(@@)(@@) | 9050 - (@)(@@) عمر بن الخطاب(@)(@@) اليتيم إذا بكى اهتز العرش ببكائه يقول الرحمن عز وجل لملائكته أبكي عبدي وأنا توفيت أباه وداريته في(@)(@@) PageV00P000(@)(@@) التراب فيقولون ربنا لا علم لنا قال اشهدوا من أرضاه وأرضيته يوم القيامة(@)(@@)(@@)(@@) | 9051 - (@)(@@) عائشة(@)(@@) اليمين أولى بالزينة من الشمال وإنما الشمال خادم اليمين يعني التختم(@)(@@)(@@)(@@) | 9052 - (@)(@@) سعيد بن جبير(@)(@@) اليسر يمن والعسر شؤم(@)(@@)(@@)(@@) | 9053 - (@)(@@) أبو الدرداء(@)(@@) اليمين الكاذبة التي يقتطع الرجل مال أخيه تدر الديار بلاقع(@)(@@)(@@)(@@) | 9054 - (@)(@@) أبو هريرة(@)(@@) اليمين الغموس عند البيع منفقة للسلعة ممحقة للكسب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 9055 - (@)(@@) أبو سويد الغرابي(@)(@@) اليمين الغموس يعقم الرحم سميت غموسا لغمسها صاحبها في الإثم في النار(@)(@@)(@@)(@@) | 9056 - (@)(@@) أبو هريرة(@)(@@) اليمين على نية المستحلف(@)(@@) آخر كتاب الفردوس والحمد لله رب العالمين والعاقبة للمتقين والصلاة على رسوله محمد وآله الطيبين الطاهرين وأصحابه المنتخبين وأزواجه أمهات المؤمنين وسلم تسليما كثيرا وحسبنا الله ونعم الوكيل نجز منه بحمد الله يوم السبت ثاني عشرين شهر شوال سنة ثمانين 
ms630	 وثلاثين وثمان مائة(@)(@@) عن أنس بن مالك رضي الله عنه قال قال رسول الله صلى الله عليه وسلم(@)(@@) لا تكرهوا الرمد فإنه يقطع عروق العمى ولا تكرهوا الزكام فإنه يقطع عروق الجذام ولا تكرهوا الدمامل فإنه يقطع عروق المرض ولا تكرهوا السعال فإنه يقطع عروق الفالج رواه أبو منصور الديلمي في مسنده الفردوس عن والده بسند إلى الحارث(@)(@@) الحمد لله الذي بنعمته تتم الصالحات PageV00P000 
