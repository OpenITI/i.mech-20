ms41	 عذري بحسن من % % همت فيه من غير مين % 7(@)(@@) % بدر تم مركب % % في قضيب من اللجين % 8(@)(@@) % وجهه الروض والحيا % % منه معسول ريقتين % 9(@)(@@) % حسن ريحانتيه قد % زاد ضعفا بالجنتين % 10(@)(@@) % لو حباني من ريقه % كان ترياق عقربين % PageV01P145 11(@)(@@) % زين الله خده % لعذابي بشامتين % 12(@)(@@) % ذاك كيما يفوز من % شيمة الحسن باثنتين % 13(@)(@@) % كان فردا لأجل ذا % % ملك الحسن مرتين % 14(@)(@@) % فلكل علامة % وهو يحوي علامتين % 15(@)(@@) % كيف أخشى اشتراكه % % وهو قد حاز رقتين % 16(@)(@@) % لا يرى الشيء مشكلا % وهو يقرا لبينتين % 17(@)(@@) % و دليلي على الذي % % قلته ذو الوزارتين % 18(@)(@@) % لفظة لا ترى لها % % في الأنام مسميين % 19(@)(@@) % فهو يختص واحد % ليس بالعدوتين % 20(@)(@@) % سيدا من قضاعة % % خير سام من سيدين % PageV01P146 21(@)(@@) % أخذ الجود والعلا % % شخصه بالوراثتين % 22(@)(@@) % من أبيه وجده % فهو حسن ذو حسنيين % 23(@)(@@) % مثل بسارين في % % أساليف النيرين % 24(@)(@@) % لو بغى المجد فوقه % أصبحا فيه فرقدين % 25(@)(@@) % إنني مقسم به % والمصلى والمأزمين % 26(@)(@@) % لا يوازيه في العلا % % و به . . . . القضيتين % 27(@)(@@) % موئلي يا أبا علي % % يا رجائي من كل أين % 28(@)(@@) % قد كفاني ما حل بي % % من خمول وفرط بين % 29(@)(@@) % و اطراحي لكل دين % و أخذي لكل دين % 30(@)(@@) % لا تدعني بعد الجفا % % أتمنى خفي حنين % PageV01P147 31(@)(@@) % أنت تدري سريرتي % % دون شك ، باسم وعين % 32(@)(@@) % وشهيدي في كل ما % % أدعيه فتى رعين % PageV01P148 البحر : بسيط تام 1(@)(@@) % طاول بجدك فالأقدار عنوان % و احكم فما لصروف الدهر عصيان % 2(@)(@@) % عليك حزم وأمر نافذ وعلى % % ريب الحوادث تسليم وإذعان % 3(@)(@@) % لكم سعود على الأعداء نافذة % وفت لكم حيث حد السيف خوان % 4(@)(@@) % ترى المقاتل أنصارا وربتما % % أصغت لأمر المنايا فهي آذان % 5(@)(@@) % إن الملوك وإن عزوا وإن كثروا % % و خالفوك فقد ذلوا وقد هانوا % % 6(@)(@@) % إن يحسدوك أبا العباس فهو لكم % ذكر جميل وللحساد أشجان % 7(@)(@@) % و ما على الشمس في أن لاح رونقها % % فأنكرته العيون الرمد ، نقصان % 8(@)(@@) % أعد توفيقك الأسطول يقدمها % % ندب أتى الملك عينا وهو 
ms42	 إنسان % 9(@)(@@) % محمد وكفانا من فتى هرمت % به الليالي وقارا وهي شبان % 10(@)(@@) % لما زكا غصنا في دوح سؤددكم % % تاهت قنا الخط لما قيل أغصان % PageV01P149 11(@)(@@) % القائد الخيل مجدولا أياطلها % % كأنما هي في الأرسان أرسان % 12(@)(@@) % % كأنما هي فوق الهام تيجان % 13(@)(@@) % رقت حنينا إلى الإعجاب ، لا عجبا % أن رق حب إلى الأوطان حنان % 14(@)(@@) % حامي الذمار ونار الحرب حامية % طلق المحيا وحد السيف غضبان % 15(@)(@@) % يبكي الصفاح نجيعا وهو مبتسم % ويوسع السمر ريا وهو ظمآن % 16(@)(@@) % يرى الدماء عقارا والظبى زهرا % فالحرب في زعمه راح وريحان % 17(@)(@@) % يرمي به البحر في فلك زجرت بها % % طيرا لهن من الألواح أبدان % 18(@)(@@) % كأنما البحر معنى مشكل صدعت % عويص أشكاله منهن أذهان % 19(@)(@@) % خضر ودهم وحمر ما بدت علمت % بها أعاديك أن الموت ألوان % 20(@)(@@) % فالخضر قضب لها الأعلام عن ورق % لو أثمرت قبلها بالحتف قضبان % PageV01P150 21(@)(@@) % و الحمر يرمي بها الموج الخضم كما % % تختال في زهرات الورد كثبان % 22(@)(@@) % والدهم تستوقف الأبصار حكمتها % % كأنها فوق خد الماء خيلان % 23(@)(@@) % كأنما عدوها إثر الطريد بها % % رقص بحيث صليل الهند ألحان % 24(@)(@@) % بعصبة أنهضوا للموت وائتمنوا % % على الحفاظ فما خانوا ولا حانوا % % 25(@)(@@) % أعطافهم مثل ما هزوه مائلة % وجوههم مثل ما سلوه غران % 26(@)(@@) % أعطاهم الحزم أيمانا مؤيدة % أن الضلال ذليل حيثما كانوا % % 27(@)(@@) % إن شئت رعت بهم أرض الشقاء فلم % يعضده من دولة المخذول صلبان % 28(@)(@@) % فقبلكم ما أتى موسى بآيته % % مصرا فلم يغن عن فرعون هامان % 29(@)(@@) % و هل ينازعكم من عزمه عبث % كالريح لم يجرها منه سليمان % 30(@)(@@) % لولاك لم يحسد الملح الفرات ولا % % جنت بسبتة يوم الفخر بغدان % PageV01P151 31(@)(@@) % قد طاب ذكرك حتى الشهد مطرح % و فاح حتى استبين المسك والبان % 32(@)(@@) % و الناس شتى أعاد في مذاهبهم % لكنهم في هواك اليوم إخوان % 33(@)(@@) % يأوي لظلك محمي ومطرد % كالروض يرتاده ظبي وسرحان % 34(@)(@@) % ويشتهي جودكم مثر وذو عدم % كالخمر يعشقها صاح ونشوان % 35(@)(@@) % ملك فتى البأس كهل الرأي متضح 
ms43	 % عالي الذؤابة رحب الباع يقظان % 36(@)(@@) % أغر للجاه منه منطق سدد % إلى الصواب وبعض الجاه إلحان % 37(@)(@@) % كأنما الناس ألفاظ لهن به % رفع وخفض وتحريك وإسكان % 38(@)(@@) % من كل قول له فصل يصيب به % و كل فعل له بالعدل ميزان % 39(@)(@@) % وكل وقت ربيع من خلائقه % وكل روض به في الطيب بستان % 40(@)(@@) % حمل الأما نة هي ن في سجيته % و هل يحس حصاة فيه ثهلان % PageV01P152 41(@)(@@) % إذا تكلم أصغى الدهر مستمعا % كما يصيخ لداعي الماء ظمآن % 42(@)(@@) % كأنما بردتا أثواب هيبته % كسرى ويأخذ عنه الرأي لقمان % 43(@)(@@) % جزى الإساءة بالحسنى مسامحة % حتى تخيل أن الذنب قربان % 44(@)(@@) % يا دهر شد عليه كف ذي مقة % وابخل به إن بعض البخل إحسان % 45(@)(@@) % وأنت متهم إلا عليه ، فها % % علق به سبتة تحظى وتزدان % PageV01P153 البحر : رمل تام 1(@)(@@) % يا سمي المصطفى يا بغيتي % % يا منى نفسي وحظي من زماني % % 2(@)(@@) % علقت منك بناني أملا % ليس لي منه سوى عض بناني % % 3(@)(@@) % يا غزالا صاد آساد الشرى % % و قضيبا قد سبى سمر الطعان % 4(@)(@@) % برح الشوق إلى عينيك بي % % عجبا أصبو لسهمي من رماني % % 5(@)(@@) % لوعة بي منك أم بي لمم % ما النهى والحب إلا طرفان % 6(@)(@@) % قل لحب الصب عنه آسلم وكن % % من سلوي واصطباري في أمان % 7(@)(@@) % شغف قيد ما يبرحني % % وفؤاد مولع بالطيران % 8(@)(@@) % ضمنت طول غرامي مقلة % تتلف الأنفس في غير ضمان % 9(@)(@@) % مائل بالود عني نافر % مرح كالمهر يطغى في العنان % 10(@)(@@) % ليس بدعا نفرة من شادن % فرق أو ميلة من غصن بان % PageV01P154 11(@)(@@) % فر من عدن وقد بان على % % حسنه آثارها أي بيان % 12(@)(@@) % فجرى في مرشفيه كوثر % وازدهت في وجنتيه جنتان % 13(@)(@@) % أنكر العذال إعلاني به % شأن من يعذل فيه غير شاني % % 14(@)(@@) % الهوى عندي إيمان فلا % % بد منه في فؤاد ولسان % PageV01P155 البحر : خفيف تام 1(@)(@@) % رع بجيش اللذات سرب الشجون % و خذ الكأس راية باليمين % 2(@)(@@) % لا تردن بالتنصل نصل اللو % % م واقلب له مجن 
ms44	 المجون % 3(@)(@@) % طلعت أنجم الكؤوس سعودا % منذ قابلن أنجم الياسمين % % 4(@)(@@) % و ظلال القضب اللطاف على النر % % جستحكي مراودا في عيون % % 5(@)(@@) % آنساني وكفكفا دمع عيني % % بسلاف كدمعة المحزون % % 6(@)(@@) % ألفا جوهر الأزاهر والقط % % ر إلى جوهر الحباب المصون % % 7(@)(@@) % و انظماها في ليلة الأنس عقدا % ملك كسرى لديه غير ثمين % % 8(@)(@@) % كيف أمنتما على الشرب شخصا % لحظه في القلوب غير أمين % % 9(@)(@@) % قام يسقي فصب في الكأس نزرا % ثقة منه بالذي في الجفون % % 10(@)(@@) % و أتى نطقه بلحن فأغنى % % عن سماع الغناء والتلحين % % PageV01P156 11(@)(@@) % إن نار الحياء في خد موسى % % جنة تثمر المنى كل حين % % 12(@)(@@) % قسما لا أحبه وأنا أق % % سم أني حنثت في ذي اليمين % % 13(@)(@@) % بدر تم له تمائم كانت % % وهي برء الجنون أصل الجنون % % 14(@)(@@) % لو رقاني بريقه لشفى مك % % نون همي بلؤلؤ مكنون % % 15(@)(@@) % أنا في ظلمة العجاج شجاع % وجبان في نور ذاك الجبين % % 16(@)(@@) % كتب الشعر فيه سينا فعوذ % % ت بياسين حسن تلك السين % % 17(@)(@@) % أتقي أعين الظباء ولك % % ن قلوب الآساد قد تتقيني % % 18(@)(@@) % فكأني النوار بجنيه ظبي % حين لا يجتنيه ليث العرين % % 19(@)(@@) % كم نهاني عن حب موسى أناس % عذلوني ، فإن بدا عذروني % % 20(@)(@@) % أكبروه ولم تقطع أكف % بمدى بل قلوبهم بجفون % % PageV01P157 21(@)(@@) % ليتني نلت منه حظا وأجلت % ليلة الوصل عن صباح المنون % % 22(@)(@@) % و قرأنا باب المضاف عناقا % و حذفنا الرقيب كالتنوين % % PageV01P158 البحر : طويل 1(@)(@@) % ضمان على عينيك أني عان % صرفت إلى أيدي العناء عناني % % 2(@)(@@) % وقد كنت أرجو الوصل نيل غنيمة % فحسبي فيه اليوم نيل أمان % 3(@)(@@) % أطعت هوى طرفي لحتفي لو أنني % % غضضت جفوني ما عضضت بناني % % 4(@)(@@) % ومن لي بجسم أشتكي منه بالضنى % % وقلب فأشكو منه بالخفقان % % 5(@)(@@) % و ما عشت حتى الآن إلا لأنني % % خفيت فلم يدر الحمام مكاني % % 6(@)(@@) % ولو أن عمري عمر نوح وبعته % % بساعة وصل منك قلت : كفاني % % 7(@)(@@) % و ما ماء ذاك الثغر عندي غالبا % بماء شبابي واقتبال زماني % % 8(@)(@@) % إذا اليأس 
ms45	 ناجى النفس منك بلن ولا % % أجابت ظنوني : ربما وعساني % % 9(@)(@@) % خليلي عندي للسلو بلادة % فإن شئتما علم الهوى فسلاني % % 10(@)(@@) % خذا عددا من مات من أول الهوى % % فإن كان فردا فاحسباني ثاني % % PageV01P159 11(@)(@@) % فإن قال شخص : أين أعشق عاشق % تخيلته دون الأنام عناني % % 12(@)(@@) % مراضع موسى أو وصال سميه % % نظيران في التحريم يشتبهان % % 13(@)(@@) % أقول وقد طال السهاد بذكره % % وقد كل نسر الشهب بالطيران % % 14(@)(@@) % وقد خفق البرق الطروب كأنه % % حسام شجاع أو فؤاد جبان % % 15(@)(@@) % يشق حداد الليل منه براحة % مخضبة أو درعه بسنان % % 16(@)(@@) % تراءى لعيني خلبا وانتجعته % % فأمطرني من مقلتي وسقاني % % 17(@)(@@) % أشار تجاهي بالسلام فلو دعا % % بها البرق قبلي عاشقا لدعاني % % 18(@)(@@) % فبت بأشواقي قتيلا وإنما % % نجيعي دمعي فاض أحمر قان % % 19(@)(@@) % كأن نجوم الليل حولي مآتم % غراب الدجى ما بينهن نعاني % % 20(@)(@@) % خررت لذكراه على الترب ساجدا % فإن لاح من قرب فكيف تراني % % PageV01P160 البحر : طويل 1(@)(@@) % يمينا بديني إنه الحب فيك أو % % بقبلة نسكي إنه وجهك الحسن % 2(@)(@@) % لحبك من قلبي وإن سلط الضنى % % على جسدي أشفى من الروح للبدن % 3(@)(@@) % فيا وطن السلوان والعشق غربة % ألا عودة بالله في ذلك الوطن ! % 4(@)(@@) % لقد طال حرب النوم فيك لناظري % % ألا هدنة منه ودعها على دخن % 5(@)(@@) % يظن هوى موسى بأني قتيله % % سأجعل نفسي فيه والله حيث ظن % PageV01P161 البحر : كامل تام 1(@)(@@) % جاهدت في تمهيد حمص راحلا % عنها وزنت فناءها مستوطنا % % 2(@)(@@) % كالنجم حل محسنا في أفقه % وانقض منه حاميا ومحصنا % % 3(@)(@@) % كالسيف أغمده يكن لك حلية % أو لا فجرده يكن لك مأمنا % % 4(@)(@@) % كالبي كان من القصيدة بيتها % % و ازداد حسنا حين جاء مضمنا % % 5(@)(@@) % كالغيث في البلد المحيل أتى على % % حسن الدعاء وسار عن حسن الثنا % % 6(@)(@@) % ولقد تهادتك البلاد فأنت ري % % حان هناك وأنت نوار هنا % % 7(@)(@@) % باراك قوم في العلا ولعلة % عز الجمان إذا الحصى لا يقتنى % % 8(@)(@@) % زج القناة مشابة لسنانها % % حتى يهم محارب أن يطعنا % % 9(@)(@@) % دع من ينازعك الغناء 
ms46	 فإنه % خرس ينازع معبدا حسن الغنا % % PageV01P162 البحر : سريع 1(@)(@@) % ولازورد باهر نوره % مستظرف الأوصاف مستحسن % 2(@)(@@) % كأنه من حسن مرآه قد % % ذابت عليه زرقة الأعين % PageV01P163 البحر : كامل تام 1(@)(@@) % لي صاحب ترك النساء تظرفا % منه ومال إلى هوى الغلمان % 2(@)(@@) % فعذلته يوما وقد أبصرته % يعنى بقود فلانة لفلان % 3(@)(@@) % فأجابتني إن اللواط إذا عتا % % قد بنثني قودا على النسوان % PageV01P164 البحر : كامل تام 1(@)(@@) % لا تركنن مع الذنوب لعزة % إن المريب بذعره متكفن % 2(@)(@@) % الصبر عما أشتهيه أخف من % % صبري لما لا أشتهيه وأهون % PageV01P165 البحر : وافر تام 1(@)(@@) % أشمس في غلالة أرجوان % وبدر طالع في غصن بان % 2(@)(@@) % وثغر ما أرى أم نظم در % و لحظ ما حوى أم صارمان % 3(@)(@@) % و خد فيه تفاح وورد % عليه من العقارب حارسان % 4(@)(@@) % و يعذلني العواذل فيه جهلا ، % عزير ما يقول العاذلان % % 5(@)(@@) % فقالوا : عبد موسى قلت : حقا % فقالوا : كيف ذا ؟ قلت : اشتراني % % 6(@)(@@) % فقالوا : هل عليك بذا ظهير % فقلت : نعم علي وشاهدان % % 7(@)(@@) % فقالوا : : هل رضيت تكون عبدا % لقد عرضت نفسك للهوان % % 8(@)(@@) % فقلت : نعم أنا عبد ذليل % لمن أهوى فخلوني وشاني % % 9(@)(@@) % بنفسي من يفديني بنفس % جعلت فداه لما أن فداني % % 10(@)(@@) % سألتك حاجة إن تقضها لي % % فقال : نعم قضيت وحاجتان % % PageV01P166 11(@)(@@) % فقلت : أشم من خديك وردا % فقال : وما تضم الوجنتان % % 12(@)(@@) % فقلت : أخاف صدغك أن يراني % % و ما أنا من لحاظك في أمان % % 13(@)(@@) % فقال : أعاشق ويخاف رميا % جبنت وما عهدتك بالجبان % % 14(@)(@@) % كذاك الصب يعذر كل صب % تحكم ما تشاء وفي ضماني % % 15(@)(@@) % فكان تحكما لا وزر فيه % % أيكتبه علي الكاتبان % % 16(@)(@@) % أديرا الراح ويحكما سلافا % فإن دارت علي فعاطياني % % PageV01P167 البحر : كامل تام 1(@)(@@) % دنف قضى عز الجمال بهونه % فقضى أسى قبل اقتضاء ديونه % 2(@)(@@) % وأغر تتلو الفجر غرته كما % % تتلو لقلبي فاطرا بجفونه % 3(@)(@@) % هو للغرابة في الجمال عرابة % أخذ المحاسن راية بيمينه % % 4(@)(@@) % حليت شعري من بديع صفاته % % بطلاوة تغنيه عن تلحينه % % 5(@)(@@) % في خد موسى نقط 
ms47	 خال رائق % نور العذار محلأ من نونه % % 6(@)(@@) % فترى صحيفة كاتب متماجن % قد خط قبل النون نقطة نونه % 7(@)(@@) % يجري بفيه كوثر في جوهر % أرخصت جوهر أدمعي لثمينه % % 8(@)(@@) % آها للؤلؤ ثغره هل يشتفي % % مكنون ذاك الشوق من مكنونه % % 9(@)(@@) % إن رمت منه الوصل فعلا حاضرا % أومت للاستئناف سين جبينه % % PageV01P168 البحر : كامل تام 1(@)(@@) % بأبي جفون معذبي وجفوني % % فهي التي جلبت إلي منوني % % 2(@)(@@) % ما كنت أحسب أن جفني قبلها % % يقتادني من نظرة لفتون % 3(@)(@@) % يا قاتل الله العيون لأنها % % حكمت علينا بالهوى والهون % % 4(@)(@@) % ولقد كتمت الحب بين جوانحي % % حتى تكلم في دموع شؤوني % % 5(@)(@@) % هيهات لا تخفى علامات الهوى % % كاد المريب بأن يقول : خذوني % % 6(@)(@@) % وبمهجتي ألحاظ ظبية وجرة % حراس مسكنها أسود عرين % % 7(@)(@@) % سدوا علي الطرق خوف طريقهم % % فالطيف لا يسري على تأمين % % 8(@)(@@) % أوما كفاهم منعهم حتى رموا % % منها مبرأة برحم ظنون % % 9(@)(@@) % و توهموا أن قد تعاطت قهوة % لما رأوها تنثني من لين % % 10(@)(@@) % واستفهموها : من سقاك ؟ وما دروا % % ما استودعت من مبسم وجفون % % PageV01P169 11(@)(@@) % ومن العجائب أنهم قد عرضوا % % بي للفتون وبعده عذلوني % % 12(@)(@@) % خدعوا فؤادي بالوصال وعندما % % شبوا الهوى في أضلعي هجروني % % 13(@)(@@) % لو لم يريدوا قتلتي لم يطعموا % % في القرب قلب متيم مفتون % % 14(@)(@@) % لم يرحموني حين حان فراقهم % % ما ضرهم لو أنهم رحموني % % 15(@)(@@) % ومن العجائب أن تعجب عاذلي % % من أن يطول تشوقي وحنيني % % 16(@)(@@) % يا عاذلي ذرني وقلبي والهوى % % أأعرتني قلبا لحمل شجوني % % 17(@)(@@) % يا ظبية تلوي ديوني في الهوى % % كيف السبيل إلى اقتضاء ديوني % % 18(@)(@@) % بيني وبينك حين تأخذ ثارها % % مرضى قلوب من مراض جفون % 19(@)(@@) % ما كان ضرك يا شقيقة مهجتي % % أن لو بعثت تحية تحييني % % 20(@)(@@) % زكيجمالا أنت فيه غنية % و تصدقي منه على المسكين % % PageV01P170 21(@)(@@) % مني علي ولو بطيف طارق % ما قل يكثر من نوال ضنين % % 22(@)(@@) % ما كنت أحسب قبل حبك أن أرى % % في غير دار الخلد حور العين % % 23(@)(@@) % قسما بحسنك ما بصرت بمثله 
ms48	 % في العالمين شهادة بيمين % % PageV01P171 البحر : سريع 1(@)(@@) % قد كتب الحسن على خده % إنا فتحنا لك فتحا مبين % 2(@)(@@) % يا قلب إن ملت إلى غيره % ما أنت إلا في ضلال مبين % PageV01P172 البحر : رمل تام 1(@)(@@) % قل لمن أسهر بالعين الجفون % مثلك التصبار عنه لا يكون % 2(@)(@@) % خفق النهر بحمص بعدما % % بنت والطير بدت منها شجون % 3(@)(@@) % والليالي بعدما كنا بها % % في نهار ألبست داجي الدجون % 4(@)(@@) % يا أخا الفضل ويا رب العلا % % والمعاني الغر في تلك الفنون % 5(@)(@@) % أين عيشي بك في ظل المنى % % في فنون دائمات وفتون % 6(@)(@@) % بخليج لم نزل نجري به % قصب السبق بغايات المجون % 7(@)(@@) % حيث مد النهر منه معصما % يتمنى لثمه زهر الغصون % 8(@)(@@) % و جرى الظل عليه سجسجا % مثلما أبصرت كحلا في العيون % 9(@)(@@) % أترى الخضراء تنسي مثله % رجم الإخوان في هذا الظنون % 10(@)(@@) % ينقضي العام ويتلو آخر % والنوى لا تنقضي ! هذا جنون % PageV01P173 11(@)(@@) % إن أساء الخل منه أدبا % فبفرط الشوق والوجد يهون % PageV01P174 البحر : طويل 1(@)(@@) % طمحت بأجفاني فأنسيتها الغمضا % % وأجنيتني من وجنتيك هوى غضا % % 2(@)(@@) % أيقبل شوقي سلوة عن مقبل % يسوم ختام الصبر خاتمه فضا % % 3(@)(@@) % أموسى أيا بعضي وكلي حقيقة % و ليس مجازا قولي الكل والبعضا % % 4(@)(@@) % خفضت مكاني إذ جزمت وسائلي % % فكيف جمعت الجزم عندي والخفضا % % 5(@)(@@) % شددت بجبل الشمس منك أناملي % % لحظي وإن الحظ يقطعها عضا % % PageV01P175 البحر : كامل تام 1(@)(@@) % صرح بما عندي ولو ملأ الفضا % % ما لي وللتعريض فيمن أعرضا % % 2(@)(@@) % لي شادن صاد الأسود بمقلة % ألقى الكمي لها الذوابل معرضا % % 3(@)(@@) % غصن منابته القلوب وكوكب % ما نوه إلا المدامع فيضا % % 4(@)(@@) % ما طال ليلي بعده بل ناظري % % يأتي الصباح فلا يراه أبيضا % % 5(@)(@@) % أبكي ويضحك راضيا بصبابتي % % فالصب يجني السخط من ذاك الرضا % % 6(@)(@@) % لا تلق أنفاسي بثغرك إنه % % برد أخاف عليه من جمر الغضا % % 7(@)(@@) % طار الكرى لكن وجدي قص في % % وكر الضلوع فلم يطق أن ينهضا % % 8(@)(@@) % أصبو إلى قصص الكليم وقومه % % قصدا لذكراك عندها وتعرضا % % 9 
ms49	(@)(@@) % أشكو إلى الحدق المراض وضلة % أن يشتكي هدف إلى سهم مضى % % 10(@)(@@) % بلوى على القلب المعذب جرها % % لحظي الظلوم ولحظ موسى والقضا % % PageV01P176 البحر : كامل تام 1(@)(@@) % شفق وشته خضرة في حمرة % فكأنه خد الحبيب معرضا % % 2(@)(@@) % و الشمس تنظر نحوه مصفرة % قد شمرت ذيل الوداع لتنهضا % % 3(@)(@@) % كالصب حين رأى عذار حبيبه % % لما بدا فسلا وولى معرضا % % PageV01P177 البحر : وافر تام 1(@)(@@) % خضعت وأمرك الأمر المطاع % و ذاع السر وانكشف القناع % 2(@)(@@) % و هل يخفي لذي وجد حديث % أتخفي النار يحملها اليفاع % 3(@)(@@) % أشاعوا أنني عبد لموسى % % نعم صدقوا علي بما أشاعوا % % 4(@)(@@) % وقد سكت الوشاة اليوم عني % % أقر الخصم فارتفع النزاع % % 5(@)(@@) % عبدت هواك فاستهوى عفافي % % كأن الود ود أو سواع % % 6(@)(@@) % بعثت وسيلة لك من ودادي % % فصافح وفدها منك الضياع % % 7(@)(@@) % هلكت بما رجوت به خلاصي % % و قد يردي سفينته الشراع % 8(@)(@@) % نفى سهري الخيال فهل رقاد % يعار لوصل طيفك أو يباع % 9(@)(@@) % لقد أربى هواك على عذابي % % كما أربت على الأدب الطباع % % 10(@)(@@) % أخاف عليك أن أشكوك بثي % % مشافهة فيخجلك السماع % % PageV01P178 11(@)(@@) % و إن عبرت عن شوقي بكتب % تلهب في أناملي اليراع % PageV01P179 البحر : طويل 1(@)(@@) % تنازعني الآمال كهلا ويافعا % % ويسعدني التعليل لو كان نافعا % % 2(@)(@@) % وما اعتنق العليا سوى مفرد سرى % % لهول الفلا والشوق والسوق رابعا % % 3(@)(@@) % رأى عزمات الشوق قد نوعت به % % فساعد في الله النوى والنوازعا % % 4(@)(@@) % و ركب دعتهم نحو ' يثرب ' نية % فما وجدت إلا مطيعا وسامعا % % 5(@)(@@) % يسابق وخد العيس ماء شؤونهم % % فيفنون بالشوق المدى والمدامعا % % 6(@)(@@) % إذا انعطفوا أو رجعوا الذكر خلتهم % % غصونا لدانا أو حماما سواجعا % % 7(@)(@@) % تضيء من التقوى حنايا صدورهم % وقد لبسوا الليل البهيم مدارعا % % 8(@)(@@) % تلاقى على وادي اليقين قلوبهم % خوافق يذكرن القطا والمشارعا % % 9(@)(@@) % قلوب عرفن الحق فهي قد انطوت % عليها جنوب ما عرفن المضاجعا % % 10(@)(@@) % تكاد مناجاة النبي محمد % تنم بها مسكا على الشم ذائعا % % PageV01P180 11(@)(@@) % تخالهم النبت الهشيم تغيرا % و قد فتقوا روضا من الذكر يانعا 
ms50	 % % 12(@)(@@) % سقى دمعهم عرس الأسى في ثرى الجوى % % فأنبت أزهار الشجون الفواقعا % % 13(@)(@@) % فذاقوا لبان الصدق محضا لعزهم % وحرم تفريطي علي المراضعا % % 14(@)(@@) % خذوا القلب يا ركب الحجاز فإنني % % أرى الجسم في أسر العلائق قابعا % % 15(@)(@@) % و لا ترجعوه إن قفلتم فإنما % % أمانتكم ألا تردوا الودائعا % % 16(@)(@@) % مع الجمرات ارموه يا قوم إنه % % حصاة تلقت من يد الشوق صادعا % % 17(@)(@@) % وحطوا رجائي في رجا زمزم الصفا % % وخلوا المنى تجمع غليلا وناقعا % % 18(@)(@@) % تخلص أقوام وأسلمني الهوى % % إلى علق سدت علي المطامعا % % 19(@)(@@) % هم دخلوا باب القبول بقرعهم % و حسبي أن أبقى لسني قارعا % % 20(@)(@@) % و والله ما لي في الدخول وسيلة % ترجى ولكن أعرف الباب واسعا % % PageV01P181 21(@)(@@) % أينفك عزمي عن قيود ثقيلة % أيمحو الهوى عن طينة القلب طابعا % % 22(@)(@@) % و تسعف ' ليت ' في قضاء لبانتي % % و تترك ' سوف ' فعل عزمي المضارعا % % 23(@)(@@) % إذا شرق الارشاد خابت بصيرتي % % كما بعثت شمس سرابا مخادعا % % 24(@)(@@) % فلا الزجر ينهاني وإن كان مرهبا % ولا النصح يثنيني وإن كان ناصعا % % 25(@)(@@) % بنيت بناء الحرف خامر طبعه % % فصار لتأثير العوامل مانعا % % 26(@)(@@) % بلغت نصاب الأربعين فزكها % % بفعل ترى فيه منيبا ورابعا % % 27(@)(@@) % وبادر بوادي السم إن كنت راقيا % و عاجل رقوع الفتق إن كنت راقعا % % 28(@)(@@) % فما اشتبهت طرق النجاة وإنما % % ركبت إليها من يقينك ظالعا % % PageV01P182 البحر : بسيط تام 1(@)(@@) % لله سر جمال أنت موضعه % والسر حيث يشاء الله يودعه % 2(@)(@@) % من كان ينكر أن الخلق جمع في % % شخص ففيك بيان ليس يدفعه % 3(@)(@@) % فمنك في كل عين ما تقر به % و منك في كل جأش ما يروعه % 4(@)(@@) % إذا انطوى لك قلب فوق موجدة % تبرأت منه أو عادته أضلعه % 5(@)(@@) % للناس إن ركبوا نهج الفخار بني % % ات الطريق ولابن الجد مهيعه % 6(@)(@@) % ما صورت لسوى التنويل راحته % و لا لغير استماع الحمد مسمعه % 7(@)(@@) % وجه يضيء ويمنى سيبها غدق % كالبدر وافق فيض النيل مطلعه % 8(@)(@@) % كالغيث لكنه ري بلا شرق % والغيث قد يشرق الوراد مشرعه 
ms51	 % 9(@)(@@) % كالطل لكن يردى النور لابسه % والظل لا يقبل الأنوار موقعه % 10(@)(@@) % بفكره من مصيف شب لفحته % و كفه من ربيع رب مربعه % PageV01P183 11(@)(@@) % زادت وزارته إذ ثنيت شرفا % مزوج الدر أبهاه وأبدعه % 12(@)(@@) % إحداهما صارم من فوق عاتقه % وأختها علم في الكف يرفعه % 13(@)(@@) % أو هدب حلته في السلم يلبسها % % و هذه في الوغى سرد يدرعه % 14(@)(@@) % أو تلك مغفر عز فوق مفرقه % و تلك تاج معاليه ترصعه % 15(@)(@@) % من عزمه لصدوع الحق يجبرها % % و رأيه لظلام الشك يصدعه % 16(@)(@@) % فذاك باب إلى الإرشاد يشرعه % و ذا سنان إلى الإلحاد يشرعه % 17(@)(@@) % كم ماكر بطلت عن ذاك خدعته % وذي عتو بهذا لأن أخدعه % 18(@)(@@) % وكم مكان من العلياء يفرعه % بذا وكم نظر عن ذا يفرعه % 19(@)(@@) % فإن رمى قرطست بالسهم نزعته % و إن رأى صادف التوفيق منزعه % 20(@)(@@) % تنبو المضاجع عنه في الدجى سهرا % ليطمئن بجنب الدين مضجعه % PageV01P184 21(@)(@@) % فلا الكثير من الدنيا يشاغله % و لا الكفاف من العلياء يقنعه % 22(@)(@@) % لطاب نفس أمير المؤمنين ولم % يدع لصوت الهدى الداعي تورعه % 23(@)(@@) % لما تحرك يأجوج النفاق بنى % % له سدادك سدا لا يضعضعه % 24(@)(@@) % لو أعربت طاعة عن طائع شهدت % بأنها لك طوق ليس تخلعه % 25(@)(@@) % ولو تشق عن المنصور تربته % أثنى عليك لعهد لا تضيعه % 26(@)(@@) % حفظت للحافظ المرحوم سيرته % و الأصل إن طاب طابت عنه أفرعه % 27(@)(@@) % رجاحة عصت الغاوين نبعتها % % و نائل طاوع العافين منبعه % 28(@)(@@) % شيدت عهدك فالتقوى دعائمه % و اشتق منه بناء ظلت تصنعه % 29(@)(@@) % فالعهد أكرم منوي وأوثقه % و الدار أسعد مبني وأرفعه % 30(@)(@@) % أنت الذي أسست بالصدق بيعته % كمثل ما أسست باليمن أربعه % PageV01P185 31(@)(@@) % ما بالبناء اضطرار أن تحسنه % سكناك يملأه حسنا ويوسعه % 32(@)(@@) % منازل البدر لا تحتاج تحلية % فغرة البدر فيها الحلي أجمعه % 33(@)(@@) % أما الفعال فما تأتيه أشرفه % أو الكلام فشعري فيك أبدعه % 34(@)(@@) % تبرع النظم في يحيى وطاوعني % % ومن براعة ممدوحي تبرعه % 35(@)(@@) % راجيك مستشعر حرب الخطوب وما % % غير الخطابة 
ms52	 والأشعار مفزعه % 36(@)(@@) % لو قاد من فقره قولا يفقره % أو لو يشجعه لفظ يسجعه % 37(@)(@@) % و شيمة الزمن المذموم تؤيسه % و عادة السيد المحمود تطمعه % 38(@)(@@) % أيسلم المجد آمالي إلى قلم % تنهل لي رحمة في الطرس أدمعه % 39(@)(@@) % إليك مرجع تأميلي فكيف ترى % % تخييبه ولأوفى الناس مرجعه % 40(@)(@@) % علقت أمداحك الحسنى على أذني % % تمائما من جنون العدم تمنعه % PageV01P186 البحر : طويل 1(@)(@@) % أموسى لقد أوردتني شر مورد % و ما أنا فرعون كفور الصنائع % 2(@)(@@) % سحرت فؤادي حين أرسلت حية ال % % عذار وقد أغرقتني في مدامعي % % 3(@)(@@) % و ما كنت أخشى أن تكون منيتي % % بكفيك والأيام ذات بدائع % % 4(@)(@@) % و والله ما يلتذ سمعي وناظري % % بغيرك إنسانا وما ذاك نافعي % % 5(@)(@@) % جعلت علي الصبر ضربة لازب % وحرمت أن آتي إليك بشافع % % 6(@)(@@) % و ما أسفي أني أموت وإنما % % حذاري أن ترمى بلؤم الطبائع % % PageV01P187 البحر : كامل تام 1(@)(@@) % أهدت نجاتك عوذة المتخوف % و جلت إياتك بغية المتشوف % 2(@)(@@) % بهج الجميع بك ابتهاج الأرض في % % محل بإطلاق الحيا المتوقف % 3(@)(@@) % يا غمة أجلت لنا عن فرحة % كالسجن أفرج عن إمارة يوسف % 4(@)(@@) % مرض الوزير المرتضى فبدت على % % مرض الوجود دلائل لا تختفي % % 5(@)(@@) % ولذلك اعتل النسيم وألبست % شمس الأصيل شحوب شاك مدنف % 6(@)(@@) % إن سر مطلعه العيون فطالما % % نامت أمانا في حماه الأكنف % 7(@)(@@) % أو مدت الأيدي له تدعو فكم % مدت إلى إحسانه المتوكف % 8(@)(@@) % ظل الزمان محيرا لشكاته % فلو أنه عين إذن لم تطرف % 9(@)(@@) % عجبا من الأيام تسقمه وما % % زالت به من كل سقم تشتفي % % 10(@)(@@) % ما نالت الآلام منه سوى الذي % % نال الصقال من الحسام المرهف % PageV01P188 11(@)(@@) % حفت بنور أبي علي عصمة % لو جاورت شمس الضحى لم تكسف % 12(@)(@@) % إن غبت عن قوم فما غاب الذي % % عودتهم من نائل وتعطف % 13(@)(@@) % كالنبت لا يلقى الغمام وإن غدا % % متنعما برضابه المترشف % 14(@)(@@) % رفد بصاحبه نقاء سريرة % وصفان من وصف السحاب الموكف % 15(@)(@@) % كرم يؤيده التكرم قد حكى % % غيد الغزال موكدا بتشوف % 16 
ms53	(@)(@@) % حسب صقيل فوق عز أشوس % كسنا الفرند على سواء المشرفي % % 17(@)(@@) % عزم تألق في نواحي همة % كالنار تومض باليفاع المشرف % 18(@)(@@) % ما فيه من غير التقى رهب ولا % % فيه لغير الجود شيمة مسرف % 19(@)(@@) % لا يبصر الزلات وهي ظواهر % تبدو ، ويبصر موضع الفضل أ % % 20(@)(@@) % أضداد مجد لا تعادي بينها % % نار البروق بمائها لا تنطفي % % PageV01P189 21(@)(@@) % متناسب في الفضل مكتمل فلا % % نقص الكفيف ولا اختلاف الأخيف % 22(@)(@@) % موف على العليا بأيسر سعيه % نيل البليغ مرادوه في أحرف % 23(@)(@@) % سعي خلاصي قد استصفى العلا % % و لقد تتاح له ولو لم يصطف % 24(@)(@@) % لو أنه التمس المساعي في الدجى % % لم يختطف منهن غير الأشنف % 25(@)(@@) % نظم المواهب كالقوافي جوده % لا نظم منتحل ولا متكلف % 26(@)(@@) % قد يلحف العافون في تسآلهم % % ما كنت أسمع بالكريم الملحف % 27(@)(@@) % إفك الدعاة محته دعوتك الرضى % % فعصا الخطيب بها عصا متلقف % 28(@)(@@) % يبدون هديا والمراد خلافه % فكأن دعوتهم كلام مصحف % 29(@)(@@) % ناضل بسيف الله أو بكتابه % و اشبع بظهر الطرف بطن المصحف % 30(@)(@@) % وإليكها ابنة ساعة لا تلتقي % % إلا بسمع منصت أو منصف % PageV01P190 31(@)(@@) % عذراء جاءت عن لهاك وخاطري % % فعجبت من كرم القريض المقرف % 32(@)(@@) % راقتك تسهيما وصابت أسهما % فأتتك بين مفوق ومفوف % 33(@)(@@) % أنا والبساط وأنت : أشرف مادح % و أجل ممدوح وأشرف موقف % PageV01P191 البحر : رمل تام 1(@)(@@) % أسعد الوجد بدمع وكفا % % لا تقل للدمع : حسبي وكفى % % 2(@)(@@) % لست في دمعي غريقا إنما % % جسدي خف ضنى حتى طفا % % 3(@)(@@) % جاد غيث الدمع من بعدك في % % مقلتي رسم الكرى حتى عفا % % 4(@)(@@) % ذكرك الأعطر يبكيني دما % رب مسك بشذاه رعفا % % 5(@)(@@) % لست مشغوفا بموسى إنه % % ليس لي قلب فأشكو الشغفا % % 6(@)(@@) % كنت أشكو في الهوى واليوم قد % % تبت ، يعفو الله عما سلفا % % PageV01P192 البحر : بسيط تام 1(@)(@@) % سألتها علة من ماء مبسمها % % تطفي بها حر مصدوع الحشا دنف % 2(@)(@@) % فاستضحكت ثم قالت : ثغر ذي شنب % في ثغر ذي فلج شيء من الكلف % 3(@)(@@) % وما درت أنه والله لا عجب 
ms54	 % أن يوجد الدر مقرونا مع الصدف % PageV01P193 البحر : طويل 1(@)(@@) % أمالك في أمري إلى العدل مصرف % حكمت فما أعطيت عدلا ولا صرفا % % 2(@)(@@) % يقول : أتشكو الميل مني ونفرتي % % و بعدي ألست البدر والغصن والخشفا % % 3(@)(@@) % تحن إلى الخيري نفسي ويغتدي % % نسيبي في تصحيفه يملأ الصحفا % % 4(@)(@@) % و ما أسهر الظلماء إلا لعله % % ينشقني الخيري من نشره عرفا % % 5(@)(@@) % كأن خيالي ليس يظهر غيره % % و لا منصفي يدري خلاف اسمه حرفا % % 6(@)(@@) % يمثل لي في كل شيء رأيته % % و إن سألوا جاوبتهم باسمه عرفا % % 7(@)(@@) % و لولا حيائي واتقاء محله % % لقبلت نعليه برغم العدا ألفا % % 8(@)(@@) % تأولت فيه الذل قلت : تواضع % وحسنت ترك الصون سميته ظرفا % % 9(@)(@@) % ألا ليت شعري من بآخر سبح % و من هو في التنزيل قبل الذي وفى % % PageV01P194 البحر : طويل 1(@)(@@) % أرقت لبرق بالحمى يتألق % فقلبي أسير حيث دمعي مطلق % 2(@)(@@) % غذا فهت بالشكوى ترنم صاحبي % % كما طارح الغصن الحمام المطوق % 3(@)(@@) % فبتنا قريني لوعة نصطلي بها % % كأنا على النار الندى والمحلق % 4(@)(@@) % نقضي ديون الشوق حتى قضى على % % غراب الدجى بازي الصباح المحلق % 5(@)(@@) % وشف عن النور الظلام كأنه % حداد على بيض الصدور يمزق % 6(@)(@@) % يمانع ضوء الفجر والفجر صادع % كما عارض البرهان قول ملفق % 7(@)(@@) % كأن احمرار الأفق والفجر والدجى % % دم وحسام مشرفي ومفرق % 8(@)(@@) % أيا جنة حلت لظى من جوانحي % % أطي ضلوعي جنة وهو يحرق % 9(@)(@@) % أينكر قلب الصب منذ سكنته % % ليبا وحرا وهو للشمس مشرق % 10(@)(@@) % رعى الله عهدا للصبا ليس يرتجى % % و اخباره متلوة تتشوق % PageV01P195 11(@)(@@) % وأرضا يكاد الليل في عرصاتها % % لشدة ما قد ضاوع المسك يعبق % 12(@)(@@) % سقاها سحاب مثل دمعي ، وميضه % كقلبي ، تشب النار فيه ويخفق % 13(@)(@@) % يداني الربى حتى قصير نباتها % % يكاد به من شوقه يتعلق % 14(@)(@@) % كأن حياه الجود والنبت والثرى % % بنان أبي بكر وخط ومهرق % 15(@)(@@) % فتى فيه ما في الشهب والبرق والحيا % % فمنها له ذهن وكف ومنطق % 16(@)(@@) % تخايله في الغيث صعق ورحمة % وفي الصارم الهندي حد ورونق 
ms55	 % 17(@)(@@) % تكفل منه راحة الدين خاطر % تعوب ونوم الملك عزم مؤرق % 18(@)(@@) % يظن به وهو المحوط ضياعه % كما ساء ظنا بالأحبة مشفق % 19(@)(@@) % حمى في سماح في قبول كدوحة % تظل وتجنى كل حين وتنشق % 20(@)(@@) % له قلم قد أوتي الحكم شيمة % فلو كان طفلا كان في المهد ينطق % PageV01P196 21(@)(@@) % بكى السيف منه غيرة فبريقه % على صفحتيه عبرة تترقرق % 22(@)(@@) % و ليس اهتزاز الرمح للطعن خفة % ولكنها من شدة الرعب أولق % 23(@)(@@) % قصير طويل الباع شاك الضنى % % تصح به مرضى المعاني وتفرق % 24(@)(@@) % إذا ما جرى بالرزق فالمزن جامد % ومهما جرى في الطرس فالبرق مؤنق % 25(@)(@@) % بثثت بأفق الغرب كل غريبة % من القول يشجى الشرق منها ويشرق % 26(@)(@@) % تسير فتحكي البدر سيرا وغرة % خلا أنها معصومة ليس تمحق % 27(@)(@@) % يحاكي ثغور الغانيات ابتسامها % % ومنظرها ، والورد أروى وأورق % 28(@)(@@) % إذا وردت حفلا تغامز أهله % صحائف فضت أم نوافج تفتق % 29(@)(@@) % فمن مطلق منهم عرى المدح مسهب % و من صامت عجزا فمطر ومطرق % 30(@)(@@) % لك النظم تهوى الشمس لو كسيت به % % وجرد عنها نورها المتألق % PageV01P197 31(@)(@@) % فيعشو له الأعشى إذا لاح نوره % ويجري جرير ظالعا حين يعنق % 32(@)(@@) % هو الدر : يهدي الدر بحر مكدر % زعاق وذا يهديه عذب مروق % 33(@)(@@) % تكاملت بين الجود والشعر فاغتدى % % عليك عيالا حاتم والفرزدق % 34(@)(@@) % قريض وقرض للنهى فمسامع % تشنف منها أو رقاب تطوق % 35(@)(@@) % لأخضلت جودا واشتعلت نباهة % فزندكيوري حيث غصنك يورق % 36(@)(@@) % فإنك في نفس المكارم والعلا % % طباع وخلق والأنام تخلق % 37(@)(@@) % ألا وتهنأ موسما لوفوده % لقد كاد قبل الوقت نحوك يسبق % 38(@)(@@) % و زارك دون الناس وحدك إنما % % ثناه التقى أو عادة ليس تخلق % 39(@)(@@) % وما منكما إلا سعيد مهنأ % و لكن لذي اللب الهناء المحقق % 40(@)(@@) % ودونكها حسناء من غير محسن % كما جاء من ذي الذنب عذر منمق % PageV01P198 41(@)(@@) % أأهدي إلى شمس الضحى كوكب السها % % وينفق لي في معدن التبر زئبق % 42(@)(@@) % تحب الورى الآداب وهي مضاعة % فأحسبها الدنيا تلام وتعشق % 43(@)(@@) % ولولاك إذ 
ms56	 أصبحت حجة سعدها % % لكنت بدعوى الشؤم فيها أصدق % 44(@)(@@) % كأن ملم الرزق طيف وهمني % % سهاد وليس الطيف في السهد يطرق % PageV01P199 البحر : كامل تام 1(@)(@@) % يا واحدا في الفضل حالفني ندى % % يده محالفة الندى لمحلق % 2(@)(@@) % فازت مناي به وقرت أضلعي % % هاتيك لم تخفق وذي لم تخفق % 3(@)(@@) % فاضت لهاه وأطرفت في نوعها % % أذهبن مذهب مغرب أو مغرق ؟ % 4(@)(@@) % إن يكس عطفي فالسماء بجودها % % تكسو الربى خلع النبات المونق % 5(@)(@@) % أما نداه فكوثر وفناؤه % عدن وهذا الزي من إستبرق % 6(@)(@@) % ما زال يظهر في آية جوده % حتى كساني بالسحاب الأزرق % 7(@)(@@) % زارت سحائبه البقاع حفاوة % حيث السحاب مع الثرى لا يلتقي % % 8(@)(@@) % إني سجعت حمامة بمديحه % فأفادني لون الحمام الأورق % 9(@)(@@) % ولقد تمرس بي مليا بحره % حتى تبين دره في منطقي % % 10(@)(@@) % يا جوده بلغتني ما أشتهي % % وملكتني وكفيتني ما أتقي % % PageV01P200 11(@)(@@) % كن موسما لمطامعي ، أو ميسما % في جبهتي ، أو مغفرا في مفرقي % % 12(@)(@@) % يعطي ويحذو حذروه ابن ماجد % أخذ الربيع عن الغمام المغدق % 13(@)(@@) % ما حيلتي بنداكما وقد التقى % % بحرا سماح في مجال ضيق % 14(@)(@@) % ماذا التأنق في السماحة خففوا % % عنكم وعن هذا اللسان المرهق % 15(@)(@@) % ما المزن إلا محسن لكنكم % حزتم شفوف المحسن المتأنق % 16(@)(@@) % أثقلتماني إنما بي خجلة % من أن أقول لهبة الجود ارفقي % % 17(@)(@@) % قوم إذا ارتجلوا المكارم نمقوا % % ما لا تنمقه روية ملفق % 18(@)(@@) % أعطيتها صفرا كأن بوارقا % زارت يدي لكنها لم تقلق % 19(@)(@@) % حييت آمالي بطاقة نرجس % أدركت نفحتها بغير تنشق % 20(@)(@@) % نورت مني حالة دهماء لو % مسح الصباح أديمها لم تشرق % PageV01P201 21(@)(@@) % بيضت عمري كله وأعدته % برا فما هو بالعقوق الأبلق % 22(@)(@@) % أذهبت عني الجدب حتى خفت أن % % أنمى إلى الأدب انتماء الملصق % 23(@)(@@) % وليت إحلالي لواحظ نائم % و رأيت خلاتي بلحظ مؤرق % 24(@)(@@) % و رأيت بي ضنكا وهون بضاعة % فهززت عطف منفس ومنفق % 25(@)(@@) % استخلص ابن خلاص الهمم التي % % فتن النجوم بأسعد وتألق % 26(@)(@@) % صدقت مخايل جوده ونشت كما % % تبدو تباشير الصباح المشرق 
ms57	 % 27(@)(@@) % لا مثل جود يضمحل كأنه % بشرى هلال الفطر غير محقق % 28(@)(@@) % كالطود لكن فيه هزة عاطف % كالليث لكن فيه شيمة مشفق % 29(@)(@@) % كالظل إلا نوره وثبوته % كالشمس إلا في لظاها المحرق % 30(@)(@@) % أحيا الصحابة والداية عصره % وأمات مغربه حديث المشرق % PageV01P202 31(@)(@@) % يا أهل سبتة هذه السير التي % % أبدت فضائل من مضى في من بقي % % 32(@)(@@) % و ضحت ولم تعثر يدا متتبع % مثل الحروف لمسن فوق المهرق % 33(@)(@@) % يلقاك بين وزارتيه وبشره % كالسيف راع بمضربين ورونق % 34(@)(@@) % تجني المعالي من رسوم علاه ما % % تجني الصنائع من حدود المنطق % 35(@)(@@) % و إذا تعرضه الحسود فمثلما % % يتعرض البرهان قول ملفق % 36(@)(@@) % أدركت سؤلي من نداك شهامة % ومدائحي في نجد مجدك ترتقي % % 37(@)(@@) % ما لاح سر الدهر قبلك إنما % % كان الزمان كمامة لم تفتق % PageV01P203 البحر : منسرح 1(@)(@@) % يا جامع الشمل بعدما افترقا % % قدر لعيني بمن أحب لقا % % 2(@)(@@) % ويا مجير المحب من فرق ال % % فراق عجل وأذهب الفرقا % % 3(@)(@@) % عاف من السقم مبتلى بهوى % % ما نفعت فيه عوذة ورقى % % 4(@)(@@) % أجر بوصل الحبيب قلبي من % طوارق الهجر وافتح الطرقا % % 5(@)(@@) % و لا تسلط أذى الفراق على % % ضعفي فما لي على الفراق بقا % % 6(@)(@@) % و لا تؤاخذ فلست أول من % بخيس عهد الحسان قد وثقا % % 7(@)(@@) % أنا الذي رام من أحبته % حظا بلقياهم فما رزقا % % 8(@)(@@) % وهل مطيق على النوى جلدا % صب لغير الغرام ما خلقا % % 9(@)(@@) % أحبتي ما الذي أضر بكم % قربي بعد النوى لو اتفقا % % 10(@)(@@) % جودوا وعودوا فديتكم دنفا % نضو سقام على الفراش لقى % % PageV01P204 11(@)(@@) % حسبت يوم الوداع أن معي % % قلبي ولم أدر أنه سرقا % % 12(@)(@@) % إن فؤادي فراش شوقكم % صادف نار الغرام فاحترقا % % 13(@)(@@) % وإن وجدي الذي أراق دم ال % % عين لدمع أهدى لها الأرقا % % 14(@)(@@) % و اعجبا لا يزال ذا ظماء % إنسان عين بدمعها غرقا % % 15(@)(@@) % قد أظلمت عيشتي ولست أرى % % إلا بكم مشرقا لها أفقا % % 16(@)(@@) % فأسأل الله أن يعيدكم % ويجمع الشمل بعدما افترقا % % PageV01P205 البحر : بسيط تام 1 
ms58	(@)(@@) % يا سالب القلب مني عندما رماقا % % لم يبق حبك لي صبرا ولا رمقا % % 2(@)(@@) % لا تسأل اليوم عما كابدت كبدي % % ليت الفراق وليت الحب ما خلقا % % 3(@)(@@) % ما باختياري ذقت الحب ثانية % وإنما جرت الأقدار فاتفقا % % 4(@)(@@) % و كنت في كلفي الداعي إلى تلفي % % مثل الفراش أحب النار فاحترقا % % 5(@)(@@) % ارفق علي النفس قد تلفت % وانظر إلي فإن الروح قد زهقا % % PageV01P206 البحر : طويل 1(@)(@@) % سل النوم يا موسى وهنئت طيبه % متى عهده من عين مهجورك الشقي % % 2(@)(@@) % وطال اتقائي أن أصاب بفتنة % لقد جلبت عيناك ما كنت أتقي % % 3(@)(@@) % نظرت بتلك العين نظرة قاتل % فهل عندها إن مت نظرة مشفق % % 4(@)(@@) % أيا معرضا أعلقت من حبله يدي % % بمثل شعاع البارق المتألق % % 5(@)(@@) % أبرهن عند النفس باطل عذره % % وأقنع منه بالوداد الملفق % % 6(@)(@@) % أأعريتني من ثوب وصلك بعدما % % كسوت الضنى عطفي والشيب مفرقي % % 7(@)(@@) % و يا سلوتي لا أعرف العذر إنني % % أخذت مع الأشجان أكرم موثق % % 8(@)(@@) % و يا صاح إن لم تدر أن شقاوة % تلذ وهونا يشبه العز فاعشق % PageV01P207 البحر : مجزوء الخفيف 1(@)(@@) % شادن لو جرى مع ال % % شمس في حلبة سبق % 2(@)(@@) % عانق الغصن فاحتذى % % لين عطفيه واسترق % 3(@)(@@) % نشق الزهر فاستفا % % د بأنفاسه عبق % 4(@)(@@) % و جرى باسم النسي % % م على خده فرق % 5(@)(@@) % قل لموسى : صدعت قل % % بي كاليم فانفلق % % 6(@)(@@) % يا جحيما على القلو % % ب ويا جنة الحدق % % 7(@)(@@) % ما أرى الخال فوق خد % يك ليلا على فلق % 8(@)(@@) % إنما كان كوكبا % قابل الشمس فاحترق % % PageV01P208 البحر : كامل تام 1(@)(@@) % انظر إلى لون الأصيل كأنه % % لا شك لون مودع لفراق % 2(@)(@@) % و الشمس من شفق المغيب كأنها % % قد خمشت خدا من الإشفاق % 3(@)(@@) % لاقت بحمرتها الخليج فألفا % % خجل الصبا ومدامع العشاق % 4(@)(@@) % سقطت أوان غروبها محمرة % كالكأس خرت من أنامل ساق % PageV01P209 البحر : طويل 1(@)(@@) % سل الكأس تزهو بين صبغ وإشراق % أذوب فيها الورد أم وجنة الساقي % % 2(@)(@@) % كؤوس تحييها النفوس كأنها % % حديث تلاق في مسامع عشاق % % 3 
ms59	(@)(@@) % إذا قتلوها بالمزاج ليشربوا % % أعاشوا مناهم بين موت وإخلاق % % 4(@)(@@) % تثور كأن الماء يلسع صرفها % % و صوت المغني مثل هينمة الراقي % % 5(@)(@@) % بموسى إذا ما شئت سكري غن لي % % و أدهق كؤوس الخمر أية إدهاق % % 6(@)(@@) % وإن شئت إعجازا ضربت بذكره % % فؤادي ففجرت العيون بآماقي % % 7(@)(@@) % يصاعد أنفاسي ضحى نفس الصبا % % و يقدح في الأحشاء نيران أشواقي % % 8(@)(@@) % إذا أنا حملت البليل صبابتي % % غدت كسموم الفتك لفحة إحراق % % 9(@)(@@) % وتعرف مني الريح زفرة عاشق % و يفهم مني البرق نظرة مشتاق % % PageV01P210 البحر : طويل 1(@)(@@) % أضاع وقاري من علقت جماله % % فيا زهرة قد زلزلت جبلا راسي % % 2(@)(@@) % وما ضر لو واسى وسلى بزورة % خلي جرى فيه القضاء على رأسي % % 3(@)(@@) % فألقط درا من فصول حديثه % % وأشرب طيب العيش من فضلة الكاس % 4(@)(@@) % وأرخصت عمري فيه وهو ذخيرتي % % وأنفقت فيه كنز صبري وإيناسي % % 5(@)(@@) % و غادرت رأيي بالعراء مذمما % وأوحشت نفسي فيه من سائر الناس % % 6(@)(@@) % وأفسدت بين النوم فيه وناظري % % و أكدت ودا بين فكري ووسواسي % % 7(@)(@@) % سأصرف صرف الحر عنه مطامعي % % و آوي بهذا القلب منه إلى الياس % % 8(@)(@@) % أما حيلة فيه فيعشق ساعة % عسى رقبة أرقي بها قلبه القاسي % % PageV01P211 البحر : طويل 1(@)(@@) % مضى الوصل إلا منية تبعث الأسى % % أداري بها همي إذا الليل عسعسا % % 2(@)(@@) % أتاني حديث الوصل زورا على النوى % % أعد ذلك الزور اللذيذ المؤنسا % % 3(@)(@@) % ويا أيها الشوق الذي جاء زائرا % أصبت الأماني خذ قلوبا وأنفسا % % 4(@)(@@) % ويا أرق الهجران بالله خل لي % % من النوم ما أقري الخيال المعرسا % % 5(@)(@@) % كساني موسى من سقام حفونه % % رداء وسقاني من الحب أكؤسا % % 6(@)(@@) % فلا صرد الله الشراب الذي سقى % % ولا خلع الله الرداء الذي كسا % % 7(@)(@@) % تلاقت لشكوى البين أنفاسنا فقل : % شذا الروض في حر الهجير تنفسا % % 8(@)(@@) % و ناديت بالترحال عنه تصنعا % لعل النوى منه تلين ما قسا % % 9(@)(@@) % وقلت : عساه إن رحلت يرق لي % % وقد نسخت لا عنده ما ادعت عسى % % 10(@)(@@) % وقال : ارض هجراني بديل النوى وقل 
ms60	 : % لعل منايانا تحولن أبؤسا % % PageV01P212 11(@)(@@) % أنادي سلوي للذي حل منك بي % % كأني أنادي أو أكلم أخرسا % % PageV01P213 البحر : كامل تام 1(@)(@@) % و معطل والسحن يعشق جيده % فيبين بالوسواس عن وسواسه % 2(@)(@@) % إن جاءني فيه العذول بشبهة % صدع الغرام بنصه وقياسه % % 3(@)(@@) % عاطيته شمسا لها في خده % % شفق أعار الورد حسن لباسه % % 4(@)(@@) % يثني الكؤوس نوافحا بروائح % يشربن من أنفاسه في كاسه % % 5(@)(@@) % فالمسك يروي الطيب عن مسك الصبا % % عن أكؤس الجريال عن أنفاسه % % PageV01P214 البحر : كامل تام 1(@)(@@) % هذا أوان فضيحتي لبيك يا % % داعي الهوى لا عطر بعد عروس % 2(@)(@@) % أوما ترى الأيام كيف تبسمت % % عن وصل موسى بعد طول عبوس % 3(@)(@@) % يسقى وزهر الروض منه طالع % في وجنة وملابس وكؤوس % 4(@)(@@) % شتى يحسنها التشابه مثلما % % تستحسن الألفاظ للتجنيس % PageV01P215 البحر : منسرح 1(@)(@@) % كيف ترى زورة الخليج وقد % % صبغ وجه العشي بالورس % 2(@)(@@) % ورق ثوب الأصيل وانفتحت % في وجنة النهر وردة الشمس % 3(@)(@@) % تلهو بذوب اللجين مطردا % فيه وذوب النضار في الكأس % PageV01P216 البحر : بسيط تام 1(@)(@@) % وشى بسري في موسى وأعلنه % % خذ يريك طراز الحسن كيف وشي % % 2(@)(@@) % تهتز في برده ريحانة شربت % ماء الصبى يا له ريا ويا عطشي % % 3(@)(@@) % هل خاله بدمي أم سيف ناظره % % قد ضاع ثأري بين الهند والحبش % 4(@)(@@) % أودى بقلبي لذاك الصدغ عقربه % لو أن درياق ذاك الريق منتعشي % % 5(@)(@@) % ترى العواذل حولي كالفراش وقد % % حاموا فأحرقتهم بالشوق في فرشي % % PageV01P217 البحر : بسيط تام 1(@)(@@) % فوق سهامك إن الله يهديها % % واسلل سيوفك فالأقدار تمضيها % % 2(@)(@@) % ثمار نجح سحاب الرأي يمطرها % % وأنت تغرسها ، والدين يجنيها % % 3(@)(@@) % إذا الكتائب نالت في العدى وطرا % فأنت نائله إذ كنت تهديها % % 4(@)(@@) % إذا أصابت لدى المرمى النبال فما % % تعزى إصابتها إلا لراميها % % 5(@)(@@) % برء الوزير أتى والفتح يعقبه % % كالشمس جاءت ، وجاء الصبح يتلوها % % 6(@)(@@) % إذا اشتكيت رأيت مشتكيا % و البأس والجود والدنيا وما فيها % % 7(@)(@@) % لذا رأيت الصبا معتلة ، وكسا % % شمس الأصيل اصفرار من تشكيها % % 8(@)(@@) % و كيف تمرضك الدنيا ولا فعلت % يا 