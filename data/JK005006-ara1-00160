ms141	 من المسجد وكفه في كف عمر . . ) ) الحديث .(@)(@@) تفرد به الحسن عن إبراهيم عن سفيان .(@)(@@) 1073 - حديث : ( ( كان النبي في العشر الأواخر يلف الفراش . . ) ) الحديث بمثله .(@)(@@) 1074 - حديث : ( ( لا تشد الرحال . . ) ) الحديث . PageV02P179(@)(@@) تفرد به الاحتياطي الحسين بن عبد الرحمن ( 1 ) عن ابن عيينة عن الزهري .(@)(@@) 1075 - حديث : ( ( إن أسيد بن حصين أتى النبي . . ) ) الحديث .(@)(@@) تفرد به رزق الله بن موسى ( 2 ) وأبو أحمد الطبري عن ابن عيينة عنه ، والمحفوظ عن الزهري عن عبد الرحمن بن كعب بن مالك .(@)(@@) 1076 - حديث : ( ( كان رسول الله يتفاءل ولا يتطاير . . ) ) الحديث ( 3 ) .(@)(@@) تفرد به علي بن يزيد الأزملي ( 4 ) الخراساني عن ابن عيينة عنه .(@)(@@) 1077 - حديث : ( ( كان النبي يأتي قباء راكبا . . ) ) الحديث .(@)(@@) تفرد به علي بن يزيد هذا عن ابن عيينة .(@)(@@) 1078 - حديث : ( ( والذي نفسي بيده ما يدخل الجنة إلا الرحيم ) ) .(@)(@@) تفرد به طاهر بن الفضل بن سعيد الحلبي ( 5 ) عن ابن عيينة عن معمر عن الزهري فذكره . PageV02P180(@)(@@) 1079 - حديث : / ( ( لماء جاء أبا العاص من المدينة . . ) ) الحديث ، وفيه : قالت زينب : ( ( إني قد أمرت أبا العاص . . ) ) ( ) .(@)(@@) تفرد به سليمان بن بلال ( 1 ) عن صالح بن كيسان عنه ، ولم يروه عنه غير أبي بكر بن أبي أويس .(@)(@@) 1080 - حديث : ( ( كنت أسكب لرسول الله ( عنبرة ) . . ) ) ( 2 ) الحديث .(@)(@@) تفرد به صالح بن أبي الأخضر عنه .(@)(@@) 1081 - حديث : ( ( جاء النبي فقال : أبخل الناس يبخلون . . ) ) الحديث ( 3 ) .(@)(@@) غريب من حديث الزهري عنه وفيه أنه خطب فقال : ( . . . . ) ( 4 ) ، وتفرد به صالح بن أبي الأخضر عنه ولا نعلم حدث به غير يحيى بن كثير بن درهم ( 5 ) وغيره يرويه عن الزهري عن عطاء بن يزيد عن الخدري ولا يذكر فيه أما بعد .(@)(@@) 1082 - حديث : ( ( عقدت بيعة أبي بكر يوم توفي النبي ) ) .(@)(@@) تفرد به يوسف بن خالد السمتي ( 6 ) عن صالح بن أبي الأخضر ، عنه . PageV02P181(@)(@@) 1082 - حديث : ( ( أن النبي كان إذا دخل الخلاء قال . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به محمد بن الحسن عن إبراهيم بن حميد عن صالح بن أبي الأخضر عنه .(@)(@@) 1084 - حديث : ( ( دخلت 
ms142	 على أنس بالهاجرة فذكر سنة رسول الله وأبي بكر وعمر . . ) ) الحديث .(@)(@@) تفرد به صالح بن أبي الأخضر عن إبراهيم بهذه الألفاظ ورواه عكرمة بن عمار عن صالح بنحو هذا .(@)(@@) 1085 - حديث : ( ( إن ناسا من قريش أسمدوا . . ) ) الحديث ( 2 ) .(@)(@@) تفرد به عبد الله بن نوفل بن ورقاء عن الزهري عنه ولم أره إلا عند محمد بن سابق عن أبي علي الحنفي عنه ، وروي عنه من وجه أخر عن أبي بكر الحنفي وهو عبد الكبير بن عبد المجيد ( 3 ) عن عبد الله بن محرز عن الزهري ، وتفرد به أبو بكر عن ابن محرز . PageV02P182(@)(@@) 31086 - حديث : ( ( أن عشرة من قريش كانوا يفتتحون القراءة بالحمد لله رب العالمين . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به أبو عيسى بن هارون عن عدي بن الفضل عن عبد الله بن طلحة عنه بهذا اللفظ وإنما يعرف عبيد الله بن أبي طلحة عن الزهري عن هذا الحديث .(@)(@@) 1087 - حديث : ( ( ما رأيت أحدا أشبه صلاة برسول الله من هذا لعمر بن عبد العزيز ) ) ( 2 ) .(@)(@@) تفرد به محمد بن عبد الله بن عنبسة عن أبيه عن الزهري .(@)(@@) 1088 - حديث : ( ( أن النبي مر برجل كاتب / مملوكا . . ) ) الحديث .(@)(@@) تفرد به بشر بن نافي عن أبي يعمر عن عبد الله بن محرز عن الزهري ويحيى بن أبي كثير وقتادة .(@)(@@) 1089 - حديث : ( ( يردن على الحوض أقوام . . ) ) الحديث .(@)(@@) تفرد به معلى بن عبد الرحمن ( 3 ) عن عبد الحميد بن جعفر عنه ، وتفرد به عبد الحميد عن الزهري ولم نكتبه إلا عن ابن مخلد .(@)(@@) 1090 - حديث : ( ( لكل أمة أمين . . ) ) الحديث ( 4 ) . PageV02P183(@)(@@) تفرد به عبد الرزاق بن عمر عن الزهري .(@)(@@) 1091 - حديث : ( ( الصدقات ) ) ( 1 ) .(@)(@@) تفرد به يحيى بن حمزة ( 2 ) عن أبيه عن سلمة بن عمرو القاضي قال هذا كتاب ابن شهاب الزهري بخطه عما أخبرني به أبو عمرو الأوزاعي عبد الرحمن .(@)(@@) 1092 - حديث : ( ( الضعفاء في أمتي ثلاثة . . ) ) الحديث .(@)(@@) غريب من حديث الزهري ، وغريب من حديث الأوزاعي عنه ، وتفرد به أيوب بن حيان ( 3 ) السلمي عن الأوزاعي ولم نكتبه إلا 
ms143	 من حديث أهل سنجار .(@)(@@) 1093 - حديث : ( ( إذا حضر العشاء . . ) ) الحديث ( 4 ) . PageV02P184(@)(@@) تفرد به عمر بن هاشم عن هقل عن الأوزاعي وروى عن مفضل بن يونس عن الأوزاعي .(@)(@@) 1094 - حديث : ( ( أن النبي شرب قائما وعلى يمينه أعرابي . . ) ) الحديث ( 1 ) .(@)(@@) تفرد به مسكين بن بكير ( 2 ) عن الأوزاعي عنه بقوله شرب قائما .(@)(@@) 1095 - حديث : ( ( سألت ربي عز وجل اللاهين من ذرية البشر . . ) ) الحديث ( 3 ) . PageV02P185(@)(@@) تفرد به عبد الرحمن بن المتوكل عن فضيل بن سليم عن عبد الرحمن بن إسحاق المدني عنه .(@)(@@) 1096 - حديث : ( ( أن النبي دخل مكة وعليه عمامة سوداء . . ) ) الحديث ( 1 ) . PageV02P186(@)(@@) غريب عن محمد بن عبد الرحمن بن أبي الموال ( 1 ) عنه .(@)(@@) تفرد به عثمان الطرائفي ( 2 ) عنه .(@)(@@) 1097 - حديث : أن النبي وسلم قرأ : ( ( ^ يومئذ يصدر الناس أشتاتا . . ) ( 3 ) الحديث .(@)(@@) تفرد به محمد بن زكريا الأزرق عن أبي ريحان العثماني عن عبد المؤمن بن عبد المهيمن بن أبي شراعة الهمداني ( 4 ) عن أبيه عنه .(@)(@@) 1098 - حديث : ( ( عرضت علي أجور أمتي . . ) ) الحديث ( 5 ) . PageV02P187(@)(@@) تفرد به محمد بن يزيد الأدمي عن عبد المجيد عن ابن جريح عنه ، غيره يرويه عن عبد المجيد عن عبد الملك عن المطلب بن عبد الله عن أنس .(@)(@@) 1099 - حديث : ( ( لما رأى النبي عكرمة بن أبي جهل وثب إليه فرحا . . ) ) الحديث .(@)(@@) غريب من حديث الزهري عن أنس ومحمد حديث ابن جريج عن الزهري ما كتبته إلا من حديث أبي عاصم / النبيل عنه .(@)(@@) 1100 - حديث : ( ( أنه رأى رسول الله يشرب لبنا . . ) ) الحديث .(@)(@@) تفرد به سالم عن سعيد بن مرداس الزبيدي عن صالح بن محمد الزبيدي عن قاسم عن عمه عبد الله عن الزهري .(@)(@@) 1101 - حديث : ( ( أن النبي نهى عن الدباء والمزفت ) ) ( 1 ) . PageV02P188(@)(@@) تفرد به نوح بن أبي مريم عنه وعبد الله .(@)(@@) 1102 - حديث : كنا نصلي المغرب ثم ننصرف . . الحديث ( 1 ) .(@)(@@) تفرد به نوح بن أبي مريم ( 1 ) عنه .(@)(@@) 1103 - حديث : أن رسول الله اصطنع خاتما . . الحديث .(@)(@@) تفرد به القاسم بن عبد الله بن عمر ( 2 ) عن أبيه وعمه . عبيد الله 
ms144	 .(@)(@@) 1104 : حديث : قرع عن فرس . . الحديث .(@)(@@) تفرد به عدي بن الفضل ( 3 ) عن عبيد الله .(@)(@@) 1105 - حديث : لا نحافظ . . ( 4 ) الحديث .(@)(@@) تفرد به قيس بن الجهم عن أبي يحيى الحماني عن عبد الله عنه .(@)(@@) 1106 - حديث : إذا أقيمت الصلاة فلا تقوموا . . الحديث ( 5 ) . PageV02P189(@)(@@) تفرد به طاهر بن مدرار عن عثمان بن عبد الرحمن ( 1 ) .(@)(@@) 1107 - حديث : دخلنا على أنس وهو يصلي . . الحديث ( 2 ) .(@)(@@) تفرد به عثمان بن أبي رواد عن الزهري وهو أخو عبد الله بن أبي رواد والحديث في صحيح البخاري .(@)(@@) 1108 - حدث : لا تعاصيا ( 3 ) . . الحديث ( 4 ) .(@)(@@) غريب من حديث عمارة بن عروة عن الزهري .(@)(@@) 1109 - حديث : أن رسول الله رخص لثياب العروس في الخلوق .(@)(@@) تفرد به عبيدة بن عبد الرحيم عن يحيى بن يحيى النيسابوري ( 5 ) عن عقيل عنه . PageV02P190(@)(@@) 1110 - حديث : أن رسول الله أمر بلال أن يشفع الأذان . . الحديث ( 1 ) .(@)(@@) تفرد به عثمان بن صالح ( 2 ) عن ابن لهيعة عن عقيل .(@)(@@) 1111 - حديث : الأنصار أحبائي . . الحديث ( 3 ) .(@)(@@) تفرد به حسان بن غالب الحجري عن ابن لهيعة عن عقيل عنه ، وعنه عبد الله بن لهيعة وعنه عثمان بن صالح .(@)(@@) 1112 - حديث : أتى النبي بقطف من عنب . . . الحديث .(@)(@@) تفرد به إبراهيم بن المنقذ عن ابن وهب عن حفص بن عمر عن عقيل ( 4 ) عنه وغيره يرويه عن ابن وهب ويسنده عن الزهري عن عبد الله بن عباس .(@)(@@) 1113 - حديث : كان رسول الله إذا ارتحل قبل أن تزيغ الشمس أخر الظهر . . الحديث ( 5 ) .(@)(@@) تفرد به حسان بن عبد الله المقبري ويقال له الواسطي عن المفضل / بن فضالة PageV02P191 عن عقيل بهذه الألفاظ وذكر فيه الجمع بين الظهر والعصر في وقت الظهر ، ورواه ابن وهب عن جابر بن إسماعيل عن عقيل ، وتفرد به ابن وهب عن جابر بهذا اللفظ .(@)(@@) 1114 - حديث : أكثر أهل الجنة البله ( ) الحديث ( 1 ) .(@)(@@) تفرد به سلامة بن روح عن عمه عقيل عنه .(@)(@@) 1115 - حديث : بعثت أنا والساعة كهاتين . . الحديث ( 2 ) .(@)(@@) وفيه ذكر الوليد بن عبد الملك ، تفرد 
ms145	 به سلامة بن روح عن عمه عقيل .(@)(@@) 1116 - حديث : كان الحسن والحسين ( يتكآن ) ( ) على ظهر رسول الله . . الحديث .(@)(@@) تفرد به قضيل بن عثمان الأعور الصيرفي المرادي ( 3 ) عن الزهري ، ولم يروه عنه غير سليم بن سفيان .(@)(@@) 1117 - حديث : كان النبي وأبو بكر وعمر يمشون أما الجنازة ( 4 ) .(@)(@@) تفرد به عبد المنعم بن بشير ( 5 ) عن فليح بن سليمان عن الزهري . PageV02P192(@)(@@) 1118 - حديث : أن رسول الله لبى وهدى . . الحديث .(@)(@@) تفرد به قرة بن الرحمن عن الزهري ونوق بن وهب عن قرة عن ربيعة عن أنس ، ورواه سويد بن عبد العزيز عن الزهري وحده .(@)(@@) 1119 - حديث : الأتقياء سادة . . الحديث .(@)(@@) غريب من حديث الزهري عنه ، وغريب من حديث الليث عنه ، تفرد به ( . . . . ) ( ) ابن عمرو عنه ، ولم يروه عنه غير عنبس بن إسماعيل القراء .(@)(@@) 1120 - حديث : الدلجة . . الحديث ( 1 ) .(@)(@@) تفرد به رويم بن يزيد المقري ( 2 ) عن الليث عنه وتابعه بحر بن أسلم الطوسي عن قبيصة عن الليث ، كذا قال قبيصة واعله قتيبة وابن أعين .(@)(@@) 1121 - حديث : من سأله جاره . . الحديث ( 3 ) .(@)(@@) تفرد به شعيب بن يحيى التجيبي ( 4 ) عن الليث وغيره يرويه عن الليث عن مالك عن الزهري عن الأعرج عن أبي هريرة . PageV02P193(@)(@@) 1122 - حديث : لو أن المؤمن في جحر . . الحديث ( 1 ) .(@)(@@) غريب من حديث الزهري عنه ، تفرد به ابن أخيه محمد بن عبد الله بن مسلم ( 2 ) ولم يروه عنه غير أبي قتادة العدوي .(@)(@@) تفرد به عنه أبو بكر عبد الرحمن بن عبد الملك بن شيبة الجرمي ( 3 ) واسم أبي قتادة يعقوب بن عبد الله بن ثعلبة بن صغير العدوي .(@)(@@) 1123 - حديث : إذا قضى أحدكم الصلاة في المسجد . . الحديث ( 4 ) .(@)(@@) وعن الزهري عن أنس وجابر .(@)(@@) 1124 - حديث : كان رسول / الله يأمرنا بالصلاة بالليل ( 5 ) وعنهما .(@)(@@) 1125 - حديث : كان رسول الله يأمرنا بالأثميد .(@)(@@) غريب من حديث الزهري ، تفرد بهما هذا الشيخ عبد الرحمن بن عبد الله بن مسلم وكان ضعيفا عن سعيد بن بزيع ( 6 ) عن ابن إسحاق عنه . PageV02P194(@)(@@) 1126 - حديث : أول زمرة 
ms146	 تدخل الجنة . . الحديث ( 1 ) ، وبمثله .(@)(@@) 1127 - حديث : إن رسول الله قال للزبير : يا زبير مفاتيح الرزق . . الحديث ( 2 ) .(@)(@@) وفيه هارون قاضي مصر مع أمير المؤمنين المأمون ، تفرد به هارون بن عبد الله المقبري ( 3 ) قاضي بمصر عن محمد بن إسحاق .(@)(@@) 1128 - حديث : أن النبي نهى عن ما ( يصنع في الطروف ) ( ) الحديث .(@)(@@) تفرد به محمد بن إسحاق عنه بهذه الألفاظ ولا أعلم رواه عنه غير عبد الأعلى ( 4 ) .(@)(@@) 1129 - حديث : قلت يا رسول الله ما تقول في رجل قليل العمل كثير ( . . . . ) ( ) الحديث .(@)(@@) تفرد به هانئ بن المتوكل ( 5 ) عن محمد بن عياض عن الزهري عنه بهذا الإسناد وهذا اللفظ . PageV02P195(@)(@@) 1130 - حديث : أهديت لرسول الله حلة استبرق . . الحديث .(@)(@@) تفرد به محمد بن الوليد الزبيدي ( 1 ) عن الزهري ولم يروه عنه غير عبد الله بن سالم الحمصي .(@)(@@) 1131 - حديث : قال رسول الله إن من آية المنافقين . . الحديث .(@)(@@) تفرد به عيسى بن المغيرة ( 2 ) عن محمد بن أبي ذئب .(@)(@@) 1132 - حديث : قال رسول الله إذا قام أحدكم إلى الصلاة . . الحديث .(@)(@@) تفرد به عبيد الله بن موسى ( 3 ) عن ابن أبي ذئب .(@)(@@) 1133 - حديث : ليس منا من خصي واختصى . . الحديث ( 4 ) . PageV02P196(@)(@@) تفرد به سليم بن داود الأزدي عن محمد بن حازم عن ابن أبي ذئب .(@)(@@) 1134 - حديث : إن ناسا أعاروا على لقاح رسول الله . . الحديث ( 1 ) .(@)(@@) غريب من حديث الزهري عن انس ومن حديث ابن أبي ذئب عنه ( اسكر ) ( ) بن شييبة واسمه عبد الرحمن بن عبد الملك ( 2 ) عن محمد بن إسماعيل ابن أبي فديك عن ابن أبي ذئب .(@)(@@) 1135 - حديث : اطلبوا الخير عند حسان الوجوه . . الحديث ( 3 ) . PageV02P197(@)(@@) تفرد به سليمان بن سلمة عن عبد العظيم بن حبيب عن ابن أبي ذئب عنه .(@)(@@) 1136 - حديث : حجم النبي أبو طيبة . . الحديث ( 1 ) / .(@)(@@) تفرد به محمد بن عبد الله بن عبيد بن عمير عن الزهري .(@)(@@) 1137 - حديث : ( ( إذا كان يوم القيامة نصب لي منبر . . الحديث ( 2 ) .(@)(@@) تفرد به علي بن يزيد الذهلي ( 3 ) عن ابن عيينة .(@)(@@) 1138 
ms147	 - حديث : نهى رسول الله عن عسب الفحل ( 4 ) . PageV02P198(@)(@@) تفرد به عبد الله بن يوسف عن ابن لهيعة عن عقيل بهذا اللفظ .(@)(@@) 1139 - حديث : نهى رسول الله أن يبيع فحلة فرسه . . الحديث ( 1 ) .(@)(@@) تفرد به ابن لهيعة عن يزيد بن أبي حبيب عنه وقفه الليث ورفعه ابن لهيعة عن يزيد .(@)(@@) 1140 - حديث : أن رجلا من الأنصار استأذنوا . . الحديث ( 2 ) .(@)(@@) تفرد به موسى بن عقبة عن الزهري ، وأخرجه البخاري عن إسماعيل عنه .(@)(@@) 1141 - حديث : كان النبي يصوم حتى نقول لا يفطر . . الحديث ( 3 ) . PageV02P199(@)(@@) تفرد به عبد الله بن ثابت عن ابن أبي ذئب عنه .(@)(@@) 1142 - حديث : كان النبي وأبو بكر وعمر يمشون أمام الجنازة ( 1 ) .(@)(@@) تفرد به عبد المنعم بن بشير ( 2 ) عن فليح بن سليم وروى عن يونس بن يزيد عن الزهري عن أنس ، حدث به عنه وعبد الله بن راشد ومحمد بن بكر البرساني ( 3 ) . PageV02P200(@)(@@) 1143 - حديث : أمر بلالا أن يشفع الأذان . . الحديث ( 1 ) .(@)(@@) تفرد به عثمان بن صالح ( 2 ) عن ابن لهيعة عن عقيل .(@)(@@) 1144 - حديث : لما كان يوم الاثنين الذي قبض فيه رسول الله خرج . . الحديث ( 3 ) .(@)(@@) غريب من حديث عبد الله بن أبي بكر بن محمد بن عمرو بن حزم عن الزهري عن أنس ، تفرد به محمد بن إسحاق عنه .(@)(@@) 1145 - حديث : أن رسول الله أتيناه يلبي بالمدينة . . الحديث . PageV02P201(@)(@@) غريب من حديث عبد الله بن أبي بكر عن الزهري .(@)(@@) تفرد به أبو مريم عبد الغفار بن القاسم ( 1 ) عنه .(@)(@@) 1146 - حديث : نهى رسول الله أن ينام أحدنا مستلقيا على بطنه . . الحديث ( 2 ) .(@)(@@) تفرد به الموقري ( 3 ) عنه .(@)(@@) 1147 - حديث : ما من مؤمن يتصدق بصدقة . . الحديث ( 4 ) .(@)(@@) تفرد به الوليد بن محمد الموقري عنه .(@)(@@) 1148 - حديث : إذا نزع أحدكم عن أخيه شيئا فليره إياه ( 5 ) .(@)(@@) تفرد به الموقري عنه .(@)(@@) 1149 - حديث : الحديث بينكم أمانة مثله ( 6 ) حديث . PageV02P202(@)(@@) 1150 - حديث : إقامة الصف من حسن الصلاة . مثله ( 1 ) .(@)(@@) 1151 - حديث : لا يغتسلن أحدكم بقلاة / . . ( 2 ) الحديث .(@)(@@) تفرد بالحديث أبو سلمة 
ms148	 .(@)(@@) 1152 - حديث : من أشرف العمل بعد الإيمان بالله التحبب إلى الناس وبمثله .(@)(@@) 1153 - حديث : المحموم شهيد مثله ( 3 ) .(@)(@@) 1154 - حديث : كان رسول الله إذا مشى تكفأ مثله .(@)(@@) 1155 - حديث : ليس في الصوم رياء مثله .(@)(@@) 1156 - حديث : من آذى عتيكا . . ( 4 ) الحديث . PageV02P203(@)(@@) 1157 - حديث : أن رسول الله ( 1 ) جامع نساءه في غسل واحد مثله .(@)(@@) 1158 - حديث : أن رسول الله مر بجدار قد مال . . الحديث ( 2 ) ، مثله .(@)(@@) تفرد بهذه الأحاديث الموقري ، ولم يرويها غير أبي أسلم محمد بن مخلد .(@)(@@) 1159 - حديث : لما قدم النبي المدينة أصابهم وعك . . الحديث ( 3 ) . PageV02P204(@)(@@) تفرد به النضر بن شميل عن صالح بن أبي الأخضر وهكذا رواه صالح وابن جريج والموقري عن الزهري .(@)(@@) وتفرد به أبو أسلم محمد بن مخلد عنه ، وخالفهم سفيان بن عيينة فرواه عن الزهري عن عيسى بن طلحة عن عبد الله بن عمرو وخالفهم ابن إسحاق فرواه عن الزهري عن أبي سلمة عن عبد الله بن عمرو وقال بكر بن وائل عن الزهري عن مولى ( 1 ) لعبد الله بن عمرو عن عبد الله بن عمرو وأبي سلمة ومعمر وعبيد الله بن عمر وسعيد بن أبي حمزة وغيرهم عن الزهري عن عبد الله بن عمرو وقال صالح بن عمر عن صالح بن أبي الأخضر ( 2 ) عن الزهري عن السائب بن يزيد عن المطلب بن أبي وداعة عن النبي ، وقال يزيد بن عياض الزهري عن سعيد بن المسيب عن عبد الله بن عمرو وقال شعيب بن خالد عن الزهري عن رجل لم يسمه عن عبد الله بن عمرو وقال إبراهيم بن مرة وعبد الرزاق بن عمر ( 3 ) عن الزهري عن سالم عن أبيه عن النبي . PageV02P205(@)(@@) 1160 - حديث : بينا نحن مع رسول الله فسقط ( ) منه . . الحديث .(@)(@@) تفرد به سلامة بن روح ( 1 ) عن عقيل .(@)(@@) 1161 - حديث : قدم أنس على الوليد بن عبد الملك فسأله ما سمع من رسول الله ( عمن أمر ) ( 2 ) الساعة . . الحديث .(@)(@@) تفرد به سلامة عن عقيل عن الزهري .(@)(@@) 1162 - حديث : كم من ضعيف . . الحديث 
ms149	 ( 3 ) مثله . PageV02P206(@)(@@) 1163 - حديث : لا تحاسدوا . . الحديث .(@)(@@) تفرد به بشر / بن المفضل ( 1 ) عن عبد الرحمن بن إسحاق عن الزهري بقوله : ( ( لا تناجشوا ) ) ولم يقل هذا عن الزهري عن أنس غيره .(@)(@@) 1164 - حديث : كان رسول الله إذا دخل الخلاء . . الحديث ( 2 ) .(@)(@@) تفرد به محمد بن الحسن بن علي بن كيسان عن إبراهيم بن حميد الطويل عن صالح بن أبي الأخضر عنه .(@)(@@) 1165 - حديث : أعيبة ( 3 ) . PageV02P207(@)(@@) تفرد به أبو معاوية عن إسماعيل بن مسلم عن الزهري(@)(@@) 1166 - حديث : من رآني في المنام . . الحديث ( 1 ) .(@)(@@) تفرد به أبو سليم المخزومي يحيى بن خالد عن ابن أبي أويس عن سليم بن بلال عن يونس عن الزهري .(@)(@@) 1167 - حديث : لما ولد إبراهيم ابن النبي كان يقع في نفسه منه شيء . . الحديث ( 2 ) .(@)(@@) تفرد به ابن لهيعة عن عقيل عنه ورواه عمرو بن خالد ، عن ابن لهيعة ، عن عقيل ويزيد بن أبي حبيب وجوده وزاد ألفاظا ، ورواه يحيى بن عثمان ( 3 ) بن صالح عن أبيه وعمرو بن خالد وتفرد به عنهما .(@)(@@) 1168 - حديث : أن النبي نهى عن جز الرأس واللحية . . الحديث ( 4 ) .(@)(@@) تفرد بن ابن لهيعة عن يزيد بن أبي حبيب وعقيل عن الزهري . PageV02P208(@)(@@) 1169 - حديث : لا تطؤوا السبايا . . الحديث ( 1 ) .(@)(@@) 1170 - حديث لا يولهن ولد على والدة ( ) الحديث ( 2 ) .(@)(@@) تفرد بهما إسماعيل بن عياش عن حجاج بن أرطأة عن الزهري .(@)(@@) 1171 - حديث : رأى رسول الله في يد رجل خاتما من ذهب . . الحديث ( 3 ) .(@)(@@) تفرد به إبراهيم بن سعد ( 4 ) عن الزهري وهو معروف برواية عبد العزيز العمري عنه وتابعه بشر بن الوليد .(@)(@@) 1172 - حديث : كان النبي إذا نظر وجهه في المرأة . . الحديث ( 5 ) . PageV02P209(@)(@@) تفرد بن سلم ( 1 ) بن قادم أبو الليث عن أبي معاوية هاشم بن عيسى الحمصي ( 2 ) عن الحارث بن مسلم عن الزهري .(@)(@@) 1173 - حديث : أن رسول الله علم على قبر عثمان بن مظعون ( 3 ) بصخرة ( 4 ) .(@)(@@) تفرد به إسماعيل بن ( مرسال ) ( 5 ) عن الزهري(@)(@@) 1174 - حديث : المرء مع من أحب ( 6 
ms150	 ) . PageV02P210(@)(@@) تفرد به موسى بن عمر عن الزهري بهذا اللفظ .(@)(@@) 1175 - حديث : من نسي صلاة . . الحديث ( 1 ) . PageV02P211(@)(@@) غريب من حديث محمد بن إسحاق عن الزهري وتابعه عثمان الوقاصي ، وتفرد به طاهر بن مدرار عن عثمان عن الزهري .(@)(@@) 1176 - حديث : من قال لا إله إلا الله . . الحديث ( 1 ) .(@)(@@) تفرد به الهذيل بن إبراهيم الحماني / المازني عن عثمان الوقاصي عنه .(@)(@@) 1177 - حديث : كان بين أذان بلال وإقامته . . الحديث ( 2 ) .(@)(@@) تفرد به البهلول بن حسان عن عثمان بن عبد الرحمن ( 39 ) الوقاصي عنه .(@)(@@) 1178 - حديث : مكة حرام . . الحديث ( 4 ) . PageV02P212(@)(@@) تفرد به صالح بن مالك عن عثمان الوقاصي عن الزهري .(@)(@@) 1179 - حديث : إن رسول الله قال للأنصار : فداكم أبي وأمي .(@)(@@) قال أبو زرعة الدمشقي : لم نكتبه إلا عن دحيم عن الوليد بن مسلم ( 1 ) عن مرزوق بن أبي الهذيل ( 2 ) عنه ، قال الدارقطني : تفرد به مرزوق عنه ( 3 ) .(@)(@@) 1180 - حدث : من سأله جاره . . الحديث ( 4 ) . PageV02P213(@)(@@) تفرد به بكر بن سهل عن شعيب بن يحيى عن الليث عن ابن شهاب عن الأعرج عن أنس .(@)(@@) 1181 - حديث : سجدتي السهو قبل التسليم ( 1 ) .(@)(@@) تفرد به عاصم الكوزي ( 2 ) عن إسماعيل بن أمية عن الزهري .(@)(@@) 1182 - حديث : بجلوا المشايخ . . الحديث ( 3 ) .(@)(@@) تفرد به صخر الحاجبي عن الليث ( 4 ) . عنه .(@)(@@) 1183 - حديث : رأيت رسول الله بال على سباطة ( 5 ) قوم . . الحديث ( 6 ) . PageV02P214(@)(@@) تفرد به سحنويه بن مازياد أبو علي مولى بني هاشم عن عبد المجيد بن عبد العزيز ( 1 ) عن ياسين الزيات عنه ، ورواه علي بن يونس الطحان عن عبد المجيد عن ياسين عن الأعمش عن أنس نحوه .(@)(@@) 1184 - حديث : إن رسول الله دخل مكة في عمرة القضاء . . الحديث ( 2 ) .(@)(@@) وفيه الشعر ، تفرد به معمر بن راشد عن الزهري ، وتفرد به عنه عبد الرزاق ، ورواه زمعة بن صالح عن الزهري مرسلا لم يذكر فيه أنسا ورواه ثابت عن انس .(@)(@@) 1185 - حديث : إذا دخل أحدكم المسجد فليقل . . الحديث ( 3 ) .(@)(@@) تفرد به إبراهيم بن الهيثم البلدي ( 4 ) عن إبراهيم بن محمد بن 
ms151	 البختري عن عيسى بن يونس عن معمر عنه .(@)(@@) 1186 - حديث : إذا أتى أحدكم المسجد فلينظر في نعليه . . الحديث ( 5 ) . PageV02P215(@)(@@) تفرد به إبراهيم بن الهيثم البلدي ( 1 ) عن إبراهيم بن محمد عن عيسى عن معمر عنه .(@)(@@) 1187 - حديث : من أراد أن يعلم ما له عند الله عز وجل . . الحديث ( 2 ) .(@)(@@) تفرد به سويد بن هلال عن عبد الرزاق عن معمر عنه .(@)(@@) 1188 - حديث : كان أشبههم وجها برسول الله . . الحديث ( 3 ) .(@)(@@) تفرد به خلف بن أيوب ( 4 ) عن معمر عنه .(@)(@@) يصف مشية فاطمة خاصة .(@)(@@) 1189 - حديث : كنت أضع للنبي طهوره . . الحديث .(@)(@@) تفرد به أحمد بن عبيد / عن محمد بن عمر الواقدي ( 5 ) عن معمر عن الزهري وقتادة . PageV02P216(@)(@@) 1190 - حديث : أن النبي كوى لسعد بن معاذ . . الحديث ( 1 ) .(@)(@@) تفرد به يزيد بن زريع ( 2 ) عن معمر عنه وخالفه عبد الرزاق فقال : عن معمر عن الزهري عن أبي أمامة ( 3 ) بن سهل بن حنيف .(@)(@@) 1191 - حديث : من كذب علي متعمدا . . الحديث ( 4 ) .(@)(@@) تفرد به الواقدي عن معمر عنه .(@)(@@) 1192 - حديث : أمرت أن أقاتل الناس . . الحديث ( 5 ) . PageV02P217(@)(@@) تفرد به الوليد بن محمد الموقري ( 1 ) عنه ، ورواه عمران القطان عن معمر عنه عن أنس عن أبي بكر ، وتفرد به عمران عن معمر بهذا الإسناد ، ولم يروه عنه غير عمرو بن عاصم .(@)(@@) 1193 - حديث : والذي نفسي بيده ما يدخل الجنة إلا رحيم . . الحديث ( 2 ) .(@)(@@) تفرد به طاهر بن الفضل بن سعيد الحلبي ( 3 ) عن ابن عيينة عن معمر عنه وهو غريب من حديث الزهري عن أنس .(@)(@@) 1194 - حديث : نعم الإدام الخل . . الحديث ( 4 ) . PageV02P218(@)(@@) تفرد به مؤمل بن إهاب ( 1 ) عن عبد الرزاق عن معمر عنه .(@)(@@) 1195 - حديث : لما كان يوم حنين انهزم الناس . . الحديث ( 2 ) .(@)(@@) تفرد به عمران القطعان عن معمر عنه ، ولم يروه عنه غير عمرو بن عاصم .(@)(@@) 1196 - حديث : لم يكن منهم أحد أشبه بالنبي من الحسن بن علي . . الحديث ( 3 ) .(@)(@@) تفرد به وفيه وكان رجل جالس مع النبي فجاءه ابن له . . الحديث . PageV02P219(@)(@@) تفرد بهذا 
ms152	 الأخير عبد الله بن معاذ الصنعاني ( 1 ) عن معمر عنه .(@)(@@) 1197 - حديث : الرجل يكون حسن العقل كثير الذنوب . . الحديث .(@)(@@) تفرد به موسى بن عبيدة عن الزهري .(@)(@@) 1198 - حديث : خرجنا مع رسول الله لسبع عشرة من رمضان . . الحديث .(@)(@@) تفرد به إسحاق بن سليم ( 2 ) عن معاوية بن يحيى عنه ، وغيره يرويه عن الزهري عن عبيد الله عن ابن عباس .(@)(@@) 1199 - حديث : أريت أني أتيت بإناء فيه لبن . . الحديث .(@)(@@) تفرد به عبد الملك بن الأحوص عن معاوية بن يحيى عنه ، والمحفوظ عن الزهري عن حمزة بن عبد الله بن عمر عن أبيه .(@)(@@) 1200 - حديث : أمرنا رسول الله أن يشترك السبعة في البدنة . . الحديث ( 3 ) .(@)(@@) تفرد به إسحاق بن سليم الرازي عن معاوية بن يحيى عنه .(@)(@@) 1201 - حديث : تزوجوا في الحي الصالح فإن العرق دساس ( 4 ) .(@)(@@) تفرد به الموقري الوليد بن محمد عنه .(@)(@@) 1202 - حديث : أول حب كان في الإسلام / حب النبي عائشة . PageV02P220(@)(@@) تفرد به الموقري عنه ، ولا نعلم رواه غير موسى بن محمد بن عطاء .(@)(@@) 1203 - حديث : مثل المريض . . الحديث ( 1 ) .(@)(@@) تفرد به الموقري عنه .(@)(@@) 1204 - حديث : كان النبي يمر بالغلمان فيسلم عليه ( 2 ) . PageV02P221(@)(@@) 1205 - حديث : ما صليت خلف أحد قط . . الحديث بمثله .(@)(@@) 1206 - حديث : نعم الشيء الهدية بين يدي طالبة الحاجة ( 1 ) مثله .(@)(@@) 1207 - حديث : نهى النبي عن عسب الفحل ( 2 ) .(@)(@@) تفرد به ابن لهيعة عن يزيد بن أبي حبيب عنه . PageV02P222(@)(@@) 1208 - حديث : اكرموا الأنصار . . ( 1 ) .(@)(@@) تفرد به الموقري عنه ، وعنه أبو أسلم .(@)(@@) 1209 - حديث : سمع النبي رجلا يقرأ ( ^ كل نفس ذائقة الموت . . ) ( 2 ) الحديث .(@)(@@) تفرد به خلف بن ياسين الزيات ( 3 ) عن أبيه عنه .(@)(@@) 1210 - حديث : لا تنتبذوا في الدباء . . الحديث ( 4 ) .(@)(@@) تفرد به أبو الطاهر بن السرح ( 5 ) عن موسى بن ربيعة عن يزيد بن الهاد عنه . PageV02P223(@)(@@) 1211 - حديث : أن النبي وأبا بكر وعمر كانوا يقرؤون ( ^ مالك يوم الدين ) ( 1 ) .(@)(@@) تفرد به أيوب بن سويد ( 2 ) عن يونس عنه .(@)(@@) 1212 - حديث : خير دينكم أيسره ( 3 ) . PageV02P224(@)(@@) تفرد به عبد الرحمن 
ms153	 بن مطرف ( 1 ) عن يونس عنه .(@)(@@) 1213 - حديث : أن زينب بنت رسول الله هاجرت وزوجها أبو الربيع . . الحديث ( 2 ) .(@)(@@) تفرد به سلم بن بلال عن يحيى بن سعيد الأنصاري ( 3 ) عن الزهري ، ولم يروه عنه غير أبي بكر بن أبي أويس ( 4 ) .(@)(@@) 1214 - حديث : أن النبي مر على صبيان فسلم عليهم ( 5 ) .(@)(@@) تفرد به الوليد بن محمد الموقري عنه .(@)(@@) 1215 - حديث : كان النبي يصلي على الخمرة ( 6 ) . PageV02P225(@)(@@) تفرد به يونس عن الزهري .(@)(@@) 1216 - حديث : إذا نزع أحدكم عن أخيه شيئا فليره ( 1 ) .(@)(@@) تفرد به الموقري الوليد بن محمد ( 2 ) عنه .(@)(@@) 1217 - حديث : شهدت لرسول الله وليمتين . . الحديث ( 3 ) .(@)(@@) تفرد به ياسين الزيات عن الزهري بهذه الألفاظ .(@)(@@) 1218 - حديث : زارنا رسول الله في دارنا . . الحديث ( 4 ) .(@)(@@) وفه : ( ( الأيمن فالأيمن ) ) . PageV02P226(@)(@@) غريب صحيح من حديث الزهري .(@)(@@) 1219 - حديث : ما أكثرتم الخوف . . الحديث .(@)(@@) تفرد به أبو الورقاء عن أبي سلمة العاملي وأبي بشر عن الزهري عن أنس ، ( وغريب من ) ( 1 ) وأبو سلمة هذا هو الحكم بن عبد الله بن / خطاف ( 2 ) وأبو بشر هو الوليد بن محمد الموقري .(@)(@@) 1220 - حديث : إن رسول الله قال لعائشة إن كانت ألممت بذنب . . الحديث ( 3 ) .(@)(@@) غريب من حديث الزهري عن أنس لم نكتبه إلا من حديث الحسن بن علي بن زكريا البصري ( 4 ) بإسناده عن الزهري عن عروة عن عائشة .(@)(@@) 1221 - حديث : من أدرك شهر رمضان ثم مات ولم يغفر له فإلى النار ( 5 ) .(@)(@@) تفرد به أبو نافع المدينى عنه .(@)(@@) 1222 - حديث : من اصطنع إليه خيرا فليثن . . الحديث ( 6 ) . PageV02P227(@)(@@) تفرد به محمد بن الوليد القلانسي عن أبي عبد الرحمن الغنوي عن أبي بكر الهذلي عنه .(@)(@@) 1223 - حديث : أن النبي قرأ : ( ^ يومئذ يصدر الناس أشتاتا ليروا أعمالهم ) ( 1 ) . بالفتح ( 2 ) .(@)(@@) غريب من حديث الزهري عن أنس ما كتبناه إلا عن أبي حامد بن محمد هارون الحضري بإسناد عن الزهري .(@)(@@) 1224 - حديث : نهى رسول الله عام الفتح عن نكاح المتعة . . ( 3 ) الحديث .(@)(@@) تفرد به الصباح بن محارب ( 4 ) عن أبي 
ms154	 حنيفة النعمان بن ثابت ( 5 ) عن الزهري .(@)(@@) 1125 - حديث : أن النبي زجر عن الشرب في الأسقية ( 6 ) .(@)(@@) تفرد به سعيد بن بشر عن أبي بكر الهذلي عنه .(@)(@@) 1226 - حديث : كنا نصلي مع رسول الله العصر . . الحديث ( 7 ) . PageV02P228(@)(@@) غريب من حديث أبي خالد الدالاني ( 1 ) عن الزهري .(@)(@@) تفرد به عمرو بن عمان عن جعفر بن سليمان عنه .(@)(@@) محمد بن علي بن الحسين ( 2 ) عن أنس(@)(@@) 1227 - حديث : ما رأيت أحدا أخف صلاة من رسول الله . . الحديث ( 3 ) .(@)(@@) تفرد به عبد الله بن ميمون القداح عن جعفر بن سليمان عن محمد بن علي عن أبيه عن أنس .(@)(@@) محمد بن إبراهيم التيمي ( 4 ) عن أنس(@)(@@) 1228 - حديث : أن رجلا من بني كلاب سأل رسول الله من عسب الفحل . . الحديث ( 5 ) . PageV02P229(@)(@@) غريب من حديث هشام بن عروة عن محمد .(@)(@@) تفرد به إبراهيم بن حميد الرواسي عنه .(@)(@@) 1229 - حديث : خير ما يختصمون فيه . . الحديث .(@)(@@) تفرد به محمد بن عمر الواقدي ( 1 ) عن حميد بن حوط عن صفوان بن سليم عنه .(@)(@@) 1230 - حديث : إذا أكلتم فاخلعوا نعالكم . . الحديث ( 2 ) .(@)(@@) تفرد به موسى بن محمد بن إبراهيم التيمي عن أبيه عن أنس .(@)(@@) محمد بن سيرين ( 3 ) عن أنس(@)(@@) 1231 - حديث : جاء أعرابي إلى النبي فقال ادخل يا / رسول الله . . الحديث .(@)(@@) قال ابن صاعد ( 4 ) هكذا قال عن أنس ولم يقل غيره .(@)(@@) تفرد به محمد بن مصعب عن حماد عن أيوب ( 5 ) عن ابن سيرين عن أنس ، PageV02P230 وتفرد به عنه أحمد بن بكر ( . . . . ) ( ) .(@)(@@) 1232 - حديث : أن رسول الله دعا الحلاق . . الحديث ( 1 ) .(@)(@@) تفرد به سعدويه بن سعيد بن سليم عن عباد بن العوام عن ابن عون وهو صحيح أخرجه مسلم ( 2 ) عن محمد بن عبد الرحيم ( 3 ) عنه ، ورواه حماد بن زيد عن أيوب عن محمد ، وتفرد به حماد بن زيد عنه .(@)(@@) 1233 - حديث : لما جيء برأس الحسين عليه السلام . . الحديث ( 4 ) . PageV02P231(@)(@@) غريب من حديث هشام بن حسان عن ابن سيرين ومن حديث جرير بن حازم عنه ، تفرد 
ms155	 به وهب بن جرير عن أبيه عن هشام وخالفه حسين المروزي ( 1 ) فرواه عن جرير بن حازم عن ابن سيرين عن أنس .(@)(@@) 1234 - حديث : دخلت الجنة فإذا أنا بنهر . . ( 2 ) الحديث .(@)(@@) غريب من حديث كثير بن شنظير ( 3 ) عنه ، تفرد به الهيثم بن خالد بهذا الإسناد .(@)(@@) 1235 - حديث : أتيت أنسا فسألته عن كحل النبي . . الحديث ( 4 ) .(@)(@@) غريب من حديث ابن عون عنه ، تفرد به عمر بن حبيب القاضي عنه .(@)(@@) 1236 - حديث : كان جبريل يعرض القرآن . . الحديث ( 5 ) . PageV02P232(@)(@@) غريب من حديث عبد الله بن عون عنه ، تفرد به يحيى بن خليف ( 1 ) عنه .(@)(@@) 1237 - حديث : كان النبي وأبو بكر وعمر يفتتحون بالحمد لله رب العالمين ( 2 ) .(@)(@@) تفرد به سليمان بن عبد الله الرقي عن خالد بن الحسين عن هشام عن ابن سيرين والحسن عن أنس .(@)(@@) 1238 - حديث : أنه كان إذا رفع رأسه من الركوع . . الحديث ( 3 ) .(@)(@@) تفرد به عبد الرحمن بن عمرو بن جبلة عن الجماعة الذين ذكرهم عن أيوب ( 4 ) عنه .(@)(@@) 1239 - حديث : أصبحت امرأة من الأنصار وعندها أهلها . . الحديث .(@)(@@) تفرد به حاتم بن وردان ( 5 ) عن أيوب .(@)(@@) محمد بن المنكدر ( 6 ) عن أنس(@)(@@) 1240 - حديث : من غش أمتي فعليه لعنة الله عز وجل . . . . . الحديث ( 7 ) .(@)(@@) غريب من حديثه عن أنس ، تفرد به ابن المنكدر ولم يروه عنه غير موسى بن محمد بن عطاء ( 8 ) . PageV02P233(@)(@@) 1241 - حديث : إذا أراد الله بأهل بيت خيرا . . . . الحديث ( 1 ) .(@)(@@) غريب من حديث محمد عنه ، تفرد به عنه ابنه المنكدر ولم يروه غير موسى هذا .(@)(@@) 1242 - حديث : لا يتم بعد حلم . . . . الحديث ( 2 ) غريب من حديثه عنه ، تفرد به يزيد / بن عبد الملك النوفلي ، ولم يروه عنه غير ابنه يحيى .(@)(@@) 1243 - حديث : خطبنا النبي ( على ) ( ) ناقته العضباء . . . . الحديث ( 3 ) . PageV02P234(@)(@@) غريب من حديثه عن أنس ، تفرد به النضر بن محرز بن ( 1 ) ، مغيث عنه ، ولم يروه غير الوليد بن المهلب الأزدي .(@)(@@) 1244 - حديث : إذا كان يوم الجمعة نادى منادي . . . . . الحديث ( 2 ) .(@)(@@) غريب من حديث محمد عن 
ms156	 أنس ، تفرد به يزيد بن مروان الخلال عن المنكدر بن محمد عن أبيه .(@)(@@) محمد بن جحادة ( 3 ) عن أنس(@)(@@) 1245 - حديث : لا تطرحوا الدر من أفواه الكلاب ( 4 ) .(@)(@@) تفرد به يحيى بن عتيبة بن أبي العيزار عنه .(@)(@@) محمد بن أبي بكر بن عوف ابن رباح الثقفي ( 5 ) عن أنس(@)(@@) 1246 - حديث : عدونا مع أنس يوم عرفة . . . الحديث ( 6 ) وروى قبله قصة ، PageV02P235 تفرد به محمد بن طلحة عن عثمان بن عبد الرحمن التيمي عنه .(@)(@@) تفرد به سفيان بن عيينة عن محمد بن عقبة عن محمد بن أبي بكر ، وتفرد به عنه أبو عبد الله المخزومي بقوله عن محمد بن عقبة ( 1 ) وهو أخو موسى بن عقبة ، ورواه عبد الجبار بن العلاء ( 2 ) عن ابن عيينة عن موسى بن عقبة ( 3 ) ، ورواه عن محمد بن أبي بكر ، ورواه بكير بن الأشج ( 4 ) عن محمد بن أبي بكر وتفرد به ميمون بن يحيى عن مخرمة عن أبيه ، ورواه أسامة بن زيد الليثي ( 5 ) عن محمد بن أبي بكر ، وتفرد به عبد الله بن وهب عنه ، ورواه الضحاك بن عثمان ( 6 ) وعبد الله بن محمد بن أبي بكر الثقفي عن محمد بن أبي بكر وتفرد به عنهما محمد بن إسماعيل بن أبي فديك ( 7 ) ورواه عبد الله بن رجاء المكي عن موسى بن عقبة ورواه PageV02P236 مالك ويحيى بن عبد الرحمن بن عثمان التيمي وعبد العزيز الماجشون ( 1 ) عن محمد بن أبي بكر عن أنس .(@)(@@) موسى بن أنس ( 2 ) عن أبيه(@)(@@) 1247 - حديث : كان للنبي سكة ( 3 ) يتطيب منها ( 4 ) .(@)(@@) تفرد به عبد الله بن المختار عنه .(@)(@@) 1248 - حديث : لما أتى رسول الله خيبر . . . . الحديث .(@)(@@) وفيه إذا سمع أذانا ، غريب من حديث يحيى بن سعيد الأنصاري عن حميد عن موسى عن أبيه ، تفرد به عبد الله بن شبيب ( 5 ) عن أيوب بن سليمان ( 6 ) بهذا الإسناد . PageV02P237(@)(@@) مجاهد ( 1 ) عن أنس(@)(@@) 1249 - حديث : ( الااس ) ( ) بكم برجالكم من الجنة . . . . الحديث .(@)(@@) غريب من حديث مجاهد بن جبر عنه 
ms157	 ، تفرد به موسى بن أعين عن ليث بن أبي سليم عنه .(@)(@@) 1250 - حديث : إذا التقى المسلمان بسيفيهما . . . . / الحديث ( 2 ) .(@)(@@) غريب من حديث مجاهد عنه ، تفرد به عباد بن كثير عنه ، وتفرد به موسى بن أعين ( 3 ) عن ( ليث ) ( ) الطرائقي عن عباد .(@)(@@) 1251 - حديث : جاء رجل إلى النبي فقال إن أبي . . . . . الحديث ( 4 ) .(@)(@@) غريب من حديث عنه ، تفرد به ليث عنه وعنه صدقة بن موسى . PageV02P238(@)(@@) مسلم الأعور ( 1 ) عن أنس(@)(@@) 1252 - حديث : كان رسول الله يجيب دعوة المملوك . . . . الحديث ( 2 ) .(@)(@@) تفرد به صالح بن بيان القاضي عن أبي حنيفة الفقيه عنه .(@)(@@) 1253 - حديث : كنت اقدم إلى رسول الله الرطب . . . . . الحديث ( 3 ) تفرد به صالح عن أبي حنيفة .(@)(@@) 1254 - حديث : كان النبي يصلي العصر والشمس بيضاء نقية ( 4 ) .(@)(@@) تفرد به إسماعيل بن صبيح عن عثمان بن يزيد الفقير ( 5 ) عنه .(@)(@@) 1255 - حديث كان النبي يستاك بفضل وضوءه ( 6 ) . PageV02P239(@)(@@) غريب من حديث الأعمش عن مسلم بن كيسان الضبي الملائي ( 1 ) ، تفرد به سعد بن الصلت ( 2 ) عنه وتفرد به عنه إسحاق بن إبراهيم شاذان .(@)(@@) مطر ( 3 ) عن أنس(@)(@@) 1256 - حديث : كان رسول الله إذا أراد أن يزوج بعض بناته . . الحديث ( 4 ) .(@)(@@) تفرد به يحيى بن عبد الله البابلتي ( 5 ) عن عبد العزيز بن حصين عنه .(@)(@@) 1257 - حديث : أهدي لرسول الله طير يقال له ( الحام ) ( 6 )(@)(@@) تفرد به الصعق بن حزن ( 7 ) عن مطر وهو شبه المرسل . PageV02P240(@)(@@) مكحول عن انس(@)(@@) 1258 - حديث : دخلت على أنس فسمعته يقول : كان رسول الله يتعوذ بالله . . . . الحديث ( 1 ) .(@)(@@) تفرد به أحمد بن صالح عن ابن وهب عن أسامة بن زيد عن سليمان بن موسى عنه بهذا اللفظ ولم يتابع عليه قال ابن أبي داود : تفرد به عن أحمد بن صالح إلا من محمد بن عوف الطائي ( 2 ) ولا تحدث به غير ابن وهب إلا أحمد بن صالح وقال من موضع آخر تفرد به سليمان بن موسى ( 3 ) عن مكحول عن أنس ، ولم يروه عنه إلا أسامة بن زيد 
ms158	 . PageV02P241(@)(@@) معاوية بن قرة ( 1 ) عن أنس(@)(@@) 1259 - حديث : مولى القوم منهم . . . . الحديث ( 2 ) تفرد به أو جنادة حصين بن مخارق عن عبد الله بن الحسن العنبري عنه .(@)(@@) مالك بن دينار ( 3 ) عن أنس(@)(@@) 1260 - حديث : قال رسول الله : حب أبي بكر وعمر إيمان وبغضهما كفر ( 4 ) .(@)(@@) غريب من حديث مالك عن أنس ، تفرد به أبو إسحاق خازم بن الحسين الحيسي ( 5 ) عنه ، ولم يروه عنه غير محمد بن عبد الرحمن عن يحيى الحماني . PageV02P242(@)(@@) معبد بن هلال عن أنس(@)(@@) 1261 - حديث : بعثت أنا والساعة كهاتين ( 1 ) . . . الحديث .(@)(@@) غريب من حديث سليمان التيمي عنه ، تفرد به معتمر عن أبيه .(@)(@@) المختار بن فلفل ( 2 ) عن أنس(@)(@@) 1262 - حديث : أن رسول الله رأى رجلا يسوق بدنة . . . . الحديث ( 3 ) .(@)(@@) تفرد به سفيان بن عيينة عن مسعر عنه وقال غيره عن مسعر عن بكير بن الأخنس .(@)(@@) مصعب بن سليم عن أنس(@)(@@) 1263 - حديث : رأيت رسول الله يقسم تمرا على نطع ( 4 ) . . . . . الحديث .(@)(@@) غريب من حديث عبيدة بن أبي رايطة ( 5 ) ما كتبناه إلا من حديث عمرو بن علي عن ابن قتيبة عنه . PageV02P243(@)(@@) ميمون بن أبي سياه ( 1 ) عن أنس(@)(@@) 1264 - حديث : سدرة المنتهى سدرة نبق .(@)(@@) غريب من حديث ميمون عنه ، وغريب من حديث أبي هاشم الرماني ( 2 ) يحيى بن دينار عنه ، تفرد به عنبسة بن سعيد قاضي الري عنه .(@)(@@) مروان الأصفر ( 3 ) عن أنس(@)(@@) 1265 - حديث : لما قدم علي من اليمن . . . . الحديث ( 4 ) .(@)(@@) لا أعلم رواه عن سليم بن حيان غير عبد الصمد .(@)(@@) النضر بن أنس ( 5 ) عن أبيه(@)(@@) 1266 - حديث : أن أنس أمرهما بالكتابة . . . . الحديث . PageV02P244(@)(@@) تفرد به أبو إسماعيل حفص بن عمر عن عبد الله بن المثنى بن عبد الله بن أنس عن النضر وموسى عن أبيهما .(@)(@@) 1267 - حديث : من شهد أن لا إله إلا الله . . . . الحديث ( 1 ) .(@)(@@) غريب من حديث قتادة عن النضر ، تفرد به سعيد بن أبي عروبة ولم يروه عنه غير عامر بن يساق ، تفرد به ( ميسور ) ( ) بن خالد .(@)(@@) نافع أبو سهيل 
ms159	 ( 2 ) عن أنس(@)(@@) 1268 - حديث : نزلت سورة الأنعام . . . . الحديث .(@)(@@) غريب من حديث أبي سهيل نافع بن مالك بن أبي عامر عن أنس ، تفرد به محمد بن إسماعيل بن أبي فديك عن عمر بن طلحة بن عمرو بن علقمة الليثي عنه .(@)(@@) 1269 - حديث : لا إله إلا الله تمتع العباد من سخط الله عز وجل ( 3 ) . PageV02P245(@)(@@) غريب من حديثه عن أنس ، تفرد به عمر بن حمزة العمري عنه ولا نعلم رواه غير أبي أسامة .(@)(@@) النعمان بن مرة ( 1 ) عن أنس(@)(@@) 1270 - / حديث : الأنصار تركتي ( 2 ) . . . . الحديث .(@)(@@) تفرد به زيد بن أخرم عن بشر بن عمر عن حماد بن سلمة عن يحيى بن سعيد عنه .(@)(@@) الهيثم بن حبيب الصراف ( 3 ) عن أنس(@)(@@) 1271 - حديث : أن النبي سافر ليلتين خلتا من رمضان حتى أتى غدير . . . . الحديث ( 4 ) .(@)(@@) غريب من حديث الهيثم عنه ، تفرد به أبو حنيفة ( 5 ) . وكذلك رواه الصلت بن الحجاج ( 6 ) ومكي بن إبراهيم ( 7 ) ، وخالد العبد محمد بن الحسن عن أبي حنيفة . PageV02P246(@)(@@) 1272 - حديث : كان النبي إذا صافح رجلا . . . الحديث ( 1 ) .(@)(@@) غريب من حديث أبي حنيفة عن الهيثم عنه .(@)(@@) تفرد به أحمد بن محمد بن عمرو بن مصعب المصيصي ( 2 ) عن أبي حمزة يعلى بن حمزة عن إبراهيم بن رستم عن أبيه عن عمرو عن أبي حنيفة عن إبراهيم بن المنتشر عن أنس .(@)(@@) هارون بن رئاب ( 3 ) عن أنس(@)(@@) 1273 - حديث : كان رسول الله إذا أراد وجها ورى بغيره . . . . . الحديث ( 4 ) . PageV02P247(@)(@@) غريب من حديث هارون عنه ، تفرد به أحمد بن سعيد الجهضمي عن محمد بن منصور عن حماد بن زيد عن أيوب عن هارون .(@)(@@) يحيى بن سعيد الأنصاري ( 1 ) عن أنس(@)(@@) 1274 - حديث : العرنيين ( 2 ) وفيه ذكر عبد الملك بن مروان ، غريب من حديث طلحة بن مصرف عن يحيى عن أنس ، تفرد به زيد بن أبي أنيسة عن طلحة عنه .(@)(@@) 1275 - حديث : كان رسول الله يطيل في الركعتين . . . . الحديث ( 3 ) .(@)(@@) غريب من حديث يحيى الأنصاري عن أنس .(@)(@@) 1276 - حديث : قال رسول 
ms160	 الله في أحب الأنصار . . . . . الحديث ( 4 ) .(@)(@@) غريب من حديث يحيى الأنصاري عنه ومن حديث الثوري عنه ، تفرد به زافر بن سليمان عن الثوري والمحفوظ عن يحيى بن سعيد عن سعيد بن إبراهيم عن الحكم بن ميناء ( 5 ) عن يزيد بن جارية عن معاوية . PageV02P248(@)(@@) 1277 - حديث : لبيك بحجة وعمرة معا ( 1 ) .(@)(@@) تفرد به أبو يوسف القاضي يعقوب بن إبراهيم ( 2 ) عن يحيى بن سعيد ، وتفرد به أبو يحيى بن أبي مرة عن بشير بن الوليد عنه .(@)(@@) 1278 - حديث : ستتفرق أمتي على ثلاثة وسبعين فرقة . . . . . . الحديث ( 3 ) .(@)(@@) غريب من حديث ياسين الزيات ( 4 ) عن يحيى بن سعيد الأنصاري . تفرد به سلميان بن هوذة عن مكرم بن يوسف عنه .(@)(@@) 1279 - حديث : أن رسول الله نهى أن ييسر التمر بالتمر . . . . . الحديث ( 5 ) .(@)(@@) تفرد به شريك عن يحيى بن سعيد / عنه .(@)(@@) 1280 - حديث : دخل أعرابي المسجد فبال . . . . الحديث ( 6 ) . PageV02P249(@)(@@) غريب من حديث يحيى عنه ، تفرد به سفيان بقوله : إنما بعثني مبشرين ولم ينعتوا مبشرين .(@)(@@) 1281 - حديث : سئل رسول الله عن آل محمد . . . . . الحديث .(@)(@@) وفيه المتقون ، تفرد به نوح بن أبي مريم عن يحيى بن سعيد عنه .(@)(@@) يحيى بن أبي كثير ( 1 ) عن أنس(@)(@@) 1282 - حديث : أيما رجل تولى غير مواليده . . . . . الحديث .(@)(@@) تفرد به عبيس بن ميمون أبو عبيدة البصري ( 2 ) عن يحيى عنه .(@)(@@) 1283 - حديث : سمعت رسول الله يقول إذا أفطر عند قوم أهل بيت . . . . الحديث ( 3 ) .(@)(@@) غريب من حديث الخليل بن مرة عن يحيى تفرد به كثير بن حميد عنه .(@)(@@) 1284 - حديث : جاء رجل إلى النبي فقال : ما لي إذا شهدت أن لا إله إلا الله . . . . . . . الحديث .(@)(@@) غريب من حديث يحيى عنه ، تفرد به عمر بن عبد الله بن أبي خثعم ( 4 ) عنه ولم يروه عنه غير زيد بن حباب .(@)(@@) 1285 - حديث : الحسد عشرة أجزاء . . . . . الحديث ( 5 ) . PageV02P250(@)(@@) غريب من حديث يحيى عنه ، وغريب من حديث الأوزاعي عن يحيى ، تفرد به طلحة بن زيد عن الأوزاعي ، وتفرد به عنه محمد بن يزيد بن سنان .(@)(@@) 1286 