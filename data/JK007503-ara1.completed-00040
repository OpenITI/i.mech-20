ms21	 قد أرى %~% قداها من المولى ، فلا أستثيرها (@)(@@) 16 وقور إذا ما الجهل أعجب أهله %~% ومن خير أخلاق الرجال وقورها (@)(@@) 17 وقد يئس الأعداء أن يستفزني %~% قيام الأسود ، وثبها وزئيرها (@)(@@) 18 ويوم من الشعرى كأن ظباءه %~% كواعب مقصور عليها ستورها (@)(@@) 19 عصبت له رأسي ، وكلفت قطعه %~% هنالك حرجوجا ، بطيئا فتورها (@)(@@) 20 تدلت عليه الشمس حتى كأنها %~% من الحر ترمى بالسكينة قورها (@)PageV01P069 (@)(@@) 21 وماء صرى لم ألق إلا القطا به ، %~% ومشهورة الأطواق ، ورقا نحورها (@)(@@) 22 كأن عصير الضيح ، في سديانه ، %~% دفوفا وأسداما ، طويلا دثورها (@)(@@) 23 وليل ، يقول القوم من ظلماته : %~% سواء بصيرات العيون وعورها (@)(@@) 24 كأن لنا منه بيوتا حصينة ، %~% مسوح أعاليها وساج كسورها (@)(@@) 25 تجاوزته حتى مضى مدلهمه ، %~% ولاح من الشمس المضيئة نورها (@)PageV01P070(@)(@@) البحر : بسيط تام (@)(@@) 1 شريح لا تتركني بعد ما علقت %~% حبالك اليوم بعد القد أظفاري (@)(@@) 2 قد طفت ما بين بانقيا إلى عدن ، %~% وطال في العجم ترحالي وتسياري (@)(@@) 3 فكان أوفاهم عهدا ، وأمنعهم %~% جارا أبوك بعرف غير إنكار (@)(@@) 4 كالغيث ما استمطره جاد وابله ، %~% وعند ذمته المستأسد الضاري (@)(@@) 5 كن كالسموأل إذ سار الهمام له %~% في جحفل كسواد الليل جرار (@)(@@) 6 جار ابن حيا لمن نالته ذمته %~% أوفى وأمنع من جار ابن عمار (@)(@@) 7 بالأبلق الفرد من تيماء منزله ، %~% حصن حصين وجار غير غدار (@)(@@) 8 إذ سامه خطتي خسف ، فقال له : %~% مهما تقله ، فإني سامع حار (@)(@@) 9 فقال : ثكل وغدر أنت بينهما ، %~% فاختر وما فيهما حظ لمختار (@)(@@) 10 فشك غير قليل ، ثم قال له : %~% اذبح هديك إني مانع جاري PageV01P071(@)(@@) 11 إن له خلقا إن كنت قاتله ، %~% وإن قتلت كريما غير عوار (@)(@@) 12 مالا كثيرا وعرضا غير ذي دنس ، %~% وإخوة مثله ليسوا بأشرار (@)(@@) 13 جروا على أدب مني ، بلا نزق ، %~% ولا إذا شمرت حرب بأغمار (@)(@@) 14 وسوف يعقبنيه ، إن ظفرت به ، %~% رب كريم وبيض ذات أطهار (@)(@@) 15 لا سرهن لدينا ضائع مذق ، %~% وكاتمات إذا استودعن أسراري (@)(@@) 16 فقال تقدمة ، إذ قام يقتله : %~% أشرف سموأل فانظر للدم الجاري (@)(@@) 17 أأقتل 
ms22	 ابنك صبرا أو تجيء بها %~% طوعا ، فأنكر هذا أي إنكار (@)(@@) 18 فشك أوداجه والصدر في مضض %~% عليه ، ومنطويا كاللذع بالنار (@)(@@) 19 واختار أدراعه أن لا يسب بها ، %~% ولم يكن عهده فيها بختار (@)(@@) 20 وقال : لا أشتري عارا بمكرمة %~% فاختار مكرمة الدنيا على العار (@)PageV01P072 (@)(@@) 21 والصبر منه قديما شيمة خلق ، %~% وزنده في الوفاء الثاقب الواري (@)PageV01P073(@)(@@) البحر : مخلع البسيط (@)(@@) 1 ألم تروا إراما وعادا ، %~% أودى بها الليل والنهار (@)(@@) 2 بادوا ، فلما أن تآدوا ، %~% قفى على إثرهم قدار (@)(@@) 3 وقبلهم غالت المنايا %~% طسما ولم ينجها الحذار (@)(@@) 4 وحل بالحي من جديس ، %~% يوم من الشر مستطار (@)(@@) 5 وأهل غمدان جمعوا %~% للدهر ما يجمع الخيار (@)(@@) 6 فصبحتهم من الدواهي %~% جائحة عقبها الدمار (@)(@@) 7 وقد غنوا في ظلال ملك ، %~% مؤيد عقلهم ، جفار (@)(@@) 8 وأهل جو أتت عليهم ، %~% فأفسدت عيشهم ، فباروا (@)(@@) 9 ومر حد على وبار ، %~% فهلكت جهرة وبار (@)(@@) 10 بل ليت شعري ، وأين ليت ، %~% وهل يفيئن مستعار PageV01P074 (@)(@@) 11 وهل يعودن بعد عسر ، %~% على أخي فاقة يسار (@)(@@) 12 وهل يشدن من لقوح ، %~% بالشخب من ثرة صرار (@)(@@) 13 أقسمتم لا نعطينكم %~% إلا عرارا ، فذا عرار (@)(@@) 14 كحلفة من أبي رياح ، %~% يسمعها لاهه الكبار (@)(@@) 15 نحيا جميعا ، ولم يفدكم %~% طعن لنا في الكلى فوار (@)(@@) 16 قمنا إليكم ولم يبردنا %~% نضح على حمينا قرار (@)(@@) 17 فقد صبرنا ، ولم نول ، %~% وليس من شأننا الفرار (@)(@@) 18 وقد فررنم ، وما صبرتم ، %~% وذاك شين لكم وعار (@)(@@) 19 فليتنا لم نحل نجدا ، %~% وليتهم قبل تلك غاروا (@)(@@) 20 إن لقيما ، وإن قيلا ، %~% وإن لقمان ، حيث ساروا PageV01P075 (@)(@@) 21 لم يدعوا بعدهم عربيا ، %~% فغنيت بعدهم نزار (@)(@@) 22 فأدركوا بعدما أضاعوا ، %~% وقاتل القوم ، فاستناروا PageV01P076(@)(@@) البحر : كامل تام (@)(@@) 1 وإذا أردت بأرض عكل نائلا ، %~% فاعمد لبيت ربيعة بن حذار (@)(@@) 2 يهب النجيبة والنجيب بسرجه ، %~% والأدم بين لواقح وعشار PageV01P077(@)(@@) البحر : كامل تام (@)(@@) 1 وإذا أتيت معتبا في دارها %~% ألفيت أهل ندى هناك خبير (@)(@@) 2 إن الجواد إذا حللت ببابه ، %~% وإذا تسائله أبو يعفور PageV01P078(@)(@@) البحر : كامل تام (@)(@@) 1 أبلغ بني قيس ، إذا 
ms23	 لاقيتهم ، %~% والحي ذهلا هل بكم تعيير ؟ (@)(@@) 2 زعمت حنيفة لا تجير عليهم %~% بدمائهم ، وأظنها ستجير (@)(@@) 3 كذبوا وبيت الله ، يفعل ذلكم %~% حتى يوازي حزرما كندير (@)(@@) 4 أو أن يروا جبارها وأشاءها ، %~% يعلو دخان فوقها وسعير (@)(@@) 5 هل كنتم إلا دوارج حشوة ، %~% دفعت كواهل عنكم وصدور (@)(@@) 6 أأثال ! إنك إن تطع في هذه ، %~% تصبح وأنت وطأ مكثور PageV01P079(@)(@@) البحر : طويل (@)(@@) 1 ألم تر أن العز ألقى برحله %~% إلى الغر من أولاد بكر بن عامر (@)PageV01P080(@)(@@) البحر : مجزوء الكامل (@)(@@) 1 يا جارتي ، ما كنت جاره ، %~% بانت لتحزننا عفاره (@)(@@) 2 ترضيك من دل ومن %~% حسن ، مخالطه غراره (@)(@@) 3 بيضاء ضحوتها وصف %~% راء العشية كالعرارة (@)(@@) 4 وسبتك حين تبسمت %~% بين الأريكة والستاره (@)(@@) 5 بقوامها الحسن الذي %~% جمع المدادة والجهاره (@)(@@) 6 كمنيل النشوان ير %~% فل في البقيرة والإزاره (@)(@@) 7 ويجيد مغزلة إلى %~% وجه تزينه النضاره (@)(@@) 8 ومها ترف غروبه ، %~% يشفي المتيم ذا الحراره (@)(@@) 9 كذرى منور أقحوا %~% ن قد تسامق في قراراه (@)(@@) 10 وغدائر سود على %~% كفل تزينه الوثاره PageV01P081 (@)(@@) 11 وأرتك كفا في الخضا %~% ب وساعدا مثل الجباره (@)(@@) 12 وإذا تنازعك الحدي %~% ث ثنت وفي النفس ازوراره (@)(@@) 13 من سرك المكتوم تن %~% أى عن هواك فلا ثماره (@)(@@) 14 وتثيب أحيانا فتط %~% مع ثم تدركها الغراره (@)(@@) 15 تبلتك ثمت لم تنل %~% ك على التجمل والوقاره (@)(@@) 16 وما بها أن لا تكو %~% ن من الثواب على يساره (@)(@@) 17 ولقد أنى أن تفي %~% من دونها بابا وداره (@)(@@) 18 ورأت بأن الشيب جا %~% نبه البشاشة والبشاره (@)(@@) 19 فاصبر ، فإنك طالما %~% أعملت نفسك في الخساره (@)(@@) 20 ولقد أنى لك أن تفي %~% ق من الصبابة والدعاره PageV01P082 (@)(@@) 21 ولقد لبست العيش أج %~% مع ، وارتديت من الإباره (@)(@@) 22 ووأصبحت لذات الشبا %~% ب ، مرفلا ونعمت ناره (@)(@@) 23 ولقد شربت الراح أس %~% قى من إناء الطهر جاره (@)(@@) 24 حتى إذا أخذت مآ %~% خذها تغشتني استداره (@)(@@) 25 فاعمد لنعب غير ه %~% ذا مسحل ينعى النكاره (@)(@@) 26 يعدو على الأعداء قص %~% را ، وهو لا يعطى القساره (@)(@@) 27 وسم العلوب 
ms24	 ، فإنه %~% أبقى على القوم استناره (@)(@@) 28 لا ناقصي حسب ، ولا %~% أيد إذا مدت قصاره (@)(@@) 29 وبني بديد إنهم %~% أهل اللآمة والصغاره (@)(@@) 30 ليسوا بعدل حين تن %~% سبهم إلى أخوي فزاره PageV01P083 (@)(@@) 31 بدر وحصن سيدي %~% وقيس بن عيلان الكثاره (@)(@@) 32 ولا إلى الهرمين في %~% بيت الحكومة والخياره (@)(@@) 33 ولا إلى قيس الحفا %~% ظ ، ولا الربيع ولا عماره (@)(@@) 34 ولا كخارجة الذي %~% ولي الحمالة والصباره (@)(@@) 35 وحملت أقوما على %~% حدباء ، تجعلهم دماره (@)(@@) 36 ولقد علمت لتكره %~% ن الحرب من اصر وغاره (@)(@@) 37 ولسوف يحبسك المضي %~% ق بنا فتعتصر اعتصاره (@)(@@) 38 ولسوف تكلح للأسن %~% ة كلحة غير افتراره (@)(@@) 39 وتسير نفس فوق لح %~% يتها ، وليس لها إحاره (@)(@@) 40 وهناك تعلم أن ما %~% قدمت كان هو المطاره PageV01P084 (@)(@@) 41 وهناك يصدق ظنكم %~% أن لا اجتماع ولا زياره (@)(@@) 42 ولا براءة للبري %~% ء ، ولا عطاء ولا خفاره (@)(@@) 43 إلا علالة أو بدا %~% هة سابح نهد الجزاره (@)(@@) 44 أو شطبة جرداء تض %~% بر بالمدجج ذي الغفاره (@)(@@) 45 تغدو بأكلف من أسو %~% د الرقمتين ، حليف زاره (@)(@@) 46 وبنو ضبيعة من يعلمو %~% ن بوارد الخلق الشراره (@)(@@) 47 إنا نوازي من يوا %~% زيهم وننكى ذا الضراره (@)(@@) 48 لسنا نقاتل بالعص %~% ي ، ولا نرامي بالحجاره (@)(@@) 49 قضم المضارب باتر ، %~% يشفي النفوس من الحراره (@)(@@) 50 وتكون في السلف الموا %~% زي منقرا وبني زراره PageV01P085 (@)(@@) 51 أبناء قوم قتلوا %~% يوم القصيبة من أواره (@)(@@) 52 فجروا على ما عودوا ، %~% ولكل عادات أماره (@)(@@) 53 والعود يعصر ماؤه ، %~% ولكل عيدان عصاره (@)(@@) 54 ولا نشبه بالكلا %~% ب على المياه من الحراره (@)(@@) 55 فاقدر بذرعك أن تحي %~% ن ، وكيف بوأت القداره (@)(@@) 56 فأنا الكفيل عليهم ، %~% أن سوف تعتقر اعتقاره (@)(@@) 57 ولقد حلفت لتصبح %~% ن ببعض ظلمك في محاره (@)(@@) 58 ولتصبحنك كأس س %~% م في عواقبها مراره (@)(@@) 59 ولقد علمتم حين ين %~% سب كل حي ذي غضاره (@)(@@) 60 أنا ورثنا العز وال %~% مجد المؤثل ذا السراره PageV01P086 (@)(@@) 61 وورثت دهما دونكم ، %~% وأرى حلومكم معاره (@)(@@) 62 إذ أنتم بالليل سرا %~% ق ، وصبح 
ms25	 غد صراره PageV01P087(@)(@@) البحر :متقارب تام (@)(@@) 1 أأزمعت من آل ليلى ابتكارا ، %~% وشطت على ذي هوى أن تزارا (@)(@@) 2 ونابت بها غربات النوى ، %~% وبد لت شوقا بها واد كارا (@)(@@) 3 ففاضت دموعي كفيض الغرو %~% ب ، إما وكيفا وإما انحدارا (@)(@@) 4 كما أسلم السلك من نظمه %~% لآلىء منحدرات صغارا (@)(@@) 5 قليلا فثم زجرت الصبى ، %~% شي ، وسير الغدو (@)(@@) 6 فأصبحت لا أقرب الغانيا %~% ت ، مزد جرا عن هواي ازد جارا (@)(@@) 7 وإن أخاك الذي تعلمين %~% ليا لينا ، إذ نحل الجفارا (@)(@@) 8 تبد ل بعد الصبى حكمة ، %~% وقنعه الشيب منه خمارا (@)(@@) 9 أحل به الشيب أثقاله ، %~% وما اعتره الشيب إلا اعترارا (@)(@@) 10 فإما تربي على آلة ، %~% قليت الصبي ، وهجرت التجارا PageV01P088 (@)(@@) 11 فقد أخرج الكاعب المسترا %~% ة ، من خدرها ، وأشيع القمارا (@)(@@) 12 وذات نواف كلون الفصو %~% ص ، باكرتها فادمجت ابتكارا (@)(@@) 13 تشد اللفاق عليها إزارا %~% ق ، إما نقالا ، وإما اغتمارا (@)(@@) 14 يعاصي العواذل طلق اليدين %~% يروي العفاة ويرخي الإزارا (@)(@@) 15 فلم ينطق الديك حتى ملأ %~% ت كوب الرباب له فاستد ارا (@)(@@) 16 إذ انكب أزهر بين السقاة ، %~% تراموا به غربا أو نضارا (@)(@@) 17 وشوق علوق تناسيته ، %~% بجوالة تستخف الضفارا (@)(@@) 18 بقية خمس من الرامسا %~% ت بيض تشبههن الصوارا (@)(@@) 19 دفعن إلى اثنين عند الخصو %~% ص قد حبسا بينهن الإصارا (@)(@@) 20 فعادا لهن ورازا له %~% ن ، واشتركا عملا وائتمارا PageV01P089 (@)(@@) 21 فهذا يعد لهن الخلى ، %~% إذا رهب الموج نوتيه ، (@)(@@) 22 فكانت سريتهن التي %~% / تروق العيون وتقضي السفارا (@)(@@) 23 فأبقى رواحي وسير الغد %~% و منها ذوات حذاء قصارا (@)(@@) 24 وألواح رهب ، كأن النسو %~% ع أبن في الدف منها سطارا (@)(@@) 25 ودأيا تلاحكن مثل الفؤو %~% س ، لاحم منها السليل الفقارا (@)(@@) 26 فلا تشتكن إلي الوجى ، %~% وطول السرى ، واجعليه اصطبارا (@)(@@) 27 يد الدهر حتى تلاقي الخيارا %~% (@)(@@) 28 تلاقين قيسا وأشياعه ، %~% يسعر للحرب نارا ، فنارا (@)(@@) 29 أقول لها حين جد الرحي %~% ل : أبرحت ربا ، وأبرحت جارا (@)(@@) 30 فمن مبلغ قومنا مالكا %~% إلى ملك خير أربابه ، PageV01P090 (@)(@@) 31 فدونكم ربكم حالفوه ، %~% إذا ظاهر 
ms26	 الملك قوما ظهارا (@)(@@) 32 وما أيبلي على هيكل ، %~% إذا اقتسم القوم أمرا كبارا (@)(@@) 33 فإن لكم قربه عزة ، %~% ووسطكم ملكه واستشارا (@)(@@) 34 فإن الذي يرتحى سيبه %~% إذا ما نحل عليه اختيارا (@)(@@) 35 أخو الحرب ، إذ لقحت بازلا %~% سما للعلى وأحل الجمارا (@)(@@) 36 وساروا بالنفع نفع الكثي %~% ب عبسا ود ودان يوما سوارا (@)(@@) 37 فأقللت قوما وأعمرتهم ، %~% وأخربت من أرض قوم ديارا (@)(@@) 38 عطاء الإله ، فإن الإل %~% ه يسمع في الغامضات السرارا (@)(@@) 39 فيا رب ناعية منهم %~% تشد اللقاق عليها إزارا (@)(@@) 40 تنوط التميم ، وتأبى الغبو %~% ق ، من سنة النوم إلا نهارا (@)PageV01P091 (@)(@@) 41 ملكت ، فعانقتها ليلة ، %~% تنص القعود ، وتدعو يسارا (@)(@@) 42 فلا تحسبني لكم كافرا ، %~% ولا تحسبني أريد الغيارا (@)(@@) 43 فإني وجدك ، لولا تجيء %~% لقد قلق الخرت أن لا انتظارا (@)(@@) 44 كطوف الغريبة وسط الحياض %~% تخاف الردى وتريد الجفارا (@)(@@) 45 ويوم يبيل النساء الدما ، %~% جعلت رداءك فيه خمارا (@)(@@) 46 فيا ليلة لي في لعلع ، %~% كطوف الغريب يخاف الإسارا (@)(@@) 47 فلما أتانا بعيد الكرى %~% سجدنا له ، ورفعنا عمارا (@)(@@) 48 فذاك أوان التقى والزكى ، %~% وإن لما كل شيء قرارا (@)(@@) 49 إلى حامل الثقل عن أهله %~% إذا الدهر ساق الهنات الكبارا (@)(@@) 50 ومن لا تفزع جاراته ، %~% ومن لا يرى حلمه مستعارا PageV01P092 (@)(@@) 51 ومن لا تضارع له ذمة ، %~% فيجعلها بين عين ضمارا (@)(@@) 52 وما رائح روحته الجنوب ، %~% يروي الزروع ويعلو الديارا (@)(@@) 53 يكب السفين لأذقانه ، %~% ويصرع بالعبر أثلا وزارا PageV01P093(@)(@@) البحر: متقارب تام (@)(@@) 1 غشيت لليلى بليل خدورا ، %~% وطالبتها ، ونذرت النذورا (@)(@@) 2 وبانت ، وقد أورثت في الفؤا %~% د صدعا ، على نأيها ، مستطيرا (@)(@@) 3 كصدع الزجاجة ما تستطي %~% ع كف الصناع لها أن تحيرا (@)(@@) 4 مليكية جاورت بالحجا %~% ز قوما عداة وأرضا شطيرا (@)(@@) 5 بما قد تريع روض القطا ، %~% وروض التناصب حتى تصيرا (@)(@@) 6 كبردية الغيل وسط الغريف ، %~% إذا خالط الماء منها السرورا (@)(@@) 7 وتفتر عن مشرق بارد %~% كشوك السيال أسف النؤوارا (@)(@@) 8 كأن جنيا من الزنجبي %~% ل خالط فاها وأربا مشورا (@)(@@) 9 وإسفنط عانة بعد الرقا 
ms27	 %~% د شك الرصاف إليها غديرا (@)(@@) 10 تهادى كما قد رأيت البهيرا %~% PageV01P094 (@)(@@) 11 لها ملك كان يخشى القراف ، %~% إذا خالط الظن منه الضميرا (@)(@@) 12 إذا نزل الحي حل الجحيش %~% شقيا غويا مبينا غيورا (@)(@@) 13 يقول لعبديه حثا النجا ، %~% وغضا من الطرف عنا وسيرا (@)(@@) 14 فليس بمرع على صاحب ، %~% وليس بمانعه أن تحورا (@)(@@) 15 وليس بمانعها بابها ، %~% ولا مستطيع بها أن يطيرا (@)(@@) 16 فبان بحسناء براقة %~% على أن في الطرف منها فتورا (@)(@@) 17 مبتلة الخلق مثل المها %~% ة لم تر شمسا ولا زمهريرا (@)(@@) 18 وتيرد برد رداء العرو %~% س رقرقت بالصيف فيه العبيرا (@)(@@) 19 وتسخن ليلة لا يستطيع %~% نباحا بها الكلب إلا هريرا (@)(@@) 20 ترى الخز تلبسه ظاهرا ، %~% وتبطن من دون ذاك الحريرا PageV01P095 (@)(@@) 21 إذا قلدت معصما يارقي %~% ن ، فصل بالدر فصلا نضيرا (@)(@@) 22 وجل زبرجدة فوقه ، %~% وياقوتة خلت شيئا نكيرا (@)(@@) 23 فألوت به طار منك الفؤاد ، %~% وألفيت حيران أو مستحيرا (@)(@@) 24 على أنها إذ رأتني أقا %~% د قالت بما قد أراه بصيرا (@)(@@) 25 رأيت رجلا غائب الوافدي %~% ن مختلف الخلق أعشى ضريرا (@)(@@) 26 فإن الحوادث ضعضعنني ، %~% وإن الذي تعلمين استعيرا (@)(@@) 27 إذا كان هادي الفتى في البلا %~% د صدر القناة أطاع الأميرا (@)(@@) 28 وخال السهولة وعثا وعورا %~% (@)(@@) 29 وفي ذاك ما يستفيد الفتى ، %~% (@)(@@) 30 وبيداء يلعب فيها السرا %~% ب لا يهتدي القوم فيها مسيرا (@)PageV01P096 (@)(@@) 31 قطعت ، إذا سمع السامعو %~% ن للجندب الجون فيها صريرا (@)(@@) 32 بناجية كأتان الثمل ، %~% توفي السرى بعد أين عسيرا (@)(@@) 33 جمالية تغتلي بالرداف ، %~% إذا كذب الآثمات الهجيرا (@)(@@) 34 إلى ملك كهلال السما %~% ء أزكى وفاء ومجدا وخيرا (@)(@@) 35 طويل النجاد رفيع العما %~% د يحمي المضاف ويعطي الفقرا (@)(@@) 36 أهوذ ، وأنت امرؤ ماجد ، %~% وبحرك في الناس يعلو البحورا (@)(@@) 37 مننت علي العطاء الجزيل ، %~% PageV01P097(@)(@@) البحر : متقارب تام (@)(@@) 1 وخاف العثار ، إذا ما مشى ، %~% فما إن تبين أسطارها (@)(@@) 2 وريع الفؤاد لعرفانها ، %~% وهاجت على النفس أذكارها (@)(@@) 3 ديار لميثاء حلت بها ، %~% فقد باعدت منكم دارها (@)(@@) 4 رأت أنها رخصة في 
ms28	 الثياب ، %~% ولم تعد في السن أبكارها (@)(@@) 5 فأعجبها ما رأت عندها ، %~% وأجشمها ذاك إبطارها (@)(@@) 6 تنابشتها لم تكن خلة ، %~% ولم يعلم الناس أسرارها (@)(@@) 7 فبانت ، وقد أورثت في الفؤا %~% د صدعا يخالط عثارها (@)(@@) 8 كصدع الزجاجة ، ما يستطي %~% ع من كان يشعب تجبارها (@)(@@) 9 فعشنا زمانا وما بيننا %~% رسول يحدث أخبارها (@)(@@) 10 وأصبحت لا أستطيع الكلام ، %~% سوى أن أراجع سمسارها PageV01P098 (@)(@@) 11 وصهباء صرف كلون الفصو %~% ص باكرت في الصبح سوارها (@)(@@) 12 فطورا تميل بنا مرة ، %~% ل خالط فاها وأريا مشورا (@)(@@) 13 تكاد تنشي ، ولما تذق ، %~% وتغشي المفاصل إفتارها (@)(@@) 14 تدب لها فترة في العظام ، %~% وتغشي الذؤابة فوارها (@)(@@) 15 تمززتها في بني قابيا ، %~% وكنت على العلم مختارها (@)(@@) 16 إذا سمت بائعها حقه %~% عنفت ، وأغضبت تجارها (@)(@@) 17 معي من كفاني غلاء السبا ، %~% وسمع القلوب وإبصارها (@)(@@) 18 إذا عدت النفس أقتارها %~% (@)(@@) 19 ومسمعتان ، وصناجة ، %~% تقلب بالكف أوتارها (@)(@@) 20 وبربطنا معمل دائم ، %~% فقد كاد يغلب إسكارها PageV01P099 (@)(@@) 21 وذو تومتين وقاقزة %~% يعل ويسرع تكرارها (@)(@@) 22 توفي ليوم وفي ليلة ، %~% ثمانين نحسب إستارها PageV01P100(@)(@@) البحر :وافر تام (@)(@@) 1 متى تقرن أصم بحبل أعشى متى تقرن أصم بحبل أعشى %~% يلجا في الضلالة والخسار (@)(@@) 2 فلست بمبصر شيئا يراه ، %~% وليس بسامع مني حواري PageV01P101(@)(@@) البحر: سريع (@)(@@) 1 شاقتك من قتلة أطلالها ، %~% بالشط فالوتر إلى حاجر (@)(@@) 2 فركن مهراس إلى مارد ، %~% فقاع منفوحة ذي الحائر (@)(@@) 3 دار لها غير آياتها %~% كل ملث صوبه زاخر (@)(@@) 4 وقد أراها وسط أترابها ، %~% في الحي ذي البهجة والسامر (@)(@@) 5 كدمية صور محرابها %~% بمذهب في مرمر مائر (@)(@@) 6 أو بيضة في الذعص مكنونة ، %~% أو درة شيفت لدى تاجر (@)(@@) 7 يشفي غليل النفس لاه بها ، %~% حوراء تسبي نظر الناظر (@)(@@) 8 ليست بسوداء ولا عنفص ، %~% داعرة تدنو إلى الداعر (@)(@@) 9 عبهرة الخلق ، بلاخية ، %~% تشوبه بالخلق الطاهر (@)(@@) 10 عهدي بها في الحي قد سربلت %~% هيفاء مثل المهرة الضامر PageV01P102 (@)(@@) 11 قد نهد الثدي على صدرها %~% في مشرق ذي صبح نائر (@)(@@) 12 لو أسندت ميتا إلى نحرها ، %~% عاش ولم ينقل إلى 
ms29	 قابر (@)(@@) 13 حتى يقول الناس مما رأوا : %~% يا عجبا للميت الناشر (@)(@@) 14 دعها ، فقد أعذرت في حبها ، %~% واذكر خنا علقمة الفاخر (@)(@@) 15 علقم ، لا لست إلى عامر ، %~% الناقض الأوتار والواتر (@)(@@) 16 واللابس الخيل بخيل ، إذا %~% ثار غبار الكبة الثائر (@)(@@) 17 سدت بني الأحوص لم تعدهم ، %~% وعامر ساد بني عامر (@)(@@) 18 ساد وألفى قومه سادة ، %~% وكابرا سادوك عن كابر (@)(@@) 19 ما يجعل الجد الظنون الذي %~% جنب صوب اللجب الزاخر (@)(@@) 20 مثل الفراتي ، إذا ما طما %~% يقذف بالبوصي والماهر PageV01P103 (@)(@@) 21 إن الذي فيه تداريتما %~% بين للسامع والآثر (@)(@@) 22 حكمتموني ، فقضى بينكم %~% أبلج مثل القمر الباهر (@)(@@) 23 لا يأخذ الرشوة في حكمه ، %~% ولا يبالي غبن الخاسر (@)(@@) 24 ولا يرهب المنكر منكم ، ولا %~% يرجوكم إلا نقى الآصر (@)(@@) 25 يا عجب الدهر متى سويا ؟ %~% كم ضاحك من ذا ، ومن ساخر (@)(@@) 26 فاقن حياء أنت ضيعته ، %~% ما لك بعد الشيب من عاذر (@)(@@) 27 ولست بالأكثر منهم حصى ، %~% وإنما العزة للكاثر (@)(@@) 28 ولست بالأثرين من مالك ، %~% ولا أبي بكر ذوي الناصر (@)(@@) 29 هم هامة الحي ، إذا حصلوا %~% من جعفر في السؤدد القاهر (@)(@@) 30 أقول لما جاءني فجره %~% من أمة في الزمن الغابر PageV01P104 (@)(@@) 31 علقم لا تسفه ولا تجعلن %~% عرضك للوارد والصادر (@)(@@) 32 أؤول الحكم على وجهه ، %~% ليس قضائي بالهوى الجائر (@)(@@) 33 قد قلت قولا ، فقضى بينكم ، %~% واعترف المنفور للنافر (@)(@@) 34 كم قد مضى شعري في مثله %~% فسار لي من منطق سائر (@)(@@) 35 إن ترجع الحكم إلى أهله ، %~% فلست بالمسني ولا النائر (@)(@@) 36 حولي ذوو الآكال من وائل %~% ولست في الهيجاء بالجاسر (@)(@@) 37 إني آليت على حلفة ، %~% ولم أقله عثرة العاثر (@)(@@) 38 ليأتينه منطق سائر ، %~% مستوثق للمسمع الآثر (@)(@@) 39 عض بما أبقى المواسي له %~% من أمه في الزمن الغابر (@)(@@) 40 وكن قد أبقين منها أذى ، %~% عند الملاقي وافي الشافر PageV01P105 (@)(@@) 41 لا تحسبني عنكم غافلا %~% فلست بالواني ولا الفاتر (@)(@@) 42 واسمع ، فإني طبن عالم ، %~% أقطع من شقشقة الهادر (@)(@@) 43 يقسم بالله لئن جاءه %~% عني أذى من سامع خابر (@)(@@) 44 
ms30	 ليجعلني سبة بعدها ، %~% جدعت ، يا علقم ، من ناذر (@)(@@) 45 أجذعا توعدني سادرا ، %~% لست على الأعداء بالقادر (@)(@@) 46 انظر إلى كف وأسرارها ، %~% هل أنت إن أوعدتني صابري (@)(@@) 47 إني رأيت الحرب إن شمرت ، %~% دارت بك الحرب مع الدائر (@)(@@) 48 كالليل من باد ومن حاضر %~%(@)(@@) 49 المطعمو اللحم ، إذا ما شتوا ، %~% والجاعلو القوت على الياسر (@)(@@) 50 من كل كوماء سحوف ، إذا %~% جفت من اللحم مدى الجازر PageV01P106 (@)(@@) 51 والشافعون الجوع عن جارهم %~% حتى يرى كالغصن الناضر (@)(@@) 52 كم فيهم من شبطة خيفق %~% وسابح ذي ميعة ضابر (@)(@@) 53 زكل جوب مترص صنعه ، %~% وصارم ذي رونق باتر (@)(@@) 54 وكل مرنان له أزمل ، %~% ولين أكعبه حادر (@)(@@) 55 وقد أسلي الهم حين اعترى ، %~% بجسر ودوسرة عاقر (@)(@@) 56 زيافة بالرحل خطارة ، %~% تلوي بشرخي ميسة قاتر (@)(@@) 57 شتان ما يومي على كورها ، %~% ويوم حيان أخي جابر (@)(@@) 58 في مجدل شيد بنيانه ، %~% يزل عنه ظفر الطائر (@)(@@) 59 يجمع خضراء لها سورة %~% تعصف بالدرع والحاسر (@)(@@) 60 باسلة الوقع ، سرابيلها %~% بيض إلى جانبه الظاهر PageV01P107(@)(@@) البحر: طويل (@)(@@) 1 لعمري لئن أمسى من الحي شاخصا ، %~% لقد نال خيصا من عفيرة خائصا (@)(@@) 2 إذا جردت يوما حسبت خميصة %~% عليها ، وجريالا ، يضيء دلامصا (@)(@@) 3 تقمرها شيخ عشاء ، فأصبحت %~% قضاعية تأتي الكواهن ناشصا (@)(@@) 4 فأقصدها سهمي ، وقد كان قبلها %~% لأمثالها من نسوة الحي قارصا (@)(@@) 5 أتاني وعيد الحوص من آل جعفر ، %~% فيا عبد عمرو لو نهيت الأحاوصا (@)(@@) 6 فقلت ، ولم أملك : أبكر بن وائل %~% متى كنت فقعا نابتا بقصائصا (@)(@@) 7 وقد ملأت بكر ومن لف لفها %~% نباكا فأحواض الرجا فالنواعصا (@)(@@) 8 أعلقم ! قد حكمتني ، فوجدتني %~% بكم عالما على الحكومة غائصا (@)(@@) 9 كلا أبويكم كان فرعا دعامة ، %~% ولكنهم زادوا وأصبحت ناقصا (@)(@@) 10 هم الطرف الناكو العدو ، وأنتم %~% بقصوى ثلاث تأكلون الوقائصا (@)PageV01P108 (@)(@@) 11 تبيتون في المشتى ملاء بطونكم ، %~% وجاراتكم جوعى يبن خمائصا (@)(@@) 12 يراقبن من جوع خلال مخافة %~% نجوم السماء العاتمات الغوامصا (@)(@@) 13 أتوعدني أن جاش بحر ابن عمكم ، %~% وبحرك ساج لا يواري الدعامصا (@)(@@) 14 فلو كنتم نخلا لكنتم 
ms31	 جرامة ، %~% ولو كنتم نبلا لكنتم معاقصا (@)(@@) 15 رمى بك في أخراهم تركك العلى ، %~% وفضل أقواما عليك مراهصا (@)(@@) 16 فغض جديد الأرض إن كنت ساخطا %~% بفيك وأحجار الكلاب الرواهصا (@)(@@) 17 فإن تتعدني ، أتعدك بمثلها ، %~% وسوف أزيد الباقيات القوارصا (@)(@@) 18 قوافي أمثالا يوسعن جلده ، %~% كما زدت في عرض القميص الدخارصا (@)(@@) 19 وقد كان شيخانا ، إذا ما تلاقيا ، %~% عدوين شتى يرميان الفرائصا (@)(@@) 20 وما خلت أبقى بيننا من مودة %~% عراض المذاكي المسنفات القلائصا (@)PageV01P109 (@)(@@) 21 فهل أنتم إلا عبيدا ، وإنما %~% تعدون خوصا في الصديق لوامصا (@)(@@) 22 تخامصكم عن حقكم غير طائل %~% على ساعة ما خلت فيها تخامصا (@)(@@) 23 فإن يلق قومي قومه تربينهم %~% قتالا وأكسار القنا ومداعصا (@)(@@) 24 ألم تر أن العرض أصبح بطنها %~% نخيلا وزرعا نابتا ، وفصافصا (@)(@@) 25 وذا شرفات يقصر الطير دونه ، %~% ترى للحمام الورق فيه قرامصا (@)PageV01P110(@)(@@) البحر : متقارب تام (@)(@@) 1 وقد أغلقت حلقات الشباب ، %~% فأنى لي اليوم أن أستفيصا (@)(@@) 2 فتلك التي حرمتك المتاع ، %~% وأوردت بقلبك إلا شقيصا (@)(@@) 3 وإنك لو سرت عمر الفتى ، %~% لتلقى لها شبها أو تغوصا (@)(@@) 4 رجعت لما رمت مستحسنا ، %~% ترى للكواعب كهرا وبيصا (@)(@@) 5 فإن كنت من ودها يائسا ، %~% وأجمعت منها بحج قلوصا (@)(@@) 6 فقرب لرحلك جلذية ، %~% هبوب السرى لا تمل النصيصا (@)(@@) 7 يشبهها صحبتي موهنا ، %~% إذا ما استتبت ، أتانا نحوصا (@)(@@) 8 إليك ابن جفنة من شقة ، %~% دأبت السرى ، وحسرت القلوصا (@)(@@) 9 تشكى إلي فلم أشكها %~% مناسم تدمى وخفا رهيصا (@)(@@) 10 يراك الأعادي على رغمتهم ، %~% تحل عليهم محلا عويصا PageV01P111 (@)(@@) 11 كحية سلع من القاتلات ، %~% تقد الصرامة عنك القميصا (@)(@@) 12 إذا ما بدا بدوة للعيون ، %~% تذكر ذو الضغن منه المحيصا PageV01P112(@)(@@) البحر : متقارب تام (@)(@@) 1 أعلقم قد صيرتني الأمور %~% إليك ، وما كان لي منكص (@)(@@) 2 كساكم علاثة أثوابه ، %~% وورثكم مجده الأحوص (@)(@@) 3 وكل أناس ، وإن أفحلوا ، %~% إذا عاينوا فحلكم بصبصوا (@)(@@) 4 وإن فحص الناس عن سيد ، %~% فسيدكم عنه لا يفحص (@)(@@) 5 فهل تنكر الشمس في ضوئها ، %~% أو القمر الباهر المبرص (@)(@@) 6 فهب لي ذنوبي فدتك النفوس ، %~% ولا زلت 
ms32	 تنمي ، ولا تنقص PageV01P113(@)(@@) البحر : طويل (@)(@@) 1 بانت سعاد وأمسى حبلها انقطعا ، %~% واحتلت الغمر فالجدين فالفرعا (@)(@@) 2 وأنكرتني وما كان الذي نكرت %~% من الحوادث إلا الشيب والصلعا (@)(@@) 3 قد يترك الدهر في خلقاء راسية %~% وهيا وينزل منها الأعصم الصدعا (@)(@@) 4 بانت وقد أسأرت في النفس حاجتها %~% بعد ائتلاف ، وخير الود ما نفعا (@)(@@) 5 وقد أرانا طلابا هم صاحبه ، %~% لو أن شيئا إذا ما فاتنا رجعا (@)(@@) 6 تعصي الوشاة وكان الحب آونة %~% مما يزين للمشغوف ما صنعا (@)(@@) 7 وكان شيء إلى شيء ، ففرقه %~% دهر يعود على تشتيت ما جمعا (@)(@@) 8 وما طلابك شيئا لست مدركه ، %~% إن كان عنك غراب الجهل قد وقعا (@)(@@) 9 تقول بني ، وقد قربت مرتحلا : %~% يارب جنب أبي الأوصاب والوجعا (@)(@@) 10 واستشفعت من سراة الحي ذا شرف ، %~% فقد عصاها أبوها والذي شفعا (@)PageV01P114 (@)(@@) 11 مهلا بني ، فإن المرء يبعثه %~% هم ، إذا خالط الحيزوم والضلعا (@)(@@) 12 عليك مثل الذي صليت فاغتمضي %~% يوما فإن لجنب المرء مضطجعا (@)(@@) 13 واستخبري قافل الركبان وانتظري %~% أوب المسافر ، إن ريثا وإن سرعا (@)(@@) 14 كوني كمثل التي إذ غاب وافدها %~% أهدت له من بعيد نظرة جزعا (@)(@@) 15 ولا تكوني كمن لا يرتجي أوبة %~% لذي اغتراب ولا يرجو له رجعا (@)(@@) 16 ما نظرت ذات أشفار كنظرتها %~% حقا كما صدق الذئبي إذ سجعا (@)(@@) 17 إذ نظرت نظرة ليست بكاذبة ، %~% إذ يرفع الآل رأس الكلب فارتفعا (@)(@@) 18 وقلبت مقلة ليست بمقرفة ، %~% إنسان عين ومؤقا لم يكن قمعا (@)(@@) 19 قالت : أرى رجلا في كفه كتف %~% أو يخصف النعل لهفي أية صنعا (@)(@@) 20 فكذبوها بما قالت ، فصبحهم %~% ذو آل حسان يزجي الموت والشرعا (@)PageV01P115 (@)(@@) 21 فاستنزلوا أهل جو من مساكنهم ، %~% وهدموا شاخص البنيان فاتضعا (@)(@@) 22 وبلدة يرهب الجواب دلجتها ، %~% حتى تراه عليها يبتغي الشيعا (@)(@@) 23 لا يسمع المرء فيها ما يؤنسه %~% بالليل إبلا نئيم البوم والضوعا (@)(@@) 24 كلفت مجهولها نفسي وشايعني %~% همي عليها ، إذا ما آلها لمعا (@)(@@) 25 بذات لوث عفرناة ، إذا عثرت ، %~% فالتعس أدنى لها من أن أقول لعا (@)(@@) 26 تلوي بعذق 
ms33	 خصاب كلما خطرت %~% عن فرج معوقة لم تتبع ربعا (@)(@@) 27 تخال حتما عليها كلما ضمرت %~% من الكلال ، بأن تستوفي النسعا (@)(@@) 28 كأنها بعدما أفضى النجاد بها %~% بالشيطين ، مهاة تبتغي ذرعا (@)(@@) 29 أهوى لها ضابئ في الأرض مفتحص %~% للحم قدما خفي الشخص قد خشعا (@)(@@) 30 فظل يخدعها عن نفس واحدها %~% في أرض فيء بفعل مثله خدعا (@)PageV01P116 (@)(@@) 31 حانت ليفجعها بابن وتطعمه %~% لحما ، فقد أطعمت لحما ، وقد فجعا (@)(@@) 32 فظل يأكل منها وهي راتعة %~% حد النهار تراعي ثيرة رتعا (@)(@@) 33 حتى إذا فيقة في ضرعها اجتمعت %~% جاءت لترضع شق النفس لو رضعا (@)(@@) 34 عجلا إلى المعهد الأدنى ففاجأها %~% أقطاع مسك وسافت من دم دفعا (@)(@@) 35 فانصرفت فاقدا ثكلى على حزن ، %~% كل دهاها وكل عندها اجتمعا (@)(@@) 36 وذاك أن غفلت عنه وما شعرت %~% أن المنية يوما أرسلت سبعا (@)(@@) 37 حتى إذا ذر قرن الشمس صبحها %~% ذؤال نبهان يبغي صحبه المتعا (@)(@@) 38 بأكلب كسراع النيل ضاربة ، %~% ترى من القد في أعناقها قطعا (@)(@@) 39 فتلك لم تترك من خلفها شبها %~% إلا الدوابر والأظلاف والزمعا (@)(@@) 40 أنضيتها بعدما طال الهباب بها ، %~% تؤم هوذة لا نكسا ولا ورعا (@)PageV01P117 (@)(@@) 41 يا هوذ إنك من قوم ذوي حسب ، %~% لا يفشلون إذا ما آنسوا فزعا (@)(@@) 42 هم الخضارم إن غابوا وإن شهدوا ، %~% ولا يرون إلى جاراتهم خنعا (@)(@@) 43 قوم بيوتهم أمن لجارهم ، %~% يوما إذا ضمت المحضورة الفزعا (@)(@@) 44 وهم إذا الحرب أبدت عن نواجذها %~% مثل الليوث وسم عاتق نفعا (@)(@@) 45 غيث الأرامل والأيتام كلهم ، %~% لم تطلع الشمس إلا ضر أو نفعا (@)(@@) 46 يا هوذ يا خير من يمشي على قدم ، %~% إذا تعصب فوق التاج أو وضعا (@)(@@) 47 له أكاليل بالياقوت زينها %~% صواغها لا ترى عيبا ، ولا طبعا (@)(@@) 48 وكل زوج من الديباج يلبسه %~% أبو قدامة محبوا بذاك معا (@)(@@) 49 لم ينقض الشيب منه ما يقال له ، %~% وقد تجاوز عنه الجهل فانقشعا (@)(@@) 50 أغر أبلج يستسقى الغمام به ، %~% لو صارع الناس عن أحلامهم صرعا (@)PageV01P118 (@)(@@) 51 قد حملوه فتي السن ما حملت 
ms34	 %~% ساداتهم فأطاق الحمل واضطلعا (@)(@@) 52 وجربوه فما زادت تجاربهم %~% أبا قدامة ، إلا الحزم والفنعا (@)(@@) 53 من ير هوذة أو يحلل بساحته ، %~% يكن لهوذة فيما نابه تبعا (@)(@@) 54 تلقى له سادة الأقوام تابعة ، %~% كل سيرضى بأن يرعى له تبعا (@)(@@) 55 بحر المواهب للوراد والشرعا %~% (@)(@@) 56 يرعى إلى قول سادات الرجال إذا %~% أبدوا له الحزم أو ما شاءه ابتدعا (@)(@@) 57 وما مجاور هيت إن عرضت له %~% قد كان يسمو إلى الجرفين واطلعا (@)(@@) 58 يجيش طوفانه إذ عب محتفلا %~% يكاد يعلو ربى الجرفين مطلعا (@)(@@) 59 طابت له الريح ، فامتدت غواربه ، %~% (@)(@@) 60 يوما بأجود منه حين تسأله ، %~% إذ ضنذ والمال بالإعطاء أو خدعا (@)PageV01P119 (@)(@@) 61 سائل تميما به أيام صفقتهم ، %~% لما أتوه أسارى كلهم ضرعا (@)(@@) 62 وسط المشقر في عيطاء مظلمة ، %~% لا يستطيعون فيها ثم ممتنعا (@)(@@) 63 لو أطعموا المن والسلوى مكانهم ، %~% ما أبصر الناس طعما فيهم نجعا (@)(@@) 64 بظلمهم ، بنطاع الملك ضاحية ، %~% فقد حسوا بعد من أنفاسهم جرعا (@)(@@) 65 أصابهم من عقاب الملك طائفة ، %~% كل تميم بما في نفسه جدعا (@)(@@) 66 فقال للملك : سرح منهم مائة ، %~% رسلا من القول مخفوضا وما رفعا (@)(@@) 67 ففك عن مائة منهم وثاقهم ، %~% فأصبحوا كلهم من غلة خلعا (@)(@@) 68 بهم تقرب يوم الفصيح ضاحية ، %~% يرجو الإله بما سدى وما صنعا (@)(@@) 69 وما أراد بها نعمى يثاب بها ، %~% إن قال كلمة معروف بها نفعا (@)(@@) 70 فلا يرون بذاكم نعمة سبقت ، %~% إن قال قائلها حقا بها وسعى (@)PageV01P120 (@)(@@) 71 لا يرقع الناس ما أوهى وإن جهدوا %~% طول الحياة ، ولا يوهون ما رقعا (@)(@@) 72 لما يرد من جميع بعد فرقه ، %~% وما يرد بعد من ذي فرقة جمعا (@)(@@) 73 قد نال أهل شبام فضل سؤدده %~% إلى المدائن خاض الموت وادرعا (@)PageV01P121(@)(@@) البحر : بسيط تام (@)(@@) 1 كانت وصاة وحاجات لنا كفف ، %~% لو أن صحبك إذ ناديتهم وقفوا (@)(@@) 2 على هريرة إذ قامت تودعنا ، %~% وقد أتى من إطار دونها شرف (@)(@@) 3 أحببت بها خلة لو أنها وقفت ، %~% وقد تزيل الحبيب النية القذف (@)(@@) 4 إن الأعز أبانا كان 
ms35	 قال لنا : %~% أوصيكم بثلاث ، إنني تلف (@)(@@) 5 الضيف أوصيكم بالضيف ، إن له %~% حقا علي ، فأعطيه وأعترف (@)(@@) 6 والجار أوصيكم بالجار ، إن له %~% يوما من الدهر يثنيه ، فينصرف (@)(@@) 7 وقاتلوا القوم ، إن القتل مكرمة ، %~% إذا تلوى بكف المعصم العوف (@)(@@) 8 إن الرباب ، وحيا من بني أسد ، %~% منهم بقير ومنهم سارب سلف (@)(@@) 9 قد صادفوا عصبة منا ، وسيدنا ، %~% كل يؤمل قنيانا ، ويطرف (@)(@@) 10 قلنا الصلاح فقالوا لا نصالحكم ، %~% أهل النبوك وعير فوقها الخصف (@)PageV01P122 (@)(@@) 11 لسنا بعير ، وبيت الله ، مائرة ، %~% إلا عليها دروع القوم ، والزغف (@)(@@) 12 لما التقينا كشفنا عن جماجمنا %~% ليعلموا أننا بكر ، فينصرفوا (@)(@@) 13 قالوا البقية ، والهندي يحصدهم ، %~% ولا بقية إلا النار ، فانكشفوا (@)(@@) 14 هل سر حنقط أن القوم صالحهم %~% أبو شريح ولم يوجد له خلف (@)(@@) 15 قد آب جارتها الحسناء قيمها %~% ركضا ، وآب إليها الثكل والتلف (@)(@@) 16 وجند كسرى غداة الحنو صبحهم %~% منا كتائب تزجي الموت فانصرفوا (@)(@@) 17 جحاجح ، وبنو ملك غطارفة %~% من الأعاجم ، في آذانها النطف (@)(@@) 18 إذا أمالوا إلى النشاب أيديهم ، %~% ملنا ببيض ، فظل الهام يختطف (@)(@@) 19 وخيل بكر فما تنفك تطحنهم %~% حتى تولوا ، وكاد اليوم ينتصف (@)(@@) 20 لو أن كل معد كان شاركنا %~% في يوم ذي قار ما أخطاهم الشرف (@)PageV01P123 (@)(@@) 21 لما أتونا ، كأن الليل يقدمهم ، %~% مطبق الأرض يغشاها بهم سدف (@)(@@) 22 وظعننا خلفنا كحلا مدامعها ، %~% أكبادها وجف ، مما ترى تجف (@)(@@) 23 حواسر عن خدود عاينت عبرا ، %~% ولا حها وعلاها غبرة كسف (@)(@@) 24 من كل مرجانة في البحر أخرجها %~% غواصها ووقاها طينها الصدف (@)PageV01P124(@)(@@) البحر : خفيف تام (@)(@@) 1 أذن اليوم جيرتي بحفوف ، %~% صرموا حبل آلف مألوف (@)(@@) 2 واستقلت على الجمال حدوج ، %~% كلها فوق بازل موقوف (@)(@@) 3 من كرات ، وطرفهن سجو ، %~% نظر الأدام من ظباء الخريف (@)(@@) 4 خاشعات يظهرن أكسية الخ %~% ز ، ويبطن دونها بشفوف (@)(@@) 5 وحثثن الجمال يسكهن بالبا %~% غز ، والأرجوان خمل القطيف (@)(@@) 6 من هواهن يتبعن نواه %~% ن ، فقلي بهن كالمشغوف (@)(@@) 7 بلعوب مع الضجيع ، إذا ما %~% سهرت بالعشاء ، غير أسوف (@)(@@) 8 ولقد أحزم اللبانة أهلي ، %~% ت 
ms36	 لا جهمة ولا علفوف (@)(@@) 9 ولقد ساءها البياض ، فلطت %~% بحجاب من دوننا مسدوف (@)(@@) 10 فاعرفي للمشيب ، إذ شمل الرأ %~% س ، فإن الشباب غير حليف (@)PageV01P125 (@)(@@) 11 ودع الذكر من عشائي ، فما يد %~% ريك ما قوتي وما تصريفي (@)(@@) 12 وصحبنا من آل جفنة أملا %~% كا كراما بالشام ذات الرفيف (@)(@@) 13 وبني المنذر الأشاهب بالحي %~% رة ، يمشون ، غدوة ، كالسيوف (@)(@@) 14 وجلنداء في عمان مقيما ، %~% ثم قيسا في حضرموت المنيف (@)(@@) 15 قاعدا حوله الندامى ، فما ين %~% فك يؤتى بموكر مجدوف (@)(@@) 16 وصدوح ، إذا يهيجها الشر %~% ب ، ترقت في مزهر مندوف (@)(@@) 17 بينما المرء كالرديني ذي الجب %~% ة سواه مصلح التثقيف (@)(@@) 18 أو إناء النضار لاحمه القي %~% ن ، ودارى صدوعه بالكتيف (@)(@@) 19 رده دهره المضلل حتى %~% عاد من بعد مشيه للدليف (@)(@@) 20 وعسير من النواعج أدما %~% ء مروح ، بعد الكلال ، رجوف PageV01P126(@)(@@) 21 قد تعللتها ، على نكظ المي %~% ط ، فتأتي على المكان المخوف (@)(@@) 22 ولقد أحزم اللبابة أهلي ، %~% وأعديهم لأمر قذيف (@)(@@) 23 بشجاع الجنان ، يحتفر الظل %~% ماء ، ماض على البلاد خشوف (@)(@@) 24 مستقل باردف ما يجعل الج %~% رة بعد الإدلاج غير الصريف (@)(@@) 25 ثم يضحي من فوره ذا هباب %~% يستطير الحصى بخف كثيف (@)(@@) 26 إن وضعنا عنه ببيداء قفر ، %~% أو قرنا ذراعه بوظيف (@)(@@) 27 لم أخل أن ذاك يردع منه ، %~% دون ثني الزمام تحت الصليف PageV01P127(@)(@@) البحر : طويل (@)(@@) 1 أرقت وخما هذا السهاد المؤرق ، %~% وما بي من سقم وما بي معشق (@)(@@) 2 ولكن أراني لا أزال بحادث ، %~% أغادى بمات لم يمس عندي وأطرق (@)(@@) 3 فإن يمس عندي الشيب والهم والعشى %~% فقد بن مني ، والسلام تفلق (@)(@@) 4 بأشجع أخاذ على الدهر حكمه ، %~% فمن أي ما تجني الحوادث أفرق (@)(@@) 5 فما أنت إن دامت عليك بخالد %~% كما لم يخلد قبل ساسا ومورق (@)(@@) 6 وكسرى شهنشاه الذي سار ملكه %~% له ما اشتهى راح عتيق وزنبق (@)(@@) 7 ولا عاديا لم يمنع الموت ماله ، %~% ورد بتيماء اليهودي أبلق (@)(@@) 8 بناه سليمان بن داود حقبة ، %~% له أزج عال وطي موثق (@)(@@) 9 يوازي كبيداء 
ms37	 السماء ودونه %~% بلاط ودارات وكلس وخندق (@)(@@) 10 له درمك في رأسه ، ومشارب ، %~% ومسك وريحان وراح تصفق PageV01P128 (@)(@@) 11 وحور كأمثال الدمى ، ومناصف ، %~% وقدر وطباخ ، وصاع وديسق (@)(@@) 12 فذاك ولم يعجز من الموت ربه ، %~% ولكن أتاه الموت لا يتأبق (@)(@@) 13 ولا الملك النعمان يوم لقيته %~% بإمته يعطي القطوط ويأفق (@)(@@) 14 ويجبى إليه السيلحون ، ودونها %~% صريفون في أنهارها والخورنق (@)(@@) 15 ويقسم أمر الناس يوما وليلة ، %~% وهم ساكتون ، والمنية تنطق (@)(@@) 16 ويأمر لليحموم كل عشية %~% بقت ، وتعليق ، وقد كاد يسنق (@)(@@) 17 يعالى عليه الجل كل عشية ، %~% ويرفع نقلا بالضحى ويعرق (@)(@@) 18 فذاك ، وما أنجى من الموت ربه %~% بساباط ، حتى مات وهو محزرق (@)(@@) 19 وقد أقطع اليوم الطويل بفتية %~% مساميح ، تسقى ، والخباء مروق (@)(@@) 20 ورادعة بالمسك صفراء عندنا %~% لجس الندامى في يد الدرع مفتق PageV01P129 (@)(@@) 21 إذا قلت غني الشرب قامت بمزهر %~% يكاد إذا درات له الكف ينطق (@)(@@) 22 وشاو إذا شئنا كميش بمسعر ، %~% وصهباء مزباد ، إذا ما تصفق (@)(@@) 23 تريك القذى من دونها وهي دونه ، %~% إذا ذاقها من ذاقها يتمطق (@)(@@) 24 وظلت شعيب غربة الماء عندنا ، %~% وأسحم مملوء من الراح متأق (@)(@@) 25 وخرق مخوف قد قطعت بجسرة ، %~% إذا خب آل فوقه يترقرق (@)(@@) 26 هي الصحب الأدنى وبيني وبينها %~% مجوف علافي ، وقطع ونمرق (@)(@@) 27 وتصبح من غب السرى ، وكأنما %~% ألم بها من طائف الجن أولق (@)(@@) 28 من الجاهل العريض يهدي لي الخنا ، %~% وذلك مما يبتريني ويعرق (@)(@@) 29 فما أنا عما تعملون بجاهل ، %~% ولا بشباة جهله يتدفق (@)(@@) 30 نهار شراحيل بن طود يريبني ، %~% وليل أبي ليلى أمر وأعلق PageV01P130(@)(@@) 31 وما كنت شاحردا ولكن حسبتني %~% إذا مسحل سدى لي القول أنطق (@)(@@) 32 شريكان فيما بيننا من هوادة ، %~% صفيان جني ، وإنس موفق (@)(@@) 33 يقول ، فلا أعيا لشيء أقوله ، %~% كفاني لا عي ، ولا هو أخرق (@)(@@) 34 جماع الهوى في الرشد أدنى إلى التقى ، %~% وترك الهوى في الغي أنجى وأوفق (@)(@@) 35 إذا حاجة ولتك لا تستطيعها ، %~% فخذ طرفا من غيرها حين تسبق (@)(@@) 36 فذلك أدنى أن تنال جسيمها ، %~% وللقصد أبقى في 
ms38	 المسير وألحق (@)(@@) 37 أتزعم للأكفاء ما أنت أهله ، %~% وتختال إذ جار ابن عمك مرهق (@)(@@) 38 وأحمدت أن ألحقت بالأمس صرمة %~% لها غدرات ، واللواحق تلحق (@)(@@) 39 فيفجعن ذا المال الكثير بماله ، %~% وطورا يقنين الضريك ، فيلحق (@)(@@) 40 أبا مسمع سار الذي قد صنعتم ، %~% فأنجد أقوام بذاك وأعرقوا (@)PageV01P131 (@)(@@) 41 وإن عتاق العيس سوف يزوركم %~% ثناء ، على أعجازهن ، معلق (@)(@@) 42 به تنفض الأحلاس في كل منزل ، %~% وتعقد أطراف الحبال ، وتطلق (@)(@@) 43 نهيتكم عن جهلكم ونصرتكم %~% على ظلمكم ، والحازم الرأي أشفق (@)(@@) 44 وأنذرتكم قوما لكم تظلمونهم %~% كراما فإن لا ينفد العيش تلتقوا (@)(@@) 45 وكم دون ليلى من عدو وبلدة %~% وسهب به مستوضح الآل يبرق (@)(@@) 46 وأصفر كالحناء طام جمامه ، %~% إذا ذاقه مستعذب الماء يبصق (@)(@@) 47 وإن امرأ أسرى إليك ، ودونه %~% فياف تنوفات ، وبيداء خيفق (@)(@@) 48 لمحقوقة أن تستجيبي لصوته ، %~% وأن تعلمي أن المعان موفق (@)(@@) 49 ولا بد من جار يجيز سبيلها ، %~% كما جوز السكي في الباب فيتق (@)(@@) 50 لعمري ، لقد لاحت عيون كثيرة %~% إلى ضوء نار في يفاع تحرق PageV01P132(@)(@@) 51 تشب لمقرورين يصطليانها ، %~% وبات على النار الندى والمحلق (@)(@@) 52 رضيعي لبان ثدي أم تحالفا ، %~% بأسحم داج عوض لا نتفرق (@)(@@) 53 يداك يدا صدق فكف مفيدة ، %~% وأخرى ، إذا ما ضن بالزاد ، تنفق (@)(@@) 54 ترى الجود يجري ظاهرا فوق وجهه %~% كما زان متن الهندواني رونق (@)(@@) 55 وأما إذا ما أوب المحل سرحهم ، %~% ولاح لهم من العشيات سملق (@)(@@) 56 نفى الذم عن آل المحلق جفنة %~% كجابية الشيخ العراقي تفهق (@)(@@) 57 يروح فتى صدق ، ويغدو عليهم %~% بملء جفان من سديف يدفق (@)(@@) 58 وعاد فتى صدق عليهم بجفنة %~% وسوداء لأيا بالمزادة تمرق (@)(@@) 59 ترى القوم فيها شارعين ودونهم %~% من القوم ولدان من النسل دردق (@)(@@) 60 طويل اليدين ، رهطه غير ثنية ، %~% أشم كريم جاره لا يرهق PageV01P133(@)(@@) 61 كذلك فافعل ما حييت إليهم ، %~% وأقدم إذا ما أعين الناس تبرق (@)PageV01P134(@)(@@) البحر : طويل (@)(@@) 1 يا جارتي بيني ، فإنك طالقه %~% كذلك أمور الناس غاد وطارقه (@)(@@) 2 وبيني ، فإن البين من العصا %~% وإلا تزال فوق رأسك 
ms39	 بارقه (@)(@@) 3 وما ذاك من جرم عظيم جنيته %~% ولا أن تكوني جئت فينا ببائقه (@)(@@) 4 وبيني حصان الفرج غير ذميمة %~% وموموقة فينا ، كذاك ووامقه (@)(@@) 5 وذوقي فتى قوم ، فإني ذائق %~% فتاة أناس مثل ما أنت ذائقه (@)(@@) 6 فقد كان في شبان قومك منكح %~% وفتيان هزان الطوال الغرانقه (@)PageV01P135(@)(@@) البحر : طويل (@)(@@) 1 أتاني وعون الحوش بيني وبينكم %~% كوانس من جنبي فتاق فأبلقا (@)(@@) 2 تأنيكم أحلام من ليس عنده %~% على الرهط مغنى لو تنالون موثقا (@)(@@) 3 بنية إن القوم كان جريرهم %~% برأسي ، لو لم يجعلوه معلقا (@)(@@) 4 أفي فتية بيض الوجوه ، إذا لقوا %~% قبيلك يوما أبلغوه المخنقا (@)(@@) 5 إذا اعتفرات أقدامهم عند معرك %~% جزاء المسيء حيث أمسى وأشرقا (@)(@@) 6 جزى الله تيما من أخ كان يتقي %~% محارم تيم ما أخف وأرهقا (@)(@@) 7 أخونا لاذي يعدو علينا ولو هوت %~% به قدم كنا به متعلقا (@)(@@) 8 أتينا لهم إذ لم نجد غير أنيهم %~% وكنا صفائحا من الموت أزرقا (@)(@@) 9 وجدنا إلى أرماحنا حين عولت %~% علينا بنو رهم من الشر ملزقا (@)PageV01P136(@)(@@) البحر : بسيط تام (@)(@@) 1 نام الخلي ، وبت الليل مرتفقا ، %~% أرعى النجوم عميدا مثبتا أرقا (@)(@@) 2 أسهو لهمي ودوائي ، فهي تسهرني ، %~% وكان حب ووجد دام ، فاتفقا (@)(@@) 3 لاشيء ينفعني من دون رؤيتها ، %~% هل يشتفي وامق مالم يصب رهقا (@)(@@) 4 صادت فؤادي بعيني مغزل خذلت ، %~% ترعى أغن غضيضا طرفه خرقا (@)(@@) 5 وبارد رتل ، عذب مذاقته ، %~% كأنما عل بالكافور ، واغتبقا (@)(@@) 6 وجيد أدماء لم تذعر فرئصها ، %~% ترعى الأراك تعاطى المرد والورقا (@)(@@) 7 وكفل كالنقا ، مالت جوانبه ، %~% ليست من الزل أوراكا وما انتطقا (@)(@@) 8 كأنها درة زهراء ، أخرجها %~% غواص دارين يخشى دونها الغرقا (@)(@@) 9 قد رامها حججا ، مذ طر شاربه ، %~% حتى تسعسع يرجوها وقد خفقا (@)(@@) 10 لا النفس توئسيه منها فيتركها ، %~% وقد رأى الرعب رأي العين فاحترقا (@)PageV01P137 (@)(@@) 11 ومارد من غواة الجن يحرسها ، %~% ذو نيقة مستعد دونها ، ترقا (@)(@@) 12 ليست له غفلة عنها يطيف بها ، %~% يخشى عليها سرى السارين والسرقا (@)(@@) 13 حرصا عليها لو أن النفس طاوعها %~% منه الضمير 
ms40	 ليالي اليم ، أو غرقا (@)(@@) 14 في حوم لجة آذي له حدب ، %~% من رامها فارقته النفس فاعتلقا (@)(@@) 15 من نالها نال خلدا لا انقطاع له ، %~% وما تمنى ، فأضحى ناعما أنقا (@)(@@) 16 تلك التي كلفتك النفس تأملها ، %~% وما تعلقت إلا الحين والحرقا (@)PageV01P138(@)(@@) البحر : خفيف تام (@)(@@) 1 يوم قفت حمولهم ، فتولوا ، %~% قطعوا معهد الخليط فشارقوا (@)(@@) 2 جاعلات جوز اليمامة بالأش %~% مل سيرا يحثهن انطلاق (@)(@@) 3 جازعات بطن العتيق كما تم %~% ضي رقاق أمامهن رقاق (@)(@@) 4 بعد قرب من دارهم وائتلاف %~% صرموا حبلك الغداة وساقوا (@)(@@) 5 يوم أبدت لنا قبيلة عن جي %~% د تليع ، تزينه الأطواق (@)(@@) 6 وشتيت كالأقحوان جلاه ال %~% طل فيه عذوبة واتساق (@)(@@) 7 وأثيث جثل النبات تروي %~% ه لعوب غريرة مفناق (@)(@@) 8 حرة طفلة الأنامل كالدم %~% ية لا عانس ولا مهزاق (@)(@@) 9 كخذول ترعى النواصف من تث %~% ليث قفرا ، خلا لها الأسلاق (@)(@@) 10 تنقص المرد والكباث بحملا %~% ج لطيف ، في جانبيه انفراق PageV01P139(@)(@@) 11 في أراك مرد ، يكاد إذا ما %~% ذرت الشمس ساعة ، يهراق (@)(@@) 12 وهي تتلو رخص العظام ضئيلا ، %~% فاتر الطرف في قواه انسراق (@)(@@) 13 ما تعادى عنه ، النهار ، ولا تع %~% جوه إلا عفافة أو فواق (@)(@@) 14 مشفقا عليه ، فما تع %~% دوه قد شف جسمها الإشفاق (@)(@@) 15 وإذا خافت السباع من الغي %~% ل وأمست وحان منها انطلاق (@)(@@) 16 روحته جيداء ذاهبة المر %~% تع لا خبة ولا مملاق (@)(@@) 17 فاصبري النفس ، إن ما حم حق ، %~% ليس للصدع في الزجاج اتفاق (@)(@@) 18 وفلاة كأنها ظهر ترس ، %~% ليس إلا الرجيع فيها علاق (@)(@@) 19 قد تجاوزتها وتحتى مروح ، %~% عنتريس ، نعابة ، معناق (@)(@@) 20 عرمس ترجم الإكام بأخفا %~% ف صلاب منها الحصى أفلاق PageV01P140 (@)(@@) 21 ولقد أقطع الخليل ، إذا لم %~% أرج وصلا ، إن الإخاء الصداق (@)(@@) 22 بكميت عرفاء مجمرة الخ %~% ف ، غذتها عوانة وفتاق (@)(@@) 23 ذات غرب ترمي المقدم بالرد %~% ف إذا ما تدافع الأرواق (@)(@@) 24 في مقيل الكناس ، إذ وقد اليو %~% م ، إذا الظل أحرزته الساق (@)(@@) 25 وكأن القتود والعجلة وال %~% وفر لما تلاحق السواق (@)(@@) 26 فوق 