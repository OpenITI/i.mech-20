ms1442	 چوب ار چه نامشان عود است(@)(@@) (@@) بر اشتراک صفت، ذات مشترک نشود %~% خدای باشد موجود و بنده موجود است(@)(@@) (@@) د حبذا گوهری چو قطرهآ آب %~% قطرهآ آب پر ز در خوشاب(@)(@@) چون محاسب ز جمعها گه حرب %~% بی عدد فرد و زوج کرده به ضرب(@)(@@) عددش پنج لیک در تضیف %~% کسر نبود در وجود ز ضعیف(@)(@@) تا بود بر کشیده مردان %~% می رود در قفای خصم زنان(@)(@@) هر کرا زخمها زند زان پس %~% قلیه ای کند ناخورد کرکس(@)(@@) روز عمر از صدش رسیده به شام %~% زین سبب عزب شد حدس را نام(@)(@@) زان سبب برگ بید خوانندش %~% که نژاد از خلاف دادنش(@)(@@) صف زنیم بر درد ولی یک مرد %~% دستگیرش کند به روز نبرد(@)(@@) (@@) - صدرا به روزگار تو هر روز1 عید باد %~% عید از میامن تو چو روزه سعید باد(@)(@@) (@@) زین خرقهآ کبود قدیمی روزگار %~% مانند صوفیانت به هر دم دو عید باد(@)(@@) (@@) تا دایرست چرخ فلک بر بسیط خاک %~% چون روزگار مدت عمرت مدید باد(@)(@@) (@@) - در سر و در علانیه، در شدت و رخا %~% پیوسته بودمت ز دل پاک دوستدار(@)(@@) (@@) واکنون که دیده دیده جمال مبارکت %~% آن دوستیت در دل من شد یکی هزار(@)(@@) (@@) - قصه چه کنم که اشتیاق تو چه کرد %~% با من دل پر زرق نفاق تو چه کرد(@)(@@) (@@) چون زلف دراز تو شبی میباید %~% تا با تو بگویم که فراق تو چه کرد(@)(@@) (@@) - در دور جام عدل تو جوری بود عظیم %~% گر بعد ازین شراب کند مست را خراب(@)(@@) (@@) از بس که لطف همچو گلت بوی میدهد %~% نشکفت اگر زکام بود علت سحاب(@)(@@) (@@) ز مهر بوسهآ پای مبارکش خواهد %~% هلال چرخ که خود را هلال گرداند(@)(@@) (@@) ولی چه سود که ذاتش چنان بلند افتاد %~% که هیچ کوکبی آنجا رسید، نتواند(@)(@@) (@@) - دل روی تو را چو روز روشن داند %~% هرست بلا روی تو را میخواند(@)(@@) (@@) بالای تو همچو سرو میبالد راست %~% حشم تو به عینه هر کس 
ms1443	 ماند PageV03P1681(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0339.jpg)(@)(@)(@@) (@@) و در این فصل میمون و وقت مبارک %~% که دهر خرف شد ز سر باز کودک(@)(@@) به فر بنفشه چمن روز به شد %~% زهی هندویی نیکبخت مبارک(@)(@@) (@@) غلام گلم زانکه خاتون رز را %~% به کار اندر آرد بسان کنیزک(@)(@@) (@@) دکدام جان که جهانش نخورد خون جگر %~% به جان تو که بدو جان خویش نسپاری(@)(@@) (@@) شود به خون عزیزان بنان تو رنگین %~% اگر به دست خود این خاک را بیفشاری(@)(@@) (@@) هر آنچه خورد زمین گر به آب باز دهد %~% ز خون عقیق شود چشمههای کهساری(@)(@@) (@@) کمال جان به علوماست و قدر تن به فعال %~% چه بهتر است ز دانایی و نکوکاری(@)(@@) (@@) سرای خلد ز بهر تو در گشاده و، تو %~% به بند مانده میان چهار دیواری(@)(@@) (@@) اگر به چشم بصیرت به کار خود نگری %~% سزد که مردم دیده به خون بیاغازی(@)(@@) (@@) چگونه از تن مسکین چگونه لذتهاست %~% نهان ز تو، که تو آنها همه غم انگاری(@)(@@) (@@) - چنانم از غم این آشنای بی حاصل %~% که خون دیدهآ من آسیا بگرداند(@)(@@) (@@) رخ نشاط من از چرخ پر نشاط شدهاست %~% ز بس که بر سر من خاک خواری افشاند(@)(@@) (@@) - کار تو لطف و تربیت آمد و گرنه من %~% خود دانم این قدر که نیایم به هیچ کار(@)(@@) (@@) لیکن اگر چه باشد کافور بس عزیز %~% از جو گزیر نبود اگر چندی است خوار(@)(@@) (@@) - بیاض صبح اسلام است یا رخسار3 انوارش %~% سواد لشکر کفر است یا زلف زرهوارش(@)(@@) (@@) ز گلبن گل بر آمد تشنهآ آن چشمهآ نوشین %~% به بستان نرگس آمد مردهآ آن چشم بیمارش(@)(@@) (@@) شود چون غنچه در پرده گل و لاله ز شرم او %~% [اگر روزی چو گل پرده براندازد ز رخسارش(@)(@@) (@@) شود طاووس سدره خوشه چین گفته قمری]4 %~% اگر طوطی جان من5 شکر چیند ز منقارش(@)(@@) (@@) دهان نقطه کردارش چو مرکز زان پدید آمد %~% که گرد مه پدید آمد خطی چون خط پرگارش(@)(@@) (@@) چو بر سوز دل من گرم شد 
ms1444	 بازار عشق او %~% دکان گوهر آگین شد دو چشم من به بازارش(@)(@@) (@@) درین بازار عشق الآ فریب وعشوه نفروشند %~% خرم آری از او، گشتهام زین سان خریدارش PageV03P1682(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0340.jpg)(@)(@)(@@) ~~عرصهآ سینیه /غرفهآ متوسطین(@)(@@) (@@) به جانی هم توانستی خریدن بوسهای زان لب %~% گر این خسته دل بی جان نبودی کشته زارش(@)(@@) (@@) رخ او در در افشانی اگر نه آفتابستی %~% نیارستی نمودن هم دهان ذره مقدارش(@)(@@) (@@) نمی دارد نگه دلهای ما یا رب نمیدانم %~% که از بهر چه معنی بیدلان خوانند دلدارش(@)(@@) (@@) ندیدم چون دهان شکرینش در جهان تنگی %~% که چون بگشایدش خنده، شکر ریزد به خروارش(@)(@@) ~~دلا چون از دهان تنگ او کامی نمییابی - ز نامیه است کنون حال شاخها(@)(@@) با برگ %~% ز بلبل است کنون کار باغها به نوا %~% چو بدخواه خداوندم ز دنیا1 نیست انکارش(@)(@@) (@@) ز بس که باد هوای گل است در سر او %~% هزار دستان گوید سخن ز باد هوا308a(@)(@@) (@@) اگر چه لاله به سان جگر همه خون است %~% دلش به سان شرر آمدهاست بر سودا(@)(@@) (@@) - عمود صبح تو گفتی که دست موسی دهر %~% برای ضربت فرعون شب عصا برداشت(@)(@@) (@@) سیاه زنگ شکسته به سوی مغرب شد %~% چو شاه روز به مشرق عمود را برداشت(@)(@@) (@@) - گم شد شب شبابم2 در صبحگاه پیری %~% تا روز شد شب من، روزم شب است یلدا(@)(@@) (@@) بر تابهام چو ماهی زین عمر شصت ساله %~% خسته است حلق جانم زین شصت، ماهی آسا(@)(@@) (@@) مانا که روز پیری با مردن است یکسان %~% کایام در حنوطم کافور کرد عمدا(@)(@@) (@@) زر کشیده شخصم سیم کشیده مویم %~% شعری است سیم در زر کایام کرد انشا(@)(@@) (@@) - بی آنکه حدیث سرد بشنید از من %~% بد خدمتی و خیانتی دید از من(@)(@@) کلی دهن دوات بست از سخنم %~% یکباره زبان کلک ببرید از من(@)(@@) (@@) - دو هفته دگر امرد شوم که ریش سپید3 %~% اگر چه بیش برآرد زمانه، بیش کنم(@)(@@) (@@) زهی عقوبت پیری که راضیم کردهاست %~% که ریش و سبلت خود 
ms1445	 را به دست خویش کنم(@)(@@) ~~- راهی دراز و تیره چو گیسوی آن پسر در وی چو اژدها کمری بر میان کوه(@)(@@) %~% وز نسج4 عنکبوت خطی بر دهان غار %~% لیک از شکستگی چو سر زلف آن نگار(@)(@@) (@@) آبش حمیم و غار ز ژرفی چو هاویه %~% اشجار او درخت زقوم و هواش نار(@)(@@) (@@) گردون چو خای و خاک چو گردون همی نمود %~% از پستی و بلندی آن غار و کوهسار PageV03P1683(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0341.jpg)(@)(@)(@@) ~~صحرای او فراخ تر از عرصهآ امیدفرسنگ او درازتر از راه1 انتظار(@)(@@) (@@) - قلم در دست او مرغی است زراندوده تن لیکن %~% به سیم آکنده شد سینه به مشک آلوده منقارش(@)(@@) (@@) سر و ریشش تراشند و سیه رویش کنند آری %~% چو دیدندش که صحبت بود با ابکار افکارش(@)(@@) (@@) اگر اندر سفر کردن بود صحت مسافر را %~% چرا رخ زرد می بینم چو ملعونان در اسفارش(@)(@@) (@@) ندیدی کز زبان مار زاید مور، رو بنگر %~% سر همچون زبان مار و خط مور کردارش(@)(@@) (@@) چو از خلوت برون آید ریاضت کرده یک چندی %~% شود در خانقاه غیب حاصل کشف اسرارش(@)(@@) - در دو عالم همی نگنجی از آنک %~% تو بزرگی و هر دو عالم تنگ(@)(@@) گر نیایم به مجلس تو همی %~% از سر عجز دان نه از سر ننگ(@)(@@) کز پی عجز دیدگان خفاش %~% نکند سوی آفتاب درنگ(@)(@@)(@@)(@@) | [سراج](@)(@@) ~~عرفه، از متو شطین چندین سراج تخلص بودهاند، از جمله صاحب این ابیات که به غایت(@)(@@) ~~صوفی وارع و زاهد است:(@)(@@) (@@) - وعدهآ خلاف ای صنم چند کنی، بس کند %~% بر دل و جانم ستم چند کنی، بس کند(@)(@@) (@@) - خوشا دردی که درمانش بود یار %~% خوشا جانی3 که جانانش بود یار(@)(@@) (@@) خوش آن حاجت که از دلبر بر آید %~% خوش آن حجت که برهانش بود یار(@)(@@) (@@) سراج خسته ترک راهها گوی %~% به جز راهی که پایانش بود یار(@)(@@) (@@) خوش آن زخمی که درمان باشدش وی %~% خوش آن گشته که تاوانش بود یار(@)(@@) (@@) خوشا تیری که از شستش 
ms1446	 گشاید %~% خوشا گویی که چوگانش بود یار PageV03P1684(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0342.jpg)(@)(@)(@@) ~~مرصه شینیه غرفه متوسطین(@)(@@)(@@)(@@) | 1310)(@)(@@)(@@)(@@) | [مولانا سروی بیرجندی](@)(@@) ~~عرفه؛ در مجالس النفایس مذکور است که مولانا سروی ولد حافظ علی بیرجندی است،(@)(@@) ~~عدم به عرصهآ ظهور آمده باشد، یا چنان سروی بر لب جویبار بقا در نشو و نما شده، در(@)(@@) ~~شعر خوشگوی بوده. او راست:(@)(@@) کاشکی دامن کشان آید قد رعنای او %~% تا نبیند دیدهآ غیری نشان پای او(@)(@@)(@@)(@@) | 1311)(@)(@@)(@@)(@@) | [مولانا سری](@)(@@) ~~عرفه: هم در مجالس النفایس امیر علیشیر مذکور است که مولانا سری ولد مولانا علی(@)(@@) ~~شهاب است. جوانی ابدال صفت، درویش طبیعت بوده. او راست:(@)(@@) (@@) بوده در دعوی به ابرویت مه نو تیز و تند %~% دید چون خورشید رویت ساخت خود کرد وغند(@)(@@)(@@)(@@) | 1(@)(@@)(@@)(@@) | مولانا سرودی خراسانی](@)(@@) ~~عرفهآ نغمهآ زبور خوش بیانی، سرود مجلس هم زبانی، مولانا سرودی خراسانی. ساز(@)(@@) ~~طبیعتش سیر آهنگ و نغمات سرود فطرتش با هوش و هنگ بوده. گویند تتبع موسیقی(@)(@@) ~~بسیار کرده، ضرب و نطقش مساوی شده. تصنیفات مشکله نوشته از وی بر السنه و افواه(@)(@@) ~~گویندگان است. به غایت عیاش رند میکش لوند بوده، و با مولانا هلالی مخصوص و(@)(@@) ~~معاصر است، و او راست: PageV03P1685(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0343.jpg)(@)(@)(@@) (@@) گه بریزد باده و گه بشکند پیمانه را %~% در شکست و ریخت دارد محتسب میخانه را(@)(@@) (@@) آشنایان را ز خود بیگانه خواهی ساختن %~% گر بدینسان آشنای خود کنی بیگانه را 308b(@)(@@) (@@) از سرودی گر شود او را ملالی دور نیست %~% زانکه کلفت باشد از دیوانگان فرزانه را(@)(@@)(@@)(@@) | 1313(@)(@@)(@@)(@@) | [میر سر برهنه](@)(@@) ~~عرفهآ پوشیدهآ لباس کامکاری، میر سر برهنه. نام او امیر شمس الدین است، در عهد میرزا به(@)(@@) ~~هرات آمده، بیست سال به امر استیفا قیام نموده، در اواخر چون سبب عزل خود را از امیر(@)(@@) ~~علیشیر دانست این قصیده در شکایت وی گفت که مطلعش این است:(@)(@@) آن سهی سرو که در سایهآ خود داد رهم کرد غمازی و بنشاند به خاک سیهام(@)(@@) ~~مع هذا امیر 
ms1447	 علیشیر او را تفقد حال بر نهج اعلی نموده، منصب صدارت به وی داد، چه(@)(@@) ~~بسیار بسیار مستعد و عالی قدر، مستحضر علوم دینی کما ینبغی بوده، از جمله اشعار اوست:(@)(@@) آنان که پرستندهآ خورشید و مهاند %~% از چشم تو در آرزوی یک نگهاند(@)(@@) کنگر اگر این است که من میبینم %~% خوبان دگر پلنگ تعلیم گهاند(@)(@@) ~~و امیر علیشیر گفته در مجالس میر سر برهنه از سادات واجب الاحترام ترکستان بود، به(@)(@@) ~~غایت خوش صحبت شیرین کلام است، مدتی صدارت کرد و در ایام جوانی به عاقل(@)(@@) ~~کنگر تعلق ورزید و از صلاح عنان تافت.2(@)(@@)(@@)(@@) | 1311(@)(@@)(@@)(@@) | سرخ وداعی](@)(@@) ~~عرفهآ داعی بر رمهآ خیال راعی، سرخ وداعی. با کمال سیاه بختی در عرصهآ سخنوری که PageV03P1686(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0344.jpg)(@)(@)(@@) ~~میدان خامهآ زرد چهره است به غایت سفیدروی بوده، رقمش چون خط سبز بنفشه مویان(@)(@@) ~~روح بخش وجانفزاست. و له:(@)(@@) (@@) - زمان رفتن است آن قد و رفتار آرزو دارم %~% دم پوشیدن چشم است و دیدار آرزو دارم(@)(@@) (@@) - به گرم و سرد جهان رهروی که خو کردهاست %~% سموم بادیه باشد نسیم گلزارش(@)(@@)(@@)(@@) | 1315](@)(@@)(@@)(@@) | [خواجه سعد گل شیرازی](@)(@@) ~~عرفهآ اختر سعد سپهر سرفرازی، خواجه سعد گل شیرازی. با خواجه حافظ و اهلی(@)(@@) ~~شیرازی در مصلای آنجا در یک مضجع و یک مصرع است. به غایت فاضل کامل دانای و(@)(@@) ~~در فنون نظم توانا بود. اشعار با مزه بلند رتبهآ استادانه دارد. و له:(@)(@@) - مگر تو خود به کلید قبول بگشایی %~% در دلم که به مهر تو و نشانهآ تست(@)(@@) ~~- در فراقم پیش ازین یک پرده حایل بود و بس - این طرفه که خود مست(@)(@@) انا الحق زد و آخر %~% بدنامی عالم همه در گردن حلاج نهاد %~% در وصالم این زمان صد پرده حایل مانده است(@)(@@) (@@) - برگ گل نیست که افتاده به طرف چمنت %~% پنبهآ داغ دل بلبل خونین کفن است(@)(@@) (@@) - تنم از ضعف جهان شد که اجل جست و نیافت %~% ناله هر چند نشان داد که در 
ms1448	 پیرهن است(@)(@@) (@@) - کشید پیش تو هر کس متاع خویش و دلم %~% نداشت چیز دگر، نالههای زار کشید(@)(@@) (@@) بدین خوشم ز ضعیفی خود که تیر تو را %~% نمیتوانم ازین سینهآ فگار کشید(@)(@@) ~~این مطلع که نوشته میشود به دیگری هم منسوب است:(@)(@@) (@@) به دست پنبهآ داغم به جای نسرین است %~% گلی که از چمن عشق چیدهام این است PageV03P1687(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0345.jpg)(@)(@)(@@) ~~متوسطین است، و مترجم مجالس گوید که از مریدان شاه قاسم انوار بود، چون بی قیدی از(@)(@@) ~~حد گذرانیده، شاه قاسم فرمود تا حجرهآ خانقاهش را ویران کردند و خاکش را بیرون(@)(@@) ~~ریختند. وی در آن حال این غزل را به مناسبت احوال خویش گفت:(@)(@@) ~~- مرا در عالم رندی به رسوایی علم کردی دلم بردی و جانم را ندیم صد ندم کردی1(@)(@@) (@@) - نشان در تختهآ هستی نبود از عالم و آدم %~% که جان در مکتب عشق از تمنای تو میزد دم(@)(@@) (@@) که دارد این چنین عیشی که در عشق تو من دارم %~% شرابم خون، کبابم دل، ندیمم درد و نقلم غم(@)(@@) (@@) نظر بر صورت خوب تو بود استاد فطرت را %~% وگر نه کی شدی هرگز مخمر طینت آدم(@)(@@) (@@) برو ای عقل نامحرم که مستان با خیال او %~% چنان خوش خلوتی دارم که من هم نیستم محرم(@)(@@) (@@) مرا گویند سعد از عشق او حاصل چهها داری؟ %~% ملامتهای گوناگون، جراحتهای بی مرهم(@)(@@) (@@) - به احتیاط گذر چون شکسته دل سعد %~% خدای را حذر از شیشهآ 2 شکستهآ من(@)(@@) (@@) - ترسم به دامن تو شبی شعلهای کشد %~% زان آتشی که در دل سعد است مشتعل(@)(@@) (@@) - طوفان محنت آمد و سیلم ز سر گذشت %~% این است در وفای تو حالم ز سر گذشت(@)(@@) خوش کن به پرسشی دل بیمار سعد را %~% زان پیشتر که پرسی و گویند در گذشت(@)(@@) (@@) دارد هوس خاک درت سعد و لیکن %~% در کوی تو کی راه دهند اهل هوس را؟ 309a(@)(@@) (@@) - کو دل که ز دستان تو پا بستهآ غم نیست %~% یا 
ms1449	 جان که جراحت شدهآ تیغ ستم نیست(@)(@@) غم ساقی و مئ خون دل و ناله مغنی %~% هیچم ز تنعم به سر کوی تو کم نیست(@)(@@) بر سعد مران جز قلم مستی و رندی %~% هر چند که بر عاشق و دیوانه قلم نیست(@)(@@)(@@)(@@) | [سعد مشهدی](@)(@@) ~~عرفهآ صاحب کمال سرمدی، سعد مشهدی. از خوش طبعان است و بعضی او را سعید PageV03P1688(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0346.jpg)(@)(@)(@@) ~~عرضه سینیه /غرفهآ متوسطین(@)(@@) ~~مشهی خوانند1:(@)(@@) (@@) - مرا در عالم رندی و رسوایی علم کردی %~% دلم بردی و جانم را ندیم صد ندم کردی(@)(@@) (@@) - شبی بنشین و چندانی شراب بی حسابم بخش %~% که نتوانم که تا روز حساب از جای برخیزم(@)(@@)(@@)(@@) | 1318)(@)(@@)(@@)(@@) | امولانا سعید غلامی](@)(@@) ~~عرفهآ سفید روی محفل نیک نامی، مولانا سعید غلامی. به غایت صاحب طبیعت، پر ذوق(@)(@@) ~~وشوق، عاشق پیشه، صالح رند، لوند از خود گذشته بود، و در تذکرهآ امیر علیشیر مذکور(@)(@@) ~~است. و له:(@)(@@) غلام خویشتنم خواند ماه رخساری %~% سیاه رویی من کرد عاقبت کاری(@)(@@)(@@)(@@) | 13319(@)(@@)(@@)(@@) | (مولانا سعید مشهدی](@)(@@) ~~عرفهآ مشهد سعادات ابدی، مولانا سعیدی مشهدی. در مجالس النفایس آمده که کاسه گری(@)(@@) ~~میکرد واین غزل ذوقافیتین از اوست:(@)(@@) از بهر قطع هستی حیله از صد جای انگیزم3 %~% مگر یک لحظه با آن دلبر خودرای آمیزم5 PageV03P1689(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0347.jpg)(@)(@)(@@) ~~عرفهآ اختر برج سعادت، سعید سعد. از جملهآ متوسطین است:(@)(@@) (@@) برگل عبیر داری و بر لاله مشکناب %~% بر نار ناردانه و بر ناردان گلاب(@)(@@) (@@) بر نسترن بنفشه و بر سوسن ارغوان %~% بادام تر ز نرگس و بر یاسمین نقاب(@)(@@) سرو از درخت قامت و بر سرو نیشکر %~% سیب از ترنج غبغب و از باد گل خوشاب(@)(@@) (@@) در روز ظلمت شب و در شب چراغ روز %~% در شام صبح صادق و در سایه آفتاب(@)(@@) (@@) در حقه لعل داری و در لعل آب خضر %~% در آب عکس آتش و آتش میان آب(@)(@@) دارد مدام در غم عشقت سعید سعد %~% چشمی پرآب و سینه پرآتش، جگر کباب(@)(@@)(@@)(@@) | 1321)(@)(@@) درویش سقای چغتایی](@)(@@) ~~عرفهآ 
ms1450	 از خود گذشته بی سر و پای بیهمتای، درویش سقای چغتای. مولد او از بخاراست و(@)(@@) ~~از بزرگان آن طبقه است که در کورهآ تجرد و درویشی جسد وجود خود را ذوب نموده به(@)(@@) ~~سیاحت اشتغال نمودی، در بلاد سند و هند بسیار گشته، الخاص در اوایل همایون پادشاه.(@)(@@) ~~دیوانی قریب به چهار هزار بیت از وی به نظر بنده رسیده، درویشانه سخن میگوید. نقل(@)(@@) ~~است که در اواخر حیات شورشی عظیم در او پیدا شد و در هیچ جا استقامت نمینمود تا(@)(@@) ~~در راه سراندیب درگذشت. از رفیق او را روایت کنند که شخصی در صحرایی او که فوت(@)(@@) ~~شده بود بر جنازه وی حاضر شد، گفت: سه شب است که حضرت رسالت پناه - صلی الله(@)(@@) ~~علیه و سلم - را در خواب دیدهام که گفت: البته بر جنازهآ دوست ما در فلان جا حاضر شود،(@)(@@) ~~در همان منزل بعد از نماز آن شخص از نظرها غایب شد. العهدة علی الراوی. وله:(@)(@@) ~~- ز خال عارضت در هر نظر حیرانیی دارمبه دور نقطه چون پرگار سرگردانیی دارم(@)(@@) (@@) گر از خیل گدایانم ولی بی منت سلطان %~% به خون دل قناعت کردهام سلطانیی دارم PageV03P1690(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0348.jpg)(@)(@)(@@) ~~عرصهٔ‌ شینیه اغرقه منوسطین(@)(@@) (@@) شد روزگار ما سیه از دود آه ما %~% یا رب کسی مباد به روز سیاه ما(@)(@@) (@@) سقا گدای تست به درد دلش برس %~% بیداد بیش ازین مکن ای پادشاه ما(@)(@@) ~~د اساس پارسایی را شکستم تا چه پیش آید به ترسازادهای دادم دل و سررشتهآ دین هم به کوی زاهدان بیهوده عمری در به در گشتم گهی اهل عبادت(@)(@@) می شمارندم، گهی فاسق به رغم محتسب با ساقی گلچهره ای سقا %~% سر بازار(@)(@@) رسوایی نشستم تا چه پیش آید %~% درین پیرانه سر زنار بستم تا چه پیش آید(@)(@@) %~% کنون رند و خراباتی و مستم تا چه پیش آید %~% سبو بردوش و جام می به(@)(@@) دستم تا چه پیش آید %~% به هر طوری که 
ms1451	 میگویند هستم تا چه پیش آید(@)(@@) (@@) - به کوی میکده درباختیم تقوی را %~% فروختیم به جامی کتاب فتوی را(@)(@@) (@@) قلم به رندی سقا زد از ازل تقدیر %~% چگونه تری تواند رضای مولی را(@)(@@) (@@) ز هرچه بود برآورد عشق یار مرا %~% به کار و بار جهان بعد ازین چه کار مرا(@)(@@) ~~- ببر ای باد از خاک سر کویش غبار ما - مباد نخل قدت را شکست باد(@)(@@) خزان %~% که نبود اشک کو را اعتبار از رهگذار ما %~% که سرو قد تو آمد عصای پیری را(@)(@@) (@@) - بزن به سینه خدنگی برای راحت ما %~% که ناوک تو بود مرهم جراحت ما 3090(@)(@@) (@@) - برفکن از جمال خویش نقاب %~% که من و تو و اوست هر سه حجاب(@)(@@) (@@) بی تو جانم به لب رسید بیا %~% نفسی مانده جان من دریاب(@)(@@) (@@) زاهد از باده کرد توبه و من -گدای کوی تو شاها امیر محتشم است %~%(@)(@@) توبه کردم ز توبه یا تواب %~% به هر دلی که غمت می رسد به غم نعم است(@)(@@) ~~- افتاده جام می ز کف جم شکست و ریخت دل را شکست و خون مرا ریخت بر(@)(@@) زمین %~% زینگونه ساغر می کس کم شکست و ریخت %~% کس را چو من مباد به عالم شکست و ریخت(@)(@@) (@@) - طرف کلاه و کاکل مشکین شکست وبست %~% صد فتنه سرزده به جهان زین شکست و بست(@)(@@) (@@) با ما شکست عهد و به اغیار بست دل %~% واحسرتا که کشت مرا زین شکست و بست(@)(@@) ~~بی ناله و فریاد دل من نفسی نیست سقا بسی شکسته در آن زلف بسته دید(@)(@@) حال دل ویران شدهآ خود به که گویم %~% فریاد ازین درد که فریادرسی نیست %~%(@)(@@) ازان دل به آن دو طره پرچین شکست و بست %~% چون غیر تو در خاطر من هیچ کسی نیست(@)(@@) (@@) رسید عشق و برفت از دلم هوای و هوس %~% به غیر ذکر تو در دل نماند جای نفس PageV03P1691(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0349.jpg)(@)(@)(@@) مولانا سلطان علی مشهدی(@)(@@) ~~عرفهآ راقم نسخهآ کمالات 
ms1452	 سرمدی، استاد کاتبان دبیرستان هدی، قبلة الکتاب، مولانا(@)(@@) ~~سلطان علی مشهدی. و آن خطاطی است که از غیرت عروس رقمش سنبل زلف بوستان(@)(@@) ~~در تاب، و از خجلت عقد شهوار قلمش گوهر شب چراغ بی آب گردیده، شیوه خط(@)(@@) ~~نسخ تعلیق بر وی و مولانا میر علی ختم شده، ثالث این دو شخص تا غایت به هم نرسیده،(@)(@@) ~~هر چند تتبعات وافر نمودهاند، چه خطوط این دو بزرگ مرتبهآ سحر بل اعجاز دارد و(@)(@@) ~~شهرت ایشان از آن بیشتر است که احتیاجی به تعریف داشته باشد. کمال حسن خط و(@)(@@) ~~حسن صورت و خوش سیرت را جمع نموده بود، چنانکه گویند: حسن اخلاقش از حسن(@)(@@) ~~خط زیاده آمده بود. در کتابت به قدرت او کم کسی معروف است، و وی از شاگردان مولانا(@)(@@) ~~اظهر است و مولانا اظهر از شاگردان مولانا جعفر و مولانا جعفر شاگرد مولانا میر علی(@)(@@) ~~تبریزی که واضع خط نسخ تعلیق است. اما شاگردان رشید وی مولانا علاءالدین محمد و(@)(@@) ~~سلطان محمد خندان و سلطان محمد نور و سلطان محمد ابریشمی و قلندر کاتب و مولانا(@)(@@) ~~شمس الدین محمد که استاد مولانا میر علی ثانی بوده، و مولانا سلطان علی مذکور در(@)(@@) ~~زمان میرزا ابوالبقا سلطان حسین بایقرا وامیر علیشیر در عرصهآ وجود بوده و مثنویی در(@)(@@) ~~روش خوش نویسی گفته است. و له:(@)(@@) (@@) -گل در بهار از آن رخ گلگون نمونهای است %~% چون اشک من که از دل پر خون نمونهای است(@)(@@) - با این همه بی حاصلی و بوالهوسی %~% درمانده به پارسایی و هیچ کسی(@)(@@) دادیم نشان به گنج مقصود تو را %~% گر ما نرسیدیم تو شاید برسی(@)(@@) - در جوانی به خط بدی میلم %~% عشق خط راندی از مزه سیلم(@)(@@) نیت روزهآ علی کردم %~% قلم مشق را جلی کردم(@)(@@) مشق را چون قلم کمر بستم %~% پیش زانوی خویش بنشستم(@)(@@) هر که کوبد دری ز روی نیاز %~% عاقبت می شود به رویش باز(@)(@@) بنده سلطان علی 
ms1453	 غلام علی است %~% شهرت نام او ز نام علی است PageV03P1692(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0350.jpg)(@)(@)(@@) ~~عرصهٔ‌ سینیه / غرفهٔ‌ متوسطین(@)(@@) (@@) اولا میکنم بیان قلم %~% بشنو این حرف از زبان قلم(@)(@@) (@@) که قلم سرخ رنگ میباید %~% نه به سختی چو سنگ میباید(@)(@@) (@@) نه سیاه و نه کوته و نه دراز %~% یاد گیر ای جوان ز روی نیاز(@)(@@) (@@) معتدل، نه سطبر و نه باریک %~% واندرونش سفید نه تاریک(@)(@@) (@@) نه درو پیچ و نی درو تابی %~% ملک خط راست نیک اسبابی(@)(@@) (@@) کاغذی بهتر از خطایی نیست %~% گر چه چندانکه آزمایی نیست(@)(@@) (@@) حبذا کاغذی سمرقندی %~% مکنش رد اگر خردمندی(@)(@@) (@@) هیچ رنگی به از حنایی نیست %~% حاجت آنکه آزمایی نیست1(@)(@@) ~~و هم چنین در جمیع آداب خوش نویسی و اسرار آن در این نسخه بیان فرموده.(@)(@@)(@@)(@@) | 1323)(@)(@@) [درویش سلطان علی قاینی](@)(@@) ~~عرفهآ درویش سلطان مشرب، 510 درویش سلطان علی. امیر علیشیر گوید: وی در خدمت(@)(@@) ~~مولانا جامی بودی، و به غیر از تصانیف وی کتابتی نمیفرمودی. کاتبی خوبی بوده،(@)(@@) ~~او راست.(@)(@@) ~~ای ز عشقت آتش زده ناموس و ننگ و نام را داده به باد نیستی هستی خاص و عام را(@)(@@)(@@)(@@) | 132(@)(@@)(@@)(@@) | [سلطان حسین ختمی](@)(@@) ~~عرفه: نیز در مجالس امیر علیشیر فرموده سلطان حسین ختمی3 پسر امیر شیخ بهلول اتکه PageV03P1693(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0351.jpg)(@)(@)(@@) ~~است، پدرش اگر چه حالا طریق فقر اختیار کرده، اما سالها به دولت سلطان صاحبقران بر(@)(@@) ~~تخت خوارزم حکومت کرد. وی جوانی فقیر است و طبعش خالی از لطافتی نیست، گفته:(@)(@@) ~~مرا بسیار مشکل مینماید فرقت جانان وداع جان شیرین هست دشوار ای مسلمانان1(@)(@@)(@@)(@@) | [سلطان محمود میرزا](@)(@@) ~~عرفه: ایضا نقل مجالس امیر علیشیر است که سلطان محمود میرزا ولد سلطان ابو سعید(@)(@@) ~~میرزاست، او را در ماوراءالنهر محمود غازی گفتندی، اکثر بدخشان و ماوراءالنهر در تحت(@)(@@) ~~لوای او مرفه الحال بودندی، همیشه به تربیت اهل فضل وکمال قیام نمودی و چون(@)(@@) ~~شاهان را ظل الله میگویند، ظلی تخلص کردی، و از جملهآ اشعار اوست:(@)(@@) ~~- گنبد گردون که خشتی 
ms1454	 نقره و خشتی زر است پیش چشم اهل بینش توده خاکستر است(@)(@@) - در کوی بلا پای نهادم ز سلامت %~% بر سینهآ ناموس زدم سنگ ملامت(@)(@@)(@@)(@@) | 21326(@)(@@)(@@)(@@) | [سلطان مسعود](@)(@@) ~~عرفه؛ و هم چنین در آنجا مسطور است که سلطان مسعود ولد سلطان محمود مذکور(@)(@@) ~~است، بعد از پدر به تخت سلطنت قیام نمود، اما آخر به سبب انقلاب روزگار به ملازمت(@)(@@) ~~سلطان حسین میرزا شتافت و به دولت دامادی او مشرف گردید و باز اندیشه به خاطر(@)(@@) ~~رسانیده به دیار خویشتن شتافت، در آنجا وی را امیر خسرو شاه گرفته میل کشید و بعد از(@)(@@) ~~میل کشیدن این رباعی گفت: PageV03P1694(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0352.jpg)(@)(@)(@@) نقدی1 که عیار دیدهآ روشن بود %~% چشم بد ایام ز چشمم بربود(@)(@@) فریاد که فریاد به جایی نرسید %~% افسوس که افسوس نمیدارد سود2(@)(@@) ~~گویند بعد از آن در خدمت میرزا آمد و چون میرزا از عالم فانی به سرای جاودانی رحلت(@)(@@) ~~فرمود و خراسان به دست محمد خان شیبانی منتقل گردید به دست اوزبک شهادت(@)(@@) ~~یافت. دو دیوان شعر دارد، یکی ترکی و یکی فارسی. در فارسی عارفی1 تخلص میکند و(@)(@@) ~~بایسنقر میرزا برادر اوست و او راست:(@)(@@) تا نشتر غم جسم مرا زیر و زبر کرد %~% از طالع مسعود فلک قطع نظر کرد(@)(@@)(@@)(@@) | 1327)(@)(@@) [خواجه سلطان محمد ولد شمس الدین بتکچی](@)(@@) ~~عرفه؛ نیز در مجالس امیر آمده که خواجه سلطان محمد4 ولد شمس الدین بتکچی به(@)(@@) ~~خواجه منصور قرابوغه خویشی دارد و در نجوم به غایت صاحب وقوف است3، و او(@)(@@) ~~راست:(@)(@@) (@@) کنج زرگر نبود گنج، قناعت باقی است %~% آنکه آن داد به شاهان، به کدایان این داد(@)(@@)(@@)(@@) | 1328)(@)(@@)(@@)(@@) | امیر سلطان محمد بخشی](@)(@@) ~~عرفه: و هم چنین مذکور مجالس است که امیر سلطان محمد بخشی ملازم بدیع الزمان PageV03P1695(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0353.jpg)(@)(@)(@@) ~~میرزاست، بسیار قابل بود، شعر ترکی بیشتر میگفته1.(@)(@@)(@@)(@@) | 1325(@)(@@) [امیر سلطان علی مهردار](@)(@@) ~~عرفه؛ هم در مجالس جلوه گر است که زبدة الامرا، امیر سلطان علی مهردار ولد امیر حسن 
ms1455	(@)(@@) ~~قلی و نبیرهآ سلطان بیگ بود، منصب امارت موروثی اوست. پدرش در ظل سلاطین(@)(@@) ~~ماوراءالنهر، و وی در خدمت شاه حسن میرزای ارغون میبود، همت و خلق و صحبت و(@)(@@) ~~مطلعی از اشعار ترکی را دعوی کرد که هر که جواب گوید هزار لاری بگیرد و کس جواب(@)(@@) ~~نتوانست گفت، و از اوست:(@)(@@) (@@) بر آمد گرد کویت خاک من از گردباد غم %~% فشاند خاک بر سر بهر دادی و ندادی هم(@)(@@) [خواجه سلمان ساوجی](@)(@@) ~~عرفهآ مشاطهآ عروس معانی، معدن گوهر سخندانی، 5100 تفسیر آیات کمال، صاحب(@)(@@) ~~رایات جلال، استاد زمان، نادرهآ دوران، میزان عیار راستی و کجی، خواجه سلمان ساوجی.(@)(@@) ~~هو جمال الدین محمد بن خواجه علاءالدین محمد که آبا و اجداد ایشان بطنا بعد بطن(@)(@@) ~~نویسنده و اهل حساب و سیاق بودهاند و از مردم متعین عامل ساوهاند. خواجه سلمان(@)(@@) ~~خود سرآمد شعرا و ندمای عصر بود. گویند چون در عنفوان حال به بغداد افتاد،(@)(@@) ~~به ملازمت شیخ حسن نویان رسید و به جهت کمانداری وی فی البدیهه چند بیتی گفت،(@)(@@) ~~وی را به غایت مستحسن افتاد و چه نهایت قدرت شاعری در طبیعت در جبهه او مشاهده PageV03P1696(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0354.jpg)(@)(@)(@@) ~~نمود، لهذا در صدد تربیت او در آمده، او را به قرة العین خود سلطان اویس مصاحبت(@)(@@) ~~فرمود و وی در آن دولت سالها مداحی نمود و از خدمت ایشان ذکورا او آناثا یافت(@)(@@) ~~آنچه یافت. الحق وی در مدح شیخ حسن و سلطان اویس و دندی و دلشاد مدحتهای(@)(@@) ~~عالی سنجیده فرموده، وکلیات او از قصاید و تغزلات و مثنویات اعم از خورشید و(@)(@@) ~~جمشید و غیره قریب بیست هزار بیت به نظر قایل رسیده و از آن مشهورتر است که محتاج(@)(@@) ~~بیان باشد.(@)(@@) ~~نقل است که در اواخر حیات گوشهآ عزلت اختیار نموده از ری و ساوه سیورغالات از دیوان(@)(@@) ~~سلطان اویس یافت و به آن قناعت نمود. در شهور سنهآ تسع و ستین و سبعمایه به 
ms1456	 جوار(@)(@@) ~~حق پیوست، و بعضی گویند در هفتصد و هفتاد و دو در گذشت. تاریخ اول موافق به(@)(@@) ~~(وجود دلشاد حدت /770) و (فناست ارواح /757؟) و (ایله ایلنارکه ؟) و(مطلع ما(@)(@@) ~~تقطع /769) و دویم مطابق به (عرش بلقیس /772) و (آدمیت و هوش /772).1 قطعهای(@)(@@) ~~که در حین کمانداری فی البدیهه گفته بود این است:(@)(@@) - چو در بار چاچی کمان رفت شاه %~% تو گفتی که در برج قوس است ماه(@)(@@) دو زاغ کمان با عقاب سه پر %~% بدیدم به یک گوشه آورده سر(@)(@@) نهادند سر بر سر دوش شاه %~% ندانم چه گفتند در گوش شاه(@)(@@) چو از شست بگشاد خسرو گره %~% آمد ز هر گوشه آواز زه(@)(@@) شها تیر در بند تدبیر تست %~% سعادت دوان در پی تیر تست(@)(@@) به عهدت زکس نالهای برنخاست %~% به غیر از کمان گر بنالد رواست(@)(@@) که در عهد سلطان صاحبقران عشق اگر زیبا بود، معشوقه گو زیبا مباش(@)(@@) دزحمت ما میدهی، زاهد تو را با ما چه کار %~% نکردهاست کس زور جز بر کمان(@)(@@) %~% عقل و دین و زهد را با عاشق شیدا چه کار؟ %~% عشق را با صورت زیبا و نازیبا چه کار؟(@)(@@) (@@) - تو یقین دان که به جز در دهن تنگ تو نیست %~% هیچ گر در دو جهان یکسر مو کامی هست(@)(@@) (@@) عود اگر دود کند بر سر او، دامن پوش %~% تا ندانند که در مجلس ما خامی هست PageV03P1697(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0355.jpg)(@)(@)(@@) ~~وای به دیدار توام، دیدهآ گریان مشتاقز اشتیاق لب لعلت به لبم جان مشتاق(@)(@@) (@@) دل به سوز تو چو پروانه به آتش مایل %~% جان به درد تو چو بیمار به درمان مشتاق(@)(@@) (@@) چون بود سبزهآ پژمرده به باران تشنه1 %~% بیش از آنم من مهجور، به جانان مشتاق(@)(@@) (@@) - فروغ حسن رویت کی تواند دید هر بیدل؟ %~% دلی چون کوه میباید که برتابد تجلی را(@)(@@) (@@) ورای پایهٔ‌ عقل است طور عاشقی، ورنه %~% کجا دریافتی مجنون، کمال حسن لیلی را(@)(@@) (@@) - در همه عالم نمیگنجی ز فرط کبریا 
ms1457	 %~% در دل تنگم نمیدانم که چون جا کردهای(@)(@@) (@@) - گر من از روی تو دورم، نه دل من با تست؟ %~% نیستی هیچ ز حال دلم آگاه چرا؟(@)(@@) (@@) - نسیم صبح من از مشرق صبوح دمید %~% ز خواب صبح در آرید آفتابم را(@)(@@) (@@) - گرفت دامن من اشک و بر درش بنشاند %~% کجا روم ز درد او که خون گرفت مرا(@)(@@) (@@) - ز رفتن پای2 عاجز گشت و ره را نیست پایانی %~% اگر کاری به سر میشد ز سر میساختم پا را(@)(@@) (@@) ز شرح حال من، زلفت چو طوماری است سربسته %~% اگر خواهی خبر، بگشا سر طومار سودا را(@)(@@) (@@) - مگسوار از سر خوان وصال خود مران ما را %~% نه مهمان توایم آخر، بخوان روزی، بخوان ما را(@)(@@) (@@) قیامت باشد آن روزی که بر بوی تو چون نرگس %~% ز خواب خوش برانگیزند مست و سرگردان ما را(@)(@@) (@@) - ای که بر من میکشی خط و نمیخوانی مرا %~% بر مثال نامه، بر خود چند پیچانی مرا؟3119(@)(@@) (@@) ای که از درگاه خود راندی به صد ناکامیم2 %~% نیستم، کام دل آخر تا به کی رانی مرا؟(@)(@@) (@@) - از ما غبار اگر چه بر انگیخت، درد او %~% گردی به دامنش مرساد از غبار ما(@)(@@) (@@) یار اختیار ماست زگیتی، ولی چه سود %~% در دست ما چو نیست کنون اختیار ما(@)(@@) (@@) -چشمهآ چشم من از سرو قدت یابد آب %~% رشتهآ جان من از، شمع رخت دارد تاب(@)(@@) (@@) تشنه لب گرد سراپای جهان گردیدم %~% نیست سرچشمه به غیر از تو و باقیاست سراب(@)(@@) (@@) روز پرسش که به یک ذره بود گفت و شنید %~% عاشقان را نبود جز به دهان تو جواب(@)(@@) (@@) - ساقی مجلس بده باده که خواهیم رفت %~% ما به هوای لبش، بر سر می چون حباب(@)(@@) (@@) سر جمالت به عقل، در نتوان یافتن %~% خود به حقیقت نجست، کس به چراغ آفتاب(@)(@@)(@@)(@@) | مزد فمحفته چه داند که کجا باید رفت؟(@)(@)PageV03P1698(@)(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0356.jpg)(@)(@)(@@) ~~رضته سینیه /غرفهٔ‌ متوسطین(@)(@@) (@@) غرض از کعبه و بتخانه تویی سلمان را %~% چه 
ms1458	 کنم خانه پی خانه خدا باید رفت(@)(@@) (@@) - زاهد دهدم توبه ز روی تو زهی! روی %~% هیچش ز خدا شرم و ز روی تو حیا نیست(@)(@@) (@@) و جان من میرقصد از شادی، مگر یار آمدست %~% می جهد چشمم همانا وقت دیدار آمدست(@)(@@) (@@) میرود اشکم که بوسد خاکپایش را به چشم %~% بر لبم جان نیز پنداری بدین کار آمدست(@)(@@) (@@) گر بلا بسیار شد، سلمان چه شد، مردانه باش %~% بر سر مردان، بلای عشق بسیار آمدست(@)(@@) - به وصل قد تو دارم بسی امید ولی %~% قبای عمر به قد امید کوتاه است(@)(@@) (@@) - درون ز غیر بپرداز و ساز، خلوت دوست %~% که اوست، مغز حقیقت، برون ازو همه پوست(@)(@@) (@@) تو را نظر همگی بر خودست و آن هیچاست %~% تو هیچ شو خود1، وانگه ببین که خود همه اوست(@)(@@) (@@) - درد عشق تو که جز جان منش منزل نیست %~% در دل میزند و جز تو، کسی در دل نیست(@)(@@) (@@) من تنی دارم و آن تن چو میانت هیچ است %~% غیر ازین هیچ میان من و تو حایل نیست(@)(@@) (@@) عارفا! عمر به باطل رودت تا نرسی %~% به مقامی که درو هر چه رود باطل نیست(@)(@@) (@@) - هر زمان جلوه حسن ارچه ز روی دگرست %~% باش یک دل به همه روی که جانانه یکیاست(@)(@@) - در سرم زلف تو سودا انداخت %~% کار من زلف تو در پا انداخت(@)(@@) آهو از باد چو بوی تو شنید %~% نافهآ مشک به صحرا انداخت(@)(@@) ماند یک قطرهآ خون از دل ما %~% دیده آن نیز به دریا انداخت(@)(@@) (@@) - دریچهآ نظر و رهگذار خاطر من %~% جز از خیال تو بر هر چه هست مسدود است(@)(@@) (@@) - من به وصلش کی رسم جایی که باد صبحدم %~% تا به درگاهش رسد از ضعف تن ده جا نشست(@)(@@) (@@) - فراق بر دل نادان چو برگ کاهی2 نیست %~% و لیک بر همهدان همچو کوه الوندست(@)(@@) (@@) دل از محبت جانان3، که بر تواند کند؟ %~% مگر کسی که دل از جان خویش برکندست(@)(@@) (@@) - مرا که 
ms1459	 چشم تو بختاست و بخت در خواباست %~% ترا که زلف تو شام است و صبح، در شام است(@)(@@) (@@) - بر جگر میزندم آن مژه هر دم نیشی %~% خون چشمم که روان گشته ازین رو جگری است(@)(@@) - می کشم دردی که درمانیش نیست %~% می روم راهی که پایانیش نیست(@)(@@) هر که جان در راه جانانی نباخت %~% یا ز دل دورست و یا جانیش هست PageV03P1699(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0357.jpg)(@)(@)(@@) (@@) گر تو با مایی به دل، دوری نمیدارد زیان %~% ور دلت با ما نباشد همنشینی سود نیست(@)(@@) (@@) خلوتسرای چشم و دل، این شسته و آن رفتهام %~% فرمای و بنشین جان من، آنجا که میخواهد دلت(@)(@@) (@@) حال بیماری چشم تو و بی خوابی من %~% داند ابروی تو کان بر سر بیماران است(@)(@@) (@@) - بر نمی دارد حجاب از هودج لیلی صبا %~% تا خلایق را شود روشن که مجنون عاقل است(@)(@@) (@@) - کار کارافتادگان را باز میبین، گاهگاه %~% خاصه، کار افتادهای، کز کار و بار افتادهاست(@)(@@) (@@) جمله ذرات وجودم غرق بحر حیرت است %~% زان میان این اشک خونین بر کنار افتادهاست(@)(@@) (@@) - دور از تو به شمشیر سرش باد زتن دور %~% آن را که به شمشیر زکویت، سر دوری است(@)(@@) (@@) - تن به پیشت شمعسان میسوخت در شب تا بمرد %~% دل به کویت چون صبا میداد جان تا درگذشت(@)(@@) (@@) - هر که از خود خبری دارد، ازو بیخبر است %~% عشق جایی نبرد پی که ز هستی اثر است(@)(@@) (@@) بر سر کوی محبت نتوان پای نهاد %~% که در آن کوی به هرجا که نهی پای، سر است(@)(@@) (@@) جان من همنفس باد سحر خواهد بود %~% تا ز بویت نفسی، در تن باد سحر است(@)(@@) (@@) -ز التفات تو با من، توان مشاهده کردن %~% که چون کند به عظام رمیم، روح اعادت(@)(@@) (@@) -گفتهای باد سحر با تو بگوید خبرم %~% این سخن پیش کسی گو، که شبش را سحریاست(@)(@@) (@@) - بی لبش چون گل پر از خون باد، کام ساغرم %~% گر لب من خنده زد، یا دست من ساغر 
ms1460	 گرفت(@)(@@) (@@) - مشک ریزان میجهد باد صبا از کوی دوست %~% نافه گویی ربودست، از خم گیسوی دوست(@)(@@) (@@) - من که در زمرهٔ‌ عشاق به رندی علمم %~% طبل پنهان چه زنم، طشت من از بام افتاد(@)(@@) (@@) - من چه دانستم که اشک یار1 چندین بر کشد؟ %~% تا مرا یک بارگی لطفش قلم بر سر کشد 3110(@)(@@) (@@) اشک را کش من به خون پرورد اندازم ز چشم %~% ناله را کز دل برون کردم به رغمم بر کشد(@)(@@) (@@) -گر بخواهند بریدن سر ما چون زلفت %~% تا دگر یک سر مو از تو نخواهیم برید(@)(@@) (@@) - بر دلم صحبت آن کس که ندارد ذوقی %~% گر همه جان عزیز است، گران میآید(@)(@@) (@@) به حیات تو که اگر میخورم از دست تو زهر %~% خوشتر از آب حیاتم به دهان میآید(@)(@@) (@@) - به هر زمین که افتد، از قامت تو سایه %~% تا دامن قیامت، زان خاک جان برآرد(@)(@@) (@@) مثلت فلک نبیند، با صد هزار دیده %~% چندان که دیدهها را، گرد جهان برآرد PageV03P1700(@)(@@) ![image filename](./1050AwhadiBalyani.CarafatCashiqin_V03_0358.jpg)(@)(@)(@@) ~~عرصه سینیه غرفهٔ‌ متوسطین(@)(@@) (@@) - دوش بر دوش فلک میزنم امروز که دوش %~% مستم از کوی خرابات به دوش آوردند(@)(@@) (@@) -گل فردوس چه باشد که به روی تو رسد %~% یا نسیمش که به خاک سر کوی تو رسد(@)(@@) (@@) از خط سبز تو در آتشم ای آب حیات %~% رشکم آید که خضر بر لب جوی تو رسد(@)(@@) (@@) من به بوی توام ای دوست هواخواه بهار %~% کز هوایش1 به دماغم همه بوی تو رسد(@)(@@) (@@) - گر تو چو شمعم کشی، بی تو نخواهم نشست %~% ور تو به تیغم زنی از تو نخواهم برید(@)(@@) -ز آفتاب رخت ماه تاب میگیرد %~% ز ماه طلعت تو آفتاب میگیرد(@)(@@) دلیر در مه2 رویت نمیتوان نگریست %~% همین که مینگرم دیده آب میگیرد(@)(@@) (@@) - خاک از نفس باد صبا بوی خوشت یافت %~% بر بوی تو بر روی هوا رقص کنان رفت(@)(@@) (@@) - خیال عارضت آباست از آن در دیده میگردد %~% نهال قامتت سرو است از آن در بر نمی آید 