ms261	 إن لله . . . . .(@)(@@) > > @QB@ ألا إن لله من في السماوات ومن في الأرض @QE@(@)(@@) قال محمد : ( ألا ) افتتاح كلام وتنبيه ؛ أي : له من في السموات ومن في | الأرض ، يفعل فيهم وبهم ما يشاء .(@)(@@) @QB@ وما يتبع الذين يدعون من دون الله شركاء @QE@ يقول : إن الذين تعبدون من | دون الله ليسوا بشركاء لله تعالى .(@)(@@) @QB@ إن يتبعون إلا الظن وإن هم إلا يخرصون @QE@ يقول : يعبدون أوثانهم ، | ويقولون : إنها تقربهم إلى الله - عز وجل - زلفى ، وما يقولون ذلك بعلم ، | إن هو منهم ( ل 141 ) إلا ظن ، وإن هم إلا يكذبون < <(@)(@@) | يونس : ( 67 ) هو الذي جعل . . . . .(@)(@@) > > @QB@ هو الذي جعل لكم الليل لتسكنوا فيه @QE@ يعني : لتستقروا فيه من النصب @QB@ والنهار مبصرا @QE@ أي : منيرا | لتبتغوا فيه معايشكم .(@)(@@) قال محمد : قيل : @QB@ مبصرا @QE@ يعني : مبصرا فيه ؛ كما تقول : ليل نائم ، | PageV02P266 | وإنما ينام فيه .(@)(@@) < <(@)(@@) | يونس : ( 68 ) قالوا اتخذ الله . . . . .(@)(@@) > > @QB@ إن عندكم من سلطان بهذا @QE@ أي : ما عندكم من حجة بهذا الذي قلتم | @QB@ أتقولون على الله ما لا تعلمون @QE@ أي : نعم ، قد قلتم على الله ما لا تعلمون | < <(@)(@@) | يونس : ( 69 ) قل إن الذين . . . . .(@)(@@) > > @QB@ قل إن الذين يفترون على الله الكذب لا يفلحون @QE@ ثم انقطع الكلام < <(@)(@@) | يونس : ( 70 ) متاع في الدنيا . . . . .(@)(@@) > > @QB@ متاع في الدنيا @QE@ يقول : الدنيا وما هم فيه متاع يستمتعون به ، ثم ينقطع إذا فارقوا | الدنيا .(@)(@@) قال محمد : @QB@ متاع @QE@ مرفوع على معنى : ذلك متاع في الدنيا .(@)(@@) سورة يونس من الآية ( 71 ) إلى الآية ( 74 ) .(@)(@@) < <(@)(@@) | يونس : ( 71 ) واتل عليهم نبأ . . . . .(@)(@@) > > @QB@ يا قوم إن كان كبر عليكم مقامي @QE@ بالدعاء إلى الله - عز وجل - | @QB@ وتذكيري بآيات الله فعلى الله توكلت فأجمعوا أمركم وشركاءكم @QE@ أي : | وأجمعوا شركاءكم @QB@ ثم لا يكن أمركم عليكم غمة @QE@ أي : في ستر ، ليكن ذلك | علانية . | PageV02P267(@)(@@) قال محمد : ( غمة ) مشتقة من : الغمامة التي تستر ؛ ومنه قوله : ' غم | الهلال ' وقد يجوز أن يكون قوله : ( غمة ) أي : غما ؛ يقال غم وغمة .(@)(@@) قالت الخنساء : |(@)(@@) % وذي كربة راخى ابن عمرو خناقه % % وغمته عن وجهه فتجلت %(@)(@@) قوله عز وجل : @QB@ ثم اقضوا إلي @QE@ أي : اجهدوا جهدكم @QB@ ولا تنظرون @QE@ | طرفة عين ؛ أي 
ms262	 : أنكم لا تقدرون على ذلك ؛ وذلك حين قالوا : @QB@ لئن لم تنته يا نوح لتكونن من المرجومين @QE@ .(@)(@@) < <(@)(@@) | يونس : ( 72 ) فإن توليتم فما . . . . .(@)(@@) > > @QB@ فإن توليتم @QE@ أعرضتم عن الإيمان @QB@ فما سألتكم @QE@ على ما أدعوكم إليه من | هذا الدين أجرا ، فيحملكم ذلك على ترك ما أدعوكم إليه .(@)(@@) < <(@)(@@) | يونس : ( 73 ) فكذبوه فنجيناه ومن . . . . .(@)(@@) > > @QB@ فكذبوه فنجيناه ومن معه في الفلك @QE@ في السفينة ^ ( وجعلناهم خلائف في | الأرض ) ^ بعد الهالكين .(@)(@@) < <(@)(@@) | يونس : ( 74 ) ثم بعثنا من . . . . .(@)(@@) > > @QB@ فما كانوا ليؤمنوا بما كذبوا به من قبل @QE@ أي : من قبل أن يأتيهم العذاب | @QB@ كذلك نطبع على قلوب المعتدين @QE@ المشركين .(@)(@@) سورة يونس من الآية ( 75 ) إلى الآية ( 82 ) . | PageV02P268(@)(@@) < <(@)(@@) | يونس : ( 76 ) فلما جاءهم الحق . . . . .(@)(@@) > > @QB@ فلما جاءهم الحق من عندنا @QE@ يعني : اليد والعصا .(@)(@@) < <(@)(@@) | يونس : ( 77 ) قال موسى أتقولون . . . . .(@)(@@) > > @QB@ قال موسى أتقولون للحق لما جاءكم أسحر هذا @QE@ قال الله - عز وجل - : | @QB@ ولا يفلح الساحرون @QE@ .(@)(@@) < <(@)(@@) | يونس : ( 78 ) قالوا أجئتنا لتلفتنا . . . . .(@)(@@) > > @QB@ قالوا أجئتنا لتلفتنا @QE@ لتصرفنا وتحولنا @QB@ عما وجدنا عليه آباءنا @QE@ يعنون : أنا | وجدناهم عبدة أوثان ، فنحن على دينهم @QB@ وتكون لكما الكبرياء @QE@ أي : وتريد | أن تكون لك ولهارون الملك والسلطان في الأرض .(@)(@@) قال محمد : إنما سمى الملك كبرياء ؛ لأنه أكبر ما يطلب من أمر الدنيا ، | وأصل الكبرياء : العظمة .(@)(@@) < <(@)(@@) | يونس : ( 81 ) فلما ألقوا قال . . . . .(@)(@@) > > @QB@ قال موسى ما جئتم به السحر @QE@ قال محمد : ( ما ) بمعنى الذي ؛ أي : | الذي جئتم به السحر .(@)(@@) < <(@)(@@) | يونس : ( 82 ) ويحق الله الحق . . . . .(@)(@@) > > @QB@ ويحق الله الحق @QE@ الذي جاء به موسى @QB@ بكلماته @QE@ بوعده الذي وعد | موسى يعني : قوله له : @QB@ لا تخف إنك أنت الأعلى @QE@ . | PageV02P269(@)(@@) سورة يونس من الآية ( 83 ) إلى الآية ( 86 ) .(@)(@@) < <(@)(@@) | يونس : ( 83 ) فما آمن لموسى . . . . .(@)(@@) > > @QB@ فما آمن لموسى إلا ذرية من قومه @QE@ قال مجاهد : يعني : أولاد الذين | أرسل إليهم موسى @QB@ على خوف من فرعون وملئهم @QE@ يعني : أشرافهم @QB@ أن يفتنهم @QE@ أن يقتلهم فرعون @QB@ وإن فرعون لعال في الأرض @QE@ أي : لباغ يبغي | عليهم ويتعدى @QB@ وإنه لمن المسرفين @QE@ .(@)(@@) < <(@)(@@) | يونس : ( 84 ) وقال موسى يا . . . . .(@)(@@) > > @QB@ وقال موسى يا قوم إن كنتم آمنتم بالله @QE@ وقد علم أنهم قد آمنوا وصدقوا ، | ولكنه كلام من 
ms263	 كلام العرب ؛ تقول : إن كنت كذا فاصنع كذا ؛ وهو يعلم أنه | كذلك ، ولكنه يريد أن يعمل بما قال له .(@)(@@) < <(@)(@@) | يونس : ( 85 ) فقالوا على الله . . . . .(@)(@@) > > @QB@ ربنا لا تجعلنا فتنة للقوم الظالمين @QE@ قال مجاهد : يقولون : لا تعذبنا | بأيدي قوم فرعون ، ولا بعذاب من عندك ، فيقول فرعون وقومه : لو كانوا على حق ما عذبوا ، ولا سلطنا عليهم ؛ فيفتنوا بنا .(@)(@@) سورة يونس من الآية ( 87 ) إلى الآية ( 89 ) . | PageV02P270 | < <(@)(@@) | يونس : ( 87 ) وأوحينا إلى موسى . . . . .(@)(@@) > > ^ ( وأوحينا إلى موسى وأخيه أن تبوءا لقومكما بمصر بيوتا واجعلوا بيوتكم | قبلة ) ^ تفسير مجاهد : أمروا أن يجعلوا في بيوتهم مساجد مستقبلي القبلة | يصلون فيها [ سرا ، لما ] خاف ( ل 142 ) موسى ومن معه من فرعون أن | يصلوا في الكنائس الجامعة .(@)(@@) @QB@ ربنا ليضلوا عن سبيلك @QE@ هذا دعاء عليهم ؛ يقول ؛ ربنا فأضلهم عن | سبيلك ؛ وذلك حين جاء وقت عذابهم [ . . . ] عليهم .(@)(@@) < <(@)(@@) | يونس : ( 88 ) وقال موسى ربنا . . . . .(@)(@@) > > @QB@ ربنا اطمس على أموالهم @QE@ فمسخت دنانيرهم ودراهمهم وزروعهم | حجارة @QB@ واشدد على قلوبهم @QE@ بالضلالة @QB@ فلا يؤمنوا @QE@ دعاء أيضا @QB@ حتى يروا العذاب الأليم @QE@ فحيل بينهم وبين أن يؤمنوا .(@)(@@) سورة يونس من الآية ( 90 ) إلى الآية ( 93 ) .(@)(@@) < <(@)(@@) | يونس : ( 90 ) وجاوزنا ببني إسرائيل . . . . .(@)(@@) > > @QB@ وجاوزنا ببني إسرائيل البحر فأتبعهم فرعون وجنوده بغيا وعدوا @QE@ العدو : | العدوان .(@)(@@) قال محمد : قوله : @QB@ فأتبعهم فرعون @QE@ أي : لحقهم ؛ يقال : أتبعت القوم : | PageV02P271 | لحقتهم ، وتبعتهم : جئت في إثرهم .(@)(@@) @QB@ حتى إذا أدركه الغرق @QE@ الآية < <(@)(@@) | يونس : ( 91 ) آلآن وقد عصيت . . . . .(@)(@@) > > يقول الله - عز وجل - : @QB@ آلآن وقد عصيت @QE@ لأنه آمن في حين لا يقبل الله فيه الإيمان ؛ وقد مضت سنة الأولين | في الذين خلوا من قبل أنه لا يقبل الإيمان عند نزول العذاب .(@)(@@) < <(@)(@@) | يونس : ( 92 ) فاليوم ننجيك ببدنك . . . . .(@)(@@) > > @QB@ فاليوم ننجيك ببدنك @QE@ تفسير مجاهد : بجسدك ، فقذفه البحر عريانا على | شاطئ البحر @QB@ لتكون لمن خلفك @QE@ لمن بعدك @QB@ أيه @QE@ فيعلم أنك عبد ذليل قد | أهلكك الله - عز وجل - وغرقك @QB@ وإن كثيرا من الناس عن آياتنا لغافلون @QE@ | يعني : المشركين لا يتفكرون فيها ولا ينظرون .(@)(@@) < <(@)(@@) | يونس : ( 93 ) ولقد بوأنا بني . . . . .(@)(@@) > > @QB@ ولقد بوأنا بني إسرائيل مبوأ صدق @QE@ أي : أنزلناهم منزل صدق 
ms264	 | @QB@ ورزقناهم من الطيبات فما اختلفوا حتى جاءهم العلم @QE@ هي كقوله : @QB@ ولا تكونوا كالذين تفرقوا واختلفوا من بعد ما جاءهم البينات @QE@ .(@)(@@) سورة يونس من الآية ( 94 ) إلى الآية ( 97 ) .(@)(@@) < <(@)(@@) | يونس : ( 94 ) فإن كنت في . . . . .(@)(@@) > > ^ ( فإن كنت في شك مما أنزلنا إليك فاسأل الذين يقرءون الكتاب من | قبلك ) ^ يعني : من آمن منهم . | PageV02P272(@)(@@) قال قتادة :(@)(@@) ذكر لنا أن نبي الله صلى الله عليه وسلم قال : ' لا أشك ولا أسأل ' .(@)(@@) @QB@ لقد جاءك الحق من ربك فلا تكونن من الممترين @QE@ يعني : الشاكين .(@)(@@) < <(@)(@@) | يونس : ( 96 ) إن الذين حقت . . . . .(@)(@@) > > ^ ( إن الذين حقت عليهم ( كلمات ) ربك لا يؤمنون ) ^ الآية ، هم الذين | يلقون الله - عز وجل - بكفرهم .(@)(@@) سورة يونس من الآية ( 98 ) إلى الآية ( 99 ) .(@)(@@) < <(@)(@@) | يونس : ( 98 ) فلولا كانت قرية . . . . .(@)(@@) > > @QB@ فلولا @QE@ فهلا @QB@ كانت قرية آمنت فنفعها إيمانها @QE@ تفسير قتادة : يقولون : لم | يكن هذا في الأمم ؛ لم ينفع قرية كفرت ثم آمنت حين عاينت عذاب الله - عز | وجل - @QB@ إلا قوم يونس لما آمنوا كشفنا عنهم عذاب الخزي @QE@ قال قتادة : | وذكر لنا أن قوم يونس كانوا بموضع من أرض ' الموصل ' فلما فقدوا نبيهم ، | قذف الله - عز وجل - في قلوبهم التوبة ، فلبسوا المسوح ، وفرقوا بين كل | بهيمة وولدها ، فعجوا إلى الله أربعين ليلة ، فلما عرف الله - عز وجل - | الصدق من قلوبهم ، والتوبة والندامة منهم على ما مضى كشف عنهم العذاب | PageV02P273 | بعد ما نزل عليهم .(@)(@@) قال يحيى : بلغني أنه كان بينهم وبين العذاب أربعة أميال .(@)(@@) وقوله : @QB@ ومتعناهم إلى حين @QE@ يعني : إلى الموت بغير عذاب .(@)(@@) < <(@)(@@) | يونس : ( 99 ) ولو شاء ربك . . . . .(@)(@@) > > @QB@ أفأنت تكره الناس حتى يكونوا مؤمنين @QE@ أي : لا تستطيع فعل ذلك إنما | يؤمن من يريد الله - عز وجل - أن يؤمن .(@)(@@) سورة يونس من الآية ( 100 ) إلى الآية ( 104 ) .(@)(@@) < <(@)(@@) | يونس : ( 100 ) وما كان لنفس . . . . .(@)(@@) > > @QB@ وما كان لنفس أن تؤمن إلا بإذن الله ويجعل الرجس على الذين لا يعقلون @QE@ يعني : رجاسة الكفر .(@)(@@) < <(@)(@@) | يونس : ( 101 ) قل انظروا ماذا . . . . .(@)(@@) > > @QB@ قل انظروا ماذا في السماوات @QE@ من شمسها وقمرها ونجومها ، وما فيها من | العجائب @QB@ والأرض @QE@ من بحارها وشجرها وجبالها ؛ ففي 
ms265	 هذه آيات وحجج | عظام @QB@ وما تغني الآيات والنذر عن قوم لا يؤمنون @QE@ إذا لم يقبلوها ، ويتفكروا | فيها . < <(@)(@@) | يونس : ( 102 ) فهل ينتظرون إلا . . . . .(@)(@@) > > @QB@ فهل ينتظرون إلا مثل أيام الذين خلوا من قبلهم @QE@ يعني : وقائع الله - | عز وجل - في الأمم السالفة التي أهلكهم بها حين كذبوا رسلهم .(@)(@@) @QB@ قل فانتظروا إني معكم من المنتظرين @QE@ أي : سينزل بكم ما نزل بهم ؛ | أخر الله - عز وجل - عذاب آخر كفار هذه الآمة إلى ( ل 143 ) النفخة الأولى | PageV02P274 | بها يكون هلاكهم ، ولم يهلكهم حين كذبوا النبي بعذاب الاستئصال ، كما | أهلك من قبلهم بعذاب الاستئصال ، فلم يبق منهم أحد .(@)(@@) < <(@)(@@) | يونس : ( 103 ) ثم ننجي رسلنا . . . . .(@)(@@) > > @QB@ ثم ننجي رسلنا والذين آمنوا @QE@ يقول : كنا إذا أهلكنا قوما أنجينا النبي | والمؤمنين ، الآية .(@)(@@) < <(@)(@@) | يونس : ( 104 ) قل يا أيها . . . . .(@)(@@) > > @QB@ قل يا أيها الناس إن كنتم في شك من ديني @QE@ يعني : المشركين @QB@ فلا أعبد الذين تعبدون من دون الله @QE@ الآية .(@)(@@) سورة يونس من الآية ( 105 ) إلى الآية ( 109 ) .(@)(@@) < <(@)(@@) | يونس : ( 106 ) ولا تدع من . . . . .(@)(@@) > > @QB@ وأن أقم وجهك @QE@ أي : وجهتك إلى قوله عز وجل : @QB@ فإن فعلت فإنك إذا من الظالمين @QE@ أي : ولست فاعلا .(@)(@@) < <(@)(@@) | يونس : ( 108 ) قل يا أيها . . . . .(@)(@@) > > @QB@ يا أيها الناس قد جاءكم الحق من ربكم @QE@ يعني : القرآن @QB@ فمن اهتدى فإنما يهتدي لنفسه ومن ضل فإنما يضل عليها @QE@ وهي كقوله عز وجل : @QB@ من عمل صالحا فلنفسه ومن أساء فعليها @QE@ .(@)(@@) @QB@ وما أنا عليكم بوكيل @QE@ بحفيظ لأعمالكم ؛ حتى أجازيكم بها ، إنما أنا | PageV02P275 | منذر أبلغكم رسالة ربي .(@)(@@) < <(@)(@@) | يونس : ( 109 ) واتبع ما يوحى . . . . .(@)(@@) > > @QB@ واصبر @QE@ على ما يقول لك المشركون @QB@ حتى يحكم الله @QE@ فيأمرك بالهجرة | والجهاد @QB@ وهو خير @QE@ أفضل @QB@ الحاكمين @QE@ . | * * * | PageV02P276 | <(@)(@@) > تفسير سورة هود وهي مكية كلها <(@)(@@) >(@)(@@) سورة هود من الآية ( 1 ) إلى الآية ( 4 ) .(@)(@@) < <(@)(@@) | هود : ( 1 ) الر كتاب أحكمت . . . . .(@)(@@) > > قوله عز اسمه : ^ ( آلر كتب ) ^ أي : هذا كتاب @QB@ أحكمت آياته @QE@ يعني : | القرآن @QB@ ثم فصلت @QE@ بينت ؛ بين فيها حلاله وحرامه وطاعته ومعصيته @QB@ من لدن @QE@ من عند @QB@ حكيم @QE@ أحكمه بعلمه @QB@ خبير @QE@ بأعمال العباد .(@)(@@) < <(@)(@@) | هود : ( 2 ) ألا تعبدوا إلا . . . . .(@)(@@) > > @QB@ ألا تعبدوا إلا الله إنني لكم منه 
ms266	 نذير @QE@ يقوله للنبي صلى الله عليه وسلم قل :(@)(@@) لا تعبدوا | إلا الله ؛ إنني لكم منه نذير ؛ أنذركم عقابه إن لم تؤمنوا @QB@ وبشير @QE@ بالجنة لمن | آمن .(@)(@@) < <(@)(@@) | هود : ( 3 ) وأن استغفروا ربكم . . . . .(@)(@@) > > @QB@ وأن استغفروا ربكم @QE@ من الشرك .(@)(@@) @QB@ يمتعكم متاعا حسنا إلى أجل مسمى @QE@ يعني : الموت ، ولا يهلكهم | بالعذاب .(@)(@@) @QB@ ويؤت كل ذي فضل فضله @QE@ كقوله : @QB@ ولكل درجات مما عملوا @QE@ | @QB@ وإن تولوا @QE@ عن هذا القرآن ، فيكذبوا به @QB@ فإني أخاف عليكم عذاب يوم كبير @QE@ . | PageV02P277(@)(@@) سورة هود من الآية ( 5 ) فقط .(@)(@@) < <(@)(@@) | هود : ( 5 ) ألا إنهم يثنون . . . . .(@)(@@) > > @QB@ ألا إنهم يثنون صدورهم ليستخفوا منه @QE@ .(@)(@@) قال الحسن : يثنون صدورهم على ما هم عليه من الكفر ؛ ليستخفوا منه | بذلك ؛ يظنون أن الله - عز وجل - لا يعلم الذي يستخفون به . قال بعضهم : | هم المنافقون .(@)(@@) قال محمد : معنى @QB@ يثنون صدورهم @QE@ : يطوون ما فيها ويسترونه .(@)(@@) @QB@ ألا حين يستغشون ثيابهم يعلم ما يسرون وما يعلنون @QE@ قال محمد : معنى | @QB@ يستغشون ثيابهم @QE@ : يستترون بها ؛ يقال : استغشيت ثوبي وتغشيته .(@)(@@) سورة هود من الآية ( 6 ) فقط .(@)(@@) < <(@)(@@) | هود : ( 6 ) وما من دابة . . . . .(@)(@@) > > ^ ( ويعلم مستقرها ومستودعها ) تفسير ابن مسعود : مستقرها : الأرحام ، | ومستودعها : الأرض التي يموت فيها .(@)(@@) يحيى : عن صاحب له ، عن الحسن بن دينار ، عن إسماعيل بن أبي خالد ، | عن قيس بن أبي حازم ، عن ابن مسعود قال :(@)(@@) إذا أراد الله - عز وجل - أن | يقبض عبدا بأرض جعل له بها حاجة ؛ فإذا كان يوم القيامة قالت الأرض : رب | هذا ما استودعتني ' . | PageV02P278(@)(@@) سورة هود من الآية ( 7 ) فقط . | PageV02P279(@)(@@) < <(@)(@@) | هود : ( 7 ) وهو الذي خلق . . . . .(@)(@@) > > ^ ( ليبولكم ) ^ ليختبركم بالأمر والنهي @QB@ أيكم أحسن عملا @QE@ فيما ابتلاكم به | من الأمر والنهي .(@)(@@) قال محمد : المعنى : يختبركم الاختبار الذي يجازيكم عليه ؛ وهو قد علم | قبل ذلك أيهم أحسن عملا .(@)(@@) سورة هود من الآية ( 8 ) إلى الآية ( 12 ) .(@)(@@) < <(@)(@@) | هود : ( 8 ) ولئن أخرنا عنهم . . . . .(@)(@@) > > @QB@ ولئن أخرنا عنهم العذاب إلى أمة معدودة @QE@ أي : إلى حين معدود . | PageV02P280(@)(@@) قال محمد : يقال : إنما سمى الحين أمة ؛ لأن آلأمة من الناس تنقرض في | حين .(@)(@@) ^ ( ليقولون ما يحبسه ) ^ قال الله - عز وجل - : @QB@ ألا يوم يأتيهم ليس 
ms267	 مصروفا عنهم @QE@ أي : ليس يستطيع أحد أن يصرفه عنهم @QB@ وحاق بهم @QE@ أحاط | بهم ^ ( ما كانوا به يستهزئون ) ^ يعني : عذاب الآخرة ؛ في تفسير الكلبي .(@)(@@) < <(@)(@@) | هود : ( 9 ) ولئن أذقنا الإنسان . . . . .(@)(@@) > > @QB@ ولئن أذقنا الإنسان @QE@ يعني : المشرك @QB@ منا رحمة @QE@ يعني : صحة وسعة في | الرزق ^ ( ثم نزعناها منه إنه ليئوس ) ^ من رحمة الله ( ل 144 ) أن تصل إليه | فيصيبه رخاء بعد شدة @QB@ كفور @QE@ لنعمة الله تعالى .(@)(@@) < <(@)(@@) | هود : ( 10 ) ولئن أذقناه نعماء . . . . .(@)(@@) > > @QB@ ولئن أذقناه نعماء بعد ضراء مسته @QE@ أي : عافيناه من تلك الضراء التي | نزلت به @QB@ ليقولن ذهب السيئات عني @QE@ ذهب الضر عني @QB@ إنه لفرح @QE@ بالدنيا | @QB@ فخور @QE@ يقول : ليست له حسبة عند ضراء ، ولا شكر عند سراء < <(@)(@@) | هود : ( 11 ) إلا الذين صبروا . . . . .(@)(@@) > > @QB@ إلا الذين صبروا وعملوا الصالحات @QE@ استثنى الله - عز وجل - أهل الإيمان ؛ | أي : أنهم لا يفعلون الذي بين من فعل المشركين .(@)(@@) < <(@)(@@) | هود : ( 12 ) فلعلك تارك بعض . . . . .(@)(@@) > > @QB@ فلعلك تارك بعض ما يوحى إليك @QE@ خاطب بهذا النبي ؛ فلا تبلغ عني | مخافة قومك @QB@ وضائق به صدرك أن يقولوا @QE@ بأن يقولوا @QB@ لولا أنزل عليه كنز @QE@ هلا أنزل عليه مال ؛ فإنه فقير @QB@ أو جاء معه ملك @QE@ فيخبرنا أنه رسول | ^ ( إنما أنت نذير والله على كل شيء وكيل ) ^ حفيظ لأعمالهم ؛ حتى يجازيهم | بها . | PageV02P281(@)(@@) سورة هود من الآية ( 13 ) إلى الآية ( 14 ) .(@)(@@) < <(@)(@@) | هود : ( 13 ) أم يقولون افتراه . . . . .(@)(@@) > > @QB@ أم يقولون افتراه @QE@ افترى محمد القرآن : اختلقه ؛ أي : قد قالوا ذلك .(@)(@@) @QB@ قل فأتوا بعشر سور مثله مفتريات وادعوا من استطعتم من دون الله @QE@ | أي : استعينوا من أطاعكم من دون الله .(@)(@@) < <(@)(@@) | هود : ( 14 ) فإن لم يستجيبوا . . . . .(@)(@@) > > @QB@ فإن لم يستجيبوا لكم @QE@ فيأتوا بعشر سور مثله ، ولن يفعلوا @QB@ فاعلموا أنما أنزل بعلم الله @QE@ أي : من عند الله .(@)(@@) سورة هود من الآية ( 15 ) إلى الآية ( 16 ) .(@)(@@) < <(@)(@@) | هود : ( 15 ) من كان يريد . . . . .(@)(@@) > > @QB@ من كان يريد الحياة الدنيا وزينتها @QE@ يعني : المشرك لا يؤمن بالآخرة(@)(@@) @QB@ نوف إليهم أعمالهم فيها @QE@ يعني : جزاء حسناتهم @QB@ وهم فيها لا يبخسون @QE@ | لا ينقصون حسناتهم التي عملوا .(@)(@@) < <(@)(@@) | هود : ( 16 ) أولئك الذين ليس . . . . .(@)(@@) > > @QB@ وحبط ما صنعوا فيها @QE@ بطل ما 
ms268	 عملوا في الدنيا من حسنات في الآخرة ؛ | لأنهم جوزوا بها في الدنيا .(@)(@@) سورة هود من الآية ( 17 ) فقط . | PageV02P282(@)(@@) < <(@)(@@) | هود : ( 17 ) أفمن كان على . . . . .(@)(@@) > > @QB@ أفمن كان على بينة من ربه @QE@ أي : بيان ويقين ؛ يعني : محمدا عليه السلام @QB@ ويتلوه شاهد منه @QE@ تفسير الكلبي : جبريل شاهد من الله - عز وجل - @QB@ ومن قبله @QE@ من | قبل القرآن @QB@ كتاب موسى إماما ورحمة @QE@ يعني : لمن آمن به .(@)(@@) يقول : أفمن كان علي بينة من ربه ويتلوه شاهد منه ؛ هل يستوى هو ومن | يكفر بالقرآن والتوراة والإنجيل ؟ ! أي : أنهما لا يستويان عند الله عز وجل .(@)(@@) قال محمد : يجوز النصب في قوله : @QB@ إماما ورحمة @QE@ على الحال .(@)(@@) @QB@ أولئك يؤمنون به @QE@ يعني : المؤمنين يؤمنون بالقرآن @QB@ ومن يكفر به من الأحزاب @QE@ قال قتادة : يعني : اليهود والنصارى @QB@ فالنار موعده @QE@ @QB@ فلا تك في مرية منه @QE@ في شك أن من كفر به ؛ فالنار موعده .(@)(@@) سورة هود من الآية ( 18 ) إلى الآية ( 19 ) .(@)(@@) < <(@)(@@) | هود : ( 18 ) ومن أظلم ممن . . . . .(@)(@@) > > @QB@ ومن أظلم ممن افترى على الله كذبا @QE@ أي : لا أحد أظلم منه ؛ وافتراؤهم | على الله - تعالى - أن قالوا إن الله - عز وجل - أمرهم بما هم عليه من | عبادة الأوثان ، وتكذيبهم بمحمد . @QB@ أولئك يعرضون على ربهم ويقول الأشهاد @QE@ الأنبياء @QB@ هؤلاء الذين كذبوا على ربهم @QE@ الآية .(@)(@@) سورة هود من الآية ( 20 ) إلى الآية ( 22 ) . | PageV02P283(@)(@@) < <(@)(@@) | هود : ( 20 ) أولئك لم يكونوا . . . . .(@)(@@) > > @QB@ أولئك لم يكونوا معجزين في الأرض @QE@ يسبقونا حتى لا نبعثهم ، ثم | نعذبهم . @QB@ وما كان لهم من دون الله من أولياء @QE@ يمنعونهم من عذاب الله .(@)(@@) @QB@ يضاعف لهم العذاب @QE@ في النار @QB@ ما كانوا يستطيعون السمع @QE@ سمع | الهدى ؛ يعني : سمع قبول إذ كانوا في الدنيا @QB@ وما كانوا يبصرون @QE@ الهدى .(@)(@@) < <(@)(@@) | هود : ( 21 ) أولئك الذين خسروا . . . . .(@)(@@) > > ^ ( وضل عنهم ما كانوا يفترون ) 6 يعني : أوثانهم ضلت عنهم ؛ فلم تغن | عنهم شيئا < <(@)(@@) | هود : ( 22 ) لا جرم أنهم . . . . .(@)(@@) > > ^ ( لا جرم أنهم في الآخرة هم الأخسرون ) ^ ( لا جرم ) كلمة وعيد .(@)(@@) قال محمد : جاء عن ابن عباس ؛ أنه كان يقول : معناها : حقا . وذكر | الزجاج عن سيبويه أنه قال : ( جرم ) معناها : حق ، ودخلت 
ms269	 لا للنفي ، كأن | المعنى : لا ينفعهم ذلك حق أن لهم النار .(@)(@@) وأنشد [ . . . ] |(@)(@@) % ولقد طعنت أبا عيينة طعنة % جرمت فزارة بعدها أن يغضبوا ) ^(@)(@@) يقول : [ أحقت الطعنة فزارة ] الغضب .(@)(@@) قال محمد : وأنشد قطرب : جرمت ( فزارة بعدها أن يغضبوا ) . | PageV02P284(@)(@@) ( ل 145 ) حق لهم الغضب .(@)(@@) سورة هود من الآية ( 23 ) إلى الآية ( 24 ) * .(@)(@@) < <(@)(@@) | هود : ( 23 ) إن الذين آمنوا . . . . .(@)(@@) > > @QB@ وأخبتوا إلى ربهم @QE@ أي : أنابوا مخلصين : < <(@)(@@) | هود : ( 24 ) مثل الفريقين كالأعمى . . . . .(@)(@@) > > @QB@ مثل الفريقين كالأعمى والأصم والبصير والسميع هل يستويان مثلا @QE@ أي لا يستويان مثل الكافر مثل | الأعمى والأصم ؛ لأنه أعمى أصم عن الهدى ، والبصير والسميع مثل | المؤمن ؛ لأنه أبصر الهدى وسمعه ؛ يقول : فكما لا يستوي عندكم الأعمى | والأصم والبصير والسميع في الدنيا ؛ فكذلك لا يستويان عند الله في الدين .(@)(@@) سورة هود من الآية ( 25 ) إلى الآية ( 28 ) .(@)(@@) < <(@)(@@) | هود : ( 27 ) فقال الملأ الذين . . . . .(@)(@@) > > @QB@ وما نراك اتبعك إلا الذين هم أراذلنا @QE@ سفلتنا @QB@ بادي الرأي @QE@ أي : فيما | يظهر لنا @QB@ وما نرى لكم علينا من فضل @QE@ في الدين @QB@ بل نظنكم كاذبين @QE@ | يعنون : نوحا ومن آمن معه .(@)(@@) < <(@)(@@) | هود : ( 28 ) قال يا قوم . . . . .(@)(@@) > > @QB@ قال يا قوم أرأيتم إن كنت على بينة من ربي @QE@ على بيان @QB@ وآتاني رحمة من عنده @QE@ يعني بالرحمة : النبوة @QB@ فعميت عليكم @QE@ أن تبصروها بقلوبكم | PageV02P285 | وتقبلوها @QB@ أنلزمكموها وأنتم لها كارهون @QE@ .(@)(@@) سورة هود من الآية ( 29 ) إلى الآية ( 31 ) .(@)(@@) < <(@)(@@) | هود : ( 29 ) ويا قوم لا . . . . .(@)(@@) > > @QB@ ويا قوم لا أسألكم عليه @QE@ يعني : على ما أدعوكم إليه من الهدى @QB@ مالا @QE@ | فإنما يحملكم على ترك الهدى المال الذي أسألكموه .(@)(@@) @QB@ إن أجري @QE@ ثوابي ^ ( إلا على الله وما أنا بطارد الذين آمنوا إنهم ملاقو | ربهم ) ^ فيحاسبهم بأعمالهم .(@)(@@) < <(@)(@@) | هود : ( 31 ) ولا أقول لكم . . . . .(@)(@@) > > @QB@ ولا أقول لكم عندي خزائن الله @QE@ أي : خزائن علم الله ^ ( و لا أقول للذين | تزدري أعينكم ) ^ .(@)(@@) قال محمد : ( تزدري ) أي : تستقل وتستخس .(@)(@@) @QB@ لن يؤتيهم الله خيرا @QE@ في العاقبة ؛ أي : أنه سيؤتيهم بذلك خيرا ؛ إن | كانت قلوبهم صادقة .(@)(@@) سورة هود من الآية ( 32 ) إلى الآية ( 37 ) . | PageV02P286(@)(@@) < <(@)(@@) | هود : ( 32 ) قالوا يا نوح . . . . .(@)(@@) > > @QB@ قالوا يا نوح قد جادلتنا 
ms270	 @QE@ ماريتنا @QB@ فأكثرت جدالنا @QE@ .(@)(@@) @QB@ إن كان الله يريد أن يغويكم @QE@ يضلكم .(@)(@@) قال محمد : ( يغويكم ) : أصله يهلككم ؛ تقول العرب : أغويت فلانا ؛ أي : | أهلكته ، ومنه قولهم : غوى الفصيل ؛ إذا فقد اللبن ، فمات .(@)(@@) < <(@)(@@) | هود : ( 35 ) أم يقولون افتراه . . . . .(@)(@@) > > @QB@ أم يقولون افتراه @QE@ إن محمدا افترى القرآن ^ ( قل إن افتريته فعلي إجرامي | وأنا بريء مما تجرمون ) ^ يقول : فعلي عملي ، وأنا بريء مما تعملون .(@)(@@) قال محمد : الإجرام : الإقدام على الذنب ؛ وهو مصدر أجرمت .(@)(@@) < <(@)(@@) | هود : ( 36 ) وأوحي إلى نوح . . . . .(@)(@@) > > @QB@ وأوحي إلى نوح أنه لن يؤمن من قومك إلا من قد آمن @QE@ قال قتادة : ذلك | حين دعا عليهم ؛ فقال : @QB@ رب لا تذر على الأرض من الكافرين ديارا @QE@ .(@)(@@) @QB@ فلا تبتئس @QE@ أي : لا تحزن لهم @QB@ بما كانوا يفعلون @QE@ .(@)(@@) < <(@)(@@) | هود : ( 37 ) واصنع الفلك بأعيننا . . . . .(@)(@@) > > @QB@ واصنع الفلك بأعيننا ووحينا @QE@ كما نأمرك بعملها @QB@ ولا تخاطبني @QE@ | تراجعني @QB@ في الذين ظلموا @QE@ أنفسهم بشركهم .(@)(@@) سورة هود من الآية ( 38 ) إلى الآية ( 40 ) . | PageV02P287(@)(@@) < <(@)(@@) | هود : ( 38 ) ويصنع الفلك وكلما . . . . .(@)(@@) > > @QB@ ويصنع الفلك @QE@ السفينة @QB@ وكلما مر عليه ملأ من قومه سخروا منه @QE@ عمل | نوح الفلك بيده ، فكان يمر عليه الملأ من قومه فيقولون له استهزاء به : | يا نوح ، بينما أنت تزعم أنك رسول رب العالمين إذ صرت نجارا .(@)(@@) @QB@ قال إن تسخروا منا فإنا نسخر منكم كما تسخرون @QE@ قال محمد : المعنى : | نستجهلكم كما تستجهلون .(@)(@@) قال يحيى :(@)(@@) وكان الرجل من قومه يأخذ بيد ابنه ، فيذهب به إلى نوح | فيقول : أي بني ، لا تطع هذا ؛ فإن أبي قد ذهب بي إليه وأنا مثلك فقال : أي | بني لا تطع هذا .(@)(@@) < <(@)(@@) | هود : ( 39 ) فسوف تعلمون من . . . . .(@)(@@) > > @QB@ فسوف تعلمون من يأتيه عذاب يخزيه @QE@ يعني : عذاب الدنيا @QB@ ويحل عليه عذاب مقيم @QE@ دائم .(@)(@@) < <(@)(@@) | هود : ( 40 ) حتى إذا جاء . . . . .(@)(@@) > > @QB@ حتى إذا جاء أمرنا @QE@ يعني : عذابنا @QB@ وفار التنور @QE@ ( التنور ) في تفسير | الحسن : الباب الذي يجتمع فيه ماء السفينة ، ففار منه الماء والسفينة على | الأرض ، فكان ذلك علامة لإهلاك القوم .(@)(@@) وقال بعضهم : التنور عين ماء كانت بالجزيرة ، يقال لها : التنور ، وبعضهم | يقول : كان التنور في أقصى داره .(@)(@@) سعيد : عن قتادة قال : كان 
ms271	 التنور أعلى الأرض . | PageV02P288(@)(@@) @QB@ قلنا احمل فيها من كل زوجين اثنين @QE@ أي : احمل زوجين اثنين من | ( ل 146 ) كل صنف ، الواحد : زوج ، والاثنان : زوجان ، فحمل فيها من | جميع ما خلق الله - عز وجل - من البهائم والهوام والسباع ودواب البر | والطير والشجر ، وشكوا إلى نوح في السفينة الزبل ؛ فأوحى الله - عز | وجل - إلى نوح أن يمسح بيده على ذنب الفيل ، ففعل فخرج منه خنزيران ، | فكانا يأكلان الزبل ، وشكوا إلى الله الفأرة فأوحى الله - عز وجل - إلى | الأسد - ألقى في قلبه - فعطس الأسد فخرج من منخريه سنوران ، فكانا | يأكلان الفأرة ، وشكوا إلى نوح عرامة الأسد ، فدعا عليه نوح فسلط الله - | عز وجل - عليه الحمى .(@)(@@) قال الحسن : وكان طول السفينة فيما بلغنا ألف ذراع ومائتي ذراع ، | وعرضها ستمائة ذراع .(@)(@@) يحيى : قال بعضهم : وكان رأسها مثل رأس الحمامة ، وذنبها كذنب الديك | مطبقة تسير ما بين الماءين : ماء السماء ، وماء الأرض .(@)(@@) قال يحيى : وبلغني أنه كان في السفينة ثلاثة أبواب : باب للسباع والطير ، | وباب للبهائم ، وباب للناس ، وفصل بين الرجال والنساء : بجسد آدم حمله | نوح معه . | PageV02P289(@)(@@) قوله عز وجل : @QB@ وأهلك إلا من سبق عليه القول @QE@ الغضب ؛ يعني : ابنه | @QB@ ومن آمن @QE@ أي : واحمل من آمن ، قال الله - عز وجل - : @QB@ وما آمن معه إلا قليل @QE@ قال السدي : يعني : ثمانين نفسا ؛ أربعون رجلا ، وأربعون امرأة .(@)(@@) قال قتادة : . لم ينج في السفينة إلا نوح وامرأته وثلاثة بنين له : سام وحام | ويافث ؛ ونساؤهم ؛ فجميعهم ثمانية .(@)(@@) سورة هود من الآية ( 41 ) إلى الآية ( 45 ) .(@)(@@) < <(@)(@@) | هود : ( 41 ) وقال اركبوا فيها . . . . .(@)(@@) > > @QB@ وقال اركبوا فيها بسم الله مجراها ومرساها @QE@ قال قتادة : قد بين الله - عز | وجل - كل ما تقولون ؛ إذا ركبتم في البر ، وإذا ركبتم في البحر ؛ إذا ركبتم | في البر قلتم : @QB@ سبحان الذي سخر لنا هذا وما كنا له مقرنين @QE@ وإذا ركبتم | في البحر قلتم : @QB@ بسم الله مجراها ومرساها @QE@ .(@)(@@) قال محمد : من قرأ : ^ ( باسم الله مجراها ومرساها ) ^ بضم الميمين | جميعا فمعنى ذلك : بالله إجراؤها ، وبالله إرساؤها ؛ يقال : جرت السفينة | PageV02P290 | وأجريتها أنا مجرى وإجراء في 
ms272	 معنى واحد ، ورست وأرسيتها مرسى | وإرساء .(@)(@@) < <(@)(@@) | هود : ( 43 ) قال سآوي إلى . . . . .(@)(@@) > > @QB@ قال لا عاصم اليوم من أمر الله إلا من رحم @QE@ يعني : الذين كانوا في | السفينة .(@)(@@) قال محمد : @QB@ لا عاصم @QE@ في معنى : لا معصوم ؛ كما قالوا : ماء | [ دافق ] بمعنى مدفوق .(@)(@@) < <(@)(@@) | هود : ( 44 ) وقيل يا أرض . . . . .(@)(@@) > > @QB@ وغيض الماء @QE@ أي : نقص .(@)(@@) قال محمد : يقال : غاض الماء يغيض إذا غاب في الأرض .(@)(@@) وقرأ بعضهم ( غيض الماء ) بإشمام الضم في الغين ، ومن قرأ بهذا أراد | الأصل فعل ، ومن كسر فللياء التي بعد فاء الفعل .(@)(@@) @QB@ وقضي الأمر @QE@ فرغ منه ؛ يعني : هلاك قوم نوح .(@)(@@) @QB@ واستوت على الجودي @QE@ جبل بالجزيرة .(@)(@@) قال قتادة :(@)(@@) وبلغني أن السفينة لما أرادت أن تقف ، تطاولت لها الجبال كل | جبل منها يحب أن تقف عليه ، وتواضع الجودى ، فجاءت حتى وقفت | عليه ، وأبقاها الله - عز وجل - عبرة وآية حتى نظر إليها أوائل هذه الأمة ، PageV02P291 | وبلغني أنها استقلت بهم في عشر خلون من رجب ، وكانت في الماء خمسين | ومائة يوما ، واستقرت بهم على الجودي شهرا ، وأهبطوا إلى الأرض في عشر | خلون من المحرم .(@)(@@) قال قتادة :(@)(@@) وذكر لنا أن نوحا عليه السلام بعث الغراب لينظر إلى الماء ؛ فوجد | جيفة فوقع عليها ، فبعث إليه [ الحمامة ] فأتته بورق زيتون ، فأعطيت الطوق | الذي في عنقها وخضاب رجليها .(@)(@@) سورة هود من الآية ( 46 ) إلى الآية ( 48 ) .(@)(@@) < <(@)(@@) | هود : ( 46 ) قال يا نوح . . . . .(@)(@@) > > @QB@ قال يا نوح إنه ليس من أهلك @QE@ الذين وعدتك أن أنجيهم ، وكان ( ابنه ) | يظهر الإيمان ويسر الشرك ، ونوح لا يعلم ؛ في تفسير الحسن . قال الحسن : | ولولا ذلك لم يناده ؛ وهو يعلم أن الله - عز وجل - مغرق الكفار ، وأنه قضى | أنه إذا نزل العذاب على قوم كذبوا رسولهم ثم آمنوا ، لم يقبل منهم .(@)(@@) @QB@ إنه عمل غير صالح @QE@ يقول : إن سؤالك إياي ما ليس لك به علم عمل | غير صالح ( ل 147 ) @QB@ فلا تسألن ما ليس لك به علم @QE@ قال الحسن أي : أنك | لم تكن تعلم ما يسر من النفاق . | PageV02P292(@)(@@) يحيى : عن حماد ، عن ثابت البناني ، عن شهر بن حوشب ، عن 
ms273	 أسماء | بنت يزيد الأنصارية قالت :(@)(@@) سمعت رسول الله صلى الله عليه وسلم يقرأ هذا الحرف : @QB@ إنه عمل غير صالح @QE@ ' . | PageV02P293(@)(@@) < <(@)(@@) | هود : ( 48 ) قيل يا نوح . . . . .(@)(@@) > > @QB@ قيل يا نوح اهبط بسلام منا @QE@ يعني : سلامة من الغرق .(@)(@@) @QB@ وبركات عليك وعلى أمم ممن معك @QE@ يعني : نسول من كان معه في | السفينة @QB@ وأمم سنمتعهم @QE@ في الدنيا يعني : أمما من نسول من كان معه في | السفينة .(@)(@@) سورة هود من الآية ( 49 ) إلى الآية ( 52 ) .(@)(@@) < <(@)(@@) | هود : ( 49 ) تلك من أنباء . . . . .(@)(@@) > > @QB@ تلك من أنباء الغيب نوحيها إليك @QE@ يقول للنبي صلى الله عليه وسلم حين انقضت قصة | نوح : تلك من أخبار الغيب ، يعني : ما قص عليه @QB@ ما كنت تعلمها أنت ولا قومك @QE@ يعني : قريشا @QB@ من قبل @QE@ هذا القرآن @QB@ فاصبر @QE@ على قولهم : إنك | مجنون ؛ وغير ذلك مما كانوا يقولونه له .(@)(@@) < <(@)(@@) | هود : ( 50 ) وإلى عاد أخاهم . . . . .(@)(@@) > > @QB@ وإلى عاد أخاهم هودا @QE@ يقول : وأرسلنا إلى عاد أخاهم هودا ، أخوهم في | النسب ، وليس بأخيهم في الدين . | PageV02P294(@)(@@) @QB@ فقال يا قوم اعبدوا الله @QE@ وحدوا الله @QB@ ما لكم من إله غيره إن أنتم إلا مفترون @QE@ كل من عبد غير الله - سبحانه - فقد افترى الكذب على الله - | تعالى - لأن الله - عز وجل - أمر العباد أن يعبدوه ولا يشركوا به شيئا .(@)(@@) قال محمد : ( غيره ) مرفوع على معنى : ما لكم إله غيره .(@)(@@) < <(@)(@@) | هود : ( 52 ) ويا قوم استغفروا . . . . .(@)(@@) > > @QB@ يرسل السماء عليكم مدرارا @QE@ أي : يوسع لكم من الرزق ، وإنما أرزاق | العباد من المطر .(@)(@@) قال محمد : معنى ( مدرارا ) ^ المبالغة ، ونصبه على الحال ؛ كأنه قال : | يرسل السماء عليكم دارة .(@)(@@) وذكر بعض المفسدين : أنه كان أصابهم جدب .(@)(@@) ^ ( ويزدكم قوة إلى قوتكم ) ^ قال مجاهد : يعني شدة إلى شدتكم أي : في | أبدانكم .(@)(@@) سورة هود من الآية ( 53 ) إلى الآية ( 57 ) . | PageV02P295(@)(@@) < <(@)(@@) | هود : ( 54 ) إن نقول إلا . . . . .(@)(@@) > > ^ ( إنه نقول إلا اعتراك ) ^ أصابك @QB@ بعض آلهتنا بسوء @QE@ أي : بجنون ؛ لأنك | عبتها ؛ يعنون : أوثانهم @QB@ فكيدوني جميعا @QE@ أنتم وأوثانكم - أي : اجهدوا | جهدكم < <(@)(@@) | هود : ( 55 ) من دونه فكيدوني . . . . .(@)(@@) > > @QB@ ثم لا تنظرون @QE@ طرفة عين ؛ إن الله - عز وجل - سيمنعني منكم ؛ | قال هذا وقد علم أن 
ms274	 الأوثان لا تقدر على أن تكيد ، وأنها لا تضر ولا تنفع | < <(@)(@@) | هود : ( 56 ) إني توكلت على . . . . .(@)(@@) > > @QB@ ما من دابة إلا هو آخذ بناصيتها @QE@ أي : هي في قبضته وقدرته .(@)(@@) سورة هود من الآية ( 58 ) إلى الآية ( 60 ) .(@)(@@) < <(@)(@@) | هود : ( 59 ) وتلك عاد جحدوا . . . . .(@)(@@) > > @QB@ واتبعوا أمر كل جبار عنيد @QE@ أي : واتبع بعضهم بعضا على الكفر ، | والعنيد : المجتنب للهدى المعاند له .(@)(@@) قال محمد : العنيد أصله في اللغة : الجائر ، والعند عند العرب : الجانب ، | فقيل للجائر : عنيد من هذا ؛ لأنه مجانب للقصد .(@)(@@) < <(@)(@@) | هود : ( 60 ) وأتبعوا في هذه . . . . .(@)(@@) > > @QB@ واتبعوا @QE@ ألحقوا @QB@ في هذه الدنيا لعنة @QE@ يعني : العذاب الذي عذبهم به | @QB@ ويوم القيامة @QE@ أي : ولهم يوم القيامة أيضا لعنة ؛ يعني : عذاب جهنم @QB@ ألا بعدا لعاد قوم هود @QE@ .(@)(@@) قال محمد : ( بعدا ) نصب على معنى : أبعدهم الله ، فبعدوا بعدا ؛ أي : | من رحمة الله PageV02P296(@)(@@) < <(@)(@@) | هود : ( 61 ) وإلى ثمود أخاهم . . . . .(@)(@@) > > @QB@ هو أنشأكم من الأرض @QE@ يريد الخلق الأول خلق آدم @QB@ واستعمركم فيها @QE@ | أي : جعلكم عمارها @QB@ إن ربي قريب مجيب @QE@ قريب ممن دعاه ، مجيب له .(@)(@@) سورة هود من الآية ( 61 ) إلى الآية ( 68 ) .(@)(@@) < <(@)(@@) | هود : ( 62 ) قالوا يا صالح . . . . .(@)(@@) > > @QB@ قالوا يا صالح قد كنت فينا مرجوا قبل هذا @QE@ أي : كنا نرجو ألا تشتم | آلهتنا ، ولا تعبد غيرها .(@)(@@) @QB@ وإننا لفي شك مما تدعونا إليه مريب @QE@ من الريبة .(@)(@@) < <(@)(@@) | هود : ( 63 ) قال يا قوم . . . . .(@)(@@) > > @QB@ فما تزيدونني غير تخسير @QE@ نقصان ؛ إن أجبتكم إلى ما تدعونني إليه .(@)(@@) < <(@)(@@) | هود : ( 64 ) ويا قوم هذه . . . . .(@)(@@) > > @QB@ ويا قوم هذه ناقة الله لكم آية @QE@ قال محمد : نصب ( آية ) على الحال ؛ | PageV02P297 | كأنه قال : انتبهوا لها في هذه الحال .(@)(@@) @QB@ ولا تمسوها بسوء @QE@ أي : لا تعقروها @QB@ فيأخذكم عذاب قريب > 2 @QB@ <(@)(@@) | هود : ( 65 ) فعقروها فقال تمتعوا . . . . .(@)(@@) > > @QB@ فعقروها فقال تمتعوا في داركم ثلاثة أيام ذلك وعد غير مكذوب @QE@ فقالوا له : ما آية | ذلك حتى نعلم أنك صادق ؟ فقال : آية ذلك أن وجوهكم تصبح أول يوم | مصفرة ، واليوم الثاني محمرة ، واليوم الثالث مسودة ، فلما كان ذلك عرفوا أنه | العذاب ، فتحنطوا وتكفنوا ، فلما أمسوا بقوا في [ . . . ] ثم صبحهم | العذاب في اليوم الرابع .(@)(@@) < <(@)(@@) | هود 
ms275	 : ( 67 ) وأخذ الذين ظلموا . . . . .(@)(@@) > > قال : @QB@ وأخذ الذين ظلموا الصيحة @QE@ ( ل 148 ) قال السدي : يعني : صيحة | جبريل عليه السلام @QB@ فأصبحوا في ديارهم جاثمين @QE@ أي : قد هلكوا .(@)(@@) < <(@)(@@) | هود : ( 68 ) كأن لم يغنوا . . . . .(@)(@@) > > @QB@ كأن لم يغنوا فيها @QE@ أي : لم يعيشوا .(@)(@@) قال محمد : وقيل كأن لم ينزلوا فيها .(@)(@@) سورة هود من الآية ( 69 ) إلى الآية ( 73 ) .(@)(@@) < <(@)(@@) | هود : ( 69 ) ولقد جاءت رسلنا . . . . .(@)(@@) > > @QB@ ولقد جاءت رسلنا إبراهيم بالبشرى @QE@ قال قتادة : بإسحاق @QB@ قالوا سلاما قال سلام @QE@ PageV02P298(@)(@@) قال محمد : ( سلاما ) منصوب على معنى : سلمنا سلاما ، وأما ( سلام ) | فمرفوع على معنى : أمري سلام .(@)(@@) @QB@ فما لبث أن جاء بعجل حنيذ @QE@ مشوي < <(@)(@@) | هود : ( 70 ) فلما رأى أيديهم . . . . .(@)(@@) > > @QB@ فلما رأى أيديهم لا تصل إليه نكرهم @QE@ أنكرهم @QB@ وأوجس منهم خيفة @QE@ أي : أضمر خوفا إذ لم يأكلوا | ^ ( فقالوا لا تخف إنا أرسلنا إلى قوم لوط ) ^ لنهلكهم < <(@)(@@) | هود : ( 71 ) وامرأته قائمة فضحكت . . . . .(@)(@@) > > @QB@ وامرأته قائمة @QE@ يعني : | سارة امرأة إبراهيم @QB@ فضحكت @QE@ قال الكلبي : لما رأت سارة فرق إبراهيم | عجبت من فرقه ، فضحكت وهي لا تدري من القوم ، فبشروها بإسحاق ، | وقالوا : نرجع إليك عاما قابلا ، وقد ولدت لإبراهيم غلاما اسمه : إسحاق ، | ويكون من وراء إسحاق يعقوب ؛ أي : من بعد إسحاق .(@)(@@) < <(@)(@@) | هود : ( 72 ) قالت يا ويلتى . . . . .(@)(@@) > > @QB@ قالت يا ويلتى أألد وأنا عجوز وهذا بعلي شيخا @QE@ وكانت قد قعدت عن | الولد ^ ( إن هذا لشيء عجيب قالوا أتعجبين من أمر الله رحمة الله وبركاته | عليكم أهل البيت إنه حميد مجيد ) ^ مستحمد إلى خلقه ، مجيد كريم .(@)(@@) قال محمد : من قرأ ( يعقوب ) بالرفع فعلى معنى : ويعقوب يحدث لها | من وراء إسحاق ، ومن قرأ : ( هذا بعلي شيخا ) فعلى الحال ؛ المعنى : | PageV02P299 | انتبهوا له في هذه الحال .(@)(@@) سورة هود من الآية ( 74 ) إلى الآية ( 76 ) .(@)(@@) < <(@)(@@) | هود : ( 74 ) فلما ذهب عن . . . . .(@)(@@) > > @QB@ فلما ذهب عن إبراهيم الروع @QE@ الفرق @QB@ وجاءته البشرى @QE@ بإسحاق | @QB@ يجادلنا في قوم لوط @QE@ قال قتادة : وذكر لنا أن مجادلته إياهم أنه قال لهم : | أرأيتم إن كان فيهم خمسون من المؤمنين ، أمعذبوهم أنتم ؟ قالوا : لا . حتى | صار ذلك إلى عشرة ، قال : أرأيتم إن كان فيهم عشرة من 
ms276	 المؤمنين ، | أمعذبوهم أنتم ؟ قالوا : لا .(@)(@@) < <(@)(@@) | هود : ( 75 ) إن إبراهيم لحليم . . . . .(@)(@@) > > @QB@ إن إبراهيم لحليم أواه منيب @QE@ المنيب : المخلص ، وقد ذكرنا الأواه قبل | هذا .(@)(@@) < <(@)(@@) | هود : ( 76 ) يا إبراهيم أعرض . . . . .(@)(@@) > > @QB@ يا إبراهيم أعرض عن هذا @QE@ قال الكلبي : سأل إبراهيم ربه ألا يهلك لوطا | وأهله ، وأن يعفو عن قوم لوط ، فقيل : يا إبراهيم ، أعرض عن هذا @QB@ إنه قد جاء أمر ربك وإنهم آتيهم عذاب غير مردود @QE@ .(@)(@@) سورة هود من الآية ( 77 ) إلى الآية ( 83 ) . | PageV02P300(@)(@@) < <(@)(@@) | هود : ( 77 ) ولما جاءت رسلنا . . . . .(@)(@@) > > ^ ( ولما جاءت رسلنا لوطا سيء بهم ) ^ قال الحسن : ساءه دخولهم ؛ لما | تخوف عليهم من قومه ^ ( وضاق بهم ذرعا ) ^ قال الكلبي : لم يدر أين ينزلهم .(@)(@@) قال : وكان قوم لوط لا يؤون ضيفا بليل ، وكانوا يعترضون من مر بالطريق | نهارا للفاحشة ، فلما جاءت الملائكة لوطا حين أمسوا ، كرههم ولم يستطع | دفعهم ، فقال : ^ ( هذا يوم عصيب ) ^ شديد .(@)(@@) < <(@)(@@) | هود : ( 78 ) وجاءه قومه يهرعون . . . . .(@)(@@) > > ^ ( وجاءه قومه يهرعون إليه ) ^ أي : يسرعون .(@)(@@) قال محمد : يقال : أهرع الرجل ؛ أي : أسرع ؛ على لفظ ما لم يسم | فاعله . ^ ( ومن قبل كانوا يعملون السيئات ) ^ يعني : يأتون الرجال في | أدبارهم ؛ وكان لا يفعل ذلك بعضهم ببعض ، إنما كانوا يفعلونه بالغرباء ^ ( قال | يا قوم هؤلاء بناتي هن أطهر لكم ) ^ أحل لكم من الرجال ، قال قتادة : أمرهم | أن يتزوجوا النساء .(@)(@@) قال محمد : وذكر أبو عبيد عن مجاهد أنه قال : كل نبي أبو أمته ، وإنما | عنى ببناته : نساء أمته .(@)(@@) قال أبو عبيد : وهذا شبيه بما يروى عن قراءة أبي بن كعب :(@)(@@) النبي أولى | بالمؤمنين من أنفسهم وأزواجه أمهاتهم وهو أب لهم ' . | PageV02P301(@)(@@) ^ ( فاتقوا الله ولا تخزون في ضيفي ) ^ الضيف : يقال للواحد وللإثنين ، | ولأكثر من ذلك ^ ( أليس منكم رجل رشيد ) ^ .(@)(@@) < <(@)(@@) | هود : ( 79 ) قالوا لقد علمت . . . . .(@)(@@) > > ^ ( قالوا لقد علمت ما لنا في بناتك من حق ) ^ من حاجة ^ ( وإنك لتعلم ما | نريد ) ^ أي : إنا نريد أضيافك دون بناتك < <(@)(@@) | هود : ( 80 ) قال لو أن . . . . .(@)(@@) > > ^ ( قال لو أن لي بكم قوة أو آوي إلى | ركن شديد ) ^ قال قتادة : يعني : إلى عشيرة قوية ( ل 149 ) فدافعوه الباب 
ms277	 ، | وقالت الملائكة : ^ ( يا لوط إنا رسل ربك لن يصلوا إليك فأسر بأهلك بقطع | من الليل ) ^ أي : سر بهم في ظلمة من الليل ^ ( ولا يلتفت منكم أحد إلا امرأتك | إنه مصيبها ما أصابهم ) ^ فقال : لا ؛ بل أهلكوهم الساعة ! فقالوا : ^ ( إن | موعدهم الصبح أليس الصبح بقريب ) ^ فطمس جبريل عليه السلام أعينهم بأحد | جناحيه ، فبقوا ليلتهم لا يبصرون < <(@)(@@) | هود : ( 82 ) فلما جاء أمرنا . . . . .(@)(@@) > > ^ ( فلما جاء أمرنا جعلنا عاليها سافلها ) ^ قال : | فلما كان في السحر ، خرج لوط وأهله ، ورفع جبريل عليه السلام أرضهم بجناحه | الآخر ، حتى بلغ بها السماء الدنيا ؛ حتى سمعت الملائكة نباح كلابهم | وأصوات دجاجهم ، فقلبها عليهم ، وكان قد عهد إلى لوط ألا يلتفت منكم | أحد إلا امرأتك ؛ فلما سمعت العجوز - عجوز السوء - الهدة التفتت ، | فأصابها ما أصاب قومها ، ثم اتبعت الحجارة من كان خارجا من مدائنهم ، قال | قتادة : كانت ثلاثا .(@)(@@) قال الحسن : فلم يبعث الله - سبحانه - بعد لوط نبيا إلا في عز من قومه ، | وكانت امرأة لوط منافقة ، تظهر الإسلام ، وقلبها على الكفر .(@)(@@) ^ ( وأمطرنا عليها حجارة من سجيل ) ^ قال قتادة : من طين ^ ( منضود ) ^ أي : | PageV02P302 | بعضه على بعض < <(@)(@@) | هود : ( 83 ) مسومة عند ربك . . . . .(@)(@@) > > ^ ( مسومة عند ربك ) ^ قال الحسن : عليها سيما ؛ أنها | ليست من حجارة الدنيا ، وأنها من حجارة العذاب .(@)(@@) قال : وتلك السيما على الحجر منها مثل الخاتم ^ ( وما هي من الظالمين | ببعيد ) ^ يقول : وما هي من ظالمي أمتك يا محمد ببعيد أن يحصبهم بها .(@)(@@) يحيى : عن همام بن يحيى ، عن القاسم بن عبد الواحد ، عن عبد الله بن | محمد بن عقيل ، عن جابر بن عبد الله قال :(@)(@@) قال رسول الله صلى الله عليه وسلم : ' إن أكثر ما | أتخوف على أمتي عمل قوم لوط ' . | PageV02P303(@)(@@) سورة هود من الآية ( 84 ) إلى الآية ( 86 ) .(@)(@@) < <(@)(@@) | هود : ( 84 ) وإلى مدين أخاهم . . . . .(@)(@@) > > @QB@ وإلى مدين @QE@ أي : وأرسلنا إلى أهل مدين @QB@ أخاهم شعيبا @QE@ أخوهم في | النسب ، وليس بأخيهم في الدين .(@)(@@) ^ ( إني أراكم بخير ) ^ أي : بخير من الله ؛ يعني : السعة والرزق ، وكانوا | أصحاب تطفيف في الكيل ، ونقصان من الميزان .(@)(@@) < <(@)(@@) | هود : ( 85 
ms278	 ) ويا قوم أوفوا . . . . .(@)(@@) > > @QB@ ولا تبخسوا الناس أشياءهم @QE@ أي : لا تظلموا @QB@ ولا تعثوا في الأرض مفسدين @QE@ قد مضى تفسير @QB@ ولا تعثوا @QE@ في سورة البقرة .(@)(@@) < <(@)(@@) | هود : ( 86 ) بقية الله خير . . . . .(@)(@@) > > ^ ( بقية الله خير لكم ) ^ قال مجاهد : يعني : طاعة الله @QB@ وما أنا عليكم بحفيظ @QE@ أحفظ عليكم أعمالكم حتى أجازيكم بها .(@)(@@) سورة هود من الآية ( 87 ) إلى الآية ( 90 ) . | PageV02P304(@)(@@) < <(@)(@@) | هود : ( 87 ) قالوا يا شعيب . . . . .(@)(@@) > > ^ ( قالوا يا شعيب أصلاتك تأمرك أن نترك ما يعبد آباؤنا ) ^ يعنون : أوثانهم .(@)(@@) قال الحسن : لم يبعث الله - عز وجل - نبيا إلا فرض عليه الصلاة | والزكاة .(@)(@@) قال محمد : المعنى : أدينك يأمرك ؛ وهو معنى ما ذهب إليه الحسن .(@)(@@) ^ ( أو أن نفعل في أموالنا ما نشاء ) ^ أي : أو أن نترك أن نفعل .(@)(@@) ^ ( إنك لأنت الحليم الرشيد ) ^ أي : أنك لست بالحليم الرشيد .(@)(@@) < <(@)(@@) | هود : ( 88 ) قال يا قوم . . . . .(@)(@@) > > ^ ( ورزقني منه رزقا حسنا ) ^ يعني : النبوة .(@)(@@) ^ ( وما أريد أن أخالفكم إلى ما أنهاكم عنه ) ^ فأفعله < <(@)(@@) | هود : ( 89 ) ويا قوم لا . . . . .(@)(@@) > > ^ ( ويا قوم لا يجرمنكم | شقاقي ) ^ أي : لا تحملنكم عداوتي @QB@ أن يصيبكم @QE@ بكفركم بي من عذاب | الله - عز وجل - ^ ( مثل ما أصاب قوم نوح . . . ) ^ الآية .(@)(@@) قال محمد : ( يجر منكم ) أصله : يكسبنكم ؛ تقول : جرمت كذا ؛ بمعنى | كسبت ، وأنشد بعضهم : |(@)(@@) % طريد عشيرة ورهين ذنب % بما جرمت يدي وجنى لساني %(@)(@@) قوله عز وجل : ^ ( وما قوم لوط منكم بيعيد ) ^ يقول : العظة بقوم لوط قريبة | PageV02P305 | منكم ؛ لأن إهلاك قوم لوط كان أقرب الإهلاكات التي عرفوها .(@)(@@) < <(@)(@@) | هود : ( 90 ) واستغفروا ربكم ثم . . . . .(@)(@@) > > ^ ( إن ربي رحيم ) ^ لمن استغفره ، وتاب إليه ^ ( ودود ) ^ محب لأهل طاعته .(@)(@@) سورة هود من الآية ( 91 ) إلى الآية ( 95 ) .(@)(@@) < <(@)(@@) | هود : ( 91 ) قالوا يا شعيب . . . . .(@)(@@) > > ^ ( قالوا يا شعيب ما نفقه كثيرا مما تقول ) ^ أي : إنا لا نقبل ، وقد فهموه | وقامت عليهم به الحجة ^ ( وإنا لنراك فينا ضعيفا ) ^ قال سفيان : كان أعمى | ^ ( ولولا رهطك لرجمناك ) ^ ( ل 150 ) بالحجارة ^ ( وما أنت علينا بعزيز ) ^ | بعظيم ، وكان من أشرافهم .(@)(@@) < <(@)(@@) | هود : ( 92 ) قال يا قوم . . . . .(@)(@@) > > ^ ( قال يا قوم أرهطي أعز عليكم من الله واتخذتموه ، وراءكم ظهريا ) ^ قال | قتادة : يقول 
ms279	 : أعززتم قومكم ، وأظهرتم بربكم(@)(@@) قال يحيى : أراه يعني : جعلتموه منكم بظهر .(@)(@@) قال محمد : يقال : ظهرت بحاجة فلان ؛ إذا نبذتها ولم تعبأ بها ، ومنه | قول الفرزدق : | PageV02P306 |(@)(@@) % تميم بن زيد لا تكونن حاجتي % % بظهر فلا يعيى علي جوابها ) ^(@)(@@) قوله عز وجل : ^ ( إن ربي بما تعملون محيط ) ^ @QB@ خبير > 2 @QB@ <(@)(@@) | هود : ( 93 ) ويا قوم اعملوا . . . . .(@)(@@) > > ^ ( ويا قوم اعملوا على | مكانتكم ) ^ أي : على دينكم ^ ( إني عامل ) ^ على ديني ^ ( سوف تعلمون من يأتيه | عذاب يخزيه ومن هو كاذب وارتقبوا إني معكم رقيب ) ^ كقوله عز وجل : | ^ ( فانتظروا إني معكم من المنتظرين ) ^ يخوفهم أنهم إن ثبتوا على دينهم ، | جاءهم العذاب < <(@)(@@) | هود : ( 95 ) كأن لم يغنوا . . . . .(@)(@@) > > ^ ( ألا بعدا لمدين كما بعدت ثمود ) ^ .(@)(@@) قال محمد : المعنى : أنهم قد بعدوا من رحمة الله - تعالى - ونصب | ( بعدا ) على المصدر ؛ يقال : بعد - بكسر العين - يبعد ؛ إذا كان بعد | هلكة ، وبعد بضم العين يبعد بعدا ؛ إذا نأى .(@)(@@) سورة هود من الآية ( 96 ) إلى الآية ( 100 ) .(@)(@@) < <(@)(@@) | هود : ( 96 ) ولقد أرسلنا موسى . . . . .(@)(@@) > > ^ ( ولقد أرسلنا موسى بآياتنا ) ^ أي : بعلاماتنا التي تدل على صحة نبوته | ^ ( وسلطان مبين ) ^ حجة بينة . | PageV02P307(@)(@@) قال محمد : والسلطان إنما سمي سلطانا ؛ لأنه حجة الله - عز وجل - في | أرضه .(@)(@@) < <(@)(@@) | هود : ( 97 - 98 ) إلى فرعون وملئه . . . . .(@)(@@) > > ^ ( وما أمر فرعون برشيد يقدم قومه يوم القيامة ) ^ أي : يقودهم إلى النار ؛ | حتى يدخلها هو وقومه .(@)(@@) < <(@)(@@) | هود : ( 99 ) وأتبعوا في هذه . . . . .(@)(@@) > > @QB@ وأتبعوا في هذه @QE@ يعني : الدنيا @QB@ لعنه @QE@ يعني : العذاب الذي عذبهم به من | الغرق @QB@ ويوم القيامة @QE@ أي : وأتبعوا يوم القيامة لعنة ^ ( بئس الرفد المرفود ) ^ قال | عطاء : ترادفت عليهم من الله - عز وجل - لعنتان : لعنة بعد لعنة ؛ لعنة | الدنيا ، ولعنة الآخرة .(@)(@@) قال محمد : وقيل : المعنى : بئس العطاء المعطى .(@)(@@) < <(@)(@@) | هود : ( 100 ) ذلك من أنباء . . . . .(@)(@@) > > ^ ( ذلك من أنباء القرى نقصه عليك منها قائم ) ^ تراه قد هلك أهله ، ومنها | @QB@ حصيد @QE@ لا ترى له أثرا .(@)(@@) سورة هود من الآية ( 101 ) إلى الآية ( 107 ) .(@)(@@) < <(@)(@@) | هود : ( 101 ) وما ظلمناهم ولكن . . . . .(@)(@@) > > ^ ( وما زادوهم غير تتبيب ) ^ غير تخسير < <(@)(@@) | هود : ( 103 ) إن في ذلك . . . . .(@)(@@) > > ^ ( وذلك يوم مشهود ) ^ يشهده أهل | PageV02P308 | السماء 
ms280	 وأهل الأرض < <(@)(@@) | هود : ( 105 ) يوم يأت لا . . . . .(@)(@@) > > ^ ( فمنهم شقي وسعيد ) ^ .(@)(@@) يحيى : عن فطر ، عن أبي الطفيل قال :(@)(@@) سمعت عبد الله بن مسعود يقول : | قال رسول الله صلى الله عليه وسلم : ' إن خلق أحدكم يجمع في بطن أمه أربعين يوما نطفة ، | ثم يكون أربعين يوما علقة ، ثم يكون أربعين يوما مضغة ، ثم يبعث الملك | فيؤمر أن يكتب أربعا : رزقه وعمله وأجله وأثره ، وشقيا أو سعيدا . والذي لا | إله غيره ؛ إن العبد ليعمل بعمل أهل الجنة حتى لا يكون بينه وبين الجنة إلا | ذراع ؛ فيسبق عليه الكتاب فيعمل بعمل أهل النار حتى يدخلها ، وإن العبد | ليعمل بعمل أهل النار حتى لا يكون بينه وبين النار إلا ذراع ؛ فيسبق عليه | الكتاب فيعمل بعمل أهل الجنة فيدخلها ' .(@)(@@) < <(@)(@@) | هود : ( 106 ) فأما الذين شقوا . . . . .(@)(@@) > > قوله عز وجل : ^ ( فأما الذين شقوا ففي النار لهم فيها زفير وشهيق ) ^ قال | قتادة : هذا حين يقول الله - عز وجل - لهم : ^ ( اخسئوا فيها ولا تكلمون ) ^ | فينقطع كلامهم ؛ فما يتكلمون بعدها بكلمة إلا هواء الزفير والشهيق ؛ فشبه | أصواتهم بأصوات الحمير ؛ أولها زفير ، وآخرها شهيق .(@)(@@) قال محمد : اختلف القول في الزفير والشهيق : ذكر عن الخليل ؛ أنه | قال :(@)(@@) الشهيق رد النفس ، والزفير إخراج النفس . وقيل : الزفير صوت | المكروب بالأنين ، والشهيق أشد منه ارتفاعا . | PageV02P309(@)(@@) < <(@)(@@) | هود : ( 107 ) خالدين فيها ما . . . . .(@)(@@) > > ^ ( خالدين فيها ما دامت السموات والأرض ) ^ الجنة في السماء ، والنار في | الأرض ؛ وذلك ما لا ينقطع أبدا ^ ( إلا ما شاء ربك ) ^ يعني : ما سبقهم به الذين | دخلوا قبلهم ؛ قال : @QB@ وسيق الذين كفروا إلى جهنم زمرا @QE@ قال : زمرة | تدخل بعد الزمرة .(@)(@@) وفي تفسير السدي : إلا ما شاء ربك لأهل التوحيد . . الذين ( ل 151 ) | يدخلون النار ؛ فلا يدومون فيها يخرجون منها إلى الجنة .(@)(@@) سورة هود من الآية ( 108 ) إلى الآية ( 111 ) .(@)(@@) < <(@)(@@) | هود : ( 108 ) وأما الذين سعدوا . . . . .(@)(@@) > > ^ ( وأما الذين سعدوا . . . ) ^ إلى قوله عز وجل : ^ ( إلا ما شاء ربك ) ^ يعني : | ما سبقهم به الذين دخلوا قبلهم ؛ قال : @QB@ وسيق الذين اتقوا ربهم إلى الجنة زمرا @QE@ قال : زمرة تدخل بعد الزمرة .(@)(@@) وفي تفسير 