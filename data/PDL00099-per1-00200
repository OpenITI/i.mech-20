ms181	 را ظلام‌ گرفت %~% ز تاب مهر زمین رنگ سیم خام‌ گرفت(@)(@@) 2 شب سیاه چو دزدان ز تاب ماه‌کمند %~% به کف نهاد و همی راه کوی و بام گرفت(@)(@@) 3 به سام روز مگر نوح دهر نفرین کرد %~% که بی‌جنایت معهود رنگ حام‌گرفت(@)(@@) 4 چو یام گشت جدی‌غرقه چون ‌طلیعه صبح %~% نمود جودی وکشتی بر او مقام‌ گرفت(@)(@@) 5 طناب فکرتم آن شب چنان دراز کشید %~% که رفت و دامن این نیلگون خیام گرفت(@)(@@) 6 خیال خلق پیمبر گذشت در دل من %~% ز بوی مشک مرا عطسه در مشام گرفت(@)(@@) 7 براق مدح چنان ‌گرم بر فلک راندم %~% که توسنم را روح‌القدس لجام‌گرفت(@)(@@) 8 سمند کلک من آن سو ترک ز عرش‌ چمید %~% چو در میان سه انگشت من خرام گرفت(@)(@@) 9 فضای خلوت دل تنگ شد به شاهد رو‌ح %~% ز بس که عیش و طرب بر دلم زحام گرفت(@)(@@) 10 چو بخت خواجه بدم تا سحر‌هان بیدار %~% چو بختش این صفت از حی لایام گرفت(@)(@@) 11 سحر چو ریخت فلک ‌گرد مهر‌های سپید %~% ز جرم خور به سر این طشت‌ زردفام‌‌ گرفت(@)(@@) 12 ز که برآمد آن سرخ شیر زرد مژه %~% که گرد خود مژه زرد خود کنام گرفت(@)(@@) 13 سپید آهوکان خورد آن غضنفر سرخ %~% که زرد مژه او تیزی از سهام ‌گرفت(@)(@@) 14 چو صایدان بگرفت آن سپید طایرکان %~% چو بر کتف زرسنهای زرد دوام ‌گرفت(@)(@@) 15 بتم چو یوسف مصری رسید و نیل خطش %~% سواد خطه ری در سواد شام‌گرفت(@)(@@) 16 مهم ز ابرو آهیخت تیغ و مهر از نور %~% از این دو تیغ ندانم جهان کدام گرفت(@)(@@) 17 به ماه چهره پریشید طرگان سیاه %~% دوباره شب شد و آفاق را ظلام‌گرفت(@)(@@) 18 چو باز چهره نمود از میان چنبر زلف %~% ز رنگ طلعت او شام رنگ بام‌ گرفت(@)(@@) 19 دلم به زلف وی از هرطرف‌ که روی نمود %~% سیاهی شب یلدا ورا زمام‌گرفت(@)(@@) 20 سهیل‌ 
ms182	 گفتی از آسمان دوید به زیر %~% به جای باده‌گلرنگ جابجام‌گرفت(@)(@@) 21 چنین شراب به شوخی چنان حرام بود %~% صواب ‌کرد که صوفی به ما حرام‌ گرفت(@)(@@) 22 چو مست گشت و ز جا جست و بوسه داد بتم %~% لبم شمیم گل و نکهت مدام گرفت(@)(@@) 23 چه گفت گفت که هر لب که مدح خواجه کند %~% ببایدش ز لب س به بوسه‌کام‌گرفت(@)(@@) 24 یمین ملت اسلام حاجی آقاسی %~% که آفریش ازو شهره‌گشت و نام‌گرفت(@)(@@) 25 ز شوق وصل وی است اینکه معنی از آغاز %~% ز عرش‌ آمد و پیوند با کلام‌ گرفت(@)(@@) 26 عدوی سردمزاجش چو سنگ سخت ‌دلست %~% چو آب‌کز خنکی معنی ژخام‌گرفت(@)(@@) 27 ز پرتوی که ضمیرش فکند چون خورشید %~% به یک اشاره زمیا و زمان تمام‌ گرفت(@)(@@) 28 به نظم دولت و دین کلک ر‌ا چو بست‌ کمر %~% حسام پادشهان جای در نیام‌گرفت(@)(@@) 29 بلی چرا نرو‌د تیغ صفدران به نیام %~% که کلک او دو جهان را به یک پیام گرفت(@)(@@) 30 نظام دولت شه کرد جان‌نثاری را %~% که دولت ملک از طاعتش نظام ‌گرفت(@)(@@) 31 همین نظام ز خواجه است چون به‌ حق نگری %~% که خواجه گیرد اگر کشوری غلام گرفت(@)(@@) 32 بد از شکوه منوچهر فر سام سوار %~% که هم به نیروی او بود هر چه سام گرفت(@)(@@) 33 نه از غمام اگر قطره‌یی به بحر چکد %~% بود ز فیضی‌ کاول ازو غمام ‌گرفت(@)(@@) 34 ظفر دوران ز یسار و یمینش‌کز طاعت %~% ز خواجه خاتم ‌لعل وز شه‌ حسام‌ گرفت(@)(@@) 35 ایا فرشته‌ گهر خواجه‌یی ‌که قرب ترا %~% قبول حق سبب فیض مستدام گر‌فت(@)(@@) 36 نعیم ظاهر و باطن که هست هستی را %~% نخست روز ز یک‌ همت تو وام‌گر‌فت(@)(@@) 37 هرآن جنین که زند مهر مهر تو به جبین %~% ز حق نشان سعادت به بطن مام ‌گرفت(@)(@@) 38 نخست روز که شد دست دولت تو دراز %~% ز پیشگاه ازل دامن قیام گرفت(@)(@@) 39 همن 
ms183	 نه دولت ای‌ران نظام یافت ز ت‌ر %~% که ملک روی زمین از تو انتظام‌ گرفت(@)(@@) 40 به بحر مدح تو تا غوطه زد به صدق دلم %~% بسان سلک ‌گهر نظمم انسجام‌ گرفت(@)(@@) 41 دوام دولت تو خواهم از جهان‌ گرچه %~% جهان ز تقویت دولتت دوام‌گرفت(@)(@@) 42 به احتشام تو همواره چرخ جهدکنان %~% اگر چه چرخ ز جهد تو احتشام‌ گرفت PageV1P131(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 عید رمضان آمد و ماه رمضان رفت %~% صد شکر که این آمد و صد شکر که آن رفت(@)(@@) 2 این با طرب و خرمی و فرخی آمد %~% وان باکرم و محنت و رنج و مرضان رفت(@)(@@) 3 عید آمد و شد عیش‌ و نشاط و طرب آغاز %~% مه رفت و خرافات خرافات خران رفت(@)(@@) 4 ایام نشاط و طرب و خرمی آمد %~% هنگام بساط و شعب و زرق و فسان رفت(@)(@@) 5 لاحول‌کنان آمد تا خانه ز مسجد %~% عابد که ز مسجد به سوی خانه دوان رفت(@)(@@) 6 عید آمد و شد باز در خانه خمار %~% شاهد به میان آمد و زاهد ز میان رفت(@)(@@) 7 این طرفه‌ که با مسجد و سجاده و دستار %~% زاهد سبک از زهد پی رطل‌ گران رفت(@)(@@) 8 ما هم چله سازیم دگر با می و معشوق %~% سی روزه به دریوزه انیمان‌که زیان رفت(@)(@@) 9 رندانه به میخانه خرامیم وگذاریم %~% سر درکف آن پای که تا دیر مغان رفت(@)(@@) 10 یعنی به در قبله عالم‌شه آفاق %~% سازیم ازین‌ روی ‌که بر یاد شهان رفت(@)(@@) 11 ای ترک بپیما به طرب جام جهان‌بین %~% هان وقت غنیمت بشمر ورنه جهان رفت(@)(@@) 12 چندی سپری‌ گشت‌ که بی‌خون دل خم %~% خوناب جگر ما را از دیده روان رفت(@)(@@) 13 گلچهر بتا باده ‌گلرنگ بیاور %~% ما را نه جزآن قسمت برآب رزان رفت(@)(@@) 14 مستم ‌کن از آن سان ‌که خراب افتم تا عید %~% واگه نه اگر دی شد وگر فصل خزان رفت(@)(@@) 15 پیش 
ms184	 آی و کن از باده ‌گلرنگ عمارت %~% ویرانه دل را که به تاراج غمان رفت(@)(@@) 16 یاقوت روان خیز مرا قوت روان دارد %~% ررزی نگری ورنه ز جسمم‌ که روان رهت(@)(@@) 17 در مشرب چشم و لب تو باده حرامست %~% آن راکه‌کشد جام ز غم خط امان رفت(@)(@@) 18 ای ترک کماندار که پیکان نگاهت %~% از را نظر ما را تا جوشن جان رفت(@)(@@) 19 تو سروی و هرگز نشود سر‌و گرایان %~% وین طرفه‌ که با سرو روان‌ کوه ‌گران رفت(@)(@@) 20 از موی میان‌کوه سرینت بود آون %~% پیوند چنین مو را باکوه چسان رفت(@)(@@) 21 هر گه نگرم کوه تو چون چشمه که در کوه %~% بینندکه از حسرت آبم ز دهان رفت(@)(@@) 22 بوسیدن آن لب هوسم باشد و از بیم %~% پیش تو حدیثیم نباید به زبان رفت(@)(@@) 23 نشگفت ‌که رحمت ‌کند و کام ببخشد %~% پیری چو منی راکه به سر چون تو جوان رفت(@)(@@) 24 پیش آی و بهل تا لب لعل تو ببوسم %~% کاندر غمت از جان و تنم تاب وتوان رفت(@)(@@) 25 ای ماه زمین بوسه دریغ ار نکنی به %~% زان لب‌که درو مدحت دارای زمان رفت(@)(@@) 26 دارای جوانبخت محمد شه غازی %~% کش صیت ظفر بر همه اقطار جهان رفت(@)(@@) 27 شاهی‌که ز عدلش‌ن به چرا بی‌ژم و وحشت %~% آهو بره در خوابگه شیر ژیان رفت(@)(@@) 28 ببریست عدو خوار چو در رزم عنان داد %~% ابریست‌گهربار چو در بزم چمان رفت(@)(@@) 29 تا بوسه زند بر در او وهم بسی سال %~% بایدش فراتر ز برکاهکشان رفت(@)(@@) 30 جز در دل بدخواه نشیمن نگزیند %~% پرنده عقابیش ‌که از ناف‌ کمان رفت(@)(@@) 31 تیغش به وغا گرنه خلیفه ملک‌الموت %~% چونست‌که بایدش پی غارت جان رفت(@)(@@) 32 در دوره عدلش شده عالم همه آباد %~% الاکه خرابی همه بر معدن و کان رفت(@)(@@) 33 چون نعره‌کشدکوسش در ه‌قعه ز بیمش %~% از جان بداندیش بر افلاک فغان رفت(@)(@@) 34 
ms185	 هرجاکه پی رزم‌ کند عزم به رغبت %~% سوزنده جحیمیست ‌که بایمش قران رفت(@)(@@) 35 ماهیست فروزنده چو بر تخت خلافت %~% مهریست ‌درخشنده چو جامش ‌به ‌لبان رفت(@)(@@) 36 آن روزکه می زد ازلی نقش دو گیتی %~% بر رزق دوگیتیش‌ کف راد ضمان رفت(@)(@@) 37 شاها ملکا دادگرا ملک ستانا %~% ای‌کایت حکمت به‌همه‌کون و مکان رفت(@)(@@) 38 اوصاف جلال تو نهشتند به جایی %~% کانجا بتوان هرگز با پای‌ گمان رفت(@)(@@) 39 تا هست جهان شاه جهان باش که ‌گیتی %~% با عدل تواش مسخره بر باغ جنان رفت PageV1P132(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بهادر شه ای شهریاران ‌غلا‌مت %~% قضا و قدر هردو در اهتمامت(@)(@@) 2 به خاصان درافتاده غوغای عامی %~% ز ادراک خاص و ز انعام عامت(@)(@@) 3 جهان آفرین زافرینش ندارد %~% مرادی دگر جز حصول مرامت(@)(@@) 4 برون بود نه چرخ از جمع امکان %~% اگر بود همپایه با احتشامت(@)(@@) 5 به دوزخ‌ گریزند ارباب تقوی %~% کشند ار به فردوس شکل حسامت(@)(@@) 6 به پیش رواق توگردون خضرا %~% گیاهیست روینده از طرف بامت(@)(@@) 7 نیم قایل شرک لیکن درآید %~% پس از نام یزدان بهر خطبه نامت(@)(@@) 8 به ایوان طرف را به میدان شغب را %~% قیام از قعودت قعود از قیامت(@)(@@) 9 ز رفعت‌ کند منع تدویر گردون %~% سنان رماح و قباب خیامت(@)(@@) 10 به عالم درونی و از عالم افزون %~% چو مضمون وافر زمو جزکلامت(@)(@@) 11 چو در حضرت قدس صف ملایک %~% صفوف سلاطین به صف سلامت(@)(@@) 12 اگر هفت دریا شود جمله ‌گوهر %~% به هنگام بخشش نیابد تمامت(@)(@@) 13 وگر دست رادت عطا وام دادی %~% زمین و زمان بود در زیر وامت(@)(@@) 14 کجاگشت عزمت مصمم به یاری %~% که حالی نگردید گردون به کامت(@)(@@) 15 کجا آهوی رافتت ‌کرد جولان %~% که حالی نشد شیر درنده رامت(@)(@@) 16 ژحل لحظه‌یی دورگردون‌کند طی %~% دهد سیرش از ابرش تیز کامت(@)(@@) 17 تعالی‌الله ای برق تک خنگ دارا %~% که‌نقش‌است نصرت به زرین ستامت(@)(@@) 18 تو آن 
ms186	 باد سیری ‌که هنگام جولان %~% بود درکف باد صرصر زمامت(@)(@@) 19 بدانسان‌که روی زمین می‌نوردی %~% اگر سوی‌ گردون شود یک خرامت(@)(@@) 20 به یک لحظه پویی ز نه چرخ برتر %~% اگر دست دارا نگیرد لجامت(@)(@@) 21 به هر قطره‌کالای صدگنج بخشد %~% به گاه کرم دست همچون غمامت(@)(@@) 22 هنوز آسمان پنبه درگوش دارد %~% ز افغان افغان به غوغای جامت(@)(@@) 23 هنوز از وغازان زمین لاله روید %~% ز خونریزی خنجر لعل فامت(@)(@@) 24 هنوز است صحرا و هامون مغربل %~% ز آسیب پولاد پیکان سهامت(@)(@@) 25 اگر پای عفوت نبد در میانه %~% برانگیخت دود از جهان انتقامت(@)(@@) 26 بود بر یمین مایه مرگ تیغت %~% بود بر یسار آیت عیش جامت(@)(@@) 27 خرد فتنه اندر زوایای عالم %~% برآید چو نیلی پرند از نیامت(@)(@@) 28 الا تا مدام آورد شادمانی %~% بود شادمانی مدام از مدامت(@)(@@) 29 نه جز در رواق ریاست نشستت %~% نه جز بر سریر کیاست مقامت PageV1P133(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 تا ابد چشم بد ازگنجور دارا دور باد %~% بحر وکان خالی زگنج همت‌گنجور باد(@)(@@) 2 آن حسین اسم حسن رسمی ‌که چشم روزگار %~% از می مینای مهرش جاودان مخمور باد(@)(@@) 3 آنکه ‌چون معمار جودش قصد آبادی‌ کند %~% آسمان در آستانش‌کمترین مزدور باد(@)(@@) 4 بر فروغ طلعتش هرگه‌که بگشایند چشم %~% دیده احباب روشن چشم اعدا کور باد(@)(@@) 5 آسمان را هست مهر و مهر شه در دست او %~% تا ابد از لطف شه ‌کارش بدین‌ دستور باد(@)(@@) 6 غیر این ‌کش پشکارانند با این هر نفس %~% از شهش بر منصبی از منشیان منشور باد(@)(@@) 7 پیشکارانی‌ که بر خرم روانشان از سپهر %~% هر زمان فرخ نوید سعیکم مشکور باد(@)(@@) 8 هر نوایی‌ کار غنون‌ساز فلک آرد پدید %~% با نوای سازبختش زاد فی‌الطنبور باد(@)(@@) 9 باد دایم محرم درگاه دارای جهان %~% آنکه تا جاوید جیش ناصرش منصور باد(@)(@@) 10 خسرو غازی بهادر شه حسن آنکو مدام %~% در شبستانش عروس عافیت مستور باد(@)(@@) 11 خاک 
ms187	 راه باد پایش توتیای چشم چرخ %~% نعل سم ابرشش تاج سر فغفور باد(@)(@@) 12 ای جهانداری‌ که درکریاس جاهت پاسبان %~% قیصر و رای‌و نجاشی‌و تکین‌ و فور باد(@)(@@) 13 تیغت ارچه هست چون‌سیماب لیکن در مصاف %~% از برای قطع نسل دشمنان ‌کافور باد(@)(@@) 14 چند روزی چون اتابک ‌گر نمودی عزم فارس %~% بازگشتت باز چون سنجر به نیشابور باد(@)(@@) 15 جاودان در چنگل شاه و در چنگال شیر %~% ز احتسابت جای غرم و لانه‌ عصفور باد(@)(@@) 16 نیکخواه از ظل چتر رایتت آسوده حال %~% بدسگال از فر بخت قاهرت مقهور باد PageV1P134(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 هر زمانم‌ که به آن ترک سر و کار افتد %~% صلح خیزد ز میان‌ کار به پیکار افتد(@)(@@) 2 من به عمد از پی صلح همی جویم جنگ %~% کز پی صلحم با بوسه سر وکار افتد(@)(@@) 3 نفسم بر دو یک افتد ز سبکروحی شوق %~% عدد بوسه من چون به سه و چار افتد(@)(@@) 4 بر میانش چو کمر آورم از شوق دو دست %~% نقطه را ماند کاندر خط پرگار افتد(@)(@@) 5 ای خوش آن وقت که خیزد بت من از پی رقص %~% از طرب رعشه برآن‌گنبد دوار افتد(@)(@@) 6 ساعد و ساق چو بالا زند آن ترک پسر %~% دختر طبع مراکیک به شلوار افتد(@)(@@) 7 خوشتر آن‌ وقت‌ که از غایت مستیش سخن %~% همچو سرما زده درکام به تکرار افتد(@)(@@) 8 گاه بنشیند و از جای به یک‌پا خیزد %~% گاه برخیزد و از پای به یک‌بار افتد(@)(@@) 9 آفتاب خردش روی نماید به غروب %~% بس‌که چون سایه هم بر در ودیوار افتد(@)(@@) 10 مژه‌اش از طرف چشم فتد بر رخسار %~% راست مانند عصا کز کف بیمار افتد(@)(@@) 11 مست در بستر من خسبد و رندان دانند %~% حالت مست‌ که در بستر هشیار افتد(@)(@@) 12 تا به صبح آنقدرش بوسه زنم بر رخسار %~% که چو منش آبله از بوسه به رخسار افتد(@)(@@) 13 صبح اگر حالت 
ms188	 شب عرضه نماید بر شاه %~% کارم از بیم به سوگند و به انکار افتد(@)(@@) 14 ور به خاک قدم شاهم سوگند دهد %~% ناگزیرم‌که مراکار به اقرار افتد(@)(@@) 15 هم به خاک قدم شه‌که قسم می‌نخورم %~% گرنه اول به‌کفم خاتم زنهار افتد(@)(@@) 16 شاه زنهار اگرم بدهد اقرارکنم %~% ورنه حاشا زنم و مسأله دشوار افتد(@)(@@) 17 نی خطاگفتم شاه از همه‌حال آگاهست %~% می نخواهد که همی پرده ز اسرار افتد(@)(@@) 18 هم‌ خدا داند و هم‌ شاه‌ که هر شب در شهر %~% زین نمط رندی و قلاشی بسیار افتد(@)(@@) 19 چون بر ابنای جهان بار خدا ستارست %~% لاجرم سایه او باید ستار افتد(@)(@@) 20 می‌خوران را شه اگر خواهد بر دار زند %~% گذر عارف و عامی همه بر دار افتد(@)(@@) 21 ور به دژخیم‌ کند حکم کشان گوش به رند %~% همه گوشست که در کوچه و بازار افتد(@)(@@) 22 این همه طیبت محضست‌که در دولت شاه %~% گر همه کافر حربیست نکوکار افتد(@)(@@) 23 شعرا را بود این قاعده از عهد قدیم %~% که حدیث از می و معشوق در اشعار افتد(@)(@@) 24 چون خور این نظم دلاویز جهانگیر شود %~% گر به خاک در شه درخور ایثار افتد(@)(@@) 25 شاه آزاد جوانبخت محمد شه راد %~% که جهان با سخن خلقش فرخار افتد(@)(@@) 26 آنکه گر نام عطایش ببری بر لب بحر %~% ریزه سنگ به قعرش ذر شهوار افتد(@)(@@) 27 خنجر بران در پنجه او روز عزا %~% همچو برقیست‌ که در قلزم زخار افتد(@)(@@) 28 رزمگاهی‌ که درو یک ره شمشیر زند %~% تا به جاوید ز خون خاکش در آغار افتد(@)(@@) 29 دور بین حزمش بر موم چو تایید دهد %~% موم چون بیضه پولادین ستوار افتد(@)(@@) 30 خار ناچیز چو گلبن همه‌ گل‌ آرد برگ %~% نظر مهرش اگر روزی بر خار افتد(@)(@@) 31 پرچم رایتش اینسان‌ که بود شقه ‌گشای %~% زود باشد که درش سایه به بلغار افتد(@)(@@) 32 تا بر اقطار زمین دور 
