ms1126	 من لقي الله مستيقنا بهن دخل الجنة : يؤمن بالله واليوم الآخر والجنة والنار ، والبعث بعد الموت والحساب ) )(@)(@@) ( حم ) عن مولى رسول الله ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 9901 ) قال النبي :(@)(@@) | 30 ( بخ بخ بخ بخ الحي عترة مبغى عليهم منصورون ، مرحبا بقوم شعيب وأخيار موسى ، اللهم ارزق عترة كفافا لا ثوت ولا إسراف ) )(@)(@@) ابن قانع ( طب ) عن سلمة بن سعيد العتري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9902 ) قال النبي :(@)(@@) | 30 ( بخ بخ لقد سألت عن عظيم وإنه ليسير على من أراد الله به الخير : تؤمن بالله واليوم الآخر ، وتقيم الصلاة المكتوبة ، وتؤدي الزكاة المفروضة وتصوم رمضان وتحج البيت ، وتعبد الله وحده لا شريك له ، حتى تموت وأنت على ذالك ؛ إن شئت حدثتك يا م| عاذ بن جبل برأس هاذا الأمر وقوامه وذروة السنام منه ، رأس هاذا الأمر تشهد أن لا إلاه إلا الله وأن محمدا عبده ورسوله ، وإن PageV04P012 قوامه إقام الصلاة وإيتاء الزكاة ، وإنما ذروة السنام منه الجهاد في سبيل الله ، إنما أمرت أن أقاتل الناس حتى يشهدوا أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، ويقيموا الصلاة ويؤتوا الزكاة ، فإذا فعلوا ذالك فقد عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم على الله ، والذي نفسي بيده ما شحب وجه ولا اغبرت قدم في عمل تبتغي فيه درجات بعد صلاة مفروضة كجهاد في سبيل الله ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9903 ) قال النبي :(@)(@@) | 30 ( بخ لكما ، أنا سيد ولد آدم ، وأنتما سيدا العرب قاله لعلي والعباس رضي الله عنهما ) )(@)(@@) ابن عساكر عن ابن عباس عن أبيه .(@)(@@)(@@)(@@) $ ( 9904 ) قال النبي :(@)(@@) | 30 ( بخير من رجل لم يصبح صائما ولم يعد سقيما ) )(@)(@@) عبد بن حميد ( ه ع ض ) عن جابر رضي الله عنه قال : قلت : كيف أصبحت يا رسول الله ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 9905 ) قال النبي :(@)(@@) | 30 ( بخروا بيوتكم باللبان والشيح ) )(@)(@@) ( هب ) عن عبد الله بن أبي جعفر معضلا .(@)(@@)(@@)(@@) $ ( 9906 ) قال النبي :(@)(@@) | 30 ( بخروا بيوتكم باللبان والشيخ والمر والزعتر ) )(@)(@@) ( هب ) عن أبي جعفر عن 
ms1127	 أبان بن صالح عن أنس .(@)(@@)(@@)(@@) ||| ( الباء مع الدال(@)(@@)(@@)(@@) |||| الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9907 ) قال النبي :(@)(@@) | 30 ( بدموع عينيك ، فإن عينا بكت من خشية الله لا تأكلها النار ) )(@)(@@) الخطيب عن زيدبن أرقم أن رجلا سأل رسول الله بما أتقي النار ؟ قال : فذكره .(@)(@@) PageV04P013(@)(@@)(@@)(@@) $ ( 9908 ) قال النبي :(@)(@@) | 30 ( بدنت فمن فاته ركوعي أدركه في بطيء قيامي ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9909 ) قال النبي :(@)(@@) | 30 ( بدأ الإسلام غريبا ثم يعود كما بدأ فطوبى للغرباء الذين يصلحون إذا فسد الناس ، والذي نفسي بيده لينحازن الإيمان إلى المدينة كما يحوز السيل ، والذي نفسي بيده ليأرزن الإسلام ما بين المسجدين كما تأرز الحية إلى جحرها ) )(@)(@@) ( حم ) عن عبد الرحمان بن سنة الأشجعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9910 ) قال النبي :(@)(@@) | 30 ( بدلاء أمتي أربعون رجلا اثنان وعشرون بالشام وثمانية عشر بالعراق ، كلما مات منهم واحد أبدل الله مكانه آخر ، فإذا جاء الأمر قبضوا ) )(@)(@@) ( كر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الباء مع الذال(@)(@@)(@@)(@@) |||| الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9911 ) قال النبي :(@)(@@) | 30 ( بذالك أمرت الرسل قبلي لا تأكل إلا طيبا ، ولا تعمل إلا صالحا ) )(@)(@@) ( حل ) عن أم عبد الله أخت شداد بن أوس رضي الله عنها .(@)(@@)(@@)(@@) ||| ( الباء مع الراء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9912 ) قال النبي :(@)(@@) | 30 ( براءة من الكبر لبوس الصوف ومجالسة فقراء PageV04P014 المؤمنين ، وركوب الحمار ، واعتقال الععنز ) )(@)(@@) ( حل هب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9913 ) قال النبي :(@)(@@) | 30 ( برئت الذمة ممن أقام مع المشركين في ديارهم ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9914 ) قال النبي :(@)(@@) | 30 ( برىء من الشح من أدى الزكاة ، وقرى الضيف ، وأعطى في النائبة ) )(@)(@@) ( هناد ع طب ) عن خالد بن زيد بن حارثة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9915 ) قال النبي :(@)(@@) | 30 ( بر الحج : إطعام الطعام ، وطيب الكلام ) )(@)(@@) ( ك ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9916 ) قال النبي :(@)(@@) | 30 ( بر الوالدين يجزىء عن الجهاد ) )(@)(@@) ( ش ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 9917 ) قال النبي :(@)(@@) | 30 ( بر الوالدين يزيد في العمر ، والكذب ينقص الرزق ، والدعاء يرد القضاء ، ولله عز 
ms1128	 وجل في خلقه قضاآن : قضاء نافذ وقضاء محدث ، وللأنبياء على العلماء فضل درجتين ، وللعلماء على الشهداء فضل درجة ) )(@)(@@) ( أبو الشيخ في التوبيخ عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9918 ) قال النبي :(@)(@@) | 30 ( بردوا طعامكم يبارك لكم فيه ) )(@)(@@) ( عد ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9919 ) قال النبي :(@)(@@) | 30 ( بروا آباؤكم تبركم أبناؤكم وعفوا تعف نساؤكم ) )(@)(@@) ( عد ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9920 ) قال النبي :(@)(@@) | 30 ( بروا آباءكم تبركم أبناؤكم وعفوا عن النساء تعف نساؤكم ، ومن تنصل إليه فلم يقبل فلن يرد علي الحوض ) )(@)(@@) ( طب ) عن جابر رضي الله عنه .(@)(@@) PageV04P015(@)(@@)(@@)(@@) $ ( 9921 ) قال النبي :(@)(@@) | 30 ( بركة الطعام الوضوء قبله والوضوء بعده ) )(@)(@@) ( حم د ت ك ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9922 ) قال النبي :(@)(@@) | 30 ( بر المرأة المؤمنة كعمل سبعين صديقا ، وفجور المرأة الفاجرة كفجور ألف فاجر ) )(@)(@@) أبو الشيخ عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9923 ) قال النبي :(@)(@@) | 30 ( بر أمك ثم أباك ثم أخاك ثم أختك ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الباء مع السين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9924 ) قال النبي :(@)(@@) | 30 ( بسم الله الرحمان الرحيم مفتاح كل كتاب ) )(@)(@@) عن أبي جعفر معضلا .(@)(@@)(@@)(@@) $ ( 9925 ) قال النبي :(@)(@@) | 30 ( بسم الله الرحمان الرحيم من محمد النبى إلى شرحبيل بن عبد كلال والحارث بن عبد كلال ونعيم بن عبد كلال قيل ذى رعين ومعافر وهمدان ، أما بعد ، فقد رجع رسولكم وأعطيتم من المغانم خمس الله وما كتب الله على المؤمنين من العشر فى العفار وما سقت السماء أو كان سيحا أو كان بعلا ففيه العشر إذا بلغ خمسة أوسق ، وفى كل خمس من الإبل سائمة شاة إلى أن تبلغ أربعا وعشرين فإذا زادت واحدة على أربع وعشرين ففيها بنت مخاض ، فإن PageV04P016 لم توجد بنت مخاض فابن لبون ذكر إلى أن تبلغ خمسا وثلاثين فإذا زادت على خمس وثلاثين واحدة ففيها بنت لبون إلى أن تبلغ خمسا وأربعين ، فإذا زادت واحدة على خمس وأربعين ففيها حقة طروقة الجمل إلى 
ms1129	 أن تبلغ ستين فإذا زادت واحدة على ستين ففيها جذعة إلى أن تبلغ خمس وسبعين فإذا زادت واحدة على خمس وسبعين ففيها بنتا لبون إلى أن تبلغ تسعين فإذا زادت واحدة ففيها حقتان طروقتا الجمل إلى أن تبلغ عشرين ومائة فما زاد ففى كل أربعين بنت لبون أربعين ، وفى كل خمسين حقة طروقة الجمل ، وفى كل ثلاثين بقرة تبيع جذع أو جذعة ، وفى كل أربعين بقرة بقرة ، وفى كل أربعين شاة سائمة شاة إلى أن تبلغ عشرين ومائة ، فإذا زادت على عشرين ومائة ففيها شاتان إلى أن تبلغ مائتين فإذا زادت واحدة فثلاث إلى أن تبلغ ثلاثمائة ، فما زاد ففى كل مائة شاة شاة ولا يؤخذ فى الصدقة هرمة ولا ذات عوار ولا تيس الغنم ، ولا يجمع بين متفرق ، ولا يفرق بين مجتمع خشية الصدقة ، فما أخذ من الخليطين فإنهما يتراجعان بالسوية بينهما ، وفي كل خمس أواق من الورق خمسة دراهم فما زاد ففي كل أربعين درهما درهم وليس فيما دون خمس أواق شيء ، وفي كل أربعين دينار دينار ، وإن الصدقة لا تحل لمحمد ولا لأهل بيته إنما هي الزكاة تزكون بها أنفسكم ولفقراء المؤمنين وفي سبيل الله ، وليس في رقيق ولا مزرعة ولا عمالة شيء إذا كانت تؤدي صدقتها من العشر ، وليس في عبد مسلم ولا في فرسه شيء ، وإن أكبر الكبائر عند الله يوم القيامة الشرك بالله ، وقتل النفس المؤمنة بغير حق ، والفرار في سبيل الله يوم الزحف ، وعقوق الوالدين ، ورمي المحصنة ، وتعلم السحر ، وأكل الربا ، وأكل مال اليتيم ، وإن العمرة الحج الأصغر ، ولا يمس القرآن إلا طاهر ، ولا طلاق قبل إملاك ، ولا عتاق حتى يبتاع ، ولا يصلين أحد منكم في ثوب واحد ليس على منكبه شيء ، ولا يحتبين في ثوب واحد ليس بين فرجه وبين السماء شيء ، ولا يصلين أحد منكم في ثوب واحد وشقه باد ، ولا يصلين أحد منكم عاقص شعره ، ومن اعتبط مؤمنا قتلا عن بينة فإنه قود إلا PageV04P017 أن يرضى أولياء المقتول ، وإن في 
ms1130	 النفس الدية مائة من الإبل ، وفي الأنف إذا أوعب جذعه الدية ، وفي اللسان الدية ، وفي الشفتين الدية ، وفي الذكر الدية ، وفي البيضتين الدية ، وفي الصلب الدية ، وفي العينين الدية ، وفي الرجل الواحدة نصف الدية ، وفي المأمومة نصف الدية ، وفي الجائفة ثلث الدية ، وفي المنقلة خمسة عشر من الإبل ، وفي كل أصبع من الأصابع في اليد والرجل عشر من الإبل ، وفي سن خمس من الإبل ، وفي الموضحة خمس من الإبل ، وإن الرجل يقتل بالمرأة وعلى أهل الذهب ألف دينار ) )(@)(@@) ( ن طب ك هق ) عن عمرو بن حزم رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 9926 ) قال النبي :(@)(@@) | 30 ( بسم الله الرحمان الرحيم ، من محمد عبد الله ورسوله إلى هرقل عظيم الروم ، سلام على من اتبع الهدى ، أما بعد ، فإني أدعوك بدعاية الإسلام ، أسلم تسلم يؤتك الله أجرك مرتين ، فإن توليت فإن عليك إثم الأريسيين ، ويا أهل الكتاب تعالوا إلى كلمة سواء بيننا وبينكم أن لا نعبد إلا الله ولا نشرك به شيئا ولا يتخذ بعضنا بعضا أربابا من دون الله ، فإن تولوا فقولوا اشهدوا بأنا مسلمون ) )(@)(@@) ( حم ق ت ) عن أبي سفيان رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 9927 ) قال النبي :(@)(@@) | 30 ( بسم الله الرحمان الرحيم ، هاذا ما اشترى ال| عداء بن خالد بن هوذة من محمد رسول الله اشترى منه عبدا أو أمة على أن لا داء ولا غائلة ولا خبثة بيع المسلم للمسلم ) )(@)(@@) ( ت ه ) عن العداء بن خالد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9928 ) قال النبي :(@)(@@) | 30 ( بسم الله الرحمان الرحيم ، هاذا كتاب من محمد PageV04P018 رسول الله لبني زهير بن أقيش ، سلام على من اتبع الهدى ، فإني أحمد إليكم الله الذي لا إلاه إلا هو ، أما بعد ، إن شهدتم أن لا إله إلا الله ، وأقمتم الصلاة ، وآتيتم الزكاة ، وفارقتم المشركين ، وأعطيتم من المغانم الخمس وسهم النبى وصفيه فأنتم آمنون بأمان الله وأمان رسوله ) )(@)(@@) ( حم د ن ) و البغوى والباوردى ( طب هق ) عن النمر بن تولب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9929 ) قال 
ms1131	 النبي :(@)(@@) | 30 ( بسم الله الرحمان الرحيم ، من محمد رسول الله إلى بديل بن ورقاء وبشر وسروات بنى عمرو سلام عليكم ، فإنى أحمد إليكم الله الذي لا إلاه إلا هو ، أما بعد فإني لم آثم بالكم ، ولم أضع في جنبكم ، وإن أكرم أهل تهامة علي لأنتم وأقربهم رحما ومن تبعكم من المطيبين ، وإنني قد أخذت لمن هاجر منكم مثل ما أخذت لنفسي ، ولو هاجر بأرضه غير سكن مكة إلا معتمرا أو حاجا ، وإني لم أضع فيكم إذ سلمتم ، وإنكم غير خائفين من قبلي ولا محضورين ، أما بعد ، فإنه قد أسلم علقمة بن علاثة وابنا هوزة وبايعا وهاجرا على من تبعهم من عكرمة وأخذ لمن تبعه منكم مثل ما أخذ لنفسه ، وإن بعضنا من بعض في الحل والحرم ، وإني والله ما كذبتكم وليحبنكم ربكم ) )(@)(@@) ابن سعد عن قبيضة ابن ذؤيب والباوردي والفاكهي في أخبار مكة ( طب ) وأبو نعيم ( ض ) وروى ( ش ) بعضه ومن وجه آخر .(@)(@@)(@@)(@@) $ ( 9930 ) قال النبي :(@)(@@) | 30 ( بسم الله الرحمان الرحيم ، هاذا ما أعطى محمد رسول الله بلال بن الحارث معادن القبيلة جليسها وغوريها وذات النصب وحيث يصلح الزرع من قدس إن كان صادقا وعلم يعطه حق مسلم ) )(@)(@@) ( د هق ) عن ابن عباس رضي الله عنهما ( د ) عن كثير بن عبد الله المزني عن أبيه عن جده ( طب ك ) عن بلال بن الحارث المزني رضي الله عنه .(@)(@@) PageV04P019(@)(@@)(@@)(@@) ||| ( الباء مع الش ي ن(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9931 ) قال النبي :(@)(@@) | 30 ( بشرى الدنيا الرؤيا الصالحة ) )(@)(@@) ( طب ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9932 ) قال النبي :(@)(@@) | 30 ( بشر المشائين في الظلم إلى المساجد بالنور التام يوم القيامة ) )(@)(@@) ( د ت ) عن بريدة ( ه ك ) عن أنس وعن سهل بن سعد رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 9933 ) قال النبي :(@)(@@) | 30 ( بشر الناس أنه من قال : لا إلاه إلا الله وحده لا شريك له وجبت له الجنة ) )(@)(@@) ( ن ) عن سهل بن حنيف وعن زيد بن خالد الجهني رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 9934 ) قال النبي :(@)(@@) | 30 ( بشر من 
ms1132	 شاهد بدرا بالجنة ) )(@)(@@) ( قط ) في الأفراد عن أبي بكر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9935 ) قال الن بي :(@)(@@) | 30 ( بشر هاذه الأمة بالسناء والدين والرفعة والنصر والتمكين في الأرض ، فمن عمل منهم عمل الآخرة للدنيا لم يكن له في الآخرة من نصيب ) )(@)(@@) ( حم حب ك هب ) عن أبي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9936 ) قال النبي :(@)(@@) | 30 ( بشروا خديجة ببيت في الجنة من قصب لا صخب فيه ولا نصب ) )(@)(@@) ( ق ) عن عبد الله بن أبي أوفى ا وعن عائشة رضي الله عنهما ( ز ) .(@)(@@) PageV04P020(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9937 ) قال النبي :(@)(@@) | 30 ( بشرك الله بخير يا عمر في الدنيا والآخرة ) )(@)(@@) ابن النحار في عمل يوم وليلة عن أبي اليسر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9938 ) قال النبي :(@)(@@) | 30 ( بشر المشائين في الظلم إلى المساجد للصلاة في جماعة بالنور التام من الله يوم القيامة ) )(@)(@@) أبو نعيم عن حارثة بن وهب الخزاعي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9939 ) قال النبي :(@)(@@) | 30 ( بشر المدلجين إلى المساجد في الظلم بمنابر من نور يوم القيامة ، يفزع الناس ولا يفزعون ) )(@)(@@) ( طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9940 ) قال النبي :(@)(@@) | 30 ( بشر المشائين في الظلم إلى الصلاة بنور ساطع يوم القيامة بين أيديهم وعن أيمانهم وعن شمائلهم ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9941 ) قال النبي :(@)(@@) | 30 ( بشر المشائين في الظلمات إلى المساجد بنور عظيم من عند الله يوم القيامة ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الباء مع الطاء(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9942 ) قال النبي :(@)(@@) | 30 ( بطحان على بركة من برك الجنة ) )(@)(@@) ( البزار ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9943 ) قال النبي :(@)(@@) | 30 ( بطن القدم يا أبا الهيثم ) )(@)(@@) ( طب ) عن أبي الهيثم PageV04P021 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9944 ) قال النبي :(@)(@@) | 30 ( بطن القدمين ) )(@)(@@) ( طب ) عن محمود بن محمود بلاغا .(@)(@@)(@@)(@@) $ ( 9945 ) قال النبي :(@)(@@) | 30 ( بطحان على ترعة من ترع الجنة ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9946 ) قال النبي :(@)(@@) | 30 ( بطل مؤمن سخي تقي حياطة الدين وملك الإسلام ، ونور الهدى ، ومنار 
ms1133	 التقى ، فطوبى لمن تبعك ، والويل لمن خذلك ) )(@)(@@) ابن عساكر عن سلمان قال : رأيت رسول الله يحدث عمر رضي الله عنه ويقول فذكره .(@)(@@)(@@)(@@) ||| ( الباء مع العين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9947 ) قال النبي :(@)(@@) | 30 ( بعثت إلى الناس كافة ، فإن لم يستجيبوا لي فإلى العرب ، فإن لم يستجيبوا لي فإلى قريش ، فإن لم يستجيبوا لي فإلى بني هاشم ، فإن لم يستجيبوا لي فإلي وحدي ) )(@)(@@) ( ابن سعد ) عن خالد بن معدان مرسلا .(@)(@@)(@@)(@@) $ ( 9948 ) قال النبي :(@)(@@) | 30 ( بعثت إلى أهل البقيع لأصلي عليهم ) )(@)(@@) ( حم ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 9949 ) قال النبي :(@)(@@) | 30 ( بعثت أنا والساعة كهاتين ) )(@)(@@) ( حم ق ت ) عن أنس ( حم ق ) عن سهل بن سعد رضي الله عنه .(@)(@@) PageV04P022(@)(@@)(@@)(@@) $ ( 9950 ) قال النبي :(@)(@@) | 30 ( بعثت بالحنيفية السمحة ، ومن خالف سنتي فليس مني ) )(@)(@@) ( خط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9951 ) قال النبي :(@)(@@) | 30 ( بعثت بجوامع الكلم ، ونصرت بالرعب ، وبينا أنا نائم أوتيت بمفاتيح خزائن الأرض فوضعت في يدي ) )(@)(@@) ( ق ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9952 ) قال النبي :(@)(@@) | 30 ( بعثت بمداراة الناس ) )(@)(@@) ( هب ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9953 ) قال النبي :(@)(@@) | 30 ( بعثت بين يدي الساعة وبالسيف حتى يعبد الله تعالى وحده لا شريك له ، وجعل رزقي تحت ظل رمحي ، وجعل الذل والصغار على من خالف أمري ، ومن تشبه بقوم فهو منهم ) )(@)(@@) ( حم ع طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9954 ) قال النبي :(@)(@@) | 30 ( بعثت داعيا ومبلغا وليس إلي من الهدى شيء ، وخلق إبليس مزينا وليس إليه من الضلالة شيء ) )(@)(@@) ( عق عد ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9955 ) قال النبي :(@)(@@) | 30 ( بعثت في نسم الساعة ) )(@)(@@) ( الحاكم في الكنى ا ) عن أبي جبيرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 9956 ) قال النبي :(@)(@@) | 30 ( بعثت في نفس الساعة فسبقتها كما سبقت هاذه هاذه لأصبعه السبابة والوسطى ) )(@)(@@) ( ت ) عن المستورد بن شداد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 9957 ) قال النبي :(@)(@@) | 30 ( بعثت لأتمم صالح الأخلاق ) )(@)(@@) ( ك هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV04P023(@)(@@)(@@)(@@) $ ( 9958 ) قال النبي 
ms1134	 :(@)(@@) | 30 ( بعثت مرحمة وملحمة ولم أبعث تاجرا ولا زارعا ، ألا وإن شرار الأمة التجار والزارعون إلا من شح على دينه ) )(@)(@@) ( حل ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9959 ) قال النبي :(@)(@@) | 30 ( بعثت من خير قرون بنى آدم قرنا فقرنا حتى كنت من القرن الذى كنت فيه ) )(@)(@@) ( خ ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9960 ) قال النبي :(@)(@@) | 30 ( بع وقل لا خلابة ) )(@)(@@) ( ك ) عن ابن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9961 ) قال النبي :(@)(@@) | 30 ( بعث الله ثمانية آلاف نبى ، أربعة آلاف منهم إلى بنى إسرائيل ، وأربعة آلاف إلى سائر الناس ) )(@)(@@) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9962 ) قال النبي :(@)(@@) | 30 ( بعث الله جبريل إلى آدم وحواء فقال لهما : ابنيا لي بيتا ، فحط جبريل ، فجعل آدم يحفر وحواء تنقل حتى أجابه الماء ، ثم نودى من تحته حسبك يا آدم ، فلما بناه أوحى الله إليه أن يطوف به ، وقيل له : أنت أول الناس وهاذا أول بيت ، ثم تناسخت القرون حتى خجه نوح ، ثم تناسخت القرون حتى رفع إبراهيم القواعد منه ) )(@)(@@) ( هق ) و ابن عساكر عن ابن عمر وقال ( هق ) تفرد به ابن لهيعة هاكذا مرفوعا .(@)(@@)(@@)(@@) $ ( 9963 ) قال النبي :(@)(@@) | 30 ( بعث الله يحيى بن زكريا إلى بني إسرائيل بخمس كلمات ، فلما بعث الله عيسى قال الله عز وجل : يا عيسى قل ليحيى بن زكريا : إما أن تبلغ ما أرسلت به إلى بني إسرائيل وإما أن أبلغهم ، فخرج يحيى حتى صار إلى بني إسرائيل فقال : إن الله تبارك وتعالى أمركم أن تعبدوه ولا تشركوا به شيئا ، ومثل ذالك كمثل رجل أعتق رجلا وأحسن إليه وأعطاه ، فانطلق وكفر نعمته ووالى PageV04P024 غيره ، وإن الله يأمركم أن تقيموا الصلاة ، ومثل ذالك كمثل رجل أسره العدو فأرادوا قتله فقال : لا تقتلوني فإن لي كنزا وأنا أفدي نفسي ، فأعطاهم كنزه ونجا بنفسه ، وإن الله تبارك وتعالى يأمركم أن تصدقوا ، ومثل ذالك كمثل رجل سعى إلى عدوه وقد أخذ للقتال جنته ، فلا يبالي من حيث أوتي ، وإن الله يأمركم 
ms1135	 أن تقرؤوا الكتاب ، ومثل ذالك كمثل قوم في حصنهم صار إليهم عدوهم وقد أعدوا في كل ناحية من نواحي الحصن قوما فليس يأتيهم من ناحية من نواحي الحصن إلا وبين أيديهم من يدرؤهم عن الحصن ، فذالك مثل من يقرأ القرآن لا يزال في أحصن حصن ) )(@)(@@) ( بز ) عن علي رضي الله عنه ورجاله موفون .(@)(@@)(@@)(@@) $ ( 9964 ) قال النبي :(@)(@@) | 30 ( بعث الله عز وجل إليه يعني كسرى ملكا ، فأخرج يده من سور جدار بيته الذي هو فيه تلألأ نورا ، فلما رآها فزع ، فقال له : لم تفزع يا كسرى ، إن الله تعالى قد بعث رسولا وأنزل عليه كتابا فاتبعه تسلم لك دنياك وآخرتك ، قال : سأنظر ) )(@)(@@) ابن إسحاق وابن أبي الدنيا وابن النجار عن الحسن البصري عن أصحاب رسول الله أنهم قالوا : يا رسول الله ما حجة الله على كسرى فيك ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 9965 ) قال النبي :(@)(@@) | 30 ( بعث الله نوحا لأربعين سنة ولبث في قومه ألف سنة إلا خمسين عاما يدعوهم ، وعاش بعد الطوفان ستين سنة حتى كثرت الناس وفشوا ) )(@)(@@) ( ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9966 ) قال النبي :(@)(@@) | 30 ( بعث داود وهو راعي غنم ، وبعث موسى وهو راعي غنم ، وبعثت أنا وأنا راعي غنم لأهلي بجياد ) )(@)(@@) ( ط ) و البغوي وابن منده وأبو نعيم من طريق أبي إسحاق عن بشر بن حزن النصري وهو مختلف في صحبته وقيل نصر بن حزن ، وقيل عبدة بن حزن بن سعد قال : بلغنا .(@)(@@) PageV04P025(@)(@@)(@@)(@@) $ ( 9967 ) قال النبي :(@)(@@) | 30 ( بعث موسى وهو يرعى غنما على أهله ، وبعثت أنا وأنا أرعى غنما لأهلي بجياد ) )(@)(@@) ( حم ) و عبد بن حميد عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9968 ) قال النبي :(@)(@@) | 30 ( بعثت أنا والساعة كهاتين إن كادت لتسبقني ) )(@)(@@) ( حم ) وسمويه ( ض ) عن عبد الله بن بريدة عن أبيه .(@)(@@)(@@)(@@) $ ( 9969 ) قال النبي :(@)(@@) | 30 ( بعثت إلى الأحمر والأسود ) )(@)(@@) ابن سعد عن أبي جعفر مرسلا .(@)(@@)(@@)(@@) $ ( 9970 ) قال النبي :(@)(@@) | 30 ( بعثت على إثر ثمانية آلاف من الأنبياء منهم أربعة آلاف من بني إسرائيل ) )(@)(@@) ابن سعد عن أنس 
ms1136	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9971 ) قال النبي :(@)(@@) | 30 ( بعثت بالحنيفية السمحة ) )(@)(@@) ابن سعد عن حبيب بن أبي ثابت مرسلا الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9972 ) قال النبي :(@)(@@) | 30 ( بعثت أنا والساعة كهاذه من هاذه ، إن كادت لتسبقني ) )(@)(@@) ( حم ) و هناد ( طب ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9973 ) قال النبي :(@)(@@) | 30 ( بعثت أنا والساعة هاكذا فسبقتها كما سبقت هاذه هاذه ) )(@)(@@) ( طب ) عن أبي جبيرة بن الضحاك الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9974 ) قال النبي :(@)(@@) | 30 ( بعثني الله هدى ورحمة للعالمين وبعثني لأمحق المزامير والمعازف وأمر الجاهلية والأوثان ، وحلف ربي بعزته ، لا يشرب عبد من عبيده الخمر في الدنيا إلا حرمها عليه يوم القيامة ، ولا يتركها عبد من عبيده في الدنيا إلا سقاه الله إياها في حظيرة القدس ) )(@)(@@) الحسن بن سفيان وابن منده وأبو نعيم وابن النجار عن أنس رضي الله عنه وضعف .(@)(@@) PageV04P026(@)(@@)(@@)(@@) $ ( 9975 ) قال النبي :(@)(@@) | 30 ( بعثني الله بالإسلام أن تقول : أسلمت نفسي لله ووجهت وجهي إليه وتخليت ، وتقيم الصلاة ، وتؤتي الزكاة ، كل مسلم على مسلم حرام أخوان نصيران ، لا يقبل الله من مسلم أشرك بعد ما أسلم عملا حتى يفارق المشركين إلى المسلمين ، ما لي آخذ بحجزكم عن النار ، ألا إن ربي داعني ، ألا وإنه سائلي هل بلغت عبادي ؟ وإني قائل رب قد بلغتهم ، فليبلغ شاهدكم غائبكم ، ثم إنكم تدعون مفدمة أفواهكم بالفدام ، ثم أول ما ينبىء عن أحدكم فخذه وكفه ، هاذا دينكم وأين ما تكن يكفيك ) )(@)(@@) ( حم طب ك ) عن بهز عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 9976 ) قال النبي :(@)(@@) | 30 ( بعثني الله حين أسري بي إلى يأجوج ومأجوج فدعوتهم إلى دين الله وعبادته فأبوا أن يجيبوني فهم في النار مع من عصى من ولد آدم وولد إبليس ) )(@)(@@) نعيم بن حماد في الفتن عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9977 ) قال النبي :(@)(@@) | 30 ( بع هاذا وهاذا على حدة ، وهاذا على حدة ، فمن غشنا ليس منا ) )(@)(@@) ( حم ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) ||| ( الباء مع العين(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9978 ) قال 
ms1137	 النبي :(@)(@@) | 30 ( بغض بني هاشم والأنصار كفر ، وبغض العرب نفاق ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV04P027(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9979 ) قال النبي :(@)(@@) | 30 ( بغض العربي للمولى نفاق ) )(@)(@@) ابن لال عن أنس رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الباء مع القاف(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9980 ) قال النبي :(@)(@@) | 30 ( بقي كلها غير كتفها ) )(@)(@@) ( ت ) صحيح عن عائشة رضي الله عنها أنهم ذبحوا شاة ، فقال النبي : ما بقي منها ؟ قالت : ما بقي منها إلا كتفها ، قال : فذكره .(@)(@@)(@@)(@@) ||| ( الباء مع الكاف(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9981 ) قال النبي :(@)(@@) | 30 ( بكاء المؤمن من قلبه ، وبكاء المنافق من هامته ) )(@)(@@) ( عق طب حل ) عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9982 ) قال النبي :(@)(@@) | 30 ( بكروا بالإفطار وأخروا السحور ) )(@)(@@) ( عد ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9983 ) قال النبي :(@)(@@) | 30 ( بكروا بالصلاة يوم الغيم ، فإنه من ترك صلاة العصر حبط عمله ) )(@)(@@) ( حم ه حب ) عن بريدة رضي الله عنه .(@)(@@) PageV04P028(@)(@@)(@@)(@@) ||| ( الباء مع اللام(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9984 ) قال النبي :(@)(@@) | 30 ( بل ائتمروا بالمعروف وتناهوا عن المنكر ، حتى إذا رأيتم شحا مطاعا ، وهوى متبعا ، ودنيا مؤثرة ، وإعجاب كل ذي رأي برأيه ، فعليك بخاصة نفسك ، ودع عنك أمر العوام ، وإن من ورائكم أيام الصبر ، الصبر فيهن مثل القبض على الجمر ، للعامل فيهن مثل أجر خمسين رجلا يعملون مثل عملكم ، قالوا : يا رسول الله أجر خمسين منهم ؟ قال : لا ، بل أجر خمسين منكم ) )(@)(@@) ( د ت ه حب ) عن أبي ثعلبة الخشني رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 9985 ) قال النبي :(@)(@@) | 30 ( بل الله يخفض ويرفع ، وإني لأرجو أن ألقى الله وليس لأحد عندي مظلمة ) )(@)(@@) ( د هق ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 9986 ) قال النبي :(@)(@@) | 30 ( بلغوا عني ولو آية ، وحدثوا عن بني إسرائيل ولا حرج ، ومن كذب علي متعمدا فليتبوأ مقعده من النار ) )(@)(@@) ( حم خ ت ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9987 ) قال النبي :(@)(@@) | 30 ( بلوا أرحامكم ولو بالسلام ) )(@)(@@) ( البزار ) عن ابن عباس ( طب ) عن أبي الطفيل ( هب ) عن أنس وسويد بن عمرو 
ms1138	 رضي الله عنه .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9988 ) قال النبي :(@)(@@) | 30 ( بل مرة واحدة ، فمن زاد فهو تطوع ) )(@)(@@) ( د ه ك ) عن ابن عباس رضي الله عنهما أن الأقرع بن حابس سأل النبي الحج في كل PageV04P029 سنة أو مرة واحدة ؟ قال : فذكره .(@)(@@)(@@)(@@) $ ( 9989 ) قال النبي :(@)(@@) | 30 ( بلغني أنكم تبابعون المثقال بالنصف والثلثين ، فإنه لا يصلح المثقال إلا بالمثقال والورق بالورق ) )(@)(@@) ابن قانع عن رويفع بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9990 ) قال النبي :(@)(@@) | 30 ( بلغني أن أمة من بني إسرائيل مسخت دواب ، فلا أدري أي الدواب هي ) )(@)(@@) الخطيب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9991 ) قال النبي :(@)(@@) | 30 ( بلغني أن أمة فقدت ولا أراها إلا الفار ، وإن أردتم أن تعرفوا ذالك فضعوا لها لبن غنم ولبن بخت ، فإنها تأكل لبن الغنم وتدع لبن البخت ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) ||| ( الباء مع النون(@)(@@)(@@)(@@) |||| من الجامع الصغير وزوائده )(@)(@@)(@@)(@@) $ ( 9992 ) قال النبي :(@)(@@) | 30 ( بنو هاشم وبنو المطلب شيء واحد ) )(@)(@@) ( طب ) عن جبير بن مطعم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9993 ) قال النبي :(@)(@@) | 30 ( بني الإسلام على خمس : شهادة أن لا إلاه إلا الله وأن محمدا رسول الله ، وإقام الصلاة ، وإيتاء الزكاة ، وحج البيت ، وصوم رمضان ) )(@)(@@) ( حم ق ت ن ) عن ابن عمر رضي الله عنهما .(@)(@@) PageV04P030(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 9994 ) قال النبي :(@)(@@) | 30 ( بني الإسلام على خصال : على شهادة أن لا إلاه إلا الله وأن محمدا رسول الله ، والإقرار بما جاء من عند الله ، والجهاد ماض منذ بعث الله رسله إلى آخر عصابة تكون من المسلمين يقاتلون الدجال ، لا ينقصهم جور من جار ولا عدل من عدل ، وأهل لا إلاه إلا الله فلا تكفروهم بذنب ، ولا تشهدوا عليهم بشرك ، والقدر خيره وشره من الله ) )(@)(@@) ابن النجار عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9995 ) قال النبي :(@)(@@) | 30 ( بني الإسلام على خمس : شهادة أن لا إلاه إلا الله ، والصلاة ، وصيام رمضان ، فمن ترك واحدة منهن كان كافرا حلال الدم ) )(@)(@@) ( طب ) عن ابن عباس رضي الله 