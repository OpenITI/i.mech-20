ms181	 چو مهر ز رای تو نورمند %~% شد مملکت چو کوه ز جاه تو استوار(@)(@@) 6 آمیخته هوای تو با دل چو جان و تن %~% و آویخته رضای تو در تن چو پود و تار(@)(@@) 7 جوهر نمی پذیرد بی حکم تو عرض %~% عنصر همی نگیرد بی امر تو قرار(@)(@@) 8 از عفو و خشم تست همه اصل روز و شب %~% وز مهر و کین تست همه طبع نور و نار(@)(@@) 9 از شوق طلعت تو و حرص دعای تو %~% با چشم گشت نرگس و با پنجه شد چنار(@)(@@) 10 از بهر جود دست تو زر زاد و خاک و سنگ %~% وز بهر زیب بزم تو گل داد چوب و خار(@)(@@) 11 در کان ز شرم چشمه یاقوت سرخ شد %~% وین خرده ایست نیکو خاطر بر این گمار(@)(@@) 12 زیرا که کوه مادر او بود و او ندید %~% مر کوه را سزای کف راد تو یسار(@)(@@) 13 از بهر ساز و آلت شاهانه تو را %~% از گونه گونه گوهر خیزد ز کوهسار(@)(@@) 14 وز بهر جشن مجلس فرخنده تو را %~% از نوع نوع گلها روید ز جویبار(@)(@@) 15 تخمی که جز به نام تو در گل پراکنند %~% آن کشت را به ژاله کند ابر سنگبار(@)(@@) 16 گر باد انتقام تو بر بحر بگذرد %~% از آب هر بخار که خیزد بود شرار(@)(@@) 17 ور قطره ای ز جود تو بر خاک برچکد %~% در دشت هر غبار که باشد شود عقار(@)(@@) 18 تا حمله برد جود تو بر گنج شایگان %~% با کس نیاز نیز نپیوست کارزار(@)(@@) 19 تا ملک تو بزاد ز اقبال دولتش %~% گه بر کتف نشاندش و گاه بر کنار(@)(@@) 20 در سهم و ترس مانده چو گاوان ز شرزه شیر %~% شیران کارزاری از آن گرز گاوسار(@)(@@) 21 از هول و هیبت تو بداندیش ملک و دین %~% با جان ممتحن زید و با دل فگار(@)(@@) 22 گاه از فزع چو رنگ 
ms182	 جهد بر فراز کوه %~% گاه از قلق چو مار خزد در شکاف غار(@)(@@) 23 ای اختیار کرده تو را ایزد از جهان %~% هرگز ندید چشم جهان تو اختیار(@)(@@) 24 گر چه فلک ز چشمه خورشید بوته کرد %~% نگرفت هیچ گوهر ملک تو را عیار(@)(@@) 25 بر غور کارهای تو واقف نگشت چرخ %~% گفت اینت بختیاری ای شاه بختیار(@)(@@) 26 عادل زمانه داری قاهر جهانستان %~% بایسته پادشاهی شایسته شهریار(@)(@@) 27 در پیش تخت مملکت تو به طوع و طبع %~% سجده کند جلالت هر روز چند بار(@)(@@) 28 شاها خدای داند و هست او گواه حق %~% تا جان من چه رنج کشید اندرین حصار(@)(@@) 29 تا من پیاده گشتم هستم سوار بند %~% بر جای خویش مانده که بیند چو من سوار(@)(@@) 30 بر سنگ خاره بند گرانم چون بدوخت %~% کز بار آن بماندم بر سنگ سنگ وار(@)(@@) 31 از گوشت پوده کرد مرا هر دو ساق پای %~% این مار بوده آهن گشته گزنده مار(@)(@@) 32 مداح نیکم و گنهم نیست بیش ازین %~% در بند بنده را ملکا بیش ازین مدار(@)(@@) 33 تندست شیر چرخ اجازت مکن بدان %~% کو بیگناه جان چو من کس کند شکار(@)(@@) 34 زین زینهار خوار فلک جان من بخر %~% اکنون که جان بر تو فگندم بزینهار(@)(@@) 35 مگذار زینهار چو در زینهار تست %~% جان مرا بدین فلک زینهار خوار(@)(@@) 36 بسته در انتظار خلاصست جان من %~% جان کندنیست بستن جان را در انتظار(@)(@@) 37 تا آسمان قرار نیابد همی ز دور %~% مهر اندرو ز سیر نگیرد همی قرار(@)(@@) 38 ای مهر شهریاری چون مهر نوربخش %~% وی آسمان رادی چون آسمان ببار(@)(@@) 39 بادی چنانکه خواهی بر تخت مملکت %~% از عمر شادمانه وز ملک شاد خوار(@)(@@) 40 تأیید جفت و بخت به کام و فلک غلام %~% دولت رفیق و چرخ مطیع و خدای یار(@)(@@) 41 خورشید ملک داده هوای تو را فروغ %~% اقبال و بخت کرده خزان تو را 
ms183	 بهار(@)(@@) 42 جشن خجسته مژده همی آردت بر آنک %~% تا حشر بود خواهد ملک تو پایدار(@)(@@) 43 تو یادگار بادی از کرده های خویش %~% هرگز مباد کرده تو از تو یادگار PageV1P127(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای به قدر از برادران برتر %~% مر تو را شد برادر تو پدر(@)(@@) 2 مادر تو چو مادر پدرست %~% پس تو را جده باشد و مادر(@)(@@) 3 زان تو معبود گشته ای آن را %~% که زنش دخترست با خواهر(@)(@@) 4 چون بزایی هم اندر آن ساعت %~% به سوی چرخ برفرازی سر(@)(@@) 5 باز هر بچه ای که زاد از تو %~% در نفس های تو برآرد پر(@)(@@) 6 جایگه های تو چو دشت و چو کوه %~% خوردنی های تو چو خشک و چو تر(@)(@@) 7 گاه زر باشی و گهی یاقوت %~% گاه باشی عبیر و گه عنبر(@)(@@) 8 روی بنمای کاندرین زندان %~% هستیم چون دو دیده اندر خور(@)(@@) 9 هم دواجی مرا و هم جبه %~% هم لحافی مرا و هم بستر(@)(@@) 10 گوهر تو در آفرینش هست %~% برتر و پاک تر ز هر گوهر(@)(@@) 11 در سرشت تو مهر باشد و کین %~% خلق را از تو خیر زاید و شر(@)(@@) 12 حشمت طاهر علی شده ای %~% بر ولی و عدو به نفع و به ضر(@)(@@) 13 داند ایزد که من نشاط کنان %~% کردم از بهر خدمت تو سفر(@)(@@) 14 خویشتن جمله در تو پیوستم %~% راست گویم همی به حق بنگر(@)(@@) 15 از بزرگی کنون روا داری %~% که بمیرم چنین به حبس اندر(@)(@@) 16 گر بدانم که هیچگونه مرا %~% گنهی مضمرست یا مظهر(@)(@@) 17 در شهنشاه عاصیم عاصی %~% در خداوند کافرم کافر(@)(@@) 18 چون امیدم بریده شد ز خلاص %~% چه نویسم ز حال خود دیگر(@)(@@) 19 حال اطفال من چگونه بود %~% گر رسدشان ز من به مرگ خبر(@)(@@) 20 بیش ازین حال خود نخواهم گفت %~% راضیم راضیم به هر چه بتر(@)(@@) 21 همه کوتاه کردم و گشتم %~% قانع 
ms184	 و خوش به هر قضا و قدر(@)(@@) 22 چند از این کاشکی و شاید بود %~% چند باشد ز چند و چون و اگر(@)(@@) 23 دل ازین حبس و بند خوش کردم %~% مگر این عمر بگذرد به مگر(@)(@@) 24 چون همه بودنی بخواهد بود %~% آدمی را چه فایده ز حذر(@)(@@) 25 تو خداوند شاد و خرم زی %~% سال مشمر ز عمر قرن شمر(@)(@@) 26 هیچ انده مخور که دولت تو %~% سازد اسباب تو همی در خور(@)(@@) 27 که شد آب حیات جان افزا %~% بر کف تو نبیند در ساغر(@)(@@) 28 بد این روزگار بدخو را %~% نبود بر تو هیچ وقت گذر(@)(@@) 29 باز بازیچه ای برون آورد %~% گردش این سپهر بازیگر(@)(@@) 30 باد بنگر که در نوشت از باغ %~% بیرم چین و دیبه ششتر(@)(@@) 31 تخت ها گشته ز آهن و پولاد %~% همه زنجیرها بروی شمر(@)(@@) 32 هر زمانی چو نوعروسان مهر %~% درکشد روی خوب در معجر(@)(@@) 33 خشک شد سیب لعل را همه خون %~% در تن از بیم باد چون نشتر(@)(@@) 34 زانکه نارنگ را بدید که باد %~% همه رویش بخست زیر و زبر(@)(@@) 35 راست چون ساقی تو بر کف دست %~% جام زرین نهد همی عبهر(@)(@@) 36 از شکوفه ربیع بزم تو شد %~% گونه آبی و ترنج اصفر(@)(@@) 37 شاد و خرم نشین و باده ستان %~% از بت سرو و قد مه منظر(@)(@@) 38 چو رخ و قد و چشم و عارض او %~% به جمال و بها و زینت و فر(@)(@@) 39 نه نگاریده خامه مانی %~% نه ترازیده رنده آذر(@)(@@) 40 روی نعمت به چشم شادی بین %~% صحن دولت به پای فخر سپر(@)(@@) 41 سر بخت تو سبز باد چو مورد %~% قد قدر تو راست چون عرعر(@)(@@) 42 بر سر جاه تو عمامه عز %~% بر تن عیش تو لباس بطر(@)(@@) 43 چون مه نو زمان زمان افزون %~% عز و جاه تو از شه صفدر(@)(@@) 44 ملک شاه بند شهر 
ms185	 گشای %~% خسرو پیل زور شیر شکر(@)(@@) 45 ملک او باد هفت کشور و باد %~% امر و نهیش روان به هر کشور(@)(@@) 46 از جمالش فروخته ایوان %~% وز کمالش فراخته افسر(@)(@@) 47 پادشاهی او و دولت تو %~% ثابت و پایدار تا محشر(@)(@@) 48 بر من این شعرها به عیب مگیر %~% خواجه بوالفتح راوی مهتر(@)(@@) 49 که چنین مدح بس شگفت بود %~% از چو من عاجز و چو من مضطر(@)(@@) 50 در چنین بند لنگ مانده و لوک %~% در چنین سمج کور گشته و کر(@)(@@) 51 تو به آواز جانفزای بدیع %~% عیب هایی که اندروست ببر PageV1P128(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 محمد ای به جهان عین فضل و ذات هنر %~% تویی اگر بود از فضل و از هنر پیکر(@)(@@) 2 تو را خطیبی خوانند شاید و زیبد %~% که تو فصیح خطیبی به نظم و نثر اندر(@)(@@) 3 گر این لقب را بر خود درست خواهی کرد %~% به وقت خطبه دانش ز عود کن منبر(@)(@@) 4 به لطف و سرعت آبست و باد خاطر تو %~% به تاب و قوت عقلت چه خاک و چه آذر(@)(@@) 5 چو تو قرین و رفیق و چو تو برادر و دوست %~% که داشته است و که دارد بدین جهان اندر(@)(@@) 6 ز حسب حال چو زهر تو زهره ام خون شد %~% که نظم کرده ای آن را به گفته چو شکر(@)(@@) 7 خرد فراوان داری همی چرا نالی %~% ازین دوازده برج نگون و هفت اختر(@)(@@) 8 چرا تو از بره و گاو در فغان باشی %~% که بی سروست یکی زین و بی لگد دیگر(@)(@@) 9 تو از دو پیکر و خرچنگ چون خروش کنی %~% چو بد کنند به تو چون نه اندر جاناور(@)(@@) 10 چه بیم داری از شیر کو ندارد چنگ %~% چه خیر جویی از خوشه کو ندارد بر(@)(@@) 11 تو را چه نقصان کرد این ترازوی خسران %~% که پله هاش فروتر نباشد و برتر(@)(@@) 12 ز کژدم 
ms186	 و ز کمان این هراس و بیم چراست %~% نه دم این را نیش و نه تیر آن را پر(@)(@@) 13 ازین بزیچه بسته دهان چرا ترسی %~% که هرگزش نه چرا گه بد و نه آبشخور(@)(@@) 14 چه جویی آب ز دلوی که آب نیست درو %~% چگونه تر شود ار نیستش بر آب گذر(@)(@@) 15 ز ماهیی که درو خار نیست این گله چیست %~% بلی ز ماهی پر خار دیده اند ضرر(@)(@@) 16 نه پیر خوانی ویحک همی تو کیوان را %~% خرف شدست ازو هیچ نیک و بد مشمر(@)(@@) 17 گر اورمزد توانا و کامران بودی %~% نه در وبالش بودی نه در هبوط مقر(@)(@@) 18 چه خواند باید بهرام را همی خونی %~% به دستش اندر هرگز که دید تیغ و تبر(@)(@@) 19 در آفتاب اگر تاب و قوتی بودی %~% سیاه روی نگشتی ز جرم قرص قمر(@)(@@) 20 سماع ناهید آخر ز مردمان که شنید %~% که خواند او را اخترشناس خنیاگر(@)(@@) 21 چه جادوییست نگویی مرا تو اندر تیر %~% که هر دو مه شود از آفتاب خاکستر(@)(@@) 22 چه بد تواند کردن مهی که گوی زمین %~% کندش تیره از آن پس که باشد او انور(@)(@@) 23 ز اختران که همه سرنگون کنند غروب %~% چه سعد باشد و نحس و چه نفع باشد و ضر(@)(@@) 24 تو ای برادر خود را میفکن از ره راست %~% ز چرخ و اختر هرگز نه خیر دان نه شر(@)(@@) 25 همه قضا و قدر کردگار عالم راست %~% مدان تو دولت و محنت جز از قضا و قدر(@)(@@) 26 زمانه نادره بازیچه ها برون آورد %~% ز بازی فلک مهره باز بازیگر(@)(@@) 27 بدان یقین که بدین گونه آفرید فلک %~% به حکمت آنکه بر این گونه ساختش چنبر(@)(@@) 28 ز بهر شیون زینسان کبود پوشش کرد %~% ز بهر سورش بست از ستارگان زیور(@)(@@) 29 بدید باید عبرت نبود باید کور %~% شنید باید پند و نگشت باید کر(@)(@@) 30 جهانت 
ms187	 عبرت و پندست رفته و مانده %~% تو مانده بازشناس و تو رفته بازنگر(@)(@@) 31 اگر ز مانده نداری خبر عجب نبود %~% ز رفته باری داری چنانکه بود خبر(@)(@@) 32 چو بنگریم همیدون پس از قضای خدا %~% بلای ما همه قزدار بود و چالندر(@)(@@) 33 من و تو هر دو فضولی شدیم و چرخ از بیخ %~% بکندمان و سزاوار بود و اندر خور(@)(@@) 34 ز ترس بر تن ما تیز و تازه افتادی %~% بدان زمان که رگ ما بجستی از نشتر(@)(@@) 35 چو اهل کوشش بودیم و بابت پیکار %~% همی چه بستیم از بهر کارزار کمر(@)(@@) 36 نه دست راست گرفتی به رسم قبضه تیغ %~% نه دست چپ را بودی توان بند سپر(@)(@@) 37 بدانکه ما را در نظم دست نیک افتاد %~% ز خود به جنگ چرا ساختیم رستم زر(@)(@@) 38 نه هر که باشد چیره براندن خامه %~% دلیر باشد بر کار بستن خنجر(@)(@@) 39 کسی که خنجر پولاد کار خواهد بست %~% دلش چو آهن و پولاد باید اندر بر(@)(@@) 40 تنی چو خارا باید سری چو سوهان سخت %~% که پای دارد با دار و گیر حمله مگر(@)(@@) 41 در آن زمان که شود زیر گرد لبها خشک %~% بدان مکان که شود زیر خود سرها تر(@)(@@) 42 همه ز آهن بینند زیور مردان %~% چو خاست گرد کمیت و سمند و جم زیور(@)(@@) 43 دلاوران را دل گردد از هراس دو نیم %~% مبارزان را خون گردد از نهیب جگر(@)(@@) 44 چو لاله گردد پشت زمین به طعن و به ضرب %~% شود چو خیری روی هوا به کر و به فر(@)(@@) 45 خروش رزم چو آواز زیر و بم نبود %~% حدیث کلک دگردان و کار تیغ دگر(@)(@@) 46 نبود باید گوریش تا به آخر عمر %~% که مردمان به چنین ضحک ها شوند سمر(@)(@@) 47 حدیث خویش همی گویم ای برادر من %~% تو زینهار گمان دگر مدار و مبر(@)(@@) 48 تو را نباید کاید 
ms188	 ز من کراهیتی %~% بدین که گفته شد ای نیک رای و ای مهتر(@)(@@) 49 کنون از آنچه خوش آید تو را بخواهم گفت %~% که هست از این پس این دولتی تو را بی مر(@)(@@) 50 گرت چو سرو مسطح همی بپیرایند %~% بدان که زود چو سرو سهی برآری سر(@)(@@) 51 ز صبر جوشن پوش و نبرد مردان کن %~% ز بأس مرکب ساز و مصاف گردان در(@)(@@) 52 تو گرد گبند خضرا برآی و شغل طلب %~% که من هزیمت گشتم ز گنبد اخضر(@)(@@) 53 مرا اگر پس ازین دولتی دهد یاری %~% من و ثنای خداوند و خامه و دفتر(@)(@@) 54 به مدحت ثقت الملک ازین چو دریا دل %~% به غوص طبع برآرم طویله های گهر(@)(@@) 55 عمید مطلق طاهر که سروران هرگز %~% ندیده اند چو او در زمانه یک سرور(@)(@@) 56 بزرگواری دریادلی که در بخشش %~% به پیش جودش دریا کم آید از فرغر(@)(@@) 57 بلند قدرش کرده ست وصف چرخ زمین %~% گشاده طبعش کرده ست نعمت بحر شمر(@)(@@) 58 ز ابر رادی وز مرغزار نعمت او %~% نه آز گردد تشنه نه مکرمت لاغر(@)(@@) 59 قلق نگشته است از قرب او مرگ خامه %~% تهی نرفته است از دست او مگر ساغر(@)(@@) 60 ندیده اند ز ایوان جاه او کنگر %~% نجسته اند ز دریای فضل او معبر(@)(@@) 61 ز اوج همت او چرخ ها شود تیره %~% ز موج بخشش او گنج ها برد کیفر(@)(@@) 62 به هیچ وقت نبودست بی سخا دستش %~% چنانکه هیچ نبودست بی عرض جوهر(@)(@@) 63 چو بحر مادر طبع سخاش بود رواست %~% که هست خوی خوش او برادر عنبر(@)(@@) 64 به دوست گردان اقبال دین و ملک آری %~% نگردد اختر بی چرخ و چرخ بی محور(@)(@@) 65 برستم از همه غم کو به چشم بخشایش %~% ز صدر جاه به من بنده تیز کرد نظر(@)(@@) 66 خدای داند کامروز اندرین زندان %~% زجود و بخشش او نعمتست بس بی مر 
ms189	(@)(@@) 67 همی ز رحمت او باشدم درین دوزخ %~% نسیم سایه طوبی و چشمه کوثر(@)(@@) 68 نه من ببینم در هر شرف چو او مخدوم %~% نه او بیابد در هر هنر چو من چاکر(@)(@@) 69 اگر خلاصی باشد مرا و خواهد او %~% نباشدم هوس لشکر و هوای سفر(@)(@@) 70 من آستانه درگاه او کنم بالین %~% بخسبم آنجا و ایمن شوم ز رنج سهر(@)(@@) 71 برون کنم ز سرم کبر و باد بی خردی %~% ز علم لشکر سازم ز اهل علم حشر(@)(@@) 72 شوم به نانی قانع به جامه ای راضی %~% به خط عقل تبرا کنم ز عجب و بطر(@)(@@) 73 همه به خشتک شلوار برنشینم و بس %~% نه اسب تازی باید مرا نه ساز بزر(@)(@@) 74 چه سود ازین سخن چون نگار و شعر چو در %~% چو ما به محنت گشتیم هر دو زیر و زبر(@)(@@) 75 دو اهل فضل و دو آزاده و دو ممتحنیم %~% دو خیره رای و دو خیره سر و دو خیره بصر(@)(@@) 76 دعای ماست به هر مسجد و به هر مجلس %~% دریغ ماست به هر محفل و به هر محضر(@)(@@) 77 تو نو گرفتی در حبس و بند معذوری %~% اگر بترسی ازین بند و بشگهی ز خطر(@)(@@) 78 منم که عشری از عمر شوم من نگذشت %~% مگر به محنت و در محنتم هنوز ایدر(@)(@@) 79 به جای مانده ام از بندهای سخت گران %~% ضعیف گشته ام از رنج های بس منکر(@)(@@) 80 نوان و سست شده رویم از طپانچه کبود %~% در آب دیده نمانم مگر به نیلوفر(@)(@@) 81 شده بر آب دو دیده سبک تر از کشتی %~% اگر چه بندی دارم گران تر از لنگر(@)(@@) 82 بلا و محنت و اندوه و رنج و محنت و غم %~% دمادمند به من بر چو قطره های مطر(@)(@@) 83 ز بس که گویم امروز این بلا بودست %~% تمام نام بلاها مرا شدست از بر(@)(@@) 84 ز ضعف پیری 
ms190	 گشته ست چون گلیم کهن %~% به حبس رویم و بوده چو دیبه ششتر(@)(@@) 85 ز بی حمیتی ای دوست چو غلیواجم %~% نه ماده خود را دانم کنون همی و نه نر(@)(@@) 86 علاج را گزر پخته می خورم زیرا %~% که آن چو سخت گزر سست شد چو برگ گزر(@)(@@) 87 دریغ شخص که از بند شد نحیف و دوتا %~% دریغ عمر که در حبس شد هبا و هدر(@)(@@) 88 همی به شعر کنم ساحری از آن باشد %~% همیشه حالم چون حال ساحران به سحر(@)(@@) 89 بسان آذر و مانی بتگر و نقاش %~% بلا و محنت بینم همی به زندان در(@)(@@) 90 از آن که می به پرستند گفت های مرا %~% بسان صورت مانی و لعبت آذر(@)(@@) 91 زمانه را پسری در هنر زمن به نبست %~% چرا نهان کندم همچو بد هنر دختر(@)(@@) 92 چرا به عمر چو کفار بسته دارندم %~% اگر یکی ام از امتان پیغمبر(@)(@@) 93 بدین همانا زین امتم نمی شمرند %~% که می برون نگذارندم از عذاب سقر(@)(@@) 94 همی سخن ها گرم آیدم کز آتش دل %~% دهان چو کوره شد و شد زبان درو اخگر(@)(@@) 95 توزان که لختی محنت کشیده ای در حبس %~% بدین که گفتم دانم که داریم باور(@)(@@) 96 یقین بدان که نه مردست خصم دانش من %~% اگر چه پوشد در جنگ جوشن و مغفر(@)(@@) 97 بلی ولیک قلمدان ز دوکدان بگریخت %~% به عاقبت بتر آمد عمامه از معجر(@)(@@) 98 بکوفتم دری از خم قلتبان باز %~% بگو بروتی باز ایدر آمدم زان در(@)(@@) 99 خرم و نیم خرم و ابله و مخنث من %~% خرد ندارم و دیوانه زادم از مادر(@)(@@) 100 وز آنکه نادان بودم چو گرد کردم ریش %~% مرا به نام همه ریش گاو خواند پدر(@)(@@) 101 چو حال فضل بدیدم که چیست بگزیدم %~% ز کار پیشه جولاهگی ز بهر پسر(@)(@@) 102 بدو نوشتم و پیغام دادم و گفتم %~% که ای سعادت در 
