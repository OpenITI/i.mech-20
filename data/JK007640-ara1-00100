ms81	 % % إذا سكروا أحلى من السكر المصري % % 17(@)(@@) % هنالك أعطينا الخلاعة حقها % % وقمنا إلى اللذات نعثر بالسكر % % 18(@)(@@) % إلى أن بدا للصبح خفق بنوده % % وطار غراب الليل عن بيضة الفجر % % 19(@)(@@) % وغارت نجوم الليل من حسن معشر % % خلائقهم أبهى من الأنجم الزهر % % 20(@)(@@) % بلوت الليالي عسرة بعد يسرة % % وكم ذقت من حلو المذاق ومن مر % % PageV01P250 21(@)(@@) % فما أبلت الأيام جدة عزمتي % % ولا أخذت تلك الحوادث من صبري % % 22(@)(@@) % إذا لم تكن لي في النوائب صاحبا % فما أنت من خيري ولا أنت من شري % % 23(@)(@@) % وليس تفي مثل الصوارم والقنا % % إذا عبثت أيدي المودات بالغدر % % 24(@)(@@) % إذا أنا أنفيت الهوان بمنزل % تركت احتمال الضيم فيه إل غيري % % 25(@)(@@) % وما العز في الدنيا سوى ظهر سابح % % يقرب ما ينأى من المهمة القفر % % 26(@)(@@) % سواء لديه الوعر والسهل إن جرى % % ولف الربا بالسهل والسهل بالوعر % % 27(@)(@@) % تعود جوب البيد فاعتاد قطعها % % فأنجد في نجد وأغور في غور % % 28(@)(@@) % عتيق من الخيل الجياد كأنه % % لشدته صخر وما قد من صخر % % 29(@)(@@) % وناصيته ميمونة منه أعلنت % بأن لها فيه مقدمة النصر % % 30(@)(@@) % وإن جياد عندي هو الغنى % % وليس الغنى بالمال والبيض والصفر % % PageV01P251 31(@)(@@) % وأشهب يكسوه الصباح رداءه % % كما أشرق الإسلام في ملة الكفر % % 32(@)(@@) % أبى أن يشق اللاحقون غباره % % فكالبرق إذ يهفو وكالريح إذ تسري % % 33(@)(@@) % إذا ما امتطاه رفعت وجرى به % % رأت أعيني بحرا ينوف على بحر % % 34(@)(@@) % أعد له عند الشدائد عدة % وأرصده فيها إلى الكر والفر % % 35(@)(@@) % فتى المجد من أهل الصدارة في العلى % % وليس محل القلب إلا من الصدر % % 36(@)(@@) % تناظر جدواه السحائب بالندى % % وأنى له جدوى أنامله العشر % % 37(@)(@@) % إذا جئته مسترفدا منه رفده % % فنل منه ما تهوى من النائل الغمر % % 38(@)(@@) % وحسبك من أيد تدفق جورها % % وناهيك من وجه تهلل بالبشر % % 39(@)(@@) % كما سقت المزن الرياض عشية % فأصبح زهر الروض مبتسم الثغر % % 40(@)(@@) % بياض يد تندى ومخضر مربع % % تروق برغد العيش في الخطط الغبر % % PageV01P252 41(@)(@@) % وما زال موصول الصلات ودأبه 
ms82	 % % من البر أن يسديه برا إلى بر % % 42(@)(@@) % مكارمه لا تترك المال وافرا % وهل تركت تلك المكارم من وفر % % 43(@)(@@) % وما ادخرت للدهر مالا يد امرئ % يعد الثناء المحض من أنفس % % 44(@)(@@) % كما لم يزل يرجى لكل ملمة % % ويعرف فيه الأمن في مواطن الذعر % % 45(@)(@@) % ولا خير في عيش الفتى وحياته % % إذا لم يكن للنفع يرجى وللضر % 46(@)(@@) % له المنطق العذب الذي راق لفظه % % رمى كل منطق من الناس بالحصر % % 47(@)(@@) % فلا ينطق العوراء سخطا ولا رضى % قريب من الحسنى بعيد من الهجر % % 48(@)(@@) % سواء إذا أثرى وأملق جوده % % جواد على الحالين في العسر واليسر % % 49(@)(@@) % صبور على الأيام كيف تقلبت % % جليد شديد البأس فيها على الدهر % % 50(@)(@@) % وقد أخلصته الحادثات بسبكها % % فكان بذاك السبك منخالص التبر % % PageV01P253 51(@)(@@) % إذا ما حمدنا في الرجال ابن أحمد % % فعن خالص في الود بالسر والجهر % % 52(@)(@@) % يعطر أرجاء القوافي ثناؤه % % ورب ثناء كان أذكى من العطر % % 53(@)(@@) % نشرنا له الصحف التي كان طيها % % على طيب ذات فيه طيبة النشر % % 55(@)(@@) % ولي في أبيه قبله وهو أهلها % % محاسن أوصاف تضيق عن الحصر % % 56(@)(@@) % فيا أيها المولى الذي عم فضله % % لك الفضل فاسمع إن تكن سامعا شعري % % 57(@)(@@) % خدمتك في حر الكلام مدائحا % فقال لسان الحال يا لك من حر % % 58(@)(@@) % وقد راق شعري في ثنائك كله % % ألا إن بعض الشعر ضرب من السحر % % 59(@)(@@) % فخذها منالداعي قصيدة أخرس % % عليك مدى الأيام تنطق بالشكر % % 60(@)(@@) % تريني لدى علياك ما قد يسرني % % وترفع قدري فيك يا رفعت القر % % PageV01P254 البحر : بسيط تام 1(@)(@@) % لله در أبي داود من رجل % يستنزل العصم من مستعصم القلل % % 2(@)(@@) % لو رام قلع الجبال الشم ما تركت % % والفائزون بما يرجون من أمل % % 3(@)(@@) % له من الله في سلم ومعترك % % بأس الحديد وجود العارض الهطل % % 4(@)(@@) % شيخ حماها بفتيان إذا زأروا % % تخوفتهم أسود الغيل بالغيل % % 5(@)(@@) % حفت به من بني نجد أغيلمة % أعدهم لنزول الحادث الجلل % % 6(@)(@@) % إذا دعاهم أبو داود يومئذ % جاؤوا إليه 
ms83	 بلا مهل على عجل % % 7(@)(@@) % المدركون بعون الله ما طلبوا % % والفائزون بما يرحبون منأمل % % 8(@)(@@) % كم فتكة لسليمان بهم فتكت % % وما تقول بفتك الفارس البطل % % 9(@)(@@) % لقد قضى الله بالنصر العزيز له % % فيما قضاه من التقدير في الأزل % % 10(@)(@@) % والله أعطاه في خلق وفي خلق % % الصدق بالقول والإخلاص بالعمل % % PageV01P255 11(@)(@@) % جاء الصريخ إليه يستجير به % % مستنجدا منه بالخطية الذيل % % 12(@)(@@) % فجهز الجيش والظلماء عاكفة % والرعد والبرق ذو ومض وذو زجل % % 13(@)(@@) % سرى إلى القوم في ليل يضل به % % سرب القطا وجبان القوم في الكلل % % 14(@)(@@) % بحيث لا يهتدي الهادي بها سبلا % يهديهم الرأي منها أوضح السبل % % 15(@)(@@) % فوارس بلغت نجد بهم شرفا % يسمو وفي غير طعن الرمح لم ينل % % 16(@)(@@) % فأدركت من عداكم كل ما طلبت % فصار يضرب فيها اليوم بالمثل % % 17(@)(@@) % وصبحتهم ببيض الهند عادية % فأصبحت وهي حمر الحل والحلل % % 18(@)(@@) % قتل وأسر وإطلاق يمن به % % على العدو وإرسال بلا رسل % % 19(@)(@@) % فكان عيد من الأعياد سر به % % أهل الحفيظة من حاف ومنتعل % % 20(@)(@@) % إذ يحشر في ذاك النهار ضحى % والخيل قد أقبلت بالشاء والإبل % % PageV01P256 21(@)(@@) % هذا هو الفخر لا كأس تدار على % % شرب ولا نغم الأوتار بالغزل % % 22(@)(@@) % فليهنك الظفر العالي الذي انقلبت % % به أعاديك بعد الخزي بالفشل % % 23(@)(@@) % وقر عينا فدتك الناس في ولد % % يحيي المناقب من آبائك الأول % % 24(@)(@@) % فأرخوه وقالوا يوم مولده % % يقر عين سليمان الزهير علي % % PageV01P257 البحر : كامل تام 1(@)(@@) % قلب يذوب عليك وجدا % % وحشى توقد منك وقدا % % 2(@)(@@) % وجفون صب لا تزال % % بهذه العبرات تندى % % 3(@)(@@) % من زفرة تحت الضلوع % % تمد سيل الدمع مدا % % 4(@)(@@) % يا قامة الغصن الرطيب % % ومقلة الرشأ المفدى % % 5(@)(@@) % وسيوف لحظك إنها % % قد جاوزت في القتل حدا % % 6(@)(@@) % ساعات بينك لا أزال % % أعدها للهجر عدا % % 7(@)(@@) % وأقول هل يدنو الوصال % وتنجز الآمال وعدا % % 8(@)(@@) % ما لي مراح من هواك % % ولا لهذا الشوق مغدى % % 9(@)(@@) % كم عاذل قد لامني % % فسددت عنه السمع سدا % % 10(@)(@@) % وعصيت عذالي عليك % % وقلت للوام بعدا 
ms84	 % % PageV01P258 11(@)(@@) % إني لأرعى عهد من % % لم يرع لي في الحب عهدا % % 12(@)(@@) % يا ويح نفسي قد حفظت % وضيع الأحباب ودا % % 13(@)(@@) % ولقد شربت هواهم % % بالروح قبل اليوم نقدا % % 14(@)(@@) % وفقدت صبري بعدهم % % لا ذاق من أهواه فقدا % % 15(@)(@@) % وأنا الفداء لمالك % بأجل من ولي الأمور % % 16(@)(@@) % كالغصن قدا والبنفسج % % عارضا والورد خدا % % 17(@)(@@) % يا ظبي كم صرعت عي % % ونك قبلنا في الدهر أسدا % % 18(@)(@@) % ورمت فلم تخط الفؤاد % % بسهم ذاك اللحظ عمدا % % 19(@)(@@) % وسقام هاتيك الجفون % % لقد عداني بل تعدى % % 20(@)(@@) % ولقد ذكرتك والهموم % % تمر بي عكسا وطردا % % PageV01P259 21(@)(@@) % والليل يقدح شهبه % % في فحمة الظلماء زندا % % 22(@)(@@) % فقضت دموعي واجبا % % في مثل ذكرك أن يؤدى % % 23(@)(@@) % أحييته بك حسرة % وقضيته أرقا وسهدا % % 24(@)(@@) % هزل اصطباري في جفاك % % وعاد هزل الوجد جدا % % 25(@)(@@) % وألانني الدهر المشوم % وهدني بالبين هدا % % 26(@)(@@) % لولاك كنت على الزمان % % كما يريد الحزم صلدا % % 27(@)(@@) % أمعذبي من غير ذنب % صبوة وجوى وصدا % % 28(@)(@@) % أنت الذي أغويتني % % حتى رأيت الغي رشدا % % 29(@)(@@) % وهواك أضناني فك % % نت من الضنى عظما وجلدا % % 30(@)(@@) % أطلقت دمعي بعدما % % قيدتني بالوجد قيدا % % PageV01P260 31(@)(@@) % وصحبت وجدي في هواك % % فكان لي خصما لدا % % 32(@)(@@) % تالله لا أجد المدام % لذيذة والعيش رغدا % % 33(@)(@@) % مذ قوضت عني الظعون % % وأزمعت للبين سعدى % % 34(@)(@@) % فهناك أظفر بالمنى % % وأفوز في جدواه قصدا % % 35(@)(@@) % حلو الفكاهة لو تذاق % % وجدتها خمرا وشهدا % % 36(@)(@@) % وأروح أزجر طائرا % في أسعد الأمراء سعدا % % 37(@)(@@) % ما في الرجال نظيره % % فيهم لهذا القرم ندا % % 38(@)(@@) % لا زال يكبت حاسدا % في مجده ويغيظ ضدا % % 39(@)(@@) % فجواته وثوابه % % قد أعجبا أخذا وردا % % 40(@)(@@) % ومناقب مأثورة % % نظمت بجيد الدهر عقدا % % PageV01P261 41(@)(@@) % % وجادها حلا وعقدا % % 42(@)(@@) % بلغت به غاياتها % % العليا ولم يبلغ أشدا % % 43(@)(@@) % حملت يداه كالغمامة % % للندى برقا ورعدا % 44(@)(@@) % فاستهده في كل خير % % إنه في الخير أهدى % % 45(@)(@@) % وبذلك الخلق الحميد % % وسعته شكرا وحمدا % % 46(@)(@@) % الجامع الفضل الذي % % أمسى وأصبح فيه فردا % % 47(@)(@@) % غمر العفاة بنائل % منه إلى العافين 
ms85	 يسدى % % 48(@)(@@) % من راح يسقى من نداه % % فلا أظن الدهر يصدى % % 49(@)(@@) % وإذا تصدى للجميل % % فثق به فيما تصدى % % 50(@)(@@) % يا من يحيل سمومها % % إن شاء بعد الحر بردا % % PageV01P262 51(@)(@@) % كم بشر استبشاره % % بالرفد قبل النيل رفدا % % 52(@)(@@) % خذها ولا الإبل الشوارد % % بالثناء عليك تحدى % % 53(@)(@@) % فاهنأ بعيد لا يزال % % كما تؤمل مستجدا % % 54(@)(@@) % لا يحرمني منك ححظ % بالأبوة قد تردى % % 55(@)(@@) % ولقد أساء بما جنى % % حتى امتلت عليه حقدا % % 56(@)(@@) % أنى وكيف وهل أرى % % 57(@)(@@) % من كان حر زمانه % % كان الزمان عليه وغدا % % PageV01P263 البحر : طويل 1(@)(@@) % لقد خفقت في النحر ألوية النصر % وكان انمحاق الشر في ذلك النحر % % 2(@)(@@) % وفتح عظيم يعلم الله أنه % % ليستصغر الأخطار من نوب الدهر % % 3(@)(@@) % علت كلمات الله وهي علية % بحد العوالي والمهندة البيتر % % 4(@)(@@) % تبلج دين الله بعد تقطب % ولاحت أسارير العناية والبشر % % 5(@)(@@) % محا البغي صمصام الوزير كما محا % % دجى الليل في أضوائه مطلع الفجر % % 6(@)(@@) % وكر البلا في كرباء فأصبحت % % مواقف للبلوى ووقفا على الضر % % 7(@)(@@) % غداة أبادت مفسدي أهل كربلا % % وكرت مواضيه بها أيما كر % 8(@)(@@) % فدانت وما دانت لمن كان قبله % % من الوزراء السابقين إلى الفخر % % 9(@)(@@) % وما أدركوا منها مراما ولا منى % ولا ظفروا منها بلب ولا قشر % % 10(@)(@@) % وحذرهم من قبل ذلك بطشه % % وأمهلهم شهرا وزاد على الشهر % % PageV01P264 11(@)(@@) % وعاملهم هذا الوزير بعدله % % وحاشاه من جور % % 12(@)(@@) % وأنذرهم بطشا شديدا وسطوة % وبالغ بالرسل الكرام وبالنذر % % 13(@)(@@) % ولو يصبر القوم الوزير عليهم % % لقيل به عجز وما قيل عن صبر % % 14(@)(@@) % وصال عليهم عند ذلك صولة % % ولا صولة الضرغام بالبيض والسمر % % 15(@)(@@) % وسار بجيش والخميس عرمرم % % فكالليل إذ يسري وكالسيل إذ يجري % % 16(@)(@@) % وقد أفسدوا شر الفساد بأرضهم % % إلى أن أتاهم منه بالفتكة البكر % % 17(@)(@@) % رمتهم بشهب الموت منه مدافع % لها شرر في ظلمة كالقصر % % 18(@)(@@) % رأوا هول يوم الحشر في موقف الردى % % وهل تنكر الأهوال في موقف الحشر ؟ % 19(@)(@@) % فدمرهم تدمير عاد لبغيهم % % بصاعقة لم تبق للقوم من 
ms86	 ذكر % % 20(@)(@@) % ألم ترهم صرعى كأن دماءهم % % تسيل كما سالت متعقة الخمر % % PageV01P265 21(@)(@@) % وكم فئة قد خامر البغي قلبها % % على أنها بأحبولة الحصر % % 22(@)(@@) % فراحت بها الأجساد وهي طريحة % تداس على ذنب جنته لدى الوزر % % 23(@)(@@) % فإن مراد جار على الورى % % ولا بد أن يجرى ولا بد أن يجري % % 24(@)(@@) % تجول المنايا بينهم بجنودها % % بحيث مجال الحرب أضيق من شبر % % 25(@)(@@) % تلاطم فيها الموج والموج من دم % تلاطم موج البحر في لجة البحر % % 26(@)(@@) % فلاذوا بقبر ابن النبي محمد % % فهل سر في تدميرهم صاحب القبر % % 27(@)(@@) % فإن تركوا لا تترك السيف قتلهم % % وإن ظهروا باؤوا بقاصمة الظهر % % 28(@)(@@) % ولا برحت أيامه الغر غرة % تضيء ضياء الشمس في طلعة الظهر % % 29(@)(@@) % ولا زال في عيد جديد مؤرخا % فقد جاء يوم العيد بالفتح والنصر % % PageV01P266 البحر : وافر تام 1(@)(@@) % متى يشفى بك الصب العميد % % ويبلغ من دنوك ما يريد % 2(@)(@@) % شج يحييه وصل من حبيب % % ويقلته التجنب والصدود % % 3(@)(@@) % ونحن من المسرة في راض % تحاك من الربيع لها برود % % 4(@)(@@) % وبنت الكرم قد طلعت علينا % % يكلل تاجها الدر النضيد % % 5(@)(@@) % معتقة تسر النفس فيها % % وقد طافت بها حسناء رود % % 6(@)(@@) % وقد صدحت على الأغصان ورق % فأغصان النقا إذ ذاك ميد % % 7(@)(@@) % تعيد علي ما تبدي غراما % فكم تبدي الغرام وكم تعيد % 8(@)(@@) % تجاوبها الغواني بالأغاني % % فيطربنا لها ناي وعود % % 9(@)(@@) % فحينئذ يدار على الندامى % % مذاب التبر والماء الجمود % % 10(@)(@@) % ويرجم كل شيطان مريد % بحيث الهم شيطان مريد % % PageV01P267 11(@)(@@) % سقى أيام لهو في زرود % % وما ضمت معانيها زرود % % 12(@)(@@) % نجدد ذكرها في كل يوم % وهل يبقى مع الذكر الجديد % % 13(@)(@@) % فقد مرت لنا فيها ليال % كما نظمت قلائدها % % 14(@)(@@) % ليال لم نكن نصغي للاح % أينقص بالملامة أم يزيد % % 15(@)(@@) % فكم في الحب من لاح لصب % يفيد بزعمه ما لا يفيد % % 16(@)(@@) % أحبتنا لقد طال التنائي % % وحالت بيننا بيد فبيد % % 17(@)(@@) % فيا زمن الصبا هل من رجوع % % ويا عهد الشباب متى تعود ؟ % 18(@)(@@) % سلام الله 
ms87	 أحبابي عليكم % % إلى بغداد يحملها البريد % % 19(@)(@@) % يهيج لوعتي وجد طريف % لكم ويشوقني وجد تليد % % 20(@)(@@) % فهل أخبرتم أني بحال % يساء بها من الناس الحسود % % PageV01P268 21(@)(@@) % تقر البصرة الفيحاء عيني % % بما يولي محمدها السعي % % 22(@)(@@) % فتى لا زال يوليني نداه % % ويغمرني له كرم وجود % % 23(@)(@@) % تدفق منهلا عذبا فراتا % فلي من عذب منهله ورود % % 24(@)(@@) % ولولا بره طبت نفسا % ولم يخضر لي في الدهر عود % % 25(@)(@@) % أشاهد منه إذ يبدو هلالا % وبدرا من مطالعه السعود % % 26(@)(@@) % وغيث كلما ينهل جو % وليثا كلما خفقت بنود % % 27(@)(@@) % فدته الناس من رجل كريم % تنبه للجميل وهم رقود % % 28(@)(@@) % وشيد ما بنته من المعالي % % له الآباء قدما والجدود % % 29(@)(@@) % فتى من هاشم بيض الأيادي % % بحيث حوادث الأيام سود % 30(@)(@@) % رؤوف بالملم له رحيم % صديق صادق بر ودود % % PageV01P269 31(@)(@@) % ومن آوى إليه وحل منه % % بأكرام ما تحل به الوفود % % 32(@)(@@) % فقد آوى إلى ركن شديد % % وليس كمثله ركن شديد % % 33(@)(@@) % هم آل النبي وكل فضل % % لديهم يستفيد المستفيد % % 34(@)(@@) % هم يوم النوال بحار جود % % وفي يوم النزال هم الأسود % % 35(@)(@@) % فمن جود تصوب به الغوادي % % ومن بأس يلين له الحديد % % 36(@)(@@) % هم الأقطاب والأنجاب فينا % % إذا دارت دوائرها الوجود % % 37(@)(@@) % وإن عرضت كرامتهم علينا % % فما للمنكرين لها جحود % % 38(@)(@@) % وما احتاج النهار إلى دليل % % وقد شهدت به منه شهود % % 39(@)(@@) % فمنها ما نشاهده عيانا % إذا ما النار أضرمها الوقود % % 40(@)(@@) % وللأكفاء يومئذ عليهم % % هبوط في الحضيض ولا صعود % % PageV01P270 41(@)(@@) % رجال كالجبال إذا اشمخرت % تبيد الراسيات ولا تبيد % % 42(@)(@@) % يخلد ذكرهم في كل عصر % % وما للمرء في الدنيا خلود % % 43(@)(@@) % فيا بيت القصيد إليك تهدى % % من العبد الرقيق لك القصيد % % 44(@)(@@) % فيطربك النشيد وكل حر % كريم الطبع يطربه النشيد % % 45(@)(@@) % فأنك والثناء عليك مني % % وما أمليته طوق وجيد % % 46(@)(@@) % كما خدمت سواليها العبيد % % فمثلك في الأكارم من يسود % % 47(@)(@@) % وما استغنيت بكل حال % % وهل يغني عن الماء الصعيد ؟ % 48(@)(@@) % ونلت بك المراد من الأماني % % فنلت من 
ms88	 المهيمن ما تريد % % PageV01P271 البحر : وافر تام 1(@)(@@) % إلى شعبان مولاي المفدى % % ربيع الفضل والروض النضير % % 2(@)(@@) % إلى من لم تزل أيديه فينا % % كأمثال القلائد في النحور % % 3(@)(@@) % يعرج بي الغرام وينثني بي % % لأسباب تمر من الخطور % % 4(@)(@@) % وقد سأل الأمير الأمس عني % % وعن سبب القعود عن المسير % % 5(@)(@@) % ومن كرم السجايا والمزايا % % إذا سأل الكبير عن الصغير % % 6(@)(@@) % وقالوا كيف لا تمضي إليه % % فترجع بالسرور وبالحبور % % 7(@)(@@) % فلم أكشف لهم عن كنه أمري % % وأطلعهم على ما في ضميري % % 8(@)(@@) % وما تركي زيارته بقصدي % % ولا كان انقطاعي عن قصوري % % 9(@)(@@) % وما استغنيت لا أبيك عنه % % غنى الظامي عن الماء النمير % % 10(@)(@@) % ولامن دون شرعته ورودي % % ولا من غير مورده صدوري % % PageV01P272 11(@)(@@) % نهاري عنده لمعان برق % وليلي بعده ليل الضرير % % 12(@)(@@) % فظاظة حاجب وردي حظ % يعوق العبد عن باب الأمير % % 13(@)(@@) % وجدت ببابه البواب يعدو % % أشد علي من كلب عقور % % 14(@)(@@) % وصار الكلب ينبحني بسب % ويكثر بالنبيح وبالهرير % % 15(@)(@@) % وأكره أن أكون له مجيبا % وما أنا من مجاوبة الشرير % % 16(@)(@@) % فهل أبصرتم كلبا يحامي % % محافظة على الليث الهصور % % 17(@)(@@) % لمن أشكو الحجاب ومن نصيري % % وأبدي الاعتذار ومن عذيري % % PageV01P273 البحر : بسيط تام 1(@)(@@) % حييت من قادم حل السرور به % % وما له عن مقام العز تأخير % 2(@)(@@) % إن الشدائد والأهوال قد ذهبت % وللخطوب استحالات وتغيير % % 3(@)(@@) % أرتك صدق مودات الرجال بها % % وبآن عندك صدق القول والزور % 4(@)(@@) % ولم تجد كسليمان لديك أخا % عليك منه جميل الصنع مقصور % % 5(@)(@@) % شكرا لأفعاله الحسنى فإن له % % يدا عليك وذاك الفعل مشكور % % 6(@)(@@) % لقد وفى لك واسترضى المشير فما % % أبقى قصورا ولا في الباع تقصير % % 7(@)(@@) % إن المشير أعز الله دولته % % بر رحيم لديه الذنب مغفور % % 8(@)(@@) % كأنني بك مغمور بنعمته % % وأنت ملحوظ عين السعد منظور % % 9(@)(@@) % أهدى إليك سلاما من سعادته % % لطف فيه إشارات وتفسير % % 10(@)(@@) % فسوف يغنيك من سلطانه نظر % وإنما نظر السلطان إكسير % % PageV01P274 11(@)(@@) % قد كان ما كان والأقدار جارية % ولا يفيد مع الأقدار تدبير 
ms89	 % % 12(@)(@@) % حسب الفتى من قضاء الله معذرة % % والمرء فيما قضاه الله معذور % % 13(@)(@@) % وابشر بما سوف تحظى من عنايته % % وأنت منه بما يرضيك مسرور % % 14(@)(@@) % والنصر فيك له والخير أجمعه % % وإنما أنت يا منصور منصور % % PageV01P275 البحر : طويل 1(@)(@@) % نعم ما لهذا الأمر غيرك صالح % وإن قيل هل من صالح قيل صالح % 2(@)(@@) % سعيت إلى نيل العلى غير كادح % وغيرك يسعى للعلى وهو كادح % % 3(@)(@@) % وتاجرت للمجد الذي أنت أهله % % وأنت بهاتيك التجارة رابح % % 4(@)(@@) % فهنيت من بين الشيوخ بخلعة % شذاها بأقطار العراقين فائح % % 5(@)(@@) % مطار فخار طار في الأرض صيته % % فأنت مقيم وهو في الأرض سائح % % 6(@)(@@) % بعلياك قد شد الوزارة أزرها % % وزير لأبواب الأبوة فاتح % % 7(@)(@@) % وإن مشيرا قد أشار بما رأى % % مشير لعمري في الحقيقة ناصح % % 8(@)(@@) % رأى بابن عيسى بعد عيسى صلاحها % % وفي صالح الأعمال تقضى المصالح % % 9(@)(@@) % ورجح منك الجانب الضخم في العلى % % وفي الناس مرجوح وفي الناس راجح % % 10(@)(@@) % لعل بك النار التي شب جمرها % % من القوم تطفى وهو إذ ذاك لافح % % PageV01P276 11(@)(@@) % وقد طوحت من بعد عيسى وبندر % % وفهد بهاتيك الديار الطوائح % % 12(@)(@@) % بكتها وقد تبكي المنازل أعين % وناحت على تلك الرسوم النوائح % % 13(@)(@@) % وكانت أمور قد أصابت فدمرت % % وما حسنت في العين منها المقابح % % 14(@)(@@) % أمور قضت إن لا يرى الأمن قاطن % لديها ولم يفرح بما كان نازح % % 15(@)(@@) % وجرت من الأرزاء كل جريرة % % وسالت ولكن بالدماء الأباطح % % 16(@)(@@) % وقد جردوها بعد آل محمد % % مثقفة تدمى وبيض صفائح % % 17(@)(@@) % وكانت حروب يعلم الله أنها % % سعير أهاجته الرياح اللوافح % % 18(@)(@@) % وما نفعت فيهم نصيحة ناصح % % وهل نفعت في الجاهلين النصائح ؟ % 19(@)(@@) % فذلك مقتول وذلك قاتل % % وذلك مجروح وذلك جارح % % 20(@)(@@) % إلى أن بلغت اليوم ما قد بلغته % % وما هذه الأقسم إلا منائح % % PageV01P277 21(@)(@@) % ولاحت لنا منك المعالي بروقها % % وبرق المعالي من محياك لائح % % 22(@)(@@) % وما أنت عما تبتغيه ببارح % % وغيرك عنها لا محالة بارح % % 23(@)(@@) % وإن أحجم المقدام عن طلب العلى % % فإنك مقدام إليها 
ms90	 وجامح % % 24(@)(@@) % وإن غض طرف عن مكارم ماجد % % فلا طرف إلا نحو جدواك طامح % % 25(@)(@@) % نعم أنتم البحر الخضم لوارد % % وأين من البحر الخضم الضحاضح % % 26(@)(@@) % منحت الذين استمطروك مكارما % وكل كريم بالمكارم مانح % % 27(@)(@@) % ليأمن في أيامك الغر خائف % ويصدح في روض البشارة صادح % % 28(@)(@@) % فخذها لدى علياك أول مدحة % % ولي فيكم من قبل هذا مدائح % % PageV01P278 البحر : كامل تام 1(@)(@@) % أنا في هواكم مطلق ومقيد % وبقربكم أجد الحياة وأفقد % 2(@)(@@) % إن تعطفوا فهو المنى أو تهجروا % % فحسى تذوب ولوعة تتوقد % % 3(@)(@@) % يا دمع عيني المراق له دمي % % ما لي على الزفرات غيرك مسعد % % 4(@)(@@) % ولقد وجدت الوجد غير مفارقي % % وفقدت صبري وهو مما يفقد % % 5(@)(@@) % لا تسألوا عن حال صب بعدكم % % لا يومه يوم ولا غده غد % 6(@)(@@) % لا دمعه يرقا ولا هذا الجوى % % بفنى ولانار الجوانح تخمد % % 7(@)(@@) % وأنا المريض بكم فهل من ممرض % % غير الصبابة فلتعدني العود % 8(@)(@@) % بنتم فما للمستهام على النوى % % جلد يقر بمثله المتجلد % % 9(@)(@@) % هلا وقفتم يوم جد رحيلكم % % مقدار ما يتزود المتزود % % 10(@)(@@) % أشكوكم ما بي وإن لم تسمعوا % % وأريكم وجدي وإن لم تشهدوا % % PageV01P279 11(@)(@@) % ولكم أقول لكم وقد أبعدتم % % يا معبدون بحقكم لا تبعدوا % % 12(@)(@@) % ساروا وما عطفوا علي بلفتة % ولربما انعطف القوم الأملد % % 13(@)(@@) % أتبعتهم نظري فكان وراءهم % % يقفو الأحبة أغوروا أو أنجدوا % % 14(@)(@@) % يا أخت مقتنص الغزال لقد رمى % % قلبي بناظره الغزال الأغيد % 15(@)(@@) % ومن القدود كما عليمت مثقف % % ومن النواظر في الفؤاد مهند % % 16(@)(@@) % لم أنس لا نسيت ليالينا التي % % كان السرور بعودها يتجدد % % 17(@)(@@) % والربع مبستم الأقاح تعجبا % منها وبانات النقا تتأود % % 18(@)(@@) % لو أبصرت عيناك جامد كأسنا % % لرأيت كيف يذاب فيها العسجد % % 19(@)(@@) % في روضة سقيت أفاويق الحيا % % فالبان يرقص والحمام يغرد % % 20(@)(@@) % تملي من الأوراق في ألحانها % % كقلائد العقيان فيه محاسن % % PageV01P280 21(@)(@@) % يحكي سقيط الطل في أرجائها % % دررا على أغصانها تتنضد % % 22(@)(@@) % يا دارنا سحبت عليك ذيولها % % وطفاء تبرق ما سقتك وترعد % % 23(@)(@@) % هل أنت 
ms91	 راجعة كا شاء الهوى % % والعيش أطيب ما يكون وأرغد % % 24(@)(@@) % ذهبت بأيام الشباب وأعرضت % عني بجانبها الحسان الخرد % % 25(@)(@@) % ويل أم نازلة المشيب فإنها % % كادت يشيب لها الغراب الأسود % % 26(@)(@@) % ذهب الشباب فما يقول معنف % في القلب منه حرارة لا تبرد % % 27(@)(@@) % من بعدما طال المقام فأقصروا % % عني الملام فصوبوا أم صعدوا % % 28(@)(@@) % ذهب الزمان بحلوه وبمره % % ومضى المؤمل فيه والمستنجد % % 29(@)(@@) % فانظر بعينك هل يروقك منظر % % بعد الذين تفرقوا وتبددوا ؟ % 30(@)(@@) % إن الجميل وأهله ومحله % % وأبو الجميل ابن الجميل محمد % % PageV01P281 31(@)(@@) % حدث ولا حرج عليك فإنما % % خير الكرام إلى أعلاه يسند % % 32(@)(@@) % وأعد حديثك و شف في ترداده % % قلبا يلذ إليه حين يردد % % 33(@)(@@) % المسبغ النعماء ليس يشوبها % % من ولا فيما يؤمل موعد % % 34(@)(@@) % هذا أبي الضيم وابن أباته % % والبيض تركع والجماجم تسجد % % 35(@)(@@) % يهن القوي بقوة من بأسه % % وإلى الضعيف تحنن وتودد % % 36(@)(@@) % تفري برأيك غير ما تفري الظبا % % فالرأي منصلت وسيفك مغمد % % 37(@)(@@) % يعد الأماني من نداه بفوزها % % ويريع منه الأخسدين توعد % % 38(@)(@@) % ممن إذا تليت عليه قصيدة % صدق القصيد وفاز فيه المقصد % % 39(@)(@@) % كم قربت لي فيه آمالي به % % أملا يشق على سواه ويبعد % % 40(@)(@@) % فرأيت من معرفة ما لابرى % % ووجدت من معناه ما لا يوجد % % PageV01P282 41(@)(@@) % وإذا أفادك جاهه أو ماله % % فهناك عز يستفاد وسؤدد % % 42(@)(@@) % شيدت معاليه وطال علاؤه % % إن المعالي كالبناء تشيد % 43(@)(@@) % كم من يد بيضاء أشكرها % % نعم تعد ولم تزل تتعدد % % 44(@)(@@) % ولكم وردت البحر من إحسانه % % لا ماؤه ملح ولا هو مزبد % % 45(@)(@@) % فوردت أعذب فهل من ماجد % % لي مصدر عن راحتيه ومورد % % 46(@)(@@) % مستودع فيما يثيب مثابه % % بخزائن الله التي لا تنفد % % 47(@)(@@) % أمزيل نحس الوافدين بسعده % % شقيت بك الحساد فيما تسعد % % 48(@)(@@) % حتى علمت ولم أكن بك جاهلا % يا ثالث القمرين أنك مفرد % % 49(@)(@@) % إني ربيب وأبيك وابن جميله % % والله يعلم والخلائق تشهد % % 50(@)(@@) % لي نسبة فيكم وأية نسبة % % PageV01P283 51(@)(@@) % إن تولدوا من صلب أكرم والد % % فكذلك الأخلاق 
ms92	 قد تتولد % % 52(@)(@@) % من محتد زاكي العناصر طيب % % طابت عناصرهم وطاب المحتد % % 53(@)(@@) % هم عودوا الناس الجميل وإنهم % % تجري عوائدهم على ما عودوا % % 54(@)(@@) % إني لأعهد بعد فقد أبيهم % % ما كنت منه قبل ذلك أعهد % % 55(@)(@@) % قد كان عز المسلمين ومجدهم % % وعياذهم وهو الأعز الأمجد % % 56(@)(@@) % ومخلد الذكر الجميل إلى مدى % يبقى وما في العالمين مخلد % % 57(@)(@@) % تتلى مناقبه ويذكر فضله % % 58(@)(@@) % كقلائد العقبان فيه محاسن % % جيد الزمان بعقدها يتقلد % % 59(@)(@@) % جاد الغمام على ثراه فإنه % % لأبر من صوب الغمام وأجود % % PageV01P284 البحر : وافر تام 1(@)(@@) % ألا من مبلغ سلامي % % رئيسا في العراق على النظام % % 2(@)(@@) % تحية مخلص بالود يبدي % % صبابة ذي فؤاد مستهام % % 3(@)(@@) % ويبلغه على البعد اشتياقا % من الداعي إلى الشهم الهمام % % 4(@)(@@) % لقد طلعت فائله علينا % % طلوع البدر في جنح الظلام % % 5(@)(@@) % سنشطره على ما كان منه % % كشكر الروض آثاره الغمام % % 6(@)(@@) % وما أسداه من كرم السجايا % % وفاء بالمودة والذمام % % 7(@)(@@) % زهت في ناصر أبيات شعر % % أتت في المدح من حر الكلام % % 8(@)(@@) % لقد أثنى الرئيس بها عليه % % ثناء باحترام واحتشام % % 9(@)(@@) % تسر بها لعمري أولياء % وتعقد عنه السنة الخصام % % 10(@)(@@) % وإن الفضل يعرفه ذووه % % به امتاز الكرام عن اللئام % % PageV01P285 11(@)(@@) % رآه مدحت الدنيا حساما % % وقد يغنيه عن حمل الحسام % % 12(@)(@@) % فقدمه المشير ليوم بؤس % يقد من الخوارج كل هام % % 13(@)(@@) % فيا لله من وال مشير % عظيم الشأن عالي القدر سامي % % 14(@)(@@) % لئن باهت به الزوراء رأبت % بهمته على حلب وشام % % 15(@)(@@) % إذ انتظم العراق به فأضحى % % يفاخر غيره بالانتظام % % 16(@)(@@) % ودمر بالصوارم مفسديها % % وأوردهم بها ورد الحمام % % 17(@)(@@) % ومد إلى الحسا كفا فطالت % % ونال بطولها صعب المرام % % 18(@)(@@) % رمى من بالعراق عصاة نجد % وزير ما رمى مرماه رامي % % 19(@)(@@) % وأدى خدمة عظمت وجلت % بهمته لسلطان الأنام % % PageV01P286 البحر : طويل 1(@)(@@) % ألما على لومي وجدا مجددا % فإني لأدري ما الضلال وما الهدى % % 2(@)(@@) % فمن مبلغ السلوان عني بأنني % % فنيت وشوقي لا يزال مخلدا % % 3(@)(@@) % عذولي انتصاح منك لا أستفيده 
ms93	 % % ومن عده عدلا فقد جار واعتدى % % 4(@)(@@) % وما كان أدرى بالذي قد دريته % % واخطأ ذاك العذل لما تعمدا % % 5(@)(@@) % أعلل نفسي بالعذيب وكلما % % أردت به إطفاء وجدي توقدا % % 6(@)(@@) % خليلي ضاع القلب هل تعرفانه % % مشوق فؤادي عندما رحلوا فدى % % 7(@)(@@) % وما أسفي إلا على عمر مغرم % % قضاه ولكن في تبعدكم سدى % % 8(@)(@@) % ولم تدر أجفاني بكم سنة الكرى % % وما زال طرفي في هواكم مسهدا % % 9(@)(@@) % وآه على يوم قضى الأنس نحبه % % توسد عرفان الهوى إذ توسدا % % 10(@)(@@) % ليالي فيها العيش كان اخضراره % % رقيق الحواشي بالمطالب أوردا % % PageV01P287 11(@)(@@) % أخلاي كم جاد الزمان بنيلها % % وهل كان طرف الدهر عنهن أرمدا % % 12(@)(@@) % وأوردنا صفو المنى فكأنه % % على وجنة الأيام كان توردا % % 13(@)(@@) % قسا قلبكم عني ولا غرو حيث لي % % حظوظ تعيد الماء إذ ذاك جلمدا % % 14(@)(@@) % وما كنت لولا الحظ أحظى لأنني % % قدحت زناد الجد فيكم فأصلدا % % 15(@)(@@) % تمادى مداكم استمر على الجفا % % وقد كاد أن يقضي مداكم على المدى % % 16(@)(@@) % ومن لعليل أنحف السقم جسمه % % تردى ولكن من ضنى وجده ردا % % 17(@)(@@) % وإن اصطباري بعد طول بعادكم % % دعا جلدا منه يبين التجلدا % % 18(@)(@@) % أعيدا لها ذكر الديار لعلها % % تبلغني تلك المعاهد مقصدا % % 19(@)(@@) % ولما أتت تلك الطلول ورسمها % % غدت تشتكي شكوى الفراق كما غدا % % 20(@)(@@) % أنادي الحمى بالنوح عن ساكن الحمى % % فيا حبذا لو أنه يسمع الندا % % PageV01P288 21(@)(@@) % تكر به الأشواق من كل جانب % % إذا كرر الذكرى لديه ورددا % % 22(@)(@@) % وما مر بالجرعاء إذ عاد ذكره % % أعاد عليه وجده فتجددا % % 23(@)(@@) % بياض محيا ذلك العيش بعدكم % % فما زال ذاك الوجه أغبر أسودا % % 24(@)(@@) % رأى البين مجموعا على القرب شملنا % % فبدده منا النوى فتبددا % % 25(@)(@@) % شذا ورد ذاك الوصلم روض قربكم % % هار اشتياقي كلما هب غردا % % 26(@)(@@) % ونشواتكم ما قد أفاق ولا ارعوى % % غدا مثل ما أمى اوأمسى كما غدا % % 27(@)(@@) % وقد جاب وعر الشوق في بيد هجركم % % ومن زاد تقواه عن العزل زودا % % 28(@)(@@) % أضل فإهدى في هواكم وينثني % % إلي هوى يهدي 
ms94	 عيانا ويهتدى % % 29(@)(@@) % رشاد عبيد الله للحق إنه % % سنا نور رشد فيه يستأنس الهدى % % 30(@)(@@) % درى كل علم في الوجود وجوده % % ولم تدر يمناه سوى السيف والندى % % PageV01P289 31(@)(@@) % يحل عقود المشكلات برأيه % % إذا أشكل المعنى الدقيق وعقدا % % 32(@)(@@) % وأحيا دورس العلم درسه % % بدت فيه آثار الفضائل مذ بدا % % 33(@)(@@) % لعمرك فليفخر على السؤدد امرؤ % يرى السؤدد العلياء مجدا وسؤؤدا % % 34(@)(@@) % وأفصح من نهج البلاغة منطقا % تخر له الأقلام في الطرس سجدا % % 35(@)(@@) % به استسهلوا حزن العلوم ووعرها % % وأيسر شيء عنده ما تشددا % % 36(@)(@@) % إذ أضرمت أعداؤاه نار باطل % أثار عليها الحق يوما فأخمدا % % 37(@)(@@) % فلو رام أسباب السماء لنالها % % وسار بمضمار المرام وما كدا % % 38(@)(@@) % وما مال إلا للعبادة والتقى % % كأن عنه شيطان الوساوس صفدا % % 39(@)(@@) % وماهو إلا قطب دائرة العلى % % إمام لأرباب الطريقة مقتدى % % 40(@)(@@) % تنيل نوال اليمن يمناه بسطها % % وما مد إلا نحو خالقه يدا % % PageV01P290 41(@)(@@) % ولم تبلغ الآمال في غير ماله % % وفي غير ذاك العذب لا ينقع الصدى % % 42(@)(@@) % ألا يا سحابا أغرق الوفد غيثه % % لظامي الندى كانت أياديه موردا % % 43(@)(@@) % فلو حاول المجد الأثيل مقامه % % لحاول ذاك المجد بالمجد أمجدا % % 44(@)(@@) % مكارم طبع في علاه ظهورها % % وكان لهاتيك المكارم موعدا % % 45(@)(@@) % وأنبت بالتقوى بأحسن منبت % وقد طاب أصلا مثلما طاب محتدا % % 46(@)(@@) % يقضي لعمر الله صوما نهاره % % ويحيي لياليه دعا وتعبدا % % 47(@)(@@) % ولما أدعى ما إن أتى الدهر مثله % % فأتبع فيما يدعيه وقلدا % % 48(@)(@@) % وأشرع للشرع الحنيف مناهجا % قواعد دين الله أضحى ممهدا % % 49(@)(@@) % تصرفه في باطن الحال باطن % % إلى الرشد أصحاب الحقيقة أرشدا % % 50(@)(@@) % ومتبع شرعا لما هو ذاهب % ومذهبه ينحو طريقة أحمدا % % PageV01P291 51(@)(@@) % وما كان إلا حين يسأل رده % % بأسرع من حاك يجاوبه الصدى % % 52(@)(@@) % وأدرك ممن فضله يملأ الفضا % % تعد أياديه بألسنة العدى % % 53(@)(@@) % ولله فيما قد أنالك حكمة % % فأعدم فيك الجهل والعلم أوجدا % % 54(@)(@@) % سعيت ويجدي السعد بالسعي ربه % % وأصبحت في صدر السعادة أسعدا % % 55(@)(@@) % فيا زهر روض أنتم زهر كمه % لقد 
ms95	 ماس غصن الفخر فيكم تأودا % % 56(@)(@@) % ظهرتم ولا يخفى ممن الشمس نورها % % وحادي انتشار الذكر في ذكركم حدا % % 57(@)(@@) % إذا ما مضى منكم عن المجد سيد % أقام لكم في موقف الفخر سيدا % % 58(@)(@@) % وذكرك حتى يقضي الله أمره % % على طول ما طال الزمان تأبدا % % 59(@)(@@) % أبرت على ما تدعيه يمينها % % متى تقسم الأيام إنك مفردا % % 60(@)(@@) % ولما دعاك الأصل يوما لفرعه % % وردت فما أبقيت للناس موردا % % PageV01P292 61(@)(@@) % رواة المعالي عن جنابك أخبروا % % حديثا عنالعلياء صح وأسندا % % 62(@)(@@) % ويورد عنك المدح والحمد كله % % كمالك يروينا كما لك أوردا % % 63(@)(@@) % غياث وغوث لا يجارى جواده % % وملجأ من آويت كنت ومنجدا % % 64(@)(@@) % ونلت بتوفيق العناية رتبة % % عدوك يلقى دونها مورد الردى % % 65(@)(@@) % وحسب الذي عاداك فيما يرومه % % جعلت عليه ليل هجرك سرمدا % % 66(@)(@@) % على رغم من عاداك قلت مؤرخا % بفتوى عبيد الله لا زال يقتدى % % PageV01P293 البحر : وافر تام 1(@)(@@) % ليهنك ما بلغت من الأماني % % فلم تبرح بأيام التهاني % % 2(@)(@@) % تسر وقد تسر الناس طرا % ببيض فعالك الغر الحسان % % 3(@)(@@) % وفيما قد فعلت جزيت خيرا % وهل تجزى سوى خلد الجنان % % 4(@)(@@) % وأولمت الولائم فاستلذت % لها الفقراء من قاص ودان % 5(@)(@@) % وأكثرت الطعام بهن حتى % % لقد ضاق الطعام عن الجفان % % 6(@)(@@) % وجاء الناس أفواجا إليها % % فلم يعرف فلان من فلان % % 7(@)(@@) % شرابهم شرراب سكري % ومما يشتهون لحوم ضان % % 8(@)(@@) % لقد قيل الطعام فلم تدان % % وقد قيل السماع فلم تدان % % 9(@)(@@) % بذكر الله إنك قبل هذا % % قد استغنيت عن كل الأغاني % % 10(@)(@@) % وماتلهو عن السبع المثاني % % بأصوات المثالث والمثاني % % PageV01P294 11(@)(@@) % ختنت بنيك في أيام سعد % بمعتدل الفصول من الزمان % % 12(@)(@@) % وأربعمائة ختنت وكانت % % يتامى لم تسنن بالختان % % 13(@)(@@) % كسوتهم الملابس فاخرات % فراحوا مثل روض الأقحوان % % 14(@)(@@) % فمن خضر ومن صفر وحمر % كأمثال الشقيق الأرجواني % % 15(@)(@@) % كازهار الربيع لها ابتهاج % وقد سقيت حيا المزن الهتان % % 16(@)(@@) % أتيت بها من الصدقات بكرا % وما كانت لعمرك بالعوان % % 17(@)(@@) % أردت بذاك وجه الله لا ما % % يقال ويستفاض من اللسان % % 18 
ms96	(@)(@@) % أحبك لا لمال أقتنيه % % ولا طمع بجود وامتنان % % 19(@)(@@) % ولا أثني عليك الخير إلا اعت % % قادا باللسان وبالجنان % % 20(@)(@@) % وكيف وأنت للإسلام ركن % تشاد به القواعد والمباني % % PageV01P295 21(@)(@@) % أعز الله فيك الدين عزا % ولم يك قبل ذلك بالمهان % % 22(@)(@@) % فكنت الروح والمعنى المعالي % % فقل عن روح المعاني % % 23(@)(@@) % تقول الحق لا تخشى ملاما % ولست عن المقالة بالجبان % % 24(@)(@@) % ولا أدريت أو ما ريت قوما % برفعة منصب وعلو شان % % 25(@)(@@) % ولم تحكم على أمر بشيء % إلى أن يستبين إلى العيان % % 26(@)(@@) % فتدرك ما تحاول بالتأني % % وإن رمت الجميل فلا توان % % 27(@)(@@) % محمد الأمين أمنت مما % % تحاذره وإنك في أمان % % 28(@)(@@) % كفاك الله ألسنة حدادا % لها وخز ولا وخز السنان % % 29(@)(@@) % ولم أسمع مقالا فيك إلا % مقال الخير آنا بعد آن % % 30(@)(@@) % بقيت لنا وللدنيا جميعا % وكل غير وجه الله فان % PageV01P296 البحر : وافر تام 1(@)(@@) % بدا والصبح غار على الظلام % وعقد النجم محلول النظام % 2(@)(@@) % فحيا بالرضاب وبالحميا % % فأحيا بالرضاب وبالمدام % 3(@)(@@) % إذا ما الشيخ في الكأس احتساها % % غدا في الحال أنشط من غلام % % 4(@)(@@) % لئن عللتني يا صاح يوما % بأحبابي فعللني بجام % % 5(@)(@@) % دعا عني الملامة في التصابي % % فقد روعتماني بالملام % % 6(@)(@@) % ألا صاحبي وبي غرام % % أعيناني على داء الغرام % % 7(@)(@@) % ويا ريح الصبا النجدي بلغ % سليمى يا صبا نجد سلامي % % 8(@)(@@) % ومن لي بالكرى يوما لعلي % % أرى طيف المليحة بالمنام % % 9(@)(@@) % وما أنسى لها في الركب قولي % % وقد نظرت لأجفان دوامي % % 10(@)(@@) % نحولي ما بخصرك من نحول % وسقمي ما بطرفك من سقام % % PageV01P297 11(@)(@@) % سقى الأثلاث في سلع سيولا % فقد جلبت حمائمها حمامي % % 12(@)(@@) % بكيت وما بكت في الدوح ورق % تظن هيامها أبدا هيامي % % 13(@)(@@) % ولو كان الهوى من غير دمع % % قضينا بالغرام على الحمام % % 14(@)(@@) % أداوي مهجة يا سعد جرحى % % رماها من رماة الحسن رام % % 15(@)(@@) % رمين قلوبنا غزلان سلع % % فما أخطأت هاتيك المرامي % % 16(@)(@@) % فبت جريح ألفاظ مراض % ورحت طعين ذياك القوام % % 17(@)(@@) % قدود البيض لا سمر العوالي % % ولحظ 
ms97	 السرب لاحد الحسام % % 18(@)(@@) % كتمت الحب متهما عليه % % وما لي طاقة بالإكتتام % % 19(@)(@@) % وكيف أطيق والعبرات مني % % تعبرعن فؤاد مستهام % % 20(@)(@@) % وما نقص اشتياق الصب شيئا % على وجه حكى بدر التمام % % PageV01P298 21(@)(@@) % يدب هواك يا سلمى بروحي % % دبيب الصرخدية في العظام % % 22(@)(@@) % وفيت بعهد من نقضت عهودي % % وما لوفاء مي من دوام % % 23(@)(@@) % فليت المالكية حين صدت % % رعيت ذمامها ورعت ذمامي % % 24(@)(@@) % صبرت على الحوادث صبر حر % يرى بالصبر إبلاغ المرامي % % 25(@)(@@) % وقلت معللا نفسي ولكن % مقالي كان أصدق من حذام % % 26(@)(@@) % سأحمد عند محمود السجايا % % عواقب أمر أخطار عظام % % 27(@)(@@) % واستغني به عما سواه % % كما يغني الركام عن الجهام % % 28(@)(@@) % وأرجو أن تظفرني سريعا % عنايته بغايات المرام % % 29(@)(@@) % لقد درت سحائبه إلى أن % زهت فيهن أزهار الكلام % % 30(@)(@@) % فحدث عن مكارمه فإني % % لتعجبني أحاديث الكرام % % PageV01P299 31(@)(@@) % إذا ما جئتني بحديث جود % لقرم جوده كالغيث هامي % % 32(@)(@@) % فما حدثت إلا عن أشم % % ولا أخبرت إلا عن همام % % 33(@)(@@) % ذكاء فيه أورى من زناد % وكف منه أندى من غمام % % 34(@)(@@) % وآراء إذا نفذت لأمر % فهن اليوم أنفذ من سهام % % 35(@)(@@) % يرى فعل الجميل عليه فرضا % كمفترض الصلاة مع الصيام % % 36(@)(@@) % وقام له على الأعناق شكر % % فلا يقضى إلى يوم القيام % % 37(@)(@@) % سريع الجود إن يدع لحسنى % % وها هو ذا بطيء الانتقام % % 38(@)(@@) % أياديه حطمن المال جودا % % فما أبقت يداه من حطام % % 39(@)(@@) % على أبوابه الآمال منا % % قد ازدحمت لنا أي ازدحام % % 40(@)(@@) % تخير ما تشاء وسله تعطى % % من ابن المصطفى خير الأنام % % PageV01P300 41(@)(@@) % تيقن أن أمرك سوف يقضى % % إذا ما شمت منه سنا ابتسام % % 42(@)(@@) % أخو الهمم التي تحكي المواضي % % وتفيك فتك خواض القتام % % 43(@)(@@) % تسامى مجده فعلا محلا % وإن محل أهل المجد سامي % % 44(@)(@@) % جميلك قاطن في كل أرض % وذكرك سار جوان الموامي % % 45(@)(@@) % طميت وأنت يوم الجود بحر % % وبحرك لا يزال الدهر طامي % % 46(@)(@@) % ومن جدواك كم قد سال سيل % فروى سيلا جودك كل ظامي % % 47(@)(@@) % لقد أوليتني نعما 
ms98	 جساما % فما أهداك للنعم الجسام % % 48(@)(@@) % دعاك لأمره المولى علي % فكنت وأنت في أعلى مقام % % 49(@)(@@) % وعدت لديه يا عين المعالي % % برأيك ناظرا أمر النظام % % 50(@)(@@) % فتم لجيشه المنصور أمر % % وإن الأمر يحسن بالتمام % % PageV01P301 البحر : رمل تام 1(@)(@@) % عد عن من لج في قال وقيل % أنا لا أصغي إلى قول العذول % % 2(@)(@@) % وأعد لي ذكر من صح الهوى % % منه بالطرق وبالجسم العليل % % 3(@)(@@) % فقد الصبر مع الوجد فما % % لاذ بالصبر عن الوجه الجميل % % 4(@)(@@) % من قدود طعنت طعن القنا % % ولحاظ فتكت فتك النصول % % 5(@)(@@) % دنف لولا تباريح الجوى % % ما قضى الوجد عليه بالنحول % % 6(@)(@@) % كلما شام سنا بارقه % % جد جد الوجد بالدمع الهمول % % 7(@)(@@) % إن ما أضرم في أحشائه % % لا أرى المحنة كالحب ولا % % 8(@)(@@) % وإذا هبت به ريح صبا % % راح يستسفي عليل بعليل % % 9(@)(@@) % كبد حرى ودمع واكف % فهو ما بين حريق وسيول % % 10(@)(@@) % لو تراه إذ نأت أحبابه % % تطأ الأرض بوخد وذميل % % PageV01P302 11(@)(@@) % لا تسل عن ما جرى كيف جرى % % سائل الدمع على الخد الأسيل % % 12(@)(@@) % أي يوم يوم سارت عيسهم % % ودعا داعي نواهم بالرحيل % % 13(@)(@@) % وتراني بعدهم أشكو الأسى % % يفلق الهام بريا من فلول % % 14(@)(@@) % وبرسم الدار من أطلالهم % % ما بجسمي من سقام ونحول % % 15(@)(@@) % بخلوا بالوصل لما أعرضوا % % ومن البلوى نوال من بخيل % % 16(@)(@@) % ليت شعري ولكم أشكو إلى % % بارد الريقة من حر الغليل % % 17(@)(@@) % لا أرى المحبة كالحبولا % % كالهوى للصب من داء قتول % % 18(@)(@@) % بأبي من أخذت أحداقه % % مهجة الوامق بالأخذ الوبيل % % 19(@)(@@) % وشفائي قرب من أسقمني % % بسقام الطرف والخصر النحيل % % 20(@)(@@) % هل علمتم أن أحداق المها % % خلقت حينئذ سحر العقول % % PageV01P303 21(@)(@@) % يا ديارا لأحباء نأت % % ألناء عنك يوما من وصول ؟ % 22(@)(@@) % كان روض العيش فيها يانعا % قبل أن آذن عودتي بالذيول % % 23(@)(@@) % بمدام أشرقت أقداحها % % بزغت كالشمس في ثوب الأصيل % % 24(@)(@@) % وشدت ورقاء في أفنانها % % أوتيت علما بموسقى الهديل % % 25(@)(@@) % حبذا اللهو وأيام الصبا % % وشمال وكؤوس من شمول % % 26(@)(@@) % وندامى نظمتهم ساعة % وقعت منا 
ms99	 بأحضان القبول % % 27(@)(@@) % عللاني بعدها من عودها % % بمرام غير مرجو الحصول % % 28(@)(@@) % إذ مضت وهي قصيرات المدى % % فلها طال بكائي وعويلي % % 29(@)(@@) % جهل اللائم ما بي ورأى % % أن يفيد العلم نصحا من جهول % % 30(@)(@@) % لا ينال الحمد في مدحي له % % من يعد الفضل من نوع الفضول % % PageV01P304 31(@)(@@) % وأراني والحجى من أربي % % في عريض الجاه ذي الباع الطويل % % 32(@)(@@) % كلما أنظمها قافية % % تنظم الإحسان في قول مقول % % 33(@)(@@) % وعلى خفتها في وزنها % % تطأ الحساد بالقول الثقيل % % 34(@)(@@) % بالغ في كل يوم مر بي % % من أبي عيسى نوالا من منيل % % 35(@)(@@) % لا يريني العيش إلا رغدا % في نعيم من جميل ابن الجميل % % 36(@)(@@) % ينظر النجم إلى عليائه % % نظر المعجب بالطرف الكليل % % 37(@)(@@) % يرتقيها درجات في العلى % % فترى الحاسد منها في نزول % % 38(@)(@@) % قصرت عن شأوه حساده % % وانثنى عنهم بباع مستطيل % % 39(@)(@@) % نسب الجود إلى راحته % % نسبة السحر إلى الطرف الكحيل % % 40(@)(@@) % وروى نائله عن سيبه % % ما روى الري عن الغيث الهطول % % PageV01P305 41(@)(@@) % كاد أن تمزجه رقته % % بنسيم من صبا نجد بليل % 42(@)(@@) % أيها الآخذ عن آبائه % % سنن المعروف بالفعل الجميل % % 43(@)(@@) % % عجزت عنها فحول من فحول % % 44(@)(@@) % هذه الناس التي في عصرنا % % ما رأينا لك فيهم من مثيل % % 45(@)(@@) % شرف أوضح من شمس الضحى % % ليس يحتاج سناها لدليل % % 46(@)(@@) % إن هززناك هززنا صارما % % 47(@)(@@) % أسأل الله لك العز الذي % % كان من أشرف آمالي وسولي % % 48(@)(@@) % دائم النعمة منهل الحيا % % مورد الظامي بعذب سلسبيل % % 49(@)(@@) % فلنعمائك عندي أثر % أثر الوابل في الروض المحيل % % 50(@)(@@) % لو شكرت الدهر ما خولتني % % لا أفي حق كثير من قليل % % PageV01P306 51(@)(@@) % إنما أنتم غيوث في الندى % % وإذا كانت وغى آساد غيل % % 52(@)(@@) % نجباء من كرام نجب % وكسوني كل فضفاض الذيول % % 53(@)(@@) % وأروني العز خفضا عيشه % % والردى أهون من عيش الذليل % % 54(@)(@@) % زينوا شعري بذكرى مجدهم % % في أعاريض فعيل وفعول % % 55(@)(@@) % إنهم فضل وبأس وندى % % زينة الافرند للسيف الصقيل % % 56(@)(@@) % وزكت أعراقهم منذ نمت % % بفروع زاكيات وأصول % % 57(@)(@@) % في 
ms100	 سبيل الله ما قد أنفقوا % % لليتامى ولأبناء السبيل % % 58(@)(@@) % أنفقوا أموالهم وادخروا % % حسنات الذكر في المجد الأثيل % % 59(@)(@@) % تخلق الدهر وتكسو جدة % % وتعيد الذكر جيلا بعد جيل % % 60(@)(@@) % يا نجوما أشرقت في أفقنا % % لا رماك الله يوما بالأفول % % PageV01P307 61(@)(@@) % أنتم الكنز الذي أدخره % % للملمات من الخطب الجليل % % 62(@)(@@) % وإليكم ينتهي لي أمل % كاد أن يطمعني بالمستحيل % % 63(@)(@@) % كم وكم لي فيكم من مدح % رفعت ذكري بكم بعد الخمول % % 64(@)(@@) % فمتى أغدو إلى إحسانكم % % إنما أغدوا إلى ظل ظليل % % 65(@)(@@) % لم أزل أحظى لديكم بالغنى % % والعطاء الجم والمال الجزيل % % PageV01P308 البحر : رمل تام 1(@)(@@) % ضحك البرق فأبكاني دما % وجرى دمعي له وانسجما % % 2(@)(@@) % وأهاخ الوجد في إيماضه % % كبدا حرى وقلبا مغرما % % 3(@)(@@) % من سنا لاح ومن برق أضا % % ما بكى الوامق إلا ابتسما % % 4(@)(@@) % فكأن البرق في جنح الدجى % % ألبس الظلماء بردا معلما % % 5(@)(@@) % باح في الحب بأسرار الهوى % % وأبى سر الهوى أن يكتما % % 6(@)(@@) % يا أخلائي وهل من وقفة % بعدكم بالجزع من ذاك الحمى % % 7(@)(@@) % أنشد الدار التي كنتم بها % % ناشدا أطلالها والأرسما % % 8(@)(@@) % يا ديارا بالغضا أعهدها % % مربض الأسد ومحراب الدمى % % 9(@)(@@) % سولت للدمع أن يجري بها % % وقضت للوجد أن يضطرما % % 10(@)(@@) % كان عهدي بظباء المنحنى % % تصرع الظبية فيه الضيغما % % PageV01P309 11(@)(@@) % وبنفسي بين أسراب المها % % ظالم لم يعف عمن ظلما % % 12(@)(@@) % إن في أحداق هاتيك الظبا % % صحة تورث جسمي سقما % % 13(@)(@@) % ومليح بابلي طرفه % % ساحر المقلة معسول اللمى % % 14(@)(@@) % حرم الله دمي وهو يرى % % أنه حل له ما حرما % % 15(@)(@@) % أشتهي عذب ثناياه التي % % جرعتني في هواه العلقما % % 16(@)(@@) % وصلت أيامه وانقرضت % % أفكانت ليت شعري حلما % % 17(@)(@@) % عللاني بعسى أو ربما % % فعسى تغني عسى أو ربما % % 18(@)(@@) % حار حكم الحب في الحب فما % % أنصف المظلوم ممن ظلما % % 19(@)(@@) % ليته يعدل في الحكم بنا % % عدل داود إذا ما حكما % % 20(@)(@@) % أيد الله به الدين امرؤ % % كان للدين به مستعصما % % PageV01P310 21(@)(@@) % بلغ الرشد كمالا وحجى % % قبل أن يبلغ فيها الحملا % % 22(@)(@@) % ومباني 