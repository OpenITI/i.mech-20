ms141	 محمد بن كعب، عن ابن عباس.(@)(@@) وصالح هذا كذاب.(@)(@@)(@@)(@@) $ 969 - «لا بأس بذبيحة العود والحجر والقصبة إذا أهرق الدم» .(@)(@@) رواه يحيى بن أبي أنيسة، عن أبي الزبير، عن جابر.(@)(@@) ويحيى هذا قال أخوه زيد بن أبي أنيسة: لا يكتب عنه، وإنه كذاب.(@)(@@)(@@)(@@) | 970 -(@)(@@) «لا بر إلا بر الأموات، ولا يصل أهل القبور إلا المؤمنون» .(@)(@@) PageV00P000(@)(@@) رواه يحيى بن سعيد قاضي شيراز، عن عمرو بن دينار، عن عطاء، عن جابر.(@)(@@) ويحيى هذا يروي المقلوبات، لا يجوز الاحتجاج به إذا انفرد.(@)(@@)(@@)(@@) $ 971 - «لا تأخذوا العلم إلا ممن تجيزون شهادتهم» .(@)(@@) رواه حفص بن عمر قاضي حلب، عن هشام بن حسان، عن محمد بن كعب القرظي، عن ابن عباس.(@)(@@) وحفص هذا يروي الموضوعات.(@)(@@) ورواه صالح بن حسان الأنصاري، عن محمد بن كعب.(@)(@@) وصالح هذا يوصف بوضع الحديث، والأول سرقه منه.(@)(@@)(@@)(@@) $ 972 - «لا تظهر الشماتة لأخيك فيعافه الله ويبتليك. . .» الحديث.(@)(@@) رواه القاسم بن أمية الحذاء، عن حفص بن غياث، عن برد أبي العلاء، عن مكحول، عن واثلة بن الأسقع.(@)(@@) والقاسم هذا يروي المناكير الكثيرة، ولا يحتج به إذا انفرد، وهذا لا أصل له من كلام رسول الله صلى الله عليه وسلم.(@)(@@) ورواه السري بن عاصم بن سهل الهمذاني أبو عاصم، عن حفص، عن برد بن سنان، عن مكحول.(@)(@@) والسري هذا كان ببغداد مؤدب المعتز، يسرق الحديث، ويرفع الموقوف، وهذا يعرف بالقاسم سرقة هذا المؤدب(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 973 - «لا تذهب الدنيا حتى يستغني الرجال بالرجال والنساء بالنساء» .(@)(@@) رواه ابن عوف القرشي، عن بكار بن تميم، عن مكحول، عن واثلة.(@)(@@) وبشر هذا عنده نسخة موضوعة بهذا الإسناد.(@)(@@) ورواه العلاء بن كثير مولى بني أمية، عن مكحول، عن واثلة وأنس.(@)(@@) والعلاء هذا لا شيء، وأظن بشر سرقه منه.(@)(@@)(@@)(@@) $ 974 - " لا تزول قدما عبد من بين يدي الرحمن حتى يسأل عن أربع: شبابك فيما أبليت. . . " الحديث.(@)(@@) رواه عبيد الله بن الفرج العتكي، عن حماد بن زيد، عن أيوب، عن نافع، عن ابن عمر، عن ابن مسعود.(@)(@@) وعبيد الله هذا ينفرد عن الثقات 
ms142	 ما لا يتابع عليه، فبطل الاحتجاج به.(@)(@@)(@@)(@@) | 975 -(@)(@@) " لا تزال على طهور، فإنه من مات على طهور رزق(@)(@@) PageV00P000(@)(@@) الشهادة.(@)(@@) رواه غسان بن أبان أبو روح الحنفي، عن حفص بن عمر بن أبي طلحة الأنصاري، عن عمه، عن أنس.(@)(@@) وغسان هذا يروي العجائب، وعده ابن حبان في المتروكين، وأنكر عليه هذا الحديث.(@)(@@)(@@)(@@) $ 976 - «لا تكرهوا مرضاكم على الطعام» .(@)(@@) رواه محمد بن عمر بن الوليد، عن مالك، عن نافع، عن ابن عمر.(@)(@@) ومحمد هذا يروي عن مالك ما ليس من حديثه ولا يجوز الاحتجاج بحديثه ولا الرواية عنه إلا عند الاعتبار للخواص.(@)(@@)(@@)(@@) $ 977 - «لا تقوم الساعة على مؤمن حتى يبعث الله بين الساعة ريحا طيبة. . .» الحديث.(@)(@@) رواه موسى بن مطير الكوفي، عن أبيه، عن أبي هريرة.(@)(@@) وموسى صاحب عجائب.(@)(@@) قال النسائي: متروك(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 978 - «لا تستخدموا أرقاءكم بالليل، فإن الليل لهم والنهار لكم» .(@)(@@) رواه يحيى بن هشام السمسار، عن هشام بن عروة، عن أبيه، عن عائشة رضي الله تعالى عنها.(@)(@@) ويحيى هذا يضع الحديث.(@)(@@)(@@)(@@) $ 979 - «لا تنزلوهن الغرف، ولا تعلموهن الكتاب، وعلموهن المغزل وسورة النور» .(@)(@@) رواه محمد بن إبراهيم الشامي، عن شعيب بن إسحاق، عن هشام، عن أبيه، عن عائشة.(@)(@@) ومحمد هذا يكون بالعراق، وترك عبادان، يضع على أهل الشام.(@)(@@)(@@)(@@) $ 980 - «لا تلقوا الدر في أفواه الكلاب» .(@)(@@) رواه علي بن سعيد الرقي، عن يزيد بن هارون، عن شعبة، عن محمد بن جحادة، عن أنس.(@)(@@) وعلى هذا قلب إسناده، وإنما يعرف هذا من حديث يحيى بن عقبة بن أبي العيزار، عن محمد بن جحادة، لم يحدث به شعبة ولا يزيد بن هارون قط.(@)(@@)(@@)(@@) | 981 -(@)(@@) «لا تسبوا البراغيث، فإنه نبه نبيا من الأنبياء لصلاة(@)(@@) PageV00P000(@)(@@) الصبح» .(@)(@@) رواه سويد بن إبراهيم، عن قتادة، عن أنس.(@)(@@) وسويد هذا يكنى بأبي حاتم القطان الهذلي، يروي الموضوعات على الثقات، وهو يعرف بهذا الحديث.(@)(@@)(@@)(@@) $ 982 - " لا تجوز شهادة خائن ولا خائنة ولا مجلود في حد ولا مجرب في شهادة ولا ظنين ولا ذي غمر على أخيه.(@)(@@) رواه يزيد بن أبي زياد، 
ms143	 عن الزهري، عن عروة، عن عائشة رضي الله تعالى عنها.(@)(@@) ويزيد هذا ليس بحجة.(@)(@@)(@@)(@@) $ 983 - «لا تكلموا في القدر، فإنه سر الله. . .» الحديث.(@)(@@) رواه الهيثم بن جماز الحنفي، عن عمران القصير، عن نافع، عن ابن عمر.(@)(@@) والهيثم لا شيء في الحديث.(@)(@@)(@@)(@@) | 984 -(@)(@@) «لا تسبوا الديك، فإنه صديقي وأنا صديقه. . .» الحديث.(@)(@@) PageV00P000(@)(@@) في الديك بطوله.(@)(@@) رواه عبد الله بن صالح كاتب الليث، عن رشدين بن سعد، عن الحسن بن ثوبان، عن يزيد بن أبي حبيب، عن سالم بن عبد الله، عن أبيه.(@)(@@) وعبد الله هذا متروك الحديث كذاب.(@)(@@)(@@)(@@) $ 985 - «لا تقربوا اليهود والنصارى في أعيادهم. . .» الحديث.(@)(@@) رواه أحمد بن إبراهيم المزني، عن محمد بن كثير، عن الأوزاعي، عن الزهري، عن أنس.(@)(@@) وأحمد هذا يضع، وينزل الشام.(@)(@@)(@@)(@@) $ 986 - «لا تجعلوني كقدح الراكب، فإن الراكب يملأ قدحه. . .» الحديث.(@)(@@) رواه موسى بن عبيدة الربذي، عن إبراهيم بن محمد بن إبراهيم التميمي، عن أبيه، عن جابر.(@)(@@) وموسى هذا أنكر حديثه أحمد.(@)(@@) وقال يحيى: ليس بشيء.(@)(@@)(@@)(@@) $ 987 - " لا تقطعوا اللحم بالسكين. . . الحديث.(@)(@@) رواه نجيح السندي، عن هشام، عن أبيه، عن عائشة رضي الله تعالى عنها.(@)(@@) ونجيح هذا مولى أم موسى أم المهدي، واختلط وكان لا يدري ما يتحدث به ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 988 - «لا تشتر من الإماء إلا صناعة اليدين» .(@)(@@) رواه مالك بن سليمان أبو غسان النهشلي، عن يزيد بن نعامة الضبي، عن أنس.(@)(@@) ومالك يأتي عن الثقات ما لا يشبه حديث الثقات.(@)(@@)(@@)(@@) $ 989 - «لا تأكلن متكئا ولا على غربال» .(@)(@@) رواه رزيق بن عبد الله الألهاني الشامي، عن عمرو بن الأسود، عن أبي الدرداء.(@)(@@) ورزيق أنكر عليه ابن حبان هذا الحديث.(@)(@@)(@@)(@@) $ 990 - «لا تغالوا بالشاء، فإنما هو سقيا من الله، وإذا حلبتم فادعوا للبن داعيا. . .» الحديث.(@)(@@) رواه طلحة بن زيد الرقي، عن برد بن سنان، عن راشد بن سعد، عن عبد الله بن بسر.(@)(@@) وطلحة منكر الحديث جدا.(@)(@@)(@@)(@@) | 991 -(@)(@@) «لا تنكحوا النساء إلا من الأكفاء، ولا يزوجهن إلا(@)(@@) PageV00P000(@)(@@) الأولياء ولا مهر دون عشرة دراهم» .(@)(@@) رواه مبشر بن عبيد الحلبي، 
ms144	 عن أبي الزبير، عن جابر.(@)(@@) ومبشر يروي الموضوعات عن الثقات.(@)(@@)(@@)(@@) $ 992 - «لا تفوت صلاة ليل في ليل ولا نهار في نهار، ولكن التضييع فيما بين ذلك» .(@)(@@) رواه محمد بن عبد الرحمن البيلماني، عن أبيه، عن ابن عمر.(@)(@@) ومحمد هذا لا شيء في الحديث.(@)(@@)(@@)(@@) $ 993 - «لا تكن أول من يدخل السوق، ولا آخر من يخرج منها، فإنها معركة الشيطان. . .» الحديث.(@)(@@) رواه يزيد بن سفيان أبو خالد، عن سليمان التيمي، عن أبي عثمان، عن سلمان.(@)(@@) ويزيد لا يجوز الاحتجاج به إذا انفرد.(@)(@@)(@@)(@@) | 994 -(@)(@@) «لا تعزير فوق عشرين سوطا» .(@)(@@) PageV00P000(@)(@@) رواه محمد بن إبراهيم الشامي، عن الوليد، عن الأوزاعي، عن يحيى بن أبي كثير، عن أبي سلمة، عن أبي هريرة.(@)(@@) ومحمد هذا مجاور عبادان، يضع الحديث على ثقات الشاميين.(@)(@@)(@@)(@@) $ 995 - «لا تستأذنوا لمن لا يبدأ بالسلام» .(@)(@@) رواه إبراهيم بن يزيد الخوزي، عن أبي الزبير، عن جابر.(@)(@@) وإبراهيم ليس بثقة.(@)(@@)(@@)(@@) $ 996 - " لا تبكين إلا لأحد رجلين: فاجر مكمل فجوره وبار مكمل بره ".(@)(@@) رواه راشد بن سعد، عن يونس بن يزيد، عن نافع، عن ابن عمر.(@)(@@) وراشد ضعيف.(@)(@@)(@@)(@@) $ 997 - «لا تدخل الملائكة بيتا فيه جلد نمر» .(@)(@@) رواه سعيد بن بشير، عن أبي الزبير، عن جابر.(@)(@@) وهذا أحد ما أنكر على سعيد.(@)(@@)(@@)(@@) | 998 -(@)(@@) «لا تضربوا إماءكم على كسر إنائكم، فإن لها آجالا(@)(@@) PageV00P000(@)(@@) كآجالكم» .(@)(@@) رواه سعيد بن هبيرة المروزي العامري، عن حماد بن سلمة، عن ثابت، عن أنس.(@)(@@) وسعيد هذا يتهم بالوضع.(@)(@@)(@@)(@@) $ 999 - «لا حول ولا قوة إلا بالله دواء من تسعة وتسعين داء أيسرها الهم» .(@)(@@) رواه بشر بن رافع النجراني، عن ابن عجلان، عن أبي هريرة.(@)(@@) وبشر يروي الموضوعات، وكأنه المتعمد لها.(@)(@@)(@@)(@@) $ 1000 - «لا حسد ولا ملق إلا في طلب العلم» .(@)(@@) رواه محمد بن علاثة، عن الأوزاعي، عن الزهري، عن أبي سلمة، عن أبي هريرة.(@)(@@) ومحمد كان ابن حبان يتهمه بالوضع والمتقدمون أحسنوا القول فيه،(@)(@@) PageV00P000(@)(@@) والقلب يميل عند مشاهدة أحاديثه إلى ما قال ابن حبان.(@)(@@)(@@)(@@) $ 1001 - «لا خير فيمن لا يجمع المال، يصل به رحمه، ويؤدي به 
ms145	 عن أمانته، ويستعين به» .(@)(@@) رواه العلاء بن سلمة الرواس أبو سالم البغدادي، عن هاشم بن القاسم، عن مرجى بن رجاء، عن سعيد، عن قتادة، عن أنس.(@)(@@) والعلاء يروي الموضوعات، وهذا من كلام سعيد بن المسيب لا من كلام رسول الله صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1002 - «لا خير في صحبة من لا يرى لك من الحق. . .» الحديث.(@)(@@) رواه بكار بن شعيب، عن أبي حازم، عن أبيه، عن سهل.(@)(@@) وبكار هذا شيخ من أهل دمشق، يروي عن الثقات ما ليس من حديثهم، لا يحل الاحتجاج به.(@)(@@)(@@)(@@) | 1003 -(@)(@@) «لا خير في التجارة إلا لمن إذا باع لم يحمد. . .» .(@)(@@) PageV00P000(@)(@@) الحديث.(@)(@@) رواه عمر بن راشد اليماني، عن يحيى بن أبي كثير، عن أبي سلمة، عن أبي هريرة.(@)(@@) وعمر هذا ليس بشيء.(@)(@@)(@@)(@@) $ 1004 - «لا خير في التجارة إلا كسب تاجر إن باع. . .» .(@)(@@) الحديث.(@)(@@) رواه بشر بن رافع النجراني، عن يحيى بن أبي كثير، عن أبي سلمة، عن أبي هريرة.(@)(@@) وبشر هذا منكر الحديث.(@)(@@)(@@)(@@) $ 1005 - «لا شفعة لصغير ولا لغالب، وإذا سبق الشريك شريكه بالشفعة فلا شفعة، والشفعة كحل العقال» .(@)(@@) رواه محمد بن عبد الرحمن البيلماني، عن أبيه، عن ابن عمر.(@)(@@) ومحمد هذا لا شيء في الحديث.(@)(@@)(@@)(@@) $ 1006 - «لا صلاة لجار المسجد إلا في المسجد» .(@)(@@) رواه عمر بن راشد، عن ابن ذئب، عن الزهري، عن عروة، عن عائشة(@)(@@) PageV00P000(@)(@@) رضي الله تعالى عنها.(@)(@@) وعمر هذا قال ابن حبان: لا يحل ذكره إلا على سبيل القدح.(@)(@@)(@@)(@@) $ 1007 - «لا فقر أشد من الجهل، ولا مال أعود من العقل. . .» الحديث بطوله.(@)(@@) رواه محمد بن عبد الله الحبطي من أهل تستر، عن شعبة، عن أبي إسحاق، عن الحارث، عن علي مسندا.(@)(@@) ومحمد يروي عن الثقات ما ليس من حديثهم.(@)(@@)(@@)(@@) $ 1008 - «لا طلاق قبل نكاح، ولا عتق لمن لا يملك، ولا صمت يوما إلى الليل، ولا رهبانية فينا» .(@)(@@) رواه سعيد بن المرزبان أبو سعد البقال، عن يزيد الفقير، عن جابر.(@)(@@) وأبو سعيد ضعيف الحديث.(@)(@@)(@@)(@@) | 1009 -(@)(@@) «لا مهر أقل من عشرة دراهم» .(@)(@@) رواه مبشر 
ms146	 بن عبيد الحلبي، عن الحجاج بن أرطاة، عن عطاء وعمرو(@)(@@) PageV00P000(@)(@@) بن دينار، عن جابر.(@)(@@)(@@)(@@) | 1000003 -(@)(@@) ومبشر يروي الموضوعات، وقد حدث في(@)(@@)(@@)(@@) | «لا تنكحوا النساء إلا من الأكفاء» عن أبي الزبير، عن جابر، وهذا التخليط من(@)(@@) مبشر.(@)(@@)(@@)(@@) $ 1010 - «لا نكاح إلا بولي وشاهدي عدل» .(@)(@@) رواه عبد الله بن محرر، عن قتادة، عن الحسن، عن عمران بن حصين.(@)(@@) وعبد الله متروك الحديث.(@)(@@) ورواه إبراهيم بن إسحاق بن إبراهيم بن عيسى بن محمد أبو إسحاق البغدادي، عن لوين محمد بن سليمان، عن أبي إسحاق، عن أبي بردة، عن أبي موسى.(@)(@@) وإبراهيم هذا سرقه من علي بن حجر، عن شريك، وهذا الحديث تفرد به علي، عن شريك، ما حدث به غيره عن شريك.(@)(@@) وأبو غسان النهدي راوي هذا الحديث تفرد عن إسرائيل، ليس عن شريك، فمن زعم أنه عن شريك فقد وهم.(@)(@@)(@@)(@@) | 1011 -(@)(@@) «لا وصية لوارث» .(@)(@@) رواه إسماعيل بن محمد بن يوسف أبو هارون، عن زكريا بن نافع الأسود،(@)(@@) PageV01P392(@)(@@) عن محمد بن مسلم الطائفي، عن ابن طاوس، عن أبيه، عن ابن عباس.(@)(@@) وإسماعيل من أهل جبرين من الشام كذاب.(@)(@@) ورواه جعفر بن عبد الواحد الهاشمي، عن ابن الطباع، عن إسماعيل بن عياش، عن شرحبيل بن مسلم، عن أبي أمامة.(@)(@@) وعن ابن الطباع، عن علي بن مسهر، عن محمد بن إسحاق، والأعمش عن إسماعيل بن عياش، عن شرحبيل.(@)(@@) وما روى الأعمش ولا ابن إسحاق، عن إسماعيل شيئا قط.(@)(@@) وجعفر هذا صنعه، والحديث من أفراد إسماعيل، لم يحدث به غيره.(@)(@@)(@@)(@@) $ 1012 - «لا هم إلا هم الدين، ولا وجع إلا وجع العين» .(@)(@@) رواه سهل بن قرين، عن ابن أبي ذئب، عن محمد بن المنكدر، عن جابر.(@)(@@) وسهل هذا يروي عن الثقات ما ليس من حديثهم، يلزق المراسيل والمقاطيع عن أقوام مشاهير، فأسندهما عنهم، لا يجوز الاحتجاج به.(@)(@@)(@@)(@@) | 1013 -(@)(@@) «لا يقطع السارق إلا في ثمن المجن أو في عشرة دراهم» .(@)(@@) PageV00P000(@)(@@) رواه محمد بن عبد الله العرزمي، عن عمرو بن شعيب، عن أبيه، عن جده.(@)(@@) ومحمد هذا متروك.(@)(@@) ورواه 
ms147	 الحجاج بن أرطاة، عن عمرو بن شعيب أيضا.(@)(@@) والحجاج متروك.(@)(@@)(@@)(@@) $ 1014 - «لا تقطع الصلاة امرأة ولا كلب. . .» الحديث.(@)(@@) رواه إسحاق بن أبي فروة، عن زيد بن أسلم، عن عطاء، عن أبي هريرة.(@)(@@) وإسحاق منكر الحديث أنكر عليه، قيل أقلب إسناد هذا الخبر ومتنه جميعا، إنما هو عن عطاء، عن أبي سعيد الخدري قوله: إذا كان أحدكم يصلي فلا يدع أحدا يمر بين يديه، فجعل مكان أبي سعيد أبا هريرة، وجاء بشيء ليس في الأخبار الصحيحة أنه أمر بإعادة الصلاة.(@)(@@)(@@)(@@) $ 1015 - «لا يقبل الله قولا إلا بعمل، ولا يقبل قولا وعملا إلا بالنية. . .» الحديث.(@)(@@) رواه أحمد بن الحسن بن أبان الأبلي المصري، عن إبراهيم بن بشار، عن سفيان بن عيينة، عن الزهري، عن سعيد بن المسيب، عن عبد الله بن مسعود.(@)(@@) وأحمد هذا دجال كذاب.(@)(@@)(@@)(@@) | 1016 -(@)(@@) «لا يكون الحيض للجارية البكر والثيب التي قد أيست(@)(@@) PageV00P000(@)(@@) من الحيض أقل من ثلاثة أيام ولا أكثر من عشرة. . .» الحديث.(@)(@@) رواه العلاء بن كثير مولى بني أمية، عن مكحول، عن أبي أمامة.(@)(@@) والعلاء يروي الموضوعات.(@)(@@) ومن أصحابنا من زعم أنه العلاء بن الحارث، وليس كذلك، لأن العلاء بن الحارث حضرمي من اليمن، وهذا مولى بني أمية، وذلك صدوق، وهذا ليس بشيء في الحديث.(@)(@@)(@@)(@@) $ 1017 - «لا يجتمع على مسلم خراج وعشر» .(@)(@@) رواه يحيى بن عنبسة، عن أبي حنيفة، عن حماد، عن إبراهيم، عن عبد الله.(@)(@@) ويحيى دجال يضع، وليس هذا من كلام الرسول.(@)(@@)(@@)(@@) $ 1018 - «لا يزال أربعون رجلا يحفظ الله بهم الأرض، كلما مات منهم رجل أبدل الله مكانه آخر، هم في الأرض كلها» .(@)(@@) رواه محمد بن عبد الرحمن البيلماني، عن أبيه، عن ابن عمر.(@)(@@) ومحمد هذا لا شيء في الحديث.(@)(@@)(@@)(@@) | 1019 -(@)(@@) «لا يقاد العبد بين اثنين» .(@)(@@) PageV00P000(@)(@@) رواه محمد بن ثابت البناني، عن أبيه، عن أنس.(@)(@@) ومحمد هذا لا يجوز الاحتجاج به ولا الرواية عنه.(@)(@@) قال ابن معين: ليس بشيء.(@)(@@)(@@)(@@) $ 1020 - «لا يبغي على الناس إلا ابن بغية أو فيه عرق منها» .(@)(@@) رواه سهل الأعرابي، عن 
ms148	 بلال بن أبي بردة، عن أبيه، عن أبي موسى.(@)(@@) والحديث لا أصل له، وسهل هذا من أهل البصرة قليل الحديث منكر الرواية، وليس بالمحل الذي يقبل منه ما ينفرد به.(@)(@@)(@@)(@@) $ 1021 - «لا يركب البحر إلا حاج أو معتمر أو غاز» .(@)(@@) رواه ليث بن أبي سليم، عن نافع، عن ابن عمر.(@)(@@) وليث هذا ضعيف الحديث جدا، تركه يحيى القطان وعبد الرحمن وأحمد ويحيى بن معين.(@)(@@)(@@)(@@) $ 1022 - «لا يلدغ المؤمن من جحر مرتين» ، رواه عبد السلام بن أبي فروة النصيبي، عن ابن عيينة، عن أبي الزناد، عن الأعرج، عن أبي هريرة.(@)(@@) وهذا ليس عند ابن عيينة أصلا، إنما هو عن الزهري، عن سعيد، عن أبي هريرة.(@)(@@) وعبد السلام سرقه وركبه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1023 - «لا يقطع الصلاة شيء وادرأ ما استطعت» .(@)(@@) رواه إبراهيم الخوزي، عن سالم بن عبد الله، عن ابن عمر.(@)(@@) وإبراهيم ليس بشيء في الحديث.(@)(@@)(@@)(@@) $ 1024 - «لا يحل لامرأة أن تبيت ليلة حتى تعرض نفسها على زوجها» .(@)(@@) رواه جعفر بن ميسرة، عن أبيه، عن ابن عمر.(@)(@@) وجعفر هذا يروي المناكير عن أبيه، وأبوه مستقيم الحديث، وهو لا شيء في الحديث.(@)(@@)(@@)(@@) $ 1025 - «لا يؤذن لكم من يدغم الهاء» .(@)(@@) رواه علي بن جميل الرقي، عن عيسى بن يونس، عن الأعمش، عن أبي صالح، عن أبي هريرة.(@)(@@) وعلي هذا يضع..(@)(@@)(@@)(@@) | 1026 -(@)(@@) «لا يذهب الله بكتيبة عبد فيصبر. . .» الحديث وكتيبته زوجته.(@)(@@) PageV00P000(@)(@@) رواه الحسن بن دينار - وهو ابن واصل - عن ابن سيرين، عن أبي هريرة.(@)(@@) والحسن هذا تركه أحمد، وضعفه يحيى والجماعة.(@)(@@)(@@)(@@) $ 1027 - «لا يدخل ولد الزنا ولا شيء من نسله إلى سبعة آباء الجنة» .(@)(@@) رواه إبراهيم بن مهاجر البجلي الكوفي، عن مجاهد، عن محمد بن عبد الرحمن بن أبي ثابت، عن أبي هريرة.(@)(@@) وإبراهيم هذا ضعيف، قال الله تعالى: {ولا تزر وازرة وزر أخرى} [الأنعام: 164] .(@)(@@)(@@)(@@) $ 1028 - «لا يعجبنكم جمع مال من غير حله. . .» الحديث.(@)(@@) رواه الحسين بن قيس الرحبي - ولقبه حنش - عن عطاء، عن ابن عمر.(@)(@@) وحسين هذا كذاب، كذبه أحمد، وتركه يحيى بن معين.(@)(@@)(@@)(@@) $ 1029 - «لا 
ms149	 يحرم الحلال الحرام، وإنما يحرم الحرام ما كان من نكاح حلال» .(@)(@@) رواه عثمان بن عبد الرحمن الوقاصي من ولد سعد، عن الزهري، عن عروة، عن عائشة رضي الله تعالى عنها.(@)(@@) وعبد الرحمن لا شيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1030 - «لا يعجبنكم إسلام امرئ حتى تعلموا ما عقدة عقله» .(@)(@@) رواه إسحاق بن أبي فروة، عن نافع، عن ابن عمر.(@)(@@) وإسحاق متروك الحديث.(@)(@@)(@@)(@@) $ 1031 - «لا يمسح الرجل جبهته من التراب حتى يفرغ من الصلاة. . .» الحديث.(@)(@@) رواه عثمان بن عبد الرحمن الوقاصي، عن مكحول، عن واثلة.(@)(@@) وعثمان لا شيء في الحديث.(@)(@@)(@@)(@@) $ 1032 - " لا يبيت أحدكم وعند رأسه طعام، فإني لا آمن عليه الهوام. . . الحديث.(@)(@@) رواه يحيى بن هاشم، عن أبيه، عن عائشة رضي الله تعالى عنها.(@)(@@) ويحيى يضع(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1033 - «لا يحبس إنسان في الدين أكثر من أربعين يوما» .(@)(@@) رواه يونس بن عطاء الصدائي، عن حميد، عن أنس.(@)(@@) ويونس يروي العجائب، لا يحتج به إذا انفرد.(@)(@@)(@@)(@@) $ 1034 - «لا يحرم من الرضاع إلا عشر رضعات» .(@)(@@) رواه محمد بن عمر الواقدي، عن هشام بن سعد، عن زيد بن أسلم، عن عياض بن عبد الله بن أبي سرح، عن عبد الله بن علقمة بن الفغواء، عن ابن عمر، عن صفية بنت أبي عبيد، عن حفصة قالت.(@)(@@) ومحمد هذا كان أحمد يكذبه، ويروي عن الثقات المقلوبات وعن الأثبات المعضلات.(@)(@@) وقال ابن معين: ليس بشيء في الحديث.(@)(@@) وقال ابن المديني: يضع الحديث.(@)(@@)(@@)(@@) | باب الياء(@)(@@)(@@)(@@) | 1035 -(@)(@@) يا رسول الله(@)(@@)(@@)(@@) | أرأيت الأرض على ما هي؟ قال: «على الماء. . .» الحديث بطوله.(@)(@@) رواه سعيد بن سنان الكندي، عن أبي(@)(@@) الزاهرية حدير بن كريب، عن كثير بن مرة، عن ابن عمر.(@)(@@) وسعيد هذا شامي ليس بشيء.(@)(@@)(@@)(@@) | 1036 -(@)(@@) «يا أبا بكر ما أحد من أهل الكتاب أعلم من عبد الله بن سلام. . .» الحديث.(@)(@@) PageV00P000(@)(@@) وفيه ذكر زيد بن سعنة بطوله.(@)(@@) رواه معلى بن عبد الرحمن الواسطي، عن عبد الحميد بن جعفر، عن الزهري، عن أنس قال: يا أبا بكر.(@)(@@) ومعلى يروي المقلوبات، ولا يحتج به إذا انفرد.(@)(@@) وحديث ابن سعنة 
ms150	 صحيح، وليس هذا من حديث الزهري ولا من حديث أنس، وإنما هو من حديث محمد بن حمزة بن عبد الله بن سلام، عن أبيه، عن جده.(@)(@@)(@@)(@@) | 1037 -(@)(@@) «يا علي إن(@)(@@)(@@)(@@) | المدينة لا تصلح لا بي وبك، وأنت مني بمنزلة هارون من موسى» .(@)(@@) رواه بهذا اللفظ حفص بن عمر الأبلي الحبطي، عن ابن أبي ذئب وإبراهيم بن سعد ويزيد بن عياض ومالك بن أنس، عن الزهري، عن سعيد بن المسيب، قال: قلت لسعد بن أبي وقاص: أنت سمعت النبي صلى الله عليه وسلم يقول لعلي: «أنت مني بمنزلة هارون من موسى» ؟ وحفص هذا يقلب الأخبار، ويكتب الأسانيد الصحيحة بالمتون الواهية، ويعمد إلى حديث قد يروى من طريق آخر فيأتي به من طريق آخر، وهذا ليس من حديث الزهري ولا سعيد ولا مالك، وإنما عند مالك(@)(@@)(@@)(@@) | 1000004 -(@)(@@) عن يحيى بن سعيد الأنصاري، عن سعيد، عن سعد، قال لي رسول الله صلى الله عليه وسلم(@)(@@)(@@)(@@) | : «ارم فداك أبي وأمي» فحمل حفص متن يزيد بن عياض على مالك عن الزهري عن سعيد متوهما، وقرن إليه(@)(@@) ابن أبي ذئب وإبراهيم بن سعد، وليس هذا من حديثهما، وقوله: المدينة لا تصلح إلا بي وبك " باطل، وهذه الزيادة موضوعة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1038 -(@)(@@) «يا علي(@)(@@)(@@)(@@) | كذب من زعم أنه يحبني ويبغضك. . .» الحديث.(@)(@@) رواه محمد بن الضوء بن الصلصال، عن أبيه، عن جده(@)(@@) أن النبي صلى الله عليه وسلم قال.(@)(@@) ومحمد هذا يروي المناكير، عن أبيه، عن جده.(@)(@@)(@@)(@@) | 1039 -(@)(@@) «يا أبا ذر ألا أدلك على(@)(@@)(@@)(@@) | خصلتين هما أخف على الظهر وأثقل في الميزان؟ . . .» الحديث.(@)(@@) رواه بشار بن الحكم الضبي، عن(@)(@@) ثابت، عن أنس.(@)(@@) وبشار هذا منكر الحديث عن أنس، وهذا مما أنكر عليه.(@)(@@)(@@)(@@) | 1040 -(@)(@@) «يا أبا ذر إن(@)(@@)(@@)(@@) | للمسجد تحية فقم فاركعهما. . .» ثم ذكر الحديث بطوله في وصية أبي ذر.(@)(@@) رواه يحيى بن سعد(@)(@@) السعدي، عن ابن جريج، عن عطاء، عن عبيد بن عمير، عن أبي ذر.(@)(@@) ويحيى هذا يروي المقلوبات عن الثقات، وليس هذا من حديث ابن جريج، عن عطاء، 
ms151	 عن عبيد بن عمير، عن أبي ذر، وهذا الحديث ليس له من الطرق إلا من رواية أبي إدريس الخولاني والقاسم بن محمد، عن أبي ذر قالوا: ليس حديث ابن جريج هذا، وهذا أنكر الروايات، ويحيى بن سعد هذا يعرف بهذا الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 1041 -(@)(@@) «يا بلال(@)(@@)(@@)(@@) | أصبح بالفجر، فإنه أعظم للأجر» .(@)(@@) رواه أيوب بن سيار الزهري، عن محمد بن المنكدر، عن جابر، عن(@)(@@) أبي بكر الصديق رضي الله عنه.(@)(@@) وأيوب ليس بشيء في الحديث.(@)(@@)(@@)(@@) | 1042 -(@)(@@) "يا عمرو بن عبسة كيف أنت(@)(@@)(@@)(@@) | إذا ركبت دابة يقال لها: الهملاج. . . الحديث.(@)(@@) وفيه ذكر بيت المقدس.(@)(@@) رواه الفرات بن سليم، عن(@)(@@) عمرو بن عاتكة، عن عمرو بن عبسة، والفرات هذا منكر الحديث جدا، يأتي بما لا يشك من الحديث صناعته أنه معمول.(@)(@@)(@@)(@@) | 1043 -(@)(@@) " يا عائشة رضي الله تعالى عنها(@)(@@)(@@)(@@) | زيدي على البيتين قالهما اليهودي: ارفع ضعيفك. . . البيتين ".(@)(@@) رواه سهل مولى المغيرة، عن حسين(@)(@@) بن رستم الأبلي، عن عروة، عن عائشة رضي الله تعالى عنها.(@)(@@) وسهل هذا يكنى بأبي حريز، يروي عن الزهري وغيره العجائب، وما لا أصل له، لا يحل الاحتجاج به.(@)(@@)(@@)(@@) | 1044 -(@)(@@) «يا معشر التجار. . .» الحديث.(@)(@@) PageV00P000(@)(@@) وفيه فجارا.(@)(@@) رواه الحارث بن عبيدة الحمصي، عن عبد الله بن عثمان بن خثيم، عن سعيد بن جبير، عن ابن عباس.(@)(@@) والحارث تفرد به.(@)(@@) وقال ابن حبان: لا يعجبني الاحتجاج به إذا انفرد.(@)(@@)(@@)(@@) $ 1045 - «يكون في أمتي رجل يقال له أبو حنيفة هو سراج أمتي هو سراج أمتي» .(@)(@@) رواه مأمون بن أحمد الهروي، عن أحمد بن عبد الله، عن عبد الله بن معدان الأزدي، عن أنس.(@)(@@) ومأمون هذا يضع الحديث دجال.(@)(@@)(@@)(@@) $ 1046 - «يكون في أمتي رجل يقال له وهب، ويكون في أمتي رجل يقال له غيلان. . .» الحديث.(@)(@@) رواه الأحوص بن حكيم، عن خالد بن معدان، عن عبادة بن الصامت.(@)(@@) والأحوص شامي ضعيف، أنكر عليه رواية هذا الحديث.(@)(@@)(@@)(@@) | 1047 -(@)(@@) «يكون في هذه الأمة رجل يقال له الوليد. . .» الحديث.(@)(@@) PageV00P000(@)(@@) رواه إسماعيل بن عياش، عن الأوزاعي، عن الزهري، عن سعيد بن المسيب، 
ms152	 عن عمر بن الخطاب.(@)(@@) هذا باطل ما حدث به عمر ولا من بعده، والحمل فيه على إسماعيل بن عياش.(@)(@@)(@@)(@@) $ 1048 - «يكون في آخر الزمان عباد جهال وقراء فسقة» .(@)(@@) رواه يوسف بن عطية الصفار السعدي، عن ثابت، عن أنس.(@)(@@) ويوسف هذا ليس بشيء في الحديث.(@)(@@)(@@)(@@) $ 1049 - «يكون نهر بين دجلة ودجيل والفرات» .(@)(@@) رواه سيف بن محمد ابن أخت سفيان الثوري، عن عاصم الأحول، عن أبي عثمان، عن جرير.(@)(@@) وسيف هذا قال ابن معين: كذاب خبيث.(@)(@@)(@@)(@@) $ 1050 - " يكون خلفي اثنا عشر خليفة: أبو بكر لا يلبث خلفي إلا قليلا، وصاحب رحى دارة العرب. . . " الحديث.(@)(@@) رواه عبد الله بن صالح كاتب الليث، عن الليث، عن خالد بن يزيد، عن سعيد بن أبي هلال، عن ربيعة بن سيف، عن شفي، عن عبد الله بن عمرو.(@)(@@) وعبد الله هذا كذاب.(@)(@@) وأورده ابن حبان في تفرداته التي أنكرت عليه(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1051 - «يوم كلم الله عز وجل موسى كان عليه جبة صوف وكساء صوف وكمه صوف» .(@)(@@) رواه حميد بن عطاء الأعرج الكوفي، عن عبد الله بن الحارث، عن ابن مسعود.(@)(@@) وحميد هذا منكر الحديث، روى نسخة بهذا الإسناد كأنها موضوعة.(@)(@@)(@@)(@@) $ 1052 - «يوم الأربعاء يوم نحس مستمر» .(@)(@@) رواه إبراهيم بن أبي حية المكي، عن جعفر بن محمد، عن أبيه، عن جابر.(@)(@@) وإبراهيم هذا ليس بشيء.(@)(@@)(@@)(@@) $ 1053 - «يسلم النساء على الرجال، ولا يسلم الرجال على النساء. . . .» الحديث.(@)(@@) رواه بشر بن عون الشامي، عن بكار بن تميم، عن مكحول، عن واثلة.(@)(@@) وبشر هذا عنده نسخة بهذا الإسناد كلها موضوعة.(@)(@@)(@@)(@@) $ 1054 - «يأتي على الناس زمان يكون وجوههم وجوه الآدميين، وقلوبهم قلوب الذئاب والضواري. . .» الحديث.(@)(@@) PageV00P000(@)(@@) رواه محمد بن الحسن الأزدي البصري، عن مالك، عن نافع، عن ابن عمر.(@)(@@) ومحمد هذا يروي عن مالك الموضوعات.(@)(@@)(@@)(@@) $ 1055 - «يأتي على الناس زمان يكونون في المسجد حلقا» .(@)(@@) رواه بزيغ بن حسان الخصاف، عن الأعمش، عن شقيق، عن عبد الله.(@)(@@) وبزيغ هذا من أهل البصرة متروك الحديث، يروي الموضوعات عن الثقات.(@)(@@)(@@)(@@) $ 1056 - «يبعث الناس يوم القيامة والسماء تطش 
ms153	 عليهم. . .» الحديث.(@)(@@) رواه نافع أبو غالب، عن أنس ".(@)(@@) وأبو غالب منكر الحديث.(@)(@@)(@@)(@@) $ 1057 - «يبعث معاوية يوم القيامة وعليه رداء من نور» .(@)(@@) رواه جعفر بن محمد الأنطاكي، عن زهير بن معاوية، عن أبي خالد الوالبي، عن طارق بن شهاب، عن حذيفة بن اليمان.(@)(@@) وجعفر هذا يروي عن زهير بن معاوية الموضوعات(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1058 - «يحشر الناس يوم القيامة جردا مردا بني ثلاث وثلاثين إلا موسى بن عمران، فإنه يحشر ولحيته إلى سرته» .(@)(@@) رواه شيخ بن أبي خالد البصري، عن حماد بن سلمة، عن عمرو بن دينار، عن جابر.(@)(@@) وهذا باطل موضوع، والآفة من شيخ.(@)(@@)(@@)(@@) $ 1059 - «يا حبذا المتخللون في الوضوء بين الأصابع» .(@)(@@) تقدم في باب الحاء في قوله حبذا.(@)(@@)(@@)(@@) $ 1060 - «يجلد في مكة رجل من قريش عليه نصف عذاب العالم» .(@)(@@) رواه محمد بن عبد الملك الأنصاري أبو عبد الله، عن الأوزاعي، عن المغيرة، عن المغيرة بن شعبة.(@)(@@) ومحمد هذا كان من أهل المدينة، ثم سكن الشام، يروي الموضوعات عن الأثبات.(@)(@@)(@@)(@@) $ 1061 - «يؤمر يوم القيامة بناس إلى الجنة حتى إذا دنوا منها. . .» الحديث بطوله.(@)(@@) رواه أبو جنادة، عن الأعمش، عن خيثمة، عن عدي بن حاتم.(@)(@@) وأبو جنادة هذا يروي عن الأعمش ما ليس من حديثه، لا يجوز الاحتجاج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1062 - «يستجيب للمظلومين ما لم يكونوا أكثر من الظالمين» .(@)(@@) رواه إبراهيم بن عبد الله ابن أخي عبد الرزاق، عن عمه، عن معمر، عن إسماعيل بن أبي خالد، عن قيس، عن جرير.(@)(@@) وإبراهيم كذاب.(@)(@@)(@@)(@@) $ 1063 - «يمينك على ما يصدقك عليه صاحبك. . .» الحديث.(@)(@@) رواه عباد بن أبي صالح السمان، عن أبيه، عن هريرة مسندا.(@)(@@) وعباد يروي عن أبيه ما لا أصل له من حديث أبيه، لا يجوز الاحتجاج به إذا انفرد.(@)(@@) وهذا خبر مشهور بعبد الله بن سعيد بن أبي سعيد المقبري، عن جده، عن أبي هريرة.(@)(@@) وعبد الله بن سعيد المقبري يقال له عباد أيضا.(@)(@@)(@@)(@@) $ 1064 - «يد الله على المؤذن حتى يفرغ من أذانه. . .» الحديث.(@)(@@) رواه أبو الصلت عبد السلام بن صالح الهروي، عن حماد بن 
ms154	 زيد، عن(@)(@@) PageV00P000(@)(@@) ثابت، عن أنس.(@)(@@) وأبو الصلت كذاب، وهذا أحد ما أنكر عليه، وما رواه حماد ولا ثابت ولا أنس، ولا رواه عنه إلا يزيد الرقاشي، وهو لا شيء.(@)(@@)(@@)(@@) $ 1065 - «يدعى الناس بأسمائهم إلا آدم، فإنه يكنى أبا محمد» .(@)(@@) رواه شيخ بن أبي خالد البصري، عن حماد بن سلمة، عن عمرو بن دينار، عن جابر.(@)(@@) وشيخ هذا يضع.(@)(@@)(@@)(@@) $ 1066 - " ينادي مناد يوم القيامة: أين بغضاء الله، فيقوم سؤال المساجد. . . " الحديث.(@)(@@) رواه جعفر بن أبان المصري، عن محمد بن رمح، عن الليث، عن نافع، عن ابن عمر.(@)(@@) وهذا مما وضعه جعفر هذا، وكان أحد الكذابين.(@)(@@) قال ابن حبان: قلت له لما سمعت منه هذا: اتق الله ولا تكذب، وذكر قصة(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1067 - «سينعق الشيطان نعقة بالشام. . .» الحديث.(@)(@@) رواه موسى بن وردان، عن أبي هريرة.(@)(@@) وموسى هذا سأل ابن معين عنه؟ فقال: ليس بالقوي، وقال مرة: ضعيف.(@)(@@)(@@)(@@) $ 1068 - «يستأذن الواحد على اثنين إذا تناجيا» .(@)(@@) رواه أحمد بن عبد الله بن ميسرة الحراني، عن يحيى بن سليم، عن عبيد الله، عن نافع، عن ابن عمر.(@)(@@) وأحمد هذا يسكن نهاوند منكر الحديث، يأتي على الثقات بما ليس من حديثهم، وهذا باطل عن النبي، والصحيح فعل ابن عمر نفسه.(@)(@@)(@@)(@@) $ 1069 - «يجزئ عن بر الوالدين الجهاد» .(@)(@@) رواه أحمد بن الحسن بن القاسم الكوفي، عن حفص بن غياث، عن أشعث، عن الحسن، عن أنس.(@)(@@) وأحمد هذا كان بمصر، يضع على الثقات.(@)(@@)(@@)(@@) | باب ما دخل فيه الألف واللام(@)(@@) من أحاديث نوردها على الترتيب المعجم أيضا(@)(@@)(@@)(@@) | 1070 -(@)(@@) «الإيمان معرفة بالقلب وإقرار باللسان وعمل بالأركان. . .» الحديث.(@)(@@) PageV00P000(@)(@@) رواه علي بن موسى الرضا، عن آبائه، وكان يأتي عن آبائه بالعجائب.(@)(@@)(@@)(@@) $ 1071 - «البدلاء أربعون، اثنان وعشرون بالشام. . .» الحديث.(@)(@@) رواه العلاء بن زيد، عن أنس.(@)(@@) والعلاء هذا له نسخة موضوعة عنه عن أنس، لا يحل ذكره إلا على سبيل التعجب.(@)(@@)(@@)(@@) $ 1072 - «التاجر الصدوق الأمين المسلم مع النبيين. . .» الحديث.(@)(@@) رواه كلثوم بن جوشن القشيري، عن أيوب، عن نافع، عن ابن عمر.(@)(@@) وكلثوم هذا يروي الموضوعات عن 
ms155	 الثقات، لا يحتج به.(@)(@@) وابن عدي لم يذكره(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1073 - «الجبن والجرأة غرائز يضعها الله حيث يشاء. . .» الحديث.(@)(@@) رواه معدي بن سليمان عن ابن عجلان عن أبيه عن أبي هريرة.(@)(@@) ومعدي هذا شيخ مصري، يروي المقلوبات عن الثقات، لا يحتج به.(@)(@@)(@@)(@@) $ 1074 - «الحجامة على الريق أمثل. . .» الحديث.(@)(@@) رواه عثمان بن مطر الشيباني، عن الحسن بن أبي جعفر، عن محمد بن جحادة، عن نافع، عن ابن عمر، قال: قال لي ابن عمر: التمس لي حجاما رقيقا.(@)(@@) وعثمان هذا كذاب.(@)(@@) ورواه المثنى بن عمرو، عن أبي سنان، عن أبي قلابة، عن ابن عمر.(@)(@@) والمثنى يروي عن ابن سنان ما ليس من حديث الثقات، وهذا موضوع.(@)(@@)(@@)(@@) $ 1075 - «الحجامة في الرأس تنفع من سبع» رواه عمر بن رباح الضرير، عن ابن طاوس، عن أبيه، عن ابن عباس.(@)(@@) وعمر هذا يروي الموضوعات عن الثقات، لا يحل الاحتجاج به.(@)(@@)(@@)(@@) | 1076 -(@)(@@) «الحيض ثلاث أربع خمس إلى عشر، فما زاد فهو(@)(@@) PageV00P000(@)(@@) استحاضة» .(@)(@@) رواه خالد بن أيوب، عن معاوية بن قرة، عن أنس.(@)(@@) وهذا موضوع عليه، ما أعلم أحدا من أصحاب الرسول أفتى بها، وأعلى شيء لأصحاب الرأي فيه قول خالد بن معدان.(@)(@@) وقال حماد بن زيد: رأيت خالدا وهو لا يميز بين الحيض والاستحاضة، وكان ابن علية يرميه بالكذب.(@)(@@) ورواه سليمان بن عمرو أبو داود النخعي، عن يزيد بن يزيد بن جابر، عن مكحول، عن أبي أمامة.(@)(@@) وسليمان هذا يضع الحديث في الحيض.(@)(@@)(@@)(@@) $ 1077 - «الحدة تعتري جماع القرآن» قيل: لم يا رسول الله؟ قال: لقوة القرآن في جوفهم ".(@)(@@) رواه أبو البختري وهب بن وهب، عن ثور بن يزيد، عن خالد بن معدان، عن معاذ بن جبل.(@)(@@) وأبو البختري هذا كذاب.(@)(@@)(@@)(@@) | 1078 -(@)(@@) «الحقب بضع وثمان سنة، كل سنة مائة وستون يوما، كل يوم كألف سنة مما تعدون» .(@)(@@) PageV00P000(@)(@@) رواه سليمان بن مسلم - شيخ يروي عن سليمان التيمي - عن نافع، عن ابن عمر.(@)(@@) وسليمان هذا لا تحل الراوية منه.(@)(@@)(@@)(@@) $ 1079 - " الحناء بعد النورة أمان من الجذام.(@)(@@) رواه علي بن موسى الرضا، عن 
ms156	 آبائه، وكان يأتي عنهم بالعجائب.(@)(@@)(@@)(@@) $ 1080 - «الخليفة بعدي أبو بكر وعمر ثم يقع الاختلاف. . .» الحديث.(@)(@@) رواه بشر بن حرب البزار، عن أبي رجاء العطاردي، عن الزبير بن العوام، عن النبي صلى الله عليه وسلم.(@)(@@) وبشر هذا ليس بالندبي منكر الحديث جدا، لا يحتج به(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1081 - «الخلق كلهم عيال الله، فأحبهم إلى الله أحبهم لعياله» .(@)(@@) رواه موسى بن عمير، عن الحكم بن عتيبة، عن إبراهيم، عن الأسود، عن عبد الله.(@)(@@) قال المقدسي: ورواه يوسف بن عطية الصفار.(@)(@@)(@@)(@@) $ 1082 - «الدنيا كلها سبعة أيام من أيام الآخرة» .(@)(@@) رواه العلاء بن زيدل، عن أنس.(@)(@@) والعلاء متروك الحديث.(@)(@@)(@@)(@@) $ 1083 - «الدعاء محجوب حتى يصلى على النبي صلى الله عليه وسلم. . .» الحديث.(@)(@@) رواه إبراهيم بن إسحاق الواسطي، عن ثور بن يزيد، عن خالد بن معدان، عن معاذ بن جبل.(@)(@@) PageV00P000(@)(@@) وإبراهيم لا يتابع على روايته عن ثور، لا يجوز الاحتجاج به.(@)(@@)(@@)(@@) $ 1084 - «الديك الأبيض صديقي وصديق صديقي. . .» الحديث.(@)(@@) رواه عبد الله بن نجيح المدني، عن سهيل، عن أبيه، عن أبي هريرة.(@)(@@) وعبد الله هذا هو والد علي ابن المديني الإمام، وقد سئل عنه فأطرق، ثم سئل فأطرق، ثم رفع رأسه، وقال: هذا هو المديني أبي ضعيف.(@)(@@) قال المقدسي: ورواه أبو شهاب الحناط، عن طلحة بن زيد، عن الأحوص بن حكيم، عن خالد بن معدان، قال: قال رسول الله.(@)(@@) وطلحة بن زيد ليس بشيء أيضا.(@)(@@)(@@)(@@) $ 1085 - «الدجاج غنم فقراء أمتي، والجمعة حج فقرائها» .(@)(@@) رواه هشام بن عبيد الله الرازي، عن ابن أبي ذئب، عن نافع، عن ابن عمر.(@)(@@) وهشام هذا أنكر عليه ابن حبان هذا الحديث، وقال: هو موضوع لا أصل له.(@)(@@)(@@)(@@) | 1086 -(@)(@@) " الرجل يتوضأ للصلاة، ثم يقبل أهله ويلاعبها أينقض ذلك وضوءه؟ قال: «لا» .(@)(@@) PageV00P000(@)(@@) رواه ركن بن عبد الله الشامي، عن مكحول، عن أبي أمامة.(@)(@@) وركن يروي عن مكحول الموضوعات.(@)(@@)(@@)(@@) $ 1087 - «الرجل على دين خليله. . .» الحديث رواه إبراهيم بن أبي يحيى الأسلمي، عن صفوان بن سليم، عن سعيد بن يسار، عن أبي هريرة.(@)(@@) وإبراهيم كذاب.(@)(@@)(@@)(@@) $ 1088 - «الرزق مقسوم 
ms157	 وهو آت ابن آدم على أي سيرة سارها. . .» الحديث.(@)(@@) ورواه يوسف بن السفر، عن الأوزاعي، عن عبدة بن أبي لبابة، عن شقيق، عن ابن مسعود.(@)(@@) ويوسف يتهم بوضع هذا الحديث وغيره.(@)(@@)(@@)(@@) | 1089 -(@)(@@) «الرهن مركوب ومحلوب» .(@)(@@) PageV00P000(@)(@@) رواه إبراهيم بن إسحاق بن إبراهيم البغدادي، عن لوين محمد بن سليمان، عن عيسى بن يونس، عن الأعمش، عن أبي صالح، عن أبي هريرة.(@)(@@) وهذا وهم فاحش، وإنما هو عند عيسى، عن زكريا بن أبي زائدة، عن الشعبي، عن أبي هريرة.(@)(@@) وأما من حديث الأعمش فهو عند أبي عوانة وأبي بكر بن عياش.(@)(@@) وقد رواه نصر بن حماد، عن شعبة، عن الأعمش مثله.(@)(@@)(@@)(@@) $ 1090 - «الزرقة في العين يمن» .(@)(@@) رواه عباد بن صهيب البصري، عن هشام بن عروة، عن أبيه، عن عائشة رضي الله تعالى عنها.(@)(@@) وعباد يتهم بالوضع.(@)(@@)(@@)(@@) $ 1091 - «الزنجي إن جاع سرق، وإن شبع زنا» .(@)(@@) رواه عنبسة بن سعيد أخو أبي الربيع السمان، عن عمرو بن ميمون، عن الزهري، عن عروة، عن عائشة.(@)(@@) وعنبسة متروك الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1092 - «السابع من ولد العباس يلبس الخضرة» .(@)(@@) رواه إسماعيل بن أبان العنبري الخياط، وكان يضع الحديث، ولم يذكر عمن رواه.(@)(@@) وقال في موضع آخر: رواه عبد العزيز بن أبان القرشي، عن فطر، عن أبي الطفيل، عن علي.(@)(@@) قال ابن معين: عبد العزيز وضع هذا الحديث، وهو من ولد سعيد بن العاص.(@)(@@)(@@)(@@) $ 1093 - «السبت لنا والأحد لشيعتنا والاثنين لبني أمية والثلاثاء لشيعتهم، والأربعاء لبني العباس والخميس لشيعتهم، والجمعة لسائر الناس، وليس فيه سفر» .(@)(@@) رواه علي بن موسى الرضا عن آبائه، وكان يأتي عنهم بالعجائب.(@)(@@)(@@)(@@) $ 1094 - «السيف والقوس في السفر بمنزلة الرداء» .(@)(@@) رواه بشر بن عون الشامي، عن بكار بن تميم، عن مكحول، عن واثلة، وهو موضوع.(@)(@@)(@@)(@@) $ 1095 - «السخاء شجرة في الجنة أغصانها في الدنيا. . .» الحديث.(@)(@@) رواه حسين بن علوان، عن هشام، عن أبيه عروة، عن عائشة رضي الله تعالى عنها.(@)(@@) والحسين بن علوان كوفي كذاب(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1096 - «الشمس والقمر ثوران عقيران في النار» .(@)(@@) رواه درست بن زياد البصري، عن يزيد 
ms158	 الرقاشي، عن أنس.(@)(@@) ودرست منكر الحديث.(@)(@@)(@@)(@@) $ 1097 - «الشعر في الأنف أمان من الجذام» .(@)(@@) رواه أشعث بن سعيد السمان، عن هشام بن عروة، عن أبيه، عن عائشة رضي الله تعالى عنها.(@)(@@) وأشعث هذا يروي عن الثقات الموضوعات.(@)(@@)(@@)(@@) $ 1098 - «الشيب نور، من خلع الشيب فقد خلع نور الإسلام» .(@)(@@) رواه الوليد بن موسى الدمشقي، عن الأوزاعي، عن يحيى بن أبي كثير، عن الحسن، عن أنس.(@)(@@) قال ابن حبان: وهذا ما لا أصل له من كلام رسول الله صلى الله عليه وسلم.(@)(@@)(@@)(@@) $ 1099 - «الشرك أخفى في أمتي من دبيب النمل على الصفاة. . .» الحديث.(@)(@@) رواه يحيى بن كثير أبو النضر البصري، عن الثوري، عن أبي إسماعيل بن أبي خالد، عن قيس، عن أبي بكر الصديق.(@)(@@) PageV00P000(@)(@@) ويحيى هذا يروي عن الثقات ما ليس من حديثهم، لا يجوز الاحتجاج به إذا انفرد، وليس هذا بيحيى بن كثير بن درهم، ذاك ثقة كنيته أبو غسان، وهذا يقال له أبو النضر.(@)(@@)(@@)(@@) $ 1100 - «الشيخ في بيته كالنبي في قومه» .(@)(@@) رواه عبد الله بن عمير بن غانم قاضي إفريقيا، عن مالك، عن نافع، عن ابن عمر.(@)(@@) وعبد الله هذا كان يضع الحديث على مالك، وله عن مالك نسخة من هذا الضرب.(@)(@@)(@@)(@@) $ 1101 - «الشتيمة والحقد في النار، لا يجتمعان في صدر مسلم» .(@)(@@) رواه عفير بن معدان، عن عطاء، عن ابن عمر.(@)(@@) وعفير قال ابن معين: ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1102 - «الصائم بالخيار ما بينه وبين نصف النهار» .(@)(@@) رواه عون بن عمارة البصري، عن حميد، عن أنس.(@)(@@) وعون ممن كثر خطؤه، فبطل الاحتجاج به.(@)(@@)(@@)(@@) $ 1103 - «الطابع معلق بقائم عرش الله، فإذا انتهكت الحرمة وعمل بالمعاصي. . .» الحديث.(@)(@@) رواه سليمان بن مسلم، عن سليمان التيمي، عن نافع، عن ابن عمر.(@)(@@) وسليمان هذا يروي عن التيمي ما ليس من حديثه، لا تحل الرواية عنه.(@)(@@)(@@)(@@) $ 1104 - «الطهور مفتاح الصلاة والتحريم تكبيرها، والتسليم تحليلها. . .» الحديث.(@)(@@) رواه طريف بن سفيان، وأبو سفيان السعدي العطاردي، عن أبي نضرة، عن أبي سعيد الخدري.(@)(@@) وطريف هذا ضعيف الحديث، وهذا الذي يقال له طريف بن 
ms159	 سعد، ويقال له طريف بن شهاب، ويقال له طريف الأشل، يحتال فيه لكي لا يعرف لضعفه، وقد وهم حسان بن إبراهيم الكرماني في هذا الخبر، فرواه عن سعيد بن مسروق أبي سفيان الثوري، عن أبي نضرة، عن الخدري.(@)(@@) PageV00P000(@)(@@) وهذا وهم فاحش، ما روى هذا الخبر عن أبي نضرة إلا أبو سفيان السعدي، فتوهم حسان لما رأى أبا سفيان أنه والد الثوري، فحدث به عن سعيد بن مسروق، ولم يضبطه، وليس لهذا الخبر إلا طريقان أبو سفيان السعدي، عن أبي نضرة، عن الخدري، وابن عقيل، عن ابن الحنفية، عن علي، وابن عقيل قد تبرأنا من عهدته في روايته فيما بعد.(@)(@@)(@@)(@@) $ 1105 - «العرب بعضهم لبعض أكفاء. . .» الحديث.(@)(@@) وفيه: «إلا حائك أو حجام» .(@)(@@) رواه عمران بن أبي الفضل، عن نافع، عن ابن عمر.(@)(@@) وعمران كان يروي الموضوعات عن الثقات، لا يحل كتب حديثه إلا على سبيل التعجب.(@)(@@)(@@)(@@) $ 1106 - «العرافة في أولها ملامة، وأوسطها ندامة. . .» الحديث.(@)(@@) رواه عمرو بن شعيب، عن أبيه، عن جده(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1107 - «العمل والإيمان أخوان شريكان. . .» الحديث.(@)(@@) رواه بشر بن إبراهيم الأنصاري، عن عبد الوهاب بن مجاهد، عن أبيه، عن علي.(@)(@@) بشر يضع.(@)(@@)(@@)(@@) $ 1108 - «الغيبة أشد من الزنا. . .» الحديث.(@)(@@) رواه عباد بن كثير الكاهلي، عن الحسن، عن أبي نضرة، عن جابر، وأبي سعيد.(@)(@@) وعباد متروك الحديث.(@)(@@)(@@)(@@) $ 1109 - «الغلاء والرخص جندان من جنود الله عز وجل» .(@)(@@) رواه العباس بن الوليد بن بكار، عن عبد الله بن المثنى، عن عمه تمامة، عن أنس.(@)(@@) والعباس هذا يروي العجائب عن الثقات.(@)(@@)(@@)(@@) $ 1110 - «الغضب من الشيطان، والشيطان خلق من النار» .(@)(@@) رواه عبد الله بن بحير الصنعاني، عن عروة بن عطية، عن أبيه، عن جده، وكانت له صحبة.(@)(@@) PageV00P000(@)(@@) وهذا أبو وائل القاضي يروي العجائب، وليس بعبد الله بن بحير بن ريسان ذاك ثقة.(@)(@@)(@@)(@@) $ 1111 - «الغنم بركة والإبل عز لأهلها، والخيل معقود في نواصيها الخير، والعبد أخوك، فإن عجز فأعنه» .(@)(@@) رواه أرطأة بن الأشعث العدوي، عن الأعمش، عن شقيق بن سلمة، عن أبي هريرة.(@)(@@) وأرطأة شيخ يروي عن 
ms160	 الأعمش العجائب.(@)(@@)(@@)(@@) $ 1112 - «الفطر يوم تفطرون، والأضحى يوم تضحون» .(@)(@@) رواه موسى بن عبيدة الربذي، عن أبي بكر بن عبد الله بن أبي رحمة، عن ابن عمر.(@)(@@) وموسى قال يحيى بن معين: هو لا شيء في الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1113 - «القدرية مجوس هذه الأمة» .(@)(@@) رواه زكريا بن منظور، عن أبي حازم، عن نافع، عن ابن عمر.(@)(@@) وزكريا ليس بشيء في الحديث.(@)(@@)(@@)(@@) $ 1114 - «الكلمة الحكمة ضالة المؤمن» .(@)(@@) رواه إبراهيم بن الفضل المخزومي، عن المقبري، عن أبي هريرة.(@)(@@) وإبراهيم ليس بشيء في الحديث.(@)(@@)(@@)(@@) $ 1115 - «اللوطيان لو اغتسلا بماء البحر لم يجزئهما حتى يتوبا. . . .» الحديث.(@)(@@) رواه روح بن مسافر البصري، عن حماد، عن إبراهيم، عن علقمة، عن عبد الله.(@)(@@) وروح يضع الحديث(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1116 - «اللص محارب لله ولرسوله فاقتلوه» .(@)(@@) رواه فرات بن زهير، عن مالك قال: أخبرتني أمي، عن أم علقمة، عن عائشة.(@)(@@) وهذا منكر لم يحدث به إلا فرات فأوجب تركه.(@)(@@)(@@)(@@) $ 1117 - «المؤمن غر كريم والفاجر خب لئيم» .(@)(@@) رواه بشر بن نافع النجراني، عن يحيى بن أبي كثير، عن أبي سلمة، عن أبي هريرة.(@)(@@) وبشر هذا يضع.(@)(@@) PageV00P000(@)(@@)(@@)(@@) $ 1118 - «المؤمن يألف، ولا خير فيمن لا يألف ولا يؤلف» .(@)(@@) رواه مصعب بن ثابت بن عبد الله بن الزبير، عن أبي حازم، عن سهل بن سعد.(@)(@@) مصعب منكر الحديث، وقال ابن معين: ضعيف.(@)(@@) ورواه عمرو بن بكر السكسكي، عن ابن جريج، عن عطاء، عن جابر.(@)(@@) وعمرو هذا روى الأوابد والطامات، وهذا أحد ما أنكر عليه.(@)(@@)(@@)(@@) $ 1119 - «المؤمن واه راقع، فالسعيد من هلك على رقعه» .(@)(@@) رواه سعيد بن خالد الخزاعي، عن محمد بن المنكدر، عن جابر.(@)(@@) وسعيد أنكر عليه هذا الحديث، وليس هذا سعيد بن خالد الذي يروي عنه ابن أبي ذئب، ذاك ثقة، يروي عن أبي سلمة بن عبد الرحمن.(@)(@@)(@@)(@@) $ 1120 - " المرجئة والقدرية والروافض والخوارج سلبت منهم أربع: التوحيد. . " الحديث.(@)(@@) رواه أبو عباد الزاهد، عن مخلد بن حسين، عن هشام بن حسان، عن الحسن،(@)(@@) PageV00P000(@)(@@) عن أنس، وأبو عباد يروي عن مخلد ما لم يحدث به قط.(@)(@@)(@@)(@@) $ 1121 - «المضمضة والاستنشاق 