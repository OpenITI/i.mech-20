ms2520	 قتلوا الحسين بن علي رضى الله عنهما قتله المختار سنة خمس وستين أو بعدها.(@)(@@)(@@)(@@) | 4184 - (@)(@@) " عمر " بن سعيد عن عمرو بن شعيب.(@)(@@)(@@)(@@) | 4185 - (@)(@@) " عمر " بن سفينة أبو برية الهاشمي مولاهم عن أبيه وعنه ابنه برية.(@)(@@)(@@)(@@) | 4186 - (@)(@@) " عمر " بن أبي سلمة بن عبد الرحمن بن عوف الزهري المدني قاضيها عن أبيه وعنه ابن عمه سعد بن إبراهيم ومسعر وأبو عوانة.(@)(@@)(@@)(@@) | 4187 - (@)(@@) " عمر " بن أبي سليمان الحجازي عن تابعي1 وعنه شبل بن عباد لا يكاد يعرف.(@)(@@)(@@)(@@) | 4188 - (@)(@@) " عمر " بن سليم الباهلي أو المزني البصري عن الحسن وعنه زيد بن الحباب ومسلم بن إبراهيم.(@)(@@)(@@)(@@) | 4189 - (@)(@@) " عمر " بن شاكر البصري تابعي عن أنس وعنه إسماعيل بن موسى.(@)(@@)(@@)(@@) | 4190 - (@)(@@) " عمر " بن شبيب2 المسلي أبو حفص الكوفي عن عبد الملك بن عمير وعنه عمر بن شبة.(@)(@@)(@@)(@@) | 4191 - (@)(@@) " عمر " بن شقيق بن أسماء الجرمي البصري عن إسماعيل بن سالم وعنه ابنه الحسن وروح بن عبادة.(@)(@@)(@@)(@@) | 4192 - (@)(@@) " عمر " بن صبح3 بن عمران التميمي أو العدوي أبو نعيم الخراساني PageV07P318(@)(@@)(@@)(@@) | 4204 - (@)(@@) " عمر " بن عطاء بن وراز1 عن سالم أبي الغيث وعنه ابن جريج.(@)(@@)(@@)(@@) | 4205 - (@)(@@) " عمر " بن علي بن عطاء بن مقدام المقدمي الثقفي أبو حفص البصري عن يحيى بن سعيد الأنصاري وعنه ابناه محمد وهاشم.(@)(@@)(@@)(@@) | 4206 - (@)(@@) " عمر " بن أبي عمر وهو ابن رباح مر.(@)(@@)(@@)(@@) | 4207 - (@)(@@) " عمر " بن فروخ2 العبدي أبو حفص البصري صاحب الاقتاب عن حبيب بن الزبير وغيره وعنه يعقوب وعدة ثقة أورده بن عدي في الكامل.(@)(@@)(@@)(@@) | 4208 - (@)(@@) " عمر " بن قتادة بن النعمان الظفري3 الأنصاري المدني عن أبيه وعنه ابنه عاصم وثقه بن حبان.(@)(@@)(@@)(@@) | 4209 - (@)(@@) " عمر " بن قيس المكي المعروف بسندل أبو حفص عن عطاء وعنه ابن عيينة وابن وهب.(@)(@@)(@@)(@@) | 4210 - (@)(@@) " عمر " بن المثنى الأشجعي الرقي عن عطاء الخراساني وعنه عمر بن عبيد الطنافسي.(@)(@@)(@@)(@@) | 4211 - (@)(@@) " عمر " بن محمد بن زيد بن عبد الله بن عمر بن الخطاب المدني نزيل عسقلان عن جده وسالم وعنه شعبة ويزيد بن زريع.(@)(@@)(@@)(@@) | 4212 - (@)(@@)