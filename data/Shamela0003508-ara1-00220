ms201	 بن المسور وهو عبد الرحمن بن المسور بن مخرمة(@)(@@)(@@)(@@) | 2942 - (@)(@@) قال يحيى وسألته عن طليق بن قيس فقال يقولون إنه أخو أبي صالح الحنفي قال يحيى وأبو صالح عبد الرحمن بن قيس(@)(@@)(@@)(@@) | 2943 - (@)(@@) سمعت يحيى يقول قد روى سفيان عن سلمة بن المنهال شيخ لهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2944 - (@)(@@) سمعت يحيى يقول قد روى سفيان عن سعيد بن عبد الرحمن الزبيدي وأبو شيبة وقد سمع حكام وقاسم بن مالك وعبد الواحد بن زياد كلهم من أبي شيبة هذا وهو سعيد بن عبد الرحمن قال يحيى وقد سمع منه أبو جعفر الرازي وهو ثقة(@)(@@)(@@)(@@) | 2945 - (@)(@@) سمعت يحيى يقول وقد روى زهير وأبو العميس عن أبي سنان عن أبي صالح الحنفي عن أخيه طليق بن قيس(@)(@@)(@@)(@@) | 2946 - (@)(@@) سمعت يحيى يقول حديث الطاعون حديث حبيب بن أبي ثابت عن إبراهيم بن سعد هو إبراهيم بن سعد بن مالك(@)(@@)(@@)(@@) | 2947 - (@)(@@) قال يحيى أبو عباد هو عبد الله بن سعيد بن أبي سعيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2948 - (@)(@@) سمعت يحيى يقول قال معمر الرقي عن حجاج بن أرطاة قال أسند لي إبراهيم والشعبي الحديث قلت ليحيى سمع منهما قال لا سمع من الشعبي حرفا واحد لم يسمع من إبراهيم شيئا قلت ليحيى ما يعني بقوله أسند لي إبراهيم والشعبي الحديث حدثاني فأسندا لي قال نعم قال يحيى وهذا عندنا خطأ أخطأ فيه معمر عن حجاج(@)(@@)(@@)(@@) | 2949 - (@)(@@) سمعت يحيى يقول صالح بن مسعود وهو جد لي يروي عنه مروان بن معاوية وقد سمع هذا من أبي جحيفة(@)(@@)(@@)(@@) | 2950 - (@)(@@) سمعت يحيى يقول سيار هو أبو حمزة وهو كوفي يروى عنه أسباط قال يحيى هذا غير سيار صاحب الشعبي ذاك يقال له سيار بن أبي سيار ويقال له سيار العنزي وهو سيار أبو الحكم(@)(@@)(@@)(@@) | 2951 - (@)(@@) سمعت يحيى يقول أبو إلياس بن بنت وهب بن منبه وقد روى عنه مروان بن معاوية(@)(@@)(@@)(@@) | 2952 - (@)(@@) سمعت يحيى يقول يونس بن أبي إسحاق قد سمع من المغيرة بن شبل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2953 - (@)(@@) سمعت يحيى يقول الحديث الذي يروونه خدرت رجل بن 
ms202	 عمر وهو أبو إسحاق عن عبد الرحمن بن سعد قيل ليحى من عبد الرحمن بن سعد قال لا أدري شك العباس سعيد أو سعد(@)(@@)(@@)(@@) | 2954 - (@)(@@) سمعت يحيى يقول قال أبو نعيم محمد بن قيس الأسدي مرجيء قال يحيى وكان أبو نعيم إذا قال في إنسان إنه مرجيء فهو من خيار الناس(@)(@@)(@@)(@@) | 2955 - (@)(@@) سمعت يحيى يقول أبو المعتمر هو يزيد بن طهمان كان بصريا نزل الكوفة كان يروى عنه أبو نعيم وكان من أهل السنة وكان ثقة وكان يروي عنه أبو عبيدة(@)(@@)(@@)(@@) | 2956 - (@)(@@) سمعت يحيى يقول عيسى بن قرطاس ضعيف(@)(@@)(@@)(@@) | 2957 - (@)(@@) وعيسى بن عمر ثقة(@)(@@)(@@)(@@) | 2958 - (@)(@@) وعيسى بن طهمان ثقة(@)(@@)(@@)(@@) | 2959 - (@)(@@) وعيسى بن المسيب البجلي كوفي وليس بشيء(@)(@@)(@@)(@@) | 2960 - (@)(@@) وعيسى الخياط ليس بشيء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2961 - (@)(@@) سمعت يحيى يقول في حديث أبي هلال الكعبي هو الصواب وليس هذا أبو هلال العتكي(@)(@@)(@@)(@@) | 2962 - (@)(@@) سمعت يحيى يقول أبو السمحاء سهل بن حسان(@)(@@)(@@)(@@) | 2963 - (@)(@@) حدثنا يحيى قال حدثنا حجاج قال حدثنا يونس بن أبي إسحاق عن أبي إسحاق عن سعيد بن جبير عن بن عباس قال ولد رسول الله صلى الله عليه وسلم يوم الفيل وقد كان يحيى قال ولد النبي صلى الله عليه وسلم عام الفيل ثم رجع فقال يوم الفيل هذا الآخر من قول يحيى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2964 - (@)(@@) حدثنا يحيى قال حدثنا عبد السلام بن حرب عن مالك بن دينار قال رأيت في يد مجاهد خاتم حديد ورأيت في يده سعفة يطرد بها حمام مكة(@)(@@)(@@)(@@) | 2965 - (@)(@@) حدثنا يحيى قال حدثنا عبد السلام بن حرب عن يونس عن الحسن قال القتل بالقسامة جاهلية(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2966 - (@)(@@) سمعت يحيى يقول حدثنا عبد السلام بن حرب عن يزيد يعني الدالاني عن عمرو بن مرة عن سعيد بن جبير قال كان أحدهم يصلي في الحرب وهو يسعى(@)(@@)(@@)(@@) | 2967 - (@)(@@) سمعت يحيى يقول قطري الخشاب ليس به بأس(@)(@@)(@@)(@@) | 2968 - (@)(@@) يزيد بن مردانبه ثقة(@)(@@)(@@)(@@) | 2969 - (@)(@@) حدثنا يحيى قال حدثنا أبو يحيى الحماني عن حميد الأعرج قال كنا في كتاب عبد الله بن الحارث فكان لا 
ms203	 يأخذ منا شيئا سمعت يحيى يقول وحميد الأعرج هذا قاص وهو كوفي(@)(@@)(@@)(@@) | 2970 - (@)(@@) قال يحيى داود بن عبد الله الأودي الذي يروي منه حسن بن صالح وأبو عوانة ثقة(@)(@@)(@@)(@@) | 2971 - (@)(@@) وداود بن يزيد الأودي ليس حديثه بشيء وهو عم بن إدريس(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2972 - (@)(@@) سمعت يحيى يقول وكيع يسند حديثا عن هشام بن عروة عن أبيه عن عائشة لا يسنده أحد غيره وأنذر عشيرتك الأقربين(@)(@@)(@@)(@@) | 2973 - (@)(@@) سمعت يحيى يقول عيسى بن يونس يسند حديثا عن هشام عن أبيه عن عائشة أن النبي صلى الله عليه وسلم كان يقبل الهدية ولا يأكل الصدقة والناس يحدثون به مرسلا(@)(@@)(@@)(@@) | 2974 - (@)(@@) سمعت يحيى يقول علي بن مالك الغنوي ليس حديثه بشيء(@)(@@)(@@)(@@) | 2975 - (@)(@@) سمعت يحيى يقول عبد الرحمن بن معقل وعبد الله بن معقل أخوان عبد الله بن معقل قال دخلت مع أبي علي عبد الله بن مسعود وعبد الرحمن بن معقل سمع من علي بن أبي طالب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2976 - (@)(@@) حدثنا يحيى قال حدثنا عبد الرزاق عن سفيان قال كان التقصير إلا في مسيرة ثلاث وكان يحتج بحديث النبي صلى الله عليه وسلم لا تسافر امرأة إلا ومعها ذو محرم قلت ليحيى فإذا أراد سفرا مثل الري أو خراسان قال يقصر حين يخرج من الباب يعني من باب خراسان(@)(@@)(@@)(@@) | 2977 - (@)(@@) سمعت يحيى يقول مالك بن الحارث كان له أخ يقال له عبد الرحمن بن الحارث كان يصحب علقمة والأسود في الحج وينفق عليهم(@)(@@)(@@)(@@) | 2978 - (@)(@@) سئل يحيى عن نوح بن دراج قال لم يكن يدري ما الحديث ولا يحسن شيئا كان عنده حديث غريب عن بن شبرمة عن الشعبي في المحرم يضطر إلى الميتة أو الصيد ليس يرويه أحد غيره ولم يكن ثقة وكان أسد بن عمرو أوثق منه وكان لنوح كاتب فأخذ حنطة الصدقة فذهب فطرحها في السفينة فلحقوه فأخذوها منه وكان يقضي وهو أعمى ثلاث سنين وكان لايخبر الناس أنه أعمى من خبثه(@)(@@)(@@)(@@) | 2979 - (@)(@@) سمعت يحيى يقول كان أسد بن عمرو قد سمع من يزيد بن أبي 
ms204	 زياد ومن مطرف ومن ربيعة الرأي ولم يكن به بأس ولما أنكر بصره ترك القضاء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2980 - (@)(@@) سمعت يحيى يقول حديث سفيان عن منصور عن مجاهد قال أين الذين كانوا ينزهون أسماعهم عن اللهو حدث به جعفر بن عون وليس هذا بشيء لا أظن له أصلا أو كما قال يحيى(@)(@@)(@@)(@@) | 2981 - (@)(@@) سمعت يحيى يقول مرة بن شراحيل هو مرة الطيب وإنما سمي الطيب لعبادته(@)(@@)(@@)(@@) | 2982 - (@)(@@) سمعت يحيى يقول روى الثوري عن بن أبجر عن سيار أبي حمزة وقد روى عن سيار أبو حمزة هذا الصلت بن بهرام وسيار هذا كوفي(@)(@@)(@@)(@@) | 2983 - (@)(@@) سمعت يحيى يقول روى مندل عن هشام بن عروة عن أبيه عن عائشة عن النبي صلى الله عليه وسلم قال لا نكاح إلا بولي قال يحيى وهذا حديث ليس بشيء(@)(@@)(@@)(@@) | 2984 - (@)(@@) سمعت يحيى يقول حبيب بن أبي عمرة مولى لبني حمان وكان حبيب قصارا(@)(@@)(@@)(@@) | 2985 - (@)(@@) سمعت يحيى يقول يوسف بن أبي إسحاق روى عنه إسرائيل وهو عم إسرائيل(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2986 - (@)(@@) سمعت يحيى يقول قد رأى عيسى بن يونس أبا إسحاق جده فرددته على يحيى قلت له رأى أبا إسحاق فقال نعم(@)(@@)(@@)(@@) | 2987 - (@)(@@) سمعت يحيى يقول حدثنا بن إدريس عن هارون بن أبي إبراهيم البربري عن عبد الله بن عبيد بن عمير قال إن أهون النسك اللباس والمشية قال يحيى هارون البربري كوفي(@)(@@)(@@)(@@) | 2988 - (@)(@@) سمعت يحيى يقول فراس صاحب الشعبي وهو فراس بن يحيى وكان مكتبا(@)(@@)(@@)(@@) | 2989 - (@)(@@) سمعت يحيى يقول قيس بن مسلم أو سليم العنبري كوفي(@)(@@)(@@)(@@) | 2990 - (@)(@@) عبد الملك بن أبي جمعة كوفي ضعيف(@)(@@)(@@)(@@) | 2991 - (@)(@@) علي بن مالك ضعيف(@)(@@)(@@)(@@) | 2992 - (@)(@@) سمعت يحيى يقول خالد بن طهمان هو أبو العلاء الخفاف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2993 - (@)(@@) سمعت يحيى يقول إسماعيل بن أبي خالد روى عن مدرك بن عمارة ومدرك بن عمارة هذا هو مدرك بن عمارة بن عقبة بن أبي معيط(@)(@@)(@@)(@@) | 2994 - (@)(@@) سمعت يحيى يقول قد روى وكيع عن رجل يقال له بشر صاحب الهروي عن زيد بن ثوب(@)(@@)(@@)(@@) | 2995 - (@)(@@) سمعت يحيى يقول حميد الأعرج الكوفي 
ms205	 وهو حميد بن عطاء(@)(@@)(@@)(@@) | 2996 - (@)(@@) سمعت يحيى يقول حجاج النخعي هو حجاج بن أرطاة(@)(@@)(@@)(@@) | 2997 - (@)(@@) سمعت يحيى يقول لقب يحيى الجزار زبان(@)(@@)(@@)(@@) | 2998 - (@)(@@) سمعت يحيى يقول كيسان أبو عمرو كوفي يروي عن يزيد بن بلال مولاه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 2999 - (@)(@@) سمعت يحيى يقول مسور بن الصلت كان كوفيا قد سمع منه سعدويه وكان يحدث بأحاديث الشيعة(@)(@@)(@@)(@@) | 3000 - (@)(@@) سمعت يحيى يقول أبو الخطاب لم أسمع به إلا في أحاديث بن أبي غنية(@)(@@)(@@)(@@) | 3001 - (@)(@@) سمعت يحيى يقول قد سمع بن نمير من عبد الله بن عطاء سمع منه أبو معاوية وسمع منه مروان بن معاوية الفزاري قال يحيى وقد روى أبو إسحاق السبيعي عن عبد الله بن عطاء هذا وكان عبد الله بن عطاء هذا كوفيا وكان ينزل مكة وقد روى عنه حبان يعني بن علي أيضا(@)(@@)(@@)(@@) | 3002 - (@)(@@) سمعت يحيى يقول رشدين بن كريب ومحمد بن كريب أخوه وكان محمد أمثلهما(@)(@@)(@@)(@@) | 3003 - (@)(@@) سمعت يحيى يقول محمد بن ميمون الزعفراني ثقة وقد سمعت منه(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3004 - (@)(@@) سمعت يحيى يقول قد سمعت من إسماعيل بن محمد بن جحادة وكان أعمى ولم يكن به بأس(@)(@@)(@@)(@@) | 3005 - (@)(@@) سمعت يحيى يقول قد سمع بن فضيل من حنظلة بن الأسود وحدثنا عنه قال يحيى ويقولون إنما هو عثمان بن الأسود ولكنه أخطأ فيه فقال حنظلة بن الأسود(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3006 - (@)(@@) سمعت يحيى يقول أبو الدهقانة يروي عن بن عمر وروى فضيل بن غزوان عن أبي الدهقانة(@)(@@)(@@)(@@) | 3007 - (@)(@@) سمعت يحيى يقول سفيان العطار هو سفيان العصفري(@)(@@)(@@)(@@) | 3008 - (@)(@@) سمعت يحيى يقول روى عبيد الله بن موسى عن عبد الله بن حميد(@)(@@)(@@)(@@) | 3009 - (@)(@@) سمعت يحيى يقول قرة العجلي روى عنه إسماعيل بن أبي خالد فقط(@)(@@)(@@)(@@) | 3010 - (@)(@@) سمعت يحيى يقول محمد بن علي السلمي أخو منصور بن المعتمر لأمه(@)(@@)(@@)(@@) | 3011 - (@)(@@) سمعت يحيى يقول في الحديث الذي يروي أتي حبر النبي صلى الله عليه وسلم يرويه سفيان الثوري عن منصور عن إبراهيم عن عبيدة والأعمش يرويه عن إبراهيم عن علقمة قال الحديث ليس بشيء الحديث حديث الثوري(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3012 - (@)(@@) سمعت 
ms206	 يحيى بن معين يقول كتب إلى رجل فقال أرأيت إن حلفنا على يمين وقد كنا حين أصبحنا قلنا اللهم ما حلفنا من حلف فمشيئتك في ذلك فترى علينا كفارة فقلت نعم فيما أعلم أن يحيى قال أشد الكفارة(@)(@@)(@@)(@@) | 3013 - (@)(@@) سمعت يحيى يقول أبو نهيك اسمه القاسم بن محمد يروي عنه سفيان ومسعر وجرير الضبي(@)(@@)(@@)(@@) | 3014 - (@)(@@) سمعت يحيى يقول يروي سفيان عن رجل يقال له السري بن كعب وقد رأى السري الحسن بن علي(@)(@@)(@@)(@@) | 3015 - (@)(@@) سمعت يحيى يقول أبو تحيى هو حكيم بن سعد(@)(@@)(@@)(@@) | 3016 - (@)(@@) سمعت يحيى يقول قد روى سفيان ومسعر عن أبي غسان قال يحيى وأبو غسان هو يحيى بن غسان وهو كوفي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3017 - (@)(@@) سمعت يحيى يقول قد روى سفيان الثوري عن ركين قلت ليحيى هو ركين بن الربيع قال لا هذا ركين آخر وهو كوفي(@)(@@)(@@)(@@) | 3018 - (@)(@@) سمعت يحيى يقول قد روى إسماعيل بن أبي خالد عن أبي حازم وهو نبتل مولى بن عباس(@)(@@)(@@)(@@) | 3019 - (@)(@@) سمعت يحيى يقول ربعي بن حراش يقولون أهل الكوفة إنه قد رأى عمر بن الخطاب(@)(@@)(@@)(@@) | 3020 - (@)(@@) حدثنا يحيى قال حدثنا القاسم بن مالك عن ليث عن معاوية عن رجل من بني كاهل قال رأيت على علي تبانا وقال نعم الثوب ما أستره للعورة وأكفه للأذى قلت ليحيى من معاوية هذا قال لا أدري(@)(@@)(@@)(@@) | 3021 - (@)(@@) حدثنا يحيى قال حدثنا القاسم بن مالك عن إسماعيل بن سميع عن أبي رزين قال إن أفضل ثوب رأيته على علي رضي الله عنه القميص من قهز وبردين قطريين قال العباس كل ثوب يضرب إلى السواد من ثياب اليمن يسمى قطريا(@)(@@)(@@)(@@) | 3022 - (@)(@@) سمعت يحيى يقول قد روى سفيان الثوري عن حريش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3023 - (@)(@@) سمعت يحيى يقول أبو عاصم العبسي هو علي بن عبيد الله العطار يروي عنه سفيان الثوري وابن إدريس(@)(@@)(@@)(@@) | 3024 - (@)(@@) وأبو عاصم الثقفي أيضا آخر(@)(@@)(@@)(@@) | 3025 - (@)(@@) وأبو عاصم الغنوي يروي عنه حماد بن سلمة(@)(@@)(@@)(@@) | 3026 - (@)(@@) سمعت يحيى يقول أبو نصر هو عبد الله بن عبد الرحمن(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3027 - (@)(@@) سمعت يحيى 
ms207	 يقول بن أخي أبي الأحوص هو أبو الزعراء يروى عنه سفيان الثوري ويروى عنه بن عيينة(@)(@@)(@@)(@@) | 3028 - (@)(@@) سمعت يحيى يقول في حديث العلاء بن عبد الكريم عن أبي كرمة قال يحيى نعم هو أبو كرمة(@)(@@)(@@)(@@) | 3029 - (@)(@@) سمعت يحيى يقول سفيان الثوري يروي عن سلمة بن المنهال وهو كوفي(@)(@@)(@@)(@@) | 3030 - (@)(@@) سمعت يحيى يقول سفيان عن زياد بن إسماعيل قال يحيى هو سهمي(@)(@@)(@@)(@@) | 3031 - (@)(@@) سمعت يحيى يقول ياسين الزيات هو أبو معاذ(@)(@@)(@@)(@@) | 3032 - (@)(@@) وقاء بن إياس أبو يزيد(@)(@@)(@@)(@@) | 3033 - (@)(@@) سمعت يحيى يقول عمر بن راشد كوفي قال يحيى وإسماعيل بن راشد أخوه وهو أيضا أخو محمد بن أبي إسماعيل وأبوه إسماعيل اسمه راشد(@)(@@)(@@)(@@) | 3034 - (@)(@@) سمعت يحيى يقول قاسم بن مالك أبو حفص(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3035 - (@)(@@) سمعت يحيى يقول قد سمع أبو إسحاق السبيعي من عمرو بن مرة حديث علي قال قال لي النبي صلى الله عليه وسلم ألا أعلمك دعاء(@)(@@)(@@)(@@) | 3036 - (@)(@@) سمعت يحيى يقول قد روى أبو عوانة وشعبة ومسعر عن أبي العنبس وليس هو من أمر أبوي العنبس الصغيرين في شيء أحد ذينك يقال له عمرو بن مروان يروى عنه وكيع والآخر سعيد بن كثير يروى عنه حفص بن غياث وثلاثتهم كوفيون وأبو العنبس الذي يحدث عنه يعلى بن عبيد هو سعيد بن كثير(@)(@@)(@@)(@@) | 3037 - (@)(@@) سمعت يحيى يقول سعد بن طريف هو سعد الإسكاف يروى عنه مندل(@)(@@)(@@)(@@) | 3038 - (@)(@@) سمعت يحيى يقول سعيد بن المرزبان هو أبو سعيد البقال وليس بشيء(@)(@@)(@@)(@@) | 3039 - (@)(@@) سمعت يحيى يقول أبو سفيان السعدي طريف بن شيهاب يروى عن شريك(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3040 - (@)(@@) سمعت يحيى يقول قد روى أبو نعيم عن عبد القاهر وروى عنه أبو الوليد الطيالسي وهو أبو رفاعة(@)(@@)(@@)(@@) | 3041 - (@)(@@) سمعت يحيى يقول منصور بن سعد كوفي(@)(@@)(@@)(@@) | 3042 - (@)(@@) سمعت يحيى يقول عنبسة بن سعيد الحاسب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3043 - (@)(@@) حدثنا يحيى قال حدثنا وكيع عن عمر بن ذر قال فرأت كتاب سعيد بن جبير إلى أبي أعلم أن كل يوم يعيشه المؤمن فهو غنيمة(@)(@@)(@@)(@@) | 3044 - (@)(@@) سمعت يحيى يقول في حديث جرير عن مغيرة 
ms208	 عن الشعبي كره أن يسف الرجل النظر إلى أخته قيل ليحيى هو يسف قال نعم(@)(@@)(@@)(@@) | 3045 - (@)(@@) سمعت يحيى يقول في حديث سفيان عن أبي إسحاق عن عبيدة بن ربيعة(@)(@@)(@@)(@@) | 3046 - (@)(@@) قال يحيى في حديث سفيان عن أبي هاشم عن إسماعيل بن رياح(@)(@@)(@@)(@@) | 3047 - (@)(@@) سمعت يحيى يقول في حديث يطرق فحله فيبقى حير الدهر قال أبو الفضل وكان أبو خيثمة حاضرا فسمع يحيى يقول هذا فقال أبو خيثمة قال لنا عبد الرحمن بن مهدي حين الدهر يريد أبدا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3048 - (@)(@@) حدثنا يحيى قال حدثنا أبو معاوية عن أبي بسطام عن الضحاك ولو ألقا معاذيره قال ستوره قلت ليحيى إنما يروى هذا مروان بن معاوية فقال إنما يروي هذا أبو معاوية لا شك فيه(@)(@@)(@@)(@@) | 3049 - (@)(@@) سمعت يحيى يقول في حديث خريم الحديث كما حدث به محمد بن عبيدة ومروان بن معاوية لم يقمه(@)(@@)(@@)(@@) | 3050 - (@)(@@) سمعت يحيى يقول محمد بن سعد الأنصاري يروي عنه سفيان بن عيينة وابن فضيل وغيره(@)(@@)(@@)(@@) | 3051 - (@)(@@) سمعت يحيى يقول محمد بن سالم كنيته أبو سهل(@)(@@)(@@)(@@) | 3052 - (@)(@@) حدثنا يحيى حدثنا جرير بن عبد الحميد عن مغيرة قال كنت أكثر الضحك فما قطعه عني إلا قتل زيد بن علي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3053 - (@)(@@) حدثنا يحيى قال حدثنا جرير عن مغيرة قال كان فرقد السبخي حائكا وكان من نصارى أهل إرمينية وهو الذي دلنا على إبراهيم(@)(@@)(@@)(@@) | 3054 - (@)(@@) سمعت يحيى يقول شيبة بن نعامة الذي روى عنه أبو معاوية الضرير ضعيف الحديث(@)(@@)(@@)(@@) | 3055 - (@)(@@) سمعت يحيى يقول لم يسمع الشعبي من أسامة(@)(@@)(@@)(@@) | 3056 - (@)(@@) سمعت يحيى يقول إسرائيل وشريك أحب إلي من مجالد(@)(@@)(@@)(@@) | 3057 - (@)(@@) سمعت يحيى يقول مندل وحبان فيهما ضعف وهما أحب إلى من قيس(@)(@@)(@@)(@@) | 3058 - (@)(@@) سمعت يحيى يقول كان علي بن مسهر ثبتا قال يحيى قال عبد الله بن نمير كان يجئني على بن مسهر فيسألني كيف حديث كذا قال يحيى قال بن نمير كان على بن مسهر قد دفن كتبه قال يحيى وكان علي بن مسهر أثبت من بن نمير(@)(@@)(@@)(@@) | 3059 - (@)(@@) سمعت يحيى يقول ولي 
ms209	 علي بن مسهر قضاء إرمينية فلما صار إلى إرمينية اشتكى عينه فجعل يختلف إليه متطبب فقال ذاك القاضي الذي بإرمينية للمتطبب اكحله بشيء يذهب عينه حتى أعطيك كذا وكذا فكحله بذاك الكحل فذهبت عينه فرجع إلى الكوفة أعمى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3060 - (@)(@@) حدثنا يحيى قال حدثنا أبو معاوية عن مسعر عن حماد عن إبراهيم قال قال عبد الله أنا مؤمن قال يحيى هذا خطأ إنما هو عن موسى بن أبي كثير رجل من المرجئة حدثنا يحيى قال حدثنا وكيع عن مسعر عن موسى بن أبي كثير عن رجل لم يسمه عن أبيه قال قال عبد الله أنا مؤمن(@)(@@)(@@)(@@) | 3061 - (@)(@@) سئل يحيى عن وكيع وابن أبي زائدة فقال وكيع أثبت من بن أبي زائدة(@)(@@)(@@)(@@) | 3062 - (@)(@@) سمعت يحيى يقول أبو الأسباط كوفي وقد روى عنه حاتم بن إسماعيل(@)(@@)(@@)(@@) | 3063 - (@)(@@) سمعت يحيى يقول النضر بن مطرف كوفي روى عنه الفزاري غيره وهو ضعيف(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3064 - (@)(@@) سمعت يحيى يقول حدثنا أبو بكر بن عياش قال سمعت مغيرة يقول والله لأنا منكم أخوف مني من الفساق أصحاب الحديث(@)(@@)(@@)(@@) | 3065 - (@)(@@) حدثنا يحيى قال حدثنا أبو معاوية عن الأعمش قال كنا نأتي خيثمة فيخرج إلينا سلالا من خبيص فيقول إنما صنعتها من أجلكم(@)(@@)(@@)(@@) | 3066 - (@)(@@) حدثنا العباس قال حدثنا يعلى بن عبيد قال حدثنا الأعمش عن خيثمة قال كان عيسى بن مريم يصنع الطعام لأصحابه فيطعمهم ويقوم عليهم ويقول هكذا فاصنعوا بالقراء(@)(@@)(@@)(@@) | 3067 - (@)(@@) حدثنا يحيى قال حدثنا أبو معاوية عن الأعمش قال كان خيثمة سيدا(@)(@@)(@@)(@@) | 3068 - (@)(@@) سمعت يحيى يقول أبو بسطام اسمه يحيى بن عبد الرحمن التميمي(@)(@@)(@@)(@@) | 3069 - (@)(@@) سمعت يحيى يقول سمعت أبا حفص الأبار قال ناولت السدي من يدي إلى يده نبيذ صلب فيه دردي فشرب قال أبو حفص الأبار قال لي حصين بن عبد الرحمن لا تشرب الحلو(@)(@@)(@@)(@@) | 3070 - (@)(@@) سمعت يحيى يقول عبد الرحمن بن إسحاق الكوفي ليس بشيء(@)(@@)(@@)(@@) | 3071 - (@)(@@) سمعت يحيى يقول عثمان بن حكيم ثقة(@)(@@)(@@)(@@) | 3072 - (@)(@@) سمعت يحيى يقول محمد بن جحادة كوفي من الأود(@)(@@)(@@)(@@) | 3073 - (@)(@@) حبيب بن 
ms210	 أبي ثابت كنيته أبو يحيى(@)(@@)(@@)(@@) | 3074 - (@)(@@) سمعت يحيى يقول العلاء بن خالد الأسدي كوفي(@)(@@)(@@)(@@) | 3075 - (@)(@@) سمعت يحيى يقول عبادة بن مسلم الفزاري يروي عنه سفيان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3076 - (@)(@@) سمعت يحيى يقول الحكم عن عبد الحميد بن عبد الرحمن بن زيد بن الخطاب وهو الذي روى عن مقسم عن بن عباس في الذي يأتي امرأته وهي حائض قال يتصدق بدينار(@)(@@)(@@)(@@) | 3077 - (@)(@@) سمعت يحيى يقول لم يرحل مسعر في حديث قط وإنما سمع بالكوفة وفي المسجد(@)(@@)(@@)(@@) | 3078 - (@)(@@) سمعت يحيى يقول بريد بن عبد الله بن أبي بردة ثقة(@)(@@)(@@)(@@) | 3079 - (@)(@@) سمعت يحيى يقول الوليد بن عقبة الشيباني هو الطحان(@)(@@)(@@)(@@) | 3080 - (@)(@@) سمعت يحيى يقول معاوية النصري هو معاوية بن سلمة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3081 - (@)(@@) سمعت يحيى يقول جابر بن نوح ليس حديثه بشيء كان حفص يضعفه وقد كتبت عن أبيه نوح بن جابر وكان يبيع الغنم(@)(@@)(@@)(@@) | 3082 - (@)(@@) سمعت يحيى يقول وذكر محمد بن القاسم الأسدي فلم يرضه قال أبو الفضل ومذهب يحيى عندي في محمد بن القاسم أن محمد بن القاسم رجل لم يكن من أصحاب الحديث ولم يكن له تيقظ أصحاب الحديث(@)(@@)(@@)(@@) | 3083 - (@)(@@) سمعت يحيى يقول يزيد بن كيسان هو أبو منين(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3084 - (@)(@@) سمعت يحيى يقول لم يسمع الحجاج بن أرطاة من الشعبي إلا حديثا ولم يسمع من الزهري شيئا(@)(@@)(@@)(@@) | 3085 - (@)(@@) سمعت يحيى يقول أسباط ليس به بأس وكان يخطىء عن سفيان(@)(@@)(@@)(@@) | 3086 - (@)(@@) سمعت يحيى يقول أبو شيبة روى عنه محمد بن فضيل وهو مكي(@)(@@)(@@)(@@) | 3087 - (@)(@@) سمعت يحيى يقول لم يرو عن أبي الزعراء إلا سلمة بن كهيل(@)(@@)(@@)(@@) | 3088 - (@)(@@) سمعت يحيى يقول عطاء بن أبي مروان هو أبو المصعب يروي عنه حجاج بن أرطاة ويروي عنه سفيان الثوري ويروى عنه شريك ويروى عنه شعبة(@)(@@)(@@)(@@) | 3089 - (@)(@@) سمعت يحيى يقول يروى أنه جعل تسعة أعشار الرزق في التجارة وعشر في السايبا يعني الحيوان(@)(@@)(@@)(@@) | 3090 - (@)(@@) سمعت يحيى يقول وقلت له الأسباط يروي عن الشيباني عن حماد عن إبراهيم قال سمعت بن عباس فقال هكذا كان يقول أسباط وهو خطأ وقد كان 
ms211	 أسباط يروي حديثا يخطي فيه كان يروي عن الشيباني عن بكير بن الأخنس عن سعيد بن المسيب قال سمعت عمر بن الخطاب وهو أيضا خطأ لم يسمع من عمر شيئا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3091 - (@)(@@) سمعت يحيى يقول قد حدث وكيع عن سفيان حدث به مرة بن بشير وحدث به مرة عن أبيه ولا أظنه الا عن أبيه حدث الفتنة من قابلها اجتيح(@)(@@)(@@)(@@) | 3092 - (@)(@@) سمعت يحيى يقول في حديث المسعودي عن حبيب عن عبدة عن أبي الدرداء قال يحيى عبدة بن أبي لبابة(@)(@@)(@@)(@@) | 3093 - (@)(@@) سمعت يحيى يقول في حديث المسعودي لا نستنسئوا الشيطان قال يحيى يقولون إذا أردت صدقة الساعة فلا تؤخرها إلى غد هكذا قال يحيى لا تستنسئوا(@)(@@)(@@)(@@) | 3094 - (@)(@@) سمعت يحيى يقول في حديث المسعودي عن أبي عتبة قال يحيى يقال إن أبا عتبة هذا مولى مروان(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3095 - (@)(@@) سمعت يحيى يقول عبد الله بن حبيب بن أبي ثابت قد روى عنه وقد روى عن أخيه عبيد الله بن حبيب بن أبي ثابت قلت ليحيى من روى عن عبيد الله بن حبيب بن أبي ثابت قال وكيع(@)(@@)(@@)(@@) | 3096 - (@)(@@) سمعت يحيى يقول قران بن تمام ثقة وكان صاحب دواب(@)(@@)(@@)(@@) | 3097 - (@)(@@) سمعت يحيى يقول سفيان بن عيينة يقول قال علي ياحبذا الكوفة أرض سواء معروفة تعرفها جمالنا المعلوفة قلت ليحيى ما يعني بقوله أرض سواء قال مستوية(@)(@@)(@@)(@@) | 3098 - (@)(@@) سمعت يحيى يقول القاسم بن عبد الرحمن من ولد عبد الله بن مسعود(@)(@@)(@@)(@@) | 3099 - (@)(@@) والقاسم بن عبد الرحمن الشامي مولى معاوية ويقال مولى يزيد بن معاوية ليس في الدنيا القاسم بن عبد الرحمن شامي غير هذا(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3100 - (@)(@@) سمعت يحيى يقول قد روى جرير عن نهشل الضبي وقد روى المسعودي عن أبي نهشل وقد روى سفيان عن نهشل الضبي أيضا وهو الذي يروي عنه جرير قال يحيى وأبو نهشل هذا يروي عنه المسعودي وهذا نهشل رجل آخر(@)(@@)(@@)(@@) | 3101 - (@)(@@) سمعت يحيى يقول في حديث الأعمش عن عمرو بن مرة عن سالم بن أبي الجعد عن أبي ثور الحدي هكذا قال 
ms212	 يحيى لم يقل أبو ثور الحداني روى حديث أبي ثور هذا جرير الرازي(@)(@@)(@@)(@@) | 3102 - (@)(@@) سمعت يحيى يقول إبراهيم بن ميمون مولى لآل سمرة يروي عنه وكيع وأبو أحمد الزبيري وهو ثقة(@)(@@)(@@)(@@) | 3103 - (@)(@@) سمعت يحيى يقول سعيد بن يزيد يروي عنه وكيع وهو كوفي ثقة(@)(@@)(@@)(@@) | 3104 - (@)(@@) سمعت يحيى يقول أبو نعيم وأبو أحمد الزبيري يرويان عن رجل يقال له قبيس وهو كوفي ثقة(@)(@@)(@@)(@@) | 3105 - (@)(@@) سمعت يحيى يقول مسلمة بن نوفل يروي عنه عيسى بن يونس ووكيع وهو ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3106 - (@)(@@) سمعت يحيى يقول أبو المنهال الطائي اسمه نصر بن أوس يروي عنه وكيع وهو ثقة(@)(@@)(@@)(@@) | 3107 - (@)(@@) حدثنا يحيى قال حدثنا عبدة عن محمد بن إسحاق عن عبد الله بن مكنف عن أنس بن مالك قال قال رسول الله صلى الله عليه وسلم أحد جبل يحبنا ونحبه وهو على ترعة من ترع الجنة وعير على ترعة من ترع النار(@)(@@)(@@)(@@) | 3108 - (@)(@@) سمعت يحيى يقول قد روى إسحاق بن سليمان الرازي عن عبد الله بن جابر هو كوفي روى عنه سفيان الثوري أيضا(@)(@@)(@@)(@@) | 3109 - (@)(@@) سألت يحيى قلت له ما ترى في رجل فرط في العلم حتى كبر فلم يقو على الحديث يكتب جامع سفيان بيديه ويعمل بما فيه قال كان سفيان إماما يقتدى به قلت فمن كرهه قال ليس يكره جامع سفيان إلا أحمق(@)(@@)(@@)(@@) | 3110 - (@)(@@) سمعت يحيى يقول منصور بن حيان كوفي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3111 - (@)(@@) سمعت يحيى يقول أبو ترة الكندي هو سلمة بن معاوية بن وهب بن قيس بن حجر(@)(@@)(@@)(@@) | 3112 - (@)(@@) سمعت يحيى يقول حدث وكيع بحديث سمعان بن مشيج حدث به عبد الرزاق والقاضي يعني هشام بن يوسف فقال وكيع سمعان بن مشيج وقد أخطأ فيه وكيع إنما هو سمعان بن مشنج قال هشام سمعان بن مشنج العامري(@)(@@)(@@)(@@) | 3113 - (@)(@@) سمعت يحيى يقول قد روى مغيرة عن الهيثم بن قطن قال يحيى والهيثم بن بدر يروى عنه مغيرة أيضا وكان الهيثم بن بدر على شرط الري(@)(@@)(@@)(@@) | 3114 - (@)(@@) سمعت يحيى يقول قد روى عبد الملك بن عمير 
ms213	 عن شبيب أبي روح(@)(@@)(@@)(@@) | 3115 - (@)(@@) سمعت يحيى يقول محمد بن عبد الرحمن مولى آل طلحة كوفي وهو محمد بن عبد الرحمن بن عبيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3116 - (@)(@@) سمعت يحيى يقول الحديث الذي يروي إسماعيل بن أبي خالد عن أبي الأشهب قد سمعه بن إدريس من أبي الأشهب نفسه قيل ليحيى أبو الأشهب كوفي قال نعم(@)(@@)(@@)(@@) | 3117 - (@)(@@) سمعت يحيى يقول قد روى سعد بن أوس الكوفي قال حدثنا عمران بن حصين وعمران بن حصين هذا ضبي(@)(@@)(@@)(@@) | 3118 - (@)(@@) سمعت يحيى يقول عامر بن مسعود الذي يروي الصوم في الشتاء ليس له صحبة كان مع بن الزبير وقد روى سفيان عن إبراهيم بن عامر هذا وقد روى جرير بن عبد الحميد أيضا عن إبراهيم بن عامر حديثين وفي حديث جرير سألت عنه فقال هو إبراهيم بن عامر(@)(@@)(@@)(@@) | 3119 - (@)(@@) سمعت يحيى يقول في حديث عبد الرزاق عن سفيان عن قابوس عن أبي ظبيان عن علي قال أتاه رجلان وقعا على امرأة في طهر واحد قال يحيى هذا أبو ظبيان يعني أبا قابوس واسمه حصين بن جندب(@)(@@)(@@)(@@) | 3120 - (@)(@@) سمعت يحيى يقول وأبو ظبيان صاحب الأعمش وليس في الدنيا أبو ظبيان إلا هذا إلا رجل يروي عنه مسعر في حديث أبي ظبيان أن عمر فقال له ما مالك هذا أبو ظبيان آخر قلت ليحيى من هو قال لا أدري(@)(@@)(@@)(@@) | 3121 - (@)(@@) سمعت يحيى يقول أبو حذيفة الذي يروي عنه أبو إسحاق هو سلمة بن صهيبة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3122 - (@)(@@) سمعت يحيى بن معين يقول أبو حمزة هو ختن أبي عبد الرحمن السلمي يروى عن أبي حمزة هذا إسماعيل بن أبي خالد(@)(@@)(@@)(@@) | 3123 - (@)(@@) سمعت يحيى يقول المقدام بن شريح هو المقدام بن شريح بن هانئ بن يزيد(@)(@@)(@@)(@@) | 3124 - (@)(@@) قال يحيى وشريح بن أرطاة وشريح بن هانئ وشريح بن النعمان وشريح بن الحارث وشريح القاضي قال يحيى هؤلاء كلهم كوفيون(@)(@@)(@@)(@@) | 3125 - (@)(@@) سمعت يحيى يقول أبو حصين عن أبي عامر الكاهلي سمع من علي(@)(@@)(@@)(@@) | 3126 - (@)(@@) سمعت يحيى يقول الربيع بن سحيم كوفي يروى عنه أبو بكر 
ms214	 بن عياش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3127 - (@)(@@) سمعت يحيى يقول سمعت كتاب عبد كل شيء عنده من حديث هشام بن عروة وكان يروي عنه ثلاثمائة حديث سمعتها كلها إلا حديثا يمتنع به(@)(@@)(@@)(@@) | 3128 - (@)(@@) سمعت يحيى يقول قد روى سفيان عن يعلى بن النعمان(@)(@@)(@@)(@@) | 3129 - (@)(@@) سمعت يحيى يقول حشرج ليس به بأس(@)(@@)(@@)(@@) | 3130 - (@)(@@) أبو إسحاق الحميسي ليس بشيء(@)(@@)(@@)(@@) | 3131 - (@)(@@) حصين بن نمير ليس بشيء(@)(@@)(@@)(@@) | 3132 - (@)(@@) سمعت يحيى يقول قد روى عن أبي بشر الحلبي قران وعبيد الله بن موسى(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3133 - (@)(@@) سمعت يحيى يقول داود الأودي عن أبيه أبوه قد رأى علي بن أبي طالب يروونه من حديث بن إدريس وهو جد عبد الله بن إدريس(@)(@@)(@@)(@@) | 3134 - (@)(@@) قال يحيى أبو إسحاق عن يزيد بن زيد قال يحيى هو السوائي يعني يزيد بن زيد(@)(@@)(@@)(@@) | 3135 - (@)(@@) سمعت يحيى يقول دثار هو دثار بن شبيب القطان(@)(@@)(@@)(@@) | 3136 - (@)(@@) سمعت يحيى يقول الحديث الذي يروي عن سلم بن عبد الرحمن كره الشكال في الخيل يخطىء فيه شعبة يقول عن عبد الله بن يزيد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3137 - (@)(@@) سمعت يحيى يقول كنا نقرأ حديث المسعودي مع أبي نعيم وكنا نقرأ مع أبي فلان أيضا كتابه وكنا نقرأ مع محمد بن عبيد كتابه(@)(@@)(@@)(@@) | 3138 - (@)(@@) حدثنا يحيى قال حدثنا حسين الأشقر قال حدثنا حسن بن صالح في قوله ولا على الذين إذا ما أتوك لتحملهم قال استحملوه النعال(@)(@@)(@@)(@@) | 3139 - (@)(@@) سمعت يحيى يقول قد روى بن شبرمة عن الحسن وابن سيرين(@)(@@)(@@)(@@) | 3140 - (@)(@@) سمعت يحيى يقول قال بن كناسة ... في انقباض وحشمة فإذا ... صادفت أهل الوفاء والكرم ... ... أرسلت نفسي على سجيتها ... وقلت ما شئت غير محتشم ...(@)(@@)(@@)(@@) | 3141 - (@)(@@) سمعت يحيى يقول أبو بكر بن عياش عن بن صالح مولى عمرو بن حريث روى عنه وعن أبيه(@)(@@)(@@)(@@) | 3142 - (@)(@@) سمعت يحيى يقول مجالد وحجاج لا يحتج بحديثهما(@)(@@)(@@)(@@) | 3143 - (@)(@@) وعطاء بن السائب لا يحتج بحديثه(@)(@@)(@@)(@@) | 3144 - (@)(@@) ولا يحتج بحديث يزيد بن أبي زياد(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3145 - (@)(@@) سمعت يحيى يقول بن أبي رافع الذي يحدث عنه حبان بن علي ليس حديثه بشيء(@)(@@)(@@)(@@) | 3146 - (@)(@@) سألت يحيى بشير 
ms215	 بن المهاجر رأى جرير بن عبد الله البجلي قال نعم قال رأيت عليه مطرف خز(@)(@@)(@@)(@@) | 3147 - (@)(@@) حدثنا يحيى قال حدثنا بن أبي غنيمة عن حفص بن عمر عن أبي الزبير الدرمكي قال قال حوشب بن عقيل لجبلة بن سحيم يا أبا سويره(@)(@@)(@@)(@@) | 3148 - (@)(@@) سمعت يحيى يقول كثير بن أبي كثير يروي عنه إسحاق الأزرق(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3149 - (@)(@@) سمعت يحيى يقول قدامة هذا الذي يروي عنه مروان الفزاري هو بن عم إبراهيم بن حميد الرؤاسي(@)(@@)(@@)(@@) | 3150 - (@)(@@) قال كان عبد الرحمن بن عبد الله بن عتبة بن مسعود قال ... سأفرش نفس الذي خولت ... وأوثر نفسي على الوارث ... ... أبادر إنفاق مستحصد ... بمالي أو عبث العابث ...(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3151 - (@)(@@) حدثنا يحيى قال حدثنا جرير عن مغيرة قال كان زياد بن حدير يبيت معه ديك(@)(@@)(@@)(@@) | 3152 - (@)(@@) وبه عن مغيرة قال كان إبراهيم إذا طلبه إنسان لا يحب أن يلقاه خرجت الجارية فقالت اطلبوه في المسجد(@)(@@)(@@)(@@) | 3153 - (@)(@@) سمعت يحيى يقول قد روى أبو معاوية عن مسحاج وقد سمع منه أيضا جرير وروى أيضا المغيرة عن مسحاج قلت ليحيى مغيرة عن مسحاج قال نعم(@)(@@)(@@)(@@) | 3154 - (@)(@@) حدثنا يحيى قال حدثني منجاب قال قال رجل لشريك كيف تجدك يا أبا عبد الله قال أجدني شاكيا غير شاك لله عز وجل(@)(@@)(@@)(@@) | 3155 - (@)(@@) سمعت يحيى يقول طلحة الأعلم كوفي يروي عنه سفيان الثوري والفزاري(@)(@@)(@@)(@@) | 3156 - (@)(@@) حدثنا يحيى قال حدثنا بن إدريس عن الشيباني عن عبد الملك بن إياس قال قلنا لإبراهيم من نسأل بعدك قال حماد(@)(@@)(@@)(@@) | 3157 - (@)(@@) قال يحيى عبد الملك بن إياس شيباني(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3158 - (@)(@@) حدثنا يحيى قال حدثنا بن إدريس عن أبيه قال سمعت بن شبرمة يقول ما أحد أمن علي بعلم من حماد(@)(@@)(@@)(@@) | 3159 - (@)(@@) سمعت يحيى يقول عمران بن زيد التغلبي ليس به بأس(@)(@@)(@@)(@@) | 3160 - (@)(@@) سمعت يحيى يقول الذي يروي عنه محمد بن بشر ومحمد بن عبيد محرز يقال له أبو رجاء وهو شامي قلت ليحيى يروى عنه عن الحسن قال قد سمع منه(@)(@@)(@@)(@@) | 3161 - (@)(@@) قال يحيى أبو البلاد يحيى الغطفاني(@)(@@)(@@)(@@) | 3162 - (@)(@@) سمعت 
ms216	 يحيى يقول قد روى زهير بن معاوية عن يحيى بن قيس وهو أبو صفوان(@)(@@)(@@)(@@) | 3163 - (@)(@@) حدثنا يحيى قال حدثنا عبيد بن أبي قرة قال سمعت يحيى بن ضريس يقول شهدت سفيان وأتاه رجل فقال ما تنقم على أبي حنيفة قال وماله قال سمعته يقول آخذ بكتاب الله فما لم أجد فبسنة رسول الله صلى الله عليه وسلم فإن لم أجد في كتاب الله ولا سنة آخذ بقول أصحابه آخذ بقول من شئت منهم وأدع قول من شئت ولاأخرج من قولهم إلى قول غيرهم فإذا ما انتهى الأمر أو جاء الأمر إلى إبراهيم والشعبي وابن سيرين والحسن وعطاء وسعيد بن المسيب وعدد رجالا فقوم اجتهدوا فأجتهد كما اجتهدوا قال فسكت سفيان طويلا ثم قال كلمات برأيه ما بقي أحد في المجلس إلا كتب نسمع التشديد من الحديث فنخافه ونسمع اللين فنرجوه لا نحاسب الأحياء ولا نقضي على الأموات نسلم ما سمعنا ونكل ما لم نعلم إلى عالمه ونتهم رأينا لرأيهم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3164 - (@)(@@) حدثنا يحيى قال حدثنا بن إدريس قال سمعت زكريا بن أبي زائدة قال كنت أرى الشعبي يمر بأبي صالح صاحب التفسير فيأخذ بأذنه فيقول ويحك كيف تفسر القرآن وأنت لا تحسن تقرأ(@)(@@)(@@)(@@) | 3165 - (@)(@@) سمعت يحيى يقول كان عبد الله بن محمد بن عقيل ينزل الحيرة(@)(@@)(@@)(@@) | 3166 - (@)(@@) سمعت يحيى يقول صالح بن حيان ضعيف الحديث(@)(@@)(@@)(@@) | 3167 - (@)(@@) سمعت يحيى يقول أبو الأحوص أحب إلي من أبي بكر بن عياش(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3168 - (@)(@@) سمعت يحيى يقول زهير وزائدة وذكرهما قلت له زهير أثبت من زائدة قال جميعا سواء(@)(@@)(@@)(@@) | 3169 - (@)(@@) سمعت يحيى يقول إسرائيل أثبت حديثا من شريك(@)(@@)(@@)(@@) | 3170 - (@)(@@) سمعت يحيى يقول كان القطان يعني يحيى لا يحدث عن إسرائيل وشريك(@)(@@)(@@)(@@) | 3171 - (@)(@@) سئل يحيى عن إسرائيل فقال قال يحيى بن آدم كنا نكتب عنده من حفظه قال يحيى كان إسرائيل لا يحفظ ثم حفظ بعد(@)(@@)(@@)(@@) | 3172 - (@)(@@) حدثنا يحيى حدثنا بن إدريس عن أشعث بن سوار عن علي بن مدرك الوهبيلي قال قال عبد الله إني لأعرف 
ms217	 سمت معاذ في أدد والنخع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3173 - (@)(@@) حدثنا يحيى عن يحيى بن آدم قال حدثنا قطبة عن الأعمش عن أبي وائل قال كان شريح يقل غشيان عبد الله قال فقلت له أو فقيل له مم ترى ذاك قال الإستغناء(@)(@@)(@@)(@@) | 3174 - (@)(@@) حدثنا يحيى قال حدثنا يحيى بن سعيد قال حدثنا سفيان عن سليمان عن عمارة عن حريث بن ظهير قال جاء نعي عبد الله إلى أبي الدرداء فقال ما ترك بعده مثله(@)(@@)(@@)(@@) | 3175 - (@)(@@) سمعت يحيى يقول حدث الأعمش عن أبي صالح عن أبي هريرة قال قال رسول الله صلى الله عليه وسلم إن للصلاة أولا وآخرا رواه الناس كلهم عن الأعمش عن مجاهد مرسلا(@)(@@)(@@)(@@) | 3176 - (@)(@@) قال يحيى أبو الوداك جبر بن نوف(@)(@@)(@@)(@@) | 3177 - (@)(@@) سألت يحيى عن حماد بن أبي أيوب فقال شيخ كوفي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3178 - (@)(@@) حدثنا يحيى قال حدثنا محمد بن كثير الصنعاني عن أبي إسحاق الفزاري قال كتب إلى سفيان الثوري إياك والحديث كأنه يخوفه سهره ما يرفع الناس إليه في الأعين(@)(@@)(@@)(@@) | 3179 - (@)(@@) سمعت يحيى يقول حدثنا أبو قطن قال حدثنا يونس عن أبي البختري عن بن عمر قال من اتقى ربه ووصل رحمه نسيء له في عمره وثرا ماله وأحبه أهله قلت له سمعته منه أو سمعته من أبي البختري قال نعم قال يحيى اسم بن البختري هذا مغراء وليس هو صاحب علي(@)(@@)(@@)(@@) | 3180 - (@)(@@) حدثنا يحيى قال حدثنا حجاج قال قال شعبة لم يسمع أبو عبد الرحمن من عثمان ولا من عبد الله ولكن قد سمع من علي(@)(@@)(@@)(@@) | 3181 - (@)(@@) حدثنا يحيى قال حدثنا جرير عن مغيرة قال قال حماد لقيت عطاء وطاوسا ومجاهد فصبيانكم أعلم منهم لا بل صبيان صبيانكم قال مغيرة هذا بغي منه(@)(@@)(@@)(@@) | 3182 - (@)(@@) قال يحيى أبو عون محمد بن عبيد الله الثقفي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3183 - (@)(@@) سمعت يحيى يقول أبو رجاء الذي يروي عنه يعلى بن عبيد هو محرز وهو شامي(@)(@@)(@@)(@@) | 3184 - (@)(@@) سمعت يحيى يقول عمران بن سليمان كوفي ثقة يروي عنه حفص وغير واحد وهو عمران القبي يعني القبة والجونة 
ms218	 التي بالكوفة بحضرة المسجد الجامع(@)(@@)(@@)(@@) | 3185 - (@)(@@) سمعت يحيى يقول أبو سعيد التيمي هو أبو سعيد عقيصا(@)(@@)(@@)(@@) | 3186 - (@)(@@) سمعت يحيى يقول ما كان في كتاب أبي إسحاق الفزاري عن أبي حماد فهو أبو حماد الحنفي وما كان في كتابه عن أبي إسماعيل فهو حاتم بن إسماعيل المزني(@)(@@)(@@)(@@) | 3187 - (@)(@@) سمعت يحيى يقول الذي يروي عنه عبد الرحيم يقول عن أبي أيوب هو عبد الرحمن بن زياد الإفريقي(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3188 - (@)(@@) سمعت يحيى يقول إبراهيم بن جرير بن عبد الله البجلي لم يسمع من أبيه شيئا(@)(@@)(@@)(@@) | 3189 - (@)(@@) سمعت يحيى يقول وسئل عن حسن بن ثابت فقال ثقة وهو كوفي وقد رأيته يقال له بن الروزجان قلت له عمن كان يحدث قال عن الأعمش وغيره(@)(@@)(@@)(@@) | 3190 - (@)(@@) سمعت يحيى يقول قال أبو عبيد الله لشريك القاضي أردت أن أسمع منك أحاديث فقال قد اختلطت علي أحاديثي وما أدري كيف هي فألح عليه أبو عبيد الله فقال حدثنا بما تحفظ ودع ما لا تحفظ فقال أخاف أن تجرح أحاديثي ويضرب بها وجهي(@)(@@)(@@)(@@) | 3191 - (@)(@@) سمعت يحيى يقول حدثني محمد بن فضيل عن محمد بن عمرو عن أبي سلمة عن أبي هريرة قال من قام رمضان إيمانا وليس بشيء(@)(@@)(@@)(@@) | 3192 - (@)(@@) حدثنا العباس حدثنا يحيى حدثنا أبو خالد الأحمر عن إسماعيل قال سألت الشعبي فقال والله لوددت أني لم أسأل عن شيء قط وما أبالي عما أعلم أو عما لا أعلم(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3193 - (@)(@@) حدثنا العباس حدثنا يحيى حدثنا بن مهدي عن سفيان عن عمرو بن ميمون عن أبيه قال مات سعيد بن جبير وما على الأرض أحد إلا ويحتاج إلى علمه(@)(@@)(@@)(@@) | 3194 - (@)(@@) سمعت يحيى يقول حديث سفيان عن إسماعيل عن عمرو بن دينار عن بن عباس لو أن رجلا تزوج على سواك لكان ذلك مهرا حدث به أبو حفص الأدبار عن سفيان عن إسماعيل بن مسلم عن عمرو بن دينار قيل ليحيى إن إنسانا حدث به عن وكيع عن سفيان عن إسماعيل بن أمية فقال ليس هذا بشيء إنما هو عن سفيان 
ms219	 عن إسماعيل بن مسلم(@)(@@)(@@)(@@) | 3195 - (@)(@@) حدثنا يحيى حدثنا جرير عن مغيرة قال قالت أم سنان بن أبي حارثة إذا أنا مت فشقوا بطني فإن فيه سيد غطفان قال قال فماتت فشقوا بطنها فاستخرجوا سنان فعاش وساد حتى كان له مال وتبع(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3196 - (@)(@@) سمعت يحيى يقول الصلت بن قويد أبو أحمر حدث عنه عمار بن محمد الثوري وعلي بن ثابت قلت ليحيى إن الصلت يحدث عن أبي هريرة لقيه قال نعم(@)(@@)(@@)(@@) | 3197 - (@)(@@) حدثنا يحيى حدثنا عبدة قال حدثنا هشام بن عروة عن عبد الله بن عروة عن عبد الله بن الزبير عن الزبير قال جمع لي رسول الله صلى الله عليه وسلم أبويه يوم قريظة فقال ارم فداك أبي وأمي قال يحيى هكذا قال عبدة عن هشام بن عروة عن عبد الله بن عروة عن عبد الله بن الزبير عن الزبير وخالف عبدة فيه الناس(@)(@@)(@@)(@@) | 3198 - (@)(@@) حدثنا يحيى قال حدثنا وكيع عن سفيان عن أبي حمزة القرشي عن أبيه عن بن عباس أنه أحرم من الشام في شتاء شديد قال يحيى وغير وكيع يقول عن حمزة القرشي لم يقل عن أبي حمزة وكان يحيى إلى من قال حمزة القرشي أميل منه إلى حديث وكيع عن أبي حمزة وقال يحيى حمزة هو الصواب(@)(@@) PageV00P000(@)(@@)(@@)(@@) | (الأول من البصريين)(@)(@@)(@@)(@@) | 3199 - (@)(@@) حدثنا يحيى قال حدثنا عبد الله بن إدريس عن شعبة عن أبي رجاء قال سألت الحسن عن أهل الكوفة وأهل البصرة قال كان يبدأ بأهل الكوفة(@)(@@)(@@)(@@) | 3200 - (@)(@@) سمعت يحيى يقول يونس بن خباب قد سمع منه عباد بن عباد وهو يتناول عثمان يقول عثمان قتل ابنتي رسول الله صلى الله عليه وسلم ولم أسمع هذا أنا من عباد(@)(@@)(@@)(@@) | 3201 - (@)(@@) حدثنا يحيى قال حدثنا أبو أسامة عن الأعمش قال كان إبراهيم يقعد مع العرفاء والمناكب فقال له خيثمة تقعد مع هؤلاء فقال نعم يتحدثون بما شاءوا ونتحدث بما نشاء(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3202 - (@)(@@) حدثنا يحيى قال حدثنا عبد السلام بن حرب عن لبطة عن أبيه قال رأيت الحسين بن 
ms220	 علي خارجا في العشر من مكة(@)(@@)(@@)(@@) | 3203 - (@)(@@) حدثنا يحيى قال حدثنا سفيان بن عيينة عن لبطة بن الفرزدق قال سفيان كان خالد الحذاء يحدث به عن لبطة ثم لقيت أنا لبطة فحدثني به(@)(@@)(@@)(@@) | 3204 - (@)(@@) حدثنا يحيى قال حدثنا جرير عن إسماعيل بن أبي خالد قال كان الشعبي وإبراهيم وأبو الضحى يجتمعون في المسجد فيتذاكرون الحديث فإذا جاءهم شيء ليس عندهم رواية رموا إبراهيم بأبصارهم(@)(@@)(@@)(@@) | 3205 - (@)(@@) حدثنا يحيى قال حدثنا عباد بن العوام حدثنا شريك بن عبد الله بن سنان قال يحيى وهو شريك بن عبد الله القاضي(@)(@@)(@@)(@@) | 3206 - (@)(@@) حدثنا يحيى قال حدثنا عقبة بن خالد قال أنبأنا عبد الله بن نافع أخبرني أبي أن بن عمر كان يقول الشفق الحمرة فإذا ذهبت الحمرة فقد غاب الشفق قيل ليحيى سمع عقبة من عبد الله بن نافع هذا قال نعم وما تنكر(@)(@@)(@@)(@@) | 3207 - (@)(@@) سمعت يحيى يقول إسماعيل بن أبي خالد أبو عبد الله(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3208 - (@)(@@) قلت ليحيى سعيد بن جبير لقي أبا هريرة قال قد روى هكذا عنه ولم يصح لي أنه سمع من أبي هريرة(@)(@@)(@@)(@@) | 3209 - (@)(@@) سمعت يحيى يقول وسئل عن الفقاع فقال ما يكرهه من الشيوخ إلا شيخ لا عقل له(@)(@@)(@@)(@@) | 3210 - (@)(@@) سمعت يحيى يقول سليم بن الأسود كوفي ثقة وهو أبو الأشعث وقد روى عنه إبراهيم النخعي(@)(@@)(@@)(@@) | 3211 - (@)(@@) حدثنا يحيى قال حدثنا هشيم عن يزيد بن أبي زياد قال حدثنا أبو جحيفة عن عبد الله بن مسعود قال كان يقول إذا رفع رأسه من الركوع قلت ليحيى من أبو جحيفة هذا قال وهب السوائي وهو من أصحاب النبي صلى الله عليه وسلم ولكنه روى عن بن مسعود(@)(@@)(@@)(@@) | 3212 - (@)(@@) سمعت يحيى يقول حسام بن مصك ليس حديثه بشيء(@)(@@)(@@)(@@) | 3213 - (@)(@@) سمعت يحيى يقول زكريا بن حكيم الذي يقال له الحبطي ليس بشيء(@)(@@)(@@)(@@) | 3214 - (@)(@@) سمعت يحيى يقول حوشب بن عقيل ثقة وكان يكنى أبا دحية(@)(@@)(@@)(@@) | 3215 - (@)(@@) سمعت يحيى يقول جهير بن يزيد ثقة(@)(@@) PageV00P000(@)(@@)(@@)(@@) | 3216 - (@)(@@) سمعت يحيى يقول في حديث سفيان وشعبة إذا اختلفا 