ms41	 الناس ، لما تقاذفوا % % بكل غضوض تملأ الفم عاقر % 3(@)(@@) % جميعا ، فأما شاعرانا فأمسكا % % وآب إلى أكفائنا كل شاعر % PageV01P142 البحر : بسيط تام 1(@)(@@) % هل تعرف الدار ، قد محت معارفها % % كأنما قد براها بعدنا باري % % 2(@)(@@) % مما تعاورها الريحان آونة % طورا ن وطورا تعفيها بأمطار % 3(@)(@@) % ولم أكن لنساء الحي قد شمطت % مني المفارق أحيانا بزوار % 4(@)(@@) % وما بها غير أدماث وأبنية ، % وخالدات بها ضبح من النار % 5(@)(@@) % ولو إلى ابن خديش كان مرحلنا % % وابني دجاجة قوم كان أخبار % 6(@)(@@) % وابن الحزنبل عمرو في ركيته % وماجد العود من أولاد نجار % 7(@)(@@) % لكن إلى جرثم المقاء إذا ولدت % عبدا لعلج من الحضنين أكار % 8(@)(@@) % إني لذاكر زيد غير مادحه % بالمرج ، يوم نزلنا مرج حمار % 9(@)(@@) % ألحقت زيدا غداة المرج بابنته % إن اللئيم على مقداره جاري % % PageV01P143 البحر : وافر تام 1(@)(@@) % ألا أبلغ أبا الدلماء عني % % بأن سنان شاعركم قصير % 2(@)(@@) % فإن يطعن فليس بذي غناء % % وإن يطعن فطعنته يسير % 3(@)(@@) % متى ما يلقني ومعي سلاحي % % يخر على القفا وله نخير % PageV01P144 البحر : وافر تام 1(@)(@@) % عفا ممن عهدت به حفير % فأجبال السيالي ، فالعوير % 2(@)(@@) % فشامات فذات الرمث قفر % عفاها ، بعدنا قطر ومور % 3(@)(@@) % ملح القطر منسكب العزالى % % إذا ما قلت أقلع يستحير % 4(@)(@@) % كأن المشرفية في ذراه % ونيران الحجيج لها سعير % 5(@)(@@) % بكل قرارة منها وفج % أضاة ماؤها ضرر يمور % 6(@)(@@) % تنقلت الديار بها ، فحلت % بحزة حيث ينتسع البعير % 7(@)(@@) % وأقفرت الفراشة والحبيا % % وأقفر بعد فاطمة الشقير % 8(@)(@@) % نأين بنا ، غداة دنون منهم % وهن إليك بالجولان ، صور % % 9(@)(@@) % كرهن ذباب دومة ، إذا عفاها % % غداة تثار للموتى القبور % 10(@)(@@) % فليت الراسمات بلغن هندا % فتعلم ما يكن لها الضمير % PageV01P145 11(@)(@@) % كأن غمامة غراء باتت % تكشف عن محاسنها الخدور % 12(@)(@@) % وقد بلغ المطي ، وهن خوص % بلادا ما تحل بها قذور % 13(@)(@@) % حلفت بمن تساق له الهدايا % % ومن حلت بكعبته النذور % 14(@)(@@) % لقد ولدت جذيمة من قريش % ولكني أهاب ، وأرتجيكم % 15(@)(@@) % وأكرمها مواطن حين تبلى % % ضرائبها وتختصب النحور % 16 
ms42	(@)(@@) % وأسرعها إلى الأعداء سيرأ % % 17(@)(@@) % به ترمي أعاديها قريش % إذا ما نابها أمر كبير % 18(@)(@@) % له يومان : يوم قراع كبش % ويوم يستظل به مطير % 19(@)(@@) % بكفيه الأعنة ، لا سؤوم % قتال الأعجمي ، ولا ضجور % 20(@)(@@) % قتلت الروم ، حتى شذ منها % % عصائب ، ما تحرزها القصور % PageV01P146 21(@)(@@) % فلو كان الحروب حروب عاد % لقام على مواطنها صبور % 22(@)(@@) % وقد علمت أمية أن ضعني % % إليها ، والعداة لها هرير % 23(@)(@@) % وأني ما حييت على هواها % % وأني بالمغيب لها نصور % 24(@)(@@) % وما يبقى على الأيام ، إلا % بنات الدهر والكلم العقور % 25(@)(@@) % فمن يك قاطعا قرنا ، فإني % % لفضل بني أبي العاصي شكور % 26(@)(@@) % علقت بجبلكم ، فشددتموه % فلا واه قواه ولا قصير % 27(@)(@@) % إمام الناس والخلفاء منهم % وفتيان تسد بها الثغور % 28(@)(@@) % ومظلمة تضيق بها ذراعي % % ويتركني بها الحدب النصور % 29(@)(@@) % كفونيها ، ولم يتواكلوها % % بخلق ، لا ألف ولا عثور % 30(@)(@@) % ولولا أنتم كرهت معد % عضاضي ، حين لاح بي القتير % PageV01P147 31(@)(@@) % ولكني أهاب ، وأترجيكم % % ويأتيني عن الأسد الزئير % 32(@)(@@) % وأنتم حين حارب كل أفق % وحين غلت بما فيها القدور % 33(@)(@@) % غشمتم بالسيوف الصيد ، حتى % % خبا منها القباقب والهدير % 34(@)(@@) % إذا ما حية منكم توارى % % تنمر حية منكم ذكير % 35(@)(@@) % وأعطيتم على الأعداء نصرا % فأبصرتم به والناس عور % 36(@)(@@) % وكانت ظلمة فكشفتموها % % وكان لها بأيديكم سفور % 37(@)(@@) % فلو أن الشهور بكين يوما % إذا لبكت لفقدكم الشهور % 38(@)(@@) % ونعم الحي في اللزبات عبس % إذا ما الطلح أرجفه الدبور % 39(@)(@@) % مساميح الشتاء إذا اجرهدت % وعزت عند مقسمها الجزور % 40(@)(@@) % بنو عبس فوارس كل يوم % % يكاد الهم خشيته يطير % PageV01P148 41(@)(@@) % وفاة تنزل الأضياف منهم % منازل ما يحل بها الضرير % 42(@)(@@) % وهم عطفوا على النعمان لما % % أتاه بتاج ذي ملك بشير % 43(@)(@@) % فجازوه بنعماه عليهم % غداة له الخورنق والسدير % 44(@)(@@) % كلا أبويك من كعب وعبس % بحور ما توازنها بحور % 45(@)(@@) % فمن يك في أوائله مختا % فإنك يا وليد بهم فخور % 46(@)(@@) % وتأوي لابن زنباع إذا ما % % تراخى الريف كاس له عقير % PageV01P149 البحر : بسيط تام 1 
ms43	(@)(@@) % إني أظن نزارا سوف تجمعها % % بعد التفرق ، حرب شبها زفر % 2(@)(@@) % صلت الجبين ، رشيد الأمر ، تعرفه % إذا تكشف عن عرنينه القتر % 3(@)(@@) % سارى بهم أرضهم ليلا ، فصبحهم % بوقعة ، لم تقدم قبلها النذر % 4(@)(@@) % وهم على آلة ، قد بينت لهم % أمرا ، علانية ، غير الذي ائتمروا % % 5(@)(@@) % حتى رأوه ، صباحا ن في ململمة % شهباء ، يبرقن في حافاتها ، البصر % 6(@)(@@) % في عارض من نزار يبرقون ، إذا % % نال الأعادي منهم فيلق ، هبروا % % 7(@)(@@) % سعى بأوتار أقوام ، فأدركها % % لولا أياديه ، ما امتنوا ولا انتصروا % % PageV01P150 البحر : بسيط تام 1(@)(@@) % نعم المجير سماك من بني أسد % بالمرج إذا قتلت جيرانها مضر % 2(@)(@@) % في غير شيء ، أقل الله خيرهم % ما إن لهم دمنة فيهم ولا ثأر % 3(@)(@@) % إن سماكا بنى مجدا لأسرته % حتى الممات ، وفعل الخير مبتدر % 4(@)(@@) % قد كنت أحسبه قينا ، وأنبؤه % فاليوم طير عن أثوابه الشرر % 5(@)(@@) % أبلى بلاء كريم ، لن يزال له % منها بعاقبة مجد ومفتخر % 6(@)(@@) % لم يلهه عن سوام الخير قد علموا % % أمر الضعيف ولا من حلمه البطر % 7(@)(@@) % فإن يكن معشر حانت مصارعهم % منا لهم ، غير ماني منية ، قدر % 8(@)(@@) % فقد نكون كراما ، ما نضام ، وقد % ينمي لنا قبل مرج الصفر الظفر % 9(@)(@@) % والخيل تشتد معقودا قوادمها % % تعدو وتمتحض الأكفال والسرر % 10(@)(@@) % عشية الفيلق الخضراء تحطمهم % ما إن يواجهها سهم ولا حجر % PageV01P151 البحر : طويل 1(@)(@@) % إذا ما نديمي علني ثم علني % % ثلاث زجاجات لهن هدير % 2(@)(@@) % جعلت أجر الذيل مني كأنني % % عليك أمير المؤمنين أمير % PageV01P152 البحر : طويل 1(@)(@@) % بني مسمع أنتم ذؤابة معشر % سيابخة يرمونني نظرا شزرا % 2(@)(@@) % ألستم بني قلع من البحر أصلكم % رأيتكم قعسا وقوتكم التمرا % % 3(@)(@@) % عيون جرى فيها النبيذ ، ولم تكن % لتشرب من لؤم طلاء ولا خمرا % % PageV01P153 البحر : طويل 1(@)(@@) % ألا يال زيد اللات ، ما بال راية % رفعتم عصاها بعدما أدبر الأمر % 2(@)(@@) % لتحموا نساء باديا ثلباتها % % قصاراف هواديها ، وأوساطها عجر % PageV01P154 البحر : طويل 1(@)(@@) % أنفت لبيض يجتليهن ثابت % بدوغان ، يهفو قزها وحريرها % % 2(@)(@@) % إذا أعرضت بيضاء قال لها 
ms44	 اسفري % % وكانت حصانا لا ينال سفورها % % PageV01P155 البحر : طويل 1(@)(@@) % لتبك أبا سمعان أطاطة الضحى % % إلى الكرم مرزام رواء جرارها % % PageV01P156 البحر : بسيط تام 1(@)(@@) % يمشون حول جنابيه وبغلته % زب العثانين مما جمعت هجر % PageV01P157 البحر : متقارب تام 1(@)(@@) % لم أر ملحمة مثلها % % أقف لي أخبرك أخبارها % % 2(@)(@@) % أمر على ثعلب جائع % وأشبع للذئب ، إن زارها % % 3(@)(@@) % تركنا البيوت لأعدائنا % % وعون النساء وأبكارها % % PageV01P158 البحر : بسيط تام 1(@)(@@) % يا كعب لا تهجون العام معترضا % فإن شعرك ، إن لاقيتني ، غرر % 2(@)(@@) % إني أنا الليث في عريسة أشب % فورع السرح ، حتى يفسح البصر % 3(@)(@@) % قد جئت تحمل رأسا ، غير ملتئم % كما تحامل فوق القنة الأمر % 4(@)(@@) % إن اللهازم لن تنفك تابعة % هم الذنابى وشرب التابع الكدر % 5(@)(@@) % قبيلة كشراك النعل دراجة % إن يهبطوا العفو لا يوجد لهم أثر % 6(@)(@@) % محلهم من بني تيم وإخوتهم % حيث يكون من الحمارة الثفر % PageV01P159 البحر : بسيط تام 1(@)(@@) % إني أبيت ، وهم المرء يعهده % من أول الليل ، حتى يفرج السفر % 2(@)(@@) % متى تبلغنا الآفاق يعملة % لمت كما لم بالداوية الأمر % 3(@)(@@) % تعارض الليل ما لاحت كواكبه % كما يعارض مرنى الخلعة اليسر % 4(@)(@@) % إليك سارنا أبا بكر رواحلنا % % 5(@)(@@) % % نروح ثمت نسري ، ثم نبتكر % 6(@)(@@) % فما أتيناك ، حتى خالطت نقبا % أيدي المطي ، وحتى خفت السفر % 7(@)(@@) % حتى أتينا أبا بكر بمدحته % وما تجهمني بعد ولا حصر % 8(@)(@@) % وجهت عنسي إلى حلو شمائله % كأن سنته في المسجد القمر % 9(@)(@@) % فرعان ما منهما إلا أخو ثقة % ما دام في الناس حي ، والفتى عمر % PageV01P160 البحر : وافر تام 1(@)(@@) % لعمر أبيك يا زفر بن عمر و % % لقد نجاك جد بني معاز % 2(@)(@@) % وركضك غير ملتفت إلينا % % كأنك ممسك بجناح بازي % % 3(@)(@@) % فلا وأبي هوازن ما جزعنا % % ولا هم الظعائن بانحياز % 4(@)(@@) % ظعائننا غداة غدت علينا % % فنعمت ساعة السيف الجراز % 5(@)(@@) % ولاقى ابن الحباب لنا حميا % % كفته كل راقية وحاز % 6(@)(@@) % وكان بنا يحل ولا يعانى % % ويرعى كل رمل أو عزار % 7(@)(@@) % فلما أن سمنت وكنت عبدا % نزت 
ms45	 بك يا بن صمعاء النوازي % % 8(@)(@@) % عمدت إلى ربيعة تغتزيها % % بمثل القمل من أهل الحجاز % 9(@)(@@) % فنعم ذوو الحماية كان قومي % % لقومك لو جزى بالقوم جاز % PageV01P161 البحر : طويل 1(@)(@@) % وليلتنا عند الغوير بقطقط % وثانية أخرى بمولى ابن أقعسا % % 2(@)(@@) % نزلنا بلا غس ولا عاتم القرى % % ولا هدنته الخمر عنا ، فينعسا % % 3(@)(@@) % فجاء بها بعد الكرى فارسية % دمشقية ، أحيت عظاما وأنفسا % % 4(@)(@@) % كأني كررت الكأس ، ساعة كرها % % على ناشص شمت حوارا ملبسا % 5(@)(@@) % فأصبح منها الوائلي كأنه % سقيم تمشى داؤه حين أسلسا % % PageV01P162 البحر : طويل 1(@)(@@) % وكنا إذا الجبار أغلق بابه % نسير ونكسو الدارعين القوانسا % % 2(@)(@@) % فمن يأتنا ، أو يعترض لطريقنا % % يجد أثرا بقا وعزا خنابسا % % PageV01P163 البحر : بسيط تام 1(@)(@@) % ما زالت الجدر والأبواب تدفعني % % حتى انتهيت إلى دير بن قابوس % 2(@)(@@) % حتى انتهيت إلى حر له كرم % يقري المدام على الإيسار والبوس % PageV01P164 البحر : رجز تام 1(@)(@@) % زيد بن عمرو صدأ الفلوس % قبيلة كالمغزل المنكوس % % 2(@)(@@) % ليست من الأصل ولا الرؤوس % وابن سوار توأم الجعموس % PageV01P165 البحر : وافر تام 1(@)(@@) % فلو ترك الحروب نساء قيس % مكبات على كحل مضيض % 2(@)(@@) % أرادوا وائلا ، ليطحطحوهم % فبادوا دون أبطحها العريض % PageV01P166 البحر : طويل 1(@)(@@) % نصبنا لكم رأسا ، فلم تكلموا به % ونحن ضربنا رأسكم ، فتصدعا % % 2(@)(@@) % ونحن قسمنا الأرض نصفين : نصفها % % لنا ونرامي أن تكون لنا معا % 3(@)(@@) % بتسعين ألفا تأله العين وسطه % متى تره عينا الطرامة ، تدمعا % % 4(@)(@@) % إذا ما أكلنا الأرض رعيا ، تطلعت % بنا الخيل ، حتى نستبيح الممنعا % % PageV01P167 البحر : رجز تام 1(@)(@@) % ويها بني تغلب ضربا ناقعا % % إنعوا إياسا واندبوا مجاشعا % 2(@)(@@) % كلاهما كان شريفا فاجعا % % حتى تسيلوا العلق الدوافعا % % 3(@)(@@) % لما رأونا والصليب طالعا % % ومارسرجيس وسما ناقعا % % 4(@)(@@) % وأبصروا راياتنا لوامعا % % كالطير ، إذا تستورد الشرائعا % % 5(@)(@@) % والبيض في أكفنا القواطعا % % خلوا لنا راذان والمزارعا % % 6(@)(@@) % وبلدة بعد ضناك واسعا % % وحنطة طيسا ، وكرما يانعا % % 7(@)(@@) % ونعما لابا ، وشاء راتعا % % أصبح جمع الحي قيس شاسعا % % 8(@)(@@) % كأنما كان غرابا واقعا % % PageV01P168 البحر : بسيط تام 1(@)(@@) % قد كشف الحلم 
ms46	 عني الجهل فانقشعت % عني الضبابة لا نكس ولا ورع % 2(@)(@@) % وهرني الناسن إلا ذا محافظة % كما يحاذر وقع الاجدل الضوع % 3(@)(@@) % والموعدي بظهر الغيب أعينهم % تبدي شناءتهم حوضي لهم ترع % 4(@)(@@) % أخزاهم الجهل ، حتى طاش قولهم % عند النضال ، فما طاروا وما وقعوا % % 5(@)(@@) % محاولون هجائي ، عند نسوتهم % ولو رأوني أسروا القول ، واتضعوا % % 6(@)(@@) % وفي الرجال يراع لا قلوب لهم % % أغمار شمط ، فما ضروا وما نفعوا % % 7(@)(@@) % إذا ما نصبت لأقوام بمشتمة % أوهيت منهم صميم العظم ، أو ظلعوا % % 8(@)(@@) % والمالكية ، قد أبصرت ما صنعت % لما تفرق شعب الحي فانصدعوا % % 9(@)(@@) % يسارق الطرف من دون الحجاب ، كما % % يرميك من دون عيص السدرة الذرع % % 10(@)(@@) % وعارضين يجول الطيب فوقهما % % ومقلة لم يخالط طرفها قمع % PageV01P169 11(@)(@@) % فأنا كالسدم من أسماء ، إذ ظعنت % أوهت من القلب ، ما لا يشعب الصنع % 12(@)(@@) % إذا تنزل من علية ، رجفت % لولا يؤيدها الآجر والقلع % PageV01P170 البحر : طويل 1(@)(@@) % قولا لزيد يثن عنا لسانه % ولا يدن منا في الزحام ، فيظلعا % % 2(@)(@@) % ويظعن ، حتى يستقر ببلدة % يجاور منجابا بها والمجذعا % % 3(@)(@@) % فأنتم أكلتم جاركم في بيوتكم % % كما قد أكلتم قبل ذاك المقنعا % % 4(@)(@@) % ونحن وفينا بالمزنم كله % وأنتم أكلتم ذا الجواعر أجمعا % % PageV01P171 البحر : متقارب تام 1(@)(@@) % أبلغ عكبا وأشياعها % % بني عامر ، أنني ضالع % 2(@)(@@) % بعثتم إلى أشمط يافعا % وهي يغلب الأشمط اليافع ؟ % PageV01P172 البحر : طويل 1(@)(@@) % ولولا هوان الخمر ما ذقت طعمها % % ولا سفت إبريقا بأنفك مترعا % % 2(@)(@@) % كما لم يذقها إذ تكون عزيزة % أبوك ولا تدنى إليه فيطمعا % % PageV01P173 البحر : طويل 1(@)(@@) % هجا الناس ليلى أم كعب فلم يدع % لها الناس إلا نفنفا أنا رافعه % PageV01P174 البحر : وافر تام 1(@)(@@) % عفا من آل فاطمة الثريا % % فمجرى السهب فالرجل البراق % 2(@)(@@) % فأصبح نازحا عنه نواها % % تقطع دونها القلص المناقي % % 3(@)(@@) % وكانت حين تعتل التفالي % % تعاطي باردا عذب المذاق % 4(@)(@@) % عليها من سموط الدر عقد % يزين الوجه في سنن العقاق % 5(@)(@@) % عداني أن أزوركم هموم % نأتني عنكم ، فمتى التلاقي % % 6(@)(@@) % ألا من مبلغ قيسا رسولا % فكيف 
ms47	 وجدتم طعم الشقاق % 7(@)(@@) % أصبنا نسوة منكم ، جهارا % بلا مهر يعد ، ولا سياق % 8(@)(@@) % تظل جيادنا متمطرات % مع الجنب المعادل والمشاق % 9(@)(@@) % فإن يك كوكب الصمعاء نحسا % به ولدت وبالقمر المحاق % 10(@)(@@) % فقد أحيا سفاه بني سليم % دفين الشر والدمن البواقي % % PageV01P175 11(@)(@@) % ملأنا جانب الثرثار منهم % وجهزنا أميمة لانطلاق % % 12(@)(@@) % ضربناهم على المكروه ، حتى % % حدرناهم إلى حدث الرقاق % 13(@)(@@) % ولاقى ابن الحباب لنا حميا % % كتفه كل حازية وراق % 14(@)(@@) % فأضحى رأسه ببلاد عك % وسائر خلقه بجبا براق % 15(@)(@@) % تعود ثعالب الحشاك منه % خبيثا ريحه ، بادي العراق % 16(@)(@@) % وإلا تذهب الأيام ، نرفد % جميلة مثلها قبل الفراق % 17(@)(@@) % بأرض يعرفون بها الشمرذى % % نطاعنهم بفتيان عتاق % 18(@)(@@) % وشيب يسرعون إلى المنادي % % بكأس الموت ، إذ كره التساقي % % 19(@)(@@) % ونعم أخو الكريهة ، حين يلقى % % إذا نزت النفوس إلى التراقي % % 20(@)(@@) % تعوذ نساؤهم بابني دخان % ولولا ذاك أبن مع الرفاق % PageV01P176 21(@)(@@) % قليلا كي ولا حتى تروها % % مشمرة على قدم وساق % 22(@)(@@) % فلا تبكوا رجال بني تميم % فما لكم ، ولا لهم تلاق % 23(@)(@@) % فأما المنتنان ابنا دخان % فقد نقحا كتنقيح العراق % 24(@)(@@) % أصنا يحميان ذمار قيس % فلم يق آنف العبدين واق % 25(@)(@@) % ومن يشهد جوارح يمتريها % % يلاق الموت بالبيض الرقاق % % PageV01P177 البحر : بسيط تام 1(@)(@@) % يا مي ، هلا يجازى بعض ودكم % أم لا يفادى أسير عندكم خلق % 2(@)(@@) % ألا يكونن هذا عهدنا بكم % إن النوى ، بعد شحط الدار ، تتفق % 3(@)(@@) % فهن يرميننا من كل مرتقب % وألبستني له ديباجة خلق % 4(@)(@@) % فقد تهازلني والمستقتلات وقد % تعتاقني عند ذات الموتة ، الأنق % 5(@)(@@) % وقد يكلفني قلبي ، فأزجره % ربعا ، غداة غدوا أهواؤهم فرق % 6(@)(@@) % وقد أقول لثور : هل ترى ظعنا % يحدو بهن حذاري مشفق شنق % 7(@)(@@) % كأنها ، بالرحا ، سفن ملججة % أو حايش ، من جواثا ، ناعم سحق % 8(@)(@@) % يرفعها الآل للتالي ، فيدركهم % % طرف حديد وطرف دونهم غرق % 9(@)(@@) % حتى لحقنا ، وقد زال النهار ، وقد % مالت لهن ، بأعلى خينف ، البرق % 10(@)(@@) % يبطرن ذا الشيب والإسلام همته % ويستقيد لهن الأهيف الروق % PageV01P178 11(@)(@@) % وفتية غير أنذال 
ms48	 ، رفعت لهم % سحق الرداء ، على علياء ، يختفق % 12(@)(@@) % رفعته ، وهو يهفو في عمائمهم % كأنه طائر ، في رجله علق % 13(@)(@@) % نفسي فداء أبي حرب غداة غدا % % مخالط الجن أو مستوحش فرق % 14(@)(@@) % على مذكرة ، ترمي الفروج بها % % غول النجاء إذا ما استعجل العنق % 15(@)(@@) % وظل حرباؤها للشمس مصطخدا % كأنه وارم الأوداج محتنق % 16(@)(@@) % والرجل لاحقة منها بأولها % % وفي يديها ، إذا استعرضتها ، دفق % 17(@)(@@) % كأنها ، بعد ضم السير جبلتها % % من وحش غزة موشي الشوى لهق % 18(@)(@@) % باتت إلى جانب منها يكفئه % ليل طويل ، وقلب خائف أرق % 19(@)(@@) % باتت له ليلة هاجت بوارحها % % ومرزم من سحاب العين يأتلق % 20(@)(@@) % فالقطر كاللؤلؤ المنثور ينفضه % إذا اقشعر به سرباله لثق % PageV01P179 21(@)(@@) % يلوذ ليلته منها بغرقدة % والغصن ينطف فوق المن والورق % 22(@)(@@) % حتى إذا كاد ضوء الصبح يفضحه % وكاد عنه سواد الليل ينطلق % 23(@)(@@) % هاجت به ذبل ، مسح جواعرها % % كأنما هن من نبعية شقق % 24(@)(@@) % فظل يهوي إلى أمر يساق له % وأتبعته كلاب الحي تستبق % 25(@)(@@) % يفرج الموت عنه ، قد تحضره % وكدن يلحقنه ، أو قد دنا اللحق % 26(@)(@@) % لما لحقن به أنحى بمغوله % يملا فرائصها من طعنه العلق % 27(@)(@@) % فكر ذو حربة ، يحمي حقيقته % إذا نحا لكلاها الروق يمتزق % 28(@)(@@) % فهن من بين متروك به رمق % صرعى ، وآخر لم يترك به رمق % 29(@)(@@) % يوم لقيناك ترمينا السموم ، وقد % كاد الملاء من الكتان تحترق % 30(@)(@@) % على مسانيف يجري ماء أعينها % % إذا تلغبهن السربخ القرق % PageV01P180 31(@)(@@) % في غمرة من سحاب الآل ، ترفعهم % % يطفون فيها ، قليلا ، ثم تنخرق % 32(@)(@@) % عن ذبل اللحم ، تهديهن معجلة % إذا تفصد ، من أقرابها ، العرق % 33(@)(@@) % كأن أنساعها من طول ما ضمرت % وشح تقعقع فيها رفرف قلق % 34(@)(@@) % تعلو الفلاة ، إذا خف السراب بها % % كما تخب ذياب القفرة الورق % 35(@)(@@) % إلى امرئ لا تخطاه الرفاق ، ولا % % جدب الخوان ، إذا ما استبطىء المرق % 36(@)(@@) % صلب الحيازيم ، لا هذر الكلام ، إذا % % هز القناة ، ولا مستعجل زهق % 37(@)(@@) % وأنت يا بن زياد عندنا حسن % منك البلاءن وأنت الناصح 
ms49	 الشفق % 38(@)(@@) % والمستقل بأمر ن ما يقوم له % غس من القوم ، رعديد ، ولا فرق % 39(@)(@@) % وأنت خير ابن أخت ، يستطاف به % إذا تزعزع فوق الفيلق الخرق % 40(@)(@@) % موطأ البيت ، محمود شمائله % عند الحمالة لا كز ولا وعق % PageV01P181 البحر : طويل 1(@)(@@) % ألهى جريرا عن أبيه وأمه % مكان لشبان الرجال أنيق % 2(@)(@@) % إذا أبصرته ذات طني ، تبسمت % إليه ، وقالت : إن ذا الخليق % 3(@)(@@) % يبيت يسوف الخور ، وهي رواكد % كما ساف أبكار الهجان فنيق % 4(@)(@@) % عبوس إلى شمط الرجال ، وإنه % إلى كل صفراء البنان طليق % 5(@)(@@) % سبتني يظل الكلب يمضغ ثوبه % له في معان الغانيات طريق % 6(@)(@@) % خروج ، ولوج ، مستخف ، كأنما % % عليه بأن لا يستفيق وثيق % 7(@)(@@) % عنيف بتحياز المخاض ورعيها % % ولكن بإرقاص البرين رفيق % 8(@)(@@) % ومن دونه يحتاط أوس بن مدلج % وإياه يخشى طارق وزنيق % PageV01P182 البحر : طويل 1(@)(@@) % ما جذع سوء خرب السوس أصله % لما حملته وائل بمطيق % 2(@)(@@) % تطيف سدوس حوله ، وكأنها % % عصي أشاء ، لوحت بحريق % 3(@)(@@) % جماد الصفا ما إن يبض بقطرة % ولو كان ذا زراعة ورقيق % 4(@)(@@) % فإن نعف عن حمران بكر بن وائل % فما إن لنا سودانهم بصديق % PageV01P183 البحر : طويل 1(@)(@@) % يا راكبا إما عرضت فبلغن % بنانة بالحصنين وابن المحلق % 2(@)(@@) % وعمران أن أدوا الذي قد وأيتم % وأعراضكم موفورة لم تمزق % % 3(@)(@@) % ألم تعلموا يا قوم أني وراكم % فما يرتقى حصني إليكم وخندقي % % 4(@)(@@) % وما أنا إن عدت معد قديمها % % بمنزلة المولى ولا المتعلق % 5(@)(@@) % لعمري لقد أبليت في الشعر دارما % بلاء نمى في كل غرب ومشرق % % 6(@)(@@) % بلاء امرئ لا مستثيب بنعمة % فتشكر نعماه ولا متملق % 7(@)(@@) % هجوت كليبا أن هجوا آل دارم % وأمسكت من يربوعهم بالمخنق % 8(@)(@@) % ورهط أبي ليلى فأطفأت نارهم % وأقررت عيني من جداء الحبلق % 9(@)(@@) % فإن يك أقوام أضاعوا ، فإنني % % حفظت الذي بيني وبين الفرزدق % PageV01P184 البحر : بسيط تام 1(@)(@@) % أما كليب بن يربوع ، فإنهم % شر الرفاق ، إذا ما حصل الرفق % 2(@)(@@) % سود الوجوه ، وراء القوم مجلسهم % % كأن قائلهم في الناس مسترق % 3(@)(@@) % البائتون 
ms50	 ، قريبا دون أهلهم % ولو يشاؤون آبو الحي ، أو طرقوا % % PageV01P185 البحر : طويل 1(@)(@@) % ما لك عز التغلبي الذي بنى % % له الله في شم الجبال الحوارك % 2(@)(@@) % وما لك ما يبني لجيم ، إذا ابتنى % % على عمد فيها طوال المسامك % 3(@)(@@) % ولا التغلبين الذين رماحهم % معاقل عوذات النساء الرواتك % 4(@)(@@) % وما غر كلبا من كليب بحية % أصم ، على أنيابه السم ، شابك % 5(@)(@@) % وبيت صفاة في لهاب ، لعابه % سمام المنايا ، أسود اللون حالك % 6(@)(@@) % ترى ما يمس الأرض منه ، إذا مشى % % صدوعا عنها متون الدكادك % 7(@)(@@) % بني الخطفى عدوا شبيها لدارم % وعميه ، أو عدوا أبا مثل مالك % 8(@)(@@) % وإلا فهروا دارما ، إن دارما % أناخ بعادي عريض المبارك % 9(@)(@@) % من العز ، لا يسطيعه أن يناله % قصار الهوادي جاذيات السنابك % 10(@)(@@) % فلست إليهم ، يا جرير ، فلا تكن % % كمستقتل أعطى يدا للمهالك % PageV01P186 11(@)(@@) % تقاصرت عن سعد ، فما أنت منهم % % ولا أنت من ذاك العديد الضبارك % 12(@)(@@) % كليب يفالون الحمير ودارم % على العيس ثانو الخز فوق الموارك % 13(@)(@@) % وكنتم مع الساعي المضل بني استها % % جرير ، وسلاكين شر المسالك % 14(@)(@@) % ضفادع غرتها صراة فقصرت % من البحر عن آذية المتدارك % PageV01P187 البحر : طويل 1(@)(@@) % بنو دارم عند السماء ، وأنتم % قذى الأرض أبعد بينما بين ذلك % % 2(@)(@@) % وقد كان منهم حاجب وابن عمه % أبو جند والزيد زيد المعارك % 3(@)(@@) % وترفدهم أبناء حنظلة الذرى % % حصى يتحدى قبصه كل فاتك % 4(@)(@@) % ولولاهم يابن المراغة ، كنتم % لقا بين أطراف القنا للسنابك % 5(@)(@@) % هم أنقذوا يوم الهضيبات سبيكم % وأبناء رهط الكلب قرع المبارك % 6(@)(@@) % فررتم حذار التغليين ، إذ سموا % % بأرعن طود مشمخر الحوارك % PageV01P188 البحر : طويل 1(@)(@@) % عفا واسط من آل رضوى فنبتل % فمجتمع الحرين ، فالصبر أجمل % 2(@)(@@) % فرابية السكران قفر ، فما لهم % بها شبح ، إلا سلام وحرمل % 3(@)(@@) % صحا القلب إلا من ظعائن فاتني % % بهن ابن خلاس طفيل وعزهل % 4(@)(@@) % كأني ، غداة انصعن للبين ، مسلم % بضربة عنق ، أو غوي معذل % 5(@)(@@) % صريع مدام يرفع الشرب رأسه % ليحيا ، وقد ماتت عظام ومفصل % 6(@)(@@) % نهاديه أحيانا ن وحينا 
ms51	 نجره % وما كاد إلا بالحشاشة يعقل % 7(@)(@@) % إذا رفعوا عظما تحامل صدره % وآخر ، مما نال منها مخبل % 8(@)(@@) % شربت ، ولا قاني لحل أليتي % % قطار تروى من فلسطين مثقل % 9(@)(@@) % عليه من المعزى مسوك روية % مملأة ، يعلى بها وتعدل % 10(@)(@@) % فقلت : اصبحوني لا أبا لأبيكم % وما وضعوا الأثقال ، إلا ليفعلوا % % PageV01P189 11(@)(@@) % أناخوا فجروا شاصيات كأنها % % رجال من السودان ، لم يتسربلوا % % 12(@)(@@) % وجاؤوا ببيسانية ، هي ، بعدما % % يعل بها الساقي ، ألذ وأسهل % 13(@)(@@) % تمر بها الأيدي ، سنيحا وبارحا % وتوضع باللهم حي وتحمل % 14(@)(@@) % وتوقف ، أحيانا ، فيفصل بيننا % % غناء مغن ، أو شواء مرعبل % 15(@)(@@) % فلذت لمرتاح ، وطابت لشارب % وراجعني منها مراح وأخيل % 16(@)(@@) % فما لبثتنا نشوة لحقت بنا % % توابعها ، مما نعل وننهل % 17(@)(@@) % فصبوا عقارا في إناء ، كأنها % % إذا لمحوها ، جذوة تتأكل % 18(@)(@@) % تدب دبيبا في العظام ، كأنه % دبيب نمال في نقا يتهيل % 19(@)(@@) % فقلت اقتلوها عنكم بمزاجها % % فأطيب بها مقتولة ، حين تقتل % 20(@)(@@) % ربت وربا في حجرها ابن مدينة % يظل على مسحاته يتركل % PageV01P190 21(@)(@@) % إذا خاف من نجم عليها ظماءة % أدب إليها جدولا يتسلسل % 22(@)(@@) % أعاذل ، إلا تقصري عن ملامتي % % أدعك ، وأعمد للتي كنت أفعل % 23(@)(@@) % وأهجرك هجرانا جميلا ، وينتحي % % لنا ، من ليالينا العوارم ، أول % 24(@)(@@) % فلما انجلت عني صبابة عاشق % بدا لي من حاجاتي المتأمل % 25(@)(@@) % إلى هاجس من آل ظمياء ، والتي % % أتي دونها باب بصرين مقفل % 26(@)(@@) % وبيداء ممحال ، كأن نعامها % % بأرجائها القصوى ، أباعر همل % 27(@)(@@) % ترى لامعات الآل فيها ، كأنها % % رجال تعرى ، تارة ، وتسربل % 28(@)(@@) % وجوز فلاة ما يغمض ركبها % % ولا عين هاديها من الخوف تغفل % 29(@)(@@) % بكل بعيد الغول ، لا يهتدى له % بعرفان أعلام ، وما فيه منهل % 30(@)(@@) % ملاعب جنان ، كأن ترابها % % إذا اطردت فيه الرياح مغربل % PageV01P191 31(@)(@@) % وحارت بقاياها إلى كل حرة % مصل يمان أو أسير مكبل % 32(@)(@@) % إلى ابن أسيد خالد أرقلت بنا % % مسانيف ، تعروري فلاة تغول % 33(@)(@@) % ترى الثعلب الحولي فيها ، كأنه % إذا ما علا نشزا ، حصان مجلل % 34(@)(@@) % ترى العرمس الوجناء يضرب حاذها % % ضئيل كفروج 
ms52	 الدجاجة معجل % 35(@)(@@) % يشق سماحيق السلا عن جنينها % % أخو قفرة بادي السغابة أطحل % 36(@)(@@) % فما زال عنها السير ، حتى تواضعت % عرائكها مما تحل وترحل % 37(@)(@@) % وتكليفناها كل نازحة الصوى % % شطون ، ترى حرباءها يتململ % 38(@)(@@) % وقد ضمرت حتى كأن عيونها % % بقايا قلات ، أو ركي ممكل % 39(@)(@@) % وغارت عيون العيس ، والتقت العرى % % فهن ، من الضراء والجهد نحل % 40(@)(@@) % % لها بعد إسآد مراح وأفكل % PageV01P192 42(@)(@@) % وإلا مبال آجن في مناخها % % ومضطمرات كالفلافل ذبل % 43(@)(@@) % حوامل حاجات ثقال ، تجرها % % إلى حسن النعمى سواهم نسل % 44(@)(@@) % إلى خالد ، حتى أنخنا بمخلد % فنعم الفتى يرجى ونعم المؤمل % 45(@)(@@) % أخالد ، مأواكم ، لمن حل ، واسع % وكفاك غيث للصعاليك مرسل % 46(@)(@@) % هو القائد الميمون ، والمبتغى به % ثبات رحى كانت قديما تزلزل % 47(@)(@@) % أبى عودك المعجوم إلا صلابة % وكفاك إلا نائلا ، حين تسأل % 48(@)(@@) % ألا أيها الساعي ليدرك خالدا % تناه وأقصر بعض ما كنت تفعل % 49(@)(@@) % فهل أنت إن مد المدى لك خالد % موازنه ، أو حامل ما يحمل % 50(@)(@@) % أبى لك أن تسطيعه ، أو تناله % حديث شآك القوم فيه وأول % 51(@)(@@) % أمية والعاصي ، وإن يدع خالد % يحبه هشام للفعال ونوفل % PageV01P193 52(@)(@@) % أولئك عين الماء فيهم ، وعندهم % من الخيفة ، المنجاة والمتحول % 53(@)(@@) % سقى الله أرضا ، خالد خير أهلها % % بمستفرغ باتت عزاليه تسحل % 54(@)(@@) % إذا طعنت ريح الصبا في فروجه % تحلب ريان الأسافل أنجل % 55(@)(@@) % إذا زعزعته الريح ، جر ذيوله % كما زحفت عوذ ثقال تطفل % 56(@)(@@) % ملح ، كأن البرق في حجراته % مصابيح ، أو أقراب بلق تجفل % 57(@)(@@) % فلما انتحى نحو اليمامة ، قاصدا % دعته الجنوب فانثنى يتخزل % 58(@)(@@) % سقى لعلعا والقرنتين فلم يكد % بأثقاله عن لعلع يتحمل % 59(@)(@@) % وغادر أكم الحزن تطفو ، كأنها % % بما احتملت منه رواجن قفل % 60(@)(@@) % وبالمعرسانيات حل ، وأرزمت % بروض القطا منه مطافيل حفل % 61(@)(@@) % لقد أوقع الجحاف بالبشر وقعة % إلى الله منها المشتكى والمعول % PageV01P194 62(@)(@@) % فسائل بني مروان ، ما بال ذمة % وحبل ضعيف ، لا يزال يوصل % 63(@)(@@) % بنزوة لص ، بعدما مر مصعب % بأشعث لا يفلى ولا هو يغسل % 64 
ms53	(@)(@@) % أتاك به الجحاف ، ثم أمرته % بجيرانكم عند البيوت تقتل % 65(@)(@@) % لقد كان للجيران ، ما لو دعوتم % به عاقل الأروى أتتكم تنزل % 66(@)(@@) % فإن لا تغيرها قريش بملكها % % يكن عن قريش مستماز ومرحل % 67(@)(@@) % ونعرر أناسا عرة يكرهونها % % ونحيا كراما ، أو نموت ، فنقتل % 68(@)(@@) % وإن تحملوا عنهم ، فما من حمالة % وإن ثقلت ، إلا دم القوم أثقل % 69(@)(@@) % وإن تعرضوا فيها لنا الحق ، لم نكن % عن الحق عميانا ، بل الحق نسأل % 70(@)(@@) % وقد ننزل الثغر المخوف ، ويتقى % % بنا الناس واليوم الأغر المحجل % PageV01P195 البحر : بسيط تام 1(@)(@@) % بانت سعاد ففي العينين ملمول % من حبها ، وصحيح الجسم مخبول % 2(@)(@@) % فالقلب ، من حبها ، يعتاده سقم % إذا تذكرتها ، والجسم مسلول % 3(@)(@@) % وإن تناسيتها أو قلت : قد شحطت % عادت نواشط منها ، فهو مكبول % 4(@)(@@) % مرفوعة عن عيون الناس في غرف % لا يطمع الشيب فيها والتنابيل % 5(@)(@@) % يخالط القلب بعد النوم لذتها % % إذا تنبه ، واعتل المتافيل % 6(@)(@@) % يروي العطاش لمى عذب مقبله % في جيد آدم ، زانته التهاويل % 7(@)(@@) % حلي يشب بياض النحر واقده % كما تصور في الدير التماثيل % 8(@)(@@) % أو كالعسيب ، نماه جدول غدق % وكنه وهج القيظ الأظاليل % 9(@)(@@) % غراء ، فرعاء ، مصقول عوارضها % % كأنها أحور العينين مكحول % 10(@)(@@) % أخرقه وهو في أكناف سدرته % يوم تضرمه الجوزاء ، مشمول % PageV01P196 11(@)(@@) % فسلها بأمون الليل ، ناجية % فيها هباب إذا كل المراسيل % 12(@)(@@) % قنواء ناضحة الذفرى مفرجة % مرفقها ، عن ضلوع الزور ، مفتول % 13(@)(@@) % تسمو ، كأن شرارا بين أذرعها % % من ناسف المرو ، مرضوح ومنجول % 14(@)(@@) % كأنها واضح الأقراب في لقح % أسمى بهن ، وعزته الأناصيل % 15(@)(@@) % تذكر الشرب ، إذ هاجت مراتعه % وذو الأشاء طريق الماء مشغول % 16(@)(@@) % فظل مرتبيا ، عطشان في أمر % كأنما مس منه الشمس مملول % 17(@)(@@) % يقسم أمرا : أبطن الغيل يوردها % % أم بحرعانة إذا نشف البراغيل % 18(@)(@@) % فأجمع الأمر أصلا ثم أوردها % % وليس ماء ، بشرب البحر معدول % 19(@)(@@) % فهاجهن على الأهواء منحدر % وقع قوائمه بالأرض تحليل % 20(@)(@@) % قارح عامين ، قد طارت نسيلته % سنبكه ، من رضاض المرو ، مفلول % PageV01P197 21(@)(@@) % يحدو خماصا كأعطال القسي ، له 
ms54	 % من صكهن ، إذا عاقبن ، تخبيل % 22(@)(@@) % أوردها منهلا ، زرقا شرائعه % وقد تعطشت الجحشان والحول % 23(@)(@@) % يشربن من بارد عذب ، وأعينها % % من حيث تخشى وراء الرامي الغيل % 24(@)(@@) % نالت قليلا ، وخاضت ، ثم أفزعها % % مرمل ، من دماء الوحش ، معلول % 25(@)(@@) % فانصعن كالطير ، يحدوهن ذو زجل % كأنه ، في تواليهنن مشكول % 26(@)(@@) % مستقبل وهج لجوزاء يهجمها % % سح الشآبيب ، شد فيه تعجيل % 27(@)(@@) % إذا بدت عورة منها ، أضر بها % % بادي الكراديس ، خاظي اللحم ، يت % 28(@)(@@) % يتبعه مثل هداب الملاء له % منها أعاصير : مقطوع وموصول % 29(@)(@@) % يا أيها الراكب المزجي مطيته % أسرع ، فأنك إن أدركت مقتول % 30(@)(@@) % لا يخدعنك كلبي بذمته % إن القضاعي إن جاورته غول % PageV01P198 31(@)(@@) % كم قد هجمنا عليهم من مسمومة % شعث ، فوارسها البيض ، البهاليل % 32(@)(@@) % نسي النساء ، فما تنعك مردفة % قد أنهجت عن معاريها السرابيل % PageV01P199 البحر : كامل تام 1(@)(@@) % كذبتك عينك ، أم رأيت بواسط % غلس الظلام من الرباب خيالا % % 2(@)(@@) % وتعرضت لك بالأباطح بعدما % % قطعت بأبرق خلة ووصالا % % 3(@)(@@) % وتغولت لتروعنا جنية % والغانيات يرينك الأهوالا % % 4(@)(@@) % يمددن من هفواتهن إلى الصبى % % سببا يصدن به الغواة طوالا % % 5(@)(@@) % ما إن رأيت كمكرهن ، إذا جرى % % فينا ، ولا كحبالهن حبالا % % 6(@)(@@) % المهديات لمن هوين مسبة % والمحسنات لمن قلين مقالا % % 7(@)(@@) % يرعين عهدك ، ما رأينك شاهدا % وإذا مذلت يصرن عنك مذالا % % 8(@)(@@) % إن الغواني ، إن رأينك طاويا % برد الشبابن طوين عنك وصالا % % 9(@)(@@) % وإذا وعدنك نائلا ، أخلفنه % ووجدت عند عداتهن مطالا % % 10(@)(@@) % وإذا دعونك عمهن ، فإنه % نسب يزيدك عندهن خبالا % % PageV01P200 11(@)(@@) % وإذا وزنت حلومهن إلى الصبى % % رجح الصبى بحلومهن فمالا % % 12(@)(@@) % أهي الصريمة منك أم محلم % أم ذا الدلال ، فطال ذاك دلالا % % 13(@)(@@) % ولقد علمت إذا العشار تروحت % هدج الرئال ، تكبهن شمالا % % 14(@)(@@) % ترمي العضاه بحاصب من ثلجها % % حتى يبيت على العضاه جفالا % % 15(@)(@@) % أنا نعجل بالعبيط لضيفنا % % قبل العيال ، ونقتل الأبطالا % % 16(@)(@@) % أبني كليب ، إن عمي اللذا % % قتلا الملوك ، وفككا الأغلالا % % 17(@)(@@) % وأخوهما السفاح ظمأ خيله % حتى وردن جبي الكلاب نهالا % % PageV01P201 البحر : كامل تام 1(@)(@@) % يخرجن 
ms55	 من ثغر الكلاب عليهم % خبب السباع تبادر الأوشالا % % 2(@)(@@) % من كل مجتنب ، شديد أسره % سلس القيادن تخاله مختالا % % 3(@)(@@) % وممرة أثر السلاح بنحرها % % فكأن فوق لبانها جريالا % % 4(@)(@@) % قب البطون قد انطوين من السرى % % وطرادهن إذا لقين قتالا % % 5(@)(@@) % ملح المتون ، كأنما ألبستها % % بالماء إذ يبس النضيح ، جلالا % % 6(@)(@@) % ولقل ما يصبحن إلا شزبا % يركبن من عرض الحوادث حالا % % 7(@)(@@) % فطحن حائرة الملوك بكلكل % حتى احتذين من الدماء نعالا % % 8(@)(@@) % وأبرن قومكن يا جرير ، وغيرهم % وأبرن من حلق الرباب حلالا % % 9(@)(@@) % ولقد دخلن على شقيق بيته % ولقد رأين بساق نضرة خالا % % 10(@)(@@) % وبنو غدانة شاخص أبصارهم % يسعون تحت بطونهن رجالا % % PageV01P202 11(@)(@@) % ينقلنهم نقل الكلاب جراءها % % حتى وردن عراعرا وأثالا % % 12(@)(@@) % حرز العيون إلى رياح ، بعدما % % جعلت لضبة بالرماح ظلالا % % 13(@)(@@) % ما إن تركن من الغواضر معصرا % إلا فصمن بساقها خلخالا % % 14(@)(@@) % ولقد سما لكم الهذيل ، فنالكم % بإراب حيث يقسم الأنفالا % % 15(@)(@@) % في فيلق يدعو الأراقم ، لم تكن % فرسانه عزلا ، ولا أكفالا % % 16(@)(@@) % بالخيل ساهمة الوجوه ، كأنما % % خالطن من عمل الوجيف سلالا % % 17(@)(@@) % ولقد عطفن على قدارة عطفة % كر المنيح ، وجلن ثم مجالا % % 18(@)(@@) % فسقين من عادين كأسا مرة % وأزلن حد بني الحباب فزالا % % 19(@)(@@) % يغشين جيفة كاهل عرينها % % وابن المهزم ، قد تركن مذالا % % 20(@)(@@) % قفتلن من حمل السلاح وغيرهم % % وتركن فلهم عليك عيالا % % PageV01P203 21(@)(@@) % ولقد بكى الجحاف ، مما أوقعت % بالشرعبية ، إذا رأى الأطفالا % % PageV01P204 البحر : كامل تام 1(@)(@@) % وإذا سما للمجد فرعا وائل % واستجمع الوادي عليك فسالا % % 2(@)(@@) % كنت القذى في موج أكدر مزبد % قذف الأتي به ، فضل ضلالا % % 3(@)(@@) % ولقد وطئن على المشاعر من منى % % حتى قدفن على الجبال جبالا % % 4(@)(@@) % فانعق بضأنك يا جريرن فإنما % % منتك نفسك في الخلاء ضلالا % % 5(@)(@@) % منتك نفسك أن تسامي دارما % أو أن توازن حاجبا وعقالا % 6(@)(@@) % وإذا وضعت أباك في ميزانهم % قفزت حديدته إليك ، فشالا % % 7(@)(@@) % إن العرارة والنبوح لدارم % والمستخف أخوهم الأثقالا % % 8(@)(@@) % المانعين الماء ، حتى يشربوا % % عفواته ، ويقسموه سجالا % % 9(@)(@@) % وابن 
ms56	 المراغة حابس أعياره % قذف الغريبة ما يذقن بلالا % % PageV01P205 البحر : وافر تام 1(@)(@@) % ألا تنهي بنو عجل جريرا % كما لا ينتهي عنا هلال % 2(@)(@@) % وما يعني عن الذهلين إلا % كما يغني عن الغنم الخيال % PageV01P206 البحر : وافر تام 1(@)(@@) % لزيد اللات أقدام قصار % قليل أخذهن من النعال % 2(@)(@@) % هنيئة في الضلال وعبد بكر % ومنجاب كراعية الخيال % 3(@)(@@) % تخلوا في الحوادث من أبيهم % ونادوا خفرة دعوى ضلال % PageV01P207 البحر : وافر تام 1(@)(@@) % لقد جاريت يا بن أبي جرير % عزوما ليس ينظرك المطالا % % 2(@)(@@) % نصبت إلي نبلك من بعيد % فليس أوان تدخر النبالا % % 3(@)(@@) % فلا ، وأبيك ، ما يستطيع قوم % إذا لم يأخذوا منا حبالا % % 4(@)(@@) % عداوتنا ، وإن كثروا وعزوا % % ولا يثنون أيدينا الطوالا % % 5(@)(@@) % وما اليربوع محتضنا يديه % بمغن عن بني الخطفى قبالا % % 6(@)(@@) % تشد القاصعاء عليه ، حتى % % تنفق ، أو يموت بها هزالا % % 7(@)(@@) % فلا تدخل بيوت بني كليب % ولا تقرب لهم أبدا رحالا % % 8(@)(@@) % ترى منها لوامع مبرقات % يكدن ينكن بالحدق الرجالا % % 9(@)(@@) % قصيرات الخطى عن كل خير % إلى السوآت ممسحة رعالا % % PageV01P208 البحر : طويل 1(@)(@@) % لهان على فتيان بكر بن وائل % وتغلب أصعاد بذات الجحافل % 2(@)(@@) % سما لمراعيها نفيل بفتية % فألوى بها عن بيت أعزل تافل % 3(@)(@@) % كأن لم تبرك بالقنيني مرة % ولم يرتكب منها لرمكاء حافل % 4(@)(@@) % شديدة أز الآخرين كأنها % % إذا ابتدها العلجان زجلة قافل % PageV01P209 البحر : - 1(@)(@@) % إن بني مليحو الشكل % كم فيهم من فعلة وفعل % 2(@)(@@) % يخطر بالمنجل وسط الحقل % يوم الحصاد خطران الفحل % PageV01P210 البحر : طويل 1(@)(@@) % ذببت عن أعراضكم آل وائل % وناضلت حتى لم أجد من أناضله % PageV01P211 البحر : كامل تام 1(@)(@@) % لمن الديار بحايل ، فوعال % درست وغيرها سنون خوال % 2(@)(@@) % درج البوارح فوقها ، فتنكرت % بعد الأنيس معارف الأطلال % 3(@)(@@) % فكأنما هي ، من تقادم عهدها ، % ورق نشرن من الكتاب بوالي % % 4(@)(@@) % دمن تذعذعها الرياح ، وتارة % تسقى بمرتجز السحاب ثقال % 5(@)(@@) % باتت يمانية الرياح تقوده % حتى استقاد لها بغير حبال % 6(@)(@@) % في مظلم غدق الرباب ، كأنما % % يسقي الأشق وعالجا بدوالي % % 7(@)(@@) % وعلى 
ms57	 زبالة بات منه كلكل % وعلى الكثيب وقلة الأدحال % 8(@)(@@) % دار تبدلت النعام بأهلها % % وصوار كل ملمع ذيال % 9(@)(@@) % وعلا البسيطة فالشقيق بريق % فالضوج بين روية فطحال % 10(@)(@@) % أدم مخدمة السواد ، كأنها % % خيل هوامل بتن في أجلال % PageV01P212 11(@)(@@) % ترعى بحازجها خلال رياضها % % وتميس بين سباسب ورمال % 12(@)(@@) % ولقد تكون بها الرباب لذيذة % وتصيد بعد تقتيل ودلال % % 13(@)(@@) % قلب الغوي ، إذا تنبه ، بعدما % % تعتل كل مذالة متفال % 14(@)(@@) % عشنا بذلك حقبة من عيشنا % % وثرا من الشهوات والأموال % 15(@)(@@) % ولقد أكون لهن صاحب لذة % حتى تغير حالهن وحالي % % 16(@)(@@) % أغليت ، حين تواكلتني وائل % % 17(@)(@@) % فتنكرت لما علتني كبرة % عند المشيب ، وآذنت بزيال % 18(@)(@@) % لما رأت بدل الشباب ، بكت له % والشيب أرذل هذه الأبدال % 19(@)(@@) % والناس همهم الحياة ، وما أرى % % طول الحياة يزيد غير خبال % % 20(@)(@@) % وإذا افتقرت إلى الذخائر ، لم تجد % ذخرا يكون كصالح الأعمال % PageV01P213 21(@)(@@) % ولئن نجوت من الحوادث سالما % % والنفس مشرفة على الآجال % % 22(@)(@@) % لأغلغلن إلى كريم مدحة % ولأثنين بنايل وفعال % 23(@)(@@) % إن ابن ربعي كفاني سيبه % ضغن العدو ونبوة البخال % 24(@)(@@) % % إن المكارم عند ذاك غوالي % % 25(@)(@@) % ولقد شفيت مليلتي من معشر % نزلوا بعقوة حية قتال % 26(@)(@@) % بعدت قعور دلائهم ، فرأيتهم % % عند الحمالة مغلقي الأقفال % 27(@)(@@) % ولقد مننت على ربيعة كلها % % وكفيت كل مواكل خذال % 28(@)(@@) % كزم اليدين عن العطية ، ممسك % ليست تبض صفاته ببلال % 29(@)(@@) % مثل ابن بزعة ، أو كآخر مثله % أولى لك ابن مسيمة الأجمال % % 30(@)(@@) % إن اللئيم ، إذا سألت بهرته % وترى الكريم يراح كالمختال % PageV01P214 31(@)(@@) % وإذا عدلت به رجالا ، لم تجد % فيض الفرات كراشح الأوشال % 32(@)(@@) % فاحمل هناك على فتى حمال % عنها بمنبهر ، ولا سعال % 33(@)(@@) % وإذا أتى باب الأمير لحاجة % سمت العيون إلى أغر طوال % 34(@)(@@) % ضخم سرادقه ، يعارض سيبه % نفحات كل صبا وكل شمال % 35(@)(@@) % وإذا المئون تؤوكلت أعناقها % % فاحمل هنالك على فتى حمال % 36(@)(@@) % ليست عطيته ، إذا ما جئته % نزرا ، وليس سجاله كسجال % 37(@)(@@) % فهو الجواد لمن تعرض سيبه % وابن الجواد وحامل الأنفال % 38 
ms58	(@)(@@) % ومسوم خرق الحتوف تقوده % للطعن ، يوم كريهة وقتال % 39(@)(@@) % أقصدت قائدها بعامل صعدة % ونزلت عند تواكل الأبطال % 40(@)(@@) % والخيل عابسة ، كأن فروجها % % ونحورها ينضحن بالجريال % PageV01P215 41(@)(@@) % والقوم تختلف الأسنة بينهم % يكبون بين سوافل وعوالي % % 42(@)(@@) % ولقد ترد الخيل عن أهوائها % % وتلف حد رجالها برجال % 43(@)(@@) % وموقع ، أثر السفار بخطمه % من سود عقة أو بني الجوال % 44(@)(@@) % يمري الجلاجل منكباه ، كأنه % قرقور أعجم من تجار أوال % 45(@)(@@) % بكرت علي به التجار ، وفوقه % أحمال طيبة الرياح حلال % 46(@)(@@) % فوضعت غير غبيطه أثقاله % بسباء لا حصر ولا وغال % 47(@)(@@) % ولقد شربت الخمر في حانوتها % % وشربتها بأريضة محلال % % 48(@)(@@) % ولقد رهنت يدي المنية ، معلما % وحملت عند تواكل الحمال % 49(@)(@@) % فلأجعلن بني كليب شهرة % بعوارم ، هبت مع القفال % 50(@)(@@) % كل المكارم قد بلغت ، وأنتم % زمع الكلاب معانقوا الأطفال % PageV01P216 51(@)(@@) % وكأنما نسيت كليب عيرها % % بين الصريح وبين ذي العقال % 52(@)(@@) % يمشون حول مكدم ، قد سحجت % % 53(@)(@@) % وإذا أتيت بني كليب ، لم تجد % عددا يهاب ولا كثير نوال % 54(@)(@@) % ألعادلين بدارم يربوعهم % جدعا جرير لألأم الأعدال % 55(@)(@@) % وإذا وردت جرير ، فاحبس صاغرا % إن البكور لحاجب وعقال % PageV01P217 البحر : بسيط تام 1(@)(@@) % هل تعرف اليوم من ماوية الطللا % % تحملت إنسه منه ، وما إحتملا % % 2(@)(@@) % ببطن خينف من أم الوليد ، وقد % % تامت فؤادك ، أو كانت له خبلا % % 3(@)(@@) % جرت عليه رياح الصيف حاصبها % % حتى تغير بعد الأنس أو خملا % % 4(@)(@@) % فما به غير موشي أكارعه % إذا أحس بشخص نابئ ، مثلا % % 5(@)(@@) % يرعى بخينف ، أحيانا وتضمره % أرض خلاء وماء سائل غللا % % 6(@)(@@) % شهري جمادى ، فلما كان في رجب % أتمت الأرض مما حملت حبلا % % 7(@)(@@) % كأن عطارة باتت تطيف به % حتى تسربل ماء الورس وانتعلا % % 8(@)(@@) % صبحه ضامر غرثان قد نحلا % % أصاب بالقفر من وسيمه خضلا % % 9(@)(@@) % حتى إذا الليل كف الطرف ألبسه % غيث ، إذا ما مرته ريحه ، سحلا % % 10(@)(@@) % داني الرباب إذا ارتجت حوامله % بالماء ، سد فروج الأرض واحتفلا % % PageV01P218 11(@)(@@) % فبات مكتليا للبرق ، يرقبه % كليلة الوصب ، ما أغفى وما عقلا % % 12 
ms59	(@)(@@) % فبات في حقف أرطاة ، يلوذ بها % % إذا أحس بسيل تحته انتقلا % % 13(@)(@@) % كأنه ساجد ، من نضخ ديمته % مسبح ، قام نصف الليل ، فابتهلا % % 14(@)(@@) % ينفي التراب بروقيه وكلكله % كما استماز رئيس المقنب النفلا % % 15(@)(@@) % كأنما القطر مرجان يساقطه % إذا علا الروق والمتنين والكفلا % % 16(@)(@@) % حتى إذا الشمس وافته بمطلعها % % صحبه ضامر غرثان قد نخلا % % 17(@)(@@) % طاو أزل كسرحان الفلاة ، إذا % % لم تؤنس الوحش منه نبأة ختلا % % 18(@)(@@) % يشلي سلوقية غضفا ، إذا اندفعت % خافت جديلة في الآثار أو ثعلا % % 19(@)(@@) % مكلبين إذا اصطادوا ، كأنهم % يسقونها بدماء الأبد العسلا % % 20(@)(@@) % فانصاع كالوكب الدري ، جرده % غيث تقشع عنه طال ما هطلا % % PageV01P219 21(@)(@@) % حتى إذا قلت نالته سوابقها % % كر عليها ، وقد أمهلنه مهلا % % 22(@)(@@) % فظل يطعنها ، شزرا ، بمغوله % % إذا أصاب بروق ضاريا قتلا % % 23(@)(@@) % كأنهن ، وقد سربلن من علق % يغشين موقد نار ، تقذف الشعلا % % 24(@)(@@) % إذا أتاهن مكلوم ، عكفن به % % عكف الفوارس ، هابوا الدراع البطلا % % 25(@)(@@) % حتى تناهين عنه ساميا حرجا % وما هدى هدي مهزوم وما نكلا % % 26(@)(@@) % وقد تبيت هموم النفس ، تبعثني % % منها نوافذ حتى أعمل الحيلا % % 27(@)(@@) % إذ لا تجهمني أرض العدو ، ولا % % عسف البلاد ، إذا حرباؤها جذلا % % 28(@)(@@) % يظل مرتبيا للشمس تصهره % إذا رأى الشمس مالت جانبا عدلا % % 29(@)(@@) % كأنه حين يمتد النهار له % إذا استقل يمان ، يقرأ الطولا % % 30(@)(@@) % وقد لبست لهذا الدهر أعصره % حتى تجلل رأسي الشيب واشتعلا % % PageV01P220 31(@)(@@) % من كل مضلعة لولا أخو ثقة % ما أصبحت أمما عندي ولا جللا % % 32(@)(@@) % وقد أكون عميد الشرب ، تسمعنا % % بحاء تسمع في ترجيعها صحلا % % 33(@)(@@) % من القيان هتوف طال ما ركدت % بفتية ، يشتهون اللهو والغزلا % % 34(@)(@@) % فبان مني شبابي ، بعد لذته % كأنما كان ضيفا نازلا رحلا % % 35(@)(@@) % إذ لا أطاوع أمر العاذلات ، ولا % % أبقي على المال ، إن ذو حاجة سألا % % 36(@)(@@) % وكاشح معرض عني ، غفرت له % وقد أبين منه الضغن والميلا % % 37(@)(@@) % ولو أواجهه مني بقارعة % ما كان كالذيب مغبوطا بما أكلا % % 38(@)(@@) % وموجع ، كان ذا قربى ، فجعت به % يوما وأصبحت أرجو 
ms60	 ، بعده ، الأملا % % 39(@)(@@) % ولا أرى الموت يأتي من يحم له % إلا كفاه ولاقى عنده شغلا % % 40(@)(@@) % وبينما المرء مغبوط بمأمنه % إذا خانه الدهر عما كان ، فانتقلا % % PageV01P221 41(@)(@@) % دع المغمر لا تسأل بمصرعه % واسأل بمصقلة البكري ما فعلا % % 42(@)(@@) % بمتلف ومفيد ، لا يمن ولا % % تهلكه النفس ، فيما فاته عذلا % % 43(@)(@@) % جزل العطاء ، وأقوام ، إذا سئلوا % % يعطون زرا كما تستوكف الوشلا % % 44(@)(@@) % وفارس غير وقاف برايته % يوم الكريهة ، حتى يعمل الأسلا % % 45(@)(@@) % ضخم تعلق أشناق الديات به % إذا المئون أمرت ، فوقه ، حملا % % 46(@)(@@) % ولو تكلفها رخو مفاصله % أو ضيق الباع عن أمثالها سعلا % % 47(@)(@@) % وقد فككت عن الأسرى وثاقهم % وليس يرجون تلجاء ولا دخلا % % 48(@)(@@) % وقد تنقذتهم من قعر مظلمة % إذا الجبان رأى أمثالها زحلا % % 49(@)(@@) % فهم فداؤك ، إذ يبكون كلهم % ولا يرون هم جاها ولا نفلا % % 50(@)(@@) % ما في معد فتى يغني رباعته % إذا يهم بأمر صالح عملا % % PageV01P222 51(@)(@@) % ألواهب المائة الجرجور ، سائقها % % تنزو يرابيع متنيه ، إذا انتقلا % % 52(@)(@@) % إن ربيعة لن تنفك صالحة % ما أخر الله عن حوبائك الأجلا % % 53(@)(@@) % أغر لا يحسب الدنيا تخلده % ولا يقول لشيء فات ما فعلا % % PageV01P223 البحر : طويل 1(@)(@@) % أليس ورائي ، إن بلاد تنكرت % سويد بن منجوف وبكر بن وائل % 2(@)(@@) % وتلك بيوت ، لا تنال فروعها % % طوال أعاليها ، شداد الأسافل % PageV01P224 البحر : وافر تام 1(@)(@@) % قفا يا صاحبي بنا ألما % % على دمن نسائلها سؤالا % % 2(@)(@@) % قفا زورا منازل أم عمرو % % ورسما بالمنازل قد أحالا % % 3(@)(@@) % أهاضيب الدجى من كل جون % سقاها بعد ساكنها سجالا % % 4(@)(@@) % فكم من وابل يأتي عليها % % يلث بها ويحتفل احتفالا % % 5(@)(@@) % فدار الحي خالية قليل % بها الأصوات إلا أن تخالا % % 6(@)(@@) % كأن ترابها من نسج ريح % طحين لم يدعن له نخالا % % 7(@)(@@) % ألا يا أيها الزور المحيا % % أتسلم بالوصال نعمت بالا % % 8(@)(@@) % ليالي ما تزال من أم عمرو % ترى في كل منزلة خيالا % % 9(@)(@@) % فحقا أن جيرتنا يقينا % كما زعموا يريدون احتمالا % % 10(@)(@@) % يفجعني بفرقتهم رجال % أرادوا أن يزيدوني خبالا % % PageV01P225 11(@)(@@) % عرفت 