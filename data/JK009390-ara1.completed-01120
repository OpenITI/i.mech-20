ms1112	 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9768 ) قال النبي :(@)(@@) | 30 ( الأزذ مني وأنا منهم ، أغضب لهم إذا غضبوا ، وأرضى لهم إذا رضوا ) )(@)(@@) أبو نعيم ( طب ) عن بشر بن عصمة ويقال : ابن عطية الليثي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9769 ) قال النبي :(@)(@@) | 30 ( الاستئناس يتكلم الرجل بتسبيحة وتكبيرة ويتنحنح يؤذن أهل البيت ) )(@)(@@) ( ه طب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9770 ) قال النبي :(@)(@@) | 30 ( الاستنجاء ثلاثة أحجار ليس فيهن رجيع ) )(@)(@@) ( طب ) عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9771 ) قال النبي :(@)(@@) | 30 ( الاستنجاء بثلاثة أحجار وبالتراب إذا لم يجد حجرا ، ولا يستنجي بشيء قد استنجى به مرة ) )(@)(@@) ( عق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9772 ) قال النبي :(@)(@@) | 30 ( الأسوكة ثلاثة : الأراك ، فإن لم يكن أراك فعنم أو بطم ) )(@)(@@) أبو نعيم في كتاب السواك عن أبي زيد الغافقي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9773 ) قال النبي :(@)(@@) | 30 ( الإسلام أن تسلم وجهك لله عز وجل ، وأن تشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، وتقيم الصلاة ، وتؤتي الزكاة ، وتصوم شهر رمضان ، وتحج البيت إن استطعت إليه سبيلا ، فإذا فعلت ذالك فقد أسلمت ) )(@)(@@) ( حم ك بز ) عن ابن عباس ( حم ) عن أبي عامر أو أبي مالك ( بز ) عن أنس ، ابن عساكر عن عبد الرحمان بن غنم رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 9774 ) قال النبي :(@)(@@) | 30 ( الإسلام أن تشهد أن لا إلاه إلا الله وأن محمدا رسول PageV03P456 الله ، وأن تقيم الصلاة وتؤتي الزكاة وتحج وتعت مر وتغتسل من الجنابة وأن تتم الوضوء وتصوم رمضان ) )(@)(@@) ( حب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9775 ) قال النبي :(@)(@@) | 30 ( الإسلام شهادة أن لا إلاه إلا الله وأني رسول الله ، وتؤمن بالأقدار خيرها وشرها ) )(@)(@@) ( بز ) عن عدي بن حاتم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9776 ) قال النبي :(@)(@@) | 30 ( الإسلام بيت واسع ، فمن دخله وسعه ، والهجرة بيت واسع فمن دخله وسعه ، ومن دعي إلى الإسلام فأسلم ، ودعي إلى الهجرة فهاجر لم يدع للخير مطلبا ولا للشر مهربا ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9777 ) قال النبي 
ms1113	 :(@)(@@) | 30 ( الإسلام ثلاثة أبيات : سفلى وعليا وغرفة ، فأما السفلى فالإسلام دخل فيه عامة المسلمين ، فلا تسأل أحدا منهم إلا قال أنا مسلم ، وأما العليا فتفاضل أعمالهم ، بعض المسلمين أفضل من بعض ، وأما الغرفة العليا فالجهاد في سبيل الله لا ينالها إلا أفضلهم ) )(@)(@@) ( طب ) عن فضالة بن عبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9778 ) قال النبي :(@)(@@) | 30 ( الإسلام عريان فلباسه الحياء وزينته الوفاء ، ومروءته العمل الصالح ، وعماده الورع ، ولكل شيء أساس ، وأساس الإسلام حب أصحاب رسول الله وحب أهل بيته ) )(@)(@@) ابن النجار عن الحسن بن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9779 ) قال النبي :(@)(@@) | 30 ( الإسلام أن تعبد الله ولا تشرك به شيئا ، وتقيم الصلاة ، وتؤتي الزكاة ، وتصوم وتحج ، والأمر بالمعروف والنهي عن المنكر ، وتسليمك على أهلك ، فمن انتقص شيئا منهن فهو سهم من الإسلام يدعه ، ومن تركهن فقد ولى الإسلام ظهره ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV03P457(@)(@@)(@@)(@@) $ ( 9780 ) قال النبي :(@)(@@) | 30 ( الإسلام حسن الخلق ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9781 ) قال النبي :(@)(@@) | 30 ( الإسلام والسلطان أخوان توأمان ، لا يصلح واحد منهما إلا بصاحبه ، فالإسلام أس ، والسلطان حارس ، و ما لا أس له يهدم ، وما لا حارس له ضائع ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9782 ) قال النبي :(@)(@@) | 30 ( الإسلام ثمانية أسهم ، الإسلام سهم ، والصلاة سهم ، والزكاة سهم ، وحج البيت سهم ، والجهاد في سبيل الله سهم ، وصوم رمضان سهم ، والأمر بالمعروف سهم ، والنهي عن المنكر سهم ، وقد خاب من لا سهم له ) )(@)(@@) ( ط ز ) عن حذيفة وحسن ( ع قط ) في الأفراد والرافعي عن علي رضي الله عنه وضعفه .(@)(@@)(@@)(@@) $ ( 9783 ) قال النبي :(@)(@@) | 30 ( الإسلام علانية والإيمان في القلب ، التقوى هاهنا ، التقوى هاهنا ، وأشار بيده إلى صدره ) )(@)(@@) ( حم بز ع ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9784 ) قال النبي :(@)(@@) | 30 ( الإسلام ثلائمائة شريعة وثلاثة عشر شريعة ، ليس منها شريعة يلقى بها صاحبها إلا وهو يدخل بها الجنة ) )(@)(@@) ( طب طس ) عن ابن عباس رضي الله عنهمتا وضعف .(@)(@@)(@@)(@@) $ ( 9785 ) قال النبي :(@)(@@) | 30 ( الإسلام أن يسلم قلبك 
ms1114	 وأن يسلم المسلمون من لسانك ويدك ، قيل : فأي الإسلام أفضل ؟ قال : الإيمان ، قيل : وما الإيمان ؟ قال : أن تؤمن بالله وملائكته وكتبه ورسله والبعث بعد الموت ، قيل : فأي الإيمان أفضل ؟ قال : الهجرة ، قيل : وما الهجرة ؟ قال : أن تهجر السوء ، قيل : فأي الهجرة أفضل ؟ قال : الجهاد ، قيل : وما الجهاد ؟ قال : أن تقاتل الكفار PageV03P458 إذا لقيتهم ، قيل : فأي الجهاد أفضل ؟ قال : من عقر جواده واهريق دمه ، ثم عملان هما أفضل الأعمال إلا من عمل بمثلهما : حجة مبرورة وعمرة ) )(@)(@@) ( حم طب ) عن عمرو بن عبسة رضي الله عنه ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 9786 ) قال النبي :(@)(@@) | 30 ( الأشرار بعد الأخيار خمسين ومائة سنة يملكون جميع أهل الدنيا وهم الترك ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9787 ) قال النبي :(@)(@@) | 30 ( الأشربة من خمس : من الحنطة والشعير والتمر والزبيب والعسل ، فما خمر فهو خمر ) )(@)(@@) الحكيم عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9788 ) قال النبي :(@)(@@) | 30 ( الأصم شريك فإن سمع وإلا فأسمعوه ) )(@)(@@) الديلمي عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9789 ) قال النبي :(@)(@@) | 30 ( الأضاحي سنة أبيكم إبراهيم بكل شعرة حسنة ، وبكل شعرة من الصوف حسنة ) )(@)(@@) ( ك ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9790 ) قال النبي :(@)(@@) | 30 ( الإضرار في الوصية من الكبائر ) )(@)(@@) ابن جرير وابن أبي حاتم عن ابن عباس رضي الله عنهما وصحح ( هق ) وقفه .(@)(@@)(@@)(@@) $ ( 9791 ) قال النبي :(@)(@@) | 30 ( الأعمال ستة والناس أربعة فموجبتان ومثل بمثل وحسنة بعشر أمثالها وحسنة بسبعمائة ضعف ، فأما الموجبتان : فمن مات لا يشرك بالله شيئا دخل الجنة ، ومن مات يشرك بالله شيئا دخل النار ، وأما مثل بمثل : فمن هم بحسنة حتى يشعرها قلبه ويعلمها الله منه كتبت له حسنة ، ومن عمل سيئة كتبت عليه سيئة ، ومن عمل حسنة فبعشر أمثالها ، ومن أنفق نفقة في سبيل الله فحسنة بسبعمائة ، وأما الناس : فموسع عليه في الدنيا موسع عليه في الآخرة ، ومقتور عليه PageV03P459 في الدنيا موسع عليه في الآخرة ، وموسع عليه في الدنيا مقتور عليه في الآخرة ، وشقي في الدنيا والآخرة ) )(@)(@@) ( حم حب طب 
ms1115	 ) و الباوردي ( ك حل عب ) عن حزيم بن فاتك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9792 ) قال النبي :(@)(@@) | 30 ( الأعمال عند الله سبعة : عملان موجبان ، وعملان بأمثالهما ، وعمل بعشر أمثاله ، وعمل بسبعمائة ، وعمل لا يعلم ثوابه إلا الله تعالى ، فأما الموجبان : فمن لقي الله يعبده مخلصا لا يشرك به شيئا وجبت له الجنة ، ومن لقي الله قد أشرك به وجبت له النار ، ومن عمل سيئة جزي بمثلها ، ومن هم بحسنة جزي بمثلها ، ومن عمل حسنة جزي عشرا ، ومن أنفق ماله في سبيل الله ضعف له نفقة الدرهم بسبعمائة ، والدينار بسبعمائة دينار ، والصيام لله تعالى لا يعلم ثواب عامله إلا الله ) )(@)(@@) الحكيم ( هب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9793 ) قال النبي :(@)(@@) | 30 ( الأكثرون هم الأسفلون يوم القيامة ، إلا من قال هاكذا وهاكذا وهاكذا ) )(@)(@@) ( د ) هناد ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9794 ) قال النبي :(@)(@@) | 30 ( الالتفاع لبسة أهل الإيمان ، والرداء لبسة العرب ) )(@)(@@) الحكيم ( طب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9795 ) قال النبي :(@)(@@) | 30 ( الإمارة باب عنت إلا من رحمه الله ) )(@)(@@) ( ش ) عن خيثمة مرسلا .(@)(@@)(@@)(@@) $ ( 9796 ) قال النبي :(@)(@@) | 30 ( الإمام ضامن والمؤذن مؤتمن ، اللهم أرشد الأئمة واعف عن المؤذنين ) )(@)(@@) أبو الشيخ في الأذان عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9797 ) قال النبي :(@)(@@) | 30 ( الأمارات خرزات منظومات بسلك ، فإذا انقطع السلك تبع بعضه بعضا ) )(@)(@@) ( ك ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9798 ) قال النبي :(@)(@@) | 30 ( الإمام أمير ، فإذا صلى قاعدا فصلوا قعودا ) )(@)(@@) الشيرازي في الألقاب والديلمي عن أبي هريرة رضي الله عنه .(@)(@@) PageV03P460(@)(@@)(@@)(@@) $ ( 9799 ) قال النبي :(@)(@@) | 30 ( الإمام العادل لا ترد دعوته ) )(@)(@@) ( ش ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9800 ) قال النبي :(@)(@@) | 30 ( الإمام جنة فإن أتم فلكم وله وإن نقص فعليه النقصان ولكم التمام ) )(@)(@@) الباوردي ( طب ) عن أبي شريح العدوي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9801 ) قال النبي :(@)(@@) | 30 ( الإمام ضامن فما صنع فاصنعوا ) )(@)(@@) ( قط هق ) في القراءة ( طس ) و الخطيب ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9802 ) قال النبي :(@)(@@) | 30 ( الإمام ضامن والمؤذن مؤتمن فأرشد الله 
ms1116	 الإمام وعفا عن المؤذنين ) )(@)(@@) ( حم طب حب هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 9803 ) قال النبي :(@)(@@) | 30 ( الإمام ضامن والمؤذن أمين ، أرشد الله الأئمة وأعان المؤذنين ) )(@)(@@) ( حل ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9804 ) قال النبي :(@)(@@) | 30 ( الإمام ضامن والمؤذن مؤتمن ، اللهم اغفر للمؤذنين واهد الأئمة ) )(@)(@@) أبو الشيخ ( طب ) عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9805 ) قال النبي :(@)(@@) | 30 ( الأمانة عز ) )(@)(@@) الديلمي عن ثوبان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9806 ) قال النبي :(@)(@@) | 30 ( الأمراء من قريش ، الأمراء من قريش ، الأمراء من قريش ، لكم عليهم حق ، ولهم عليكم حق ما فعلوا ثلاثا : ما حكموا فعدلوا ، واسترحموا فرحموا ، وعاهدوا فوقوا ، فمن لم يفعل ذالك منهم فعليه لعنة الله والملائكة والناس أجمعين ) )(@)(@@) ( حم ع ) عن أبي برزة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9807 ) قال النبي :(@)(@@) | 30 ( الأمير إمام فإن صلى قاعدا فصلوا قعودا ، وإن صلى قائما فصلوا قياما ) )(@)(@@) ( عب ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV03P461(@)(@@)(@@)(@@) $ ( 9808 ) قال النبي :(@)(@@) | 30 ( الأناة في كل شيء خير إلا في ثلاث : إذا صيح في خيل الله فكونوا أول من يشخص ، وإذا نودي للصلاة فكونوا في أول من يخرج ، وإذا كانت الجنازة فعجلوا بها ، ثم الأناة بعد خير ) )(@)(@@) العسكري في الأمثال عن نفيع الحارثي عن مشيخته من قومه .(@)(@@)(@@)(@@) $ ( 9809 ) قال النبي :(@)(@@) | 30 ( الأناة خير إلا في العمل الصالح ) )(@)(@@) العسكري عن جابر بن محمد رضي الله عنه معضلا .(@)(@@)(@@)(@@) $ ( 9810 ) قال النبي :(@)(@@) | 30 ( الأنبياء كلهم يدخلون الجنة قبل سليمان بن داود بأربعين عاما ، وإن فقراء المسلمين يدخلون الجنة قبل أغنيائهم بأربعين عاما ، وإن صالح العبيد يدخلون الجنة قبل الآخرين بأربعين عاما ، وإن أهل المدن يدخلون الجنة قبل أهل الرستاق بأربعين عاما لفضل المدائن والجماعات والجمعات وحلق الذكر ، وإن كان بلاء خصوا به دونهم ) )(@)(@@) ( طب ) عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9811 ) قال النبي :(@)(@@) | 30 ( الأنبياء إخوة لعلات ، أمهاتهم شتى ودينهم واحد ، وإني أولى الناس بعيسى بن مريم لأنه لم يكن بيني وبينه نبي ، وإنه نازل فإذا رأيتموه فاعرفوه : رجل مربوع إلى الحمرة والبياض ، عليه ثوبان ممصران 
ms1117	 رأسه يقطر وإن لم يصبه بلل ، فيدق الصليب ويقتل الخنزير ، ويضع الجزية ، ويدعو الناس إلى الإسلام ، فيهلك في زمانه الملل كلها إلا الإسلام ، وترتع الأسود مع الإبل ، والنمار مع البقر ، والذئاب مع الغننم ، وتلعب الصبيان بالحيات فلا تضرهم فيمكث في الأرض أربعين سنة ثم يتوفى ويصلي عليه المسلمون ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9812 ) قال النبي :(@)(@@) | 30 ( الأنبياء تنام أعينهم ولا تنام قلوبهم ) )(@)(@@) الديلمي عن PageV03P462 أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9813 ) قال النبي :(@)(@@) | 30 ( الأنبياء قادة والفقهاء سادة ومجالستهم زيادة ، وأنتم في ممر الليل والنهار ، في آجال منقوصة ، وأعمال محفوظة ، والموت يأتيكم بغتة ، فمن زرع خيرا يحصد رغبة ، ومن زرع شرا يحصد ندامة ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9814 ) قال النبي :(@)(@@) | 30 ( الأنصار ومزينة كرشي وعيبتي ، هم الشعار والناس الدثار ) )(@)(@@) العسكري في الأمثال عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9815 ) قال النبي :(@)(@@) | 30 ( الأنصار شعار والناس دثار ، ولولا الهجرة لكنت امرأ من الأنصار ) )(@)(@@) ( ع ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9816 ) قال النبي :(@)(@@) | 30 ( الأنصار لا يحبهم إلا مؤمن ولا يبغضهم إلا منافق ، ومن أحبهم أحبه الله ، ومن أبغضهم أبغضه الله ) )(@)(@@) ( ش ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9817 ) قال النبي :(@)(@@) | 30 ( الأنصار آية المؤمنين وآية المنافق ، لا يحبهم ألا مؤمن ، ولا يبغضهم إلا منافق ) )(@)(@@) ( ط ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9818 ) قال النبي :(@)(@@) | 30 ( الأنصار أعفة صبر ، وإن الناس تبع لقريش في هاذا الشأن ، مؤمنهم تبع لمؤمنهم ، وفاجرهم تبع لفاجرهم ) )(@)(@@) ابن جرير ( كر ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9819 ) قال النبي :(@)(@@) | 30 ( الأواه الخاشع المتضرع ) )(@)(@@) ابن جرير عن عبد الله بن شداد بن الهاد مرسلا .(@)(@@)(@@)(@@) $ ( 9820 ) قال النبي :(@)(@@) | 30 ( لأواب الذي يذكر ذنوبه في الخلاء فيستعفر الله ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9821 ) قال النبي :(@)(@@) | 30 ( الأيام البيض : ثلاثة أيام من كل شهر ) )(@)(@@) ( طب ) عن PageV03P463 ابن عمر رضي الله عنهما أن رجلا سأل النبي عن الصيام قال فذكره .(@)(@@)(@@)(@@) $ ( 9822 ) قال النبي :(@)(@@) | 30 ( الأيدي ثلاثة : فيد الله 
ms1118	 عز وجل هي العليا ، ويد المعطي هي التي تليها ، ويد السائل هي السفلى إلى يوم القيامة ، فاستعف عن السؤال ما استطعت ) )(@)(@@) ( حم ) و العسكري في الأمثال وابن جرير في تهذيبه ( ك حل ) .(@)(@@)(@@)(@@) $ ( 9823 ) قال النبي :(@)(@@) | 30 ( الأيدي ثلاثة : فيد الله العليا ، ويد المعطي التي تليها ، ويد السائل أسفل إلى يوم القيامة ، فاستعفوا عن السؤال ما استطعتم ، ومن أعطاه الله خيرا فلير عليه ، وابدأ بمن تعول ، وارتضخ من الفضل ولا تلام على كفاف ، ولا تعجز عن نفسك ) )(@)(@@) ( هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9824 ) قال النبي :(@)(@@) | 30 ( الأيدي ثلاثة : يد الله العليا ، ويد المعطي الوسطى ، ويد المعطى السفلى ) )(@)(@@) ابن جرير في تهذيبه عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9825 ) قال النبي :(@)(@@) | 30 ( الإيمان أن تؤمن بالله وملائكته والكتاب والنبيين وتؤمن بالقدر ) )(@)(@@) ( ن ) عن أبي هريرة وأبي ذر رضي الله عنهما معا .(@)(@@)(@@)(@@) $ ( 9826 ) قال النبي :(@)(@@) | 30 ( الإيمان أن تؤمن بالله واليوم الآخر والملائكة والكتاب والنبيين والموت والحياة بعد الموت وتؤمن بالجنة والنار والحساب والميزان ، وتؤمن بالقدر كله خيره وشره ، فإذا فعلت ذالك فقد آمنت ) )(@)(@@) ( حم بز ) عن ابن عباس ( حم ) عن أبي عامر أو أبي مالك ( ز ) عن أنس ابن عساكر عن عبد الرحمان بن غنم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9827 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان إلى لخم وجذام ) )(@)(@@) ( حم ض ) عن PageV03P464 أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9828 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان حتى جبال جذام وبارك الله في جذام ) )(@)(@@) ابن عساكر عن روح بن زنباع مرسلا .(@)(@@)(@@)(@@) $ ( 9829 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان والحكمة يمانية ، ورحى الإسلام دائرة فيما ولد قحطان ، والجفوة والقسوة فيما ولد عدنان ، حمير رأس العرب ونابها ، ومذحج هامتها وعصمتها وأزد كاهلها وجمجمتها ، وهمدان غاربها وذروتها ، والأنصار مني وأنا منهم ، اللهم اغفر للأنصار ولأبناء الأنصار ، اللهم أعز غسان أكرم العرب في الجاهلية ، وأفضل الناس في الإسلام بقية من كان يؤمن بالله واليوم الآخر فليكرم الأنصار ، وآزروني ونصروني وحموني هم شيعتي وأصحابي وأول من يدخل بحبوحة الجنة من أمتي ) )(@)(@@) الرامهرمزي ( خط 
ms1119	 كر ) والديلمي عن عثمان رضي الله عنه ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 9830 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان هاكذا إلى لخم وجذام ، والجفاء في هاذين الحيين ربيعة ومضر ) )(@)(@@) ابن عساكر عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 9831 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان والحكمة يمانية في هاذين الحيين من لخم وجذام ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9832 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان إلى لخم وجذام ، إلا أن الكفر وقسوة القلوب في هاذين الحيين من ربيعة ومضر ) )(@)(@@) ابن عساكر عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9833 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان في جندس وجذام ) )(@)(@@) ( طب ) عن عبد الله بن عوف رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9834 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان والحكمة هاهنا إلى لخم وجذام ) )(@)(@@) ( طب ) عن أبي كبشة رضي الله عنه .(@)(@@) PageV03P465(@)(@@)(@@)(@@) $ ( 9835 ) قال النبي :(@)(@@) | 30 ( الإيمان في قلب الرجل أن يحب الله عز وجل ) )(@)(@@) الديلمي وابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9836 ) قال النبي :(@)(@@) | 30 ( الإيمان عريان وزينته الحياء ولباسه التقوى ، وماله الفقه ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه الخرائطي في مكارم الأخلاق عن وهب بن منبه رضي الله عنه موقوفا .(@)(@@)(@@)(@@) $ ( 9837 ) قال النبي :(@)(@@) | 30 ( الإيمان إلى لخم وجذام صلوات الله على جذام يقاتلون الكفار على رؤوس الشعف ينصرون الله ورسوله ) )(@)(@@) الشيرازي في الألقاب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9838 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان ومضر عند أذناب الإبل ) )(@)(@@) ( طب ) عن ابن مسعود ( طب ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9839 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان وهم مني وإلي وإن بعد منهم المربع ، ويوشك أن يأتوكم أنصارا وأعوانا فآمركم بهم خيرا ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9840 ) قال النبي :(@)(@@) | 30 ( الإيمان يمان إلى لخم وجذام وعاملة ، ومأكول حمير من أكلها ، وحضرموت خير من بني الحارث لا قيل ولا قاهر ولا ملك إلا الله ، إن الله تعالى أمرني أن ألعن قريشا فلعنتهم مرتين ، ثم أمرني أن أصلي عليهم مرتين فكانت عليهم مرتين ، وأكثر القبائل في الجنة مذحج 
ms1120	 وأسلم وغفار ومزينة وأخلاطهم من جهينة خير من بني أسد ، وتميم وهوازن وغطفان عند الله يوم القيامة ، وإني أبالي أن يهلك الحيان كلاهما ، وأمرني أن ألعن قبيلتين تميم بن مرة سبعا فلعنتهم ، وبكر بن وائل خمسا ، وبنو عصية عصت الله ورسوله ، قبيلتان لا يدخل الجنة منهم أحد أبدا : مناعس وملاوس ) )(@)(@@) ( طب ) عن عمرو بن عبسة رضي الله عنه .(@)(@@) PageV03P466(@)(@@)(@@)(@@) $ ( 9841 ) قال النبي :(@)(@@) | 30 ( الإيمان أن تشهد أن لا إلاه إلا الله وحده لا شريك له وأن محمدا عبده ورسوله ، وأن يكون الله ورسوله أحب إليك مما سواهما ، وأن تحرق في النار أحب إليك من أن تشرك بالله ، وأن تحب غير ذي نسب لا تحبه إلا لله عز وجل ، فإذا كنت كذالك فقد دخل حب الإيمان في قلبك كما دخل حب الماء للظمآن في اليوم القائظ ، ما من أمتي عبد يعمل حسنة فيعلم أنها حسنة وأن الله جازيه بها خيرا ، ولا يعمل سيئة فيعلم أنها سيئة ويستغفر الله منها ويعلم أنه لا يغفر إلا هو إلا وهو مؤمن ) )(@)(@@) ( حم ) عن أبي رزين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9842 ) قال النبي :(@)(@@) | 30 ( الإيمان ثابت في القلب واليقين خطوات ) )(@)(@@) الديلمي عن داود بن سعد الأنصاري عن أبيه .(@)(@@)(@@)(@@) $ ( 9843 ) قال النبي :(@)(@@) | 30 ( الإيمان عريان ولباسه التقوى وزينته الحياء ، وماله الفقه ، وثمرته العلم ) )(@)(@@) الديلمي عن ابن مسعود مرفوعا الديلمي عن أبي هريرة رضي الله عنهما موقوفا .(@)(@@)(@@)(@@) $ ( 9844 ) قال النبي :(@)(@@) | 30 ( الإيمان والعمل شريكان في قرن لا يقبل الله تعالى أحدهما إلا بصاحبه ) )(@)(@@) ( ك ) في تاريخه و الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9845 ) قال النبي :(@)(@@) | 30 ( الإيمان قول وعمل يزيد وينقص ) )(@)(@@) ابن النجار عن عبد الله بن أبي أوفى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9846 ) قال النبي :(@)(@@) | 30 ( الإيمان الصلاة ، فمن فرغ لها قلبه ، وحافظ عليها بحدها ووقتها وسنتها فهو مؤمن ) )(@)(@@) ابن النجار عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 9847 ) قال النبي :(@)(@@) | 30 ( الإيمان ثلائمائة وثلاثون شريعة من وافى بشريعة منهن دخل الجنة ) )(@)(@@) ( طس طب هب ) و ابن النجار 