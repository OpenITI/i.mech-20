ms281	 جناني % % PageV01P1090 البحر : طويل 1(@)(@@) % ألا إن وحي الله في كل كائن % من الصخر والأشجار والحيوان % 2(@)(@@) % وفي عالم الأركان في كل حالة % وفي أنفس الأفلاك والملوان % 3(@)(@@) % وقد نزلت أملاكه من مقامها % % ليلقاه منها بالتقى الثقلان % % PageV01P1091 البحر : وافر تام 1(@)(@@) % يمين المؤمن الركن اليماني % % أبايعه لأحظى بالأماني % % 2(@)(@@) % يمين ما لها حجب تعالت % عن الحجاب والحجب المثاني % % 3(@)(@@) % أمنت بلثمها من كل سوء % يصيرني إلى دار الهوان % 4(@)(@@) % فأنعم بالكثيب وساكنيه % على مرأى من الحور الحسان % 5(@)(@@) % تنادي من أريكتها تأمل % جمالا ما له في الحسن ثاني % % 6(@)(@@) % فليس الزهد في الأكوان شيا % % لأن الكون من سر العيان % 7(@)(@@) % فلا ألوي ولا أرعيه سمعي % % فأعجب بالمعان عن المعاني % % PageV01P1092 البحر : بسيط تام 1(@)(@@) % ألبست زينب ثوب الفضل والدين % من يد من هو مسكين ابن مسكين % 2(@)(@@) % هو الفقير الذي قد باع متجرا % أضلاله بالهدى لله والدين % 3(@)(@@) % على التخلق بالأسماء أجمعها % % أسماء ديان يوم الفصل والدين % 4(@)(@@) % وأعكف على كل خير أنت فاعله % % فإنما الخير في التشريع بالدين % PageV01P1093 البحر : طويل 1(@)(@@) % رأيت الذي لا بد لي منه جهرة % ولم يك إلا ما رأيت من الكون % 2(@)(@@) % ولكنه منه على ما رأيته % % كإنسان عين الشخص فيه من العين % 3(@)(@@) % ويأتي على ما يأتي للفصل والقضا % % وقد كان قبل الخلق في ذلك العين % % 4(@)(@@) % إذا المرء لم يعرف بسمع ولا بدا % % لعين أتاه إلا من بالحفظ والصون % % 5(@)(@@) % فرضنا له عين الكمال لأنه % % إذا كان في الأحجار فيها من العين % 6(@)(@@) % إذا شاء أن يروي من الماء مرتو % فلا يشرب إلا ما يكون من العين % 7(@)(@@) % فذاك له مثل الرضاع لأنه % تولد منها عن فصال وعن بين % 8(@)(@@) % وما كان قولي إنه عين ما يرى % % من الكون إلا قوله لي بلا مين % 9(@)(@@) % ولما سألت الله عونا على الذي % % يكلفني من فرضه كان في عوني % % 10(@)(@@) % ويا عجبا إن المعين هو الذي % % يكون معانا رده شاهد البين % PageV01P1094 11(@)(@@) % ولو لم يكن في الغيب 
ms282	 عين لصورة % % 12(@)(@@) % تباعد عنها الشين والشين كونها % % فأنت ترى عينا وما ثم من شين % % 13(@)(@@) % إذا قال لي ما أنت إلا هويتي % % فأين الذي قال المنازع من بوني % % 14(@)(@@) % لقد حرت في أمري وإني لصادق % تقابل ألفاظ تترجم عن عيني % % 15(@)(@@) % وما عجبي عن واحد عنه واحد % كما قيل لكن من وحيد عن اثنين % % 16(@)(@@) % فلولاه لم أوجد ولولاي لم يكن % ولا بد لي في كون ذاتي من اثنين % % 17(@)(@@) % حقيقة ذاتي من حقيقة ذاته % ولا بد من ذاتي فلا بد من تين % % 18(@)(@@) % وإني من الأضداد في كل حالة % كما هو مثل الغر في اللون والجون % 19(@)(@@) % ومن ذا الذي قد قيل فيه مداين % وهل كان هذا الحكم إلا من الدين % 20(@)(@@) % لقد حجبت منا قلوب صقيلة % عن الكشف والتحقيق من حجب الرين % PageV01P1095 21(@)(@@) % لقد خالقوا في اللون وهو مشاهد % وأين شهيد الكون من شاهد اللون % 22(@)(@@) % لقد لنت للأقوام حتى كأنني % % عجزت عن التقييد من شدة اللين % % 23(@)(@@) % وقد جاء حكم الفال فيما علمتم % % وحاشاه مما تعرفون من الغين % 24(@)(@@) % كما قيل حداد لحاجب بابهم % % وقد قيل هذا اللفظ في العرف للقين % 25(@)(@@) % ولو كان في الداعي إلى الله غلظة % % لفروا ولكن جاء باللين والهين % PageV01P1096 البحر : طويل 1(@)(@@) % وقال أيضا : شؤونك يا مولاي قد حيرت سري % % وقولك بالتفريع أذهلني عني % % 2(@)(@@) % لأني لا أدري بماذا تجيبني % % مع العلم أن الأصل فيما أتى مني % % 3(@)(@@) % ووالله ما تجني علي وإنما % % نفوس الورى منها على نفسها تجني % % 4(@)(@@) % فلم أو فسلم فالأمور كما ترى % % وما هو عن حدس وما هو عن ظن % 5(@)(@@) % ولكنه علم صحيح محقق % أتين به الأرواح في ظلمة الدجن % % PageV01P1097 البحر : خفيف تام 1(@)(@@) % ما قرة العين غير عيني % % فبيني كان الهوى وبيني % % 2(@)(@@) % والله لولا وجود كوني % % ما لاح عيني لغير عيني % % 3(@)(@@) % فكونه ما رأيت فيه % أكمل من صورتي وكوني % % 4(@)(@@) % بالبين أوصلت كل بين % % فقام شكر البين بيني % % 5(@)(@@) % قد أحس الله في 
ms283	 وجودي % % عند أداء الفروض عوني % % 6(@)(@@) % أشهدني فيه علم ذاتي % % في هذه الدار قبل حيني % % 7(@)(@@) % لا فرق الله يا حبيبي % % ما بين أنفاسه وبيني % % PageV01P1098 البحر : طويل 1(@)(@@) % نهاني ودادي أن أبث سرائري % % إلى أحد غيري فمت بكتماني % % 2(@)(@@) % نبابي زمان عز عندي وجوده % % وقد كان مشهودي لمشهد إحساني % % 3(@)(@@) % نزلت إلى الأمر الدني وكان لي % % علو الذي أعلى الإله به شاني % % 4(@)(@@) % نروم أمورا من زمان محكم % بتضعيف آرائي وتحليل أركاني % % 5(@)(@@) % نرى فيه ربي عين دهري وموجدي % % بتوحيد إسلام عميم وإيمان % 6(@)(@@) % نموت ونحيى حكم دهري بنشأتي % % ولم آت فيما قلت فيه ببهتان % 7(@)(@@) % نسميه بالدهر العظيم لأنه % به قد تسمى لي بأوضح تبيان % 8(@)(@@) % نمت إليه بالوداد فعله % % يجود على أهل الوجود بطوفان % 9(@)(@@) % نعيش به لما تألم باطني % % بما أشعل التبريح من نار تركاني % % 10(@)(@@) % نحت نحوه سبحانه من وجودنا % % خواطر إيماء بتقويض بنيان % PageV01P1099 البحر : بسيط تام 1(@)(@@) % إني لأهوى الهدى والهدى يهواني % % فما أرى من هدى إلا تمناني % % 2(@)(@@) % اللطف من كرمي والعطف من شيمي % % والمنع منعي كما الإحسان إحساني % % 3(@)(@@) % وما منعت الذي منعت من بخل % منعي عطاء فمنعي جود محسان % 4(@)(@@) % والله لو بسطت أرزاقه لبغت % طوائف وعلى ذا قام بنياني % % 5(@)(@@) % وزني صحيح فإني عادل حكم % بالله وزني لهذا صح ميزاني % % 6(@)(@@) % إني لمن أصل أجواد ذوي حسب % العم من طيء والخال خولاني % % 7(@)(@@) % وإن لي نسب التقوى يحققه % % إحسان عقدي بإسلامي وإيماني % % 8(@)(@@) % كذاك لي نسب بالله متصل % يقول أهل النهى به علا شأني % % PageV01P1100 البحر : كامل تام 1(@)(@@) % ذكرى إلهي ليس عن نسيان % لكن عبادة منعم محسان % 2(@)(@@) % إني على نفسي مننت بذكره % وكذاك فعل محقق إنسان % % 3(@)(@@) % إن الرجال لهم شباب زمانة % % كالشمس في حمل وفي نيسان % % 4(@)(@@) % الله قواهم على تكليفه % إياهم في دولة الميزان % % 5(@)(@@) % بعناية الندب الكريم المصطفى % % خي الخلائق من بني عدنان % 6(@)(@@) % لما سمعت به سلكت سبيله % وكفرت بالطاغوت والطغيان % % 7(@)(@@) % عقدا وإيمانا فإن وجوده 
ms284	 % % في عينها بشهادة الإحسان % % 8(@)(@@) % وبذا قضى أن لا تكون عباده % الإله في محكم القرآن % 9(@)(@@) % فورثته قولا وعلما والذي % % كلفت من عمل ومن إيمان % % 10(@)(@@) % حفظ المهيمن دينه بقواعد % خمس لما فيه من السلطان % % PageV01P1101 البحر : كامل تام 1(@)(@@) % لما تعدى حفظه أعيانها % % حفظا إلهيا إلى الجيران % 2(@)(@@) % فبنيت إسلامي عليها محكما % أركانه فيحل من بنياني % % 3(@)(@@) % الله كرمنا بدولة أحمد % كرما يعم شرائع الإحسان % 4(@)(@@) % شهدت بذلك نيتي وطويتي % % وإن امترى في ذلك الثقلان % % 5(@)(@@) % لما سرى سر الوجود بجوده % % في عالم الأرواح والأبدان % 6(@)(@@) % شهدت حقائقه بأن وجوده % % قد عمنا في الحكم والأعيان % 7(@)(@@) % لما التفت بناظري لم أطلع % % إلا إليه فإنه بعياني % % 8(@)(@@) % لو كان ثم سواه كنت مقسما % بين الإله وعالم الأكوان % 9(@)(@@) % فانظر لما تحوي عليه قصيدتي % % من كل علم قام عن برهان % 10(@)(@@) % لو أن رسطاليس أو أفلاطنا % % في عصرنا لأقر بالحرمان % PageV01P1102 11(@)(@@) % من عدل الميزان يعرف قولنا % % ويقر بالنقصان والخسران % % 12(@)(@@) % لا تخسروا الميزان إن عقولكم % % دون الذي أعنيه في الرجحان % 13(@)(@@) % إقرأ كتاب الله فاتحة الهدى % % فجميع ما يحويه في العنوان % 14(@)(@@) % إن الإله الحق أعلم كونها % % عين الصلاة وإنها قسمان % % 15(@)(@@) % لما قرأت كتابه في خلوة % معصومة من خاطر الشيطان % 16(@)(@@) % عاينت فيه معالما بدلائل % % لا يمتري في صدقها اثنان % 17(@)(@@) % لو أن عبد الفكر يشهد قوانا % % لم ينتطح في سرنا عنزان % % 18(@)(@@) % لكنهم لما تعبد فكرهم % % ألبابهم بعدوا عن الفرقان % % 19(@)(@@) % إن تتق الله الذي يجعل لك % % الفرقان بين الحق والبهتان % 20(@)(@@) % لو وفقوا ما لفقوا أقوال من % % لعبوا بهم كتلاعب الولدان % % PageV01P1103 21(@)(@@) % والكل في التحقيق أمر واحد % في أصله بالنص والبرهان % % 22(@)(@@) % نطقت بذلك ألسن معلومة % % بإصابة التحقيق في التبيان % % 23(@)(@@) % لو أنهم شهدوا الذي أشهدته % % ما قام في ألبابهم حكمان % % 24(@)(@@) % لعبت بهم أهواؤهم فهم لها % % عند اللبيب كسائر الحيوان % % 25(@)(@@) % إن النجاة لمن يقلد ربه % % فيما أتاه به وهم صنفان % 26(@)(@@) % صنف يراه شهود عين دائما % أو 
ms285	 في حجاب عنه وهو الثاني % % PageV01P1104 البحر : بسيط تام 1(@)(@@) % قل للشخص الذي بالحق يعرفني % % من كان يعرفني بالحق ينصفني % % 2(@)(@@) % ولست فيه بمعصوم وإن غلطت % ألفاظا فعلى التحقيق يوقفني % % 3(@)(@@) % فصاحبي من أراه في تقلبه % % في كل حال من الأحوال ينصحني % % 4(@)(@@) % في خلوة إن نصح الشخص في ملإ % % فضيحة وخليلي ليس يفضحني % % 5(@)(@@) % فالله يمنح ما أملت منه وما % % يعطيني إلا الذي في الوقت يصلحني % % 6(@)(@@) % نعم ويصلح بي فالنفس واثقة % به على كل ما يرضى وينفعني % % 7(@)(@@) % فإنه الله جل الله ذو كرم % المنع منه عطاء حين يمنعني % % 8(@)(@@) % المنع منه عطاء فيه منفعة % للعبد من حيث لا يدري ويحجبني % % 9(@)(@@) % عنه واعلم قطعا أنه ملك % % وإنني نائب عنه فيكرمني % % 10(@)(@@) % يرفع غاشية يقول مطرقا هذا % % هذا خليفتنا في السر والعلن % % PageV01P1105 11(@)(@@) % بروحه القدسي العال أيدني % % وبالظلال التي في الحر ظللني % % 12(@)(@@) % وجاءنا منه توقيع بأن لنا % % ختم الولاية والختمان في قرن % % 13(@)(@@) % روح لروح وتيجان مكللة % من النضار الذي الرحمن يزجرني % % 14(@)(@@) % عنها وعن حلل الديباج فاعتبروا % % فيما أتاكم به ذو المنطق الحسن % 15(@)(@@) % الواهب الألف والآلاف جائزة % % لكل طالب رفد أو لذي لسن % 16(@)(@@) % شبهت نفسي في عصري وحالتها % % بعصر سيدنا سيف بن ذي يزن % % 17(@)(@@) % لا علم لي بالذي في الغيب من عجب % ولست أدري بنعمان ولا المزني % % 18(@)(@@) % حتى رأيت الذي بالعلم بشرني % % والملك وهو مع الأنفاس يطلبني % % 19(@)(@@) % إن الذي قد دعاني في بشائره % % فلا يزال مع الأحيان يخطبني % % 20(@)(@@) % فقلت يا رب أما العلم أقبله % والملك لست أراه فهو يخدعني % % PageV01P1106 21(@)(@@) % إن كان عرضا فما لي فيه من أرب % أو كان أمرا فإن الأمر يطمعني % % 22(@)(@@) % في عصمة عصم الله الحفيظ بها % % نفسي فأعلم أن الله يحفظني % % 23(@)(@@) % إذا سمعت كلاما لا يوافقني % % منه أسلمه وليس يحفظني % % 24(@)(@@) % له التصرف في مولاه كيف يرى % % مولاه فهو له من أعصم الجنن % 25(@)(@@) % أجسام كل رسول مصطفى ندس % % له المكانة والزلفى بلا محن % 26 
ms286	(@)(@@) % أتى بمألكة من عند مرسله % % مبلغا بلسان القوم واللحن % % 27(@)(@@) % قد طهر الله نفسا منه زاكية % % من كل سوء كمثل الحقد والإحن % % PageV01P1107 البحر : مخلع البسيط 1(@)(@@) % أقول بالله لا بكوني % % فإنه بالدليل عيني % % 2(@)(@@) % إن الحدوث الذي لكوني % % قد حال ما بينه وبيني % % 3(@)(@@) % في نظر العقل لا بكشفي % % فالبين بيني والبين بيني % % 4(@)(@@) % إن دل أني له بغير % % فذاك لي إذ سألت عوني % % 5(@)(@@) % أو قلت إني له بعين % أكذبني صوته وصوني % % 6(@)(@@) % فالأمر بيني وبين حبي % % عليه نبني إن كنت تبني % % 7(@)(@@) % أثنيت يوما علي جهلا % فقال : أثني علي تثني % % 8(@)(@@) % فنيت عني به إليه % % وذاك ما لم يقم بظني % % 9(@)(@@) % وما جهلت الروي فيما % % نظمته فانظروه مني % % 10(@)(@@) % فما تراه من نظم قولي % % فليس شعرا خذوه عني % % PageV01P1108 11(@)(@@) % بل هو ما قال فيه ربي % % من ذكر جمع ببين كوني % % 12(@)(@@) % فكل ما في الوجود نظم % وليس شعرا والوزن وزني % % 13(@)(@@) % ليس الفراهيد لي إمام % أنا إمام له فإني % % 14(@)(@@) % في كل ما قلت من روي % علام وقتي فلا تثني % % 15(@)(@@) % في آل عمران إن نظرتم % بيت وفي توبة وثني % % 16(@)(@@) % بالحجر واعلم بأن قولي % % في كل ما قلت عنه يغني % % 17(@)(@@) % فالرقم مني والحق يملي % % فكل ما خط ليس مني % % PageV01P1109 البحر : طويل 1(@)(@@) % إذا كنت إنسانا فكن خير إنسان % فإن بخيل القوم ليس بمحسان % 2(@)(@@) % ولا تظهرن إن كنت تملك سترة % إل كل ذي عين بصورة عربان % 3(@)(@@) % وحقق إذا ما قلت قولا ولا تكن % تخلط صدق القول منك ببهتان % 4(@)(@@) % ولا تسرعن إن جاء يسأل سائل % ولا تبذر السمراء في أرض عيمان % 5(@)(@@) % وكن ذا لسان واحد وهو عينه % ولا تك من قوم بفيهم لسانان % % 6(@)(@@) % لسان بخلق وهو عضو معين % وليس يرى ذا العضو إلا لتبيان % 7(@)(@@) % ونطق بحق فهو بالصدق ناطق % تقسم قرآنا بتقسيم فرقان % % 8(@)(@@) % فيبدو لذاك القسم من كل وجهة % من العالم الأدنى إليك طريقان % 9(@)(@@) % طريق شكور أو كفور وما هما 
ms287	 % % فريقان بل هم بالتقاسم فرقان % 10(@)(@@) % فإن كنت عند القسم بالأمر عالما % فما ثم فرقان بوجه ولا ثان % PageV01P1110 11(@)(@@) % فما أنت بالتوحيد متحد به % فربحك خسران ونقصك رجحاني % % 12(@)(@@) % ولا تدخلن إن كنت طالب حكمة % حقيقة ما تبغيه كفه ميزان % 13(@)(@@) % قما وضع الميزان إلا بأرضه % هنا وبأرض الحشر والشان كالشان % % 14(@)(@@) % وما هو مطلوبي فذلك خارج % عن الحد والتقسيم فيه ببرهان % 15(@)(@@) % فليس وجود الخلق إلا بجوده % % وجود الإله الحق ليس بميزان % % 16(@)(@@) % يفيض الإله الحق عين عطائه % % وتقبله الأعيان من غير نقصان % 17(@)(@@) % فما ثم إلا كامل في طريقه % من أصحاب أفلاك وأصحاب أركان % % 18(@)(@@) % بهذا قد أعطى كل من كان خلقه % % كما قاله الرحمن في نص قرآن % % PageV01P1111 البحر : بسيط تام 1(@)(@@) % شكرت نعمة ربي حين أظهر لي % % وجه القبول وجازاني بإحسان % % 2(@)(@@) % لما تكلم فيه لم يجيء أحد % بمثل ما قلته فيه ببهتان % 3(@)(@@) % عند المخالف إلا رسله ولنا % % عن الكتاب وعن كشف وإيمان % 4(@)(@@) % الله يعلم أنى ما ذكرت لكم % % إلا الذي نصه عنه بقرآ ، % 5(@)(@@) % فعم عقد جميع الخلق كلهم % ما قاله وهو عقدي وهو برهاني % % 6(@)(@@) % إلا الشريك الذي بالجهل أثبته % من كان مسكنه بدار نيران % 7(@)(@@) % ناداني الحق لما أن علمت به % % خير الموازين بالبرهان ميزاني % % 8(@)(@@) % فزن به وهو قرآني وما نطقت % به التراجم عني فهو تبياني % % 9(@)(@@) % فزن به لا تزن بالعقل إن له % في الوزن تطفيفا أو نقصا بخسران % % PageV01P1112 البحر : مخلع البسيط 1(@)(@@) % إني وسعت الكيان طرا % لما وسعت الذي براني % % 2(@)(@@) % فكنت بيتا له مسوى % % مهيئا للذي بناني % % 3(@)(@@) % له فلم يرتضي سواي % أراه مثل الذي يراني % % 4(@)(@@) % مذ وسع الحق قلب كوني % % ما زلت في لذة العيان % 5(@)(@@) % أشهده فيه كل حين % ذا كرم مطلق العنان % 6(@)(@@) % في كل وصف تراه عيني % % على الذي وحيه أراني % % 7(@)(@@) % ما علم الله غير عبد % أضحى من السر في أمان % 8(@)(@@) % ليس لنا مشهد سواه % % أراه فيه ولا أراني % % 9(@)(@@) % أرنو 
ms288	 إليه بقدر علمي % % من غير أين ولا زمان % 10(@)(@@) % ولا ترى عينه سواي % % إلا إذا كان في الجنان % % PageV01P1113 11(@)(@@) % أو صار في حلبة المنايا % % قد سبق القوم للرهان % PageV01P1114 البحر : مخلع البسيط 1(@)(@@) % سبحان من لا أرى سواه % % في كل شيء تراه عيني % % 2(@)(@@) % وذاك فرق يراه عقلي % % ما بين معبوده وبيني % % 3(@)(@@) % فكلما قلت أنت ربي % % لبست بالسلب ثوب صوفي % % 4(@)(@@) % تنزيهه جده تعالى % % تشبيهه كونه بكوني % % 5(@)(@@) % طلبت بالشرع منه عونا % يا مدعي لا يكون عوني % % 6(@)(@@) % إلا لعبد له مجال % ولا مجال إلا لأيني % % 7(@)(@@) % وفي استوائي العقول تاهت % إذ حال ما بينها وبيني % % 8(@)(@@) % قد جاءنا الحق في التلقي % % بكل هين وكل لين % 9(@)(@@) % يا مرسلا إنني سميع % إن قمت لي فيه باثنتين % % 10(@)(@@) % ذات تعالت لها صفات % من كل حسن وكل زين % PageV01P1115 11(@)(@@) % إن رام تحصيلهن فكري % % بنيت بيتي بتبنتين % PageV01P1116 البحر : خفيف تام 1(@)(@@) % خاب ظني إن لم تكن عند ظني % % قل فمن لي يا منية المتمني % % 2(@)(@@) % والذي فات لا تعده علينا % % ومن الآن فلتكن عند ظني % % PageV01P1117 البحر : بسيط تام 1(@)(@@) % من وافق الحق في حكم وفي عمل % فإنه عمر الفاروق في الزمن % 2(@)(@@) % يا نائب الحق إن الحق أهلكم % % لما أقامك في ذا المنصب الحسن % 3(@)(@@) % فإن عدلت وقاك الله فتنته % وإن عدلت ابتلاك الله بالمحن % 4(@)(@@) % قرينه الحال تعطى ما أردت بما % % ضربته مثلا للهمهم الفطن % 5(@)(@@) % إني لسان صغار لي وعائلة % % وترجمانهم في السر والعلن % % 6(@)(@@) % قد أصبحوا مالهم ثوب يرد به % برد الهواء ولا فلس من الثمن % 7(@)(@@) % وما التمست سوى مرسوم سيدهم % % فإن منعتم فلا ثوب سوى الكفن % 8(@)(@@) % وإن ظني بكم في حقهم حسن % ولم يخب أحد في ظنه الحسن % % 9(@)(@@) % إن أجدب الوقت فاستسقاء صاحبه % % يزيله بانسكاب الوابل الهتن % 10(@)(@@) % فإنه رب إحسان ومأثرة % على المقلين بالآلاء والمنن % % PageV01P1118 البحر : سريع 1(@)(@@) % نتيجة عن واحد لا تكن % % ألا ترى لم يكن إلا بكن % % 2(@)(@@) % فهو بما أظهر ما عنده 
ms289	 % % منا ومنه ظاهر قد بطن % PageV01P1119 البحر : رمل تام 1(@)(@@) % إنما قلت لشيء كن فكان % % بكلام الحق لا قول فلان % 2(@)(@@) % مهد العذر لنا صاحبه % % بإشارات ورمز في بيان % 3(@)(@@) % إنما كان عن أذني لا تقل % % إنه كان عن إذن لكيان % 4(@)(@@) % يتعالى الله في إيجاده % ما تراه من جميع الحدثان % % 5(@)(@@) % عن شريك غير ما أثبته % % حكم إمكان لشخص ذي جنان % % 6(@)(@@) % نظر الله إليه نظرة % إذ أتاه في غمام لا عيان % 7(@)(@@) % ما حديثي لم يكن عن لم يكن % إنما أورده عن كان وكان % 8(@)(@@) % بلسان ومقال واضح % ورقوم بيراع وبنان % % 9(@)(@@) % وكذا أورده الله لنا % % في كتاب بلسان الترجمان % % PageV01P1120 البحر : سريع 1(@)(@@) % هيهات هيهات لما توعدون % من قيل فيهم في لظى مبلسون % % 2(@)(@@) % حال إله الخلق ما بينهم % % وبينه شرعا فلا يرحمون % 3(@)(@@) % إن على أبصارهم غشوة % من ظلمة الجهل فلا يبصرون % % 4(@)(@@) % قد علموا الأمر فأنساهم % فلم يجيبوا وأبوا يسمعون % % 5(@)(@@) % فلتأتهم ساعتهم بغتة % من عنده بكل ما يكرهون % % 6(@)(@@) % تأخذهم منه على غفلة % % في حال تفريط ولا يشعرون % 7(@)(@@) % قد لعموا الأمر فأنساهم % أنفسهم سكرا ولا يعلمون % % 8(@)(@@) % لا يسأل الله عن أفعاله % % بهم كما جاء وهم يسألون % 9(@)(@@) % قد قيل فيهم وقفوهم يروا % % هذا الذي كانوا به يفتنون % 10(@)(@@) % قد قصل الله لهم مالهم % وما عليهم في الذي يقرأون % % PageV01P1121 11(@)(@@) % جاءت به الأرسال من عنده % مبشرين وبه منذرون % 12(@)(@@) % قال لهم خيالهم حكمنا % % اللغو فيه فعسى تغلبون % 13(@)(@@) % عاد عليهم حسرة لغوهم % % فيه فكانوا في الورى خاسرين % % 14(@)(@@) % فأعرض الله وأرساله % لما تولوا عنهم معرضين % % PageV01P1122 البحر : مجزوء الرجز 1(@)(@@) % لله فينا ما سكن % % وما توارى واستكن % 2(@)(@@) % فإنه سبحانه % لقلبنا نعم السكن % 3(@)(@@) % فلا تقولوا ماله % فإنما القلب سكن % 4(@)(@@) % ولا تكونوا كالذي % % غلا لجهل فامتحن % 5(@)(@@) % غلو أهل الرفض في % % أمر الحسين والحسن % % 6(@)(@@) % الشكر لله الذي % % أسمعني كل حسن % % 7(@)(@@) % في كل بشرى قال لي % % إنك عبد مؤتمن % % 8(@)(@@) % على الذي أعطيته % % من 
ms290	 كل سر في السنن % % 9(@)(@@) % فقل كما قال الذي % % يقوله من قد أمن % % 10(@)(@@) % الحمد لله الذي % % أذهب عن قلبي الحزن % PageV01P1123 البحر : خفيف تام 1(@)(@@) % لا ينيب الفؤاد إلا إذا % % لم يشاهد بذكره ما سواه % % 2(@)(@@) % فإذا شاهد العجائب فيه % % لم يكن ذا إنابة في هواه % % PageV01P1124 البحر : كامل تام 1(@)(@@) % إن المراد مع المريد مطالب إن المراد مع المريد مطالب % بدلائل التحقيق في دعواهما % % 2(@)(@@) % فإذا جهلت الأمر في حاليهما % % فدليل ما والاه في تقواهما % % PageV01P1125 البحر : بسيط تام 1(@)(@@) % ما يتقي الله إلا كل ذي نظر % مسدد مجتبى قد خصه الله % 2(@)(@@) % يقطع الليل بالتسبيح بين يدي % % مولاه دامعة في الليل عيناه % 3(@)(@@) % يقول يا سيدي يا منتهى أملي % % ما للعبيد رحيم غير مولاه % 4(@)(@@) % الله كرم من هذي سجيته % % ونعته فإذا يدعوه لباه % 5(@)(@@) % لولاه ما ضحكت أرض بزهرتها % % ولا بكت سحبها لولاه لولاه % % 6(@)(@@) % الله فضله الله جمله % % الله عدله الله سواه % % 7(@)(@@) % يا صفوة الدين أنت الدين أجمعه % % طابت بذكرك أعراف وأفواه % % PageV01P1126 البحر : بسيط تام 1(@)(@@) % إن البروج أماكن مقدرة % في أطلس تحدث الأيام دورته % 2(@)(@@) % ولا تزال إلى ما لا انقضاء له % % فاحفظه لا يحجبنك اليوم سورته % 3(@)(@@) % فما لغيرته في الخلد من أثر % لكن تؤثر في الأركان غيرته % % 4(@)(@@) % لولا تحركه لم ندر ما زمن % ففيه حيرتنا وفيه حيرته % % 5(@)(@@) % وما استقامته إلا تمايله % فإنه عورة والكل عورته % 6(@)(@@) % فما ترى في وجود الكون من أثر % % إلا وفيه إذا حققت صورته % % 7(@)(@@) % فكل منزلة في الكون ظاهرة % وإنما هي في التحقيق سورته % % 8(@)(@@) % فلا تذمن دهرا لست تعرفه % % فالدهر من شهدت بالملك فطرته % % 9(@)(@@) % به تواصلت الأشياء وانصرمت % % فسيرة الدهر في الأشياء سيرته % % 10(@)(@@) % وليس يدري بها إلا الذي حسنت % مع المهيمن في سر سريرته % PageV01P1127 11(@)(@@) % ما التفت الساق بالساق التي تليت % إلا تقول قد التفت غديرته % PageV01P1128 البحر : طويل 1(@)(@@) % إذا جاءت الأسماء يقدمها الله % % فعظمه بالذكرى وقل قل هو الله % 2(@)(@@) % ألا إنه الرحمن 
ms291	 في عرشه استوى % % ولو كان ألف اسم فذاك هو الله % % 3(@)(@@) % وقالوا لنا باسم الرحيم خصصتم % بآخرة فانظر تجده هو الله % % 4(@)(@@) % ركنت إلى الاسم العليم لأنني % % عليم بما قد قال في العالم الله % % 5(@)(@@) % يرتب أحوالي الحكيم بمنزل % يويدني فيه وجود هو الله % 6(@)(@@) % أتتني كرامات فقلت من اسمه ال % % كريم أتاني في وجودي بها الله % % 7(@)(@@) % إذا عظموني بالعظيم رأيتهم % % أخلاء ودا اصطفاهم له الله % 8(@)(@@) % لقد قام بالقيوم عال وسافل % إليه التجاء الخلق سبحانه الله % % 9(@)(@@) % وقد نص فيه إنه الأكرم الذي % % إليه مرد الأمر والكافل الله % % 10(@)(@@) % ألا إنني باسم السلام عرفته % وقد قيل لي أن السلام هو الله % PageV01P1129 11(@)(@@) % رجعت إليه طالبا غفر زلتي % % فراجعني التواب إني أنا الله % 12(@)(@@) % وناداني الرب الذي قامني به % % أجبتك فيما قد سألت أنا الله % 13(@)(@@) % إذا جاءني الوهاب ينعم لا يرى % % جزاء على النعماء ذلكم الله % % 14(@)(@@) % فكن معه تحمد على كل حالة % ولا تخف الأقصاء فالأقرب الله % % 15(@)(@@) % لقد سمع الله السميع مقالتي % % بأني عبد والسميع هو الله % % 16(@)(@@) % إذا ما دعوت الله صدقا يقول لي % % مجيب أنا فاسأل فإني أنا الله % 17(@)(@@) % أنا واسع أعطى على كل حالة % كفور أو شكارا لأني أنا الله % % 18(@)(@@) % فقلت له أنت العزيز فقال لي : % حماي منيع فالعزيز هو الله % 19(@)(@@) % عجبت له من شاكر وهو منعم % ومن يشكر النعماء ذاك هو الله % 20(@)(@@) % هو القاهر المحمود في قهر عبده % % ولولا نزاع العبد ماقاله الله % PageV01P1130 21(@)(@@) % وجاء يصلي إذ علمنا بأنه % % هو الآخر الممتن والآخر الله % 22(@)(@@) % هو الظاهر المشهود في كل ظاهر % % وفي كل مستور فمشهودك الله % 23(@)(@@) % له الكبرياء السار في كل حادث % فلا تمتر إن الكبير هو الله % % 24(@)(@@) % ويعلم ما لا يعلم إلا بخبره % لذا قال حي فالخبير هو الله % % 25(@)(@@) % ومن ينشئ الأكوان بدءا وعودة % فذاك قدير والقدير هو الله % 26(@)(@@) % ومن يرني أشهد لنفسي بأنه % بصير يراني والبصير هو الله % 27(@)(@@) % يبالغ في الغفران 
ms292	 في كل ما يرى % % من السوء مني فالغفور هو الله % 28(@)(@@) % يبالغ في شكري إذا كنت عاملا % ولا فعل لي إن الشكور هو الله % % 29(@)(@@) % إذا ستر الغفار ذاتك أن ترى % % مخالفة فاشكره إذ عصم الله % 30(@)(@@) % وما قهر القهار إلا منازعا % بدعواه لا بالفعل والفاعل الله % PageV01P1131 31(@)(@@) % وما ذكر الجبار إلا من أجلنا % % ليجبرنا في الفعل والعامل الله % 32(@)(@@) % نزول من أجلي كونه متكبرا % بآلة تعريف وهذا هو الله % % 33(@)(@@) % بآلة عهد قلت فيه مصور % لنا فيه والأرحام إذ قاله الله % 34(@)(@@) % وإن شؤون البر إصلاح خلقه % % لمن يطلب الإصلاح فالمحسن الله % 35(@)(@@) % بمقتدر أقوى على كل صورة % أريد بها فعلا ليرضى بها الله % % 36(@)(@@) % ألم تر أن الله قد خلق البرا % % وأنشأ منه الناس فالبارىء الله % % 37(@)(@@) % وكل علي في الوجود مقيد % سوى من تعالى فالعلي هو الله % 38(@)(@@) % وكل ولي ما عدا الحق نازل % فليس وليا فالولي هو الله % % 39(@)(@@) % لنا قوة من ربنا مستعارة % فنحن ضعاف والقوي هو الله % 40(@)(@@) % ولا حي إلا من تكون حياته % هويته والحي سبحانه الله % % PageV01P1132 41(@)(@@) % فعيل لمفعول يكون وفاعل % كذا قيل لي إن الحميد هو الله % % 42(@)(@@) % يمجده عبد الهوى في صلاته % على غير علم والمجيد هو الله % % 43(@)(@@) % تحبب لي باسم الودود بجوده % % فأثبت عندي جوده أنه الله % 44(@)(@@) % لجأت إليه إنه الصمد الذي % % إليه التجاء الخلق والصمد الله % % 45(@)(@@) % وما أحد تعنو له أوجه العلى % % سواه كما قلناه والأحد الله % % 46(@)(@@) % هو الواحد المعبود في كل صورة % % تكون له مجلى فذلكم الله % % 47(@)(@@) % أنا أول في الممكنات مقيد % وإطلاقها ألله فالأول الله % % 48(@)(@@) % أقول هو الأعلى ولكن لغير من % وإن قلت من فافهم كما قاله الله % % 49(@)(@@) % هو المتعالي للذي جاء من ظما % % وجوع وسقيم مثل ما قاله الله % 50(@)(@@) % يقدر أرزاقا ويوجدها بنا % % كما جاء في الأخبار فالخالق الله % PageV01P1133 51(@)(@@) % وإن جاء بالخلاق فهو بكوننا % % كثيرين بالأشخاص والموجد الله % % 52(@)(@@) % ولا تطلب الأرزاق إلا من الذي % % تسميه 
ms293	 بالرزاق ذلكم الله % 53(@)(@@) % هو الحق لا أكني ولست بملغز % ولا رامز والحق يعلمه الله % % 54(@)(@@) % لقد جاءني حكم اللطيف بذاته % % وإن كان من أسمائه فهو الله % % 55(@)(@@) % رؤوف بنا والنهي عن رأفة يكن % بحاكمنا في الزان إن حده الله % 56(@)(@@) % عفو بإعطاء القليل وإن يكن % % بحاكمنا في الزان إن حده الله % 57(@)(@@) % % كثيرا سواء هكذا نصه الله % 58(@)(@@) % إذا جاءك الفتاح أبشر بنصره % % وإنك مدعو كما حكم الله % % 59(@)(@@) % فإن له حكم المتانة في الورى % % وأنت رقيق فالمتين هو الله % % 60(@)(@@) % وأنت خفي في ضنائن غيبه % % ولست جليا فالمبين هو الله % % PageV01P1134 61(@)(@@) % تأمل إذا ما كنت بالله مؤمنا % من المؤمن الصديق فالمؤمن الله % 62(@)(@@) % ولاتختبر حكم المهيمن إنه % % شهيد لما قد كان والشاهد الله % % 63(@)(@@) % جلاه لنا من باطن الأمر حكمه % % هو الباطن المجهول فالمدرك الله % 64(@)(@@) % يشاهد في القدوس في كل حالة % % أكون عليها فالشهيد هو الله % 65(@)(@@) % شديد إذا يدعى المليك بحكمه % % على خلقه فانظره فالحاكم الله % 66(@)(@@) % كما هو إن نكرته وأزلته % % عن الياء فأقصره تجد هو الله % 67(@)(@@) % وكبره تكبيرا إذا ما ذكرتنا % % به حاكم الله والأكبر الله % 68(@)(@@) % وما عز من يفنيه برهان فكره % وقد عز عنه والأعز هو الله % 69(@)(@@) % هو السيد المعلوم عند أولي النهى % % وجاءت به الأنباء والسيد الله % 70(@)(@@) % إذا قلت سبوح فذلكم اسمه % % لما كان من تنزيهكم وهو الله % % PageV01P1135 71(@)(@@) % كما هو وتر للطلاب بثاره % % لكل شريك يدعي أنه الله % 72(@)(@@) % وقل فيه محسان كما جاء نصه % بألسنة الأرسال فالمحسن الله % 73(@)(@@) % جميل ولا يهوى من أعجب ما يرى % % فقال لي المجلى الجميل هو الله % 74(@)(@@) % ولما علمنا بالبراهين أنه % رفيق بنا قلنا الرفيق هو الله % % 75(@)(@@) % لقد جاءني باسم المسعر عبده % % محمد المبعوث والمخبر الله % % 76(@)(@@) % وفي قبضة الرحمن كانت ذواتنا % % مع الحدث المرثي والقابض الله % 77(@)(@@) % ويبسطنا عند الكثيب لكي نرى % % على جهة الانعام فالباسط الله % % 78(@)(@@) % كما أنه الشافي لسقم طبيعتي % % كما جاء يشفني وإن أسقم 
ms294	 الله % 79(@)(@@) % كما أنه المعطى الوجود وما له % % من الحق خلقا هكذا قاله الله % 80(@)(@@) % ولما أتى داعي المقدم طالبا % تقدم من يدعو من العالم الله % PageV01P1136 81(@)(@@) % ومن حكمه باسم المؤخر لم أكن % على حكمه الهادي كما قد قضى الله % % 82(@)(@@) % % على كل شيء منه يعلمه الله % % 83(@)(@@) % فهذا الذي قد صح قد جئتكم به % وقد قالت الحفاظ ما ثم إلا هو % % 84(@)(@@) % ونعني به في النقل إذ كان قد روت % بأن له الأسماء من صدق دعواه % 85(@)(@@) % وقيدها في تسعة لفظه لنا % % وتسعين من أحصاها يدخل مأواه % 86(@)(@@) % وما هو إلا جنة فوق جنة % على درج الأسماء والخلد مثواه % % PageV01P1137 البحر : بسيط تام 1(@)(@@) % الله أنزل نورا يستضاء به % % على فؤاد نبي سره الله % % 2(@)(@@) % أتى به روحه من فوق أرقعة % % سبع إلى قلبه والسامع الله % 3(@)(@@) % منه إليه به كان النزول له % % فليس في الكون إلا الواحد الله % % 4(@)(@@) % والجسم والعرض المشهود فيه وما % % في الغيب ما ان تراه ذلك الله % % 5(@)(@@) % ولا تناقض فيما قلته فأنا % % عين الكثير وعيني الواحد الله % % 6(@)(@@) % من أعجب الأمر أن الحكم من عدم % % في عين كون فأين العبد والله % % 7(@)(@@) % فالعين تشهد خلقا جاء من عدم % والأمر حقا وعين المبصر الله % % 8(@)(@@) % له اليمين له العينان في خبر % أتى به منه والآتي هو الله % % 9(@)(@@) % فالحكم لي وله عين الوجود وما % % للعين مني وجود بل هو الله % % 10(@)(@@) % فانظره في شجر وانظره في حجر % وانظره في كل شيء ذلك الله % PageV01P1138 11(@)(@@) % كل الأسامي له إن كنت تعقله % هو المسمى بها فكلها الله % 12(@)(@@) % فلو يقول جهول قد جهلت وما % % بالله جهل فما كوني هو الله % % 13(@)(@@) % فقل له ذاك حكم العين فيه ومن % يدري الذي قلته بأنه الله % % 14(@)(@@) % ما ثم والله إلا حيرة ظهرت % وبي حلفت وإن المقسم الله % % 15(@)(@@) % لو كان ثم وجود ما هو الله % % لم ينفرد بالوجود الواحد الله % 16(@)(@@) % بل الحدوث لنا وما يتابعه % وهذه نسب والثابت 
ms295	 الله % 17(@)(@@) % ينوب عنا وإنا منه في عدم % ونحن نشهده والشاهد الله % % PageV01P1139 البحر : بسيط تام 1(@)(@@) % النون كالعين في أنطى وأعطاه % لحن أتاه به شرع فأعطاه % 2(@)(@@) % الحرف يبدل من حرف يماثله % % في قرب مخرجه لذاك ساواه % % 3(@)(@@) % وذا بعيد فكيف الأمر فيه فقل % بأنه بعض عين حين سماه % 4(@)(@@) % فقال والعين أيضا مثله وكذا % % سين وشين لما ذا العين حلاه % 5(@)(@@) % العين عم نفوس الكون أجمعها % % جدا وحققها فذاك معناه % % 6(@)(@@) % وما سواه فليس الأمر فيه كذا % % لسر ذلك رب اللحن جلاه % 7(@)(@@) % فقد تبين أن العين سارية % % في كل شيء لهذا السر أدناه % % 8(@)(@@) % قربا فأبدله نونا مسامحة % في كل كون ييد الحق أبداه % PageV01P1140 البحر : وافر تام 1(@)(@@) % وقال أيضا : عبدت الله لم أعبد سواه % % فما معبودنا إلا الإله % 2(@)(@@) % سرى توحيده في كل عين % فما شيء يسبحه سواه % 3(@)(@@) % ولكن ليس نفقه علم هذا % % وإن كان المسبح قد دعاه % % 4(@)(@@) % لقد حجب العباد بما أراهم % من أنفسهم فلا عين تراه % % 5(@)(@@) % ولا عقل يراه بعين فكر % وبرهان ولم يبعد داه % 6(@)(@@) % قريب بالشريعة حين قالت % % بأن القلب صيره حماه % 7(@)(@@) % بعيد بالأدلة عن عقول % لقد عز الذي يحمي ذراه % PageV01P1141 البحر : سريع 1(@)(@@) % هذا الذي عنت له الأوجه % ليس له من خلقه مشبه % % 2(@)(@@) % ولو بدا للعين في صورتي % % له المقام الأفخم الأنزه % 3(@)(@@) % قد استوى فيه وفي نفسه % % العالم الهمهم والأبله % % 4(@)(@@) % ما يعرف الحق سوى نفسهم % % إن عرفوا وكل ذا كنهه % % 5(@)(@@) % فإن تجلى لعيون الورى % % رأوه منهم ولذا نزهوا % % 6(@)(@@) % أنفسهم في بعض أقوالهم % % قال به أربابه الوله % % 7(@)(@@) % تنزيههم عاد عليهم كما % % جاء به النص الذي نزهوا % % 8(@)(@@) % وفيه قال العبد سبحانه % % عليه أهل الله قد نبهوا % % 9(@)(@@) % فإنه ليس بأنفاسهم % % ما اعتقد الناس وما شبهوا % % PageV01P1142 البحر : وافر تام 1(@)(@@) % إذا شمس النفوس أرت ضحاها % % تزايدت القلوب بما تلاها % % 2(@)(@@) % تراها فيه حالا بعد حال % ومجلاها الهلال إذا تلاها % % 3(@)(@@) % وإني من حقيقته بسري 
ms296	 % % كمثل الشمس إذ تعطي سناها % % 4(@)(@@) % فما أنا في الوجود سواه عينا % وما هم في الوجود بنا سواها % % 5(@)(@@) % فتلك سماؤنا لما بناها % % وهذي أرضنا لما طحاها % % 6(@)(@@) % من أجلي كان ربي في شؤون % % وقد بلغت فواكهكم أناها % % 7(@)(@@) % سنفرغ منكم جودا إليكم % لتعطي نفوسكم منها مناها % % 8(@)(@@) % ويلحمها بذات منه لما % % علمت بأنها كانت سداها % % 9(@)(@@) % يعذبنا النهار سدى وويلا % وليلته يعذبنا نداها % % 10(@)(@@) % فغطاها الظلام بسر كوني % % وجلاها النهار وما جلاها % % PageV01P1143 البحر : طويل 1(@)(@@) % إذا زلزلت أرض الجسوم تراها % % وما نالت الأجفان فيه كراها % % 2(@)(@@) % لقد ظهرت فيها أمور عظيمة % وما انفصمت مما رأته عراها % % 3(@)(@@) % إذا جاءها الداعي ليخرج ما بها % % وأخرج لي ما قد أجن ثراها % % 4(@)(@@) % وقد عجزت أبصارنا أن ترى لها % % بساحتنا حكما فكيف تراها % % PageV01P1144 البحر : بسيط تام 1(@)(@@) % رأيت زلزلة عظمى منبهة % على أمور عظام كدت أخفها % % 2(@)(@@) % في برزخ من برازخ الكرى ظهرت % آثارها وهو حالي قد بدا فيها % % 3(@)(@@) % بدا لشاهد عيني عين صورته % تراه يا ليت شعري هل يوافيها % % 4(@)(@@) % قالت خواطرنا من فوق أرقعة % تحريك أفلاكنا منا يكافيها % % 5(@)(@@) % لو كان يصفو لنا في حال رؤيتنا % % إياها خاطرنا كنا نصافيها % % 6(@)(@@) % لكنها مرضت نفسي لرؤيتها % % وقد سألت إلهي أن يعافيها % % 7(@)(@@) % شافهتها ومرادي أن أذكرها % % بما لها عندنا من في إلى فيها % % 8(@)(@@) % تحرك الجسم مني في تحركها % % بسجدة لأمور لا تنافيها % % 9(@)(@@) % وكان فيما بدا مني لما قصدت % من المواعظ والذكرى تلافيها % % PageV01P1145 البحر : مخلع البسيط 1(@)(@@) % ما انبعثت همتي إليها % % ولم أعرج يوما عليها % % 2(@)(@@) % من علم النفس علم كشف % لم يلق ما عنده إليها % % 3(@)(@@) % بما له خصها اعتناء % % فكل ما عنده لديها % % 4(@)(@@) % فليس في الكون ما تراه % % سواه فالأمر في يديها % % PageV01P1146 البحر : بسيط تام 1(@)(@@) % ما ليلة القدر إلا ذات رائيها % % وهي الدليل على الخير الذي فيها % % 2(@)(@@) % تحوي على كل خير قيدته لنا % % بألف شهر وذاك القدر يكفيها % % 3(@)(@@) % ولم يقيد بشيء ما يزيد 
ms297	 على % % ما قيدته لنا حتى يوفيها % % 4(@)(@@) % فليس يحصر غير الذات في عدد % لأنه خير رب مودع فيها % % 5(@)(@@) % وخيره سرمدي لا انقضاء له % % فالله يحرسها والله يكفيها % % 6(@)(@@) % من كل عين تؤديها إلى عطب % ولو قد سعينا في تلافيها % % PageV01P1147 البحر : طويل 1(@)(@@) % تعالى وجود الذات عن نيل ناظر % فإن وجود الذات لله عينها % % 2(@)(@@) % وذاك اختصاص بالإله ولا تقل % % بأن ذوات الخلق كالحق كونها % % 3(@)(@@) % تغيرت الأحكام لما تغايرت % بألفاظه الأنساب فالبين بينها % % 4(@)(@@) % فمن شاء فليقطع ومن شاء فليصل % فذلك ستر فيه للذات صونها % % PageV01P1148 البحر : كامل تام 1(@)(@@) % من كان تكمل ذاته بسواها % % فهو الذي بالمحدثات يضاهى % % 2(@)(@@) % الحق أعظم أن يكون كمثل ما % % قد قال بعض الناس فيه فضاهى % % 3(@)(@@) % أكوانه بصفاته وتباهى % % في ذاك إعجابا بها وتناهى % % 4(@)(@@) % من يقبل الأغيار كان سواها % % وهي التي ثبتت لمن سواها % % 5(@)(@@) % عند المنازع للمحقق والذي % % ما زال ينكر كونها أشباها % % 6(@)(@@) % فانظر إلى هذي العقول من الذي % % قد كان أثبتها فما أعماها % % PageV01P1149 البحر : طويل 1(@)(@@) % نزيه الجناب العال كيف تنزهت % % به مقل الأبصار بالمنظر الأزهى % % 2(@)(@@) % وكيف تراه العين وهو منزه % % بكرسيه العالي المنزه والأبهى % % 3(@)(@@) % إذا سمعت أذناي شرح كلامه % تحققت قطعا بيننا من هو الأشهى % % 4(@)(@@) % تعالى جلال الله عن كل مدرك % ولله حال ما ألذ وما أشهى % % 5(@)(@@) % فأنهيت أمري طالبا حق خالقي % % إلا أن عبد الله من كان قد أنهى % % 6(@)(@@) % فإن كان حقا ما يقال فإنه % % يقرره حالا وإلا فقد ينهى % % 7(@)(@@) % ومثلي من يسهو عن الحق عندما % % يقرره أمرا ومثلي من ينهى % % 8(@)(@@) % دهاني بأمر كنت قبل جهلته % % فما أمكن المملوك رد فما أدهى % % 9(@)(@@) % وهي جانب البيت العتيق لعزة % % فلم أر أهوى منه بيتا ولا أدهى % % 10(@)(@@) % ولم يلهني عنه حميم وصاحب % فإن لم يكن بالقول بالحال قد ألهى % % PageV01P1150 11(@)(@@) % فلا تحجبني عنك ربي بصورة % % فإني لها أسعى كما أنني منها % % 12(@)(@@) % حديثي الذي عند السماع أبثه % % فما هو إلا من 
ms298	 روايتنا عنها % % 13(@)(@@) % وما علمت نفسي مثالا مطابقا % كما تزعم الألباب كنت لها شبها % % 14(@)(@@) % إذا طمعت نفسي بإدراك ذاتها % % فتلك التي تدعى بجاهلة بلها % % 15(@)(@@) % تخص إذا خصت نفوس شريفة % % منزهة الأوصاف بالصورة الشوهى % % PageV01P1151 البحر : طويل 1(@)(@@) % إذا وصف الشرع المبين إلها % % فذاك الإله الحق ليس يضاهى % % 2(@)(@@) % ودع عنك أفكارا تنازع حكمة % فآلهة الأفكار لا تتناهى % % 3(@)(@@) % وقد بلغت نفسي إذا هي أنصفت % وقالت بقول الشرع فيه مناها % % 4(@)(@@) % فيا قارئ القرآن شرعك فالتزم % % فما آية إلا يزيد رضاها % % 5(@)(@@) % وما طعمة الأفكار إلا تغصص % إذا هي لم تبلغ لديه أناها % % PageV01P1152 البحر : بسيط تام 1(@)(@@) % إني نظرت إلى نفسي بعين رضى % فقهقهت عجبا مني لجهلي بها % % 2(@)(@@) % وأقبلت نحو عقلي كي تعاتبه % أعاقلا نفسه يرضى بمذهبها % % 3(@)(@@) % كيف الرضى وهو ذو مكر وذو خدع % دليلنا ما بدا لي من تعجبها % % PageV01P1153 البحر : بسيط تام 1(@)(@@) % إن المحامد أنواع منوعة % % تبيينها لك حمد الحامدين بها % % 2(@)(@@) % وما لها صور في غير حالهم % فكن بذا عالما إن كنت منتبها % % 3(@)(@@) % عم الحلال إذا أكلت عن ضرر % فإن جهلت فكل ما كان مشتبها % % 4(@)(@@) % وما يعم حرام وهو حجتنا % % إن المآل إلى الرحمن انتبها % % 5(@)(@@) % إن النجوم لتجري في مطالعها % % بما يشاء من أمر نحو مغربها % % 6(@)(@@) % وذلك الأمر أخفاه وأودعه % % رب السموات في تسيير كوكبها % % 7(@)(@@) % فقائل إن هذا الحكم ليس لها % % وقائل حكم هذا من كوكبها % % 8(@)(@@) % يسري فيحدث في أعياننا عجبا % وما لها مذهب في أصل مذهبها % % 9(@)(@@) % وما لها خبر مما يقوم بنا % % بل ذلك الأمر فينا من مرتبها % % 10(@)(@@) % تقلب الليل عنها والنهار معا % وما التقلب إلا من مقلبها % % PageV01P1154 11(@)(@@) % سبحانه وتعالى أن يحاط بما % % يحويه علما لدينا في تقلبها % % PageV01P1155 البحر : بسيط تام 1(@)(@@) % إني رأيت براهين العقول على % % نفي التحيز لا تقوى دلالتها % % 2(@)(@@) % إن البدور بعين الحس تشهدها % % وقد أحاطت بها في الجو هالتها % % 3(@)(@@) % ولم تكن غير أنوار بها انبعثت % % منها إلى غاية فيها 
ms299	 حبالتها % % 4(@)(@@) % على السواء فدارت كي يحيط بها % % وما أحاط بها غير فآلتها % % 5(@)(@@) % منها فنطقها بالمحال موجدها % % حقا وقد حققت فيها مقالتها % % 6(@)(@@) % واعلم بأن صفات الحق ليس لها % % حد ينال فقد عالت فريضتها % % PageV01P1156 البحر : سريع 1(@)(@@) % زوجت الأنفس أبدانها % % إذ أظهر الإنسان أعيانها % % 2(@)(@@) % وأحكم الطبع بها شهوة % إذ أحكم الصانع بنيانها % % 3(@)(@@) % أسكنه الرحمن في جنة % % يلاعب الحور وولدانها % % 4(@)(@@) % أطاف بالكاس وإبريقه % % رحمانه عليه غلمانها % % 5(@)(@@) % لما أتى عند كثيب الحمى % % يطلب للأنصار رحمانها % % 6(@)(@@) % أنفسنا لو عرفت ذاتها % % لأقرأت بالجمع قرآنها % % 7(@)(@@) % سبحان من حيرها حكمة % % فيها فلا تعرف فرقانها % % PageV01P1157 البحر : سريع 1(@)(@@) % لولا وجود النفس الأنزه % ما لاح عين العالم المشبه % PageV01P1158 البحر : بسيط تام 1(@)(@@) % ألبست من هومنا اليوم خرقتنا % % لباس تقوى وفيه بعض ما فيه % % 2(@)(@@) % إذا يصح له من أصله نسب % صح اللباس لباس الفخر والتيه % % 3(@)(@@) % وأي فخر يسامي فخر ذي نسب % تفجر العلم منه في نواحيه % 4(@)(@@) % فليلبس الولد المحفوظ خرقتنا % % على الشروط التي ضمنتها فيه % % 5(@)(@@) % وهي التزين بالأخلاق أجمعها % % محمودها في الذي يبدي ويخفيه % PageV01P1159 البحر : بسيط تام 1(@)(@@) % وجوده منتج كوني لنعلمه % والعلم بي منتج للعلم بالله % % 2(@)(@@) % فكوننا من دليل العقل مأخذه % والعلم مأخذه من شرعه الزاهي % % 3(@)(@@) % ولا تقل هذه في الحق مغلطة % الحق ما قلته في الأمر يا ساهي % % 4(@)(@@) % عناية الله بي إذ كان يعلمني % % مثال هذا بلا مال بلا جاه % % 5(@)(@@) % هذا هو الجاه إن حققت منصبه % وليس يعرفه ساه ولا واهي % % 6(@)(@@) % الحق يسألني ما ليس يدركه % إلا بنا مدرك من حس أو باه % % 7(@)(@@) % ببيت التفكر بيت العنكبوت وبيت % الكشف عندهم في فكرهم واهي % % 8(@)(@@) % لولا التفكر كان الناس في دعة % في العلم بالله لا بالآمر الناهي % % 9(@)(@@) % وليس يعبده إلا منزهه % % في كل عين من أمثال وأشباه % 10(@)(@@) % إذا أتاكم رسول الحق يمنحكم % % أسماء مرسلة فلا تقل ما هي % % PageV01P1160 11(@)(@@) % خذها ولا تعتبر فيها مقايسة % % ولا اشتقاقا وكن كالعالم الواهي 
ms300	 % % PageV01P1161 البحر : بسيط تام 1(@)(@@) % قد خرت من عدمي بالكون ما ثبتت % % في العين صورته والكون لله % % 2(@)(@@) % فالحكم فينا لنا فليس يظلمنا % % وقامت الحجة الغراء لله % % 3(@)(@@) % ما للمحالات في العين الثبوت وقد % أقامها العقل للأوهام لله % 4(@)(@@) % والطبع ساعده والطرف شاهده % % شهود وهم بأحكام من الله % % 5(@)(@@) % لو لم يرد لم يكن وقد أراد فكان % % ولو فليس لها حكم مع الله % % 6(@)(@@) % من يزرع المنع لم يحصد سوى عدم % والجود يزرع والايجاد لله % % 7(@)(@@) % وحيثما ثبتت في العين صورتها % % فليس ينتج إلا المنع والله % 8(@)(@@) % ويضعف الحكم فيها إن قرنت بها % % وجود لا حكمة أيضا من الله % % 9(@)(@@) % لولا تحقق لو دان لنيط به % خلاف ما يستحق الذات والله % % 10(@)(@@) % فرحمة الله بالأعيان أوجدت % % الألحان فاحكم بها جودا من الله % % PageV01P1162 11(@)(@@) % ضاق النطاق على من ليس يعرفها % % ولست تعرفها إلا من الله % % 12(@)(@@) % فليس يشهد في الأكوان كائنة % وحكمها أحد إلا من الله % % 13(@)(@@) % فاحمد وزد واعترف بالكون من عدم % واشكر إلهك لا تشكر سوى الله % % 14(@)(@@) % إني أتيت علوما في قصيدتنا % % تخفى على كل محجوب عن الله % 15(@)(@@) % وقل بها إنها العلم الصحيح ولا % % تعدل إلى غيرها تدنو من الله % 16(@)(@@) % لا تركنن إلى شيء تسر به % % إلا وتشهده جودا من الله % 17(@)(@@) % تدفع غوائله بما اتصفت به % % من الشهود فلا تغفل عن الله % 18(@)(@@) % ولا تخف من أمور أنت تحذرها % % إلا وعصمتكم فيها من الله % 19(@)(@@) % قصدي حضورك لا تغفل وكن رجلا % لله بالله في الله مع الله % 20(@)(@@) % فكن كسهل وأمثال له علموا % % في أن كون وجود الله لله % PageV01P1163 21(@)(@@) % يا بردها حكمة ذوقا على كبدي % % الحال جاء بها فضلا من الله % PageV01P1164 البحر : بسيط تام 1(@)(@@) % إن الإله الذي بالشرع تعرفه % ليس الإله الذي بالفكر تدريه % 2(@)(@@) % العقل نزه والتحديد يأخذه % % والشرع ما بين تنزيه وتشبيه % 3(@)(@@) % الشرع أصدق ميزان يعرفنا % % بربنا ولهذا همتي فيه % 4(@)(@@) % إن الشريعة تجري غير قاصرة % % والمعقل في عمه فيه وفي 