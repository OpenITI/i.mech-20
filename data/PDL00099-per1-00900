ms899	 و کرم %~% درویش و پادشهی محتاج و محتشمی(@)(@@) 27 فضلی به صاحب ری داری ز فضل و هنر %~% کاو صاحب قلمست تو صاحب‌کرمی(@)(@@) 28 شمشیر در کف تو دانی مشابه چیست %~% در دست اصل وجود سرمایه عدمی(@)(@@) 29 از بس ضیا و بها می‌بینمت‌که مهی %~% از بس عطا و کرم پندارمت‌ که یمی(@)(@@) 30 در روز فتنه و کین هان روزگار اثری %~% درگاه شادی و فر هین مشتری شیمی(@)(@@) 31 در عقل و هوش و خرد بی‌مثل و بی‌شبهی %~% سرمایه خردی پیرایه هممی(@)(@@) 32 شایدکه از توکند فخر آنچه نقش وجود %~% کامد ز هستی تو کامل وجود همی PageV1P418(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ترک کشتی‌گیر من میل شنا دارد همی %~% وانچه بی‌میلی بود با آشنا دارد همی(@)(@@) 2 نگذرد بر لب ز میل آشنایانش حدیث %~% ور حدیثی دارد از میل و شنا دارد همی(@)(@@) 3 می‌ندارم زهره تاگویم به هنگام شنا %~% زهره را مایل به خط استوا دارد همی(@)(@@) 4 ازکمر بگذشته زلف تابدارش ای ‌شگفت %~% می‌ندانم ‌کز کمر قصد کجا دارد همی(@)(@@) 5 گنج سیم اندرکمر مانا مگر دارد سراغ %~% تا زگنج سیم ‌کام دل روا دارد همی(@)(@@) 6 زلفش آری اژدرست و گنج بیند در کمر %~% هر کمر کاو گنج دارد اژدها دارد همی(@)(@@) 7 پهلوانی می‌کند با اهل دل ‌گیسوی او %~% بنگر آن افتاده اندر سر چها دارد همی(@)(@@) 8 می‌رباید زلف مشکینش دل از خوبان مگر %~% زلف او خاصیت آهن‌ربا دارد همی(@)(@@) 9 با سر زلفش ‌‌که یک ‌اقلیم دل پابست اوست %~% روز و شب مسکین دل ‌من ماجرا دارد همی(@)(@@) 10 چون نماید میل‌ کشتی‌ کشتی صبر مرا %~% زآب چشمان غرقه بحر فنا دارد همی(@)(@@) 11 میل ‌چون جنبد به‌ دستش ‌‌میل ‌من‌ جنبد چنانک %~% تا دوصد فرسنگم از دانش جدا دارد همی(@)(@@) 12 چون به چرخ آید بتابد روی هر ساعت زمن %~% نسبتی مانا به چرخ بی‌وفا دارد همی(@)(@@) 13 رند و قلاشست در ظاهر ولیکن 
ms900	 در نهفت %~% پاکدامن خویش را چون پوریا دارد همی(@)(@@) 14 پیکرش یک‌ ‌توده نسرینست ‌و یک‌خروار سیم %~% سیم و نسرین را دریغ از ما چرا دارد همی(@)(@@) 15 سیم‌و نسرینش ‌ز اشک‌لاله‌گون‌و ضعف دل %~% سیم و نسرینم عقیق و کهربا دارد همی(@)(@@) 16 یاسمینست آن نه ‌پیکر ارغوانست ‌آن ‌نه خط %~% روی و پیکر کی چنین فر و بها دارد همی(@)(@@) 17 هیچ دیدی یاسمین را سخت سندان در بغل %~% یا شنبدی ‌کارغوان مشک ختا دارد همی(@)(@@) 18 بر فراز نخل قد سیمای سیمینش عیان %~% یا نه بر سرو روان بدرالدجی دارد همی(@)(@@) 19 چشم ‌و ابرو خال ‌و گیسو قامت ‌و رو زلف ‌و لب %~% در کمین خلق دزدی جابجا دارد همی(@)(@@) 20 دولت وصلی‌ که شاهان جهان را آرزوست %~% وقف قلاشان و رندان ‌کرده تا دارد همی(@)(@@) 21 تخت ‌عاجش را نه‌دیدست و نه‌بیند هیچکس %~% تا نگار پارسی‌دل پارسا دارد همی(@)(@@) 22 گاه گاهی بوسه‌ای‌‌ گر می دهد عیبش مکن %~% اینقدر بر خلق بخشایش روا دارد همی(@)(@@) 23 غیر وی از وی نخواهد هرکه باشد پاکباز %~% پاکباز از هرچه جز جانان ابا دارد همی(@)(@@) 24 ویحک از بالای دلبندش که چون پوشد قبا %~% صد خیابان نارون در یک قبا دارد همی(@)(@@) 25 وقف خوبان ‌کرده قاآنی مگر گفتار خویش %~% کاینهمه زیشان به لب مدح و ثنا دارد همی(@)(@@) 26 تا نه‌ پنداری هوسناکست و هر جا شاهدیست %~% خویش رادزدیده‌بر جورش رضا دارد همی(@)(@@) 27 طبع را می‌آزماید در مضامین شگرف %~% وزسخن سنجان امید مرحبا دارد همی(@)(@@) 28 ورنه ‌هم یکتا خدا داند که ‌اندر شرق ‌و غرب %~% روی دل در هرچه دارد در خدا دارد همی(@)(@@) 29 او به‌ یاری ‌بسته ‌دل کش ‌‌نیست‌ هستی ‌ز آب‌ و گل %~% در وجودش آب و‌ گل نشو و نما دارد همی(@)(@@) 30 چون‌ ولا خواهد بلا خواهد از آنرو روز و شب %~% خاطر از بالای خوبان در بلا دارد همی 