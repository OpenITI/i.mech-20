ms6321	 )(@)(@@)(@@)(@@) $ 12364 عن أبي مالك الأشجعي أن الحسن بن الحارث الجدلي ، أخبره : ( أن أمير مكة خطبهم فقال : عهد إلينا رسول الله أن ننسك للرؤية ، فإن لم نره وشهد شاهدا عدل نسكنا لشهادتهما ، فسألت الحسن بن الحارث ، من أمير مكة ؟ قال : هو الحارث بن حاطب ، أخو محمد بن حاطب ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12365 عن الحارث بن حاطب رضي الله عنه قال : ( سرق رجل على عهد رسول الله ، فأتي بهه النبي فقال : اقتلوه ، فقالوا : يا رسول الله ! إنما سرق ، فقال : اقطعوه ، ثم سرق على عهد أبي بكر رضي الله عنه فقطعه ، ثم سرق أيضا فقطع أربع مرات ، حتى قطع قوائمه كلها ، ثم سرق الخامسة ، فقال أبو بكر : كان رسول الله أعلم بهذا حين أمر بقتله ، اذهبوا به فاقتلوه ، فقتلناه ) . ( الحسن بن سفيان ، ع ، والشاشي ، طب ، ك ، وأبو نعيم ، ص ) .(@)(@@) PageV18P295(@)(@@)(@@)(@@) $ 12366 عن الزهري قال : ( ضرب رسول الله لنفر من المهاجرين والأنصار بسهامهم يوم بدر كاملة وكانوا غيبا عنها لعذر كان بهم ، منهم من الأنصار أبو لبانة بن عبد المنذر والحارث بن حاطب رضي الله عنهما ) . ( طب ) .(@)(@@)(@@)(@@) |||| 48 ( الحارث بن خزمة الأنصاري رضي الله عنه )(@)(@@)(@@)(@@) $ 12367 عن أبي بشير الحارث بن خزمة الأنصاري : ( أنه كان مع رسول الله في بعض أسفاره ، فأرسل رسول الله رسولا والناس في مبيتهم ، لا يبقين في رقبة بعير قلادة من وتر إلا قطعت ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12368 عن الحارث بن خزمة بن أبي غنم الأنصاري رضي الله عنه قال : ( قدم رسول الله المدينة يوم الإثنين لأربع عشرة من ربيع الأول ، وكان يوم بدء يوم الإثنين من رمضان ، وتوفي يوم الإثنين لخمس عشرة من ربيع الأول ) .(@)(@@)(@@)(@@) |||| 49 ( الحارث بن زياد الساعدي رضي الله عنه )(@)(@@)(@@)(@@) $ 12369 عن الحارث بن زياد الساعدي رضي الله عنه قال : ( أتيت النبي يوم الخندق وهو يبايع الناس على الهجرة ، فظننا أنهم يدعون إلى البيعة ، فقلت : يا رسول الله ! بايع هذا على الهجرة ، فقال : ومن هذا ؟ قلت : هذا ابن عمي حوط بن يزيد أو : يزيد بن حوط فقال رسول الله 
ms6322	 ت : لا أبايعكم ، إن الناس يهاجرون إليكم ، ولا تهاجرون إليهم ، والذي نفسي بيده ! لا يحب الأنصار رجل حتى يلقى الله ، إلا لقي الله وهو يحبه ، ولا يبغض الأنصار رجل حتى يلقى الله ، إلا لقي الله وهو يبغضه ) . ( حم ، خ ، في تاريخه ، وابن أبي خيثمة ، وأبو عوانة ، والبغوي ، طب ، وأبو نعيم ) .(@)PageV18P296(@)(@@)(@@)(@@) |||| 50 ( الحارث بن غزية الأنصاري رضي الله عنه )(@)(@@)(@@)(@@) $ 12370 عن الحارث بن غزية الأنصاري رضي الله عنه : سمعت رسول الله يقول يوم فتح مكة : ( لا هجرة بعد الفتح ، إنما هو الإيمان ، والنية ، والجهاد ؛ متعة النساء حرام ، متعة النساء حرام ، متعة النساء حرام ، ثم كان الغد فقال : يا معشر خزاعة ! والذي نفسي بيده ، لو قتلتم قتيلا لأديته ، لا أعلم أحدا أعدى على الله ممن استحل حرمة الله ، أو قتل غير قاتله ، ثم انصرف ، ثم كان بعد الغد فقام فقال : والذي نفسي بيده ! لقد علمت أن مكة حرم الله وأمنه ، وأحب البلدان إلى الله ، ولو لم أخرج منها لم أخرج ، لا يعضد شجرها ، ولا يحتش حشيشها ولا يختلى خلاها ، فقال العباس : إلا الإذخر يا رسول الله ، فإنه للصواغين وظهور البيوت . فقال رسول الله إلا الإذخر ، لا ينفر صيدها ، ولا تحل لقطتها إلا لمنشد ) . ( الحسن بن سفيان ، وأبو نعيم ) .(@)(@@)(@@)(@@) |||| 51 ( الحارث بن عبد الله البجلي رضي الله عنه ويقال : الجهني )(@)(@@)(@@)(@@) $ 12371 عن الحارث بن عبد الله الجهني رضي الله عنه قال : ( بعثني رسول الله إلى اليمن ، ولو أوقن أنه يموت لم أفارقه فأتاني قائل بخبر أن محمدا قد مات ، قلت : متى ؟ قال : اليوم ، فلو أن عندي سلاحا لقاتلته ، فلم ألبث إلا يسيرا حتى أتاني آت من أبي بكر رضي الله عنه أن رسول الله قد توفي ، فبايع الناس خليفته من بعده ، فبايع من قبلك ، فقلت للرجل الذي أخبرني : من أين علمت ذلك ؟ قال : إن في الكتاب الأول أنه يموت نبي في هذا اليوم ، قلت : وكيف يكون بعده ؟ قال : ستدور رحاهم إلى خمس وثلاثين سنة ) . ( أبو نعيم ) .(@)PageV18P297(@)(@@)(@@)(@@) |||| 52 ( الحارث بن عبد الله بن أبي 
ms6323	 ربيعة رضي الله عنه )(@)(@@)(@@)(@@) $ 12372 عن الحارث بن عبد الله بن أبي ربيعة رضي الله عنه : ( أن النبي أتي بسارق فقيل لرسول الله : إنه لناس من الأنصار ما لهم مال غيره ، فتركه ، ثم أتي به الثانية ، فتركه ، ثم أتي به الثالية فتركه ، ثم أتي به الرابعة فتركه ، ثم أتي به الخامسة فقطع يمينه ، ثم أتي به السادية فقطع رجله ، ثم أتي به السابعة ، فقطع يده ، ثم أتي به الثامنة فقطع رجله ، ثم قال : أربع بأربع ) . ( هارون في المسند ، وأبو نعيم ) .(@)(@@)(@@)(@@) |||| 53 ( الحارث بن عبد شمس الخثعمي رضي الله عنه )(@)(@@)(@@)(@@) $ 12373 عن الحارث بن عبد شمس الخثعمي رضي الله عنه : ( أنه خرج إلى النبي فأسلم ، وأخذ لجميع أصحابه الأمان على دمائهم وأموالهم ، وكتب له كتابا ، وأباحهم في بلادهم كذا وكذا الحديث ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 54 ( الحارث بن عمرو السهمي رضي الله عنه )(@)(@@)(@@)(@@) $ 12374 عن يحيى بن زرارة بن كريم بن الحارث ، حدثني أبي ، عن جده الحارث بن عمرو رضي الله عنه : ( أنه لقي النبي في حجة الوداع ، وهو على ناقته العضباء ، فقلت : بأبي أنت وأمي يا رسول الله ، استغفر لي ، فقال : غفر الله لكم ، ثم استدرت إلى الشق الآخر رجاء أن يخصني ، فقلت : استغفر لي ، فقال : غفر الله لكم ، فقال رجل : يا رسول الله ! الفرائع والعتائر ؟ PageV18P298 فقال : من شاء فرع ، ومن شاء لم يفرع ، ومن شاء عتر ، ومن شاء لم يعتر ، وفي الغنم أضيتها ، ثم قال : ألا إن دماءكم وأموالكم عليكم حرام كحرمة يومكم هذا ، وبلدكم هذا ، وشهركم هذا ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12375 عن عتبة بن عبد الملك السهمي رضي الله عنه قال : حدثني زرارة بن كريم بن الحارث بن عمرو السهمي : ( أن الحارث بن عمرو رضي الله عنه حدثه قال : أتيت رسول الله وهو بمنى ، أو بعرفات ، وتجيء الأعراب ، فإذا رأوا وجهه قالوا : هذا وجه مبارك ، قلت : يا رسول الله ! استغفر لي ، قال : اللهم اغفر لنا ، فدرت ، فقلت : يا رسول الله ! استغفر لي ، فقال : اللهم اغفر لنا ، فدرت ، فقلت : يا رسول الله 
ms6324	 ! استغفر لي ، فقال : اللهم اغفر لنا ، فذهب يبزق ، فقال بيده ، فأخذ بزاقه فمسح بها نعله ، كره أن يصيب به أحدا ممن حوله ، ثم قال : أيها الناس ! أي يوم هذا ، وأي شهر هذا ، إن دماءكم . . . ، فدكر نحوه ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12376 عن سهل بن حسين الباهلي ، حدثني زرارة عن الحارث السهمي رضي الله عنه : ( أنه أتى النبي مثله فأهوى نبي الله فمسح وجهه ، فما زالت نضرة على وجهه حتى هلك ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 55 ( الحارث بن غطيف السكوني رضي الله عنه )(@)(@@)(@@)(@@) $ 12377 عن يونس بن سيف العبسي ، عن الحارث بن غظيف أو غطيف بن الحارث الكندي شك معاوية قال : ( مهما نسيت لم أنس أني رأيت رسول الله وضع يده اليمنى على اليسرى يعني في الصلاة ) . ( ش ، خ ، في تاريخه وأبو نعيم ، كر ) .(@)PageV18P299(@)(@@)(@@)(@@) |||| 56 ( الحارث بن قيس الأسدي رضي الله عنه )(@)(@@)(@@)(@@) $ 12378 عن الحارث بن قيس بن الأسود الأسدي : أنه أسلم وعنده ثماني نسوة ، فأمره النأ أن يختار منهن أربعا ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12379 عن قيس بن الحارث الأسدي رضي الله عنه قال : ( أسلمت وعندي ثماني نسوة ، فقال النبي : اختر منهن أربعا ) . ( عب ) .(@)(@@)(@@)(@@) |||| 57 ( الحارث بن مالك الأنصاري رضي الله عنه )(@)(@@)(@@)(@@) $ 12380 عن الحارث بن مالك الأنصاري رضي الله عنه قال : ( مررت بالنبي فقال : كيف أصبحت يا حارث ؟ قلت : أصبحت مؤمنا حقا ، فقال : انظر ما تقول ! فإن لكل شيء حقيقة ، فما حقيقة إيمانك ؟ قلت : قد عزفت نفسي عن الدنيا ، وأسهرت لذلك ليلي ، وأظمأت نهاري ، وكأني أنظر إلى عرش ربي بارزا وكأني أنظر إلى أهل الجنة يتزاورون فيها ، وكأني أنظر إلى أهل النار يتضاغون فيها ، فقال : يا حارث ! عرفت فالزم قالها ثلاثا ) . ( طب ، وأبو نعيم ) .(@)(@@)(@@)(@@) $ 12381 عن أنس رضي الله عنه قال : ( إن رسول الله دخل المسجد ، والحارث بن مالك رضي الله عنه نائم ، فحركه برجله ، قال : ارفع رأسك ، فرفع رأسه ، فقال : بأبي أنت وأمي يا رسول الله ! فقال النبي : كيف أصبحت يا حارث بن مالك ؟ قال : أصبحت يا رسول الله مؤمنا حقا ، قال : إن لكل 
ms6325	 حق حقيقة ، فما حقيقة ما تقول ؟ قال : عزفت عن الدنيا ، وأظمأت نهاري ، وأسهرت ليلي ، وكأني أنطر إلى عرش ربي ، فكأني أنظر إلى أهل الجنة PageV18P300 فيها يتزاورون ، وإلى أهل النار يتعاوون ، فقال له النبي : أنت امرؤ نور الله قلبه ، عرفت فالزم ) . ( كر ) .(@)(@@)(@@)(@@) |||| 58 ( الحارث بن مالك بن البرصاء الليثي رضي الله عنه )(@)(@@)(@@)(@@) $ 12382 عن الحارث بن مالك : ( أن البرصاء الليثي رضي الله عنه قال : قال رسول الله يوم فتح مكة : لن تغزى بعد اليوم إلى يوم القيامة ) . ( ش ، وأبو نعيم ) .(@)(@@)(@@)(@@) $ 12383 عن الحارث بن برصاء الليثي رضي الله عنه قال : ( سمعت النبي في الحج وهو يمشي بين الجمرتين وهو يقول : من اقتطع من مال أخيه شيئا بغير حق يأخذه بيمين فاجرة فليتبوأ مقعده من النار ، فليبلغ شاهدكم غائبكم وفي لفظ : ( من أخذ شيئا من مال امرىء مسلم بيمين فاجرة فليتبوأ بيتا في النار ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 59 ( الحارث بن نوفل رضي الله عنه )(@)(@@)(@@)(@@) $ 12384 عن عبد الله بن الحارث بن نوفل رضي الله عنه : ( أن النبي أخذ لؤلؤة فجعلها في خيط فأعطاها بعض أهله ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12385 عن عبد الله الحارث بن نوفل عن أبيه : أن النبي علمهم الصلاة على الميت : ( اللهم اغفر لإخواننا وأخواتنا ، وأصلح ذات بيننا ، وألف بين قلوبنا ، اللهم ! هذا عبدك فلان ابن فلان ، ولا نعلم إلا خيرا ، وأنت أعلم به منا ، فاغفر لنا وله ) . فقلت وأنا أصغر القوم : فإن لم أعلم خيرا ؟ قال : فلا تقل إلا ما تعلم ) . ( أبو نعيم ) .(@)PageV18P301(@)(@@)(@@)(@@) |||| 60 ( الحارث بن هشام بن المغيرة المخزومي رضي الله عنه )(@)(@@)(@@)(@@) $ 12386 عن المسيب ، عن الحارث بن هشام المخزومي رضي الله عنه : ( أن النبي سجد سجدتي السهو قبل أن يسلم ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12387 عن حبيب بن أبي ثابت : ( أن الحارث بن هشام ، وعكرمة بن أبي جهل ، وعياش بن أبي ربيعة رضي الله عنهم خرجوا يوم اليرموك حتى أثبتوا ، فدعا الحارث بن هشام بماء ليشربه ، فنظر إليه عكرمة فقال : آدفعه إلى عكرمة ، فلما أخذه عكرمة نظر إليه عياش ، فقال : ادفعه 
ms6326	 إلى عياش ، فما وصل إلى عياش حتى مات ، وما وصل إلى أحد منهم حتى ماتوا ) . ( أبو نعيم ، كر ) .(@)(@@)(@@)(@@) $ 12388 عن هشام بن عروة ، عن أبيه ، عن الحارث بن هشام رضي الله عنه قال : ( سألت رسول الله : كيف يأتيك الوحي ؟ قال : أحيانا يأتيني مثل صلصلة الجرس ، فيفصم عني وقد وعيت ما قال ، وهو أشده علي ، وأحيانا يأتيني الملك فيتمثل لي رجلا ويكلمني ، وأعي ما يقول ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12389 عن عبد الرحمن بن الحارث بن هشام المخزومي عن أبيه قال : ( رأيت رسول الله في حجته وهو واقف على راحلته وهو يقول : والله إنك لخير أرض الله ) . ( ابن سعد ، كر ) .(@)(@@)(@@)(@@) |||| 61 ( الحارث بن يمجد رضي الله عنه )(@)(@@)(@@)(@@) $ 12390 عن الحارث بن يمجد عمن حدثه عن رجل يكنى بأبي سعيد قال : قدمت من العالية إلى المدينة ، فما بلغت حتى أصابني جهد ، فبينا أنا أسير في PageV18P302 سوق من أسواق المدينة سمعت رجلا يقول لصاحبه : إن رسول الله قرى الليلة ، فلما سمعت ذكر القرى ، وفي جهد ، أتيت رسول الله فقلت : يا رسول الله ! بلغني أنك قريت الليلة ، قال : أجل ، قال : وما ذاك ؟ قال طعام فيه سخينة ، قلت : فما فعل فضله ؟ قال : رفع ، قلت : يا رسول الله ! أفي أول أمتك يكون موتا أو في آخرها ؟ قال : في أولها ، ثم يلحقوني أفنادا يفنى بعضهم بعضا ) . ( ابن منده ، كر ) .(@)(@@)(@@)(@@) |||| 62 ( الحارث رضي الله عنه غير منسوب )(@)(@@)(@@)(@@) $ 12391 عن حماد بن سلمة ، عن ثابت ، عن حبيب بن سبيعة الضبعي ، عن الحارث : ( أن رجلا كان جالسا عند النبي فمر رجل فقال : يا رسول الله ! إني أحبه في الله ، فقال رسول الله : أعلمته ذلك ؟ قال : لا ، قال : فاذهب ، فقال : أحبك الله الذي أحببتني له ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) |||| 63 ( الحجاج بن عبد الله رضي الله عنه ويقال له : سهيل النصري )(@)(@@)(@@)(@@) $ 12392 عن مكحول قال : ( لما كان يوم بدر قاتلت طائفة من المسلمين وبقيت طائفة عند رسول الله ، فجاءت الطائفة التي قاتلت بالأسلاب وأشياء أصابوها ، فقسمت الغنيمة ولم يقسم للطائفة التي لم تقاتل ، فقالت الطائفة 
ms6327	 التي لم تقاتل : اقسموا لنا ، فأبت ، فكان بينهم في ذلك كلام ، فأنزل الله تعالى : { يسألونك عن الأنفال * قل الأنفال لله والرسول فاتقوا الله وأصلحوا ذات بينكم وأطيعوا الله ورسوله } فكان صلاح ذات بينهم أن ردوا الذي كانوا أعطوا PageV18P303 ما كانوا أخذوا ، قال مكحول : حدثني بهذا الحديث الحجاج بن سهيل النصري ، فما منعني أن أسأله عن إسناده إلا هيبته ) . ( كر ) .(@)(@@)(@@)(@@) $ 12393 عن مكحول عن الحجاج بن عبد الله النصري قال : ( النفل حق لله ولرسوله ) . ( ش ، طب ، والحسن بن سفيان ، والبغوي وأبو نعيم ، كر ) .(@)(@@)(@@)(@@) |||| 64 ( الحجاج بن علاط السلمي رضي الله عنه )(@)(@@)(@@)(@@) $ 12394 عن ابن عباس رضي الله عنهما : ( أن الحجاج بن علاط رضي الله عنه أهدى لرسول الله سيفه ذا الفقار ، ودحية الكلبي رضي الله عنه أهدى له بغلته الشهباء ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12395 عن يحيى بن يعمر الليثي ، حدثني ابن يسار العلاطي من ولد الحجاج بن علاط ، حدثتني جدتي عن أمها أنها سمعت الحجاج بن علاط يقول : ( أذن لي رسول الله في ودائعي التي كانت بمكة أن أكذب حتى اخذها ، فأخبرتهم أن محمدا قد أصيب ، فدفعت إلي ودائعي ، ثم خرجت في جوف الليل حتى أتيت النبي وهو بخيبر فأخبرته بذلك ) . ( كر &(@)(@@)(@@)(@@) $ 1764 ) .(@)(@@)(@@)(@@) $ 12396 عن واثلة بن الأسقع قال : ( كان سبب إسلام الحجاج بن علاط البهزي ، ثم السلمي ، أنه خرج في ركب من قومه يريد مكة ، فلما جن عليهم الليل ، وهم في واد وحش مخيف قفر فقال له أصحابه : يا أبا كلاب ! قم فاتخذ لنفسك ولأصحابك أمانا ، فقام الحجاج فجعل يقول :(@)(@@) [ شعأعيذ نفسي وأعيذ صحبي [ ع(@)(@@) من كل جني بهذا النقب [ / شع(@)(@@) [ شعحتى أؤوب سالما وركبي [ / شع PageV18P304(@)(@@) فسمع قائلا يقول : ( يا معشر الجن والإنس إن استطعتم أن تنفذوا من أقطار السماوات والأرض فانفذوا لا تنفذون إلا بسلطان ) فلما قدموا مكة أخبر بذلك في نادي قريش ، فقالوا : صدقت والله يا أبا كلاب ! إن هذا مما يزعم محمد أنه أنزل عليه ! قال : قد والله سمعته وسمعه هؤلاء معي ! فبينما هم كذلك إذ جاء العاصي 
ms6328	 بن وائل ، فقالوا له : يا أبا هشام ! أما تسمع ما يقول أبو كلاب ؟ قال : وما يقول ؟ فأخبروه بذلك ، فقال : وما يعجبكم من ذلك ؟ إن الذي سمعه هناك هو الذي ألقاه الله على لسان محمد ، فنهنه ذلك القوم عني ولم يزدني في الأمر إلا بصيرة ، فسألت عن النبي ، فأخبرت أنه قد خرج من مكة إلى المدينة ، فركبت راحلتي وانطلقت حتى أتيت النبي بالمدينة ، فأخبرته بما سمعت . فقال : سمعت والله الحق ! هو ولله من كلام ربي عز وجل الذي أنزل علي ، ولقد سمعت حقا يا أبا كلاب ! فقلت : يا رسول الله ! علمني الإسلام ، فشهدني كلمة الإخلاص ، وقال : سر إلى قومك فادعهم إلى مثل ما أدعوك إليه فإنه الحق ) . ( ابن أبي الدنيا في هواتف الجان ، كر ، وفيه أيوب بن سويد ، ومحمد بن عبد الله الليثي ضعيفان ) .(@)(@@)(@@)(@@) |||| 65 ( الحجاج بن عمرو بن غزية المازني رضي الله عنه )(@)(@@)(@@)(@@) $ 12397 عن الحجاج بن عمرو رضي الله عنه قال : ( بحسب أحدكم إذا قام من الليل يصلي حتى يصبح أنه قد تهجد ، أما التهجد : المرء يصلي الصلاة بعد رقدة ، ثم الصلاة بعد رقدة ، وتلك كانت صلاة رسول الله ) . ( طب ، وأبو نعيم ) .(@)PageV18P305(@)(@@)(@@)(@@) |||| 66 ( الحجاج بن مالك الأسلمي رضي الله عنه )(@)(@@)(@@)(@@) $ 12398 عن الحجاج بن الحجاج بن مالك الأسلمي ، عن أبيه قال : ( قلت : يا رسول الله ! ما يذهب عني مذمة الرضاع ؟ قال : غرة عبد أو أمة ) . ( عب ، وأبو نعيم ) .(@)(@@) مسند ( 67 ) الحدرجان بن مالك الأسدي رضي الله عنه ) 3 $(@)(@@)(@@)(@@) $ 12399 عن الحدرجان بن مالك الأسدي ، عن عوانة بن الحكم قال : حدثني خديج خصي لمعاوية ، وكان في سبي فزارة ، فوهبه النبي لابنته فاطمة رضي الله عنها فأعتقته ، وربته فاطمة وعلي فكان بعد ذلك مع معاوية أشد الناس على علي ) . ( . . . ) .(@)(@@)(@@)(@@) $ 12400 قال أبو بشر الدولابي ، حدثنا إسحاق بن إبراهيم الرملي ، حدثنا هاشم بن محمد بن هاشم بن جزء بن عبد الرحمان بن جزء بن الحدرجان بن مالك ، حدثني أبي عن أبيه عن جده ، حدثني أبي جزء بن الحدرجان عن الحدرجان قال : ( قدمت 
ms6329	 أنا وأخي الأسود على رسول الله فآمنا به وصدقناه ، وكان جزء والأسود قد خدما رسول الله وصحباه ) . ( ابن منده وأبو نعيم وقالا : تفرد به إسحاق الرملي ، قال في الإصابة : وهم مجهولون ) .(@)(@@)(@@)(@@) |||| 68 ( الدحداح رضي الله عنه )(@)(@@)(@@)(@@) $ 12401 عن ابن الدحداح رضي الله عنه قال : ( لما نزلت : { من ذا الذي PageV18P306 يقرض الله قرضا حسنا } ، قال ابن الدحداح : آستقرضنا ربنا من أموالنا يا رسول الله ؟ قال : نعم ، قال : فإن لي حائطين : أحدهما بالعالية ، والآخر بالسافلة ، فقد أقرضت ربي خيرهما ، فقال رسول الله : هو لليتيم الذي عندكم ، ثم قال رسول الله : رب عذق لابن الدحداح في الجنة مذلل ) . ( عب ، وابن جرير ، طس ، وفيه إسماعيل بن قيس ضعيف ) .(@)(@@)(@@)(@@) |||| 69 ( الديلمي رضي الله عنه )(@)(@@)(@@)(@@) $ 12402 عن الديلمي رضي الله عنه : ( أنه أسلم وعنده أختان ، فأمره النبي أن يختار أيتهما شاء ويطلق الأخرى ) . ( عب ) .(@)(@@)(@@)(@@) |||| 70 ( الرائسي رضي الله عنه )(@)(@@)(@@)(@@) $ 12403 عن ابن الرائسي ، عن أبيه وكان من أهل هجر ، وكان فقيها قال : ( انطلقت إلى رسول الله في وفد بصدقة حملها إليه ، فنهاهم عن النبيذ في هذه الظروف ، فرجعوا إلى أرضهم ، وهي أرض تهامة حارة ، فاستوخموا فرجعوا إليه العام الثاني في صدقاتهم فقالوا : يا رسول الله ! إنك نهيتنا عن هذه الأوعية وتركناها ، فشق ذلك علينا ، فقال : آذهبوا فاشربوا فيما شئتم ، ولا تشربوا ما أوكىء سقاؤه على إثم ) . ( طب ) .(@)(@@)(@@)(@@) |||| 71 ( السيد الحسن بن الإمام علي رضي الله عنه )(@)(@@)(@@)(@@) $ 12404 عن الحسن عن جابر رضي الله عنه قال : ( قيل يا رسول الله ! أي الأعمال أفضل ؟ قال : الصبر والسماحة ) . ( ع ، هب ) .(@)(@@) PageV18P307(@)(@@)(@@)(@@) $ 12405 عن الحسن رضي الله عنه قال : ( الإيمان : الصبر والسماحة ، الصبر عن محارم الله ، وأداء فرائض الله ) . ( هب ) .(@)(@@)(@@)(@@) $ 12406 عن محمد بن سليم وهو أبو هلال قال : ( سأل أبان الحسن رضي الله عنه وقال : تخاف النفاق ؟ قال : وما يؤمنني منه ، وقد خافه عمر بن الخطاب رضي الله عنه ! ) . ( جعفر الفريابي في صفة المنافقين ) .(@)(@@)(@@)(@@) $ 12407 عن الحسن بن علي رضي الله عنهما : في قوله تعالى : { أصحاب الأخدود } ؟ قال : ( هم الحبشة 
ms6330	 ) . ( ابن المنذر وابن أبي حاتم ) .(@)(@@)(@@)(@@) $ 12408 عن الحسن بن علي رضي الله عنه أنه قيل له : ( إن أبا ذر يقول : الفقر أحب إلي من الغنى ، والسقم أحب إلي من الصحة ، فقال : رحم الله أبا ذر ، أما أنا فأقول : من اتكل على حسن اختيار الله له لم يتمن أنه في غير الحالة التي اختار الله تعالى له : وهذا حد الوقوف على الرضا بما تصرف به القضاء ) . ( كر ) .(@)(@@)(@@)(@@) $ 12409 عن الحسن بن علي رضي الله عنهما : ( أن معاوية سأله عن الكرم والمروءة فقال : أما الكرم فالتبرع بالمعروف ، والإعطاء قبل السؤال ، والإطعام في المحل ؛ وأما المروءة : فحفظ الرجل دينه ، وإحراز نفسه من الدنس ، وقيامه بضيفه ، وأداء الحقوق وإفشاء السلام ) . ( ابن المرزبان ) .(@)(@@)(@@)(@@) $ 12410 عن الحسن بن علي رضي الله عنهما قال : ( كلا فعل رسول الله : قد أهل حين استوت به راحلته ، وقد أهل وهو بالبيداء من الأرض قبل أن تستوي به راحلته ) . ( طب ) .(@)(@@) PageV18P308(@)(@@)(@@)(@@) $ 12411 عن الحسن بن علي رضي الله عنهما : ( أن النبي كان إذا توضأ قصد موضع سجوده بماء حتى يسيله على موضع السجود ) . ( كر ) .(@)(@@)(@@)(@@) $ 12412 عن حبال بن رفيدة قال : ( أتيت الحسن بن علي رضي الله عنهما فقال : ما حاجتك ؟ فقلت : سائل ، فقال : إن كنت تسأل في دم موجع ، أو غرم مفظع ، أو فقر مدقع ، فقد وجب حقك ، وإلا فلا حق لك ، فقلت : إني سائل في إحداهن ، فأمر لي بخمس مائة ، ثم أتيت الحسين بن علي رضي الله عنهما فاستقبلني بمثل ما استقبلني ، ثم أمر لي بمثل ذلك ، ثم أتيت عائشة رضي الله عنها فاستقبلتني بمثل ما استقبلاني به ، ثم أعطتني دون ما أعطياني ) . ( ابن جرير ) .(@)(@@)(@@)(@@) $ 12413 عن الحسن بن علي رضي الله عنهما : ( أنه قال لأبي الأعور السلمي : ألم تعلم أن رسول الله لعن رعلا وذكوان وعمرو بن سفيان ) . ( ع ، كر ) .(@)(@@)(@@)(@@) $ 12414 عن أبي رافع : ( أنه مر بحسن بن علي رضي الله عنهما وحسن يصلي قائما ، وقد غرز ضفيرتين في قفاه ، فحلهما أبو رافع ، فالتفت إليه مغضبا ، فقال له أبو رافع 
ms6331	 : أقبل على صلاتك ولا تغضب ، فإني سمعت رسول الله يقول ذلك كفل الشيطان يقول مقعد الشيطان يعني مغرز ضفيرته ) . ( عب ، وأبو نعيم في المعرفة ) .(@)(@@)(@@)(@@) $ 12415 عن أبي مجلز ، عن فتى من آل علي إما ابن الحسن بن علي ، وإما ابن الحسين بن علي رضي الله عنهما قال : حدثتنا امرأة من أهلنا قالت : ( بينا رسول الله مستلقيا على ظهره يلاعب صبيا على صدره إذ بال ، فقامت لتأخذه ، فقال : دعيه ، ائتني بكوز من ماء ، فأتيته بكوز من ماء ، فنضح الماء PageV18P309 على البول وقال : هكذا يصنع بالبول من الذكر ، ويغسل من الأنثى ) . ( ص ) .(@)(@@)(@@)(@@) $ 12416 عن الحسن بن علي رضي الله عنهما : ( أنه قال لبنيه وبنى أخيه : إنكم صغار قوم يوشك أن تكونوا كبار آخرين ، فتعلموا العلم ، فمن لم يحسن منكم أن يؤديه أو يحفظه فليكتبه وليضعه في بيته ) . ( هق ، في المدخل ، كر ) .(@)(@@)(@@)(@@) $ 12417 عن سفيان قال : ( أتيت حسن بن علي رضي الله عنهما بعد رجوعه من الكوفة إلى المدينة ، فقلت له : يا مذل المؤمنين ! فكان مما احتج علي أن قال : سمعت رسول الله يقول : لا تذهب الأيام والليالي حتى يجتمع أمر هذه الأمة على رجل واسع السرم ، ضخم البلعوم ، يأكل ولا يشبع وهو معاوية فعلمت أن أمر الله واقع ) . ( نعيم بن حماد في الفتن ) .(@)(@@)(@@)(@@) $ 12418 عن أبي يحيى النخعي قال : ( كنت بين الحسن ، والحسين ومروان يتشاتمان ، فجعل الحسن يكف الحسين ، فقال مروان : أهل بيت ملعونون ؛ فغضب الحسن وقال : أقلت : أهل بيت ملعونون ؟ فوالله ! لقد لعنك الله على لسان نبيه وأنت في صلب أبيك وفي لفظ : لقد لعن الله أباك على لسان نبيه وأنت في صلبه ) . / ابن سعد ، ع ، كر ) .(@)(@@)(@@)(@@) $ 12419 عن السيد الحسن رضي الله عنه قال : ( قال النبي : ادعوا لي سيد العرب ، قلت : ألست سيد العرب ؟ قال : أنا سيد ولد ادم ، وعلي سيد العرب ، فلما جاء قال : يا معشر الأنصار ! ألا أدلكم على ما إن تمسكتم به لن تضلوا بعده أبدا ؟ هذا علي فأحبوه بحبي وأكرموه بكرامتي ، فإن جبريل أمرني بالذي قلت 
ms6332	 لكم عن الله عز وجل ) . ( حل ) .(@)(@@) PageV18P310(@)(@@)(@@)(@@) $ 12420 عن عاصم بن ضمرة قال : ( خطب الحسن بن علي رضي الله عنه حين قتل علي فقال : يا أهل العراق ! لقد كان فيكم بين أظهركم رجل قتل الليلة ، وأصيب اليوم ، لم يسبقه الأولون بعلم ، ولا يدركه الآخرون ، كان النبي إذا بعثه في سرية ، كان جبريل عن يمينه ، وميكائل عن يساره ، فلا يرجع حتى يفتح الله عليه ) . ( ش ) .(@)(@@)(@@)(@@) $ 12421 عن هبيرة بن يريم قال : ( سمعت الحسن رضي الله عنه قام خطيبا فخطب الناس فقال : يا أيها الناس ! لقد فارقكم أمس رجل ما سبقه الأولون ، ولا يدركه الآخرون ، ولقد كان رسول الله يبعثه المبعث فيعطيه الراية فما يرجع حتى يفتح الله عليه ، جبريل عن يمينه ، وميكائيل عن شماله ، وما ترك بيضاء ولا صفراء إلا سبعمائة درهم فضلت من عطائه ، أراد أن يشتري بها خادما ) . ( ش ، حم ، وأبو نعيم ، كر ، وأورده ابن جرير من طريق الحسن عن الحسين ) .(@)(@@)(@@)(@@) $ 12422 عن الحسن رضي الله عنه : ( أنه لما قتل علي رضي الله عنه قام خطيبا ، فحمد الله وأثنى عليه ، ثم قال : أما بعد ، والله ! لقد فتلتم الليلة رجلا في ليلة نزل فيها القرآن ، وفيها رفع عيسى بن مريم ، وفيها قتل يوشع بن نون فتى موسى ، وفيها تيب على بني إسرائيل ) . ( ع ، وابن جرير ، كر ) .(@)(@@)(@@)(@@) $ 12423 عن عقبة بن الحارث قال : ( خرجت مع أبي بكر رضي الله عنه من صلاة العصر بعد وفاة رسول الله بليال ، وعلي يمشي إلى جنبه ، فمر بحسن بن علي رضي الله عنهما يلعب مع غلمان فاحتمله على رقبته وهو يقول :(@)(@@) [ شعبأبي شبيه بالنبي [ عليس شبيها بعلي [ / شع(@)(@@) وعلي يضحك ) ( ابن سعد ، حم ، وابن المدني ، خ ، ن ، ك ؛ قال ابن كثير : هذا في حكم المرفوع لأنه في قوة قوله إن رسول الله كان يشبه الحسن ) .(@)(@@) PageV18P311(@)(@@)(@@)(@@) $ 12424 عن الحارث : ( أن عليا رضي الله عنه كان يقول للحسن : خالع سرباله ) . ( ك ) .(@)(@@)(@@)(@@) $ 12425 عن أبي إسحاق قال : ( قال علي رضي الله عنه ونظر إلى وجه ابنه الحسن فقال : إن 
ms6333	 ابني هذا سيد كما سماه النبي ، سيخرج من صلبه رجل يسمى اسم نبيكم ! يشبهه في الخلق ، ولا يشبهه في الخلق ، يملأ في الخلق ، يملأ الأرض عدلا ) . ( د ، ونعيم بن حماد في الفتن ) .(@)(@@)(@@)(@@) $ 12426 عن علي رضي الله عنه قال : ( دخل علينا رسول الله فقال : أين لكع ؟ ههنا لكع ؟ فخرج عليه الحسن وعليه سخاب قرنفل ، وهو ماد يده ، فمد رسول الله يده فالتزمه وقال : بأبي أنت وأمي ! من أحبني فليحب هذا ) . ( كر ) .(@)(@@)(@@)(@@) $ 12427 عن عبد الرحمن بن عوف رضي الله عنه قال : قال عمرو بن العاص ، وأبو الأعور السلمي لمعاوية : إن الحسن بن علي رضي الله عنهما رجل عي ، فقال معاوية : لا تقولا ذلك ! فإن رسول الله قد تفل في فيه ، ومن تفل رسول الله في فيه فليس بعي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12428 عن أبي هريرة رضي الله عنه قال : ( رأيت رسول الله أخذ بيد الحسن بن علي رضي الله عنهما وجعل رجليه على ركبتيه وهو يقول : ترق عين بقه ) . ( وكيع في الغرر ، والرامهرمزي في الأمثال ) .(@)(@@)(@@)(@@) $ 12429 عن أبي هريرة رضي الله عنه قال : ( إن النبي قال للحسن : اللهم ! إني أحبه فأحبه ، وأحب من يحبه ) . ( كر ، حم ) .(@)(@@)(@@)(@@) $ 12430 عن أبي هريرة رضي الله عنه قال : ( خرج النبي إلى بيت PageV18P312 فاطمة رضي الله عنها فخرجت معه ، فقال : أثم لكع ؟ فاحتبس فظننت أنها تلبسه سخابا أو تغسله ، فجاء الحسن يشتد فاعتنقه وقال : اللهم ! إني أحبه فأحبه وأحب من يحبه ) . ( ع ، كر ) .(@)(@@)(@@)(@@) $ 12431 عن أبي هريرة رضي الله عنه قال : ( جلس رسول الله في المسجد وأنا معه فقال : ادعوا لي لكع ، فجاء الحسن رضي الله عنه يشتد حتى أدخل يديه في لحية النبي وجعل النبي يفتح فمه ويدخل فمه في فمه ، ثم قال : اللهم ! إني أحبه فأحبه وأحب من يحبه ثلاث مرات يقولها ) . ( كر ) .(@)(@@)(@@)(@@) $ 12432 عن أبي هريرة رضي الله عنه قال : ( سمعت أذناي هاتان رسول الله وهو آخذ بكفيه جميعا حسنا أو حسينا ، وقدماه على قدم رسول الله وهو يقول : حزقة حزقة ، ترق عين بقه 
ms6334	 ! فترقى الغلام ، حتى يطلع قدميه على صدر رسول الله ، ثم قال له : افتح فاك ، ثم قبله ، ثم قال : اللهم أحبه فإني أحبه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12433 عن أبي هريرة رضي الله عنه قال : ( رأيت رسول الله حامل الحسن بن علي رضي الله عنهما على عاتقه ولعابه يسيل عليه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12434 عن أبي هريرة رضي الله عنه قال : ( رأيت رسول الله يمص لسان الحسن كما يمص الرجل التمرة ) . ( ابن شاهين في الأفراد ، كر ) .(@)(@@)(@@)(@@) $ 12435 عن سعيد المقبري قال : ( كنا مع أبي هريرة رضي الله عنه إذ جاء الحسن بن علي رضي الله عنهما فسلم ، فقال أبو هريرة : وعليك السلام يا سيدي ! سمعت رسول الله يقول : إنه لسيد ) . ( ع ، كر ) .(@)(@@)(@@)(@@) $ 12436 عن عمير بن إسحاق : ( أن أبا هريرة رضي الله عنه لقي PageV18P313 الحسن بن علي رضي الله عنهما فقال : ارفع ثوبك حتى أقبل حيث رأيت النبي يقبل ، فرفع عن بطنه ، فوضع فمه على سرته ) . ( ابن النجار ) .(@)(@@)(@@)(@@) $ 12437 عن ابن عباس رضي الله عنهما قال : ( خرج النبي وهو حامل الحسن رضي الله عنه على عاتقه ، فقال له رجل : يا غلام ! نعم المركب ركبت ! فقال رسول الله : ونعم الراكب هو ) . ( كر ) .(@)(@@)(@@)(@@) $ 12438 عن زهير بن الأقمر ( بينما الحسن بن علي رضي الله عنهما يخطب إذ قام رجل من الأزد ، آدم طوال فقال : لقد رأيت النبي واضعه في حبوته يقول : من أحببني فليحبه ! فليبلغ الشاهد الغائب ) . ( ش ، حم ، وابن منده ، كر ، ك ) .(@)(@@)(@@)(@@) $ 12439 عن زهير بن الأقمر قال : ( بينما الحسن بن علي رضي الله عنهما يخطب إذ قام إليه شيخ من أزد شنوءة فقال : رأيت النبي واضع هذا الذي على المنبر في حبوته وهو يقول : من أحبني فليحبه ! فليبلغ الشاهد الغائب ، ولولا عزمة رسول الله ما حدثت أحدا ) . ( ابن منده ، كر ) .(@)(@@)(@@)(@@) $ 12440 عن البراء بن عازب رضي الله عنه قال : ( رأيت النبي حمل الحسن رضي الله عنه على عاتقه وقال : اللهم ! إني أحبه فأحبه ) . ( ش ، حم ، خ ، م ، ت ، زاد ، كر : وأحب من يحبه ) .(@)(@@)(@@)(@@) $ 12441 عن سودة 
ms6335	 بنت مسرح الكندية قالت : ( كنت فيمن حضر فاطمة رضي الله عنها ضربها المخاض ، فجاء النبي فقال : كيف هي ؟ كيف ابنتي فديتها ؟ قلت : إنها لتجهد يا رسول الله ! قال : فإذا وضعت فلا تحدثي شيئا حتى تؤذنيني ، وفي لفظ : فلا تسبقيني به بشيء ، قالت : فوضعته ، فسررته ولففته في خرقة صفراء ، فجاء رسول الله فقال : ما فعلت ابنتي PageV18P314 فديتها ، وما حالها ، وكيف هي ؟ فقلت : يا رسول الله ! وضعته ، وسررته ، وجعلته في خرقة صفراء ، قال : لقد عصيتني ! قلت : أعوذ بالله من معصية الله ومعصية رسوله ! سررته يا رسول الله ! ولم أجد من ذلك بدا ، قال : ائتيني به ، فأتيته به ، فألقى عنه الخرقة الصفراء ولفه في خرقة بيضاء ، وتفل في فيه وألبأه بريقه ، ثم قال : ادعي لي عليا ، فدعوته ، فقال : ما سميته يا علي ! قال سميته جعفرا يا رسول الله ! قال : لا ، ولكنه حسن ، وبعده حسين ، وأنت أبو الحسن والحسين ) . ( ابن منده ، وأبو نعيم ، كر ، ورجاله ثقات ) .(@)(@@)(@@)(@@) $ 12442 عن عائشة رضي الله عنها : ( أن النبي كان يأخذ حسنا فيضمه إليه ثم يقول : اللهم ! إن هذا ابني وأنا أحبه فأحبه وأحب من يحبه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12443 عن الحسن رضي الله عنه قال : ( رفع النبي الحسن بن علي معه على المنبر فقال : إن ابني هذا سيد ! ولعل الله أن يصلح به بين فئتين من المسلمين ) . ( ش ) .(@)(@@)(@@)(@@) $ 12444 عن محمد بن سيرين قال : ( نظر النبي إلى الحسن بن علي رضي الله عنهما فقال : يا بني ! اللهم سلمه وسلم فيه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12445 عن أبي جعفر قال : ( بينما الحسن رضي الله عنه مع رسول الله إذ عطش فاشتد ظمؤه ، فطلب له النبي ماء فلم يجد ، فأعطاه لسانه فمصه حتى روي ) . ( كر ) .(@)(@@)(@@)(@@) $ 12446 عن سعيد بن زيد قال : ( احتضن رسول الله حسنا رضي الله عنه ثم قال : اللهم ! إني قد أحببته فأحبه ) . ( طب ، وأبو نعيم ) .(@)(@@)(@@)(@@) $ 12447 عن حصين بن عوف الخثعمي قال : ( وفد المقدام بن PageV18P315 معد يكرب ، وعمرو بن الأسود إلى قنسرين ، فقال معاوية للمقدام : أعلمت أن الحسن بن علي رضي الله 
ms6336	 عنهما توفي ؟ فاسترجع المقدام ، فقال له معاوية : أتراها مصيبة ؟ قال : ولم لا أراها مصيبة وقد وضعه رسول الله في حجره فقال : هذا مني ، وحسين من علي ) . ( طب ، عن خالد بن معدان ) .(@)(@@)(@@)(@@) $ 12448 عن الزهري ، عن أنس رضي الله عنه قال : ( كان أشبههم برسول الله الحسن بن علي رضي الله عنهما ) . ( أبو نعيم ) .(@)(@@)(@@)(@@) $ 12449 عن أبي حازم الأشجعي قال : ( رأيت حسين بن علي رضي الله عنهما قدم سعيد بن العاص على الحسن بن علي فصلى عليه ، ثم قال : لولا السنة ما قدمتك ، وسعيد أمير على المدينة يومئد ) . ( طب ، وأبو نعيم ، كر ) .(@)(@@)(@@)(@@) $ 12450 عن الحسن بن علي رضي الله عنهما قال : ( من طلب الدنيا قعدت به ، ومن زهد فيها لم يبال من أكلها ، الراغب فيها عبد لمن يملكها ، أدنى ما فيها يكفي ، وكلها لا تغني ، من اعتدل يومه فيها فهو مغرور ، ومن كان يومه خيرا من غده فهو مغبون ، ومن لم يتفقد النقصان عن نفسه فإنه في نقصان ، ومن كان في نقصان فالموت خير له ) . ( ابن النجار ) .(@)(@@)(@@)(@@) $ 12451 عن الحارث الأعور : ( أن عليا سأل ابنه الحسن رضي الله عنه عن أشياء من المروءة ، قال : يا بني ! ما السداد ؟ قال : يا أبت ! دفع المنكر بالمعروف ، قال : فما الشرف ؟ قال : اصطناع العشيرة ، وحمل الجريرة ، قال : فما المروءة ؟ قال : ( العفاف وإصلاح المرء ماله ، قال : فما الدقة ؟ قال : النظر في اليسير ، ومنع الحقير ، قال : فما اللؤم ؟ قال : إحراز المرء نفسه ، وبذله عرسه ، قال فما السماحة ؟ قال : البذل في العسر واليسر ، قال : فما الشح ؟ قال : أن ترى ما في يديك شرفا ، وما أنفقته تلفا ، قال : فما الإخاء ؟ قال : الوفاء PageV18P316 في الشدة والرخاء ، قال : فما الجبن ؟ قال : الجرأة على الصديق ، والنكول على العدو ، وقال : فما الغنيمة ؟ قال : الرغبة في التقوى ، والزهادة في الدنيا هي الغنيمة الباردة ، قال : فما الحلم ؟ قال : كظم الغيظ ، وملك النفس ، قال : فما الغنى ؟ قال : رضى النفس بما قسم الله لها وإن قل ، فإنما الغنى غنى النفس ، قال : فما الفقر ؟ قال : شره النفس في كل 
ms6337	 شيء ، قال : فما المنعة ؟ قال : شدة البأس ، ومقارعة أشد الناس ، قال : فما الذل ؟ قال : الفزع عند المصدومة ، قال : فما الجرأة ؟ قال : مواقعة الأقران ، قال : فما الكلفة ؟ قال : كلامك فيما لا يعنيك ، قال : فما المجد ؟ قال : أن تعطي في الغرم ، وأن تعفو عن الجرم ، قال : فما العقل ؟ قال : حفظ القلب كل ما استوعيته ، قال : فما الخرق ؟ قال : معاداتك لإمامك ، ورفعك عليه كلامك ، قال : فما السناء ؟ قال : إتيان الجميل ، وترك القبيح ، قال : فما الحزم ؟ قال : طول الأناة ، والرفق بالولاة ، والاحتراس من الناس بسوء الظن هو الحزم ، قال : فما الشرف ؟ قال : موافقة الإخوان ، وحفظ الجيران ، قال : فما السفه ؟ قال : اتباع الدناءة ومصاحبة الغواة ، قال : فما الغفلة ؟ قال : تركك المسجد ، وطاعتك المفسد ، قال : فما الحرمان ؟ قال : تركك حظك وقد عرض عليك ، قال : فما السيد ؟ قال : السيد الأحمق في المال ، المتهاون في عرضه يشتم فلا يجيب ، المتحزن بأمور عشيرته هو السيد ، قال : ثم قال علي رضي الله عنه : يا بني ! سمعت رسول الله يقول : لا فقر أشد من الجهل ، ولا مال أعود من العقل ، ولا وحدة أوحش من العجب ، ولا مظاهرة أوثق من المشاورة ، ولا عقل كالتدبير ، ولا حسب كحسن الخلق ، ولا ورع كالكف ، ولا عبادة كالتفكر ، ولا إيمان كالحياء والصبر وسمعت رسول الله يقول : آفة الحديث الكذب ، آفة العلم النسيان ، وافة الحلم السفه ، وآفة العبادة الفترة ، وافة الظرف الصلف ، وافة الشجاعة البغي ، وافة السماحة المن ، وآفة الجمال الخيلاء ، وافة الحسب الفخر ؛ وسمعت PageV18P317 رسول الله يقول : ينبغي للعاقل إذا كان عاقلا أن يكون له من النهار أربع ساعات : ساعة يناجي فيها ربه جل جلاله ، وساعة يحاسب فيها نفسه ، وساعة يأتي فيها أهل العلم الذين يبصرونه أمر دينه وينصحونه ، وساعة يخلي فيها بين نفسه ولذتها من أمر الدنيا فيما يحل ويجمل ، وينبغي أن لا يكون شاخصا إلا في ثلاث : مرمة لمعاش ، أو خلود لمعاد ، أو لذة في غير محرم وينبغي للعاقل أن يكون في شأنه ، فيحفظ فرجه ولسانه ، ويعرف أهل زمانه ، والعلم خليل الرجل ، والعقل دليله 
ms6338	 ، والحلم وزيره ، والعمل قرينه ، والصبر أمير جنوده ، والرفق والده ، واليسر أخوه ، يا بني ! لا تستخفن برجل تراه أبدا ، إن كان أكبر منك فعد أنه أبوك ، وإن كان قريبا منك فهو أخوك ، وإن كان أصغر منك فاحسب أنه ابنك ) . ( الصابوني في المائتين ، طب ، كر ) .(@)(@@)(@@)(@@) $ 12452 عن الحسن بن علي رضي الله عنهما قال : ( اعلموا أن الحلم زينة ، والوفاء مروءة ، والعجلة سفه ، والسفر ضعف ، ومجالسة أهل الدناءة شين ، ومخالطة أهل الفسق ريبة ) . ( كر ) .(@)(@@)(@@)(@@) $ 12453 عن الحسن بن علي رضي الله عنهما قال : ( الناس أربعة : فمنهم من له خلاق وليس له خلق ، ومنهم من له خلق وليس له خلاق ، ومنهم من ليس له خلق ولا خلاق فذاك شر الناس ، ومنهم من له خلق وخلاق فذاك أفضل الناس ) . ( كر ) .(@)(@@)(@@)(@@) $ 12454 عن جابر رضي الله عنه قال : ( قال رسول الله للحسن : إن ابني هذا سيد ، وليصلحن الله به وفي لفظ : على يديه بين فئتين من المسلمين عظيمتين ) . ( كر ) .(@)(@@)(@@)(@@) $ 12455 عن أبي عبيدة بن الحكم الأزدي : ( أن قوما أتوا الحسن بن علي رضي الله عنهما فذكروا زيادا وجعلوا يقولون : اللهم اجعل قتله بأيدينا ، فقال PageV18P318 الحسن : مه ! فإن في القتل كفارات ولكن أسأل الله أن يميته على فراشه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12456 عن ابن أبي مليكة قال : ( إني لأطوف مع الحسن ابن علي رضي الله عنهما فقيل له : قتل زياد ، فساءه ذلك ، فقلت له : وما يسرك ؟ قال : إن في القتل كفارة لكل مؤمن ) . ( كر ) .(@)(@@)(@@)(@@) $ 12457 عن الحسن بن علي بن أبي طالب رضي الله عنهما ، عن النبي يا علي ! يكون في آخر الزمان قوم لهم نبز يعرفون به يقال لهم الرافضة ، فإن أدركتهم فاقتلهم قتلهم الله فإنهم مشركون ) . ( ابن النجار ) .(@)(@@)(@@)(@@) $ 12458 عن يونس قال : ( تبينت أن الحسن بن علي رضي الله عنهما كان يقول : اللهم تفرد بموت زياد ، فإن في الموت كفارة ) . ( ابن جرير ) .(@)(@@)(@@)(@@) $ 12459 عن أبي بكرة رضي الله عنه قال : ( كان رسول الله يصلي بالناس ، فإذا سجد وثب الحسن رضي الله عنه على ظهره ، أو على عنقه 
ms6339	 ، فرفع رأسه فيضعه وضعا رفيقا لئلا يصرع ، ففعل ذلك غير مرة ، فلما قضى صلاته ضمه إليه وجعل يقبله ، فقالوا : يا رسول الله ! إنك لتفعل بهذا شيئا ما رأيناك تفعله بأحد ! فقال : إن ابني هذا ريحانتي من الدنيا ، وإن ابني هذا سيد ، وسيصلح الله به بين فئتين من المسلمين ) . ( حم ، والروياني ، كر ) .(@)(@@)(@@)(@@) |||| 72 ( السيد الحسين بن الإمام علي رضي الله عنهما )(@)(@@)(@@)(@@) $ 12460 عن أبي حازم الأشجعي قال : ( رأيت حسين ابن علي رضي الله عنهما قدم سعيد بن العاص على الحسن بن علي فصلى عليه ثم قال : لولا أنها السنة ما قدمتك ، وسعيد أمير على المدينة يومئذ ) . ( طب ، وأبو نعيم ، كر ) .(@)(@@) PageV18P319(@)(@@)(@@)(@@) $ 12461 عن أبي العطاف طارق بن مطر بن طارق الطائي الحمصي ، حدثني أبي ، حدثنا صمصامة وضنينة ابنا الطرماح قالا : حدثنا أبو الطرماح قال : سمعت الحسين بن علي رضي الله عنهما يقول : ( كنا مع النبي في الطواف ، فأصابتنا السماء فالتفت إلينا فقال : ائتنفوا العمل فقد غفر لكم ما مضى ) . ( الشيرازي في الألقاب ، كر ، وقال : غريب جدا لم أكتبه إلا من هذا الوجه ) .(@)(@@)(@@)(@@) $ 12462 عن الحسين بن علي رضي الله عنهما قال : ( كان رسول الله أحسن ما خلق الله خلقا ) ( عد ، كر ) .(@)(@@)(@@)(@@) $ 12463 عن عطاء قال : ( كان النبي يأخذ حسينا رضي الله عنه في الصلاة فيحمله قائما حتى إذا سجد وضعه ) . ( عب ) .(@)(@@)(@@)(@@) $ 12464 عن الحسين بن علي رضي الله عنهما : ( أنه كان يقول في قنوت الوتر : اللهم إنك ترى ولا نرى ، وأنت بالمنظر الأعلى وإن إليك الرجعى ، وإن لك الآخرة والأولى ، اللهم إنا نعوذ بك من أن نذل ونخزى ) . ( ش ) .(@)(@@)(@@)(@@) $ 12465 عن فاطمة بنت الحسين ، عن أبيها الحسين رضي الله عنه قال : ( أوصى رسول الله عند موته بثلاث : أوصى أن ينفذ جيش أسامة ، ولا يسكن معه في المدينة إلا أهل دينه ، قال محمد : ونسيت الثالثة ) . ( طب ، عن محمد بن علي بن الحسين ، عن أبيه ، عن جده ) .(@)(@@)(@@)(@@) $ 12466 قال الزبير بن بكار ، حدثني إبراهيم بن حمزة ، حدثني محمد بن عثمان بن أبي حرملة مولى 
ms6340	 بني عثمان عن الحسين بن علي رضي الله عنهما : ( كان ممن ثبت مع رسول الله يوم حنين : العباس وعلي وأبو سفيان بن الحارث ، وعقيل بن أبي طالب ، وعبد الله بن الزبير بن عبد المطلب ، والزبير بن العوام وأسامة بن زيد رضي الله عنهم ) . ( كر ) .(@)(@@)(@@)(@@) $ 12467 عن محمد بن عثمان بن أبي حرملة مولى بني عثمان عن PageV18P320 الحسين بن علي رضي الله عنهم قال : ( كان ممن ثبت مع النبي يوم حنين : العباس وعلي وأبو سفيان بن الحارث ، وعقيل بن أبي طالب ، وعبد الله بن الزبير بن عبد المطلب ، والزبير بن العوام ، وأسامة بن زيد رضي الله عنهم ) . ( كر ) .(@)(@@)(@@)(@@) $ 12468 عن إسماعيل بن رجاء ، عن أبيه قال : ( كنت في مسجد الرسول في حلقة فيها : أبو سعيد الخدري ، وعبد الله بن عمرو رضي الله عنه فمر بنا حسين بن علي رضي الله عنهما فسلم ، فرد عليه القوم ، فقال عبد الله بن عمرو : ألا أخبركم بأحب أهل الأرض إلى أهل السماء ؟ قالوا : بلى ، قال : هو هذا الماشي ، ما كلمني كلمة منذ ليالي صفين ، ولأن يرضى عني أحب إلي من أن يكون لي حمر النعم ، فقال أبو سعيد : ألا تعتذر إليه ؟ قال : بلى ، فاستأذن أبو سعيد ، فأذن له فدخل ، ثم استأذن لعبد الله بن عمرو ، فلم يزل به حتى أذن له ، فأخبره أبو سعيد بقول عبد الله بن عمرو ، فقال له حسين رضي الله عنه : أعلمت يا عبد الله أني أحب أهل الأرض إلى أهل السماء ! قال : إي ورب الكعبة ! قال : فما حملك على أن قاتلتني وأبي يوم صفين ؟ فوالله لأبي كان خيرا مني ! قال : أجل ، ولاكن عمرو شكاني إلى رسول الله فقال : يا رسول الله ! إن عبد الله يقوم الليل ويصوم النهار ، فقال لي رسول الله : يا عبد الله به عمرو ! صل ونم ، وصم وأفطر وأطع عمروا ! فلما كان يوم صفين أقسم علي فخرجت ، أما والله ! ما كثرت لهم سوادا ، ولا اخترطت سيفا ولا طعنت برمح ، ولا رميت بسهم ؛ قال : فكلمه ) . ( كر ) .(@)(@@)(@@)(@@) $ 12469 عن 