ms2458	 أبو سليمان البصري مصنف كتاب العقل.(@)(@@)(@@)(@@) | 2886 - (@)(@@) " داود " بن مدرك عن عروة وعنه موسى بن عبيدة الربذي.(@)(@@)(@@)(@@) | 2887 - (@)(@@) " داود " بن منصور النسائي أبو سليمان الثغري نزيل بغداد قاضي المصيصة.(@)(@@)(@@)(@@) | 2888 - (@)(@@) " داود " بن نصير2 الطائي أبو سليمان العالم الرباني أحد الاعلام الكوفي الزاهد مات سنة ستين ومائة وقيل سنة خمس وستين.(@)(@@)(@@)(@@) | 2889 - (@)(@@) " داود " بن يزيد بن عبد الرحمن الزعافري أبو يزيد الأعرج العطار الكوفي الاودي.(@)(@@)(@@)(@@) | 2890 - (@)(@@) " داود " السراج ثقفي مصري.(@)(@@) 2891 – " داود " الطفاوي هو ابن راشد وهو القسام. PageV07P213(@)(@@)(@@)(@@) | من اسمه دراج ودرست ودغفل(@)(@@)(@@)(@@) | 2892 - (@)(@@) " دراج " أبو السمح قاضي مصر.(@)(@@)(@@)(@@) | 2893 - (@)(@@) " درست3 " بن زياد العنبري روى عن حميد وابن جدعان.(@)(@@)(@@)(@@) | 2894 - (@)(@@) " دغفل4 " بن حنظلة بن زيد السدوسي الشيباني الذهلي مخضرم عالم النسب. PageV07P213(@)(@@)(@@)(@@) | من اسمه دفاع ودلهم ودهثم(@)(@@)(@@)(@@) | 2895 - (@)(@@) " دفاع5 " بن دغفل القيسي بالقاف أبو روح البصري.(@)(@@)(@@)(@@) | 2896 - (@)(@@) " دلهم " بن الأسود بن عبد الله بن صاحب العقيلي بالضم.(@)(@@)(@@)(@@) | 2897 - (@)(@@) " دلهم " بن صالح الكندي الكوفي عن الشعبي. PageV07P213(@)(@@)(@@)(@@) | 2898 - (@)(@@) " دهثم " بن قران العكلي أو الحنفي اليمامي.(@)(@@) PageV07P214(@)(@@)(@@)(@@) | من اسمه ديسم وديلم ودينار(@)(@@)(@@)(@@) | 2899 - (@)(@@) " ديسم1 " السدوسي عنه أيوب السجستاني.(@)(@@)(@@)(@@) | 2900 - (@)(@@) " ديلم " بن غزوان العبدي أبو غالب البراء بتشديد الراء بصري.(@)(@@)(@@)(@@) | 2901 - (@)(@@) " دينار " عن ابن عمر وعن ابن الحنفية.(@)(@@)(@@)(@@) | 2902 - (@)(@@) " دينار " بن عمرو بن الحارث. PageV07P214(@)(@@)(@@)(@@) | حرف الذال المعجمة(@)(@@)(@@)(@@) | من اسمه ذر وذيال(@)(@@)(@@)(@@) | 2903 - (@)(@@) " ذر " بن عبد الله المرهبي2 الهمداني الكوفي عن سعيد بن جبير وسعيد بن عبد الرحمن بن أبزي وعنه ابنه عمر ومنصور والحكم.(@)(@@)(@@)(@@) | 2904 - (@)(@@) " ذيال " بن عبيد بن حنظلة الحنفي قال ابن معين ثقة وقال الأزدي فيه نظر. PageV07P214(@)(@@)(@@)(@@) | حرف ا