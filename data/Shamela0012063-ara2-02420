ms2401	(@)(@@) PageV07P108(@)(@@) فليحب القرآن ومن أحب القرآن فليحب المساجد".(@)(@@) 1174 – " أبو معمر " تقدم في ترجمة الحارث بن الحجاج أن الدارقطني قال فيه وفي شيخ أبي معشر الراوي عن سالم مجهولان فيحتمل أن يكون هو الراوي عن أنس رضى الله عنه والذي يظهر لي أنه غيره.(@)(@@) 1175 – " أبو معمر " شيخ لأبي داود الطيالسي اسمه حبان بكسر المهملة بعدها موحدة بن زهير.(@)(@@) 1176 – " أبو معمر " التميمي اسمه حفص.(@)(@@) 1177 – " أبو معن " الأيلي عن وبيض لا يدري من هو انتهى وذكره ابن حبان في الثقات وقال روى عن جابر بن يزيد.(@)(@@) 1178 – " أبو معين " هو ثمامة بن اشرس المعتزلي.(@)(@@) 1179 – " أبو المغيث " الحموي اسمه محمد بن عبد الله.(@)(@@) PageV07P109(@)(@@)(@@)(@@) | من كنيته أبو المغيرة وأبو المفاخر وأبو المفضل(@)(@@) 1180 – " أبو المغيرة " القواس عن عبد الله بن عمر وذكره سليمان التيمي ولينه وقال ابن المديني لا اعلم أحدا روى عنه غير عوف انتهى وقال إسحاق بن منصور عن يحيى بن معين ثقة وذكره ابن حبان في الثقات.(@)(@@) 1181 – " أبو المفاخر " النيسابوري هو الحسن بن ذي النون.(@)(@@) 1182 – " أبو المفضل " شيباني اسمه محمد بن عبد الله.(@)(@@) 1183 – " أبو المفضل " بن العلاء بن عبد الرحمن اسمه شبل بكسر الشين المعجمة وسكون الموحدة تقدم.(@)(@@) PageV07P109(@)(@@)(@@)(@@) | من كنيته أبو مقاتل وأبو المقدام وأبو مكيس(@)(@@) 1184 – " أبو مقاتل " السمرقندي أحد التلفى اسمه حفص بن سلم1 قد ذكره. PageV07P109(@)(@@) 1185 – " أبو المقدام " بن عمرو اسمه إسماعيل.(@)(@@) 1186 – " أبو المقدام " بن شروس اسمه إسماعيل الصغاني يروي عن عكرمة وقد مر.(@)(@@) 1187 – " أبو مكيس " اسمه دينار تقدم.(@)(@@) PageV07P110(@)(@@)(@@)(@@) | من كنيته أبو المليح وأبو مليح وأبو المناقب(@)(@@) 1188 – " أبو المليح " الهذلي عن أبي صالح السمان المدني وعنه مروان بن معاوية الفزاري اخرج له الحاكم في المستدرك في كتاب الدعاء واعترف بأنه في عدد المجهولين انتهى ووقع عنده أبو الفتح الفارسي.(@)(@@) 1189 – " أبو مليح " كالأول لكن مصغر هو الحسن بن يوسف الطرائفي المصري.(@)(@@) 1190 – " أبو المناقب " العلوي اسمه محمد بن حمزة بن إسماعيل.(@)(@@)(@@)(@@) | 1191 - (@)(@@) " أبو المناقب " القزويني اسمه محمد بن أحمد 
ms2402	 بن إسماعيل.(@)(@@) PageV07P110(@)(@@)(@@)(@@) | من كنيته أبو المنذر(@)(@@)(@@)(@@) | 1192 - (@)(@@) " أبو المنذر " بن أبي الصهباء اسمه سلام البصري الفزاري.(@)(@@)(@@)(@@) | 1193 - (@)(@@) " أبو المنذر " هو أسد بن عمرو الفقيه.(@)(@@)(@@)(@@) | 1194 - (@)(@@) "أبو المنذر" اسمه هشام بن محمد بن السائب بن الكلبي.(@)(@@)(@@)(@@) | 1195 - (@)(@@) " أبو المنذر " تابعي أرسل حديثا لا يدري من هو.(@)(@@)(@@)(@@) | 1196 - (@)(@@) " أبو المنذر " شيخ لمعتمر اسمه حسين.(@)(@@) PageV07P110(@)(@@)(@@)(@@) | من كنيته "أبو منصور.(@)(@@)(@@)(@@) | 1197 - (@)(@@) " أبو منصور " بن سكرويه اسمه محمد بن أحمد القاضي الأصبهاني.(@)(@@)(@@)(@@) | 1198 - (@)(@@) " أبو منصور " العباداني وهاه أبو الفتح الأزدي.(@)(@@)(@@)(@@) | 1199 - (@)(@@) " أبو منصور " النهرواني اسمه سليمان ابن محمد1. PageV07P110(@)(@@)(@@)(@@) | 1200 - (@)(@@) " أبو منصور " اللغوي اسمه محمد بن علي بن عمر.(@)(@@)(@@)(@@) | 1201 - (@)(@@) " أبو منصور " الرازي اسمه إبراهيم بن علي بن محمد.(@)(@@)(@@)(@@) | 1202 - (@)(@@) " أبو منصور " الحربي هو أحمد بن الحسين بن علي بن عمر.(@)(@@)(@@)(@@) | 1203 - (@)(@@) " أبو منصور " الكرخي اسمه محمد بن طاهر.(@)(@@)(@@)(@@) | 1204 - (@)(@@) " أبو منصور " البندنيجي هو ناشب بنون ومعجمة ثم موحدة بن هلال بن نصر الحراني.(@)(@@)(@@)(@@) | 1205 - (@)(@@) " أبو منصور " الرومي اسمه برغش بن عبد الله.(@)(@@)(@@)(@@) | 1206 - (@)(@@) " أبو منصور " له ذكر في الفضل بن عطارد.(@)(@@) PageV07P111(@)(@@)(@@)(@@) | من كنيته أبو المنيب وأبو المفاخر(@)(@@)(@@)(@@) | 1207 - (@)(@@) " أبو المنيب " أرسل حديثا لا يعرف روى بقية عن مسلم بن زياد عنه انتهى قال ابن أبي حاتم سألت أبي عنه فقال لا أعرفه وقال أبو زرعة شيخ مجهول.(@)(@@)(@@)(@@) | 1208 - (@)(@@) " أبو المنيب " الأحدب الشامي روى عن معاذ بن جبل وغيره من الصحابة وعنه عاصم وأبو عطاء فرق البخاري وتبعه بن أبي حاتم وابن صاعد بينه وبين بن المنيب الجرشي وقال الحاكم أبو أحمد: ما أراهما إلا واحد وقال غيره الصواب مع البخاري أن الجرشي بصري والأحدب شامي وقد نقل ابن خفيف الصوفي عن العقيلي أن البخاري قال: في هذا ليس بشيء ووهم ابن خفيف فان البخاري: إنما قال ذلك في ابن منيب المروزي واسمه عبيد الله وهو من رجال التهذيب.(@)(@@)(@@)(@@) | 1209 - (@)(@@) " أبو المنيب " آخر فرق الحاكم بينه وبين الجرشي فاورد له من طريق عبيد الله بن زحر عنه عن يحيى بن أبي كثير عن أبي سلمة عن 
ms2403	 أبي هريرة رضى الله عنه رفعه في الأمر بالتستر عند الخلاء وبه عن يحيى بن أبي كثير عن الحسن مثله مرسلا قال أبو أحمد: هذا حديث منكر وعبيد الله بن زحر منكر الحديث وأبو المنيب(@)(@@) PageV07P111(@)(@@) رجل مجهول قلت: أقر شيخنا هذا وما أظنه إلا الجرشي لأنه شامي ويحيى بن أبي كثير أبو النضر يمامي.(@)(@@)(@@)(@@) | 1210 - (@)(@@) " أبو المهاجر " هو سابق بن عبد الله الرقي.(@)(@@) PageV07P112(@)(@@)(@@)(@@) | من كنيته أبو مهدي وأبو مهرية وأبو المهلب وأبو المهند(@)(@@)(@@)(@@) | 1211 - (@)(@@) " أبو مهدي " الأعرابي شيخ للاصمعي ذكر أبو جعفر القاري راوي كتاب البحار لأبي عبيدة عنه أن الأصمعي ذكر عن أبي مهدي عن أبي هريرة حديثا قال أبو جعفر: كان أبو مهدي من فصحاء الناس وقال الأصمعي: أنه خولط في عقله في آخر دهره وقال: فمررت به يوما يماري بنسوة قيام فسمعته يقول: رأيت الشعراء في النار ولهم كصيص قال أبو جعفر: الكصيص بالمهملة الصوت الخفي وذكر بقية القصة.(@)(@@)(@@)(@@) | 1212 - (@)(@@) " أبو مهرية " عن أبي امامة لا يعرف.(@)(@@)(@@)(@@) | 1213 - (@)(@@) " أبو المهلب " محمود بن غيلان اسقطه أحمد ويحيى بن معين وأبو خيثمة.(@)(@@)(@@)(@@) | 1214 - (@)(@@) " أبو المهند " الغداني اسمه فضال بن جبير صاحب أبي امامة.(@)(@@) PageV07P112(@)(@@)(@@)(@@) | من كنيته أبو الموال وأبو المورع وأبو موسى وأبو موهوبة(@)(@@)(@@)(@@) | 1215 - (@)(@@) " أبو الموال ".(@)(@@)(@@)(@@) | 1216 - (@)(@@) " أبو المورع " عن علي لا يعرفان.(@)(@@)(@@)(@@) | 1217 - (@)(@@) " أبو موسى " المصيصي هو هارون بن زياد.(@)(@@)(@@)(@@) | 1218 - (@)(@@) " أبو موسى " الطائي اسمه عبد الله بن الفضل الأنباري.(@)(@@)(@@)(@@) | 1219 - (@)(@@) " أبو موسى " الهمداني عن الوليد بن عقبة بن معيط وعنه ثابت بن الحجاج قال البخاري: في التاريخ الأوسط اسمه عبد الله لا يعرف ولا يتابع عليه.(@)(@@)(@@)(@@) | 1220 - (@)(@@) " أبو موسى " الصيرفي اسمه عمران.(@)(@@) PageV07P112(@)(@@)(@@)(@@) | 1221 - (@)(@@) " أبو موسى " الصفار عن ابن عباس وعنه موسى بن المغيرة مجهول.(@)(@@)(@@)(@@) | 1222 - (@)(@@) " أبو موسى " عن علي وعنه رميح مجهول.(@)(@@)(@@)(@@) | 1223 - (@)(@@) " أبو موسى " في ترجمة طريف بن زيد.(@)(@@)(@@)(@@) | 1224 - (@)(@@) " أبو موسى " الهروي اسمه إسحاق بن إبراهيم.(@)(@@)(@@)(@@) | 1225 - (@)(@@) " أبو موسى " بن الهيثم اسمه عيسى.(@)(@@)(@@)(@@) | 1226 - (@)(@@) " أبو موهوبة " اسمه رشيد.(@)(@@) PageV07P113(@)(@@)(@@)(@@) | من كنيته أبو ميسرة وأبو ميمون(@)(@@)(@@)(@@) | 1227 
ms2404	 - (@)(@@) " أبو ميسرة " النهاوندي اسمه أحمد بن عبد الله.(@)(@@)(@@)(@@) | 1228 - (@)(@@) " أبو ميمون " الصوري اسمه أيوب بن محمد.(@)(@@)(@@)(@@) | 1229 - (@)(@@) " أبو ميمون " الربيعي اسمه سالم.(@)(@@)(@@)(@@) | 1230 - (@)(@@) " أبو ميمون " عن أبي هريرة وعنه قتادة قال الدارقطني: مجهول يترك.(@)(@@) PageV07P113(@)(@@)(@@)(@@) | حرف النون(@)(@@)(@@)(@@) | من كنيته أبو ناشرة وأبو نصر(@)(@@)(@@)(@@) | 1231 - (@)(@@) " أبو ناشرة " لا يعرف.(@)(@@)(@@)(@@) | 1232 - (@)(@@) " أبو نصر " شيخ لحماد بن سلمة قال يحيى بن معين اسمه زيد قلت: ولا يعرف.(@)(@@)(@@)(@@) | 1233 - (@)(@@) " أبو نصر " الأنماطي اسمه معمر بن محمد.(@)(@@)(@@)(@@) | 1234 - (@)(@@) " أبو نصر " البار اسمه إبراهيم بن الفضل.(@)(@@)(@@)(@@) | 1235 - (@)(@@) " أبو نصر " بن الوبار اسمه أحمد بن محمد بن أحمد بن ميمون السلمي الغزال.(@)(@@)(@@)(@@) | 1236 - (@)(@@) " أبو نصر " الخباز اسمه أحمد بن مسرور.(@)(@@)(@@)(@@) | 1237 - (@)(@@) " أبو نصر " بن عساكر1 اسمه عبد الرحيم بن محمود بن الحسن. PageV07P113(@)(@@)(@@)(@@) | 1238 - (@)(@@) " أبو نصر " بن ودعان اسمه محمد بن علي الموصلي.(@)(@@)(@@)(@@) | 1239 - (@)(@@) " أبو نصر " السكري التاجر اسمه محمد بن الحسن بن جعفر.(@)(@@)(@@)(@@) | 1240 - (@)(@@) " أبو نصر " بن الباوردي اسمه منصور بن عبد الحميد.(@)(@@)(@@)(@@) | 1241 - (@)(@@) " أبو نصر " الوزيري اسمه محمد بن طاهر.(@)(@@)(@@)(@@) | 1242 - (@)(@@) " أبو نصر " بن حمدويه البغدادي اسمه أحمد بن عبد الله بن محمد.(@)(@@)(@@)(@@) | 1243 - (@)(@@) " أبو نصر " البجلي اسمه الفضل بن الحسن.(@)(@@)(@@)(@@) | 1244 - (@)(@@) " أبو نصر " عن علي في القارن يسعى سعيين لا يدري من هو روى له الدارقطني انتهى وقد تقدم في ترجمة ولده عبد الرحمن قال ابن حبان في ترجمة عبد الرحمن روى عن أبيه مناكير وأبوه مجهول لا يدري من هو ولا يعلم له سماع من علي قلت: وخبط فيه الأزدي كما تقدم في عبد الرحمن.(@)(@@)(@@)(@@) | 1245 - (@)(@@) " أبو نصر " الهمداني الصوفي اسمه عبد الرحمن بن محمد.(@)(@@)(@@)(@@) | 1246 - (@)(@@) " أبو نصر " الأنصاري اسمه أحمد بن عبد الله.(@)(@@)(@@)(@@) | 1247 - (@)(@@) " أبو نصر " عن هانئ بن المتوكل هو مكدوح بن محمد بن ساكن.(@)(@@) PageV07P114(@)(@@)(@@)(@@) | من كنيته أبو نعامة وأبو النعمان(@)(@@)(@@)(@@) | 1248 - (@)(@@) " أبو نعامة " الأسدي شيخ للحسن بن صالح لا يعرف.(@)(@@)(@@)(@@) | 1249 - (@)(@@) " أبو نعامة " شيخ لأبي جهضم لا يعرف.(@)(@@)(@@)(@@) | 1250 - (@)(@@) " أبو النعمان " الأنصاري يروي عن هشام بن عروة بمناكير قال ابن حبان: لا 
ms2405	 يجوز الاحتجاج به بحال محمد بن أبي السري حدثنا رواد بن الجراح ثنا أبو النعمان عن هشام بن عروة عن أبيه عن عائشة مرفوعا "من رابط ثلاث ليال سود فقد أدرك رباط سنة".(@)(@@)(@@)(@@) | 1251 - (@)(@@) " أبو النعم " أن ابن عبد الله بن كعب بن مالك عن أبيه عن جده قال العلائي في الوشي: لا أعرفه وليس هو عبد الرحمن ذاك يكنى أبا الخطاب.(@)(@@) PageV07P114(@)(@@)(@@)(@@) | من كنيته "أبو نعيم".(@)(@@)(@@)(@@) | 1252 - (@)(@@) " أبو نعيم " الحافظ الأصبهاني اسمه أحمد بن عبد الله بن إسحاق.(@)(@@)(@@)(@@) | 1253 - (@)(@@) " أبو نعيم " البلخي قال محمود بن غيلان ضرب أحمد وابن معين وأبو خيثمة على حديثه واسقطوه.(@)(@@)(@@)(@@) | 1254 - (@)(@@) " أبو نعيم " بن قيراط اسمه.(@)(@@)(@@)(@@) | 1255 - (@)(@@) " أبو نعيم " عن محمد بن زياد وعنه مندل بن علي مجهول.(@)(@@)(@@)(@@) | 1256 - (@)(@@) " أبو نعيم " هو اسمه عمر بن صبيح.(@)(@@) PageV07P115(@)(@@)(@@)(@@) | من كنيته أبو نهشل وأبو نواس وأبو نوح وأبو النيل(@)(@@)(@@)(@@) | 1257 - (@)(@@) " أبو نهشل " عن أبي وائل وعنه المسعودي لا يعرف.(@)(@@)(@@)(@@) | 1258 - (@)(@@) " أبو نواس " الشاعر المفلق اسمه الحسن بن هانئ شعره في الذروة ولكن فسقه ظاهر وتهتكه واضح فليس بأهل أن يروي عنه له رواية عن حماد بن سلمة وغيره توفي سنة نيف وتسعين ومائة انتهى وأرخه بن الجوزي سنة خمس وتسعين وقيل عاش إلى رأس المأتين وقيل: قبلها بسنة أو سنتين وهو الحسن بن هانئ بن جناح بن عبد الله بن الجراح يكنى أبا علي الحكمي ولد بالأهواز ونشأ بالبصرة وتأدب بابي زيد وأبي عبيدة وتلمذ لوالبة بن الحباب قال الجاحظ ما رأيت أفصح لهجة منه وحدث عن حماد وعبد الواحد بن زياد ومعتمر بن سليمان وغيرهم روى عنه محمد بن إبراهيم بن كثير وناس قليل وكان شيخه أبو عبيدة يقول: هو للمستحدثين كامرء القيس للمتقدمين واشتهر بالتقدم في وصف الخمر حتى كان لا يوجد لاحد من أهل عصره شيء في وصف الخمر إلا نسب لأبي نواس وأكثر من النظم في المجون ولا سيما في الغلمان ويصرح(@)(@@) PageV07P115(@)(@@) كثيرا بالفاحشة وزعم بن المعتمر أنه كان لا يتمكن من فعل شيء 
ms2406	 من ذلك مع اشتهاره بالفسق وقال ابن الجوزي: غلب عليه اللهو فلا أحب أن اذكر شيئا من أفعاله المذمومة لأنه ذكر عنه التوبة في آخر عمره ويقال: أنه عاش ستين سنة إلا سنة.(@)(@@)(@@)(@@) | 1259 - (@)(@@) " أبو نوح " اسمه قاسم.(@)(@@)(@@)(@@) | 1260 - (@)(@@) " أبو النيل " روى عن عمر بن عبد العزيز لا يدري من هو.(@)(@@) PageV07P116(@)(@@)(@@)(@@) | حرف الهاء(@)(@@)(@@)(@@) | من كنيته أبو هارون(@)(@@) ".(@)(@@)(@@)(@@) | 1261 - (@)(@@) " أبو هارون " الخريبي عن عبد الله بن يوسف القيسي بخبر باطل انتهى وقد تقدم في إسماعيل بن محمد بن يوسف.(@)(@@)(@@)(@@) | 1262 - (@)(@@) " أبو هارون " عن أبي وهب الكلاعي وعنه الوليد بن مسلم لا يعرف.(@)(@@)(@@)(@@) | 1263 - (@)(@@) " أبو هارون " عن الحكم بن عيينة واه تكلم فيه وهو شامي قال الجوزجاني ساقط انتهى وذكره ابن عدي.(@)(@@)(@@)(@@) | 1264 - (@)(@@) " أبو هارون " النميري هو عمرو بن عبد الله.(@)(@@)(@@)(@@) | 1265 - (@)(@@) " أبو هارون " بن المطلب اسمه عيسى.(@)(@@)(@@)(@@) | 1266 - (@)(@@) " أبو هارون " الغنوي اسمه إبراهيم بن العلاء.(@)(@@) PageV07P116(@)(@@)(@@)(@@) | من كنيته أبو هاشم وأبو هانئ(@)(@@)(@@)(@@) | 1267 - (@)(@@) " أبو هاشم " الجبائي شيخ المعتزلة وابن شيخهم أبي علي هو عبد السلام.(@)(@@)(@@)(@@) | 1268 - (@)(@@) " أبو هاشم " بن محمد الحميري الشاعر اسمه إسماعيل بن محمد.(@)(@@)(@@)(@@) | 1269 - (@)(@@) " أبو هاشم " بن بنت داود بن أبي هند اسمه إسحاق بن عيسى.(@)(@@)(@@)(@@) | 1270 - (@)(@@) " أبو هاشم " اسمه زياد صوابه أبو هاشم.(@)(@@) PageV07P116(@)(@@)(@@)(@@) | 1271 - (@)(@@) " أبو هاشم " هو الذي قبله.(@)(@@)(@@)(@@) | 1272 - (@)(@@) " أبو هاشم " المالكي اسمه هانئ.(@)(@@)(@@)(@@) | 1273 - (@)(@@) " أبو هاشم " النخعي اسمه خضر بن مسلم.(@)(@@)(@@)(@@) | 1274 - (@)(@@) " أبو هاشم " الواسطي هو رحمة بن مصعب.(@)(@@)(@@)(@@) | 1275 - (@)(@@) " أبو هاشم " الإسكندراني هو هانئ بن المتوكل.(@)(@@)(@@)(@@) | 1276 - (@)(@@) " أبو هانئ " ذكره يحيى بن معين هكذا وقال ضعيف.(@)(@@)(@@)(@@) | 1277 - (@)(@@) " أبو هانئ " الأصبهاني بن خليفة.(@)(@@)(@@)(@@) | 1278 - (@)(@@) " أبو هانئ " بن بسر اسمه عمير.(@)(@@) PageV07P117(@)(@@)(@@)(@@) | من كنيته أبو هدبة وأبو الهذيل وأبو هرمز(@)(@@)(@@)(@@) | 1279 - (@)(@@) " أبو هدبة " اسمه إبراهيم بن هدبة.(@)(@@)(@@)(@@) | 1280 - (@)(@@) " أبو الهذيل " البصري اسمه مخلد بن عبد الواحد.(@)(@@)(@@)(@@) | 1281 - (@)(@@) " أبو الهذيل " العلاف شيخ المعتزلة هو محمد بن الهذيل.(@)(@@)(@@)(@@) | 1282 - (@)(@@) " أبو الهذيل " آخر هو الحكيم بن سليمان.(@)(@@)(@@)(@@) | 1283 - (@)(@@) " أبو هرمز " نافع مر.(@)(@@) PageV07P117(@)(@@)(@@)(@@) | من كنيته أبو هريرة وأبو هزان وأبو هشام(@)(@@)(@@)(@@) | 1284 
ms2407	 - (@)(@@) " أبو هريرة " عن مكحول وعنه أبو المليح الرقي لا يعرف.(@)(@@)(@@)(@@) | 1285 - (@)(@@) " أبو هريرة " بن أبي خلف أو مولى بن أبي خلف قيل اسمه ايمن عن محمد بن المبارك الصوري وعنه أحمد بن يحيى بن خالد الرقي غريب أورده الدارقطني في الغرائب وقال: أنه باطل قلت: ورواته ثقات إلا هذا.(@)(@@)(@@)(@@) | 1286 - (@)(@@) " أبو هزان " اسمه يزيد بن سمرة.(@)(@@)(@@)(@@) | 1287 - (@)(@@) " أبو هشام " القناد كان يتبع الحسين حدث عنه كامل بن طلحة لا يعرف(@)(@@) PageV07P117(@)(@@) وخبره منكر أخبرنا أحمد بن هبة الله قال أنا عبد العزيز بن محمد إجازة قال أنا تميم انا الكنجرودي أنا أبو عمرو البختري انا أبو يعلى الموصلي ثنا كامل بن طلحة الجحدري قال ثنا أبو هشام القناد عن الحسين بن علي رضى الله عنهما عن النبي صلى الله عليه وآله وسلم قال: "المغبون لا مأجور ولا محمود".(@)(@@)(@@)(@@) | 1288 - (@)(@@) " أبو هشام " عن أبي حرة اسمه سلمة بن سليمان الضبي تقدم.(@)(@@)(@@)(@@) | 1289 - (@)(@@) " أبو هشام " عن أبي معاذ مجهول كشيخه حدث عنه سهل بن عثمان العسكري.(@)(@@)(@@)(@@) | 1290 - (@)(@@) " أبو هشام " والدابي المقدام اسمه زياد مر ذكره قريبا في أبي هاشم.(@)(@@) PageV07P118(@)(@@)(@@)(@@) | من كنيته أبو هفان وأبو هلال وأبو همام(@)(@@)(@@)(@@) | 1291 - (@)(@@) " أبو هفان " الشاعر الخرنوبي حدث عن الأصمعي بخبر منكر قال ابن الجوزي: لا يعول عليه انتهى وقد تقدم في الأسماء في عبد الله بن أحمد بن حرب.(@)(@@)(@@)(@@) | 1292 - (@)(@@) " أبو هلال " الثعلبي1 عن ابن عباس وعنه أبو إسحاق لا يعرف وذكره البخاري في الضعفاء وسماه عميرا وقال لا يتابع عليه.(@)(@@)(@@)(@@) | 1293 - (@)(@@) " أبو همام " البصري حكى عنه الأوزاعي قال أبو زرعة: لا يعرف.(@)(@@)(@@)(@@) | 1294 - (@)(@@) " أبو همام " آخر اسمه سعيد بن محمد البكرواي. PageV07P118(@)(@@)(@@)(@@) | من كنيته أبو همدان وأبو هند(@)(@@)(@@)(@@) | 1295 - (@)(@@) " أبو همدان " هو قاسم بن مهران قاضي هيت قال ابن عدي كذاب انتهى وقد تقدم في الأسماء مطولا2.(@)(@@)(@@)(@@) | 1296 - (@)(@@) " أبو هند " الصديق عن نافع مولى بن عمر رضى الله عنهما لا يعرف وعنه أبو خالد الدالاني ذكره ابن عدي في ترجمة الدالاني وذكر أن بعض الرواة صحفه PageV07P118(@)(@@) وإنما 
ms2408	 الحديث لإبراهيم الصائغ عن نافع.(@)(@@)(@@)(@@) | 1297 - (@)(@@) " أبو هند " عن أنس بن مالك رضى الله عنه بحديث الطير وعنه أبو عاصم لا يعرف.(@)(@@)(@@)(@@) | 1298 - (@)(@@) " أبو هند " عن أبي طالوت وعنه معتمر بن سليمان لا يعرف وكأنه الأول.(@)(@@) PageV07P119(@)(@@)(@@)(@@) | من كنيته "أبو هنيدة وأبو الهيثم.(@)(@@)(@@)(@@) | 1299 - (@)(@@) " أبو هنيدة " عن أبي معاوية وعنه داود بن أبي هند لا يعرف انتهى وذكره ابن حبان في الثقات1.(@)(@@)(@@)(@@) | 1300 - (@)(@@) " أبو الهيثم " البصري عن سعيد بن أبي عمرو عبد الحكم بن محمد لا يعرف.(@)(@@)(@@)(@@) | 1301 - (@)(@@) " أبو الهيثم " عن الزهري وعنه بقية لا يعرف.(@)(@@)(@@)(@@) | 1302 - (@)(@@) " أبو الهيثم " عن ابن أبي عروبة لا يعرف.(@)(@@)(@@)(@@) | 1303 - (@)(@@) " أبو الهيثم " العبدي عن أبي مجلز قال ابن حبان: منكر الحديث قلت: لعل النكارة من غيره روى حديثه جبارة بن المغلس عن شريك عن أبي الهيثم العبدي عن أبي مجلز عن معاوية مرفوعا من ركب على النمار لم يصحب الملائكة قلت: واتى عن مالك بخبر منكر رواه عنه إسحاق بن الفرات انتهى والخبر المذكور في كتاب قضاء الحوائج لابن أبي الدنيا في باب شكر الصنعة وإسناده صحيح ومتنه منكر كما قال المصنف وأخرجه الدارقطني في غرائب مالك من طريق إسحاق بن الفرات عنه عن مالك عن الزهري عن ابن أبي حدرد الأسلمي قال الحديث في خلافة عمر فذكر أنه لقي محمد بن مسلمة فقال كنت عند رسول الله صلى الله عليه وآله وسلم فقال لحسان PageV07P119(@)(@@) ابن ثابت: "أنشدني من شعر الجاهلية" فأنشده قصيدة للاعشى فذكر القصة قال الدارقطني أبو الهيثم العبدي مجهول وهذا غير محفوظ عن مالك ولا عن الزهري.(@)(@@)(@@)(@@) | 1304 - (@)(@@) " أبو الهيثم " الفرضي عن موسى بن عقبة قال الأزدي: كذاب.(@)(@@)(@@)(@@) | 1305 - (@)(@@) " أبو الهيثم " العمري اسمه خالد بن يزيد المكي الحذاء كما تقدم في حرف الخاء المعجمة.(@)(@@) PageV07P120(@)(@@)(@@)(@@) | حرف الواو(@)(@@)(@@)(@@) | من كنيته أبو الوازع وأبو واقد وأبو الورد.(@)(@@)(@@)(@@) | 1306 - (@)(@@) " أبو الوازع " اسمه زهير بن مالك يروي عن ابن عمر رضى الله عنهما.(@)(@@)(@@)(@@) | 1307 - (@)(@@) " أبو واقد " السلاب عن مالك بن أبي الرحال مجهول.(@)(@@)(@@)(@@) | 1308 - (@)(@@) " أبو واقد " عن 
ms2409	 ابن عون لا يعرف.(@)(@@)(@@)(@@) | 1309 - (@)(@@) " أبو الورد " العتكي اسمه هلال.(@)(@@) PageV07P120(@)(@@)(@@)(@@) | من كنيته أبو الورقاء وأبو الوضاح وأبو الوفاء(@)(@@)(@@)(@@) | 1310 - (@)(@@) " أبو الورقاء " الكوفي اسمه الزبرق أن ابن عبد الله العبدي الكوفي.(@)(@@)(@@)(@@) | 1311 - (@)(@@) " أبو الوضاح " عن علي وعنه يونس بن أبي إسحاق قال ابن المديني: مجهول.(@)(@@)(@@)(@@) | 1312 - (@)(@@) " أبو الوضاح " عن أنس قال ابن عدي في ترجمة محمد بن سعيد الأزرق الطبري حدثني أحمد بن موسى سعدويه الأزرق قال ثنا هدبة قال ثنا أبو عوانة عن أبيه عن أنس رضى الله عنه رفعه لا شغار في الإسلام قال ابن عدي هذا وضع بارد وأبو عوانة اسمه الوضاح وهو عبد سبي من جرجان إلى البصرة فمن أين يروي عن أبيه وهو عبد وأبوه كافر.(@)(@@)(@@)(@@) | 1313 - (@)(@@) "أبو الوفاء" النسوي اسمه سعد بن علي القاضي1.(@)(@@)(@@)(@@) | 1314 - (@)(@@) "أبو الوفاء" بن عقيل الحنبلي الظفري اسمه علي بن عقيل بن محمد. PageV07P120(@)(@@)(@@)(@@) | من كنيته أبو الوليد وأبو وهب(@)(@@)(@@)(@@) | 1315 - (@)(@@) " أبو الوليد " المخزومي عن عبد الله بن عمر هو خالد بن إسماعيل الكذاب.(@)(@@)(@@)(@@) | 1316 - (@)(@@) " أبو الوليد" عن بلال بن أبي بردة لا يعرف.(@)(@@)(@@)(@@) | 1317 - (@)(@@) " أبو الوليد " بن عمرو1 بن حماس ضعفه بن المديني.(@)(@@)(@@)(@@) | 1318 - (@)(@@) " أبو الوليد " الرقي اسمه سليمان ابن عبيد الله.(@)(@@)(@@)(@@) | 1319 - (@)(@@) " أبو الوليد " بن برد الأنطاكي قال ابن القطان: لا يعرف انتهى وقد ذكر النسائي في الكنى وقال صالح.(@)(@@)(@@)(@@) | 1320 - (@)(@@) " أبو الوليد " الموصلي اسمه طريف.(@)(@@)(@@)(@@) | 1321 - (@)(@@) " أبو الوليد " اسمه محمد بن الحارث بن الحصين.(@)(@@)(@@)(@@) | 1322 - (@)(@@) " أبو الوليد " اسمه عبد الله بن محمد الكاملي.(@)(@@)(@@)(@@) | 1323 - (@)(@@) " أبو الوليد " بن نهشل اسمه أبان.(@)(@@)(@@)(@@) | 1324 - (@)(@@) " أبو الوليد " حكى عنه حفص بن غياث: لا يعرف.(@)(@@)(@@)(@@) | 1325 - (@)(@@) " أبو وهب " الطائي أو الكلاعي اسمه الحارث حمصي.(@)(@@)(@@)(@@) | 1326 - (@)(@@) " أبو وهب " الكوفي هو الوليد بن عيسى.(@)(@@)(@@)(@@) | 1327 - (@)(@@) " أبو وهب " الأسدي هو محمد بن حمزة. PageV07P121(@)(@@)(@@)(@@) | حرف الياء آخر الحروف(@)(@@)(@@)(@@) | من كنيته أبو يحيى وأبو يزيد(@)(@@)(@@)(@@) | 1328 - (@)(@@) " أبو يحيى " التيمي هو إسماعيل بن يحيى مر.(@)(@@)(@@)(@@) | 1329 - (@)(@@) " أبو يحيى " الوقار اسمه زكريا بن يحيى مر.(@)(@@)(@@)(@@) | 1330 - (@)(@@) " أبو يحيى " المدني عن بسر 
ms2410	 بن مطعم مجهول.(@)(@@) PageV07P121(@)(@@)(@@)(@@) | 1331 - (@)(@@) " أبو يحيى " عن شمر بن عطية لا يعرف.(@)(@@)(@@)(@@) | 1332 - (@)(@@) " أبو يحيى " عن خالد بن يزيد حدث عنه حميد الطويل لا يعرف.(@)(@@)(@@)(@@) | 1333 - (@)(@@) " أبو يحيى " النيسابوري صاحب المصنفات ذكره أحمد بن علي السليماني في عداد من يضع الحديث.(@)(@@)(@@)(@@) | 1334 - (@)(@@) " أبو يحيى " الزعفراني هو جعفر بن محمد قد ذكر.(@)(@@)(@@)(@@) | 1335 - (@)(@@) " أبو يحيى " الارسوفي اسمه زكريا بن قانع أو بن نافع كما في الأسماء.(@)(@@)(@@)(@@) | 1336 - (@)(@@) " أبو يحيى " الساجي اسمه زكريا بن يحيى.(@)(@@)(@@)(@@) | 1337 - (@)(@@) " أبو يحيى " الكتاني اسمه زكريا بن يحيى أيضا.(@)(@@)(@@)(@@) | 1338 - (@)(@@) " أبو يحيى " بن عبد الله اسمه الزبير.(@)(@@)(@@)(@@) | 1339 - (@)(@@) " أبو يحيى " الخراساني بن عبد الصمد بن حسان.(@)(@@)(@@)(@@) | 1340 - (@)(@@) " أبو يحيى " السلمي اسمه عبد الصمد بن الفضل البلخي.(@)(@@)(@@)(@@) | 1341 - (@)(@@) " أبو يحيى " القعقاع بن الوليد.(@)(@@)(@@)(@@) | 1342 - (@)(@@) " أبو يحيى " النهشلي اسمه الوضاح بن محمد.(@)(@@)(@@)(@@) | 1343 - (@)(@@) " أبو يزيد" الملائي عن ابن عمر مجهول.(@)(@@)(@@)(@@) | 1344 - (@)(@@) " أبو يزيد " الطحان لا يدري من هو تفرد عنه أحمد بن يونس اليربوعي قال ابن عدي: نقل عثمان ابن سعيد الدارمي أن يحيى بن معين سئل عنه فقال: لا أعرفه.(@)(@@)(@@)(@@) | 1345 - (@)(@@) " أبو يزيد " البسطامي اسمه ظفر طيفور.(@)(@@)(@@)(@@) | 1346 - (@)(@@) " أبو يزيد " الأيلي خالد بن نزار.(@)(@@)(@@)(@@) | 1347 - (@)(@@) " أبو يزيد " الأعور عن عمر بن مرة في المهدي وعنه يوسف بن حوشب لا يعرف ذكره ابن عدي وقال يقال: أنه عمرو بن قيس.(@)(@@) PageV07P122(@)(@@)(@@)(@@) | من كنيته أبو يسر وأبو اليسع وأبو يعقوب(@)(@@)(@@)(@@) | 1348 - (@)(@@) " أبو يسر " القاضي حدث عن الأوزاعي قال الحاكم ذاهب الحديث بمرة.(@)(@@)(@@)(@@) | 1349 - (@)(@@) " أبو اليسع " عن أبي هريرة رضى الله عنه أن النبي صلى الله عليه وآله وسلم كان إذا قرأ آخر القيامة ووالتين قال: بلى وأبو اليسع لا يدري من هو والسند بذلك مضطرب.(@)(@@)(@@)(@@) | 1350 - (@)(@@) " أبو اليسع " اسمه طلحة.(@)(@@)(@@)(@@) | 1351 - (@)(@@) " أبو