ms193	 عن ابن سيرين مجهول(@)(@@)(@@)(@@) $ 3798 - عبد الملك بن إبراهيم أبو مروان المديني عنه خالد بن مخلد مجهول PageV02P403(@)(@@)(@@)(@@) $ 3799 - عه / عبد الملك بن أعين عن أبي وائل قال أبو حاتم صالح الحديث وقال ابن معين ليس بشيء روى له البخاري مقرونا بآخر وهو شيعي(@)(@@)(@@)(@@) $ 3800 - عبد الملك بن بديل عن عبيد بن نحيح قال أبو الفتح الأزدي متروك(@)(@@)(@@)(@@) $ 3801 - عبد الملك بن أبي جمعة عن الحسن ضعفه ابن معين والنسائي وقال أبو حاتم لا بأس به(@)(@@)(@@)(@@) $ 3802 - عبد الملك بن أبي جميلة عن أبي بكر بن بشير مجهول(@)(@@)(@@)(@@) $ 3803 - عبد الملك بن حبيب القرطبي الفقيه كثير الوهم صحفي وقد أتهم(@)(@@)(@@)(@@) $ 3804 - عبد الملك بن حذافة الجمحي قال الدارقطني يترك(@)(@@)(@@)(@@) $ 3805 - عبد الملك بن حذيفة شيخ لصالح بن كيسان مجهول(@)(@@)(@@)(@@) $ 3806 - عبد الملك بن حسين عن ابن عرفة بخبر باطل هو آفته(@)(@@)(@@)(@@) $ 3807 - ق / عبد الملك بن حسين أبو مالك النخعي عن علي ابن الأقمر ضعفوه(@)(@@)(@@)(@@) $ 3808 - عبد الملك بن خسك عن حجر المدري يماني تكلم فيه ابن عدي PageV02P404 -(@)(@@)(@@)(@@) $ 3809 - عبد الملك بن حصين بن الترجمان أخو عبد العزيز قال أبو زرعة لا يكتب حديثه(@)(@@)(@@)(@@) $ 3810 - عبد الملك بن خلج الصنعاني عن وهب بن منبه ضعفه غير واحد(@)(@@)(@@)(@@) $ 3811 - عبد الملك بن خيار عن محمد بن دينار عن هشيم بخبر موضوع(@)(@@)(@@)(@@) $ 3812 - م د ت ق / عبد الملك بن الربيع بن سبرة عن أبيه صدوق ضعفه ابن معين(@)(@@)(@@)(@@) $ 3813 - د س / عبد الملك بن زكريا تابعي رأى الحسن بن علي مجهول(@)(@@)(@@)(@@) $ 3814 - عبد الملك بن زياد النصيبي قال الأزدي غير ثقة عن أحمد بن عبد الله الشاشي(@)(@@)(@@)(@@) $ 3815 - دس / عبد الملك بن زيد بن سعيد بن زيد روى عنه ابن أبي فديك ضعفه علي بن الحسين بن الجنيد وقال النسائي ليس به بأس(@)(@@)(@@)(@@) $ 3816 - عبد الملك بن أبي زهير روى عنه سعيد بن السائب صويلح ولا يكاد يعرف(@)(@@)(@@)(@@) $ 3817 - عبد الملك بن سليمان القرقساني عن عيسى بن يونس قال العقيلي حديثه غير 
ms194	 محفوظ PageV02P405(@)(@@)(@@)(@@) $ 3818 - م عه / عبد الملك بن أبي سليمان ثقة مشهور تكلم فيه شعبة للتفرد بخبر الشفعة(@)(@@)(@@)(@@) $ 3819 - عبد الملك بن الشعشاع بيض له مجهول(@)(@@)(@@)(@@) $ 3820 - عبد الملك بن أبي صالح شيخ لعيسى بن يونس ضعفه الأزدي(@)(@@)(@@)(@@) $ 3821 - س / عبد الملك بن طفيل الجزري تابعي لا يعرف(@)(@@)(@@)(@@) $ 3822 - عبد الملك بن عبد الله بن محمد بن سيرين شيخ مجهول(@)(@@)(@@)(@@) $ 3823 - عبد الملك بن عبد الله العابدي عن عاصم الأحول قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 3824 - عبد الملك بن عبد الرحمن شامي نزل البصرة عن الأوزاعي كذبه الفلاس قلت هو الذماري إن شاء الله صويلح قال الدارقطني ليس بقوي(@)(@@)(@@)(@@) $ 3825 - عبد الملك بن عبد الرحمن من ولد عتاب عن ابن جريج قال العقيلي تفرد بحديث(@)(@@)(@@)(@@) $ 3826 - عبد الملك بن عبدربه الطائي عن خلف بن خليفة وغيره منكر الحديث له خسر واه في خصائص النسائي وآخر عن الوليد ابن مسلم موضوع(@)(@@)(@@)(@@) $ 3827 - عبد الملك بن عبد العزيز عن الأوزاعي اتهمه أبو حاتم بن حبان PageV02P406(@)(@@)(@@)(@@) $ 3828 - عبد الملك بن عبد الملك عن مصعب عن القاسم قال ابن حبان لا يتابع على حديثه(@)(@@)(@@)(@@) $ 3829 - عبد الملك بن عبيد عن حمران قال ابن المديني مجهول(@)(@@)(@@)(@@) $ 3830 - ت / عبد الملك بن علاف عن أنس قال الترمذي مجهول(@)(@@)(@@)(@@) $ 3831 - عبد الملك بن عمر الرزاز عن الدارقطني متهم بتزوير سماعه(@)(@@)(@@)(@@) $ 3832 - عبد الملك ابن أخي عمرو بن حريث مجهول أرسل حديثا(@)(@@)(@@)(@@) $ 3833 - ع / عبد الملك بن عمير ثقة مشهور قال أبو حاتم ليس بحافظ قال ابن معين مخلط(@)(@@)(@@)(@@) $ 3834 - عبد الملك بن أبي عياش عن عرزب وله صحبة مجهول(@)(@@)(@@)(@@) $ 3835 - عبد الملك بن عيسى العكبري الأخباري شيخ لهناد النسفي يأتي بعجائب ذكره ابن النجار(@)(@@)(@@)(@@) $ 3836 - دق س / عبد الملك بن قدامة أو قتادة الجمحي قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 3837 - عبد الملك بن أخي القعقاع عن ابن عمر في النبيذ قال ابن أبي عاصم مجهول(@)(@@)(@@)(@@) $ 3838 - دس / عبد الملك بن محمد وقيل ابن عبد الرحمن الذماري PageV02P407 أبو الزرقاء 
