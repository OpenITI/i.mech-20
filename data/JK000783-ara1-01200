ms1181	 لا نعلمه يروى عن النبي - [ & ] - إلا | برواية بريدة عنه ولا نعلم رواه عن صالح بن حيان إلا عمر بن علي . |(@)(@@) 4438 - حدثنا محمد بن الوليد البسري قال : نا محمد بن عبيد | PageV10P314 | قال : نا صالح بن حيان عن عبد الله بن بريدة عن أبيه - رضي الله عنه - | أن رسول الله - [ & ] - مس صنما فتوضأ .(@)(@@) ورأيته عندي في موضعين في موضع عن يعلى وفي موضع عن محمد | وإنما معناه مس صنما فتوضأ غسل يديه . |(@)(@@) 4439 - حدثنا عمرو بن مالك قال : نا إسماعيل بن عبد الله أبو | إسحاق قال : نا عقبة الأصم عن عبد الله بن بريدة عن أبيه - رضي | الله عنه - أن رسول الله - [ & ] - كان يقول : ' اللهم | اجعلني شكورا واجعلني صبورا واجعلني في عيني صغيرا وفي أعين | الناس كبيرا ' . | PageV10P315(@)(@@) وهذا الحديث لا نعلم أحدا رواه عن عبد الله بن بريدة عن أبيه إلا | عقبة الأصم وهو رجل من أهل البصرة ليس به بأس . |(@)(@@) 4440 - حدثنا معمر بن سهل وصفوان بن المغلس قالا : نا | عبيد الله بن موسى قال : نا يوسف بن صهيب عن عبد الله بن بريدة | عن أبيه - رضي الله عنه - قال تفرق الناس عن رسول الله - [ & ] - | يوم حنين فلم يبق معه إلا رجل يقال له زيد وهو آخذ بعنان بغلة | رسول الله - [ & ] - الشهباء فقال له رسول الله : ' ويحك | ادع الناس ' فنادى زيد : أيها الناس هذا رسول الله - [ & ] - | يدعوكم فلم يجئ أحد فقال : ' ادع الأنصار ' فنادى يا معشر | الأنصار رسول الله - [ & ] - يدعوكم فلم يجئ أحد قال : | ' ويحك خص الأوس والخزرج ' فقال : يا معشر الأوس والخزرج هذا | رسول الله - [ & ] - يدعوكم فلم يجئ أحد قال : ' ويحك | خص المهاجرين فإن لي في أعناقهم بيعة ' قال : فحدثني بريدة أنه أقبل | منهم ألف قد طرحوا الجفون حتى أتوا رسول الله - [ & ] - | PageV10P316 | فمشوا قدما حتى فتح الله عليهم .(@)(@@) وهذا الحديث لا نعلم رواه إلا بريدة ولا نعلم رواه عن عبد الله بن | بريدة عن أبيه إلا يوسف بن صهيب ويوسف رجل مشهور من أهل | الكوفة . |(@)(@@) 4441 - حدثنا محمد بن 
ms1182	 معمر وصفوان بن المغلس قالا : نا | عبيد الله - يعني - ابن موسى عن يوسف بن صهيب بن بريدة عن أبيه | - رضي الله عنه - أن امرأة حذفت امرأة فقضى رسول الله - [ & ] - | في ولدها خمسمائة ونهى يومئذ عن الحذف .(@)(@@) وهذا الحديث لا نعلم رواه عن عبد الله بن بريدة إلا يوسف بن | صهيب . | PageV10P317 |(@)(@@) 4442 - حدثنا عمرو بن مالك قال : نا عمرو بن النعمان | قال : نا يوسف بن صهيب عن عبد الله بن بريدة عن أبيه - رضي الله | عنه - قال : قال رسول الله - [ & ] - : ' إذا صلى أحدكم | إلى سترة فليدن منها لا يقطع الشيطان عليه صلاته ' .(@)(@@) وهذا الحديث لا نعلم يروى عن بريدة إلا من هذا الوجه ولا نعلم | رواه عن يوسف بن صهيب إلا عمرو بن النعمان ، وعمرو رجل من أهل | البصرة . |(@)(@@) 4443 - حدثنا محمد بن المثنى قال : نا أبو المساور الفضل بن | مساور قال : نا عوف عن ميمون أبي عبد الله عن عبد الله بن بريدة | عن أبيه - رضي الله عنه - قال لما كان يوم خيبر نزل رسول الله - [ & ] - | بحضرة أهل خيبر فأعطى رسول الله - [ & ] - | اللواء عمر بن الخطاب - رضي الله عنه - ونهض من نهض معه | من الناس فلقوا أهل خيبر فكشف عمر - رضي الله عنه - وأصحابه فرجع | إلى رسول الله - [ & ] - يجبنه أصحابه وهو يجبن أصحابه | PageV10P318 | فقال رسول الله - [ & ] - : ' لأعطين الراية غدا رجلا يحب | الله ورسوله ويحبه الله ورسوله ' ، فلما كان من الغد دعا عليا - رضي الله | عنه - فدفعها إليه وهو أرمد فتفل في عينه وأعطاه اللواء وسار معه الناس | فأتى أهل خيبر وإذا مرحب يرتجز بين أيديهم يقول : |(@)(@@) % قد علمت خيبر أني مرحب % % شاك السلاح بطل مجرب %(@)(@@) % أطعن أحيانا وحينا أضرب % % إذ السيوف أقبلت تلهب %(@)(@@) فاختلف هو وعلي - رضي الله عنه - ضربتين فضربه علي - رضي | الله عنه - ضربة على هامته حتى عض السيف أضراسه وسمع أهل العسكر | صوت ضربته وما تتام آخر الناس حتى فتح أولهم .(@)(@@) وهذا الحديث لا نعلمه يروى عن بريدة إلا من هذا الوجه بهذا | الإسناد . | PageV10P319 |(@)(@@) 4444 - حدثنا صفوان 
ms1183	 بن المغلس قال : نا عبد العزيز بن أبان | قال : نا بشير بن المهاجر قال : نا عبد الله بن بريدة عن أبيه - رضي | الله عنه - قال : قال رسول الله - [ & ] - : ' ما منكم من | أحد إلا سيكلمه الله عز وجل ليس بينه وبينه [ 241 ] حجاب ولا | ترجمان ' .(@)(@@) وهذا الحديث لا نعلم رواه عن بشير بن المهاجر إلا عبد العزيز بن | أبان وعبد العزيز لم يكن بالقوي وإنما يكتب من حديثه ما لم ينفرد به . |(@)(@@) 4445 - حدثنا محمد بن معمر قال : نا روح بن عبادة قال : نا | PageV10P320 | يعقوب بن إبراهيم قال : نا صالح بن حيان عن عبد الله بن بريدة عن | أبيه - رضي الله عنه - قال ضمر رسول الله - [ & ] - الخيل | ووقت لإضمارها وقتا وقال : يوم كذا وكذا من موضع كذا وكذا | وأرسل الخيل التي ليست بمضمورة من دون ذلك .(@)(@@) وهذا الحديث لا نعلمه يروى عن بريدة إلا من هذا الوجه ولا | نعلم رواه عن صالح بن حيان إلا يعقوب بن إبراهيم . |(@)(@@) 4446 - حدثنا محمد بن مسكين قال : نا سعيد بن سليمان قال : نا | عبد الله بن حكيم عن يوسف بن صهيب عن ابن بريدة عن أبيه | - رضي الله عنه - عن النبي - [ & ] - قال : ' ثلاثة لا تقربهم | الملائكة السكران والمتضمح بالزعفران والحائض أو الجنب ' . | PageV10P321(@)(@@) وهذا الحديث لا نعلمه يروى عن بريدة إلا من هذا الوجه ولا نعلم | رواه عن يوسف بن صهيب إلا عبد الله بن حكيم . |(@)(@@) 4447 - حدثنا محمد بن معمر قال : نا يعقوب بن محمد قال : نا | عبد العزيز بن عمران قال : نا أفلح بن سعيد عن سفيان بن فروة | عن أبيه عن بريدة الأسلمي - رضي الله عنه - قال لما أقبل رسول الله | - [ & ] - في مهاجره لقي ركبا فقال : ' يا أبا بكر سل القوم | ممن هم ' قالوا نحن من أسلم قال : ' سلمت يا أبا بكر سلهم من أي | أسلم ' قالوا من بني سهم قال : ' ارم بسهمك يا أبا بكر ' .(@)(@@) وهذا الحديث لا نعلم رواه عن النبي - [ & ] - إلا | بريدة ولا نعلم له طريقا عن بريدة إلا 
ms1184	 هذا الطريق . |(@)(@@) 4448 - حدثنا العباس بن عبد العظيم العنبري قال : نا يحيى بن | كثير قال : نا إسماعيل بن سليمان عن عبد الله بن أوس عن | PageV10P322 | بريدة - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' بشر المشائين في الظلم إلى المساجد بالنور التام يوم القيامة ' . |(@)(@@) 4449 - حدثنا العباس بن محمد قال : نا عون بن عمارة قال : نا | هشام بن حسان عن واصل عن عبد الله بن بريدة عن أبيه - رضي الله | عنه - قال كنا عند رسول الله - [ & ] - فأقبل رجل من | قريش يخطر في حلة له فلما قام على النبي - [ & ] - قال : | ' يا بريدة ! هذا ممن لا يقيم الله له يوم القيامة وزنا ' . | PageV10P323(@)(@@) وهذا الحديث لا نعلم رواه عن عبد الله بن بريدة إلا واصل هو | واصل مولى أبي عيينة رجل من أهل البصرة مشهور ، وعون بن عمارة لم | يكن بالحافظ ولم يتابع على هذا الحديث . |(@)(@@) 4450 - حدثنا إبراهيم بن عبد الله بن الجنيد ومحمد بن يزيد قالا : | نا عبد العزيز بن الخطاب قال : نا حبان بن علي قال : نا صالح بن | حيان عن عبد الله بن بريدة عن أبيه - رضي الله عنه - قال جاء رجل | إلى النبي - [ & ] - فقال أرني آية قال : ' اذهب إلى تلك | الشجرة فادعها ' فذهب إليها فقال : إن رسول الله - [ & ] - | يدعوك فمالت على كل جانب منها حتى قلعت عروقها ، ثم | أقبلت حتى جاءت إلى رسول الله - [ & ] - فأمرها رسول | الله أن ترجع فقام الرجل فقبل رأسه ويديه ورجليه وأسلم .(@)(@@) وهذا الحديث لا نعلم رواه عن صالح بن حيان إلا حبان بن علي | PageV10P324 | ولا نعلمه يروى عن النبي - [ & ] - في تقبيل الرأس إلا هذا | الحديث . |(@)(@@) 4451 - حدثنا زهير بن محمد قال : أنا عبد الرازق قال : أنا سفيان | الثوري عن مالك بن مغول عن ابن بريدة عن أبيه - رضي الله عنه - أن | النبي - [ & ] - سمع رجلا يقول : اللهم إني أسألك بأنك | أنت الله لا إله إلا أنت ، الأحد الصمد ، الذي لم تلد ولم تولد ، ولم يكن | لك كفوا أحد ، فقال : ' لقد سأل الله باسمه الذي إذا 
ms1185	 دعي به أجاب وإذا | سئل به أعطى ' .(@)(@@) وهذا الحديث لا نعلم رواه عن عبد الله بن بريدة إلا مالك بن | مغول . |(@)(@@) 4452 - حدثنا إبراهيم بن سعيد الجوهري قال : نا أبو الجواب | أحوص بن جواب عن عمار بن رزيق عن أبي إسحاق عن الزبير | PageV10P325 | ابن عدي عن ابن بريدة عن أبيه - رضي الله عنه - قال : قال رسول | الله - [ & ] - : ' كل مسكر حرام ' .(@)(@@) وهذا الحديث لا نعلم رواه عن أبي إسحاق إلا عمار بن رزيق ولا | نعلم روى الزبير بن عدي عن عبد الله بن بريدة عن أبيه غير هذا | الحديث . |(@)(@@) 4453 - حدثنا سلمة بن شبيب قال : نا عبد الله بن الوزير | الطائفي قال : نا محمد بن جابر عن سماك بن حرب عن القاسم بن | عبد الرحمن عن ابن بريدة عن أبيه - رضي الله عنه - قال كنا مع رسول | الله - [ & ] - حتى إذا كنا بودان أو بالقبور سأل الشفاعة | لأمه أحسبه قال فضرب جبريل - [ & ] - صدره وقال : لا | PageV10P326 | تستغفر لمن مات مشركا فرجع وهو حزين .(@)(@@) ولا نعلم روى هذا الحديث بهذا الإسناد إلا محمد بن جابر وقد | روى علقمة بن مرثد عن سليمان بن بريدة عن أبيه - رضي الله عنه - | أنهم كانوا مع رسول الله - [ & ] - فأتى جذم حائط | [ 242 ] فجلس إلى قبر كأنه مخاطب فرجع فقال : ' هذا قبر أمي | استأذنت ربي في زيارته فأذن لي واستأذنت ربي في الاستغفار فلم يأذن | لي ' فلم نر يوما أكثر باكيا من ذلك اليوم . |(@)(@@) 4454 - حدثنا به أحمد بن الوزير البصري قال : نا الضحاك بن | مخلد قال : نا سفيان عن علقمة بن مرثد عن ابن بريدة عن أبيه . |(@)(@@) 4455 - حدثنا عبد الله بن أحمد المروزي قال : نا آدم بن أبي | PageV10P327 | إياس قال : نا يزيد بن زريع عن عطاء الخراساني عن عبد الله بن | بريدة عن أبيه - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' إنا كنا نهيناكم عن قران التمر فأقرنوا فقد وسع الله | الخير ' .(@)(@@) وهذا الحديث لا نعلم له طريقا عن بريدة إلا هذا الطريق ولا نعلم | رواه إلا 
ms1186	 آدم عن يزيد بن زريع . |(@)(@@) 4456 - حدثنا محمد بن عبد الله بن المبارك المخرمي قال : نا أبو | معاوية عن الأعمش عن ابن بريدة عن أبيه - رضي الله عنه - عن النبي | PageV10P328 | - [ & ] - قال : ' ما يخرج الرجل الصدقة حتى يفك عنها | لحيي سبعين شيطانا ' .(@)(@@) وهذا الحديث لا نعلم رواه إلا أبو معاوية عن الأعمش وابن بريدة | هذا هو سليمان بن بريدة . |(@)(@@) 4457 - حدثنا محمد بن عمارة الكوفي قال : نا علي بن قادم | قال : نا قيس عن علقمة بن مرثد عن سليمان بن بريدة عن أبيه | - رضي الله عنه - أن النبي - [ & ] - استغفر لماعز . |(@)(@@) 4458 - حدثنا العباس بن عبد الله قال : نا يحيى بن يعلى بن | الحارث المحاربي عن أبيه عن علقمة بن مرثد عن ابن بريدة عن أبيه | PageV10P329 | - رضي الله عنه - قال جاء ماعز بن مالك إلى النبي - [ & ] - | فردده ، ثم قال : ' استنكهوه ' فاستنكهوه ' ثم رجمه .(@)(@@) ولا نعلم يروى عن النبي - [ & ] - أنه قال استنكهوه | إلا في حديث يحيى بن يعلى بن الحارث . |(@)(@@) 4459 - حدثنا عمر بن محمد بن الحسن الأسدي الكوفي قال : نا | أبي قال : نا محمد بن أبان عن علقمة بن مرثد عن سليمان بن | بريدة عن أبيه - رضي الله عنه - عن النبي - [ & ] - قال : | ' إن الحجر ليهوى في جهنم فما يصل إلى قعرها سبعين خريفا ' .(@)(@@) وهذا الحديث لا نعلم رواه إلا محمد بن أبان ولا نعلم رواه عن | PageV10P330 | محمد بن أبان إلا محمد بن الحسن . |(@)(@@) 4460 - حدثنا حميد بن الربيع قال : نا جرير عن ليث - يعني - | ابن أبي سليم عن عثمان بن بريدة عن أبيه - رضي الله عنه - أن النبي | - [ & ] - قال : ' من رمانا بالليل فليس منا ' . |(@)(@@) 4461 - حدثنا محمد بن المثنى قال : نا هشام بن عبد الملك قال : | نا محمد بن أبان عن علقمة بن مرثد عن سليمان بن بريدة عن أبيه | - رضي الله عنه - قال جاءت الغامدية إلى رسول الله - [ & ] - | فقالت : إنها زنت فأعرض النبي - [ & ] - عنها | فقالت يا رسول الله تريد أن تردني كما رددت ماعز إني حبلى من | الزنا فقال : ' متى تضعي 
ms1187	 ' فذهبت فلما وضعت جاءت به إلى رسول الله | - [ & ] - تحمله فقالت قد ولدت قال : ' اذهبي حتى | PageV10P331 | تفطميه ' فذهبت ، ثم جاءت به وفي يده كسرة خبز ، فقالت إني قد | فطمته . فقال : ' ائتني بمن يكفله ' فقام رجل فقال : أنا أكفله فجعل | أصحاب النبي - [ & ] - يتعجبون من الرجل ويقولون ما | كان عليه لو لم يكفله فأمر بها فرجمت ، ثم صلي عليها فقال رجل كيف | تصلي عليها وهي كذا فقال النبي - [ & ] - : ' لقد تابت | توبة لو قسمت بين أهل المدينة لوسعتهم أو نحو هذا ' . |(@)(@@) 4462 - حدثنا عباد بن أحمد العرزمي قال : حدثني عمي عن | أبيه عن جابر الجعفي عن عبد الله بن بريدة عن أبيه - رضي الله | عنه - قال رسول الله - [ & ] - : ' يا بريدة إذا كان حين | تفتتح الصلاة فقل : سبحانك اللهم وبحمدك لا حول ولا قوة إلا بالله | ولا إله إلا أنت وحدك لا شريك لك تبارك اسمك وتعالى جدك ولا إله | PageV10P332 | غيرك ظلمت نفسي فاغفر لي إنه لا يغفر الذنوب إلا أنت وتقرأ ما | تيسر من القرآن وتركع فتقول سبحان ربي العظيم ثلاث مرات فإذا | رفعت من الركوع فقل سمع الله لمن حمده اللهم ربنا ولك الحمد ملء | السماء وملء الأرض وملء ما شئت من شيء بعد فإذا سجدت فقل | سبحان ربي الأعلى ثلاثا سجد وجهي لمن خلقه فشق سمعه وبصره | تبارك الله أحسن الخالقين فإذا رفعت من السجدة فقل رب اغفر لي | وارحمني واهدني وارزقني إني لما أنزلت إلي من خير فقير فإذا جلست | في صلاتك فلا تتركن في التشهد لا إله إلا الله وأني رسول الله والصلاة | علي وعلى جميع أنبياء الله وسلم على عباد الله الصالحين ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن بريدة بهذا | الإسناد . |(@)(@@) 4463 - حدثنا رجاء بن محمد قال : نا عبيد الله بن موسى قال : | نا بشير بن المهاجر عن عبد الله بن بريدة عن أبيه - رضي الله عنه - | قال : قال رسول الله - [ & ] - : ' ما نقض قوم العهد إلا | كان القتل بينهم ولا ظهرت فاحشة في قوم قط إلا 
ms1188	 سلط الله عليهم | PageV10P333 | الموت ، ولا منع قوم قط الزكاة إلا حبس الله عنهم القطر ' .(@)(@@) وهذا الحديث لا نعلمه يروى إلا عن بريدة ولا نعلم له طريقا عن | بريدة إلا هذا الطريق . |(@)(@@) 4464 - حدثنا محمد بن مسكين قال : نا سعيد بن سليمان قال : | نا منصور بن [ 243 ] أبي الأسود عن عطاء بن السائب عن محارب بن | دثار عن ابن بريدة وهو سليمان عن أبيه - رضي الله عنه - قال سأل | رسول الله - [ & ] - جعفرا - رضي الله عنه - حين قدم من | الحبشة ما أعجب شيء رأيته قال : رأيت امرأة تحمل على رأسها مكتل من | طعام فمر فارس فركضه فأبذره فجلست تجمع طعامها ، ثم التفتت قالت | ويل له إذا وضع الملك تبارك وتعالى كرسيه فأخذ للمظلوم من الظالم | فقال رسول الله - [ & ] - تصديقا لقولها ' لا قدست أمة أو | PageV10P334 | كيف تقدس أمة لا يأخذ ضعيفها حقه من شديدها غير متعتع ' .(@)(@@) وهذا الحديث لا نعلم رواه عن عطاء بن السائب إلا منصور بن | أبي الأسود ولا نعلم له عن بريدة طريقا غير هذا الطريق . |(@)(@@) 4465 - حدثنا إبراهيم بن يوسف الصيرفي قال : نا أبو يحيى | التيمي عن أبي فروة عن المغيرة بن سبيع البجلي عن ابن بريدة عن | أبيه - رضي الله عنه - أنه سمعه يقول جالست النبي - [ & ] - | فرأيته كالحزين فقال له رجل مالي أراك كأنك حزين قال : | ' ذكرت أني كنت نهيتكم عن لحوم الأضاحي أن تأكلوها إلا ثلاثة أيام | فكلوا وأطعموا وادخروا ما بدا لكم ، ونهيتكم عن زيارة القبور فمن | أرد منكم أن يزور قبرا فليزره ، ونهيتكم عن الدباء والحنتم والنقير | PageV10P335 | والمزفت فاجتنبوا كل مسكر واشربوا فيما بدا لكم ' . |(@)(@@) 4466 - حدثنا عبدة بن عبد الله قال : أنا سويد بن عمرو قال : | نا زهير عن الوليد بن ثعلبة عن عبد الله بن بريدة عن أبيه - رضي الله | عنه - قال : قال رسول الله - [ & ] - ' سيد الاستغفار أن | يقول الرجل إذا جلس في صلاته اللهم أنت ربي لا إله إلا أنت خلقتني | فأنا عبدك أنا على عهدك ووعدك ما استطعت أعوذ بك من 
ms1189	 شر ما | صنعت أبوء بنعمتك علي وأبوء بذنبي فاغفر لي إنه لا يغفر الذنوب إلا | أنت ' . | PageV10P336 |(@)(@@) 4467 - حدثنا محمد بن السكن قال : نا عمران بن أبان قال : نا | خلف بن خليفة عن أبي هاشم عن ابن بريدة عن أبيه . |(@)(@@) 4468 - وحدثنا أحمد بن عثمان قال : نا بكر بن عبد الرحمن | PageV10P337 | عن قيس عن الأعمش ، عن سعد بن عبيدة عن ابن بريدة ، عن أبيه | - رضي الله عنه - أن النبي - [ & ] - قال : ' القضاة ثلاثة اثنان | في النار وواحد في الجنة قاض قضى بجور فهو في النار وقاض قضى بغير | علم فهو في النار وقاض بالحق فهو في الجنة ' . |(@)(@@) 4469 - حدثنا العباس بن أبي طالب قال : نا بكر بن خداش | قال : نا عيسى بن المسيب عن عطية العوفي عن عبد الله بن بريدة عن | PageV10P338 | أبيه - رضي الله عنه - قال : قال رسول الله - [ & ] - ' لا | يستعمل الرجل على عشرة فما فوقهم إلا جيء به يوم القيامة مغلولة | يده إلى عنقه فإن كان محسنا فك غله وإن كان مسيئا زيد غلا إلى | غله ' . |(@)(@@) 4470 - حدثنا محمد بن المثنى قال : نا يحيى بن أبي بكير قال : نا | حسام بن مصك عن عبد الله عن أبيه - رضي الله عنه - قال : قال رسول | الله - [ & ] - : ' إن من الشعر حكمة ' . |(@)(@@) 4471 - حدثنا رجاء بن محمد وعبد الملك بن محمد الرقاشي قالا : نا | PageV10P339 | مالك بن إسماعيل قال : نا عبد الرحمن بن حميد الرؤاسي قال : نا عبد | الكريم بن سليط عن ابن بريدة عن أبيه قال نفر لعلي - رضي الله عنه - | لو خطبت فاطمة - رضي الله عنها - فأتى النبي - [ & ] - | فقال : ' ما حاجة علي ' قال ذكرت فاطمة بنت رسول الله - [ & ] - | قال : مرحبا وأهلا لم يزده عليهما فخرج علي - رضي الله | عنه - إلى أولئك الرهط وهم ينتطرونه ، قالوا : ما وراءك ؟ قال : لا أدري | غير أنه قال لي : مرحبا وأهلا قالوا : يكفيك من رسول الله - [ & ] - | أعطاك الأهل وأعطاك المرحب قال : فلما بعد ما زوجه قال : يا علي | إنه لا بد للعرس من وليمة ' وقال سعد : عندي كبش 
ms1190	 وجمع له رهط من | الأنصار فلما كان ليلة البناء قال : ' يا علي لا تحدث شيئا حتى تلقاني ' | فدعا النبي - [ & ] - بماء فتوضأ منه ، ثم أفرغه على علي | - رضي الله عنه - ثم قال : ' اللهم بارك فيهما وبارك لهما في شبليهما ' . | PageV10P340 |(@)(@@) | مسند | وائل بن حجر | رضي الله عنه(@)(@@) | PageV10P341 | صفحة فارغة . | PageV10P342 |(@)(@@) | حديث وائل بن حجر ( ويعد في المدنيين )(@)(@@) 4472 - حدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن سماك بن حرب عن علقمة بن وائل عن أبيه أنه قال سأل | سلمة بن يزيد الجعفي رسول الله - [ & ] - فقال : يا رسول | الله أرأيت إن قامت علينا أمراء يسألونا حقهم ويمنعونا حقنا فما تأمرنا | فأعرض عنه ثم سأله فأعرض عنه ، ثم سأله فأعرض عنه فقال : ' اسمعوا | وأطيعوا فإنما عليكم ما حملتم وعليهم ما حملوا ' . |(@)(@@) 4473 - حدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن سماك بن حرب عن علقمة بن وائل عن أبيه أن طارق بن | PageV10P343 | سويد سأل النبي - [ & ] - عن الخمر يتداوى بها ، فقال : | ' ليس هي دواء ، ولكنها داء ' . |(@)(@@) 4474 - حدثنا محمد بن المثنى ومحمد بن بشار قالا : نا محمد بن | جعفر قال : نا شعبة عن سماك عن علقمة بن وائل عن أبيه - رضي | الله عنه - عن النبي - [ & ] - قال : ' لا تقولوا [ 244 ] | للعنب الكرم ، ولكن الحبلة ' . | PageV10P344 |(@)(@@) 4475 - حدثنا محمد بن المثنى قال : نا محمد بن جعفر قال : نا | شعبة عن سماك بن حرب عن علقمة بن وائل عن أبيه - رضي الله | عنه - أن رسول الله - [ & ] - أقطعه أرضا ، قال : فأرسل | معي معاوية فقال أعطها إياه قال فخرجت وأنا راكب ومعاوية يمشي في | نصف النهار فقال معاوية أردفني خلفك قلت لا تكون من أرداف الملوك | قال فأعطني نعلك قلت انتعل ظل الناقة فلما استخلف معاوية أتيته | فأقعدني معه على السرير وذكرني الحديث فوددت أني كنت حملته بين | يدي .(@)(@@) وهذه الأحاديث لا نعلم رواها بهذه الألفاظ إلا وائل بن حجر ولا | نعلم لها طريقا عن وائل إلا هذا الطريق . |(@)(@@) 4476 - حدثنا إبراهيم 
ms1191	 بن زياد البغدادي قال : نا عاصم بن علي | PageV10P345 | قال : نا أبو الأحوص عن سماك بن حرب عن علقمة بن وائل عن | أبيه - رضي الله عنه - قال جاء رجل من حضرموت ورجل من كندة إلى | رسول الله - [ & ] - فقال الحضرمي يا رسول الله إن هذا قد غلبني على أرض كانت لأبي فقال الكندي هي أرضي وفي يدي ليس | له فيها حق فقال النبي - [ & ] - للحضرمي : ' ألك بينة ' قال | ما لي بينة قال يحلف قال إذا يحلف ما يبالي على ما حلف عليه ليس يتورع | من شيء قال ليس لك إلا ذلك ، ثم قال رسول الله - [ & ] - : | ' من حلف على مال أخيه فأكله ظلما لقي الله وهو عنه معرض ' . |(@)(@@) 4477 - وحدثناه محمد بن عبد الملك القرشي قال : نا أبو عوانة | PageV10P346 | عن عبد الملك بن عمير عن علقمة بن وائل عن أبيه - رضي الله | عنه - قال : كنت عند رسول الله - [ & ] - فأتاه رجلان | يختصمان في أرض ، فقال أحدهما : إن هذا انتزى على أرضي في الجاهلية | يا رسول الله وهو امرؤ القيس وهذا ربيعة بن عبدان فقال رسول الله | - [ & ] - : ' بينتك ' قال : ليس لي بينة ، قال : ' يمينه ' قال إذا | يذهب بها قال : ' ليس لك إلا ذلك ' فلما قام ليحلف قال رسول الله | - [ & ] - : ' من اقتطع أرضا ظلما لقي الله وهو عليه | غضبان ' قال أبو بكر أحسب أنه قال : ' من أقطع أرضا ظلما | بيمينه ' . |(@)(@@) 4478 - حدثنا أبو كريب قال : نا أبو معاوية عن الحجاج يعني | PageV10P347 | ابن أرطاة عن عبد الجبار بن وائل عن أبيه - رضي الله عنه - قال | رأيت رسول الله - [ & ] - إذا سجد وضع جبهته وأنفه | على الأرض . |(@)(@@) 4479 - حدثنا عبد الله بن سعيد الكندي قال : نا معمر بن | سليمان الرقي عن الحجاج بن أرطاة عن عبد الجبار بن وائل بن | حجر عن أبيه - رضي الله عنه - أن امرأة استكرهت على عهد رسول | الله - [ & ] - فدرأ الحد عن المرأة وأقامه على الذي أصابه | PageV10P348 | ولم يذكر أنه جعل لها مهرا . |(@)(@@) 4480 - وحديثي الحجاج لا نعلم رواهما غيره عن عبد الجبار ولا | نعلم أسند 
ms1192	 عبد الملك بن عمير عن علقمة بن وائل عن أبيه إلا هذا | الحديث الذي ذكرناه قبل حديث الحجاج . |(@)(@@) 4481 - حدثني علي بن سعيد المسرقي قال : نا أبو الأحوص سلام | ابن سليم عن أبي إسحاق عن عبد الجبار بن وائل بن حجر عن | أبيه - رضي الله عنه - أنه صلى خلف النبي - [ & ] - فقرأ | فاتحة الكتاب فلما قال ^ ( ولا الضالين ) ^ قال : ' آمين ' رفع بها | صوته . | PageV10P349 |(@)(@@) 4482 - حدثنا عبدة بن عبد الله قال : أنا سفيان بن عقبة ومعاوية | ابن هشام عن سفيان عن عاصم بن كليب عن أبيه عن وائل بن | حجر - رضي الله عنه - قال : أتيت النبي - [ & ] - ولي شعر طويل | فقال : ' ذباب ' فذهبت فأخذته ، ثم جئت فقال : ' لم أعنك ، وهذا | أحسن ' . |(@)(@@) 4483 - حدثنا رجاء بن محمد السقطي ومحمد بن موسى الواسطي | قالا أنا يزيد بن هارون قال : أنا شريك عن عاصم بن كليب عن | PageV10P350 | أبيه عن وائل بن حجر - رضي الله عنه - أن النبي - [ & ] - | كان إذا صلى فأراد أن يسجد تقع ركبتيه إلى الأرض قبل يديه | وإذا رفع ركبتيه قبل يديه .(@)(@@) وهذا الحديث لا نعلم رواه إلا يزيد بن هارون عن شريك . |(@)(@@) 4484 - حدثنا أحمد بن عبد الله الواسطي قال : نا صلة بن | سليمان قال : نا أبو هانئ أشعث بن عبد الله قال : حدثني حمزة أبو | عمر ورجل آخر قالا : بلغنا عن ابن وائل بن حجر حديث فلقيناه | PageV10P351 | بواسط في مجلس فقلنا له : ما حديث بلغنا عنك ؟ قال : حدثني أبي قال : | شهدت رجلا وجاء برجل يقاد في نسعة قد قتل رجلا فقال رسول الله | - [ & ] - لولي المقتول : ' أتعفو ؟ ' قال : لا ، قال : ' أتأخذ | الدية ؟ ' قال : لا ، قال : ' فتقتله ' قال : نعم ، قال : ' فاذهب ' قال : فذهب | به ، فلما كان غير بعيد دعاه ، فقال : ' أتعفو ؟ ' قال : لا ، قال : ' أتأخذ | الدية ؟ ' قال : لا ، قال : ' تقتله ' قال : نعم ، وذهب به حتى فعل ذلك | مرارا ، فقال رسول الله - [ & ] - : ' إن قتله فهو مثله ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن وائل بن حجر | وقد روى أبو هريرة نحوه بغير لفظه 
ms1193	 وحمزة أبو عمر رجل روى عنه عوف | وأشعث هذا الحديث . |(@)(@@) 4485 - حدثنا محمد بن عبد الملك القرشي قال : نا بشر بن | PageV10P352 | المفضل قال : نا عاصم بن كليب عن أبيه عن وائل بن حجر | - رضي الله عنه - قال رمقت [ 245 ] النبي - [ & ] - فلما | افتتح الصلاة رفع يديه حتى بلغ بهما أذنيه وكبر ، ثم وضع يده اليمنى | على اليسرى فلما ركع رفع ورفع يديه حين رفع فلما جلس في الثانية | جلس على رجله اليسرى ثناها تحته ، ثم نصب اليمنى ووضع يده اليمنى | على فخذه اليمنى ويده اليسرى على فخذه اليسرى وحلق حلقة بأصبعه | السبابة باليمنى . | PageV10P353 |(@)(@@) 4486 - حدثنا إبراهيم بن سعيد قال : نا محمد بن حجر قال : | حدثني سعيد بن عبد الجبار بن وائل بن حجر عن أبيه عن أمه عن | وائل بن حجر - رضي الله عنه - قال بلغنا ظهور رسول الله - [ & ] - | ونحن في ملك عظيم وطاعة فرفضته وخرجت راغبا في الله | ورسوله فلما قدمت على رسول الله - [ & ] - كان قد | بشرهم بقدومي فلما قدمت عليه وسلمت عليه رد علي وبسط لي رداءه | وأجلسني عليه ، ثم صعد منبره وأقعدني معه فرفع يده فحمد الله وأثنى | عليه وصلى على النبيين واجتمع الناس إليه فقال لهم : ' أيها الناس هذا | وائل بن حجر قد أتاكم من أرض بعيدة من حضرموت طائعا غير | مكره راغبا في الله ورسوله وفي دينه بقية أبناء الملوك ' ، فقلت : يا رسول | الله ، ما هو إلا أن بلغنا ظهورك ونحن في ملك عظيم وطاعة عظيمة ، | PageV10P354 | فأتيتك راغبا في الله وفي رسوله وفي دينه . قال : ' صدقت ' . |(@)(@@) 4487 - حدثنا إبراهيم بن سعيد الجوهري قال : نا محمد بن | حجر قال : نا سعيد بن عبد الجبار بن وائل بن حجر عن أبيه عن | أمه عن وائل بن حجر - رضي الله عنه - أن النبي - [ & ] - | نهى عن الشغار . |(@)(@@) 4488 - حدثنا إبراهيم بن سعيد قال : نا محمد بن حجر قال : | حدثني سعيد بن عبد الجبار بن وائل بن حجر عن أبيه عن أمه عن | وائل بن حجر - رضي الله عنه - قال شهدت 
ms1194	 النبي - [ & ] - | وأتي بإناء فيه ماء فأكفاه على يمينه ثلاثا ، ثم غمس يمينه في الماء | PageV10P355 | فغسل بها يساره ثلاثا ، ثم أدخل يمينه في الماء فحفن بها حفنة من الماء | فمضمض واستنشق ثلاثا واستنثر ، ثم أدخل كفيه في الإناء فرفعها إلى | وجهه فغسل وجهه ثلاثا وغسل باطن أذنيه وأدخل أصبعيه في داخل | أذنيه ومسح ظاهر رقبته وباطن لحيته ثلاثا ، ثم أدخل يمينه في الماء فغسل | بها ذراعه اليمنى حتى جاوز المرفق ثلاثا ، ثم غسل يساره بيمينه حتى | جاوز المرفق ثلاثا ، ثم مسح على رأسه ثلاثا وظاهر أذنيه ثلاثا وظاهر | رقبته وأظنه قال وظاهر لحيته ثلاثا ، ثم غسل بيمينه قدمه اليمنى ثلاثا | وفصل بين أصابعه أو قال خلل بين أصابعه ورفع الماء حتى جاز الكعب ، | ثم رفعه في الساق ، ثم فعل باليسرى مثل ذلك ، ثم أخذ حفنة من ماء | فملأ بها يده ، ثم وضعها على رأسه حتى انحدر الماء من جوانبه وقال هذا | تمام الوضوء ولم أره تنشف بثوب ، ثم نهض إلى المسجد فدخل في | المحراب - يعني - موضع المحراب فصف الناس خلفه وعن يمينه وعن يساره ، | ثم رفع يديه حتى حاذتا بشحمة أذنيه ، ثم وضع يمينه على يساره عند | صدره ، ثم افتتح القراءة فجهر بالحمد ، ثم فرغ من سورة الحمد ، ثم قال : | ' آمين ' حتى سمع من خلفه ، ثم قرأ سورة أخرى ، ثم رفع يديه بالتكبير | حتى حاذتا بشحمة أذنيه ، ثم ركع فجعل يديه على ركبتيه وفرج بين | أصابعه وأمهل في الركوع حتى اعتدل وصار صلبه لو وضع عليه قدح | من الماء ما انكفأ ، ثم رفع رأسه - [ & ] - بخشوع وقال : | ' سمع الله لمن حمده ' ثم رفع يديه حتى حاذتا بشحمة أذنيه ، ثم انحط | للسجود بالتكبير فرفع يديه إلى أن حاذتا بشحمة أذنيه ، ثم أثبت جبهته | في الأرض حتى إني أرى أنفه في الرمل وقوس بذراعيه ورأسه وبسط | PageV10P356 | فخذه اليسار ونصب اليمين كما أثبت أصابع رجليه ولم يمهل بالسجود | ورفع رأسه فرفع يديه بالتكبير إلى أن حاذتا بشحمة أذنيه وجلس جلسة | خفيفة فوضع كفه اليمين على 
ms1195	 ركبته وبعض فخذه وحلق بأصبعه ، ثم | انحط ساجدا بمثل ذلك ، ثم رفع رأسه بالتكبير بيديه إلى أن حاذتا ، بشحمة | أذنيه وإلى أن اعتدل في قيامه ورجع كل عظم إلى موضعه ، ثم صلى أربع | ركعات يفعل فيهن ما يفعل في هذه ، ثم جلس جلسة في التشهد مثل | ذلك ، ثم سلم على يمينه حتى يرى بياض خده الأيسر وسلم عن يساره | حتى يرى بياض خده الأيمن .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن وائل بن حجر | بهذا الإسناد . |(@)(@@) 4489 - حدثنا معمر بن سهل قال : نا عامر بن مدرك قال : نا | خلاد يعني بن مسلم الصفار عن موسى بن أبي عائشة عن عاصم بن | PageV10P357 | كليب عن أبيه عن وائل بن حجر - رضي الله عنه - قال : تفقدت | صلاة النبي - [ & ] - فرأيته يرفع يديه إذا كبر ، ثم يضع | يديه واحدة على الأخرى ، ثم إذا أراد أن يركع رفع يديه فكبر ، ثم قال | سمع الله لمن حمده فرفع فأوهمت رفع حين سجد أم لا قال فركع ركعتين | فلما قعد للتشهد افترش رجله اليسرى ووضع يده اليمنى على فخذه ، ثم | عقد أصبعه ، ثم حلق حلقة وأشار بالسبابة وسلم عن يمينه وعن يساره | قال ورأيته يكبر كلما خفض ورفع . | PageV10P358 |(@)(@@) | مسند | أبي برزة الأسلمي | رضي الله عنه(@)(@@) | PageV10P359 | صفحة فارغة . | PageV10P360 |(@)(@@) | حديث أبي برزة الأسلمي عن النبي - [ & ] -(@)(@@) 4490 - حدثنا يحيى بن حبيب بن عربي وإسحاق بن إبراهيم بن | الشهيد قالا : نا المعتمر بن سليمان قال : نا أبي عن أبي عثمان | النهدي عن أبي برزة [ 246 ] الأسلمي - رضي الله عنه - قال كنا مع | رسول الله - [ & ] - في سفر وجارية من الأنصار على | بعير لها فنظرت إلى رسول الله - [ & ] - خلفها وقد | تضايق بهم الجبل فقالت حل حل عليك لعنة الله - تعني - لبعيرها فقال | النبي - [ & ] - : ' من صاحب هذا البعير أو الراحلة فلا | يصحبنا بعير عليه من الله لعنة ' . | PageV10P361(@)(@@) وهذا الكلام قد روي عن النبي - [ & ] - بألفاظ | مختلفة فذكرنا كل حديث بلفظه في موضعه ولا نعلمه يروى عن أبي برزة | إلا من هذا الوجه واسم أبي 
ms1196	 برزة نضلة بن عبيد واسم أبي عزة يسار بن | عبيد واسم أبي عثمان النهدي عبد الرحمن بن مل . |(@)(@@) 4491 - حدثنا محمد بن معمر قال : نا هشام بن عبد الملك قال : | نا حماد بن سلمة عن ثابت البناني عن كنانة بن نعيم عن أبي برزة | - رضي الله عنه - أن رسول الله - [ & ] - لقى العدو فأفاء الله | عليه فقال : ' هل تفقدون من أحد ' قالوا نعم فلانا وفلانا ، ثم قال : ' هل | تفقدون من أحد ' في الثاني والثالث قالوا : لا قال : ' لكني أفقد جليبيبا | انطلقوا فالتمسوه في القتلى ' ، فالتمسوه فوجدوه إلى جنب سبعة قد | قتلهم ، ثم قتلوه فأتي النبي - [ & ] - فأخبر فجاء حتى قام | عليه فقال : ' هذا مني وأنا منه قتل سبعة هذا مني وأنا منه ' يقولها مرتين ، | ثم حمله على ساعديه ماله سرير غير ساعدي النبي - [ & ] - | حتى حفر له ودفن ولم يذكر غسلا . | PageV10P362(@)(@@) وهذا الحديث لا نعلم رواه إلا أبو برزة ولا نعلم له طريقا عن أبي | برزة إلا هذا الطريق . |(@)(@@) 4492 - حدثنا عمرو بن علي قال : نا أبو داود قال : نا حماد يعني | ابن سلمة عن الأزرق بن قيس عن شريك بن شهاب قال كنت | أتمنى أن ألقى رجلا من أصحاب النبي - [ & ] - أسأله عن | الخوارج فلقيت أبا برزة في يوم عيد في نفر من أصحابه ، فقلت له سمعت | رسول الله - [ & ] - ذكر الخوارج قال : سمعت رسول الله | - [ & ] - بأذني ورأيته بعيني أتي رسول الله - [ & ] - | بمال فأعطى من عن يمينه ومن عن شماله ، ولم يعط من وراءه | شيئا فقام رجل من ورائه فقال : يا محمد والله ما عدلت في منذ اليوم وكان | رجلا أسود مطموم الشعر عليه ثوبان أبيضان قال فغضب رسول الله | - [ & ] - غضبا شديدا وقال : ' والله لا تجدون بعدي رجلا | هو أعدل عليكم مني ' ثم قال : ' يخرج في آخر الزمان قوم كأن هذا | PageV10P363 | منهم يقرءون القرآن لا يجاوز تراقيهم يمرقون من الإسلام كما يمرق | السهم من الرمية سيماهم التحليق لا يزالون يخرجون حتى يخرج | آخرهم مع المسيح الدجال فإذا لقيتموهم فاقتلوهم شر الخلق | والخليقة ' .(@)(@@) وهذا الحديث 
ms1197	 قد روى نحو كلامه عن النبي - [ & ] - | من غير وجه فذكرنا كل حديث بلفظه في موضعه ولا نعلم روى | عن شريك بن شهاب إلا الأزرق بن قيس ولا نعلم روى غير هذا | الحديث . |(@)(@@) 4493 - حدثنا محمد بن عبد الملك القرشي قال : نا حماد بن زيد | عن جميل بن مرة عن أبي الوضيء عن أبي برزة - رضي الله عنه - قال : | قال رسول الله - [ & ] - : ' البيعان بالخيار ما لم يتفرقا ' . | PageV10P364 |(@)(@@) 4494 - وحدثناه محمد بن خالد بن خداش قال : نا عبد القاهر | ابن شعيب قال : نا هشام بن حسان عن جميل بن مرة عن أبي الوضيء | عن أبي برزة عن النبي - [ & ] - بنحوه . |(@)(@@) 4495 - حدثنا عمرو بن علي قال : نا يحيى بن سعيد قال : نا أبان | ابن صمعة عن أبي الوازع عن أبي برزة - رضي الله عنه - قال : قلت | يا رسول الله علمني شيئا أنتفع به قال : ' اعزل الأذى عن طريق | المسلمين ' .(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن أبي برزة وأبو | الوازع رجل من أهل البصرة وروى عنه أيوب وشداد بن سعيد ومهدي | ابن ميمون وغيرهم . | PageV10P365 |(@)(@@) 4496 - حدثنا محمد بن معمر قال : نا روح بن أسلم والحجاج | ابن نصير قال : نا أبو طلحة وهو شداد بن سعيد عن أبي الوازع عن | أبي برزة - رضي الله عنه - قال : قال رسول الله - [ & ] - : | ' إن لي حوضا ما بين أيلة وصنعاء عرضه كطوله يعب فيه ميزابان من | الجنة أحدهما من ورق والآخر من ذهب وأبيض من اللبن وأحلى من | العسل وأبرد من الثلج فيه آنية عدد نجوم السماء من شرب منه شربة | لم يظمأ حتى يدخل الجنة ' .(@)(@@) قال روح في حديثه وزاد شداد بن سعيد عن أيوب عن أبي الوازع | عن أبي برزة عن النبي - [ & ] - ' تنزوا في أيدي المؤمنين ' | يعني الآنية .(@)(@@) ولا نعلم روى أيوب عن أبي الوازع إلا هذا الحديث ولا رواه عن | أيوب إلا شداد بن سعيد . | PageV10P366 |(@)(@@) 4497 - حدثنا عبد الواحد بن غياث قال : نا مهدي بن ميمون | قال : نا أبو الوازع عن أبي برزة 
ms1198	 - رضي الله عنه - أن رسول الله | - [ & ] - بعث رجلا إلى حي من أحياء العرب فسبوه | وضربوه [ 247 ] فأتى النبي - [ & ] - فأخبره فقال : ' لو | أهل عمان أتيت إذا ما ضربوك ولا سبوك ' .(@)(@@) وهذا الحديث لا نعلمه بهذا اللفظ إلا عن أبي برزة عن النبي | - [ & ] - وقد روى عن ابن عمر قريبا منه بغير لفظه . |(@)(@@) 4498 - حدثنا محمد بن معمر ورجاء بن محمد قالا : نا يعلى بن | عبيد قال : نا الحجاج بن دينار عن أبي هاشم عن أبي العالية عن | أبي برزة - رضي الله عنه - قال : كان النبي - [ & ] - إذا | جلس فأراد أن يقوم قال : ' سبحانك اللهم وبحمدك أشهد أن لا إله إلا | أنت أستغفرك وأتوب إليك ' قالوا : يا رسول الله إنك لتقول كلاما ما | PageV10P367 | كنت تقوله فيما خلا فقال : ' هذا كفارة ما يكون من المجلس ' .(@)(@@) وهذا الحديث لا نعمله يروى عن أبي برزة إلا من هذا الوجه بهذا | الإسناد . |(@)(@@) 4499 - حدثنا محمد بن المثنى قال : نا عثمان بن عثمان | الغطفاني قال : نا خالد الحذاء عن المغيرة بن أبي برزة عن أبيه | - رضي الله عنه - أن النبي - [ & ] - نهى عن النوم قبلها | والحديث بعدها يعني العشاء . | PageV10P368 |(@)(@@) 4500 - وحدثناه محمد بن المثنى قال : نا محمد بن جعفر عن | شعبة عن خالد الحذاء عن أبي المنهال عن أبي برزة عن النبي - [ & ] - | بنحوه . |(@)(@@) 4501 - وحديث خالد الحذاء عن المغيرة بن أبي برزة عن أبيه | أحسب وهم فيه عثمان بن عثمان والصواب خالد الحذاء عن أبي | المنهال عن أبي برزة وأبو المنهال اسمه سيار بن سلامة . |(@)(@@) 4502 - وحدثنا محمد بن معمر قال : نا أبو النعمان محمد بن | الفضل قال : نا سكين بن عبد العزيز عن سيار بن سلامة عن أبي | PageV10P369 | برزة - رضي الله عنه - أن النبي - [ & ] - قال : ' الأمراء | من قريش ، ولي عليهم حق ولهم عليكم ، حتى ما فعلوا ثلاث ما | استرحموا فرحموا وحكموا فعدلوا وعاهدوا فوفوا فمن لم يفعل ذلك | منهم فعليه لعنة الله والملائكة والناس أجمعين ' .(@)(@@) وهذا الحديث لا نعلمه إلا عن أبي برزة بهذا الإسناد وسكين رجل | مشهور من 
ms1199	 أهل البصرة . |(@)(@@) 4503 - حدثنا يحيى بن حكيم قال : نا يحيى بن حماد قال : نا أبو | الأشهب واسمه جعفر بن حيان عن أبي الحكم عن أبي برزة - رضي الله | عنه - قال : قال رسول الله - [ & ] - : ' إنما أخشى عليكم | شهوات الغي في بطونكم وفروجكم ومضلات الهوى ' . | PageV10P370(@)(@@) وهذا الحديث لا نعلمه يروى بهذا اللفظ إلا عن أبي برزة بهذا | الإسناد . |(@)(@@) 4504 - حدثنا محمد بن المثنى ويحيى بن حكيم قال : نا عبد | الرحمن بن مهدي قال : نا شعبة عن علي بن زيد عن المغيرة بن أبي | برزة عن أبيه - رضي الله عنه - قال : ' أسلم سالمها الله وغفار غفر الله | لها ' . |(@)(@@) 4505 - وحدثناه يحيى بن حبيب بن عربي قال : نا خالد بن | الحارث قال : نا شعبة عن علي بن زيد عن المغيرة بن أبي برزة عن | النبي - [ & ] - بنحوه . | PageV10P371(@)(@@) وهذا الحديث لا نعلمه يروى عن أبي برزة إلا من هذا الوجه ولا | نعلم رواه عن علي بن زيد إلا شعبة . |(@)(@@) 4506 - حدثنا محمد بن معمر قال : نا حماد بن مسعدة قال : نا | عبد السلام بن أبي حازم قال رأيت أبا برزة وأرسل إليه ابن زياد يسأله | عن الحوض قال فأخبرني من دخل معه قال فلما رآه ابن زياد قال : إن | محمديكم هذا لدحداح قال فلما سمعها أبو برزة قال ما كنت أرى أن | أعيش حتى أعير بصحبة رسول الله - [ & ] - قال : فقيل له | إنك لا تعير بذلك قال وسأله ابن زياد عن الحوض فقال سمعت رسول الله | - [ & ] - يقول أحسبه قال : ' إن لي حوضا فمن كذب به | لا أورده الله يعني إياه ' . |(@)(@@) 4507 - حدثنا يحيى بن حكيم قال : نا أبو بحر عبد الرحمن بن | عثمان قال : نا عوف عن أبي المساور قال : قلت لأبي برزة رضي الله | PageV10P372 | عنه من رجم النبي - [ & ] - قال رجل منا يقال له ماعز بن | مالك . |(@)(@@) 4508 - حدثنا محمد بن موسى القطان الواسطي قال : نا أبو | المسيب سلام بن سلم الواسطي قال : نا مبارك بن فضالة عن الأزرق | بن قيس عن أبي برزة - رضي الله عنه 
ms1200	 - أن النبي - [ & ] - | قال : ' خير الناس قرني ، ثم الذين يلونهم ، ثم الذين يلونهم ' .(@)(@@) وهذا الحديث لا نعلم أحدا أسنده إلا مبارك بن فضالة عن الأزرق | عن أبي برزة ولا نعلم رواه عن مبارك بن فضالة إلا سلام بن سلم . | PageV10P373 |(@)(@@) 4509 - وحدثنا عباد بن يعقوب الكوفي قال : نا محمد بن فضيل | ابن غزوان قال : نا يزيد بن أبي زياد عن سليمان بن عمرو بن | الأحوص عن أبي هلال العكي عن أبي برزة الأسلمي - رضي الله | عنه - أن رسول الله - [ & ] - نظر إلى رجلين في أحد | يتمثلان بهذا الشعر في حمزة [ 248 ] . |(@)(@@) % تركت حوريا تلوح عظامه % % زوي الحرب عنه أن يجن فيقبرا %(@)(@@) فقال رسول الله - [ & ] - : ' اللهم اركسهما في | الفتنة ركسا وادعهم إلى العذاب دعا ' . | PageV10P374(@)(@@) وسليمان بن عمرو بن الأحوص روى عنه يزيد بن أبي زياد وغيره | وأبو هلال العكي فرجل غير معروف . |(@)(@@) 4510 - حدثنا أحمد بن سنان الواسطي قال : نا يزيد بن هارون | قال : نا عبد السلام عن الأزرق بن قيس عن أبي برزة - رضي الله عنه - | عن النبي - [ & ] - في حديث طويل ذكره أنه توضأ | ومسح على الخفين . |(@)(@@) 4511 - حدثنا محمد بن معمر ، قال : نا محمد بن خالد بن عثمة | قال : نا إبراهيم بن سعد قال : نا عبد الله بن عامر عن محمد من ولد | أبي برزة عن أبي برزة الأسلمي - رضي الله عنه - أن النبي - [ & ] - | PageV10P375 | عليه وسلم - قال : ' ليس من البر الصيام في السفر ' . |(@)(@@) 4512 - حدثنا محمد بن عمرة الرازي قال : نا السندي بن | عبدويه قال : نا جسر بن جعفر عن الأزرق بن قيس قال سمعت أبا | برزة الأسلمي - رضي الله عنه - يقول غزوت مع رسول الله - [ & ] - | PageV10P376 | غزوة كذا وغزوة كذا حتى عد ثمان غزوات فما رأينا منه | إلا التيسير والتخفيف .(@)(@@) قال أبو بكر علقمة بن مرثد إنما يحدث عن سليمان بن بريدة عن | أبيه ومحارب بن دثار إنما يحدث عن سليمان بن بريدة ومحمد بن جحادة | إنما يحدث عن سليمان بن بريدة وسليمان الأعمش إنما يحدث عن ابن | بريدة فذكر غير واحد 