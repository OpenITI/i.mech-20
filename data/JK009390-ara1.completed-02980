ms2961	 :(@)(@@) | 30 ( يا حمزة ! نفس تحييها أحب إليك أو نفس تميتها ؟ قال : نفس أحييها ، قال : عليك بنفسك ) )(@)(@@) ( حم ) عن ابن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ 27772 قال النبي :(@)(@@) | 30 ( يا حمزة ! إن الدنيا خضرة حلوة ، فمن أخذها بحقها بورك له فيها ، ورب متخوض في مال الله ومال رسوله له النار ) )(@)(@@) الحكيم عن خولة بنت سعد الأنصارية امرأة حمزة رضي الله عنها .(@)(@@)(@@)(@@) $ 27773 قال النبي :(@)(@@) | 30 ( يا حملة القرآن ! إن أهل السماوات يذكرونكم عند الله فتحببوا إلى الله بتوقير كتابه ليزداد لكم حبين يحببكم إلى عباده ) )(@)(@@) أبو نعيم عن صهيب رضي الله عنه .(@)(@@)(@@)(@@) $ 27774 قال النبي :(@)(@@) | 30 ( يا حمير ! أما شعرت أن الأنين اسم من أسماء الله يستريح به المريض ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@) PageV09P162(@)(@@)(@@)(@@) $ 27775 قال النبي :(@)(@@) | 30 ( يا حكيم ابن حزام ! إن هاذا المال خضرة حلوة ، فمن أخذه بسخاوة نفس ، وحسن أكله بورك له فيه ، ومن أخذه باستشراف نفس وسوء أكلة لم يبارك له ، وكان كالذي يأكل ولا يشبع ، اليد العليا خير مناليد السفلى ، وابدأ بمن تعول ) )(@)(@@) ( طب ) عن حكيم بن حزام رضي الله عنه .(@)(@@)(@@)(@@) $ 27776 قال النبي :(@)(@@) | 30 ( يا حميراء ! إن ويحك أو ريسك رحمة فلا تجزعي منها ، ولاكن اجزعي من الويل ) )(@)(@@) أبو الحسن الربي في الحربيات عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ 27777 قال النبي :(@)(@@) | 30 ( يا خالد ! إنها ستكون بعدي أحداث وفتن وفرقة واختلاف ، فإذا كان ذالك ، فإن استطعت أن تكون عبد الله المقتول لا القاتل فافعل ) )(@)(@@) ( ش حم ) و نعيم بن حماد في الفتن ، ( طب ) والبغوي والباوردي وابن قانع وأبو نعيم ، ( ك ) عن خالد بن عرفطة رضي الله عنه .(@)(@@)(@@)(@@) $ 27778 قال النبي :(@)(@@) | 30 ( يا خالد ! لا تسب عمارا ، فإنه من يعادي عمارا يعاديه الله ، ومن يبغض عمارا يبغضه الله ، ومن يسب عمارا يسبه الله ، ومن يسفه عمارا يسفهه الله ، ومن يحقر عمارا يحقره الله ) )(@)(@@) ( ط ) و سمويه ، ( طب ك ) عن خالد بن الوليد رضي الله عنه .(@)(@@)(@@)(@@) $ 27779 قال النبي :(@)(@@) | 30 ( يا خ| باب ! خمس إن فعلت بهن 
ms2962	 رأيتني وإن لم تفعل بهن لم ترني : تعبد الله ولا تشرك به شيئا وإن قطعت وحرقت ، وتؤمن بالقدر ، تعلم أن ما أصابك لم يكن ليخطئك ، وما أخطأك لم يكن ليصيبك ، ولا تشرب الخمر فإن خطيئتها تفرع الخطايا ، كما أن شجرتها تعلو الشجر ، وبر والديك وإن أمراك أن تخرج من كل شيء من الدنيا ، وتعتصم بحبل الجماعة فإن يد الله على الجماعة ، يا خباب ! إنك إن رأيتني يوم القيامة لم تفارقني ) )(@)(@@) ( طب ) عن خباب رضي الله عنه .(@)(@@) PageV09P163(@)(@@)(@@)(@@) $ 27780 قال النبي :(@)(@@) | 30 ( يا خريم بن فاتك ! لولا خلتان فيك لكنت أنت الرجل ، توفي شعرك وتسبل إزارك ) )(@)(@@) ( حم ) و ابن سعد ، ( طب ك ) وتعقب ( حل ) عن خريم بن فاتك رضي الله عنه .(@)(@@)(@@)(@@) $ 27781 قال النبي :(@)(@@) | 30 ( يا رافع ! إن شئت نزعت السهم والقطبة جميعا ، وإن شئت نزعت السهم وتركت القطبة وأشهد لك يوم القيامة أنك شهيد ) )(@)(@@) ( ط حم ) و ابن سعد ، ( طب ) عن رافع بن خديج رضي الله عنه أنه أصابه سهم مع رسول الله قال فذكره .(@)(@@)(@@)(@@) $ 27782 قال النبي :(@)(@@) | 30 ( يا زبير ! إن باب الرزق مفتوح من لدن العرش إلى قرار بطن الأرض ، يرزق الله كل عبد على قدر همته ونهمته ) )(@)(@@) ( حل ) عن الزبير رضي الله عنه .(@)(@@)(@@)(@@) $ 27783 قال النبي :(@)(@@) | 30 ( يا زيد ! أعط زكاة رأسك مع الناس وإن لم تجد إلا صاعا من حنطة ) )(@)(@@) ( طب ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ 27784 قال النبي :(@)(@@) | 30 ( يا زيد ! إن تكن عند الناس كاسدا فإنك لست عند الله بكاسد ، إذا قدمت المدينة فانزل علي ، وإذا أنا بدرت نزلت عليك ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ 27785 قال النبي :(@)(@@) | 30 ( يا زيد ! لو أن عينيك لما بهما فصبرت واحتسبت لم يكن لك ثواب دون الجنة ) )(@)(@@) ( طب ) عن زيد بن أرقم رضي الله عنه .(@)(@@)(@@)(@@) $ 27786 قال النبي :(@)(@@) | 30 ( يا زيد ! تعلم لي كتاب يهود فإني والله ما آمن يهود على كتابي ) )(@)(@@) ( حم ) عن زيد بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ 27787 قال النبي :(@)(@@) | 30 ( يا 
ms2963	 سائب ! قد كنت تعمل أعمالا في الجاهلية لا تقبل PageV09P164 منك وهي اليوم تقبل منك ) )(@)(@@) ( حم ) و ابن سعد ، ( طب عن السائب بن السائب رضي الله عنه .(@)(@@)(@@)(@@) $ 27788 قال النبي :(@)(@@) | 30 ( يا سعد ! أفلا أخبرك بأعجب من ذلك ؟ قوم علموا ما جهل هاؤلاء ، ثم جهلوا كجهلهم ) )(@)(@@) ابن عساكر عن سعد بن أبي وقاص رضي الله عنه أنه قال : يا رسول الله ! أتيتك من عند قوم هم وأنعامهم سواء قال فذكره .(@)(@@)(@@)(@@) $ 27789 قال النبي :(@)(@@) | 30 ( يا خفاف ! ابتغ الرفيق قبل الطريق ، فإن عرض لك أمر نصرك ، وإن احتجت إليه رفدك ) )(@)(@@) ( خط ) الجامع عن خفاف بن ندبة رضي الله عنه .(@)(@@)(@@)(@@) $ 27790 قال النبي :(@)(@@) | 30 ( يا خولة ! لا نصبر على حر ولا نصبر على برد ) )(@)(@@) ( هب ) عن خولة بنت قيس رضي الله عنها .(@)(@@)(@@)(@@) $ 27791 قال النبي :(@)(@@) | 30 ( يا خولة ! لا نصبر على حر ولا برد ، يا خولة ! إن الله تعالى أعطاني الكوثر ، وهو نهر في الجنة ، وما خلق أحب إلي عمن يرده من قومك ، يا خولة ! رب متخوض في مال الله ومال رسوله فيما اشتهت نفسه له النار يوم القيامة ) )(@)(@@) ( طب ) عن خولة بنت قيس رضي الله عنها .(@)(@@)(@@)(@@) $ 27792 قال النبي :(@)(@@) | 30 ( يا رباح ! لا تنفخ في الصلاة فإنه من نفخ فقد تكلم ) )(@)(@@) ( ك ) في تاريخه عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ 27793 قال النبي :(@)(@@) | 30 ( يا سايب ! أنظر أخلاقك التي كنت تصنعها في الجاهلية فاجعلها في الإسلام ، أقر الضيف ، وأكرم اليتيم ، وأحسن إلى جارك ) )(@)(@@) ( حم ) و البغوي عن السائب بن السائب عبد الله المخزومي رضي الله عنه .(@)(@@)(@@)(@@) $ 27794 قال النبي :(@)(@@) | 30 ( يا سعد ! ألا أدلك على صدقة ، خفيفة مؤونتها ، PageV09P165 عظيم أجرها ؟ : تسقي الماء ) )(@)(@@) ( طب ) عن سعد بن عبادة رضي الله عنه .(@)(@@)(@@)(@@) $ 27795 قال النبي :(@)(@@) | 30 ( يا سراقة ! اعمل لما جف به القلم وجرت به المقادير ، فإن كلا ميسر ) )(@)(@@) ( طب ) عن سراقة بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ 27796 قال النبي :(@)(@@) | 30 ( يا سراقة ! ألا أخبرك بأهل الجنة وأهل النار ؟ أما أهل النار فكل جعظري 
