ms121	 كنت إلا للصبابة داعيا(@)(@@) % فذكرتني نجدا وما كنت ناسيا % % 6(@)(@@) % ليال سرقناها من الدهر في نجد ' % % 7(@)(@@) % نواعم عيش مازج الأنس زهرها % % رطاب أديم خالط المسك نشرها % % 8(@)(@@) % رقاق حواش قرب الوصل فجرها % ' ليال قصيرات ، ويا ليت عمرها % % 9(@)(@@) % يمد بعمري فهو غاية ما عندي ' % % PageV01P405 10(@)(@@) % رياح الهنا فيها تنشقت عرفها % % وفيها مدام اللهو عاقرت صرفها % % 11(@)(@@) % لدى روضة لا يبلغ العقل وصفها(@)(@@) % بها طلعت شمس النهار فلفها % % 12(@)(@@) % ظلامان من ليل ومن فاحم جعد % % 13(@)(@@) % سوادان يعمى الفجر بين دجاهما % % هما اثنان لكن واحد منتماهما % % 14(@)(@@) % أتت تتخفى خيفة في رداهما(@)(@@) % ولو لم تغطي خدها ظلماتها % % 15(@)(@@) % لشق عمود الصبح من وجنة الخد ' % % 16(@)(@@) % فأبصرت منها إذا سهت منه غرة % محيا هو الشمس المنيرة غرة % 17(@)(@@) % ولاح لها خد ، هو النور نضرة(@)(@@) % قد اختلست منها عيوني نظرة % 18(@)(@@) % أرتني لهيب النار في جنة الخلد % % PageV01P406 % 19(@)(@@) % تحيرت في بدر من الوجه زاهر % يلوح على غصن من القد ناضر % 20(@)(@@) % وأسياف لحظ في الجفون بواتر % ' في وجنتيها حمرة شك ناظري % % 21(@)(@@) % أمن دم قلبي لونها أم من الورد % % 22(@)(@@) % فبالشذر أيدي الحسن طرزن صدرها % % وبالنجم لابالدر وشحن خصرها % % 23(@)(@@) % لها مقلة هاروت ينفث سحرها % ' وفي نحرها عقد توهمت ثغرها % % 24(@)(@@) % لئالئه نظمن من ذلك العقد % % 25(@)(@@) % بنفسي هيفاء الوشاح من الدمى % % سقتني حميا الراح صرفا من اللمى % % PageV01P407 26(@)(@@) % فأمسيت من وصف المدام متيما % ' وما كنت أدري ما المدام ، وإنما % % 27(@)(@@) % عرفت مذاق الراح من ريقها الشهد ' % % 28(@)(@@) % وقبل ارتشاف الثغر ما لذة الهنا % % وقبل سنا الخدين ما لامع السنا % % 29(@)(@@) % وقبل رنين الحلي مارنة الغنا(@)(@@) % وقبل اهتزاز القد ما هزة القنا % % 30(@)(@@) % وقبل حسام اللحظ ما الصارم الهندي % % 31(@)(@@) % لها كل يوم عطفة ثم نبوة % وما علقت فيها بقلبي سلوة % 32(@)(@@) % فمن بعدها زادت بقلبي صبوة % ' ومن قربها مالت برأسي نشوة % % 33(@)(@@) % صحوت بها يامي من سكرة البعد % % PageV01P408 34(@)(@@) % ولا عجب إن يشف في عطف قلبها % % سقام جفاها يوم بت بجنيها 
ms122	 % % 35(@)(@@) % هي الداء طورا والشفاء لصبها(@)(@@) % وإن زال سكر البعد من سكر قربها % % 36(@)(@@) % فلا طب حتى يدفع الضد بالضد % % 37(@)(@@) % فمذ كنت ذرا قد تعشقت زينبا % % وفي عالم الأصلاب زدت تعذبا % % 38(@)(@@) % وموهت في ضرب من اللحن مطرب(@)(@@) % تعشقتها طفلا وكهلا وأشيبا % % 39(@)(@@) % وهما عرته رعشة الرأس والقد % % 40(@)(@@) % أغار عليها أن يمر بشعبها % % نسيم الصبا أو يكتسي طيب تربها % % 41(@)(@@) % وأدري بحبي كيف بات بقلبها % ' ولم تدر ليلى أنني كلف بها % % PageV01P409 42(@)(@@) % وقلبي من نار الصبابة في وقد ' % % 43(@)(@@) % وأخفيت عن نفسي هوى سقمه شكت % % ولم تدر أحشائي بمن نارها ذكت % % 44(@)(@@) % وكفي لأسناني لمن أسفا نكت % ' وما علمت من كتم حبي لمن بكت % % 45(@)(@@) % جفوني ولا قلبي لمن ذاب في الوجد % % 46(@)(@@) % إذا ما تذاكرنا الهوى بتشبب % أتيت بتشبيب عن الشوق معرب % 48(@)(@@) % وأدفع في هند ومية عن دعد % % 49(@)(@@) % وإن قلت إني واجد في جآذر % فوجدي بريا لا بوحش نوافر % 50(@)(@@) % وإن قلت أروى فالمنى أم عامر % وإن قلت شوقي باللوى فبحاجر % % 51(@)(@@) % أو المنحنى فاعلم حننت إلى نجد % % PageV01P410 52(@)(@@) % فيحسب طرفي في هوى تلك قد قذي % % وأن بهاتيك العذارى تلذذي % % 53(@)(@@) % وفي ذكر أوطان لها القلب يغتذي % ' وما ولعت نفسي بشيء سوى الذي % % 54(@)(@@) % ذكرت ، ولكن تعلم النفس ما قصدي % % 55(@)(@@) % وأكرم أرباب الغرام الألى خلوا % % أناس أسروا سره مذ به ابتلوا % % 56(@)(@@) % وقال لقوم للأذاعة ما قلوا % ' كذا من تصدى للهوى فليكن ولو % % 57(@)(@@) % تجرع من أحبابه علقم الصد ' % % 58(@)(@@) % فان الفتى من يحكم الرأي فكره % ويعجز أرباب البصيرة سبره % 59(@)(@@) % وذو الحزم من يخفى على الناس أمره % ' وليس الفتى ذو الحزم من راح سره % % 60(@)(@@) % تناقله الأفواه للحر والعبد ' % % PageV01P411 61(@)(@@) % إذا لم يصنه عن خليل وحسد % % تحدث فيه الناس في كل مشهد % % 62(@)(@@) % وغنت به الركبان في كل فدفد(@)(@@) % فيسري إلى القاصي كما بمحمد % % 63(@)(@@) % سرت بنت فكري بالثناء وبالحمد ' % % 64(@)(@@) % لقد جمدت دون القريض القرايح % وماتت بموت الماجدين المدايح % % 65(@)(@@) % فما لرتاج 
ms123	 الشعر إلاي فاتح % ' وما للثنا إلا محمد صالح % % 66(@)(@@) % لقد ضل مهديه لغير أبي المهدي % % 67(@)(@@) % ظهور العلى في مثله ما استقلت % له رتبة عنها الكواكب خطت % % 68(@)(@@) % فتى إن يرم إدراكه العقل يبهت % ' همام إلى العلياء حدة فكرتي % % 69(@)(@@) % بعثت فلم تبصر لعلياه من حد % % PageV01P412 70(@)(@@) % مليك عليه طائر الوهم لم يحم % وكل ابن مجد شأو علياه لم يرم % 71(@)(@@) % تحدر من أصلاب فخر غدت عقم(@)(@@) % وعن مثله أم المكارم لم تقم % % 72(@)(@@) % فأبى ترى ندا لجوهره الفرد ' % % 73(@)(@@) % له خلق ما شاب سلساله القذا % % ولا هو في غير الفخار تلذذا % % 74(@)(@@) % وغير العلى منذ الولادة ما اغتذى % ' تربى بحجر المجد طفلا وقبل ذا % % 75(@)(@@) % براه إله العرش من عنصر المجد ' % % 76(@)(@@) % فعلم صوب الغيث أن يتهللا % % ووازن منه الحلم رضوى ويذبلا % % 77(@)(@@) % وفات جميع السابقين إلى العلى(@)(@@) % ترقى النهى قبل الفطام به إلى % % 78(@)(@@) % نهاية إدراك الأنام من الرشد ' % % 79(@)(@@) % تجمع شمل الزهد لما تشتتا % % وعاش التقى من بعد ما كان ميتا % % PageV01P413 80(@)(@@) % بذي نسك ما زال لله مخبتا(@)(@@) % ومعتصم مما يشان به الفتى % % 81(@)(@@) % بعفة نفس تربه وهو في المهد ' % % 82(@)(@@) % فلا غرو إن عمت نوافله الملا % % وطبقن ظهر الأرض سهلا وأجبلا % % 83(@)(@@) % وفات الورى فخرا ومجدا مؤثلا % ' فذا واحد الدنيا انطوى برده على % % 84(@)(@@) % جميع بني الدنيا فبورك من برد ' % % 85(@)(@@) % عليه العلا قد دار إذ هو قطبه % % وفي فخره من دهره ضاق رحبه % 86(@)(@@) % وبيت علاه سامت الشهب كثبه(@)(@@) % رفيع مقام أين ما حل تربه % % 87(@)(@@) % من الشهب تمسي تربها أنجم السعد ' % % 88(@)(@@) % عظيم محل كان للفضل جوهرا % % له رتبة طالت على الشم مفخرا % % 89(@)(@@) % لتأنف أن يستام عزة نخوتي % ' على شرفات المجد مغناه والورى % % PageV01P414 90(@)(@@) % بحصبائه ، لا بالكواكب ، تستهدي ' % % 91(@)(@@) % إذا هو بالايحاش بدل أنسه % % تبيت صروف الدهر تنكر مسه % % 92(@)(@@) % همام عليه يحسد الغد أمسه(@)(@@) % تراه ، ولو قد كان يخفض نفسه % % 93(@)(@@) % لآمله عطفا ويبسم للوفد ' % % 94(@)(@@) % رفيعا بحيث النجم لم يك ممسكا 
ms124	 % % بأذياله والفكر لم ير مسلكا % % 95(@)(@@) % % ثبيرا على جنب الوثير قد اتكا % % 96(@)(@@) % ودون لقاه هيبة الأسد الورد % % 97(@)(@@) % أعز الورى نفسا وأزكى نجابة % وأسبق في الآراء منهم إصابة % 98(@)(@@) % وأبلغهم وسط الندي خطابة % ' له الفصحاء المفلقون مهابة % 99(@)(@@) % إذا سئلوا لا يستطيعون للرد ' % % PageV01P415 100(@)(@@) % عليم له نفس عن الله لم تمل % % ومن ذكر ما لم يرضه لم يزل وجل % % 101(@)(@@) % ومنه وعنه العلم بين الورى نقل % ' لقد ضاق صدر الدهر من بعض بثه ال % % 102(@)(@@) % علوم ، وما يخفيه أضعاف ما يبدي ' % % 103(@)(@@) % وعمياء سدت عن ذوي الرشد سبلها % % تساوى بها علم الأنام وجهلها % % 104(@)(@@) % جلاها فتى تدري العلوم وأهلها(@)(@@) % إذا انعقدت عوصاء أشكل حلها % % 105(@)(@@) % فليس لها إلاه للحل والعقد ' % % 106(@)(@@) % وغامضة فهم الورى دونها انقطع % % وليس لهم في حل معقودها طمع % % 107(@)(@@) % إذا أعوصت في كشف غامضها صدع(@)(@@) % فيوضحها بعد الغموض ولم يدع % % 108(@)(@@) % لمعترض بابا لها غير منسد % % PageV01P416 109(@)(@@) % وكانت متى فاهت ذوو الحزم تخزهم % % فيرضوا بذل العجز من بعد عزهم % % 110(@)(@@) % وحتى تحاماها الفحول برمزهم % % وعنه أرم الناطقون لعجزهم % % 111(@)(@@) % ومذوده فى القول منشحذ الحد % % 112(@)(@@) % تراه به عضب المضارب مرهفا % % إذا هو أمضى الحكم لن يتوقفا % % 113(@)(@@) % فيمسي عليه طالبوا العلم عكفا % ' فيلقي إلى أذهانها علم ما اختفى % % 114(@)(@@) % ويفرغ فى آذانها لؤلؤ العقد % % 115(@)(@@) % ومن كل طخياء جلا كل غبرة % بايضاح قول عن لسان كزبرة % 116(@)(@@) % ولم يك إلاه بحدة فكرة(@)(@@) % رشيد بعين الحزم أول نظرة % PageV01P417 117(@)(@@) % يرى ما به ضلت عقول ذوي الرشد ' % % 118(@)(@@) % ترد أمور الناس في كل مشكل % إلى قلب ، إن أشكل الرأى ، حول % 119(@)(@@) % ومن كل أمر فاتح كل مقفل(@)(@@) % يسدد سهم الرأى في كل معضل % % 120(@)(@@) % إذا طاشت الآراء فيه عن القصد % % 121(@)(@@) % فتى معه المعروف يرحل رحل % % وتنزل آمال الورى حيثما نزل % % 122(@)(@@) % ببرد التقى فوق العفاف قد اشتمل % ' ترى نفسه من حبها الله لم تزل % % 123(@)(@@) % بطاعته لله في غاية الجهد % % 124(@)(@@) % حليف التقى ما انفك لله 
ms125	 شاكرا % % وللنوم ، من حب العبادة ، هاجرا % % PageV01P418 125(@)(@@) % وفي ورده ما زال لليل عامرا % ' يقوم إلى ما كان ندبا مبادرا % % 126(@)(@@) % مبادرة الهيم العطاش إلى الورد % % 127(@)(@@) % فيجلو ظلام الليل منه إذا سجى % % بغرة وجه كالصباح تبلجا % % 128(@)(@@) % وعن قلب مسجور الحشى يظهر الشجا % ' وفي عين عاض نادم يسهر الدجا % % 129(@)(@@) % وما هم بالعصيان للواحد الفرد ' % % 130(@)(@@) % فكم شاد بالتقوى بيوت هدى درس % % وقام بعين جفنها النوم لم يدس % % 131(@)(@@) % بأوراده يقضي دجا الليل في أنس(@)(@@) % فيقصر عن أوراده ولو أنه اس % % 132(@)(@@) % تدام بجنح سرمد الدهر مسود ' % % 133(@)(@@) % إذا لم يفض يوما على الدهر عفوه % أتاه منيبا يقبض الخوف خطوه % % PageV01P419 134(@)(@@) % ونادى بصوت ليس يرفع نحوه(@)(@@) % فيا سابقا لم يدرك العقل شأوه % % 135(@)(@@) % ولا تهتدي الأوهامة منه إلى قصد ' % % 136(@)(@@) % ألا اسق رياضي ، أنها اصفر زهرها % % وضوء ليالي التي حلن غرها % % 137(@)(@@) % أنر وجه أيامي التي اسود فجرها(@)(@@) % فشمس بني العلياء أنت وبدرها % % 138(@)(@@) % أخوك ربيع الخلق في الزمن الصلد ' % % 139(@)(@@) % ونفسكما من كل إثم تقدست % % وداركما قدما على الجود أسست % % 140(@)(@@) % وجودكما بالنور نته الربا اكتست % ' وحلمكما منه الجبال لقد رست % % 141(@)(@@) % ويطبع من عزميكما الصارم الهندي % % 142(@)(@@) % وإنكما عقدان للفضل حليا % % وبدران في أفق المعالي تجليا % % PageV01P420 143(@)(@@) % وصقران في جو المكارم جليا % ' وغيثا عطاء أنتما يفضح الحيا % % 144(@)(@@) % فيعول إعلانا من الغيظ بالرعد ' % % 145(@)(@@) % ضلال لذي قصد لغير كما رحل % % وأمسي له في غير جودكما أمل % % 146(@)(@@) % ألم يدر مذ جود الكرام قد اضمحل % % بقية جود للورى ذخر وكما ال % % 147(@)(@@) % كرام لمن من بعدهم جاء يستجدي % % 148(@)(@@) % وأبقوكما في الأرض للخلق مقصدا % % ليمسي علاهم فيكما متجددا % % 149(@)(@@) % ويبقى نداهم في الزمان مخلدا % % لعلمهم في موتهم يدج الندى % % 150(@)(@@) % بأكفانهم ميتا ويدفن في اللحد % % 151(@)(@@) % كأن الورى كانوا بنيهم وأنتما % % أقاموكما فيهم كفيلا وقيما % % 152(@)(@@) % ومن بعدهم في ذلك العبء قمتما % % فأحييتما ميت الندى فكأنما % % PageV01P421 153(@)(@@) % هم بكما ردوا إلى الجود والمجد % % 154(@)(@@) % توارثتما منهم سماء مفاخر % وزينتموها 
ms126	 في نجوم زواهر % 155(@)(@@) % وقد حزتما ما أحرزا من ذخائر % وأحرزتما ما خلفوا من مآثر % 156(@)(@@) % ولم تدعا شيئا من الحسب العد % % 157(@)(@@) % كرام على كل الأنام لهم يد % وبيت علاهم في الزمان مشيد % 158(@)(@@) % وليس عليهم زاد في الفضل سيد % لئن زاد في معنى طريف محمد % 159(@)(@@) % عليهم فذا فرع لمجدهم التلد % % 160(@)(@@) % وإن هم ببطن الأرض من قبل أضمروا % % فإن لعلياهم معاليه مظهر % 161(@)(@@) % وطي مساعيهم به عاد ينشر % وإن درجوا موتى بعلياه عمروا % % 162(@)(@@) % بعمر لأقصى غاية الدهر ممتد % % PageV01P422 163(@)(@@) % فمن جوهر العلياء كانوا فرنده % % وأول من أورى من الجود زنده % % 164(@)(@@) % درى الحي فيهم والذي حل لحده % % هم شرعوا للجود في الناس نجده % % 165(@)(@@) % ولولاهم ما كان للجود من نجد % % 166(@)(@@) % فهل لسواها الزاخرات قد اعتزت ؟ % وهل غيرها سحب إذا السحب أعوزت ؟ % 167(@)(@@) % لقد أحرزت بالوفر حمدا فبرزت % % ولو لم تحز بالوفر حمدا لأحرزت % % 168(@)(@@) % حسان سجاياها لها أوفر الحمد % % 169(@)(@@) % إذا في الشتاء الشول غبراء روحت % % ومص الثرى ماء الرياض فصوحت % % 170(@)(@@) % فانهما فيها سيول تبطحت % % أناس يرى في الكرخ من فيه طوحت % % 171(@)(@@) % إليهم بنات الشدقميات من بعد % % 172(@)(@@) % سنا نارهم قد صيروه نعوتهم % % لمسترشد الظلماء كي لا يفوتهم % % PageV01P423 173(@)(@@) % ويبصر من وافى لكي يستبيتهم % % 174(@)(@@) % لكعبة جدواهم لمن أمها تهدي % % 175(@)(@@) % لهم أوجه يستصبحون بها الملا % % كأن بدور التم منهن تجتلى % % 176(@)(@@) % فلو قابلوا فيها دجى الليل لانجلى % % ولو وزنت فيهم شيوخ بني العلى % % 177(@)(@@) % لما عدلوا طفلا لهم كان في المهد % % 178(@)(@@) % فطفلهم حذو المسن قد احتذى % % وعزتهم أضحت لعين العدا قذا % % 179(@)(@@) % وكل من الحساد فيها تعوذا % % وكلا إذا أبصرت منهم تقول : ذا % % 180(@)(@@) % محمد فيه شارة الأب والجد % % 181(@)(@@) % رفيع على لا يطلع الفكر نجده % % حليف تقى لا يعلق الأثم برده % % 182(@)(@@) % أخو الحزم ما حلت يد الدهر عقده % % إذا انعقد النادي تراه وولده % % PageV01P424 183(@)(@@) % لناديه عقدا وهو واسطة العقد % % 184(@)(@@) % كأن عقابا فيه بين قشاعم % وليث عرين فيه بين 
ms127	 ضراغم % 185(@)(@@) % وصل صفاة فيه بين أراقم % على أنهم فيه نجوم مكارم % 186(@)(@@) % تحف ببدر المجد في مطلع السعد % % 187(@)(@@) % بروق علاهم من سناها تكشفت % % وكفهم للوفد من سيبه كفت % % 188(@)(@@) % وفي رحمة منه عليهم تعطفت % % وأخلاقهم من حسن أخلاقه صفت % % 189(@)(@@) % ومنها اكتسى لطفا نسيم صبا نجد % % 190(@)(@@) % فلو نفحت ميتا لأحيته حقبة % ولو كن في المسبوب لم ير سبة % 191(@)(@@) % ولو كن في المكروب لم ير كربة % ولو ذاقها الأعداء كانوا أحبة % 192(@)(@@) % لنوعين فيها من رحيق ومن شهد % % PageV01P425 193(@)(@@) % وجودهم في المحل من جود كفه % % وإن شمخت آنافهم فبأنفه % % 194(@)(@@) % وعرف علاهم فاح من طيب عرفه % % تضوع من أعطافهم ما بعطفه % % 195(@)(@@) % لطائم فخر ينتسبن إلى المجد % % 196(@)(@@) % أعز بني الدنيا وأطيب عنصرا % % لهم عاد عود الفضل فينان مثمرا % % 197(@)(@@) % وفيهم غدا صبح المكارم مسفرا % ' سلالة مجد هم مصابيح في الورى % % 198(@)(@@) % بكل إذا استهدت فذاك هو ( المهدي % % 199(@)(@@) % له راحة للوفد تبسط أنملا % % 200(@)(@@) % فتى مذ نشا تدري جميع بني العلى(@)(@@) % له مفخر لو بعضه اقتسم الملا % % 201(@)(@@) % لزاد ، وما قد زاد جل عن العد ' % % PageV01P426 202(@)(@@) % وسادوا بما حار النهى في عجيبه % % وبدر السما استغنى بهم عن مغيبه % % 203(@)(@@) % فأمسوا وكل مشرق في غروبه % ' وأصبح كل ساميا في نصيبه % % 205(@)(@@) % وشأو ذوو العلياء لا يعلقونه % % وكنه ذوو الأفهام لا يدركونه % % 206(@)(@@) % وقدر يغض الدهر عنه جفونه(@)(@@) % وعز أكف الدهر تحسم دونه % % 207(@)(@@) % فيرنوا إليه الدهر في مقل رمد ' % % 208(@)(@@) % وحلم يراديه الزمان بخطبه % % فيلفيه أرسى من أبان وهضبه % % 209(@)(@@) % وفهم لسقم الجهل شاف بطبه % ' ورأي يرى ما غاب من خلف حجبه % % 210(@)(@@) % كأن بابه عن رأيه غير منسد ' % % 211(@)(@@) % يبيت على حفظ العلى غيرها جد % % ويبذل فيها من طريف وتالد % % 212(@)(@@) % وتبصر منه عين كل مشاهد(@)(@@) % فتى قد رقى العليا بهمة ماجد % % PageV01P427 213(@)(@@) % له أحرزت شأو العلى وهو في المهد % % 214(@)(@@) % ومن ساعة الميلاد في حبها صبا % % وكانت له أما وكان لها أبا % % 215(@)(@@) % فإن تعتجب 
ms128	 من ذا تجد منه أعجبا(@)(@@) % إذا ما تراءى محتب شك في الحبا % % 216(@)(@@) % على رجل معقودة أو على أحد ' % % 217(@)(@@) % فإن قلت : هذا مرهف كان أرهفا % % وأخلاقه : هن الصبا كن ألطفا % % 218(@)(@@) % وإن قلت : ذا ماء السما لست منصفا(@)(@@) % لعمرك ما ماء السماء وإن صفا % % 219(@)(@@) % بأطيب مما منه قد ضم في البرد % % 220(@)(@@) % وهوب لو ان البحر في كفه فني % % وآمله عن صيب المزن قد غني % % PageV01P428 221(@)(@@) % حميد سجايا للمكارم يقتني % ' فريدة هذا الدهر لو لم نجد بني % % 222(@)(@@) % أبيه تعالى عن شبيه وعن ند % % 223(@)(@@) % كرام بهم ربع المكارم روضا % % وصبح العلى من نورهم عاد أبيضا % % 224(@)(@@) % هم في علاهم خير من ضمه الفضا % ' فروع على منها محمد الرضا % % 225(@)(@@) % مزايا علاه ليس تحصر بالعد ' % % 226(@)(@@) % سحاب على الوفاد نائله مطل % % وسحبان يمشي في فصاحته ثمل % % 227(@)(@@) % فإن تقصرن في مدح علياه أو تطل % ' فلا أحنف يحكيه بالحلم لا وبال % % 228(@)(@@) % فصاحة قس بل ولا معن في الرفد ' % % 229(@)(@@) % % وأس العلى مذ كان ترب لأسه % % PageV01P429 230(@)(@@) % وإن يومه أثنى عليه كأمسه(@)(@@) % فهمته في الجود طبق لنفسه % % 231(@)(@@) % ومذوده والحزم سيان في الحد % % 232(@)(@@) % فلا وفد غيث جدواه عمه % وشابه في الجدوى أباه وعمه % % 233(@)(@@) % ومذ بشرت فيه القوابل أمه % ' سعى طالبا أوج المعالي فأمه % % 235(@)(@@) % % تلوح إذا بالمصطفى فيهما اتصل % % 236(@)(@@) % فحلوا جميعا رتبة دونها زحل % ' وكلهم جاءوا على نسق من ال % % 237(@)(@@) % على واحد ما عن تساويه من بد % % 238(@)(@@) % أولي الحمد في عالي الثناء شفعتم % وإن عنه في معروفكم قد غنيتم % PageV01P430 239(@)(@@) % تهشون شوقا إن دعا من دعوتم % ' بني المجد من أبكار فكري خطبتم % 240(@)(@@) % فتاة عن الخطاب تجنح للصد % % 241(@)(@@) % بدايع أفكار لها الصيد أذعنت % % وفي حجب الأفكار عنهم تحصنت % % 242(@)(@@) % لها مارنوا يوما ولا لهم رنت(@)(@@) % ولكن رأتكم كفوها فتزينت % % 243(@)(@@) % لكم وأتت تختال في حلل الحمد ' % % 244(@)(@@) % فلو شامها الأعشى تحير وامتحن % % وإن زهيرا لو يراها بها افتتن % % 245(@)(@@) % وأبى لحسان كمنظومها الحسن 
ms129	(@)(@@) % لها من بديع القول نظم بكم إذ الن % % 246(@)(@@) % وابغ في مضمار أعجازه تكدي % % PageV01P431 247(@)(@@) % على فترة في الشعر إن قيل ينبذ % وإن قد بدا لا طرف إلا وقد قذي % % 248(@)(@@) % ظهرت بنظم فيه ما قته غذي(@)(@@) % ولي أذعنت آياته وأنا الذي % % 249(@)(@@) % بقيت له من بعد أربابه وحدي ' % % 250(@)(@@) % فنظم من ألفاظه الدر مقولي % % وفي النظم يبديه كعقد مفصل % 251(@)(@@) % بديع معان إن أفه فيه ينقل(@)(@@) % إذا ما تلوه في العراق بمحفل % % 252(@)(@@) % سرت فيه أفواه الرواة إلى نجد ' % % 253(@)(@@) % فكم قد تبدت فيه للناس درة % وكم قد تجلت منه للشمس ضرة % 254(@)(@@) % ومبصره قد قال : هل هو زهرة(@)(@@) % وسامعه قد شك هل فيه خمرة % 255(@)(@@) % أو أن بنظم الشعر ضرب من الشهد ' % % 256(@)(@@) % حكى الروضة الغناء حسن بهائه % % وفاق على شهب الدجا بسنائه % % PageV01P432 257(@)(@@) % وأخفى ضياء الشمس نور ضيائه(@)(@@) % وقد زاد في تضميخه بثنائه % % 258(@)(@@) % عليكم شذا قد طبق لاأرض بالند ' % % 259(@)(@@) % أرم لدى إنشادها المفصح اللسن % % وطاش حجى الفهامة الحاذق الفطن % % 260(@)(@@) % فما أنا في إنشائه قط مغتبن(@)(@@) % ولست باطرائي له مزده وإن % % 261(@)(@@) % غدا طرفة ابن العبد من حسنه عبدي % % 262(@)(@@) % ولا أنا من يعلي القريض محله % % ولا من يزيد النظم والنثر فضله % % 263(@)(@@) % حويت بقومي المجد والفضل كله(@)(@@) % وما في نظام الشعر حمد لمن له % % 264(@)(@@) % سنام على ينمى إلى شيبة الحمد ' % % 265(@)(@@) % ومفخره سامي السما بعليه % % وعزته موصولة بقصيه % % PageV01P433 266(@)(@@) % وسؤدده إرث له من لويه(@)(@@) % وبني النبي المصطفى ووصيه % % 267(@)(@@) % لنا النسب الوضاح في جبهة المجد % % 268(@)(@@) % وإن نظاما انتجته رويتي % % لنأنف أن يستام عزة نخوتي % % 269(@)(@@) % فما سمحت إلا لكم فيه فكرتي(@)(@@) % فدونكموه فهو في زبري التي % % 270(@)(@@) % طوت ذكر من قبلي فكيف الذي بعدي ' % % 271(@)(@@) % ولا نضبت من كفكم أبحر الندى % % ولا أفلت من أفقكم أنجم الهدى % % 272(@)(@@) % ولا زال ربع المجد فيكم مشيدا % ' ولا برحت علياكم تسخط العدى % % 273(@)(@@) % فتكثر عض الكف من شدة الحقد % % PageV01P434 البحر : مجزوء الرمل 1(@)(@@) % أصبح السعد 
ms130	 قريني % % والمنى طوع يميني % % 2(@)(@@) % حيث مذ صرت لحيني % % كنت والوجد خديني % % 3(@)(@@) % وبه العيش منكد % % 4(@)(@@) % واثقا أحمد ربي % % أن سيجلو كرب قلبي % % 5(@)(@@) % بنجيب وابن نجب % فجلا ( أحمد ) كربي % % 6(@)(@@) % فأنا أحمد أحمد % % PageV01P435 البحر : طويل 1(@)(@@) % إذا ادعت الكتاب يوما تخرصا % % لأقلامها سحر له دان من عصى % % 2(@)(@@) % وقل : يا دعاة السحر خلوا التشخصا % % لأقلام موسى سر ما كان في العصا % % 3(@)(@@) % لموسى بن عمران من الأية الكبرى % % 4(@)(@@) % ترى الفضل فيها أنها في زفاغة % تسيغ من الأقلام أحلى مساغة % 5(@)(@@) % ولكن لدى إلقاء أي صياغة % إذا أبدت الكتاب سحر بلاغة % 6(@)(@@) % فأقلام موسى كالعصا تلقف السحرا % % PageV01P436 البحر : طويل 1(@)(@@) % أجل لم يكن في ساحة الأرض فاعلمن % % لسار حمى إلا ببيتين في الزمن % % 2(@)(@@) % ببيت بناه الله أمنا من المحن(@)(@@) % وبيت على ظهر الفلاة بناه من % % 3(@)(@@) % له همة من ساحة الكون أوسع ' % % 4(@)(@@) % ألا رب قفر قد قطعنا فضاءه % % بيوم وصلنا في الصباح مساءه % % 5(@)(@@) % ولما علينا الليل مد رداءه(@)(@@) % نزلنا به والغيث يسكب ماءه % % 6(@)(@@) % كأن قطره من سيب كفيه يهمع % % 7(@)(@@) % كأن النعامى حين وافت بقطره % % لنا حملت من خلقه طيب نشره % % 8(@)(@@) % فما قطره إلا تتابع وفره % ' وما برقه إلا تبسم ثغره % % 9(@)(@@) % لوفاده من جانب الكرخ يلمع % PageV01P437 % % 10(@)(@@) % فبورك بيتا فيه كان احتجابنا % % عن السوء مذ أمسى إليه انقلابنا % % 11(@)(@@) % به أمنت حصب الرياح ركابنا % ' ومنه وقتنا أن تبل ثيابنا % % 12(@)(@@) % مقاصر من شأو الكواكب أرفع % % 13(@)(@@) % مقاصر بتنا من حماها بجنة % وقينا الأذى من حفظها بمجنة % 14(@)(@@) % غدت مجمع السارين إنس وجنة(@)(@@) % ولم ير في الدنيا مقاصر جنة % 15(@)(@@) % لشمل بني الدنيا سواهن تجمع % % 16(@)(@@) % فوحشتنا زالت بانس رحابها % % عشية بتنا في نعيم جنابها % % PageV01P438 17(@)(@@) % إلى أن نسينا السير تحت قبلها % ' كأنا حلول في منازلنا بها % % 18(@)(@@) % ولم تتضمنا مهامه بلقع ' % % 19(@)(@@) % بنا أدلجت تطوي المهامه عيسنا % % إلى أن بأيدي السير دارت كؤوسنا % % 20(@)(@@) % فمالت نشاوى نحوهن رؤوسنا % ' وبتنا بها حتى تمنت 
ms131	 نفوسنا % % 21(@)(@@) % نقيم بها ما دامت الشمس تطلع % % 22(@)(@@) % ومذ كان فيها بالسرور مبيتنا % % بحيث ثمار البشر والأنس قوتنا % % 23(@)(@@) % رأينا الهنا في ظلها لا يفوتنا % % وعنها وإن عزت علينا بيوتنا % % 24(@)(@@) % وددنا إلى أكنافها ليس نرجع % % 25(@)(@@) % فلا عجب إن تغد صبحا وعتمة % بها الوفد من كل الجهات ملمة % PageV01P439 26(@)(@@) % وتمسي لهم بالخوف أمنا وعصمة % ففيها أبو المهدي أسبغ نعمة % 27(@)(@@) % على الناس فيها طوق الناس أجمع % % 28(@)(@@) % أعز الورى أضحى لديها أذلها % % وأفضلهم ما زال يشكر فضلها % % 29(@)(@@) % وكيف يبارى العالمون أقلها % % وأغناهم قد كان مفتقرا لها % % 30(@)(@@) % كمن مسه فقر من الدهر مدقع % % 31(@)(@@) % بها عم أهل الأرض دان وشاسعا % % وفيها لكل الخير أصبح جامعا % % 32(@)(@@) % وليس لهذي وحدها كان صانعا % % له الله كم أسدى سواها صنايعا % % 33(@)(@@) % بأمثالها سمع الورى ليس يقرع % % 34(@)(@@) % فللخلق أبواب السماحة فتحت % % بها وسيول الأرض منها تبطحت % % 35(@)(@@) % ومنها أزاهير الرياض تفتحت % ' وقد عجزت عنها الملوك فأصبحت % % PageV01P440 36(@)(@@) % لعزته بين الخلائق تخضع ' % % 37(@)(@@) % لقد غمر الدنيا معا بسخائه % % فكانت لسانا ناطقا بثنائه % % 38(@)(@@) % وأدب صرف الدهر بعد اعتدائه(@)(@@) % فلا برحت في الكون شمس علائه % % 39(@)(@@) % بأفق سماء المجد بالفخر تسطع % % PageV01P441 البحر : متقارب تام 1(@)(@@) % تعاليت من فاتح خاتم % عليم بما كان من عالم % 2(@)(@@) % فيا صفوة الله من هاشم % ' تخيرك الله من آدم % 3(@)(@@) % وآدم لولاك لم يخلق % % 4(@)(@@) % بك الكون آنس منه مجيئا % % وفيك غدا لا به مستضيئا % % 5(@)(@@) % لأنك مد جاء طلقا وضيئا % ' بجبهته كنت نورا مضيئا % % 6(@)(@@) % كما ضاء تاج على مفرق % % 7(@)(@@) % فمن أجل نورك قد قربا % % إله السما آدما واجتبى % % 8(@)(@@) % نعم والسجود له أوجبا(@)(@@) % لذلك إبليس لما أبى % % PageV01P442 9(@)(@@) % سجودا له بعد طرد شقي ' % % 10(@)(@@) % وساعة أغراه في إفكه % % بأكل الذي خص في تركه % % 11(@)(@@) % عصى فنجى بك من هلكه(@)(@@) % ومع نوح إذ كنت في فلكه % % 12(@)(@@) % نجى وبمن فيه لم يغرق ' % % 13(@)(@@) % وسارة في ظلك المستطيل % % غداة غدا حملها مستحيل % % 14(@)(@@) % باسحاق بشرهاجبرئيل(@)(@@) % وخلل 
ms132	 نورك صلب الخليل % % 15(@)(@@) % فبات وبالنار لم يحرق % % 16(@)(@@) % حملت بصلب أمين أمين % % إلى أن بعثت رسولا مبين % % 17(@)(@@) % وهل كيف تحمل في المشركين(@)(@@) % ومنك التقلب في الساجدين % % PageV01P443 18(@)(@@) % به الذكر أفصح بالمنطق % % 19(@)(@@) % براك المهيمن إذ لا سماء % % ولا أرض مدحوة لا فضاء % % 20(@)(@@) % ومذ خلق الخلق والأنبياء(@)(@@) % سواك من الرسل في ايلياء % % 21(@)(@@) % مع الروح والجسم لم يلتق ' % % 22(@)(@@) % وكل رأى الله لم يحذه % % علاك وعلمك لم يغذه % % 23(@)(@@) % فنزه عهدك عن نبذه(@)(@@) % فجئت من الله في أخذه % % 24(@)(@@) % لك العهد منهم على موثق % % 25(@)(@@) % صدعت به والورى في عماء % % فخفت بمجدك جند السماء % % PageV01P444 26(@)(@@) % ورف عليك لواء الثناء(@)(@@) % وفي الحشر للحمد ذاك اللواء % % 27(@)(@@) % على غير رأسك لم يخفق ' % % 28(@)(@@) % وحين عرجت لأسنا مقام % % وأدناك منه إله الأنام % % 29(@)(@@) % أصبت بمرقاك أعلى المرام(@)(@@) % وعن غرض القرب منك السهام % % 30(@)(@@) % لدى قاب قوسين لم تمرق ' % % 31(@)(@@) % وقدما بنورك لما أضاء % % رأت ظلمة العدم الإنجلاء % % 32(@)(@@) % فمن فضل ضوئك كان الضياء % ' لقد رمقت بك عين العماء % % 33(@)(@@) % وفي غير نورك لم ترمق ' % % 34(@)(@@) % أضاء سناك لها مبرقا % % وقابل مرآتها مشرقا % % 35(@)(@@) % إلى أن أشاع لها رونقا(@)(@@) % فكنت لمرآتها زيبقا % % PageV01P445 36(@)(@@) % وصفو المرايا من الزيبق ' % % 37(@)(@@) % بك الأرض مدت ليوم الورود % % وأضحت عليها الرواسي ركود % % 38(@)(@@) % وسقف السما شيد لا في عمود % ' فلولاك لا نطم هذا الوجود % % 39(@)(@@) % من العدم المحصن في مطبق ' % % 40(@)(@@) % ولولاك ما كان خلق يعود % % لذات النعيم وذات الوقود % % 41(@)(@@) % ولا بهما ذاق طعم الخلود % ' ولا شم رائحة للوجود % % 42(@)(@@) % وجود بعرنين مستنشق % % 43(@)(@@) % ولو لم تجدك لمولوده % % أبا أم أركان موجوده % % 44(@)(@@) % إذا عقمت دون توليده(@)(@@) % ولولاك طفل مواليده % % PageV01P446 45(@)(@@) % بحجر العناصر لم يبغق % % 46(@)(@@) % ولولاك ثوب الدجى ما انسدل % % ونور سراج الضحى ما اشتعل % % 47(@)(@@) % ولولاك غيث السما ما نزل(@)(@@) % ولولاك رتق السموات وال % % 48(@)(@@) % أراضي لك الله لم يفتق ' % % 49(@)(@@) % ففيك السماء علينا بنى % % وذي الأرض مد فراشا لنا % % 50(@)(@@) % فلولاك ما انحفظت 
ms133	 تحتنا % ' ولولاك مارفعت فوقنا % % 51(@)(@@) % يد الله فسطاط إستبرق % % 52(@)(@@) % ولا كان بينهما من ولوج % % لغيث تحمل ماء يموج % % PageV01P447 53(@)(@@) % ولا انتظم الأرض ذات الفروج(@)(@@) % ولا نثرت كف ذات البروج % % 54(@)(@@) % دنانير في لوحها الأزرق ' % % 55(@)(@@) % ولا سير الشهب ذات الضياء % % بنهر المجرة رب العلاء % % 56(@)(@@) % ولا ينش نوتي زنج المساء(@)(@@) % ولا طاف من فوق موج السماء % % 57(@)(@@) % هلال تقوس كالزورق ' % % 58(@)(@@) % ولولاك وشي الرياض اضمحل % % ولا طرز الطل منه حلل % % 59(@)(@@) % وفيهن جسم الثرى ما اشتمل % ' ولولاك ما كللت وجنة ال % % 60(@)(@@) % بسيطة أيدي الحيا المغدق ' % % 61(@)(@@) % ولولاك ما فلت الغاديات % % بأنمل قطر نواصي الفلاة % % 62(@)(@@) % ولا الرعد ناغى جنين العضات % ' ولا كست السحب طفل النبات % % PageV01P448 63(@)(@@) % من اللؤلؤ الرطب في بخنق ' % % 64(@)(@@) % ولا صدغ آس بدى في ربى % % على ورد خد غدا مذهبا % % 65(@)(@@) % ولا ربحت قد غصن صبا(@)(@@) % ولا اختال نبت ربى في قبا % % 66(@)(@@) % ولا راح يرفل في قرطق ' % % 67(@)(@@) % أفضت نطاق ندى دافقات % % بها اخضر غرس رجا الكائنات % % 68(@)(@@) % فلولاك ما سال وادي الهبات(@)(@@) % ولولاك غصن نقى المكرمات % % 69(@)(@@) % وحق أياديك لم يورق % % 70(@)(@@) % لك الأرض أنشأ علامها % % وقد نصبت لك أعلامها % % 71(@)(@@) % فلولاك لم ينخفض هامها(@)(@@) % وسبع السموات أجرامها % % PageV01P449 72(@)(@@) % لغير عروجك لم تخرق % % 73(@)(@@) % ولولاك يونس ما خلصا % % من الحوت حين دعا مخلصا % % 74(@)(@@) % وعيسى لما أبرء الأبرصا % ' ولولاك مثعنجر بالعصا % % 75(@)(@@) % لموسى بن عمران لم يفلق % % 76(@)(@@) % ولا يوم حرب على الشرك فاظ % % بسيف هدى مستطير الشواظ % % 77(@)(@@) % ولا أنفس الكفر أضحت تفاظ(@)(@@) % ولولاك سوق عكاظ الحفاظ % % 78(@)(@@) % على حوزة الدين لم ينفق % % PageV01P450 79(@)(@@) % بحبل الهدى كم رقاب ربقت % % وكم لبني الشرك هاما فلقت % % 80(@)(@@) % وكم في العروج حجابا خرقت % ' وأسرى بك الله حتى طرقت % % 81(@)(@@) % طرائق بالوهم لم تطرق % % 82(@)(@@) % لقد كنت حيث تحير العقول % % بشأو على ما إليه وصول % % 83(@)(@@) % فأنزلك الله هاد رسول % ' ورقاك مولاك بعد النزول % % 84(@)(@@) % على رفرف حف بالنمرق % % 85(@)(@@) % لك الله أنشا من الأمهات % % كرائم 
ms134	 ما مثلها محصنات % % 86(@)(@@) % ومذ زوجت بالكرام الهداة(@)(@@) % بمثلك أرحامها الطاهرات % % PageV01P451 87(@)(@@) % من النطف الغر لم تعلق % % 88(@)(@@) % لحقت وإن كنت لم تعنق % % بشأو به الرسل لم تعلق % % 89(@)(@@) % وأحرزت قدما مدى الأسبق(@)(@@) % فيا لاحقا قط لم يسبق % % 90(@)(@@) % ويا سابقا قط لم يلحق ' % % 91(@)(@@) % خلقت لدين الهدى باسطا % % لنا ، وبأحكامه قاسطا % % 92(@)(@@) % وحيث صعدت على شاحطا % ' تصوبت من صاعد هابطا % % 93(@)(@@) % إلى صلب كل تقي نقي % % 94(@)(@@) % هبطت بأمر العلي الودود % % إلى عالم عالم بالسعود % % PageV01P452 95(@)(@@) % ونورك سام لأعلى الوجود % ' فكان هبوطك عين الصعود % % 96(@)(@@) % فلا زلت منحدرا ترتقي ' % % PageV01P453 البحر : كامل تام 1(@)(@@) % عجبا سمرت بذكر غير مسامر % وسهرت فيمن ليس في بساهر % % 2(@)(@@) % ولأجل أن يجتاز بين محاجري % ' ناديت من سلب الكرى عن ناظري % % 3(@)(@@) % وتجلدي بقيطعة وفراق ' % % 4(@)(@@) % ودعوت : دونك يا صبا بحياته % % عتبا نسيمك كان خير رواته % % 5(@)(@@) % فاستخجلي لي في شذا نفحاته % ' من أخجل الغزلان في لفتاته ؟ % 6(@)(@@) % والشمس من خديه بالإشراق ' % % 7(@)(@@) % هبني أقول وما أسأت مقالة : % يا تاركا مني الدموع مذالة % 8(@)(@@) % أرأيت قبلك إذ هجرت ضلالة % من مال عني واستقل ملالة % 9(@)(@@) % والدمع فيه انهل من آماقي % % 10(@)(@@) % فلو ان لي إذ كان هجرك جائحي % % قلبا سواك نبوت نبوة جامح % % PageV01P454 11(@)(@@) % كن كيف شئت فما هواك مبارحي % % أمناي أنت القلب بين جوانحي % % 12(@)(@@) % أمناي أنت النور في أحداقي % % 13(@)(@@) % يا من أقام على الجفاء وما ارعوى % % لا ترقدن ، مكان حبك بالجوى % % 14(@)(@@) % فعلى سواك فؤاد صبك ما انطوى % % أمناي جن إليك من فرط الهوى % % 15(@)(@@) % توقا ، فؤاد متيم مشتاق % % 16(@)(@@) % أبدا لغيرك ما شغفت بفاتن % وعلى الوفاء أقمت منك بضاعن % % 17(@)(@@) % ألهيتني عن أن أهيم بشادن % % وغدا الهوى إلفي وليس ، فداوني % % 18(@)(@@) % غير الوصال لدائه من راق % % 19(@)(@@) % رفقا بصب في هواك معذب % لك في غوير حشاه أحسن ملعب % 20(@)(@@) % يدعوك دعوة خائف مترقب % هلا ترق لخائف متجلبب % PageV01P455 21(@)(@@) % برد العفاف ، رمية الأشواق % % 22(@)(@@) % بالوصل خلتك قد برقت إثابة % فمطرتني جهرا وكنت 
ms135	 سحابة % 23(@)(@@) % أو ما كفاك بأن أشف كآبة % فحشاشتي ذابت عليك صبابة % 24(@)(@@) % والعين ترعف بالدم المهراق % % 25(@)(@@) % أنا في هواك قطنت أو لم تقطن % كلف حسنت لديك أو لم أحسن % % 26(@)(@@) % يا ثالث القمرين صل وتبين % % إن كنت فردا في الجمال فإنني % % 27(@)(@@) % تالله فيك لواحد العشاق % % 28(@)(@@) % وانظر لنفسك إن أردت تحولا % أيليق غير حشاشتي لك منزلا % % 29(@)(@@) % أنت المنير السعد شمس ضحى الملا % % وأنا الأثيل المجد بدر سما العلا % % 30(@)(@@) % فرع المكارم طيب الأعراق % % PageV01P456 31(@)(@@) % من دوحة بالمجد طاب نماؤها % % لبني الزمان مظلة أفياؤها % % 32(@)(@@) % أنا من عليه تجمعت أهواؤها % % وإذا الملا اضطربت بها آراؤها % % 33(@)(@@) % لعظيمة كشفت لهم عن ساق % % 34(@)(@@) % أوضحت مشكلها بأول نظرة % وفتحت مقفلها بأول خطرة % 35(@)(@@) % مازلت مذ ظل الأنام بحيرة % أهديهم نهج الصواب بفكرة % 36(@)(@@) % كالشمس مشرقة على الآفاق % % 37(@)(@@) % شهدت لي الدنيا غداة أتيتها % % أني نهضت لأهلها فكفيتها % % 38(@)(@@) % فإذا بها التوت الخطوب لويتها % % وإذا السنون تتابعت أوليتها % % 39(@)(@@) % من راحتي بوابل مغداق % % 40(@)(@@) % وإذا القنا انتظمت نثرت عقودها % % بيد تحل طلا العدى وبنودها % % PageV01P457 41(@)(@@) % وإذا الظبا ازدحمت ثنيت حدودها % % وإذا الوغى استعرت أذقت أسودها % % 42(@)(@@) % طعم الحمام على متون عتاق % % 43(@)(@@) % ألقى الوفود بطلعة ميمونة % ويد بربح ثنائها مفتونة % 44(@)(@@) % تثني العدى في صفقة مغبونة % بأسنة خطية مسنونة % 45(@)(@@) % وصوارم صم الشفار رقاق % % 46(@)(@@) % حاربت بالهجران من لك سالما % % حتى كأنا كاشحان تظالما % % 47(@)(@@) % بك لست لا وأبيك أعذر عالما(@)(@@) % فلئن وصلت أخا الهوى فلطالما % % 48(@)(@@) % كنت الحري بأحسن الأخلاق ' % % 49(@)(@@) % أفبعد صدق مودة لم تمنن % تجفو وتكذب ظن من لم يظنن % % 50(@)(@@) % فلئن لحظت فأنت عين المحسن(@)(@@) % ولئن أقمت على الجفاء فإنني % % PageV01P458 51(@)(@@) % أشكوك مبتهلا إلى الخلاق % % 52(@)(@@) % متحرك شوقي بمن هو ساكن % أدعوه وهو مع التجنب بائن % % 53(@)(@@) % أين المودة فالوفاء معادن ؟ % فأجابني خجلا ودادك كامن % % 54(@)(@@) % بحشاي خيفة عامد لنفاق % % 55(@)(@@) % شوقي لوصلك يا بن أكرم ماجد % صلتي إليك وأنت أكرم عائد % 56(@)(@@) % فتصفح الدعوى بفكرة 
ms136	 ناقد % % 58(@)(@@) % فأمالني لهوى به استأنفته % % عودا على بدء عليه ألفته % % 59(@)(@@) % والصدق فيما يدعيه عرفته(@)(@@) % فلثمته في فيه ثم رشفته % % 60(@)(@@) % وجذبته وضممته لعناق % % 61(@)(@@) % ودعوت وصلك في نهاية بغيتي % % فلقد حفظت علي فيه بقيتي % % PageV01P459 62(@)(@@) % بشراي فزت بمن يشاق لرؤيتي(@)(@@) % وطفقت أنشد : نلت غاية منيتي % % 63(@)(@@) % يا حبذا لو أن وصلك باقي % % PageV01P460 البحر : سريع 1(@)(@@) % قل للعلى حزنا : أطيلي العويل % % وطارحي بالنوح ذات الهديل % % 2(@)(@@) % فاليوم من آلك آل الجميل(@)(@@) % حل بهذا القبر طود جليل % % 3(@)(@@) % وبحر جود وحسام صقيل % % 4(@)(@@) % أدرج والمعروف في برده % % وحل والإحسان في لحده % % 5(@)(@@) % فابك الذي للجلد من بعده % ' لا يجمل الصبر على فقده % % 6(@)(@@) % من أين للفاقد صبر جميل ' % % 7(@)(@@) % قد عوذت فيه العلى نسلها % % حتى عليهم آمنت ثكلها % % 8(@)(@@) % فغير بدع إن بكت بعلها % % كان وكيلا وكفيلا لها % % 9(@)(@@) % فحسبنا الله ونعم الوكيل % % PageV01P461 البحر : بسيط تام 1(@)(@@) % إذا كتبت فخطي زهر آكام % ولؤلؤ زنت فيه جيد أيامي % % 2(@)(@@) % كأن في كفي البيضا بأنعام % % بين الأنامل فوق الطرس أقلامي % % 3(@)(@@) % غيد بحزوى تهادى بين آرام % % 4(@)(@@) % وفي البياض مدادي لا يقاس به % % سوى احورار العذارى في تناسبه % % 5(@)(@@) % وخالها حسن نقطي في ضرائبه(@)(@@) % والسطر في كلمي في رق كاتبه % % 6(@)(@@) % سلك بدا دره في كف نظام % % 7(@)(@@) % رب الفصاحة والأقلام من رسلي % % وصحفها غر آي الشعر من قبلي % % 8(@)(@@) % وما تنزهت عن قولي ولم أقل(@)(@@) % أنا كليم المعاني واليراعة لي % % PageV01P462 9(@)(@@) % هي العصا والمعاني الغر أغنامي ' % % 10(@)(@@) % إني عن الروح أعلا الخلق منزلة % عن كل آي أتت في الذكر منزلة % 11(@)(@@) % عن الإله الذي عم الورى صلة % ' أروي أحاديث آبائي مسلسلة % 12(@)(@@) % كما روت نشواتي بنت بسطام % % 13(@)(@@) % أنا الذي زلزل الدنيا وآهلها % % ولف في آخر الغبراء أولها % % 14(@)(@@) % والبيض تشهد لو جردت أنصلها(@)(@@) % في الكر والفر هامات الكماة لها % % 15(@)(@@) % وقع الدخيل على أقدام أقدامي ' % % PageV01P463 البحر : بسيط تام 1(@)(@@) % طفنا بنادي على بالبشر ملتمع % % كم ضم للأنس من كهل ومن 
ms137	 يفع % % 2(@)(@@) % ورب شاد هناك اهتاج ذا ولع % % ورب مجلس أنس فوق مرتفع % % 3(@)(@@) % قد طال إيوان كسرى الملك إيوانا % % 4(@)(@@) % بناء عز ولكن سقفه كرم % حتى عليه الثريا لم تطأ قدم % 5(@)(@@) % ذو منظر عنه ثغر الدهر مبتسم % ' تود لو أنها تحكي له إرم % 6(@)(@@) % وعرش بلقيس أن يحكيه أركانا % % 7(@)(@@) % رباعه لم تزل يا مي آهلة % بمن كم افترضوا للوفد نافلة % 8(@)(@@) % فمن شذا فخرهم إن رحت سائلة % ' تجري الصبا الغض في مغناه حاملة % PageV01P464 9(@)(@@) % له بأردانها شيحا وريحانا % % 10(@)(@@) % ومع نديم كأن حيا بمجمرة % مفاكه بأناشيد معطرة % 11(@)(@@) % ذي طلعة مثل وجه البدر مسفرة(@)(@@) % في ليلة مثل صدر الصبح مقمرة % 12(@)(@@) % بتنا ، بحيث تبدى الفجر ، ندمانا ' % % 13(@)(@@) % بتنا ومجتمع اللذات مجمعنا % % ونشوة الأنس لا الصهباء تصرعنا % % 14(@)(@@) % نحيي الدجى ونميت الهم أجمعنا % ' جذلا سكارى وإبراهيم يسمعنا % % 15(@)(@@) % نشائد الشعر ألحانا فألحانا % % 16(@)(@@) % عنوان أخبار أهل الفضل إن رويت % % قرآن آيات علياها إذا تليت % % 17(@)(@@) % لسانها للمقال الفصل إن دعيت % % إنسان عين بني الدنيا لقد عشيت % % PageV01P465 18(@)(@@) % عين رأت غيره في الناس إنسانا % % 19(@)(@@) % لم تحك أخلاقه الصهباء مرتشفا % % ولم تماثله أرباب النهى ظرفا % % 20(@)(@@) % ممن ترى الكل منهم سابقا أنفا % % قد فات أقرانه ثم ارتقى شرفا % % 21(@)(@@) % فما ارتضى النسر والجوزاء أقرانا % % 22(@)(@@) % يفوق حي ملوك الأرض ميتهم % وفوق أنماطها يجري كميتهم % 23(@)(@@) % دعني ومدحهم إني رأيتهم % من سادة شرعة الإسلام بيتهم % % 24(@)(@@) % سادوا جميع الورى شيبا وشبانا % % 25(@)(@@) % بيت تفاخر هام الصيد أرجلنا % % على ثراه ، فتهوي فيه تحملنا % % 26(@)(@@) % يا ليلة طاب فيها منه منزلنا % % بتنا ومذهبة الأحزان تشملنا % % 27(@)(@@) % بحر تناول منه نوح طوفانا % % PageV01P466 28(@)(@@) % لزورق الفكر سبح في جداوله % وطائر البشر صدح في خمائله % 29(@)(@@) % قد شف عن دره صافى مناهله % وخضرة الروض حفت في سواحله % % 30(@)(@@) % فروضه روضة الفردوس أنسانا % % 31(@)(@@) % روض من الأنس في طل الهنا خظل % % كم فيه حيا الندامى شادن غزل % 32(@)(@@) % وعاطش الخصر ريان الصبا ثمل % وأهيف القد قاني 
ms138	 الخد معتدل % % 33(@)(@@) % إذا بدى وتثنى أخجل البانا % % 34(@)(@@) % ظبي من الإنس بات الحلي باهضه % % ذو مبسم همت لما شمت وامضه % % 35(@)(@@) % لهوت فيه غضيض الطرف خافضه % % قد خفف اللين خديه وعارضه % % 36(@)(@@) % وثقل السكر من عينيه أجفانا % % 37(@)(@@) % غض الشمائل من زهو الصبا طرب % كم جد في مهجتي من لحظه لعب % % PageV01P467 38(@)(@@) % ضرب من الخمر ما في فيه أم ضرب % % مهفهف غنج في ثغره شنب % 39(@)(@@) % ولؤلؤ رطب ريقا وأسنانا % % 40(@)(@@) % أجيل فكري طورا في حواضنه % % أي الجواهر كانت من معادنه % % 41(@)(@@) % وتارة في هوى قلبي وفاتنه % % أسرح الطرف في معنى محاسنه % 42(@)(@@) % فيرجع الطرف عن معناه حيرانا % % 43(@)(@@) % أنشى لنا الأنس مذ غنى لنا هزجا % % فرد منا خليعا كل رب حجى % % 44(@)(@@) % قد راقنا بهجة بل شاقنا دعجا % % أظنه كان شمسا أو هلال دجى % % 45(@)(@@) % أو ريم رمل براه الله إنسانا % % 46(@)(@@) % مفضض الثغر ذو كف مخضبة % ووجنة من دماء الصب مشربة % 47(@)(@@) % مرخى فروع كنشر المسك طيبة % يشتد بين الندامى في مذهبة % PageV01P468 48(@)(@@) % كالشمس مشرقة في أفق مغنانا % % 49(@)(@@) % لم أدر هل سكبت من ذوب عسجده % أم خده قد كساها من تورده % % 50(@)(@@) % أم استعارت سناها من توقده % % إذاة هوى يلقط الألباب من يده % % 51(@)(@@) % سلافها خلتها نارا وقربانا % % 52(@)(@@) % فمن طلا أشفعت لي في استيافته % % وريقة عذبت لي في ارتشافته % % 53(@)(@@) % حيا بخمرين زادا في ضرافته % % فقمت أشرب حينا من سلافته % % 54(@)(@@) % ومن لمى ثغره المعسول أحيانا % % 55(@)(@@) % منعم الجسم لا شالت نعامته % % ولا انمحت من بياض الخد شامته % 56(@)(@@) % كم عاد بالكاس تجلوها ابتسامته % % حتى إذا أخذت منا مدامته % % 57(@)(@@) % وقد تشابه أقصانا وأدنانا % % PageV01P469 58(@)(@@) % غنى لنا فصحونا منه عن فرح % كأننا ما شربنا الراح في قدح % 59(@)(@@) % وحيث كنا أخذنا منه في ملح % % وناولتنا غبوقا كف مصطبح % % 60(@)(@@) % أماتنا السكر أحيانا وأحيانا % % 61(@)(@@) % نعم ألم ، ونام الحي ، ظبيهم % يعطي الندامى من الصهباء ما احتكموا % % 62(@)(@@) % حتى بهم صاح داعي الفجر ويحكم % يا رقبة الحي 
ms139	 هبوا طال نومكم % % 63(@)(@@) % قوموا وإن لم تقوموا كان ما كانا % % 64(@)(@@) % لقد حلفت ببيت فيه ظللنا % % رواق عز علاه القننا % % 65(@)(@@) % لا خفت دهري لا سرا ولا علنا % % أنختشي والنقي ابن التقي لنا % % 66(@)(@@) % سواعد البطش ، يمنانا ويسرانا % % 67(@)(@@) % مولى تود الدراري أنها حسبت % % منه مناقبه أو فخرها اكتسبت % % PageV01P470 68(@)(@@) % يعزوه طورا إذا أهل الحجى انتسبت % % وذلك المجلس السامي به رسبت % % 69(@)(@@) % أركانه وسمت بالعز كيوانا % % 70(@)(@@) % ناد قرى الضيف من إحدى عوارفه % % والوفد طائفه فيه كعاكفه % % 71(@)(@@) % ينسيهم الأهل أنسا في طرائفه % % إن أخمص القوم نالوا من صحائفه % % 72(@)(@@) % ما تشتهي النفس ألوانا فألوانا % % 73(@)(@@) % ببابه تتلاقى السبل مشرعة % إذ لم يكن غيره للجود مشرعة % 74(@)(@@) % تؤم كوثره الوفاد مسرعة % ومن صدى ينضر الأقداح مترعة % 75(@)(@@) % فيغتدي بالفرات العذب ريانا % % 76(@)(@@) % به النقي علي القدر كوكبها % % تهدى به ، إن أضل الركب غيهها % % 77(@)(@@) % حبر صفى منه للوراد مشربها % % غيث إذا انهمرت كفاه تحسبها % % PageV01P471 78(@)(@@) % إن قطب العام سيلا أم بطنانا % % 79(@)(@@) % لئن تجلى أخو مجد بسؤدده % % وزانه في البرايا طيب محتده % % 80(@)(@@) % فأنه والمعالي بعض شهده % % قد طوق المجد جيدا يوم مولده % % 81(@)(@@) % وقرط العلم والمعروف آذانا % % 82(@)(@@) % عف السريرة ذو نفس مبرأة % معصومة بالتقى من كل سيئة % 83(@)(@@) % عن مدحه أي حسنى غير منبئة % لو أنزل اليوم قرآن على فئة % 84(@)(@@) % بعد النبي لكان اليوم قرءانا % % 85(@)(@@) % كم آمل صدقت فيه عيافته % % جودا وكم ملكت نفسا ظرافته % % 86(@)(@@) % أجل وكم فطرت قلبا مخافته % % من بيت مجد لقد شيدت غرافته % % 87(@)(@@) % فكان للعلم بين الناس عنوانا % % PageV01P472 88(@)(@@) % محض النجار كريم الفرع طيبه % سامي العلى من نطاف العز مشربه % % 89(@)(@@) % من أسرة ودها القرآن موجبه % وسادة كل من تلقاه تحسبه % 90(@)(@@) % آباؤه مضر الحمرا وعدنانا % % 91(@)(@@) % لولاهم حبوة الإسلام ما انعقدت % % ولا شريعته أنهارها اطردت % % 92(@)(@@) % قوم هم سرج الإيمان لاخمدت % % فكم مصابيح علم فيهم اتقدت % % 93(@)(@@) % مثل المصابيح لا تحتاج برهانا % % 94(@)(@@) % بمقطع الرأي كم أوهت مذ اعترضت 
ms140	 % % صفاة حجة أهل الشرك فاندحضت % % 95(@)(@@) % أجل وكم ركن غي محكم نقضت(@)(@@) % وكم يراع لهم أسنانه لفظت % % 96(@)(@@) % فوائدا أحكمت للعلم أركانا % % PageV01P473 97(@)(@@) % منازل الملأ الأعلى منازلهم % % وفي السما شرفا تتلى فضائلهم % % 98(@)(@@) % أكارم تغمر الدنيا نوافلهم % ' فقل لمن قد غدا جهلا يطاولهم % % 99(@)(@@) % قصر ولا تدعي زورا وبهتانا ' % % 100(@)(@@) % يا منسم الفخر قف واترك مصاعبهم % % أتعبت نفسك لن تسمو غواربهم % % 101(@)(@@) % هيهات فاتك أن تحوي مناقبهم % ' ما أنت والقوم ترجو أن تغالبهم % % 102(@)(@@) % نعم إذا غالب العصفور عقبانا ' % % 103(@)(@@) % فمت بدائك عن غيط توهجه % يوري الحشا ومساعيهم تؤججه % % 104(@)(@@) % فتهجم للمعالي لست تنهجه(@)(@@) % ولا تريع لهم سربا وتزعجه % % 105(@)(@@) % نعم إذا أزعج اليعفور سرحانا ' % % 106(@)(@@) % بنى العلى طاب في العلياء مغرسكم % % وللهدى والندى مازال مجلسكم % % PageV01P474 107(@)(@@) % عواصب بجلال الله أرؤسكم(@)(@@) % فلا تزال يد الأفراح تلبسكم % % 108(@)(@@) % طول المدى من ثياب البشر قمصانا % % 109(@)(@@) % ولا تزال عداكم تشتكي عللا % بين البرية تغتدي مثلا % 110(@)(@@) % عواريا من لباسي عزة وعلا(@)(@@) % ونحن نلبس من أيديكم حللا % 111(@)(@@) % نجر فيها على الجوزاء أردانا % % 112(@)(@@) % ملابسا كلما مسنا بهن ضحى % رأت حواسدنا من غيظها برحا % 113(@)(@@) % كأننا في الورى من نهينا فرحا(@)(@@) % نختال فيها على أنف العدى مرحا % 114(@)(@@) % وخير أمر أغاض اليوم أعدانا ' % % PageV01P475 البحر : خفيف تام 1(@)(@@) % أنجوم بنورها يستضاء % نثرتها بأفقها العلياء % 2(@)(@@) % أم مزايا تود لو أن منها % % فصلت نظم عقدها الجوزاء % % 3(@)(@@) % مكرمات بنشرها الفضل يحيى % % لكريم لولاه مات الرجاء % % 4(@)(@@) % لا تقس واصلا بمن كل يوم % واصل للوفود منه عطاء % % 5(@)(@@) % كرم تستهل في كل قطر % من غواديه ديمة وطفاء % % 6(@)(@@) % يا مطيب القرى إذا ما اقشعرت % % ببني الدهر شتوة غبراء % % 7(@)(@@) % أين من يرتقي لعلياك منهم ؟ % وهم في الهبوط عنك سواء % % 8(@)(@@) % وسماء تظلهم وهي أرض % لك ، لكنها عليهم سماء % 9(@)(@@) % إن هذي الدنيا يشع عليها % % رونق منك رائق وبهاء % % 10(@)(@@) % قد زهت بالزورا لأنك فيها % % فهي عين لها وأنت ضياء % % PageV01P476 11(@)(@@) % لك ، يا ما أرق طبعك ، حلم 