ms283	 ي(@)(@)(@@) حدث بها من(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) حب، و(@)(@)(@@)(@@)(@@) || AUTO لا(@)(@)(@@) بأس بتعب(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ر الرؤ(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ا للعارف، ول(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ست الرؤ(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ا لأول عابر، و(@)(@)(@@)(@@)(@@) || AUTO لا(@)(@)(@@)(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) جوز الكذب ف(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) الحلم و(@)(@)(@@)(@@)(@@) || AUTO لا(@)(@)(@@) فرق ب(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ن رؤ(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ا الل(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ل والنهار، و(@)(@)(@@)(@@)(@@) || AUTO لا(@)(@)(@@) ب(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ن رؤ(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ا الرجال والنساء، والرؤ(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ا الصالحة جزء من ستة وأربع(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ن جزءا من النبوة وتواطؤ الرؤ(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ا بأن(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) راها جماعة دل(@)(@)(@@)(@@)(@@) || AUTO ي(@)(@)(@@) ل على صحتها.(@)(@)PageV02P565(@)(@)(@@) كتاب الآداب الشرعية(@)(@)PageV02P567(@)(@)(@@)(@@)(@@) | AUTO كتاب الآداب الشرعية(@)(@)(@@) وهو مشتمل على فصول:(@)(@)(@@)(@@)(@@) || AUTO الأول في أدب النفس(@)(@)(@@) يسن لكل مسلم مكلف: خوف سابقة وخاتمة ومكر وخديعة وفضيحة والصبر على الطاعة، والنعم والبلاء، والنقم في بدنه وعرضه وأهله وماله، وعن كل مأثم واستدراك ما فات من الهفوات وقصد القرب والطاعة بنيته وقوله وفعله والزهد في الدنيا والرغبة في الآخرة، وفي وجوب الرضا بقضاء، الله خلاف، ولا يجوز الرضا بكفر ومعصية، ويحرم بهت، وغيبة ونميمة، ومكر وخديعة، PageV02P569 (@@) وسخرية، واستهزاء، وكذب، لغير صلاح وحرب وزوجة، ويحرم مدح وذم بباطل، ويجب كف يده وفمه، وفرجه وبقية أعضائه عما يحرم، ويسن عما يكره. وتلزم التوبة شرعا لا عقلا، كل مسلم مكلف قد أثم من ذنب. والتوبة الندم وتصح من بعض الذنوب ولا تصح في حق الآدميين: إلا بآدائه إلى ربه، أو وارثه ومن لم يندم على ما حد فيه لم يكن حده توبة، وتقبل التوبة ما PageV02P570 (@@) لم يعاين الملك، وقبول التوبة تفضل من الله عز وجل، وتحبط المعاصي بالتوبة، والكفر بالإسلام. والطاعة بالردة المتصلة بالموت، ولا تحبط طاعة بمعصية غير الردة. والأمر بالمعروف، والنهي عن المنكر فرض عين على من علمه حراما وشاهده وعرف ما ينكر ولم يخف أذى ولا فتنة في نفس أو مال، ويجوز على الأدنى إذا قدر عليه وترك الأعلى الذي 
ms284	 لا يقدر عليه ويسوغ للمذنب الإنكار حتى على مثل ذنبه والإنكار على مختلف فيه إلا على متمذهب بما يخالفه ولا إنكار على كافر في ما لا يحرم عليهم ويكون فاعله متواضعا رفيقا شفيقا غير فظ عالما بالمأمورات والمنهيات، دينا نزها عفيفا قاصدا بذلك وجه PageV02P571 (@@) الله وإقامة دينه ونصر شرعه ويباح كسر آلة لهو وصور ودف صنوج وشق وعاء خمر وهل يحرق بيت خمر فيه خلاف، ويجب إنكار البدع المضلة وإقامة الحجة على إبطالها، ويسن هجر من جهر بالمعاصي ويحرم جهر مسلم عدل ويزول بالسلام ويجوز لعن الكفار عاما وفي لعن معين خلاف PageV02P572 (@@) ومما للمسلم على المسلم أن يستر عورته، ويرحم غربته، ويقيل عثرته، ويقبل معذرته، ويرد غيبته، ويديم نصيحته، ويحفظ خلته، ويرعى ذمته، ويجيب دعوته، ويقبل هديته ويكافئ صلته، ويشكر نعمته، ويحسن نصرته، ويشفع مسألته، ويشمت عطيته، ويرد ضالته، ويواليه، ولا يعاديه، وينصره على ظالمه، ويكفه عن الظلم، ويحب له ما يحب لنفسه، ويكره له ما يكره لنفسه، وليس على مسلم نصح ذمي، ويحرم المن، وتسن المشورة حتى لمن هو دونه، ويجتهد في النصح وتحرم إشارته بغش.(@)(@@) والصلاة على النبي صلى الله عليه وسلم خارج الصلاةسنة، وتجب في العمر مرة وقيل كلما ذكر، والسلام على من مر عليه سنة عين من منفرد وعلى الكفاية من جماعة. ويكره في الحمام، وعلى من يأكل أو يقاتل، والمصلي، ومن يقضي حاجته والمتوضئ، ورد السلام المسنون فرض كفاية، ولا بأس PageV02P573 (@@) بالكتابة إلى بعيد بالسلامة، ويكره كتابة تقبيل الأرض، ولا يسلم على ذمي فإن سلم أحدهم قيل له وعليكم. ويسلم على أخلاط ويقصد المسلم، وفي تهنئة الكفار وتقريبهم خلاف وإن سلم على ذمي وهو لا يعلم حاله: رد عليه ويسلم الصغير على الكبير والماشي على الجالس والراكب عليهما. وإذا التقيا فسلم كل فعلى كل الرد، ويسن الاستئذان ثلاثا فإن أذن له وإلا رجع. ويكره الجلوس وسط الحلقة، ويكره القيام لغير سلطان، ووالد وعالم. ويكره لأهل PageV02P574 (@@) المعاصي والفجور، ويسن لكل تعلم الأدب والسمت والفضل، والحياء، ولا 
ms285	 بأس بالتوديع عند التفرق، ويكره للرجل أن يسافر أو يبيت وحده. ولا يجوز للمرأة أن تسافر يوما وليلة بغير محرم، ولا بأس بأخذ الشيء من لحية الرجل وثوبه، ويقوله له أخذت يداك خيرا. وتكره السياحة في غير مقصد صحيح، وتجب طاعة والد، وزوج وولي أمر وسيد في غير معصيته، وصلة رحم، ويجب على كل تعلم ما يحتاج إليه من أمر دينه وعلى الأب أن يؤدب ولده PageV02P575 (@@) ويضربه. ولكبير الإخوة على صغيرهم حق، وتجب كفاية مماليكه بما يحتاجون وتأديبهم بمثل ولده ويحرم التطاول عليهم وتجب معاشرة الجار بالمعروف وأن يكرمه ويعظمه ولا يؤذيه، وتسن العزلة عن خلطاء السوء، وتسن عشرة أهل الخير، وينبغي لطالب العلم أن يخلص نيته، ويحسن سيرته، ويتواضع في نفسه ويطلب الأهم فالأهم، ويقدم الفقه ثم الأصول ويأخذ ما يحتاج إليه من نحو ولغة وعلى الشيخ أن يحرص على الطلبة، ويحسن النية فيهم، ويجب رفعهم ورياستهم ويكره للعالم أن يغسل كتبه، أو يدفنها وإن أوصى بذلك لم يفعل. وكره أحمد وغيره علم الكلام وإذا سئل عما يعلم لزمه الجواب إن كان فيه فائدة بلا مضرة وكان من العلوم الدينية، وفهم السائل يدركه، وليس في البلد غيره، ويكره PageV02P576 (@@) النظر في كتاب غيره بغير إذنه، وحبس الكتب. ويجب شكر المعم، وتسن عيادة المريض. وتكره وسط النهار، ويدعو للمريض، وتسن زيارة الإخوان، والمصافحة في اللقاء غير امرأة وأمرد لشهوة، ولا بأس بالمعانقة والتقبيل لغير أمرد. ويكره أن يتناجى اثنان دون ثالث، وتجوز مع الزيادة وأن يدخل في ستر قوم.(@)(@)PageV02P577(@)(@)(@@)(@@)(@@) || AUTO الثاني: أدب القراءة والمصحف(@)(@)(@@) في كراهة نقط المصحف وشكله وكتابة الأخماس والأعشار، وأسماء السور خلاف. وتحرم كتابته بنجس، وتوسده، ووضعه تحت الرأس من غير حاجة. ومن استخف به أو ببعضه كفر. ويحرم السفر به إلى أرض العدو، وتملكه لكافر، ويجبر على إزالة يده عنه إن ملكه ويجوز أخذ الأجرة على نسخه ولا يجوز تفسيره برأي واجتهاد ويجوز بحديث وقول صحابي وبمقتضى اللغة خلاف وتجوز القراءة لماش وراكب ومضطجع، ومحدث حدثا أصغر، 
ms286	 ونجس بدن، وثوب وعلى كل حال، إلا مع حيض وجنابة، ونفاس، ويشرع في أوقات الشدائد والمصائب. ويسن الختم كل أسبوع، وفي كراهة دونه خلاف. وفي PageV02P578 (@@) أول المفصل أقوال الأصح من قاف، ويسن التكبير من أول الضحى، وترتيل القراءة وسؤال الرحمة عند ذكرها والتعوذ من العذاب عند ذكره ويكره قراءة الألحان. ويتعوذ قبل القراءة، ولا يكره تطييب المصحف، ولا جعله على كرسي أو كيس حرير، ويباح تركه على الأرض، وفي تحليته بذهب أو فضة خلاف.(@)(@)PageV02P579(@)(@)(@@)(@@)(@@) || AUTO الثالث: تشميت العاطس(@)(@)(@@) تشميت العاطس وجوابه: فرض كفاية، ويغطي العاطس وجهه، ويخفض صوته، ويحمد، ويجيبه من سمعه يرحمك الله، ويجيب يهديكم الله ويصلح بالكم. ولا يشمت كافرا وإن شمته أجابه أمين يهديكم الله. ولا يشمت امرأة شابة، وإذازاد على الثلاث لم يشمت وقيل له عافاك الله. ويقال للطفل بارك الله فيك، ولا يجاب المتجشيء بشيء فإن حمد قيل له: هنيئا ومن تثاءب كظم ما استطاع.(@)(@@) ويباح خصي الغنم، وفي كراهة إنزاء الحمير على الخيل خلاف، PageV02P580 (@@) ويكره تعليق جرس ونحوه على الدابة. وتكره إزالة الأوساخ باليمين، ويجوز الإرداف على الدابة وركوب ثلاثة، ولا يكره الانتعال، والأكل والشرب قائما، وكذلك البول إذا أمن التلويث. ويكره المشي في نعل واحدة ويكره النوم ضحى، وبعد العصر. وأن ينام أو يجلس بعضه في الشمس وبعضه في الظل ويكره التكني بأبي يحي وأبي عيسى وفي أبي القاسم خلاف. ومن مشى مع PageV02P581 (@@) أفضل منه مشي عن يمينه. والجماعة خلفه ويجلس تحته وتكره التجارة إلى أرض العدو، ويباح استئجار أرض كافر وشراؤها كإجارته وبيعه أرضا في الأصح، ويسن التكسب ومعرفة أحكامه، ويجب الوفاء، وأخف وأفضل التجارة في العطر، وقيل اللبن، وأفضل الاكتساب قيل: بها، وقيل: بالزراعة ومن أبيح له أخذ شيء، أبيح له سؤاله، وما آتاه من غير سؤال، ولا إشراف نفس يوجب أخذه في ثالث: ويباح دخول الحمام للرجل إذا أمن النظر منه، وإليه، ويحرم بلا إزار PageV02P582 (@@) وفي إباحته للمرأة خلاف، وحكم دخوله كالخلاء ويغسل إبطيه وقدميه عند دخوله بماء بارد، ويقصد 
ms287	 موضعا خاليا، ولا يدخل البيت الحار حتى يعرق في الأول، ولا يطيل المقام إلا بقدر حاجته، وهو في الصيف أحمد من الشتاء. ولا يدخله حال الامتلاء، ولا يشرب الباردة فيه، ولا بعده، ويسن تسريح الشعر وغسله ودهنه وتقليم الأظفار مخالفا يوم الجمعة والخميس ولا يترك ذلك فوق الأربعين، ويسن الخضاب بغير السواد، ونتف الشيب ويحرم نمص ووشر ووشم ويباح ثقب أذن الأنثى ويكره لذكر. ومن سمع نهيق حمار PageV02P583 (@@) أو عوي كلاب تعوذ وصياح ديك سأل الله من فضله، ويكره اتخاذ طير في قفص، أو يأكل زع الناس ويباح اقتناء كلب لصيد، وماشية وزرغ ونحوه فقط، ويباح قتل كلب عقور، وأسود بهيم. ووزغ، وفأر، وحية، وعقرب، وكل مؤذ، ويؤذن حيات البيوت قبل قتلها وقمل، وبق وبرغوث، ونحوها بغير نار لا ضفدع، ونمل. ويكره طرح القمل ويكره إطالة وقوف الدابة محملة، أو مركوبة. ويكره النوم بين مستيقظين، ومد الرجلين بحضرة الناس والطيرة والتشاؤم ولا بأس بالفأل وإذا وقع الطاعون ببلد فلا يخرج منه، وإن كان PageV02P584 (@@) ببلد فلا يدخلها. ويحرم لعب الشطرنج ونرد، ولا يجالس من يلعب ذلك ولا يسلم عليه، ويسن الكف عن مساوئ الناس وعيوبهم ولا ينظر في النجوم إلا لمعرفة القبلة، والوقت ويقول إذا رأى الهلال ما ورد، وهل الفقير الصابر أفضل أم الغني الشاكر فيه خلاف.(@)(@)PageV02P585(@)(@)(@@)(@@)(@@) || AUTO الرابع: يباح التداوي(@)(@)(@@) يباح التداوي وتركه أفضل ولا بأس بالحمية، ويكره أن يستعين المسلم بذمي أو كافر غيره في طب أو غيره، ولا بأس بالتداوي بالقرآن تعليقا وشربا ورقية، وتكره بما لا يعرف ويباح الكي والحقنة ضرورة ويكرها بدونها ويجوز للطبيب النظر إلى ما تدعو الحاجة إليه حتى الفرج ويباح الحجامة والفصد والتشريط والبط وقطع السلع ويحرم التداوي بنجس وطاهر محرم وسماع دف وغناء، وبمقير وفي الترياق الكثير PageV02P586 (@@) خلاف. ويباح للمرأة شرب دواء لقطع حيض ومخبة لأقرب رمضان لتفطر، ولإلقاء نطفة في وجه، ولا يجوز لإلقاء جنين، ولا بأس أن يطلق عن المسحور، وشرب مسهل وقيء، والتداوي بماء زمزم، ويكره سب الحمى. 
ms288	(@)(@)PageV02P587(@)(@)(@@)(@@)(@@) || AUTO الخامس: يكره نفط الطعام والشراب(@)(@)(@@) ويكره أكله مما يلي غيره إذا كان الطعام لونا واحدا، ومن وسط القصعة. والأكل والشرب متكئا ومضطجعا وبشماله لغير ضرورة، ويكره غسل بدنه بمطعوم ولا بأس بنخالة، وتسن التسمية قبل الطعام والشرب وإن نسي أتى بها ولو في آخره. ويباح تخير الفاكهة، ونحوها، ولو من ناحية غيره، ويباح الأكل من بيت قريب؛ وصديق من غير مال محترز عنه إذا علم أو ظن رضا صاحبه، ويكره القرآن في التمر ونحوه ويسن الجلوس للأكل على رجله اليسرى، وينصب اليمنى أو يتربع. ويسن الأكل بثلاث أصابع ويسن لعق الأصبع، والتقاط ما سقط، ويسن أن يحمد بعده، ويحرم الأكل والشرب في الذهب والفضة، PageV02P588 (@@) ويباح في غيرهما مطلقا إذا كان طاهرا، ويباح تخليل أسنانه بغير قضيب ورمان وريحان وطرفاء، ويباح الشبع وتركه أولى. ولا يتأخر عن المائدة قبل الناس. وتسن مباسطة من يأكل، ولا يحدث بمستقذر، ولا مضحك، ويأكل الفاكهة قبل الطعام ولا يصلح بعده إلا الكمثرى والسفرجل ولا يشرب الماء عقب الفاكهة إلا التين. ويكره الأكل على الطريق وبين أن يبدأ بالملح ويختمبه ويكره إخراج شيء من فيه ورده، ولا يمسح يده بالخبز ولا يستبذله ولا يخلط طعاما بطعام، ولا يذم الطعام، ولا يستحسنه صاحبه، ولا يمدحه وفي غسل اليدين قبل الطعام وبعده خلاف. ولا بأس بسمح بمنديل وإحدى اليدين الأخرى. وبرجله ولا بأس بأكل فاكهة مدودة بدودها وخل مدود وجبن ونحوه به، وفي أكل PageV02P589 (@@) الدود مفردا خلاف، وإذا فرغ من الأكل عندغيره سن الانصراف، ويخرج مع الضيف إلى باب الدار. ويكره أن يطعم البهائم الخبز، ويكره أكل لحم نيء وغير نضيج وطين وتراب ويحرم أكل القمل والحشرات، ولا بأس أن يقال لمن شرب هنيئا أو صحة.(@)(@)PageV02P590(@)(@)(@@)(@@)(@@) || AUTO السادس: يسن أن يصان كل مسجد(@)(@)(@@) من كل وسخ وقذر وقذارة ومخاط وبصاق، وإن رثيت فيه أو فعلت دفنت وعن تقليم أظفار، ويكره زخرفته بذهب أو فضة أو نقش أو صيغ أو كتابة، ولا يعلق شيء في قبلته ويصان عن 
ms289	 بيع وشراء وعمل صنعة، وعن صغير ومجنون وحائض ونفسا ولغط وكثرة حديث، ورفع صوت بمكروه، ورائحة كريهة، وثوم وبصل وكراث، وإن دخله من أكل ذلك أخرج، وجنب بلا وضوء، ومرور وغناء وسماع وإنشاد ضالة ويقول من سمعه لا ردها اللهعليك وإقامة حد، وعرس، وزرع، وجماع، وبول وقيء وإخراج نجاسة وسؤال، ولا بأس فيه بذكر وتعليم فقه، وحديث وقراءة ووعظ وعقد نكاح، وقضاء ولا يخرج منه حصى وتراب للتبرك ولا يدخله كافر إلا بإذن مسلم، ويقدم المسلم PageV02P591 (@@) يمناه في دخوله، ويسراه في خروجه، ويقول ما ورد ويضع نعله عن يساره وأمامه ويسن كنسه وتنظيفه في ثالث ويصلي من دخله ركعتين ويباح دخول بيعة وكنيسة.(@)(@)PageV02P592(@)(@)(@@)(@@)(@@) || AUTO السابع: يحرم على كل رجل(@)(@)(@@) حر وعبد عند استعمال ثوب وعمامة وتكة وسراويل شراؤه من حرير بلا ضرورة ويباح زر ونحوه، وإن كان منسوجا مع غيره وغلب حرم وإن قل أبيح، وإن استويا فخلاف وفي إباحته لمرض وجرب وصغير، خلاف، ويباح كله للنساء، ويباح للرجل منه علم ورقعة ولبنة جنب وسجف فروة قدر كف، ويحرم منسوج بذهب وفضة ومطلي ومكفت ومطعم بأحدهما، ويحرم تمويه حائط وسقف وسرير بأحدهما ويباح له من الفضة قبيعة السيف، وآلة الحرب ويحرم دواة ومحبرة ومقلمة ومرأة ومسعط ونحو ذلك ولا يحرم اللآليء والجواهر الثمينة ويكه كتب صداق المرأة في الحرير ويحرم تصوير حيوان برأس في ثوب، ونحوه وكذا في حائط وسرير ونحو ذلك ولا بأس بما فيه غير حيوان من شجر ويكره ستر PageV02P593 (@@) الحيطان مطلقا ولو بما لا تصاوير فيه، ويباح للمرأة التحلي بذهب وفضة وغيرهما مطلقا، ويباح ثوب من شعر ما يؤكل لحمه وفي لبس نجس من ثوب وجلد في غير صلاة خلاف، ويباح لبس كل جلد طاهر ويباح لبس السواد كله، وفي الأحمر والأصفر خلاف، ويباح ثوب الرجل من نصف ساقه إلى كعبه، ويكره ما نزل عن ذلك، ويحرم الخيلاء والتعجب بثوب ونحوه ولا بأس بالسراويل. وتوسيع كم المرأة وتطويل كم الرجل إلى رؤوس الأصبع، ويكره ثوب الشهرة ويكره 
ms290	 ما خالف زي بلده. ويسن التوسطفي الملبس وتكره العمامة الصماء [وتسن] النظافة وغسل الثوب الوسخ، ويباح للرجل خاتم الفضة في الخنصر، ويكره في الوسطى والسبابة، ويكره خاتم الحديد والنحاس والرصاص PageV02P594 (@@) ويكره تشبه رجل بامرأة، وعكسه لغير حاجة، ويسن للمرأة المزوجة الخضاب، ويكره للرجل، ويكره لبس النعال الصراة ويسن كون الخف أحمر والنعمل أصفر ويباح الأحمر والأسود. ويسن الطيب للرجل بما ظهر ريحه وخفي لونه، وللمرأة العكس. ويسن النظر في المرآة ويقول ما ورد. ويسن الكحل وترا والدهن غبا، ويكره القزع وحلق رأس المرأة لغير حاجة، ولا يجوز للمرأة أن تبدي زينتها لأجنبي وكافرة.(@)(@)PageV02P595(@)(@)(@@) كتاب الألغاز(@)(@)PageV02P597(@)(@)(@@)(@@)(@@) | AUTO كتاب الألغاز(@)(@)(@@) وهي ثلاثة أقسام(@)(@)(@@)(@@)(@@) || AUTO أحدها الفقه(@)(@)(@@) :(@)(@@) - ماء طهور لا تصح الطهارية به؟ فضل وضوء المرأة للرجل.(@)(@@) - ماء طهور يحرم استعماله؟ ماء آبار ثمود.(@)(@@) - رجل عليه طاهر ونجس وحدث يقدم غسل الطاهر عليهما؟ الطيب في الإحرام.(@)(@@) - وضوء صح ممن لا عقل له؟ وضوء الميت.(@)(@@) - طهارة لا تبطل بوجود الحدث وتبطل بعدمه؟ طهارة دائم الحدث.(@)(@@) - حجارة طاهرة لا يجوز الاستجمار بها؟ حجارة الحرم.(@)(@@) - دم حيوان لا يؤكل لحمه يحكم بطهارته؟ دم القمل والبراغيث.(@)(@@) - واجب في الصلاة تركه عمدا وصحت صلاته؟ الجماعة.(@)(@@) - صلاة لا تصح إلا جماعة؟ هي الجمعة.(@)(@@) - صلاة يحرم فعلها وتركها؟ هي صلاة السكران.(@)(@)PageV02P599(@)(@)(@@) - صلاة تفعل عن حي نيابة؟ هي صلاة الطواف.(@)(@@) - صلاة تقصر في سفر قصير؟ صلاة عرفة ومزدلفة.(@)(@@) - قبور يسن للنساء زيارتها من غير كراهة؟ هي قبر النبي صلى الله عليه وسلم وصاحبيه.(@)(@@) - مسلم ملك نصابا وحال عليه الحول ولا تجب زكاته؟ العبد إذا ملكه السيد وقلنا نملك ذهبا وفضة.(@)(@@) - لا يشترط لوجوب الزكاة فيهما الحول؟ هو إذا أخرجهما من معدن.(@)(@@) - زكاة تجب في مال كافر؟ في نصار بني تغلب فإنها تؤخذ منهم مثلي ما تؤخذ من المسلمين.(@)(@@) - مسافر يلزمه الصوم وسفره مباح؟ إذا علم أنه يقدم غدا لزمه الصوم.(@)(@@) - صوم تطوع يسن في السفر؟ هو عاشوراء.(@)(@@) - فقير عادم بالكلية يجب عليه الحج؟ هو القريب الذي لا يحتاج إلى كلفة.(@)(@@) - قادر 
ms291	 على الحج بالزاد والراحلة والبلوغ والحرية وأمن الطريق ولا يجب عليه الحج؟ هي المرأة إذا لم يكن لها محرم.(@)(@@) - شخص يصح أن يحرم بالحج عن نفسه وعن غيره معا؟ هو ولي الصغير فإنه يحرم عن الطفل المولي عليه ولو كان محرما والطفل يتولى الأفعال.(@)(@@) - رجل قبض ملك غيه بإذنه ثم أتلفه ضمنه بمثله وقيمته؟ إذا أخذ من حلال صيدا ثم دخل به الحرم أو أحرم وهو معه ثم أتلفه يضمنه بالقيمة لمالكه وبمثله جزاء.(@)(@@) - أضحية لا يجوز الصدقة منها بشيء؟ هي الأضحية عن اليتيم.(@)(@)PageV02P600(@)(@)(@@) - شاة يحرم أكلها إذا ذبحت وليست مستحقة؟ هي الجلالة.(@)(@@) - لبن غنم يحرم أكله؟ هو لبن الجلالة.(@)(@@) - رجل باع أباه وأكل ثمنه؟ هو رجل أذن لعبده في التزويج بحرة فتزوجها وولدت له ابنا فهو حر. ثم ماتت وورثها فطالب الابن مالك أبيه بمهر أمه فوكله في بيع أبيه واستيفاء المهر من ثمنه.(@)(@@) - عبد يجوز عتقه ولا يجوز بيعه؟ هي أم الولد.(@)(@@) - شخص يصح أن يشتري عينا لم يرها قط ولا وصفت له؟ إذا اشترى الأعمى نفسه.(@)(@@) - وكيل في عقد يعتبر في صحة العقد؟ تسمية موكل الوكيل في النكاح.(@)(@@) - هبة تجب على الواهب الرجوع فيها؟ إذا وهب بعض ولده دون بعض.(@)(@@) - عين لا يجوز بيعها وتجوز هديتها والصدقة بها؟ الأضحية.(@)(@@) - صحيح يعتبر وصية من الثلث؟ إذا وقع الطاعون في بلده.(@)(@@) - مملوك لا مالك له؟ هو من وقف على خدمة الكعبة.(@)(@@) - شخص ماتعن أمه وجدته ورثت الثلث والباقي للجدة؟ هذا ابن ابن الملاعنة على رواية.(@)(@@) - رجل مات عن أربع زوجات استحقت إحداهن المهر والميراث والثانية لا تستحق مهرا ولا ميراثا والثالثة المهر دون الميراث والرابعة الميراث دون المهر؟ الأولى حرة مسلمة والثانية أم ولد، والثالثة كافرة، والرابعة أمة تزوجها وجعل عتقها صداقها.(@)(@@) - وطء مباح بغير نكاح ولا ملك يمين؟ هو العبد إذا أباح له السيد التسري وقلنا لا يملك.(@)(@)PageV02P601(@)(@)(@@) - نساء أحرار حرم نكاحهن على أحد؟ هن أزواج النبي صلى الله عليه وسلم.(@)(@@) - شخص طلق امرأة غيره بغير وكالة وصح 
ms292	 طلاقه. هو الحاكم إذا طلق على المولى.(@)(@@) - رجل جنى على عوض رجل لزمه دية عضوين؟ في عين الأعور.(@)(@@) - قتل لا يصح العفو عنه؟ قطاع الطريق.(@)(@@) - مسلم سب كافرا وجب قتله؟ إذا سب أم النبي صلى الله عليه وسلم.(@)(@@) - رجل قال لزوجته: إن شربت هذا الماء فأنت طالق، وإن تركته فأنت طالق؟ تسقي به خبزا أو تطبخ به دقيقا وتأكله.(@)(@)(@@)(@@)(@@) || AUTO الثاني: في النحو(@)(@)(@@) :(@)(@@) - مفعول مرفوع؟ إذا ناب عن الفاعل.(@)(@@) - مبتدأ منصوب؟ إذا دخلت عليه إن.(@)(@@) - خبر منصوب؟ إذا دخلت عليه كان.(@)(@@) - علم نكرة؟ إذا كان غير منون فنون.(@)(@@) - غير منصرف يجر بالكسرة إذا أضيف.(@)(@)(@@)(@@)(@@) || AUTO الثالث: في التواري(@)(@)(@@) :(@)(@@) - رجل وطئ أمه لم يجب عليه شيء؟ المراد وطئها برجله.(@)(@@) - رجل لمس نعله انتقض وضوءه؟ المراد بالنعل الزوجة.(@)(@@) - لا يجب الغسل على من أمنى؟ يعني نزل منى.(@)(@@) - رجل أجنب وجب عليه غسل فأسه؟ الفأس العظم المشرف على نقرة القفا PageV02P602 (@@) - تجوز الصلاة على الغائط؟ هو المكان المطمئن.(@)(@@) - تجوز الصلاة على رأس الكلب؟ هو ثنية معروفة.(@)(@@) - تجوز الصلاة وفخذة باد؟ الفخذ العشيرة وباد من البدو.(@)(@@) - رجل أكل في رمضان بعدما أصبح وصح صومه؟ يعني صبح سراجه.(@)(@@) - رجل أكل في رمضان ليلا فسد صومه؟ الليل فرخ الكروان.(@)(@@) - رجل أكل في رمضان نهارا وصح صومه؟ النهار فرخ الحبارى يعني أكله بالليل.(@)(@@) - امرأة ضحكت فسد صومها؟ الضحك الحيض.(@)(@@) - رجل لاط بصغير وفتحه ولا حد عليه؟ المراد به حوض صغير ملأه ماء وفتحه.(@)(@@) - رجل أدخل جميع ذكره في حجر صغير ولا غسل عليه؟ الحجر الثقب في أرض أو حجر.(@)(@@) - رجل أدخل ذكره في فرج ولا غسل عليه؟ الفرج المنفرج في الأرض.(@)(@@) - رجل جامع امرأة أجنبية ولا غسل عليه ولا حد؟ جاء من المجيء.(@)(@)PageV02P603(@)(@)(@@) كتاب العروض(@)(@)PageV02P605(@)(@)(@@)(@@)(@@) | AUTO كتاب العروض(@)(@)(@@)(@@)(@@) || AUTO الشعر إنما يتركب من وتد وسيب(@)(@)(@@) ، فإن كان التركيب من حرفين فهو السبب، فإن كان ثنيهما ساكنا فهو الخفيف، وإن كانا متحركين فهو الثقيل، وإن كان من ثلاثة فهو الوتد ودوائره خمس والبحور الخارجة منه ستة عشر.(@)(@@) الأول: الطويل، 
ms293	 وهو: فعولن مفاعيلن أربع مرات.(@)(@@) الثاني: البسيط، وهو مستفعلن فاعلن أربع مرات.(@)(@@) الثالث: المديد، وهو فاعلاتن فاعلن أربع مرات.(@)(@@) الرابع: الوافر، وهو مفاعلتن ست مرات.(@)(@@) الخامس: الكامل، وهو متفاعلن ست مرات.(@)(@@) السادس: الهزج، وهو مفاعيلن ست مرات.(@)(@@) السابع: الرجز، وهو مستفعلن ست مرات.(@)(@)PageV02P607(@)(@)(@@) الثامن: الرمل، وهو فاعلاتن ست مرات.(@)(@@) التاسع: السريع، وهو مستفعلن مستفعلن مفعولات مرتان.(@)(@@) العاشر: المنسرح، وهو مستفعلن مفعولات مستفعلن مرتان.(@)(@@) الحادي عشر: الخفيف، وهو فاعلاتن مستفعلن فاعلاتن مرتان.(@)(@@) الثاني عشر: المضارع، وهو مفاعلين فاعلاتن مفاعلين مرتان.(@)(@@) الثالث عشر: المقتضب، وهو مفعولات مستفعلن مستفعلن: مرتان.(@)(@@) الرابع عشر: المجت، وهو مستفعلن فاعلاتن فاعلاتن مرتان.(@)(@@) الخامس عشر: المتقارب، فعولن ثماني مرات.(@)(@@) السادس عشر: المتدارك، وهو فاعلن ثماني مرات.(@)(@)PageV02P608(@)(@)(@@) كتاب الحكم والمواعظ(@)(@)PageV02P609(@)(@)(@@)(@@)(@@) | AUTO كتاب الحكم والمواعظ(@)(@)(@@)(@@)(@@) || AUTO من خاف سلم -من عجل ندم-(@)(@)(@@) كل بريء جريء- كل خائف هارب - كل راج طالب- كل محب مستأنس - كل عدو مستوحش- عين الرضى تستر العيوب، وعين السخط تظهر الذنوب - كيف تنام عين مع المخافة - كيف يغفل قلب بعد اليقين بالمحاسبة - لا يمحو الشهوات من القلوب إلا خوف مزعج أو شوق مقلق- موت القلب طلب الدنيا بالآخرة - من أنزل الموت حق منزلته لم يعد غدا من أجله- كم من مستقبل يوما لا يستكمله وراج غدا لا يبلغه- كل علم لا ينفع صاحبه فهو وبال عليه- من لم يكن معك فهو عليك- كلب ينبح لك خير من كلب ينبح عليك- من عمر آخرته خرب دنياه ومن عمر دنياه خرب آخرته- لا ينال العلم براحة الجسد- لا يلدغ المؤمن من جحر مرتين- لا يجني على المرء إلا يده- الشديد من غلب نفسه- ليس الخبر كالمعاينة- الشاهد يرى ما لا يرى الغائب- ساقي القوم آخرهم شربا- لو بغى جبل على جبل جعله الله دكا- الحرب خدعة- المسلم مرآة أخيه-خير الرزق ما كفى- البلاء موكل بالمنطق- فضل العلم خير من فضل العبادة- الغنى غنى النفس- الحياء خير كله- الخيل في نواصيها الخير- عدة المؤمن كأخذ باليد- من الشعر حكمة- من البيان سحر- الصحة والفراغ نعمتان مغبون فيهما كثير من الناس- ارحم من في الأرض يرحمك من في السماء- المكر والخديعة في الناس- المرء مع من أحب- PageV02P611 (@@) المستشار مؤتمن- من لم يرحم لا يرحم- الدال 
ms294	 على الخير كفاعله- لا يشكر الله من لا يشكر الناس- كل معروف صدقة- لا يؤوى الضالة إلا ضال- مطل الغني ظلم- الظلم ظلمات يوم القيامة- جبلت القلوب على حب من أحسن إليها وبغض من أساء إليها- ما نقص مال من صدقة- لا رضاع بعد فطام- لا يتم بعد احتلام- دع ما يريبك إلى ما لا يريبك- من صمت نجا- عثرة اللسان أمر من عثرة الرجل- الناس كالإبل المائة لا تكاد تجد فيها راحلة- من لم ينظر في العواقب فليس الدهر له بصاحب- الشر يقطع فعل المعروف- يا كثي الذنوب متى تتوب- يا من شاب في المعاصي قد دنا الأخذ بالنواصي- يا من يصر على الصغائر والكبائر ودهش عن أخراه فصار كالحائر، أما آن لك أن ترجع، أما حان أن تترك ما أنت عليه وتقلع، فيا أيها الشاب لا تغتر بشبابك فكم من غصن قصفته الرياح، ويا أيها الكهل لا تخدعن بقوتك فكم من زرع وثمر أصيب قبل بدو الصلاح، ويا أيها الشيخ اعتبر وأقلع فليس بعد الانتهاء غير البرزخ. إخواني اتعظوا بمن مضى واعتبروا بمن مات وانقضى، قف بالديار واسألها عن الأهل والأنصار، ستنبئك عنهم بأن الكل ماتوا، وإنكم عن قريب عما أتوا عليه تأتوا، فتزود يا أخي لهذا السفر البعيد، وتأهب لذلك المصرع الشديد(@)(@@) تزود للذي لابد منه ... فإن الموت ميقات العباد(@)(@@) أترضى أن تكون رفيق قوم ... لهم زاد وأنت بغير زاد PageV02P612 (@@) كتاب الملل والمذاهب(@)(@@) مرتب على الحروف(@)(@)PageV02P613(@)(@)(@@)(@@)(@@) | AUTO كتاب الملل والمذاهب (مرتب على الحروف)(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) - الإسلام- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) زارقة- الإمامية- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) شعرية- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) حمدية- الاتحادية- الإلحادية- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) طباء- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) صولية- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) دباء- الإسماعيلية- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) خفشية- ال(@)(@)(@@)(@@)(@@) || AUTO أ(@)(@)(@@) خنية- الإلهامية- PageV02P615 (@@) الإ(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) احية- الإسكافية.(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) ال(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) يهسية- ال(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@) دعية- ال(@)(@)(@@)(@@)(@@) || AUTO ب(@)(@)(@@)(@@)(@@) || AUTO ت(@)(@)