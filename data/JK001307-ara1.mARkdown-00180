ms161	 لا يعرف(@)(@@)(@@)(@@) $ 3204 د(@)(@@) عبد الله بن سليمان بن جنادة عن أبيه عن جده قال البخاري في حديثه نظر(@)(@@)(@@)(@@) $ 3205 عبد الله بن سليمان البعلبكي عن ابن المبارك ليس بذاك القوي(@)(@@)(@@)(@@) $ 3206 ت(@)(@@) عبد الله بن سليمان النوفلي لم يرو عنه سوى هشام بن يوسف(@)(@@)(@@)(@@) $ 3207 عبد الله بن سليمان السجستاني ثقة كذبه ابوه يعني في غير الحديث ووثقه الناس(@)(@@)(@@)(@@) $ 3208 عبد الله بن السمط عن صالح بن علي روى خبرا موضوعا(@)(@@)(@@)(@@) $ 3209 عبد الله بن سنان عن ابن المنكدر ضعفه أبو حاتم وغيره واسطي(@)(@@)(@@)(@@) $ 3210 عبد الله بن سيدان الربذي تابعي عن أبي ذر قال البخاري لا يتابع في حديثه(@)(@@)(@@)(@@) $ 3211 عبد الله بن سيف عن مالك بن مغول لا يعرف PageV01P341 وحديثه منكر روى عنه سعد بن نصر وذكر انه خوارزمي والحسين بن عيسى البسطامي(@)(@@)(@@)(@@) $ 3212 عبد الله بن شبيب الربعي الاخباري واه قال أبو أحمد الحاكم ذاهب الحديث(@)(@@)(@@)(@@) $ 3213 عبد الله بن أبي شديدة روى عنه مغيرة بن سعد ارسل حديثا مجهول(@)(@@)(@@)(@@) $ 3214 عبد الله بن الشرود والد بكر قال الدارقطني هو وابنه ضعيفان(@)(@@)(@@)(@@) $ 3215 س(@)(@@) عبد الله بن شريك العامري عن ابن عمر وكان من اصحاب المختار في شبيبته وثقه أحمد وابن معين وغيرهما ولينه النسائي وقال الجوزجاني كذاب(@)(@@)(@@)(@@) $ 3216 م عه(@)(@@) عبد الله بن شقيق العقيلي ثقة ناصبي كان سليمان التيمي سيء الرأي فيه(@)(@@)(@@)(@@) $ 3217 عبد الله بن أبي شقيق السلولي عن أبي زيد أحد الصحابة مجهول(@)(@@)(@@)(@@) $ 3218 خ د ت ق(@)(@@) عبد الله بن صالح كاتب الليث مكثر صالح الحديث له مناكير والصحيح ان البخاري روى عنه في الصحيح وروى عنه ابن معين قال أبو زرعة كان حسن الحديث وقال الفضل الشعراني ما رأيته الا وهو يحدث أو يسبح وقال ابن عدي PageV01P342 هو عندي مستقيم الحديث وله اغاليط وقال أبو حاتم لم يكن ممن يكذب واما الحافظ جزرة فقال كان يكذب وقال النسائي ليس بثقة وقال غيره ضعيف(@)(@@)(@@)(@@) $ 3219 م عه(@)(@@) عبد الله بن الصامت 
ms162	 عن عمه أبي ذر صدوق ومنهم من لم يحتج به(@)(@@)(@@)(@@) $ 3220 عبد الله بن صدقة عن أبيه يروي عنه البرجلاني لا يعرف(@)(@@)(@@)(@@) $ 3221 عبد الله بن صفوان عن وهب بن منبه قال هشام بن يوسف ضعيف(@)(@@)(@@)(@@) $ 3222 ت(@)(@@) عبد الله بن صهبان عن عطية قال أبو حاتم في حديثه شيء(@)(@@)(@@)(@@) $ 3223 عبد الله بن ضرار الاسدي عن ابن مسعود قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 3224 عبد الله بن ضرار عن أبيه وغيره قال يحيى لا يكتب حديثه(@)(@@)(@@)(@@) $ 3225 عه(@)(@@) عبد الله بن ظالم عن سعيد بن زيد العشرة في الجنة قال البخاري لم يصح(@)(@@)(@@)(@@) $ 3226 ق(@)(@@) عبد الله بن عامر الاسلمي المدني عن نافع ضعفه غير واحد(@)(@@)(@@)(@@) $ 3227 عبد الله بن أبي عامر القرشي المدني قال أحمد ضعيف(@)(@@)(@@)(@@) $ 3228 عبد الله بن عباد بصري نزل مصر عن المفضل بن فضالة ضعيف(@)(@@)(@@)(@@) $ 3229 عبد الله بن عبد الله بن أبي امية عن أم سلمة لم يثبت حديثه PageV01P343(@)(@@)(@@)(@@) $ 3230 م متابعة عه(@)(@@) عبد الله بن عبد الله بن أبي عامر أبو أويس عن الزهري قال ابن معين صالح وليس بذاك وبعضهم قواه وقال أحمد ضعيف وقال ابن معين هو مثل فليح في حديثه ضعف(@)(@@)(@@)(@@) $ 3231 عبد الله بن عبد الله بن محمد أبو بكر بن أبي سبرة في الكنى كذبه أحمد بن حنبل(@)(@@)(@@)(@@) $ 3232 ق(@)(@@) عبد الله بن عبد الله الاموي عن الحسن بن الحر لا يعرف قال العقيلي لا يتابع على حديثه(@)(@@)(@@)(@@) $ 3233 عبد الله بن عبد الله شيخ لمحمد بن قيس قال ابن معين لا اعرفه(@)(@@)(@@)(@@) $ 3234 م د س ق(@)(@@) عبد الله بن عبد الرحمن بن يعلى الطائفي عن عطاء قال أبو حاتم والنسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3235 عبد الله بن عبد الرحمن عن ابن عمر مجهول(@)(@@)(@@)(@@) $ 3236 عبد الله بن عبد الرحمن الجزري عن الثوري قال ابن حبان كان يأتي بالأوابد(@)(@@)(@@)(@@) $ 3237 عبد الله بن عبد الرحمن الكلبي عن مالك حدث بالطامات ببخارى وكذب(@)(@@)(@@)(@@) $ 3238 عبد الله بن عبد 
ms163	 الرحمن الجمحي عن الزهري لا يعرف وقاله ابن معين قلت روى عنه معن وجماعة قال الدارقطني ليس بالقوي PageV01P344(@)(@@)(@@)(@@) $ 3239 عبد الله بن عبد الرحمن بن مليحة النيسابوري عن عكرمة بن عمار قال الحاكم أبو عبد الله الغالب على رواياته المناكير(@)(@@)(@@)(@@) $ 3240 عبد الله بن عبد الرحمن بن موهب عن القاسم بن محمد ضعفه ابن معين(@)(@@)(@@)(@@) $ 3241 عبد الله بن عبد الرحمن بن زيد عن مجهول روى عنه عبد الكريم(@)(@@)(@@)(@@) $ 3242 عبد الله بن أبي عبد الرحمن عن أبيه مجهول وعنه فطر بن خليفة(@)(@@)(@@)(@@) $ 3243 عبد الله بن عبد الرحمن بن اسيد الازدي عن انس قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 3244 عبد الله بن عبد الرحمن المسمعي عن أبيه اتى بحديث منكر لا يعرف ساقه العقيلي(@)(@@)(@@)(@@) $ 3245 ق(@)(@@) عبد الله بن عبد العزيز بن أبي ثابت الليثي عن الزهري ضعفوه(@)(@@)(@@)(@@) $ 3246 عبد الله بن عبد العزيز بن أبي رواد عن أبيه قال أبو حاتم وغيره احاديثه منكرة وقال ابن الجنيد لا يساوي فلسا(@)(@@)(@@)(@@) $ 3247 عبد الله بن عبد العزيز عن مالك اتهمه ابن حبان وقال وحديثه كذب عن نافع عن ابن عمر مرفوعا الرباط على رأس السبعين ومائة افضل فأما(@)(@@)(@@)(@@) $ 3248 عبد الله بن عبد العزيز العمري الزاهد فوثقه النسائي(@)(@@)(@@)(@@) $ 3249 عبد الله بن العزيز الحضرمي أحد التابعين مجهول PageV01P345(@)(@@)(@@)(@@) $ 3250 عبد الله بن عبد العزيز المديني هو الليثي قد ذكر وقيل الزهري روى عن اخيه خبرا باطلا(@)(@@)(@@)(@@) $ 3251 ت(@)(@@) عبد الله بن عبد القدوس كوفي نزل الري عن الاعمش ضعفوه(@)(@@)(@@)(@@) $ 3252 عبد الله بن عبد الكريم الثقفي عن أبي رجاء قال أبو زرعة مجهول(@)(@@)(@@)(@@) $ 3253 عبد الله بن عبد الملك عن يزيد بن رومان قال ابن حبان لا يشبه حديثه حديث الثقات يروي العجائب(@)(@@)(@@)(@@) $ 3254 عبد الله بن عبد الملك بن كرز ينسب إلى جده(@)(@@)(@@)(@@) $ 3255 عبد الله بن عبد الملك الاسكندراني عن ابن وهب ضعفه ابن يونس(@)(@@)(@@)(@@) $ 3256 عبد الله بن عبيد الله هو أبو عاصم العباداني يأتي(@)(@@)(@@)(@@) $ 3257 عبد الله 
ms164	 بن عبدوس روى عن الانصاري قال الدارقطني ليس بالقوي(@)(@@)(@@)(@@) $ 3258 خ(@)(@@) عبد الله بن عبيدة الربذي اخو موسى عن سهل ابن سعد وثقه غير واحد وقال ابن عدي الضعف على حديثه بين وقال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 3259 عبد الله بن عتبة بن أبي سفيان عن أم حبيبة فيه جهالة(@)(@@)(@@)(@@) $ 3260 م عه(@)(@@) عبد الله بن عثمان بن خثيم وثقه ابن معين مرة PageV01P346 ومرة قال ليس بالقوي وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 3261 عبد الله بن عثمان بن سعد قال ابن معين لا اعرفه(@)(@@)(@@)(@@) $ 3262 ق(@)(@@) عبد الله بن عرادة السدوسي عن الرقاشي قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 3263 عبد الله بن عصم أبو علوان عن ابن عباس قال ابن حبان منكر الحديث جدا(@)(@@)(@@)(@@) $ 3264 عبد الله بن عصمة عن حماد بن سلمة لينه العقيلي وغيره(@)(@@)(@@)(@@) $ 3265 م عه عبد الله بن عطاء المكي شيخ لشعبة وثق وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3266 عبد الله بن عطاء بن إبراهيم مولى آل الزبير شيخ لابن إسحاق قال ابن معين لا شيء(@)(@@)(@@)(@@) $ 3267 عبد الله بن عطاء الابراهيمي متأخر وثقه يحيى بن منده وكذبه السقطي(@)(@@)(@@)(@@) $ 3268 عبد الله بن عطارد عن مسعر روى احاديث لا يتابع عليها(@)(@@)(@@)(@@) $ 3269 ق(@)(@@) عبد الله بن عطية لم يرو عنه سوى منيب بن عبد الله(@)(@@)(@@)(@@) $ 3270 عبد الله بن علي بن نعجة الجهني عن أبيه قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 3271 عبد الله بن علي بن سويدة التكريتي عن الكروخي قال ابن الدبيثي فيه تساهل في الرواية(@)(@@)(@@)(@@) $ 3272 عبد الله بن علي بن مهران روى عنه موسى بن عقبة مجهول PageV01P347(@)(@@)(@@)(@@) $ 3273 عبد الله بن علي الباهلي الوضاحي قال ابن طاهر كان يضع الحديث(@)(@@)(@@)(@@) $ 3274 د ت(@)(@@) عبد الله بن علي أبو أيوب الافريقي عن ابن المنكدر لينه أبو زرعة(@)(@@)(@@)(@@) $ 3275 عبد الله بن العلاء بن أبي نبقة بيض له مجهول(@)(@@)(@@)(@@) $ 3276 عبد الله بن أبي علاج الموصلي عن مالك اتهم بالوضع وقد مر(@)(@@)(@@)(@@) $ 3277 عبد الله بن عمار 
ms165	 اليمامي عن أبي الصلت مجهول(@)(@@)(@@)(@@) $ 3278 د(@)(@@) عبد الله بن عمر بن غانم الافريقي مجهول الحال واتهمه ابن حبان وذكر له عن نافع عن ابن عمر رفعه الشيخ في بيته كالنبي في قومه وبالسند ما من شجرة احب إلى الله من الحناء(@)(@@)(@@)(@@) $ 3279 عبد الله بن عمر السعيدي الأموي معاصر لمالك فيه جهالة(@)(@@)(@@)(@@) $ 3280 عبد الله بن عمر بن أبان قال صالح جزرة كان غاليا في التشيع(@)(@@)(@@)(@@) $ 3281 م متابعة عه(@)(@@) عبد الله بن عمر بن حفص العمري صدوق حسن الحديث قال أحمد صالح الحديث وقال ابن معين PageV01P348 يكتب حديثه وقال ابن عدي لا بأس به وعن ابن معين ايضا صويلح وقال س ليس بالقوي(@)(@@)(@@)(@@) $ 3282 عبد الله بن عمر الخراساني عن الليث لا يعرف وقال ابن عدي له مناكير(@)(@@)(@@)(@@) $ 3283 عبد الله بن عمران البصري عن أبي عمران الجوني قيل ليس بقوي ذكره العقيلي(@)(@@)(@@)(@@) $ 3284 عبد الله بن عمرو الواقعي عن أبان العطار قال أبو حاتم يفتعل الحديث وقال في أبيه عمر وقال الرافعي هكذا وقع في كتاب ابن أبي حاتم عن أبيه وقال الكتاني سألت أبا حاتم عن عبد الله بن عمرو الواقعي فقال ضعيف(@)(@@)(@@)(@@) $ 3285 م عه(@)(@@) عبد الله بن عمرو المخزومي عن عبد الله بن السائب تفرد عنه محمد بن عباد بن جعفر(@)(@@)(@@)(@@) $ 3286 د(@)(@@) عبد الله بن عمرو بن الفغواء عن أبيه وله صحبة لا يعرف(@)(@@)(@@)(@@) $ 3287 عبد الله بن عمرو بن هند المخزومي روى عنه عوف قال الدارقطني ليس بقوي(@)(@@)(@@)(@@) $ 3288 عبد الله بن عمرو بن حسان عن شعبة وغيره متهم بالكذب(@)(@@)(@@)(@@) $ 3289 عبد الله بن عمرو ببن خداش عن أبي جعفر الباقر مجهول(@)(@@)(@@)(@@) $ 3290 عبد الله بن عمير القرشي في زمن التابعين مجهول ايضا PageV01P349(@)(@@)(@@)(@@) $ 3291 د ت ق(@)(@@) عبد الله بن عميرة لا يعرف قال البخاري لا يعرف له سماع من الأحنف وذكره ابن حبان في الثقات(@)(@@)(@@)(@@) $ 3292 م ق(@)(@@) عبد الله بن عياش القتباني المصري عن الاعرج صالح الحدبث قال أبو حاتم 
ms166	 صدوق ليس بالمتين وقال أبو داود والنسائي ضعيف(@)(@@)(@@)(@@) $ 3293 ع(@)(@@) عبد الله بن عيسى بن عبد الرحمن بن أبي ليلي ثقة قال ابن المديني هو عندي منكر الحديث وقال الدارقطني متروك الحديث(@)(@@)(@@)(@@) $ 3294 عبد الله بن عيسى بن أبي المكدم مصري عن زيد بن سعد وعنه يحيى بن عثمان بن صالح وقال لا يسوى شيئا(@)(@@)(@@)(@@) $ 3295 ت(@)(@@) عبد الله بن عيسى أبو خلف الخزاز عن يونس بن عبيد ضعفوه(@)(@@)(@@)(@@) $ 3296 عبد الله بن عيسى الجندي شيخ لعبد الرزاق لا يعرف والحديث منكر(@)(@@)(@@)(@@) $ 3297 عبد الله بن عيسى أبو مسعود حدث عنه إبراهيم الكندي قال ابن المديني مجهولان(@)(@@)(@@)(@@) $ 3298 عبد الله بن عيسى أبو علقمة الفروي قال ابن حبان يقلب الأخبار عن الثقات(@)(@@)(@@)(@@) $ 3299 عبد الله بن عيسى الخزري عن عفان قال الدارقطني كذاب(@)(@@)(@@)(@@) $ 3300 عبد الله بن عيسى عن أبي الحكم مجهول(@)(@@)(@@)(@@) $ 3301 عبد الله بن غزوان عن عمرو بن سعد هو وشيخه مجهولان(@)(@@)(@@)(@@) $ 3302 د(@)(@@) عبد الله بن فضالة عن أبيه ولفضالة صحبة لا يعرفان والخبر منكر في وقت الصلاة PageV01P350(@)(@@)(@@)(@@) $ 3303 عبد الله بن أبي فراس روى عنه قادم بن ميسور مجهول(@)(@@)(@@)(@@) $ 3304 م د(@)(@@) عبد الله بن فروخ عن عائشة مجهول قلت بل ثقة مشهور(@)(@@)(@@)(@@) $ 3305 د(@)(@@) عبد الله بن فروخ الأفريقي عن ابن جريج قال البخاري تعرف وتنكر وقال ابن عدي أحاديثه غير محفوظة(@)(@@)(@@)(@@) $ 3306 عبد الله بن قبيصة عن هشام بن عروة قال العقيلي لا يتابع على كثير من حديثه(@)(@@)(@@)(@@) $ 3307 عبد الله بن قدامة عن عبد الله بن دينار نكرة له موضوعات(@)(@@)(@@)(@@) $ 3308 عبد الله بن قنبر عن أبيه عن علي بخبر منكر جدا ذكره العقيلي في الضعفاء(@)(@@)(@@)(@@) $ 3309 عبد الله بن قيس الخزاز عن حميد الطويل قال الأزدي كذاب(@)(@@)(@@)(@@) $ 3310 عبد الله بن قيس تابعي أرسل وعنه أبو معاوية المدني مجهولان(@)(@@)(@@)(@@) $ 3311 عبد الله بن قيس عن ابن عباس لا يدرى من هو(@)(@@)(@@)(@@) $ 3312 عبد الله بن كثير المديني عن المقبري قال ابن حبان 
ms167	 لا يحتج به(@)(@@)(@@)(@@) $ 3313 عبد الله بن كرز أبو كرز قاضي الموصل عن نافع قال البخاري هو عبد الله بن عبد الملك بن كرز متروك عنه علي بن الجعد(@)(@@)(@@)(@@) $ 3314 عبد الله بن كليب عن يحيى بن يعمر مجهول PageV01P351(@)(@@)(@@)(@@) $ 3315 عبد الله بن كيسان أبو مجاهد عن عكرمة مروزي ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 3316 خ م(@)(@@) عبد الله بن أبي لبيد المدني عن أبي سلمة ثبت لكنه كان يرى القدر(@)(@@)(@@)(@@) $ 3317 د ت ق(@)(@@) عبد الله بن لهيعة قاضي مصر ضعيف قال أحمد من كان مثله بمصر في كثرة حديثه وضبطه وقال بعض الناس ما روى عنه مثل ابن وهب وابن المبارك فهو أجود وأقوى(@)(@@)(@@)(@@) $ 3318 عبد الله بن أبي ليلي عن علي لا يعرف وخبره منكر(@)(@@)(@@)(@@) $ 3319 د س(@)(@@) عبد الله بن مالك تابعي ماروى عنه إلا كثير بن فرقد(@)(@@)(@@)(@@) $ 3320 ت ق(@)(@@) عبد الله بن المثني الأنصاري عن عمومته وعنه ابنه محمد قال أبو حاتم صالح الحديث وقال أبو داود لا أخرج حديثه وقال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 3321 عبد الله بن محمد بن إبراهيم المروزي عن سليمان بن معبد بخبر باطل(@)(@@)(@@)(@@) $ 3322 عبد الله بن محمد بن أسامة عن الليث وابن لهيعة اتهمه ابن حبان بالوضع(@)(@@)(@@)(@@) $ 3323 عبد الله بن محمد بن جعفر بن شاذان عن أحمد بن محمد ابن مهران الرازي بحديث كذب في فاطمة في مشيخة ابن المهتدي بالله PageV01P352(@)(@@)(@@)(@@) $ 3324 عبد الله بن محمد بن جعفر المخرمي كذبه الدارقطني(@)(@@)(@@)(@@) $ 3325 عبدالله بن محمد بن جعفر أبو القاسم القزويني الفقيه مشهور كذبه الدارقطني(@)(@@)(@@)(@@) $ 3326 عبدالله بن محمد بن زاذان عن هشام بن عروة ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 3327 عبدالله بن محمد بن ربيعة القدامي عن مالك ضعفه ابن عدي(@)(@@)(@@)(@@) $ 3328 عبدالله بن محمد بن سعيد بن أبي مريم عن الفريابي الكبير قال ابن عدي يحدث بالأباطيل فأما ان يكون مغفلا أو أنه يتعمد(@)(@@)(@@)(@@) $ 3329 عبدالله بن محمد بن سنان الروحي عن أبي الوليد في حدود سنة سبعين ومائتين 
ms168	 اعتنى بحديث روح بن القاسم قال ابن حبان كان يضع الحديث(@)(@@)(@@)(@@) $ 3330 عبد الله بن محمد بن أبي الأشعث عن الأعمش جاء في خبر منكر(@)(@@)(@@)(@@) $ 3331 د(@)(@@) عبد الله بن محمد بن عبدالله بن زيد الأنصاري في الأذان لينه البخاري(@)(@@)(@@)(@@) $ 3332 عبد الله بن محمد بن عبد الغفار بن ذكوان البعلبكي عن ابن جوصاء تكلم فيه الكتاني(@)(@@)(@@)(@@) $ 3333 عبد الله بن محمد بن عبد الملك الرقاشي عن جده قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 3334 عبد الله بن محمد بن عبد المؤمن القرطبي شيخ ابن عبد البر PageV01P353 تأخر صدوق قال ابن الفرضي لم يكن ضبطه جيدا فربما أخل بالهجاء(@)(@@)(@@)(@@) $ 3335 عبد الله بن محمد بن عبد الوهاب أبو سعيد الرازي اتهمه الخليلي(@)(@@)(@@)(@@) $ 3336 عبد الله بن محمد بن عجلان عن أبيه قال ابن حبان لا يحل كتب حديثه(@)(@@)(@@)(@@) $ 3337 د ت ق(@)(@@) عبد الله بن محمد بن عقيل حسن الحديث احتج به أحمد واسحاق وقال ابن خزيمة لا أحتج به وقال أبو حاتم وغيره لين الحديث(@)(@@)(@@)(@@) $ 3338 عبد الله بن محمد بن عقيل الباوردي عن النجاد قال عبد الرحمن بن منده قال لي من لم يكن معتزليا فليس بمسلم فتركته(@)(@@)(@@)(@@) $ 3339 عبد الله بن محمد بن عمار بن سعد القرظ عن أبائه ضعفه ابن معين(@)(@@)(@@)(@@) $ 3340 عبد الله بن محمد بن عمر بن علي والد عيسى قال بن المديني هو وسط وقال غيره صالح الحديث(@)(@@)(@@)(@@) $ 3341 عبد الله بن محمد بن قاسم عن يزيد بن هارون تكلم فيه ابن حبان(@)(@@)(@@)(@@) $ 3342 عبد الله بن محمد بن محارب الاصطخري عن أبي خليفة PageV01P354 أحاديثه عنه مقلوبة هي بروايات ابن دريد أشبه توفي سنة أربع وثمانين وثلاثمائة(@)(@@)(@@)(@@) $ 3343 م د(@)(@@) عبد الله بن محمد بن معن عن أم هشام وثق وليس بمعروف(@)(@@)(@@)(@@) $ 3344 عبد الله بن محمد بن المغيرة الكوفي بمصر عن الثوري واه قال ابن عدي عامة حديثه لا يتابع عليه(@)(@@)(@@)(@@) $ 3345 عبد الله بن محمد بن المغيرة المدني عن هشام بن عروة ضعفه 
ms169	 ابن عدي وغيره(@)(@@)(@@)(@@) $ 3346 عبد الله بن محمد بن وهب الدينوري الحافظ قال الدارقطني متروك(@)(@@)(@@)(@@) $ 3347 عبد الله بن محمد بن يحيى بن عروة تركه أبو حاتم وغيره وقال ابن حبان لا يحل كتبة حديثه(@)(@@)(@@)(@@) $ 3348(@)(@@) عبد الله بن محمد بن اليسع المقريء الأنطاكي عن أبي عروبة قال الأزهري ليس بحجة كان يقول قرأت الختمة في ساعة(@)(@@)(@@)(@@) $ 3349 عبد الله بن محمد بن يعقوب البخاري قال أبو سعيد الرواس يتهم بالوضع(@)(@@)(@@)(@@) $ 3350 عبد الله بن محمد اليمامي عن أدم بن علي مجهول(@)(@@)(@@)(@@) $ 3351 ق(@)(@@) عبد الله بن محمد العدوي شيخ للوليد بن بكير مجهول وقيل كان وضاعا PageV01P355(@)(@@)(@@)(@@) $ 3352 ق(@)(@@) عبد الله بن محمد الليثي عن تابعي صغير لا يدرى من هو في القدرية(@)(@@)(@@)(@@) $ 3353 عبد الله بن محمد أبو الحباب عن الزهري قال وكيع كان يضع الحديث(@)(@@)(@@)(@@) $ 3354 عبد الله بن محمد أبو القاسم البغوي ثقة تكلم فيه بعضهم بلا حجة(@)(@@)(@@)(@@) $ 3355 عبد الله بن محمد أبو بكر الخزاعي حفيد عبد الرحمن ابن غزوان قراد عن محمود بن خداش وضاع متروك(@)(@@)(@@)(@@) $ 3356 عبد الله بن محمد أبو القاسم بن الثلاج عن البغوي قال الأزهري كان يضع الحديث(@)(@@)(@@)(@@) $ 3357 عبد الله بن محمد بن الشرقي أخو الحافظ أبي حامد تكلموا فيه لادمانه المسكر(@)(@@)(@@)(@@) $ 3358 عبد الله بن محمد المقرىء الحذاء عن ابن المظفر قال ابن خيرون كان يكذب في القراءات(@)(@@)(@@)(@@) $ 3359 عبد الله بن محمد أبو عباد السراج شيخ للحاكم متهم(@)(@@)(@@)(@@) $ 3360 ق(@)(@@) عبد الله ابن المحرر يروي عن زيد بن الاصم وقتادة قال أحمد ترك الناس حديثه(@)(@@)(@@)(@@) $ 3361 عبد الله بن أبي محرز يروي عنه عبد الرحمن بن أبي عمار مجهول(@)(@@)(@@)(@@) $ 3362 عبد الله بن مروان عن ابن جريج قال ابن عدي حدث عنه سليمان بن عبد الرحمن بمناكير(@)(@@)(@@)(@@) $ 3363 عبد الله بن مروان عن ابن أبي ذئب قال ابن حبان لا يحل الاحتجاج به PageV01P356(@)(@@)(@@)(@@) $ 3364 عبد الله بن أبي مريم والد أبي بكر الغساني لا يعرف وخبره منكر(@)(@@)(@@)(@@) $ 3365 
ms170	 د ت ق(@)(@@) عبد الله بن أبي مرة الزوفي وقيل ابن مرة عن خارجة في الوتر لم يصح خبره(@)(@@)(@@)(@@) $ 3366 عبد الله بن مسلم بن قتيبة أبو محمد صاحب التصانيف صدوق سمع اسحاق بن راهوية قال الحاكم أجمعت الأمة على أن القتيبي كذاب قلت هذا بغي وتخرص بل قال الخطيب هو ثقة(@)(@@)(@@)(@@) $ 3367 ق(@)(@@) عبد الله بن مسلم بن هرمز عن مجاهد ضعفه ابن معين وقال الإمام أحمد صالح الحديث(@)(@@)(@@)(@@) $ 3368 د ت س(@)(@@) عبد الله بن مسلم أبو طيبة عن ابن بريدة قال أبو حاتم لا يحتج به وقواه غيره PageV01P357(@)(@@)(@@)(@@) $ 3369 عبد الله بن مسلم بن رشيد عن الليث متهم بوضع الحديث ذكره ابن حبان(@)(@@)(@@)(@@) $ 3370 عبد الله بن المسور بن عون بن جعفر بن أبي طالب قال أحمد وغيره أحاديثه موضوعة وقال النسائي والدارقطني متروك وهوأبو جعفر عرف بالمدائني في زمن المنصور(@)(@@)(@@)(@@) $ 3371 عبد الله بن مسعر بن كدام قال أبو حاتم متروك(@)(@@)(@@)(@@) $ 3372 عبد الله مساور تابعي مجهول(@)(@@)(@@)(@@) $ 3373 عبد الله بن مصعب بن خالد الجهني عن أبيه عن جده فرفع خطبة منكرة طويلة وعنه عبد الله بن نافع الصائغ(@)(@@)(@@)(@@) $ 3374 عبد الله بن مصعب الزبيري والد مصعب ضعفه ابن معين(@)(@@)(@@)(@@) $ 3375 عبد الله بن مضارب من صغار التابعين كذا لا يعرف(@)(@@)(@@)(@@) $ 3376 عبد الله بن مطر أبو ريحانة في الكنى(@)(@@)(@@)(@@) $ 3377 س(@)(@@) عبد الله بن المطلب عن أنس لا يعرف(@)(@@)(@@)(@@) $ 3378 ت ق(@)(@@) عبد الله بن معاذ الصنعاني كان عبد الرزاق يكذبه وله عن معمر ونحوه وأما أبو حاتم فقال هو أوثق من عبد الرزاق(@)(@@)(@@)(@@) $ 3379 عبد الله بن معانق الأشعري تابعي لينه أبو الحسن الدارقطني(@)(@@)(@@)(@@) $ 3380 م عه(@)(@@) عبد الله بن معبد الزماني عن أبي قتادة ثقة قال البخاري لا يعرف له سماع منه(@)(@@)(@@)(@@) $ 3381 عبد الله بن معاوية بن عاصم عن هشام بن عروة قال البخاري منكر الحديث PageV01P358(@)(@@)(@@)(@@) $ 3382 عبد الله بن مكنف عن أنس مجهول قال ابن حبان لا يحتج به(@)(@@)(@@)(@@) $ 3383 عبد 
ms171	 الله بن ملاذ الأشعري شيخ لجرير بن حازم لا يعرف(@)(@@)(@@)(@@) $ 3384 عبد الله بن منصور أبو بكر الباقلاني المقريء قال ابن المديني ادعى رواية غير العشرة عن القلانسي فتكلموا فيه وأصر شرها منه(@)(@@)(@@)(@@) $ 3385 عبد الله بن المنكدر بن محمد بن المنكدر فيه جهالة وله خبر منكر(@)(@@)(@@)(@@) $ 3386 د ق(@)(@@) عبد الله بن منين المصري لم يرو عنه غير الحارث بن سعيد(@)(@@)(@@)(@@) $ 3387 عبد الله بن موسى بن كريد عن ابن صاعد صاحب مناكير وأوابد(@)(@@)(@@)(@@) $ 3388 ق(@)(@@) عبد الله بن موسى التيمي عن أسامة بن زيد ليس بحجة(@)(@@)(@@)(@@) $ 3389 عبد الله بن موسى هو عمر بن موسى هالك(@)(@@)(@@)(@@) $ 3390 ت ق(@)(@@) عبد الله بن المؤمل المخزومي عن عطاء ضعفه الدارقطني وجماعة(@)(@@)(@@)(@@) $ 3391 ق(@)(@@) عبد الله بن ميسرة شيخ لهشيم هو أبو ليلى وهو أبو اسحاق وأبو جرير وأبو الخليل روى عن مجاهد ضعفه النسائي وجماعة(@)(@@)(@@)(@@) $ 3392 ت(@)(@@) عبد الله بن ميمون القداح المكي عن جعفر بن محمد PageV01P359(@)(@@) قال أبو حاتم متروك وقال البخاري ذاهب الحديث وقال آخر ليس بحجة(@)(@@)(@@)(@@) $ 3393 عبد الله بن ميمون عن زهير بن منقذ لا يدرى من هو ولا شيخه(@)(@@)(@@)(@@) $ 3394 عه(@)(@@) عبد الله بن نافع بن أبي العمياء عن ربيعة بن الحارث قال البخاري لم يصح حديثه(@)(@@)(@@)(@@) $ 3395 عبد الله بن نافع مولى ابن عمر أخو أبوي بكر وعمر ضعفوه(@)(@@)(@@)(@@) $ 3396 م عه(@)(@@) عبد الله بن نافع الصائغ عن مالك وثق وقال البخاري في حفظه شيء وقال أحمد بن حنبل لم يكن بذاك في الحديث(@)(@@)(@@)(@@) $ 3397 د س ق(@)(@@) عبد الله بن نجي الحضرمي عن علي قال البخاري فيه نظر(@)(@@)(@@)(@@) $ 3398 ع(@)(@@) عبد الله بن أبي نجيح المكي المفسر ثقة قال القطان لم يسمع التفسير كله من مجاهد بل كله عن القاسم عن أبي بزة وقد ذكره الجوزجاني فيمن رمي بالقدر هو وزكريا بن إسحاق وعبد الحميد ابن جعفر وإبراهيم بن نافع وابن إسحاق وعمر بن أبي زائدة وشبل بن عباد وابن أبي ذئب وسيف 
ms172	 بن سليمان PageV01P360(@)(@@)(@@)(@@) $ 3399 عبد الله بن نصر الأنطاكي الأصم عن وكيع منكر الحديث(@)(@@)(@@)(@@) $ 3400 عبد الله بن نصر شيخ يروي عنه حاتم بن اسماعيل المدني مجهول(@)(@@)(@@)(@@) $ 3401 عبد الله بن نعيم الدمشقي عن الضحاك بن عرزب تكلم فيه(@)(@@)(@@)(@@) $ 3402 عبد الله بن هارون بن أبي علقمة الفروي له عن القعنبي وغيره مناكير(@)(@@)(@@)(@@) $ 3403 عبد الله بن هارون الحجازي شيخ معاصر للثوري لا يعرف(@)(@@)(@@)(@@) $ 3404 عبد الله بن هارون الصوري عن الأوزاعي لا يعرف بخبر كذب في أخلاق الأبدال(@)(@@)(@@)(@@) $ 3405 عبد الله بن هارون البجلي عن ليث بن أبي سليم فيه لين(@)(@@)(@@)(@@) $ 3406 عبد الله بن هانئ بن أبي عبلة عن أبيه أدركه أبو حاتم متهم بالكذب(@)(@@)(@@)(@@) $ 3407 ت س(@)(@@) عبد الله بن هانئ أبو الزعراء عن ابن مسعود قال البخاري لا يتابع عليه(@)(@@)(@@)(@@) $ 3408 عبد الله بن هبة الله الحلي البزاز عن سبط الخياط أبي محمد ونحوه مات سنة تسع وستماية ظهر أن السماع لأخ له قديم(@)(@@)(@@)(@@) $ 3409 عبد الله بن هشام الدستوائي عن أبيه قال أبو حاتم متروك الحديث(@)(@@)(@@)(@@) $ 3410 عبد الله بن أبي هند روى عنه أبو مالك الأشجعي قال خ حديثه منكر(@)(@@)(@@)(@@) $ 3411 عبد الله بن واقد أبو قتادة الحراني مشهور بالحديث والزهد قال أبو حاتم ذهب حديثه وقال الدارقطني وغيره ضعيف وأما أحمد فقال ما به بأس وربما أخطأ وقال البخاري تركوه PageV01P361(@)(@@)(@@)(@@) $ 3412 عبد الله بن واقد قال عباس عن ابن معين روى عن أبي الزبير وقتادة ليس بشيء ذكره العقيلي(@)(@@)(@@)(@@) $ 3413 ق(@)(@@) عبد الله بن واقد أبو رجاء الخراساني عن ابن عجلان قال ابن عدي مظلم الحديث(@)(@@)(@@)(@@) $ 3414 د ت س(@)(@@) عبد الله بن الوليد العدني صدوق سمع الثوري قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 3415 عبد الله بن وهب شيخ عراقي روى عنه أبو سعيد الأشج فأما(@)(@@)(@@)(@@) $ 3416 عبد الله بن وهب المصري الإمام ثقة ثبت تناكد ابن عدي بذكره في الكامل وكذا ذكر(@)(@@)(@@)(@@) $ 3417 عبد الله بن يوسف التنيسي وهو ثقة حجة(@)(@@)(@@)(@@) $ 3418 
ms173	 عبد الله بن وهب النسوي عن يزيد بن هارون قال ابن حبان دجال يضع الحديث(@)(@@)(@@)(@@) $ 3419 عبد الله بن وهب من رؤس الحرورية زائغ(@)(@@)(@@)(@@) $ 3420 عبد الله بن يحيى الألهاني شيخ لبقية والوليد بن مسلم صدوق إن شاء الله تعالى(@)(@@)(@@)(@@) $ 3421 عبد الله بن يحيى بن موسى السرخسي لقيه ابن عدي واتهمه(@)(@@)(@@)(@@) $ 3422 عبد الله بن يحيى الثقفي التوأم عن ابن أبي مليكة ضعف(@)(@@)(@@)(@@) $ 3423 عبد الله بن يحيى المؤدب عن اسماعيل بن عياش بخبر كذب في فضل معاوية لا يعرف PageV01P362(@)(@@)(@@)(@@) $ 3424 عبد الله بن يحيى البرلسي قال الدارقطني مجهول قلت صالح الحديث سمع حيوة بن شريح(@)(@@)(@@)(@@) $ 3425 عبد الله بن يزيد بن آدم الدمشقي تابعي قال أحمد أحاديثه موضوعة(@)(@@)(@@)(@@) $ 3426 عبد الله بن يزيد بن تميم السلمي أخو عبد الرحمن وثقه دحيم وقال أحمد ثنا عنه الوليد بن مسلم بمناكير(@)(@@)(@@)(@@) $ 3427 عبد الله بن يزيد أبو عقيل قال الجوزجاني أحاديثه منكرة(@)(@@)(@@)(@@) $ 3428 عبد الله بن يزيد بن قنطس عن أنس قال البخاري متهم بأمر عظيم وأما أحمد بن حنبل ويحيى بن معين فوثقاه(@)(@@)(@@)(@@) $ 3429 عبد الله بن يزيد مولى المنبعث صدوق قال الدارقطني يعتبر به(@)(@@)(@@)(@@) $ 3430 عبد الله بن يزيد بن الحداني عن سليمان بن زريق عن الحسن بحديث منكر ولا يعرف(@)(@@)(@@)(@@) $ 3431 عبد الله بن يزيد البكري عن عكرمة بن عمار ضعفه أبو حاتم(@)(@@)(@@)(@@) $ 3432 عبد الله بن يزيد محمش النيسابوري عن هشام بن عبيد الله كذاب(@)(@@)(@@)(@@) $ 3433 عبد الله بن يسار تابعي هو ابن أبي نجيح ثقة مر قال ابن الجوزي قال يحيى كان من رؤس الدعاة إلى القدر(@)(@@)(@@)(@@) $ 3434 عبد الله بن يعقوب الكرماني شيخ ابن محمش ضعيف PageV01P363(@)(@@)(@@)(@@) $ 3435 عبد الله بن يعلى بن مرة الثقفي عن أبيه ضعفه غير واحد(@)(@@)(@@)(@@) $ 3436 د س(@)(@@) عبد الله بن يونس تابعي لم يرو عنه غير يزيد بن الهاد(@)(@@)(@@)(@@) $ 3437 عبد الله أبو منير عن سعد بن أبي ذباب قيل لم يصح حديثه(@)(@@)(@@)(@@) $ 3438 د(@)(@@) عبد الله الهمداني عن 
ms174	 أبي موسى لا يعرف كنيته أبو موسى(@)(@@)(@@)(@@) $ 3439 عبد الله البناني شيخ لمعن بن عيسى لا يعرف(@)(@@)(@@)(@@) $ 3440 عه(@)(@@) عبد الله أبو بكر الحنفي عن أنس لا يعرف حسن الترمذي حديثه(@)(@@)(@@)(@@) $ 3441 ق(@)(@@) عبد الأعلى بن أعين الكوفي قال الدارقطني ليس بثقة(@)(@@)(@@)(@@) $ 3442 عبد الأعلى بن حسين بن ذكوان عن أبيه قال العقيلي منكر الحديث(@)(@@)(@@)(@@) $ 3443 عبد الأعلى بن سليمان بن الهيثم بن جميل بخبر في أيام البيض كذب لعله الآفة وعنه ثقة(@)(@@)(@@)(@@) $ 3444 عه(@)(@@) عبد الأعلى بن عامر الثعلبي عن ابن الحنفيه ضعفه أحمد وأبو زرعة(@)(@@)(@@)(@@) $ 3445 ع(@)(@@) عبد الأعلى بن عبد الأعلى السامي صدوق قال ابن سعد لم يكن بالقوي قلت ورمي بالقدر(@)(@@)(@@)(@@) $ 3446 عبد الأعلى بن عبد الله روى عنه موسى بن يعقوب الزمعي لا يعرف وهو بن أبي فروة PageV01P364(@)(@@)(@@)(@@) $ 3447 عبد الأعلى بن عبد الرحمن شيخ لبقية لا يعرف والخبر منكر متنه من حفظ على أمتي أربعين حديثا بعثه الله فقيها رواه أحمد بن صالح المصري ثنا المسيب بن واضح ثنا بقية(@)(@@)(@@)(@@) $ 3448 عبد الأعلى بن محمد عن يحيى بن سعيد ضعفه أبو الفتح الأزدي(@)(@@)(@@)(@@) $ 3449 ق(@)(@@) عبد الأعلى بن أبي ا لمساور الكوفي عن الشعبي ضعفوه جدا(@)(@@)(@@)(@@) $ 3450 عبد الأعلى القرشي عن عطاء قال ابن حبان لا يجوز أن يحتج به(@)(@@)(@@)(@@) $ 3451 عبد الأعلى الكوفي مولى جعفي مجهول(@)(@@)(@@)(@@) $ 3452 د(@)(@@) عبد الأكرم بن أبي حنيفة عن أبيه وعنه شعبة لا يعرف(@)(@@)(@@)(@@) $ 3453 عبد الأول بن عبد الله المصري المعلم أبو نعيم يروي عن ابن وهب بلايا هو آفتها وعنه محمد بن عبد الله بن عرس(@)(@@)(@@)(@@) $ 3454 عبد الباقي بن قانع الحافظ قال الدارقطني كان يحفظ لكنه كان بخطئ ويصر وقال البرقاني هو عندي ضعيف ورأيت البغداديين يوثقونه وقال أبو الحسن بن الفرات حدث به أختلاط قبل موته بسنتين PageV01P365(@)(@@)(@@)(@@) $ 3455 عبد الباقي بن محمد بن ناقيا الشاعر مشهور متهم بالزندقة(@)(@@)(@@)(@@) $ 3456 عبد الجبار بن أحمد الهمذاني القاضي روى عن أبي الحسن ابن سلمة القطان وغيره ولكنه 
ms175	 من رؤوس الاعتزال نسأل الله السلامة(@)(@@)(@@)(@@) $ 3457 عبد الجبار بن أحمد السمسار عن علي بن المثنى الطهوي بموضوع في فضل علي وعنه ابن المظفر(@)(@@)(@@)(@@) $ 3458 عبد الجبار بن الحجاج الخراساني قال الأزدي متروك(@)(@@)(@@)(@@) $ 3459 عبد الجبار بن سعيد المساحقي عن مالك قال العقيلي له مناكير(@)(@@)(@@)(@@) $ 3460 ت(@)(@@) عبد الجبار بن العباس الشبامي الكوفي عن أبي إسحاق شيعي وثقه أبو حاتم وغيره وأما أبو نعيم الملائي فقال لم يكن في بالكوفة أكذب منه(@)(@@)(@@)(@@) $ 3461 ت(@)(@@) عبد الجبار بن عمر الأيلي عن نافع وغيره وهاه أبو زرعه وغيره(@)(@@)(@@)(@@) $ 3462 عبد الجبار بن عمر العطاردي والد أحمد قال العقيلي في حديثه وهم كثير(@)(@@)(@@)(@@) $ 3463 عبد الجبار بن عمارة الأنصاري شيخ للواقدي مجهول(@)(@@)(@@)(@@) $ 3464 عبد الجبار بن مسلم عن الزهري واه(@)(@@)(@@)(@@) $ 3465 عبد الجبار بن المغيره تابعي لم يصح حديثه قاله البخاري(@)(@@)(@@)(@@) $ 3466 عبد الجبار بن نافع عن أيوب بن موسى لا يعرف PageV01P366(@)(@@)(@@)(@@) $ 3467 م عه(@)(@@) عبد الجبار بن وائل بن حجر تابعي قال ابن معين ثقة لم يسمع من أبيه وقال غيره سمع منه قلت لم يخرج له مسلم إلا عن اخيه علقمة عن أبيه(@)(@@)(@@)(@@) $ 3468 د س(@)(@@) عبد الجبار بن الورد المكي عن عطاء ثقة قال البخاري يخالف في بعض حديثه(@)(@@)(@@)(@@) $ 3469 عبد الجبار بن وهب روى عنه يحيى بن ايوب المقابري لا يدرى من هو(@)(@@)(@@)(@@) $ 3470 د س(@)(@@) عبد الجليل بن عطية عن شهر صدوق قال البخاري ربما يهم(@)(@@)(@@)(@@) $ 3471 عبد الحافظ بن عبد المنعم الشروطي روى عن الضياء لا يعتمد على ما اثبت للناس من سنة تسعين وستماية وبعدها فانه خبط(@)(@@)(@@)(@@) $ 3472 عبد الحكم بن عبد الله القسملي عن انس ضعفه غير واحد(@)(@@)(@@)(@@) $ 3473 عبد الحكم بن عبد الله عن الزهري شامي ضعيف(@)(@@)(@@)(@@) $ 3474 عبد الحكم بن ميسرة عن ابن جريج عن أبي الزبير عن جابر ما رئي رسول الله صلى الله عليه وسلم مادا رجليه بين اصحابه و هذا منكر(@)(@@)(@@)(@@) $ 3475 عبد الحكيم عن سفيان الثوري روى حديثا موضوعا 
ms176	(@)(@@)(@@)(@@) $ 3476 عبد الحكم شيخ لبكر بن سالم لا يدرى من هو(@)(@@)(@@)(@@) $ 3477 عبد الحكيم بن عبد الله بن أبي فروة المدني قال الدارقطني مقل يعتبر به PageV01P367(@)(@@)(@@)(@@) $ 3478 ت(@)(@@) عبد الحكيم بن منصور الواسطي عن عبد الملك بن عمير تركوه(@)(@@)(@@)(@@) $ 3479 عبد الحكيم البصري كاتب بن أبي عروبة قال الدارقطني يترك(@)(@@)(@@)(@@) $ 3480 عبد الحميد بن إبراهيم أبو تقي الحمصي قال أبو حاتم ليس بشيء روى عن عفير بن معدان(@)(@@)(@@)(@@) $ 3481 خ م(@)(@@) عبد الحميد بن أبي أويس أبو بكر المدني ثقة أخطأ الأزدي حيث قال كان يضع الحديث والأزدي كثير التخبيط قد ذكر الدارقطني أبا بكر عبد الحميد فقال حجة(@)(@@)(@@)(@@) $ 3482 عبد الحميد بن أمية عن أنس قال الدارقطني لا شيء(@)(@@)(@@)(@@) $ 3483 عبد الحميد بن بحر بصري كوفي الأصل عن مالك قال ابن حبان كان يسرق الحديث(@)(@@)(@@)(@@) $ 3484 ت ق(@)(@@) عبد الحميد بن بهرام صاحب شهر وثقه ابن معين وقال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 3485 م عه(@)(@@) عبد الحميد بن جعفر المدني صدوق قال أبو حاتم لا يحتج به ضعفه القطان وفيه قدرية(@)(@@)(@@)(@@) $ 3486 ت ق(@)(@@) عبد الحميد بن حبيب بن أبي العشرين كاتب الأوزاعي وثقه أحمد وضعفه دحيم(@)(@@)(@@)(@@) $ 3487 ت(@)(@@) عبد الحميد بن الحسن الهلالي عن قتادة وثقه ابن معين وضعفه أبو زرعة و الدارقطني(@)(@@)(@@)(@@) $ 3488 عبد الحميد بن حميد بن شفي شيخ لغنجار مجهول(@)(@@)(@@)(@@) $ 3489 عبد الحميد بن ربيع اليمامي لا يعرف PageV01P368(@)(@@)(@@)(@@) $ 3490 عبد الحميد بن زيد العمي فيه جهالة وحديثه منكر(@)(@@)(@@)(@@) $ 3491 ق(@)(@@) عبد الحميد بن سالم عن أبي هريرة من لعق العسل لا يعرف والخبر منكر(@)(@@)(@@)(@@) $ 3492 عبد الحميد بن السري عن عبيد الله بن عمر لا يعرف وحديثه كذب(@)(@@)(@@)(@@) $ 3493 س ق(@)(@@) عبد الحميد بن سلمة شيخ لعثمان البتي لا يعرف(@)(@@)(@@)(@@) $ 3494 د س(@)(@@) عبد الحميد بن سنان تابعي يجهل لكنه وثق(@)(@@)(@@)(@@) $ 3495 ت ق(@)(@@) عبد الحميد بن سليمان اخو فليح عن أبي الزناد ضعفوه جدا(@)(@@)(@@)(@@) $ 3496 عبد الحميد بن سوار عن إياس بن معاوية 
ms177	 ضعفه أبو زرعة(@)(@@)(@@)(@@) $ 3497 عبد الحميد بن صفوان أبو السوار عن هشيم مجهول(@)(@@)(@@)(@@) $ 3498 د(@)(@@) عبد الحميد بن عبد الله بن عبد الله بن عمر كتاب في الصدقه لم يرو عنه غير يحيى بن سعيد(@)(@@)(@@)(@@) $ 3499 س(@)(@@) عبد الحميد بن عبد الله المخزومي ما روى عنه سواى حبيب بن أبي ثابت(@)(@@)(@@)(@@) $ 3500 د(@)(@@) عبد الحميد بن عبد الواحد ما أعرف أحد ا روى عنه سوى بندار(@)(@@)(@@)(@@) $ 3501 عبد الحميد بن قدامة عن انس في الفاغيه قال البخاري لا يتابع عليه PageV01P369(@)(@@)(@@)(@@) $ 3502 عبد الحميد بن يحيى تفرد عنه عبد الصمد بن سليمان(@)(@@)(@@)(@@) $ 3503 عبد الحميد بن يوسف عن ميمون بن مهران قال الازدي ليس بشيء(@)(@@)(@@)(@@) $ 3504 خ(@)(@@) عبد الحميد أبو يحيى الحماني وثقه ابن معين وضعفه أحمد وابن سعد(@)(@@)(@@)(@@) $ 3505 عبد الحميد بن السقا عن جابر مجهول(@)(@@)(@@)(@@) $ 3506 د(@)(@@) عبد الحميد مولى بني هاشم عن امه مجهول(@)(@@)(@@)(@@) $ 3507 عبد الخالق بن زيد بن واقد عن أبيه قال النسائي ليس بثقة(@)(@@)(@@)(@@) $ 3508 عبد الخالق بن فيروز الجوهري قال المفضل لم يكن موثوقا به وقال ايضا تكلموا فيه(@)(@@)(@@)(@@) $ 3509 ق(@)(@@) عبد الخالق عن انس لا يعرف(@)(@@)(@@)(@@) $ 3510 د(@)(@@) عبد الخبير عن أبيه عن جده ثابت بن قيس قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 3511 ت(@)(@@) عبد ربه بن بارق الحنفي عصري هشيم قال أحمد ما به بأس وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3512 عبد ربه بن الحكم الطائفي مجهول(@)(@@)(@@)(@@) $ 3513 عبد ربه بن سليمان شيخ لاسماعيل بن عياش مجهول(@)(@@)(@@)(@@) $ 3514 خ م(@)(@@) عبد ربه بن نافع أبو شهاب الحناط صدوق وليس بذاك الحافظ(@)(@@)(@@)(@@) $ 3515 دس(@)(@@) عبد ربه ويقال عبد رب شيخ تفرد عنه قتادة PageV01P370(@)(@@)(@@)(@@) $ 3516 - عبد الرحمن بن إبراهيم القاص عن ابن المنكدر ضعفه الدارقطني(@)(@@)(@@)(@@) $ 3517 - عبد الرحمن بن إبراهيم الكرماني قال ابن معين ليس بشيء(@)(@@)(@@)(@@) $ 3518 - عبد الرحمن بن إبراهيم الراسبي عن مالك حديثه موضوع(@)(@@)(@@)(@@) $ 3519 - عبد الرحمن بن إبراهيم المديني عن العلاء بن عبد الرحمن وثق وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3520 - عبد الرحمن 
ms178	 بن إبراهيم الدمشقي عن الليث لا يعرف وحديثه موضوع(@)(@@)(@@)(@@) $ 3521 - عبد الرحمن بن الأخنس لا يعرف(@)(@@)(@@)(@@) $ 3522 - عبد الرحمن بن أحمد القزويني عن أبي سلمة القطان ضعيف(@)(@@)(@@)(@@) $ 3523 - عبد الرحمن بن آدم قال ابن معين لا أعرفه(@)(@@)(@@)(@@) $ 3524 - م عه / عبد الرحمن بن إسحاق المدني عباد قال أحمد صالح الحديث وقال أبو داود ثقة إلا أنه قدري وقال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 3525 - د ت / عبد الرحمن بن إسحاق الواسطي أبو شيبة عن النعمان بن سعد ضعفوه PageV02P375 -(@)(@@)(@@)(@@) $ 3526 عبد الرحمن بن إسحاق أبو عبد الكريم قال الجوزجاني كان غير محمود في الحديث(@)(@@)(@@)(@@) $ 3527 - عبد الرحمن بن أشرس عن مالك مجهول وقال ابن الجنيد ليس به بأس وقال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 3528 عبد الرحمن بن آمين عن أنس مدني قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 3529 - عبد الرحمن بن أبي أمية المكي عن بعض التابعين قال أبو حاتم لا يعرف(@)(@@)(@@)(@@) $ 3530 - عبد الرحمن بن آلستن قال ابن ماكولا له عن سعيد ما لا يتابع عليه(@)(@@)(@@)(@@) $ 3531 - س ق / عبد الرحمن بن بديل بن ميسرة عن أبيه ضعيف وقواه أبو داود(@)(@@)(@@)(@@) $ 3532 - عبد الرحمن بن بشير الدمشقي عن ابن إسحاق قال أبو حاتم منكر الحديث(@)(@@)(@@)(@@) $ 3533 - د / عبد الرحمن بن أبي بكر عن جابر لا ندري من هو(@)(@@)(@@)(@@) $ 3534 - ت ق / عبد الرحمن بن أبي بكر المليكي عن عمه قال البخاري ذاهب الحديث وقال ابن معين ضعيف(@)(@@)(@@)(@@) $ 3535 - ق / عبد الرحمن بن بهمان ما روى عنه سوى عبد الله بن عثمان بن خثيم PageV02P376(@)(@@)(@@)(@@) $ 3536 - د ت ق / عبد الرحمن بن البيلماني تابعي مشهور قال أبو حاتم لين وذكره ابن حبان في الثقات وقال الدارقطني ضعيف(@)(@@)(@@)(@@) $ 3537 - د ت ق / عبد الرحمن بن ثابت بن ثوبان صدوق رمي بالقدر وقال أحمد لم يكن بالقوي(@)(@@)(@@)(@@) $ 3538 - عبد الرحمن بن ثابت بن الصامت عن أبيه لينه البخاري(@)(@@)(@@)(@@) $ 3539 - عبد الرحمن بن ثابت عن أنس لا يعرف(@)(@@)(@@)(@@) $ 3540 - خ عه / عبد الرحمن بن ثروان الأودي شيخ لشعبة قال أحمد لا 
ms179	 يحتج به ولينه أبو حاتم ووثقه ابن معين(@)(@@)(@@)(@@) $ 3541 - عبد الرحمن بن جابر بن عبد الله وثقوه إلا ابن سعد فقال فيه ضعف(@)(@@)(@@)(@@) $ 3542 - عبد الرحمن بن جعفر البردعي عن أحمد بن محمد الموقفي ضعفهما الدارقطني(@)(@@)(@@)(@@) $ 3543 - عبد الرحمن بن حاتم المرادي ضعيف(@)(@@)(@@)(@@) $ 3544 - عه / عبد الرحمن بن الحارث بن عياش عن عمرو بن شعيب قال أحمد متروك وقال ابن نمير لا أقدم على ترك حديثه وقال أبو حاتم شيخ وقال آخر صدوق PageV02P377(@)(@@)(@@)(@@) $ 3545 - عبد الرحمن بن الحارث عن بقية قال ابن عدي يسرق الحديث(@)(@@)(@@)(@@) $ 3546 - عبد الرحمن بن حازم أبو حازم عن مجاهد لا يعرف(@)(@@)(@@)(@@) $ 3547 - عبد الرحمن بن الحارث الغنوي عن محمد بن جرير قال ابن أبي الفوارس لا يعتمد عليه(@)(@@)(@@)(@@) $ 3548 - د ت ق / عبد الرحمن بن حبيب بن أردك عن عطاء صدوق فيه لين قال س منكر الحديث(@)(@@)(@@)(@@) $ 3549 - عبد الرحمن بن حجوة عن عمرو بن رؤبة لم يثبت حديثه(@)(@@)(@@)(@@) $ 3550 - م عه / عبد الرحمن بن حرملة الأسلمي عن ابن المسيب قال ابن معين صالح وقال يحيى القطان ضعيف وقال أبو حاتم لا يحتج به ولينه البخاري(@)(@@)(@@)(@@) $ 3551 - د س / عبد الرحمن بن حرملة عن ابن مسعود قال البخاري لا يصح حديثه(@)(@@)(@@)(@@) $ 3552 - عبد الرحمن بن حريز معاصر لهشيم لا يدرى من هو(@)(@@)(@@)(@@) $ 3553 - عبد الرحمن بن الحسن أبو مسعود الموصلي الزجاج قال أبو حاتم لا يحتج به سمع معمرا(@)(@@)(@@)(@@) $ 3554 - عبد الرحمن بن الحسن بن عبيد الأسدي الهمذاني قال صالح بن أحمد الحافظ ادعى الرواية عن ابن ديزيل فذهب علمه وقال القاسم بن أبي صالح يكذب(@)(@@)(@@)(@@) $ 3555 - عبد الرحمن بن حماد الطلحي التيمي شيخ العيشي قال أبو حاتم منكر الحديث PageV02P378 -(@)(@@)(@@)(@@) $ 3556 - خ ت / عبد الرحمن بن حماد الشعيثي صدوق مشهور قال أبو حاتم ليس بالقوي(@)(@@)(@@)(@@) $ 3557 - س / عبد الرحمن بن خالد بن ميسرة تابعي ما روى عنه إلا ابنه محمد(@)(@@)(@@)(@@) $ 3558 - عبد الرحمن بن خالد بن نجيح عن أبيه وغيره قال ابن يونس منكر الحديث 
ms180	(@)(@@)(@@)(@@) $ 3559 - عبد الرحمن بن خضير عن طاوس ضعفه أبو حفص الفلاس(@)(@@)(@@)(@@) $ 3560 - عبد الرحمن بن داود الواعظ حدث بالمغرب سنة ثمان وستمائة عن أبي الوقت بالبخاري اتهمه الأبار(@)(@@)(@@)(@@) $ 3561 - د ت ق / عبد الرحمن بن دينار أبو يحيى القتات وقيل اسمه دينار وقبل زاذان مختلف في الإحتجاج به وقال النسائي ليس بالقوي(@)(@@)(@@)(@@) $ 3562 - د ت ق / عبد الرحمن بن رافع التنوحي عن عبد الله بن عمر وله حديث وهو منكر(@)(@@)(@@)(@@) $ 3563 - عه / عبد الرحمن بن أبي الرجال مشهور وثقة جماعة وبعضهم لم يحتج به(@)(@@)(@@)(@@) $ 3564 - عبد الرحمن بن رزين عن محمد بن يزيد قال الدارقطني مجهول(@)(@@)(@@)(@@) $ 3565 - عبد الرحمن بن زاذان عن أحمد بن حنبل وعنه أبو بكر ابن شاذان فذكر حديثا موضوعا PageV02P379(@)(@@)(@@)(@@) $ 3566 - د ت ق / عبد الرحمن بن زياد بن أنعم الإفريقي مشهور جليل ضعفه ابن معين والنسائي وقال الدارقطني ليس بالقوي ووهاه أحمد(@)(@@)(@@)(@@) $ 3567 - عبد الرحمن بن زبيد بن الحارث اليامي قال البخاري منكر الحديث(@)(@@)(@@)(@@) $ 3568 - ت ق / عبد الرحمن بن زيد بن أسلم عن أبيه ضعفه أحمد والدارقطني(@)(@@)(@@)(@@) $ 3569 - عبد الرحمن بن زيد الوراق مشهور قال ابن النجار حدث بأجزاء لم يسمعها(@)(@@)(@@)(@@) $ 3570 - ق / عبد الرحمن بن سعد بن عمار بن سعد القرظ في حديثه نكارة(@)(@@)(@@)(@@) $ 3571 - م عه / عبد الرحمن بن أبي سعيد الخدري وثقه مسلم والنسائي ولينه ابن سعد(@)(@@)(@@)(@@) $ 3572 - ق / عبد الرحمن بن سلم عن عطية بن قيس إسناده مضطرب(@)(@@)(@@)(@@) $ 3573 - م س / عبد الرحمن بن سلمان عن ابن الهاد وعدة قال أبو حاتم مضطرب الحديث وقال البخاري فيه نظر وقال النسائي وغيره ليس بالقوي(@)(@@)(@@)(@@) $ 3574 - عبد الرحمن بن سلمة عن أبي عبيدة تابعي لا يكاد يعرف PageV02P380(@)(@@)(@@)(@@) $ 3575 - د س / عبد الرحمن بن سلمة أو مسلمة عن عمه تابعي لا يعرف(@)(@@)(@@)(@@) $ 3576 - ق / عبد الرحمن بن سليمان بن أبي الجون عن يحيى بن سعيد الأنصاري قال أبو حاتم لا يحتج به(@)(@@)(@@)(@@) $ 3577 - خ م / عبد الرحمن بن سليمان بن الغسيل رأى سهلا وثق 