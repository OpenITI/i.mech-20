ms385	 جهاندار تااین جهان را %~% به بهروزی و خرمی بگذرانی(@)(@@) 46 به عز اندرون ملک تو بینهایت %~% به ملک اندرون عز تو جاودانی(@)(@@) 47 ترا عدل نوشیروانست و از تو %~% غلامانت ار تاج نوشیروانی(@)(@@) 48 جز این یک قصیده که از من شنیدی %~% هزاران قصیده شنو مهرگانی PageV1P244(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 همی سراید چنگ آن نگار چنگسرای %~% نبید باید و خالی ز گفتگوی سرای(@)(@@) 2 غذای روح سماعست و آن شخص نبید %~% خوشا نبید کهن با سماع طبع گشای(@)(@@) 3 نبید تلخ و سماع حزین و روی نکو %~% بدین سه چیز بود مردم جهان رارای(@)(@@) 4 مرا طبیب جهاندیده این سه فرموده ست %~% تو دوستان گرانمایه را همی فرمای(@)(@@) 5 نبید تلخ و سماع حزین به کف کردم %~% ز بهر روی نکومانده ام دل اندروای(@)(@@) 6 کجا شد آن صنم ماهروی سیمین تن %~% کجا شد آن بت عاشق پرست مهر لقای(@)(@@) 7 به مجلس از کف اوخوردمی نبید بزرگ %~% بیاد خدمت درگاه میر بار خدای(@)(@@) 8 امیر عالم عادل محمد محمود %~% خدایگان جهان خسرو جهان آرای(@)(@@) 9 مظفری که به اندیشه کین تو اندتوخت %~% ز پیل آهن یشک و ز شیر آهن خای(@)(@@) 10 ز گور مانی تدبیر او تباه کند %~% فسون و جادویی جادوان مای به مای(@)(@@) 11 اگر نمای چاکران ملک %~% فسون کنند فسون چون زهیر روح گزای(@)(@@) 12 به پیش بینی آن بیند او که دیده نیند %~% منجمان به سطرلاب آسمان پیمای(@)(@@) 13 زهی تن هنر و چشم نیکنامی را %~% چو روح درخور وهمچون دو دیده اندربای(@)(@@) 14 ترا همایون دارد پدر به فال که تو %~% ستوده طلعتی و صورت تو روح فزای(@)(@@) 15 اگر تو نیستی از هر شهی همایون تر %~% نشان رایت تو نیستی خجسته همای(@)(@@) 16 کسی که گوید من چون توام به فضل و هنر %~% سبک خرد بود و یافه گوی و ژاژ درای(@)(@@) 17 کسی که خواهد تا فضل تو بپوشاند %~% گو آفتاب درفشنده 
ms386	 رابه گل اندای(@)(@@) 18 به تست علم عزیز و به تست عدل مکین %~% به تست جود متین و به تست فضل بپای(@)(@@) 19 همی ستود نداند ترا چنان که تویی %~% زبان مادح و اندیشه ملوک ستای(@)(@@) 20 ز بوی خلق تو اطراف گوزگانان را %~% همی شناخت ندانم ز دست عنبر سای(@)(@@) 21 امیر زیبی و شایی به تخت ملک و به تاج %~% همی بباش مر این هر دو را تو زیب و تو شای(@)(@@) 22 چنانکه گوی سعادت ربوده ای ز ملوک %~% زخسروان جهان گوی مملکت بربای(@)(@@) 23 یکی ستاره بر آمدبه نام دولت تو %~% زهی ستاره به وقت آمدی بر آی برآی(@)(@@) 24 دلیر باش و به بازوی اوشجاعت کن %~% بلندباش وبه شمشیر او جهان پیرای(@)(@@) 25 بدان مقام رسانش که رای بر در او %~% سپید مهره زند بر نوای رویین نای(@)(@@) 26 ایا به رادی برکنده خانمان نیاز %~% چو شاه شرق به شمشیر تیز خانه رای(@)(@@) 27 همیشه آرزوی من به گیتی این بوده ست %~% که من به حضرت تو یا بمی به خدمت جای(@)(@@) 28 مرا خدای بدین آرزو اجابت کرد %~% چه آرزوست که من آن نیافتم ز خدای(@)(@@) 29 به جایگاهی کانجا ملوک روی نهند %~% همی نهم من و یاران من به خدمت پای(@)(@@) 30 من این کرامت و فضل از خدای دانم و بس %~% بر این کرامت یارب تو هر زمان بفزای(@)(@@) 31 ز بهر تقویت دین ایزدی با تیغ %~% ز روی ملک همی زنگ کفر و کین بزدای(@)(@@) 32 همیشه تا که نبوده ست چون دو رویکدل %~% چنان کجا نبود مرد پارسا چو مرای(@)(@@) 33 همیشه تا دل میخواره سماع پرست %~% شود گشاده به آوای رود رود سرای(@)(@@) 34 امیر باش و جهاندار باش و خسرو باش %~% جهان گشای و ولی پرور و عدوفرسای(@)(@@) 35 زمانه را به تو امنیتست وآسایش %~% زمانه تا که بپاید تو با زمانه بپای(@)(@@) 36 همه به رادی کوش 
ms387	 و همه به دانش یاز %~% همه به علم بکوش و ماهمه به فضل گرای(@)(@@) 37 همیشه طالع مسعود تو همایون باد %~% چنانکه رایت میمون تو ز بال همای PageV1P245(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دل من همی جست پیوسته یاری %~% که خوش بگذراند بدو روزگاری(@)(@@) 2 شنیدم که جوینده یابنده باشد %~% به معنی درست آمداین لفظ باری(@)(@@) 3 بتی چون بهاری به دست من آمد %~% که چون اوبتی نیست اندربهاری(@)(@@) 4 بتی چون گل تازه کاندر مه دی %~% زرخسار اوگل توان چد کناری(@)(@@) 5 چه قدش چه پیراسته زاد سروی %~% چه رویش چه آراسته لاله زاری(@)(@@) 6 به کام دل خویش یاری گزیدم %~% که دارد چو یار من امروز یاری(@)(@@) 7 بدین یار خود عاشقی کرد خواهم %~% کزین خوشتر اندرجهان نیست کاری(@)(@@) 8 دل او را همی خواستاورا سپردم %~% همین به که من کردم از هر شماری(@)(@@) 9 چرا دل دهم جز بدو چون ندارم %~% پس از خدمت شه جز او غمگساری(@)(@@) 10 شه عالم عادل داد گستر %~% که بی چاکر او نیابی دیاری(@)(@@) 11 ولیعهد محمود غازی محمد %~% مهین خسروی برترین شهریاری(@)(@@) 12 به هر فضلی اندر جهان گشته پیدا %~% چو تابان مهی بر سر کوهساری(@)(@@) 13 گراز تو کسی کش ندیده ست پرسد %~% که «دانی ملک را» چه گویی تو باری(@)(@@) 14 کریمست و آزاده و تازه رویی %~% جوانست و آهسته و با وقاری(@)(@@) 15 خوی و سیرت و راه و آیین و رسمش %~% پسندیده نزدیک هر هوشیاری(@)(@@) 16 جهان پیش او روز تا شب به خدمت %~% میان بسته بر گونه پیشکاری(@)(@@) 17 نه اصل و بزرگیش را منتهایی %~% نه احسان و کردار او را کناری(@)(@@) 18 نه هنگام زربخشی اوراست صبری %~% نه هنگام کوشش مراو را قراری(@)(@@) 19 به کار اندرون داهی پیش بینی %~% به خشم اندرون صابر بردباری(@)(@@) 20 به یک جابر آمیخته حلم و صبرش %~% قراریست پنداری اندر قراری(@)(@@) 21 به هر مادحی مل بخشد جهانی %~% به هر 
ms388	 زایری سیم بخشد به باری(@)(@@) 22 تهی نیست از بخشش او سرایی %~% چو از لشکر شاه ایران حصاری(@)(@@) 23 سخاوت میان بخیلی و دستش %~% بر آورده از روی و آهن جداری(@)(@@) 24 هر ابری که بگذشت بر مجلس او %~% ز شرم کف اوشود چون غباری(@)(@@) 25 غمی نیست ار با کفش بر نیاید %~% به صد سال شمسی ز در یا بخاری(@)(@@) 26 حصاری و از ترکش او خدنگی %~% مصافی و از موکب او سواری(@)(@@) 27 چو نالی سبک بگذراند به تیری %~% گران شاخ از سالخورده چناری(@)(@@) 28 زده خشت زخم خدنگیش ناید %~% نیاید زده مورچه فعل ماری(@)(@@) 29 هر آن کس که بیخواب شد ز نهیبش %~% نخوابد سبک دیگر ازکو کناری(@)(@@) 30 نگر تا تو اسفندیارش نخوانی %~% که آید ز هر مویش اسفندیاری(@)(@@) 31 به هر کاری او را کند بخت یاری %~% جهان را نیاید چنو بختیاری(@)(@@) 32 ز اقبال سلطان بر او حاسدان را %~% شد از اشک هر چشم چون کفته ناری(@)(@@) 33 از این نیکوییهای او دشمنان را %~% به سربود در هر زمانی خماری(@)(@@) 34 ز خوبی که ایزد بد و داد خواهد %~% همانا یکی نیست این از هزاری(@)(@@) 35 زهی خسروی کاین همه روشنایی %~% زرای تو گیرد همی نوبهاری(@)(@@) 36 ز شادی که از تو جهان راست نونو %~% نبینم همی در جهان سوکواری(@)(@@) 37 شکار شهان بیشتر مرغ باشد %~% شکار تو شیرست و نکو شکاری(@)(@@) 38 چه کردار داری که در گوش هر کس %~% ز شکر تو بینم همی گوشواری(@)(@@) 39 مرا جامه خاصه خویش دادی %~% چه باشدمرا بیش از این افتخاری(@)(@@) 40 چو طاووس رنگین مرا جلوه دادی %~% به طاووسی چون شکفته بهاری(@)(@@) 41 قبای تو جز تاجداری نپوشد %~% نهادی مرا پایه تاجداری(@)(@@) 42 فزودی مرا زین قبا تاقیامت %~% جمالی و جاهی به هر پود و تاری(@)(@@) 43 بزرگی و جاه و جمال وشرف را %~% زبانیست گوینده زین هر چهاری(@)(@@) 44 به ناکرده خدمت دهی حق 
ms389	 خدمت %~% که دیده ست هرگز چوتو حقگزاری(@)(@@) 45 همی تا ز بهر مثل بر زبانها %~% در آید که هر اشتر و مرغزاری(@)(@@) 46 چنان چون بگویند اندر مثلها %~% که پهلوی هر گل نشسته ست خاری(@)(@@) 47 ترا باد هر جا که بنهند تختی %~% عدو را بود هر کجا هست داری(@)(@@) 48 زخوبان و از ریدکان سرایی %~% به قصر تو هر خانه ای قند هاری PageV1P246(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 ای باد بهاری خبر از یار چه داری %~% پیغام گل سرخ سوی باده کی آری(@)(@@) 2 هم ز اول روز از تو همی بوی خوش آید %~% گویی همه شب سوخته ای عود قماری(@)(@@) 3 زلف بت من داشته ای دوش در آغوش %~% نی نی تو هنوز این دل و این زهره نداری(@)(@@) 4 خورشید بر آن ماه زمین تافت نیارد %~% دانم که تو باز لفک او جست نیاری(@)(@@) 5 تو با گل و سوسن زن و و من با لب و زلفش %~% ور برگ بود بنشین تا بوسه شماری(@)(@@) 6 من دوش به کف داشتم آن زلف همه شب %~% وز دولب او کرده ام امروز نهاری(@)(@@) 7 ای فرخی این قصه و این حال چه چیزست %~% پیش ملک شرق همی خواب گزاری(@)(@@) 8 شاه ملکان میر محمد که مر اوراست %~% از آمل و از ساری تازان سوی باری(@)(@@) 9 شاهی که ترا نعمت صد ساله بریزد %~% گر بر در او نیم زمان پای فشاری(@)(@@) 10 شادی و خوشی خواهی رو خدمت او کن %~% تا عمر به شای و به خوشی بگذاری(@)(@@) 11 چون خدمت او کردی و او در تو نگه کرد %~% فربه بشوی از نعمت او گر چه نزاری(@)(@@) 12 افزون دهداز طمع و ز اندیشه توبر %~% تخمی که در آن خدمت فرخنده بکاری(@)(@@) 13 ای بار خدای ملکان ای ملک راد %~% ای آنکه همی حق همه کس بگزاری(@)(@@) 14 گویی که خدا از پی آن داد ترا ملک %~% تا کار تبه 
ms390	 کرده هر کس بنگاری(@)(@@) 15 یک دست تو ابرست و دگردست تو دریا %~% هرگز نتوانی که نبخشی و نباری(@)(@@) 16 رسم شعرا ازتو هزار و دو هزارست %~% آخر ده هزاری شوی و بیست هزاری(@)(@@) 17 فردا همه کار تو دگر خواهد گشتن %~% امروز میندیش که در اول کاری(@)(@@) 18 خوابم نبرد تابه سرای تو نبینم %~% چون کوه فرو ریخته دینار نثاری(@)(@@) 19 از دولت سلطان و ز نیکو نیت تو %~% این کار شود ساخته و محکم و کاری(@)(@@) 20 گیتی همه همواره ترا خواهد گشتن %~% زان گونه که هرگز به دگر کس نسپاری(@)(@@) 21 آن روز خورم خوش که درین خابه ببینم %~% زین پنج هزاری رده ترکان حصاری(@)(@@) 22 وین درگه و این دشت پر از خیمه و پر میر %~% شهر از بنه ایشان پر مهد و عماری(@)(@@) 23 از روم رسیده بر تو هدیه رومی %~% و آورده ز بلغار ترا باز شکاری(@)(@@) 24 شاهان جهان روی نهاده بردر تو %~% وز درد شده روی بداندیش تو تاری(@)(@@) 25 من شاد همی گردم ز آنجای بدانجای %~% وین شعر به آواز برآورده چو قاری(@)(@@) 26 بوالحارث ما آمده و ساخته با هم %~% چون طوطیک و شاری و چون طوطی و ساری(@)(@@) 27 در خانه تو دولت و درخانه تو ملک %~% در خانه آن کس که جز این خواهد زاری(@)(@@) 28 وآن کس که تر از دل و جان دوست ندارد %~% چون سنگ ز بیقدری و چون خاک ز خواری(@)(@@) 29 تو اسی تو باروحی کالوی و فخری () %~% بدخواه تو مانده پی بی باره و داری ()(@)(@@) 30 ارجو که ترا تا ابد الد هر به هر کار %~% توفیق بود ز ایزد و ازدولت یاری(@)(@@) 31 آزاده خداوندی و خوشخوی کریمی %~% بافر شهنشاهی وبا زیب سواری(@)(@@) 32 پردانش و پر خیری و پر فضلی و پر شرم %~% باسایه و با سنگی و با حلم و وقاری(@)(@@) 33 آن چیست ز کردار بسنده که ترا 
ms391	 نیست %~% آن چیست زنیکویی و خوبی که نداری(@)(@@) 34 از دانش و فضل تو سخنهاست به هر جا %~% اندازه ندارد هنرو فضل تو باری(@)(@@) 35 برخور تو ازین دانش و برخور تو ار این فضل %~% برخور تو از ین جشن و از این فصل بهاری(@)(@@) 36 شاهی کن و شادی کن و آنکن که تو خواهی %~% ای داده ترا هر چه بباید همه باری(@)(@@) 37 شادی ز بتان خیزد در پیش بتاندار %~% با جعد سمر قندی و با زلف بخاری(@)(@@) 38 همواره بود در بر تو هر شب و هر روز %~% ترکی که کند طره او غالیه باری PageV1P247(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 دل من خواهی و اندوه دل من نبری %~% اینت بیرحمی و بیمهری و بیداد گری(@)(@@) 2 تو بر آنی که دل من ببری دل ندهی %~% من بدین پرده نیم گرتو بدین پرده دری(@)(@@) 3 غم توچند خورم و انده تو چند برم %~% نخورم تا نخوری و نبرم تانبری(@)(@@) 4 هر زمانگویی بر دو رخ و بر عارض من %~% قمرست و سمن تازه خوشبوی طری(@)(@@) 5 چه کنم گرتو به عارض چو شکفته سمنی %~% چه کنم گر تو به رخ همچو دو هفته قمری(@)(@@) 6 بیش از آن باشد کز عشق تومن موی شدم %~% سال تا سال خروش و ماه تا ماه گری(@)(@@) 7 شمع افروخته بینم چو به تو در نگرم %~% شمع ناسوخته بینی چو به من درنگری(@)(@@) 8 بندگی خواهی از من بخر از میر مرا %~% بنده تو نشوم تا تو ز میرم نخری(@)(@@) 9 خاصه آن بنده که ماننده من بنده بود %~% مدح گوینده و داننده الفاظ دری(@)(@@) 10 سال تا سال همه مدحت او نظم کنم %~% نکند میر دل از مهر چنین بنده بری(@)(@@) 11 میر ابو احمد شهزاده محمد ملکی %~% حق شناسنده و معروف به نیکو سیری(@)(@@) 12 گر گهر باید او هست امیری گهری %~% ور هنر بادی اوهست امیری هنری(@)(@@) 13 ای ملکزاده امیریکه 
