ms61	 إلى بيعة % و لو مشى حولا إلي المسيح % PageV01P224 البحر : - 1(@)(@@) % نفسي فداؤك كيف تصبر طائعا % عن فتية مثل البدور صباح % % 2(@)(@@) % حنت نفوسهم إليك فأعلنوا % % نفسا يقد مسالك الأرواح % 3(@)(@@) % و غدوا لراحهمو ذكرك بينهم % % أذكى وأطيب من نسيم الراح % 4(@)(@@) % فإذا جرت حببا على أقداحهم % جعلوك ريحانا على الأقداح % % PageV01P225 البحر : - 1(@)(@@) % و هواكلو كان الملام صلاحا % % ما زاد قلبي لوعة وجراحا % % 2(@)(@@) % أحبب إلي بليلة أفنيتها % % حتى الصباح تفكها ومزاحا % % 3(@)(@@) % ما كان لو مدت علي جناحها % % للوصل ما غنى الحمام وناحا % % 4(@)(@@) % باتت يداي له وشاحا لازما % حتى كسا الليل الصباح وشاحا % % 5(@)(@@) % قم فانف بالكاسات سلطان الكرى % % واجعل مطايا الراح منك الراحا % % 6(@)(@@) % لا تأسفن على الصباح فحسبنا % % ضوء السوالف والسلاف صباحا % % 7(@)(@@) % فض النديم ختامهافكأنما % % فض الختام عن العبير ففاحا % % 8(@)(@@) % لم أدر إذ حث السقاة كؤوسها % % أكواكبا يحملن أم أقداحا % 9(@)(@@) % إني منحت ذوي الصلاح من الورى % % بغضا فلست إليهم مرتاحا % % 10(@)(@@) % من لي بدير كنت مشغوفا به % % لما عرفت الراح عاد رياحا % % PageV01P226 البحر : - 1(@)(@@) % قم بنا قبل غرة الإصباح % و قيام السقاة بالأقداح % 2(@)(@@) % نتمشى إلى النعيم الذي في % % ه صلاح الأجساد والأرواح % 3(@)(@@) % بيت ريف ترود عينك فيه % % بين بيض الطلى وبيض الفقاح % 4(@)(@@) % و تلاقي الجسوم في خلع من % % ه رقاق على الجسوم ملاح % 5(@)(@@) % من سراويل سندس تملأ العي % % ن بهاء ومن غلالة داح % 6(@)(@@) % و إذا كان مئزر الكفل النه % % د عدوا لطرفك الطماح % 7(@)(@@) % فهنيئا لك الصدور وما في % % هن من ظاهر الجمال المباح % 8(@)(@@) % و الخدود التي نقلن من الور % % د إلى عصفرية التفاح % 9(@)(@@) % و مجال النطاق حين تجيل % % الطرف في جنة ومجرى الوشاح % 10(@)(@@) % و إذا ما خلافحسبك ما في % % جدره من غرائب الأشباح % PageV01P227 11(@)(@@) % من قيان برزن ليس على الأب % % صار في نهب حبها من جناح % 12(@)(@@) % و كماة تهز بيض سيوف % غير مرهوبة و سمر رماح % 13(@)(@@) % فإذا ما صقلت جسمك فيه % % بأكف النعيم 
ms62	 صقل الصفاح % 14(@)(@@) % ملت من ربعه إلى رغد العي % % ش غدوا موصلا برواح % 15(@)(@@) % تتروى من الصبوح و تفتض % نسيم الرياض قبل الصباح % 16(@)(@@) % و أحق الأيام بالقصف يوم % جنيت مزنه جنوب الرياح % PageV01P228 البحر : - 1(@)(@@) % أعاد الحيا سكر النبات وقد صحا % % و جدد من عهد الربيع الذي انمحى % % 2(@)(@@) % و بات زناد البرق يقدح ناره % % على الآسحتى اهتز فيه وقدحا % % 3(@)(@@) % كأن حمام الروض نشوان كلما % % ترنم في أغصانه أو ترجحا % % 4(@)(@@) % ولاذ نسيم الروض من طول سيره % % حسيرا بأطراف الغصون مطلحا % % 5(@)(@@) % فباشر ورد الأقحوان مشرفا % و صافح ورد الباقلاء مجنحا % % 6(@)(@@) % و حلل من أزراره النورفاغتدى % % كلفظ جليب هم أن يتفصحا % % 7(@)(@@) % و شق على لون الخدود شقائقا % رأته عيون السرب أبهى وأصلحا % % 8(@)(@@) % أراك نصال النبل قبل اتضاحه % % و حل خراج النبل حين تفتحا % % PageV01P229 البحر : - 1(@)(@@) % إن عن لهو أو سنح % فاغد إلى اللهو ورح % 2(@)(@@) % رضيت أن أحظى بعز % اليأس والعز منح % % 3(@)(@@) % و صاحب يقدح لي % % نار السرور بالقدح % % 4(@)(@@) % فرحت مطوي المنى % % لا أزجر الطير الروح % % 5(@)(@@) % و لا أقول لامرىء % ضن بمال أو سمح % % 6(@)(@@) % و لا أرى من صبوة % نهج التقى و إن وضح % % 7(@)(@@) % تصافح الكأس يدي % % ما ارتد خطب أو صفح % % 8(@)(@@) % في روضة قد لبست % % من لؤلؤ الطل سبح % % 9(@)(@@) % يألفني حمامها % % مغتبقا ومصطبح % % 10(@)(@@) % أوقظه بالعزفأو % % يوقظنيإذا صدح % % PageV01P230 11(@)(@@) % و الجو في ممسك % طرازه قوس قزح % % 12(@)(@@) % يبكي بلا حزن كما % % يضحك من غير فرح % % 13(@)(@@) % كم جامح ممتنع % خليته لما جمح % % 14(@)(@@) % و كم عذول ناصح % قلت لهو قد نصح % % 15(@)(@@) % أقصر فمن رام صلا % % ح العيش بالكأس صلح % % PageV01P231 البحر : - 1(@)(@@) % خطرات هي العلاو ارتياح % و غدو إلى الوغى ورواح % 2(@)(@@) % و أياد تحثهن عدات % مثل ما حثت السحاب الرياح % 3(@)(@@) % يا حسام الإلهيا جبل الدن % % ياو يا بحرها الذي يستماح % 4(@)(@@) % ففداك الهمام والملك المر % % جو للبذل والفتى الجحجاح % 5(@)(@@) % خطأ قولنا لمثلكيفدي % % ه ذوو النقص 
ms63	 والنفوس الشحاح % 6(@)(@@) % كيف تفدي الربا الشواهق أم كي % % ف يساوى بغمرة ضحضاح % 7(@)(@@) % بك تمضي الظبى وتجري المذاكي % % و يصول الردى ويدمى السلاح % 8(@)(@@) % سفر مسفر لك السعد فيه % % قاده اليمنو انتحاه النجاح % 9(@)(@@) % في خميس كالليل وجهك مصبا % % ح تجلى ضياه بل إصباح % 10(@)(@@) % هاك منك العدو أرقم يسري % % في سراه إليهحين متاح % PageV01P232 11(@)(@@) % عبد نعماك منذ شهرين ثاو % فاعتلاق يحيا به أو سراح % PageV01P233 البحر : - 1(@)(@@) % وباكية ليلها كله % % تحاكي الصباح بمصباحها % % 2(@)(@@) % بصيرة ليل ولكنها % % ضريرتهعند إصباحها % % 3(@)(@@) % نجز لإصلاحها رأسها % % فإفسادها عند إصلاحها % % PageV01P234 البحر : - 1(@)(@@) % الكأس تهدي إلى شرابها فرحا % فما لهذا الفتى صفرا من الفرح % 2(@)(@@) % يصفر إن صب ساقيه لنا قدحا % كأنما دمه ينصب في القدح % PageV01P235 البحر : - 1(@)(@@) % أنخت في حانة أترجة % و حبذا حانتها من مناخ % 2(@)(@@) % ثم اطرحنا الدين في بيتها % % حتى انسلخنا منه أي انسلاخ % 3(@)(@@) % تصافح الخمر به نفسها % % و تزرع النسل بها في السباخ % % 4(@)(@@) % كل سميع في الهوى مبصر % أعمى عن الرشد أصم الصماخ % 5(@)(@@) % حتى إذا الشمس بها آذنت % % خيامها الصفر بحل الأواخ % 6(@)(@@) % راحوا على الراحو قد بدلوا % % مشي الفرازين بمشي الرخاخ % % PageV01P236 البحر : - 1(@)(@@) % وقائع مثل ما بدأت تعود % و خيل ما تحط لها لبود % 2(@)(@@) % و فتيان تقيتهم دروع % مضاعفة و صبرهم عتيد % 3(@)(@@) % و تعرين أسفار الأعادي % % تمائمه إذا ارتاع الحديد % 4(@)(@@) % و أيام على الإسلام بيض % و هن على العدا حمر وسود % 5(@)(@@) % تفتح زهرة الآمال فيها % % فتوح لا يقد لها بريد % 6(@)(@@) % يخبر عن طراد يتقيه % % كرى الأعداءفهو له طريد % 7(@)(@@) % و مبرقة الحتوفإذا أسالت % دماء الشيب شاب لها الوليد % 8(@)(@@) % يبيت جلادها شرقا وغربا % حديثا تقشعر له الجلود % 9(@)(@@) % و لا إحجام إلا أن تكفي % % عن البيضالحياة أو الخدود % 10(@)(@@) % خطا الذرب الأصم إلى سمند % و قعقعة الحديد لها حديد % PageV01P237 11(@)(@@) % أيرهب جانب الأعداء ميلا % و سيف الدولة الركن الشديد % 12(@)(@@) % و قاد الخيل قبا يقتضيها % % ذخيرة جهدهاأو يستزيد % 13(@)(@@) % فأرسلها 
ms64	 على الصفصاف يخفي % % سنا أوضاحها عنه الكديد % 14(@)(@@) % و زارت أرض خرشنة رعالا % فكادت أرض خرشنة تميد % 15(@)(@@) % و جزن على الصعيد مبرقعات % براقعهن ما نسج الصعيد % 16(@)(@@) % و خرت في قرى جيحان تردى % % بجائحة عليهاأو ترود % 17(@)(@@) % و باتت توقد النيرانفيها % % و سيان الكواكب والوقود % 18(@)(@@) % و سحن بجانبي سيحان حتى % % رجعن وفجه المعمور بيد % 19(@)(@@) % فأصبح وهو ورد الموج مما % % يفيض عليه نحر أو وريد % 20(@)(@@) % إذا خرت عليه رأيت بحرا % تخر عليه من بحر مدود % PageV01P238 21(@)(@@) % و أوردها الخليج وقد تساوت % بجمتها التهائم والنجود % 22(@)(@@) % و فوق للحصون سهام نار % يصاب بلفحها الغرض البعيد % 23(@)(@@) % إذا انتشرت على الجدران راقت % كما راقت من العصب البرود % 24(@)(@@) % إذا ركع القنا الخطي صلوا % % صلاة جل واجبها السجود % 25(@)(@@) % فما أبقيت إلا مخطفات % حمى الأخطاف منها والنهود % 26(@)(@@) % تساق إليه مثنى أو فرادى % % كما يهوي من السلك الفريد % 27(@)(@@) % و بيضك يا بن عبد الله تلقى % % سباياها الحسان كما تريد % 28(@)(@@) % تقد البيض في الهيجاء قدا % و تثنيها السوالف والقدود % 29(@)(@@) % أتاك وفي حشاه رياح روع % عواصف ما لهبتها ركود % 30(@)(@@) % بوجه غاض ماء الأرض عنه % % فليس بعائد ما اخضر عود % PageV01P239 31(@)(@@) % و رب ممنع حاولت منه % % فلم يمنعه معقله المشيد % 32(@)(@@) % ومشرقة لقاصدها صبوب % على قمم السحائب أو صعود % 33(@)(@@) % تحف بها شواهق شامخات % كما حفت بسيدها الجنود % 34(@)(@@) % كأن فوارع الشرفات منها % % نساء في ملاحفها قعود % 35(@)(@@) % أحطت بها الأسنة لامعات % فهن على ترائبها عقود % 36(@)(@@) % فأولدها قراعكو هي بكر % و لم تر قبلها بكر ولود % 37(@)(@@) % رأت أمثال صورتها حديدا % فكادتو هي راسية تميد % 38(@)(@@) % و مازالت جيادك طاويات % تقاد إلى العدوفتستقيد % 39(@)(@@) % ضربت بها الثغرين سدا % يؤيد ركنه رأي سديد % 40(@)(@@) % و أبت بهاو قد أحرزت مجدا % قناك عليهو البيض الشهود % PageV01P240 41(@)(@@) % طوالع بين إيماض وخرس % تمائمها البوارق والرعود % 42(@)(@@) % تلقين الثرى صما تساوى % % بهن الرمل والحجر الصلود % 43(@)(@@) % فطورا بالأرند لها طراد ؛ % و طورا بالخليج 
ms65	 لها ورود % 44(@)(@@) % و لما قابلت طرسوس غرا % محجلة تقابلها السعود % 45(@)(@@) % كففت شذاتهافارتد بأس % كدفاع الحريقو فاض جود % 46(@)(@@) % لقد شرفت بسؤددك القوافي % % و فاز المجد والحسب التليد % 47(@)(@@) % فيوم الحرب تطربك المذاكي ؛ % و يوم السلم يطربك النشيد % 48(@)(@@) % تحاسدت الملوكفليس تخبو % % ضغائنهاو لا تفنى الحقود % 49(@)(@@) % و أنت الدهر إنعاما وبؤسا % و ما للدهرنعلمهحسود % PageV01P241 البحر : - 1(@)(@@) % فتوحك ردت بهجة الملك سرمدا % % و أنت حسام الله فل بك العدا % % 2(@)(@@) % يحدث عنك المشرفي مجردا % و يثني عليك السمهري مسددا % 3(@)(@@) % أعاد وأبدى الفتح منك معودا % قراع العدا جار على ما تعودا % % 4(@)(@@) % و ممطر أرض الروم من دم أهلها % % سحابا إذا روى الثرى منه أحمدا % % 5(@)(@@) % تخالف فعل الغيث منهفكلما % % بدا العود مخضرا ثناه موردا % % 6(@)(@@) % سرى مخلقا في الله ديباج وجهه % % فذب عن الإسلام حتى تجددا % % 7(@)(@@) % يفلق بالضرب التريك وما حوى % % و يخرق بالطعن الدلاص المسردا % % 8(@)(@@) % فيا لك من يوم أحر عليهم % و أندى على الدين الحنيف وأبردا % % 9(@)(@@) % و رب محلى بالكواكب شاخص % شخصت إليهفانمحى وتأبدا % % 10(@)(@@) % فأعطاك ما تهوى وقلد أمره % % نجوم قنا أضحى بهن مقلدا % % PageV01P242 11(@)(@@) % مثلت له في مثل أركان طوده % و أسطرت فيه الجلمد الصلد جلمدا % % 12(@)(@@) % و صدر وراء السابري خرقته % % فكان ثقاف الرمح لما تأودا % % 13(@)(@@) % و أبيض رقراق السوابغ أرهجت % سنابكه حتى ثنا الجو أربدا % % 14(@)(@@) % تتابع يهفو فوقه كل طائر % إذا صافحته راحة الراح غردا % % 15(@)(@@) % و أشرق في رأد الضحى فكأنما % % تلاعب منه الشمس صرحا ممردا % % 16(@)(@@) % يزف نجوما ليس يمنع ضوءها % % تكاشف ليل النقع أن يتوقدا % % 17(@)(@@) % إذا ما رأتهن البطارق أنحسا % رآهن مجتاح البطارق أسعدا % % 18(@)(@@) % صدعت ببرق البيض صدر عجاجة % و قد أبرق المقدار فيه وأرعدا % % 19(@)(@@) % و أبت وقد أشربت ساحته دما % كأنك أشرقت الأسنة عسجدا % % 20(@)(@@) % لقد لبس الإسلام شرقا ومغربا % بسيف ابن عبد الله ظلا ممددا % % PageV01P243 21(@)(@@) % ثنى الخيل عن ماء الفرات صوادرا % فكان لها ورد الخليجين موردا % % 22(@)(@@) % يطير 
ms66	 على أرباض خرشنة بها % % لوافح يهتكن المنيف المشيدا % % 23(@)(@@) % حريقا يغشي الجدر حتى كأنما % % لبسن حبير الوشي مثنى وموحدا % % 24(@)(@@) % إذا الغرض المنصوب بات معصفرا % بطائر سهم منه أصبح أسودا % % 25(@)(@@) % فبات على البرج المطلكأنما % % يلاحظ منه فرقدا ثم فرقدا % % 26(@)(@@) % و بث السرايا حولها فتفرقت % كما بثت الريح الحيا فتبددا % % 27(@)(@@) % فبات مغذا في السلاحو موجفا % مغيرا عليهم في البلادو منجدا % 28(@)(@@) % يؤانس منهم كل ليث حفيظة % على الطرف وحشي الشمائل أغيدا % % 29(@)(@@) % كأن رماح الخط حول بيوتهم % % على صهوات الخيل درا مبددا % % 30(@)(@@) % عرضت على البيض الرقاق أسودهم % % و سقت المها حوا إليها وسهدا % % PageV01P244 31(@)(@@) % و قومت منهم جانبا لظهورهم % % و أشرفتهم بالمشرفية منشدا % % 32(@)(@@) % و أوردت حد السيف قمة لاون % لتمزج فيه سورة البأس بالندى % % 33(@)(@@) % أتاك يهز الروع أعضاء جسمه % % كما هز بالأمس الحسام المهندا % % 34(@)(@@) % يغض لديك الرعب أجفان عينه % % فإن هم أن يستغرق اللحظ أرعدا % % 35(@)(@@) % و رب حديد اللفظ واللحظ منهم % مثلت له فارتد أخرس أرمدا % % 36(@)(@@) % ذعرتهم غزوا دراكا فأصبحوا % % على البعد خفاق الحشا ومسهدا % % 37(@)(@@) % يظنون غربي السحاب كتيبة % تشرقو البرق الشآمي مطردا % % 38(@)(@@) % إذا الدولة الغراء سمتك سيفها % % لتبهجسماك الهدى ناصر الهدى % % 39(@)(@@) % ليهنك أن الروم ذل عزيزها % % فصارت مواليها بعزك أعبدا % % 40(@)(@@) % إذا قيل سيف الدولة اهتز عرشها % % و خرت ركوعا عند ذاك وسجدا % % PageV01P245 البحر : - 1(@)(@@) % م بودي لو ملكت ثني قيادي % % فأعتاض عن غي الهوى برشاد % 2(@)(@@) % تمادت دموعي يوم جدت بك النوى % % و للوم في أعقابهن تماد % % 3(@)(@@) % أقيمو حظي الهجر عند إقامتي % % و أرحلو الشوق المبرح زادي % % 4(@)(@@) % إذا ما حداه البرق يرتاح صبوة % إلى رائح من ذي الأراك و غاد % % 5(@)(@@) % و إن لم يكن عهد الشباب براجع % لديهو لا عصر الصبا بمعادص بودي لو ملكت ثني قيادي % % 6(@)(@@) % فأعتاض عن غي الهوى برشاد % تمادت دموعي يوم جدت بك النوى % % 7(@)(@@) % و للوم في أعقابهن تمادي % % أقيمو حظي الهجر عند إقامتي % % 8(@)(@@) % و أرحلو الشوق 
ms67	 المبرح زادي % % إذا ما حداه البرق يرتاح صبوة % 9(@)(@@) % إلى رائح من ذي الأراك و غادي % % و إن لم يكن عهد الشباب براجع % 10(@)(@@) % لديهو لا عصر الصبا بمعاد % و أخرى تحامى خلتي عند خلتي % % PageV01P246 11(@)(@@) % فسيان قربي عندها وبعادي % % و تعجب من ضن القريض وخبره % % 12(@)(@@) % على وشل لا ري فيه لصادي % % فما تعبي إلا لتجديد راحة % 13(@)(@@) % و لا سهري إلا لطول رقادي % % كليني إلى المهرية القود إنها % % 14(@)(@@) % ستأخذ من أيدي الخطوب قيادي % % و كل فتى أجدى علي فصاحبي ؛ % 15(@)(@@) % و كل بلاد أخصبت فبلادي % % و أقسم بالغمض الذي جاد موهنا % 16(@)(@@) % تحية مشتاق ورنة حادي % % لفقد الندى الربعي أوجدني الأسى % % 17(@)(@@) % و أفقدني عيشي ولين مهادي % % و وسدني أيدي الركابو طالما % % 18(@)(@@) % أقض لديها مضجعي ووسادي % % إذا أنا حاولت الأميرفإنما % % 19(@)(@@) % أحاول منه جنتي وعتادي % % حلللت بنادي الشأم لما أعاده % % 20(@)(@@) % علي بن عبد الله أكرم نادي % % أغرإذا امتدت يد الدهر كفها % % PageV01P247 21(@)(@@) % ببيض صفاح أو ببيض أيادي % % يروع الندى أمواله بنفادها % % 22(@)(@@) % و ما ريع مجد عنده بنفاد % إذا امتزج المعروف بالبشر عنده % % 23(@)(@@) % غدا الحمد ممزوجا له بوداد % رمى كل منآد القناة من العدا % % 24(@)(@@) % بخطب تحاماه الخطوب نآد % بجرد تثير النقع حتى كأنما % % 25(@)(@@) % تمزق منه البيض ثوب حداد % و بيض إذا اهتزت ترقرق ماؤها % % 26(@)(@@) % و هن إلى ماء النفوس صوادي % % وكل رديني أصم كأنما % % 27(@)(@@) % تروع منه الروع حية وادينهبودي لو ملكت ثني قيادي % % فأعتاض عن غي الهوى برشاد % 28(@)(@@) % تمادت دموعي يوم جدت بك النوى % % و للوم في أعقابهن تماد % % 29(@)(@@) % أقيمو حظي الهجر عند إقامتي % % و أرحلو الشوق المبرح زادي % % 30(@)(@@) % إذا ما حداه البرق يرتاح صبوة % إلى رائح من ذي الأراك و غاد % % PageV01P248 31(@)(@@) % و إن لم يكن عهد الشباب براجع % لديهو لا عصر الصبا بمعاد % 32(@)(@@) % و أخرى تحامى خلتي عند خلتي % % فسيان قربي عندها وبعادي % % 33(@)(@@) % و تعجب من ضن القريض وخبره % % على وشل لا ري 
ms68	 فيه لصاد % % 34(@)(@@) % فما تعبي إلا لتجديد راحة % و لا سهري إلا لطول رقادي % % 35(@)(@@) % كليني إلى المهرية القود إنها % % ستأخذ من أيدي الخطوب قيادي % % 36(@)(@@) % و كل فتى أجدى علي فصاحبي ؛ % و كل بلاد أخصبت فبلادي % % 37(@)(@@) % و أقسم بالغمض الذي جاد موهنا % تحية مشتاق ورنة حادي % % 38(@)(@@) % لفقد الندى الربعي أوجدني الأسى % % و أفقدني عيشي ولين مهادي % % 39(@)(@@) % و وسدني أيدي الركابو طالما % % أقض لديها مضجعي ووسادي % % 40(@)(@@) % إذا أنا حاولت الأميرفإنما % % أحاول منه جنتي وعتادي % % PageV01P249 41(@)(@@) % حلللت بنادي الشأم لما أعاده % % علي بن عبد الله أكرم ناد % % 42(@)(@@) % أغرإذا امتدت يد الدهر كفها % % ببيض صفاح أو ببيض أياد % % 43(@)(@@) % يروع الندى أمواله بنفادها % % و ما ريع مجد عنده بنفاد % 44(@)(@@) % إذا امتزج المعروف بالبشر عنده % % غدا الحمد ممزوجا له بوداد % 45(@)(@@) % رمى كل منآد القناة من العدا % % بخطب تحاماه الخطوب نآد % 46(@)(@@) % بجرد تثير النقع حتى كأنما % % تمزق منه البيض ثوب حداد % 47(@)(@@) % و بيض إذا اهتزت ترقرق ماؤها % % و هن إلى ماء النفوس صواد % 48(@)(@@) % وكل رديني أصم كأنما % % تروع منه الروع حية وادي % % 49(@)(@@) % تحف بجذلان العشيكأنه % % لدى طرد ما راح نصب طراد % 50(@)(@@) % و أغلب رحب الباع ينجده الردى % % إذا ما ارتدى في مأزق بنجاد % PageV01P250 51(@)(@@) % يبيتو حد السيف حل مبيته % % لديهو جفن العين حل سهاد % 52(@)(@@) % يصعد أنفاس العدوإذا ثنى % % إليه المنايا في ظبى وصعاد % 53(@)(@@) % أمام خميس يحجب الأفق بالقنا % % و يملأ أقطار الثرى بجياد % 54(@)(@@) % فمن عاد بالكيد الخفيفإنه % % يعود بيأس في الكريهة باد % 55(@)(@@) % سأعلم نفسي بالسماحة عالما % بأن بلاد التغلبي بلادي % % 56(@)(@@) % فدونكها تختال في كل مسمع % و تخطر في مكنون كل فؤاد % 57(@)(@@) % حبتك بريحان الكلامو إنما % % تجود برياه لكل جواد % 58(@)(@@) % بأطيب من طيب الرقاد لساهر % و أعذب من ريق الحبيب لصاد % % PageV01P251 البحر : - 1(@)(@@) % عذر العذول فراح فيك مساعدا % % و غدا الهوى لهوى المشوق معاهدا % % 2(@)(@@) % لما رأى للبين وجدا طارفا % منهو للهجران وجدا تالدا % % 3(@)(@@) % و 
ms69	 هوى يردد في محاجر مغرم % دمعا يكون على التلدد شاهدا % % 4(@)(@@) % ما ضر وسنى المقلتين لو انها % % ردت على الصب الرقاد الشاردا % % 5(@)(@@) % سفرت لهفأرته بدرا طالعا % و تمايلتفأرته غصنا مائدا % % 6(@)(@@) % و تبسمتفجلت له عن واضح % متألق يجلو الظلام الراكدا % % 7(@)(@@) % حتى إذا وقفت لتوديع النوى % % في موقف يدني الجوى المتباعدا % % 8(@)(@@) % نثرت رياح الشوق في وجناتها % % من نرجس فوق الخدود فرائدا % % 9(@)(@@) % لحظت ربيع ربيعنا آمالنا % % فغدت ركائبنا إليه قواصدا % % 10(@)(@@) % يحملن للحسن بن عبد الله في % % حر الحديث مآثرا ومحامدا % % PageV01P252 11(@)(@@) % بدع إذا نظم الثناء عقودها % % كانت لأعناق الملوك قلائدا % % 12(@)(@@) % قل للأمير أبي محمد الذي % % أضحى له المجد المؤثل حامدا % % 13(@)(@@) % أما الوفودفإنهم قد عاينوا % % قبل الربيع بك الربيع الوافدا % % 14(@)(@@) % يغشون من شرق البلاد وغربها % % بالموصل الزهراء أروع ماجدا % % 15(@)(@@) % خشعت له إن بان عنها صادرا % و تبسمت لما أتاها واردا % % 16(@)(@@) % فكأنما حل الربيع ربوعها % % فكسا السهولة والحزون مجاسدا % % 17(@)(@@) % أجرت يداه بها الندى فكأنما % % أجرى بساحتها الفرات الباردا % % 18(@)(@@) % ملك إذا ما كان بادىء نعمة % ألفيته عجلا إليها عائدا % % 19(@)(@@) % متفرد من رأيه بعزائم % لو أنهن طلعن كن فراقدا % % 20(@)(@@) % و خلائق كالروض في رأد الضحى % % تدني إليه أقاصيا وأباعدا % % PageV01P253 21(@)(@@) % يستنصرون على الزمانإذا اعتدى % % من لا يزال على الزمان مساعدا % % 22(@)(@@) % جذلان ليس على المكارم صابرا ؛ % يقظان ليس عن الكريهة حائدا % % 23(@)(@@) % خلق يسر الناظرين ومنطق % أبدا يفيد السامعين فوائدا % % 24(@)(@@) % و يد تعيد الماء في أقلامها % % جودا وتكسو الطرس نورا حاشدا % % 25(@)(@@) % إن ألبست تزهى بك الدنيافقد % % أصبحت للدنيا شهابا واقدا % % 26(@)(@@) % و بسطت آمال العفاة بهافقد % % حمدوا نداك مصادرا ومواردا % % 27(@)(@@) % و لبست مجدك بالصوارم والقنا % % و النجم ليس يراه إلا صاعدا % % 28(@)(@@) % أدركت ما حاولت منه وادعا % فعلوت من يرجو لحاقك جاهدا % % 29(@)(@@) % و غدوت ركنا في الخطوب لتغلب % و يدا لها في المكرمات وساعدا % % PageV01P254 البحر : - 1(@)(@@) % صنائع الله لا نحصي لها عددا ؛ % فنحمد الله حمدا دائما أبدا % % 2 
ms70	(@)(@@) % كفت يد الدهر إذ مدت إلى ملك % ما زال يبسط بالجدوى إلي يدا % % 3(@)(@@) % سلامة لبس المجد السرور بها % % من بعد ما حشيت أحشاؤه كمدا % % 4(@)(@@) % قل للعدو الذي أخفى عداوته % % و جاء يهدي إليه الحتف مجتهدا % % 5(@)(@@) % لو ساعدتك الليالي لم تدع وزرا % للمكرماتو لم تترك لها عضدا % % 6(@)(@@) % سم الشراب ليدني الحتف من أسد % إذ لم ينل بظباه الصارم الأسدا % % 7(@)(@@) % فنال منه كما نال النبيو قد % % أخفوا له في الشواء الغدر والحسدا % % 8(@)(@@) % يفدي الأمير المرجى معشر عجزوا % % عن عقد ما حلأو عن حل ما عقدا % % 9(@)(@@) % هي السعود التي كنا نؤملها % % ردت صروف الليالي عيشة رغدا % % 10(@)(@@) % تجددت لك أثواب الحياة بها % % فالبس برغم العدا أثوابها الجددا % % PageV01P255 البحر : - 1(@)(@@) % رد جفني بسافح الدمع يندى % % حين حييتهفأحسن ردا % % 2(@)(@@) % سمحت لي به السجوففما حا % % د عن العينو الركائب تحدى % % 3(@)(@@) % قمر كلما منحناه لحظا % منح اللحظ جلنارا و وردا % % 4(@)(@@) % هو كالريم ما تلفت جيدا ؛ % و هو كالغصن ما تأود قدا % % 5(@)(@@) % أناإن راح أو غدا لفراق % في رواح من الحمام ومغدى % % 6(@)(@@) % أيها البرقإن وجدت غماما % فاسق نجدا بهو من حل نجدا % % 7(@)(@@) % و تعهد تلك الخيامففيها % % ظبيات يفتكن بالصب عمدا % % 8(@)(@@) % بجديد الشؤبوب يصبح منه % % خلق الروض ناضرا مستجدا % % 9(@)(@@) % و مرب يخفي صنائع بيضا % حين يبدي لنا شمائل ربدا % % 10(@)(@@) % و كأن الوميض ينشر نورا % في أعاليه أو يفوف بردا % % PageV01P256 11(@)(@@) % عاد بحر السرور بالشيب جزرا % بعدما كان بالشبيبة مدا % % 12(@)(@@) % و أساء الزمان فيه إلينا % % حين أعطى القليل منه وأكدى % % 13(@)(@@) % كان كالبرق استتم خمودا % قبل أن يستتم للعين وقدا % % 14(@)(@@) % قد غنينا عن السحابو لو كا % % ن رحيقا بين السقاة وشهدا % % 15(@)(@@) % أصبحت راحة الأمير أبي الهي % % جاء أحلى جنى وأعذب وردا % % 16(@)(@@) % سيد يهدم الثراءو يبني % % سؤددا في حمى النجوم ومجدا % % 17(@)(@@) % غمرتنا له سجال عطايا % % كسجال الغمام أسرف جدا % % 18(@)(@@) % يضعف الشكر عن مكافاة ما نو % ول فيهاو ما أفاد 
ms71	 وأسدى % % 19(@)(@@) % و إذا عدت المناهل كانت % يده منهلا من العرف عدا % % 20(@)(@@) % سد منه وجه الخطوب فأضحى % % دون ما يتقي من الدهر سدا % % PageV01P257 21(@)(@@) % و كفى الوفد أن يحث المطايا % % بندى يغتدي إلى الوفد وفدا % % 22(@)(@@) % أنت سعد العفاةيا بن سعيد % و كفاهم بأن تطاول سعدا % % 23(@)(@@) % مستهل إذا تبسم برقا % و هو بين الخطوب قهقه رعدا % % 24(@)(@@) % بات يهدي إلي شوقا إلى بش % رك مستبشرا إلى الروض يهدى % % 25(@)(@@) % و بطيء في السير يسرع ومضا % مثل ما تسرع الأنامل عدا % % 26(@)(@@) % فتذكرت جد نعماك لما % % مرح الغيث في الرياض وجدا % % 27(@)(@@) % أنا جلد على الخطوبو لكن % لست فيها على جفائك جلدا % % 28(@)(@@) % أوسع الدهرمذ تعتبتذما % بعدما كنت أوسع الدهر حمدا % % 29(@)(@@) % فكأني أرى السرور عدوا % أتحداهو المدامة هندا % 30(@)(@@) % فلو اني ارتشفت ثغر حبيب % بارد الظلم لم أنل منه بردا % % PageV01P258 31(@)(@@) % أجفاء مرا و لم أجن ذنبا % فأجازى به بعادا وصدا % % 32(@)(@@) % و اطراحا يبيت يخلق صبرا % بين أحشاي أو يجدد وجدا % % 33(@)(@@) % حين جارت علي أحداث دهر % ليس يسلكن بيإذا سرت قصدا % % 34(@)(@@) % نوب لو علت شماريخ رضوى % % أوشكت أن تخر منهن هدا % % 35(@)(@@) % عرضتني على الحسامفأضحى % % كل عضو مني لحديه غمدا % % 36(@)(@@) % و كست مفرقي عمامة حرب % أرجوانية الذوائب تندى % % 37(@)(@@) % و إذا قست هجرك المر بالده % رو ما قد جناه كان أشدا % % 38(@)(@@) % أنا حر إذا انتسبتو لكن % جعلتني لك الصنائع عبدا % % 39(@)(@@) % لا أقول الغمام مثل أيادي % % كو لا السيف مثل عزمك حدا % % 40(@)(@@) % أنت أمضى من الحسام وأصفى % % من حيا المزن في المحولو أندى % % PageV01P259 البحر : - 1(@)(@@) % أقبل كالذود رعت شوارده % % أغر لا تكذبنا مواعده % % 2(@)(@@) % فظل يعتاد الحياة قائده % % و راح ظمآن الثرى يناشده % % 3(@)(@@) % حتى إذا ما ارتجست رواعده % % و أذهبت ببوقها عطارده % % 4(@)(@@) % عادت بما سر الثرى عوائده % و انتثرت في روضها فرائده % % 5(@)(@@) % و اطردت بصفوها موارده % % حتى ظننا حسنا يجاوده % % 6(@)(@@) % هو الحيا الربعيفاز قاصده % % مبذولة لوفده فوائده % % 7 
ms72	(@)(@@) % مصروفة عن خلة مكائده % % شاهدة بفضله مشاهده % % 8(@)(@@) % منظومة من شكره قلائده % % يحمده وليه وحاسده % % PageV01P260 البحر : - 1(@)(@@) % أما آن للملحي أن ينشر الودا % % و يطوي الجفاء المر والهجر والصدا % % 2(@)(@@) % أيغضب أن حليت كف ابن هاشم % سوار هجاج يقرض القلب لا الزندا % % 3(@)(@@) % و ما خلت ضعفان العراق يسومني % % لأمثاله ذما يسيرا ولا حمدا % % 4(@)(@@) % إذا الورد يوما انتحاه بكفه % حسبت قفاه روضة تنبت الوردا % % 5(@)(@@) % تجود سحاب الخافقات قذاله % فتوسعه هطلا ومن دمه تندى % % PageV01P261 البحر : - 1(@)(@@) % سهادي فيك أعذب من رقادي % % و غيي فيك أحسن من رشادي % % 2(@)(@@) % و إن حل الفراق عقود دمعي % % و بينت النوى ما في فؤادي % % 3(@)(@@) % فما زالت غوادي الدمع تبدي % % خفي الوجد للظعن الغوادي % % 4(@)(@@) % مها لو ملكت غرب التنائي % % لآثرت الدنو على البعاد % 5(@)(@@) % مريضات الجفونإذا انتحتنا % % بأسهمهاصحيحات الوداد % 6(@)(@@) % فمن نشوان من شوق طريف % أضفناه إلى شوق تلاد % 7(@)(@@) % و كم للبين من شوق طريف % أضفناه إلى شوق تلاد % 8(@)(@@) % و يوم لو ملكت قياد صبري % % به ألفيتني صعب القياد % 9(@)(@@) % نصرت على الهوى بالدمع فيه % % كما نصر الأمير على الأعادي % % 10(@)(@@) % فتى كالدهر يسعد من يوالي % % بأنعمهو يشقي من يعادي % % PageV01P262 11(@)(@@) % ترى الأقدار تنجد فيه نجدا % رحيب الباع يخطر في النجاد % 12(@)(@@) % سديد الرأي والرمح استقامت % طرائقه على طرق السداد % 13(@)(@@) % و أبيض في سواد الخطب يسري % % بعزم في سواد الليل هاد % 14(@)(@@) % بفرع من عدي بين ماضي % % غرار العزمأو واري الزناد % 15(@)(@@) % فلاح سناه في زمن بهيم % و ذاب نداه في سنة جماد % 16(@)(@@) % رميت ذوي العنادو قد تمادوا % % سفاها في العداوة والعناد % 17(@)(@@) % بجيش للمنايا فيه جيش % شديد البأس في النوب الشداد % 18(@)(@@) % إذا ماج الحديد ضحى عليه % % حسبت البربحرا ذا طراد % 19(@)(@@) % ببيض أخلصت حتى أقامت % % عمود الصبح في ظلم الدآدي % % 20(@)(@@) % و سمر سمرت فيهن زرق % هواد في النحور وفي الهوادي % % PageV01P263 21(@)(@@) % إذا صدرت عن الأجساد خيلت % مضمخة الصدور من الجساد % 22(@)(@@) % فألبست الخلافة ثوب عز 
ms73	 % غداة لبست قسطلة الجياد % 23(@)(@@) % و أنت مظفر في يوم سعد % محا إشراقه ظلم البلاد % 24(@)(@@) % رأينا الليث في غاب العوالي % % بهو الشمس في ظل الأيادي % % 25(@)(@@) % سلمت لنشر عارفة رفات % تعمو دفع نائبة نآد % 26(@)(@@) % فكم حلت بساحتك الأماني % % فلم يصدرن عن ورد ثماد % 27(@)(@@) % و كم قصدتك أبكار القوافي % % فلم يقنع نوالك باقتصاد % 28(@)(@@) % أرى من الحسين بلا امتنان % و إحسان الحسين بلا نفاد % 29(@)(@@) % خلال كلها روض أريض % قريب العهد من صوب العهاد % 30(@)(@@) % يفوز بها كريم عن كريم % و يحويها جواد عن جواد % PageV01P264 31(@)(@@) % زففت إليه من مدحي عروسا % معرسة الهوى في كل نادي % % 32(@)(@@) % بألفاظ عذبنفهن أشهى % % إلى الصادي من العذب البراد % 33(@)(@@) % سواد في بياض لاح حتى % % حسبناه بياضا في سواد % 34(@)(@@) % و إن بدأت مواهبهو عادت % % فمدحي عائد فيه وبادي % % PageV01P265 البحر : - 1(@)(@@) % صدودك علم النوم الصدودا % % و جدد للهوى عهدا جديدا % % 2(@)(@@) % مللتفعاد منك الجودمنعا % و لو أنصفت عاد المنع جودا % % 3(@)(@@) % أحل وداعنا عطفا جديدا % و أدنى بيننا وصلا بعيدا % % 4(@)(@@) % فمن خد يصافح فيه خدا ؛ % و من جيد يعانق فيه جيدا % % 5(@)(@@) % و ساجي الطرف ألبسه التصابي % % سخابا يلبس الجزع الجليدا % % 6(@)(@@) % أنازعه اللحاظ فإن تصدى % % لنا واش تنازعنا الصدودا % % 7(@)(@@) % فما ضيعت فيه الحلمإلا % لأحفظ في الهوى منه العهودا % % 8(@)(@@) % و ما انحلت عقود الدمع حتى % % تحلى من مدامعه عقودا % % 9(@)(@@) % سقى ربعا يجدد لي التصابي % % رباهو يخلق الصبر الجديدا % % 10(@)(@@) % حيا يزداد منه الروض حسنا % إذا ما ازداد بارقة وقودا % % PageV01P266 11(@)(@@) % فكم صعدن من أنفاس صب % فأروى من مدامعه الصعيدا % % 12(@)(@@) % تلقى الدهر آمالي بنجح % و عاد ذميم أيامى حميدا % % 13(@)(@@) % و قالألا إلى جود ابن فهد % فرحت من الليالي مستزيدا % % 14(@)(@@) % فتى يمسي بنائله مفيدا % و يصبح للمحامد مستفيدا % % 15(@)(@@) % ربيع الجود ما ينفك يبدي % % ربيعا من خلائقه مجودا % % 16(@)(@@) % مليء أن يزيد الأزد فخرا % طريفا أو يشيد لها تليدا % % 17(@)(@@) % رأى وجه العلى حسنا جميلا % فأصبح بالعلى 
ms74	 صبا عميدا % % 18(@)(@@) % ورد عطاه لي صفو العطايا % % فليس يمل وارده الورودا % % 19(@)(@@) % و مد عليه ظل السيفحتى % % تفيأ للعلى ظلا مديدا % % 20(@)(@@) % فأسعد جوده جدا شقيا % و أشقى بأسه جدا سعيدا % % PageV01P267 21(@)(@@) % تمل أبا الفوارس مشرقات % تعيد نحوسها أبدا سعودا % % 22(@)(@@) % و زادك وافد الآمال نشرا % يبشر بالعلى منك الوفودا % % 23(@)(@@) % فكم أنجزت من عدة لعاف % فأنجز للزمان بك الوعيدا % % 24(@)(@@) % متى شرفت غيرك بامتداحي % % لبست بمدحك الشرف العتيدا % % 25(@)(@@) % و كم لي فيك من عذراء بكر % تخال لحسنها عذراء رودا % % 26(@)(@@) % عرائس ما اجتلاها الطرفإلا % أباحته السوالف والخدودا % % 27(@)(@@) % بألفاظ يراها القلب بيضا % إذا ما عاينتها العين سودا % % 28(@)(@@) % مخلدة تطيل شجى الأعادي % % و تضمن عن معاليك الخلودا % % 29(@)(@@) % شغلت بها قلوب الناس طرا % فما تنفك نسخا أو نشيدا % % PageV01P268 البحر : - 1(@)(@@) % أأقحوانا أرته أم بردا % % غيداء يهتز عطفها غيدا % % 2(@)(@@) % رنت إليه بطرف خاذلة % ضعيفة الطرف تضعف الجلدا % % 3(@)(@@) % لو وجدت للفراق ما وجدا % % لافتقدت نومها كما افتقدا % % 4(@)(@@) % لا تلح صبا على صبابته % % و إن رأى الغي في الهوى رشدا % % 5(@)(@@) % فلم تزل للفراق غائلة % تلذ في المورد الذي وردا % % 6(@)(@@) % لو كفيوم الفراق أدمعنا % % الصبر كفينا الملام والفندا % % 7(@)(@@) % إلفان لم يألفا الصدودو لم % % يستبدلا من كراهما السهدا % % 8(@)(@@) % أذل عز النوى عزاءهما % % و بين البين منهما الكمدا % % 9(@)(@@) % سرنا بآمالنا إلى ملك % يسر بالآمل الذي وفدا % % 10(@)(@@) % مستيقظ الرأي والعزيمة ما % % استيقظ طرف الزمانأو رقدا % % PageV01P269 11(@)(@@) % فلاح روض النسيم مبتسما % و فاض بحر السماح مطردا % % 12(@)(@@) % مد ابن فهد إلى العفاة يدا % كفت من الدهر ساعدا ويدا % % 13(@)(@@) % فاض على آمليه منه حيا % أنفد آمالهم وما نفدا % % 14(@)(@@) % و الغيث والليث والهلال إذا % % أقمر بأسا ونجدة وندى % % 15(@)(@@) % خلائق منه غضة تركت % خلائق الدهر غضة جددا % % 16(@)(@@) % و همة ما تطأطأت همم % الأقوام إلا سمت به صعدا % % 17(@)(@@) % ما بعدت للعلاء منزلة % إلا أرته بعادها صعدا % % 18(@)(@@) % ناس من الجود ما يجود به % % و ذاكرا 
ms75	 منه كلما وجدا % % 19(@)(@@) % بذلت وجدي من الثناء لمن % يبذل في المكرمات ما وجدا % % 20(@)(@@) % أغر يغريه بالندى خلق % رد به الجود بعدما فقدا % % PageV01P270 21(@)(@@) % يحل ما يعقد الزمان ولا % % يحل صرف الزمان ما عقدا % % 22(@)(@@) % سلمت للمجد يا سلامة ما % % غرد حاد لرحلة وحدا % % 23(@)(@@) % قضيت حق الصيام مجتهدا % فرحت بالأجر منه منفردا % % 24(@)(@@) % و شرد الهم عن مواطنه % % عيد أعاد السرور إذ شردا % % 25(@)(@@) % فاسعد بدنيا بدت محاسنها % % منكفأعطتك عيشة رغدا % % 26(@)(@@) % و مدحة ثقفتفلم يدع % التثقيف ميلا بهاو لا أودا % % 27(@)(@@) % أماتت الحاسدين من أسف % و غادرت أوجه العدا ربدا % % PageV01P271 البحر : - 1(@)(@@) % كان جليدا فخانه جلده % و عاده بعد همة كمده % 2(@)(@@) % و أطلق الشوق أسر عبرته % % و هو أسير الفؤاد مضطهده % % 3(@)(@@) % أدمع ذاك الغزال فاض على ال % % خدينأم عقده وهت عقده % % 4(@)(@@) % قام يريد الوداع كالغصن % الريان يثني قوامه غيده % % 5(@)(@@) % و ذو الهوى غضة صبابته % % يكابد الشوق طبه كبده % % 6(@)(@@) % كم بين تلك السجوف من مقل % تبذل من دمعها الذي تجده % % 7(@)(@@) % و مستعير النضار من رشإ % لم يخطه لحظه ولا جيده % % 8(@)(@@) % لا يرتجى الصب برد غلته % % ما ضن عنه بريقه برده % % 9(@)(@@) % غدا ابن فهد و المجد شيمته % % و الجود والمجد لهوه ودده % % 10(@)(@@) % فتى فتى السماحمكتهل ال % % حلم ذكي الفؤاد متقده % % PageV01P272 11(@)(@@) % و مسرف الجود حين يقتصد ال % % غيثرفيق الفعال مقتصده % % 12(@)(@@) % كم من صباح سناه عزمته ؛ % و من أياد سماتهن يده % % 13(@)(@@) % مناقب ينطوي الحسود لها % % على جوىأو يميته حسده % % 14(@)(@@) % جرى فبذ الملوك حين جرى % % و فات أقصى مداهم أمده % % 15(@)(@@) % و كيف يرجو لحاقه ملك % يضيق عن رحب صدره بلده % % 16(@)(@@) % ربع كأن الربيع ألبسه % % غرائب النور يانعا خضده % % 17(@)(@@) % و منهل راق وردهفغدا % % يطرد عنا الإعدام مطرده % % 18(@)(@@) % و صارم لم يشمه ذو زرد % إلا تفرى عن حده زرده % % 19(@)(@@) % إذا ارتدى مهجة الكمي غدا % % مضرجا من جساده جسده % % 20(@)(@@) % يعضد قرما تقله يده % % طورا و طورا 
ms76	 يكنه عضده % % PageV01P273 21(@)(@@) % يلقى المنايا من راح يوعده % % حتما و يلقى النجاح من يعده % % 22(@)(@@) % صنيعه سائر يلوحو هل % % يخفى صنيع مدائحي برده % % 23(@)(@@) % وقف علينا الثناءما اطردت % حسنا معانيهو استوى أوده % % 24(@)(@@) % و كلما أخلقت بدائعه % جاءت إليه مجدة جدده % % PageV01P274 البحر : - 1(@)(@@) % يغض الطرف عن ورد الخدود % و يعرض عن مهفهفة القدود % 2(@)(@@) % مقر للعواذل بالتصابي ؛ % مقيم للوشاة على الجحود % 3(@)(@@) % أفاد به الهوى شوقا طريفا % يضرم لوعة الشوق التليد % 4(@)(@@) % و من جور الهوى أن راح يزجي % % مطايا البين في أثر الصدود % 5(@)(@@) % و فوق العيش بيض وكلتنا % % بأيام من الهجران سود % 6(@)(@@) % و غزلان تزيل الوشي صونا % لوشي جمالها الغض الجديد % 7(@)(@@) % إذا خطرت فما للقمص إلا % % مصافحة الروادف والنهود % 8(@)(@@) % هي الأيام إن جمحت عنادا % أذلت كل جبار عنيد % 9(@)(@@) % تنام وتطرق الأحداث يقظى % % و لوع الطيف بالركب الهجود % 10(@)(@@) % إليكفرب هاجرة أفاءتأيخشى الخطب ذو قلب حداد وخطب غياهبه حديد % % علي إفاءة الظل المديدسقط بيت % % PageV01P275 11(@)(@@) % إذا لم آو فيه إلى ابن فهد % فما آوي إلى ركن شديد % 12(@)(@@) % إذا حل الوفود له محلا % غدوا وحملهم عطن الوفود % 13(@)(@@) % أتيت مروعا يهتز جأشي % % فأبت محسدا يهتز عودي % % 14(@)(@@) % فعش للمجد تنجز فيه وعدا % من الجدوى وتصفح عن وعيد % PageV01P276 البحر : - 1(@)(@@) % وقانا الله فيك منى الحسود % ودافع عنك للكرم التليد % 2(@)(@@) % و مد عليك للنعماء ظلا % فإنا منك في ظل مديد % 3(@)(@@) % فصدتفلا عراك الهم فيه % % و لا عريت من ثوب السعود % 4(@)(@@) % دم ود المؤمل لو فداه % % بماء الوجهأو بدم الوريد % 5(@)(@@) % و كف لو يكون لها كفاء % وقيناها بديباج الخدود % 6(@)(@@) % فكان لها الشفاء بغير كلم % و كان بنا مباشرة الحديد % PageV01P277 البحر : - 1(@)(@@) % قسمت قلبي بين الهم والكمد % و مقلتي بين فيض الدمع والسهد % 2(@)(@@) % و رحت في الحسن أشكالا مقسمة % بين الهلال وبين الغصن والعقد % 3(@)(@@) % أرينني مطرا ينهل ساكبه % % من الجفون وبرقا لاح من برد % 4(@)(@@) % ووجنة لا يروي ماؤها ظمأ % % بخلا وقد 
ms77	 لذعت نيرانها كبدي % % 5(@)(@@) % فكيف أبقي على ماء الشؤونو ما % % أبقى الغرام على صبري ولا جلدي % % 6(@)(@@) % جرى ابن فهد فلم يدرك له أمد % و كل ذي سؤدد يجري إلى أمد % 7(@)(@@) % و حن للجود مهتزا ومنتصبا % كالرمح لم يؤت من ميل ولا أود % 8(@)(@@) % وعلم الدهر من أخلاقه خلقا % أذكى من الورد أو أحلى من الشهد % 9(@)(@@) % فالمجد منه علا مقرونة بعلى % % و الجود منه يد موصولة بيد % 10(@)(@@) % فضلان ما زال محسودا بنيلهما % % والبأس والجود مقرونان بالحسد % PageV01P278 11(@)(@@) % أغر لا صلف يزري بسؤدده % % بين الملوكو لا كبر على أحد % 12(@)(@@) % يريك من رقة الألفاظ منطقه % % در العقودغدت محلولة العقد % 13(@)(@@) % جعلته جنة من كل نائبة % و رحت من جوده في جنة الخلد % 14(@)(@@) % أبا الفوارس أحييت السماح لنا % % و قمت فيه قيام الروح للجسد % 15(@)(@@) % ما رمت إحصاء ما أوليت من حسن % إلا وزاد على الإحصاء والعدد % 16(@)(@@) % آثرت في الصوم تقوى الله مجتهدا % على هواك وبعت الغي بالرشد % 17(@)(@@) % فاسعد بعيد أعاد اللهو في سعة % و اليمن في دعة والعيش في رغد % 18(@)(@@) % تقدمت مدحة زهراء مشرقة % كالروض يضحك عن نوارة الخضد % 19(@)(@@) % و جاش بحري فلم أقنع بواحدة % حتى أتيت بها مشتدة العضد % 20(@)(@@) % قلادة جال فيها الفكر فانتظمت % نظم القلائد لم تنقص ولم تزد % PageV01P279 البحر : - 1(@)(@@) % سواء علينا وعدها ووعيدها % % إذا ما تساوى وصلها وصدودها % % 2(@)(@@) % وقفنا وقد ريعت مها الحيفانثنت % تصيد بألحاظ المها من يصيدها % % 3(@)(@@) % أعن وسن ترنو إلي عيونها ؛ % أمن سكر مالت علي قدودها % % 4(@)(@@) % فجازعة تعطي الغرام قيادها % % وقد راح مقتاد الغرام يقودها % % 5(@)(@@) % وساكنة تهتز ساكنة الجوى % % إذا اهتز من ماء الشبيبة عودها % % 6(@)(@@) % فللورد خداهاو للخمر ريقها % % وللغصن عطفاهاو للريم جيدها % % 7(@)(@@) % ألم ترني عفت المطالب إذ عفا % % من الجود مغناها ورث جديدها % % 8(@)(@@) % و صنت عقود المدح من كل ممسك % يهون عليه درها وفريدها % % 9(@)(@@) % هل المجد إلا في أياد تفيدها % % سجايا ابن فهد أو معال تشيدها % % 10 
ms78	(@)(@@) % فتى حث جدواهفما يستحثها % % و زادت أياديهفما يستزيدها % % PageV01P280 11(@)(@@) % له شرف عالي المحلو همة % تصعد أنفاس العدو صعودها % % 12(@)(@@) % و مازال فرد المكرماتو إنما % % يؤمل فرد المكرماتوحيدها % % 13(@)(@@) % ترى بين عينيه من البشر أنجما % تلوح لمرتاد السماح وفودها % % 14(@)(@@) % فإن تشتهر في كل شرق ومغرب % معالي ابن فهد فالثناء يزيدها % % 15(@)(@@) % سلامةإن الأزد بالبأس والندى % % تسود الورى طرا و أنت تسودها % % 16(@)(@@) % و قد علم الأعداء أن لست بادئا % بجائحة إلا وأنت معيدها % % 17(@)(@@) % رأت أسدا يلقى المنية حاسرا % إذا اختال في قمص الحديد أسودها % % 18(@)(@@) % فأقصر عنها بأسها ودفاعها % % و أكهم منها حدها وحديدها % % 19(@)(@@) % أرقت لود منك أودى ابتسامه % % و أنجم بشر منك غابت سعودها % % 20(@)(@@) % و ما ستر الكتمان عندي صنيعة % و لا أفسد النعماء في جحودها % % PageV01P281 21(@)(@@) % سأنشر فضلا لاتزال تديمه % و أثني بنعمى لاتزال تفيدها % % 22(@)(@@) % و أشكرها شكر الرياض صنيعة % من الرائحات الغر راحت تجودها % % 23(@)(@@) % فولت تجار الحمد تنشر حمدها % % و قد سعدت بالجود منك جدودها % % 24(@)(@@) % أريتهم وجها طليقا وراحة % يري بأسها في النائبات وجودها % % 25(@)(@@) % و صارت قوافي الشعر فيك عرائسا % تضيء الدجى أجيادها وخدودها % % 26(@)(@@) % فلا زالت الأيام تلقاك بيضها % % خصوصا وتلقى من يعاديك سودها % % 27(@)(@@) % فتسعد في خفض من العيش سعدها % % و يعتاد في يمن من الدهر عيدها % % 28(@)(@@) % و دونك من مستطرف الوشي خلعة % مطارفها موشية وبرودها % % 29(@)(@@) % فما زهرت إلا لديك نجومها % % و لا حسنت إلا عليك عقودها % % PageV01P282 البحر : - 1(@)(@@) % قل لابن فهد و إن شطت منازله % % و كم بعيد على العافين ما بعدا % % 2(@)(@@) % إن الغصون التي رويتها شحبت % و كيف نضرتهاو الماء قد نفدا % % 3(@)(@@) % غشيت بعدك منسوبا إلى أدب % يجفو الأديب ويطفي نوره حسدا % % PageV01P283 البحر : - 1(@)(@@) % فرقت بين جفونه ورقاده % % و جمعت بين غرامه وفؤاده % % 2(@)(@@) % و أبث في ثنيي حشاه صبابة % باتت لها الأشجان بين وساده % % 3(@)(@@) % لله أيام الكثيبفقد مضت % بمراده الغض الهوى ومراده % % 4(@)(@@) % أيام للعذال عز جماحه % % شغفا و للأحباب 
ms79	 ذل قياده % % 5(@)(@@) % غفلات دهر غيه وضلاله % % أولى بنا من هديه ورشاده % % 6(@)(@@) % و دجى بذات الطلح يبيض الهوى % % لأخي الصبابة في ارتكام سواده % % 7(@)(@@) % و ثرى كأن رباه تنشر حليها % % ما بين حر تلاعه ووهاده % % 8(@)(@@) % عطر تمر به الرياح فتنكسي % % عطرين من أجسادها وجساده % % 9(@)(@@) % ما صان قرب العيش فيه مدامعي % % حتى أزيل مصونها لبعاده % % 10(@)(@@) % و إذا الصبا أضحى عتاد متيم % فنفادها يهواه عند نفاده % % PageV01P284 11(@)(@@) % و الدهر كالنشوان في إصلاحه % % ما راح يصلحه وفي إفساده % % 12(@)(@@) % راع لنا يجتاح دثر سوامه ؛ % و أب لنا يسطو على أولاده % % 13(@)(@@) % ففعاله المحمود عند بخيله % % و فعاله المذموم عند جواده % % 14(@)(@@) % و لو اقتدى فينا بأحمد لارتدى % % بردين من توفيقه وسداده % % 15(@)(@@) % خرق تخرق في سماح لم يزل % غمر السماح يقل عند ثماده % % 16(@)(@@) % مرتاد حمد لاتزال خوافقا % رايات أنعمه على مرتاده % % 17(@)(@@) % إن كنت مطرد الجوارفعذ به % أو كنت ممتحن الزمان فناده % % 18(@)(@@) % يعطيك ما يعطيه غرب حسامه % % و شبا أسنتهو كر جواده % % 19(@)(@@) % مازال يصعد بين بيض سيوفه % % قلل الفخارو بين سمر صعاده % % 20(@)(@@) % تعب الجوانح يشتري قضض العلى % % أبدا براحته ولين مهاده % % PageV01P285 21(@)(@@) % قد قلت للجاري على آثاره % % أنت الجوادو لست من أنداده % % 22(@)(@@) % ذهبت سجالك عند جري جواده % % و خبا ضرامك عند وري زناده % % 23(@)(@@) % و إذا امرؤ أعيت عليك سهوله % % فاغضض جفونك عن ذرى أطواده % % 24(@)(@@) % شرف إذا ما اختال فيهرأيته % % في تاج تبعه وحلة عاده % % 25(@)(@@) % بيت لتبع تلتقي عمد العلى % % في ملتقى أطنابه وعماده % % 26(@)(@@) % هذاو معترك إذا عرك القنا % % فيه الشجاع مضى طريد طراده % % 27(@)(@@) % خلط العجاجة بالدماءكأنما % % نشرت مجاسده خلال جياده % % 28(@)(@@) % أوفى عليفما انجلت غمراته % % إلا بصدق كفاحه وجلاده % % 29(@)(@@) % رحل الصيامو قد أعد من التقى % % و النسك فيه عدة لمعاده % % 30(@)(@@) % متمسكا بالصدق في موعوده % % متمسكا بالعفو في إيعاده % % PageV01P286 31(@)(@@) % قبل الإله صيامه في شهره % و أعاد ما يهواه من أعياده % % PageV01P287 البحر : - 1(@)(@@) % فما يباليإذا ما الدهر أسعده 
ms80	 % % ضن الخلي بدمع العين أو جادا % % 2(@)(@@) % وعن للعين سرب راح يذكره % شبائه السرب ألحاظا وأجيادا % % 3(@)(@@) % راحوا رياحا تزجي كل سارية % من الندى وغدوا للحلم أطوادا % % 4(@)(@@) % تناهبوا الفضل دون الناس كلهم % فأصبح الناس أعداء وحسادا % % 5(@)(@@) % لا يبعد الله منكم عصبة فضلت % فزادها الفضل إقصاء وإبعادا % % 6(@)(@@) % كشيمة العود مازالت بلا سبب % تهدي إلى العود إحراقا وانفادا % % 7(@)(@@) % قتلى أقيمت بأكناف العراق لها % % مآتم أصبحت بالشام أعيادا % % PageV01P288 البحر : - 1(@)(@@) % باليمن ما رفع الأمير وشيدا % % و بجده النعماء ما قد جددا % % 2(@)(@@) % قصر أناف على القصور بحلة % ملك أناف على الملوك مؤيدا % % 3(@)(@@) % قلناو قد أعلاه جد صاعد % في الجو حتى ما يصادف مصعدا % % 4(@)(@@) % أبنية ببنائها فضح البنا % % أم فرقد بسناه شان الفرقدا % % 5(@)(@@) % غرف تألق في الظلامفلو سرى % % بضيائهاساري الدجنة لاهتدى % % 6(@)(@@) % عني الربيع بها فنشر حولها % % حللا تدبج وشيها أيدي الندى % % 7(@)(@@) % فكأنما تزجي السحائب فوقها % % جيشا يهز البرق فيه مطردا % % 8(@)(@@) % و كأنما نشر الهواء بجوها % % في كل ناحية رداء مجسدا % % 9(@)(@@) % و كأن ظل النخل حول قبابها % % ظل الغمامإذا الهجير توقدا % % 10(@)(@@) % من كل خضراء الذوائب زينت % بثمارها جيدا لها ومقلدا % % PageV01P289 11(@)(@@) % خرقت أسافلهن ريان الثرى % % حتى اتخذن البحر فيه موردا % % 12(@)(@@) % شجر إذا ما الصبح أسفر لم ينح % للأمن طائرهو لكن غردا % % 13(@)(@@) % غنيت مغانيها الحسان عن الحيا % % ماراح في عرصاتهنو ما اغتدى % % 14(@)(@@) % بمشمر في السير إلا أنه % % يسري فيمنعه السرى أن يبعدا % % 15(@)(@@) % وصل الحنين بعبرة مسفوحة % حتى حسبناه مشوقا مكمدا % % 16(@)(@@) % مسترفد أمواج دجلة رافد % وجه الثرى أكرم به مسترفدا % % PageV01P290 البحر : - 1(@)(@@) % أناشد دهري أن يعود كما بدا % % فقد غار بي في الحادثات وأنجدا % % 2(@)(@@) % توعدني من بعد ما وعد الغنى % % فأنجز إيعادا وأخلف موعدا % % 3(@)(@@) % و كنت أرى الأيام ظلا ممددا % و مهتصرا غضا وعيشا ممهدا % % 4(@)(@@) % فصرن لريب الدهر سهما مسددا % و أسمر خطيا وعضبا مجردا % % 5(@)(@@) % سقاهاو ما السقيا بكف صنيعها % % خليع الحيا إن جر برديه غردا 