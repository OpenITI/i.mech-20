ms101	(@)(@@) % وقال المفرك : ثاب الفتى % % وسالمني الكلب لا ينبح % % 26(@)(@@) % فهذا أوان انقضت شرتي % % وشرعت في الدين لا أطلح % 27(@)(@@) % بلوت ابن نهيا فما عنده % سوى أن سيأكل أو يسلح % % 28(@)(@@) % وذاك فتى من سراة النبيط % تعود شيئا فما يفلح % % 29(@)(@@) % يحب النكاح ويأبى الصلاح % % كذاك النباطي لا يصلح % 30(@)(@@) % إذا شئت لاقيته رابضا % على ظهره رجل يسبح % PageV01P396 31(@)(@@) % تراه يسر بنيك ابنه % على أنه سبة تفضح % % 32(@)(@@) % وما كان إلا كأم العرو % % س إذا نكحت بنتها تفرح % PageV01P397 البحر : وافر تام 1(@)(@@) % صحا تربي وما قلبي بصاح % وأصبح عاندا حبل النصاح % % 2(@)(@@) % وكنت من المزاح أكاد أسلو % % فقد لاقيت قاطعة المزاح % 3(@)(@@) % أبيت مروعا وأظل صبا % كأن القلب مني ذو جناح % 4(@)(@@) % ومن يك ذاق من عشقي قراحا % فإني قد شربت من القراح % % 5(@)(@@) % ولست بذاكر ' عباد ' إلا % % تبادرت المدامع بانسفاح % 6(@)(@@) % ولا أنسى غداة بكت وقالت : % أتغدو أم تروح من الرواح % 7(@)(@@) % فقلت لها : الرواح بذاك أحجى % % وأقرب بالمحب من الصباح % 8(@)(@@) % يلومك في مودتها ' سعيد ' % وما في حب ( عبدة ) من جناح % 9(@)(@@) % فغرك أن لومك يا ' سعيد ' % بتمنع بل أحر من النزاح % 10(@)(@@) % فدع لوم المحب إذا تهادى % % به حب النساء لحاك لاح % % PageV01P398 11(@)(@@) % فإنك لا ترد هوى بلوم % ولا طرب المتيم بامصاح % % 12(@)(@@) % تعلل حين نسألها نوالا % حرادا بالتدلل والمزاح % % 13(@)(@@) % كأن بريقها عسلا جنيا % وطعم الزنجبيل وريح راح % 14(@)(@@) % تراخت في النعيم فلم تنلها % % حواسد أعين الزرق القباح % % 15(@)(@@) % نعم علقتها فلها حياتي % % هدايا الحب في نفس الرياح % % 16(@)(@@) % وإن أهلك فدام علي هلكي % % لها طول السلامة والصلاح % % 17(@)(@@) % طرحت مودتي وصرمت حبلي % % ولم أهمم لودك باطراح % % 18(@)(@@) % فجودي بالوصال لمستهام % بذكرك في المساء وفي الصباح % 19(@)(@@) % يهيم بكم وقد دلفت إليه % جيوش الحب بالموت الصراح % % 20(@)(@@) % طبيبي داوني وتأن سقمي % % لك اليوم التلاد على النجاح % PageV01P399 21(@)(@@) % إذا سليتني أوهجت منها % % فؤادا لا يساعف بارتياح % % 22(@)(@@) % وكيف شفاء مختبل حزين % بشبعى الحجل جائعة الوشاح % PageV01P400 البحر : كامل تام 
ms102	 1(@)(@@) % ومعذل هجر اللئام حديثه % متعالم بفتوة ومزاح % % 2(@)(@@) % نازعته الريحان في نفس الضحى % % وسماع عاملة اليدين رداح % % 3(@)(@@) % وزجاجة للشرب فيها مقنع % قرنت بأزهر كالغزال مباح % % 4(@)(@@) % سلس بلينة المذاق رقيقة % كالدمع تخليط لينها بجماح % % 5(@)(@@) % ورضاب ذي أشر أغر كأنما % % غبقت مشاربه من التفاح % 6(@)(@@) % خود إذا جنح الظلام فإنها % % PageV01P401 البحر : طويل 1(@)(@@) % أقمت وأجريت الصبا ما وحى واح % % وأمسكت عن باب الضلالة مفتاحي % % 2(@)(@@) % وقال العذارى : ليس فيك بقية % كذبن يحز السيف في الطبع الضاحي % % 3(@)(@@) % تمتعت من ود الشباب الذي مضى % % مع البيض أسقى رقهن مع الراح % % 4(@)(@@) % وواد العذارى زائر ومردنا % يطفن بذيال السرابيل مسفاح % % 5(@)(@@) % من القادة المسأذنين إذا غدا % % كأن على أعطافه ضوء مصباح % % 6(@)(@@) % لقد كان يومي بالجديد مشهرا % وأيام ذي ضال ويوم بذي ضاح % % 7(@)(@@) % ليالي أغدو بينهن مرفلا % أحب وأعطى حاجتي غير ملحاح % % 8(@)(@@) % فغير ذاك العيش تاج لبسته % وطاعة مهدي كفت قول نصاح % % 9(@)(@@) % فمالآن لا أسري إلى أم مالك % بعتبى ولا أصغي إلى قول قرواح % 10(@)(@@) % تمثل لي وجه الخليفة دونها % % فقل في حبيب دونه أسد شاح % % PageV01P402 11(@)(@@) % وندمان صدق قد وصلت حديثه % بأزهر مجاج المدامة نباح % % 12(@)(@@) % إذا فرغت كأس امرئ خر ساجدا % وصب لنا صفراء في طيب تفاح % % 13(@)(@@) % على ذاك حتى ردني عن جهالة % وما الناس إلا طالب اللهو أو صاح % % 14(@)(@@) % ولولا أمير المؤمنين محمد % رجعت بأخرى من دمى الناس ملواح % % 15(@)(@@) % لها نصفات حولها يستلمنها % % كما استلم الركن النواسك بالراح % % 16(@)(@@) % إذا نظرت حالت بها عين ناظر % وأودت بألباب وألوت بأرواح % % 17(@)(@@) % فقلت لها : بان الشباب فقد مضى % % وصاحبني غيظ لغيران منباح % 18(@)(@@) % لعلك أن لا تعرفيني بمثلها % % هداني أمير المؤمنين بمصباح % % 19(@)(@@) % فآليت : لا آلو الخليفة طاعة % ولا أبتغي إذنا على ذات أوشاح % % 20(@)(@@) % تركت تجارات المعازف رائحا % وأعرضت عن راح وعن قينتي راح % PageV01P403 البحر : خفيف تام 1(@)(@@) % طال ليلي وبات قلبي جناحا % % ومللت العذال والنصاحا % % 2(@)(@@) % يأمرون المحب بالصبر عمن % % قد 
ms103	 برى الحب جسمه فاستطاحا % % 3(@)(@@) % بئس ما يأمرون مستشعر الهم % يقاسي من عبدة الأتراحا % % 4(@)(@@) % أيها القارىء المذكر بالله : % ترى في وصال حب جناحا % % 5(@)(@@) % قال : لا بأس بالحديث إذا ما % % لم يزيدا على الحديث جماحا % % 6(@)(@@) % أي خير يا عون يرجو محب % في سواد الفؤاد منه براحا % % 7(@)(@@) % كيف يرجو سلو صب حزين % زاده الحب حين شاع ارتياحا % % 8(@)(@@) % إن تكن إنما تروح وتغدو % % بانتصاح فما أريد انتصاحا % % 9(@)(@@) % فدع الغدو والرواح علينا % % ما غدا حبها علينا وراحا % % 10(@)(@@) % قد كتمت الهوى مليا فلما % % ضقت ذرعا بحب عبدة باحا % % PageV01P404 11(@)(@@) % ليت شعري عن أم عمرو وعمرو % % لم يكن جاهلا ولا مزاحا % % 12(@)(@@) % أحديث منها رماه بطب % ليته مات قبلها فاستراحا % % 13(@)(@@) % بل يرجي ما لا ينال ولولا % % ما يرجي اكتسى المسوح وساحا % % 14(@)(@@) % أم عمرو ما زال حبك يغتا % % ل عزائي حتى افتضحت افتضاحا % % 15(@)(@@) % كيف لا ترحمين شخصا محبا % ميتا من هواك موتا صراحا % % 16(@)(@@) % كان يرعى المصباح حينا فلما % % ضافه الحب ضيع المصباحا % % 17(@)(@@) % إن تكوني أردت أن تفجعيه % بمزاح فقد قطعت المزاحا % % 18(@)(@@) % واصلا للحياة منها وإن عا % % ش وماتت بكى عليها وناحا % % 19(@)(@@) % إن شهدت الوفاة يا عون مني % % في مقام وكنت تنوي صلاحا % % 20(@)(@@) % فادع سرب الملاح يشهدن موتي % % بحنوط إني أحب الملاحا % % PageV01P405 21(@)(@@) % من هوى عبدة البخيلة أني % % لا أرى غيرها لقلبي رواحا % % 22(@)(@@) % أنت عون الشيطان إن لم تعني % % فارع ما قلت تشف مني قماحا % % 23(@)(@@) % وادع قومي بأم عمرو فإني % % عاقد حبها علي وشاحا % % 24(@)(@@) % مستهام النهار مرتفق الليل % إلى أن أعاين الإصباحا % % 25(@)(@@) % لم أزل من هوى عبيدة أهوى % % ما يليها حتى هويت الرياحا % % 26(@)(@@) % لست أنسى غداة قامت تهادى % % للمصلى فطار قلبي وطاحا % % 27(@)(@@) % في نساء إذا أردن ضياء % % لظلام جعلنها مصباحا % % 28(@)(@@) % فأضاءت لهن داجية الليل % وجلت عما تجن الوحاحا % % PageV01P406 البحر : مجزوء الخفيف 1(@)(@@) % الق ( حربا ) فحيه % ثم سله عن القدح % 2(@)(@@) % أقريب مزاره % أم مع النجم قد 
ms104	 طمح % 3(@)(@@) % إن يكن في ا % % رضت عنه ولم ألح % 4(@)(@@) % قد وفى لي المفضل % ل بن عباد وما بلح % 5(@)(@@) % ووزناه بالكرا % % م فساوى وقد رجح % 6(@)(@@) % فله الفضل حيث كا % % ن على من وأى وشح % PageV01P407 البحر : خفيف تام 1(@)(@@) % نور عيني تركت قلبي جناحا % % يوم فارقتني فحن وناحا % % 2(@)(@@) % جوهر الدر لم أنلك ولو نل % تك كنت الغنى وكنت الفلاح % 3(@)(@@) % كيف لم تذكري الرسول إلينا % % وقعودي إليك أرعى الصباحا % % 4(@)(@@) % يشتهي قربك الفؤاد ولكن % % لا تبالينه ويأبى انتصاحا % % 5(@)(@@) % ذهبت نظرتي إليك بنفسي % % ونمى الحب عن فؤادي فباحا % % 6(@)(@@) % يوم أذري إليك من حذر الفر % % قة دمعي وقد عزمت الرواحا % % 7(@)(@@) % نور عيني لو كان منك في الست % % ر لعيب شفيت مني قراحا % % 8(@)(@@) % أسلمتني عيني إليك وقالت % % لو تعزى بالصبر عنك استراحا % % 9(@)(@@) % ومن المشتكى سلوك عني % % واشتياقي قد افتضحت افتضاحا % % PageV01P408 البحر : كامل تام 1(@)(@@) % فتن المرعث بعد طول تصاح % وصبا ومل مقالة النصاح % % 2(@)(@@) % وأصابه سحر البخيلة بعد ما % % ألف الصلاة وعاذ بالمسباح % % 3(@)(@@) % فتعرضت لك للذي حاذرته % حوراء في عقد لها ووشاح % 4(@)(@@) % خود إذا جنح الظلام فإنها % % تكفي الأوانس فقدة المصباح % 5(@)(@@) % ولو أنها داوت صدى من هائم % حران ينظر غفلة المياح % 6(@)(@@) % برضاب ذي أشر أغر كأنما % % 7(@)(@@) % شفت الغليل ولم تنل بملامة % وشفاء من تيمت غير جناح % 8(@)(@@) % إن البخيلة لو يميل بها الصبى % % كالقنو مال على أبي الدحداح % 9(@)(@@) % أتنصحا ما تأمرين فمثلها % % رجع النصيح شفى من الأبراح % 10(@)(@@) % رجل سيبذل للطبيب تلاده % إن كان ذا ثقة له بنجاح % PageV01P409 11(@)(@@) % ولقد كلفت بها وعيرني الهوى % % بادي النصيحة ساكن الأرواح % 12(@)(@@) % فحلفت لا أعطي العواذل طاعة % حتى يقام علي بالأنواح % 13(@)(@@) % وإذا هويت فلا يعيرك الهوى % % إلا مقالة آخرين صحاح % 17(@)(@@) % فإذا النديم شكا الصدى من هامة % عندي شفيت صداءه بالراح % 18(@)(@@) % مما تضمنه أشم معمم % بلحاء باسقة من الأدواح % % 19(@)(@@) % فإذا أكب حكى لسمعك ضاحكا % تحت الغمامة أو دوي نباح 
ms105	 % 20(@)(@@) % بخروج لينة المذاق رقيقة % كالدمع تخلط لينها بجماح % 21(@)(@@) % حتى أروح وقد قضيت لبانة % أندى من المتضيف الرواح % % 22(@)(@@) % لوصال أخرى قد سلوت سلوها % % فأبت بنات فؤادي المرتاح % % 23(@)(@@) % لما رأتني فوق أجرد سابح % % كالفيء معترضا على أرماح % PageV01P410 24(@)(@@) % سلس المقلد لا أخفض جاشه % إلا تقاذف غربه بطماح % % 25(@)(@@) % قالت لجارتها : أتانا زائر % رقت له كبدي ولان جناحي % % 26(@)(@@) % ما طلته دينا وطال طلابه % والدين منسرح وغير سراح % 27(@)(@@) % فاليوم أقضي دينه بنيابتي % % في كل غدوة شارق ورواح % PageV01P411 البحر : بسيط تام 1(@)(@@) % دعني أمت بالهوى لا يلحني لاح % ليس المشوق إلى الأحباب كالصاحي % % 2(@)(@@) % لو كنت تطرب لم تنكر بكا طرب % صب على نفسه بالشعر نواح % % 3(@)(@@) % خفض جشاك على نأي الدنو بها % % آليت أدني نصيحا ما وحى واح % % 4(@)(@@) % قد هر قبلك كلب دون حجرتها % % فهل فزعت لكلب مر نباح % % 5(@)(@@) % أبى لي اللعج المشبوب في كبدي % % وفي فؤادي وأوصالي وأرواحي % % 6(@)(@@) % أرتاح للريح إن هبت يمانية % وأنت عندي رخيم غير مرتاح % % 7(@)(@@) % لا أسمع الصوت إلا صوت جارية % تدعو إلى أسد من حبها شاح % % 8(@)(@@) % كأنما انتزعت حبي بدعوتها % % كأنها جبل من دون نصاحي % % 9(@)(@@) % ريا الروادف ملواح منعمة % يا حبذا كل ريا الردف ملواح % 10(@)(@@) % لم ترث لي من جوى حب وقد ضحكت % عن بارد كوميض البرق لماح % % PageV01P412 11(@)(@@) % كأن في طرف عينيها إذا نظرت % بناظر ع قدا من سحر سباح % % 12(@)(@@) % تسر عينا وتلقى الشمس غيبتها % % كأنما خلقت من ضوء مصباح % 13(@)(@@) % أمسي أؤمل جدواها فتخلفني % % وما أزال كما أمسيت إصباحي % % 14(@)(@@) % وكيف يخلف مأمول له شرف % من بعد ما قال خيرا لامرىء ناح % % 15(@)(@@) % يلومني صاحبي فيها وقد فتحت % إلى الصبابة لي بابا بمفتاح % % 16(@)(@@) % خاضت من الحب ضحضاحا وما رضيت % % حتى جشمت إليها غير ضحضاح % % 17(@)(@@) % تسوكت لي بمسواك لتعلمني % % ما طعم فيها وما همت بإصلاح % % 18(@)(@@) % لما أتنني على المسواك ريقتها % % مثلوجة الطعم مثل الشهد بالراح % % 19(@)(@@) % قبلت ما مس فاها ثم 
ms106	 قلت له : % يا ليتني كنت ذا المسواك يا صاح % % 20(@)(@@) % قل للرباب : ارجعي روحي إلى جسدي % % أو علليني بوجه منك وضاح % % PageV01P413 21(@)(@@) % على الوساوس تعفيني وتتركني % % من باكر بدعاوي الحب رواح % % PageV01P414 البحر : خفيف تام 1(@)(@@) % لا تلمني على عبيدة صاح % زودتني زادا من الأتراح % % 2(@)(@@) % وانهني إن نهيتني عن هواها % % باسم أخرى إن اسمها من فراحي % % 3(@)(@@) % بل دع الحب ثم لمني عليها % % ذكرك الحب زائدي في ارتياحي % % 4(@)(@@) % قد ذكرت الهوى فرق فؤادي % % ودعوت اسمها فطار جناحي % % 5(@)(@@) % ولقد كنت ذا مزاح فأصبح % ت على حبها قليل المزاح % % 6(@)(@@) % طربا للرياح هبت جنوبا % أين مثلي يهوى هبوب الرياح % % 7(@)(@@) % أيها المرء إن قلبك صاح % % من هواها وليس قلبي بصاح % 8(@)(@@) % أفتنتني لا ريب عبدة إني % % من هواها على سبيل افتضاح % 9(@)(@@) % هل على عاشق خلا بحبيب % في التزام وقبلة من جناح % % 10(@)(@@) % إنما بالفؤاد والعين مني % % حب شبعى الخلخال غرثى الوشاح % % PageV01P415 11(@)(@@) % مكرب فوق معقد المرط منها % % واحتشى المرط من أباة رباح % % 12(@)(@@) % بنت ستر لم تبد للشمس يوما % ما خلا الفطر أو غداة الأضاحي % % 13(@)(@@) % سلبته يوم الخروج حجاه % بأسيل العطبول والأوضاح % % 14(@)(@@) % وبثغر يحكي المخبر عنه % نفحة المسك فت في كأس راح % % 15(@)(@@) % يا خليلي تلكما داء عيني % % ودوائي من دمعها السفاح % % 16(@)(@@) % إن أم الوليد - فاسترقياها - % أفسدتني وعندها إصلاحي % % 17(@)(@@) % ثم قولا لها بقول وفيها % % ضنة من فؤاده المستباح : % 18(@)(@@) % اسجحي يا عبيد في ود نفسي % % ليس إمساكها من الإسجاح % % 19(@)(@@) % أقلق الروح طول صفحك عني % % وصليني وسكني أرواحي % % 20(@)(@@) % ولقد قلت للنطاسي : أعطيك % % تلادي وطارفي بالنجاح % % PageV01P416 21(@)(@@) % داوني من حمام قلبي إليها % % بدواء يرد غرب الجماح % % 22(@)(@@) % فاحتماني وقال : داء عياء % ما لمن يبتلى به من رواح % 23(@)(@@) % ما دواء الذي يسهد باللي % ل ولا يستريح في الإصباح % 24(@)(@@) % فتجهزت لانقضاء حياتي % % واستعدت لميتتي أنواحي % % PageV01P417 البحر : طويل 1(@)(@@) % يقول أبو عمرو غداة تهللت % % من العين درات وفاض سفوحها % % 2(@)(@@) % أجدك من ريحانة طاب ريحها % % ظللت 
ms107	 تبكي خلة وتنوحها % % 3(@)(@@) % فقلت له : لا تكثر اللوم إنني % % أتى من هوى نفسي علي جموحها % % 4(@)(@@) % كأنك لم تعلم لعبدة حرمة % وأسرار حب عندنا لا نبيحها % % 5(@)(@@) % تثاقلت الذلفاء عني وما درت % % بذي كبد حرى يغص قريحها % % 6(@)(@@) % وقد كادت الأيام دون لقائها % % تصرم إلا أن يمر سنيحها % % 7(@)(@@) % يذكرني الريحان رائحة التي % % إذا لم تطيب وافق المسك ريحها % % 8(@)(@@) % عبيدة هم النفس إن يدن حبها % % وإن تنأ عنها فارق النفس روحها % % 9(@)(@@) % فلا هي من شوق إليها تريحني % % ولا أنا من طول الرجاء أريحها % % 10(@)(@@) % هواك غبوق النفس في كل ليلة % وذكرتمو في كل يوم صبوحها % % PageV01P418 11(@)(@@) % وللنفس حاجات إليك إذا خلت % سيعيا بها عند اللقاء فصيحها % % 12(@)(@@) % فلست بسال ما تغنت حمامة % وما شاق رهبان النصارى مسيحها % % PageV01P419 البحر : طويل 1(@)(@@) % لعمري لقد أزرى سهيل بصهره % وولاهمو في شركه غير صالح % % 2(@)(@@) % أزوجتم العلج اللئيم ابن سالم % وما زائن زوجتموه بفاضح % % 3(@)(@@) % ألا يخرج الدجال إن كان خارجا % وهذا سهيل صهر موسى بن صالح % % 4(@)(@@) % فما أملت هذا له نفس صالح % ولا كان يرجوها له في المناكح % 5(@)(@@) % ولا خاف هذا صالح عند موته % على عقبه في ناديات الفضائح % % PageV01P420 البحر : وافر تام 1(@)(@@) % أأبجر هل لهذا الليل صبح % وهل بوصال من أحببت نصح % 2(@)(@@) % أأبجر قد هويت فلا تلمني % % على كبدي من الهجران قرح % 3(@)(@@) % جرى دمعي فأخبر عن ضمير % كجاري المسك دل عليه نفح % 4(@)(@@) % كأني يوم سار بنو يزيد % يؤم دليلهم بصرى وينحو % % 5(@)(@@) % خرجت بنشوة من بيت رأس % تدور بهامتي والطرف طمح % 6(@)(@@) % أسائل أين سار بنو يزيد % % وعندي منهم الخبر المصح % 7(@)(@@) % أأبحر هل ترى بالنقب عيرا % تميل كأنها سلم وطلح % 8(@)(@@) % خرجن على النقا متواترات % نواعب في السراب لهن شبح % 9(@)(@@) % فواعجبا صفوت لغير صاف % وأعطيت الكريمة من يشح % 10(@)(@@) % وذي مال وليس بذي غناء % % كزب الشيخ لا يعلوه نضح % PageV01P421 11(@)(@@) % صبرت عليه حتى بان فسلا % كأن إخاءه خبز وملح % 12(@)(@@) % وفياض اليدين 
ms108	 على الموالي % % له فضل يعاش به ومنح % 13(@)(@@) % من المتحرفين يدا وجودا % علي مديحه وعليه نجح % 14(@)(@@) % أتاني وده خدما ومالا % وعيلني وبعض النيل وتح % 15(@)(@@) % مضى هذا ، فقل في أم بكر % أراها لا تجود ولست أصحو % % 16(@)(@@) % رأيت لها على الروحاء طيفا % ورؤية من تحب عليه صلح % 17(@)(@@) % ويوم لقيتها بجناب حوضى % % كعضب العير سيق إليه ربح % 18(@)(@@) % تتابعت الثوائج لأم بكر % % تفوز بها وحال عليك قدح % 19(@)(@@) % إذا ما شئت راح علي هم % من الغادين أو طرب ملح % 20(@)(@@) % وقالوا : لو صفحت عن النصارى % % ولا والله ما بأخيك صفح % PageV01P422 21(@)(@@) % أحن إلى محاسن أم بكر % ودون لقائها دكح ونكح % 22(@)(@@) % وأضبط لا توزعه المنايا % % أبل مشيع بالموت سمح % 23(@)(@@) % تعز ولا تكن مثل ابن نهيا % % له رمح ولا يغنيه رمح % 24(@)(@@) % يميل على رماح القوم ظلما % له . . . . . . . . . . . . . . . . فطح % 25(@)(@@) % يذم الشيب حماد بن نهيا % % وليس له من الشبان مدح % 26(@)(@@) % يوافقه ارتكاض القرد فيه % وإن مسح الضراط فذاك ربح % 27(@)(@@) % به جرح من الرمح المذكى % % وليس به من المأثور جرح % PageV01P423 البحر : سريع 1(@)(@@) % أنى دعاه الشوق فارتاحا % % من بعد ما أصبح جماحا % % 2(@)(@@) % ذكره عهد الصبى صاحب % كان له إذاك مفتاحا % % 3(@)(@@) % أيام عبادة من شأنه % إن لم يزرها باكرا راحا % % 4(@)(@@) % القلب مشغوف بما قد مضى % % يلقى من الأحزان أتراحا % % 5(@)(@@) % وكيف لا يصبو إلى غادة % % تكفيك في الظلماء مصباحا % % 6(@)(@@) % سحارة العين لها صورة % جاد عليها الحسن سحاحا % % 7(@)(@@) % كأن ثلجا بين أسنانها % % مستشركا راحا وتفاحا % % 8(@)(@@) % كاتمت ما ألقى إلى وجهها % % حتى إذا عذبني باحا % % 9(@)(@@) % كفى خليلي هوى شفني % % لا يعدم الناصح أنصاحا % % 10(@)(@@) % قولا لمن لم تريا مثله % في محفل جسما وألواحا : % PageV01P424 11(@)(@@) % كري لنا العيش الذي قد مضى % % ما كان ذاك العيش ضحضاحا % % 12(@)(@@) % لا كنت إن كنت تناسيتكم % لهائج بعدكمو ناحا % % 13(@)(@@) % في حلتي جسم فتى ناحل % لو هبت الريح له طاحا % % 14(@)(@@) % كان الشقا حبى مدينية % راحت بها دار وما 
ms109	 راحا % % 15(@)(@@) % أرعى بها النجم وما رغبتي % % نجما بطرف العين لماحا % % 16(@)(@@) % أذابحي الشوق إلى قربها % % ما كان ذاك الشوق ذباحا % % 17(@)(@@) % لم أنس ما قالت وأترابها % % في معرك ينظمن مسباحا : % 18(@)(@@) % أقلل من الطيب إذا زرتنا % % إني أخاف المسك إن فاحا % % 19(@)(@@) % لا تتركنا غرضا للعدى % % إن كنت للأهوال سباحا % % 20(@)(@@) % لم أدر أن المسك واش بنا % % إن حار باب الدار مسباحا % % PageV01P425 21(@)(@@) % فسمحت أخرى وقالت لها : % لا تحرما ما كان إصلاحا % % 22(@)(@@) % لا بد من طيب لمعتاده % يغدو به نفسا وأرواحا % % 23(@)(@@) % كم ليلة قد شق إصباحها % % عنا نعيما كان زحزاحا % % 24(@)(@@) % لم ننبسط فيه إلى محرم % % حتى رأينا الصبح وضاحا % % 25(@)(@@) % إلا حديثا معجبا أنسه % أكبرته غنما وأرباحا % % PageV01P426 البحر : منسرح 1(@)(@@) % أبكاك بدر السماء أن لاحا % . . . . مر بعد موته قاحا % % 2(@)(@@) % على حبيب يبيت ملتدما % يبكيك نوح الحمام إن ناحا % % 3(@)(@@) % ذكرك البدر وجهها فتلا : % لله وجه الحبيب مصباحا % % 4(@)(@@) % كأن في قرقر تضمنها % % سفرجلا طيبا وتفاحا % % PageV01P427 البحر : خفيف تام 1(@)(@@) % درة حيثما أديرت أضاءت % ومشم من حيثما شم فاحا % % 2(@)(@@) % وجنان قال الإله لها كو % % ني ! فكانت روحا وروحا وراحا % % PageV01P428 البحر : طويل 1(@)(@@) % وزائرة ما مسها الطيب برهة % من الدهر لكن طيبها الدهر فائح % PageV01P429 البحر : طويل 1(@)(@@) % لعمري لقد هذبت قولي ولم أدع % مقالا لمغتاب ودعوى لمن لحا % % 2(@)(@@) % ومن كان ذا فهم بليد وعقله % % به علة عاب الكلام المنقحا % % PageV01P430 البحر : متقارب تام 1(@)(@@) % كبكر تشهى لذيذ النكاح % % وتفرق من صولة الناكح % % PageV01P431 البحر : طويل 1(@)(@@) % أصفراء كان الود منك مباحا % % ليالي كان الهجر منك قراحا % % 2(@)(@@) % وكان جواري الحي إذ كنت فيهم % % PageV01P432 البحر : طويل 1(@)(@@) % ألا من لمطروب الفؤاد عميد % ومن لسقيم بات غير معود % 2(@)(@@) % بأم سعيد جفوة عن لقائه % % وإن كانت البلوى بأم سعيد % % 3(@)(@@) % إذا قلت : داوي من أصبت فؤاده % بسقمك ، داوته بطول صدود % 4(@)(@@) % وإن جيد منته المنى بلقائه % % خلايا ولا يلقاه ، غير مجود % 5(@)(@@) % كأن عليها ألوة لا تسره % بجائزة منها 
ms110	 ولا بشديد % % 6(@)(@@) % وجلدني عنها البريء من الهوى % % ولست على هجرانها بجليد % 7(@)(@@) % فقلت له : بعض الملامة إنني % % على اللوم منها ضامن لمزيد % % 8(@)(@@) % أعد سجودي بالحصى وتلومني % % ولولا الهوى أوهمت بعض سجودي % % 9(@)(@@) % كأن بقلبي جنة تستفزه % بنسيان ما صليت غير عديد % 10(@)(@@) % شغلت بها نفسي فلست بفارغ % % لدان يرجيني ولا لبعيد % PageV01P433 11(@)(@@) % أدر لسعدى عن لبان مودتي % % صفاء وإن همت لنا بجمود % 12(@)(@@) % وإني لوصال لأخلاق حبلها % % وما كنت وصالا لغير جديد % % 13(@)(@@) % وكل امرئ ساع وللنفس غاية % وما الداء إلا الداء غير ودود % % 14(@)(@@) % ورائحة للعين منها مخيلة % إذا برقت لم تسق بطن صعيد % % 15(@)(@@) % من المستهلات الهموم على الفتى % % خفا برقها من عصفر وعقود % 16(@)(@@) % حسدت عليها كل شيء يمسها % % وما كنت لولا حبها بحسود % 17(@)(@@) % فمن لامني في الغانيات فقل له : % تعش واحدا لا زلت غير وحيد % 18(@)(@@) % وأصفر مثل الزعفران شربته % % على صوت صفراء الترائب رود % % 19(@)(@@) % ربيبة ستر يعرض الموت دونها % % زئير أسود تابعات أسود % % 20(@)(@@) % كأن أميرا جالسا في حجابها % % تؤمل رؤياه عيون وفود % PageV01P434 21(@)(@@) % أهبت بنات الصدر بعد رقادها % % فأصبحن قد وافين غير رقود % % 22(@)(@@) % ثقيلة ما بين البرين إلى الحشا % % وما الداء إلا غير ودود % 23(@)(@@) % تروح بمثل الأيم فوق نطاقها % % ويا لك من وجه هناك وجيد % 24(@)(@@) % من البيض لم تسرح على أهل غنة % وقيرا ولم ترفع حداج قعود % % 25(@)(@@) % كأن لسانا ساحرا في لسانها % % أعين بصوت كالفرند حديد % % 26(@)(@@) % كأن رياضا فرقت في حديثها % % على أن بدوا بعضه كبرود % % 27(@)(@@) % تميت بها ألبابنا وقلوبنا % % مرارا وتحييهن بعد همود % 28(@)(@@) % إذا نظقت صحنا وصاح لنا الصدى % % صياح جنود وجهت لجنود % % 29(@)(@@) % ظللنا بذاك الديدان اليوم كله % كأنا من الفردوس تحت خلود % 30(@)(@@) % ولا بأس إلا أننا عند أهلها % % شهود وما ألبابنا بشهود % PageV01P435 31(@)(@@) % فلما رأينا الليل شب ظلامه % وشب بمصباح لغير سعود % 32(@)(@@) % رجعنا وفينا شيمة أريحية % من العيش في ود لهن وجود % % 33(@)(@@) % فلسنا وإن هز العدو سوادنا 
ms111	 % % عن اللهو ما عن الصبا بقعود % PageV01P436 البحر : طويل 1(@)(@@) % يعيش بجد عاجز وجليد % وكل قريب لا ينال بعيد % 2(@)(@@) % وفي الطمع التنصيب واليأس كالغنى % % وليس لما يبقي الشحيح خلود % 3(@)(@@) % ولا يدفع الموت الأطباء بالرقى % % وسيان نحس يتقى وسعود % % 4(@)(@@) % وما نال شيئا طالب بجلادة % ولكن لقوم حظوة وجدود % % 5(@)(@@) % وتصبح لا تدري أيأتيك خافضا % نصيبك أم تغدو له فترود % % 6(@)(@@) % يفوت الغنى قوما يخفون للغنى % % ويلقى رباحا آخرون قعود % % 7(@)(@@) % وللخير أسباب وللعين فتنة % ومن مات من حب النساء شهيد % % 8(@)(@@) % وبيضاء مكسال كأن حديثها % % إذا ألقيت منه العيون برود % 9(@)(@@) % دعتني بأسباب الهوى ودعوتها % % ليالي سربال الصفاء جديد % % 10(@)(@@) % فجاءت على خوف كأن فؤادها % % جناح السمانى يرعوي ويحيد % PageV01P437 11(@)(@@) % فأعطيتها كف الصفاء فأعرضت % ثقيلة أدعاص الروادف رود % % 12(@)(@@) % تصد حياء ثم يقتادها الهوى % % إلينا وفيها صبوة وصدود % 13(@)(@@) % وأي نعيم لم أعش في ظلاله % % أكاد على لذاته وأكيد % % 14(@)(@@) % شربت بكأس العاشقين وزارني % % هلال عليه مجسد وعقود % % 15(@)(@@) % من المستفزات القلوب إذا مشت % تأود في أعطافها وتميد % 16(@)(@@) % تزين بخلق وجهها ويزينه % أغر كمصباح الظلام وجيد % 17(@)(@@) % كأن نساء الحي حين يزرنها % % نواحب نحب تم فيه سجود % % 18(@)(@@) % فما كان إلا الأنس بيني وبينها % % وشدو غناء تارة ونشيد % 19(@)(@@) % طوينا بها ذاك الزمان وإننا % % لكالماء للحران فيه برود % % 20(@)(@@) % فلما ذكت عين وأشرفت العدى % % وجاهرنا واش ودب حسود % PageV01P438 21(@)(@@) % وقد قلت تأديبا له وصبابة % إليها ومن دون اللقاء وعيد : % 22(@)(@@) % أطيعي عدوا واحذري عين حاسد % عقاربه تسري ونحن قعود % % 23(@)(@@) % فقالت : بنا شوق إليك وإنما % % نصادي عيونا تنثني فنعود % PageV01P439 البحر : كامل تام 1(@)(@@) % أسعاد جودي لا شفيت سعادا % % وصلي بودك هائما معتادا % % 2(@)(@@) % إن الزيارة أعقبت بفؤاده % % طربا فأعقب فتنة وفسادا % % 3(@)(@@) % ما تأمرين بزائر أقصيته % % يوم الخميس وقد رجا ميعادا % % 4(@)(@@) % أمسكت شقة نفسه فأذاعها % % وبخلت فاتخذ الهموم وسادا % % 5(@)(@@) % وتركته نصبا إليك بحاجة % كيما يزيد وويله إن زادا % % 6(@)(@@) % قالوا : نكدك بالهوى وتكدنا % . . . . المعيشة ما بلغت 
ms112	 كدادا % % 7(@)(@@) % ولقد عجبت من الضعيفة إذ بدت % تثني أسامة فانثنى وانقادا % % 8(@)(@@) % أسد تصيده غزال شادن % ما اصطاد قبلك شادن آسادا % % 9(@)(@@) % ولقد أقول لصاحب لي مهتر % قد مات من كلف بها أو كادا : % 10(@)(@@) % حتام تجشمني الصبى وتشفني % % بل ليت غيرك يا فؤاد فؤادا % % PageV01P440 11(@)(@@) % ما زلت تذكر وجهها وحديثها % % منذ انصرفت وما ذكرت معادا % % 12(@)(@@) % سعدى مباعدة وأنت مخاطر % أفقد رضيت مع الخطار بعادا % % 13(@)(@@) % منعتك يقظى ما تحب ولم تجد % % في نومها ، فمتى تكون جوادا % % 14(@)(@@) % وإذا أردت عداتها بخلت بها % % حتى الفؤاد وصافحتك جمادا % % 15(@)(@@) % أبطرف مقلتك المريضة صدته % % ما إن سمعت بمثله مصطادا % % 16(@)(@@) % صفراء آنسة يزين نقابها % % عين تروح للعيون سهادا % % 17(@)(@@) % إلا تكن قمر السماء فإنها % % مثل المريعة تعجب الروادا % % 18(@)(@@) % ولقد بدا لي أن أموت بحبها % % فانهل دمعي في الرداء وجادا % % 19(@)(@@) % فطوت زيارتها لغير ملامة % حذر المراقب للزمان مدادا % % 20(@)(@@) % نطقت فأنطق ما سمعت مدامعي % % عن كل ناطقة تقول سدادا % % PageV01P441 21(@)(@@) % وكأن ما سمعت له بحديثها % % هاروت يسلب مقلتيه رقادا % % 22(@)(@@) % وأقام يشفق أن يجن صبابة % ويخاف موته قلبه إن عادا % % PageV01P442 البحر : سريع 1(@)(@@) % يا طول هذا الليل لم أرقد % إلا رقاد الوصب الأرمد % 2(@)(@@) % مثل اكتحال العين نومي به % بل دون كحل العين بالمرود % 3(@)(@@) % أراقب الصبح كأني امرؤ % من راحة فيه على موعد % 4(@)(@@) % بت إلى أن راعني ضوؤه % وخلف سني إصبعي من يدي % % 5(@)(@@) % تعجبا مما دهاني به % أقرب جيراني لذي الأبعد % 6(@)(@@) % رقى إليها كذبا لم يكن % % مني على ممشى ولا مقعد % % 7(@)(@@) % حتى أدلت بل ثنى لبها % % عنى مقال الكاشح المفسد % % 8(@)(@@) % في الصدر مما بلغت حبتي % % مثل شهاب القابس الموقد % 9(@)(@@) % إن بردت عن كبدي لوعة % طالت على القلب فلم تبرد % % 10(@)(@@) % بل أيها الواشي بها عندنا % % لا زلت لا تعجبني فازدد % PageV01P443 11(@)(@@) % أنت لعمر الله أوجدتها % % علي حتى كدرت موردي % % 12(@)(@@) % وكنت أسباني بها صاحبا % يعتل في الأمر ولم يوجد % 13(@)(@@) % لم تر 
ms113	 مثلي مغرما بالهوى % % ومثل عبادة لم تقصد % 14(@)(@@) % تبرو لدى هجري وأدوى به % فلست بالحي ولا بالردي % % 15(@)(@@) % لكنني مثل سبيلهما % % مثل سليم الحية الأسود % 16(@)(@@) % شتان ذا منها وإرسالها : % أدالج أنت ولم تعهد % 17(@)(@@) % غداة زمت إبلي غدوة % والقوم من باك ومن مسعد % 18(@)(@@) % فقلت : إن آبوا فأنت الهوى % % وإن أرح منك فلا تبعد % % 19(@)(@@) % يا عبد لا تنسي فلم أنسه % ممشاي بين المسجد المبتدي % % 20(@)(@@) % يوم عبيد الله كالمعتدي % % علي في حبك أو معتدي % % PageV01P444 21(@)(@@) % يقول إذ أبصرني مقبلا % % في القوم معتما ولم أرتد % 22(@)(@@) % لما رآه شهدت عينه % مشوه اللبسة في المشهد % 23(@)(@@) % هذي لتي دلهه حبها % % وكان حينا من حصى المسجد % % 24(@)(@@) % فقلت : يا صاح بها حيني % % كلني لما بي لست بالمرشد % % 25(@)(@@) % كنت كما قلت من أبنائه % وفتنتي عبدة بالمرصد % 26(@)(@@) % بينا كذا إذ برقت برقة % بين رداء الخز والمجسد % 27(@)(@@) % بيضاء حسنا أشربت صفرة % تهتز في غصن الصبى الأغيد % % 28(@)(@@) % تحسدها الجارات من حسنها % % ومثل عبادة فليحسد % 29(@)(@@) % يحسدن منها قصبا مالئا % للقلب والخلخال والمعضد % % 30(@)(@@) % والدر والياقوت يحسدنها % % مناطة في الأوضح الأجيد % % PageV01P445 31(@)(@@) % ومضحكا منها كما أومضت % صيفية المزن ولم ترعد % % 32(@)(@@) % وأنها حوراء مكحولة % غانية تغنى عن الإثمد % % 33(@)(@@) % يحسدنها ذاك إلى صورة % قامت بها عندي ولم تقعد % % 34(@)(@@) % لا عيب فيها غير تأخيرها % % كل صباح وعدنا في غد % PageV01P446 البحر : خفيف تام 1(@)(@@) % لا تعد لي كليلة بالجماد % بتها خائفا على أسهادي % % 2(@)(@@) % أرهب السيف إن وردت على الحي و % % وأطوي الهموم والقلب صاد % 3(@)(@@) % ضيعة النفس وادلاج على القصد % وما خير مدلج غير هاد % 4(@)(@@) % ولقد أصرف الفؤاد عن الشي % ء حياء وحبه في السواد % 5(@)(@@) % أمسك النفس بالعفاف وأمسي % % ذاكرا في غد حديث الأعادي % % 6(@)(@@) % ذاك إذ لا تزال ( حبى ) من البغي % % خيالا يزورني في الرقاد % % 7(@)(@@) % ثم قد قصرت وما قصر الحب % كأني جعلته من تلادي % % 8(@)(@@) % لثقال الأعجاز تمشي الهوينى % % مثل غصن الريحانة المياد % 9(@)(@@) % ضحكت لي عن 
ms114	 بارد الطعم عذب % مستنير كالكوكب الوقاد % 10(@)(@@) % ثم راقت باللون والعين حتى % % كاد حبي يطير بي عن وسادي % % PageV01P447 11(@)(@@) % هي بدر السماء ، لا بل هي الشمس % مس تدلت في مذهب وجساد % % 12(@)(@@) % لا أسر الحساد فيها وتمسي % % ندبة في مسرة الحساد % % 13(@)(@@) % تترك القرب ثم تعقب بالبع % % د فويلي من قربها والبعاد % % 14(@)(@@) % وجواد في النوم يعطيني النفس % وليست يقظى لنا بجواد % 15(@)(@@) % تحسن المشي في المنام ولا تحسن % % يقظى مشي المريب المصادي % % 16(@)(@@) % الحب في منطقي وعيني باد % في منطقي وعيني باد % % 17(@)(@@) % ليس يخفى طرف المحب ولا كس % رة عين العدو عند اعتيادي % % 18(@)(@@) % حشر عين يلقى البغيض ولا يلقى % % لقى محبا عينان دون ازدياد % % 19(@)(@@) % ولقد قلت إذ جفيت ولم أجف % % وكانت بليتي من ودادي % % 20(@)(@@) % ليت حظي من العباد ومما % % خلق الله لذة للعباد % PageV01P448 21(@)(@@) % ريق ( حبى ) أحسوه سبعة % أيام شفاء لقرحة بالفؤاد % 22(@)(@@) % إنها منيتي وحاجتي الكبرى % % ونفسي لو متعتني بزاد % 23(@)(@@) % أشتهي قربها على العسر والي % % وعند الضيا ويوم التنادي % % 24(@)(@@) % قل لها يا فرير إني من الشو % ق إليها وحدتي في جهاد % 25(@)(@@) % كيف صبري فردا على غير نيل % طال هذا بخلا وطال انفرادي % % PageV01P449 البحر : منسرح 1(@)(@@) % راحت سليمى تدعوك بالعند % وبالمنى في غد وبعد غد % % 2(@)(@@) % قالت : سنلقاك فرط سابعة % فقلت : يا بردها على الكبد % 3(@)(@@) % ليت الحديث الذي وصفت لنا % % يكون بيعا بالمال والولد % % 4(@)(@@) % ثم انثنت وانتظرت موعدها % % أرجو وفاء به على الأمد % % 5(@)(@@) % حتى إذا ما عددت سابعة % وزدت سبعا فضلا على العدد % 6(@)(@@) % قالت : بعيني عين موكلة % والأسد حولي فكيف بالأسد % % 7(@)(@@) % ما زلت أغتره وأختله % حتى التقينا يوما ولم نكد % 8(@)(@@) % حتام أدعو الصبى وأتبعه % % والموت دان والله بالرصد ؟ % 9(@)(@@) % كل امرئ تارك احبته % % وصائر تربة من البلد ؟ % 10(@)(@@) % قد كنت أمشي إليك جائرة % فالآن حين اقتصدت فاقتصد % % PageV01P450 11(@)(@@) % فقلت لما التوت بنائلها % % وسملت عينها ولم تذد : % 12(@)(@@) % يا أسمح الناس بالسلام ويا % % أبخلهم بالصفاء والصفد % % 13 
ms115	(@)(@@) % يا قوم نفسي لها معلقة % ما بعد نفسي بصالح جسدي % % 14(@)(@@) % شط علي الهوى يكلفني % % لقيان سعدى وليس بالصدد % % 15(@)(@@) % كروا علي الرقاد أتركها % % وعللوني بها من الوحد % 16(@)(@@) % طال انفرادي بها وما انفردت % % بساهر الليل مائل الوسد % 17(@)(@@) % يشكو إليها هوى يموته % غما ولا يشتكي إلى أحد % 18(@)(@@) % أرمد من نأيها ولو قربت % يوما شفت عينه من الرمد % % 19(@)(@@) % وصاحب قال لي ووافقني % % ملآن وجدا وبات لم يجد : % 20(@)(@@) % لا تعجل الأمر قبل موقته % ما حم آت والنفس في كبد % % PageV01P451 21(@)(@@) % فقلت : غي الشباب يتبعني % % قولي رضينا فنم ولا تجد % 22(@)(@@) % دعني وسلمى أعش بلذتها % % إن ساعفت أو أمت من الكمد % 23(@)(@@) % يا ويحها طفلة خلوت بها ! % ليست ذنوبي فيها من العدد % 24(@)(@@) % فاعهدينا من الظنون على تب % % ليغ واش من قول ذي حسد % % 25(@)(@@) % قد تبت مما كرهت فاحتسبي % % غفران ما جئت غير معتمد % 26(@)(@@) % لما وجدنا قالت لقينتها : % قولي وضينا فنم ولا تجد % % 27(@)(@@) % كانت على ذاك من مودتنا % % إذ نحن من عاتب ومصطرد % 28(@)(@@) % نطوي بها الدهر حين ننكره % طيا ونشفي بها صدى الكمد % % 29(@)(@@) % حتى انثنى العيش من مريرتها % % في صوت حاد يحدو بها غرد % 30(@)(@@) % فاعذر محبا بفقد جيرته % متى يبن من هويت تفتقد % % PageV01P452 البحر : خفيف تام 1(@)(@@) % أنجزي يا سلامة الموعودا % % وتصابي ولا تطيعي الحسودا % % 2(@)(@@) % إن تريني فاد الرقاد من الوجد % % حزينا أجيد فيك القصيدا % % 3(@)(@@) % فلقد كنت لا أسارق بالطر % % ف إلى مثلك الجميع القعودا % % 4(@)(@@) % إن قد شفني هواك فأقصيت % % نصيحي والألطف المودودا % % 5(@)(@@) % قد مللت الأدنى بحبك إذ حل % % فؤادي ولست أهوى العيدا % % 6(@)(@@) % يعلم الله ما ذكرتك إلا % % بت من لوعة الهوى معمودا % % 7(@)(@@) % ذا لسان إذا أردت اعتذارا % من هواكم وجدته مصفودا % % 8(@)(@@) % صدقيني بما أقول فإني % % باعث بالهوى دموعي شهودا % % 9(@)(@@) % لمحب على المودة باك % % أو يكون الصنيع منكم سديدا % % 10(@)(@@) % بات يرجوكمو وذاك بعيد % دونه باب بذلكم مسدودا % % PageV01P453 11(@)(@@) % إن قلبي آلى وفيه لجاج % يوم 
ms116	 بصرته الهوى مستفيدا % % 12(@)(@@) % لا يطيع العذال في هجر سلمى % % أو تصوغوه صخرة أو حديدا % % 13(@)(@@) % فتبعت بالفؤاد حين تألى % % في هواه فلم أوافق سعودا % % 14(@)(@@) % بل أسى بالفؤد فيما اصطحبنا % % غير أني تبعته يوم صيدا % % 15(@)(@@) % ليت أني فقدت قبل اتباعي % % صاح قلبي وكان قلبي الفقيدا % % 16(@)(@@) % إن عصيت الفؤاد حين عصاني % % في هواه إلى التعزي سديدا % % 17(@)(@@) % فلقد كاد ما أكابد منها % % ومن القلب يتركاني حريدا % % 18(@)(@@) % مولعا بالخلو مما ألاقي % % أحسب العيش أن يكون الوحيدا % % 19(@)(@@) % لا يقضي العجيب مني أبو حر % ب وينسى الذي ضمنت الوليدا % % 20(@)(@@) % علق من هوى سلامة في % % القلب أراه سيبلغ المجهودا % % PageV01P454 21(@)(@@) % قال : أذرى المرعث الدمع فانه % % نظاما وكان عهدي جليدا % % 22(@)(@@) % ما لعينيك لم تذوقا من اللي % % ل رقادا ولم تريدا جمودا % % 23(@)(@@) % قلت : عين بكت من الشيب إذ حل % وأخرى ممن يريني الصدودا % % 24(@)(@@) % لو تجلت غيابة الهم عن قلبي % % إلى يافع أطعت الرشيدا % % 25(@)(@@) % صردت هامتي سلام وما كا % % ن لديهن مشربي تصريدا % % 26(@)(@@) % كيف لا يكثر البكاء وقد كنت % % ربيحا عند الغواني صيودا % % 27(@)(@@) % كل بيضاء كالمهاة استعارت % لك أم الغزال عينا وجيدا % 28(@)(@@) % زانه الشذر والفريد على النحر % نظاما بل زان ذاك الفريدا % % 29(@)(@@) % فإذا هن قد نفرن من الشيب % يب وأوقدن للوداع وقودا % % 30(@)(@@) % كل شيء إلى انقطاع مداه % وصروف الأيام تبلي الجديدا % % PageV01P455 31(@)(@@) % ونديم نادمته عامري % كزياد عين الندى أو يزيدا % % 32(@)(@@) % ليلة تلبس البياض من الشهر وأخرى % % تدني جلابيب سودا % % 33(@)(@@) % فلهونا هذي وهذي ولم نأ % % ت حراما فيها ولا تفنيدا % % 34(@)(@@) % حيث نطوي الفحشاء والفحش إن قي % % ل عفافا وننشر المحمودا % % 35(@)(@@) % ولدينا حلو الثنا صيدحي % بهوانا تزيده الكأس جودا % % 36(@)(@@) % فارغ اللب للنجيم إذا اش % % تف ثلاثا ألفيته غريدا % % 37(@)(@@) % ضمن الكأس ذا السماح ولا يؤ % % ذي جليسا ولا يصافي العبيدا % % 38(@)(@@) % بيديه مثل المصلي من الليل % % سجودا حينا وحينا ركودا % % 39(@)(@@) % لا تبيت الكئاس منه إذا ما % % قابلته الكئاس إلا 
ms117	 سجودا % % 40(@)(@@) % ثم فرقتهم أميد غدوا % وحري ندمانهم أن يميدا % % PageV01P456 41(@)(@@) % وغدوا أو تروحوا بعد أخدا % % نا يجرون حين راحوا البرودا % % PageV01P457 البحر : بسيط تام 1(@)(@@) % تعجبت جارتي مني وقد رقدت % عني العيون وبات الهم محتشدا % % 2(@)(@@) % قالت لسعدى وأخرى من مناصفها % % ما هاج هذا وقد خيلته هجدا % % 3(@)(@@) % قالت فقلت لها ما زلت أكتمكم % % وساوس الحب حتى ضاف فاعتمدا % % 4(@)(@@) % أرقت من خلة باتت وساوسها % % تسري علي وباتت دارها صددا % % 5(@)(@@) % حوراء كانت هوى نفسي ومنيتها % % لو قرب الدهر من لقيانها أمدا % % 6(@)(@@) % ولو تكلم محمولا جنازته % قد مات بالأمس أو ترثي له خلدا % % 7(@)(@@) % فالقلب صب معنى حين يذكرها % % والعين عبرى تقاسي الهم والسهدا % % 8(@)(@@) % ما إن رأيت كمشعوف بحبكمو % % يبقى ولا مثلكم يعتل لو رقدا % % 9(@)(@@) % وعدتني ثم لم توفي بموعدة % % فكنت كالمزن لم يمطر وقد رعدا % % 10(@)(@@) % إذا نأيت دعاني منكمو نكد % فإن دنوت منعت النائل النكدا % % PageV01P458 11(@)(@@) % بليت والنأي متروك على حزن % ولا أرى القلب إلا زادني بعدا % % 12(@)(@@) % أرعى من العهد والميثاق حقهما % % لا يصلح الحر إلا حفظ ما وعدا % % 13(@)(@@) % إني حلفت يمينا غير كاذبة % عند المقام ولم أقرب له فندا : % 14(@)(@@) % لو خير القلب من يمشي على قدم % % لاختار سعدى ولم يعدل بها أحدا % % 15(@)(@@) % لو ساعفتنا وصد الناس كلهمو % % لما وجدت لفقد الناس مفتقدا % % 16(@)(@@) % تركتني مستهام القلب في شغل % لهفان لا والدا أهوى ولا ولدا % % 17(@)(@@) % أخا هموم وأحزان تأوبني % % فاخشى إلهك إني ميت كمدا % % 18(@)(@@) % كأنني عابد من حب رؤيتها % % إن المحب تراه مثل من عبدا % % 19(@)(@@) % لا أرفع الطرف في النادي إذا نطقوا % % ولا أزال مكبا بينهم أبدا % % 20(@)(@@) % بهم نفس معناة بذكركمو % % إذا أقول خبا مشبوبه وقدا % % PageV01P459 21(@)(@@) % والقلب عندك مأخوذ مسامعه % فلا يروعه من قام أو قعدا % % 22(@)(@@) % أبليت جسمي فنفسي غير آمنة % أن يدرك الروح ما قد خامر الجسدا % % 23(@)(@@) % ألا تحرجت مما قد رميت به % وسط النساء لمن أفنى وقد رقدا % % 24(@)(@@) % لو كان ذا 
ms118	 قوة أعفت جلادته % وقد أزيدعلى ذي قوة جلدا % % 25(@)(@@) % لكن في الحب أسقاما منهلة % لذي الحلاوة حتى يجهد الكبدا % % 26(@)(@@) % فلن أكون حديدا في مقالتكم % % كما خلقت ولا صوانة صلدا % % 27(@)(@@) % قالت : أراك تعزى عن زيارتنا % % وقد يزور بيوت الحي من وجدا % % 28(@)(@@) % فقلت : إني عداني أن أزوركمو % % قوم يبيتون من بغضائنا رصدا % % 29(@)(@@) % مغفلون عن الخيرات عندهمو % % من فطنة الشر علم لم يكن رشدا % % 30(@)(@@) % ما ضر أهلك يا سعدى فقدتهمو % % من عاشق زار لو قالوا له سددا % % PageV01P460 31(@)(@@) % إن التجهم عدى عن زيارتكم % ممن علقت وأمسى ذاك قد جهدا % % 32(@)(@@) % مخلأ بات يرعى كل بارقة % لو كان يصفو له ورد لقد وردا % % 33(@)(@@) % فأرسلت حين كل الطرف : إنهمو % % قد نوموا فأتنا إن كنت مفتأدا % % 34(@)(@@) % ووطنت تربها الحولاء ليلتها % % قبل الرسالة حتى أصبحت عضدا % % 35(@)(@@) % ولم أدع زينة حتى لبست لها % % من الجديد لكي ألمم بهن غدا % % 36(@)(@@) % في ليلة خلف شهر الصوم ناقصة % تسعا وعشرين قد أحصيتها عددا % % 37(@)(@@) % حتى ارتقيت إليها في مشيدة % دون السماء تناغي ظلها صعدا % % 38(@)(@@) % لما رأت لمحة مني مرعثة % خضرا وحمرا وصفرا بينها جددا % % 39(@)(@@) % قالت لترب لها كانت موطنة % جاء المرعث فاثني عندك الوسدا % % 40(@)(@@) % وأحسني حين تلقيه تحيته % ولا تكوني إذا حدثتنا وتدا % % PageV01P461 41(@)(@@) % خفي قريبا وعودي إن حاجتنا % % دون القريبة في قلبين قد كمدا % % 42(@)(@@) % طال التنائي فكل غير مترك % حتى تري عاتبا منا ومصطردا % % 43(@)(@@) % حتى التقينا فمن شكوى ومعتبة % تكرها لا نخاف العين والرصدا % % 44(@)(@@) % غاب القذى فشربنا صفو ليلتنا % % حبين نلهو ونخشى الواحد الصمدا % % 45(@)(@@) % قالت : فأنى بنفسي جئت مسترقا % من العدو تخطى الوعر والجددا % % 46(@)(@@) % جور أتى بك أم قصد فقلت لها : % ما زلت أقصد لو تدنين من قصدا % % 47(@)(@@) % لا تعجبي لاجتيابي الليل منسرقا % ما كنت قبلك رعديدا ولا بلدا % % 48(@)(@@) % يا رب قائلة يوما لجارتها % % إن المرعث همي غاب أو شهدا % % 49(@)(@@) % صددت عنها فلم أدمن زيارتها % % إلى هواك فلم تجزي به 
ms119	 صفدا % % 50(@)(@@) % لما قضينا حديثا من معاتبة % وكاد يبرد هذا الشر أو بردا % % PageV01P462 51(@)(@@) % جاءت بأزهر لم تنسج عمامته % إذا الزجاجة كادت كأسه سجدا % % 52(@)(@@) % ريان كالريم خداه ومذبحه % إن لم يرع بسجود سامرا ركدا % % 53(@)(@@) % نلهو إليه ونشكو بث أنفسنا % % في سلوة وزوال الليل قد أفدا % % 54(@)(@@) % حتى إذ طارق ثارت عداوته % بأول الصبح كانت صالحا فسدا % % 55(@)(@@) % قامت تهادى إلى أهل تراقبهم % مشي البهير ترى في مشيه أودا % % 56(@)(@@) % والعين تحدر دمعا جد واكفة % على مساقط دمع كان قد جمدا % % 57(@)(@@) % كأنه لؤلؤ رثت معاقده % فانساب أوله في السلك فاطردا % % 58(@)(@@) % وقمت لم أقض منها إذ خلوت بها % % إلا الحديث وإلا أن أمس يدا % % 59(@)(@@) % حتى خرجت فكان الدهر مندحلا % بين القرينين حلالا لما عقدا % % PageV01P463 البحر : مجزوء الخفيف 1(@)(@@) % اسقني يابن أسعدا % % قبل أن ينزل الردى % % 2(@)(@@) % شربة تذهب الهمو % % م وتشفي المصردا % % 3(@)(@@) % اسقني ثم غنني % % لا أرى النجم عردا % % 4(@)(@@) % أنقدت عيني الكرى % % من رعى الهم أنقدا % % 5(@)(@@) % إن فاها أشهى % % إلي رضابا وموردا % % 6(@)(@@) % من جنى النحل بالنقا % % خ زلالا مبردا % % 7(@)(@@) % شاقني صوت طائر % زار إلفا فغردا % % 8(@)(@@) % إن ( حبى ) بحبها % % تركتني مسهدا % % 9(@)(@@) % أمسكتني على الصبا % % بة حران معبدا % % 10(@)(@@) % آمل العيش تارة % وأرى الموت أسودا % % PageV01P464 11(@)(@@) % فهمومي مطلة % بادئات وعودا % % 12(@)(@@) % لم تدع لي عند الملا % % ئح والله موعدا % % 13(@)(@@) % يا ابنة الخير قد ملك % ي ، أنا الفدا % % 14(@)(@@) % لج من حبك الطري % % فأطرقت واعتدى % % 15(@)(@@) % أعتقيني من الهوى % % أو عدي منك موعدا % % 16(@)(@@) % أطمعينا كيما نعيش % وقولي لنا : ( غدا ) % 17(@)(@@) % أنت همي مع القرين % ين وإن رحت مفردا % % 18(@)(@@) % حبذا أنت يا حبا % % بة والعود والندى % % 19(@)(@@) % وحديث من الخلا % % ء من العين والعدى % % 20(@)(@@) % يا ابنة الخير قد % ك تداوي به الصدا % % PageV01P465 21(@)(@@) % وشراب معتق % يترك الشيخ مقعدا % % 22(@)(@@) % ذاك عيش لو دام لي % % عشت فيه مخلدا % % PageV01P466 البحر : بسيط تام 1(@)(@@) % يا صاحبي دعا لومي وتفنيدي % % فليس ما فات من 
ms120	 أمر بمردود % 2(@)(@@) % ما للفتى غير ما أعطى الإله وما % % يمنع فذلك شيء غير موجود % 3(@)(@@) % والأمر صعب إذا أخطأت وجهته % حتى توفق منه للمراشيد % 4(@)(@@) % فليت شعري على قيل الوشاة لنا % % إذ أزمع الحي وانصاعوا لتصعيد % 5(@)(@@) % حيث استقلت وصدت لا تكلمنا % % والدمع يجري على الخدين والجيد % 6(@)(@@) % قد كنت آمل من نعم مواعدها % % فما وأت لي وما جاءت بموعود % PageV01P467 البحر : طويل 1(@)(@@) % لقد ذكرتني ليلة القدر مجلسا % لثنتين من شعب على غير موعد % 2(@)(@@) % سرى بهما شوق إلي فجاءتا % % على وجل من أقربين وحسد % % 3(@)(@@) % وكاتمتا أخرى هواي وغرتا % % أميرهما مني بنسك ومسجد % 4(@)(@@) % كعاب وأخرى كالكعاب خريدة % ثقال ولم تستشعرا عيش جحد % % 5(@)(@@) % فنبهني زيد فقمت إليهما % % أجر أسابي الكرى غير مرقد % 6(@)(@@) % فلما التقينا بالحديث تبسمت % إلي وقالت : بيت أمن فأنشد % % 7(@)(@@) % فعللتها حتى تسحر طائر % وكادت تقضى سورة المتهجد % % 8(@)(@@) % تقول لي الصغرى الصلاة وقد دنت % شواكل توديع الإمام المؤيد % % 9(@)(@@) % وإن مر مجتاز علينا تقنعت % مخافة قول الفاحش المتزيد % % 10(@)(@@) % فقلت لها : ألقي الصلاة وأنثني % % شفاعة من يأوي لحران مقصد % PageV01P468 11(@)(@@) % تبدل من حب الصلاة حديثنا % % وكنت أراه غاية المتعبد % 12(@)(@@) % فيا مجلسا لم نقض فيه لبانة % ويا ليلة قد كنت عنها بمقعد % 13(@)(@@) % إذا العاتق العسراء عتقت الهوى % % تيسر من أخرى لنا غير منكد % 14(@)(@@) % لعمرك ما ترك الصلاة بمنكر % ولا الصوم إن زارتك ' أم محمد ' % 15(@)(@@) % فتاة لها عندي دخيل كرامة % وساعف حب من طريف ومتلد % 16(@)(@@) % أهيم بكم يا ( حمد ) إن كنت خاليا % وأنت حديث النفس في كل مشهد % 17(@)(@@) % وما كنت أخشى أن تكون منيتي % % مودتكم يوما وكنت بمرصد % 18(@)(@@) % وللقلب وسواس من الحب يغتدي % % ورائح روعات الهوى المتردد % 19(@)(@@) % وكل خليل بعد عينك عينه % % ستنكرني إلا بقايا التجلد % % 20(@)(@@) % تضمخ بالجادي إذا ما تروحت % وتأوي إذا قالت إلى كن مسجد % PageV01P469 21(@)(@@) % إذا قلت : أوفي العهد قالت وأعرضت : % ستدرك ما قد فاتك اليوم في غد % % 22(@)(@@) % فلم تر عيني مثلها 