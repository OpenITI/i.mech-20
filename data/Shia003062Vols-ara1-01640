ms1621	 أبو عبس وأبو عيسى بالشك " (4) كو " قال " وبهامشها " ح أآلهتنا قاله ".(@)(1) من كو (2) من قط وبهامش كو " ح مرسل " (3) كو " وتقاسموهم " وعليه " صح " وبهامشها " ح فتقاسموهم " وضبب عليه (4) بهامش و " ح الشطر " (5) من كو (6) من قط (7) كتب عليه في كو " صح " وبهامشها " أآلهتنا أبو عاصم " وضبب عليه، وبهامش قط " أبو عصام هو رواد بن الجراح " (8) كو " هو ابن محمد " كذا وهو خطأ - ح.(@)(1) عليه في كو " صح " وبهامشها " ح ص الحدسين " وضبب عليه وكأنه " المجذمين " - ح(@)(1) بهامش كو " ح أآلهتنا - تكنوا " وكتب عليه " صح " (2) كتب فوقها في كو " أآلهتنا نزل " (3) كو " وروى.(@)(1) سقط من كو فصارت العبارة الآتية كأنها ترجمة مستقلة - (2) جعل ابن أبي حاتم لهذا ترجمة أخرى فهو عنده غير أبى غرارة (3) كو " ثنا ".(@)(1) من كو (2) من قط (3) كو " أخبرنا " (4) كو " حدثنا " (5) بهامش كو " بلغ العرض " (6) قال ابن أبي حاتم في ترجمة محمد بن عبد الرحمن بن نوفل المتقدم رقم (435) " اخرج البخاري اسم محمد بن عبد الرحمن بن عبد الله روى عن طريف البراد روى عنه محمد بن إسحاق فسمعت أبي يقول هو أبو الأسود " كتابه (3 / 2 / 321) ثم أعاد ص 324 " محمد بن عبد الرحمن روى عن طريف البراد عن أبي هريرة روى عنه محمد بن إسحاق سمعت أبي يقول ذلك " - ح(@)(1) بهامش كو " ح المستملى المدني " (2) من كو (3) قط " يشبهه ".(@)(1) كو " قال " وبهامشها " ح - قاله " (2) ذكره ابن أبي حاتم (6 / 2 / 322) فقال " روى عنه ابن أبي ذئب حديث أم سلمة مرفوع فيمن أهل من بيت المقدس " ثم قال " اخرج البخاري هذا الاسم في كتابه وذكر أنه روى عنه الدراوردي وابن أبي فديك فقال أبو زرعة انما هو محمد بن عبد الله بن عبد الرحمن بن يحنس روى عنه ابن أبي فديك " (3) قط " عن ابن أبي سفيان ".(@)(1) بهامش كو " ح أبيه " وضبب عليه (2) كذا.(@)(1) من كو (2) كو " قال " وفوقه " ح قاله ".(@)(1) كو " أراه عن بقية " (2) جعله ابن أبي حاتم والمتقدم رقم (485) واحدا وقد أشار المؤلف إلى ذلك - ح 
ms1622	 (3) هامش كو " خ ص - منذر ".(@)(1) من كو (2) بهامش قط " قال أبو بكر بن ثابت هذا هو الذي روى عنه أبو نعيم ومحمد بن عبيد وأبو أحمد الزبيري وليس بغيره " يعنى انه الذي قبله رقم (494).(@)(1) قسط " أراه أخبرنا " وكانت في كو كذلك ثم ضرب عليها وكتب بالهامش " أبا - صح " وكأنها كانت في أصل قديم " أبا " بغير فقط فتوهمت " انا " اختصار أخبرنا - ح (2) كتب عليه في كو " صح " وبهامشها " ح أآلهتنا أبو عمر " وضبب (3) بهامش كو " ح - ابن أبي الزناد " (4) كو " فوجدهم "(@)(1) بهامش كو " في نسخة أخرى ابن اخى حزم " وكلاهما صحيح أبو حزم له ابنان حزم وعبد الواحد كما في اكمال ابن مأكولا وغيره - (2) من كو (3) سقط من قط.(@)(1) سقط من قط (2) من كو.(@)(1) قط " أخا محمد " كذا.(@)(1) بهامش كو " ص حجت " كذا (2) قط " عن ".(@)(1) ضبب عليه في كو وبالهامش " رأيت بخط ابن ناصر - الصواب اغلاق " (2) كو " الأردني " وكتب بالهامش " أآلهتنا الأزدي " وضبب عليه (3) من كو.(@)(1) من كو والظاهر أنها نعت لمحمد راجع التهذيب (6 / 62) (2) كذا في الأصلين وكتاب ابن أبي حاتم ووقع بهامش كو " في نسخة أخرى سمع منه عمر بن ميمون " كذا - ح (3) هكذا في كو وكتاب ابن أبي حاتم ووقع في قط " العامري ".(@)(1) بهامش كو " في خ أخرى - تغنى بقصيدة - بدل تقول " وزاد في قط بعد تقول كلمة صورتها " تعدل " أو " تغزل " (2) زاد في كو " وضرب على البيت " وكتب عليها " خ " (3) بهامش كو " ابن حبيب بن خريت ".(@)(1) من كو (2) قط " محمد " كذا (3) كو " كريمة وكان ابن عباس لا يرى " وبهامشها " أآلهتنا وقال "(@)(1) من قط (2) هكذا في كو وكتاب ابن أبي حاتم ووقع في قط " بن أبي عبيد ".(@)(1) قط " وقال " (2) سقط من قط (3) من كو (4) بهامش كو " ح الجمحي " (5) كتب عليها في كو " عن " (6) زاد في كو " انه " (7) كو " ثلاثة " (8) كو " الصلوات ".(@)(1) كو " فحدثني " وفوقها " ح حدثني " (2) كو " فيم أنت فأخبره وأدخلني ".(@)(1) أراه إسماعيل بن عياش فان هذه كنيته وهو حمصي ووقع في كو " عتبية " كذا - ح.(@)(1) هو القصاب 
ms1623	 عمران بن أبي عطاء - ح (2) قط " ورجعنا " (3) من قط.(@)(1) كو " ح قال " وفوقها " قاله ".(@)(1) لقب لمحمد هذا كما في التقريب وهكذا ضبط في كو واقتصر في قط على كسر الكاف الثانية - ح (2) كو " بضع ".(@)(1) من كو (2) قط " قال أخبرنا " (3) بهامش كو " آخر الثالث من نسخة ابن عبدان وأول الرابع من اجزائه وآخر الثالث من نسخة أبى النرسي وأول الرابع من اجزائه " وفى قط " آخر الجزء الثالث من اجزاء نسخ الشيخ "(@)(1) من كو (2) بهامش كو " ح سمع " (3) كو " حدثنا "(@)(1) من كو (2) كو " ونهوني "(@)(1) كو " الصوم " وضبب عليه وبالهامش " الصيام - صح "(@)(1) بهامش كو " رأيت بخط ابن ناصر - أآلهتنا حاشية، قال لنا ألح (الحافظ) أبو الغنائم ابن النرسي قال ابن عقدة محمد بن عمرو الهاشمي هذا هو محمد بن عمرو بن الحسن بن علي ثم كرره ههنا وهو رجل واحد - صح " وقد نبه المؤلف على ذلك كما يأتي - ح (2) من قط (3) سقط من قط بقية هذه الترجمة وقوله " محمد بن عمرو " أول الترجمة الآتية.(@)(1) قط " ويغسل ".(@)(1) بهامش قط " ح عقبة " (2) بهامش كو " أآلهتنا ابن سليمان موضع مسلم " وضبب على كلمة سليمان، وقال ابن أبي حاتم " هشام بن مسلم، روى عن عبد العزيز بن أبي روى وروى عنه مرحوم بن عبد العزيز " - ح (3) ستأتي ترجمته في بابه ووقع في كو " حكيم " خطأ - ح (4) ضبطه في كو بضم العين وكذا ضبطه ابن السمعاني في الأنساب وفى قط بكسر العين وفى القاموس بالكسر قال " ويضم " - ح(@)(1) من قط (2) هكذا في قط والتهذيب وغيره ووقع في كو " عمران " وبهامشها " في ح بدل عمران عمير ".(@)(١) قط " استأذن لي يزيد بن زياد " (٢) بهامش كو " بلغ الجماعة بدار الحديث بالموصل... " (٣) كو " بن أبي لبيبة " وكتب على كلمة أبى " خ " (٤) في <a href="/الكتب/41_النهاية">النهاية</a> (أآلهتنا ع د)... بما على السواقي وما سعد من الماء فيها.. أي ما جاء من الماء سيحا لا يحتاج إلى دالية.. " (5) قط " وقال " (6) قط " عن ".(@)(1) كو " سمع منه سعيد " كذا (1) قط " وهو "(@)(1) من قط وبهامش كو " ح الكوفي 
ms1624	 " (2) فوقها في كو " ح المدني ".(@)(1) زاد في قط " عن أبيه " أخرى (2) كو " قال ".(@)(1) هو الطين والوحل الشديد ووقع في قط " الزرع " خطأ (2) بهامش قط " في أخرى، بالسين " (3) من قط.(@)(1) فوقه في كو " ح قال " (2) سقط من قط.(@)(1) قط " يرفعه ".(@)(1) من كو (2) ستأتي ترجمته في بابه ووقع في قط " بشر " خطأ - ح.(@)(@@) (3) يعنى رقم (630) وجزم به غيره - ح.(@)(1) كو " وقال " (2) قط " نسقى " (3) كذا في قط ووقع في كو " حي قبل ".(@)(@@) (4) كو " وقران سأله "(@)(1) زاد في كو " بن مالك " (2) زاد في كو " بن جعفر " ثم علم عليها " ح - إلى " (3) قط " المخزومي " كذا (4) قط " عباس " خطأ - ح (5) هو الطنافسي ذكر ابن أبي حاتم في ترجمته رواية أبى كريب عنه - كتابه (3 / 1 / 123) ووقع في قط " عمرو بن عبيد " كذا - ح.(@)(1) وقع في كو " عمرو " كذا (2) هو ابن رفاعة صرح بن ابن أبي حاتم وستأتى ترجمته (4 / 2 / 70) ووقع في قط " معاذ " خطأ - ح (3) من كو.(@)(1) في قط " آخر الجزء الثالث من اجزاء الشيخ " (2) هذا السند من قط.(@)(1) قط " الأعرج أبو عبد الملك " كذا وفى الطبقة الرابعة من ثقات ابن حبان ترجمة لمحمد هذا وفيها " يروى عن حيان الأعرج عن جابر بن زيد " وفى الثالثة " عبد الملك بن الأشج يروى عن جابر بن زيد.. " ولم يذكروا في ترجمة محمد ولا حبان انه يقال له عبد الملك أو الأشج والله أعلم - ح (2) ضبطه عبد الغني في المؤتلف ص 101 وغيره ووقع في كو " فضالة " خطأ - ح (3) كو " سيئ " (4) بهامش قط " فضالة في أخرى " (5) بهامش كو " أآلهتنا العنسي بالنون - صح " (6) بهامش كو " بلغ الجماعة ".(@)(1) قط " وقال لي " كذا وهو خطأ فان يحيى توفى سنة 194 وفيها ولد المؤلف - ح (2) زاد في قط " لي " وهو خطأ أيضا - ح.(@)(1) زاد في قط " الأسدي " وضبب عليها ولا وجه لها - ح.(@)(1) كو " بنت ابن قيس " كذا (2) كتب عليه في كو " صح " وبالهامش " ح قاص " (3) فرق بينهما أبو حاتم وغيره راجع التهذيب (9 / 414) - ح (4) من قط (5) هكذا في كو وكتاب ابن 
ms1625	 أبي حاتم وستأتى ترجمة حرب في بابه ووقع في قط " وحدث " كذا - ح (6) كو " أخبرنا " (7) كو " لنا " (8) كو " صلى "(@)(1) هو نجيح ذكره ابن أبي حاتم في الرواة عن محمد بن قيس القاص وقع في كو " أبو مغتمر " وبهامشها " معشر " وضبب عليه - ح (2) كو " قصصته " وبهامشها " خ قصصت " (3) زاد في قط " وهو أمير المؤمنين " كذا.(@)(1) كو " وقال " (2) هكذا في قط والتاريخ الصغير المؤلف ذكره فيمن مات بعد المائتين ووقع في كو " وثمانين " خطأ ثم كأنه حاول ان يصلحها ولم يتضح - ح(@)(1) بهامش كو " أآلهتنا عن محمد بن أبي الدارمي روى عنه ابن مهدي " وفى حاشية أخرى " خ كذا عنده لم نعرفه " (2) هكذا في كو وكتاب بن أبي حاتم وسيأتى في أثناء الترجمة كذلك ووقع ها في قط " محمد بن القاسم " (3) قط " وجدوا " (4) قط " محمد بن القاسم "(@)(1) بهامش كو " بلغ العرض بالأصل فصح " (2) قط " حدثني " (3) فوقها في كو " أآلهتنا صح " وبهامشها " ح ص حفظ " (4) كو " حميد بن أبي الأسود " كذا وهو خطأ - ح.(@)(1) زاد في قط " عن أبيه " أخرى (2) هو ابن سليمان صرح به ابن أبي حاتم وغيره ووقع في قط " عبد الرحمن " خطأ - ح (3) كذا وفى هامش قط " بسام في أخرى "(@)(1) سقط من قط (2) قط " ابنه "(@)(1) قط " يحتمل " (2) كذا وكأنه سقط " عن ابن شهاب " - ح(@)(1) قط " استعدت " (2) كو " ما كنت " (3) من كو (4) وقع في كو "...(@)(@@) دينار بسنة حدثنا مسدد " كذا وهو خطأ فقد قال المؤلف في التاريخ الصغير ص 146 " قال على ومات أبو الزبير قبل عمرو بن دينار " ولم يزد وكذا نقله في التهذيب عن المؤلف وزاد " وقال عمرو بن علي والترمذي مات سنة ست وعشرين ومائة وسياق العبارة هنا يدل ان الصواب ما في قط والله أعلم - ح (5) قط " عن ابن عيينة " واراه وهما - ح.(@)(1) بهامش كو " في نسخة أخرى مولى أم قهل بدل فهم " قال مصححه وفى كتاب ابن أبي حاتم " أم قهكم " وفى التهذيب " أم مشكم " وفى الصحابيات أم قهطم واسمها فاطمة بنت علقمة، وقد ذكر المؤلف 
ms1626	 أبا عبد الرحمن هذا في الكنى رقم (443) ولكن سقط هناك لفظ الكنية وذكر روايته عن أبي هريرة والله أعلم - ح(@)(1) من قط وبهامش كو " هذا سالم هو الأفطس " (2) من قط وعلم عليها وكتب بالهامش " ثبت المعلم عليه لغير العذري " (3) ستأتي ترجمته في بابه وضبطه عبد الغنى في المؤتلف ص 134 وغيره ووقع في قط " بسرة " خطأ - ح.(@)(1) من كو والسياق يقتضيها - ح (2) من قط (3) قط " أواق ".(@)(1) من قط (2) بهامش كو " في خ أخرى كعب بن أشرف وأسيع " وشكل أسيع بفتح فسكون ففتح (3) بهامش كو " بلغ الجماعة بدار الحديث المعمورة باربل " (4) قط " تطبق " وفى كتاب ابن أبي حاتم " تطبق جهنم "(@)(1) كو " ابن أبي الأسود " كذا وهو الأسود بن عوف بن عبد عوف له ترجمة في الاستيعاب والإصابة وغيرهما - ح (2) كو " أخو "(@)(1) راجع ترجمة معاذ بن زهرة وما علقناه عليها - ح (2) زاد في قط " عن أبيه كذا - ح (3) كو " استعف الله " وبهامشها " خ استغفر " (4) هو الوسيم ابن جميل صرح به ابن أبي حاتم وصاحب التهذيب وستأتى ترجمته ووقع في كو " الوسيمي " كذا - ح(@)(1) سقط من قط (2) هكذا في كو وكتاب ابن أبي حاتم والثقات، وفى ترجمة مالك بن زبيد من التهذيب (10 / 16) " وقال البخاري في تاريخه روى عن عبد الله بن مسعود روى عنه ابنه محمد " ووقع في قط " عن أبي مسعود " كذا - ح (3) فوقه في كو " صح " وبهامشها أخرى يدل عبد الله بن عثمان عبد الملك بن عثمان الثقفي كذا وهو في الثقات " عبد الله " وكذا في التهذيب عن المؤلف - ح (4) من قط ومر مثله عن هامش كو (5) هكذا في كو والميزان والتهذيب (9 / 422) وذكره الدولابي في الكنى (2 / 24) ووقع في قط " ابن المغيرة " خطأ - ح (6) هكذا في قط والكنى ووقع في كو " حادى " وبهامشها " خادم " وفى كتاب أبى حاتم " مولى " وفى التهذيب " مولى البراء ويقال خادمه " - ح(@)(1) هو صديق أبى حفص التنيسي ستأتي ترجمته في بابه - ح (2) لفظ ابن أبي حاتم " محمد بن معن بن نضلة بن عمرو الغفاري " وسيأتى 
ms1627	 كذلك في ترجمة محمد بن معن ولما تأخر هنا لفظ " ابن عمرو " وقع اشتباه فوقع بهامش قط " خ - عن عمرو " ونحوه بهامش كو - ح.(@)(1) كو " استقبل " وفى كتاب ابن أبي حاتم " إذا استقبل " - ح (2) هكذا شكله في قط وهكذا ضبطه عبد الغني في المؤتلف ص 412 وغيره وشكله في كو كمعلم - ح (3) يحيى لعله ابن سعيد القطان ومحمد هو صاحب الترجمة ووقع قط " يحيى بن محمد " خطأ - ح (4) قال ابن أبي حاتم " محمد بن مهزم الشعاب ... يقال الرمام يرم القصاع " أقول والشعاب بمعناه يشعب القصاع ويرمها أي يصلحها إذا انكسرت - ح (5) هو سعيد بن عبد الله بن جريج ستأتي ترجمته - ح (6) وقع في بعض الكتب " الثعلبي " كما يأتي في ترجمة مجاشع - ح.(@)(1) هكذا جاءت هذه الترجمة في الأصلين وذكر له في قط ترجمة أخرى مختصرة بعد ترجمة " محمد مولى بنى تميم " واعلم عليها وكتب بالهامش " المعلم عليه ثبت لغير العذري " (2) في قط في الترجمة المزيدة " مرة عبد الله ومرة محمد ومرة عبد الله أو محمد والصحيح محمد " وكذلك حكاه في التهذيب (3 - 389) عن المؤلف الا انه لم يذكر " والصحيح محمد " - ح (3) قط " عمر " كذا (4) فوقها في كو " ح - قوله ".(@)(1) كذا (2) في هامش كو " بلغ الجماعة بدار الحديث بالموصل ".(@)(1) هكذا في قط والتهذيب (9 / 485) وفى كتاب ابن أبي حاتم في ترجمة عبد الوهاب وكذا في لسان الميزان (4 / 87) ووقع في كو " حسين " كذا - ح (2) أراه أحمد بن أبي الطيب المروزي واسم أبى الطيب سليمان ذكر المزي في ترجمته روايته عن محمد بن ميمون الزعفراني - ووقع في كو " أحمد بن أبي سليمان " وكتب عليه صح " كذا ح.(@)(1) هكذا افردها في قط وألحقها في كو بالترجمة السابقة - قال ".. روى عنه شعبة، ومحمد بن مرة.. " - ح (2) سقط من قط (3) بهامش كو " في أخرى العدوية " (4) كذا وقع هنا " أبا الزوائد " وقال ابن أبي حاتم " روى عن أبيه عن ذي الزوائد " وسيأتى في الجلد الرابع ترجمة مطير رقم (2006) وفيها " سمع ذا الزوائد " وستأتى ترجمة ذي الزوائد 
ms1628	 في باب الذال وفيها رواية سليم بن مطير عن أبيه عنه ولكن في الإصابة انه قد روى فيه " أبو الزوائد " بدل " ذو الزوائد " والله أعلم - ح(@)(١) قال في <a href="/الكتب/41_النهاية">النهاية</a> " يريد إذا تقاتلوا على الملك " ووقع في كو " تحاحقت " وبهامشها " أآلهتنا فإذا تجاحفت " وعليه " صح " - ح.(@)(1) هكذا في كو وكتاب ابن أبي حاتم ووقع في قط " الخضر " وسيأتي في ترجمة حفص بن عبد الله بن أبي طلحة ".. قال نا عمر بن يونس قال حدثنا محمد بن موسى اليمامي عن حفص الأنصاري سمع عمه انسا قال النبي صلى الله عليه وسلم أنت مع من أحببت " فالله اعلم - ح (2) بهامش كو " في أخرى - العنزي - بدل العتري، والصواب العتري " وبهامش قط " عتر من بنى رؤاس رهط وكيع بن الجراح " (3) اسمه دينار تأتى ترجمته في بابه وفيها رواية محمد بن موسى هذا عنه ووقع في قط ".. بن يسار أبو عبد الله " كذا - ح.(@)(1) بهامش كو " في خ أحرى عمر بن عبيد الله بن عمرو " أقول ذكر ابن أبي حاتم في باب عمرو " عمرو بن عبيد الله الأنصاري.. روى عنه مالك وسليمان بن بلال " - ح (2) سقط من قط (3) وقع في قط " ثقة " وبهامشها " يعد "(@)(1) كو " يسئ " وبهامشها " أآلهتنا - سيئ " وعليه " صح " (2) في لسان الميزان (5 / 381) انه عباس بن عبد الرحمن بن ميناء لكن وقع في النسخة - " سياز " بدل ميناء وستأتي ترجمته في المجلد الرابع رقم (14) وهناك ترجمة أخرى رقم (20) " عباس بن مسلمة عن أبي سعيد " كذا وقعت في النسخة وكذا طبعت واخشى ان أن يكون الصواب هناك " عباس عن محمد بن مسلمة عن أبي سعيد " والله أعلم.(@)بهامش كو " في نسخة أخرى ما لرأى أبي حنيفة " كذا قال.(@)(1) قط " قال نا " (2) هو عقبة بن عامر يروى عنه ثمامة بن شفى أبو علي الهمداني كما يأتي في ترجمة ثمامة - ح (3) من قط (4) هذه الترجمة من قط وأعلم عليها وكتب بالهامش " المعلم عليه ثبت لغير العذري " ولهذا الرجل ترجمة عند ابن أبي حاتم ولكن قال " الحمصي " وكذا 
ms1629	 في الميزان ولسانه وفيهما ان كنيته " أبو أسلم " وكذا ذكره في كنى اللسان فالله اعلم - ح (5) لم أجد هذا الرجل وذكر ابن أبي حاتم رواية محمد بن مخلد هذا عن مالك وغيره، وفيه في الافراد من باب الحاء " حجوة بن مدرك كوفي سكن دمشق " وذكر روايته عن مكحول وغيره وانه روى عنه هشام بن عمار وعثمان بن عبد الرحمن الطرائفي، وكذا ضبطه ونسبه ابن مأكولا في الاكمال " حجوة بن مدرك " وذكره ابن عساكر في تاريخ دمشق " حجوة بن مدرك الغساني.. " تهذيبه (5 / 87) فالله اعلم - ح.(@)(1) بسطت الكلام عليه في ترجمة قرين من هذا الكتاب ج 4 رقم (885) ووقع هنا في كو " قرير " وضبب عليه وبهامشها " قرين " وصحح عليه، وبهامش قط " قريم " حطأ - ح (2) قط " اغتسل " (3) من قط (4) يحتمل هذا ثلاثة أوجه الأول أن يكون متعلقا بصاحب الترجمة أي انه محمد بن مسور بن إبراهيم بن عبد الرحمن بن عوف وقد جزم به ابن مأكولا عند ذكر قرين، الثاني أن يكون متعلقا بقرين أي انه قرين بن إبراهيم بن عبد الرحمن بن عوف، وقد قال ابن مأكولا " قرين بن إبراهيم وقيل إنه ابن عبد الرحمن بن عوف " الثالث أن يكون متعلقا بإبراهيم بن سعد أي انه إبراهيم بن سعد بن إبراهيم بن عبد الرحمن ابن عوف وصرح به ابن أبي حاتم في هذه الترجمة - ح.(@)(1) شافع بن السائب هو جد الإمام الشافعي رحمه الله وكأن سعيد بن سليمان تحرف عليه " مسافع " فصار " شافع " ثم كمل النسب من عنده والله أعلم - ح (2) قط " عبد المطلب " وهو خطأ واضح (3) قط " وقال " (4) بهامش كو " خ وروى "(@)(1) كو " وعن حوشب مثله عن حبيب " والله أعلم - ح (2) من كو (3) هكذا في الأصلين وتهذيب التهذيب ووقع بهامش كو " في خ أخرى بدل بسام سالم ".(@)(1) هو الحراني صرح به ابن أبي حاتم وغيره وقد تقدمت ترجمته رقم (302) ووقع في قط " مسلمة " كذا - ح (2) هكذا في قط وهكذا ضبطه ابن السمعاني في الأنساب الورقة (352) الوجه الثاني قال " ويقال له 
ms1630	 الصاغاني أيضا " ووقع في كو " الصنغاني " خطأ - ح.(@)(1) هكذا في كتاب ابن أبي حاتم وتاريخ بغداد (3 / 271) والتهذيب (10 / 464) وزاد (الحراني " ومحمد بن سلمة الحراني قد تقدمت ترجمته رقم (302) ووقع في الأصلين " مسلم " وبهامش كو " في خ أخرى - محمد بن سلمة مراسيل " - ح (2) كذا وقع في الأصلين ولم يذكره ابن أبي حاتم ولا ابن حبان كأنهما يريان ان الصواب محمد بن معن الذي تقدمت ترجمته رقم (9 7) فقد ذكره في التهذيب في شيوخ يعقوب بن محمد الزهري (11 / 396) وفى الرواة عن عمارة بن عبد الله بن صياد (7 / 419) وفى ترجمة عمارة من كتاب ابن أبي حاتم ما يعلم منه انه ينسب إلى جده يقال " عمارة بن صياد أو ابن الصياد " وكذا في التهذيب وفيه انه يروى عن جابر - ح (3) قط " قرين " كذا.(@)(1) هكذا ضبطه عبد الغني في المؤتلف ص 123 وغيره ووقع في قط " مجيب " وكذلك صنع ابن أبي حاتم فإنه عقد بابا لمن اسمه محمد واسم أبيه مجيب فذكر فيه هذا ومحمد بن مجيب الثقفي، وآخر، كذا صنع - ح (2) قط " الدقيق " كذا والله أعلم (3) قط " سليم " وبهامش كو " خ سلم " والله أعلم - ح (4) كو " وهب بن سليمان بن أسيد " كذا وترجمة وهب بن سليمان عند المؤلف وابن أبي حاتم ولم يرفعا نسبه - ح.(@)(1) زاد في قط هنا ترجمة " محمد بن أبي المجالد.. " وقد تقدمت ترجمة هذا الرجل رقم (715) وأشرنا إلى هذه الزيادة - ح (2) من قط (3) ضبطه ابن مأكولا وقال عبد الغني في المؤتلف ص 117 " محمد بن عبيد بن عمير المحرم " وفى الميزان ثلاث تراجم " محمد المحرم " " محمد بن عمر المحرم " " محمد بن عبد الله بن عبيد بن عمير الليثي المكي ويقال له محمد المحرم " وفى اللسان انهم واحد وفى الترجمة سبب تلقيبه وهو أنه كان يحرم بالحج السنة كلها وأنكر عليه عكرمة ذلك وقال له " ما اعلم أحد أشرا منك " وقد تقدمت ترجمة محمد بن عبد الله بن عبيد ابن عمير رقم (424) - ح.(@)(1) بهامش كو " في خ أخرى 
ms1631	 عصمة عقبة " وبهامش قط " خ عقبة " وستأتى ترجمة عصمة بن سالم ج 4 رقم (291) ووقع فيها " روى عن الفضل ابن معدان ومحمد بن نوح " كذا وقع في الأصل هناك الصواب " روى عنه " فلينبه عليه - ح.(@)(1) في ترجمة عبد الله من الإصابة انه وقع في بعض الروايات، " عمير " ورجحه بالاتفاق على أن اسم عمته سهيمة بنت عمير قال " الا أن تكون سهيمة أخت أبيه من امه " - ح (2) قط " المدني " والصواب " المزني " كما يعلم من مراجعة ترجمة عبد الله وسهيمة - ح (3) بهامش قط " خ شهيمة " وهو خطأ ح (4) سقطت من كو (5) لم يذكره ابن أبي حاتم وذكره ابن حبان وقال " لا يعتد به إذا انفرد " - ح (6) من قط.(@)(1) في التهذيب ترجمتان " محمد بن أبان بن عمران.. " و " محمد بن أبان بن وزير.. " وذكر أن البخاري روى في صحيحه عن محمد بن ابان عن محمد بن جعفر غندر في موضعين من الصلاة فقيل هو الأول وقيل هو الثاني، ووقع بهامش كو " في خ محمد بن بشار " وكتب بعده صح وهو والله أعلم - ح (2) شكله في كو بفتح النون وبالهامش " الصواب بكسر النون " وضبطه ابن مأكولا في الاكمال بالكسر ثم قال " وقيل فيه محمد بن النيل بفتح النون " - ح (3) هو يحيى بن عبد الله بن بكير ينسب كثيرا إلى جده يروى عن الليث ووقع في كو " يحيى بن أبي بكير " واراه خطأ - ح (4) شكله في كو بفتحة على الواو وكتب عليه " خف " يريد أنه بالتخفيف وبالهامش " ح أآلهتنا أبى النوار بتشديد الواو " والمعروف التخفيف - ح(@)(1) هو عبد الرحمن بن أبي بكرة صرح به ابن أبي حاتم ووقع في قط " عن ابن بكرة " كذا - ح (2) بهامش قط " سعيد - صح " كذا ح (3) هو بريد بن عبد الله بن أبي مريم بصرى كصاحب الترجمة ووقع في قط " يزيد " واراه تصحيفا فان يزيد بن أبي مريم شامي - ح (4) تقدم ضبطه فما علقناه على رقم (311) ووقع في الأصلين " حيان " كذا وفرق ابن أبي حاتم بين الراوي عن ابن أبي 
ms1632	 بكرة والراوي عن حبأن السلمي وحكاه في اللسان (6 / 408) ثم قال " قال النباتي جمعهما البخاري وهو أشبه " - ح (5) بهامش كو " خ - الدفنية - مقدم النون " وراجع ما علقناه على رقم (311) - ح (6) هكذا في قط وهو في كتاب ابن أبي حاتم والثقات وصفة الصفوة (3 / 93) " النضر " ووقع في كو " نصر " كذا - ح.(@)(1) كو " قال " (2) كذا في الأصلين وشكل في كو حزور كجعفر ولمحمد بن نشر ترجمة في التهذيب (9 / 488) وعد في الرواة عنه علي بن الحزور ولعلى بن الحزور ترجمة عندهم وضبطه اسم أبيه في التقريب وغيره بفتح المهملة والزاي وتشديد الواو مفتوحة ولم يذكروا كنيته ولا أنه غنوي فالله اعلم - ح(@)(1) كو " مات بالشام هي بالرصافة " كذا - ح.(@)(1) من قط (2) كتب فوقها في كو " خ - لي " (3) قط " ما بعته ".(@)(1) قط " عنده عسر " كذا (2) في هامش " آخر الجزء الرابع من اجزاء الشيخ أبي ذر " (3) ليس في قط.(@)(1) بهامش قط " قال عبد الغني - يقال هدية وهدبة " وتمام عبارة عبد الغني " بضم الهاء وفتح الياء " المؤتلف ص 132 يعنى ان الثاني بالتصغير - ح.(@)(1) هو ابن اياس ستأتي ترجمته ج 4 رقم (2650) وفيها روايته عن سعيد بن جبير ووقع في قط " وفاء " - ح (2) بهامش كو " بلغ الجماعة ".(@)(@@) (3) بهامش كو " ح ص - يزيد - صح " وقد قيل في والد عبد الحميد يزيد والأكثر انه زياد وستأتى ترجمة عبد الحميد وترجمة أبيه زياد ولم يترجم المؤلف وابن أبي حاتم ليزيد بن صيفي وذكره ابن حبان في الثقات وقال في ترجمة صيفي " روى عنه.. وابناه زياد ويزيد " وقال ابن أبي حاتم في ترجمة محمد هذا " سمعت أبي يقول لا اعلم روى عن محمد بن يزيد هذا الا ابنه يوسف ولا اعلم روى محمد بن يزيد عن أحد وكان البخاري (قال) روى عن أبيه وعمه فضرب عليه أبى " كذا قال والمؤلف لم يذكر رواية محمد عن أحد وانما ذكر بالسند ارساله عن جده صهيب ولم يقل انه " روى عن أبيه وعمه " وانما ذكر بالسند أن يوسف حدث عن أبيه وعمه 
ms1633	 وقد قال ابن أبي حاتم في ترجمة يوسف " روى عن.. وأبيه وعبد الحميد " ولمحمد بن يزيد ترجمة في الميزان واللسان (5 / 430) وفيها عن العقيلي ".. سعدويه حدثنا يوسف بن محمد بن يزيد حدثني أبي عن أبيه عن جده ان صهيبا قال ما جعلني رسول الله صلى الله عليه وآله وسلم بينه وبين العدو قط ما كنت الا امامه أو عن يمينه أو عن يساره، كذا وأول الأثر مقلوب والصواب " ما جعلت رسول الله صلى الله عليه وآله بيني وبين العدو.. " والله أعلم - ح(@)(1) ضبب عليه في كو (2) قط " أخبرنا ".(@)(1) وقع في قط " وقال محمد وزيد " وفى كو " قاله محمد بن وزير " ثم كتب بيده " محمد بن وزير مات.. " على انها ترجمة مستقلة وكلاهما خطأ وفى التاريخ الصغير المؤلف ص 211 " وحدثني هارون قال مات (أبو علقمة الفروي) في المحرم سنة تسعين، حدثني محمد بن أبي بكر قال مات عمر بن علي سنة ثنتين وتسعين، وقال محمد بن وزير مات فيها محمد بن يزيد الواسطي، وقال غيره سنة ثمان وثمانين ومائة " ومحمد بن يزيد هو الراوي عن سفيان والعوام، ومحمد بن وزير هو العبدي الواسطي ولد سنة 179 وتوفى سنة 257 كما في التهذيب (9 / 501) - ح.(@)(1) بهامش قط " هذا هو الرحبي المتقدم الذكر قاله أبو بكر بن ثابت "(@)(1) في قط " امره أو نهيه " وفى هامش كو " خ - أو نهيه عن المنكر - ".(@)(@@) (2) هو عمرو بن يحيى بن عمارة صرح به ابن أبي حاتم ووقع في الأصلين " عمر " وبهامش كو " في خ أخرى عمرو بن يحيى - بدل عمر " - ح.(@)(1) هو الغافقي يروى عن ابن عجلان وعنه سعيد بن أبي مريم راجع التهذيب (11 - 187) ووقع في قط " يحيى بن يحيى " كذا - ح(@)(1) قط " صمنا " كذا (2) قط " قال حدثني " (3) من كو (4) كو قال حدثنا(@)(1) قط " ابن عفير " خطأ راجع ترجمة محمد بن سهل رقم (306) وراجع التعجيل ص 56 - ح (2) هكذا في قط والتهذيب وكذلك ذكره الدولابي في الكنى (2 / 40) ووقع في كو وكتاب ابن أبي حاتم 
ms1634	 والثقات " أبو عمرو " والله أعلم - ح.(@)(1) سقط من قط (2) قط " قال حدثني " (3) هكذا في قط والتهذيب وهكذا يأتي في ترجمة غسان عم هذا الرجل ج 4 رقم 475 ووقع في كو " بشار " - ح.(@)(1) من قط (2) بهامش قط " قال أبو بكر بن ثابت محمد بن أبي يعقوب هو محمد بن إسحاق الكرماني وقد تقدم في الجزء الأول مات سنة أربع وأربعين ومائتين وقد وهم البخاري في التفرقة بين الترجمتين وهما رجل واحد " قال مصححه ليس هذا بوهم وانما ذكره المؤلف في الموضعين على علم وعبارته هنا وهناك توضح ذلك فإنه ذكر هناك وفاته وقال هنا " كتبنا عنه " فهو شيخه اخرج عنه في الصحيح وغيره، وفى التهذيب (9 / 38) " وفى الزهرة روى عنه البخاري أربعين حديثا، فاما أبو حاتم فلم يعرفه فان ابنه ذكر في كتابه كما هنا إلى قوله " إبراهيم " ثم قال " سمعت أبي يقول هو مجهول " وقال فيمن اسم أبيه إسحاق " محمد بن إسحاق بن أبي يعقوب الكرماني إن كان البلخي فروى.. " وليس به فان الكرماني هو محمد بن إسحاق بن منصور أبو عبد الله بن أبي يعقوب الكرماني سكن البصرة " التهذيب (9 / 38) والبلخي هو محمد بن إسحاق بن حرب أبو عبد الله اللؤلؤي السهمي مولاهم من أهل بلخ ويعرف بابن أبى يعقوب قدم الكوفة قبل سنة ثلاثين ومائتين وقدم بغداد في سنة اثنتين وعشرين ومائتين، راجع تاريخ بغداد (1 / 234) ولسان الميزان (5 / 66) والكرماني ثقة والبلخي كذبوه والله أعلم - ح(@)(1) من كو ومثله في كتاب ابن أبي حاتم وغيره - ح.(@)(1) لم يذكر هذا الاسم في الأصلين بل وقع فيهما " باب من افناء الناس قال لي " - ح (2) كأنه محمد بن " إسماعيل بن أبي سمينة ففي ترجمته من التهذيب ان البخاري روى عنه في التاريخ ووقع في كو " شيبة " والله أعلم - ح (3) تقدمت ترجمته رقم 187 " محمد بن خالد ويقال ابن عثمة وعثمة امه ".(@)(@@) (4) هذه الترجمة من كو وذكره ابن أبي حاتم (5) مثله في كتاب ابن أبي حاتم والميزان واللسان وبهامش كو " خ 
ms1635	 - محمد بن الكندي " - ح (3) لفظ ابن أبي حاتم " عبد الله بن يحيى التوأم " وقال في ترجمته " عبد الله بن يحيى أبو يعقوب التوأم " وفى التهذيب (6 / 75) " عبد الله ويقال عباد ويقال عبادة بن يحيى بن سلمان الثقفي أبو يعقوب التوأم " وفيه في الألقاب (12 / 342) " التوأم - هو عبد الله بن يحيى " فظهر بهذا انه عبد الله التوأم، التوأم لقب لعبد الله نفسه - ح(@)(1) هو محمد بن حفص راجع ما علقناه على ترجمة ابنه الهيثم من هذا الكتاب ج 4 رقم (2777) - ح (2) لم يذكره ابن أبي حاتم (3) لم يذكره ابن أبي حاتم أيضا ويمكن أن يكون محمد بن انس الظفري الذي تقدم في الصحابة رقم " 6 " والله أعلم - ح (4) قط " أخبرنا " (5) كو " كذب قال حدثت " (6) هكذا في كو والثقات ولسان الميزان (5 / 438) ووقع في قط " محمد مولى هشام " كذا - ح.(@)(1) بهامش كو " بلغ الجماعة سماعا وقراءة بدار الحديث المعمورة بالموصل. آخر الرابع من نسخة ابن النرسي الكوفي وأول الخامس من نسخته بخطه والغندجاني أيضا وأول خامس ابن عبدان أيضا. بلغت سماعا على ألح (الحافظ) أبى الحسين ابن يوسف وعرضا بالأصل فسح " (2) قط " يروون " ومثله بالهامش كو.(@)(1) كذا وقع في كو ووقع في قط " وعمر العبدري " وقال المزي في تهذيبه " وأبى عمر العبدي " كذا ذكره فيمن يعرف بكنيته من شيوخ إبراهيم - ح (2) هو الهيثم بن رافع راجع ترجمته في الجلد الرابع من هذا الكتاب رقم (2774) - ح (3) قط " الحضرة " وبهامشها " الحكرة " وهو الصواب راجع ترجمة الهيثم ح (4) هو الوليد بن شجاع - ح.(@)(1) بهامش كو " ح - ثم كان بالشام " (2) في التهذيب " البناني مولاهم " وقال ابن مأكولا " بنانة قبيلة.. وقال الزبير بنانة كانت أمة لسعد بن لؤي فحضنت بنيه عمارا وعمارة ومخزوما بعد أمهم فغلبت عليهم فسموا بها " ووقع في قط " نباتة " وهو تصحيف - ح (3) هكذا في قط وكتاب ابن أبي حاتم والميزان واللسان ووقع في كو " أبو إسحاق " كذا - ح (4) كذا وقع في الأصلين والأشبه انه " إبراهيم أبو إسحاق " فان عادة المؤلف تأخير الكنى وعند 
ms1636	 ابن أبي حاتم ترجمة لمحمد بن أبي سعيد وفيها " روى عن وهب بن منبه روى عنه إبراهيم أبو إسحاق الصنعاني " هكذا في أصلين منه وقد طبعناه كذلك راجع كتاب ابن أبي حاتم ج 3 قسم 2 ص 266 ولم أجد ترجمة لإبراهيم هذا في غير هذا الكتاب وقد لا يبعد أن يكون هو إبراهيم بن عمر بن كيسان وسيأتى في محله وكنيته أبو إسحاق وروى عن وهب بن منبه نفسه كما في التهذيب (1 / 147) وذكره المزي والله أعلم - ح(@)(1) زاد في كو " بن عبد الله " أخرى والترجمة عند ابن أبي حاتم وغيره يدون هذه الزيادة - ح (2) كو " وعن " كذا (3) قط " بريد بن بريد " كذا.(@)(1) قط " قال حدثنا " (2) قط " ابن مسعود " وبهامشها " خ أبو مسعود - قال الشيخ وهو الصواب ".(@)(@@) (3) ذكر ابن حبان في اتباع التابعين هذا الرجل إبراهيم بن بديل بن بشير وقال ابن أبي حاتم " إبراهيم بن بديل الخزاعي روى عن " وبيض وفى الميزان ولسانه " إبراهيم بن بديل ورقاء الخزاعي.. " كذا قال وعندهم " عبد الله بن بديل بن ورقاء يروى عن الزهري وعمرو بن دينار " ذكره ابن أبي حاتم وابن حبان وله ترجمة في التهذيب (5 / 155) " عبد الله بن بديل بن ورقاء ويقال ابن بشر الخزاعي ويقال الليثي " ثم بين... انه غير عبد الله بن بديل بن ورقاء الصحابي الذي قتل بصفين مع علي رضي الله عنه، وسيأتى في هذه الترجمة ذكر عبد الله بن بديل عن عمرو بن دينار فكأن المؤلف رحمه الله تعالى يشير إلى احتمال أن يكون إبراهيم وعبد الله واحد أو أخوين ولا يمكن ان يكونا ابني بديل بن ورقاء الصحابي المشهور فإنه توفى في حياة النبي صلى الله عليه وآله، نعم عبد الله بن بديل المقتول بصفين هو ابن بديل ورقاء الصحابي اتفاقا واما إبراهيم وعبد الله الآخر فلعله وقع في النسب اختصار والله أعلم - ح.(@)(1) قط " حدثني " (2) بهامش كو " في خ أخرى يسر بدل بشر " أقول هو بسر ابن سفيان له ترجمة في الإصابة 
ms1637	 وذكر هذا الخبر ونقل عن ابن مأكولا وغيره انهم ضبطوه كذلك بضم الموحدة وسكون السين المهملة - ح.(@)(@@) (3) من كو (4) كو " التميمي " وبهامشها " التيمي - صح " وهو الصواب(@)(1) من قط (2) كذا في الأصلين وسيأتى في أثناء الترجمة " إبراهيم بن أبي بكير " وكذا تقدم في ترجمة محمد صاحب الساج رقم (308) وذكره ابن أبي حاتم فيمن اسمه إبراهيم ولا ينسبون " إبراهيم بن أبو بكير.. " وقال ابن حبان في اتباع التابعين من الثقات " إبراهيم بن أبي بكير كنيته أبو بكير " ح.(@)(1) قضية صنيع المؤلف ان إبراهيم ابن اخى جرير وهم جزما أو احتمالا وانه إبراهيم بن جرير صاحب الترجمة، وصنيع ابن حبان يقتضى الجزم بذلك فإنه ذكر في الثقات إبراهيم بن جرير فقال " روى عن أبيه روى عنه شعبة بن الحجاج " (2) كو " جده " خطأ (3) بهامش كو " في خ أخرى عن جدته تويلة بنت أسيد " أقول ذكرها في الإصابة بالتاء المثناة قال " تويلة بالتصغير بنت أسلم " ثم قال " وقيل فيها تولة بغير تصغير وقيل أولها نون " ثم أعادها في النون " نويلة " ثم ذكر أن تويلة بالمثناة رواية إبراهيم بن حمزة الزبيري عن إبراهيم بن جعفر " ونويلة بالنون رواية إسحاق بن إدريس عن جعفر بن محمود، وإبراهيم بن حمزة أوثق، وقال ابن حبان في الصحابة من الثقات في باب النون " نفيرة بنت أسلم بن عمارة بن سلمان الحارثية من بنى دينار بن النجار لها صحبة " كذا وقع في النسخة " نفيرة " ولم يذكر أخرى بلفظ نويلة أو تويلة أو تولة ولم أر في الإصابة نفيرة ولا ما يقرب منها والله أعلم - ح(@)(1) بهامش قط " نجز الجزء الرابع من اجزاء الشيخ أبي ذر ".(@)(1) سقط من قط(@)(1) في كتاب ابن أبي حاتم والثقات " الأودي " (2) هو صاحب الترجمة ووقع في قط " عن إدريس " كذا اما ابن أبي حاتم فقال " إبراهيم بن أبي حديد جد إدريس الأودي روى عن علي مرسل روى عنه ابناه إدريس وداود.. " كذا قال وإدريس وداود هما ابنا يزيد بن عبد الرحمن كما في ترجمتيهما وقال ابن أبي 
ms1638	 حاتم في باب يزيد " يزيد بن عبد الرحمن الأودي والد إدريس وداود الأوديين وهو جد عبد الله بن إدريس روى عن علي " فالله اعلم - ح.(@)(@@) (3) قط " ويقال " (4) يريد أن إبراهيم صاحب الترجمة قال قلت لعلي بن حسين فقد ذكر ابن أبي حاتم رواية إبراهيم عن علي بن حسين - ح.(@)(1) يريد ما لم تكن معك في بيتك فإنها إذا كانت في بيتك كانت ممن تعول وليس لك اعطاء الزكاة لاحد ممن تعوله ووقع في قط " بالباب " وبهامش كو " ح - ص بالباب " كذا - ح (2) هكذا في قط والثقات ولسان الميزان (1 / 51) وهكذا يأتي في ترجمة كلثوم بن زياد ج 4 قسم 1 رقم (981) ووقع في كو " اليماني " خطا - ح (3) سقط من قط (4) جزم به غيره قال ابن أبي حاتم " إبراهيم بن حنظلة بن أبي سفيان.. سمعت أبي وأبا زرعة يقولان ذلك " - ح.(@)(1) مثله في كتاب ابن أبي حاتم فيمن يسمى إبراهيم ولا ينسبون " إبراهيم أبو الحصين " ووقع بهامش كو " في خ - ابن الحصين " كذا - ح.(@)(1) هكذا في كو وكتاب ابن أبي حاتم والثقات ووقع في قط " دليم " كذا - ح (2) من كو.(@)(1) قط " لو أن زرعها " (2) هكذا في كو وهكذا ضبطه ابن مأكولا وغيره وستأتي ترجمة رفاعة بن هرير وترجمة هرير ووقع في قط " هدير " خطأ - ح (3) هكذا في قط والثقات وتاريخ بغداد (6 / 76) وصنيع ابن حجر في التبصير يقتضيه ووقع في كو " الحناط " ومثله في كتاب ابن أبي حاتم والله أعلم - ح (4) من قط(@)(1) هكذا في كو وفيها اثر اصلاح كأن الكلمة كانت " ابن عامر " فأصلحت وفى كتاب ابن أبي حاتم والثقات وغيرها " عن أبي عامر " وفى الكنى للمؤلف رقم (497) " أبو عامر عن ابن عباس روى عنه إبراهيم بن زياد " ووقع في قط " عن ابن عامر " كذا - ح (2) على كلمة " محمد " اثر طمس في قط وضبب عليها في كو وبالهامش " مخلد " ثم كتب " في خ من رواية ابن فارس محمد بن عمر " وفى كتاب ابن أبي حاتم والثقات " مخلد " فالله اعلم ولم 
ms1639	 أجد فيمن اسمه محمد أو مخلد من يترجح انه هذا الا ان في الثقات - 4 - " مخلد بن عمرو البلخي شيخ يروى عن الفضيل بن عياض " - ح (3) نسبه ابن أبي حاتم " إبراهيم بن يحيى بن زيد بن ثابت " ومثله في الإصابة في ترجمة أم سعد وستأتى ترجمة له كذلك في محله - ح (4) سقط هنا " بنت سعد " قال ابن سعد " أم سعد بنت سعد ابن الربيع " ثم ذكر انها أم يحيى بن زيد بن ثابت واخوته، راجع الطبقات ج 8 ص 300 - ح.(@)(1) من هنا إلى آخر الترجمة من كو (2) بهامش الأصل - كو " شاهدت بخط ابن ناصر الصواب حملا " (3) كذا وقال ابن سعد " قتل سعد بن الربيع بأحد وأم سعد حمل فولدتها أمها بعد قتل سعد بأشهر ".(@)(1) هو الوليد بن عبد الرحمن الجرشى صرح به ابن أبي حاتم وغيره وستأتى ترجمته ج 4 قسم 2 رقم (2512) وضبطه عبد الغني في مشتبه النسبة ص 15 ووقع في قط " الجرشى " خطأ - ح. (2) هو هرير بن عبد الرحمن بن رافع بن خديج ستأتي ترجمته ج 4 قسم 2 رقم (290) وراجع ما علقناه على ترجمة إبراهيم بن رافع بن خديج ووقع في قط " هدير " خطأ - ح (3) بهامش كو " هو ابن الأشعث البخاري "(@)(1) زاد في قط " عن عبد الله " أخرى واراه تكرارا من الناسخ - ح (2) قط " ترفع ".(@)(1) مثله في الثقات ذكر إبراهيم هذا في التابعين ووقع في كتاب ابن أبي حاتم " إبراهيم بن سعيد روى عن أبي عبد الحميد عن أبي هريرة... " كذا - ح (2) قط " أبو إبراهيم " خطأ وإبراهيم هذا كنيته أبو إسحاق كما في التهذيب (1 / 120) ح.(@)(١) قط " لم يسمعه " كذا (٢) قال عبد الغني في المؤتلف ص ٧٨ " وشعيث بالثاء.. إبراهيم بن شعيث روى عنه ابن وهب.. " وتبعه ابن مأكولا وفى لسان الميزان (١ / ٦٧) " ضبطه الخطيب بالثاء المثلثة وزعم أن البخاري صحفه بالباء الموحدة " - ح (٣) زاد في كو " قال " كذا (٤) في <a href="/الكتب/41_النهاية">النهاية</a> (ق ذ ر) " هلك المتقذرون يعنى الذين يأتون القاذورات " وبهامش كو " نسخة - المتفردون 
ms1640	 و أأدخل - المنفردون "(@)(١) حكى ابن أبي حاتم عن أبيه قال " أظن بين إبراهيم ويزيد محمد بن إسحاق " - ح (٢) ضبطه في قط بكسر العين وفى كو بفتحها وتشديد الشين (٣) الحديث في <a href="/الكتب/1734_سنن-أبي-داود-ج-٢">سنن أبي داود ج ٢</a> كتاب الملاحم - باب في البصرة وزاد " لا يقوم مع شهداء بدر غيرهم " ووقع في قط " شهدوا " - ح(@)(1) ستأتي ترجمة حميد ووقع هنا في قط " يعفور " خطأ - ح (2) من قط.(@)(1) ستأتي ترجمته في بابه ووقع في قط " سعيد " خطأ - ح (2) من كو.(@)(1) مثله في التهذيب المزي ووقع بهامش كو " في أخرى - سمع عبد الله بن الحارث وابن عباس " وهو خطا - ح.(@)(١) بهامش كو " ح ص - وقال " (٢) من كو ومثله في كتاب ابن أبي حاتم وغيره - ح (٣) كذا وقع في قط ووقع في كو " يزيد بن أبي أميمة " وكتب فوقه " أمية " بقى ان في جامع الترمذي أبواب <a href="/الكتب/47_الدعوات">الدعوات</a> باب ما جاء ما يقول إذا ودع انسانا " حدثنا أحمد بن عبيد الله السليمي البصري نا أبو قتيبة سلم بن قتيبة عن إبراهيم بن عبد الرحمن بن يزيد بن أمية عن نافع عن ابن عمر... " وبناء عليه سمى في التهذيب هذا الرجل " إبراهيم بن عبد الرحمن يزيد بن أمية وذكر روايته عن نافع فقط وعنه سلم فقط ولم يذكر ابن أبي حاتم لا ذا ولا ذاك اما ابن حبان فسماه " إبراهيم بن عبد الرحمن بن الحارث بن حاطب المدني روى عن نافع ويزيد ابن أمية روى عنه سلم بن قتيبة " فاعتمد ظاهر السياق في نسخ هذا الكتاب وسيأتي ما فيه فاما ما وقع في الأصل " عن نافع ويزيد بن أمية " فليس بصريح المخالفة لما في الترمذي لجواز أن يكون إبراهيم روى أيضا عن جده يزيد بن أمية والله أعلم.(@)(1) اهاب أن يكون وقع هنا سقط فان العبارة من هنا إلى آخر الترجمة تتعلق بإبراهيم بن عبد الله بن الحارث بن حاطب وهو رجل آخر له ترجمة عند ابن أبي حاتم وابن حبان والتهذيب (1 / 133) وذكروا انه يروى 