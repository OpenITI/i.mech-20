ms591	 نمرد %~% هم خیالش دیدمی در خواب اگر بغنودمی(@)(@@) 24 نی‌نی آن فرزانه را داغ فراقم کشت و بس %~% گر به عالم داد بودی من به خون ماخوذمی(@)(@@) 25 شد ز من بدرود گر بختیم بودی پیش از آنک %~% او ز من بدرود رفتی من ز جان بدرودمی(@)(@@) 26 گر دلم دادی که شروان بی‌جمالش دیدمی %~% راه صد فرسنگ را زین سر بسر پیمودمی(@)(@@) 27 جانم ار در نیم تیمار فراقش نیستی %~% آخر از جان یتیمانش غمی بزدودمی(@)(@@) 28 گفتی ای باز سپید از دود دل چون می‌رهی %~% کاش ار باز سپیدم بی‌سیاهی دودمی PageV1P0630(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 گرچه کان خرد مرا دانی %~% عاجزم در نهاد خاقانی(@)(@@) 2 صورت روح پاک می‌بینم %~% متدرع به شخص انسانی(@)(@@) 3 افضل الدین امیر رملک سخن %~% شارح رمزهای پنهانی PageV1P0631(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 نثار اشک من هر شب شکر ریزی است پنهانی %~% که همت را زناشوئی است از زانو و پیشانی(@)(@@) 2 چو هم‌زانو شوم با غم گریبان را کنم دامن %~% سر من از سر زانو کند دامن گریبانی(@)(@@) 3 سرم زان جفت زانو شد که از تن حلقه‌ای سازم %~% در آن حلقه ترازو دار بیاعان روحانی(@)(@@) 4 دلم کعبه است و تن حلقه چگونه حلقه‌ای کانرا %~% ز بس دندانه گر بینی دهان زمزمش خوانی(@)(@@) 5 سر احرامیان عشق بر زانو به است ایرا %~% صفا و مروه مردان سر زانوست گر دانی(@)(@@) 6 تو زین احرام و زین کعبه چه دانی کز برون چشمت %~% ز کعبه پوششی دیده است و از احرام عریانی(@)(@@) 7 شده است آیینه زانو بنفش از شانه دستم %~% که دارم چون بنفشه سر به زانوی پشیمانی(@)(@@) 8 ملخ کردار خون آلودم از باران اشک آری %~% ملخ سر بر سر زانوست خون آلوده بارانی(@)(@@) 9 هوا را دست بربستم خرد را پای بشکستم %~% نه صرافم چه خواهم کرد نقد انسی و جانی(@)(@@) 10 هوا خفته است و بستر کرده از پهلوی نومیدی %~% خردمست است 
ms592	 و بالین دارد از زانوی نادانی(@)(@@) 11 از آن شد پرده چشمم به خون بکری آلوده %~% که غم با لعبتان دیده جفتی کرد پنهانی(@)(@@) 12 ببین بر روزن چشمم عروس روز نظاره %~% که بیند بچگان دیده را در رقص مهمانی(@)(@@) 13 بپیچد آه من در بر چو ز آتش چنبری و آنگه %~% رسن‌وار آتشین چنبر گره گیرد ز پیچانی(@)(@@) 14 به خون ساده ماند اشک و خاک سوده دارد رخ %~% مگر رخ نعل پیکان است و اشکم لعل پیکانی(@)(@@) 15 شب غم‌های من چون شد به صبح شادی آبستن %~% رود سامان نقب من همه بر گنج سامانی(@)(@@) 16 دل از تعلیم غم پیچد معاذ الله که بگذارم %~% که غم پیر دبستان است و دل طفل شبستانی(@)(@@) 17 از آن چون لوح طفلانم به سرخی اشک و زردی رخ %~% که دل را نشره عید است ز آن پیر دبستانی(@)(@@) 18 رقوم اشک اگر بینی به عجم و نقطه بر رویم %~% رموز غم ز هر حرفی به مد و همزه برخوانی(@)(@@) 19 ببستم حرص را چشم و شکستم آز را دندان %~% چو میم اندر خط کاتب چو سین در حرف دیوانی(@)(@@) 20 مشاع آمد میان عیسی و من گلشن وحدت %~% به جان آن نیمه بخریدم هم از عیسی به ارزانی(@)(@@) 21 فلک چون آتش دهقان سنان کین کشد بر من %~% که بر ملک مسیحم هست مساحی و دهقانی(@)(@@) 22 مرا شد گلشن عیسی و زین رشک افتاب آنگه %~% سپر فرمود دیلم‌وار و زوبین کرد ماکانی(@)(@@) 23 مرا آیینه وحدت نماید صورت عنقا %~% مرا پروانه عزلت دهد ملک سلیمانی(@)(@@) 24 چه جای عزلت و ملک است کانجا ساخت همت خوان %~% که عنقا مورخوان گشت و سلیمان مرد هم خوانی(@)(@@) 25 وگر چون عیسی از خورشید سازم خوانچه زرین %~% پر طاووس فردوسی کند برخوان مگس رانی(@)(@@) 26 به دست همت از خاطر برانم غم که سلطانان %~% مگس‌ران‌ها کنند از پر طاووسان بستانی(@)(@@) 27 نکوئی 
ms593	 بر دل است از دهر و بد بر طبع آلوده %~% طرب بر مردم است از عیدو غم بر گاو قربانی(@)(@@) 28 دلم را منزلی پیش است و واپس ماندگان از پس %~% که راهش سنگ‌لاخ است و سم افکنده است پالانی(@)(@@) 29 به هفتاد آب و خاک از دل بشویم گرد ظلمت را %~% که هفتادش حجت بیش است و هر هفتاد ظلمانی(@)(@@) 30 دل اینجا علتی دارد که نضجی نیست دردش را %~% هنوز آن روزنش بسته است و او بیمار بحرانی(@)(@@) 31 هنوز اسفندیار من نرفت از هفت‌خوان بیرون %~% هنوزش در دژ روئین عروسانند زندانی(@)(@@) 32 دلم چون بر نشستن خواست سلطان خرد گفتا %~% که بر باد هوس منشین که شمع روح بنشانی(@)(@@) 33 ندیدی آفتاب جان در اسطرلاب اندیشه %~% نخواندی احسن التقویم در تحویل انسانی(@)(@@) 34 نه هرزه است آنچه دیدستی نه عشوه است آنچه خواندستی %~% نه مهمل عالم خلقی نه قاصر علم یزدانی(@)(@@) 35 به دست شرع لبس طبع میدر گر خردمندی %~% به آب عقل حیض نفس می‌شوی ار مسلمانی(@)(@@) 36 چو طاووست چه باید لبس اگر باز هواگیری %~% چو خرگوشت چه باید حیض اگر شیر نیستانی(@)(@@) 37 تو را گفتند ازین بازار مگذر خاک بیزی کن %~% که اینجا ریزها ریزند صرافان ربانی(@)(@@) 38 مقامت خاک بیزی راست تا زرها به دست آری %~% تو زر در خاک می‌بیزی و آخر دست می‌مانی(@)(@@) 39 چه سود از لوح کو ماند ز نقطه اولین حرفی %~% که از روی گران باری ز ابجد حرف پایانی(@)(@@) 40 اگر خواهی گرفت از ریز روزی روزه عزلت %~% کلوخ انداز را از دیده راوق ریز ریحانی(@)(@@) 41 وگر یک ره نماز مرده خواهی کرد بر گیتی %~% وضو از آب چشمان کن که بس آلوده دامانی(@)(@@) 42 در این علت سرای دهر خرسندی طبیبت بس %~% چو تسکین سازت او باشد کند درد تو درمانی(@)(@@) 43 به خوان دهر چون دولاب یابی کاسه‌ها شسته %~% که بر دولاب گردون 
ms594	 هست کارش کاسه گردانی(@)(@@) 44 عیار دهر کم ارز است دیدم ز آتش همت %~% زرش زیف است و چون آتش به ارزانی است ارزانی(@)(@@) 45 به کشتی ماند این ایام و بادش چرخ سرگردان %~% به اعمی ماند این کشتی و قائد باد آبانی(@)(@@) 46 فلک هم مرکبی تند است کژ جولان که چون کشتی %~% عنان بر پاردم دارد ز روی تنگ میدانی(@)(@@) 47 همه دور فلک جور است و تو داغ فلک داری %~% ز پرگار فلک بیرون توانی رفت نتوانی(@)(@@) 48 فلک را شیوه بدبختی است در کار نکوکاران %~% چو بختی بار بدبختی کش از مستی و حیرانی(@)(@@) 49 اگر با بخت نر ماده قرینند آن خدا دوران %~% تو چون دوران به فردی ساز کاخر فحل دورانی(@)(@@) 50 بهر ناسازیی درساز و دل با ناخوشی خوش کن %~% که آبت زیر کاه است و کمالت زیر نقصانی(@)(@@) 51 به معلولی تن اندر ده که یاقوت از فروع خور %~% سفر جل رنگ بود اول که آخر گشت رمانی(@)(@@) 52 چو خورشید و چو ایمان شو که ویران‌ها کنی روشن %~% برهنه جامها می‌بخش اگر خورشید ایمانی(@)(@@) 53 چو درویشی به درویشان نظر به کن که جرم خور %~% به عوری کرد عوران را فنک پوش زمستانی(@)(@@) 54 اگر بر بوی یک‌رنگی گریزت نیست از یاران %~% به یار بدقناعت کن که بی‌یاری است بی‌جانی(@)(@@) 55 نه عیسی داشت از یاران کمینه سوزنی دربر %~% نه سوزن شبه دجالی است یک چشم سپاهانی(@)(@@) 56 وگر عنقائی از مرغان ز کوه قاف دین مگذر %~% که چون بی‌قاف شد عنقا عنا گردد ز نالانی(@)(@@) 57 سلاحت بهر دین بهتر که زنبور از پی شهدی %~% چو گیلی گور دین پوش است و زوبین کرده گیلانی(@)(@@) 58 از آن در خرقه آدم خشن خویی که در باطن %~% مرقع‌دار ابلیسی ملمع دار شیطانی(@)(@@) 59 تو را در رنگ آزادان کجا معنی آزادی %~% که ازرق پوش چون پیکان خشن سیرت چو سوهانی(@)(@@) 60 
ms595	 از آن بر سر زنندت پتک همچون پای پیل ایرا %~% که سندانی و در تربیع شکل کعبه را مانی(@)(@@) 61 ز جیب موسوی لافی و پس چون امت موسی %~% نه اهل تسع آیاتی که مرد سبع الوانی(@)(@@) 62 فروکن نطع آزادی برافکن لام درویشی %~% که با لام سیه‌پوشان نماند لاف لامانی(@)(@@) 63 یهود آسا غیاری دوز بر کتف مسلمانان %~% اگرشان بر در اغیار دین بینی به دربانی(@)(@@) 64 به سختی جان سگ می‌دار هان تا چون سبک‌ساران %~% چو سگ در پیش سگ‌ساران به لابه دم نجنبانی(@)(@@) 65 به لمس پیرزن ماند حضور ناکسان کاول %~% وضو باطل کند و آخر ندارد نار پستانی(@)(@@) 66 چه باشی مشک سقایان گهت دق و گه استسقا %~% نثار افشان هر خوان و زکوة استان هر خانی(@)(@@) 67 عمارت دوست شد طاووس از آن پای گلین دارد %~% ولیکن سر بزرگی یافت بوم از بوم ویرانی(@)(@@) 68 شبه را کز سیه پوشی برآمد نام آزادی %~% به از یاقوت اطلس پوش داغ بنده فرمانی(@)(@@) 69 نماند آب وفا جائی مگر در جوی درویشان %~% به آب و دانه ایشان بساز ار مرغ ایشانی(@)(@@) 70 چه آزادند درویشان ز آسیب گران‌باری %~% چه محتاجند سلطانان به اسباب جهان‌بانی(@)(@@) 71 بدا سلطانیا کورا بود رنج دل آشوبی %~% خوشا درویشیا کورا بود گنج تن آسانی(@)(@@) 72 پس از سی سال روشن گشت بر خاقانی این معنی %~% که سلطانی است درویشی و درویشی است سلطانی(@)(@@) 73 ز دیوان ازل منشور کاول در میان آمد %~% امیری جمله را دادند وسلطانی به خاقانی(@)(@@) 74 به خوان معنی آرائی براهیمی پدید آمد %~% ز پشت آزر صنعت علی نجار شروانی(@)(@@) 75 سخن گفتن به که ختم است می‌دانی و می‌پرسی %~% فلک را بین که می‌گوید به خاقانی به خاقانی(@)(@@) 76 اگر بر احمد مختار کس خواند چنین شعری %~% ز صدر او ندا آید که قد احسنت حسانی(@)(@@) 77 عراقم جلوه کرد امسال بر لشکرگه سلطان %~% که بودش ز 
ms596	 آفتاب خاطرم لاف خراسانی(@)(@@) 78 چو آواز وفات ناصر الدین در عراق آمد %~% من و خاک عراق آشفته گشتیم از پریشانی(@)(@@) 79 بنالد جان ابراهیم و گرید دیده کعبه %~% بر ابراهیم ربانی و کعبه صدق را بانی(@)(@@) 80 مر او بود هم نوح و هم ابراهیم و دیگر کس %~% همه کنعان نا اهلند یا نمرود کنعانی(@)(@@) 81 خلافت‌دار احمد بودو هم احمد ندا کردش %~% که فاروق فریقینی و ذو النورین فرقانی(@)(@@) 82 هوا چون خاک پای و آز خوک پایگاهت شد %~% خراج از دهر ذمی روی رومی خوی بستانی(@)(@@) 83 دل از هش رفت چون موسی و تن پیچید چون ثعبان %~% که مرد آن موسوی دستی که کلکش کرد ثعبانی(@)(@@) 84 ز قطران شب و کافور روزم حاصل این آمد %~% که از نم دیده کافوری است وز غم جامه قطرانی(@)(@@) 85 اگر کافور با قطران ره زادن فرو بندد %~% مرا کافور و قطران زاد درد و داغ پنهانی(@)(@@) 86 دلم مرگ پسر عم سوخت و در جانم زد آن آتش %~% که هیمه‌ش عرق شریان گشت و دودش روح حیوانی(@)(@@) 87 سخن در ماتم است اکنون که من چون مریم از اول %~% در گفتن فرو بستم به مرگ عیسی ثانی(@)(@@) 88 علی را گو که غوغای حوادث کشت عثمان را %~% علی‌وار از جهان بگسل که ماتم دار عثمانی(@)(@@) 89 وحید ادریس عالم بود و لقمان جهان اما %~% چو مرگ آمد چه سودش داشت ادریسی و لقمانی(@)(@@) 90 به یک‌دم بازرست از چرخ و ننگ سعد و نحس او %~% که این تثلیث برجیس است و آن تربیع کیوانی PageV1P0632(@)(@@)(@@)(@@) || [genre: Q](@)(@@) 1 بردار زلفش از رخ تا جان تازه بینی %~% وز نیم کشت غمزه‌اش قربان تازه بینی(@)(@@) 2 یک سو فکن دو زلفش و ایمانت تازه گردان %~% کاندر حجاب کفرش ایمان تازه بینی(@)(@@) 3 پروانه غمش را هر دم به خون خلقی %~% شمشیر تیز یابی فرمان تازه بینی(@)(@@) 4 ترکان غمزه او چون 
