ms41	 غين وقاف خاء % و الصاد و الضاد و ظاء طاء ) 1038 -(@)(@@) ( خالفها في الصفة المنخفضه % فاستفل اللسان مما عرضه ) 1039 -(@)(@@) ( أما حروف بذلاقة تدل % فستة يجمعها مر بنفل ) 1040 -(@)(@@) ( و هي التي لم يخل بالقياس % عنها رباعي و لا خماسي ) 1041 -(@)(@@) ( و غيرها مصمتة إذ صمتا % في صيغ النوعين عنها فاثبتا ) 1042 -(@)(@@) ( ينضم في القلقلة الضغطة في % وقف إلى الشدة بالتعرف ) 1043 -(@)(@@) ( يجمعها قطب جد عند الثقه % و قد تسمى بحروف اللقلقه ) 1044 -(@)(@@) ( و أحرف الصفير ما بها صفر % صاد وزاي ثم سين فاعتبر ) 1045 -(@)(@@) ( حروف لين مدها سواء % الواو و الألف ثم الياء ) 1046 -(@)(@@) ( و اللام في اصطلاحهم منحرف % إذ اللسان عنده ينحرف ) 1047 -(@)(@@) ( و الراء قد سمي بالمكرر % فالنطق في ذلك بالتعسر ) PageV01P083 1048 -(@)(@@) ( و الألف الهاوي لأنه اتسع % به هواء الصوت عندما ارتفع ) 1049 -(@)(@@) ( و يجعل المهتوت وصف التاء % لما به من هتة الخفاء ) طريق إدغام المتقاربين 1050 -(@)(@@) ( في المتقاربين حيث يدغم % لا بد من قلب به ينتظم ) 1051 -(@)(@@) ( و الأول القياس إن لم يعرض % أمر كما في اذبحتودا إذ رضي ) 1052 -(@)(@@) ( و هكذا في بعض تاء افتعلا % إذ كثر التغيير فيها كاصطلى ) 1053 -(@)(@@) ( يضعف محم مدغما في معهم % في السدس ست شذ و هو يلزم ) 1054 -(@)(@@) ( و لم يجز إدغام ما يلتبس % كمثل زنماء ففك يؤنس ) 1055 -(@)(@@) ( من ثم قالوا طدة لا وطدا % لثقل أو لبس و ألغوا وتدا ) 1056 -(@)(@@) ( و لم يبالوا في امحى واطيرا % إذ أمن اللبس إذا تغيرا ) 1057 -(@)(@@) ( و جاء ود عن تميم في وتد % إذ جمعه الأوتاد يكفي للسند ) 1058 -(@)(@@) ( لم يدغموا حروف مشفر ضوي % فيما يدانيها لضعف يلتوي ) 1059 -(@)(@@) ( و سيد ولية قد أدغما % حيث أعلا قبل أن يدغما ) 1060 -(@)(@@) ( و النون في لام وراء تدغم % إذ كرهت نبرتها فيلزم ) 1061 -(@)(@@) ( و أدغمت في الميم حيث اشتركا % في صفة الغنة حين أدركا ) 1062 -(@)(@@) ( و هكذا في الواو مثل الياء % إذ أمكن الغنة بالإبقاء ) 1063 -(@)(@@) ( و قد أتى نخسف بهم واغفر لي 
ms42	 % لبعض شأنهم بغير المثل ) 1064 -(@)(@@) ( لا يدغمون أحرف الصفير % في غيرها حفظا عن التغيير ) 1065 -(@)(@@) ( لم يدغموا المطبق في سواه % من غير إطباق لما حواه ) PageV01P084 1066 -(@)(@@) ( و لا حروف الحلق فيما كانا % أدخل منه بالذي استبانا ) 1067 -(@)(@@) ( لكنهم قد يدغمون الحاءا % في العين و الهاء و لا سواءا ) 1068 -(@)(@@) ( من ثم قالوا اذبحتودا مدغما % كذلك إذ بحاذه لتدغما ) 1069 -(@)(@@) ( فالهاء في الحاء و عين في الحا % و الحاء في العين كذاك في الها ) 1070 -(@)(@@) ( فيقلبا حاء على ما ثبتا % لكن فمن زحزح عن النار أتى ) 1071 -(@)(@@) ( و الغين في الخاء كبلغ خدمك % و الخاء في الغين كسلخ غنمك ) 1072 -(@)(@@) ( و القاف في الكاف كما نخلقكم % و الكاف في القاف كذاك يدغم ) 1073 -(@)(@@) ( و الجيم في الشين على ما جاءا % في قول من أدغم أخرج شاءا ) إدغام اللام المعرفة 1074 -(@)(@@) ( و اللام ذو التعريف في اللام وفي % ثلاث عشر لازما من أحرف ) 1075 -(@)(@@) ( التاء و الثاء و ذال ظاء % و الراء و الزاي و دال طاء ) 1076 -(@)(@@) ( و الصاد و الضاد كذا و النون % و السين و الشين فذا قانون ) 1077 -(@)(@@) ( و غير ذي التعريف في المثل لزم % و نحو بل ران على ما قد علم ) 1078 -(@)(@@) ( و في البواقي جائز كهل سأل % كذاك هل تدري و هل شاع المثل ) إدغام النون الساكنة 1079 -(@)(@@) ( و في السكون يدغمون النونا % بالفرض في حروف يرملونا ) 1080 -(@)(@@) ( و الأفصح الغنة عند الياء % و الواو لا في اللام أو في الراء ) 1081 -(@)(@@) ( و النون قبل الباء ميما يقلب % كمنبر بعنبر يطيب ) 1082 -(@)(@@) ( و النون في غير حروف الحلق % يخفى فخمس حاله للخلق ) 1083 -(@)(@@) ( و يدغم النون إذا تحركا % على الجواز كالذي قد أدركا ) 1084 -(@)(@@) ( و التاء و الطاء كذاك الدال % و الثاء و الظاء كذا و الذال ) 1085 -(@)(@@) ( فبعضها يدغم في البعض وفي % صاد وزاي ثم سين يقتفي ) PageV01P085 1086 -(@)(@@) ( في نحو فرطت لدى الإطلاق % إن كان إدغام مع الإطباق ) 1087 -(@)(@@) ( فذاك إتيان بطاء طار % و 
ms43	 جمع ساكنين في اعتبار ) 1088 -(@)(@@) ( ليست كذاك غنة في النون % فيمن يبقيها على القانون ) 1089 -(@)(@@) ( و الصاد ثم الزاي ثم السينا % فبعضها في البعض يدغمونا ) 1090 -(@)(@@) ( و الباء في الميم وفاء أدغما % نحو يعذب من يشاء مدغما ) 1091 -(@)(@@) ( و جاز أن يدغم تاء افتعلا % في مثلها كقتلا أو قتلا ) 1092 -(@)(@@) ( عليهما جاء مقتلونا % بفتح قاف أو مقتلونا ) 1093 -(@)(@@) ( و قد أتى أيضا مرد فينا % بالضم إتباعا كذا روينا ) 1094 -(@)(@@) ( و الثاء في تاء افتعال أدغما % فرضا على الوجهين كاثأرتما ) 1095 -(@)(@@) ( و السين فيها أدغمت شذوذا % على شذوذ كاسمع مأخوذا ) 1096 -(@)(@@) ( و لا يجوز اتمعت إذ تذهب % فضيلة الصفير و هي تطلب ) 1097 -(@)(@@) ( و تاء الافتعال بعد المطبقه % تقلب طاء لترى منطبقه ) 1098 -(@)(@@) ( فيلزم الإدغام في يطعم % و جوز الوجهان في يظطلم ) 1099 -(@)(@@) ( و جاءت الثلاث في فيظطلم % في بيت شعر لزهير قد علم ) 1100 -(@)(@@) ( شذ على شذوذه في اصطبرا % إذ لا يجوز للصفير اطبرا ) 1101 -(@)(@@) ( و هكذا على الشذوذ في اضطرب % إذ لم يجز للاستطالة اطرب ) 1102 -(@)(@@) ( و تاء الافتعال دالا قلبا % في الدال و الذال وزاي فاقلبا ) 1103 -(@)(@@) ( و أدغمت على الوجوب ادثر % و جاء الادغام قويا في ادكر ) PageV01P086 1104 -(@)(@@) ( و جاء بالذال كمثل اذكرا % و جاء بالفك كمثل اذدكرا ) 1105 -(@)(@@) ( و يضعف الإدغام في يزدجر % إذ لم يجز لما مضى يدجر ) 1106 -(@)(@@) ( و في خبطت شذذت خبط % كذاك فزد ثم عد حصط ) إدغام تاء تتنزل و تتنابزوا 1107 -(@)(@@) ( في تتنازلون عندما وصل % أو تتنزلون إدغام نقل ) 1108 -(@)(@@) ( إن لم يصاحبه صحيح سكنا % مقدما و كان معلوم البنا ) 1109 -(@)(@@) ( و التاء من تفعل قد تدغم % في الأحرف التي بها تدغم ) 1110 -(@)(@@) ( فهمزة الوصل لها تجتلب % كاثاقلوا وازينوا واطيبوا ) إدغام سين الاستفعال ) 1111 -(@)(@@) ( و نحو ما اسطاعوا على الإدغام مع % بقاء صوت السين نادرا وقع )(@)(@@)(@)(@@) | باب الحذف(@)(@@) 1112 -(@)(@@) ( و الحذف للإعلال سابقا ذكر % و الحذف للترخيم في النحو زبر ) 1113 -(@)(@@) ( و جاء حذف التاء في تسربل % تنازعون و هي لا 
ms44	 تنزل ) 1114 -(@)(@@) ( ظلتم و مستم كأحستم ثبتا % و اسطاع يسطيع و يستيع أتى ) 1115 -(@)(@@) ( و في على الماء أتى علماء % و في من الماء أتى ملماء ) 1116 -(@)(@@) ( و في بني العنبر بلعنبر قد % جاء كبلحارث فيما قد ورد ) 1117 -(@)(@@) ( شذ بتاء لم يشدد يتقي % منه تق الله ببيت مرتقي ) PageV01P087 1118 -(@)(@@) ( و ليس منه قولهم قد تخذا % يتخذ فتحا فهو أصل أخذا ) 1119 -(@)(@@) ( ثم من استتخذ جاء استخذا % و قيل إبدال لتاء اتخذا )(@)(@@)(@)(@@) | باب مسائل التمارين(@)(@@) 1120 -(@)(@@) ( وكيف يبنى من كذا مثل كذا % يعني إذا منه وزان أخذا ) 1121 -(@)(@@) ( ثم بمقتضى القياس صرفا % كيف به ينطق حتى يعرفا ) 1122 -(@)(@@) ( و الفارسي قال في القياس % تزيد ما قد زيد في الأساس ) 1123 -(@)(@@) ( و هكذا تحذف ما قد حذفا % في أصله على قياس عرفا ) 1124 -(@)(@@) ( و عند آخرين حذف ما حذف % قياسا أو غير قياس إذ تصف ) 1125 -(@)(@@) ( مضربي محوي من ضرب % أبو علي مضري في النسب ) 1126 -(@)(@@) ( دعو و دعو من دعا كاسم وغد % وادع دع للآخرين يعتقد ) 1127 -(@)(@@) ( ثم دعايا باتفاق من دعا % مثل صحائف على ما اخترعا ) 1128 -(@)(@@) ( و عنمل كعنسل من عملا % و مثله من قال جاء قنولا ) 1129 -(@)(@@) ( لا يدغمون النون كي لا يلبسا % بفعل المشدود مثل خمسا ) 1130 -(@)(@@) ( و مثل قنفخر كذا عنمل % للبس علكد كما قنول ) 1131 -(@)(@@) ( لم يبن من نحو كسرت أو جعل % مثل جحنفل للبس أو ثقل ) 1132 -(@)(@@) ( و من وأى أوء مثال أبلم % و من أوى أو بواو مدغم ) 1133 -(@)(@@) ( و من وأى إي وزان إجرد % و من أوى إي و إي فاقصد ) PageV01P088 1134 -(@)(@@) ( و منهما عند ولاة العزه % إيئاة أو إياة من إوزه ) 1135 -(@)(@@) ( و كاطلخم من وأى ايأيا % و من أوى وزانه ايويا ) 1136 -(@)(@@) ( من أولق مثال ما شاء الله % قال أبو علي إذ بناه ) 1137 -(@)(@@) ( وزانه ما ألق الإلاق % فالألق المقول ثم اللاق ) 1138 -(@)(@@) ( ووجه ذاك أنه قد جعلا % أولقا اذ أوغل فيه فوعلا ) 1139 -(@)(@@) ( و هو على ذلك قد 
ms45	 أجاب في % اسم بألق أو بألق يقتفي ) 1140 -(@)(@@) ( و الفارسي لابن خالويه % حاور في مسالة لديه ) 1141 -(@)(@@) ( فقال زن من آءة مسطارا % فظن مفعالا به فحارا ) 1142 -(@)(@@) ( فقال الاستاذ له مساء % فالأصل مستطار إذ يجاء ) 1143 -(@)(@@) ( كذا أبو الفتح ابن جني سأله % عن كوكب من لفظ وأي نقله ) 1144 -(@)(@@) ( ثم بواو مع نون جمعه % ثم إلى الياء أضافه معه ) 1145 -(@)(@@) ( فحار أيضا في جواب ما سأل % قال أبو الفتح أوي في المثل ) 1146 -(@)(@@) ( من باع منسوجا كعنكبوت % يجاب في ذاك ببيععوت ) 1147 -(@)(@@) ( و كاطمأن وزنا ابيععا % مصحح الياء فلا يدعا ) 1148 -(@)(@@) ( من قلت كاغدودن فاقوول قل % والأخفش اقويل فالواو ثقل ) 1149 -(@)(@@) ( أظهر على اغدودن واو اقووولا % كذلك ابيويع مثل اغووولا ) 1150 -(@)(@@) ( من قوة مقوي المسفور % و هكذا قوي العصفور ) PageV01P089 1151 -(@)(@@) ( قضية من قضيت قذعمله % و هو قض في عضد في المسأله ) 1152 -(@)(@@) ( و كالقذعميلة في القضيه % فالقضوية على الرويه ) 1153 -(@)(@@) ( و كالحمصيصة في البناء % فالقضوية على القضاء ) 1154 -(@)(@@) ( في ملكوت كقضوت عملا % جحمرش كقضيي قد جعلا ) 1155 -(@)(@@) ( و من حييت حيو كجحمرش % و كالحلبلاب القضيضاء نقش ) 1156 -(@)(@@) ( قرأيت في دحرجت من قراءه % ثم قرأي كسبطر جاءه ) 1157 -(@)(@@) ( أتوا على اطمأننت باقرأيأت % و يقرئي حالهم أن يأتوا ) 1158 -(@)(@@) ( تم بعون الله صرف الشافيه % ورخته فقلت نظمي الوافيه ) PageV01P090 1159 -(@)(@@) ( أبياتها بليغة عليه % عدتها منظومة قويه ) 1160 -(@)(@@) ( ناظمها في سلكها قوام % و الحمد كالمسك لها ختام ) PageV01P091 
