ms121	 عن عطاء: مجهول. -د-(@)(@@)(@@)(@@) $ 3010 - عمارة بن القرشي: عن أبي بردة، قال الأزدي: ضعيف جدا.(@)(@@)(@@)(@@) || عمر(@)PageV01P289(@)(@@)(@@)(@@) $ 3011 - عمر بن إبراهيم العبدي: عن قتادة، وثقه ابن معين، وقال أبو حاتم: لا يحتج به. -ت، س، ق-(@)(@@)(@@)(@@) $ 3012 - عمر بن إبراهيم بن خالد الكردي: عن عبد الملك بن عمير، قال الدارقطني: كذاب يضع.(@)(@@)(@@)(@@) $ 3013 - عمر بن أبان بن عثمان: عن أبيه، له حديث واحد وهو غريب.(@)(@@)(@@)(@@) $ 3014 - عمر بن أحمد بن جرجة: قال ابن طاهر: روى عن الثقات الموضوعات.(@)(@@)(@@)(@@) $ 3015 - عمر بن إسماعيل بن مجالد: قال النسائي، والدارقطني: متروك.(@)(@@)(@@)(@@) $ 3016 - عمر بن إسماعيل: عن هشام بن عروة: مجهول، وحديثه ساقط.(@)(@@)(@@)(@@) $ 3017 - عمر بن أيوب المدني: عن ضمرة وجماعة، جرحه ابن حبان.(@)(@@)(@@)(@@) $ 3018 - عمر بن أبي بكر العدوي: قال أبو حاتم: متروك، ذاهب الحديث.(@)(@@)(@@)(@@) $ 3019 - عمر بن بزيع: عن حارث بن حجاج: مجهول كشيخه.(@)(@@)(@@)(@@) $ 3020 - عمر بن بسطام: عن نصر بن القاسم: مجهول.(@)(@@)(@@)(@@) $ 3021 - عمر بن بلال الحمصي: عن عبد الله بن بسر المازني: مجهول.(@)(@@)(@@)(@@) $ 3022 - عمر بن جعفر البصري الحافظ: ثقة، كذبه أبو محمد السبيعي.(@)(@@)(@@)(@@) $ 3023 - عمر بن حبيب العدوي القاضي: كذبه ابن معين، وضعفه النسائي.(@)(@@)(@@)(@@) $ 3024 - عمر بن أبي الحجبي: بصري، عن ابن جريج، وهاه العقيلي.(@)(@@)(@@)(@@) $ 3025 - عمر بن الحسن الراسبي: عن أبي عوانة، حديث «علي سيد العرب».(@)(@@)(@@)(@@) $ 3026 - عمر بن الحسن الأشناني القاضي: كذبه الدارقطني.(@)(@@)(@@)(@@) $ 3027 - عمر بن حفص العبدي: عن ثابت، قال أحمد: يكتب حديثه.(@)(@@)(@@)(@@) $ 3028 - عمر بن حفص بن عمر بن سعد: عن أبيه، قال ابن معين: ليس بشيء. -ق-(@)(@@)(@@)(@@) $ 3029 - عمر بن حفص، قاضي عمان: قال أبو حاتم: ليس بمعروف.(@)(@@)(@@)(@@) $ 3030 - عمر بن الحكم بن ثوبان: قال البخاري: ذاهب الحديث. -م، د، ق-(@)(@@)(@@)(@@) $ 3031 - عمر بن الحكم الهذلي: قال أبو حاتم: مجهول، ذاهب الحديث.(@)(@@)(@@)(@@) $ 3032 - عمر بن حماد بن سعيد الأبح: عن ابن أبي عروبة، جرحه ابن حبان، وقال أبو حاتم: ليس بالقوي.(@)(@@)(@@)(@@) $ 3033 - عمر بن حمزة بن عبد الله بن عمر: ضعفه ابن معين لنكارة حديثه. -م، د، ت، ق-(@)(@@)(@@)(@@) $ 3034 
ms122	 - عمر بن خليفة: عن هشام بن حسان، قال العقيلي: منكر الحديث. قلت: كأنه عمر بن أبي خليفة.(@)(@@)(@@)(@@) $ 3035 - عمر بن داود: عن سنان بن أبي سنان: مجهول.(@)(@@)(@@)(@@) $ 3036 - عمر بن ذر: عن أبي قلابة، قال يعقوب الفسوي: مجهول.(@)(@@)(@@)(@@) $ 3037 - عمر بن ذر الهمداني: ثقة، مشهور بالإرجاء.(@)(@@)(@@)(@@) $ 3038 - عمر بن ذؤيب: عن ثابت، لا يعرف.(@)(@@)(@@)(@@) $ 3039 - عمر بن راشد اليمامي: ضعفوه. -ت، ق-(@)(@@)(@@)(@@) $ 3040 - عمر بن راشد المدني: قال أبو حاتم: وجدت حديثه كذبا.(@)(@@)(@@)(@@) $ 3041 - عمر بن راشد: عن عبد الرحمن بن حرملة، قال ابن عدي: مجهول.(@)(@@)(@@)(@@) $ 3042 - عمر بن راشد الكوفي: عن نافع، هو أخو محمد وإسماعيل، قال ابن المديني: ولدوا في بطن، وقال البخاري: كانوا أربعة، فالثلاثة محدثون، والرابع لا يحضرني ذكره، ولدوا كلهم في بطن واحد.(@)(@@)(@@)(@@) $ 3043 - عمر بن راشد الثقفي: عن الشعبي، قال أبو حاتم: مجهول.(@)(@@)(@@)(@@) $ 3044 - عمر بن ربيعة الإيادي: عن الحسن، قال أبو حاتم: منكر الحديث.(@)(@@)(@@)(@@) $ 3045 - عمر بن رديح: عن عطاء بن أبي ميمونة، قال ابن معين: صالح الحديث.(@)(@@)(@@)(@@) $ 3046 - عمر بن رؤبة الشامي: قال البخاري: فيه نظر. -عه-(@)(@@)(@@)(@@) $ 3047 - عمر بن رياح، أبو حفص البصري: عن عمرو بن شعيب، ويقال فيه: عمر بن أبي عمر، متروك: قال الفلاس: دجال. -ق-(@)(@@)(@@)(@@) $ 3048 - عمر بن زرعة: عن ابن جريج، قال البخاري: فيه نظر.(@)(@@)(@@)(@@) $ 3049 - عمر بن زياد: عن الأسود بن قيس: مجهول.(@)(@@)(@@)(@@) $ 3050 - عمر بن زيد الصنعاني: عن أبي الزبير، قال ابن حبان: لا يحتج به. -د، ت، ق-(@)(@@)(@@)(@@) $ 3051 - عمر بن سعد: عن عمر الثقفي، قال البخاري: لا يصح حديثه.(@)(@@)(@@)(@@) $ 3052 - عمر بن سعيد الأبح: هو عمر بن حماد بن سعيد، قد ذكر.(@)(@@)(@@)(@@) $ 3053 - عمر بن سعيد بن سريج: عن الزهري، لين الحديث.(@)(@@)(@@)(@@) $ 3054 - عمر بن سعيد الدمشقي: عن سعيد بن عبد العزيز، تركوه.(@)(@@)(@@)(@@) $ 3055 - عمر بن أبي سلمة بن عبد الرحمن: ضعفه ابن معين، وقال النسائي: ليس بقوي. -عه-(@)(@@)(@@)(@@) $ 3056 - عمر بن سليم: عن يوسف بن إبراهيم، لا يعرفان. -د، ق-(@)(@@)(@@)(@@) $ 3057 - عمر بن أبي سليمان. حجازي: مجهول، عن 
ms123	 التابعين.(@)(@@)(@@)(@@) $ 3058 - عمر بن سهل: عن شعبة، يخالف في حديثه. -ق-(@)(@@)(@@)(@@) $ 3059 - عمر بن سيار: عن ابن أخي الزهري، يخالف الثقات. م(@)(@@)(@@)(@@) $ 3060 - عمر بن شاكر: عن أنس، قال أبو حاتم: ضعيف يروي المناكير، وقال ابن عدي: يروي نسخة عشرين حديثا غير محفوظة. -ت-(@)(@@)(@@)(@@) $ 3061 - عمر بن شبيب المسلمي الكوفي: ضعفه الدارقطني وغيره. -ق-(@)(@@)(@@)(@@) $ 3062 - عمر بن شريك: عن أبيه: مجهول.(@)(@@)(@@)(@@) $ 3063 - عمر بن شقيق البصري: عن إسماعيل بن مسلم، حديثه مقارب. -د-(@)(@@)(@@)(@@) $ 3064 - عمر بن شوذب: ضعيف.(@)(@@)(@@)(@@) $ 3065 - عمر بن شيبة: لا يعرف.(@)(@@)(@@)(@@) $ 3066 - عمر بن صالح البصري: عن أبي جمرة، قال أبو حاتم: ضعيف.(@)(@@)(@@)(@@) $ 3067 - عمر بن صالح الواسطي: عن علي بن عاصم، حديثه منكر.(@)(@@)(@@)(@@) $ 3068 - عمر بن صالح: عن عبد الله بن زيد، قال أبو حاتم: ليس بقوي.(@)(@@)(@@)(@@) $ 3069 - عمر بن أبي صالح: عن أبي غالب: مجهول، وعنه مجهول.(@)(@@)(@@)(@@) $ 3070 - عمر بن صبح: عن قتادة وغيره، كذاب، اعترف بالوضع. -ق-(@)(@@)(@@)(@@) $ 3071 - عمر بن صهبان، وقيل عمر بن محمد بن صهبان: عن نافع، تركوه. -ق-(@)(@@)(@@)(@@) $ 3072 - عمر بن طلحة بن علقمة بن وقاص الليثي: شيخ لأبي مصعب: مجهول.(@)(@@)(@@)(@@) $ 3073 - عمر بن طلحة: عن ابن أبي عروبة: مجهول، جرحه ابن حبان.(@)(@@)(@@)(@@) $ 3074 - عمر بن عامر البصري: ضعفه ابن معين مرة، ووثقه أخرى.(@)(@@)(@@)(@@) $ 3075 - عمر بن عبد الله، مولى غفرة: ضعفه ابن معين، والنسائي. -د، ت-(@)(@@)(@@)(@@) $ 3076 - عمر بن عبد الله بن يعلى بن مرة الثقفي: ضعفوه. -د، ق-(@)(@@)(@@)(@@) $ 3077 - عمر بن عبد الله بن أبي خثعم اليمامي: وهاه البخاري وغيره. -ت، ق-(@)(@@)(@@)(@@) $ 3078 - عمر بن عبد الله الرومي: عن شريك، جرحه ابن حبان.(@)(@@)(@@)(@@) $ 3079 - عمر بن عبد الرحمن الوقاصي: عن سالم بن عبد الله ضعفه الأزدي.(@)(@@)(@@)(@@) $ 3080 - عمر بن عبيد الخزاز السابري: عن هشام، ضعفه أبو حاتم.(@)(@@)(@@)(@@) $ 3081 - عمر بن عثمان بن موسى التيمي المدني: قبل المائتين، مقل: مجهول. -ت، ق-(@)(@@)(@@)(@@) $ 3082 - عمر بن عطاء: عن أبي سلمة، قال أبو حاتم: مضطرب الحديث.(@)(@@)(@@)(@@) $ 3083 - عمر بن عطاء: عن عكرمة، ضعفه ابن معين، والنسائي. -د، ت-(@)(@@)(@@)(@@) $ 3084 - عمر بن علي المقدمي: 
ms124	 ثقة، مشهور، لكنه دلس. -ع-(@)(@@)(@@)(@@) $ 3085 - عمر بن عمران السدوسي: مجهول.(@)(@@)(@@)(@@) $ 3086 - عمر بن عمرو العسقلاني: عن سفيان الثوري، قال ابن عدي: يضع الحديث.(@)(@@)(@@)(@@) $ 3087 - عمر بن أبي عمر الدمشقي: عن عمرو بن شعيب، قال ابن عدي: مجهول.(@)(@@)(@@)(@@) $ 3088 - عمر بن عيسى الأسلمي: عن ابن جريج، قال البخاري: منكر الحديث.(@)(@@)(@@)(@@) $ 3089 - عمر بن عيسى الليثي. هو ابن دأب: ضعفه الجماعة.(@)(@@)(@@)(@@) $ 3090 - عمر بن غياث، وقيل عمرو: عن عاصم بن بهدلة: ضعفوه.(@)(@@)(@@)(@@) $ 3091 - عمر بن فرقد: عن عطاء بن السائب، قال البخاري: منكر الحديث.(@)(@@)(@@)(@@) $ 3092 - عمر بن قيس المكي: سندول، عن عطاء، متهم، تركوه يرسل. -ق-(@)(@@)(@@)(@@) $ 3093 - عمر بن أبي كبشة: بصري: مجهول.(@)(@@)(@@)(@@) $ 3094 - عمر بن أبي ليلى: عن محمد بن كعب: مجهول.(@)(@@)(@@)(@@) $ 3095 - عمر بن المثنى: عن أبي إسحاق، ضعف. -ق-(@)(@@)(@@)(@@) $ 3096 - عمر بن المثنى: عن قتادة، شيخ لبقية: مجهول.(@)(@@)(@@)(@@) $ 3097 - عمر بن محمد بن زيد بن عبد الله بن عمر: نزيل عسقلان، ثقة له غرائب. -خ، م، د، س، ق-(@)(@@)(@@)(@@) $ 3098 - عمر بن محمد الزهري: مجهول.(@)(@@)(@@)(@@) $ 3099 - عمر بن محمد الأسلمي: كذلك.(@)(@@)(@@)(@@) $ 3100 - عمر بن محمد بن صهبان: هو عمر بن صهبان.(@)(@@)(@@)(@@) $ 3101 - عمر بن محمد بن السري: عن البغوي، اتهمه أبو الحسين بن الفرات.(@)(@@)(@@)(@@) $ 3102 - عمر بن محمد، أبو القاسم بن الثلاج: عن المحاملي، متهم بالكذب.(@)(@@)(@@)(@@) $ 3103 - عمر بن محمد التل: عن الهلال بن العلاء، قال الدارقطني: وضاع.(@)(@@)(@@)(@@) $ 3104 - عمر بن المختار البصري: قال ابن عدي: روى الأباطيل عن يونس بن عبيد.(@)(@@)(@@)(@@) $ 3105 - عمر بن مدرك القاص: عن القعنبي، ضعيف.(@)(@@)(@@)(@@) $ 3106 - عمر بن مسكين: عن نافع، وعنه المحاربي، وجبارة في حديثه نكرة.(@)(@@)(@@)(@@) $ 3107 - مر بن مصعب بن الزبير: عن عروة، ورد في حديث منكر بمرة.(@)(@@)(@@)(@@) $ 3108 - عمر بن معتب: تابعي، وقال النسائي: ليس بالقوي، وقيل: عمر بن أبي معتب. -د، س، ق-(@)(@@)(@@)(@@) $ 3109 - عمر بن أبي معروف: عن ليث، مكي مجهول.(@)(@@)(@@)(@@) $ 3110 - عمر بن المغيرة: عن داود بن أبي هند، ليس بالمتقن.(@)(@@)(@@)(@@) $ 3111 - عمر بن موسى الوجيهي: عن مكحول، قال ابن عدي: هو 
ms125	 ممن يضع الحديث.(@)(@@)(@@)(@@) $ 3112 - عمر بن موسى: عم الكديمي، قال ابن عدي: ضعيف، يسرق الحديث.(@)(@@)(@@)(@@) $ 3113 - عمر بن موسى التيمي: حمصي، عن مكحول، قال [ص: 298] ابن حبان: يروي الموضوعات. قلت: هو الوجيهي، هو عمر ابن موسى بن حفص.(@)(@@)(@@)(@@) $ 3114 - عمر بن مساور: عن الحسن، وأبي جمرة، ضعفه أبو حاتم.(@)(@@)(@@)(@@) $ 3115 - عمر بن مينا: عن أبيه، وعمر بن أبي مالك، وعمر بن معين: مجهول.(@)(@@)(@@)(@@) $ 3116 - عمر بن نافع: عن أنس، ضعيف، ولابن معين فيه قولان، أما عمر بن نافع مولى ابن عمر فثقة، حديثه في «الصحيحين».(@)(@@)(@@)(@@) $ 3117 - عمر بن نبهان العبدي: عن الحسن، ضعفه أبو حاتم وغيره، أما عمر بن نبهان، تابعي من شيوخ أبي الزبير فسالم من جرح. -د-(@)(@@)(@@)(@@) $ 3118 - عمر بن هارون، أبو حفص البلخي: عن ابن جريج وغيره، تركوه. -ت، ق-(@)(@@)(@@)(@@) $ 3119 - عمر بن الهجنح: عن أبي بكرة الثقفي، نكرة لا يعرف.(@)(@@)(@@)(@@) $ 3120 - عمر بن هشام: شيخ لأبي داود، يروي عن الخريبي، لا يعرف.(@)(@@)(@@)(@@) $ 3121 - عمر بن أبي هوذة: عن ابن جريج: مجهول، لينه يحيى بن معين.(@)(@@)(@@)(@@) $ 3122 - عمر بن واصل: قال أبو حاتم: ضعيف.(@)(@@)(@@)(@@) $ 3123 - عمر بن واصل: شيخ، يروي عن سهل بن عبد الله، اتهمه الخطيب بالوضع.(@)(@@)(@@)(@@) $ 3124 - عمر بن الوليد الشني: قال النسائي: ليس بالقوي.(@)(@@)(@@)(@@) $ 3125 - عمر بن يحيى: عن شعبة، قال أبو نعيم الأصبهاني، متروك.(@)(@@)(@@)(@@) $ 3126 - عمر بن يزيد: عن الزهري، قال ابن حبان: يقلب الأسانيد، ويرفع المرسل.(@)(@@)(@@)(@@) $ 3127 - عمر بن يزيد، أبو حفص الرفاء: عن شعبة، قال ابن عدي: حديثه كالموضوع.(@)(@@)(@@)(@@) $ 3128 - عمر بن يزيد: عن عطاء وغيره، منكر الحديث، لعله صاحب الزهري.(@)(@@)(@@)(@@) $ 3129 - عمر بن يعلى: ضعفه النسائي.(@)(@@)(@@)(@@) $ 3130 - عمر التميمي: عن الحسن: مجهول.(@)(@@)(@@)(@@) || عمران(@)PageV01P299(@)(@@)(@@)(@@) $ 3131 - عمران بن أبان: عن محمد بن مسلم الطائفي، ضعفوه.(@)(@@)(@@)(@@) $ 3132 - عمران بن أنس: مجهول. -د، ت-(@)(@@)(@@)(@@) $ 3133 - عمران بن أوس بن ضمعج: تفرد عن أبيه بحديث.(@)(@@)(@@)(@@) $ 3134 - عمران بن حميري: عن عمار بن ياسر، لا يدرى من هو.(@)(@@)(@@)(@@) $ 3135 - عمران بن خالد الخزاعي: عن ابن سيرين، قال أبو حاتم: 
ms126	 ضعيف.(@)(@@)(@@)(@@) $ 3136 - عمران بن أبي خليد الواسطي: قال أبو داود: ليس بثقة.(@)(@@)(@@)(@@) $ 3137 - عمران القطان بن داور، أبو العوام: ضعفه يحيى والنسائي.-عه-(@)(@@)(@@)(@@) $ 3138 - عمران بن زياد القسملي: عن ثابت، قال الأزدي: مجهول.(@)(@@)(@@)(@@) $ 3139 - عمران بن زيد، أبو يحيى الملائي: عن أبي يحيى القتات، لينه ابن معين. -ت، ق-(@)(@@)(@@)(@@) $ 3140 - عمران بن سريع: عن حذيفة، قال البخاري: في حديثه نظر.(@)(@@)(@@)(@@) $ 3141 - عمران بن ظبيان: شيخ للثوري: مجهول، جرحه ابن حبان.(@)(@@)(@@)(@@) $ 3142 - عمران ابن أبي طلحة البدري: مجهول.(@)(@@)(@@)(@@) $ 3143 - عمران بن عبد العزيز، أبو ثابت الزهري: قال يحيى: منكر الحديث.(@)(@@)(@@)(@@) $ 3144 - عمران بن عبد الله المعافري: قال يحيى بن معين: ضعيف. -د، ق-(@)(@@)(@@)(@@) $ 3145 - عمران بن عبد المعافري: هو ابن عبد الله، تابعي فيه جهالة. -ق، د-(@)(@@)(@@)(@@) $ 3146 - عمران بن عكرمة: روى عنه ذؤيب بن عباد: مجهولان.(@)(@@)(@@)(@@) $ 3147 - عمران بن عيينة: أخو سفيان، قال أبو حاتم: يأتي بالمناكير. -عه-(@)(@@)(@@)(@@) $ 3148 - عمران بن أبي الفضل: عن نافع، قال ابن معين وغيره: ليس بشيء.(@)(@@)(@@)(@@) $ 3149 - عمران بن قيس: عن ابن عمر رضي الله عنهما: مجهول.(@)(@@)(@@)(@@) $ 3150 - عمران بن مسلم الفزاري الكوفي: عن مجاهد، قال أبو أحمد الزبيري: رافضي.(@)(@@)(@@)(@@) $ 3151 - عمران بن مسلم: عن عبد الله بن دينار، قال البخاري: منكر الحديث، أما عمران بن مسلم القصير صاحب الحسن فثقة، وعمران القصير عن أنس، وعنه جعفر بن برقان، مقل.(@)(@@)(@@)(@@) $ 3152 - عمران بن ميثم: تابعي، قال العقيلي: من كبار الرافضة.(@)(@@)(@@)(@@) $ 3153 - عمران بن وهب الطائي: ضعفه أبو حاتم.(@)(@@)(@@)(@@) $ 3154 - عمران بن يزيد، أو ابن زيد التغلبي: شيخ أبي النضر، ضعفه ابن معين. -ت، ق-(@)(@@)(@@)(@@) $ 3155 - عمران العمي: عن الحسن، قال يحيى القطان: كتبت عنه ورميت به.(@)(@@)(@@)(@@) $ 3156 - عمران البارقي: تابعي: مجهول. -د-(@)(@@)(@@)(@@) || عمرو(@)PageV01P301(@)(@@)(@@)(@@) $ 3157 - عمرو بن أبي الأزهر العتكي: قاضي جرجان، عن هشام بن عروة، قال أحمد وغيره: كان يضع الحديث.(@)(@@)(@@)(@@) $ 3158 - عمرو بن بحر الجاحظ: قال ثعلب: ليس بثقة، ولا مأمون.(@)(@@)(@@)(@@) $ 3159 - عمرو بن أبي برة: عن شعبة: مجهول.(@)(@@)(@@)(@@) $ 3160 - عمرو بن بكر السكسكي: اتهمه ابن حبان، وقال ابن عدي: له مناكير. 
ms127	(@)(@@)(@@)(@@) $ 3161 - عمرو بن بشر: مجهول.(@)(@@)(@@)(@@) $ 3162 - عمرو بن أبي بكر: عن محمد بن كعب القرظي، له حديث وهو منكر.(@)(@@)(@@)(@@) $ 3163 - عمرو بن ثابت: هو عمرو بن أبي المقدام، تركوه قال أبو داود: رافضي.(@)(@@)(@@)(@@) $ 3164 - عمرو بن جابر، أبو زرعة الحضرمي: عن جابر، قال النسائي: ليس بثقة. -ت، ق-(@)(@@)(@@)(@@) $ 3165 - عمرو بن جرير البجلي: عن إسماعيل بن أبي خالد، متهم واه.(@)(@@)(@@)(@@) $ 3166 - عمرو بن جميع: عن الأعمش، قال ابن عدي: متهم بالوضع.(@)(@@)(@@)(@@) $ 3167 - عمرو بن حريش الزبيدي: تابعي: مجهول. -د-(@)(@@)(@@)(@@) $ 3168 - عمرو بن الحصين العقيلي: عن ابن ثلاثة، تركوه. -ق-(@)(@@)(@@)(@@) $ 3169 - عمرو بن حكم: عن شعبة، تركه أحمد، والنسائي.(@)(@@)(@@)(@@) $ 3170 - عمرو بن حمزة: عن صالح المري، قال الدارقطني: ضعيف.(@)(@@)(@@)(@@) $ 3171 - عمرو بن حية: تابعي: مجهول.(@)(@@)(@@)(@@) $ 3172 - عمرو بن خالد، أبو حفص: وأبو يوسف الأعشى، عن هشام بن عروة، قال ابن حبان: لا تحل الرواية عنه.(@)(@@)(@@)(@@) $ 3173 - عمرو بن خالد القرشي الكوفي: عن زيد بن علي، كذبه أحمد والناس، أما عمرو بن خالد الحراني، نزيل مصر، فمن شيوخ البخاري. -خ، س-(@)(@@)(@@)(@@) $ 3174 - عمرو بن خزيمة المدني: تابعي، لا يعرف. -د، ت-(@)(@@)(@@)(@@) $ 3175 - عمرو بن خليف الحتاوي، أبو صالح: روى عنه ابن قتيبة العسقلاني، وحتاوة: قرية كان يضع الحديث.(@)(@@)(@@)(@@) $ 3176 - عمرو بن داود: مجهول، روى عنه معلى بن ميمون وحده.(@)(@@)(@@)(@@) $ 3177 - عمرو بن دينار. قهرمان آل الزبير: مشهور، ضعفوه. -ت، ق-(@)(@@)(@@)(@@) $ 3178 - عمرو بن ذو مر الهمداني: عن علي، قال البخاري: لا يعرف.(@)(@@)(@@)(@@) $ 3179 - عمر بن أبي روق، واسم أبيه عطية: ضعفه الدارقطني.(@)(@@)(@@)(@@) $ 3180 - عمرو بن زياد الباهلي: عن مالك، قال أبو حاتم: كذاب أفاك.(@)(@@)(@@)(@@) $ 3181 - عمرو بن سعيد: عن أنس، شامي، قال ابن حبان: لا يحل ذكره في الكتب إلا اعتبارا قلت: يشتبه بعمرو بن سعيد البصري، عن أنس، والبصري ثقة خرج له مسلم.(@)(@@)(@@)(@@) $ 3182 - عمرو بن أبي سلمة التنيسي: ثقة، قال أبو حاتم: لا يحتج به، وقال ابن معين: ضعيف.(@)(@@)(@@)(@@) $ 3183 - عمرو بن شمر الجعفي: عن التابعين، رافضي متروك.(@)(@@)(@@)(@@) $ 3184 - عمرو بن شعيب: