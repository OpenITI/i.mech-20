ms181	 رخ خوبت ار مدارا نکند %~% یا قد تو، سرو را محابا نکند(@)(@@) (@@) با روی تو، گل زغنچه ننماید روی %~% با قد تو، سرو قصد بالا نکند(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1807 روی توز عکس، گلستان آرد بار %~% چشمم ز سرشک، ارغوان آرد بار(@)(@@) (@@) ارسایهآ سروت، اوفتد بر سر خاک %~% عمری ز تو، خاک تیره جان آرد بار(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1808 در باغ، سمن تا ز رخت رنگ ربود %~% غنچه، به ثنای تو زبان باز گشود(@)(@@) (@@) ازر شک لب تو، لاله در خون بنشست %~% وز شرم قد تو، سرو بالا ننمود(@)(@@)(@@)(@@) | جمال گنجه ای(@)(@@) ~~1809 گل، گرچه همه بوی و همه رنگ آیددر جوی لبت، سبوش بر سنگ آید(@)(@@) (@@) خود را چه نهد سرو چمن، بالایی %~% کز قامت تو، ورا قبا تنگ آید(@)(@@)(@@)(@@) | ظهیر شفروه(@)(@@) (@@) 1810 در باغ مرو، تا گل رعنا برود! %~% او شرمگن است، صبر کن تا برود!(@)(@@) (@@) بر سرو مکن تکیه، که جلف است و دراز %~% ترسم که قد توبیند، از جا برود!(@)(@@)(@@)(@@) | بدر تفلیسی(@)(@@) (@@) 1811 تا لعل لب تو، روی خوبی آراست %~% با قد تو، سرو از سر دعوی برخاست(@)(@@) (@@) از لعل تو گشت، خاتم حسن درست %~% وله %~% وزقد تو گشت، کار نیکویی راست(@)(@@) (@@) 1812 گم شد دلم و، زلف تو بویی دارد %~% منکر مشو، ار کسی درستی آرد(@)(@@) (@@) در دعوی دن، شاگهد من روی تو بس %~% خود قد تو، راستی فرو نگذارد PageV01P332(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0336.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1812 نه با توزحال خود، غمی شاید گفت نه یک سخن، از بیش و کمی شاید گفت(@)(@@) (@@) درخشم شدی، که وصف قدت کردم %~% با تو، سخنی راست نمی شاید گفت!(@)(@@)(@@)(@@) | اله(@)(@@) (@@) 1814 ای روی تو بر گل زده پیدا و نهفت %~% باطاق قدت، سرو کجا باشد جفت؟(@)(@@) (@@) چندین چه حدیث سرو آزاد کنی؟ %~% هم قد تو، گر راست همی باید گفت!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 1817 با لاله رخان به باغ سرو از سرناز %~% می کرد، ز شرح غم تو قصه دراز(@)(@@) (@@) از باد صبا، چو وصف قدت 
ms182	 بشنید %~% ز آوازهآ قامت تو، آمد به نماز(@)(@@)(@@)(@@) | نجم گنجه ای(@)(@@) (@@) 1816 گل کیست؟ تو شکرین دهانی او نه! %~% سوسن که بود؟ توخوش زبانی او نه!(@)(@@) (@@) در باغ، به بالای تو می ماند سرو %~% این است، که تو سرو روانی او نه!(@)(@@)(@@)(@@) | شمس گنجهای(@)(@@) (@@) 1811 مه، نام شکستهآ جهان است و تونه %~% گل، دستخوش جهانیان است و تونه(@)(@@) (@@) سروارچه به باغ پادشاه است، ولیک %~% اوله %~% او دست نشان دیگران است و، تونه(@)(@@) ~~1818 از حسن تودر زمانه، افسانه شنوخوبی تورا، زخویش و بیگانه شنو(@)(@@) (@@) دایم سخن قد تومی گوید، دل %~% آری، سخن راست ز دیوانه شنوا(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1819 ای کار قد تو ناپسندیدن سرو %~% پهلو چه کنی به خیره، از دیدن سرو(@)(@@) (@@) بخرام به باغ یک نفس، تا باشد %~% وله %~% از قامت تو صلای رنجیدن سرو(@)(@@) (@@) 1820 آن لحظه که آید به چمن یار، ای سرو %~% جز بندگی قدش مکن کار، ای سرو(@)(@@) (@@) با قامت او، حدیث اندازه مگو %~% اوله %~% اندازهآ کار خود نگه دار، ای سرو(@)(@@) (@@) 182 زلفت، که دلم زمهر او می پیچد %~% دل چیست؟ که جان در تن او می پیچد(@)(@@) (@@) کس، همسری قدت نکرد الا او %~% او نیز، هم ازقدت فرو می پیچد PageV01P333(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0337.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1822 با آنکه به دلبری است یکتا قدت %~% کس مایهآ حسن نیست الا قدت(@)(@@) (@@) در حسن، سر آمد جهان زلف توبود %~% او نیز، بکرد سر به سر با قدت(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) (@@) 1823 یاری، که زجانش دوستر داشتم اوست %~% بروی همه هست و نیست بگذاشتم، اوست(@)(@@) (@@) دی در چمنی رفتم و، سروی دیدم %~% در پای وی افتادم، پنداشتم اوست!(@)(@@) شهاب دفتر خوان(@)(@@) (@@) 1824 رویی همه دلبری و، خویی [همه] خوش %~% چشمی همه تن کرشمه و، قدی کش(@)(@@) (@@) مه با رخ او چیست؟ گرانی بارد %~% با قامت او سرو، درازی ناخوش!(@)(@@) (@@) 1825 امروز، چمن باز بدان می ماند %~% غیره %~% گویی به رخ خوش پسران میماند(@)(@@) (@@) ای سرو، به پایه ای رسیدی که 
ms183	 تورا %~% گویند: به بالای فلان می ماند!(@)(@@)(@@)(@@) | سعید شروانی(@)(@@) (@@) 1826 ای بادهآ عشق، عقل را مست کنی %~% از دست شوم، چو کار ازین دست کنی(@)(@@) (@@) زین سان که شد افراشته شمشاد قدت %~% داری سر آن که سرو را پست کنی(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 1827 از گیل گل نوچون رخ رعنات نرست %~% نرگس، به فریب چشم شهلات نرست(@)(@@) (@@) در باغ وجود، بر لب آب حیات %~% یک سرو، به اندازهآ بالات نرست(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) ~~1828 ای لاله رخ، از بهرخدا، یادت هست؟کاندر چمن باغ همی گشتی، مست!(@)(@@) ~~قدت چو بدید سرو، بنشست زپایرویت چوبدید گل، در افتاد زدست!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1829 ای دو لب تو راحت جان پیوستهدر کشتن من بسته میان پیوسته(@)(@@) ~~زان روی، که ماند به قد توقد سرو سر سبز بود، سرو روان پیوسته(@)(@@)(@@)(@@) | صدر زنگانی(@)(@@) ~~1830 لاله، که مثال عارض وخد تو اوست در باغ، غلام حسن بی حد تو اوست(@)(@@) ~~سرو ارچهآ به اصل هست آزاد، ولیکامروز، کمینه بندهآ قد تو اوست PageV01P334(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0338.jpg)(@)(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) ~~183 گل، گرچه که خوبروی خواندند او رابا روی تو، از باغ براندند او را(@)(@@) (@@) در سرکشیی کرد به بالای تو سرو %~% دور از تو، به خاک در نشاندند او را!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1832 گفتم: گل رعنای تورا، چتوان گفت؟ %~% وان نرگس شهلای تو را، چتوان گفت؟(@)(@@) (@@) گفتا که: بگو، شرح قد و بالایم %~% گفتم: قد و بالای تو را، چتوان گفت؟(@)(@@)(@@)(@@) | اوله(@)(@@) ~~عکس قد خوب یار، در طبع من است 1833 تا معنی را، معدن و کان شد طبعم(@)(@@) %~% زان است، که چون آب روان شد طبعم %~% از غایت لطف، محض جان شد طبعم(@)(@@)(@@)(@@) | نمط دهم(@)(@@)(@@)(@@) | درتشبیهات خال(@)(@@)(@@)(@@) | مبارکشاه(@)(@@) (@@) 183 خالی، که وطن چهرهآ خوب تو گزید گویی که ز گلشن رخ خرم تو %~%(@)(@@) زنگی بچه ای برهنه، گل خواهد چید! %~% دانسی به چه ماند و، چرا گشت پدید؟(@)(@@) ~~من، خال تو را دانه همی دانستم 183 بر طرف لبت، که غایت کام 
ms184	 دل است(@)(@@) %~% اوله %~% کی دانستم؟ که دانه خود دام دل است! %~% خال تو دل آشوب و دلارام دل است(@)(@@)(@@)(@@) | علاء الدین غوری(@)(@@) (@@) 1836 آن خال، بر آن رخ دل افروز نگر %~% بر هر چه مراد اوست فیروزنگر(@)(@@) ~~مانند شب سیاه دلسوختگانسر بر زده از میانهآ روز نگر(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 183 زلفت همه آفاق معطر کرده ست %~% خطت، خط حسن را مزور کردهست(@)(@@) (@@) وان خال، برآن رخ تو، گویی که مگر %~% زنگی بچه ای، زلاله بستر کردهست!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 1838 بر عارض سیم آن بت یغمایی %~% آن خال سیه نگر، بدان زیبایی(@)(@@) (@@) همچون سر انگشت، که از رعنایی %~% در عنبر تر زنی و، در مه سایی PageV01P335(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0339.jpg)(@)(@)(@@)(@@)(@@) | جمال اصفهانی(@)(@@) (@@) 1839 بر چشم تو آن خال تو، ای حور نژاد %~% همچون دل تو سیاه بس طرفه نهاد(@)(@@) (@@) زان غالیه، کابروی تو بنگاشته اند %~% یک قطره فرو چکید و، بر چشم افتاد(@)(@@)(@@)(@@) | جمال اصفهانی(@)(@@) (@@) 1840 آن خال فراز چشمت، ای حور نژاد %~% بس نغز نهادهاند و، بس طرفه نهاد(@)(@@) (@@) گویی که به تحقیق، دبیر استاد %~% یک نقطه زمشک، بر سر صاد نهاد(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1841 نقاش ازل به خامه، ای حور نژاد %~% ابروی تورا، به چابکی خم می داد(@)(@@) (@@) یک قطره، ز کلک عنبرینش بچکید %~% بر طرف لب شکرفشان تو فتاد(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) (@@) 1842 خالی است سیاه، بر رخ آن مهوش %~% افتاده خوش و، مرا همی افتد خوش(@)(@@) (@@) چون مهر، که از مشک نهی بر باده %~% یا قطرهآ آبی، که چکد بر آتش!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1843 در چاه زنخدانت، دل ما به نواست %~% وان خال سیاه تو، بدین حال گواست(@)(@@) (@@) سیبی است زنخدان تو، وان خال سیاه %~% از غایت لطف، دانه در وی پیداست(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1844 از روی تو، زلف پارهای بگرفته ست %~% هر حلقه ازو، کنارهای بگرفتهست(@)(@@) (@@) وان خال سیاه بر رخت، پنداری %~% در پیکر مه، ستارهای بگرفتهست(@)(@@)(@@)(@@) | جمال اصفهانی(@)(@@) (@@) 1845 مشاطهآ تقدیر، قضا را بگماشت %~% تا بر رخ توزمشک، خالی بنگاشت(@)(@@) (@@) یعنی که: 
ms185	 هر آنکه وصل ما می طلبد %~% او را پس ازین، جامه چنین باید داشت!(@)(@@)(@@)(@@) | رفیع لنبانی(@)(@@) (@@) 1846 گیرم که به جز جور دمادم نکنی %~% گیرم که دلم به وصل، خرم نکنی(@)(@@) (@@) بر آتش رخسار تو، همچون خالت %~% خوش می سوزم، نظاره ای هم نکنی!(@)(@)PageV01P336(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0340.jpg)(@)(@)(@@) (@@) 1847 چون دایرهآ لب تو درهم پیوست %~% ثیا %~% بنگر که چگونه عرصه ای داشت به دست(@)(@@) (@@) کان نقطهآ عنبرین به دستور لبت %~% در دایره جا نیافت، بر گوشه نشست(@)(@@)(@@)(@@) | تاج الدین(@)(@@) (@@) 1848 در چاه زنخدان تو، ای عشوه پرست %~% خالی است، فریبنده تر از نرگس مست(@)(@@) (@@) نه نه غلطم، که خال تو بر زنخت %~% زنگی بچه ایست، گوی سیمین دردست(@)(@@)(@@)(@@) | جمال بخاری(@)(@@) (@@) 1844 تا دست ازل، نقش تو دلکش کردهست %~% عشق رخ تو، جهان پر آتش کردهست(@)(@@) (@@) مرطرف لب لعل تو، از مشک تبت %~% خالی است، که حال من مشوش کردهست(@)(@@)(@@)(@@) | رشید سمرقندی(@)(@@) (@@) 185 طرفه شدهای و، طرفه حالی که توراست %~% زان طرفه ترای جان وجهان، حال که راستب(@)(@@) (@@) خال تو، به سوی لب چنان آمد راست %~% گویی که از و بوسه همی خواهد خواست(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~دیدم که نهند مشک، بر آتش تیز 185 آن خال بر آن ساعدت، ای حور نژاد(@)(@@) %~% دادهست بسی خرمن دلها بر باد %~% بر آب ندیدهام، کسی مشک نهاد(@)(@@)(@@)(@@) | خطیر الدین(@)(@@) (@@) 185 یارم، که کم از هیچ میانی دارد ر لعل شکر فشان، نشانی دارد %~%(@)(@@) گویی که دلی بر سر جانی دارد %~% وانگاه، کم از میان دهانی دارد(@)(@@)(@@)(@@) | ابوالعلای (شاپور؟)(@)(@@) (@@) 1852 آن خال فراز چشمت، ای حور نژاد %~% همچون دل من سیاه بس طرفه فتاد(@)(@@) (@@) هرگه که بدو در نگرم، گردم شاد %~% گویم که دلم ببرد و بر دیده نهاد(@)(@@)(@@)(@@) | معین طنطرانی(@)(@@) ~~185 آن خال، که با دل منش خون افتاد بر گوشهآ لب، بگوی تا چون افتاد؟(@)(@@) (@@) در دایرهآ دهان، مگر جای نیافت %~% آن نقطه، که از دایره بیرون افتاد(@)(@@)(@@)(@@) | هستی(@)(@@) ~~185 آن خال، که برگردن مرد افکن 
ms186	 توستهمواره، مغمز تن پرفن توست(@)(@@)(@@)(@@) | ی وزن من است، در گردن توست.(@)(@)PageV01P337(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0341.jpg)(@)(@)(@@)(@@)(@@) | صاین مراغی(@)(@@) (@@) 1856 تا شیر و شکر، در رطب آورد لبت %~% خال خوش عنبر لقب آورد لبت(@)(@@) (@@) آن خال بر آن لب لبت، جان من است %~% از بهر چه جانم به لب آورد لبت!(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 1857 بندی، که ز زلف دلکش انداخته ای %~% در حلق دل خلق، خوش انداخته ای(@)(@@) (@@) نمرود صفت، خال خلیل آسا را %~% انصاف، که خوش در آتش انداخته ای(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1858 آن خال سیه بر آن رخ، ای خرمن گل %~% مشک است و، کسی ندید مشک ازتن گل(@)(@@) (@@) ترسید مگر زمانه از رفتن گل %~% الغیره %~% کز مشک زدهست میخ، بردامن گل(@)(@@) (@@) 1859 جانا، رخ توفتنهآ ابدال چراست؟ %~% و اندر صفتش، دلم بدین حال چراست؟(@)(@@) (@@) در کتبت ماه را نقط نیست، رخت %~% ماه است، برو نقطه ای از خال چراست؟(@)(@@)(@@)(@@) | نمط یازدهم(@)(@@)(@@)(@@) | درتشبیهات لب(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) (@@) 1860 بر یاد تو، زهر دو ستگانی گردد %~% وزنام تو، مرگی زندگانی گردد(@)(@@) (@@) بر کاغذ اگر وصف لبت بنویسم %~% رخسارهآ کاغذ، ارغوانی گردد(@)(@@)(@@)(@@) | رضی نیشابوری(@)(@@) (@@) 1861 مه، پیش رخت جلوه گری یارد کرد؟ %~% مشاطگی گل طری یارد کرد؟(@)(@@) (@@) شکر، که هزار بار شد آب از شرم %~% پیش لب لعلت، شکری یارد کرد؟(@)(@@)(@@)(@@) | شهری(@)(@@) (@@) 1662 شکر، زلبت به طعنه لنگ آمده ایست %~% در تنگ بدان شد، که به تنگ آمده ایست(@)(@@) (@@) شکر شکنا، زلعل نیز ایمن باش %~% کو نیز، برآبگینه سنگ آمده ایست(@)(@@)(@@)(@@) | صانعی(@)(@@) (@@) 1863 یاقوت ز خورشید، همی گیرد رنگ %~% خورشید بر آسمان، و او اندر سنگ(@)(@@) (@@) یاقوت لب بتم، از آن رنگین است %~% کاندر بر خورشید، همی باشد تنگ PageV01P338(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0342.jpg)(@)(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) ~~1864 آن لعل، که نرخ قند بشکست این است وان آب حیات و، آن حکایت که(@)(@@) کنند %~% دانم که شنیده ای، اگر هست این است! %~% وان باده، که عقل را کند مست این است(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 1865 ای مهر ومه، از رخ 
ms187	 تو تشویر خوران %~% وز غمزهآ تو، جان و دلم تیر خوران(@)(@@) (@@) روزی که تو شیر خواره بودی، بودند %~% شیر و شکر، از لبان تو شیر خوران!(@)(@@) (@@) 186 ای چشمهآ جان بسته به دریای لبت %~% اوله %~% وی شیفته عالمبی، زسودای لبت(@)(@@) (@@) جانم، زنهانخانهآ این سینهآ تنگ %~% بر بام لب آمد، به تماشای لبت(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) یاقوت، در آتش لبت آب شود 1867 ای لعل جهان نعل بهای لب تو %~% ظهیر(@)(@@) %~% ای آب حیات خاک پای لب تو! %~% فیروزهآ چرخ، رهنمای لب تو(@)(@@) (@@) 1868 در عشق تو، ای کوی غمت منزل من %~% بگداختم و، حل نشد این مشکل من(@)(@@) (@@) آن لعل لبت، با همه سیرابی خویش %~% از بهر چه شد تشنه به خون دل من(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1869 روی تو به حسن، بر قمر می خندد %~% زلفین تو، بر عنبر تر می خندد(@)(@@) (@@) نوشین لب تو، ز غایت شیرینی %~% لغیره %~% بیوسته، چو پسته بر شکر می خندد(@)(@@) ~~هرگز به جهان ندید کس، تشنه لبی 1870 ای من به تو دل ز مهر بانی داده(@)(@@) %~% الغیره %~% جان بر لب آب زندگانی داده %~% پیش دولبت، جان و جوانی داده(@)(@@) (@@) 187 گل، با رخ گلرنگ تو تشویر خورد %~% نرگس، ز کمان ابرویت تیر خورد(@)(@@) (@@) در نیشکری سبز شکر در طفلی %~% گویی زلب چون شکری شیر خورد(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 1872 هرکز لب شیرین تو محروم شود %~% از تاب تو، سوزنده تر از موم شود(@)(@@) (@@) آن دو لب شیرین تو، ای جان و جهان %~% چیزی است، که آن به ذوق معلوم شود PageV01P339(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0343.jpg)(@)(@)(@@) (@@) 18733 یک بوسه از آن دو لعل خندان لبت %~% لغیره %~% هان تا ندهی جان تو وجان لبت(@)(@@) (@@) ارجان بدهد زتشنگی آب حیات %~% آبش مده از چشمهآ حیوان لبت(@)(@@)(@@)(@@) | معین طنطرانی(@)(@@) ~~1874 معشوق مرا، لب و دهان شیرین است گفتا که: مکش دست به تنگ شکرم(@)(@@) %~% گفتم: نتوان کرد که جان شیرین است! %~% وین تلخی عمر، از آن زبان شیرین است(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1875 آن سبزهآ نورسته 
ms188	 چنان شیرین است %~% کز تلخی آن، همه جهان شیرین است(@)(@@) (@@) روزی، سخنی از لب او می گفتم %~% زان روز مرا همه دهان شیرین است(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) در خاتم وصلش ار نگین می طلبی 1876 یکساعته وصل دوست، جانی ارزد %~%(@)(@@) جان را چه محل بود؟ جهانی ارزد! %~% از لعل لبش طلب، که کانی ارزد(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 1877 گرچه زلبت زیر و زبر می گردم بلبل نفسم، هوای گل می دارم %~% با(@)(@@) دو لب خشک و چشم تر می گردم %~% طوطی سخنم، گرد شکرمی گردم!(@)(@@) (@@) 1878 بر گوشهآ مه، عنبر گلبوش نمود %~% اوله %~% دل شیفته گشت و، عقل مدهوش نمود(@)(@@) (@@) از پرده برون فتادم آن لحظه که او %~% قدر سر نیشی ز لب نوش نمود(@)(@@)(@@)(@@) | برهان گنجه ای(@)(@@) (@@) 1879 گر رنگ رخت، به باد برداده شود %~% از رنگ رخنت، باد همه باده شود(@)(@@) (@@) ار تو به مثل، به سنگ بر بوسه دهی %~% سنگ از لب تو، عقیق و بیجاده شود(@)(@@) قاضی کمال مراغه ای(@)(@@) (@@) 1880 چشمم چوبه روز آن رخ دلبر بیند %~% در شب لب لعل او به خواب اربیند(@)(@@) (@@) بلبل همه روز، وصل گل را طلبد %~% طوطی همه شب، به خواب شکر بیند(@)(@@)(@@)(@@) | خطیر ابوزید(@)(@@) ~~مس تنگدلم زهر دو، گویی که دلم 1881 گل، از دو رخ پر طربت نقش گرفت(@)(@@) %~% نرگس، زدو جادو نسبت، نقش گرفت %~% چون موم، زمیم دو لبت نقش گرفت PageV01P340(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0344.jpg)(@)(@)(@@) قاضی ابوالمجد(@)(@@) (@@) 1882 باد، از سر زلف تو خبر داد به چین %~% خاک آمد و، کرد پایبوس تو گزین(@)(@@) (@@) از عکس رخ تو، لاله بگرفت آتش %~% وز شرم لبت، آب فرو شد به زمین(@)(@@)(@@)(@@) | سید مرتضی(@)(@@) (@@) 1882 جام، از لب تو چو در طرب می آید از آرزوی لب تو، جام می را %~%(@)(@@) دانی که لبالب چه سبب می آید؟ %~% جانی که شراب است، به لب می آید(@)(@@)(@@)(@@) | وله(@)(@@) ~~از رشک لب تو، کس چه داند کورا 188 آن جام، که از باده رخش گلگون است 
ms189	(@)(@@) %~% با آن لب خندان، چه دلی پرخون است؟ %~% در خنده چوصبح، اگر چه روز افزون است(@)(@@)(@@)(@@) | مرزبان(@)(@@) ~~1884 چشمت، که ز چشم من گهر می ریزد چشم تو، به تیغ اگر بریزد خونم(@)(@@) %~% هم، خون من خسته جگر می ریزد %~% شاید، که لبت خود به شکر می ریزد(@)(@@) ~~از رشک لب تو، هر کجا نیشکری است 1886 از ر شک رخ تو ماه، می فرساید(@)(@@) %~% لغیره %~% هرماه دو شب، روی به کس ننماید %~% انگشت، به دندان کسان می خاید(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) ~~گر من زلبت نمی شکیبم، چه عجب 1887 هرگز، من از آن نرگس تر نشکیبم(@)(@@) %~% من طوطی عشقم، زشکر نشکیبم %~% زان روی زگل شکفته تر نشکیبم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 188 دل در غم تو، به شادمانی میرد %~% جان در هجرت، به کامرانی میرد(@)(@@) (@@) می میرم پیش لب تو، این عجب است %~% اوله %~% کس بر لب آب زندگانی میرد:(@)(@@) (@@) 1885 از بهر لبت، که آب حیوانش رهی است %~% غم نیست اگر کنارم از وصل تهی است(@)(@@) (@@) اسکندر وقت، مردم دیدهآ من %~% جویای لب تو، همچنان در سیهی است(@)(@@) (@@) 189 هر دل، که بر تو سیمبر بگذارند %~% وله %~% او را و تو را، به یکدگر بگذارند(@)(@@) (@@) در کنج لب توجای گیرد، کانجا %~% آرامگهی خوش است، اگر بگذارند PageV01P341(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0345.jpg)(@)(@)(@@)(@@)(@@) | بغیره(@)(@@) (@@) 1891 ای پر مگس برون ز شکر کرده %~% لالایی جا حیات (؟) عنبر کرده(@)(@@) (@@) لعل از حسد لب توای آب حیات %~% در سنگ شکسته، خاک بر سر کرده(@)(@@)(@@)(@@) | حمید گنجه ای(@)(@@) (@@) 1892 در زیر کله، کلاله بین تا چه خوش است %~% وان مشک ندیم لاله بین، تا چه خوش است(@)(@@) (@@) ماند به پیالهای پر از باده، لبش %~% آن بادهآ در پیاله بین، تا چه خوش است(@)(@@)(@@)(@@) | خطیر ابوزید(@)(@@) (@@) 1893 یاقوت لب تو، کیمیای طرب است %~% در دیدهآ عقلم تسوتیای طرب است(@)(@@) (@@) نی نی غلطم، لبت ورای طرب است %~% بنیاد حیات است، چه جای طرب است!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1894 چون زلف تو، کس کمند پرتاب ندید 
ms190	 %~% کس چون خم ابروی تو، محراب ندید(@)(@@) (@@) جان دوش، لب لعل تو دیدهست به خواب %~% شیرین تر از این [خواب] کسی خواب ندید!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1895 ای برده سبق زآب حیوان لب تو %~% خون کرده دل لعل بدخشان، لب تو(@)(@@) (@@) از لفظ خوشم، شکر فرو می بارد %~% زانگه که گرفتهام به دندان، لب تو(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1896 ای چشم و لب توهمچوبادام و شکر %~% نقلم ز تو هست این دو، بادام و شکر(@)(@@) (@@) در عالم دلبری که دارد گویی %~% از جزع و عقیق جز تو، بادام و شکر(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1897 بر گل، ز بنفشه عارضت رنگ آورد %~% بر ماه رخت کار به جان تنگ آورد(@)(@@) (@@) گوهر، بر دندان تو در آب نشست %~% لبهای تو، پای لعل در سنگ آورد(@)(@@)(@@)(@@) | رضیهآ گنجه ای(@)(@@) ~~1898 تا شاه رخت ملک بهاری بگرفت هریک زمیانه پیش کاری بگرفت(@)(@@) (@@) شد غمزه وزیر و، ابروت حاجب خاص %~% لعلت زمیانه، آبداری بگرفت(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1899 از شرم رخ تو، آتش آبی گردد %~% وز نور تو، ذره آفتابی گردد(@)(@@) (@@) شکر، ز خجالت لب شیرینت %~% از بس که عرق کند جلابی گردد PageV01P342(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0346.jpg)(@)(@)(@@) ~~وان آب حیات را که مردم گویند 190 سرو ارچه بلند است، به آیین تونیست(@)(@@) %~% الغیره %~% سرچشمه اش، الآ لب نوشین تونیست %~% ماه ارچه شکرف است، به تمکین تونیست(@)(@@)(@@)(@@) | شهریارزوزن(@)(@@) (@@) 1901 دریاب، که کار حسن در می گذرد %~% و اقبال زمانه، زود برمی گذرد(@)(@@) (@@) شکرانه کنون ده، که زیاد لب تو %~% در هر دهنی، سخن شکر می گذرد(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 190 یاقوت لب تو گوهر کان دل است %~% مغز دل وجان و، مایهآ جان دل است(@)(@@) (@@) دل خضر مسافر است، در ظلمت تن %~% نوشین لب تو، چشمه حیوان دل است(@)(@@)(@@)(@@) | وله(@)(@@) (@@) کالای غریب است لبت، سختش دار 1903 ای چشم خوشت نرگس رعنای غریب %~%(@)(@@) وی وصل تو در دلم تمنای غریب %~% تا کس نکند طمع، به کالای غریب!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 190 گر چشم خوشت، کمین جان می سازد %~% یاقوت 
ms191	 لبت، قوت روان می سازد(@)(@@) (@@) هر نیش، که چشم تو زند بر دل من %~% نوشین لب تو، مرهم آن می سازد(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1905 آن روز، که صبح اجل آرد شب من %~% در زیر زمین، خاک شود قالب من(@)(@@) (@@) از نام لبت - که بر لبم کرد گذر- %~% بس لاله که بردمد، زخاک لب من(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1906 با لطف تو، آب از گل تر می بچکد %~% وز رشک تو، زهرهآ قمر می بچکد(@)(@@) (@@) وصف لب لعل تو، به شکر نکنم %~% کز شرم لبت، خوی ز شکر می بچکد(@)(@@)(@@)(@@) | عیانی گنجه ای(@)(@@) (@@) 1907 چاکر به لب توای پسر، خودارد %~% چون بلبل، کو بر گل تر خودارد(@)(@@) (@@) جانا، تو شکر لبی ومن طوطی طبع %~% دانی تو، که طوطی به شکر خودارد(@)(@@) ~~1908 یک بوسهام از لب تو، گر می باشد آن روز، مرا حال بتر می باشد(@)(@@) (@@) زیرا که زیک بوسه، جزاین فایده نیست %~% کم آرزوی یکی دگر می باشد PageV01P343(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0347.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) ~~1909 عهدی کردم، که قصد امرد نکنمقصد خط وخال وعارض وخد نکنم(@)(@@) (@@) لیکن چوتوام بوسه دهی، رد نکنم %~% مستوری سرد، تا بدین حد نکنم(@)(@@)(@@)(@@) | جمال اشهری(@)(@@) (@@) 1910 چون بار غمت، جز دل ریشم نکشد %~% وز مهر تو، دل به مهر خو یشم نکشد(@)(@@) (@@) آن پستهآ تنگ تو، نگویی که چرا %~% یک بوسهآ تنگ پسته، پیشم نکشد؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1911 تا چند، دلم قرین آتش داری %~% عیشم، به دو زلف در کشاکش داری(@)(@@) (@@) از مملکت لبت، چه کم گردد اگر %~% وقتم به یکی بوسهآ خوش، خوش داری؟(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1912 از آرزوی بوسهآ آن جان و جهان %~% بر بوسه گهش نهادم انگشت، نهان(@)(@@) (@@) یک سال فزون است، که از لذت آن %~% انگشت، همی برون نیارم زدهان(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1913 دل مردهآ توست، تا حیاتی بدهی %~% بر لعل، به یک بوسه براتی بدهی(@)(@@) (@@) از شکر بوسه، لعل توقارون است %~% کم زانکه هزار یک زکاتی بدهی!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1914 بر من، لبت اربه بوسه [جانی] بخشود %~% انصاف نباشد، که 
ms192	 شوی خشم آلود(@)(@@) ~~خود حاصل این قصه جز این نیست، که بود او را شکری زیان، مرا جانی سود!(@)(@@)(@@)(@@) | وله(@)(@@) ~~1915 یک شب، به خودت کشم به مشکین رسنت صد بوسه زنم، بر لب شکر شکنت(@)(@@) (@@) وز بوسه، چو فریاد کنی در شکنم %~% فریاد، به بوسه ای دگر در دهنت!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1916 گردون، چو بپرداخت ز کار لب تو %~% و آراست به سبزه، جو یبار لب تو(@)(@@) (@@) مقصود من از جمله جهان، بوسی بود %~% آن نیز، نهاد در کنار لب تو(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~191 دوشینه شب، اندر آنچنان رهگذری بوسید مرا نگار من بی خبری(@)(@@) (@@) امروز چه خوشدلم که می گفت به ناز: %~% ای جانت به لب رسیده خواهی دگری!(@)(@)PageV01P344(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0348.jpg)(@)(@)(@@)(@@)(@@) | سید بخاری(@)(@@) (@@) 1918 صوفی شوم و، لباس فیروزه کنم %~% در صفهآ غم، عزیمت روزه کنم(@)(@@) (@@) بس پیش رخت، برون کنم دست نیاز %~% بوسی ز کف پای تو، در یوزه کنم(@)(@@)(@@)(@@) | ظهیر فاریابی(@)(@@) (@@) 191 آن بت، که زغم خویش مدهوشم کرد %~% بگرفت، به قهر حلقه در گوشم کرد(@)(@@) (@@) ی خواستم از درد، که فریاد کنم %~% لب بر لب من نهاد و، خاموشم کرد!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 192 یارب، که من و هزار بهتر زمنت %~% برخی تن نرم و نازک چون سمنت(@)(@@) ~~192 صوفی شوم و، خرقه کنم فیروزه ای جان و جهان، زخود روا می داری(@)(@@) %~% لغیره %~% من مرده و، آب زندگی در دهنت! %~% وردی سازم غم تو را، هر روزه(@)(@@) (@@) رنبیل، به دست دل دیوانه دهم %~% تا از لب تو، بوسه کند در یوزه(@)(@@) (@@) 192 زین خط، که به گرد آن لبان می آید %~% لیر %~% سرمایهآ حسنت، به زیان می آید(@)(@@) (@@) صد بار بگفتم که: شکرهای لبت %~% بفروش ومنه، که کاروان می آید!(@)(@@)(@@)(@@) | بدر تفلیسی(@)(@@) (@@) 1922 ای زلف خوشت را حرکاتی نیکو %~% خط تو، بر آن وجه زکاتی نیکو(@)(@@) (@@) خوش باش، که می برآورد دایهآ حسن %~% طفل شکرت را، به نباتی نیکو(@)(@@)(@@)(@@) | شمس گنجه ای(@)(@@) (@@) 192 صد بار کنم جهد، من 
ms193	 خسته جگر %~% تا با تو کنم وصف لبت، ای دلبر(@)(@@) (@@) خود زهره که راست گفتن، ای سیمین بر %~% پیش تو، حدیشی ز شکر شیرین تر(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~192 گر وصف رخت، مرا به گفتار آرددر هر حرفی، گلی پدیدار آرد(@)(@@) (@@) ور شرح لبت را به قلم، بنویسم %~% بی، باز دگر باره شکر بار آرد(@)(@@)(@@)(@@) | شرف بیکقانی(@)(@@) ~~1922 ای از تو امید ساده بدنام شده بل عقل حلال زاده، بدنام شده PageV01P345(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0349.jpg)(@)(@)(@@) ~~1(@)(@@)(@@)(@@) | خلیل شروانی(@)(@@) (@@) 1927 با وصل توای نگار، کار است مرا %~% با لعل تو، بی شمار کار است مرا(@)(@@) (@@) در پیش لب چون شکرت، خواهم مرد %~% در هر نفس، ارهزار کار است مرا(@)(@@)(@@)(@@) | نمط دوازدهم(@)(@@)(@@)(@@) | دربوسه دادن ونادادن(@)(@@)(@@)(@@) | لااعرف(@)(@@) (@@) 1928 جانا، همه سازهای دمسازم زن %~% بانگی که زنی، هم از سر نازم زن(@)(@@) (@@) از بهر یکی بوسه، چه در خشم شدی؟ %~% لغیره %~% اینک لب من! بیا وصد بازم زن!(@)(@@) (@@) 1929 خوش خفته به ناز، آن بت سیم ذقن %~% بوسی زدمش، که کام خوش گشت و دهن!(@)(@@) (@@) برجست و، به خشم گفت: دور از لب من! %~% این پسته شکستن است، نه بوسه زدن!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1930 خورشید شراب و، ماه ساقی دارم %~% با حور، منم که هم وثاقی دارم؟(@)(@@) (@@) یک بوسه برآن لبم حسابی افتاد %~% صد بستدم و، هزار باقی دارم!(@)(@@)(@@)(@@) | زکی کاشغری(@)(@@) (@@) 1931 لب بر لب تو، به صد برانداز نهم %~% بوسه نه یکی، هزار آغاز نهم(@)(@@) (@@) آنگاه، اگر هیچ عتاب آغازی %~% برداشته بوسهها، به جا باز نهم!(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 1932 جانا، لب لعلت آنچنان شیرین است %~% کزیاد لبت، مرا دهان شیرین است(@)(@@) (@@) جان است لبت به بوسه، آسان آسان %~% گر می ندهی رواست، جان شیرین است!(@)(@@)(@@)(@@) | نظامی گنجه ای(@)(@@) ~~1933 گفتم که: دل مرا جگر سفت مکن بوسی بده و، با جگرم جفت مکن!(@)(@@) (@@) خوشتر چه از آنکه او، به تسلیم وبه شرم %~% می داشت دهن به پیش و، می گفت: مکنا PageV01P346(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0350.jpg)(@)(@)(@@)(@@)(@@) | شرف شفروه(@)(@@) (@@) 1934 دوش آنهمه 
ms194	 لطف، اگر چه از مستی بود %~% پیرایهآ عمر و، مایهآ هستی بود(@)(@@) (@@) سوسی به سرانگشت، به ما می انداخت %~% من می ستدم، اگر چه سردستی بود!(@)(@@) (@@) 1935 از بس که لبم کرد، هوای لب تو %~% وله %~% جانم به لب آمد، از برای لب تو(@)(@@) (@@) دست لب من گیر، به بوسی زلبت %~% ای آب حیات خاک پای لب توا(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1930 هر فتنه، که چرخ در قرانی بکند %~% چشم تو به غمزه، در زمانی بکند(@)(@@) (@@) یک بوسه لب تو، به دو صد جان ندهد %~% ترسد، که ز سرمایه زیانی بکند!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1931 گر لعل تو، بوسی به روانی بدهد %~% این عاشق دلداده، روانی بدهد(@)(@@) (@@) ور زانکه به سیم و زر، در آری سر را %~% هر چند که مفلس است، جانی بدهد(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1938 ای شاخ نشاط، از توبری بایستی! شیرین پسری، ولیک ما را زلبت %~%(@)(@@) جزخنده و نکته، شکری بایستی! %~% به زینت، سوی ما نظری بایستی!(@)(@@) (@@) 193 جانا، به سرت هیچ سر آن داری بوسی، به زکات لب به ما بسپاری %~%(@)(@@) وله %~% کاین عادت سرکشی، زسر بگذاری؟ %~% خوز ستانی! کم شکری پنداری!(@)(@@)(@@)(@@) | تاج زنگانی(@)(@@) (@@) 1940 تیر مژهات، گر هگشایی عجب است سلطان لبت، که گنج گوهر دارد %~%(@)(@@) یک بوسه نمی دهد، گدایی عجب است! %~% وان ابرو و غمزه، دلر بایی عجب است(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~191 یاری، که مرا جفا زغم کم ندهدوین زخم مرا، به بوسه مرهم ندهد(@)(@@)(@@)(@@) | قطب اهری PageV01P347(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0351.jpg)(@)(@)(@@)(@@)(@@) | مجیر بیلقانی(@)(@@) (@@) 1943 هم جور تو بردن، آرزو می کندم %~% هم پیش تو مردن، آرزو می کندم(@)(@@) (@@) آن بوسه، که دوشم زلبان دادستی %~% هم با تو سپردن آرزو می کندم!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1944 چون زلف تو، حال خود مشوش بکنم %~% خاک درت، از دیده متقش بکنم(@)(@@) (@@) جان از بن دندان بدهم، گر بدهی %~% چندان شکر از لب، که دهان خوش بکنم!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1945 خواهم، که همه لعل نگینت بوسم %~% یا زلف سیاه پر زچینت بوسم(@)(@@) (@@) جانا، توخلیفهآ زمانی امروز %~% دستوری ده، 
ms195	 که آستینت بوسم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1946 مگذار بتا، که غبغبت را بوسند %~% وان ماه چهارده شبت را بوسند(@)(@@) (@@) چون نگذاری، که آستینت بوسم %~% مگذار، که دیگران لبت را بوسند!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1947 ای هر چه شکر زنیمکاران لبت %~% وی هر چه گهر ز رهگذاران لبت(@)(@@) (@@) چشمی دارم ز اشک، چون ابر بهار %~% در حسرت و رشک بوسه باران لبت!(@)(@@)(@@)(@@) | معین طنطرانی(@)(@@) (@@) 1948 دانی که لبم هست، دعاگوی لبت %~% خوش کن نفسی با لب من، خوی لبت(@)(@@) (@@) دریاب لبی، که خاکبوس لب توست %~% ای آب حیات جمله در جوی لبت!(@)(@@)(@@)(@@) | فخر مبارکشاه(@)(@@) (@@) 1949 زان ستبل تازه، نافهآ آهوبخش %~% دل را، جانی ز نرگس جادو بخش(@)(@@) (@@) از باغ جمال تو چه کم خواهد شد؟ %~% ای سیب زنخ، هان! دو سه شفتالو بخش!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1950 آن بت، که دوای دل من در لب اوستدرمان دل هزار تن، در لب اوست(@)(@@) (@@) جان می خواهد بهای یک بوسه، ولیک %~% در جان سخنی نیست، سخن در لب اوست!(@)(@@)(@@)(@@) | صدر خجندی(@)(@@) (@@) 1951 یک بوسه زلعل خویش کم گیر، و ببخش %~% زنهار، روا مدار تقصیر و، ببخش(@)(@@) (@@) جان پیش کشیدهام، نه از بهر بها %~% این هدیه و، آن عطاست، پذیر و، ببخش!(@)(@)PageV01P348(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0352.jpg)(@)(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1952 هر توبه که داشتم، نگارم بشکست می خوردم و، دست اختیارم بشکست(@)(@@) (@@) جون دید که با خمار برخاستهام %~% بنشست، به یک بوسه خمارم بشکست(@)(@@) (@@) 1953 ای جان وجهان، فغان ازین جان وجهان %~% الغیره %~% مردم ز غم تو آشکارا و نهان(@)(@@) (@@) یک بوسه وجان، ناز مکن، هیچ مگو! %~% بستان و بده، جور مکن، باز رهان!(@)(@@)(@@)(@@) | اوحد کرمانی(@)(@@) (@@) 1954 کردم لب نوش آن دلارام طمع %~% و انداخت مرا در دم آن دام، طمع(@)(@@) (@@) گفتم: زلبت بادهآ خامم طمع است! %~% گفتا: برو، ای سوختهآ خام طمع!(@)(@@)(@@)(@@) | سید شیرانی(@)(@@) (@@) 1955 آن لب، که اگر در شکری آمیزد %~% از همجنسی، شکر در او آو یزد(@)(@@) (@@) با من صد ره، به بوسه ای بستیزد %~% و آنگه، زلبش بوسه فرو می 
ms196	 ریزد!(@)(@@)(@@)(@@) | سید حافظ(@)(@@) (@@) 1956 بگذار، که جزع دلر بایت بوسم %~% یا آن لب لعل جانفزایت بوسم(@)(@@) (@@) در جزع ولبت، طمع کجا یارم کرد %~% چون دست نمی رسد، که پایت بوسم!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 1957 گفتی : ز دو یاقوت لب چون شکرم %~% یک بوسه به جانی است، مده دردسرم(@)(@@) (@@) گر جان یابم، یکی به صد وام کنم %~% و آیم، زتو بوسی به دو صد جان بخرم!(@)(@@)(@@)(@@) | عایشه(@)(@@) (@@) 1958 بر حرف نهاد دوش یار انگشتم %~% برجست و، کشید از سر مستی مشتم(@)(@@) (@@) دشنام همی خواست که آغاز کند %~% دشنام، به بوسه در دهانش کشتم!(@)(@@)(@@)(@@) | شهاب سرخسی(@)(@@) (@@) 1959 دیوانه شوم، چو با غمت پیوندم %~% لعل تو، ز گیسوی تو سازد بندم(@)(@@) (@@) چاه زنخ تورا، رسن زلف توبس %~% بگذار، که دلو بوسه در وی بندم!(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 1960 آنی، که غمت آتش دل تیز کند %~% لبهای تو، جان را طرب انگیز کند(@)(@@) ~~کافر باشد که با لب چون شکرت سامان گنه یابد، و پرهیز کند!(@)(@)PageV01P349(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0353.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 1961 ای قند به تنگ آمده از نوش لبت %~% دیرست که شد لبم، فراموش لبت(@)(@@) (@@) دستوری ده، تا لب من غصهآ دل %~% گوید به زبان حال، در گوش لبت!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1962 گر عکس رخت، در ظلمات افتادی %~% خورشید، در او در حرکات افتادی(@)(@@) (@@) اسکندر اگر بوسه زدی، بر لب تو %~% حالی، به لب آب حیات افتادی!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~1963 امروز، فراق روی یارم سخت است همچون دل یار، بند کارم سخت است(@)(@@) (@@) دوش، از می نوشین لبش بودم مست %~% امروز، بدین سبب خمارم سخت است!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1964 یک بوسه، به کوری بداندیش لبت %~% گر می بدهی، سهل بود پیش لبت!(@)(@@) (@@) ایام شریف است و، تومنعم زجمال %~% من عاشق دلشکسته، درو یش لبت!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1965 ای آب حیات گشته حیران زلبت %~% واله شده، والی بدخشان زلبت(@)(@@) (@@) در ملک جمال تو، چه نقصان آید %~% گر دلشدهای زنده کند جان، زلبت!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1966 جانم، ز همه جهان تو را می خواهد %~% وصلت، 
ms197	 به نیاز و به دعا میخواهد(@)(@@) (@@) سلطان دلم، دو اسبه آمد برتو %~% از لعل لبت، نعل بها می خواهد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~1967 دردم، به دو جزع ناوک انداز دهد درمان، ز دو لعل کیسه پرداز دهد(@)(@@) (@@) جانم ببرد چون ملک الموت، به چشم %~% و آنگاه چوعیسی، به دو لب باز دهد!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1968 ترکی، که همه مهر شناسد کین را %~% وز کفر همی باز نداند، دین را(@)(@@) (@@) وسه ندهد، دل ببرد، جان خواهد! %~% این چیست، چه گویند و، چه خواننداین را؟(@)(@@)(@@)(@@) | مهذب شروانی(@)(@@) (@@) 1965 رفتم که یکی دزدم از آن تنگ شکر %~% او خفته، نهفته کردم آهنگ شکر!(@)(@@) (@@) سادام گشاد و، گفت در پسته مرا %~% ننماید [هیچ] طوطیی رنگ شکر!(@)(@)PageV01P350(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0354.jpg)(@)(@)(@@) فلکی شروانی(@)(@@) ~~1197 ای رشک پری، لعل تو کانی ارزد نی، نی، زلبت - کز در دندان من(@)(@@) است- %~% باور بادت، ملک جهانی ارزد! %~% یک، بوسه مع الغرامه، جانی ارزد!(@)(@@) شرف شفروه(@)(@@) (@@) بوسی- زدهانی که نداری- بفرست 197 تن، در غم آن غمزهآ غماز دهم %~%(@)(@@) تا جان- که ندارم - به عوض باز دهم! %~% جان ودل ودین را، به تو دمسازدهم(@)(@@) یمین اصفهانی(@)(@@) ~~نی، نی، لب او به بوسه آزرده شود 197 برخیزم و، چون زلف در افتم به(@)(@@) برش %~% الغیره %~% هان! ای لب خاکسار، هم خاک درش! %~% چون موی خطش، بوسه زنم بر شکرش(@)(@@) (@@) 1973 جانا، دل مبن عجب توانی بردن %~% همواره به روز و شب، توانی بردن(@)(@@) ~~میل توبه جان است، ومرا جان به لب استجان از لب من، به لب توانی بردن!(@)(@@) ~~از بهر خدا را، به لبم برنه لب 1975 زان نیست دلم، که گرد ناکس گردد(@)(@@) %~% الغیره %~% تا جان به لب رسیده، واپس گردد! %~% وصل چوتویی گزید، تا کس گردد(@)(@@) کمال اسماعیل(@)(@@) (@@) 1975 سر، بر سر خاک آستان تونهم جانم به لب آمدهست، یک بوسه بیار %~%(@)(@@) اوله %~% دل، در خم زلف دلستان تونهم %~% تا جان، به بهانه در دهان تونهم!(@)(@@) ~~من نیز شوم، جان خود آرم بر لب 1976 در 
ms198	 خلوت وصل، ای چو شگر لب تو(@)(@@) %~% وله %~% گیرم که نهادهام، لب اندر لب توا %~% چون می نتوان نهاد لب، بر لب تو(@)(@@) (@@) 1977 آنجا، که هزار بینوایی باشد %~% ازار لب تورا، روایی باشد(@)(@@) (@@) دانم، که تو را بوسه بهایی نبود %~% گر هدیه دهی، بار خدایی باشد!(@)(@)PageV01P351(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0355.jpg)(@)(@)(@@)(@@)(@@) | غیره(@)(@@) (@@) 1978 آن بت، که به یک بوسه ندادی دستم %~% دوش، از در خانه [ام] در آمد مستم(@)(@@) (@@) کوشیدم و، زلفش به ستم بشکستم %~% تا یک دو [سه]بوسه بردهانش بستم!(@)(@@)(@@)(@@) | جمال عمر(@)(@@) ~~1979 زلفت، به خطا مشک ختن می بخشد لعلت، به عطا در به عدن می بخشد(@)(@@) (@@) هر گز شکری لبت نبخشید به من %~% با آنکه همه شکر به من می بخشد(@)(@@)(@@)(@@) | نجیب گنجه ای(@)(@@) ~~1980 ای مرده لب من به تمنای لبتتا چند خورم، غصهآ سودای لبت؟(@)(@@) (@@) عید است، لب چون شکرت پیش آور %~% تا بگشایم روزه، به خرمای لبت!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 1981 با ماهرخی، که زلف او چون شست است %~% سرو سهی از رشک قد او، یست است(@)(@@) (@@) گفتم که: یکی بوسه بده، گفت: به چشم! %~% گفتم: نه، به لب حواله کن، کومست است(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1982 ای دل، هوست در خم آن گیسو چیست؟ %~% چندین نظر بوالعجب از هر سو چیست؟(@)(@@) (@@) گر هیچ بدان سیب زنخدان برسی %~% معلومم کن، ترنج شفتالو چیست؟(@)(@@)(@@)(@@) | شمس(@)(@@) (@@) 1983 دهقان، چوقد تو سرو کی کاریدهست؟ %~% یا ابر، چو چشم من کجا باریدهست؟(@)(@@) (@@) گر در لب تو بوسه نگنجد، شاید %~% کان حقهآ لعل، پر ز مروارید است!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 1984 یک روز، دلم نگشت شاد از لب تو %~% تا بستدمی به بوسه، داد از لب تو(@)(@@) (@@) تو در داری در لب، ومن درو یشم %~% درو یشان را خدادهاد، از لب تو!(@)(@@)(@@)(@@) | وله(@)(@@) ~~1985 اومید دل ازیار، نمی یارم خواست می میرم و، زنهار نمی یارم خواست(@)(@@) (@@) بوسی است امیدم از لبش، گر بدهد %~% اوله %~% کم باشد و، بسیار نمی یارم خواست!(@)(@@) (@@) 1985 ای چشمهآ نوش را 
ms199	 در اندر لب تو %~% وی کرده هزارجان، سر اندر لب تو(@)(@@) ~~از بهر خدا، چرا روا می داری؟من تشنه و، آب کوثر اندر لب تو!(@)(@)PageV01P352(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0356.jpg)(@)(@)(@@) (@@) جاه زنخت، پر شده از آب حیات 1987 ای گشته به خون من مسکین تشنه %~%(@)(@@) اوله %~% یک قطره، نمی دهد به چندین تشنه! %~% مر وصل تورا، این دل غمگین تشنه(@)(@@)(@@)(@@) | جمال محمد(@)(@@) (@@) 1987 وه، وه! که به دیدار تو چونم تشنه %~% هرگه که ببینمت، فزونم تشنه(@)(@@) (@@) من تشنهآ آن دو لعل سیرابم و، هست %~% عالم همه زین قبل، به خونم تشنه!(@)(@@)(@@)(@@) | کمال خجندی(@)(@@) ~~1989 یک بوسه، بر آن عارض خندانت نویس ازتاب تودر تبم، زشفتالوی لب(@)(@@) %~% خطیم، بر آن سیب زنخدانت نویس! %~% یک دارو، بهر درد مندانت نویس(@)(@@)(@@)(@@) | سعد گنجهای(@)(@@) ~~مپسند - که در کوی کرم نیست روا 1990 ای گشته به لطفت، ابر بهمن تشنه(@)(@@) %~% در لعل توآب کوثر و، من تشنه! %~% هجرایت به خون من، چودشمن تشنه(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 1991 امروز، که بوسهآ تو جانی ارزد فردا که خطت در آید، آبت برود %~%(@)(@@) بفروش به چیزی، که جهانی ارزد %~% زان بوسهآ تو هزار، نانی ارزد!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 1992 دریافتم آخر، زقضا را به شبش %~% صد بوسه زدم، بر لب همچون رطبش(@)(@@) (@@) او خواست که دشنام دهد، حالی من %~% دشنام، به بوسه در شکستم به لبش!(@)(@@) ~~1993 گفتم که : لبم به بوسه ای مهمان است 1994 گفتم: نظری، که عمر من فاسد شد گفتم: بوسی به جان دهی؟ گفت: برو عقل آمد و، در پهلوی من زد(@)(@@) انگشت %~% ولها %~% ولها %~% لغیرها %~% یعنی که : خموش، بیع کن، ارزان(@)(@@) است! %~% گفتا که: بهای بوسهآ من جان است! %~% بازار لب من، اینچنین کاسند(@)(@@) شد! %~% گفتا: ز حسد جهان پر از حاسد شد(@)(@@) (@@) 1995 هرگز نرسد ازاو امانی به دلی %~% ترسد، که از او، فتد گمانی به دلی PageV01P353(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0357.jpg)(@)(@)(@@)(@@)(@@) | زکی مراغی(@)(@@) (@@) 1996 من کی گفتم پری نه ای، حورنه ای؟ %~% یا کی گفتم چشم مرا نور نه ای؟ 
ms200	(@)(@@) (@@) بوسی خواهم، بها زمن جان خواهی %~% با اینهمه، از معامله دورنهای!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 1997 در روی تو، از بیم نظر نتوان کرد %~% در لعل تو، آهنگ شکر نتوان کرد(@)(@@) (@@) نه آنکه لب لعل تو، نتوان بوسید %~% خود با لب تو، زیر و ز برنتوان کرد!(@)(@@)(@@)(@@) | رضی گنجه ای(@)(@@) (@@) 1998 تا بر رخ زیبای تو باشد نظرم %~% هر لحظه بود، آرزوت بیشترم(@)(@@) (@@) اندر لب تو آب حیاتی است، که من %~% چندان که ازوبیش خورم، تشنه ترم!(@)(@@)(@@)(@@) | رضیه گنجه ای(@)(@@) (@@) 1999 مه بر رخ تو گزیدنم، دل ندهد %~% وز تو صنما بریدنم، دل ندهد(@)(@@) (@@) تا از لب نوش تو، چشیدم شکری %~% از هیچ شکر، چشیدنم دل ندهد(@)(@@) حاجی شهاب گنجه ای(@)(@@) (@@) 2000 آن بت، که اگر طلب کند جان بدهم %~% دی گفت: چت آرزوست؟ تا آن بدهم(@)(@@) (@@) گفتم که: دو بوسه، از دو جا می خواهم %~% گفت: از بن گوش، از بن دندان بدهم!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 2001 بشنو، بفروش بر رهی شفتالو %~% چون کم شود، ار بیش نهی شفتالو(@)(@@) (@@) امروز به زربده، که باشد به ازانک %~% فردا به یکی سیب دهی، شفتالو!(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 2002 ای در دل هر کسی زعشقت هوسی %~% جز وصل توام مباد، فریاد رسی(@)(@@) (@@) گر جان شود آگه، که لبت می بوسم %~% آید به زیارت لبم، هر نفسی!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 2003 جانا، دل من نهان نهان باز فرست %~% خون آلود است، همچنان باز فرست!(@)(@@) (@@) در بازاری، که جان زمن لب زتوبود %~% چون بیع به سر نرفت، جان باز فرست!(@)(@@)(@@)(@@) | مجد الدین جاندار(@)(@@) (@@) 2000 با ما صنما، هیچ تلطف نکنی %~% در کوی مراد ما، توقف نکنی(@)(@@) ~~انصاف بده، چه باشد ار در عمری با ما، به یکی بوسه تکلف نکنی!(@)(@)PageV01P354(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0358.jpg)(@)(@)(@@) ~~2.05 با یاره حدیث بوسه ار در گیرد گفتی دو سه بار، با لبش در نگرفت(@)(@@) %~% وله %~% یک بار دگر بگو، مگر در گیرد %~% ای دل، سخنت عیش ز سر در گیرد(@)(@@)(@@)(@@) | جمال شروانی(@)(@@) (@@) 2003 ای کار شکر رفته زسامان، ز 