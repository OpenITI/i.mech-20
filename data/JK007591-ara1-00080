ms61	 يكن ما ألم بالجسم شكوى % % فتهنا لوافد الإقبال % % 4(@)(@@) % لا ولا كان زائرا من سقام % % إنما كان طائفا من خيال % % 5(@)(@@) % وعكة أقلعت وأنت صحيح % % ويصح النسيم بالإعتلال % % 6(@)(@@) % أو ما هذه السماء سرار البدر % % فيها على طريق الكمال % % 7(@)(@@) % نعمة الله لا يخص بها الخالق % % إلا من كان منه ببال % % 8(@)(@@) % ولباس من المثوبة والغفران % % ألبست ضافي الأذيال % % 9(@)(@@) % فهنيئا لك البقاء وإن كان % % هناء يخص فيه المعالي % % 10(@)(@@) % والتقى والندى ومعربة الخيل % % وبيض الظبى وسمر العوالي % % PageV01P248 11(@)(@@) % والخلال التي إذا ما تحلت % % صدرت منك عن كريم الخلال % % 12(@)(@@) % إن وقتك النفوس ما تتوقى % % فحقيق فدى الموالي الموالي % % 13(@)(@@) % أو تحصنت في شعار من التقوى % % فما زلت منه في سربال % % 14(@)(@@) % فشفى الله من أجل دواء يه % % صريح الدعاء والابتهال % % 15(@)(@@) % ملك أبدل المخافة بالأمن % % وأضحى يعد في الأبدال % % 16(@)(@@) % وهو تاج الملوك فالملك العاطل % % حال به على كل حال % % 17(@)(@@) % وإذا النيران غابا فنور الدين % % شمس فجرية الآصال % % 18(@)(@@) % قد أرت وجهك العلى ما يريها % % وهي مرآة صالح الأعمال % % 19(@)(@@) % وقضى الله أن نجمك في الأنجم % % سام وأن جدك عال % % 20(@)(@@) % كل يوم هذا المحيا محيى % % بالتهاني على يد الإقبال % % PageV01P249 البحر : بسيط تام 1(@)(@@) % يا أهل بابل أنتم أصل بلبالي % % ردوا فؤادي على جثماني البالي % % 2(@)(@@) % لا واعتناق هواكم بعد فرقتكم % % ما كان صرف النوى منكم على بالي % % 3(@)(@@) % وإنما اعترضت بيني وبينكم % % نوائب أرخصت من دمعي الغالي % % 4(@)(@@) % لولا مكان هواكم من محافظتي % % لما صرفت إليكم وجه آمالي % % 5(@)(@@) % سلوت عن غيركم لما علقت بكم % % وجدا ألا فاعجبوا للعاشق السالي % % 6(@)(@@) % يا صاح إن دموعي حرب زاجرها % % فامنح هواملها تركي وإهمالي % % 7(@)(@@) % وانظر إلى عبراتي بعد بعدهم % % إن أنت لم تر حالي عند ترحالي % % 8(@)(@@) % لو كنت شاهدنا والبين يجمعنا % % على وداع بنيران الهوى صال % % 9(@)(@@) % رأيت حبة قلبي كيف يسلبها % % خد لها ليس بالخالي من الخال % % 10(@)(@@) % وقد علاني فتور عند رؤيتها % % مقسم بين عينيها وأوصالها 
ms62	 % % PageV01P250 11(@)(@@) % أقول للصاحب الهادي ملامته % % ضلالة القلب في أكناف ذي ضال % % 12(@)(@@) % دعني أفض شؤوني في معالمها % % فالدمع دمعي والأطلال أطلالي % % 13(@)(@@) % أما كفى أسفا أني أصخت إلى % % نهي النهى وكفيت الشيب عذالي % % 14(@)(@@) % إذا التفت إلى ما فات من عمري % % سحبت فوق رسوم اللهو أذيالي % % 15(@)(@@) % سقى الحيا طرفي عيش نعمت به % % فلم يكن غير أسحار وآصال % % 16(@)(@@) % أولى لها إن دنت بالوصل ثانية % % فإن ذكرت النوى يوما فأولى لي % % PageV01P251 البحر : منسرح 1(@)(@@) % لو أن قاضي الهوى علي ولي % % ما جار في الحكم من علي ولي % % 2(@)(@@) % وكان ما في الدلال من قبل % % الحسن بما في الغرام من قبلي % % 3(@)(@@) % حسبي وحسب الجوى أغالبه % % فيا عذولي مالي وللعذل % % 4(@)(@@) % كيف يداوى الفؤاد من سقم % % تاريخه كان وقعة المقل % % 5(@)(@@) % لا تسقيني صريح لائمة % % فصحتي في سلافة القبل % % 6(@)(@@) % بي من بني الترك شادن غنج % % يصيد لحظ الغزال بالغزل % % 7(@)(@@) % أغيد يلقاك طرفه ثملا % % وليس فيه سماحة الثمل % % 8(@)(@@) % مبتسم والعيون باكية % % وفارغ والقلوب في شغل % % 9(@)(@@) % لاحظني كالقضيب معتدلا % % وصد والصبر غير معتدل % % 10(@)(@@) % وأصبحت في الورى محبته % % كأنها دولة من الدول % % PageV01P252 11(@)(@@) % ملاحة دانت القلوب بها % % طوعا كما دانت العلى لعلي % % PageV01P253 البحر : طويل 1(@)(@@) % كأن الذي آلى على بسط كفه % % سوى مالها في البأس من قائم النصل % % 2(@)(@@) % يروح عقيد الراح لا يستفزه % % إلى الكأس إلا أنها ضرة البخل % % 3(@)(@@) % يملك ألباب القلوب بروعة % % تحالف من بعدي على حرب من قبلي % % 4(@)(@@) % وليست كأخرى تربها يكفر الحيا % % كأن وقوع الغيث منها على رمل % % 5(@)(@@) % أبا الحسن انقادت إلى بابك المنى % % وحلت به الآمال محلولة العقل % % 6(@)(@@) % بقيت . . . الدولة المرتجى لها % % إلى أن ترى من نسله أبوي شبل % % 7(@)(@@) % هلال تجلى في الكمال على الصبا % % ورب صبا يأوي إلى سودد كهل % % 8(@)(@@) % وغرس علمنا أصله من فروعه % % وما العلم إلا رد فرع إلى الأصل % % PageV01P254 البحر : منسرح 1(@)(@@) % بسيفك المنتضى من الكحل % % ووردك المجتنى من الخجل % % 2(@)(@@) % وكأسك المشتهى مقبلها 
ms63	 % % أنت لأجلي خلقت أم أجلي % % 3(@)(@@) % أهوى لذكراك كل عاذلة % % حسبك محبا محبة العذل % % 4(@)(@@) % لولاك لم أستلذ لائمة % % فليت من لامني علي ولي % % 5(@)(@@) % كي لا يكون الملام منه على % % معتدل القد غير معتدل % % 6(@)(@@) % مبتهج والنفس ذاهلة % % وآمن والقلوب في وجل % % 7(@)(@@) % ولو بان جسمي لخصره لشكا % % ذاك إلى ذا ظلامة الكفل % % PageV01P255 البحر : خفيف تام 1(@)(@@) % كل دعوى شجاعة لم تؤيد % % بكلام الكلام دعوى محال % % 2(@)(@@) % لا يرعك الصقال في السيف حتى % % ينطق الفل شاهدا للصقال % % 3(@)(@@) % لو تكون السهام تحسن قصدا % % عرجت عن مقاصد الآمال % % 4(@)(@@) % غادر البأس في جبينك منه % % أثرا لاح في جبين الهلال % % 5(@)(@@) % لا يجلى دجى الحوادث إلا % % غرر الحرب في وجوه الرجال % % 6(@)(@@) % في مقاديمها تصاب المقاديم % % وترمى الأكفال في الأكفال % % PageV01P256 البحر : طويل 1(@)(@@) % دعوا للمحيا ما استباحته من عقلي % % فإني رأيت الحظ من حيز الجهل % % 2(@)(@@) % وما زالت الأيام يجري نظامها % % على العكس حتى أدرك الجد بالهزل % % 3(@)(@@) % وهل في فؤادي فضلة تسع الهوى % % وما العشق إلا شغل قلب بلا شغل % % 4(@)(@@) % إذا أنت لم يصحبك إلا مهذب % % فخلك من أمس وحيدا بلا خل % % 5(@)(@@) % فدع لذوي الأموال ما اغتبطوا به % % وصن ثمرات الفضل بخلا على الفضل % % 6(@)(@@) % فإن الفتى من غادرته خلاله % % فريدا وإن أضحى من الناس في حفل % % PageV01P257 البحر : وافر تام 1(@)(@@) % ونجل تدرك الأبصار منه % % سنا قمر بتاج المجد حال % % 2(@)(@@) % حبته سنة الإسلام طهرا % % تكفل غيره الماء الزلال % % 3(@)(@@) % فيا لك من دم يجري سرورا % % وكلم نقصه سمة الكمال % % 4(@)(@@) % وذي ألم يلذ به وجرح % % يكون قصاصه جدل الرجال % % 5(@)(@@) % وأي جناية ترضى المساعي % % بها ويثاب جانيها بمال % % PageV01P258 البحر : خفيف تام 1(@)(@@) % من رآني قبلت عين رسولي % % ظن أن الرسول جاء بسولي % % 2(@)(@@) % إنما حين قال أبصرت مأمولك % % أجللت من رأي مأمولي % % 3(@)(@@) % إن عينا تأملت ذاك الوحه % % أحق العيون بالتقبيل % % PageV01P259 البحر : رجز تام 1(@)(@@) % بين فتور المقلتين والكحل % % هوى له من كل قلب مل انتحل % % 2 
ms64	(@)(@@) % توق في فتكتها لواحظا % % أما ترى تلك الظبى كيف تسل % % 3(@)(@@) % يا ويحها نواظرا سواحرا % % ما عقل العقل بها إلا اختبل % % 4(@)(@@) % لو لم تكن بابل في أجفانها % % لما برت أسهمها من المقل % % 5(@)(@@) % يا راميا مسمومة نصاله % % عيناك للقارة قل لي أم ثغل % % 6(@)(@@) % وعاذل خوفني من لحظها % % إليك عني سبق السيف العذل % % 7(@)(@@) % ذاك على سفك دمي محبب % % أنا القتيل مغرم بمن قتل % % 8(@)(@@) % لاحظت منه وجنتين ما جرى % % ماء الصبى بجمرها إلا اشتعل % % 9(@)(@@) % آه على ظمآنها ضمانة % % لو كفل الخصر لوجدي بالكفل % % 10(@)(@@) % يا صاح حلل من أناشيط الأسى % % إذا حللت بين هاتيك الحلل % % PageV01P260 11(@)(@@) % سل عن رقادي بالغضى كيف مضى % % وعن فؤادي بعدها ماذا فعل % % 12(@)(@@) % وإن رأت عيناك ربعا خاليا % % فاسق حيا طلهما ذاك الطلل % % 13(@)(@@) % وعد عن محاجر بحاجر % % نظرتها أقرب عهد بأجل % % 14(@)(@@) % واجتن أثمار الهوى فباللوى % % غصن نقا يحمل تفاح الخجل % % 15(@)(@@) % وإن يغب عنك اهتزاز قده % % فسل به اترابه من الأسل % % 16(@)(@@) % كل حلال عنده محرم % % فليت شعري عن دمي كيف استحل % % 17(@)(@@) % إياك أن تحمل قلبي ظلما % % فما لخصمي بقبيلي من قبل % % 18(@)(@@) % ترى ولي الثأر إن أراده % % فهل مجير من مجير الدين هل % % PageV01P261 البحر : بسيط تام 1(@)(@@) % الحق مبتهج والسيف مبتسم % % ومال أعدا مجير الدين مبتسم % % 2(@)(@@) % قدت الجياد وحصنت البلاد % % وأمنت العباد فأنت الحل والحرام % % 3(@)(@@) % وجئت بالخيل من أقصى مرابطها % % معاقد الحزم في أوساطها الحزم % % 4(@)(@@) % حتى إذا ما أحاط المشركون بنا % % كالليل يلتهم الدنيا له ظلم % % 5(@)(@@) % وأقبلوا لا من الإقبال في عدد % % يؤود حاسبه الإعياء والسأم % % 6(@)(@@) % أجريت بحرا من الماذي معتكرا % % أمواجه بأواسي البأي تلتطم % % 7(@)(@@) % وسست جندك والرحمن يكلؤه % % سياسة ما يعفى إثرها ندم % % 8(@)(@@) % وقفت في الجيش والأعلام خافقة % % كل قناة فوقها علم % % 9(@)(@@) % يحوطك الله صونا في عيونهم % % والله يعصم من بالله يعتصم % % 10(@)(@@) % حتى إذا بدت الأراء ضاحكة % % وأقبلت اوجه الإقبال تبتسم % % PageV01P262 11(@)(@@) % أتبعت جن سراياهم مضمرة % % فيها نجوم 
ms65	 إذا جد الوغى رجموا % % 12(@)(@@) % والنصر دان وخيل الله مقبلة % % ترجو الشهادة في الهيجا وتغتنم % % 13(@)(@@) % صاب الغمام عليهم والسهام معا % % فما دروا أيما الهطالة الديم % % 14(@)(@@) % سرو لينتهبوا الأعمار فانتهبوا % % قتلا ويغتنموا الأمول فاغتنموا % % 15(@)(@@) % وأقبلت خيلنا ترى بخيلهم % % مجنوبة وعلى أرماحنا القمم % % 16(@)(@@) % وأدبر الملك الطاغي يزعزعه % % حر الأسنة وهو البارد الشبم % % 17(@)(@@) % وافوا دمشق فظنوا انها جدة % % ففارقوها وفي أيديهم العدم % % 18(@)(@@) % وأيقنوا مع ضياء الصبح أنهم % % إن لم يزولوا سراعا زالت الخيم % % 19(@)(@@) % فغادروا أكثر القربان وانجلفوا % % وخلفوا أكثر الصلبان وانهزموا % % 20(@)(@@) % وحاولوا المسجد الأدني فما عبرت % % عن مسجد القدم الأقصى لهم قدم % % PageV01P263 21(@)(@@) % مستسلمين لأيدي المسلمين وقد % % أغرى القنا بتمادي خطفهم نهم % % 22(@)(@@) % لا يملك الجسم دفعا عن مقاتله % % كأن حين يغشاه الردى صنم % % PageV01P264 البحر : طويل 1(@)(@@) % تباشرت الأقطار من فرح به % % ففي كل ثغر من ظباه مباسم % % 2(@)(@@) % وما تحمل الخيل الاعادي جهالة % % به بل رجاء أنهن غنائم % % PageV01P265 البحر : كامل تام 1(@)(@@) % أبدى السلو خديعة للائم % % وحنى الضلوع على فؤاد هائم % % 2(@)(@@) % ورأى الرقيب يحل ترجمة الهوى % % فاستقبل الواشي بثغر باسم % % 3(@)(@@) % ومضى يناضل دونه كتمانه % % ما الحب إلا للمحب الكاتم % % 4(@)(@@) % من فاض ختم لسانه عن سره % % ختمت أنامله ثنية نادم % % 5(@)(@@) % ومهفهف لعب الصبا بقوامه % % لعب النعامى بالقضيب الناعم % % 6(@)(@@) % حرم الوصايا وأرهفت أجفانه % % فأتاك ينظر صارما من صارم % % 7(@)(@@) % ولكم جرى طرفي يعاتب طرفه % % لو يسمع الساجي حديث الساجم % % 8(@)(@@) % إني لأرحم ناظريه من الضنا % % لو أن مرحوما يرق لراحم % % 9(@)(@@) % لله موقفنا وقد ضرب الدجى % % سترا علينا من جفون النائم % % 10(@)(@@) % وفمي يقبل خاتما في كفه % % قبلا تغالط عن فم كالخاتم % % PageV01P266 11(@)(@@) % كيف السبيل إلى مراشف ثغره % % عين الرقيب قذاة عين الحائم % % 12(@)(@@) % نلحى الوشاة وإن بين جفوننا % % لمدامعا تسعى لها بنمائم % % 13(@)(@@) % يا أيها المغرى بأخبار الهوى % % لا تخدعن عن الخبير العلم % % 14(@)(@@) % اسأل فديتك بالصبابة لمتي % % واسأل بنور الدين صدر الصارم % % 15(@)(@@) % ومعطفات ترتمي بأجنحة % % ومثقفات تهتدي بلهاذم 
ms66	 % % 16(@)(@@) % ومسومات لست تدري في الوغى بقوائم يدركن أم بقوادم % % 17(@)(@@) % كل ابن سابقة إذا ابتدر المدى % % فلغير غرته يمين اللاطم % % 18(@)(@@) % يرمي بفارسه أمام طريده % % حتى يرى االمهزوم خلف الهازم % % 19(@)(@@) % ينمى إلى الملك إذا قسم الندى % % والبأس كان المكتنى بالقاسم % % 20(@)(@@) % متسربل بالحزم ساعة تلتقي % % حلق البطان على جواد الحازم % % PageV01P267 21(@)(@@) % ما بين منقطع الرقاب وسيفه % % إلا اتصال يمينه بالقائم % % 22(@)(@@) % سام الشآم ويالها من صفقة % % لولاه ما أعيت على يد سائم % % 23(@)(@@) % ولشمرت عنها الثغور وأصبحت % % فيها العواصم وهي غير عواصم % % 24(@)(@@) % تلك التي جمحت على من راضها % % ودعوت فانقادت بغير شكائم % % 25(@)(@@) % وإذا سعادتك احتبت في دولة % % قام الزمان لها مقام الخادم % % 26(@)(@@) % يا ابن الملوك وحسب أنصار الهدى % % ما عند رأيك من ظبا وعزائم % % 27(@)(@@) % قوم إذا انتضت السيوف أكفهم % % قلت الصواعق في متون غمائم % % 28(@)(@@) % من كل منصور البيان بعجة % % وهل الأسود الغلب غير الأعاجم % % 29(@)(@@) % أو مفصح يقري الصوارم في الوغى % % أسخى هناك بنفسه من حاتم % % 30(@)(@@) % حصن بلادك هيبة لا رهبة % % فالدرع من عدد الشجاع الحازم % % PageV01P268 31(@)(@@) % وارم الاعادجي بالعوادي وإنها % % كفلت بفل قديمها والقادم % % 32(@)(@@) % أهلا بما حملت إليك جيادهم % % ما في ظهور الخيل غير غائم % % 33(@)(@@) % واسأل فوارس حاكموك إلى القنا % % في الحرب كيف رأوا لسان الحاكم % % 34(@)(@@) % تلك العوامل أي فعال العدى % % ما سكنت حركتها بجوازم % % 35(@)(@@) % هيهات يطمع في محلك طامع % % طال البناء على يمين الهادم % % 36(@)(@@) % كلفت همتك العلو فحلقت % % فكأنما هي دعوة في ظالم % % 37(@)(@@) % قطنت بأوطان النجوم فكم لها % % من مارد قذفت إليه براجم % % 38(@)(@@) % أنشأت في حلب غمامة رأفة % % أمددت ديمتها بنوء دائم % % 39(@)(@@) % ألحقت أهل الفقر فيها بالغنى % % أمن المؤمل ثروة للعادم % % 40(@)(@@) % وأظن أن الناس لما لم يروا % % عدلا كعدلك أرجفوا بالقائم % % PageV01P269 41(@)(@@) % فتهن أوصاف العلى منظومة % % فالدر أنفسه بكف الناظم % % 42(@)(@@) % جاءتك في حلل النباهة حاسرا % % تختال بين فضائل ومكارم % % 43(@)(@@) % عربية أنسابها لو أنها % % لحقت أمية لانتمت في دارم % % 44 
ms67	(@)(@@) % وتمل غرة كل فطر بعده % % متسربلا أسنى ثواب الصائم % % 45(@)(@@) % لا زال وجهك في عقود سعوده % % بدر التمام مقلدا بتمائم % % PageV01P270 البحر : رمل تام 1(@)(@@) % أنتم كالشمس لولا خدرها % % ما شكى عاشقها ليل التمام % % 2(@)(@@) % من لدات الحور إلا أنها % % ألفت نار الحشى دار مقام % % 3(@)(@@) % وأما لو أصبحت موجدتي % % جدتي كنت بكم أغنى الأنام % % 4(@)(@@) % أو لو أن الحب فضل كان لي % % ما لشمس الدين من فضل الكرام % % 5(@)(@@) % نير تقدمه آثاره % % كبوادي الفجر تحدو بالظلام % % 6(@)(@@) % طالع المغرب من مشرقه % % طلعة الشمس على أهل الشآم % % 7(@)(@@) % عاقد الجود غماما هاطلا % % أوليس الشمس حربا للغمام % % 8(@)(@@) % حاكم يلجأ من همته % % ومن العلم إلى ركني شمام % % 9(@)(@@) % لو قضى بين نداه والحيا % % لا نقضى بينهما طول الخصام % % 10(@)(@@) % ومتى أنشأ فضلا ناثرا % % نال حبات قلوب في نظام % % PageV01P271 11(@)(@@) % كم ثنى جائر سمع بهدى % % وهدى حائر دمع بانسجام % % 12(@)(@@) % بين تاج لاح في وقد السنا % % وكمال راح في عقد التمام % % 13(@)(@@) % فوقوا الليل بنجم ثاقب % % وشهاب يتسرى عن ضرام % % 14(@)(@@) % حين فاتوا فأتوا شأو العلى % % غرر الفضل وفرسان الكلام % % 15(@)(@@) % فهمه ما بين ماض صارم % % في خطوب الدهر أو قاض إمام % % 16(@)(@@) % أو جواد للمعالي سابق % % أو عتاد للملمات همام % % 17(@)(@@) % رفعوا للملك أعلام السنا % % ونفوا عن حوزتيه كل ذام % % 18(@)(@@) % ورأت آراؤهم يوم الوغى % % فوق ما دق عن الطعن التؤام % % 19(@)(@@) % وإذا ما أظلمت سبل الهدى % % ضرجوا عنها غيابات الجهام % % 20(@)(@@) % يا بني القاسم هل من قرب % % فلقد طال على البعد أوامي % % PageV01P272 21(@)(@@) % ما انتجعت الغيث حتى شاقني % % برقكم ما كل برق مستهام % % 22(@)(@@) % إنما أنتم أواذي ندى % % يمتريها عارض بالفضل هام % % 23(@)(@@) % شغلوا كل فؤاد بهوى % % وأمالوا كل قلب عن ملام % % 24(@)(@@) % وأباتوا كل قلب شارد % % من هواهم في عقال وزمام % % 25(@)(@@) % رفعوا فوق العوالي أنجما % % طالعات دون أقمار الخيام % % 26(@)(@@) % حجبت كل فتاة أختها % % أقواما منعوه بقوام % % 27(@)(@@) % ما عليهم لو أباحوا في الهوى % % ما عليهم من صفات المستهام 
ms68	 % % 28(@)(@@) % من خصور وشحوها بالضنى % % وعيون كحلوها بالسقام % % 29(@)(@@) % يا أحبائي متى تشفي الجوى % % نظرة بين وداع وسلام % % PageV01P273 البحر : متقارب تام 1(@)(@@) % هبوا أن حاجبه حاجب % % بدا في شعار بني هاشم % % 2(@)(@@) % فمن أين صار إلى ثغره % % بياض أتى من أبي غانم % % 3(@)(@@) % مواهب تحسر عن شأوها % % مذاكي سنا البارق الساجم % % 4(@)(@@) % تراقت سموا إلى واجد % % وصابت حنوا على عادم % % 5(@)(@@) % كفيض البحار يمد الغمام % % وينقع من غلة الحائم % % 6(@)(@@) % إذا لاح في زمن عابس % % أراك ثنايا الثنا الباسم % % 7(@)(@@) % محامد من دون إعراضه % % قطعن الطريق على الشاتم % % 8(@)(@@) % وقالوا السماحة طائية % % وكم في خزيمة من حاتم % % 9(@)(@@) % يرد قراه على الطارقين % % رأد الضحى في الدجى العاتم % % 10(@)(@@) % إذا أسلمتك الذرى فاستجر % % بني أسد عصمة العاصم % % PageV01P274 11(@)(@@) % أعز منالا على أعجم % % وأصلب عودا على عاجم % % 12(@)(@@) % لهم من حديث العلى في القديم % % ما ليس للطارف القادم % % 13(@)(@@) % تنوب المغارم أموالهم % % فتنشط عقلا على الغارم % % 14(@)(@@) % نجوم العلى غربت في العلى % % وأوصت إلى سعدها الناجم % % PageV01P275 البحر : طويل 1(@)(@@) % ولما نزلنا بالزواجر هاجني % % خيالان منها معرق وشآمي % % 2(@)(@@) % فبت وهذا آخذ بشكيمتي % % إليه وهذا جاذب بزمامي % % 3(@)(@@) % تجاذبني الأهواء شرقا ومغربا % % فقلبي ورائي تارة وأمامي % % 4(@)(@@) % وتسألني الحسناء عن طول غيبتي % % فقلت لها عام لديك بعام % % 5(@)(@@) % تباعد عن ذات السوارين روحتي % % فلم يبق من لمياء غير لمام % % 6(@)(@@) % فها أنا إن بغداد هاجت صبابتي % % بعثت إلى دار السلام سلامي % % PageV01P276 البحر : طويل 1(@)(@@) % إذا أبرزتهن العيون حواسرا % % نظرن إلينا من خلال المعاصم % % 2(@)(@@) % حلول بمستن العفاة عفاتهم % % غنيون عن نار القرى بالمباسم % % 3(@)(@@) % وقد بان عن لبنان برق كأنه % % بياض الأيادي أوسنا وجه حاتم % % 4(@)(@@) % تعود فوود الحمد عنه كأنهم % % قد افترقوا عن جامعات المواسم % % PageV01P277 البحر : خفيف تام 1(@)(@@) % واحيائي وقد مررت بعم % % من مسيحية دعتني بعمي % % 2(@)(@@) % أين عصر الشباب أيام أدعوها % % صبيا بجدتي وبأمي % % PageV01P278 البحر : كامل تام 1(@)(@@) % لمن القوام السمهري سنانه % % ما أرهفت من لحظها أجفانه % % 2(@)(@@) % إن كان 
ms69	 نازعك الهوى إنكاره % % فمن الذي بعث الجوى عرفانه % % 3(@)(@@) % ظبي صوارم مقلتيه أسنة % % فبناظريه ضرابه وطعانه % % 4(@)(@@) % لهج بكأس جفونه فقوامه % % أبدا نزيف رحيقها سكرانه % % 5(@)(@@) % كفلت سلافة خده عن صدغه % % ألا يفارق وردها ريحانه % % 6(@)(@@) % وبنفسي الرشأ المترجم طرفه % % عن بابل هاروتها إنسانه % % 7(@)(@@) % لا وصل إلا ما تجود به النوى % % من طيفه فوصاله هجرانه % % 8(@)(@@) % حكمته فقضى علي قضاؤه % % وهوى الأحبة جائر سلطانه % % 9(@)(@@) % أدمى جفون الصب صب دموعه % % سعة وضاق بسره كتمانه % % 10(@)(@@) % ضمن الفريق فراق أغصان اللوى % % أفبينه ضمن الجوى أم بانه % % PageV01P279 11(@)(@@) % يا فضل ما للفضل هيض جناحه % % فبدت زمانته وضاع زمانه % % 12(@)(@@) % قعد السماح به وكم من ناهض % % ضاقت لبانته فضاق لبانه % % 13(@)(@@) % ومخلف ما كان يبلغ شأوه % % لو لم يكن بيد القضاء عنانه % % 14(@)(@@) % ومروع سكنت خوافق أمنه % % لولا جمال الدين عز أمانه % % 15(@)(@@) % من نال قاصية المطالب جوده % % والغيث ما عم الربى هطلانه % % 16(@)(@@) % واستوعبت غرر الكلام فنونه % % واستوسقت ثمر العلى أفنانه % % 17(@)(@@) % أذكى الأنام إشارة وعبارة % % ما المرء إلا قلبه ولسانه % % 18(@)(@@) % ففروعه تنبيك عن أعراقه % % وكفاك من خير النسيب عيانه % % 19(@)(@@) % وإذا أردت محله من فارس % % فترق حيث سما به إيوانه % % 20(@)(@@) % شرف تفيأت الملوك ظلاله % % وعلى على هماتها بنيانه % % PageV01P280 21(@)(@@) % ما أغمدوا سيف ابن ذي يزن به % % إلا تقاصر عندها غمدانه % % 22(@)(@@) % جد تمكن في ذؤابة منصب % % لو نالها العيوق جن جنانه % % 23(@)(@@) % فليبت مال الملك من عزماته % % طماح طرف كفاية يقظانه % % 24(@)(@@) % يغدو عليه ثقيلة أكمامه % % ويروح عنه خفيفة أردانه % % 25(@)(@@) % لا تخدع الأهواء ثاقب رأيه % % والرأي مملوك عليه مكانه % % 26(@)(@@) % مستظهر بولاته فكفاتهم % % نوابه وثقاتهم أعوانه % % 27(@)(@@) % يعدوهم تأنيبه ويخصهم % % تهذيبه ويعمهم إحسانه % % 28(@)(@@) % وإذا انتضوا أقلامه لملمة % % أبصرت من كتابه فرسانه % % 29(@)(@@) % ميثاقه حرم لخائف بأسه % % يغنيك عن أيمانه إيمانه % % 30(@)(@@) % وقف الحساب عليه ركض إجابة % % لا البرق يدركها ولا سريانه % % PageV01P281 البحر : - 1(@)(@@) % بما بعطفيك من تيه ومن صلف % % من دل ذلك يا هذا على تلفي 
ms70	 % % 2(@)(@@) % ناشدتك الله في نفس غدت فرقا % % بين الجوى والأسى والبث والأسف % % 3(@)(@@) % ومهجة رفع التكليف خالقها % % عنها لشدة ما تلقى من الكلف % % 4(@)(@@) % أستشعر اليأس في لا ثم تطمعني % % إشارة في اعتناق اللام والألف % % 5(@)(@@) % إن أنت رويت من ألفاظه أذنا % % علمت كيف مقر الدر في الصدف % % 6(@)(@@) % وإن نظرت إلى القرطاس في يده % % رأيت كيف نبات الروض في الصحف % % 7(@)(@@) % وثنى الخطاب إليه فضل فصاحة % % لا قسها منه ولا سحبانه % % 8(@)(@@) % هذا وإن تكن اتصالات العلى % % تقضي بسعد فالقران قرانه % % 9(@)(@@) % أمحمد بن علي اعتنق الأسى % % فكري فضاق بفارس ميدانه % % 10(@)(@@) % ما بال حادي المجد مغبر المدى % % وأخو الهوينا روضة أعطانه % % PageV01P282 11(@)(@@) % هبني جنيت على نداك جناية % % تقضى فأن حنوه وحنانه % % 12(@)(@@) % وأنا الذي لا عيب فيه لقائل % % ما لم يقل هذا الزمان زمانه % % PageV01P283 البحر : بسيط تام 1(@)(@@) % والله لو أنصف الفتيان أنفسهم % % أعطوك ما ادخروا منه وما صانوا % % 2(@)(@@) % ما أنت حين تغني في مجالسهم % % إلا نسيم الصبا والقوم أغصان % % PageV01P284 البحر : بسيط تام 1(@)(@@) % خذوا حديث غرامي عن ضنا بدني % % أغنى لسان الهوى عن دمعي اللسن % % 2(@)(@@) % إذا استقل محل السر محتملا % % عن الضمير فهل يبقى سوى العلن % % 3(@)(@@) % وخبروني عن قلبي ومالكه % % فربما أشكل المعنى على الفطن % % 4(@)(@@) % من ذا الذي ترهب الأبطال صولته % % زيد الفوارس أم سيف بن ذي يزن % % 5(@)(@@) % وما جفون إذا سلت صوارمها % % تجاذبت مهج الأقران من قرن % % 6(@)(@@) % هذا الذي سلب العشاق نومهم % % أما ترى عينه ملأى من الوسن % % 7(@)(@@) % تفرق الحسن إلا في محاسنه % % ويلاه من فتن جمعن في فنن % % 8(@)(@@) % إذا الصبابة عاطتني مدامتها % % فما فؤادي على سر بمؤتمن % % 9(@)(@@) % أمسى غرامي بذاك القد يوهمني % % أن اعتلال الصبا شوق إلى الغصن % % 10(@)(@@) % أعيا اللوائم سمعي غير لائمة % % للشيب مالت إلى عيني عن أذني % % PageV01P285 11(@)(@@) % حتى إذا ما تناهى العذل عن كلفي % % قامت إلي بنات الدهر تعذلني % % 12(@)(@@) % فما ثنت ناظري عن منظر حسن % % حتى أرتني مكاني من أبي الحسن 
ms71	 % % 13(@)(@@) % وكيف يخشى جناني مس حادثة % % وقد جعلت صفي الدين من جنني % % 14(@)(@@) % فتى يجاوز بالآمال غاياتها % % حتى ترى في المنى ما ليس في المنن % % 15(@)(@@) % المشتري الحمد غضا من معادنه % % يغضي على الغبن فيه لا على الغبن % % 16(@)(@@) % يعتد بذل عطاياه لطالبها % % من الفروض عليه لا من السنن % % 17(@)(@@) % حتى كأن خطوط الكف من يده % % كتاب وقف على الإحسان والمنن % % 18(@)(@@) % يولي وينسى الذي أولاه محتقرا % % كأن ما كان من نعماء لم يكن % % 19(@)(@@) % أرى الوفود رباع الجود عامرة % % من بعد ما وقفوا منها على دمن % % 20(@)(@@) % إذا احتبى الحلم في حضن رياسته % % رأيت عقد الحبى منه على حضن % % PageV01P286 21(@)(@@) % معترك الوفد هذا قد قضى عللا % % من راحتيه وذا في ساحة العطن % % 22(@)(@@) % تمده من بني العجلان مأثرة % % بمثلها فخرت قيس على اليمن % % 23(@)(@@) % قوم إذا ناظروا عن سرح جارهم % % تكلمت ألسن الخطية اللدن % % 24(@)(@@) % تجول أسيافهم في قلب من وتروا % % مجالها موهنا في أعين البدن % % 25(@)(@@) % إذا تهادوا بها في البرك آونة % % شفوا نحول الظبي من ذلك السمن % % 26(@)(@@) % إذ لا ترد ذراها عن قوائمها % % ولا تحامي عن اللبات باللبن % % 27(@)(@@) % ترى القوائم تبدي في أكفهم % % مباسم الجود بين السيف والسفن % % 28(@)(@@) % كأنهم عندما جاد الزمان بهم % % تخيروك له جودا على الزمن % % 29(@)(@@) % فلا تعفت سبيل من مكارم % % أصبحت من نهجها إلا على سنن % % 30(@)(@@) % يا ناصح الدولة الإحسان مرتهن % % على الثناء وهذا ما على الرهن % % PageV01P287 31(@)(@@) % والعيد عندي كيوم عاد ذاهبه % % وإنما فعله من فعلك الحسن % % 32(@)(@@) % فاحرز به حبرات الحمد مطرحا % % ما يصنع القوم في صنعاء أو عدن % % 33(@)(@@) % من اللواتي إذا غالى الكرام بها % % في موطن لم يراعوا مبلغ الثمن % % 34(@)(@@) % غراء إذ حللت من معشر أجنا % % فربما عاقدت قوما على الأجن % % 35(@)(@@) % كأنها بعد إعلان الضمير بها % % لا تستخير سوى الأسماع من وطن % % 36(@)(@@) % ترى البصائر في صافي بلاغتها % % ما في سواها من الأقذاء والدرن % % 37(@)(@@) % والشعر مرآة عقل يستدل بها % % على موازنة الألباب 
ms72	 والفطن % % 38(@)(@@) % فلا تغرك أشباح معطلة % % فإنما الشعر مثل الروح في البدن % % PageV01P288 البحر : منسرح 1(@)(@@) % يا هل سمعتم بدير سمعان % % وما به للعيون من عان % % 2(@)(@@) % أموقف للصلاة هيكله % % أم منبت من منابت البان % % 3(@)(@@) % في كل غصن تفاحتا خجل % % تلقاك من مثل ببستان % % 4(@)(@@) % من ذات بشر يلوح في بشر % % وذات جان يعلو على جان % % 5(@)(@@) % يرمي فيصمي عن غير ناطقة % % ما كل قوس ترى بمرنان % % 6(@)(@@) % في ليلة لم تزل بها حرقي % % تلفح نيرانهم بنيران % % 7(@)(@@) % كأن بهرام من توقده % % بات زعيما بحرب كيوان % % 8(@)(@@) % نار ونور كأن إنسهما % % في الليل ما آنس ابن عمران % % 9(@)(@@) % حتى انجلى الصبح في كنائسها % % عن كل نشوانة ونشوان % % 10(@)(@@) % تسجد للشمس وهي معرضة % % في الأفق عنه بوجه غيران % % PageV01P289 11(@)(@@) % وانصرفوا والفؤاد أفئدة % % مع كل نصرانة ونصران % % 12(@)(@@) % يا حسن عيد الصليب لو أن كان % % الدهر فيهم أعياد صلبان % % PageV01P290 البحر : خفيف تام 1(@)(@@) % يا غزال الثغور بالقسيان % % أنت من غال ذكره نسياني % % 2(@)(@@) % أسأل السانحات عنك نهارا % % فإذا الليل جن جن جناني % % 3(@)(@@) % كيف يصغي إلى السلو جماحي % % بعدما أطلق الغرام عناني % % 4(@)(@@) % حبذا يوم باكرتنا الزنانير % % ترينا القضبان في الكثبان % % 5(@)(@@) % وعلى موقف الأساقف ظبي % % يفرس الأسد من بني الفرسان % % 6(@)(@@) % غصن نابت من المرمر المنضود % % في غير منبت الأغصان % % 7(@)(@@) % الذبح النفوس سموه بالمذبح % % أم للصلاة والقربان % % 8(@)(@@) % أخرته القسوس عن رتبة الصدر % % وحطته في صدور الأماني % % 9(@)(@@) % ذاك وقت سخا علي به الدهر % % فيا هل لذلك اليوم ثان % % 10(@)(@@) % فأرى من أراني الشمس شماسا % % على الأرض تالي الألحان % % PageV01P291 البحر : متقارب تام 1(@)(@@) % أما عند هذا القوم الرديني % % سجية عطف تقاضاه ديني % % 2(@)(@@) % وأحسب ما طال هذا المطال % % إلا ليلحق حينا بحين % % 3(@)(@@) % ومن عجب أنني أشتكي % % قساوة غصن من البان لين % % 4(@)(@@) % رماني بسهمين من ناظرين % % عن متن قوسين من حاجبين % % 5(@)(@@) % وإن أنكرت مقلتاه دمي % % فسائل به حمرة الوجنتين % % 6(@)(@@) % ولم لا تناكرني عينه % % وقد علمت كيف إقرار 
ms73	 عيني % % 7(@)(@@) % ومالي خصم سوى ناظري % % فهل حاكم بين عيني وبيني % % 8(@)(@@) % أصبت عدى فملأت القلوب % % وصبت يدا فملأت اليدين % % 9(@)(@@) % كأنك لست ترى راحة % % سوى حثو مالك بالراحتين % % 10(@)(@@) % فداؤك باك على ماله % % بكاء اليتيم على الوالدين % % PageV01P292 البحر : رمل تام 1(@)(@@) % كلما غض هواكم من جفوني % % سكن اللوم اغترارا لسكوني % % 2(@)(@@) % ووراء الصدر مني لوعة % % شانها ركض دموعي في شؤوني % % 3(@)(@@) % يا لدمع حار في أجفانه % % أن يسمى يوفي أو خؤون % % 4(@)(@@) % فلئن دل على وجدي بكم % % فلقد حامى عن السر المصون % % 5(@)(@@) % فتأمل عجبا من ناظر % % خائن يخبر عن قلب أمين % % 6(@)(@@) % في سبيل الحب مني مهجة % % قتلت بين خدود وعيون % % 7(@)(@@) % يئست أن تفتدى أفئدة % % أسرت بين فتور وفتون % % 8(@)(@@) % وقلوب ملكتهن المها % % فاتكات بالنهى ملك اليمين % % 9(@)(@@) % جبرة ما زال قتلي دينها % % واعتصامي بمجير الدين ديني % % PageV01P293 البحر : مجزوء الرمل 1(@)(@@) % قل لمن أطلع شمس % % الكأس من أفق اليمين % % 2(@)(@@) % احبس الكأس فقد % % عفت سلاف الزرجون % % 3(@)(@@) % واسقني من خمر ألحاظك % % كأسا من فتون % % 4(@)(@@) % أنا لا أشربها إللا % % بكاسات الجفون % % 5(@)(@@) % لا تلمني أين سكر الخمر % % من سكر العيون % % PageV01P294 البحر : خفيف تام 1(@)(@@) % عج بنا أيها الدليل فقد جرت % % بصحبي عن قصد ذات اليمين % % 2(@)(@@) % يبتغي وادي المياه من الأرض % % ووادي المياه بين جفوني % % 3(@)(@@) % يا خليلي أحين بانت دموعي % % عن شؤوني سألتني عن شؤوني % % 4(@)(@@) % لا تسلني يا ملحيا أين قلبي % % ضل قلبي الحزين بين الحزون % % PageV01P295 البحر : مجزوء الكامل 1(@)(@@) % وحمائم ناحت على فنن % % فبعثن لي حزنا إلى حزن % % 2(@)(@@) % ناحت ونحت وفي البكا فرج % % فظللت أسعدها وتسعدني % % 3(@)(@@) % شتى الهوى والشوق يجمعنا % % كل بكى منا على شجن % % PageV01P296 البحر : مجزوء الكامل 1(@)(@@) % ما زلت أخدع عن دمشق % % صبابتي بالغوطتين % % 2(@)(@@) % حتى مررت بتادف % % فكأنني بالنيرين % % 3(@)(@@) % ورأيت ما قد كنت % % آمله بأشواقي بعيني % % PageV01P297 البحر : خفيف تام 1(@)(@@) % وحبيب طوى وصالي لما % % نشر الشيب خلتي بعد صون % % 2(@)(@@) % ظن صبغ الشباب صبغ الليالي % % فاصطفاها علي أكبر 
ms74	 عون % % 3(@)(@@) % حال حين استحال لون شبابي % % باعني في الهوى بفاضل لون % % PageV01P298 البحر : سريع 1(@)(@@) % أقمت بالأنبار ذا لوعة % % مقسومة بين حبيبين % % 2(@)(@@) % أشتاق أهلي بدمشق وفي % % بغداد حظ القلب والعين % % 3(@)(@@) % ففي لقائي ذا فراقي لذا % % قل لي متى أخلو من البين % % PageV01P299 البحر : خفيف تام 1(@)(@@) % أعرب الفضل من بديع الزمان % % عن معان عزت على يونان % % 2(@)(@@) % ما تلاها لما تلاها ولكن % % فاتها حائزا خصال الرهان % % PageV01P300 البحر : مجزوء الكامل 1(@)(@@) % ما هذه الحدث الفواتن % % إلا سهام في كنائن % % 2(@)(@@) % ترمي فلا تخطي المقاتل % % إنه من حان حائن % % 3(@)(@@) % وأغن غنى محسنا % % فعجبت من شاد وشادن % % 4(@)(@@) % ما غردت حركاته % % إلا تراقصت السواكن % % 5(@)(@@) % ينأى ويدنو طيفه % % فهو المواصل والمباين % % 6(@)(@@) % ما أغفل الأجسام من % % أخذ القلوب بها رهائن % % 7(@)(@@) % يا مودعا قلبي هواه % % توق دمعي فهو خائن % % 8(@)(@@) % لا ملة لك في الملال % % فأي دين أنت دائن % % 9(@)(@@) % أتحل قلبا ظاعنا % % يا ساكنا في غير ساكن % % 10(@)(@@) % أترى لمن وليته % % حرب العواذل أن يهادن % % PageV01P301 11(@)(@@) % إن خاف قلبي في هواك % % فأمر جاه الحب واهن % % 12(@)(@@) % وإن استجار فإن جارك % % يا ضياء الدين آمن % % 13(@)(@@) % رب الفواضل والفضائل % % والمحامد والمحاسن % % 14(@)(@@) % والعارفات تعود من % % جدوى يديك إلى مواطن % % 15(@)(@@) % والبارقات من الخلائق % % تمتري السحب الهواتن % % 16(@)(@@) % والمجد مخزون العلا % % والمال ليس عليه خازن % % 17(@)(@@) % وعوامل الأقلام لا % % تنفك مشرعة تطاعن % % 18(@)(@@) % تعلو البنان طليعة % % خلف الصدور لها مكامن % % 19(@)(@@) % لبست سرابيل الوغى % % أو ما تراها في الجواشن % % 20(@)(@@) % أأبا سعيد والسعيد % % من استقل إليك ظاعن % % PageV01P302 21(@)(@@) % وضحت له سبل الهدى % % وجرت له الطير الميامن % % 22(@)(@@) % ويداك تقذف بالنضار % % كأنها بعض المعادن % % 23(@)(@@) % وعلي حسن الظن فيك % % وقد يكون الظن كاهن % % 24(@)(@@) % أملا ضمنت له النجاح % % وآمل الكرماء ضامن % % 25(@)(@@) % أنا من إذا صغت القريض % % فمن يوازي أو يوازن % % 26(@)(@@) % وإذا جرت أمثاله % % بالحمد فيك فمن يراهن % % PageV01P303 البحر : سريع 1(@)(@@) % قلت تقول الله لا خائفا % % مع حكم القرآن حكم القران % % 2 
ms75	(@)(@@) % لا راقب النجم ولا سائلا % % ما فعل السعدان والنيران % % 3(@)(@@) % بل غرت للإسلام حتى لقد % % دان له من بالطواغيت دان % % 4(@)(@@) % رعت نواميس نواقيسها % % بحلبة الآذان وقت الأذان % % 5(@)(@@) % تمحو تصاوير الدمى عن يد % % تبني المحاريب خلال المحان % % 6(@)(@@) % هذا وكم أنشأت من منبر % % فارسه فارس سحر البيان % % 7(@)(@@) % من مال بالإخلاص ما ملته % % كان من الله مكين المكان % % 8(@)(@@) % يا شائما بالشام صوب الحيا % % ودانيا من كل قاص ودان % % 9(@)(@@) % هذي سجوف الملك مرفوعة % % عن ملك أخباره كالعيان % % 10(@)(@@) % أوضح سبل العدل مفتنة % % فللبرايا بالدعاء افتتان % % PageV01P304 11(@)(@@) % ألغى حقوقا كلها باطل % % إلى ضمان حط مال الضمان % % 12(@)(@@) % عطفا ورفقا بالرعايا وإن % % أصبح تأديب ملوك الزمان % % 13(@)(@@) % كم بين من نام على نشوة % % وساهد في صهوة من حصان % % 14(@)(@@) % في كل يوم ينثني سيفه % % ببلدة بكر وأخرى عوان % % PageV01P305 البحر : بسيط تام 1(@)(@@) % له من الرشأ الوسنان عيناه % % ولي من الوجد أقصاه وأدناه % % 2(@)(@@) % ما ضن ناظره عني بنظرته % % إلا وأسقم الطرف أشقاء % % 3(@)(@@) % بنفسي القمر المحجوب طلعته % % عني وإن كان يهواني وأهواه % % 4(@)(@@) % إذا عزمت على السلوان خادعني % % بثغره فثنت عزمي ثناياه % % 5(@)(@@) % يلومني الناس في وجدي بمبسمه % % ظلما ولو عاينوا فاه لما فاهوا % % 6(@)(@@) % قد كنت أعهده يهوى مواصلتي % % يا ليت شعري من بالهجر أغراه % % 7(@)(@@) % ولى هواه على قلبي فعذبه % % وحكم السقم في جسمي فأضناه % % 8(@)(@@) % وليلة بات ندماني مقبله % % أسقى المدامة والكاسات أفواه % % 9(@)(@@) % وأجتني الورد من أفنان وجنته % % إذ لا يفارق ذاك الورد مجناه % % 10(@)(@@) % عادت لعيني أحلام الكرى وسرى % % طيف الخيال فحيا الله مسراه % % PageV01P306 11(@)(@@) % يا صاح إن كنت صاحي القلب من كلف % % فسل نسيم الصبا من أين مغداه % % 12(@)(@@) % يا حبذا وافد الأشواق مبتكرا % % يحي سلامك يا سلمى محياه % % 13(@)(@@) % ما هب يحكي الخزامى طيب نفحته % % إلا نسبت إلى رياك رياه % % 14(@)(@@) % ولا رفعت إلى بدر الدجى نظري % % إلا ذكرتك والأقمار أشباه % % 15(@)(@@) % كيف السلو وما بالشام من سكن % % يغنيك عن سكن بغداد مغناه 
ms76	 % % PageV01P307 البحر : مجزوء الرمل 1(@)(@@) % لا تناظر جاهلا % % أسندك الدهر إليه % % 2(@)(@@) % إنما تهدي له % % علما يعاديك عليه % % PageV01P308 البحر : مجزوء الوافر 1(@)(@@) % إذا ما زرت ماريا % % فما سعدى وماريا % % 2(@)(@@) % فتاة كقضيب البان % % يثنيها الصبا طيا % % 3(@)(@@) % تلوى كالمواعيد % % أطالت عمرها ليا % % 4(@)(@@) % لها وجه مسيحي % % ترى الميت به حيا % % 5(@)(@@) % إذا ما قابلته الشمس % % لم تبصر له فيا % % 6(@)(@@) % فيا أحسن من أعرض % % إدلالا ومن حيا % % 7(@)(@@) % أتنسين وحياك % % فتى قلت له هيا % % 8(@)(@@) % فلو نظهر وسم الحب % % أبصرت له كيا % % 9(@)(@@) % هوى إلا يكن رشدا % % فما أحسنه غيا % % PageV01P309 البحر : متقارب تام 1(@)(@@) % إذا ما خدمت كبار الملوك % % فأول ما تخدم الحاشيه % % 2(@)(@@) % فكن جاري الماء يسقي الرياض % % فأول ما تشرب الساقيه % % PageV01P310 
ms77	