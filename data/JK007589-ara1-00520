ms501	 منهم إذاخاف دهره % معوله ضم الكتاب إلى الصدر % % 3(@)(@@) % أذكرك الوعد الذي كان بيننا % % وما مر من يوم عليه ومن شهر % % 4(@)(@@) % وقطرة غيث كنت أنبأت أنها % % سيتبعها قطر ملث على قطر % % 5(@)(@@) % تقبلها منك امرؤ متوقع % لها أخوات من أناملك العشر % % 6(@)(@@) % ولا غروأنت البحر تفضى عفاته % % إلى الضحل من جدواه ثم إلى الغمر % % 7(@)(@@) % أو الغيث يأتي قطره قبل سيله % % أو الشمس يهدي ضوءها وضح الفجر % % 8(@)(@@) % فدتك نفوس الناس من ذي حياطة % غدوت لهم أما ممهدة الحجر % % 9(@)(@@) % تظل من الأمر المخوف وغيره % تضم بنيها باليدين إلى النحر % % 10(@)(@@) % فإشفاقها من أن يموتوا من الغنى % % كإشفاقها من أن يموتوا من الفقر % % PageV01P1990 11(@)(@@) % لذلك تحمي الناس أول وهلة % نداك سوى الشيء الموائم والنزر % % 12(@)(@@) % تدرجهم هونا على درجاته % % وترفعهم بالقدر منه إلى القدر % % 13(@)(@@) % ولو وردت كبرى عطاياك بغتة % على مستنيل أسلمته إلى القبر % % 14(@)(@@) % إذا لتقضى قلبه من شغافه % % سرورا بما حازت يداه من الوفر % % 15(@)(@@) % ومن فرحات النفس ما فيه حتفها % % ومن أنسها بالخير ما هو كالنفر % % 16(@)(@@) % أبا حسن حتى متى أنا حابس % عليك رجائي أنسخ العصر بالعصر % 17(@)(@@) % وقد وجبت لي بالمودة حرمة % ومن بعدها ثنتان بالمدح والصبر % % 18(@)(@@) % وعدت فبادر بالوفاء فقد ترى % % مبادرة الأيام بالغدر والختر % % 19(@)(@@) % أتأمن أن يرمى مرج مطلته % % دوين الذي رجى بداهية هتر % % 20(@)(@@) % فتقدح فيما بين ضعفيك حسرة % كحسرته ليست بخامدة الجمر % % PageV01P1991 21(@)(@@) % وما أمن مأمول على نفس آمل % حوادث دهر غير مأمونة المكر % % 22(@)(@@) % ترامى بنا شأو المطال إلى مدى % بعيد ولسنا من حديد ولا صخر % % 23(@)(@@) % وإني لأرجو من سمائك مطرة % أهز لها عطفي في ورق نضر % % 24(@)(@@) % نتيجة وعد صادق منك شاهدي % % عليه كتاب يحفز السطر بالسطر % % 25(@)(@@) % ولن يخلف الوعد امرؤ سار قوله % أرى الوعد مثل العهد والخلف كالغدر % % 26(@)(@@) % ولو وعدت عنك المنى متمنيا % وفيت له عنها وفاءك بالنذر % % 27(@)(@@) % تطول بمال نالني منك جذره % فإنك قد جربت شكري على الجذر % % 28 
ms502	(@)(@@) % جدا منك أو من ماجد تستميحه % % لراجيك رحب الباع ذي همة بحر % % 29(@)(@@) % وما المائة الصفراء منك ببدعة % ولا من أخيك الأريحي أبي الصقر % % 30(@)(@@) % ولا هي أقصى ما أرجيه منكما % % وكيف وأدناه الجسيم من الأمر % % PageV01P1992 31(@)(@@) % ورأيك في رد الكتاب فإنه % % إذا انأد ظهري نعم مستند الظهر % % 32(@)(@@) % وليس بمنفك قريني أو يرى % % قرين كتابي في يميني لدى الحشر % % 33(@)(@@) % ولم لا ولم أقرأه إلا تكشفت % غواشي همومي وانتشيت بلا خمر % % 34(@)(@@) % وزادت به عيناي في كل روضة % أنيقة وشي النور طيبة النشر % % PageV01P1993 البحر : - 1(@)(@@) % أصبحت الدنيا تروق من نظر % بمنظر فيه جلاء للبصر % % 2(@)(@@) % واها لها مصطنعا لمن شكر % % أثنت على الله بآلاء المطر % % 3(@)(@@) % فالأرض في روض كأفواف الحبر % % نيرة النوار زهراء الزهر % % 4(@)(@@) % تبرجت بعد حياء وخفر % % تبرج الأنثى تصدت للذكر % % PageV01P1994 البحر : - 1(@)(@@) % الحب داء عياء لا دواء له % % تضل فيه الأطباء النحارير % 2(@)(@@) % قد كنت أحسب أن العاشقين غلوا % % في وصفه فإذا في القوم تقصير % % 3(@)(@@) % سقيا لأيام لم أخبره تجربة % إلا بما وصفت عنه الأخابير % % PageV01P1995 البحر : - 1(@)(@@) % ياابن حرب كسوتني طيلسانا % حمله لاسمه كثير كثير % % 2(@)(@@) % يتجلى تنسم الريح من غا % % ية تسعين فرسخا فيطير % % 3(@)(@@) % إن من يمسك السماء على الأر % % ض وباقي حوبائه لقدير % % PageV01P1996 البحر : - 1(@)(@@) % العين لا تنفك من نظر % والقلب لا ينفك من وطر % 2(@)(@@) % ومحاسن الأشياء فيك معا % فملا لتيك ملالتي بصري % % 3(@)(@@) % متعات وجهك في بديهتها % % جدد وفي أعقابها الأخر % % 4(@)(@@) % فكأن وجهك من تجدده % % متنقل للعين في صور % % PageV01P1997 البحر : - 1(@)(@@) % ياأيها السيد الذي غمرت % قدما أياديه شكر من شكره % % 2(@)(@@) % قد كنت أوليتني يدا عظمت % عندي وكانت لديك محتقره % % 3(@)(@@) % أربعة جدت لي بها سلفا % إذ عقني من ثقاتي البرره % 4(@)(@@) % وكم يد قبلها جبرت بها % % عظمي وكان الزمان قد كسره % % 5(@)(@@) % فإن تقاصص فغير ذي شطط % وعبد مولى أحق منعذره % % 6(@)(@@) % وإن تؤخر قصاص ذي عوز % يشكرك والشكر خير ما ثمره % % 7(@)(@@) % وحقك الشكر كيف كنت 
ms503	 وما اخ % % ترت ففيه الصلاح والخيره % % 8(@)(@@) % وكبر ظني أن ليس مثلك من % % أخدج معروفه ولا بتره % % 9(@)(@@) % يفديك من ذاك كل منتكث % يعقب من صفو فعله كدره % % 10(@)(@@) % رزقي لشهرين قد علمت به % % أربعة نيفت على عشره % PageV01P1998 11(@)(@@) % ونيف العقد كالسنام له % % إن جب أبقى بظهره دبره % % 12(@)(@@) % لن يقضى العقد بعد نيفه % حاجة ذي حاجة ولا وطره % % 13(@)(@@) % وكيف حمل العقير راكبه % % لاكيف أو قطعه به سفره % % 14(@)(@@) % فاترك لرزقي سنامه يقه % فأنت أولى موفر وفره % % 15(@)(@@) % يامؤثر الناس بالثراء ومن % % له عليهم بالسؤدد الأثره % % 16(@)(@@) % لاأوحش المجد يابني عمر % منكم فأنتم أجل من عمره % % PageV01P1999 البحر : - 1(@)(@@) % لو كنت مجبول السما % % ح لكنت كالشيء المسخر % 2(@)(@@) % أو كنت تبتاع الثناء % لكان جودك جود متجر % 3(@)(@@) % لكن رأيت الجود أح % % سن ما رآه الناس منظر % % 4(@)(@@) % لا يستعير حليه % من غيره بل فيه يظهر % % 5(@)(@@) % ففعلته لا للثنا % % ء ولا لطبع فيك مجبر % % 6(@)(@@) % لكن لأن محاسن ال % % إحسان في الإحسان جوهر % % 7(@)(@@) % والعرف معروف لذا % % ت طباعه والنكر منكر % % 8(@)(@@) % تعطي وتمنع مامنع % % ت وأنت مقتدر مخير % % PageV01P2000 البحر : - 1(@)(@@) % إني سألت ابن أبي طاهر % لم تنبح البدر إذا ما بهر % 2(@)(@@) % فقال لي أحسده حسنه % وأنه عال يفوق البشر % % 3(@)(@@) % قلت فإن الشمس قد أوتيت % هذا وما تنبح غير القمر % % 4(@)(@@) % فقال يعشي بصري ضوؤها % % وليس ضوء البدر يعشي البصر % % PageV01P2001 البحر : - 1(@)(@@) % ليس على الضارط تعيير % ولا على الضاحك تغيير % 2(@)(@@) % كلاهما أجراه مقداره % كرها وهل تعصى المقادير % % 3(@)(@@) % كم ضرطة تتبعها ضحكة % وما على الثنتين تنكير % 4(@)(@@) % كلاهما إن قيستا فلتة % حانت ولله تدابير % % PageV01P2002 البحر : - 1(@)(@@) % لعمري لقد أنكرت غير نكير % عبوس الغواني لابتسام قتير % 2(@)(@@) % كذا هن لا يوقعن ودا على امرىء % أطارت غرابا عنه كف مطير % 3(@)(@@) % وللشيب جهر والشبيبة طرة % وليس جهير في الصبا كطرير % 4(@)(@@) % عزاؤك عن ظبي طرير فإنه % % بعينيك إذ شيبت غير غرير % % 5(@)(@@) % رأيت حياة المرء بعد مشيبه % % إذا زاول 
ms504	 الدنيا حياة أسير % % 6(@)(@@) % خليلي هل من نهية الشيب عائض % لمعتاضها من حبرة وحبير % % 7(@)(@@) % وبنت نعيم في ضبابة عنبر % تفور وطورا في عجاج عبير % % 8(@)(@@) % برهرهة لم تغز إلا بناعم % ولم تسق من ماء بغير نمير % % 9(@)(@@) % مضمخة اللبات تحسب نحرها % % من المسك والجادي نحر نحير % % 10(@)(@@) % محجبة تحتل عليا خورنق % تشارف أنهارا خلال سدير % % PageV01P2003 11(@)(@@) % سقتني بعينيها وفيها ودلها % % خمورا لها ليست خمور عصير % % 12(@)(@@) % من الظبيات العاطيات لمجتني % % ثمار قلوب لا لحب بذير % % 13(@)(@@) % تغير على الجلد اللبيب فتستبي % % حجاه ولم تحمل سلاح مغير % 14(@)(@@) % بدر نثير من حديث تحفه % بآخر في سمطين غير نثير % 15(@)(@@) % تبسم عنه في الدجى فكأنما % % يضيء الدجى منه بروق صبير % 16(@)(@@) % أفيما يفيد الشيب من واعظ النهى % % وفاء بهذا في حكومة زير % % 17(@)(@@) % أبى ذاك إلا كل شهم مشمر % % لها من مجاز واعتنى بمصير % % 18(@)(@@) % طوى مدة من دهره ذات زخرف % إلى أبد ذي سندس وحرير % % 19(@)(@@) % بمنزلة لا لغو فيها سوى الذي % % بها من غناء مطرب وزمير % % 20(@)(@@) % أرانين طير لا تزال ملية % بكر هديل تارة وصفير % % PageV01P2004 21(@)(@@) % ألا تلكم الدار التي حل أهلها % % بناء عن الخطب المخوف شطير % % 22(@)(@@) % خفيرهم فيها من الشر كله % % خفير إليه أمر كل خفير % % 23(@)(@@) % لهم ما اشتهوا فيها مسوقا إليهم % مقودا إذا شاؤوا بغير جرير % % 24(@)(@@) % وليست بها شمس فكل زمانهم % % غدو وإصال بغير هجير % % 25(@)(@@) % بلى كل شمس فوق خوط مهفهف % على دعص رمل يزدهيك وثير % % 26(@)(@@) % وعيش بلا موت وكل ملذة % يفوز بها الملتذ غير مضير % % 27(@)(@@) % أناخ بهم في الأمن خوف أراهم % كأنهم يمشون فوق شفير % % 28(@)(@@) % نهتهم به أحلامهم أن يثابروا % % على عمل للعاملين مبير % % 29(@)(@@) % وإن ابن إبراهيم حقا لمنهم % وإن كان للسلطان أي ظهير % % 30(@)(@@) % فتى يتقى في السلم حشو دواته % % كما يتقى في الحرب حشو جفير % % PageV01P2005 31(@)(@@) % يرى الحائنون الموت يصرف نابه % % إذا بعث الأقلام ذات صرير % % 32(@)(@@) % إذا ما أثار الحق بعد آدفانه % % بتحصيله الشافي 
ms505	 فأي مثير % % 33(@)(@@) % له حلم لقمان الحكيم فإن طغا % % سفيه فخلف الحلم صولة شير % 34(@)(@@) % وما ظن راج ما لديه بكاذب % ولا مخ راع في ذراه برير % % 35(@)(@@) % بكير العطايا للعفاة وإنما % % حميد نبات الأرض كل بكير % % 36(@)(@@) % ينيل بلا وعد إذا النيل لم يكن % % بغير وعيد قبله وهرير % % 37(@)(@@) % فتى لا ينسيه الفعال اتكاله % % على تاج ملك سالف وسرير % % 38(@)(@@) % ولكنه يبني على إرث من مضى % % جهيرا من البنيان فوق جهير % % 39(@)(@@) % أبا الحسنين العلم والجود لاتزل % بنعماء ما قامت هضاب ثبير % % 40(@)(@@) % كناك بها لا بالحسين مسلم % % إليك رقاب الود غير معير % % PageV01P2006 41(@)(@@) % معظم قدر منك جد معظم % % مكبر شأن منك جد كبير % % 42(@)(@@) % أبت لك أن تكنى بحسن مصغر % محاسن ما مقدارها بصغير % % 43(@)(@@) % وقد علم الأقوام أنك مكمل % لك الحسن في مرأى وغيب ضمير % % 44(@)(@@) % وما الحسن إلا شيمة مستقلة % بتبصير ذي جهل وجبر كسير % % 45(@)(@@) % وأنت الذي لا ينكر الناس أنه % % هدى لأخي جور غنى لفقير % % 46(@)(@@) % تعظم من شكر الصديق حقيره % % وتحقر من جدواك غير حقير % % 47(@)(@@) % لك الدهر معروف شهير وإنما % % تحب من المعروف كل ستير % % 48(@)(@@) % وما أعجب المعروف تستر فعله % % ولست تراه الدهر غير شهير % % 49(@)(@@) % إذا زارك العافون كان إيابهم % % إياب بشير لا إياب نذير % 50(@)(@@) % ولو قعد العافون عنك لزارهم % % نوالك من تلقاء خير مزير % PageV01P2007 51(@)(@@) % كأن الذي يغشى جنابك نازل % على روضة مولية وغدير % % 52(@)(@@) % نداك لهم رهن مدى الدهر كله % % بأخضر ربعي النبات نضير % % 53(@)(@@) % فهنأك الله الفضيلة منحة % % ولا زلت في خير يزيد وخير % 54(@)(@@) % وهنأك الله الذي أنت أهله % برغم العدى من رأي خير أمير % % 55(@)(@@) % أمير رأى فيك الذي ليس مشكلا % ووافقه في ذاك خير وزير % % 56(@)(@@) % لعمري لقد جلى بعين جلية % من القوم نظار فقيد نظير % % 57(@)(@@) % تأمل أين الفهم والحزم والتقى % % لباغي سفير فوق كل سفير % % 58(@)(@@) % فأبصرها فيك الموفق كلها % % فولاك ما ولاك غير نكير % % 59(@)(@@) % ولما عزمت الظعن كي تفصل 
ms506	 التي % % عصت كل طب بالأمور خبير % % 60(@)(@@) % رحلت على اسم الله أيمن رحلة % وسرت على اسم الله خير مسير % % PageV01P2008 61(@)(@@) % على ثقة من ناصر الدين أنه % % سينصر منك الحق خير نصير % % 62(@)(@@) % فألفاك ميمون النقيبه كالذي % % عرفت به في أول وأخير % % 63(@)(@@) % ظللت له بالغيب عينا يديرها % % فأيتما عين وأي مدير % % 64(@)(@@) % ولما توسطت الأمور كفيتها % % وأقبلت محمودا بوجه بشير % % 65(@)(@@) % ولولاك لم تعدم دماء ممارة % سدى من قتيل طائح وعقير % % 66(@)(@@) % إذا ولعاق العاملين عن الحيا % % عوائق بالسلطان ذات ضرير % % 67(@)(@@) % ولكن نهيت السيف عن سطواته % % بيمنك فارتد ارتداد حسير % % 68(@)(@@) % وبدلت خبط العالمين هداية % وقد يهتدي أعمى بنور بصير % % 69(@)(@@) % وما كان إصلاح الأمور التي التوت % فداويتها من دائها بيسير % 70(@)(@@) % ولكن من والى الإله ميسر % % له بأقل السعي كل عسير % % PageV01P2009 71(@)(@@) % ولم تمتهن لكنك المرء لم يزل % % معدا لعير تارة ونفير % % 72(@)(@@) % فتنفر في النفار أي محافظ % % وتقعد طورا أي حافظ عير % % 73(@)(@@) % تغيب فلا تنفك شغل مذاكر % وتبدو فلا تنفك نصب مشير % % 74(@)(@@) % يهش لذكراك العدو وإنه % % ليضمر في الأحشاء نار سعير % % 75(@)(@@) % وقد سئل الحساد عنك بأسرهم % % فقالوا وما حابوا بوزن نقير % % 76(@)(@@) % مهذب أخلاق مشرف همة % مثقف آراء ممر مرير % % 77(@)(@@) % فأعجب بفضل بان حتى استبانه % % من الناس قوم في غباء حمير % % 78(@)(@@) % وأعجب بفضل بان حتى عنت له % % سباع من الأعداء ذات زئير % % 79(@)(@@) % وحتى غدا يثني به كل كاشح % % بقول ويتلو قوله بزفير % % 80(@)(@@) % أطال علي الدهر قوم بظلمهم % % وكم لك من يوم علي قصير % % PageV01P2010 81(@)(@@) % فلو كان لي حق تريد قضاءه % لأ لفيت قد جاوزته بكثير % % 82(@)(@@) % ولكن ما تسديه فضل منحته % % وأنت بترك الفضل غير جدير % % 83(@)(@@) % إذا كنت شمسا نورها من طباعها % % فكيف بأن نلقاك غير منير % % 84(@)(@@) % وكنت سحابا ضاق بالماء وسعه % فكيف بأن نلقاك غير مطير % % 85(@)(@@) % أبى الله إلا أن تضيء لحائر % وتندى لمستسق إباء قدير % % 86(@)(@@) % شكرت ولم أسأل مزيدا فزدتني % % دريرا من المعروف بعد 
ms507	 درير % % 87(@)(@@) % نفحت بسيل بعد قطر وللحيا % % سيول بعقب القطر ذات خرير % % 88(@)(@@) % مطرت وقد أيبست حتى بللتني % % فعودي لين المتن غير هصير % 89(@)(@@) % عليه ثمار الشكر بين شكيره % % فيا حسنه حملا خلال شكير % % 90(@)(@@) % وقالوا أطل في مدحه قلت حسبكم % % رشائيفليس المستقى بقعير % % PageV01P2011 91(@)(@@) % ألا ربما قصرت في مدح ماجد % وفزت بسجل من نداه غزير % % 92(@)(@@) % وما بي غنى عما لديك ولو غدت % مفاتيح ما ملكت عبء بعير % % 93(@)(@@) % فعش في جوار الله خير مجاور % يجير بك الأحرار خير مجير % % 94(@)(@@) % يد الله من ريب الزمان وقاية % على خطر للمجد فيك خطير % % 95(@)(@@) % فما لك عيب غير أنك لم تدع % أخا كرم جاراك غير بهير % % 96(@)(@@) % وأنك من أصبحت يوما عشيره % من الناس طرا ذم كل عشير % % 97(@)(@@) % منحتكها غراء يقطع وخدها % % نهار أخي لهو وليل سمير % % 98(@)(@@) % وإن لم أقرظ منك إلا مقرظا % وإن لم أشد إلا بذكر ذكير % % PageV01P2012 البحر : - 1(@)(@@) % يا من زكا جهره وإسراره % وصح إبداؤه وإضماره % 2(@)(@@) % أراك عاقبتني لأني لم % % أسألك شيئا يجل مقداره % 3(@)(@@) % وملت نحو الذي يميل أخو ال % % جهل إلى مثله ويختاره % 4(@)(@@) % وهو البخور الذي محصلنا % % من ملكه قترة وإعصاره % 5(@)(@@) % ذاك الذي أشبهت روائحه % % روائح الروض فاح نواره % 6(@)(@@) % ولا ترى عاقلا يعامله % إلا إذا زال عنه إعساره % 7(@)(@@) % لكنه الند وهو مقترح % يجل عن أن يذم مختاره % % 8(@)(@@) % لا سيما ندك الذي منعت % جودته أن يسب عطاره % % 9(@)(@@) % سمي ندا لأنه أبدا % تبعد في الخافقين آثاره % % 10(@)(@@) % تند أرواحه فتطرأ من % % أقصى قصي البلاد أخباره % % PageV01P2013 11(@)(@@) % كأنما ذكرك الذي حلف ال % % معروف أن لا تنام سماره % % 12(@)(@@) % ينفذ أقطار كل منخرق % تحمي الرياح النفوذ أقطاره % % 13(@)(@@) % يبعث نشرا له تطيب به % % أنجاد إقليمه وأغواره % % 14(@)(@@) % إذا امتطى الريح سار منشمرا % سيان مدحيكم وسياره % % 15(@)(@@) % حقرت لي منه غير محتقر % فراث عني لذاك إحضاره % % 16(@)(@@) % وكنت لا تعذر المخفف في الت % % تخفيف حتى يبين إعذاره % % 17(@)(@@) % وحاجة السائل المثقل 
ms508	 في % % نفسك كالشهد حين تشتاره % % 18(@)(@@) % وإنني تائب إليك من الت % % خفيف توبا تصح أسراره % % 19(@)(@@) % ما بيننا بعدها مطالبة % إلا بما لا يعاب ممتاره % % 20(@)(@@) % كالحاجة الفخمة الجليلة من % % جاه ومال يميل معياره % % PageV01P2014 21(@)(@@) % وأنت أهل لذاك يا سندي % % ومن مطافي وقبلتي داره % % 22(@)(@@) % يا من له السؤدد التمام إذا % % كان لكل الأنام معشاره % % 23(@)(@@) % لن يحسن الاحتشام من ملك % % درهمه للندى وديناره % % 24(@)(@@) % فحواه بشراه حين تسأله % وحلمه إن عثرت إنذاره % % 25(@)(@@) % أنذر في البخل معشر منع % وفي السماح الغريب إنذاره % % 26(@)(@@) % يقر بالوعد حين يعقده % وإن أتى العرف طال إنكاره % 27(@)(@@) % يا لك من منكر ومعترف % يكرم إنكاره وإقراره % % 28(@)(@@) % حررنا طوله وعبدنا % % فنحن عبدانه وأحراره % % 29(@)(@@) % يا من إذا المال حل عقوته % % حسن إقباله وإدباره % % 30(@)(@@) % يورد من حله على كرم % % ثم إلى العارفات إصداره % % PageV01P2015 31(@)(@@) % يا من يجير الملاوذين به % % فالله من كل آفة جاره % % 32(@)(@@) % قصر من يسأل الحقائر أم % % ثالك جدا وآن إقصاره % % 33(@)(@@) % فاعذر وإن كنت قد سألتك ما % % يصغر فيما تنيل قنطاره % % 34(@)(@@) % وعجل الند وليكن عبق الن % نفحة يذكو وإن خبت ناره % % 35(@)(@@) % فما قليل قليل ذي كرم % يطيب إقلاله وإكثاره % % 36(@)(@@) % ومن زراء الكثير قطعكه % % ومن بهاء القليل إدراره % % 37(@)(@@) % شجا أن أروم الصبر عنك فيلتوي % % عليولؤم أن يساعدني الصبر % % 38(@)(@@) % فيا حزني أن لا سلو يطيعني % % ويا سوءتا من سلوتي إنها غدر % % PageV01P2016 البحر : - 1(@)(@@) % صادت فؤادي عشية النفر % % ظبية قصر نأت عن القفر % 2(@)(@@) % كالشمس في حسنها وبهجتها % % فإن تورعت قلتكالبدر % 3(@)(@@) % لو قلدت نحرها السعود من الس % سبعة قلت لذلك النحر % % 4(@)(@@) % أو نطقت خصرها بمنطقة ال % % جوزاء قلت لذلك الخصر % % PageV01P2017 البحر : - 1(@)(@@) % من الحيف تخسيس النوال ومطله % فعجل خسيسا أو فأجل موفرا % % 2(@)(@@) % وكن نخلة تلوي وتسني عطاءها % % وإلا فكن عصفا أقل ويسرا % % PageV01P2018 البحر : - 1(@)(@@) % ليهنك أن قد مر من صدر دولة % % شهور توالت بعدهن شهور % 2(@)(@@) % وأن العدا قد سوغوا في مؤمل % % مقالهم بعض الرجاء 
ms509	 غرور % 3(@)(@@) % أيجدب ياللناس مرعى وليكم % % وأنتم غيوث للورى وبحور % % 4(@)(@@) % ويدجو عليه ليله ونهاره % وأنتم شموس أشرقت وبدور % % PageV01P2019 البحر : - 1(@)(@@) % أقول وقد قال العذول فأكثرا % % ومل من الإكثار فيها فأقصرا % % 2(@)(@@) % دريرة مني بالمكان الذي به % % حياتي فدع عنك الملام المكررا % % 3(@)(@@) % جرى حبها مني مجاري ريقها % % وألحاظها ثم اكتفى فتحيرا % % 4(@)(@@) % فيا لك من جار مع الروح ساكن % مساكنها في مأمن أن ينفرا % % 5(@)(@@) % وكيف سلو القلب عنها وقد غدا % % لها كل قلب سخرته مسخرا % % 6(@)(@@) % وقد أوتيت عينين هاروت فيهما % % وماروت ما أدهى لقلب وأسحرا % % 7(@)(@@) % دريرة ما للدر عندي مفخر % % سواك ولولا أنت ما عد مفخرا % % 8(@)(@@) % دعاك المسمي باسمه فرفعته % % وفخمت من مقداره فتكبرا % % 9(@)(@@) % فأنت له حلي وإن كان حلية % لكل غضيض الطرف أكحل أحورا % % 10(@)(@@) % وما الحلى إلا حيلة لنقيصة % تتمم من حسن إذا الحسن قصرا % % PageV01P2020 11(@)(@@) % ليس لحلي في الجميلة منظرا % جمال ولكن في القبيحة منظرا % % 12(@)(@@) % تضيء نجوم الليل في الليل وحده % % وليس لها ضوء إذا الصبح نورا % % 13(@)(@@) % فأما إذا ما الحسن كان مكملا % كحسنك لم يحتج إلى أن يزورا % % PageV01P2021 البحر : - 1(@)(@@) % إذا كنت لو دام السواد وأخلقت % محاسنك الأيام قيل كبير % % 2(@)(@@) % فكيف ترجي بالخضاب وإفكه % % وأنت كبير أن يقالصغير % % PageV01P2022 البحر : - 1(@)(@@) % هل الملالة إلا منقضى وطر % من لذة يطبى من غيرها وطر % 2(@)(@@) % وفيك أحسن ماتسمو النفوس له % % فأين يرغب عنك السمع والبصر % % 3(@)(@@) % لاشيء إلا وفيها منه أحسنه % فأين يصرف عنها القلب والنظر % % 4(@)(@@) % ما كان ضر سماء تستظل بها % % فلو امحى نيراها الشمس والقمر % % PageV01P2023 البحر : - 1(@)(@@) % يامن له صفوات الحسن والخير % % ومن تصاغر عنه الشمس والقمر % % 2(@)(@@) % أحسن وجهك ينمي لا انتهاء له % % أم هل تعاقبه في ساعة صور % % PageV01P2024 البحر : - 1(@)(@@) % ويغفر للهافين غير مقصر % ولاجاهل ماقد أتوا حين يغفر % 2(@)(@@) % ولكن يثيب المحسنين مثوبة % ينافسهم فيها المسيء فيقصر % % PageV01P2025 البحر : - 1(@)(@@) % زوج شيخ لنا عجوزا % تزهى بطست لها وتور % 2(@)(@@) % تنزه الطرف في ذراها % % فلا ترى 
ms510	 ثم غير ثور % 3(@)(@@) % قد بارها الدهركل بور % % وبارت الدهر كل بور % 4(@)(@@) % دارت تعاويذها قديما % في الحزن والسهل كل دور % % 5(@)(@@) % ملظة بالطريق تهدى % % في كل نجد وكل غور % % 6(@)(@@) % قد أنعلت خفها بزوج % ولففت رأسها بكور % % 7(@)(@@) % تزعم تعويذها شفاء % % من كل برد وكل فور % % 8(@)(@@) % وشيخنا محرز جداها % % في كل حال وكل طور % % 9(@)(@@) % تمور أكسابها عليه % % إذا التوى الكسب كل مور % % 10(@)(@@) % حتى إذا ضاجعته ليلا % وصافحت زوره بزور % % PageV01P2026 11(@)(@@) % أدلت إلى شدقه لسانا % ما هو إلا طحال ثور % % 12(@)(@@) % وابتلعت أيره بطيز % % ما هو إلا غمار هور % 13(@)(@@) % فالعدل منها عليه جور % % قاتلها الله أي جور % % 14(@)(@@) % وحاله الحور بعد كور % في ذاك لا الكور بعد حور % % 15(@)(@@) % أشهد إن لم ترح وتغدو % % جليس قعقاع بن شور % % 16(@)(@@) % لتسكنن الثرى وشيكا % أولتموتن خلف سور % % PageV01P2027 البحر : - 1(@)(@@) % يا ابن الوزير الذي تمت وزارته % لا تجمعن علي العار والنارا % % 2(@)(@@) % إن كنت أحسنت في وصفي مآثركم % % فأثروا في بالأحسان آثارا % % 3(@)(@@) % أو كنت قد قلت مالا أستحق به % % منكم ثوابا فردوه وما سارا % % 4(@)(@@) % إن المديح إذا ما سار منفردا % من الثواب كسا من قاله عارا % % 5(@)(@@) % الله يعلم أني ما ألوتكم % إطابة عند مدحيكم وإكثارا % % 6(@)(@@) % وقد يغر بليغ من بلاغته % وقد يظن سوى المختار مختارا % % 7(@)(@@) % فعفوكم عن مسيء غير معتمد % كان الإله لكم من سخطه جارا % % 8(@)(@@) % إني أرى عفوكم عني وستركم % عيبي أجل من التثويب مقدارا % % 9(@)(@@) % صونوا خلاقي كما صنتم نوالكم % عني وإلا فكونوا حاكما جارا % % 10(@)(@@) % من ذا أحل لكم أن تهتكوا خلقي % % وأن تمدوا على المعروف أستارا % % PageV01P2028 11(@)(@@) % غث من الشعر فيه ذل مسألة % كلاهما يكسب المستور إعوارا % % 12(@)(@@) % ردوا علي بييتا زل عن كبدي % % لم يلق عندكم إذ ضيم أنصارا % % 13(@)(@@) % أصغر تموه فأسرفتم وحق له % لو تمم الله ما لقاه إصغارا % % 14(@)(@@) % ردوا علي قبيحا عندكم حسنا % عندي أرى ما ازدريتم منه كبارا % % 15(@)(@@) % أقررت فيه بعيب لست 
ms511	 أعرفه % وربما استبطن الإقرار إنكارا % % 16(@)(@@) % أسهبت فيكم لكي أعلى فطأطأني % % تقصيركم بي فقد أزمعت إقصارا % % 17(@)(@@) % إن السلاليم لاتبنى أطاولها % % يوما ليهبط بانيهن أغوارا % % 18(@)(@@) % لكن ليصعد أنجادا تشرفه % حتى يمد إليه الناس أبصارا % % 19(@)(@@) % وقد هبطت بما أسديته لكم % % من حالق ولعل الله قد خارا % % 20(@)(@@) % كم هابط صاعد من بعد هبطته % % وغائر منجد من بعد ما غارا % % PageV01P2029 21(@)(@@) % قد يخفض الدهر من حر ليرفعه % % طورا وطورا وكان الدهر أطوارا % % 22(@)(@@) % لاغرو أن يضع المهدي هاديه % حالا ليرفعه حالا إذا ثارا % % 23(@)(@@) % ثقلت في كفة الميزان فانكدرت % تهوي وشالت خفاف القوم أقدارا % % 24(@)(@@) % صبرا فكم ناهض من بعد وقعته % % يوما وكم واقع من بعد ما طارا % % 25(@)(@@) % إذا هوى الدر في الميزان أصدره % تاجا إلى قمة العلياء سوارا % % 26(@)(@@) % إن المواعظ أنفال ينفلها % % ذوو الحجى تترك الأعسار أيسارا % % 27(@)(@@) % سينصف الدهر من قوم بدائرة % وفي الجديدين إنصاف إذا دارا % % 28(@)(@@) % وثقت فيكم بغدر الدهر إن له % غدرا وفيا وقدما كان غدارا % % 29(@)(@@) % يارب غدر وفي قد رأيت له % أخنى على ملك واغتال جبارا % % 30(@)(@@) % لابني سمير صروف غير غافلة % تحسن نقضا كما تحسن إمرارا % % PageV01P2030 31(@)(@@) % لعل ما نالني منكم سيغضب لي % % أنصار صدق من الأنصار أحرارا % % PageV01P2031 البحر : - 1(@)(@@) % إن أنت صادفت أخا لحية % قد جللت من كبر صدره % 2(@)(@@) % فاقبض بيسراك على أصلها % % وضع على حلقومه الشفره % % 3(@)(@@) % فإن خشيت الله في قتله % % وخفت منه سطوة مره % % 4(@)(@@) % فثب إلى عثنونه ناتفا % فأت عليه شعرة شعره % % PageV01P2032 البحر : - 1(@)(@@) % يا بن فراس أي شيء تنتظر % لم يبق إلا أن أراك تعتذر % % 2(@)(@@) % وأن أراني عند ذاك أعتبر % % فتسأل الغفران إذ لا أغتفر % % 3(@)(@@) % رح لي بما أملت إذا لم تبتكر % % وإن عجزت أن تسن فافتقر % % 4(@)(@@) % أولا فقد خاب رجائي وخسر % % والقول يبقى والخطوب تنشمر % % PageV01P2033 البحر : - 1(@)(@@) % لا يغضبن لعمرو من له خطر % فليس يرضى بضيمي من له خطر % 2(@)(@@) % لا سيما ولقولي فيه منزلة % من سيد مثلاه الشمس 
ms512	 والقمر % % 3(@)(@@) % لضحكة منه أولى أن أسر بها % % من ضحكة الروض وشى برده الزهر % 4(@)(@@) % لو كنت أعلم أن الشرك يضحكه % أشركت بالقرد عمرو أنه عبر % 5(@)(@@) % فإن تعجب قوم قلت ممتثلا % قول الفرزدق فيما أدت السير % 6(@)(@@) % أيعجب الناس أن أضحكت سيدهم % % خليفة الله يستسقى به المطر % % 7(@)(@@) % وإنني مستعير عرض عمرهم % شهرا من الحول كي يقضى به وطر % % 8(@)(@@) % كما استعار علي هام شيعته % % تحت الظبا ساعة فيما حكى الخبر % % 9(@)(@@) % وليس يغبن عمرو في إعارته % % إياي عرضا سيبقى فيه لي أثر % % 10(@)(@@) % يعيرنيه دريسا ثم يأخذه % مني جديدا موشى كله حبر % % PageV01P2034 11(@)(@@) % يا عمرو لا تمنعنا ما نسر به % % فإن ذلك لؤم منك أو خور % % 12(@)(@@) % وقد أعار خيار الناس هامهم % إمامهم ولأهل الفضل مصطبر % % 13(@)(@@) % دع ذا فأنت حقيق أن تكافئني % % لو كنت تدري وأنى يفقه الحجر % % 14(@)(@@) % نبهت ذكرك حتى عاد خامله % بدرا وكان سرارا دونه ستر % % 15(@)(@@) % سخرت فيك هجائي بعدما ذئرت % منك القوافي وقدما عيفت القذر % % 16(@)(@@) % وإن تسخير فكري فيك قافية % لسخرة منه خفت عندها السخر % % 17(@)(@@) % فاشكر وهيهات أن تهدى لشكر يد % وكيف يهدى غوي قصره سقر % 18(@)(@@) % أستغفر الله لم تشهرك حادثة % بل أنت قدما بذاك الأنف مشتهر % 19(@)(@@) % بل أنت كلك شيء لا نظير له % فيما رأيناوفي أشياء تنتظر % % 20(@)(@@) % فاشكر إلهك لا تشرك به أحدا % إن كان يشكر شىء كله شهر % % PageV01P2035 21(@)(@@) % يا عمرو لو قلبت ميممسكنة % باء محركة لم تخطأ الفقر % % 22(@)(@@) % فإن ضننت بميم كاست صاحبها % % فبدل العين غينا أيها الغمر % % 23(@)(@@) % ولا تميلن عن عمرو إلى عمر % فينتضي لك من أكفانه عمر % % 24(@)(@@) % ويغضب الله والسبع الطباق له % % وساكنوهن والأبرار والسور % % 25(@)(@@) % سمتك يا عمرو عمرا وهي ظالمة % رمام سوء وقد أودى بها العفر % % 26(@)(@@) % فادع الإله عليها غير متئب % وغير اسمك حلت باسمك الغير % % 27(@)(@@) % خيم على عبرواقنع بها سمة % فيها لمثلك إن أنصفت مقتصر % % 28(@)(@@) % سامح أبا العبر المسكين في ولد % يعزى إليه 
ms513	 وكنه أيها العبر % % 29(@)(@@) % أصبحت تصلح مصداقا لكنيته % % دعوى شواهدها أخلاقك العرر % % 30(@)(@@) % أنت ابنه غير شك يا أبا حسن % فاذهب ظفرت بما لم يأمل الظفر % % PageV01P2036 31(@)(@@) % حصلته هاشميا لا نظير له % % ملحا وظرفا وإن قال الخنا نفر % % 32(@)(@@) % وما أتى بك حيا بل صدى حفر % وهكذا تلد الأصداء والحفر % % 33(@)(@@) % لو كنت من ولد الأحياء ما اكتسبت % يداك دهياء لا تبقي ولا تذر % % 34(@)(@@) % أعجب بناسل عمرو وهو في جدث % وفي الحوادث آيات ومعتبر % % 35(@)(@@) % وإن أعجب من عمرو وناسله % % لأن غدا وهو محجوج ومعتمر % 36(@)(@@) % جبس يهر على الأحرار حاجبه % % وآفة الناس أن تستأسد البقر % % 37(@)(@@) % وأن يكون له بغل وآلته % % وأن يسير وقد حفت به الزمر % % 38(@)(@@) % مخبل الخلق في أوصاله حول % % كأن خلقته ثوب به شطر % % 39(@)(@@) % أو شكل ميزان قت جانب صعد % % وجانب ثقلوه فهو منحدر % % 40(@)(@@) % للعين في وجه عمرو مقبلا طير % وفي قفاه لها مستدبرا عبر % % PageV01P2037 41(@)(@@) % فإن تطاوح فيه طرفها صعدا % أضحى له ولها في طولها سفر % % 42(@)(@@) % قالت مقابح عمرو عند موقعه % % في أمه ما لمثلي افتضت العذر % % 43(@)(@@) % أنى يكون لنفس حرة سكنا % وليس فيه لكلب جائع جزر % % 44(@)(@@) % إني لأحسب عمرا من طفاسته % % يضحي وفي بعضه عن بعضه زور % % 45(@)(@@) % يا ابن الوزير الذي جلت وزارته % أنى يراح إلى عمرو ويبتكر % % 46(@)(@@) % قد أنكر الحزم أنا كل شارقة % تضحى بعمرو لنا ذنب ومعتذر % % 47(@)(@@) % يزري علينا به قوم فيجشمنا % % تمويه عذر وبعض العذر معتسر % % 48(@)(@@) % ولا يني مستخفا بامرىء وجبت % عليك بالميل والزلفى له أجر % % 49(@)(@@) % منها الكرامة وهي الفرض توجبه % وعند طولك أنفال له أخر % % 50(@)(@@) % وما دعاه إلى استخفافه درك % % لكن دعاه إليه الجهل والبطر % % PageV01P2038 51(@)(@@) % وليس تخطىء ذا الخرطوم واحدة % من اثنتين إذا ما حصحص النظر % % 52(@)(@@) % جهالة وتعد في إهانته % % مولاك والذنب في هاتيك مغتفر % 53(@)(@@) % لكن عتاد أبي الخرطوم سيدنا % % كبيرة صغرت في جنبها الكبر % % 54(@)(@@) % قد امتطى القرد في إتيانها غررا % ياواحد الناس 
ms514	 فليعثر به الغرر % % 55(@)(@@) % أما رآك وقد أكرمتني طرفا % من النهار أما كانت له ذكر % % 56(@)(@@) % أما درى أن ما عظمت قيمته % فهو العظيم وماحقرت محتقر % % 57(@)(@@) % لشد ما أقدمت بالأمس عزمته % على التي أعوزت أنصارها العذر % % 58(@)(@@) % فإن هم عذروا بالجهل صاحبها % % فليس في رفض أعمى القلب مؤتمر % % 59(@)(@@) % ممن يرى أن رزء العرض مجتبر % ولايرى أن رزء المال يجتبر % % 60(@)(@@) % وما الصواب سوى استقصاء نعمته % وكل نعمى على أمثاله هدر % % PageV01P2039 61(@)(@@) % كيما يكون لأقوام به أدب % وفي النكال عن الزلات مزدجر % % 62(@)(@@) % والحمد لله شكرا لاشريك له % على الأمور التي يجري بها القدر % % 63(@)(@@) % وسائل لي ما عمرو وموضعه % % أأعوزت رأي ذاك السيد الخير % % 64(@)(@@) % فقلت كلا ولكن طوله عجب % بمثله شغل السمار والسمر % % 65(@)(@@) % ما زال ذا منن تهدى إلى شبح % مافيه مسدى لعرف حين يختبر % % 66(@)(@@) % محاولا فعل عرف لا يخالطه % شوب سواه وذاك الصفو لا الكدر % % 67(@)(@@) % وللصنائع والآلاء تصفية % عند الكرام تراها تلكم الفطر % % 68(@)(@@) % خرق تراه بفعل الغيث مقتديا % والغيث ينعم حتى يعشب المدر % % 69(@)(@@) % فلن تراه وفي عرف يجود به % % ترشيح شكر وهل للغيث متجر % 70(@)(@@) % كاف كسى الناس طرا من فواضله % % ماليس في ثوبه ضيق ولا قصر % % PageV01P2040 71(@)(@@) % كالغيث يصبح مغمورا بنائله % % أفاضل القوم والأنعام والشجر % % 72(@)(@@) % هذا على أن فيه فضل تكرمة % للأفضلين ولم لاتمسح الغرر % % 73(@)(@@) % مثل الفراسي والنحوي صاحبه % وكالملقب فهو الغنج والحور % % 74(@)(@@) % ذاك الذي لم يزل ظرفا ونادرة % كأن محضره الأصداغ والطرر % % 75(@)(@@) % وكالطبيب أبي إسحاق إن له % نفعا مبينا إذا ما أجحف الضرر % % 76(@)(@@) % وما نسيت أبا إسحاق مائرنا % % تلك الفكاهات سيقت نحوه المير % % 77(@)(@@) % بحر المعاني ثقاف اللفظ قيمه % إذا تعاجم فيه البدو والحضر % % 78(@)(@@) % وكيف أنسى امرأ يحي محاسنه % ذكراه عندي إذا ما ماتت الذكر % % 79(@)(@@) % وكالنظيف نزيف إنه لهب % ذاك له حركات كلها شرر % % 80(@)(@@) % ذاك الذي لم يزل طيبا ومنفعة % كأن مشهده الآصال والبكر % % PageV01P2041 81(@)(@@) % أقسمت لو لم تحصنا حرارته % من 
ms515	 برد عمرو لقد أودت بنا القرر % % 82(@)(@@) % ولي إلى ابن فراس عودة وجبت % له علي بحق إنه وزر % % 83(@)(@@) % ذو مخبر بارع في منظر حسن % فيه لذي الفخر بالخدام مفتخر % % 84(@)(@@) % كأنه حين يجري في كتابته % % له طريق إلى العلياء مختصر % % 85(@)(@@) % صفاه من كل عيب أنه رجل % ما إن يزال له من عائب حذر % % 86(@)(@@) % سيف محلى تروق العين حليته % وصارم حين يتلو حدهذكر % % 87(@)(@@) % ولا يخونك في سر ولا علن % أمانة أو يخون السمع والبصر % % 88(@)(@@) % ليست مثانيه من نبع لعاطفه % % ولا مكاسره للمعتدي عشر % 89(@)(@@) % تطرفت شرر منه حباه بها % % شرخ الشباب ولم تنقض له مرر % % 90(@)(@@) % وربما نفخت في ناره هنة % فاستوقدت شررا ما مثلها شرر % % PageV01P2042 91(@)(@@) % حام بحزم حمى السلطان في كرم % رام بعزم إذا عنت له الفقر % % 92(@)(@@) % يثني السهام عن المرمى وآونة % يمضي السهام إذا لاحت له الثغر % % 93(@)(@@) % لا يورد الأمر أو تبدو مصادره % ولايرى الورد ما لم يمكن الصدر % % 94(@)(@@) % أضحت كتابته بيضاء تشبهه % يجبى بها الحمد للسلطان والبدر % % 95(@)(@@) % وكل ما قلته فيه فسيدنا % % أولى به وهو من حقت له الأثر % % 96(@)(@@) % وللعروق ثمار الفرع تمنحها % % أغصانه وللب الهامة الشعر % % PageV01P2043 البحر : - 1(@)(@@) % قل للإمام المهتدي كاسمه % % وللشبيه السر بالجهر % % 2(@)(@@) % أنصفت بعض الناس من بعضهم % % فأنصف الناس من الدهر % % PageV01P2044 البحر : - 1(@)(@@) % ألا ليت شعري حين أخلفت موعدي % % وأنت امرؤ قد حلمتك المعاشر % 2(@)(@@) % أقدرت أني راغب فيك لائم % % أبا حسن أم زاهد فيك عاذر % 3(@)(@@) % كلا ذا وهذا يتقي الخل مثله % على العهد من خلانه ويحاذر % % 4(@)(@@) % ويا ليت شعري حين غبت أفائز % ببغيته أم خائب القدح خاسر % % PageV01P2045 البحر : - 1(@)(@@) % لئن قبحت مني لديك الظهائر % لحسبك حسنا ما تجن الضمائر % 2(@)(@@) % وإني وإن أخلفت وعدك للذي % % وفى لك منه جهره والسرائر % % 3(@)(@@) % عثرت وأنساني التحفظ أنني % % أراك مقيلا حين يعثر عاثر % % 4(@)(@@) % فلا تلحيني في ذنوبي كلها % % فجاني ذنوبي عفوك المتواتر % % 5(@)(@@) % فإن لا تكن كانت لعفوك وحده % % فعفوك لي 
ms516	 فيها شريك مشاطر % % 6(@)(@@) % ومالك إنكار الجرائر من أخ % إذا وقعت منه ومنك الجرائر % % 7(@)(@@) % ولا بأس أن يزداد طولك بسطة % بأني خطاء وأنك غافر % % 8(@)(@@) % وضعت جران الذل سمعا وطاعة % ولي في مغيبي عنك يوما معاذر % % 9(@)(@@) % شغلت بصيد الظبي حتى اقتنصته % وها هو ذا قد قبضته الأظافر % % 10(@)(@@) % وكل امرىء يفري بجدك مفلح % وكل امرىء يسقي بجدك ظافر % % PageV01P2046 11(@)(@@) % وهل يحسن التقصير أو يعذر الونى % % ومثلي مأمور ومثلك آمر % % 12(@)(@@) % وليست لأستاذ علي ملامة % إذا غاب شخصي عنه والنفع حاضر % % 13(@)(@@) % وساءلتني هل غبت والقدح فائز % لدى غيبتي أم خائب ثم خاسر % 14(@)(@@) % ولم أخل من ربح وخسر كليهما % % إذا نفذت للمبصرين البصائر % % 15(@)(@@) % كفاني ربحا بغيتي لك حاجة % ولو أنها مما يهاب المخاطر % % 16(@)(@@) % وحسبي خسرا أن افأت بنظرة % إليك على أني بقلبي ناظر % % PageV01P2047 البحر : - 1(@)(@@) % يا كائنا بين أوعاث وأوعار % من صرف دهر على أبنائه ضاري % % 2(@)(@@) % لعا لعا لك من عثر ألم بنا % % في سابح منك طرف غير عثار % % 3(@)(@@) % ما زال يسبق بالتقريب طالبه % وفيه كنزان من شد وإحضار % % 4(@)(@@) % أعجب به فيك من شكو ولا عجب % من ريب دهر ولا من صرف مقدار % % 5(@)(@@) % أنى امتحنت ببلوى لا يشاكلها % % ما خلتها غير تعبير وإنذار % % 6(@)(@@) % وكل عبد أراد الله عصمته % لم يخله الله من وعظ وإذكار % % 7(@)(@@) % أما وبرئك كل البرء من وصب % أضر بالناس طرا كل إضرار % % 8(@)(@@) % لئن منحتك إشفاقا تكنفه % ودان من بين إعلان وإسرار % % 9(@)(@@) % إني لأنشر إشفاقي على رجل % فرد له خطر واف بأخطار % 10(@)(@@) % وكنت والدهر غدار بصاحبه % % لا سيما إن رآه غير غدار % PageV01P2048 11(@)(@@) % أخشى عليك اضطرام الدهر لاعللا % تخشى على كل كابي الزند عوار % 12(@)(@@) % ما أنت والبرد يا من كل جارحة % من جسمه ذات نيران وأنوار % % 13(@)(@@) % جارت عليلتك المنهاج سارية % وهل يضل على بدر الدجى ساري % % 14(@)(@@) % ما مثلها ياشهاب الأرض غاشية % معهودة من غواشي تلكم الدار % % 15(@)(@@) % برد أطاف بنار منك موقدة 
ms517	 % ليست تبوخ ولا تذكى بمسعار % % 16(@)(@@) % ما كان يجمع جل الله بينكما % % إلا المؤلف بين الثلج والنار % % 17(@)(@@) % أبشر فإنك طود الله أسسه % وشاد منه بناء غير منهار % % 18(@)(@@) % فأمن فإن ذكاء أنت ضامنه % قرن لشكرك جلد غير خوار % % 19(@)(@@) % ستستجيش عليه أو تطحطحه % في فيقة بحريق منه سوار % % 20(@)(@@) % وإنما هو برد والسلام له % شفع وفيك طباع زنده واري % % PageV01P2049 21(@)(@@) % والله يأسر قوما ثم يطلقهم % % والدهر ينسخ أطوارا بأطوار % % 22(@)(@@) % وحسبك العرف من درع ومن ترس % وحسبك الله من حصن ومن جار % % 23(@)(@@) % كأنني بك في سربال عافية % والحال حالان من نقض وإمرار % % 24(@)(@@) % تجري فتسبق من يجري إلى كرم % عفوا وأجدر بسبق بعد مضمار % % 25(@)(@@) % وأنت صاح من الأسقام منتقب % ديباجة ذات إشراق وإسفار % % 26(@)(@@) % نشوان من أريحيات الندى ثمل % لا من عصارة كرم بنت أعصار % % 27(@)(@@) % مطعم طيبات العيش تأكلها % % والصوم لاشك متبوع بإفطار % % 28(@)(@@) % عوادك الشعراء الصيد قد وفدوا % % إلى عطاياك من بدو وأمصار % 29(@)(@@) % عقرى لتأسوهم كسرى لتجبرهم % % يهوون كالطير تهوي نحو أوكار % % 30(@)(@@) % كاروا العمائم واقلولوا على شعب % وأقبلوا بين أكوار وأكوار % % PageV01P2050 31(@)(@@) % جابت سهولا وأوعارا ركائبهم % % كيما يحلوا سهولا بعد أوعار % 32(@)(@@) % في كل هاجرة شهباء حامية % وكل داجية دهماء كالقار % 33(@)(@@) % فخيموا منك في سهل مباءته % وأوسعوا بك طرا بعد إقتار % % 34(@)(@@) % ولو قدرت من اللين اللطيف بهم % % أحللتهم بين أجفان وأشفار % % 35(@)(@@) % فكم ضيوف ضيوف في رحالهم % وكم هنا لك من زوار زوار % % 36(@)(@@) % تطوى لنا الأرض إن أمتك نيتنا % % وإن لقيناك زيدت نشر أقطار % % 37(@)(@@) % طي ونشر لشوق لا كفاء له % % وطلعة منك فيها طي إعسار % % 38(@)(@@) % وحق أن تنشر الدنيا لذي أمل % لاقال ياخير ممتار لممتار % 39(@)(@@) % كما يحق بأن تطوى لذي سفر % نواك يا خير مزدار لمزدار % % 40(@)(@@) % لنا فوائد شتى منك نافعة % % عرف لعاف وعرفان لنظار % % PageV01P2051 41(@)(@@) % ما انفك آتوك من مال تجود به % % ومن إضاءة آراء وأفكار % % 42(@)(@@) % آراؤك البيض تهديهم وتشفعها % % آلاؤك الصفر ما الأيدي 
ms518	 بأصفار % % 43(@)(@@) % فالناس تحت سماء منك مشمسة % والناس تحت سماء منك مدرار % % 44(@)(@@) % أصحت وصابت ففيها كل منفعة % وربما أصعقت يوما لأشرار % % 45(@)(@@) % وليس يصلح لاستصلاح مملكة % % غير امرىء نافع بالحق ضرار % % 46(@)(@@) % ما ليم قط على استئثاره أحد % إلا وجدناك معذولا لإيثار % 47(@)(@@) % تعطي الجزيل وما أكبرت قيمته % وأيسر الشكر تلقاه بإكبار % 48(@)(@@) % شهدت أنك سلسال كماء حيا % % وسائر الناس صلصال كفخار % 49(@)(@@) % أقسمت بالفعلات الغر تفعلها % % في الناس أنك من غراء مذكار % 50(@)(@@) % لئن سبقت إلي الناس كلهم % لقد سبقت إلى شكري وأشعاري % % PageV01P2052 51(@)(@@) % أبكرت فاصطدتني والقوم في سنة % وصاحب الصيد قدما كل مبكار % % 52(@)(@@) % أنت الذي صان لي عرضي ومسألتي % % عن كل كلب على الأحرار هرار % % 53(@)(@@) % ولن يثوب شعرا كالعليم به % % ولن يقوم ثوبا مثل سمسار % % 54(@)(@@) % أمطيتني البشر حملانا وأقفرني % % قوم وكم بين حملان وإقفار % % 55(@)(@@) % كم سهلة فيك لاتكدي محافرها % % وصخرة منك تنبي كل منقار % % 56(@)(@@) % يا خائفا بدآت منه مشرفة % على عوائد سيب منه ثرثار % % 57(@)(@@) % ثق بالعوائد منه إنه رجل % % كالسيل يحفر تيارا بتيار % % 58(@)(@@) % لا تخش من بدئه قطعا لعودته % % فإن إقدامه إقدام كرار % % 59(@)(@@) % حاشاه أن يردع الإجزال كرته % أو أن يقدم إغزارا لإنزار % % 60(@)(@@) % بل تستخف بما أعطاك قبضته % حتى يرى ألف قنطار كدينار % % PageV01P2053 61(@)(@@) % وحق من لا يفي شيء بهمته % % أن يستقل لعاف ألف قنطار % % 62(@)(@@) % خرق يحاجز بالإجبار عاذله % ولا يحاجز ممتاحا بإجبار % % 63(@)(@@) % ما عامل الدهر في إقباله أحد % إلا اشترى منه إقبالا بإدبار % 64(@)(@@) % بني ثوابة لا زالت منازلكم % % تلفى مثابة مداح وأشعار % % 65(@)(@@) % أغراض منتزع أكلاء مرتبع % مهناة منتجع غايات أسفار % % 66(@)(@@) % ما زلتم تمنحون العرف جاحده % حتى أقر به من بعد إنكار % % 67(@)(@@) % وفي الرقاب وسوم من صنائعكم % % إن أنكرتها رجال بعد إقرار % % 68(@)(@@) % تستعبدون بها الأحرار دهركم % فكم عبيد لكم في الناس أحرار % % 69(@)(@@) % لكن من عبد الأحرار عبدهم % % عن غير عمد بحكم للعلى جاري % % 70(@)(@@) % يريد إعتاق ملهوف فتلزمه % نعماه رقا 
ms519	 بلا إثم ولا عار % PageV01P2054 71(@)(@@) % لكم علينا امتنان لا امتنان به % % وهل تمن سماوات بأمطار % 72(@)(@@) % فكل حر بنعماكم وصمتكم % من منكم مكتس من منكم عاري % % 73(@)(@@) % وكيف ينوي اعتباد الحر معتقه % في كل بؤس وإعسار بإيسار % 74(@)(@@) % وما اعتبادكم حرا بمعتمد % أنى ونياتكم نيات أخيار % % 75(@)(@@) % وكم منحتم وكم ألقيتم عذرا % بعد اللهى لا لتقصير وإقصار % % 76(@)(@@) % أريتمونا عيانا كل مكرمة % كانت قديما لدينا رجم أخبار % % 77(@)(@@) % تخادعون عن الدنيا وزبرجها % % فتخدعون وما أنتم بأغمار % % 78(@)(@@) % وتفعلون جميلا في مساترة % كأن معروفكم إيداع أسرار % % 79(@)(@@) % ما سار مدحكم في الأرض منشمرا % إلا بعرف لكم في الناس سيار % % 80(@)(@@) % يا رب أبواع أقوام ذوي كرم % قيست فيما عدلت منكم بأشبار % % PageV01P2055 81(@)(@@) % طلتم بمجدكم الأمجاد كلهم % % لا تعدموا طول أقدار وأعمار % % 82(@)(@@) % إن كان أورق أقوام فإنكم % مفضلون بتنوير وإثمار % 83(@)(@@) % أظللتم بشكير نبته ثمر % % للمجتبين وحييتم بنوار % % 84(@)(@@) % كأنما الناس في الدنيا بظلكم % قد خيموا بين جنات وأنهار % 85(@)(@@) % أيامنا غدوات كلها بكم % خلالهن ليال مثل أسحار % 86(@)(@@) % لكم خلائق لو تحظى السماء بها % % لما ألاحت نجوما غير أقمار % 87(@)(@@) % لا ترهبوا الدهر إن العرف ناهضة % لكم على الدهر منها خير أنصار % 88(@)(@@) % أنتم بها منه في حرز وواقية % إن صال يوما بأنياب وأظفار % % 89(@)(@@) % لولا عمارتكم للملك دولته % لأصبح الملك في بيداء مقفار % % 90(@)(@@) % كتاب ملك إذا شئتم مقاتلة % يستنفر الملك منكم خير أنفار % % PageV01P2056 91(@)(@@) % تقاتلون بآراء مسددة % لا بل بأسلحة لا بل بأقدار % % 92(@)(@@) % أقلامكم كرماح الخط مشرعة % طولا كطول وآثارا كآثار % % 93(@)(@@) % آراء صدق أتى التوفيق خيرتها % % في موقف بين إيراد وإصدار % % 94(@)(@@) % يا رب ثقل حملتم عن خلائقنا % % لم تعدلوه بآثام وأوزار % % 95(@)(@@) % لا كالألى حملوا ما لا يفون به % % وأوقروا من أثام أي إيقار % % 96(@)(@@) % رآكم الله والسلطان حزبهما % % فاستعمر الملك منكم خير عمار % % 97(@)(@@) % لو لم تكونوا دروعا للدروع بها % % لأعورت كل درع أي إعوار % % 98(@)(@@) % أو لم تكونوا سهاما للسهام بها % % إذا لطاشت 
ms520	 مرامي كل أسوار % % 99(@)(@@) % أو لم تكونوا رماحا للرماح بها % % لم يجعل الله فيها نقض أوتار % % 100(@)(@@) % أو لم تكونوا سيوفا للسيوف بها % % لأخفرت حامليها أي إخفار % % PageV01P2057 101(@)(@@) % رعيتم لقحات الفيء رعيتها % % فأعقبت بعد إنزار بإغزار % % 102(@)(@@) % حفلتم ومريتم كل ناحية % قد حاردت ثم ثلثتم بإدرار % % 103(@)(@@) % فأترعت عفوات الدر محلبها % % وطال ما لم تصادف غير أغبار % % 104(@)(@@) % تلفى العلاب إذا أدررتم دررا % ملأن بين قرارات وأصبار % % 105(@)(@@) % يا رب أمر غدا حضاره غيبا % وأنتم غيب فيه كحضار % % 106(@)(@@) % كم قد سموتم بأيديكم إلى شرف % لم يسم قط له قوم بأبصار % % 107(@)(@@) % لاتجعلوا من حديث الناس موعظة % ولا يزل عرفكم أسمار سمار % % 108(@)(@@) % ومستخف بقدر الشعر قلت له % % لن ينفق العطر إلا عند معطار % % 109(@)(@@) % لاتصغر الشعر إن أصغرت قائله % فإنه غير محقوق بإصغار % % 110(@)(@@) % ولا يغرنك تصريف الهني له % % فتستخف بشأن منه كبار % % PageV01P2058 111(@)(@@) % أما ترى المسك بيناه على حجر % يذله كل ذل فهر عطار % % 112(@)(@@) % إذ بلغته صروف الدهر غايته % فاحتل منزلة من رأس جبار % % 113(@)(@@) % وقد عرفت وغيري حق معرفة % % للشعر أنصار صدق أي أنصار % % 114(@)(@@) % يكفيك أن أبا العباس ينصره % وإنما الحكم فيه حكم معيار % % 115(@)(@@) % فاعدل بلومك عني إنني رجل % أجررت في الشعر حبلي أي إجرار % % 116(@)(@@) % في الشعر أشياء يرتاح الكريم لها % % مثل اهتزاز قويم المتن خطار % % 117(@)(@@) % أبني البديع وأهديه إلى ملك % % يبني الرفيع وما يبني بأحجار % % 118(@)(@@) % أضحت له منح تحيا بها مدح % عون بعون وأبكار بأبكار % % 119(@)(@@) % يكسي المديح ولم يعور مجرده % وكعبة الله لا تكسي لإعوار % % 120(@)(@@) % ما في مجرد بيت الله مثلبة % كلا وإن كان مستورا بأستار % PageV01P2059 121(@)(@@) % فرد البلاغة لا يخلو مخاطبه % من سحر يافعة لا سحر سحار % % 122(@)(@@) % يزداد في القول إنجازا ومشربه % محض العذوبة لم يملح لإبحار % % 123(@)(@@) % لا يعرف الناس إقلال العيي له % حاشاه ذاك ولا إكثار مهذار % % 124(@)(@@) % تلقى به في مقامات الحجى بطلا % على كلام سواه غير مغوار % % 125(@)(@@) % مجانب كل تمويه لبينة 