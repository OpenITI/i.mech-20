ms601	 جنة نعيم(@)(@@) PageV01P766(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P767(@)(@@) {كلا} ردع لهم عن طمعهم في الجنة {إنا خلقناهم} كغيرهم {مما يعلمون} من نطف فلا يطمع بذلك في الجنة وإنما يطمع فيها بالتقوى(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P767(@)(@@) {فلا} لا زائدة {أقسم برب المشارق والمغارب} للشمس والقمر وسائر الكواكب {إنا لقادرون}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P767(@)(@@) {على أن نبدل} نأتي بدلهم {خيرا منهم وما نحن بمسبوقين} بعاجزين عن ذلك(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P767(@)(@@) {فذرهم} اتركهم {يخوضوا} في باطلهم {ويلعبوا} في دنياهم {حتى يلاقوا} يلقوا {يومهم الذي يوعدون} فيه العذاب(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P767(@)(@@) {يوم يخرجون من الأجداث} القبور {سراعا} إلى المحشر {كأنهم إلى نصب} وفي قراءة بضم الحرفين شيء منصوب كعلم أو راية {يوفضون} يسرعون(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P767(@)(@@) {خاشعة} ذليلة {أبصارهم ترهقهم} تغشاهم {ذلة ذلك اليوم الذي كانوا يوعدون} ذلك مبتدأ وما بعدها الخبر ومعناه يوم القيامة = 71 سورة(@)(@@)(@@)(@@) | نوح(@)(@@) PageV01P767(@)(@@) {إنا أرسلنا(@)(@@)(@@)(@@) | نوح(@)(@@) ا إلى قومه أن أنذر} أي بإنذار {قومك من قبل أن يأتيهم} إن لم يؤمنوا {عذاب أليم} مؤلم في الدنيا والآخرة(@)(@@) PageV01P767(@)(@@) {قال يا قوم إني لكم نذير مبين} بين الإنذار(@)(@@) PageV01P767(@)(@@) {أن} أي بأن أقول لكم {اعبدوا الله واتقوه وأطيعون(@)(@@) PageV01P767(@)(@@) {يغفر لكم من ذنوبكم} من زائدة فإن الإسلام يغفر به ما قبله أو تبعيضية لإخراج حقوق العباد {ويؤخركم} بلا عذاب {إلى أجل مسمى} أجل الموت {إن أجل الله} بعذابكم إن لم تؤمنوا {إذا جاء لا يؤخر لو كنتم تعلمون} ذلك لآمنتم(@)(@@) PageV01P768(@)(@@) {قال رب إني دعوت قومي ليلا ونهارا} أي دائما متصلا(@)(@@) PageV01P768(@)(@@) {فلم يزدهم دعائي إلا فرارا} عن الإيمان(@)(@@) PageV01P768(@)(@@) {وإني كلما دعوتهم لتغفر لهم جعلوا أصابعهم في آذانهم} لئلا يسمعوا كلامي {واستغشوا ثيابهم} غطوا رؤوسهم بها لئلا ينظروني {وأصروا} على كفرهم {واستكبروا} تكبروا عن الإيمان {استكبارا}(@)(@@) PageV01P768(@)(@@) {ثم إني دعوتهم جهارا} أي بأعلى صوتي(@)(@@) PageV01P768(@)(@@) {ثم إني أعلنت لهم} صوتي {وأسررت} الكلام {لهم إسرارا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P768(@)(@@) {فقلت استغفروا ربكم} من الشرك {إنه كان غفارا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P768(@)(@@) {يرسل السماء} المطر وكانوا قد منعوه {عليكم مدرارا} كثير الدرور(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P768(@)(@@) {ويمددكم بأموال وبنين ويجعل لكم جنات} بساتين {ويجعل لكم أنهارا} جارية(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P768(@)(@@) {مالكم لا ترجون لله وقارا} أي تأملون 
ms602	 وقار الله إياكم بأن تؤمنوا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P768(@)(@@) {وقد خلقكم أطوارا} جمع طور وهو الحال فطورا نطفة وطورا علقة إلى تمام خلق الإنسان والنظر في خلقه يوجب الإيمان بخالقه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P768(@)(@@) {ألم تروا} تنظروا {كيف خلق الله سبع سماوات طباقا} بعضها فوق بعض(@)(@@) PageV01P768(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P769(@)(@@) {وجعل القمر فيهن} أي في مجموعهن الصادق بالسماء الدنيا {نورا وجعل الشمس سراجا} مصباحا مضيئا وهو أقوى من نور القمر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P769(@)(@@) {والله أنبتكم} خلقكم {من الأرض} إذ خلق أباكم آدم منها {نباتا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P769(@)(@@) {ثم يعيدكم فيها} مقبورين {ويخرجكم} للبعث {إخراجا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P769(@)(@@) {والله جعل لكم الأرض بساطا} مبسوطة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {لتسلكوا منها سبلا} طرقا {فجاجا} واسعة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {قال نوح رب إنهم عصوني واتبعوا} أي السفلة والفقراء {من لم يزده ماله وولده} وهم الرؤساء المنعم عليهم بذلك وولد بضم الواو وسكون اللام وبفتحهما والأول قيل جمع ولد بفتحهما كخشب وخشب وقيل بمعناه كبخل وبخل {إلا خسارا} طغيانا وكفرا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {ومكروا} أي الرؤساء {مكرا كبارا} عظيما جدا بأن كذبوا نوحا وآذوه ومن اتبعه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {وقالوا} للسفلة {لا تذرن آلهتكم ولا تذرن ودا} بفتح الواو وضمها {ولا سواعا ولا يغوث ويعوق ونسرا} هي أسماء أصنامهم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {وقد أضلوا} بها {كثيرا} من الناس بأن أمروهم بعبادتهم {ولا تزد الظالمين إلا ضلالا} عطفا على قد أضلوا دعا عليهم لما أوحي إليه أنه لن يؤمن من قومك إلا من قد آمن(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {مما} ما صلة {خطاياهم} وفي قراءة خطيئآتهم بالهمز {أغرقوا} بالطوفان {فأدخلوا نارا} عوقبوا بها عقب الإغراق تحت الماء {فلم يجدوا لهم من دون} أي غير {الله أنصارا} يمنعون عنهم العذاب(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {وقال نوح رب لا تذر على الأرض من الكافرين ديارا} أي نازل دار والمعنى أحدا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P769(@)(@@) {إنك إن تذرهم يضلوا عبادك ولا يلدوا إلا فاجرا كفارا} من يفجر ويكفر قال ذلك لما تقدم من الإيحاء إليه(@)(@@) PageV01P769(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P770(@)(@@) {رب اغفر لي ولوالدي} وكانا مؤمنين {ولمن دخل بيتي} منزلي أو مسجدي {مؤمنا وللمؤمنين والمؤمنات} إلى يوم القيامة {ولا تزد الظالمين إلا تبارا} هلاكا فأهلكوا = 72 سورة 
ms603	(@)(@@)(@@)(@@) | الجن(@)(@@) مكية وآياتها ثمان وعشرون بسم الله الرحمن الرحيم(@)(@@) PageV01P770(@)(@@) {قل} يا محمد للناس {أوحي إلي} أي أخبرت بالوحي من الله تعالى {أنه} الضمير للشأن {استمع} لقراءتي {نفر من(@)(@@)(@@)(@@) | الجن} (@)(@@) جن نصيبين وذلك في صلاة الصبح ببطن نخل موضع بين مكة والطائف وهم الذين ذكروا في قوله تعالى {وإذ صرفنا إليك نفرا من الجن} الآية {فقالوا} لقومهم لما رجعوا إليهم {إنا سمعنا قرآنا عجبا} يتعجب منه في فصاحته وغزارة معانيه وغير ذلك(@)(@@) PageV01P770(@)(@@) {يهدي إلى الرشد} الإيمان والصواب {فآمنا به ولن نشرك} بعد اليوم {بربنا أحدا}(@)(@@) PageV01P770(@)(@@) {وأنه} الضمير للشأن فيه وفي الموضعين بعده {تعالى جد ربنا} تنزه جلاله وعظمته عما نسب إليه {ما اتخذ صاحبة} زوجة {ولا ولدا}(@)(@@) PageV01P770(@)(@@) {وأنه كان يقول سفيهنا} جاهلنا {على الله شططا} غلوا في الكذب بوصفه بالصاحبة والولد(@)(@@) PageV01P770(@)(@@) {وأنا ظننا أن} مخففة أي أنه {لن تقول الإنس والجن على الله كذبا} بوصفه بذلك حتى تبينا كذبهم بذلك قال تعالى(@)(@@) PageV01P770(@)(@@) {وأنه كان رجال من الإنس يعوذون} يستعيذون {برجال من الجن} حين ينزلون في سفرهم بمخوف فيقول كل رجل أعوذ بسيد هذا المكان من شر سفهائه {فزادوهم} بعوذهم بهم {رهقا} فقالوا سدنا الجن والإنس(@)(@@) PageV01P771(@)(@@) {وأنهم} أي الجن {ظنوا كما ظننتم} يا إنس {أن} مخففة من الثقيلة أي أنه {لن يبعث الله أحدا} بعد موته(@)(@@) PageV01P771(@)(@@) قال الجن {وأنا لمسنا السماء} رمنا استراق السمع {فوجدناها ملئت حرسا} من الملائكة {شديدا وشهبا} نجوما محرقة وذلك لما بعث النبي صلى الله عليه وسلم(@)(@@) PageV01P771(@)(@@) {وأنا كنا} أي قبل مبعثه {نقعد منها مقاعد للسمع} أي نستمع {فمن يستمع الآن يجد له شهابا رصدا} أرصد له ليرمى به(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P771(@)(@@) {وأنا لا ندري أشر أريد} بعد استراق السمع {بمن في الأرض أم أراد بهم ربهم رشدا} خيرا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P771(@)(@@) {وأنا منا الصالحون} بعد استماع القرآن {ومنا دون ذلك} أي قوم غير صالحين {كنا طرائق قددا} فرقا مختلفين مسلمين وكافرين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P771(@)(@@) {وأنا ظننا أن} مخففة من الثقيلة أي أنه {لن نعجز الله في الأرض ولن نعجزه هربا} لا نفوته كائنين 
ms604	 في الأرض أو هاربين منها في السماء(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P771(@)(@@) {وأنا لما سمعنا الهدى} القرآن {آمنا به فمن يؤمن بربه فلا يخاف} بتقدير هو {بخسا} نقصا من حسناته {ولا رهقا} ظلما بالزيادة في سيئاته(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P771(@)(@@) {وأنا منا المسلمون ومنا القاسطون} الجائرون بكفرهم {فمن أسلم فأولئك تحروا رشدا} قصدوا هداية(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P771(@)(@@) {وأما القاسطون فكانوا لجهنم حطبا} وقودا وأنا وأنهم وأنه في اثني عشر موضعا هي وأنه تعالى وأنا منا المسلمون وما بينهما بكسر الهمزة استئنافا وبفتحها بما يوجه به(@)(@@) PageV01P771(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P772(@)(@@) قال تعالى في كفار مكة {وإن} مخففة من الثقيلة واسمها محذوف أي وأنهم وهو معطوف على أنه استمع {لو استقاموا على الطريقة} أي طريقة الإسلام {لأسقيناهم ماء غدقا} كثيرا من السماء وذلك بعد ما رفع المطر عنهم سبع سنين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P772(@)(@@) {لنفتنهم} لنختبرهم {فيه} فنعلم كيف شكرهم علم ظهور {ومن يعرض عن ذكر ربه} القرآن {نسلكه} بالنون والياء ندخله {عذابا صعدا} شاقا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P772(@)(@@) {وأن المساجد} مواضع الصلاة {لله فلا تدعوا} فيها {مع الله أحدا} بأن تشركوا كما كانت اليهود والنصارى إذا دخلوا كنائسهم وبيعهم أشركوا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P772(@)(@@) {وأنه} بالفتح والكسر استئنافا والضمير للشأن {لما قام عبد الله} محمد النبي صلى الله عليه وسلم {يدعوه} يعبده ببطن نخل {كادوا} أي الجن المستمعون لقراءته {يكونون عليه لبدا} بكسر اللام وضمها جمع لبدة كاللبد في ركوب بعضهم بعضا ازدحاما حرصا على سماع القرآن(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P772(@)(@@) {قال} مجيبا للكفار في قولهم ارجع عما أنت فيه وفي قراءة قل {إنما أدعو ربي} إلها {ولا أشرك به أحدا}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P772(@)(@@) {قل إني لا أملك لكم ضرا} غيا {ولا رشدا} خيرا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P772(@)(@@) {قل إني لن يجيرني من الله} من عذابه إن عصيته {أحد ولن أجد من دونه} أي غيره {ملتحدا} ملتجأ(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P772(@)(@@) {إلا بلاغا} استثناء من مفعول أملك أي لا أملك لكم إلا البلاغ إليكم {من الله} أي عنه {ورسالاته} عطف على بلاغا وما بين المستثنى منه والاستثناء اعتراض لتأكيد نفي الاستطاعة {ومن يعص الله ورسوله} في التوحد فلم يؤمن {فإن له نار جهنم 
ms605	 خالدين} حال من ضمير من في له رعاية في معناها وهي حال مقدرة والمعنى يدخلونها مقدار خلودهم {فيها أبدا}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P772(@)(@@) {حتى إذا رأوا} ابتدائية فيها معنى الغاية لمقدر قبلها أي لا يزالون على كفرهم إلى أن يروا {ما يوعدون} به من العذاب {فسيعلمون} عند حلوله بهم يوم بدر أو يوم القيامة {من أضعف ناصرا وأقل عددا} أعوانا أهم أم المؤمنون على القول الأول أو أنا أم هم على الثاني فقال بعضهم متى هذا الوعد فنزل(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P772(@)(@@) {قل إن} أي ما {أدري أقريب ما توعدون} من العذاب {أم يجعل له ربي أمدا} غاية وأجلا لا يعلمه إلا هو(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P772(@)(@@) {عالم الغيب} ما غاب عن العباد {فلا يظهر} يطلع {على غيبه أحدا} من الناس(@)(@@) PageV01P772(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P773(@)(@@) {إلا من ارتضى من رسول فإنه} مع إطلاعه على ما شاء منه معجزة له {يسلك} يجعل ويسير {من بين يديه} أي الرسول {ومن خلفه رصدا} ملائكة يحفظونه حتى يبلغه في جملة الوحي(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P773(@)(@@) {ليعلم} الله علم ظهور {أن} مخففة من الثقيلة أي أنه {قد أبلغوا} أي الرسل {رسالات ربهم} روعي بجمع الضمير معنى من {وأحاط بما لديهم} عطف على مقدر أي فعلم ذلك {وأحصى كل شيء عددا} تمييز وهو محول من المفعول والأصل أحصى عدد كل شيء = 73 سورة(@)(@@)(@@)(@@) | المزمل(@)(@@) مكية إلا آية فمدنية وآياتها عشرون آية بسم الله الرحمن الرحيم(@)(@@) PageV01P773(@)(@@) {يا أيها(@)(@@)(@@)(@@) | المزمل(@)(@@) } النبي وأصل المتزمل أدغمت التاء في الزاي أي المتلفف بثيابه حين مجيء الوحي له خوفا منه لهيبته(@)(@@) PageV01P773(@)(@@) {قم الليل} صل {إلا قليلا}(@)(@@) PageV01P773(@)(@@) {نصفه} بدل من قليلا وقلته بالنظر إلى الكل {أو انقص منه} من النصف {قليلا} إلى الثلث(@)(@@) PageV01P773(@)(@@) {أو زد عليه} إلى الثلثين وأو للتخيير {ورتل القرآن} تثبت في تلاوته {ترتيلا}(@)(@@) PageV01P773(@)(@@) {إنا سنلقي عليك قولا} قرآنا {ثقيلا} مهيبا أو شديدا لما فيه من التكاليف(@)(@@) PageV01P773(@)(@@) {إن ناشئة الليل} القيام بعد النوم {هي أشد وطئا} موافقة السمع للقلب على تفهم القرآن {وأقوم قيلا} أبين قولا(@)(@@) PageV01P773(@)(@@) {إن لك في النهار سبحا طويلا} تصرفا في إشغالك لا 
ms606	 تفرغ فيه لتلاوة القرآن(@)(@@) PageV01P773(@)(@@) {واذكر اسم ربك} أي قل بسم الله الرحمن الرحيم في ابتداء قراءتك {وتبتل} انقطع {إليه تبتيلا} مصدر بتل جيء به رعاية للفواصل وهو ملزوم التبتل(@)(@@) PageV01P773(@)(@@) هو {رب المشرق والمغرب لا إله إلا هو فاتخذه وكيلا} موكلا له أمورك(@)(@@) PageV01P773(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {واصبر على ما يقولون} أي كفار مكة من أذاهم {واهجرهم هجرا جميلا} لا جزع فيه وهذا قبل الأمر بقتالهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {وذرني} اتركني {والمكذبين} عطف على المفعول أو مفعول معه والمعنى أنا كافيكهم وهم صناديد قريش {أولي النعمة} التنعم {ومهلهم قليلا} من الزمن فقتلوا بعد يسير منه ببدر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {إن لدينا أنكالا} قيودا ثقالا جمع نكل بكسر النون {وجحيما} نارا محرقة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {وطعاما ذا غصة} يغص به في الحلق وهو الزقوم أو الضريع أو الغسلين أو شوك من نار لا يخرج ولا ينزل {وعذابا أليما} مؤلما زيادة على ما ذكر لمن كذب النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {يوم ترجف} تزلزل {الأرض والجبال وكانت الجبال كثيبا} رملا مجتمعا {مهيلا} سائلا بعد اجتماعه وهو من هال يهيل وأصله مهيول استثقلت الضمة على الياء فنقلت إلى الهاء وحذفت الواو ثاني الساكنين لزيادتها وقلبت الضمة كسرة لمجانسة الياء(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {إنا أرسلنا إليكم} يا أهل مكة {رسولا} هو محمد صلى الله عليه وسلم {شاهدا عليكم} يوم القيامة بما يصدر منكم من العصيان {كما أرسلنا إلى فرعون رسولا} هو موسى عليه الصلاة والسلام(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {فعصى فرعون الرسول فأخذناه أخذا وبيلا} شديدا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {فكيف تتقون إن كفرتم} في الدنيا {يوما} مفعول تتقون أي عذابه بأي حصن تتحصنون من عذاب يوم {يجعل الولدان شيبا} جمع أشيب لشدة هوله وهو يوم القيامة والأصل في شين شيبا الضم وكسرت لمجانسة الياء ويقال في اليوم الشديد يوم يشيب نواصي الأطفال وهو مجاز ويجوز أن يكون المراد في الآية الحقيقة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {السماء منفطر} ذات انفطار أي انشقاق {به} بذلك اليوم لشدته {كان وعده} تعالى بمجيء ذلك {مفعولا} أي هو كائن لا محالة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P774(@)(@@) {إن هذه} الآيات المخوفة {تذكرة} عظة 
ms607	 للخلق {فمن شاء اتخذ إلى ربه سبيلا} طريقا بالإيمان والطاعة(@)(@@) PageV01P774(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P775(@)(@@) {إن ربك يعلم أنك تقوم أدنى} أقل {من ثلثي الليل ونصفه وثلثه} بالجر عطف على ثلثي وبالنصب على أدنى وقيامه كذلك نحو ما أمر به أول السورة {وطائفة من الذين معك} عطف على ضمير تقوم وجاز من غير تأكيد للفصل وقيام طائفة من أصحابه كذلك للتأسي به ومنهم من كان لا يدري كم صلى من الليل وكم بقي منه فكان يقوم الليل كله احتياطا فقاموا حتى انتفخت أقدامهم سنة أو أكثر فخفف عنهم قال تعالى {والله يقدر} يحصي {الليل والنهار علم إن} مخففة من الثقيلة واسمها محذوف أي أنه {لن تحصوه} أي الليل لتقوموا فيما يجب القيام فيه إلا بقيام جميعه وذلك يشق عليكم {فتاب عليكم} رجع بكم إلى التخفيف {فاقرؤوا ما تيسر من القرآن} في الصلاة بأن تصلوا ما تيسر {علم أن} مخففة من الثقيلة أي أنه {سيكون منكم مرضى وآخرون يضربون في الأرض} يسافرون {يبتغون من فضل الله} يطلبون من رزقه بالتجارة وغيرها {وآخرون يقاتلون في سبيل الله} وكل من الفرق الثلاثة يشق عليهم ما ذكر في قيام الليل فخفف عنهم بقيام ما تيسر منه ثم نسخ ذلك بالصلوات الخمس {فاقرؤوا ما تيسر منه} كما تقدم {وأقيموا الصلاة} المفروضة {وآتوا الزكاة وأقرضوا الله} بأن تنفقوا ما سوى المفروض من المال في سبيل الخير {قرضا حسنا} عن طيب قلب {وما تقدموا لأنفسكم من خير تجدوه عند الله هو خيرا} مما خلفتم وهو فصل وما بعده وإن لم يكن معرفة يشبهها لامتناعه من التعريف {وأعظم أجرا واستغفروا الله إن الله غفور رحيم} للمؤمنين = 74 سورة(@)(@@)(@@)(@@) | المدثر(@)(@@) المكية وآياتها ست وخمسون بسم الله الرحمن الرحيم(@)(@@) PageV01P775(@)(@@) {يا أيها(@)(@@)(@@)(@@) | المدثر} (@)(@@) النبي صلى الله عليه وسلم وأصله المتدثر أدغمت التاء في الدال أي المتلفف بثيابه عند نزول الوحي عليه(@)(@@) PageV01P775(@)(@@) {قم فأنذر} خوف أهل مكة النار إن لم يؤمنوا(@)(@@) PageV01P775(@)(@@) {وربك فكبر} عظم عن إشراك المشركين(@)(@@) PageV01P776(@)(@@) {وثيابك فطهر} عن النجاسة أو قصرها خلاف جر العرب 
ms608	 ثيابهم خيلاء فربما أصابتها نجاسة(@)(@@) PageV01P776(@)(@@) {والرجز} فسره النبي صلى الله عليه وسلم بالأوثان {فاهجر} أي دم على هجره(@)(@@) PageV01P776(@)(@@) {ولا تمنن تستكثر} بالرفع حال أي لا تعط شيئا لتطلب أكثر منه وهذا خاص به صلى الله عليه وسلم لأنه مأمور بأجمل الأخلاق وأشرف الآداب(@)(@@) PageV01P776(@)(@@) {ولربك فاصبر} على الأوامر والنواهي(@)(@@) PageV01P776(@)(@@) {فإذا نقر في الناقور} نفخ في الصور وهو القرن النفخة الثانية(@)(@@) PageV01P776(@)(@@) {فذلك} أي وقت النقر {يومئذ} بدل مما قبله المبتدأ وبني لإضافته إلى غير متمكن وخبر المبتدأ {يوم عسير} والعامل في إذا ما دلت عليه الجملة اشتد الأمر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {على الكافرين غير يسير} فيه دلالة على أنه يسير على المؤمنين في عسره(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {ذرني} اتركني {ومن خلقت} عطف على المفعول أو مفعول معه {وحيدا} حال من من أو من ضميره المحذوف من خلقت منفردا بلا أهل ولا مال هو الوليد بن المغيرة المخزومي(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {وجعلت له مالا ممدودا} واسعا متصلا من الزروع والضروع والتجارة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {وبنين} عشرة أو أكثر {شهودا} يشهدون المحافل وتسمع شهاداتهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {ومهدت} بسطت {له} في العيش والعمر والولد {تمهيدا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {ثم يطمع أن أزيد}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {كلا} لا أزيده على ذلك {إنه كان لآياتنا} القرآن {عنيدا} معاندا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {سأرهقه} أكلفه {صعودا} مشقة من العذاب أو جبلا من نار يصعد فيه ثم يهوي أبدا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {إنه فكر} فيما يقول في القرآن الذي سمعه من النبي صلى الله عليه وسلم {وقدر} في نفسه ذلك(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P776(@)(@@) {فقتل} لعن وعذب {كيف قدر} على أي حال كان تقديره(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P776(@)(@@) {ثم قتل كيف قدر}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P776(@)(@@) {ثم نظر} في وجوه قومه أو فيما يقدح به فيه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P776(@)(@@) {ثم عبس} قبض وجهه وكلحه ضيقا بما يقول {وبسر} زاد في القبض والكلوح(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P776(@)(@@) {ثم أدبر} عن الإيمان {واستكبر} تكبر عن اتباع النبي صلى الله عليه وسلم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P776(@)(@@) {فقال} فيما جاء به {إن} ما {هذا إلا سحر يؤثر} ينقل عن السحرة(@)(@@) PageV01P776(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P777(@)(@@) {إن} ما {هذا إلا قول البشر} كما قالوا إنما يعلمه بشر(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P777(@)(@@) {سأصليه} أدخله {سقر} جهنم(@)(@@)(@@)(@@) | 2 
ms609	 - (@)(@@) PageV01P777(@)(@@) {وما أدراك ما سقر} تعظيم لشأنها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P777(@)(@@) {لا تبقي ولا تذر} شيئا من لحم ولا عصب إلا أهلكته ثم يعود كما كان(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P777(@)(@@) {لواحة للبشر} محرقة لظاهر الجلد(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {عليها تسعة عشر} ملكا خزنتها قال بعض الكفار وكان قويا شديد البأس أنا أكفيكم سبعة عشر واكفوني أنتم اثنين قال تعالى(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {وما جعلنا أصحاب النار إلا ملائكة} أي فلا يطاقون كما يتوهمون {وما جعلنا عدتهم} ذلك {إلا فتنة} ضلالا {للذين كفروا} بأن يقولوا لم كانوا تسعة عشر {ليستيقن} ليستبين {الذين أوتوا الكتاب} أي اليهود صدق النبي صلى الله عليه وسلم في كونهم تسعة عشر الموافق لما في كتابهم {ويزداد الذين آمنوا} من أهل الكتاب {إيمانا} تصديقا لموافقته ما أتى به النبي صلى الله عليه وسلم لما في كتابهم {ولا يرتاب الذين أوتوا الكتاب والمؤمنون} من غيرهم في عدد الملائكة {وليقول الذين في قلوبهم مرض} شك بالمدينة {والكافرون} بمكة {ماذا أراد الله بهذا} العدد {مثلا} سموه لغرابته بذلك وأعرب حالا {كذلك} أي مثل إضلال منكر هذا العدد وهدى مصدقه {يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك} أي الملائكة في قوتهم وأعوانهم {إلا هو وما هي} أي سقر {إلا ذكرى للبشر}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {كلا} استفتاح بمعنى ألا {والقمر}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {والليل إذا} بفتح الذال {دبر} جاء بعد النهار وفي قراءة إذ أدبر بسكون الذال بعدها همزة أي مضى(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {والصبح إذا أسفر} ظهر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {إنها} أي سقر {لإحدى الكبر} البلايا العظام(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {نذيرا} حال من إحدى وذكر لأنها بمعنى العذاب {للبشر}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {لمن شاء منكم} بدل من البشر {أن يتقدم} إلى الخير أو الجنة بالإيمان {أو يتأخر} إلى الشر أو النار بالكفر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {كل نفس بما كسبت رهينة} مرهونة مأخوذة بعملها في النار(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P777(@)(@@) {إلا أصحاب اليمين} وهم المؤمنون فناجون منها كائنون(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P777(@)(@@) {في جنات يتساءلون} بينهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P777(@)(@@) {عن المجرمين} وحالهم ويقولون لهم بعد إخراج الموحدين من النار(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P777(@)(@@) {ما سلككم} أدخلكم {في سقر(@)(@@) PageV01P777(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P778(@)(@@) {قالوا لم نك من المصلين} 
ms610	(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P778(@)(@@) {ولم نك نطعم المسكين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P778(@)(@@) {وكنا نخوض} في الباطل {مع الخائضين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P778(@)(@@) {وكنا نكذب بيوم الدين} البعث والجزاء(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P778(@)(@@) {حتى أتانا اليقين} الموت(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P778(@)(@@) {فما تنفعهم شفاعة الشافعين} من الملائكة والأنبياء والصالحين والمعنى لا شفاعة لهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P778(@)(@@) {فما} مبتدأ {لهم} خبره متعلق بمحذوف انتقل ضميره إليه {عن التذكرة معرضين} حال من الضمير والمعنى أي شيء حصل لهم في إعراضهم عن الاتعاظ(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P778(@)(@@) {كأنهم حمر مستنفرة} وحشية(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P778(@)(@@) {فرت من قسورة} أسد أي هربت منه أشد الهرب(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P778(@)(@@) {بل يريد كل امرئ منهم أن يؤتى صحفا منشرة} أي من الله تعالى باتباع النبي كما قالوا لن نؤمن لك حتى تنزل علينا كتابا نقرؤه(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P778(@)(@@) {كلا} ردع عما أرادوه {بل لا يخافون الآخرة} أي عذابها(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P778(@)(@@) {كلا} استفتاح {إنه} أي القرآن {تذكرة} عظة(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P778(@)(@@) {فمن شاء ذكره} قرأه فاتعظ به(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P778(@)(@@) {وما يذكرون} بالياء والتاء {إلا أن يشاء الله هو أهل التقوى} بأن يتقى {وأهل المغفرة} بأن يغفر لمن اتقاه = 75 سورة(@)(@@)(@@)(@@) | القيامة(@)(@@) PageV01P778(@)(@@) {لا} زائدة في الموضعين {أقسم بيوم(@)(@@)(@@)(@@) | القيامة(@)(@@) PageV01P778(@)(@@) {ولا أقسم بالنفس اللوامة} التي تلوم نفسها وإن اجتهدت في الإحسان وجواب القسم محذوف أي لتبعثن دل عليه(@)(@@) PageV01P779(@)(@@) {أيحسب الإنسان} أي الكافر {ألن نجمع عظامه} للبعث والإحياء(@)(@@) PageV01P779(@)(@@) {بلى} نجمعها {قادرين} مع جمعها {على أن نسوي بنانه} وهو الأصابع أي نعيد عظامها كما كانت مع صغرها فكيف بالكبيرة(@)(@@) PageV01P779(@)(@@) {بل يريد الإنسان ليفجر} اللام زائدة ونصبه بأن مقدرة أي أن يكذب {أمامه} أي يوم القيامة دل عليه(@)(@@) PageV01P779(@)(@@) {يسأل أيان} متى {يوم القيامة} سؤال استهزاء وتكذيب(@)(@@) PageV01P779(@)(@@) {فإذا برق البصر} بكسر الراء وفتحها دهش وتحير لما رأى مما كان يكذبه(@)(@@) PageV01P779(@)(@@) {وخسف القمر} أظلم وذهب ضوؤه(@)(@@) PageV01P779(@)(@@) {وجمع الشمس والقمر} فطلعا من المغرب أو ذهب ضوؤهما وذلك في يوم القيامة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {يقول الإنسان يومئذ أين المفر} الفرار(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {كلا} ردع عن طلب الفرار {لا وزر} لا ملجأ يتحصن به(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {إلى ربك يومئذ المستقر} مستقر الخلائق فيحاسبون ويجازون(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {ينبأ الإنسان يومئذ بما قدم وأخر} بأول عمله 
ms611	 وآخره(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {بل الإنسان على نفسه بصيرة} شاهد تنطلق جوارحه بعمله والهاء للمبالغة فلا بد من جزائه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {ولو ألقى معاذيره} جمع معذرة على غير قياس أي لو جاء بكل معذرة ما قبلت منه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) تعالى لنبيه {لا تحرك به} بالقرآن قبل فراغ جبريل منه {لسانك لتعجل به} خوف أن ينفلت منك(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {إن علينا جمعه} في صدرك {وقرآنه} قراءتك إياه أي جريانه على لسانك(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {فإذا قرأناه} عليك بقراءة جبريل {فاتبع قرآنه} استمع قراءته فكان صلى الله عليه وسلم يستمع ثم يقرؤه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P779(@)(@@) {ثم إن علينا بيانه} بالتفهيم لك والمناسبة بين هذه الآية وما قبلها أن تلك تضمنت الإعراض عن آيات الله وهذه تضمنت المبادرة إليها بحفظها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P779(@)(@@) {كلا} استفتاح بمعنى ألا {بل تحبون العاجلة} الدنيا بالياء والتاء في الفعلين(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P779(@)(@@) {وتذرون الآخرة} فلا يعملون لها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P779(@)(@@) {وجوه يومئذ} أي في يوم القيامة {ناضرة} حسنة مضيئة(@)(@@) PageV01P779(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P780(@)(@@) {إلى ربها ناظرة} أي يرون الله سبحانه وتعالى في الآخرة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P780(@)(@@) {ووجوه يومئذ باسرة} كالحة شديدة العبوس(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P780(@)(@@) {تظن} توقن {أن يفعل بها فاقرة} داهية عظيمة تكسر فقار الظهر(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P780(@)(@@) {كلا} بمعنى إلا {إلا بلغت} النفس {التراقي} عظام الحلق(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P780(@)(@@) {وقيل} قال من حوله {من راق} يرقيه ليشفى(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P780(@)(@@) {وظن} أيقن من بلغت نفسه ذلك {أنه الفراق} فراق الدنيا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P780(@)(@@) {والتفت الساق بالساق} أي إحدى ساقيه بالأخرى عند الموت أو التفت شدة فراق الدنيا بشدة إقبال الآخرة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {إلى ربك يومئذ المساق} أي السوق وهذا يدل على العامل في إذا والمعنى إذا بلغت النفس الحلقوم تساق إلى حكم ربها(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {فلا صدق} الإنسان {ولا صلى} أي لم يصدق ولم يصل(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {ولكن كذب} بالقرآن {وتولى} عن الإيمان(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {ثم ذهب إلى أهله يتمطى} يتبختر في مشيته إعجابا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {أولى لك} فيه التفات عن الغيبة والكلمة اسم فعل واللام للتبيين أي وليك ما تكره {فأولى} أي فهو أولى بك من غيرك(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {ثم أولى لك فأولى} تأكيد(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {أيحسب} يظن {الإنسان أن يترك 
ms612	 سدى} هملا لا يكلف بالشرائع لا يحسب ذلك(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {ألم يك} أي كان {نطفة من مني يمنى} بالياء والتاء تصب في الرحم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {ثم كان} المني {علقة فخلق} الله منها الإنسان {فسوى} عدل أعضاءه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P780(@)(@@) {فجعل منه} من المني الذي صار علقة قطعة دم ثم مضغة أي قطعة لحم {الزوجين} النوعين {الذكر والأنثى} يجتمعان تارة وينفرد كل منهما عن الآخر تارة(@)(@@) PageV01P780(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P781(@)(@@) {أليس ذلك} الفعال لهذه الأشياء {بقادر على أن يحيي الموتى} قال صلى الله عليه وسلم بلى = 76 سورة(@)(@@)(@@)(@@) | الإنسان(@)(@@) PageV01P781(@)(@@) {هل} قد {أتى على(@)(@@)(@@)(@@) | الإنسان(@)(@@) } آدم {حين من الدهر} أربعون سنة {لم يكن} فيه {شيئا مذكورا} كان فيه مصورا من طين لا يذكر أو المراد بالإنسان الجنس وبالحين مدة الحمل(@)(@@) PageV01P781(@)(@@) {إنا خلقنا الإنسان} الجنس {من نطفة أمشاج} أخلاط أي من ماء الرجل وماء المرأة المختلطين الممتزجين {نبتليه} نختبره بالتكليف والجملة مستأنفة أو حال مقدرة أي مريدين ابتلاءه حين تأهله {فجعلناه} بسبب ذلك {سميعا بصيرا}(@)(@@) PageV01P781(@)(@@) {إنا هديناه السبيل} بينا له طريق الهدى ببعث الرسل {إما شاكرا} أي مؤمنا {وإما كفورا} حالان من المفعول أي بينا له في حال شكره أو كفره المقدرة وإما لتفصيل الأحوال(@)(@@) PageV01P781(@)(@@) {إنا أعتدنا} هيأنا {للكافرين سلاسل} يسحبون بها في النار {وأغلالا} في أعناقهم تشد فيها السلاسل {وسعيرا} نارا مسعرة أي مهيجة يعذبون بها(@)(@@) PageV01P781(@)(@@) {إن الأبرار} جمع بر أو بار وهم المطيعون {يشربون من كأس} هو إناء شرب الخمر وهي فيه والمراد من خمر تسمية للحال باسم المحل ومن للتبعيض {كان مزاجها} ما تمزج به {كافورا}(@)(@@) PageV01P781(@)(@@) {عينا} بدل من كافورا فيها رائحته {يشرب بها} منها {عباد الله} أولياؤه {يفجرونها تفجيرا} يقودونها حيث شاءوا من منازلهم(@)(@@) PageV01P781(@)(@@) {يوفون بالنذر} في طاعة الله {ويخافون يوما كان شره مستطيرا} منتشرا(@)(@@) PageV01P782(@)(@@) {ويطعمون الطعام على حبه} أي الطعام وشهوتهم له {مسكينا} فقيرا {ويتيما} لا أب له {وأسيرا} يعني المحبوس بحق(@)(@@) PageV01P782(@)(@@) {إنما نطعمكم لوجه الله} لطلب ثوابه {لا نريد منكم جزاء ولا شكورا} شكرا فيه علة الإطعام وهل تكلموا بذلك أو علمه الله منهم 
ms613	 فأثنى عليهم به قولان(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {إنا نخاف من ربنا يوما عبوسا} تكلح الوجوه فيه أي كريه المنظر لشدته {قمطريرا} شديدا في ذلك(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {فوقاهم الله شر ذلك اليوم ولقاهم} أعطاهم {نضرة} حسنا وإضاءة في وجوههم {وسرورا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {وجزاهم بما صبروا} بصبرهم عن المعصية {جنة} أدخلوها {وحريرا}(@)(@@) البسوه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {متكئين} حال من مرفوع أدخلوها المقدر {فيها على الأرائك} السرر في الحجال {لا يرون} لا يجدون حال ثانية {فيها شمسا ولا زمهريرا} لا حرا ولا بردا وقيل الزمهرير القمر فهي مضيئة من غير شمس ولا قمر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {ودانية} قريبة عطف على محل لا يرون أي غير رائين {عليهم} منهم {ظلالها} شجرها {وذللت قطوفها تذليلا} أدنيت ثمارها فينالها القائم والقاعد والمضطجع(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {ويطاف عليهم} فيها {بآنية من فضة وأكواب} أقداح بلا عرى {كانت قواريرا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {قوارير من فضة} أي أنها من فضة يرى باطنها من ظاهرها كالزجاج {قدروها} أي الطائفون {تقديرا} على قدر ري الشاربين من غير زيادة ولا نقص وذلك ألذ الشراب(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {ويسقون فيها كأسا} خمرا {كان مزاجها} ما تمزج به {زنجبيلا}(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {عينا} بدل من زنجبيلا {فيها تسمى سلسبيلا} يعنى أن ماءها كالزنجبيل الذى تستلذ به العرب سهل المساغ في الحلق(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P782(@)(@@) {ويطوف عليهم ولدان مخلدون} بصفة الولدان لا يشيبون {إذا رأيتهم حسبتهم} لحسنهم وانتشارهم في الخدمة {لؤلؤا منثورا} من سلكه أو من صدفه وهو أحسن منه في غير ذلك(@)(@@) PageV01P782(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {وإذا رأيت ثم} أي وجدت الرؤية منك في الجنة {رأيت} جواب إذا {نعيما} لا يوصف {وملكا كبيرا} واسعا لا غاية له(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {عاليهم} فوقهم فنصبه على الظرفية وهو خبر لمبتدأ بعد وفي قراءة بسكون الياء مبتدأ وما بعده خبر والضمير المتصل به للمعطوف عليهم {ثياب سندس} حرير {خضر} بالرفع {وإستبرق} بالجر ما غلظ من الديباج فهو البطائن والسندس الظهائر وفي قراءة عكس ما ذكر فيهما وفي أخرى برفعهما وفي أخرى بجرهما {وحلوا أساور من فضة} وفي موضع من ذهب للإيذان بأنهم يحلون من النوعين معا ومفرقا {وسقاهم ربهم شرابا 
ms614	 طهورا} مبالغة في طهارته ونظافته بخلاف خمر الدنيا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {إن هذا} النعيم {كان لكم جزاء وكان سعيكم مشكورا}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {إنا نحن} تأكيد لاسم إن أو فصل {نزلنا عليك القرآن تنزيلا} خبر إن أي فصلناه ولم ننزله جملة واحدة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {فاصبر لحكم ربك} عليك بتبليغ رسالته {ولا تطع منهم} أي الكفار {آثما أو كفورا} أي عتبة بن ربيعة والوليد بن المغيرة قالا للنبي صلى الله عليه وسلم ارجع عن هذا الأمر ويجوز أن يراد كل آثم وكافر أي لا تطع أحدهما أيا كان فيما دعاك إليه من إثم أو كفر(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {واذكر اسم ربك} في الصلاة {بكرة وأصيلا} يعني الفجر والظهر والعصر(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {ومن الليل فاسجد له} يعني المغرب والعشاء {وسبحه ليلا طويلا} صل التطوع فيه كما تقدم من ثلثيه أو نصفه أو ثلثه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {إن هؤلاء يحبون العاجلة} الدنيا {ويذرون وراءهم يوما ثقيلا} شديدا أي يوم القيامة لا يعملون له(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {نحن خلقناهم وشددنا} قوينا {أسرهم} أعضاءهم ومفاصلهم {وإذا شئنا بدلنا} جعلنا {أمثالهم} في الخلقة بدلا منهم بأن نهلكهم {تبديلا} تأكيد ووقعت إذا موقع إن نحو إن يشأ يذهبكم لأنه تعالى لم يشأ ذلك وإذا لما يقع(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P783(@)(@@) {إن هذه} السورة {تذكرة} عظة للخلق {فمن شاء اتخذ إلى ربه سبيلا} طريقا بالطاعة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P783(@)(@@) {وما تشاءون} بالتاء والياء اتخاذ السبيل بالطاعة {إلا أن يشاء الله} ذلك {إن الله كان عليما} بخلقه {حكيما} في فعله(@)(@@) PageV01P783(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P784(@)(@@) {يدخل من يشاء في رحمته} جنته وهم المؤمنون {والظالمين} ناصبه فعل مقدر أي أعد يفسر {أعد لهم عذابا أليما} مؤلما وهم الكافرون = 77 سورة(@)(@@)(@@)(@@) | المرسلات(@)(@@) PageV01P784(@)(@@) {و(@)(@@)(@@)(@@) | المرسلات (@)(@@) عرفا} أي الرياح متتابعة كعرف الفرس يتلو بعضه بعضا ونصبه على الحال(@)(@@) PageV01P784(@)(@@) {فالعاصفات عصفا} الرياح الشديدة(@)(@@) PageV01P784(@)(@@) {والناشرات نشرا} الرياح تنشر المطر(@)(@@) PageV01P784(@)(@@) {فالفارقات فرقا} أي آيات القرآن تفرق بين الحق والباطل والحلال والحرام(@)(@@) PageV01P784(@)(@@) {فالملقيات ذكرا} أي الملائكة تنزل بالوحي إلى الأنبياء والرسل يلقون الوحي إلى الأمم(@)(@@) PageV01P784(@)(@@) {عذرا أو نذرا} أي للإعذار والإنذار من الله تعالى وفي قراءة بضم ذال نذرا 
ms615	 وقرئ بضم ذال عذرا(@)(@@) PageV01P784(@)(@@) {إنما توعدون} أي يا كفار مكة من البعث والعذاب {لواقع} كائن لا محالة(@)(@@) PageV01P784(@)(@@) {فإذا النجوم طمست} محي نورها(@)(@@) PageV01P784(@)(@@) {وإذا السماء فرجت} شقت(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {وإذا الجبال نسفت} فتتت وسيرت(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {وإذا الرسل أقتت} بالواو وبالهمزة بدلا منها أي جمعت لوقت(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {لأي يوم} ليوم عظيم {أجلت} للشهادة على أممهم بالتبليغ(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {ليوم الفصل} بين الخلق ويؤخذ منه جواب إذا أي وقع الفصل بين الخلائق(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {وما أدراك ما يوم الفصل} تهويل لشأنه(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {ويل يومئذ للمكذبين} هذا وعيد لهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {ألم نهلك الأولين} بتكذيبهم أي أهلكناهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P784(@)(@@) {ثم نتبعهم الآخرين} ممن كذبوا ككفار مكة فنهلكهم(@)(@@) PageV01P784(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P785(@)(@@) {كذلك} مثل ما فعلنا بالمكذبين {نفعل بالمجرمين} بكل من أجرم فيما يستقبل فنهلكهم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P785(@)(@@) {ويل يومئذ للمكذبين} تأكيد(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {ألم نخلقكم من ماء مهين} ضعيف وهو المني(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {فجعلناه في قرار مكين} حريز وهو الرحم(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {إلى قدر معلوم} وهو وقت الولادة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {فقدرنا} على ذلك {فنعم القادرون} نحن(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {ويل يومئذ للمكذبين}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {ألم نجعل الأرض كفاتا} مصدر كفت بمعنى ضم أي ضامة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {أحياء} على ظهرها {وأمواتا} في بطنها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {وجعلنا فيها رواسي شامخات} جبالا مرتفعات {وأسقيناكم ماء فراتا} عذبا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {ويل يومئذ للمكذبين} ويقال للمكذبين يوم القيامة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P785(@)(@@) {انطلقوا إلى ما كنتم به} من العذاب {تكذبون}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {انطلقوا إلى ظل ذي ثلاث شعب} هو دخان جهنم إذا ارتفع افترق ثلاث فرق لعظمه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {لا ظليل} كنين يظلهم من حر ذلك اليوم {ولا يغني} يرد عنهم شيئا {من اللهب} النار(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {? إنها} أي النار {ترمي بشرر} هو ما تطاير منها {كالقصر} من البناء في عظمه وارتفاعه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {كأنه جمالات} جمع جمالت جمع جمل وفي قراءة جمالت {صفر} في هيئتها ولونها وفي الحديث شرار الناس أسود كالقير والعرب تسمي سود الإبل صفرا لشوب سوادها بصفرة فقيل صفر في الآية بمعنى سود لما ذكر وقيل لا والشرر جمع شرارة والقير القار(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {ويل يومئذ للمكذبين}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {هذا} أي يوم القيامة {يوم 
ms616	 لا ينطقون} فيه بشيء(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {ولا يؤذن لهم} في العذر {فيعتذرون} عطف على يؤذن من غير تسبب عنه فهو داخل في حيز النفي أي لا إذن فلا اعتذار(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {ويل يومئذ للمكذبين}(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P785(@)(@@) {هذا يوم الفصل جمعناكم} أيها المكذبون من هذه الأمة {والأولين} من المكذبين قبلكم فتحاسبون وتعذبون جميعا(@)(@@) PageV01P785(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P786(@)(@@) {فإن كان لكم كيد} حيلة في دفع العذاب عنكم {فكيدون} فافعلوها(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {ويل يومئذ للمكذبين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {إن المتقين في ظلال} أي تكاثف أشجار إذ لا شمس يظل من حرها {وعيون} نابعة من الماء(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {وفواكه مما يشتهون} فيه إعلام بأن المأكل والمشرب في الجنة بحسب شهواتهم بخلاف الدنيا فبحسب ما يجد الناس في الأغلب ويقال لهم(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {كلوا واشربوا هنيئا} حال أي متهنئين {بما كنتم تعملون} من الطاعة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {إنا كذلك} كما جزينا المتقين {نجزي المحسنين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {ويل يومئذ للمكذبين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {كلوا وتمتعوا} خطاب للكفار في الدنيا {قليلا} من الزمان وغايته إلى الموت وفي هذا تهديد لهم {إنكم مجرمون}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {ويل يومئذ للمكذبين}(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {وإذا قيل لهم اركعوا} صلوا {لا يركعون} لا يصلون(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P786(@)(@@) {ويل يومئذ للمكذبين}(@)(@@)(@@)(@@) | 5 - (@)(@@) PageV01P786(@)(@@) {فبأي حديث بعده} أي القرآن {يؤمنون} أي لا يمكن إيمانهم بغيره من كتب الله بعد تكذيبهم به لاشتماله على الإعجاز الذي لم يشتمل عليه غيره = 78 سورة(@)(@@)(@@)(@@) | النبأ(@)(@@) PageV01P786(@)(@@) {عم} عن أي شيء {يتساءلون} يسأل بعض قريش بعضا(@)(@@) PageV01P786(@)(@@) {عن النبإ العظيم} بيان لذلك الشيء والاستفهام لتفخيمه وهو ما جاء به النبي صلى الله عليه وسلم من القرآن المشتمل على البعث وغيره(@)(@@) PageV01P786(@)(@@) {الذي هم فيه مختلفون} فالمؤمنون يثبتونه والكافرون ينكرونه(@)(@@) PageV01P786(@)(@@) {كلا} ردع {سيعلمون} ما يحل بهم على إنكارهم له(@)(@@) PageV01P786(@)(@@) {ثم كلا سيعلمون} تأكيد وجيء فيه بثم للإيذان بأن الوعيد الثاني أشد من الأول ثم أومأ تعالى إلى القدرة على البعث فقال(@)(@@) PageV01P786(@)(@@) {ألم نجعل الأرض مهادا} فراشا كالمهد(@)(@@) PageV01P787(@)(@@) {والجبال أوتادا} تثبت بها الأرض كما تثبت الخيام بالأوتاد والاستفهام للتقرير(@)(@@) PageV01P787(@)(@@) {وخلقناكم أزواجا} ذكورا وإناثا(@)(@@) PageV01P787(@)(@@) {وجعلنا نومكم سباتا} راحة لأبدانكم(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {وجعلنا الليل لباسا} ساترا بسواده(@)(@@)(@@)(@@) | 1 
ms617	 - (@)(@@) PageV01P787(@)(@@) {وجعلنا النهار معاشا} وقتا للمعايش(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {وبنينا فوقكم سبعا} سبع سماوات {شدادا} جمع شديدة أي قوية محكمة لا يؤثر فيها مرور الزمان(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {وجعلنا سراجا} منيرا {وهاجا} وقادا يعني الشمس(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {وأنزلنا من المعصرات} السحابات التي حان لها أن تمطر كالمعصر الجارية التي دنت من الحيض {ماء ثجاجا} صبابا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {لنخرج به حبا} كالحنطة {ونباتا} كالتين(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {وجنات} بساتين {ألفافا} ملتفة جمع لفيف كشريف وأشراف(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {إن يوم الفصل} بين الخلائق {كان ميقاتا} وقتا للثواب والعقاب(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {يوم ينفخ في الصور} القرن بدل من يوم الفصل أو بيان له والنافخ إسرافيل {فتأتون} من قبوركم إلى الموقف {أفواجا} جماعات مختلفة(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P787(@)(@@) {وفتحت السماء} بالتشديد والتخفيف شققت لنزول الملائكة {فكانت أبوابا} ذات أبواب(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {وسيرت الجبال} ذهب بها عن أماكنها {فكانت سرابا} هباء أي مثله في خفة سيرها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {إن جهنم كانت مرصادا} راصدة أو مرصدة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {للطاغين} الكافرين فلا يتجاوزونها {مآبا} مرجعا لهم فيدخلونها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {لابثين} حال مقدرة أي مقدرا لبثهم {فيها أحقابا} دهورا لا نهاية لها جمع حقب بضم أوله(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {لا يذوقون فيها بردا} نوما فإنهم لا يذوقونه {ولا شرابا} ما يشرب تلذذا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {إلا} لكن {حميما} ماء حارا غاية الحرارة {وغساقا} بالتخفيف والتشديد ما يسيل عن صديد أهل النار فإنهم يذوقونه جوزوا بذلك(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {جزاء وفاقا} موافقا لعملهم فلا ذنب أعظم من الكفر ولا عذاب أعظم من النار(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P787(@)(@@) {إنهم كانوا لا يرجون} يخافون {حسابا} لإنكارهم البعث(@)(@@) PageV01P787(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P788(@)(@@) {وكذبوا بآياتنا} القرآن {كذابا} تكذيبا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P788(@)(@@) {وكل شيء} من الأعمال {أحصيناه} ضبطناه {كتابا} كتبا في اللوح المحفوظ لنجازي عليه ومن ذلك تكذيبهم بالقرآن(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {فذوقوا} أي فيقال لهم في الآخرة عند وقوع العذاب ذوقوا جزاءكم {فلن نزيدكم إلا عذابا} فوق عذابكم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {إن للمتقين مفازا} مكان فوز في الجنة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {حدائق} بساتين بدل من مفازا أو بيان له {وأعنابا} عطف على مفازا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {وكواعب} جواري تكعبت ثديهن جمع كاعب {أترابا} على سن واحد جمع ترب بكسر التاء وسكون الراء(@)(@@)(@@)(@@) | 3 
ms618	 - (@)(@@) PageV01P788(@)(@@) {وكأسا دهاقا} خمرا مالئة محالها وفي سورة القتال وأنهار من خمر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {لا يسمعون فيها} أي الجنة عند شرب الخمر وغيرها من الأحوال {لغوا} باطلا من القول {ولا كذابا} بالتخفيف أي كذبا وبالتشديد أي تكذيبا من واحد لغيره بخلاف ما يقع في الدنيا عند شرب الخمر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {جزاء من ربك} أي جزاهم الله بذلك جزاء {عطاء} بدل من جزاء {حسابا} أي كثيرا من قولهم أعطاني فأحسبني أي أكثر علي حتى قلت حسبي(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {رب السماوات والأرض} بالجر والرفع {وما بينهما الرحمن} كذلك وبرفعه مع جر رب {لا يملكون} أي الخلق {منه} تعالى {خطابا} أي لا يقدر أحد أن يخاطبه خوفا منه(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {يوم} ظرف ل لا يملكون {يقوم الروح} جبريل أو جند الله {والملائكة صفا} حال أي مصطفين {لا يتكلمون} أي الخلق {إلا من أذن له الرحمن} في الكلام {وقال} قولا {صوابا} من المؤمنين والملائكة كأن يشفعوا لمن ارتضى(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P788(@)(@@) {ذلك اليوم الحق} الثابت وقوعه وهو يوم القيامة {فمن شاء اتخذ إلى ربه مآبا} مرجعا أي رجع إلى الله بطاعته ليسلم من العذاب فيه(@)(@@) PageV01P788(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P789(@)(@@) {? إنا أنذرناكم} يا كفار مكة {عذابا قريبا} عذاب يوم القيامة الآتي وكل آت قريب {يوم} ظرف لعذابا بصفته {ينظر المرء} كل امرئ {ما قدمت يداه} من خير وشر {ويقول الكافر يا} حرف تنبيه {ليتني كنت ترابا} يعني فلا أعذب يقول ذلك عندما يقول الله تعالى للبهائم بعد الاقتصاص من بعضها لبعض كوني ترابا = 79 سورة(@)(@@)(@@)(@@) | النازعات(@)(@@) PageV01P789(@)(@@) {و(@)(@@)(@@)(@@) | النازعات} (@)(@@) الملائكة تنزع أرواح الكفار {غرقا} نزعا بشدة(@)(@@) PageV01P789(@)(@@) {والناشطات نشطا} الملائكة تنشط أرواح المؤمنين أي تسلها برفق(@)(@@) PageV01P789(@)(@@) {والسابحات سبحا} الملائكة تسبح من السماء بأمره تعالى أي تنزل(@)(@@) PageV01P789(@)(@@) {فالسابقات سبقا} الملائكة تسبق بأرواح المؤمنين إلى الجنة(@)(@@) PageV01P789(@)(@@) {فالمدبرات أمرا} الملائكة تدبر أمر الدنيا أي تنزل بتدبيره وجواب هذه الأقسام محذوف أي لتبعثن يا كفار مكة وهو عامل في(@)(@@) PageV01P789(@)(@@) {يوم ترجف الراجفة} النفخة الأولى بها يرجف كل شيء أي يتزلزل فوصفت بما يحدث منها(@)(@@) PageV01P789(@)(@@) {تتبعها الرادفة} النفخة الثانية وبينهما أربعون سنة 
ms619	 والجملة حال من الراجفة فاليوم واسع للنفختين وغيرهما فصح ظرفيته للبعث الواقع عقب الثانية(@)(@@) PageV01P789(@)(@@) {قلوب يومئذ واجفة} خائفة قلقة(@)(@@) PageV01P789(@)(@@) {أبصارها خاشعة} ذليلة لهول ما ترى(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P789(@)(@@) {يقولون} أي أرباب القلوب والأبصار استهزاء وإنكارا للبعث {أئنا} بتحقيق الهمزتين وتسهيل الثانية وإدخال ألف بينهما على الوجهين في الموضعين {لمردودون في الحافرة} أي أنرد بعد الموت إلى الحياة والحافرة اسم لأول الأمر ومنه رجع فلان في حافرته إذا رجع من حيث جاء(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P789(@)(@@) {أئذا كنا عظاما نخرة} وفي قراءة ناخرة بالية متفتتة نحيا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P789(@)(@@) {قالوا تلك} أي رجعتنا إلى الحياة {إذا} إن صحت {كرة} رجعة {خاسرة} ذات خسر إن قال تعالى(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P789(@)(@@) {فإنما هي} أي الرادفة التي يعقبها البعث {زجرة} نفخة {واحدة} فإذا نفخت(@)(@@) PageV01P789(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P790(@)(@@) {فإذا هم} أي كل الخلائق {بالساهرة} بوجه الأرض أحياء بعد ما كانوا ببطنها أمواتا(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P790(@)(@@) {هل أتاك} يا محمد {حديث موسى} عامل في(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P790(@)(@@) {إذ ناداه ربه بالواد المقدس طوى} اسم الوادي بالتنوين وتركه فقال(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P790(@)(@@) {اذهب إلى فرعون إنه طغى} تجاوز الحد في الكفر(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P790(@)(@@) {فقل هل لك} أدعوك {إلى أن تزكى} وفي قراءة بتشديد الزاي بإدغام التاء الثانية في الأصل فيها تتطهر من الشرك بأن تشهد أن لا إله إلا الله(@)(@@)(@@)(@@) | 1 - (@)(@@) PageV01P790(@)(@@) {وأهديك إلى ربك} أدلك على معرفته ببرهان {فتخشى} فتخافه(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {فأراه الآية الكبرى} من آياته السبع وهي اليد أو العصا(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {فكذب} فرعون موسى {وعصى} الله تعالى(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {ثم أدبر} عن الإيمان {يسعى} في الأرض بالفساد(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {فحشر} جمع السحرة وجنده {فنادى}(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {فقال أنا ربكم الأعلى} لا رب فوقي(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {فأخذه الله} أهلكه بالغرق {نكال} عقوبة {الآخرة} أي هذه الكلمة {والأولى} أي قوله قبلها ما علمت لكم من إله غيري وكان بينهما أربعون سنة(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {إن في ذلك} المذكور {لعبرة لمن يخشى} الله تعالى(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {أأنتم} بتحقيق الهمزتين وإبدال الثانية ألفا وتسهيلها وإدخال ألف بين المسهلة والأخرى وتركه أي منكرو البعث {أشد خلقا أم السماء} أشد خلقا {بناها} بيان لكيفية خلقها(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {رفع 
ms620	 سمكها} تفسير لكيفية البناء أي جعل سمتها في جهة العلو رفيعا وقيل سمكها سقفها {فسواها} جعلها مستوية بلا عيب(@)(@@)(@@)(@@) | 2 - (@)(@@) PageV01P790(@)(@@) {وأغطش ليلها} أظلمه {وأخرج ضحاها} أبرز نور شمسها وأضيف إليها الليل لأنه ظلها والشمس لأنها سراجها(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P790(@)(@@) {والأرض بعد ذلك دحاها} بسطها وكانت مخلوقة قبل السماء من غير دحو(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P790(@)(@@) {أخرج} حال بإضمار قد أي مخرجا {منها ماءها} بتفجير عيونها {ومرعاها} ما ترعاه النعم من الشجر والعشب وما يأكله الناس من الأقوات والثمار وإطلاق المرعى عليه استعارة(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P790(@)(@@) {والجبال أرساها} أثبتها على وجه الأرض لتسكن(@)(@@) PageV01P790(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P791(@)(@@) {متاعا} مفعول له لمقدر أي فعل ذلك متعة أو مصدر أي تمتيعا {لكم ولأنعامكم} جمع نعم وهي الإبل والبقر والغنم(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P791(@)(@@) {فإذا جاءت الطامة الكبرى} النفخة الثانية(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P791(@)(@@) {يوم يتذكر الإنسان} بدل من إذا {ما سعى} في الدنيا من خير وشر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P791(@)(@@) {وبرزت} أظهرت {الجحيم} النار المحرقة {لمن يرى} لكل راء وجواب إذا(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P791(@)(@@) {فأما من طغى} كفر(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P791(@)(@@) {وآثر الحياة الدنيا} باتباع الشهوات(@)(@@)(@@)(@@) | 3 - (@)(@@) PageV01P791(@)(@@) {فإن الجحيم هي المأوى} مأواه(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P791(@)(@@) {وأما من خاف مقام ربه} قيامه بين يديه {ونهى النفس} الأمارة {عن الهوى} المردي باتباع الشهوات(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P791(@)(@@) {فإن الجنة هي المأوى} وحاصل الجواب فالعاصي في النار والمطيع في الجنة(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P791(@)(@@) {يسألونك} أي كفار مكة {عن الساعة أيان مرساها} متى وقوعها وقيامها(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P791(@)(@@) {فيم} في أي شيء {أنت من ذكراها} أي ليس عندك علمها حتى تذكرها(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P791(@)(@@) {إلى ربك منتهاها} منتهى علمها لا يعلمه غيره(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P791(@)(@@) {إنما أنت منذر} إنما ينفع إنذارك {من يخشاها} يخافها(@)(@@)(@@)(@@) | 4 - (@)(@@) PageV01P791(@)(@@) {كأنهم يوم يرونها لم يلبثوا} في قبورهم {إلا عشية أو ضحاها} عشية يوم أو بكرته وصح إضافة الضحى إلى العشية لما بينهما من الملابسة إذ هما طرفا النهار وحسن الإضافة وقوع الكلمة فاصلة = 80 سورة(@)(@@)(@@)(@@) | عبس(@)(@@) PageV01P791(@)(@@)(@@)(@@) | {عبس} (@)(@@) النبي كلح وجهه {وتولى} أعرض لأجل(@)(@@) PageV01P791(@)(@@) {أن جاءه الأعمى} عبد الله بن أم مكتوم فقطعه عما هو مشغول به ممن يرجو إسلامه من أشراف قريش الذين هو حريص على إسلامهم ولم 