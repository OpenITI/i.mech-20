ms361	 ، يئن منه المفصل % 33(@)(@@) % غير المعاجل بالعقاب إذا هفا % % جرم ويسبق بالعطاء ويعجل % % 34(@)(@@) % ضرغام هيجاء كفاه بأنه % عند القواضب والقنا بي مشبل % 35(@)(@@) % نستعطف الأمر المولى بأسمه % % فيعود أو ندعوا العلاء فيقبل % % 36(@)(@@) % ولرب يوم قد ملأت فروجه % خيلا ، تدرع بالغبار وترقل % 37(@)(@@) % وفوارسا يتزاحمون على الردى % % نهلا وقد عز البرود السلسل % % 38(@)(@@) % من كل أروع ماجد في كفه % قلق هتوف بالمنون ومعول % 39(@)(@@) % ضربا كأشداق الهجان رواغيا % ووغى كما اضطرم الأباء المشعل % 40(@)(@@) % وعيون طعن كالعيون يمدها % % ماء مذانبه العروق الذبل % PageV01P1264 41(@)(@@) % من كل شوهاء الضلوع مثيرها % % متعوذ والناظر المتأمل % % 42(@)(@@) % شهاقة تدق النجيع ، وتنطوي % % فيها المسائل أو تضل الأنمل % % 43(@)(@@) % ينزو لها علق تمطق خلفه % أو عاند يلقى النواظر شلشل % 44(@)(@@) % ولديك أن طمح العدو صوارم % % تدمي عرانين العدا وتذلل % % 45(@)(@@) % كالنار ما يسألن غير ضريبة % والسيف أعلى من يجود ويسأل % 46(@)(@@) % يستبهم الأمر الفظيع ، فلا ترى % % إلا القواضب مطلعا يتقبل % % 47(@)(@@) % ما بين من يخشى المنية ، والذي % % يصلي بها في العمر إلا منزل % % 48(@)(@@) % لا تنظر الباغي لقربى ، وارمه % بالذل ، واقطع ما عليه يعول % 49(@)(@@) % هذا الأمين أدال منه شقيقه % ومضى عقيرا بابنه المتوكل % % 50(@)(@@) % والعفو مكرمة فإن أغرى بها % % متغافل قال الرجال مغفل % % PageV01P1265 51(@)(@@) % ولقد حضرت وأنت غائب نكبة % % فخلاك ما قال العدا وتقولوا % % 52(@)(@@) % لا يغررنك أنهم بسهامهم % % أشووا ، وما بلغوا مدى ما أملوا % % 53(@)(@@) % هيهات لم يرم العدو بسهمه % % وإن انزوى إلا ليدمى المقتل % % 54(@)(@@) % وأنا المضارب عن علاك بمقول % % ماضي الغرار ولا الجراز المصقل % % 55(@)(@@) % يدمي الجوارح وهو ساكن غمده % % ولقلما يمضي بغمد منصل % 56(@)(@@) % هيهات يلحق بالصميم مدرع % % أبدا ويزري بالبحار الجدول % % 57(@)(@@) % ما صارم كدر الذباب كصارم % خلع الجلاء على ظباه الصيقل % % 58(@)(@@) % وسماؤنا الظلماء يكتم شخصها % % أنى أضاء العارض المتهلل % % 59(@)(@@) % ليس التفرد بالعلاء طماعة % % إن العلى درج لمن يتوقل % 60(@)(@@) % نظم ونثر قد طمحت إليهما % % صعدا ويعنو للأخير الأول % % PageV01P1266 61(@)(@@) % وحديث فضلي ضارب بعروقه % في الأرض ينقله المطي 
ms362	 البزل % 62(@)(@@) % لولاك ما سمحت بقول همتي % % قدري أجل من القريض وأفضل % % 63(@)(@@) % هذا ، وفي بعض الذي امتلأت به % عني البلاد لقائل متعلل % % 64(@)(@@) % لما نظرت إلى علاك غريبة % % ومضيع راعي المناقب مهمل % 65(@)(@@) % أحرزتها متوغلا غاياتها % % والمجد ملء يد الذي يتوغل % 66(@)(@@) % في سيرة غراء تستضوى بها الدنيا ويلبسها الزمان الأطول % % دنيا ، ويلبسها الزمان الأطول % 67(@)(@@) % ملئت بفضلك ، فالولي مكثر % ما شاع عنها والعدو مقلل % % 68(@)(@@) % يفتن فيها القائلون كأنما % % طلعت كما طلع الكتاب المنزل % % 69(@)(@@) % هنأت جدك بالتحلق في العلى % % ولأنت نعم المقبل المتقبل % % 70(@)(@@) % وطرحت تهنئة بأيام أرى % % فيها سواء من يقل وينبل % PageV01P1267 71(@)(@@) % وأرى لحاظ الحاسدين مريبة % والغيظ بين ضلوعهم يتغلغل % % 72(@)(@@) % ما للزمان يعقني بعصابة % % تجفو علي من الزمان وتثقل % % 73(@)(@@) % يذوي على قدم الليالي عهدها % % مثل الأديم على التقادم ينغل % 74(@)(@@) % ود الحليم شفاء دائك كله % % وصداقة السفهاء داء معضل % % PageV01P1268 البحر : طويل 1(@)(@@) % إلى الله إني للعظيم حمول % كثير بنفسي ، والعديل قليل % 2(@)(@@) % ومن طعمه من سيفه كيف يتقي % % ومن يطلب العلياء كيف يقيل % % 3(@)(@@) % يقولون : خالل في البلاد ، وإنما % % خليلي من لا يطبيه خليل % % 4(@)(@@) % وليس طباع الناس وفقا وربما % % تفاضل فيهم أنفس وعقول % 5(@)(@@) % ولولا نفوس في الأقل عزيزة % % لغطى جميع العالمين خمول % 6(@)(@@) % فما تطلب الأيام من متغرب % له كل يوم رحلة ونزول % % 7(@)(@@) % رمى مقتل الدنيا بسهم قناعة % % فعز لأن غال الرمية غول % 8(@)(@@) % إلا إنما الدنيا إذا ما نظرتها % % بقلبك ، أم للبنين ثكول % 9(@)(@@) % وما يثقل الميت الصعيد ، وإنما % % على الحي عبء للزمان ثقيل % % 10(@)(@@) % وتختلف الأيام حتى ترى العلى % % عناء ويغدو ما يروق يهول % % PageV01P1269 11(@)(@@) % أقول لغر بالمنايا ودونه % لهن خيول جمة وحبول % % 12(@)(@@) % ستعطى يد العاني إذا ما دنا لها % % بغير وغى قرن ألد صؤول % 13(@)(@@) % فلا تعتصم بالبعد عنها ، فإنها % % مسرة نقي في العظام دمول % 14(@)(@@) % أرى شيبة في العارضين فيلتوي % % بقلبي حداها جوى وغليل % % 15(@)(@@) % ومن عجب غضي عن الشيب جازعا % وكري إذا لاقى الرعيل 
ms363	 رعيل % 16(@)(@@) % ولي نفس يطغى إذا ما رددته % % فيعرقني عرق المدى ، ويغول % 17(@)(@@) % وما تسع الأضلاع ريعان زفرة % % يكاد لها قلب الجليد يزول % 18(@)(@@) % وما ذاك من وجد خلا أن همة % عنائي بها في الواجدين طويل % % 19(@)(@@) % بكيت وكان الدمع شيبا مبيضا % عذاري ، لا جاري الغروب هطول % 20(@)(@@) % وشوكة ضغن ما انتقشت شباتها % % ذهابا بنفسي أن يقال عجول % PageV01P1270 21(@)(@@) % وإني إن أعط المدى متنفسا % نزعت أذاها ، والزمان يديل % 22(@)(@@) % وما أنا إلا الليث لو تعلمونه % % وذا الشعر البادي علي قبيل % 23(@)(@@) % وقد عصبت مني الليالي بساعد % % تئن الأعادي مرة وتنيل % 24(@)(@@) % إذا سطرت نهرا وراء بيوتها % % سطوت وما يعدى علي قبيل % % 25(@)(@@) % وزور المآقي من جديل وشدقم % تبلد عنها شدقم وجديل % 26(@)(@@) % شققنا بها قلب الظلام وفوقها % % رجال كأطراف الذوابل ميل % % 27(@)(@@) % وهبت لأصحابي شمال لطيفة % قريبة عهد بالحبيب بليل % 28(@)(@@) % ترانا إذا أنفاسنا مزجت بها % % نرنح في أكوارنا ونميل % % 29(@)(@@) % ولم أر نشوى للشمال عشية % % كأن الذي غال الرؤوس شمول % 30(@)(@@) % وبرق يعاطينا الجوى غير أنه % % به من عيون الناظرين نحول % PageV01P1271 31(@)(@@) % وليل مريض النجم من صحة الدجى % % نضونا ولألاء النصول دليل % % 32(@)(@@) % وأخضر مستور التراب بروضة % رعينا وقد لبى الرغاء صهيل % % 33(@)(@@) % وعدنا بها والليل ينفض طله % سقاط اللآلي والنسيم عليل % % 34(@)(@@) % إذا استوحشت آذانها من تنوفة % وحمحم وخد دائب وذميل % 35(@)(@@) % رمت بأناسي الحداق وراعها % % أبارق يعرضن الردى وهجول % % 36(@)(@@) % ولولا رجاء منك رقابها % % لما آب إلا ضالع وكليل % 37(@)(@@) % ودون رواق المجد منك ممنع % جزيل المعالي والعطاء جزيل % % 38(@)(@@) % مرير القوى لا يرأم الضيم أنفه % وأيدي العدا لا عليه نصول % % 39(@)(@@) % ينهنه بالأعداء وهو مصمم % % ويزجر بالعذال ، وهو منيل % 40(@)(@@) % فتى لا يرى الإحسان عبأ يجره % ولكنه لولا الآباء ذلول % % PageV01P1272 41(@)(@@) % أقر بحق المجد ، وهو مضيع % وعظم قدر الدين وهو ضئيل % % 42(@)(@@) % سرى طالبا ما يطلب الناس غيره % وما كل قرن في الرجال رجيل % 43(@)(@@) % فما آب حتى استفرغ المجد كله % شروب على غيظ العدو أكول 
ms364	 % 44(@)(@@) % أيرجى مداه بعد ما ضحكت به % % أمام المعالي ، غرة وحجول ؟ % 45(@)(@@) % أرى كل حي من فضالات سيفه % وها هوذا طاغي الغرار صقيل % % 46(@)(@@) % وكم غمرة يعلو الملجم ماؤها % % شققت ولو أن الدماء تسيل % % 47(@)(@@) % وهول يغيظ الحاسدين ركبته % % وحيد العلى ، والهائبون نزول % 48(@)(@@) % بطعنة مياس إلى الموت رمحه % % يروم العلى من غاية فيطول % 49(@)(@@) % فداك رجال للمنى في ديارهم % نحيب ، وللظن الجميل عويل % 50(@)(@@) % فواغر عمر الدهر لم يطعموا العلى % % إلا قل ما يعطى العلاء بخيل % % PageV01P1273 51(@)(@@) % أرادوك بالأمر الجليل وإنما % % يصادم بالأمر الجليل جليل % 52(@)(@@) % أألآن إن ألقيت ثني زمامها % % وعطل أغراض لها وجديل % % 53(@)(@@) % وإلا ليال أنت راكب ظهرها % % وأمر العلى جمعا إليك يؤل % % 54(@)(@@) % وطاغ وعاء الشربين ضلوعه % % وداء من الغل القديم دخيل % % 55(@)(@@) % رماك وبين العين والعين حاجز % % وقال وراء الغيب فيك وقيل % % 56(@)(@@) % فما زلت تستوفي مراميه ، والقوى % % تقطع ، والإقبال عنه يميل % 57(@)(@@) % إلى أن أطعت الله ثم رميته % % فلم تغض إلا والرمي قتيل % % 58(@)(@@) % كذلك أعداء الرجال وهذه % % لسائر من يطغى عليك سبيل % 59(@)(@@) % وتسمو سمو النار عزا وهمة % ويهوي هوي الأرض ، وهو ذليل % 60(@)(@@) % هنيئا لك العيد الجديد فإنه % % بيمنك وضاح الجبين جميل % PageV01P1274 61(@)(@@) % ولا زالت الأعياد هطلى رخية % يحييك منها زائر ونزيل % 62(@)(@@) % وساق عداك العاصفات وأقبلت % % عليك شمال لدنة وقبول % 63(@)(@@) % وقد تعقم الأفهام عن قول قائل % % فيوجز بعض القول وهو مطيل % % 64(@)(@@) % وما الفضل إلا ما أقول فراعة % % وباقي مقامات الأنام فضول % PageV01P1275 البحر : كامل تام 1(@)(@@) % من لي برعبلة من البزل % % ترمي إليك معاقد الرحل % 2(@)(@@) % عجلى الرواح كأنما لمحت % % فيكم غدير الجود من قبلي % % 3(@)(@@) % نغرتها ، والبدر مطلع % حتى استجاب لقائد الأفل % % 4(@)(@@) % كتبت سطورا من مناسمها % % فوق الأباطح والسرى يملي % % 5(@)(@@) % إني بها في السير مقترح % عجلا على الإقتاب والجدل % % 6(@)(@@) % إن الذي وخدت إليه فتى % % يبرا إلى أملي من البخل % 7(@)(@@) % لا تملك العرصات قعدته % وإن استقر ، ففي ذرى الإبل % 8(@)(@@) % لم يستمل بالذل جانبه % مذ 
ms365	 شد قبضته على النصل % % 9(@)(@@) % تنبيك نفحته إذا فغمت % % عن طيب مغرس ذلك الأصل % 10(@)(@@) % ولأنت مثل السيف في مضر % % عاذت بقائمة من الذل % % PageV01P1276 11(@)(@@) % وإذا هتفت بهم لنائبة % % جذبوا وراءك بالقنا الذبل % % 12(@)(@@) % لا يسلمون من اتقى بهم % قرع القنا ومواقع النبل % % 13(@)(@@) % عامي وعام المحل في بلد % % فاسحب إلي ذؤابة الوبل % 14(@)(@@) % واحصد قواي ، فإنني أبدا % بين القرائن مارج الحبل % PageV01P1277 البحر : طويل 1(@)(@@) % أراقب من طيف الحبيب وصالا % % ويأبى خيال أن يزور خيالا % % 2(@)(@@) % وهل أبقت الأشجان إلا ممثلا % تعاوده أيدي الضنا ، ومثالا % % 3(@)(@@) % ألم بنا ، والليل قد شاب رأسه % وقد ميل الغرب النجوم ومالا % % 4(@)(@@) % وإني أهتدي في مدلهم ظلامه % % يخوض بحارا ، أو يجوب رمالا % % 5(@)(@@) % تأوب من نحو الأحبة طاردا % رقادي ، وما أسدى إلي نوالا % % 6(@)(@@) % أوائل مس الغمض أجفان ناظري % % كما قارب القوم العطاش صلالا % % 7(@)(@@) % وما كان إلا عارضا من طماعة % أزال الكرى عن مقلتي وزالا % % 8(@)(@@) % سقى الله أظعانا أجزن على الحمى % % خفافا ، كأقواس النصال عجالا % % 9(@)(@@) % يغالبن أعناق الربى عجرفية % قراع رجال في اللقاء رجالا % % 10(@)(@@) % وجدت اصطباري دونهن سفاهة % وأبصرت رشدي بعدهن ضلالا % % PageV01P1278 11(@)(@@) % وما ضر من أمسى زمامي بكفه % على النأي لو أرخى لنا وأطالا % % 12(@)(@@) % تذكرت أيام القرينة ، والهوى % % يجدد أقرانا لنا وحبالا % % 13(@)(@@) % مضين بعيش لا يعدن بمثله % % وأعقبننا مر الزمان خيالا % % 14(@)(@@) % سلي عن فمي فصل الخطاب وعن يدي % % رماحا كحيات الرمال طوالا % % 15(@)(@@) % وبيضا تروى بالدماء متونها % % إذا ما لقين الدارعين نهالا % % 16(@)(@@) % فما لي أرضى بالقليل ضراعة % وأوسع دين المشرفي مطالا % % 17(@)(@@) % تريد الليالي أن تخف بمقودي % % وأي جواد لو أصاب مجالا % % 18(@)(@@) % سآخذها إما استلابا وفلتة % % وإما طرادا في الوغى وقتالا % % 19(@)(@@) % فإن أنا لم أركب إليها مخاطرا % وأعظم قولا دونها وقتالا % % 20(@)(@@) % فهذا حسامي لم أرق ذبابه % % مضاء ، وهذا ذابلي لم طالا % % PageV01P1279 21(@)(@@) % وأطلبها بالراقصات ، كأنما % % أثور منها ربربا ورئالا % % 22(@)(@@) % إذا أسقط السير العنيف نعالها % % من الأين أحذتها الدماء نعالا % % 23(@)(@@) % وكل 
ms366	 غضني ، إذا قلت قد ونى % % من الشد جلى في الغبار وجالا % % 24(@)(@@) % وأكبر همي أن أولاقي فاضلا % أصادف منه للغليل بلالا % % 25(@)(@@) % فدى لأبي الفتح الأفاضل إنه % يبر عليهم ، إن أرم ، وقالا % % 26(@)(@@) % إذا جرت الآداب جاء أمامها % % قريعا وجاء الطالبون إفالا % % 27(@)(@@) % فتى مستعاد القول حسنا ولم يكن % % يقول محالا أو يحيل مقالا % % 28(@)(@@) % ليقري أسماع الرجال فصاحة % ويورد أفهام العقول زلالا % % 29(@)(@@) % ويجري لنا عذبا نميرا ، وبعضهم % % إذا قال ، أجرى للمسامع آلا % % 30(@)(@@) % أسفهم إن ميز القوم خلة % % وأثقبهم ، يوم الجدال ، نصالا % % PageV01P1280 31(@)(@@) % وما كان إلا السيف أطلق غربه % % وزاد غراري مضربيه صقالا % % 32(@)(@@) % ولما رأيت الوفر دون محله % جزاء وقد أسدى يدا وأنالا % % 33(@)(@@) % بعثت له وفرا من الشعر باقيا % وكنزا من الحمد الجزيل ومالا % % 34(@)(@@) % فسم آخرا منه كوسمك أولا % وشن عليه رونقا وجمالا % 35(@)(@@) % ومثلك إن أولى الجميل أتمه % وإن بدأ الإحسان زاد ووالى % % PageV01P1281 البحر : متقارب تام 1(@)(@@) % أأبقى كذا أبدا مستقلا % يقلبني الدهر عزا وذلا ؟ % 2(@)(@@) % وأقنع بالدون فعل الذليل يخشى الأجل ويرضى الأقلا % % ل ، يخشى الأجل ويرضى الأقلا % 3(@)(@@) % وإني رأيت غني الأنام % % إذا لم يكن ذا علاء مقلا % % 4(@)(@@) % ومن دون ضيمي فناء الرماح % وبيض القواضب ذفا وفلا % % 5(@)(@@) % فلا زلت كلا على المقربات % % إلى أن أنال ذرى المجد كلا % 6(@)(@@) % إذا عز قلبك في دهره % % فما عذر وجهك في أن يذلا % % 7(@)(@@) % ألا فاجهد النفس في نيلها % % ولا ترقبن عسى أو لعلا % % 9(@)(@@) % وحل حبي العجز عن همة % % تؤد الأيانق شدا وحلا % % 11(@)(@@) % إلى حيث تومى إليك البنان % % وتصبح ثم الأعز المجلا % 12(@)(@@) % قليل المثال وخير البلاد % % حمى منزل لا أرى فيه مثلا % % PageV01P1282 15(@)(@@) % وتعلو المعالي إلى العاجزين % % ونحن نرى الذل أعلى وأغلى % % 16(@)(@@) % عدتك ، أبا الطيب ، العاديات % % 17(@)(@@) % فلم أر الأك من يصطفى % % ثناء ويرعى ذماما وإلا % % 19(@)(@@) % وحلت نداي جميع الورى % % غداة أعتقدتك عضدا وخلا % % 21(@)(@@) % ينام عن الخير نوم الضباع % وفي الشر يطلع سمعا أزلا % 22(@)(@@) % طويل اليدين 
ms367	 إلى المخزيات % % يمد إلى المجد باعا أشلا % % 23(@)(@@) % فتى أعلقته عنان الفخار % مكارم جاءت به المجد قبلا % % 24(@)(@@) % وأصبح حاسده خابطا % إذا كاد يهدى إلى المجد ضلا % 25(@)(@@) % أشم كعالية السمهري % % وهمته منه أغلا وأعلى % % 26(@)(@@) % ويجمع قلبا جريئا ، ووجها % أتم من البدر نورا وأملا % % PageV01P1283 27(@)(@@) % مضاء القضيب إذا ما انجلى % % وضوء الهلال ، إذا ما تجلى % % 28(@)(@@) % وقلب الشجاع حسام فإن % % حلا منظرا فحسام محلى % % 29(@)(@@) % يغيم يوم الندى المستهل % % ويقشع يوم الوغى المصمئلا % 30(@)(@@) % ويوسع مادحه بشره % فيوليه أضعاف ما كان أولى % % 31(@)(@@) % يشمر للروع عن ساقه % ويسحب للجود ذيلا رفلا % 32(@)(@@) % فيوما يعود بجد علي % ويوما يعود بقدح معلى % % 33(@)(@@) % ويلقى إليه عظيم الزمان % % من المأثرات الأجل الأجلا % % 34(@)(@@) % فيمسي لأسرارها حافظا % % ويغدو بأعبائها مستقلا % 35(@)(@@) % فدونكها كإضاة الغدير % أو السيف سل أو الروض طلا % 36(@)(@@) % ولولاك كانت كأمثالها % % تصان عن المدح عزا ونبلا % % PageV01P1284 37(@)(@@) % فقد كنت حصنت أبكارهن % % وعودتهن عن القوم عضلا % % PageV01P1285 البحر : رجز تام 1(@)(@@) % أتذكراني طلب الطوائل % أيقظتما مني غير غافل % % 2(@)(@@) % قوما ، فقد مللت من إقامتي % % والبيد أولى بين من المعاقل % % 3(@)(@@) % شنا بي الغارات كل ليلة % وعوداني طرد الهوامل % % 4(@)(@@) % وصيراني سببا إلى العلى % % إني عين البطل الحلاحل % % 5(@)(@@) % قد حشد الدهر علي كيده % وجاءت الأيام بالزلازل % % 6(@)(@@) % ومن عجيب ما أرى من صرفه % قد دميت من ناجذي أناملي % % 7(@)(@@) % توكس أحداث الليالي صفقتي % % لا در در الدهر من معامل % % 8(@)(@@) % لا خطر الجود على بالي ، ولا % % سقت يدي يوم الطعان ذابلي % % 9(@)(@@) % إن لم أقدها كأضاميم القطا % % أو بدد العقارب الشوائل % % 10(@)(@@) % طوامح الأبصار يهفو نقعها % % على طموح الناظرين بازل % % PageV01P1286 11(@)(@@) % مستصحبا إلى الوغى فوارسا % يستنزلون الموت بالعوامل % % 12(@)(@@) % تحتهم ضوامر كأنها % % أجادل تنهض بالأجادل % 13(@)(@@) % غر إذا سدت ثنيات الدجى % % طلعنها بالغرر السوائل % 14(@)(@@) % وذي حجول نافض سبيبه % عجبا ، على مثل المهاة الخاذل % 15(@)(@@) % ينقض لا تلحق من غباره % إلا بقايا فلق الجراول % 16(@)(@@) % يكرع في غرته من طولها % % ويتقي الجندل 
ms368	 بالجنادل % 17(@)(@@) % بمثله أبغي العلى ، وأغتدى % % أول نزال إلى النوازل % % 18(@)(@@) % وذي فلول مرهف ، نجاده % على لموع ذات ذيل ذائل % 19(@)(@@) % إن أمير المؤمنين والدي % % حز الرقاب بالقضاء الفاصل % 20(@)(@@) % وجدي النبي في آبائه % علا ذرى العلياء والكواهل % PageV01P1287 21(@)(@@) % فمن كأجدادي إذا نسبتني % % أم من كأحيائي أو قبائلي % % 22(@)(@@) % من هاشم أكرم من حج ، ومن % % جلل بيت الله بالوصائل % 23(@)(@@) % قوم لأيديهم على كل يد % % فضل سجال من ردى ونائل % % 24(@)(@@) % فوارس الغارات لا يطربهم % % إلا نوازي نغم الصواهل % 25(@)(@@) % بالسمر تختب ثعيلباتها % % مثل ذئاب الردهة العواسل % % 26(@)(@@) % والبيض قد طلعن من أغمادها % % للروع تعلو قمم القبائل % 27(@)(@@) % يخضبن إما من دماء مارق % أو من دماء العوذ والمطافل % % 28(@)(@@) % ذوو القباب الحمر ينضى سجفها % % عن عدد من سامر وجامل % 29(@)(@@) % أرى ملوكا كالبهام غفلة % % في مثل طيش النعم الجوافل % % 30(@)(@@) % أولى من الذود ، إذا جربتهم % برعي ذي الرياض والخمائل % % PageV01P1288 31(@)(@@) % إن أنا أعطيتهم مقادتي % % فلم إذا أطلق غربي صاقلي % % 32(@)(@@) % ومقولي كالسيف يحتمي به % % أشوس أباء على المقاول % 33(@)(@@) % ما لك ترضى أن يقال شاعر ؟ % بعدا لها من عدد الفضائل % 34(@)(@@) % كفاك ما أورق من أغصانه % وطال من أعلامه الأطاول % % 35(@)(@@) % فكم تكون ناظما وقائلا % وأنت غب القول غير فاعل % 36(@)(@@) % كم يقتضيني السيف عزمي ويدي % % تدفعه دفع الغريم الماطل % 37(@)(@@) % أأرهب القتل حذار ميتة % لا بد ألقاها بغير قاتل % 38(@)(@@) % قد غار قبلي الرمح في عنيبة % % تحت العوالي ، وكليب وائل % 39(@)(@@) % هبني شبيبا يوم طاحت عنقه % % عن حد مفتوق الغرار قاصل % % 40(@)(@@) % لما رأي الموت أو الذل انبرى % % إلى الردى مشمر الذلاذل % % PageV01P1289 41(@)(@@) % أو مصعبا لما دنا ميقاته % % وضرب المقدار بالحبائل % % 42(@)(@@) % حمى يمين الضيم إن يقوده % % وانقاد في حبل الردى المعاجل % 43(@)(@@) % فعل امرء رأي الخمول ذلة % فاختار أن يقبر غير خامل % % 44(@)(@@) % إن كان لا بد من الموت فمت % % تحت ظلال الأسل الذوابل % PageV01P1290 البحر : وافر تام 1(@)(@@) % لمن دمن بذي سلم وضال % بلين ، وكيف بالدمن البوالي ؟ % 2 
ms369	(@)(@@) % وقفت بهن لا أصغي لداع % ولا أرجو جوابا عن سؤالي % % 3(@)(@@) % أيا دار الألى درجت عليها % % حوايا المزن والحجج الخوالي % % 4(@)(@@) % فأي حيا بأرضك للغوادي % % وأي بلى بربعك لليالي % % 5(@)(@@) % وبين ذوائب العقدات ظبي % قصير الخطوفي المرط المذال % % 6(@)(@@) % ربيب إن أريغ إلى حديث % نوار أن أريد إلى وصال % % 7(@)(@@) % فهل لي والمطامع مرديات % دنو من لمى ذاك الغزال ؟ % 8(@)(@@) % لقد سلبت ظباء الدار لبي % % إلا ما للظباء بها ومالي % % 9(@)(@@) % تنغصني بأيام التلاقي % % معاجلتي بأيام الزيال % % 10(@)(@@) % تحيفني الصدود وكنت دهرا % اروع بالصدود فلا أبالي % % PageV01P1291 11(@)(@@) % وكيف أفيق لا جسدي بناء % عن البلوى ، ولا قلبي بسالي % % 12(@)(@@) % يرنحني إليك الشوق حتى % % أميل من اليمين إلى الشمال % % 13(@)(@@) % كما مال المعاقر عاودته % حميا الكأس حالا بعد حال % % 14(@)(@@) % ويأخذني لذكركم ارتياح % % كما نشط الأسير من العقال % % 15(@)(@@) % وأيسر ما ألاقي أن هما % يغصصني بذا الماء الزلال % % 16(@)(@@) % فلولا الشوق ما كثر التفاتي % % ولا زمت إلى طلل جمالي % % 17(@)(@@) % وإني لا أوامق ثم إني % % إذا وامقت يوما لا أقالي % % 18(@)(@@) % أنا ابن الفرع من أعلى نزار % ومن يزن الأسافل بالأعالي % % 19(@)(@@) % نماني كل ممتعض أبي % جرى طلق الجموح إلى المعالي % % 20(@)(@@) % من القوم الألى ملكوا رقاب الأ % % الأواخر واختلوا قمم الأوالي % % PageV01P1292 21(@)(@@) % إذا بسطوا الخطا سحبوا رقاق % % البرود على الرقاق من النعال % % 22(@)(@@) % وإن قسمت بيوت المجد حازوا % % فناء البيت ذي العمد الطوال % % 23(@)(@@) % وإنهم لأعنف بالمذاكي % % محاضرة وأقرع بالعوالي % % 24(@)(@@) % افظ من الأسود فإن أنالوا % % رأيت أرق من بيض الحجال % % 25(@)(@@) % يخف عليهم بذل الأيادي % % وقد أثقلن أعناق الرجال % 26(@)(@@) % بني عمي وعز على يميني % % من الضراء ما لقيت شمالي % % 27(@)(@@) % أعود على عقوقكم بحلمي % % إذا خطر العقوق لكم ببالي % % 28(@)(@@) % أروني من يقوم لكم مقامي % % أروني من يقول لكم مقالي % % 29(@)(@@) % ومن يحمي الحريم من الأعادي % % ومن يشفني من الداء العضال % % 30(@)(@@) % يشايح دونكم يوم المنايا % % ويرمي عنكم يوم النضال % PageV01P1293 31(@)(@@) % سأبلغ بالقلى والبعد عنكم % مبالغ ليس تبلغ بالألال 
ms370	 % 32(@)(@@) % فمن لا يستقيم على التصافي % % جدير أن يقوم بالتقالي % % 33(@)(@@) % وأحسب أن سينفعني انتصاري % % إذا ما عاد بالضرر احتمالي % % 34(@)(@@) % أكيدا بعد أن رفعت منارى % % وأرست في مقاعدها جبالي % % 35(@)(@@) % وشد المجد أطنابي إليه % % ومد على جوانبه حبالي % % 36(@)(@@) % وتم علاؤكم بي بعد نقص % تمام الحضرمية بالقبال % 37(@)(@@) % وما فضلي على قومي بخاف % كما فضل القريع على الأفال % % 38(@)(@@) % وإني إن لحقت أبي جلالا % فهذي النار من ذاك الذبال % 39(@)(@@) % وأين القطر إلا للغوادي % % وأين النور إلا للهلال % % 40(@)(@@) % أصون عن الرجال فضول قولي % % وأبذل للرجال فضول مالي % % PageV01P1294 41(@)(@@) % ورب قوارص نكتت جناني % % أشد علي من صرد النبال % 42(@)(@@) % صبرت لها ، ولم أردد مقالا % فكان جزاء قائلها فعالي % % 43(@)(@@) % وجاذبني على العلياء قوم % وما علموا بأن جميعها لي % % 44(@)(@@) % لئن نلت الكواكب في علاها % % لقد أبقيت فضلا من منالي % % 45(@)(@@) % حلفت بها كراكعة الحنايا % % خوابط للجنادل والرمال % 46(@)(@@) % مهدمة العرائك من وجاها % % تعاض من الغوارب بالرحال % 47(@)(@@) % إلى البلد الحرام معرضات % % لإجراء الطلى بدم حلال % 48(@)(@@) % ليعتسفن هذا الليل مني % % أشيعث ، عاب لمته الغوالي % % 49(@)(@@) % خفيف الحاذ يشغله سراه % % زمانا ، أن يفكر في الهزال % 50(@)(@@) % وممترق إلى العلياء حتى % % يجاوز مد غاية كل عال % PageV01P1295 51(@)(@@) % فإن أنا لم أقم فيها فقامت % % على قبري النوادب بالمآل % PageV01P1296 البحر : بسيط تام 1(@)(@@) % حب العلى شغل قلب ما له شغل % وآفة الصب فيه اللوم والعذل % % 2(@)(@@) % قالت ضنيت ، فقلت الشوق يجمعنا % % ويعرق الوجد ما لا تعرق العلل % 3(@)(@@) % وإن تحون جسمي ما علمت به % % فالرمح ينآد طورا ثم يعتدل % % 4(@)(@@) % كيف التخلص من عين لها علق % بالظاعنين ومن قلب به خبل % % 5(@)(@@) % ومن لوجدي أن يقتادني طمع % % إلى الحبيب ، وأن يعتاقني طلل % 6(@)(@@) % لا تبعدن مطايانا التي حملت % تلك الظعائن مرخاة لها الجدل % 7(@)(@@) % سير الدموع على آثارها عنق % % وسيرها الوخد والتبغيل والرمل % 8(@)(@@) % دون القباب عفاف في جلاببها % % والصون يحفظ ما لا تحفظ الكلل % 9(@)(@@) % فلا الحدوج يرى وجه المقيم بها % % ولا 
ms371	 تحس بصوت الظاعن الإبل % 10(@)(@@) % وفي البراقع غزلان مرببة % % يرميننا بعيون نبلها الكحل % PageV01P1297 11(@)(@@) % إذا الحسان حملن الحلي أسلحة % فإنما حليها الأجياد والمقل % 12(@)(@@) % ألا وصال سوى طيف يؤرقني % % ولا رسائل إلا البيض والأسل % 13(@)(@@) % وعادة الشوق عنددي غير غافلة % % قلب مروع ودمع واكف هطل % 14(@)(@@) % وللأسنة فيهم أعين نجل % ولا عناق ، ولا ضم ، ولا قبل % 15(@)(@@) % لا ناصر غير دمعي أن هم ظلموا % % والدمع عون لمن ضاقت به الحيل % 16(@)(@@) % والعذل أثقل محمول على أذن % وهو الخفيف على العذال إن عذلوا % % 17(@)(@@) % من لي ببارق وعد خلفه مطر % % وكيف لي بعتاب بعده خجل % 18(@)(@@) % النفس أدنى عدو أنت حاذره % % والقلب أعظم ما يبلى به الرجل % 19(@)(@@) % والحب ما خلصت منها لذاذته % % لا ما تكدره الأوجاع والعلل % % 20(@)(@@) % قد عود النوم عيني أن تفارقه % % وهون السير عندي الأينق الذلل % PageV01P1298 21(@)(@@) % فما تشبث بي دار ، ولا بلد % أنا الحسام وما تحظى به الخلل % % 22(@)(@@) % الليل أحمل ظهر أنت راكبه % إن الصباح لطرف والدجا جمل % % 23(@)(@@) % ولى الشباب وهذا الشيب يطرده % % يفدي الطريدة ذاك الطارد العجل % 24(@)(@@) % ما نازل الشيب في راسي بمرتحل % % عني ، وأعلم أني عنه مرتحل % 25(@)(@@) % من لم يعظه بياض الشعر أدركه % في غرة حتفه المقدور والأجل % 26(@)(@@) % من أخطأته سهام الموت قيده % % طول السنين فلا لهو ولا جذل % % 27(@)(@@) % وضاق من نفسه ما كان متسعا % حتى الرجاء ، وحتى العزم والأمل % 28(@)(@@) % ما عفتي في الهوى يوما بمانعتي % % أن لا تعف بكفي القنا الذبل % % 29(@)(@@) % وللرجال أحاديث ، فأحسنها % % ما نمق الجود لا ما نمق البخل % % 30(@)(@@) % ولا اقتحامي على الغارات يعصمني % % من المنون ، ولا ريث ، ولا عجل % PageV01P1299 31(@)(@@) % وميتتي في النوى والقرب واحدة % إذا تكافأت الغايات والسبل % 32(@)(@@) % يستشعر الطرف زهوا يوم أركبه % % كأنه بنجوم الليل منتعل % 33(@)(@@) % والخيل عالمة ما فوق أظهرها % % من الرجال جبان كان أو بطل % % 34(@)(@@) % أغر أدهم صبغ الليل صبغته % % تضل في خلقه الألحاظ والمقل % 35(@)(@@) % مناقل في عنان الريح جريته % كأنه قبس أو 
ms372	 بارق عمل % % 36(@)(@@) % قصير ما بين أولاه وآخره % % كأنما العنق معقود بها الكفل % % 37(@)(@@) % إذا الربيع كسا البيداء بردته % ضاقت ركابي وهاد الأرض والقلل % % 38(@)(@@) % والواردات مياه القاع سانحة % على جوانبها الحوذان والنفل % 39(@)(@@) % وكالثغور أقاحيها ، إذا غربت % شمس النهار والقت صبغها الأصل % % 40(@)(@@) % ورد ومرعى إذا شاءت مشافرها % % مستجمعان ولا كد ولا عمل % % PageV01P1300 41(@)(@@) % وغافلين عن العلياء قائدهم % في كل غي فتي العقل مكتهل % % 42(@)(@@) % شنوا الخضاب حذارا أن يطالبهم % بحلمه الشيب أو يقصيهم الغزل % % 43(@)(@@) % عارين إلا من الفحشاء يسترهم % ثوب الخمول وتنبو عنهم الحلل % % 44(@)(@@) % قوم بأسماعهم عن منطقي صمم % وفي لواحظهم عن منظري قبل % 45(@)(@@) % يبددون إذا أقبلت لحظهم % % شرب المروع لا عل ، ولا نهل % 46(@)(@@) % يبدون ودي ويحموني ثراءهم % لو كان حقا تساوت بيننا الدول % 47(@)(@@) % كفى حسودي كبتا أنه رجل % % أغرى به الهم مذ أغرى بي الجذل % % 48(@)(@@) % ما بال شعري ملوما لا يجانبه % عن كل ما يقتضيه القول والعمل % % 49(@)(@@) % لا حاجة بي إلى مال يعبدني % % له الرجاء ، ويضنيني به الشغل % 50(@)(@@) % حسبي غنى نفسي الباقي وكل غنى % % من المغانم والأموال ينتقل % % PageV01P1301 51(@)(@@) % تغير الناس في سمع وفي نظر % % واستحسن الغدر حتى استقبح الخلل % 52(@)(@@) % فما طلابك إنسانا تصاحبه % كل الأنام كما لا تشتهى همل % % 53(@)(@@) % يستبشرون ، إذا صحت جسومهم % وبالعقول إذا فتشتها علل % % 54(@)(@@) % ما هيجتني العدا ، إلا وكنت لها % % سماء كل جواد أرضه القلل % % 55(@)(@@) % يمشي الحسام بكفي في رؤوسهم % ويخرق الرمح ما تعيا به الفتل % 56(@)(@@) % قومي هم الناس لا جيل سواسية % % الجود عندهم عار إذا سئلوا % % 57(@)(@@) % أبي الوصي وأمي خير والدة % % بنت الرسول الذي ما بعده رسل % 58(@)(@@) % وأين قوم كقومي إن سألتهم % % سوابق الخيل في يوم الوغى نزلوا % % 59(@)(@@) % كالصخر إن حلموا والنار إن غضبوا % % والأسد إن ركبوا والوبل إن بذلوا % % 60(@)(@@) % الطاعنين من الجبار مقتله % % والضاربين ، وذيل النقع منسدل % PageV01P1302 61(@)(@@) % والراكبين المطايا والجياد معا % لا الشكل تحسبها يوما ولا العقل % % 62(@)(@@) % تغضي عيون الأعادي عن رماحهم 
ms373	 % % وللأسنة فيهم يمضي به الأجل % % 63(@)(@@) % والله أكرم مولى أنت آمله % يوما وأعظم من يعطى ومن يسل % % 64(@)(@@) % عفو ، وحلم ، ونعماء ، ومقدرة % ومستجيب ومعطاء ومحتمل % % 65(@)(@@) % وكيف نأمل أن تبقى الحياة لنا % % وغير راجعة أيامنا الأول % PageV01P1303 البحر : كامل تام 1(@)(@@) % قلق العدو ، وقد حظيت برتبة % تعلو عن النظراء والأمثال % % 2(@)(@@) % لو كنت أقنع بالنقابة وحدها % % لغضضت حين بلغتها آمالي % % 3(@)(@@) % لكن لي نفس تتوق إلى التي % % ما بعد أعلاها مقام عال % 4(@)(@@) % قالوا حجرت على نداك وطالما % % أرغمت فيه معاطس العذال % 5(@)(@@) % هيهات قل الحامدون وصار من % أحبوه يحسدني على أموالي % % 6(@)(@@) % من لي بمن تزكو الصنائع عنده % % حتى أشاطره كرائم مالي % % PageV01P1304 البحر : طويل 1(@)(@@) % أمل من مثانيها ، فهذا مقيلها % % وهذي مغاني دارهم وطلولها % % 2(@)(@@) % حرام على عيني تجاوز أرضها % % ولم يرو أظماء الديار همولها % % 3(@)(@@) % وقد خالطت ذاك الثرى نفحاتها % % وجرت على ذاك الصعيد ذيولها % % 4(@)(@@) % حفوف رمال ما يخاف انهيالها % % وأغصان بان ما يخاف ذبولها % % 5(@)(@@) % وثم جياد ما يفل رعيلها % % فأعذرها فيمن يحب عذولها % % 6(@)(@@) % رضينا ولم نسمح من النيل بالرضا % % ولكن كثير لو علمنا قليلها % % 7(@)(@@) % شموس قباب قد رأينا شروقها % % فيا ليت شعري أين منا أفولها % % 8(@)(@@) % تعالين عن بطن العقيق تيامنا % يقومها قصد السرى ويميلها % % 9(@)(@@) % فهل من معيري نظرة فأريكها % % شريقي نجد يوم زالت حمولها % % 10(@)(@@) % كطامية التيار يجري سفينها % % PageV01P1305 11(@)(@@) % ولم تر إلا ممسكا بيمينه % % رواجف صدر ما يبل غليلها % % 12(@)(@@) % ومختنقا من عبرة ما تزوله % % ومختبطا في لوعة ما يزولها % % 13(@)(@@) % محا بعدكم تلك العيون بكاؤها % % وغال بكم تلك الأضالع غولها % % 14(@)(@@) % فمن ناظر لم تبق إلا دموعه % % ومن مهجة لم يبق إلا غليلها % % 15(@)(@@) % دعوا لي قلبا بالغرام أذيبه % % عليكم ، وعينا في الطلول أجيلها % % 16(@)(@@) % سقاها الرباب الجون كل غمامة % يهش لها حزن الملا وسهولها % % 17(@)(@@) % إذا ملكت ريح الجنوب عنانها % % أحالت عليها بعد لأي قبولها % % 18(@)(@@) % وساق إليها مثقلات عشاره % ضوامر ترغو بالضريب فحولها % % 19(@)(@@) % نجائب لا يؤدي بإخفافها 
ms374	 السرى % % وإن طال بالبيد القواء ذميلها % % 20(@)(@@) % فكم نفحة من أرضها بردت حشى % % وبل غليلا من فؤاد بليلها % % PageV01P1306 21(@)(@@) % تخطى الرياح الهوج أعناق رملها % % فتجبرها جبر القرا ، وتهيلها % % 22(@)(@@) % منازل لا يعطي القياد مقيمها % % مغالبة ، ولا يهان نزيلها % % 23(@)(@@) % خليلي قد خف الهوى وتراجعت % إلى الحلم نفس لا يعز مذيلها % % 24(@)(@@) % فلست ابن أم الخيل أن لم أمل بها % % عوابس في دار العدو أبيلها % % 25(@)(@@) % إذا انجفلت من غمرة ثاب كرها % % وعاد إلى مر المنايا جفولها % % 26(@)(@@) % يزعفر من عض الشكيم لعابها % % ويرعد من قرع العوالي خصيلها % % 27(@)(@@) % وأعطف عن خوض الدماء رؤوسها % % فقد فقدت أوضاحها وحجولها % % 28(@)(@@) % % إلى كل بيداء يرم دليلها % % 29(@)(@@) % توقر من عنف السياط مراحها % % وغاض على طول القياد صهيلها % % 30(@)(@@) % ونحن القروم الصيدان جاش بأسها % % تنودر مرعى ذودها ومقيلها % % PageV01P1307 31(@)(@@) % بأيماننا بيض الغروب خفائف % % نغول بها هام المعدا وتغولها % % 32(@)(@@) % تفللن حتى كاد من طول وقعها % % بيوم الوغى يقضي عليها فلولها % % 33(@)(@@) % قوائم قد جربن كل مجرب % بضرب الطلى حتى تفانت نصولها % % 34(@)(@@) % وأودية بين العراق وحاجر % % ببيض المواضي والعوالي نسيلها % % 35(@)(@@) % يمد بدفاع الدماء غثاؤها % % ويجري بأعناق الرجال حميلها % % 36(@)(@@) % إذا هاشم العلياء عب عبابها % % وسالت بأطناب البيوت سيولها % % 37(@)(@@) % مدفعة تحت الرحال ركابها % % محفزة تحت اللبود خيولها % % 38(@)(@@) % وكل مثنات النسوع مطارة % % سواء عليها حلها ورحيلها % % 39(@)(@@) % كأن على متن الظليم قتودها % % وفي يد علوي الرياح جديلها % % 40(@)(@@) % رأيت المساعي كلها وتلاحقت % فروع العلى مجموعة وأصولها % % PageV01P1308 41(@)(@@) % إذا استبقت يوما تراخى تبيعها % % وخلى لها الشأو البعيد رسيلها % % 42(@)(@@) % وإما أمالت للطعان رماحها % % وشن عليها للقاء شليلها % % 43(@)(@@) % فثم عوال ما ترد صدورها % % وثم جياد ما يغل رعيلها % % 44(@)(@@) % وثم الحماة الذائدون عن الحمى % % عشية لا يحمي النساء بعولها % % 45(@)(@@) % أبي ما أبي لا تدعون نظيره % % رديف العلى من قبلكم وزميلها % % 46(@)(@@) % هو الحامل الأعباء كل مطيقها % % وعج عجيج الموقرات حمولها % % 47(@)(@@) % طويل نجاد يحتبي في عصابة % فيفرعها مستعليا ، ويطولها % % 48(@)(@@) % إذا صال قلنا 
ms375	 : أجمع الليث وثبة % وإن جاد قلنا : مد من مصر نيلها % % 49(@)(@@) % حليم إذا التفت عليه عشيرة % % تطاطا له شبانها وكهولها % % 50(@)(@@) % وإن نعرة يوما أمالت رؤوسها % % أقام على نهج الهدى يستميلها % % PageV01P1309 51(@)(@@) % وانظرها حتى تعود حلومها % % وأمهلها حتى تثوب عقولها % % 52(@)(@@) % ولم يطوها بالحلم فضل زمامها % % فتعثر فيه عثرة لا يقيلها % % 53(@)(@@) % فعن بأسه المرهوب يرمى عدوها % % ومن ماله المبذول يودى قتيلها % % 54(@)(@@) % أكابرنا والسابقون إلى العلى % % ألا تلك آساد ونحن شبولها % % 55(@)(@@) % وإن أسودا كنت شبلا لبعضها % % لمحقوقة أن لا يذل قتيلها % % PageV01P1310 البحر : خفيف تام 1(@)(@@) % راحل أنت ، والليالي نزول % ومضر بك البقاء الطويل % 2(@)(@@) % لا شجاع يبقى فيعتنق ال % % بيض ، ولا آمل ، ولا مأمول % 3(@)(@@) % غاية الناس في الزمان فناء % وكذا غاية الغصون الذبول % % 4(@)(@@) % إنما المرء للمنية مخبوء % % وللطعن تستجم الخيول % % 5(@)(@@) % من مقيل بين الضلوع إلى طو % % ل عناء ، وفي التراب مقيل % 6(@)(@@) % فهو كالغيم ألفته جنوب % يوم دجن ومزقته قبول % % 7(@)(@@) % عادة للزمان في كل يوم % % يتناىء خل وتبكى طلول % % 8(@)(@@) % فالليالي عون عليك مع البي % بين كما ساعد الذوابل طول % % 9(@)(@@) % ربما وافق الفتى من زمان % فرح ، غيره به متبول % 10(@)(@@) % هي دنيا إن واصلت ذا جفت % % هذا ملالا كأنها عطبول % % PageV01P1311 11(@)(@@) % كل باك يبكى عليه وإن % % طال بقاء والثاكل المثكول % % 12(@)(@@) % والأماني حسرة وعناء % للذي ظن أنها تعليل % 13(@)(@@) % ما يبالي الحمام أين ترقى % % بعد ما غالت ابن فاطم غول % % 14(@)(@@) % أي يوم أدمى المدامع فيه % حادث رائع وخطب جليل % % 15(@)(@@) % يوم عاشوراء الذي لا أعان ال % % صحب فيه ولا أجار القبيل % % 16(@)(@@) % يا ابن بنت الرسول ضيعت % % العهد رجال والحافظون قليل % % 17(@)(@@) % ما أطاعوا النبي فيك ، وقد ما % % لت بأرماحهم إليك الذحول % 18(@)(@@) % وأحالوا على المقادير في حر % بك لو أن عذرهم مقبول % % 19(@)(@@) % واستقالوا من بعد ما أجلبوا في % % ها أالآن أيها المستقيل % 20(@)(@@) % إن أمرا قنعت من دونه السي % ن ، وولى ، ونحره مبلول % PageV01P1312 21(@)(@@) % يا حساما فلت مضاربه الها % % م 
ms376	 ، وقد فله الحسام الصقيل % 23(@)(@@) % يا جوادا أدمى الجواد من الطع % يوم يبدو طعن وتخفى حجول % % 24(@)(@@) % يوم طاحت أيدي السوابق في النق % ع وفاض الونى وغاض الصهيل % 25(@)(@@) % أتراني أعير وجهي صونا % وعلى وجهه تجول الخيول % 26(@)(@@) % أتراني ألذ ماء ، ولما % % يرو من مهجة الإمام الغليل % 27(@)(@@) % قبلته الرماح وانتصلت في % % ه المنايا ، وعانقته النصول % 28(@)(@@) % والسبايا على النجائب تستا % % وقد نالت الجيوب الذيول % % 29(@)(@@) % من قلوب يدمى بها ناظر الوج % د ومن أدمع مراها الهمول % 30(@)(@@) % قد سلبن القناع عن كل وجه % % فيه للصون من قناع بديل % % 31(@)(@@) % وتنقبن بالأنامل ، والدم % ع على كل ذي نقاب دليل % PageV01P1313 32(@)(@@) % وتشاكين ، والشكاة بكاء % وتنادين ، والنداء عويل % 33(@)(@@) % لا يغب الحادي العنيف ولا % % يفتر عن رنة العديل العديل % 34(@)(@@) % يا غريب الديار صبري غريب % % وقتيل الأعداء ، نومي قتيل % 35(@)(@@) % بي نزاع يطغى إليك وشوق % وغرام وزفرة وعويل % % 36(@)(@@) % ليت أني ضجيع قبرك ، أو أ % % ن ثراه بمدمعي مطلول % 37(@)(@@) % لا أغب الطفوف في كل يوم % من طراق الأنواء غيث هطول % % 38(@)(@@) % مطر ناعم ، وريح شمال % ونسيمن غض وظل ظليل % % 39(@)(@@) % يا بني أحمد إلى كم سناني % % غائب عن طعانه ممطول % 40(@)(@@) % وجيادي مربوطة ، والمطايا % % ومقامي يروع عنه الدخيل % 41(@)(@@) % كم إلى كم تعلو الطغاة ، وكم يح % % كم في كل فاضل مفضول % PageV01P1314 42(@)(@@) % قد أذاع الغليل قلبي ، ولكن % غير بدع إن استطب العليل % % 43(@)(@@) % ليت أني أبقى ، فأمترق النا % % س وفي الكف صارم مسلول % 44(@)(@@) % واجر القنا لثارات يوم ال % % طف يستلحق الرعيل الرعيل % 45(@)(@@) % صبغ القلب حبكم صبغة الشي % وشيبي لولا الردى لا يحول % % 46(@)(@@) % أنا مولاكم وإن كنت منكم % % والدي حيدر ، وأمي البتول % 47(@)(@@) % وإذا الناس أدركوا غاية الفخر % % ر شآهم من قال جدي الرسول % 48(@)(@@) % يفرح الناس بي لأني فضل % والأنام الذي أراه فضول % 49(@)(@@) % فهم بين منشد ما أقفي % % ه سرورا وسامع ما أقول % % 50(@)(@@) % ليت شعري من لائمي في مق % % ال ترضيه خواطر وعقول % % 51(@)(@@) % أترك الشيء 
ms377	 عاذري فيه كل % % ناس من أجل أن لحاني عذول % PageV01P1315 52(@)(@@) % هو سؤلي أن أسعد الله جدي % % ومعالي الأمور للذمر سول % % PageV01P1316 البحر : طويل 1(@)(@@) % أيرجع ميتا رنة وعويل % ويشفى بإسراب الدموع غليل % % 2(@)(@@) % نطيل غراما ، والسلو موافق % ونبدي بكاء والعزاء جميل % % 3(@)(@@) % شباب الفتى ليل مضل لطرقه % وشيب الفتى عضب عليه صقيل % 4(@)(@@) % فما لون ذا قبل المشيب بدائم % ولا عصر ذا بعد الشباب طويل % % 5(@)(@@) % وحائل لون الشعر في كل لمة % % دليل على أن البقاء يحول % 6(@)(@@) % نؤمل أن نروى من العيش والردى % % شروب لأعمار الرجال أكول % 7(@)(@@) % وهيهات ما يغنى العزيز تعزز % % فيبقى ولا ينجي الذليل خمول % % 8(@)(@@) % نقول مقيل في الكرى لجنوبنا % % وهل غير أحشاء القبور مقيل % 9(@)(@@) % دع الفكر في حب البقاء وطوله % فهمك لا العمر القصير يطول % % 10(@)(@@) % ولا ترج أن تعطى من العيش كثرة % % فكل مقام في الزمان قليل % % PageV01P1317 11(@)(@@) % ومن نظر الدنيا بعين حقيقة % درى أن ظلا لم يزل سيزول % % 12(@)(@@) % تشيع أظعان إلى غير رجعة % وتبكى ديار بعدهم وطلول % 13(@)(@@) % لماذا تربي المرضعات طماعة % % لماذا تخلى بالنساء بعول % % 14(@)(@@) % أليس إلى الآجال نهوي ، وخلفنا % % من الموت حاد لا يغب عجول ؟ % 15(@)(@@) % فمحتضر بين الأقارب أو فتى % % تشحط ما بين الرماح قتيل % % 16(@)(@@) % إذا لم يكن عقل الفتى عون صبره % % فليس إلى حسن العزاء سبيل % 17(@)(@@) % وإن جهل الأقدار والدهر عاقل % % فأضيع شيء في الرجال عقول % % 18(@)(@@) % تغير ألوان الليالي وتنمحي % % به غرر معلومة وحجول % 19(@)(@@) % تعز أمين الله واستأنف الأسى % % ففي الأجر من عظم المصاب بديل % % 20(@)(@@) % وما هذه الأيام إلا فوارس % % تطاردنا ، والنائبات خيول % PageV01P1318 21(@)(@@) % وإن زال نجم من ذؤابة هاشم % % فلا عجب ، إن النجوم تزول % 22(@)(@@) % مضى والذي يبقى أحب إلى العلى % % وأهدى إلى المعروف حين ينيل % 23(@)(@@) % بقاءك نهوى وحده دون غيره % % فدع كل نفس ما سواك تسيل % 24(@)(@@) % وموت الفتى خير له من حياته % إذا جاور الأيام وهو ذليل % % 25(@)(@@) % تلفت إلى آبائك الغر هل ترى % % من القوم باق 
ms378	 جاوزته حبول % 26(@)(@@) % وهل نال في العيش الفتى فوق عمره % وهل بل من داء الحمام غليل % % 27(@)(@@) % ومن مات لم يعلم وقد عانق الثرى % % بكاه خليل أم سلاه خليل % % 28(@)(@@) % فكفكف عنان الوجد ، إما تعزيا % وإما طلابا أن يقال حمول % 29(@)(@@) % فكل ، وإن لم يعجل الموت ، ذاهب % ألا إن أعمار الأنام شكول % 30(@)(@@) % وللحزن ثورات تجور على الفتى % % كما صرعت هام الرجال شمول % % PageV01P1319 31(@)(@@) % لقد كنت أوصى بالبكاء من الجوى % % لو أن غراما بالدموع غسيل % 32(@)(@@) % فأما ، ولا وجد يزول بعبرة % فصبر الفتى عند البلاء جميل % % 33(@)(@@) % وكم خالط الباكين من سن ضاحك % وبين رغاء الرازحات صهيل % % 34(@)(@@) % وإني أراني لا ألين لحادث % له أبدا وطء علي ثقيل % 35(@)(@@) % وأغضي عن الأقدار ، وهي تنوبني % % وما نظري عند الأمور كليل % 36(@)(@@) % يهون عندي الصبر ما وقعت به % صروف الليالي والخطوب نزول % 37(@)(@@) % وما أنا بالمغضي على ما يعيبني % % ولا أنا عن ود القريب أحول % 38(@)(@@) % ولا قائل ما يعلم الله ضده % ولو نال من جلدي قنا ونصول % 39(@)(@@) % ولولا أمير المؤمنين تحضرت % بي البيد هوجاء الزمام ذمول % 40(@)(@@) % وطوح بي ، في كل شرق ومغرب % زمان ضنين بالرجاء بخيل % PageV01P1320 41(@)(@@) % ولكنه أعلى محلي على العدا % % وعلم نطقي فيه كيف يقول % % 42(@)(@@) % وعودني من جود كفيه عادة % % أعوج إليها بالمنى وأميل % 43(@)(@@) % يقولون : لو أملت في الناس غيره % وهل فوقه للسائلين مسول % 44(@)(@@) % ومن يك إقبال الخليفة سيفه % % يلاق الليالي وهي عنه نكول % 45(@)(@@) % ومن كان يرمي عن تقدم باعه % % يصب سهمه أغراضه ويؤل % % 46(@)(@@) % فتى تبصر العلياء في كل موقف % به الرمح أعمى والحسام ذليل % 47(@)(@@) % ويدخل أطراف القنا كل مهجة % بها أبدا غل عليه دخيل % 48(@)(@@) % إذا لاح يوم الروع في سرج سابح % تناذره بعد الرعيل رعيل % 49(@)(@@) % بقيت ، أمير المؤمنين ، فإنما % % بقاؤك بالعز المقيم كفيل % 50(@)(@@) % ولا ظفرت منك الليالي بفرصة % ولا غال قلبا بين جنبك غول % PageV01P1321 51(@)(@@) % وأعطيت ما لم يعط في الملك مالك % % فإنك فضل والأنام فضول % PageV01P1322 البحر 
ms379	 : مجزوء الكامل 1(@)(@@) % إن كان ذاك الطود خ % ر ، فبعدما استعلى طويلا % % 2(@)(@@) % موف على القلل الذوا % % ب في العلى عرضا وطولا % % 3(@)(@@) % قرم يسدد لحظه % فترى القروم له مثولا % % 4(@)(@@) % ويرى عزيزا حيث % % ل ، ولا يرى إلا ذليلا % % 5(@)(@@) % كالليث ، إلا أنه % م تعود بالليان حولا % % 6(@)(@@) % وعلا على الأقران لا % % مثلا يعد ولا عديلا % % 7(@)(@@) % من معشر ركبوا العلا % % وأبوا عن الكرم النزولا % % 8(@)(@@) % غر إذا نسبوا لن % % ك على العلى جيلا ، فجيلا % % 9(@)(@@) % كرموا فروعا بعد ما % % طابوا ، وقد عجموا أصولا % % 10(@)(@@) % نسب غدا رواده % % يستنجبون لنا الفحولا % % PageV01P1323 11(@)(@@) % يا ناظر الدين الذي % % رجع الزمان به كليلا % % 12(@)(@@) % يا صارم المجد الذي % % ملئت مضاربه فلولا % % 13(@)(@@) % يا كوكب الأحساب أعج % % جلك الدجى عنا أفولا % % 14(@)(@@) % يا غارب النعم العظام % % م غدوت معمورا جزيلا % % 15(@)(@@) % يا مصعب العلياء قادت % % ك العدا نقضا ذلولا % % 16(@)(@@) % لهفي على ماض قضى % % ألا ترى منه بديلا % % 17(@)(@@) % وزوال ملك لم يكن % % يوما يقدر أن يزولا % % 18(@)(@@) % ومنازل سطر الزمان % على معالمها الحؤولا % % 19(@)(@@) % من بعد ما كانت على الأ % % يام مربأة زلولا % % 20(@)(@@) % والأسد ترتكز القنا % % فيها وترتبط الخيولا % % PageV01P1324 21(@)(@@) % من يسبغ النعم الجسام % % ويصطفي المجد الجزيلا % % 22(@)(@@) % من ينتج الآمال يو % تعود الليان حولا % % 23(@)(@@) % من يورد السمر الطوال % % ويطعم البيض النصولا % % 24(@)(@@) % من يزجر الدهر الغشوم % % ويكشف الخطب الجليلا % % 25(@)(@@) % وتراه يمنع دوننا % % وادي النوائب أن يسيلا % % 27(@)(@@) % هذا ، وكم حرب تب % سد سطوتها الغليلا % % 28(@)(@@) % صماء تخرس آلها % % إلا قراعا ، أو صهيلا % % 29(@)(@@) % والخيل عابسة تج % من العجاج بها ذيولا % % 30(@)(@@) % أجتاب عارضها ، وقد % رحل المنون به همولا % % 31(@)(@@) % كالثائر الضرغام أن % % لبس الوغى دق الرعيلا % % PageV01P1325 32(@)(@@) % صانعت يوم فراقه % % قلبا ، قد اعتنق الغليلا % % 33(@)(@@) % ظعن الغنى عني وحو % ول رحله إلا قليلا % % 34(@)(@@) % إن عاد يوما عاد وج % ه الدهر مقتبلا جميلا % % 35(@)(@@) % ولئن مضى طوع المنون % % مؤمما تلك السبيلا % % 36(@)(@@) % فلقد تخلف مجده % % عبأ على الدنيا ثقيلا 
ms380	 % % 37(@)(@@) % واستذرت الأيام من % نفحاته ظلا ظليلا % % PageV01P1326 البحر : رمل تام 1(@)(@@) % أي طود دك من أي جبال % لقحت أرض به بعد حيال % % 2(@)(@@) % ما رأى حي نزار قبلها % % جبلا سار على أيدي الرجال % 3(@)(@@) % عجبا أصبحت للضيم وما % % نثر الطعن أنابيب العوالي % % 4(@)(@@) % فإذا رامي المقادير رمى % % فدروع المرء أعوان النصال % % 5(@)(@@) % قاده المقدار قسرا بعد ما % % أكره السمر على المق الطوال % 6(@)(@@) % وأبال الخيل في كل حمى % % يمنع الماطر منهل العزالي % % 7(@)(@@) % مثل عقبان الموامي دلحا % راشها قرع الحنايا بالنبال % % 8(@)(@@) % حاملا عن قومه العبء ، وما % % حمدوا عرعرة العود الجلال % 9(@)(@@) % أيها القبر الذي أمسى به % عاطل الأرض جميعا وهو حالي % % 10(@)(@@) % لم يواروا بك ميتا إنما % % أفرغوا فيك ذنوبا من نوال % % PageV01P1327 11(@)(@@) % طال ما لاذ به المال كما % % لاذت الإصبع يوما بالقبال % 12(@)(@@) % حملوه بازلا محتقرا % دلج الليل ولزات الحبال % % 13(@)(@@) % إن غدا مجدوعة إشرافه % % فالبنى وافية ، والمجد عالي % % 14(@)(@@) % عقروا ليثا ولو هاهوا به % % كان بعد العقر أرجى للصيال % 15(@)(@@) % وكذا الأيام من قارعها % % تركت فيه علامات النزال % 16(@)(@@) % عقلوه بعدما جاز المدى % % وطوى شأو مساع ومعالي % % 17(@)(@@) % وكذا السابق يوما بعنان % % يحرز السبق ويوما بعقال % % 18(@)(@@) % قمت عنها بعد ما عج بها % % ورمى أوسقها بزل الجمال % 19(@)(@@) % وانتزعت النصل من مقلتها % % بعد غايات نزاع ومطال % 20(@)(@@) % ليتهم أعطوك إن لم يعدلوا % % بسلة الراقي من الداء العضال % PageV01P1328 21(@)(@@) % نتجوا في المجد ما ألقحته % % ربما أوقد نارا غير صالي % % 22(@)(@@) % وكأني خلل الغيب أرى % % نغرة من جرحها بعد اندمال % 23(@)(@@) % وإذا الأعداء عدوك لها % % سلموا فضلك من غير جدال % 24(@)(@@) % لا أضاعوا رابئا في قلة % كلأ المجد ، وقد نام الكوالي % % 25(@)(@@) % يوم للشعب دهان من دم % والمواضي للمقاديم فوالي % % 26(@)(@@) % في فتو شيعوا أرماحهم % أمم الموت إلى الطعن عجال % % 27(@)(@@) % بخفاف فوق أيمان رجال % وثقال فوق أعناق رجال % % 28(@)(@@) % قضب ، يوم صداها في الوغى % % بالطلى أطول من يوم الصقال % % 29(@)(@@) % لك منها ناحل تعصى به % يوم أبدلن عصيا 