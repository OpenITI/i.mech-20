ms2149	 رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 19841 ) قال النبي :(@)(@@) | 30 ( مرحبا بطالب العلم ، إن طالب العلم لتحفه الملائكة وتظله بأجنحتها ، ثم يركب بعضهم بعضا حتى يبلغوا السماء الدنيا من محبتهم لما يطلب ) )(@)(@@) البغوي ( طب ) عن صفوان بن عسال رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19842 ) قال النبي :(@)(@@) | 30 ( مرحبا بالشتاء فيه تنزل الرحمة ، أما ليله فطويل للقائم ، وأما نهاره فقصير للصائم ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19843 ) قال النبي :(@)(@@) | 30 ( مرحبا بالمصفرين والمحمرين ) )(@)(@@) الحسن بن سفيان وابن أبي عاصم في الآحاد ، والبغوي والباوردي وابن قانع وابن السكن ( طب ) عن حسان بن أبي جابر السلمي أن رسول الله رأى رجالا من أصحابه قد صفروا لحاهم ، وآخرين قد حمروها ، فقال : فذكره ، قال ابن السكن : في إسناده نظر .(@)(@@) PageV06P448(@)(@@)(@@)(@@) $ ( 19844 ) قال النبي :(@)(@@) | 30 ( مرحبا بك يا جويبر ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19845 ) قال النبي :(@)(@@) | 30 ( مرحبا بالأزرد : أحسن الناس وجوها ، وأشجعهم قلوبا ، وأطيبهم أفواها ، وأعظمهم أمانة ، شعاركم يا مبرور ) )(@)(@@) ( عد ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19846 ) قال النبي :(@)(@@) | 30 ( مرحبا بكم ، أحسن الناس وجوها ، وأصدقه لقاء ، وأطيبه كلاما ، وأعظمه أمانة ، أنتم مني وأنا منكم ) )(@)(@@) ابن سعد عن منير بن عبد الله الأزدي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19847 ) قال النبي :(@)(@@) | 30 ( مرحبا بابنة بني ضيعة قومه ) )(@)(@@) المسعودي في مروج الذهب عن عكرمة عن ابن عباس رضي الله عنهما قال : وردت ابنة خالد بن سنان على النبي فتلقاها بخير وأكرمها وقال : فذكره عبد الرزاق في أماليه عن سعد بن جبير مرسلا ورجاله ثقات .(@)(@@)(@@)(@@) $ ( 19848 ) قال النبي :(@)(@@) | 30 ( مرحبا بالراكب المهاجر ، مرحبا بالراكب المهاجر ) )(@)(@@) ( ت ) وضعفه وابن سعد ( ك ) عن عكرمة بن أبي جهل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19849 ) قال النبي :(@)(@@) | 30 ( مرحبا بك من بيت ، ما أعظمك وأعظم حرمتك ، وللمؤمن أعظم عند الله من حرمة منك ) )(@)(@@) ( هب ) عن ابن عباس رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 19850 ) قال النبي :(@)(@@) | 30 ( مرحبا بسيد المسلمين وإمام المتقين قاله لعلي ) )(@)(@@) ( حل ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ 19851 قال النبي 
ms2150	 :(@)(@@) | 30 ( مرحبا بك أبا يزيد ، كبيرا أصبحت قاله لعقيل ) )(@)(@@) الديلمي عن جابر رضي الله عنه .(@)(@@) PageV06P449(@)(@@)(@@)(@@) $ ( 19852 ) قال النبي :(@)(@@) | 30 ( مررت ليلة أسري بي على قوم تقرض شفاههم بمقاريض من نار ، قلت لجبريل : من هاؤلاء ؟ قال : خطباء من أهل الدنيا ممن كانوا يأمرون الناس بالبر وينسون أنفسهم وهم يتلون الكتاب أفلا يعقلون ) )(@)(@@) ( ط حم ) و عبد بن حميد ( ع طس حل ص ) عن اينس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19853 ) قال النبي :(@)(@@) | 30 ( مررت بموسى ليلة أسري بي وو قائم في قبره من غائلة وغويلة ) )(@)(@@) ( حل ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19854 ) قال النبي :(@)(@@) | 30 ( مررت بك البارحة وأنت تقرأ فاستمعنا لقراءتك ) )(@)(@@) ( ت ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19855 ) قال النبي :(@)(@@) | 30 ( مررت ليلة أسري بي على قوم يخمشون وجوههم بأظافيرهم ، فقلت : يا جبريل من هاؤلاء ؟ قال : هاؤلاء الذين يغتابون الناس ويقعون في أعراضهم ) )(@)(@@) ابن أبي الدنيا في ذم الغيبة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19856 ) قال النبي :(@)(@@) | 30 ( مررت ليلة أسري بي على إبراهيم فقال جبريل : من معك ؟ قال : هاذا محمد ، فقال : يا محمد مر أمتك أن يكثروا غراس الجنة فإن تربتها طيبة ، وأرضها واسعة ، قلت : وما غراس الجنة ؟ قال : لا حول ولا قوة إلا بالله ) )(@)(@@) ( حب ) عن أبي أيوب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19857 ) قال النبي :(@)(@@) | 30 ( مر لقمان على جارية في الكتاب فقال : لمن يصقل هاذا السيف ) )(@)(@@) الحكيم عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19858 ) قال النبي :(@)(@@) | 30 ( مر علي الشيطان فتناولته فأخذته فخنقته حتى وجدت برد لسانه على يدي ، فقال : أوجعتني أوجعتني ، ولولا دعاء سليمان PageV06P450 لأصبح مناطا إلى أسطوانة من أساطين المسجد ينظر إليه ولدان أهل المدينة ) )(@)(@@) ( حم هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 19859 ) قال النبي :(@)(@@) | 30 ( مر بهاذا الوادي عسفان إبراهيم وهود وصالح وشعيب على بكرات حمر أزرهم العباء ، وأرديتهم النمار ، وشراك نعالهم الخوض ، وأزمة نوقهم الليف يؤمون البيت العتيق ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 19860 ) قال الن