ms41	 من الأزد صيد الملوك % و ما زال ينمي النجيب النجيبا % % 19(@)(@@) % سلمت سلامة للمكرمات % و ما زلت تبسط باعا رحيبا % % 20(@)(@@) % تزف إليك تجار المديح % عذارى تروقك حسنا وطيبا % % PageV01P144 21(@)(@@) % فكم لك من سؤدد كالعبير % أصاب من المدح ريحا جنوبا % % 22(@)(@@) % و رأي يكشف ليل الخطوب % ضياءإذا الخطب أعيا اللبيبا % % 23(@)(@@) % و مشتمل بنجاد الحسام % يفل شبا الحرب بأسا مهيبا % % 24(@)(@@) % ملأت جوانحه رهبة % فأطرقو القلب يبدي وجيبا % % 25(@)(@@) % كسوت المكارم ثوب الشباب % و قد كن ألبسن فينا المشيبا % % 26(@)(@@) % ضرائب أبدعتها في السماح % فلسنا نرى لك فيها ضريبا % % 27(@)(@@) % تخلصتني من يد النائبات % و أحللتني منك ربعا خصيبا % % 28(@)(@@) % و ملكت مدحي كما ملكت % بنو هاشم بردها والقضيبا % % 29(@)(@@) % و أنى لوارد بحر القريض % إذا ورد المادحون القليبا % % 30(@)(@@) % و لست كمن يسترد المديح % إذا ما كساه الكريم المثيبا % % PageV01P145 31(@)(@@) % يحلي بمدحته غيره % % فيمسي محلى ويضحي سليبا % % PageV01P146 البحر : - 1(@)(@@) % أرى همة تختال بين الكواكب % و طودا من العلياء صعب الجوانب % 2(@)(@@) % و مربض آساد ومعدن سؤدد % و موئل مطلوب وغاية طالب % 3(@)(@@) % علا ملكت لب الأميرو إنما % % تملك ألباب الكرام المناجب % 4(@)(@@) % تروح به بين الصوارم والقنا % % و تغدو به بين اللهى والمواهب % 5(@)(@@) % فتى طالبي الدين أصبح جوده % % يحسن للطلاب وجه المطالب % 6(@)(@@) % تساهم فيه العرب والعجمفاحتوى % % على المجد من أقيالها والمرازب % 7(@)(@@) % و كم ومضت أسيافه بمشارق % فراع العدا إيماضها بمغارب % 8(@)(@@) % حبيت على رغم الحسود بجنة % حبتك بأنواع الثمار الأطايب % 9(@)(@@) % تعجلت منها ما يعجل مثله % % لكل جميل السعي عف المذاهب % 10(@)(@@) % ميادين ريحان كأن نسيمه % % نسيم الهوى أيام وصل الحبائب % PageV01P147 11(@)(@@) % كأن سواقيه سلاسل فضة % إذا اطردت بين الصبا والجنائب % 12(@)(@@) % و روض إذا ما راضه الغيثأنشأت % حدائقه وشيا كوشي السبائب % 13(@)(@@) % و حالية الأجياد من ثمراتها % % مفلكة الأجسام خضر الذوائب % 14(@)(@@) % خرقن الثرى عن مائه الغمرفارتوت % أسافلها من زاخر غير ناضب % 15(@)(@@) % إذا ما سقتهن السحائب شربة % خلطن بماء البحر ماء السحائب % 16(@)(@@) % تقل 
ms42	 شماريخ الثمار كأنها % % إذا طلعت حمرا أكف الكواعب % 17(@)(@@) % و جاعلة در السحاب مدامة % إذا شربت در السحاب الصوائب % 18(@)(@@) % لها كالىء يذكي اللحاظ خلالها % % حذارا عليها من سخاط النوائب % 19(@)(@@) % يرد إليها حية الماء ما انكفت % عن القصد أو صدت صدود المجانب % 20(@)(@@) % فقد لبست خضر الغلائلو انثنت % % لها مرجحنات بخضر الشوارب % PageV01P148 21(@)(@@) % قطوف تساوى شربهاو تباينت % % تباين مسود العذار وشائب % 22(@)(@@) % فمن برد لم يجل للشمس حاجبا % من الظل إلا غازلته بحاجب % 23(@)(@@) % و من سبج أجرت به الكرم سلكها % % و لم تجر في منظومه خرق ثاقب % 24(@)(@@) % بدائع أضحت في المذاق أقاربا % و إن كن في الألوان غير أقارب % 25(@)(@@) % ترى الماء شتى السبل ينساب بينها % % كما ريعت الحيات من كل جانب % 26(@)(@@) % و مسترفد تيار دجلة رافدا % سواحلها من نازح ومقارب % 27(@)(@@) % يسير وإن لم يبرحالدهر خطوة % فليس بوقاف و ليس بسارب % 28(@)(@@) % مواصل إيجاف تكاد تجيبه % % إذا حن ليلا موجفات الركائب % 29(@)(@@) % تسيل خلال الروض من فيض دمعه % % قواضب تزري بالسيوف القواضب % 30(@)(@@) % و ممتنع جلبابه الغيم في الضحى % % و حليته في الليل زهر الكواكب % PageV01P149 31(@)(@@) % أضاءفلو أن النجوم تحيرت % ضلالا هداها سبلها في الغياهب % 32(@)(@@) % له شرفات كالوذائل أشرفت % على نازح الأقطار نائي المناكب % 33(@)(@@) % إذا لبست ورس الأصيل حسبتها % % تعل برقراق من التبر ذائب % 34(@)(@@) % مجاور بر ضاحك النور معشب % و بحر طموح الموج عذب المشارب % 35(@)(@@) % إذا بكر القناص فيه وأعزبت % حبائله في صيد تلك العوازب % 36(@)(@@) % رأيت بنات البحر موشية القرى % % بهو بنات البر بيض الترائب % 37(@)(@@) % محاسن أرزاق من النورو المها % % يغذ إليها طالب غير خائب % 38(@)(@@) % فمن سانح بالخير في إثر سابح % و مختضب الأطراف من دم خاضب % 39(@)(@@) % و آمنة لا الوحش يزعر سربها % % و لا الطير منها داميات المخالب % 40(@)(@@) % هي الروض لم تنش الخوامل زهره % % و لا خضل عن دمع من المزن ساكب % PageV01P150 41(@)(@@) % إذا انبعثت بين الخمائل خلتها % % زرابي كسرى بثها في الملاعب % 42(@)(@@) % و 
ms43	 إن عمن في طامي المياه تبسمت % غرائبها ما بين تلك الغرائب % 43(@)(@@) % و دهم إذا ما الليل رفع سجفه % % تكشف منها عن وجوه شواحب % 44(@)(@@) % و إن آنست شخصا من الإنس صرصرت % كما صرصرت في الطرس أقلام كاتب % 45(@)(@@) % جبال رست في لجة غير أنها % % تحاذر أنفاس الرياح اللواعب % 46(@)(@@) % إذا عاينت للماء وفدا رأيتها % % تودع منه غائبا غير آيب % 47(@)(@@) % يسير إليها الركب في لج زاخر % و ليس سوى أولادها من مراكب % 48(@)(@@) % تضم رجالا أغرب الشيب فيهم % فمال على أجفانهم والحواجب % 49(@)(@@) % فمن رهج لا يستثار بحافر % لديهمو خيل لا تذل لراكب % 50(@)(@@) % عجائب ملك في فنائل لم تكن % عجائب ملك قبلها بعجائب % PageV01P151 51(@)(@@) % هي الحرم المحمي ممن يرومه % % بكل صقيل المتن عضب المضارب % 52(@)(@@) % مواطن لم يسحب بها الغي ذيله % % وكم للعوالي بينها من مساحب % 53(@)(@@) % أبا حسن لا زال ودك مشربي % % إذا بعدت يوما علي مشاربي % % 54(@)(@@) % نهنيك بالبرء الذي قام فعله % % مقام الضحى والحندس المتراكب % 55(@)(@@) % أعاد رياض الحمد مونقة الربا % % و رد رياح الجود ريا المشارب % 56(@)(@@) % فصدق من ظن الصديقو أكذبت % مواقعه ظن العدو المحارب % 57(@)(@@) % إذا كنت من صرف الحوادث معتبي % % فلست عليها ما حييت بعاتب % 58(@)(@@) % إليك القوافي الغر لا نظم سارق % و لا فكر مأفوك و لا لفظ حاطب % 59(@)(@@) % كتائب حمد لو رميت بها العدا % % غداة الوغى قامت مقام الكتائب % PageV01P152 البحر : - 1(@)(@@) % طلعت شموس الخدر كيما تغربا % % و بدت محاسنها لكي تتغيبا % % 2(@)(@@) % فكفاه أن يصف الصبابة ناطقا % دمع إذا وصف الصبابة أطنبا % % 3(@)(@@) % يا حبذا شمس جلت عنها النوى % % فجلت على الصب الشنيب الأشنبا % % 4(@)(@@) % و تعمدته بلحظة لو أنها % % سهم لجاز عن الشغاف مخضبا % % 5(@)(@@) % قامت تميل للعناق مقوما % كالخوط أبدع في الثمار وأغربا % % 6(@)(@@) % حملت ذراه الأقحوان مفضضا % يسقي المدامة والشقيق مذهبا % % 7(@)(@@) % و أبت وقد أخذ النقاب جمالها % % حركات غصن البان أن تتنقبا % % 8(@)(@@) % ما كنت إلا البدر فارق حجبه % % حتى إذا شمناه عاد مججبا 
ms44	 % % 9(@)(@@) % فغدوت لا أدري أكان له الحمى % % لما تغيب مشرقا أو مغربا % % 10(@)(@@) % فإذا الحيا أعطى الرياح قياده % % فانقاد تجنبه الجنوب أو الصبا % % PageV01P153 11(@)(@@) % فسقى محلا بالعقيق وخلة % و ربى بأطراف الغميم وربربا % % 12(@)(@@) % ما لي رأيت الدهر وكل صرفه % % بالقلبي الشهم كيف تقلبا % % 13(@)(@@) % ساويت جدا في مخيلة لاعب % و الندب ليس يجد حتى يلعبا % % 14(@)(@@) % و معرض لي بالطراد خسأته % % و متى رأيت الليث طارد ثعلبا % % 15(@)(@@) % فليثو في رمس الخمولفإنني % % نار تضرم في ذؤابة كبكبا % % 16(@)(@@) % هيهات جانبت السفاه وأهله % % حدثا فكيف أرى السفاهة أشيبا % % 17(@)(@@) % و أحلني عز الأمير محلة % لو رامني فيها الزمان تهيبا % % 18(@)(@@) % عدنا بمبيض الصنائع راضيا % منهو محمر العوامل مغضبا % % 19(@)(@@) % غمر المواهب لا يساجل مرغبا % في المكرمات ولا يطاول مرهبا % % 20(@)(@@) % و ممنع يردي العدو إذا ارتدى % % بالسيف أو يحبو الولي إذا احتبا % % PageV01P154 21(@)(@@) % و أغر لو نطقت رحاب محله % % قالت لطلاب المكارممرحبا % % 22(@)(@@) % ناضلت منه بذي السداد فما هفا % % و ضربت منه بذي الفقارفما نبا % % 23(@)(@@) % و صحبت أيام المشيب بجوده % % مبيضةفذممت أيام الصبا % % 24(@)(@@) % بشر كمصباح الحيا وخلائق % تخبو لبهجتها مصابيح الربا % % 25(@)(@@) % و مناسب حاز الفضيلة أعجما % فيناكما حاز الفضيلة معربا % % 26(@)(@@) % إن شاء عد من الشعوب أجلها % % أو شاء عد من القبائل تغلبا % % 27(@)(@@) % يرتاح ما غنى الحديد إلى الوغى % % فيخوض موجا منه أكدر مجلبا % % 28(@)(@@) % و يكر مطرود السنان كأنه % % قمر يطارد في العجاجة كوكبا % % 29(@)(@@) % أأشيم بارقة الغمامو قد غدت % يمنى أبي الحسن الغمام الصيبا % % 30(@)(@@) % قاظ الزمان فكنت ظلا سجسجا % و نأى الربيع فكنت روضا معشبا % % PageV01P155 31(@)(@@) % ترك القصائد قصرت عن عد ما % % يسديو من يحصي الحصى والأثلبا % % 32(@)(@@) % و الطالبيون انتحتك وفودهم % % فرأوا نداك الغمر قرب مطلبا % % 33(@)(@@) % لاحظتهمو الفكر يصرف عنهم % % لحظ النواظر بغضة وتجنبا % % 34(@)(@@) % فنظمتهم جمعا وقد نشرتهم % أيدي الزمان ففرقوا أيدي سبا % % 35(@)(@@) % أحببت ذا القربى و ليس يحبه % % إلا امرؤ رفض الغريب الأجنبا % % 36(@)(@@) % أما الصيام فقد أجبت 
ms45	 دعاءه % و رأيته فعلا أغر مهذبا % % 37(@)(@@) % شهر وصلت صيامه بقيامه % % فنضوته نضو الجوانح متعبا % % 38(@)(@@) % فأجب دعاء الفطر مصطبحا فقد % ناداك حي على الصباح فثوبا % % 39(@)(@@) % و تملها بكرا فلست مزوجا % شرف الشريف من المدائح ثيبا % % 40(@)(@@) % حمدا أمر الفكر سلك نظامه % % فأصاب درا من علاك مثقبا % % PageV01P156 41(@)(@@) % إن حل أوطن في صدور رواته % % أو سار شرق في البلاد وغربا % % PageV01P157 البحر : - 1(@)(@@) % من لي برد سوالف الأحقاب % و مآرب أعيت على الطلاب % 2(@)(@@) % أتبعتها نفس المحب تضرمت % أحشاؤه لتفرق الأحباب % % 3(@)(@@) % أتبعتها نظر المشوق تجمعت % زفراته لتفرق الأتراب % 4(@)(@@) % إن الظباء حمت مراتعها الظبا % % ورعت سوائمها أسود الغاب % 5(@)(@@) % من كل سكرى اللحظ أثمر غصنها % % نوعين من ورد ومن عناب % 6(@)(@@) % ريا أخاضتنا على ظمأ الهوى % % من وعدها الممطول لمع سراب % 7(@)(@@) % لله أعرابية غدرت بنا ؛ % إن النفاق سجية الأعراب % 8(@)(@@) % حجبت محاسنها الخيامو لو بدت % كان العفاف لها أتم حجاب % 9(@)(@@) % و أحلها من قلب عاشقها الهوى % % بيتا بلا عمد و لا أطناب % 10(@)(@@) % هيهات ما صدرت عقود نسيبه % % عن لوعة كمنتو لا أوصاب % PageV01P158 11(@)(@@) % لكنها فكر إذا ما سومرت % باتت تفتح زهرة الآداب % 12(@)(@@) % يهنى العواذل أنه هجر الصبا % % أنف الشباب معذل الأصحاب % 13(@)(@@) % لحظ الكواعب سرهفوجدته % % عف السريرة طاهر الأثواب % 14(@)(@@) % كم قلن لما قام في محرابه % % سيان أنت ودمية المحراب % 15(@)(@@) % يا حسن ما خلعت على أعطافه % % أيدي الصبا أو زانه بتصابي % % 16(@)(@@) % إن الوعيد ثناه عن آرائه % % حتى تجنب مونق الآداب % 17(@)(@@) % الآن قصرت النوائبفاغتدت % بندى الأمير كليلة الأنياب % 18(@)(@@) % سفرت لنا من رأيه وحسامه % % عن ضوء صبح مسفر وشهاب % 19(@)(@@) % ملك عقود الحمد ملء يمينه % % و نداه ملء حقائب الطلاب % 20(@)(@@) % شفع الندى لعفاتهبندىكما % % شفع الربيع سحابة بسحاب % PageV01P159 21(@)(@@) % و عفافرد البيض في أغمادها % % و سطا فعل متونها بخضاب % 22(@)(@@) % و جرى فبين مقصر عن شأوه % % متخلف عنه وآخر كاب % % 23(@)(@@) % شيدت مجدك فاعملي بمهذب % بين القبائل والشعوب لباب % 24(@)(@@) % و نصبت نفسك 
ms46	 للنبي وآله % % حتى سقيتهم من الطلاب % 25(@)(@@) % فأعز نصرك منهم باقي الهدى % % و أذل عنه بقية الأحزاب % 26(@)(@@) % نزلوا فناك مخضبين أعزة % ما بين رحب خلائق ورحاب % 27(@)(@@) % فكأنما حلوا بيثرب منهأو % % نزلوا بمكة في ربا وهضاب % 28(@)(@@) % فاسلم أبا حسن ليوم مكارم % وطف سحائبها ويوم عقاب % 29(@)(@@) % لم تنض أثواب الصيام مودعا % حتى كساك الفطر ثوب ثواب % 30(@)(@@) % فاسعد بعيد عاد كوكب سعده % طلق الضياء مؤكد الأسباب % PageV01P160 31(@)(@@) % و تحلها نظم اللسانو إنما % % نظم اللسان فرائد الألباب % 32(@)(@@) % لو صافحت سمع الوليد جفا لها % % أرسوم دار أم سطور كتاب % 33(@)(@@) % بل لو تأملها ابن أوس لم يقل % لو أن دهرا رد رجع جوابي % % PageV01P161 البحر : - 1(@)(@@) % لنا من الدهر خصم لا نغالبه % % فما على الدهر إن ولت نوائبه % % 2(@)(@@) % يرتد عنه جريحا من يسالمه % % فكيف يسلم منه من يحاربه % % 3(@)(@@) % و لو أمنت الذي تجني أراقمه % % علي هان الذي تجني عقاربه % % 4(@)(@@) % تظلم الشعر من ليث يساوره % % إذا تبرجأوصل يواثبه % % 5(@)(@@) % و حجبت دون رائيها بدائعه ؛ % و قيدت دون مسراها غرائبه % % 6(@)(@@) % و كيف لا يتحامى سفرها سننا % أمسى به أسد ضار نوائبه % % 7(@)(@@) % يا غيبة الكرم المفقود غائبه % % و خيبة الأدب المجفو صاحبه % % 8(@)(@@) % أتستباح على قسر محارمه % % و تسترق على صغر كواعبه % % 9(@)(@@) % أبعد ما انهد عمري في محاسنه % % حتى وهى بحلول الشيب جائبه % % 10(@)(@@) % و رقرق الطبع فيه ماء رونقه % فجاء كالوشي مصقولا سبائبه % % PageV01P162 11(@)(@@) % و كان كالثمر استقصيت غايته % % خبرا فما بيدي إلا أطايبه % % 12(@)(@@) % ضرب من السحر أجلوه على نفر % سيان قائله فيهم وجالبه % % 13(@)(@@) % تضيء مثل سطور البرق أسطره % % كأنما ذهب القرطاس كاتبه % % 14(@)(@@) % تدنست بيدي غيري مطارفه % % و سودت بسوى قومي مناسبه % % 15(@)(@@) % وشي إذا نمنمت منه خواطرنا % % بردا فلا بد من كف تجاذبه % % 16(@)(@@) % نهب فلو حضرته النار مضرمة % جرى إليه يخوض النار ناهبه % % 17(@)(@@) % بل لو تعلق بالجوزاء هاربه % % ما فات خطف أبي عثمان هاربه % % 18(@)(@@) % سبى و أبقت بوادي سبيه 
ms47	 لمحا % معشوقة إن عفت عنها عواقبه % % 19(@)(@@) % إذا الكمي تحامى بعض ما ملكت % رماحه من خطير فهو واهبه % % 20(@)(@@) % له على سرج شعري غارة أبدا % يرتاع معقوله منها وساربه % % PageV01P163 21(@)(@@) % فلا السنان لها دام و قد برقت % فتكا و لا السيف مخضوبا مضاربه % % 22(@)(@@) % إذا تخطف من أولادنا ولدا % قامت بمثل قوافيه نوادبه % % 23(@)(@@) % إليكم عن شهاب طار طائره % قدما يعري أديم الجو ثاقبه % % 24(@)(@@) % فنكبوا عن طريق السيل تمتنعوا % % من قبل أن تتهاداكم غواربه % % 25(@)(@@) % فلست أهدي إلى قوم سمائحه % % من بعد ما قسمت فيهم جنائبه % % 26(@)(@@) % و لا تمدوا إلى العيوق أيديكم % % جهلا فلن يدرك العيوق طالبه % % 27(@)(@@) % هل للغنيين عذر في اغتصابهما % % حليا يبوء بأوفى اللعن غاصبه % % 28(@)(@@) % قل للوزير تحرج إنه سلب % غشما تعدى على المسلوب سالبه % % 29(@)(@@) % لا يبعد الله درا حلياك به % % فكم فتى عطلت منه ترائبه % % 30(@)(@@) % و مركبا يتحرى الصدق مادحه % % حسنا كما يتحرى الإفك عائبه % % PageV01P164 31(@)(@@) % مدفعا بأكف الظلم رائضه % منكبا برماح الجود راكبه % % 32(@)(@@) % أضحى ابن فهد حريبا من محاسنه % % من بعد ما بذلت فيها حرائبه % % 33(@)(@@) % و أنت لا شك من أفواف يمنته % % عار كما عريت منها مناكبه % % 34(@)(@@) % و كيف تسحب وشيا قد تداوله % % قوم سواك فقد رثت مساحبه % % 35(@)(@@) % تبرجت فيهم قدما عرايسه % % و أشرقت فيهم دهرا كواكبه % % 36(@)(@@) % لا يعجبنك دينار المديحو لم % % يضربه باسمك دون الناس ضاربه % % 37(@)(@@) % فخير صيدك ما حلت مصايده ؛ % و خير مالك ما طابت مكاسبه % % 38(@)(@@) % و إن أصخت لتغريد المديحفقد % % وافى مغردهو انحط ناعبه % % PageV01P165 البحر : - 1(@)(@@) % على غير عتب ما طويت عتابها % % و آثرت من بعد الوصال احتسابها % % 2(@)(@@) % وقفنا فظل الشوق يسأل دارها % % و تجعل أسراب الدموع جوابها % % 3(@)(@@) % فلا برحت ريح الجنوب حفية % تخص بألطاف السحاب جنابها % % 4(@)(@@) % لوامع برق لا تمس أراكها % % و أنفاس ريح لا تروع ترابها % % 5(@)(@@) % و مجدولة جدل العنان منحتها % % عناني فأضحت رحلة الهجر دابها % % 6(@)(@@) % إذا برزت كان العفاف حجابها % % و إن 
ms48	 سفرت كان الحياء نقابها % % 7(@)(@@) % و من دونها نيل الغمامإذا سرت % نجوم القنا الخطي تزجي قبابها % % 8(@)(@@) % حمتنا اللياليبعد ساكنة الحمى % % مشارب يهوى كل طام شرابها % % 9(@)(@@) % ألاحظها لحظ الطريد محله % % و أذكرها ذكر البغي شبابها % % 10(@)(@@) % و أنشدهاو القرب بيني وبينها % % و لو آب حلمي ما رجوت إيابها % % PageV01P166 11(@)(@@) % تخيرت أفواف المديحفلم أنخ % بباب بني العباس إلا لبابها % % 12(@)(@@) % قواف لو أن الأخيلية عاينت % محاسنها زانت بهن سخابها % % 13(@)(@@) % أغريداه مزنة مستهلة % إذا شام راج بالشآم سحابها % % 14(@)(@@) % و لو لم يثبها الهاشمي لأصبحت % مآثره اللاتي حوين ثوابها % % 15(@)(@@) % يعد الجبال من قريش أبوة % إذا عد ذو فخر سواها هضابها % % 16(@)(@@) % إذا انتسبت بين الخلائق ألحقت % أواصرها بالمصطفى وانتسابها % % 17(@)(@@) % و إن حملت سمر الرماح لمشهد % رأيت أسود الغاب تحمل غابها % % 18(@)(@@) % و سالت بهم تلك البطاح كأنما % % أسالوا عليها بالحديد سرابها % % 19(@)(@@) % بهم عرفت زرق الأسنة ريها % % كما عرفت بيض السيوف خضابها % % 20(@)(@@) % أبا أحمد أصبحت شمس مكارم % تضيءو مصباح العلى وشهابها % % PageV01P167 21(@)(@@) % أبوك الذي سقى الحجيجو لم يزل % بمكة يروي ركبها وركابها % % 22(@)(@@) % و لما أقام المحل بين بيوتهم % % دعا الله فيه دعوةفأجابها % % 23(@)(@@) % و لم يثن طرف العين حتى تهللت % مدامع مزن لا تمل انسكابها % % 24(@)(@@) % فأعتبت الأرض السماء بجاهه % غداة تولى عن قريش عتابها % % 25(@)(@@) % بني هاشم أعطاكم الحق رتبة % يقصر عنها من يريد اغتصابها % % 26(@)(@@) % فأشرق منها في القلوب ضياؤكم % % فأذهب عن تلك النفوس ارتيابها % % 27(@)(@@) % منعتم بني مروان حوزتها بكم % % و حزتم على رغم الأنوف نهابها % % 28(@)(@@) % و آثرتم فك العناةو إنما % % يملككم عتق الرقاب رقابها % % 29(@)(@@) % و من ينأ عن إرث النبوة والهدى % % فأنتم ورثتم هديها وكتابها % % 30(@)(@@) % و هل يتحلى بالخلافة غيركم % % و أنتم سلبتم عبد شمس ثيابها % % PageV01P168 البحر : - 1(@)(@@) % إذا السحاب حداه البرق مجنوبا % % و حث منه وميض البرق شؤبوبا % % 2(@)(@@) % و حن حتى أجاب النبت حنته % % كأنه مذكر أشجانها النيبا % % 3(@)(@@) % و حمل الريح حملا لا كفاء له % % يعيد 
ms49	 منكبه بالثقل منكوبا % % 4(@)(@@) % و سار جحفله في الجو وانتشرت % أعلامهفحباها البرق تذهيبا % % 5(@)(@@) % و خيلبين ضرام ساطع وحيا % أبو الفوارس مرجوا ومرهوبا % % 6(@)(@@) % فجاد حيا أروي في زيارتهم % % خوفا وظنا أوري عنه تغييبا % % 7(@)(@@) % و إن حمى البين عذبا من موارده % % إلا خيالا يزيد القلب تعذيبا % % 8(@)(@@) % و ربما جنبت ريح الجنوب حيا % رد الجوى فيه حتى عاد مربوبا % % 9(@)(@@) % و شب لي في سواد الليل بارقه % % فخلته في سواد القلب مشبوبا % % 10(@)(@@) % أقول والريح تثني من أعنته % % على الثنية ألا رحت مسلوبا % % PageV01P169 11(@)(@@) % أرض إذا نسجت فيها مطارفها % % زادت لطيب الثرى أطرافها طيبا % % 12(@)(@@) % لا تستغيث إلى الأنواء تربتها % % إذا استغاث إليها الترب مكروبا % % 13(@)(@@) % دساكر و رياض حين ساعدني % % دين البطالة كانت لي محاريبا % % 14(@)(@@) % و ما تنمر جلباب الغمام بها % % إلا كسا الروض من نهر جلابيبا % % 15(@)(@@) % كأنما الغيثمرفضا بعقوتها % % نعمى الأميرإذا ارفضت شآبيبا % % 16(@)(@@) % الواهب النفس للأرماح في نشب % يعيده في طلاب الحمد موهوبا % % 17(@)(@@) % بينا تراه وأسلاب الملوك له % % رأيته بسجال العرف مسلوبا % % 18(@)(@@) % كالغيث يبسم للرواد بارقه % % و ربما عاد في الأعداء ألهوبا % % 19(@)(@@) % أقام للرفد سوقا من مكارمه % % يضحي الثناء إليهاالدهرمجلوبا % % 20(@)(@@) % و درت الجود وعدا صادقا يده % % و كان ظنا على الأياتم مكذوبا % % PageV01P170 21(@)(@@) % حلم ومكرمة ما دار بينهما % % إلا أراك هضابا أو أهاضيبا % % 22(@)(@@) % يقابل الخصم منه منطقا ذربا % و القرن أزرق ماضي الحد مذروبا % % 23(@)(@@) % أغر لا تخضب الصهباء راحته % % حتى يرد القنا ريان مخضوبا % % 24(@)(@@) % أقول للمبتغي إدراك سؤدده % خفض عليك فليس النجم مطلوبا % % 25(@)(@@) % إن تسأل السلم تسلم من صوارمه % % أو تؤثر الحرب ترجع عنه محروبا % % 26(@)(@@) % كم من جبين أنار السيف صفحته % % فعاد طرسا بحد السيف مكتوبا % % 27(@)(@@) % و كم له في الوغى من طعنة قتلت % عداهأو نثرت رمحا أنابيبا % % 28(@)(@@) % قوم إذا جردوا البيض الرقاق حووا % % جرد الصواهل والبيض الرعابيبا % % 29(@)(@@) % بادون للعز يبدو ضوء نارهم % ليلا إذا بات ضوء البرق محجوبا % % 30(@)(@@) % يعد من 
ms50	 تغلب صيدا غطارفة % أضحى مغالبهم في الحرب مغلوبا % % PageV01P171 31(@)(@@) % أرسوا قبابهم في البرو اتخذوا % % سورا عليه من الأرماح مضروبا % % 32(@)(@@) % إليكوافت بنا الآمال مهدية % درا إلى لجج الأفكار منسوبا % % 33(@)(@@) % من كل مخدومة الألفاظ خادمة % على نفاستها الغر المنا جيبا % % 34(@)(@@) % و كم لأفكارنا من سلك قافية % أصاب در مساع منك مثقوبا % % PageV01P172 البحر : - 1(@)(@@) % تباعد عن عرسه جعفر % فسرهما البعد بعد اقتراب % 2(@)(@@) % و كانت تصبى إلى غيره % % و كان إلى غيرها ذا تصاب % % 3(@)(@@) % فبينا هما يتبعان الهوى % % على حذر منهما وارتقاب % 4(@)(@@) % أتاح الزمان له سفرة % معجلة لم تكن في الحساب % 5(@)(@@) % فمكنها من قياد الزناة % و تمكنه من قياد القحاب % 6(@)(@@) % فودا وقد وفقا للفراق % بأن التلاقي يوم الحساب % PageV01P173 البحر : - 1(@)(@@) % قد أمكن الطالب مطلوب % و أسعد الغر المناجيب % 2(@)(@@) % و الغيث قد بان له عارض % على بساط الروض مسكوب % 3(@)(@@) % و الفجر كالراهب قد مزقت % من طرب عنه الجلابيب % 4(@)(@@) % فقم بنا ننعم في منزل % نعيمه الدائم محبوب % 5(@)(@@) % و نشتري منه رخيصا به % % كأنه للرخص موهوب % 6(@)(@@) % بيت بنته حكماء الورى % % فهو إلى الحكمة منسوب % 7(@)(@@) % مجاور النار ولكنه % % يجاور الروحبه الطيب % 8(@)(@@) % حر هو الظل لأجسادنا % % و الحر للأجسام تعذيب % 9(@)(@@) % طاب فلو رد شباب امرء % لارتد شبانا به الشيب % 10(@)(@@) % كأنهإذ ضحكت جدره % من خالص الفضة مصبوب % PageV01P174 11(@)(@@) % كأن ما قبب من سقفه % قحف من البلور مكبوب % 12(@)(@@) % كم سالب بزة أعدائه % % أطرق فيهو هو مسلوب % 13(@)(@@) % فرب شيء فيه أبصرته % % لولاه أضحى وهو محجوب % 14(@)(@@) % يخلو وفيه من صنوف الوغى % % للصيد والقصف أعاجيب % 15(@)(@@) % تعترض الخيل على جدره % % قبلا فمجنوب ومركوب % 16(@)(@@) % و تلتقي بالبيض فرسانه % % فضارب منهم ومضروب % 17(@)(@@) % منظر حرب ما لها مخبر % سلاحها بالدم مخضوب % 18(@)(@@) % لا يرتجي العز بها غالب % و لا يخاف الذل مغلوب % 19(@)(@@) % و تطرد الوحش بها أكلب % دامية منها المخاليب % 20(@)(@@) % فلبة بالناب ملبوبة % و منكب بالظفر منكوب % PageV01P175 21(@)(@@) % و يشرب الراح به شارب 
ms51	 % مرتفق بالتاج معصوب % 22(@)(@@) % عيانه ينبيك عن نعمة % و هو بما عاينت مكذوب % 23(@)(@@) % حتى إذا نلت به لذة % ليس على من نالها حوب % 24(@)(@@) % ملنا إلى شرب حلال لنا % % إن الحلال الطلق مشروب % 25(@)(@@) % راح يحييك بها شادن % زينه ظرف وتأديب % 26(@)(@@) % فالمسك مهجور إذا صفقت % في الكاسو الكافور مسبوب % 27(@)(@@) % و ليس يكبو الهم إلا إذا % % أعمل فيه الكاس والكوب % PageV01P176 البحر : - 1(@)(@@) % سلوت محمدا لما تمادى % % به الهجرانو انقطع العتاب % 2(@)(@@) % و قد ينسى الربيع إذا تولت % لياليه وقد يسلى الشباب % PageV01P177 البحر : - 1(@)(@@) % و قريبة من كل قلب إن بدت % للمرء أدناها إليه وقربا % % 2(@)(@@) % روى القلوب نسيمها وتلهبت % حسنا فأذكت في القلوب تلهبا % % 3(@)(@@) % صفراء ما عنت لعيني ناظر % إلا توهمها سنانا مذهبامكان البيت الرابع % % 4(@)(@@) % فكأنما ذهب حوى كافوره % % فغدا برياهو راح مطيبامكان البيت الثالث % % PageV01P178 البحر : - 1(@)(@@) % وأغن كالرشأ الغري % % ر نشا خلال الربرب % 2(@)(@@) % في خده ورد حما % % ه من القطاف بعقرب % 3(@)(@@) % لما سقاه قهوة % في الكاس ذات تلهب % 4(@)(@@) % حيا بدستنبوية % مثل السنان المذهب % PageV01P179 البحر : - 1(@)(@@) % بديعة جسمها زبرجدة % خضراء يخفي جمالها الحجب % 2(@)(@@) % مجروحة الخصرغير دامية % كما تكون الجروح والندب % 3(@)(@@) % كأنهامن جفاء لبستها % % مقرورة والهجير يلتهب % 4(@)(@@) % كأنما الماءحين تبعثه % ذوب لجين ميزابه ذهب % PageV01P180 البحر : - 1(@)(@@) % تجنبني حسن المدام وطيبها % % فقد ظمئت نفسيو طال شحوبها % % 2(@)(@@) % و عندي ظروف لو تظرف دهرها % % لما بات مغرى بالكآبة كوبها % % 3(@)(@@) % و شعث دنان خاويات كأنها % % صدور رجال فارقتها قلوبها % % 4(@)(@@) % فسقياك لا س قيا السحابفإنها % % هي العلة القصوى و أنت طبيبها % % PageV01P181 البحر : - 1(@)(@@) % يوم رذاذ ممسك الحجب % يضحك فيه السرور من كثب % 2(@)(@@) % و مجلس أسبلت ستائره % % على شموس البهاء والحسب % 3(@)(@@) % و قد جرت خيل راحنا خببا % في جريهاأو هممن بالخبب % 4(@)(@@) % و التهبت نارنافمنظرها % % يغنيك عن كل منظر عجب % 5(@)(@@) % إذا ارتمت بالشرار واطردت % على ذراها مطارد اللهب % 6(@)(@@) % رأيت ياقوتة مشبكة % تطير عنها قراضة الذهب % 7(@)(@@) % فسر إلى المجلس الذي 
ms52	 ابتسمت % فيه رياض الجمال والأدب % PageV01P182 البحر : - 1(@)(@@) % يحيي اشتياقا بعضنا بك بعضنا % % إذا قبل الكاس الروية شارب % 2(@)(@@) % و عندي لك الريحان زين بساطه % % بزهر كما زانت سماء كو اكب % 3(@)(@@) % و ذيل كما انجرت ذيول غلائل % مصندلة تختال فيها الكواعب % 4(@)(@@) % سقاه دموع الورد ساف أساله % % و شاب له الكافور بالمسك شائب % 5(@)(@@) % و قد أطلقت فيه الشمائل وانثنت % مقيدة في جانبيه الجنائب % 6(@)(@@) % و حافظة ماء الحياة لفتية % حياتهم أن تستلذ المشارب % 7(@)(@@) % يسربلها أجفى اللباسو إنما % % يليق بها أفوافه والسبائب % 8(@)(@@) % على جسد مثل الزبرجد لم يزل % يشاكله في لونه ويناسب % 9(@)(@@) % إذا استودعت حر اللجين سبائكا % يصوب من أجسامها وهو ذائب % PageV01P183 البحر : - 1(@)(@@) % شوى أثوابه قشب % و مد شأنه عجب % 2(@)(@@) % ترى الأمواج تسكن في % % غواربه وتضطرب % 3(@)(@@) % كسرب الوحش يبعد في % % تناطحه ويقترب % 4(@)(@@) % و يوم يؤثر اللذا % % ت فيه من له أدب % 5(@)(@@) % و شمس من وراء الدج % ن تسفر ثم تنتقب % 6(@)(@@) % و مجلسنا على شرف % بحجب الغيم محتجب % 7(@)(@@) % علا فالبرق يبسم دو % % نهو الرعد ينتحب % 8(@)(@@) % فمن شرقيه لهب ؛ % و من غربيه صخب % 9(@)(@@) % و بين يديه زاهرة % إلى الأنواء تنتسب % 10(@)(@@) % لها من كل مرتجس % يمر بها أب حدب % PageV01P184 11(@)(@@) % يميل بها قضيب البا % % ن أحيانا وينتصب % 12(@)(@@) % و قد رفعت لنا سود % نجوم سمائها الحبب % 13(@)(@@) % تجيش بما أفاء الطر % ف والمجنوبة النجب % 14(@)(@@) % و ترطن مثل ما جعلت % نساء الزنج تصطخب % 15(@)(@@) % و أحدقنا بأزهر خا % % فقات فوقه العذب % 16(@)(@@) % يواصل في اسمه فضل ال % % مقرب ثم يجتنب % 17(@)(@@) % فما ينفك من سبج % يعود كأنه ذهب % 18(@)(@@) % و إخوان الصفاء إلي % ك مشتاق ومكتئب % 19(@)(@@) % و ذكرك بينهم أزكى % % من الريحان إن شربوا % % 20(@)(@@) % و قد وافاك موكبهم % فكن حرا كما يجب % PageV01P185 البحر : - 1(@)(@@) % تصابى فأضحى بعد سلوته صبا % % و عاود عمرو طوقه بعد ما شبا % % 2(@)(@@) % و مر به رطب البنانكأنه % % يميل من أعطافه غصنا رطبا % % 3 
ms53	(@)(@@) % نشرت له صدر العتابفقال لي % % ظفرت بنا فاطو العتابلك العتبى % % 4(@)(@@) % و لا وصل إلا أن تبيت أكفنا % % ركائب تزجي من مدامتنا ركبا % % 5(@)(@@) % فجدد بها عهد التواصل بيننا % % و داو بها شوقا ونفس بها كربا % % 6(@)(@@) % و كنيا بن فهد في الفتوة عاذري % % فما زلت خدنا للفتوة أو تربا % % 7(@)(@@) % و لا تجعل الذنب العظيم خيانة % فليس مليح الذنب مقترفا ذنبا % % PageV01P186 البحر : - 1(@)(@@) % يا حسن لينوفر شغفت به % % يمنحه الماء صفو مشروبه % 2(@)(@@) % كأنه عاشق به ظمأ % توهم الماء ريق محبوبه % PageV01P187 البحر : - 1(@)(@@) % هل للوزير أدام الله دولته % % في صاحب يتحرى نصح من صحبا % % 2(@)(@@) % و عارف بفنون الشعر ينقدها % % نقد الصيارفة الأوراق والذهبا % % 3(@)(@@) % طاف الذكاء به يوما يكلفه % فكاد يضرم في أثوابه اللهبا % % 4(@)(@@) % لو أن صاحبه يوما يكلفه % % ثقل الجبال إذا ما عده تعبا % % 5(@)(@@) % فخذه يرض الذي توليه من حسن % و لو نفى الأصفرينالظمأ والسغبا % % PageV01P188 البحر : - 1(@)(@@) % عندي إذا ما ارتاحت القلوب % و حن للصيد الفتى الطروب % 2(@)(@@) % أداة رزق شأنها عجيب % يخصب منها المنزل الجديب % 3(@)(@@) % كالدرع أصداها الحيا السكوب % يبعثها رام بها مصيب % 4(@)(@@) % عيونها عن عينه تنوب % في ذاخر تياره صخوب % 5(@)(@@) % له مجال فيه أو سروب % إذا ابتغى الرزق بها الطلوب % 6(@)(@@) % أعطته ما يذكو وما يطيب % % PageV01P189 البحر : - 1(@)(@@) % الكأس قطب السرور والطرب % فاحظ بها قبل حادث النوب % 2(@)(@@) % و انظر إلى الليل كيف تصدعه % راية صبح مبيضة العذب % 3(@)(@@) % كراهب حن للهوى طربا % فشق جلبابه من الطرب % 4(@)(@@) % فاليوم يوم صفت شمائله % % بصفو عيش ومنظر عجب % 5(@)(@@) % فمن صقيل المدود مطرد % كأنه ماء صفحة القضب % 6(@)(@@) % ترعد أحشاؤه لدي كما % % ترعد أحشاء هائم وصب % 7(@)(@@) % و من قصور عليه مشرفة % تضيء والليل أسود الحجب % 8(@)(@@) % بيض إذا الشمس حان مغربها % % حسبت أطرافهن من ذهب % PageV01P190 البحر : - 1(@)(@@) % كبوة الهم بين كاس وكوب % و اغتباط المحب والمحبوب % 2(@)(@@) % هو يومي من اللذاذة يجلي % % فعل يوم الكريهة المرهوب % 3(@)(@@) % حبذا اسهم تفوقها الأل 
ms54	 % % حاظ لا تتقى بغير القلوب % 4(@)(@@) % بين خيل من المدامة قرب % ن إلي السرور بالتقريب % 5(@)(@@) % و دنان أقمن صفا كما قا % % مغداة اللقاءرجل حروب % 6(@)(@@) % و بواط كأنهن وهاد % أترعتها سجال غيث سكوب % 7(@)(@@) % فكأن الكؤوس فيها جنوحا % أنجم الليل صوبت للمغيب % 8(@)(@@) % نحن أبناء هذه الكأس لا نع % دل عن شربها إلى مشروب % 9(@)(@@) % أدبتنا الأيام حين أرتنا % % بطش أحداثها بكل أديب % 10(@)(@@) % و علمنا أنا نصيب المنايا % % فأخذنا من الهوى بنصيب % PageV01P191 البحر : - 1(@)(@@) % لبست مصندلة الثياب فمن رأى % % قمرا تسربل بعدها أثوابا % % 2(@)(@@) % و حكت من الرشأ الربيب ثلاثة % عينا وجيدا مفتنا وإهابا % % PageV01P192 البحر : - 1(@)(@@) % فلقد حدا برق الغلي % % ل سحائب الدمع السكوب % 2(@)(@@) % لولاه لم يك للمنا % % زل في دموعي من نصيب % 3(@)(@@) % وردت عليه صوالج % لعبت بحبات القلوب % 4(@)(@@) % لما خطبت ندى الحسي % % ن أمنت غائلة الخطوب % 5(@)(@@) % قمر الندى بل ضيغم ال % % هيجاء في اليوم العصيب % 6(@)(@@) % فعفاته في مرتع % من سيب راحته خصيب % 7(@)(@@) % شيم حلين من الثنا % % ء كما عطلن من العيوب % 8(@)(@@) % بغرائب تهدي اللبا % % ب من الثناء إلى اللبيب % 9(@)(@@) % لو صافحت سمع المحب % لأذهلته عن الحبيب % PageV01P193 البحر : - 1(@)(@@) % و سألت عنهفقيل مات لما به % % قلب الندى لا شك مات لما به % % 2(@)(@@) % و كأنما بخل الزمان على الورى % % ببقائهأو هابهفبدا به % % 3(@)(@@) % فلمن أصون مدامعي من بعده % % و لأيما أبكيه من أسبابه % % 4(@)(@@) % لخطابه لجوابه لصوابه % % لحفاظه لثوابه لعقابه % % 5(@)(@@) % للحمل عن منتابهللنصح عن % % أسبابهللصفح عن مغتابه % % 6(@)(@@) % للبيض من أثوابهللزهر من % % آرائهللغر من آدابه % % 7(@)(@@) % لحجاهأم لنهاهأم لقراهأم % % لعلاهأم لنداه في أصحابه % % 8(@)(@@) % أم من يرجي بعده صرف الردى % % عن نفسه بجلاده وضرابه % % 9(@)(@@) % هيهات لا يغني البكاءإذا سطا % % أسد الزمان بمخلبيه ونابه % % 10(@)(@@) % و لئن سقاه الموت كأسا مرة % فليشربن الموت مثل شرابه % % PageV01P194 البحر : - 1(@)(@@) % فداؤك من أوردته منهل الردى % % و ورد الردى للعاشقين يطيب % 2(@)(@@) % و ما مات حتى أنحل الحب جسمه % % فلم يبق فيه للترابنصيب 
ms55	 % PageV01P195 البحر : - 1(@)(@@) % لما مضى يومك في اللذات % و في سرور معجب الأوقات % 2(@)(@@) % و أقبل الليل على ميقات % و نشر الغرب الممسكات % 3(@)(@@) % و مد حتى صرن مظلمات % قمنا إلى الصيد بمجلبات % 4(@)(@@) % مثل البدور الزهر طالعات % تخالها بالتبر مشربات % 5(@)(@@) % و سرج كالشهب ذاكيات % بمرعدات وبمبرقات % 6(@)(@@) % زاهرة كزاهر النبات % تراع منهن مها الفلاة % 7(@)(@@) % و أكلب تستغرق الصفات % ضوامر الأحشاء مخطفات % 8(@)(@@) % إلى دماء الصيد صاديات % باسطة الآذان سابغات % 9(@)(@@) % سواقط الأرجاء ساكنات % بلؤلؤ الطل مقرطات % 10(@)(@@) % فعن من سرب ومن ظبات % مشتبه التيجان والشيات % PageV01P196 11(@)(@@) % ترى الروامج مصندلات % قد جللتهن مفرجات % 12(@)(@@) % عن يقق البطون واللبات % و زينت منها ذرى الهامات % 13(@)(@@) % فطوقت من شبع طاقات % فلم تزل تنظر حائرات % 14(@)(@@) % راسفة رسف المقيدات % قد عميت عن سبل النجاة % 15(@)(@@) % ثمت صافحنا المجنبات % نحورها كثلة الرعاة % 16(@)(@@) % حتى إذا لاح الصباح الآتي % % و نشر الشرق معصفرات % 17(@)(@@) % تنقض حتى صرن مذهبات % قمنا بها بيضا مجردات % 18(@)(@@) % تحسبها العين مفضضات % فعدن منهن مخضبات % 19(@)(@@) % و ارتفعت قدورنا اللواتي % % تعتام في الخصب وفي الأزمات % 20(@)(@@) % ترى بنات الماء غاليات % مشرفة منها على الحافات % PageV01P197 21(@)(@@) % مثل كبار الراء طافيات % فهي وما فيها من الأقوات % 22(@)(@@) % للضيف والجيران والجارات % % PageV01P198 البحر : - 1(@)(@@) % رب صاف رقرقته % % الريح في متن صفاة % 2(@)(@@) % عبق من جر أذيا % % ل رياح عبقات % 3(@)(@@) % صافح الركبان منه % % صفحتي عذب فرات % 4(@)(@@) % أودعته الريح ما استو % دعها زهر النبات % 5(@)(@@) % فانثنوا عنه بأيد % خضرات عطرات % PageV01P199 البحر : - 1(@)(@@) % أهدت على نأي المحلو قد % % أنأى التصبر طول هجرتها % % 2(@)(@@) % نارنجة منها استعير لها % % ما ألبست من حسن بهجتها % % 3(@)(@@) % فشعاعها من نار وجنتها % % و نسيمها من عطر نكهتها % % 4(@)(@@) % و كأن ما يخفيه باطنها % % ما أضمرت من سوء غدرتها % % 5(@)(@@) % و حكى اخضرار شاب حمرتها % % قرص الأكف أديم وجنتها % % 6(@)(@@) % و أتتك مكملة محاسنها % % تختال في أثواب زينتها % % 7(@)(@@) % فشعارها صفر اللجينو من % % ذهب مصوغ ثوب بذلتها % % 8(@)(@@) % تهدي إلى الأرواح 
ms56	 من بعد % تحف السرور بطيب نشرتها % % 9(@)(@@) % و يصونها مسرى روائحها % % من أن تباشرها بشمتها % % 10(@)(@@) % فاشرب عليها من شقيقتها % % في نعت رياها وصيغتها % % PageV01P200 11(@)(@@) % و اعطف عنان النفس عن فكر % راحت معذبة بصحبتها % % PageV01P201 البحر : - 1(@)(@@) % أمقدم يا أبا المقدامأنت على % % شعريو تاركه أسلاب غارات % 2(@)(@@) % إني خلعت إليه العذر منسلخا % من الحجاسابحا في بحر غارات % 3(@)(@@) % و كيف شن أبو الغارات غارته % % علي مقتحما بالخيل ساحاتي % % 4(@)(@@) % إن المجانين لا تلحى إذا اجترمت % و لا تلام على إتيان سوءات % 5(@)(@@) % ما كنت أحذر عارات النبيط ولا % % أخاف عض كلاب مستكينات % % 6(@)(@@) % يا مدعي الشعر كن منه على وجل % فقد منيت بشيطان له عات % % 7(@)(@@) % ذللت ذلة ذي جهل و قد كثرت % في أخدعيك وفي اليافوخ ذلات % % 8(@)(@@) % صفع أخذت به شعري برمته % % فنلت ثأرك ثم ازددت ثارات % 9(@)(@@) % وهبك حاولت مدحا تستميح به % % فلم جريت على تلك الملامات % PageV01P202 البحر : - 1(@)(@@) % إني هديت لنعمة مكنونة % فأثرتها من تربة وصفاة % 2(@)(@@) % بئر كأن رشاءها في مائها % % سمراء قد ركزت على مرآة % 3(@)(@@) % كافورة الصيف التي تحيا بها % % طوقتها بفرائد اللبات % % 4(@)(@@) % طوقتها حجرا و لو أنصفتها % % طوقتها بقلائد اللبات % 5(@)(@@) % ملكت ثناء جوانحيفجميعها % % يثني بما أولت من الحسنات % 6(@)(@@) % و لكم منيت بغيرها فكأنما % % حاولت خير مضيع الخيرات % 7(@)(@@) % تعطيك بعد الكد ماء آجنا % طرقا كفقد الماء في الفلوات % PageV01P203 البحر : - 1(@)(@@) % شيم الأمير وفت لنا بعداتها % % فجرت سحائب جوده لعفاتها % % 2(@)(@@) % لا تعدم العلياء منه شمائلا ؛ % حسنات هذا الدهر من حسناتها % % 3(@)(@@) % نفديه إن كنا الفداء لنفسه % % من حادث الأيام أو نكباتها % % 4(@)(@@) % شكت العلى لما شكته جفونه % % فشكاته مقرونة بشكاتها % % 5(@)(@@) % قد قلت للأعداءمهلا إنها % % نوب تجلى الصبح من ظلماتها % % 6(@)(@@) % قالوااشتكى رمدا حمى أجفانه % % سنة الرقادو غض من لحظاتها % % 7(@)(@@) % فأجبتهم لم ترمد العين التي % % تحمر بأسا يوم حرب عداتها % % 8(@)(@@) % لكن رأته محاربا أمواله % % بنواله فجرت على عاداتها % % PageV01P204 البحر : - 1(@)(@@) % لا تأخذني بجرم كاسات % فما جناياتها جناياتي % % 2 
ms57	(@)(@@) % فالسكر برية بلا علم % يضل فيها أخو الهدايات % 3(@)(@@) % إن كنت عني الغداة منصرفا % فالحظ ثنائيو الحظ موالاتي % % 4(@)(@@) % و إن جرت زلة على سكر % فإنها اليوم بكر زلاتي % % PageV01P205 البحر : - 1(@)(@@) % لو سالمته سجايا طرفك الساجي % % لكان أول صب في الهوى ناجي % % 2(@)(@@) % سرت أوائل دمع العين حين سرت % % أوائل الحي من ظعن وأحداج % 3(@)(@@) % و من وراء سجوف الرقم شمس ضحى % تجول في جنح ليل مظلم داجي % % 4(@)(@@) % مقدودة خرطت أيدي الشباب لها % % حقين دون مجال العقد من عاج % 5(@)(@@) % كأن عبرتها يوم الفراق جرت % من ماء وجنتها أو ماء أوداج % 6(@)(@@) % ما للقوافي خطت قوما محاسنها % % و ألهجت بابن فهد أي إلهاج % % 7(@)(@@) % فكل يوم تريه روضة أنفا % تربي على الروض من حسن وإبهاج % 8(@)(@@) % مفوقات إذا استسقت أنامله % % ضحكن من عارض للجود ثجاج % 9(@)(@@) % ثنى المديح إليه عطفهفثنى % % أعطافهو منه في وشي وديباج % 10(@)(@@) % أغر ما حكمت يمناه في نشب % إلا تحكم فيه الآمل الراجي % % PageV01P206 11(@)(@@) % و متعب في طلاب المجد همته % % مواصل للسرى فيه بإدلاج % 12(@)(@@) % معمورة بذوي التيجان نسبته % % فما يعدد إلا كل ذي تاج % 13(@)(@@) % تسطو بأسمر يمضيه سنا قبس % بين الشراسيف والأحشاء ولاج % 14(@)(@@) % و البيض فوق متون الزعف خافقة % كأنهن حريق فوق أمواج % 15(@)(@@) % عزم إذا نابت الأقوام نائبة % تكشفت عن سراج منه وهاج % 16(@)(@@) % أبا الفوارسإني مطلق هممي % % فيما أحاول من نأي وإزعاج % 17(@)(@@) % منافر نفرا رثت حبالهم % و أنهج الجود فيهم أي إنهاج % 18(@)(@@) % ترى الأديب مضاعا بين أظهرهم % % كأنه عربي بين أعلاج % 19(@)(@@) % فليس يطربهم أني مدحتهم ؛ % و ليس يغضبهم أني لهم هاج % % 20(@)(@@) % و أنت تعلم أني جد لي سفر % إني إلى الكتب فيه جد محتاج % PageV01P207 21(@)(@@) % فما يطيل مقامي في ديارهم % إلا انتظار طوامير وأدراج % PageV01P208 البحر : - 1(@)(@@) % صرفت عن الكثير الوفر طرفي % % و ها أنا للقليل الوفر راجي % % 2(@)(@@) % و كم من نطفة عذبت وطابت % أحب إلي من بحر أجاج % PageV01P209 البحر : - 1(@)(@@) % و مجرد كالنصل أسلم نفسه 
ms58	 % % لمجرد يكسوه ما لا ينسج % 2(@)(@@) % ثوبا تمزقه الأنامل رقة % و يذيبه الماء القراحفيبهج % 3(@)(@@) % فكأنه لما التقى في خصره % % نصفان ذا عاج وذا فيروزج % PageV01P210 البحر : - 1(@)(@@) % و روضة آذريون قد زر وسطها % % نوافج مسك هيجت قلب مهتاج % 2(@)(@@) % تراها عيونا بالنهار روانيا % و عند غروب الشمس أزرار ديباج % PageV01P211 البحر : - 1(@)(@@) % سارية في الظلام مهدية % إلى النفوس الردى بلا حرج % 2(@)(@@) % شائلة في ذنيبها حمة % كأنها سبجة من السبج % PageV01P212 البحر : - 1(@)(@@) % رأيت الناس ذا جود ومنع % فذا يثنى عليهو ذاك يهجى % % 2(@)(@@) % و فقد الثلج في إبان قيظ % تذوب له الصخور الصم وهجا % % 3(@)(@@) % فجد بالقوت منه تحز ثناء % أراك بفضله أولى وأحجى % % 4(@)(@@) % و لا تتعجبن من برد شعري % % فإني طالب بالثلج ثلجا % % PageV01P213 البحر : - 1(@)(@@) % لما رأينا خمار الكأس يعلقنا % % عجنا إلى عاج أرضه سبج % 2(@)(@@) % بيت له داخل حل النعيم به % % و خارج فيه للقلب الشجي فرج % 3(@)(@@) % ذو قبة كسماء و البدور بها % % جاماتها في ذرى في الجوينشرج % 4(@)(@@) % حر وبرد سواء و الهواء به % % معدل قسمة ما شانها عوج % PageV01P214 البحر : - 1(@)(@@) % لمحة البارق من حيث لمح % طمحت للشوق وهنا فطمح % 2(@)(@@) % أذكرتنا الجيرة الغادين من % % برقة الأبرق والركب الروح % 3(@)(@@) % و الخيام المستقلات ضحى % % بظباء نزحت فيمن نزح % % 4(@)(@@) % و ترى الكارين مغبوقا به % % روق الغيث بهأو مصطبح % % 5(@)(@@) % و قرى دجلة تطفو فوقه % % واضحات النهج ما فيه وضح % % 6(@)(@@) % كل خفاق الجناحينإذا % % فارقته غمرة الماء جنج % % 7(@)(@@) % و الربا من شاطىء النهرإذا % % سرب الماء عليه وسرح % % 8(@)(@@) % و اختيال الروض في وشي الحيا % % و اعتراض الجو في قوس قزح % % 9(@)(@@) % وطن اللهوفمن مجروحة % دمعها الراحو دمع مجترح % % 10(@)(@@) % يسلم الدمع عليه نازح % لو رآه أسلم الدمع قزح % % PageV01P215 11(@)(@@) % حبذا أحناؤه لا المنحنى % % و ذرى الطلح به لا مطلح % % 12(@)(@@) % حيث ترب الأرض مسك راقد % فإذا نبهه القطر نفح % % 13(@)(@@) % و مقال الشرب للساقي أدر % فلك الراح وللطاهي برح % % 14(@)(@@) % يا ابن فهد أنت لي جار 
ms59	 إذا % % حادث أعضلأو خطب فدح % % 15(@)(@@) % كل قولي لك ما هذا ندى % حين قولي لأناس ما أشح % 16(@)(@@) % أربي أن أجلب الحمد إلى % % يعربي الفخرأو أهدي المدح % % 17(@)(@@) % وهب المجد له أوضاحه % % فارتداهنو للناس الترح % % 18(@)(@@) % بات يجري والحيا في طلق % كلما كل مجاريه جمح % % 19(@)(@@) % همة إن شامها غاضت به % % همة إن رامها لاح ألح % 20(@)(@@) % أصلح الله لك الدهرفقد % % أصلحت يمناك دهري فصلح % % PageV01P216 21(@)(@@) % هو عيش عاد في صحته % % و هلال عاد للسقم شبح % % 22(@)(@@) % و صيام أزعجت بارحه % % سانحات الفطر من حيث سنح % % 23(@)(@@) % و رياض تجتلى في طرف % نظم القطر حلاها وملح % % 24(@)(@@) % فإذا مر بها مرتجز % عاد فيها هزج الصوت أبح % 25(@)(@@) % فالبس البرد الذي منه ضفا % % و ادخل الباب الذي منه انفتح % % 26(@)(@@) % و اقتدح نار سرور زندها % % حين يخبووجه ساق وقدح % % 27(@)(@@) % بين أوتار إذا ما استنطقت % نثر العناب فيه والبلح % % 28(@)(@@) % و إذا ازددت لشيء فرحا % فليزد شانيكهما وترح % % PageV01P217 البحر : - 1(@)(@@) % قل للأمير الذي علا فغدا % % مرتديا بالعلى ومتشحا % % 2(@)(@@) % فتحت باب العلى و مثلك لا % % يغلق باب الندى الذي فتحا % % 3(@)(@@) % حاشاك أن تعدم السماحو أن % % يخيب راجيك بعد ما نجحا % % 4(@)(@@) % و أن يقول العذول مبتهجا % أفاق من نشوة الندى فصحا % % 5(@)(@@) % نشدتك الله والذين غدا % % فضلهم في الكتاب متضحا % % 6(@)(@@) % لا تقطعن عادتي التي سلفت % و لا تردن سرحتي برحا % % PageV01P218 البحر : - 1(@)(@@) % سأحتج للملحي أقوم حجة % و إن كان شعري من ظباه جريحا % % 2(@)(@@) % يقولون قفصي عسا بظر أمه % و سالمه الموسى فراح صحيحا % % 3(@)(@@) % و ما ضره أن صافح البظر وجهه % إذا كان مختون اللسانفصيحا % % PageV01P219 البحر : - 1(@)(@@) % على الرغم بدلت من رغم لاح % % و من نزهي في الوجوه الصباح % 2(@)(@@) % و شربي المدامة ممزوجة % محرمها بالحلال المباح % 3(@)(@@) % و مخطفة القد مهتزة % تباكرني قبل حين الصباح % 4(@)(@@) % فتسفر عن مثل ورد الربيع % و تبسم عن مثل نور الأقاحي % % 5(@)(@@) % بيوم يجد به الدارعون % فلا يعرفون سبيل المزاح % 6 
ms60	(@)(@@) % ترش به السمر طعنا ترى % % مواقفنا منه حمر النواحي % % 7(@)(@@) % و يخطر في هبوتيه الكمي % بقلب جريء ووجه وقاح % 8(@)(@@) % و سابغة مثل سرد الشجاع % أو الماء عند هبوب الرياح % 9(@)(@@) % و أبيض يلمع في متنه % إذا ضلبرق الحمام المتاح % 10(@)(@@) % فمن راح يسخط عذاله % % و يرضي الهوى بين عود وراح % PageV01P220 11(@)(@@) % فإني عدمت تثني القدود % و بدلت منه بثني الرماح % 12(@)(@@) % و كنت أشيم بروق الثغور % فصرت أشيم بروق الصفاح % 13(@)(@@) % و ما إن سمعت غناء الحدي % % دإلا ذكرت غناء الوشاح % 14(@)(@@) % فليت ضجيعيليل التما % % ميعلم أني ضجيع السلاح % 15(@)(@@) % أراعي المنية عند الغدو % و أنتظر الحتف عند الرواح % 16(@)(@@) % و لو أن لي حيلة في الفرار % فررت وهان علي افتضاحي % % 17(@)(@@) % متى أطإ الأرض مبيضة % جوانبها أو أرى الجو صاح % % 18(@)(@@) % فألبس خيل الوغى راحة % و أتعب في اللهو خيل المراح % 19(@)(@@) % عسى القرب يطفىء من لوعتي % % و ينقص من غلتي والتياحي % % PageV01P221 البحر : - 1(@)(@@) % زدني من العذل فيها أيها اللاحي % % إن الفؤاد إليها جد مرتاح % 2(@)(@@) % بيضاء تنظر من طرف تقلبه % مفرق بين أجسام وأرواح % 3(@)(@@) % ماء النعيم على ديباج وجنتها % % يجول بين جنى ورد وتفاح % 4(@)(@@) % رقت فلو مزج الماء القراح بها % % والراح لامتزجت بالماء والراح % PageV01P222 البحر : - 1(@)(@@) % لم ألق ريحانةو لا راحا % % إلا ثنتني إليك مرتاحا % % 2(@)(@@) % و عندنا ظبية مهفهفة % ترأم طفلا هناك صداحا % % 3(@)(@@) % تفسد قلبي إن أفسدتهو لا % % أرى لما أفسدته إصلاحا % % 4(@)(@@) % و فتية إن تذكروا ذكروا % % من الكلام المليح أرواحا % % 5(@)(@@) % و قد أضاءت نجوم مجلسنا % % حتى اكتسى غرة وأوضاحا % % 6(@)(@@) % لو جمدت راحنا غدت ذهبا % أو ذاب تفاحنا اغتدى راحا % % 7(@)(@@) % عصابة لو شهدت مجلسهم % % كنت شهابا لهم ومصباحا % % 8(@)(@@) % أغلق باب السرور دونهم % فكن لباب السرور مفتاحا % % PageV01P223 البحر : - 1(@)(@@) % قامت تثنى بين أترابها % % و فائح العنبر منها يفوح % 2(@)(@@) % راهبة لله في نسوة % قد ألبست قضب اللجين المسوح % % 3(@)(@@) % كأنهاإذ سفرتروضة % ألبسها الزهر صبيحا مليح % % 4(@)(@@) % لولاك لم أمش 