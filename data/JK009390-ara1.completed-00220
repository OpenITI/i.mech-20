ms201	 بن مغفل رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1884 ) قال النبي :(@)(@@) | 30 ( إذا ولغ الكلب في الإناء فاغسلوه سبع مرار ، السابعة بالتراب ) )(@)(@@) ( د ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@) PageV01P277(@)(@@)(@@)(@@) $ ( 1885 ) قال النبي :(@)(@@) | 30 ( إذا ولغ الكلب في إناء أحدكم فليرقه ثم ليغسله سبع مرات ) )(@)(@@) ( م ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1886 ) قال النبي :(@)(@@) | 30 ( إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات ) )(@)(@@) ( ن ه ) عن أبي هريرة عن ابن عمر ( البزار ) عن ابن عباس رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 1887 ) قال النبي :(@)(@@) | 30 ( إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات إحداهن بالبطحاء ) )(@)(@@) ( قط ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1888 ) قال النبي :(@)(@@) | 30 ( إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات أولاهن بالتراب ) )(@)(@@) ( حم ن ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1889 ) قال النبي :(@)(@@) | 30 ( إذا ولي أحدكم أخاه فليحسن كفنه ) )(@)(@@) ( حم م د ن ) عن جابر ( ت ه ) عن أبي قتادة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1890 ) قال النبي :(@)(@@) | 30 ( إذا ولي أحدكم أخاه فليحسن كفنه فإنهم يبعثون في أكفانهم ، ويتزاورون في أكفانهم ) )(@)(@@) ( سمويه عق خط ) عن الحارث عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1891 ) قال النبي :(@)(@@) | 30 ( إذا هبطت بلاد قومه فاحذره فإنه قد قال القائل أخوك البكري ولا تأمنه ) )(@)(@@) ( حم د ) عن عمرو بن الفغواء رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1892 ) قال النبي :(@)(@@) | 30 ( إذا هلك كسرى فلا كسرى بعده ، وإذا هلك قيصر فلا قيصر بعده ، والذي نفسي بيده لتنفقن كنوزهما في سبيل الله ) )(@)(@@) ( حم ق ) عن PageV01P278 جابر بن سمرة ( حم ق ت ) عن أبي هريرة رضي الله عنهم ( ز ) .(@)(@@)(@@)(@@) $ ( 1893 ) قال النبي :(@)(@@) | 30 ( إذا هم أحدكم بالأمر فليركع ركعتين من غير الفريضة ثم ليقل : اللهم إني أستخيرك بعلمك وأستقدرك بقدرتك ، وأسألك من فضلك العظيم ، فإنك تقدر ولا أقدر ، وتعلم ولا أعلم وأنت علام الغيوب ، اللهم فإن كنت تعلم هاذا الأمر ، وتسميه باسمه ، خيرا لي في ديني ومعاشي وعاقبة أمري فاقدره لي ويسره لي ثم يارك 
ms202	 لي فيه وإن كنت تعلمه شرا لي في ديني ومعاشي وعاقبة أمري فاصرفني عنه واصرفه عني ، واقدر لي الخير حيث كان ثم رضني به ) )(@)(@@) ( حم خ 4 ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1894 ) قال النبي :(@)(@@) | 30 ( إذا هممت بأمر فاستخر ربك فيه سبع مرات ، ثم انظر إلى الذي يسبق إلى قلبك فإن الخيرة فيه ) )(@)(@@) ( ابن السنى ) في عمل يوم وليلة ( فر ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1895 ) قال النبي :(@)(@@) | 30 ( اذبحوا لله في أي شهر كان ، وبروا لله وأطعموا ) )(@)(@@) ( د ن ه ك ) عن نبشة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1896 ) قال النبي :(@)(@@) | 30 ( أذكر الله فإنه عون لك على ما تطلب ) )(@)(@@) ( ابن عساكر ) عن عطاء بن أبي مسلم مرسلا .(@)(@@)(@@)(@@) $ ( 1897 ) قال النبي :(@)(@@) | 30 ( أذكر الموت في صلاتك فإن الرجل إذا ذكر الموت في صلاته لحري أن يحسن صلاته ، وصل صلاة رجل لا يظن أنه يصلي صلاة غيرها ، وإياك وكل أمر يعتذر منه ) )(@)(@@) ( فر ) عن أنس رضي الله عنه وحسنه الحافظ ابن حجر وهو نادر في مفاريد مسند الفردوس فإن أكثرها ضعاف ( ز ) .(@)(@@) PageV01P279(@)(@@)(@@)(@@) $ ( 1898 ) قال النبي :(@)(@@) | 30 ( اذكروا الله ذكرا خاملا ، قيل : وما الذكر الخامل ؟ قال : الذكر الخامل الذكر الخفي ) )(@)(@@) ( ابن المبارك ) في الزهد عن ضمرة بن حبيب مرسلا .(@)(@@)(@@)(@@) $ ( 1899 ) قال النبي :(@)(@@) | 30 ( أذكروا الله ذكرا يقول المنافقون إنكم تراؤون ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1900 ) قال النبي :(@)(@@) | 30 ( أذكروا محاسن موتاكم وكفوا عن مساوئهم ) )(@)(@@) ( د ت ك هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1901 ) قال النبي :(@)(@@) | 30 ( أذن في الناس أن من كان أكل فليصم بقية يومه ، ومن لم يكن أكل فليصم فإن اليوم يوم عاشوراء ) )(@)(@@) ( حم ق ن ) عن سل مة بن الأكوع ( م ) عن الربيع بنت معوذ رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1902 ) قال النبي :(@)(@@) | 30 ( أذن في الناس أنه من شهد أن لا إلاه إلا الله وحده لا شريك له مخلصا دخل الجنة ) )(@)(@@) ( البزار ع ) عن عمر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1903 ) قال النبي :(@)(@@) | 30 
ms203	 ( إذنك علي أن يرفع الحجاب وأن تستمع لسوادي حتى أنهاك ) )(@)(@@) ( حم م ه ) عن ابن مسعود رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1904 ) قال النبي :(@)(@@) | 30 ( أذن لي أن أحدث عن ملك من حملة العرش رجلاه في الأرض السفلى وعلى قرنه العرش ، وبين شحمة أذنيه وعاتقه خفقان الطير سبعمائة عام ، يقول ذالك الملك سبحانك حيث كنت ) )(@)(@@) ( طس ) عن أنس رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1905 ) قال النبي :(@)(@@) | 30 ( أذن لي أن أحدث عن ملك من ملائكة الله تعالى من حملة العرش ما بين شحمة أذنه إلى عاتقه مسيرة سبعمائة سنة ) )(@)(@@) ( د و الضياء ) عن PageV01P280 جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1906 ) قال النبي :(@)(@@) | 30 ( أذهب الباس رب الناس ، اشف أنت الشافي لا شفاء إلا شفاؤك شفاء لا يغادر سقما ) )(@)(@@) ( حم د ه ) عن ابن مسعود ( حم ه ) عن عائشة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1907 ) قال النبي :(@)(@@) | 30 ( اذهبا توضيا ثم استهما ثم اقتسما ، ثم ليحلل كل واحد منكما صاحبه ) )(@)(@@) ( ك ) عن أم سلمة ( ز ) .(@)(@@)(@@)(@@) $ ( 1908 ) قال النبي :(@)(@@) | 30 ( اذهب بنعلي هاتين فمن لقيت من وراء هاذا الحائط يشهد إن لا إلاه إلا الله مستيقنا بها قلبه فبشره بالجنة ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1909 ) قال النبي :(@)(@@) | 30 ( أذهبتم من عندي جميعا وجئتم متفرقين إنما أهلك من كان قبلكم الفرقة ) )(@)(@@) ( حم ) عن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1910 ) قال النبي :(@)(@@) | 30 ( اذهب فاغتسل بماء وسدر وألق عنك شعر الكفر ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1911 ) قال النبي :(@)(@@) | 30 ( اذهب فانظر إليها فإنه أحرى أن يؤدم بينكما ) )(@)(@@) ( حم قط ك هق ) عن أنس ( حم ه قط طب هق ) عن المغيرة بن شعبة رضي الله عنهما ( ز ) .(@)(@@)(@@)(@@) $ ( 1912 ) قال النبي :(@)(@@) | 30 ( اذهب فإن في البيت ثلاثة منهم غلام قد صلى فخذه ولا تضربه فإنا قد نهينا عن ضرب أهل الصلاة ) )(@)(@@) ( هب ) عن أبي أمامة رضي الله عنه ( ز ) .(@)(@@) PageV01P281(@)(@@)(@@)(@@) $ ( 1913 ) قال النبي :(@)(@@) | 30 ( اذهب فقد ملكتكها بما معك من القرآن ) )(@)(@@) ( ق ن ) عن سهل 
ms204	 بن سعد رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1914 ) قال النبي :(@)(@@) | 30 ( اذهبوا إلى صاحبكم فأخبروه أن ربي قد قتل ربه الليلة ، يعني كسرى ) )(@)(@@) ( أبو نعيم ) عن دحية رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1915 ) قال النبي :(@)(@@) | 30 ( اذهبوا بهاذا الماء ، فإذا قدمتم إلى بلدكم فاكسروا بيعتكم وانفحوا مكانها من هاذا الماء ، واتخذوها مسجدا ) )(@)(@@) ( حم حب ) عن طل ق بن علي رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1916 ) قال النبي :(@)(@@) | 30 ( اذهبوا بهاذه الخميصة إلى أبي جهم بن حذيفة وأتوني بأنبجانيته فإنها ألهتني آنفا في صلاتي ) )(@)(@@) ( ق د ن ه ) عن عائشة رضي الله عنها ( ز ) .(@)(@@)(@@)(@@) $ ( 1917 ) قال النبي :(@)(@@) | 30 ( اذهبوا به يعني بأبي قحافة إلى بعض نسائه فليغيره بشيء وجنبوه السواد ) )(@)(@@) ( حم م ) عن جابر رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1918 ) قال النبي :(@)(@@) | 30 ( اذهبوا فقاسموهم أنصاف الأموال ولا تمسوا ذراريهم لولا أن الله لا يحب ضلالة العمل ما رزيناكم عقالا ) )(@)(@@) ( د ) عن الذؤيب العنبري رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 1919 ) قال النبي :(@)(@@) | 30 ( أذيبوا طعامكم بذكر الله والصلاة ولا تناموا عليه فتقسوا قلوبكم ) )(@)(@@) ( طس عد ) و ابن السنى وأبو نعيم في الطب ( هب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) |||| ( الإكمال من الجامع الكبير )(@)(@@)(@@)(@@) $ ( 1920 ) قال النبي :(@)(@@) | 30 ( إذ انبعث أشقاها انبعث لها رجل عزيز عارم منيع في PageV01P282 رهطه مثل أبي زمعة ) )(@)(@@) ( حم خ م ت ) عن عبد الله بن زمعة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1921 ) قال النبي :(@)(@@) | 30 ( إذا أتاك الله من هاذا المال من غير مسألة ولا إشراف فخذه فكله وتموله ) )(@)(@@) ( كر ) عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1922 ) قال النبي :(@)(@@) | 30 ( إذا أتاك الله مالا فلير عليك ) )(@)(@@) ( حب ) عن أبي الأحوص عن أبيه .(@)(@@)(@@)(@@) $ ( 1923 ) قال النبي :(@)(@@) | 30 ( إذا ابتلي أحدكم بالقضاء بين المسلمين فلا يرفع صوته على أحد الخصمين أكثر من الآخر في النقاش ) )(@)(@@) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1924 ) قال النبي :(@)(@@) | 30 ( إذا بغض الله عبدا نزع منه الحياء فإذا نزع منه الحياء لم تلقه إلا بغيضا مبغضا ، فنزع منه الأمانة ، فإذا نزع منه 
ms205	 الأمانة نزع منه الرحمة ، فإذا نزع منه الرحمة نزع منه ربقة الإسلام ، وإذا نزع منه ربقة الإسلام لم تلقه إلا شيطانا مريدا ) )(@)(@@) ( هب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1925 ) قال النبي :(@)(@@) | 30 ( إذا أبق العبد لم تقبل له صلاة حتى يرجع إلى مواليه ) )(@)(@@) ( م ) و ابن خزيمة وأبو عوانة والباوردي عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1926 ) قال النبي :(@)(@@) | 30 ( إذا أبق العبد فلحق بالعدو فمات فهو كافر ) )(@)(@@) ( حم ) وابن خزيمة ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1927 ) قال النبي :(@)(@@) | 30 ( إذا أبق العبد فقد برئت منه ذمة الله ورسوله ) )(@)(@@) ( طب ) عن جرير ( عد ) عن أبي هريرة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1928 ) قال النبي :(@)(@@) | 30 ( إذا أبق العبد ثم أبق فبيعوه ولا تعذبوا خلق الله ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ 1929 قال النبي :(@)(@@) | 30 ( إذا أبق العبد لم تقبل له صلاة وإن مات مات كافرا ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@) PageV01P283(@)(@@)(@@)(@@) $ ( 1930 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم فراشه فليقل : اللهم رب السماوات ورب الأرض ، ربنا ورب كل شيء أنت آخد بناصيته ، أنت الأول فليس قبلك شيء ، وأنت الآخر فليس بعدك شيء ، وأنت الباطن فليس دونك شيء ، اغننا من الفقر واقض عنا الدين ) )(@)(@@) ( ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1931 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم فراشه فلينزع داخلة إزاره ثم لينفض بها فراشه فإنه لا يدري ما حدث عليه بعده ثم ليضطجع على جنبه الأيمن ثم ليقل : باسمك ربي وضعت جنبي وبك أرفعه ، فإن أمسكت نفسي فارحمها وإن أرسلتها فاحفظها بما حفظت به عبادك الصالحين ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1932 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم مجلسا فليسلم فإن بدا له أن يجلس جلس ، فإن أراد أن يقوم فليسلم فليست الأولى بأحق من الآخرة ) )(@)(@@) ( ابن السنى ) في عمل يوم وليلة ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1933 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم أهله فليستر عليه وعلى أهله ولا يتعريان تعري الحمير ) )(@)(@@) ( طب 
ms206	 ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1934 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم أهله فليلق على عجزه وعجزها ثوبا ولا يتجردان تجرد العيرين ) )(@)(@@) ( قط ) في الإفراد عن عبد الله بن سرجس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1935 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم الجمعة فليغتسل ) )(@)(@@) ( د ) عن عمر ( د ت ك ) عن أبي هريرة رضي الله عنهما .(@)(@@) PageV01P284(@)(@@)(@@)(@@) $ ( 1936 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم الغائط فليكرم قبلة الله فلا يستقبلن القبلة ، واتقوا مجالس اللعن : الظل والماء وقارعة الطريق ) )(@)(@@) حرب بن إسماعيل الكرماني في مسائله والطبري في تهذيبه عن سراقة بن مالك رضي الله عنه وضعف ، وقال أبو حاتم إنما يروونه موقوفا وأسنده ( عب ) بآخرة .(@)(@@)(@@)(@@) $ ( 1937 ) قال النبي :(@)(@@) | 30 ( إذا أتى الرجل امرأته وهي حائض فليتصدق بدينار أو نصف دينار ) )(@)(@@) ( د ت ن ه ك ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1938 ) قال النبي :(@)(@@) | 30 ( إذا أتى الرجل أخاه يعوده مشى في خرافة الجنة حتى يجلس ، فإذا جلس غمرته الرحمة فإن كان غدوة صلى عليه سبعون ألف ملك حتى يمسي ، وإن كان مسيا صلى عليه سبعون ألف ملك حتى يصبح ) )(@)(@@) ( هب ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1939 ) قال النبي :(@)(@@) | 30 ( إذا أتى أحدكم على راع فليناد يا راعي الإبل ثلاثا ، فإن أجابه وإلا فليحلب وليشرب ولا يحملن ، وإذا أتى أحدكم على حائط فليناد ثلاثا يا صاحب الحائط فإن أجابه وإلا فليأكل ولا يحملن ) )(@)(@@) ( حب هق ) وضعفه عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1940 ) قال النبي :(@)(@@) | 30 ( إذا أتاك المصدق فأعطه صدقتك ، فإن اعتدى عليك فوله ظهرك ولا تلعنه وقل اللهم إني أحتسب عندك ما أخذ مني ) )(@)(@@) ( ك ) في تاريخه ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1941 ) قال النبي :(@)(@@) | 30 ( إذا أتاكم شريف قوم فأكرموه ) )(@)(@@) للدولابي ( كر ) عن أبي راشد .(@)(@@)(@@)(@@) $ ( 1942 ) قال النبي :(@)(@@) | 30 ( إذا أتيت أهلك فاعمل عملا كيسا ) )(@)(@@) ( خط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1943 ) قال النبي :(@)(@@) | 30 ( إذا أتيت أهلك ثم أردت أن تعود فتوضأ وضوءك PageV01P285 للصلاة ) )(@)(@@) ( عد هق ) عن 
ms207	 ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1944 ) قال النبي :(@)(@@) | 30 ( إذا أتيت مسجد صنعاء فاجعله عن يمين ، جبل يقال له صبير ) )(@)(@@) ( طس ) عن وبر بن عيسى الخزاعي .(@)(@@)(@@)(@@) $ ( 1945 ) قال النبي :(@)(@@) | 30 ( إذا أتيتم الغائط فلا تستقبلوا القبلة ولا تستدبروها ببول ولا غائط ولاكن شرقوا وغربوا ) )(@)(@@) ( ض حم د ت ك ) عن أبي أيوب رضي الله عنه قال ( ت ) هو أحسن شيء في الباب وأصح .(@)(@@)(@@)(@@) $ ( 1946 ) قال النبي :(@)(@@) | 30 ( إذا أتيتم الصلاة فلا تأتوها تسعون وأتوها تمشون ، وعليكم بالسكينة فما أدركتم فصلوا وما فاتكم فاقضوا ) )(@)(@@) ( ن حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1947 ) قال النبي :(@)(@@) | 30 ( إذا أتيتم الصلاة فأتوا وعليكم السكينة فصلوا ما أدركتم واقضوا ما سبقتم ) )(@)(@@) ( ن حب ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1948 ) قال النبي :(@)(@@) | 30 ( إذا أتيتم الصلاة فأتوها وعليكم السكينة والوقار فما أدركتم فصلوا وما فاتكم فأتموا ) )(@)(@@) ( خط ) في المتفق والمفترق عن البراء بن عازب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1949 ) قال النبي :(@)(@@) | 30 ( إذا أتيتم على أعطان الإبل فلا تصلوا فيها ، وإذا أتيتم أعطان الغنم فصلوا فيها إن شئتم ) )(@)(@@) ( هق ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1950 ) قال النبي :(@)(@@) | 30 ( إذا أتي أحدكم بريح طيب فليصب منها ) )(@)(@@) ( عد ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1951 ) قال النبي :(@)(@@) | 30 ( إذا أتي أحدكم بالطيب فليمس منه ، وإذا أتي بالحلو فليصب منها ) )(@)(@@) ( هب ) عن أبي هريرة رضي الله عنه وقال ( هب ) تفرد بن فضالة بن PageV01P286 حصين العطار وكان مهتما بهذا الحديث .(@)(@@)(@@)(@@) $ ( 1952 ) قال النبي :(@)(@@) | 30 ( إذا أتي أحدكم بهدية فجلساؤه وشركاؤه فيها ) )(@)(@@) ( الحكيم ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1953 ) قال النبي :(@)(@@) | 30 ( إذا اجتمع عيدان في يوم أجزأهم الأول ) )(@)(@@) ( د ن ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1954 ) قال النبي :(@)(@@) | 30 ( إذا اجتمع أهل النار في النار ومعهم من شاء الله من أهل القبلة قال الكفار للمسلمين ألم تكونوا مسلمين قالوا : بلى ، قالوا : فما أغنى عنكم إسلامكم وقد صرتم معنا في النار ؟ قالوا : كانت لنا ذنوب فأخذنا بها 
ms208	 فسمع الله ما قالوا فأمر بمن كان في النار من أهل القبلة فاخرجوا فلما رأى ذالك من بقي من الكفار قالوا : يا ليتنا كنا مسلمين فنخرج كما خرجوا ، فذالك قوله : { ربما يود الذين كفروا لو كانوا مسلمين } ) )(@)(@@) ابن أبي عاصم في السنة وابن جرير وابن أبي حاتم ( طب ) وابن مردويه ( ك هق ) في البعث عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1955 ) قال النبي :(@)(@@) | 30 ( إذا اجتمع ثلاثة مسلمين فليؤمهم أقرؤهم لكتاب الله وإن كان أصغرهم ، فإن أمهم فهو أميرهم ) )(@)(@@) ( ش ) عن أبي سلمة بن عبد الرحمن مرسلا .(@)(@@)(@@)(@@) $ ( 1956 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله تعالى عبدا اقتناه لنفسه ولم يشغله بزوجة ولا ولد ) )(@)(@@) ( حل ) و الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1957 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا ابتلاه ، وإذا أحبه الحب البالغ اقتناه ، لا يترك له مالا ولا ولدا ) )(@)(@@) ( طب ) عن أبي عتبة الخولاني .(@)(@@)(@@)(@@) $ ( 1958 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا صب عليه البلاء صبا ثجه ثجا ) )(@)(@@) ( طب ) عن أنس رضي الله عنه .(@)(@@) PageV01P287(@)(@@)(@@)(@@) $ ( 1959 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله قوما ابتلاهم ، فمن صبر فله الصبر ، ومن جزع فله الجزع ) )(@)(@@) ( هب ) عن محمود بن لبيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1960 ) قال النبي :(@)(@@) | 30 ( إذا أحب الله عبدا أثنى عليه سبعة أصناف من الخير لم يعمله ، وإذا سخط على عبد أثنى عليه سبعة أصناف من الشر لم يعمله ) )(@)(@@) ( هق ) في الزهد عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1961 ) قال النبي :(@)(@@) | 30 ( إذا أحب أحدكم أخاه فليخبره وليقل إني أحبك في الله وإني أودك في الله عز وجل ) )(@)(@@) ( ابن أبي الدنيا ) عن مجاهد مرسلا .(@)(@@)(@@)(@@) $ ( 1962 ) قال النبي :(@)(@@) | 30 ( إذا أحببت رجلا فاسأله عن اسمه واسم أبيه وعشيرته ومنزله ، فإن كان مريضا عدته ، وإن كان في حاجة أعنته ، وإن كان غائبا حفظته في أهله ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1963 ) قال النبي :(@)(@@) | 30 ( إذا أحدث الرجل وقد جلس في آخر صلاته قبل أن يسلم 
ms209	 فقد جازت صلاته ) )(@)(@@) ( ت ) وضعفه و ابن جرير عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1964 ) قال النبي :(@)(@@) | 30 ( إذا أحدث الإمام في آخر صلاته حين يستوي قاعدا فقد تمت صلاته وصلاة من وراءه على مثل صلاته ) )(@)(@@) ( عب ) و ابن جرير ( طب ) عن ابن عمرو وفيه عبد الرحمن بن زياد ( ضعيف ) .(@)(@@)(@@)(@@) $ ( 1965 ) قال النبي :(@)(@@) | 30 ( إذا أحدث الإمام بعد ما يرفع رأسه من آخر السجود واستوى جالسا تمت صلاته وصلاة من خلفه ممن ائتم به ممن أدرك معه أول الصلاة ) )(@)(@@) ( ابن جرير ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1966 ) قال النبي :(@)(@@) | 30 ( إذا أحدثت ذنبا فأحدث عنده توبة ، إن سرا فسرا ، وإن علانية فعلانية ) )(@)(@@) ( الديلمي ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1967 ) قال النبي :(@)(@@) | 30 ( إذا أحرم أحدكم فليؤمن على دعائه ، إذا قال اللهم اغفر لي فليقل آمين ، ولا يلعن بهيمة ولا إنسانا فإن دعاءه مستجاب ، ومن عم PageV01P288 بدعائه المؤمنين والمؤمنات استجيب له ) )(@)(@@) ( الديلمي ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1968 ) قال النبي :(@)(@@) | 30 ( إذا أحسستم من أنفسكم رقة فاغتنموا الدعاء ) )(@)(@@) الديلمي عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1969 ) قال النبي :(@)(@@) | 30 ( إذا أحسن العبد فألصق الله به البلاء فإن الله عز وجل يريد أن يصافيه ) )(@)(@@) ( هناد هب ) عن سعيد بن المسيب مرسلا .(@)(@@)(@@)(@@) $ ( 1970 ) قال النبي :(@)(@@) | 30 ( إذا اختلف البيعان فالقول ما قال البائع ، وإذا استهلك فالقول ما قال المشتري ) )(@)(@@) ( قط ) في الأفراد عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1971 ) قال النبي :(@)(@@) | 30 ( إذا اختلف المتبايعان وليس بينهما شاهد استحلف البائع ثم كان المبتاع بالخيار ، إن شاء أخذ وإن شاء ترك ) )(@)(@@) ( هق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1972 ) قال النبي :(@)(@@) | 30 ( إذا اختلفت أمتي في الأهواء فعليكم بدين الأعراب ) )(@)(@@) ( عد ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1973 ) قال النبي :(@)(@@) | 30 ( إذا اختلفت عليك الأشياء وكثرت الأحاديث فإن الهدى أن تدع ما يريبك إلى ما لا يريبك ) )(@)(@@) ( الديلمي ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1974 ) قال النبي :(@)(@@) | 30 ( إذا اختلفتم في الطريق فإذرعوا 
ms210	 سبعة أذرع ولا تجعلوا أقل منه ذالك ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1975 ) قال النبي :(@)(@@) | 30 ( إذا اختلفتم في الطريق فاجعلوه سبعة أذرع ، ومن بنى بناء فليدعمه حائط جاره ) )(@)(@@) ( حم هق ) عن ابن عباس رضي الله عنهما .(@)(@@) PageV01P289(@)(@@)(@@)(@@) $ ( 1976 ) قال النبي :(@)(@@) | 30 ( إذا اختلفتم في الطريق فإذرعوا سبعة أذرع ثم ابنوا ) )(@)(@@) ( عب ) عن عكرمة مرسلا .(@)(@@)(@@)(@@) $ ( 1977 ) قال النبي :(@)(@@) | 30 ( إذا أخذ أحدكم فليأخذ بيمينه ، وإذا أكل فليأكل بيمينه ، وإذا شرب فليشرب بيمينه فإن الشيطان يأكل بشماله ويعطي بشماله ويشرب بشماله ) )(@)(@@) ( طس ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1978 ) قال النبي :(@)(@@) | 30 ( إذا أخذ المؤذن في الإقامة فلا صلاة إلا المكتوبة ) )(@)(@@) ( الديلمي ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1979 ) قال النبي :(@)(@@) | 30 ( إذا أخذت مضجعك فاقرأ قل يا أيها الكافرون ) )(@)(@@) ( ن ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1980 ) قال النبي :(@)(@@) | 30 ( إذا أخذت مضجعك فتوضأ وضوءك للصلاة ثم اضطجع على شقك الأيمن ثم قل : اللهم أسلمت وجهي إليك ، وفوضت أمري إليك ، وألجأت ظهري إليك رغبة ورهبة إليك ، لا ملجأ ولا منجا منك إلا إليك ، آمنت بكتابك الذي أنزلت ، ونبيك الذي أرسلت واجعله آخر ما تقول فإن مت في ليلتك مت على الفطرة ) )(@)(@@) ( ت ) حسن صحيح ، و ابن جرير ( حب ) عن البراء قال ( ت ) ولا نعلم في شيء من الروايات ذكر الوضوء إلا في هاذا الحديث ، رواه ابن جرير بدون ذكر الوضوء ، وزاد في آخره : ( وإن أصبحت أصبحت وقد أصبت خيرا ) .(@)(@@)(@@)(@@) $ ( 1981 ) قال النبي :(@)(@@) | 30 ( إذا أخذت مضجعك من الليل فقل : اللهم أسلمت نفسي إليك ، ووجهت وجهي إليك ، وفوضت أمري إليك ، وألجأت ظهري إليك ، آمنت بكتابك المنزل ، ونبيك المرسل ، اللهم أسلمت نفسي إليك ، أنت خلقتها ، لك محياها ولك مماتها ، إن أمسكتها فارحمها ، وإن أخرتها فاحفظها بحفظ الإيمان ) )(@)(@@) ( ش ) و ابن جرير ( طب ) وابن السني عن عمار رضي الله عنه .(@)(@@) PageV01P290(@)(@@)(@@)(@@) $ ( 1982 ) قال النبي :(@)(@@) | 30 ( إذا أخذت مضجعك فقل : أعوذ بكلمات الله التامة من غضبه وعقابه وشر عباده ومن همزات الشياطين وأن يحضرون فإنه 
ms211	 لا يضرك ، وبالحري أن لا يضرك ) )(@)(@@) ( حم ) و ابن السنى في عمل يوم وليلة عن الوليد بن الوليد بن المغيرة .(@)(@@)(@@)(@@) $ ( 1983 ) قال النبي :(@)(@@) | 30 ( إذا أخذت مضجعك فقولي : الحمد لله الكافي ، سبحان الله الأعلى ، حسبي الله وكفى ، ما شاء الله قضى ، سمع الله لمن دعا ، ليس من الله ملجا ، ولا وراء الله ملتجا ، توكلت على ربي وربكم ، ما من دابة إلا هو آخد بناصيتها ، إن ربي على صراط مستقيم ، الحمد لله الذي لم يتخذ ولدا ، ولم يكن له شريك في الملك ، ولم يكن له ولي من الذل وكبره تكبيرا ، ما من مسلم يقولها عند منامه ثم ينام وسط الشياطين والهوام فتضره ) )(@)(@@) ( ابن السنى ) عن فاطمة الزهراء رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1984 ) قال النبي :(@)(@@) | 30 ( إذا أدخل الله أهل الجنة الجنة وأهل النار النار قال : يا أهل الجنة كم لبثتم في الأرض عدد سنين ؟ قالوا : لبثنا يوما أو بعض يوم ، قال : نعما اتجرتم في يوم أو بعض يوم رضواني وجنتي امكثوا خالدين مخلدين ، ثم يقول : يا أهل النار كم لبثتم في الأرض عدد سنين ؟ قالوا : لبثنا يوما أو بعض يوم ، قال : بئس ما اتجرتم في يوم أو بعض يوم ، غضبي وسخطي ، امكثوا فيها خالدين مخلدين ، فيقولون : ربنا أخرجنا منها ، فإن عدنا فإنا ظالمون ، فيقول : اخسؤوا فيها ولا تكلمون ، فيكون ذالك آخر عهدهم بكلام ربهم ) )(@)(@@) أبو بكر محمد بن إبراهيم الإسماعيلي عن أيفع الكلاعي رضي الله عنه وله صحبة ، قال ابن كثير : غريب ، والظاهر أنه منقطع .(@)(@@)(@@)(@@) $ ( 1985 ) قال النبي :(@)(@@) | 30 ( إذا أدركت كلبك وقد أكل فلا تأكل ) )(@)(@@) ( حل ) وضعفه PageV01P291 عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1986 ) قال النبي :(@)(@@) | 30 ( إذا أدركتك الصلاة في مرابض الغنم فصل ، وإذا أدركتك في أعطان الإبل فابترز فإنها من خلقة الشياطين ) )(@)(@@) ( عب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1987 ) قال النبي :(@)(@@) | 30 ( إذا ادهن أحدكم فليبدأ بحاجبيه فإنه يذهب بالصداع ، وذالك أول ما ينبت على ابن آدم من الشعر ) )(@)(@@) ( الحكيم ) عن قتادة عن أنس رضي الله 
ms212	 عنهما .(@)(@@)(@@)(@@) $ ( 1988 ) قال النبي :(@)(@@) | 30 ( إذا أديت زكاته فليس بكنز ) )(@)(@@) ( طب هق ) عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 1989 ) قال النبي :(@)(@@) | 30 ( إذا أديت الزكاة فقد قضيت ما عليك ، ومن جمع مالا حراما ثم تصدق به لم يكن له فيه أجر ، وكان عليه إصره ) )(@)(@@) ( ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1990 ) قال النبي :(@)(@@) | 30 ( إذا أديتها يعني الزكاة إلى رسولي فقد برئت منها فلك أجرها ، وإثمها على من بدلها ) )(@)(@@) ( حم هق ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1991 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن أدبر الشيطان وله حصاص ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1992 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن هرب الشيطان حتى يكون بالروحاء ) )(@)(@@) ( ش حم ) و عبد بن حميد عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1993 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن فقولوا مثل قوله ) )(@)(@@) ( ن ) عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P292(@)(@@)(@@)(@@) $ ( 1994 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن فهو عمود الله عز وجل ، وإذا تقدم الإمام فهو نور الله ، وإذا استوت الصفوف فهي أركان الله فبادروا إلى عمود الله ، واقتبسوا من نور الله ، وكونوا أركان الله في الأرض ) )(@)(@@) ابن النجار عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 1995 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن خرج الشيطان من المسجد له حصاص ، فإذا سكت المؤذن رجع ، فإذا أقام المؤذن خرج من المسجد وله ضراط فإذا سكت رجع حتى يأتي المرء المسلم في صلاته فيدخل بينه وبين نفسه لا يدري أزاد في صلاته أو نقص ؟ فإذا وجد ذالك أحدكم فليسجد سجدتين وهو جالس قبل أن يسلم ثم يسلم ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1996 ) قال النبي :(@)(@@) | 30 ( إذا أذن المؤذن أدبر الشيطان وله ضراط ، فإذا سكت أقبل فإذا ثوب أدبر وله ضراط فإذا سكت أقبل يخطر بين المرء ونفسه حتى يضل الرجل لا يدري كم صلى ، فإذا صلى أحدكم فوجد ذالك فليسجد سجدتين وهو جالس ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1997 ) قال النبي :(@)(@@) | 30 ( إذا 
ms213	 أذنب العبد نكت في قلبه نكتة سوداء ، فإن تاب صقل منها ، فإن عاد زادت حتى تعظم في قلبه ) )(@)(@@) ( ت ن ه ك ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1998 ) قال النبي :(@)(@@) | 30 ( إذا أذنت فارفع صوتك فإنه لا يسمعه أحد إلا شهد لك يوم القيامة ) )(@)(@@) ( أبو الشيخ ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 1999 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله عز وجل بعبد خيرا استعمله قبل موته ، قيل : ما استعماله ؟ قال : يهديه إلى العمل الصالح قبل موته ثم يقبضه على PageV01P293 ذالك ) ( حم ) عن ع$ مرو بن الحمق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2000 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله عز وجل بعبد خيرا غسله ، قيل : وما غسله ؟ قال : يحببه إلى جيرانه ) )(@)(@@) ( الخرائطي في مكارم الأخلاق ) عن عمرو بن الحمق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2001 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا يفقهه ) )(@)(@@) ( الحكيم ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2002 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا غسله ، وهل تدرون ما غسله ؟ يفتح له عملا صالحا بين يدي موته حتى يرضى عنه جيرانه ) )(@)(@@) ( حم طب ك ) عن عمرو الحمق رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2003 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله تعالى بعبد خيرا عجل له عقوبة ذنبه في الدنيا ، وإذا أراد الله بعبد شرا أمسك عليه عقوبة ذنبه حتى يوافيه يوم القيامة كأنه عير ) )(@)(@@) ( طب ) عن عمار ( حم طب ك هب ) عن عبد الله بن مغفل رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2004 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا أرسل إليه ملكا قبل الموت فهيأه وأرشده وأصلحه حتى يموت على خير حال ، فيقول الناس : رحم الله فلانا مات على خير حال ، وإذا أراد الله بعبد شرا أرسل إليه شيطانا فأغواه وألهاه حتى يموت على شر حال ) )(@)(@@) الديلمي عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2005 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا بعث إليه ملكا من خزان الجنة فيمسح ظهره فيسخي نفسه بالزكاة ) )(@)(@@) ( الديلمي ) عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2006 ) قال النبي :(@)(@@) | 30 ( إذا أراد 
ms214	 الله بعبد خيرا بعث إليه قبل موته بعام ملكا يسدده ويوفقه حتى يموت على خير أحايينه فيقول الناس : مات فلان على خير PageV01P294 أحايينه ، فإذا حضروا رأى ما أعد له جعل يتهوع نفسه من الحرص على أن تخرج فهناك أحب لقاء الله ، وأحب الله لقاءه ، وإذا أراد الله بعبد شرا قيض له قبل موته بعام شيطانا يضله ويغويه حتى يموت على شر أحايينه ، فيقول الناس قد مات فلان على شر أحايينه فإذا حضر ورأى ما أعد له ، جعل يبتلع نفسه كراهية أن تخرج فهناك كره لقاء الله ، وكره الله لقاءه ) )(@)(@@) ابن أبي الدنيا في ذكر الموت عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2007 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا أرضاه بما قسم له وبارك له فيه ) )(@)(@@) ( الديلمي ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2008 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد خيرا عجل له عقوبته في الدنيا ، وإذا أراد الله بعبده شرا أخر عقوبته إلى يوم القيامة حتى يأتيه كأنه عير فيطرحه في النار ) )(@)(@@) ( هناد ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 2009 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بعبد شرا خضر له في اللبن والطين حتى يبني ) )(@)(@@) ( طب طس طص خط ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2010 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله عز وجل بعبد خيرا علمه هاؤلاء الكلمات ثم لم ينسهن إياه : اللهم إني ضعيف فقو في رضاك ضعفي ، وخذ إلى الخير بناصيتي ، واجعل الإسلام منتهى رضاي ، اللهم إني ضعيف فقوني ، وذليل فأعزني ، وفقير فأغنني وارزقني ) )(@)(@@) ( كر ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2011 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله عز وجل أن يخلق النطفة خلقا قال ملك الأرحام معرضا أي رب أشقي أم سعيد ؟ أذكر أم أنثى ؟ أي رب أحمر أم أسود ، فيقضي الله أمره ثم يكتب بين عينيه ما هو لاق من خير أو شر ، حتى النكبة ينكبها ) )(@)(@@) ابن جرير ( قط ع بز ) في الأفراد عن ابن عمر رضي الله عنهما ، ورجال ( ع ) رجال الصحيح .(@)(@@) PageV01P295(@)(@@)(@@)(@@) $ ( 2012 ) قال النبي :(@)(@@) | 30 ( إذا 
ms215	 أراد الله تعالى أن يخلق النسمة فجامع الرجل المرأة طار ماؤه في كل عرق وعصب منها وإذا كان يوم السابع جمعه الله ثم أحضر له كل عرق بينه وبين آدم ، ثم قرأ في أي صورة ما شاء ركبك ) )(@)(@@) ( طب ) و أبو نعيم في الطب عن مالك بن الحويرث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2013 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله تعالى أن يوحي بأمره تكلم بالوحي أخذت السماوات رجفة شديدة من خوف الله تعالى ، فإذا سمع بذالك أهل السماوات صعقوا وخروا سجدا فيكون أولهم يرفع رأسه جبريل فيكلمه الله تعالى من وحيه بما أراد ، فينتهي به جبريل على الملائكة ، كلما مر بسماء سماء سأله أهلها ماذا قال ربنا يا جبريل ، فيقول جبريل قال الحق وهو العلي الكبير ، فيقولون كلهم مثل ما قال جبريل ، فينتهي به جبريل حيث أمر من السماء والأرض ) )(@)(@@) ابن جرير وابن أبي حاتم وأبو الشيخ في العظمة وابن مردويه وفي الأسماء والصفات ( طب ) عن النواس بن سمعان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2014 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بأهل بيت خيرا أدخل عليهم باب الرفق ، وإذا أراد بأهل بيت شرا أدخل عليهم الخرق ) )(@)(@@) الخرائطي في مكارم الأخلاق عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2015 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله تعالى بأهل بيت خيرا أدخل عليهم بابا من الرفق ) )(@)(@@) الخرائطي في مكارم الأخلاق ( هق ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2016 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بأهل الأرض عذابا فنظر إلى ما بهم من الجوع والعطط صرف عنهم العذاب ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2017 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله تعالى أن يخوف خلقه أظهر للأرض منه شيئا وارتعدت ، وإذا أراد أن يهلك خلقه تبدى لها ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما ، ورواه ( طب ) في السنة عنه موقوفا نحوه .(@)(@@)(@@)(@@) $ ( 2018 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم خيرا ابتلاهم ) )(@)(@@) ( ع هب ) عن PageV01P296 أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2019 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم خيرا ولى عليهم 
ms216	 حلماءهم ، وقضى بينهم علماؤهم ، وجعل المال في سمحائهم ، وإذا أراد الله بقوم شرا ولى عليهم سفهاءهم ، وقضى بينهم جهالهم ، وجعل المال في بخلائهم ) )(@)(@@) الديلمي عن مهران رضي الله عنه وله صحبة .(@)(@@)(@@)(@@) $ ( 2020 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله بقوم نماء رزقهم السماحة والعفاف ، وإذا أراد بقوم اقتطاعا فتح عليهم باب خيانة ) )(@)(@@) ( طب كر ) الديلمي عن عبادة بن الصامت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2021 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله أن يستجيب لعبده أذن له في الدعاء ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2022 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله قبض روح عبد بأرض جعل له إليها حاجة فلم ينته حتى يقدمها ) )(@)(@@) ( ك ) عن مطر بن عكامس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2023 ) قال النبي :(@)(@@) | 30 ( إذا أراد الله قبض روح عبد بأرض جعل له فيها حاجة فلم ينته حتى يأتيها ، ثم قرأ رسول الله { إن الله عنده علم الساعة } إلى آخر الآية ) )(@)(@@) ( حم خ ) في الأدب ( ك طب حل ) عن أبي عزة الهذلي ( ك هب ) عن عروة بن مضرس رضي الله عنهم ( ك ) عن جندب البجلي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2024 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحد أن يمر بين يديك وبين سترتك فاردده ، فإن أبى فادفعه ، فإن أبى فقاتله ، فإنما هو شيطان ) )(@)(@@) ( عب ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2025 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم سفرا فليسلم على إخوانه فإن الله يزيده بدعوتهم خيرا ) )(@)(@@) ابن النجار عن زيد بن أرقم رضي الله عنه .(@)(@@) PageV01P297(@)(@@)(@@)(@@) $ ( 2026 ) قال النبي :(@)(@@) | 30 ( إذا أراد يعني الذي يجامع أن يعود فليتوضأ وضوءه للصلاة ) )(@)(@@) ابن خزيمة عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2027 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يأتي الجمعة فليغتسل ) )(@)(@@) ( م ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2028 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يعطي أخاه أرضا فليمنحها إياه ولا يعطيه بالثلث والربع ) )(@)(@@) ( طب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2029 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أن يضطجع فلينزع داخلة إزاره ثم لينفض 
ms217	 بها فراشه فإنه لا يدري ما خلفه عليه ، ثم ليضطجع على شقه الأيمن ، ثم ليقل : رب بك وضعت جنبي وبك أرفعه ، فإن أمسكت نفسي فارحمها ، وإن أرسلتها فاحفظها بما حفظت به عبادك الصالحين ) )(@)(@@) ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2030 ) قال النبي :(@)(@@) | 30 ( إذا أراد أحدكم أمرا فليقل اللهم إني أستخيرك بعلمك ، وأستقدرك بقدرتك ، وأسألك من فضلك العظيم ، فإنك تقدر ولا أقدر ، وتعلم ولا أعلم وأنت علام الغيوب ، اللهم إن كان كذا وكذا خيرا لي في ديني وخيرا لي في معيشتي وخيرا لي في عاقبة أمري فاقدره لي وبارك لي فيه ، وإن كان غير ذالك خيرا لي فاقدر لي الخير حيث ما كان ورضني بقدرك ) )(@)(@@) ( حب ) والمخلص في أماليه و ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2031 ) قال النبي :(@)(@@) | 30 ( إذا أردت أن تعود فتوضأ وضوءك للصلاة ) )(@)(@@) ( هق ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2032 ) قال النبي :(@)(@@) | 30 ( إذا أرسلت كلبك فأكل الصيد فلا تأكل فإنما أمسك PageV01P298 على نفسه ، وإذا أرسلته فقتل ولم يأكل فكل فإنما أمسك على صاحبه ) )(@)(@@) ( حم ) عن ابن عباس رضي الله عنهما ، ورجاله رجال الصحيح .(@)(@@)(@@)(@@) $ ( 2033 ) قال النبي :(@)(@@) | 30 ( إذا أسبلت الشعور ومشي بالتبختر ، ويصم عن السامع قال الله عز وجل : فبي حلفت لأدعون بعضهم بعضا ) )(@)(@@) الخرائطي في مساوىء الأخلاق عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2034 ) قال النبي :(@)(@@) | 30 ( إذا استأذن أحدكم أخاه أن يغرز خشبة في جداره فلا يمنعه ) )(@)(@@) ( د ت ) صحيح ( ه ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2035 ) قال النبي :(@)(@@) | 30 ( إذا استأذنكم نساؤكم بالليل إلى المسجد فأذنوا لهن ) )(@)(@@) ( خ حب ) عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2036 ) قال النبي :(@)(@@) | 30 ( إذا استأذنكم نساؤكم إلى الصلاة فلا تمنعوهن ) )(@)(@@) ( حم ض ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2037 ) قال النبي :(@)(@@) | 30 ( إذا استجمر أحدكم فليستجمر ثلاثا ) )(@)(@@) ( حم ض ش ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2038 ) قال النبي :(@)(@@) | 30 ( إذا استجمر أحدكم فليوتر فإن الله تعالى وتر يحب الوتر ، أما ترى السماوات 
ms218	 سبعا والأرضين سبعا ، والأيام سبعا ، والطواف والجمار ) )(@)(@@) ( طس حب ك ) وتعقب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2039 ) قال النبي :(@)(@@) | 30 ( إذا استحلت هاذه الأمة الخمر بالنبيذ ، والربا بالبيع ، والسحت بالهدية ، واتجروا بالزكاة فعند ذالك هلاكهم ليزدادوا إثما ) )(@)(@@) الديلمي عن حذيفة رضي الله عنه .(@)(@@) PageV01P299(@)(@@)(@@)(@@) $ ( 2040 ) قال النبي :(@)(@@) | 30 ( إذا استحلت أمتي خمسا فعليهم الدمار : إذا ظهر فيهم التلاعن ، ولبسوا الحرير ، واتخذوا القينات ، وشربوا الخمور ، واكتفى الرجال بالرجال وال نس اء بالنساء ) )(@)(@@) ( هب ) عن طريقين عن أنس رضي الله عنه ، وقال كل من الإسنادين غير قوي غير أنه إذا ضم بعضه إلى بعض أخذ قوة .(@)(@@)(@@)(@@) $ ( 2041 ) قال النبي :(@)(@@) | 30 ( إذا استعجم القرآن على لسان أحدكم وهو يصلي فليقعد ) )(@)(@@) ( م ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2042 ) قال النبي :(@)(@@) | 30 ( إذا استغنى النساء بالنساء والرجال بالرجال فبشرهم بريح حمراء تخرج من قبل المشرق فيمسخ بعضهم ويخسف ببعض ذالك بما عصوا ، وكانوا يعتدون ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2043 ) قال النبي :(@)(@@) | 30 ( إذا استغنى أحدكم عن أرضه فليمنحها أخاه أو يدع ) )(@)(@@) ( طب ) عن رافع بن خديج رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2044 ) قال النبي :(@)(@@) | 30 ( إذا استقرت النطفة في الرحم اثنين وسبعين صباحا أتى ملك الأرحام فخلق لحمها وعظمها وسمعها وبصرها ثم قال : يا رب أشقي أم سعيد فيقضي ربك ما شاء ، ويكتب الملك ثم يكتب رزقه وأجله وعمله ثم يخرج الملك ) )(@)(@@) الباوردي عن ابن الطفيل عامر بن واثلة عن حذيفة بن أسيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2045 ) قال النبي :(@)(@@) | 30 ( إذا استنفرتم فانفروا ) )(@)(@@) ( ه ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2046 ) قال النبي :(@)(@@) | 30 ( إذا استهل المولود ورث وتلك طعنة الشيطان ، كل بني آدم نائل منه تلك الطعنة إلا ما كان من مريم وابنها فإنها لما وضعتها أمها قالت إني أعيذها بك وذريتها من الشيطان الرجيم فضرب دونها بحجاب ) )(@)(@@) فطعن فيه ابن خزيمة عن أبي هريرة رضي الله عنه .(@)(@@) PageV01P300(@)(@@)(@@)(@@) $ ( 2047 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم من منامه فلا يغمس يده في الإناء حتى 
ms219	 يغسلها ثم ليتوضأ ، فإن غمس يده في الإناء من قبل أن يغسلها فليرق ذالك الماء ) )(@)(@@) ( عد ) عن أبي هريرة رضي الله عنه قال ( عد ) قوله فليرق ذالك الماء منكر لا يحفظ وفي السند ضعيفان وانقطاع .(@)(@@)(@@)(@@) $ ( 2048 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ أحدكم من الليل فليوقظ امرأته فإن لم تستيقظ فلينضح في وجهها من الماء ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2049 ) قال النبي :(@)(@@) | 30 ( إذا استيقظ الإنسان من منامه ابتدره ملك وشيطان فيقول الملك : افتح بخير ، ويقول الشيطان : افتح بشر ، فإن قال الحمد لله الذي أحيا نفسي بعد موتها ، الحمد لله الذي يمسك السماء أن تقع على الأرض ، والحمد لله الذي يمسك التي قضى عليها الموت ويرسل الأخرى إلى أجل مسمى ، طرد الملك الشيطان وظل يكلؤه ) )(@)(@@) أبو الشيخ في الثواب عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2050 ) قال النبي :(@)(@@) | 30 ( إذا أسكن الله تعالى أهل الجنة الجنة بقي في الجنة مكان أفيح فيسكنها الله ستين وثلاثمائة عالم كل عالم أكبر من الدنيا منذ خلقت إلى يوم تنقطع ) )(@)(@@) الديلمي عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2051 ) قال النبي :(@)(@@) | 30 ( إذا أسلم العبد كتب الله له كل حسنة قدمها ومحى عنه كل سيئة زلفها ثم قيل له ائتنف العمل : الحسنة بعشر أمثالها إلى سبعمائة ضعف ، والسيئة بمثلها إلا أن يعفو الله وهو الغفور ) )(@)(@@) ( سمويه ) عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2052 ) قال النبي :(@)(@@) | 30 ( إذا أسلم العبد فحسن إسلامه تقبل الله منه كل حسنة زلفها ، وكفر الله عنه كل سيئة زلفها ، وكان في الإسلام ما كان : الحسنة بعشر أمثالها إلى سبعمائة ، والسيئة بمثلها أو يمحوها الله ) )(@)(@@) ( هب ) عن عطاء بن يسار مرسلا .(@)(@@) PageV01P301(@)(@@)(@@)(@@) $ ( 2053 ) قال النبي :(@)(@@) | 30 ( إذا اشترى أحدكم لحما فليكثر مرقته فإن لم يصب من اللحم أصاب من المرق ، وهو أحد اللحمين ، وليغرف لجيرانه ) )(@)(@@) ( هب ) عن عل قمة بن عبد الله المزني عن أبيه .(@)(@@)(@@)(@@) $ ( 2054 ) قال النبي :(@)(@@) | 30 ( إذا اشتكى أحدكم فليضع يده حيث يجد ألمه ثم ليقل : أعوذ بعزة الله 
ms220	 وقدرته من شر ما أجد وأحاذر سبعا ) )(@)(@@) مالك ( م د ت ه ط ) عن عثمان بن أبي العاصي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2055 ) قال النبي :(@)(@@) | 30 ( إذا اشتكى العبد المؤمن قال الله لكاتبيه اكتبا لعبدي هاذا مثل ما كان يعمل في صحته ما كان حبسي فإن قبضته قبضته إلى خير ، وإن هو عافاه أبدله بلحم خير من لحمه ، وبدم خير من دمه ) )(@)(@@) ( هناد ) عن عطاء بن يسار مرسلا .(@)(@@)(@@)(@@) $ ( 2056 ) قال النبي :(@)(@@) | 30 ( إذا أشكلت عليك آية من القرآن تؤنثها أو تذكرها فذكر القرآن ) )(@)(@@) ابن قانع عن بشير أو بشير بن الحارث رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2057 ) قال النبي :(@)(@@) | 30 ( إذا أصاب أحدكم غم أو لأواء فليقل : الله الله ربي لا أشرك به شيئا ، الله الله ربي لا أشرك به شيئا ) )(@)(@@) ( حب ) عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2058 ) قال النبي :(@)(@@) | 30 ( إذا أصابتك مصيبة فقولي : اللهم أعطني أجر مصيبتي واخلفني خيرا منها ) )(@)(@@) ابن سعد عن أم سلمة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 2059 ) قال النبي :(@)(@@) | 30 ( إذا أصبتم مثل هاذا فضربتم بأيديكم فقولوا : بسم الله وبركة الله ، فإذا شبعتم فقولوا : الحمد لله الذي هو أشبعنا وأروانا ، وأنعم علينا وأفضل ، فإن هاذا كفاف ) )(@)(@@) كذا ( هب ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 2060 ) قال النبي :(@)(@@) | 30 ( إذا أصبح إبليس بعث جنوده فيقول من أضل اليوم مسلما ألبسته التاج ، فيجيئون فيقول هاذا لم أزل به حتى طلق امرأته فيقول فيوشك أن PageV01P302 يتزوج ، ويجيء هاذا فيقول لم أزل به اليوم حتى عق والديه فيقول فيوشك أن يبر ، ويجيء هاذا فيقول : لم أزل به حتى أشرك ، فيقول أنت أنت ، ويجيء هاذا فيقول : لم أزل به حتى زنا فيقول : أنت أنت ، ويجيء هاذا فيقول : لم أزل به حتى قتل فيقول : أنت أنت ويلبسه التاج ) )(@)(@@) ( طب ك ) عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2061 ) قال النبي :(@)(@@) | 30 ( إذا أصبحتم فقولوا : اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت ) )(@)(@@) ( ه ) و ابن السني عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 2062 ) قال 