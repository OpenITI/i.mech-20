ms741	 أن % % تأخذه لائمة اللوم % 53(@)(@@) % لا حرم الحل ولا استعذبت % % شهوته يوما جنى محرم % 54(@)(@@) % ولا اقتفى إثر رجال مضوا % % عيابهم ملأى من المأثم % 55(@)(@@) % لم يصدفوا عن خلفاء الهدى % % ولم يكافوا نعمة المنعم % 56(@)(@@) % حتى إذا نيطت به لوطفت % % جروحها بالعاصب الملحم % 57(@)(@@) % قالوا له لما رأوه لها % % خذ دستها العالي فقل واحكم % 58(@)(@@) % فأنت في الميراث في قعدد % منها بحق عنه لم تزحم % 59(@)(@@) % حملتها ثقلا وأكرمت في الص % % بر فلم تعي ولم تسأم % 60(@)(@@) % مقام عز لك من رامه % % تحرشا فر من الضيغم % PageV01P2330 61(@)(@@) % وساوس حدث جنيها % % قوما ولم يرق ولم يعزم % 62(@)(@@) % ورب صعب جاهل حلمه % لم يعرف الصدر ولم يحلم % 63(@)(@@) % وطامع شم رياح المنى % % في جوها بالأجدع الأرغم % 64(@)(@@) % يجاذب الأقدار من دونها % % بمسحل التدبير لم يبرم % 65(@)(@@) % وعمر أيامك فيها وإن % % أدواه عمر الجذع الأزلم % 66(@)(@@) % وأرقب الناس لما لا يرى % % في الليل باغي عثرة الأنجم % 67(@)(@@) % يا حافظ المجد بحفظي ويا % % معظمه في أنه معظمي % % 68(@)(@@) % ومعلقا كفي ملمومة % في العهد لم تنكث ولم تفصم % 69(@)(@@) % غرست من ودك حلو الجنى % % ورب غرس ليس بالمطعم % 70(@)(@@) % وخاس قوم بجديد الهوى % % وأنت راع للهوى الأقدم % PageV01P2331 71(@)(@@) % وإنما بقاك لي دونهم % % تمسكي بالأكرم الأكرم % 72(@)(@@) % فاسمع أكايلك جزاء بها % % غنيمة جاءتك من مغرم % 73(@)(@@) % سيارة في الأرض لم تغترض % عنسا إلى سير ولم تحزم % 74(@)(@@) % نافقة في موسم مكسد % ناطقة من زمن مفحم % 75(@)(@@) % تنسى الليالي وهي مذكورة % ويهرم الدهر ولم تهرم % 76(@)(@@) % عزة ذات البعل فيها وإن % % أعطتك لينا ذلة الأيم % 77(@)(@@) % نسيبة إما إلى هاشم ال % % قريض أو مخزومة تنتمي % % 78(@)(@@) % ما ضرها والعرب أبياتها % % آباؤها منى الأب الأعجمي % % 79(@)(@@) % فاشرح لها صدرا ومهرج مع ال % % أنعم من عيشك فالأنعم % 80(@)(@@) % ملتقطا سمعك من جوهر ال % % كلام ما أنثره من فمي % % PageV01P2332 البحر : - 1(@)(@@) % ليل السرى مثل نهار المقام % ما خفت أن تظلم أو أن تضام % 2(@)(@@) % ودون صدر البيت مرخى به % % عليك 
ms742	 ستر الذل صدر الحسام % 3(@)(@@) % وجانب الخفض على لينه % % مع الأذى أوطأ منه السلام % 4(@)(@@) % خاطر فإما عيشة حرة % يرغدها العز وإما الحمام % 5(@)(@@) % كم تترك الجمة مسترويا % % بنطفة ليست تبل الأوام % 6(@)(@@) % وترهب الإصحار مستبردا % % مع الضحى ظل كسور الخيام % 7(@)(@@) % نمت ونام الحظ فافتح له % % جفنك وانهض فإذا قمت قام % 8(@)(@@) % تحتشم التغرير والرزق في ال % % إقدام والحرمان في الاحتشام % 9(@)(@@) % زاحم على باب العلا ضاغطا % % لا بد أن تدخل بين الزحام % 10(@)(@@) % رام بها الليل فما يسفر ال % % نجاح إلا عن نقاب الظلام % PageV01P2333 11(@)(@@) % موارقا عن عقل أشطانها % % مروق فوق السهم عن قوس رام % 12(@)(@@) % لعل حظا عقمت هذه ال % % أرض به يولد بعد العقام % 13(@)(@@) % ميز من الناس على ظهرها % % نفسك لا ميزة تحت احتشام % 14(@)(@@) % من طلب الغاية خطوا على % % ظهر الهوينا رام صعب المرام % 15(@)(@@) % لله مفطور على عزه % % أرضعه المجد لغير الفطام % 16(@)(@@) % لا يملك الغريد إطرابه % % شجوا ولا نشوته للمدام % 17(@)(@@) % ولا توازي صدره فرجة % تساكن الحب وتقري الغرام % 18(@)(@@) % لولا السرى مستضوئا لم يكن % % يرفع طرفا لبدور التمام % 19(@)(@@) % ينسيه حر الغيظ برد اللمى % % وجائر الحظ اعتدال القوام % 20(@)(@@) % حتى ترى بعد بطون الربى % % أبياته فوق ظهور الإكام % PageV01P2334 21(@)(@@) % تحسب من صبوته بالعلا % % وسعيه خلف الأمور الجسام % 22(@)(@@) % أن زعيم الدين أغراه بال % % عزة أو علمه الاعتزام % 23(@)(@@) % حدث بالشاهد من غيبه % % مصدق الدعوى مزكى الكلام % 24(@)(@@) % يريك بالجذوة من فضله % % ما خلفها من لهب واضطرام % 25(@)(@@) % أسرار وجه شف عن خلقه % تطلع الخمر وراء الفدام % 26(@)(@@) % وجه ترى البدر به مسفرا % % وهو هلال لك تحت اللثام % 27(@)(@@) % ماء الحياء الرطب والحسن في % % وجنته ماء وراح وجام % 28(@)(@@) % قد كان لو أفرج عن طرقه % منسجما أو هم بالإنسجام % 29(@)(@@) % لو عكف الحسن على قبلة % تعبدا صلى إليه وصام % 30(@)(@@) % وهمة أيسر ما ترتقي % % إليه تهوين الأمور العظام % PageV01P2335 31(@)(@@) % داست به الجو وحساده % % مداوس الذلة فوق الرغام % 32(@)(@@) % شفا بها الملك وقد 
ms743	 شفه % % من سفراء العجز طول السقام % 33(@)(@@) % كفته منه قبل أيامه % آراء نصر هن بيض ولام % 34(@)(@@) % ورد عنه وادعا قاعدا % % دهم الخطوب الثائرات القيام % 35(@)(@@) % وعد من بعد أخيه ومن % % بعد أخيه ثالثا للتمام % 36(@)(@@) % واسطة من بين هذا وذا % % تكامل السلك بها والنظام % 37(@)(@@) % فهم ثلاث الخيف في كلها % % لمنسك الحج فروض تقام % 38(@)(@@) % سل بعلي خصمه إننا % % نقنع فيه بشهود الخصام % 39(@)(@@) % يخبرك من يحسده أنه % % ضرورة واحد هذا الأنام % 40(@)(@@) % تمنطق السودد طفلا وما % % فض من العوذة منه ختام % PageV01P2336 41(@)(@@) % وهب للعلياء في عشره % % ولدة الخمسين عنها ينام % 42(@)(@@) % فمر في غلوته سابقا % % والناس مأمومون وهو الإمام % 43(@)(@@) % والريح تدعووهي تقتصه % % ردوه إن كان لفيه لجام % % 44(@)(@@) % يا أعين الناس انظري واعجبي % % بذ كهول المجد هذا الغلام % 45(@)(@@) % مد إلى سؤاله والعدا % % يدين للإنعام والإنتقام % 46(@)(@@) % والكسر والجبرة في موقف % ما بين بسط منهما وانضمام % 47(@)(@@) % وجاد حتى لم يدع فضلة % عليه للبحر ولا للغمام % 48(@)(@@) % يرى لما يحفظ من وفره % % إضاعة العهد ونقض الذمام % 49(@)(@@) % كأن ما قد حل من ماله % % وطاب محظور عليه حرام % 50(@)(@@) % أغراه بالتبذير لوامه % % فود من يسأله أن يلام % PageV01P2337 51(@)(@@) % يفديك من عادى معاليك أن % % كان فداء الكرماء اللئام % 52(@)(@@) % توقصه خلفك عثراته % % كبوا وما شق رداء القيام % 53(@)(@@) % يذارع الجو بمشلولة % محلولة لم يرتبطها عصام % 54(@)(@@) % يغمدها من حيث سلت ومن % % سل ولم يقدر على الضرب شام % 55(@)(@@) % يصعد يبغيك وقد أوشكت % رجلاك أن تنزل بابني شمام % 56(@)(@@) % طاب بكم تربي وطالت يدي % % وأنبتت لحما أثيثا عظام % 57(@)(@@) % وعاودتني حين أغنيتم % بعد مشيبي شرتي والعرام % 58(@)(@@) % فستقبلوها غررا طلقة % مع التهاني ووجوها وسام % 59(@)(@@) % بارزة الحسن لكم كلما % % نادت رجالا من وراء الفدام % 60(@)(@@) % كرائما صاهرني منكم % على عذاراها رجال كرام % PageV01P2338 61(@)(@@) % إذا المهيرات شكون الشقا % % طاب لها فيكم نعيم ودام % 62(@)(@@) % سائرة لم يعتقل رسغها % % شكل ولم يحبس طلاها زمام % 63(@)(@@) % لم تترك الغور لنجد مع ال % % إلف 
ms744	 ولم تهجر عراقا لشام % 64(@)(@@) % مع النعامى طائرات بكم % % وجافلات مع طرد النعام % 65(@)(@@) % أعراضكم في طي ما حملت % لطائم وهي لقوم لطام % 66(@)(@@) % بواقيا حلية أحسابكم % % ما دامت الأطواق حلى الحمام % 67(@)(@@) % ما خدم النيروز إقبالكم % % فهي لها أسورة أو خدام % 68(@)(@@) % يوم من العام ولكنه % % يكر في دولتكم ألف عام % PageV01P2339 البحر : - 1(@)(@@) % كثر فيك اللوم % وأين سمعي وهم % 2(@)(@@) % قلبي واللوم علي % % ك منجد ومتهم % 3(@)(@@) % سعوا بغش لاسعوا % % وينصحون زعموا % % 4(@)(@@) % وأتعب المكلفي % % ن ناصح متهم % 5(@)(@@) % قالوا سهرت وال % % عيون المسهرات نوم % 6(@)(@@) % وليس في جسمك إلا % جلدة وأعظم % 7(@)(@@) % وما عليهم أرقى % % ولا رقادي لهم % 8(@)(@@) % وهل سمات الحب إ % % لا سهر وسقم % 9(@)(@@) % خذ أنت في شأنك يا % % دمعي خذ ودعهم % 10(@)(@@) % هذا الكثيب الفردمن % % نجد وهذاالعلم % PageV01P2340 11(@)(@@) % وحيث يشقى ناظر % من حيث كان ينعم % 12(@)(@@) % ناشد بسعد دارها % % فالدار عنك تفهم % 13(@)(@@) % وهل يجيب طلل % والربع لا يكلم % 14(@)(@@) % أين دماكوالهوى % % سؤالناأين هم % 15(@)(@@) % وأين غفلات لنا % % تنصع منها الظلم % 16(@)(@@) % فالجيرة الجيرة وال % % أنعم منهم أنعم % 17(@)(@@) % وفي التشاكي قبل % مخلوسة تغتنم % 18(@)(@@) % وخلوات حلوة % % تنم وهي تكتم % 19(@)(@@) % تفضل في شرعتها % % للغدوات العتم % 20(@)(@@) % ثراك يستاف مع ال % % صبح لهاويلثم % PageV01P2341 21(@)(@@) % وغاربين لا تنو % % ب الطالعات عنهم % 22(@)(@@) % كل فتاة لحظها % % على القناة لهذم % 23(@)(@@) % لو لم تكن تدمي به % % ما مازج الدمع دم % 24(@)(@@) % عادت بقلبي مشركا % % وهو حنيف مسلم % 25(@)(@@) % لأنه يعبدها % % بالحب وهي صنم % 26(@)(@@) % وغادرت نار الجوى % % تذكى لها وتضرم % 27(@)(@@) % فإن يكن ضل بها % % فحسبه جهنم % 28(@)(@@) % أقسمت والصادق لا % % يحرج حين يقسم % 29(@)(@@) % بالمهديات لمنى % تبدن أو تسنم % 30(@)(@@) % كالأكم اغتصت بها % % تشرق منها الأكم % PageV01P2342 31(@)(@@) % مقلدات للردى % % ترقش أو ترقم % 32(@)(@@) % حتى ترى واجبة % جنوبها تقتسم % 33(@)(@@) % وزمزم وما شفت % من كل داء زمزم % 34(@)(@@) % وما اجتبي للماسحي % % ن الأسود المستلم % 35(@)(@@) % أن بني أيوب من % % غشم الخطوب عصم % 36(@)(@@) % وأن أيامهم % فينا الشهور 
ms745	 الحرم % 37(@)(@@) % قوم ثقال أدركوا % % جميع إل غرموا % % 38(@)(@@) % نيرانهم أراؤهم % % والسابقات الهمم % 39(@)(@@) % إن حاربوا يوما فأس % % يافهم تكلم % 40(@)(@@) % ويبطئ الرمح الأص % % م فيخف القلم % PageV01P2343 41(@)(@@) % ولهم المجد فق % % فوا إثره ولقموا % % 42(@)(@@) % فقرب السبق لهم % % وخوض قوم فيهم % 43(@)(@@) % وحسبهم أن عمي % % د الرؤساء منهم % 44(@)(@@) % أفق علا لا تخلف ال % % أنوار منه الظلم % 45(@)(@@) % تولد من شموسه % % أهلة وأنجم % 46(@)(@@) % تقدم الناس بهم % % عصرهم المقدم % 47(@)(@@) % وجاء يبني فوق ما % % قد أسسوا ودعموا % % 48(@)(@@) % فجاز حد المبتدي % % ن المنتهي المتمم % 49(@)(@@) % فليهنهم ما فتحوا % % به العلا أو ختموا % % 50(@)(@@) % وأنهم إذا ادعوا ال % % معجز دل ابنهم % PageV01P2344 51(@)(@@) % أبلج بسام وفى % % نادى العلا مقدم % 52(@)(@@) % وفائض ربيعه % % يوم تفيض الديم % 53(@)(@@) % مبارك تستقبل ال % % يوم به فتغنم % 54(@)(@@) % بلجة فجر وجهه % يقمر منهاالمعتم % 55(@)(@@) % محصن بالشكر أن % % تنفر منه النعم % 56(@)(@@) % يا فارس الكرة وخ % % ز الطعن فيها الكلم % 57(@)(@@) % جروحها بالسبر وال % % عصاب لا تلتحم % 58(@)(@@) % حلبتها القرطاس وال % % أسطر خيل دهم % 59(@)(@@) % والأنمل السبط لها % % أعنة ولجم % 60(@)(@@) % فارسها المعلم لا % % يهفو عليه العلم % PageV01P2345 61(@)(@@) % مقتعدا أنماطه % % حيث تجول الهمم % 62(@)(@@) % حطت بها خلائفا % بهم تحاط الأمم % 63(@)(@@) % ناطوا بك الأمر فما % % ليموا ولا تألموا % % 64(@)(@@) % فسلموا الأمر إلى % % نصحك حتى سلموا % % 65(@)(@@) % المنبر الصائح عن % % أسمائهم والدرهم % 66(@)(@@) % وغزونا مجمعا % % وحجنا والموسم % 67(@)(@@) % كل يقوم بالذي % % تقضي به وتحكم % 68(@)(@@) % سعى رجال للذي % % توعدهم وتنعم % 69(@)(@@) % ولم ينالوا نعما % % تلذ فيما تصم % 70(@)(@@) % وأنت تسعى للتي % % تعلو بها وتعظم % PageV01P2346 71(@)(@@) % فمن تزن عنده % % بريبة أو ترجم % 72(@)(@@) % فالله والخليفتا % % ن بالرجال أعلم % 73(@)(@@) % فلا يزل عقد الكلا % % م بعلاك ينظم % 74(@)(@@) % ولا تزل يقظى الخطو % % ب وهي عنك نوم % 75(@)(@@) % وإن طغت غريبة % تهم أو تقسم % 76(@)(@@) % كانت كأضغاث الكرى % % ما راع منها حلم % 77(@)(@@) % ثم انجلت كما جلا الص % % بح الظلام عنكم % 78(@)(@@) % وناوبتك بالتها % % ني مفصحات عجم % 79(@)(@@) % سطورها الخرس تبي % % ن 
ms746	 عنكم وتفهم % 80(@)(@@) % يقرأ قبل فضه % % كتابها المترجم % PageV01P2347 81(@)(@@) % أعراضكم في طيها % % روض الحمى المكمم % 82(@)(@@) % لطائم أرواحها % % لغيركم لا تنسم % 83(@)(@@) % عاشقة واصلة % وهي أوانا تصرم % PageV01P2348 البحر : - 1(@)(@@) % بكر العارض تحدوه النعامى % % فسقاك الري يا دار أماما % % 2(@)(@@) % وتمشت فيك أرواح الصبا % % يتأرجن بأنفاس الخزامى % % 3(@)(@@) % وإذا مغنى خلا من زائر % بعدما فارق أو زير لماما % % 4(@)(@@) % فقضى حفظ الهوى أن تصبحى % % للمحبين مناخا ومقاما % % 5(@)(@@) % أجتدى المزن وما ذا أربى % % أن تجود المزن أطلالا رماما % % 6(@)(@@) % وقليلا فيك أن أدعو لها % % ما رآني الله أستجدي الغماما % % 7(@)(@@) % أين سكانك لا أين هم % أحجازا أقبلوها أم شاما % % 8(@)(@@) % صدعوا بعد التئام فغدت % % بهم أيدي الموامي تترامى % % 9(@)(@@) % وتبقوا كل حيران بليد % يسأل الجندل عنهم والرغاما % % 10(@)(@@) % يا لواة الدين عن ميسرة % والضنينات وما كن لئاما % % PageV01P2349 11(@)(@@) % قد وقفنا قبلكم في ربعكم % % فنقضناه استلاما والتزاما % % 12(@)(@@) % سعد الراكب تحتث به % % جسرة تخلط وهدا وإكاما % % 13(@)(@@) % تطأ العسف فتدمي خفها % % جبهات الأرض شجا ولطاما % % 14(@)(@@) % تتنزى أنفا في خلقها % % أن تطيع السوط أو ترضي الزماما % % 15(@)(@@) % تطعم البيد إذا ما هجرت % شبع البيداء نقيا وسلامى % % 16(@)(@@) % ماؤها بسل على أظمائها % % أو ترى بالنعف هاتيك الخياما % % 17(@)(@@) % وبجرعاء الحمى قلبي فعج % بالحمى فاقرأ على قلبي السلاما % % 18(@)(@@) % وترجل فتحدث عجبا % % أن قلبا سار عن جسم أقاما % % 19(@)(@@) % قل لجيران الغضا آه على % % طيب عيش بالغضا لو كان داما % % 20(@)(@@) % نصل العام وما ننساكم % وقصارى الوجد أن نسلخ عاما % % PageV01P2350 21(@)(@@) % حملوا ريح الصبا نشركم % قبل أن تحمل شيحا وثماما % % 22(@)(@@) % وابعثوا أشباحكم لي في الكرى % % إن أذنتم لجفوني أن تناما % % 23(@)(@@) % وقف الظامي على أبوابكم % % أفيقضى وهو لم يشف أواما % % 24(@)(@@) % ما يبالي من سقيتن اللمى % % منعكن الماء عذبا والمداما % % 25(@)(@@) % واعجبوا من أن يرى الظلم حلالا % % شارب وهو يرى الخمر حراما % % 26(@)(@@) % أشتكيكم وإلى من أشتكي % % أنت الداء فمن يشفى السقاما % % 27(@)(@@) % أنتم والدهر سيف وفم % ما تملان ضرابا وخصاما % % 28(@)(@@) % كلما 
ms747	 عاتبت في حظي دهري % % زاده العتبلجاجا وعراما % % 29(@)(@@) % وإذا استرهفت خلا فكأني % % منه جردت على عنقي حساما % % 30(@)(@@) % لمت أيامي على الغدر فقد % % زادت الإجرام حتى لا ملاما % % PageV01P2351 31(@)(@@) % ولزمت الصمت لا أشكو وصمتي % % بعد أن أفنيت في القول الكلاما % % 32(@)(@@) % قعد الناس بنصري في حقوق % قعد المجد يبكيها وقاما % % 33(@)(@@) % دفع الله وحامى عن رجال % قد رعوني لم يضيعوا لي سواما % % 34(@)(@@) % كفني جودهم أن أجتدي % % وأبى عزهم لي أن أضاما % % 35(@)(@@) % طلعوا في جنح خلاتي نجوما % % وانتحوا نحو مرامي سهاما % % 36(@)(@@) % وأضاءت لي أماني بهم % % عشيت في الناس تيها وظلاما % % 37(@)(@@) % عرفوا بالجود حتى أصبحوا % % من وضوح في سواد الدهر شاما % % 38(@)(@@) % لم أذمم حرمة سالفة % في معاليهم ولا عهدا قدامى % % 39(@)(@@) % ما استفادوا كرما في ولكن % % خلقوا من طينة المجد كراما % % 40(@)(@@) % من رجال لبسوا الملك جديدا % % وافتلواناصية الدهر غلاما % % PageV01P2352 41(@)(@@) % روضوا العلياء حتى اقتعدوا % % ظهرها الذروةمنه والسناما % % 42(@)(@@) % وإذا الأيام غمت أقبلوها % % غررا تقدح في الخطب وساما % % 43(@)(@@) % ببني عبد الرحيم استحلبت % مزن الجود وقد كن جهاما % % 44(@)(@@) % أولدواأم الندى فالتقحت % ببنيها بعد أن حالت عقاما % % 45(@)(@@) % ورثوا أصل العلا فافترعوا % % بنفوس ضمنت فيها التماما % % 46(@)(@@) % تركوا الناس قعودا للحبى % % يشتكون العجز أفواجا قياما % % 47(@)(@@) % فتحوا باب الندى واستشهدوا % % بزعيم الدين إذ كان ختاما % % 48(@)(@@) % جاء مأموما وقامت آية % % فيه دلت أنه جاء إماما % % 49(@)(@@) % سبق الناس قروما قروما قرحا % % جذع ريض وما عض اللجاما % % 50(@)(@@) % وحوى السؤدد من أطرافه % % فكلا جنبيه أيمانا وساما % % PageV01P2353 51(@)(@@) % وانتهى في الفضل من حيث ابتدا % % ما تثنى غصنه حتى استقاما % % 52(@)(@@) % ورعى الدولة من تدبيره % % يقظ العين إذا الذائد ناما % % 53(@)(@@) % لو رأى الذئب قريبا سرحه % لعمي من فرق أو لتعامى % % 54(@)(@@) % حاطها سيفا ورأيا ولسانا % % إن تداهى وتلاحى وترامى % % 55(@)(@@) % وشفى أدواءها من معشر % قبل طبوها فزادوها سقاما % % 56(@)(@@) % فهو فيها وأخوه وأخوه % % يذبل ساندرضوى وشماما % % 57(@)(@@) % عزمات كالمقادير مضاء % وقضايا كالأنابيب انتظاما % % 58(@)(@@) % ويد يرتعد السيف بها % % وسماح 
ms748	 لقن الجود الغماما % % 59(@)(@@) % وسجايا تشرب الصهباء منها % % كلما أرعش رأسا وعظاما % % 60(@)(@@) % ومعال كملت ما تبتغى % % لك فيها زائدا إلا الدواما % % PageV01P2354 61(@)(@@) % شرف كان عصاميا فلم % % يرض عن كسبك أو صرت عصاما % % 62(@)(@@) % أنت من جاثيت أيامي به % % وهي خصم فتحامتني احتشاما % % 63(@)(@@) % وتروحت من الثقل وقد % % حفيت جنباي ضغطا وزحاما % % 64(@)(@@) % كم يد أرضعتني درتها % % بعد أن قد كنت عوجلت الفطاما % % 65(@)(@@) % أدركت حالي فكانت بالندى % % في ضرام الفقر بردا وسلاما % % 66(@)(@@) % كنت لي أمتنهم حبل وداد % في الملمات وأوفاهم ذماما % % 67(@)(@@) % فعلام ارتجع الإعراض منى % % ذلك الإقبال والعطف علاما % % 68(@)(@@) % وكمالنسيان والشافع لي % % يخفر الذكرة بي والإهتماما % % 69(@)(@@) % وإذا سحبك عني عبست % فمتى آمل من أرضي ابتساما % % 70(@)(@@) % والملال المر لم فاجأني % % من فتى كان بحبي مستهاما % % PageV01P2355 71(@)(@@) % ونعم أعذركم فالتمسوا % % عذرة المجد إذا ما المجد لاما % % 72(@)(@@) % وانظروا أي جواب للعلا % % إن أتت تغضب لي أو تتحامى % % 73(@)(@@) % فتمنوا فضلتي واغتنموا % % ما وجدتم من بقاياي اغتناما % % 74(@)(@@) % واستمدوها نطافا حلوة % تنهل الإعراض غزرا وجهاما % % 75(@)(@@) % تنفض الأرض بأوصافكم % طبق الأرض مسيرا ومقاما % % 76(@)(@@) % لو أقيمت معجزاتي فيكم % قبلة صلى لها الشعر وصاما % % 77(@)(@@) % أو زقا الأموات يستحيونها % % نشرت بالحسن رمات وهاما % % 78(@)(@@) % فاسمعوها عودا وابقوا لها % % وزرا ما صرف الصبح الظلاما % % 79(@)(@@) % واستماحت روضة ربعية % صبحة النيروز وطفا وركاما % % 80(@)(@@) % وسعى الوفد يحلون الحبى % % نحو جمع ويزفون جماما % % PageV01P2356 81(@)(@@) % كل يوم للتهاني عندكم % % سوق ربح في سواكم لن تقاما % % PageV01P2357 البحر : - 1(@)(@@) % دارت عليك بكأسها % % فلتشكرنك والندامى % % 2(@)(@@) % وجلت جواريها علي % % ك رواقصا غرا وساما % % 3(@)(@@) % تلقى نواحلها الخما % % ص سمينة المعنى جساما % % 4(@)(@@) % يقدمن واضحة الجبي % % ن تشق غرتها الظلاما % % 5(@)(@@) % تحيي وتقتل من رأت % % أبدا وصالا وانصراما % % 6(@)(@@) % تطوى وتنشر في البلا % % د فلا رحيل ولا مقاما % % PageV01P2358 البحر : - 1(@)(@@) % وما ابن أرض غرض لابن سما % % ناران لم يخمدهما سلطان ما % % 2(@)(@@) % يحتربان أبدا على مدى % ثم يكون الأخبث المنهزما % % 3(@)(@@) % ما التقيا قط فعاد خائبا 
ms749	 % % بالخسر إلا من تبدى منهما % % 4(@)(@@) % راميهما لم يخط من صاحبه % % إصابة تدمى ولا تجري دما % % 5(@)(@@) % بر يطيع ربه وفاجر % لكن يخوضان معا جهنما % % PageV01P2359 البحر : - 1(@)(@@) % بيضاء في لجة خضراء سابحة % عدوها النور بل أضدادها الظلم % 2(@)(@@) % لها من النور وجه كله نقط % وغرة كلها للناظرين فم % 3(@)(@@) % من حولها مفردات عن تجمعها % % كأنهن بنات وهي أمهم % 4(@)(@@) % إذا أحطن بها من كل ناحية % حنت لهن بثدي كله حلم % PageV01P2360 البحر : - 1(@)(@@) % وذي جسدين ألقى الصبح منه % ملاءته على الليل البهيم % 2(@)(@@) % ضحوك الوجه مكمدة حشاه % % له أبوان من كرم ولوم % 3(@)(@@) % أسير في يديك رهين حبس % ويسري حكمه باسم وسيم % 4(@)(@@) % له صفة المباسم والتراقي % % وشبه في الأهلة والنجوم % 5(@)(@@) % إذا وليته كتمان سر % أمنت إذاعة الرجل النموم % 6(@)(@@) % وتهلك عينه طورا ويبقى % % له أثر كآثار الرسوم % 7(@)(@@) % له لون يخبر عن وجوه ال % % جنان وقد توغل في الجحيم % PageV01P2361 البحر : - 1(@)(@@) % أتعلمين يابنة الأعاجم % كم لأخيك في الهوى من لائم % 2(@)(@@) % يهب يلحاه بوجه طلق % ينطق عن قلب حسود راغم % 3(@)(@@) % وهو مع المجد على سبيله % % ماض مضاء المشرفي الصارم % % 4(@)(@@) % ممتثلا ما سنه آباؤه % إن الشبول شبه الضراغم % 5(@)(@@) % من أيكة مذ غرستها فارس % ما لان غمزا فرعها لعاجم % 6(@)(@@) % لمن على الأرض وكانت غيضة % أبنية لا تبتغى لهادم % 7(@)(@@) % من فرس الباطل بالحق ومن % أرغم للمظلوم أنف الظالم % % 8(@)(@@) % إلا بنو ساسان أو جدودهم % % طر بخوافيهم وبالقوادم % 9(@)(@@) % أيهم أبكى دما فكلهم % % يجل عن دموعي السواجم % 10(@)(@@) % كم جذبت ذكراهممن جلدي % % جذب الفريق من فؤاد الهائم % PageV01P2362 11(@)(@@) % لا غرو والدنيا بهم طابت إذا % % لم تحل يوما بعدهم لطاعم % 12(@)(@@) % ما اختصمتني فيهم قبيلة % إلا وكنت غصة المخاصم % 13(@)(@@) % ولا نشرت في يدي فضلهم % إلا نثرت ملء عقد الناظم % 14(@)(@@) % إن يجحد الناس علاهم فبما % % أنكر روض نعم الغمائم % 15(@)(@@) % أو قلد الصارم غير ربه % % فليس غير كفه للقائم % 16(@)(@@) % أحق بالأرض إذا أنصفتم % عامرها بشرف العزائم % 17 
ms750	(@)(@@) % يا ناحلي مجدهم أنفسهم % % هبوا فللأضغاث عين الحالم % 18(@)(@@) % شتان رأس يفخر التاج به % % وأرؤس تفخر بالعمائم % 19(@)(@@) % كم قصرت سيوفهم عن جارهم % % خطى الزمان قائما بقائم % 20(@)(@@) % ودفعت حماتهم عن نوب % عظائم تكشف بالعظائم % PageV01P2363 21(@)(@@) % وخولوا من نعمة واغتنموا % % جل السماح عن يمين غارم % 22(@)(@@) % مناقب تفتق ما رقعتم % من بأس عمرو وسماححاتم % 23(@)(@@) % ما برحت مظلمة ديناكم % حتى أضاء كوكب في هاشم % 24(@)(@@) % بنتم به وكنتم من قبله % % سرا يموت في ضلوع كاتم % 25(@)(@@) % حللتم بهديه ويمنه % بعد الوهاد في ذرى العواصم % 26(@)(@@) % وعاد هل من مالك مسامح % تدعون هل من مالك مقاوم % 27(@)(@@) % تخفق راياتكم منصورة % إذا ادرعتم باسمه في جاحم % 28(@)(@@) % عمر منكم في أذى تفضحكم بين قتيل منكم محارب يكفر أو منافق مسالم % % أخباره في سير الملاحمسقط بيت ص % % 29(@)(@@) % ثم قضى مسلما من ريبة % فلم يكن من غدركم بسالم % 30(@)(@@) % نقضتم عهوده في أهله % % وحلم عن سنن المراسم % PageV01P2364 31(@)(@@) % وقد شهدتم مقتل ابن عمه % % خير مصل بعده وصائم % 32(@)(@@) % وما استحل باغيا إمامكم % يزيد بالطف من ابن فاطم % 33(@)(@@) % وها إلى اليوم الظبا خاضبة % من دمه مناسر القشاعم % 34(@)(@@) % والفرس لما علقوا بدينه % % لم تنل العروة كف فاصم % 35(@)(@@) % فمن إذا أجدر أن يملكها % % موقوفة على النعيم الدائم % 36(@)(@@) % لا بد يوما أن تقال عثرة % من سابق أو هفوة من حازم % 37(@)(@@) % لو هبت الريح نسيما أبدا % % لم يتعوذ من أذى السمائم % 38(@)(@@) % أو أمنت حسناء طول عمرها % % عينا لما احتاجت إلى التمائم % 39(@)(@@) % خذ يا حسودي بين جنبيك جوى % يرمي إلى قلبك بالضرائم % 40(@)(@@) % واقنع فقد فتك غير خامل % بالصغر أن تقرع سن نادم % PageV01P2365 41(@)(@@) % لا زلت منحوس الجزاء قلقا % بوادع وسهرا لنائم % PageV01P2366 البحر : - 1(@)(@@) % ذل الفراق لقد رمت يده % % منى أعز فتى على قومي % % 2(@)(@@) % وسقى اللقاء العين لو ظمئت % % من دمعها رويت من النوم % 3(@)(@@) % في الرائحين هوى شعفت به % شعف العواذل فيه باللوم % 4(@)(@@) % يا يوم فاجأنى بفرقته % % لم أجزه 
ms751	 إذ لم يكن يومي % % PageV01P2367 البحر : - 1(@)(@@) % نعم منجميلة إحدى النعم % وإن ضن قلب فقد جاد فم % 2(@)(@@) % نعالج في الحب مر الكلا % % م ونقنع منه بحلو الكلم % 3(@)(@@) % وتبرد أكبادنا خلسة % من اللحظ أو زورة في الحلم % 4(@)(@@) % فداء جميلة تحت الظلام % % ونومتها ساهر لم ينم % 5(@)(@@) % صحا من مقبلها بالمدام % % وأبرئ من طرفها بالسقم % 6(@)(@@) % تغرب حب ابنة العامري % فساق إلى العرب ود العجم % 7(@)(@@) % أما وتمايلها والنسيم % يجور على قدها إن حكم % 8(@)(@@) % وجاعل مفتاح رزق العباد % % يمين أبي قاسم ما قسم % 9(@)(@@) % عرفت لنفسي سوى حبها % % خصيما صبرت له إن ظلم % 10(@)(@@) % وكيف يصاحب ذلا فتى % بسعد تعلق أوفى العصم % PageV01P2368 11(@)(@@) % فتى ضبة يوم أخذ الترات % وشيخهم يوم رعى الذمم % 12(@)(@@) % وبدر تفرع من شمسهم % % فما تركا دولة للظلم % 13(@)(@@) % تلفت يسأل أشياخهم % % ليلحق في المجد سعيا بهم % 14(@)(@@) % فأخبره الخال عن خير جد % وحدثه الأب عن خير عم % 15(@)(@@) % وجمع شتى سجاياهم % فكن الندى وكريم الشيم % 16(@)(@@) % فإن كان يوم جدا قال خذ % وإن تك نائبة قيل قم % 17(@)(@@) % وإن طرقوا بابن ليل أذم % له جوده وابن صبح ألم % 18(@)(@@) % لقوه بسعدهم المستنير % فكان الهزبر وكان الخضم % 19(@)(@@) % فمن مبلغ النصح عنى أباه % % وما أنا في النصح بالمنهم % 20(@)(@@) % إذا ما سألت أبا قاسم % % فإن شئت أسر وإن شت نم % PageV01P2369 21(@)(@@) % شبيهك خلقا وخلقا نراه % % كما القدم الوفق أخت القدم % 22(@)(@@) % أبا القاسم دعوة من فتى % وصال الندى فيه وصل الرجم % 23(@)(@@) % أتى عاثرا حظه بالزمان % % فإن أنت قلتسلام سلم % 24(@)(@@) % سرى الشوق بي أودعت حاجة % سمعت لها بعد طول الصمم % 25(@)(@@) % فحملت رحلي محفوفة % بإدراك ما تتمنى الهمم % 26(@)(@@) % مطاوي للاأرض إما انتشرن % مصابيح إما شققن الظلم % 27(@)(@@) % علمن مرادي أو خلتهن % تبطن بالحزم تحت الحزم % % 28(@)(@@) % فلما طلعن بنا النهروان % % تعاقدن طاعة حكم الحكم % 29(@)(@@) % وجلن برملجلولا فسمن % سنابكهن إباء السأم % 30(@)(@@) % وخنقن بالماء في خانقي % % ن حبا لما بعدها أو قرم % PageV01P2370 31(@)(@@) % وما 
ms752	 شمن حلوانحتى حلا % % بأفواهها طعم فوس اللجم % 32(@)(@@) % وبشرهابالجبالالحصا % % وكانت جبالا وكنا العصم % 33(@)(@@) % تزاحمها أشرات بها % % كأن أكمتها في الأكم % 34(@)(@@) % ولما قضى سيرها ما قضى % % لنا الله من نيل أسنى القسم % 35(@)(@@) % وألقتنهاوند مطروحة % وراء شممنا نسيم الكرم % 36(@)(@@) % فجئتك أخبر من ذا أزو % % ر من ملك وبمن ذا ألم % 37(@)(@@) % بداءينشوق برا إذ رآك % % وأخر لم يبر بعد العدم % 38(@)(@@) % وقد جر شهرا علي المقام % % وأني وجدا كأن لم أقم % 39(@)(@@) % ولكن عنيون بي إذ حضرت % عنيون بالأمر بعدي الملم % 40(@)(@@) % أضاميم عند العطا مذ نأيت % أبى شمل عزهم أن يضم % PageV01P2371 41(@)(@@) % ضربت لهم أجلا في اللقاء % % قصيرا وإن طال حزنا وغم % 42(@)(@@) % يعدون للشوق أيامه % % يخالونه قبل تم استتم % 43(@)(@@) % إذا عرضت منهم ذكرة % مسحت لها كبدي من ألم % 44(@)(@@) % فإذناسلمت لهذا الوداع % % وإن قلتها عن فؤاد وجمء % % 45(@)(@@) % غدا أنبذ العز نبذ الحصاة % % وأهجر للخوف دار الحرم % 46(@)(@@) % وأترك دارك لاقاليا % % ورائي وبين يدي الندم % 47(@)(@@) % وبعد فحين ترانيالعراق % فقد نشر العلم منى علم % 48(@)(@@) % وسوف يناشدني السائلون % % بمجدك وهو أبر القسم % % 49(@)(@@) % بماذا رجعت وماذا احتقبت % % وماذا ركبت وأين الحشم % 50(@)(@@) % وكل المخبر عني يقول % % من البحر جاء فماذا غيم % PageV01P2372 51(@)(@@) % فحدثتهم عنك بي كيف شئت % فبالروض يظهر فضل الديم % 52(@)(@@) % متى يبعث الدهر مثلي لكم % % ألا إنها فرصة تغتنم % 53(@)(@@) % فللمرء ذكران في رفده % فذكر يزين وذكر يصم % 54(@)(@@) % سلمت وزارك منى السلا % % م ما أورقت شجرات السلم % 55(@)(@@) % وحياك محيى العلا في ذرا % % ك ما ناوب الغدوات العتم % PageV01P2373 البحر : - 1(@)(@@) % أعلل فيك ببرد النسيم % فؤادا عليلا بحر الهموم % 2(@)(@@) % وأعتاض بالبدر لو ناب عن % % ك قامة غصن وألحاظ ريم % 3(@)(@@) % وهذا اشتباهكما في الوجوه % % فأين اشتباهكما في الجسوم % 4(@)(@@) % أقام وبنت وأحظى لدى % أن يفتدى ظاعن بالمقيم % 5(@)(@@) % سقاك الغمام ودارا تض % % م أهلك أعرفها بالغميم % 6(@)(@@) % أحب ولم يك لي موطنا % % لحبك نازح تلك الرسوم % 7(@)(@@) % وقال الوشاة ولاموا علي % % ك 
ms753	 لو يظفرون بسمع الملوم % 8(@)(@@) % رعى الله قلبك من حافظ % صحيح على كل عهد سقيم % 9(@)(@@) % أفي كل يوم حبيب يخون % % فيحمل حادثه للقديم % 10(@)(@@) % إلى كم تطيل وقوف النجو % % م بعد هواك ارتقاب النجوم % PageV01P2374 11(@)(@@) % وتبغي الرقاد ابتغاء الخلي % ودون سلامة ليل السليم % % 12(@)(@@) % خذوا عذلكم ودعوا للغرام % % حشا يقتضيه اقتضاء الغريم % 13(@)(@@) % وقم يا نديمي وكم نخبة % عصيت عليها اقتراح النديم % 14(@)(@@) % فغن بذكرهم واسقني % % بماء جفوني ماء الكروم % 15(@)(@@) % وغالط بشكرك شكر الزمان % % بخفض الكريم ورفع اللئيم % 16(@)(@@) % ودافع بأيامه ما استطعت % فيوم سفيه بيوم حليم % 17(@)(@@) % ووارحمتا لك مستنصرا % % عليه بغير ابنعبد الرحيم % 18(@)(@@) % ولكن إذا ما ذكرت الحسين % ذكرت الثراء لكف عديم % 19(@)(@@) % وجردت سيفا تفل الخطوب % مضاربه نافذات العزيم % 20(@)(@@) % من البيض ما طبع الفرس من % % ه للهند زبرة مجد تميم % PageV01P2375 21(@)(@@) % هم القوم تعقد تيجانهم % % عمائم فوق الوقار العميم % 22(@)(@@) % ويشهد أبناؤهم مثله % لآبائهم بصفاء الأروم % 23(@)(@@) % رأى شعبة لي من بينهم % % مشعبة المجد في بيت روم % 24(@)(@@) % فقام بنصرتها والكري % % م صب الفؤاد بنصر الكريم % 25(@)(@@) % أبا قاسم زعم المجد لا % % أخيب وأنت بأمري زعيمي % % 26(@)(@@) % نجم رجالا لإمرارهم % % وتحلوا فنرعاك رعى الجميم % 27(@)(@@) % ومما أبثك إلا سواك % % بشر مخوف وخير مروم % 28(@)(@@) % غدا الناس أعداء ما يحرمو % % ن يهزأ جاهلهم بالعليم % 29(@)(@@) % وصار الغنى قربة للعدو % والفقر مبعدة للحميم % 30(@)(@@) % فكل وحاشاك خل اليسار % % يرى معه وصديق النعيم % PageV01P2376 31(@)(@@) % تعوج ما اعوج دهر عليك % % كما يستقيم مع المستقيم % 32(@)(@@) % ومن شئت فالق بلا حاجة % بوجه طليق وود سليم % 33(@)(@@) % فإن عرضت صرت أي الذليل % لديه وقد كنت أي الكريم % 34(@)(@@) % وكم صاحب كنت بالقرب منه % % أجل محل النبيه العظيم % 35(@)(@@) % فلما رأى حاجتي عنده % % رآني الوصي بعين اليتيم % 36(@)(@@) % وبدلت من بشره والسلام % بقول مريض ووجه شتيم % 37(@)(@@) % ينزلني درجا في اللقاء % % بحسب طروقي له أو لزومي % % 38(@)(@@) % أعني متمم ما قد بدأت % فإن المفاتح رهن الختوم % 39(@)(@@) % غدوت ونصري وجوبا 
ms754	 عليك % % ذمام يدي من زماني الذميم % 40(@)(@@) % بما بيننا من ولاء طريف % وود وبيت وأصل قديم % PageV01P2377 41(@)(@@) % ولو لم يكن غير حلي لديك % % رحال المنى وعقال الهموم % 42(@)(@@) % وبالعصبية بان الأبي ال % % حمي من العاجز المستنيم % 43(@)(@@) % فأردي كليب لحفظ الجوار % ورعى الذمار وصون الحريم % 44(@)(@@) % وللخوف في قومه أن يضا % % م مات ابن حجر قتيل الكلوم % 45(@)(@@) % وخاطرحاجب في قوسه % فخلفها شرفا في تميم % 46(@)(@@) % وما حطك الدهر في سؤدد % تساموا له ووفاء وخيم % 47(@)(@@) % ولا زال ذا الخلق السهل منك % % طريقا إلى كل حظ جسيم % 48(@)(@@) % وودع دارك شهر الصيام % % وداع مشوق كثير القدوم % 49(@)(@@) % يعودك والعيد من بعده % متى فارقا فلسعد مقيم % 50(@)(@@) % على عمل بالتقى ضيق % خفي وملك وسيع وسيم % PageV01P2378 51(@)(@@) % وسعي يوفر أجر المثاب % عليك ويحبط وزر الأثيم % 52(@)(@@) % مدى الدهر ما خضرت أيكة % وطوف بين منى والحطيم % PageV01P2379 البحر : - 1(@)(@@) % أجيراننابالغور والركب متهم % أيعلم خال كيف بات المتيم % 2(@)(@@) % رحلتم وعمر الليل فينا وفيكم % سواء وفيكم ساهرون نوم % 3(@)(@@) % بنا أنتم من ظاعنين وخلفوا % % قلوبا أبت أن تعرف الصبر عنهم % 4(@)(@@) % يقون الوجوه الشمس والشمس فيهم % ويسترشدون النجم والنجم منهم % 5(@)(@@) % أناشد نعمان الأخابير عنهم % كفى خبرة مستفصح وهو أعجم % 6(@)(@@) % وأحلم إشفاقا وللبين أنة % يبين عليها الطائش المتحلم % 7(@)(@@) % ولما جلا التوديع عما عهدته % % ولم يبق إلا نظرة تتغنم % 8(@)(@@) % بكيت على الوادي فحرمت ماءه % % وكيف يحل الماء أكثره دم % 9(@)(@@) % ونفرت بالأنفاس عنى حدوجهم % % كأن مطاياهم بهن توسم % 10(@)(@@) % أعاذل إن كان السلو لغدرة % فأصدق ما حدثت أنى مغرم % PageV01P2380 11(@)(@@) % وددت الهوى يومين وصلا وهجرة % به اليوم يشقى من به أمس ينعم % 12(@)(@@) % وأن ملوكا في بروجرد كرمت % بهم بذلوا الإنصاف فيما تكرموا % % 13(@)(@@) % فميز من أعدائهم أولياؤهم % % إذا انتقموا يوم الجزاء وأنعموا % % 14(@)(@@) % ولكنهم والجور من دين غيرهم % % طريقا بسهم الجور في الناس قسموا % % 15(@)(@@) % فلا ماء إلا في الحسود مرقرق % ولا نار إلا في المحب تضرم % 16(@)(@@) % ألا راكب بين الجبال 
ms755	 سبيله % % يظن نشاطا مسهلا وهو محزم % 17(@)(@@) % يبلغ من بعد السلام رسالة % عساه على أخطارها بي يسلم % 18(@)(@@) % يحط بضبيين جمرة فخرهم % % بحيث انتموا وملكهم حيث خيموا % % 19(@)(@@) % فيطرق أسماعا تصم عن الخنا % % وتصغي إلى داعي الندى فتصمم % 20(@)(@@) % إلام وكان البر منكم سجية % % تواصلنا يخفى وكم نتظلم % PageV01P2381 21(@)(@@) % وما بال غصن فيكم طاب أصله % فرعتم له الهجران فيما فرعتم % 22(@)(@@) % فطبقتم الآفاق وقفا بصيته % % فلما نمى سوئلتم فمسكتم % 23(@)(@@) % أواش دهاني عندكم أم خيانة % جنتها يد حاشاي من ذاك أو فم % 24(@)(@@) % أراجع نفسي أي ذنب رمى بها % % إلى السخط منكم والظنون ترجم % 25(@)(@@) % فلا جرما ما ناصفت في حسابها % % سوى أن مللتم والملال تجرم % 26(@)(@@) % وأن حسودا ربما كان غاظه % % على حظه بالعجز حظي منكم % 27(@)(@@) % تخلت لما أسداه بعدي وجوهكم % فظل وللخالي الشجاعة يلحم % 28(@)(@@) % وبي ما به من غيظه بمحاسني % % لأن كنت فيكم واقفا حيث يرغم % 29(@)(@@) % وما أنا ممن يستغر بخدعة % يعود على أعقابها يتندم % 30(@)(@@) % أسادتنا والجود صيرنا لكم % % عبيدا وعن قوم نعز ونكرم % PageV01P2382 31(@)(@@) % بأي المساعي تكتبون عدوكم % % إذا أنتم أغريتم فقبلتم % 32(@)(@@) % وفي أيما حكم تظنون زلة % فيظهر من تأديبكم إن حرمتم % 33(@)(@@) % ومغريكم بي أن تكفوا نوالكم % % بمجدكم أغراكم لو علمتم % 34(@)(@@) % أعيذكم من مذنب في عقوبة % بقيتم له عذرا ويقدح فيكم % 35(@)(@@) % ولو أنكم لما وجدتم عتبتم % وأعطيتم أصلحتم وشكرتم % 36(@)(@@) % نقصتم بحذف اسمي صحيفة رفدكم % % فما زاد في أموالكم ما نقصتم % 37(@)(@@) % وما الفقر إذ أغفلتم ما منعتم % وليس الغنى لو جدتم ما بذلتم % 38(@)(@@) % ولا كان قدر المال قدر انتقامكم % % ألا بئس فتكات الملوك فتكتم % 39(@)(@@) % ووالله ما لله فيما حفظتم % % ولا للعلا حق وحقي أضعتم % 40(@)(@@) % ولا بي ميزان العطاء وإنه % % ليصغر عندي وهو في الدهر يعظم % PageV01P2383 41(@)(@@) % ولا ذلة عاما فعاما تجد لي % % على صعدة من عطفكم ليس تعجم % 42(@)(@@) % وإني لأرضى من كثير طريقة اب % % تذالي قليلا بالعفاف يتمم % 43(@)(@@) % وحسبي فيما أدعيه بعلمكم % % متى 
ms756	 قلتم في عفتي ما عرفتم % 44(@)(@@) % ولكن مودات عذارى نكحتها % % وإني من تطليقها أتذمم % 45(@)(@@) % ونفس قضت فيكم زمان شبابها % % رجت أنها فيكم تشيب وتهرم % 46(@)(@@) % ويخجلني أن ينشر الناس أنكم % % طويتم من التنويه ما بي نشرتم % 47(@)(@@) % إذا صور الإشفاق لي كيف أنتم % وكيف إذا ما عن ذكري صرتم % 48(@)(@@) % تنفست عن عتب فؤادي مفصح % به ولساني للحفاظ مجمجم % 49(@)(@@) % وفى في ماء من بقايا ودادكم % % كثيرا به من ماء وجهي أرقتم % 50(@)(@@) % أضم فمي صمتا عليه وبينه % % وبين انكساب ريثما أتكلم % PageV01P2384 51(@)(@@) % لمن يذخر المال الفتى وهو قادر % به أن يحوز الحمد وهو مذمم % 52(@)(@@) % ألمظ نفسي عتبكم وهو حنظل % وأورد ما استطيبتم وهو علقم % 53(@)(@@) % فلا مات عرض المرء وهو ابن حرة % وفي الأرض دينار يعيش ودرهم % 54(@)(@@) % أأرباب نعماي التي مذ عدمتها % % علمت وقد أثريت أني معدم % 55(@)(@@) % وخطاب أفكاري التي ولدت لهم % % ذكورا كراما والقرائح تعقم % 56(@)(@@) % متى اعتضتم منى خطيبا بفضلكم % % وهل مثل شعري عن علاكم مترجم % 57(@)(@@) % وما غير مدحي طبق الأرض فيكم % وإن كان ملء الأرض ما قد مدحتم % 58(@)(@@) % سواء إذا لم تسر قبل أوانسي % % وشاعر ما لم يروه الناس مفحم % 59(@)(@@) % فما بال عامي هجركم لي جفاهما % % جديبين عام الهجرة المتقدم % 60(@)(@@) % أثقلت أم كنت المعيدي عندكم % % سمعتم به غير الذي قد نظرتم % PageV01P2385 61(@)(@@) % فلا شكروا فضل العتاب فإنه % % فضالات داء الصدر والداء يكظم % 62(@)(@@) % وما فاض حتى ضاق عنه إناؤه % % وقد يملأ القطر الإناء فيفعم % 63(@)(@@) % صبرت لكم حولين تلوين راجيا % % أخيب ووقع الجرح في الجرح مؤلم % 64(@)(@@) % وأشهد إن لم تغنني العام هذه % % فلا ريع ممنوع ولا جاد منعم % 65(@)(@@) % إذا شئتم أن تنظروا كيف يبتني ال % % علاء الثناء فانظروا كيف أنتم % PageV01P2386 البحر : - 1(@)(@@) % قد قنعنا أن نرقب الأحلاما % % لو أذنتم لمقلة أن تناما % % 2(@)(@@) % يالواةالديون إن غريم % لكم لو قضبتموه الغراما % % 3(@)(@@) % ما لكم لا يذم منكم بغاة ال % % عيب إلا إلا لكم أو ذماما % % 4(@)(@@) % بقلوب 
ms757	 لا تحسن الصفح غلظ % ووجوه لا تحسن الإجراما % % 5(@)(@@) % لا أحل الفراق من رشإ في % % كم أحلت نواه نفسا حراما % % 6(@)(@@) % صار حظي من بعده عشق ذكرا % % ه إلى أن عشقت فيه الملاما % % 7(@)(@@) % لا ادعت بعده الغصون قواما % % عند عيني ولا البدور تماما % % 8(@)(@@) % يا صريع العيون إن فتر الغن % % ج لحاظا بها فترت عظاما % % 9(@)(@@) % حبذا بابل على ذكرك السح % % ر وعيش ببابل لو داما % % 10(@)(@@) % وطريق إلى المراخ نفضنا % % ه على بعده ضنا وغراما % % PageV01P2387 11(@)(@@) % وربيع من عصر لهو عصرنا % % ه أن الله لم يهبه أثاما % % 12(@)(@@) % ومتى قلت عد ليوم مضى من % ى فإني لا أعرف الأياما % % 13(@)(@@) % قل لقوم عدوا الغنى كله البخ % % ل وعدوا السماحة الإعداما % % 14(@)(@@) % حسبوا من قنوطهم أنهم لا % % يجمعون النعيم والإنعاما % % 15(@)(@@) % حسب عبد الرحيمأن بنيه % % وصلوا باتباعه الأرحاما % % 16(@)(@@) % صدقوا عنه فاستقاموا مصلي % % ن على إثره ومر أماما % % 17(@)(@@) % فاقهم وهو منهم ابن علي % والخوافي مكفورة بالقدامى % % 18(@)(@@) % ساد بالمجد ثم ما شئت من ج % % د إذا اعوجت الخطوب استقاما % % 19(@)(@@) % تأكل العين منه ما تشرب النف % % س اتفاقا في حبه والتئاما % % 20(@)(@@) % قمر زينت سماء علاه % % بنجوم من رهطه تتسامى % % PageV01P2388 21(@)(@@) % لا يعد الغلام منهم أخاه % % ساد حتى يشآى الكهول غلاما % % 22(@)(@@) % يال عبد الرحيم أحصدتم لي % % سببا كان في سواكم رماما % % 23(@)(@@) % قعد الدهر بي لئيما فقمتم % % تحملون الخطوب عنى كراما % % 24(@)(@@) % أنهضوني بوصفكم إنني ما اع % % تدت أن أقهر الجبال زحاما % % 25(@)(@@) % للتهاني وصف يخص وإن كا % % نت سعاداتكم تعم العاما % % 26(@)(@@) % وفر الله يا أبا القاسم اليو % % م من الخير عندك الأقساما % % 27(@)(@@) % وأراني فيك التي خير حسا % % دك حالا من شم فيها الرغاما % % 28(@)(@@) % بالغا فوق ما تروم من الع % % ز إذا فات طالبا ما راما % % 29(@)(@@) % في نحور العدا شجا ما غدا النا % % س إلى النحر سائقين السواما % % PageV01P2389 البحر : - 1(@)(@@) % يا مستضيم الملك أين الحامي % % يا جدب ما فعل السحاب الهامي % % 2(@)(@@) % حرم 
ms758	 الإمارة كيف حل سلوكه % % من غير تلبية ولا إحرام % 3(@)(@@) % ما للعراق عقيب صحته اشتكى % % سقما يجاذب من ذيول الشام % % 4(@)(@@) % من غص في دار السلام وإنما % % هي حين تعمر بيضة الإسلام % 5(@)(@@) % أأصيب بالشمس الضحى أم خولست % % فيها الليالي البيض بدر تمام % 6(@)(@@) % أم هل هوى بأبي علي نجمها % % رام تعود بالنجوم يرامي % % 7(@)(@@) % قدر أصاب الصاحب ابن صلاحها % % بيد فكانت أم كل سقام % 8(@)(@@) % بغريبة الإلمام ما خطرت على % % بال ولا سبقت إلى الأوهام % 9(@)(@@) % عهدي التجنب بالردى عن مثله % % يا موت ما سبب لذا الإقدام % 10(@)(@@) % أفمستجيرا حيث عز رواقه % % لمخافة دهمتك أو إعدام % PageV01P2390 11(@)(@@) % فلقد وصلت إلى المنيع المرتقى % % ولقد حططت ذرى المنيف السامي % % 12(@)(@@) % وغصبتنا من لم يفدنا مثله % % جوب الملا وتعاقب الأعوام % 13(@)(@@) % وحيا مطرناه على يأس الثرى % % من جوه وقطوب كل غمام % 14(@)(@@) % عقل الزمان به ووقر نفسه % % فالآن عاد لشرة وعرام % 15(@)(@@) % بشراك يا ساعي الفساد وغبطة % ذهب المقوم يا بني الإجرام % 16(@)(@@) % عاد القوي على الضعيف مسلطا % % ونمى السفاه فدب في الأحلام % 17(@)(@@) % سوم خيولك للثغور مريدها % % واطمع وسم بالملك رخص مسام % 18(@)(@@) % واخلط بنومك مطمئنا حيث لم % % يك مورد لتروم حط لجام % 19(@)(@@) % خلى لك الحسن السبيل وأخليت % % منه عزائم رحلة ومقام % 20(@)(@@) % لا سدد الخطي في طلب ولا % % شحذت لمثلك شفرتا صمصام % PageV01P2391 21(@)(@@) % من للجيوش وقد أصيب عميدها % % ما البيت بعد عماده لقيام % 22(@)(@@) % من للدسوت وللسروج محافظ % ظهريه من حزم بها وحزام % 23(@)(@@) % من للفتوة بعد موتك إنها % % رحم تضم وأنت تحت رجام % 24(@)(@@) % من لابن وحدته تقوض قومه % % ومضى أبوه يا أبا الأيتام % 25(@)(@@) % من للبلاد تضمها ورعية % أرضعتها الإنصاف بعد فطام % 26(@)(@@) % ولدارك الفيحاء إلا بابها % % شرقا بضيق مواكب وزحام % 27(@)(@@) % ملكت على حراسها وتسلبت % % أبوابها من دافع ومحامي % % 28(@)(@@) % مثلوا قعودا وسطها وقصارهم % % بالأمس خطوة واصلين قيام % 29(@)(@@) % يدعوك بالإصغار في اسمك ناقص % من قبل أن ندعوك بالإعظام % 30(@)(@@) % خطروا بها الخيلاء بعد مراتب % معدودة 
ms759	 الخطوات بالأقدام % PageV01P2392 31(@)(@@) % واسترسلوا بيد التحية واحتبوا % % فصحاء بعد تطاول الإعجام % 32(@)(@@) % من كل مقصوص اللسان شكمته % % قبل الردى من هيبة بلجام % 33(@)(@@) % ذرب يقول ولو سمعت تلجلجت % شفتاه غدر التاء بالتمتام % 34(@)(@@) % زل الزمان غداة يومك زلة % لا تتقى خجلاتها بلثام % 35(@)(@@) % عار جنى عارا على الأعوام % أبدا ويومك منه عار العام % 36(@)(@@) % لا سد ثغرتنا سواك مفوقا % % إلا امرؤ عن قوس رأيك رامي % % 37(@)(@@) % يجرى على سنن رآك نهجته % % كالفتر معتمدا على الإبهام % 38(@)(@@) % أتراك تسمع لي وأبرح نازل % بك ضعف فهمك مع قوى إفهامي % % 39(@)(@@) % ألممت أستعدي بلحدك من جوى % % قلبي فزاد صبابتي إلمامي % % 40(@)(@@) % قبر خلطت مدامعي بترابه % % ونداك فهو الآن بحر طامي % % PageV01P2393 41(@)(@@) % وأجله عن شق جيب إنه % % فدى الجيوب عليه بالأعلام % 42(@)(@@) % ووقفت أجزيك الثناء مؤبنا % % يا لوعتي أن كان ذاك مقامي % % 43(@)(@@) % هذا جزاي وليس ذلك نعمة % % فيما مننت فكيف كان غرامي % % 44(@)(@@) % لو رشت قادمتي فطار قصيصها % % أو لو كسوت من الهزال عظامي % % 45(@)(@@) % إن لم يكن لي منك يوم خصني % % فلقد علمتك صالح الأيام % 46(@)(@@) % ولقد أعد إذا بكيتك صادقا % % في الحافظين وواصلي الأرحام % 47(@)(@@) % أصلي وأصلك في مقر واحد % وتفاوت الفرعين بالأقسام % 48(@)(@@) % وإذا تشجرت المناسب والتقى ال % % فخران كان أبوك من أعمامي % % 49(@)(@@) % شرف وصلنا حبله في فارس % بالمحكمين مرائر الإبرام % 50(@)(@@) % برمون بالإعراض بعد غبورهم % % وسماء يمتدحون بالأجسام % PageV01P2394 51(@)(@@) % ولقد جمعت إلى مديحك حاديا % ناحاك فاستذممت خير ذمام % 52(@)(@@) % فتحوا ضريحك في مساكن تربة % جاورتها فختمت طيب ختام % 53(@)(@@) % ونزلت فيمضر وقومك غيرهم % % بعد الممات بأشرف الأقوام % 54(@)(@@) % أنى التفت فأنت في حرزين من % % حرمي شهيد سيد وإمام % 55(@)(@@) % أصبحت منهم بالنزول عليهم % يا رحب ما بوثت من إكرام % 56(@)(@@) % فإذا تزخرفت الجنان غدا لهم % % صاحبتهم فدخلتم بسلام % PageV01P2395 البحر : - 1(@)(@@) % أنبه طرفي وهو يخدع بالحلم % وأصدق نفسي وهي تقنع بالرجم % 2(@)(@@) % أسر بأن أبقى وهلكي من البقا % % وأكره أن أذوى ومن صحتي سقمي % % 3(@)(@@) % تمسكت من دهري بمستلب 
ms760	 القوى % % ضعيف الذمام واحد الحمد والذم % 4(@)(@@) % أصاب بخطب منه إما مفوقا % % إلي وإما خاطئا عاثر السهم % 5(@)(@@) % وما أنا في الأمرين إلا رديئة % إذا كان رام لا محالة أن يصمي % % 6(@)(@@) % حلمت على الأيام حتى ظننتني % % على فرط ما يظلمن أسفه بالحلم % 7(@)(@@) % وأعلم لو صاعبتهن بأنني % % أحارب شيئا ثم أجنح للسلم % 8(@)(@@) % تنقص منى كل يوم وليلة % وتعجبني إن زاد شربي أو طعمي % % 9(@)(@@) % وما أنا إلا شارب الماء من دمي % % مغالطة أو آكل الزاد من لحمي % % 10(@)(@@) % ولم أر كالدنيا بغيضا محببا % % ولا عدل مثل الموت أشبه بالظلم % PageV01P2396 11(@)(@@) % ألا جاءني والقول حق وباطل % نعي تغشى ثم أقشع عن رغمي % % 12(@)(@@) % أغمض عيني منه عن كاشف العمى % % وأستر أذني فيه عن مسمع الصم % 13(@)(@@) % أصبنا بأم تعجب الحال أنه % % بأمثالها في الفخر يوفى على العم % 14(@)(@@) % خليلي من كسرى بن سابورإنما % % عظيمكما المدعو في النوب العظم % 15(@)(@@) % قفا فانظرا حزني بعادي مصابها % % إذا انضم في الأحزان سقم إلى سقم % 16(@)(@@) % أسلى بفرعي بعد أصلي فإنما % % إلى العظم تفضي مشية الداء في اللحم % 17(@)(@@) % وفي الأمر أن تنسى ولا مثل هذه % % تنافى المعاني قي تشاركها في اسم % 18(@)(@@) % فإن لم يكن لي عندها بولادة % مكان البنين من حضان ومن ضم % 19(@)(@@) % فقد ولدت نفسا كنفسى كرامة % علي وإن حدت بجسم سوى جسمي % % 20(@)(@@) % وفي الإخوة الجافين أبناء علة % وفي الأجنباء الأصفياء بنو أم % PageV01P2397 21(@)(@@) % ألا لا تعرفها بغير ابنها أبا % % وقد ينسب الإنسان يوما بمن ينمي % % 22(@)(@@) % أيشفيك أن تبكي فهذي مدامعي % % ببيض وحمر بين سكب إلى سجم % 23(@)(@@) % وإن تحمل الأحزان دونك أضلعي % % فوا الله لا جلدي يخور ولا عظمي % % 24(@)(@@) % وهل رد ميتا مسرف في غرامه % فأنفق نفسي عنك هينة الغرم % 25(@)(@@) % ويسليك أن الفضل تربك والتقى % % بما سلبا منها شريكاك في اليتم % 26(@)(@@) % فإن أخرتك باقيا وتقدمت % بلا جزع لاقته فيك ولا إثم % 27(@)(@@) % ففي العيش ما يشتاق منه إلا الردى % % وفي الوصل ما يحتاج 