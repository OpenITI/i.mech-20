ms361	 خرمن صبر رهی %~% تا صبح دمید روشنایی، می سوخت!(@)(@@)(@@)(@@) | انوری(@)(@@) (@@) 3622 دل، گرچه غمت زجان نهان می دارد %~% اشکم، همه خرده در میان می دارد(@)(@@) (@@) جان، بی تو کنون فراق تن می طلبد %~% دل، بی تو کنون ماتم جان می دارد!(@)(@@) (@@) 3623 دل، درد تو یادگار دارد بی تو %~% اوله %~% و اندوه توه در کنار دارد بی تو(@)(@@) (@@) با این همه، من زجان به جان آمده ام %~% تا، درتن من چه کار دارد بی تو؟(@)(@@) (@@) 3624 چرخ از تو، به حیله ها جدا کرد مرا %~% رضی %~% با درد فراقت، آشنا کرد مرا(@)(@@) (@@) من، قدر وصال تونمی دانستم %~% هجران تو لاجرم، سزا کرد مرا(@)(@@) (@@) 3625 بخت بدم، از بر تو آواره بکرد %~% دوری توام، غریب و بیچاره بکرد(@)(@@) (@@) وصل تومرا، بر فلک هفتم برد %~% هجر تو در افکند و، به صد پاره بکرد(@)(@@) (@@) 3626ای ترک، فراقت نه به بازوی من است %~% بی روی تو، روی هر غمی سوی من است(@)(@@) (@@) هجر توام ای نگار، می رنجاند %~% می نشناسد، بگو که: «(هندوی من است!)(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3627 آن کیست، که هجران رخ او زرد نکرد؟ فرقش، زفراق یار پر گرد نکرد؟(@)(@@) (@@) توعمر خوش منی، به هنگام وصال %~% از رفتن عمر خوش، که را درد نکرد؟(@)(@@) ~~3628 دل، جام طرب به دست اخلاص گرفت در کوی طلب، جنبش رقاص گرفت(@)(@@) (@@) مسکین خبرش نیست، که سلطان فراق %~% اقطاع وصال، جمله با خاص گرفت!(@)(@)PageV01P552(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0556.jpg)(@)(@)(@@) ~~36299 یا لشکر زنگ، پیش و پس بگرفته ست یا رومی روز را، عسس بگرفته ست!(@)(@@) ~~یا تیره شب هجر، دهان بگشادهست یا در گلوی صبح، نفس بگرفتهست!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3630 در عشق، تنم ز موی باریک تراستروزم، ز سر زلف تو تاریک تر است(@)(@@) (@@) کار دل من، که زندگانی زتوداشت %~% دور ازتو، کنون به مرگ نزدیک تر است!(@)(@@)(@@)(@@) | وکی اکاف(@)(@@) (@@) 3631 گر دلبر من، راز دلم بشنودی %~% یک بار دگر، روی به من بنمودی(@)(@@) (@@) آخر، به قیامتش بخواهم دیدن %~% ای 
ms362	 کاش، قیامت من اکنون بودی!(@)(@@) (@@) 332 گر من، به منل هزار جان داشتمی %~% در پیش تو، جمله بر میان داشتمی(@)(@@) ~~گفتی: دل هجر هیچ داری؟ گفتم: 3632 دانی تو، که من بی توچه رسوا(@)(@@) باشم؟ %~% اشهری %~% گر داشتمی دل، دل آن داشتمی! %~% چون واله و سرگشته و شیدا باشم؟(@)(@@) (@@) هرگز دل غمگنم، به تو شاد مباد %~% ثیی %~% گر بی تو دمی شاد بدم، یا باشم!(@)(@@) (@@) 3634 از مدت هجران تو، غمگینم من %~% وز خون دو دیده، جامه رنگینم من(@)(@@) ~~فی الجمله چه شرح می دهم؟ شرمم باد!بی روی توزنده ام، چه سنگینم من!(@)(@@) (@@) 3635 شب، همچویکی طبیب هندو زادست %~% قیفال، ز دیدگان من بگشادهست(@)(@@) (@@) خورشید، مگر که در مغاک افتادهست %~% یا خود فلک از دور، فرو افتاده ست!(@)(@@)(@@)(@@) | مهستی(@)(@@) (@@) 3636 آمد شب و، شد جهان روشن تاری %~% در شأن من آمد، آیت بیداری(@)(@@) (@@) خورشید، به مه داد خط بیزاری %~% چنبر بشکست چرخ را، پنداری!(@)(@@)(@@)(@@) | معزی(@)(@@) (@@) 3637 یار، از غم من خبر ندارد گویی %~% یا خواب، به من گذر ندارد گویی(@)(@@) (@@) تاریک تر است هر زمانی، شب من %~% یارب، شب من سحر ندارد گویی!(@)(@)PageV01P553(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0557.jpg)(@)(@)(@@)(@@)(@@) | برتضی(@)(@@) (@@) 3638 ای عکس رخت، سروروان را سایه %~% وز سنبل زلفت، ارغوان را سایه(@)(@@) (@@) جانی تو، اگر سایه نداری بر من %~% معذوری، از آنکه نیست جان را سایه!(@)(@@) (@@) 3639 دردا، که رخ بخت ز من تافته ماند %~% پیراهن خوشدلیم، نابافته ماند(@)(@@) (@@) جستم به هزارجان ودل، وصل تورا %~% من گم شدم و، وصل تونایافته ماند!(@)(@@)(@@)(@@) | اسعد گنجهای(@)(@@) (@@) 3640 ای برده غم تو، شادمانی را آب %~% تا کی دهم از سرشک، خانی را آب؟(@)(@@) (@@) در لعل توآب زندگانی است، ولیک %~% بی روی تونیست، زندگانی را آب!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3641 در عشق تو، بنگر که چه رنجور کسم %~% وز وصل تو، بنگر که چه مهجور کسم(@)(@@) (@@) بی هیچ بهانه، از تو دوری جستم %~% یارب، که چگونه از خدا دور کسم!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~3642 در عارض تو، نقش طرب شاید 
ms363	 دیددر زلف تو، صد شور و شغب شاید دید(@)(@@) (@@) در روزاگر نبینمت، نیست عجب %~% اوله %~% ماهی توو، ماه را به شب شاید دید!(@)(@@) ~~3643 ای توش وتوان، توش وتوان با توبرفت وی راحت جان، راحت جان با توبرفت(@)(@@) (@@) از سروقدت، روان ترم طبعی بود %~% وله %~% رفتی توو، آن طبع روان با توبرفت!(@)(@@) (@@) 3644 از مهر شدی دور، به کین نزدیکی %~% دوری به بسی، به زچنین نزدیکی!(@)(@@) (@@) از دیده شدی دور، به جان نزدیکی %~% من، دور ندیدهام بدین نزدیکی!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~364 یاری، که زلب به لعل کان نزدیک است وزحسن، به ماه آسمان نزدیک است(@)(@@) (@@) از دیده اگر دور شد او، باکی نیست %~% دور است زدیده و، به جان نزدیک است!(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3245 هر روز، تنم بسی بکاهد زفراق %~% هر شب، جانم به حق پناهد زفراق(@)(@@) (@@) کشتهست مرا فرلق، دردا که مرا %~% کس نیست، که خون من بخواهد زفراق!(@)(@)PageV01P554(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0558.jpg)(@)(@)(@@)(@@)(@@) | نمط چهارم(@)(@@)(@@)(@@) | در شکر از فراق(@)(@@)(@@)(@@) | الؤلؤی(@)(@@) ~~3647 هجران، که فراق آن نگار آید از او در جور هزار روزگار آید از او(@)(@@) ~~مر چند، که جور بیشمار آید از اوآخر، نه [که] بوی وصل یار آید از او!(@)(@@) (@@) 3648 ای زردی رخ، چوجان به کاری تومرا %~% زیرا که ز دوست، یادگاری تو مرا(@)(@@) (@@) وی هجر اگر [] غمگساری تو مرا %~% زبیرا که نشان عشق یاری تو مرا!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 3640 گفتم که شوم به وصلت، آگاه ز هجر %~% و ایمن باشم به مهرت، ای ماه زهجر(@)(@@) (@@) گر وصل چنین است، که دیدم زتو من %~% فریاد زوصل و، لوحش الله زهجر!(@)(@@) (@@) 3650 از عمر که بگذشت، بلا می بینم %~% وز بخت که برگشت، جفا می بینم(@)(@@) ~~از هجر، در این میان وفا می بینمباری، ز کیان ببین چها می بینم!(@)(@@) (@@) 3651 جانا، زغمت حکایتی دارم خوش %~% وز توبا تو، شکایتی دارم خوش(@)(@@) (@@) گر معزولم، زملکت وصل تومن %~% در هحرانت، ولایتی دارم خوش!(@)(@@)(@@)(@@) | فلکی شروانی(@)(@@) (@@) 365 گر نزد تو ای نگار، مقبول 
ms364	 نیم %~% جز در غم تو، به هیچ مشغول نیم(@)(@@) (@@) گر تولیت وصال تو، نیست مرا %~% باری زغم فراق، معزول نیم!(@)(@@)(@@)(@@) | جمال خلیل(@)(@@) ~~بر وصل تو، هجران تورا بگزیدم 3653 از بس سخنانت، که عیان می شنوم(@)(@@) %~% وله %~% کز وصل تو، لاف این و آن می شنوم %~% و احوال تورا، از این وآن می شنوم(@)(@@) (@@) 3654 دل، در هوس قامت طاقت دارم %~% جان، درغم و درد و اشتیاقت دارم(@)(@@) ~~گر روز وصال تو، چنین خواهد بودبس شکر، که از شب فراقت دارم!(@)(@)PageV01P555(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0559.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3655 گرچه که ز اشتیاق تو می میرم %~% وز عشق تو، در وثاق تو می میرم(@)(@@) (@@) چندان شکر است از فراق تو مرا %~% کز آرزوی فراق تو می میرم(@)(@@) (@@) 3656 نه مهر تو، در وفاق تومی طلبم %~% اوله %~% نه، خاک در وثاق تومی طلبم(@)(@@) (@@) دیروز، زدل وصال تومی جستم %~% امروز، به جان فراق تو می طلبم(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3657 گرچه زدهام، در وثاقت همه عمر %~% ور چه بودم، در اشتیاقت همه عمر(@)(@@) (@@) از ذوق فراق تو، چو آگاه شدم %~% دست من و، دامن فراقت همه عمر!(@)(@@)(@@)(@@) | نمط پنجم(@)(@@)(@@)(@@) | تمنا وآرزومندی(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~3658 شخصی دارم: دلی خراب اندروی جانی دارم: هزار تاب اندر وی(@)(@@) ~~وز آرزوی روی تو، دارم شب و روز چشمی و، هزار چشمه آب اندر وی!(@)(@@)(@@)(@@) | شفروه(@)(@@) ~~3659 صد سال دگر، که مرده باشم زغمت برخاکم ار گذر کنی، از کرمت(@)(@@) (@@) بر بوی تو زنده گردم و، بار دگر %~% یمین %~% خاک قدمت شوم، به عذر قدمت!(@)(@@) ~~3660 ای گشته خجل، پری و حور از رویت خورشید گرفته وام، نور از رویت(@)(@@) (@@) در آرزوی روی تو داریم، امروز %~% له %~% چشمی و هزار اشک، دور از رویت!(@)(@@) (@@) 3661 چون روی، ز حسرتت فرا خاک کنم %~% و اندیشهآ آن قامت چالاک کنم(@)(@@) (@@) والله، ز میان خاک سر بردارم %~% وله %~% وز شوق، گریبان کفن چاک کنم!(@)(@@) ~~366 چون دیدن آن سروروان، در خواب است آرام دل و راحت جان، 
ms365	 در خواب است(@)(@@) (@@) در خواب، چوروی یار می شاید دید %~% بیداری بخت عاشقان، در خواب است!(@)(@)PageV01P556(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0560.jpg)(@)(@)(@@) ~~وان خار، که سر بر زند از خاک رهی 3663 تا، رونق بازار رخت خواهد بود(@)(@@) %~% اوله %~% هم، تشنهآ گلزار رخت خواهد بود! %~% چشمم همه، در کار رخت خواهد بود(@)(@@) ~~366 دوش، ارچه فراق ترکتازیها کرد تا روز، چه گویمت؟ که اندیشهآ من(@)(@@) %~% یا مستی صبر سرفرازیها کرد! %~% با آرزوت چه عشقبازیها کرد!(@)(@@) (@@) 3665 یاد تو کنم، کار مرا ساز آید چون بنشینم، حدیث وصل تو کنم %~% خ(@)(@@) %~% فو %~% نام توبرم، عمر شده باز آید %~% با من، در و دیوار به آواز آید!(@)(@@) (@@) 366 بیم است، که بی زیور جانم بینی %~% وزضعف، به دیدهآ گمانم بینی(@)(@@) (@@) ازجان، نفسی با تو هنوزم باقی است %~% خ %~% گر نشتابی، در آن جهانم بینی!(@)(@@) ~~3667 تا دست وصال تو، نگیرم در دست نه لب روزی، به خنده خواهم بگشود(@)(@@) %~% نه چشم شبی، ز گریه خواهم در بست! %~% وز دو لب میگونت، نگردم سرمست(@)(@@) (@@) 3668 در چنبر دوستی، در آرم سر تو %~% بیرون نبرم هیچ، سر از چنبر تو(@)(@@) (@@) باشد که مگربرنهم، ای جان و جهان %~% لب بر لب ورخ بر رخ و، بر بر برتو!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3669 هرگز باشد، که دل زغم برهانم؟وین سوز فراق را، ز دل بنشانم؟(@)(@@) (@@) فریاد کنان، دست در آن زلف زنم %~% وانصاف، از آن لب ودهان بستانم؟(@)(@@)(@@)(@@) | (@)(@@) (@@) گاهی چو زمین، بوسه زنم برقدمت 367 گر هیچ، سعادتم نشاند بر تو %~%(@)(@@) اخ %~% گاهی چو فلک، گردم گرد در توا %~% جان پیش کشم، مباش گو در خور تو!(@)(@@) ~~14ا دن یاد نوآرد، بشود هوش از هوش(@)(@@) ~~دیدار تورا، چشم همی دارد چشم PageV01P557(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0561.jpg)(@)(@)(@@) (@@) 3672 گه، بوی خوشت ز پیرهن می شنوم %~% گه، وصف رخت زخویشتن می شنوم(@)(@@) (@@) چون هیچ نباشد، کسکی بنشانم %~% تا نام تومی گوید و، من می شنوم!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3673 رو یم، چوبدان روی نکوی تو رسد %~% وز گلشن وصل 
ms366	 و مهر، بوی تو رسد(@)(@@) (@@) بستم ره آب دیدهآ خود، تا اشک %~% آن روی نشوید، که به روی تورسد!(@)(@@)(@@)(@@) | مرتضی(@)(@@) (@@) 3674 خرم دل آنکه حلقهآ موی تودید %~% وان جعد چو سنبل سمنبوی تودید(@)(@@) ~~دی چشم تو بوسیدم، امروز بتامی بوسم، روی آنکه او روی تودید!(@)(@@) (@@) 3675 از چشم سرت، گرچه نهان می بینم %~% احوال تو را، زمان زمان می بینم(@)(@@) (@@) گفتار تو را، به گوش جان می شنوم %~% دیدار تو را، به چشم جان می بینم!(@)(@@) ~~3676 از صبح دوم، خوش نفسی می آید در سر ز نسیمش، هوسی می آید(@)(@@) (@@) ترسم که چوصبح، جامه بر خود بدرم %~% کز جامهآ او، بوی کسی می آید!(@)(@@)(@@)(@@) | عزیز شروانی(@)(@@) (@@) 3677 رفت آن غم دل، که باز گفتیم به هم %~% وان وصل، کزو چو گل شکفتیم به هم(@)(@@) (@@) دردا، که زیکدگر جدا افتادیم %~% تا باردگر، کجا؟ کی افتیم به هم؟(@)(@@)(@@)(@@) | شفروه(@)(@@) (@@) 3278 روزم ز تو، دلفروز باشد گویی %~% بختم زتو، کیسه دوز باشد گویی(@)(@@) ~~روزی، که وصال توبود روزی منآن روز، کدام روز باشد گویی؟(@)(@@) ~~3679 دلدان، از آنچه گفت اگر باز آید کارم، به مراد دل مگر باز آید(@)(@@) ~~اسباب نشاط، جمله هست الآ اویارب، چه بود اگر ز در باز آید!(@)(@@)(@@)(@@) | خر(@)(@@) ~~328 از چرخ کهن، محنت و دردم تازهست وز نالهآ من، همنه جهان آوازهست(@)(@@) (@@) وین غصه، که من می کشم از هجرانت %~% چون آرزوی من به تو، بی اندازه ست!(@)(@)PageV01P558(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0562.jpg)(@)(@)(@@)(@@)(@@) | کمال اسماعیل(@)(@@) ~~3680 جانم ز غمت در تف و تب می میرد وزآرزویت، به روز و شب می میرد(@)(@@) (@@) در بحر فراق تو، چو افتاد دلم %~% اوله %~% در آرزوی کنار و لب، می میرد!(@)(@@) ~~3682 هر شب زغم تو، ای نگارین یارموز مهررخ چوماهت، ای دلدارم(@)(@@) (@@) تا وقت سحر، به ماه در می نگرم %~% وز دیده، ستارگان فرو می بارم!(@)(@@) (@@) 3683 ای رفته وجود در سر آرزوت %~% پیدا شده بر من، اثر آرزوت(@)(@@) (@@) خونی، که زچشم من 
ms367	 بریزد غم تو %~% بر خاک نویسد، سمر آرزوت!(@)(@@)(@@)(@@) | خا(@)(@@) (@@) 3684 دی، دفتر اندیشه فراهم شده بود %~% عزم سر کوی دوست، محکم شده بود(@)(@@) (@@) دل گفت که: خوش دمی است، یارب این دم %~% چون باز خود آمدم من، آن دم شده بود!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3685 گویی بینم، به رغم این دشمن من از بازوی من قلاده، در گردن تو(@)(@@) %~% پیراهن تویکی و، پیراهن من؟ %~% وز گیسوی تو کمند، در گردن من!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3686 از آرزوی روی تو، بگداخت تنم %~% وز خون دو دیده، لعل شد پیرهنم(@)(@@) (@@) گویی بودا شبی، که تودر بزنی %~% من گویم: کیست آن؟ تو گویی که: منم!(@)(@@) (@@) 3287 با یارنشستن، آرزو می کندم %~% وز غصه برستن، آرزو می کندم(@)(@@) (@@) عهدی کردم، که نیز نامش نبرم %~% آن عهد شکستن، آرزو می کندم!(@)(@@) (@@) یاری که جدا نبود از من، نفسی 3688 ایام وصالش، آرزو می کندم %~% وله(@)(@@) %~% در خواب، خیالش آرزو می کندم! %~% زیبا خط وخالش، آرزو می کندم(@)(@@) (@@) 3689 نزد تو نشستن، آرزو می کندم %~% زلف تو شکستن، آززومی کندم(@)(@@) ~~ک پا ک..(@)(@)PageV01P559(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0563.jpg)(@)(@)(@@) (@@) 3690 جان، دوش هوای وصل دلبر میزد %~% هر در که رسید، حلقه بر در میزد(@)(@@) (@@) دل، چون مگس از حسرت آن تنگ شکر %~% فریاد کنان، دو دست بر سر میزد!(@)(@@) (@@) 33691 من، دوش به آرزوی رویت هر دم %~% در رنگ گل و باده، نگه می کردم(@)(@@) (@@) با ساغر و، با رباب [تا] وقت سحر %~% بر یاد رخت می زدم و، می خوردم!(@)(@@) (@@) 3692 دوش، آن سر زلفین بتابش دیدم %~% و اندر بر خود، مست خرابش دیدم(@)(@@) ~~وان خال سیه زمشک نابش، دیدمدردا که بدین صفت، به خوابش دیدم!(@)(@@) ~~گفتا که: مراد تو بخواهم دادن 3693 خوش خفته بدم من، از غم گلبویان(@)(@@) %~% از خواب در آمدم به کی، کی؟ گویان! %~% دیدم بت خویش را، که آمد پویان(@)(@@)(@@)(@@) | اثیر الدین(@)(@@) (@@) 3694 من، نیمشبی دوش بر یار شدم %~% با او نفسی، محرم اسرار شدم(@)(@@) ~~رویی که بدان 
ms368	 [روی] نهادم، زطرب بر روی زمین بود، چوبیدار شدم!(@)(@@)(@@)(@@) | اوله(@)(@@) (@@) 3695 ای صیح، به نیم خنده دادم دادی %~% چیزی زرخ یار، به یادم دادی(@)(@@) (@@) وی باد، بدین بوی معطر که توراست %~% وله %~% زنهار که چون بوی، به بادم دادی!(@)(@@) (@@) 3696 ای گوهر قیمتی، ز دریا واپرس %~% یعنی که زچشم وسینهآ ما، واپرس(@)(@@) (@@) وان دم، که به تشنگان خود وانگری %~% گر هیچ مرا ببینی آنجا، واپرس!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3691 پشتم ز غمت گر بخمد، باکی نیست %~% ورجان زبر من برمد، باکی نیست(@)(@@) (@@) در آخر آن شبی که با تو گذرد %~% گر صبح قیامت بدمد، باکی نیست!(@)(@@)(@@)(@@) | مجد الدین بغدادی(@)(@@) (@@) 369 دانی که چراست، ای پسندیدهآ من %~% پر آب، دو دیدهآ ستمدیدهآ من؟(@)(@@) شاید ز آرزوی لب تو %~% آب، از دهن مردمک دیدهآ من PageV01P560(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0564.jpg)(@)(@)(@@)(@@)(@@) | رضی الدین(@)(@@) (@@) 3699 گفتی که: زعهد ما تورا یاد آید؟ %~% یا هرگزت از وفای ما یاد آید؟(@)(@@) (@@) یادم نایی، زانکه زیادم نروی %~% کز یاد شده، بود که با یاد آید(@)(@@) (@@) 3700 ای باد، پیامی ز فلانی بستان %~% بگذر تو بدو، وز او نشانی بستان(@)(@@) (@@) یک راه، به بوی زلف او دستم گیر %~% وانگاه، به پایمزد جانی بستان!(@)(@@) (@@) 3701 ای درد تو درمان کسی، وان کس من %~% وی عشق تو در جان کسی، وان کس من(@)(@@) (@@) گویی که ببینم، لب چون قند تورا؟ %~% خر %~% خاییده به دندان کسی، وان کس من(@)(@@) (@@) 3702 خود را، به حیل در افکنم مست آنجا %~% تا بنگرم، آن جان وجهان هست آنجا؟(@)(@@) (@@) با پای رساندم، به مقصود دلم %~% یا سربنهم، همچو دل از دست آنجا!(@)(@@) (@@) 3701 دل، خستهآ درد توست درمانش کن %~% غمگین هوای توست، شادانش کن(@)(@@) (@@) دشخوارتر است کار دل، هر ساعت %~% یک ساعته کار توست، درمانش کن(@)(@@) ~~3704 روزی، بینی مرا تومست افتادهدر حلقهآ زلف بت پرست افتاده(@)(@@) ~~دستار ز سر، قدح ز دست افتادهدر پای تو سر نهاده، مست افتاده!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~3705 ای من به فدات کرده جانم، دریابوی داده 
ms369	 به باد خان و مانم، دریاب(@)(@@) (@@) از غایت آرزوی روی چومهت %~% یک موی نماند که نمانم دریاب(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3706 اکنون که هزینه کرد هجران نفسم %~% ای باد سپیده دم به فریاد رسم!(@)(@@) (@@) بویی ز دو زلف آن نگارین، به من آر %~% اوله %~% تا جان بدهم، دل نبود باز پسم!(@)(@@) (@@) 3707 تا چند، سخنهای مزور گوییم؟ %~% یا خود، غم خود به نوع دیگر گوییم؟(@)(@@) (@@) برخیز و بیا، تا دوبه دو بنشینیم %~% حال دل خویش، یک به یک برگوییم!(@)(@)PageV01P561(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0565.jpg)(@)(@)(@@)(@@)(@@) | نمط ششم(@)(@@)(@@)(@@) | در امید(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 3708 چرخ از پی تو، همی دواند ما را %~% زهر غم تو، همی چشاند ما را(@)(@@) (@@) نومید نیم ز بخت، آخر روزی %~% وله %~% یک بار دگر، به هم رساند ما را!(@)(@@) (@@) 3709 نام تو برم، روان من تازه شود %~% یاد تو کنم، طرب ز اندازه شود(@)(@@) (@@) وان روز، که اومید وصالت باشد %~% از بیخودی ام، به عالم آوازه شود!(@)(@@) (@@) 3710 آخر، سحری بود شب تار مرا %~% و آخر، نظری بود به من یار مرا(@)(@@) (@@) زین کار فرو بسته، نگردم نومید %~% باشد که گشایشی بود، کار مرا(@)(@@) ~~3711 ای دل، سر آرزو به پای اندر بند اومید، به فضل رهنمای اندر بند(@)(@@) (@@) چون می دانی زخلق چیزی ناید %~% نومید مشو، دل به خدای اندر بند(@)(@@) ~~3712 از دست غمت، شکسته شد پای امیدخود هیچ نماند در دلم جای امید(@)(@@) (@@) اومید من او وفا نخواهد کردن %~% پس وای دل و، وای من و، وای امید(@)(@@) (@@) 3713 هم درد دل مرا، دوایی برسد %~% هم کار غمم، به منتهایی برسد(@)(@@) (@@) گر رشتهآ عمر نگسلد، هم روزی %~% سر رشته اومید، به جایی برسد!(@)(@@) ~~با محنت هجر، پای می باید داشت آخر، سر این این رشته به جایی برسد!(@)(@@) ~~3715 ای وصل تو، برتر از تمنای امیدناپخته بمانده بی تو، سودای امید(@)(@@) (@@) من در تو کجا رسم؟ که آنجا که تویی %~% نه دست طلب رسید و، نه پای امید!(@)(@)PageV01P562(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0566.jpg)(@)(@)(@@) ~~3716 
ms370	 از سوز تو، جانم ای دلارام بسوخت دل، در غمت از سردی ایام بسوخت(@)(@@) ~~سودای تو، آتشی برافروخت نخستدر آخر کارش، طمع خام بسوخت!(@)(@@) ~~3717 آن فتنه، که روی یارم انگیخته بودجانم، به یکی موی در آو یخته بود(@)(@@) (@@) اومید مرا گرفت دست، ارنه فلک %~% بی هیچ بهانه، خون من ریخته بود!(@)(@@) (@@) 3718 ای دل، چو اسیر آن مهی هیچ مگو %~% وزعادت او چوآگهی، هیچ مگو(@)(@@) (@@) از روی تکلف، دل خود خوش میدار %~% باشد که ازاین غم برهی، هیچ مگوا(@)(@@) (@@) 3719 گر ملک سلیمان، به گدایی برسد %~% وصلت، به چومن بی سر وپایی برسد(@)(@@) (@@) اومید بدان نیست، که کار چومنی %~% باچون تو کسی، به هیچ جایی برسد!(@)(@@)(@@)(@@) | خی(@)(@@) (@@) 3720 گر، با رخ توبه لاله زاری برسم %~% بی شک، به بهشت و جویباری برسم(@)(@@) (@@) در بحر غمت، چو اشک موج افکندم %~% آخر به لبی، یا به کناری برسم!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) ~~3721 بی روی تو، از هلاک جانم غم نیست یاد [توا ز آب زندگانی کم نیست(@)(@@) ~~با این همه اندیشه، به وصل رخ تو کمتر زامیدی بود، آنم هم نیست!(@)(@@)(@@)(@@) | وله(@)(@@) ~~3722 خاک قدمت، به تاج خورشید ارزدیکروزه غمت، به عمر جاوید ارزد(@)(@@) ~~شکر ایزد را، که از تونومید شدم وین نومیدی، هزار اومید ارزد!(@)(@@)(@@)(@@) | لغیره(@)(@@) ~~3723 از پای دلم، دام غم او بگشایدوزشب، نفس صبحدم او بگشاید(@)(@@) (@@) از بستگی کار، شکایت نکنم %~% آن کس که فروبست، هم او بگشاید!(@)(@@)(@@)(@@) | یمین اصفهانی(@)(@@) ~~3724 هم، گردد بخت خفته بیدار آخر هم، شاخ امید آورد بار آخر(@)(@@) (@@) هم، با سر دوستی شود یار آخر %~% جاوید چنین نماند، این کار آخر!(@)(@)PageV01P563(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0567.jpg)(@)(@)(@@) ابوالحسن طلحه(@)(@@) (@@) 3725 هم، با سر دوستی و آزرم شود %~% هم، بر من بیچاره دلش نرم شود(@)(@@) (@@) سرما چوبه غایت رسد، آخر روزی %~% خورشید بتابد و، جهان گرم شود!(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3726 نه، دل به کسی جز از تومایل دارم %~% نه، از تو مراد خویش حاصل دارم(@)(@@) (@@) جای تو دل من است 
ms371	 و، اومید من آنک %~% در بر گیرم، هر آنچه در دل دارم!(@)(@@) (@@) 3727 کودل؟ که در آن روی نکو شاید بست %~% یا صبر؟ که دست غم فرو شاید بست(@)(@@) (@@) خود در دل پاره پارهام نیست درست %~% چندانکه امید اندر او شاید بست!(@)(@@)(@@)(@@) | مهذب(@)(@@) (@@) 3728 ناز تو، فلک هم به سر آرد آخر %~% با من دل تو، سر اندر آرد آخر(@)(@@) (@@) خاری که زهجران تو، در جان من است %~% روزی گل وصل تو، بر آرد آخرا(@)(@@)(@@)(@@) | الغیره(@)(@@) (@@) 3729 هر چند، زهجر دوست هستم به عذاب %~% نومید شدن ز وصل هم: نیست صواب(@)(@@) (@@) هم باز شود نقاب مهر، از مهتاب %~% یک روز، به جوی رفته باز آید آب!(@)(@@)(@@)(@@) | علی بن الحسن(@)(@@) (@@) 3730 ما را به تو، از بخت نوید است هنوز %~% نومید شدن ازتو، که دیدهست هنوز(@)(@@) (@@) گر روز فراق تو دراز است، دواست %~% ما را، شب وصل از توامید است هنوز!(@)(@@)(@@)(@@) | سید محمود(@)(@@) ~~3731 با من، چه ستم کان بت بد پیشه نکرد؟خونم بکشید و، هیچ اندیشه نکرد(@)(@@) (@@) در باغچهآ امیدم، از جور و جفا %~% آن کرد، که هزار تیشه در بیشه نکرد!(@)(@@) (@@) 3732 هر روز در این زمانه، مستی است مرا %~% مستی نه زمی، ز تنگدستی است مرا(@)(@@) (@@) شکر ایزد را، که تنگ دستی است مرا %~% کاخر روزی، امید هستی است مرا(@)(@@) (@@) 3733 گر بر سر من ز چرخ آتش بارد %~% ممکن نبود، که دل تورا بگدارد(@)(@@) (@@) آخر روزی، گذر کند بر دل تو %~% کآن سوخته دل، بعه ما امیدع داره PageV01P564(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0568.jpg)(@)(@)(@@) ~~3734 آن دل، که دل از خویشتنش بگرفته ست بی تو، هوس خون شدنش بگرفتهست(@)(@@) (@@) در هجر توجان بر سرپای است، ولیک %~% فخ %~% اومید وصال، دامنش بگرفته ست!(@)(@@) (@@) 3735 بر من، غم گردون به سر آید آخر %~% نیک اختریم، کارگر آید آخر(@)(@@) (@@) مهتاب شقاوتم، فرو شد به زمین %~% خورشید سعادتم، برآید آخر!(@)(@@)(@@)(@@) | نمط هفتم(@)(@@)(@@)(@@) | در طعنه(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~لاحول کنی، چو ریش بینی امروز 3736 دی بود ز 
ms372	 روی تو، مه اندرتگ و تاز(@)(@@) %~% آن دیو، به لاحول کجا گردد باز! %~% وز زلف خوشت بود همه مشک طراز(@)(@@)(@@)(@@) | سیفی(@)(@@) (@@) 3737 ای مه، به کف ابر زبون خواهی شد %~% وی شاخ سمن، بنفشه گون خواهی شد(@)(@@) (@@) ای رایت نیکویی، نگون خواهی شد %~% در چشم من است، آنکه خون خواهی شد!(@)(@@)(@@)(@@) | اسدی(@)(@@) ~~3738 بیماری عشق، چون ز من برد قرار از روی و لبت، گلشکرم بود به کار(@)(@@) (@@) و اکنون همه روزمی کنم شکر، بدانک %~% آن گلشکرت نماند و، به شد بیمار!(@)(@@)(@@)(@@) | اخ(@)(@@) ~~3739 کافور تو، با مشک سرشتند آخر بر برگ گلت، بنفشه کشتند آخر(@)(@@) ~~دعوی کردی به پادشاهی، یکچند منشور زوال تو، نبشتند آخر!(@)(@@)(@@)(@@) | أخر(@)(@@) ~~3740 تا کی، ز سر سرکشی و غایت نازهر لحظه، حدیث هجر گیری آغاز؟(@)(@@) (@@) من نیز، نمیرم از غم عشق کسی %~% یکچند بگریم و، خمش گردم بازا PageV01P565(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0569.jpg)(@)(@)(@@) (@@) 36 %~% باب چهاردهم - فراق(@)(@@) (@@) 3741 ای ریش، بیا از رخ او سر برکن %~% آبش ببر، آتش دلم کمتر کن(@)(@@) ~~این کره، عجب تند وشموش است، ای چخ زودش تو، سر افسار سیه بر سر کن!(@)(@@) (@@) 3742 اندر رخ بی خطان، که ره داند کرد %~% تا نیک، به رو یشان نگه داند کرد؟(@)(@@) (@@) بی ریش، سخنشان زانا الحق باشد %~% خاقانی %~% هم ریش، که رویشان سیه داند کرد!(@)(@@) (@@) 3743 از عشق لب تو، بیش تیمارم نیست %~% کآلودهآ لبهاست، سزاوارم نیست!(@)(@@) (@@) گر خود به مثل آب حیات است، آن لب %~% چون خضر بدو رسید، بر کارم نیست!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3744 طوطی دم و دینارنشان است، آن لبغماز و دوروی، از پی آن است آن لب(@)(@@) (@@) زنهار، میالای در آن لب نامم %~% وله %~% کآلودهآ لبهای کسان است، آن لب!(@)(@@) (@@) 3745 شد، آن غم دل که می کشیدم زتومن %~% وان عشوه ودم، که می شنیدم زتومن(@)(@@) (@@) من باتوچنان بدم، که ناخن با گوشت %~% اکنون که دراز شد، بریدم زتومن!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3746 خوبان، زپی سر که شکر نفروشند بهر درم، از 
ms373	 لعل شکر نفروشند(@)(@@) (@@) با ناجنسان، برای زر ننشینند %~% وز بهر طمع، عمر به زر نفروشند!(@)(@@)(@@)(@@) | عبدالرزاق(@)(@@) (@@) 3747 بر من مزن ای صنم، که من پستم خود %~% مفزای ستم، که واله و مستم خود(@)(@@) (@@) امشب، ز حساب صد شب دیگر گیر %~% کت یاد نیامد، که کسی هستم خود!(@)(@)PageV01P566(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0570.jpg)(@)(@)(@@)(@@)(@@) | لغیره(@)(@@) (@@) 3748 سیارهآ روز رو شناییت منم %~% بازار کساد را، رواییت منم(@)(@@) (@@) چون از همه باز مانی، آیی بر من %~% معشوقهآ روز بینواییت منم!(@)(@@)(@@)(@@) | نمط هشتم(@)(@@)(@@)(@@) | درتهدید وتعییر(@)(@@) (@@) 3749 از درد دل پر غمم، ای ماه بترس %~% خر %~% وی خفته، زنالهآ سحرگاه بترس(@)(@@) (@@) در هر نفسی، تعبیه دارم آهی %~% ای آینه، می گویمت: از آه بترس!(@)(@@)(@@)(@@) | رضی(@)(@@) (@@) 3750 هر نیمشبم، درد توبیدار کند %~% اندیشهآ تو، در دل من کار کند(@)(@@) (@@) زان می ترسم بتا، که درد دل من %~% روزی، به چنین شبت گرفتار کند!(@)(@@)(@@)(@@) | صدر(@)(@@) ~~375 هر لحظه، غمی به مستمندی رسدت تیری زجفا، به دردمندی رسدت(@)(@@) (@@) در کشتن عاشقان، از این بیش مکوش %~% زنهار، مبادا که گزندی رسدت!(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~3751 با خصم منت، همیشه دمسازیهاستبا ما، سخنت زروی طنازیهاست(@)(@@) (@@) از عز خود و ذلت من، بیش مناز %~% کاندر پس پردهآ فلک، بازیهاست!(@)(@@)(@@)(@@) | لغیرها(@)(@@) (@@) 3752 در وعدهآ تو، کدام فرداست که نیست؟ %~% واندر سرم ازعشق، چه سوداست که نیست؟(@)(@@) ~~یک قطره زآب شرم و، یک ذره وفا در چشم و دلت، خدای داناست که نیست!(@)(@@) ~~3750 گفتم حق صحبت قدیمت گیرد واندوه دل من، به دو نیمت گیرد(@)(@@) (@@) آنت نگرفت، وه که دود دل من %~% روزیت بگیرد و، عظیمت گیرد!(@)(@@)(@@)(@@) | دختر ستی(@)(@@) ~~3255 گه خصم شوی مرا و، گه یار آیی روزی به هزار گونه، در کار آیر(@)(@@) (@@) ای دوست، نترسی که به خون دل من %~% روزی، به چنین شبسی گرفتار آبی؟(@)(@)PageV01P567(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0571.jpg)(@)(@)(@@)(@@)(@@) | عایشه(@)(@@) (@@) 3756 تیر دردم، بدوزدت می دانم %~% وین آتش من، فروزدت می دانم(@)(@@) (@@) مشغول نگردم، به دعا کردن بد %~% خود سوز دلم بسوزدت، می دانم!.(@)(@@) (@@) 3757 افسوس، 
ms374	 که طبع دلفروزیت نبود %~% جز پرده دری و، سینه سوزیت نبود(@)(@@) (@@) من داده بدم به تو، دل و دیده وجان %~% تو برده بدی، ولیک روزیت نبود!(@)(@@) (@@) 3758 آنی، که فلک ستاره را تاج تو کرد %~% مه، کشور روم را به تاراج تو کرد(@)(@@) (@@) خود را و مرا، به معرفت باز شناس %~% هر چند، مرا زمانه محتاج تو کرد!(@)(@@) (@@) 3759 از دل صنما، مهر تو بیرون کردم %~% وان کوه غم تورا، چوهامون کردم(@)(@@) (@@) امروز نگویمت، که چون خواهم کرد؟ %~% فردا بینی که گویمت: چون کردم!(@)(@@)(@@)(@@) | مهذب(@)(@@) ~~3760 تا چند کنی، قصد به جان آمدهای؟ تا چند زنی، بر سر محنت زدهای؟(@)(@@) (@@) بر حسن مکن تکیه، مبادا که شبی %~% کاری بکند، درد دل دلشدهای!(@)(@@) ~~3761 ای عارض تو، جهانفروز دل من دل نیست زعشق تو، به سوز دل من(@)(@@) (@@) چون من، ز سر جان و جهان برخیزی %~% گر بنشینی، شبی به روز دل من!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~3762 آن جان و جهان، که کاهش قلب آمدمردانه، بدیدمش که در قلب آمد(@)(@@) ~~پنداشته ام، که هست چون من به عیارچون بر محک دل زدمش، قلب آمد!(@)(@@)(@@)(@@) | رضی(@)(@@) (@@) 3763 بر من ستم و جور، از این بیش مکن %~% آهنگ، به خون دل درویش مکن(@)(@@) ~~روزیت، به خون من بخواهند گرفتامروز، از آن روز بیندیش، مکن!(@)(@@)(@@)(@@) | الیاس(@)(@@) ~~372 سخت آمدم از تو، سست پیمانیها وز چون تو سبکروح، گر انجانیها!(@)(@@) (@@) ترسم که چو جوییم، پشیمان باشی %~% بس سود نداردت پشیمانیها!(@)(@)PageV01P568(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0572.jpg)(@)(@)(@@)(@@)(@@) | مهستی(@)(@@) ~~3765 از رنگ رخ تو، گل عجب شرمگن است وز طعم لبت بتا، رطب شرمگن است(@)(@@) (@@) هر بی ادبی که در سرت هست، مکن %~% کز بی ادبیهات، ادب شرمگن است!(@)(@@)(@@)(@@) | فاضی(@)(@@) ~~3766 گیرم ره بادی، که ز کوی تو رسد تا زو به من دلشده، بوی تورسد(@)(@@) (@@) این سوخته را، از آتش غم برهان %~% زان پیش، که دود او به روی تورسد!(@)(@@) ~~3767 ای زلف ورخ تو، در جهان رای همهخاک کف پای تو، 
ms375	 دلارای همه(@)(@@) (@@) گر با دگری به زمنی، وای به من %~% ور با همه کس چوبا منی، وای همه!(@)(@@) ~~3768 تا کی، دل من فگار خواهد بودن؟وز دست تو، زاروار خواهد بودن؟(@)(@@) (@@) امروز، زجور هرچه خواهی می کن %~% صدر %~% فردا، همه را شمار خواهد بودن!(@)(@@) (@@) 3769 ای در نفست تعبیه، جانی دیگر %~% وی عالم لطف تو، جهانی دیگر(@)(@@) (@@) در باقی کن بدین زمان، جور و جفا %~% تا باز نگویم، به زبانی دیگر!(@)(@@) ~~377 کو آن همه سوگند؟ که خوردی با من کز راه جفا هیچ نگردی، با من(@)(@@) ~~ماندهست از آن من، که چون نامردان کردی با من، هرآنچه کردی با من!(@)(@@)(@@)(@@) | خ(@)(@@) ~~377 تا کی، دلت آزار مرا ساز کند؟خوی تو، جفا و جور آغاز کند؟1(@)(@@) (@@) امروز بکن هر چه توانی، فردا %~% ریش تو، مکافات تو خود باز کند!(@)(@@)(@@)(@@) | نمط نهم(@)(@@) در وفا به اول وجفا به آخر(@)(@@)(@@)(@@) | ابوالحسن(@)(@@) (@@) 3276 اول، ز هزار گونه رنگ آوردی %~% تا خسته دل مرا، به چنگ آوردی(@)(@@) (@@) اکنون، به جفا پای نهادی با من %~% تا، دست دلم به زیر سبنگ آوردی!(@)(@)PageV01P569(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0573.jpg)(@)(@)(@@)(@@)(@@) | وله(@)(@@) (@@) 3773 اول، دل من چونامهآ مهر توخواند %~% وصل تو مرا، ز ناز بردیده نشاند(@)(@@) (@@) واکنون، که دلت زمهر دامن افشاند %~% با من به جز از دریغ، چیزی بنماند!(@)(@@)(@@)(@@) | سوکی(@)(@@) (@@) 3774 ز اول، همه دوستی نمودی با من %~% و آخر، همه دشمنی فزودی با من(@)(@@) (@@) با آن همه، نیستم زوصلت نومید %~% تا بو که چنان شوی، که بودی با من!(@)(@@) ~~3775 در عشق، بگو شیوهآ مستوری چیست؟در نامدنت، حجت معذوری چیست؟(@)(@@) (@@) نزدیک شدی به ما و، دور افتادی %~% آن نزدیکی چه بود، واین دوری چیست؟(@)(@@) (@@) 3776 یارم، که ز مه به حسن ناموس ببرد %~% نرخ همه قندها، به یک بوس ببرد(@)(@@) (@@) بر بود دلم اول و، آخر برکشت %~% افسوس دل من، که به افسوس ببرد!(@)(@@)(@@)(@@) | کمال زیاد(@)(@@) ~~3777 ای دوست، همان راحت جانی که بدیوآن عشوه فروش دلستانی که بدی(@)(@@) ~~امروز، 
ms376	 دلت خلاف دمسازی ماستیا من نه منم، یا تونه آنی که بدی!(@)(@@) (@@) 3778 جانا، دل من به عهد بد بشکستی %~% زان گونه که از تونسزد، بشکستی(@)(@@) (@@) با من کردی هزارعهد، اول کار %~% وآخرهمه را، چوزلف خود بشکستی(@)(@@)(@@)(@@) | نمط دهم(@)(@@)(@@)(@@) | درتنهایی(@)(@@)(@@)(@@) | خر(@)(@@) (@@) 3279 خوناب گرفت حقهآ دانایی %~% شد تیره زغم، آینهآ بینایی(@)(@@) ~~در پیش من، ارچه مردمان بسیارنددور از رویت، بمردم از تنهایی!(@)(@@) (@@) 3780 فریاد، که فریاد رسی نیست مرا %~% یمین %~% در کوی وفا، همنفسی نیست مرا(@)(@@) (@@) گر کس بدمی، کسی بدی همدم من %~% چون هیچکسم، هیح کسی نیست مرا!(@)(@)PageV01P570(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0574.jpg)(@)(@)(@@) ~~3781 گشتیم دگر باره، گرفتار زعشق رسوای جهان شدیم، زین بار زعشق(@)(@@) (@@) کس نیست، که با او غم دل بتوان گفت %~% فریاد ز بیکسی و، زنهار زعشق!(@)(@@)(@@)(@@) | یمین(@)(@@) (@@) 3782 تنها ام، کاشکی تنی داشتمی %~% یا زور بدی، که پای بفراشتمی(@)(@@) (@@) ای دوست، به جای تواگر من بدمی %~% تنهات، بدین روز بنگداشتمی!(@)(@@)(@@)(@@) | *(@)(@@) (@@) 3283 کو همنفسی، که راز گویم با او %~% حال دل خسته، باز گویم با او؟(@)(@@) (@@) در عالم، کونیازمندی چون من %~% تا واقعهآ نیاز گویم، با او؟(@)(@@) (@@) 3784 از تنهایی فزود غم، مایهآ من %~% لالام غم است و، درد دل دایهآ من(@)(@@) (@@) جز سایه، در این خاک ندارم یاری %~% هم سایهآ من، که هست همسایهآ من!(@)(@@) ~~3785 ما، این غم دل با که گساریم آخر؟ کس نیست، که با او نفسی بتوان(@)(@@) زد %~% تنها، همه عمر چون گذاریم آخر! %~% زین غصه، دمی با که بر آریم آخر؟(@)(@@) ~~378 نه، قصهآ آن شمع چگل بتوان گفت! نه، حال من خوار و خجل بتوان گفت!(@)(@@) (@@) غم در دل تنگ من از آن است، که نیست %~% خر %~% یک دوست، که با او غم دل بتوان گفت!(@)(@@) ~~3787 آن یار، که در سینه جنون دارم از او بر هر مژه، صد قطرهآ خون دارم از او(@)(@@) (@@) کنجی و دمی و محرمی می طلبم %~% تا شرح دهم، که حال چون دارم از او!(@)(@@) (@@) 3788 
ms377	 فارغ نشود، دل من از غم نفسی %~% و ین چشم سرشک بارم، از نم نفسی(@)(@@) (@@) تا، شرح نم چشم و غم دل گویم %~% کومحرم و دوستی، کجا همنفسی!(@)(@@) ~~جز آینه، روی همدمی نتوان دید 3789 برکس به وفا، چون که رقم نتوان زد(@)(@@) %~% زین پس، به ره مهر قدم نتوان زد %~% زان نز چه فایده؟ که دم نتوان زدا PageV01P571(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0575.jpg)(@)(@)(@@) ~~3790 درد تو، که کاروان صد درمان زد برداشت زدل دست، کنون در جان زد(@)(@@) ~~صاحب دردی کجا، که با او نفسی از درد دل خود، نفسی بتوان زد!(@)(@@)(@@)(@@) | نمط یازدهم(@)(@@) درضعف وزردی روی(@)(@@)(@@)(@@) | لاادری(@)(@@) (@@) 3791 چونان شده ام، که دید نتوانندم %~% تا پیش توای نگا ننشانندم(@)(@@) (@@) خورشید توو، به ذره من مانندم %~% چون ذره به خورشید همی راننذم(@)(@@)(@@)(@@) | جمال عبد الرزاق(@)(@@) (@@) 3792ای خستهآ عارض چوماهت که منم %~% وی شیفتهآ زلف سیاهت که منم(@)(@@) (@@) از ضعف چنانم، اگرم وابینی %~% باور نشود به صد گواهت، که منم!(@)(@@) (@@) 3793 با دل، همه شب حدیث تومی گویم %~% بوی تو، زهر باد صبا میجویم(@)(@@) (@@) رخساره به خون دیده، زان می شویم %~% تا روز دگر، زرد نباشد رویم!(@)(@@) ~~3794 دور از توچنان شدهست، کزضعف تنم پیوسته، میان تهی بود پیرهنم(@)(@@) (@@) در رسم خطاب، از آن بگویم که منم %~% زیرا که به عقل، راست ناید سخنم!(@)(@@) ~~3795 بگداخت چنان، از تف اندیشه تنم کاید پریک پشه، [چو] ده پیرهنم!(@)(@@) (@@) من کم شدم، وکم زکمم می خوانند %~% گر کم زیکم، مگر کم از خویشتنم!(@)(@@) ~~3796 از بس که تنم، رنج فراق تو کشید در پیرهنم، زلاغری نیست پدید(@)(@@) (@@) ای قفل نشاط را، وصال تو کلید %~% وصل تو، تن من است کش نتوان دید!(@)(@@)(@@)(@@) | اح(@)(@@) ~~3793 وصل تو، اگر بدین شتابی نشدی بودی که دلم، بدین خرابی نشدی(@)(@@) (@@) ور باز نکردی به[] م آبی %~% از گریه چنین، روی من آبی نشدی PageV01P572(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0576.jpg)(@)(@)(@@) (@@) 3798 افلاک، به تیر عشق بتوانم سفت %~% و آفاق، به باد سرد بتوانبم رفت 
ms378	(@)(@@) (@@) از عشق چنان شدم، که نتوانم گفت %~% اندر یک چشم پشه، بتوانم خفت(@)(@@)(@@)(@@) | اخی(@)(@@) ~~این طرفه کز این نیل، وزین زر که مراست 3799 آری، منم آنکه نیست از(@)(@@) روی توفرد %~% ثی %~% وز هجر تو دل چونیل و، رخ چون زرزرد %~% نه رنگزری، نه گازری شاید کرد!(@)(@@) (@@) 3800 گر رنجه کنی قدم به پرسیدن من %~% روشن کنی از جمال خود، مسکن من(@)(@@) (@@) مانندهآ پشه ام، که بتوانی دید %~% خر %~% خون دل من، در استخوان تن من!(@)(@@) (@@) امروز، اگر خمیده پشتی بینی 3801 آن بنده که در عشق، جوان یافتیش %~%(@)(@@) رخ سرخ، به سان ارغوان یافتیش %~% رخ زرد، چنان دان که نشان یافتیش!(@)(@@) (@@) گر باد مرا، به چشم موری فکند 3802 آن تار منم، که عنکبوتم بتند %~%(@)(@@) فی %~% بر هم نزند دیده و، دردش نکند! %~% وان ذره منم، که روزگارم بزند(@)(@@) ~~3803 رخسارهآ زرد چون زرم می بینی گفتی که: «ازعشق من نمردی(@)(@@) توهنوز؟)) %~% در هر نفسی، زارترم میبینی %~% آخر، نه بدین کار درم می بیتی؟(@)(@@) (@@) 3804 من برده نیم، جور کسی برده نیم %~% الآ ز تو، از هیچ کس آزرده نیم(@)(@@) (@@) گفتی که: «ز عشق من نمردی تو هنوز!) %~% مشتاب، اگر مرده نیم، مردنی ام!(@)(@@)(@@)(@@) | خ(@)(@@) ~~380 مسکتین دل من، حدیث جان می گویدبا من، غم عشق تونهان می گوید(@)(@@) (@@) گیرم که من از شرم، نگویم غم خویش %~% خود چهره، [غمم] به صد زبان می گوید؟(@)(@)PageV01P573(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0577.jpg)(@)(@)(@@)(@@)(@@) | نمط دوازدهم(@)(@@)(@@)(@@) | در صبر(@)(@@)(@@)(@@) | لاادری(@)(@@) ~~3806 صبرم، چو فراق روی بنمود گریخت آن دیر رسیده بین، که چون زود گریخت!(@)(@@) (@@) زد هجر ستیزه روی، در من آتش %~% تا صبر گریزپای، چون دود گریخت!(@)(@@)(@@)(@@) | شفروه(@)(@@) ~~3807 رایی که نتیجهآ خرد بود، نماند عقلی که محل نیک و بد بود، نماند(@)(@@) (@@) صبری، که ز بهر دفع غوغای غمش %~% بر درگه وصل نامزد بود نماند!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3808 ای دل، به خدا اگر تورا دسترسی است در صبر مپیچ، گرنه بد همنفسی است(@)(@@) (@@) تو صبر ندیدهای، 
ms379	 ندانی او را %~% من صبرشناسم، که چه بی صبرکسی است!(@)(@@) ~~3809 تا جان و دلم، بوی غمت یافته اند در هجر، به صبر موی بشکافتهاند(@)(@@) (@@) تا چند کنم صبر، به اومید بهی %~% نه صبر، به پای چون منی بافته اند!(@)(@@) ~~3810 گر مهر تو، از دلم کم انگاشتمی از سر، هوس وصل توبگذاشتمی(@)(@@) (@@) از درد فراق تو، از این سان که منم %~% صبر است علاج، کاشکی داشتمی!(@)(@@)(@@)(@@) | عوافی(@)(@@) ~~3811 صد حادثه، در زمانه افزون افتادوین حادثه طرفهتر، که اکنون افتاد(@)(@@) ~~دستم، چوعنان رخش آن ماه گرفت پایم، ز رکاب صبر بیرون افتاد!(@)(@@)(@@)(@@) | الغیره(@)(@@) ~~3812 این دل، غم آن روی چوماهت دارد واندیشهآ آن زلف سیاهت دارد(@)(@@) ~~با این دو بلا، عشق به سر نتوان برد در صبر گریز، اگر نگاهت دارد!(@)(@@) (@@) آن به، که در صبر فرا پیش کنم 3813 گر من صفت درد دل خویش کنم %~%(@)(@@) دلهای جهانیان، زغم ریش کنم %~% تا با تورسم، حکایت خویش کنم!(@)(@)PageV01P574(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0578.jpg)(@)(@)(@@)(@@)(@@) | طلحه(@)(@@) (@@) 3814 گر من، ز میان جان برآرم آهی %~% عالم گردد، به سان آتشگاهی(@)(@@) (@@) گویند مرا که: صبر کن یک ماهی %~% چون صبر کنم زعشق ماهی، ماهی!(@)(@@)(@@)(@@) | خر(@)(@@) (@@) 3815 صبرم، چو بدید کان دل از پولاد است %~% گفتا: بروم، که رنج بردن باداست!(@)(@@) (@@) گر صبر سر خویش گرفت، آزاد است %~% کاین صبرنه بندهآ من است، آزاد است!(@)(@@) (@@) 3810 گفتم که: چو هجر جویی، ای حور نژاد %~% از هجر تو، من به صبر بستانم داد(@)(@@) (@@) چون هجر آمد، نیامد از صبرم یاد %~% هجر تو، مرا و صبر را داد به باد!(@)(@@) (@@) 3817 با دل گفتم: نکوشود کار، به صبر %~% فارغ بنشین و، کار بگذار به صبر(@)(@@) (@@) دل گفت: بلی، لیک سخن در عمر است %~% گر عمر بود، نکو شود کار به صبر!(@)(@@) (@@) 3818 شنگرف شد ای نگار، خاک پایم %~% از بس که بر او، خون جگر پالایم(@)(@@) ~~تن بی تو بود، ز ناله چون آسایم؟ 3810 صبر، این دل من چوهر 
ms380	 دلی می(@)(@@) پنداشت از دور، کلاه گوشهآ غم چو بدید %~% نلی %~% دل با تو بود، صبز که(@)(@@) را فرمایم؟ %~% بگریخت، چنانکه کفش و دستار گذاشت! %~% بنشست دراو، گفت: چنین جای که داشت؟(@)(@@) (@@) 382 دلبر، چوز من قوت روان باز افکند %~% تن، صحبت دل بدان جهان باز افکند(@)(@@) (@@) صبر، از پی دل هم شدنی بود، ولیک %~% روزی دو سه، از برای جان باز افکند!(@)(@@)(@@)(@@) | اشهری(@)(@@) ~~382 دیدی، که به عشقت چومرا رای آمدصبرم، به چه نوع پای برجای آمد(@)(@@) (@@) امروز، همان صبر مرا می بینی %~% کز دست غمت، چگونه در پای آمد!(@)(@@)(@@)(@@) | اوله(@)(@@) ~~3822 دردی است، که گر بگویم افزون گردد وز خاموشی، دلم پر از خون گردد(@)(@@) (@@) یارب، تو مرا صبر به ارزانی دار %~% تا من نگرم، که عاقبت چون گردد!(@)(@)PageV01P575(@)(@)(@@) ![image filename](./0650KhalilShirwani.NuzhatMajalis_0579.jpg)(@)(@)(@@) ~~7ک باب چهاردهم - فراق(@)(@@)(@@)(@@) | له(@)(@@) (@@) 3823 ای دل، همه روز در غمت می بینم %~% وی دیده، همیشه درنمت می بینم(@)(@@) (@@) ای صبر، که دی آن همه می گفتی، هان %~% ول %~% امروز کجایی؟ که کمت می بینم!(@)(@@) (@@) 3824 در دل، علم وصل نگون می بینم %~% هر روز، سپاه غم فزون می بینم(@)(@@) (@@) از زخم سنان هجر، بر سینهآ صبر %~% صحرای دل، آغشته به خون می بینم!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 33825 دردا، که دلم به وصل توشاد نماند %~% وز خاک درت، به دست جز باد نماند(@)(@@) (@@) جانی، که تو را عزیز می داشت بکاست %~% صبری، که مرا غرور می داد نمانذ!(@)(@@) (@@) 3826 دل خاص توو، من تن تنها اینجا %~% گوهر به کفت بمانده، دریا اینجا(@)(@@) (@@) در کارتوام، به صبر مفکن کارم %~% کز صبر میان تهی ترم تا اینجا!(@)(@@)(@@)(@@) | صدر(@)(@@) (@@) 3827 دل، دوش ز دیده در مکنون می ریخت %~% تا صبحدمان، از رگ جان خون می ریخت(@)(@@) (@@) دری، که به سالهاش گرد آمده بود %~% دامن دامن، ز دیده بیرون می ریخت!(@)(@@)(@@)(@@) | سید اشرف(@)(@@) (@@) 3828 شکر ایزد را، که آب چشمم خون شد %~% وین انده بی نهایتم، افزون شد(@)(@@) ~~عشق تو در 