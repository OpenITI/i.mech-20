ms2709	 ونقص الكلام وعدم وضوحه (بوشر).(@)(@@) لجلاج: ثقيل اللسان (الكامل 10، 6).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) الدابة: ألبسها اللجام (بوشر، همبرت 52، محيط المحيط).(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) : وكز، رج اللجام بهزة هزا شديدا أو سحبه (الكالا sofrenar = ضرب اللجام).(@)(@@) أ(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) القدر: رفع القدر من النار بعد أن وضع عصا في عروتها تسهل رفعها فيقال آنذاك حملوها بلجامها (معجم الجغرافيا).(@)(@@) أ(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) المكيال: أوفاه م(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) (معجم الجغرافيا).(@)(@@) التجم: التجمت الدابة مطاوع أ(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) (محيط المحيط). (فوك).(@)(@@) التجم عن الكلام: انقطع عنه (ألف ليلة 247:1، 2) وجاء عند (بوشر): انقطع عن الكلام، كأنه أ(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) بلجام.(@)(@@) لجام: عند (فوك وماكني) جمعها أ(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) .(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) : انظرها في أ(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) .(@)(@@) لجام: صانع اللجام وبائعه (فوك).(@)(@@) تلجيمة: رج لزام الفرس هزا شديدا وفجائيا وسحبه.(@)(@@) م(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) : مكيال كان يستخدم للكيل سابقا في البصرة (الكامل 5: 112، انظر فيما تقدم أ(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) المكيال).(@)(@@) م(@)(@)(@@)(@@)(@@) || AUTO لجم(@)(@)(@@) = صاعان ونصف صاع وهو عشرة أمداد (معجم الجغرافيا).(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) : شكل(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) ة (فوك، أبو الوليد 538:5).(@)(@@) ت(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) : مطاوع(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) بالمعنى السابق (فوك).(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) ة وجمعها(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) ات و(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) : خندق حول الحقل المحروث يسهل تصريف مياه الأمطار (الكالا): sangradera de suelo ويقابلها عند (نبريجا) كلمتي elix colliquium, فالأولى أي كلمة elix تعني خندقا كبيرا لصرف مياه التربة. والكلمة الثانية تعني خندقا لتصريف مياه الأمطار.(@)(@@) وفي كتاب اصول العبرية (لأبي الوليد 537، 26 - 27)؛ هو الخط الذي يخطه الحراث حوالي - حول - (المترجم) - المكان الذي يريد حرثه وهو المسمى(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) ة.(@)(@@) وقد وردت هذه الكلمة عند فوك أيضا في (مادة aureola orti) .(@)(@@) إن تأويلها عنده بأنها crusta aree قد حوره الناشر وجعله (ص32) cesta دون موجب إذ ليس هناك أي تصحيف للكلمة؛ أن دوكانج قد فسر كلمة crosta أو crusta بأنها مستنقع صغير أو مجمع صغير لماء راكد مغيض وفسر كلمة crusta aree بناء على ذلك بأنها مستنقع الماء 
ms2710	 الراكد الذي يحيط بالحقل. إن كلمة(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) ة وردت أيضا في (مزامير سعديا 129).(@)(@@) إنني أعتقد أن كلمة elix اللاتينية التي وردت آنفا عند (نبريجا) هي تحريف لكلمة elicis التي وردت عند (كلوميل وبلاين)؛ (فيستوس): (الاليجي (أي ال(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) ة elicis) خندق مائي يجمع الماء من حوله). إنها إذن كلمة elicem التي تلفظ، وفقا للغة الأسبانية elicen التي اشتق منها أو أودت إلى الظهور كلمة(@)(@)(@@)(@@)(@@) || AUTO لجن(@)(@)(@@) ة.(@)(@@) لجين: برتقال (دومب 69، هلو).(@)(@@) لجانة: جرة طينية كبيرة ذات عنق ضيق ومقابض من الطرفين (باين سميث 1351).(@)(@)PageV09P213(@)(@)(@@)(@@)(@@) || CHECK لحس(@)(@)(@@)(@@)(@@) || CHECK لحد(@)(@)(@@)(@@)(@@) || CHECK لحج(@)(@)(@@)(@@)(@@) || CHECK لحب(@)(@)(@@) وأصل الكلمة في اللاتينية لجانة: lagena) .(@)(@)(@@) •(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) :(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) واسم المصدر(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) ح و(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) ة:(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) على: عاث، خرب، أضر، غزا = أ(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) (فوك، فريتاج كرست 7: 44): فلم يزل وناخ عليه بكلكله و(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) عليه الفقر ويؤيد صحة التحريك الموضوع على الكلمة هنا ما ورد في مخطوطتنا 495.(@)(@@) أ(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) : أصر، واصل في، تعمق في، استقر في (ماكني 167:2، 9): أشار إلى الغلام أن ي(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) في سقيه وفي ص (4: 285) من المرجع نفسه ورد البيت الآتي:(@)(@@) أراك ملكت الخافقين مهابة ... بها ما ت(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) الشهب في الخفقان(@)(@@) أ(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) ب: قفى، دائما، ب أو على أثره ب (القلائد 86:7):إ(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) اح الدهر على التمام بالسرار وفي المرجع نفسه (56:6).(@)(@)(@@) وقبل جرت عن بعض كتبي جفوة ... أ(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) ت على وجهي بغمز ا(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) واجب(@)(@@) أ(@)(@)(@@)(@@)(@@) || AUTO لح(@)(@)(@@) على: ضايق، أربك (ابن العوام 354:1): حين زرعنا جفني