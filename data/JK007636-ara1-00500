ms481	 إلى جبل الحلم يا ساريه % % PageV01P2281 31(@)(@@) % و لفظ يقرط أسماعنا % % بما لا رأت مثله ماريه % % 32(@)(@@) % و جود ينقص جود الحيا % % موازين أنعمه الوافيه % % 33(@)(@@) % فخذ من قواعد أكياسه % % ودع لندى حاتم الماشيه % % 34(@)(@@) % له الله من سائر المكرما % % ت وأطواد سؤدده راسيه % % 35(@)(@@) % متيمة بالعلى نفسه % % وعين السهى تحتها ساهيه % % 36(@)(@@) % و حاكمة بين حساده % % وقصاده يده الساميه % % 37(@)(@@) % فهاتيك خائفة بأسها % % وهذي لأنعمها راجيه % % 38(@)(@@) % تظل على العسر أقلامه % % فتأخذه أخذة رابيه % % 39(@)(@@) % سمعنا محاسن قوم ولا % % كمثل محاسنه الباديه % % 40(@)(@@) % من القوم تمحى نجوم السما % % وآثار سؤددهم باقيه % % PageV01P2282 41(@)(@@) % رياض محامدهم غضة % % وسحب عوارفهم هاميه % % 42(@)(@@) % أأزكى الورى أسرة برة % % وأسعدهم همة عاليه % % 43(@)(@@) % إليك بعثت وفود الرجا % % ووجهت همتي القاصيه % % 44(@)(@@) % و أملت برك دون الورى % % زمان يدي عنهم نائيه % % 45(@)(@@) % دعاني سواك لعين النوال % % فقلت على عينك الراقيه % % 46(@)(@@) % و كان المؤيد ثم انقضى % % فأيد مطالبي العانيه % % 47(@)(@@) % و خذها عقيلة مدح على % % بني الشعر رتبتها عاليه % % 48(@)(@@) % بحق الركوب لمن قالها % % على عنق الضد بالغاشيه % % 49(@)(@@) % يتيمة فكر امرئ يرتجي % % كفالة أيامه الماضيه % % PageV01P2283 البحر : - 1(@)(@@) % بدا وقامته تختال بالتيه % % فأي شمس على رمح تحاكيه % % 2(@)(@@) % وقمت أذكره بالظبي ملتفتا % فقال لي طرفه من غير تشبيه % % 3(@)(@@) % أغن يبعد مشتاقا ويرشقه % % باللحظ فهو على الحالين يرميه % % 4(@)(@@) % ماللذي فتنت قلبي محاسنه % % أضحى يعذب روحي وهي تفديه % % 5(@)(@@) % و ما لعاذل قلبي في محبته % % تعبان يدخل فيما ليس يعنيه % % 6(@)(@@) % ألفاظه الريح لكن في الحشا لهب % % وربما كان مر الريح يذكيه % % 7(@)(@@) % و القلب قد أشكر الله الحبيب به % % فما الملام على حال بمخليه % % 8(@)(@@) % لا يختشي بيت قلبي غزو لا ئمه % % فإن للبيت ربا سوف يحميه % % 9(@)(@@) % يا ثاني العطف من تيه ومن غضب % % حتى كأني قلت الغصن ثانيه % % 10(@)(@@) % خفض قلاك وعللني بوعد لقا % % وخل عمري يقضى في تقاضيه % % PageV01P2284 11(@)(@@) % و ابعث خيالا تراني منه في جدل % % فالروح تثبته والجسم ينفيه % % 12(@)(@@) % هيهات طال 
ms482	 سهادي في هواك فلا % % طيف أراه ولا سقم أواريه % % 13(@)(@@) % أحيي الليالي تسهادا فيالفتى % % يميته الليل حزنا وهو يحييه % % 14(@)(@@) % لو كان لليل سلطان كما زعموا % % لكان ينصف جفني من تشكيه % % 15(@)(@@) % سقيا لوصلك والأيام عاطفة % % ترد دمع المعنى من مآقيه % % 16(@)(@@) % و صل تكنف روحي بعد ما جهدت % % كما تكنف دين الله محييه % % 17(@)(@@) % حامي حمى الملك بالأقلام مشرعة % % على المنى والمنايا حول واديه % % 18(@)(@@) % لو ألقيت كعصا موسى على حجر % % تفجر الماء من أقصى نواحيه % % 19(@)(@@) % جاءت بيحيى معاليه مبشرة % % فصدقت يده بشرى معاليه % % 20(@)(@@) % يد بأصل نداها فرع كل ندى % % كالبحر ناقلة عنه سواقيه % % PageV01P2285 21(@)(@@) % سارت وراء خباها السحب وادعة % % لا تأخذ الماء الا من مجاريه % % 22(@)(@@) % يا محسن الظن هذا نحو أنعمه % % بمفرد الفضل قد نادى مناديه % % 23(@)(@@) % يمم مغانيه بالقصد محتكما % إن الغنى اشتق فينا من مغانيه % % 24(@)(@@) % ذاك الذي يستمد النيل أنعمه % % فما الأصابع الا من أياديه % % 25(@)(@@) % حوت كنانة سهما من براعته % % لا تعرف اليمن الا حين تحويه % % 26(@)(@@) % بكف زاكي السجايا ان برى قلما % يكاد ينطق تمجيدا لباريه % % 27(@)(@@) % ذو السؤدد المحض لا طود يجاذبه % % ثوب الوقار ولا نجم يساميه % % 28(@)(@@) % ماضي شبا العزم كم حال به علقت % % تعلق الحال من فعل بماضيه % % 29(@)(@@) % في بيت فضل على الجوزاء مرتفع % % تعنو القصائد عن أدنى مبانيه % % 30(@)(@@) % لم ندر ما فيه من وصف فنحصره % % وصاحب البيت أدرى بالذي فيه % % PageV01P2286 31(@)(@@) % بيت ليحيى من الفاروق متصل % % بخ لماضيه من بيت وباقيه % % 32(@)(@@) % قل للذي نهضت للمجد همته % % ضاهي السماك ويحيى لا يضاهيه % % 33(@)(@@) % ان السيادة قد نضت سوالفها % % لواحد العصر يصبيها وتصبيه % % 34(@)(@@) % مقسم الدين والدنيا على شيم % % قد أتعبت في المعالي من يجاريه % % 35(@)(@@) % أيامه للعلى والمجد قائمة % % وللعفاف وللتقوى لياليه % % 36(@)(@@) % ما زال يعمل آراء وأدعية % % حتى استوى الملك في أعلى صياصيه % % 37(@)(@@) % و استوثق العدل في الدنيا فليس بها % % جان سوى راتع في الروض يجنيه % % 38(@)(@@) % يا من له الفضل باديه 
ms483	 وحاضره % % ومن له القصد دانيه وقاصيه % % 39(@)(@@) % دين الرجا قد تناهت لي مطالبه % % على الزمان ولكن أنت قاضيه % % 40(@)(@@) % أدعوك دعوة شاكي الحال معتقد % % أن ليس غيرك بعد الله يشكيه % % PageV01P2287 41(@)(@@) % ان لم تراع برأي منك مقصده % % يا ابن السراة فقل لي من تراعيه % % 42(@)(@@) % في نظرة منك تأميلي ومفترجي % % ولفظة منك تنويلي وتنو يهي % % 43(@)(@@) % أقول والدمع قد سارت ركائبه % % إلى حماك وقد طافت أمانيه % % 44(@)(@@) % هذا نباتي لفظ يشتكي عطشا % لعل أفقك بالأنواء يسقيه % % 45(@)(@@) % نعم وهذا مقال داثر فعسى % % يا من له قلم الانشاء تنشيه % % PageV01P2288 البحر : - 1(@)(@@) % تبسم عن حلو الرضاب شهيه % % روينا صحيح الحسن عن جوهريه % % 2(@)(@@) % وأقبل وضاح السنا متبسما % فأفصح عن قمريه قمريه % % 3(@)(@@) % وغنى وقد مالت به نشوة الصبا % % نديمي ماس الغصن في سندسيه % % 4(@)(@@) % فلم أر أحلى منه غصنا ترنمت % % على ورق الديباج ورق حليه % % 5(@)(@@) % و بدرا له في العرب والترك نسبة % % دعتني إلى داني الهوى وقصيه % % 6(@)(@@) % يهز علي الرمح من علوية % % قواما ويرمي السهم من فحقيه % % 7(@)(@@) % و يسكر عقلي خده بمدامة % % سقاها لغيثى من إنا عسجديه % % 8(@)(@@) % فيالك من دينار خد قد انتمى % % يحاكيه من حسنى إلى يوسفيه % % 9(@)(@@) % تطلبت بالإخلاص في الحب عدنه % % وتبت يد العذال في لهبيه % % 10(@)(@@) % و اني لتصفو لي المدامة باسمه % % ولائم سمعي فيه مثل صفيه % % PageV01P2289 11(@)(@@) % و صبرني الواشي فيا لمصبر % % قتيل بمسنون اللحاظ مشيه % % 12(@)(@@) % و كيف يلذ الصبر عن ثغر باسم % % جرى الريق بالذكرى على سكريه % % 13(@)(@@) % نأى ولمن لم يألف العشق غادر % % فما عذر عذري الغرام وفيه % % 14(@)(@@) % و إن فاتني ماء الحياة بثغره % % فكم نصب لاقيت من دون ريه % % 15(@)(@@) % و رب مدام بيننا قد أدارها % % بنان مدامي اللماء عليه % % 16(@)(@@) % غزاني بخديه بياض وحمرة % % فويلاه من قيسيه يمنيه % % 17(@)(@@) % و آها على سر الصبا بظلامه % % فلا كان شيب فاضح بنقيه % % 18(@)(@@) % و لا قيدت عن مصر قافية الحيا % % ولا عطلت أبياتها من رويه % % 19(@)(@@) % هويت من الآثار 
ms484	 آثار عمرها % % ومن بيت فضل الله فضل عليه % % 20(@)(@@) % وزير ملوك شد بالرأي إزرهم % % وحاتم دهر كف بأس عديه % % PageV01P2290 21(@)(@@) % و صاحب تدبيرين عن فاضليه % % تحدثت العليا وعن أفضليه % % 22(@)(@@) % بكف روت أقلامه عن تميرها % % وزند روت آراؤه عن وريه % % 23(@)(@@) % و ذو النسب المرفوع عن محبوبه % % إلى عمري المنتمى عدويه % % 24(@)(@@) % و ذو القلم الخطي إما بدرجه % % وإما بما يختال من سمهريه % % 25(@)(@@) % يراع بتأثير الحروف حمى الحمى % % فكان ابتداء النصر من إلفيه % % 26(@)(@@) % سطافي الوغى حدا وأينع في الندى % % فلله جاني فرعه وجنيه % % 27(@)(@@) % و صاغ بديعا حفه بمكارم % % فلم تخل في الحالين من ذهبيه % % 28(@)(@@) % براحة من أولى الورى كل راحة % % بما سار من سر العطا وجليه % % 29(@)(@@) % و يمنى لها في الحظ والجود والتقى % % ملأت صفات لم تحد عن وليه % % 30(@)(@@) % اذ استخدمت مداحها استخدموا لها % % بديع الثنا من محضه عربيه % % PageV01P2291 31(@)(@@) % ترقى ابن فضل الله في الفضل غاية % % قضت ذل شانيه وعز صفيه % % 32(@)(@@) % فيا فوز قوم آمنوا تحت رقه % % ويا ويح من لا آمنوا برقيه % % 33(@)(@@) % هو البحر في تياره وحيائه % % أو السيل في إروائه وأتيه % % 34(@)(@@) % اذا قيل من أسمى جلالا ونسبة % % حلفنا لوصفيه على عمريه % % 35(@)(@@) % اذا سار سار النصر تلو يراعه % % وان حل حل الفضل صدر دنيه % % 36(@)(@@) % اذا حف في نادي السعود بقومه % % فما البدر في بيت السما بكفيه % % 37(@)(@@) % علوتم به يا آل يحيى بشامخ % % إلى أن نظرتم للسها من عليه % % 38(@)(@@) % فإن شئتم ورد الغمام بأفقكم % % أطلتم خيال المستقي لركيه % % 39(@)(@@) % أخا العلم والعلياء علمت منطقي % % غرائب من ساري الكلام سريه % % 40(@)(@@) % بإنشائك المهدي إلى العقل نشوة % % وإن كان من طهر المقال زكيه % % PageV01P2292 41(@)(@@) % و شعر بكرنا قبله متنبئا % وكدنا نقول الآن شعر نبيه % % 42(@)(@@) % بمعجز نظم الدر غير منقب % % وإخراج ما أعيى الورى من جنيه % % 43(@)(@@) % نشرت قريضي بعد ما قد طويته % % وأغديته بعد امتناع طويه % % 44(@)(@@) % و قد كان عافي البيت أنشد رسمه % % هو الربع جارته 
ms485	 دموع وليه % % 45(@)(@@) % إلى أن أعاد العطف لي منك عاتيا % بشعري طلاعا على معنويه % % 46(@)(@@) % يفوح على رغم العدى عنبريه % % ويخبر آراء الرضا عن بريه % % 47(@)(@@) % أتى لك ما محض العلى وسميها % % فخذ من حداقي الثنا عيشميه % % 48(@)(@@) % و عش يا ابن يحيى ذا حياة سعيدة % % وعيش هني المستطاب مريه % % 49(@)(@@) % تقابلك الأعوام ذا في قدومه % % بسعد وذا بالحمد عنه مضيه % % 50(@)(@@) % كأن هلال العام زورق قادم % % عليك بمملوك الثناء مليه % % PageV01P2293 51(@)(@@) % فهنئته ألفا وألفا ومثلها % % إلى أن يتيه العقل في عدديه % % 52(@)(@@) % لكل امرئ والاك حظ سعيده % % وكل امريء عاداك حظ شقيه % % PageV01P2294 البحر : - 1(@)(@@) % جاءت العاذلات شيئا فريا % % وظمئنا إلى لقاك فريا % % 2(@)(@@) % يا قريبا من المحب بعيدا % وعذابا إلى المحب شهيا % % 3(@)(@@) % وغزالا لناظريه فتور % تركا القلب كالزناد وريا % % 4(@)(@@) % غلب الصبر في هوى ناظريه % % وضعيفان يغلبان قويا % 5(@)(@@) % و على وجنتيه نار أراني % % إن تسليت عن هواها شقيا % % 6(@)(@@) % يا خليلي عندها خلياني % % أنا أولى بوجنتيه صليا % % 7(@)(@@) % أنا أدري بأن لي من سناها % % في الجبين طالعا قمريا % % 8(@)(@@) % لا أرى حين حل عقرب صدغ % % سفر القلب في هواها رديا % % 9(@)(@@) % بأبي غصن معطفيه على القر % % ب وفي البعد جانيا وجنيا % % 10(@)(@@) % و يتيم من لؤلؤ الثغر حلو % راح في مثله الرشيد غويا % % PageV01P2295 11(@)(@@) % ذو ابتسام بالسهد أرمد عيني % % مع أني اكتحلته لؤلؤيا % % 12(@)(@@) % تارة في بضائع الحسن يأتي % % جوهريا وتارة سكريا % % 13(@)(@@) % فتنة الحسن فوق خديه لا تب % % رح قيسي رأيه يمنيا % % 14(@)(@@) % أنظم الشعر وهو يبسم عجبا % ولهذا أتى به جوهريا % % 15(@)(@@) % عامريا من التغزل فيه % % ومن المدح بعده قرشيا % % 16(@)(@@) % حبذا من قريش في الشام فرع % % أبطحي أكرم به بهنسيا % % 17(@)(@@) % شمس عليا عمت منافعها الخ % % لق قريبا من الورى وقصيا % % 18(@)(@@) % و كريم زاكي الأصول هززنا % % منه للمكرمات فرعا زكيا % % 19(@)(@@) % فإذا ما دعى رسول رجاء % % فضل أبوابه دعى خزرجيا % % 20(@)(@@) % و اذا ما سقى نداه نباتي % % طاب مدحي في الحالتين رويا % % PageV01P2296 21 
ms486	(@)(@@) % كم سبرنا له تقى ونوالا % فوجدنا في الحالتين وليا % % 22(@)(@@) % كم ثناء وإلى لعلياه مدحا % حسنا في الورى وقدرا عليا % % 23(@)(@@) % و معان يحيى لها فلقد أو % % تي حكم الفخار فيها صبيا % % 24(@)(@@) % تاليا في العلى وزيرا شهدنا % % ه لآمالنا وفيا حفيا % % 25(@)(@@) % قال إحسانه تهنوا نوالا % وزكاة منه وكان تقيا % % 26(@)(@@) % حبذا تلو ذاك شمسا تلونا % % مدح أيامه جليلا جليا % % 27(@)(@@) % خطبته مناصب الدين والدن % % يا كما قد نرى فكان الكفيا % % 28(@)(@@) % عن تفاريق يمنه فاسأل الجا % % نع تسئل لسان صدق عليا % % 29(@)(@@) % ياله في الورى فتى قريشا % عم بالخير جامعا أمويا % 30(@)(@@) % و رئيسا نجا ذوو القصد لما % % قربت منها الملوك نجيا % % PageV01P2297 31(@)(@@) % و رأوا عزمه لدين ودنيا % % شافيا كافيا غنيا مليا % % 32(@)(@@) % سائرات أقلامه يوم حفظ % % وعطاء على الصراط سويا % % 33(@)(@@) % فترى الحق كالصباح رواء % وترى الخير كالغمام رويا % % 34(@)(@@) % و ترى اليراع يجري بجود % % وبيان جواده العربيا % % 35(@)(@@) % صان وجهي عن الورى بأياد % % وأياد غيرن حالي الرزيا % % 36(@)(@@) % فأنا اليوم والزمان بخير % % ها كأن السعيد كان شقيا % % 37(@)(@@) % جنة من دمشق نرتع فيها % % ولنا الرزق بكرة وعشيا % % 38(@)(@@) % يا كريما يخفي أياديه لو كا % % ن شذا المسك والصباح خفيا % % 39(@)(@@) % أصلح الباطن افتقادك والظا % % هر اذ كنت جائعا وعريا % % 40(@)(@@) % فابق ما شئت كيف شئت مرجى % % مستفاض النعمى سنيا سريا % % PageV01P2298 41(@)(@@) % يلتقيك الثنا ويزداد طيبا % مثلما يلتقي الرياض الوليا % % PageV01P2299 البحر : - 1(@)(@@) % نبه الملك عزمك العمر يا % % لمهماته ونام هنيا % % 2(@)(@@) % ودعا وجهك السعيد فما كا % % ن حمى مصر بالدعاء شقيا % % 3(@)(@@) % أنت بين السادات كالذهب الخا % % لص لا غرو أن يرى مصر يا % % 4(@)(@@) % أنت أولى مدبر ومشير % % قربته الملوك منها نجيا % % 5(@)(@@) % أنت ترعى الأمور والله يرعا % % ك فلا زلت راعيا مرعيا % % 6(@)(@@) % حبذا منك للسيادة كفؤ % وافر الفضل والثناء وفيا % % 7(@)(@@) % عرف الملك منه أصلاعريقا % بين أوطانه وفرعا عليا % % 8(@)(@@) % وحوى من علاه كوكب رأي % % طالع السعد بكرة وعشيا % % 9(@)(@@) % ناظرا ساهرا على الملك 
ms487	 يدري % % كيف يهدي له المرام الخفيا % % 10(@)(@@) % ان أردنا التقى لديه أو الجو % % د وجدنا في الحالتين وليا % % PageV01P2300 11(@)(@@) % باهر المطلعين رأيا ومرأى % % حبذا الفضل لامعا ألمعيا % % 12(@)(@@) % حاملا في مواطن السلم والحر % % ب يراعا يردي الزمان الرديا % % 13(@)(@@) % قلما جائلا اذا خط حرفا % حمد الناس رمحه الخطيا % % 14(@)(@@) % يانع الغصن كلما هزه أس % % قط مال البلاد منه جنيا % % 15(@)(@@) % يا رئيسا دعا الزمان له الوف % % د وقال الرجاء حثوا المطيا % % 16(@)(@@) % دام للقاصدين شخصك غوثا % وغماما للواردين رويا % % 17(@)(@@) % قال إحسانه تهنوا نوالا % وزكاة منه وكان تقيا % % PageV01P2301 البحر : - 1(@)(@@) % ما للندى لا يلبي صوت داعيه % % أظن أن ابن شاد قام ناعيه % % 2(@)(@@) % ما للرجاء قد اشتدت مذاهبه % % ما للزمان قد اسودت نواحيه % % 3(@)(@@) % مالي أرى الملك قد فضت مواقفه % % مالي أرى الوفد قد فاضت مآقيه % % 4(@)(@@) % نعى المؤيد ناعيه فيا أسفي % % للغيث كيف غدت عنا غواديه % % 5(@)(@@) % واروعتا لصباح عند رؤيته % % أظن أن صباح الحشر ثانيه % % 6(@)(@@) % واحسرتاه لنظمي في مدائحه % % كيف استحال لنظمي في مراثيه % % 7(@)(@@) % أبكيه بالدر من جفني ومن كلمي % % والبحر أحسن ما بالدر أبكيه % % 8(@)(@@) % أروي بدمعي ثرى ملك له شيم % % قد كان يذكرها الصادي فترويه % % 9(@)(@@) % أذيل ماء جفوني بعده أسفا % لماء وجهي الذي قد كان يحميه % % 10(@)(@@) % جاد من الدمع لا ينفك يطلقه % % من كان يطلق بالإنعام جاديه % % PageV01P2302 11(@)(@@) % و مهجة كلما فاهت بلوعتها % % قالت رزية مولاها لها إيه % % 12(@)(@@) % ليت المؤيد لا زالت عوارفه % % فزاد قلب المعنى في تلظيه % % 13(@)(@@) % ليت الحمام حبا الأيام موهبة % % فكان يفني بني الدنيا ويبقيه % % 14(@)(@@) % ليت الاصاغر تفدى الأكبرون بها % % فكانت الشهب في الآفاق تفديه % % 15(@)(@@) % أعزز علي بأن ألقى عوارفه % % ملىء الزمان واني لا ألاقيه % % 16(@)(@@) % أعزز علي بأن تبلى شمائله % % تحت التراب وماتبلى أياديه % % 17(@)(@@) % أعزز علي بأن ترعى النجوم على % % سرح من الملك قد خلاه راعيه % % 18(@)(@@) % هلا بغير عماد الدين حادثة % % ألقت رداه وأوهت من مبانيه % % 19(@)(@@) % هلا ثنى الدهر غربا عن 
ms488	 محاسنه % % فكان كوكب سعد في لياليه % % 20(@)(@@) % ترى درى الدهر مقدار الذي فقدت % % من فيض أدمعه أحوال أهليه % % PageV01P2303 21(@)(@@) % ترى درى الدهر ما معزى سماحته % % فجاء مهجته في زي عافيه % % 22(@)(@@) % لا أعتب الزمن المودي بسيده % % يكفيه ما قد تولى عنه يكفيه % % 23(@)(@@) % لهفي وهل نافعي لهفي على ملك % % بات الغمام على الآفاق يبكيه % % 24(@)(@@) % لهفي وهل نافعي لهفي على ملك % % كسى الزمان حدادا من دياجيه % % 25(@)(@@) % لهفي على الملك قد أهوت سناجقه % % إلى التراب وقد حطت غواشيه % % 26(@)(@@) % لهفي على الخيل قد وفت صواهلها % % حق العزا فهو يشجيها وتشجيه % % 27(@)(@@) % لهفي على ذلك السلطان حين قضى % % من الحمام عليه حكم قاضيه % % 28(@)(@@) % لهفي عليه لممتار ومطلب % % بالمال يقريه أو بالعلم يقريه % % 29(@)(@@) % لهفي عليه لجود كان يعجبه % % فيه الملام كأن اللوم يغريه % % 30(@)(@@) % ما خلف ابن علي من ذخائره % % إلا ثنا أضحت الدنيا تواليه % % PageV01P2304 31(@)(@@) % لهفي عليه لحلم كان يبسطه % % على العفاة ومدح كان يجنيه % % 32(@)(@@) % كان المديح له عرسا بدولته % % فأحسن الله للشعر العزا فيه % % 33(@)(@@) % كان الفقير اذا أمر الزمان بغى % % عليه قام إلى السلطان ينهيه % % 34(@)(@@) % كان المؤيد في يومي ندى وردى % % غيثا لراجيه أو غوثا للاجيه % % 35(@)(@@) % تروى صحاح القضايا عن براعته % % والنصر في الحرب يروي عن عواليه % % 36(@)(@@) % من للعلوم وللأعلام ينشرها % % و للوغى ورداء الخوف يطويه % % 37(@)(@@) % من للكسير من الأهوال يجبره % % وللطريد من الأيام يؤويه % % 38(@)(@@) % من للتصانيف أمثال الكواكب في % % ليل المداد لساري الفكر يهديه % % 39(@)(@@) % مضى وقد كان عضبا للزمان فيا % % لهفي على مغمد في الترب ماضيه % % 40(@)(@@) % لو أمكن الصبر عنه ما أنست به % % فكيف والحزن من أحشاي ينعيه % % PageV01P2305 41(@)(@@) % آها لأحمر دمع بعد أشهبه % % أجراه حتى لقد أفناه مجريه % % 42(@)(@@) % أفنى المؤيد تبر الدمع من بصري % % وتلك عادته في التبر يفنيه % % 43(@)(@@) % كيف السلو وحولي من صنائعه % % ما يمنع الصخر من أدنى تسليه % % 44(@)(@@) % هذي حماة أغص الهم واديها % % وطاوع الخزن فيه دمع عاصيه % % 45(@)(@@) % كأنه استشعر الأحزان 
ms489	 من قدم % % فللنواعير نوح في نواحيه % % 46(@)(@@) % هذي المنازل والدنيا معطلة % % كأنها اللفظ خال من معانيه % % 47(@)(@@) % جاد الحيا قبره الزاكي فلا برحت % % سحائب العفو والرضوان تسقيه % % 48(@)(@@) % نعم السحائب تسقي صوب وابلها % % نعم الضريح ونعم المرء ثاويه % % 49(@)(@@) % مهنأ بجنان الخلد دانية % % ونحن نصلى بنار من تنائيه % % 50(@)(@@) % من كان يتعب في المعروف راحته % % فهو المهنى بترحيب وترفيه % % PageV01P2306 51(@)(@@) % يا آل أيوب صبرا إن إرثكمو % % من اسم أيوب صبر كان ينجيه % % 52(@)(@@) % هي المنايا على الأقوام دائرة % % كل سيأتيه منها دور ساقيه % % 53(@)(@@) % هي المقادير هذا الأصل تنزعه % % بعد النمو وهذا الفرع تنميه % % 54(@)(@@) % كأنني بسليل المكرمات وقد % % سعى بحق تراث الملك ساعيه % % 55(@)(@@) % محمد وهو اسم عنه مشتهر % % ولي بعه بيت اسماعيل ينشيه % % 56(@)(@@) % يا ناصر الدين أنت الملك قد قرأت % % علائم الملك فيه عين رائيه % % 57(@)(@@) % و من أبيك تعلمت الثبات فما % % تحتاج تذكر أمرا أنت تدريه % % 58(@)(@@) % لا تخش بيتك أن يلوي الزمان به % % فإن للبيت ربا سوف يحميه % % PageV01P2307 البحر : - 1(@)(@@) % لو أن شكوى الاسى يا عز يغنيه % % لكان بث لسان الدمع يكفيه % % 2(@)(@@) % فيا له دمع عين كل غادية % % لا تأخذ الماء الا من مجاريه % % 3(@)(@@) % كأن جود علاء الدين صارله % % رواية فهو يرويها وترويه % % 4(@)(@@) % ذو اللفظ والفضل لوقال البحار طمت % % قالت فواضله من غير تشبيه % % 5(@)(@@) % يامن أطارح منك البيت أسكنه % % آوى اليه كما أرضى وأنشيه % % 6(@)(@@) % ما أحسن البيت من نعماك اسكنه % % بكل بيت من الأمداح يعنيه % % 7(@)(@@) % مثلي ومثلك يدري فضل ذاك وذا % % وصاحب البيت أدرى بالذي فيه % % PageV01P2308 البحر : - 1(@)(@@) % إمام المسلمين تعز عمن % % فقدت وعش تفدى بالبرايا % % 2(@)(@@) % ودم لمدائح وصفا أجور % % لك المرباع منها والصفايا % % 3(@)(@@) % فقيدتك التي صغرت كبير % % قضاء عزائها بين القضايا % % 4(@)(@@) % فيا لك طفلة من بيت علم % % عليها قد تطفلت المنايا % % 5(@)(@@) % ويا لك زهرة من دوح قوم % % سرت بجدودها مسرى البجايا % % 6(@)(@@) % لقد وضع الاسى دمعا عليها % % وقد طلعت شجون من ثنايا % % 7(@)(@@) % ولم 
ms490	 أعرف لها إسما ولكن % % أقول الآن فاطمة الرزايا % % PageV01P2309 البحر : - 1(@)(@@) % أعربت يا مقلتي الغافيه % % عن زورة كافية شافيه % % 2(@)(@@) % طيف كرى ما زال الا غدت % % ما الشرط للأحزان ما النافيه % % 3(@)(@@) % كما نفت وافر خوف الورى % % عافية من سيدي وافيه % % 4(@)(@@) % قاضي قضاة الدين ماشهبه % % خائفة القطع ولاخافيه % % 5(@)(@@) % ذو العلم والجدوى التي شردت % % محلا وجهلا عينها الصافيه % % 6(@)(@@) % ماذا جرى للخلق خوفا على % % مهجته من أدمع طافيه % % 7(@)(@@) % فالآن أحزان الورى قد عفت % % فالحمد لله على العافيه % % PageV01P2310 البحر : - 1(@)(@@) % لست أنسى ابتسامها اللؤلؤيا % % ملبسا خدي الدموع حليا % % 2(@)(@@) % وخدودا حمرية اللون أشكو % % من جفاها وناظرا مستحيا % % 3(@)(@@) % لشذور الأغزال مع مدح تاج الد % % ين اصبحت صائغا جوهريا % % 4(@)(@@) % ان عبد الوهاب قاضي قضاة الد % % ين أوفى الورى ندى أو نديا % % 5(@)(@@) % هبة للعلى من الله ما زا % % ل لدى النسك والعطاء وليا % % 6(@)(@@) % يا إماما تهوي الغمائم من خل % % ف عطاياه سجدا وبكيا % % 7(@)(@@) % ما فقدنا أما خلفت جنايا % % كان للمعتفي وكان تقيا % % PageV01P2311 البحر : - 1(@)(@@) % يا إماما له مقام سني % % وثناء في الخافقين وفي % 2(@)(@@) % مااسم شيء فيه لقوم طعام % % ولكل الورى بخمسيه ري % 3(@)(@@) % وهو مستضعف العيان ولكن % % فيه للسامعين بأس قوي % 4(@)(@@) % لا تقل لي في اللغز بالفتح ريب % % فهو لغز اذا نظرت جلي % 5(@)(@@) % سائل الذكر إن عكست وإن أس % % قطت حرفا كذاك منه السري % PageV01P2312 البحر : - 1(@)(@@) % يا محسنا إن أساء الزمان وإن % % مزق حال الفتى فمر فيه % % 2(@)(@@) % ينشد من ودك الجميل ومن % % مدحك في صدره وفي فيه % % 3(@)(@@) % أرضى لمن غاب عنك غيبته % % فذاك ذنب عقابه فيه % % PageV01P2313 البحر : - 1(@)(@@) % تعشقته غصنا ناضرا % يميل به السكر من ناظريه % % 2(@)(@@) % تحجب دون القنا شخصه % % فصفرة لوني شوقا اليه % % 3(@)(@@) % وكم ذا أدور على خصره % % وما وقعت لي عين عليه % % PageV01P2314 البحر : - 1(@)(@@) % سألت قلبي عن ذوي العشق وعن % % ما أوتيته من فنون الحسن مي % % 2(@)(@@) % فقال لي إني وجدت امرأة % % تملكهم وأوتيت من كل شيء % % PageV01P2315 البحر : - 1 
ms491	(@)(@@) % لقد أدى تلاوته ووفى % % قرآءته لمولانا بني % 2(@)(@@) % صغير وهو إذ يتلو كبير % فما أدري بني أو أبي % % PageV01P2316 البحر : - 1(@)(@@) % عجبت لها مدحة ضاع لي % % شذاها وإن لم يكن في وفي % % 2(@)(@@) % فضاعت ولكن على أوجه % ثلاث لدي ومني وفي % PageV01P2317 البحر : - 1(@)(@@) % ومخدومة أتبعت مدح نبيها % % بخادمة أتبعتها بوليها % % 2(@)(@@) % لعلك يا جاه الشفيع محمد % % توصي بها عطف الوصي عليها % % PageV01P2318 البحر : - 1(@)(@@) % يا وزيرا شمل الآفا % % ق بالنعمى الحفيه % % 2(@)(@@) % قال تنويرك في الجا % % مع للشهب حكيه % % 3(@)(@@) % أنجمي عندك سعد % % وقناديل مضيه % % 4(@)(@@) % كيف لا وهي بنور الل % % ه أعمال زكيه % % PageV01P2319 البحر : - 1(@)(@@) % ليس يخشى من نجم سعد سقوطا % % من رأى قاضي القضاة عليا % % 2(@)(@@) % سار قاضي القضاة للشام غيثا % فله الله ساريا وسريا % % 3(@)(@@) % ان وجدنا وسمي جدواه في الدن % % يا وجدنا في الدين منه وليا % % 4(@)(@@) % قال إحسانه تهنوا نوالا % % وزكاة منه وكان تقيا % % PageV01P2320 البحر : - 1(@)(@@) % يا مليكا يجبر قصاده % % جبرا له الله مكاف عليه % % 2(@)(@@) % شكرا لها في الجود مخفية % % يبسط ضيف الباب فيها يديه % % 3(@)(@@) % اذا أتته وهو في صحبه % % صار مضافا ومضافا اليه % % PageV01P2321 البحر : - 1(@)(@@) % الحمد لله كل وقت % % بقرب مخدومنا هني % 2(@)(@@) % هنى دمشق وساكنيها ال % % غيث والقادم الوفي % 3(@)(@@) % ان جاء وسميها سريعا % فالآن قد جاءها الولي % PageV01P2322 البحر : - 1(@)(@@) % بأيمن طالع مسرى وزير % % نوال يداه للآمال محيا % % 2(@)(@@) % فيا ليت البرامك عاينوه % % وأنعمه تعم الخلق سقيا % % 3(@)(@@) % فينضب جعفر ويعوز فضل % % ويبلى خالد ويموت يحيى % % PageV01P2323 البحر : - 1(@)(@@) % يا سراة الأنصار تاج بينكم % % لرؤوس الأنساب أدنى حلي % 2(@)(@@) % ما أراه إلا أبا نصر وقت % % مالك ناصر لقصدي الجلي % 3(@)(@@) % فهو قاض ومالك وأبو نص % % ر وعبد الوهاب وابن علي % PageV01P2324 البحر : - 1(@)(@@) % تقول المعالي لابن يحيى عليها % % ومن كعلي في معاليه أو يحيى % % 2(@)(@@) % اذا كنت يوما ذا نبات غرسته % % فعاهد ولا تهمل نباتك بالسقيا % % 3(@)(@@) % يفح لك ريحان الثنا من نسيمه % % ويدعو فيرضي زهرة الدين والدنيا % % PageV01P2325 البحر : - 1(@)(@@) % ومليح اذا نظرت اليه % % قلت 
ms492	 أملك له الملاح رعايا % % 2(@)(@@) % فيه للناظر حسن وملح % % فهو يشوي به كبود البرايا % % PageV01P2326 البحر : - 1(@)(@@) % لامني الفتح اذ عزمت على النأ % % ي فقالت ضروراتي إيه % % 2(@)(@@) % أنت دفنت النوى كما زعموا % % فها أنا عن دمشق أنويه % % PageV01P2327 البحر : - 1(@)(@@) % يا علوي الذكر كم نعمة % % الي من بابك مهديه % % 2(@)(@@) % ان لم يكن في الدست حظي فلي % % من جودك الراتب زبديه % % PageV01P2328 البحر : - 1(@)(@@) % فديت فتى يده بالحيا % % وجبهته من حياء نديه % % 2(@)(@@) % يسافر قصدي إلى بابه % % فمنه المكان ومنه الهديه % % PageV01P2329 البحر : - 1(@)(@@) % شكوت صديقا ونافقته % % بشكوى فيا خسر عمري لديه % % 2(@)(@@) % نهاري الجميع دعاء له % % وليلي الجميع دعاء عليه % % PageV01P2330 البحر : - 1(@)(@@) % بأبي فاتر اللواحظ ألمى % % جاء فيه العذول شيبئا فريا % % 2(@)(@@) % غلب الصبر في هوى ناظريه % % وضعيفان يغلبان قويا % % PageV01P2331 البحر : - 1(@)(@@) % يا وزير العليا دعاء محب % % راح للعشر إذ أشرت إليه % % 2(@)(@@) % ما يبالي إذا بكى من هوان % % وافتقار اذا ضحكت عليه % % PageV01P2332 البحر : - 1(@)(@@) % و مبادلين بدمعتين حلاهما % % هذا لهذا قائم بولائه % % 2(@)(@@) % كالبحر تمطره السحاب ومالها % % من عليه لأنها من مائه % % PageV01P2333 البحر : - 1(@)(@@) % شكرا لها يا سيدي من نعمة % % بلغت من التأميل فوق المنتهى % % 2(@)(@@) % لا زال مدحك كل شهر روضة % % يعزى لمصر وكل شيء منتهى % % PageV01P2334 البحر : - 1(@)(@@) % و صلت المدام وذات اللمى % % زمان الصبا والليالي الشهيه % % 2(@)(@@) % فيالك من طيب عيش قطع % % ت بشرب العجوز ورشف الصبيه % % PageV01P2335 البحر : - 1(@)(@@) % أتيت لمصر في كتاب شفاعة % % إلى ولد من والد مورث العليا % % 2(@)(@@) % فيالكتاب جاء من عند ميت % % لحي فقال السعد لبيك يايحيى % % PageV01P2336 البحر : - 1(@)(@@) % و بمهجتي رشأ يميس قوامه % % فكأنه نشوان من شفتيه % % 2(@)(@@) % شغف العذار بخده ورآه قد % % نعست نواظره فدب عليه % PageV01P2337 البحر : - 1(@)(@@) % رأيت فتى من باب دارك طالعا % فأذكرني بيتا قديما شجانيا % % 2(@)(@@) % خليلي لا والله لا نترك البكا % % اذا علم من أرض نجد بدا ليا % % PageV01P2338 البحر : - 1(@)(@@) % بهت العذول وقد رأى ألحاظها % % تركية تدع الحليم سفيها % % 2(@)(@@) % فثنى الملام وقال دونك والاسى % % هذي مضايق لست أدخل 
ms493	 فيها % % PageV01P2339 البحر : - 1(@)(@@) % كم قائل اذ رآني % % أسعى لأندى البريه % % 2(@)(@@) % عطية منه تبغي % % فقلت ألف عطيه % % PageV01P2340 البحر : - 1(@)(@@) % فوض الجامع السعيد لمن يد % % عى له فيه بالضحى والعشي % 2(@)(@@) % لا عجيب ان خصه دون قوم % % أموي يعزى إلى قرشي % % PageV01P2341 البحر : - 1(@)(@@) % للعبد عندكم رسوم مكارم % % إن أقصيت فنداكم يدنيها % % 2(@)(@@) % و كفاكم أن الغيوث اذا همت % % تمحو الرسوم وغيثكم ينسيها % % PageV01P2342 البحر : - 1(@)(@@) % مرآتك العقل كل وقت % % تريك من نفسك الخفايا % % 2(@)(@@) % فلا تحكم هواك فيها % % إن الهوى يصدئ المرايا % % PageV01P2343 البحر : - 1(@)(@@) % يا سيدي عطفا على عصبة % % أفكارهم للقمح محميه % % 2(@)(@@) % قد طبخت بالشوق أكبادهم % % فيا لها طبخة قمحيه % % PageV01P2344 البحر : - 1(@)(@@) % يا رسولي لصبي % % مائس مثل صبيه % % 2(@)(@@) % خذ متى شئت ثيابي % % وارم في حلقي عشيه % % PageV01P2345 البحر : - 1(@)(@@) % علوت اسما ومقدارا ومعنى % % فيا لله من حسن حلي % 2(@)(@@) % كانكم الثلاثة ضرب خيط % % علي في علي في علي % PageV01P2346 البحر : - 1(@)(@@) % يا سيدي دعوة من نفسه % % محصورة في بيدق الحاشيه % % 2(@)(@@) % ينهي إلى همتك المشتكى % % وانما يشكو إلى العاليه % % PageV01P2347 البحر : - 1(@)(@@) % أصبحت من بعد خمولي الذي % % قد كان مسموما ومرئيا % % 2(@)(@@) % أعمل في الأيام ما أشتهي % % لأنني أصبحت بدريا % % PageV01P2348 البحر : - 1(@)(@@) % رأينا تواقيع تاج الزمان % % و فيها من الفضل معنى جلي % 2(@)(@@) % بنسك وجود وحفظ أجاد % % فقلت الثلاثة حظ الولي % PageV01P2349 البحر : - 1(@)(@@) % تهن بعوده عيدا سعيدا % و عش ما شئت يا كهف البرايا % % 2(@)(@@) % نحرت به جميع عداك فانحر % % قرونا آخرين من الضحايا % % PageV01P2350 البحر : - 1(@)(@@) % رب مولى مال عني بعد ما % % كان بالإحسان ميالا الي % 2(@)(@@) % فاضل سلمت في الدهر له % % ليته سلم في الحين علي % PageV01P2351 البحر : - 1(@)(@@) % برغمي أن أهاديكم بمعنى % % دقيق في مقابلة العطايا % % 2(@)(@@) % فيا خجلي ويا عتبي لدهر % % اذا وصل الدقيق إلى الهدايا % % PageV01P2352 البحر : - 1(@)(@@) % بأبي أنت حلوة الريق لكن % % أنا من لسعة الجفا في بليه % % 2(@)(@@) % فيك شهد وفيك لسع فرفقا % بشجي أمسى وأنت خليه % % PageV01P2353 البحر : - 1(@)(@@) % فديتك أيها الرامي بقوس % % ولحظ يا ضنا جسدي عليه % % 2 
ms494	(@)(@@) % لقوسك نحو حاجبك انجذاب % % وشبه الشيء منجذب اليه % % PageV01P2354 البحر : - 1(@)(@@) % أخا الخصر الدقيق فدتك روحي % % نعم وفدت ملاحتك البرايا % % 2(@)(@@) % عسى تهديه لي ضما ومن لي % % بأن يصل الدقيق إلى الهدايا % % PageV01P2355 البحر : - 1(@)(@@) % قالوا وقد زدتني برا وتكرمة % % يا خير من لندى كف أناديه % % 2(@)(@@) % ماذا قبضت نهار العشر قلت لهم % % قبضت ميقات موسى من أياديه % % PageV01P2356 البحر : - 1(@)(@@) % بمقدمك السعيد قد استنارت % % دمشق وبشرت بسنا علي % % 2(@)(@@) % وقد كانت إلى الوسمي تهفو % % فأغناها الولي عن الولي % % PageV01P2357 البحر : - 1(@)(@@) % حيينا فإنا في رضى حبهم متنا % % وصح لقانا بالغيوب فما غبنا % % 2(@)(@@) % وقلنا وقد جاء البشير فبشرنا % % أحبتنا صدوا وقد علموا أنا % % 3(@)(@@) % متى ما بعدنا عن جنابهم عدنا % % 4(@)(@@) % بعدنا عيانا والقلوب على المنى % % منى القلب لا تخلوا لديها من الجنا % % 5(@)(@@) % فيا حبذا الأحباب والبين بيننا % % منعنا جناهم فاغتذينا بأننا % % 6(@)(@@) % مدى الدهر ما لذنا بغير ولا عذنا % % 7(@)(@@) % لهم نعم ملء الأيادي مباحة % لها راحتا جود وللبحرراحة % 8(@)(@@) % و مهما عرتنا من صدود إجاحة % لنا برحاء القرب في البعد راحة % 9(@)(@@) % و قد مسنا ضر فكيف ولو أنا % % 10(@)(@@) % سقى جفني البسام سفح المقطم % % وحام عليها نوء دمع ومهزم % % PageV01P2358 11(@)(@@) % فكم في حماهم من شجي القلب مغرم % % وكم في ذراهم من مشوق متيم % % 12(@)(@@) % يود دنو الحين منه اذا حنا % % 13(@)(@@) % و كم مستهام صادح بحنينه % % دفين الاسى يبكي لأجل دفينه % % 14(@)(@@) % و كم ذي بكى يروي عن ابن معينه % % وكم ذي سقام شعر بأنينه % % 15(@)(@@) % و ما شعروا من ضعفه أنه أنا % % 16(@)(@@) % و كم ثم من أغصان غيد ثنيننا % % إلى العهد لا تلوي من الوعد بيننا % % 17(@)(@@) % و رب ظبا عارضننا ورميننا % % وأعين عين رعننا ورعيننا % % 18(@)(@@) % بما أخذت منا وما صرفت عنا % % 19(@)(@@) % علون وأظهرن الجمال مثابة % % تخال لها عند الشموس قرابة % % 20(@)(@@) % و لم تبق من أرواح قوم صبابة % % تجافيننا حتى فتنا صبابة % % PageV01P2359 21(@)(@@) % و لا طفننا حتى سلمنا وما كدنا % % 22(@)(@@) % يجن سواد الليل 
ms495	 لي بعد قربكم % % ويضحى نهاري باسما عند عتبكم % % 23(@)(@@) % فلله ليل ما أجن لصبكم % % سلوا إن شككتم في جنوني بحبكم % % 24(@)(@@) % نهاري إذا أضحى وليلي إذا جنى % % 25(@)(@@) % نهاري بأخبار الرضا يتبسم % % وليلي إلى روح الرجا يتنسم % % 26(@)(@@) % و جوهر روحي منكم يتقسم % % تبشرني الألطاف بالقرب منكم % % 27(@)(@@) % فصدري ما أفضى وعيشي ما أهنا % % 28(@)(@@) % و ما أحسن الدنيا نعيما ومنسكا % بدولة سلطان محا شكو من شكا % % 29(@)(@@) % بمطلب جود لم يخف منه مهلكا % فسهل للدنيا وللدين مسلكا % % 30(@)(@@) % و أسبل أذيال النجاح فأسبلنا % % PageV01P2360 31(@)(@@) % فيارب أيد دولة الملك الذي % % روى حسن الأوصاف عن عرفها الشذي % % 32(@)(@@) % لقد أخذت في ملكها خير مأخذ % % بسهمي ثناء أو دعاء منفذ % % 33(@)(@@) % ترى الفوز منه قاب قوسين أو أدنى % % 34(@)(@@) % مليك وجدنا بابه الرحب معدنا % % لكسب الثنا والأجر والملك موطنا % % 35(@)(@@) % فجاء الرجا من كل ناحية بنا % % وفاضت بحور الشعر بالمدح والهنا % % 36(@)(@@) % على بابه حتى سبحنا وسبحنا % % 37(@)(@@) % وزدنا به من رائق العيش صفوه % % وجوز من بعد التحرج زهوه % % 38(@)(@@) % و لما رأينا الجد بالجود لهوه % % ركبنا المطايا والسوانح نحوه % % 39(@)(@@) % فيا بحر قد صارت سوابحنا سفنا % % 40(@)(@@) % جرين بنا كالسفن جري السوابح % % إلى باب قصر سافر النجح سافح % % PageV01P2361 41(@)(@@) % سوائر من غاد اليه ورائح % % عمرنا وعمرنا بيوت المدائح % % 42(@)(@@) % فلله حسنى ما عمرنا وعمرنا % % 43(@)(@@) % مليك له في اسم وفعل بنصره % % عوائد من سر الجميل وجهره % % 44(@)(@@) % و لما نصرنا في الحروب بذكره % % قصرنا على كسب الغنى باب قصره % % 45(@)(@@) % فيا حبذا القصر المشيد والمغنى % % 46(@)(@@) % لنا ملك قد كمل الله فضله % % فخوله ملك البسيطة كله % % 47(@)(@@) % بجد وجمع جمع الفضل شمله % % هو البحر إلا أننا سمك له % % 48(@)(@@) % بلقياه نحيى أو بفرقته نفنى % % 49(@)(@@) % مباديه في العلياء غايات من مضى % % من الحائزين الملك يعنو له القضا % % 50(@)(@@) % له صارم عزم وحزم قد انتضى % % فكم حاكم بالعدل في وصفه رضا % % PageV01P2362 51(@)(@@) % و كم معرب يبني وكم شرف يبنى % % 52(@)(@@) % يحق لشعري 
ms496	 أن يطيش نباته % % سرورا بسلطان وفت لي صلاته % % 53(@)(@@) % و مدح تسامت كل يوم رواته % % إلى روض قول باكرت زهراته % % 54(@)(@@) % و أعذره لو طاش والانس والجنا % % 55(@)(@@) % لذكرك يا أوفى الملوك الأكارم % % عفا طلل من ذكر معن وحاتم % % 56(@)(@@) % كأنك عنهم قد ختمت بخاتم % % فحاتم طي ما له بشر باسم % % 57(@)(@@) % و معن فلا لفظ يحس ولا معنى % % 58(@)(@@) % لعمري لو كانوا نجوما ترفعت % % وأحملها ضوء الصباح فأقلعت % % 59(@)(@@) % ممدحة يوم النوال تورعت % % وكانوا بحارا في زمان توزعت % % 60(@)(@@) % ندامى كأنا في أحاديثهم خضنا % % PageV01P2363 61(@)(@@) % إلى أن تجلت طلعة ناصرية % % جلت دولة من ملكها قاهرية % % 62(@)(@@) % ملية أبيات العطا قادرية % % وكان عطا معن القرى نادرية % % 63(@)(@@) % و أنت القرى أعطيت والكنز والمدنا % % 64(@)(@@) % فلا زال للإسلام ملكا وناصرا % وللمال والأعدا مبيدا وقاهرا % 65(@)(@@) % ولازال كل الناس أصبح شاعرا % يقيم لوزني شعره البر وافرا % 66(@)(@@) % و ما كان ذو وفر يقيم له وزنا % % 67(@)(@@) % و حقك لا أنسى ببابك ثروتي % % مرتبة في حال ضعفي وقوتي % % 68(@)(@@) % و لا قلت ما قال ابن جرح لعسرتي % % أذو صنعة فاستخدموني لصنعتي % % 69(@)(@@) % برزقي وإلا فارزقوني مع الزمنى % % PageV01P2364 البحر : - 1(@)(@@) % صرفت فعلي في الأسى وقولي % % بحمد ذي الطول الشديد الحول % % 2(@)(@@) % يالائما ملامه يطول % % إسمع هديت الرشد ما أقول % % 3(@)(@@) % كلامك الفاسد لست أتبع % % حد الكلام ما أفاد المستمع % % 4(@)(@@) % أفدي غزالا مثلوا جماله % % في مثل قد أقبلت الغزاله % % 5(@)(@@) % ما قال مذ ملك قلبي واسترق % كقولهم رب غلام لي أبق % % 6(@)(@@) % للقمرين وجهه مطالع % % فهي ثلاث ما لهن رابع % % 7(@)(@@) % لأحرف الحسن على خديه خط % % وقال قوم انها اللام فقط % % 8(@)(@@) % داني المزار يحذر الضنين % % عليه مثل بان أو يبين % % 9(@)(@@) % كتمته والحسن ليس يجتلى % % والاسم لا يدخله من وإلى % % 10(@)(@@) % منفرد بالحب في دار الهنا % % مثاله الدار وزيد وأنا % % PageV01P2365 11(@)(@@) % لا يختشي ملاعب الظنون % % والأمر مبني على السكون % % 12(@)(@@) % في خده التبري هان نشبي % % وقيمة الفضة دون الذهب % % 13(@)(@@) % فاصرف عليها ثروة 
ms497	 تستام % % فما على صارفها ملام % % 14(@)(@@) % و انفق له دينار من ضن وشح % % ولا تبل أخف وزنا أم رجح % % 15(@)(@@) % و إن رأيت قده العالي فصف % % وقف على المنصوب منه بالألف % % 16(@)(@@) % و العارض النوني ما أنصفته % % وان تكن باللام قد عرفته % % 17(@)(@@) % في مثله انظم ان نظمت محسنا % % وإن ذكرت فاعلا منونا % % 18(@)(@@) % واها لها بحرف نون قد عرف % % كمثل ما تكتبه لا يختلف % % 19(@)(@@) % يأتي بنقط الخال في إعجام % % وتارة يأتي بمعنى اللام % % 20(@)(@@) % دونك ان عشقته بين الورى % % معظما لقدره مكبرا % % PageV01P2366 21(@)(@@) % و ان ترد وجنته المنيره % % فصغر النار على نويره % % 22(@)(@@) % كم ومتى جادلت فيه من عذل % % ولا وحتى ثم أو وأم وبل % % 23(@)(@@) % حتى تولت أوجه العذال % % وأقبل الغلام كالغزال % % 24(@)(@@) % للحظه المسكر فعل يطرب % % مفعوله مثل سقي ويشرب % % 25(@)(@@) % فلا تلم عويشقا فيه تلف % % ولا سكيران الذي لا ينصرف % % 26(@)(@@) % لا تلح قلبي في الهوى فتتعبا % % وما عليك عتبه فتعتبا % % 27(@)(@@) % جسمي وذاك الخصر والجفن الدنف % % هن حروف الاعتدال المكتنف % % 28(@)(@@) % بجفنه نادى الهوى يا للشجي % % وكل ياء بعد مكسور تجي % % 29(@)(@@) % يا جفنه الناصب فيه فكري % % ونصبه وجره بالكسر % % 30(@)(@@) % إن قيل للظبي هنا إلمام % % فاكسر وقل ليقم الغلام % % PageV01P2367 31(@)(@@) % و يا مليحا عنه أخرت القمر % % إما لتهوان وإما لصغر % % 32(@)(@@) % كرر فما أحلى لسمعي السامي % % قولك يا غلام يا غلامي % % 33(@)(@@) % و ارفق بمضناك فما سوى اسمه % % و لا لغير ما بقى من رسمه % % 34(@)(@@) % فقد حكى العداة بالوقوف % % فاعطف على سائلك الضعيف % % 35(@)(@@) % أفقرت في الحسن الغواني مثلما % % قالوا حذامي وقطامي في الدما % % 36(@)(@@) % فافخر بمعنى لحظك المعشوق % % في كل ما تأنيثه حقيقي % % 37(@)(@@) % يالك لحظا بسعاد أزرى % % وجاء في الوزن مثال سكرى % % 38(@)(@@) % حتى اسمه منتقص لمن وعى % % كما يقال في سعاد يا سعا % % 39(@)(@@) % يا واصفا أوصاف ذياك الصبا % % تم الكلام عنده فلينصبا % % 40(@)(@@) % هيهات بل دع عنك ما أضنى وما % % وعاص سباب الهوى لتسلما % % PageV01P2368 41(@)(@@) % و حبر الأمداح 
ms498	 في علي % قاضي القضاة الطاهر التقي % 42(@)(@@) % بكل معنى قد تناها واستوى % % في كلم شتى رواها من روى % % 43(@)(@@) % باكر إلى ذاك الحمى العالي وصف % % اذا درجت قائلا ولم تقف % % 44(@)(@@) % دونك والمدح ذكيا معجبا % نحو لقيت القاضي المهذبا % % 45(@)(@@) % ذو الجود والعلم عليه أرسى % % وهكذا أصبح ثم أمسى % % 46(@)(@@) % فاضرع إلى قار لقاء نافع % % واقرع إلى حامي حماه المانع % % 47(@)(@@) % يقول للضيف نداه حب وهل % % ومثله ادخل وانبسط واشرب وكل % % 48(@)(@@) % إذا ظفرت عنده بموعد % % يقول كم مال أفادته يدي % % 49(@)(@@) % له يراع كم له في خطره % % حماية منظومة مع دره % % 50(@)(@@) % في الجود واليأس وفي العلم وفي % % ذلك منسوب اليه فاعرف % % PageV01P2369 51(@)(@@) % فقولهم أبيض في الهبات % % كقولهم أحمر في الصفات % % 52(@)(@@) % شم حده يوم الندى والبأس % % فإنه ماض بغير لبس % % 53(@)(@@) % لله ما ألينه عند العطا % % وما أجد سيفه حين السطا % % 54(@)(@@) % يهزه ذو الرفع في العلاء % % والجزم في الفعل بلا امتراء % % 55(@)(@@) % حبر له يثني الثناء قصده % % وخلفه وإثره وعنده % % 56(@)(@@) % إن قال قولا بين الغرائبا % % وقام قس في عكاظ خاطبا % % 57(@)(@@) % وان سخا أتى على ذي العدد % والكيل والوزن ومذروع اليد % 58(@)(@@) % معطل السمع من العذال % % فحاله مغير بحال % % 59(@)(@@) % الفضل جنس بيته المهنى % % ونوعه الذي عليه يبنى % % 60(@)(@@) % سام به أهل العلى جميعا % وادفع ولا ردا ولا تفريعا % % PageV01P2370 61(@)(@@) % وإن ذكرت أفق بيت قد نما % % فانصب وقل كم كوكبا يحوي السما % % 62(@)(@@) % بيت نظيم المجد والعلاء % % عند جميع العرب العرباء % % 63(@)(@@) % يقر من يأتي له أو اقترب % % وكل منسوب إلى اسم في العرب % % 64(@)(@@) % تقول مصر في علاه الواجبه % % كقول سكان الحجاز قاطبه % % 65(@)(@@) % أبنية الأنصار طلاع الفنن % % و زاد مبنى حسنه أبو الحسن % % 66(@)(@@) % جار إذا ما امتدت الأيادي % % تقول هذا طلحة الجواد % % 67(@)(@@) % اذا اجتليت في العطا جبينه % % أو استشرت للرجا يمينه % % 68(@)(@@) % تقول قد خلت الهلال لائحا % وقد وجدت المستشار ناصحا % % 69(@)(@@) % كم بالغنى عنه تولى راحل % % وواقف بالباب أضحى السائل % % 70 
ms499	(@)(@@) % فياض سيب في الورى فلم يقل % % في هبة يا هب من هذا الرجل % % PageV01P2371 71(@)(@@) % قال له الشرع امض ما تحاوله % % واقض قضاء لا يرد قائله % % 72(@)(@@) % وأنت يا قاصده سر في جدد % % واسع إلى الخيرات لقيت الرشد % % 73(@)(@@) % إن تكتحل سناه تلقى الرشدا % % وأين ما تذهب تلاق سعدا % % 74(@)(@@) % فافخر به سحب الحيا إن صابا % % واستوت المياه والأخشابا % % 75(@)(@@) % ولا تقل كان غماما ورحل % % كان وما انفك الفتى ولم يزل % % 76(@)(@@) % باب سواه اهجر عداك عيب % وصغر الباب فقل بويب % 77(@)(@@) % هذا الذي يفعل فينا الطولا % % فقدم الفاعل فهو أولى % % 78(@)(@@) % جود به أنسى أحاديث المطر % % فليس يحتاج لها إلى خبر % % 79(@)(@@) % مثل الهبا فيه كلام العذل % % والريح تلقاء الحيا المنهل % % 80(@)(@@) % وبحر شعر خضته لذكره % % وغصت في البحر ابتغاء دره % % PageV01P2372 81(@)(@@) % حنى ملا عيني نداه عينا % % وطبت نفسا إذ قضيت دينا % % 82(@)(@@) % دونكها معسولة الآداب % % ممزوجة بلمحة الاعراب % % 83(@)(@@) % مضى بها الليل مضي الأنجم % % وبات زيد ساهرا لم ينم % % 84(@)(@@) % فافتح لها باب قبول يجتلى % % وان تجد عيبا فسد الخللا % % 85(@)(@@) % لازلت مسموع الثنا ذا منن % جائلة دائرة في الألسن % % 86(@)(@@) % ما لعداك راية تقام % % وليس غير الكسر والسلام % PageV01P2373 البحر : - 1(@)(@@) % أثنى شذا الروض على فضل السحب % % واشتملت بالوشي أرداف الكثب % % 2(@)(@@) % ما بين نور مسفراللثام % % وزهر يضحك في الأكمام % % 3(@)(@@) % إن كانت الأرض لها ذخائر % % فهي لعمري هذه الأزاهر % % 4(@)(@@) % قد بسطتها راحة الغمائم % % بسط الدنانير على الدراهم % % 5(@)(@@) % أحسن بوجه الزمن الوسيم % % تعرف فيه نضرة النعيم % % 6(@)(@@) % وحبذا وادي حماة الرحب % % حيث زهى العيش به والعشب % % 7(@)(@@) % أرض السناء والهناء والمرح % % والأمن واليمن ورايات الفرح % % 8(@)(@@) % ذات النواعير سقاة الترب % وأمهات عصفه والأب % % 9(@)(@@) % تعلمت نوح الحمام الهتف % % أيام كانت ذات فرع أهيف % 10(@)(@@) % فكلها من الحنين قلب % لاسيما والماء فيها صب % % PageV01P2374 11(@)(@@) % لله ذاك السفح والوادي الغرد % % والماء معسول الرضاب مطرد % % 12(@)(@@) % يصبو لها الرآئي ويهفو السامع % % ويحمد العاصي فكيف الطائع % % 13(@)(@@) % إذا نظرت للربا والنهر 
ms500	 % % فارو عن الربيع أو عن جعفر % % 14(@)(@@) % محاسن تلهي العيون والفكر % % ربيع روضات وشحرور صفر % % 15(@)(@@) % أمام كل منزل بستان % % وبين كل قرية ميدان % % 16(@)(@@) % أما رأيت الورق في الأوراق % % جاذبة القلوب بالأطواق % % 17(@)(@@) % فبادر اللذة يا فلان % % واغنم متى أمكنك الزمان % 18(@)(@@) % و لا تقل مشتى ولا مصيف % فكل وقت للهنا شريف % 19(@)(@@) % كل زمان يتقضى بالجذل % % زمان عيش كيفما دار اعتدل % % 20(@)(@@) % أحسن ما أذكر من أوقاته % % وخير ماأبعث من لذاته % % PageV01P2375 21(@)(@@) % بروزنا للصيد فيه والقنص % % وحورنا من مره أحلى الفرص % % 22(@)(@@) % و أخذنا الوحش من المسارب % % وفعلنا في الطير فوق الواجب % % 23(@)(@@) % لما دنا زمان رمي البندق % % سرنا على وجه السرور المشرق % % 24(@)(@@) % في عصبة عادلة في الحكم % % وغلمة مثل بدور التم % 25(@)(@@) % من كل مبعوث إلى الأطيار % % تظله غمامة الغبار % 26(@)(@@) % و كل معسول الشباب أغيد % % منعطف عطف القضيب الأملد % % 27(@)(@@) % قد حمد القوم به عقبى السفر % % عند اقتران القوس منه بالقمر % % 28(@)(@@) % لولا حذار القوس في يديه % % لغنت الورق على عطفيه % % 29(@)(@@) % في كفه محنية الاوصال % % قاطعة الاعمار كالهلال % % 30(@)(@@) % زهراء خضراء الاهاب معجبه % % مما ثوت بين الرياض المعشبه % % PageV01P2376 31(@)(@@) % فاغرة الافواه للاطيار % % طالبة لهن بالأوتار % % 32(@)(@@) % كأنها حول المياه نون % % أو حاجب بما تشا مقرون % % 33(@)(@@) % لها نبات بالمنى مغدوقة % % من طيبة واحدة مخلوقة % % 34(@)(@@) % سامعة لما تشير الأم % % مع أنها مثل الحجار صم % 35(@)(@@) % واها لها من شهب تخطف % % شاهرة بالعزم وهي تقذف % % 36(@)(@@) % كأنها والطير منها هارب % % خلف الشياطين شهاب ثاقب % % 37(@)(@@) % حتى نزلنا بمكان مونق % % اخوان صدق أحدقوا بالملق % % 38(@)(@@) % فياله في الحسن من محل % % مراد جد ومراد هزل % % 39(@)(@@) % للطير في مياهه مواقع % % كأنها من فوقه فواقع % % 40(@)(@@) % فلم نزل في منزل كريم % % نروي حديث الرمي عن قديم % % PageV01P2377 41(@)(@@) % حتى طوى الافق رداء الورس % % والتقم المغرب قرص الشمس % % 42(@)(@@) % و ذر مسك الليل في فرق الافق % % واتشحت خود السماء بالنطق % % 43(@)(@@) % وابتدر القوم إلى المراصد % % من ساهر الليل التمام ساهد 