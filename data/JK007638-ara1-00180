ms161	 شكت قوم عفوه % % 9(@)(@@) % محض الصنيعة لا كجود % سواه مصنوع مموه % % 10(@)(@@) % في كل يوم عنده % % حسنى يسوء بها عدوه % % PageV01P565 11(@)(@@) % شرع كلا وقتيه أحر % % ز في الندى بهما سموه % % 12(@)(@@) % فغدوه كرواحه % ورواحه يحكى غدوه % % PageV01P566 البحر : سريع 1(@)(@@) % باتت تعاطيني حمياها % % بيضاء كالبدر محياها % % 2(@)(@@) % جاءت من الفردوس تهدي لنا % % نفحة كافور بمسراها % % 3(@)(@@) % لو لم تكن من حورها لم يكن % % رحيقها بين ثناياها % % 4(@)(@@) % ذات قوام حبذا بانة % منه نسيم الدل ثناها % % 5(@)(@@) % ووجنة تغنيك في شمها % % عن شمك الورد برياها % % 6(@)(@@) % بت كما شئت بها ناعما % معانقا مرتشفا فاها % % 7(@)(@@) % في روضة تروي صباها الشذا % % عن حسن لا عن خزاماها % % 8(@)(@@) % من لم يدع للفخر من غاية % إلا وقد أحرز أقصاها % % 9(@)(@@) % لم تجر أهل السبق في شأوه % % إلا غدا العجز قصاراها % % 10(@)(@@) % ذو راحة أغزر من ديمة % تحلبها كف نعاماها % % PageV01P567 11(@)(@@) % تنمييه من حي العلى أسرة % أحلى من الشهد سجاياها % % 12(@)(@@) % هم أنجم الأرض بأنوارهم % % أضاء أقصاها وأدناها % % PageV01P568 البحر : مجزوء الكامل 1(@)(@@) % للمجد طلعتك البهية % % شمس تشع على البريه % % 2(@)(@@) % وبنان كفك للندى % % وطفاء ساكبة رويه % % 3(@)(@@) % ولك المناقب في سما % % ء الفخر مزهرة مضيه % % 4(@)(@@) % لا زلت يا بن جلا همو % % م الوفد طلاع الثنيه % % 5(@)(@@) % كالطود حلما أو تهز % ك للثناء الاريحيه % % 6(@)(@@) % أبني الزمان وراءكم % % عن هذه الرتب العليه % % 7(@)(@@) % ودعوا الفخار بأسره % لأغر بسام العشيه % % 8(@)(@@) % خير البرية من تعيش % على عوارفه البريه % % 9(@)(@@) % هذا أبو الهادي الذي % % يعطي ويحتقر العطيه % % 10(@)(@@) % لم يرض بالدنيا وما فيها % % لوافده هديه % % PageV01P569 11(@)(@@) % كرما تبشر وفده % بالنجح بهجته الوضيه % % 12(@)(@@) % حلو الحميا خلقه % مر الحفاظ مع الحميه % % PageV01P570 البحر : رجز تام 1(@)(@@) % ما حلية الدنيا سوى أمجادها % % يزهر في بهائهم نديها % % 2(@)(@@) % واليوم قد زينت ومن محمد % % لا من سواه حسن حليها % % 3(@)(@@) % قد نسج الفخر لها مطارفا % مطرز بصنعه بهيها % % PageV01P571 البحر : بسيط تام 1(@)(@@) % وراءك اليوم عن لهوى وعن طربى % % فإن قلبي أمسى كعبة النوب 
ms162	 % 2(@)(@@) % لا تطمعي في وصالى إن لي كبدا % تهوى وصال العلى لا الخرد العرب % % 3(@)(@@) % أبعد حفظى لأسباب العلى زمنا % أضيعها لك بين اللهو واللعب % % 4(@)(@@) % ما بت مستمطرا من مقلتي جزعا % نوء المدامع بين النؤى والطنب % % 5(@)(@@) % قدح الأسى البرق والرعد الحنين وأن % % فاسي الجنوب ودمعي ديمة % 6(@)(@@) % ولا صبا أبدا قلبي لغانية % إذ ليس في حسنها شغلي ولا أربي % % 7(@)(@@) % في السمر لا السمر معقود هواي ولل % % بيض الظبا ليس للبيض الظبا طربى % % 8(@)(@@) % وما عشقت سوى بكر العلى أبدا % ولست أخطبها إلا بذي شطب % % 9(@)(@@) % وطالما صرف هذا الدهر قلبني % % فلم يكن لسوى العلياء منقلبى % % 10(@)(@@) % ما ضرني بين قوم خفض منزلتي % % ومنزلي فوق هام السبعة الشهب % % PageV01P572 11(@)(@@) % وحسب نفسي وإن أصبحت ذا عدم % من ثروة أنني مثر من الأدب % % 12(@)(@@) % ولست آسى على عمر أطايبه % % أنفقتها في ابتغاء المجد في الكرب % % 13(@)(@@) % يأسى على العمر من باتت تقلبه % في مطرح الذل كف الخوف والرهب % % 14(@)(@@) % لم يسرق الدهر لي فضلا ولا شرفا % وما ادعائي العلى والمجد بالكذب % % 15(@)(@@) % وإنها لمساع لا نظير لها % % ورثتها عن أب من هاشم فأب % % 16(@)(@@) % من معشر عقدوا قدما مآزرهم % % على العفاف وكانوا أنجب العرب % % 17(@)(@@) % والأرض لم تبق منها بقعة أبدا % إلا سقوها برقراق الدم السرب % % PageV01P573 البحر : بسيط تام 1(@)(@@) % حتف الحماة ومقدام السراة له % % في الروع سطوة هجام على النوب % % 2(@)(@@) % محض الضريبة مغوار الكتيبة مح % % مود النقيبة يوم السبق والغلب % % 3(@)(@@) % في كفه مرهف ماضي المضارب في % % يوم القراع تراه ساطع اللهب % % 4(@)(@@) % يمضى ولم يعتلق في شفرتيه دم % من سرعة القطع يوم الروع والرهب % % 5(@)(@@) % في موقف بين أنياب الحمام به الآ % % ساد لم تنج بالإقدام والهرب % % 6(@)(@@) % أعيا المنية حتى أنها سئمت % قبض النفوس به من شدة التعب % % PageV01P574 البحر : منسرح 1(@)(@@) % يا غمرة من لنا بمعبرها % % موارد الموت دون مصدرها % % 2(@)(@@) % يطفح موج البلا الخطير بها % % فيغرق العقل في تصورها % % 3(@)(@@) % وشدة عندما انتهت عظما % شدائد 
ms163	 الدهر مع تكثرها % % 4(@)(@@) % ضاقت ولم يأتها مفرجها % % فجاشت النفس في تحيرها % % 5(@)(@@) % الآن رجس الضلالة استغرق % % الأرض فضجت إلى مطهرها % % 6(@)(@@) % وملة الله غيرت فغدت % % تصرخ لله من مغيرها % % 7(@)(@@) % من مخبري والنفوس عاتبة % ماذا يؤدى لسان مخبرها ؟ % 8(@)(@@) % لم صاحب الأمر عن رعيته % % أغضى فغصت بجور أكفرها ؟ % 9(@)(@@) % ما عذره نصب عينه أخذت % شيعته وهو بين أظهرها % % 10(@)(@@) % يا غيرة الله لا قرار على % % ركوب فحشائها ومنكرها % % PageV01P575 11(@)(@@) % سيفك والضرب إن شيعتكم % % قد بلغ السيف حر منحرها % % 12(@)(@@) % مات الهدى سيدي فقم وأمت % % شمس ضحاها بليل عثيرها % % 13(@)(@@) % واترك منايا العدى بأنفسهم % % تكثر في الروع من تعثرها % % 14(@)(@@) % لم يشف من هذه الصدور سوى % % كسرك صدر القنا بموغرها % % 15(@)(@@) % وهذه الصحف محو سيفك للأ % % عمار منهم أمحى لأسطرها % % 16(@)(@@) % فالنطف اليوم تشتكي وهي في % % الأرحام منها إلى مصورها % % 17(@)(@@) % فالله يا ابن النبي في فئة % ما ذخرت غيركم لمحشرها % % 18(@)(@@) % ماذا لأعدائها تقول إذا % % لم تنجها اليوم من مدمرها % % 19(@)(@@) % أشقة البعد دونك اعترضت % % أم حجبت عنك عين مبصرها ؟ % 20(@)(@@) % فهاك قلب قلوبنا ترها % % تفطرت فيك من تنظرها % % PageV01P576 21(@)(@@) % كم سهرت أعين وليس سوى % % انتظارها غوثكم بمسهرها % % 22(@)(@@) % أين الحفيظ العليم للفئة ال % % مضاعة الحق عند أفجرها % % 23(@)(@@) % تغضى وأنت الأب الرحيم لها % % ما هكذا الظن يا ابن أطهرها % % 24(@)(@@) % إن لم تغشها لجرم أكبرها % % فارحم لها ضعف جرم أصغرها % % 25(@)(@@) % كيف رقاب من الجحيم بكم % % حررها الله في تبصرها % % 26(@)(@@) % ترضى بأن تسترقها عصب % لم تله عن نايها ومزمرها % % 27(@)(@@) % إن ترض يا صاحب الزمان بها % % ودام للقوم فعل منكرها % % 28(@)(@@) % ماتت شعار الإيمان واندفنت % % ما بين خمر العدى وميسرها % % 29(@)(@@) % أبعد بها خطة تراد بها % % لا قرب الله دار مؤثرها % % 30(@)(@@) % الموت خير من الحياة بها % % لو تملك النفس من تخيرها % % PageV01P577 31(@)(@@) % ما غر أعداءنا بربهم % % وهو ملى بقصم أظهرها % % 32(@)(@@) % مهلا فلله في بريته % % عوائد جل قدر أيسرها % % 33(@)(@@) % فدعوة الناس إن تكن حجبت % % لأنها 
ms164	 ساء فعل أكثرها % % 34(@)(@@) % فرب حرى حشى لواحدها % % شكت إلى الله في تضورها % % 35(@)(@@) % توشك أنفاسها وقد صعدت % % أن تحرق القوم في تسعرها % % PageV01P578 البحر : متقارب تام 1(@)(@@) % سنام علائي لم يقرع % وهضبة مجدي لم تطلع % 2(@)(@@) % فقل لرجال سعت جهدها % % لتدرك فوق السهى موضعي % % 3(@)(@@) % ولو أن للشمس أحسابها % % حياء من الخزى لم تطلع % % 4(@)(@@) % قفي حيث أوقفك العجز أو % % فطيري لأم السما أو قعى % % 5(@)(@@) % فلست بجائزة سعى من % % له حوزة الشرف الأرفع % % 6(@)(@@) % فنحن بنو هاشم لا نزال % % لنا الصدر في الجمع والمجمع % % 7(@)(@@) % ومن عزمي البيض مطبوعة % ولولا مضائى لم تقطع % % PageV01P579 البحر : طويل 1(@)(@@) % ألفت قراع الخطب مذ أنا يافع % فكيف تروع اليوم قلبى الروائع % 2(@)(@@) % لقد عركت منى الليالي ابن حرة % على العرك منه لا تلين الأخادع % % 3(@)(@@) % وسيان عندي سلم دهرى وحربه % % وما هو معط لي وما هو مانع % % 4(@)(@@) % لعمري ليضع أيما شاء إنه % % حقير بعيني كل ما هو صانع % % 5(@)(@@) % سأنشد لا عجزا ولكن تحمسا % لي الله أي الحادثات أصانع % % 6(@)(@@) % وأي الأعادي أتقى وهم الحصى % % عديدا وكل مجهر ومصانع % % 7(@)(@@) % فحيث طرحت اللحظ أبصرت منهم % أخا حنق شخصي لأحشاء صادع % % 8(@)(@@) % إذا ما رآني ازور عني طرفه % كأني رمح بين جنبيه شارع % % 9(@)(@@) % وإني ولا فخر ، كفاني تغردي % % تحاشدهم أنى حوتنا المجامع % % 10(@)(@@) % أريهم بأني عن دهاهم مغفل % وعندي لهم خب من العزم رداع % % PageV01P580 11(@)(@@) % كذئب الفضا تلقاه رخوا إذا مشى % % ويشتد إن واثبته وهو قاطع % % 12(@)(@@) % ينام بإحدى مقلتيه ويتقي % % بأخرى العادي فهو يقظان هاجع % % PageV01P581 البحر : مجزوء الكامل 1(@)(@@) % إضرب بسيف أو لسان % وأطعن برمح أو بنان % 2(@)(@@) % يغني اللسان عن المهند % والبنان عن السنان % % 3(@)(@@) % ورم الفخار بهمة % رجحت على الشم الرعان % % 4(@)(@@) % واسبق لغايات المعالي % % مالكا قصب الرهان % % 5(@)(@@) % مت تحت ظل المرهفات % فإن هذا العمر فاني % % 6(@)(@@) % أو عش كريما في حياتك % % هاجرا دار الهوان % % 7(@)(@@) % وإذا رأيت العز أبعد % والهوان إليك داني % % 8(@)(@@) % فالحزم موت باعتزاز % لا 
ms165	 حياة في هوان % % 9(@)(@@) % فالحزم إن سيم المذلة % % صاحب العضب اليماني % % 10(@)(@@) % وإذا نبت فيه المعاهد % حل في كور الهجان % % PageV01P582 البحر : خفيف تام 1(@)(@@) % لا تحنى إذا أخو الشوق حنا % % أنا يا ورق للشجا منك أدنى % % 2(@)(@@) % وعلى مائس الأراك تغنى % % ودعي النوح للكئيب المعنى % % 3(@)(@@) % ليت عهدي بحي نعمان يغدو % % راجعا والمحال ما أتمنى % % 4(@)(@@) % نزلوا بالغضا فأضحت عليه % % أضلعي من ترادف الشوق تحنى % % 5(@)(@@) % لفتاة في ذلك الحي تغدو % % وهي من نشوة الصبا تتثنى % % 6(@)(@@) % عوذت خدرها الفوارس بالبيض % % وسمر الرماح ضربا وطعنا % % 7(@)(@@) % أين منها متيم كلما اشتاق % % إليها هفا غراما وأنا % % 8(@)(@@) % طوحته يد الليالي بهيماء % فأمسى مستوحش الفكر مضنى % % 9(@)(@@) % نازحا عن دياره تترامى % % فيه أيدي المطي سهلا وحزنا % % 10(@)(@@) % قد رثى لي الأنام انس وجن % مذ شجيت الأنام إنسا وجنا % % PageV01P583 11(@)(@@) % طرح الدهر كفة الغدر يصطاد % % بها الماجدين في كل مغنى % % 12(@)(@@) % يبتغي ذلهم ونقص علاهم % % ومحال ما يبتغي الدهر منا % % 13(@)(@@) % نحن أبناء هاشم أربط العا % % لم جأشا وأكثر الناس منا % % 14(@)(@@) % قد قفونا آباءنا الغر بالما % % ل سخاء وبالمكارم ضنا % % PageV01P584 البحر : طويل 1(@)(@@) % فيا نير الدنيا الذي بضيائه % % جلا عن محياها ظلام الغياهب % 2(@)(@@) % عجبت لمن يبغي علاك بسعيه % % وما هو من أبناء هذي المطالب % % 3(@)(@@) % وما هو إلا كالمناسم لو سعت % مدى الدهر لا تسمو سمو الغوارب % % 4(@)(@@) % وأعجب منه من يجاريك في الندى % % وعندك يلفي باسطا كف طالب % % 5(@)(@@) % يهابك إذا تبدو ومرجل ضغنه % % من الغيظ يغلي منه خلف الترائب % % 6(@)(@@) % ويطرق إجلالا بحيث تظنه % % قد انعقدت أهدابه بالحواجب % % 7(@)(@@) % فحسبك فخرا أن فرعك ينتمي % % لعرق على في طينة المجد ضارب % % 8(@)(@@) % ولو بنداك البحر يقرن لم يكن % بجنب نداك البحر نهلة شارب % % PageV01P585 البحر : كامل تام 1(@)(@@) % حدرت بأطراف البنان نقابها % % مرحا فأخجل حسنها أترابها % % 2(@)(@@) % وجلت غداة تبسمت عن واضح % تستعذب العشاق فيه عذابها % % 3(@)(@@) % قتالة اللحظات ، فهي إذا رنت % % وجد المشوق سهامها أهدابها % % 4(@)(@@) % من حور عدن أقبلت 
ms166	 لكنها % % لم يحك مختوم الرحيق رضابها % % 5(@)(@@) % سارقتها النظر المريب بمقلة % لم تقض من لمحاتها آرابها % % 6(@)(@@) % فرأيت في تلك الغلائل طفلة % لم تدر إلا عطرها وخضابها % % 7(@)(@@) % ولقد دعوت وما دعوت مجيبة % ودعت بقلبي للهدى فأجابها % % 8(@)(@@) % أعقيلة الحيين شقت فنولى % % كبدا هوتك فكابدت أوصابها % % 9(@)(@@) % ما دمية المحراب أنت بل التي % % تنسين نساك الورى محرابها % % 10(@)(@@) % وأسر ما ضم الضجيع غريرة % لبست شبابك لا نزعت شبابها % % PageV01P586 11(@)(@@) % يا هل سبتك بلحنها ابنة نشوة % إن تشد رقصت الكؤوس حبابها % % 12(@)(@@) % بعثت حديث عبيرها لك في الصبا % % فأرق أنفاس الصبا وأطابها % % 13(@)(@@) % طربت لوصلك فاصطفت لك دلها % % وأتتك تغرب في الهوى إغرابها % % 14(@)(@@) % وحبتك ما خلف النقاب وإنها % % لمراشف حدر الهلال نقابها % % 15(@)(@@) % حدرته عن قمر يود رقيبه % % لو أنها استغشت عليه ثيابها % % 16(@)(@@) % فارشف أغر كأن ناسق دره % % فيه تناول شهدة فأذابها % % 17(@)(@@) % وانشق معطرة الثرى بمطارف % خطرت تجر على الثرى هدابها % % 18(@)(@@) % نضت الحجاب ولو عليها أسبلت % تلك الفروع إذا أعدن حجابها % % 19(@)(@@) % هتكت أشعة نورها ستر الدجى % % وجلون من تلك الفجاج ضبابها % % 20(@)(@@) % فكأن ليلة وصلها زنجية % حنقت عليك فمزقت جلبابها % % PageV01P587 21(@)(@@) % وكأن أنجمها الثواقب في الدجى % % حدق تراقب في الحجال كعابها % % 22(@)(@@) % تحكى - وقد قلقت - أميمة عندما % % وصفت لعينك قرطها وحقابها % % 23(@)(@@) % لا بل حكت قلقا قلوب معاشر % ضمن النقيب بعزه إرهابها % % 24(@)(@@) % وأرى السهى خفيت خفاء عداته % % لحقارة حتى على من هابها % % 25(@)(@@) % خفت مراسيل الثناء بمثقل % في شكر أنعمه الثقال رقابها % % 26(@)(@@) % لمقلم ظفر الخطوب بنجدة % قلقت لأفواه النوائب نابها % % 27(@)(@@) % ملك إذا استنهضته نهضت به % % همم تدك على السهول هضابها % % 28(@)(@@) % وإذا الحمية ألبسته حفيظة % نزعت لخيفته الضراغم غلبها % % 29(@)(@@) % فإذا المطالب دون قصدك ارتجت % فاقرع بهمته ، وحسبك بابها % % 30(@)(@@) % رضع المكارم ناشئا في حجرها % % وكفى العظائم واطئا أعقابها % % PageV01P588 31(@)(@@) % فوقاء طلعته الكريمة أوجه % جعلت عن الوفد القطوب حجابها % % 32(@)(@@) % وفداء أنمله الندية أنمل % لم تند لو قرض القريض إهابها % % 33(@)(@@) % ما زال 
ms167	 يبتدىء المكارم غضة % حتى على الدنيا أعاد شبابها % % 34(@)(@@) % أبنى الزمان وراءكم عن غاية % ما فيكم من يستطيع طلابها % % 35(@)(@@) % كم تجذبون مطارف الفخر التي % % نسجت لسيد هاشم فاجتابها % % 36(@)(@@) % الله جلبه الرياسة فيكم % أفعنه ينزع غيره جلبابها ؟ % 37(@)(@@) % فدعوا له صدر الوسادة واقعدوا % % قاصين عنها ، لستم أربابها % % 38(@)(@@) % للفاطمي القادري ومن له % % حسب من الأحساب كان لبابها % % 39(@)(@@) % تنميه من علياء هاشم اسرة % وصل الإله بعرشه أنسابها % % 40(@)(@@) % أنت الذي ورث السيادة عن أب % ورث النبوة : وحيها وكتابها % % PageV01P589 41(@)(@@) % أقررت أعين غالب تحت الثرى % % وسررت ثم قصيها وكلابها % % 42(@)(@@) % كانت مقلدة رقاب مضارب % منها تعلمت السيوف ضرابها % % 43(@)(@@) % واليوم لو شهدت لسانك لا نتضت % منه بكل وقيعة قرضابها % % 44(@)(@@) % وأرى النقابة منك لابن سمائها % % ضرب الإله على النجوم قبابها % % 45(@)(@@) % وأحلك الدار التي لجلالها % % عنت الملوك وقبلت أعتابها % % 46(@)(@@) % دار تمنى النيرات لو أنها % % لثمت بأجفان العيون ترابها % % 47(@)(@@) % هي منتدى شرف من الدار التي % % كانت ملائكة السما حجابها % % 48(@)(@@) % حزتم بنى النبأ العظيم مآثرا % حتى الملائك لا تطيق حسابها % % 49(@)(@@) % فيمن تفاخر والورى بأكفكم % % جعل الإله ثوابها وعقابها % % 50(@)(@@) % كنتم على أولى الزمان رؤوسها % % شرقا وكان سواكم أذنابها % % PageV01P590 51(@)(@@) % ولهاشم في كل عصر سيد % يجدونه لصدوعهم رءابها % % 52(@)(@@) % واليوم أنت وحسبهم بك سيدا % لهم تروض من الأمور صعابها % % 53(@)(@@) % فحدت قوافي الشعر باسمك مذلها % % راضت خلائقك الحسان صعابها % % 54(@)(@@) % ولقد رأيتك في المكارم مسهبا % فأطلن عندك في الثنا إسهابها % % 55(@)(@@) % فطرحن في أفناء مجدك ثقلها % % ونضون عن أنضائهن حقابها % % 56(@)(@@) % وأطفن منك بجنب أكرم من رعى % % لبنى أرومة مجده أنسابها % % 57(@)(@@) % يطلبن منك عناية نسمو بها % % حتى نطاول في العلى أربابها % % 58(@)(@@) % فإذا بمن لك تصطفيه خلطتنا % % كنا لدائرة العلى أقطابها % % 59(@)(@@) % ونرى لك الدنيا بعزك أعتبت % من بعدما كنا نمل عتابها % % 60(@)(@@) % يا من له انتهت العلى من هاشم % قد سدت هاشم شيبها وشبابها % % PageV01P591 61(@)(@@) % فاضرب خيامك في الذرى من مجدها % % واعقد بناصية السهى أطنابها % % PageV01P592 البحر : طويل 
ms168	 1(@)(@@) % هل الحب إلا ما أذاب حشا الصب % فإن لم تذب فيه فلا خير في الحب % 2(@)(@@) % وخير خليليك الصفيين من صفا % % لك الود منه في بعادك والقرب % % 3(@)(@@) % على النأى يمسى ذا جفون كأنما % % تكلف أن يحصي بها عدد الشهب % % 4(@)(@@) % ولا خير في ود إمرئ تستديمه % % بعتب ، وأوشك أن يزول مع العتب % % 5(@)(@@) % ألم ترني أصفيت ودي لماجد % كأن على ما نابني قلبه قلبي % % PageV01P593 البحر : طويل 1(@)(@@) % بنورك لا بالنيرات الثواقب % أضاء حمى الزوراء من كل جانب % 2(@)(@@) % طلعت طلوع البدر فيها فلم تدع % % على الأرض فخرا للسما في الكواكب % % 3(@)(@@) % خلعت عليها من بهائك حلة % بها اختالت اليوم اختيال الكواعب % % 4(@)(@@) % وألبستها عقدا من الفخر ناظما % لها الدر فيه وهو در المناقب % % 5(@)(@@) % فما أنت إلا بحر علم تتابعت % عجائبه والبحر جم العجائب % % 6(@)(@@) % وما أنت إلا روض فضل تحدثت % برياه أنفاس لصبا والجنائب % % 7(@)(@@) % وما أنت إلا ديمة مستهلة % بعرف من اللطف الإلهي ساكب % % 8(@)(@@) % أخو همم لو زاحم الدهر بعضها % % ثنته بصغراها حطيم المناكب % % 9(@)(@@) % سما مفرق الجوزاء مجدك عاقدا % ذوائبه منها على في الذوائب % % 10(@)(@@) % وجاراك من قلنا له : أين من جرى % % على الأرض من مجرى النجوم الثواقب % % PageV01P594 11(@)(@@) % أرح غارب الآمال عنك فلم ينل % % مكان الدرارى فوق هذي الغوارب % % 12(@)(@@) % وراءك أبراد لعلياء لم تكن % تمد الثريا نحوها كف جاذب % % 13(@)(@@) % فيا بن المزايا القادرية أعجزت % مزاياك في تعدادها كل حاسب % % 14(@)(@@) % غلبنا بك الصيد الكرام على العلى % % فحقك أن تدعى بسيد غالب % % 15(@)(@@) % يروقك ما قد طرزت لك وشيه % % صناع القوافي لا صناع الكواعب % % 16(@)(@@) % فدمت على هام المجرة ساحبا % مطارف فخر طاهرات المساحب % % PageV01P595 البحر : طويل 1(@)(@@) % لقد قلت للأرض ادعت بنجومها : % عليك السما فخرا فقالت : أجيبها % % 2(@)(@@) % لئن هي بالإشراق منها تزينت % % فما الفخر حيث حل نقيبها % % PageV01P596 البحر : مجزوء الكامل 1(@)(@@) % يا خير من صنع الجميل % لربه متقربا % % 2(@)(@@) % وحنا على أبناء فا % % طمة فكان لهم أبا % % 3(@)(@@) % ورعى حقوق المؤمنين 
ms169	 % ترؤفا وتحدبا % % 4(@)(@@) % قد جئت في زمن القطي % % عة واصلا من أتربا % % 5(@)(@@) % لحظ الإله بك الكرا % % م فكنت منهض من كبا % % 6(@)(@@) % وحفظت ماء وجوههم % % عن أن يراق ويسكبا % % PageV01P597 البحر : مجزوء الكامل 1(@)(@@) % الفخر شاد بكم قبابه % % والشعر زان بكم كعابه % % 2(@)(@@) % والعلم في الدنيا بثا % % قب فكركم أذكى شهابه % % 3(@)(@@) % لكم الكلام وأنتم % % امراء معركة الخطابه % % 4(@)(@@) % من ذا يراجح حلمكم ؟ % والحلم ما زلتم هضابه % % 5(@)(@@) % أم من يطاولكم على % ومن العلى لكم الذؤابه % % 6(@)(@@) % لكم النبوة ، والإما % % مة ، والسيادة ، والنقابة % % 7(@)(@@) % من قال : لي فخر كه % % ذا فليعد لنا انتسابه % % 8(@)(@@) % هذي الرياسة لا كمن % % كانت رياسته ثيابه % % 9(@)(@@) % هتف الرجاء فكنتم % بالفضل أول من أجابه % % 10(@)(@@) % وحميتم ثغر العلى % % وكذاك يحمي الليث غابه % % PageV01P598 11(@)(@@) % أنفت يداكم أن تسا % % جل بالندى حتى السحابه % % 12(@)(@@) % وبجودها حلفت بأن % % تدع الكرام ولا صبابه % % 13(@)(@@) % يا ابن الذين رواق عز % هم يحجب بالمهانة % % 14(@)(@@) % واللابسين رداء فخ % % رهم تطرزه النجابه % % 15(@)(@@) % ماذا أقول ومدحكم % % شحن الإله به كتابه % % PageV01P599 البحر : طويل 1(@)(@@) % لتلق ملوك الأرض طوعا يد الصلح % % حذار حسام صاغه الله للفتح % 2(@)(@@) % وأجرى فرندا فيه من جوهر العلى % % غدا يخطف الأبصار باللمع واللمح % % 3(@)(@@) % فكم شق فجرا من دجى ليل حادث % وأضحك للأيام من أوجه طلح % % 4(@)(@@) % لو الدولة الغراء يوما تفاخرت % مع الشمس قالت أين صبحك من صبحي % % 5(@)(@@) % فتى في صريح المجد ينمي لمعشر % % بيوتهم في المجد سامية الصرح % % 6(@)(@@) % فتى ولدت منه النجابة حازما % بعيد مجال يرفد الملك بالنصح % % 7(@)(@@) % أغر لسيماء العلى في جبينه % % سنى في حشا الحساد يذكي جوى البرح % % 8(@)(@@) % له طلعة غراء دائمة السنا % % هي الشمس لو تمسى هي البدر لو يضحى % % 9(@)(@@) % هو البحر ، بل لا يشبه البحر جوده % % وهل يستوي العذب الفرات مع الملح % % 10(@)(@@) % يزوج آمال العفاة بجوده % % ويقرنه في الحال في مولد النجح % % PageV01P600 11(@)(@@) % ويبسط كفا رطبة من سماحة % إذا قبض اليبس الأكف من الشح % % 12(@)(@@) % أرى المدح 
ms170	 في الأشراف أفضل زينة % ولكنه في فضله شرف المدح % % 13(@)(@@) % هو السيف ، بل لا يفعل السيف فعله % % بقوم على الأضغان مطوية الكشح % % 14(@)(@@) % فقاتل أهل الضغن بالبطش لم يكن % % كقاتل أهل الضغن بالبطش والصفح % % 15(@)(@@) % هو الرمح سل عنه فؤاد حسوده % % بما بات يلقى من شبا ذلك الرمح % % 16(@)(@@) % تجده كليما وهو أعدل شاهد % فيا شاهدا أضحى يعدل بالجرح % % 17(@)(@@) % إليك ابن أم المجد عذراء تجتلى % % كأن محيا وجهها فلق الصبح % % 18(@)(@@) % بها أرج من طيب ذكرك نشره % % يعطر أنفاس الصبا لك بالنفح % % 19(@)(@@) % تود بنات النظم أن لو حكينها % % ويا بعد ما بين الملاحة والقبح % % 20(@)(@@) % لقد فاز فيها قدحك اليوم مثلما % % غدت وهي فيك اليوم فائزة القدح % % PageV01P601 21(@)(@@) % فليس لها كف سواك ولم يكن % % يليق سواها فيك من خرد المدح % % PageV01P602 البحر : كامل تام 1(@)(@@) % لا زلت يا ربع الشباب حميدا % باق وإن خلق الزمان جديدا % % 2(@)(@@) % ما أنت للعشاق إلا جنة % صحبوا بها العيش القديم رغيدا % % 3(@)(@@) % أيام كان العيش غضا ناعما % والدهر مقتبل الشباب وليدا % % 4(@)(@@) % والدار طيبة الثرى مما بها % % يسحبن ربات الخدور برودا % % 5(@)(@@) % يستاف زائرها ثراها عنبرا % فيكذبن طرفا يراه صعيدا % % 6(@)(@@) % يعطو إلى عذبات فرع أراكة % طبي تفيأ ظلها الممدودا % % 7(@)(@@) % غنج يسل من اللواحظ مرهفا % % بغدو عليه قتيله محسودا % % 8(@)(@@) % هو منتضى في الجفن إلا أنه % % بين الجوانح يغتدي مغمودا % % 9(@)(@@) % أضحت ضرائبه القلوب تعد أد % % ماها به ، وهو الشقي ، سعيدا % 10(@)(@@) % وشقيق خديه النقي من الحبا % % أضحى بعقرب صدغه مرصودا % % PageV01P603 11(@)(@@) % يمسى سليما يشتفى بالريق من % % باللثم بات بقطفه معمودا % % 12(@)(@@) % كم بت معتنقا له في ليلة % بات العفاف بها على شهيدا % 13(@)(@@) % وكأنما في الأفق هالة بدرها % % وبها الكواكب قد طلعن سعودا % % 14(@)(@@) % ناد محمد حل فيه وولده % % وبعلاه خفت ناشئا ووليدا % % 15(@)(@@) % هو دارة الشرف التي قد مهدت % أبد الزمان بعزهم تمهيدا % % 16(@)(@@) % فرشوا بساحة أرضه القمرين وات % % كأوا على زهر النجوم قعودا % % 17(@)(@@) % متعاقدين على المكارم أحرزوا % % شرفا 
ms171	 تماثل طارفا وتليدا % % 18(@)(@@) % وعليهم قطبا فقطبا دائر % فلك الفخار ابوة وجدودا % % 19(@)(@@) % كانوا قديما والعلى صدف لهم % % درا تناسق في الفخار نضيدا % % 20(@)(@@) % وأبوهم البحر المحيط وقد بدوا % % منه على جيد الزمان عقودا % % PageV01P604 21(@)(@@) % هو لجة المعروف ما عرفت بنو ال % % دنيا سواه منهلا مورودا % % 22(@)(@@) % وبقية الأمجاد لم ير غيره % % خلفا لهم فوق الثرى موجودا % % 23(@)(@@) % مستظهرا بعناية من ربه % % وقفت عليه العز والتأييدا % % 24(@)(@@) % متمحض لله في أفعاله % % بالغيب يخشى الخالق المعبودا % % 25(@)(@@) % فكأنما الأعضاء منه أعين % تذكى جهنم نصبهن وقودا % % 26(@)(@@) % لم تجترح ذنبا جوارح جسمه % % بل كان عن خطط الذنوب بعيدا % % 27(@)(@@) % فتراه مرتعد الفرائص رهبة % لا باحتمال خطيئة مجهودا % % 28(@)(@@) % يمسى بنفس لا تميل مع الهوى % % لله يحي ليله تهجيدا % % 29(@)(@@) % وإذا تجلى الليل أصبح باسطا % للوفد كفا ما تغب الجودا % % 30(@)(@@) % نسك كما شاء الإله وأنعم % لم يحصها إلا الإله عديدا % % PageV01P605 31(@)(@@) % يا من لو اقتسم الأنام صلاحه % % ما سن فيهم ذو الجلال حدودا % % 32(@)(@@) % لله منجية ولدت بحجرها % % كان التقى في حجرها مولودا % % 33(@)(@@) % لا تغتذى بغذا الجنين نزاهة % لكن غذيت الشكر والتحميدا % % 34(@)(@@) % وبرزت والدنيا جميعا مجهل % علما جلا منها الغواشى السودا % % 35(@)(@@) % وغدت وكانت عاقرا ام الندى % % لما تطرقها نداك ولودا % % 36(@)(@@) % تنميك من سلف المعالي أسرة % غلبوا على الشرف الكرام الصيدا % % 37(@)(@@) % من كل معصوم البصيرة لم يزل % منه الرداء على التقى معقودا % % 38(@)(@@) % لم يرتفع لك بيت مكرمة لهم % % إلا وكان لهأخوك عمودا % % 39(@)(@@) % شهدت صفات ( أبي الأمين ) بأنه % % فضل البرية سيدا ومسودا % % 40(@)(@@) % وأحله حيث استحق من العلى % % حسب على الأحساب نال مزيدا % % PageV01P606 41(@)(@@) % بذل السماح بذا الزمان وإنه % % لأعز من ' بيض الأنوق ' وجودا % % 42(@)(@@) % وعلى حياض سماحه اختلف الورى % % شرقا وغربا مصدرا وورودا % % 43(@)(@@) % يزداد منهل عرفه فيضا إذا % % جفت ضروع الغاديات جمودا % % 44(@)(@@) % ما إن غدا في العرف مبدأ غاية % إلا لها ابن أخيه كان معيدا % % 45(@)(@@) % ليس الحيا الوسمي من جدوى محم % % د الرضا 
ms172	 في المحل أنضر عودا % % 46(@)(@@) % قد جاورت مغناه دجلة فاغتدى % % بندى يديه ماؤها ممدودا % % 47(@)(@@) % والبحر من يمسي ويصبح جاره % % لا بد أن يمتاح منه الجودا % % 48(@)(@@) % جذلان يشرق للسماحة كلما % % دفع الظلام له الركاب وفودا % % 49(@)(@@) % يسترشدون بنور أبلج إن خبا % % ضوء النجوم يزد سناه وقودا % % 50(@)(@@) % بأغر يغلب وجهه شمس الضحى % % بضيائه حتى تموت خمودا % % PageV01P607 51(@)(@@) % ما المجد منتحل لديه وإنما % % ولدته أم المكرمات مجيدا % % 52(@)(@@) % قد حلقت فيه لأرفع رتبة % همم تناهت في العلو صعودا % % 53(@)(@@) % وحوت له النفس الكريمة سؤددا % % أمسى بناصية السهى معقودا % % 54(@)(@@) % فإذا عقود المجد فضل نظمها % % كانت مناقبه لهن فريدا % % 55(@)(@@) % هو شمس أفق المكرمات وبدرها ال % % هادي لمن أمسى يجوب البيدا % % 56(@)(@@) % ورث السماحة من خضم سماحة % فغدا بمجموع الفخار وحيدا % % 57(@)(@@) % ذا الشبل من ذاك الهزبر وإنما % % تلد الأسود الضاريات أسودا % % 58(@)(@@) % يا من تعذر أن يحيط بوصفهم % % نظم ولو ملأ الزمان قصيدا % % 59(@)(@@) % والجامعين المكرمات بوفرهم % % مذ أكثروا في شمله التبديدا % % 60(@)(@@) % ولهم بأندية العلاء إذا بدوا % % تهوي الأعاظم ركعا وسجودا % % PageV01P608 61(@)(@@) % أهدت لجيد علاكم ابنة فكرتي % % درر الثناء قلائدا وعقودا % % 62(@)(@@) % جليت محاسنها عليكم فاجتلوا % % منها لمجدكم كعابا رودا % % 63(@)(@@) % هي نثرة تصفوا على أحسابكم % % زغف خلفت بنسجها داوودا % % 64(@)(@@) % قد خلدت لكم الثناء وسؤلها % % إن الثناء لكم يدوم خلودا % % 65(@)(@@) % فبقيتم في غبطة من ربكم % % لكن بقاء لم يكن محدودا % % PageV01P609 البحر : طويل 1(@)(@@) % لقد رحلت عن ودنا فيه جفوة % وبعد الجفا فيه يراجع بالود % 2(@)(@@) % فنحن على ما كان من عهد حبه % % أقمنا ولم نعزم رحيلا عن العهد % % 3(@)(@@) % وكم ليلة ليلاء فيه سهرتها % % وقد مل طرق النجم فيها من السهد % % 4(@)(@@) % يبيت خليا قلبه من صبابة % ولم يدر من برح الصبابة ما عدي % % 5(@)(@@) % وكنا إذا شطت بنا الدار أو دنت % صفيين لم نكدر على القرب والبعد % % 6(@)(@@) % وإني لتصيبني على النأي والجفا % % إليه سجايا منه أحلى من اشهد % % 7(@)(@@) % خليلي عندي اليوم لو تعلمانه % % عجيب 
ms173	 غرام فاسمعا منه ما أبدي % % 8(@)(@@) % ألم يزعموا أن القلوب لأهلها % % شواهد منهم بالقطيعة والود % % 9(@)(@@) % فما بال قلبي محكما عقدة الهوى % % لمن حل من حبل الهوى محكم العقد ؟ % 10(@)(@@) % وهل أنا وحدي يا خليلي هكذا % % وجدت به أم هكذا كل ذي وجد ؟ % PageV01P610 11(@)(@@) % وبالفرد من أعلام نجد سقى الحيا % % عهود حمى ذيالك العلم الفرد % % 12(@)(@@) % منازل يستوقفن كل أخي هوى % ويحبسن أيدي الواخدات عن الوخد % % 13(@)(@@) % لنا طلعت في غربها الشمس آية % % فقلت لنا البشرى بها ظهر المهدي % % 14(@)(@@) % أتى الخلف ابن المجتبي الحسن الذي % % غدا قائما بالحق يهدي إلى الرشد % % 15(@)(@@) % إمام هدى نور النبوة زاهر % بطلعة بدر وهي كاملة السعد % % 16(@)(@@) % ومن عطفه نشر الإمامة فائح % له أرج يغنيك عن أرج الند % % 17(@)(@@) % به حفظ الباري شريعة جده % % وشيد من أركانها كل منهد % % 18(@)(@@) % فقام بمبيض من الرشد هاديا % إلى الحق في داج من الغي مسود % % 19(@)(@@) % بقية أهل العلم والحلم والحجى % % وأهل التقى والبر والنسك والزهد % % 20(@)(@@) % ولولا احترامي باقر العلم قلت ما % % له من ذوي العلم الأفاضل من ند % PageV01P611 21(@)(@@) % فتى حببته في النفوس شمائل % شذاهن أذكى من شذا الشيح والرند % % 22(@)(@@) % وطبع كطبع الروض رق هواؤه % % بأسرار رياه تذيع صبا نجد % % 23(@)(@@) % وخلق به لو يمزج الماء شارب % لما شك فيه أنه الكوثر الخلدى % % 24(@)(@@) % معيد لما أبدأه في الجود لا كمن % % إذا جاء لا يغدو معيدا لما يبدي % % PageV01P612 البحر : خفيف تام 1(@)(@@) % من محمد رشيد باشا بباني % % استمدت أهل النهى كل رشد % 2(@)(@@) % ملك قد تقلد الأمر والنهى % ببأس على العدو أشد % 3(@)(@@) % مستضاء برأيه كل آن % مستشار في كل حل وعقد % % 4(@)(@@) % بسط العدل رأفة وطوى الجو % % ر جميعا من كل غور ونجد % % 5(@)(@@) % فالورى لابتهالها لعلاه % % تستديم البقاء من غير حد % 6(@)(@@) % ماجد أحرز الوزارة إرثا % عن أب ماجد وعن خير جد % 7(@)(@@) % لا تقسه بغيره في المعالي % % ما قديم الفخار كالمستجد % 8(@)(@@) % قد نضته يد الإمارة سيفا % يخطف العين في 
ms174	 شعاع الفرند % % 9(@)(@@) % وبه أورت النجابة زندا % فخبا من ملوكها كل زند % % 10(@)(@@) % ففداء لها الملوك جميعا % وبحق جميعها لك أفدي % % PageV01P613 11(@)(@@) % إنما أنت قطب دائرة الفخ % % ر وعنوان كل شكر وحمد % % 12(@)(@@) % بك فيحاؤنا اكتست كل فخر % ما اكتست مثله لفخر ببرد % % 13(@)(@@) % سعدت فيك فهي في كل آن % تتباهى بطالع منك سعد % % 14(@)(@@) % يا عيون الفيحاء قري بمولى % فيه يقذى طرف الخصيم الألد % % 15(@)(@@) % وبه فاخري الممالك طرا % واستطيلي بعزة واستبدى % % PageV01P614 البحر : رجز تام 1(@)(@@) % أطلع شمس الراح ليلا أغيد % كأنه من نورها مجسد % 2(@)(@@) % وزفتها تحت الدجى فاشتبهت % % مدامه وخده المورد % % 3(@)(@@) % فلست أدري أجلا لامعة % بكفه بها المدام عسجد % % 4(@)(@@) % أم يده البيضاء في رقتها % % بها شعاع خده يتقد % % 5(@)(@@) % ساق من الجوزاء وهو المشترى % % نطاقه وعقده المنضد % % 6(@)(@@) % شمس الضحى تود لو كان ابنها % % وهي لها بدر السماء ولد % % 7(@)(@@) % إذا أدارت كفه لثامه % % خلت الثريا للهلال تعقد % % 8(@)(@@) % من لي بقطف زهرة من خده % % وعقرب الصدغ عليها رصد % % 9(@)(@@) % مورد الوجنة ما استخجلته % % إلا وما الورد منها بدد % % 10(@)(@@) % مطرد في خده ماء الحيا % % ماء الحيا في خده مطرد % % PageV01P615 11(@)(@@) % علقته نشوان من خمر الصبا % % سبط القوام فرعه مجعد % % 12(@)(@@) % أهيف كم تعطفت قامته % % وهو لألحان الغنا يردد % % 13(@)(@@) % تعطف البانة يثنيها الصبا % % وفوقها قمرية تغرد % 14(@)(@@) % من لي لو فيها فمي يخلد ؟ % لحسنه بدر السماء يسجد % % 15(@)(@@) % وشوقي الكامل ليس حره % % يطفيه إلا ريقه المبرد % % 16(@)(@@) % ما الحسن إلا جمرة بخده % % وجمرة في القلب منى تقد % % 17(@)(@@) % أبرد هاتيك بلثم هذه % % يا من رأى نارا بنار تبرد ؟ % 18(@)(@@) % نار ولكن هي عندي جنة % % 19(@)(@@) % كم ليلة بات بها منادى % % إلى الصباح والوشاة رقد % % 20(@)(@@) % وسنان لم أجذب إلى خصره % % إلا ثنى أعطافه التميد % % PageV01P616 21(@)(@@) % حتى يرى وخصره من رقة % على في انعطافه منعقد % % 22(@)(@@) % أعد على صاحبي ذكر الطلا % % وعد عما يزعم المفند % % 23(@)(@@) % راحك يا ابن النشوات فاغتنم % حظك منها والعذار أسود 
ms175	 % % 24(@)(@@) % وعصر اطرابك في اقتباله % % غرة علياه سوى العز يد % % 25(@)(@@) % وعاقر الراح يحييك بها % % شريكها في اللب إذ يغرد % % 26(@)(@@) % ما ولدت أم الجمال مثله % % وأقسمت بأنها ما تلد % % 27(@)(@@) % ما استجمع اللذات إلا مجلس % على معاطاة الكؤوس يعقد % % 28(@)(@@) % ما هو إلا للندامى فلك % به من الكأس يدور فرقد % % 29(@)(@@) % أو روضة فيها الخدود مجتنى % % من السقاة والشفاه مورد % % 30(@)(@@) % وشادن وفرته ريحانة % % بطيب رياها النسيم يشهد % % PageV01P617 31(@)(@@) % يا طالب العدل هلم ظافرا % فالعدل شخص قد حواه بلد % % 32(@)(@@) % أما ترى الفيحاء كيف أصبحت % % والجور من ورائها مشرد % % 33(@)(@@) % هذا حسام الدين بين أهلها % % أصبح والملك به مقلد % % 34(@)(@@) % جرت ملوك العصر في مضماره % % لغاية إلا عليه تبعد % 35(@)(@@) % فجاء يجري سابقا ما مسحت % % 36(@)(@@) % فقل لمن يطمع في عليائه % % إليكها سيارة مع الصبا % % 37(@)(@@) % فالمجد إرث والندى سجية % والحمد كسب والعلاء مولد % % 38(@)(@@) % تبصر في رواقه محجبا % منه ولا حاجب إلا السؤدد % % 39(@)(@@) % قد خدمت أقلامه بيض الظبا % % تصدرها عن أمره وتورد % % 40(@)(@@) % سيف بكف الملك منه قائم % مقام خديه الطلا والعضد % PageV01P618 41(@)(@@) % منزلتان ليس في كليهما % % ينوب عنه الصارم المجرد % % 42(@)(@@) % وأنت حيث باسمه شاركته % % لا تفتخر يا أيها المهند % % 43(@)(@@) % فهو على هام العداة منتضى % % دأبا وأنت تنتضى وتغمد % % 44(@)(@@) % إن أشعرتك رهبة هيبته % % فمنه في صدر الندي أسد % % 45(@)(@@) % % طرف ولا ينطق فيها مذود % % 46(@)(@@) % مصور في شخصه روح النهى % % عليه أبراد الفخار جدد % % 47(@)(@@) % وغيره يغريك حسن شكله % % ومنه ما في البرد إلا جسد % % 48(@)(@@) % أبلج عنه واليه في الندى % % تروى أحاديث الندى وتسند % % 49(@)(@@) % لهم نداه مشرك في وفره % % ومدحهم حقا له موحد % % 50(@)(@@) % يا خير من زار الثناء ربعه % % فزار أزكى من نماه محتد % % PageV01P619 51(@)(@@) % إليكما سيارة مع الصبا % % تتهم في نشر الثنا وتنجد % % 52(@)(@@) % سحارة الألفاظ بابلية % أم الكلام مثلها لا تلد % % 53(@)(@@) % بل كل معنى جاهلي قد غدا % % يود منها أنه مولد % % 54(@)(@@) % لا تحمد العود على قافية % ما 
ms176	 كل عود في الأمور أحمد % % 55(@)(@@) % أنت فدم سيد أبناء العلى % % ونظمها للشعر فيك سيد % % PageV01P620 البحر : طويل 1(@)(@@) % سبقت الورى مجدا يدوم بلا حد % فكان بلا قبل ويبقى بلا بعد % 2(@)(@@) % خلقت كما شاءت نقيبتك التي % % أتاها الندى كوني فكنت بلا ند % 3(@)(@@) % وجئت إلى الدنيا كما اشتهت العلى % % تعيد من المعروف أضعاف ما تبدي % % 4(@)(@@) % وتبسط أندى من أديم غمامة % % بنانا يعلمن الحيا كيف يستجدي % % 5(@)(@@) % وفي الناس من يغدو به مستميحه % كمستقطر ماء من الحجر الصلد % % 6(@)(@@) % فيا لابسا برد السيادة لا شذا % من الفخر إلا وهو في ذلك البرد % % 7(@)(@@) % فبوركت من فرد حوى الدهر كله % % ببرد علا منه طوى الناس في برد % % 8(@)(@@) % زعيم النهى ما عطرت جيبها الصبا % % بأطيب نشرا من عبيرك والند % 9(@)(@@) % يقولون في الدنيا بنت دارك العلى % % فقلت بل الدنيا بها بنيت عندي % % 10(@)(@@) % كذبنا فذا رضوان بشرك مخبر % يحدث عنها أنها جنة الخلد % % PageV01P621 11(@)(@@) % فمنك المزايا قد تقسمن فردها % % وأعجب شيء قسمة الجوهر الفرد % % 12(@)(@@) % ألست من القوم الذين وليدهم % % يرشح طفلا للعلى وهو في المهد % % 13(@)(@@) % فما حضنوا إلا بحجر نقابة % ولا رضعوا يوما سوى حلم الرشد % % 14(@)(@@) % فيا قمم الأعداء للإرض طأطئ % % ويا عينهم عودي من الجفن في غمد % % 15(@)(@@) % نضا الله في كف النقابة سيفها % % وقال احتكم ما شئت يا فاصل الحد % % 16(@)(@@) % وهاتيك أبصار العدى وقلوبها % % فدونك ما تختاره من ذوي الحقد % % 17(@)(@@) % ومما يعير الأرض فخرا على السما % % ويبهي الحصا فيها على أنجم % % 18(@)(@@) % بيوت بها قد أودع الله منكم % % أطائب ما استصفاه من عترة المجد % % 19(@)(@@) % لكم أذن الله العظيم برفعها % % وأنتم مصابيح بها الناس تستهدي % % 20(@)(@@) % لوجهك قد صلى بها المدح والثنا % % لأنك فيها قبلة الشكر والحمد % % PageV01P622 البحر : كامل تام 1(@)(@@) % نفسي بحبل ولاء أحمد أمسكت % مذ أحكمت بنياط قلبي عقده % % 2(@)(@@) % أنى وفرض مودتي هي فيهم % أجر الرسالة لست أنسى عهده % % 3(@)(@@) % بل لم تزل كبدي تروح وجدها % % بنسيم ذكراه فتلقي برده % % 4 
ms177	(@)(@@) % ماذا أقول على البعاد محررا % من نعت شوق فيه أشكو بعده % % 5(@)(@@) % وجميع أقلامي يكل لسانها % % أنبأء فضل هن أوحى آيها % % 6(@)(@@) % لكن إذا سأل الحبيب فؤاده % % علم الذي عندي بما هو عنده % % 7(@)(@@) % هو ذاك غرة جبهة الحسب الذي % % لفخاره السامي أعد معده % % 8(@)(@@) % من طينة الشرف التي من محضها % % بارى الأنام برى أباه وجده % % 9(@)(@@) % من معدن الكرم الإلهي الذي % % لا خلق إلا وهو يشكو رفده % % 10(@)(@@) % من بيت مختلف الملائكة الذي % % للحق يهدي من تطلب رشده % % PageV01P623 11(@)(@@) % من منبع الحكم الذي يرد النهى % % منه ويصدر وهو يحمد ورده % % 12(@)(@@) % من عترة الوحى الذين سما بهم % % حسب له التنزيل يرفع مجده % % 13(@)(@@) % ممن بعطف علاهم متضوع % أرج الإمامة مهديا لك نده % % 14(@)(@@) % ممن على اولي الزمان نداهم % % غمروا به حر الزمان وعبده % % 15(@)(@@) % في كل عصر منهم ابن نبوة % جمع الإله به المحاسن وحده % % 16(@)(@@) % فرد يسد مسد أرباب النهى % % وجميعها ليست تسد مسده % % 17(@)(@@) % واليوم هذا أحمد في فضله % % فاضرب بذهنك أين تلقى نده ؟ % 18(@)(@@) % جاءت رسالته إلي فقلت ' ما % % كذب الفؤاد بما رأى ) لي وده % % 19(@)(@@) % ونظرت في معراج رحلته التي % % قد نال ( بالإسراء ) فيها قصده % % 20(@)(@@) % إذ سار مقتعدا ( براق ) عزيمة % % قد قربت من كل أفق بعده % % PageV01P624 21(@)(@@) % وأرته من آياته ما لا يرى اب % % ن مفازة لو كان أعمل جهده % % 22(@)(@@) % فأتى يقص محاسن القصص التي % % قد أبطلت هزل الكلام وجده % % 23(@)(@@) % % من غيب أسرار البلاغة عنده % % 24(@)(@@) % أبغي الخطاب له بوصف جامع % لهباته فيه أخاطب مجده % % 25(@)(@@) % وأعود عما ابتغى متحيرا % ماذا أقول : ولست أملك وجده % % 26(@)(@@) % إذ عندي ' القاموس ' بعض هباته % % فمتى سوى القاموس يشمل رفده % % 27(@)(@@) % وله لدى صنيعة من معدن ال % % جود الذي فرض المهيمن حمده % % 28(@)(@@) % بيضاء صافية الحديدة قد حكت % بصفاء جوهرها لعيني وده % % 29(@)(@@) % وكأن رونق ذلك الحسب الذي % % ينهى إليه بها أشاع فرنده % % 30(@)(@@) % مشحوذة كلسانه فكأنه % % فيها مكان الحد ركب حده % % PageV01P625 31(@)(@@) % تروي حديث القطع 
ms178	 عن ذي رونق % فيه النبي أبوه أتحف جده % % 32(@)(@@) % ما قط رأس يراعة فيها فتى % إلا تذكر ذا الفقار وقده % % PageV01P626 البحر : طويل 1(@)(@@) % صباح الهدى من ضوء وجهك مسفر % % ومن نوره ليل التهجد مقمر % 2(@)(@@) % خلقت كما شاء التقى غير منطو % على ريبة فيما تسر وتجهر % % 3(@)(@@) % لك انتهت اليوم الرياسة للهدى % % وإنك قبل اليوم فيها لأجدر % % 4(@)(@@) % ولم أدر حتى زار شخصك ناظري % % بأن التقى في الأرض شخص مصور % % 5(@)(@@) % وأعظم شيء أن كفك لم يقم % بها عرض الدنيا وكلك جوهر % % 6(@)(@@) % يقر بعين الدين أنك نير % به حوزة الإسلام تزهو وتزهر % % 7(@)(@@) % وفرج صدري كون ناديك للتقى % % وأنك للأحكام فيه المصدر % % 8(@)(@@) % فخاصمت فيك البدر يشرق نوره % % وإن عليه حجتي منه أنور % % 9(@)(@@) % فقال : كلانا زاهر في سمائه % % فقلت : نعم لكن محياه أزهر % % 10(@)(@@) % وقالت نجوم الأفق : إني كثيرة % فقلت : مزايا شيخنا منك أكثر % % PageV01P627 11(@)(@@) % وقال النسيم الغض : إني لعاطر % فقلت : شذا أخلاقه منك أعطر % % 12(@)(@@) % ودع راحتيه يا سحاب فمنهما % % يصوب الندى طبعا وأنت مسخر % % 13(@)(@@) % لقد نشأت من رحمة الله فيهما % % سحائب عشر بالعوارف تمطر % % 14(@)(@@) % فيا علماء الأرض شرقا ومغربا % كذا فليكن من للهدى يتخير % % 15(@)(@@) % ويا خير من يرتاده آمل الورى % % فمنظره في روضة منه يحبر % % 16(@)(@@) % إذا قيل فيمن روضة الفضل تزهر % % وأي بحار العلم أروى وأغزر ؟ % 17(@)(@@) % إليك غدت تومي الشريعة لا إلى % % سواك وأثنت وانثنت لك تشكر % % 18(@)(@@) % وإن قيل من للمشكلات يحلها % % ذكرت ولم تعقد بغيرك خنصر % % 19(@)(@@) % حليف التقى ما سار ذكر لذي تقى % بمنقبة إلا وذكرك أسير % % 20(@)(@@) % لقد ضم منك البرد والبرد طاهر % فتى هو من ماء الغمامة أطهر % % PageV01P628 21(@)(@@) % فتى حببته في النفوس خلائق % يكاد بها من وجهه البشر يقطر % 22(@)(@@) % فلو لم أبت فيها من الهم صاحيا % لقلت هي الصهباء من حيث تسكر % % 23(@)(@@) % إليك عروسا كنت أسلفت مهرها % % ولم تجل لولا أنها لك تمهر % % 24(@)(@@) % شكرتك ما أسديته من صنيعة % تقدمت فيها والصنيعة تشكر 
ms179	 % % 25(@)(@@) % عطايا أتت منك ابتداءا حسابها % % إلي وما كانت ببالي تخطر % % 26(@)(@@) % وغير عجيب إن بدا من محمد % بمنزلة تشجى الحواسد حيدر % % 27(@)(@@) % فما عصرنا إلا القيامة شدة % % وما فيه إلا حوض جدواك كوثر % % 28(@)(@@) % رمت عنده الدنيا كبار همومها % % وهمته العلياء منهن أكبر % % 29(@)(@@) % وطاف رجاها في حماه محلقا % عن الناس حيث الكل منهم مقصر % % PageV01P629 البحر : بسيط تام 1(@)(@@) % بنور وجهك لا بالشمس والقمر % أضاء أفق سماء المجد والخطر % 2(@)(@@) % وفي البرية من معروفك انتشرت % رواية الشاهدين السمع والبصر % % 3(@)(@@) % تحدثوا عنك حتى أن كل فم % به عبير شذا من نشرك العطر % % 4(@)(@@) % فذكرك المسك بين الناس يسحق با % % للسان والفم لا بالفهر والحجر % % 5(@)(@@) % وخلقك الروضة الغناء ترهم في % % نطاف بشرك لا في ريق المطر % % 6(@)(@@) % وكفك البحر ما غاض الرجاء به % % إلا وأبرز منه أنفس الدرر % % 7(@)(@@) % ودار عزك تغدو الوفد ناعمة % فيها بأرغد عيش ناعم نضر % % 8(@)(@@) % بها الضيوف تحيى منك أكرم من % % يعطى الرغائب من بدو ومن حضر % % 9(@)(@@) % حيث الجنان على بعد تضئ بها % % للطارقين ضياء الأنجم الزهر % 10(@)(@@) % لقد غدا الأفق العلوي يحسدها % % على مواقدها في سالف العصر % % PageV01P630 11(@)(@@) % وود لو أنها كانت به بدلا % من الكواكب حتى الشمس والقمر % % 12(@)(@@) % فالشهب والبدر يطفي الصبح ضوءهما % % والشمس في الليل لم تشرق ولم تنر % % 13(@)(@@) % لكن دارك لم تبرح مواقدها % % مضيئة تصل الإصباح بالسحر % % 14(@)(@@) % ما زلت ترفع فيها للقرى كرما % نارا شكا الأفق منها لافح الشرر % % 15(@)(@@) % يا مقرض الأرض في عصر به وثقت % % بنو الزمان بكنز البيض والصفر % % 16(@)(@@) % كأنما الله لم يندب سواك إلى % % قرض يضاعفه في محكم السور % % 17(@)(@@) % فلم تكن بشرا بل أنت روح ندى % للعالمين بدت في صورة البشر % % 18(@)(@@) % يفدي يديك ابن حرص لا حياء له % % يلقى العفاة بوجه قد من حجر % % 19(@)(@@) % جرى لعلياك من جهل فقلت له : % لقد جريت ولكن جري منحدر % % 20(@)(@@) % سما بك الحظ إلا عن علاء أبي ال % % مهدي حطك ذل العجز 
ms180	 والخور % % PageV01P631 21(@)(@@) % أنت المعذب بالأموال تجمعها % % خوف البغيضين من فقر ومن عسر % % 22(@)(@@) % وهو المفرق ما يحويه مدخرا % كنز الخطيرين من حمد ومن شكر % % 23(@)(@@) % ما ديمة القطر من صغرى أنامله % % للمحل أقتل في أعوامه الغبر % % 24(@)(@@) % يا ناظرا سير الأمجاد دونك خذ % منه العيان ودع ما جاء في السير % % 25(@)(@@) % تجد به من أبيه كل مأثرة % ما للحيا مثلها في الجود من أثر % % 26(@)(@@) % يريكها هو أو عبد الكريم بلا % % شك وأيهما إن شئت فاختبر % % 27(@)(@@) % لا تطلبن بها من ثالث لهما % % هل ثالث شارك العينين بالنظر % % 28(@)(@@) % تفرعا للعلى من دوحة سقيت % ماء التقى فزكت في أول العصر % % 29(@)(@@) % وقد سما فرعها الأعلى فأثمر ما % % بين النجوم بمثل الأنجم الزهر % % 30(@)(@@) % بكل صافي المحيتا بشره كرم % وكل أخلاقه صفو بلا كدر % % PageV01P632 31(@)(@@) % ما أحدقوا بالرضا إلا وخلتهم % كواكبا تستمد النور من قمر % % 32(@)(@@) % مهذب يتبع النعمى بثانية % دأبا وجود سواه بيضة العقر % 33(@)(@@) % له مناقب مجد كلها غرر % في جبهة الدهر بل أبهى من الغرر % % 34(@)(@@) % زواهر في سماء الفضل دائرة % بمثلها فلك الخضراء لم يدر % % 35(@)(@@) % رأى الثناء لباس الفخر تنسجه % % يد الندى لذوي العلياء والخطر % % 36(@)(@@) % فجاد حتى دعاه البحر حسبك ما % % أبقى سماحك لي فضلا على البشر % % 37(@)(@@) % وكل عنه لسان البرق ثم دعا % % بالرعد أكرمت إني عنك ذو قصر % % 38(@)(@@) % ينمى إلى طيبي الأعراق من عقدوا % % على العفاف قديما طاهر الأزر % % 39(@)(@@) % أعزة نورهم هاد ووجه مسا % % عيهم حسين بليل الحادث النكر % % 40(@)(@@) % الوارثان من المهدي كل على % لأفقها طاهر الأوهام لم يطر % % PageV01P633 41(@)(@@) % والباسطان لدى الجدوى أكفهما % % سحائبا تمطر العافين بالبدر % % 42(@)(@@) % والغالبان على الفخر الكرام معا % بحيث لم يدعا فخرا لمفتخر % % 43(@)(@@) % يا طيب فرع سماح مثمر بهما % % ما كل فرع سماح طيب الثمر % % 44(@)(@@) % لم يطلعا غاية للفخر ليس ترى % % شأوا بها لمجيد غير منحسر % % 45(@)(@@) % إلا وللمصطفى أبصرت ما لهما % % يوم الرهان من الإيراد والصدر % % 46(@)(@@) % أغر ما زهرت للشهب 