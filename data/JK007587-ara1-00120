ms101	 % % PageV01P471 72(@)(@@) % فعدل مزيل كل ظلم وجوده % % وجود مذيل ما تصون الخواتم % % 73(@)(@@) % رميت العدا بالأسد في أجم القنا % % على الجرد ، تقتاد الردى وهو راغم % 74(@)(@@) % بمثل أتي السيل ، ضاق به الفضا % % وضاق على الأعداء منه المخارم % 75(@)(@@) % يبارين شهب القذف يحملن مثلها % % من الحتف ، للباغي الرجيم رواجم % 76(@)(@@) % سرايا كموج البحر ، في ليل عثير % به من عواليهم نجوم نواجم % 77(@)(@@) % تسير جيوش الطير فوق جيوشها % % لها كل يوم من عداها ولائم % % 78(@)(@@) % فإن خفض الفرسان للطعن في الوغى % % رماحهم انقضت عليها القشاعم % 79(@)(@@) % تعرض منها فوق غزة عارض % سحاب المنايا فوقه متراكم % % 80(@)(@@) % فللنقع سحب ، والسيوف بوارق % وللدم وبل والنبات جماجم % % 81(@)(@@) % بوارق منها الغوث لا الغيث يرتجى % % أشائم لا يروى بها الدهر شائم % % PageV01P472 82(@)(@@) % فليس لراج غير عفوك ملجأ % % وليس لعاص لم ينب منك عاصم % % 83(@)(@@) % تنزهت عن أموال من أنت قاتل % % فقد جهلت بين الجيوش المقاسم % 84(@)(@@) % فنهبك أرواح تنفلها الظبا % % وسمر العوالي ، والبلاد مغانم % 85(@)(@@) % فلا مورد إلا يمازجه دم % % ولا مرتع إلا رعته المناسم % % 86(@)(@@) % فسيفك للخصم المعاند خاصم % وعدلك للشكوى وللجور شاكم % 87(@)(@@) % خلطت السطا بالعدل ، حتى تألفت % أسود الشرى والمطفلات الروائم % % 88(@)(@@) % يشن أبو الغارات غارات جوده % % على ماله وهوالمطيع المسالم % % 89(@)(@@) % ويبعثها شعث النواصي كأنها % % ذئاب الفلا تردي عليها الضراغم % % 90(@)(@@) % تلظ بأرض المشركين كأنها % % صواد إلى ورد حوان حوائم % % 91(@)(@@) % فويح العدا من بأسها ، إنما سرى % % إليها ولم تشعر ردى وأداهم % % PageV01P473 92(@)(@@) % فهم جزر للبيض ، والبيض كالدمى % % سبايا تهادى والبلاد معالم % % 93(@)(@@) % غزوتهم في أرضهم وبلادهم % % وجحفلهم في أرضها متزاحم % 94(@)(@@) % فأفنيتهم قتلا وأسرا بأسرهم % % فناجيهم مستسلم أو مسالم % % 95(@)(@@) % فلما أبادتهم سيوفك ، وانجلت % % عن الأرض منهم ظلمة ومظالم % 96(@)(@@) % غروتهم في البحر حتى كأنما ال % % أساطيل فيه موجه المتلاطم % % 97(@)(@@) % بفرسان بحر فوق دهم كأنها % % على الماء طير ما لهن قوادم % % 98(@)(@@) % يصرفها فرسانها بأعنة % جرت حيث لم توصل بهن الشكائم % % 99(@)(@@) % إذا دفعوها قلت : فرسان غارة % % سروا بجياد ما لهن 
ms102	 قوائم % % 100(@)(@@) % دماؤهم في البحر حمر سوائح % % وهامهم في البر سحم جواثم % % 101(@)(@@) % فلم يخف في فج من الأرض هارب % ولم ينج في لج من الماء عائم % % PageV01P474 102(@)(@@) % وعاد الأسارى مردفين وسفنهم % % تقاد ، كما قاد المهاري الخزائم % 103(@)(@@) % وقد شمر الملكان في الله طالبي % % رضاه بعزم لم تعقه اللوائم % % 104(@)(@@) % بجد هو العضب الحسام وحده % % لعادية الأعداء والكفر حاسم % % 105(@)(@@) % وقاما بنصر الدين ، والله قائم % بنصرهما ، ما دام للسيف قائم % 106(@)(@@) % وما دون أن يفنى الفرنج وتفتح ال % % لاد ، سوى أن يمضي العزم في % % 107(@)(@@) % ا ملكا ، قد أحمد الله سعيه % % ونيته ، والله بالسر عالم % 108(@)(@@) % تهن ثناء ، طبق الأرض نشره % % هو المسك لا ما ضمنته اللطائم % % 109(@)(@@) % ثناء به يحدو الحداة وينشد ال % % رواة وتشدو في الغصون الحمائم % % 110(@)(@@) % يسير مع الركبان أنى تيمموا % % على أنه في ساحة الحي هاجم % % 111(@)(@@) % أمير الجيوش ، اسمع مقالة بائح % % بشكرك ، يبدي مثل ما هو كاتم % PageV01P475 112(@)(@@) % بفضلك ا لى صادقا ، إن فكره % % لعاص له في نظم ما هو ناظم % % 113(@)(@@) % كأن بديعي شعره وبيانه % % حروف اعتلال والهموم جوازم % % 114(@)(@@) % على أنه كالصم صبرا وقسوة % تحز المدى في قلبه وهو كاظم % % 115(@)(@@) % فما يعرف الشكوى ولا يستكين لل % % خطوب ، ولا توهى قواه العظائم % 116(@)(@@) % ولو كان سحبانا أجر لسانه % % ألا هكذا في الله تمضي العزائم % % 117(@)(@@) % هي السحر ، لا ما سار عن أرض بابل % هي الدر ، لا ما ألفته النواظم % 118(@)(@@) % فريدة دهر للقلوب تهافت % % عليها ، وللأسماع فيها تزاحم % 119(@)(@@) % إذا أنشدت في محفل قال سامع : % أنفثة سحر ، أم رقى ، وتمائم % 120(@)(@@) % ولولا رجاء الصالح الملك الذي % % بدولته الدهر المقطب باسم % 121(@)(@@) % وأني أمني النفس لثم بنانه % % وما كان قبلي للسحائب لأثم % PageV01P476 122(@)(@@) % ففيها منايا للأعادي قواصم % وفيها بحار للعطايا خضارم % % 123(@)(@@) % وحطي رحال الشكر عني ببابه % % بحيث اعتدا الآمال في المال حاكم % 124(@)(@@) % ويعجب مني الناس حت يقول من % % رآني إلى الجنات قد عاد آدم % % 125(@)(@@) % قضيت لبعدي عن ذراه ندامة % ولا 
ms103	 عجب إن مات بالهم نادم % 126(@)(@@) % أتتك ابنة الفكر الحسير ؛ وإنها % % تسير مسير البدر ، والليل عاتم % 127(@)(@@) % بمدح بديع من ولي ممدح % جدير بأن يغلى به السوم سائم % 128(@)(@@) % تسوم جميل الرأى ، لا المال ، إنه % % بذول له فيما قضته المكارم % 129(@)(@@) % تضمن روضا ، زهره مدح مجدك ال % % علي ، وأوراق الكتاب كمائم % 130(@)(@@) % فدمت ، ودامت هالة ، أنت بدرها % % وملكك ، ما كر الجديدان ، دائم % PageV01P477 البحر : خفيف تام 1(@)(@@) % كم تغص الأيام منى ، وتأبى % % همتي أن تنال مني مناها % % 2(@)(@@) % أنا في كفها كجذوة نار % كلما نكست تعالى سناها % % PageV01P478 البحر : مجتث 1(@)(@@) % لا تجزعن لخطب % % فكل دهرك خطب % % 2(@)(@@) % وحادثات الليالي % % مملة ما تغب % % 3(@)(@@) % تروح سلما وتغدو % % على الفتى ، وهي حرب % 4(@)(@@) % ولا تضق باصطبار % % ذرعا إذا اشتد كرب % % 5(@)(@@) % فصبر يومك مر % % وفي غد هو عذب % % 6(@)(@@) % كم صابر الدهر قوم % % فأدركوا ما أحبوا % % 7(@)(@@) % وكل نار حريق % يخشى لظاها ستخبو % % PageV01P479 البحر : متقارب تام 1(@)(@@) % أيحسب دهرى أنى جز % عت ، لما غال من نشبي وانتهب % 2(@)(@@) % فقد أخلصتني أحداثه % % وبالنار يبدو خلاص الذهب % % 3(@)(@@) % وما حطني أخذه ما است % عاد ، ولا زادني رفعة ما وهب % 4(@)(@@) % وما أنا إلا كضوء الشهاب % % إذا نكسوه اعتلى والتهب % % PageV01P480 البحر : بسيط تام 1(@)(@@) % لأصبرن لدهري صبر محتسب % حتى يرى غير ما قد كان يحسبه % 2(@)(@@) % وأستميت لما تأتي الخطوب به % % ليعلم الخطب أني لست أرهبه % % 3(@)(@@) % إن غالبتني على وفري نوائبه % % فحسن صبري في اللأواء يغلبه % % 4(@)(@@) % أو أبعدتني عن أهلي وعن وطني % % فأبعد الفرج المرجو أقربه % % 5(@)(@@) % والدهر يهدم ما يبني ، ويخمد ما % % يورى ، ويبعد ما يدني تقلبه % % PageV01P481 البحر : خفيف تام 1(@)(@@) % كف عني واش وأغضى رقيب % % ونهاني عن التصابي المشيب % 2(@)(@@) % وأرتني الستون نهجي وقد كا % % ن عفا ، وهو مهيع ملحوب % 3(@)(@@) % وانقضت شرتي ، وشد لي الح % لم حبا ، لا يحلها ما يريب % 4(@)(@@) % وخبرت الأيام حتى لقال الن % ناس : هذه هو الخبير الأريب % % 5(@)(@@) % وعزيز علي أني وقد جر % بت دهري لم 
ms104	 يهدني التجريب % % 6(@)(@@) % وإذا حمت المقادير أخطا ال % % رء في الرأي ، حيث كان يصيب % PageV01P482 البحر : - 1(@)(@@) % لا تنكرن مر العتاب فتحته % % شهد جنته يد الوداد الناصح % 2(@)(@@) % وتطلب المحبوب في مكروهه % % فالدر يطلب في الأجاج المالح % % PageV01P483 البحر : كامل تام 1(@)(@@) % اصبر على ما تختشي أو ترتجي % % تظفر بحسن سكينة ونجاح % 2(@)(@@) % أو ما ترى السارين لما صابروا % % ظلم السرى أفضوا إلى الإصباح % % PageV01P484 البحر : بسيط تام 1(@)(@@) % نزهت نفسي عن من الرجال وإن % % علت بهم رتب الدنيا ، وإن شمخوا % % 2(@)(@@) % إذا المطامع قادتني إلى طمع % يزري فماذا أفاد الشيب والشيخ % % PageV01P485 البحر : كامل تام 1(@)(@@) % سرعن بلادهم فقد سئمت بها % % عيسي محول معرسي ومناخي % % 2(@)(@@) % ودع الأماني إنها غرارة % % ووعودها للطامعين أواخي % % 3(@)(@@) % ما عندها للواردين سرابها % % غير المطال بموعد متراخي % % PageV01P486 البحر : مجزوء الكامل 1(@)(@@) % انظر بعيشك هل ترى % % أحدا يدوم على المودة % % 2(@)(@@) % لترى أخلاء الرخا % % ء عدا ، إذا نابتك شدة % 3(@)(@@) % ولكل ما تأبى وتهوى % % وى إن صبرت مدى ومدة % % PageV01P487 البحر : سريع 1(@)(@@) % عندي للأيام إن أقبلت % % علي فعل الخير والجود % 2(@)(@@) % وإن تولت ففؤادي كما % % علمت ، في اللأواء ، جلمود % 3(@)(@@) % يصابر الأيام ، أو تنقضي % % خطوبهن البيض والسود % PageV01P488 البحر : طويل 1(@)(@@) % تيقظ فمن يشناك يسهر ليله % % وقد يخدع اليقظان من هو راقد % % 2(@)(@@) % ولا تحتقر كيد الضعيف فإنما % % تقد شفار المرهفات المبارد % 3(@)(@@) % وتلقى الأسود بالخديعة في الزبى % % ولو جوهرت لم ينج منهن صائد % % 4(@)(@@) % وإهمال ما يخشى من الأمر مهلك % ومصرع رضوان بما قلت شاهد % % PageV01P489 البحر : طويل 1(@)(@@) % سأنفق وفرى في اكتساب مكارم % % أظل بها بعد الممات مخلدا % % 2(@)(@@) % وأسعى إلى الهيجاء ، لا أرهب الردى % % ولا أتخشى عاملا ومهندا % % 3(@)(@@) % بكل فتى يلقى المنية ضاحكا % كأن له في القتل عيشا مجددا % % 4(@)(@@) % فإن نلت ما أرجو فللجود ثم لي % % وإن مت خلفت الثناء المؤبدا % % PageV01P490 البحر : كامل تام 1(@)(@@) % لا ترغبن فيمن إذا شاهدته % % وخبرته ، لم تلفه بالشاهد % % 2(@)(@@) % ومتى أردت تكثرا بدنوه % % فاعلم بأنك لم تزد عن واحد % % PageV01P491 البحر 
ms105	 : طويل 1(@)(@@) % تلق ذوي الحاجات بالبشر إنه % % إلى كرماء الناس أشهى من الجدا % % 2(@)(@@) % عسى من يرجى سيبك اليوم يغتني % % فتصبح فيمن ترتجي سيبه غدا % % PageV01P492 البحر : كامل تام 1(@)(@@) % ارض الخمول ، تعش به في نجوة % مما تخاف ، ومن معاندة العدا % % 2(@)(@@) % دون المعالي عدوة إن خضتها % % متقحما أوردت مهجتك الردى % % 3(@)(@@) % وإذا سلمت ونلت أيسر بغية % منها جعلت لك البرية حسد % 4(@)(@@) % فاسمع نصيحة من يكاد لعلمه % % بالدهر يدري اليوم بالآتي غد % PageV01P493 البحر : بسيط تام 1(@)(@@) % ما كف كفي عن جودي بموجودي % % نوائب وملمات لحت عودي % % 2(@)(@@) % فيا ليسر أبذل ميسوري وأبذل في % % عسري لطالب رفدي شطر موجودي % % PageV01P494 البحر : - 1(@)(@@) % إن فاجأتك الليالي % % بما يسوء فصبرا % % 2(@)(@@) % فالدهر يرهق عسرا % % ويتبع العسر يسرا % % 3(@)(@@) % لو دام ما ساء منه % % لدام ما كان سرا % % PageV01P495 البحر : مجزوء الكامل 1(@)(@@) % الق الخطوب إذا طرق % % ن بقلب محتسب صبور % % 2(@)(@@) % فسينقضي زمن الهمو % % م كما انقضى زمن السرور % % 3(@)(@@) % فمن المحال دوام حا % % ل في مدى العمر القصير % % PageV01P496 البحر : كامل تام 1(@)(@@) % أستر همومك بالتجمل ، واصطبر % % إن الكريم على الحوادث يصبر % % 2(@)(@@) % كالشمع ، يظهر نوره متجملا % خوف الشمات ، وفيه نار تسعر % PageV01P497 البحر : مجزوء الكامل 1(@)(@@) % لا تأمنن كيد العد % % و فأمن كيدهم غرر % % 2(@)(@@) % كن منه إن كان القو % % ي أو الضعيف على حذر % % 3(@)(@@) % فالماء يطفي النار طب % % عا ، في الصفاء وفي الكدر % PageV01P498 البحر : كامل تام 1(@)(@@) % عش واحدا ، أو فالتمس لك صاحبا % في محتدي ورع وطيب نجار % % 2(@)(@@) % واحذر مصاحبة السفيه ، فشر ما % % جلب الندامة صحبة الأشرار % 3(@)(@@) % والناس كالأشجار : هذى يجتنى % % منها الثمار وذي وقود النار % % PageV01P499 البحر : طويل 1(@)(@@) % يقولون لي : أفنيت كل ذخيرة % وأنفقت مالا لا تجود به النفس % 2(@)(@@) % فقلت : نعم فرقت ما جمعت يدي % % وأرجو غدا يأتي بما أذهب الأمس % % PageV01P500 البحر : كامل تام 1(@)(@@) % إياك والسلطان لا يدنيك من % % أبوابه متكسب ومعاش % % 2(@)(@@) % واعلم بأنهم على ما كان من % % أحوالهم نار ونحن فراش % % PageV01P501 البحر : مجزوء الخفيف 1(@)(@@) % كل 
ms106	 مستقبل من ال % % هم ينسى إذا مضى % % 2(@)(@@) % والذي ساء من زما % % نك سهل مع الرضا % % 3(@)(@@) % وأخو الحزم من إذا % % أعضل الأمر فوضا % % PageV01P502 البحر : بسيط تام 1(@)(@@) % أصبحت كالنسر خانته قوادمه % % لا تستقل جناحاه إذا نهضا % % 2(@)(@@) % أروح من نائبات لا تغب ومن % % هموم عيش كما لا أشتهي غرضا % % 3(@)(@@) % لكنني قد حلبت الدهر أشطره % فما يراني لخطب ناب منقبضا % % 4(@)(@@) % ألقى الحوادث بالصبر الجميل ومق % % دور القضاء بتسليم له ورضا % % 5(@)(@@) % علما بتغيير أحوال الزمان فكم % % رأيت مبرم أمر عاد منتقضا % % PageV01P503 البحر : كامل تام 1(@)(@@) % لا تستكن للهم ، واثن جماحه % % بعزيمة في الخطب لا تتضعضع % 2(@)(@@) % فإذا أتى ما ليس يدفع فالقه % % بالصبر ، فهو دواء مالا يدفع % PageV01P504 البحر : كامل تام 1(@)(@@) % قل للذين يسرهم ما ساءنا : % لا زايلتكم حسرة وتلهف % 2(@)(@@) % شملي بحمد الله بعد تشتت % % وتفرق ، متجمع متألف % 3(@)(@@) % والمال إن غال الزمان تلاده % % وسلمت ، سد مكانه المستطرف % PageV01P505 البحر : وافر تام 1(@)(@@) % إلى كم ترتجي عطف الملول % وتستجدي نوالا من بخيل % 2(@)(@@) % كأنك في الذي حاولت ساع % % لجمع ضحى نهارك بالأصيل % % 3(@)(@@) % لقد أوقعت قلبك في عناء % كبير في رجاء جدا قليل % % 4(@)(@@) % وفي الأطماع للمعتز ذل % % وحسن اليأس عز للذليل % 5(@)(@@) % فلا تعص النهى ؛ فالحزم ناه % لمثلك عن طلاب المستحيل % % 6(@)(@@) % تناسوا ، أو نسوا عهدي ، ومالوا % % إلى جحد الهوى كل المميل % 7(@)(@@) % ولما أن رأوا حسني قبيحا % رأوا غمط الجميل من الجميل % % 8(@)(@@) % سلوا وتبدلوا بك فاسل عنهم % % فكل الناس من أبناء جيل % 9(@)(@@) % ولا تجزع لغدر من خليل % فقد نسخ الوفاء من الخليل % % 10(@)(@@) % وأغض على القذى عينا ، وسكن % % حشاك على جوى الهم الدخيل % PageV01P506 البحر : طويل 1(@)(@@) % وإني لعصاء العواذل ، لا أرى % على شعث الخلان مستبدلا خلا % 2(@)(@@) % ضنين بمن صاحبت أحسب أنه % % إذا بان ، لا ألقى له أبدا مثلا % PageV01P507 البحر : مجزوء الرمل 1(@)(@@) % أيها الربع المحيل % جد بي عنك الرحيل % 2(@)(@@) % لست بالدار ولا في % % ك لمن يضحى مقيل % 3(@)(@@) % غاب عنى الرشد في 
ms107	 % % قصديك والرأي الأصيل % % 4(@)(@@) % غلطة كانت ولطف % % الله ما زال يقيل % % 5(@)(@@) % ما مقام الحر في ار % % ض بها الناس قليل % 6(@)(@@) % بلد فيه عزيز الق % % قوم مقهور ذليل % % 7(@)(@@) % لست أرجوك وقد لا % % حت لعيني المحول % 8(@)(@@) % إنما يرتاد أرض ال % % حل مغرور جهول % PageV01P508 البحر : طويل 1(@)(@@) % أين غض دهر من جماحي ، أو ثنى % % عناني أو زلت بأخمصي النعل % % 2(@)(@@) % تظاهر قوم بالشمات ؛ جهالة % وكم إحنة في الصدر أبرزها الجهل % 3(@)(@@) % وهل أنا إلا السيف فلل حده % % قراع الأعادي ، ثم أرهفه الصقل % PageV01P509 البحر : طويل 1(@)(@@) % توالى إلي السائلون وإنني % % لآنف ألا يدرك السؤل سائلي % % 2(@)(@@) % ولكن مستوري كظاهر حالهم % % فما حيلتي ، والحظ حرب الفضائل % % 3(@)(@@) % ولو بسطت أيدي الحوادث من يدي % % تلقتهم قبل السؤال بنائلي % % PageV01P510 البحر : بسيط تام 1(@)(@@) % علام أخضع في الدنيا لمن رفعت % وما بأيديهم رزقي ولا أجلي % % 2(@)(@@) % ما قدر الله لا أستطيع أدفعه % وما لهم في سوى المقدور من عمل % % PageV01P511 البحر : سريع 1(@)(@@) % إن سر أعدائي أن عضني % % دهري بما أذهب من مالي % % 2(@)(@@) % فهمتي بالنجم معقودة % ما حطها ما حال من حالي % % 3(@)(@@) % كالنار إن نكسها قابس % لم يتنكس نورها العالي % % PageV01P512 البحر : بسيط تام 1(@)(@@) % سلوت عن كل حال كنت ذا شغف % % بها ولم أسل في حال عن الكرم % % 2(@)(@@) % ما غال دهري وفري في تقلبه % % إلا جعلت الندى سترا على العدم % % PageV01P513 البحر : طويل 1(@)(@@) % لنا هجمة للحق إن ناب ، والقرى % % وللجار ما تنفك نهبا مقسما % 2(@)(@@) % إذا هي لم يعجل إلى الضيف درها % % أدر اليماني من عراقبها الدما % % PageV01P514 البحر : رجز تام 1(@)(@@) % لا تودعن سمع شكية % فالقلب أولى بالذي أجنا % % 2(@)(@@) % وكل ما نشكوه من زماننا % % نزول عنه أو يزول عنا % % PageV01P515 البحر : بسيط تام 1(@)(@@) % ظلمت شعري وليس الظلم من شيمي % % يطيعني حين أدعوه ، وأعصيه % % 2(@)(@@) % يهم أن يذكر القوم اللئام بما % % فيهم فأزجره عنهم وأثنيه % % 3(@)(@@) % وليس من خلقي ثلب الغني ، وإن % % جنى ولا ذكر ذي نقص بما فيه % % PageV01P516 البحر : مجزوء الكامل 
ms108	 1(@)(@@) % لما رأيت صروف ه % % ذا الدهر تلعب بالبرايا % % 2(@)(@@) % يعلو بها هذا ويه % % بط ذا وقصرهم المنايا % % 3(@)(@@) % ورأيته مسترجعا % نزر المواهب والعطايا % % 4(@)(@@) % متغاير الأحوال مخ % % لف الضرائب والسجايا % % 5(@)(@@) % لا نعمة فيه تدو % % م ولا تدوم به البلايا % % 6(@)(@@) % لم أغتبط فيه بفائ % % ئدة ولم أخش الرزايا % % PageV01P517 البحر : خفيف تام 1(@)(@@) % في الشواهد والأمثال وما ينسج على هذا المنواللو صبرنا على البلاء احتسابا % لرجونا عنه جزيل الثواب % 2(@)(@@) % غير أن اصطبارنا صبر عجز % % واضطرار كذاك صبر الدواب % % 3(@)(@@) % فلحى الله أنفسا ترتضي الع % % يش ، إذا كان فيه ذل الرقاب % % PageV01P518 البحر : بسيط تام 1(@)(@@) % حسبي من العيش خير العيش يدركه % % سواي بي ، ولي الأوصاب والنصب % 2(@)(@@) % كأنني البو تستمرى العجول به % % وإنما لسواه الدر والحلب % % PageV01P519 البحر : بسيط تام 1(@)(@@) % بعدا لمن شره أعمى ، يصيب ولا % % يرى مكان الأعادي من ذوي النسب % % 2(@)(@@) % كالنار تحرق طبعا ، لا تميز بي % % ن المندل الرطب في الإحراق والحطب % % PageV01P520 البحر : متقارب تام 1(@)(@@) % ألفت الكجاوة بعد النفور ، % وطابت ، وما خلتها لي تطيب % 2(@)(@@) % وصرف الزمان كما قد علمت % % ت أمنك الله منه ، عجيب % 3(@)(@@) % يعيد صديقك وهو العدو % % ويثني بغيضك وهو الحبيب % % PageV01P521 البحر : بسيط تام 1(@)(@@) % أما ترى الماجد المفضال ترفعه % % أيامه وهو بالإحسان مقترب % % 2(@)(@@) % طوق القياد كغصن البان يجذبه % % مر النسيم على ضعف فينجذب % % PageV01P522 البحر : كامل تام 1(@)(@@) % شاهدت نملا قد تجاذب زهرة % ذا قد تملكها ، وهذا يسلب % 2(@)(@@) % مثل الملوك تجاذبوا الدنيا ، فما % % حصلت لمغلوب ولا من يغلب % % PageV01P523 البحر : بسيط تام 1(@)(@@) % يا آلف الهم ، لا تقنط ، فأيأس ما % % تكون يأتيك لطف الله بالفرج % 2(@)(@@) % ثق بالذي يسمع النجوى ، وينجى من ال % % بلوى ويستنقذ الغرقى من اللجج % % PageV01P524 البحر : كامل تام 1(@)(@@) % ثقلي إذا ناديتني لملمة % أجدي من المتسرع الهلباج % 2(@)(@@) % إن الأناة من الخيبر بما أتى % % تغنيك عن سير ، وعن إدلاج % 3(@)(@@) % ما في شرار النار نفع يرتجى % % والجمر فيه فضيلة الإنضاج % % PageV01P525 البحر : بسيط تام 1(@)(@@) % لولا الذي جرت الأقلام 
ms109	 قبل به % % ما نال ذو الجهل ، دون الحازم ، المنحا % % 2(@)(@@) % لكن للحظ ميزانا ترفع ذو الن % % قصان في وزنه وانحط من رجحا % % PageV01P526 البحر : كامل تام 1(@)(@@) % قالوا : نهته الأربعون عن الصبا % % وأخو المشيب يجور ثمت يهتدي % % 2(@)(@@) % كم ضل في ليل الشباب فدله % % وضح المشيب على الطريق الأقصد % % 3(@)(@@) % وإذا عددت سني ثم نقصتها % % زمن الهموم فتلك ساعة مولدي % % PageV01P527 البحر : كامل تام 1(@)(@@) % أصبحت في زمن يشيب لجوره % % فود الجنين ويهرم المولود % % 2(@)(@@) % وإذا شكونا اليوم ، ثم أتى غد % قلنا : ألا يا ليت أمس يعود % % PageV01P528 البحر : بسيط تام 1(@)(@@) % ودع أخا العزم مصرا ، لا لميس ، وخض % بالسابحات بحار المهمه البيد % 2(@)(@@) % وسر عن الأرض تنبو بالكرام ، فقد % % طال انتظار الجنى من يابس العود % % PageV01P529 البحر : وافر تام 1(@)(@@) % صديق لي ، تنكر بعد ود % وأم الغدر في الدنيا ولود % 2(@)(@@) % أراه ملاله حسني قبيحا % فصد ، وأيسر الغدر الصدود % 3(@)(@@) % وذم اليوم ما حمدته مني % % تجاربه وأمس به شهيد % % 4(@)(@@) % ولست ألومه فيما أتاه % % أساء ، فرابه الفعل الحميد % 5(@)(@@) % قد يجد المريض الماء مرا % % بفيه وهو سلسال برود % % PageV01P530 البحر : بسيط تام 1(@)(@@) % مضت لداتي وإخواني ، وأفردني % % دهري ، فعشت وحيدا ميتا كمدا % % 2(@)(@@) % وما أرى لي بحسن الصبر بعدهم % % وإن تجلدت خوف الشامتين ، يدا % % 3(@)(@@) % والقبر أرفق مسكون ونكرهه % % إذ كان يسكنه الإنسان منفردا % % PageV01P531 البحر : خفيف تام 1(@)(@@) % تنظر العاجز الحظوظ فيستع % % لي ، وتعمى عن حازم محدود % 2(@)(@@) % في اعتلاء الشرار عن راكد الجم % % ر دليل أن العلا بالجدود % % PageV01P532 البحر : بسيط تام 1(@)(@@) % إن يستروا وجه إحساني بكفرهم % % فالشمس أدنى سحاب عن يسترها % % 2(@)(@@) % وإن هم كدروا صفوي بغشهم % % فالعين أدنى القذى فيها يكدرها % % PageV01P533 البحر : بسيط تام 1(@)(@@) % إن كنت في مصر مجهولا ، وقد شهرت % % فضائلي بين بدو الناس والحضر % % 2(@)(@@) % فما على الشمس من عار تعاب به % % إذا اختفى ضوءها عن غير ذي بصر % PageV01P534 البحر : طويل 1(@)(@@) % كفى حزنا أن الحوادث قصرت % % يدي ولساني عن نوال وعن أمر % % 2(@)(@@) % فما يخشي الأعداء بأسي 
ms110	 وسطوتي % % ولا يرتجي الإخوان نفعي ولا نصري % % 3(@)(@@) % إذا نابهم خطب فكل استطاعتي % % تلهب أنفاس أحر من الجمر % % 4(@)(@@) % ولا خير في الدنيا لمثلي ولو صفت % % إذا كان لا يرجى لنفع ولا ضر % % PageV01P535 البحر : سريع 1(@)(@@) % سهل على العارف بالدهر % % ما ناب من مستصعب الأمر % % 2(@)(@@) % وكل ما استعظم من حادث % مستصغر في جانب الصبر % PageV01P536 البحر : بسيط تام 1(@)(@@) % أنظر إلى حسن صبر الشمع نظهر لل % % رائين نورا ، وفيه النار تستعر % 2(@)(@@) % كذا الكريم تراه ضاحكا جذلا % وقلبه بدخيل الهم منفطر % PageV01P537 البحر : منسرح 1(@)(@@) % اصبر على ما كرهت تحظ بما % % تهوى ، فما جازع بمعذور % 2(@)(@@) % إن اصطبار الجنين في ظلم ال % % شاء أفضى به إلى النور % % PageV01P538 البحر : بسيط تام 1(@)(@@) % إني لأعرف من وجه العدو وإن % % أبدى المداجاة ما تخفي ضمائره % % 2(@)(@@) % كالخط يلحظه القاري ، فيوصل مع % % ناه إلى قلبه في الوقت ناظره % PageV01P539 البحر : بسيط تام 1(@)(@@) % اصبر تنل ما ترجيه وتفضل من % % جاراك شأو العلا سبقا وتبريزا % % 2(@)(@@) % فالتبر أحرق بالنيران مصطبرا % على لظاها ، إلى أن عاد إبريزا % % PageV01P540 البحر : بسيط تام 1(@)(@@) % اصبر إذا ناب خطب وانتظر فرجا % يأتي به الله بعد الريث والياس % % 2(@)(@@) % إن اصطبار ابنة العنقود إذ حبست % % في ظلمه القار أداها إلى الكاس % % PageV01P541 البحر : سريع 1(@)(@@) % الضر في أيامنا هذه % % كالليل يغشى سائر الناس % 2(@)(@@) % وكلهم راض وفوق الرضا % % ببلغة الطاعم والكاسي % % 3(@)(@@) % ودون ما يرجونه مانع % % يلقى وجوه الناس بالياس % % PageV01P542 البحر : وافر تام 1(@)(@@) % أراني أستطيل مدى حياتي % % وما في مفرقي للشيب وخط % 2(@)(@@) % ولو أسقطت منه زمان همي % % لقال الناس : هذا الشخص سقط % PageV01P543 البحر : بسيط تام 1(@)(@@) % لا تخدعن بأطماع تزخرفها % % لك المنى بحديث المين والخدع % % 2(@)(@@) % فلو كشفت عن الموتى بأجمعهم % % وجدت هلكهم في الحرص والطمع % PageV01P544 البحر : كامل تام 1(@)(@@) % ومماذق رجع النداء جوابه % % فإذا عرا خطب فأبعد من دعي % % 2(@)(@@) % مثل الصدى ، يخفى علي مكانه % % أبدا ويملأ بالإجابة مسمعي % % PageV01P545 البحر : كامل تام 1(@)(@@) % قوم يموت الناس عندهم % % ضرا وهم منهم على 
ms111	 فرق % % 2(@)(@@) % كالبحر يهلك فيه راكبه % % عطشا ، ويخشى الموت بالغرق % % PageV01P546 البحر : بسيط تام 1(@)(@@) % لنا صديق يغر الأصدقاء ، وما % % رأيته قط في ود امرئ صدقا % % 2(@)(@@) % صديقه أبدا منه على وجل % كراكب البحر يخشى دهره الغرقا % % PageV01P547 البحر : بسيط تام 1(@)(@@) % لا تقربن باب سلطان وإن ملأت % % هباته غير ممنون بها الطرقا % % 2(@)(@@) % فإن أبوابهم كالبحر : راكبه % مروع القلب يخشى دهره الغرقا % % PageV01P548 البحر : بسيط تام 1(@)(@@) % أستر بصبرك ما تخفيه من كمد % وإن أذاب حشاك الهم والحرق % % 2(@)(@@) % كالشمع يظهر أنوار التجمل ، والد % موع منهلة ، والجسم محترق % PageV01P549 البحر : منسرح 1(@)(@@) % من رزق الصبر نال بغيته % % ولاحظته السعود في الفلك % 2(@)(@@) % إن اصطبا الزجاج للسبك والن % % يران أدناه من فم الملك % % PageV01P550 البحر : بسيط تام 1(@)(@@) % أنظر إلى صرف دهري كيف عودني % % بعد المشيب سوى عاداتي الأول % 2(@)(@@) % وفي تغاير صرف الدهر معتبر % % وأي حال على الأيام لم تحل % % 3(@)(@@) % قد كنت مسعر حرب ، كلما خمدت % أضرمتها باقتداح البيض في القلل % 4(@)(@@) % همي منازلة الأقران أحسبهم % % فرائسي فهم مني على وجل % % 5(@)(@@) % أمضى على الهول من ليل وأهجم من % % سيل ، وأقدم في الهيجاء من أجل % 6(@)(@@) % فصرت كالغادة المكسال : مضجعها % % على الحشايا وراء السجف والكلل % % 7(@)(@@) % قد كدت أعفن من طول الثواء كما % % يصدى المهند طول المكث في الخلل % 8(@)(@@) % أروح بعد دروع الحرب في حلل % % من الدبيقي فبؤسا لي وللحلل % % 9(@)(@@) % وما الرفاهة من رأيي ولا أربي % % ولا التنعم من همي ولا شغلى % % 10(@)(@@) % ولست أهوى بلوغ المجد في رفة % ولا العلا دون حطم البيض والأسل % % PageV01P551 البحر : طويل 1(@)(@@) % إذا ما عرا خطب من الدهر فاصطبر % فإن الليالي بالخطوب حوامل % 2(@)(@@) % فكل الذي يأتي به الدهر زائل % سريعا ، فلا تجزع لما هو زائل % PageV01P552 البحر : خفيف تام 1(@)(@@) % كل شيء تراه في هذه الدن % % يا خيال إذا انتبهت يزول % % 2(@)(@@) % ما يدوم النعيم فيها ولا البؤ % % س متاع الدنيا متاع قليل % % 3(@)(@@) % والذي يصرف الهموم إذا ما % % ضقت ذرعا بهن صبر جميل % PageV01P553 البحر 
ms112	 : بسيط تام 1(@)(@@) % إني وثقت بأمر غرني أملي % % فيه ، وقد قيل : كم من واثق خجل % 2(@)(@@) % عادت إلي الأماني منه آيسة % فيا حياء المنى من خيبة الأمل % % PageV01P554 البحر : كامل تام 1(@)(@@) % لا در درك من رجاء كاذب % % يغترنا بورود لامع آل % % 2(@)(@@) % أبدا يسوقنا بنصرة خاذل % ووفاء خوان ، وعطفة قال % 3(@)(@@) % ونرى سبيل الرشد لكن مالنا % % عزم مع الأهواء والآمال % % PageV01P555 البحر : كامل تام 1(@)(@@) % لا تعتبن من مل إن عتابه % % كثقاف معوج الظلال المائل % % 2(@)(@@) % يلقى العتاب بسمع لاه صادف % ويرى الخضوع بطرف ساه غافل % % 3(@)(@@) % فإذا أقمت دليل قبح فعاله % % دفع العيان بحجة المتجاهل % PageV01P556 البحر : بسيط تام 1(@)(@@) % لا يؤسفنك ما غال الزمان فما % % يرضى بما غال : من وفر ومن مال % 2(@)(@@) % وإنما هو بالتدريج ينقلنا % % نقل المخادع من حال إلى حال % 3(@)(@@) % وليس يرضى بما دون النفوس وما % % تفدى إذا غالها حاشاك بالغالي % % PageV01P557 البحر : مجزوء الكامل 1(@)(@@) % يا جاعل الأشغال عذ % % را في مدافعتي ومطلي % % 2(@)(@@) % شغلي إليك إذا اشتغل % % ت ، فإذ فرغت فأنت مثلي % % PageV01P558 البحر : طويل 1(@)(@@) % إلى كم أجوب الأرض مالي معرس % ولا لمسيري في البلاد قفول % 2(@)(@@) % كأني في الدنيا قذاة بمقلة % تردد في أرجائها ، وتجول % 3(@)(@@) % أشيم بها برق الحيا وهو خلب % % وأرتاد أرض الروض وهي محول % % 4(@)(@@) % وما من تكاليف الحياة وبؤسها % % خلاص بغير الموت ، وهو مهول % PageV01P559 البحر : سريع 1(@)(@@) % زهدني في العقل أني أرى % % عناية الأيام بالجهل % % 2(@)(@@) % والدهر كالميزان : ذو الفضل ين % % حط وذو النقصان يستعلي % % PageV01P560 البحر : كامل تام 1(@)(@@) % رفع الحظوظ لمن أصبن ، وحط من % % أخطأنه ، فيه يحار العاقل % 2(@)(@@) % يعطى الغبي ويحرم الندب الفتى % % كالديك توج والبزاة عواطل % % PageV01P561 البحر : خفيف تام 1(@)(@@) % لي مولى صحبته مذهب العم % % ر فلم يرع حرمتي وذمامي % % 2(@)(@@) % ظنني ظله أصاحبه الده % % ر على غير نائل واحترام % % 3(@)(@@) % فافترقنا كأنه كان طيفا % وكأني رأيته في المنام % % PageV01P562 البحر : منسرح 1(@)(@@) % لو كان رزق الفتى بقوته % نازلت ضاري الأسود في الأجم % % 2(@)(@@) % لكنه عن مشيئة سبقت 
ms113	 % % في الخلق تجري فيهم على القسم % PageV01P563 البحر : طويل 1(@)(@@) % لحى الله أرضا يرشف المرء رزقه % % بها مكرها رشف الذعاف من السم % 2(@)(@@) % تشيب حبات القلوب بجورها % % وتهرم إنسان العيون من الهم % PageV01P564 البحر : كامل تام 1(@)(@@) % لا تأسفن لذاهب أو فائت % % يرجى ، ولا تتبعه زفرة نادم % % 2(@)(@@) % واصبر على الحدثان صبر مسلم % % متيقن أن ليس منه بسالم % % 3(@)(@@) % فغضارة الدنيا كظل زائل % % والعيش فيها مثل حلم النائم % % 4(@)(@@) % والدهر يمنح ، ثم يمنع نزر ما % % أعطى ، ويبخل بالسرور الدائم % % 5(@)(@@) % والناس من لم يصطبر لمصابه % صبر الرضا صبر اصطبار الراغم % % PageV01P565 البحر : مجزوء الكامل 1(@)(@@) % قل للرجاء : إليك ، قد % % أتعبتني بعد الكرام % % 2(@)(@@) % قد عم داء البخل ح % % ى شاع في كل الأنام % 3(@)(@@) % فأكفهم بالبخل مق % % فلة على سحت الحطام % % 4(@)(@@) % فإلام ترتاد المحو % % ل ، وترتجي ري الجهام % % PageV01P566 البحر : مجزوء الرمل 1(@)(@@) % يا أخي الشاكي لما أش % % وه والحامل همي % % 2(@)(@@) % ونسيب الود لا نس % % بة آباء وعم % % 3(@)(@@) % ظلمتني دولة العد % % ل فمن يكشف ظلمي % % 4(@)(@@) % ومتى يحكم لي بال % % عدل والحاكم خصمي % % PageV01P567 البحر : كامل تام 1(@)(@@) % لا تطلعن لسان شكوى بائح % % ضجرا على سر الفؤاد الكاتم % % 2(@)(@@) % واعلم بأن جميع ما فيه بنو الد % % نيا يزول زوال حلم النائم % % PageV01P568 البحر : خفيف تام 1(@)(@@) % اصطبر للزمان إن حاف حينا % % أو تلقاك بالمخاوف حينا % % 2(@)(@@) % إن صبر الكليم وهو طريد ال % % خوف أفضى به إلى طورسينا % % PageV01P569 البحر : مجزوء الكامل 1(@)(@@) % من مل فاهجره فقد % % أبدى لك اليأس المبينا % % 2(@)(@@) % أعيا شماس أخي التلو % % ن والملال الرائضينا % % 3(@)(@@) % لن يرجع الفخار بع % % د تلافه بالكسر طينا % % PageV01P570 البحر : بسيط تام 1(@)(@@) % يا شارب الخمر بعد النسك والدين % وبعد ما تاب عما راب مذ حين % % 2(@)(@@) % أفسدت دينك والسبعون أفسدت ال % % دنيا فلست بذي دنيا ولا دين % % 3(@)(@@) % وإنما أنت فخار تكسر ، لا % يرجى لنفع ، ولا يعتد في الطين % PageV01P571 البحر : بسيط تام 1(@)(@@) % كم تقصد الماجدين الفاضلين ، وكم % % تعلم الكرماء البخل يا زمن % 2(@)(@@) % إذا 
ms114	 توالت عليهم نائباتك واج % % تاحت فواضل ما يولونه المحن % % 3(@)(@@) % فكيف بالجود والأحداث تسلب ما % % يولى به العرف أو تسدى به المنن % % 4(@)(@@) % شغل الزمان بأهل النقص يرفعهم % % حتى يثمر للوراث ما خزنوا % % 5(@)(@@) % ألهاه عن كرماء الناس ، فهو على % % ذوي المكارم والأفضال مضطغن % % PageV01P572 البحر : كامل تام 1(@)(@@) % لا تخضعن رغبا ولا رهبا ، فما % % مرجو والمخشي إلا الله % % 2(@)(@@) % ما قد قضاه الله مالك من يد % % بدفاعه وسواه لا تخشاه % % PageV01P573 البحر : خفيف تام 1(@)(@@) % نلت في مصر كل ما يرتجى الآ % % مل من رفعة ومال وجاه % % 2(@)(@@) % فاستردت ما خولتني ، وما أسر % % رع نقص الأمور عند التناهي % % 3(@)(@@) % كنت فيها كأنني في منام % زال منه ما سر عند انتباهي % % PageV01P574 البحر : طويل 1(@)(@@) % وشائمة برقا بفودي راعها % % وما كل برق لاح يؤذن بالخصب % % 2(@)(@@) % رأت شعرات أخلقت بعد جدة % ونفسا سلت بعد الغراية في الحب % % 3(@)(@@) % فقالت نهاك الشيب عن مرح الصبا % % ورداك بعد الجون دهرك بالعصب % 4(@)(@@) % فقلت : نعم أصبحت طوع عواذلي % % وأصبحت لا أصبو للهو ولا أصبي % % 5(@)(@@) % ولا عجب : ليل تبلج فجره % % وحلم رمى شيطان جهلي بالشهب % % 6(@)(@@) % وهم ورى بين الجوانح زنده % أضاء له في مفرقي لامع اللهب % PageV01P575 البحر : بسيط تام 1(@)(@@) % أما ترى الشيب قد رداك بعد دجى % % فوديك واها لذاك الليل بالعصب % % 2(@)(@@) % وأسمعتك الليالي في مواعظها % % أن ابن سبعين من ورد على قرب % % 3(@)(@@) % أعرضت عن صبوات كنت ذا شغف % بها وجانبت ما يدني من الريب % % 4(@)(@@) % وسرت طوع النهى ، ترضى أناتي في % % سيري ومري في شدي وفي خببي % % PageV01P576 البحر : كامل تام 1(@)(@@) % لو كان صد مغاضبا ومعاتبا % % أعتبته ووضعت خدي تائبا % % 2(@)(@@) % لكن رأى تلك النضارة قد ذوت % % لما غدا ماء الشبيبة ناضبا % % 3(@)(@@) % وتعاقب الأيام أعقب لمتي % % من حالك جثل شكيرا شايبا % % 4(@)(@@) % ورأى النهى بعد الغواية صاحبي % % فثنى العنان يريغ غيري صاحبا % % 5(@)(@@) % وأبيه ما ظلم المشيب وإنه % % أملي فقلت : عساه عني راغبا % % 6(@)(@@) % أنا كالدجى ، لما انتهى نشرت له % % أيدي 
ms115	 الصباح من الضياء ذوائبا % % 7(@)(@@) % خمسون من عمري مضت لم أتعظ % % فيها كأني كنت عنها غائبا % % 8(@)(@@) % لم أنتفع بتجاربي فيها على % % أني لقيت من الزمان عجائبا % % 9(@)(@@) % وأتت علي بمصر عشر بعدها % % كانت عظاة كلها وتجاربا % % 10(@)(@@) % شاهدت من لعب الزمان بأهله % % وتقلب الدنيا الرقوب عجائبا % % PageV01P577 البحر : بسيط تام 1(@)(@@) % صحا ، وللجهل أوقات وميقات % وللغوايات والأهواء غايات % 2(@)(@@) % رأى المشيب كبيض الهند لامعة % لها على فوده الغربيب إصلات % 3(@)(@@) % فراجع الحلم وانجابت غوايته % % وفي النهى للهوى المردى نهايات % 4(@)(@@) % والشيب شهب رمت شيطان شرته % % فأقصدته ، وكم تنجو الرميات % 5(@)(@@) % لله در الصبا ، لو دام رونقه % % فما كأوقاته في العمر أوقات % % 6(@)(@@) % ولا رعى الشيب من زور إذا نزل الم % مثوى نأت وسرت عنه المسرات % % 7(@)(@@) % طوالع الشيب إن راقتك واضحة % طلائع قدمتهن المنيات % PageV01P578 البحر : كامل تام 1(@)(@@) % مالي رأيت الثلج عمم شيبه % قلل الربا ، فزهت بحسن نباتها % % 2(@)(@@) % راق العيون ، وشيب فودى راعها % % حتى كان الشيب وخز قذاتها % % PageV01P579 البحر : بسيط تام 1(@)(@@) % دع ما نهى الشيب والسبعون عنه ، فتر % % باك الصبا والشباب الغض قد درجا % % 2(@)(@@) % واعتضت من فتك أخذان الصبا ورعا % ومن جهالة أيام الشباب حجا % % 3(@)(@@) % عذرت ، إذ جرت في ليل الشباب ، فهل % عذر وشيبك قد أذكى لك السرجا % % 4(@)(@@) % وما أساءت بك الأيام إذ جعلت % % فوديك درا وكانا قبله سبجا % % PageV01P580 البحر : طويل 1(@)(@@) % أرى شعرات ينتبذن كأنها % % على الماء صدع في الزجاجة بادي % % 2(@)(@@) % وعهدي بها فيما مضى ، وكأنها % % على الفضة البيضاء نقش سواد % % PageV01P581 البحر : طويل 1(@)(@@) % إذا ما جلا الليل النهار بنوره % % تعقبه ليل أحم ركود % % 2(@)(@@) % فما لي أرى ليل الشباب إذا جلا % % وجاء نهار الشيب ليس يعود % % PageV01P582 البحر : كامل تام 1(@)(@@) % نظرت بياض مفارقي ، فاسترجعت % أسفا وقالت : أين ذاك الأسود % % 2(@)(@@) % قلت : اضمحل فأطرقت وتنفست % % نفسا تصعده حشا تتوقد % % 3(@)(@@) % قالت : فهل من موعد للقائنا % % فأرى نذير البين قلت : الموعد % % PageV01P583 البحر : متقارب تام 1(@)(@@) % يقولون : جار عليك المشيب % ومن ذا يجير إذا الشيب 
ms116	 جارا % % 2(@)(@@) % وما كنت مغتبطا بالشباب % % وهل كان إلا رداء معارا % % 3(@)(@@) % ولكنني ساءني فقده % % فواها له ، أي هم أثارا % % 4(@)(@@) % وما ساءني أن أحال الزمان % % ليلي نهارا وجهلي وقارا % % 5(@)(@@) % ولكن يقولون : عصر الشباب % % يكون لكل سرور قرارا % % 6(@)(@@) % وما زلت منذ ترديته % كخابط ليل أعاني العثارا % % 7(@)(@@) % أكابد دهرا يشيب الوليد % % وهما يشب بأحشاي نارا % % 8(@)(@@) % فوجدى أني فارقته % % ولم أبل ما يزعمون اختبارا % % PageV01P584 البحر : طويل 1(@)(@@) % تصاممت عن لوم العذول كأنما % % رمى الوجد يوم البين سمعي بالوقر % % 2(@)(@@) % وقد كنت معذورا بآنفة الصبا % % فهل لي بعد الشيب في الجهل من عذر % 3(@)(@@) % وغير ملوم مدلج ضل ، إنما % % يلام إذا ما ضل في وضح الفجر % % PageV01P585 البحر : بسيط تام 1(@)(@@) % رأيت ما تلفظ الموسى فآسفني % % إذ عاد حالكه كالثلج منثورا % % 2(@)(@@) % فقلت إذ رابني تغيير صبغته : % سبحان من رد ذاك الند كافورا % % PageV01P586 البحر : بسيط تام 1(@)(@@) % إذا تقوس ظهر المرء من كبر % فعاد كالقوس يمشي ، والعصا الوتر % 2(@)(@@) % فالموت أروح آت يستريح به % % والعيش فيه له التعذيب والضرر % PageV01P587 البحر : طويل 1(@)(@@) % إذا عاد ظهر المرء كالقوس ، والعصا % % له حين يمشي ، وهي تقدمه ، وتر % 2(@)(@@) % ومل تكاليف الحياة وطولها % % وأضعفه من بعد قوته الكبر % 3(@)(@@) % فإن له في الموت أعظم راحة % % وأمنا من الموت الذي كان ينتظر % PageV01P588 البحر : كامل تام 1(@)(@@) % لدتي وإخوان الشباب مضوالدتي وإخوان الشباب مضوا % % قبلي ، وكم من بعدهم أبقى % % 2(@)(@@) % كنا كأفراس الرهان جروا % % في غاية ، فتقدموا سبقا % % 3(@)(@@) % وهم إذا بلغوا المدى وقفوا % % حتى تضم الحلبة الخلقا % % PageV01P589 البحر : كامل تام 1(@)(@@) % ثلج النبات فراق لون مشيبه % % فعلام لون الشيب ليس يروق % % 2(@)(@@) % ما ذاك إلا أن ذا داع إلى % % طيب السرور ، وذاك عنه يعوق % 3(@)(@@) % وإذا أخو الشيب استجاب للذة % ومسرة ، فسروره مسروق % PageV01P590 البحر : كامل تام 1(@)(@@) % لم تترك السبعون في إقبالها % % منى سوى مالا عليه معول % % 2(@)(@@) % حتى إذا ما عامها عني انقضى % % ووطئت في العام الذي يستقبل % 3(@)(@@) % حطمت قواي وأوهنت من نهضتي 
ms117	 % % وكذا بمن طلب السلامة تفعل % % 4(@)(@@) % كم قد شهدت من الحروب فليتني % % في بعضها من قبل نكسي أقتل % % 5(@)(@@) % والقتل أحسن بالفتى من قبل أن % % يبلى ، ويفنيه الزمان ، وأجمل % 6(@)(@@) % وأبيك ما أجحمت عن خوض الردى % % في الحرب ، يشهد لي بذاك المنصل % 7(@)(@@) % وإذا قضاء الله أخرني إلى % % أجلي المؤقت لي فماذا أعمل % PageV01P591 البحر : كامل تام 1(@)(@@) % وضح الصباح لناظر المتأمل % % فإلام توضع في الطريق المجهل % 2(@)(@@) % أو ما نهتك السن عن مرح الصبا % % والخوض في غي الزمان الأول % % 3(@)(@@) % نزه بياض الشيب عن دنس الهوى % % فقد ارتديت الدر غير مفصل % % 4(@)(@@) % واعف العذول عن الملام فلومه % % غير الملم بسمع من لم يجهل % % PageV01P592 البحر : وافر تام 1(@)(@@) % نضا صبغ الشباب ، فلست أدري % % لصبغ حال ، أم تغيير حال % 2(@)(@@) % وما أبيض الغراب الجون إلا % % لينعب بانتقال وارتحال % PageV01P593 البحر : رجز تام 1(@)(@@) % إن ضعفت عن حمل ثقلي رجلي % % ورابني عثارها في السهل % % 2(@)(@@) % أمشي كما يمشي الوجي في الوحل % مشي الأسير مثقلا بالكبل % % 3(@)(@@) % فللعصا عندي عذ المبلي % % ان عجزت ، أو ضعفت عن حملي % % PageV01P594 البحر : كامل تام 1(@)(@@) % قالت وأحزنها بياض مفارقي % % ماذا ؟ فقلت : تريكة الأيام % % 2(@)(@@) % فبكت وقالت : هل لها من وارد % % أو رائد يوما ؟ فقلت : حمامي % % PageV01P595 البحر : كامل تام 1(@)(@@) % أنظر إلى لعب الزمان بأهله % % فكأنهم وكأنه أحلام % % 2(@)(@@) % قد كان كفي مألفا لمهند % تعرى القلوب له وتفرى الهام % % 3(@)(@@) % ولأسمر لدن الكعوب ، وجاره % % حيث استمر الفكر والأوهام % % 4(@)(@@) % تتزايل الأبطال عني مثلما % % نفرت من الأسد الهصور نعام % % 5(@)(@@) % فرجعت أحمل بعد سبعين العصا % % فاعجب لما تأتي به الأيام % % 6(@)(@@) % وإذا الحمام أبى معاجلة الفتى % % فحياته ، لا تكذبن ، حمام % PageV01P596 البحر : مجزوء الكامل 1(@)(@@) % من مبلغ عني فلا % % ن الدين ، والأنباء تنمي % % 2(@)(@@) % أني هجرتك لا كظنك % طائعا لكن برغمي % % 3(@)(@@) % أوهت خطوب الدهر من % % هممي ، وفلت حد عزمي % % 4(@)(@@) % ورمتني الأيام عن % % قوسي ، فأردتني بسهمي % % 5(@)(@@) % وغدا الذين بهم أس % % لي الهم حين يلم همي % % PageV01P597 البحر : وافر تام 1(@)(@@) % أفكر 
ms118	 في فرية ما تلاقي % % من الدنيا فتغشاني الهموم % % 2(@)(@@) % وتصعد زفرتي أسفا لعلمي % % بما يلقى من البؤس اليتيم % % 3(@)(@@) % وقد أودعتها ربا كريما % وما ينسى وديعته الكريم % PageV01P598 البحر : بسيط تام 1(@)(@@) % لما تخطتني السبعون معرضة % وساور الضعف بعد الأيد أركاني % % 2(@)(@@) % وأدخلت كان في شكري وفي صفتي % % واسترجع الدهر ما قد كان أعطاني % % 3(@)(@@) % رزقت فروة والسبعون تخبرها % % أن سوف تيتم عن قرب ، وتنعاني % % 4(@)(@@) % وهي الضعيفة ما تنفك كاسفة % ذليلة تمتري دمعي وأحزاني % % 5(@)(@@) % ما كان ، عما ستلقاه وعن جزعي % % لما ستلقاه ، أغناها وأغناني % % PageV01P599 البحر : رمل تام 1(@)(@@) % حملت ثقلي في السهل العصا % % ونبت بي حين حاولت الحزونا % % 2(@)(@@) % وإذا رجلي خانتني ، فلا % % لوم عندي للعصا في أن تخونا % % PageV01P600 البحر : سريع 1(@)(@@) % نكست في الخلق وحطتني الس % % بعون لما أن علت سني % % 2(@)(@@) % وغيرت خطي فأضحى كما % % ترى وكم قد غيرت مني % % 3(@)(@@) % والموت فيه راحة من أذى الد % % نيا ، فما أغفله عني % % PageV01P601 البحر : رمل تام 1(@)(@@) % نظرت مبيض فودي فبكت % % ثم قالت : ما الذي بعدي عراه % % 2(@)(@@) % قلت : هذي صبغة الله ، ومن % % يصبغ الأسود مبيضا سواه % % PageV01P602 البحر : كامل تام 1(@)(@@) % حملت ثقلي بعد ما شبت العصا % % فتحملته تحمل المتكاره % 2(@)(@@) % ومشت به مشي الحسير بوقره % % لا يستقل مقيدا بعثاره % % 3(@)(@@) % ما دها ثقلي ، ولكن ثقل ما % % أبقى الشباب علي من أوزاره % % 4(@)(@@) % ورجاى معقود بمن أعطى أخا الس % % بعين عهدة عتقه من ناره % % PageV01P603 البحر : بسيط تام 1(@)(@@) % يا رب حسن رجائي فيك حسن لي % % تضييع وقتي في لهو وفي لعب % % 2(@)(@@) % وأنت قلت لمن أضحى على ثقة % بحسن عفوك : إني عند ظنك بي % % PageV01P604 البحر : بسيط تام 1(@)(@@) % يا غافلين عن الأمر الذي خلقوا % % له ، أفيقوا ، فللنوام هبات % 2(@)(@@) % ماذا السكون إلى دنيا حوادثها % % لها على الخلق غدوات وعدوات % 3(@)(@@) % كيف البقاء بدار للفناء بها % % على الخلائق كرات وغارات % % 4(@)(@@) % وأنت يا أيها المغرور مالك في الد % % نيا من الناس غير البعد منجاة % 5(@)(@@) % يسرك البشر منهم حين تبصرهم 
ms119	 % % ولو خبرت لساءتك الطويات % % 6(@)(@@) % فاقطع حبالك من كل الأنام ، فهم % في كل حالات من دانوا حبالات % 7(@)(@@) % واحذر من الناس ، إني قد خبرتهم % ولا يغرنك خب فيه إخبات % % 8(@)(@@) % لا ترجهم في ملمات الزمان ؛ فما % % تلم إلا من الناس الملمات % 9(@)(@@) % وكلهم ، وهم الأحياء ، إن بعثوا % % على الحياء وفعل الخي أموات % % 10(@)(@@) % وقد سمعنا بأن الأرض كان بها % % ناس كرام ولكن قيل : قد ماتوا % % PageV01P605 11(@)(@@) % ولست أدري صحيحا ما تضمنت ال % % كتب القديمة أم فيها ضمانات % 12(@)(@@) % وأغلب الظن أن القوم قد جمعوا % % للباخلين حديث البهت : أي هاتوا % % 13(@)(@@) % لو كان ما جمعوا يبقى لهم لقضت % عليهم بالمواساة المروءات % % 14(@)(@@) % فكيف ، وهي عوار تسترد ، وأف % ياء تنقلها في الناس دودت % % PageV01P606 البحر : بسيط تام 1(@)(@@) % لا ترتج الخلق ؛ فالأبواب مرتجة % دون الحطام وباب الله مفتوح % % 2(@)(@@) % والرزق لو كان في أيدي الأنام أبوا % % أن يشرب الماء من طوفانه نو % % 3(@)(@@) % لكنه في يدي من فضله أبدا % للطائعين وللعاصين ممنوح % PageV01P607 البحر : بسيط تام 1(@)(@@) % مذ بصرتني تجاريبي ، ونبهني % % خبري بدهري فقدت العيشة الرغدا % % 2(@)(@@) % كأنني كنت في حلم ، فأيقظني % % خوفي ، وآلى على جفني لا رقدا % % PageV01P608 البحر : طويل 1(@)(@@) % عجزت عن الدنيا ، فما لي من يد % بها ولي الأيد المساعد واليد % % 2(@)(@@) % ولكنني لم أسل عنها فأرعوي % % ولا نلت منها ما أود وأقصد % % 3(@)(@@) % شقيت بما أحرزته من فضائل % % بأيسرها يحظى الشقي ويسعد % % 4(@)(@@) % وفي النفس ، إن ناجيتها باطراحها % % وبالزهد فيها ، فترة وتردد % 5(@)(@@) % فيا رب ألهمها الرشاد بتركها % % فإنك تهدي من تشاء وترشد % % PageV01P609 البحر : طويل 1(@)(@@) % نزلنا به ، حتى إذا يومنا انقضى % % رحلنا على العيس النجائب والجرد % 2(@)(@@) % نؤم بها البيت العتيق ونبتغي % % من النار عتقا جاء في سابق الوعد % 3(@)(@@) % فيا من قصدنا بيته ونبيه % % بك العوذ يا مولاي من خيبة القصد % % PageV01P610 البحر : رجز تام 1(@)(@@) % أما رأوا تقلب الدنيا بنا % % وفتكها بمن إليها أخلدا % % 2(@)(@@) % كم نسفت أيدي الخطوب جبلا % وصيرت لجة بحر ثمدا % % 3(@)(@@) % وكم أعادت ذا ثراء 
ms120	 معدما % وذا قبيل وعديد مفردا % % 4(@)(@@) % علمت ما لم يعلموا ، ونظرت % عيناي دهري مصدرا وموردا % % 5(@)(@@) % فما رأيت غير ظل زائل % كل يمد نحوه ، جهلا ، يدا % % PageV01P611 البحر : سريع 1(@)(@@) % مثوبة الفاقد عن فقده % % بصبره أنفع من وجده % % 2(@)(@@) % يبكيه من حزن عليه فهل % % يطمع في التخليد من بعده % % 3(@)(@@) % ما حيلة الناس ؟ ! وهل من يد % لهم بدفع الموت أو صده % 4(@)(@@) % وروده لا بد منه فلم % % تنكر ما لا بد من ورده % % 5(@)(@@) % سهامه لم يستطع ردها % % داود بالمحكم من سرده % % 6(@)(@@) % ولا سليمان ابنه ردها % % بملكه والحشد من جنده % % 7(@)(@@) % عدل تساوى الخلق فيه فما % % يميز المالك عن عبده % 8(@)(@@) % كل له حد ، إذا ما انتهى % % إليه وافاه على حده % % 9(@)(@@) % تجمعنا الأرض فكل امرئ % % في لحده كالطفل في مهده % % 10(@)(@@) % أما ترى ورادنا عرسوا % % بمنزل دان على بعده % % PageV01P612 11(@)(@@) % تبوءوا الأرض ولم يخبروا % % عن حر مثواهم ولا برده % % 12(@)(@@) % لحادث أسكتهم أمسكوا % % عن ابتداء القول أو رده % % 13(@)(@@) % لو نطقوا قالوا : التقى خير ما % % تزود المرء إلى لحده % 14(@)(@@) % فارجع إلى الله وثق بالذي % % وافاك في الصادق من وعده % % 15(@)(@@) % للصابرين الأجر ، والأمن من % عذابه ، والفوز في خلده % % PageV01P613 البحر : بسيط تام 1(@)(@@) % تبارك اسمك ، كم من ية شهدت % بأنك الواحد المستعلى الصمد % 2(@)(@@) % ما يصبغ الأسود الغربيب غيرك مب % يضا ولا يتعاطى صبغه أحد % % PageV01P614 البحر : مجزوء الكامل 1(@)(@@) % احذر من الدنيا ولا % % تغتر بالعمر القصير % % 2(@)(@@) % وانظر إلى ثار من % صرعته منا بالغرور % % 3(@)(@@) % عمروا ، وشادوا ما ترا % % ه : من المنازل والقصور % 4(@)(@@) % وتحولوا من بعد سك % % ناها إلى سكنى القبور % % PageV01P615 البحر : مجزوء الكامل 1(@)(@@) % لا تغتبط بسرور دن % % يا ، ما يدوم بها سرور % 2(@)(@@) % وكذاك لا تجزع لحا % % دثة تضيق بها الصدور % % 3(@)(@@) % فجميع ما فيه الأنا % % م أليس آخره القبور % % PageV01P616 البحر : طويل 1(@)(@@) % أرى العين تستحلي الكرى وأمامها % % كرى ليس تقضيه إلى داعي الحشر % 2(@)(@@) % وليس ينام الخائفون ، فمالها % % تنام على عظم المخافة والذعر % PageV01P617 البحر : كامل 