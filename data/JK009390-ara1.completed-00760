ms741	 ( إن الله لغني عن تعذيب هاذا نفسه ) )(@)(@@) ( حم خ م د ت ن ) و ابن خزيمة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6825 ) قال النبي :(@)(@@) | 30 ( إن الله لينظر إلى الكافر ولا ينظر إلى العائل المزهو ولقد حملت سليمان بن داود الريح وهو متكيء فاعجب واختال في نفسه فطرح على الأرض ) )(@)(@@) ( طس ) و ابن عساكر عن ابن عمر رضي الله عنهما .(@)(@@) PageV02P493(@)(@@)(@@)(@@) $ ( 6826 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليدخل بلقمة الخبز وقبضة التمر ومثله مما ينفع المسكين ثلاثة الجنة : صاحب البيت الآمر به ، والزوجة الصالحة ، والخادم الذي يناول المسكين ، الحمد لله الذي لم ينس خادمنا ) )(@)(@@) ( ك ) ومعقب وابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6827 ) قال النبي :(@)(@@) | 30 ( إن الله ليدخل بالسهم الواحد ثلاثة الجنة : صانعه يحتسب في صنعته الخير ، والرامي به ، والممد به ، وقال : ارموا واركبوا ، ولأن ترموا أحب إلي من أن تركبوا كل ما يلهو به الرجل المسلم باطل إلا رمية بقوسه أو تأديبه فرسه أو ملاعبته أهله فإنهن من الحق ، ومن علم الرمي ثم تركه فهي نعمة كفرها ) )(@)(@@) ( ط حم ت ) حسن ( ك هق ) عن عقبة بن عامر ( ت ) عن عبد الله بن عبد الرحمن بن أبي حسين مرسلا .(@)(@@)(@@)(@@) $ ( 6828 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليلين قلوب رجال فيه حتى تكون ألين من اللبن ، وإن الله عز وجل ليشد قلوب رجال فيه حتى تكون أشد من الحجارة ، وإن مثلك يا أبا بكر كمثل عيسى قال : إن تعذبهم فإنهم عبادك وإن تغفر لهم فإنك أنت العزيز الحكيم ، وإن مثلك يا عمر كمثل موسى قال : { ربنا اطمس على أموالهم واشدد على قلوبهم فلا يؤمنوا حتى يروا العذاب الأليم } أنتم عالة فلا ينفلتن أحد منهم إلا بفداء أو ضربة عنق ، إلا سهيل بن بيضاء ) )(@)(@@) ( حم عق ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6829 ) قال النبي :(@)(@@) | 30 ( إن الله ليبيت القوم بالنعمة ثم يصبحون وأكثرهم بها كافر ، يقولون : مطرنا بنوء كذا وكذا ) )(@)(@@) ابن جرير ( هق ) عن أبي هريرة 
ms742	 رضي الله عنه .(@)(@@) PageV02P494(@)(@@)(@@)(@@) $ ( 6830 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليحمي عبده المؤمن كما يحمي الرعي الشفيق غنمه عن مواضع الهلكة ) )(@)(@@) أبو الشيخ في الثواب عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6831 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليبغض الرجل يدخل عليه في بيته فلا يقاتل ) )(@)(@@) الديلمي عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6832 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليبغض الذين يكنزون البغضاء لاخوانهم في صدورهم ، فإذا لقوهم تخلفوا لهم ) )(@)(@@) الديلمي عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6833 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليبتلي العبد بالرزق لينظر كيف يعمل ، فإن رضي بورك له فيه ، وإن لم يرض لم يبارك له فيه ) )(@)(@@) الديلمي عن عبد الله بن الشخير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6834 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليحمي المؤمن من الدنيا نظرا وشفقة عليه كما يحمي المريض أهله الطعام ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6835 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليرفع ذرية المؤمن إليه حتى يلحقهم في درجته وإن كانوا دونه في العمل لتقر بهم عينه ) )(@)(@@) الديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6836 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليستمع قراءة لم يكن الذين كفروا فيقول : ابشر عبدي فوعزتي لامكنن لك في الجنة حتى ترضى ) )(@)(@@) أبو نعيم في المعرفة من طريق عبد الله بن مسلمة بن أسلم عن ابن شهاب عن إسماعيل بن أبي حكيم المدني ثم أحد بني فضيل وعبد الله ضعفه الدارقطني .(@)(@@)(@@)(@@) $ ( 6837 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليجرب أحدكم بالبلاء وهو أعلم به كما يجرب أحدكم ذهبه بالنار ، فمنهم من يخرج كالذهب الإبريز فذاك الذي حماه الله من الشبهات ، ومنهم من يخرج كالذهب دون ذالك فذاك الذي يشك بعض PageV02P495 الشك ، ومنهم من يخرج كالذهب الأسود فذاك الذي قد افتتن ) )(@)(@@) ( طب ك ) وتعقب عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6838 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليستحي أن يعذب عبده أو أمته إذا أسنا في الإسلام ) )(@)(@@) الخطيب عن جابر رضي الله عنه 
ms743	 .(@)(@@)(@@)(@@) $ ( 6839 ) قال النبي :(@)(@@) | 30 ( إن الله ليستحي أن يعذب الشيخ الكبير ) )(@)(@@) الشيرازي في الألقاب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6840 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليدخل بالسهم الواحد ثلاثة الجنة : صانعه محتسبا به ، والمعين به ، والرامي به في سبيل الله ) )(@)(@@) الخطيب عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6841 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليدرأ بالصدقة سبعين ميتة من السوء ) )(@)(@@) ابن صصرى في أماليه وأبو الشيخ في الثواب وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6842 ) قال النبي :(@)(@@) | 30 ( إن الله ليضحك من إياس العباد وقنوطهم وقرب الرحمة لهم ) )(@)(@@) الخطيب عن عائشة رضي الله عنها .(@)(@@)(@@)(@@) $ ( 6843 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليؤيد الإسلام برجال ما هم من أهله ) )(@)(@@) ( طب ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6844 ) قال النبي :(@)(@@) | 30 ( إن الله ليؤيد الدين بقوم لا خلاق لهم ) )(@)(@@) ابن النجار عن كعب بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6845 ) قال النبي :(@)(@@) | 30 ( إن الله ليؤيد الدين بالرجل الفاجر ) )(@)(@@) ( طب ) عن عمرو بن النعمان بن مقرن رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6846 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليعير العبد يوم القيامة حتى يقول له PageV02P496 جيرانه وأقاربه ومن عرف من الدنيا : يا لك من آدمي عليك لعنة الله ، أبكل هاذا بارزت الله وقد أظهرت في الدنيا علانية حسنة ) )(@)(@@) ابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6847 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليعذب الميت بنياح أهله عليه ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6848 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليعطي على الرفق ما لا يعطي على الخرق ، فإذا أحب الله عبدا أعطاه الرفق ، ما من أهل بيت يحرمون الرفق إلا قد حرموا ) )(@)(@@) ابن أبي الدنيا في ذم الغضب عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6849 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليستحي أن يبسط العبد إليه يديه يسأله فيهما خيرا فيردهما خائبتين ) )(@)(@@) ( حم طب حب ك ) عن سل مان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6850 ) قال النبي :(@)(@@) | 30 ( إن 
ms744	 الله تعالى لينظر إلى عباده كل يوم ثلاثمائة وستين مرة يبدي ويعيد وذالك من حبه لخلقه ) )(@)(@@) الديلمي عن أبي هدبة عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6851 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لينصت للقرآن ويسمعه من أهله ) )(@)(@@) الديلمي عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6852 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليرفع بهاذا القرآن أقواما ويضع به آخرين ) )(@)(@@) ( حب ) عن عمر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6853 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليتجلى للناس عامة ، ويتجلى لأبي بكر خاصة ) )(@)(@@) ابن النجار عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6854 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ملبسك قميصا تريدك أمتي على خلعه فلا تخلعه ) )(@)(@@) ( حم ت ه ) أبو نعيم في فضائل الصحابة عن عائشة رضي الله عنها ، PageV02P497 قاله لعثمان رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6855 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى منع مني بني صالح بنو مدلج بصلتهم الرحم وطعنهم في ألباب البقر ، وفي لفظ : في لبات الإبل ) )(@)(@@) أبو عبيد والخرائطي في مكارم الأخلاق عن زيد بن أسلم مرسلا .(@)(@@)(@@)(@@) $ ( 6856 ) قال النبي :(@)(@@) | 30 ( إن الله هو القيوم إني لأرجو أن أفارقكم حين أفارقكم ولا يطلبني أحد بمظلمة ظلمتها في نفس ولا مال ) )(@)(@@) ( حم ) و الخطيب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6857 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى هو الخالق القابض الرزاق المسعر ، وإني لأرجو أن ألقى الله وليس أحد منكم يطلبني بمظلمة في عرض ولا مال ) )(@)(@@) ( طب ) عن أبي جحيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6858 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل هو الطبيب ولاكنك رجل رفيق ) )(@)(@@) أبو نعيم في الطب عن عبد الملك بن أبحر عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6859 ) قال النبي :(@)(@@) | 30 ( إن الله هو السلام ، فإذا قعد أحدكم في الصلاة فليقل : التحيات والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته ، السلام علينا وعلى عباد الله الصالحين . فإنكم إذا قلتموها أصابت كل عبد لله صالح في السماء والأرض ، أشهد أن لا إلاه إلا الله وأشهد أن محمدا عبده ورسوله ، ثم ليختر من المسألة 
ms745	 ما شاء ) )(@)(@@) ( حم خ م حب ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6860 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل هو السلام ، فإذا سلم أحدكم فلا يقول بين يدي الله شيئا فإن الله هو السلام ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@) PageV02P498(@)(@@)(@@)(@@) $ ( 6861 ) قال النبي :(@)(@@) | 30 ( إن الله وتر يحب الوتر فمن لم يوتر فليس منا ) )(@)(@@) ( عب ) عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 6862 ) قال النبي :(@)(@@) | 30 ( إن الله وعدني أن يدخل الجنة من أمتي أربعمائة ألف ، قال أبو بكر رضي الله عنه : زدنا يا رسول الله ، قال عمر : حسبك يا أبا بكر ، فقال أبو بكر : دعني يا عمر ، وما عليك أن يدخلنا الله الجنة كلنا ، فقال عمر : إن الله عز وجل إن شاء أدخل خلقه الجنة بكف واحد ، فقال رسول الله : صدق عمر ) )(@)(@@) ( حم ع ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6863 ) قال النبي :(@)(@@) | 30 ( إن الله وعدني أن يدخل الجنة من أمتي سبعين ألفا بغير حساب ، ويشفع كل ألف بسبعين ألفا ، ثم يحثي في ثلاث حثيات بكفه إن ذالك إن شاء الله يستوعب مهاجري أمتي ويوفي بشيء من أعرابنا ) )(@)(@@) ( حم ) عن أبي هريرة ( ت ه ) عن أبي أمامة البغوي عن أبي سعيد الزرقي رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6864 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى وعدني أن يدخل من أمتي ثلاثمائة ألف الجنة ) )(@)(@@) ( طب ) عن أبي بكر بن عمير عن أبيه .(@)(@@)(@@)(@@) $ ( 6865 ) قال النبي :(@)(@@) | 30 ( إن الله وعدني فارس ثم الروم نساءهم وأبناءهم ولأمتهم وكنوزهم ، وأمدني بحمير أعوانا ) )(@)(@@) نعيم بن حماد في الفتن عن صفوان بن عمرو رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6866 ) قال النبي :(@)(@@) | 30 ( إن الله وضع شطر الصلاة عن المسافر ، ووضع الصوم عن المسافر وعن المرضع وعن الحبلى ) )(@)(@@) ( عب حم ) و عبد بن حميد ( د ت ) حسن ( ن ه ) والبغوي وابن خزيمة والطحاوي والباوردي وابن قانع ( طب هق ض ) عن أنس بن مالك الكعبي قال ( ت ) والبغوي ولا يعرف له غير هاذا الحديث .(@)(@@) PageV02P499(@)(@@)(@@)(@@) $ ( 6867 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل وضع 
ms746	 عن المسافر نصف الصلاة والصوم ) )(@)(@@) ( طب ) عن أبي أميمة الضمري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6868 ) قال النبي :(@)(@@) | 30 ( إن الله وملائكته يصلوننعلى الذين يصلون الصفوف ، وما بين الفرد والجماعة خمس وعشرون درجة ) )(@)(@@) ( طس ) عن عبد الله بن زيد بن عاصم رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6869 ) قال النبي :(@)(@@) | 30 ( إن الله وملائكته يصلون على الصف المقدم ) )(@)(@@) ( عب ) عن أبي صالح وعن ابن ربيعة مرسلا ( ش ) عن البراء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6870 ) قال النبي :(@)(@@) | 30 ( إن الله لا يحب هاذا وضربه ، يلوون ألسنتهم للناس لي البقر لسانها بالمرعى ، كذالك يلوي الله ألسنتهم ووجوههم في جهنم ) )(@)(@@) ( طب هب ) و أبو نصر السجزي في الإبانة وقال محفوظ صالح الإسناد وابن عساكر عن واثلة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6871 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لا يحب الفاحش ولا المتفحش ، والذي نفس محمد بيده ، لا تقوم الساعة حتى يظهر الفحش والتفحش وسوء الجوار ، وقطيعة الأرحام ، وحتى يخون الأمين ويؤتمن الخائن ) )(@)(@@) ( ك ) عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6872 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لا يدخل شيئا من الكبر الجنة ، فقال قائل : إني أحب أن أتجمل بجلاد سوطي وشسع نعلي ، قال : إن ذاك ليس من الكبر ، إن الله جميل يحب الجمال ، إنما الكبر من سفه الحق وغمض الناس بعينه ) )(@)(@@) البغوي عن أبي ريحانة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6873 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لا يرضى فعل عبد حتى يرضى قوله ) )(@)(@@) الديلمي عن أنس رضي الله عنه .(@)(@@) PageV02P500(@)(@@)(@@)(@@) $ ( 6874 ) قال النبي :(@)(@@) | 30 ( إن الله لا يستحي من الحق أما أنا فإذا فعلت كذا وكذا فأغسل من ذالك فرجي ، وأتوضا وضوئي للصلاة ، ثم ذكر الغسل ، وأما الماء يكون بعد الماء فذالك المذي ما أقرب بيتي من المسجد ، ولأن أصلي في بيتي أحب إلي من أن أصلي في المسجد إلا أن تكون صلاة مكتوبة ، وأما مؤاكلة الحائض فواكلها ) )(@)(@@) ( حم ) و ابن خزيمة ( هق ض ) عن حرام بن حكيم عن عمه عبد الله بن سعد الأنصاري رضي الله عنه وروى 
ms747	 بعضه ( د ت ) .(@)(@@)(@@)(@@) $ ( 6875 ) قال النبي :(@)(@@) | 30 ( إن الله لا يستحي من الحق لا تأتوا النساء في أعجازهن ) )(@)(@@) ( طب ) عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6876 ) قال النبي :(@)(@@) | 30 ( إن الله لا يستحيي من الحق ، لا يحل لأحد أن يأتي النساء في أدبارهن ) )(@)(@@) ( طب ) عن خزيمة بن ثابت الأنصاري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6877 ) قال النبي :(@)(@@) | 30 ( إن الله لا يستحيي من الحق ، لا يحل أن تأتوا النساء في أدبارهن ) )(@)(@@) ( كر ) عن خزيمة بن ثابت رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6878 ) قال النبي :(@)(@@) | 30 ( إن الله لا يصنع بشقاء أختك شيئا فلتركب ولتختمر ولتصم ثلاثة أيام ) )(@)(@@) ( ت ) حسن ( د ن ه حم هق ) عن عقبة بن عامر قال : قلت : يا رسول الله إن أختي نذرت أن تمشي إلى البيت حافية غير مختمرة قال فذكره .(@)(@@)(@@)(@@) $ ( 6879 ) قال النبي :(@)(@@) | 30 ( إن الله لا يصنع بشقاء أختك شيئا لتخرج راكبة ولتكفر عن يمينها ) )(@)(@@) ( حم ك هق ) عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6880 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لا يقبض العلم انتزاعا ينتزعه من PageV02P501 الناس ، ولاكن يقبض العلم بقبض العلماء ، حتى إذا لم يترك عالما اتخذ الناس رؤساء جهالا فسئلوا فأفتوا بغير علم فضلوا وأضلوا ) )(@)(@@) ( خ م حم ت ه و الدارمي ) عن ابن عمرو رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6881 ) قال النبي :(@)(@@) | 30 ( إن الله لا يحب كل فاحش متفحش ) )(@)(@@) ( حم طب ض ) عن أسامة بن زيد رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6882 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لا يقبل لصاحب بدعة صوما ولا صلاة ولا صدقة ولا حجا ولا عمرة ولا جهادا ولا صرفا ولا عدلا يخرج من الإسلام كما تخرج الشعرة من العجين ) )(@)(@@) ( ه ) و الديلمي عن حذيفة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6883 ) قال النبي :(@)(@@) | 30 ( إن الله لا يقبل يوم القيامة من الصقور صرفا ولا عدلا ، قيل : وما الصقور يا رسول الله ؟ قال : الذي يدخل على أهله الرجال ) )(@)(@@) ( خ ) في التاريخ و الخرائطي في مساويء الأخلاق ( طب ) وأبو نعيم ( هب ) وابن عساكر عن 
ms748	 مالك بن أحمر الجذامي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6884 ) قال النبي :(@)(@@) | 30 ( إن الله لا يقدس قوما لا يعطى الضعيف منهم حقه ) )(@)(@@) ( ه ) عن أبي سعيد الخدري رضي الله عنه وابن سعد عن يحيى بن جعدة مرسلا .(@)(@@)(@@)(@@) $ ( 6885 ) قال النبي :(@)(@@) | 30 ( إن الله لا يؤاخذ المزاح الصادق في مزاحه ) )(@)(@@) ابن عساكر عن عائشة رضي الله عنها وقال إسناده منقطع الديلمي عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6886 ) قال النبي :(@)(@@) | 30 ( إن الله لا ينظر إلى أجسامكم ولا إلى أموالكم ولاكن ينظر إلى قلوبكم ، فمن كان له قلب صالح تحنن الله عليه ، وإنما أنتم بنو آدم PageV02P502 وأحبكم إلي أتقاكم ) )(@)(@@) ( حم ه ) عن أبي هريرة ( طب ) عن أبي مالك الأشعري رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6887 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى لا ينظر إلى صوركم ولا إلى أموالكم ، ولاكن ينظر إلى قلوبكم وأعمالكم ، فمن كان له قلب صالح تحنن الله عليه ) )(@)(@@) الحكيم عن يحيى بن أبي كثير مرسلا .(@)(@@)(@@)(@@) $ ( 6888 ) قال النبي :(@)(@@) | 30 ( إن الله لا ينظر إلى المسبل يوم القيامة ) )(@)(@@) ( حم ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6889 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل لا ينظر في صلاة عبد لا يباشر بكفيه الأرض ) )(@)(@@) الديلمي عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ 6890 قال النبي :(@)(@@) | 30 ( إن الله لا ييسر لعبد إلا بالرضى فإذا رضي عنه أطلق له الحجج ) )(@)(@@) ابن النجار عن المقداد بن الأسود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6891 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يأمر بالكافر السخي إلى جهنم ، فيقول لمالك خازن جهنم عذبه وخفض عنه العذاب على قدر سخائه الذي كان في دار الدنيا ) )(@)(@@) أبو الشيخ في الثواب والديلمي عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6892 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يباهي بالمتقلد بسيفه في سبيل الله ملائكته وهم يصلون عليه ما دام متقلده ) )(@)(@@) الخطيب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6893 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يباهي بأهل عرفات ملائكته أهل السماء فيقول لهم : انظروا إلى عبادي هاؤلاء جاؤوني شعثا غبرا 
ms749	 ) )(@)(@@) ( حب ك هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6894 ) قال النبي :(@)(@@) | 30 ( إن الله يباهي ملائكته عشية عرفة بالحجاج فيقول : PageV02P503 انظروهم شعثا غبرا ، أشهدكم أني قد غفرت لهم ) )(@)(@@) ابن النجار عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6895 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يبعث الملائكة يوم الجمعة على أبواب المساجد يكتبون القوم : الأول والثاني والثالث والرابع والخامس والسادس ، فإذا بلغوا السابع كانوا بمنزلة من قرب العصافير ) )(@)(@@) ( طب ) عن واثلة رضي الله عنه ( ز ) .(@)(@@)(@@)(@@) $ ( 6896 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يبعث يوم القيامة مناديا ينادي : يا آدم إن الله يأمرك أن تبعث بعثا من ذريتك إلى النار ، فيقول آدم : يا رب ومن كم ؟ قال : فيقال له : من كل مائة تسعة وتسعين ، فقال رجل : من هاذا الناجي منا بعد هاذا يا رسول الله ؟ قال : هل تدرون ما أنتم في الناس إلا كالشامة في صدر البعير ) )(@)(@@) ( حم ) عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6897 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يبعث يوم القيامة مناديا ينادي يا أهل الجنة ، يقول : يسمع أولهم وآخرهم إن الله تعالى وعدكم الحسنى وزيادة ، فالحسنى الجنة والزيادة النظر إلى وجه الرحمان ) )(@)(@@) ابن جرير عن أبي موس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6898 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يبغض الآكل فوق شبعه ، والغافل عن طاعة ربه ، والتارك سنة نبيه ، والمخفر ذمته ، والمبغض عترته ، والمؤذي جيرانه ) )(@)(@@) الديلمي عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6899 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يبغض صوت الخلخال كما بغض الغناء ، يعاقب صاحبه كما يعاقب الزامر ولا يلبس خلخالا ذات صوت إلا ملعونة ) )(@)(@@) الديلمي عن أبي أمامة رضي الله عنه .(@)(@@) PageV02P504(@)(@@)(@@)(@@) $ ( 6900 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يبغض الفاحش البذيء ) )(@)(@@) ( طب ت ) و الخرائطي في مساوىء الأخلاق عن أبي الدرداء رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6901 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يجمع الأمم يوم القيامة ثم ينزل من عرشه إلى كرسيه ، وكرسيه وسع السماوات والأرض ) )(@)(@@) ( طب ) عن ابن مسعود رضي الله عنه 
ms750	 .(@)(@@)(@@)(@@) $ ( 6902 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يحب ثلاثة ويبغض ثلاثة ، يبغض الشيخ الزاني ، والفقير المختال ، والمكثر البخيل ، ويحب ثلاثة : رجل كان في كتيبة فكر يحميهم حتى قتل أو يفتح الله عليه ، ورجل كان في قوم فأدلجوا فنزلوا من آخر الليل فكان النوم أحب إليهم مما يعدل به فناموا وقام يتلو آياتي ويتملقني ، ورجل كان في قوم فأتاهم رجل يسألهم بقرابة بينهم وبينه فبخلوا عنه وخلف بأعقابهم فأعطاه حيث لا يراه إلا الله ومن أعطاه ) )(@)(@@) ( حم ) واللفظ له حب ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6903 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يحب ثلاثة ويبغض ثلاثة ، رجل غزا في سبيل الله صابرا محتسبا فقاتل حتى قتل ، ورجل كان له جار سوء يؤذيه فيصبر على أذاه ويحتسبه حتى يكفيه الله إياه بحياة أو موت ، ورجل سافر مع قوم فارتحلوا حتى إذا كانوا من آخر الليل وقع عليهم الكرى فنزلوا فضربوا برؤسهم ثم قام فتطهر وصلى رهبة لله ورغبة فيما عنده ، والثلاثة الذين يبغضهم الله : البخيل المنان ، والمخنال الفخور ، والتاجر الحلاف ) )(@)(@@) ( ط طب ك هق ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6904 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يحب أن يؤخذ برخصه كما يحب أن يؤخذ بعزائمه ، إن الله بعثني بالحنيفية السمحة دين إبراهيم ) )(@)(@@) ابن عساكر عن علي رضي الله عنه .(@)(@@) PageV02P505(@)(@@)(@@)(@@) $ ( 6905 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل رفيق يحب الرفق ويرضاه ويعطي عليه ما لا يعطي على العنف ) )(@)(@@) ( طب ) عن أبي أمامة ( م ) عن عائشة و ( د ) عن عبد الله بن مغفل رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6906 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يحب أن يرى أثر نعمته على عبده ، ويبغض البؤس والتباؤس ) )(@)(@@) سمويد عن أبي سعيد رضي الله عنه و ( ت حم ) عن عمرو بن شعيب عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6907 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يحب من يحب التمر ) )(@)(@@) ( طب عد ) و الخطيب عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6908 ) قال النبي :(@)(@@) | 30 
ms751	 ( إن الله تعالى يحب أن تعدلوا بين أولادكم ) )(@)(@@) ( ن ت طب ) عن النعمان بن بشير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6909 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يحب إذا عمل العبد عملا أن يحكمه ) )(@)(@@) ابن أبي داود في المصاحف وابن النجار عن عائشة رضي الله عنها وفيه مصعب بن ثابت ضعيف .(@)(@@)(@@)(@@) $ ( 6910 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يحب عبده المؤمن إذا كان فقيرا متعففا ) )(@)(@@) ( طب ) عن عمران بن حصين رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6911 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يحب أن يرى أثر نعمته على عبده ، ويكره البؤس والتباؤس ، ويحب الحيي الحليم العفيف المتعفف من عباده ، ويبغض الفاحش البذيء المسائل الملحف ) )(@)(@@) ابن صصرى في أماليه عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6912 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يحب العطاس ويكره التثاؤب ، فإذا PageV02P506 تثاءب أحدكم فليكظم ما استطاع أو ليضع يده على فيه ، فإنه إذا تثاءب فقال آه فإنما هو الشيطان يضحك من جوفه ) )(@)(@@) ( حب ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6913 ) قال النبي :(@)(@@) | 30 ( إن الله يبسط يده بالليل ليتوب مسيء النهار ، ويبسط يده بالنهار ليتوب مسيء الليل حتى تطلع الشمس من مغربها ) )(@)(@@) ( م حم ) واللفظ لهما . و أبو الشيخ في العظمة ( هق ) في الأسماء عن أبي موسى ا رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6914 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يرفع ويخفض ، ولاكني لأرجو أن ألقى الله عز وجل وليس لأحد عندي مظلمة ) )(@)(@@) ( حم ) عن أبي هريرة أن رجلا قال : يا رسول الله سعر قال فذكره .(@)(@@)(@@)(@@) $ ( 6915 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يدخل بالسهم الواحد ثلاثة نفر الجنة : صانعه يحتسب في صنعته الخير ، والرامي به ، ومنبله ، وارمو واركبوا ، وأن ترموا أحب إلي من أن تركبوا ، ليس من اللهو إلا ثلاث : تأديب الرجل فرسه وملاعبته أهله ، ورميه بقوسه ونبله ، ومن ترك الرمي بعد ما علمه رغبة فنه فإنها نعمة تركها ) )(@)(@@) ( د ن ) عن عقبة بن عامر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6916 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يستحيي أن 
ms752	 يغفر لقوم وفيهم رجل ليس منهم إلا غفر له معهم ) )(@)(@@) أبو الشيخ في الثواب عن أبي سعيد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6917 ) قال النبي :(@)(@@) | 30 ( إن الله يستحيي من عبده وأمته يشيبان في الإسلام أن يعذبهما ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6918 ) قال النبي :(@)(@@) | 30 ( إن الله يعرض على عبده في كل يوم نصيحة ، فإن هو قبلها سعد ، وإن تركها شقي ، فإن الله باسط يده بالليل لمسيء النهار ليتوب ، PageV02P507 فإن تاب تاب الله عليه ، وباسط يده بالنهار لمسيء الليل ، فإن تاب تاب الله عليه ، وإن الحق ثقيل كثقله يوم القيامة ، وإن الباطل خفيف كخفته يوم القيامة ، وإن الجنة محظور عليها بالمكاره ، وإن النار محظور عليها بالشهوات ) )(@)(@@) ابن عساكر وابن شاهين عن ابن جريج عن الزهري مرسلا ( طس ) عن ابن جريج عن عطاء عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6919 ) قال النبي :(@)(@@) | 30 ( إن الله ليعطي على الرفق ما لا يعطي على العنف ) )(@)(@@) رواه ( م ) عنك عن عائشة و ( حم ) عن علي و ( طب ) عن جرير رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6920 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ليعطي على الرفق ما لا يعطي على الخرق ، وإذا أحب الله عبدا أعطاه الرفق ، ما من أهل بيت يحرمون الرفق إلا قد حرموا ) )(@)(@@) ( طب ) عن جرير رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6921 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يعطي الدنيا على نية الآخرة ، وأبى أن يعطي الآخرة على نية الدنيا ) )(@)(@@) ابن المبارك والديلمي وابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6922 ) قال النبي :(@)(@@) | 30 ( إن الله يعلم أن أحدكما كاذب فهل منكما تائب ، قاله للمتلاعنين ) )(@)(@@) ( خ د ه ت م ) عن ابن عمر ( خ ) عن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6923 ) قال النبي :(@)(@@) | 30 ( إن الله يغفر في أول ليلة من شهر رمضان لكل أهل هاذه القبيلة ) )(@)(@@) ( ع ) و ابن خزيمة ( ض ) عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6924 ) قال النبي :(@)(@@) | 30 ( إن الله يعفر في ليلة النصف من شعبان لجميع أهل الأرض إلا المشرك أو المشاحن ) )(@)(@@) ( هب 
ms753	 ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV02P508(@)(@@)(@@)(@@) $ ( 6925 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يغفر ليلة النصف من شعبان للمسلمين ويملي للكافرين ، ويدع أهل الحقد بحقدهم ) )(@)(@@) ابن قانع عن أبي ثعلبة الخشني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6926 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يغفر لعبده ما لم يقع الحجاب ، قيل : وما وقوع الحجاب ؟ قال : تخرج النفس وهي مشركة ) )(@)(@@) ( حم خ ) في التاريخ ( ع حب ) و البغوي في الجعديات ( ك ض ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6927 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يفتح أبواب سماء الدنيا ثم يبسط يده : ألا عبد يسألني فاعطيه ، فلا يزال كذالك حتى يسطع الفجر ) )(@)(@@) ابن عساكر عن ابن مسعود رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6928 ) قال النبي :(@)(@@) | 30 ( إن الله يقبل توبة العبد قبل أن يموت بيوم ) )(@)(@@) ( حم ) عن رجل .(@)(@@)(@@)(@@) $ ( 6929 ) قال النبي :(@)(@@) | 30 ( إن الله يقبل توبة العبد قبل أن يموت بنصف يوم ) )(@)(@@) ( حم ) عن رجل .(@)(@@)(@@)(@@) $ ( 6930 ) قال النبي :(@)(@@) | 30 ( إن الله يقبل توبة العبد قبل أن يموت بضحوة ) )(@)(@@) ( حم ) عن رجل .(@)(@@)(@@)(@@) $ ( 6931 ) قال النبي :(@)(@@) | 30 ( إن الله يقبل توبة العبد ما لم يغرغر بنفسه ) )(@)(@@) ( حم ) عن رجل .(@)(@@)(@@)(@@) $ ( 6932 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يقول : لا إلاه إلا أنا ، خلقت الخير وقدرته ، فطوبى لمن خلقته للخير ، وخلقت الخير له وأجريت الخير على يديه ، أنا الله لا إلاه إلا أنا خلقت الشر وقدرته فويل لمن خلقته للشر وخلقت الشر له وأجريت الشر على يديه ) )(@)(@@) ابن النجار عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6933 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يقول : يا عبادي كلكم ضال إلا من PageV02P509 هديت ، وضعيف إلا من قويت ، وفقير إلا من أغنيت ، فسلوني أعطكم ، فلو أن أولكم وآخركم وجنكم وإنسكم وحيكم وميتكم ورطبكم ويابسكم اجتمعوا على قلب أتقى عبد من عبادي ما زاد في ملكي جناح بعوضة ، ولو أن أولكم وآخركم وحيكم وميتكم ورطبكم ويابسكم اجتمعوا على قلب أفجر عبد هو لي ما نقصوا من ملكي جناح بعوضة ، ذالك 
ms754	 أناي واحد ، عذابي كلام ، ورحمتي كلام ، فمن أيقن بقدرتي على المغفرة لم يتعاظم في نفس أني أغفر له ذنوبه وإن كثرت ) )(@)(@@) ( طب ) عن أبي موسى ا رضي الله عنه .(@)(@@) PageV02P510(@)(@@)(@@)(@@) $ ( 6934 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : يا أيها الناس إنا خلقناكم من ذكر وأنثى وجعلناكم شعوبا وقبائل لتعارفوا إن أكرمكم عند الله أتقاكم ، فليس لعربي على عجمي فضل ، ولا لعجمي على عربي فضل ولا لأسود على أبيض فضل ، ولا لأبيض على أسود فضل إلا بالتقوى ، يا معشر قريش لا تجيئوا بالدنيا تحملونها على أعناقكم ، وتجيء الناس بالآخرة ، فإني لا أغني عنكم من الله شيئا ) )(@)(@@) ( طب ) عن العداء بن خالد رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6935 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : يا عبدي ما عبدتني ورجوتني فإني غافر لك على ما كان فيك ، ويا عبدي إن لقيتني بقراب الأرض خطيئة ما لم تشرك بي لقيتك بقرابها مغفرة ) )(@)(@@) ( حم ) عن أبي ذر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6936 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : أحب عبادة عبدي إلي النصيحة ) )(@)(@@) ابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6937 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يقول : أنا عند ظن عبدي بي ، إن ظن خيرا فخير ، وإن ظن شرا فشر ) )(@)(@@) ( حم ) عن أبي هريرة ( طب حل ) وابن عساكر عن واثل رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6938 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : يا ابن آدم قد أنعمت عليك PageV03P005 نعما عظاما لا تحصي عددها ، ولا تطيق شكرها ، وإن مما أنعمت عليك أن جعلت لك عينين تنظر بهما وجعلت لهما غطاء فانظر بعينيك إلى ما أحللت لك ، فإن رأيت ما حرمت عليك فأطبق عليهما غطاءهما منهما ، وجعلت لك لسانا وجعلت له غلافا ، فانطق بما أمرتك وأحللت لك ، فإن عرض لك ما حرمت عليك فاغلق عليك لسانك وجعلت لك فرجا ، وجعلت لك سترا فأصب بفرجك ما أحللت ، فإن عرض لك ما حرمت عليك فارخ عليك سترك ، ابن آدم إنك لا تحمل سخطي ، ولا تطيق انتقامي ) )(@)(@@) ابن عساكر 
ms755	 عن مكحول مرسلا .(@)(@@)(@@)(@@) $ ( 6939 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : ثلاث خلال غيبتهن عن عبادي ، لو رآهن رجل ما عمل سوءا أبدا ، لو كشفت غطائي فرآني حتى يستيقن ويعلم كيف أفعل بخلقي إذا أمتهم وقبضت السماوات بيدي ، ثم قبضت الأرض ثم الأرضين ، ثم قلت أنا الملك من ذا الذي له الملك دوني ، ثم أريهم الجنة وما أعددت لهم فيها من كل خير فيستيقنونها وأريهم النار وما أعددت لهم فيها من كل شر فيستيقنونها ، ولاكن عمدا غيبت ذالك عنهم لأعلم كيف يعملون ، وقد بينته لهم ) )(@)(@@) ( طب ) و أبو الشيخ في العظمة عن أبي مالك الأشعري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6940 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يقول : يا ابن آدم إذا أخذت منك كريمتيك فصبرت واحتسبت عند الصدمة الأولى ، لم أرض لك بثواب دون الجنة ) )(@)(@@) ( حم طب ت ) و ابن السني في عمل يوم وليلة وابن عساكر عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6941 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : أنا خير شريك ، فمن أشرك معي شيئا فهو لشريكي ) )(@)(@@) البغوي ( قط ) وابن عساكر ( ض ) عن الضحاك بن قيس الفهري رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6942 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : أنا خير شريك ، فمن أشرك معي شيئا فهو لشريكي ، يا أيها الناس أخلصوا أعمالكم لله ، فإن الله لا يقبل من PageV03P006 الأعمال إلا ما خلص له ، ولا تقولوا هاذا لله وللرحم فإنه للرحم وليس لله منه شيء ) )(@)(@@) الخطيب في المتفق والمفترق عنه .(@)(@@)(@@)(@@) $ ( 6943 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : إن عبدي كل عبدي الذي يذكرني وهو ملاق قرنه ، يعني : عند القتال ) )(@)(@@) ابن سعد ( ت ) وضعفه ( طب هب ) عن عمارة بن زعكرة المازني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6944 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : إن عبدا أصححت له جسمه ، وأوسعت عليه في الرزق ، فأتى عليه خمس حجج لا يأتي إلي فيهن لمحروم ) )(@)(@@) ( ع ) عن خباب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6945 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول للملائكة انطلقوا إلى عبدي 
ms756	 فصبوا عليه البلاء ، فيأتونه فيصبون عليه البلاء فيحمد الله ، فيرجعون فيقولون : يا ربنا صببنا عليه البلاء صبا كما أمرتنا ، فيقول : ارجعوا فإني أحب أن أسمع صوته ) )(@)(@@) ( طب هب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6946 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : من أهان لي وليا فقد بارزني بالعداوة ، ابن آدم لم تدرك ما عندي إلا بأداء ما افترضت عليك ، ولا يزال عبدي يتقرب إلي بالنوافل حتى أحبه فأكون أنا سمعه الذي يسمع به ، وبصره الذي يبصر به ، ولسانه الذي ينطق به ، وقلبه الذي يعقل به ، فإذا دعاني أجبته ، وإذا سألني أعطيته ، وإذا استنصرني نصرته ، وأحب ما تعبدني عبدي به النصح لي ) )(@)(@@) ( طب ) و أبو نعيم في الطب عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6947 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول يوم القيامة لآدم : قم فجهز من ذريتك تسعمائة وتسعة وتسعين إلى النار وواحدا إلى الجنة ، فبكى أصحابه وبكوا ثم قال رسول الله : ارفعوا رؤوسكم فوالذي نفسي بيده ، ما أمتي في الأمم إلا كالشعرة البيضاء في جلد الثور الأسود فخفف ذالك عنهم ) )(@)(@@) ( حم ) عن أبي الدرداء PageV03P007 رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6948 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : هي ناري أسلطها على عبدي المؤمن لتكون حظه من النار في الآخرة ، يعني : الحمى ) )(@)(@@) ( هق ) عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6949 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يقول : أنا أرجف الأرض بعبادي في خير كتابي ، فمن قبضت فيها من المؤمنين كانت له رحمة ، وكانت آجالهم التي كتبت عليهم ، ومن قبضت من الكفار كانت عذابا لهم وكانت آجالهم التي كتبت عليهم ) )(@)(@@) نعيم بن حماد في الفتن عن عروة بن روم مرسلا .(@)(@@)(@@)(@@) $ ( 6950 ) قال النبي :(@)(@@) | 30 ( إن الله يلحظ إلى الكعبة في كل عام لحظة وذالك ليلة النصف من شعبان ، فعند ذالك تحن إليها قلوب المؤمنين ) )(@)(@@) الديلمي عن عائشة وعن ابن عباس رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6951 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ليلوم على العجز فأنل من نفسك الجهد ، فإن غلبت فقل 
ms757	 : توكلت على الله ، حسبي الله ونعم الوكيل ) )(@)(@@) ( حم د طب ) عن أبي أمامة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6952 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يلوم على العجز ، ولاكن عليك بالكيس ، فإذا غلبك امر ( ؤ ) فقل : حسبي الله ونعم الوكيل ) )(@)(@@) ( د طب ) و ابن السني في عمل يوم وليلة ( هق ) عن عوف بن مالك رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6953 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى يمسخ خلقا كثيرا وإن الإنسان يخلو بمعصيته فيقول الله تعالى : استهانة بي فيمسخه ، ثم يبعثه يوم القيامة إنسانا ، يقول : كما بدأكم تعودون ثم يدخله النار ) )(@)(@@) ( خ ) في الضعفاء عن عبد الغفور بن عبد العزيز بن سعيد الأنصاري عن أبيه عن جده .(@)(@@)(@@)(@@) $ ( 6954 ) قال النبي :(@)(@@) | 30 ( إن الله يمهل ، حتى إذا ذهب من الليل نصفه أو PageV03P008 ثلثاه قال : لا تسألن عبادي غيري ، من يسألني أستجيب له ، من يسألني أعطيه ، من يستغفرني أغفر له ، حتى يطلع الفجر ) )(@)(@@) ( ه ) عن رفاعة الجهني رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6955 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ينادي يوم القيامة أين جيراني ؟ أين جيراني فتقول الملائكة ؟ ربنا من ينبغي له أن يجاورك ، فيقول : أين عمار المساجد ؟ ) )(@)(@@) ابن النجار عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6956 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ينادي يوم القيامة بصوت رفيع غير قطيع ، يا عبادي ، أنا الله لا إلاه إلا أنا أرحم الراحمين ، وأحكم الحاكمين ، وأسرع الحاسبين ، يا عبادي لا خوف عليكم اليوم ولا أنتم تحزنون ، فأحضروا حجتكم ويسروا جوابا فإنكم مسؤولون محاسبون ، يا ملائكتي أقيموا عبادي صفوفا على أطراف أنامل أقدامهم للحساب ) )(@)(@@) الديلمي عن معاذ رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6957 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل ينزل الرزق على قدر المؤونة ، وينزل الصبر على قدر البلاء ) )(@)(@@) ابن لال في مكارم الأخلاق عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6958 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ينزل في كل يوم مائة رحمة : ستين منها للطائفين بالبيت ، وعشرين على أهل مكة ، وعشرين على سائر الناس ) )(@)(@@) الخطيب عن ابن عباس رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6959 
ms758	 ) قال النبي :(@)(@@) | 30 ( إن الله تعالى ينظر إلى عباده يوم عرفة فلا يدع أحدا في قلبه مثقال ذرة من الإيمان إلا غفر له ) )(@)(@@) الديلمي عن ابن عمر رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6960 ) قال النبي :(@)(@@) | 30 ( إن الله ينهاكم عن ثلاث : قيل وقال ، وإضاعة المال ، وكثرة السؤال ) )(@)(@@) الخطيب عن المغيرة بن شعبة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6961 ) قال النبي :(@)(@@) | 30 ( إن الله كره لكم ثلاثا : قيل وقال ، وإضاعة المال ، PageV03P009 وكثرة السؤال ) )(@)(@@) رواه ( خ م ) عن المغيرة بن شعبة واللفظ لهما والدارمي والموطا و ( حم ) .(@)(@@)(@@)(@@) $ ( 6962 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يهبط من السماء العليا إلى السماء الدنيا فيقول : هل من سائل ؟ هل من مستغفر ؟ هل من داع ؟ حتى إذا طلع الفجر ارتفع ) )(@)(@@) ( طب ) و البغوي عن أبي الخطاب رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6963 ) قال النبي :(@)(@@) | 30 ( إن الله عز وجل يوحي إلى الحفظة أن لا تكتبوا على صوام عبيدي بعد العصر سيئة ) )(@)(@@) ( ك ) في تاريخه و الخطيب عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6964 ) قال النبي :(@)(@@) | 30 ( إن الأحمق يصيب بحمقه أعظم من فجور الفاجر ، وإنما يقرب الناس الزلف على قدر عقولهم ) )(@)(@@) الحكيم عن أنس رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6965 ) قال النبي :(@)(@@) | 30 ( إن الله يوكل بآكل الخل ملكين يستغفران له حتى يفرغ ) )(@)(@@) ( كر ) عن جابر رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6966 ) قال النبي :(@)(@@) | 30 ( إن الأرض لا ينجسها شيء في دخول المشرك المسجد ) )(@)(@@) عبد الرزاق عن الحسن مرسلا .(@)(@@)(@@)(@@) $ ( 6967 ) قال النبي :(@)(@@) | 30 ( إن الأرض لتقبل من هو شر منه ، ولاكن الله أحب أن يريكم تعظيم حرمة لا إلاه إلا الله ) )(@)(@@) ( ه ) عن عمران بن حصين رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6968 ) قال النبي :(@)(@@) | 30 ( إن الأرض أمرت أن تكفته منا معاشر الأنبياء ، يعني : الغائط ) )(@)(@@) ( ك ) عن ليلى مولاة عائشة رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6969 ) قال النبي :(@)(@@) | 30 ( إن الأرضين بين كل أرض إلى التي تليها مسيرة خمسمائة سنة ، فالعليا منها على ظهر حوت قد التقى طرفاه في سماء الدنيا والحوت PageV03P010 على صخرة ، والصخرة بيد ملك ، والثانية مسكن الريح 
ms759	 ، فلما أراد الله أن يهلك عادا أمر خازن الريح أن يرسل عليهم ريحا تهلك عادا فقال : يا رب أرسل عليهم من الريح قدر منخر الثور ؟ فقال له الجبار تبارك وتعالاى : إذن يكفأ الأرض ومن عليها ، ولاكن أرسل عليهم بقدر خاتم فهي التي قال الله في كتابه : ما تذر من شيء أتت عليه إلا جعلته كالرميم ، والثالثة فيها حجارة جهنم ، والرابعة فيها كبريت جهنم ، قالوا : يا رسول الله أللنار كبريت ؟ قال : نعم ، والذي نفسي بيده ، إن فيها لأودية من كبريت لو أرسل فيها الجبال الرواسي لماعت ، والخامسة فيها حيات جهنم ، إن أفواهها كالأودية تلسع الكافر اللسعة فلا يبقى منه لحم على وضم ، والسادسة فيها عقارب جهنم ، إن أدنى عقربة منها كالبغال الموكفة تلسع إحداهن اللسعة فيجد حموتها أربعين سنة والسابعة سقر وفيها إبليس مصفد بالحديد يد أمامه ويد خلفه ، فإذا أراد الله أن يطلقه لما يشاء من عباده أطلقه ) )(@)(@@) ( ك ) وتعقب عن ابن عمرو رضي الله عنهما .(@)(@@)(@@)(@@) $ ( 6970 ) قال النبي :(@)(@@) | 30 ( إن الأرواح ججنود مجندة ، فما تعارف منها ائتلف ، وما تناكر منها اختلف ) )(@)(@@) ( كر ) في سل مان و ( خ ) عن عائشة و ( م د حم ) عن أبي هريرة رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6971 ) قال النبي :(@)(@@) | 30 ( إن الإسلام يجب ما كان قبله ، وإن الهجرة تجب ما كان قبلها ) )(@)(@@) ( حم طب ) عن عمرو بن العاص رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6972 ) قال النبي :(@)(@@) | 30 ( إن الإسلام بدأ غريبا وسيعود غريبا فطوبى للغرباء ، قالوا : يا رسول الله وما الغرباء ؟ قال : الذين يصلحون عند فساد الناس ) )(@)(@@) ( م جه حم ) عن أبي هريرة و ( م ) عن ابن عمر و ( ت حم جه والدارمي ) عن أبي الأحوص PageV03P011 عن عبد الله بن مسعود و ( حم ) عن سعد بن أبي وقاص و ( جه ) عن أنس بن مالك و ( طب ) عن سهل بن سعد أبو النصر السجزي في الإبانة عن عبد الرحمن بن سنه عن سعد بن أبي وقاص رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6973 ) قال النبي :(@)(@@) | 30 ( إن الإسلام لا يحرز لكم العارية 
ms760	 مؤداة ) )(@)(@@) ( هق ) عن عطاء بن أبي رباح مرسلا .(@)(@@)(@@)(@@) $ ( 6974 ) قال النبي :(@)(@@) | 30 ( إن الإسلام بدأ غريبا وسيعود غريبا ، فطوبى للغرباء بين يدي الساعة ) )(@)(@@) رواه ( م جه ت حم ) مرفوعا ، نعيم بن حماد في الفتن عن مجاهد مرسلا .(@)(@@)(@@)(@@) $ ( 6975 ) قال النبي :(@)(@@) | 30 ( إن الأعمال تعرض يوم الخميس ويوم الجمعة ، فيغفر لكل عبد لا يشرك بالله شيئا إلا رجلين فإنه يقول : أخروا لهاذين حتى يصطلحا ) )(@)(@@) ابن عساكر عن أبي هريرة رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6976 ) قال النبي :(@)(@@) | 30 ( إن الأمة ستغدر بك من بعدي وأنت تعيش على ملتي ، وتقتل على سني ، من أحبك أحبني ، ومن أبغضك أبغضني ، وإن هاذه ستخضب من هاذه ، يعني لحيته من رأسه ) )(@)(@@) ( قط ) في الأفراد ( ك ) و الخطيب عن علي رضي الله عنه .(@)(@@)(@@)(@@) $ ( 6977 ) قال النبي :(@)(@@) | 30 ( إن الأمة قد ألقت فروة رأسها ) )(@)(@@) ( ش ) عن عطاء مرسلا .(@)(@@)(@@)(@@) $ ( 6978 ) قال النبي :(@)(@@) | 30 ( إن الأنبياء يتكاثرون باممهم وقد كثرتهم إلا موسى بن عمران وإني لأرجو أن أكثره ، ولقد أعطي موسى بن عمران خصلات لم يعطهن نبي لله ، إنه مكث يناجي ربه أربعين يوما ، ولا ينبغي لمتناجيين أن يتناجيا أطول من نجواهما وإن ربك توحد بدفنه في قبره فلم يطلع عليه أحد ، وهو يوم يصعق الناس قائم عند العرش لا يصعق معهم ) )(@)(@@) ( طب ) و ابن عساكر عن عوف بن مالك رضي الله عنه .(@)(@@) PageV03P012(@)(@@)(@@)(@@) $ ( 6979 ) قال النبي :(@)(@@) | 30 ( إن الأنصار قوم فيهم غزل فلو أرسلتم من يقول : أتيناكم أتيناكم فحيانا وحياكم ) )(@)(@@) ( هق ) عن عائشة ( جه ) عن ابن عباس و ( حم ) عن جابر رضي الله عنهم .(@)(@@)(@@)(@@) $ ( 6980 ) قال النبي :(@)(@@) | 30 ( إن الإيمان هاهنا ، إن الإيمان هاهنا ، وإن القسوة وغلظ القلوب في الفدادين عند أصول أذناب الإبل حيث يطلع قرنا الشيطان في ربيعة ومضر ) )(@)(@@) ( خ ) عن ابن عمرو وأبي مسعود و ( م حم ع ) وابن عساكر عن أبي مسعود عنه .(@)(@@)(@@)(@@) $ ( 6981 ) قال النبي :(@)(@@) | 30 ( إن الإيمان بدأ غريبا وسيعود كما بدأ ، فطوبى يومئذ للغرباء إذا فسد الناس ، والذي نفس أبي القاسم بيده ليأرز الإيمان بين 