ms277	 د (@)(@@)(@@)(@@) $ 3658 -(@)(@@) عتاب بن المثنى عن مولاه بهز بن حكيم وعنه أحمد بن سعيد الدارمي وعباس العنبري. ت (@)(@@)(@@)(@@) $ 3659 -(@)(@@) عتاب مولى هرمز عن أنس وعنه شعبة وثق. ق PageV01P695(@)(@@)(@@)(@@) $ 3660 -(@)(@@) عتبان بن مالك الخزرجي السالمي بدري عنه أنس بن مالك ومحمود بن الربيع توفي زمن معاوية. خ م س ق (@)(@@)(@@)(@@) $ 3661 -(@)(@@) عتبة بن أبي حكيم عن مكحول وعبادة بن نسي وطائفة وعنه يحيى بن حمزة وابن شابور وابن المبارك مختلف في توثيقه وقال أبو حاتم: صالح الحديث مات بصور 147. 4 (@)(@@)(@@)(@@) $ 3662 -(@)(@@) عتبة بن حماد أبو خليد الدمشقي القارئ عن الأوزاعي وطائفة وعنه هشام الأزرق وأيوب ابن محمد الوزان حكى العباس بن الوليد البيروتي عنه: أنه قرأ " الموطأ " على مالك في أربعة أيام فالله أعلم!. ق (@)(@@)(@@)(@@) $ 3663 -(@)(@@) عتبة بن حميد الضبي عن عكرمة وطائفة وعنه أبو معاوية وابن عيينة وطائفة ضعفه أحمد. د ت ق (@)(@@)(@@)(@@) $ 3664 -(@)(@@) عتبة بن عبد الله أبو العميس المسعودي أخو عبد الرحمن المسعودي الكوفي عن الشعبي وابن أبي مليكة والطبقة وعنه شعبة وأبو نعيم وطائفة وثقه أحمد. ع (@)(@@)(@@)(@@) $ 3665 -(@)(@@) عتبة بن عبد الله اليحمدي المروزي عن مالك وجماعة وعنه النسائي وابن خزيمة والحسن بن سفيان وثقه النسائي مات 244. س (@)(@@)(@@)(@@) $ 3666 -(@)(@@) عتبة بن عبد الله عن أسماء بنت عميس وعنه عبد الحميد بن جعفر لا يعرف. ت PageV01P696(@)(@@)(@@)(@@) $ 3667 -(@)(@@) عتبة بن عبد الملك عن زرارة بن كريم وغيره وعنه عبد الصمد بن عبد الوارث ويعقوب الحضرمي وثق. د (@)(@@)(@@)(@@) $ 3668 -(@)(@@) عتبة بن عبد السلمي أبو الوليد له صحبة ورواية وعنه خالد بن معدان و عبد الله بن ناسح وجماعة مات سنة 87. د ق(@)(@@)(@@)(@@) $ 3669 -(@)(@@) عتبة بن غزوان المازني بدري جليل أسلم بعد ستة رجال وكان من الرماة المذكورين وهو الذي اختط البصرة مات على المشهور في سنة 17 وله سبع وخمسون سنة روى عنه خالد بن عمير وجماعة. م ت س ق (@)(@@)(@@)(@@) $ 3670 -(@)(@@) عتبة بن فرقد السلمي صحابي نزل الكوفة وعنه قيس بن أبي حازم والشعبي. س (@)(@@)(@@)(@@) $ 3671 -(@)(@@) عتبة بن محمد 
ms278	 بن الحارث بن نوفل عن ابن عباس وجماعة وعنه ابن جريج وجماعة وثق.(@)(@@) د س (@)(@@)(@@)(@@) $ 3672 -(@)(@@) عتبة بن أبي عتبة مسلم عن جماعة منهم عبيد بن حنين وعنه إسماعيل بن جعفر وسليمان بن بلال صدوق. خ م د ق (@)(@@)(@@)(@@) $ 3673 -(@)(@@) عتبة بن الندر السلمي صحابي نزل دمشق عنه خالد بن معدان الحمصي وعلي بن رباح. ق (@)(@@)(@@)(@@) $ 3674 -(@)(@@) عتبة بن يقظان عن الحسن والشعبي وطائفة وعنه عبد الله بن نمير وأبو يحيى الحماني عبد الحميد وثقه بعضهم وقال النسائي: غير ثقة. ق (@)(@@)(@@)(@@) $ 3675 -(@)(@@) عتي بن ضمرة السعدي عن أبي بن كعب وابن مسعود وعنه ابنه والحسن. ت س ق (@)(@@)(@@)(@@) $ 3676 -(@)(@@) عتيك بن الحارث بن عتيك الأنصاري عن عمه جابر وعنه سبطه عبد الله بن عبد الله شيخ مالك. د س (@)(@@)(@@)(@@) $ 3677 -(@)(@@) عثام بن علي الكلابي الكوفي عن هشام بن عروة وطبقته وعنه علي بن حرب وأحمد بن بديل وطائفة وثقه أبو زرعة الرازي مات 195. خ 4. PageV01P697(@)(@@)(@@)(@@) $ 3678 -(@)(@@) عثمان بن إسحاق، عن قبيصة بن ذؤيب في ميراث الجدة، وعنه الزهري وحده. 4.(@)(@@)(@@)(@@) $ 3679 -(@)(@@) عثمان بن إسماعيل الدمشقي، عن الوليد، ومروان بن معاوية، وعنه ابن ماجة، ومحمد بن خريم، والحسن بن سفيان. ق.(@)(@@)(@@)(@@) $ 3680 -(@)(@@) عثمان بن الأسود الجمحي المكي، عن أبيه، وسعيد بن جبير، وطائفة، وعنه يحيى القطان، وأبو عاصم، مات 150. ع.(@)(@@)(@@)(@@) $ 3681 -(@)(@@) عثمان بن جبلة بن أبي رواد العتكي المروزي، عن قرة، وشعبة، وعنه ابناه: عبدان، وعبد العزيز شاذان، ثقة. خ م س.(@)(@@)(@@)(@@) $ 3682 -(@)(@@) عثمان بن جبير، عن أبي أيوب الأنصاري، وعنه عبد الله بن عثمان بن خثيم. ق.(@)(@@)(@@)(@@) $ 3683 -(@)(@@) عثمان بن الجهم، عن زر، وعنه وكيع بن محرز. ق.(@)(@@)(@@)(@@) $ 3684 -(@)(@@) عثمان بن أبي حازم، عن أبيه، وعنه ابن أخيه أبان بن عبد الله البجلي، وثقهم ابن حبان. د.(@)(@@)(@@)(@@) $ 3685 -(@)(@@) عثمان بن حاضر القاص، عن ابن عباس، وجابر، وعنه ابن إسحاق، وعمرو بن ميمون بن مهران، وجماعة، وثقه أبو زرعة. د ق.(@)(@@)(@@)(@@) $ 3686 -(@)(@@) عثمان بن حصن بن علاق، عن عروة بن رويم، وطائفة، وعنه 
ms279	 هشام بن عمار، وعلي بن حجر، وعدة، وثقه أبو داود. س. PageV02P005(@)(@@)(@@)(@@) $ 3687 -(@)(@@) عثمان بن الحكم الجذامي، عن يحيى بن سعيد، وموسى بن عقبة، وعنه سعيد بن أبي مريم، وطائفة، قال أبو حاتم: ليس بالمتقن، وقال ابن يونس: عرض عليه قضاء مصر فأبى، وهجر الليث لإشارته بأن يولى، مات 163. د س.(@)(@@)(@@)(@@) $ 3688 -(@)(@@) عثمان بن حكيم الكوفي، عن الحسن بن حي، وجماعة، وعنه ابنه أحمد، والحنيني، توفي 219. س.(@)(@@)(@@)(@@) $ 3689 -(@)(@@) عثمان بن حكيم بن عباد بن حنيف الأوسي، عن أبي أمامة بن سهل، وابن المسيب، وعنه هشيم، وعلي بن مسهر، وخلق، وثقوه. م 4.(@)(@@)(@@)(@@) $ 3690 -(@)(@@) عثمان بن حنيف، أخو عباد، وسهل، صحابي، عنه ابن أخيه أبو أمامة، وعبيد الله بن عبد الله ابن عتبة، وكان أحد الأشراف. ت س ق.(@)(@@)(@@)(@@) $ 3691 -(@)(@@) عثمان بن حيان المري، عن مولاته أم الدرداء، وعنه عبد الرحمن بن يزيد بن جابر، وهشام بن سعد، ولي المدينة فجار. م ق.(@)(@@)(@@)(@@) $ 3692 -(@)(@@) عثمان بن خالد العثماني، عن مالك، وعنه ابنه محمد، وإبراهيم بن سعيد الجوهري، قال النسائي: ليس بثقة. ق.(@)(@@)(@@)(@@) $ 3693 -(@)(@@) عثمان بن ربيعة التيمي، عن شداد بن أوس، وعنه كثير بن زيد، وثق. ت.(@)(@@)(@@)(@@) $ 3694 -(@)(@@) عثمان بن أبي رواد العتكي، عن الزهري، وعنه شعبة، ومحمد بن بكر البرساني، وثقه ابن معين. خ.(@)(@@)(@@)(@@) $ 3695 -(@)(@@) عثمان بن زائدة الكوفي المقرئ الزاهد، نزيل الري، عن نافع، والزبير بن عدي، وطائفة، وعنه حكام بن سلم، وأبو الوليد الطيالسي، وطائفة. م. PageV02P006(@)(@@)(@@)(@@) $ 3696 -(@)(@@) عثمان بن زفر التيمي، عن عبد العزيز بن الماجشون، وعاصم بن محمد العمري، وطائفة، وعنه العباس الترقفي، وعيسى زاغاث، قال أبو حاتم: صدوق، مات 218. ت س.(@)(@@)(@@)(@@) $ 3697 -(@)(@@) عثمان بن زفر الجهني الدمشقي، عن محمد بن خالد، وعنه بقية، وغيره، وثق. د.(@)(@@)(@@)(@@) $ 3698 -(@)(@@) عثمان بن السائب، مولى أبي محذورة، عن أبيه، وغيره، وعنه ابن جريج، وثق. د س.(@)(@@)(@@)(@@) $ 3699 -(@)(@@) عثمان بن سعد أبو بكر البصري المؤدب، عن أنس، ومجاهد، وعنه شعبة، والأنصاري، لينه غير واحد. د ت.(@)(@@)(@@)(@@) $ 3700 -(@)(@@) عثمان بن سعيد بن كثير الحمصي، 
ms280	 مولى بني أمية، عن حريز بن عثمان، وحسان بن نوح، وعنه ابناه: عمرو، ويحيى، وعثمان الدارمي، وكان ثقة من العابدين. د س ق.(@)(@@)(@@)(@@) $ 3701 -(@)(@@) عثمان بن أبي سليمان بن جبير بن مطعم، قاضي مكة، عن عمه نافع، وعروة، وعنه ابن جريج، وابن عيينة، وثقه أحمد. م د س ق.(@)(@@)(@@)(@@) $$$ * -(@)(@@) عثمان بن سهل، عن جده رافع بن خديج، وعنه سعيد بن يزيد، فيه جهالة. د.(@)(@@)(@@)(@@) $ 3702 -(@)(@@) عثمان بن أبي سودة المقدسي، عن أبي الدرداء، وأبي هريرة، وعنه أخوه زياد، وثور بن يزيد، والأوزاعي وقال: أدرك عبادة وهو مولاه. د ت ق. PageV02P007(@)(@@)(@@)(@@) $ 3703 -(@)(@@) عثمان بن صالح الخلقاني، عن يزيد بن هارون، والطبقة، وعنه أبو داود، والمحاملي، ثقة، توفي 256. د.(@)(@@)(@@)(@@) $ 3704 -(@)(@@) عثمان بن صالح السهمي، مصري، عن ليث، ومالك، وعنه البخاري، وابنه يحيى، وخلق، مات 219. خ س ق.(@)(@@)(@@)(@@) $ 3705 -(@)(@@) عثمان بن الضحاك بن عثمان الحزامي، عن أبيه، وأبي حازم الأعرج، وعنه عبد الله بن نافع الصائغ، وجماعة، فيه ضعف. ت.(@)(@@)(@@)(@@) $ 3706 -(@)(@@) عثمان بن طلحة بن أبي طلحة العبدري الحاجب، له صحبة، عنه ابن عمه شيبة، وابن عمر، توفي 42. م د.(@)(@@)(@@)(@@) $ 3707 -(@)(@@) عثمان بن أبي العاتكة الدمشقي القاص، عن عمير بن هانئ، وطائفة، وعنه الوليد، وابن شابور، ضعفه النسائي، ووثقه غيره، توفي 155. د ق.(@)(@@)(@@)(@@) $ 3708 -(@)(@@) عثمان بن عاصم أبو حصين الأسدي، عن ابن عباس، وشريح، وطائفة، وعنه شعبة، والسفيانان، وخلق، ثقة ثبت صاحب سنة، توفي سنة 127، وقيل سنة 128. ع.(@)(@@)(@@)(@@) $ 3709 -(@)(@@) عثمان بن أبي العاص الثقفي، ولي الطائف للنبي صلى الله عليه وسلم، عنه ابن المسيب، ونافع بن جبير، وجماعة، مات 51. م 4.(@)(@@)(@@)(@@) $ 3710 -(@)(@@) عثمان بن عبد الله بن الأسود، عن عبد الله بن هلال الثقفي، وعنه إبراهيم بن ميسرة. س. PageV02P008(@)(@@)(@@)(@@) $ 3711 -(@)(@@) عثمان بن عبد الله بن أوس الثقفي، عن جده، وعمه عمرو، وعنه إبراهيم بن ميسرة، ومحمد بن سعيد، وجماعة. د. ق.(@)(@@)(@@)(@@) $ 3712 -(@)(@@) عثمان بن عبد الله بن الحكم، عن عثمان، وعنه إسماعيل بن عمرو الأشدق. ق.(@)(@@)(@@)(@@) $ 3713 -(@)(@@) عثمان بن عبد الله بن سراقة العدوي، 