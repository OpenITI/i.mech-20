ms21	 سيف البغي عنا وعطلت % % قيود وأغلال وسجن وسجان % % 49(@)(@@) % وما كان منا الحي في ثوب ذله % % بأنهض ممن ضم قبر وأكفان % % 50(@)(@@) % ومن على المستضعفين وأنجزت % % مواعيد تمكين وآذن إمكان % % PageV01P066 51(@)(@@) % بيمن الإمام الظافر الغافر الذي % % صفا منه للإسلام سر وإعلان % % 52(@)(@@) % مجرد سيف الإنتقام لمن عتا % % فمال به في الدين زيغ وإدهان % % 53(@)(@@) % فمن سره المحيا فسمع وطاعة % % ومن يحسد الموتى فكفر وعصيان % % PageV01P067 البحر : كامل تام 1(@)(@@) % شهدت لك الأعياد أنك عيدها % % بك حن موحشها وآب بعيدها % % 2(@)(@@) % وأضاء مظلمها وأفرخ روعها % % وأطاع عاصيها ولان شديدها % % 3(@)(@@) % وصفت لنا الدنيا فشب كبيرها % % في إثر ما قد كان شاب وليدها % % 4(@)(@@) % ما كان أجمد قبل يومك بحرها % % فالآن فجر بالندى جلمودها % % 5(@)(@@) % والريح للإقبال تزجي للمنى % % ديما تدفق بالحياة مدودها % % 6(@)(@@) % ولقد تغيم وما لنا من ودقها % % إلا خواطف برقها ورعودها % % 7(@)(@@) % وارتاح بيتك في أباطح مكة % % لمعاد أيام دنا موعودها % % 8(@)(@@) % لمواكب صهلت إليك خيولها % % وكتائب خفقت عليك بنودها % % 9(@)(@@) % شغفا بدعوتك التي قد طالما % % عمرت تهائمها بها ونجودها % % 10(@)(@@) % وأهل محرمها ولبى ركبها % % وتلاحقت حجابها ووفودها % % PageV01P068 11(@)(@@) % فالآن أنجز موعد الدنيا لنا % % ولها وأخلف روعها ووعيدها % % 12(@)(@@) % حين استقل بك السرير وفوقه % % بأس الخلائف منجبيك وجودها % % 13(@)(@@) % وبهاؤها وسناؤها ووفاؤها % % وصفوفها وسيوفها وجنودها % % 14(@)(@@) % وتلبست منك الخلافة تاجها % % وتلألأت لباتها وعقودها % % 15(@)(@@) % أعظم بها نعما وفيت بشكرها % % فولي عهد المسلمين مزيدها % % 16(@)(@@) % تاليك تحتاز المدى فيحوزه % % وتؤود شاهقة الربا فيؤودها % % 17(@)(@@) % إن تزرع المعروف فهو غمامة % % أو تبدأ النعماء فهو معيدها % % 18(@)(@@) % نستفتح السراء وهو يسيرها % % وتشيد العلياء وهو يشيدها % % 19(@)(@@) % وإذا ازدهتك من المحامد زهرة % % في روضة غناء فهو يرودها % % 20(@)(@@) % وإذا تقحمت العداة مواردا % % فلنعم طعان الكماة يذودها % % PageV01P069 21(@)(@@) % فطرته من قطب النجوم ولادة % % وكلت إليه الخيل فهو يقودها % % 22(@)(@@) % واختصه بدر السماء بنسبة % % حكمت على السادات أن سيسودها % % 23(@)(@@) % وسرت إليه من يديك شمائل % % أغرته بالآفاق فهو يحودها % % 24(@)(@@) % وكسوته ثوبي وغى ورياسة % % زهيت عليه 
ms22	 سيوفها وبرودها % % 25(@)(@@) % أيام أزهرت البلاد كواكبا % % بقباب جندك والرجاء عبيدها % % 26(@)(@@) % حججا ثلاثة ما تأنس حضرها % % شوقا إليك ولا توحش بيدها % % 27(@)(@@) % وسرادق النصر العزيز عليكما % % مرفوع أروقة الهدى ممدودها % % 28(@)(@@) % حتى ارتقيت من المنابر رتبة % % غرت بها غر الرجال وصيدها % % 29(@)(@@) % في قبة الملك الذي صنهاجة % % وزنانة أطنابها وعمودها % % 30(@)(@@) % وسراتها ودعاتها ورعاتها % % وبناتها وحماتها وأسودها % % PageV01P070 31(@)(@@) % هم نوروا لك ليل كل مضلة % % سمرا وبيضا ما تجف غمودها % % 32(@)(@@) % نور لمن والاك فهي وقيده % % أو نار من عاداك فهو وقودها % % 33(@)(@@) % أذهلتها بعلاك عما أورثت % % من ملكها آباؤها وجدودها % % 34(@)(@@) % وتعوضت بذراك من أوطانها % % أمنية حسب النفوس وجودها % % 35(@)(@@) % صدقتك أيام النزار سيوفها % % ضربا وفي يوم النفار عهودها % % 36(@)(@@) % في ساعة مقطوعة أرحامها % % لا البر شاهدها ولا مشهودها % % 37(@)(@@) % يوم أذل كرامة للئامه % % وسطت بأحرار الملوك عبيدها % % 38(@)(@@) % وتواكلت أبطالها في كربة % % أعيت بها ساداتها ومسودها % % 39(@)(@@) % لا يهتدي سمت النجاة دليلها % % دهشا ولا وجه السداد سديدها % % 40(@)(@@) % حتى طلعت لهم بأسعد غرة % % طلعت عليهم في السماء سعودها % % PageV01P071 41(@)(@@) % فتنسموا نفس الحياة لأنفس % % قد حان من حوض الحمام ورودها % % 42(@)(@@) % دلفوا إلى شهباء حان حصادها % % بظبى رئوس الدارعين حصيدها % % 43(@)(@@) % وشعاب قنتيش وقد حشرت لهم % % أمم بغاة لا يكت عديدها % % 44(@)(@@) % فكأنما مرضت قلوبهم لهم % % غلا فجاءوا بالرماح تعودها % % 45(@)(@@) % تركوا بها ظهر الصعيد وقد غدا % % بطنا وأجساد الغواة صعيدها % % 46(@)(@@) % وكتائب الإفرنج إذ كادتك في % % أشايعها والله عنك يكيدها % % 47(@)(@@) % بسوابح في لج بحر سوابغ % % فاضت على الأرض الفضاء مدودها % % 48(@)(@@) % ولقد أضافوا نسرها وغرابها % % وقراهما طاغوتها وعميدها % % 49(@)(@@) % شلو لأرمنقورها حشرت به % % للزحف ثم إلى الجحيم حشودها % % 50(@)(@@) % ودنت لها في آر تحت صوارم % % وريت بعز المسلمين زنودها % % PageV01P072 51(@)(@@) % من بعد ما قصفوا الرماح وأصلتوا % % بيضا يشيع حدها توحيدها % % 52(@)(@@) % فكأنما رفعت لها صلبانها % % في ظل هبوتها فحان سجودها % % 53(@)(@@) % وبجانب الغربي إذ أقدمتها % % شعثاء بشر بالفتوح شهيدها % % 54(@)(@@) % ضربوا على الأخدود هام حماته % % حتى عبرت 
ms23	 وجسرهن خدودها % % 55(@)(@@) % في وقعة قامت بعذر سيوفهم % % لو ذاب من حر الجلاد حديدها % % 56(@)(@@) % ويضيق فيها العذر عن خطية % % سمراء لم يورق بكفك عودها % % 57(@)(@@) % فبها رأينا العز حيث توده % % وسوابغ النعماء حيث تريدها % % 58(@)(@@) % إلا كرائم من كرائمك التي % % بك كرمت أخطارها وجدودها % % 59(@)(@@) % ذعرت بحكم الجاهلية أن ترى % % قد دس في ترب الثرى موئودها % % 60(@)(@@) % أو ملكت من في يديه مماتها % % ونأت على من في يديه خلودها % % PageV01P073 61(@)(@@) % فاقبل فقد ساقت إليك مهورها % % أكفاء حمد لا يذم حميدها % % 62(@)(@@) % بدعا من النظم النفيس تشاكهت % % فيها الجواهر درها وفريدها % % 63(@)(@@) % ولتهننا أيام عز كلها % % عيد وأنت لمن أطاعك عيدها % % 64(@)(@@) % ولقد يحول على وليك حولها % % في مشفق الأهلين وهو فقيدها % % 65(@)(@@) % إن يطرق الأوطان فهو أسيرها % % أو يشعر الأعداء فهو طريدها % % 66(@)(@@) % لا حرمة الرحمن ناهية ولا % % معلوم أيام ولا معدودها % % 67(@)(@@) % عن مسلم ضحى به غاو وعن % % نفس حرام والعداة تصيدها % % 68(@)(@@) % قد عاندوا الرحمن في حرماته % % أن تعتدى في المسلمين حدودها % % 69(@)(@@) % بيض السيوف علي فيك حدادها % % متوقد الأكباد نحوي سودها % % 70(@)(@@) % هذا جناي وغارة مشهودة % % عدلت بحب المستعين شهودها % % PageV01P074 71(@)(@@) % وكفاك من نفس كفيت رجاءها % % ذخرا فهان طريفها وتليدها % % 72(@)(@@) % كانت وحيدة دهرها من نكبة % % منكوبها فذ الدهور وحيدها % % 73(@)(@@) % ولئن أجد لي الحسود نفاسة % % أن قد دعاك لنعمة تجديدها % % 74(@)(@@) % فأنا الذي لم تغض عين الدهر عن % % نعمى ولا نقمى ينام حسودها % % 75(@)(@@) % ولذاك في عنقي موثق غلها % % باق وفي القدمين بعد قيودها % % PageV01P075 البحر : طويل 1(@)(@@) % تخيرت فاستمسكت بالعروة الوثقى % % فبشراك أن تفنى عداك وأن تبقى % % 2(@)(@@) % فما أبطل الرحمن باطل من بغى % % على الحق إلا أن يحق بك الحقا % % 3(@)(@@) % وما لاح هذا الملك بدرا لتمه % % بوجهك إلا أن يبير العدى محقا % % 4(@)(@@) % وما كنت عند الله أكرم من حبا % % خلافته إلا وأنت له أتقى % % 5(@)(@@) % ليجلو عن الدنيا بك الهم والأسى % % ويجمع في سلطانك الغرب والشرقا % % 6(@)(@@) % رددت نظام الملك في عقد 
ms24	 سلكه % % وما كان إلا صوفة في يدي خرقا % % 7(@)(@@) % وأضحكت سن الدهر من بعد مقلة % % مدامعها شوقا إلى الحق ما ترقا % % 8(@)(@@) % وقلدت والي العهد سيفا إلى العدى % % فسار كأن الشمس قلدت البرقا % % 9(@)(@@) % وسطي سماء قد جعلت نجومها % % صفائح بيض الهند والأسل الزرقا % % 10(@)(@@) % بوارق لو لم تخطف الهام في الوغى % % لخرت جسوم من رواعدها صعقا % % PageV01P076 11(@)(@@) % كأن الملا منهن أحشاء عاشق % % تبكي دما عيناه من حر ما يلقى % % 12(@)(@@) % هوادي في ضنك المكر ولا هدى % % نواطق بالفتح المبين ولا نطقا % % 13(@)(@@) % يخبرن عن إلحاح سعيك في العدى % % كأن سطيحا في سناهن أو شقا % % 14(@)(@@) % ويجلون عن ليل العجاج كأنما % % تقلب إحداهن ناظرتي زرقا % % 15(@)(@@) % وجردا ينازعن الكماة أعنة % % يفرغنها جهدا ويملأنها عنقا % % 16(@)(@@) % تكر ورادا من دماء عداتها % % وإن أقدمت شهبا على الطعن أو بلقا % % 17(@)(@@) % روائع يوم الروع تعدو سوابحا % % كراما وتمسي في دماء العدى غرقى % % 18(@)(@@) % ضمان عليها نفس كل منازع % % ولو حملته الغول أو ركب العنقا % % 19(@)(@@) % تبارى إلى الهيجا بأسد خفية % % إذا هال وجه الموت هاموا به عشقا % % 20(@)(@@) % وإن فزعوا نحو الصريخ فلا ونى % % وإن وردوا حوض المنايا فلا فرقا % % PageV01P077 21(@)(@@) % عبيد مماليك وأملاك بربر % % وكل عظيم الفخر قد حزته رقا % % 22(@)(@@) % هم فئة الإسلام إن شهدوا الوغى % % وهم أفق للملك إن نزلوا أفقا % % 23(@)(@@) % عممتهم نعمى جزوك بها هوى % % وأوزعتهم حلما جزوك به صدقا % % 24(@)(@@) % وأوريتهم زندا ينير لهم هدى % % وأقبلتهم كفا ينير لهم رزقا % % 25(@)(@@) % وعزما لنصر الدين والملك منتضى % % ورأيا من التوفيق والسعد مشتقا % % 26(@)(@@) % شمائل إنعام شملت به الورى % % وأخلاق إكرام عممت به الخلقا % % 27(@)(@@) % فجدك ما أعلى وذكرك ما أبقى % % وراجيك ما أغنى وشانيك ما أشقى % % 28(@)(@@) % ويمناك بالإحسان حسب من اعتفى % % وسقياك بالمعروف حسب من استسقى % % 29(@)(@@) % وناداك عبد يقتضيك ودائعا % % وإن عظمت خطرا فأنفس به علقا % % 30(@)(@@) % به أنست الدنيا أساطير من مضى % % وأتعبت الأيام أقلام من يبقى % % PageV01P078 31(@)(@@) % إذا ما شجا الأعداء في قمم الذرى 
ms25	 % % شفاها بحظ تحت أقدامها ملقى % % 32(@)(@@) % وإن يك مسبوقا فيارب سابق % % بعيد المدى لا يدعي معه سبقا % % 33(@)(@@) % وإن له في راحتيك وسائلا % % تناديه من جو السماء ألا ترقى % % 34(@)(@@) % فسر في ضمان الله ناصر دولة % % كأن عمود الصبح عن وجهها انشقا % % 35(@)(@@) % وحسبك من حلاك تاج خلافة % % رآك لها أهلا فأعطاكها حقا % % PageV01P079 البحر : خفيف تام 1(@)(@@) % بلغت عبدك الخطوب مداها % % يوم تبليغك النفوس مناها % % 2(@)(@@) % وتناهى جهد الحياة ممن لم % % يسع فيما رضيت إلا تناهى % % 3(@)(@@) % وعجيب أن يفني الظمىء نفسا % % أبحر الأرض في يدي مولاها % % 4(@)(@@) % ملك نافست بأدنى رضاه % % بشرته ربحا بأقصى رضاها % % 5(@)(@@) % بذلت كل طارف وتليد % % لو شفاها من ليتها وعساها % % 6(@)(@@) % ولقد شافهت سيوف عداه % % لو كفاها بها شمات عداها % % 7(@)(@@) % إن تلافيتها فأنفس نفس % % لك أسنى حليها وحلاها % % 8(@)(@@) % أو فأدنى مواعد الموت منها % % إن تضعها عشية أو ضحاها % % PageV01P080 البحر : كامل تام 1(@)(@@) % كم أستطيل تضللي وتلددي % % وأروح في ظلم الخطوب وأغتدي % % 2(@)(@@) % والأرض مشرقة بنوري ربها % % والفجر منبلج لعين المهتدي % % 3(@)(@@) % بأغر من بيت النبوة والهدى % % كالبدر من ولد النبي محمد % % 4(@)(@@) % القاسم المقسوم راحة كفه % % في بسط معروف وقبض مهند % % 5(@)(@@) % الهاشمي الطالبي الفاطمي % % الوارث العليا بأعلى قعدد % % 6(@)(@@) % أهدى إلى الدنيا علي هدية % % في طي أردية النهى والسودد % % 7(@)(@@) % حتى تجلى للمكارم والعلا % % بدر تنقل في بروج الأسعد % % 8(@)(@@) % متقدما من مشرق في مشرق % % متنقلا من سيد في سيد % % 9(@)(@@) % من كل روح بالعفاف مقدس % % في كل جسم بالسناء مقلد % % 10(@)(@@) % بعدوا عن الرجس الذميم وطهروا % % في منشأ للمنجبين ومولد % % PageV01P081 11(@)(@@) % ولرب موجود ولما يوجد % % منهم ومفقود كأن لم يفقد % % 12(@)(@@) % ما بشروا بالفوز حتى بشروا % % بأبر من خلف الجدود وأمجد % % 13(@)(@@) % لهم زكي صلاتنا ودعاؤنا % % في كل خطبة منبر وتشهد % % 14(@)(@@) % ومكانهم من قلب كل كتيبة % % كمكانهم من قلب كل موحد % % 15(@)(@@) % هم أنجبوك لسان صدق عنهم % % فرعا يطيب لنا بطيب المحتد % % 16(@)(@@) % وهم رضوك لكل خطب فادح % % واستخلفوك 
ms26	 لكل غاو معتد % % 17(@)(@@) % ولصوت داع بالصريخ مثوب % % ولفك عان بالخطوب مقيد % % 18(@)(@@) % ملك تشاكه جوده وجواده % % إن كر نحو مبارز أو مجتد % % 19(@)(@@) % أعيا علي أهاديات جياده % % في الروع أهدى أم نداه في الندى % % 20(@)(@@) % لا الفارس الأقصى بمعجزه ولا % % جدواه للأدنين دون الأبعد % % PageV01P082 21(@)(@@) % سيف الخلافة في العدى وأمينها % % دون الغبوب وزينها في المشهد % % 22(@)(@@) % يبلي جوانحها بنفس مخاطر % % وينيم أعينها بعين مسهد % % 23(@)(@@) % جهد الكرام وما دنوا من غاية % % أحرزتها متأنيا لم تجهد % % 24(@)(@@) % بك أخمدت نيرانها من فتنة % % لولاك يابن نبينا لم تخمد % % 25(@)(@@) % من ذا سواك إذ الرجال تدافعوا % % رأيا يؤلفها برأي أوحد % % 26(@)(@@) % وإذا الصوارم جردت في فتنة % % عمياء تغمدها بسيف مغمد % % 27(@)(@@) % ولرب مشعلة الرماح كففتها % % عفوا وما زعزعت حبوة مرتد % % 28(@)(@@) % يا من إذا علقت يدي بيمينه % % فالكاشحون أقل ما ملكت يدي % % 29(@)(@@) % وإذا عقلت رواحلي بفنائه % % فقد اقتضيت ضمان يومي عن غد % % 30(@)(@@) % وعدتني الدنيا شقيقك مفزعا % % من سوء عادية الزمان الأنكد % % PageV01P083 31(@)(@@) % وكفى ببشرك لي بشيرا بالمنى % % وقبول وجهك منجزا للموعد % % 32(@)(@@) % يابن الشفيع بنا وأكرم أسوة % % للمقتدين وأنت أجدر مقتد % % 33(@)(@@) % امدد يمينك شافعا ومشفعا % % تحز الثناء مخلدا بمخلد % % 34(@)(@@) % يابن الوصي علي أوص سميه % % ألا يضيع سمي جدك أحمد % % 35(@)(@@) % يا صفوة الحسنين كم قد أحسنا % % إصغاء ود النازح المتودد % % 36(@)(@@) % يأيها القمران أين سناكما % % عن مطبق في ليل هم أسود % % 37(@)(@@) % يأيها الغيثان هل لكما إلى % % روض النهى والعلم في الترب الصدي % % 38(@)(@@) % يا فرقدي قطب الخلافة جهزا % % مهدي السلام لفرقد من فرقد % % 39(@)(@@) % فلأجعلن ثناء ما أوليتما % % زادا لكل مكوف أو منجد % % 40(@)(@@) % حتى يسمع طيب ما أثني به % % قبر بطيبة أو بصحن المسجد % % PageV01P084 41(@)(@@) % وإذا وردنا حوض جدك فاستمع % % وأبوك يسقي للرواء السرمد % % 42(@)(@@) % شكر الذي أرحبتما من منزلي % % وثناء ما رفهتما من مورد % % 43(@)(@@) % في ستة ضعفوا وضعف عدهم % % حملا لمبهور الفؤاد مبلد % % 44(@)(@@) % شد الجلاء رحالهم فتحملت % % أفلاذ قلب بالهموم مبدد % % 45(@)(@@) % وحدت 
ms27	 بهم صعقات روع شردت % % أوطانهم في الأرض كل مشرد % % 46(@)(@@) % لا ذات خدرهم يرام لوجهها % % كن ولا ذو مهدهم بممهد % % 47(@)(@@) % عاذوا بلمع الآل في مد الضحى % % من بعد ظل في القصور ممدد % % 48(@)(@@) % ورضوا لباس الجود ينهك منهم % % بالبؤس أبشار النعيم الأرغد % % 49(@)(@@) % واستوطنوا فزعا إلى بحر الندى % % أهوال بحر ذي غوارب مزبد % % 50(@)(@@) % من كل عار بالتجمل مكتس % % ومزود بالصبر غير مزود % % PageV01P085 51(@)(@@) % ولنعم جبر الفقر من بعد الغنى % % والذل بعد العز آل محمد % % PageV01P086 البحر : متقارب تام 1(@)(@@) % لعلك يا شمس عند الأصيل % % شجيت لشجو الغريب الذليل % % 2(@)(@@) % وألقوا على مروان صفوة أنفس % % تعالى بها جد الزمان وجده % % 3(@)(@@) % وسيفك منهم سهمك الصائب الذي % % يزيد غناء كلما زاد بعده % % 4(@)(@@) % رميت به آفاق رومة فانثنى % % يقود بنود الروم نحوك بنده % % 5(@)(@@) % فرب حمي الغل في غيل ملكها % % بعيد على شأو الجنائب قصده % % 6(@)(@@) % متى يرم صرف الدهر لا يعد نفسه % % وإن يرمه صرف المكاره بعده % % 7(@)(@@) % تجلى ابن يحيى في سناك لغيه % % فبصره أن اصطناعك رشده % % 8(@)(@@) % فما أبطأت إذا أبطأت يد قادح % % أتاك وقد أورى لك النجح زنده % % 9(@)(@@) % ولا غاب من وافاك من أرض رومة % % بغاب من الخطي تزأر أسده % % 10(@)(@@) % كتائب لو يرمى بها الدهر قبلنا % % لزلزل ذو القرنين منها وسده % % PageV01P087 11(@)(@@) % كأن فضاء الأرض ألبس منهم % % لبوسا من الماذي قدر سرده % % 12(@)(@@) % تهد بهم شم الجبال فإن هفوا % % فحظك يرمي جمعهم فيهده % % 13(@)(@@) % فما ينظر الأعداء إلا عجاجة % % يسير بها الرحمن فيها وعبده % % 14(@)(@@) % إلى يوم فلج ساطع لك نوره % % وميقات فتح صادق لك وعده % % 15(@)(@@) % على بادئ الإنعام فيه تمامه % % وحق على سبط الخلافة حمده % % 16(@)(@@) % فكوني شفيعي إلى ابن الشفيع % % وكوني رسولي إلى ابن الرسول % % 17(@)(@@) % فإما شهدت فأزكى شهيد % % وإما دللت فأهدى دليل % % 18(@)(@@) % على سابق في قيود الخطوب % % ونجم سنا في غثاء السيول % % 19(@)(@@) % ينادي الندى لسقام الضياع % % ويشكو إلى الملك داء الخمول % % 20(@)(@@) % وعز على العلم مثواه أرضا % % على 
ms28	 حكم دهر ظلوم جهول % % PageV01P088 21(@)(@@) % ويعجب كيف دنا من علي % % ولم تنفصم حلقات الكبول % % 22(@)(@@) % وكيف تنسم آل النبي % % وأبطأ عنه شفاء الغليل % % 23(@)(@@) % وأطواد عزهم ماثلات % % له وهو يرنو بطرف كليل % % 24(@)(@@) % وأبحرهم زاخرات إليه % % ويرشف في الثمد المستحيل % % 25(@)(@@) % وقد آذنوه الخصيب المريع % % ومرتعه في الوخيم الوبيل % % 26(@)(@@) % تجزأ من جنتي مأرب % % بخمط وأثل وسدر قليل % % 27(@)(@@) % غريب وكم غربت راحتاه % % في الأرض من وجه بكر بتول % % 28(@)(@@) % مكرمة ما نأت عن بلاد % % ولا قربت من شبيه مثيل % % 29(@)(@@) % تضيء لها مظلمات النفوس % % وتروى بها ظامئات العقول % % 30(@)(@@) % وتطلع في زاهرات النجوم % % ومطلعها جانح للأفول % % PageV01P089 31(@)(@@) % شريد السيوف وفل الحتوف % % يكيد بأفلاذ قلب مهول % % 32(@)(@@) % تهاوت بهم مصعقات الرواعد % % في مدجنات الضحى والأصيل % % 33(@)(@@) % بوارق ظلماء ظلم تبيح % % دمى من حمى أو دما من قتيل % % 34(@)(@@) % فأذهل مرضعة عن رضيع % % وأنسى الحمائم ذكر الهديل % % 35(@)(@@) % وشط الصريخ على ذي الصراخ % % وفات المعول ذات العويل % % 36(@)(@@) % فما تهتدي العين فيها سبيلا % % سوى سبل العبرات الهمول % % 37(@)(@@) % ولا يعرف الموت فيها طريقا % % إلى النفس إلا بعضب صقيل % % 38(@)(@@) % ركبت لها محملا للنجاة % % وصيرت قصدك فيه عديلي % % 39(@)(@@) % فردت على عقبيها المنون % % بواق مجير ورأي أصيل % % 40(@)(@@) % وقد سمتها بنفيس التلاد % % على أنفس ضائعات الذحول % % PageV01P090 41(@)(@@) % فهلت اليسار بيسرى جواد % % وحطت الذمار بيمنى بخيل % % 42(@)(@@) % نفوسا حنت قوس عطفي عليها % % فكن سهام قسي الخمول % % 43(@)(@@) % ومن دوننا آنسات الديار % % نهاب الحمى موحشات الطلول % % 44(@)(@@) % يهيج فيها زفير الرياح % % مدامع شجو السحاب المخيل % % 45(@)(@@) % وتلطم فيها أكف البروق % % خدود عراص علينا ثكول % % 46(@)(@@) % تظلم من هاطلات الغمام % % وتشكو من الريح جر الذيول % % 47(@)(@@) % مغاني السرور لبسن الحداد % % على لابسات ثياب الذهول % % 48(@)(@@) % خطيبات خطب النوى والمهور % % مهارى عليها رحال الرحيل % % 49(@)(@@) % فمن حرة جليت بالجلاء % % وعذراء نصت بنص الذميل % % 50(@)(@@) % ولا حلي إلا جمان الدموع % % يسيل على كل خد أسيل % % PageV01P091 51(@)(@@) % فبدلن من بعد خفض النعيم % % بشق الحزون ووعث السهول % % 52(@)(@@) % ومن 
ms29	 قصر الليل تحت الحجال % % بهول السرى تحت ليل طويل % % 53(@)(@@) % ومن علل الماء تحت الظلال % % صلاء القلوب بحر الغليل % % 54(@)(@@) % ومن طيب نفح بنور الرياض % % تلظى لفح بنار المقيل % % 55(@)(@@) % ومن أنسها بين ظئر وترب % % سرى ليلها بين ذيب وغول % % 56(@)(@@) % ومن كل مرأى محيا جميل % % تلقي الخطوب بصبر جميل % % 57(@)(@@) % لعل عواقبه أن تتم % % فيهدي الغريب سواء السبيل % % 58(@)(@@) % إلى الهاشمي إلى الطالبي % % إلى الفاطمي العطوف الوصول % % 59(@)(@@) % إلى ابن الوصي إلى ابن النبي % % إلى ابن الذبيح إلى ابن الخليل % % 60(@)(@@) % إلى المستجار من المستجير % % إلى المستقال من المستقيل % % PageV01P092 61(@)(@@) % إلى المستضاف المليك العزيز % % من المستضيف الغريب الذليل % % 62(@)(@@) % سلام وأنت ابن بدء السلام % % من ضيفه المكرمين الدخول % % 63(@)(@@) % غداة يضيف أهل السماء % % إلى منزل آلف للنزيل % % 64(@)(@@) % فرد سلام حليم منيب % % وجاء بعجل كريم عجول % % 65(@)(@@) % وأعطانه مألف للضيوف % % وموطن ذي عيلة أو معيل % % 66(@)(@@) % شرائع خلدها في الأنام % % من كل أرض وفي كل جيل % % 67(@)(@@) % وما زال من آله حافظ % % معالمها حفظ بر وصول % % 68(@)(@@) % بأنفس مجد سراع إليها % % وأيد عليها شهود عدول % % 69(@)(@@) % فسمي جدك عمرو الكرام % % بهشم الثريد زمان المحول % % 70(@)(@@) % وشيبه ساقي الحجيج الكفيل % % بمأوى الغريب وقوت الخليل % % PageV01P093 71(@)(@@) % وضيف حتى وحوش الفلاة % % وأهدى القرى لهضاب الوعول % % 72(@)(@@) % وإن أبا طالب للضيوف % % لأطلب من ضيفه للحلول % % 73(@)(@@) % ولا مثل والدك المصطفى % % لركب وفود وحي خلول % % 74(@)(@@) % يبادرهم بابتناء القباب % % ويكرمهم بدنو النزول % % 75(@)(@@) % ويخلع عن منكبيه الرداء % % سرورا وفرشا لضيف القيول % % 76(@)(@@) % يروح عليهم بغر الجفان % % ويغدو لهم بالغريض النشيل % % 77(@)(@@) % قرى عاجلا يقتضي شربه % % من الكوثر العذب والسلسبيل % % 78(@)(@@) % فأنتم هداة حياة وموت % % وأنتم أئمة فعل وقيل % % 79(@)(@@) % وسادات من حل جنات عدن % % جميع شبابهم والكهول % % 80(@)(@@) % وأنتم خلائف دنيا ودين % % بحكم الكتاب وحكم العقول % % PageV01P094 81(@)(@@) % ووالدكم خاتم الأنبياء % % لكم من مجد حفي كفيل % % 82(@)(@@) % تلذ بحملكم عاتقاه % % على حمله كل عبء ثقيل % % 83(@)(@@) % ورحب على ضمكم صدره % % إذا ضاق صدر أب عن 
ms30	 سليل % % 84(@)(@@) % ويطرقه الوحي وهنا وأنتم % % ضجيعاه بين يدي جبرئيل % % 85(@)(@@) % وزودكم كل هدي زكي % % وأودعكم كل رأي أصيل % % 86(@)(@@) % . . . . . . . . . . . . . . . . . . . % . . . . . . . . . . . . . . . . . . . . % PageV01P095 البحر : طويل 1(@)(@@) % جهادك حكم الله من ذا يرده % % وعزمك أمر الله من ذا يصده % % 2(@)(@@) % وطائرك اليمن الذي أنت يمنه % % وطالعك السعد الذي أنت سعده % % 3(@)(@@) % . . . . . . . . . . . . . . . . . . . . . . . . % . . . . . . . . . . . . . . . . . . . . . . . . . % 4(@)(@@) % وبيعة رضوان رعى الله حقها % % لمن بيعة الرضوان إذ غاب جده % % 5(@)(@@) % فأصبح في رأس الرياسة تاجه % % ونظم في جيد الخلافة عقده % % 6(@)(@@) % مسرته مأوى الغريب وستره % % ولذته خير المقل ورفده % % 7(@)(@@) % وأجناده في موقف الروع روضه % % وأعلامه في مورد الموت ورده % % 8(@)(@@) % نلاعب آرام الفلا من هباته % % وآرامه غر الطراد وجرده % % 9(@)(@@) % أونفترش الديباج من جود كفه % % وما فرشه إلا الجواد ولبده % % 10(@)(@@) % ومن برح فبالبيض الحسان بوجده % % فالبيض في الهيجاء برح وجده % % PageV01P096 11(@)(@@) % وقربنا من رحمة الله هديه % % ورغبنا في طاعة الله زهده % % 12(@)(@@) % وعلمنا بذل النفوس لنصره % % ندى كفه المربى على القطر عده % % 13(@)(@@) % ولو لم يواف الوافدون قبابه % % لأصبح من زهر الكواكب وفده % % 14(@)(@@) % وأيامه الموصول طول صيامه % % بليل تحلى بالتلاوة سهده % % 15(@)(@@) % وأبلج من قحطان قربك عزه % % وملكك محياه ونصرك مجده % % 16(@)(@@) % شديد محال الرمح فيك أبيه % % مبر خصام السيف عنك ألده % % 17(@)(@@) % رضاك له يا مرتضى دين واثق % % بأنك للدين الحنيف تعده % % 18(@)(@@) % وما يزدهيه منك دهر يسوده % % إذا لم تجرده لثغر يسده % % 19(@)(@@) % يوقر عنكم سمعه فيصيخه % % ويقصر عنكم طرفه فيمده % % 20(@)(@@) % وعهدك بالآمال تصرف عنكم % % ورداكم عهد السموأل عهده % % PageV01P097 21(@)(@@) % وكم حل موت الحق من شد عقدكم % % ويحيي ابن يحيى عقدكم فيشده % % 22(@)(@@) % وإن مات موت اليأس منكم رجاؤه % % تنسم فيكم روحه فيرده % % 23(@)(@@) % وناديت في الإسلام حي على الهدى % % فيالك من ظمآن قد حان ورده % % 24(@)(@@) % فقلدته سيفا لزحف يقوده % % لخزي عداك أو لزغف يقده % % 25(@)(@@) % فإن لم يكن للهند يوما حديده % % فمن يعرب العليا شباه وحده % % 26(@)(@@) % وإن يك في سرو اليمانين أصله % % فطاعته في عبد شمس ووده % % 27(@)(@@) % وإن أنجبته أزده 
ms31	 وتجيبه % % فصفوته عدنانه ومعده % % 28(@)(@@) % أما وتحلى دون ملكك نصله % % لقدما تحلى من سنائك غمده % % 29(@)(@@) % لملك نمى عبد المليك ملوكه % % وأنجم نور من هشام تمده % % 30(@)(@@) % بكل إمام ناصر أنت صنوه % % وكل مليك قاهر أنت نده % % PageV01P098 31(@)(@@) % نموك إلى بيت النبوة وابتنوا % % لك الشرف الفرد الذي أنت فرده % % 32(@)(@@) % فأفخر بمن قرب النبيين فخره % % وأمجد بمن مجدالخلائف مجده % % 33(@)(@@) % ومن كل حق في الخلافة حقه % % وكل إمام في البرية جده % % 34(@)(@@) % بومن أمه أجياد والركن ظئره % % ومرضعه البطحاء والحجر مهده % % 35(@)(@@) % له حرم الإتهام والغور غوره % % ومنهج سبل الحج والنجد نجده % % 36(@)(@@) % وحيث اعتلى صوت الملبي وحجه % % وحيث انتهى صدر الحجيج ووخده % % 37(@)(@@) % مناقب سارت في معالم كنهها % % عقول بني الدنيا وما حد حده % % 38(@)(@@) % وفخر لو استنجدت في وصفه الورى % % لأسأر من عد الحصى من يعده % % 39(@)(@@) % ولم يبل ما أبلاه آباء منذر % % لأولهم بل مفخر تستجده % % 40(@)(@@) % وحق على يمنى يدي بقاؤه % % جديدا على مر الزمان وخلده % % PageV01P099 41(@)(@@) % بغرب لسان لو أباري به الورى % % مدى الدهر لم يبلغ نصيفي مده % % 42(@)(@@) % عليما بأن من ألحدت فيك نفسه % % ففي لهوات الذيب والذبخ لحده % % 43(@)(@@) % ومن يبغ في الآفاق عنك مراغما % % فوجدانه في ملتقى الخيل فقده % % 44(@)(@@) % ومن يتخذ في غير بحرك موردا % % فلم يتخذ إلا لنعليك خده % % 45(@)(@@) % أفلا أمل إلا إليك انتهاؤه % % ولا ملك إلا إليك مرده % % PageV01P100 البحر : طويل 1(@)(@@) % لك الخير قد أوفى بعهدك خيران % % وبشراك قد آواك عز وسلطان % % 2(@)(@@) % هو النجح لا يدعى إلى الصبح شاهد % % هو الفوز لا يبغى على الشمس برهان % % 3(@)(@@) % إليك شحنا الفلك تهوي كأنها % % وقد ذعرت عن مغرب الشمس غربان % % 4(@)(@@) % على لجج خضر إذا هبت الصبا % % ترامى بنا فيها ثبير وثهلان % % 5(@)(@@) % موائل ترعى في ذراها مواثلا % % كما عبدت في الجاهلية أوثان % % 6(@)(@@) % وفي طي أسمال الغريب غرائب % % سكن شغاف القلب شيب وولدان % % 7(@)(@@) % يرددن في الأحشاء حز مصائب % % تزيد ظلاما ليلها وهي نيران % % 8(@)(@@) % إذا غيض ماء 
ms32	 البحر منها مددنه % % بدمع عيون يمتريهن أشجان % % 9(@)(@@) % وإن سكنت عنا الرياح جرى بنا % % زفير إلى ذكر الأحبة حنان % % 10(@)(@@) % يقلن وموج البحر والهم والدجى % % تموج بنا فيها عيون وآذان % % PageV01P101 11(@)(@@) % ألا هل إلى الدنيا معاذ وهل لنا % % سوى البحر قبر أو سوى الماء أكفان % % 12(@)(@@) % وهبنا رأينا معلم الأرض هل لنا % % من الأرض مأوى أو من الإنس عرفانه % % 13(@)(@@) % وصرف الردى من دون أدنى منازل % % تباهى إلينا بالسرور وتزدان % % 14(@)(@@) % تقسمهن السيف والحيف والبلى % % وشطت بنا عنها عصور وأزمان % % 15(@)(@@) % كما اقتسمت أخذانهن يدي النوى % % فهم للردى والبر والبحر أخدان % % 16(@)(@@) % ظعائن عمران المعاهد مقفر % % بهن وقفر الأرض منهن عمران % % 17(@)(@@) % موت أمهم ماذا هوت برحالهم % % إلى نازح الآفاق سفن وأظعان % % 18(@)(@@) % كواكب إلا أن أفلاك سيرها % % زمام ورحل أو شراع وسكان % % 19(@)(@@) % فإن غربت أرض المغارب موئلي % % وأنكرني فيها خليط وخلان % % 20(@)(@@) % فكم رحبت أرض العراق بمقدمي % % وأجزلت البشرى علي خراسان % % PageV01P102 21(@)(@@) % وإن بلادا أخرجتني لعطل % % وإن زمانا خان عهدي لخوان % % 22(@)(@@) % سلام على الإخوان تسليم آيس % % وسقيا لدهر كان لي فيه إخوان % % 23(@)(@@) % ولا عرفت بي خلة دار خلة % % عفا رسمها منها جفاء ونسيان % % 24(@)(@@) % وغرت ببرق المزن من ذكر صعقه % % ومن ذكر رب كل يوم له شان % % 25(@)(@@) % ويارب يوم بان صدع سلامه % % بصدع النوى أفلاذ قلبي إذ بانوا % % 26(@)(@@) % نودعهم شجوا بشجو كمثلما % % أجابت حفيف السهم عوجاء مرنان % % 27(@)(@@) % ويصدع ما ضم الوداع تفرق % % كما انشعبت تحت العواصف أغصان % % 28(@)(@@) % إذا شرق الحادي بهم غربت بنا % % نوى يومها يومان والحين أحيان % % 29(@)(@@) % فلا مؤنس إلا شهيق وزفرة % % ولا مسعد إلا دموع وأجفان % % 30(@)(@@) % وما كان ذاك البين بين أحبة % % ولكن قلوب فارقتهن أبدان % % PageV01P103 31(@)(@@) % فيا عجبا للصبر منا كأننا % % لهم غير من كنا وهم غير من كانوا % % 32(@)(@@) % قضى عيشهم بعدي وعيشي بعدهم % % بأني قد خنت الوفاء وقد خانوا % % 33(@)(@@) % وأفجع بمن آوى صفيح وجامد % % ووارت رمال بالفلاة وكثبان % % 34(@)(@@) % وجوه تناءت في البلاد قبورها 
ms33	 % % وإنهم في القلب مني لسكان % % 35(@)(@@) % وما بليت في الترب إلا تجددت % % عليها من القلب المفجع أحزان % % 36(@)(@@) % هم استخلفوا الأحباب أمواج لجة % % هي الموت أو في الموت عنهن سلوان % % 37(@)(@@) % بقايا نفوس من بقية أنفس % % يميتون أحزاني فدينوا بما دانوا % % 38(@)(@@) % أقول لهم صبرا لكم أو عليكم % % عسى العيش محمود أو الموت عجلان % % 39(@)(@@) % ولا قنط واليسر لعسر غالب % % وفي العرش رب بالخلائق رحمان % % 40(@)(@@) % ولا بأس من رح وفي الله مطمع % % ولا بعد من خير وفي الأرض خيران % % PageV01P104 41(@)(@@) % ستنسون أهوال العذاب ومالكا % % إذا ضمكم في جنة الفوز رضوان % % 42(@)(@@) % متى تلحظوا قصر المرية تظفروا % % ببحر حصى يمناه در ومرجان % % 43(@)(@@) % وتستبدلوا من موج بحر شجاكم % % ببحر لكم منه لجين وعقيان % % 44(@)(@@) % فتى سيفه للدين أمن وإيمان % % ويمناه للآمال روح وريحان % % 45(@)(@@) % تقلد سيف الله فينا بحقه % % فبرت عهود بالوفاء وأيمان % % 46(@)(@@) % وحلى بتاج العز مفرق مخبت % % بقلبه داع إلى الله ديان % % 47(@)(@@) % وبالخير فتاح وبالخير عائد % % وبالخيل ظعان وللخيل طعان % % 48(@)(@@) % نقضت سيوف حاربته وأيمن % % وشاهت وجوه فاخرته وتيجان % % 49(@)(@@) % له الكرة العزاء عن كل شارد % % أضاءت لهم منها ديار وأوطانأ % % 50(@)(@@) % ورد بها يوم اللقاء زناتة % % كما انقلبت يوم الهباءة ذبيان % % PageV01P105 51(@)(@@) % بكل كمي عامري يسوقه % % لحر الوغى قلب على الدين حران % % 52(@)(@@) % حليهم بيض الصوارم والقنا % % لها وحلاها سابغات وأبدان % % 53(@)(@@) % تراءاك حزب البغي منهم فأقبلوا % % وفي كل أنف للغواية شيطان % % 54(@)(@@) % فأي صقور قلبت أي أعين % % إلى أي ليث ردها وهي خلدان % % 55(@)(@@) % عيونا بها كادوا الهدى ففقأتها % % فهم في شعاب الغي والرشد عميان % % 56(@)(@@) % وما لهم في ظلمة بعد كوكب % % وما لهم في مقلة بعد إنسان % % 57(@)(@@) % يضيق بهم رحب القصور وودهم % % لو احتازهم عنها كهوف وغيران % % 58(@)(@@) % وأنسيتهم حمل القنا فسلاحهم % % عليك إذا لاقوك ذل وإذعان % % 59(@)(@@) % وأنى لفل القبط في مصر موئل % % وقد غيل فرعون وأهلك هامان % % 60(@)(@@) % فياذل أعلام الهدى يوم عزهم % % ويا عز أعلام الهدى بك إذ هانوا % % PageV01P106 61 
ms34	(@)(@@) % حفرت لهم في يوم قبرة بألقنا % % قبورا هواء الجو منهن ملآن % % 62(@)(@@) % يطير بها هام ونسر وناعب % % ويعدو بها ذيب وذيخ وسرحان % % 63(@)(@@) % فلو شهد الأملاك يومك فيهم % % لألقى إليك التاج كسرى وخاقان % % 64(@)(@@) % ولو رد في المنصور روح حياته % % غداة لقيت الموت والموت عريان % % 65(@)(@@) % وناديت للهيجاء أبناء ملكه % % فلباك آساد عبيد وفتيان % % 66(@)(@@) % جبال إذا أرسيتها حومة الوغى % % وإن تدعهم يوما إليك فعقبان % % 67(@)(@@) % يقودهم داع إلى الحق مجلب % % على البغي يرضي ربه وهو غضبان % % 68(@)(@@) % كتائب بل كتب بنصرك سطرت % % ووجهك باسم الله والسيف عنوان % % 69(@)(@@) % هو السيف لا يرتاب أنك سيفه % % إذا نازل الأقران في الحرب أقران % % 70(@)(@@) % كأن العدى لما اصطلوا حر ناره % % أصهاب هواديهم من الجوحسبان % % PageV01P107 71(@)(@@) % وأسمر يسري في بحار من الندى % % بيمناك لكن يغتدي وهو ظمآن % % 72(@)(@@) % تلألأ نورا من سناك سنانه % % وقد دعت الفرسان للحرب فرسان % % 73(@)(@@) % لحياك من أحييت منه شمائلا % % يموت بها في الأرض ظلم وعدوان % % 74(@)(@@) % وناجاك إسرارا وناداك معلنا % % وحسب العلى منه سرار وإعلان % % 75(@)(@@) % بألا هكذا فليحفظ العهد حافظ % % ألا هكذا فليخلف الملك سلطان % % 76(@)(@@) % فلله ماذا أنجبت منك عامر % % ولله ماذا ناسبت منك قحطان % % 77(@)(@@) % ولله منا أهل بيت رمتهم % % إلى يدك العليا بحور وبلدان % % 78(@)(@@) % وكلهم يزهى على الشمس في الضحى % % وبدر الدياجي أنهم لك جيران % % 79(@)(@@) % وقد زاد أبناء السبيل وسيلة % % وحلو فزادوا أنهم لك ضيفان % % 80(@)(@@) % فما قصرت بي عن علاك شفاعة % % ولا بك عن مثلي جزاء وإحسان % % PageV01P108 البحر : طويل 1(@)(@@) % أرحلي محمول على العتق النجب % % يؤمك أم سار على القتم النكب % % 2(@)(@@) % يقود بها هاد إلى الأمر والمنى % % ويحدو بها حاد على الخوف والرعب % % 3(@)(@@) % غرائب مما أغرب الدهر أطلعت % % عليك هلال العلم من أفق الغرب % % 4(@)(@@) % طوت فلوات الأرض نحوك وانطوت % % كبدر إلى محق بشهر إلى عقب % % 5(@)(@@) % كئوسا تسافتها الليالي تنادما % % فجاءتك كالأقداح ردت عن الشرب % % 6(@)(@@) % تعاورهن البر والبحر مثلما % % ترد بأيدي الرسل أجوبة الكتب % % 7(@)(@@) % فليل إلى 
ms35	 صبح وصبح إلى دجى % % وكرب إلى روح وروح إلى كرب % % 8(@)(@@) % وسهل إلى حزن وحزن إلى فلا % % وسهب إلى بحر وبحر إلى سهب % % 9(@)(@@) % يكتبن صفحات السعود نواظرا % % وينفضن من أقلامهن على القلب % % 10(@)(@@) % ويقضمن أطراف الهشيم تبلغا % % إلى الروضة الغناء في المشرب العذب % % PageV01P109 11(@)(@@) % تنيخ فتلقي في الصخور كلاكلا % % تنوء لأرض المسك زهوا عن الترب % % 12(@)(@@) % ويفحصن في رضم الحصى بمناسم % % تهيم إلى حصباء من لؤلؤ رطب % % 13(@)(@@) % أنسمها رياك في نفحة الصبا % % وأجلو لها سيماك في أوجه الشهب % % 14(@)(@@) % وأسمعها داعيك في كل منهل % % هلم إلى الإكرام والمنزل الرحب % % 15(@)(@@) % ولاح لها البرق الذي أغدق الثرى % % فهن إليه موفضات إلى نصب % % 16(@)(@@) % موفرة مني إليك وسائلا % % تفوح لأنفاس الركائب والركب % % 17(@)(@@) % ولو عجزت عن همتي لتبلغت % % بذي قدم تصبو إلى ذي يد تصبي % % 18(@)(@@) % فقل لمن عاذ الهدى بسيوفه % % ودارت نجوم الملك منه على قطب % % 19(@)(@@) % وضاء بنور الحق غرة وجهه % % فأطفأ نيران الضغائن والشغبأ % % 20(@)(@@) % أخو الكهل وابن للكبير ووالد % % لأبنائهم في معتزى غير ذي ترب % % PageV01P110 21(@)(@@) % عطاء بلا من وحكم بلا هوى % % وملك بلا كبر وعز بلا عجب % % 22(@)(@@) % ومولى كما تجلو المصابيح في الدجى % % ورأي كما يشفي الهناء من النقب % % 23(@)(@@) % سما فاشترى مثنى الوزارة سابقا % % بمثنى الأيادي البيض والخلق الندب % % 24(@)(@@) % وحاز عنان الدهر سمعا وطاعة % % بكشف قناع الصبر والسمر والقضب % % 25(@)(@@) % غمام أظل الأرض وانهل بالحيا % % ضمان على النعمى أمان من الجدب % % 26(@)(@@) % تفجر للأيام بالجود والندى % % وأثمر للإسلام بالحزم واللب % % 27(@)(@@) % فتى يتلقى الروع بالبيض والقنا % % ومعتفي الأضياف بالأهل والرحب % % 28(@)(@@) % مسمى بفتح الله أرض العدى به % % مكنى بنصر الله والدين والرب % % 29(@)(@@) % وأي وليد للمكارم والعلا % % وأي رضيع للوقائع والحرب % % 30(@)(@@) % وأي فتى في مشهد الرأي والنهى % % وأي فتى في موقع الطعن والضرب % % PageV01P111 31(@)(@@) % وأي عروس بالسيادة لم يسق % % سوى السيف من مهر إليها ولا خضب % % 32(@)(@@) % واي رجاء قاد رحلي إليكما % % وقد أصعقتني مثل راغية الصقب % % 33(@)(@@) % بعيد من الأوطان 
ms36	 مستشعر العدى % % غريب على الأمواه متهم الصحب % % 34(@)(@@) % أقل من الرئبال في الأرض آلفا % % وإن كان لحمي للحسود وللخب % % 35(@)(@@) % وأعظم تأنيسا لدهري من المنى % % وأوحش منه من فتى الجب في الجب % % 36(@)(@@) % ولله من عزم إليك استقادني % % فأفرط في بعد وفرط في قرب % % 37(@)(@@) % حياء من الحال التي أنت عالم % % بها كيف عاثت في سناها يد الخطب % % 38(@)(@@) % وتسويف يوم بعد يوم تخوفا % % لعلي لا ألقاك منشرح القلب % % 39(@)(@@) % وشحا بباقي ماء وجه بذلته % % لعلي أقضي قبل إنفاده نحبي % % 40(@)(@@) % وتأخير رجل بعد تقديم أختها % % حذارا لدهر لا يغمض عن حربي % % PageV01P112 41(@)(@@) % كما مسني الشيطان نحوك ساعيا % % بطائف سقم من عذاب ومن نصب % % 42(@)(@@) % وبارقة من مقلتي أم ملدم % % ثنتني صريعا لليدين وللجنب % % 43(@)(@@) % محجبة لا تتقى بشبا القنا % % ولا يختفي منها بباب ولا حجب % % 44(@)(@@) % يدق عن القلب المؤنب قدرها % % وقد جل ما لاقيت منها عن العتبب % % 45(@)(@@) % طوت ظمء عشر بعد عشر وأوردت % % على النفس لا ترضى على الرفه بالغب % % 46(@)(@@) % إذا كرعت في حوض نفسي خضخضت % % ففاضت نواحيه بمنهمر سكب % % 47(@)(@@) % فمطعمها لحمي ومشربها دمي % % وترتع في جسمي وتأوي إلى قلبي % % 48(@)(@@) % كأن لها عندي مخاريف جنة % % وأصلي بها نار المعذب بالذنب % % 49(@)(@@) % إذا أوقدت جسمي هجيرا تظللت % % فحلت كناسا من شغا في أوخلبي % % 50(@)(@@) % تحملتها في حر صدري وأضعلي % % وتحمل أحشائي على المركب الصعب % % PageV01P113 51(@)(@@) % ألاوذ عنها قلب مكتئب شج % % وتحفز نحوي قلب ذي لوعة صب % % 52(@)(@@) % وتكذبني عنها الأماني وإنها % % إلي لأهدى من قطاة إلى شرب % % 53(@)(@@) % وإن كان أضنى الحب فالعقل حاكم % % بأن ضنى الشنآن فوق ضنى الخب % % 54(@)(@@) % وفي راحتي عبد الفعيل بن فاعل % % شفائي وفي نعمى مكارمه طبي % % 55(@)(@@) % دعوت فلباني وآوى تغربي % % إلى كرم للعز ذي مرتقى صعب % % 56(@)(@@) % وجلى همومي من سناه ببارق % % أضاء به ما بين شرق إلى غرب % % 57(@)(@@) % وأسبل لي من ستره فوق ستة % % أهيم بهم في الأرض مثل القطا الزغب % % 58(@)(@@) % فأصبحت في إكرامه مانع 
ms37	 الحمى % % وأمسيت في سلطانه آمن السرب % % 59(@)(@@) % وحمدا لمن هدى لساني لحمده % % وحسبي له من قد قضى أنه حبي % % PageV01P114 البحر : طويل 1(@)(@@) % أنورك أم أوقدت بالليل نارك % % لباغ قراك أو لباغ جوارك % % 2(@)(@@) % ورباك أم عرف المجامر أشعلت % % بعود الكباء والألوة نارك % % 3(@)(@@) % ومبسمك الوضاح أم ضوء بارق % % حداه دعائي أن يجود ديارك % % 4(@)(@@) % وخلخالك استنضيت أم قمر بدا % % وشمس تبدت أم ألحت سوارك % % 5(@)(@@) % وطرة صبح أم جبينك سافرا % % أعرت الصباح نوره أم أعارك % % 6(@)(@@) % وأنت أجرت الليل إذا هزم الضحى % % كتائبه والصبح لما استجارك % % 7(@)(@@) % فللصبح فيما بين قرطيك مطلع % % وقد سكن الليل البهيم خمارك % % 8(@)(@@) % أفيا لنهار لا يغيض ظلامه % % ويا لظلام لا يغيض نهارك % % 9(@)(@@) % ونجم الثريا أم لآل تقسمت % % يمينك إذ ضمختها أم يسارك % % 10(@)(@@) % لسلطان حسن في بديع محاسن % % يصيد القلوب النافرات نفارك % % PageV01P115 11(@)(@@) % وجند غرام في دروع صبابة % % تقلدن أقدار الهوى واقتدراك % % 12(@)(@@) % هو الملك لا بلقيس أدرك شأوها % % مداك ولا الزباء شقت غبارك % % 13(@)(@@) % وقادمة الجوزاء راعيت موهنا % % بحر هواك أم ترسمت دارك % % 14(@)(@@) % وطيفك أسرى فاستثار تشوقي % % إلى العهد أم شوقي إليك استثارك % % 15(@)(@@) % ومرتد أنفاسي إليك استطارني % % أم الروح لما رد في استطارك % % 16(@)(@@) % بكم جزت من بحر إلي ومهمه % % يكاد ينسي المستهام ادكارك % % 17(@)(@@) % ذو الحظ من علم الكتاب حداك لي % % أم الفلك الدوار نحوي أدارك % % 18(@)(@@) % وكيف كتمت الليل وجهك مظلما % % أشعرك أغشيت السنا أم شعارك % % 19(@)(@@) % وكيف اعتسفت البيد لا في ظعائن % % ولا شجر الخطي حف شجارك % % 20(@)(@@) % ولا أذن الحي الجميع برحلة % % أراح لها راعي المخاض عشارك % % PageV01P116 21(@)(@@) % ولا أرزمت خوص المهاري مجيبة % % صهيل جياد يكتنفن قطارك % % 22(@)(@@) % ولا أذكت الركبان عنك عيونها % % حذار عيون لا ينمن حذارك % % 23(@)(@@) % وكيف رضيت الليل ملبس طارق % % وما ذر قرن الشمس إلا استنارك % % 24(@)(@@) % وكم دون رحلي من قصور مشيدة % % تحرم من قرب المزار مزارك % % 25(@)(@@) % وقد زأرت حولي أسود تهامست % % لها الأسد أن كفي عن السمع زارك % % 26 
ms38	(@)(@@) % وأرضي سيول من خيول مظفر % % وليلي نجوم من سماء مبارك % % 27(@)(@@) % بحيث وجدت الأمن يهتف بالمنى % % هلمي إلى عينين جادا سرارك % % 28(@)(@@) % هلمي إلى بحرين قد مرج الندى % % عبابيهما لا يسأمان انتظارك % % 29(@)(@@) % هلمي إلى سيفين والحد واحد % % يجيران من صرف الحوادث جارك % % 30(@)(@@) % هلمي إلى طرفي رهان تقدما % % إلى الأمد الجالي عليك اختيارك % % PageV01P117 31(@)(@@) % وحيي على دوحين جاد نداهما % % ظلالك واستدنى إلي ثمارك % % 32(@)(@@) % وبشرك قد فازت قداحك بالمنى % % وأعطيت من هذا الأنام خيارك % % 33(@)(@@) % شريكان في صدق المنى وكلاهما % % إذا بارز الأقران غير مشاركب % % 34(@)(@@) % هما سمعا دعواك يا دعوة الهدى % % وقد أوثق الدهر الخئون إسارك % % 35(@)(@@) % وسلا سيوفا لم تزل تلتظي أسى % % بثأرك حتى أدركا لك ثارك % % 36(@)(@@) % ويهنيك يا دار الخلافة منهما % % هلالان لاحا يرفعان منارك % % 37(@)(@@) % كلا القمرين بين عينيه غرة % % أنارت كسوفيك وجلت سرارك % % 38(@)(@@) % فقاد إليك الخيل شعثا شوازبا % % يلبين بالنصر العزيز انتصارك % % 39(@)(@@) % سوابق هيجاء كأن صهيلها % % يجاوب تحت الخافقات شعارك % % 40(@)(@@) % بكل سري العتق سرى عن الهدى % % وكل حمي الأنف أحمى ذمارك % % PageV01P118 41(@)(@@) % تحلوا من المنصور نصرا وعزة % % فأبلوك في يوم البلاء اخيتارك % % 42(@)(@@) % إذا انتسبوا يوم الطعان لعامر % % فعمرك يا هام العدى لا عمارك % % 43(@)(@@) % يقودهم منهم سراجا كتائب % % يقولان للدنيا أجدي افتخارك % % 44(@)(@@) % إذا افترت الرايات عن غرتيهما % % فيا للعدى أضللت منهم فرارك % % 45(@)(@@) % وإن أشرق النادي بنور سناهما % % فبشرى الأماني عينك لاضمارك % % 46(@)(@@) % وكم كشفا من كربة بعد كربة % % تقول لها النيران كفى أوارك % % 47(@)(@@) % وكم لبيا من دعوة وتداركا % % شفى رمق ما كان المتدارك % % 48(@)(@@) % ويا نفس غاو كم أقرا نفارك % % ويا رجل هاو كم أقالا عثارك % % 49(@)(@@) % ولست ببدع حين قلت لهمتي % % أقلي لإعتاب الزمان انتظارك % % 50(@)(@@) % فلله صدق العزم أية غرة % % إذا لم تطيعي في لعل اغترارك % % PageV01P119 51(@)(@@) % فإن غالت البيد اصطبارك والسرى % % فما غال ضيم الكاشحين اصطبارك % % 52(@)(@@) % ويا خلة التسويف قومي فأغدفي % % قناعك من دوني وشدى إزارك % % 53(@)(@@) % وحسبك بي يا خلة النأي 
ms39	 خاطري % % بنفسي إلى الحظ النفيس حطارك % % 54(@)(@@) % فقد آن إعطاء النوى صفقة الهوى % % وقولك للأيام حوري محارك % % 55(@)(@@) % وياستر البيض النواعم أعلني % % إلى اليعملات والرحال سرارك % % 56(@)(@@) % نواجي واستودعتهن نواجيا % % حفاظك يا هذي بذي وازدهارك % % 57(@)(@@) % ودونك أفلاذ الفؤاد فشمري % % ودونك يا عين اللبيب اعتبارك % % 58(@)(@@) % صرفت الكرى عنها بمغتبق السرى % % وقلت أديري والنجوم عقاركأ % % 59(@)(@@) % فإن وجبت للمغربين جنوبها % % فداوي برقراق السراب خمارك % % 60(@)(@@) % وأوري بزندي سدفة ودجنة % % إذا كانتا لي مرخك وعفارك % % PageV01P120 61(@)(@@) % وإن خلع الليل الأصائل فاخلعي % % إلى الملكين الأكرمين عذارك % % 62(@)(@@) % بلنسية مثوى الأماني فاطلبي % % كنوزك في أقطارها وادخارك % % 63(@)(@@) % سينبيك زجري عن بلاء نسيته % % إذا أصبحت تلك القصور قصارك % % 64(@)(@@) % وأظفر سعي بالرضامن مظفر % % وبورك لي في حسن رأي مبارك % % 65(@)(@@) % فظمء المنى قد شاء بارقة الحيا % % وأنشقت يا ظئر الرجاء حوارك % % 66(@)(@@) % وحمدا يميني قد تملأت بالمنى % % وشكرا يساري قد حويت يسارك % % 67(@)(@@) % وقل لسماء المزن إن شئت أقلعي % % ويا أرضنا إن شئت غيضي بحارك % % 68(@)(@@) % ولا توحشي يا دولة العز والندى % % مساءك من نوريهما وابتكارك % % PageV01P121 البحر : كامل تام 1(@)(@@) % هل تثنين غروب دمع ساكب % % من شام بارقة الغمام الصائب % % 2(@)(@@) % أبت العزيمة من فؤاد جامد % % أن تستقيد لماء جفن ذائب % % 3(@)(@@) % من ترمه حدق المكارم تصبه % % عن مصيبات أحبه وحبائب % % 4(@)(@@) % ففراق ربات الخدور مكفر % % بلقاء نجم المكرمات الثاقب % % 5(@)(@@) % قالت وقد مزج الوداع مدامعا % % بمدامع وترائبا بترائب % % 6(@)(@@) % أتفرق حتى بمنزل غربة % % كم نحن للأيام نهبة ناهب % % 7(@)(@@) % في كل يوم منتوى متباعد % % يرمي حشاشة شملنا المتقارب % % 8(@)(@@) % وثنت تذكر مقربات سفائن % % عذنا بها من مقفرات سباسب % % 9(@)(@@) % أيام تؤنسنا فلا وسواحل % % عن آنسات مقاصر وملاعب % % 10(@)(@@) % نعب الغراب بها فطار بأهلها % % سربا على مثل الغراب الناعب % % PageV01P122 11(@)(@@) % خرق الجناح إلى الرياح مضلل % % بشمائل لعبت به وجنائب % % 12(@)(@@) % يهوي بذي طمرين مزق لبسها % % أيدي لواهف للنفوس نوادب % % 13(@)(@@) % في غول ذي لجج لبسن دياجيا % % ترك الحياة لنا كأمس الذاهب % % 14(@)(@@) % بقاسيتهن غواربا 
ms40	 كغياهب % % وسريتهن غياهبا كغوارب % % 15(@)(@@) % نجلو ظلام الليل قبل صباحه % % بظلى زفير أو برأس شائب % % 16(@)(@@) % يا هذه لله تلك حدائقا % % زهراتهن مفارقي وذوائبي % % 17(@)(@@) % مثل الرياض تفتحت أكمامها % % عن محكمات بصائري وتجاربي % % 18(@)(@@) % فدخرت للألباب كفة حابل % % ولأشطر الأيام كفي حالب % % 19(@)(@@) % ورميت آفاق العراق بشرد % % ليس العجائب عندها بعجائب % % 20(@)(@@) % من كل ساحرة كأن رويها % % في ألسن الراوين ريقة كاعب % % PageV01P123 21(@)(@@) % ولكم وصلت تنائفا بتنائف % % حتى وصلت مشارقا بمغارب % % 22(@)(@@) % فكأنما قفيت إثر بدائعي % % في الأرض أو ناويت شأو غرائبي % % 23(@)(@@) % أو رمت حظي في السماء وقد جرى % % لمداه في فلك الفضاء الغائب % % 24(@)(@@) % ولئن دجت لي الحادثات فما أرى % % نور اليقين بطرف ظن كاذب % % 25(@)(@@) % صدقتني الأنباء ضربة لازم % % أن ليس هم الدهر ضربة لازب % % 26(@)(@@) % فشفيت في حر التجمل غلتي % % وقضيت من حسن العزاء مآربي % % 27(@)(@@) % وحرست عرضي بالتوكل من نأي % % عني بجانبه نأيت بجانبي % % 28(@)(@@) % وقد رأيت الجد ليس ببالغ % % والعجز ليس عن الصراط بناكب % % 29(@)(@@) % كم قد سعدت بما تمنى حاسدي % % قدرا وخبت بما تخير صاحبي % % 30(@)(@@) % ووجدت طعم السم في شهد الجنى % % وأجاج شربي في نمير مشاربي % % PageV01P124 31(@)(@@) % ورفلت في النعم السوابغ ملبسي % % أثوابها الدهر الذي هو سالبي % % 32(@)(@@) % يا ربة الخدر استجدي سلوة % % جد النجاء بهائم بك لاعب % % 33(@)(@@) % إما شجيت برحلتي فاستبشري % % بجميل ظني من جميل عواقبي % % 34(@)(@@) % ولئن جنيت عليك ترحة راحل % % فأنا الزعيم لها بفرحة آيب % % 35(@)(@@) % هل أبصرت عيناك بدرا طالعا % % في الأفق إلا من هلال غارب % % 36(@)(@@) % والله من بعدي عليك خليفتي % % وخليفة هديت إليه مذاهبي % % 37(@)(@@) % بيني وبينك أن يلبي دعوتي % % داعي لبيب من مناخ ركائبي % % 38(@)(@@) % وأهل نحو فنائه وعطائه % % فيهل نحو وسائلي ورغائبي % % 39(@)(@@) % أوأشيم برق يمينه وجبينه % % ويشم ريح أواصري ومطالبي % % 40(@)(@@) % وأهزه بشوافع من عامر % % تزري بكل قرابة ومناسب % % PageV01P125 41(@)(@@) % فهناك جاءتك الخطوب خواضعا % % ومشى إليك الدهر مشية تائب % % 42(@)(@@) % وأناب سلطان النوائب وانثنت % % ذللا وأعتب كل مولى عانب % % 43(@)(@@) % ملك متى 